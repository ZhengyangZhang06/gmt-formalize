module

public import Poincare.SimonGMT.Chapter01.Hausdorff
public import Mathlib.Topology.MetricSpace.Thickening

@[expose] public section

/-!
# Open covers for Simon's literal Hausdorff content

Every strictly diameter-admissible set admits open enlargements whose
diameter costs approach its own cost. The universal property of the outer
measure generated by a covering cost then proves that requiring open sets
does not change any fixed-scale content. This includes dimension zero and
does not require a countable basis or separability of the metric space.
-/

open Filter Metric Set MeasureTheory
open scoped ENNReal NNReal Topology

namespace Poincare.SimonGMT.Chapter01

universe u

variable {X : Type u} [EMetricSpace X]

/-- Open enlargement can preserve a strict diameter constraint and any
strict upper bound on the corresponding nonnegative-dimensional cost. -/
theorem exists_isOpen_superset_ediam_rpow_lt
    {m : ℝ} (hm : 0 ≤ m) {C : Set X} {δ r : ℝ≥0∞}
    (hC : ediam C < δ) (hr : (ediam C / 2) ^ m < r) :
    ∃ U : Set X, C ⊆ U ∧ IsOpen U ∧ ediam U < δ ∧ (ediam U / 2) ^ m < r := by
  have hdcont : Continuous (fun ε : ℝ≥0 => ediam C + 2 * (ε : ℝ≥0∞)) := by
    fun_prop (disch := norm_num)
  have hccont : Continuous (fun ε : ℝ≥0 => ((ediam C + 2 * (ε : ℝ≥0∞)) / 2) ^ m) := by
    fun_prop (disch := norm_num)
  have hd : ∀ᶠ ε : ℝ≥0 in 𝓝 0, ediam C + 2 * (ε : ℝ≥0∞) < δ :=
    (isOpen_lt hdcont continuous_const).mem_nhds (by simpa using hC)
  have hc : ∀ᶠ ε : ℝ≥0 in 𝓝 0, ((ediam C + 2 * (ε : ℝ≥0∞)) / 2) ^ m < r :=
    (isOpen_lt hccont continuous_const).mem_nhds (by simpa using hr)
  have hevent : ∀ᶠ ε : ℝ≥0 in 𝓝[>] 0,
      0 < ε ∧ ediam C + 2 * (ε : ℝ≥0∞) < δ ∧
        ((ediam C + 2 * (ε : ℝ≥0∞)) / 2) ^ m < r :=
    Filter.Eventually.and self_mem_nhdsWithin
      (Filter.Eventually.filter_mono nhdsWithin_le_nhds (hd.and hc))
  obtain ⟨ε, hε, hεδ, hεr⟩ := hevent.exists
  refine ⟨thickening ε C, self_subset_thickening (NNReal.coe_pos.mpr hε) C,
    isOpen_thickening, (ediam_thickening_le ε).trans_lt hεδ, ?_⟩
  apply lt_of_le_of_lt _ hεr
  apply ENNReal.rpow_le_rpow _ hm
  exact ENNReal.div_le_div_right (ediam_thickening_le (s := C) ε) 2

/-- Every set of diameter strictly below a bound has an open superset
whose diameter is still strictly below that bound. -/
theorem exists_isOpen_superset_ediam_lt {C : Set X} {δ : ℝ≥0∞} (hC : ediam C < δ) :
    ∃ U : Set X, C ⊆ U ∧ IsOpen U ∧ ediam U < δ := by
  obtain ⟨U, hCU, hU, hUδ, _⟩ := exists_isOpen_superset_ediam_rpow_lt
    (m := 0) (r := 2) (by norm_num) hC (by norm_num)
  exact ⟨U, hCU, hU, hUδ⟩

/-- Simon's single-set cost with the additional requirement that the
covering set be open. -/
noncomputable def simonHausdorffOpenCoverCost
    (m : ℝ) (δ : ℝ≥0∞) (C : Set X) : ℝ≥0∞ :=
  extend (fun C (_ : ediam C < δ ∧ IsOpen C) => (ediam C / 2) ^ m) C

/-- The fixed-scale outer measure generated using only open covering sets. -/
noncomputable def simonHausdorffOpenContentOuter
    (m : ℝ) (δ : ℝ≥0∞) : OuterMeasure X :=
  realUnitBallVolume m • OuterMeasure.boundedBy (simonHausdorffOpenCoverCost (X := X) m δ)

/-- Simon Remark 2.3(1), open-cover form, for the literal fixed-scale
content in every real dimension `m ≥ 0`. -/
theorem simonHausdorffOpenContentOuter_eq {m : ℝ} (hm : 0 ≤ m) (δ : ℝ≥0∞) :
    simonHausdorffOpenContentOuter (X := X) m δ =
      simonHausdorffContentOuter (X := X) m δ := by
  have hcost (C : Set X) :
      simonHausdorffCoverCost m δ C ≤ simonHausdorffOpenCoverCost m δ C := by
    by_cases hd : ediam C < δ <;> by_cases hC : IsOpen C <;>
      simp [simonHausdorffCoverCost, simonHausdorffOpenCoverCost, extend, hd, hC]
  have hunrestricted : OuterMeasure.boundedBy (simonHausdorffCoverCost (X := X) m δ) ≤
      OuterMeasure.boundedBy (simonHausdorffOpenCoverCost (X := X) m δ) :=
    OuterMeasure.le_boundedBy.mpr fun C => (OuterMeasure.boundedBy_le C).trans (hcost C)
  have hopen : OuterMeasure.boundedBy (simonHausdorffOpenCoverCost (X := X) m δ) ≤
      OuterMeasure.boundedBy (simonHausdorffCoverCost (X := X) m δ) := by
    apply OuterMeasure.le_boundedBy.mpr
    intro C
    by_cases hC : ediam C < δ
    · rw [simonHausdorffCoverCost,
        extend_eq (fun C (_ : ediam C < δ) => (ediam C / 2) ^ m) hC]
      apply le_of_forall_gt
      intro r hr
      obtain ⟨U, hCU, hU, hUδ, hUr⟩ := exists_isOpen_superset_ediam_rpow_lt hm hC hr
      calc
        OuterMeasure.boundedBy (simonHausdorffOpenCoverCost m δ) C ≤
            OuterMeasure.boundedBy (simonHausdorffOpenCoverCost m δ) U := measure_mono hCU
        _ ≤ simonHausdorffOpenCoverCost m δ U := OuterMeasure.boundedBy_le U
        _ = (ediam U / 2) ^ m :=
          extend_eq (fun C (_ : ediam C < δ ∧ IsOpen C) => (ediam C / 2) ^ m) ⟨hUδ, hU⟩
        _ < r := hUr
    · simp [simonHausdorffCoverCost, extend, hC]
  unfold simonHausdorffOpenContentOuter simonHausdorffContentOuter
  rw [le_antisymm hopen hunrestricted]

/-- The literal set-valued approximant can be computed using open covers. -/
theorem simonHausdorffContent_eq_openContent {m : ℝ} (hm : 0 ≤ m)
    (δ : ℝ≥0∞) (A : Set X) :
    simonHausdorffContent m δ A = simonHausdorffOpenContentOuter m δ A := by
  rw [simonHausdorffOpenContentOuter_eq hm]
  rfl

/-- The limiting Hausdorff outer measure is likewise unchanged when all
covering sets are required to be open, as stated in Simon Remark 2.3(1). -/
theorem simonHausdorffOuterMeasureReal_eq_iSup_openContent {m : ℝ} (hm : 0 ≤ m) :
    simonHausdorffOuterMeasureReal (X := X) m =
      ⨆ (δ : ℝ≥0∞), ⨆ (_ : 0 < δ), simonHausdorffOpenContentOuter (X := X) m δ := by
  simp only [simonHausdorffOpenContentOuter_eq hm]
  rfl

end Poincare.SimonGMT.Chapter01
