module

public import Mathlib.Geometry.Euclidean.Volume.Measure
public import Mathlib.Analysis.SpecialFunctions.Gamma.Basic
public import Mathlib.Analysis.SpecialFunctions.Gaussian.GaussianIntegral
public import Mathlib.Topology.MetricSpace.Cover
public import Poincare.SimonGMT.Chapter01.Basic
public import Poincare.SimonGMT.Chapter01.MetricCriterion

@[expose] public section

/-!
# Simon GMT, Chapter 1, §2: Hausdorff measure

The literal construction uses Simon's Gamma-function normalization and strict
diameter bounds.  Its identification with `simonHausdorffMeasureReal` below is
proved for every nonnegative real dimension.  The older natural-dimensional
`simonHausdorffMeasure n` API is Mathlib's Haar-normalized `μHE[n]`; identifying
its Haar scalar with Simon's explicit normalization is a separate obligation.
-/

open Filter Metric Set
open scoped ENNReal MeasureTheory Pointwise Topology

namespace Poincare.SimonGMT.Chapter01

universe u

variable {X : Type u} [EMetricSpace X] [MeasurableSpace X] [BorelSpace X]

/-- Simon's real-dimensional constant
`ωₘ = π^(m/2) / Γ(m/2 + 1)`.  The source uses it for every real `m ≥ 0`,
not only for integer dimensions. -/
noncomputable def realUnitBallVolume (m : ℝ) : ℝ≥0∞ :=
  ENNReal.ofReal (Real.pi ^ (m / 2) / Real.Gamma (m / 2 + 1))

/-- Public defining equation for the Euclidean unit-ball normalization. -/
theorem realUnitBallVolume_eq (m : ℝ) :
    realUnitBallVolume m =
      ENNReal.ofReal (Real.pi ^ (m / 2) / Real.Gamma (m / 2 + 1)) := by
  rfl

/-- The cost assigned in Simon (2.2) to a single admissible covering set.
It is infinite when the strict diameter bound fails. -/
noncomputable def simonHausdorffCoverCost
    (m : ℝ) (δ : ℝ≥0∞) (C : Set X) : ℝ≥0∞ :=
  MeasureTheory.extend
    (fun C (_ : ediam C < δ) => (ediam C / 2) ^ m) C

/-- The same single-set cost with Simon Remark 2.3(1)'s additional closed-set
requirement. -/
noncomputable def simonHausdorffClosedCoverCost
    (m : ℝ) (δ : ℝ≥0∞) (C : Set X) : ℝ≥0∞ :=
  MeasureTheory.extend
    (fun C (_ : ediam C < δ ∧ IsClosed C) => (ediam C / 2) ^ m) C

/-- The outer measure generated by Simon's size-`δ` covering costs.  Using
`OuterMeasure.boundedBy` is important at dimension zero: its covering formula
charges only nonempty covering sets, so a finite cover may be padded by empty
sets without acquiring infinitely many spurious `0 ^ 0` terms. -/
noncomputable def simonHausdorffContentOuter
    (m : ℝ) (δ : ℝ≥0∞) : MeasureTheory.OuterMeasure X :=
  realUnitBallVolume m •
    MeasureTheory.OuterMeasure.boundedBy
      (simonHausdorffCoverCost (X := X) m δ)

/-- The size-`δ` outer measure obtained when every covering set is required
to be closed. -/
noncomputable def simonHausdorffClosedContentOuter
    (m : ℝ) (δ : ℝ≥0∞) : MeasureTheory.OuterMeasure X :=
  realUnitBallVolume m •
    MeasureTheory.OuterMeasure.boundedBy
      (simonHausdorffClosedCoverCost (X := X) m δ)

/-- Simon (2.2), literally: the size-`δ` Hausdorff approximant obtained by
covering with countably many sets of diameter strictly less than `δ`, with
value zero on the empty set and infinity when no such cover exists. -/
noncomputable def simonHausdorffContent
    (m : ℝ) (δ : ℝ≥0∞) (A : Set X) : ℝ≥0∞ :=
  simonHausdorffContentOuter (X := X) m δ A

/-- The extended distance between two sets, with the natural value `∞` when
one of the sets is empty.  This is Simon's `d(A, B)` in (2.4). -/
noncomputable def simonSetEDist (A B : Set X) : ℝ≥0∞ :=
  ⨅ x : A, ⨅ y : B, edist (x : X) (y : X)

theorem simonSetEDist_le_edist {A B : Set X}
    {x y : X} (hx : x ∈ A) (hy : y ∈ B) :
    simonSetEDist A B ≤ edist x y :=
  iInf_le_of_le ⟨x, hx⟩ <| iInf_le_of_le ⟨y, hy⟩ le_rfl

@[simp] theorem simonHausdorffContent_empty (m : ℝ) (δ : ℝ≥0∞) :
    simonHausdorffContent (X := X) m δ ∅ = 0 :=
  (simonHausdorffContentOuter (X := X) m δ).empty

/-- Simon Remark 2.3(1), closed-cover form: taking the infimum only over
closed covering sets does not change the size approximant. -/
theorem simonHausdorffClosedContentOuter_eq
    (m : ℝ) (δ : ℝ≥0∞) :
    simonHausdorffClosedContentOuter (X := X) m δ =
      simonHausdorffContentOuter (X := X) m δ := by
  have hcost (C : Set X) :
      simonHausdorffCoverCost m δ C ≤
        simonHausdorffClosedCoverCost m δ C := by
    by_cases hd : ediam C < δ <;>
      by_cases hc : IsClosed C <;>
        simp [simonHausdorffCoverCost, simonHausdorffClosedCoverCost,
          MeasureTheory.extend, hd, hc]
  have hunrestricted_le_closed :
      MeasureTheory.OuterMeasure.boundedBy
          (simonHausdorffCoverCost (X := X) m δ) ≤
        MeasureTheory.OuterMeasure.boundedBy
          (simonHausdorffClosedCoverCost (X := X) m δ) :=
    MeasureTheory.OuterMeasure.le_boundedBy.2 fun C =>
      (MeasureTheory.OuterMeasure.boundedBy_le C).trans (hcost C)
  have hclosed_le_unrestricted :
      MeasureTheory.OuterMeasure.boundedBy
          (simonHausdorffClosedCoverCost (X := X) m δ) ≤
        MeasureTheory.OuterMeasure.boundedBy
          (simonHausdorffCoverCost (X := X) m δ) := by
    apply MeasureTheory.OuterMeasure.le_boundedBy.2
    intro C
    by_cases hd : ediam C < δ
    · calc
        MeasureTheory.OuterMeasure.boundedBy
              (simonHausdorffClosedCoverCost (X := X) m δ) C ≤
            MeasureTheory.OuterMeasure.boundedBy
              (simonHausdorffClosedCoverCost (X := X) m δ) (closure C) :=
          MeasureTheory.measure_mono subset_closure
        _ ≤ simonHausdorffClosedCoverCost m δ (closure C) :=
          MeasureTheory.OuterMeasure.boundedBy_le _
        _ = simonHausdorffCoverCost m δ C := by
          simp [simonHausdorffCoverCost, simonHausdorffClosedCoverCost,
            MeasureTheory.extend, ediam_closure, hd]
    · simp [simonHausdorffCoverCost, MeasureTheory.extend, hd]
  unfold simonHausdorffClosedContentOuter simonHausdorffContentOuter
  rw [le_antisymm hclosed_le_unrestricted hunrestricted_le_closed]

/-- Simon (2.4), in a slightly stronger form: size-`δ` content is additive
as soon as `δ ≤ d(A,B)`.  The source assumes the stronger inequality
`δ < d(A,B) / 2`; see `simonHausdorffContent_union_of_lt_half_setEDist`. -/
theorem simonHausdorffContent_union_of_le_setEDist
    (m : ℝ) (δ : ℝ≥0∞) {A B : Set X}
    (hδ : δ ≤ simonSetEDist A B) :
    simonHausdorffContent m δ (A ∪ B) =
      simonHausdorffContent m δ A + simonHausdorffContent m δ B := by
  rw [simonHausdorffContent, simonHausdorffContent,
    simonHausdorffContent, simonHausdorffContentOuter]
  simp only [MeasureTheory.OuterMeasure.smul_apply, smul_eq_mul]
  rw [MeasureTheory.OuterMeasure.boundedBy_union_of_top_of_nonempty_inter]
  · exact mul_add _ _ _
  · intro C hAC hBC
    apply MeasureTheory.extend_eq_top
    intro hC
    rcases hAC with ⟨x, hxA, hxC⟩
    rcases hBC with ⟨y, hyB, hyC⟩
    exact (hδ.trans <| (simonSetEDist_le_edist hxA hyB).trans <|
      Metric.edist_le_ediam_of_mem hxC hyC).not_gt hC

/-- Simon (2.4), with the hypothesis printed in the source. -/
theorem simonHausdorffContent_union_of_lt_half_setEDist
    (m : ℝ) (δ : ℝ≥0∞) {A B : Set X}
    (hδ : δ < simonSetEDist A B / 2) :
    simonHausdorffContent m δ (A ∪ B) =
      simonHausdorffContent m δ A + simonHausdorffContent m δ B :=
  simonHausdorffContent_union_of_le_setEDist m δ
    (hδ.le.trans ENNReal.half_le_self)

/-- Simon Remark 2.3(2): every positive-scale Hausdorff approximant
is finite on a totally bounded set (for nonnegative dimension). -/
theorem simonHausdorffContent_lt_top_of_totallyBounded
    {m : ℝ} (hm : 0 ≤ m) {δ : ℝ≥0∞} (hδ : 0 < δ)
    {A : Set X} (hA : TotallyBounded A) :
    simonHausdorffContent m δ A < ∞ := by
  rcases ENNReal.exists_nnreal_pos_mul_lt
      (a := (2 : ℝ≥0∞)) (b := δ) ENNReal.ofNat_ne_top hδ.ne' with
    ⟨ε, hε, hεδ⟩
  rcases Metric.exists_finite_isCover_of_totallyBounded hε.ne' hA with
    ⟨N, -, hN, hcover⟩
  letI := hN.fintype
  let ν : MeasureTheory.OuterMeasure X :=
    MeasureTheory.OuterMeasure.boundedBy
      (simonHausdorffCoverCost (X := X) m δ)
  have hA_cover : A ⊆ ⋃ z : N, closedEBall (z : X) (ε : ℝ≥0∞) := by
    intro x hx
    rcases hcover hx with ⟨z, hzN, hxz⟩
    refine mem_iUnion.2 ⟨⟨z, hzN⟩, ?_⟩
    simpa [Metric.mem_closedEBall] using hxz
  have hdiam (z : N) :
      ediam (closedEBall (z : X) (ε : ℝ≥0∞)) < δ :=
    Metric.ediam_closedEBall_le.trans_lt (by simpa [mul_comm] using hεδ)
  have hball (z : N) :
      ν (closedEBall (z : X) (ε : ℝ≥0∞)) ≤
        (ediam (closedEBall (z : X) (ε : ℝ≥0∞)) / 2) ^ m := by
    calc
      ν (closedEBall (z : X) (ε : ℝ≥0∞)) ≤
          simonHausdorffCoverCost m δ
            (closedEBall (z : X) (ε : ℝ≥0∞)) :=
        MeasureTheory.OuterMeasure.boundedBy_le _
      _ = (ediam (closedEBall (z : X) (ε : ℝ≥0∞)) / 2) ^ m :=
        by
          simpa [simonHausdorffCoverCost] using
            (MeasureTheory.extend_eq
              (fun C (_ : ediam C < δ) => (ediam C / 2) ^ m)
              (hdiam z))
  have hball_top (z : N) :
      ν (closedEBall (z : X) (ε : ℝ≥0∞)) < ∞ :=
    (hball z).trans_lt <| ENNReal.rpow_lt_top_of_nonneg hm <| by
      exact ENNReal.div_ne_top
        ((hdiam z).trans_le le_top).ne (by norm_num)
  have hνA : ν A < ∞ := by
    refine (MeasureTheory.measure_mono hA_cover).trans_lt ?_
    refine (MeasureTheory.measure_iUnion_le
      (fun z : N => closedEBall (z : X) (ε : ℝ≥0∞))).trans_lt ?_
    rw [tsum_fintype]
    exact ENNReal.sum_lt_top.mpr fun z _ => hball_top z
  rw [simonHausdorffContent, simonHausdorffContentOuter]
  simp only [smul_apply, smul_eq_mul]
  exact ENNReal.mul_lt_top (by simp [realUnitBallVolume]) hνA

/-- Increasing the permitted covering diameter can only decrease Simon's
size approximant. -/
theorem simonHausdorffContent_antitone
    (m : ℝ) {δ₁ δ₂ : ℝ≥0∞} (hδ : δ₁ ≤ δ₂) (A : Set X) :
    simonHausdorffContent m δ₂ A ≤ simonHausdorffContent m δ₁ A := by
  have hcost : ∀ C : Set X,
      simonHausdorffCoverCost m δ₂ C ≤
        simonHausdorffCoverCost m δ₁ C := by
    intro C
    by_cases hC : ediam C < δ₁
    · have hC₂ : ediam C < δ₂ := hC.trans_le hδ
      have heq₁ :
            MeasureTheory.extend
              (fun C (_ : ediam C < δ₁) => (ediam C / 2) ^ m) C =
            (ediam C / 2) ^ m :=
        MeasureTheory.extend_eq
          (m := fun C (_ : ediam C < δ₁) => (ediam C / 2) ^ m)
          (s := C) hC
      have heq₂ :
            MeasureTheory.extend
              (fun C (_ : ediam C < δ₂) => (ediam C / 2) ^ m) C =
            (ediam C / 2) ^ m :=
        MeasureTheory.extend_eq
          (m := fun C (_ : ediam C < δ₂) => (ediam C / 2) ^ m)
          (s := C) hC₂
      simpa [simonHausdorffCoverCost, heq₁, heq₂]
    · have heq₁ :
          MeasureTheory.extend
              (fun C (_ : ediam C < δ₁) => (ediam C / 2) ^ m) C = ∞ :=
        MeasureTheory.extend_eq_top
          (m := fun C (_ : ediam C < δ₁) => (ediam C / 2) ^ m)
          (s := C) hC
      simpa [simonHausdorffCoverCost, heq₁] using
        (show simonHausdorffCoverCost m δ₂ C ≤ ∞ from le_top)
  have hb :
      MeasureTheory.OuterMeasure.boundedBy
          (simonHausdorffCoverCost (X := X) m δ₂) ≤
        MeasureTheory.OuterMeasure.boundedBy
          (simonHausdorffCoverCost (X := X) m δ₁) :=
    MeasureTheory.OuterMeasure.le_boundedBy.2 fun C =>
      (MeasureTheory.OuterMeasure.boundedBy_le C).trans (hcost C)
  rw [simonHausdorffContent, simonHausdorffContent,
    simonHausdorffContentOuter, simonHausdorffContentOuter]
  simp only [smul_apply, smul_eq_mul]
  exact mul_le_mul (le_refl _) (hb A) zero_le zero_le

/-- Simon (2.1), packaged as the supremum of the size-`δ` outer measures.
Thus the literal real-dimensional construction is kernel-checked to be an
outer measure, not merely recorded as a set function. -/
noncomputable def simonHausdorffOuterMeasureReal
    (m : ℝ) : MeasureTheory.OuterMeasure X :=
  ⨆ (δ : ℝ≥0∞), ⨆ (_ : 0 < δ),
    simonHausdorffContentOuter (X := X) m δ

/-- Simon (2.1), literally as the supremum of the size-`δ` approximants. -/
noncomputable def simonHausdorffOuterValue
    (m : ℝ) (A : Set X) : ℝ≥0∞ :=
  simonHausdorffOuterMeasureReal (X := X) m A

/-- Mathlib adapter for the standard real-dimensional Hausdorff measure with
Simon's normalization factor `ωₘ / 2^m`.  The exact source-side `δ` formula is
recorded separately in `simonHausdorffContent`. -/
noncomputable def simonHausdorffMeasureReal
    (m : ℝ) : MeasureTheory.Measure X :=
  (realUnitBallVolume m / (2 : ℝ≥0∞) ^ m) • μH[m]

/-- The legacy Mathlib Haar-normalized `n`-dimensional Hausdorff measure.
The literal Gamma-normalized construction is `simonHausdorffMeasureReal`;
their identification is proved below for dimensions zero and one. -/
noncomputable abbrev simonHausdorffMeasure (n : ℕ) : MeasureTheory.Measure X :=
  MeasureTheory.Measure.euclideanHausdorffMeasure n

/-- Metricity of the legacy Mathlib-normalized measure.  The literal
construction's metricity is `simonHausdorffOuterMeasureReal_isMetric`. -/
theorem simonHausdorffMeasure_isMetric (n : ℕ) :
    (simonHausdorffMeasure (X := X) n).toOuterMeasure.IsMetric := by
  have hbase :
      (MeasureTheory.Measure.hausdorffMeasure (X := X) (n : ℝ)).toOuterMeasure.IsMetric := by
    rw [MeasureTheory.Measure.hausdorffMeasure,
      MeasureTheory.Measure.mkMetric_toOuterMeasure]
    exact MeasureTheory.OuterMeasure.mkMetric'_isMetric _
  rw [simonHausdorffMeasure,
    MeasureTheory.Measure.euclideanHausdorffMeasure_def,
    MeasureTheory.Measure.smul_toOuterMeasure]
  intro A B hAB
  simp only [smul_apply]
  rw [hbase A B hAB, smul_add]

/-- Additivity on positively separated sets for the legacy Mathlib measure.
The all-real literal version of Simon (2.5) is proved below. -/
theorem simonHausdorffMeasure_union_of_areSeparated (n : ℕ)
    {A B : Set X} (hAB : Metric.AreSeparated A B) :
    simonHausdorffMeasure n (A ∪ B) =
      simonHausdorffMeasure n A + simonHausdorffMeasure n B := by
  change (simonHausdorffMeasure n).toOuterMeasure (A ∪ B) = _
  exact simonHausdorffMeasure_isMetric n A B hAB

/-- Borel regularity of the legacy Mathlib-normalized measure.  The literal
all-real statement (2.6) is `simonHausdorffOuterMeasureReal_isBorelRegular`. -/
theorem simonHausdorffMeasure_isBorelRegular (n : ℕ) :
    IsBorelRegularOuterMeasure
      (simonHausdorffMeasure (X := X) n).toOuterMeasure :=
  measure_toOuterMeasure_isBorelRegular _

/-- Simon (2.8), first characterizing property: Lebesgue measure of an open
coordinate box is the product of its side lengths. -/
theorem lebesgueMeasure_openBox (n : ℕ) (a b : Fin n → ℝ) :
    MeasureTheory.volume
        (Set.pi Set.univ fun i => Set.Ioo (a i) (b i)) =
      ∏ i, ENNReal.ofReal (b i - a i) :=
  Real.volume_pi_Ioo

/-- Simon (2.8), second characterizing property: Lebesgue outer measure is
the infimum of its values on open supersets, for every (not necessarily
measurable) set. -/
theorem lebesgueMeasure_eq_iInf_isOpen (n : ℕ)
    (A : Set (Fin n → ℝ)) :
    MeasureTheory.volume A =
      ⨅ (U : Set (Fin n → ℝ)) (_ : A ⊆ U) (_ : IsOpen U),
        MeasureTheory.volume U :=
  A.measure_eq_iInf_isOpen MeasureTheory.volume

/-- Mathlib's Haar-normalized Hausdorff measure equals Euclidean volume.
This alone does not identify the Gamma-normalized literal construction in
Simon (2.9), nor establish the source's fixed-positive-scale assertion. -/
theorem simonHausdorffMeasure_euclidean_eq_volume (n : ℕ) :
    (simonHausdorffMeasure n :
      MeasureTheory.Measure (EuclideanSpace ℝ (Fin n))) =
      MeasureTheory.volume :=
  EuclideanSpace.euclideanHausdorffMeasure_eq_volume n

/-- The zero-dimensional measure of a singleton is one, part of the discussion
following Simon (2.2). -/
@[simp] theorem simonHausdorffMeasure_zero_singleton (x : X) :
    simonHausdorffMeasure 0 ({x} : Set X) = 1 := by
  rw [simonHausdorffMeasure,
    MeasureTheory.Measure.euclideanHausdorffMeasure_zero,
    MeasureTheory.Measure.hausdorffMeasure_zero_singleton]

/-- Simon's Hausdorff measures are invariant under isometries.  This is the
coordinate-free form repeatedly used after (2.6). -/
theorem simonHausdorffMeasure_isometry_image
    {Y : Type*} [EMetricSpace Y] [MeasurableSpace Y] [BorelSpace Y]
    (n : ℕ) {f : X → Y} (hf : Isometry f) (A : Set X) :
    simonHausdorffMeasure n (f '' A) = simonHausdorffMeasure n A :=
  hf.euclideanHausdorffMeasure_image A

/-- Simon's homogeneity law for Hausdorff measure under nonzero scalar
dilations. -/
theorem simonHausdorffMeasure_smul
    {𝕜 E : Type*} [NormedAddCommGroup E] [NormedDivisionRing 𝕜]
    [Module 𝕜 E] [NormSMulClass 𝕜 E]
    [MeasurableSpace E] [BorelSpace E]
    (n : ℕ) {r : 𝕜} (hr : r ≠ 0) (A : Set E) :
    simonHausdorffMeasure n (r • A) =
      ‖r‖₊ ^ n • simonHausdorffMeasure n A :=
  MeasureTheory.Measure.euclideanHausdorffMeasure_smul₀ n hr A

omit [MeasurableSpace X] [BorelSpace X] in
/-- Strict and non-strict diameter bounds give the same limiting outer
measure.  The comparison uses an intermediate positive radius, and therefore
also handles the extended radius `∞`. -/
theorem outerMeasure_iSup_strictDiameter_eq_mkMetric'
    (q : Set X → ℝ≥0∞) :
    (⨆ (δ : ℝ≥0∞), ⨆ (_ : 0 < δ),
      MeasureTheory.OuterMeasure.boundedBy
        (MeasureTheory.extend (fun C (_ : ediam C < δ) => q C))) =
      MeasureTheory.OuterMeasure.mkMetric' q := by
  apply le_antisymm
  · refine iSup_le fun δ => iSup_le fun hδ => ?_
    obtain ⟨r, hr, hrδ⟩ := exists_between hδ
    apply le_trans ?_ (le_iSup₂_of_le r hr le_rfl)
    apply MeasureTheory.OuterMeasure.mkMetric'.le_pre.mpr
    intro C hC
    exact (MeasureTheory.OuterMeasure.boundedBy_le C).trans_eq
      (MeasureTheory.extend_eq (fun C (_ : ediam C < δ) => q C) (hC.trans_lt hrδ))
  · refine iSup_le fun δ => iSup_le fun hδ => ?_
    apply le_trans ?_ (le_iSup₂_of_le δ hδ le_rfl)
    apply MeasureTheory.OuterMeasure.le_boundedBy.mpr
    intro C
    by_cases hC : ediam C < δ
    · rw [MeasureTheory.extend_eq (fun C (_ : ediam C < δ) => q C) hC]
      exact MeasureTheory.OuterMeasure.mkMetric'.pre_le hC.le
    · rw [MeasureTheory.extend_eq_top (fun C (_ : ediam C < δ) => q C) hC]
      exact le_top

omit [MeasurableSpace X] [BorelSpace X] in
/-- The literal strict-cover definition is precisely the metric outer
measure generated by the radius cost `(diam / 2)^m`, scaled by `ω_m`. -/
theorem simonHausdorffOuterMeasureReal_eq_smul_mkMetric (m : ℝ) :
    simonHausdorffOuterMeasureReal (X := X) m =
      realUnitBallVolume m •
        MeasureTheory.OuterMeasure.mkMetric (fun d => (d / 2) ^ m) := by
  unfold simonHausdorffOuterMeasureReal simonHausdorffContentOuter
    simonHausdorffCoverCost
  have h := congrArg (fun ν : MeasureTheory.OuterMeasure X => realUnitBallVolume m • ν)
    (outerMeasure_iSup_strictDiameter_eq_mkMetric' (fun C : Set X => (ediam C / 2) ^ m))
  simpa only [MeasureTheory.OuterMeasure.smul_iSup,
    MeasureTheory.OuterMeasure.mkMetric] using h

/-- Exact normalization bridge for every real `m ≥ 0`, including `m = 0`:
the literal outer measure equals `(ω_m / 2^m)` times Mathlib's unnormalized
Hausdorff outer measure. -/
theorem simonHausdorffOuterMeasureReal_eq_scaled_hausdorffMeasure
    {m : ℝ} (hm : 0 ≤ m) :
    simonHausdorffOuterMeasureReal (X := X) m =
      (realUnitBallVolume m / (2 : ℝ≥0∞) ^ m) •
        (MeasureTheory.Measure.hausdorffMeasure (X := X) m).toOuterMeasure := by
  have hpow0 : (2 : ℝ≥0∞) ^ m ≠ 0 := by simp
  have hpowfin : (2 : ℝ≥0∞) ^ m ≠ ∞ := by simp
  have hfun : (fun d : ℝ≥0∞ => (d / 2) ^ m) =
      ((2 : ℝ≥0∞) ^ m)⁻¹ • (fun d : ℝ≥0∞ => d ^ m) := by
    funext d
    rw [ENNReal.div_rpow_of_nonneg d 2 hm]
    simp only [Pi.smul_apply, smul_eq_mul, div_eq_mul_inv, mul_comm]
  rw [simonHausdorffOuterMeasureReal_eq_smul_mkMetric, hfun,
    MeasureTheory.OuterMeasure.mkMetric_smul _ (ENNReal.inv_ne_top.mpr hpow0)
      (ENNReal.inv_ne_zero.mpr hpowfin), smul_smul]
  rw [MeasureTheory.Measure.hausdorffMeasure,
    MeasureTheory.Measure.mkMetric_toOuterMeasure]
  rfl

/-- The normalized real-dimensional Borel measure has exactly Simon's
literal outer measure, including evaluation on arbitrary nonmeasurable sets. -/
theorem simonHausdorffMeasureReal_toOuterMeasure {m : ℝ} (hm : 0 ≤ m) :
    (simonHausdorffMeasureReal (X := X) m).toOuterMeasure =
      simonHausdorffOuterMeasureReal (X := X) m := by
  rw [simonHausdorffMeasureReal, MeasureTheory.Measure.smul_toOuterMeasure,
    simonHausdorffOuterMeasureReal_eq_scaled_hausdorffMeasure hm]

/-- Setwise form of the exact literal-construction identification. -/
theorem simonHausdorffOuterValue_eq_simonHausdorffMeasureReal
    {m : ℝ} (hm : 0 ≤ m) (A : Set X) :
    simonHausdorffOuterValue m A = simonHausdorffMeasureReal m A := by
  rw [simonHausdorffOuterValue, ← simonHausdorffMeasureReal_toOuterMeasure hm]
  rfl

omit [MeasurableSpace X] [BorelSpace X] in
/-- The literal real-dimensional outer measure is metric; no integer
dimension restriction or normalization identification with Euclidean volume
is involved. -/
theorem simonHausdorffOuterMeasureReal_isMetric (m : ℝ) :
    (simonHausdorffOuterMeasureReal (X := X) m).IsMetric := by
  rw [simonHausdorffOuterMeasureReal_eq_smul_mkMetric]
  intro A B hAB
  simp only [smul_apply, MeasureTheory.OuterMeasure.mkMetric]
  rw [MeasureTheory.OuterMeasure.mkMetric'_isMetric _ A B hAB, smul_add]

omit [MeasurableSpace X] [BorelSpace X] in
/-- Simon (2.5) for the literal construction, in every real dimension. -/
theorem simonHausdorffOuterValue_union_of_areSeparated (m : ℝ)
    {A B : Set X} (hAB : Metric.AreSeparated A B) :
    simonHausdorffOuterValue m (A ∪ B) =
      simonHausdorffOuterValue m A + simonHausdorffOuterValue m B :=
  simonHausdorffOuterMeasureReal_isMetric m A B hAB

omit [MeasurableSpace X] [BorelSpace X] in
/-- Simon (2.5) with the source's positive set-distance hypothesis. -/
theorem simonHausdorffOuterValue_union_of_pos_setEDist (m : ℝ)
    {A B : Set X} (hAB : 0 < simonSetEDist A B) :
    simonHausdorffOuterValue m (A ∪ B) =
      simonHausdorffOuterValue m A + simonHausdorffOuterValue m B := by
  apply simonHausdorffOuterValue_union_of_areSeparated m
  refine ⟨simonSetEDist A B, hAB.ne', fun x hx y hy => ?_⟩
  exact iInf_le_of_le ⟨x, hx⟩ <| iInf_le_of_le ⟨y, hy⟩ le_rfl

omit [MeasurableSpace X] [BorelSpace X] in
/-- Simon (2.6) for the literal construction in every real `m ≥ 0`:
all Borel sets are Caratheodory measurable and every subset has an
equal-measure Borel hull. -/
theorem simonHausdorffOuterMeasureReal_isBorelRegular {m : ℝ} (hm : 0 ≤ m) :
    IsBorelRegularOuterMeasure (simonHausdorffOuterMeasureReal (X := X) m) := by
  let : MeasurableSpace X := borel X
  let : BorelSpace X := ⟨rfl⟩
  rw [← simonHausdorffMeasureReal_toOuterMeasure hm]
  exact measure_toOuterMeasure_isBorelRegular _

/-- Simon's normalization constant is strictly positive in its source domain. -/
theorem realUnitBallVolume_pos {m : ℝ} (hm : 0 ≤ m) : 0 < realUnitBallVolume m := by
  rw [realUnitBallVolume, ENNReal.ofReal_pos]
  exact div_pos (Real.rpow_pos_of_pos Real.pi_pos _)
    (Real.Gamma_pos_of_pos (by linarith))

/-- The normalizing volume of the Euclidean unit ball is finite for every
real dimension parameter. -/
theorem realUnitBallVolume_ne_top (m : ℝ) : realUnitBallVolume m ≠ ∞ := by
  exact ENNReal.ofReal_ne_top

/-- The zero-dimensional normalization constant is one. -/
@[simp] theorem realUnitBallVolume_zero : realUnitBallVolume 0 = 1 := by
  simp [realUnitBallVolume, Real.Gamma_one]

/-- The one-dimensional normalization constant is the length two of the
unit interval. -/
@[simp] theorem realUnitBallVolume_one : realUnitBallVolume 1 = 2 := by
  have h : Real.pi ^ ((1 : ℝ) / 2) / Real.Gamma (1 / 2 + 1) = 2 := by
    rw [Real.Gamma_add_one (by norm_num : (1 : ℝ) / 2 ≠ 0),
      Real.Gamma_one_half_eq, ← Real.sqrt_eq_rpow]
    field_simp [(Real.sqrt_pos.mpr Real.pi_pos).ne']
  simpa only [realUnitBallVolume, h] using (ENNReal.ofReal_ofNat (n := 2))

/-- At dimension zero the literal normalized Borel measure agrees with
the older normalized API on every extended metric space. -/
theorem simonHausdorffMeasureReal_zero :
    simonHausdorffMeasureReal (X := X) 0 = simonHausdorffMeasure 0 := by
  simp [simonHausdorffMeasureReal, simonHausdorffMeasure,
    MeasureTheory.Measure.euclideanHausdorffMeasure_zero]

/-- At dimension one Simon's constant and Mathlib's Haar normalization
agree.  This argument uses the already proved one-dimensional length theorem,
not a higher-dimensional isodiametric assertion. -/
theorem simonHausdorffMeasureReal_one :
    simonHausdorffMeasureReal (X := X) 1 = simonHausdorffMeasure 1 := by
  have hreal : (simonHausdorffMeasure 1 : MeasureTheory.Measure ℝ) =
      MeasureTheory.volume := by
    simpa only [simonHausdorffMeasure, Module.finrank_self] using
      (InnerProductSpace.euclideanHausdorffMeasure_eq_volume (V := ℝ))
  have hc := congrArg (fun ν : MeasureTheory.Measure ℝ => ν (Ioo 0 1)) hreal
  rw [simonHausdorffMeasure, MeasureTheory.Measure.euclideanHausdorffMeasure_def] at hc
  simp only [MeasureTheory.Measure.smul_apply, Nat.cast_one,
    MeasureTheory.hausdorffMeasure_real, Real.volume_Ioo, sub_zero,
    ENNReal.ofReal_one, ENNReal.smul_def, smul_eq_mul, mul_one] at hc
  have hc' := ENNReal.coe_eq_one.mp hc
  rw [simonHausdorffMeasureReal, realUnitBallVolume_one, simonHausdorffMeasure,
    MeasureTheory.Measure.euclideanHausdorffMeasure_def]
  norm_num [hc']
  rw [ENNReal.div_self (by norm_num) (by norm_num), one_smul]

/-- In every natural dimension the literal construction is a precisely
specified scalar multiple of Euclidean volume.  Proving that this scalar is
one in general is the remaining geometric normalization problem; it is not
assumed or silently absorbed into the definition. -/
theorem simonHausdorffOuterMeasureReal_nat_eq_smul_volume (n : ℕ) :
    simonHausdorffOuterMeasureReal (X := EuclideanSpace ℝ (Fin n)) (n : ℝ) =
      ((realUnitBallVolume (n : ℝ) / (2 : ℝ≥0∞) ^ (n : ℝ)) *
        (MeasureTheory.Measure.addHaarScalarFactor
          (μH[(n : ℝ)] : MeasureTheory.Measure (EuclideanSpace ℝ (Fin n)))
          MeasureTheory.volume : ℝ≥0∞)) •
        (MeasureTheory.volume : MeasureTheory.Measure (EuclideanSpace ℝ (Fin n))).toOuterMeasure := by
  rw [simonHausdorffOuterMeasureReal_eq_scaled_hausdorffMeasure (by positivity)]
  have h := MeasureTheory.Measure.isAddLeftInvariant_eq_smul
    (μH[(n : ℝ)] : MeasureTheory.Measure (EuclideanSpace ℝ (Fin n))) MeasureTheory.volume
  conv_lhs => rw [h]
  rw [MeasureTheory.Measure.smul_toOuterMeasure, ENNReal.smul_def, smul_smul]

/-- The literal zero-dimensional Hausdorff outer measure on Euclidean
zero-space agrees with volume. -/
theorem simonHausdorffOuterMeasureReal_euclidean_zero_eq_volume :
    simonHausdorffOuterMeasureReal (X := EuclideanSpace ℝ (Fin 0)) 0 =
      (MeasureTheory.volume : MeasureTheory.Measure (EuclideanSpace ℝ (Fin 0))).toOuterMeasure := by
  rw [← simonHausdorffMeasureReal_toOuterMeasure (by norm_num),
    simonHausdorffMeasureReal_zero, simonHausdorffMeasure_euclidean_eq_volume]

/-- The literal one-dimensional Hausdorff outer measure on Euclidean
one-space agrees with length. -/
theorem simonHausdorffOuterMeasureReal_euclidean_one_eq_volume :
    simonHausdorffOuterMeasureReal (X := EuclideanSpace ℝ (Fin 1)) 1 =
      (MeasureTheory.volume : MeasureTheory.Measure (EuclideanSpace ℝ (Fin 1))).toOuterMeasure := by
  rw [← simonHausdorffMeasureReal_toOuterMeasure (by norm_num),
    simonHausdorffMeasureReal_one, simonHausdorffMeasure_euclidean_eq_volume]

end Poincare.SimonGMT.Chapter01
