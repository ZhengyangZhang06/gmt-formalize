        set y₁ : ℝ := (c₁ : ℝ) * κ with hy₁def
        have hc₁0 : (0 : ℝ) ≤ c₁ := c₁.coe_nonneg
        have hy₁0 : 0 ≤ y₁ := by positivity
        have hApos : 0 < (CΦ + 1) ^ (m' + 2) := by positivity
        have hA1 : 1 ≤ (CΦ + 1) ^ (m' + 2) := one_le_pow₀ (by linarith)
