      obtain ⟨Y', hY'ω, hY'm, -⟩ := hresX A hA
      obtain ⟨R, hR⟩ := hAb.subset_closedBall 0
      obtain ⟨φ, hφs, hφc, hφ1, hφ0, hφle⟩ : ∃ φ : Eucl N → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) φ ∧ HasCompactSupport φ ∧
