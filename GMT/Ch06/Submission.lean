        simp only
        ring
      refine ⟨?_, ?_⟩
      · simp_rw [hv₁apply]
        rw [← IntegrableOn, skp_oface_integrable_iff]
        simpa [skpProj_chart] using hcube_int
      · simp_rw [hv₁apply]
        rw [hμ₁, skp_oface_integral, hXω]
