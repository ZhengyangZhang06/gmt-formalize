  -- Monotonicity of the products `c_k · b · x^k · y` used for the constant `C(m, ℓ)`.
  have constLe : ∀ (cK c₀ bb B x X₀ y Y : ℝ) (k n : ℕ), 0 ≤ cK → cK ≤ c₀ → 0 ≤ bb → bb ≤ B → 0 ≤ x →
