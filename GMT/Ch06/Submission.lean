        · have : F.1 i < ⌊x i⌋ + 2 := by exact_mod_cast c1
          omega
    apply Set.Finite.subset ((Fintype.piFinset fun i => Finset.Icc (⌊x i⌋ - 2) (⌊x i⌋ + 1)) ×ˢ
