  -- admissible radii for the Besicovitch covering
  let fadm : Eucl P → Set ℝ := fun x => {r | 0 < r ∧ μ (sphere x r) = 0 ∧
    ∃ Sr : GeometricCurrentOn (univ : Set (Eucl P)) (m + 1),
