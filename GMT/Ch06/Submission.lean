    -- Step 5a: the rescaled integrand vanishes for `‖c‖ > R'` (lower bound on `T`).
    have van1 : ∀ r : ℝ, 0 < r → ∀ c : Eucl (m + 1), R' < ‖c‖ →
        h (b + r • c) * f (blowUpMap x r (G (b + r • c))) = 0 := by
      intro r hr c hc
      by_cases hmem : b + r • c ∈ A
      · have hlb := hlow (b + r • c) hmem.1 b hbT
        rw [add_sub_cancel_left, norm_smul, Real.norm_eq_abs, abs_of_pos hr] at hlb
        have hfz : f (blowUpMap x r (G (b + r • c))) = 0 := by
          apply hfR
          rw [blowUpMap, norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hr, le_inv_mul_iff₀ hr]
          have h1 : κ₀ ≤ κ := min_le_left _ _
          have h2 : R < κ₀ * ‖c‖ := by rw [← hκ₀R']; exact mul_lt_mul_of_pos_left hc hκ₀
          have h3 : κ₀ * ‖c‖ ≤ κ * ‖c‖ := mul_le_mul_of_nonneg_right h1 (norm_nonneg _)
          nlinarith
        rw [hfz, mul_zero]
      · rw [hh, indicator_of_notMem hmem, zero_mul]
    -- Step 5b: the model integrand vanishes for `‖c‖ > R'`.
    have van2 : ∀ c : Eucl (m + 1), R' < ‖c‖ → f (L c) = 0 := by
      intro c hc
      apply hfR
      have h1 : κ₀ ≤ (KL : ℝ)⁻¹ := min_le_right _ _
      have h2 : R < κ₀ * ‖c‖ := by rw [← hκ₀R']; exact mul_lt_mul_of_pos_left hc hκ₀
      have h3 : κ₀ * ‖c‖ ≤ (KL : ℝ)⁻¹ * ‖c‖ := mul_le_mul_of_nonneg_right h1 (norm_nonneg _)
      have h4 : (KL : ℝ)⁻¹ * ‖c‖ ≤ ‖L c‖ := by
        rw [inv_mul_le_iff₀ hKL0]; exact hLlow c
      linarith
    set B : Set (Eucl (m + 1)) := closedBall 0 R' with hBdef
    have hBc : ∀ c, c ∉ B → R' < ‖c‖ := fun c hc => by
      rw [hBdef, mem_closedBall_zero_iff, not_le] at hc; exact hc
    have hBfin : volume B ≠ ∞ := measure_closedBall_lt_top.ne
    -- Integrability of the rescaled density.
    have hhcomp : ∀ r : ℝ, 0 < r → Integrable (fun c => h (b + r • c)) volume := fun r hr =>
      (hint.comp_add_left b).comp_smul hr.ne'
    -- Step 5e: Lebesgue point estimate.
    set ω : ℝ := volume.real (closedBall (0 : Eucl (m + 1)) 1) with hωdef
    have hvolball : ∀ ρ : ℝ, 0 ≤ ρ → volume.real (closedBall b ρ) = ρ ^ (m + 1) * ω := by
      intro ρ hρ
      rw [measureReal_def, Measure.addHaar_closedBall' volume b hρ, hfin, ENNReal.toReal_mul,
        ENNReal.toReal_ofReal (pow_nonneg hρ _), hωdef, measureReal_def]
    have step5e :
        Tendsto (fun r : ℝ => ∫ c in B, |h (b + r • c) - h b| ∂volume) (𝓝[>] 0) (𝓝 0) := by
      have hlim := (hleb R' hR').const_mul (R' ^ (m + 1) * ω)
      rw [mul_zero] at hlim
      refine hlim.congr' ?_
      filter_upwards [self_mem_nhdsWithin] with r hr
      have hr0 : (0 : ℝ) < r := hr
      have hρ : 0 ≤ R' * r := by positivity
      have hvpos : 0 < volume.real (closedBall b (R' * r)) := by
        rw [hvolball _ hρ]
        have : 0 < ω := by
          rw [hωdef, measureReal_def]
          exact ENNReal.toReal_pos (measure_closedBall_pos volume 0 one_pos).ne'
            measure_closedBall_lt_top.ne
        positivity
      symm
      calc ∫ c in B, |h (b + r • c) - h b| ∂volume
          = ∫ c, (closedBall b (R' * r)).indicator (fun z => |h z - h b|) (b + r • c) ∂volume := by
            rw [← integral_indicator measurableSet_closedBall]
            congr 1
            funext c
            by_cases hc : c ∈ B
            · have hc' : b + r • c ∈ closedBall b (R' * r) := by
                rw [mem_closedBall, dist_eq_norm, add_sub_cancel_left, norm_smul,
                  Real.norm_eq_abs, abs_of_pos hr0]
                rw [hBdef, mem_closedBall_zero_iff] at hc
                nlinarith
              rw [indicator_of_mem hc, indicator_of_mem hc']
            · have hc' : b + r • c ∉ closedBall b (R' * r) := by
                rw [mem_closedBall, dist_eq_norm, add_sub_cancel_left, norm_smul,
                  Real.norm_eq_abs, abs_of_pos hr0, not_le]
                have := hBc c hc
                nlinarith
              rw [indicator_of_notMem hc, indicator_of_notMem hc']
        _ = (r ^ (m + 1))⁻¹ * ∫ z in closedBall b (R' * r), |h z - h b| ∂volume := by
            rw [hDscale _ r hr0, integral_indicator measurableSet_closedBall]
        _ = (r ^ (m + 1))⁻¹ * (volume.real (closedBall b (R' * r)) *
              ⨍ z in closedBall b (R' * r), ‖h z - h b‖) := by
            rw [setAverage_eq, smul_eq_mul, mul_inv_cancel_left₀ hvpos.ne']
            simp only [Real.norm_eq_abs]
        _ = R' ^ (m + 1) * ω * ⨍ z in closedBall b (R' * r), ‖h z - h b‖ := by
            rw [hvolball _ hρ, mul_pow]
            field_simp
    -- Step 5f: the oscillation term tends to zero.
    have step5f : Tendsto (fun r : ℝ => ∫ c in B, (h (b + r • c) - h b) *
        f (blowUpMap x r (G (b + r • c))) ∂volume) (𝓝[>] 0) (𝓝 0) := by
      have hlim := step5e.const_mul C
      rw [mul_zero] at hlim
      refine squeeze_zero_norm' ?_ hlim
      filter_upwards [self_mem_nhdsWithin] with r hr
      have hr0 : (0 : ℝ) < r := hr
      rw [← integral_const_mul]
      refine norm_integral_le_of_norm_le ?_ (Eventually.of_forall fun c => ?_)
      · exact (((hhcomp r hr0).integrableOn.sub (integrableOn_const hBfin)).abs).const_mul C
      · rw [norm_mul, Real.norm_eq_abs, mul_comm]
        exact mul_le_mul_of_nonneg_right (hC _) (abs_nonneg _)
    -- Step 5g: dominated convergence for the blown-up parametrization.
    have step5g : Tendsto (fun r : ℝ => ∫ c in B, f (blowUpMap x r (G (b + r • c))) ∂volume)
        (𝓝[>] 0) (𝓝 (∫ c in B, f (L c) ∂volume)) := by
      refine tendsto_integral_filter_of_dominated_convergence (fun _ => C)
        (Eventually.of_forall fun r => (hcontΔ r).aestronglyMeasurable)
        (Eventually.of_forall fun r => Eventually.of_forall fun c => hC _)
        (integrableOn_const hBfin) (Eventually.of_forall fun c => ?_)
      have hd : HasDerivAt (fun t : ℝ => b + t • c) c 0 := by
        simpa using ((hasDerivAt_id (0 : ℝ)).smul_const c).const_add b
      have hLd' : HasFDerivAt G L (b + (0 : ℝ) • c) := by simpa using hLd
      have hcomp := (hLd'.comp_hasDerivAt (0 : ℝ) hd).tendsto_slope_zero_right
      have hlim : Tendsto (fun t : ℝ => blowUpMap x t (G (b + t • c))) (𝓝[>] 0) (𝓝 (L c)) := by
        refine hcomp.congr' (Eventually.of_forall fun t => ?_)
        simp [blowUpMap, hx]
      exact (f.continuous.tendsto _).comp hlim
    -- Step 5: the parametrized part converges to the model integral.
    have step5 : Tendsto
        (fun r : ℝ => ∫ c, h (b + r • c) * f (blowUpMap x r (G (b + r • c))) ∂volume)
        (𝓝[>] 0) (𝓝 (h b * ∫ c, f (L c) ∂volume)) := by
      have hmodel : ∫ c, f (L c) ∂volume = ∫ c in B, f (L c) ∂volume :=
        (setIntegral_eq_integral_of_forall_compl_eq_zero fun c hc => van2 c (hBc c hc)).symm
      rw [hmodel]
      have hlim := step5f.add (step5g.const_mul (h b))
      rw [zero_add] at hlim
      refine hlim.congr' ?_
      filter_upwards [self_mem_nhdsWithin] with r hr
      have hr0 : (0 : ℝ) < r := hr
      rw [← setIntegral_eq_integral_of_forall_compl_eq_zero fun c hc => van1 r hr0 c (hBc c hc),
        ← integral_const_mul, ← integral_add]
      · congr 1
        funext c
        ring
      · exact (((hhcomp r hr0).integrableOn.sub (integrableOn_const hBfin)).mul_bdd
          (hcontΔ r).aestronglyMeasurable (Eventually.of_forall fun c => hC _))
      · exact (((hcontΔ r).continuousOn.integrableOn_compact (isCompact_closedBall _ _)).const_mul
          (h b))
    -- Step 6: the part of `M` off the parametrized piece has density zero at `x`.
    have step6 : Tendsto (fun r : ℝ => (r ^ (m + 1))⁻¹ * ∫ z in S, f (blowUpMap x r z) * θ z ∂μ)
        (𝓝[>] 0) (𝓝 0) := by
      have hRr : Tendsto (fun r : ℝ => R * r) (𝓝[>] 0) (𝓝[>] 0) := by
        refine tendsto_nhdsWithin_iff.2 ⟨?_, ?_⟩
        · have hc : Continuous fun r : ℝ => R * r := by fun_prop
          have := hc.tendsto 0
          simp only [mul_zero] at this
          exact this.mono_left nhdsWithin_le_nhds
        · filter_upwards [self_mem_nhdsWithin] with r hr
          exact mul_pos hR hr
      have hlim := (hdens.comp hRr).const_mul (C * R ^ (m + 1))
      rw [mul_zero] at hlim
      refine squeeze_zero_norm' ?_ hlim
      filter_upwards [self_mem_nhdsWithin] with r hr
      have hr0 : (0 : ℝ) < r := hr
      have hvanS : ∀ z, z ∉ closedBall x (R * r) → f (blowUpMap x r z) * θ z = 0 := by
        intro z hz
        rw [mem_closedBall, dist_eq_norm, not_le] at hz
        rw [hfR, zero_mul]
        rw [blowUpMap, norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hr0, le_inv_mul_iff₀ hr0]
        nlinarith
      have hcut : ∫ z in S, f (blowUpMap x r z) * θ z ∂μ =
          ∫ z in S ∩ closedBall x (R * r), f (blowUpMap x r z) * θ z ∂μ := by
        rw [inter_comm, ← Measure.restrict_restrict measurableSet_closedBall,
          setIntegral_eq_integral_of_forall_compl_eq_zero hvanS]
      have hθS : IntegrableOn θ (S ∩ closedBall x (R * r)) μ :=
        hθ.mono_set (inter_subset_left.trans sdiff_subset)
      have hbound : ‖∫ z in S ∩ closedBall x (R * r), f (blowUpMap x r z) * θ z ∂μ‖ ≤
          C * ∫ z in S ∩ closedBall x (R * r), |θ z| ∂μ := by
        rw [← integral_const_mul]
        refine norm_integral_le_of_norm_le (hθS.abs.const_mul C) (Eventually.of_forall fun z => ?_)
        rw [norm_mul, Real.norm_eq_abs (θ z)]
        exact mul_le_mul_of_nonneg_right (hC _) (abs_nonneg _)
      rw [hcut, norm_mul, norm_inv, norm_pow, Real.norm_eq_abs, abs_of_pos hr0]
      calc (r ^ (m + 1))⁻¹ * ‖∫ z in S ∩ closedBall x (R * r), f (blowUpMap x r z) * θ z ∂μ‖
          ≤ (r ^ (m + 1))⁻¹ * (C * ∫ z in S ∩ closedBall x (R * r), |θ z| ∂μ) :=
            mul_le_mul_of_nonneg_left hbound (by positivity)
        _ = C * R ^ (m + 1) *
            ((∫ z in S ∩ closedBall x (R * r), |θ z| ∂μ) / (R * r) ^ (m + 1)) := by
            rw [mul_pow]
            field_simp
    -- Step 7: the limit is `θ(x) ∫_{L(ℝⁿ)} f dHⁿ`.
    have step7 : h b * ∫ c, f (L c) ∂volume =
        θ x * ∫ y in (LinearMap.range (L : Eucl (m + 1) →ₗ[ℝ] Eucl P) : Set (Eucl P)), f y ∂μ := by
      rw [hlinear L hLinj f, hh, indicator_of_mem (show b ∈ A from ⟨hbT, hbM⟩),
        Poincare.SimonGMT.Chapter02.areaJacobianAt_eq_normDet]
      ring
    rw [← step7]
    have hmain := step5.add step6
    rw [add_zero] at hmain
    refine hmain.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with r hr
    have hr0 : (0 : ℝ) < r := hr
    rw [step1 r hr0, step2 r, mul_add, step3 r, step4 r hr0]
  -- The case of a Borel `M` with `θ ∈ L¹(Hⁿ⌞M)`.
  have hcore : ∀ (M : Set (Eucl P)) (θ : Eucl P → ℝ), MeasurableSet M →
      IntegrableOn θ M (μHE[m + 1] : Measure (Eucl P)) → CountablyRectifiable (m + 1) M →
      ∀ᵐ x ∂((μHE[m + 1] : Measure (Eucl P)).restrict M), ∃ V : Submodule ℝ (Eucl P),
        HasWeightedApproximateTangentSpaceAt (m + 1) M θ x V := by
    intro M θ hM hθ hrect
    set μ := (μHE[m + 1] : Measure (Eucl P)) with hμ
    obtain ⟨N, hN, G, T, κ, hGlip, hTmeas, hκ, hreg, hlow, hcov⟩ := hparam M hrect
    have hfin : Module.finrank ℝ (Eucl (m + 1)) = m + 1 := finrank_euclideanSpace_fin
    have hvol : (μHE[m + 1] : Measure (Eucl (m + 1))) = volume := by
      have := InnerProductSpace.euclideanHausdorffMeasure_eq_volume (V := Eucl (m + 1))
      rwa [hfin] at this
    have hp : ∀ p, ∀ᵐ x ∂μ.restrict (M ∩ G p '' T p), ∃ V : Submodule ℝ (Eucl P),
        HasWeightedApproximateTangentSpaceAt (m + 1) M θ x V := by
      intro p
      obtain ⟨K, hK⟩ := hGlip p
      have hinjT : InjOn (G p) (T p) := by
        intro b₁ h₁ b₂ h₂ he
        have h12 := hlow p b₁ h₁ b₂ h₂
        rw [he, sub_self, norm_zero] at h12
        have h0 : ‖b₁ - b₂‖ ≤ 0 := by nlinarith [norm_nonneg (b₁ - b₂), hκ p]
        exact sub_eq_zero.1 (norm_le_zero_iff.1 h0)
      have hY : MeasurableSet (G p '' T p) :=
        (hTmeas p).image_of_continuousOn_injOn hK.continuous.continuousOn hinjT
      set A := T p ∩ G p ⁻¹' M with hAdef
      have hA : MeasurableSet A := (hTmeas p).inter (hK.continuous.measurable hM)
      set h := A.indicator
        (fun c => Poincare.SimonGMT.Chapter02.areaJacobianAt (G p) c * θ (G p c)) with hh
      have hhint : Integrable h volume := by
        rw [hh, integrable_indicator_iff hA]
        have hGA : G p '' A = M ∩ G p '' T p := by
          rw [hAdef, image_inter_preimage, inter_comm]
        have himg :=
          (Poincare.SimonGMT.Chapter02.integrableOn_image_iff_integrableOn_areaJacobian_smul
            hA (fun c hc => (hreg p c hc.1).1) (fun c hc => (hreg p c hc.1).2)
            (hinjT.mono inter_subset_left) θ).1
        rw [hfin, hvol] at himg
        simpa only [smul_eq_mul] using himg (hθ.mono_set (hGA ▸ inter_subset_left))
      -- Lebesgue points of `h`.
      have hleb_ae : ∀ᵐ c ∂(volume : Measure (Eucl (m + 1))), ∀ t : ℝ, 0 < t →
          Tendsto (fun r : ℝ => ⨍ z in closedBall c (t * r), ‖h z - h c‖) (𝓝[>] 0) (𝓝 0) := by
        filter_upwards [IsUnifLocDoublingMeasure.ae_tendsto_average_norm_sub volume
          hhint.locallyIntegrable 1] with c hc t ht
        refine hc (fun _ => c) (fun r => t * r) ?_ ?_
        · refine tendsto_nhdsWithin_iff.2 ⟨?_, ?_⟩
          · have hcont : Continuous fun r : ℝ => t * r := by fun_prop
            have := hcont.tendsto 0
            simp only [mul_zero] at this
            exact this.mono_left nhdsWithin_le_nhds
          · filter_upwards [self_mem_nhdsWithin] with r hr
            exact mul_pos ht hr
        · filter_upwards [self_mem_nhdsWithin] with r hr
          rw [one_mul]
          exact mem_closedBall_self (mul_pos ht hr).le
      -- Zero density of the rest of `M` at almost every point of the piece.
      have hdens_ae := hdensity θ (M \ G p '' T p) (hM.diff hY) (hθ.mono_set sdiff_subset)
      -- Images of non-Lebesgue points are null.
      set Abad := {c | c ∈ A ∧ ¬ ∀ t : ℝ, 0 < t →
        Tendsto (fun r : ℝ => ⨍ z in closedBall c (t * r), ‖h z - h c‖) (𝓝[>] 0) (𝓝 0)}
        with hAbaddef
      have hAbad : (volume : Measure (Eucl (m + 1))) Abad = 0 :=
        measure_mono_null (fun c hc => hc.2) (ae_iff.1 hleb_ae)
      have hGAbad : μ (G p '' Abad) = 0 := by
        have := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn
          (m + 1) (hK.lipschitzOnWith (s := Abad))
        rw [hvol, hAbad, mul_zero] at this
        exact le_antisymm this bot_le
      have hbad : ∀ᵐ x ∂μ, x ∉ G p '' Abad := measure_eq_zero_iff_ae_notMem.1 hGAbad
      filter_upwards [ae_restrict_of_ae hbad, ae_restrict_of_ae hdens_ae,
        ae_restrict_mem (hM.inter hY)] with x hx1 hx2 hx3
      obtain ⟨c, hcT, rfl⟩ := hx3.2
      have hcA : c ∈ A := ⟨hcT, hx3.1⟩
      have hcleb : ∀ t : ℝ, 0 < t →
          Tendsto (fun r : ℝ => ⨍ z in closedBall c (t * r), ‖h z - h c‖) (𝓝[>] 0) (𝓝 0) := by
        by_contra hcon
        exact hx1 ⟨c, ⟨hcA, hcon⟩, rfl⟩
      have hcdens := hx2 (fun hmem => hmem.2 ⟨c, hcT, rfl⟩)
      exact ⟨_, hblowup M θ hM hθ (G p) K hK (T p) (hTmeas p) (κ p) (hκ p) (hreg p) (hlow p) h hh
        hhint c hcT hx3.1 hcleb hcdens⟩
    have hMcov : M ⊆ N ∪ ⋃ p, M ∩ G p '' T p := by
      intro x hx
      rcases hcov hx with h0 | h1
      · exact Or.inl h0
      · obtain ⟨p, hp⟩ := mem_iUnion.1 h1
        exact Or.inr (mem_iUnion.2 ⟨p, hx, hp⟩)
    refine ae_restrict_of_ae_restrict_of_subset hMcov ?_
    rw [ae_restrict_union_iff]
    refine ⟨?_, (ae_restrict_iUnion_iff _ _).2 hp⟩
    rw [Measure.restrict_eq_zero.2 hN, ae_zero]
    exact Filter.eventually_bot
  -- Localization to `M ∩ W_q`, `W_q ⊂⊂ U`, and to a Borel subset of full measure.
  intro U M θ hU hMU hMm hrect hpos hint
  set μ := (μHE[m + 1] : Measure (Eucl P)) with hμ
  obtain ⟨W, hWcc, hWcov⟩ := Submission.cmb_exists_compactly_contained_exhaustion P U hU
  have hloc : ∀ q, ∀ᵐ x ∂μ.restrict (M ∩ W q), ∃ V : Submodule ℝ (Eucl P),
      HasWeightedApproximateTangentSpaceAt (m + 1) M θ x V := by
    intro q
    obtain ⟨hWo, hWc, hWU⟩ := hWcc q
    have hMq : NullMeasurableSet (M ∩ W q) μ := hMm.inter hWo.measurableSet.nullMeasurableSet
    obtain ⟨M', hM'sub, hM'meas, hM'ae⟩ := hMq.exists_measurable_subset_ae_eq
    have hθM' : IntegrableOn θ M' μ :=
      (hint _ hWc hWU).mono_set (hM'sub.trans (inter_subset_inter_right _ subset_closure))
    have hcore := hcore M' θ hM'meas hθM' (hrect.mono (hM'sub.trans inter_subset_left))
    rw [← Measure.restrict_congr_set hM'ae]
    filter_upwards [hcore, ae_restrict_mem hM'meas] with x hx hxM'
    obtain ⟨V, hV⟩ := hx
    refine ⟨V, Submission.br_weightedTangent_congr P (m + 1) M' M θ θ x (W q) hWo
      (hM'sub hxM').2 ?_ (Eventually.of_forall fun _ => rfl) rfl V hV⟩
    refine measure_mono_null ?_ (ae_eq_set.1 hM'ae).2
    rintro y ⟨hy | hy, hyW⟩
    · exact absurd (hM'sub hy.1).1 hy.2
    · exact ⟨⟨hy.1, hyW⟩, hy.2⟩
  have hcov : M ⊆ ⋃ q, M ∩ W q := by
    intro x hx
    obtain ⟨i, hi⟩ := hWcov {x} isCompact_singleton (singleton_subset_iff.2 (hMU hx))
    exact mem_iUnion.2 ⟨i, hx, hi rfl⟩
  exact ae_restrict_of_ae_restrict_of_subset hcov ((ae_restrict_iUnion_iff _ _).2 hloc)

/-- Simon Ch. 6, proof of Theorem 8.1 (pp. 174–175), (10)–(13) and the concluding argument:
the orientation of a rectifiable representation of a current with locally finite boundary mass.
For `Hⁿ`-a.e. `x ∈ M` (weighted tangent space `L`, Lebesgue point of `ξ` for `μ = θ Hⁿ⌞M`,
finite upper densities of `μ` and of the mass measure `ν` of `∂T`), the blow-ups of `T` at `x`
converge to `S_x(ω) = θ(x) ∫_L ⟨ω, ξ(x)⟩ dHⁿ`, while the boundary bound
`|∂T(η^#φ)| ≤ sup |η^#φ| ν(B_{4r}(x)) = O(rⁿ⁺¹)` gives `∂S_x = 0`.  Testing with
`φ = (a ϕ) β`, `a` a covector vanishing on `L`, shows `⟨a ∧ β, ξ(x)⟩ = 0`; in an orthonormal
frame adapted to `L` this forces `ξ(x) = c τ₁ ∧ ⋯ ∧ τₙ`, and `|ξ(x)| = 1` gives `c = ±1`. -/
theorem Submission.rectifiability_orientation : ∀ (P m : ℕ) (U : Set (Eucl P)), IsOpen U → ∀ T : GeometricCurrentOn U (m + 1), (∀ W, CompactlyContainedOpen W U → T.boundary.massOn W < ∞) → ∀ (M : Set (Eucl P)) (θ : Eucl P → ℝ) (ξ : Eucl P → NVector (Eucl P) (m + 1)), M ⊆ U → NullMeasurableSet M (μHE[m + 1] : Measure (Eucl P)) → CountablyRectifiable (m + 1) M → (∀ x ∈ M, 0 < θ x) → (∀ K : Set (Eucl P), IsCompact K → K ⊆ U → IntegrableOn θ (M ∩ K) (μHE[m + 1] : Measure (Eucl P))) → AEStronglyMeasurable ξ ((μHE[m + 1] : Measure (Eucl P)).restrict M) → (∀ᵐ x ∂((μHE[m + 1] : Measure (Eucl P)).restrict M), ∑ α : SimonMultiIndex (m + 1) P, (euclideanNVectorCoordinate (ξ x) α) ^ 2 = 1) → (∀ ω : TestFormOn U (m + 1), T ω = tauAction (m + 1) M θ ξ ω) → ∀ᵐ x ∂((μHE[m + 1] : Measure (Eucl P)).restrict M), ∃ τ : Fin (m + 1) → Eucl P, Orthonormal ℝ τ ∧ HasWeightedApproximateTangentSpaceAt (m + 1) M θ x (Submodule.span ℝ (range τ)) ∧ (ξ x = simpleNVector τ ∨ ξ x = -simpleNVector τ) := by
  open Poincare.SimonGMT.Chapter03 (blowUpMap) in
  intro P m
  classical
  -- Concluding argument of the proof of 8.1: a unit `n`-vector killing every `a ∧ β` with `a`
  -- vanishing on the `n`-plane `L` is `±τ₁ ∧ ⋯ ∧ τₙ` for an orthonormal basis `τ` of `L`.
  have hLA : ∀ (w : NVector (Eucl P) (m + 1)) (L : Submodule ℝ (Eucl P)),
      Module.finrank ℝ L = m + 1 →
      (∑ α : SimonMultiIndex (m + 1) P, (euclideanNVectorCoordinate w α) ^ 2 = 1) →
      (∀ a : Eucl P →L[ℝ] ℝ, (∀ z ∈ L, a z = 0) → ∀ β : Covector (Eucl P) m,
        w (ContinuousAlternatingMap.alternatizeUncurryFin (a.smulRight β)) = 0) →
      ∃ τ : Fin (m + 1) → Eucl P, Orthonormal ℝ τ ∧ Submodule.span ℝ (range τ) = L ∧
        (w = simpleNVector τ ∨ w = -simpleNVector τ) := by
    intro w L hL hw hvan
    classical
    -- `n ≤ P`
    have hnP : m + 1 ≤ P := by
      have := Submodule.finrank_le L
      rwa [hL, finrank_euclideanSpace_fin] at this
    -- an orthonormal basis `τ` of `L`
    let v : OrthonormalBasis (Fin (m + 1)) ℝ L := (stdOrthonormalBasis ℝ L).reindex (finCongr hL)
    let τ : Fin (m + 1) → Eucl P := fun k => ((v k : L) : Eucl P)
    have hτon : Orthonormal ℝ τ := v.orthonormal.comp_linearIsometry L.subtypeₗᵢ
    have hτspan : Submodule.span ℝ (range τ) = L := by
      have hr : range τ = L.subtype '' range (fun k => v k) := by
        rw [← range_comp]; rfl
      have htop : Submodule.span ℝ (range (fun k => v k)) = ⊤ := by
        simpa using v.toBasis.span_eq
      rw [hr, Submodule.span_image, htop, Submodule.map_top, Submodule.range_subtype]
    -- extend `τ` to an orthonormal basis `b` of `ℝ^P`: `b (β₀ k) = τ k`
    let β₀ : SimonMultiIndex (m + 1) P := Fin.castLEOrderEmb hnP
    obtain ⟨b, hb⟩ : ∃ b : OrthonormalBasis (Fin P) ℝ (Eucl P), ∀ k, b (β₀ k) = τ k := by
      let v' : Fin P → Eucl P := fun i => if h : (i : ℕ) < m + 1 then τ ⟨i, h⟩ else 0
      have hs : Orthonormal ℝ ({i : Fin P | (i : ℕ) < m + 1}.domRestrict v') := by
        have he : Function.Injective
            (fun i : {i : Fin P | (i : ℕ) < m + 1} => (⟨(i : Fin P), i.2⟩ : Fin (m + 1))) := by
          intro i j hij
          apply Subtype.ext
          apply Fin.ext
          simpa using congrArg Fin.val hij
        have heq : {i : Fin P | (i : ℕ) < m + 1}.domRestrict v' =
            τ ∘ (fun i : {i : Fin P | (i : ℕ) < m + 1} => (⟨(i : Fin P), i.2⟩ : Fin (m + 1))) := by
          funext i
          have hi : ((i : Fin P) : ℕ) < m + 1 := i.2
          simp only [Set.domRestrict, v', Function.comp_apply]
          rw [dite_eq_left hi]
        rw [heq]
        exact hτon.comp _ he
      obtain ⟨b, hb⟩ := hs.exists_orthonormalBasis_extension_of_card_eq (by simp)
      refine ⟨b, fun k => ?_⟩
      have hk : ((β₀ k : Fin P) : ℕ) < m + 1 := k.isLt
      rw [hb (β₀ k) hk]
      simp only [v']
      rw [dite_eq_left hk]
      rfl
    -- the dual coframe `dτ i = ⟨b i, ·⟩`
    let R : Eucl P →L[ℝ] Eucl P :=
      (b.repr.toContinuousLinearEquiv : Eucl P →L[ℝ] EuclideanSpace ℝ (Fin P))
    have hR : R = (b.repr.toContinuousLinearEquiv : Eucl P →L[ℝ] EuclideanSpace ℝ (Fin P)) := rfl
    let dτ : Fin P → (Eucl P →L[ℝ] ℝ) := fun i => (EuclideanSpace.proj i).comp R
    have hdτ : ∀ i z, dτ i z = inner ℝ (b i) z := fun i z => b.repr_apply_apply z i
    have hdτb : ∀ i j, dτ i (b j) = if i = j then 1 else 0 := by
      intro i j
      rw [hdτ, orthonormal_iff_ite.mp b.orthonormal i j]
    -- coordinates in the frame `b`
    have hexp : ∀ ω : Covector (Eucl P) (m + 1), ω = ∑ β : SimonMultiIndex (m + 1) P,
        ω (fun j => b (β j)) • wedgeCovectors (m + 1) (fun j => dτ (β j)) := by
      intro ω
      let S : Eucl P →L[ℝ] Eucl P :=
        (b.repr.symm.toContinuousLinearEquiv : EuclideanSpace ℝ (Fin P) →L[ℝ] Eucl P)
      have hS : S = (b.repr.symm.toContinuousLinearEquiv :
        EuclideanSpace ℝ (Fin P) →L[ℝ] Eucl P) := rfl
      have h1 := Submission.cmb_covector_eq_sum_coord_smul_wedge P (m + 1)
        (covectorPullback (m + 1) S ω)
      have h2 : ω = covectorPullback (m + 1) R (covectorPullback (m + 1) S ω) := by
        ext u
        simp [covectorPullback_apply, hS, hR, Function.comp_def]
      conv_lhs => rw [h2, h1]
      rw [map_sum]
      refine Finset.sum_congr rfl fun β _ => ?_
      rw [map_smul, covectorPullback_wedgeCovectors]
      congr 1
      simp [euclideanCovectorCoordinate, covectorPullback_apply, hS, Function.comp_def,
        b.repr_symm_single]
    -- `dτ i` vanishes on `L` for `i ∉ range β₀`
    have hdτL : ∀ i : Fin P, m + 1 ≤ (i : ℕ) → ∀ z ∈ L, dτ i z = 0 := by
      intro i hi z hz
      have hle : Submodule.span ℝ (range τ) ≤ LinearMap.ker (dτ i : Eucl P →ₗ[ℝ] ℝ) := by
        rw [Submodule.span_le]
        rintro _ ⟨k, rfl⟩
        have hik : i ≠ β₀ k := by
          intro h
          have h' : (i : ℕ) = (k : ℕ) := congrArg Fin.val h
          omega
        simp only [SetLike.mem_coe, LinearMap.mem_ker, ContinuousLinearMap.coe_coe]
        rw [← hb k, hdτb, ite_eq_right hik]
      have := hle (hτspan ▸ hz)
      simpa using this
    -- the wedge of a permuted coframe
    have hperm : ∀ (γ : Fin (m + 1) → (Eucl P →L[ℝ] ℝ)) (σ : Equiv.Perm (Fin (m + 1))),
        wedgeCovectors (m + 1) (γ ∘ σ) =
          ((Equiv.Perm.sign σ : ℤ) : ℝ) • wedgeCovectors (m + 1) γ := by
      intro γ σ
      ext u
      rw [ContinuousAlternatingMap.smul_apply, wedgeCovectors_apply_det, wedgeCovectors_apply_det,
        smul_eq_mul]
      exact Matrix.det_permute σ (Matrix.of fun i j => γ i (u j))
    -- `w` kills every frame wedge other than `τ*₁ ∧ ⋯ ∧ τ*ₙ`
    have hzero : ∀ β : SimonMultiIndex (m + 1) P, β ≠ β₀ →
        w (wedgeCovectors (m + 1) (fun j => dτ (β j))) = 0 := by
      intro β hβ
      -- the last index of `β` is at least `n`
      have hlast : m + 1 ≤ ((β (Fin.last m) : Fin P) : ℕ) := by
        by_contra hcon
        rw [not_le] at hcon
        apply hβ
        rw [← OrderEmbedding.range_inj_of_wellFoundedLT]
        have hsub : range β ⊆ range β₀ := by
          rintro _ ⟨k, rfl⟩
          have hk : ((β k : Fin P) : ℕ) < m + 1 :=
            lt_of_le_of_lt (β.monotone (Fin.le_last k)) hcon
          exact ⟨⟨β k, hk⟩, Fin.ext rfl⟩
        exact Set.eq_of_subset_of_ncard_le hsub
          (by rw [Set.ncard_range_of_injective β₀.injective,
            Set.ncard_range_of_injective β.injective]) (Set.finite_range _)
      -- rotate the last factor to the front
      let γ : Fin (m + 1) → (Eucl P →L[ℝ] ℝ) :=
        Fin.cons (dτ (β (Fin.last m))) (fun k => dτ (β (Fin.castSucc k)))
      have hrot : (fun j => dτ (β j)) = γ ∘ finRotate (m + 1) := by
        have h := Fin.snoc_eq_cons_rotate (Fin.init (fun j => dτ (β j))) (dτ (β (Fin.last m)))
        rw [Fin.snoc_init_self] at h
        exact h
      have hγw : wedgeCovectors (m + 1) γ = ContinuousAlternatingMap.alternatizeUncurryFin
          ((dτ (β (Fin.last m))).smulRight
            (wedgeCovectors m (fun k => dτ (β (Fin.castSucc k))))) := rfl
      rw [hrot, hperm, map_smul, hγw,
        hvan _ (hdτL _ hlast) (wedgeCovectors m (fun k => dτ (β (Fin.castSucc k)))), smul_zero]
    have hbτ : (fun j => b (β₀ j)) = τ := funext hb
    -- hence `w = c τ₁ ∧ ⋯ ∧ τₙ`
    let c := w (wedgeCovectors (m + 1) (fun j => dτ (β₀ j)))
    have hwc : w = c • simpleNVector τ := by
      ext ω
      rw [smul_apply, simpleNVector_apply, smul_eq_mul]
      conv_lhs => rw [hexp ω]
      rw [map_sum, Finset.sum_eq_single β₀]
      · rw [map_smul, smul_eq_mul, hbτ, mul_comm]
      · intro β _ hβ
        rw [map_smul, hzero β hβ, smul_zero]
      · intro h
        exact absurd (Finset.mem_univ _) h
    -- `|τ₁ ∧ ⋯ ∧ τₙ| = 1` (Cauchy–Binet for an orthonormal family)
    have hnorm1 : ∑ α : SimonMultiIndex (m + 1) P,
        (wedgeCovectors (m + 1) (fun j => EuclideanSpace.proj (α j)) τ) ^ 2 = 1 := by
      let Θ := wedgeCovectors (m + 1) (fun j => dτ (β₀ j))
      have hΘ : Θ = wedgeCovectors (m + 1) (fun j => dτ (β₀ j)) := rfl
      have h1 := Submission.cmb_covector_eq_sum_coord_smul_wedge P (m + 1) Θ
      have h2 : Θ τ = 1 := by
        rw [hΘ, wedgeCovectors_apply_det]
        convert Matrix.det_one (n := Fin (m + 1)) (R := ℝ)
        ext i j
        rw [Matrix.of_apply, ← hb j, hdτb, Matrix.one_apply]
        simp [β₀.injective.eq_iff]
      have h3 : ∀ α : SimonMultiIndex (m + 1) P, euclideanCovectorCoordinate Θ α =
          wedgeCovectors (m + 1) (fun j => EuclideanSpace.proj (α j)) τ := by
        intro α
        rw [euclideanCovectorCoordinate, hΘ, wedgeCovectors_apply_det, wedgeCovectors_apply_det,
          ← Matrix.det_transpose]
        congr 1
        ext i j
        rw [Matrix.transpose_apply, Matrix.of_apply, Matrix.of_apply, hdτ, hb,
          EuclideanSpace.inner_single_right]
        simp
      calc ∑ α : SimonMultiIndex (m + 1) P,
            (wedgeCovectors (m + 1) (fun j => EuclideanSpace.proj (α j)) τ) ^ 2
          = ∑ α : SimonMultiIndex (m + 1) P, euclideanCovectorCoordinate Θ α *
              wedgeCovectors (m + 1) (fun j => EuclideanSpace.proj (α j)) τ := by
            refine Finset.sum_congr rfl fun α _ => ?_
            rw [h3, sq]
        _ = Θ τ := by
            conv_rhs => rw [h1]
            rw [ContinuousAlternatingMap.sum_apply]
            simp only [ContinuousAlternatingMap.smul_apply, smul_eq_mul]
        _ = 1 := h2
    have hc2 : c ^ 2 = 1 := by
      rw [hwc] at hw
      simp only [euclideanNVectorCoordinate, smul_apply, simpleNVector_apply,
        smul_eq_mul, mul_pow] at hw
      rwa [← Finset.mul_sum, hnorm1, mul_one] at hw
    refine ⟨τ, hτon, hτspan, ?_⟩
    have hcc : c * c = 1 := by rw [← sq]; exact hc2
    rcases mul_self_eq_one_iff.mp hcc with h | h
    · left
      rw [hwc, h, one_smul]
    · right
      rw [hwc, h]
      ext ω
      simp only [smul_apply, neg_apply, simpleNVector_apply, smul_eq_mul,
        neg_one_mul]
  -- Homogeneity of the Euclidean coefficient norm: `|t α| = |t| |α|`.
  have hnormsmul : ∀ (t : ℝ) (α : Covector (Eucl P) m),
      covectorEuclideanNorm (t • α) = |t| * covectorEuclideanNorm α := by
    intro t α
    unfold covectorEuclideanNorm
    rw [← Real.sqrt_sq_eq_abs, ← Real.sqrt_mul (sq_nonneg t), Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl fun I _ => ?_
    split_ifs
    · simp only [ContinuousAlternatingMap.smul_apply, smul_eq_mul, mul_pow]
    · simp
  -- An `n`-vector of coefficient norm `1` has operator norm at most `#I(n, P)`.
  have hξbd : ∀ w : NVector (Eucl P) (m + 1),
      ∑ α : SimonMultiIndex (m + 1) P, (euclideanNVectorCoordinate w α) ^ 2 = 1 →
      ‖w‖ ≤ (Fintype.card (SimonMultiIndex (m + 1) P) : ℝ) := by
    intro w hw
    refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) fun ω => ?_
    have hω := congrArg w (Submission.cmb_covector_eq_sum_coord_smul_wedge P (m + 1) ω)
    rw [map_sum] at hω
    rw [hω]
    refine (norm_sum_le _ _).trans ?_
    calc ∑ α : SimonMultiIndex (m + 1) P, ‖w (euclideanCovectorCoordinate ω α •
            wedgeCovectors (m + 1) fun j => EuclideanSpace.proj (α j))‖
        ≤ ∑ _α : SimonMultiIndex (m + 1) P, ‖ω‖ := by
          refine Finset.sum_le_sum fun α _ => ?_
          rw [map_smul, smul_eq_mul, norm_mul]
          have h1 : ‖euclideanCovectorCoordinate ω α‖ ≤ ‖ω‖ := by
            have h := ω.le_opNorm (fun j => EuclideanSpace.single (α j) (1 : ℝ))
            simpa [euclideanCovectorCoordinate, PiLp.norm_single] using h
          have h2 : ‖w (wedgeCovectors (m + 1) fun j => EuclideanSpace.proj (α j))‖ ≤ 1 := by
            have hle : (euclideanNVectorCoordinate w α) ^ 2 ≤ 1 := hw ▸
              Finset.single_le_sum (fun β _ => sq_nonneg (euclideanNVectorCoordinate w β))
                (Finset.mem_univ α)
            rw [Real.norm_eq_abs]
            exact (sq_le_one_iff_abs_le_one _).1 hle
          calc ‖euclideanCovectorCoordinate ω α‖ *
                ‖w (wedgeCovectors (m + 1) fun j => EuclideanSpace.proj (α j))‖
              ≤ ‖ω‖ * 1 := mul_le_mul h1 h2 (norm_nonneg _) (norm_nonneg _)
            _ = ‖ω‖ := mul_one _
      _ = (Fintype.card (SimonMultiIndex (m + 1) P) : ℝ) * ‖ω‖ := by simp
  -- Blow-ups rescale `Hⁿ`: `∫_{η_{x,r}(S)} F dHⁿ = r⁻ⁿ ∫_S F ∘ η_{x,r} dHⁿ`.
  have hblow : ∀ (x : Eucl P) (r : ℝ), 0 < r → ∀ (S : Set (Eucl P)) (F : Eucl P → ℝ),
      ∫ y in blowUpMap x r '' S, F y ∂(μHE[m + 1] : Measure (Eucl P)) =
        (r ^ (m + 1))⁻¹ * ∫ z in S, F (blowUpMap x r z) ∂(μHE[m + 1] : Measure (Eucl P)) := by
    intro x r hr S F
    set μ := (μHE[m + 1] : Measure (Eucl P)) with hμ
    let e : Eucl P ≃ₜ Eucl P :=
      (Homeomorph.subRight x).trans (Homeomorph.smulOfNeZero r⁻¹ (inv_ne_zero hr.ne'))
    have he : (e : Eucl P → Eucl P) = blowUpMap x r := rfl
    have hemb : MeasurableEmbedding (blowUpMap x r) := he ▸ e.measurableEmbedding
    have himg : ∀ Z : Set (Eucl P), μ (blowUpMap x r '' Z) =
        ((‖r⁻¹‖₊ ^ (m + 1) : ℝ≥0) : ℝ≥0∞) * μ Z := by
      open scoped Pointwise in
      intro Z
      have h1 : blowUpMap x r '' Z = r⁻¹ • (IsometryEquiv.subRight x '' Z) := by
        rw [← Set.image_smul, Set.image_image]
        rfl
      rw [h1, hμ, Measure.euclideanHausdorffMeasure_smul₀ _ (inv_ne_zero hr.ne'),
        (IsometryEquiv.subRight x).isometry.euclideanHausdorffMeasure_image]
      rfl
    have hmeas : μ.restrict (blowUpMap x r '' S) =
        (‖r⁻¹‖₊ ^ (m + 1)) • Measure.map (blowUpMap x r) (μ.restrict S) := by
      ext T hT
      rw [Measure.restrict_apply hT, Measure.smul_apply, Measure.map_apply hemb.measurable hT,
        Measure.restrict_apply (hemb.measurable hT), ← Set.image_preimage_inter, himg]
      rfl
    rw [hmeas, integral_smul_nnreal_measure, hemb.integral_map, NNReal.smul_def, smul_eq_mul]
    congr 1
    rw [NNReal.coe_pow, coe_nnnorm, Real.norm_eq_abs, abs_inv, abs_of_pos hr, inv_pow]
  -- Finite upper density gives `λ(B̄_r(x)) ≤ C rⁿ` for small `r`.
  have hdens : ∀ (κ : Measure (Eucl P)) (x : Eucl P),
      dimensionalUpperDensity κ.toOuterMeasure ((m + 1 : ℕ) : ℝ) univ x < ⊤ →
      ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ r in 𝓝[>] (0 : ℝ),
        κ (closedBall x r) ≤ ENNReal.ofReal (C * r ^ (m + 1)) := by
    intro κ x hx
    obtain ⟨c, hc1, hc2⟩ := exists_between hx
    have hω0 : Poincare.SimonGMT.Chapter01.realUnitBallVolume ((m + 1 : ℕ) : ℝ) ≠ 0 :=
      (Poincare.SimonGMT.Chapter01.realUnitBallVolume_pos (Nat.cast_nonneg _)).ne'
    have hωtop : Poincare.SimonGMT.Chapter01.realUnitBallVolume ((m + 1 : ℕ) : ℝ) ≠ ⊤ :=
      Poincare.SimonGMT.Chapter01.realUnitBallVolume_ne_top _
    refine ⟨(c * Poincare.SimonGMT.Chapter01.realUnitBallVolume ((m + 1 : ℕ) : ℝ)).toReal,
      ENNReal.toReal_nonneg, ?_⟩
    filter_upwards [eventually_lt_of_limsup_lt hc1, self_mem_nhdsWithin] with r hr hr0
    have hr0' : (0 : ℝ) < r := hr0
    simp only [Poincare.SimonGMT.Chapter01.dimensionalDensityQuotient,
      Measure.toOuterMeasure_apply, univ_inter] at hr
    rw [ENNReal.rpow_natCast, ← ENNReal.ofReal_pow hr0'.le] at hr
    rw [ENNReal.div_lt_iff
      (Or.inl (mul_ne_zero hω0 (ENNReal.ofReal_pos.2 (pow_pos hr0' _)).ne'))
      (Or.inl (ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top))] at hr
    calc κ (closedBall x r)
        ≤ c * (Poincare.SimonGMT.Chapter01.realUnitBallVolume ((m + 1 : ℕ) : ℝ) *
            ENNReal.ofReal (r ^ (m + 1))) := hr.le
      _ = ENNReal.ofReal ((c * Poincare.SimonGMT.Chapter01.realUnitBallVolume
            ((m + 1 : ℕ) : ℝ)).toReal * r ^ (m + 1)) := by
        rw [ENNReal.ofReal_mul ENNReal.toReal_nonneg,
          ENNReal.ofReal_toReal (ENNReal.mul_ne_top hc2.ne hωtop), mul_assoc]
  intro U hU T hbd M θ ξ hMU hMm hrect hpos hint hξm hξn hT
  set μ := (μHE[m + 1] : Measure (Eucl P)) with hμ
  -- Localization to `W_q ⊂⊂ U`; `ν` is the mass measure of `∂T` and `L_x` the tangent space.
  obtain ⟨W, hWcc, hWcov⟩ := Submission.cmb_exists_compactly_contained_exhaustion P U hU
  obtain ⟨ν, hν⟩ :=
    (Submission.rectifiability_mass_measure_representation P m U hU T.boundary hbd).1
  have htan := Submission.rectifiability_weighted_tangent_ae P m U M θ hU hMU hMm hrect hpos hint
  have hloc : ∀ q, ∀ᵐ x ∂μ.restrict (M ∩ W q), ∃ τ : Fin (m + 1) → Eucl P, Orthonormal ℝ τ ∧
      HasWeightedApproximateTangentSpaceAt (m + 1) M θ x (Submodule.span ℝ (range τ)) ∧
      (ξ x = simpleNVector τ ∨ ξ x = -simpleNVector τ) := by
    intro q
    obtain ⟨hVo, hVc, hVcU⟩ := hWcc q
    set V := W q with hVdef
    have hVU : V ⊆ U := subset_closure.trans hVcU
    have hMV : NullMeasurableSet (M ∩ V) μ := hMm.inter hVo.measurableSet.nullMeasurableSet
    have hθV : IntegrableOn θ (M ∩ V) μ :=
      (hint _ hVc hVcU).mono_set (inter_subset_inter_right _ subset_closure)
    have hθm : AEMeasurable (fun y => ENNReal.ofReal (θ y)) (μ.restrict (M ∩ V)) :=
      ENNReal.measurable_ofReal.comp_aemeasurable hθV.aestronglyMeasurable.aemeasurable
    -- The finite measure `μq = θ Hⁿ ⌞ (M ∩ V)`.
    set μq : Measure (Eucl P) :=
      (μ.restrict (M ∩ V)).withDensity (fun y => ENNReal.ofReal (θ y)) with hμq
    have : IsFiniteMeasure μq := by
      refine ⟨?_⟩
      rw [hμq, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
      refine lt_of_le_of_lt (lintegral_mono fun y => ?_) hθV.2
      rw [Real.enorm_eq_ofReal_abs]
      exact ENNReal.ofReal_le_ofReal (le_abs_self _)
    have hac : μ.restrict (M ∩ V) ≪ μq := withDensity_absolutelyContinuous' hθm (by
      filter_upwards [ae_restrict_mem₀ hMV] with y hy
      exact (ENNReal.ofReal_pos.2 (hpos y hy.1)).ne')
    have hμqac : μq ≪ μ.restrict M :=
      (withDensity_absolutelyContinuous _ _).trans
        (Measure.absolutelyContinuous_of_le (Measure.restrict_mono inter_subset_left le_rfl))
    -- `∫_M θ F dHⁿ = ∫ F dμq` for `F` vanishing off `V`.
    have hμq_int : ∀ F : Eucl P → ℝ, (∀ y ∉ V, F y = 0) →
        ∫ y in M, θ y * F y ∂μ = ∫ y, F y ∂μq := by
      intro F hF
      rw [hμq, integral_withDensity_eq_integral_toReal_smul₀ hθm
        (Eventually.of_forall fun _ => ENNReal.ofReal_lt_top)]
      have h1 : ∫ y in M ∩ V, θ y * F y ∂μ = ∫ y in M, θ y * F y ∂μ := by
        rw [inter_comm, ← Measure.restrict_restrict hVo.measurableSet]
        exact setIntegral_eq_integral_of_forall_compl_eq_zero fun y hy => by rw [hF y hy, mul_zero]
      rw [← h1]
      refine integral_congr_ae ?_
      filter_upwards [ae_restrict_mem₀ hMV] with y hy
      rw [ENNReal.toReal_ofReal (hpos y hy.1).le, smul_eq_mul]
    -- `ξ ∈ L¹(μq)` and its Lebesgue points (Besicovitch differentiation).  The normed-group
    -- instances of `NVector (ℝ^P) n = (Λⁿ ℝ^P)*` need one more pending synthesis level.
    set_option maxSynthPendingDepth 2 in
    have hξq : Integrable ξ μq := Integrable.of_bound (hξm.mono_ac hμqac) _ (by
      filter_upwards [hμqac.ae_le hξn] with y hy
      exact hξbd _ hy)
    have hleb : ∀ᵐ x ∂μq,
        Tendsto (fun r => ⨍ y in closedBall x r, ‖ξ y - ξ x‖ ∂μq) (𝓝[>] 0) (𝓝 0) := by
      filter_upwards [(Besicovitch.vitaliFamily μq).ae_tendsto_average_norm_sub
        hξq.locallyIntegrable] with x hx
      exact hx.comp (Besicovitch.tendsto_filterAt μq x)
    -- Finite upper densities of `μq` and of `ν` (Simon (2), (3); Ch. 1, 3.3).
    have hdμ : ∀ᵐ x ∂μ, dimensionalUpperDensity μq.toOuterMeasure ((m + 1 : ℕ) : ℝ) univ x < ⊤ := by
      have h := Submission.rectifiability_density_comparison P (m + 1) μq
        {x | dimensionalUpperDensity μq.toOuterMeasure ((m + 1 : ℕ) : ℝ) univ x = ⊤} univ ⊤
        isOpen_univ (subset_univ _) (fun x hx => le_of_eq hx.symm)
      have h0 : μ {x | dimensionalUpperDensity μq.toOuterMeasure ((m + 1 : ℕ) : ℝ) univ x = ⊤} =
          0 := by
        by_contra hne
        rw [ENNReal.top_mul hne] at h
        exact (measure_lt_top μq univ).ne (top_le_iff.mp h)
      filter_upwards [measure_eq_zero_iff_ae_notMem.1 h0] with x hx
      exact lt_top_iff_ne_top.2 hx
    have hdν : ∀ᵐ x ∂μ, x ∈ V →
        dimensionalUpperDensity ν.toOuterMeasure ((m + 1 : ℕ) : ℝ) univ x < ⊤ := by
      have h := Submission.rectifiability_density_comparison P (m + 1) ν
        {x | x ∈ V ∧ dimensionalUpperDensity ν.toOuterMeasure ((m + 1 : ℕ) : ℝ) univ x = ⊤} V ⊤
        hVo (fun x hx => hx.1) (fun x hx => le_of_eq hx.2.symm)
      have hνV : ν V < ⊤ := by
        rw [hν.2 V (hWcc q)]
        exact hbd V (hWcc q)
      have h0 : μ {x | x ∈ V ∧
          dimensionalUpperDensity ν.toOuterMeasure ((m + 1 : ℕ) : ℝ) univ x = ⊤} = 0 := by
        by_contra hne
        rw [ENNReal.top_mul hne] at h
        exact hνV.ne (top_le_iff.mp h)
      filter_upwards [measure_eq_zero_iff_ae_notMem.1 h0] with x hx hxV
      exact lt_top_iff_ne_top.2 fun h => hx ⟨hxV, h⟩
    -- Simon (11)–(13) at a good point: `⟨a ∧ β, ξ(x)⟩ = 0` whenever `a` vanishes on `L`.
    have hpoint : ∀ x ∈ V, 0 < θ x → ∀ L : Submodule ℝ (Eucl P),
        HasWeightedApproximateTangentSpaceAt (m + 1) M θ x L →
        Tendsto (fun r => ⨍ y in closedBall x r, ‖ξ y - ξ x‖ ∂μq) (𝓝[>] 0) (𝓝 0) →
        ∀ Cμ : ℝ, 0 ≤ Cμ →
        (∀ᶠ r in 𝓝[>] (0 : ℝ), μq (closedBall x r) ≤ ENNReal.ofReal (Cμ * r ^ (m + 1))) →
        ∀ Cν : ℝ, 0 ≤ Cν →
        (∀ᶠ r in 𝓝[>] (0 : ℝ), ν (closedBall x r) ≤ ENNReal.ofReal (Cν * r ^ (m + 1))) →
        ∀ a : Eucl P →L[ℝ] ℝ, (∀ z ∈ L, a z = 0) → ∀ β : Covector (Eucl P) m,
          ξ x (ContinuousAlternatingMap.alternatizeUncurryFin (a.smulRight β)) = 0 := by
      intro x hxV hθx L hL hleb Cμ hCμ0 hCμ Cν hCν0 hCν a ha β
      -- a closed ball around `x` inside `V`
      obtain ⟨ε, hε, hεV⟩ := Metric.isOpen_iff.mp hVo x hxV
      have hδV : closedBall x (ε / 2) ⊆ V := (closedBall_subset_ball (half_lt_self hε)).trans hεV
      -- the cutoff `ϕ` and the model `(n - 1)`-form `Ψ = (a ϕ) β`
      let ϕ : ContDiffBump (0 : Eucl P) := ⟨1, 2, one_pos, one_lt_two⟩
      let Ψ : DifferentialForm (Eucl P) m := fun z => (a z * ϕ z) • β
      have hΨ : Ψ = fun z => (a z * ϕ z) • β := rfl
      have hΨsm : IsSmoothForm Ψ := (a.contDiff.mul ϕ.contDiff).smul contDiff_const
      have hΨsupp : tsupport Ψ ⊆ closedBall 0 2 := by
        have hsub : Function.support Ψ ⊆ Function.support ϕ := fun z hz h0 => hz (by simp [hΨ, h0])
        exact (closure_mono hsub).trans ϕ.tsupport_eq.subset
      have hΨtest : IsTestForm Ψ :=
        ⟨hΨsm, (isCompact_closedBall 0 2).of_isClosed_subset (isClosed_tsupport _) hΨsupp⟩
      let Ω : DifferentialForm (Eucl P) (m + 1) := exteriorDerivative Ψ
      have hΩtest : IsTestForm Ω := exteriorDerivative_isTestForm hΨtest
      have hΩcont : Continuous Ω := hΩtest.1.continuous
      have hΩzero : ∀ z : Eucl P, 2 < ‖z‖ → Ω z = 0 := by
        intro z hz
        refine image_eq_zero_of_notMem_tsupport fun hmem => ?_
        have h2 := hΨsupp (tsupport_exteriorDerivative_subset Ψ hmem)
        rw [mem_closedBall_zero_iff] at h2
        linarith
      obtain ⟨CΩ, hCΩ⟩ := hΩcont.bounded_above_of_compact_support hΩtest.2
      have hCΩ0 : 0 ≤ CΩ := (norm_nonneg _).trans (hCΩ 0)
      -- on `L`, `Ω = ϕ G`
      have hΩL : ∀ z ∈ L,
          Ω z = ϕ z • ContinuousAlternatingMap.alternatizeUncurryFin (a.smulRight β) := by
        intro z hz
        have hd : HasFDerivAt Ψ ((a z • fderiv ℝ ϕ z + ϕ z • a).smulRight β) z :=
          (a.hasFDerivAt.mul
            ((ϕ.contDiff (n := 1)).differentiable (by simp) z).hasFDerivAt).smul_const β
        show ContinuousAlternatingMap.alternatizeUncurryFin (fderiv ℝ Ψ z) = _
        rw [hd.fderiv, ha z hz, zero_smul, zero_add,
          ← ContinuousAlternatingMap.alternatizeUncurryFin_smul]
        congr 1
        ext v
        simp [smul_smul]
      -- the blow-up forms `ψ r (y) = r Ψ((y - x) / r)`, with `dψ r (y) = Ω((y - x) / r)`
      let A : ℝ → Eucl P → Eucl P := fun r y => r⁻¹ • (y - x)
      have hA : A = fun r y => r⁻¹ • (y - x) := rfl
      let ψ : ℝ → DifferentialForm (Eucl P) m := fun r y => r • Ψ (A r y)
      have hψ : ψ = fun r y => r • Ψ (A r y) := rfl
      have hAnorm : ∀ r : ℝ, 0 < r → ∀ y, ‖A r y‖ = ‖y - x‖ / r := by
        intro r hr y
        rw [hA, norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hr, inv_mul_eq_div]
      have hAcont : ∀ r : ℝ, Continuous (A r) := fun r => by
        simp only [hA]
        fun_prop
      have hψsupp : ∀ r : ℝ, 0 < r → tsupport (ψ r) ⊆ closedBall x (2 * r) := by
        intro r hr
        refine closure_minimal (fun y hy => ?_) isClosed_closedBall
        have hΨy : Ψ (A r y) ≠ 0 := fun h => hy (by simp only [hψ, h, smul_zero])
        have h2 := hΨsupp (subset_tsupport _ hΨy)
        rw [mem_closedBall_zero_iff, hAnorm r hr, div_le_iff₀ hr] at h2
        rw [mem_closedBall, dist_eq_norm]
        linarith
      have hψtest : ∀ r : ℝ, 0 < r → IsTestForm (ψ r) := by
        intro r hr
        refine ⟨?_, (isCompact_closedBall x (2 * r)).of_isClosed_subset (isClosed_tsupport _)
          (hψsupp r hr)⟩
        exact (hΨsm.comp ((contDiff_id.sub (contDiff_const (c := x))).const_smul r⁻¹)).const_smul r
      have hdψ : ∀ r : ℝ, 0 < r → ∀ y, exteriorDerivative (ψ r) y = Ω (A r y) := by
        intro r hr y
        have hAd : HasFDerivAt (A r) (r⁻¹ • ContinuousLinearMap.id ℝ (Eucl P)) y :=
          ((hasFDerivAt_id y).sub_const x).const_smul r⁻¹
        have hΨd : HasFDerivAt Ψ (fderiv ℝ Ψ (A r y)) (A r y) :=
          (hΨsm.differentiable (by simp) _).hasFDerivAt
        have hψd : HasFDerivAt (ψ r)
            (r • (fderiv ℝ Ψ (A r y)).comp (r⁻¹ • ContinuousLinearMap.id ℝ (Eucl P))) y :=
          (hΨd.comp y hAd).const_smul r
        have heq : r • (fderiv ℝ Ψ (A r y)).comp (r⁻¹ • ContinuousLinearMap.id ℝ (Eucl P)) =
            fderiv ℝ Ψ (A r y) := by
          ext v
          simp [smul_smul, mul_inv_cancel₀ hr.ne']
        show ContinuousAlternatingMap.alternatizeUncurryFin (fderiv ℝ (ψ r) y) =
          ContinuousAlternatingMap.alternatizeUncurryFin (fderiv ℝ Ψ (A r y))
        rw [hψd.fderiv, heq]
      have hΩA : ∀ r : ℝ, 0 < r → ∀ y, y ∉ closedBall x (2 * r) → Ω (A r y) = 0 := by
        intro r hr y hy
        apply hΩzero
        rw [hAnorm r hr, lt_div_iff₀ hr]
        rw [mem_closedBall, dist_eq_norm, not_le] at hy
        linarith
      -- the Euclidean coefficient norm of `ψ r` is `O(r)`
      have hψnorm : ∀ r : ℝ, 0 < r → ∀ y,
          covectorEuclideanNorm (ψ r y) ≤ 2 * r * ‖a‖ * covectorEuclideanNorm β := by
        intro r hr y
        have h1 : ψ r y = (r * (a (A r y) * ϕ (A r y))) • β := by
          simp only [hψ, hΨ, smul_smul]
        have hz : |a (A r y) * ϕ (A r y)| ≤ 2 * ‖a‖ := by
          by_cases h0 : ϕ (A r y) = 0
          · rw [h0, mul_zero, abs_zero]
            positivity
          · have hlt : ‖A r y‖ < 2 := by
              have hmem : A r y ∈ Function.support ϕ := h0
              rw [ϕ.support_eq, mem_ball_zero_iff] at hmem
              exact hmem
            rw [abs_mul, abs_of_nonneg ϕ.nonneg]
            have ha' : |a (A r y)| ≤ ‖a‖ * ‖A r y‖ := by
              rw [← Real.norm_eq_abs]
              exact a.le_opNorm _
            calc |a (A r y)| * ϕ (A r y) ≤ (‖a‖ * ‖A r y‖) * 1 :=
                  mul_le_mul ha' ϕ.le_one ϕ.nonneg (by positivity)
              _ ≤ 2 * ‖a‖ := by
                rw [mul_one, mul_comm]
                exact mul_le_mul_of_nonneg_right hlt.le (norm_nonneg a)
        rw [h1, hnormsmul, abs_mul, abs_of_pos hr]
        have hβ0 := covectorEuclideanNorm_nonneg β
        calc r * |a (A r y) * ϕ (A r y)| * covectorEuclideanNorm β
            ≤ r * (2 * ‖a‖) * covectorEuclideanNorm β :=
              mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hz hr.le) hβ0
          _ = 2 * r * ‖a‖ * covectorEuclideanNorm β := by ring
      -- `I r = ∫ ⟨Ω(A r y), ξ(y)⟩ dμq` and `I₀ r = ∫ ⟨Ω(A r y), ξ(x)⟩ dμq`
      let I : ℝ → ℝ := fun r => ∫ y, ξ y (Ω (A r y)) ∂μq
      let I₀ : ℝ → ℝ := fun r => ∫ y, ξ x (Ω (A r y)) ∂μq
      have hvanV : ∀ r : ℝ, 0 < r → 2 * r ≤ ε / 2 → ∀ y, y ∉ V → Ω (A r y) = 0 :=
        fun r hr hrε y hy => hΩA r hr y fun h => hy (hδV (closedBall_subset_closedBall hrε h))
      have hscale : ∀ c : ℝ, 0 < c → Tendsto (fun r : ℝ => c * r) (𝓝[>] 0) (𝓝[>] 0) := by
        intro c hc
        refine tendsto_nhdsWithin_iff.2 ⟨?_, ?_⟩
        · have hcont : Continuous fun r : ℝ => c * r := by fun_prop
          simpa using (hcont.tendsto 0).mono_left nhdsWithin_le_nhds
        · filter_upwards [self_mem_nhdsWithin] with r hr
          exact mul_pos hc hr
      -- Simon (12): `|I r| = |∂T(ψ r)| ≤ M_{B(x, 4r)}(∂T) sup |ψ r| = O(r^{n + 1})`
      have hbdry : ∀ᶠ r in 𝓝[>] (0 : ℝ),
          |I r| ≤ Cν * (4 * r) ^ (m + 1) * (2 * r * ‖a‖ * covectorEuclideanNorm β) := by
        filter_upwards [(hscale 4 four_pos).eventually hCν,
          Ioo_mem_nhdsGT (show (0 : ℝ) < ε / 8 by positivity)] with r hrν hr
        obtain ⟨hr0, hrε⟩ := hr
        have h4ε : 4 * r ≤ ε / 2 := by linarith
        have hmem : ψ r ∈ testFormOnSubmodule U m :=
          show IsTestForm (ψ r) ∧ tsupport (ψ r) ⊆ U from ⟨hψtest r hr0, (hψsupp r hr0).trans
            ((closedBall_subset_closedBall (by linarith)).trans (hδV.trans hVU))⟩
        have hval : T.boundary ⟨ψ r, hmem⟩ = I r := by
          rw [GeometricCurrentOn.boundary_apply, hT, tauAction]
          have hω : ∀ y, ((exteriorDerivativeTestOn U m ⟨ψ r, hmem⟩ : TestFormOn U (m + 1)) :
              DifferentialForm (Eucl P) (m + 1)) y = Ω (A r y) := hdψ r hr0
          simp only [hω]
          exact hμq_int (fun y => ξ y (Ω (A r y)))
            fun y hy => by rw [hvanV r hr0 (by linarith) y hy, map_zero]
        have hcc : CompactlyContainedOpen (ball x (4 * r)) U :=
          ⟨isOpen_ball, (isCompact_closedBall x (4 * r)).of_isClosed_subset isClosed_closure
            closure_ball_subset_closedBall,
            closure_ball_subset_closedBall.trans
              ((closedBall_subset_closedBall h4ε).trans (hδV.trans hVU))⟩
        rw [← hval]
        refine Submission.cmb_abs_apply_le_of_massOn_le P m U (ball x (4 * r)) T.boundary
          ⟨ψ r, hmem⟩ (Cν * (4 * r) ^ (m + 1)) _ (by positivity) ?_ ?_ (hψnorm r hr0)
        · rw [← hν.2 _ hcc]
          exact (measure_mono ball_subset_closedBall).trans hrν
        · exact (hψsupp r hr0).trans (closedBall_subset_ball (by linarith))
      -- the test function `f = ⟨Ω, ξ(x)⟩ ∈ C_c(ℝ^P)`
      let f : CompactlySupportedContinuousMap (Eucl P) ℝ :=
        ⟨⟨fun z => ξ x (Ω z), (ξ x).continuous.comp hΩcont⟩, hΩtest.2.comp_left (map_zero (ξ x))⟩
      -- Simon (11), main part: `r⁻ⁿ I₀ r → θ(x) ∫_L f dHⁿ`
      have hmain : Tendsto (fun r => (r ^ (m + 1))⁻¹ * I₀ r) (𝓝[>] 0)
          (𝓝 (θ x * ∫ z in (L : Set (Eucl P)), f z ∂μ)) := by
        refine (hL.2 f).congr' ?_
        filter_upwards [Ioo_mem_nhdsGT (show (0 : ℝ) < ε / 4 by positivity)] with r hr
        obtain ⟨hr0, hrε⟩ := hr
        rw [hblow x r hr0 M (fun y => f y * θ (x + r • y))]
        congr 1
        show _ = ∫ y, ξ x (Ω (A r y)) ∂μq
        rw [← hμq_int (fun y => ξ x (Ω (A r y)))
          fun y hy => by rw [hvanV r hr0 (by linarith) y hy, map_zero]]
        refine integral_congr_ae (Eventually.of_forall fun z => ?_)
        show ξ x (Ω (r⁻¹ • (z - x))) * θ (x + r • (r⁻¹ • (z - x))) = θ z * ξ x (Ω (r⁻¹ • (z - x)))
        rw [smul_smul, mul_inv_cancel₀ hr0.ne', one_smul, add_sub_cancel, mul_comm]
      -- Simon (11), error part: `r⁻ⁿ |I r - I₀ r| ≤ CΩ Cμ 2ⁿ ⨍_{B(x, 2r)} |ξ - ξ(x)| dμq → 0`
      have hξΩ : ∀ r : ℝ, Integrable (fun y => ξ y (Ω (A r y))) μq := by
        intro r
        have : SecondCountableTopologyEither (Eucl P) (Covector (Eucl P) (m + 1)) :=
          secondCountableTopologyEither_of_left _ _
        refine Integrable.mono' (hξq.norm.mul_const CΩ) ?_ (Eventually.of_forall fun y => ?_)
        · exact isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable
            (hξq.aestronglyMeasurable.prodMk (hΩcont.comp (hAcont r)).aestronglyMeasurable)
        · exact ((ξ y).le_opNorm _).trans (mul_le_mul_of_nonneg_left (hCΩ _) (norm_nonneg (ξ y)))
      have hxΩ : ∀ r : ℝ, Integrable (fun y => ξ x (Ω (A r y))) μq := fun r =>
        Integrable.of_bound ((ξ x).continuous.comp (hΩcont.comp (hAcont r))).aestronglyMeasurable
          (‖ξ x‖ * CΩ) (Eventually.of_forall fun y =>
            ((ξ x).le_opNorm _).trans (mul_le_mul_of_nonneg_left (hCΩ _) (norm_nonneg (ξ x))))
      have herr : Tendsto (fun r => (r ^ (m + 1))⁻¹ * (I r - I₀ r)) (𝓝[>] 0) (𝓝 0) := by
        have hlim := (hleb.comp (hscale 2 two_pos)).const_mul (CΩ * Cμ * 2 ^ (m + 1))
        rw [mul_zero] at hlim
        refine squeeze_zero_norm' ?_ hlim
        filter_upwards [(hscale 2 two_pos).eventually hCμ, self_mem_nhdsWithin] with r hrμ hr
        have hr0 : (0 : ℝ) < r := hr
        have hdiff : I r - I₀ r = ∫ y, (ξ y - ξ x) (Ω (A r y)) ∂μq := by
          show (∫ y, ξ y (Ω (A r y)) ∂μq) - ∫ y, ξ x (Ω (A r y)) ∂μq = _
          rw [← integral_sub (hξΩ r) (hxΩ r)]
          rfl
        have hle : ‖∫ y, (ξ y - ξ x) (Ω (A r y)) ∂μq‖ ≤
            ∫ y, CΩ * (closedBall x (2 * r)).indicator (fun y => ‖ξ y - ξ x‖) y ∂μq := by
          refine norm_integral_le_of_norm_le
            (((hξq.sub (integrable_const (ξ x))).norm.indicator
              measurableSet_closedBall).const_mul CΩ)
            (Eventually.of_forall fun y => ?_)
          by_cases hy : y ∈ closedBall x (2 * r)
          · rw [indicator_of_mem hy]
            calc ‖(ξ y - ξ x) (Ω (A r y))‖ ≤ ‖ξ y - ξ x‖ * ‖Ω (A r y)‖ := (ξ y - ξ x).le_opNorm _
              _ ≤ ‖ξ y - ξ x‖ * CΩ := mul_le_mul_of_nonneg_left (hCΩ _) (norm_nonneg (ξ y - ξ x))
              _ = CΩ * ‖ξ y - ξ x‖ := mul_comm _ _
          · simp [indicator_of_notMem hy, hΩA r hr0 y hy]
        have hint : ∫ y, CΩ * (closedBall x (2 * r)).indicator (fun y => ‖ξ y - ξ x‖) y ∂μq =
            CΩ * (μq.real (closedBall x (2 * r)) *
              ⨍ y in closedBall x (2 * r), ‖ξ y - ξ x‖ ∂μq) := by
          rw [integral_const_mul, integral_indicator measurableSet_closedBall,
            ← measure_smul_setAverage _ (measure_ne_top μq (closedBall x (2 * r))), smul_eq_mul]
        have hμB : μq.real (closedBall x (2 * r)) ≤ Cμ * (2 * r) ^ (m + 1) := by
          rw [measureReal_def]
          exact ENNReal.toReal_le_of_le_ofReal (by positivity) hrμ
        have havg0 : 0 ≤ ⨍ y in closedBall x (2 * r), ‖ξ y - ξ x‖ ∂μq := by
          rw [setAverage_eq]
          exact smul_nonneg (inv_nonneg.2 measureReal_nonneg)
            (integral_nonneg fun y => norm_nonneg (ξ y - ξ x))
        simp only [Function.comp_apply]
        rw [norm_mul, norm_inv, norm_pow, Real.norm_eq_abs, abs_of_pos hr0, hdiff]
        calc (r ^ (m + 1))⁻¹ * ‖∫ y, (ξ y - ξ x) (Ω (A r y)) ∂μq‖
            ≤ (r ^ (m + 1))⁻¹ * (CΩ * (μq.real (closedBall x (2 * r)) *
                ⨍ y in closedBall x (2 * r), ‖ξ y - ξ x‖ ∂μq)) := by
              rw [← hint]
              exact mul_le_mul_of_nonneg_left hle (by positivity)
          _ ≤ (r ^ (m + 1))⁻¹ * (CΩ * (Cμ * (2 * r) ^ (m + 1) *
                ⨍ y in closedBall x (2 * r), ‖ξ y - ξ x‖ ∂μq)) :=
              mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left
                (mul_le_mul_of_nonneg_right hμB havg0) hCΩ0) (by positivity)
          _ = CΩ * Cμ * 2 ^ (m + 1) * ⨍ y in closedBall x (2 * r), ‖ξ y - ξ x‖ ∂μq := by
              have hrn : (r ^ (m + 1))⁻¹ * r ^ (m + 1) = 1 :=
                inv_mul_cancel₀ (pow_ne_zero _ hr0.ne')
              rw [mul_pow]
              linear_combination
                (CΩ * Cμ * 2 ^ (m + 1) * ⨍ y in closedBall x (2 * r), ‖ξ y - ξ x‖ ∂μq) * hrn
      -- the two limits of `r⁻ⁿ I r`
      have hlim1 : Tendsto (fun r => (r ^ (m + 1))⁻¹ * I r) (𝓝[>] 0)
          (𝓝 (θ x * ∫ z in (L : Set (Eucl P)), f z ∂μ)) := by
        have h := hmain.add herr
        rw [add_zero] at h
        refine h.congr' (Eventually.of_forall fun r => ?_)
        show (r ^ (m + 1))⁻¹ * I₀ r + (r ^ (m + 1))⁻¹ * (I r - I₀ r) = (r ^ (m + 1))⁻¹ * I r
        ring
      have hlim2 : Tendsto (fun r => (r ^ (m + 1))⁻¹ * I r) (𝓝[>] 0) (𝓝 0) := by
        have hlin : Tendsto
            (fun r : ℝ => Cν * 4 ^ (m + 1) * (2 * ‖a‖ * covectorEuclideanNorm β) * r)
            (𝓝[>] 0) (𝓝 0) := by
          have h0 : Tendsto (fun r : ℝ => r) (𝓝[>] 0) (𝓝 0) :=
            tendsto_id.mono_left nhdsWithin_le_nhds
          simpa using h0.const_mul (Cν * 4 ^ (m + 1) * (2 * ‖a‖ * covectorEuclideanNorm β))
        refine squeeze_zero_norm' ?_ hlin
        filter_upwards [hbdry, self_mem_nhdsWithin] with r hr hr0
        have hr0' : (0 : ℝ) < r := hr0
        rw [norm_mul, norm_inv, norm_pow, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_pos hr0']
        calc (r ^ (m + 1))⁻¹ * |I r|
            ≤ (r ^ (m + 1))⁻¹ *
                (Cν * (4 * r) ^ (m + 1) * (2 * r * ‖a‖ * covectorEuclideanNorm β)) :=
              mul_le_mul_of_nonneg_left hr (by positivity)
          _ = Cν * 4 ^ (m + 1) * (2 * ‖a‖ * covectorEuclideanNorm β) * r := by
              have hrn : (r ^ (m + 1))⁻¹ * r ^ (m + 1) = 1 :=
                inv_mul_cancel₀ (pow_ne_zero _ hr0'.ne')
              rw [mul_pow]
              linear_combination (Cν * 4 ^ (m + 1) * (2 * ‖a‖ * covectorEuclideanNorm β) * r) * hrn
      -- `∫_L f = ⟨G, ξ(x)⟩ ∫_L ϕ` and `∫_L ϕ > 0`
      have hfL : ∫ z in (L : Set (Eucl P)), f z ∂μ =
          ξ x (ContinuousAlternatingMap.alternatizeUncurryFin (a.smulRight β)) *
            ∫ z in (L : Set (Eucl P)), ϕ z ∂μ := by
        rw [← integral_const_mul]
        refine setIntegral_congr_fun L.closed_of_finiteDimensional.measurableSet fun z hz => ?_
        show ξ x (Ω z) = ξ x (ContinuousAlternatingMap.alternatizeUncurryFin (a.smulRight β)) * ϕ z
        rw [hΩL z hz, map_smul, smul_eq_mul, mul_comm]
      have hLϕ : 0 < ∫ z in (L : Set (Eucl P)), ϕ z ∂μ := by
        have :=
          Poincare.SimonGMT.Chapter03.regular_euclideanHausdorffMeasure_restrict_submodule hL.1
        rw [integral_pos_iff_support_of_nonneg (fun z => ϕ.nonneg)
          (ϕ.continuous.integrable_of_hasCompactSupport ϕ.hasCompactSupport), ϕ.support_eq]
        have h0 : (0 : Eucl P) ∈ (μ.restrict (L : Set (Eucl P))).support := by
          rw [Poincare.SimonGMT.Chapter03.support_euclideanHausdorffMeasure_restrict_submodule hL.1]
          exact L.zero_mem
        exact (Measure.mem_support_iff_forall _).1 h0 _ (ball_mem_nhds 0 ϕ.rOut_pos)
      have h0 := tendsto_nhds_unique hlim1 hlim2
      rw [hfL] at h0
      rcases mul_eq_zero.mp h0 with h | h
      · exact absurd h hθx.ne'
      · rcases mul_eq_zero.mp h with h' | h'
        · exact h'
        · exact absurd h' hLϕ.ne'
    filter_upwards [ae_restrict_of_ae_restrict_of_subset inter_subset_left htan,
      ae_restrict_of_ae_restrict_of_subset inter_subset_left hξn, hac.ae_le hleb,
      ae_restrict_of_ae hdμ, ae_restrict_of_ae hdν, ae_restrict_mem₀ hMV]
      with x hxL hxn hxleb hxdμ hxdν hxMV
    obtain ⟨L, hL⟩ := hxL
    obtain ⟨Cμ, hCμ0, hCμ⟩ := hdens μq x hxdμ
    obtain ⟨Cν, hCν0, hCν⟩ := hdens ν x (hxdν hxMV.2)
    obtain ⟨τ, hτon, hτspan, hsign⟩ := hLA (ξ x) L hL.1 hxn
      (hpoint x hxMV.2 (hpos x hxMV.1) L hL hxleb Cμ hCμ0 hCμ Cν hCν0 hCν)
    refine ⟨τ, hτon, ?_, hsign⟩
    rw [hτspan]
    exact hL
  have hcov : M ⊆ ⋃ q, M ∩ W q := by
    intro x hx
    obtain ⟨i, hi⟩ := hWcov {x} isCompact_singleton (singleton_subset_iff.2 (hMU hx))
    exact mem_iUnion.2 ⟨i, hx, hi rfl⟩
  exact ae_restrict_of_ae_restrict_of_subset hcov ((ae_restrict_iUnion_iff _ _).2 hloc)

/-- The lattice `n`-skeleton `⋃_{F ∈ 𝓛ₙ(ρ)} F` of the cubical decomposition of `ℝ^N` of side
`ρ > 0` is closed (used for `spt Q ⊆ Lₙ`, Simon Ch. 6, §5, (22), in the proof of Theorem 5.1).
Each face `ρ (z + F_α)` is an intersection of closed coordinate slabs and hyperplanes; a point
`y ∈ ρ (z + F_α)` has `ρ zᵢ ≤ yᵢ ≤ ρ zᵢ + ρ`, so the ball `B(x, ρ)` meets `ρ (z + F_α)` only if
`xᵢ/ρ − 2 < zᵢ < xᵢ/ρ + 2` for every `i`.  With finitely many `α`, the faces form a locally finite
family, and a locally finite union of closed sets is closed. -/
theorem Submission.deformation_skeleton_isClosed :
    ∀ (n N : ℕ) (ρ : ℝ), 0 < ρ → IsClosed (⋃ F : LatticeFaceIndex n N, latticeFace ρ F) := by
  intro n N ρ hρ
  -- Step 1: every face is closed.
  have hclosed : ∀ F : LatticeFaceIndex n N, IsClosed (latticeFace ρ F) := by
    intro F
    rw [latticeFace, ofPred_forall]
    refine isClosed_iInter fun i => ?_
    have hc : Continuous fun x : Eucl N => x i := PiLp.continuous_apply 2 _ i
    by_cases hi : i ∈ range F.2
    · simpa [hi, ofPred_and] using
        (isClosed_le continuous_const hc).inter (isClosed_le hc continuous_const)
    · simpa [hi] using isClosed_eq hc continuous_const
  -- Steps 2–3: the ball `B(x, ρ)` meets only finitely many faces.
  refine LocallyFinite.isClosed_iUnion (fun x => ?_) hclosed
  refine ⟨ball x ρ, ball_mem_nhds x hρ, ?_⟩
  let T : Fin N → Set ℤ := fun i => ((↑) : ℤ → ℝ) ⁻¹' Ioo (x i / ρ - 2) (x i / ρ + 2)
  have hT : ∀ i, (T i).Finite := fun i => by
    simp only [T, Int.preimage_Ioo]
    exact finite_Ioo _ _
  refine ((Finite.pi hT).prod (toFinite (univ : Set (SimonMultiIndex n N)))).subset ?_
  rintro ⟨z, α⟩ ⟨y, hyF, hyB⟩
  refine ⟨fun i _ => ?_, mem_univ _⟩
  -- Step 2: `ρ zᵢ ≤ yᵢ ≤ ρ zᵢ + ρ`.
  have hy : ρ * (z i : ℝ) ≤ y i ∧ y i ≤ ρ * (z i : ℝ) + ρ := by
    by_cases hi : i ∈ range α
    · have h : ρ * (z i : ℝ) ≤ y i ∧ y i ≤ ρ * ((z i : ℝ) + 1) := (hyF i).1 hi
      exact ⟨h.1, by linarith [h.2]⟩
    · have h : y i = ρ * (z i : ℝ) := (hyF i).2 hi
      exact ⟨h.ge, by linarith⟩
  -- Step 3: `|yᵢ − xᵢ| ≤ |y − x| < ρ`, hence `xᵢ/ρ − 2 < zᵢ < xᵢ/ρ + 2`.
  have hxy : |y i - x i| < ρ := by
    have h1 : dist y x < ρ := hyB
    have h2 : dist (y i) (x i) ≤ dist y x := PiLp.dist_apply_le y x i
    rw [Real.dist_eq] at h2
    linarith
  obtain ⟨hxy1, hxy2⟩ := abs_lt.1 hxy
  show x i / ρ - 2 < (z i : ℝ) ∧ (z i : ℝ) < x i / ρ + 2
  constructor
  · rw [sub_lt_iff_lt_add, div_lt_iff₀ hρ]
    linarith [hy.2]
  · rw [← sub_lt_iff_lt_add, lt_div_iff₀ hρ]
    linarith [hy.1]

/-- Chebyshev choice of a good slicing radius (step 2 of the proof of the Deformation Theorem,
Simon Ch. 6, 5.1, printed (10)).  If `a < b`, `g : ℝ → [0, ∞]` is measurable with
`∫⁻_{(a, b)} g ≤ K` and `N` is Lebesgue-null, then some `t ∈ (a, b) \ N` has
`g t ≤ 2K/(b − a)`.  With `s = 2K/(b − a)`, the set `B = {t ∈ (a, b) : s < g t}` has measure
`< b − a` (it is empty if `K = ∞`, null if `K = 0`, and of measure `≤ (b − a)/2` by Markov's
inequality otherwise), so `(a, b) ⊄ B ∪ N`. -/
theorem Submission.deformation_good_radius :
    ∀ (a b : ℝ) (g : ℝ → ℝ≥0∞) (K : ℝ≥0∞) (N : Set ℝ), a < b → Measurable g → ∫⁻ t in Ioo a b, g t ≤ K → volume N = 0 → ∃ t ∈ Ioo a b, t ∉ N ∧ g t ≤ 2 * K / ENNReal.ofReal (b - a) := by
  intro a b g K N hab hg hK hN
  -- `ℓ = volume (Ioo a b) ∈ (0, ∞)`, `s = 2K/ℓ` and `B = {t ∈ Ioo a b : s < g t}`.
  set ℓ : ℝ≥0∞ := ENNReal.ofReal (b - a)
  have hℓ0 : ℓ ≠ 0 := (ENNReal.ofReal_pos.2 (sub_pos.2 hab)).ne'
  have hℓtop : ℓ ≠ ∞ := ENNReal.ofReal_ne_top
  have hvol : volume (Ioo a b) = ℓ := Real.volume_Ioo
  set s : ℝ≥0∞ := 2 * K / ℓ with hsdef
  set B : Set ℝ := Ioo a b ∩ {t | s < g t} with hBdef
  -- Step 1: `volume B < ℓ`.
  have hB : volume B < ℓ := by
    rcases eq_or_ne K ∞ with hKtop | hKtop
    · -- (a) `K = ∞`: then `s = ∞`, so `B = ∅`.
      have hs : s = ∞ := by
        rw [hsdef, hKtop, ENNReal.mul_top two_ne_zero, ENNReal.top_div_of_ne_top hℓtop]
      have hB0 : B = ∅ := by
        ext t
        simp [hBdef, hs]
      rw [hB0, measure_empty]
      exact pos_iff_ne_zero.2 hℓ0
    rcases eq_or_ne K 0 with hK0 | hK0
    · -- (b) `K = 0`: then `s = 0` and `g = 0` a.e. on `Ioo a b`, so `volume B = 0`.
      have hs : s = 0 := by rw [hsdef, hK0, mul_zero, ENNReal.zero_div]
      have hint : ∫⁻ t in Ioo a b, g t = 0 := le_antisymm (hK.trans hK0.le) zero_le
      have hae : g =ᵐ[volume.restrict (Ioo a b)] 0 := (lintegral_eq_zero_iff hg).1 hint
      have hB0 : volume B = 0 := by
        refine measure_mono_null (t := {t | g t ≠ 0} ∩ Ioo a b) ?_ ?_
        · rintro t ⟨htI, hts⟩
          exact ⟨(hs ▸ hts : (0 : ℝ≥0∞) < g t).ne', htI⟩
        · refine le_antisymm ((Measure.le_restrict_apply _ _).trans (le_of_eq ?_)) zero_le
          exact ae_iff.1 hae
      rw [hB0]
      exact pos_iff_ne_zero.2 hℓ0
    · -- (c) `0 < K < ∞`: Markov's inequality gives `s · volume (Ioo a b ∩ {s ≤ g}) ≤ K`;
      -- `volume B ≥ ℓ` would force `2K = s · ℓ ≤ K`, impossible.
      have hsℓ : s * ℓ = 2 * K := ENNReal.div_mul_cancel hℓ0 hℓtop
      have hmarkov : s * volume.restrict (Ioo a b) {t | s ≤ g t} ≤ K :=
        (mul_meas_ge_le_lintegral hg s).trans hK
      have hBsub : B ⊆ {t | s ≤ g t} ∩ Ioo a b := fun t ht =>
        ⟨show s ≤ g t from le_of_lt ht.2, ht.1⟩
      have hBle : volume B ≤ volume.restrict (Ioo a b) {t | s ≤ g t} :=
        (measure_mono hBsub).trans (Measure.le_restrict_apply _ _)
      refine hBle.trans_lt (lt_of_not_ge fun hle => hK0 ?_)
      have h2K : K + K ≤ K + 0 := by
        rw [add_zero, ← two_mul, ← hsℓ]
        calc s * ℓ ≤ s * volume.restrict (Ioo a b) {t | s ≤ g t} := by gcongr
          _ ≤ K := hmarkov
      exact nonpos_iff_eq_zero.1 ((ENNReal.add_le_add_iff_left hKtop).1 h2K)
  -- Step 2: `Ioo a b ⊄ B ∪ N`, since otherwise `ℓ ≤ volume B + volume N = volume B < ℓ`.
  have hsub : ¬ Ioo a b ⊆ B ∪ N := by
    intro h
    refine (lt_irrefl ℓ) (lt_of_le_of_lt ?_ hB)
    calc ℓ = volume (Ioo a b) := hvol.symm
      _ ≤ volume (B ∪ N) := measure_mono h
      _ ≤ volume B + volume N := measure_union_le _ _
      _ = volume B := by rw [hN, add_zero]
  -- Step 3: a point of `Ioo a b` outside `B ∪ N` is the required `t`.
  obtain ⟨t, htI, htBN⟩ := not_subset.1 hsub
  exact ⟨t, htI, fun htN => htBN (Or.inr htN), not_lt.1 fun hts => htBN (Or.inl ⟨htI, hts⟩)⟩

/-- **Mass limits of currents with summable increments** (Simon Ch. 6, proof of 5.1, I.5,
printed (19)).  If `A_{ν+1} = A_ν + B_ν` and `∑_ν M(B_ν) < ∞`, then `A_ν ⇀ A' = A_0 + ∑_μ B_μ`,
`M(A') ≤ M(A_0) + ∑_ν M(B_ν)`, `M(A' - A_ν) ≤ ∑_μ M(B_{μ+ν})`, and `spt A' ⊆ F` for every closed
`F` containing all `spt A_ν`.  Each tail `∑_μ B_{μ+ν}` is a current of mass at most
`∑_μ M(B_{μ+ν})` (`fiw_ims_series_current`); telescoping gives
`A_ν(ω) = A_0(ω) + ∑_{μ<ν} B_μ(ω)`, so `A' - A_ν` is the `ν`-th tail; supports pass to weak
limits (`iwl_cr_support_lemmas`). -/
theorem Submission.deformation_telescope_limit : ∀ (N k : ℕ) (A B : ℕ → GeometricCurrentOn (univ : Set (Eucl N)) k), (∀ ν ω, A (ν + 1) ω = A ν ω + B ν ω) → (∑' ν, (B ν).mass) < ∞ → ∃ A' : GeometricCurrentOn (univ : Set (Eucl N)) k, WeaklyConvergesOn A A' ∧ A'.mass ≤ (A 0).mass + ∑' ν, (B ν).mass ∧ (∀ (ν : ℕ) (Dν : GeometricCurrentOn (univ : Set (Eucl N)) k), (∀ ω, Dν ω = A' ω - A ν ω) → Dν.mass ≤ ∑' μ, (B (μ + ν)).mass) ∧ ∀ F : Set (Eucl N), IsClosed F → (∀ ν, (A ν).support ⊆ F) → A'.support ⊆ F := by
  intro N k A B hAB hB
  -- For every shift `ν`, the tail series `∑_μ B_{μ+ν}` is a current `S ν` with
  -- `M(S ν) ≤ ∑' μ, M(B_{μ+ν})` (`fiw_ims_series_current` with all coefficients `1`).
  have hS : ∀ ν : ℕ, ∃ S : GeometricCurrentOn (univ : Set (Eucl N)) k,
      (∀ ω, HasSum (fun μ => B (μ + ν) ω) (S ω)) ∧ S.mass ≤ ∑' μ, (B (μ + ν)).mass := by
    intro ν
    -- `M_W(B_{μ+ν}) ≤ M(B_{μ+ν})`, and the shifted sum is at most the full sum `< ∞`.
    have hfin : ∀ W, CompactlyContainedOpen W (univ : Set (Eucl N)) →
        (∑' μ, (((fun _ : ℕ => (1 : ℤ)) μ).natAbs : ℝ≥0∞) * (B (μ + ν)).massOn W) < ∞ := by
      intro W _
      simp only [Int.natAbs_one, Nat.cast_one, one_mul]
      calc ∑' μ, (B (μ + ν)).massOn W ≤ ∑' μ, (B (μ + ν)).mass :=
            ENNReal.tsum_le_tsum fun μ => (B (μ + ν)).massOn_mono (subset_univ W)
        _ ≤ ∑' μ, (B μ).mass :=
            ENNReal.tsum_comp_le_tsum_of_injective (add_left_injective ν) fun μ => (B μ).mass
        _ < ∞ := hB
    obtain ⟨S, hsum, hmass⟩ := Submission.fiw_ims_series_current N k univ isOpen_univ
      (fun μ => B (μ + ν)) (fun _ => 1) hfin
    refine ⟨S, fun ω => ?_, ?_⟩
    · simpa only [Int.cast_one, one_mul] using hsum ω
    · simpa only [GeometricCurrentOn.mass, Int.natAbs_one, Nat.cast_one, one_mul] using hmass univ
  choose S hSsum hSmass using hS
  have hS0 : ∀ ω, HasSum (fun μ => B μ ω) (S 0 ω) := fun ω => by
    simpa only [add_zero] using hSsum 0 ω
  -- The limit `A' = A_0 + S 0`, i.e. `A'(ω) = A_0(ω) + ∑_μ B_μ(ω)`.
  obtain ⟨A', hA'⟩ : ∃ A' : GeometricCurrentOn (univ : Set (Eucl N)) k,
      ∀ ω, A' ω = A 0 ω + S 0 ω :=
    ⟨⟨(A 0).toCurrent + (S 0).toCurrent, fun ωs h => by
      simpa only [LinearMap.add_apply, add_zero] using
        ((A 0).continuous' ωs h).add ((S 0).continuous' ωs h)⟩, fun ω => rfl⟩
  -- Telescoping: `A_ν(ω) = A_0(ω) + ∑_{μ<ν} B_μ(ω)`.
  have htel : ∀ ν ω, A ν ω = A 0 ω + ∑ μ ∈ Finset.range ν, B μ ω := by
    intro ν ω
    induction ν with
    | zero => simp
    | succ ν ih => rw [hAB, ih, Finset.sum_range_succ, add_assoc]
  -- `A_ν(ω)` are the partial sums of a convergent series with sum `A'(ω)`.
  have hconv : WeaklyConvergesOn A A' := by
    intro ω
    rw [hA']
    exact ((hS0 ω).tendsto_sum_nat.const_add (A 0 ω)).congr fun ν => (htel ν ω).symm
  refine ⟨A', hconv, ?_, fun ν Dν hD => ?_, fun F hF hAF =>
    Submission.iwl_cr_support_lemmas.2.1 N k univ isOpen_univ F A A' hF hAF hconv⟩
  · -- `A'(ω) ≤ M(A_0) + M(S 0)` for every admissible `ω`, and `M(S 0) ≤ ∑' ν, M(B_ν)`.
    have hS0mass : (S 0).mass ≤ ∑' ν, (B ν).mass := by
      simpa only [add_zero] using hSmass 0
    refine sSup_le ?_
    rintro _ ⟨ω, hω, rfl⟩
    calc ENNReal.ofReal (A' ω) = ENNReal.ofReal (A 0 ω + S 0 ω) := by rw [hA']
      _ ≤ ENNReal.ofReal (A 0 ω) + ENNReal.ofReal (S 0 ω) := ENNReal.ofReal_add_le
      _ ≤ (A 0).mass + (S 0).mass := add_le_add ((A 0).le_massOn hω) ((S 0).le_massOn hω)
      _ ≤ (A 0).mass + ∑' ν, (B ν).mass := add_le_add le_rfl hS0mass
  · -- `Dν = S ν`: `A'(ω) - A_ν(ω) = ∑_{μ ≥ ν} B_μ(ω) = ∑_μ B_{μ+ν}(ω)`.
    have hDS : Dν = S ν := by
      ext ω
      have h := (hS0 ω).summable.sum_add_tsum_nat_add ν
      rw [(hSsum ν ω).tsum_eq, (hS0 ω).tsum_eq] at h
      rw [hD, hA', htel ν ω, ← h]
      ring
    rw [hDS]
    exact hSmass ν

/-- Measurable tangential differential on a single `C¹` chart (for the push-forward in Simon
Ch. 6, 3.9): let `Φ` be `C¹` with `c ‖w - w'‖ ≤ ‖Φ w - Φ w'‖` (`c > 0`) on the open set `Ω`, and
let `Λ A` be a left inverse of each injective `A` with `‖A (Λ A v)‖ ≤ ‖v‖`, `Λ` continuous on the
injective maps.  With `Ψ` the inverse of `Φ` on `S = Φ(Ω)`, the map
`G x = D(f ∘ Φ)(Ψ x) ∘ Λ(DΦ(Ψ x))` on `S` (`0` elsewhere) is Borel: `S` is Borel by
Lusin–Souslin, `Ψ` is `c⁻¹`-Lipschitz on `S`, `DΦ(w)` is injective by
`lpf_wtc_cat_fderiv_lower_bound`, and `D(f ∘ Φ)` is Borel. -/
theorem Submission.lpf_tde_mcd_single_chart :
    ∀ (P Q n : ℕ) (Λ : (Eucl n →L[ℝ] Eucl P) → (Eucl P →L[ℝ] Eucl n)) (Φ : Eucl n → Eucl P) (Ω : Set (Eucl n)) (f : Eucl P → Eucl Q), ContinuousOn Λ {A : Eucl n →L[ℝ] Eucl P | Function.Injective A} → (∀ A : Eucl n →L[ℝ] Eucl P, Function.Injective A → (Λ A).comp A = ContinuousLinearMap.id ℝ (Eucl n) ∧ ∀ v : Eucl P, ‖A (Λ A v)‖ ≤ ‖v‖) → IsOpen Ω → ContDiff ℝ 1 Φ → (∃ c : ℝ, 0 < c ∧ ∀ w ∈ Ω, ∀ w' ∈ Ω, c * ‖w - w'‖ ≤ ‖Φ w - Φ w'‖) → ∃ G : Eucl P → (Eucl P →L[ℝ] Eucl Q), Measurable G ∧ MeasurableSet (Φ '' Ω) ∧ ∀ x ∈ Φ '' Ω, ∃ w ∈ Ω, Φ w = x ∧ (∀ s : Eucl n, G x (fderiv ℝ Φ w s) = fderiv ℝ (f ∘ Φ) w s) ∧ ∀ v : Eucl P, ∃ s : Eucl n, ‖fderiv ℝ Φ w s‖ ≤ ‖v‖ ∧ G x v = fderiv ℝ (f ∘ Φ) w s := by
  classical
  intro P Q n Λ Φ Ω f hΛc hΛ hΩ hΦ hc
  obtain ⟨c, hcpos, hanti⟩ := hc
  -- `c ‖a‖ ≤ 0` with `c > 0` forces `a = 0`.
  have hzero : ∀ a : Eucl n, c * ‖a‖ ≤ 0 → a = 0 := fun a ha =>
    norm_le_zero_iff.mp (by nlinarith [norm_nonneg a])
  -- `Φ` is injective on `Ω`, so `S = Φ(Ω)` is Borel by the Lusin–Souslin theorem.
  have hinj : InjOn Φ Ω := by
    intro w hw w' hw' h
    have h1 := hanti w hw w' hw'
    rw [h, sub_self, norm_zero] at h1
    exact sub_eq_zero.mp (hzero _ h1)
  have hS : MeasurableSet (Φ '' Ω) :=
    hΩ.measurableSet.image_of_continuousOn_injOn hΦ.continuous.continuousOn hinj
  -- The inverse chart `Ψ` maps `S` into `Ω`, inverts `Φ` there and is `c⁻¹`-Lipschitz on `S`.
  obtain ⟨Ψ, hΨmem, hΨeq⟩ : ∃ Ψ : Eucl P → Eucl n,
      (∀ x ∈ Φ '' Ω, Ψ x ∈ Ω) ∧ ∀ x ∈ Φ '' Ω, Φ (Ψ x) = x :=
    ⟨Function.invFunOn Φ Ω, fun _ hx => Function.invFunOn_mem hx,
      fun _ hx => Function.invFunOn_eq hx⟩
  have hΨcont : ContinuousOn Ψ (Φ '' Ω) := by
    refine (LipschitzOnWith.of_dist_le_mul (K := Real.toNNReal c⁻¹)
      fun x hx x' hx' => ?_).continuousOn
    have h1 := hanti (Ψ x) (hΨmem x hx) (Ψ x') (hΨmem x' hx')
    rw [hΨeq x hx, hΨeq x' hx'] at h1
    rw [dist_eq_norm, dist_eq_norm, Real.coe_toNNReal _ (inv_nonneg.mpr hcpos.le),
      inv_mul_eq_div, le_div_iff₀ hcpos]
    linarith
  -- `DΦ(w)` is injective for `w ∈ Ω` by the lower bound `c ‖s‖ ≤ ‖DΦ(w) s‖`.
  have hDinj : ∀ w ∈ Ω, Function.Injective (fderiv ℝ Φ w) := by
    intro w hw s t hst
    have h1 := Submission.lpf_wtc_cat_fderiv_lower_bound P n Φ Ω c w hΩ hw
      (hΦ.differentiable one_ne_zero w) hanti (s - t)
    rw [map_sub, hst, sub_self, norm_zero] at h1
    exact sub_eq_zero.mp (hzero _ h1)
  -- `Ψ` and `x ↦ Λ(DΦ(Ψ x))`, extended by `0` off `S`, are Borel, and so is `D(f ∘ Φ)`.
  have hΨm : Measurable ((Φ '' Ω).piecewise Ψ fun _ => 0) :=
    hΨcont.measurable_piecewise continuousOn_const hS
  have hΛm : Measurable ((Φ '' Ω).piecewise (fun x => Λ (fderiv ℝ Φ (Ψ x))) fun _ => 0) := by
    refine ContinuousOn.measurable_piecewise ?_ continuousOn_const hS
    exact hΛc.comp ((hΦ.continuous_fderiv one_ne_zero).comp_continuousOn hΨcont)
      fun x hx => hDinj (Ψ x) (hΨmem x hx)
  have hBm := (measurable_fderiv ℝ (f ∘ Φ)).comp hΨm
  -- `G x = D(f ∘ Φ)(Ψ x) ∘ Λ(DΦ(Ψ x))` on `S`; composition of linear maps is continuous.
  refine ⟨fun x => (fderiv ℝ (f ∘ Φ) ((Φ '' Ω).piecewise Ψ (fun _ => 0) x)).comp
      ((Φ '' Ω).piecewise (fun x => Λ (fderiv ℝ Φ (Ψ x))) (fun _ => 0) x),
    isBoundedBilinearMap_comp.continuous.measurable2 hBm hΛm, hS, fun x hx => ?_⟩
  have hA := hΛ _ (hDinj (Ψ x) (hΨmem x hx))
  refine ⟨Ψ x, hΨmem x hx, hΨeq x hx, fun s => ?_,
    fun v => ⟨Λ (fderiv ℝ Φ (Ψ x)) v, hA.2 v, ?_⟩⟩
  · simp only [Set.piecewise_eq_of_mem _ _ _ hx, ContinuousLinearMap.comp_apply]
    rw [← ContinuousLinearMap.comp_apply (Λ _), hA.1, ContinuousLinearMap.id_apply]
  · simp only [Set.piecewise_eq_of_mem _ _ _ hx, ContinuousLinearMap.comp_apply]

/-- Countable measurable gluing by the first index: for measurable sets `S j` and measurable
maps `G j : X → Y` there is a measurable `L : X → Y` vanishing off `⋃ j, S j` and agreeing at each
`x ∈ ⋃ j, S j` with some `G j` such that `x ∈ S j`.  Take `L x = G'_{j(x)} x` with
`G'_j = (S j).piecewise (G j) 0` and `j(x)` the least `j` with `x ∈ S j ∨ x ∉ ⋃ i, S i`;
`L` is measurable by `Measurable.find`. -/
theorem Submission.lpf_tde_mcd_countable_glue :
    ∀ (X Y : Type) [MeasurableSpace X] [MeasurableSpace Y] [Zero Y] (S : ℕ → Set X)
      (G : ℕ → X → Y), (∀ j, MeasurableSet (S j)) → (∀ j, Measurable (G j)) →
      ∃ L : X → Y, Measurable L ∧ (∀ x, x ∉ (⋃ j, S j) → L x = 0) ∧
        ∀ x ∈ (⋃ j, S j), ∃ j, x ∈ S j ∧ L x = G j x := by
  intro X Y _ _ _ S G hS hG
  classical
  -- Every `x` satisfies `x ∈ S j ∨ x ∉ ⋃ i, S i` for some `j`.
  have h : ∀ x, ∃ j, x ∈ S j ∨ x ∉ ⋃ i, S i := fun x => by
    by_cases hx : x ∈ ⋃ i, S i
    · obtain ⟨j, hj⟩ := mem_iUnion.1 hx
      exact ⟨j, Or.inl hj⟩
    · exact ⟨0, Or.inr hx⟩
  -- `L x = G'_{j(x)} x` with `G'_j = (S j).piecewise (G j) 0` and `j(x)` the least such `j`.
  refine ⟨fun x => (S (Nat.find (h x))).piecewise (G (Nat.find (h x))) 0 x, ?_, ?_, ?_⟩
  · exact Measurable.find (p := fun j x => x ∈ S j ∨ x ∉ ⋃ i, S i)
      (fun j => (hG j).piecewise (hS j) measurable_const)
      (fun j => (hS j).union (MeasurableSet.iUnion hS).compl) h
  · intro x hx
    have hxS : x ∉ S (Nat.find (h x)) := fun hxS => hx (mem_iUnion.2 ⟨_, hxS⟩)
    simp only [piecewise_eq_of_notMem _ _ _ hxS, Pi.zero_apply]
  · intro x hx
    have hxS : x ∈ S (Nat.find (h x)) := (Nat.find_spec (h x)).resolve_right (not_not.2 hx)
    exact ⟨Nat.find (h x), hxS, piecewise_eq_of_mem _ _ _ hxS⟩

/-- Moore–Penrose left inverse (Simon Ch. 3 §2, input to 2.1–2.2): `Λ(A) = (A* A)⁻¹ A*` is
continuous on the injective `A : ℝⁿ → ℝ^P`, `Λ(A) A = id`, and the orthogonal projection
`A Λ(A)` onto `range A` does not increase norms. -/
theorem Submission.lpf_tde_continuous_left_inverse :
    ∀ (n P : ℕ), ∃ Λ : (Eucl n →L[ℝ] Eucl P) → (Eucl P →L[ℝ] Eucl n),
      ContinuousOn Λ {A : Eucl n →L[ℝ] Eucl P | Function.Injective A} ∧
      ∀ A : Eucl n →L[ℝ] Eucl P, Function.Injective A →
        (Λ A).comp A = ContinuousLinearMap.id ℝ (Eucl n) ∧ ∀ v : Eucl P, ‖A (Λ A v)‖ ≤ ‖v‖ := by
  intro n P
  -- `A* A` is a unit of the endomorphism ring when `A` is injective.
  have hunit : ∀ A : Eucl n →L[ℝ] Eucl P, Function.Injective A →
      IsUnit ((ContinuousLinearMap.adjoint A).comp A) := by
    intro A hA
    have hinj : Function.Injective ((ContinuousLinearMap.adjoint A).comp A) :=
      (ContinuousLinearMap.adjoint_comp_self_injective_iff A).2 hA
    exact ContinuousLinearMap.isUnit_iff_bijective.2
      ⟨hinj, LinearMap.injective_iff_surjective.1 hinj⟩
  -- `Λ(A) = (A* A)⁻¹ A*`, with `Ring.inverse` (`= 0` off the units).
  refine ⟨fun A => (Ring.inverse ((ContinuousLinearMap.adjoint A).comp A)).comp
    (ContinuousLinearMap.adjoint A), ?_, fun A hA => ?_⟩
  · -- Adjoint, composition and the ring inverse at units are continuous.
    intro A₀ hA₀
    have hadj : Continuous fun A : Eucl n →L[ℝ] Eucl P => ContinuousLinearMap.adjoint A :=
      ContinuousLinearMap.adjoint.continuous
    have hinv : ContinuousAt (fun A : Eucl n →L[ℝ] Eucl P =>
        Ring.inverse ((ContinuousLinearMap.adjoint A).comp A)) A₀ := by
      have h := NormedRing.inverse_continuousAt (hunit A₀ hA₀).unit
      rw [IsUnit.unit_spec] at h
      exact h.comp_of_eq (hadj.clm_comp continuous_id).continuousAt rfl
    exact (hinv.clm_comp hadj.continuousAt).continuousWithinAt
  have hu := hunit A hA
  refine ⟨?_, fun v => ?_⟩
  · -- `Λ(A) A = (A* A)⁻¹ (A* A) = id`.
    rw [ContinuousLinearMap.comp_assoc, ← ContinuousLinearMap.mul_def,
      Ring.inverse_mul_cancel _ hu]
    rfl
  · -- `p := A Λ(A) v` satisfies `A* p = A* v`, so `v - p ⊥ p`; Pythagoras.
    beta_reduce
    set p := A ((Ring.inverse ((ContinuousLinearMap.adjoint A).comp A)).comp
      (ContinuousLinearMap.adjoint A) v) with hp
    have hAp : ContinuousLinearMap.adjoint A p = ContinuousLinearMap.adjoint A v := by
      have h := congrArg (fun T : Eucl n →L[ℝ] Eucl n => T (ContinuousLinearMap.adjoint A v))
        (Ring.mul_inverse_cancel _ hu)
      simpa [ContinuousLinearMap.mul_def, hp] using h
    have horth : inner ℝ (v - p) p = 0 := by
      rw [hp, ← ContinuousLinearMap.adjoint_inner_left, ← hp, map_sub, hAp, sub_self,
        inner_zero_left]
    have h := norm_add_sq_eq_norm_sq_add_norm_sq_real horth
    rw [sub_add_cancel] at h
    exact (mul_self_le_mul_self_iff (norm_nonneg p) (norm_nonneg v)).2
      (by nlinarith [mul_self_nonneg ‖v - p‖])

/-- Borel chartwise tangential differential (Simon Ch. 3 §2, 2.1–2.2, for Ch. 6, 3.6): for C¹
charts `Φ j` antilipschitz on open `Ω j` and any `f`, glue the Borel pieces
`x = Φ j w ↦ D(f ∘ Φ j)(w) ∘ Λ(DΦ j(w))` along the first chart through `x`, and `0` off the
charts; `Λ` is the continuous left inverse of `lpf_tde_continuous_left_inverse`. -/
theorem Submission.lpf_tde_measurable_chart_differential :
    ∀ (P Q n : ℕ) (Φ : ℕ → Eucl n → Eucl P) (Ω : ℕ → Set (Eucl n)) (f : Eucl P → Eucl Q), (∀ j, IsOpen (Ω j)) → (∀ j, ContDiff ℝ 1 (Φ j)) → (∀ j, ∃ c : ℝ, 0 < c ∧ ∀ w ∈ Ω j, ∀ w' ∈ Ω j, c * ‖w - w'‖ ≤ ‖Φ j w - Φ j w'‖) → ∃ L : Eucl P → (Eucl P →L[ℝ] Eucl Q), StronglyMeasurable L ∧ (∀ x, x ∉ (⋃ j, Φ j '' Ω j) → L x = 0) ∧ ∀ x ∈ (⋃ j, Φ j '' Ω j), ∃ j, ∃ w ∈ Ω j, Φ j w = x ∧ (∀ s : Eucl n, L x (fderiv ℝ (Φ j) w s) = fderiv ℝ (f ∘ Φ j) w s) ∧ ∀ v : Eucl P, ∃ s : Eucl n, ‖fderiv ℝ (Φ j) w s‖ ≤ ‖v‖ ∧ L x v = fderiv ℝ (f ∘ Φ j) w s := by
  intro P Q n Φ Ω f hΩ hΦ hanti
  -- Step 0: the continuous left inverse `Λ` on the injective maps.
  obtain ⟨Λ, hΛc, hΛ⟩ := Submission.lpf_tde_continuous_left_inverse n P
  -- Steps 1–5, chart by chart: a Borel piece `G j` on the Borel image `Φ j '' Ω j`.
  choose G hGm hSm hG using fun j =>
    Submission.lpf_tde_mcd_single_chart P Q n Λ (Φ j) (Ω j) f hΛc hΛ (hΩ j) (hΦ j) (hanti j)
  -- Steps 6–7: glue the pieces along the first chart containing `x`, `0` off the charts.
  obtain ⟨L, hLm, hL0, hL⟩ := Submission.lpf_tde_mcd_countable_glue (Eucl P)
    (Eucl P →L[ℝ] Eucl Q) (fun j => Φ j '' Ω j) G hSm hGm
  refine ⟨L, hLm.stronglyMeasurable, hL0, fun x hx => ?_⟩
  -- Step 8: `L x` is the piece of a chart `j` through `x`, so the chart identities transfer.
  obtain ⟨j, hxj, hLx⟩ := hL x hx
  obtain ⟨w, hw, hΦw, hA, hv⟩ := hG j x hxj
  refine ⟨j, w, hw, hΦw, fun s => by rw [hLx]; exact hA s, fun v => ?_⟩
  obtain ⟨s, hs, hGs⟩ := hv v
  exact ⟨s, hs, by rw [hLx]; exact hGs⟩

/-- For `Hⁿ`-a.e. `y ∈ M ∩ Φ(Ω)` and `w ∈ Ω` with `Φ w = y`, `DΦ(w)(ℝⁿ)` is the approximate
tangent space of `M` with multiplicity `θ` at `y` (Simon Ch. 3, proof of 1.6 and Remark 1.8(1),
for one `C¹` chart `Φ` that is antilipschitz on the open set `Ω`). -/
theorem Submission.lpf_weighted_tangent_on_c1_chart :
    ∀ (Q n : ℕ) (V M : Set (Eucl Q)) (θ : Eucl Q → ℝ) (Φ : Eucl n → Eucl Q) (Ω : Set (Eucl n)),
      IsOpen V → M ⊆ V → NullMeasurableSet M (μHE[n] : Measure (Eucl Q)) →
      (∀ y ∈ M, 0 < θ y) →
      (∀ K : Set (Eucl Q), IsCompact K → K ⊆ V →
        IntegrableOn θ (M ∩ K) (μHE[n] : Measure (Eucl Q))) →
      IsOpen Ω → ContDiff ℝ 1 Φ →
      (∃ c : ℝ, 0 < c ∧ ∀ w ∈ Ω, ∀ w' ∈ Ω, c * ‖w - w'‖ ≤ ‖Φ w - Φ w'‖) →
      ∀ᵐ y ∂((μHE[n] : Measure (Eucl Q)).restrict (M ∩ Φ '' Ω)), ∀ w ∈ Ω, Φ w = y →
        HasWeightedApproximateTangentSpaceAt n M θ y
          (LinearMap.range (fderiv ℝ Φ w).toLinearMap) := by
  intro Q n V M θ Φ Ω hV hMV hM hθ hθK hΩ hΦ hanti
  -- `N := Φ(Ω)` is Borel and locally `Hⁿ`-finite.
  obtain ⟨hN, hNK⟩ :=
    Submission.lpf_wtc_chart_image_measurable_locally_finite Q n Φ Ω hΩ hΦ hanti
  -- Compact pieces `C k ⊆ M`, `θ|C k` continuous, `Hⁿ(C k) < ∞`, covering `M` up to a null set.
  obtain ⟨C, hCc, hCM, hθC, hCfin, hMC⟩ :=
    Submission.lpf_wtc_lusin_compact_pieces Q n V M θ hV hMV hM hθ hθK
  have hCm : ∀ k, MeasurableSet (C k) := fun k => (hCc k).isClosed.measurableSet
  -- Zero `n`-density of `Hⁿ ⌞ (C k ∖ N)`, `Hⁿ ⌞ (N ∖ C k)` and `θ Hⁿ ⌞ (M ∖ C k)` off these sets.
  have h₁ := fun k => Submission.lpf_wtc_ae_zero_density_off_set Q n univ (C k \ Φ '' Ω)
    (fun _ => 1) isOpen_univ ((hCm k).diff hN).nullMeasurableSet fun K _ _ => by
      simp only [setLIntegral_one]
      exact (measure_mono (inter_subset_left.trans sdiff_subset)).trans_lt (hCfin k)
  have h₂ := fun k => Submission.lpf_wtc_ae_zero_density_off_set Q n univ (Φ '' Ω \ C k)
    (fun _ => 1) isOpen_univ (hN.diff (hCm k)).nullMeasurableSet fun K hK _ => by
      simp only [setLIntegral_one]
      exact (measure_mono (inter_subset_inter_left K sdiff_subset)).trans_lt (hNK K hK)
  have h₃ := fun k => Submission.lpf_wtc_ae_zero_density_off_set Q n V (M \ C k)
    (fun x => ENNReal.ofReal (θ x)) hV (hM.diff (hCm k).nullMeasurableSet) fun K hK hKV =>
      (lintegral_mono_set (inter_subset_inter_left K sdiff_subset)).trans_lt
        (hθK K hK hKV).setLIntegral_lt_top
  have hall := ae_all_iff.2 fun k => (h₁ k).and ((h₂ k).and (h₃ k))
  rw [ae_restrict_iff'₀ (hM.inter hN.nullMeasurableSet)]
  filter_upwards [hall, measure_eq_zero_iff_ae_notMem.1 hMC] with y hy hyC hyMN w hw hwy
  subst hwy
  obtain ⟨k, hyk⟩ : ∃ k, Φ w ∈ C k := by
    by_contra h
    exact hyC ⟨hyMN.1, fun h' => h (mem_iUnion.1 h')⟩
  obtain ⟨hy₁, hy₂, hy₃⟩ := hy k
  -- `N` has approximate tangent space `T = DΦ(w)(ℝⁿ)` at `Φ w`, and so does `C k`.
  have hCT := Submission.lpf_wtc_tangent_transfer Q n (C k) (Φ '' Ω) (Φ w) _
    (hCm k).nullMeasurableSet hN.nullMeasurableSet
    (Submission.lpf_wtc_chart_approx_tangent Q n Φ Ω hΩ hΦ hanti w hw)
    ⟨1, one_pos, hNK _ (isCompact_closedBall _ _)⟩
    (by simpa only [setLIntegral_one] using hy₁ (mem_univ _) fun h => h.2 hyMN.2)
    (by simpa only [setLIntegral_one] using hy₂ (mem_univ _) fun h => h.2 hyk)
  -- Transfer to `(M, θ)` on a closed ball about `Φ w` inside `V`.
  obtain ⟨ε, hε, hεV⟩ := Metric.isOpen_iff.1 hV _ (hMV hyMN.1)
  exact Submission.lpf_wtc_weighted_tangent_transfer Q n M (C k) θ (Φ w) _ hM
    (hCm k).nullMeasurableSet (hCM k) hyk (fun x hx => (hθ x hx).le) hCT
    ⟨ε / 2, half_pos hε, (measure_mono inter_subset_left).trans_lt (hCfin k),
      hθK _ (isCompact_closedBall _ _) ((closedBall_subset_ball (half_lt_self hε)).trans hεV)⟩
    ((hθC k).continuousWithinAt hyk) (hy₃ (hMV hyMN.1) fun h => h.2 hyk)

/-- Signed change of variables along an injective Lipschitz chart (Simon Ch. 3, 2.6; used for
Ch. 6, 3.9): if `Φ` is Lipschitz and `c`-antilipschitz on the open set `Ω`, `A ⊆ Φ(Ω)` is
`Hᵏ`-null-measurable and `h` is `Hᵏ`-integrable on `A`, then `h(Φ(w)) JΦ(w)` is `Lᵏ`-integrable
on `D = Ω ∩ Φ⁻¹(A)` and `∫_A h dHᵏ = ∫_D h(Φ(w)) JΦ(w) dLᵏ(w)`.  This is the `[0, ∞]`-valued
change of variables applied to the positive and negative parts of `h` and to `|h|`. -/
theorem Submission.deformation_ipl_cc_signed_change_of_variables : ∀ (P k : ℕ) (Φ : Eucl k → Eucl P) (Ω : Set (Eucl k)) (A : Set (Eucl P)) (h : Eucl P → ℝ), IsOpen Ω → (∃ K : ℝ≥0, LipschitzOnWith K Φ Ω) → (∃ c : ℝ, 0 < c ∧ ∀ w ∈ Ω, ∀ w' ∈ Ω, c * ‖w - w'‖ ≤ ‖Φ w - Φ w'‖) → A ⊆ Φ '' Ω → NullMeasurableSet A (μHE[k] : Measure (Eucl P)) → IntegrableOn h A (μHE[k] : Measure (Eucl P)) → IntegrableOn (fun w => h (Φ w) * Real.sqrt (Matrix.of fun i j => inner ℝ (fderiv ℝ Φ w (EuclideanSpace.single i 1)) (fderiv ℝ Φ w (EuclideanSpace.single j 1))).det) (Ω ∩ Φ ⁻¹' A) (volume : Measure (Eucl k)) ∧ ∫ x in A, h x ∂(μHE[k] : Measure (Eucl P)) = ∫ w in Ω ∩ Φ ⁻¹' A, h (Φ w) * Real.sqrt (Matrix.of fun i j => inner ℝ (fderiv ℝ Φ w (EuclideanSpace.single i 1)) (fderiv ℝ Φ w (EuclideanSpace.single j 1))).det ∂(volume : Measure (Eucl k)) := by
  intro P k Φ Ω A h hΩ hΦLip hΦanti hAΦ hAm hh
  set J : Eucl k → ℝ := fun w => Real.sqrt (Matrix.of fun i j => inner ℝ
    (fderiv ℝ Φ w (EuclideanSpace.single i 1)) (fderiv ℝ Φ w (EuclideanSpace.single j 1))).det
  set D : Set (Eucl k) := Ω ∩ Φ ⁻¹' A
  -- The Jacobian `J = JΦ` is nonnegative and Borel: `fderiv ℝ Φ` is Borel, and `J` is a
  -- continuous function of its columns `DΦ(w) eᵢ`.
  have hJ0 : ∀ w, 0 ≤ J w := fun w => Real.sqrt_nonneg _
  have hJm : Measurable J := by
    have hfd : Measurable (fderiv ℝ Φ) := measurable_fderiv ℝ Φ
    have hcol : ∀ i : Fin k, Measurable (fun w => fderiv ℝ Φ w (EuclideanSpace.single i 1)) :=
      fun i => (ContinuousLinearMap.apply ℝ (Eucl P)
        (EuclideanSpace.single i 1)).continuous.measurable.comp hfd
    have hmat : Measurable (fun w => (fun i j => inner ℝ
        (fderiv ℝ Φ w (EuclideanSpace.single i 1)) (fderiv ℝ Φ w (EuclideanSpace.single j 1)) :
          Fin k → Fin k → ℝ)) := by
      refine measurable_pi_iff.mpr fun i => measurable_pi_iff.mpr fun j => ?_
      exact continuous_inner.measurable.comp ((hcol i).prodMk (hcol j))
    have hdet : Continuous (fun f : Fin k → Fin k → ℝ => (Matrix.of f).det) :=
      (show Continuous (fun f : Fin k → Fin k → ℝ => Matrix.of f) from continuous_id).matrix_det
    exact Real.continuous_sqrt.measurable.comp (hdet.measurable.comp hmat)
  -- The `[0, ∞]`-valued change of variables for `h⁺`, `h⁻` and `|h|`.
  obtain ⟨-, hposm, hposeq⟩ := Submission.lpf_raf_chart_change_of_variables P k Φ Ω A
    (fun x => ENNReal.ofReal (h x)) hΩ hΦLip hΦanti hAΦ hAm hh.aemeasurable.ennreal_ofReal
  obtain ⟨-, hnegm, hnegeq⟩ := Submission.lpf_raf_chart_change_of_variables P k Φ Ω A
    (fun x => ENNReal.ofReal (-h x)) hΩ hΦLip hΦanti hAΦ hAm hh.neg.aemeasurable.ennreal_ofReal
  obtain ⟨-, -, habseq⟩ := Submission.lpf_raf_chart_change_of_variables P k Φ Ω A
    (fun x => ‖h x‖ₑ) hΩ hΦLip hΦanti hAΦ hAm hh.aemeasurable.enorm
  -- `h ∘ Φ = (h⁺ ∘ Φ) - (h⁻ ∘ Φ)` is a.e.-measurable on `D`.
  have hhΦ : AEMeasurable (fun w => h (Φ w)) ((volume : Measure (Eucl k)).restrict D) := by
    refine (hposm.ennreal_toReal.sub hnegm.ennreal_toReal).congr
      (Filter.Eventually.of_forall fun w => ?_)
    simp only [Pi.sub_apply]
    rcases le_total 0 (h (Φ w)) with hw | hw
    · rw [ENNReal.toReal_ofReal hw, ENNReal.ofReal_of_nonpos (by linarith), ENNReal.toReal_zero,
        sub_zero]
    · rw [ENNReal.ofReal_of_nonpos hw, ENNReal.toReal_ofReal (by linarith), ENNReal.toReal_zero]
      ring
  -- Integrability on `D`: `∫⁻_D ‖h(Φ(w)) J(w)‖ₑ dw = ∫⁻_A ‖h‖ₑ dHᵏ < ∞`.
  have hFint : IntegrableOn (fun w => h (Φ w) * J w) D (volume : Measure (Eucl k)) := by
    refine ⟨(hhΦ.mul hJm.aemeasurable).aestronglyMeasurable, ?_⟩
    rw [HasFiniteIntegral]
    have : ∫⁻ w in D, ‖h (Φ w) * J w‖ₑ = ∫⁻ x in A, ‖h x‖ₑ ∂(μHE[k] : Measure (Eucl P)) := by
      rw [habseq]
      refine lintegral_congr fun w => ?_
      rw [enorm_mul, Real.enorm_eq_ofReal_abs (J w), abs_of_nonneg (hJ0 w)]
    rw [this]
    exact hh.2
  refine ⟨hFint, ?_⟩
  -- The signed identity: `∫ f = (∫⁻ f⁺) - (∫⁻ f⁻)` on both sides, and
  -- `ofReal (±h(Φ(w))) * ofReal (J w) = ofReal (±h(Φ(w)) * J w)` as `J ≥ 0`.
  rw [integral_eq_lintegral_pos_part_sub_lintegral_neg_part hh,
    integral_eq_lintegral_pos_part_sub_lintegral_neg_part hFint, hposeq, hnegeq]
  congr 2
  · refine lintegral_congr fun w => ?_
    rw [← ENNReal.ofReal_mul' (hJ0 w)]
  · refine lintegral_congr fun w => ?_
    rw [← ENNReal.ofReal_mul' (hJ0 w), neg_mul]

/-- `Hⁿ`-a.e. properties pull back along antilipschitz charts (used for Simon Ch. 6, 3.9): if
`M` is `Hⁿ`-null-measurable, `Ω` and `Φ` are measurable and `c ‖w - w'‖ ≤ ‖Φ w - Φ w'‖` on `Ω`
with `c > 0`, then `Ω ∩ Φ⁻¹(M)` is `Lⁿ`-null-measurable, and a property holding `Hⁿ`-a.e. on
`M ∩ Φ(Ω)` holds at `Φ w` for `Lⁿ`-a.e. `w ∈ Ω ∩ Φ⁻¹(M)`. -/
theorem Submission.lpf_ccr_ae_pullback : ∀ (P n : ℕ) (M : Set (Eucl P)) (Φ : Eucl n → Eucl P) (Ω : Set (Eucl n)) (p : Eucl P → Prop), MeasurableSet Ω → Measurable Φ → (∃ c : ℝ, 0 < c ∧ ∀ w ∈ Ω, ∀ w' ∈ Ω, c * ‖w - w'‖ ≤ ‖Φ w - Φ w'‖) → NullMeasurableSet M (μHE[n] : Measure (Eucl P)) → (∀ᵐ x ∂((μHE[n] : Measure (Eucl P)).restrict (M ∩ Φ '' Ω)), p x) → NullMeasurableSet (Ω ∩ Φ ⁻¹' M) (volume : Measure (Eucl n)) ∧ ∀ᵐ w ∂((volume : Measure (Eucl n)).restrict (Ω ∩ Φ ⁻¹' M)), p (Φ w) := by
  intro P n M Φ Ω p hΩ hΦ ⟨c, hc, hanti⟩ hM hp
  -- `Hⁿ`-null sets of `ℝ^P` pull back to `Lⁿ`-null sets of parameters in `Ω`.
  have hnull := Submission.lpf_raf_chart_preimage_null P n Φ Ω c hc hanti
  -- With `B ⊆ M` measurable and `Hⁿ(M \ B) = 0`, `Ω ∩ Φ⁻¹(M)` is measurable ∪ `Lⁿ`-null.
  obtain ⟨B, hBM, hB, hBae⟩ := hM.exists_measurable_subset_ae_eq
  have hS : Ω ∩ Φ ⁻¹' M = (Ω ∩ Φ ⁻¹' B) ∪ (Ω ∩ Φ ⁻¹' (M \ B)) := by
    ext w
    by_cases hw : Φ w ∈ B
    · simp [hw, hBM hw]
    · simp [hw]
  have hSm : NullMeasurableSet (Ω ∩ Φ ⁻¹' M) (volume : Measure (Eucl n)) := by
    rw [hS]
    exact (hΩ.inter (hΦ hB)).nullMeasurableSet.union_null (hnull _ (ae_eq_set.mp hBae).2)
  refine ⟨hSm, (ae_restrict_iff'₀ hSm).mpr ?_⟩
  -- The exceptional set `{¬p} ∩ (M ∩ Φ(Ω))` is `Hⁿ`-null, so its pullback is `Lⁿ`-null.
  have hZ : (μHE[n] : Measure (Eucl P)) ({x | ¬p x} ∩ (M ∩ Φ '' Ω)) = 0 :=
    nonpos_iff_eq_zero.mp ((Measure.le_restrict_apply _ _).trans_eq (ae_iff.mp hp))
  rw [ae_iff]
  refine measure_mono_null (fun w hw => ?_) (hnull _ hZ)
  have hw' : ¬(w ∈ Ω ∩ Φ ⁻¹' M → p (Φ w)) := hw
  obtain ⟨⟨hwΩ, hwM⟩, hwp⟩ := not_imp.mp hw'
  exact ⟨hwΩ, hwp, hwM, mem_image_of_mem Φ hwΩ⟩

/-- Measurable relative orientation on a `C¹` antilipschitz chart (Simon Ch. 6, proof of 3.9,
step (6c)): for a rectifiable triple `(M, θ, ξ)` and a `C¹` map `Φ` that is antilipschitz on the
open set `Ω`, there is a sign `σ = ±1`, a.e.-strongly measurable for `Lᵏ ⌞ (Ω ∩ Φ⁻¹(M))`, with
`JΦ(w) ξ(Φ(w)) = σ(w) ∂₁Φ(w) ∧ ⋯ ∧ ∂ₖΦ(w)` for `Lᵏ`-a.e. `w ∈ Ω ∩ Φ⁻¹(M)`.  The sign is that of
`⟨ξ(Φ(w)), β_w⟩` for the covector `β_w(u) = det (⟪∂ₐΦ(w), u_b⟫)`, continuous in `w`. -/
theorem Submission.deformation_ipl_cc_chart_orientation_sign : ∀ (P k : ℕ) (U M : Set (Eucl P)) (θ : Eucl P → ℝ) (ξ : Eucl P → NVector (Eucl P) k) (Φ : Eucl k → Eucl P) (Ω : Set (Eucl k)), IsOpen U → IsRectifiableTriple U k M θ ξ → IsOpen Ω → ContDiff ℝ 1 Φ → (∃ c : ℝ, 0 < c ∧ ∀ w ∈ Ω, ∀ w' ∈ Ω, c * ‖w - w'‖ ≤ ‖Φ w - Φ w'‖) → ∃ σ : Eucl k → ℝ, AEStronglyMeasurable σ ((volume : Measure (Eucl k)).restrict (Ω ∩ Φ ⁻¹' M)) ∧ ∀ᵐ w ∂((volume : Measure (Eucl k)).restrict (Ω ∩ Φ ⁻¹' M)), (σ w = 1 ∨ σ w = -1) ∧ Real.sqrt (Matrix.of fun i j => inner ℝ (fderiv ℝ Φ w (EuclideanSpace.single i 1)) (fderiv ℝ Φ w (EuclideanSpace.single j 1))).det • ξ (Φ w) = σ w • simpleNVector (fun b => fderiv ℝ Φ w (EuclideanSpace.single b 1)) := by
  intro P k U M θ ξ Φ Ω hU hT hΩ hΦC1 hΦanti
  have hΦc : Continuous Φ := hΦC1.continuous
  have hΦm : Measurable Φ := hΦc.measurable
  -- A strongly measurable representative `ξt` of `ξ`.
  set ξt := hT.aestronglyMeasurable.mk ξ with hξt
  have hξtm : StronglyMeasurable ξt := hT.aestronglyMeasurable.stronglyMeasurable_mk
  have hξeq : ∀ᵐ x ∂((μHE[k] : Measure (Eucl P)).restrict M), ξ x = ξt x :=
    hT.aestronglyMeasurable.ae_eq_mk
  -- Good points of `M ∩ Φ(Ω)`: tangent spaces from the chart and the orientation, `ξ = ξt`.
  have hgoodH : ∀ᵐ y ∂((μHE[k] : Measure (Eucl P)).restrict (M ∩ Φ '' Ω)),
      (∀ w ∈ Ω, Φ w = y → HasWeightedApproximateTangentSpaceAt k M θ y
          (LinearMap.range (fderiv ℝ Φ w).toLinearMap)) ∧
      (∃ τ : Fin k → Eucl P, Orthonormal ℝ τ ∧
        HasWeightedApproximateTangentSpaceAt k M θ y (Submodule.span ℝ (range τ)) ∧
        (ξ y = simpleNVector τ ∨ ξ y = -simpleNVector τ)) ∧
      ξ y = ξt y := by
    have h1 := Submission.lpf_weighted_tangent_on_c1_chart P k U M θ Φ Ω hU hT.subset
      hT.nullMeasurableSet hT.pos hT.integrableOn hΩ hΦC1 hΦanti
    have h2 := ae_restrict_of_ae_restrict_of_subset (inter_subset_left : M ∩ Φ '' Ω ⊆ M) hT.orients
    have h3 := ae_restrict_of_ae_restrict_of_subset (inter_subset_left : M ∩ Φ '' Ω ⊆ M) hξeq
    filter_upwards [h1, h2, h3] with y hy1 hy2 hy3
    exact ⟨hy1, hy2, hy3⟩
  -- Pull the good points back to parameters.
  obtain ⟨hSm, hgood⟩ := Submission.lpf_ccr_ae_pullback P k M Φ Ω _ hΩ.measurableSet hΦm hΦanti
    hT.nullMeasurableSet hgoodH
  have hmemS : ∀ᵐ w ∂((volume : Measure (Eucl k)).restrict (Ω ∩ Φ ⁻¹' M)), w ∈ Ω ∩ Φ ⁻¹' M :=
    ae_restrict_mem₀ hSm
  set v : Eucl k → Fin k → Eucl P := fun w b => fderiv ℝ Φ w (EuclideanSpace.single b 1) with hv
  set J : Eucl k → ℝ := fun w => Real.sqrt (Matrix.of fun i j => inner ℝ
    (fderiv ℝ Φ w (EuclideanSpace.single i 1)) (fderiv ℝ Φ w (EuclideanSpace.single j 1))).det
    with hJdef
  -- The test covector `β w = covectorPullback (DΦ(w)†) β₀`, `β w u = det (⟪∂ₐΦ(w), u_b⟫)`.
  set β₀ : Covector (Eucl k) k := wedgeCovectors k (fun a => (EuclideanSpace.proj a : Eucl k →L[ℝ] ℝ))
    with hβ₀
  set β : Eucl k → Covector (Eucl P) k :=
    fun w => covectorPullback k (ContinuousLinearMap.adjoint (fderiv ℝ Φ w)) β₀ with hβdef
  have hβv : ∀ w, β w (v w) = (Matrix.of fun i j => inner ℝ (v w i) (v w j)).det := by
    intro w
    simp only [hβdef, covectorPullback_apply, hβ₀, wedgeCovectors_apply_det]
    congr 1
    ext i j
    simp only [Matrix.of_apply, Function.comp_apply]
    have h1 := EuclideanSpace.inner_single_left (𝕜 := ℝ) i (1 : ℝ)
      (ContinuousLinearMap.adjoint (fderiv ℝ Φ w) (v w j))
    rw [ContinuousLinearMap.adjoint_inner_right] at h1
    simp only [map_one, one_mul] at h1
    rw [h1]
    rfl
  have hβc : Continuous β := by
    have hfd : Continuous (fderiv ℝ Φ) := hΦC1.continuous_fderiv one_ne_zero
    have hadj : Continuous (fun w => ContinuousLinearMap.adjoint (fderiv ℝ Φ w)) :=
      (ContinuousLinearMap.adjoint (𝕜 := ℝ) (E := Eucl k) (F := Eucl P)).continuous.comp hfd
    have hcomp : Continuous (fun A : Eucl P →L[ℝ] Eucl k =>
        (covectorPullback k A : Covector (Eucl k) k →L[ℝ] Covector (Eucl P) k)) :=
      ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM
    exact (hcomp.comp hadj).clm_apply continuous_const
  -- The sign `σ` of the pairing `p w = ⟨ξ(Φ(w)), β w⟩`, and its measurability.
  set p : Eucl k → ℝ := fun w => ξ (Φ w) (β w) with hp
  set σ : Eucl k → ℝ := fun w => if 0 ≤ p w then 1 else -1 with hσdef
  have hpm : AEStronglyMeasurable p ((volume : Measure (Eucl k)).restrict (Ω ∩ Φ ⁻¹' M)) := by
    have hξΦ : AEStronglyMeasurable (fun w => ξ (Φ w))
        ((volume : Measure (Eucl k)).restrict (Ω ∩ Φ ⁻¹' M)) := by
      refine (hξtm.comp_measurable hΦm).aestronglyMeasurable.congr ?_
      filter_upwards [hgood] with w hw
      exact hw.2.2.symm
    have hpair : Continuous (fun q : NVector (Eucl P) k × Covector (Eucl P) k => q.1 q.2) :=
      isBoundedBilinearMap_apply.continuous
    exact hpair.comp_aestronglyMeasurable (hξΦ.prodMk hβc.aestronglyMeasurable)
  have hσm : AEStronglyMeasurable σ ((volume : Measure (Eucl k)).restrict (Ω ∩ Φ ⁻¹' M)) := by
    have hs : Measurable (fun t : ℝ => if 0 ≤ t then (1 : ℝ) else -1) :=
      Measurable.ite measurableSet_Ici measurable_const measurable_const
    exact (hs.comp_aemeasurable hpm.aemeasurable).aestronglyMeasurable
  refine ⟨σ, hσm, ?_⟩
  filter_upwards [hgood, hmemS] with w hw hwS
  obtain ⟨hw1, ⟨τ, hτ, hτT, hξτ⟩, -⟩ := hw
  -- `range DΦ(w) = span τ` by uniqueness of the weighted approximate tangent space (`θ > 0`).
  have hθpos : 0 < θ (Φ w) := hT.pos _ hwS.2
  have hrange : LinearMap.range (fderiv ℝ Φ w).toLinearMap = Submodule.span ℝ (range τ) :=
    HasWeightedApproximateTangentSpaceAt.unique hθpos.ne' (hw1 w hwS.1 rfl) hτT
  have hσval : σ w = 1 ∨ σ w = -1 := by
    simp only [hσdef]; split_ifs <;> simp
  refine ⟨hσval, ?_⟩
  -- `∂Φ(w) = B τ` with `B_{ba} = ⟪τ_a, ∂_bΦ(w)⟫`, so `simpleNVector ∂Φ(w) = det B • simpleNVector τ`.
  have hvmem : ∀ b, v w b ∈ Submodule.span ℝ (range τ) := by
    intro b; rw [← hrange]; exact LinearMap.mem_range_self _ _
  have hvexp : ∀ b, (∑ a, inner ℝ (τ a) (v w b) • τ a) = v w b := by
    intro b
    obtain ⟨cf, hcf⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp (hvmem b)
    have hc : ∀ a, inner ℝ (τ a) (v w b) = cf a := by
      intro a; rw [← hcf]; exact hτ.inner_right_fintype cf a
    simp_rw [hc]; exact hcf
  set B : Matrix (Fin k) (Fin k) ℝ := Matrix.of fun b a => inner ℝ (τ a) (v w b) with hB
  have hS : simpleNVector (v w) = B.det • simpleNVector τ := by
    rw [← Submission.lpf_simple_nvector_algebra.2 P k B τ]
    congr 1
    funext b
    simp only [hB, Matrix.of_apply]
    exact (hvexp b).symm
  -- Norms: `‖simpleNVector τ‖ = 1`, `JΦ(w) = |det B|` and `β w (∂Φ(w)) = (det B)²`.
  have hsτ : ‖simpleNVector τ‖ = 1 := by
    have h := Submission.lpf_simple_nvector_algebra.1 P k τ
    have hG : (Matrix.of fun i j => inner ℝ (τ i) (τ j)) = (1 : Matrix (Fin k) (Fin k) ℝ) := by
      ext i j
      simp [Matrix.one_apply, orthonormal_iff_ite.mp hτ]
    rw [hG, Matrix.det_one] at h
    have h0 : 0 ≤ ‖simpleNVector τ‖ := ContinuousLinearMap.opNorm_nonneg _
    nlinarith [h]
  have hnsmul : ∀ (d : ℝ) (s : NVector (Eucl P) k), ‖d • s‖ = |d| * ‖s‖ := by
    intro d s
    apply le_antisymm
    · simpa [Real.norm_eq_abs] using ContinuousLinearMap.opNorm_smul_le d s
    · by_cases hd : d = 0
      · simp only [hd, abs_zero, zero_mul]; exact ContinuousLinearMap.opNorm_nonneg _
      · have h := ContinuousLinearMap.opNorm_smul_le d⁻¹ (d • s)
        rw [smul_smul, inv_mul_cancel₀ hd, one_smul, Real.norm_eq_abs, abs_inv] at h
        have hpos : 0 < |d| := abs_pos.mpr hd
        calc |d| * ‖s‖ ≤ |d| * (|d|⁻¹ * ‖d • s‖) := by gcongr
          _ = ‖d • s‖ := by field_simp
  have hnormS : ‖simpleNVector (v w)‖ = |B.det| := by
    rw [hS, hnsmul, hsτ, mul_one]
  have hJ : J w = |B.det| := by
    have h := Submission.lpf_simple_nvector_algebra.1 P k (v w)
    show Real.sqrt (Matrix.of fun i j => inner ℝ (v w i) (v w j)).det = |B.det|
    rw [← h, Real.sqrt_sq (ContinuousLinearMap.opNorm_nonneg _), hnormS]
  have hSβ : simpleNVector (v w) (β w) = B.det ^ 2 := by
    rw [simpleNVector_apply, hβv, ← Submission.lpf_simple_nvector_algebra.1 P k (v w), hnormS,
      sq_abs]
  -- Case analysis on `det B` and on the orientation `ξ(Φ(w)) = ±simpleNVector τ`.
  by_cases hd : B.det = 0
  · have hJ0 : J w = 0 := by rw [hJ, hd, abs_zero]
    have hS0 : simpleNVector (v w) = 0 := by rw [hS, hd, zero_smul]
    show J w • ξ (Φ w) = σ w • simpleNVector (v w)
    rw [hJ0, zero_smul, hS0, smul_zero]
  · have hs : simpleNVector τ (β w) = B.det := by
      have h1 : B.det * simpleNVector τ (β w) = B.det * B.det := by
        have := hSβ
        rw [hS, smul_apply, smul_eq_mul] at this
        rw [this]; ring
      exact mul_left_cancel₀ hd h1
    show J w • ξ (Φ w) = σ w • simpleNVector (v w)
    rw [hJ, hS, smul_smul]
    rcases hξτ with h | h
    · have hp' : p w = B.det := by
        show ξ (Φ w) (β w) = B.det
        rw [h, hs]
      rw [h]
      congr 1
      simp only [hσdef, hp']
      split_ifs with h0
      · rw [abs_of_nonneg h0]; ring
      · rw [abs_of_neg (lt_of_not_ge h0)]; ring
    · have hp' : p w = -B.det := by
        show ξ (Φ w) (β w) = -B.det
        rw [h, neg_apply, hs]
      rw [h]
      have hcoef : -|B.det| = σ w * B.det := by
        simp only [hσdef, hp']
        split_ifs with h0
        · have hneg : B.det < 0 := lt_of_le_of_ne (by linarith) hd
          rw [abs_of_neg hneg]; ring
        · have hpos : 0 < B.det := by linarith
          rw [abs_of_pos hpos]; ring
      ext γ
      simp only [smul_apply, neg_apply, smul_eq_mul]
      rw [← hcoef]; ring

/-- Chart representation of push-forward integrals (steps (6a)–(6d) of the chart convergence in
the C¹ push-forward limit behind the proof of Simon Ch. 6, 5.1): let `Φ` be C¹, Lipschitz and
`c`-antilipschitz (`c > 0`) on the open `Ω ⊆ ℝᵏ`, and let `G ⊆ M ∩ Φ(Ω)` be `Hᵏ`-null-measurable
with `θ ∈ L¹(Hᵏ ⌞ G)`.  With `D = Ω ∩ Φ⁻¹(G)` and the chart orientation sign `σ = ±1`, the weight
`ψ = 1_D (θ ∘ Φ) σ` is in `L¹(Ω)` (as `JΦ ≥ cᵏ` and `∫_D (θ ∘ Φ) JΦ = ∫_G θ`), and
`∫_G θ ⟨α(f), A_# ξ⟩ dHᵏ = ∫_Ω ψ ⟨α(f(Φ)), ∂₀(f ∘ Φ) ∧ ⋯ ∧ ∂ₖ₋₁(f ∘ Φ)⟩ dLᵏ` whenever
`D(f ∘ Φ)(w) = A(Φ w) ∘ DΦ(w)` a.e. on `D` and the left integrand is integrable: by the signed
change of variables, `JΦ(w) ξ(Φ w) = σ(w) ∂₀Φ(w) ∧ ⋯ ∧ ∂ₖ₋₁Φ(w)` and `A(Φ w) ∂_bΦ = ∂_b(f ∘ Φ)`. -/
theorem Submission.deformation_ipl_cc_chart_integral_representation : ∀ (P Q k : ℕ) (U M : Set (Eucl P)) (θ : Eucl P → ℝ) (ξ : Eucl P → NVector (Eucl P) k) (Φ : Eucl k → Eucl P) (Ω : Set (Eucl k)) (G : Set (Eucl P)), IsOpen U → IsRectifiableTriple U k M θ ξ → IsOpen Ω → ContDiff ℝ 1 Φ → (∃ K : ℝ≥0, LipschitzOnWith K Φ Ω) → (∃ c : ℝ, 0 < c ∧ ∀ w ∈ Ω, ∀ w' ∈ Ω, c * ‖w - w'‖ ≤ ‖Φ w - Φ w'‖) → G ⊆ M → G ⊆ Φ '' Ω → NullMeasurableSet G (μHE[k] : Measure (Eucl P)) → IntegrableOn θ G (μHE[k] : Measure (Eucl P)) → ∃ ψ : Eucl k → ℝ, IntegrableOn ψ Ω (volume : Measure (Eucl k)) ∧ ∀ (f : Eucl P → Eucl Q) (A : Eucl P → (Eucl P →L[ℝ] Eucl Q)) (α : Eucl Q → Covector (Eucl Q) k), (∀ᵐ w ∂((volume : Measure (Eucl k)).restrict (Ω ∩ Φ ⁻¹' G)), HasFDerivAt (f ∘ Φ) ((A (Φ w)).comp (fderiv ℝ Φ w)) w) → IntegrableOn (fun x => θ x * nVectorPushforward k (A x) (ξ x) (α (f x))) G (μHE[k] : Measure (Eucl P)) → ∫ x in G, θ x * nVectorPushforward k (A x) (ξ x) (α (f x)) ∂(μHE[k] : Measure (Eucl P)) = ∫ w in Ω, ψ w * α (f (Φ w)) (fun b => fderiv ℝ (f ∘ Φ) w (EuclideanSpace.single b 1)) ∂(volume : Measure (Eucl k)) := by
  intro P Q k U M θ ξ Φ Ω G hU hT hΩ hΦC1 hΦLip hΦanti hGM hGΦ hGm hθG
  obtain ⟨c, hc, hcanti⟩ := hΦanti
  set J : Eucl k → ℝ := fun w => Real.sqrt (Matrix.of fun i j => inner ℝ
    (fderiv ℝ Φ w (EuclideanSpace.single i 1)) (fderiv ℝ Φ w (EuclideanSpace.single j 1))).det
    with hJdef
  set D : Set (Eucl k) := Ω ∩ Φ ⁻¹' G with hDdef
  have hDΩ : D ⊆ Ω := inter_subset_left
  have hDM : D ⊆ Ω ∩ Φ ⁻¹' M := fun w hw => ⟨hw.1, hGM hw.2⟩
  -- (6a) `c ‖s‖ ≤ ‖DΦ(w) s‖` on `Ω`, hence `cᵏ ≤ JΦ(w)` by the Gram determinant bound.
  have hJlow : ∀ w ∈ Ω, c ^ k ≤ J w := fun w hw =>
    Submission.deformation_ipl_cc_gram_det_lower_bound P k (fderiv ℝ Φ w) c hc.le
      (Submission.lpf_wtc_cat_fderiv_lower_bound P k Φ Ω c w hΩ hw
        ((hΦC1.differentiable one_ne_zero) w) hcanti)
  -- (6c) The orientation sign `σ = ±1` with `JΦ ξ(Φ) = σ ∂₀Φ ∧ ⋯ ∧ ∂ₖ₋₁Φ`, restricted to `D`.
  obtain ⟨σ, hσm, hσ⟩ := Submission.deformation_ipl_cc_chart_orientation_sign P k U M θ ξ Φ Ω
    hU hT hΩ hΦC1 ⟨c, hc, hcanti⟩
  have hσD : ∀ᵐ w ∂((volume : Measure (Eucl k)).restrict D), (σ w = 1 ∨ σ w = -1) ∧
      J w • ξ (Φ w) = σ w • simpleNVector (fun b => fderiv ℝ Φ w (EuclideanSpace.single b 1)) :=
    ae_restrict_of_ae_restrict_of_subset hDM hσ
  -- (6b) Change of variables for `θ`: `D` is null-measurable, `θ ∘ Φ` is a.e.-measurable on `D`
  -- and `∫_G θ dHᵏ = ∫_D (θ ∘ Φ) JΦ dLᵏ` (in `ℝ≥0∞`).
  have hθae : AEMeasurable (fun x => ENNReal.ofReal (θ x))
      ((μHE[k] : Measure (Eucl P)).restrict G) := hθG.aemeasurable.ennreal_ofReal
  obtain ⟨hDm, hθΦm, hθCoV⟩ := Submission.lpf_raf_chart_change_of_variables P k Φ Ω G
    (fun x => ENNReal.ofReal (θ x)) hΩ hΦLip ⟨c, hc, hcanti⟩ hGΦ hGm hθae
  have hmemD : ∀ᵐ w ∂((volume : Measure (Eucl k)).restrict D), w ∈ D := ae_restrict_mem₀ hDm
  have hθΦpos : ∀ w ∈ D, 0 < θ (Φ w) := fun w hw => hT.pos _ (hGM hw.2)
  have hθΦae : AEMeasurable (fun w => θ (Φ w)) ((volume : Measure (Eucl k)).restrict D) := by
    refine hθΦm.ennreal_toReal.congr ?_
    filter_upwards [hmemD] with w hw
    exact ENNReal.toReal_ofReal (hθΦpos w hw).le
  have hσDm : AEStronglyMeasurable σ ((volume : Measure (Eucl k)).restrict D) :=
    hσm.mono_measure (Measure.restrict_mono hDM le_rfl)
  have hDmΩ : NullMeasurableSet D ((volume : Measure (Eucl k)).restrict Ω) :=
    hDm.mono_ac Measure.restrict_le_self.absolutelyContinuous
  have hrestrDΩ : ((volume : Measure (Eucl k)).restrict Ω).restrict D =
      (volume : Measure (Eucl k)).restrict D := by
    rw [Measure.restrict_restrict₀ hDmΩ, inter_eq_left.mpr hDΩ]
  -- The weight `ψ = 1_D F₁`, `F₁ = (θ ∘ Φ) σ`, is a.e.-strongly measurable on `Ω`.
  set F₁ : Eucl k → ℝ := fun w => θ (Φ w) * σ w with hF₁
  set ψ : Eucl k → ℝ := D.indicator F₁ with hψdef
  have hF₁m : AEStronglyMeasurable F₁ ((volume : Measure (Eucl k)).restrict D) :=
    hθΦae.aestronglyMeasurable.mul hσDm
  have hψm : AEStronglyMeasurable ψ ((volume : Measure (Eucl k)).restrict Ω) := by
    rw [hψdef, aestronglyMeasurable_indicator_iff₀ hDmΩ, hrestrDΩ]
    exact hF₁m
  have hck : 0 < c ^ k := pow_pos hc k
  have hck0 : ENNReal.ofReal (c ^ k) ≠ 0 := by simpa using hck
  refine ⟨ψ, ?_, ?_⟩
  · -- (6d) `∫_Ω |ψ| = ∫_D θ ∘ Φ ≤ c⁻ᵏ ∫_D (θ ∘ Φ) JΦ = c⁻ᵏ ∫_G θ < ∞`.
    refine ⟨hψm, ?_⟩
    rw [HasFiniteIntegral]
    have h1 : ∫⁻ w in Ω, ‖ψ w‖ₑ = ∫⁻ w in D, ‖F₁ w‖ₑ := by
      have : (fun w => ‖ψ w‖ₑ) = D.indicator (fun w => ‖F₁ w‖ₑ) := by
        funext w
        by_cases hw : w ∈ D
        · simp [hψdef, hw]
        · simp [hψdef, hw]
      rw [this, lintegral_indicator₀ hDmΩ, hrestrDΩ]
    rw [h1]
    have h2 : ∫⁻ w in D, ‖F₁ w‖ₑ ≤ ∫⁻ w in D,
        (ENNReal.ofReal (c ^ k))⁻¹ * (ENNReal.ofReal (θ (Φ w)) * ENNReal.ofReal (J w)) := by
      refine lintegral_mono_ae ?_
      filter_upwards [hσD, hmemD] with w hw hwD
      have hθp := hθΦpos w hwD
      have hσ1 : |σ w| = 1 := by rcases hw.1 with h | h <;> simp [h]
      have hle : c ^ k ≤ J w := hJlow w hwD.1
      calc ‖F₁ w‖ₑ = ENNReal.ofReal (θ (Φ w)) := by
            rw [hF₁, Real.enorm_eq_ofReal_abs, abs_mul, hσ1, abs_of_pos hθp, mul_one]
        _ = (ENNReal.ofReal (c ^ k))⁻¹ * (ENNReal.ofReal (θ (Φ w)) * ENNReal.ofReal (c ^ k)) := by
            rw [mul_comm (ENNReal.ofReal (θ (Φ w))), ← mul_assoc,
              ENNReal.inv_mul_cancel hck0 ENNReal.ofReal_ne_top, one_mul]
        _ ≤ (ENNReal.ofReal (c ^ k))⁻¹ * (ENNReal.ofReal (θ (Φ w)) * ENNReal.ofReal (J w)) := by
            gcongr
    refine lt_of_le_of_lt h2 ?_
    rw [lintegral_const_mul' _ _ (ENNReal.inv_ne_top.mpr hck0), ← hθCoV]
    refine ENNReal.mul_lt_top (ENNReal.inv_lt_top.mpr (by simpa using hck)) ?_
    refine lt_of_le_of_lt ?_ hθG.2
    refine lintegral_mono fun x => ?_
    rw [Real.enorm_eq_ofReal_abs]
    exact ENNReal.ofReal_le_ofReal (le_abs_self _)
  · -- (7) `∫_G h dHᵏ = ∫_D h(Φ) JΦ dLᵏ` by the signed change of variables, and pointwise on `D`
    -- `h(Φ w) JΦ(w) = F₁(w) α(f(Φ w))(∂(f ∘ Φ)(w))`.
    intro f A α hfd hint
    obtain ⟨-, hcov⟩ := Submission.deformation_ipl_cc_signed_change_of_variables P k Φ Ω G
      (fun x => θ x * nVectorPushforward k (A x) (ξ x) (α (f x)))
      hΩ hΦLip ⟨c, hc, hcanti⟩ hGΦ hGm hint
    rw [hcov]
    have hR : ∫ w in Ω, ψ w * α (f (Φ w))
          (fun b => fderiv ℝ (f ∘ Φ) w (EuclideanSpace.single b 1)) =
        ∫ w in D, F₁ w * α (f (Φ w))
          (fun b => fderiv ℝ (f ∘ Φ) w (EuclideanSpace.single b 1)) := by
      have : (fun w => ψ w * α (f (Φ w))
            (fun b => fderiv ℝ (f ∘ Φ) w (EuclideanSpace.single b 1))) =
          D.indicator (fun w => F₁ w * α (f (Φ w))
            (fun b => fderiv ℝ (f ∘ Φ) w (EuclideanSpace.single b 1))) := by
        funext w
        by_cases hw : w ∈ D
        · simp [hψdef, hw]
        · simp [hψdef, hw]
      rw [this, integral_indicator₀ hDmΩ, hrestrDΩ]
    rw [hR]
    refine setIntegral_congr_ae₀ hDm ?_
    have hgood := (ae_restrict_iff'₀ hDm).mp (hσD.and hfd)
    filter_upwards [hgood] with w hw hwD
    obtain ⟨⟨-, hJξ⟩, hder⟩ := hw hwD
    set v : Fin k → Eucl P := fun b => fderiv ℝ Φ w (EuclideanSpace.single b 1) with hv
    set β : Covector (Eucl P) k := covectorPullback k (A (Φ w)) (α (f (Φ w))) with hβ
    -- Evaluate `JΦ ξ(Φ w) = σ v₀ ∧ ⋯ ∧ vₖ₋₁` at `β = A(Φ w)^# α(f(Φ w))`.
    have key : ξ (Φ w) β * J w = σ w * β v := by
      have := congrArg (fun T : NVector (Eucl P) k => T β) hJξ
      simp only [smul_apply, smul_eq_mul, simpleNVector_apply] at this
      linarith [this]
    -- The chain rule: `∂_b(f ∘ Φ)(w) = A(Φ w) v_b`.
    have hfv : (fun b => fderiv ℝ (f ∘ Φ) w (EuclideanSpace.single b 1)) =
        (A (Φ w)) ∘ v := by
      funext b
      rw [hder.fderiv]
      rfl
    have hβv : β v = α (f (Φ w)) ((A (Φ w)) ∘ v) := by
      rw [hβ, covectorPullback_apply]
    show θ (Φ w) * nVectorPushforward k (A (Φ w)) (ξ (Φ w)) (α (f (Φ w))) * J w =
      F₁ w * α (f (Φ w)) (fun b => fderiv ℝ (f ∘ Φ) w (EuclideanSpace.single b 1))
    have hpush : nVectorPushforward k (A (Φ w)) (ξ (Φ w)) (α (f (Φ w))) = ξ (Φ w) β := rfl
    rw [hpush, mul_assoc, key, hβv, hfv, hF₁]
    ring

/-- Push-forward integrands on a rectifiable triple (Simon Ch. 6, 3.6–3.9): if `x ↦ A(x)_# ξ(x)`
and `β` are `Hᵏ⌞M`-a.e.-strongly measurable and `|A(x) v| ≤ Λ |v|` on the weighted approximate
tangent spaces of `(M, θ)` at `Hᵏ`-a.e. `x ∈ M`, then `θ · ⟨β, A_# ξ⟩` is `Hᵏ⌞M`-a.e.-strongly
measurable and bounded by `Λᵏ ‖β‖ θ` at `Hᵏ`-a.e. point of `M`.  Measurability of `θ` comes from
exhausting `U` by compact sets; the bound evaluates `β` on the frame `A(x) τ`, where
`ξ(x) = ±τ₁ ∧ ⋯ ∧ τₖ`. -/
theorem Submission.deformation_ipl_cc_pushforward_integrand_bound : ∀ (P Q k : ℕ) (U M : Set (Eucl P)) (θ : Eucl P → ℝ) (ξ : Eucl P → NVector (Eucl P) k) (A : Eucl P → (Eucl P →L[ℝ] Eucl Q)) (β : Eucl P → Covector (Eucl Q) k) (Λ : ℝ), IsOpen U → IsRectifiableTriple U k M θ ξ → AEStronglyMeasurable (fun x => nVectorPushforward k (A x) (ξ x)) ((μHE[k] : Measure (Eucl P)).restrict M) → AEStronglyMeasurable β ((μHE[k] : Measure (Eucl P)).restrict M) → (∀ᵐ x ∂((μHE[k] : Measure (Eucl P)).restrict M), ∀ Tx : Submodule ℝ (Eucl P), HasWeightedApproximateTangentSpaceAt k M θ x Tx → ∀ v ∈ Tx, ‖A x v‖ ≤ Λ * ‖v‖) → AEStronglyMeasurable (fun x => θ x * nVectorPushforward k (A x) (ξ x) (β x)) ((μHE[k] : Measure (Eucl P)).restrict M) ∧ ∀ᵐ x ∂((μHE[k] : Measure (Eucl P)).restrict M), |θ x * nVectorPushforward k (A x) (ξ x) (β x)| ≤ Λ ^ k * ‖β x‖ * θ x := by
  intro P Q k U M θ ξ A β Λ hU hT hAξm hβm hA
  -- `θ` is a.e.-strongly measurable on `M`: exhaust `U` by the compact sets
  -- `K_q = B̄(0, q) ∖ thickening (1 / (q + 1)) Uᶜ`.
  set Kq : ℕ → Set (Eucl P) := fun q =>
    closedBall (0 : Eucl P) q ∩ (thickening (1 / ((q : ℝ) + 1)) Uᶜ)ᶜ with hKq
  have hKqc : ∀ q, IsCompact (Kq q) := fun q =>
    (isCompact_closedBall _ _).inter_right isOpen_thickening.isClosed_compl
  have hKqU : ∀ q, Kq q ⊆ U := by
    intro q x hx
    by_contra hxU
    exact hx.2 (Metric.self_subset_thickening (by positivity) _ hxU)
  have hUcov : U ⊆ ⋃ q, Kq q := by
    intro x hx
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hU x hx
    obtain ⟨q₁, hq₁⟩ := exists_nat_one_div_lt hε
    obtain ⟨q₂, hq₂⟩ := exists_nat_ge ‖x‖
    refine mem_iUnion.mpr ⟨max q₁ q₂, ?_, ?_⟩
    · rw [mem_closedBall, dist_zero_right]
      exact hq₂.trans (by exact_mod_cast le_max_right q₁ q₂)
    · intro hth
      obtain ⟨z, hz, hdz⟩ := Metric.mem_thickening_iff.mp hth
      apply hz
      apply hball
      rw [mem_ball, dist_comm]
      calc dist x z < 1 / ((max q₁ q₂ : ℕ) + 1 : ℝ) := hdz
        _ ≤ 1 / ((q₁ : ℝ) + 1) := by
            gcongr
            exact_mod_cast le_max_left q₁ q₂
        _ < ε := hq₁
  have hMeq : M = ⋃ q, M ∩ Kq q := by
    ext x
    simp only [mem_iUnion, mem_inter_iff]
    constructor
    · intro hx
      obtain ⟨q, hq⟩ := mem_iUnion.mp (hUcov (hT.subset hx))
      exact ⟨q, hx, hq⟩
    · rintro ⟨q, hx, -⟩; exact hx
  have hθm : AEStronglyMeasurable θ ((μHE[k] : Measure (Eucl P)).restrict M) := by
    rw [hMeq, aestronglyMeasurable_iUnion_iff]
    intro q
    exact (hT.integrableOn (Kq q) (hKqc q) (hKqU q)).aestronglyMeasurable
  constructor
  · -- The pairing `(N, γ) ↦ N γ` is continuous.
    have hpair : Continuous (fun p : NVector (Eucl Q) k × Covector (Eucl Q) k => p.1 p.2) :=
      isBoundedBilinearMap_apply.continuous
    exact hθm.mul (hpair.comp_aestronglyMeasurable (hAξm.prodMk hβm))
  · -- At a.e. `x ∈ M`, `ξ x = ±simpleNVector τ` for an orthonormal tangent frame `τ`, and
    -- `|A x (τ a)| ≤ Λ`.
    filter_upwards [hT.orients, hA, ae_restrict_mem₀ hT.nullMeasurableSet] with x hor hAx hxM
    obtain ⟨τ, hτ, hτT, hξτ⟩ := hor
    have hθ : 0 < θ x := hT.pos x hxM
    have hb : ∀ a, ‖A x (τ a)‖ ≤ Λ := fun a => by
      have := hAx _ hτT (τ a) (Submodule.subset_span (mem_range_self a))
      rwa [hτ.1 a, mul_one] at this
    have hval : |nVectorPushforward k (A x) (ξ x) (β x)| = |β x (fun a => A x (τ a))| := by
      rcases hξτ with h | h
      · rw [h, nVectorPushforward_simple, simpleNVector_apply]; rfl
      · have : nVectorPushforward k (A x) (-simpleNVector τ) (β x) =
            -(nVectorPushforward k (A x) (simpleNVector τ) (β x)) := rfl
        rw [h, this, abs_neg, nVectorPushforward_simple, simpleNVector_apply]; rfl
    have hprod : ∏ a, ‖A x (τ a)‖ ≤ Λ ^ k := by
      calc ∏ a, ‖A x (τ a)‖ ≤ ∏ _a : Fin k, Λ :=
            Finset.prod_le_prod₀ (fun a _ => norm_nonneg _) (fun a _ => hb a)
        _ = Λ ^ k := by simp
    have hle : |β x (fun a => A x (τ a))| ≤ Λ ^ k * ‖β x‖ := by
      calc |β x (fun a => A x (τ a))| = ‖β x (fun a => A x (τ a))‖ := (Real.norm_eq_abs _).symm
        _ ≤ ‖β x‖ * ∏ a, ‖A x (τ a)‖ := ContinuousAlternatingMap.le_opNorm _ _
        _ ≤ ‖β x‖ * Λ ^ k := by gcongr
        _ = Λ ^ k * ‖β x‖ := mul_comm _ _
    rw [abs_mul, abs_of_pos hθ, hval]
    calc θ x * |β x (fun a => A x (τ a))| ≤ θ x * (Λ ^ k * ‖β x‖) := by gcongr
      _ = Λ ^ k * ‖β x‖ * θ x := by ring

/-- Dominated convergence over a countable partition (Tannery's theorem): if `S = ⋃ E i` a.e. for
pairwise disjoint null-measurable `E i`, `|f j| ≤ G` eventually in `j` and `|f₀| ≤ G` a.e. on `S`
with `G` integrable on `S`, and `∫_{E i} f j → ∫_{E i} f₀` for every `i`, then
`∫_S f j → ∫_S f₀`. -/
theorem Submission.deformation_ipl_cc_tendsto_setIntegral_of_partition : ∀ (X : Type) [MeasurableSpace X] (μ : Measure X) (S : Set X) (E : ℕ → Set X) (f : ℕ → X → ℝ) (f₀ G : X → ℝ), (∀ i, NullMeasurableSet (E i) μ) → Pairwise (Function.onFun Disjoint E) → S =ᵐ[μ] (⋃ i, E i) → IntegrableOn G S μ → (∀ j, AEStronglyMeasurable (f j) (μ.restrict S)) → AEStronglyMeasurable f₀ (μ.restrict S) → (∀ᶠ j in atTop, ∀ᵐ x ∂(μ.restrict S), |f j x| ≤ G x) → (∀ᵐ x ∂(μ.restrict S), |f₀ x| ≤ G x) → (∀ i, Tendsto (fun j => ∫ x in E i, f j x ∂μ) atTop (𝓝 (∫ x in E i, f₀ x ∂μ))) → Tendsto (fun j => ∫ x in S, f j x ∂μ) atTop (𝓝 (∫ x in S, f₀ x ∂μ)) := by
  intro X _ μ S E f f₀ G hEm hEd hSE hG hfm hf₀m hfb hf₀b hlim
  -- Step 1: `μ ⌞ S = μ ⌞ ⋃ E i`, so `G` is integrable on `⋃ E i`.
  have hres : μ.restrict S = μ.restrict (⋃ i, E i) := Measure.restrict_congr_set hSE
  have hGS' : IntegrableOn G (⋃ i, E i) μ := by rw [IntegrableOn, ← hres]; exact hG
  -- Step 2: eventually `f j`, and `f₀`, are integrable on `⋃ E i` (dominated by `G`).
  have hint : ∀ᶠ j in atTop, IntegrableOn (f j) (⋃ i, E i) μ := by
    filter_upwards [hfb] with j hj
    rw [IntegrableOn, ← hres]
    exact Integrable.mono' hG (hfm j) (by simpa [Real.norm_eq_abs] using hj)
  have hint₀ : IntegrableOn f₀ (⋃ i, E i) μ := by
    rw [IntegrableOn, ← hres]
    exact Integrable.mono' hG hf₀m (by simpa [Real.norm_eq_abs] using hf₀b)
  -- Step 3: countable additivity over the a.e.-disjoint pieces `E i`.
  have hdisj : Pairwise (Function.onFun (AEDisjoint μ) E) := fun i j hij => (hEd hij).aedisjoint
  have hsumj : ∀ᶠ j in atTop, ∫ x in S, f j x ∂μ = ∑' i, ∫ x in E i, f j x ∂μ := by
    filter_upwards [hint] with j hj
    rw [setIntegral_congr_set hSE, integral_iUnion_ae hEm hdisj hj]
  have hsum₀ : ∫ x in S, f₀ x ∂μ = ∑' i, ∫ x in E i, f₀ x ∂μ := by
    rw [setIntegral_congr_set hSE, integral_iUnion_ae hEm hdisj hint₀]
  -- Step 4: eventually `|∫_{E i} f j| ≤ b i := ∫_{E i} G`, and `∑ b i = ∫_{⋃ E i} G` converges.
  have hEsub : ∀ i, μ.restrict (E i) ≤ μ.restrict S := fun i => by
    rw [hres]; exact Measure.restrict_mono (subset_iUnion E i) le_rfl
  have hbsum : Summable (fun i => ∫ x in E i, G x ∂μ) :=
    (hasSum_integral_iUnion_ae hEm hdisj hGS').summable
  have hbound : ∀ᶠ j in atTop, ∀ i, ‖∫ x in E i, f j x ∂μ‖ ≤ ∫ x in E i, G x ∂μ := by
    filter_upwards [hfb] with j hj i
    refine norm_integral_le_of_norm_le (hGS'.mono_set (subset_iUnion E i)) ?_
    have hj' : ∀ᵐ x ∂(μ.restrict S), ‖f j x‖ ≤ G x := by simpa [Real.norm_eq_abs] using hj
    exact ae_mono (hEsub i) hj'
  -- Step 5: Tannery's theorem (dominated convergence for series), by the `ε / 3` argument of
  -- Mathlib's `tendsto_tsum_of_dominated_convergence` (not imported here): cut the tail of
  -- `∑ b i` outside a finite set `T`, and use termwise convergence on `T`.
  have tannery : ∀ (a : ℕ → ℕ → ℝ) (a₀ b : ℕ → ℝ), Summable b →
      (∀ i, Tendsto (fun j => a j i) atTop (𝓝 (a₀ i))) → (∀ᶠ j in atTop, ∀ i, ‖a j i‖ ≤ b i) →
      Tendsto (fun j => ∑' i, a j i) atTop (𝓝 (∑' i, a₀ i)) := by
    intro a a₀ b hb ha hab
    have ha₀b : ∀ i, ‖a₀ i‖ ≤ b i := fun i =>
      le_of_tendsto (tendsto_norm.comp (ha i)) (hab.mono fun j hj => hj i)
    have hsum₀' : Summable fun i => ‖a₀ i‖ :=
      hb.of_norm_bounded fun i => (norm_norm (a₀ i)).symm ▸ ha₀b i
    have hsumj' : ∀ᶠ j in atTop, Summable fun i => ‖a j i‖ := by
      filter_upwards [hab] with j hj
      exact hb.of_norm_bounded <| by simpa only [norm_norm] using hj
    rw [Metric.tendsto_nhds]
    intro ε hε
    obtain ⟨B, hB⟩ := hb
    obtain ⟨T, hT⟩ : ∃ T : Finset ℕ, dist (∑ i ∈ T, b i) B < ε / 3 := by
      rw [HasSum, Metric.tendsto_nhds] at hB
      exact Eventually.exists <| hB _ (by positivity)
    have htail : ∑' i : (Tᶜ : Set ℕ), b i < ε / 3 := by
      calc _ ≤ ‖∑' i : (Tᶜ : Set ℕ), b i‖ := Real.le_norm_self _
           _ = ‖B - ∑ i ∈ T, b i‖ := congrArg _ ?_
           _ < ε / 3 := by rwa [dist_eq_norm, norm_sub_rev] at hT
      simpa only [hB.summable.sum_add_tsum_compl, eq_sub_iff_add_eq'] using hB.tsum_eq
    have hfin : Tendsto (fun j => ∑ i ∈ T, a j i) atTop (𝓝 (∑ i ∈ T, a₀ i)) :=
      tendsto_finsetSum _ fun i _ => ha i
    rw [Metric.tendsto_nhds] at hfin
    filter_upwards [hfin (ε / 3) (by positivity), hsumj', hab] with j hj hsj hbj
    rw [dist_eq_norm, ← hsj.of_norm.tsum_sub hsum₀'.of_norm,
      ← (hsj.of_norm.sub hsum₀'.of_norm).sum_add_tsum_compl (s := T),
      (by ring : ε = ε / 3 + (ε / 3 + ε / 3))]
    refine (norm_add_le _ _).trans_lt (add_lt_add ?_ ?_)
    · simpa only [dist_eq_norm, Finset.sum_sub_distrib] using hj
    · rw [(hsj.subtype _).of_norm.tsum_sub (hsum₀'.subtype _).of_norm]
      refine (norm_sub_le _ _).trans_lt (add_lt_add ?_ ?_)
      · refine ((norm_tsum_le_tsum_norm (hsj.subtype _)).trans ?_).trans_lt htail
        exact (hsj.subtype _).tsum_le_tsum (hbj ·) (hB.summable.subtype _)
      · refine ((norm_tsum_le_tsum_norm (hsum₀'.subtype _)).trans ?_).trans_lt htail
        exact (hsum₀'.subtype _).tsum_le_tsum (ha₀b ·) (hB.summable.subtype _)
  have htan := tannery (fun j i => ∫ x in E i, f j x ∂μ) (fun i => ∫ x in E i, f₀ x ∂μ)
    (fun i => ∫ x in E i, G x ∂μ) hbsum hlim hbound
  rw [hsum₀]
  exact htan.congr' (hsumj.mono fun j hj => hj.symm)

/-- Rademacher for `f ∘ Φ`: if `f` is locally Lipschitz on an open `U ⊆ ℝ^P` and `Φ : ℝⁿ → ℝ^P`
is `C¹`, then `f ∘ Φ` is differentiable at `Lⁿ`-a.e. `w` with `Φ w ∈ U`. -/
theorem Submission.lpf_ccr_ae_differentiableAt_comp : ∀ (P Q n : ℕ) (U : Set (Eucl P)) (f : Eucl P → Eucl Q) (Φ : Eucl n → Eucl P), IsOpen U → LocallyLipschitzOn U f → ContDiff ℝ 1 Φ → ∀ᵐ w ∂(volume : Measure (Eucl n)), Φ w ∈ U → DifferentiableAt ℝ (f ∘ Φ) w := by
  intro P Q n U f Φ hU hf hΦ
  -- Step 1: `O = Φ⁻¹(U)` is open.
  have hO : IsOpen (Φ ⁻¹' U) := hU.preimage hΦ.continuous
  -- Step 2: `f ∘ Φ` is locally Lipschitz on `O`: compose a Lipschitz neighbourhood of `f` at
  -- `Φ w` (a full neighbourhood, as `U` is open) with one of the `C¹` map `Φ` at `w`.
  have hloc : LocallyLipschitzOn (Φ ⁻¹' U) (f ∘ Φ) := by
    intro w hw
    obtain ⟨K₁, t₁, ht₁, hft₁⟩ := hf hw
    rw [hU.nhdsWithin_eq hw] at ht₁
    obtain ⟨K₂, t₂, ht₂, hΦt₂⟩ := hΦ.locallyLipschitz w
    refine ⟨K₁ * K₂, t₂ ∩ Φ ⁻¹' t₁, mem_nhdsWithin_of_mem_nhds
      (inter_mem ht₂ (hΦ.continuous.continuousAt.preimage_mem_nhds ht₁)), ?_⟩
    exact hft₁.comp (hΦt₂.mono inter_subset_left) fun y hy => hy.2
  -- Step 3: countable Lipschitz cover of `O` (accepted sibling).
  obtain ⟨O, K, hOo, hcov, hlip⟩ :=
    Submission.lpf_lli_countable_lipschitz_cover n Q (Φ ⁻¹' U) (f ∘ Φ) hloc
  -- Step 4: Rademacher on each piece `O i ∩ O`; it is open, so differentiability within it is
  -- differentiability.
  have hpiece : ∀ i, ∀ᵐ w ∂(volume : Measure (Eucl n)),
      w ∈ O i ∩ Φ ⁻¹' U → DifferentiableAt ℝ (f ∘ Φ) w := fun i => by
    filter_upwards [(hlip i).ae_differentiableWithinAt_of_mem
      (μ := (volume : Measure (Eucl n)))] with w hw hws
    exact (hw hws).differentiableAt (((hOo i).inter hO).mem_nhds hws)
  -- Step 5: countably many null sets; every `w` with `Φ w ∈ U` lies in some piece.
  filter_upwards [ae_all_iff.2 hpiece] with w hw hwU
  obtain ⟨i, hi⟩ := mem_iUnion.1 (hcov hwU)
  exact hw i ⟨hi, hwU⟩

/-- Chain rule on a `C¹` antilipschitz chart (Simon Ch. 6, proof of 3.9, steps 2 and 5.2): for
`Lⁿ`-a.e. `w ∈ Ω ∩ Φ⁻¹(M)`, `DΦ(w)(ℝⁿ)` is the weighted approximate tangent space of `(M, θ)` at
`Φ(w)` and `D(f∘Φ)(w) = L(Φ w) ∘ DΦ(w)`.  The tangent identification and the derivative clause
for `L` hold `Hⁿ`-a.e. on `M`, hence at `Φ w` for a.e. parameter; `f∘Φ` is differentiable a.e.
(Rademacher); and along each `DΦ(w)s ∈ TₓM` both `L(Φ w)` and `D(f∘Φ)(w)` give the derivative of
`t ↦ f(Φ(w) + t DΦ(w)s)` at `0`. -/
theorem Submission.lpf_chart_chain_rule : ∀ (P Q n : ℕ) (U M : Set (Eucl P)) (θ : Eucl P → ℝ) (ξ : Eucl P → NVector (Eucl P) n) (f : Eucl P → Eucl Q) (L : Eucl P → (Eucl P →L[ℝ] Eucl Q)) (Φ : Eucl n → Eucl P) (Ω : Set (Eucl n)), IsOpen U → IsRectifiableTriple U n M θ ξ → LocallyLipschitzOn U f → (∀ᵐ x ∂((μHE[n] : Measure (Eucl P)).restrict M), ∀ Tx : Submodule ℝ (Eucl P), HasWeightedApproximateTangentSpaceAt n M θ x Tx → ∀ v ∈ Tx, HasDerivAt (fun t : ℝ => f (x + t • v)) (L x v) 0) → IsOpen Ω → ContDiff ℝ 1 Φ → (∃ c : ℝ, 0 < c ∧ ∀ w ∈ Ω, ∀ w' ∈ Ω, c * ‖w - w'‖ ≤ ‖Φ w - Φ w'‖) → ∀ᵐ w ∂((volume : Measure (Eucl n)).restrict (Ω ∩ Φ ⁻¹' M)), HasWeightedApproximateTangentSpaceAt n M θ (Φ w) (LinearMap.range (fderiv ℝ Φ w).toLinearMap) ∧ HasFDerivAt (f ∘ Φ) ((L (Φ w)).comp (fderiv ℝ Φ w)) w := by
  intro P Q n U M θ ξ f L Φ Ω hU hT hf hL hΩ hΦ hanti
  have hΩm : MeasurableSet Ω := hΩ.measurableSet
  have hΦm : Measurable Φ := hΦ.continuous.measurable
  -- Step 2: tangent identification `T_{Φ w}(M, θ) = DΦ(w)(ℝⁿ)` (sibling lemma), pulled back to
  -- a.e. parameter; this also gives the null-measurability of `Ω ∩ Φ⁻¹(M)`.
  obtain ⟨hSm, h₁⟩ := Submission.lpf_ccr_ae_pullback P n M Φ Ω _ hΩm hΦm hanti
    hT.nullMeasurableSet
    (Submission.lpf_weighted_tangent_on_c1_chart P n U M θ Φ Ω hU hT.subset
      hT.nullMeasurableSet hT.pos hT.integrableOn hΩ hΦ hanti)
  -- Step 3: the derivative clause for `L` holds at `Φ w` for a.e. parameter.
  have h₂ := (Submission.lpf_ccr_ae_pullback P n M Φ Ω _ hΩm hΦm hanti hT.nullMeasurableSet
    (ae_restrict_of_ae_restrict_of_subset inter_subset_left hL)).2
  -- Step 4: Rademacher for `f ∘ Φ` on `Φ⁻¹(U) ⊇ Ω ∩ Φ⁻¹(M)`.
  have h₃ := ae_restrict_of_ae (s := Ω ∩ Φ ⁻¹' M)
    (Submission.lpf_ccr_ae_differentiableAt_comp P Q n U f Φ hU hf hΦ)
  filter_upwards [h₁, h₂, h₃, ae_restrict_mem₀ hSm] with w hw₁ hw₂ hw₃ hwS
  have hwU : Φ w ∈ U := hT.subset hwS.2
  have hTw := hw₁ w hwS.1 rfl
  refine ⟨hTw, ?_⟩
  have hdiff : DifferentiableAt ℝ (f ∘ Φ) w := hw₃ hwU
  -- Step 5: `f` is Lipschitz on a neighbourhood of `Φ w` (`U` is open), so along `DΦ(w)s` the
  -- derivative of `t ↦ f(Φ w + t DΦ(w)s)` at `0` is both `D(f∘Φ)(w)s` and `L(Φ w)(DΦ(w)s)`.
  have hlip : ∃ K : ℝ≥0, ∃ V ∈ 𝓝 (Φ w), LipschitzOnWith K f V := by
    obtain ⟨K, V, hV, hfV⟩ := hf hwU
    exact ⟨K, V, hU.nhdsWithin_eq hwU ▸ hV, hfV⟩
  have hline := Submission.lpf_ccr_hasDerivAt_line_of_comp n P Q f Φ w hlip
    (hΦ.differentiable one_ne_zero w) hdiff
  have heq : fderiv ℝ (f ∘ Φ) w = (L (Φ w)).comp (fderiv ℝ Φ w) := by
    ext1 s
    exact (hline s).unique (hw₂ _ hTw _ (LinearMap.mem_range_self _ s))
  exact heq ▸ hdiff.hasFDerivAt

/-- Measurability of the push-forward `k`-vector field (Simon Ch. 6, (3.6), p. 147, as needed in
the proof of the Deformation Theorem, §5, p. 166): for a rectifiable triple `(M, θ, ξ)` in an open
`U`, a locally Lipschitz `f` and any `L` with `L(x)v = d/dt f(x + tv)|₀` on the weighted
approximate tangent spaces `TₓM`, `x ↦ L(x)_# ξ(x)` is `Hᵏ⌞M`-a.e. strongly measurable.  Off an
`Hᵏ`-null set, `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₖ` with `span τ = TₓM = DΦ_j(w)(ℝᵏ)` for a `C¹` chart
`Φ_j(w) = x` (uniqueness of `TₓM`, `θ x > 0`), so `L x` agrees on `τ` with the Borel chartwise
differential `L'` of `lpf_tde_measurable_chart_differential`. -/
theorem Submission.deformation_ipl_tangential_pushforward_aestronglyMeasurable : ∀ (P Q k : ℕ) (U M : Set (Eucl P)) (θ : Eucl P → ℝ) (ξ : Eucl P → NVector (Eucl P) k) (f : Eucl P → Eucl Q) (L : Eucl P → (Eucl P →L[ℝ] Eucl Q)), IsOpen U → IsRectifiableTriple U k M θ ξ → LocallyLipschitzOn U f → (∀ᵐ x ∂((μHE[k] : Measure (Eucl P)).restrict M), ∀ Tx : Submodule ℝ (Eucl P), HasWeightedApproximateTangentSpaceAt k M θ x Tx → ∀ v ∈ Tx, HasDerivAt (fun t : ℝ => f (x + t • v)) (L x v) 0) → AEStronglyMeasurable (fun x => nVectorPushforward k (L x) (ξ x)) ((μHE[k] : Measure (Eucl P)).restrict M) := by
  intro P Q k U M θ ξ f L hU hT hf hL
  -- Step 1: `C¹` charts `Φ j`, Lipschitz and antilipschitz on open `Ω j`, cover `M` up to an
  -- `Hᵏ`-null set.
  obtain ⟨Φ, Ω, hΩ, hΦ, hLip, hanti, hcover⟩ :=
    Submission.lpf_countably_rectifiable_c1_cover P k M hT.countablyRectifiable
  -- Step 2: a strongly measurable `L'` with `L'(x) ∘ DΦ_j(w) = D(f ∘ Φ_j)(w)` at a chart
  -- preimage `w` of every covered point `x`.
  obtain ⟨L', hL'm, -, hL'⟩ :=
    Submission.lpf_tde_measurable_chart_differential P Q k Φ Ω f hΩ hΦ hanti
  -- Step 3: on each chart, the tangent identification and the chain rule hold off an `Lᵏ`-null
  -- set `E j ⊆ Ω j` of parameters.
  have hgood : ∀ j, ∃ E : Set (Eucl k), E ⊆ Ω j ∧ (volume : Measure (Eucl k)) E = 0 ∧
      ∀ w ∈ Ω j, Φ j w ∈ M → w ∉ E →
        HasWeightedApproximateTangentSpaceAt k M θ (Φ j w)
            (LinearMap.range (fderiv ℝ (Φ j) w).toLinearMap) ∧
          HasFDerivAt (f ∘ Φ j) ((L (Φ j w)).comp (fderiv ℝ (Φ j) w)) w := by
    intro j
    have h := Submission.lpf_chart_chain_rule P Q k U M θ ξ f L (Φ j) (Ω j) hU hT hf hL (hΩ j)
      (hΦ j) (hanti j)
    refine ⟨{w | ¬ (HasWeightedApproximateTangentSpaceAt k M θ (Φ j w)
        (LinearMap.range (fderiv ℝ (Φ j) w).toLinearMap) ∧
          HasFDerivAt (f ∘ Φ j) ((L (Φ j w)).comp (fderiv ℝ (Φ j) w)) w)} ∩ (Ω j ∩ Φ j ⁻¹' M),
      fun w hw => hw.2.1,
      nonpos_iff_eq_zero.1 ((Measure.le_restrict_apply _ _).trans_eq (ae_iff.1 h)), ?_⟩
    intro w hw hwM hwE
    by_contra hcon
    exact hwE ⟨hcon, hw, hwM⟩
  choose E hEΩ hE0 hEgood using hgood
  -- Step 4: `Φ j (E j)` is `Hᵏ`-null, as `Φ j` is Lipschitz on `E j ⊆ Ω j` and `Hᵏ = Lᵏ` on `ℝᵏ`.
  have hΦE : ∀ j, (μHE[k] : Measure (Eucl P)) (Φ j '' E j) = 0 := by
    intro j
    obtain ⟨K, hK⟩ := hLip j
    refine nonpos_iff_eq_zero.1
      ((Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn k
        (hK.mono (hEΩ j))).trans ?_)
    rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume, hE0 j, mul_zero]
  have hcov : ∀ᵐ x ∂((μHE[k] : Measure (Eucl P)).restrict M), x ∈ ⋃ j, Φ j '' Ω j := by
    rw [ae_iff, Measure.restrict_apply₀' hT.nullMeasurableSet]
    refine measure_mono_null ?_ hcover
    intro x hx
    exact ⟨hx.2, hx.1⟩
  have hnot : ∀ᵐ x ∂((μHE[k] : Measure (Eucl P)).restrict M), ∀ j, x ∉ Φ j '' E j :=
    ae_all_iff.2 fun j => ae_restrict_of_ae (measure_eq_zero_iff_ae_notMem.1 (hΦE j))
  -- Step 5: off an `Hᵏ`-null set, `ξ x = ±τ₁ ∧ ⋯ ∧ τₖ` with `span τ = DΦ_j(w)(ℝᵏ)` (uniqueness of
  -- weighted approximate tangent spaces, `θ x > 0`), so `L' x ∘ τ = L x ∘ τ`.
  have heq : (fun x => nVectorPushforward k (L' x) (ξ x)) =ᵐ[(μHE[k] : Measure (Eucl P)).restrict M]
      fun x => nVectorPushforward k (L x) (ξ x) := by
    filter_upwards [ae_restrict_mem₀ hT.nullMeasurableSet, hcov, hnot, hT.orients]
      with x hxM hxc hxE hor
    obtain ⟨τ, -, hτ, hξ⟩ := hor
    obtain ⟨j, w, hw, hΦw, hA, -⟩ := hL' x hxc
    have hwM : Φ j w ∈ M := by rw [hΦw]; exact hxM
    have hwE : w ∉ E j := fun hwE => hxE j ⟨w, hwE, hΦw⟩
    obtain ⟨hW, hD⟩ := hEgood j w hw hwM hwE
    rw [hΦw] at hW hD
    have hspan := HasWeightedApproximateTangentSpaceAt.unique (hT.pos x hxM).ne' hτ hW
    have hcomp : L' x ∘ τ = L x ∘ τ := by
      funext a
      obtain ⟨s, hs⟩ : τ a ∈ LinearMap.range (fderiv ℝ (Φ j) w).toLinearMap :=
        hspan ▸ Submodule.subset_span (mem_range_self a)
      have hs' : fderiv ℝ (Φ j) w s = τ a := hs
      rw [Function.comp_apply, Function.comp_apply, ← hs', hA s, hD.fderiv,
        ContinuousLinearMap.comp_apply]
    rcases hξ with hξ | hξ
    · rw [hξ, nVectorPushforward_simple, nVectorPushforward_simple, hcomp]
    · ext ω
      simp only [nVectorPushforward, hξ, ContinuousLinearMap.comp_apply,
        neg_apply, simpleNVector_apply, covectorPullback_apply, hcomp]
  -- Step 6: `(A, w) ↦ A_# w = w ∘ A^#` is continuous, so `x ↦ L'(x)_# ξ(x)` is `Hᵏ⌞M`-a.e.
  -- strongly measurable, and it agrees a.e. with `x ↦ L(x)_# ξ(x)`.
  have hcont : Continuous fun p : (Eucl P →L[ℝ] Eucl Q) × NVector (Eucl P) k =>
      nVectorPushforward k p.1 p.2 :=
    continuous_snd.clm_comp
      (ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM.comp continuous_fst)
  exact (hcont.comp_aestronglyMeasurable
    (hL'm.aestronglyMeasurable.prodMk hT.aestronglyMeasurable)).congr heq

/-- `C_c^∞` fields are dense in `L¹(Ω)`: for `Ω ⊆ ℝⁿ` open, `c : ℝⁿ → ℝⁿ` integrable on `Ω` and
`δ > 0` there is a smooth `b` with compact support, `spt b ⊆ Ω` and `∫_Ω |c − b| < δ`.  The
exhaustion `K_j = F_j ∩ B̄(0, j)` of `Ω` gives a compact `K ⊆ Ω` with `∫_{Ω∖K} |c| < δ/2`;
`1_K c` is within `δ/2` in `L¹(ℝⁿ)` of a smooth compactly supported `b₀` (approximate simple
functions, using the regularity of `Lⁿ` and the smooth Urysohn lemma); and `b = χ b₀` for a
smooth cutoff `0 ≤ χ ≤ 1` with `χ = 1` on `K` and `spt χ ⊆ Ω`. -/
theorem Submission.slicing_im_ll_gws_smooth_dense :
    ∀ (n : ℕ) (Ω : Set (Eucl n)) (c : Eucl n → Eucl n), IsOpen Ω → IntegrableOn c Ω (volume : Measure (Eucl n)) → ∀ δ : ℝ, 0 < δ → ∃ b : Eucl n → Eucl n, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) b ∧ HasCompactSupport b ∧ tsupport b ⊆ Ω ∧ ∫ w in Ω, ‖c w - b w‖ < δ := by
  intro n Ω c hΩ hc δ hδ
  -- Step 1: the compact exhaustion `K j = F j ∩ B̄(0, j)` of `Ω`.
  obtain ⟨F, hFc, hFΩ, hFU, hFm⟩ := hΩ.exists_iUnion_isClosed
  have hKc : ∀ j : ℕ, IsCompact (F j ∩ closedBall 0 j) := fun j =>
    (isCompact_closedBall 0 j).inter_left (hFc j)
  have hKΩ : ∀ j : ℕ, F j ∩ closedBall 0 j ⊆ Ω := fun j => inter_subset_left.trans (hFΩ j)
  have hKm : Monotone fun j : ℕ => F j ∩ closedBall (0 : Eucl n) j := fun i j hij =>
    inter_subset_inter (hFm hij) (closedBall_subset_closedBall (Nat.cast_le.2 hij))
  have hKU : ⋃ j : ℕ, F j ∩ closedBall (0 : Eucl n) j = Ω := by
    refine Subset.antisymm (iUnion_subset hKΩ) fun w hw => ?_
    rw [← hFU] at hw
    obtain ⟨i, hi⟩ := mem_iUnion.1 hw
    refine mem_iUnion.2 ⟨max i ⌈‖w‖⌉₊, hFm (le_max_left _ _) hi, ?_⟩
    rw [mem_closedBall, dist_zero_right]
    exact (Nat.le_ceil _).trans (Nat.cast_le.2 (le_max_right _ _))
  -- Step 2: a compact `K = K j ⊆ Ω` with `∫_{Ω \ K} |c| < δ / 2`.
  have hcn : IntegrableOn (fun w => ‖c w‖) Ω := hc.norm
  obtain ⟨K, hK, hKΩ', htail⟩ : ∃ K : Set (Eucl n), IsCompact K ∧ K ⊆ Ω ∧
      ∫ w in Ω \ K, ‖c w‖ < δ / 2 := by
    have hlim := tendsto_setIntegral_of_monotone (fun j => (hKc j).measurableSet) hKm
      (by rw [hKU]; exact hcn)
    rw [hKU] at hlim
    obtain ⟨j, hj⟩ := ((tendsto_order.1 hlim).1 _ (sub_lt_self _ (half_pos hδ))).exists
    refine ⟨_, hKc j, hKΩ j, ?_⟩
    rw [setIntegral_sdiff (hKc j).measurableSet hcn (hKΩ j)]
    linarith
  -- Step 3: `C_c^∞` is dense in `L¹(ℝⁿ)` (simple functions, regularity and smooth Urysohn).
  have hdense : ∀ f : Eucl n → Eucl n, Integrable f → ∀ ε : ℝ, 0 < ε →
      ∃ g : Eucl n → Eucl n, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) g ∧ HasCompactSupport g ∧
        ∫ w, ‖f w - g w‖ ≤ ε := by
    intro f hf ε hε
    have hind : ∀ (v : Eucl n) ⦃s : Set (Eucl n)⦄, MeasurableSet s → volume s < ∞ →
        ∀ {η : ℝ≥0∞}, η ≠ 0 → ∃ g : Eucl n → Eucl n,
          eLpNorm (g - s.indicator fun _ => v) 1 volume ≤ η ∧
            (ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) g ∧ HasCompactSupport g) := by
      intro v s hs hμs η hη
      obtain ⟨θ, hθ0, hθ⟩ := ENNReal.exists_nnreal_pos_mul_lt
        (ENNReal.mul_ne_top ENNReal.ofNat_ne_top enorm_ne_top : 2 * ‖v‖ₑ ≠ ∞) hη
      have hθ0' : (θ : ℝ≥0∞) ≠ 0 := ENNReal.coe_ne_zero.2 hθ0.ne'
      obtain ⟨A, hAs, hA, hsA⟩ := hs.exists_isCompact_sdiff_lt hμs.ne hθ0'
      obtain ⟨U, hsU, hU, -, hUs⟩ := hs.exists_isOpen_sdiff_lt hμs.ne hθ0'
      obtain ⟨L, hL, hAL, hLU⟩ := exists_compact_between hA hU (hAs.trans hsU)
      obtain ⟨χ, hχ, hχr, hχs, hχ1⟩ := exists_contDiff_support_eq_eq_one_iff
        (n := (⊤ : ℕ∞)) isOpen_interior hA.isClosed hAL
      have hχ0 : ∀ x, x ∉ interior L → χ x = 0 := fun x hx =>
        Function.notMem_support.1 (by rw [hχs]; exact hx)
      refine ⟨fun x => χ x • v, ?_, hχ.smul contDiff_const, ?_⟩
      · calc eLpNorm ((fun x => χ x • v) - s.indicator fun _ => v) 1 volume
            ≤ eLpNorm ((U \ A).indicator fun _ => v) 1 volume := by
              refine eLpNorm_mono ((hχ.continuous.smul continuous_const).aestronglyMeasurable.sub
                (aestronglyMeasurable_const.indicator hs)) fun x => ?_
              rw [Pi.sub_apply]
              by_cases hxA : x ∈ A
              · simp [(hχ1 x).1 hxA, indicator_of_mem (hAs hxA)]
              by_cases hxU : x ∈ U
              · rw [indicator_of_mem (mem_sdiff_of_mem hxU hxA)]
                obtain ⟨h0, h1⟩ := hχr (mem_range_self x)
                by_cases hxs : x ∈ s
                · rw [indicator_of_mem hxs,
                    show χ x • v - v = (χ x - 1) • v by rw [sub_smul, one_smul], norm_smul,
                    Real.norm_eq_abs]
                  calc |χ x - 1| * ‖v‖ ≤ 1 * ‖v‖ := by
                        gcongr; rw [abs_le]; constructor <;> linarith
                    _ = ‖v‖ := one_mul _
                · rw [indicator_of_notMem hxs, sub_zero, norm_smul, Real.norm_eq_abs]
                  calc |χ x| * ‖v‖ ≤ 1 * ‖v‖ := by
                        gcongr; rw [abs_le]; constructor <;> linarith
                    _ = ‖v‖ := one_mul _
              · have hxs : x ∉ s := fun h => hxU (hsU h)
                have hxL : x ∉ interior L := fun h => hxU (hLU (interior_subset h))
                simp [hχ0 x hxL, hxs]
          _ = ‖v‖ₑ * volume (U \ A) := by
              rw [eLpNorm_indicator_const (hU.measurableSet.diff hA.measurableSet).nullMeasurableSet
                one_ne_zero ENNReal.one_ne_top]
              simp
          _ ≤ ‖v‖ₑ * (θ + θ) := by
              gcongr
              calc volume (U \ A) ≤ volume ((U \ s) ∪ (s \ A)) := measure_mono fun x hx => by
                    by_cases hxs : x ∈ s
                    · exact Or.inr ⟨hxs, hx.2⟩
                    · exact Or.inl ⟨hx.1, hxs⟩
                _ ≤ volume (U \ s) + volume (s \ A) := measure_union_le _ _
                _ ≤ θ + θ := add_le_add hUs.le hsA.le
          _ = θ * (2 * ‖v‖ₑ) := by ring
          _ ≤ η := hθ.le
      · exact HasCompactSupport.intro hL fun x hx => by
          simp [hχ0 x fun h => hx (interior_subset h)]
    obtain ⟨g, hfg, hg, hgc⟩ := (memLp_one_iff_integrable.2 hf).induction_dense
      ENNReal.one_ne_top
      (fun g : Eucl n → Eucl n => ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) g ∧ HasCompactSupport g)
      hind (fun f g hf hg => ⟨hf.1.add hg.1, hf.2.add hg.2⟩) (ENNReal.ofReal_pos.2 hε).ne'
    refine ⟨g, hg, hgc, ?_⟩
    have hm : AEStronglyMeasurable (f - g) volume :=
      (hf.sub (hg.continuous.integrable_of_hasCompactSupport hgc)).aestronglyMeasurable
    rw [eLpNorm_one_eq_lintegral_enorm hm] at hfg
    change ∫ w, ‖(f - g) w‖ ≤ ε
    rw [integral_norm_eq_lintegral_enorm hm]
    exact ENNReal.toReal_le_of_le_ofReal hε.le hfg
  -- Step 3 applied to `1_K c`.
  have hKi : Integrable (K.indicator c) :=
    (integrable_indicator_iff hK.measurableSet).2 (hc.mono_set hKΩ')
  obtain ⟨b₀, hb₀, hb₀c, hb₀K⟩ := hdense _ hKi (δ / 2) (half_pos hδ)
  have hb₀i : Integrable b₀ := hb₀.continuous.integrable_of_hasCompactSupport hb₀c
  -- Step 4: a smooth cutoff `χ`, `χ = 1` exactly on `K`, `0 ≤ χ ≤ 1`, `tsupport χ ⊆ L ⊆ Ω`.
  obtain ⟨L, hL, hKL, hLΩ⟩ := exists_compact_between hK hΩ hKΩ'
  obtain ⟨χ, hχ, hχr, hχs, hχ1⟩ := exists_contDiff_support_eq_eq_one_iff
    (n := (⊤ : ℕ∞)) isOpen_interior hK.isClosed hKL
  have hχL : tsupport χ ⊆ L := by
    rw [tsupport, hχs]
    exact closure_minimal interior_subset hL.isClosed
  have hχc : HasCompactSupport χ := hL.of_isClosed_subset (isClosed_tsupport _) hχL
  -- Step 5: `b = χ b₀`.
  have hbc : HasCompactSupport fun w => χ w • b₀ w := hχc.smul_right
  have hbi : Integrable fun w => χ w • b₀ w :=
    (hχ.continuous.smul hb₀.continuous).integrable_of_hasCompactSupport hbc
  refine ⟨fun w => χ w • b₀ w, hχ.smul hb₀, hbc,
    (tsupport_smul_subset_left _ _).trans (hχL.trans hLΩ), ?_⟩
  -- Step 6: `|c - b| ≤ |1_{Kᶜ} c| + |1_K c - b₀|` pointwise.
  have hptw : ∀ w, ‖c w - χ w • b₀ w‖ ≤ ‖Kᶜ.indicator c w‖ + ‖K.indicator c w - b₀ w‖ := by
    intro w
    by_cases hw : w ∈ K
    · simp [(hχ1 w).1 hw, hw]
    · rw [indicator_of_mem (mem_compl hw), indicator_of_notMem hw, zero_sub, norm_neg]
      obtain ⟨h0, h1⟩ := hχr (mem_range_self w)
      calc ‖c w - χ w • b₀ w‖ ≤ ‖c w‖ + ‖χ w • b₀ w‖ := norm_sub_le _ _
        _ ≤ ‖c w‖ + ‖b₀ w‖ := by
          gcongr
          rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg h0]
          exact mul_le_of_le_one_left (norm_nonneg _) h1
  -- Step 7: integrate over `Ω`.
  have h1 : ∫ w in Ω, ‖Kᶜ.indicator c w‖ < δ / 2 := by
    simp_rw [norm_indicator_eq_indicator_norm]
    rw [setIntegral_indicator hK.measurableSet.compl, ← sdiff_eq]
    exact htail
  have h2 : ∫ w in Ω, ‖K.indicator c w - b₀ w‖ ≤ δ / 2 :=
    (setIntegral_le_integral (hKi.sub hb₀i).norm
      (Eventually.of_forall fun _ => norm_nonneg _)).trans hb₀K
  calc ∫ w in Ω, ‖c w - χ w • b₀ w‖
      ≤ ∫ w in Ω, (‖Kᶜ.indicator c w‖ + ‖K.indicator c w - b₀ w‖) :=
        setIntegral_mono (hc.sub hbi.integrableOn).norm
          ((hc.indicator hK.measurableSet.compl).norm.add (hKi.sub hb₀i).norm.integrableOn) hptw
    _ = (∫ w in Ω, ‖Kᶜ.indicator c w‖) + ∫ w in Ω, ‖K.indicator c w - b₀ w‖ :=
        integral_add (hc.indicator hK.measurableSet.compl).norm (hKi.sub hb₀i).norm.integrableOn
    _ < δ / 2 + δ / 2 := add_lt_add_of_lt_of_le h1 h2
    _ = δ := add_halves δ

/-- `C_c^∞(Ω)` is dense in `L¹(Ω)` for real functions: for `Ω ⊆ ℝᵏ` open, `η` integrable on `Ω`
and `ε > 0` there is a smooth `φ` with compact support, `spt φ ⊆ Ω` and `∫_Ω |η − φ| < ε`.  For
`k = 0` the space is a point, so `Ω = ∅` (take `φ = 0`) or `Ω = ℝ⁰` (take `φ = η`, a constant).
For `k ≥ 1` the field `c = η e₀` is approximated by `b` (`slicing_im_ll_gws_smooth_dense`) and
`φ = b₀` is its first coordinate, so `|η − φ| = |(c − b)₀| ≤ |c − b|`. -/
theorem Submission.deformation_ipl_mwc_td_scalar_smooth_dense :
    ∀ (k : ℕ) (Ω : Set (Eucl k)) (η : Eucl k → ℝ), IsOpen Ω → IntegrableOn η Ω (volume : Measure (Eucl k)) → ∀ ε : ℝ, 0 < ε → ∃ φ : Eucl k → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) φ ∧ HasCompactSupport φ ∧ tsupport φ ⊆ Ω ∧ ∫ w in Ω, |η w - φ w| ∂(volume : Measure (Eucl k)) < ε := by
  intro k Ω η hΩ hη ε hε
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · -- `k = 0`: `Eucl 0` is a single point, so `Ω = ∅` or `Ω = univ`.
    by_cases hΩe : Ω = ∅
    · subst hΩe
      exact ⟨0, contDiff_const, HasCompactSupport.zero, by simp, by simpa using hε⟩
    · have hΩu : Ω = univ := by
        obtain ⟨x, hx⟩ := nonempty_iff_ne_empty.2 hΩe
        exact eq_univ_of_forall fun y => Subsingleton.elim x y ▸ hx
      have hconst : η = fun _ => η 0 := funext fun x => congrArg η (Subsingleton.elim x 0)
      refine ⟨η, ?_, ?_, by simp [hΩu], by simpa using hε⟩
      · rw [hconst]
        exact contDiff_const
      · exact subsingleton_of_subsingleton.isCompact.of_isClosed_subset (isClosed_tsupport _)
          (subset_univ _)
  · -- `k ≥ 1`: carry `η` as the first coordinate of a vector field and project back.
    let i₀ : Fin k := ⟨0, hk⟩
    let e : Eucl k := EuclideanSpace.single i₀ (1 : ℝ)
    have he : e i₀ = 1 := by simp [e]
    have hc : IntegrableOn (fun w => η w • e) Ω := hη.smul_const e
    obtain ⟨b, hb, hbc, hbΩ, hbε⟩ :=
      Submission.slicing_im_ll_gws_smooth_dense k Ω (fun w => η w • e) hΩ hc ε hε
    let p : Eucl k →L[ℝ] ℝ := EuclideanSpace.proj i₀
    have hp : ∀ v : Eucl k, p v = v i₀ := fun v => rfl
    have hp0 : p 0 = 0 := map_zero p
    have hφ : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (p ∘ b) := p.contDiff.comp hb
    have hφc : HasCompactSupport (p ∘ b) := hbc.comp_left hp0
    refine ⟨p ∘ b, hφ, hφc, (tsupport_comp_subset hp0 b).trans hbΩ, ?_⟩
    have hbi : Integrable b := hb.continuous.integrable_of_hasCompactSupport hbc
    have hφi : Integrable (p ∘ b) := hφ.continuous.integrable_of_hasCompactSupport hφc
    -- `|η − φ| = |(c − b)₀| ≤ ‖c − b‖` pointwise, and both sides are integrable on `Ω`.
    have hptw : ∀ w, |η w - (p ∘ b) w| ≤ ‖η w • e - b w‖ := fun w => by
      have h1 : (η w • e - b w) i₀ = η w - (p ∘ b) w := by
        simp [Function.comp, hp, he]
      rw [← h1, ← Real.norm_eq_abs]
      exact PiLp.norm_apply_le _ _
    calc ∫ w in Ω, |η w - (p ∘ b) w| ≤ ∫ w in Ω, ‖η w • e - b w‖ :=
          setIntegral_mono (hη.sub hφi.integrableOn).abs (hc.sub hbi.integrableOn).norm hptw
      _ < ε := hbε

/-- Leibniz bound for determinants: if every entry of a real `n × n` matrix satisfies
`|A i j| ≤ c`, then `|det A| ≤ n! · cⁿ`.  Expand `det A = ∑_σ sgn(σ) • ∏_i A (σ i) i`, apply the
triangle inequality, drop the sign `±1`, bound each product of `n` entries by `cⁿ`, and count the
`n!` permutations of `Fin n`. -/
theorem Submission.deformation_ipl_mwc_mil_abs_det_le :
    ∀ (n : ℕ) (c : ℝ) (A : Matrix (Fin n) (Fin n) ℝ), (∀ i j, |A i j| ≤ c) →
      |Matrix.det A| ≤ (n.factorial : ℝ) * c ^ n := by
  intro n c A hA
  rw [Matrix.det_apply]
  calc |∑ σ : Equiv.Perm (Fin n), Equiv.Perm.sign σ • ∏ i, A (σ i) i|
      ≤ ∑ σ : Equiv.Perm (Fin n), |Equiv.Perm.sign σ • ∏ i, A (σ i) i| :=
        Finset.abs_sum_le_sum_abs _ _
    _ = ∑ σ : Equiv.Perm (Fin n), ∏ i, |A (σ i) i| := by
        -- `sgn σ = ±1`, and `|·|` is multiplicative on finite products.
        refine Finset.sum_congr rfl fun σ _ => ?_
        rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h | h <;>
          simp [h, Finset.abs_prod]
    _ ≤ ∑ _σ : Equiv.Perm (Fin n), c ^ n := by
        refine Finset.sum_le_sum fun σ _ => ?_
        calc ∏ i, |A (σ i) i| ≤ ∏ _i : Fin n, c :=
              Finset.prod_le_prod₀ (fun i _ => abs_nonneg _) (fun i _ => hA _ _)
          _ = c ^ n := by simp
    _ = (n.factorial : ℝ) * c ^ n := by
        simp [Fintype.card_perm]

/-- **Dominated convergence for `h_m · det A_m`.**  If the entries of `A_m(x)` are bounded by
`C`, `|h_m| ≤ H` with `H` integrable for all large `m`, and `h_m → h₀`, `A_m → A₀` entrywise
`μ`-a.e., then `∫ h_m det A_m dμ → ∫ h₀ det A₀ dμ`.  Dominated convergence with the bound
`H · n! Cⁿ` (`deformation_ipl_mwc_mil_abs_det_le`); `det A_m` is a.e.-strongly measurable by
the Leibniz formula and `det` is continuous in the entries. -/
theorem Submission.deformation_ipl_mwc_mil_tendsto_integral_mul_det : ∀ (α : Type) [MeasurableSpace α] (μ : Measure α) (n : ℕ) (C : ℝ) (A : ℕ → Fin n → Fin n → α → ℝ) (A₀ : Fin n → Fin n → α → ℝ) (h : ℕ → α → ℝ) (h₀ H : α → ℝ), (∀ m t s, AEStronglyMeasurable (A m t s) μ) → (∀ m, AEStronglyMeasurable (h m) μ) → Integrable H μ → (∀ m t s x, |A m t s x| ≤ C) → (∀ᶠ m in atTop, ∀ x, |h m x| ≤ H x) → (∀ᵐ x ∂μ, Tendsto (fun m => h m x) atTop (𝓝 (h₀ x))) → (∀ᵐ x ∂μ, ∀ t s, Tendsto (fun m => A m t s x) atTop (𝓝 (A₀ t s x))) → Tendsto (fun m => ∫ x, h m x * Matrix.det (Matrix.of fun t s => A m t s x) ∂μ) atTop (𝓝 (∫ x, h₀ x * Matrix.det (Matrix.of fun t s => A₀ t s x) ∂μ)) := by
  intro α _ μ n C A A₀ h h₀ H hAm hhm hH hAb hhb hhl hAl
  refine tendsto_integral_filter_of_dominated_convergence
    (fun x => H x * ((n.factorial : ℝ) * C ^ n)) ?_ ?_ (hH.mul_const _) ?_
  · -- Leibniz: `det A_m(x) = ∑_σ sgn σ ∏_i A_m(σ i, i, x)`, finite sums and products of
    -- a.e.-strongly measurable functions.
    refine Eventually.of_forall fun m => (hhm m).mul ?_
    have hdet : (fun x => Matrix.det (Matrix.of fun t s => A m t s x)) =
        fun x => ∑ σ : Equiv.Perm (Fin n), ((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ i, A m (σ i) i x := by
      funext x
      rw [Matrix.det_apply]
      refine Finset.sum_congr rfl fun σ _ => ?_
      rw [Units.smul_def, zsmul_eq_mul]
      rfl
    rw [hdet]
    refine Finset.aestronglyMeasurable_fun_sum _ fun σ _ => ?_
    exact aestronglyMeasurable_const.mul
      (Finset.aestronglyMeasurable_fun_prod _ fun i _ => hAm m _ _)
  · -- `|h_m(x) det A_m(x)| ≤ H(x) · n! Cⁿ` for every `x`, once `|h_m| ≤ H`.
    filter_upwards [hhb] with m hm
    refine Eventually.of_forall fun x => ?_
    rw [Real.norm_eq_abs, abs_mul]
    exact mul_le_mul (hm x)
      (Submission.deformation_ipl_mwc_mil_abs_det_le n C _ fun t s => hAb m t s x)
      (abs_nonneg _) ((abs_nonneg _).trans (hm x))
  · -- Entrywise convergence gives `A_m(x) → A₀(x)` in the product topology; `det` is continuous.
    filter_upwards [hhl, hAl] with x hx1 hx2
    refine hx1.mul ?_
    have hc : Continuous (Matrix.det : Matrix (Fin n) (Fin n) ℝ → ℝ) := continuous_id.matrix_det
    exact (hc.tendsto _).comp (tendsto_pi_nhds.2 fun t => tendsto_pi_nhds.2 fun s => hx2 t s)

/-- A.e. derivative of a coordinate of a Lipschitz map (the Rademacher step of the Lipschitz
minor integration by parts in the proof of Simon Ch. 6, 3.9): if `v : ℝᵏ → ℝ^Q` is `C`-Lipschitz
on an open `Ω` and `g = v^c := proj_c ∘ v` on `Ω`, then for Lebesgue-a.e. `w ∈ Ω`,
`Dg(w) x = proj_c (Dv(w) x)` for every `x`.  By Rademacher's theorem `v` is differentiable within
`Ω` at a.e. `w ∈ Ω`, hence at `w` as `Ω` is open; `g` and `v^c` agree near `w`, so they have the
same `fderiv`, which is `proj_c ∘L Dv(w)` by the chain rule.  No regularity of `g` is needed. -/
theorem Submission.deformation_ipl_mwc_mil_ae_fderiv_eq_proj :
    ∀ (k Q : ℕ) (Ω : Set (Eucl k)) (C : ℝ≥0) (v : Eucl k → Eucl Q) (c : Fin Q)
      (g : Eucl k → ℝ), IsOpen Ω → LipschitzOnWith C v Ω →
      EqOn g (fun w => EuclideanSpace.proj c (v w)) Ω →
      ∀ᵐ w ∂(volume : Measure (Eucl k)), w ∈ Ω → ∀ x : Eucl k,
        fderiv ℝ g w x = EuclideanSpace.proj c (fderiv ℝ v w x) := by
  intro k Q Ω C v c g hΩ hv hg
  -- Rademacher's theorem on `Ω`: `v` is differentiable within `Ω` at a.e. `w ∈ Ω`.
  filter_upwards [hv.ae_differentiableWithinAt_of_mem (μ := volume)] with w hw hwΩ x
  -- `Ω` is a neighbourhood of `w`, so `v` is differentiable at `w` and `g = proj_c ∘ v` near `w`.
  have hd : DifferentiableAt ℝ v w := (hw hwΩ).differentiableAt (hΩ.mem_nhds hwΩ)
  have heq : g =ᶠ[𝓝 w] (fun w => EuclideanSpace.proj c (v w)) :=
    eventuallyEq_of_mem (hΩ.mem_nhds hwΩ) hg
  -- Chain rule for the continuous linear map `proj_c`.
  have hcomp : HasFDerivAt (fun w => EuclideanSpace.proj c (v w))
      ((EuclideanSpace.proj c).comp (fderiv ℝ v w)) w :=
    (EuclideanSpace.proj c : Eucl Q →L[ℝ] ℝ).hasFDerivAt.comp w hd.hasFDerivAt
  -- Locality of `fderiv`: `Dg(w) = D(proj_c ∘ v)(w) = proj_c ∘L Dv(w)`.
  rw [heq.fderiv_eq, hcomp.fderiv]
  rfl

/-- **A directional derivative of a compactly supported `C¹` function has integral `0`.**  For
`h : ℝᵏ → ℝ` of class `C¹` with compact support and `e ∈ ℝᵏ`, `∫ Dh(w)(e) dw = 0`, where
`Dh(w) = fderiv ℝ h w`.  `h` is Lipschitz, so integration by parts for Lipschitz functions against
the constant function `1` gives `∫ ∂ₑ1 · h = ∫ ∂₋ₑh · 1`.  The left side vanishes and, `h` being
differentiable, `∂₋ₑh(w) = Dh(w)(-e) = -Dh(w)(e)`, so the right side is `-∫ Dh(w)(e) dw`. -/
theorem Submission.deformation_ipl_mwc_mis_integral_fderiv_eq_zero :
    ∀ (k : ℕ) (h : Eucl k → ℝ) (e : Eucl k), ContDiff ℝ 1 h → HasCompactSupport h →
      ∫ w, fderiv ℝ h w e ∂(volume : Measure (Eucl k)) = 0 := by
  intro k h e hh hcs
  -- `h` is Lipschitz; integrate by parts against the constant function `1`.
  obtain ⟨D, hD⟩ := ContDiff.lipschitzWith_of_hasCompactSupport hcs hh one_ne_zero
  have key := LipschitzWith.integral_lineDeriv_mul_eq (μ := (volume : Measure (Eucl k)))
    (LipschitzWith.const (α := Eucl k) (1 : ℝ)) hD hcs e
  -- Both functions are differentiable, so their line derivatives are Fréchet derivatives.
  have h1 : ∀ w, lineDeriv ℝ (fun _ : Eucl k => (1 : ℝ)) w e = 0 := fun w => by
    rw [(differentiableAt_const (1 : ℝ)).lineDeriv_eq_fderiv]
    simp
  have h2 : ∀ w, lineDeriv ℝ h w (-e) = -fderiv ℝ h w e := fun w => by
    rw [((hh.differentiable one_ne_zero) w).lineDeriv_eq_fderiv]
    simp
  simp only [h1, h2, zero_mul, integral_zero, mul_one, integral_neg] at key
  linarith

/-- **The determinant of a matrix of `C^m` functions is `C^m`.**  Let `M t s : ℝᵏ → ℝ`
(`t, s : Fin n`) be `C^m` for some `m : WithTop ℕ∞` (finite, `∞` or `ω`).  Then
`w ↦ det (M t s w)ₜₛ` is `C^m`.  By the Leibniz formula `det A = ∑_σ sign σ · ∏ᵢ A (σ i) i`, this
function is a finite sum, over the permutations `σ` of `Fin n`, of constant multiples of finite
products of entries (for `n = 0` it is the constant `1`). -/
theorem Submission.deformation_ipl_mwc_mis_det_contDiff :
    ∀ (k n : ℕ) (m : WithTop ℕ∞) (M : Fin n → Fin n → Eucl k → ℝ),
      (∀ t s, ContDiff ℝ m (M t s)) →
        ContDiff ℝ m (fun w => Matrix.det (Matrix.of fun t s : Fin n => M t s w)) := by
  intro k n m M hM
  -- Leibniz formula: `det (M t s w)ₜₛ = ∑_σ sign σ * ∏ᵢ M (σ i) i w`.
  simp only [Matrix.det_apply', Matrix.of_apply]
  -- Each summand is a constant times a finite product of `C^m` entries.
  apply ContDiff.sum
  intro σ _
  apply contDiff_const.mul
  apply contDiff_prod
  intro i _
  exact hM _ _

/-- Signed first-row cofactors as restricted Leibniz sums: `(-1)^q` times the minor of the
`r × (r + 1)` array `N` with column `q` deleted is the sum of `sgn σ * ∏ t, N t (σ t.succ)` over
the permutations `σ` of `Fin (r + 1)` with `σ 0 = q`.  Both sides are the determinant of the
matrix with row `0` equal to `Pi.single q 1` and row `t.succ` equal to `N t`. -/
theorem Submission.deformation_ipl_mwc_pi_cofactor_leibniz : ∀ (r : ℕ) (N : Fin r → Fin (r + 1) → ℝ) (q : Fin (r + 1)), (-1 : ℝ) ^ (q : ℕ) * Matrix.det (Matrix.of fun t s : Fin r => N t (q.succAbove s)) = ∑ σ : Equiv.Perm (Fin (r + 1)), (if σ 0 = q then ((Equiv.Perm.sign σ : ℤ) : ℝ) else 0) * ∏ t : Fin r, N t (σ t.succ) := by
  intro r N q
  let A : Matrix (Fin (r + 1)) (Fin (r + 1)) ℝ := Matrix.of (Matrix.vecCons (Pi.single q 1) N)
  -- Laplace expansion along row `0`: only the column `j = q` survives.
  have h1 : A.det = (-1 : ℝ) ^ (q : ℕ) *
      Matrix.det (Matrix.of fun t s : Fin r => N t (q.succAbove s)) := by
    rw [Matrix.det_succ_row_zero, Finset.sum_eq_single q]
    · have hsub : A.submatrix Fin.succ q.succAbove =
          Matrix.of fun t s : Fin r => N t (q.succAbove s) := by
        ext t s
        simp [A]
      rw [hsub]
      simp [A]
    · intro j _ hj
      simp [A, hj]
    · intro h
      exact absurd (Finset.mem_univ q) h
  -- Leibniz formula for `Aᵀ`: the row-`0` factor `Pi.single q 1 (σ 0)` selects `σ 0 = q`.
  have h2 : A.det = ∑ σ : Equiv.Perm (Fin (r + 1)),
      (if σ 0 = q then ((Equiv.Perm.sign σ : ℤ) : ℝ) else 0) * ∏ t : Fin r, N t (σ t.succ) := by
    rw [← Matrix.det_transpose, Matrix.det_apply']
    refine Finset.sum_congr rfl (fun σ _ => ?_)
    rw [Fin.prod_univ_succ]
    simp only [A, Matrix.transpose_apply, Matrix.of_apply, Matrix.cons_val_zero,
      Matrix.cons_val_succ, Pi.single_apply]
    split_ifs <;> ring
  rw [← h1, h2]

/-- Schwarz symmetry of mixed directional second derivatives of a `C²` function on `ℝ^k`:
`∂_v (∂_u f)(x) = ∂_u (∂_v f)(x)`. -/
theorem Submission.deformation_ipl_mwc_pi_hessian_symm :
    ∀ (k : ℕ) (f : Eucl k → ℝ), ContDiff ℝ 2 f → ∀ x u v : Eucl k,
      fderiv ℝ (fun y : Eucl k => fderiv ℝ f y u) x v =
        fderiv ℝ (fun y : Eucl k => fderiv ℝ f y v) x u := by
  intro k f hf x u v
  -- `Df` is `C¹`, hence differentiable at `x`; by Schwarz, `D²f(x)` is symmetric.
  have h1 : ContDiff ℝ 1 (fderiv ℝ f) := hf.fderiv_right (by norm_num)
  have hd : DifferentiableAt ℝ (fderiv ℝ f) x := (h1.differentiable (by norm_num)) x
  have hs : IsSymmSndFDerivAt ℝ f x := hf.contDiffAt.isSymmSndFDerivAt (by simp)
  -- Differentiating `y ↦ Df(y) u` at `x` in direction `v` gives `D²f(x) v u`.
  rw [fderiv_clm_apply hd (differentiableAt_const u),
    fderiv_clm_apply hd (differentiableAt_const v)]
  simpa using hs v u

/-- Product rule for a weighted sum of finite products: if every `g i t` is differentiable at
`w`, the derivative of `x ↦ ∑ i, a i * ∏ t, g i t x` at `w` in direction `v` is
`∑ i, a i * ∑ u, fderiv ℝ (g i u) w v * ∏ t ≠ u, g i t w`. -/
theorem Submission.deformation_ipl_mwc_pi_fderiv_sum_prod : ∀ (k r : ℕ) (ι : Type) [Fintype ι] (a : ι → ℝ) (g : ι → Fin r → Eucl k → ℝ) (w v : Eucl k), (∀ i t, DifferentiableAt ℝ (g i t) w) → fderiv ℝ (fun x : Eucl k => ∑ i, a i * ∏ t, g i t x) w v = ∑ i, a i * ∑ u, fderiv ℝ (g i u) w v * ∏ t ∈ Finset.univ.erase u, g i t w := by
  intro k r ι _ a g w v hg
  -- Product rule for each `∏ t, g i t`, then the constant factor `a i` and the sum over `ι`.
  have hs : HasFDerivAt (fun x => ∑ i, a i * ∏ t, g i t x)
      (∑ i, a i • ∑ u, (∏ t ∈ Finset.univ.erase u, g i t w) • fderiv ℝ (g i u) w) w :=
    HasFDerivAt.fun_sum fun i _ =>
      (HasFDerivAt.finsetProd fun t _ => (hg i t).hasFDerivAt).const_mul (a i)
  -- Evaluate the derivative at `v` termwise and commute the real factors.
  rw [hs.fderiv]
  simp only [sum_apply, smul_apply, smul_eq_mul]
  refine Finset.sum_congr rfl fun i _ => ?_
  congr 1
  refine Finset.sum_congr rfl fun u _ => ?_
  ring

/-- Algebraic core of the Piola identity: an alternating sum over permutations against a kernel
`H u` symmetric in its two arguments vanishes, since `σ ↦ σ * swap 0 u.succ` reverses the sign,
exchanges the two arguments of `H u` and fixes every other factor. -/
theorem Submission.deformation_ipl_mwc_pi_swap_cancel : ∀ (r : ℕ) (H : Fin r → Fin (r + 1) → Fin (r + 1) → ℝ) (N : Fin r → Fin (r + 1) → ℝ), (∀ u i j, H u i j = H u j i) → ∑ σ : Equiv.Perm (Fin (r + 1)), ((Equiv.Perm.sign σ : ℤ) : ℝ) * ∑ u : Fin r, H u (σ 0) (σ u.succ) * ∏ t ∈ Finset.univ.erase u, N t (σ t.succ) = 0 := by
  intro r H N hH
  simp_rw [Finset.mul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_eq_zero (fun u _ => ?_)
  -- Pair `σ` with `σ * τ`, `τ = (0 u.succ)`; the terms `T σ` and `T (σ * τ)` cancel.
  let τ : Equiv.Perm (Fin (r + 1)) := Equiv.swap 0 u.succ
  have hτne : (0 : Fin (r + 1)) ≠ u.succ := (Fin.succ_ne_zero u).symm
  let T : Equiv.Perm (Fin (r + 1)) → ℝ := fun σ =>
    ((Equiv.Perm.sign σ : ℤ) : ℝ) * (H u (σ 0) (σ u.succ) * ∏ t ∈ Finset.univ.erase u, N t (σ t.succ))
  have hT : ∀ σ : Equiv.Perm (Fin (r + 1)), T (σ * τ) = - T σ := by
    intro σ
    have h0 : (σ * τ) 0 = σ u.succ := by simp [τ, Equiv.Perm.mul_apply]
    have h1 : (σ * τ) u.succ = σ 0 := by simp [τ, Equiv.Perm.mul_apply]
    have hprod : ∏ t ∈ Finset.univ.erase u, N t ((σ * τ) t.succ) =
        ∏ t ∈ Finset.univ.erase u, N t (σ t.succ) := by
      refine Finset.prod_congr rfl (fun t ht => ?_)
      have htu : t ≠ u := Finset.ne_of_mem_erase ht
      rw [Equiv.Perm.mul_apply, Equiv.swap_apply_of_ne_of_ne (Fin.succ_ne_zero t)
        (fun h => htu (Fin.succ_injective _ h))]
    have hsign : ((Equiv.Perm.sign (σ * τ) : ℤ) : ℝ) = - ((Equiv.Perm.sign σ : ℤ) : ℝ) := by
      rw [Equiv.Perm.sign_mul, Equiv.Perm.sign_swap hτne]
      push_cast
      ring
    simp only [T]
    rw [h0, h1, hprod, hsign, hH u (σ u.succ) (σ 0)]
    ring
  have hS : ∑ σ, T σ = - ∑ σ, T σ :=
    calc ∑ σ, T σ = ∑ σ, T (σ * τ) := (Equiv.sum_comp (Equiv.mulRight τ) T).symm
      _ = ∑ σ, - T σ := Finset.sum_congr rfl (fun σ _ => hT σ)
      _ = - ∑ σ, T σ := Finset.sum_neg_distrib _
  linarith

/-- Piola identity (step (3.2)(i) of the proof of `minor_weak_continuity`; Evans, PDE, §8.1.4(b),
Lemma 1): for `C²` functions `W_0, …, W_{r-1}` on `ℝ^k` and `b : Fin (r + 1) → Fin k`, the signed
minors `c_q = (-1)^q det (∂_{b (q.succAbove s)} W_t)_{t,s}` satisfy `∑_q ∂_{b q} c_q = 0`.
By the cofactor formula `c_q = ∑_{σ 0 = q} sgn σ ∏_t ∂_{b (σ t.succ)} W_t` and the product rule,
`∑_q ∂_{b q} c_q = ∑_σ sgn σ ∑_u H_u(σ 0, σ u.succ) ∏_{t ≠ u} ∂_{b (σ t.succ)} W_t` with
`H_u(i, j) = ∂_{b i} ∂_{b j} W_u`; this vanishes since `H_u` is symmetric (Schwarz) and
`σ ↦ σ * swap 0 u.succ` changes the sign. -/
theorem Submission.deformation_ipl_mwc_piola_identity :
    ∀ (k r : ℕ) (W : Fin r → Eucl k → ℝ) (b : Fin (r + 1) → Fin k), (∀ t, ContDiff ℝ 2 (W t)) →
      ∀ w : Eucl k, ∑ q : Fin (r + 1), fderiv ℝ (fun x : Eucl k => (-1 : ℝ) ^ (q : ℕ) *
        Matrix.det (Matrix.of fun t s : Fin r =>
          fderiv ℝ (W t) x (EuclideanSpace.single (b (q.succAbove s)) 1))) w
          (EuclideanSpace.single (b q) 1) = 0 := by
  intro k r W b hW w
  -- `D t i x = ∂_{b i} W_t (x)`, the entries of the minors; `C¹` since `W_t` is `C²`.
  let D : Fin r → Fin (r + 1) → Eucl k → ℝ := fun t i x =>
    fderiv ℝ (W t) x (EuclideanSpace.single (b i) 1)
  have hD : ∀ t i, DifferentiableAt ℝ (D t i) w := fun t i =>
    (((hW t).fderiv_right (m := 1) (by norm_num)).differentiable one_ne_zero w).clm_apply
      (differentiableAt_const _)
  -- `H u i j = ∂_{b i} ∂_{b j} W_u (w)` is symmetric in `(i, j)`.
  let H : Fin r → Fin (r + 1) → Fin (r + 1) → ℝ := fun u i j =>
    fderiv ℝ (D u j) w (EuclideanSpace.single (b i) 1)
  have hH : ∀ u i j, H u i j = H u j i := fun u i j =>
    Submission.deformation_ipl_mwc_pi_hessian_symm k (W u) (hW u) w
      (EuclideanSpace.single (b j) 1) (EuclideanSpace.single (b i) 1)
  -- Cofactor formula and product rule: `∂_{b q} c_q = ∑_{σ 0 = q} sgn σ ∂_{b q} ∏_t D t (σ t.succ)`
  have hc : ∀ q : Fin (r + 1), fderiv ℝ (fun x : Eucl k => (-1 : ℝ) ^ (q : ℕ) *
      Matrix.det (Matrix.of fun t s : Fin r =>
        fderiv ℝ (W t) x (EuclideanSpace.single (b (q.succAbove s)) 1))) w
        (EuclideanSpace.single (b q) 1) =
      ∑ σ : Equiv.Perm (Fin (r + 1)), (if σ 0 = q then ((Equiv.Perm.sign σ : ℤ) : ℝ) else 0) *
        ∑ u : Fin r, H u q (σ u.succ) * ∏ t ∈ Finset.univ.erase u, D t (σ t.succ) w := by
    intro q
    have hcof : (fun x : Eucl k => (-1 : ℝ) ^ (q : ℕ) *
        Matrix.det (Matrix.of fun t s : Fin r =>
          fderiv ℝ (W t) x (EuclideanSpace.single (b (q.succAbove s)) 1))) =
        fun x => ∑ σ : Equiv.Perm (Fin (r + 1)),
          (if σ 0 = q then ((Equiv.Perm.sign σ : ℤ) : ℝ) else 0) * ∏ t : Fin r, D t (σ t.succ) x :=
      funext fun x => Submission.deformation_ipl_mwc_pi_cofactor_leibniz r (fun t i => D t i x) q
    rw [hcof]
    exact Submission.deformation_ipl_mwc_pi_fderiv_sum_prod k r (Equiv.Perm (Fin (r + 1)))
      (fun σ => if σ 0 = q then ((Equiv.Perm.sign σ : ℤ) : ℝ) else 0)
      (fun σ t => D t (σ t.succ)) w _ fun σ t => hD t (σ t.succ)
  -- Sum over `q`: only `q = σ 0` survives, and the sum cancels in pairs `σ, σ * swap 0 u.succ`.
  refine Eq.trans ?_
    (Submission.deformation_ipl_mwc_pi_swap_cancel r H (fun t i => D t i w) hH)
  rw [Fintype.sum_congr _ _ hc, Finset.sum_comm]
  refine Fintype.sum_congr _ _ fun σ => ?_
  rw [Finset.sum_eq_single (σ 0) (fun q _ hq => by rw [ite_eq_right (Ne.symm hq), zero_mul])
    (fun h => absurd (Finset.mem_univ _) h), ite_eq_left rfl]

/-- Integration by parts for Jacobian minors of `C²` functions (step (3.2)(ii) of the weak
continuity of Jacobian minors behind the Lipschitz push-forward limits in the proof of the
Deformation Theorem, Simon Ch. 6, 5.1): for `C²` functions `V₀, …, V_r : ℝᵏ → ℝ`, directions
`b : Fin (r + 1) → Fin k` and `φ ∈ C¹_c(ℝᵏ)`, with
`A = (∂_{b(s)} V_t)_{t,s}` and the signed first-row cofactors
`C_q = (-1)^q det(∂_{b(q.succAbove s)} V_{t+1})_{t,s}`, `∫ φ det A = -∑_q ∫ V₀ C_q ∂_{b(q)} φ`.
Laplace expansion along row `0` gives `det A = ∑_q ∂_{b(q)} V₀ · C_q`.  The directional derivative
`∂_{b(q)}(V₀ φ C_q)` of the compactly supported `C¹` function `V₀ φ C_q` has integral `0`, and the
product rule turns this into `∫ ∂_{b(q)} V₀ φ C_q = -∫ V₀ ∂_{b(q)} φ C_q - ∫ V₀ φ ∂_{b(q)} C_q`.
Summing over `q`, the last terms cancel by the Piola identity `∑_q ∂_{b(q)} C_q = 0`. -/
theorem Submission.deformation_ipl_mwc_minor_ibp_smooth :
    ∀ (k r : ℕ) (V : Fin (r + 1) → Eucl k → ℝ) (b : Fin (r + 1) → Fin k) (φ : Eucl k → ℝ),
      (∀ t, ContDiff ℝ 2 (V t)) → ContDiff ℝ 1 φ → HasCompactSupport φ →
      ∫ w, φ w * Matrix.det (Matrix.of fun t s : Fin (r + 1) =>
          fderiv ℝ (V t) w (EuclideanSpace.single (b s) 1)) ∂(volume : Measure (Eucl k)) =
        -∑ q : Fin (r + 1), ∫ w, V 0 w * ((-1 : ℝ) ^ (q : ℕ) *
          Matrix.det (Matrix.of fun t s : Fin r =>
            fderiv ℝ (V t.succ) w (EuclideanSpace.single (b (q.succAbove s)) 1))) *
          fderiv ℝ φ w (EuclideanSpace.single (b q) 1) ∂(volume : Measure (Eucl k)) := by
  intro k r V b φ hV hφ hφc
  -- `C q w = (-1)^q det(∂_{b(q.succAbove s)} V_{t+1}(w))_{t,s}`: the signed first-row cofactors.
  obtain ⟨C, hC⟩ : ∃ C : Fin (r + 1) → Eucl k → ℝ, ∀ q w, C q w = (-1 : ℝ) ^ (q : ℕ) *
      Matrix.det (Matrix.of fun t s : Fin r =>
        fderiv ℝ (V t.succ) w (EuclideanSpace.single (b (q.succAbove s)) 1)) :=
    ⟨_, fun _ _ => rfl⟩
  have hCf : ∀ q, C q = fun w => (-1 : ℝ) ^ (q : ℕ) *
      Matrix.det (Matrix.of fun t s : Fin r =>
        fderiv ℝ (V t.succ) w (EuclideanSpace.single (b (q.succAbove s)) 1)) :=
    fun q => funext (hC q)
  -- Step 1 (Laplace expansion along row `0`): `det A = ∑_q ∂_{b(q)} V₀ · C_q`.
  have hLap : ∀ w, Matrix.det (Matrix.of fun t s : Fin (r + 1) =>
      fderiv ℝ (V t) w (EuclideanSpace.single (b s) 1)) =
      ∑ q, fderiv ℝ (V 0) w (EuclideanSpace.single (b q) 1) * C q w := by
    intro w
    rw [Matrix.det_succ_row_zero]
    refine Finset.sum_congr rfl fun q _ => ?_
    rw [hC q w, Matrix.of_apply]
    have hsub : (Matrix.of fun t s : Fin (r + 1) =>
        fderiv ℝ (V t) w (EuclideanSpace.single (b s) 1)).submatrix Fin.succ q.succAbove =
        Matrix.of fun t s : Fin r =>
          fderiv ℝ (V t.succ) w (EuclideanSpace.single (b (q.succAbove s)) 1) := rfl
    rw [hsub]
    ring
  -- Step 2 (regularity): the entries `∂_i V_t` and, by the Leibniz formula, the cofactors `C_q`
  -- are `C¹`.
  have hDV : ∀ t i, ContDiff ℝ 1 fun w => fderiv ℝ (V t) w (EuclideanSpace.single i 1) :=
    fun t i => ((hV t).fderiv_right (m := 1) one_add_one_eq_two.le).clm_apply contDiff_const
  have hV0 : ContDiff ℝ 1 (V 0) := (hV 0).of_le one_le_two
  have hCd : ∀ q, ContDiff ℝ 1 (C q) := by
    intro q
    rw [hCf q]
    exact contDiff_const.mul (Submission.deformation_ipl_mwc_mis_det_contDiff k r 1
      (fun t s w => fderiv ℝ (V t.succ) w (EuclideanSpace.single (b (q.succAbove s)) 1))
      fun t s => hDV t.succ _)
  -- Step 3 (supports and integrability): `φ` and `Dφ` vanish off the compact set `tsupport φ`,
  -- so every continuous integrand below with a factor `φ` or `∂_i φ` is integrable.
  have hφ0 : ∀ w, w ∉ tsupport φ → φ w = 0 := fun w hw => image_eq_zero_of_notMem_tsupport hw
  have hdφ0 : ∀ w, w ∉ tsupport φ → fderiv ℝ φ w = 0 :=
    fun w hw => fderiv_of_notMem_tsupport ℝ hw
  have hcs : ∀ g : Eucl k → ℝ, (∀ w, w ∉ tsupport φ → g w = 0) → HasCompactSupport g := by
    intro g hg0
    refine hφc.mono' fun w hw => ?_
    by_contra hw'
    exact (Function.mem_support.mp hw) (hg0 w hw')
  have hint : ∀ g : Eucl k → ℝ, Continuous g → (∀ w, w ∉ tsupport φ → g w = 0) →
      Integrable g (volume : Measure (Eucl k)) :=
    fun g hg hg0 => hg.integrable_of_hasCompactSupport (hcs g hg0)
  have hcDφ : ∀ i, Continuous fun w => fderiv ℝ φ w (EuclideanSpace.single i 1) :=
    fun i => (hφ.continuous_fderiv one_ne_zero).clm_apply continuous_const
  have hcDC : ∀ q i, Continuous fun w => fderiv ℝ (C q) w (EuclideanSpace.single i 1) :=
    fun q i => ((hCd q).continuous_fderiv one_ne_zero).clm_apply continuous_const
  have hT1 : ∀ q, Integrable (fun w => fderiv ℝ (V 0) w (EuclideanSpace.single (b q) 1) *
      φ w * C q w) (volume : Measure (Eucl k)) := fun q =>
    hint _ (((hDV 0 _).continuous.mul hφ.continuous).mul (hCd q).continuous)
      fun w hw => by rw [hφ0 w hw, mul_zero, zero_mul]
  have hT2 : ∀ q, Integrable (fun w => V 0 w * fderiv ℝ φ w (EuclideanSpace.single (b q) 1) *
      C q w) (volume : Measure (Eucl k)) := fun q =>
    hint _ ((hV0.continuous.mul (hcDφ _)).mul (hCd q).continuous)
      fun w hw => by rw [hdφ0 w hw, zero_apply, mul_zero, zero_mul]
  have hT3 : ∀ q, Integrable (fun w => V 0 w * φ w *
      fderiv ℝ (C q) w (EuclideanSpace.single (b q) 1)) (volume : Measure (Eucl k)) := fun q =>
    hint _ ((hV0.continuous.mul hφ.continuous).mul (hcDC q _))
      fun w hw => by rw [hφ0 w hw, mul_zero, zero_mul]
  -- Product rule for `V₀ φ C_q` in the direction `e_{b(q)}`.
  have hprod : ∀ q w, fderiv ℝ (fun y => V 0 y * φ y * C q y) w (EuclideanSpace.single (b q) 1) =
      fderiv ℝ (V 0) w (EuclideanSpace.single (b q) 1) * φ w * C q w +
        V 0 w * fderiv ℝ φ w (EuclideanSpace.single (b q) 1) * C q w +
        V 0 w * φ w * fderiv ℝ (C q) w (EuclideanSpace.single (b q) 1) := by
    intro q w
    have hd : HasFDerivAt (fun y => V 0 y * φ y * C q y)
        ((V 0 w * φ w) • fderiv ℝ (C q) w +
          C q w • (V 0 w • fderiv ℝ φ w + φ w • fderiv ℝ (V 0) w)) w :=
      ((hV0.differentiable one_ne_zero w).hasFDerivAt.mul
        (hφ.differentiable one_ne_zero w).hasFDerivAt).mul
        ((hCd q).differentiable one_ne_zero w).hasFDerivAt
    rw [hd.fderiv]
    simp only [add_apply, smul_apply, smul_eq_mul]
    ring
  -- Steps 4–5 (one integration by parts for each `q`): `∫ ∂_{b(q)}(V₀ φ C_q) = 0`, so
  -- `∫ ∂_{b(q)} V₀ φ C_q = -∫ V₀ ∂_{b(q)} φ C_q - ∫ V₀ φ ∂_{b(q)} C_q`.
  have hq : ∀ q, ∫ w, fderiv ℝ (V 0) w (EuclideanSpace.single (b q) 1) * φ w * C q w =
      -(∫ w, V 0 w * fderiv ℝ φ w (EuclideanSpace.single (b q) 1) * C q w) -
        ∫ w, V 0 w * φ w * fderiv ℝ (C q) w (EuclideanSpace.single (b q) 1) := by
    intro q
    have h0 := Submission.deformation_ipl_mwc_mis_integral_fderiv_eq_zero k
      (fun y => V 0 y * φ y * C q y) (EuclideanSpace.single (b q) 1) ((hV0.mul hφ).mul (hCd q))
      (hcs _ fun w hw => by rw [hφ0 w hw, mul_zero, zero_mul])
    simp only [hprod q] at h0
    have h12 : Integrable (fun w => fderiv ℝ (V 0) w (EuclideanSpace.single (b q) 1) * φ w * C q w +
        V 0 w * fderiv ℝ φ w (EuclideanSpace.single (b q) 1) * C q w)
        (volume : Measure (Eucl k)) := (hT1 q).add (hT2 q)
    rw [integral_add h12 (hT3 q), integral_add (hT1 q) (hT2 q)] at h0
    linarith
  -- Step 6 (Piola identity for the rows `W_t = V_{t+1}`): `∑_q ∂_{b(q)} C_q = 0`.
  have hdivC : ∀ w, ∑ q, fderiv ℝ (C q) w (EuclideanSpace.single (b q) 1) = 0 := by
    intro w
    simp only [hCf]
    exact Submission.deformation_ipl_mwc_piola_identity k r (fun t => V t.succ) b
      (fun t => hV t.succ) w
  calc ∫ w, φ w * Matrix.det (Matrix.of fun t s : Fin (r + 1) =>
          fderiv ℝ (V t) w (EuclideanSpace.single (b s) 1)) ∂(volume : Measure (Eucl k))
      = ∫ w, ∑ q, fderiv ℝ (V 0) w (EuclideanSpace.single (b q) 1) * φ w * C q w := by
        refine integral_congr_ae (ae_of_all _ fun w => ?_)
        simp only [hLap w, Finset.mul_sum]
        refine Finset.sum_congr rfl fun q _ => ?_
        ring
    _ = ∑ q, ∫ w, fderiv ℝ (V 0) w (EuclideanSpace.single (b q) 1) * φ w * C q w :=
        integral_finsetSum _ fun q _ => hT1 q
    _ = ∑ q, (-(∫ w, V 0 w * fderiv ℝ φ w (EuclideanSpace.single (b q) 1) * C q w) -
          ∫ w, V 0 w * φ w * fderiv ℝ (C q) w (EuclideanSpace.single (b q) 1)) :=
        Finset.sum_congr rfl fun q _ => hq q
    _ = -(∑ q, ∫ w, V 0 w * fderiv ℝ φ w (EuclideanSpace.single (b q) 1) * C q w) -
          ∫ w, ∑ q, V 0 w * φ w * fderiv ℝ (C q) w (EuclideanSpace.single (b q) 1) := by
        rw [integral_finsetSum _ fun q _ => hT3 q, Finset.sum_sub_distrib, Finset.sum_neg_distrib]
    _ = -∑ q, ∫ w, V 0 w * fderiv ℝ φ w (EuclideanSpace.single (b q) 1) * C q w := by
        simp only [← Finset.mul_sum, hdivC, mul_zero, integral_zero, sub_zero]
    _ = -∑ q : Fin (r + 1), ∫ w, V 0 w * ((-1 : ℝ) ^ (q : ℕ) *
          Matrix.det (Matrix.of fun t s : Fin r =>
            fderiv ℝ (V t.succ) w (EuclideanSpace.single (b (q.succAbove s)) 1))) *
          fderiv ℝ φ w (EuclideanSpace.single (b q) 1) ∂(volume : Measure (Eucl k)) := by
        congr 1
        refine Finset.sum_congr rfl fun q _ => integral_congr_ae (ae_of_all _ fun w => ?_)
        simp only [hC q w]
        ring

/-- A smooth approximate identity on `ℝⁿ` (Simon Ch. 6, proof of 2.34, p. 143; Ch. 2, §2):
`ψ_k(y) = (k+1)ⁿ I⁻¹ h((k+1) y)` for a smooth bump `0 ≤ h ≤ 1` with `h(0) = 1`,
`spt h ⊆ B_1(0)` and `I = ∫ h > 0`.  Each `ψ_k` is `C^∞`, nonnegative, of integral `1` and
supported in `B̄_{1/(k+1)}(0)`, and `0 ≤ ψ_k ≤ (k+1)ⁿ I⁻¹`.  For locally integrable `g` and every
Lebesgue point `x` of `g` (Simon Ch. 1, 3.17), `|(g ∗ ψ_k)(x) − g(x)| ≤ I⁻¹ Lⁿ(B_1(0)) ·
⨍_{B̄_{1/(k+1)}(x)} |g − g(x)| → 0`, so `g ∗ ψ_k → g` almost everywhere. -/
theorem Submission.constancy_mdc_smooth_approx_identity_ae_tendsto :
    ∀ n : ℕ, ∃ ψ : ℕ → Eucl n → ℝ, (∀ k, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (ψ k)) ∧
      (∀ k, HasCompactSupport (ψ k)) ∧
      (∀ k : ℕ, tsupport (ψ k) ⊆ closedBall 0 (1 / ((k : ℝ) + 1))) ∧ (∀ k y, 0 ≤ ψ k y) ∧
      (∀ k, ∫ y, ψ k y ∂volume = 1) ∧
      ∀ g : Eucl n → ℝ, LocallyIntegrable g volume → ∀ᵐ x ∂volume,
        Tendsto (fun k => convolution g (ψ k) (ContinuousLinearMap.lsmul ℝ ℝ) volume x) atTop
          (𝓝 (g x)) := by
  intro n
  -- A smooth bump `h` with `0 ≤ h ≤ 1`, `h 0 = 1` and `spt h ⊆ B_1(0)`; `I = ∫ h > 0`.
  obtain ⟨h, hts, hhc, hhs, hrange, h0⟩ :=
    exists_contDiff_tsupport_subset (n := (⊤ : ℕ∞)) (ball_mem_nhds (0 : Eucl n) one_pos)
  have hh0 : ∀ y, 0 ≤ h y := fun y => (hrange ⟨y, rfl⟩).1
  have hh1 : ∀ y, h y ≤ 1 := fun y => (hrange ⟨y, rfl⟩).2
  have hhcont : Continuous h := hhs.continuous
  have hhint : Integrable h volume := hhcont.integrable_of_hasCompactSupport hhc
  have hIpos : 0 < ∫ y, h y := by
    rw [integral_pos_iff_support_of_nonneg (fun y => hh0 y) hhint]
    exact hhcont.isOpen_support.measure_pos volume ⟨0, by simp [Function.mem_support, h0]⟩
  set I := ∫ y, h y with hI
  have hzero : ∀ y : Eucl n, 1 ≤ ‖y‖ → h y = 0 := by
    intro y hy
    apply image_eq_zero_of_notMem_tsupport
    intro hy'
    have := hts hy'
    rw [mem_ball, dist_zero_right] at this
    linarith
  -- The kernels `ψ_k(y) = (k+1)ⁿ I⁻¹ h((k+1) y)`.
  have hs : ∀ k : ℕ, (0 : ℝ) < (k : ℝ) + 1 := fun k => by positivity
  set Ψ : ℕ → Eucl n → ℝ := fun k y => ((k : ℝ) + 1) ^ n * (I⁻¹ * h (((k : ℝ) + 1) • y))
    with hΨ
  have hΨsmooth : ∀ k, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (Ψ k) := fun k =>
    contDiff_const.mul (contDiff_const.mul (hhs.comp (contDiff_const_smul _)))
  have hΨzero : ∀ (k : ℕ) (y : Eucl n), 1 / ((k : ℝ) + 1) ≤ ‖y‖ → Ψ k y = 0 := by
    intro k y hy
    have h1 : 1 ≤ ‖((k : ℝ) + 1) • y‖ := by
      rw [norm_smul, Real.norm_of_nonneg (hs k).le]
      rw [div_le_iff₀ (hs k)] at hy
      linarith
    simp only [hΨ, hzero _ h1, mul_zero]
  have hΨsupp : ∀ k : ℕ, tsupport (Ψ k) ⊆ closedBall 0 (1 / ((k : ℝ) + 1)) := by
    intro k
    refine closure_minimal ?_ isClosed_closedBall
    intro y hy
    rw [mem_closedBall, dist_zero_right]
    by_contra hlt
    push Not at hlt
    exact hy (hΨzero k y hlt.le)
  have hΨc : ∀ k, HasCompactSupport (Ψ k) := fun k =>
    HasCompactSupport.of_support_subset_isCompact (isCompact_closedBall _ _)
      ((subset_tsupport _).trans (hΨsupp k))
  have hΨnn : ∀ k y, 0 ≤ Ψ k y := fun k y => by
    have := hh0 (((k : ℝ) + 1) • y)
    have := (hs k).le
    have := inv_nonneg.2 hIpos.le
    simp only [hΨ]
    positivity
  have hΨle : ∀ k y, Ψ k y ≤ ((k : ℝ) + 1) ^ n * I⁻¹ := fun k y => by
    simp only [hΨ]
    have hp : 0 ≤ ((k : ℝ) + 1) ^ n := by positivity
    have hIi : 0 ≤ I⁻¹ := inv_nonneg.2 hIpos.le
    have := hh1 (((k : ℝ) + 1) • y)
    calc ((k : ℝ) + 1) ^ n * (I⁻¹ * h (((k : ℝ) + 1) • y))
        ≤ ((k : ℝ) + 1) ^ n * (I⁻¹ * 1) := by gcongr
      _ = _ := by ring
  have hΨint : ∀ k, Integrable (Ψ k) volume := fun k =>
    (hΨsmooth k).continuous.integrable_of_hasCompactSupport (hΨc k)
  -- `∫ ψ_k = (k+1)ⁿ I⁻¹ (k+1)⁻ⁿ ∫ h = 1` by the linear change of variables `y ↦ (k+1) y`.
  have hΨone : ∀ k, ∫ y, Ψ k y = 1 := by
    intro k
    simp only [hΨ]
    rw [integral_const_mul, integral_const_mul, Measure.integral_comp_smul,
      finrank_euclideanSpace_fin]
    rw [smul_eq_mul, abs_of_pos (by positivity : (0 : ℝ) < (((k : ℝ) + 1) ^ n)⁻¹), ← hI]
    field_simp
  refine ⟨Ψ, hΨsmooth, hΨc, hΨsupp, hΨnn, hΨone, ?_⟩
  intro g hg
  -- Lebesgue points: `⨍_{B̄_r(x)} |g − g(x)| → 0` as `r ↓ 0`, for a.e. `x`.
  have hleb :=
    IsUnifLocDoublingMeasure.ae_tendsto_average_norm_sub (volume : Measure (Eucl n)) hg 1
  filter_upwards [hleb] with x hx
  set r : ℕ → ℝ := fun k => 1 / ((k : ℝ) + 1) with hr
  have hrpos : ∀ k, 0 < r k := fun k => by simp only [hr]; positivity
  have hrlim : Tendsto r atTop (𝓝[>] 0) :=
    tendsto_nhdsWithin_iff.2 ⟨tendsto_one_div_add_atTop_nhds_zero_nat,
      Eventually.of_forall fun k => hrpos k⟩
  have havg := hx (fun _ => x) r hrlim (Eventually.of_forall fun k => by
    rw [one_mul]; exact mem_closedBall_self (hrpos k).le)
  set ω := (volume : Measure (Eucl n)).real (ball 0 1) with hω
  have hωpos : 0 < ω := by
    rw [hω, measureReal_def]
    exact ENNReal.toReal_pos (measure_ball_pos volume 0 one_pos).ne' measure_ball_lt_top.ne
  set C := I⁻¹ * ω with hC
  -- `|(g ∗ ψ_k)(x) − g(x)| ≤ C ⨍_{B̄_{1/(k+1)}(x)} |g − g(x)|` with `C = I⁻¹ Lⁿ(B_1(0))`.
  have hbound : ∀ k, ‖convolution g (Ψ k) (ContinuousLinearMap.lsmul ℝ ℝ) volume x - g x‖ ≤
      C * ⨍ y in closedBall x (r k), ‖g y - g x‖ := by
    intro k
    set K := closedBall x (r k) with hK
    have hKc : IsCompact K := isCompact_closedBall _ _
    have hconv : Integrable (fun t => g t * Ψ k (x - t)) volume := by
      have := (hΨc k).convolutionExists_right (ContinuousLinearMap.lsmul ℝ ℝ) hg
        (hΨsmooth k).continuous x
      simpa [ConvolutionExistsAt, ContinuousLinearMap.lsmul_apply, smul_eq_mul] using this
    have hconst : Integrable (fun t => g x * Ψ k (x - t)) volume :=
      ((hΨint k).comp_sub_left x).const_mul (g x)
    have hgx : g x = ∫ t, g x * Ψ k (x - t) := by
      rw [integral_const_mul, integral_sub_left_eq_self (fun y => Ψ k y) volume x, hΨone k,
        mul_one]
    have hdiff : convolution g (Ψ k) (ContinuousLinearMap.lsmul ℝ ℝ) volume x - g x =
        ∫ t, (g t - g x) * Ψ k (x - t) := by
      rw [convolution_def]
      conv_lhs => rw [hgx]
      rw [← integral_sub _ hconst]
      · congr 1
        funext t
        simp only [ContinuousLinearMap.lsmul_apply, smul_eq_mul]
        ring
      · simpa [ContinuousLinearMap.lsmul_apply, smul_eq_mul] using hconv
    have hoff : ∀ t, t ∉ K → ‖g t - g x‖ * Ψ k (x - t) = 0 := by
      intro t ht
      rw [hK, mem_closedBall, not_le, dist_eq_norm, ← norm_neg, neg_sub] at ht
      rw [hΨzero k (x - t) ht.le, mul_zero]
    have hgK : IntegrableOn g K volume := hg.integrableOn_isCompact hKc
    have hgxK : IntegrableOn (fun t => ‖g t - g x‖) K volume :=
      (hgK.sub (integrableOn_const (hKc.measure_lt_top.ne))).norm
    calc ‖convolution g (Ψ k) (ContinuousLinearMap.lsmul ℝ ℝ) volume x - g x‖
        = ‖∫ t, (g t - g x) * Ψ k (x - t)‖ := by rw [hdiff]
      _ ≤ ∫ t, ‖(g t - g x) * Ψ k (x - t)‖ := norm_integral_le_integral_norm _
      _ = ∫ t, ‖g t - g x‖ * Ψ k (x - t) := by
          congr 1
          funext t
          rw [norm_mul, Real.norm_of_nonneg (hΨnn k _)]
      _ = ∫ t in K, ‖g t - g x‖ * Ψ k (x - t) :=
          (setIntegral_eq_integral_of_forall_compl_eq_zero hoff).symm
      _ ≤ ∫ t in K, ‖g t - g x‖ * (((k : ℝ) + 1) ^ n * I⁻¹) := by
          refine integral_mono_of_nonneg (Eventually.of_forall fun t => ?_) (hgxK.mul_const _)
            (Eventually.of_forall fun t => ?_)
          · exact mul_nonneg (norm_nonneg _) (hΨnn k _)
          · exact mul_le_mul_of_nonneg_left (hΨle k _) (norm_nonneg _)
      _ = (∫ t in K, ‖g t - g x‖) * (((k : ℝ) + 1) ^ n * I⁻¹) := integral_mul_const _ _
      _ = C * ⨍ y in K, ‖g y - g x‖ := by
          rw [setAverage_eq, smul_eq_mul, hC]
          have hKvol : (volume : Measure (Eucl n)).real K = r k ^ n * ω := by
            rw [measureReal_def, hK, Measure.addHaar_closedBall _ _ (hrpos k).le,
              finrank_euclideanSpace_fin, ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity),
              hω, measureReal_def]
          rw [hKvol]
          simp only [hr]
          field_simp
          rw [mul_assoc, ← mul_pow, mul_one_div_cancel (hs k).ne', one_pow, mul_one]
  -- Squeeze: `0 ≤ |(g ∗ ψ_k)(x) − g(x)| ≤ C ⨍ … → 0`.
  rw [tendsto_iff_norm_sub_tendsto_zero]
  refine squeeze_zero (fun k => norm_nonneg _) hbound ?_
  simpa using havg.const_mul C

/-- **Smooth approximation of a Lipschitz function with a.e. convergent derivatives**
(mollification).  Let `ψ_m` be the kernels of `constancy_mdc_smooth_approx_identity_ae_tendsto`
and `G_m(x) = ∫ ψ_m(y) g(x − y) dy = (ψ_m ⋆ g)(x)`.  Then `G_m` is `C^∞`, `L`-Lipschitz (an
average of translates of `g`), and `|G_m − g| ≤ 2L/(m+1)` by
`slicing_mb_sa_mollify_lipschitz_close`.  Differentiating under the integral sign
(`slicing_mb_sa_mollify_lipschitz_hasFDerivAt`), `DG_m(x) e_b = (∂_b g ∗ ψ_m)(x)`, which tends to
`∂_b g(x)` for a.e. `x` because `∂_b g` is bounded and measurable; as `‖T‖ ≤ Σ_b |T e_b|` for
`T : ℝ^k →L[ℝ] ℝ`, `DG_m(x) → Dg(x)` for a.e. `x`. -/
theorem Submission.deformation_ipl_mwc_lipschitz_smooth_approx : ∀ (k : ℕ) (L : ℝ≥0) (g : Eucl k → ℝ), LipschitzWith L g → ∃ G : ℕ → Eucl k → ℝ, (∀ m, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (G m)) ∧ (∀ m, LipschitzWith L (G m)) ∧ TendstoUniformly G g atTop ∧ ∀ᵐ w ∂(volume : Measure (Eucl k)), Tendsto (fun m => fderiv ℝ (G m) w) atTop (𝓝 (fderiv ℝ g w)) := by
  intro k L g hg
  -- The kernels `ψ_m`: `C^∞`, `≥ 0`, `∫ ψ_m = 1`, `spt ψ_m ⊆ B̄_{1/(m+1)}(0)`.
  obtain ⟨ψ, hψs, hψc, hψsupp, hψnn, hψone, hψae⟩ :=
    Submission.constancy_mdc_smooth_approx_identity_ae_tendsto k
  have hψcont : ∀ m, Continuous (ψ m) := fun m => (hψs m).continuous
  have hψint : ∀ m, Integrable (ψ m) volume := fun m =>
    (hψcont m).integrable_of_hasCompactSupport (hψc m)
  -- `ψ_m(y) = 0` for `|y| ≥ 2/(m+1)`.
  have hψzero : ∀ (m : ℕ) (y : Eucl k), 2 / ((m : ℝ) + 1) ≤ ‖y‖ → ψ m y = 0 := by
    intro m y hy
    apply image_eq_zero_of_notMem_tsupport
    intro hy'
    have h1 := hψsupp m hy'
    rw [mem_closedBall, dist_zero_right] at h1
    have h2 : 1 / ((m : ℝ) + 1) < 2 / ((m : ℝ) + 1) :=
      div_lt_div_of_pos_right (by norm_num) (by positivity)
    linarith
  -- `G_m(x) = ∫ ψ_m(y) g(x − y) dy`.
  set G : ℕ → Eucl k → ℝ := fun m x => ∫ y, ψ m y * g (x - y) with hG
  refine ⟨G, fun m => ?_, fun m => ?_, ?_, ?_⟩
  · -- `G_m = ψ_m ⋆ g` is `C^∞`.
    have hconv : convolution (ψ m) g (ContinuousLinearMap.lsmul ℝ ℝ) volume = G m := by
      funext x
      simp only [convolution_def, ContinuousLinearMap.lsmul_apply, smul_eq_mul, hG]
    rw [← hconv]
    exact (hψc m).contDiff_convolution_left _ (hψs m) hg.continuous.locallyIntegrable
  · -- `|G_m(x) − G_m(x')| ≤ ∫ ψ_m(y) |g(x − y) − g(x' − y)| dy ≤ L |x − x'|`.
    refine LipschitzWith.of_dist_le_mul fun x x' => ?_
    have hi : ∀ z, Integrable (fun y => ψ m y * g (z - y)) volume := fun z =>
      Continuous.integrable_of_hasCompactSupport
        ((hψcont m).mul (hg.continuous.comp (continuous_const.sub continuous_id))) (hψc m).mul_right
    have hpt : ∀ y, ‖ψ m y * g (x - y) - ψ m y * g (x' - y)‖ ≤ ψ m y * ((L : ℝ) * dist x x') := by
      intro y
      rw [← mul_sub, Real.norm_eq_abs, abs_mul, abs_of_nonneg (hψnn m y)]
      refine mul_le_mul_of_nonneg_left ?_ (hψnn m y)
      rw [← Real.dist_eq]
      calc dist (g (x - y)) (g (x' - y)) ≤ L * dist (x - y) (x' - y) := hg.dist_le_mul _ _
        _ = L * dist x x' := by rw [dist_sub_right]
    rw [Real.dist_eq]
    simp only [hG]
    rw [← integral_sub (hi x) (hi x'), ← Real.norm_eq_abs]
    calc ‖∫ y, ψ m y * g (x - y) - ψ m y * g (x' - y)‖ ≤ ∫ y, ψ m y * ((L : ℝ) * dist x x') :=
          norm_integral_le_of_norm_le ((hψint m).mul_const _) (Eventually.of_forall hpt)
      _ = L * dist x x' := by rw [integral_mul_const, hψone m, one_mul]
  · -- `|G_m − g| ≤ 2L/(m+1) → 0`.
    have hclose : ∀ m x, |G m x - g x| ≤ (L : ℝ) * (2 / ((m : ℝ) + 1)) := fun m x =>
      Submission.slicing_mb_sa_mollify_lipschitz_close k g L hg (ψ m) (2 / ((m : ℝ) + 1))
        (hψcont m) (hψc m) (hψnn m) (hψzero m) (hψone m) x
    have hlim : Tendsto (fun m : ℕ => (L : ℝ) * (2 / ((m : ℝ) + 1))) atTop (𝓝 0) := by
      have := tendsto_one_div_add_atTop_nhds_zero_nat.const_mul (2 * (L : ℝ))
      rw [mul_zero] at this
      exact this.congr fun m => by ring
    rw [Metric.tendstoUniformly_iff]
    intro ε hε
    filter_upwards [(tendsto_order.1 hlim).2 ε hε] with m hm x
    rw [dist_comm, Real.dist_eq]
    exact (hclose m x).trans_lt hm
  · set e : Fin k → Eucl k := fun b => EuclideanSpace.basisFun (Fin k) ℝ b with he
    have hDg : ∀ z, ‖fderiv ℝ g z‖ ≤ L := fun z => norm_fderiv_le_of_lipschitz ℝ hg
    -- `DG_m(x) = ∫ ψ_m(y) Dg(x − y) dy`, a Bochner integral of an integrable integrand.
    have hfd : ∀ m x, fderiv ℝ (G m) x = ∫ y, ψ m y • fderiv ℝ g (x - y) := fun m x =>
      (Submission.slicing_mb_sa_mollify_lipschitz_hasFDerivAt k g L hg (ψ m) (hψcont m)
        (hψc m) x).fderiv
    have hint : ∀ m x, Integrable (fun y => ψ m y • fderiv ℝ g (x - y)) volume := by
      intro m x
      refine ((hψint m).mul_const (L : ℝ)).mono' ?_ (Eventually.of_forall fun y => ?_)
      · exact ((hψcont m).measurable.smul ((measurable_fderiv ℝ g).comp
          (measurable_const.sub measurable_id))).aestronglyMeasurable
      · rw [norm_smul, Real.norm_of_nonneg (hψnn m y)]
        exact mul_le_mul_of_nonneg_left (hDg _) (hψnn m y)
    -- Hence `DG_m(x) v = (Dg(·) v ∗ ψ_m)(x)`.
    have happly : ∀ m x v, fderiv ℝ (G m) x v =
        convolution (fun t => fderiv ℝ g t v) (ψ m) (ContinuousLinearMap.lsmul ℝ ℝ) volume x := by
      intro m x v
      rw [hfd, ContinuousLinearMap.integral_apply (hint m x), convolution_lsmul_swap]
      congr 1
      funext t
      simp only [smul_apply, smul_eq_mul, mul_comm]
    -- `Dg(·) v` is measurable and bounded by `L |v|`, hence locally integrable.
    have hloc : ∀ v, LocallyIntegrable (fun t => fderiv ℝ g t v) volume := by
      intro v
      refine (locallyIntegrable_const ((L : ℝ) * ‖v‖)).mono
        (measurable_fderiv_apply_const ℝ g v).aestronglyMeasurable
        (Eventually.of_forall fun t => ?_)
      rw [Real.norm_of_nonneg (mul_nonneg L.coe_nonneg (norm_nonneg v))]
      exact (ContinuousLinearMap.le_opNorm _ _).trans
        (mul_le_mul_of_nonneg_right (hDg t) (norm_nonneg _))
    -- For a.e. `x`: `DG_m(x) e_b → Dg(x) e_b` for every `b`.
    have hae : ∀ᵐ x ∂(volume : Measure (Eucl k)), ∀ b,
        Tendsto (fun m => fderiv ℝ (G m) x (e b)) atTop (𝓝 (fderiv ℝ g x (e b))) := by
      rw [ae_all_iff]
      intro b
      filter_upwards [hψae _ (hloc (e b))] with x hx
      simp_rw [happly]
      exact hx
    -- `‖T‖ ≤ Σ_b |T e_b|`, writing `z = Σ_b z_b e_b` with `|z_b| ≤ |z|`.
    have hnorm : ∀ T : Eucl k →L[ℝ] ℝ, ‖T‖ ≤ ∑ b, |T (e b)| := by
      intro T
      refine ContinuousLinearMap.opNorm_le_bound _
        (Finset.sum_nonneg fun b _ => abs_nonneg _) fun z => ?_
      have hz : z = ∑ b, z b • e b := by
        simpa [he] using ((EuclideanSpace.basisFun (Fin k) ℝ).sum_repr z).symm
      calc ‖T z‖ = ‖∑ b, z b * T (e b)‖ := by
            conv_lhs => rw [hz]
            simp [map_sum, map_smul]
        _ ≤ ∑ b, ‖z b * T (e b)‖ := norm_sum_le _ _
        _ = ∑ b, ‖z b‖ * |T (e b)| := by simp [norm_mul]
        _ ≤ ∑ b, ‖z‖ * |T (e b)| := Finset.sum_le_sum fun b _ =>
            mul_le_mul_of_nonneg_right (PiLp.norm_apply_le z b) (abs_nonneg _)
        _ = (∑ b, |T (e b)|) * ‖z‖ := by rw [← Finset.mul_sum, mul_comm]
    -- Squeeze: `‖DG_m(x) − Dg(x)‖ ≤ Σ_b |DG_m(x) e_b − Dg(x) e_b| → 0`.
    filter_upwards [hae] with x hx
    rw [tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero (fun m => norm_nonneg _) (fun m => hnorm _) ?_
    have hsum : Tendsto (fun m => ∑ b, |(fderiv ℝ (G m) x - fderiv ℝ g x) (e b)|) atTop
        (𝓝 (∑ b, |fderiv ℝ g x (e b) - fderiv ℝ g x (e b)|)) := by
      refine tendsto_finsetSum _ fun b _ => ?_
      simp only [sub_apply]
      exact ((hx b).sub_const _).abs
    simpa using hsum

/-- **Integration by parts for the Jacobian minors of a Lipschitz map** (the divergence form of
the minors; cf. J. M. Ball, ARMA 63 (1977)).  Let `v` be `C`-Lipschitz on the open set `Ω`,
`φ ∈ C¹_c(Ω)`, `M = det (∂_{b s} v^{a t})_{t,s}` the `(r+1) × (r+1)` minor with rows `a` and
columns `b`, and `C_q = (-1)^q det (∂_{b (q.succAbove s)} v^{a t.succ})_{t,s}` its cofactors
along the first row.  Then `∫_Ω φ M = -∑_q ∫_Ω v^{a 0} C_q ∂_{b q} φ`.

Extend each coordinate `v^c|_Ω` to a `C`-Lipschitz `ṽ^c` on `ℝ^k` (McShane) and mollify it
(`lipschitz_smooth_approx`): `G^c_m` is `C^∞` and `C`-Lipschitz, `G^c_m → ṽ^c` uniformly and
`DG^c_m → Dṽ^c` a.e.  The identity holds on `ℝ^k` for the rows `G^{a t}_m` (`minor_ibp_smooth`);
the matrix entries are bounded by `C` and converge a.e., and the scalar factors are dominated by
`|φ|` resp. `(|ṽ^{a 0}| + 1) |∂_{b q} φ|` for large `m`, so it passes to the limit
(`mil_tendsto_integral_mul_det`).  Finally `Dṽ^c = proj_c ∘ Dv` a.e. on `Ω`
(`mil_ae_fderiv_eq_proj`), `ṽ^c = v^c` on `Ω`, and every integrand vanishes off
`tsupport φ ⊆ Ω`. -/
theorem Submission.deformation_ipl_mwc_minor_ibp_lipschitz : ∀ (k Q r : ℕ) (Ω : Set (Eucl k)) (C : ℝ≥0) (a : Fin (r + 1) → Fin Q) (b : Fin (r + 1) → Fin k) (v : Eucl k → Eucl Q) (φ : Eucl k → ℝ), IsOpen Ω → LipschitzOnWith C v Ω → ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ Ω → ∫ w in Ω, φ w * Matrix.det (Matrix.of fun t s : Fin (r + 1) => EuclideanSpace.proj (a t) (fderiv ℝ v w (EuclideanSpace.single (b s) 1))) ∂(volume : Measure (Eucl k)) = -∑ q : Fin (r + 1), ∫ w in Ω, EuclideanSpace.proj (a 0) (v w) * ((-1 : ℝ) ^ (q : ℕ) * Matrix.det (Matrix.of fun t s : Fin r => EuclideanSpace.proj (a t.succ) (fderiv ℝ v w (EuclideanSpace.single (b (q.succAbove s)) 1)))) * fderiv ℝ φ w (EuclideanSpace.single (b q) 1) ∂(volume : Measure (Eucl k)) := by
  intro k Q r Ω C a b v φ hΩ hv hφ hφc hφΩ
  -- Step 1 (McShane): `v^c = proj_c ∘ v` is `C`-Lipschitz on `Ω`, so it extends to a
  -- `C`-Lipschitz `ṽ^c` on `ℝ^k` with `ṽ^c = v^c` on `Ω`.
  have hvc : ∀ c : Fin Q, LipschitzOnWith C (fun w => EuclideanSpace.proj c (v w)) Ω := by
    intro c
    refine LipschitzOnWith.of_dist_le_mul fun x hx y hy => ?_
    calc dist (EuclideanSpace.proj c (v x)) (EuclideanSpace.proj c (v y))
          = ‖(v x - v y) c‖ := by simp [dist_eq_norm]
      _ ≤ ‖v x - v y‖ := PiLp.norm_apply_le _ _
      _ = dist (v x) (v y) := (dist_eq_norm _ _).symm
      _ ≤ C * dist x y := hv.dist_le_mul x hx y hy
  choose vt hvtl hvteq using fun c => (hvc c).extend_real
  -- Step 2: `C^∞`, `C`-Lipschitz `G^c_m → ṽ^c` uniformly, with `DG^c_m → Dṽ^c` a.e.
  choose G hGs hGl hGu hGd using fun c =>
    Submission.deformation_ipl_mwc_lipschitz_smooth_approx k C (vt c) (hvtl c)
  -- Step 3: the smooth identity `(S_m)` for the rows `V^m_t = G^{a t}_m`.
  have hS : ∀ m : ℕ, ∫ w, φ w * Matrix.det (Matrix.of fun t s : Fin (r + 1) =>
        fderiv ℝ (G (a t) m) w (EuclideanSpace.single (b s) 1)) =
      -∑ q : Fin (r + 1), ∫ w, G (a 0) m w * ((-1 : ℝ) ^ (q : ℕ) *
        Matrix.det (Matrix.of fun t s : Fin r =>
          fderiv ℝ (G (a t.succ) m) w (EuclideanSpace.single (b (q.succAbove s)) 1))) *
        fderiv ℝ φ w (EuclideanSpace.single (b q) 1) := fun m =>
    Submission.deformation_ipl_mwc_minor_ibp_smooth k r (fun t => G (a t) m) b φ
      (fun t => (hGs (a t) m).of_le (WithTop.coe_le_coe.2 le_top)) hφ hφc
  -- Step 4: the entries `∂_i g` of a `C`-Lipschitz `g` are bounded by `C`, and those of `G^c_m`
  -- converge a.e. to those of `ṽ^c`.
  have hent : ∀ g : Eucl k → ℝ, LipschitzWith C g → ∀ (i : Fin k) (w : Eucl k),
      |fderiv ℝ g w (EuclideanSpace.single i 1)| ≤ C := by
    intro g hg i w
    calc |fderiv ℝ g w (EuclideanSpace.single i 1)|
        ≤ ‖fderiv ℝ g w‖ * ‖EuclideanSpace.single i (1 : ℝ)‖ :=
          (fderiv ℝ g w).le_opNorm _
      _ ≤ C := by simpa using norm_fderiv_le_of_lipschitz ℝ hg (x₀ := w)
  have hconv : ∀ᵐ w ∂(volume : Measure (Eucl k)), ∀ (c : Fin Q) (i : Fin k),
      Tendsto (fun m => fderiv ℝ (G c m) w (EuclideanSpace.single i 1)) atTop
        (𝓝 (fderiv ℝ (vt c) w (EuclideanSpace.single i 1))) := by
    filter_upwards [ae_all_iff.2 hGd] with w hw c i
    exact ((continuous_id.clm_apply continuous_const).tendsto _).comp (hw c)
  -- Step 5: dominated convergence on both sides of `(S_m)`.
  have hφcont : Continuous φ := hφ.continuous
  have hL := Submission.deformation_ipl_mwc_mil_tendsto_integral_mul_det (Eucl k) volume (r + 1)
    C (fun m t s w => fderiv ℝ (G (a t) m) w (EuclideanSpace.single (b s) 1))
    (fun t s w => fderiv ℝ (vt (a t)) w (EuclideanSpace.single (b s) 1)) (fun _ => φ) φ
    (fun w => |φ w|) (fun m t s => (measurable_fderiv_apply_const ℝ _ _).aestronglyMeasurable)
    (fun _ => hφcont.aestronglyMeasurable) (hφcont.integrable_of_hasCompactSupport hφc).abs
    (fun m t s w => hent _ (hGl _ m) _ w) (Eventually.of_forall fun _ _ => le_rfl)
    (ae_of_all _ fun _ => tendsto_const_nhds) (hconv.mono fun w hw t s => hw _ _)
  have hR : ∀ q : Fin (r + 1), Tendsto (fun m => ∫ w, G (a 0) m w * ((-1 : ℝ) ^ (q : ℕ) *
        Matrix.det (Matrix.of fun t s : Fin r =>
          fderiv ℝ (G (a t.succ) m) w (EuclideanSpace.single (b (q.succAbove s)) 1))) *
        fderiv ℝ φ w (EuclideanSpace.single (b q) 1)) atTop
      (𝓝 (∫ w, vt (a 0) w * ((-1 : ℝ) ^ (q : ℕ) *
        Matrix.det (Matrix.of fun t s : Fin r =>
          fderiv ℝ (vt (a t.succ)) w (EuclideanSpace.single (b (q.succAbove s)) 1))) *
        fderiv ℝ φ w (EuclideanSpace.single (b q) 1))) := by
    intro q
    have hdφ : Continuous fun w => fderiv ℝ φ w (EuclideanSpace.single (b q) 1) :=
      (hφ.continuous_fderiv one_ne_zero).clm_apply continuous_const
    have hdφs : HasCompactSupport fun w => fderiv ℝ φ w (EuclideanSpace.single (b q) 1) :=
      hφc.fderiv_apply ℝ _
    -- The majorant `(|ṽ^{a 0}| + 1) |∂_{b q} φ|` is continuous with compact support.
    have hH : Integrable (fun w => (|vt (a 0) w| + 1) *
        |fderiv ℝ φ w (EuclideanSpace.single (b q) 1)|) (volume : Measure (Eucl k)) :=
      (((hvtl (a 0)).continuous.abs.add continuous_const).mul
        hdφ.abs).integrable_of_hasCompactSupport hdφs.abs.mul_left
    -- `|G^{a 0}_m| ≤ |ṽ^{a 0}| + 1` as soon as `sup |G^{a 0}_m − ṽ^{a 0}| < 1`.
    have hbd : ∀ᶠ m in atTop, ∀ w, |(-1 : ℝ) ^ (q : ℕ) * G (a 0) m w *
        fderiv ℝ φ w (EuclideanSpace.single (b q) 1)| ≤
        (|vt (a 0) w| + 1) * |fderiv ℝ φ w (EuclideanSpace.single (b q) 1)| := by
      filter_upwards [Metric.tendstoUniformly_iff.1 (hGu (a 0)) 1 one_pos] with m hm w
      have hd := hm w
      rw [Real.dist_eq, abs_sub_comm] at hd
      have h1 : |G (a 0) m w| ≤ |vt (a 0) w| + 1 := by
        linarith [abs_sub_abs_le_abs_sub (G (a 0) m w) (vt (a 0) w)]
      rw [abs_mul, abs_mul, abs_pow, abs_neg, abs_one, one_pow, one_mul]
      exact mul_le_mul_of_nonneg_right h1 (abs_nonneg _)
    have key := Submission.deformation_ipl_mwc_mil_tendsto_integral_mul_det (Eucl k) volume r C
      (fun m t s w => fderiv ℝ (G (a t.succ) m) w (EuclideanSpace.single (b (q.succAbove s)) 1))
      (fun t s w => fderiv ℝ (vt (a t.succ)) w (EuclideanSpace.single (b (q.succAbove s)) 1))
      (fun m w => (-1 : ℝ) ^ (q : ℕ) * G (a 0) m w *
        fderiv ℝ φ w (EuclideanSpace.single (b q) 1))
      (fun w => (-1 : ℝ) ^ (q : ℕ) * vt (a 0) w * fderiv ℝ φ w (EuclideanSpace.single (b q) 1))
      _ (fun m t s => (measurable_fderiv_apply_const ℝ _ _).aestronglyMeasurable)
      (fun m => ((continuous_const.mul (hGs (a 0) m).continuous).mul hdφ).aestronglyMeasurable)
      hH (fun m t s w => hent _ (hGl _ m) _ w) hbd
      (ae_of_all _ fun w => (tendsto_const_nhds.mul ((hGu (a 0)).tendsto_at w)).mul
        tendsto_const_nhds)
      (hconv.mono fun w hw t s => hw _ _)
    convert key using 2 with m <;>
      exact integral_congr_ae (Eventually.of_forall fun w => by beta_reduce; ring)
  -- `(S)`: by uniqueness of limits, `(S_m)` passes to the limit `m → ∞`.
  have hlim := tendsto_nhds_unique hL
    (((tendsto_finsetSum _ fun q _ => hR q).neg).congr fun m => (hS m).symm)
  -- Step 6: back to `v` on `Ω`.  For a.e. `w ∈ Ω`, `Dṽ^c(w) = proj_c ∘ Dv(w)`.
  have hae : ∀ᵐ w ∂(volume : Measure (Eucl k)), w ∈ Ω → ∀ (c : Fin Q) (x : Eucl k),
      fderiv ℝ (vt c) w x = EuclideanSpace.proj c (fderiv ℝ v w x) := by
    filter_upwards [ae_all_iff.2 fun c => Submission.deformation_ipl_mwc_mil_ae_fderiv_eq_proj
      k Q Ω C v c (vt c) hΩ hv (hvteq c).symm] with w hw hwΩ c x
    exact hw c hwΩ x
  -- `φ` and `Dφ` vanish off `tsupport φ ⊆ Ω`, so the integrals over `ℝ^k` are over `Ω`.
  have hφ0 : ∀ w, w ∉ Ω → φ w = 0 := fun w hw =>
    image_eq_zero_of_notMem_tsupport fun h => hw (hφΩ h)
  have hdφ0 : ∀ w, w ∉ Ω → fderiv ℝ φ w = 0 := fun w hw =>
    fderiv_of_notMem_tsupport ℝ fun h => hw (hφΩ h)
  have hΩint : ∀ F F' : Eucl k → ℝ, (∀ w, w ∉ Ω → F' w = 0) →
      (∀ᵐ w ∂(volume : Measure (Eucl k)), w ∈ Ω → F w = F' w) → ∫ w in Ω, F w = ∫ w, F' w :=
    fun F F' h0 hFF' => (setIntegral_congr_ae hΩ.measurableSet hFF').trans
      (setIntegral_eq_integral_of_forall_compl_eq_zero h0)
  refine (hΩint _ _ (fun w hw => ?_) ?_).trans (hlim.trans ?_)
  · simp [hφ0 w hw]
  · filter_upwards [hae] with w hw hwΩ
    simp only [hw hwΩ]
  · congr 1
    refine Finset.sum_congr rfl fun q _ => (hΩint _ _ (fun w hw => ?_) ?_).symm
    · simp [hdφ0 w hw]
    · filter_upwards [hae] with w hw hwΩ
      have h0 : vt (a 0) w = EuclideanSpace.proj (a 0) (v w) := (hvteq (a 0) hwΩ).symm
      simp only [hw hwΩ, h0]

/-- Smooth test functions suffice (step (3.0) of the proof of `minor_weak_continuity`): if
`Ω ⊆ ℝᵏ` is open, `|f_j|, |f₀| ≤ B` on `Ω` and `∫_Ω φ f_j → ∫_Ω φ f₀` for every `φ ∈ C¹_c(Ω)`, then
`∫_Ω η f_j → ∫_Ω η f₀` for every `η ∈ L¹(Ω)`.  Given `δ > 0`, choose `ε > 0` with
`2 |B| ε ≤ δ / 2` and, by `scalar_smooth_dense`, `φ ∈ C_c^∞(Ω)` with `∫_Ω |η − φ| < ε`.  Then
`|∫_Ω η g − ∫_Ω φ g| ≤ |B| ∫_Ω |η − φ| ≤ |B| ε` for `g = f_j, f₀`, so for large `j`
`|∫_Ω η f_j − ∫_Ω η f₀| ≤ |B| ε + |∫_Ω φ f_j − ∫_Ω φ f₀| + |B| ε < δ`. -/
theorem Submission.deformation_ipl_mwc_test_density : ∀ (k : ℕ) (Ω : Set (Eucl k)) (B : ℝ) (f : ℕ → Eucl k → ℝ) (f₀ : Eucl k → ℝ), IsOpen Ω → (∀ j, AEStronglyMeasurable (f j) ((volume : Measure (Eucl k)).restrict Ω)) → AEStronglyMeasurable f₀ ((volume : Measure (Eucl k)).restrict Ω) → (∀ j, ∀ w ∈ Ω, |f j w| ≤ B) → (∀ w ∈ Ω, |f₀ w| ≤ B) → (∀ φ : Eucl k → ℝ, ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ Ω → Tendsto (fun j => ∫ w in Ω, φ w * f j w ∂(volume : Measure (Eucl k))) atTop (𝓝 (∫ w in Ω, φ w * f₀ w ∂(volume : Measure (Eucl k))))) → ∀ η : Eucl k → ℝ, IntegrableOn η Ω (volume : Measure (Eucl k)) → Tendsto (fun j => ∫ w in Ω, η w * f j w ∂(volume : Measure (Eucl k))) atTop (𝓝 (∫ w in Ω, η w * f₀ w ∂(volume : Measure (Eucl k)))) := by
  intro k Ω B f f₀ hΩ hfm hf₀m hfB hf₀B hφ η hη
  -- Step 2: `ζ g ∈ L¹(Ω)` for `ζ ∈ L¹(Ω)` and `g` bounded by `B` (hence by `|B|`) on `Ω`.
  have hint : ∀ ζ g : Eucl k → ℝ, IntegrableOn ζ Ω (volume : Measure (Eucl k)) →
      AEStronglyMeasurable g ((volume : Measure (Eucl k)).restrict Ω) → (∀ w ∈ Ω, |g w| ≤ B) →
      IntegrableOn (fun w => ζ w * g w) Ω (volume : Measure (Eucl k)) := fun ζ g hζ hg hgB =>
    Integrable.mul_bdd hζ hg (ae_restrict_of_forall_mem hΩ.measurableSet fun w hw =>
      (hgB w hw).trans (le_abs_self B))
  rw [Metric.tendsto_atTop]
  intro δ hδ
  -- Step 3: `ε > 0` with `2 |B| ε ≤ δ / 2` (`|B|` avoids the case split `Ω = ∅`).
  obtain ⟨ε, hε0, hBε⟩ : ∃ ε : ℝ, 0 < ε ∧ |B| * ε ≤ δ / 4 := by
    refine ⟨δ / (4 * (|B| + 1)), by positivity, ?_⟩
    rw [mul_div_assoc', div_le_div_iff₀ (by positivity) (by positivity)]
    nlinarith [abs_nonneg B]
  -- Step 1 (the sibling `scalar_smooth_dense`): `φ ∈ C_c^∞(Ω)` with `∫_Ω |η − φ| < ε`.
  obtain ⟨φ, hφs, hφc, hφΩ, hηφ⟩ :=
    Submission.deformation_ipl_mwc_td_scalar_smooth_dense k Ω η hΩ hη ε hε0
  have hφi : IntegrableOn φ Ω (volume : Measure (Eucl k)) :=
    (hφs.continuous.integrable_of_hasCompactSupport hφc).integrableOn
  -- `|∫_Ω η g − ∫_Ω φ g| ≤ |B| ∫_Ω |η − φ| ≤ |B| ε` for `g` bounded by `B` on `Ω`.
  have happrox : ∀ g : Eucl k → ℝ,
      AEStronglyMeasurable g ((volume : Measure (Eucl k)).restrict Ω) → (∀ w ∈ Ω, |g w| ≤ B) →
      dist (∫ w in Ω, η w * g w ∂(volume : Measure (Eucl k)))
        (∫ w in Ω, φ w * g w ∂(volume : Measure (Eucl k))) ≤ |B| * ε := by
    intro g hg hgB
    rw [dist_eq_norm, ← integral_sub (hint η g hη hg hgB) (hint φ g hφi hg hgB)]
    calc ‖∫ w in Ω, η w * g w - φ w * g w ∂(volume : Measure (Eucl k))‖
        ≤ ∫ w in Ω, |B| * |η w - φ w| ∂(volume : Measure (Eucl k)) := by
          refine norm_integral_le_of_norm_le ((hη.sub hφi).abs.const_mul |B|)
            (ae_restrict_of_forall_mem hΩ.measurableSet fun w hw => ?_)
          rw [← sub_mul, Real.norm_eq_abs, abs_mul, mul_comm]
          exact mul_le_mul_of_nonneg_right ((hgB w hw).trans (le_abs_self B)) (abs_nonneg _)
      _ = |B| * ∫ w in Ω, |η w - φ w| ∂(volume : Measure (Eucl k)) := integral_const_mul _ _
      _ ≤ |B| * ε := mul_le_mul_of_nonneg_left hηφ.le (abs_nonneg B)
  -- The hypothesis for `φ ∈ C¹_c(Ω)`, then the `ε/3` estimate.
  obtain ⟨N, hN⟩ := Metric.tendsto_atTop.1
    (hφ φ (hφs.of_le (WithTop.coe_le_coe.2 le_top)) hφc hφΩ) (δ / 2) (half_pos hδ)
  refine ⟨N, fun j hj => ?_⟩
  have h₁ := happrox (f j) (hfm j) (hfB j)
  have h₂ := hN j hj
  have h₃ := happrox f₀ hf₀m hf₀B
  rw [dist_comm] at h₃
  linarith [dist_triangle4 (∫ w in Ω, η w * f j w ∂(volume : Measure (Eucl k)))
    (∫ w in Ω, φ w * f j w ∂(volume : Measure (Eucl k)))
    (∫ w in Ω, φ w * f₀ w ∂(volume : Measure (Eucl k)))
    (∫ w in Ω, η w * f₀ w ∂(volume : Measure (Eucl k)))]

/-- Weak-* continuity of the Jacobian minors (step 3 of the proof of `minor_weak_continuity`;
J. M. Ball, ARMA 63 (1977); Fonseca–Leoni–Malý, ARMA 178 (2005)).  Let `v_j, v₀` be
`C`-Lipschitz on the open set `Ω` with `v_j → v₀` uniformly on `Ω`, and let
`M_{a,b}(u) = det (⟨e_{a t}, Du (e_{b s})⟩)_{t,s}` be the `r × r` minor with rows `a` and
columns `b`.  Then `∫_Ω η M_{a,b}(v_j) → ∫_Ω η M_{a,b}(v₀)` for every `η ∈ L¹(Ω)`.

Induction on `r`; for `r = 0` both sides equal `∫_Ω η`.  For `r + 1`, `‖Du‖ ≤ C` on `Ω` gives
`|M_{a,b}(u)| ≤ (r+1)! C^{r+1}` there, so by `test_density` it suffices to test against
`φ ∈ C¹_c(Ω)`.  By `minor_ibp_lipschitz`,
`∫_Ω φ M_{a,b}(u) = -∑_q ∫_Ω u^{a 0} (-1)^q M_{a',b^{(q)}}(u) ∂_{b q} φ` with `a' = a ∘ succ`,
`b^{(q)} = b ∘ q.succAbove`.  In each term the part carrying `v_j^{a 0} - v₀^{a 0} → 0`
(uniformly on `Ω`, while `|M_{a',b^{(q)}}| ≤ r! C^r`) tends to `0`, and the induction hypothesis
applies to the rest, tested against `η_q = v₀^{a 0} ∂_{b q} φ ∈ L¹(Ω)`. -/
theorem Submission.deformation_ipl_mwc_minor_weak_star :
    ∀ (k Q : ℕ) (Ω : Set (Eucl k)) (C : ℝ≥0) (v : ℕ → Eucl k → Eucl Q) (v₀ : Eucl k → Eucl Q),
      IsOpen Ω → (∀ j, LipschitzOnWith C (v j) Ω) → LipschitzOnWith C v₀ Ω →
      TendstoUniformlyOn v v₀ atTop Ω → ∀ (r : ℕ) (a : Fin r → Fin Q) (b : Fin r → Fin k)
      (η : Eucl k → ℝ), IntegrableOn η Ω (volume : Measure (Eucl k)) →
      Tendsto (fun j => ∫ w in Ω, η w * Matrix.det (Matrix.of fun t s : Fin r =>
          EuclideanSpace.proj (a t) (fderiv ℝ (v j) w (EuclideanSpace.single (b s) 1)))
            ∂(volume : Measure (Eucl k))) atTop
        (𝓝 (∫ w in Ω, η w * Matrix.det (Matrix.of fun t s : Fin r =>
          EuclideanSpace.proj (a t) (fderiv ℝ v₀ w (EuclideanSpace.single (b s) 1)))
            ∂(volume : Measure (Eucl k)))) := by
  intro k Q Ω C v v₀ hΩ hv hv₀ hconv r
  /- Step 0: bounds and measurability.  Leibniz formula: `|det A| ≤ n! c^n` if all
  `|A t s| ≤ c` (`Matrix.det_le` is not imported). -/
  have abs_det_le : ∀ {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (c : ℝ),
      (∀ t s, |A t s| ≤ c) → |A.det| ≤ (Nat.factorial n : ℝ) * c ^ n := by
    intro n A c hA
    rw [Matrix.det_apply]
    calc |∑ σ : Equiv.Perm (Fin n), Equiv.Perm.sign σ • ∏ i, A (σ i) i|
        ≤ ∑ σ : Equiv.Perm (Fin n), |Equiv.Perm.sign σ • ∏ i, A (σ i) i| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _σ : Equiv.Perm (Fin n), c ^ n := by
          gcongr with σ
          have hσ : |Equiv.Perm.sign σ • ∏ i, A (σ i) i| = |∏ i, A (σ i) i| := by
            rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h | h <;> simp [h]
          rw [hσ, Finset.abs_prod]
          calc ∏ i, |A (σ i) i| ≤ ∏ _i : Fin n, c := by
                gcongr with i
                exact hA _ _
            _ = c ^ n := by simp
      _ = (Nat.factorial n : ℝ) * c ^ n := by simp [Fintype.card_perm]
  -- If `u` is `C`-Lipschitz on `Ω`, then `‖Du‖ ≤ C` on `Ω`, so every entry of a minor is
  -- bounded by `C` and `|M_{a,b}(u)| ≤ n! C^n` on `Ω`; every minor is Borel measurable.
  have minor_facts : ∀ {n : ℕ} (a : Fin n → Fin Q) (b : Fin n → Fin k) (u : Eucl k → Eucl Q),
      LipschitzOnWith C u Ω →
      (∀ w ∈ Ω, |Matrix.det (Matrix.of fun t s : Fin n => EuclideanSpace.proj (a t)
          (fderiv ℝ u w (EuclideanSpace.single (b s) 1)))| ≤ (Nat.factorial n : ℝ) * (C : ℝ) ^ n) ∧
      Measurable (fun w => Matrix.det (Matrix.of fun t s : Fin n => EuclideanSpace.proj (a t)
          (fderiv ℝ u w (EuclideanSpace.single (b s) 1)))) := by
    intro n a b u hu
    constructor
    · intro w hw
      refine abs_det_le _ C fun t s => ?_
      have hDu : ‖fderiv ℝ u w‖ ≤ C := norm_fderiv_le_of_lipschitzOn ℝ (hΩ.mem_nhds hw) hu
      calc |EuclideanSpace.proj (a t) (fderiv ℝ u w (EuclideanSpace.single (b s) 1))|
          = ‖fderiv ℝ u w (EuclideanSpace.single (b s) 1) (a t)‖ := by simp [Real.norm_eq_abs]
        _ ≤ ‖fderiv ℝ u w (EuclideanSpace.single (b s) 1)‖ := PiLp.norm_apply_le _ _
        _ ≤ ‖fderiv ℝ u w‖ * ‖EuclideanSpace.single (b s) (1 : ℝ)‖ :=
          (fderiv ℝ u w).le_opNorm _
        _ ≤ C := by simpa using hDu
    · have hdet : Continuous fun A : Fin n → Fin n → ℝ => (Matrix.of A).det :=
        Continuous.matrix_det continuous_id
      have hent : ∀ t s : Fin n, Measurable fun w =>
          EuclideanSpace.proj (a t) (fderiv ℝ u w (EuclideanSpace.single (b s) 1)) := fun t s =>
        (EuclideanSpace.proj (a t)).continuous.measurable.comp
          (measurable_fderiv_apply_const ℝ u _)
      exact hdet.measurable.comp
        (measurable_pi_iff.2 fun t => measurable_pi_iff.2 fun s => hent t s)
  induction r with
  | zero =>
    -- Step 1: a `0 × 0` determinant is `1`, so the sequence is constant.
    intro a b η hη
    simp only [Matrix.det_isEmpty, mul_one]
    exact tendsto_const_nhds
  | succ r ih =>
    intro a b η hη
    -- `M u = M_{a,b}(u)`, the `(r + 1) × (r + 1)` minor.
    let M : (Eucl k → Eucl Q) → Eucl k → ℝ := fun u w =>
      Matrix.det (Matrix.of fun t s : Fin (r + 1) =>
        EuclideanSpace.proj (a t) (fderiv ℝ u w (EuclideanSpace.single (b s) 1)))
    -- Step 2: by `test_density` (bound `(r+1)! C^{r+1}`) it suffices to test against
    -- `φ ∈ C¹_c(Ω)`.
    refine Submission.deformation_ipl_mwc_test_density k Ω
      ((Nat.factorial (r + 1) : ℝ) * (C : ℝ) ^ (r + 1)) (fun j => M (v j)) (M v₀) hΩ
      (fun j => (minor_facts a b (v j) (hv j)).2.aestronglyMeasurable)
      (minor_facts a b v₀ hv₀).2.aestronglyMeasurable
      (fun j => (minor_facts a b (v j) (hv j)).1) (minor_facts a b v₀ hv₀).1 ?_ η hη
    intro φ hφ hφc hφΩ
    -- `M' q u = M_{a',b^{(q)}}(u)`, `dφ q = ∂_{b q} φ` and `p u = u^{a 0}`.
    let M' : Fin (r + 1) → (Eucl k → Eucl Q) → Eucl k → ℝ := fun q u w =>
      Matrix.det (Matrix.of fun t s : Fin r => EuclideanSpace.proj (a t.succ)
        (fderiv ℝ u w (EuclideanSpace.single (b (q.succAbove s)) 1)))
    let dφ : Fin (r + 1) → Eucl k → ℝ := fun q w => fderiv ℝ φ w (EuclideanSpace.single (b q) 1)
    let p : (Eucl k → Eucl Q) → Eucl k → ℝ := fun u w => EuclideanSpace.proj (a 0) (u w)
    -- Step 3: integration by parts (`minor_ibp_lipschitz`) for `u = v_j` and `u = v₀`.
    have hDu : ∀ u, LipschitzOnWith C u Ω →
        ∫ w in Ω, φ w * M u w ∂(volume : Measure (Eucl k)) =
          -∑ q : Fin (r + 1), ∫ w in Ω, p u w * ((-1 : ℝ) ^ (q : ℕ) * M' q u w) * dφ q w
            ∂(volume : Measure (Eucl k)) := fun u hu =>
      Submission.deformation_ipl_mwc_minor_ibp_lipschitz k Q r Ω C a b u φ hΩ hu hφ hφc hφΩ
    have hfun : (fun j => ∫ w in Ω, φ w * M (v j) w ∂(volume : Measure (Eucl k))) = fun j =>
        -∑ q : Fin (r + 1), ∫ w in Ω, p (v j) w * ((-1 : ℝ) ^ (q : ℕ) * M' q (v j) w) * dφ q w
          ∂(volume : Measure (Eucl k)) := funext fun j => hDu _ (hv j)
    rw [hfun, hDu v₀ hv₀]
    refine (tendsto_finsetSum _ fun q _ => ?_).neg
    -- `dφ q` is continuous, vanishes off the compact `K = tsupport φ ⊆ Ω` and is integrable.
    set K := tsupport φ with hK
    have hKc : IsCompact K := hφc
    have hdφc : Continuous (dφ q) :=
      (hφ.continuous_fderiv one_ne_zero).clm_apply continuous_const
    have hdφ0 : ∀ w, w ∉ K → dφ q w = 0 := by
      intro w hw
      have : fderiv ℝ φ w = 0 := by
        by_contra h
        exact hw (support_fderiv_subset ℝ (Function.mem_support.2 h))
      simp [dφ, this]
    have hdφsupp : HasCompactSupport (dφ q) :=
      HasCompactSupport.of_support_subset_isCompact hKc fun w hw => by
        by_contra h; exact hw (hdφ0 w h)
    have hdφint : Integrable (dφ q) (volume : Measure (Eucl k)) :=
      hdφc.integrable_of_hasCompactSupport hdφsupp
    -- `p u` is bounded on `K` and measurable on `Ω`; `|M' q u| ≤ B' = r! C^r` on `Ω`.
    have hpbd : ∀ u, LipschitzOnWith C u Ω → ∃ P : ℝ, 0 ≤ P ∧ ∀ w ∈ K, |p u w| ≤ P := by
      intro u hu
      obtain ⟨P, hP⟩ := hKc.exists_bound_of_continuousOn
        (((EuclideanSpace.proj (a 0)).continuous.comp_continuousOn hu.continuousOn).mono hφΩ)
      refine ⟨max P 0, le_max_right _ _, fun w hw => le_trans ?_ (le_max_left _ _)⟩
      have := hP w hw
      simp only [Function.comp_apply, Real.norm_eq_abs] at this
      exact this
    have hpm : ∀ u, LipschitzOnWith C u Ω →
        AEStronglyMeasurable (p u) ((volume : Measure (Eucl k)).restrict Ω) := fun u hu =>
      ((EuclideanSpace.proj (a 0)).continuous.comp_continuousOn
        hu.continuousOn).aestronglyMeasurable hΩ.measurableSet
    have hM'b : ∀ u, LipschitzOnWith C u Ω →
        ∀ w ∈ Ω, |M' q u w| ≤ (Nat.factorial r : ℝ) * (C : ℝ) ^ r :=
      fun u hu => (minor_facts (fun t => a t.succ) (fun s => b (q.succAbove s)) u hu).1
    have hM'm : ∀ u, LipschitzOnWith C u Ω → Measurable (M' q u) :=
      fun u hu => (minor_facts (fun t => a t.succ) (fun s => b (q.succAbove s)) u hu).2
    set B' : ℝ := (Nat.factorial r : ℝ) * (C : ℝ) ^ r with hB'
    have hB'0 : 0 ≤ B' := by positivity
    -- Step 4: anything a.e.-measurable on `Ω` and bounded by `c |dφ q|` there is integrable.
    have hint : ∀ (F : Eucl k → ℝ) (c : ℝ),
        AEStronglyMeasurable F ((volume : Measure (Eucl k)).restrict Ω) →
        (∀ w ∈ Ω, |F w| ≤ c * |dφ q w|) → IntegrableOn F Ω (volume : Measure (Eucl k)) := by
      intro F c hFm hFb
      refine Integrable.mono' ((hdφint.abs.const_mul c).integrableOn) hFm ?_
      exact (ae_restrict_iff' hΩ.measurableSet).2 (ae_of_all _ fun w hw => by
        simpa [Real.norm_eq_abs] using hFb w hw)
    let ηq : Eucl k → ℝ := fun w => p v₀ w * dφ q w
    obtain ⟨P0, hP00, hP0⟩ := hpbd v₀ hv₀
    have hηq : IntegrableOn ηq Ω (volume : Measure (Eucl k)) := by
      refine hint ηq P0 ((hpm v₀ hv₀).mul hdφc.aestronglyMeasurable.restrict) fun w hw => ?_
      by_cases hwK : w ∈ K
      · rw [abs_mul]; exact mul_le_mul_of_nonneg_right (hP0 w hwK) (abs_nonneg _)
      · simp [ηq, hdφ0 w hwK]
    have hI1 : ∀ j, IntegrableOn (fun w => (p (v j) w - p v₀ w) *
        ((-1 : ℝ) ^ (q : ℕ) * M' q (v j) w) * dφ q w) Ω (volume : Measure (Eucl k)) := by
      intro j
      obtain ⟨Pj, hPj0, hPj⟩ := hpbd (v j) (hv j)
      refine hint _ ((Pj + P0) * B') ((((hpm _ (hv j)).sub (hpm _ hv₀)).mul
        ((hM'm _ (hv j)).aestronglyMeasurable.const_mul _)).mul
          hdφc.aestronglyMeasurable.restrict) ?_
      intro w hw
      by_cases hwK : w ∈ K
      · rw [abs_mul, abs_mul, abs_mul, abs_pow, abs_neg, abs_one, one_pow, one_mul]
        gcongr
        · exact (abs_sub _ _).trans (add_le_add (hPj w hwK) (hP0 w hwK))
        · exact hM'b _ (hv j) w hw
      · simp [hdφ0 w hwK]
    have hI2 : ∀ u, LipschitzOnWith C u Ω →
        IntegrableOn (fun w => ηq w * M' q u w) Ω (volume : Measure (Eucl k)) := by
      intro u hu
      refine hint _ (P0 * B') ((hpm v₀ hv₀).mul hdφc.aestronglyMeasurable.restrict
        |>.mul (hM'm _ hu).aestronglyMeasurable) ?_
      intro w hw
      by_cases hwK : w ∈ K
      · simp only [ηq, abs_mul]
        calc |p v₀ w| * |dφ q w| * |M' q u w| ≤ P0 * |dφ q w| * B' := by
              gcongr
              · exact hP0 w hwK
              · exact hM'b _ hu w hw
          _ = P0 * B' * |dφ q w| := by ring
      · simp [ηq, hdφ0 w hwK]
    -- Step 5: `I_j = ∫_Ω (v_j^{a 0} - v₀^{a 0}) (-1)^q M'_j dφ + (-1)^q ∫_Ω η_q M'_j`.
    have hsplit : ∀ j, ∫ w in Ω, p (v j) w * ((-1 : ℝ) ^ (q : ℕ) * M' q (v j) w) * dφ q w
        ∂(volume : Measure (Eucl k)) =
        (∫ w in Ω, (p (v j) w - p v₀ w) * ((-1 : ℝ) ^ (q : ℕ) * M' q (v j) w) * dφ q w
          ∂(volume : Measure (Eucl k))) +
          (-1 : ℝ) ^ (q : ℕ) * ∫ w in Ω, ηq w * M' q (v j) w ∂(volume : Measure (Eucl k)) := by
      intro j
      rw [← integral_const_mul, ← integral_add (hI1 j) ((hI2 _ (hv j)).const_mul _)]
      congr 1; funext w; simp only [ηq]; ring
    have hlim : ∫ w in Ω, p v₀ w * ((-1 : ℝ) ^ (q : ℕ) * M' q v₀ w) * dφ q w
        ∂(volume : Measure (Eucl k)) =
        0 + (-1 : ℝ) ^ (q : ℕ) * ∫ w in Ω, ηq w * M' q v₀ w ∂(volume : Measure (Eucl k)) := by
      rw [zero_add, ← integral_const_mul]
      congr 1; funext w; simp only [ηq]; ring
    -- Step 6: the first term tends to `0`, as `p (v j) → p v₀` uniformly on `Ω`.
    have h1 : Tendsto (fun j => ∫ w in Ω, (p (v j) w - p v₀ w) *
        ((-1 : ℝ) ^ (q : ℕ) * M' q (v j) w) * dφ q w ∂(volume : Measure (Eucl k))) atTop
        (𝓝 0) := by
      rw [Metric.tendsto_atTop]
      intro ε hε
      set I := ∫ w, |dφ q w| ∂(volume : Measure (Eucl k)) with hI
      have hI0 : 0 ≤ I := integral_nonneg fun w => abs_nonneg _
      set δ := ε / (2 * (B' * I + 1)) with hδ
      have hδ0 : 0 < δ := by positivity
      obtain ⟨N, hN⟩ := eventually_atTop.1 (Metric.tendstoUniformlyOn_iff.1 hconv δ hδ0)
      refine ⟨N, fun j hj => ?_⟩
      rw [dist_zero_right]
      have hbound : ∀ᵐ w ∂((volume : Measure (Eucl k)).restrict Ω),
          ‖(p (v j) w - p v₀ w) * ((-1 : ℝ) ^ (q : ℕ) * M' q (v j) w) * dφ q w‖ ≤
            δ * B' * |dφ q w| := by
        refine (ae_restrict_iff' hΩ.measurableSet).2 (ae_of_all _ fun w hw => ?_)
        have e1 : |p (v j) w - p v₀ w| ≤ δ := by
          have h' := (hN j hj w hw).le
          rw [dist_comm, dist_eq_norm] at h'
          calc |p (v j) w - p v₀ w| = |EuclideanSpace.proj (a 0) (v j w - v₀ w)| := by
                simp [p]
            _ = ‖(v j w - v₀ w) (a 0)‖ := by simp [Real.norm_eq_abs]
            _ ≤ ‖v j w - v₀ w‖ := PiLp.norm_apply_le _ _
            _ ≤ δ := h'
        have e2 := hM'b _ (hv j) w hw
        rw [Real.norm_eq_abs, abs_mul, abs_mul, abs_mul, abs_pow, abs_neg, abs_one, one_pow,
          one_mul]
        gcongr
      calc ‖∫ w in Ω, (p (v j) w - p v₀ w) * ((-1 : ℝ) ^ (q : ℕ) * M' q (v j) w) * dφ q w
            ∂(volume : Measure (Eucl k))‖
          ≤ ∫ w in Ω, δ * B' * |dφ q w| ∂(volume : Measure (Eucl k)) :=
            norm_integral_le_of_norm_le ((hdφint.abs.const_mul _).integrableOn) hbound
        _ ≤ ∫ w, δ * B' * |dφ q w| ∂(volume : Measure (Eucl k)) :=
            setIntegral_le_integral (hdφint.abs.const_mul _) (ae_of_all _ fun w => by positivity)
        _ = δ * (B' * I) := by rw [integral_const_mul, hI]; ring
        _ < ε := by
            rw [hδ]
            have : 0 < B' * I + 1 := by positivity
            rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
            nlinarith
    -- Steps 7–8: the induction hypothesis, tested against `η_q ∈ L¹(Ω)`, handles the second
    -- term; multiplying by `(-1)^q` and adding the first term gives `I_j → I_0`.
    have hih := ih (fun t => a t.succ) (fun s => b (q.succAbove s)) ηq hηq
    rw [hlim]
    exact (h1.add (hih.const_mul _)).congr fun j => (hsplit j).symm

/-- Weak continuity of the Jacobian minors `M_{a,b}(u) = det (⟨e_{a t}, Du (e_{b s})⟩)_{t,s}`
against a coefficient `ψ (g ∘ u)`, `ψ ∈ L¹(Ω)`, `g ∈ C_c(ℝ^Q)` (step 2 of the proof of
`minor_weak_continuity`).  With `η = ψ (g ∘ u₀) ∈ L¹(Ω)`,
`∫_Ω ψ (g ∘ u_j) M_{a,b}(u_j) = ∫_Ω ψ (g ∘ u_j - g ∘ u₀) M_{a,b}(u_j) + ∫_Ω η M_{a,b}(u_j)`; the
first term tends to `0` because `|M_{a,b}(u_j)| ≤ r! C^r` on `Ω` and `g ∘ u_j → g ∘ u₀`
uniformly on `Ω`, the second tends to `∫_Ω η M_{a,b}(u₀)` by `minor_weak_star`. -/
theorem Submission.deformation_ipl_mwc_coeff_minor_continuity :
    ∀ (k Q : ℕ) (Ω : Set (Eucl k)) (ψ : Eucl k → ℝ) (g : Eucl Q → ℝ) (C : ℝ≥0)
      (u : ℕ → Eucl k → Eucl Q) (u₀ : Eucl k → Eucl Q) (r : ℕ) (a : Fin r → Fin Q)
      (b : Fin r → Fin k), IsOpen Ω → IntegrableOn ψ Ω (volume : Measure (Eucl k)) →
      Continuous g → HasCompactSupport g → (∀ j, LipschitzOnWith C (u j) Ω) →
      LipschitzOnWith C u₀ Ω → TendstoUniformlyOn u u₀ atTop Ω →
      Tendsto (fun j => ∫ w in Ω, ψ w * g (u j w) * Matrix.det (Matrix.of fun t s : Fin r =>
          EuclideanSpace.proj (a t) (fderiv ℝ (u j) w (EuclideanSpace.single (b s) 1)))
            ∂(volume : Measure (Eucl k))) atTop
        (𝓝 (∫ w in Ω, ψ w * g (u₀ w) * Matrix.det (Matrix.of fun t s : Fin r =>
          EuclideanSpace.proj (a t) (fderiv ℝ u₀ w (EuclideanSpace.single (b s) 1)))
            ∂(volume : Measure (Eucl k)))) := by
  intro k Q Ω ψ g C u u₀ r a b hΩ hψ hg hgc hu hu₀ hconv
  -- `M v w = M_{a,b}(v)(w)`, the `(a, b)` minor of `Dv(w)`.
  let M : (Eucl k → Eucl Q) → Eucl k → ℝ := fun v w => Matrix.det (Matrix.of fun t s : Fin r =>
    EuclideanSpace.proj (a t) (fderiv ℝ v w (EuclideanSpace.single (b s) 1)))
  /- Step 1: bounds and measurability.  Leibniz formula: `|det A| ≤ r! c^r` if all
  `|A t s| ≤ c` (`Matrix.det_le` is not imported). -/
  have abs_det_le : ∀ (A : Matrix (Fin r) (Fin r) ℝ) (c : ℝ), (∀ t s, |A t s| ≤ c) →
      |A.det| ≤ (Nat.factorial r : ℝ) * c ^ r := by
    intro A c hA
    rw [Matrix.det_apply]
    calc |∑ σ : Equiv.Perm (Fin r), Equiv.Perm.sign σ • ∏ i, A (σ i) i|
        ≤ ∑ σ : Equiv.Perm (Fin r), |Equiv.Perm.sign σ • ∏ i, A (σ i) i| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _σ : Equiv.Perm (Fin r), c ^ r := by
          gcongr with σ
          have hσ : |Equiv.Perm.sign σ • ∏ i, A (σ i) i| = |∏ i, A (σ i) i| := by
            rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h | h <;> simp [h]
          rw [hσ, Finset.abs_prod]
          calc ∏ i, |A (σ i) i| ≤ ∏ _i : Fin r, c := by
                gcongr with i
                exact hA _ _
            _ = c ^ r := by simp
      _ = (Nat.factorial r : ℝ) * c ^ r := by simp [Fintype.card_perm]
  -- On `Ω`, `‖Dv‖ ≤ C` for `v` `C`-Lipschitz on `Ω`, so every entry of the minor is `≤ C`.
  obtain ⟨B, hB0, hMb⟩ : ∃ B : ℝ, 0 ≤ B ∧
      ∀ v, LipschitzOnWith C v Ω → ∀ w ∈ Ω, |M v w| ≤ B := by
    refine ⟨(Nat.factorial r : ℝ) * (C : ℝ) ^ r, by positivity, fun v hv w hw => ?_⟩
    refine abs_det_le _ C fun t s => ?_
    have hD : ‖fderiv ℝ v w‖ ≤ C := norm_fderiv_le_of_lipschitzOn ℝ (hΩ.mem_nhds hw) hv
    calc |EuclideanSpace.proj (a t) (fderiv ℝ v w (EuclideanSpace.single (b s) 1))|
        = ‖fderiv ℝ v w (EuclideanSpace.single (b s) 1) (a t)‖ := by simp [Real.norm_eq_abs]
      _ ≤ ‖fderiv ℝ v w (EuclideanSpace.single (b s) 1)‖ := PiLp.norm_apply_le _ _
      _ ≤ ‖fderiv ℝ v w‖ * ‖EuclideanSpace.single (b s) (1 : ℝ)‖ := (fderiv ℝ v w).le_opNorm _
      _ ≤ C := by simpa using hD
  have hMm : ∀ v, Measurable (M v) := by
    intro v
    have hdet : Continuous fun A : Fin r → Fin r → ℝ => (Matrix.of A).det :=
      Continuous.matrix_det continuous_id
    have hent : ∀ t s : Fin r, Measurable fun w =>
        EuclideanSpace.proj (a t) (fderiv ℝ v w (EuclideanSpace.single (b s) 1)) := fun t s =>
      (EuclideanSpace.proj (a t)).continuous.measurable.comp (measurable_fderiv_apply_const ℝ v _)
    exact hdet.measurable.comp (measurable_pi_iff.2 fun t => measurable_pi_iff.2 fun s => hent t s)
  have hMbd : ∀ j, ∀ᵐ w ∂(volume : Measure (Eucl k)).restrict Ω, ‖M (u j) w‖ ≤ B := fun j =>
    (ae_restrict_iff' hΩ.measurableSet).2 (ae_of_all _ fun w hw => by
      simpa [Real.norm_eq_abs] using hMb _ (hu j) w hw)
  obtain ⟨G, hG⟩ := hg.bounded_above_of_compact_support hgc
  have hgm : ∀ v, LipschitzOnWith C v Ω →
      AEStronglyMeasurable (fun w => g (v w)) ((volume : Measure (Eucl k)).restrict Ω) :=
    fun v hv => (hg.comp_continuousOn hv.continuousOn).aestronglyMeasurable hΩ.measurableSet
  -- Step 2: integrability.
  let η : Eucl k → ℝ := fun w => ψ w * g (u₀ w)
  have hη : IntegrableOn η Ω (volume : Measure (Eucl k)) :=
    Integrable.mul_bdd hψ (hgm u₀ hu₀) (ae_of_all _ fun w => hG _)
  have hint₁ : ∀ j, IntegrableOn (fun w => ψ w * (g (u j w) - g (u₀ w)) * M (u j) w) Ω
      (volume : Measure (Eucl k)) := fun j =>
    Integrable.mul_bdd (Integrable.mul_bdd (c := G + G) hψ ((hgm _ (hu j)).sub (hgm _ hu₀))
      (ae_of_all _ fun w => (norm_sub_le _ _).trans (add_le_add (hG _) (hG _))))
      (hMm _).aestronglyMeasurable (hMbd j)
  have hint₂ : ∀ j, IntegrableOn (fun w => η w * M (u j) w) Ω (volume : Measure (Eucl k)) :=
    fun j => Integrable.mul_bdd hη (hMm _).aestronglyMeasurable (hMbd j)
  -- Step 3: `∫_Ω ψ (g ∘ u_j) M_j = D₁(j) + ∫_Ω η M_j`.
  have hsplit : ∀ j, ∫ w in Ω, ψ w * g (u j w) * M (u j) w ∂(volume : Measure (Eucl k)) =
      (∫ w in Ω, ψ w * (g (u j w) - g (u₀ w)) * M (u j) w ∂(volume : Measure (Eucl k))) +
        ∫ w in Ω, η w * M (u j) w ∂(volume : Measure (Eucl k)) := by
    intro j
    rw [← integral_add (hint₁ j) (hint₂ j)]
    congr 1
    funext w
    simp only [η]
    ring
  -- Step 4: `D₁(j) → 0`, as `g ∘ u_j → g ∘ u₀` uniformly on `Ω` and `|M_j| ≤ B` there.
  have hunif : TendstoUniformlyOn (fun j w => g (u j w)) (fun w => g (u₀ w)) atTop Ω :=
    (hgc.uniformContinuous_of_continuous hg).comp_tendstoUniformlyOn hconv
  obtain ⟨I, hI0, hI⟩ : ∃ I : ℝ, 0 ≤ I ∧ ∫ w in Ω, |ψ w| ∂(volume : Measure (Eucl k)) = I :=
    ⟨_, integral_nonneg fun w => abs_nonneg _, rfl⟩
  have hD₁ : Tendsto (fun j => ∫ w in Ω, ψ w * (g (u j w) - g (u₀ w)) * M (u j) w
      ∂(volume : Measure (Eucl k))) atTop (𝓝 0) := by
    rw [Metric.tendsto_atTop]
    intro ε hε
    have hBI : 0 < B * I + 1 := by positivity
    obtain ⟨δ, hδ0, hδε⟩ : ∃ δ : ℝ, 0 < δ ∧ δ * (B * I + 1) = ε :=
      ⟨ε / (B * I + 1), div_pos hε hBI, div_mul_cancel₀ ε hBI.ne'⟩
    obtain ⟨N, hN⟩ := eventually_atTop.1 (Metric.tendstoUniformlyOn_iff.1 hunif δ hδ0)
    refine ⟨N, fun j hj => ?_⟩
    have hbound : ∀ᵐ w ∂(volume : Measure (Eucl k)).restrict Ω,
        ‖ψ w * (g (u j w) - g (u₀ w)) * M (u j) w‖ ≤ δ * B * |ψ w| := by
      refine (ae_restrict_iff' hΩ.measurableSet).2 (ae_of_all _ fun w hw => ?_)
      have e₁ : |g (u j w) - g (u₀ w)| ≤ δ := by
        rw [← Real.dist_eq, dist_comm]
        exact (hN j hj w hw).le
      have e₂ := hMb _ (hu j) w hw
      rw [Real.norm_eq_abs, abs_mul, abs_mul]
      calc |ψ w| * |g (u j w) - g (u₀ w)| * |M (u j) w| ≤ |ψ w| * δ * B := by gcongr
        _ = δ * B * |ψ w| := by ring
    rw [dist_zero_right]
    calc ‖∫ w in Ω, ψ w * (g (u j w) - g (u₀ w)) * M (u j) w ∂(volume : Measure (Eucl k))‖
        ≤ ∫ w in Ω, δ * B * |ψ w| ∂(volume : Measure (Eucl k)) :=
          norm_integral_le_of_norm_le (hψ.abs.const_mul _) hbound
      _ = δ * (B * I) := by rw [integral_const_mul, hI]; ring
      _ < δ * (B * I + 1) := mul_lt_mul_of_pos_left (lt_add_one _) hδ0
      _ = ε := hδε
  -- Step 5: the sibling `minor_weak_star` tested against `η ∈ L¹(Ω)`.
  have hη₂ :=
    Submission.deformation_ipl_mwc_minor_weak_star k Q Ω C u u₀ hΩ hu hu₀ hconv r a b η hη
  -- Step 6: conclusion.
  have hlim := hD₁.add hη₂
  rw [zero_add] at hlim
  exact hlim.congr fun j => (hsplit j).symm

/-- **Weak continuity of `ψ · α(u)(∂₀u, …, ∂_{k−1}u)`** (weak continuity of Jacobian minors;
used for Lipschitz push-forwards as limits of C¹ push-forwards in the proof of Simon Ch. 6, 5.1,
remark after (21)).  By the covector expansion and `wedgeCovectors_apply_det`,
`α(y)(∂₀u, …, ∂_{k−1}u) = ∑_γ α_γ(y) M_γ(Du)` with `α_γ = euclideanCovectorCoordinate (α ·) γ`
and `M_γ(Du) = det(∂_s u^{γ t})`.  Each summand `ψ (α_γ ∘ u) M_γ(Du)` is integrable on `Ω`:
`α_γ` is continuous with compact support, and `‖Du‖ ≤ C` on the open set `Ω` gives
`|M_γ(Du)| = |dy^γ(Du e₀, …, Du e_{k−1})| ≤ ‖dy^γ‖ Cᵏ` there.  Each summand converges by
`deformation_ipl_mwc_coeff_minor_continuity` with `g = α_γ`, `r = k`, `a = γ`, `b = id`. -/
theorem Submission.deformation_ipl_minor_weak_continuity : ∀ (k Q : ℕ) (Ω : Set (Eucl k)) (ψ : Eucl k → ℝ) (α : Eucl Q → Covector (Eucl Q) k) (C : ℝ≥0) (u : ℕ → Eucl k → Eucl Q) (u₀ : Eucl k → Eucl Q), IsOpen Ω → IntegrableOn ψ Ω (volume : Measure (Eucl k)) → Continuous α → HasCompactSupport α → (∀ j, LipschitzOnWith C (u j) Ω) → LipschitzOnWith C u₀ Ω → TendstoUniformlyOn u u₀ atTop Ω → Tendsto (fun j => ∫ w in Ω, ψ w * α (u j w) (fun b => fderiv ℝ (u j) w (EuclideanSpace.single b 1)) ∂(volume : Measure (Eucl k))) atTop (𝓝 (∫ w in Ω, ψ w * α (u₀ w) (fun b => fderiv ℝ u₀ w (EuclideanSpace.single b 1)) ∂(volume : Measure (Eucl k)))) := by
  intro k Q Ω ψ α C u u₀ hΩ hψ hαc hαs hu hu₀ hlim
  -- Coordinate expansion: `α(y)(x) = ∑_γ α_γ(y) det(x_s^{γ t})`.
  have hexp : ∀ (y : Eucl Q) (x : Fin k → Eucl Q), α y x = ∑ γ : SimonMultiIndex k Q,
      euclideanCovectorCoordinate (α y) γ *
        Matrix.det (Matrix.of fun t s : Fin k => EuclideanSpace.proj (γ t) (x s)) := by
    intro y x
    conv_lhs => rw [Submission.cmb_covector_eq_sum_coord_smul_wedge Q k (α y)]
    rw [ContinuousAlternatingMap.sum_apply]
    refine Finset.sum_congr rfl fun γ _ => ?_
    rw [ContinuousAlternatingMap.smul_apply, wedgeCovectors_apply_det, smul_eq_mul]
  -- The coefficients `α_γ` are continuous with compact support.
  have hgc : ∀ γ : SimonMultiIndex k Q, Continuous fun y => euclideanCovectorCoordinate (α y) γ :=
    fun γ => hαc.eval_const _
  have hgs : ∀ γ : SimonMultiIndex k Q,
      HasCompactSupport fun y => euclideanCovectorCoordinate (α y) γ := by
    intro γ
    refine hαs.mono fun y hy => ?_
    rw [Function.mem_support] at hy ⊢
    intro h0
    apply hy
    simp [euclideanCovectorCoordinate, h0]
  -- The minors of a map `C`-Lipschitz on `Ω` are measurable, and bounded on `Ω` by
  -- `‖dy^γ‖ Cᵏ` since `‖Dv‖ ≤ C` on the open set `Ω`.
  have hminor : ∀ v : Eucl k → Eucl Q, LipschitzOnWith C v Ω → ∀ γ : SimonMultiIndex k Q,
      AEStronglyMeasurable (fun w => Matrix.det (Matrix.of fun t s : Fin k =>
          EuclideanSpace.proj (γ t) (fderiv ℝ v w (EuclideanSpace.single s 1))))
          ((volume : Measure (Eucl k)).restrict Ω) ∧
        ∀ w ∈ Ω, ‖Matrix.det (Matrix.of fun t s : Fin k =>
            EuclideanSpace.proj (γ t) (fderiv ℝ v w (EuclideanSpace.single s 1)))‖ ≤
          ‖wedgeCovectors k (fun t => EuclideanSpace.proj (γ t))‖ * (C : ℝ) ^ k := by
    intro v hv γ
    set ω : Covector (Eucl Q) k := wedgeCovectors k (fun t => EuclideanSpace.proj (γ t)) with hω
    -- `M_γ(v)(w) = dy^γ(Dv(w) e₀, …, Dv(w) e_{k−1})`.
    have hM : ∀ w, Matrix.det (Matrix.of fun t s : Fin k =>
        EuclideanSpace.proj (γ t) (fderiv ℝ v w (EuclideanSpace.single s 1))) =
          ω (fun s => fderiv ℝ v w (EuclideanSpace.single s 1)) := by
      intro w
      rw [hω, wedgeCovectors_apply_det]
    simp only [hM]
    refine ⟨?_, fun w hw => ?_⟩
    · have hcont : Continuous fun L : Eucl k →L[ℝ] Eucl Q =>
          ω (fun s => L (EuclideanSpace.single s 1)) :=
        ω.coe_continuous.comp (continuous_pi fun s => continuous_id.clm_apply continuous_const)
      exact (hcont.measurable.comp (measurable_fderiv ℝ v)).aestronglyMeasurable
    · have hD : ‖fderiv ℝ v w‖ ≤ C := norm_fderiv_le_of_lipschitzOn ℝ (hΩ.mem_nhds hw) hv
      calc ‖ω (fun s => fderiv ℝ v w (EuclideanSpace.single s 1))‖
          ≤ ‖ω‖ * ∏ s, ‖fderiv ℝ v w (EuclideanSpace.single s 1)‖ := ω.le_opNorm _
        _ ≤ ‖ω‖ * ∏ _s : Fin k, (C : ℝ) := by
            gcongr with s
            calc ‖fderiv ℝ v w (EuclideanSpace.single s 1)‖
                ≤ ‖fderiv ℝ v w‖ * ‖(EuclideanSpace.single s (1 : ℝ) : Eucl k)‖ :=
                  (fderiv ℝ v w).le_opNorm _
              _ = ‖fderiv ℝ v w‖ := by simp
              _ ≤ C := hD
        _ = ‖ω‖ * (C : ℝ) ^ k := by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  -- Each summand `ψ (α_γ ∘ v) M_γ(v)` is integrable on `Ω`.
  have hint : ∀ v : Eucl k → Eucl Q, LipschitzOnWith C v Ω → ∀ γ : SimonMultiIndex k Q,
      IntegrableOn (fun w => ψ w * euclideanCovectorCoordinate (α (v w)) γ *
        Matrix.det (Matrix.of fun t s : Fin k =>
          EuclideanSpace.proj (γ t) (fderiv ℝ v w (EuclideanSpace.single s 1))))
        Ω (volume : Measure (Eucl k)) := by
    intro v hv γ
    obtain ⟨B, hB⟩ := (hgc γ).bounded_above_of_compact_support (hgs γ)
    obtain ⟨hmeas, hbd⟩ := hminor v hv γ
    have hgm : AEStronglyMeasurable (fun w => euclideanCovectorCoordinate (α (v w)) γ)
        ((volume : Measure (Eucl k)).restrict Ω) :=
      ((hgc γ).comp_continuousOn hv.continuousOn).aestronglyMeasurable hΩ.measurableSet
    have hm : AEStronglyMeasurable (fun w => euclideanCovectorCoordinate (α (v w)) γ *
        Matrix.det (Matrix.of fun t s : Fin k =>
          EuclideanSpace.proj (γ t) (fderiv ℝ v w (EuclideanSpace.single s 1))))
        ((volume : Measure (Eucl k)).restrict Ω) := hgm.mul hmeas
    have hb : ∀ᵐ w ∂((volume : Measure (Eucl k)).restrict Ω),
        ‖euclideanCovectorCoordinate (α (v w)) γ * Matrix.det (Matrix.of fun t s : Fin k =>
          EuclideanSpace.proj (γ t) (fderiv ℝ v w (EuclideanSpace.single s 1)))‖ ≤
          B * (‖wedgeCovectors k (fun t => EuclideanSpace.proj (γ t))‖ * (C : ℝ) ^ k) := by
      filter_upwards [ae_restrict_mem hΩ.measurableSet] with w hw
      rw [norm_mul]
      exact mul_le_mul (hB _) (hbd w hw) (norm_nonneg _) ((norm_nonneg _).trans (hB (v w)))
    exact (Integrable.mul_bdd hψ hm hb).congr
      (Eventually.of_forall fun w => (mul_assoc _ _ _).symm)
  -- Both integrals are finite sums over `γ` of such summands.
  have hrw : ∀ v : Eucl k → Eucl Q, LipschitzOnWith C v Ω →
      ∫ w in Ω, ψ w * α (v w) (fun b => fderiv ℝ v w (EuclideanSpace.single b 1))
          ∂(volume : Measure (Eucl k)) =
        ∑ γ : SimonMultiIndex k Q, ∫ w in Ω, ψ w * euclideanCovectorCoordinate (α (v w)) γ *
          Matrix.det (Matrix.of fun t s : Fin k =>
            EuclideanSpace.proj (γ t) (fderiv ℝ v w (EuclideanSpace.single s 1)))
          ∂(volume : Measure (Eucl k)) := by
    intro v hv
    rw [← integral_finsetSum _ fun γ _ => hint v hv γ]
    congr 1
    funext w
    rw [hexp (v w), Finset.mul_sum]
    exact Finset.sum_congr rfl fun γ _ => (mul_assoc _ _ _).symm
  rw [hrw u₀ hu₀]
  refine Tendsto.congr (fun j => (hrw (u j) (hu j)).symm) ?_
  -- Each summand converges: coefficient–minor continuity with `r = k`, `a = γ`, `b = id`.
  exact tendsto_finsetSum _ fun γ _ =>
    Submission.deformation_ipl_mwc_coeff_minor_continuity k Q Ω ψ
      (fun y => euclideanCovectorCoordinate (α y) γ) C u u₀ k γ (fun s => s)
      hΩ hψ (hgc γ) (hgs γ) hu hu₀ hlim

/-- Convergence of push-forward integrals under `C¹` approximation (Simon Ch. 6, proof of the
Deformation Theorem, §5, p. 166: the push-forward limit behind "Q, R₁ are integer multiplicity by
(19), 4.4, 4.5 and 3.13", part (I)).  Let `(M, θ, ξ)` be a rectifiable triple in `ℝ^P`, `g` be
`Λ`-Lipschitz, `L(x)v` the derivative of `t ↦ g(x + tv)` at `0` along the weighted approximate
tangent spaces `TₓM`, `θ` integrable on `M ∩ g⁻¹(K)` for compact `K`, and `C¹` maps `g_j` with a
common Lipschitz constant `Λ'` converge uniformly to `g`.  Then for every continuous compactly
supported `ω`, `∫_M θ ⟨ω(g_j), (Dg_j)_# ξ⟩ dHᵏ → ∫_M θ ⟨ω(g), L_# ξ⟩ dHᵏ`.  Once `|g_j - g| < 1`,
both integrands vanish off `g⁻¹(K)`, `K` the closed `1`-neighbourhood of `spt ω`, and are bounded
by `max(Λ, Λ')ᵏ ‖ω‖_∞ θ 1_{g⁻¹(K)}`.  On the disjointed `C¹` chart pieces `E_i` of `M`, one
`ψ ∈ L¹(Ω_i)` gives `∫_{E_i} = ∫_{Ω_i} ψ ⟨ω(u), ∂u⟩` for `u = g_j ∘ Φ_i` and `u = g ∘ Φ_i`; these
converge by weak continuity of minors, and dominated convergence over the pieces sums them. -/
theorem Submission.deformation_ipl_chart_convergence : ∀ (P Q k : ℕ) (M : Set (Eucl P)) (θ : Eucl P → ℝ) (ξ : Eucl P → NVector (Eucl P) k) (g : Eucl P → Eucl Q) (Λ : ℝ≥0) (L : Eucl P → (Eucl P →L[ℝ] Eucl Q)), IsRectifiableTriple (univ : Set (Eucl P)) k M θ ξ → LipschitzWith Λ g → (∀ᵐ x ∂((μHE[k] : Measure (Eucl P)).restrict M), ∀ Tx : Submodule ℝ (Eucl P), HasWeightedApproximateTangentSpaceAt k M θ x Tx → ∀ v ∈ Tx, HasDerivAt (fun t : ℝ => g (x + t • v)) (L x v) 0) → (∀ K : Set (Eucl Q), IsCompact K → IntegrableOn θ (M ∩ g ⁻¹' K) (μHE[k] : Measure (Eucl P))) → ∀ (gj : ℕ → Eucl P → Eucl Q) (Λ' : ℝ≥0), (∀ j, ContDiff ℝ 1 (gj j)) → (∀ j, LipschitzWith Λ' (gj j)) → TendstoUniformly gj g atTop → ∀ ω : Eucl Q → Covector (Eucl Q) k, Continuous ω → HasCompactSupport ω → Tendsto (fun j => ∫ x in M, θ x * nVectorPushforward k (fderiv ℝ (gj j) x) (ξ x) (ω (gj j x)) ∂(μHE[k] : Measure (Eucl P))) atTop (𝓝 (∫ x in M, θ x * nVectorPushforward k (L x) (ξ x) (ω (g x)) ∂(μHE[k] : Measure (Eucl P)))) := by
  intro P Q k M θ ξ g Λ L hT hg hL hθK gj Λ' hgjC1 hgjLip hconv ω hωc hωs
  -- Step 1: a fixed compact target set
  have hK₀ : IsCompact (tsupport ω) := hωs
  set K : Set (Eucl Q) := Metric.cthickening 1 (tsupport ω) with hKdef
  have hK : IsCompact K := hK₀.cthickening
  have hKm : MeasurableSet (g ⁻¹' K) := hg.continuous.measurable hK.isClosed.measurableSet
  have hev : ∀ᶠ j in atTop, ∀ x, dist (g x) (gj j x) < 1 :=
    Metric.tendstoUniformly_iff.mp hconv 1 one_pos
  have hvan_j : ∀ j, (∀ x, dist (g x) (gj j x) < 1) → ∀ x, g x ∉ K → ω (gj j x) = 0 := by
    intro j hj x hx
    by_contra hne
    apply hx
    have hmem : gj j x ∈ tsupport ω := subset_tsupport _ hne
    exact Metric.mem_cthickening_of_dist_le (g x) (gj j x) 1 (tsupport ω) hmem (hj x).le
  have hvan : ∀ x, g x ∉ K → ω (g x) = 0 := by
    intro x hx
    by_contra hne
    exact hx (Metric.self_subset_cthickening _ (subset_tsupport _ hne))
  -- Step 2: measurability and domination of both integrands
  have hgjloc : ∀ j, LocallyLipschitzOn univ (gj j) :=
    fun j => (hgjLip j).locallyLipschitz.locallyLipschitzOn
  have hgloc : LocallyLipschitzOn univ g := hg.locallyLipschitz.locallyLipschitzOn
  have hgjdiff : ∀ j, Differentiable ℝ (gj j) := fun j => (hgjC1 j).differentiable one_ne_zero
  have hgjderiv : ∀ j x (v : Eucl P),
      HasDerivAt (fun t : ℝ => gj j (x + t • v)) (fderiv ℝ (gj j) x v) 0 := by
    intro j x v
    have h1 : HasDerivAt (fun t : ℝ => x + t • v) v 0 := by
      simpa using ((hasDerivAt_id (0:ℝ)).smul_const v).const_add x
    have h2 : HasFDerivAt (gj j) (fderiv ℝ (gj j) x) (x + (0:ℝ) • v) := by
      simpa using (hgjdiff j x).hasFDerivAt
    exact h2.comp_hasDerivAt (0:ℝ) h1
  have hEj : ∀ j, AEStronglyMeasurable
      (fun x => θ x * nVectorPushforward k (fderiv ℝ (gj j) x) (ξ x) (ω (gj j x)))
        ((μHE[k] : Measure (Eucl P)).restrict M) ∧
      ∀ᵐ x ∂((μHE[k] : Measure (Eucl P)).restrict M),
        |θ x * nVectorPushforward k (fderiv ℝ (gj j) x) (ξ x) (ω (gj j x))| ≤
          (Λ' : ℝ) ^ k * ‖ω (gj j x)‖ * θ x := by
    intro j
    refine Submission.deformation_ipl_cc_pushforward_integrand_bound P Q k univ M θ ξ
      (fun x => fderiv ℝ (gj j) x) (fun x => ω (gj j x)) Λ' isOpen_univ hT ?_ ?_ ?_
    · exact Submission.deformation_ipl_tangential_pushforward_aestronglyMeasurable P Q k univ M θ ξ
        (gj j) (fun x => fderiv ℝ (gj j) x) isOpen_univ hT (hgjloc j)
        (Filter.Eventually.of_forall fun x Tx _ v _ => hgjderiv j x v)
    · exact (hωc.comp (hgjC1 j).continuous).aestronglyMeasurable
    · refine Filter.Eventually.of_forall fun x Tx _ v _ => ?_
      exact (fderiv ℝ (gj j) x).le_of_opNorm_le (norm_fderiv_le_of_lipschitz ℝ (hgjLip j)) v
  have hLbound : ∀ᵐ x ∂((μHE[k] : Measure (Eucl P)).restrict M), ∀ Tx : Submodule ℝ (Eucl P),
      HasWeightedApproximateTangentSpaceAt k M θ x Tx → ∀ v ∈ Tx, ‖L x v‖ ≤ (Λ : ℝ) * ‖v‖ := by
    filter_upwards [hL] with x hx Tx hTx v hv
    have hd := hx Tx hTx v hv
    have hlip : LipschitzWith (Λ * ‖v‖₊) (fun t : ℝ => g (x + t • v)) := by
      refine LipschitzWith.of_dist_le_mul fun s t => ?_
      calc dist (g (x + s • v)) (g (x + t • v)) ≤ Λ * dist (x + s • v) (x + t • v) :=
            hg.dist_le_mul _ _
        _ = (Λ * ‖v‖₊ : ℝ≥0) * dist s t := by
            rw [dist_add_left, dist_eq_norm, ← sub_smul, norm_smul, Real.dist_eq]
            push_cast
            rw [Real.norm_eq_abs]
            ring
    have := hd.le_of_lipschitz hlip
    simpa using this
  have hE0 := Submission.deformation_ipl_cc_pushforward_integrand_bound P Q k univ M θ ξ L
    (fun x => ω (g x)) Λ isOpen_univ hT
    (Submission.deformation_ipl_tangential_pushforward_aestronglyMeasurable P Q k univ M θ ξ g L
      isOpen_univ hT hgloc hL)
    (hωc.comp hg.continuous).aestronglyMeasurable hLbound
  -- Step 3: one integrable dominator
  obtain ⟨W, hW⟩ : ∃ W, ∀ y, ‖ω y‖ ≤ W := hωs.exists_bound_of_continuous hωc
  have hW0 : 0 ≤ W := (norm_nonneg _).trans (hW 0)
  set C₀ : ℝ := (max (Λ : ℝ) (Λ' : ℝ)) ^ k * W with hC₀
  set Gd : Eucl P → ℝ := fun x => C₀ * (g ⁻¹' K).indicator θ x with hGd_def
  have hGd : IntegrableOn Gd M (μHE[k] : Measure (Eucl P)) := by
    have h1 : IntegrableOn θ (M ∩ g ⁻¹' K) (μHE[k] : Measure (Eucl P)) := hθK K hK
    have h2 : Integrable ((g ⁻¹' K).indicator θ) ((μHE[k] : Measure (Eucl P)).restrict M) := by
      rw [integrable_indicator_iff hKm, IntegrableOn, Measure.restrict_restrict hKm,
        Set.inter_comm]
      exact h1
    exact h2.const_mul C₀
  have hmemM : ∀ᵐ x ∂((μHE[k] : Measure (Eucl P)).restrict M), x ∈ M :=
    ae_restrict_mem₀ hT.nullMeasurableSet
  have hmaxΛ : (Λ : ℝ) ≤ max (Λ : ℝ) (Λ' : ℝ) := le_max_left _ _
  have hmaxΛ' : (Λ' : ℝ) ≤ max (Λ : ℝ) (Λ' : ℝ) := le_max_right _ _
  have hboundj : ∀ᶠ j in atTop, ∀ᵐ x ∂((μHE[k] : Measure (Eucl P)).restrict M),
      |θ x * nVectorPushforward k (fderiv ℝ (gj j) x) (ξ x) (ω (gj j x))| ≤ Gd x := by
    filter_upwards [hev] with j hj
    filter_upwards [(hEj j).2, hmemM] with x hx hxM
    have hθ : 0 < θ x := hT.pos x hxM
    by_cases hgx : g x ∈ K
    · have hind : (g ⁻¹' K).indicator θ x = θ x :=
        Set.indicator_of_mem (show x ∈ g ⁻¹' K from hgx) _
      simp only [hGd_def, hind, hC₀]
      calc _ ≤ (Λ' : ℝ) ^ k * ‖ω (gj j x)‖ * θ x := hx
        _ ≤ (max (Λ : ℝ) (Λ' : ℝ)) ^ k * W * θ x := by
            gcongr
            · exact hW _
    · have h0 := hvan_j j hj x hgx
      have hind : (g ⁻¹' K).indicator θ x = 0 :=
        Set.indicator_of_notMem (show x ∉ g ⁻¹' K from hgx) _
      simp [hGd_def, hind, h0]
  have hbound0 : ∀ᵐ x ∂((μHE[k] : Measure (Eucl P)).restrict M),
      |θ x * nVectorPushforward k (L x) (ξ x) (ω (g x))| ≤ Gd x := by
    filter_upwards [hE0.2, hmemM] with x hx hxM
    have hθ : 0 < θ x := hT.pos x hxM
    by_cases hgx : g x ∈ K
    · have hind : (g ⁻¹' K).indicator θ x = θ x :=
        Set.indicator_of_mem (show x ∈ g ⁻¹' K from hgx) _
      simp only [hGd_def, hind, hC₀]
      calc _ ≤ (Λ : ℝ) ^ k * ‖ω (g x)‖ * θ x := hx
        _ ≤ (max (Λ : ℝ) (Λ' : ℝ)) ^ k * W * θ x := by
            gcongr
            · exact hW _
    · have h0 := hvan x hgx
      have hind : (g ⁻¹' K).indicator θ x = 0 :=
        Set.indicator_of_notMem (show x ∉ g ⁻¹' K from hgx) _
      simp [hGd_def, hind, h0]
  -- integrability of the integrands on M (eventually) and of the limit integrand
  have hintj : ∀ᶠ j in atTop, IntegrableOn
      (fun x => θ x * nVectorPushforward k (fderiv ℝ (gj j) x) (ξ x) (ω (gj j x))) M
        (μHE[k] : Measure (Eucl P)) := by
    filter_upwards [hboundj] with j hj
    exact Integrable.mono' hGd (hEj j).1 (by simpa [Real.norm_eq_abs] using hj)
  have hint0 : IntegrableOn (fun x => θ x * nVectorPushforward k (L x) (ξ x) (ω (g x))) M
      (μHE[k] : Measure (Eucl P)) :=
    Integrable.mono' hGd hE0.1 (by simpa [Real.norm_eq_abs] using hbound0)
  -- Step 4: chart pieces
  obtain ⟨Φ, Ω, hΩo, hΦC1, hΦLip, hΦanti, hcov⟩ :=
    Submission.lpf_countably_rectifiable_c1_cover P k M hT.countablyRectifiable
  set Ep : ℕ → Set (Eucl P) := disjointed (fun i => M ∩ Φ i '' Ω i) with hEp
  have hEsub : ∀ i, Ep i ⊆ M ∩ Φ i '' Ω i := fun i => disjointed_subset _ i
  have himgm : ∀ i, MeasurableSet (Φ i '' Ω i) :=
    fun i => (Submission.lpf_wtc_chart_image_measurable_locally_finite P k (Φ i) (Ω i) (hΩo i)
      (hΦC1 i) (hΦanti i)).1
  have hEm : ∀ i, NullMeasurableSet (Ep i) (μHE[k] : Measure (Eucl P)) :=
    NullMeasurableSet.disjointed fun i => hT.nullMeasurableSet.inter (himgm i).nullMeasurableSet
  have hEdisj : Pairwise (Function.onFun Disjoint Ep) := disjoint_disjointed _
  have hMeq : M =ᵐ[(μHE[k] : Measure (Eucl P))] (⋃ i, Ep i) := by
    rw [hEp, iUnion_disjointed, ← Set.inter_iUnion]
    refine ae_eq_set.mpr ⟨?_, ?_⟩
    · rw [Set.sdiff_self_inter]; exact hcov
    · rw [Set.sdiff_eq_empty.mpr Set.inter_subset_left]; exact measure_empty
  -- Step 5/6: convergence on each piece
  have hpiece : ∀ i, Tendsto
      (fun j => ∫ x in Ep i, θ x * nVectorPushforward k (fderiv ℝ (gj j) x) (ξ x) (ω (gj j x))
        ∂(μHE[k] : Measure (Eucl P))) atTop
      (𝓝 (∫ x in Ep i, θ x * nVectorPushforward k (L x) (ξ x) (ω (g x))
        ∂(μHE[k] : Measure (Eucl P)))) := by
    intro i
    set G' : Set (Eucl P) := Ep i ∩ g ⁻¹' K with hG'
    have hG'M : G' ⊆ M := fun x hx => (hEsub i hx.1).1
    have hG'Φ : G' ⊆ Φ i '' Ω i := fun x hx => (hEsub i hx.1).2
    have hG'm : NullMeasurableSet G' (μHE[k] : Measure (Eucl P)) :=
      (hEm i).inter hKm.nullMeasurableSet
    have hθG' : IntegrableOn θ G' (μHE[k] : Measure (Eucl P)) :=
      (hθK K hK).mono_set (fun x hx => ⟨hG'M hx, hx.2⟩)
    obtain ⟨ψ, hψ, hrep⟩ :=
      Submission.deformation_ipl_cc_chart_integral_representation P Q k univ M θ ξ (Φ i) (Ω i) G'
        isOpen_univ hT (hΩo i) (hΦC1 i) (hΦLip i) (hΦanti i) hG'M hG'Φ hG'm hθG'
    obtain ⟨KΦ, hKΦ⟩ := hΦLip i
    -- the C¹ integrands
    have hrepj : ∀ᶠ j in atTop,
        ∫ x in Ep i, θ x * nVectorPushforward k (fderiv ℝ (gj j) x) (ξ x) (ω (gj j x))
          ∂(μHE[k] : Measure (Eucl P)) =
        ∫ w in Ω i, ψ w * ω ((gj j ∘ Φ i) w)
          (fun b => fderiv ℝ (gj j ∘ Φ i) w (EuclideanSpace.single b 1)) := by
      filter_upwards [hev, hintj] with j hj hintMj
      have hzero : ∀ x, x ∉ g ⁻¹' K →
          θ x * nVectorPushforward k (fderiv ℝ (gj j) x) (ξ x) (ω (gj j x)) = 0 := by
        intro x hx
        simp [hvan_j j hj x hx]
      have hcut : ∫ x in Ep i, θ x * nVectorPushforward k (fderiv ℝ (gj j) x) (ξ x) (ω (gj j x))
            ∂(μHE[k] : Measure (Eucl P)) =
          ∫ x in G', θ x * nVectorPushforward k (fderiv ℝ (gj j) x) (ξ x) (ω (gj j x))
            ∂(μHE[k] : Measure (Eucl P)) := by
        rw [hG', ← setIntegral_indicator hKm]
        refine setIntegral_congr_fun₀ (hEm i) fun x _ => ?_
        by_cases hx : x ∈ g ⁻¹' K
        · rw [Set.indicator_of_mem hx]
        · rw [Set.indicator_of_notMem hx, hzero x hx]
      rw [hcut]
      refine hrep (gj j) (fun x => fderiv ℝ (gj j) x) ω ?_ (hintMj.mono_set hG'M)
      refine Filter.Eventually.of_forall fun w => ?_
      exact (hgjdiff j (Φ i w)).hasFDerivAt.comp w
        (((hΦC1 i).differentiable one_ne_zero) w).hasFDerivAt
    -- the limit integrand
    have hrep0 : ∫ x in Ep i, θ x * nVectorPushforward k (L x) (ξ x) (ω (g x))
          ∂(μHE[k] : Measure (Eucl P)) =
        ∫ w in Ω i, ψ w * ω ((g ∘ Φ i) w)
          (fun b => fderiv ℝ (g ∘ Φ i) w (EuclideanSpace.single b 1)) := by
      have hzero : ∀ x, x ∉ g ⁻¹' K → θ x * nVectorPushforward k (L x) (ξ x) (ω (g x)) = 0 := by
        intro x hx
        simp [hvan x hx]
      have hcut : ∫ x in Ep i, θ x * nVectorPushforward k (L x) (ξ x) (ω (g x))
            ∂(μHE[k] : Measure (Eucl P)) =
          ∫ x in G', θ x * nVectorPushforward k (L x) (ξ x) (ω (g x))
            ∂(μHE[k] : Measure (Eucl P)) := by
        rw [hG', ← setIntegral_indicator hKm]
        refine setIntegral_congr_fun₀ (hEm i) fun x _ => ?_
        by_cases hx : x ∈ g ⁻¹' K
        · rw [Set.indicator_of_mem hx]
        · rw [Set.indicator_of_notMem hx, hzero x hx]
      rw [hcut]
      refine hrep g L ω ?_ (hint0.mono_set hG'M)
      have hcc := Submission.lpf_chart_chain_rule P Q k univ M θ ξ g L (Φ i) (Ω i) isOpen_univ hT
        hgloc hL (hΩo i) (hΦC1 i) (hΦanti i)
      have hsub : Ω i ∩ Φ i ⁻¹' G' ⊆ Ω i ∩ Φ i ⁻¹' M :=
        fun w hw => ⟨hw.1, hG'M hw.2⟩
      exact (ae_restrict_of_ae_restrict_of_subset hsub hcc).mono fun w hw => hw.2
    -- weak continuity of minors on this chart
    have hlim := Submission.deformation_ipl_minor_weak_continuity k Q (Ω i) ψ ω ((max Λ Λ') * KΦ)
      (fun j => gj j ∘ Φ i) (g ∘ Φ i) (hΩo i) hψ hωc hωs
      (fun j => ((hgjLip j).comp_lipschitzOnWith hKΦ).weaken
        (mul_le_mul_of_nonneg_right (le_max_right _ _) (by positivity)))
      ((hg.comp_lipschitzOnWith hKΦ).weaken
        (mul_le_mul_of_nonneg_right (le_max_left _ _) (by positivity)))
      ((hconv.comp (Φ i)).tendstoUniformlyOn)
    rw [hrep0]
    exact hlim.congr' (hrepj.mono fun j hj => hj.symm)
  -- Step 7: summation
  exact Submission.deformation_ipl_cc_tendsto_setIntegral_of_partition (Eucl P)
    (μHE[k] : Measure (Eucl P)) M Ep
    (fun j x => θ x * nVectorPushforward k (fderiv ℝ (gj j) x) (ξ x) (ω (gj j x)))
    (fun x => θ x * nVectorPushforward k (L x) (ξ x) (ω (g x))) Gd
    hEm hEdisj hMeq hGd (fun j => (hEj j).1) hE0.1 hboundj hbound0 hpiece

/-- **Lipschitz push-forward as the limit of `C¹` push-forwards** (the consistency step behind
the remark after display (21) in the proof of Simon Ch. 6, 5.1), conditional on Lemma 3.9.
Lemma 3.9 gives an integer multiplicity `S = g_# X` with data `(M', θ', ξ', L')`.  Both triples
represent `X`, so `Hᵏ(M Δ M') = 0` and `θ = θ'`, `ξ = ξ'` `Hᵏ`-a.e. on `M`
(`ltg_tau_unique_on_open`); hence the weighted tangent spaces of `(M, θ)` are those of
`(M', θ')` (`br_weightedTangent_congr`) and `L'` has the derivative property on `(M, θ)`.  As
`Hᵏ(M \ spt X) = 0` (`lpf_rectifiable_support_null`), `θ` is integrable on `M ∩ g⁻¹(K)` for
compact `K`, and `deformation_ipl_chart_convergence` gives convergence of the `C¹` push-forward
integrals to `∫_M θ ⟨ω(g), L'_# ξ⟩ dHᵏ = S(ω)`. -/
theorem Submission.deformation_im_pushforward_limit : LipschitzPushforwardIntegerMultiplicity → ∀ (P Q k : ℕ) (X : GeometricCurrentOn (univ : Set (Eucl P)) k) (M : Set (Eucl P)) (θ : Eucl P → ℝ) (ξ : Eucl P → NVector (Eucl P) k), IsRectifiableTriple (univ : Set (Eucl P)) k M θ ξ → (∀ x ∈ M, ∃ j : ℕ, θ x = j) → (∀ ω : TestFormOn (univ : Set (Eucl P)) k, X ω = tauAction k M θ ξ ω) → ∀ (g : Eucl P → Eucl Q) (Λ : ℝ≥0), LipschitzWith Λ g → (∀ K : Set (Eucl Q), IsCompact K → IsCompact (g ⁻¹' K ∩ X.support)) → ∃ S : GeometricCurrentOn (univ : Set (Eucl Q)) k, IsLipschitzPushforward X g S ∧ IsIntegerMultiplicity S ∧ ∀ (gj : ℕ → Eucl P → Eucl Q) (Λ' : ℝ≥0), (∀ j, ContDiff ℝ 1 (gj j)) → (∀ j, LipschitzWith Λ' (gj j)) → TendstoUniformly gj g atTop → ∀ ω : TestFormOn (univ : Set (Eucl Q)) k, Tendsto (fun j => ∫ x in M, θ x * nVectorPushforward k (fderiv ℝ (gj j) x) (ξ x) ((ω : DifferentialForm (Eucl Q) k) (gj j x)) ∂(μHE[k] : Measure (Eucl P))) atTop (𝓝 (S ω)) := by
  intro hLPF P Q k X M θ ξ hM hθ hX g Λ hg hprop
  -- (II.1) Lemma 3.9 with `U = ℝ^P`, `V = ℝ^Q`, `T = X = τ(M, θ, ξ)`, `f = g`.
  obtain ⟨S, hSpush, hSint⟩ := hLPF P Q k univ univ isOpen_univ isOpen_univ X g
    ⟨M, θ, ξ, hM, hθ, hX⟩ (locallyLipschitzOn_univ.2 hg.locallyLipschitz) (mapsTo_univ g univ)
    fun K hK _ => hprop K hK
  refine ⟨S, hSpush, hSint, ?_⟩
  obtain ⟨M', θ', ξ', L', hM', hX', hL', hS⟩ := hSpush
  intro gj Λ' hgj hgjL hgjg ω
  -- (II.2)–(II.6): both triples represent `X`, so `Hᵏ(M Δ M') = 0` and `θ = θ'`, `ξ = ξ'`
  -- `Hᵏ`-a.e. on `M`; in particular `Hᵏ ⌞ M = Hᵏ ⌞ M'`.
  obtain ⟨hMM', hθξ⟩ := Submission.ltg_tau_unique_on_open P k univ univ isOpen_univ subset_rfl
    M M' θ θ' ξ ξ' hM hM' fun ω _ => (hX ω).symm.trans (hX' ω)
  have hrestr : (μHE[k] : Measure (Eucl P)).restrict M =
      (μHE[k] : Measure (Eucl P)).restrict M' := by
    refine Measure.restrict_congr_set (measure_symmDiff_eq_zero_iff.1 ?_)
    simpa only [inter_univ] using hMM'
  have hθξM : ∀ᵐ x ∂((μHE[k] : Measure (Eucl P)).restrict M), θ x = θ' x ∧ ξ x = ξ' x := by
    simpa only [inter_univ] using hθξ
  -- (II.7a–b): every weighted tangent space of `(M, θ)` at such `x` is one of `(M', θ')`, so
  -- `L'` has the derivative property of `d^M g` on `(M, θ)`.
  have hL : ∀ᵐ x ∂((μHE[k] : Measure (Eucl P)).restrict M), ∀ Tx : Submodule ℝ (Eucl P),
      HasWeightedApproximateTangentSpaceAt k M θ x Tx →
        ∀ v ∈ Tx, HasDerivAt (fun t : ℝ => g (x + t • v)) (L' x v) 0 := by
    have hL'M := hL'
    rw [← hrestr] at hL'M
    filter_upwards [hL'M, hθξM] with x hx hxθξ Tx hTx
    exact hx Tx (Submission.br_weightedTangent_congr P k M M' θ θ' x univ isOpen_univ
      (mem_univ x) hMM' (hθξ.mono fun y hy => hy.1) hxθξ.1 Tx hTx)
  -- (b): `Hᵏ(M \ spt X) = 0` and `g⁻¹(K) ∩ spt X` is compact, so `θ` is integrable on
  -- `M ∩ g⁻¹(K)` for every compact `K`.
  have hint : ∀ K : Set (Eucl Q), IsCompact K →
      IntegrableOn θ (M ∩ g ⁻¹' K) (μHE[k] : Measure (Eucl P)) := by
    intro K hK
    refine (hM.integrableOn _ (hprop K hK) (subset_univ _)).mono_set_ae (ae_le_set.2 ?_)
    refine measure_mono_null ?_ (Submission.lpf_rectifiable_support_null P k univ X M θ ξ hM hX)
    rintro x ⟨⟨hxM, hxK⟩, hx⟩
    exact ⟨hxM, fun hxX => hx ⟨hxM, hxK, hxX⟩⟩
  -- (I): the `C¹` push-forward integrals converge to `∫_M θ ⟨ω(g), L'_# ξ⟩ dHᵏ`.
  have hconv := Submission.deformation_ipl_chart_convergence P Q k M θ ξ g Λ L' hM hg hL hint
    gj Λ' hgj hgjL hgjg (ω : DifferentialForm (Eucl Q) k) ω.property.1.1.continuous
    ω.property.1.2
  -- (II.7c) and the final display of (II.7): this limit is `S(ω)`.
  have hlim : ∫ x in M, θ x * nVectorPushforward k (L' x) (ξ x)
      ((ω : DifferentialForm (Eucl Q) k) (g x)) ∂(μHE[k] : Measure (Eucl P)) = S ω := by
    rw [hS ω, ← hrestr]
    refine integral_congr_ae ?_
    filter_upwards [hθξM] with x hx
    rw [hx.1, hx.2]
  rw [← hlim]
  exact hconv

/-- **Push-forward operators and the straight-line homotopy (Simon Ch. 6, 2.17–2.29, 3.2(2)).**
Assume (S5′), the conclusion of `deformation_im_pushforward_limit`.  For every `D` there are
constants `c_k = max(1, c₀(D, k))` (`c₀` the constant of the affine estimate 2.27) such that every
`f : ℝ^D → ℝ^D` has operators `P_k X = f_# X` and `H_k X = h_# ([[0,1]] × X)`, the Lipschitz
push-forwards characterized in `dph_lipschitz_pushforward`, where
`h(t, x) = f(x) + t (x − f(x))` is the straight-line homotopy from `f` to the identity.  On currents
with admissible data `(E, Λ, δ, b)` they satisfy the mass, support, integrality, tangential
vanishing and linearity clauses, `∂ P = P ∂` and the homotopy formula `X − P X = ∂ H X + H ∂X`
(Simon 2.25), the latter as the limit of the smooth homotopy formula for the mollified homotopies
`ĥ_n(t, x) = f_n(x) + t (x − f_n(x))`. -/
theorem Submission.deformation_pushforward_homotopy : (∀ (P Q k : ℕ) (X : GeometricCurrentOn (univ : Set (Eucl P)) k) (M : Set (Eucl P)) (θ : Eucl P → ℝ) (ξ : Eucl P → NVector (Eucl P) k), IsRectifiableTriple (univ : Set (Eucl P)) k M θ ξ → (∀ x ∈ M, ∃ j : ℕ, θ x = j) → (∀ ω : TestFormOn (univ : Set (Eucl P)) k, X ω = tauAction k M θ ξ ω) → ∀ (g : Eucl P → Eucl Q) (Λ : ℝ≥0), LipschitzWith Λ g → (∀ K : Set (Eucl Q), IsCompact K → IsCompact (g ⁻¹' K ∩ X.support)) → ∃ S : GeometricCurrentOn (univ : Set (Eucl Q)) k, IsLipschitzPushforward X g S ∧ IsIntegerMultiplicity S ∧ ∀ (gj : ℕ → Eucl P → Eucl Q) (Λ' : ℝ≥0), (∀ j, ContDiff ℝ 1 (gj j)) → (∀ j, LipschitzWith Λ' (gj j)) → TendstoUniformly gj g atTop → ∀ ω : TestFormOn (univ : Set (Eucl Q)) k, Tendsto (fun j => ∫ x in M, θ x * nVectorPushforward k (fderiv ℝ (gj j) x) (ξ x) ((ω : DifferentialForm (Eucl Q) k) (gj j x)) ∂(μHE[k] : Measure (Eucl P))) atTop (𝓝 (S ω))) → ∀ D : ℕ, ∃ c : ℕ → ℝ≥0, ∀ f : Eucl D → Eucl D, ∃ (Pf : (k : ℕ) → GeometricCurrentOn (univ : Set (Eucl D)) k → GeometricCurrentOn (univ : Set (Eucl D)) k) (Hf : (k : ℕ) → GeometricCurrentOn (univ : Set (Eucl D)) k → GeometricCurrentOn (univ : Set (Eucl D)) (k + 1)), (∀ (k : ℕ) (E : Set (Eucl D)) (Λ : ℝ≥0) (δ b : ℝ) (X : GeometricCurrentOn (univ : Set (Eucl D)) k), IsClosed E → 0 < δ → LipschitzOnWith Λ f (thickening δ E) → (∀ x ∈ E, dist (f x) x ≤ b) → X.mass < ∞ → (∀ (j : ℕ) (Y : GeometricCurrentOn (univ : Set (Eucl D)) (j + 1)), k = j + 1 → HEq Y X → Y.boundary.mass < ∞) → X.support ⊆ E → (Pf k X).mass ≤ (c k : ℝ≥0∞) * (Λ : ℝ≥0∞) ^ k * X.mass ∧ (Hf k X).mass ≤ (c k : ℝ≥0∞) * ENNReal.ofReal b * (1 + (Λ : ℝ≥0∞)) ^ k * X.mass ∧ (Pf k X).support ⊆ closure (f '' X.support) ∧ (Hf k X).support ⊆ cthickening b X.support ∧ (IsIntegerMultiplicity X → IsIntegerMultiplicity (Pf k X) ∧ IsIntegerMultiplicity (Hf k X)) ∧ (∀ (α : SimonMultiIndex k D) (z : Eucl D) (ω : TestFormOn (univ : Set (Eucl D)) k) (ε : ℝ), 0 < ε → (∀ x ∈ thickening ε X.support, f x ∈ thickening ε (tsupport (ω : DifferentialForm (Eucl D) k)) → ∀ i, i ∉ range α → f x i = z i) → (∀ y, (ω : DifferentialForm (Eucl D) k) y (fun j => EuclideanSpace.single (α j) (1 : ℝ)) = 0) → Pf k X ω = 0) ∧ ∀ (X₁ X₂ : GeometricCurrentOn (univ : Set (Eucl D)) k) (a a₁ : ℝ), X₁.mass < ∞ → (∀ (j : ℕ) (Y : GeometricCurrentOn (univ : Set (Eucl D)) (j + 1)), k = j + 1 → HEq Y X₁ → Y.boundary.mass < ∞) → X₁.support ⊆ E → (∀ ω, X₂ ω = a * X ω + a₁ * X₁ ω) → (∀ ω, Pf k X₂ ω = a * Pf k X ω + a₁ * Pf k X₁ ω) ∧ ∀ ω, Hf k X₂ ω = a * Hf k X ω + a₁ * Hf k X₁ ω) ∧ ∀ (j : ℕ) (E : Set (Eucl D)) (Λ : ℝ≥0) (δ b : ℝ) (X : GeometricCurrentOn (univ : Set (Eucl D)) (j + 1)), IsClosed E → 0 < δ → LipschitzOnWith Λ f (thickening δ E) → (∀ x ∈ E, dist (f x) x ≤ b) → X.mass < ∞ → X.boundary.mass < ∞ → X.support ⊆ E → (Pf (j + 1) X).boundary = Pf j X.boundary ∧ ∀ ω, X ω - Pf (j + 1) X ω = (Hf (j + 1) X).boundary ω + Hf j X.boundary ω := by
  have hSA := Submission.dph_lipschitz_smooth_approx
  have hIP := Submission.dph_interval_product
  have hIPIM := Submission.dph_interval_product_im
  have hSH := Submission.dph_smooth_homotopy
  have hLPF := Submission.dph_lipschitz_pushforward
  have hLPFIM := Submission.dph_lipschitz_pushforward_im
  intro hS5 D
  classical
  /- Part 0.  Coordinates on `ℝ^{D+1} = ℝ × ℝ^D` (time first, via `Fin.cons`): `tm y = y₀` and
  `tl y = (y₁, …, y_D)`, with `‖y‖² = tm y² + ‖tl y‖²`. -/
  obtain ⟨tl, htl⟩ : ∃ tl : Eucl (D + 1) →L[ℝ] Eucl D, ∀ y, tl y =
      (EuclideanSpace.equiv (Fin D) ℝ).symm
        (Fin.tail (EuclideanSpace.equiv (Fin (D + 1)) ℝ y)) := by
    let tlₗ : Eucl (D + 1) →ₗ[ℝ] Eucl D :=
      { toFun := fun y => (EuclideanSpace.equiv (Fin D) ℝ).symm
          (Fin.tail (EuclideanSpace.equiv (Fin (D + 1)) ℝ y))
        map_add' := fun a b => by ext i; simp [Fin.tail]
        map_smul' := fun c a => by ext i; simp [Fin.tail] }
    exact ⟨LinearMap.toContinuousLinearMap tlₗ, fun y => rfl⟩
  obtain ⟨tm, htm⟩ : ∃ tm : Eucl (D + 1) →L[ℝ] ℝ, ∀ y,
      tm y = EuclideanSpace.equiv (Fin (D + 1)) ℝ y 0 := by
    let tmₗ : Eucl (D + 1) →ₗ[ℝ] ℝ :=
      { toFun := fun y => EuclideanSpace.equiv (Fin (D + 1)) ℝ y 0
        map_add' := fun a b => by simp
        map_smul' := fun c a => by simp }
    exact ⟨LinearMap.toContinuousLinearMap tmₗ, fun y => rfl⟩
  have hnorm2 : ∀ y : Eucl (D + 1), ‖y‖ ^ 2 = tm y ^ 2 + ‖tl y‖ ^ 2 := by
    intro y
    rw [EuclideanSpace.norm_sq_eq, EuclideanSpace.norm_sq_eq, Fin.sum_univ_succ, htm, htl]
    simp [Fin.tail]
  have htl_le : ∀ y, ‖tl y‖ ≤ ‖y‖ := fun y => by
    have := hnorm2 y
    nlinarith [sq_nonneg (tm y), norm_nonneg y, norm_nonneg (tl y)]
  have htm_le : ∀ y, |tm y| ≤ ‖y‖ := fun y => by
    have := hnorm2 y
    rw [← sq_abs (tm y)] at this
    nlinarith [abs_nonneg (tm y), norm_nonneg y, norm_nonneg (tl y), sq_nonneg ‖tl y‖]
  have hy_le : ∀ y, ‖y‖ ≤ |tm y| + ‖tl y‖ := fun y => by
    have := hnorm2 y
    rw [← sq_abs (tm y)] at this
    nlinarith [abs_nonneg (tm y), norm_nonneg y, norm_nonneg (tl y)]
  have htl_cons : ∀ (s : ℝ) (x : Eucl D), tl ((EuclideanSpace.equiv (Fin (D + 1)) ℝ).symm
      (Fin.cons s (EuclideanSpace.equiv (Fin D) ℝ x))) = x := by
    intro s x
    rw [htl, ContinuousLinearEquiv.apply_symm_apply, Fin.tail_cons,
      ContinuousLinearEquiv.symm_apply_apply]
  have htm_cons : ∀ (s : ℝ) (x : Eucl D), tm ((EuclideanSpace.equiv (Fin (D + 1)) ℝ).symm
      (Fin.cons s (EuclideanSpace.equiv (Fin D) ℝ x))) = s := by
    intro s x
    rw [htm, ContinuousLinearEquiv.apply_symm_apply, Fin.cons_zero]
  -- The cylinder `[0, 1] × S` of the children, in these coordinates.
  have hcyl : ∀ S : Set (Eucl D), {y : Eucl (D + 1) | EuclideanSpace.equiv (Fin (D + 1)) ℝ y 0 ∈
      Icc (0 : ℝ) 1 ∧ (EuclideanSpace.equiv (Fin D) ℝ).symm
        (Fin.tail (EuclideanSpace.equiv (Fin (D + 1)) ℝ y)) ∈ S} =
      {y | tm y ∈ Icc (0 : ℝ) 1 ∧ tl y ∈ S} := by
    intro S
    ext y
    simp only [Set.mem_ofPred_eq, htl, htm]
  have hcyl_closed : ∀ S : Set (Eucl D), IsClosed S →
      IsClosed {y : Eucl (D + 1) | tm y ∈ Icc (0 : ℝ) 1 ∧ tl y ∈ S} := fun S hS =>
    (isClosed_Icc.preimage tm.continuous).inter (hS.preimage tl.continuous)
  have hcyl_compact : ∀ K : Set (Eucl D), IsCompact K →
      IsCompact {y : Eucl (D + 1) | tm y ∈ Icc (0 : ℝ) 1 ∧ tl y ∈ K} := by
    intro K hK
    obtain ⟨R, hR⟩ := hK.isBounded.subset_closedBall 0
    refine Metric.isCompact_of_isClosed_isBounded (hcyl_closed K hK.isClosed)
      ((isBounded_closedBall (x := (0 : Eucl (D + 1))) (r := 1 + R)).subset ?_)
    rintro y ⟨ht, hx⟩
    rw [mem_closedBall, dist_zero_right]
    have h1 : |tm y| ≤ 1 := abs_le.2 ⟨by linarith [ht.1], ht.2⟩
    have h2 : ‖tl y‖ ≤ R := by simpa [mem_closedBall, dist_zero_right] using hR hx
    linarith [hy_le y]
  /- Standing facts on currents: supports are closed, a current with empty support vanishes,
  mass bounds through mass-admissible forms (`cmb_abs_apply_le_of_massOn_le`). -/
  have hsupp_closed : ∀ (m n : ℕ) (T : GeometricCurrentOn (univ : Set (Eucl m)) n),
      IsClosed T.support := by
    intro m n T
    show IsClosed (univ \ T.zeroRegion)
    rw [← compl_eq_univ_sdiff]
    exact T.isOpen_zeroRegion.isClosed_compl
  have hzero_of_supp : ∀ (m n : ℕ) (T : GeometricCurrentOn (univ : Set (Eucl m)) n),
      T.support ⊆ ∅ → ∀ ω, T ω = 0 := fun m n T hT ω =>
    Submission.isoperimetric_apply_eq_zero_of_disjoint_support m n univ T ω
      (Set.disjoint_left.2 fun x _ hx => hT hx)
  have hmass_le : ∀ (m n : ℕ) (T : GeometricCurrentOn (univ : Set (Eucl m)) n) (C : ℝ),
      (∀ ω ∈ massAdmissibleOn (univ : Set (Eucl m)) n univ, T ω ≤ C) →
      T.mass ≤ ENNReal.ofReal C := by
    intro m n T C hC
    unfold GeometricCurrentOn.mass GeometricCurrentOn.massOn
    apply sSup_le
    rintro _ ⟨ω, hω, rfl⟩
    exact ENNReal.ofReal_le_ofReal (hC ω hω)
  have hmass_zero : ∀ (m n : ℕ) (T : GeometricCurrentOn (univ : Set (Eucl m)) n),
      (∀ ω, T ω = 0) → T.mass = 0 := fun m n T hT =>
    le_antisymm ((hmass_le m n T 0 fun ω _ => (hT ω).le).trans_eq ENNReal.ofReal_zero) zero_le
  have habs_le : ∀ (m n : ℕ) (T : GeometricCurrentOn (univ : Set (Eucl m)) n), T.mass < ∞ →
      ∀ ω ∈ massAdmissibleOn (univ : Set (Eucl m)) n univ, |T ω| ≤ T.mass.toReal := by
    intro m n T hT ω hω
    have := Submission.cmb_abs_apply_le_of_massOn_le m n univ univ T ω T.mass.toReal 1
      ENNReal.toReal_nonneg (by rw [ENNReal.ofReal_toReal hT.ne]; exact le_rfl) (subset_univ _) hω.2
    simpa using this
  have hmass_lin : ∀ (m n : ℕ) (T T₁ T₂ : GeometricCurrentOn (univ : Set (Eucl m)) n) (a a₁ : ℝ),
      T.mass < ∞ → T₁.mass < ∞ → (∀ ω, T₂ ω = a * T ω + a₁ * T₁ ω) → T₂.mass < ∞ := by
    intro m n T T₁ T₂ a a₁ hT hT₁ h₂
    refine lt_of_le_of_lt (hmass_le m n T₂ (|a| * T.mass.toReal + |a₁| * T₁.mass.toReal) ?_)
      ENNReal.ofReal_lt_top
    intro ω hω
    rw [h₂ ω]
    have e1 := habs_le m n T hT ω hω
    have e2 := habs_le m n T₁ hT₁ ω hω
    calc a * T ω + a₁ * T₁ ω ≤ |a * T ω| + |a₁ * T₁ ω| := add_le_add (le_abs_self _) (le_abs_self _)
      _ = |a| * |T ω| + |a₁| * |T₁ ω| := by rw [abs_mul, abs_mul]
      _ ≤ |a| * T.mass.toReal + |a₁| * T₁.mass.toReal :=
        add_le_add (mul_le_mul_of_nonneg_left e1 (abs_nonneg _))
          (mul_le_mul_of_nonneg_left e2 (abs_nonneg _))
  /- The characterizations used by the children: `LipPF m m' k X G S` (the Lipschitz push-forward
  `S = G_# X` is the limit of `X(η_n)` along every locally admissible smooth approximation of `G`
  and every eventually compatible `η_n`) and `PC m k X Z` (`Z = [[0,1]] × X`). -/
  obtain ⟨LipPF, hLipPF⟩ : ∃ LipPF : (m m' k : ℕ) → GeometricCurrentOn (univ : Set (Eucl m)) k →
      (Eucl m → Eucl m') → GeometricCurrentOn (univ : Set (Eucl m')) k → Prop,
      ∀ m m' k X G S, LipPF m m' k X G S ↔ ∀ (Gj : ℕ → Eucl m → Eucl m') (O : Set (Eucl m)) (L : ℝ),
        IsOpen O → X.support ⊆ O → (∀ n, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (Gj n)) →
        (∀ᶠ n in atTop, ∀ x ∈ O, ‖fderiv ℝ (Gj n) x‖ ≤ L) → TendstoUniformlyOn Gj G atTop O →
        ∀ (ω : TestFormOn (univ : Set (Eucl m')) k) (ηj : ℕ → TestFormOn (univ : Set (Eucl m)) k),
        (∀ᶠ n in atTop, ∃ N : Set (Eucl m), IsOpen N ∧ X.support ⊆ N ∧ ∀ x ∈ N,
          (ηj n : DifferentialForm (Eucl m) k) x = ((ω : DifferentialForm (Eucl m') k)
            (Gj n x)).compContinuousLinearMap (fderiv ℝ (Gj n) x)) →
        Tendsto (fun n => X (ηj n)) atTop (𝓝 (S ω)) :=
    ⟨_, fun _ _ _ _ _ _ => Iff.rfl⟩
  obtain ⟨PC, hPC⟩ : ∃ PC : (m k : ℕ) → GeometricCurrentOn (univ : Set (Eucl m)) k →
      GeometricCurrentOn (univ : Set (Eucl (m + 1))) (k + 1) → Prop,
      ∀ m k X Z, PC m k X Z ↔ ∀ (η : TestFormOn (univ : Set (Eucl (m + 1))) (k + 1))
        (φ : ℝ → TestFormOn (univ : Set (Eucl m)) k), (∀ s ∈ Icc (0 : ℝ) 1, ∀ (x : Eucl m)
          (v : Fin k → Eucl m), (φ s : DifferentialForm (Eucl m) k) x v =
            (η : DifferentialForm (Eucl (m + 1)) (k + 1))
              ((EuclideanSpace.equiv (Fin (m + 1)) ℝ).symm
                (Fin.cons s (EuclideanSpace.equiv (Fin m) ℝ x)))
              (Fin.cons (EuclideanSpace.single 0 1) fun i =>
                (EuclideanSpace.equiv (Fin (m + 1)) ℝ).symm
                  (Fin.cons 0 (EuclideanSpace.equiv (Fin m) ℝ (v i))))) →
        Z η = ∫ s in (0 : ℝ)..1, X (φ s) :=
    ⟨_, fun _ _ _ _ => Iff.rfl⟩
  /- Part 6.  The constants `c_k = max(1, c₀(D, k))`, `c₀` the constant of the affine estimate. -/
  choose c₀ hc₀ hc₀aff using fun k => hSH.2.2 D D k
  obtain ⟨c, hc1, hcc₀⟩ : ∃ c : ℕ → ℝ≥0, (∀ k, (1 : ℝ≥0∞) ≤ c k) ∧
      ∀ k, ENNReal.ofReal (c₀ k) ≤ c k :=
    ⟨fun k => Real.toNNReal (max 1 (c₀ k)), fun k => by
      rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (le_max_left _ _),
      fun k => ENNReal.ofReal_le_ofReal (le_max_right _ _)⟩
  refine ⟨c, fun f => ?_⟩
  -- The straight-line homotopy from `f` (`t = 0`) to the identity (`t = 1`).
  obtain ⟨h, hh⟩ : ∃ h : Eucl (D + 1) → Eucl D, ∀ y, h y = f (tl y) + tm y • (tl y - f (tl y)) :=
    ⟨_, fun y => rfl⟩
  -- The operators (6.1): classical choices of the characterized push-forwards.
  obtain ⟨Pf, hPf⟩ : ∃ Pf : (k : ℕ) → GeometricCurrentOn (univ : Set (Eucl D)) k →
      GeometricCurrentOn (univ : Set (Eucl D)) k, ∀ k X S, LipPF D D k X f S →
        (∀ S', LipPF D D k X f S' → S' = S) → Pf k X = S := by
    refine ⟨fun k X => if hX : ∃ S, LipPF D D k X f S then Classical.choose hX else 0,
      fun k X S hS hu => ?_⟩
    have hex : ∃ S, LipPF D D k X f S := ⟨S, hS⟩
    dsimp only
    rw [dite_eq_left hex]
    exact hu _ (Classical.choose_spec hex)
  obtain ⟨Hf, hHf⟩ : ∃ Hf : (k : ℕ) → GeometricCurrentOn (univ : Set (Eucl D)) k →
      GeometricCurrentOn (univ : Set (Eucl D)) (k + 1), ∀ k X S Z, PC D k X Z →
        LipPF (D + 1) D (k + 1) Z h S → (∀ Z', PC D k X Z' → Z' = Z) →
        (∀ S', LipPF (D + 1) D (k + 1) Z h S' → S' = S) → Hf k X = S := by
    refine ⟨fun k X => if hX : ∃ S Z, PC D k X Z ∧ LipPF (D + 1) D (k + 1) Z h S then
      Classical.choose hX else 0, fun k X S Z hZ hS huZ huS => ?_⟩
    have hex : ∃ S Z, PC D k X Z ∧ LipPF (D + 1) D (k + 1) Z h S := ⟨S, Z, hZ, hS⟩
    dsimp only
    rw [dite_eq_left hex]
    obtain ⟨Z₀, hZ₀, hS₀⟩ := Classical.choose_spec hex
    rw [huZ Z₀ hZ₀] at hS₀
    exact huS _ hS₀
  /- Lipschitz bound for straight-line homotopies `y ↦ g(tl y) + tm y (tl y − g(tl y))`
  (computation of 6.4): if `g` is `Λg`-Lipschitz on `U` and `|x − g x| ≤ bg` there, the homotopy is
  `(3Λg + 2 + bg)`-Lipschitz on `[−2, 2] × U`. -/
  have hLemH : ∀ (g : Eucl D → Eucl D) (Λg bg : ℝ≥0) (U : Set (Eucl D)), LipschitzOnWith Λg g U →
      (∀ x ∈ U, dist x (g x) ≤ bg) →
      LipschitzOnWith (3 * Λg + 2 + bg) (fun y => g (tl y) + tm y • (tl y - g (tl y)))
        {y : Eucl (D + 1) | tm y ∈ Icc (-2 : ℝ) 2 ∧ tl y ∈ U} := by
    intro g Λg bg U hg hgb
    refine LipschitzOnWith.of_dist_le_mul fun y hy y' hy' => ?_
    have hx := hg.dist_le_mul _ hy.2 _ hy'.2
    have hb' := hgb _ hy'.2
    have ht : |tm y| ≤ 2 := abs_le.2 ⟨hy.1.1, hy.1.2⟩
    have hd1 : ‖tl y - tl y'‖ ≤ ‖y - y'‖ := by rw [← map_sub]; exact htl_le _
    have hd2 : |tm y - tm y'| ≤ ‖y - y'‖ := by rw [← map_sub]; exact htm_le _
    rw [dist_eq_norm] at hx hb' ⊢
    have key : g (tl y) + tm y • (tl y - g (tl y)) - (g (tl y') + tm y' • (tl y' - g (tl y'))) =
        (g (tl y) - g (tl y')) + tm y • ((tl y - tl y') - (g (tl y) - g (tl y'))) +
          (tm y - tm y') • (tl y' - g (tl y')) := by
      simp only [smul_sub, sub_smul]; abel
    rw [key, dist_eq_norm]
    have hA : ‖g (tl y) - g (tl y')‖ ≤ Λg * ‖y - y'‖ :=
      hx.trans (mul_le_mul_of_nonneg_left hd1 Λg.coe_nonneg)
    have hV : ‖(tl y - tl y') - (g (tl y) - g (tl y'))‖ ≤ ‖y - y'‖ + Λg * ‖y - y'‖ :=
      (norm_sub_le _ _).trans (add_le_add hd1 hA)
    have hTV : ‖tm y • ((tl y - tl y') - (g (tl y) - g (tl y')))‖ ≤
        2 * (‖y - y'‖ + Λg * ‖y - y'‖) := by
      rw [norm_smul, Real.norm_eq_abs]
      exact mul_le_mul ht hV (norm_nonneg _) zero_le_two
    have hdW : ‖(tm y - tm y') • (tl y' - g (tl y'))‖ ≤ ‖y - y'‖ * bg := by
      rw [norm_smul, Real.norm_eq_abs]
      exact mul_le_mul hd2 hb' (norm_nonneg _) (norm_nonneg _)
    have h3 := norm_add₃_le (a := g (tl y) - g (tl y'))
      (b := tm y • ((tl y - tl y') - (g (tl y) - g (tl y'))))
      (c := (tm y - tm y') • (tl y' - g (tl y')))
    push_cast
    nlinarith [norm_nonneg (y - y')]
  /- `|x − f x| ≤ b + (1 + Λ) ε` on `E_ε` (`ε ≤ δ`), from the Lipschitz bound on `E_δ`. -/
  have hfdist : ∀ (E : Set (Eucl D)) (Λ : ℝ≥0) (δ b : ℝ), LipschitzOnWith Λ f (thickening δ E) →
      (∀ x ∈ E, dist (f x) x ≤ b) → ∀ ε, 0 < ε → ε ≤ δ → ∀ x ∈ thickening ε E,
        dist x (f x) ≤ b + (1 + Λ) * ε := by
    intro E Λ δ b hLip hb ε hε hεδ x hx
    obtain ⟨y, hyE, hxy⟩ := mem_thickening_iff.1 hx
    have hxδ : x ∈ thickening δ E := thickening_mono hεδ E hx
    have hyδ : y ∈ thickening δ E := self_subset_thickening (hε.trans_le hεδ) E hyE
    have h1 := hLip.dist_le_mul y hyδ x hxδ
    have h2 := hb y hyE
    have h3 : dist x (f x) ≤ dist x y + dist y (f y) + dist (f y) (f x) := dist_triangle4 _ _ _ _
    rw [dist_comm y (f y)] at h3
    rw [dist_comm y x] at h1
    have h4 : (Λ : ℝ) * dist x y ≤ Λ * ε := mul_le_mul_of_nonneg_left hxy.le Λ.coe_nonneg
    linarith
  /- Properness of `f` on closed subsets of `E` (6.1): `f⁻¹(K) ∩ S ⊆ cthickening b K`. -/
  have hfprop : ∀ (E : Set (Eucl D)) (Λ : ℝ≥0) (δ b : ℝ) (S : Set (Eucl D)), IsClosed S → S ⊆ E →
      0 < δ → LipschitzOnWith Λ f (thickening δ E) → (∀ x ∈ E, dist (f x) x ≤ b) →
      ∀ K : Set (Eucl D), IsCompact K → IsCompact (f ⁻¹' K ∩ S) := by
    intro E Λ δ b S hS hSE hδ hLip hb K hK
    have hcont : ContinuousOn f S := hLip.continuousOn.mono
      ((self_subset_thickening hδ S).trans (thickening_subset_of_subset δ hSE))
    have hcl : IsClosed (f ⁻¹' K ∩ S) := by
      rw [inter_comm]; exact hcont.preimage_isClosed_of_isClosed hS hK.isClosed
    refine (hK.cthickening (r := b)).of_isClosed_subset hcl fun x hx => ?_
    exact mem_cthickening_of_dist_le x (f x) b K hx.1 (by rw [dist_comm]; exact hb x (hSE hx.2))
  /- `h` is Lipschitz near `[0, 1] × E` (6, computation of `L_h`). -/
  have hhLip : ∀ (E : Set (Eucl D)) (Λ : ℝ≥0) (δ b : ℝ), 0 < δ →
      LipschitzOnWith Λ f (thickening δ E) → (∀ x ∈ E, dist (f x) x ≤ b) →
      LipschitzOnWith (3 * Λ + 2 + Real.toNNReal (b + (1 + Λ) * δ)) h
        (thickening (min 1 δ / 2) {y : Eucl (D + 1) | tm y ∈ Icc (0 : ℝ) 1 ∧ tl y ∈ E}) := by
    intro E Λ δ b hδ hLip hb
    have hsub : thickening (min 1 δ / 2) {y : Eucl (D + 1) | tm y ∈ Icc (0 : ℝ) 1 ∧ tl y ∈ E} ⊆
        {y | tm y ∈ Icc (-2 : ℝ) 2 ∧ tl y ∈ thickening δ E} := by
      intro y hy
      obtain ⟨y₀, ⟨ht₀, hx₀⟩, hyy₀⟩ := mem_thickening_iff.1 hy
      have hm1 : min 1 δ ≤ 1 := min_le_left _ _
      have hm2 : min 1 δ ≤ δ := min_le_right _ _
      have h1 : |tm y - tm y₀| ≤ dist y y₀ := by rw [dist_eq_norm, ← map_sub]; exact htm_le _
      have h2 : dist (tl y) (tl y₀) ≤ dist y y₀ := by
        rw [dist_eq_norm, dist_eq_norm, ← map_sub]; exact htl_le _
      have h1' := abs_le.1 h1
      refine ⟨⟨by linarith [ht₀.1, h1'.1], by linarith [ht₀.2, h1'.2]⟩,
        mem_thickening_iff.2 ⟨tl y₀, hx₀, by linarith⟩⟩
    rw [show h = fun y => f (tl y) + tm y • (tl y - f (tl y)) from funext hh]
    exact (hLemH f Λ _ (thickening δ E) hLip fun x hx =>
      (hfdist E Λ δ b hLip hb δ hδ le_rfl x hx).trans (Real.le_coe_toNNReal _)).mono hsub
  /- `|h(t, x) − x| = (1 − t)|f x − x| ≤ b` on `[0, 1] × E` (6.6). -/
  have hhdist : ∀ (E : Set (Eucl D)) (b : ℝ), (∀ x ∈ E, dist (f x) x ≤ b) → ∀ y,
      tm y ∈ Icc (0 : ℝ) 1 → tl y ∈ E → dist (h y) (tl y) ≤ b := by
    intro E b hb y ht hx
    have e : h y - tl y = (1 - tm y) • (f (tl y) - tl y) := by
      rw [hh]; simp only [smul_sub, sub_smul, one_smul]; abel
    rw [dist_eq_norm, e, norm_smul, Real.norm_eq_abs, abs_of_nonneg (by linarith [ht.2]),
      ← dist_eq_norm]
    have h1 := hb _ hx
    have h0 : 0 ≤ dist (f (tl y)) (tl y) := dist_nonneg
    nlinarith [ht.1]
  /- Properness of `h` on closed subsets of `[0, 1] × E`. -/
  have hhprop : ∀ (E : Set (Eucl D)) (Λ : ℝ≥0) (δ b : ℝ) (C : Set (Eucl (D + 1))), IsClosed C →
      C ⊆ {y | tm y ∈ Icc (0 : ℝ) 1 ∧ tl y ∈ E} → 0 < δ → LipschitzOnWith Λ f (thickening δ E) →
      (∀ x ∈ E, dist (f x) x ≤ b) → ∀ K : Set (Eucl D), IsCompact K → IsCompact (h ⁻¹' K ∩ C) := by
    intro E Λ δ b C hC hCE hδ hLip hb K hK
    have hr : 0 < min 1 δ / 2 := by have := lt_min one_pos hδ; linarith
    have hcont : ContinuousOn h C := (hhLip E Λ δ b hδ hLip hb).continuousOn.mono
      (hCE.trans (self_subset_thickening hr _))
    have hcl : IsClosed (h ⁻¹' K ∩ C) := by
      rw [inter_comm]; exact hcont.preimage_isClosed_of_isClosed hC hK.isClosed
    refine (hcyl_compact _ (hK.cthickening (r := b))).of_isClosed_subset hcl ?_
    rintro y ⟨hyK, hyC⟩
    obtain ⟨ht, hx⟩ := hCE hyC
    exact ⟨ht, mem_cthickening_of_dist_le (tl y) (h y) b K hyK
      (by rw [dist_comm]; exact hhdist E b hb y ht hx)⟩
  /- Admissible approximations (Part 1, 5.5, 6.4, 6.11): from `smooth_approx`, `C^∞` maps
  `f_n → f` uniformly on `S_{δ/2}` with `‖Df_n‖ ≤ Λ` there, and the straight-line homotopies
  `ĥ_n(t, x) = f_n(x) + t (x − f_n(x))`, `C^∞`, converging uniformly to `h` near `[0, 1] × S` with
  eventually bounded derivatives; both are eventually proper. -/
  have hAPX : ∀ (E : Set (Eucl D)) (Λ : ℝ≥0) (δ b : ℝ) (S : Set (Eucl D)), IsClosed S → S ⊆ E →
      0 < δ → LipschitzOnWith Λ f (thickening δ E) → (∀ x ∈ E, dist (f x) x ≤ b) →
      ∃ (fn : ℕ → Eucl D → Eucl D) (hn : ℕ → Eucl (D + 1) → Eucl D) (L₂ : ℝ),
        (∀ n, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fn n)) ∧
        (∀ n, ∀ x ∈ thickening (δ / 2) S, ‖fderiv ℝ (fn n) x‖ ≤ Λ) ∧
        TendstoUniformlyOn fn f atTop (thickening (δ / 2) S) ∧
        (∀ᶠ n in atTop, ∀ K : Set (Eucl D), IsCompact K → IsCompact (fn n ⁻¹' K ∩ S)) ∧
        (∀ n y, hn n y = fn n (tl y) + tm y • (tl y - fn n (tl y))) ∧
        (∀ n, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (hn n)) ∧
        (∀ᶠ n in atTop, ∀ y ∈ {y : Eucl (D + 1) | tm y ∈ Ioo (-1 : ℝ) 2 ∧
          tl y ∈ thickening (δ / 2) S}, ‖fderiv ℝ (hn n) y‖ ≤ L₂) ∧
        TendstoUniformlyOn hn h atTop
          {y : Eucl (D + 1) | tm y ∈ Ioo (-1 : ℝ) 2 ∧ tl y ∈ thickening (δ / 2) S} ∧
        (∀ᶠ n in atTop, ∀ K : Set (Eucl D), IsCompact K →
          IsCompact (hn n ⁻¹' K ∩ {y : Eucl (D + 1) | tm y ∈ Icc (0 : ℝ) 1 ∧ tl y ∈ S})) := by
    intro E Λ δ b S hS hSE hδ hLip hb
    obtain ⟨fh, fn, L, -, hhGeq, hfns, -, hfnu, hfnd, -⟩ :=
      hSA D D f Λ S δ hδ (hLip.mono (thickening_subset_of_subset δ hSE))
    have hδ2 : 0 < δ / 2 := half_pos hδ
    have hunif : TendstoUniformlyOn fn f atTop (thickening (δ / 2) S) :=
      hfnu.tendstoUniformlyOn.congr_right (hhGeq.mono (thickening_mono (half_le_self hδ.le) S))
    have hS2E : thickening (δ / 2) S ⊆ thickening (δ / 2) E := thickening_subset_of_subset _ hSE
    have hxf : ∀ x ∈ thickening (δ / 2) S, dist x (f x) ≤ Real.toNNReal (b + (1 + Λ) * δ) :=
      fun x hx => (hfdist E Λ δ b hLip hb (δ / 2) hδ2 (half_le_self hδ.le) x (hS2E hx)).trans
        ((by nlinarith [Λ.coe_nonneg] : b + (1 + Λ) * (δ / 2) ≤ b + (1 + Λ) * δ).trans
          (Real.le_coe_toNNReal _))
    have hev1 : ∀ᶠ n in atTop, ∀ x ∈ thickening (δ / 2) S, dist (f x) (fn n x) < 1 :=
      Metric.tendstoUniformlyOn_iff.1 hunif 1 one_pos
    have hhns : ∀ n, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞)
        (fun y => fn n (tl y) + tm y • (tl y - fn n (tl y))) := fun n =>
      ((hfns n).comp tl.contDiff).add
        (tm.contDiff.smul (tl.contDiff.sub ((hfns n).comp tl.contDiff)))
    refine ⟨fn, fun n y => fn n (tl y) + tm y • (tl y - fn n (tl y)),
      ((3 * Λ + 2 + (Real.toNNReal (b + (1 + Λ) * δ) + 1) : ℝ≥0) : ℝ), hfns, hfnd, hunif, ?_,
      fun n y => rfl, hhns, ?_, ?_, ?_⟩
    · -- `f_n` is eventually proper on `S`
      filter_upwards [hev1] with n hn K hK
      have hcl : IsClosed (fn n ⁻¹' K ∩ S) := (hK.isClosed.preimage (hfns n).continuous).inter hS
      refine (hfprop E Λ δ b S hS hSE hδ hLip hb _ (hK.cthickening (r := 1))).of_isClosed_subset
        hcl ?_
      rintro x ⟨hxK, hxS⟩
      exact ⟨mem_cthickening_of_dist_le (f x) (fn n x) 1 K hxK
        (hn x (self_subset_thickening hδ2 S hxS)).le, hxS⟩
    · -- eventual derivative bound for `ĥ_n` near `[0, 1] × S`
      filter_upwards [hev1] with n hn y hy
      obtain ⟨ρ, hρ, hball⟩ := Metric.isOpen_iff.1 isOpen_thickening (tl y) hy.2
      have hLipU : LipschitzOnWith Λ (fn n) (ball (tl y) ρ) :=
        (convex_ball _ _).lipschitzOnWith_of_nnnorm_fderiv_le (𝕜 := ℝ)
          (fun x _ => ((hfns n).differentiable (by simp)).differentiableAt)
          (fun x hx => by rw [← NNReal.coe_le_coe, coe_nnnorm]; exact hfnd n x (hball hx))
      have hbU : ∀ x ∈ ball (tl y) ρ, dist x (fn n x) ≤
          ((Real.toNNReal (b + (1 + Λ) * δ) + 1 : ℝ≥0) : ℝ) := fun x hx => by
        have h1 := hxf x (hball hx)
        have h2 := (hn x (hball hx)).le
        push_cast
        linarith [dist_triangle x (f x) (fn n x)]
      have hL := hLemH (fn n) Λ (Real.toNNReal (b + (1 + Λ) * δ) + 1) _ hLipU hbU
      have hnhds : {y' : Eucl (D + 1) | tm y' ∈ Icc (-2 : ℝ) 2 ∧ tl y' ∈ ball (tl y) ρ} ∈ 𝓝 y := by
        refine Filter.mem_of_superset ((((isOpen_Ioo (a := (-2 : ℝ)) (b := 2)).preimage
          tm.continuous).inter (isOpen_ball.preimage tl.continuous)).mem_nhds
            ⟨⟨by linarith [hy.1.1], hy.1.2⟩, mem_ball_self hρ⟩) ?_
        exact fun y' hy' => ⟨Ioo_subset_Icc_self hy'.1, hy'.2⟩
      exact norm_fderiv_le_of_lipschitzOn ℝ hnhds hL
    · -- `ĥ_n → h` uniformly near `[0, 1] × S`: `h − ĥ_n = (1 − t)(f − f_n)`
      rw [Metric.tendstoUniformlyOn_iff]
      intro ε hε
      filter_upwards [Metric.tendstoUniformlyOn_iff.1 hunif (ε / 2) (half_pos hε)] with n hn y hy
      have e : h y - (fn n (tl y) + tm y • (tl y - fn n (tl y))) =
          (1 - tm y) • (f (tl y) - fn n (tl y)) := by
        rw [hh]; simp only [smul_sub, sub_smul, one_smul]; abel
      rw [dist_eq_norm, e, norm_smul, Real.norm_eq_abs, ← dist_eq_norm]
      have h1 : |1 - tm y| ≤ 2 := abs_le.2 ⟨by linarith [hy.1.2], by linarith [hy.1.1]⟩
      have h2 := hn (tl y) hy.2
      nlinarith [dist_nonneg (x := f (tl y)) (y := fn n (tl y)), abs_nonneg (1 - tm y)]
    · -- `ĥ_n` is eventually proper on `[0, 1] × S`
      filter_upwards [hev1] with n hn K hK
      have hcl : IsClosed ((fun y => fn n (tl y) + tm y • (tl y - fn n (tl y))) ⁻¹' K ∩
          {y : Eucl (D + 1) | tm y ∈ Icc (0 : ℝ) 1 ∧ tl y ∈ S}) :=
        (hK.isClosed.preimage (hhns n).continuous).inter (hcyl_closed S hS)
      refine (hcyl_compact _ (hK.cthickening (r := b + 1))).of_isClosed_subset hcl ?_
      rintro y ⟨hyK, ht, hx⟩
      refine ⟨ht, mem_cthickening_of_dist_le (tl y) _ (b + 1) K hyK ?_⟩
      have e : tl y - (fn n (tl y) + tm y • (tl y - fn n (tl y))) =
          (1 - tm y) • (tl y - fn n (tl y)) := by
        simp only [smul_sub, sub_smul, one_smul]; abel
      rw [dist_eq_norm, e, norm_smul, Real.norm_eq_abs, abs_of_nonneg (by linarith [ht.2]),
        ← dist_eq_norm]
      have h1 : dist (tl y) (fn n (tl y)) ≤ b + 1 := by
        have h3 := hb (tl y) (hSE hx)
        have h4 := (hn (tl y) (self_subset_thickening hδ2 S hx)).le
        linarith [dist_triangle (tl y) (f (tl y)) (fn n (tl y)), dist_comm (f (tl y)) (tl y)]
      nlinarith [ht.1, ht.2, dist_nonneg (x := tl y) (y := fn n (tl y))]
  /- Compatible forms along a sequence of eventually proper smooth maps (2.1, `compatible_form`). -/
  have hCF : ∀ (m m' k : ℕ) (A : Set (Eucl m)) (G : ℕ → Eucl m → Eucl m')
      (ω : TestFormOn (univ : Set (Eucl m')) k), (∀ n, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (G n)) →
      (∀ᶠ n in atTop, ∀ K : Set (Eucl m'), IsCompact K → IsCompact (G n ⁻¹' K ∩ A)) →
      ∃ ηj : ℕ → TestFormOn (univ : Set (Eucl m)) k, ∀ᶠ n in atTop, ∃ N : Set (Eucl m), IsOpen N ∧
        A ⊆ N ∧ ∀ x ∈ N, (ηj n : DifferentialForm (Eucl m) k) x =
          ((ω : DifferentialForm (Eucl m') k) (G n x)).compContinuousLinearMap
            (fderiv ℝ (G n) x) := by
    intro m m' k A G ω hG hprop
    have hex : ∀ n, ∃ η : TestFormOn (univ : Set (Eucl m)) k,
        (∀ K : Set (Eucl m'), IsCompact K → IsCompact (G n ⁻¹' K ∩ A)) →
        ∃ N : Set (Eucl m), IsOpen N ∧ A ⊆ N ∧ ∀ x ∈ N, (η : DifferentialForm (Eucl m) k) x =
          ((ω : DifferentialForm (Eucl m') k) (G n x)).compContinuousLinearMap
            (fderiv ℝ (G n) x) := by
      intro n
      by_cases hn : ∀ K : Set (Eucl m'), IsCompact K → IsCompact (G n ⁻¹' K ∩ A)
      · obtain ⟨η, -, N, hN, hAN, -, -, hηN, -⟩ :=
          Submission.iwl_sp_exists_compatible_testForm m m' k univ univ A (G n) isOpen_univ
            (subset_univ A) (hG n) (fun K hK _ => hn K hK) ω
        exact ⟨η, fun _ => ⟨N, hN, hAN, hηN⟩⟩
      · exact ⟨0, fun h' => absurd h' hn⟩
    choose ηj hηj using hex
    exact ⟨ηj, hprop.mono fun n hn => hηj n hn⟩
  /- The push-forwards of a current `Y` with admissible data (6.1–6.2): `P_k Y` is the Lipschitz
  push-forward of `Y` by `f`, `H_k Y` that of the product `Z = [[0,1]] × Y` by `h`. -/
  have key : ∀ (k : ℕ) (E : Set (Eucl D)) (Λ : ℝ≥0) (δ b : ℝ)
      (Y : GeometricCurrentOn (univ : Set (Eucl D)) k), IsClosed E → 0 < δ →
      LipschitzOnWith Λ f (thickening δ E) → (∀ x ∈ E, dist (f x) x ≤ b) → Y.mass < ∞ →
      (∀ (j : ℕ) (W : GeometricCurrentOn (univ : Set (Eucl D)) (j + 1)), k = j + 1 → HEq W Y →
        W.boundary.mass < ∞) → Y.support ⊆ E →
      LipPF D D k Y f (Pf k Y) ∧ (∀ S', LipPF D D k Y f S' → S' = Pf k Y) ∧
      (Pf k Y).mass ≤ (Λ : ℝ≥0∞) ^ k * Y.mass ∧ (Pf k Y).support ⊆ closure (f '' Y.support) ∧
      ∃ Z : GeometricCurrentOn (univ : Set (Eucl (D + 1))) (k + 1), PC D k Y Z ∧
        (∀ Z', PC D k Y Z' → Z' = Z) ∧
        Z.support ⊆ {y | tm y ∈ Icc (0 : ℝ) 1 ∧ tl y ∈ Y.support} ∧
        (∀ (η : TestFormOn (univ : Set (Eucl (D + 1))) (k + 1))
          (φ : ℝ → TestFormOn (univ : Set (Eucl D)) k), (∀ s ∈ Icc (0 : ℝ) 1, ∀ (x : Eucl D)
            (v : Fin k → Eucl D), (φ s : DifferentialForm (Eucl D) k) x v =
              (η : DifferentialForm (Eucl (D + 1)) (k + 1))
                ((EuclideanSpace.equiv (Fin (D + 1)) ℝ).symm
                  (Fin.cons s (EuclideanSpace.equiv (Fin D) ℝ x)))
                (Fin.cons (EuclideanSpace.single 0 1) fun i =>
                  (EuclideanSpace.equiv (Fin (D + 1)) ℝ).symm
                    (Fin.cons 0 (EuclideanSpace.equiv (Fin D) ℝ (v i))))) →
          ContinuousOn (fun s => Y (φ s)) (Icc (0 : ℝ) 1)) ∧
        LipPF (D + 1) D (k + 1) Z h (Hf k Y) ∧
        (∀ S', LipPF (D + 1) D (k + 1) Z h S' → S' = Hf k Y) ∧
        (Hf k Y).support ⊆ closure (h '' Z.support) := by
    intro k E Λ δ b Y hE hδ hLip hb hYm hYn hYE
    have hYcl := hsupp_closed D k Y
    obtain ⟨SP, hSP, hSPu, hSPm, hSPs⟩ := hLPF.1 D D k Y f Λ δ hYm hYn hδ
      (hLip.mono (thickening_subset_of_subset δ hYE)) (hfprop E Λ δ b Y.support hYcl hYE hδ hLip hb)
    have hPY : Pf k Y = SP := hPf k Y SP ((hLipPF _ _ _ _ _ _).2 hSP)
      (fun S' hS' => hSPu S' ((hLipPF _ _ _ _ _ _).1 hS'))
    obtain ⟨Z, hZ, hZu, hZm, hZs, hZc, hZn⟩ := hIP.1 D k Y hYm
    have hZm' : Z.mass < ∞ := lt_of_le_of_lt hZm hYm
    have hZn' : ∀ (j : ℕ) (W : GeometricCurrentOn (univ : Set (Eucl (D + 1))) (j + 1)),
        k + 1 = j + 1 → HEq W Z → W.boundary.mass < ∞ := by
      intro j W hj hW
      obtain rfl : k = j := Nat.succ.inj hj
      rw [eq_of_heq hW]
      exact hZn hYn
    have hZcyl : Z.support ⊆ {y | tm y ∈ Icc (0 : ℝ) 1 ∧ tl y ∈ Y.support} := by
      rw [← hcyl]; exact hZs
    have hZE : Z.support ⊆ {y | tm y ∈ Icc (0 : ℝ) 1 ∧ tl y ∈ E} :=
      hZcyl.trans fun y hy => ⟨hy.1, hYE hy.2⟩
    have hr : 0 < min 1 δ / 2 := by have := lt_min one_pos hδ; linarith
    obtain ⟨SH, hSH, hSHu, -, hSHs⟩ := hLPF.1 (D + 1) D (k + 1) Z h _ _ hZm' hZn' hr
      ((hhLip E Λ δ b hδ hLip hb).mono (thickening_subset_of_subset _ hZE))
      (hhprop E Λ δ b Z.support (hsupp_closed _ _ Z) hZE hδ hLip hb)
    have hHY : Hf k Y = SH := hHf k Y SH Z ((hPC _ _ _ _).2 hZ) ((hLipPF _ _ _ _ _ _).2 hSH)
      (fun Z' hZ' => hZu Z' ((hPC _ _ _ _).1 hZ'))
      (fun S' hS' => hSHu S' ((hLipPF _ _ _ _ _ _).1 hS'))
    rw [hPY, hHY]
    exact ⟨(hLipPF _ _ _ _ _ _).2 hSP, fun S' hS' => hSPu S' ((hLipPF _ _ _ _ _ _).1 hS'), hSPm,
      hSPs, Z, (hPC _ _ _ _).2 hZ, fun Z' hZ' => hZu Z' ((hPC _ _ _ _).1 hZ'), hZcyl, hZc,
      (hLipPF _ _ _ _ _ _).2 hSH, fun S' hS' => hSHu S' ((hLipPF _ _ _ _ _ _).1 hS'), hSHs⟩
  refine ⟨Pf, Hf, ?_, ?_⟩
  · /- Clause (I): the seven conjuncts for a current `X` with admissible data `(E, Λ, δ, b)`. -/
    intro k E Λ δ b X hE hδ hLip hb hXm hXn hXE
    obtain ⟨hPX, -, hPXm, hPXs, Z, hZ, -, hZcyl, hZc, hHX, -, hHXs⟩ :=
      key k E Λ δ b X hE hδ hLip hb hXm hXn hXE
    have hXcl := hsupp_closed D k X
    have hr : 0 < min 1 δ / 2 := by have := lt_min one_pos hδ; linarith
    have hZE : Z.support ⊆ {y | tm y ∈ Icc (0 : ℝ) 1 ∧ tl y ∈ E} :=
      hZcyl.trans fun y hy => ⟨hy.1, hXE hy.2⟩
    refine ⟨?_, ?_, hPXs, ?_, ?_, ?_, ?_⟩
    · -- (1) `M(P_k X) ≤ Λ^k M(X) ≤ c_k Λ^k M(X)` (6.3)
      refine hPXm.trans ?_
      rw [mul_assoc]
      exact le_mul_of_one_le_left zero_le (hc1 k)
    · -- (2) `M(H_k X) ≤ c_k b (1 + Λ)^k M(X)` (6.4), via the affine estimate of `smooth_homotopy`
      by_cases hb0 : 0 ≤ b
      · obtain ⟨fn, hn, L₂, hfns, hfnd, hfnu, hfnp, hhn, hhns, hhnd, hhnu, hhnp⟩ :=
          hAPX E Λ δ b X.support hXcl hXE hδ hLip hb
        have hOo : IsOpen {y : Eucl (D + 1) | tm y ∈ Ioo (-1 : ℝ) 2 ∧
            tl y ∈ thickening (δ / 2) X.support} :=
          (isOpen_Ioo.preimage tm.continuous).inter (isOpen_thickening.preimage tl.continuous)
        have hcylO : {y : Eucl (D + 1) | tm y ∈ Icc (0 : ℝ) 1 ∧ tl y ∈ X.support} ⊆
            {y : Eucl (D + 1) | tm y ∈ Ioo (-1 : ℝ) 2 ∧ tl y ∈ thickening (δ / 2) X.support} :=
          fun y hy => ⟨⟨by linarith [hy.1.1], by linarith [hy.1.2]⟩,
            self_subset_thickening (half_pos hδ) _ hy.2⟩
        have hXB : X.mass ≤ ENNReal.ofReal X.mass.toReal := (ENNReal.ofReal_toReal hXm.ne).ge
        have hΛ0 : (0 : ℝ) ≤ Λ := Λ.coe_nonneg
        have hc0k := hc₀ k
        -- for `0 < t ≤ δ/2`: `|H_k X(ψ)| ≤ c₀ (b + (1 + Λ) t + t) (1 + Λ)^k M(X)`
        have hbound : ∀ ψ ∈ massAdmissibleOn (univ : Set (Eucl D)) (k + 1) univ, ∀ t, 0 < t →
            t ≤ δ / 2 →
              |Hf k X ψ| ≤ c₀ k * (b + (1 + Λ) * t + t) * (1 + Λ) ^ k * X.mass.toReal := by
          intro ψ hψ t ht htδ
          obtain ⟨η', hη'⟩ := hCF (D + 1) D (k + 1)
            {y | tm y ∈ Icc (0 : ℝ) 1 ∧ tl y ∈ X.support} hn ψ hhns hhnp
          have hlim := (hLipPF _ _ _ _ _ _).1 hHX hn _ L₂ hOo (hZcyl.trans hcylO) hhns hhnd hhnu
            ψ η'
            (hη'.mono fun n ⟨N, hN, hcN, hηN⟩ => ⟨N, hN, hZcyl.trans hcN, hηN⟩)
          refine le_of_tendsto hlim.abs ?_
          filter_upwards [hη', hfnp, Metric.tendstoUniformlyOn_iff.1 hfnu t ht] with n hηn hpn hdn
          obtain ⟨N, hN, hcN, hηN⟩ := hηn
          have hGa : (fun y : Eucl (D + 1) => fn n ((EuclideanSpace.equiv (Fin D) ℝ).symm
              (Fin.tail (EuclideanSpace.equiv (Fin (D + 1)) ℝ y))) +
                (EuclideanSpace.equiv (Fin (D + 1)) ℝ y 0) •
                  (id ((EuclideanSpace.equiv (Fin D) ℝ).symm
                    (Fin.tail (EuclideanSpace.equiv (Fin (D + 1)) ℝ y))) -
                    fn n ((EuclideanSpace.equiv (Fin D) ℝ).symm
                      (Fin.tail (EuclideanSpace.equiv (Fin (D + 1)) ℝ y))))) = hn n :=
            funext fun y => by rw [hhn, htl, htm]; rfl
          have hO2 : thickening t X.support ⊆ thickening (δ / 2) X.support := thickening_mono htδ _
          have := hc₀aff k X Z (fn n) id (thickening t X.support) (b + (1 + Λ) * t + t) (1 + Λ)
            X.mass.toReal (by nlinarith) (by linarith) ENNReal.toReal_nonneg hXB
            ((hPC _ _ _ _).1 hZ) (hfns n) contDiff_id isOpen_thickening
            (self_subset_thickening ht _)
            (fun x hx => by
              have h1 := hfdist E Λ δ b hLip hb t ht (htδ.trans (half_le_self hδ.le)) x
                (thickening_subset_of_subset t hXE hx)
              have h2 := (hdn x (hO2 hx)).le
              rw [id]
              linarith [dist_triangle x (f x) (fn n x)])
            (fun x hx => (hfnd n x (hO2 hx)).trans (by linarith))
            (fun x _ => by rw [fderiv_id]; exact ContinuousLinearMap.norm_id_le.trans (by linarith))
            hpn ψ 1 (η' n) hψ.2 ⟨N, hN, by rw [hcyl]; exact hcN, by rw [hGa]; exact hηN⟩
          simpa using this
        -- let `t → 0⁺`
        have hbound0 : ∀ ψ ∈ massAdmissibleOn (univ : Set (Eucl D)) (k + 1) univ,
            |Hf k X ψ| ≤ c₀ k * b * (1 + Λ) ^ k * X.mass.toReal := by
          intro ψ hψ
          have hcont : Tendsto (fun t : ℝ => c₀ k * (b + (1 + Λ) * t + t) * (1 + Λ) ^ k *
              X.mass.toReal) (𝓝[>] 0) (𝓝 (c₀ k * (b + (1 + Λ) * 0 + 0) * (1 + Λ) ^ k *
                X.mass.toReal)) :=
            ((by fun_prop : Continuous fun t : ℝ => c₀ k * (b + (1 + Λ) * t + t) * (1 + Λ) ^ k *
              X.mass.toReal).tendsto 0).mono_left nhdsWithin_le_nhds
          have := ge_of_tendsto hcont (by
            filter_upwards [Ioo_mem_nhdsGT (half_pos hδ)] with t ht using
              hbound ψ hψ t ht.1 ht.2.le)
          simpa using this
        refine (hmass_le D (k + 1) (Hf k X) _ fun ψ hψ =>
          (le_abs_self _).trans (hbound0 ψ hψ)).trans ?_
        have hp1 : 0 ≤ c₀ k * b := mul_nonneg hc0k hb0
        have hp2 : 0 ≤ c₀ k * b * (1 + (Λ : ℝ)) ^ k := mul_nonneg hp1 (pow_nonneg (by linarith) k)
        rw [ENNReal.ofReal_mul hp2, ENNReal.ofReal_mul hp1, ENNReal.ofReal_mul hc0k,
          ENNReal.ofReal_pow (by linarith), ENNReal.ofReal_add zero_le_one hΛ0, ENNReal.ofReal_one,
          ENNReal.ofReal_coe_nnreal, ENNReal.ofReal_toReal hXm.ne]
        gcongr
        exact hcc₀ k
      · -- `b < 0`: then `E = ∅`, all supports are empty and `H_k X = 0`
        have hE0 : E ⊆ ∅ := fun x hx => by
          have h1 := hb x hx
          have h2 : 0 ≤ dist (f x) x := dist_nonneg
          exact absurd (h2.trans h1) hb0
        have hZe : Z.support ⊆ ∅ := fun y hy => hE0 (hXE (hZcyl hy).2)
        have hHe : (Hf k X).support ⊆ ∅ := by
          refine hHXs.trans ?_
          rw [subset_empty_iff.1 hZe, image_empty, closure_empty]
        rw [hmass_zero D (k + 1) (Hf k X) (hzero_of_supp D (k + 1) (Hf k X) hHe)]
        exact zero_le
    · -- (4) `spt H_k X ⊆ closure h([0, 1] × spt X) ⊆ cthickening b (spt X)` (6.6)
      refine hHXs.trans (closure_minimal ?_ isClosed_cthickening)
      rintro _ ⟨y, hy, rfl⟩
      obtain ⟨ht, hx⟩ := hZcyl hy
      exact mem_cthickening_of_dist_le (h y) (tl y) b X.support hx (hhdist E b hb y ht (hXE hx))
    · -- (5) integrality (6.7): `lipschitz_pushforward_im` with (S5′), `interval_product_im`
      intro hXim
      refine ⟨hLPFIM hS5 D D k X f Λ δ (Pf k X) hXim hδ
        (hLip.mono (thickening_subset_of_subset δ hXE))
        (hfprop E Λ δ b X.support hXcl hXE hδ hLip hb) ((hLipPF _ _ _ _ _ _).1 hPX), ?_⟩
      exact hLPFIM hS5 (D + 1) D (k + 1) Z h _ _ (Hf k X) (hIPIM D k X Z hXim ((hPC _ _ _ _).1 hZ))
        hr ((hhLip E Λ δ b hδ hLip hb).mono (thickening_subset_of_subset _ hZE))
        (hhprop E Λ δ b Z.support (hsupp_closed _ _ Z) hZE hδ hLip hb) ((hLipPF _ _ _ _ _ _).1 hHX)
    · -- (6) tangential vanishing (6.8): the mollified `f_n` kill `ω` near `spt X`
      intro α z ω ε hε hfz hωα
      obtain ⟨fh, fn, L, -, hhGeq, hfns, -, hfnu, hfnd, hfntan⟩ :=
        hSA D D f Λ X.support δ hδ (hLip.mono (thickening_subset_of_subset δ hXE))
      obtain ⟨r, hr0, hev⟩ := hfntan k α z ω ε hε hfz hωα
      have hunif : TendstoUniformlyOn fn f atTop (thickening (δ / 2) X.support) :=
        hfnu.tendstoUniformlyOn.congr_right (hhGeq.mono (thickening_mono (half_le_self hδ.le) _))
      have hlim := (hLipPF _ _ _ _ _ _).1 hPX fn (thickening (δ / 2) X.support) Λ isOpen_thickening
        (self_subset_thickening (half_pos hδ) _) hfns
        (Eventually.of_forall fun n x hx => hfnd n x hx) hunif ω (fun _ => 0)
        (hev.mono fun n hn => ⟨thickening r X.support, isOpen_thickening,
          self_subset_thickening hr0 _, fun x hx => by rw [hn x hx]; rfl⟩)
      have h0 : (fun _ : ℕ => X (0 : TestFormOn (univ : Set (Eucl D)) k)) = fun _ => 0 :=
        funext fun _ => map_zero X.toCurrent
      rw [h0] at hlim
      exact tendsto_nhds_unique hlim tendsto_const_nhds
    · -- (7) linearity (6.9): `lipschitz_pushforward` (III), products are linear in `X`
      intro X₁ X₂ a a₁ hX₁m hX₁n hX₁E hX₂
      have hX₂s : X₂.support ⊆ X.support ∪ X₁.support :=
        Submission.iwl_cr_support_lemmas.2.2 D k univ isOpen_univ X X₁ X₂ a a₁ hX₂
      have hX₂m : X₂.mass < ∞ := hmass_lin D k X X₁ X₂ a a₁ hXm hX₁m hX₂
      have hX₂n : ∀ (j : ℕ) (W : GeometricCurrentOn (univ : Set (Eucl D)) (j + 1)), k = j + 1 →
          HEq W X₂ → W.boundary.mass < ∞ := by
        intro j W hj hW
        subst hj
        rw [eq_of_heq hW]
        refine hmass_lin D j X.boundary X₁.boundary X₂.boundary a a₁ (hXn j X rfl HEq.rfl)
          (hX₁n j X₁ rfl HEq.rfl) fun ω => ?_
        rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.boundary_apply,
          GeometricCurrentOn.boundary_apply]
        exact hX₂ _
      have hUE : X.support ∪ X₁.support ⊆ E := union_subset hXE hX₁E
      obtain ⟨hP1, -, -, -, Z₁, hZ₁, -, hZ₁cyl, hZ₁c, hH1, -, -⟩ :=
        key k E Λ δ b X₁ hE hδ hLip hb hX₁m hX₁n hX₁E
      obtain ⟨hP2, -, -, -, Z₂, hZ₂, -, -, -, hH2, -, -⟩ :=
        key k E Λ δ b X₂ hE hδ hLip hb hX₂m hX₂n (hX₂s.trans hUE)
      refine ⟨hLPF.2.2 D D k X X₁ X₂ f Λ δ (Pf k X) (Pf k X₁) (Pf k X₂) a a₁ hδ
        (hLip.mono (thickening_subset_of_subset δ hUE))
        (hfprop E Λ δ b _ ((hsupp_closed D k X).union (hsupp_closed D k X₁)) hUE hδ hLip hb) hX₂
        ((hLipPF _ _ _ _ _ _).1 hPX) ((hLipPF _ _ _ _ _ _).1 hP1) ((hLipPF _ _ _ _ _ _).1 hP2), ?_⟩
      -- `[[0,1]] × X₂ = a [[0,1]] × X + a₁ [[0,1]] × X₁`
      have hZlin : ∀ η, Z₂ η = a * Z η + a₁ * Z₁ η := by
        intro η
        obtain ⟨φ, -, hφ⟩ := Submission.iwl_cr_ci_slice_testForm D k η
        have hφ' : ∀ s ∈ Icc (0 : ℝ) 1, ∀ (x : Eucl D) (v : Fin k → Eucl D),
