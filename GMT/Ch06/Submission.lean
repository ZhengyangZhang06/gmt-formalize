        have : Countable t := htc.to_subtype
        have hBm : ∀ i : t, MeasurableSet (closedBall (i : Eucl P) (rr i)) :=
          fun i => measurableSet_closedBall
        have hBd : Pairwise (Function.onFun Disjoint fun i : t => closedBall (i : Eucl P) (rr i)) :=
          fun i j hij => htdisj i.2 j.2 (fun h => hij (Subtype.ext h))
        set U : Set (Eucl P) := ⋃ i : t, closedBall (i : Eucl P) (rr i) with hUdef
        have hUm : MeasurableSet U := MeasurableSet.iUnion hBm
        have hAU : a ≤ μ U := by
          have hU' : (⋃ x ∈ t, closedBall x (rr x)) = U := Set.biUnion_eq_iUnion _ _
          rw [hU'] at htnull
          calc a = μ A₀ := rfl
            _ ≤ μ (A₀ \ U ∪ U) := measure_mono (fun y hy => by
                by_cases hyU : y ∈ U
                · exact Or.inr hyU
                · exact Or.inl ⟨hy, hyU⟩)
            _ ≤ μ (A₀ \ U) + μ U := measure_union_le _ _
            _ = μ U := by rw [htnull, zero_add]
        have hTω : T ω = ∫ y in Uᶜ, v' y ((ω : DifferentialForm (Eucl P) (m + 1)) y) ∂μ' +
            ∫ y in U, v' y ((ω : DifferentialForm (Eucl P) (m + 1)) y) ∂μ' := by
          rw [(hrep ω).2]
          exact (integral_add_compl hUm hint).symm.trans (add_comm _ _)
        have hsum : HasSum (fun i : t => ∫ y in closedBall (i : Eucl P) (rr i),
            v' y ((ω : DifferentialForm (Eucl P) (m + 1)) y) ∂μ')
            (∫ y in U, v' y ((ω : DifferentialForm (Eucl P) (m + 1)) y) ∂μ') :=
          hasSum_integral_iUnion hBm hBd hint.integrableOn
        obtain ⟨Rc, hRc⟩ := hμres Uᶜ hUm.compl
        have hcompl : ∫ y in Uᶜ, v' y ((ω : DifferentialForm (Eucl P) (m + 1)) y) ∂μ' ≤
            (μ Uᶜ).toReal := by
          rw [← hresval _ _ hRc ω]
          have h := habs Rc ω 1 (by rw [hresmass _ _ hRc]; exact measure_ne_top μ _) hω1
          rw [hresmass _ _ hRc, mul_one] at h
          exact (le_abs_self _).trans h
        set cl : ℝ := 9 / 2 * L * (1 / ((l : ℝ) + 1)) with hcl
        have hcl0 : 0 ≤ cl := by positivity
        have hball : ∀ i : t, ∫ y in closedBall (i : Eucl P) (rr i),
            v' y ((ω : DifferentialForm (Eucl P) (m + 1)) y) ∂μ' ≤
              (2⁻¹ + cl) * (μ (closedBall (i : Eucl P) (rr i))).toReal := by
          rintro ⟨x, hxt⟩
          have hr := htr x hxt
          obtain ⟨⟨hr0, hsp, -⟩, -, hrl⟩ := hr
          change ∫ y in closedBall x (rr x), v' y ((ω : DifferentialForm (Eucl P) (m + 1)) y) ∂μ' ≤
            (2⁻¹ + cl) * (μ (closedBall x (rr x))).toReal
          have hcb : ∫ y in closedBall x (rr x), v' y ((ω : DifferentialForm (Eucl P) (m + 1)) y) ∂μ' =
              AB x (rr x) ω := by
            rw [hresval _ _ (hAB x (rr x)) ω, hballSet]
            obtain ⟨Rs, hRs⟩ := hμres (sphere x (rr x)) isClosed_sphere.measurableSet
            have hs0 : ∫ y in sphere x (rr x), v' y ((ω : DifferentialForm (Eucl P) (m + 1)) y) ∂μ'
                = 0 := by
              rw [← hresval _ _ hRs ω]
              have h := habs Rs ω 1 (by rw [hresmass _ _ hRs]; exact measure_ne_top μ _) hω1
              rw [hresmass _ _ hRs, hsp, ENNReal.toReal_zero, zero_mul] at h
              exact abs_nonpos_iff.1 h
            have hdisj : Disjoint (ball x (rr x)) (sphere x (rr x)) :=
              Set.disjoint_left.2 fun y h1 h2 => by
                rw [mem_ball] at h1; rw [mem_sphere] at h2; linarith
            rw [← ball_union_sphere, setIntegral_union hdisj isClosed_sphere.measurableSet
              hint.integrableOn hint.integrableOn, hs0, add_zero]
          set Sx := SS ⟨x, hxt⟩ with hSxdef
          set Ax := AB x (rr x) with hAxdef
          let Zx : GeometricCurrentOn (univ : Set (Eucl P)) (m + 1) :=
            ⟨Sx.toCurrent - Ax.toCurrent, fun ωs h => by
              simpa using (Sx.continuous' ωs h).sub (Ax.continuous' ωs h)⟩
          have hZxapp : ∀ θ, Zx θ = Sx θ - Ax θ := fun θ => rfl
          have hZxb : Zx.boundary = 0 := by
            apply GeometricCurrentOn.ext
            intro θ
            have h := hSSb ⟨x, hxt⟩ θ
            rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.boundary_apply] at h
            rw [GeometricCurrentOn.boundary_apply, hZxapp, GeometricCurrentOn.zero_apply]
            rw [hSxdef, h, sub_self]
          have hZxv : ∀ θ : TestFormOn (univ : Set (Eucl P)) (m + 1),
              Disjoint (tsupport (θ : DifferentialForm (Eucl P) (m + 1)))
                (closedBall x (3 * rr x)) → Zx θ = 0 := by
            intro θ hθ
            rw [hZxapp, hSSv ⟨x, hxt⟩ θ hθ, hAxdef, hresval _ _ (hAB x (rr x)) θ, zero_sub,
              neg_eq_zero]
            apply setIntegral_eq_zero_of_forall_eq_zero
            intro y hy
            have hyb : y ∈ closedBall x (3 * rr x) := by
              have h := hy.2
              rw [mem_closedBall]
              linarith
            have h0 : (θ : DifferentialForm (Eucl P) (m + 1)) y = 0 :=
              image_eq_zero_of_notMem_tsupport (fun h => Set.disjoint_left.1 hθ h hyb)
            rw [h0, map_zero]
          have hSxfin : Sx.mass ≠ ∞ :=
            ne_top_of_le_ne_top (ENNReal.mul_ne_top (by norm_num) (measure_ne_top μ _))
              (hSSm ⟨x, hxt⟩)
          have hAxm : Ax.mass = μ (ball x (rr x)) := by
            rw [hAxdef, hresmass _ _ (hAB x (rr x)), hballSet]
          have hAxfin : Ax.mass ≠ ∞ := by rw [hAxm]; exact measure_ne_top μ _
          have hZxm : ∀ (θ : TestFormOn (univ : Set (Eucl P)) (m + 1)) (C : ℝ),
              (∀ y, covectorEuclideanNorm ((θ : DifferentialForm (Eucl P) (m + 1)) y) ≤ C) →
                |Zx θ| ≤ (Sx.mass.toReal + Ax.mass.toReal) * C := by
            intro θ C hC
            rw [hZxapp]
            calc |Sx θ - Ax θ| ≤ |Sx θ| + |Ax θ| := abs_sub _ _
              _ ≤ Sx.mass.toReal * C + Ax.mass.toReal * C :=
                add_le_add (habs Sx θ C hSxfin hC) (habs Ax θ C hAxfin hC)
              _ = (Sx.mass.toReal + Ax.mass.toReal) * C := by ring
          have hcone' := hL Zx x (3 * rr x) (Sx.mass.toReal + Ax.mass.toReal) (by linarith)
            (by positivity) hZxb hZxv hZxm
          have hμbc : μ (ball x (rr x)) ≤ μ (closedBall x (rr x)) :=
            measure_mono ball_subset_closedBall
          have hSxm' : Sx.mass.toReal ≤ 2⁻¹ * (μ (closedBall x (rr x))).toReal := by
            have h1 : Sx.mass ≤ 2⁻¹ * μ (closedBall x (rr x)) :=
              (hSSm ⟨x, hxt⟩).trans (mul_le_mul_of_nonneg_left hμbc bot_le)
            have h2 := ENNReal.toReal_mono (ENNReal.mul_ne_top (by norm_num) (measure_ne_top μ _)) h1
            rwa [ENNReal.toReal_mul, ENNReal.toReal_inv, ENNReal.toReal_ofNat] at h2
          have hAxm' : Ax.mass.toReal ≤ (μ (closedBall x (rr x))).toReal := by
            rw [hAxm]; exact ENNReal.toReal_mono (measure_ne_top μ _) hμbc
          have hSxω : Sx ω ≤ 2⁻¹ * (μ (closedBall x (rr x))).toReal := by
            have h := habs Sx ω 1 hSxfin hω1
            rw [mul_one] at h
            exact (le_abs_self _).trans (h.trans hSxm')
          have hK : Sx.mass.toReal + Ax.mass.toReal ≤ 3 / 2 * (μ (closedBall x (rr x))).toReal := by
            linarith
          have hZω : -Zx ω ≤ cl * (μ (closedBall x (rr x))).toReal := by
            have h1 := neg_le_abs (Zx ω)
            have h2 : (Sx.mass.toReal + Ax.mass.toReal) * L * (3 * rr x) ≤
                3 / 2 * (μ (closedBall x (rr x))).toReal * L * (3 * (1 / ((l : ℝ) + 1))) :=
              mul_le_mul (mul_le_mul_of_nonneg_right hK hL0) (by linarith)
                (by linarith) (mul_nonneg (by positivity) hL0)
            have h3 : 3 / 2 * (μ (closedBall x (rr x))).toReal * L * (3 * (1 / ((l : ℝ) + 1))) =
                cl * (μ (closedBall x (rr x))).toReal := by rw [hcl]; ring
            linarith
          have hAx : Ax ω = Sx ω - Zx ω := by rw [hZxapp]; ring
          rw [hcb, hAx]
          have h4 : (2⁻¹ + cl) * (μ (closedBall x (rr x))).toReal =
              2⁻¹ * (μ (closedBall x (rr x))).toReal + cl * (μ (closedBall x (rr x))).toReal := by
            ring
          linarith
        have hsum2 : HasSum (fun i : t => (2⁻¹ + cl) * (μ (closedBall (i : Eucl P) (rr i))).toReal)
            ((2⁻¹ + cl) * (μ U).toReal) := by
          apply HasSum.mul_left
          have h1 : μ U = ∑' i : t, μ (closedBall (i : Eucl P) (rr i)) := measure_iUnion hBd hBm
          rw [h1, ENNReal.tsum_toReal_eq (fun i => measure_ne_top μ _)]
          exact (ENNReal.summable_toReal (h1 ▸ measure_ne_top μ U)).hasSum
        have hUle : ∫ y in U, v' y ((ω : DifferentialForm (Eucl P) (m + 1)) y) ∂μ' ≤
            (2⁻¹ + cl) * (μ U).toReal := hasSum_le hball hsum hsum2
        have hμsplit : (μ Uᶜ).toReal + (μ U).toReal = (μ univ).toReal := by
          rw [← ENNReal.toReal_add (measure_ne_top μ _) (measure_ne_top μ _), add_comm,
            measure_add_measure_compl hUm]
        have haU' : a.toReal ≤ (μ U).toReal := ENNReal.toReal_mono (measure_ne_top μ _) hAU
        have hUuniv : (μ U).toReal ≤ (μ univ).toReal :=
          ENNReal.toReal_mono (measure_ne_top μ _) (measure_mono (subset_univ _))
        have hprod : 0 ≤ cl * ((μ univ).toReal - (μ U).toReal) :=
          mul_nonneg hcl0 (sub_nonneg.2 hUuniv)
        rw [hTω]
        have h5 : 9 / 2 * L * (μ univ).toReal * (1 / ((l : ℝ) + 1)) = cl * (μ univ).toReal := by
          rw [hcl]; ring
        rw [h5]
        nlinarith [hcompl, hUle]
      have htend : Tendsto (fun l : ℕ => (μ univ).toReal - a.toReal / 2 +
          9 / 2 * L * (μ univ).toReal * (1 / ((l : ℝ) + 1))) atTop
          (𝓝 ((μ univ).toReal - a.toReal / 2)) := by
        have h := (tendsto_one_div_add_atTop_nhds_zero_nat).const_mul
          (9 / 2 * L * (μ univ).toReal)
        have h' := h.const_add ((μ univ).toReal - a.toReal / 2)
        simpa using h'
      exact ge_of_tendsto' htend hl
    have hTm : T.mass ≤ ENNReal.ofReal ((μ univ).toReal - a.toReal / 2) := by
      apply sSup_le
      rintro _ ⟨ω, hω, rfl⟩
      exact ENNReal.ofReal_le_ofReal (hkey ω hω.2)
    have hlt : ENNReal.ofReal ((μ univ).toReal - a.toReal / 2) < μ univ := by
      rw [ENNReal.ofReal_lt_iff_lt_toReal (by linarith) (measure_ne_top μ univ)]
      linarith
    exact absurd (hTm.trans_lt (hlt.trans_eq hμuniv)) (lt_irrefl _)
  rw [ae_iff]
  refine measure_mono_null (fun x hx => ?_) hA₀
  have hx' : ¬ 0 < dimensionalUpperDensity μ.toOuterMeasure ((m + 1 : ℕ) : ℝ) univ x := hx
  rw [not_lt, nonpos_iff_eq_zero] at hx'
  show _ < ε₀
  rw [hx']
  exact hε₀pos
/-- Eilenberg finiteness: if `f : ℝ^N → ℝ^{m+1}` is Lipschitz and `E ⊆ ℝ^N` is Borel with
`H^{m+1}(E) < ∞`, then `E ∩ f⁻¹{y}` is finite for Lebesgue-a.e. `y ∈ ℝ^{m+1}`. -/
theorem Submission.rectifiability_bf_infinite_fibre_null : ∀ (N m : ℕ) (E : Set (Eucl N)) (f : Eucl N → Eucl (m + 1)) (K : ℝ≥0), MeasurableSet E → (μHE[m + 1] : Measure (Eucl N)) E < ∞ → LipschitzWith K f → (volume : Measure (Eucl (m + 1))) {y : Eucl (m + 1) | (E ∩ f ⁻¹' {y}).Infinite} = 0 := by
  intro N m E f K hE hEfin hf
  -- Step 1: `Lᵏ(f '' S) ≤ K ^ k * Hᵏ(S)` (`k = m + 1`), as `μHE[k] = volume` on `ℝᵏ`.
  have himage : ∀ S : Set (Eucl N), (volume : Measure (Eucl (m + 1))) (f '' S) ≤
      (K : ℝ≥0∞) ^ (m + 1) * μHE[m + 1] S := by
    intro S
    have h := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn
      (m + 1) (hf.lipschitzOnWith (s := S))
    rwa [EuclideanSpace.euclideanHausdorffMeasure_eq_volume] at h
  -- Step 2: the dyadic cubes `g i ⁻¹' {z}`, `g i x = (⌊2 ^ i * x j⌋)_j`, are Borel, and two
  -- distinct points lie in distinct cubes for all large `i`.
  set g : ℕ → Eucl N → (Fin N → ℤ) := fun i x j => ⌊(2 : ℝ) ^ i * x j⌋ with hg
  have hQm : ∀ i z, MeasurableSet (g i ⁻¹' {z}) := by
    intro i z
    have hQ : g i ⁻¹' {z} =
        ⋂ j, (fun x : Eucl N => (2 : ℝ) ^ i * x j) ⁻¹' Ico (z j : ℝ) (z j + 1) := by
      ext x
      simp [hg, funext_iff, Int.floor_eq_iff]
    rw [hQ]
    exact MeasurableSet.iInter fun j =>
      (by fun_prop : Measurable fun x : Eucl N => (2 : ℝ) ^ i * x j) measurableSet_Ico
  have hsep : ∀ x x' : Eucl N, x ≠ x' → ∀ᶠ i in atTop, g i x ≠ g i x' := by
    intro x x' hne
    obtain ⟨j, hj⟩ : ∃ j, x j ≠ x' j :=
      not_forall.1 fun h => hne (by ext j; exact h j)
    have hc : 0 < |x j - x' j| := abs_pos.2 (sub_ne_zero.2 hj)
    filter_upwards [((tendsto_pow_atTop_atTop_of_one_lt one_lt_two).atTop_mul_const
      hc).eventually_ge_atTop 1] with i hi heq
    have h1 := Int.abs_sub_lt_one_of_floor_eq_floor (congrFun heq j)
    rw [← mul_sub, abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 2 ^ i)] at h1
    linarith
  -- Step 3: `∑_z Hᵏ(E ∩ g i ⁻¹' {z}) = Hᵏ(E)`.
  have hsplit : ∀ i, ∑' z, (μHE[m + 1] : Measure (Eucl N)) (E ∩ g i ⁻¹' {z}) =
      μHE[m + 1] E := by
    intro i
    have hdisj : Pairwise (Function.onFun Disjoint fun z => E ∩ g i ⁻¹' {z}) := by
      intro z z' hzz'
      refine Set.disjoint_left.2 fun x hx hx' => hzz' ?_
      exact (show g i x = z from hx.2).symm.trans hx'.2
    have hU : (⋃ z, E ∩ g i ⁻¹' {z}) = E := by
      ext x
      simp
    rw [← measure_iUnion hdisj fun z => hE.inter (hQm i z), hU]
  -- Step 4: for Borel hulls `B i z ⊇ f '' (E ∩ g i ⁻¹' {z})`, the counts
  -- `n i = ∑_z 1_{B i z}` satisfy `∫ n i ≤ C := K ^ k * Hᵏ(E) < ∞`.
  set B : ℕ → (Fin N → ℤ) → Set (Eucl (m + 1)) :=
    fun i z => toMeasurable volume (f '' (E ∩ g i ⁻¹' {z})) with hB
  have hBm : ∀ i z, MeasurableSet (B i z) := fun i z => measurableSet_toMeasurable _ _
  set n : ℕ → Eucl (m + 1) → ℝ≥0∞ := fun i y => ∑' z, (B i z).indicator 1 y
  have hnm : ∀ i, Measurable (n i) := fun i =>
    Measurable.tsum fun z => measurable_one.indicator (hBm i z)
  set C : ℝ≥0∞ := (K : ℝ≥0∞) ^ (m + 1) * μHE[m + 1] E
  have hCfin : C < ∞ := ENNReal.mul_lt_top (ENNReal.pow_lt_top ENNReal.coe_lt_top) hEfin
  have hint : ∀ i, ∫⁻ y, n i y ≤ C := by
    intro i
    calc ∫⁻ y, n i y = ∑' z, ∫⁻ y, (B i z).indicator 1 y :=
          lintegral_tsum fun z => (measurable_one.indicator (hBm i z)).aemeasurable
      _ = ∑' z, volume (f '' (E ∩ g i ⁻¹' {z})) := by
          congr 1; ext z; rw [lintegral_indicator_one (hBm i z), hB, measure_toMeasurable]
      _ ≤ ∑' z, (K : ℝ≥0∞) ^ (m + 1) * μHE[m + 1] (E ∩ g i ⁻¹' {z}) :=
          ENNReal.tsum_le_tsum fun z => himage _
      _ = C := by rw [ENNReal.tsum_mul_left, hsplit i]
  -- Step 5: over an infinite fibre, `M ≤ n i y` for all large `i`, since `M` points of the
  -- fibre eventually lie in `M` distinct cubes.
  have hlarge : ∀ y ∈ {y : Eucl (m + 1) | (E ∩ f ⁻¹' {y}).Infinite}, ∀ M : ℕ,
      ∀ᶠ i in atTop, (M : ℝ≥0∞) ≤ n i y := by
    intro y hy M
    obtain ⟨T, hTsub, hTcard⟩ := Set.Infinite.exists_subset_card_eq hy M
    have hev : ∀ᶠ i in atTop, ∀ p ∈ T ×ˢ T, p.1 ≠ p.2 → g i p.1 ≠ g i p.2 := by
      refine (eventually_all_finset (T ×ˢ T)).2 fun p _ => ?_
      by_cases hp : p.1 = p.2
      · exact Eventually.of_forall fun i h => absurd hp h
      · exact (hsep p.1 p.2 hp).mono fun i hi _ => hi
    filter_upwards [hev] with i hi
    have hinj : InjOn (g i) T := by
      intro x hx x' hx' hxx'
      by_contra hne
      exact hi (x, x') (Finset.mem_product.2 ⟨hx, hx'⟩) hne hxx'
    calc (M : ℝ≥0∞) = ∑ z ∈ T.image (g i), (1 : ℝ≥0∞) := by
          rw [Finset.sum_const, Finset.card_image_of_injOn hinj, hTcard, nsmul_one]
      _ = ∑ z ∈ T.image (g i), (B i z).indicator 1 y := by
          refine Finset.sum_congr rfl fun z hz => ?_
          obtain ⟨x, hxT, rfl⟩ := Finset.mem_image.1 hz
          have hxE : x ∈ E ∩ f ⁻¹' {y} := hTsub (Finset.mem_coe.2 hxT)
          have hyB : y ∈ B i (g i x) := subset_toMeasurable _ _ ⟨x, ⟨hxE.1, rfl⟩, hxE.2⟩
          rw [indicator_of_mem hyB]
          rfl
      _ ≤ n i y := ENNReal.sum_le_tsum _
  -- Step 6: Fatou's lemma gives `∫ F ≤ C` for `F = liminf_i n i`, so `F < ∞` a.e.
  set F : Eucl (m + 1) → ℝ≥0∞ := fun y => liminf (fun i => n i y) atTop
  have hFm : Measurable F := Measurable.liminf hnm
  have hFint : ∫⁻ y, F y ≤ C :=
    (lintegral_liminf_le hnm).trans (liminf_le_of_frequently_le' (Frequently.of_forall hint))
  have hFae : ∀ᵐ y, F y < ∞ := ae_lt_top hFm (hFint.trans_lt hCfin).ne
  -- Step 7: the infinite fibres lie over the null set `{F = ∞}`.
  refine measure_mono_null (fun y hy => ?_) (ae_iff.1 hFae)
  have hFy : F y = ∞ := by
    refine top_unique ?_
    rw [← ENNReal.iSup_natCast]
    exact iSup_le fun M => le_liminf_of_le (by isBoundedDefault) (hlarge y hy M)
  simp [hFy]
/-- **Conical density lemma for purely unrectifiable sets** (Mattila, *Geometry of Sets and
Measures in Euclidean Spaces*, 15.13–15.15; Hovila–Järvenpää–Järvenpää–Ledrappier,
arXiv:1104.3453, Lemma 2.2).  Let `k = m + 1`, `L_v x = (⟨v₁, x⟩, …, ⟨v_k, x⟩) ∈ ℝᵏ` and
`X_v(a,r,s) = {x : |x - a| < r, |L_v(x - a)| < s |x - a|}`.  If `E ⊆ ℝ^N` is purely
`k`-unrectifiable, the set of `a ∈ E` at which, for every `η > 0`, some aperture `s ∈ (0,1)`
gives `Hᵏ(E ∩ X_v(a,r,s)) ≤ η (r s)ᵏ` for all `r ∈ (0,δ)` is `Hᵏ`-null.  The three steps of the
proof (the conical density estimate, the uniform density bound forcing measure zero, and the
reduction to rational apertures) are local `have`s of this single declaration. -/
theorem Submission.rectifiability_bf_cone_density : ∀ (N m : ℕ) (E : Set (Eucl N)) (v : Fin (m + 1) → Eucl N) (δ : ℝ), Poincare.SimonGMT.Chapter03.PurelyUnrectifiable (m + 1) E → 0 < δ → (μHE[m + 1] : Measure (Eucl N)) {a | a ∈ E ∧ ∀ η : ℝ, 0 < η → ∃ s ∈ Ioo (0 : ℝ) 1, ∀ r ∈ Ioo (0 : ℝ) δ, (μHE[m + 1] : Measure (Eucl N)) (E ∩ {x | dist x a < r ∧ ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (x - a)) : Eucl (m + 1))‖ < s * ‖x - a‖}) ≤ ENNReal.ofReal (η * (r * s) ^ (m + 1))} = 0 := by
  -- Step 1(a) (Mattila 15.13): a set on which `L_v` is bi-Lipschitz lies in a Lipschitz image of `ℝᵏ`, hence is countably `k`-rectifiable, hence null in the purely unrectifiable `E`.
  have graph_null : ∀ (N m : ℕ) (E F : Set (Eucl N)) (v : Fin (m + 1) → Eucl N) (c : ℝ), Poincare.SimonGMT.Chapter03.PurelyUnrectifiable (m + 1) E → F ⊆ E → 0 < c → (∀ a ∈ F, ∀ b ∈ F, c * ‖b - a‖ ≤ ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (b - a)) : Eucl (m + 1))‖) → (μHE[m + 1] : Measure (Eucl N)) F = 0 := by
    classical
    intro N m E F v c hE hFE hc hbi
    let L : Eucl N → Eucl (m + 1) := fun x => WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) x)
    have hLsub : ∀ x y, L x - L y = L (x - y) := by
      intro x y
      ext i
      simp only [L, PiLp.sub_apply]
      rw [← inner_sub_right]
    have hinj : InjOn L F := by
      intro a ha b hb hab
      have h1 := hbi a ha b hb
      have h2 : L (b - a) = 0 := by rw [← hLsub, hab, sub_self]
      change c * ‖b - a‖ ≤ ‖L (b - a)‖ at h1
      rw [h2, norm_zero] at h1
      have h3 : ‖b - a‖ ≤ 0 := by nlinarith [norm_nonneg (b - a)]
      exact (sub_eq_zero.1 (norm_le_zero_iff.1 h3)).symm
    let g : Eucl (m + 1) → Eucl N := Function.invFunOn L F
    have hg : ∀ a ∈ F, g (L a) = a := fun a ha => hinj.leftInvOn_invFunOn ha
    have hglip : LipschitzOnWith (Real.toNNReal c⁻¹) g (L '' F) := by
      apply LipschitzOnWith.of_dist_le_mul
      rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩
      rw [hg a ha, hg b hb, dist_eq_norm, dist_eq_norm, hLsub,
        Real.coe_toNNReal _ (inv_nonneg.2 hc.le)]
      have h1 : c * ‖a - b‖ ≤ ‖L (a - b)‖ := hbi b hb a ha
      rw [inv_mul_eq_div, le_div_iff₀ hc]
      linarith
    obtain ⟨G, hGlip, hGeq⟩ := hglip.extend_finite_dimension
    have hFrange : F ⊆ range G := fun a ha =>
      ⟨L a, (hGeq (mem_image_of_mem L ha)).symm.trans (hg a ha)⟩
    have hrect : CountablyRectifiable (m + 1) F :=
      (Poincare.SimonGMT.Chapter03.countablyRectifiable_range hGlip).mono hFrange
    exact hE F hFE hrect
  -- Step 1(b), geometry: with `h = h(a)` and a partner `b` with `3h/4 < |b - a| ≤ h` in the `s/4`-cone, the cylinder `{|L_v(x - a)| < sh/4}` meets `F` inside `X_v(a,2h,s) ∪ X_v(b,2h,s)`.
  have two_cone_cover : ∀ (N m : ℕ) (v : Fin (m + 1) → Eucl N) (F : Set (Eucl N)) (a b : Eucl N) (s h : ℝ), 0 < s → (∀ c ∈ F, ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (c - a)) : Eucl (m + 1))‖ < s / 4 * ‖c - a‖ → ‖c - a‖ ≤ h) → ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (b - a)) : Eucl (m + 1))‖ < s / 4 * ‖b - a‖ → 3 * h / 4 < ‖b - a‖ → ‖b - a‖ ≤ h → F ∩ {x | ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (x - a)) : Eucl (m + 1))‖ < s * h / 4} ⊆ {x | dist x a < 2 * h ∧ ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (x - a)) : Eucl (m + 1))‖ < s * ‖x - a‖} ∪ {x | dist x b < 2 * h ∧ ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (x - b)) : Eucl (m + 1))‖ < s * ‖x - b‖} := by
    intro N m v F a b s h hs hmax hb1 hb2 hb3
    have hh : 0 < h := by linarith [norm_nonneg (b - a)]
    have hlin : ∀ c : Eucl N,
        (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (c - b)) : Eucl (m + 1)) =
          WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (c - a)) +
            WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (a - b)) := by
      intro c
      ext i
      simp only [PiLp.add_apply]
      rw [← inner_add_right]
      congr 1
      abel
    have hneg : ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (a - b)) : Eucl (m + 1))‖ =
        ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (b - a)) : Eucl (m + 1))‖ := by
      rw [← norm_neg]
      congr 1
      ext i
      simp only [PiLp.neg_apply]
      rw [← inner_neg_right, neg_sub]
    rintro c ⟨hcF, hc⟩
    change ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (c - a)) : Eucl (m + 1))‖ <
      s * h / 4 at hc
    have hca : ‖c - a‖ ≤ h := by
      by_contra hlt
      push Not at hlt
      have hin : ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (c - a)) : Eucl (m + 1))‖ <
          s / 4 * ‖c - a‖ := by
        calc _ < s * h / 4 := hc
          _ < s / 4 * ‖c - a‖ := by nlinarith
      linarith [hmax c hcF hin]
    by_cases hfar : h / 4 ≤ ‖c - a‖
    · left
      refine ⟨by rw [dist_eq_norm]; linarith, ?_⟩
      calc _ < s * h / 4 := hc
        _ ≤ s * ‖c - a‖ := by nlinarith
    · right
      push Not at hfar
      have htri1 : ‖b - a‖ ≤ ‖c - b‖ + ‖c - a‖ := by
        calc ‖b - a‖ ≤ ‖b - c‖ + ‖c - a‖ := norm_sub_le_norm_sub_add_norm_sub b c a
          _ = ‖c - b‖ + ‖c - a‖ := by rw [norm_sub_rev b c]
      have htri2 : ‖c - b‖ ≤ ‖c - a‖ + ‖b - a‖ := by
        calc ‖c - b‖ ≤ ‖c - a‖ + ‖a - b‖ := norm_sub_le_norm_sub_add_norm_sub c a b
          _ = ‖c - a‖ + ‖b - a‖ := by rw [norm_sub_rev a b]
      have hcb1 : h / 2 < ‖c - b‖ := by linarith
      have hcb2 : ‖c - b‖ < 2 * h := by linarith
      refine ⟨by rw [dist_eq_norm]; exact hcb2, ?_⟩
      rw [hlin c]
      calc _ ≤ ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (c - a)) : Eucl (m + 1))‖ +
            ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (a - b)) : Eucl (m + 1))‖ :=
            norm_add_le _ _
        _ < s * h / 4 + s / 4 * ‖b - a‖ := by rw [hneg]; linarith
        _ ≤ s * h / 2 := by nlinarith
        _ < s * ‖c - b‖ := by nlinarith
  -- Step 1(c): Vitali covering (factor `τ = 2`, so `5r` enlargements) of the projected balls in `ℝᵏ`, countability, and the volume packing bound `Σ ρᵏ ≤ (M + R)ᵏ`.
  have vitali_packing : ∀ (N m : ℕ) (A : Set (Eucl N)) (y : Eucl N → Eucl (m + 1)) (ρ : Eucl N → ℝ) (y₀ : Eucl (m + 1)) (R M : ℝ), (∀ a ∈ A, 0 < ρ a ∧ ρ a ≤ R) → (∀ a ∈ A, dist (y a) y₀ ≤ M) → ∃ I : Set (Eucl N), I ⊆ A ∧ I.Countable ∧ I.PairwiseDisjoint (fun b => ball (y b) (ρ b)) ∧ (∀ a ∈ A, ∃ b ∈ I, ball (y a) (ρ a) ⊆ ball (y b) (5 * ρ b)) ∧ ∑' b : I, ENNReal.ofReal (ρ b ^ (m + 1)) ≤ ENNReal.ofReal ((M + R) ^ (m + 1)) := by
    intro N m A y ρ y₀ R M hρ hy
    obtain ⟨u, huA, hudisj, hucov⟩ := Vitali.exists_disjoint_subfamily_covering_enlargement
      (fun a => ball (y a) (ρ a)) A ρ 2 one_lt_two (fun a ha => (hρ a ha).1.le) R
      (fun a ha => (hρ a ha).2) (fun a ha => nonempty_ball.2 (hρ a ha).1)
    have hucount : u.Countable := hudisj.countable_of_isOpen (fun a _ => isOpen_ball)
      (fun a ha => nonempty_ball.2 (hρ a (huA ha)).1)
    refine ⟨u, huA, hucount, hudisj, ?_, ?_⟩
    · intro a ha
      obtain ⟨b, hbu, ⟨z, hza, hzb⟩, hab⟩ := hucov a ha
      refine ⟨b, hbu, fun w hw => ?_⟩
      rw [mem_ball] at hw hza hzb ⊢
      calc dist w (y b) ≤ dist w (y a) + dist (y a) z + dist z (y b) := dist_triangle4 _ _ _ _
        _ < ρ a + ρ a + ρ b := by rw [dist_comm (y a) z]; linarith
        _ ≤ 5 * ρ b := by linarith
    · rcases u.eq_empty_or_nonempty with hu | ⟨b₀, hb₀⟩
      · subst hu
        simp
      have hR : 0 < R := (hρ b₀ (huA hb₀)).1.trans_le (hρ b₀ (huA hb₀)).2
      have hM : 0 ≤ M := dist_nonneg.trans (hy b₀ (huA hb₀))
      set μ : Measure (Eucl (m + 1)) := volume with hμ
      have hω0 : μ (ball 0 1) ≠ 0 := (measure_ball_pos μ 0 one_pos).ne'
      have hωtop : μ (ball 0 1) ≠ ⊤ := measure_ball_lt_top.ne
      have hfin : Module.finrank ℝ (Eucl (m + 1)) = m + 1 := finrank_euclideanSpace_fin
      have hsub : (⋃ b ∈ u, ball (y b) (ρ b)) ⊆ ball y₀ (M + R) := by
        intro w hw
        obtain ⟨b, hbu, hwb⟩ := mem_iUnion₂.1 hw
        rw [mem_ball] at hwb ⊢
        calc dist w y₀ ≤ dist w (y b) + dist (y b) y₀ := dist_triangle _ _ _
          _ < ρ b + M := by linarith [hy b (huA hbu)]
          _ ≤ M + R := by linarith [(hρ b (huA hbu)).2]
      have key : (∑' b : u, ENNReal.ofReal (ρ b ^ (m + 1))) * μ (ball 0 1) ≤
          ENNReal.ofReal ((M + R) ^ (m + 1)) * μ (ball 0 1) := by
        rw [← ENNReal.tsum_mul_right]
        calc ∑' b : u, ENNReal.ofReal (ρ b ^ (m + 1)) * μ (ball 0 1)
            = ∑' b : u, μ (ball (y b) (ρ b)) := by
              congr 1
              funext b
              rw [Measure.addHaar_ball_of_pos μ _ (hρ b (huA b.2)).1, hfin]
          _ = μ (⋃ b ∈ u, ball (y b) (ρ b)) :=
              (measure_biUnion hucount hudisj (fun b _ => measurableSet_ball)).symm
          _ ≤ μ (ball y₀ (M + R)) := measure_mono hsub
          _ = ENNReal.ofReal ((M + R) ^ (m + 1)) * μ (ball 0 1) := by
              rw [Measure.addHaar_ball μ _ (by linarith), hfin]
      exact (ENNReal.mul_le_mul_iff_left hω0 hωtop).1 key
  -- Step 1 (Mattila 15.14): the conical density estimate `Hᵏ(B ∩ B(x₀,δ′/6)) ≤ C₁ λ δ′ᵏ`, `C₁ = 2(20/3)ᵏ(‖L_v‖ + 1)ᵏ`.
  have conical_density_estimate : ∀ (N m : ℕ) (E : Set (Eucl N)) (v : Fin (m + 1) → Eucl N), Poincare.SimonGMT.Chapter03.PurelyUnrectifiable (m + 1) E → ∃ C₁ : ℝ, 0 < C₁ ∧ ∀ (B : Set (Eucl N)) (s δ' l : ℝ), B ⊆ E → 0 < s → s < 1 → 0 < δ' → 0 ≤ l → (∀ a ∈ B, ∀ r : ℝ, 0 < r → r ≤ δ' → (μHE[m + 1] : Measure (Eucl N)) (E ∩ {x | dist x a < r ∧ ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (x - a)) : Eucl (m + 1))‖ < s * ‖x - a‖}) ≤ ENNReal.ofReal (l * (r * s) ^ (m + 1))) → ∀ x₀ : Eucl N, (μHE[m + 1] : Measure (Eucl N)) (B ∩ ball x₀ (δ' / 6)) ≤ ENNReal.ofReal (C₁ * l * δ' ^ (m + 1)) := by
    intro N m E v hE
    -- the linear map `L_v` and an operator-norm bound `Λ`
    let Lₗ : Eucl N →ₗ[ℝ] Eucl (m + 1) :=
      { toFun := fun x => WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) x)
        map_add' := fun x y => by
          ext i
          simp [inner_add_right]
        map_smul' := fun c x => by
          ext i
          simp [inner_smul_right] }
    let Lc : Eucl N →L[ℝ] Eucl (m + 1) := LinearMap.toContinuousLinearMap Lₗ
    let L : Eucl N → Eucl (m + 1) := fun x => WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) x)
    have hLc : ∀ x, Lc x = L x := fun x => rfl
    set Λ : ℝ := ‖Lc‖ with hΛ
    have hΛ0 : 0 ≤ Λ := norm_nonneg _
    have hLsub : ∀ x y, L x - L y = L (x - y) := fun x y => by
      rw [← hLc, ← hLc, ← hLc]; exact (map_sub Lc x y).symm
    have hLbound : ∀ x, ‖L x‖ ≤ Λ * ‖x‖ := fun x => by
      rw [← hLc]; exact Lc.le_opNorm x
    have hL0 : L 0 = 0 := by rw [← hLc]; exact map_zero Lc
    refine ⟨2 * (20 / 3) ^ (m + 1) * (Λ + 1) ^ (m + 1), by positivity, ?_⟩
    intro B s δ' l hBE hs0 hs1 hδ' hl hcone x₀
    set F : Set (Eucl N) := B ∩ ball x₀ (δ' / 6) with hFdef
    have hFB : F ⊆ B := inter_subset_left
    have hFE : F ⊆ E := hFB.trans hBE
    have hFdist : ∀ a ∈ F, ∀ b ∈ F, ‖b - a‖ < δ' / 3 := by
      intro a ha b hb
      have h1 : dist a x₀ < δ' / 6 := ha.2
      have h2 : dist b x₀ < δ' / 6 := hb.2
      rw [← dist_eq_norm]
      calc dist b a ≤ dist b x₀ + dist a x₀ := dist_triangle_right b a x₀
        _ < δ' / 6 + δ' / 6 := add_lt_add h2 h1
        _ = δ' / 3 := by ring
    -- the partition `F = F₀ ∪ F₁`
    set F₀ : Set (Eucl N) := {a | a ∈ F ∧ ∀ b ∈ F, s / 4 * ‖b - a‖ ≤ ‖L (b - a)‖} with hF₀def
    set F₁ : Set (Eucl N) := {a | a ∈ F ∧ ∃ b ∈ F, ‖L (b - a)‖ < s / 4 * ‖b - a‖} with hF₁def
    have hFsplit : F ⊆ F₀ ∪ F₁ := by
      intro a ha
      by_cases h : ∃ b ∈ F, ‖L (b - a)‖ < s / 4 * ‖b - a‖
      · exact Or.inr ⟨ha, h⟩
      · push Not at h
        exact Or.inl ⟨ha, h⟩
    -- (a) graph part
    have hF₀null : (μHE[m + 1] : Measure (Eucl N)) F₀ = 0 :=
      graph_null N m E F₀ v (s / 4) hE (fun a ha => hFE ha.1)
        (by positivity) (fun a ha b hb => ha.2 b hb.1)
    -- (b) the function `h`
    let hfun : Eucl N → ℝ := fun a =>
      sSup ((fun b => ‖b - a‖) '' {b | b ∈ F ∧ ‖L (b - a)‖ < s / 4 * ‖b - a‖})
    have hbdd : ∀ a ∈ F,
        BddAbove ((fun b => ‖b - a‖) '' {b | b ∈ F ∧ ‖L (b - a)‖ < s / 4 * ‖b - a‖}) := by
      intro a ha
      refine ⟨δ' / 3, ?_⟩
      rintro t ⟨b, hb, rfl⟩
      exact (hFdist a ha b hb.1).le
    have hS_le : ∀ a ∈ F, ∀ c ∈ F, ‖L (c - a)‖ < s / 4 * ‖c - a‖ → ‖c - a‖ ≤ hfun a := by
      intro a ha c hc hc'
      exact le_csSup (hbdd a ha) ⟨c, ⟨hc, hc'⟩, rfl⟩
    have hpos : ∀ a ∈ F₁, 0 < hfun a := by
      rintro a ⟨ha, b, hb, hlt⟩
      have hba : b ≠ a := by
        rintro rfl
        simp only [sub_self, hL0, norm_zero, mul_zero, lt_self_iff_false] at hlt
      have : 0 < ‖b - a‖ := norm_pos_iff.2 (sub_ne_zero.2 hba)
      exact this.trans_le (hS_le a ha b hb hlt)
    have hle : ∀ a ∈ F₁, hfun a ≤ δ' / 3 := by
      rintro a ⟨ha, b, hb, hlt⟩
      refine csSup_le ⟨‖b - a‖, ⟨b, ⟨hb, hlt⟩, rfl⟩⟩ ?_
      rintro t ⟨c, hc, rfl⟩
      exact (hFdist a ha c hc.1).le
    have hpartner : ∀ a ∈ F₁, ∃ b ∈ F, ‖L (b - a)‖ < s / 4 * ‖b - a‖ ∧
        3 * hfun a / 4 < ‖b - a‖ ∧ ‖b - a‖ ≤ hfun a := by
      intro a haF₁
      have hp := hpos a haF₁
      obtain ⟨ha, b, hb, hlt⟩ := haF₁
      have hne : ((fun b => ‖b - a‖) '' {b | b ∈ F ∧ ‖L (b - a)‖ < s / 4 * ‖b - a‖}).Nonempty :=
        ⟨‖b - a‖, ⟨b, ⟨hb, hlt⟩, rfl⟩⟩
      obtain ⟨t, ⟨c, hc, rfl⟩, htc⟩ := exists_lt_of_lt_csSup hne
        (show 3 * hfun a / 4 < hfun a by linarith)
      exact ⟨c, hc.1, hc.2, htc, hS_le a ha c hc.1 hc.2⟩
    -- two cones cover each cylinder
    have hcyl : ∀ a ∈ F₁, (μHE[m + 1] : Measure (Eucl N)) (F ∩ {x | ‖L (x - a)‖ < s * hfun a / 4}) ≤
        2 * ENNReal.ofReal (l * (2 * hfun a * s) ^ (m + 1)) := by
      intro a haF₁
      obtain ⟨b, hbF, hb1, hb2, hb3⟩ := hpartner a haF₁
      have haF : a ∈ F := haF₁.1
      have hincl := two_cone_cover N m v F a b s (hfun a) hs0
        (hS_le a haF) hb1 hb2 hb3
      have h2h0 : 0 < 2 * hfun a := by linarith [hpos a haF₁]
      have h2hle : 2 * hfun a ≤ δ' := by linarith [hle a haF₁]
      calc (μHE[m + 1] : Measure (Eucl N)) (F ∩ {x | ‖L (x - a)‖ < s * hfun a / 4})
          ≤ (μHE[m + 1] : Measure (Eucl N))
              ((E ∩ {x | dist x a < 2 * hfun a ∧ ‖L (x - a)‖ < s * ‖x - a‖}) ∪
                (E ∩ {x | dist x b < 2 * hfun a ∧ ‖L (x - b)‖ < s * ‖x - b‖})) := by
            apply measure_mono
            intro x hx
            rcases hincl hx with h | h
            · exact Or.inl ⟨hFE hx.1, h⟩
            · exact Or.inr ⟨hFE hx.1, h⟩
        _ ≤ (μHE[m + 1] : Measure (Eucl N))
              (E ∩ {x | dist x a < 2 * hfun a ∧ ‖L (x - a)‖ < s * ‖x - a‖}) +
            (μHE[m + 1] : Measure (Eucl N))
              (E ∩ {x | dist x b < 2 * hfun a ∧ ‖L (x - b)‖ < s * ‖x - b‖}) :=
            measure_union_le _ _
        _ ≤ ENNReal.ofReal (l * (2 * hfun a * s) ^ (m + 1)) +
            ENNReal.ofReal (l * (2 * hfun a * s) ^ (m + 1)) :=
            add_le_add (hcone a (hFB haF) _ h2h0 h2hle) (hcone b (hFB hbF) _ h2h0 h2hle)
        _ = 2 * ENNReal.ofReal (l * (2 * hfun a * s) ^ (m + 1)) := (two_mul _).symm
    -- (c) Vitali covering of the projected balls
    obtain ⟨I, hIF₁, hIcount, -, hIcover, hIsum⟩ :=
      vitali_packing N m F₁ L (fun a => s * hfun a / 20) (L x₀)
        (s * δ' / 60) (Λ * δ' / 6)
        (fun a ha => by
          have h1 := hpos a ha
          have h2 := hle a ha
          refine ⟨by positivity, ?_⟩
          calc s * hfun a / 20 ≤ s * (δ' / 3) / 20 := by gcongr
            _ = s * δ' / 60 := by ring)
        (fun a ha => by
          have hax : ‖a - x₀‖ < δ' / 6 := by
            have := ha.1.2
            rwa [mem_ball, dist_eq_norm] at this
          rw [dist_eq_norm, hLsub]
          calc ‖L (a - x₀)‖ ≤ Λ * ‖a - x₀‖ := hLbound _
            _ ≤ Λ * (δ' / 6) := mul_le_mul_of_nonneg_left hax.le hΛ0
            _ = Λ * δ' / 6 := by ring)
    -- (d) covering of `F`
    have hcover : F ⊆ F₀ ∪ ⋃ b ∈ I, (F ∩ {x | ‖L (x - b)‖ < s * hfun b / 4}) := by
      intro a ha
      rcases hFsplit ha with h0 | h1
      · exact Or.inl h0
      · right
        obtain ⟨b, hbI, hsub⟩ := hIcover a h1
        have hmem : L a ∈ ball (L a) (s * hfun a / 20) := by
          have := hpos a h1
          exact mem_ball_self (by positivity)
        have hab := hsub hmem
        rw [mem_ball, dist_eq_norm, hLsub] at hab
        refine mem_iUnion₂.2 ⟨b, hbI, ha, ?_⟩
        show ‖L (a - b)‖ < s * hfun b / 4
        linarith
    -- (e) the estimate
    have hsum' : ∑' b : I, ENNReal.ofReal ((s * hfun b / 20) ^ (m + 1)) ≤
        ENNReal.ofReal ((Λ * δ' / 6 + s * δ' / 60) ^ (m + 1)) := hIsum
    calc (μHE[m + 1] : Measure (Eucl N)) (B ∩ ball x₀ (δ' / 6))
        = (μHE[m + 1] : Measure (Eucl N)) F := rfl
      _ ≤ (μHE[m + 1] : Measure (Eucl N))
            (F₀ ∪ ⋃ b ∈ I, (F ∩ {x | ‖L (x - b)‖ < s * hfun b / 4})) := measure_mono hcover
      _ ≤ (μHE[m + 1] : Measure (Eucl N)) F₀ + (μHE[m + 1] : Measure (Eucl N))
            (⋃ b ∈ I, (F ∩ {x | ‖L (x - b)‖ < s * hfun b / 4})) := measure_union_le _ _
      _ ≤ 0 + ∑' b : I, (μHE[m + 1] : Measure (Eucl N))
            (F ∩ {x | ‖L (x - b)‖ < s * hfun b / 4}) := by
          rw [hF₀null]
          gcongr
          exact measure_biUnion_le _ hIcount _
      _ ≤ ∑' b : I, 2 * ENNReal.ofReal (l * (2 * hfun b * s) ^ (m + 1)) := by
          rw [zero_add]
          exact ENNReal.tsum_le_tsum fun b => hcyl b (hIF₁ b.2)
      _ = ∑' b : I, ENNReal.ofReal (2 * l * 40 ^ (m + 1)) *
            ENNReal.ofReal ((s * hfun b / 20) ^ (m + 1)) := by
          congr 1
          funext b
          have hreal : 2 * l * 40 ^ (m + 1) * (s * hfun b / 20) ^ (m + 1) =
              2 * (l * (2 * hfun b * s) ^ (m + 1)) := by
            rw [show 2 * hfun b * s = 40 * (s * hfun b / 20) by ring, mul_pow]
            ring
          have h40 : (0 : ℝ) ≤ 2 * l * 40 ^ (m + 1) := mul_nonneg (mul_nonneg (by norm_num) hl) (by positivity)
          rw [← ENNReal.ofReal_mul h40, hreal, ENNReal.ofReal_mul (p := 2) (by norm_num),
            ENNReal.ofReal_ofNat]
      _ = ENNReal.ofReal (2 * l * 40 ^ (m + 1)) *
            ∑' b : I, ENNReal.ofReal ((s * hfun b / 20) ^ (m + 1)) := ENNReal.tsum_mul_left
      _ ≤ ENNReal.ofReal (2 * l * 40 ^ (m + 1)) *
            ENNReal.ofReal ((Λ * δ' / 6 + s * δ' / 60) ^ (m + 1)) := by gcongr
      _ = ENNReal.ofReal (2 * l * 40 ^ (m + 1) * (Λ * δ' / 6 + s * δ' / 60) ^ (m + 1)) :=
          (ENNReal.ofReal_mul (mul_nonneg (mul_nonneg (by norm_num) hl) (by positivity))).symm
      _ ≤ ENNReal.ofReal (2 * (20 / 3) ^ (m + 1) * (Λ + 1) ^ (m + 1) * l * δ' ^ (m + 1)) := by
          apply ENNReal.ofReal_le_ofReal
          have h1 : Λ * δ' / 6 + s * δ' / 60 ≤ (Λ + 1) * δ' / 6 := by nlinarith
          have h2 : (Λ * δ' / 6 + s * δ' / 60) ^ (m + 1) ≤ ((Λ + 1) * δ' / 6) ^ (m + 1) :=
            pow_le_pow_left₀ (by positivity) h1 _
          calc 2 * l * 40 ^ (m + 1) * (Λ * δ' / 6 + s * δ' / 60) ^ (m + 1)
              ≤ 2 * l * 40 ^ (m + 1) * ((Λ + 1) * δ' / 6) ^ (m + 1) := by gcongr
            _ = 2 * (20 / 3) ^ (m + 1) * (Λ + 1) ^ (m + 1) * l * δ' ^ (m + 1) := by
                rw [show (Λ + 1) * δ' / 6 = (Λ + 1) * δ' * (1 / 6) by ring, mul_pow, mul_pow,
                  show (20 / 3 : ℝ) = 40 * (1 / 6) by norm_num, mul_pow]
                ring
  -- Step 2 (Mattila 6.2(1), uniform form): `Hᵏ(B ∩ B̄(x,ρ)) ≤ (c_k/2) ρᵏ` for `x ∈ B`, `ρ ≤ ρ₀` forces `Hᵏ(B) = 0`, where `μHE[k] = c_k • μH[k]`.
  have uniform_density_null : ∀ (N m : ℕ), ∃ c : ℝ, 0 < c ∧ ∀ (B : Set (Eucl N)) (ρ₀ : ℝ), 0 < ρ₀ → (∀ x ∈ B, ∀ ρ : ℝ, 0 < ρ → ρ ≤ ρ₀ → (μHE[m + 1] : Measure (Eucl N)) (B ∩ closedBall x ρ) ≤ ENNReal.ofReal (c * ρ ^ (m + 1))) → (μHE[m + 1] : Measure (Eucl N)) B = 0 := by
    intro N m
    set κ : ℝ≥0 := Measure.addHaarScalarFactor (volume : Measure (EuclideanSpace ℝ (Fin (m + 1))))
      (μH[((m + 1 : ℕ) : ℝ)] : Measure (EuclideanSpace ℝ (Fin (m + 1)))) with hκ
    have hκ0 : κ ≠ 0 := Measure.addHaarScalarFactor_volume_hausdorffMeasure_ne_zero (m + 1)
    have hκ0' : (κ : ℝ≥0∞) ≠ 0 := by exact_mod_cast hκ0
    have hdef : ∀ S : Set (Eucl N), (μHE[m + 1] : Measure (Eucl N)) S =
        (κ : ℝ≥0∞) * (μH[((m + 1 : ℕ) : ℝ)] : Measure (Eucl N)) S := by
      intro S
      rw [Measure.euclideanHausdorffMeasure_def, Measure.smul_apply, ENNReal.smul_def, smul_eq_mul]
    have hκpos : (0 : ℝ) < κ := NNReal.coe_pos.2 (pos_iff_ne_zero.2 hκ0)
    refine ⟨(κ : ℝ) / 2, div_pos hκpos two_pos, ?_⟩
    intro B ρ₀ hρ₀ hB
    set c : ℝ := (κ : ℝ) / 2 with hc
    have hc0 : 0 < c := div_pos hκpos two_pos
    have : NullSingletonClass (μH[((m + 1 : ℕ) : ℝ)] : Measure (Eucl N)) :=
      Measure.nullSingletonClass_hausdorff (Eucl N) (by positivity)
    -- local claim on balls of radius `ρ₀ / 2`
    have hloc : ∀ x₁ ∈ B, (μHE[m + 1] : Measure (Eucl N)) (B ∩ ball x₁ (ρ₀ / 2)) = 0 := by
      intro x₁ hx₁
      set B' : Set (Eucl N) := B ∩ ball x₁ (ρ₀ / 2) with hB'
      have hfin : (μHE[m + 1] : Measure (Eucl N)) B' < ⊤ := by
        calc (μHE[m + 1] : Measure (Eucl N)) B'
            ≤ (μHE[m + 1] : Measure (Eucl N)) (B ∩ closedBall x₁ (ρ₀ / 2)) :=
              measure_mono (inter_subset_inter_right _ ball_subset_closedBall)
          _ ≤ ENNReal.ofReal (c * (ρ₀ / 2) ^ (m + 1)) :=
              hB x₁ hx₁ _ (by positivity) (by linarith)
          _ < ⊤ := ENNReal.ofReal_lt_top
      have hcov : ∀ t : ℕ → Set (Eucl N), B' ⊆ ⋃ n, t n →
          (∀ n, ediam (t n) ≤ ENNReal.ofReal ρ₀) →
          (μHE[m + 1] : Measure (Eucl N)) B' ≤
            ENNReal.ofReal c * ∑' n, ⨆ _ : (t n).Nonempty, ediam (t n) ^ (((m + 1 : ℕ) : ℝ)) := by
        intro t ht hdiam
        have hterm : ∀ n, (μHE[m + 1] : Measure (Eucl N)) (B' ∩ t n) ≤
            ENNReal.ofReal c * ⨆ _ : (t n).Nonempty, ediam (t n) ^ (((m + 1 : ℕ) : ℝ)) := by
          intro n
          rcases (B' ∩ t n).eq_empty_or_nonempty with he | ⟨x, hxB', hxt⟩
          · rw [he, measure_empty]
            exact zero_le
          · have hne : (t n).Nonempty := ⟨x, hxt⟩
            rw [iSup_pos hne]
            have hdfin : ediam (t n) ≠ ⊤ := ne_top_of_le_ne_top ENNReal.ofReal_ne_top (hdiam n)
            set d : ℝ := (ediam (t n)).toReal with hd
            have hdeq : ENNReal.ofReal d = ediam (t n) := ENNReal.ofReal_toReal hdfin
            have hd0 : 0 ≤ d := ENNReal.toReal_nonneg
            have hdle : d ≤ ρ₀ := by
              rw [← ENNReal.ofReal_le_ofReal_iff hρ₀.le, hdeq]
              exact hdiam n
            have hpow : ediam (t n) ^ (((m + 1 : ℕ) : ℝ)) = ENNReal.ofReal (d ^ (m + 1)) := by
              rw [← hdeq, ENNReal.rpow_natCast, ENNReal.ofReal_pow hd0]
            rw [hpow, ← ENNReal.ofReal_mul hc0.le]
            rcases hd0.eq_or_lt with hd0' | hdpos
            · have hsub : B' ∩ t n ⊆ {x} := by
                rintro z ⟨-, hz⟩
                have h1 : edist z x ≤ ediam (t n) := edist_le_ediam_of_mem hz hxt
                rw [← hdeq, ← hd0', ENNReal.ofReal_zero, nonpos_iff_eq_zero, edist_eq_zero] at h1
                exact h1
              calc (μHE[m + 1] : Measure (Eucl N)) (B' ∩ t n)
                  ≤ (μHE[m + 1] : Measure (Eucl N)) {x} := measure_mono hsub
                _ = 0 := by rw [hdef, measure_singleton, mul_zero]
                _ ≤ _ := zero_le
            · have hsub : B' ∩ t n ⊆ B ∩ closedBall x d := by
                rintro z ⟨hzB', hz⟩
                refine ⟨hzB'.1, ?_⟩
                rw [mem_closedBall, ← ENNReal.ofReal_le_ofReal_iff hd0, ← edist_dist, hdeq]
                exact edist_le_ediam_of_mem hz hxt
              exact (measure_mono hsub).trans (hB x hxB'.1 d hdpos hdle)
        calc (μHE[m + 1] : Measure (Eucl N)) B'
            ≤ (μHE[m + 1] : Measure (Eucl N)) (⋃ n, B' ∩ t n) := by
              refine measure_mono fun x hx => ?_
              obtain ⟨n, hn⟩ := mem_iUnion.1 (ht hx)
              exact mem_iUnion.2 ⟨n, hx, hn⟩
          _ ≤ ∑' n, (μHE[m + 1] : Measure (Eucl N)) (B' ∩ t n) := measure_iUnion_le _
          _ ≤ ∑' n, ENNReal.ofReal c * ⨆ _ : (t n).Nonempty, ediam (t n) ^ (((m + 1 : ℕ) : ℝ)) :=
              ENNReal.tsum_le_tsum hterm
          _ = ENNReal.ofReal c * ∑' n, ⨆ _ : (t n).Nonempty, ediam (t n) ^ (((m + 1 : ℕ) : ℝ)) :=
              ENNReal.tsum_mul_left
      have hc' : ENNReal.ofReal c ≠ 0 := (ENNReal.ofReal_pos.2 hc0).ne'
      have hle : (μHE[m + 1] : Measure (Eucl N)) B' ≤
          ENNReal.ofReal c * (μH[((m + 1 : ℕ) : ℝ)] : Measure (Eucl N)) B' := by
        have hinf : (μHE[m + 1] : Measure (Eucl N)) B' ≤ ENNReal.ofReal c *
            ⨅ (t : ℕ → Set (Eucl N)) (_ : B' ⊆ ⋃ n, t n)
              (_ : ∀ n, ediam (t n) ≤ ENNReal.ofReal ρ₀),
              ∑' n, ⨆ _ : (t n).Nonempty, ediam (t n) ^ (((m + 1 : ℕ) : ℝ)) := by
          rw [mul_comm, ← ENNReal.div_le_iff_le_mul (Or.inl hc') (Or.inl ENNReal.ofReal_ne_top)]
          refine le_iInf fun t => le_iInf fun ht => le_iInf fun hdiam => ?_
          rw [ENNReal.div_le_iff_le_mul (Or.inl hc') (Or.inl ENNReal.ofReal_ne_top), mul_comm]
          exact hcov t ht hdiam
        refine hinf.trans ?_
        gcongr
        rw [Measure.hausdorffMeasure_apply]
        exact le_iSup₂_of_le (ENNReal.ofReal ρ₀) (ENNReal.ofReal_pos.2 hρ₀) le_rfl
      rw [hdef] at hle hfin ⊢
      have hμHfin : (μH[((m + 1 : ℕ) : ℝ)] : Measure (Eucl N)) B' ≠ ⊤ := by
        intro htop
        rw [htop, ENNReal.mul_top hκ0'] at hfin
        exact lt_irrefl _ hfin
      by_contra hne
      have hμH0 : (μH[((m + 1 : ℕ) : ℝ)] : Measure (Eucl N)) B' ≠ 0 := fun h0 => hne (by rw [h0, mul_zero])
      have hκle : (κ : ℝ≥0∞) ≤ ENNReal.ofReal c := (ENNReal.mul_le_mul_iff_left hμH0 hμHfin).1 hle
      have hlt : ENNReal.ofReal c < κ := by
        rw [hc, ENNReal.ofReal_div_of_pos two_pos, ENNReal.ofReal_coe_nnreal, ENNReal.ofReal_ofNat]
        exact ENNReal.half_lt_self hκ0' ENNReal.coe_ne_top
      exact absurd hκle (not_le.2 hlt)
    -- globalize with a countable subcover
    obtain ⟨T, hTB, hTc, hTU⟩ := TopologicalSpace.isOpen_biUnion_countable B
      (fun x => ball x (ρ₀ / 2)) (fun _ _ => isOpen_ball)
    have hcover : B ⊆ ⋃ x ∈ T, (B ∩ ball x (ρ₀ / 2)) := by
      intro z hz
      have hz' : z ∈ ⋃ x ∈ B, ball x (ρ₀ / 2) := mem_iUnion₂.2 ⟨z, hz, mem_ball_self (by positivity)⟩
      rw [← hTU] at hz'
      obtain ⟨x, hxT, hzx⟩ := mem_iUnion₂.1 hz'
      exact mem_iUnion₂.2 ⟨x, hxT, hz, hzx⟩
    exact measure_mono_null hcover ((measure_biUnion_null_iff hTc).2 fun x hx => hloc x (hTB hx))
  -- Step 3: rational apertures, then Steps 1 and 2 on each `B_q`.
  intro N m E v δ hE hδ
  obtain ⟨c, hc, hudn⟩ := uniform_density_null N m
  obtain ⟨C₁, hC₁, hcde⟩ := conical_density_estimate N m E v hE
  set η₀ : ℝ := c / (C₁ * 24 ^ (m + 1)) with hη₀
  have hη₀pos : 0 < η₀ := by positivity
  -- the sets `B_{s'}` for rational apertures `s'`
  set Bq : ℚ → Set (Eucl N) := fun q => {a | a ∈ E ∧ ∀ r ∈ Ioo (0 : ℝ) δ,
    (μHE[m + 1] : Measure (Eucl N)) (E ∩ {x | dist x a < r ∧
      ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (x - a)) : Eucl (m + 1))‖ <
        (q : ℝ) * ‖x - a‖}) ≤ ENNReal.ofReal (2 ^ (m + 1) * η₀ * (r * q) ^ (m + 1))} with hBq
  -- Step 3(a)
  have hsub : {a | a ∈ E ∧ ∀ η : ℝ, 0 < η → ∃ s ∈ Ioo (0 : ℝ) 1, ∀ r ∈ Ioo (0 : ℝ) δ,
      (μHE[m + 1] : Measure (Eucl N)) (E ∩ {x | dist x a < r ∧
        ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (x - a)) : Eucl (m + 1))‖ <
          s * ‖x - a‖}) ≤ ENNReal.ofReal (η * (r * s) ^ (m + 1))} ⊆
      ⋃ (q : ℚ) (_ : 0 < (q : ℝ) ∧ (q : ℝ) < 1), Bq q := by
    rintro a ⟨haE, ha⟩
    obtain ⟨s, ⟨hs0, hs1⟩, hs⟩ := ha η₀ hη₀pos
    obtain ⟨q, hq1, hq2⟩ := exists_rat_btwn (show s / 2 < s by linarith)
    have hq0 : (0 : ℝ) < q := by linarith
    refine mem_iUnion₂.2 ⟨q, ⟨hq0, by linarith⟩, haE, fun r hr => ?_⟩
    calc (μHE[m + 1] : Measure (Eucl N)) (E ∩ {x | dist x a < r ∧
          ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (x - a)) : Eucl (m + 1))‖ <
            (q : ℝ) * ‖x - a‖})
        ≤ (μHE[m + 1] : Measure (Eucl N)) (E ∩ {x | dist x a < r ∧
          ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (x - a)) : Eucl (m + 1))‖ <
            s * ‖x - a‖}) := by
          refine measure_mono (inter_subset_inter_right _ fun x hx => ⟨hx.1, hx.2.trans_le ?_⟩)
          exact mul_le_mul_of_nonneg_right hq2.le (norm_nonneg _)
      _ ≤ ENNReal.ofReal (η₀ * (r * s) ^ (m + 1)) := hs r hr
      _ ≤ ENNReal.ofReal (2 ^ (m + 1) * η₀ * (r * q) ^ (m + 1)) := by
          apply ENNReal.ofReal_le_ofReal
          have hr0 : 0 ≤ r := hr.1.le
          have h1 : (r * s) ^ (m + 1) ≤ (2 * (r * q)) ^ (m + 1) := by
            apply pow_le_pow_left₀ (by positivity)
            nlinarith
          calc η₀ * (r * s) ^ (m + 1) ≤ η₀ * (2 * (r * q)) ^ (m + 1) :=
                mul_le_mul_of_nonneg_left h1 hη₀pos.le
            _ = 2 ^ (m + 1) * η₀ * (r * q) ^ (m + 1) := by rw [mul_pow]; ring
  -- Step 3(b)
  have hnull : ∀ q : ℚ, 0 < (q : ℝ) ∧ (q : ℝ) < 1 → (μHE[m + 1] : Measure (Eucl N)) (Bq q) = 0 := by
    rintro q ⟨hq0, hq1⟩
    apply hudn (Bq q) (δ / 13) (by positivity)
    intro x hx ρ hρ hρle
    have hcd := hcde (Bq q) q (12 * ρ) (2 ^ (m + 1) * η₀) (fun a ha => ha.1) hq0 hq1
      (by positivity) (by positivity) (fun a ha r hr0 hrle => ha.2 r ⟨hr0, by linarith⟩) x
    calc (μHE[m + 1] : Measure (Eucl N)) (Bq q ∩ closedBall x ρ)
        ≤ (μHE[m + 1] : Measure (Eucl N)) (Bq q ∩ ball x (12 * ρ / 6)) :=
          measure_mono (inter_subset_inter_right _ (closedBall_subset_ball (by linarith)))
      _ ≤ ENNReal.ofReal (C₁ * (2 ^ (m + 1) * η₀) * (12 * ρ) ^ (m + 1)) := hcd
      _ = ENNReal.ofReal (c * ρ ^ (m + 1)) := by
          congr 1
          have h24 : (24 : ℝ) ^ (m + 1) = 2 ^ (m + 1) * 12 ^ (m + 1) := by
            rw [← mul_pow]; norm_num
          rw [hη₀, mul_pow, h24]
          field_simp
  apply measure_mono_null hsub
  refine measure_iUnion_null fun q => measure_iUnion_null fun hq => hnull q hq
/-- The upper limit of `f : ℝ → [0,∞]` at `0⁺` is computed along the radii `1/(n+1)`:
`limsup_{t→0⁺} f(t) = inf_{n ∈ ℕ} sup_{0<t<1/(n+1)} f(t)`.  The intervals `(0, ε)`, `ε > 0`, form
a basis of `𝓝[>] 0`, so the upper limit is `inf_{ε>0} sup_{(0,ε)} f`; each radius `1/(n+1)` is
admissible, and every `ε > 0` exceeds some `1/(n+1)`, below which the supremum is smaller. -/
theorem Submission.rectifiability_mickle_rado_limsup_eq_iInf :
    ∀ f : ℝ → ℝ≥0∞, limsup f (𝓝[>] (0 : ℝ)) =
      ⨅ n : ℕ, ⨆ t ∈ Ioo (0 : ℝ) (1 / ((n : ℝ) + 1)), f t := by
  intro f
  rw [(nhdsGT_basis (0 : ℝ)).limsup_eq_iInf_iSup]
  apply le_antisymm
  · refine le_iInf fun n => ?_
    exact iInf₂_le (1 / ((n : ℝ) + 1)) (by positivity)
  · refine le_iInf₂ fun ε hε => ?_
    obtain ⟨n, hn⟩ := exists_nat_one_div_lt hε
    refine (iInf_le _ n).trans ?_
    exact biSup_mono fun t ht => ⟨ht.1, ht.2.trans hn⟩
theorem Submission.rectifiability_mickle_rado_sup_lsc : ∀ (m : ℕ) (ψ : OuterMeasure (Eucl (m + 1))), (∀ (c : Eucl (m + 1)) (τ : ℝ), ψ (ball c τ) = ⨆ τ' ∈ Ioo (0 : ℝ) τ, ψ (ball c τ')) → ∀ r : ℝ, LowerSemicontinuous (fun c : Eucl (m + 1) => ⨆ t ∈ Ioo (0 : ℝ) r, ψ (ball c t) / ENNReal.ofReal (t ^ (m + 1))) := by
  intro m ψ hball r
  -- step 1: `c ↦ ψ (ball c τ)` is lower semicontinuous, by inner continuity on balls
  have hlsc : ∀ τ : ℝ, LowerSemicontinuous (fun c : Eucl (m + 1) => ψ (ball c τ)) := by
    intro τ c a ha
    change a < ψ (ball c τ) at ha
    rw [hball c τ] at ha
    obtain ⟨τ', hτ', hlt⟩ := lt_biSup_iff.1 ha
    filter_upwards [ball_mem_nhds c (sub_pos.2 hτ'.2)] with c' hc'
    refine hlt.trans_le (measure_mono ?_)
    intro z hz
    rw [mem_ball] at hz hc' ⊢
    calc dist z c' ≤ dist z c + dist c c' := dist_triangle _ _ _
      _ < τ' + (τ - τ') := by rw [dist_comm c c']; exact add_lt_add hz hc'
      _ = τ := by ring
  -- step 2: divide by the positive finite `tᵏ`, then take the supremum over `t ∈ (0, r)`
  apply lowerSemicontinuous_biSup
  intro t ht
  have hden : ENNReal.ofReal (t ^ (m + 1)) ≠ 0 := (ENNReal.ofReal_pos.2 (pow_pos ht.1 _)).ne'
  exact (ENNReal.continuous_div_const _ hden).comp_lowerSemicontinuous (hlsc t)
    (fun _ _ h => ENNReal.div_le_div_right h _)
/-- Vitali covering estimate off a `ψ`-null closed set, a covering step for the Mickle–Radó
density theorem (Mickle–Radó, Proc. Amer. Math. Soc. 9 (1958), 433–439).  If `K` is closed,
`ψ K = 0` and `ψ(B(z,τ)) ≤ C τᵏ` for `z ∈ K`, `0 < τ < r` (`k = m + 1`), then
`ψ(B(c₀,t)) · Lᵏ(B(0,1)) ≤ C 6ᵏ Lᵏ(B(c₀,2t) ∖ K)` for `c₀ ∈ K`, `0 < t`, `6t ≤ r`.  The balls
`B(z, d z)`, `d z = dist(z,K)`, `z ∈ B(c₀,t) ∖ K`, miss `K` and lie in `B(c₀,2t)`.  A disjoint
(hence countable) Vitali subfamily has `5`-fold enlargements covering `B(c₀,t) ∖ K`, and
`B(b, 5 d b) ⊆ B(z'_b, 6 d b)` for a nearest point `z'_b ∈ K` of `b`, where `6 d b < 6t ≤ r`. -/
theorem Submission.rectifiability_mickle_rado_vitali_bound : ∀ (m : ℕ) (ψ : OuterMeasure (Eucl (m + 1))) (K : Set (Eucl (m + 1))) (C : ℝ≥0∞) (r : ℝ), IsClosed K → ψ K = 0 → (∀ z ∈ K, ∀ τ ∈ Ioo (0 : ℝ) r, ψ (ball z τ) ≤ C * ENNReal.ofReal (τ ^ (m + 1))) → ∀ c₀ ∈ K, ∀ t : ℝ, 0 < t → 6 * t ≤ r → ψ (ball c₀ t) * (volume : Measure (Eucl (m + 1))) (ball 0 1) ≤ C * 6 ^ (m + 1) * (volume : Measure (Eucl (m + 1))) (ball c₀ (2 * t) \ K) := by
  intro m ψ K C r hK hψK hbound c₀ hc₀ t ht htr
  set μ : Measure (Eucl (m + 1)) := volume with hμ
  set ω := μ (ball 0 1) with hω
  have hfin : Module.finrank ℝ (Eucl (m + 1)) = m + 1 := finrank_euclideanSpace_fin
  have hKne : K.Nonempty := ⟨c₀, hc₀⟩
  -- step 1: `ψ(B(c₀,t)) ≤ ψ(B(c₀,t) ∖ K) + ψ(K) = ψ(B(c₀,t) ∖ K)`
  have h1 : ψ (ball c₀ t) ≤ ψ (ball c₀ t \ K) := by
    calc ψ (ball c₀ t) ≤ ψ ((ball c₀ t \ K) ∪ K) := measure_mono (fun x hx => by
          by_cases h : x ∈ K
          · exact Or.inr h
          · exact Or.inl ⟨hx, h⟩)
      _ ≤ ψ (ball c₀ t \ K) + ψ K := measure_union_le _ _
      _ = ψ (ball c₀ t \ K) := by rw [hψK, add_zero]
  set T := ball c₀ t \ K with hT
  -- step 2: on `T`, the radius `d z = dist(z, K)` satisfies `0 < d z ≤ dist(z, c₀) < t`
  set d : Eucl (m + 1) → ℝ := fun z => infDist z K with hd
  have hd_pos : ∀ z ∈ T, 0 < d z := fun z hz => (hK.notMem_iff_infDist_pos hKne).1 hz.2
  have hd_lt : ∀ z ∈ T, d z < t := fun z hz =>
    (infDist_le_dist_of_mem hc₀).trans_lt (mem_ball.1 hz.1)
  -- steps 3–4: a disjoint, hence countable, Vitali subfamily `u ⊆ T` with enlargement factor `5`
  obtain ⟨u, huT, hdisj, hcov⟩ := Vitali.exists_disjoint_subfamily_covering_enlargement_ball
    T (fun z => z) d t (fun z hz => (hd_lt z hz).le) 5 (by norm_num)
  have hu_count : u.Countable := hdisj.countable_of_isOpen (fun _ _ => isOpen_ball)
    (fun z hz => ⟨z, mem_ball_self (hd_pos z (huT hz))⟩)
  -- step 5: recentre at nearest points `z' b ∈ K`, so that `T ⊆ ⋃_{b ∈ u} B(z' b, 6 d b)`
  have hnear : ∀ z, ∃ y ∈ K, infDist z K = dist z y := fun z => hK.exists_infDist_eq_dist hKne z
  choose z' hz'K hz'd using hnear
  have hcover : T ⊆ ⋃ b ∈ u, ball (z' b) (6 * d b) := by
    intro a ha
    obtain ⟨b, hbu, hab⟩ := hcov a ha
    have hab' : a ∈ ball b (5 * d b) := hab (mem_ball_self (hd_pos a ha))
    refine mem_iUnion₂.2 ⟨b, hbu, ?_⟩
    rw [mem_ball] at hab' ⊢
    have hbz : dist b (z' b) = d b := (hz'd b).symm
    calc dist a (z' b) ≤ dist a b + dist b (z' b) := dist_triangle _ _ _
      _ < 5 * d b + d b := by rw [hbz]; linarith
      _ = 6 * d b := by ring
  -- steps 6–7: as `0 < 6 d b < 6t ≤ r`, `ψ(T) ≤ ∑_{b ∈ u} C 6ᵏ (d b)ᵏ`
  have h2 : ψ T ≤ ∑' b : u, C * 6 ^ (m + 1) * ENNReal.ofReal ((d b) ^ (m + 1)) := by
    calc ψ T ≤ ψ (⋃ b ∈ u, ball (z' b) (6 * d b)) := measure_mono hcover
      _ ≤ ∑' b : u, ψ (ball (z' b) (6 * d b)) := measure_biUnion_le ψ hu_count _
      _ ≤ ∑' b : u, C * 6 ^ (m + 1) * ENNReal.ofReal ((d b) ^ (m + 1)) := by
        refine ENNReal.tsum_le_tsum fun b => ?_
        have hb : (b : Eucl (m + 1)) ∈ T := huT b.2
        have hpos := hd_pos b hb
        have hlt := hd_lt b hb
        calc ψ (ball (z' b) (6 * d b)) ≤ C * ENNReal.ofReal ((6 * d b) ^ (m + 1)) :=
              hbound (z' b) (hz'K b) (6 * d b) ⟨by linarith, by linarith⟩
          _ = C * 6 ^ (m + 1) * ENNReal.ofReal ((d b) ^ (m + 1)) := by
            rw [mul_pow, ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_pow (by norm_num)]
            simp [mul_assoc]
  -- step 8: for the disjoint balls `B(b, d b) ⊆ B(c₀,2t) ∖ K`,
  -- `∑_{b ∈ u} (d b)ᵏ ω = Lᵏ(⋃_{b ∈ u} B(b, d b)) ≤ Lᵏ(B(c₀,2t) ∖ K)`
  have h3 : ∑' b : u, ENNReal.ofReal ((d b) ^ (m + 1)) * ω ≤ μ (ball c₀ (2 * t) \ K) := by
    have heq : ∀ b : u,
        ENNReal.ofReal ((d b) ^ (m + 1)) * ω = μ (ball (b : Eucl (m + 1)) (d b)) := by
      intro b
      rw [Measure.addHaar_ball μ _ (hd_pos b (huT b.2)).le, hfin]
    simp_rw [heq]
    rw [← measure_biUnion hu_count hdisj (fun _ _ => measurableSet_ball)]
    apply measure_mono
    intro y hy
    obtain ⟨b, hbu, hyb⟩ := mem_iUnion₂.1 hy
    have hbT := huT hbu
    refine ⟨?_, ?_⟩
    · rw [mem_ball] at hyb ⊢
      have hbc := mem_ball.1 hbT.1
      have := hd_lt b hbT
      calc dist y c₀ ≤ dist y b + dist b c₀ := dist_triangle _ _ _
        _ < 2 * t := by linarith
    · intro hyK
      exact Set.disjoint_left.1 (disjoint_ball_infDist (x := b) (s := K)) hyb hyK
  -- step 9: combine, pulling the constants out of the sums
  calc ψ (ball c₀ t) * ω
      ≤ (∑' b : u, C * 6 ^ (m + 1) * ENNReal.ofReal ((d b) ^ (m + 1))) * ω := by
        gcongr; exact h1.trans h2
    _ = C * 6 ^ (m + 1) * ∑' b : u, ENNReal.ofReal ((d b) ^ (m + 1)) * ω := by
        rw [ENNReal.tsum_mul_left, ENNReal.tsum_mul_right, mul_assoc]
    _ ≤ C * 6 ^ (m + 1) * μ (ball c₀ (2 * t) \ K) := by gcongr

/-- Mickle–Radó density step (Mattila, Thm 18.5, step 3 with `ε ↓ 0`): if `ψ(B(z,τ)) ≤ C τᵏ`
for `z ∈ K`, `0 < τ < r`, where `K` is closed and `ψ(K) = 0`, then the upper `k`-density of `ψ`
vanishes at `Lᵏ`-a.e. point of `K`.  At a Lebesgue density point `c ∈ K` of `K`, the Vitali
estimate `ψ(B(c,t))·ω ≤ C·6ᵏ·Lᵏ(B(c,2t) ∖ K)` together with
`Lᵏ(B̄(c,2t) ∖ K) = (2t)ᵏ·ω·(1 − R_c(2t))`, `R_c(ρ) = Lᵏ(K ∩ B̄(c,ρ))/Lᵏ(B̄(c,ρ)) → 1`, gives
`ψ(B(c,t))/tᵏ ≤ C·12ᵏ·(1 − R_c(2t)) → 0`. -/
theorem Submission.rectifiability_mickle_rado_density_zero : ∀ (m : ℕ) (ψ : OuterMeasure (Eucl (m + 1))) (K : Set (Eucl (m + 1))) (C : ℝ≥0∞) (r : ℝ), IsClosed K → ψ K = 0 → C ≠ ⊤ → 0 < r → (∀ z ∈ K, ∀ τ ∈ Ioo (0 : ℝ) r, ψ (ball z τ) ≤ C * ENNReal.ofReal (τ ^ (m + 1))) → ∀ᵐ c ∂((volume : Measure (Eucl (m + 1))).restrict K), limsup (fun t : ℝ => ψ (ball c t) / ENNReal.ofReal (t ^ (m + 1))) (𝓝[>] 0) = 0 := by
  intro m ψ K C r hK hψK hC hr hbound
  set μ : Measure (Eucl (m + 1)) := volume with hμ
  filter_upwards [Besicovitch.ae_tendsto_measure_inter_div μ K, ae_restrict_mem hK.measurableSet]
    with c hc hcK
  apply Tendsto.limsup_eq
  set ω := μ (ball 0 1) with hω
  have hω0 : ω ≠ 0 := (measure_ball_pos μ 0 one_pos).ne'
  have hωtop : ω ≠ ⊤ := measure_ball_lt_top.ne
  have hfin : Module.finrank ℝ (Eucl (m + 1)) = m + 1 := finrank_euclideanSpace_fin
  -- the density ratio at radius 2t
  have hR2 : Tendsto (fun t : ℝ => μ (K ∩ closedBall c (2 * t)) / μ (closedBall c (2 * t)))
      (𝓝[>] 0) (𝓝 1) := by
    refine hc.comp ?_
    have h2 : Tendsto (fun t : ℝ => 2 * t) (𝓝[>] 0) (𝓝[>] (2 * 0)) :=
      tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _
        ((continuous_const.mul continuous_id).tendsto' _ _ rfl |>.mono_left nhdsWithin_le_nhds)
        (by filter_upwards [self_mem_nhdsWithin] with t ht; exact mem_Ioi.2 (by simpa using ht))
    simpa using h2
  have hlim : Tendsto (fun t : ℝ => C * 12 ^ (m + 1) *
      (1 - μ (K ∩ closedBall c (2 * t)) / μ (closedBall c (2 * t)))) (𝓝[>] 0) (𝓝 0) := by
    have h1 := ENNReal.Tendsto.sub tendsto_const_nhds hR2 (Or.inl ENNReal.one_ne_top)
    have h12 : C * 12 ^ (m + 1) ≠ ⊤ := ENNReal.mul_ne_top hC (ENNReal.pow_ne_top (by norm_num))
    have h2 := ENNReal.Tendsto.const_mul (a := C * 12 ^ (m + 1)) h1 (Or.inr h12)
    simpa using h2
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hlim
    (Eventually.of_forall fun _ => bot_le) ?_
  filter_upwards [Ioo_mem_nhdsGT (show (0 : ℝ) < r / 6 by positivity)] with t ht
  have ht0 : 0 < t := ht.1
  have h0 := Submission.rectifiability_mickle_rado_vitali_bound m ψ K C r hK hψK hbound c hcK t ht0
    (by linarith [ht.2])
  -- measure of the complement in the closed ball
  set V := μ (closedBall c (2 * t)) with hV
  set A := μ (K ∩ closedBall c (2 * t)) with hA
  have hVball : V = ENNReal.ofReal ((2 * t) ^ (m + 1)) * ω := by
    rw [hV, Measure.addHaar_closedBall μ c (by positivity), hfin]
  have hV0 : V ≠ 0 := by
    rw [hVball]; exact mul_ne_zero (ENNReal.ofReal_pos.2 (by positivity)).ne' hω0
  have hVtop : V ≠ ⊤ := measure_closedBall_lt_top.ne
  have hAle : A ≤ V := measure_mono inter_subset_right
  have hdiff : μ (ball c (2 * t) \ K) ≤ V * (1 - A / V) := by
    have hsplit : μ (closedBall c (2 * t) \ K) + A = V := by
      rw [hA, inter_comm]; exact measure_sdiff_add_inter _ hK.measurableSet
    have h1 : μ (ball c (2 * t) \ K) ≤ μ (closedBall c (2 * t) \ K) :=
      measure_mono (sdiff_subset_sdiff_left ball_subset_closedBall)
    have h2 : μ (closedBall c (2 * t) \ K) = V - A :=
      ENNReal.eq_sub_of_add_eq (ne_top_of_le_ne_top hVtop hAle) hsplit
    have h3 : V * (1 - A / V) = V - A := by
      rw [ENNReal.mul_sub (fun _ _ => hVtop), mul_one, ENNReal.mul_div_cancel hV0 hVtop]
    rw [h3, ← h2]; exact h1
  -- conclude
  have hpowt : ENNReal.ofReal (t ^ (m + 1)) ≠ 0 := (ENNReal.ofReal_pos.2 (pow_pos ht0 _)).ne'
  rw [ENNReal.div_le_iff_le_mul (Or.inl hpowt) (Or.inl ENNReal.ofReal_ne_top)]
  have h2t : ENNReal.ofReal ((2 * t) ^ (m + 1)) = 2 ^ (m + 1) * ENNReal.ofReal (t ^ (m + 1)) := by
    rw [mul_pow, ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_pow (by norm_num)]
    simp
  have key : ψ (ball c t) * ω ≤
      (C * 12 ^ (m + 1) * (1 - A / V) * ENNReal.ofReal (t ^ (m + 1))) * ω := by
    calc ψ (ball c t) * ω ≤ C * 6 ^ (m + 1) * μ (ball c (2 * t) \ K) := h0
      _ ≤ C * 6 ^ (m + 1) * (V * (1 - A / V)) := by gcongr
      _ = (C * 12 ^ (m + 1) * (1 - A / V) * ENNReal.ofReal (t ^ (m + 1))) * ω := by
        rw [hVball, h2t]
        have : (12 : ℝ≥0∞) ^ (m + 1) = 6 ^ (m + 1) * 2 ^ (m + 1) := by
          rw [← mul_pow]; norm_num
        rw [this]; ring
  exact (ENNReal.mul_le_mul_iff_left hω0 hωtop).1 key

/-- **Mickle–Radó density theorem** (Mickle–Radó, Proc. Amer. Math. Soc. 9 (1958), 433–439;
Mattila, Thm 18.5).  Let `ψ` be an outer measure on `ℝᵏ`, `k = m + 1`, inner continuous on open
balls, and `D` a Borel set with `ψ(D) = 0`.  Then the upper density
`ϑ(c) = limsup_{t↓0} ψ(B(c,t))/tᵏ` lies in `{0, ∞}` at `Lᵏ`-a.e. point of `D`.  With
`g_n(c) = sup_{0<t<1/(n+1)} ψ(B(c,t))/tᵏ`, each `g_n` is lower semicontinuous and `ϑ = inf_n g_n`,
so `ϑ` is Borel.  The set `{c ∈ D : 0 < ϑ(c) < ∞}` is covered by the Borel sets
`S_n = {c ∈ D : (n+1)⁻¹ < ϑ(c), g_n(c) ≤ n+1}`.  If `Lᵏ(S_n) > 0`, a compact `K ⊆ S_n` with
`Lᵏ(K) > 0` has `ψ(K) = 0` and `ψ(B(z,τ)) ≤ (n+1)τᵏ` for `z ∈ K`, `0 < τ < 1/(n+1)`; hence
`ϑ = 0` at `Lᵏ`-a.e. point of `K`, contradicting `ϑ > (n+1)⁻¹` on `K`. -/
theorem Submission.rectifiability_mickle_rado : ∀ (m : ℕ) (ψ : OuterMeasure (Eucl (m + 1))) (D : Set (Eucl (m + 1))), (∀ (c : Eucl (m + 1)) (τ : ℝ), ψ (ball c τ) = ⨆ τ' ∈ Ioo (0 : ℝ) τ, ψ (ball c τ')) → MeasurableSet D → ψ D = 0 → (volume : Measure (Eucl (m + 1))) {c | c ∈ D ∧ 0 < limsup (fun t : ℝ => ψ (ball c t) / ENNReal.ofReal (t ^ (m + 1))) (𝓝[>] 0) ∧ limsup (fun t : ℝ => ψ (ball c t) / ENNReal.ofReal (t ^ (m + 1))) (𝓝[>] 0) < ⊤} = 0 := by
  intro m ψ D hball hD hψD
  let g : ℕ → Eucl (m + 1) → ℝ≥0∞ := fun n c =>
    ⨆ t ∈ Ioo (0 : ℝ) (1 / ((n : ℝ) + 1)), ψ (ball c t) / ENNReal.ofReal (t ^ (m + 1))
  let ϑ : Eucl (m + 1) → ℝ≥0∞ := fun c =>
    limsup (fun t : ℝ => ψ (ball c t) / ENNReal.ofReal (t ^ (m + 1))) (𝓝[>] 0)
  -- step 1: `ϑ = inf_n g_n` with every `g_n` lower semicontinuous, so `ϑ` is Borel
  have hϑ : ∀ c, ϑ c = ⨅ n, g n c := fun c =>
    Submission.rectifiability_mickle_rado_limsup_eq_iInf
      (fun t : ℝ => ψ (ball c t) / ENNReal.ofReal (t ^ (m + 1)))
  have hg_meas : ∀ n, Measurable (g n) := fun n =>
    (Submission.rectifiability_mickle_rado_sup_lsc m ψ hball _).measurable
  have hϑ_meas : Measurable ϑ := by
    have h : ϑ = fun c => ⨅ n, g n c := funext hϑ
    rw [h]
    exact Measurable.iInf hg_meas
  have hg_anti : ∀ c, Antitone (fun n => g n c) := by
    intro c n n' hnn'
    apply biSup_mono
    intro t ht
    refine ⟨ht.1, lt_of_lt_of_le ht.2 ?_⟩
    have h1 : (n : ℝ) ≤ n' := by exact_mod_cast hnn'
    gcongr
  -- step 2: `{c ∈ D : 0 < ϑ c < ∞} ⊆ ⋃_n S_n` for the Borel sets `S_n`
  let S : ℕ → Set (Eucl (m + 1)) := fun n =>
    {c | c ∈ D ∧ ((n : ℝ≥0∞) + 1)⁻¹ < ϑ c ∧ g n c ≤ (n : ℝ≥0∞) + 1}
  have hS_meas : ∀ n, MeasurableSet (S n) := by
    intro n
    exact hD.inter ((measurableSet_lt measurable_const hϑ_meas).inter
      (measurableSet_le (hg_meas n) measurable_const))
  have hsub : {c | c ∈ D ∧ 0 < limsup (fun t : ℝ => ψ (ball c t) / ENNReal.ofReal (t ^ (m + 1))) (𝓝[>] 0) ∧ limsup (fun t : ℝ => ψ (ball c t) / ENNReal.ofReal (t ^ (m + 1))) (𝓝[>] 0) < ⊤} ⊆ ⋃ n, S n := by
    rintro c ⟨hcD, hpos, hfin⟩
    change ϑ c < ⊤ at hfin
    change 0 < ϑ c at hpos
    rw [hϑ c] at hfin
    obtain ⟨n₀, hn₀⟩ := iInf_lt_iff.1 hfin
    obtain ⟨N, hN⟩ := ENNReal.exists_nat_gt hn₀.ne
    obtain ⟨n₁, hn₁⟩ := ENNReal.exists_inv_nat_lt hpos.ne'
    set n := max n₀ (max N n₁) with hn
    refine mem_iUnion.2 ⟨n, hcD, ?_, ?_⟩
    · refine lt_of_le_of_lt ?_ hn₁
      apply ENNReal.inv_le_inv.2
      have : n₁ ≤ n := le_trans (le_max_right _ _) (le_max_right _ _)
      have : (n₁ : ℝ≥0∞) ≤ n := by exact_mod_cast this
      exact this.trans le_self_add
    · calc g n c ≤ g n₀ c := hg_anti c (le_max_left _ _)
        _ ≤ N := hN.le
        _ ≤ (n : ℝ≥0∞) := by
          have : N ≤ n := le_trans (le_max_left _ _) (le_max_right _ _)
          exact_mod_cast this
        _ ≤ (n : ℝ≥0∞) + 1 := le_self_add
  -- step 3: `Lᵏ(S_n) = 0`, via a compact `K ⊆ S_n` and the density-zero step on `K`
  have hS_null : ∀ n, (volume : Measure (Eucl (m + 1))) (S n) = 0 := by
    intro n
    by_contra hne
    obtain ⟨K, hKS, hKc, hKpos⟩ := (hS_meas n).exists_lt_isCompact (pos_iff_ne_zero.2 hne)
    have hψK : ψ K = 0 := measure_mono_null (fun x hx => (hKS hx).1) hψD
    have hbound : ∀ z ∈ K, ∀ τ ∈ Ioo (0 : ℝ) (1 / ((n : ℝ) + 1)),
        ψ (ball z τ) ≤ ((n : ℝ≥0∞) + 1) * ENNReal.ofReal (τ ^ (m + 1)) := by
      intro z hz τ hτ
      have h1 : ψ (ball z τ) / ENNReal.ofReal (τ ^ (m + 1)) ≤ g n z :=
        le_iSup₂ (f := fun t (_ : t ∈ Ioo (0 : ℝ) (1 / ((n : ℝ) + 1))) =>
          ψ (ball z t) / ENNReal.ofReal (t ^ (m + 1))) τ hτ
      have h2 := h1.trans (hKS hz).2.2
      rwa [ENNReal.div_le_iff_le_mul (Or.inl (ENNReal.ofReal_pos.2 (pow_pos hτ.1 _)).ne')
        (Or.inl ENNReal.ofReal_ne_top)] at h2
    have hae := Submission.rectifiability_mickle_rado_density_zero m ψ K ((n : ℝ≥0∞) + 1)
      (1 / ((n : ℝ) + 1)) hKc.isClosed hψK (by simp) (by positivity) hbound
    obtain ⟨c, hcK, hc0⟩ := Measure.exists_mem_of_measure_ne_zero_of_ae hKpos.ne' hae
    have h3 : ((n : ℝ≥0∞) + 1)⁻¹ < ϑ c := (hKS hcK).2.1
    change _ < limsup _ _ at h3
    rw [hc0] at h3
    exact (ENNReal.not_lt_zero h3).elim
  exact measure_mono_null hsub (measure_iUnion_null hS_null)

/-- For an s-finite `μ` and measurable sets `G r s ⊆ Z × Y`, increasing in `s` and with
`G r s = ⋃_{0<r'<r} G r' s` for `r > 0`, the map
`z ↦ limsup_{s→0⁺} sup_{0<r<δ} μ{y | (z, y) ∈ G r s} / (r s)ᵏ` is measurable.  Each section
measure is measurable in `z` (Tonelli).  By continuity from below along rational `r' < r` the
supremum over `r` may be taken over rational `r`, and since `F(s) ≤ (s'/s)ᵏ F(s')` for
`0 < s ≤ s'`, the supremum over `s ∈ (0, ε)` may be taken over rational `s`.  Computing the upper
limit along the radii `1/(n+1)` then gives a countable `inf`–`sup` of measurable functions. -/
theorem Submission.rectifiability_bf_limsup_sup_measurable :
    ∀ (Z Y : Type) [MeasurableSpace Z] [MeasurableSpace Y] (k : ℕ) (μ : Measure Y) (δ : ℝ)
      (G : ℝ → ℝ → Set (Z × Y)), SFinite μ → (∀ r s, MeasurableSet (G r s)) →
      (∀ r s s', s ≤ s' → G r s ⊆ G r s') →
      (∀ r s, 0 < r → G r s = ⋃ r' ∈ Ioo (0 : ℝ) r, G r' s) →
      Measurable (fun z : Z => limsup (fun s : ℝ => ⨆ r ∈ Ioo (0 : ℝ) δ,
        μ {y | (z, y) ∈ G r s} / ENNReal.ofReal ((r * s) ^ k)) (𝓝[>] 0)) := by
  intro Z Y _ _ k μ δ G hμ hG hmono hcont
  -- `g z r s` is the section measure and `F z s` the supremum over `r ∈ (0, δ)`
  let g : Z → ℝ → ℝ → ℝ≥0∞ := fun z r s => μ {y | (z, y) ∈ G r s}
  let F : Z → ℝ → ℝ≥0∞ := fun z s => ⨆ r ∈ Ioo (0 : ℝ) δ, g z r s / ENNReal.ofReal ((r * s) ^ k)
  show Measurable fun z => limsup (F z) (𝓝[>] 0)
  have hgm : ∀ r s, Measurable fun z => g z r s := fun r s =>
    measurable_measure_prodMk_left (hG r s)
  -- `G` is monotone in `r` on `(0, ∞)`
  have hGr : ∀ s r₁ r₂, 0 < r₁ → r₁ ≤ r₂ → G r₁ s ⊆ G r₂ s := by
    intro s r₁ r₂ h1 h12
    rcases h12.lt_or_eq with h | rfl
    · rw [hcont r₂ s (h1.trans h)]
      exact subset_biUnion_of_mem (u := fun r' => G r' s) ⟨h1, h⟩
    · exact le_rfl
  -- the supremum over `r` is a supremum over rational `r`
  have hFq : ∀ z s, 0 < s → F z s = ⨆ q : ℚ, ⨆ (_ : (q : ℝ) ∈ Ioo (0 : ℝ) δ),
      g z q s / ENNReal.ofReal (((q : ℝ) * s) ^ k) := by
    intro z s hs
    apply le_antisymm
    · refine iSup₂_le fun r hr => ?_
      have hU : {y | (z, y) ∈ G r s} =
          ⋃ q : {q : ℚ // 0 < (q : ℝ) ∧ (q : ℝ) < r}, {y | (z, y) ∈ G (q.1 : ℝ) s} := by
        ext y
        simp only [mem_iUnion, mem_ofPred_eq]
        constructor
        · intro hy
          rw [hcont r s hr.1] at hy
          simp only [mem_iUnion] at hy
          obtain ⟨r', hr', hy'⟩ := hy
          obtain ⟨q, hq1, hq2⟩ := exists_rat_btwn hr'.2
          exact ⟨⟨q, hr'.1.trans hq1, hq2⟩, hGr s r' q hr'.1 hq1.le hy'⟩
        · rintro ⟨q, hy⟩
          exact hGr s q r q.2.1 q.2.2.le hy
      have hdir : Directed (· ⊆ ·)
          (fun q : {q : ℚ // 0 < (q : ℝ) ∧ (q : ℝ) < r} => {y | (z, y) ∈ G (q.1 : ℝ) s}) := by
        intro q₁ q₂
        refine ⟨⟨max q₁.1 q₂.1, ?_, ?_⟩, ?_, ?_⟩
        · exact lt_of_lt_of_le q₁.2.1 (by exact_mod_cast le_max_left q₁.1 q₂.1)
        · rw [Rat.cast_max]; exact max_lt q₁.2.2 q₂.2.2
        · intro y hy
          exact hGr s q₁.1 _ q₁.2.1 (by exact_mod_cast le_max_left q₁.1 q₂.1) hy
        · intro y hy
          exact hGr s q₂.1 _ q₂.2.1 (by exact_mod_cast le_max_right q₁.1 q₂.1) hy
      have hgr : g z r s = ⨆ q : {q : ℚ // 0 < (q : ℝ) ∧ (q : ℝ) < r}, g z (q.1 : ℝ) s := by
        show μ {y | (z, y) ∈ G r s} = _
        rw [hU]
        exact hdir.measure_iUnion
      rw [hgr, ENNReal.iSup_div]
      refine iSup_le fun q => ?_
      refine le_trans ?_ (le_iSup₂ (f := fun (q : ℚ) (_ : (q : ℝ) ∈ Ioo (0 : ℝ) δ) =>
        g z q s / ENNReal.ofReal (((q : ℝ) * s) ^ k)) q.1 ⟨q.2.1, q.2.2.trans hr.2⟩)
      apply ENNReal.div_le_div_left
      apply ENNReal.ofReal_le_ofReal
      apply pow_le_pow_left₀ (mul_pos q.2.1 hs).le
      exact mul_le_mul_of_nonneg_right q.2.2.le hs.le
    · refine iSup_le fun q => iSup_le fun hq => ?_
      exact le_iSup₂ (f := fun r (_ : r ∈ Ioo (0 : ℝ) δ) => g z r s / ENNReal.ofReal ((r * s) ^ k))
        (q : ℝ) hq
  have hFm : ∀ s, 0 < s → Measurable fun z => F z s := by
    intro s hs
    have : (fun z => F z s) = fun z => ⨆ q : ℚ, ⨆ (_ : (q : ℝ) ∈ Ioo (0 : ℝ) δ),
        g z q s / ENNReal.ofReal (((q : ℝ) * s) ^ k) := funext fun z => hFq z s hs
    rw [this]
    exact Measurable.iSup fun q => Measurable.iSup fun _ => (hgm q s).div_const _
  -- scaling in `s`: `F z s ≤ (s'/s)ᵏ F z s'` for `0 < s ≤ s'`
  have hscale : ∀ z s s', 0 < s → s ≤ s' → F z s ≤ ENNReal.ofReal ((s' / s) ^ k) * F z s' := by
    intro z s s' hs hss'
    refine iSup₂_le fun r hr => ?_
    have hs' : 0 < s' := hs.trans_le hss'
    have h1 : g z r s ≤ g z r s' := measure_mono (fun y hy => hmono r s s' hss' hy)
    have hA : ENNReal.ofReal ((r * s') ^ k) =
        ENNReal.ofReal ((s' / s) ^ k) * ENNReal.ofReal ((r * s) ^ k) := by
      rw [← ENNReal.ofReal_mul (by positivity), ← mul_pow]
      congr 2
      field_simp
    have hc0 : ENNReal.ofReal ((s' / s) ^ k) ≠ 0 := (ENNReal.ofReal_pos.2 (by positivity)).ne'
    calc g z r s / ENNReal.ofReal ((r * s) ^ k)
        ≤ g z r s' / ENNReal.ofReal ((r * s) ^ k) := ENNReal.div_le_div_right h1 _
      _ = ENNReal.ofReal ((s' / s) ^ k) * (g z r s' / ENNReal.ofReal ((r * s') ^ k)) := by
          rw [hA, ← mul_div_assoc, ENNReal.mul_div_mul_left _ _ hc0 ENNReal.ofReal_ne_top]
      _ ≤ ENNReal.ofReal ((s' / s) ^ k) * F z s' := by
          gcongr
          exact le_iSup₂ (f := fun r (_ : r ∈ Ioo (0 : ℝ) δ) =>
            g z r s' / ENNReal.ofReal ((r * s') ^ k)) r hr
  -- the supremum over `s ∈ (0, ε)` is a supremum over rational `s`
  have hsupq : ∀ z (ε : ℝ), 0 < ε → ⨆ s ∈ Ioo (0 : ℝ) ε, F z s =
      ⨆ q : ℚ, ⨆ (_ : (q : ℝ) ∈ Ioo (0 : ℝ) ε), F z q := by
    intro z ε hε
    apply le_antisymm
    · refine iSup₂_le fun s hs => ?_
      have hn : ∀ n : ℕ, F z s ≤ ENNReal.ofReal ((1 + 1 / ((n : ℝ) + 1)) ^ k) *
          ⨆ q : ℚ, ⨆ (_ : (q : ℝ) ∈ Ioo (0 : ℝ) ε), F z q := by
        intro n
        have hpos : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
        have hlt : s < min ε (s * (1 + 1 / ((n : ℝ) + 1))) := by
          refine lt_min hs.2 ?_
          have := mul_pos hs.1 hpos
          nlinarith
        obtain ⟨q, hq1, hq2⟩ := exists_rat_btwn hlt
        have hqε : (q : ℝ) < ε := hq2.trans_le (min_le_left _ _)
        have hq0 : 0 < (q : ℝ) := hs.1.trans hq1
        calc F z s ≤ ENNReal.ofReal (((q : ℝ) / s) ^ k) * F z q := hscale z s q hs.1 hq1.le
          _ ≤ ENNReal.ofReal ((1 + 1 / ((n : ℝ) + 1)) ^ k) *
              ⨆ q : ℚ, ⨆ (_ : (q : ℝ) ∈ Ioo (0 : ℝ) ε), F z q := by
            gcongr ?_ * ?_
            · apply ENNReal.ofReal_le_ofReal
              apply pow_le_pow_left₀ (div_pos hq0 hs.1).le
              rw [div_le_iff₀ hs.1]
              have := hq2.trans_le (min_le_right _ _)
              linarith
            · exact le_iSup₂ (f := fun (q : ℚ) (_ : (q : ℝ) ∈ Ioo (0 : ℝ) ε) => F z q) q
                ⟨hq0, hqε⟩
      have h1 : Tendsto (fun n : ℕ => ENNReal.ofReal ((1 + 1 / ((n : ℝ) + 1)) ^ k)) atTop
          (𝓝 1) := by
        rw [← ENNReal.ofReal_one]
        apply ENNReal.tendsto_ofReal
        have := ((tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)).const_add 1).pow k
        simpa using this
      have htend := ENNReal.Tendsto.mul_const h1
        (Or.inl one_ne_zero) (b := ⨆ q : ℚ, ⨆ (_ : (q : ℝ) ∈ Ioo (0 : ℝ) ε), F z q)
      rw [one_mul] at htend
      exact ge_of_tendsto' htend hn
    · refine iSup_le fun q => iSup_le fun hq => ?_
      exact le_iSup₂ (f := fun s (_ : s ∈ Ioo (0 : ℝ) ε) => F z s) (q : ℝ) hq
  -- the upper limit along the radii `1/(n+1)`, with rational `s`
  have hform : ∀ z, limsup (F z) (𝓝[>] 0) = ⨅ n : ℕ, ⨆ q : ℚ,
      ⨆ (_ : (q : ℝ) ∈ Ioo (0 : ℝ) (1 / ((n : ℝ) + 1))), F z q := by
    intro z
    rw [Submission.rectifiability_mickle_rado_limsup_eq_iInf (F z)]
    congr 1
    funext n
    exact hsupq z _ (by positivity)
  rw [funext hform]
  exact Measurable.iInf fun n => Measurable.iSup fun q => Measurable.iSup fun hq => hFm q hq.1
/-- The parameter set of fibre witnesses (alternative T3 of the Besicovitch–Federer trichotomy in
the proof of Simon Ch. 6, 8.1) is Borel.  For `E ⊆ ℝ^N` σ-compact, `δ ∈ ℝ` and
`L_v x = (⟨v₁, x⟩, …, ⟨v_k, x⟩)` (`k = m + 1`), the set `W` of `(a, v)` admitting `x ∈ E` with
`x ≠ a`, `|x − a| < δ` and `L_v x = L_v a` is measurable.  With `E = ⋃ₙ Kₙ`, `Kₙ` compact,
`W = ⋃_{n,l} π(C_{n,l})`, where `π(x, (a, v)) = (a, v)` and `C_{n,l}` is the compact set of
`(x, (a, v))` with `x ∈ Kₙ`, `‖(a, v)‖ ≤ l`, `1/(l+1) ≤ |x − a| ≤ δ − 1/(l+1)` and
`L_v x = L_v a`. -/
theorem Submission.rectifiability_bf_witness_set_measurable : (∀ (N m : ℕ) (E : Set (Eucl N)) (δ : ℝ), IsSigmaCompact E → MeasurableSet {p : Eucl N × (Fin (m + 1) → Eucl N) | ∃ x ∈ E, x ≠ p.1 ∧ dist x p.1 < δ ∧ (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (p.2 i) x) : Eucl (m + 1)) = (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (p.2 i) p.1) : Eucl (m + 1))}) := by
  intro N m E δ hE
  -- `E = ⋃ₙ Kₙ` with every `Kₙ` compact.
  obtain ⟨K, hK, hKE⟩ := hE
  -- `(x, (a, v)) ↦ L_v x` and `(x, (a, v)) ↦ L_v a` are continuous.
  have hLc : Continuous (fun q : Eucl N × (Eucl N × (Fin (m + 1) → Eucl N)) =>
      (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (q.2.2 i) q.1) : Eucl (m + 1))) := by
    refine (PiLp.continuous_toLp 2 _).comp (continuous_pi fun i => ?_)
    exact ((continuous_apply i).comp (continuous_snd.comp continuous_snd)).inner continuous_fst
  have hLc' : Continuous (fun q : Eucl N × (Eucl N × (Fin (m + 1) → Eucl N)) =>
      (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (q.2.2 i) q.2.1) : Eucl (m + 1))) := by
    refine (PiLp.continuous_toLp 2 _).comp (continuous_pi fun i => ?_)
    exact ((continuous_apply i).comp (continuous_snd.comp continuous_snd)).inner
      (continuous_fst.comp continuous_snd)
  -- `C_{n,l}`: `x ∈ Kₙ`, `‖(a, v)‖ ≤ l`, `1/(l+1) ≤ |x − a| ≤ δ − 1/(l+1)`, `L_v x = L_v a`.
  let C : ℕ → ℕ → Set (Eucl N × (Eucl N × (Fin (m + 1) → Eucl N))) := fun n l =>
    (K n ×ˢ closedBall (0 : Eucl N × (Fin (m + 1) → Eucl N)) l) ∩
      ({q | 1 / ((l : ℝ) + 1) ≤ dist q.1 q.2.1} ∩ {q | dist q.1 q.2.1 ≤ δ - 1 / ((l : ℝ) + 1)} ∩
        {q | (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (q.2.2 i) q.1) : Eucl (m + 1)) =
          (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (q.2.2 i) q.2.1) : Eucl (m + 1))})
  -- A compact set intersected with closed conditions is compact.
  have hCc : ∀ n l, IsCompact (C n l) := by
    intro n l
    refine ((hK n).prod (isCompact_closedBall _ _)).inter_right ?_
    refine ((isClosed_le continuous_const ?_).inter (isClosed_le ?_ continuous_const)).inter
      (isClosed_eq hLc hLc')
    · exact continuous_fst.dist (continuous_fst.comp continuous_snd)
    · exact continuous_fst.dist (continuous_fst.comp continuous_snd)
  -- `W = ⋃_{n,l} π(C_{n,l})`, choosing `l` by the Archimedean property.
  have key : {p : Eucl N × (Fin (m + 1) → Eucl N) | ∃ x ∈ E, x ≠ p.1 ∧ dist x p.1 < δ ∧
      (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (p.2 i) x) : Eucl (m + 1)) =
        (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (p.2 i) p.1) : Eucl (m + 1))} =
      ⋃ n, ⋃ l : ℕ, Prod.snd '' C n l := by
    ext p
    simp only [mem_ofPred_eq, mem_iUnion, mem_image]
    constructor
    · rintro ⟨x, hxE, hxa, hxδ, hL⟩
      rw [← hKE, mem_iUnion] at hxE
      obtain ⟨n, hn⟩ := hxE
      have hd0 : 0 < dist x p.1 := dist_pos.2 hxa
      have hmin : 0 < min (dist x p.1) (δ - dist x p.1) := lt_min hd0 (by linarith)
      obtain ⟨l₁, hl₁⟩ := exists_nat_one_div_lt hmin
      obtain ⟨l₂, hl₂⟩ := exists_nat_ge ‖p‖
      refine ⟨n, max l₁ l₂, (x, p), ?_, rfl⟩
      have hle : 1 / ((max l₁ l₂ : ℕ) + 1 : ℝ) ≤ 1 / ((l₁ : ℝ) + 1) := by
        apply one_div_le_one_div_of_le (by positivity)
        have : (l₁ : ℝ) ≤ ((max l₁ l₂ : ℕ) : ℝ) := by exact_mod_cast le_max_left l₁ l₂
        linarith
      have h1 := lt_of_le_of_lt hle hl₁
      refine ⟨⟨hn, ?_⟩, ⟨?_, ?_⟩, hL⟩
      · rw [mem_closedBall, dist_zero_right]
        exact hl₂.trans (by exact_mod_cast le_max_right l₁ l₂)
      · exact (h1.trans_le (min_le_left _ _)).le
      · have := h1.trans_le (min_le_right _ _)
        simp only [mem_ofPred_eq]
        linarith
    · rintro ⟨n, l, q, ⟨⟨hq1, -⟩, ⟨hd1, hd2⟩, hL⟩, rfl⟩
      refine ⟨q.1, ?_, ?_, ?_, hL⟩
      · rw [← hKE]; exact mem_iUnion.2 ⟨n, hq1⟩
      · intro h
        have : (0 : ℝ) < 1 / ((l : ℝ) + 1) := by positivity
        simp only [mem_ofPred_eq, h, dist_self] at hd1
        linarith
      · have : (0 : ℝ) < 1 / ((l : ℝ) + 1) := by positivity
        simp only [mem_ofPred_eq] at hd2
        linarith
  -- Each `π(C_{n,l})` is compact, hence Borel; so is the countable union.
  rw [key]
  exact MeasurableSet.iUnion fun n => MeasurableSet.iUnion fun l =>
    ((hCc n l).image continuous_snd).measurableSet

/-- **Borel measurability of the cone ratio** (step 2(a)–(c) of the Besicovitch–Federer
trichotomy, Mattila, *Geometry of Sets and Measures in Euclidean Spaces*, Lemma 18.9).  For
`v ∈ (ℝ^N)^k`, `k = m + 1`, let `L_v y = (⟨v₁, y⟩, …, ⟨v_k, y⟩)` and
`X_v(a, r, s) = {x : |x - a| < r, |L_v (x - a)| < s |x - a|}`.  Then
`Φ(a, v) = limsup_{s → 0⁺} sup_{0 < r < δ} μ(X_v(a, r, s)) / (rs)ᵏ` is measurable in `(a, v)`:
the cones are the sections of `G(r, s) = {((a, v), x) : |x - a| < r, |L_v (x - a)| < s |x - a|}`,
which is open, monotone in `s` and left continuous in `r`, so `limsup_sup_measurable` applies. -/
theorem Submission.rectifiability_bf_cone_ratio_measurable : ∀ (N m : ℕ) (μ : Measure (Eucl N)) (δ : ℝ), SFinite μ → Measurable (fun p : Eucl N × (Fin (m + 1) → Eucl N) => limsup (fun s : ℝ => ⨆ r ∈ Ioo (0 : ℝ) δ, μ {x | dist x p.1 < r ∧ ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (p.2 i) (x - p.1)) : Eucl (m + 1))‖ < s * ‖x - p.1‖} / ENNReal.ofReal ((r * s) ^ (m + 1))) (𝓝[>] 0)) := by
  intro N m μ δ hμ
  -- Step 1: the cone `X_v(a, r, s)` is the section of `G(r, s)` at `z = (a, v)`.
  refine Submission.rectifiability_bf_limsup_sup_measurable (Eucl N × (Fin (m + 1) → Eucl N))
    (Eucl N) (m + 1) μ δ (fun r s => {q | dist q.2 q.1.1 < r ∧
      ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (q.1.2 i) (q.2 - q.1.1)) : Eucl (m + 1))‖ <
        s * ‖q.2 - q.1.1‖}) hμ ?_ ?_ ?_
  -- Step 2: `G(r, s)` is open (strict inequalities between continuous functions), hence
  -- measurable in the second-countable product.
  · intro r s
    have hL : Continuous fun q : (Eucl N × (Fin (m + 1) → Eucl N)) × Eucl N =>
        ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (q.1.2 i) (q.2 - q.1.1)) :
          Eucl (m + 1))‖ :=
      continuous_norm.comp ((PiLp.continuous_toLp 2 _).comp (continuous_pi fun i =>
        ((continuous_apply i).comp (continuous_snd.comp continuous_fst)).inner
          (continuous_snd.sub (continuous_fst.comp continuous_fst))))
    have hd : Continuous fun q : (Eucl N × (Fin (m + 1) → Eucl N)) × Eucl N => dist q.2 q.1.1 :=
      by fun_prop
    have hn : Continuous fun q : (Eucl N × (Fin (m + 1) → Eucl N)) × Eucl N =>
        s * ‖q.2 - q.1.1‖ := by fun_prop
    exact ((isOpen_lt hd continuous_const).inter (isOpen_lt hL hn)).measurableSet
  -- Step 3: `G(r, s)` is monotone in `s`, as `s |x - a| ≤ s' |x - a|` for `s ≤ s'`.
  · intro r s s' hss' q hq
    exact ⟨hq.1, hq.2.trans_le (by gcongr)⟩
  -- Step 4: `G(r, s) = ⋃_{0 < r' < r} G(r', s)`; for `|x - a| < r` take `r' = (|x - a| + r) / 2`.
  · intro r s hr
    ext q
    simp only [mem_iUnion, mem_ofPred_eq, mem_Ioo]
    constructor
    · rintro ⟨h1, h2⟩
      exact ⟨(dist q.2 q.1.1 + r) / 2, ⟨by positivity, by linarith⟩, by linarith, h2⟩
    · rintro ⟨r', ⟨-, hr'r⟩, h1, h2⟩
      exact ⟨h1.trans hr'r, h2⟩
/-- Cone-ratio dichotomy.  Write `L x = (⟨v₁, x⟩, …, ⟨v_k, x⟩)` (`k = m + 1`),
`X(r, s) = {x : |x − a| < r, |L(x − a)| < s|x − a|}` and
`Φ = limsup_{s→0⁺} sup_{0<r<δ} μ(X(r, s))/(rs)ᵏ`.  If `Φ = 0`, then for each `η > 0` some
`s ∈ (0, 1)` has `μ(X(r, s)) ≤ η(rs)ᵏ` for all `r ∈ (0, δ)`.  If `Φ = ∞`, then
`X(r, s) ⊆ L⁻¹(B̄(La, rs))`, so the push-forward `L_# μ` has infinite upper `k`-density at
`La`: its density quotients at the radii `rs → 0⁺` are unbounded. -/
theorem Submission.rectifiability_bf_cone_ratio_reduction :
    (∀ (N m : ℕ) (μ : Measure (Eucl N)) (δ : ℝ) (a : Eucl N) (v : Fin (m + 1) → Eucl N),
      (limsup (fun s : ℝ => ⨆ r ∈ Ioo (0 : ℝ) δ, μ {x | dist x a < r ∧
          ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (x - a)) : Eucl (m + 1))‖ <
            s * ‖x - a‖} / ENNReal.ofReal ((r * s) ^ (m + 1))) (𝓝[>] 0) = 0 →
        ∀ η : ℝ, 0 < η → ∃ s ∈ Ioo (0 : ℝ) 1, ∀ r ∈ Ioo (0 : ℝ) δ, μ {x | dist x a < r ∧
          ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (x - a)) : Eucl (m + 1))‖ <
            s * ‖x - a‖} ≤ ENNReal.ofReal (η * (r * s) ^ (m + 1))) ∧
      (limsup (fun s : ℝ => ⨆ r ∈ Ioo (0 : ℝ) δ, μ {x | dist x a < r ∧
          ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (x - a)) : Eucl (m + 1))‖ <
            s * ‖x - a‖} / ENNReal.ofReal ((r * s) ^ (m + 1))) (𝓝[>] 0) = ⊤ →
        dimensionalUpperDensity (Measure.map (fun x : Eucl N =>
          (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) x) : Eucl (m + 1))) μ).toOuterMeasure
          ((m + 1 : ℕ) : ℝ) univ
          (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) a) : Eucl (m + 1)) = ⊤)) := by
  intro N m μ δ a v
  -- `X r s` is the cone, `F s` the supremum of the ratios `μ(X r s)/(rs)ᵏ` over `r ∈ (0, δ)`
  set X : ℝ → ℝ → Set (Eucl N) := fun r s => {x | dist x a < r ∧
    ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (x - a)) : Eucl (m + 1))‖ < s * ‖x - a‖}
  set F : ℝ → ℝ≥0∞ := fun s =>
    ⨆ r ∈ Ioo (0 : ℝ) δ, μ (X r s) / ENNReal.ofReal ((r * s) ^ (m + 1)) with hF
  constructor
  · -- `Φ = 0`: eventually `F s < η`; take such an `s ∈ (0, 1)`
    intro h0 η hη
    have hlt : limsup F (𝓝[>] 0) < ENNReal.ofReal η := by
      rw [h0]; exact ENNReal.ofReal_pos.2 hη
    obtain ⟨s, hs1, hs2⟩ :=
      ((eventually_lt_of_limsup_lt hlt).and (Ioo_mem_nhdsGT one_pos)).exists
    refine ⟨s, hs2, fun r hr => ?_⟩
    have hpos : 0 < (r * s) ^ (m + 1) := pow_pos (mul_pos hr.1 hs2.1) _
    have h3 : μ (X r s) / ENNReal.ofReal ((r * s) ^ (m + 1)) < ENNReal.ofReal η :=
      (le_iSup₂ (f := fun r (_ : r ∈ Ioo (0 : ℝ) δ) =>
        μ (X r s) / ENNReal.ofReal ((r * s) ^ (m + 1))) r hr).trans_lt hs1
    rw [ENNReal.div_lt_iff (Or.inl (ENNReal.ofReal_pos.2 hpos).ne') (Or.inl ENNReal.ofReal_ne_top)]
      at h3
    rw [ENNReal.ofReal_mul hη.le]
    exact h3.le
  · -- `Φ = ∞`: ratios above `b ω_k` at `r < δ`, small `s` give density quotients above `b` at `rs`
    intro htop
    set L : Eucl N → Eucl (m + 1) := fun x =>
      (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) x) : Eucl (m + 1)) with hL
    have hLc : Continuous L :=
      (PiLp.continuous_toLp 2 _).comp (continuous_pi fun i => continuous_const.inner continuous_id)
    have hLsub : ∀ x y, L x - L y = L (x - y) := by
      intro x y
      simp only [hL, ← WithLp.toLp_sub]
      congr 1
      funext i
      simp [inner_sub_right]
    set ω := Poincare.SimonGMT.Chapter01.realUnitBallVolume (((m + 1 : ℕ) : ℝ)) with hω
    have hω0 : ω ≠ 0 := by
      rw [hω, Poincare.SimonGMT.Chapter01.realUnitBallVolume]
      refine (ENNReal.ofReal_pos.2 (div_pos (Real.rpow_pos_of_pos Real.pi_pos _)
        (Real.Gamma_pos_of_pos ?_))).ne'
      positivity
    have hωt : ω ≠ ⊤ := by
      rw [hω, Poincare.SimonGMT.Chapter01.realUnitBallVolume]
      exact ENNReal.ofReal_ne_top
    -- `δ > 0`, since otherwise `F = 0` and `Φ = 0`
    have hδ : 0 < δ := by
      by_contra hδ
      have hF0 : F = fun _ => 0 := by
        funext s
        rw [hF, Ioo_eq_empty (not_lt.2 (not_lt.1 hδ))]
        simp
      rw [hF0, limsup_const] at htop
      exact ENNReal.zero_ne_top htop
    unfold dimensionalUpperDensity
    refine ENNReal.eq_top_of_forall_nnreal_le fun b => ?_
    refine le_limsup_of_frequently_le ?_ (by isBoundedDefault)
    rw [(nhdsGT_basis (0 : ℝ)).frequently_iff]
    intro ρ₀ hρ₀
    have hΛ : (b : ℝ≥0∞) * ω < limsup F (𝓝[>] 0) := by
      rw [htop]
      exact ENNReal.mul_lt_top ENNReal.coe_lt_top (lt_top_iff_ne_top.2 hωt)
    obtain ⟨s, hs1, hs2⟩ := ((frequently_lt_of_lt_limsup (by isBoundedDefault) hΛ).and_eventually
      (Ioo_mem_nhdsGT (div_pos hρ₀ hδ))).exists
    obtain ⟨r, hr, hrs⟩ := lt_biSup_iff.1 hs1
    have hrs0 : 0 < r * s := mul_pos hr.1 hs2.1
    have hrsρ : r * s < ρ₀ := by
      have h1 : r * s < δ * (ρ₀ / δ) := mul_lt_mul'' hr.2 hs2.2 hr.1.le hs2.1.le
      rwa [mul_div_cancel₀ _ hδ.ne'] at h1
    refine ⟨r * s, ⟨hrs0, hrsρ⟩, ?_⟩
    have hpos : 0 < (r * s) ^ (m + 1) := pow_pos hrs0 _
    -- the cone lies in the preimage of the closed ball `B̄(La, rs)`
    have hsub : X r s ⊆ L ⁻¹' closedBall (L a) (r * s) := by
      intro x hx
      simp only [mem_preimage, mem_closedBall, dist_eq_norm, hLsub]
      have h1 : ‖x - a‖ < r := by rw [← dist_eq_norm]; exact hx.1
      calc ‖L (x - a)‖ ≤ s * ‖x - a‖ := hx.2.le
        _ ≤ s * r := by gcongr; exact hs2.1.le
        _ = r * s := mul_comm _ _
    have hmap :
        μ (X r s) ≤ (Measure.map L μ).toOuterMeasure (univ ∩ closedBall (L a) (r * s)) := by
      rw [Measure.coe_toOuterMeasure, univ_inter,
        Measure.map_apply hLc.measurable isClosed_closedBall.measurableSet]
      exact measure_mono hsub
    unfold Poincare.SimonGMT.Chapter01.dimensionalDensityQuotient
    rw [ENNReal.ofReal_rpow_of_nonneg hrs0.le (by positivity), Real.rpow_natCast,
      ENNReal.le_div_iff_mul_le (Or.inl (mul_ne_zero hω0 (ENNReal.ofReal_pos.2 hpos).ne'))
        (Or.inl (ENNReal.mul_ne_top hωt ENNReal.ofReal_ne_top))]
    refine le_trans ?_ hmap
    rw [ENNReal.lt_div_iff_mul_lt (Or.inl (ENNReal.ofReal_pos.2 hpos).ne')
      (Or.inl ENNReal.ofReal_ne_top)] at hrs
    rw [← mul_assoc]
    exact hrs.le
/-- Cones versus unions of coordinate fibres (step 4 of the Besicovitch–Federer trichotomy,
Mattila 18.9, used for Simon Ch. 6, 8.1).  Let `k = m + 1`, `L_u(y) = (⟨u₁, y⟩, …, ⟨u_k, y⟩)`,
`X_u(a, r, s) = {x : |x − a| < r, |L_u(x − a)| < s|x − a|}`, `u ⊕_j c = (uᵢ + cᵢ e_j)ᵢ` and
`K_j(t) = {x ≠ a : L_{u ⊕_j c}(x − a) = 0 for some |c| < t}`.  With
`Φ = limsup_{s → 0⁺} sup_{0<r<δ} μ(X_u(a, r, s))/(rs)ᵏ` and
`ϑ_j = limsup_{t → 0⁺} sup_{0<r<δ} μ(B(a, r) ∩ K_j(t))/(rt)ᵏ`, we have `ϑ_j ≤ Φ` for every `j`
and `Φ ≤ (√N)ᵏ Σ_j ϑ_j`.  Since `L_{u ⊕_j c}(y) = L_u(y) + y_j c`,
`B(a, r) ∩ K_j(t) ⊆ X_u(a, r, t)` and `X_u(a, r, s) ⊆ ⋃_j B(a, r) ∩ K_j(√N s)`. -/
theorem Submission.rectifiability_bf_fibre_cone_comparison :
    ∀ (N m : ℕ) (μ : Measure (Eucl N)) (δ : ℝ) (a : Eucl N) (u : Fin (m + 1) → Eucl N), (∀ j : Fin N, limsup (fun t : ℝ => ⨆ r ∈ Ioo (0 : ℝ) δ, μ (ball a r ∩ {x | x ≠ a ∧ ∃ c ∈ ball (0 : Eucl (m + 1)) t, (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (u i + c i • EuclideanSpace.single j (1 : ℝ)) (x - a)) : Eucl (m + 1)) = 0}) / ENNReal.ofReal ((r * t) ^ (m + 1))) (𝓝[>] 0) ≤ limsup (fun s : ℝ => ⨆ r ∈ Ioo (0 : ℝ) δ, μ {x | dist x a < r ∧ ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (u i) (x - a)) : Eucl (m + 1))‖ < s * ‖x - a‖} / ENNReal.ofReal ((r * s) ^ (m + 1))) (𝓝[>] 0)) ∧ limsup (fun s : ℝ => ⨆ r ∈ Ioo (0 : ℝ) δ, μ {x | dist x a < r ∧ ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (u i) (x - a)) : Eucl (m + 1))‖ < s * ‖x - a‖} / ENNReal.ofReal ((r * s) ^ (m + 1))) (𝓝[>] 0) ≤ ENNReal.ofReal (Real.sqrt (N : ℝ) ^ (m + 1)) * ∑ j : Fin N, limsup (fun t : ℝ => ⨆ r ∈ Ioo (0 : ℝ) δ, μ (ball a r ∩ {x | x ≠ a ∧ ∃ c ∈ ball (0 : Eucl (m + 1)) t, (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (u i + c i • EuclideanSpace.single j (1 : ℝ)) (x - a)) : Eucl (m + 1)) = 0}) / ENNReal.ofReal ((r * t) ^ (m + 1))) (𝓝[>] 0) := by
  intro N m μ δ a u
  -- `L = L_u`, `K j t = K_j(t)`, `X r s = X_u(a, r, s)`, `F = F`, `Fj j = F_j`.
  let L : Eucl N → Eucl (m + 1) := fun y => (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (u i) y) : Eucl (m + 1))
  let K : Fin N → ℝ → Set (Eucl N) := fun j t => {x | x ≠ a ∧ ∃ c ∈ ball (0 : Eucl (m + 1)) t,
    (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (u i + c i • EuclideanSpace.single j (1 : ℝ)) (x - a)) : Eucl (m + 1)) = 0}
  let X : ℝ → ℝ → Set (Eucl N) := fun r s => {x | dist x a < r ∧ ‖L (x - a)‖ < s * ‖x - a‖}
  let F : ℝ → ℝ≥0∞ := fun s => ⨆ r ∈ Ioo (0 : ℝ) δ, μ (X r s) / ENNReal.ofReal ((r * s) ^ (m + 1))
  let Fj : Fin N → ℝ → ℝ≥0∞ := fun j t => ⨆ r ∈ Ioo (0 : ℝ) δ, μ (ball a r ∩ K j t) / ENNReal.ofReal ((r * t) ^ (m + 1))
  show (∀ j, limsup (Fj j) (𝓝[>] 0) ≤ limsup F (𝓝[>] 0)) ∧
    limsup F (𝓝[>] 0) ≤ ENNReal.ofReal (Real.sqrt (N : ℝ) ^ (m + 1)) * ∑ j : Fin N, limsup (Fj j) (𝓝[>] 0)
  -- Step 1, fibre identity: `L_{u ⊕_j c}(y) = L_u(y) + y_j c`.
  have hfib : ∀ (j : Fin N) (c : Eucl (m + 1)) (y : Eucl N),
      (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (u i + c i • EuclideanSpace.single j (1 : ℝ)) y) : Eucl (m + 1)) =
        L y + (y j) • c := by
    intro j c y
    ext i
    simp [L, inner_add_left, real_inner_smul_left, EuclideanSpace.inner_single_left, mul_comm]
  -- Step 2, inclusion (ii): `B(a, r) ∩ K_j(t) ⊆ X_u(a, r, t)` for `t > 0`.
  have hincl2 : ∀ (j : Fin N) (r t : ℝ), 0 < t → ball a r ∩ K j t ⊆ X r t := by
    rintro j r t ht x ⟨hxr, hxa, c, hc, hx0⟩
    refine ⟨hxr, ?_⟩
    rw [hfib] at hx0
    have hL : L (x - a) = -((x - a) j • c) := eq_neg_of_add_eq_zero_left hx0
    rw [hL, norm_neg, norm_smul]
    have hy : 0 < ‖x - a‖ := norm_pos_iff.2 (sub_ne_zero.2 hxa)
    have hc' : ‖c‖ < t := by simpa using hc
    have hyj : ‖(x - a) j‖ ≤ ‖x - a‖ := PiLp.norm_apply_le _ _
    calc ‖(x - a) j‖ * ‖c‖ ≤ ‖x - a‖ * ‖c‖ := by gcongr
      _ < ‖x - a‖ * t := mul_lt_mul_of_pos_left hc' hy
      _ = t * ‖x - a‖ := mul_comm _ _
  refine ⟨fun j => ?_, ?_⟩
  -- Step 3: `F_j ≤ F` on `(0, ∞)`, hence `ϑ_j ≤ Φ`.
  · refine limsup_le_limsup ?_ (by isBoundedDefault) (by isBoundedDefault)
    filter_upwards [self_mem_nhdsWithin] with t ht
    refine iSup₂_mono fun r hr => ?_
    exact ENNReal.div_le_div_right (measure_mono (hincl2 j r t ht)) _
  · rcases Nat.eq_zero_or_pos N with hN | hN
    -- Step 4: for `N = 0` every cone is empty, so `Φ = 0`.
    · subst hN
      have hF0 : F = fun _ => 0 := by
        funext s
        have hX : ∀ r, X r s = ∅ := by
          intro r
          ext x
          have hxa : x - a = 0 := Subsingleton.elim _ _
          simp [X, hxa]
        simp [F, hX]
      rw [hF0, limsup_const]
      exact zero_le
    · set σ : ℝ := Real.sqrt (N : ℝ) with hσdef
      have hσ : 0 < σ := Real.sqrt_pos.2 (by exact_mod_cast hN)
      have hσsq : σ ^ 2 = (N : ℝ) := Real.sq_sqrt (Nat.cast_nonneg N)
      -- Step 5, inclusion (i): `X_u(a, r, s) ⊆ ⋃_j B(a, r) ∩ K_j(σ s)` for `s > 0`.
      have hincl1 : ∀ r s, 0 < s → X r s ⊆ ⋃ j, ball a r ∩ K j (σ * s) := by
        rintro r s hs x ⟨hxr, hx⟩
        set y := x - a with hydef
        have hy : 0 < ‖y‖ := by
          rcases (norm_nonneg y).lt_or_eq with h | h
          · exact h
          · exfalso
            rw [← h, mul_zero] at hx
            exact (norm_nonneg _).not_gt hx
        obtain ⟨j, -, hj⟩ := Finset.exists_max_image Finset.univ (fun j => ‖y j‖)
          (Finset.univ_nonempty_iff.2 ⟨⟨0, hN⟩⟩)
        have hsq : ‖y‖ ^ 2 ≤ (σ * ‖y j‖) ^ 2 := by
          rw [PiLp.norm_sq_eq_of_L2, mul_pow, hσsq]
          calc ∑ i, ‖y i‖ ^ 2 ≤ ∑ _i : Fin N, ‖y j‖ ^ 2 :=
                Finset.sum_le_sum fun i _ => pow_le_pow_left₀ (norm_nonneg _) (hj i (Finset.mem_univ i)) 2
            _ = (N : ℝ) * ‖y j‖ ^ 2 := by simp
        have hle : ‖y‖ ≤ σ * ‖y j‖ :=
          (pow_le_pow_iff_left₀ (norm_nonneg _) (by positivity) two_ne_zero).1 hsq
        have hyj : 0 < ‖y j‖ := by
          by_contra hcon
          have : ‖y j‖ = 0 := le_antisymm (not_lt.1 hcon) (norm_nonneg _)
          rw [this, mul_zero] at hle
          linarith
        have hyj0 : y j ≠ 0 := norm_pos_iff.1 hyj
        refine mem_iUnion.2 ⟨j, mem_ball.2 hxr, ?_, (-(y j)⁻¹) • L y, ?_, ?_⟩
        · intro h
          rw [hydef, h, sub_self, norm_zero] at hy
          exact lt_irrefl _ hy
        · rw [mem_ball_zero_iff, norm_smul, norm_neg, norm_inv]
          rw [inv_mul_lt_iff₀ hyj]
          calc ‖L y‖ < s * ‖y‖ := hx
            _ ≤ s * (σ * ‖y j‖) := by gcongr
            _ = ‖y j‖ * (σ * s) := by ring
        · rw [hfib, smul_smul, mul_neg, mul_inv_cancel₀ hyj0, neg_smul, one_smul, add_neg_cancel]
      -- Step 6, pointwise bound: `F(s) ≤ σᵏ Σ_j F_j(σ s)` for `s > 0`.
      have hpt : ∀ s, 0 < s → F s ≤ ENNReal.ofReal (σ ^ (m + 1)) * ∑ j, Fj j (σ * s) := by
        intro s hs
        refine iSup₂_le fun r hr => ?_
        have hc0 : ENNReal.ofReal (σ ^ (m + 1)) ≠ 0 := (ENNReal.ofReal_pos.2 (by positivity)).ne'
        have hA : ENNReal.ofReal ((r * (σ * s)) ^ (m + 1)) =
            ENNReal.ofReal (σ ^ (m + 1)) * ENNReal.ofReal ((r * s) ^ (m + 1)) := by
          rw [← ENNReal.ofReal_mul (by positivity), ← mul_pow]
          congr 2
          ring
        calc μ (X r s) / ENNReal.ofReal ((r * s) ^ (m + 1))
            ≤ (∑ j, μ (ball a r ∩ K j (σ * s))) / ENNReal.ofReal ((r * s) ^ (m + 1)) := by
              refine ENNReal.div_le_div_right ?_ _
              exact (measure_mono (hincl1 r s hs)).trans (measure_iUnion_fintype_le μ _)
          _ = ∑ j, ENNReal.ofReal (σ ^ (m + 1)) *
                (μ (ball a r ∩ K j (σ * s)) / ENNReal.ofReal ((r * (σ * s)) ^ (m + 1))) := by
              rw [ENNReal.sum_div]
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [hA, ← mul_div_assoc, ENNReal.mul_div_mul_left _ _ hc0 ENNReal.ofReal_ne_top]
          _ ≤ ∑ j, ENNReal.ofReal (σ ^ (m + 1)) * Fj j (σ * s) := by
              refine Finset.sum_le_sum fun j _ => ?_
              gcongr
              exact le_iSup₂ (f := fun r (_ : r ∈ Ioo (0 : ℝ) δ) =>
                μ (ball a r ∩ K j (σ * s)) / ENNReal.ofReal ((r * (σ * s)) ^ (m + 1))) r hr
          _ = ENNReal.ofReal (σ ^ (m + 1)) * ∑ j, Fj j (σ * s) := by rw [Finset.mul_sum]
      -- Step 8: `limsup` is subadditive along `𝓝[>] 0` (direct `ε`-argument).
      have hadd : ∀ (v w : ℝ → ℝ≥0∞), limsup (fun s => v s + w s) (𝓝[>] (0 : ℝ)) ≤
          limsup v (𝓝[>] 0) + limsup w (𝓝[>] 0) := by
        intro v w
        refine ENNReal.le_of_forall_pos_le_add fun ε hε hlt => ?_
        have hv : limsup v (𝓝[>] (0 : ℝ)) < ⊤ := lt_of_le_of_lt le_self_add hlt
        have hw : limsup w (𝓝[>] (0 : ℝ)) < ⊤ := lt_of_le_of_lt le_add_self hlt
        have hε2 : (ε : ℝ≥0∞) / 2 ≠ 0 := by
          simp [ENNReal.div_eq_zero_iff, hε.ne']
        refine limsup_le_of_le (by isBoundedDefault) ?_
        filter_upwards [eventually_lt_of_limsup_lt (ENNReal.lt_add_right hv.ne hε2),
          eventually_lt_of_limsup_lt (ENNReal.lt_add_right hw.ne hε2)] with x h1 h2
        calc v x + w x ≤ (limsup v (𝓝[>] 0) + (ε : ℝ≥0∞) / 2) + (limsup w (𝓝[>] 0) + (ε : ℝ≥0∞) / 2) :=
              add_le_add h1.le h2.le
          _ = limsup v (𝓝[>] 0) + limsup w (𝓝[>] 0) + ε := by
              rw [add_add_add_comm, ENNReal.add_halves]
      have hsum : ∀ (S : Finset (Fin N)) (h : Fin N → ℝ → ℝ≥0∞),
          limsup (fun s => ∑ j ∈ S, h j s) (𝓝[>] (0 : ℝ)) ≤ ∑ j ∈ S, limsup (h j) (𝓝[>] 0) := by
        intro S h
        induction S using Finset.induction_on with
        | empty => simp
        | insert j S hj ih =>
          simp only [Finset.sum_insert hj]
          exact (hadd (h j) (fun s => ∑ i ∈ S, h i s)).trans (add_le_add le_rfl ih)
      -- Step 9, change of variable `t = σ s`: `s ↦ σ s` maps `𝓝[>] 0` into `𝓝[>] 0`.
      have hT : Tendsto (fun s : ℝ => σ * s) (𝓝[>] 0) (𝓝[>] 0) := by
        rw [tendsto_nhdsWithin_iff]
        refine ⟨?_, ?_⟩
        · have : Tendsto (fun s : ℝ => σ * s) (𝓝 0) (𝓝 (σ * 0)) :=
            ((continuous_const.mul continuous_id).tendsto 0)
          rw [mul_zero] at this
          exact this.mono_left nhdsWithin_le_nhds
        · filter_upwards [self_mem_nhdsWithin] with s hs
          exact mul_pos hσ hs
      have hcv : ∀ j, limsup (fun s => Fj j (σ * s)) (𝓝[>] (0 : ℝ)) ≤ limsup (Fj j) (𝓝[>] 0) := by
        intro j
        calc limsup (fun s => Fj j (σ * s)) (𝓝[>] (0 : ℝ))
            = limsup (Fj j) (map (fun s : ℝ => σ * s) (𝓝[>] 0)) := Filter.limsup_comp (Fj j) _ _
          _ ≤ limsup (Fj j) (𝓝[>] 0) := limsup_le_limsup_of_le hT (by isBoundedDefault) (by isBoundedDefault)
      -- Steps 7 and 10: pull out the constant `σᵏ`, then apply steps 8 and 9.
      calc limsup F (𝓝[>] 0) ≤ limsup (fun s => ENNReal.ofReal (σ ^ (m + 1)) * ∑ j, Fj j (σ * s)) (𝓝[>] 0) := by
            refine limsup_le_limsup ?_ (by isBoundedDefault) (by isBoundedDefault)
            filter_upwards [self_mem_nhdsWithin] with s hs
            exact hpt s hs
        _ = ENNReal.ofReal (σ ^ (m + 1)) * limsup (fun s => ∑ j, Fj j (σ * s)) (𝓝[>] 0) :=
            ENNReal.limsup_const_mul_of_ne_top ENNReal.ofReal_ne_top
        _ ≤ ENNReal.ofReal (σ ^ (m + 1)) * ∑ j, limsup (fun s => Fj j (σ * s)) (𝓝[>] 0) := by
            gcongr
            exact hsum Finset.univ (fun j s => Fj j (σ * s))
        _ ≤ ENNReal.ofReal (σ ^ (m + 1)) * ∑ j, limsup (Fj j) (𝓝[>] 0) := by
            gcongr with j
            exact hcv j
/-- **Slice densities of the exceptional parameters** (Mattila, *Geometry of Sets and Measures in
Euclidean Spaces*, Lemma 18.9; for transversal families, Hovila–Järvenpää–Järvenpää–Ledrappier,
arXiv:1104.3453, Lemma 2.5).  Let `k = m + 1`, `L_u y = (⟨u_i, y⟩)_i`,
`w ⊕ c = (w_i + c_i e_j)_i`, `K_w(C) = {x ≠ a : L_{w ⊕ c}(x − a) = 0 for some c ∈ C}` and
`ϑ_j(u) = limsup_{t↓0} sup_{0<r<δ} μ(B(a,r) ∩ K_u(B(0,t)))/(rt)ᵏ`.  Then the set `𝔅_j` of `u`
with `0 < ϑ_j(u) < ∞` and no `x ∈ E` with `0 < |x − a| < δ` and `L_u x = L_u a` is Lebesgue-null.
For fixed `w`, `ψ_w(C) = sup_{0<r<δ} μ(B(a,r) ∩ K_w(C))/rᵏ` is an outer measure on `ℝᵏ`, inner
continuous on open balls, and vanishes on the Borel set `D_w` of those `c` for which `w ⊕ c` has
no such `x`, because `μ(ℝ^N ∖ E) = 0`.  As `K_w(B(c,t)) = K_{w ⊕ c}(B(0,t))`, the upper
`k`-density of `ψ_w` at `c` is `ϑ_j(w ⊕ c)`, so by the Mickle–Radó theorem
`Lᵏ{c : w ⊕ c ∈ 𝔅_j} = 0` for every `w`.  `𝔅_j` is Borel, and Tonelli for `(w, c) ↦ w ⊕ c` in both
orders, with translation invariance, gives `𝓛(𝔅_j) · ∞ = 0`. -/
theorem Submission.rectifiability_bf_slice_density_null : ∀ (N m : ℕ) (μ : Measure (Eucl N)) (E : Set (Eucl N)) (δ : ℝ) (a : Eucl N) (j : Fin N), SFinite μ → IsSigmaCompact E → μ Eᶜ = 0 → (volume : Measure (Fin (m + 1) → Eucl N)) {u : Fin (m + 1) → Eucl N | ¬ (∃ x ∈ E, x ≠ a ∧ dist x a < δ ∧ (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (u i) x) : Eucl (m + 1)) = (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (u i) a) : Eucl (m + 1))) ∧ 0 < limsup (fun t : ℝ => ⨆ r ∈ Ioo (0 : ℝ) δ, μ (ball a r ∩ {x | x ≠ a ∧ ∃ c ∈ ball (0 : Eucl (m + 1)) t, (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (u i + c i • EuclideanSpace.single j (1 : ℝ)) (x - a)) : Eucl (m + 1)) = 0}) / ENNReal.ofReal ((r * t) ^ (m + 1))) (𝓝[>] 0) ∧ limsup (fun t : ℝ => ⨆ r ∈ Ioo (0 : ℝ) δ, μ (ball a r ∩ {x | x ≠ a ∧ ∃ c ∈ ball (0 : Eucl (m + 1)) t, (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (u i + c i • EuclideanSpace.single j (1 : ℝ)) (x - a)) : Eucl (m + 1)) = 0}) / ENNReal.ofReal ((r * t) ^ (m + 1))) (𝓝[>] 0) < ⊤} = 0 := by
  intro N m μ E δ a j hμ hE hEc
  let Lu : (Fin (m + 1) → Eucl N) → Eucl N → Eucl (m + 1) := fun u y =>
    (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (u i) y) : Eucl (m + 1))
  let T3 : (Fin (m + 1) → Eucl N) → Prop := fun u => ∃ x ∈ E, x ≠ a ∧ dist x a < δ ∧
    (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (u i) x) : Eucl (m + 1)) =
      (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (u i) a) : Eucl (m + 1))
  let Ks : (Fin (m + 1) → Eucl N) → ℝ → Set (Eucl N) := fun u t => {x | x ≠ a ∧
    ∃ c ∈ ball (0 : Eucl (m + 1)) t, (WithLp.toLp 2 (fun i : Fin (m + 1) =>
      inner ℝ (u i + c i • EuclideanSpace.single j (1 : ℝ)) (x - a)) : Eucl (m + 1)) = 0}
  let θ : (Fin (m + 1) → Eucl N) → ℝ≥0∞ := fun u => limsup (fun t : ℝ => ⨆ r ∈ Ioo (0 : ℝ) δ,
    μ (ball a r ∩ Ks u t) / ENNReal.ofReal ((r * t) ^ (m + 1))) (𝓝[>] 0)
  let B : Set (Fin (m + 1) → Eucl N) := {u | ¬ T3 u ∧ 0 < θ u ∧ θ u < ⊤}
  show (volume : Measure (Fin (m + 1) → Eucl N)) B = 0
  -- step 1(a), 1(c): `L_{u ⊕ c} y = L_u y + y_j c` and `L_v (x - y) = L_v x - L_v y`
  have hfib : ∀ (u : Fin (m + 1) → Eucl N) (c : Eucl (m + 1)) (y : Eucl N),
      (WithLp.toLp 2 (fun i : Fin (m + 1) =>
        inner ℝ (u i + c i • EuclideanSpace.single j (1 : ℝ)) y) : Eucl (m + 1)) =
          Lu u y + (y j) • c := by
    intro u c y
    ext i
    simp [Lu, inner_add_left, real_inner_smul_left, EuclideanSpace.inner_single_left, mul_comm]
  have hLsub : ∀ (v : Fin (m + 1) → Eucl N) (x y : Eucl N), Lu v (x - y) = Lu v x - Lu v y := by
    intro v x y
    ext i
    simp [Lu, inner_sub_right]
  -- step 1(f): explicit form of `K_{j,u}(t)` for `t > 0`
  have hKs : ∀ u t, 0 < t → Ks u t = {x | ‖Lu u (x - a)‖ < t * ‖(x - a) j‖} ∪
      {x | x ≠ a ∧ (x - a) j = 0 ∧ Lu u (x - a) = 0} := by
    intro u t ht
    ext x
    simp only [Ks, mem_ofPred_eq, mem_union]
    constructor
    · rintro ⟨hxa, c, hc, h0⟩
      rw [hfib] at h0
      by_cases hyj : (x - a) j = 0
      · right
        refine ⟨hxa, hyj, ?_⟩
        rw [hyj, zero_smul, add_zero] at h0
        exact h0
      · left
        have hL : Lu u (x - a) = -((x - a) j • c) := eq_neg_of_add_eq_zero_left h0
        rw [hL, norm_neg, norm_smul]
        have hc' : ‖c‖ < t := mem_ball_zero_iff.1 hc
        have hpos : 0 < ‖(x - a) j‖ := norm_pos_iff.2 hyj
        calc ‖(x - a) j‖ * ‖c‖ < ‖(x - a) j‖ * t := mul_lt_mul_of_pos_left hc' hpos
          _ = t * ‖(x - a) j‖ := mul_comm _ _
    · rintro (h | ⟨hxa, hyj, h0⟩)
      · have hyj : (x - a) j ≠ 0 := by
          intro h'
          rw [h', norm_zero, mul_zero] at h
          exact (norm_nonneg _).not_gt h
        have hxa : x ≠ a := by
          intro h'
          apply hyj
          rw [h', sub_self]
          rfl
        refine ⟨hxa, (-((x - a) j)⁻¹) • Lu u (x - a), ?_, ?_⟩
        · rw [mem_ball_zero_iff, norm_smul, norm_neg, norm_inv,
            inv_mul_lt_iff₀ (norm_pos_iff.2 hyj)]
          linarith [h]
        · rw [hfib, smul_smul, mul_neg, mul_inv_cancel₀ hyj, neg_smul, one_smul, add_neg_cancel]
      · refine ⟨hxa, 0, mem_ball_self ht, ?_⟩
        rw [hfib, smul_zero, add_zero]
        exact h0
  -- step 8(a): `ϑ_j` is measurable (`limsup_sup_measurable`; `G` is Borel by step 1(f))
  let G : ℝ → ℝ → Set ((Fin (m + 1) → Eucl N) × Eucl N) := fun r t =>
    {q | q.2 ∈ ball a r ∩ Ks q.1 t}
  have hc1 : Continuous fun q : (Fin (m + 1) → Eucl N) × Eucl N => Lu q.1 (q.2 - a) := by
    refine (PiLp.continuous_toLp 2 _).comp (continuous_pi fun i => ?_)
    exact ((continuous_apply i).comp continuous_fst).inner (continuous_snd.sub continuous_const)
  have hc2 : Continuous fun q : (Fin (m + 1) → Eucl N) × Eucl N => (q.2 - a) j :=
    (PiLp.continuous_apply 2 _ j).comp (continuous_snd.sub continuous_const)
  have hGm : ∀ r t, MeasurableSet (G r t) := by
    intro r t
    rcases le_or_gt t 0 with ht | ht
    · have : G r t = ∅ := by
        ext q
        simp only [G, mem_ofPred_eq, mem_empty_iff_false, iff_false]
        rintro ⟨-, -, c, hc, -⟩
        rw [ball_eq_empty.2 ht] at hc
        exact hc
      rw [this]
      exact MeasurableSet.empty
    · have : G r t = {q | dist q.2 a < r} ∩ ({q | ‖Lu q.1 (q.2 - a)‖ < t * ‖(q.2 - a) j‖} ∪
          ({q | q.2 ≠ a} ∩ {q | (q.2 - a) j = 0} ∩ {q | Lu q.1 (q.2 - a) = 0})) := by
        ext q
        simp only [G, mem_ofPred_eq, mem_inter_iff, mem_ball]
        rw [hKs q.1 t ht]
        simp only [mem_union, mem_ofPred_eq, mem_inter_iff, and_assoc]
      rw [this]
      refine (isOpen_lt (continuous_snd.dist continuous_const) continuous_const).measurableSet.inter
        (MeasurableSet.union ?_ ?_)
      · exact (isOpen_lt hc1.norm (continuous_const.mul hc2.norm)).measurableSet
      · exact ((isOpen_ne_fun continuous_snd continuous_const).measurableSet.inter
          (isClosed_eq hc2 continuous_const).measurableSet).inter
          (isClosed_eq hc1 continuous_const).measurableSet
  have hGmono : ∀ r t t', t ≤ t' → G r t ⊆ G r t' := by
    rintro r t t' htt' q ⟨hq1, hxa, c, hc, h0⟩
    exact ⟨hq1, hxa, c, ball_subset_ball htt' hc, h0⟩
  have hGcont : ∀ r t, 0 < r → G r t = ⋃ r' ∈ Ioo (0 : ℝ) r, G r' t := by
    intro r t hr
    ext q
    simp only [G, mem_iUnion, mem_ofPred_eq, mem_inter_iff, mem_ball, mem_Ioo]
    constructor
    · rintro ⟨h1, h2⟩
      exact ⟨(dist q.2 a + r) / 2, ⟨by positivity, by linarith⟩, by linarith, h2⟩
    · rintro ⟨r', ⟨-, hr'r⟩, h1, h2⟩
      exact ⟨h1.trans hr'r, h2⟩
  have hθm : Measurable θ :=
    Submission.rectifiability_bf_limsup_sup_measurable (Fin (m + 1) → Eucl N) (Eucl N) (m + 1)
      μ δ G hμ hGm hGmono hGcont
  -- step 8(b), 8(c): `𝔅_j` is measurable (`witness_set_measurable`)
  have hW := Submission.rectifiability_bf_witness_set_measurable N m E δ hE
  have hT3m : MeasurableSet {u : Fin (m + 1) → Eucl N | ¬ T3 u} :=
    (measurable_const.prodMk measurable_id) hW.compl
  have hBm : MeasurableSet B :=
    hT3m.inter ((measurableSet_lt measurable_const hθm).inter
      (measurableSet_lt hθm measurable_const))
  -- steps 2–7: `Lᵏ{c : w ⊕ c ∈ 𝔅_j} = 0` for every `w`
  let sh : Eucl (m + 1) → (Fin (m + 1) → Eucl N) := fun c i => c i • EuclideanSpace.single j (1 : ℝ)
  have hsh : Continuous sh :=
    continuous_pi fun i => (PiLp.continuous_apply 2 _ i).smul continuous_const
  have hslice : ∀ w : Fin (m + 1) → Eucl N,
      (volume : Measure (Eucl (m + 1))) {c | w + sh c ∈ B} = 0 := by
    intro w
    let KC : Set (Eucl (m + 1)) → Set (Eucl N) := fun C => {x | x ≠ a ∧ ∃ c ∈ C,
      (WithLp.toLp 2 (fun i : Fin (m + 1) =>
        inner ℝ (w i + c i • EuclideanSpace.single j (1 : ℝ)) (x - a)) : Eucl (m + 1)) = 0}
    -- step 1(d): `K_w` is monotone and commutes with countable unions
    have hKCmono : ∀ C₁ C₂, C₁ ⊆ C₂ → KC C₁ ⊆ KC C₂ := by
      rintro C₁ C₂ h x ⟨hxa, c, hc, h0⟩
      exact ⟨hxa, c, h hc, h0⟩
    have hKCunion : ∀ (s : ℕ → Set (Eucl (m + 1))), KC (⋃ i, s i) = ⋃ i, KC (s i) := by
      intro s
      ext x
      simp only [KC, mem_ofPred_eq, mem_iUnion]
      constructor
      · rintro ⟨hxa, c, ⟨i, hci⟩, h0⟩
        exact ⟨i, hxa, c, hci, h0⟩
      · rintro ⟨i, hxa, c, hci, h0⟩
        exact ⟨hxa, c, ⟨i, hci⟩, h0⟩
    -- step 2: the outer measure `ψ_w`
    let ψ : OuterMeasure (Eucl (m + 1)) :=
      { measureOf := fun C =>
          ⨆ r ∈ Ioo (0 : ℝ) δ, μ (ball a r ∩ KC C) / ENNReal.ofReal (r ^ (m + 1))
        empty := by
          have : KC ∅ = ∅ := by
            ext x
            simp [KC]
          simp [this]
        mono := fun {s₁ s₂} h => iSup₂_mono fun r _ =>
          ENNReal.div_le_div_right (measure_mono (inter_subset_inter_right _ (hKCmono _ _ h))) _
        iUnion_nat := fun s _ => by
          refine iSup₂_le fun r hr => ?_
          rw [hKCunion, inter_iUnion]
          calc μ (⋃ i, ball a r ∩ KC (s i)) / ENNReal.ofReal (r ^ (m + 1))
              ≤ (∑' i, μ (ball a r ∩ KC (s i))) / ENNReal.ofReal (r ^ (m + 1)) :=
                ENNReal.div_le_div_right (measure_iUnion_le _) _
            _ = ∑' i, μ (ball a r ∩ KC (s i)) / ENNReal.ofReal (r ^ (m + 1)) := by
                simp only [div_eq_mul_inv, ENNReal.tsum_mul_right]
            _ ≤ ∑' i, ⨆ r ∈ Ioo (0 : ℝ) δ, μ (ball a r ∩ KC (s i)) / ENNReal.ofReal (r ^ (m + 1)) :=
                ENNReal.tsum_le_tsum fun i => le_iSup₂ (f := fun r (_ : r ∈ Ioo (0 : ℝ) δ) =>
                  μ (ball a r ∩ KC (s i)) / ENNReal.ofReal (r ^ (m + 1))) r hr }
    have hψ : ∀ C, ψ C = ⨆ r ∈ Ioo (0 : ℝ) δ, μ (ball a r ∩ KC C) / ENNReal.ofReal (r ^ (m + 1)) :=
      fun C => rfl
    -- step 3: inner continuity of `ψ_w` on open balls
    have hball : ∀ (c : Eucl (m + 1)) (τ : ℝ),
        ψ (ball c τ) = ⨆ τ' ∈ Ioo (0 : ℝ) τ, ψ (ball c τ') := by
      intro c τ
      apply le_antisymm
      · rcases le_or_gt τ 0 with hτ | hτ
        · rw [ball_eq_empty.2 hτ, measure_empty]
          exact zero_le
        · rw [hψ]
          refine iSup₂_le fun r hr => ?_
          let τn : ℕ → ℝ := fun n => τ - τ / ((n : ℝ) + 2)
          have hτn_mono : Monotone τn := by
            intro n n' hnn'
            simp only [τn]
            have : τ / ((n' : ℝ) + 2) ≤ τ / ((n : ℝ) + 2) := by
              apply div_le_div_of_nonneg_left hτ.le (by positivity)
              have : (n : ℝ) ≤ n' := by exact_mod_cast hnn'
              linarith
            linarith
          have hτn_mem : ∀ n, τn n ∈ Ioo 0 τ := by
            intro n
            have h1 : τ / ((n : ℝ) + 2) < τ := by
              rw [div_lt_iff₀ (by positivity)]
              have : (0 : ℝ) ≤ n := Nat.cast_nonneg n
              nlinarith
            have h2 : 0 < τ / ((n : ℝ) + 2) := by positivity
            exact ⟨by simp only [τn]; linarith, by simp only [τn]; linarith⟩
          have hballU : ball c τ = ⋃ n, ball c (τn n) := by
            ext c'
            simp only [mem_ball, mem_iUnion]
            constructor
            · intro hd
              obtain ⟨n, hn⟩ := exists_nat_gt (τ / (τ - dist c' c))
              refine ⟨n, ?_⟩
              simp only [τn]
              have hpos : 0 < τ - dist c' c := by linarith
              have : τ / ((n : ℝ) + 2) < τ - dist c' c := by
                rw [div_lt_iff₀ (by positivity)]
                rw [div_lt_iff₀ hpos] at hn
                nlinarith
              linarith
            · rintro ⟨n, hn⟩
              exact hn.trans (hτn_mem n).2
          have hmono_sets : Monotone (fun n => ball a r ∩ KC (ball c (τn n))) := by
            intro n n' hnn'
            exact inter_subset_inter_right _ (hKCmono _ _ (ball_subset_ball (hτn_mono hnn')))
          have hmeas : μ (ball a r ∩ KC (ball c τ)) = ⨆ n, μ (ball a r ∩ KC (ball c (τn n))) := by
            rw [hballU, hKCunion, inter_iUnion]
            exact hmono_sets.measure_iUnion
          rw [hmeas, ENNReal.iSup_div]
          refine iSup_le fun n => ?_
          refine le_trans ?_ (le_iSup₂ (f := fun τ' (_ : τ' ∈ Ioo (0 : ℝ) τ) => ψ (ball c τ'))
            (τn n) (hτn_mem n))
          rw [hψ]
          exact le_iSup₂ (f := fun r (_ : r ∈ Ioo (0 : ℝ) δ) =>
            μ (ball a r ∩ KC (ball c (τn n))) / ENNReal.ofReal (r ^ (m + 1))) r hr
      · exact iSup₂_le fun τ' hτ' => ψ.mono (ball_subset_ball hτ'.2.le)
    -- steps 4–6: `D_w` is Borel and `ψ_w`-null, so Mickle–Radó applies
    let D : Set (Eucl (m + 1)) := {c | ¬ T3 (w + sh c)}
    have hDm : MeasurableSet D :=
      (measurable_const.prodMk (continuous_const.add hsh).measurable) hW.compl
    have hψD : ψ D = 0 := by
      rw [hψ]
      refine le_antisymm (iSup₂_le fun r hr => ?_) zero_le
      have : μ (ball a r ∩ KC D) = 0 := by
        refine measure_mono_null (fun x hx => ?_) hEc
        obtain ⟨hxr, hxa, c, hcD, hx0⟩ := hx
        intro hxE
        apply hcD
        refine ⟨x, hxE, hxa, (mem_ball.1 hxr).trans hr.2, ?_⟩
        have h0 : Lu (w + sh c) (x - a) = 0 := hx0
        rw [hLsub] at h0
        exact sub_eq_zero.1 h0
      rw [this, ENNReal.zero_div]
    have hMR := Submission.rectifiability_mickle_rado m ψ D hball hDm hψD
    -- step 7: `K_w(B(c,t)) = K_{w ⊕ c}(B(0,t))`, so the slice density at `c` is `ϑ_j(w ⊕ c)`
    have hKCtr : ∀ (c : Eucl (m + 1)) (t : ℝ), KC (ball c t) = Ks (w + sh c) t := by
      intro c t
      ext x
      simp only [KC, Ks, mem_ofPred_eq]
      constructor
      · rintro ⟨hxa, c', hc', h0⟩
        refine ⟨hxa, c' - c, ?_, ?_⟩
        · rw [mem_ball_zero_iff, ← mem_ball_iff_norm]
          exact hc'
        · have hv : ∀ i, (w + sh c) i + (c' - c) i • EuclideanSpace.single j (1 : ℝ) =
              w i + c' i • EuclideanSpace.single j (1 : ℝ) := by
            intro i
            simp only [sh, Pi.add_apply, PiLp.sub_apply, sub_smul]
            abel
          simp only [hv]
          exact h0
      · rintro ⟨hxa, c'', hc'', h0⟩
        refine ⟨hxa, c + c'', ?_, ?_⟩
        · rw [mem_ball_iff_norm, add_sub_cancel_left, ← mem_ball_zero_iff]
          exact hc''
        · have hv : ∀ i, w i + (c + c'') i • EuclideanSpace.single j (1 : ℝ) =
              (w + sh c) i + c'' i • EuclideanSpace.single j (1 : ℝ) := by
            intro i
            simp only [sh, Pi.add_apply, PiLp.add_apply, add_smul]
            abel
          simp only [hv]
          exact h0
    have hid : ∀ c : Eucl (m + 1),
        limsup (fun t : ℝ => ψ (ball c t) / ENNReal.ofReal (t ^ (m + 1))) (𝓝[>] 0) =
          θ (w + sh c) := by
      intro c
      apply limsup_congr
      filter_upwards [self_mem_nhdsWithin] with t ht
      have ht' : (0 : ℝ) < t := ht
      rw [hψ, ENNReal.iSup_div]
      refine iSup_congr fun r => ?_
      rw [ENNReal.iSup_div]
      refine iSup_congr fun hr => ?_
      rw [hKCtr c t]
      have hr0 : 0 < r := hr.1
      have hA0 : ENNReal.ofReal (r ^ (m + 1)) ≠ 0 := (ENNReal.ofReal_pos.2 (by positivity)).ne'
      rw [div_eq_mul_inv, div_eq_mul_inv, div_eq_mul_inv, mul_assoc,
        ← ENNReal.mul_inv (Or.inl hA0) (Or.inl ENNReal.ofReal_ne_top),
        ← ENNReal.ofReal_mul (by positivity), ← mul_pow]
    refine le_antisymm (le_trans (measure_mono ?_) hMR.le) zero_le
    intro c hc
    refine ⟨hc.1, ?_, ?_⟩
    · rw [hid c]; exact hc.2.1
    · rw [hid c]; exact hc.2.2
  -- step 9: Tonelli for `(w, c) ↦ w ⊕ c` in both orders
  have hP : MeasurableSet ((fun p : (Fin (m + 1) → Eucl N) × Eucl (m + 1) => p.1 + sh p.2) ⁻¹' B) :=
    (continuous_fst.add (hsh.comp continuous_snd)).measurable hBm
  have h1 : ((volume : Measure (Fin (m + 1) → Eucl N)).prod (volume : Measure (Eucl (m + 1))))
      ((fun p : (Fin (m + 1) → Eucl N) × Eucl (m + 1) => p.1 + sh p.2) ⁻¹' B) = 0 := by
    rw [Measure.prod_apply hP]
    have : ∀ w : Fin (m + 1) → Eucl N, (volume : Measure (Eucl (m + 1)))
        (Prod.mk w ⁻¹'
          ((fun p : (Fin (m + 1) → Eucl N) × Eucl (m + 1) => p.1 + sh p.2) ⁻¹' B)) = 0 :=
      fun w => hslice w
    simp [this]
  have h2 : ((volume : Measure (Fin (m + 1) → Eucl N)).prod (volume : Measure (Eucl (m + 1))))
      ((fun p : (Fin (m + 1) → Eucl N) × Eucl (m + 1) => p.1 + sh p.2) ⁻¹' B) =
        (volume : Measure (Fin (m + 1) → Eucl N)) B * ⊤ := by
    rw [Measure.prod_apply_symm hP]
    have : ∀ c : Eucl (m + 1), (volume : Measure (Fin (m + 1) → Eucl N))
        ((fun w => (w, c)) ⁻¹'
          ((fun p : (Fin (m + 1) → Eucl N) × Eucl (m + 1) => p.1 + sh p.2) ⁻¹' B)) =
            (volume : Measure (Fin (m + 1) → Eucl N)) B :=
      fun c => measure_preimage_add_right (volume : Measure (Fin (m + 1) → Eucl N)) (sh c) B
    simp only [this]
    rw [lintegral_const, measure_univ_of_isAddLeftInvariant]
  rw [h1] at h2
  rcases mul_eq_zero.1 h2.symm with h | h
  · exact h
  · exact absurd h ENNReal.top_ne_zero

/-- **Besicovitch–Federer trichotomy for almost every linear map** (Mattila, *Geometry of Sets and
Measures in Euclidean Spaces*, Lemma 18.9; Hovila–Järvenpää–Järvenpää–Ledrappier, Geom. Dedicata
161 (2012), Lemma 2.4).  Let `k = m + 1`, `μ = Hᵏ⌞E`, `L_v x = (⟨v_i, x⟩)_i`,
`X_v(a,r,s) = {x : |x − a| < r, |L_v(x − a)| < s|x − a|}` and
`Φ(a,v) = limsup_{s↓0} sup_{0<r<δ} μ(X_v(a,r,s))/(rs)ᵏ`.  Fix `a`.  By Mickle–Radó on the slices
`v ⊕_j c`, for a.e. `v` without a fibre witness (T3) every fibre density `ϑ_j(v)` lies in `{0, ∞}`,
and `ϑ_j ≤ Φ ≤ N^{k/2} Σ_j ϑ_j` puts `Φ(a,v)` in `{0, ∞}`.  The set of such `(a,v)` is Borel, so
Fubini gives the same for a.e. `v` and `μ`-a.e. `a`; `Φ = 0` is (T1) and `Φ = ∞` gives the
infinite projected density (T2). -/
theorem Submission.rectifiability_bf_trichotomy : ∀ (N m : ℕ) (E : Set (Eucl N)) (δ : ℝ), IsSigmaCompact E → (μHE[m + 1] : Measure (Eucl N)) E < ∞ → 0 < δ → ∀ᵐ v ∂(volume : Measure (Fin (m + 1) → Eucl N)), ∀ᵐ a ∂((μHE[m + 1] : Measure (Eucl N)).restrict E), (∀ η : ℝ, 0 < η → ∃ s ∈ Ioo (0 : ℝ) 1, ∀ r ∈ Ioo (0 : ℝ) δ, (μHE[m + 1] : Measure (Eucl N)) (E ∩ {x | dist x a < r ∧ ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) (x - a)) : Eucl (m + 1))‖ < s * ‖x - a‖}) ≤ ENNReal.ofReal (η * (r * s) ^ (m + 1))) ∨ dimensionalUpperDensity (Measure.map (fun x : Eucl N => (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) x) : Eucl (m + 1))) ((μHE[m + 1] : Measure (Eucl N)).restrict E)).toOuterMeasure ((m + 1 : ℕ) : ℝ) univ (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) a) : Eucl (m + 1)) = ⊤ ∨ ∃ x ∈ E, x ≠ a ∧ dist x a < δ ∧ (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) x) : Eucl (m + 1)) = (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) a) : Eucl (m + 1)) := by
  intro N m E δ hE hEfin _
  -- step 1: `E` is Borel and `μ = Hᵏ⌞E` is a finite measure carried by `E`
  have hEmeas : MeasurableSet E := by
    obtain ⟨K, hK, hKE⟩ := hE
    rw [← hKE]
    exact MeasurableSet.iUnion fun n => (hK n).measurableSet
  have : IsFiniteMeasure ((μHE[m + 1] : Measure (Eucl N)).restrict E) :=
    isFiniteMeasure_restrict.2 hEfin.ne
  have hμE : ((μHE[m + 1] : Measure (Eucl N)).restrict E) Eᶜ = 0 := by
    rw [Measure.restrict_apply' hEmeas, compl_inter_self, measure_empty]
  have hμS : ∀ S : Set (Eucl N),
      (μHE[m + 1] : Measure (Eucl N)) (E ∩ S) = ((μHE[m + 1] : Measure (Eucl N)).restrict E) S := by
    intro S
    rw [Measure.restrict_apply' hEmeas, inter_comm]
  set μ : Measure (Eucl N) := (μHE[m + 1] : Measure (Eucl N)).restrict E
  -- step 2: the cone ratio `Φ(a,v)` and the fibre-witness set `W` of (T3) are Borel in `(a,v)`
  set Φ : Eucl N × (Fin (m + 1) → Eucl N) → ℝ≥0∞ := fun p => limsup (fun s : ℝ => ⨆ r ∈ Ioo (0 : ℝ) δ, μ {x | dist x p.1 < r ∧ ‖(WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (p.2 i) (x - p.1)) : Eucl (m + 1))‖ < s * ‖x - p.1‖} / ENNReal.ofReal ((r * s) ^ (m + 1))) (𝓝[>] 0)
  set W : Set (Eucl N × (Fin (m + 1) → Eucl N)) := {p | ∃ x ∈ E, x ≠ p.1 ∧ dist x p.1 < δ ∧ (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (p.2 i) x) : Eucl (m + 1)) = (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (p.2 i) p.1) : Eucl (m + 1))}
  have hΦ : Measurable Φ := Submission.rectifiability_bf_cone_ratio_measurable N m μ δ inferInstance
  have hW : MeasurableSet W := Submission.rectifiability_bf_witness_set_measurable N m E δ hE
  have hG : MeasurableSet
      {p : Eucl N × (Fin (m + 1) → Eucl N) | (Φ (p.1, p.2) = 0 ∨ Φ (p.1, p.2) = ⊤) ∨ (p.1, p.2) ∈ W} :=
    ((hΦ (measurableSet_singleton 0)).union (hΦ (measurableSet_singleton ⊤))).union hW
  -- step 3: for every `a`, `Φ(a,v) ∈ {0, ∞}` or (T3) holds for a.e. `v`
  have hslice : ∀ a : Eucl N, ∀ᵐ v ∂(volume : Measure (Fin (m + 1) → Eucl N)),
      (Φ (a, v) = 0 ∨ Φ (a, v) = ⊤) ∨ (a, v) ∈ W := by
    intro a
    set ϑ : Fin N → (Fin (m + 1) → Eucl N) → ℝ≥0∞ := fun j u => limsup (fun t : ℝ => ⨆ r ∈ Ioo (0 : ℝ) δ, μ (ball a r ∩ {x | x ≠ a ∧ ∃ c ∈ ball (0 : Eucl (m + 1)) t, (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (u i + c i • EuclideanSpace.single j (1 : ℝ)) (x - a)) : Eucl (m + 1)) = 0}) / ENNReal.ofReal ((r * t) ^ (m + 1))) (𝓝[>] 0)
    -- Mickle–Radó on the slices: `0 < ϑ_j(v) < ∞` without (T3) only for a null set of `v`
    have hnull : ∀ j : Fin N, ∀ᵐ u ∂(volume : Measure (Fin (m + 1) → Eucl N)),
        ¬ ((a, u) ∉ W ∧ 0 < ϑ j u ∧ ϑ j u < ⊤) := by
      intro j
      filter_upwards [measure_eq_zero_iff_ae_notMem.1
        (Submission.rectifiability_bf_slice_density_null N m μ E δ a j inferInstance hE hμE)]
        with u hu
      exact hu
    filter_upwards [ae_all_iff.2 hnull] with u hu
    by_cases hT3 : (a, u) ∈ W
    · exact Or.inr hT3
    refine Or.inl ?_
    -- cones versus unions of fibres: `ϑ_j ≤ Φ ≤ N^{k/2} Σ_j ϑ_j`
    obtain ⟨hle, hge⟩ := Submission.rectifiability_bf_fibre_cone_comparison N m μ δ a u
    have hle' : ∀ j, ϑ j u ≤ Φ (a, u) := hle
    have hge' : Φ (a, u) ≤ ENNReal.ofReal (Real.sqrt (N : ℝ) ^ (m + 1)) * ∑ j : Fin N, ϑ j u :=
      hge
    have h0top : ∀ j, ϑ j u = 0 ∨ ϑ j u = ⊤ := by
      intro j
      by_contra hcon
      exact hu j ⟨hT3, pos_iff_ne_zero.2 (not_or.1 hcon).1, lt_top_iff_ne_top.2 (not_or.1 hcon).2⟩
    by_cases htop : ∃ j, ϑ j u = ⊤
    · obtain ⟨j, hj⟩ := htop
      have h := hle' j
      rw [hj, top_le_iff] at h
      exact Or.inr h
    · refine Or.inl (nonpos_iff_eq_zero.1 (hge'.trans_eq ?_))
      rw [Finset.sum_eq_zero fun j _ => (h0top j).resolve_right (not_exists.1 htop j), mul_zero]
  -- step 4: Fubini turns `∀ a, ∀ᵐ v` into `∀ᵐ v, ∀ᵐ a ∂μ`
  have hswap : ∀ᵐ v ∂(volume : Measure (Fin (m + 1) → Eucl N)), ∀ᵐ a ∂μ,
      (Φ (a, v) = 0 ∨ Φ (a, v) = ⊤) ∨ (a, v) ∈ W :=
    (Measure.ae_ae_comm (μ := μ) (ν := (volume : Measure (Fin (m + 1) → Eucl N)))
      (p := fun a v => (Φ (a, v) = 0 ∨ Φ (a, v) = ⊤) ∨ (a, v) ∈ W) hG).1
      (Eventually.of_forall hslice)
  -- step 5: `Φ = 0` gives (T1) and `Φ = ∞` gives (T2)
  filter_upwards [hswap] with v hv
  filter_upwards [hv] with a ha
  rcases ha with (h0 | htop) | hT3
  · refine Or.inl fun η hη => ?_
    obtain ⟨s, hs, hsr⟩ :=
      (Submission.rectifiability_bf_cone_ratio_reduction N m μ δ a v).1 h0 η hη
    exact ⟨s, hs, fun r hr => (hμS _).trans_le (hsr r hr)⟩
  · exact Or.inr (Or.inl ((Submission.rectifiability_bf_cone_ratio_reduction N m μ δ a v).2 htop))
  · exact Or.inr (Or.inr hT3)

/-- Simon Ch. 6, proof of 8.1, (1) and (6): a set `S` of positive upper density `Θ*ⁿ(ν, ·)`,
covered by open sets `W q` of finite `ν`-measure, is covered by countably many sets of finite
`Hⁿ`-measure, and it is `Hⁿ`-null when it is `ν`-null.  The pieces
`{x ∈ S ∩ W q : (j + 1)⁻¹ ≤ Θ*ⁿ(ν, x)}` are controlled by the density comparison with
`V = W q`, and, when `ν(S) = 0`, with `V = O ∩ W q` for an open `O ⊇ S` given by outer
regularity of the finite measure `ν ⌞ W q`. -/
theorem Submission.rectifiability_positive_density_cover_null : ∀ (P n : ℕ) (ν : Measure (Eucl P)) (W : ℕ → Set (Eucl P)) (S : Set (Eucl P)), (∀ q, IsOpen (W q)) → (∀ q, ν (W q) < ∞) → S ⊆ ⋃ q, W q → (∀ x ∈ S, 0 < dimensionalUpperDensity ν.toOuterMeasure (n : ℝ) univ x) → (∃ C : ℕ → Set (Eucl P), S ⊆ ⋃ i, C i ∧ ∀ i, (μHE[n] : Measure (Eucl P)) (C i) < ∞) ∧ (ν S = 0 → (μHE[n] : Measure (Eucl P)) S = 0) := by
  intro P n ν W S hWo hWfin hSW hpos
  -- The pieces `A j q = {x ∈ S ∩ W q : (j + 1)⁻¹ ≤ Θ*ⁿ(ν, x)}` cover `S`.
  obtain ⟨A, hAS, hAW, hAD, hcover⟩ : ∃ A : ℕ → ℕ → Set (Eucl P), (∀ j q, A j q ⊆ S) ∧
      (∀ j q, A j q ⊆ W q) ∧ (∀ j q, ∀ x ∈ A j q,
        ((j : ℝ≥0∞) + 1)⁻¹ ≤ dimensionalUpperDensity ν.toOuterMeasure (n : ℝ) univ x) ∧
      S ⊆ ⋃ j, ⋃ q, A j q := by
    refine ⟨fun j q => {x | x ∈ S ∧ x ∈ W q ∧
      ((j : ℝ≥0∞) + 1)⁻¹ ≤ dimensionalUpperDensity ν.toOuterMeasure (n : ℝ) univ x},
      fun j q x hx => hx.1, fun j q x hx => hx.2.1, fun j q x hx => hx.2.2, ?_⟩
    intro x hx
    obtain ⟨q, hq⟩ := mem_iUnion.1 (hSW hx)
    obtain ⟨k, hk⟩ := ENNReal.exists_inv_nat_lt (hpos x hx).ne'
    refine mem_iUnion.2 ⟨k, mem_iUnion.2 ⟨q, hx, hq, ?_⟩⟩
    calc ((k : ℝ≥0∞) + 1)⁻¹ ≤ (k : ℝ≥0∞)⁻¹ := ENNReal.inv_le_inv.2 le_self_add
      _ ≤ _ := hk.le
  have ht0 : ∀ j : ℕ, ((j : ℝ≥0∞) + 1)⁻¹ ≠ 0 := fun j =>
    ENNReal.inv_ne_zero.2 (ENNReal.add_ne_top.2 ⟨ENNReal.natCast_ne_top j, ENNReal.one_ne_top⟩)
  refine ⟨⟨fun i => A (Nat.unpair i).1 (Nat.unpair i).2, ?_, ?_⟩, ?_⟩
  · -- Reindex the pieces by `Nat.pair`.
    intro x hx
    obtain ⟨j, q, hjq⟩ : ∃ j q, x ∈ A j q := by simpa only [mem_iUnion] using hcover hx
    refine mem_iUnion.2 ⟨Nat.pair j q, ?_⟩
    simpa only [Nat.unpair_pair] using hjq
  · -- Density comparison with `V = W q`: `(j + 1)⁻¹ Hⁿ(A j q) ≤ ν(W q) < ∞`.
    intro i
    have h := Submission.rectifiability_density_comparison P n ν
      (A (Nat.unpair i).1 (Nat.unpair i).2) (W (Nat.unpair i).2) _ (hWo _) (hAW _ _) (hAD _ _)
    rcases ENNReal.mul_lt_top_iff.1 (h.trans_lt (hWfin _)) with h1 | h1 | h1
    · exact h1.2
    · exact absurd h1 (ht0 _)
    · simp [h1]
  · -- If `ν(S) = 0`, every piece is `Hⁿ`-null.
    intro hS0
    have hpiece : ∀ j q, (μHE[n] : Measure (Eucl P)) (A j q) = 0 := by
      intro j q
      by_contra hne
      have hc : 0 < ((j : ℝ≥0∞) + 1)⁻¹ * (μHE[n] : Measure (Eucl P)) (A j q) :=
        ENNReal.mul_pos (ht0 j) hne
      -- Outer regularity of the finite measure `ν ⌞ W q` gives an open `O ⊇ S` with
      -- `ν(O ∩ W q) < (j + 1)⁻¹ Hⁿ(A j q)`.
      have : IsFiniteMeasure (ν.restrict (W q)) := isFiniteMeasure_restrict.2 (hWfin q).ne
      obtain ⟨O, hSO, hOo, hOlt⟩ := Set.exists_isOpen_lt_of_lt (μ := ν.restrict (W q)) S _
        (((Measure.restrict_apply_le _ _).trans hS0.le).trans_lt hc)
      rw [Measure.restrict_apply hOo.measurableSet] at hOlt
      exact (Submission.rectifiability_density_comparison P n ν (A j q) (O ∩ W q) _
        (hOo.inter (hWo q)) (fun x hx => ⟨hSO (hAS j q hx), hAW j q hx⟩) (hAD j q)).not_gt hOlt
    exact measure_mono_null hcover
      (measure_iUnion_null fun j => measure_iUnion_null fun q => hpiece j q)
/-- Simon Ch. 6, proof of 8.1, (8) (p. 174): σ-finite Radon–Nikodym with a positive real density.
If `ν⌞B` and `μ` are σ-finite, `μ(X ∖ B) = 0` and `μ ≪ ν`, then `μ = (ν⌞M).withDensity θ` with
`M = B ∩ {0 < dμ/d(ν⌞B) < ∞}` and `θ = (dμ/d(ν⌞B)).toReal`; `θ` is `ν`-integrable on `M ∩ K`
whenever `μ K < ∞`, since `∫_{M ∩ K} θ dν = μ K`. -/
theorem Submission.rectifiability_rn_positive_real_density : ∀ (X : Type) [MeasurableSpace X] (ν μ : Measure X) (B : Set X), MeasurableSet B → SigmaFinite (ν.restrict B) → SigmaFinite μ → μ Bᶜ = 0 → μ ≪ ν → ∃ (M : Set X) (θ : X → ℝ), M ⊆ B ∧ MeasurableSet M ∧ Measurable θ ∧ (∀ x ∈ M, 0 < θ x) ∧ (∀ K : Set X, MeasurableSet K → μ K < ∞ → IntegrableOn θ (M ∩ K) ν) ∧ μ = (ν.restrict M).withDensity (fun x => ENNReal.ofReal (θ x)) := by
  intro X _ ν μ B hB _ _ hμB hμν
  -- Step 1: `μ ≪ ν⌞B`, since `μ ≪ ν` and `μ(X ∖ B) = 0`.
  have hac : μ ≪ ν.restrict B := by
    refine Measure.AbsolutelyContinuous.mk fun s hs hs0 => ?_
    rw [Measure.restrict_apply hs] at hs0
    exact measure_mono_null (inter_union_sdiff s B).symm.subset
      (measure_union_null (hμν hs0) (measure_mono_null (fun x hx => hx.2) hμB))
  -- Step 2: Radon–Nikodym for the σ-finite pair `(μ, ν⌞B)`: `μ = (ν⌞B).withDensity h` with
  -- `h = dμ/d(ν⌞B)` measurable and `(ν⌞B)`-a.e. finite.
  obtain ⟨h, hh, hrep, hfin⟩ : ∃ h : X → ℝ≥0∞, Measurable h ∧
      μ = (ν.restrict B).withDensity h ∧ ∀ᵐ x ∂(ν.restrict B), h x < ∞ := by
    refine ⟨μ.rnDeriv (ν.restrict B), Measure.measurable_rnDeriv _ _, ?_,
      Measure.rnDeriv_lt_top _ _⟩
    conv_lhs => rw [Measure.haveLebesgueDecomposition_add μ (ν.restrict B)]
    rw [Measure.singularPart_eq_zero_of_ac hac, zero_add]
  -- Step 3: `θ = h.toReal` and `M = B ∩ {0 < θ} = B ∩ {0 < h < ∞}`.
  have hθ : Measurable fun x => (h x).toReal := hh.ennreal_toReal
  have hM : MeasurableSet (B ∩ {x | 0 < (h x).toReal}) :=
    hB.inter (measurableSet_lt measurable_const hθ)
  -- Steps 4–5: `h = 1_M · ofReal θ` `(ν⌞B)`-a.e., hence `μ = (ν⌞M).withDensity (ofReal ∘ θ)`.
  have hrepM : μ = (ν.restrict (B ∩ {x | 0 < (h x).toReal})).withDensity
      (fun x => ENNReal.ofReal (h x).toReal) := by
    have hae : h =ᵐ[ν.restrict B] (B ∩ {x | 0 < (h x).toReal}).indicator
        (fun x => ENNReal.ofReal (h x).toReal) := by
      filter_upwards [hfin, ae_restrict_mem hB] with x hxfin hxB
      by_cases hx : 0 < (h x).toReal
      · rw [indicator_of_mem (show x ∈ B ∩ {x | 0 < (h x).toReal} from ⟨hxB, hx⟩),
          ENNReal.ofReal_toReal hxfin.ne]
      · rw [indicator_of_notMem fun hxM => hx hxM.2]
        exact ((ENNReal.toReal_eq_zero_iff _).mp
          (le_antisymm (not_lt.mp hx) ENNReal.toReal_nonneg)).resolve_right hxfin.ne
    rw [hrep, withDensity_congr_ae hae, withDensity_indicator hM, Measure.restrict_restrict hM,
      inter_eq_left.mpr inter_subset_left]
  -- Step 6: for measurable `K` with `μ K < ∞`, `∫_{M ∩ K} |θ| dν = μ K < ∞`.
  refine ⟨B ∩ {x | 0 < (h x).toReal}, fun x => (h x).toReal, inter_subset_left, hM, hθ,
    fun x hx => hx.2, fun K hK hμK => ⟨hθ.aestronglyMeasurable, ?_⟩, hrepM⟩
  rw [hasFiniteIntegral_iff_ofReal (Eventually.of_forall fun x => ENNReal.toReal_nonneg)]
  rw [hrepM, withDensity_apply _ hK, Measure.restrict_restrict hK, inter_comm K] at hμK
  exact hμK
open scoped CompactlySupported in
/-- **Besicovitch–Federer projection theorem, finite-measure case** (Mattila, *Geometry of Sets
and Measures in Euclidean Spaces*, Theorem 18.1; Hovila–Järvenpää–Järvenpää–Ledrappier,
arXiv:1104.3453, Theorem 1.2).  Let `k = m + 1` and `L_v x = (⟨v₁, x⟩, …, ⟨v_k, x⟩) ∈ ℝᵏ`.  If
`E ⊆ ℝ^N` is Borel and purely `k`-unrectifiable with `Hᵏ(E) < ∞`, then `Lᵏ(L_v(E)) = 0` for
Lebesgue-a.e. `v ∈ (ℝ^N)ᵏ`.  After passing to a σ-compact core of `E`, the trichotomy splits `E`,
up to an `Hᵏ`-null set, into the cone-density sets (`Hᵏ`-null), the points over which
`(L_v)_# (Hᵏ ⌞ E)` has infinite density (Lebesgue-null image by density comparison) and the
points with infinite `L_v`-fibres (Lebesgue-null image by Eilenberg finiteness). -/
theorem Submission.rectifiability_bf_projection_null_ae : ∀ (N m : ℕ) (E : Set (Eucl N)), MeasurableSet E → (μHE[m + 1] : Measure (Eucl N)) E < ∞ → Poincare.SimonGMT.Chapter03.PurelyUnrectifiable (m + 1) E → ∀ᵐ v ∂(volume : Measure (Fin (m + 1) → Eucl N)), (volume : Measure (Eucl (m + 1))) ((fun x : Eucl N => (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) x) : Eucl (m + 1))) '' E) = 0 := by
  intro N m E hE hEfin hPU
  -- Step 1: a σ-compact Borel core `E' ⊆ E` with `Hᵏ(E \ E') = 0` (`k = m + 1`).
  have : IsFiniteMeasure ((μHE[m + 1] : Measure (Eucl N)).restrict E) :=
    isFiniteMeasure_restrict.2 hEfin.ne
  obtain ⟨C, hCc, hCE, hCnull⟩ := Submission.lpf_lli_inner_compact_approx N
    (μHE[m + 1] : Measure (Eucl N)) E hE.nullMeasurableSet inferInstance
  set E' := ⋃ k, C k
  have hE'E : E' ⊆ E := iUnion_subset hCE
  have hE'm : MeasurableSet E' := MeasurableSet.iUnion fun k => (hCc k).measurableSet
  have hE'fin : (μHE[m + 1] : Measure (Eucl N)) E' < ∞ := (measure_mono hE'E).trans_lt hEfin
  -- Step 2: the trichotomy at every scale `δ_l = 1/(l+1)`, for a.e. `v` simultaneously.
  have htri := fun l : ℕ => Submission.rectifiability_bf_trichotomy N m E' (1 / ((l : ℝ) + 1))
    (isSigmaCompact_iUnion_of_isCompact C hCc) hE'fin (by positivity)
  filter_upwards [ae_all_iff.2 htri] with v hv
  -- Fix `v` and write `L x = (⟨v₁, x⟩, …, ⟨v_k, x⟩)`; `L` is linear, hence Lipschitz.
  set L : Eucl N → Eucl (m + 1) :=
    fun x => WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) x) with hL
  obtain ⟨K, hK⟩ : ∃ K : ℝ≥0, LipschitzWith K L := by
    let ℓ : Eucl N →ₗ[ℝ] Eucl (m + 1) :=
      { toFun := L
        map_add' := fun x y => by ext i; simp [hL, inner_add_right]
        map_smul' := fun c x => by ext i; simp [hL, inner_smul_right] }
    exact ⟨_, (LinearMap.toContinuousLinearMap ℓ).lipschitzWith⟩
  -- `L` maps `Hᵏ`-null sets to Lebesgue-null sets, as `μHE[k] = volume` on `ℝᵏ`.
  have himage : ∀ S : Set (Eucl N), (μHE[m + 1] : Measure (Eucl N)) S = 0 →
      (volume : Measure (Eucl (m + 1))) (L '' S) = 0 := by
    intro S hS
    have h := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn
      (m + 1) (hK.lipschitzOnWith (s := S))
    rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume, hS, mul_zero] at h
    exact nonpos_iff_eq_zero.1 h
  -- The image of `E \ E'` is null, so it suffices to treat `E'`.
  rw [← union_sdiff_cancel hE'E, image_union]
  refine measure_union_null ?_ (himage _ hCnull)
  -- A full-measure set `G` of points of `E'` at which the trichotomy holds at every scale.
  obtain ⟨G, hG, hGP⟩ :=
    eventually_iff_exists_mem.1 ((ae_restrict_iff' hE'm).1 (ae_all_iff.2 hv))
  -- (T1) The cone-density sets `E₁ l` are `Hᵏ`-null (`bf_cone_density` with `δ = 1/(l+1)`).
  set E₁ : ℕ → Set (Eucl N) := fun l => {a | a ∈ E' ∧ ∀ η : ℝ, 0 < η → ∃ s ∈ Ioo (0 : ℝ) 1,
    ∀ r ∈ Ioo (0 : ℝ) (1 / ((l : ℝ) + 1)), (μHE[m + 1] : Measure (Eucl N))
      (E' ∩ {x | dist x a < r ∧ ‖L (x - a)‖ < s * ‖x - a‖}) ≤
        ENNReal.ofReal (η * (r * s) ^ (m + 1))}
  have hE₁null : ∀ l, (μHE[m + 1] : Measure (Eucl N)) (E₁ l) = 0 := fun l =>
    Submission.rectifiability_bf_cone_density N m E' v (1 / ((l : ℝ) + 1)) (hPU.mono hE'E)
      (by positivity)
  -- (T2) The set `Y₂` where `ν = L_# (Hᵏ ⌞ E')` has infinite upper density is null: density
  -- comparison with `t = ∞` and `V = ℝᵏ` gives `∞ · Lᵏ(Y₂) ≤ ν(ℝᵏ) = Hᵏ(E') < ∞`.
  set Y₂ : Set (Eucl (m + 1)) := {y | dimensionalUpperDensity
    (Measure.map L ((μHE[m + 1] : Measure (Eucl N)).restrict E')).toOuterMeasure
      ((m + 1 : ℕ) : ℝ) univ y = ⊤}
  have hY₂null : (volume : Measure (Eucl (m + 1))) Y₂ = 0 := by
    have h := Submission.rectifiability_density_comparison (m + 1) (m + 1)
      (Measure.map L ((μHE[m + 1] : Measure (Eucl N)).restrict E')) Y₂ univ ⊤ isOpen_univ
      (subset_univ _) fun y hy => ge_of_eq hy
    rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume,
      Measure.map_apply hK.continuous.measurable MeasurableSet.univ, preimage_univ,
      Measure.restrict_apply_univ] at h
    by_contra hne
    rw [ENNReal.top_mul hne] at h
    exact lt_irrefl _ (h.trans_lt hE'fin)
  -- (T3) The set `Y₃` of points with infinite `L`-fibre in `E'` is null (Eilenberg finiteness),
  -- and a point with fibre partners at every scale `δ_l` has an infinite fibre.
  set Y₃ : Set (Eucl (m + 1)) := {y | (E' ∩ L ⁻¹' {y}).Infinite}
  have hY₃null : (volume : Measure (Eucl (m + 1))) Y₃ = 0 :=
    Submission.rectifiability_bf_infinite_fibre_null N m E' L K hE'm hE'fin hK
  have hinf : ∀ a ∈ E', (∀ l : ℕ, ∃ x ∈ E', x ≠ a ∧ dist x a < 1 / ((l : ℝ) + 1) ∧
      L x = L a) → L a ∈ Y₃ := by
    intro a ha h3 hfin
    have hcl : IsClosed ((E' ∩ L ⁻¹' {L a}) \ {a}) := hfin.sdiff.isClosed
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hcl.isOpen_compl a fun h => h.2 rfl
    obtain ⟨l, hl⟩ := exists_nat_one_div_lt hε
    obtain ⟨x, hxE, hxa, hdist, hLx⟩ := h3 l
    exact hball (mem_ball.2 (hdist.trans hl)) ⟨⟨hxE, hLx⟩, hxa⟩
  -- Step 3: `L(E') ⊆ L(Gᶜ) ∪ ⋃ₗ L(E₁ l) ∪ Y₂ ∪ Y₃`, and every piece is Lebesgue-null.
  refine measure_mono_null (t := ((L '' Gᶜ ∪ ⋃ l, L '' E₁ l) ∪ Y₂) ∪ Y₃) ?_
    (measure_union_null (measure_union_null (measure_union_null (himage _ (mem_ae_iff.1 hG))
      (measure_iUnion_null fun l => himage _ (hE₁null l))) hY₂null) hY₃null)
  rintro _ ⟨a, ha, rfl⟩
  by_cases haG : a ∈ G
  swap
  · exact Or.inl (Or.inl (Or.inl ⟨a, haG, rfl⟩))
  by_cases h2 : L a ∈ Y₂
  · exact Or.inl (Or.inr h2)
  by_cases h3 : L a ∈ Y₃
  · exact Or.inr h3
  -- Otherwise (T3) fails at some scale `δ_l`, where (T1) must then hold.
  obtain ⟨l, hl⟩ : ∃ l, a ∈ E₁ l := by
    by_contra hno
    refine h3 (hinf a ha fun l => ?_)
    rcases hGP a haG ha l with h1 | h2' | h3'
    · exact (hno ⟨l, ha, h1⟩).elim
    · exact (h2 h2').elim
    · exact h3'
  exact Or.inl (Or.inl (Or.inr (mem_iUnion.2 ⟨l, a, hl, rfl⟩)))

/-- **Simon Ch. 3, Structure Theorem 3.6, as used in Ch. 6, 8.1 (p. 174).**  If `A ⊆ ℝ^P` is
purely `n`-unrectifiable and `Hⁿ`-σ-finite (`n = m + 1`), then some rotation `Q` makes every
coordinate projection `p_α(Q(A))`, `α ∈ I(n, P)`, Lebesgue-null.  Up to an `Hⁿ`-null set, `A`
is a countable union of compact purely unrectifiable pieces of finite measure, and their images
under `x ↦ (⟪vᵢ, x⟫)ᵢ` are null for almost every frame `v`
(`rectifiability_bf_projection_null_ae`).  Gram–Schmidt applied to a random frame, together with
Tonelli's theorem, gives an orthonormal frame all of whose coordinate subframes avoid the null
set of bad frames. -/
theorem Submission.rectifiability_structure_projection : ∀ (P m : ℕ) (A : Set (Eucl P)), Poincare.SimonGMT.Chapter03.PurelyUnrectifiable (m + 1) A → (∃ S : ℕ → Set (Eucl P), A ⊆ ⋃ j, S j ∧ ∀ j, (μHE[m + 1] : Measure (Eucl P)) (S j) < ∞) → ∃ Q : Eucl P ≃ₗᵢ[ℝ] Eucl P, ∀ α : SimonMultiIndex (m + 1) P, (volume : Measure (Eucl (m + 1))) ((fun x : Eucl P => (WithLp.toLp 2 (fun i : Fin (m + 1) => Q x (α i)) : Eucl (m + 1))) '' A) = 0 := by
  have bf := Submission.rectifiability_bf_projection_null_ae
  classical
  intro P m A hA hS
  -- Step 1: if `P < m + 1` there is no strictly increasing `α`.
  by_cases hnP : m + 1 ≤ P
  swap
  · refine ⟨LinearIsometryEquiv.refl ℝ _, fun α => absurd ?_ hnP⟩
    simpa using Fintype.card_le_of_injective α α.injective
  -- Steps 4-6 (frame avoidance): for every null Borel set `Z` of `(m + 1)`-frames whose complement
  -- is stable under row recombination, some orthonormal basis has all coordinate subframes outside `Z`.
  have hFA : ∀ Z : Set (Fin (m + 1) → Eucl P), MeasurableSet Z →
      (volume : Measure (Fin (m + 1) → Eucl P)) Z = 0 →
      (∀ (G : Matrix (Fin (m + 1)) (Fin (m + 1)) ℝ) (w : Fin (m + 1) → Eucl P),
        (fun i => ∑ l, G i l • w l) ∈ Z → w ∈ Z) →
      ∃ Q : Eucl P ≃ₗᵢ[ℝ] Eucl P, ∀ α : SimonMultiIndex (m + 1) P,
        (fun i => Q.symm (EuclideanSpace.single (α i) (1 : ℝ))) ∉ Z := by
    intro Z hZm hZ0 hZpre
    -- an orthonormal frame `c` gives the isometry `x ↦ ∑ xₖ cₖ`
    have hUc : ∀ c : Fin P → Eucl P, Orthonormal ℝ c →
        ∃ U : Eucl P ≃ₗᵢ[ℝ] Eucl P, ∀ x : Eucl P, U x = ∑ k, x k • c k := by
      intro c hc
      have hsp : ⊤ ≤ Submodule.span ℝ (Set.range c) :=
        (hc.linearIndependent.span_eq_top_of_card_eq_finrank' (by simp)).ge
      refine ⟨(OrthonormalBasis.mk hc hsp).repr.symm, fun x => ?_⟩
      rw [← (OrthonormalBasis.mk hc hsp).sum_repr_symm]
      simp
    -- the transpose of an orthonormal frame is orthonormal
    have hTON : ∀ b : Fin P → Eucl P, Orthonormal ℝ b →
        Orthonormal ℝ (fun k : Fin P => (WithLp.toLp 2 (fun i : Fin P => b i k) : Eucl P)) := by
      intro b hb
      have hsp : ⊤ ≤ Submodule.span ℝ (Set.range b) :=
        (hb.linearIndependent.span_eq_top_of_card_eq_finrank' (by simp)).ge
      rw [orthonormal_iff_ite]
      intro k l
      have h := (OrthonormalBasis.mk hb hsp).sum_inner_mul_inner
        (EuclideanSpace.single k (1 : ℝ)) (EuclideanSpace.single l (1 : ℝ))
      simp only [OrthonormalBasis.coe_mk, EuclideanSpace.inner_single_left,
        EuclideanSpace.inner_single_right, PiLp.single_apply] at h
      rw [PiLp.inner_apply]
      simp only [RCLike.inner_apply, conj_trivial] at h ⊢
      convert h using 1
      · refine Finset.sum_congr rfl fun i _ => ?_
        simp [mul_comm]
      · by_cases hkl : k = l <;> simp [hkl, eq_comm]
    -- Tonelli: for an isometry-invariant finite measure on independent frames and an equivariant
    -- orthonormalization, the orthonormalized frame and its transpose have the same law
    have hTonGen : ∀ (μ : Measure (Fin P → Eucl P)), IsFiniteMeasure μ → μ univ ≠ 0 →
        (∀ (O : Eucl P ≃ₗᵢ[ℝ] Eucl P) (S' : Set (Fin P → Eucl P)), MeasurableSet S' →
          μ ((fun a i => O (a i)) ⁻¹' S') = μ S') →
        (∀ᵐ a ∂μ, LinearIndependent ℝ a) →
        ∀ (GS : (Fin P → Eucl P) → (Fin P → Eucl P)), Measurable GS →
        (∀ (O : Eucl P ≃ₗᵢ[ℝ] Eucl P) a, GS (fun i => O (a i)) = fun i => O (GS a i)) →
        (∀ a, LinearIndependent ℝ a → Orthonormal ℝ (GS a)) →
        ∀ (S' : Set (Fin P → Eucl P)), MeasurableSet S' →
        μ (GS ⁻¹' S') =
          μ ((fun a k => (WithLp.toLp 2 (fun i : Fin P => GS a i k) : Eucl P)) ⁻¹' S') := by
      intro μ hfin hμ0 hμinv hμind GS hGSm hGSeq hGSon S' hS'
      set T : (Fin P → Eucl P) → (Fin P → Eucl P) :=
        fun b k => (WithLp.toLp 2 (fun i : Fin P => b i k) : Eucl P) with hT
      set st : (Fin P → Eucl P) → (Fin P → Eucl P) → (Fin P → Eucl P) :=
        fun c b i => ∑ k, b i k • c k with hst
      have hco : ∀ k : Fin P, Continuous fun x : Eucl P => x k := fun k =>
        (EuclideanSpace.proj (𝕜 := ℝ) k).continuous
      have hTc : Continuous T := by
        refine continuous_pi fun k => (PiLp.continuous_toLp 2 _).comp (continuous_pi fun i => ?_)
        exact (hco k).comp (continuous_apply i)
      have hstc : Continuous (fun p : (Fin P → Eucl P) × (Fin P → Eucl P) => st p.1 p.2) := by
        refine continuous_pi fun i => continuous_finsetSum _ fun k _ => ?_
        exact ((hco k).comp ((continuous_apply i).comp continuous_snd)).smul
          ((continuous_apply k).comp continuous_fst)
      have hTT : ∀ b, T (T b) = b := by
        intro b; funext k; ext i; simp [hT]
      have hstT : ∀ b c, st c b = T (st (T b) (T c)) := by
        intro b c; funext i; ext j; simp [hT, hst, mul_comm]
      have hUst : ∀ c, Orthonormal ℝ c →
          ∃ U : Eucl P ≃ₗᵢ[ℝ] Eucl P, ∀ b, st c b = fun i => U (b i) := by
        intro c hc
        obtain ⟨U, hU⟩ := hUc c hc
        exact ⟨U, fun b => by funext i; simp [hst, hU]⟩
      have hTm : Measurable T := hTc.measurable
      set M : Set ((Fin P → Eucl P) × (Fin P → Eucl P)) :=
        {p | st (T (GS p.2)) (GS p.1) ∈ S'} with hM
      have hMm : MeasurableSet M :=
        hS'.preimage (hstc.measurable.comp ((hTm.comp (hGSm.comp measurable_snd)).prodMk
          (hGSm.comp measurable_fst)))
      have h1 : (μ.prod μ) M = μ ((fun a => T (GS a)) ⁻¹' S') * μ univ := by
        rw [Measure.prod_apply hMm]
        have hae : ∀ᵐ x ∂μ, μ (Prod.mk x ⁻¹' M) = μ ((fun a => T (GS a)) ⁻¹' S') := by
          filter_upwards [hμind] with x hx
          obtain ⟨U, hU⟩ := hUst (T (GS x)) (hTON _ (hGSon x hx))
          have hset : Prod.mk x ⁻¹' M =
              (fun a i => U (a i)) ⁻¹' ((fun a => T (GS a)) ⁻¹' S') := by
            ext y
            simp only [hM, mem_preimage, mem_ofPred_eq]
            rw [hstT, hTT, hU, ← hGSeq]
          rw [hset, hμinv U ((fun a => T (GS a)) ⁻¹' S') ((hTm.comp hGSm) hS')]
        rw [lintegral_congr_ae hae, lintegral_const, mul_comm]
      have h2 : (μ.prod μ) M = μ (GS ⁻¹' S') * μ univ := by
        rw [Measure.prod_apply_symm hMm]
        have hae : ∀ᵐ y ∂μ, μ ((fun x => (x, y)) ⁻¹' M) = μ (GS ⁻¹' S') := by
          filter_upwards [hμind] with y hy
          obtain ⟨U, hU⟩ := hUst (T (GS y)) (hTON _ (hGSon y hy))
          have hset : (fun x => (x, y)) ⁻¹' M = (fun a i => U (a i)) ⁻¹' (GS ⁻¹' S') := by
            ext x
            simp only [hM, mem_preimage, mem_ofPred_eq]
            rw [hU, ← hGSeq]
          rw [hset, hμinv U (GS ⁻¹' S') (hGSm hS')]
        rw [lintegral_congr_ae hae, lintegral_const, mul_comm]
      exact (ENNReal.mul_left_inj hμ0 (measure_ne_top μ univ)).mp (h2.symm.trans h1)
    -- Gram-Schmidt is equivariant under linear isometries
    have hGSeq : ∀ (O : Eucl P ≃ₗᵢ[ℝ] Eucl P) (a : Fin P → Eucl P),
        InnerProductSpace.gramSchmidtNormed ℝ (fun i => O (a i)) =
          fun i => O (InnerProductSpace.gramSchmidtNormed ℝ a i) := by
      intro O a
      have key : ∀ k, InnerProductSpace.gramSchmidt ℝ (fun i => O (a i)) k =
          O (InnerProductSpace.gramSchmidt ℝ a k) := by
        intro k
        induction k using WellFoundedLT.induction with
        | _ k ih =>
          rw [InnerProductSpace.gramSchmidt_def ℝ (fun i => O (a i)) k,
            InnerProductSpace.gramSchmidt_def ℝ a k]
          simp only [Submodule.starProjection_singleton]
          rw [map_sub, map_sum]
          congr 1
          refine Finset.sum_congr rfl fun i hi => ?_
          rw [ih i (Finset.mem_Iio.mp hi)]
          simp [LinearIsometryEquiv.inner_map_map, map_smul]
      funext k
      simp only [InnerProductSpace.gramSchmidtNormed, key, LinearIsometryEquiv.norm_map, map_smul]
    -- Gram-Schmidt is measurable
    have hGSm : Measurable (fun a : Fin P → Eucl P => InnerProductSpace.gramSchmidtNormed ℝ a) := by
      have key : ∀ k, Measurable (fun a : Fin P → Eucl P =>
          InnerProductSpace.gramSchmidt ℝ a k) := by
        intro k
        induction k using WellFoundedLT.induction with
        | _ k ih =>
          have h : (fun a : Fin P → Eucl P => InnerProductSpace.gramSchmidt ℝ a k) = fun a =>
              a k - ∑ i ∈ Finset.Iio k, (inner ℝ (InnerProductSpace.gramSchmidt ℝ a i) (a k) /
                ‖InnerProductSpace.gramSchmidt ℝ a i‖ ^ 2) • InnerProductSpace.gramSchmidt ℝ a i := by
            funext a
            have := InnerProductSpace.gramSchmidt_def'' ℝ a k
            simp only [RCLike.ofReal_real_eq_id, id] at this
            exact eq_sub_of_add_eq this.symm
          rw [h]
          refine (measurable_pi_apply k).sub (Finset.measurable_sum _ fun i hi => ?_)
          have hi' := ih i (Finset.mem_Iio.mp hi)
          have hin : Measurable fun a : Fin P → Eucl P =>
              inner ℝ (InnerProductSpace.gramSchmidt ℝ a i) (a k) :=
            continuous_inner.measurable.comp (hi'.prodMk (measurable_pi_apply k))
          exact (hin.div (hi'.norm.pow_const 2)).smul hi'
      refine measurable_pi_iff.mpr fun k => ?_
      simp only [InnerProductSpace.gramSchmidtNormed, RCLike.ofReal_real_eq_id, id]
      exact ((key k).norm.inv).smul (key k)
    -- the first `m + 1` Gram-Schmidt vectors recombine the first `m + 1` input vectors
    have hGSspan : ∀ a : Fin P → Eucl P, ∃ G : Matrix (Fin (m + 1)) (Fin (m + 1)) ℝ,
        ∀ i : Fin (m + 1), InnerProductSpace.gramSchmidtNormed ℝ a (Fin.castLE hnP i) =
          ∑ l, G i l • a (Fin.castLE hnP l) := by
      intro a
      have h : ∀ i : Fin (m + 1), ∃ c : Fin (m + 1) → ℝ, ∑ l, c l • a (Fin.castLE hnP l) =
          InnerProductSpace.gramSchmidtNormed ℝ a (Fin.castLE hnP i) := by
        intro i
        rw [← Submodule.mem_span_range_iff_exists_fun]
        have hmem := InnerProductSpace.gramSchmidt_mem_span ℝ a (le_refl (Fin.castLE hnP i))
        have hsub : a '' Set.Iic (Fin.castLE hnP i) ⊆
            Set.range (fun l : Fin (m + 1) => a (Fin.castLE hnP l)) := by
          rintro _ ⟨k, hk, rfl⟩
          have hk' : (k : ℕ) < m + 1 := lt_of_le_of_lt (by simpa [Fin.le_def] using hk) i.isLt
          exact ⟨⟨k, hk'⟩, by simp⟩
        unfold InnerProductSpace.gramSchmidtNormed
        exact Submodule.smul_mem _ _ (Submodule.span_mono hsub hmem)
      choose G hG using h
      exact ⟨G, fun i => (hG i).symm⟩
    -- a coordinate permutation moving the initial segment onto `α`
    have hperm : ∀ α : SimonMultiIndex (m + 1) P, ∃ O : Eucl P ≃ₗᵢ[ℝ] Eucl P,
        ∀ (x : Eucl P) (i : Fin (m + 1)), O x (α i) = x (Fin.castLE hnP i) := by
      intro α
      let e₀ : {x // x ∈ Set.range (Fin.castLE hnP)} ≃ {y // y ∈ Set.range α} :=
        (Equiv.ofInjective _ (Fin.castLE_injective hnP)).symm.trans
          (Equiv.ofInjective α α.injective)
      let σ : Equiv.Perm (Fin P) := e₀.extendSubtype
      have hσ : ∀ i, σ (Fin.castLE hnP i) = α i := by
        intro i
        simp only [σ]
        rw [Equiv.extendSubtype_apply_of_mem e₀ _ ⟨i, rfl⟩]
        simp [e₀]
      refine ⟨LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ σ, fun x i => ?_⟩
      rw [← hσ i]
      simp [LinearIsometryEquiv.piLpCongrLeft_apply]
    -- the random frame: Lebesgue measure restricted to the independent frames in a ball
    set B : Set (Fin P → Eucl P) := ball 0 2 ∩ {a | LinearIndependent ℝ a} with hB
    set μ : Measure (Fin P → Eucl P) := (volume : Measure (Fin P → Eucl P)).restrict B with hμ
    have hBopen : IsOpen B := isOpen_ball.inter (isOpen_setOfPred_linearIndependent (𝕜 := ℝ))
    have hBm : MeasurableSet B := hBopen.measurableSet
    have hfin : IsFiniteMeasure μ :=
      isFiniteMeasure_restrict.mpr ((measure_mono inter_subset_left).trans_lt measure_ball_lt_top).ne
    have hμ0 : μ univ ≠ 0 := by
      rw [Measure.restrict_apply_univ]
      refine (hBopen.measure_pos _ ⟨fun i => EuclideanSpace.single i 1, ?_, ?_⟩).ne'
      · rw [mem_ball_zero_iff, pi_norm_lt_iff (by norm_num)]
        intro i
        simp
      · exact (EuclideanSpace.orthonormal_single (𝕜 := ℝ) (ι := Fin P)).linearIndependent
    have hμinv : ∀ (O : Eucl P ≃ₗᵢ[ℝ] Eucl P) (S' : Set (Fin P → Eucl P)), MeasurableSet S' →
        μ ((fun a i => O (a i)) ⁻¹' S') = μ S' := by
      intro O S' hS'
      have hΨ : MeasurePreserving (fun (a : Fin P → Eucl P) i => O (a i)) volume volume :=
        measurePreserving_pi (fun _ => volume) (fun _ => volume) (fun _ => O.measurePreserving)
      have hBpre : (fun (a : Fin P → Eucl P) i => O (a i)) ⁻¹' B = B := by
        ext a
        simp only [hB, mem_preimage, mem_inter_iff, mem_ball_zero_iff, mem_ofPred_eq,
          pi_norm_lt_iff (show (0 : ℝ) < 2 by norm_num), LinearIsometryEquiv.norm_map]
        have : LinearIndependent ℝ (fun i => O (a i)) ↔ LinearIndependent ℝ a :=
          LinearMap.linearIndependent_iff (v := a) O.toLinearEquiv.toLinearMap
            (LinearEquiv.ker O.toLinearEquiv)
        rw [this]
      have hpre : (fun (a : Fin P → Eucl P) i => O (a i)) ⁻¹' S' ∩ B =
          (fun (a : Fin P → Eucl P) i => O (a i)) ⁻¹' (S' ∩ B) := by
        rw [preimage_inter, hBpre]
      rw [Measure.restrict_apply (hΨ.measurable hS'), Measure.restrict_apply hS', hpre,
        hΨ.measure_preimage (hS'.inter hBm).nullMeasurableSet]
    have hμind : ∀ᵐ a ∂μ, LinearIndependent ℝ a := by
      rw [ae_restrict_iff' hBm]
      exact Filter.Eventually.of_forall fun a ha => ha.2
    -- projections of null sets of `(m + 1)`-frames are null
    have hproj : (volume : Measure (Fin P → Eucl P))
        {a | (fun i : Fin (m + 1) => a (Fin.castLE hnP i)) ∈ Z} = 0 := by
      let p : Fin P → Prop := fun k => (k : ℕ) < m + 1
      have hmp := measurePreserving_piEquivPiSubtypeProd
        (fun _ : Fin P => (volume : Measure (Eucl P))) p
      let f : Fin (m + 1) ≃ {k : Fin P // p k} :=
        { toFun := fun i => ⟨Fin.castLE hnP i, i.isLt⟩
          invFun := fun k => ⟨k.1, k.2⟩
          left_inv := fun i => by simp
          right_inv := fun k => by ext; simp }
      have hf := measurePreserving_piCongrLeft
        (fun _ : {k : Fin P // p k} => (volume : Measure (Eucl P))) f
      set Z' : Set ({k : Fin P // p k} → Eucl P) := {w | (fun i : Fin (m + 1) => w (f i)) ∈ Z}
        with hZ'
      have hZ'0 : Measure.pi (fun _ : {k : Fin P // p k} => (volume : Measure (Eucl P))) Z' = 0 := by
        rw [← hf.measure_preimage_equiv Z']
        have hpre : (MeasurableEquiv.piCongrLeft (fun _ => Eucl P) f) ⁻¹' Z' = Z := by
          ext v
          simp only [hZ', mem_preimage, mem_ofPred_eq]
          congr! 1
        rw [hpre]
        exact hZ0
      have hset : {a : Fin P → Eucl P | (fun i : Fin (m + 1) => a (Fin.castLE hnP i)) ∈ Z} =
          (MeasurableEquiv.piEquivPiSubtypeProd (fun _ : Fin P => Eucl P) p) ⁻¹' (Z' ×ˢ univ) := by
        ext a
        simp [hZ', f, MeasurableEquiv.piEquivPiSubtypeProd, Equiv.piEquivPiSubtypeProd]
      rw [hset, volume_pi, hmp.measure_preimage_equiv, Measure.prod_prod, hZ'0, zero_mul]
    set GS : (Fin P → Eucl P) → (Fin P → Eucl P) :=
      fun a => InnerProductSpace.gramSchmidtNormed ℝ a with hGS
    have hGSon : ∀ a, LinearIndependent ℝ a → Orthonormal ℝ (GS a) :=
      fun a ha => InnerProductSpace.gramSchmidtNormed_orthonormal ha
    have hGSeq' : ∀ (O : Eucl P ≃ₗᵢ[ℝ] Eucl P) a, GS (fun i => O (a i)) = fun i => O (GS a i) :=
      hGSeq
    have hGSm' : Measurable GS := hGSm
    set T : (Fin P → Eucl P) → (Fin P → Eucl P) :=
      fun b k => (WithLp.toLp 2 (fun i : Fin P => b i k) : Eucl P) with hT
    have hco : ∀ k : Fin P, Continuous fun x : Eucl P => x k := fun k =>
      (EuclideanSpace.proj (𝕜 := ℝ) k).continuous
    have hTc : Continuous T := by
      refine continuous_pi fun k => (PiLp.continuous_toLp 2 _).comp (continuous_pi fun i => ?_)
      exact (hco k).comp (continuous_apply i)
    have hTm : Measurable T := hTc.measurable
    -- the law of the Gram-Schmidt frame equals the law of its transpose (Tonelli)
    have hTon := hTonGen μ hfin hμ0 hμinv hμind GS hGSm' hGSeq' hGSon
    -- every coordinate subframe of the Gram-Schmidt frame avoids `Z` almost surely
    have hS : ∀ β : Fin (m + 1) → Fin P,
        MeasurableSet {b : Fin P → Eucl P | (fun i => b (β i)) ∈ Z} :=
      fun β => hZm.preimage (measurable_pi_iff.mpr fun i => measurable_pi_apply (β i))
    have hbad : ∀ α : SimonMultiIndex (m + 1) P, μ {a | (fun i => GS a (α i)) ∈ Z} = 0 := by
      intro α
      obtain ⟨O, hO⟩ := hperm α
      have e1 : μ {a | (fun i => GS a (α i)) ∈ Z} = μ {a | (fun i => T (GS a) (α i)) ∈ Z} :=
        hTon _ (hS α)
      have hX : MeasurableSet {a | (fun i => T (GS a) (α i)) ∈ Z} := (hTm.comp hGSm') (hS α)
      have e2 : μ {a | (fun i => T (GS a) (α i)) ∈ Z} =
          μ {a | (fun i => T (GS a) (Fin.castLE hnP i)) ∈ Z} := by
        rw [← hμinv O _ hX]
        congr 1
        ext a
        simp only [mem_preimage, mem_ofPred_eq]
        rw [hGSeq']
        have : (fun i => T (fun j => O (GS a j)) (α i)) =
            (fun i => T (GS a) (Fin.castLE hnP i)) := by
          funext i; ext j; simp [hT, hO]
        rw [this]
      have e3 : μ {a | (fun i => T (GS a) (Fin.castLE hnP i)) ∈ Z} =
          μ {a | (fun i => GS a (Fin.castLE hnP i)) ∈ Z} :=
        (hTon _ (hS (Fin.castLE hnP))).symm
      have e4 : μ {a | (fun i => GS a (Fin.castLE hnP i)) ∈ Z} ≤
          μ {a | (fun i => a (Fin.castLE hnP i)) ∈ Z} := by
        refine measure_mono fun a ha => ?_
        obtain ⟨G, hG⟩ := hGSspan a
        have h' : (fun i => GS a (Fin.castLE hnP i)) =
            fun i => ∑ l, G i l • a (Fin.castLE hnP l) := funext hG
        exact hZpre G _ (h' ▸ ha)
      have e5 : μ {a | (fun i => a (Fin.castLE hnP i)) ∈ Z} = 0 :=
        le_antisymm ((Measure.restrict_le_self _).trans_eq hproj) zero_le
      rw [e1, e2, e3]
      exact le_antisymm (e4.trans e5.le) zero_le
    have hfinite : Finite (SimonMultiIndex (m + 1) P) :=
      Finite.of_injective (fun f : Fin (m + 1) ↪o Fin P => (f : Fin (m + 1) → Fin P))
        (fun f g h => RelEmbedding.ext (congrFun h))
    have hN : μ ({a | LinearIndependent ℝ a}ᶜ ∪
        ⋃ α : SimonMultiIndex (m + 1) P, {a | (fun i => GS a (α i)) ∈ Z}) = 0 := by
      refine measure_union_null ?_ (measure_iUnion_null hbad)
      rw [Measure.restrict_apply' hBm]
      refine measure_mono_null (fun a ha => ?_) measure_empty
      exact ha.1 ha.2.2
    obtain ⟨a, ha⟩ : ({a | LinearIndependent ℝ a}ᶜ ∪
        ⋃ α : SimonMultiIndex (m + 1) P, {a | (fun i => GS a (α i)) ∈ Z})ᶜ.Nonempty := by
      by_contra h
      rw [Set.not_nonempty_iff_eq_empty, compl_empty_iff] at h
      rw [h] at hN
      exact hμ0 hN
    simp only [mem_compl_iff, mem_union, not_or, mem_iUnion, not_exists, mem_ofPred_eq,
      not_not] at ha
    obtain ⟨hind, hgood⟩ := ha
    obtain ⟨U, hU⟩ := hUc (GS a) (hGSon a hind)
    refine ⟨U.symm, fun α => ?_⟩
    simp only [LinearIsometryEquiv.symm_symm, hU]
    have hsum : (fun i => ∑ k, (EuclideanSpace.single (α i) (1 : ℝ)) k • GS a k) =
        fun i => GS a (α i) := by
      funext i
      simp [PiLp.single_apply]
    rw [hsum]
    exact hgood α
  -- Step 2: compact, purely unrectifiable pieces of finite measure covering `A` up to a null set.
  obtain ⟨K, hKc, hKfin, hKpu, hnull⟩ : ∃ K : ℕ → Set (Eucl P), (∀ j, IsCompact (K j)) ∧
      (∀ j, (μHE[m + 1] : Measure (Eucl P)) (K j) < ∞) ∧
      (∀ j, Poincare.SimonGMT.Chapter03.PurelyUnrectifiable (m + 1) (K j)) ∧
      (μHE[m + 1] : Measure (Eucl P)) (A \ ⋃ j, K j) = 0 := by
    obtain ⟨S, hAS, hSfin⟩ := hS
    set μ : Measure (Eucl P) := μHE[m + 1] with hμ
    let A' : ℕ → Set (Eucl P) := fun j => A ∩ S j
    have hA'fin : ∀ j, μ (A' j) ≠ ∞ := fun j =>
      ((measure_mono inter_subset_right).trans_lt (hSfin j)).ne
    let B : ℕ → Set (Eucl P) := fun j => toMeasurable μ (A' j)
    have hBmeas : ∀ j, MeasurableSet (B j) := fun j => measurableSet_toMeasurable _ _
    have hAB : ∀ j, A' j ⊆ B j := fun j => subset_toMeasurable _ _
    have hBfin : ∀ j, μ (B j) < ∞ := fun j => by
      simp only [B, measure_toMeasurable]; exact (hA'fin j).lt_top
    have hBinter : ∀ j F, MeasurableSet F → μ (toMeasurable μ (A' j) ∩ F) = μ (A' j ∩ F) :=
      fun j F hF => Measure.measure_toMeasurable_inter hF (hA'fin j)
    have hBpu : ∀ j, Poincare.SimonGMT.Chapter03.PurelyUnrectifiable (m + 1) (B j) := by
      intro j
      obtain ⟨R, Pp, hRP, -, hRmeas, -, hRrect, hPpu⟩ :=
        Poincare.SimonGMT.Chapter03.measurable_rectifiable_purelyUnrectifiable_decomposition
          (n := m + 1) (hBmeas j).nullMeasurableSet (fun _ => B j)
          (subset_iUnion_of_subset 0 subset_rfl) (fun _ => hBfin j)
      have hRsub : R ⊆ B j := by rw [hRP]; exact subset_union_left
      have hR0 : μ R = 0 := by
        have h1 := hBinter j R hRmeas
        rw [inter_eq_right.mpr hRsub] at h1
        rw [h1]
        exact hA _ (inter_subset_left.trans inter_subset_left) (hRrect.mono inter_subset_right)
      intro T hT hTrect
      have hcov : T ⊆ (T ∩ R) ∪ (T ∩ Pp) := by
        intro x hx
        have hxB := hT hx
        rw [hRP] at hxB
        rcases hxB with h | h
        · exact Or.inl ⟨hx, h⟩
        · exact Or.inr ⟨hx, h⟩
      refine measure_mono_null hcov (measure_union_null (measure_mono_null inter_subset_right hR0) ?_)
      exact hPpu _ inter_subset_right (hTrect.mono inter_subset_left)
    have hcomp : ∀ j, ∃ C : ℕ → Set (Eucl P), (∀ i, IsCompact (C i)) ∧ (∀ i, C i ⊆ B j) ∧
        μ (B j \ ⋃ i, C i) = 0 := by
      intro j
      have : IsFiniteMeasure (μ.restrict (B j)) := isFiniteMeasure_restrict.mpr (hBfin j).ne
      have happrox : ∀ i : ℕ, ∃ C ⊆ B j, IsCompact C ∧
          μ.restrict (B j) (B j \ C) < ((i : ℝ≥0∞) + 1)⁻¹ := fun i =>
        (hBmeas j).exists_isCompact_sdiff_lt (measure_ne_top _ _) (by simp)
      choose C hCsub hCc hCsmall using happrox
      refine ⟨C, hCc, hCsub, ?_⟩
      have hle : ∀ i : ℕ, μ.restrict (B j) (B j \ ⋃ k, C k) ≤ ((i : ℝ≥0∞) + 1)⁻¹ := fun i =>
        ((measure_mono (sdiff_subset_sdiff_right (subset_iUnion C i))).trans (hCsmall i).le)
      have h0 : μ.restrict (B j) (B j \ ⋃ k, C k) = 0 := by
        refine le_antisymm (ENNReal.le_of_forall_pos_le_add ?_) zero_le
        intro ε hε _
        obtain ⟨i, hi⟩ := ENNReal.exists_inv_nat_lt (a := (ε : ℝ≥0∞)) (by simpa using hε.ne')
        calc μ.restrict (B j) (B j \ ⋃ k, C k) ≤ ((i : ℝ≥0∞) + 1)⁻¹ := hle i
          _ ≤ (i : ℝ≥0∞)⁻¹ := by gcongr; exact le_self_add
          _ ≤ ε := hi.le
          _ ≤ 0 + ε := by simp
      rwa [Measure.restrict_apply' (hBmeas j), inter_eq_left.mpr sdiff_subset] at h0
    choose C hCc hCsub hCnull using hcomp
    refine ⟨fun k => C (Nat.unpair k).1 (Nat.unpair k).2, fun k => hCc _ _, fun k => ?_,
      fun k => ?_, ?_⟩
    · exact (measure_mono (hCsub _ _)).trans_lt (hBfin _)
    · exact (hBpu _).mono (hCsub _ _)
    · have hsub : A \ ⋃ k, C (Nat.unpair k).1 (Nat.unpair k).2 ⊆ ⋃ j, (B j \ ⋃ i, C j i) := by
        intro x hx
        obtain ⟨j, hj⟩ := mem_iUnion.mp (hAS hx.1)
        refine mem_iUnion.mpr ⟨j, hAB j ⟨hx.1, hj⟩, ?_⟩
        intro hxC
        obtain ⟨i, hi⟩ := mem_iUnion.mp hxC
        exact hx.2 (mem_iUnion.mpr ⟨Nat.pair j i, by simpa [Nat.unpair_pair] using hi⟩)
      exact measure_mono_null hsub (measure_iUnion_null hCnull)
  -- the row maps `L v x = (⟪v i, x⟫)ᵢ`
  let L : (Fin (m + 1) → Eucl P) → Eucl P → Eucl (m + 1) :=
    fun v x => (WithLp.toLp 2 (fun i : Fin (m + 1) => inner ℝ (v i) x) : Eucl (m + 1))
  -- Step 3(b): `v ↦ Lⁿ(L v '' K)` is measurable for compact `K` (closed graph and Tonelli).
  have hLmeas : ∀ K' : Set (Eucl P), IsCompact K' →
      Measurable (fun v => (volume : Measure (Eucl (m + 1))) (L v '' K')) := by
    intro K' hK'
    let Λ : (Fin (m + 1) → Eucl P) × Eucl P → Eucl (m + 1) := fun p => L p.1 p.2
    have hΛ : Continuous Λ := by
      apply (PiLp.continuous_toLp 2 _).comp
      apply continuous_pi
      intro i
      exact ((continuous_apply i).comp continuous_fst).inner continuous_snd
    let Γ : Set ((Fin (m + 1) → Eucl P) × Eucl (m + 1)) := {q | ∃ x ∈ K', Λ (q.1, x) = q.2}
    have hΓ : IsClosed Γ := by
      have : CompactSpace K' := isCompact_iff_compactSpace.mp hK'
      let C' : Set (((Fin (m + 1) → Eucl P) × Eucl (m + 1)) × K') :=
        {r | Λ (r.1.1, (r.2 : Eucl P)) = r.1.2}
      have hC' : IsClosed C' := isClosed_eq
        (hΛ.comp ((continuous_fst.comp continuous_fst).prodMk
          (continuous_subtype_val.comp continuous_snd)))
        (continuous_snd.comp continuous_fst)
      have himg : Prod.fst '' C' = Γ := by
        ext q
        constructor
        · rintro ⟨r, hr, rfl⟩
          exact ⟨r.2, r.2.2, hr⟩
        · rintro ⟨x, hx, hq⟩
          exact ⟨(q, ⟨x, hx⟩), hq, rfl⟩
      rw [← himg]
      exact isClosedMap_fst_of_compactSpace C' hC'
    have hmeas := measurable_measure_prodMk_left (ν := (volume : Measure (Eucl (m + 1))))
      hΓ.measurableSet
    have hsec : ∀ v : Fin (m + 1) → Eucl P, Prod.mk v ⁻¹' Γ = L v '' K' := by
      intro v
      ext y
      simp only [mem_image, mem_preimage, mem_ofPred_eq, Γ, Λ]
    simp_rw [← hsec]
    exact hmeas
  -- Step 3(c): recombining the rows by a matrix `G` scales `Lⁿ(L v '' S)` by `|det G|`.
  have hLrec : ∀ (G : Matrix (Fin (m + 1)) (Fin (m + 1)) ℝ) (v : Fin (m + 1) → Eucl P)
      (S' : Set (Eucl P)), (volume : Measure (Eucl (m + 1))) (L (fun i => ∑ l, G i l • v l) '' S') =
        ENNReal.ofReal |G.det| * (volume : Measure (Eucl (m + 1))) (L v '' S') := by
    intro G v S'
    let g : Eucl (m + 1) →ₗ[ℝ] Eucl (m + 1) := Matrix.toEuclideanLin G
    have hcomp : L (fun i => ∑ l, G i l • v l) = g ∘ L v := by
      funext x
      ext i
      simp [L, g, Matrix.toEuclideanLin, Matrix.mulVec, dotProduct, sum_inner, inner_smul_left]
    have hdet : LinearMap.det g = G.det := by
      simp only [g, Matrix.toEuclideanLin]
      simp
    rw [hcomp, Set.image_comp, Measure.addHaar_image_linearMap, hdet]
  -- the bad set `Z`
  let Z : Set (Fin (m + 1) → Eucl P) :=
    ⋃ j, {v | 0 < (volume : Measure (Eucl (m + 1))) (L v '' K j)}
  have hZm : MeasurableSet Z :=
    MeasurableSet.iUnion fun j => measurableSet_lt measurable_const (hLmeas (K j) (hKc j))
  -- Step 3(a): `Z` is Lebesgue-null.
  have hZ0 : (volume : Measure (Fin (m + 1) → Eucl P)) Z = 0 := by
    refine measure_iUnion_null fun j => ?_
    have h := bf P m (K j) (hKc j).isClosed.measurableSet (hKfin j) (hKpu j)
    rw [ae_iff] at h
    refine measure_mono_null (fun v hv => ?_) h
    simp only [mem_ofPred_eq] at hv ⊢
    exact hv.ne'
  have hZpre : ∀ (G : Matrix (Fin (m + 1)) (Fin (m + 1)) ℝ) (w : Fin (m + 1) → Eucl P),
      (fun i => ∑ l, G i l • w l) ∈ Z → w ∈ Z := by
    intro G w hw
    simp only [Z, mem_iUnion, mem_ofPred_eq] at hw ⊢
    obtain ⟨j, hj⟩ := hw
    refine ⟨j, pos_iff_ne_zero.mpr fun h0 => ?_⟩
    rw [hLrec G w (K j), h0, mul_zero] at hj
    exact lt_irrefl _ hj
  obtain ⟨Q, hQ⟩ := hFA Z hZm hZ0 hZpre
  -- Steps 4 and 3(d): conclusion
  refine ⟨Q, fun α => ?_⟩
  set v : Fin (m + 1) → Eucl P := fun i => Q.symm (EuclideanSpace.single (α i) (1 : ℝ)) with hvdef
  have hv : ∀ j, (volume : Measure (Eucl (m + 1))) (L v '' K j) = 0 := by
    intro j
    by_contra hne
    exact hQ α (mem_iUnion.mpr ⟨j, pos_iff_ne_zero.mpr hne⟩)
  have hrows : (fun x : Eucl P => (WithLp.toLp 2 (fun i : Fin (m + 1) => Q x (α i)) : Eucl (m + 1)))
      = L v := by
    funext x
    simp only [L, v]
    congr 1
    funext i
    rw [← LinearIsometryEquiv.inner_map_map Q, LinearIsometryEquiv.apply_symm_apply,
      EuclideanSpace.inner_single_left]
    simp
  rw [hrows]
  have hsub : L v '' A ⊆ (⋃ j, L v '' K j) ∪ L v '' (A \ ⋃ j, K j) := by
    rintro y ⟨x, hxA, rfl⟩
    by_cases hx : x ∈ ⋃ j, K j
    · obtain ⟨j, hj⟩ := mem_iUnion.mp hx
      exact Or.inl (mem_iUnion.mpr ⟨j, mem_image_of_mem _ hj⟩)
    · exact Or.inr (mem_image_of_mem _ ⟨hxA, hx⟩)
  refine measure_mono_null hsub (measure_union_null (measure_iUnion_null hv) ?_)
  let ℓ : Eucl P →ₗ[ℝ] Eucl (m + 1) :=
    { toFun := L v
      map_add' := by
        intro x y
        simp only [L]
        ext i
        simp [inner_add_right]
      map_smul' := by
        intro c x
        simp only [L]
        ext i
        simp [inner_smul_right] }
  let f : Eucl P →L[ℝ] Eucl (m + 1) := LinearMap.toContinuousLinearMap ℓ
  have hf : (f : Eucl P → Eucl (m + 1)) = L v := rfl
  have hvol : (volume : Measure (Eucl (m + 1))) = (μHE[m + 1] : Measure (Eucl (m + 1))) := by
    have h := InnerProductSpace.euclideanHausdorffMeasure_eq_volume (V := Eucl (m + 1))
    simpa [finrank_euclideanSpace] using h.symm
  rw [hvol, ← hf]
  have hle := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn
    (A := A \ ⋃ j, K j) (m + 1) (f.lipschitzWith.lipschitzOnWith)
  rw [hnull, mul_zero] at hle
  exact le_antisymm hle zero_le

/-- Simon Ch. 6, proof of 8.1, (1)–(8) (pp. 173–174): if `Θ*ⁿ(μ, x) > 0` for `μ`-a.e. `x`, the
mass measure `μ` of `T` is `θ Hⁿ ⌞ M` for a Borel, countably `n`-rectifiable `M ⊆ U` and a Borel
`θ`, positive on `M` and locally `Hⁿ`-integrable in `U`.  A Borel carrier
`B₀ ⊆ U ∩ {Θ*ⁿ(μ, ·) > 0}` of `μ` is `Hⁿ`-σ-finite; in its decomposition `B₀ = R ∪ P'`
(Ch. 3, Lemma 3.2) the purely unrectifiable part `P'` is `μ`-null by the structure theorem and
Remark 2.37(2), hence `Hⁿ`-null; Radon–Nikodym for `μ ≪ Hⁿ ⌞ B₀` then gives `M` and `θ`. -/
theorem Submission.rectifiability_mass_measure_rectifiable : ∀ (P m : ℕ) (U : Set (Eucl P)), IsOpen U → ∀ T : GeometricCurrentOn U (m + 1), (∀ W, CompactlyContainedOpen W U → T.massOn W + T.boundary.massOn W < ∞) → ∀ μ : Measure (Eucl P), IsMassMeasure T μ → (∀ᵐ x ∂μ, 0 < dimensionalUpperDensity μ.toOuterMeasure ((m + 1 : ℕ) : ℝ) univ x) → ∃ (M : Set (Eucl P)) (θ : Eucl P → ℝ), M ⊆ U ∧ MeasurableSet M ∧ CountablyRectifiable (m + 1) M ∧ Measurable θ ∧ (∀ x ∈ M, 0 < θ x) ∧ (∀ K : Set (Eucl P), IsCompact K → K ⊆ U → IntegrableOn θ (M ∩ K) (μHE[m + 1] : Measure (Eucl P))) ∧ μ = ((μHE[m + 1] : Measure (Eucl P)).restrict M).withDensity (fun x => ENNReal.ofReal (θ x)) := by
  intro P m U hU T hmass μ hμ hdens
  -- Step 1: an exhaustion `W i ⊂⊂ U` with `μ(W i) = M_{W i}(T) < ∞` and `U ⊆ ⋃ i, W i`, so `μ`
  -- is σ-finite; and `μ ≪ Hⁿ` (Remark 2.37(1)).
  obtain ⟨W, hWU, hWK⟩ := Submission.cmb_exists_compactly_contained_exhaustion P U hU
  have hWo : ∀ i, IsOpen (W i) := fun i => (hWU i).1
  have hWfin : ∀ i, μ (W i) < ∞ := fun i => by
    rw [hμ.2 _ (hWU i)]
    exact le_self_add.trans_lt (hmass _ (hWU i))
  have hUW : U ⊆ ⋃ i, W i := fun x hx => by
    obtain ⟨i, hi⟩ := hWK {x} isCompact_singleton (singleton_subset_iff.2 hx)
    exact mem_iUnion.2 ⟨i, hi (mem_singleton x)⟩
  have hμσ : SigmaFinite μ := by
    refine ⟨⟨⟨fun i => W i ∪ Uᶜ, fun _ => trivial, fun i => ?_, ?_⟩⟩⟩
    · exact (measure_union_le _ _).trans_lt (by rw [hμ.1, add_zero]; exact hWfin i)
    · refine eq_univ_of_forall fun x => ?_
      by_cases hx : x ∈ U
      · obtain ⟨i, hi⟩ := mem_iUnion.1 (hUW hx)
        exact mem_iUnion.2 ⟨i, Or.inl hi⟩
      · exact mem_iUnion.2 ⟨0, Or.inr hx⟩
  have hac := Submission.rectifiability_mass_measure_abs_continuous P m U hU T hmass μ hμ
  -- Step 2: a Borel carrier `B₀ = U ∖ Z` of `μ`, `Z` a Borel `μ`-null hull of
  -- `{x : ¬ Θ*ⁿ(μ, x) > 0}`.
  obtain ⟨B₀, hB₀m, hB₀U, hB₀D, hμB₀⟩ : ∃ B₀ : Set (Eucl P), MeasurableSet B₀ ∧ B₀ ⊆ U ∧
      (∀ x ∈ B₀, 0 < dimensionalUpperDensity μ.toOuterMeasure ((m + 1 : ℕ) : ℝ) univ x) ∧
      μ B₀ᶜ = 0 := by
    set Z := toMeasurable μ {x | ¬ 0 < dimensionalUpperDensity μ.toOuterMeasure
      ((m + 1 : ℕ) : ℝ) univ x} with hZ
    have hZ0 : μ Z = 0 := by
      rw [hZ, measure_toMeasurable]
      exact ae_iff.1 hdens
    refine ⟨U \ Z, hU.measurableSet.diff (measurableSet_toMeasurable _ _), sdiff_subset,
      fun x hx => ?_, measure_mono_null (fun x hx => ?_) (measure_union_null hμ.1 hZ0)⟩
    · by_contra h
      exact hx.2 (subset_toMeasurable _ _ h)
    · by_cases hxU : x ∈ U
      · exact Or.inr (by_contra fun hxZ => hx ⟨hxU, hxZ⟩)
      · exact Or.inl hxU
  -- Step 3 (printed (1)): `B₀` is covered by countably many sets of finite `Hⁿ`-measure.
  obtain ⟨C, hB₀C, hCfin⟩ := (Submission.rectifiability_positive_density_cover_null P (m + 1) μ W
    B₀ hWo hWfin (hB₀U.trans hUW) hB₀D).1
  -- Step 4: Lemma 3.2 of Ch. 3 gives `B₀ = R ∪ P'` with `R` Borel and countably rectifiable and
  -- `P'` purely unrectifiable.
  obtain ⟨R, P', hRP, -, -, hP'm, hRrect, hP'pure⟩ :=
    Poincare.SimonGMT.Chapter03.measurable_rectifiable_purelyUnrectifiable_decomposition
      hB₀m.nullMeasurableSet C hB₀C hCfin
  have hP'B₀ : P' ⊆ B₀ := subset_union_right.trans hRP.symm.subset
  -- `μ(P') = 0`: the structure theorem gives `Q` with `Lⁿ(p_α(Q P')) = 0` for all `α`; Remark
  -- 2.37(2) gives `μ(Bk) = 0` for a Borel kernel `Bk ⊆ P'`, and `μ ≪ Hⁿ` handles `P' ∖ Bk`.
  obtain ⟨Q, hQ⟩ := Submission.rectifiability_structure_projection P m P' hP'pure
    ⟨C, hP'B₀.trans hB₀C, hCfin⟩
  obtain ⟨Bk, hBkP', hBkm, hBkae⟩ := hP'm.exists_measurable_subset_ae_eq
  have hμBk : μ Bk = 0 := Submission.rectifiability_projection_null P m U hU T hmass μ hμ Q Bk
    hBkm fun α => measure_mono_null (image_mono hBkP') (hQ α)
  have hμP' : μ P' = 0 :=
    measure_mono_null (union_sdiff_cancel hBkP').symm.subset
      (measure_union_null hμBk (hac (ae_le_set.1 hBkae.symm.le)))
  -- `Hⁿ(P') = 0` (printed (6)), so `B₀ = R ∪ P'` is countably rectifiable (printed (7)).
  have hP'0 : (μHE[m + 1] : Measure (Eucl P)) P' = 0 :=
    (Submission.rectifiability_positive_density_cover_null P (m + 1) μ W P' hWo hWfin
      (hP'B₀.trans (hB₀U.trans hUW)) fun x hx => hB₀D x (hP'B₀ hx)).2 hμP'
  have hB₀rect : CountablyRectifiable (m + 1) B₀ := by
    have h := Poincare.SimonGMT.Chapter03.countablyRectifiable_sUnion (n := m + 1) (D := {R, P'})
      ((countable_singleton P').insert R) (by
        rintro S (rfl | rfl)
        exacts [hRrect, Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero hP'0])
    rwa [sUnion_pair, ← hRP] at h
  -- Steps 5–6 (printed (8)): Radon–Nikodym for `μ ≪ Hⁿ ⌞ B₀`, with `Hⁿ ⌞ B₀` σ-finite by step 3,
  -- gives `M ⊆ B₀` and `θ > 0` on `M` with `μ = θ Hⁿ ⌞ M`.
  obtain ⟨M, θ, hMB₀, hMm, hθm, hθpos, hθint, hrep⟩ :=
    Submission.rectifiability_rn_positive_real_density (Eucl P) (μHE[m + 1] : Measure (Eucl P)) μ
      B₀ hB₀m (Poincare.SimonGMT.Chapter03.sigmaFinite_restrict_of_hausdorff_finite_cover C hB₀C
        hCfin) hμσ hμB₀ hac
  -- Step 7: a compact `K ⊆ U` lies in some `W i`, so `μ(K) < ∞` and `θ` is integrable on `M ∩ K`.
  refine ⟨M, θ, hMB₀.trans hB₀U, hMm, hB₀rect.mono hMB₀, hθm, hθpos, fun K hK hKU => ?_, hrep⟩
  obtain ⟨i, hi⟩ := hWK K hK hKU
  exact hθint K hK.measurableSet ((measure_mono hi).trans_lt (hWfin i))

/-- **Simon Ch. 6, 8.1 (Rectifiability Theorem, p. 173).**  By (1)–(8) of the printed proof the
mass measure is `μ = θ Hⁿ ⌞ M` with `M` countably `n`-rectifiable and `θ > 0` locally
`Hⁿ`-integrable on `M`; by (2.7)–(2.8) `T(ω) = ∫ ⟨ω, ξ⟩ dμ` with `|ξ| = 1` `μ`-a.e., so
`T = τ(M, θ, ξ)` (9); and by (10)–(13) `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ` for an orthonormal basis `τ` of the
weighted approximate tangent space `TₓM`, for `Hⁿ`-a.e. `x ∈ M`.  (Book `n = m + 1`.) -/
theorem Submission.rectifiability_theorem : RectifiabilityTheorem := by
  intro P m U hU T hT ⟨μ, hμ, hdens⟩
  -- (1)–(8): `μ = θ Hⁿ ⌞ M`.
  obtain ⟨M, θ, hMU, hM, hMrect, hθm, hθpos, hθint, rfl⟩ :=
    Submission.rectifiability_mass_measure_rectifiable P m U hU T hT μ hμ hdens
  -- (2.7)–(2.8), using `M_W(T) ≤ M_W(T) + M_W(∂T)`.
  obtain ⟨ξ, hξm, hξ1, hrep⟩ :=
    (Submission.rectifiability_mass_measure_representation P (m + 1) U hU T fun W hW =>
      (hT W hW).trans_le' le_self_add).2 _ hμ
  -- (9): `T = τ(M, θ, ξ)`, as `θ > 0` on `M`.
  have hτ : ∀ ω : TestFormOn U (m + 1), T ω = tauAction (m + 1) M θ ξ ω := fun ω => by
    rw [(hrep ω).2, integral_withDensity_eq_integral_toReal_smul hθm.ennreal_ofReal
      (Eventually.of_forall fun _ => ENNReal.ofReal_lt_top), tauAction]
    exact setIntegral_congr_fun hM fun x hx => by
      rw [ENNReal.toReal_ofReal (hθpos x hx).le, smul_eq_mul]
  -- `|ξ| = 1` holds `Hⁿ`-a.e. on `M`, as `θ > 0` on `M`.
  have hξ1' : ∀ᵐ x ∂((μHE[m + 1] : Measure (Eucl P)).restrict M),
      ∑ α : SimonMultiIndex (m + 1) P, (euclideanNVectorCoordinate (ξ x) α) ^ 2 = 1 := by
    filter_upwards [(ae_withDensity_iff hθm.ennreal_ofReal).1 hξ1, ae_restrict_mem hM]
      with x hx hxM
    exact hx (ENNReal.ofReal_pos.2 (hθpos x hxM)).ne'
  -- (10)–(13), using `M_W(∂T) ≤ M_W(T) + M_W(∂T)`.
  exact ⟨M, θ, ξ, ⟨hMU, hM.nullMeasurableSet, hMrect, hθpos, hθint, hξm.aestronglyMeasurable,
    Submission.rectifiability_orientation P m U hU T (fun W hW => (hT W hW).trans_le' le_add_self)
      M θ ξ hMU hM.nullMeasurableSet hMrect hθpos hθint hξm.aestronglyMeasurable hξ1' hτ⟩, hτ⟩

/-- Interior product of a unit simple `(m+1)`-vector with a unit vector of its plane (Simon Ch. 6,
4.3).  Let `τ` be an orthonormal frame of `T = span τ`, `0 ≠ g ∈ T`, `ν = |g|⁻¹ g`, and
`w = ±τ₁ ∧ ⋯ ∧ τₘ₊₁`.  The contraction `w ⌞ ν : α ↦ w(ν♭ ∧ α)`, where
`(ν♭ ∧ α)(v) = ∑ᵢ (-1)ⁱ ⟨ν, vᵢ⟩ α(v₀, …, v̂ᵢ, …, vₘ)` (`alternatizeUncurryFin_apply`), is
`±τ'₁ ∧ ⋯ ∧ τ'ₘ` for an orthonormal basis `τ'` of `S = T ∩ g^⊥`.  Indeed `S` has dimension `m`
(`finrank_add_inf_finrank_orthogonal'`), `σ = (τ', ν)` is an orthonormal basis of `T`, so
`w = ±simpleNVector σ` (`Submission.fiw_ims_frame_sign`), and `(ν♭ ∧ α)(σ) = (-1)^m α(τ')` because
`⟨ν, τ'ₖ⟩ = 0`, `|ν| = 1` and `removeNth (last m) σ = τ'`. -/
theorem Submission.slicing_im_st_interior_product :
    ∀ (P m : ℕ) (τ : Fin (m + 1) → Eucl P) (g : Eucl P) (w : NVector (Eucl P) (m + 1)), Orthonormal ℝ τ → g ∈ Submodule.span ℝ (range τ) → g ≠ 0 → (w = simpleNVector τ ∨ w = -simpleNVector τ) → ∃ τ' : Fin m → Eucl P, Orthonormal ℝ τ' ∧ Submodule.span ℝ (range τ') = Submodule.span ℝ (range τ) ⊓ (ℝ ∙ g)ᗮ ∧ (w.comp ((ContinuousAlternatingMap.alternatizeUncurryFinCLM ℝ (Eucl P) ℝ).comp (ContinuousLinearMap.smulRightL ℝ (Eucl P) (Covector (Eucl P) m) (innerSL ℝ (‖g‖⁻¹ • g)))) = simpleNVector τ' ∨ w.comp ((ContinuousAlternatingMap.alternatizeUncurryFinCLM ℝ (Eucl P) ℝ).comp (ContinuousLinearMap.smulRightL ℝ (Eucl P) (Covector (Eucl P) m) (innerSL ℝ (‖g‖⁻¹ • g)))) = -simpleNVector τ') := by
  intro P m τ g w hτ hg hg0 hw
  set T : Submodule ℝ (Eucl P) := Submodule.span ℝ (range τ) with hTdef
  set S : Submodule ℝ (Eucl P) := T ⊓ (ℝ ∙ g)ᗮ with hSdef
  set ν : Eucl P := ‖g‖⁻¹ • g with hνdef
  -- Step 1: `S` has dimension `m`, as `ℝ ∙ g ≤ T` has dimension `1` and `T` dimension `m + 1`.
  have hT : Module.finrank ℝ T = m + 1 := by
    rw [hTdef, finrank_span_eq_card hτ.linearIndependent, Fintype.card_fin]
  have hgT : (ℝ ∙ g) ≤ T := (Submodule.span_singleton_le_iff_mem g T).2 hg
  have hS : Module.finrank ℝ S = m := by
    rw [hSdef, inf_comm]
    exact Submodule.finrank_add_inf_finrank_orthogonal' hgT
      (by rw [finrank_span_singleton hg0, hT, add_comm])
  -- Step 2: an orthonormal basis `τ'` of `S`, indexed by `Fin m`.
  let b : OrthonormalBasis (Fin m) ℝ S := (stdOrthonormalBasis ℝ S).reindex (finCongr hS)
  let τ' : Fin m → Eucl P := fun i => (b i : Eucl P)
  have hτ' : Orthonormal ℝ τ' := b.orthonormal.comp_linearIsometry S.subtypeₗᵢ
  have hτ'S : ∀ k, τ' k ∈ S := fun k => (b k).2
  have hspan' : Submodule.span ℝ (range τ') = S := by
    have hr : range τ' = S.subtype '' range b := by
      rw [← range_comp]
      rfl
    have htop : Submodule.span ℝ (range b) = ⊤ := by
      simpa using b.toBasis.span_eq
    rw [hr, Submodule.span_image, htop, Submodule.map_subtype_top]
  -- Step 3: the adapted frame `σ = (τ', ν)` is an orthonormal basis of `T`.
  have hνT : ν ∈ T := T.smul_mem _ hg
  have hν1 : ‖ν‖ = 1 := by
    simpa [hνdef] using norm_smul_inv_norm (𝕜 := ℝ) hg0
  have hτ'ν : ∀ k, inner ℝ (τ' k) ν = 0 := by
    intro k
    have hk : inner ℝ g (τ' k) = 0 :=
      Submodule.mem_orthogonal_singleton_iff_inner_right.1 (hτ'S k).2
    rw [hνdef, inner_smul_right, real_inner_comm, hk, mul_zero]
  have hντ' : ∀ k, inner ℝ ν (τ' k) = 0 := fun k => by
    rw [real_inner_comm]
    exact hτ'ν k
  set σ : Fin (m + 1) → Eucl P := Fin.snoc (α := fun _ => Eucl P) τ' ν with hσdef
  have hσ : Orthonormal ℝ σ := by
    rw [orthonormal_iff_ite]
    intro i j
    refine Fin.lastCases ?_ (fun a => ?_) i <;> refine Fin.lastCases ?_ (fun c => ?_) j
    · simp [σ, hν1]
    · simp [σ, hντ', (Fin.castSucc_ne_last c).symm]
    · simp [σ, hτ'ν, Fin.castSucc_ne_last a]
    · simp only [σ, Fin.snoc_castSucc, Fin.castSucc_inj]
      exact orthonormal_iff_ite.1 hτ' a c
  have hσT : Submodule.span ℝ (range σ) = T := by
    apply Submodule.eq_of_le_of_finrank_eq
    · rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      refine Fin.lastCases ?_ (fun a => ?_) i
      · simpa [σ] using hνT
      · simpa [σ] using (hτ'S a).1
    · rw [finrank_span_eq_card hσ.linearIndependent, Fintype.card_fin, hT]
  -- Step 4: frame sign, `w = ± simpleNVector σ`.
  have hwσ : w = simpleNVector σ ∨ w = -simpleNVector σ := by
    rcases Submission.fiw_ims_frame_sign P (m + 1) τ σ hτ hσ hσT.symm with hs | hs <;>
      rcases hw with rfl | rfl
    · exact Or.inl hs.symm
    · exact Or.inr (by rw [hs])
    · exact Or.inr (by rw [hs]; exact (neg_neg (simpleNVector τ)).symm)
    · exact Or.inl (by rw [hs])
  -- Step 5: evaluation, `(ν♭ ∧ α)(σ) = (-1)^m α(τ')`.
  have hc : (simpleNVector σ).comp
      ((ContinuousAlternatingMap.alternatizeUncurryFinCLM ℝ (Eucl P) ℝ).comp
        (ContinuousLinearMap.smulRightL ℝ (Eucl P) (Covector (Eucl P) m) (innerSL ℝ ν))) =
      ((-1 : ℝ) ^ m) • simpleNVector τ' := by
    ext α
    simp only [ContinuousLinearMap.comp_apply, simpleNVector_apply, smul_apply, smul_eq_mul,
      ContinuousAlternatingMap.alternatizeUncurryFinCLM_apply,
      ContinuousAlternatingMap.alternatizeUncurryFin_apply]
    rw [Fin.sum_univ_castSucc]
    simp [σ, Fin.removeNth_last, Fin.init_snoc, hντ', hν1]
  -- Step 6: conclusion, `w ⌞ ν = ± (-1)^m simpleNVector τ'`.
  refine ⟨τ', hτ', hspan', ?_⟩
  rcases neg_one_pow_eq_or ℝ m with hm | hm <;> rcases hwσ with rfl | rfl
  · left
    rw [hc, hm, one_smul]
  · right
    rw [ContinuousLinearMap.neg_comp, hc, hm, one_smul]
  · right
    rw [hc, hm, neg_one_smul ℝ (simpleNVector τ')]
  · left
    rw [ContinuousLinearMap.neg_comp, hc, hm, neg_one_smul ℝ (simpleNVector τ')]
    exact neg_neg (simpleNVector τ')

/-- Slices of a rectifiable triple are rectifiable triples (Simon Ch. 6, 4.1–4.4).  For `L¹`-a.e.
`t`, `M_t = {x ∈ M : f(x) = t, G(x) ≠ 0}` with multiplicity `θ` and orientation
`ξ_t = ξ ⌞ ν`, `ν = |G|⁻¹ G` (`ξ_t(x)(α) = ξ(x)(ν(x)♭ ∧ α)`), is a rectifiable `m`-triple in `U`.
The co-area formula `slicing_im_coarea` for `(M, f, G)` feeds `slicing_im_st_measure_fields`
(null-measurability of `M_t`, local integrability of `θ` on `M_t`, measurability of `ξ_t`),
`slicing_im_st_slice_geometry` (`M_t` is countably `m`-rectifiable with weighted approximate
tangent plane `TₓM ∩ G(x)^⊥`, Simon 4.1(2)) and the null transfer `slicing_im_st_ae_transfer`,
which carries the orientation clause of `(M, θ, ξ)` and the tangential-gradient property to
`Hᵐ`-a.e. point of `M_t`; `subset` and `pos` are inherited from `M_t ⊆ M`.  At such a point,
`ξ(x) = ±τ₁ ∧ ⋯ ∧ τₘ₊₁` with `τ` an orthonormal basis of `TₓM ∋ G(x) ≠ 0`, so
`slicing_im_st_interior_product` gives an orthonormal basis `τ'` of `TₓM ∩ G(x)^⊥` with
`ξ_t(x) = ±τ'₁ ∧ ⋯ ∧ τ'ₘ` (Simon 4.3). -/
theorem Submission.slicing_im_slice_triple :
    ∀ (P m : ℕ) (U M : Set (Eucl P)) (θ : Eucl P → ℝ) (ξ : Eucl P → NVector (Eucl P) (m + 1))
      (f : Eucl P → ℝ) (L : ℝ≥0) (G : Eucl P → Eucl P), IsOpen U →
      IsRectifiableTriple U (m + 1) M θ ξ → LipschitzWith L f → Measurable G →
      (∀ x, ‖G x‖ ≤ L) →
      (∀ᵐ x ∂((μHE[m + 1] : Measure (Eucl P)).restrict M), ∀ Q : Submodule ℝ (Eucl P),
        HasWeightedApproximateTangentSpaceAt (m + 1) M θ x Q →
          G x ∈ Q ∧ ∀ u ∈ Q, HasDerivAt (fun s : ℝ => f (x + s • u)) (inner ℝ (G x) u) 0) →
      ∀ᵐ t ∂(volume : Measure ℝ), IsRectifiableTriple U m {x | x ∈ M ∧ f x = t ∧ G x ≠ 0} θ
        (fun x => (ξ x).comp ((ContinuousAlternatingMap.alternatizeUncurryFinCLM ℝ (Eucl P) ℝ).comp
          (ContinuousLinearMap.smulRightL ℝ (Eucl P) (Covector (Eucl P) m)
            (innerSL ℝ (‖G x‖⁻¹ • G x))))) := by
  intro P m U M θ ξ f L G hU hT hf hG hGL hTG
  -- The co-area formula for `(M, f, G)`.
  have hCA := Submission.slicing_im_coarea P m U M θ ξ f L G hU hT hf hG hGL hTG
  -- For a.e. `t`: `M_t` is `Hᵐ`-null-measurable, `θ` is locally `Hᵐ`-integrable on `M_t` and
  -- `ξ_t` is `Hᵐ ⌞ M_t`-a.e. strongly measurable.
  have hMF := Submission.slicing_im_st_measure_fields P m U M θ ξ f L G hU hT
    hf.continuous.measurable hG hGL hCA
  -- For a.e. `t`: `M_t` is countably `m`-rectifiable and, `Hᵐ`-a.e. on `M_t`, `TₓM ∩ G(x)^⊥` is
  -- a weighted approximate tangent plane of `(M_t, θ)`.
  have hSG := Submission.slicing_im_st_slice_geometry P m U M θ ξ f L G hU hT hf hG hGL hTG hCA
  -- For a.e. `t`: the orientation clause of `(M, θ, ξ)` and the tangential-gradient property hold
  -- `Hᵐ`-a.e. on `M ∩ f⁻¹{t}`.
  have hNT := Submission.slicing_im_st_ae_transfer P m M f G hCA _ (hT.orients.and hTG)
  filter_upwards [hMF, hSG, hNT] with t ⟨hnm, hint, hasm⟩ ⟨hcr, htan⟩ hp
  have hsub : {x | x ∈ M ∧ f x = t ∧ G x ≠ 0} ⊆ M ∩ f ⁻¹' {t} := fun x hx => ⟨hx.1, hx.2.1⟩
  refine ⟨fun x hx => hT.subset hx.1, hnm, hcr, fun x hx => hT.pos x hx.1, hint, hasm, ?_⟩
  -- Orientation: `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₘ₊₁` with `span τ = TₓM ∋ G(x) ≠ 0`, so
  -- `ξ_t(x) = ±τ'₁ ∧ ⋯ ∧ τ'ₘ` with `span τ' = TₓM ∩ G(x)^⊥`, a weighted approximate tangent plane
  -- of `(M_t, θ)` at `x`.
  filter_upwards [ae_restrict_mem₀ hnm, htan, ae_restrict_of_ae_restrict_of_subset hsub hp]
    with x hx hxtan ⟨⟨τ, hτ, hτT, hξ⟩, hxTG⟩
  obtain ⟨τ', hτ', hspan, hξ'⟩ :=
    Submission.slicing_im_st_interior_product P m τ (G x) (ξ x) hτ (hxTG _ hτT).1 hx.2.2 hξ
  refine ⟨τ', hτ', ?_, hξ'⟩
  rw [hspan]
  exact hxtan _ hτT

/-- Integrals converge if they converge on every piece of a countable measurable partition, under
integrable domination (step 4 of the tangential weak limit argument).  As `ν` lives on `⋃ⱼ Vⱼ`,
countable additivity gives `∫ H dν = ∑ⱼ ∫_{Vⱼ} H dν` for integrable `H`; the terms for `H = F_k`
are bounded by the summable `∫_{Vⱼ} b dν`, so Tannery's theorem (dominated convergence for series,
the `ε / 3` argument of Mathlib's `tendsto_tsum_of_dominated_convergence`, inlined since that file
is not available here) passes to the limit termwise. -/
theorem Submission.slicing_im_ll_twl_partition_tendsto :
    ∀ (X : Type) [MeasurableSpace X] (ν : Measure X) (V : ℕ → Set X) (b : X → ℝ)
      (F : ℕ → X → ℝ) (Flim : X → ℝ), (∀ j, MeasurableSet (V j)) →
      Pairwise (Function.onFun Disjoint V) → ν (⋃ j, V j)ᶜ = 0 → Integrable b ν →
      (∀ k, Integrable (F k) ν) → (∀ k, ∀ᵐ x ∂ν, ‖F k x‖ ≤ b x) → Integrable Flim ν →
      (∀ j, Tendsto (fun k => ∫ x in V j, F k x ∂ν) atTop (𝓝 (∫ x in V j, Flim x ∂ν))) →
      Tendsto (fun k => ∫ x, F k x ∂ν) atTop (𝓝 (∫ x, Flim x ∂ν)) := by
  intro X _ ν V b F Flim hVm hVd hVc hb hF hFb hFlim hlim
  -- `ν` lives on `⋃ⱼ Vⱼ`, so `∫ H dν = ∑ⱼ ∫_{Vⱼ} H dν` for integrable `H`.
  have hν : ν.restrict (⋃ j, V j) = ν := Measure.restrict_eq_self_of_ae_mem (mem_ae_iff.2 hVc)
  have hsum : ∀ H : X → ℝ, Integrable H ν →
      HasSum (fun j => ∫ x in V j, H x ∂ν) (∫ x, H x ∂ν) := fun H hH => by
    simpa only [hν] using hasSum_integral_iUnion hVm hVd hH.integrableOn
  -- The summable majorant: `|∫_{Vⱼ} F_k dν| ≤ ∫_{Vⱼ} b dν`.
  have hbound : ∀ k j, ‖∫ x in V j, F k x ∂ν‖ ≤ ∫ x in V j, b x ∂ν := fun k j =>
    norm_integral_le_of_norm_le hb.integrableOn (ae_restrict_of_ae (hFb k))
  -- Tannery's theorem along `atTop` on `ℕ` (proof of `tendsto_tsum_of_dominated_convergence`).
  have tannery : ∀ (f : ℕ → ℕ → ℝ) (g : ℕ → ℝ) (bound : ℕ → ℝ), Summable bound →
      (∀ j, Tendsto (f · j) atTop (𝓝 (g j))) → (∀ᶠ n in atTop, ∀ j, ‖f n j‖ ≤ bound j) →
      Tendsto (fun n => ∑' j, f n j) atTop (𝓝 (∑' j, g j)) := by
    intro f g bound h_sum hab h_bound
    have h_g_le (k : ℕ) : ‖g k‖ ≤ bound k :=
      le_of_tendsto (tendsto_norm.comp (hab k)) <| h_bound.mono (fun n h => h k)
    have h_sumg : Summable (‖g ·‖) :=
      h_sum.of_norm_bounded (fun k ↦ (norm_norm (g k)).symm ▸ h_g_le k)
    have h_suma : ∀ᶠ n in atTop, Summable (‖f n ·‖) := by
      filter_upwards [h_bound] with n h
      exact h_sum.of_norm_bounded <| by simpa only [norm_norm] using h
    rw [Metric.tendsto_nhds]
    intro ε hε
    let ⟨S, hS⟩ := h_sum
    obtain ⟨T, hT⟩ : ∃ (T : Finset ℕ), dist (∑ i ∈ T, bound i) S < ε / 3 := by
      rw [HasSum, Metric.tendsto_nhds] at hS
      exact Eventually.exists <| hS _ (by positivity)
    have h1 : ∑' (k : (Tᶜ : Set ℕ)), bound k < ε / 3 := by
      calc _ ≤ ‖∑' (k : (Tᶜ : Set ℕ)), bound k‖ := Real.le_norm_self _
           _ = ‖S - ∑ i ∈ T, bound i‖ := congrArg _ ?_
           _ < ε / 3 := by rwa [dist_eq_norm, norm_sub_rev] at hT
      simpa only [h_sum.sum_add_tsum_compl, eq_sub_iff_add_eq'] using hS.tsum_eq
    have h2 : Tendsto (∑ k ∈ T, f · k) atTop (𝓝 (T.sum g)) :=
      tendsto_finsetSum _ (fun i _ ↦ hab i)
    rw [Metric.tendsto_nhds] at h2
    filter_upwards [h2 (ε / 3) (by positivity), h_suma, h_bound] with n hn h_suma h_bound
    rw [dist_eq_norm, ← h_suma.of_norm.tsum_sub h_sumg.of_norm,
      ← (h_suma.of_norm.sub h_sumg.of_norm).sum_add_tsum_compl (s := T),
      (by ring : ε = ε / 3 + (ε / 3 + ε / 3))]
    refine (norm_add_le _ _).trans_lt (add_lt_add ?_ ?_)
    · simpa only [dist_eq_norm, Finset.sum_sub_distrib] using hn
    · rw [(h_suma.subtype _).of_norm.tsum_sub (h_sumg.subtype _).of_norm]
      refine (norm_sub_le _ _).trans_lt (add_lt_add ?_ ?_)
      · refine ((norm_tsum_le_tsum_norm (h_suma.subtype _)).trans ?_).trans_lt h1
        exact (h_suma.subtype _).tsum_le_tsum (h_bound ·) (h_sum.subtype _)
      · refine ((norm_tsum_le_tsum_norm <| h_sumg.subtype _).trans ?_).trans_lt h1
        exact (h_sumg.subtype _).tsum_le_tsum (h_g_le ·) (h_sum.subtype _)
  -- Pass to the limit termwise and identify both sums with the full integrals.
  have hlim' := tannery (fun k j => ∫ x in V j, F k x ∂ν) (fun j => ∫ x in V j, Flim x ∂ν)
    (fun j => ∫ x in V j, b x ∂ν) (hsum b hb).summable hlim (Eventually.of_forall hbound)
  rw [← (hsum Flim hFlim).tsum_eq]
  exact hlim'.congr fun k => (hsum (F k) (hF k)).tsum_eq

/-- Bochner change of variables along an injective Lipschitz chart (Simon Ch. 3, 2.6 for
integrable integrands; used for Ch. 6, 4.5(2)): if `Φ` is Lipschitz and `κ`-antilipschitz on the
open set `Ω`, `A ⊆ Φ(Ω)` is `Hⁿ`-null-measurable and `F` is Banach-valued and `Hⁿ⌞A`-integrable,
then `D = Ω ∩ Φ⁻¹(A)` is `Lⁿ`-null-measurable, `JΦ · (F ∘ Φ)` is `Lⁿ`-integrable on `D` and
`∫_A F dHⁿ = ∫_D JΦ(w) F(Φ(w)) dLⁿ(w)`.  The nonnegative chart formula, valid for every Borel
`g ≥ 0`, says that `Φ` pushes `JΦ · Lⁿ⌞D` forward to `Hⁿ⌞A`. -/
theorem Submission.slicing_im_ll_twl_chart_integral_eq : ∀ (E : Type) [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E] (P n : ℕ) (Φ : Eucl n → Eucl P) (Ω : Set (Eucl n)) (A : Set (Eucl P)) (F : Eucl P → E), IsOpen Ω → (∃ K : ℝ≥0, LipschitzOnWith K Φ Ω) → (∃ κ : ℝ, 0 < κ ∧ ∀ w ∈ Ω, ∀ w' ∈ Ω, κ * ‖w - w'‖ ≤ ‖Φ w - Φ w'‖) → A ⊆ Φ '' Ω → NullMeasurableSet A (μHE[n] : Measure (Eucl P)) → IntegrableOn F A (μHE[n] : Measure (Eucl P)) → NullMeasurableSet (Ω ∩ Φ ⁻¹' A) (volume : Measure (Eucl n)) ∧ IntegrableOn (fun w => Real.sqrt (Matrix.of fun i j => inner ℝ (fderiv ℝ Φ w (EuclideanSpace.single i 1)) (fderiv ℝ Φ w (EuclideanSpace.single j 1))).det • F (Φ w)) (Ω ∩ Φ ⁻¹' A) (volume : Measure (Eucl n)) ∧ ∫ x in A, F x ∂(μHE[n] : Measure (Eucl P)) = ∫ w in Ω ∩ Φ ⁻¹' A, Real.sqrt (Matrix.of fun i j => inner ℝ (fderiv ℝ Φ w (EuclideanSpace.single i 1)) (fderiv ℝ Φ w (EuclideanSpace.single j 1))).det • F (Φ w) ∂(volume : Measure (Eucl n)) := by
  intro E _ _ _ P n Φ Ω A F hΩ hLip hanti hAΩ hA hF
  -- Step 1: the nonnegative chart formula with `g = 0` gives that `D` is null-measurable.
  have hD : NullMeasurableSet (Ω ∩ Φ ⁻¹' A) (volume : Measure (Eucl n)) :=
    (Submission.lpf_raf_chart_change_of_variables P n Φ Ω A (fun _ => 0) hΩ hLip hanti hAΩ hA
      aemeasurable_const).1
  -- Step 2: `Φ` is continuous on the open set `Ω ⊇ D`, hence a.e.-measurable on `D`.
  obtain ⟨K, hK⟩ := hLip
  have hΦ : AEMeasurable Φ ((volume : Measure (Eucl n)).restrict (Ω ∩ Φ ⁻¹' A)) :=
    (hK.continuousOn.aemeasurable hΩ.measurableSet).mono_set inter_subset_left
  -- Steps 3–6: transfer `F` along `Φ` with the weight `JΦ` (Borel, and nonnegative as a square
  -- root), using the nonnegative chart formula for each Borel `g`.
  exact ⟨hD, Submission.slicing_im_ll_twl_cie_weighted_transfer (Eucl n) (Eucl P) E
    ((volume : Measure (Eucl n)).restrict (Ω ∩ Φ ⁻¹' A)) ((μHE[n] : Measure (Eucl P)).restrict A)
    Φ (fun w => Real.sqrt (Matrix.of fun i j => inner ℝ (fderiv ℝ Φ w (EuclideanSpace.single i 1))
      (fderiv ℝ Φ w (EuclideanSpace.single j 1))).det) F hΦ
    (Submission.slicing_im_ll_twl_cie_jacobian_measurable P n Φ).aemeasurable
    (fun _ => Real.sqrt_nonneg _)
    (fun g hg => (Submission.lpf_raf_chart_change_of_variables P n Φ Ω A g hΩ ⟨K, hK⟩ hanti hAΩ
      hA hg.aemeasurable).2.2) hF⟩

/-- Coefficient field on a chart piece (Simon Ch. 6, proof of 4.5(2)): if `Φ` is `C¹`, Lipschitz
and `κ`-antilipschitz on the open `Ω`, `A ⊆ Φ(Ω)` is `Hⁿ`-null-measurable and `Y` is
`Hⁿ ⌞ A`-integrable with `Y(x) ∈ range DΦ(w)` for all `w ∈ Ω ∩ Φ⁻¹(x)`, `Hⁿ`-a.e. `x ∈ A`, then
`c := 1_D Λ(DΦ)(JΦ · Y ∘ Φ)` (`D = Ω ∩ Φ⁻¹(A)`, `Λ` the continuous left inverse) vanishes off
`D`, is `Lⁿ`-integrable (`|c| ≤ κ⁻¹ JΦ |Y ∘ Φ|`) and `DΦ(w) c(w) = JΦ(w) Y(Φ w)` for `Lⁿ`-a.e.
`w ∈ D`. -/
theorem Submission.slicing_im_ll_twl_coefficient_field : ∀ (P n : ℕ) (Φ : Eucl n → Eucl P) (Ω : Set (Eucl n)) (A : Set (Eucl P)) (Y : Eucl P → Eucl P), IsOpen Ω → ContDiff ℝ 1 Φ → (∃ K : ℝ≥0, LipschitzOnWith K Φ Ω) → (∃ κ : ℝ, 0 < κ ∧ ∀ w ∈ Ω, ∀ w' ∈ Ω, κ * ‖w - w'‖ ≤ ‖Φ w - Φ w'‖) → A ⊆ Φ '' Ω → NullMeasurableSet A (μHE[n] : Measure (Eucl P)) → IntegrableOn Y A (μHE[n] : Measure (Eucl P)) → (∀ᵐ x ∂((μHE[n] : Measure (Eucl P)).restrict A), ∀ w ∈ Ω, Φ w = x → Y x ∈ LinearMap.range (fderiv ℝ Φ w).toLinearMap) → ∃ c : Eucl n → Eucl n, IntegrableOn c Ω (volume : Measure (Eucl n)) ∧ (∀ w, w ∉ Ω ∩ Φ ⁻¹' A → c w = 0) ∧ ∀ᵐ w ∂((volume : Measure (Eucl n)).restrict (Ω ∩ Φ ⁻¹' A)), fderiv ℝ Φ w (c w) = Real.sqrt (Matrix.of fun i j => inner ℝ (fderiv ℝ Φ w (EuclideanSpace.single i 1)) (fderiv ℝ Φ w (EuclideanSpace.single j 1))).det • Y (Φ w) := by
  intro P n Φ Ω A Y hΩ hΦ hlip hanti hAΩ hA hY htan
  obtain ⟨κ, hκ, hκanti⟩ := hanti
  -- `Λ(B) B = id` and `‖B Λ(B) v‖ ≤ ‖v‖` for injective `B`, and `Λ` is continuous there.
  obtain ⟨Λ, hΛcont, hΛ⟩ := Submission.lpf_tde_continuous_left_inverse n P
  -- On `Ω`, `κ ‖s‖ ≤ ‖DΦ(w) s‖`: `DΦ(w)` is injective and `‖Λ(DΦ(w)) v‖ ≤ κ⁻¹ ‖v‖`.
  have hlow : ∀ w ∈ Ω, ∀ s, κ * ‖s‖ ≤ ‖fderiv ℝ Φ w s‖ := fun w hw =>
    Submission.lpf_wtc_cat_fderiv_lower_bound P n Φ Ω κ w hΩ hw
      (hΦ.differentiable one_ne_zero w) hκanti
  have hinj : ∀ w ∈ Ω, Function.Injective (fderiv ℝ Φ w) := by
    intro w hw s s' h
    have h1 := hlow w hw (s - s')
    rw [map_sub, h, sub_self, norm_zero] at h1
    have h2 : ‖s - s'‖ ≤ 0 := by
      by_contra h3
      exact absurd h1 (not_le.mpr (mul_pos hκ (lt_of_not_ge h3)))
    exact sub_eq_zero.mp (norm_le_zero_iff.mp h2)
  have hΛle : ∀ w ∈ Ω, ∀ v, ‖Λ (fderiv ℝ Φ w) v‖ ≤ κ⁻¹ * ‖v‖ := fun w hw v =>
    (le_inv_mul_iff₀ hκ).2
      ((hlow w hw (Λ (fderiv ℝ Φ w) v)).trans ((hΛ _ (hinj w hw)).2 v))
  -- `w ↦ Λ(DΦ(w))` is continuous on `Ω`, hence a.e. strongly measurable on `D = Ω ∩ Φ⁻¹(A)`.
  have hΛm : AEStronglyMeasurable (fun w => Λ (fderiv ℝ Φ w))
      ((volume : Measure (Eucl n)).restrict (Ω ∩ Φ ⁻¹' A)) :=
    ((hΛcont.comp (hΦ.continuous_fderiv one_ne_zero).continuousOn fun w hw =>
      hinj w hw).aestronglyMeasurable hΩ.measurableSet).mono_set inter_subset_left
  -- The tangency of `Y` holds at `Φ w` for `Lⁿ`-a.e. `w ∈ D`, and `D` is null-measurable.
  obtain ⟨hDm, hpull⟩ := Submission.lpf_ccr_ae_pullback P n A Φ Ω
    (fun x => ∀ w ∈ Ω, Φ w = x → Y x ∈ LinearMap.range (fderiv ℝ Φ w).toLinearMap)
    hΩ.measurableSet hΦ.continuous.measurable ⟨κ, hκ, hκanti⟩ hA
    (ae_restrict_of_ae_restrict_of_subset inter_subset_left htan)
  -- An integrable `Z` on `D` with `Z(w) ∈ range DΦ(w)` a.e. lifts to `c := 1_D Λ(DΦ) Z`.
  have key : ∀ Z : Eucl n → Eucl P, IntegrableOn Z (Ω ∩ Φ ⁻¹' A) (volume : Measure (Eucl n)) →
      (∀ᵐ w ∂((volume : Measure (Eucl n)).restrict (Ω ∩ Φ ⁻¹' A)),
        Z w ∈ LinearMap.range (fderiv ℝ Φ w).toLinearMap) →
      ∃ c : Eucl n → Eucl n, IntegrableOn c Ω (volume : Measure (Eucl n)) ∧
        (∀ w, w ∉ Ω ∩ Φ ⁻¹' A → c w = 0) ∧
        ∀ᵐ w ∂((volume : Measure (Eucl n)).restrict (Ω ∩ Φ ⁻¹' A)),
          fderiv ℝ Φ w (c w) = Z w := by
    intro Z hZ hZr
    -- `‖Λ(DΦ(w)) Z(w)‖ ≤ κ⁻¹ ‖Z(w)‖` on `D`.
    have hf : IntegrableOn (fun w => Λ (fderiv ℝ Φ w) (Z w)) (Ω ∩ Φ ⁻¹' A)
        (volume : Measure (Eucl n)) := by
      refine Integrable.mono' ((Integrable.norm hZ).const_mul κ⁻¹)
        ((ContinuousLinearMap.id ℝ (Eucl P →L[ℝ] Eucl n)).aestronglyMeasurable_comp₂ hΛm
          hZ.aestronglyMeasurable) ?_
      filter_upwards [ae_restrict_mem₀ hDm] with w hw
      exact hΛle w hw.1 (Z w)
    refine ⟨(Ω ∩ Φ ⁻¹' A).indicator fun w => Λ (fderiv ℝ Φ w) (Z w),
      (hf.integrable_indicator₀ hDm).integrableOn, fun w hw => indicator_of_notMem hw _, ?_⟩
    -- `Z(w) = DΦ(w) t` and `Λ(DΦ(w)) DΦ(w) = id` give `DΦ(w) c(w) = Z(w)`.
    filter_upwards [hZr, ae_restrict_mem₀ hDm] with w hw hwD
    obtain ⟨t, ht⟩ := LinearMap.mem_range.1 hw
    have ht' : fderiv ℝ Φ w t = Z w := ht
    rw [indicator_of_mem hwD]
    show fderiv ℝ Φ w (Λ (fderiv ℝ Φ w) (Z w)) = Z w
    rw [← ht', ← ContinuousLinearMap.comp_apply (Λ (fderiv ℝ Φ w)) (fderiv ℝ Φ w),
      (hΛ _ (hinj w hwD.1)).1, ContinuousLinearMap.id_apply]
  -- By the area formula on the chart, `JΦ · Y ∘ Φ` is integrable on `D`; it is tangent like `Y`.
  obtain ⟨-, hZ, -⟩ := Submission.slicing_im_ll_twl_chart_integral_eq (Eucl P) P n Φ Ω A Y hΩ
    hlip ⟨κ, hκ, hκanti⟩ hAΩ hA hY
  refine key _ hZ ?_
  filter_upwards [hpull, ae_restrict_mem₀ hDm] with w hw hwD
  exact Submodule.smul_mem _ _ (hw w hwD.1 rfl)

/-- Chain rule on a `C¹` chart for a Lipschitz function with a tangential gradient (used for
Simon Ch. 6, §4): if `h` is `L`-Lipschitz and, for `Hⁿ`-a.e. `x ∈ A`, `s ↦ h(x + s u)` has
derivative `⟨G(x), u⟩` at `0` for all `u ∈ range DΦ(w)` with `Φ(w) = x`, then Rademacher's theorem
on `Ω` and uniqueness of derivatives give `D(h ∘ Φ)(w) = ⟨G(Φ(w)), DΦ(w) ·⟩` for `Lⁿ`-a.e.
`w ∈ Ω ∩ Φ⁻¹(A)`. -/
theorem Submission.slicing_im_ll_twl_chart_hasFDerivAt : ∀ (P n : ℕ) (Φ : Eucl n → Eucl P) (Ω : Set (Eucl n)) (A : Set (Eucl P)) (h : Eucl P → ℝ) (L : ℝ≥0) (G : Eucl P → Eucl P), IsOpen Ω → ContDiff ℝ 1 Φ → (∃ K : ℝ≥0, LipschitzOnWith K Φ Ω) → (∃ κ : ℝ, 0 < κ ∧ ∀ w ∈ Ω, ∀ w' ∈ Ω, κ * ‖w - w'‖ ≤ ‖Φ w - Φ w'‖) → NullMeasurableSet A (μHE[n] : Measure (Eucl P)) → LipschitzWith L h → (∀ᵐ x ∂((μHE[n] : Measure (Eucl P)).restrict A), ∀ w ∈ Ω, Φ w = x → ∀ u ∈ LinearMap.range (fderiv ℝ Φ w).toLinearMap, HasDerivAt (fun s : ℝ => h (x + s • u)) (inner ℝ (G x) u) 0) → ∀ᵐ w ∂((volume : Measure (Eucl n)).restrict (Ω ∩ Φ ⁻¹' A)), HasFDerivAt (h ∘ Φ) ((innerSL ℝ (G (Φ w))).comp (fderiv ℝ Φ w)) w := by
  intro P n Φ Ω A h L G hΩ hΦ ⟨K, hK⟩ hanti hA hh hG
  -- The tangential hypothesis at `Φ w` holds for `Lⁿ`-a.e. `w ∈ Ω ∩ Φ⁻¹(A)`.
  obtain ⟨hD, hpull⟩ := Submission.lpf_ccr_ae_pullback P n A Φ Ω
    (fun x => ∀ w ∈ Ω, Φ w = x → ∀ u ∈ LinearMap.range (fderiv ℝ Φ w).toLinearMap,
      HasDerivAt (fun s : ℝ => h (x + s • u)) (inner ℝ (G x) u) 0)
    hΩ.measurableSet hΦ.continuous.measurable hanti hA
    (ae_restrict_of_ae_restrict_of_subset inter_subset_left hG)
  -- Rademacher: `h ∘ Φ` is Lipschitz on the open set `Ω`, so differentiable a.e. in `Ω`.
  have hrad : ∀ᵐ w ∂(volume : Measure (Eucl n)), w ∈ Ω → DifferentiableWithinAt ℝ (h ∘ Φ) Ω w :=
    (hh.comp_lipschitzOnWith hK).ae_differentiableWithinAt_of_mem
  filter_upwards [hpull, ae_restrict_of_ae hrad, ae_restrict_mem₀ hD] with w hpw hdw hwD
  have hdiff : DifferentiableAt ℝ (h ∘ Φ) w := (hdw hwD.1).differentiableAt (hΩ.mem_nhds hwD.1)
  -- Identify `D(h ∘ Φ)(w) s` with `⟨G(Φ w), DΦ(w) s⟩` for every direction `s`.
  have key : fderiv ℝ (h ∘ Φ) w = (innerSL ℝ (G (Φ w))).comp (fderiv ℝ Φ w) := by
    refine ContinuousLinearMap.ext fun s => ?_
    rw [ContinuousLinearMap.comp_apply, innerSL_apply_apply]
    have hline : HasDerivAt (fun t : ℝ => w + t • s) s 0 := by
      simpa using ((hasDerivAt_id (0 : ℝ)).smul_const s).const_add w
    have hΦline : HasDerivAt (fun t : ℝ => Φ (w + t • s)) (fderiv ℝ Φ w s) 0 :=
      ((hΦ.differentiable one_ne_zero) w).hasFDerivAt.comp_hasDerivAt_of_eq (0 : ℝ) hline
        (by simp)
    have hφ₁ : HasDerivAt (fun t : ℝ => h (Φ (w + t • s))) (fderiv ℝ (h ∘ Φ) w s) 0 :=
      hdiff.hasFDerivAt.comp_hasDerivAt_of_eq (0 : ℝ) hline (by simp)
    -- The tangential hypothesis, applied at `w` itself in the direction `DΦ(w) s`.
    have h₁ : HasDerivAt (fun t : ℝ => h (Φ w + t • fderiv ℝ Φ w s))
        (inner ℝ (G (Φ w)) (fderiv ℝ Φ w s)) 0 :=
      hpw w hwD.1 rfl _ ⟨s, rfl⟩
    -- `h(Φ w + t DΦ(w) s)` and `h(Φ(w + t s))` differ by at most `L · o(t)`.
    have h₂ : HasDerivAt (fun t : ℝ => h (Φ w + t • fderiv ℝ Φ w s)) (fderiv ℝ (h ∘ Φ) w s) 0 := by
      rw [hasDerivAt_iff_isLittleO] at hΦline hφ₁ ⊢
      have hO : (fun t : ℝ => h (Φ w + t • fderiv ℝ Φ w s) - h (Φ (w + t • s))) =O[𝓝 0]
          (fun t : ℝ => Φ (w + t • s) - Φ (w + (0 : ℝ) • s) - (t - 0) • fderiv ℝ Φ w s) := by
        refine Asymptotics.IsBigO.of_bound (L : ℝ) (Eventually.of_forall fun t => ?_)
        refine (hh.norm_sub_le _ _).trans_eq ?_
        rw [← norm_neg (Φ w + t • fderiv ℝ Φ w s - Φ (w + t • s))]
        congr 2
        simp only [zero_smul, add_zero, sub_zero]
        abel
      refine (hφ₁.add (hO.trans_isLittleO hΦline)).congr_left fun t => ?_
      simp only [zero_smul, add_zero, sub_zero]
      abel
    exact h₂.unique h₁
  rw [← key]
  exact hdiff.hasFDerivAt

/-- Slicing (Simon Ch. 6, §4), tangential weak limit, step (9a)–(9b): over a chart piece
`A ⊆ Φ(Ω)`, tangential integrals are parameter integrals against one field `c`,
`∫_A Df(Y) dHⁿ = ∫_Ω D(f∘Φ)(c)` and `∫_A ⟨G, Y⟩ dHⁿ = ∫_Ω D(h∘Φ)(c)`.  Here `c` is the
coefficient field (`DΦ(w) c(w) = JΦ(w) Y(Φ(w))` a.e. on `Ω ∩ Φ⁻¹(A)`, `c = 0` off it); both
identities are the chart integral formula combined with the chain rule. -/
theorem Submission.slicing_im_ll_twl_chart_representation : ∀ (P n : ℕ) (Φ : Eucl n → Eucl P) (Ω : Set (Eucl n)) (A : Set (Eucl P)) (h : Eucl P → ℝ) (L : ℝ≥0) (G Y : Eucl P → Eucl P), IsOpen Ω → ContDiff ℝ 1 Φ → (∃ K : ℝ≥0, LipschitzOnWith K Φ Ω) → (∃ κ : ℝ, 0 < κ ∧ ∀ w ∈ Ω, ∀ w' ∈ Ω, κ * ‖w - w'‖ ≤ ‖Φ w - Φ w'‖) → A ⊆ Φ '' Ω → NullMeasurableSet A (μHE[n] : Measure (Eucl P)) → LipschitzWith L h → Measurable G → (∀ x, ‖G x‖ ≤ L) → IntegrableOn Y A (μHE[n] : Measure (Eucl P)) → (∀ᵐ x ∂((μHE[n] : Measure (Eucl P)).restrict A), ∀ w ∈ Ω, Φ w = x → Y x ∈ LinearMap.range (fderiv ℝ Φ w).toLinearMap ∧ ∀ u ∈ LinearMap.range (fderiv ℝ Φ w).toLinearMap, HasDerivAt (fun s : ℝ => h (x + s • u)) (inner ℝ (G x) u) 0) → ∃ c : Eucl n → Eucl n, IntegrableOn c Ω (volume : Measure (Eucl n)) ∧ (∀ (f : Eucl P → ℝ) (K : ℝ≥0), Differentiable ℝ f → LipschitzWith K f → ∫ x in A, fderiv ℝ f x (Y x) ∂(μHE[n] : Measure (Eucl P)) = ∫ w in Ω, fderiv ℝ (f ∘ Φ) w (c w)) ∧ ∫ x in A, inner ℝ (G x) (Y x) ∂(μHE[n] : Measure (Eucl P)) = ∫ w in Ω, fderiv ℝ (h ∘ Φ) w (c w) := by
  intro P n Φ Ω A h L G Y hΩ hΦ hLip hanti hAΦ hA hh hGm hGL hY hae
  -- Step 1: the coefficient field `c`.
  obtain ⟨c, hc, hc0, hcD⟩ := Submission.slicing_im_ll_twl_coefficient_field P n Φ Ω A Y hΩ hΦ
    hLip hanti hAΦ hA hY (hae.mono fun x hx w hw hwx => (hx w hw hwx).1)
  -- Step 2: the differential of `h ∘ Φ` on `Ω ∩ Φ⁻¹(A)`.
  have hhD := Submission.slicing_im_ll_twl_chart_hasFDerivAt P n Φ Ω A h L G hΩ hΦ hLip hanti hA
    hh (hae.mono fun x hx w hw hwx => (hx w hw hwx).2)
  have hΦd : Differentiable ℝ Φ := hΦ.differentiable one_ne_zero
  have hY' : Integrable Y ((μHE[n] : Measure (Eucl P)).restrict A) := hY
  -- Step 3: `c` vanishes off `Ω ∩ Φ⁻¹(A)`, so integrals over `Ω` reduce to it.
  have hred : ∀ g : Eucl n → (Eucl n →L[ℝ] ℝ),
      ∫ w in Ω, g w (c w) = ∫ w in Ω ∩ Φ ⁻¹' A, g w (c w) := fun g =>
    setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hΩ.measurableSet inter_subset_left
      fun w hw => by rw [hc0 w hw.2, map_zero]
  refine ⟨c, hc, fun f K hf hfK => ?_, ?_⟩
  · -- Step 4: identity (i), with `F = Df(Y)`, `|F| ≤ K |Y|`.
    have hF : IntegrableOn (fun x => fderiv ℝ f x (Y x)) A (μHE[n] : Measure (Eucl P)) := by
      refine Integrable.mono' (hY'.norm.const_mul (K : ℝ))
        ((continuous_fst.clm_apply continuous_snd).comp_aestronglyMeasurable₂
          (measurable_fderiv ℝ f).aestronglyMeasurable hY'.aestronglyMeasurable)
        (Eventually.of_forall fun x => ?_)
      calc ‖fderiv ℝ f x (Y x)‖ ≤ ‖fderiv ℝ f x‖ * ‖Y x‖ := (fderiv ℝ f x).le_opNorm (Y x)
        _ ≤ K * ‖Y x‖ :=
          mul_le_mul_of_nonneg_right (norm_fderiv_le_of_lipschitz ℝ hfK) (norm_nonneg _)
    rw [(Submission.slicing_im_ll_twl_chart_integral_eq ℝ P n Φ Ω A _ hΩ hLip hanti hAΦ hA
      hF).2.2, hred (fderiv ℝ (f ∘ Φ))]
    refine integral_congr_ae ?_
    filter_upwards [hcD] with w hw
    rw [fderiv_comp w (hf (Φ w)) (hΦd w), ContinuousLinearMap.comp_apply, hw, map_smul]
  · -- Step 5: identity (ii), with `F = ⟨G, Y⟩`, `|F| ≤ L |Y|`.
    have hF : IntegrableOn (fun x => inner ℝ (G x) (Y x)) A (μHE[n] : Measure (Eucl P)) := by
      refine Integrable.mono' (hY'.norm.const_mul (L : ℝ))
        (continuous_inner.comp_aestronglyMeasurable₂ hGm.aestronglyMeasurable
          hY'.aestronglyMeasurable)
        (Eventually.of_forall fun x => ?_)
      calc ‖inner ℝ (G x) (Y x)‖ ≤ ‖G x‖ * ‖Y x‖ := norm_inner_le_norm _ _
        _ ≤ L * ‖Y x‖ := mul_le_mul_of_nonneg_right (hGL x) (norm_nonneg _)
    rw [(Submission.slicing_im_ll_twl_chart_integral_eq ℝ P n Φ Ω A _ hΩ hLip hanti hAΦ hA
      hF).2.2, hred (fderiv ℝ (h ∘ Φ))]
    refine integral_congr_ae ?_
    filter_upwards [hcD, hhD] with w hw hw'
    rw [hw'.fderiv, ContinuousLinearMap.comp_apply, hw, innerSL_apply_apply,
      real_inner_smul_right, smul_eq_mul]

/-- **Lipschitz bound, in the field, for the pairing `∫_Ω Df(b)`.**  If `f` is `C`-Lipschitz on
the open set `Ω ⊆ ℝⁿ` and `b, b'` are integrable on `Ω`, then
`|∫_Ω Df(b) − ∫_Ω Df(b')| ≤ C ∫_Ω |b − b'|`, where `Df(w) = fderiv ℝ f w` (`0` where `f` is not
differentiable).  On `Ω` we have `‖Df(w)‖ ≤ C`, so `w ↦ Df(w)(v(w))` is dominated by `C |v|`; it
is a.e. strongly measurable because `Df` is Borel, hence integrable for `v = b, b'`, and the
estimate follows by linearity of the integral and of `Df(w)`. -/
theorem Submission.slicing_im_ll_gws_pairing_bound :
    ∀ (n : ℕ) (Ω : Set (Eucl n)) (C : ℝ≥0) (f : Eucl n → ℝ), IsOpen Ω → LipschitzOnWith C f Ω →
      ∀ b b' : Eucl n → Eucl n, IntegrableOn b Ω (volume : Measure (Eucl n)) →
        IntegrableOn b' Ω (volume : Measure (Eucl n)) →
        |(∫ w in Ω, fderiv ℝ f w (b w)) - ∫ w in Ω, fderiv ℝ f w (b' w)| ≤
          C * ∫ w in Ω, ‖b w - b' w‖ := by
  intro n Ω C f hΩ hf b b' hb hb'
  -- `Ω` is a neighbourhood of each of its points, so `‖Df(w)‖ ≤ C` on `Ω`.
  have hD : ∀ w ∈ Ω, ‖fderiv ℝ f w‖ ≤ C := fun w hw =>
    norm_fderiv_le_of_lipschitzOn ℝ (hΩ.mem_nhds hw) hf
  -- Hence `|Df(w)(v(w))| ≤ C |v(w)|` for a.e. `w ∈ Ω`, for every field `v`.
  have hle : ∀ v : Eucl n → Eucl n,
      ∀ᵐ w ∂(volume : Measure (Eucl n)).restrict Ω, ‖fderiv ℝ f w (v w)‖ ≤ C * ‖v w‖ := by
    intro v
    refine (ae_restrict_iff' hΩ.measurableSet).2 (Eventually.of_forall fun w hw => ?_)
    exact (fderiv ℝ f w).le_of_opNorm_le (hD w hw) (v w)
  -- `w ↦ Df(w)(v(w))` is integrable on `Ω` when `v` is: it is a.e. strongly measurable
  -- (`Df` is Borel) and dominated by `C |v|`.
  have hint : ∀ v : Eucl n → Eucl n, IntegrableOn v Ω volume →
      IntegrableOn (fun w => fderiv ℝ f w (v w)) Ω volume := fun v hv =>
    (hv.norm.const_mul C).mono' ((ContinuousLinearMap.apply ℝ ℝ).aestronglyMeasurable_comp₂
      hv.aestronglyMeasurable (measurable_fderiv ℝ f).aestronglyMeasurable) (hle v)
  -- Combine the integrals by linearity, then estimate.
  rw [← integral_sub (hint b hb) (hint b' hb')]
  simp_rw [← map_sub]
  rw [← Real.norm_eq_abs, ← integral_const_mul]
  exact norm_integral_le_of_norm_le ((hb.sub hb').norm.const_mul C) (hle (b - b'))

/-- **Integration by parts against a `C¹` field, for functions Lipschitz on `Ω`.**  Let `Ω ⊆ ℝⁿ`
be open and `b : ℝⁿ → ℝⁿ` be `C¹` with compact support and `tsupport b ⊆ Ω`.  The divergence
`g = ∑ᵢ Dbᵢ(·)(eᵢ)` of `b` is integrable, and for every `f` that is `L`-Lipschitz on `Ω`, `f g` is
integrable on `Ω` and `∫_Ω Df(b) = −∫_Ω f g`, where `Df(w) = fderiv ℝ f w` (`0` where `f` is not
differentiable).  Extend `f` to an `L`-Lipschitz `F` on `ℝⁿ` (McShane); `DF = Df` on the open set
`Ω` and `b, g` vanish off `Ω`, so both sides are integrals over `ℝⁿ` with `F` in place of `f`.
Expand `b = ∑ᵢ bᵢ eᵢ`: by Rademacher's theorem `DF(w)(eᵢ)` is the line derivative of `F` along
`eᵢ` for a.e. `w`, and integration by parts for Lipschitz functions moves it onto the compactly
supported Lipschitz coordinate `bᵢ`. -/
theorem Submission.slicing_im_ll_gws_lipschitz_ibp :
    ∀ (n : ℕ) (Ω : Set (Eucl n)) (b : Eucl n → Eucl n), IsOpen Ω → ContDiff ℝ 1 b →
      HasCompactSupport b → tsupport b ⊆ Ω → ∃ g : Eucl n → ℝ,
        Integrable g (volume : Measure (Eucl n)) ∧
        ∀ (L : ℝ≥0) (f : Eucl n → ℝ), LipschitzOnWith L f Ω →
          IntegrableOn (fun w => f w * g w) Ω (volume : Measure (Eucl n)) ∧
          ∫ w in Ω, fderiv ℝ f w (b w) = -∫ w in Ω, f w * g w := by
  intro n Ω b hΩ hb hbc hbΩ
  classical
  -- Coordinates `bᵢ` of `b`: `C¹` with compact support, hence Lipschitz; `Dbᵢ = 0` off
  -- `tsupport b`.
  let e : Fin n → Eucl n := fun i => EuclideanSpace.single i 1
  let bi : Fin n → Eucl n → ℝ := fun i x => EuclideanSpace.proj i (b x)
  have hbi_cd : ∀ i, ContDiff ℝ 1 (bi i) := fun i =>
    (EuclideanSpace.proj i : StrongDual ℝ (Eucl n)).contDiff.comp hb
  have hbi_cs : ∀ i, HasCompactSupport (bi i) := fun i =>
    hbc.comp_left (g := fun y => EuclideanSpace.proj i y) (map_zero _)
  have hbi_ts : ∀ i, tsupport (bi i) ⊆ tsupport b := fun i =>
    tsupport_comp_subset (g := fun y => EuclideanSpace.proj i y) (map_zero _) b
  have hbi_lip : ∀ i, ∃ D, LipschitzWith D (bi i) := fun i =>
    ContDiff.lipschitzWith_of_hasCompactSupport (hbi_cs i) (hbi_cd i) one_ne_zero
  have hbi_diff : ∀ i, Differentiable ℝ (bi i) := fun i => (hbi_cd i).differentiable one_ne_zero
  have hbi_cfd : ∀ i, Continuous (fderiv ℝ (bi i)) := fun i =>
    (hbi_cd i).continuous_fderiv one_ne_zero
  have hDbi_zero : ∀ i w, w ∉ tsupport b → fderiv ℝ (bi i) w = 0 := fun i w hw =>
    image_eq_zero_of_notMem_tsupport fun h => hw (hbi_ts i (tsupport_fderiv_subset ℝ h))
  -- The divergence `g = ∑ᵢ Dbᵢ(·)(eᵢ)` is continuous and vanishes off `tsupport b`, so it has
  -- compact support and is integrable.  It does not depend on `L` or `f`.
  let g : Eucl n → ℝ := fun w => ∑ i, fderiv ℝ (bi i) w (e i)
  have hg_cont : Continuous g :=
    continuous_finsetSum _ fun i _ => (hbi_cfd i).clm_apply continuous_const
  have hg_zero : ∀ w, w ∉ tsupport b → g w = 0 := fun w hw =>
    Finset.sum_eq_zero fun i _ => by simp [hDbi_zero i w hw]
  have hg_cs : HasCompactSupport g := HasCompactSupport.intro hbc hg_zero
  refine ⟨g, hg_cont.integrable_of_hasCompactSupport hg_cs, fun L f hf => ?_⟩
  -- McShane: `F` is `L`-Lipschitz on `ℝⁿ` and `F = f` on `Ω`, so `DF = Df` on the open set `Ω`.
  obtain ⟨F, hF, hfF⟩ := hf.extend_real
  have hDf : ∀ w ∈ Ω, fderiv ℝ f w = fderiv ℝ F w := fun w hw =>
    Filter.EventuallyEq.fderiv_eq (Filter.eventuallyEq_of_mem (hΩ.mem_nhds hw) hfF)
  -- (a): `F g` is continuous with compact support, and `f g = F g` on `Ω`.
  have hFg_int : Integrable (fun w => F w * g w) volume :=
    (hF.continuous.mul hg_cont).integrable_of_hasCompactSupport (hg_cs.mul_left (f := F))
  refine ⟨hFg_int.integrableOn.congr_fun (fun w hw => by simp [hfF hw]) hΩ.measurableSet, ?_⟩
  -- (b) reduces to `∫ DF(b) = −∫ F g` over `ℝⁿ`, as `b` and `g` vanish off `Ω`.
  have h1 : ∫ w in Ω, fderiv ℝ f w (b w) = ∫ w, fderiv ℝ F w (b w) := by
    rw [setIntegral_congr_fun hΩ.measurableSet (g := fun w => fderiv ℝ F w (b w))
      (fun w hw => by simp only [hDf w hw])]
    refine setIntegral_eq_integral_of_forall_compl_eq_zero fun w hw => ?_
    simp [image_eq_zero_of_notMem_tsupport fun h => hw (hbΩ h)]
  have h2 : ∫ w in Ω, f w * g w = ∫ w, F w * g w := by
    rw [setIntegral_congr_fun hΩ.measurableSet (g := fun w => F w * g w)
      (fun w hw => by simp only [hfF hw])]
    refine setIntegral_eq_integral_of_forall_compl_eq_zero fun w hw => ?_
    simp [hg_zero w fun h => hw (hbΩ h)]
  rw [h1, h2]
  -- Expand `b = ∑ᵢ bᵢ eᵢ`; each term `DF(·)(eᵢ) bᵢ` is integrable, as `‖DF‖ ≤ L` and `bᵢ` is
  -- continuous with compact support.
  have hexp : ∀ w, fderiv ℝ F w (b w) = ∑ i, fderiv ℝ F w (e i) * bi i w := by
    intro w
    conv_lhs => rw [← (EuclideanSpace.basisFun (Fin n) ℝ).sum_repr (b w)]
    simp [map_sum, map_smul, EuclideanSpace.basisFun_apply, mul_comm, e, bi]
  have hterm_int : ∀ i, Integrable (fun w => fderiv ℝ F w (e i) * bi i w) volume := by
    intro i
    refine Integrable.bdd_mul (c := L * ‖e i‖)
      ((hbi_cd i).continuous.integrable_of_hasCompactSupport (hbi_cs i))
      (measurable_fderiv_apply_const ℝ F (e i)).aestronglyMeasurable ?_
    filter_upwards with w
    exact (ContinuousLinearMap.le_opNorm _ _).trans
      (mul_le_mul_of_nonneg_right (norm_fderiv_le_of_lipschitz ℝ hF) (norm_nonneg _))
  -- Rademacher (`DF(w)(eᵢ) = ∂_{eᵢ}F(w)` a.e.) and integration by parts for Lipschitz functions.
  have hibp : ∀ i, ∫ w, fderiv ℝ F w (e i) * bi i w
      = -∫ w, fderiv ℝ (bi i) w (e i) * F w := by
    intro i
    obtain ⟨D, hD⟩ := hbi_lip i
    have hae : (fun w => fderiv ℝ F w (e i) * bi i w)
        =ᵐ[volume] (fun w => lineDeriv ℝ F w (e i) * bi i w) := by
      filter_upwards [hF.ae_differentiableAt (μ := volume)] with w hw
      rw [hw.lineDeriv_eq_fderiv]
    rw [integral_congr_ae hae, hF.integral_lineDeriv_mul_eq hD (hbi_cs i) (e i), ← integral_neg]
    congr 1
    ext w
    rw [((hbi_diff i) w).lineDeriv_eq_fderiv]
    simp
  -- Sum over `i`; each `Dbᵢ(·)(eᵢ) F` is continuous and vanishes off the compact `tsupport b`.
  have hterm2_int : ∀ i, Integrable (fun w => fderiv ℝ (bi i) w (e i) * F w) volume := by
    intro i
    refine (((hbi_cfd i).clm_apply continuous_const).mul
      hF.continuous).integrable_of_hasCompactSupport (HasCompactSupport.intro hbc fun w hw => ?_)
    simp [hDbi_zero i w hw]
  calc ∫ w, fderiv ℝ F w (b w) = ∫ w, ∑ i, fderiv ℝ F w (e i) * bi i w := by
        simp_rw [hexp]
    _ = ∑ i, ∫ w, fderiv ℝ F w (e i) * bi i w :=
        integral_finsetSum _ fun i _ => hterm_int i
    _ = ∑ i, -∫ w, fderiv ℝ (bi i) w (e i) * F w :=
        Finset.sum_congr rfl fun i _ => hibp i
    _ = -∫ w, ∑ i, fderiv ℝ (bi i) w (e i) * F w := by
        rw [integral_finsetSum _ fun i _ => hterm2_int i, Finset.sum_neg_distrib]
    _ = -∫ w, F w * g w := by
        congr 1
        refine integral_congr_ae (Eventually.of_forall fun w => ?_)
        simp [g, Finset.mul_sum, mul_comm]

/-- Convergence of the gradient pairings against a `C¹` test field: if `u_k → u` uniformly on
the open set `Ω`, all `C`-Lipschitz on `Ω`, and `b` is `C¹` with compact support in `Ω`, then
`∫_Ω Du_k(b) → ∫_Ω Du(b)`.  With the weak divergence `g ∈ L¹` of `b` given by
`slicing_im_ll_gws_lipschitz_ibp`, `∫_Ω Du_k(b) - ∫_Ω Du(b) = ∫_Ω (u - u_k) g`, which is at most
`sup_Ω |u - u_k| · ∫_Ω |g|`. -/
theorem Submission.slicing_im_ll_gws_smooth_tendsto : ∀ (n : ℕ) (Ω : Set (Eucl n)) (C : ℝ≥0) (u : Eucl n → ℝ) (ug : ℕ → Eucl n → ℝ), IsOpen Ω → LipschitzOnWith C u Ω → (∀ k, LipschitzOnWith C (ug k) Ω) → TendstoUniformlyOn ug u atTop Ω → ∀ b : Eucl n → Eucl n, ContDiff ℝ 1 b → HasCompactSupport b → tsupport b ⊆ Ω → Tendsto (fun k => ∫ w in Ω, fderiv ℝ (ug k) w (b w)) atTop (𝓝 (∫ w in Ω, fderiv ℝ u w (b w))) := by
  intro n Ω C u ug hΩ hu hug hconv b hb hbc hbΩ
  -- Step 1: the weak divergence `g` of `b`, applied to `u` and to every `u_k` (all
  -- `C`-Lipschitz on `Ω`).
  obtain ⟨g, hg, hgf⟩ := Submission.slicing_im_ll_gws_lipschitz_ibp n Ω b hΩ hb hbc hbΩ
  obtain ⟨hu_int, hu_eq⟩ := hgf C u hu
  -- Step 2: `∫_Ω Du_k(b) - ∫_Ω Du(b) = -∫_Ω u_k g + ∫_Ω u g = ∫_Ω (u - u_k) g`.
  have hdiff : ∀ k, (∫ w in Ω, fderiv ℝ (ug k) w (b w)) - ∫ w in Ω, fderiv ℝ u w (b w) =
      ∫ w in Ω, (u w - ug k w) * g w := fun k => by
    obtain ⟨hk_int, hk_eq⟩ := hgf C (ug k) (hug k)
    simp only [sub_mul]
    rw [hk_eq, hu_eq, integral_sub hu_int hk_int]
    ring
  -- Step 3: `A = ∫_Ω |g| ≥ 0`, `η = ε / (2 (A + 1))`, and `N` with `|u - u_k| < η` on `Ω` for
  -- all `k ≥ N` (uniform convergence).
  obtain ⟨A, hA⟩ : ∃ A, ∫ w in Ω, |g w| = A := ⟨_, rfl⟩
  have hA0 : 0 ≤ A := by
    rw [← hA]
    exact integral_nonneg fun w => abs_nonneg (g w)
  refine Metric.tendsto_atTop.2 fun ε hε => ?_
  have hA1 : 0 < 2 * (A + 1) := by linarith
  have hη : 0 < ε / (2 * (A + 1)) := div_pos hε hA1
  obtain ⟨N, hN⟩ := eventually_atTop.1 (Metric.tendstoUniformlyOn_iff.1 hconv _ hη)
  refine ⟨N, fun k hk => ?_⟩
  -- Step 4: `|∫_Ω (u - u_k) g| ≤ ∫_Ω η |g| = η A`.
  have hbound : ∀ w ∈ Ω, ‖(u w - ug k w) * g w‖ ≤ ε / (2 * (A + 1)) * |g w| := fun w hw => by
    rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, ← Real.dist_eq]
    exact mul_le_mul_of_nonneg_right (hN k hk w hw).le (abs_nonneg (g w))
  have hest : ‖∫ w in Ω, (u w - ug k w) * g w‖ ≤ ∫ w in Ω, ε / (2 * (A + 1)) * |g w| :=
    norm_integral_le_of_norm_le (hg.integrableOn.abs.const_mul _)
      (ae_restrict_of_forall_mem hΩ.measurableSet hbound)
  rw [integral_const_mul, hA] at hest
  -- Step 5: `η A < η · 2 (A + 1) = ε`.
  rw [Real.dist_eq, hdiff k, ← Real.norm_eq_abs]
  calc ‖∫ w in Ω, (u w - ug k w) * g w‖ ≤ ε / (2 * (A + 1)) * A := hest
    _ < ε / (2 * (A + 1)) * (2 * (A + 1)) := mul_lt_mul_of_pos_left (by linarith) hη
    _ = ε := div_mul_cancel₀ ε hA1.ne'

/-- Local finiteness for an integer series of currents `∑ c_r τ(M_r, θ_r, ξ_r)` (Simon Ch. 6, 3.13,
used for `R^(ℓ)`, `S^(ℓ)` in the proof of 7.2): with `Θ = ∑' r, |c_r| 1_{M_r} θ_r` and
`∑' r, |c_r| ∫_{M_r ∩ W} θ_r dHⁿ < ∞` for each `W ⊂⊂ U`, `Θ` is locally `Hⁿ`-integrable in `U`
and `Hⁿ`-a.e. `x` lies in `M_r` for only finitely many `r` with `c_r ≠ 0`.  Termwise integration
(`lintegral_tsum`) gives `∫_W Θ dHⁿ < ∞` on each `W ⊂⊂ U`, so `Θ < ∞` a.e. near each point of
`U`, hence a.e. on `U` (`ℝ^P` is second countable); at such `x` each such `r` adds at least `1`
to `Θ(x)`, and off `U` no `M_r` contains `x`. -/
theorem Submission.fiw_ims_overlap_finite :
    ∀ (P n : ℕ) (U : Set (Eucl P)), IsOpen U →
      ∀ (M : ℕ → Set (Eucl P)) (θ : ℕ → Eucl P → ℝ) (c : ℕ → ℤ), (∀ r, M r ⊆ U) →
        (∀ r, NullMeasurableSet (M r) (μHE[n] : Measure (Eucl P))) →
        (∀ r, ∀ K : Set (Eucl P), IsCompact K → K ⊆ U →
          IntegrableOn (θ r) (M r ∩ K) (μHE[n] : Measure (Eucl P))) →
        (∀ r, ∀ x ∈ M r, 1 ≤ θ r x) →
        (∀ W, CompactlyContainedOpen W U →
          (∑' r, ((c r).natAbs : ℝ≥0∞) *
            ∫⁻ x in M r ∩ W, ENNReal.ofReal (θ r x) ∂(μHE[n] : Measure (Eucl P))) < ∞) →
        (∀ K : Set (Eucl P), IsCompact K → K ⊆ U →
          (∫⁻ x in K, ∑' r, ((c r).natAbs : ℝ≥0∞) *
            (M r).indicator (fun y => ENNReal.ofReal (θ r y)) x
              ∂(μHE[n] : Measure (Eucl P))) < ∞) ∧
        ∀ᵐ x ∂(μHE[n] : Measure (Eucl P)), {r | c r ≠ 0 ∧ x ∈ M r}.Finite := by
  intro P n U hU M θ c hMU hMnull hint hθ1 hsum
  set H : Measure (Eucl P) := (μHE[n] : Measure (Eucl P))
  -- `g r = |c_r| 1_{M_r} θ_r` and `Θ = ∑' r, g r`.
  set g : ℕ → Eucl P → ℝ≥0∞ := fun r x =>
    ((c r).natAbs : ℝ≥0∞) * (M r).indicator (fun y => ENNReal.ofReal (θ r y)) x with hg
  set Θ : Eucl P → ℝ≥0∞ := fun x => ∑' r, g r x with hΘ
  -- Steps 1–2: on `W ⊂⊂ U` every `g r` is a.e.-measurable (`θ_r` is integrable on
  -- `M_r ∩ closure W`), so `∫_W Θ = ∑' r, |c_r| ∫_{M_r ∩ W} θ_r < ∞`.
  have hW : ∀ W, CompactlyContainedOpen W U →
      AEMeasurable Θ (H.restrict W) ∧ ∫⁻ x in W, Θ x ∂H < ∞ := by
    intro W hWcc
    obtain ⟨hWo, hWc, hWU⟩ := hWcc
    have hnull : ∀ r, NullMeasurableSet (M r) (H.restrict W) := fun r =>
      (hMnull r).mono Measure.restrict_le_self
    have hterm : ∀ r, AEMeasurable (g r) (H.restrict W) := by
      intro r
      have hi : IntegrableOn (θ r) (M r ∩ W) H :=
        (hint r _ hWc hWU).mono_set (inter_subset_inter_right _ subset_closure)
      have hmeas : AEMeasurable (fun y => ENNReal.ofReal (θ r y))
          ((H.restrict W).restrict (M r)) := by
        rw [Measure.restrict_restrict' hWo.measurableSet]
        exact hi.aestronglyMeasurable.aemeasurable.ennreal_ofReal
      exact ((aemeasurable_indicator_iff₀ (hnull r)).2 hmeas).const_mul _
    refine ⟨AEMeasurable.tsum hterm, ?_⟩
    have hEq : ∫⁻ x in W, Θ x ∂H =
        ∑' r, ((c r).natAbs : ℝ≥0∞) * ∫⁻ x in M r ∩ W, ENNReal.ofReal (θ r x) ∂H := by
      rw [hΘ, lintegral_tsum hterm]
      refine tsum_congr fun r => ?_
      rw [hg, lintegral_const_mul' _ _ (ENNReal.natCast_ne_top _), lintegral_indicator₀ (hnull r),
        Measure.restrict_restrict' hWo.measurableSet]
    rw [hEq]
    exact hsum W ⟨hWo, hWc, hWU⟩
  -- Every compact `K ⊆ U` lies in some `W ⊂⊂ U`.
  have hcover : ∀ K : Set (Eucl P), IsCompact K → K ⊆ U →
      ∃ W, CompactlyContainedOpen W U ∧ K ⊆ W := by
    intro K hK hKU
    obtain ⟨W, hWo, hKW, hWU, hWc⟩ := exists_open_between_and_isCompact_closure hK hU hKU
    exact ⟨W, ⟨hWo, hWc, hWU⟩, hKW⟩
  -- Step 3: conclusion (a), as `∫_K Θ ≤ ∫_W Θ` for `K ⊆ W ⊂⊂ U`.
  refine ⟨fun K hK hKU => ?_, ?_⟩
  · obtain ⟨W, hWcc, hKW⟩ := hcover K hK hKU
    exact (lintegral_mono_set hKW).trans_lt (hW W hWcc).2
  -- Step 4: `N = {x ∈ U | Θ x = ∞}` is null: each `x ∈ U` has a neighbourhood `W ⊂⊂ U` on which
  -- `Θ < ∞` a.e., and `ℝ^P` is second countable.
  set N : Set (Eucl P) := {x | x ∈ U ∧ Θ x = ∞}
  have hN0 : H N = 0 := by
    refine measure_null_of_locally_null N fun x hx => ?_
    obtain ⟨W, hWcc, hxW⟩ := hcover {x} isCompact_singleton (singleton_subset_iff.2 hx.1)
    obtain ⟨hmeas, hfin⟩ := hW W hWcc
    have hae : ∀ᵐ y ∂H, y ∈ W → Θ y < ∞ :=
      (ae_restrict_iff' hWcc.1.measurableSet).1 (ae_lt_top' hmeas hfin.ne)
    refine ⟨N ∩ W, inter_mem_nhdsWithin N (hWcc.1.mem_nhds (hxW rfl)), ?_⟩
    refine measure_mono_null (fun y hy => ?_) (ae_iff.1 hae)
    simp only [mem_ofPred_eq, not_imp, not_lt, top_le_iff]
    exact ⟨hy.2, hy.1.2⟩
  -- Step 5: conclusion (b).  For `x ∈ U \ N`, every `r` with `c_r ≠ 0` and `x ∈ M_r` has
  -- `g r x ≥ 1` while `∑' r, g r x < ∞`; for `x ∉ U` no `M_r` contains `x`.
  filter_upwards [measure_eq_zero_iff_ae_notMem.1 hN0] with x hxN
  by_cases hxU : x ∈ U
  · have hΘx : Θ x ≠ ∞ := fun h => hxN ⟨hxU, h⟩
    refine (ENNReal.finite_const_le_of_tsum_ne_top hΘx one_ne_zero).subset ?_
    rintro r ⟨hc, hxM⟩
    have h1 : (1 : ℝ≥0∞) ≤ ((c r).natAbs : ℝ≥0∞) := by
      exact_mod_cast Int.natAbs_pos.2 hc
    have h2 : (1 : ℝ≥0∞) ≤ (M r).indicator (fun y => ENNReal.ofReal (θ r y)) x := by
      rw [indicator_of_mem hxM]
      simpa using ENNReal.ofReal_le_ofReal (hθ1 r x hxM)
    simpa [hg] using mul_le_mul' h1 h2
  · exact finite_empty.subset fun r hr => hxU (hMU r hr.2)

/-- One term of Simon Ch. 6, 3.1 (‡): for a rectifiable triple `(M, θ, ξ)` in `U`, an open
`W ⊂⊂ U` and a continuous `n`-form `ω` with `tsupport ω ⊆ W` and `‖ω(x)‖ ≤ B`, the integrand
`1_M θ ⟨ω, ξ⟩` is `Hⁿ`-a.e. strongly measurable and `∫ |1_M θ ⟨ω, ξ⟩| dHⁿ ≤ B ∫_{M ∩ W} θ dHⁿ`,
since `|⟨ω(x), ξ(x)⟩| ≤ ‖ω(x)‖` for `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ` (`Submission.fiw_ims_tt_unit_bound`). -/
theorem Submission.fiw_ims_tt_term_bound :
    ∀ (P n : ℕ) (U W M : Set (Eucl P)) (θ : Eucl P → ℝ) (ξ : Eucl P → NVector (Eucl P) n)
      (ω : Eucl P → Covector (Eucl P) n) (B : ℝ), IsRectifiableTriple U n M θ ξ →
      CompactlyContainedOpen W U → Continuous ω → tsupport ω ⊆ W → (∀ x, ‖ω x‖ ≤ B) →
      AEStronglyMeasurable (M.indicator fun x => θ x * ξ x (ω x)) (μHE[n] : Measure (Eucl P)) ∧
      ∫⁻ x, ‖M.indicator (fun y => θ y * ξ y (ω y)) x‖ₑ ∂(μHE[n] : Measure (Eucl P)) ≤
        ENNReal.ofReal B * ∫⁻ x in M ∩ W, ENNReal.ofReal (θ x) ∂(μHE[n] : Measure (Eucl P)) := by
  intro P n U W M θ ξ ω B htri hW hω hωW hB
  obtain ⟨hWo, hLc, hLU⟩ := hW
  set g : Eucl P → ℝ := fun x => θ x * ξ x (ω x)
  -- `g` vanishes off `tsupport ω ⊆ W`.
  have hg0 : ∀ x, x ∉ W → g x = 0 := by
    intro x hx
    have hωx : ω x = 0 := image_eq_zero_of_notMem_tsupport fun h => hx (hωW h)
    show θ x * ξ x (ω x) = 0
    rw [hωx, map_zero, mul_zero]
  have hML : NullMeasurableSet (M ∩ closure W) (μHE[n] : Measure (Eucl P)) :=
    htri.nullMeasurableSet.inter isClosed_closure.measurableSet.nullMeasurableSet
  have hMW : NullMeasurableSet (M ∩ W) (μHE[n] : Measure (Eucl P)) :=
    htri.nullMeasurableSet.inter hWo.measurableSet.nullMeasurableSet
  -- Hence `1_M g = 1_{M ∩ closure W} g`.
  have hG : M.indicator g = (M ∩ closure W).indicator g := by
    funext x
    by_cases hxL : x ∈ closure W
    · by_cases hxM : x ∈ M <;> simp [Set.indicator, hxL, hxM]
    · simp [Set.indicator, hxL, hg0 x fun hxW => hxL (subset_closure hxW)]
  refine ⟨?_, ?_⟩
  · -- On `M ∩ closure W`: `θ` is integrable (`closure W` is a compact subset of `U`), `ξ` is
    -- measurable (restricted from `M`), `ω` is continuous, and `(v, α) ↦ v α` is continuous.
    have hθ : AEStronglyMeasurable θ ((μHE[n] : Measure (Eucl P)).restrict (M ∩ closure W)) :=
      (htri.integrableOn (closure W) hLc hLU).aestronglyMeasurable
    have hξ : AEStronglyMeasurable ξ ((μHE[n] : Measure (Eucl P)).restrict (M ∩ closure W)) :=
      htri.aestronglyMeasurable.mono_measure (Measure.restrict_mono inter_subset_left le_rfl)
    have hev : Continuous fun p : NVector (Eucl P) n × Covector (Eucl P) n => p.1 p.2 :=
      isBoundedBilinearMap_apply.continuous
    rw [hG, aestronglyMeasurable_indicator_iff₀ hML]
    exact hθ.mul (hev.comp_aestronglyMeasurable (hξ.prodMk hω.aestronglyMeasurable))
  · -- `Hⁿ`-a.e. `|1_M g| ≤ 1_{M ∩ W} B θ`: on `M ∩ W`, `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ` with `τ`
    -- orthonormal, so `|ξ(x)(ω(x))| ≤ ‖ω(x)‖ ≤ B`; elsewhere `1_M g` vanishes.
    have hae : ∀ᵐ x ∂(μHE[n] : Measure (Eucl P)), ‖M.indicator g x‖ₑ ≤
        (M ∩ W).indicator (fun y => ENNReal.ofReal B * ENNReal.ofReal (θ y)) x := by
      filter_upwards [(ae_restrict_iff'₀ htri.nullMeasurableSet).1 htri.orients] with x hx
      by_cases hxM : x ∈ M
      · by_cases hxW : x ∈ W
        · obtain ⟨τ, hτ, -, hξx⟩ := hx hxM
          have hθx : 0 < θ x := htri.pos x hxM
          have hB0 : 0 ≤ B := (norm_nonneg _).trans (hB x)
          have hub : |ξ x (ω x)| ≤ B :=
            (Submission.fiw_ims_tt_unit_bound P n τ (ξ x) hτ hξx (ω x)).trans (hB x)
          rw [Set.indicator_of_mem hxM, Set.indicator_of_mem (show x ∈ M ∩ W from ⟨hxM, hxW⟩)]
          show ‖θ x * ξ x (ω x)‖ₑ ≤ ENNReal.ofReal B * ENNReal.ofReal (θ x)
          rw [Real.enorm_eq_ofReal_abs, ← ENNReal.ofReal_mul hB0, abs_mul, abs_of_pos hθx,
            mul_comm B]
          exact ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hub hθx.le)
        · simp [Set.indicator_of_mem hxM, hg0 x hxW]
      · simp [Set.indicator_of_notMem hxM]
    calc ∫⁻ x, ‖M.indicator g x‖ₑ ∂(μHE[n] : Measure (Eucl P))
        ≤ ∫⁻ x, (M ∩ W).indicator (fun y => ENNReal.ofReal B * ENNReal.ofReal (θ y)) x
            ∂(μHE[n] : Measure (Eucl P)) := lintegral_mono_ae hae
      _ = ∫⁻ x in M ∩ W, ENNReal.ofReal B * ENNReal.ofReal (θ x) ∂(μHE[n] : Measure (Eucl P)) :=
          lintegral_indicator₀ hMW _
      _ = ENNReal.ofReal B * ∫⁻ x in M ∩ W, ENNReal.ofReal (θ x) ∂(μHE[n] : Measure (Eucl P)) :=
          lintegral_const_mul' _ _ ENNReal.ofReal_ne_top

/-- **Termwise integration of an integer series of rectifiable triples** (Simon Ch. 6, 3.1 (‡)
for the `M`-absolutely convergent series of 3.13 and the proof of 7.2).
Let `(M_r, θ_r, ξ_r)` be rectifiable triples in `U` and `c_r ∈ ℤ` with
`∑_r |c_r| ∫_{M_r ∩ W} θ_r dHⁿ < ∞` for every `W ⊂⊂ U`.  Then for every `ω ∈ 𝒟ⁿ(U)`, with
`F_r := 1_{M_r} c_r θ_r ⟨ω, ξ_r⟩`, the series `∑_r c_r τ(M_r, θ_r, ξ_r)(ω)` has sum
`∫ ∑_r F_r dHⁿ`.  Choose an open `W ⊂⊂ U` with `tsupport ω ⊆ W` and a bound `‖ω(x)‖ ≤ B`;
`Submission.fiw_ims_tt_term_bound` makes each `F_r` a.e. strongly measurable with
`∫ |F_r| dHⁿ ≤ |c_r| B ∫_{M_r ∩ W} θ_r dHⁿ`, so `∑_r ∫ |F_r| dHⁿ < ∞` and the series can be
integrated termwise (`hasSum_integral_of_summable_integral_norm`); finally
`∫ F_r dHⁿ = c_r ∫_{M_r} θ_r ⟨ω, ξ_r⟩ dHⁿ = c_r τ(M_r, θ_r, ξ_r)(ω)`. -/
theorem Submission.fiw_ims_tsum_tau :
    ∀ (P n : ℕ) (U : Set (Eucl P)), IsOpen U → ∀ (M : ℕ → Set (Eucl P)) (θ : ℕ → Eucl P → ℝ)
      (ξ : ℕ → Eucl P → NVector (Eucl P) n) (c : ℕ → ℤ),
      (∀ r, IsRectifiableTriple U n (M r) (θ r) (ξ r)) →
      (∀ W, CompactlyContainedOpen W U → (∑' r, ((c r).natAbs : ℝ≥0∞) *
        ∫⁻ x in M r ∩ W, ENNReal.ofReal (θ r x) ∂(μHE[n] : Measure (Eucl P))) < ∞) →
      ∀ ω : TestFormOn U n, HasSum (fun r => (c r : ℝ) * tauAction n (M r) (θ r) (ξ r) ω)
        (∫ x, ∑' r, (M r).indicator (fun y => (c r : ℝ) * (θ r y * ξ r y
          ((ω : DifferentialForm (Eucl P) n) y))) x ∂(μHE[n] : Measure (Eucl P))) := by
  intro P n U hU M θ ξ c htri hsum ω
  -- `ω` is smooth (hence continuous) with compact support `tsupport ω ⊆ U`.
  have hωc : Continuous (ω : DifferentialForm (Eucl P) n) := ω.2.1.1.continuous
  have hωK : HasCompactSupport (ω : DifferentialForm (Eucl P) n) := ω.2.1.2
  -- Localization: an open `W ⊂⊂ U` with `tsupport ω ⊆ W`, and `‖ω(x)‖ ≤ B` for all `x`.
  obtain ⟨W, hWo, hKW, hLU, hLc⟩ :=
    exists_open_between_and_isCompact_closure hωK.isCompact hU ω.2.2
  have hW : CompactlyContainedOpen W U := ⟨hWo, hLc, hLU⟩
  obtain ⟨B, hB⟩ := hωc.bounded_above_of_compact_support hωK
  -- `F r = c_r G r`, where `G r := 1_{M_r} θ_r ⟨ω, ξ_r⟩` is controlled by the child lemma.
  let G : ℕ → Eucl P → ℝ := fun r =>
    (M r).indicator fun y => θ r y * ξ r y ((ω : DifferentialForm (Eucl P) n) y)
  let F : ℕ → Eucl P → ℝ := fun r =>
    (M r).indicator fun y => (c r : ℝ) * (θ r y * ξ r y ((ω : DifferentialForm (Eucl P) n) y))
  have hFG : ∀ r x, F r x = (c r : ℝ) * G r x := by
    intro r x
    by_cases hx : x ∈ M r <;> simp [F, G, hx]
  have hG : ∀ r, AEStronglyMeasurable (G r) (μHE[n] : Measure (Eucl P)) ∧
      ∫⁻ x, ‖G r x‖ₑ ∂(μHE[n] : Measure (Eucl P)) ≤ ENNReal.ofReal B *
        ∫⁻ x in M r ∩ W, ENNReal.ofReal (θ r x) ∂(μHE[n] : Measure (Eucl P)) := fun r =>
    Submission.fiw_ims_tt_term_bound P n U W (M r) (θ r) (ξ r) (ω : DifferentialForm (Eucl P) n)
      B (htri r) hW hωc hKW hB
  -- `‖(c_r : ℝ)‖ₑ = |c_r|`.
  have hc : ∀ r, ‖(c r : ℝ)‖ₑ = ((c r).natAbs : ℝ≥0∞) := fun r => by
    rw [Real.enorm_eq_ofReal_abs, ← Int.cast_abs, ← Nat.cast_natAbs, ENNReal.ofReal_natCast]
  have hFm : ∀ r, AEStronglyMeasurable (F r) (μHE[n] : Measure (Eucl P)) := fun r => by
    have : F r = fun x => (c r : ℝ) * G r x := funext (hFG r)
    rw [this]
    exact (hG r).1.const_mul _
  -- `∫ |F_r| dHⁿ ≤ |c_r| B ∫_{M_r ∩ W} θ_r dHⁿ`.
  have hFle : ∀ r, ∫⁻ x, ‖F r x‖ₑ ∂(μHE[n] : Measure (Eucl P)) ≤ ENNReal.ofReal B *
      (((c r).natAbs : ℝ≥0∞) *
        ∫⁻ x in M r ∩ W, ENNReal.ofReal (θ r x) ∂(μHE[n] : Measure (Eucl P))) := fun r =>
    calc ∫⁻ x, ‖F r x‖ₑ ∂(μHE[n] : Measure (Eucl P))
        = ∫⁻ x, ((c r).natAbs : ℝ≥0∞) * ‖G r x‖ₑ ∂(μHE[n] : Measure (Eucl P)) := by
          simp_rw [hFG r, enorm_mul, hc]
      _ = ((c r).natAbs : ℝ≥0∞) * ∫⁻ x, ‖G r x‖ₑ ∂(μHE[n] : Measure (Eucl P)) :=
          lintegral_const_mul' _ _ (ENNReal.natCast_ne_top _)
      _ ≤ ((c r).natAbs : ℝ≥0∞) * (ENNReal.ofReal B *
            ∫⁻ x in M r ∩ W, ENNReal.ofReal (θ r x) ∂(μHE[n] : Measure (Eucl P))) := by
          gcongr
          exact (hG r).2
      _ = _ := mul_left_comm _ _ _
  -- Hence `∑_r ∫ |F_r| dHⁿ ≤ B ∑_r |c_r| ∫_{M_r ∩ W} θ_r dHⁿ < ∞`.
  have hFsum : ∑' r, ∫⁻ x, ‖F r x‖ₑ ∂(μHE[n] : Measure (Eucl P)) ≠ ∞ := by
    refine ne_top_of_le_ne_top (ENNReal.mul_ne_top (ENNReal.ofReal_ne_top (r := B))
      (hsum W hW).ne) ?_
    rw [← ENNReal.tsum_mul_left]
    exact ENNReal.tsum_le_tsum hFle
  have hFi : ∀ r, Integrable (F r) (μHE[n] : Measure (Eucl P)) := fun r =>
    ⟨hFm r, (ENNReal.le_tsum (f := fun r => ∫⁻ x, ‖F r x‖ₑ ∂(μHE[n] : Measure (Eucl P))) r).trans_lt
      (lt_top_iff_ne_top.2 hFsum)⟩
  have hFs : Summable fun r => ∫ x, ‖F r x‖ ∂(μHE[n] : Measure (Eucl P)) :=
    (ENNReal.summable_toReal hFsum).congr fun r => (integral_norm_eq_lintegral_enorm (hFm r)).symm
  -- Termwise integration, and `∫ F_r dHⁿ = c_r τ(M_r, θ_r, ξ_r)(ω)`.
  have hint : ∀ r, ∫ x, F r x ∂(μHE[n] : Measure (Eucl P)) =
      (c r : ℝ) * tauAction n (M r) (θ r) (ξ r) ω := fun r => by
    simp only [F]
    rw [integral_indicator₀ (htri r).nullMeasurableSet, integral_const_mul]
    rfl
  have hS := hasSum_integral_of_summable_integral_norm hFi hFs
  simp only [hint] at hS
  exact hS

/-- **Series of integer multiplicity currents, Simon Ch. 6, 3.13 (p. 149), as used in the proof
of 7.2 (p. 170).**  Under tangent locality in `U`, an `M`-absolutely convergent series
`∑ c_r τ(M_r, θ_r, ξ_r)` with `c_r ∈ ℤ` and integer `θ_r` is one integer multiplicity current
`τ(M', θ', ξ')`.  Off an `Hⁿ`-null set, only finitely many `M_r` with `c_r ≠ 0` contain `x`,
each `ξ_r` orients `M_r` at `x`, and `ξ_r(x) = ±ξ_{r'}(x)` whenever `x ∈ M_r ∩ M_{r'}`.  With
`ξ̂ = ξ_{r(x)}` for the first index `r(x)` of an `M_r ∋ x` and `ξ_r = σ_r ξ̂` (`σ_r = ±1`),
`θ̂ = ∑' r, 1_{M_r} c_r σ_r θ_r` is an integer-valued finite sum bounded by
`∑' r, |c_r| 1_{M_r} θ_r`; then `M' = {θ̂ ≠ 0}`, `θ' = |θ̂|`, `ξ' = (θ̂/|θ̂|) ξ̂` give the sum of
the series. -/
theorem Submission.fiw_ims_combine : ∀ (P n : ℕ) (U : Set (Eucl P)), IsOpen U → (∀ (M₁ M₂ : Set (Eucl P)) (θ₁ θ₂ : Eucl P → ℝ), M₁ ⊆ U → M₂ ⊆ U → NullMeasurableSet M₁ (μHE[n] : Measure (Eucl P)) → NullMeasurableSet M₂ (μHE[n] : Measure (Eucl P)) → (∀ x ∈ M₁, 0 < θ₁ x) → (∀ x ∈ M₂, 0 < θ₂ x) → (∀ K : Set (Eucl P), IsCompact K → K ⊆ U → IntegrableOn θ₁ (M₁ ∩ K) (μHE[n] : Measure (Eucl P))) → (∀ K : Set (Eucl P), IsCompact K → K ⊆ U → IntegrableOn θ₂ (M₂ ∩ K) (μHE[n] : Measure (Eucl P))) → ∀ᵐ x ∂((μHE[n] : Measure (Eucl P)).restrict (M₁ ∩ M₂)), ∀ Q : Submodule ℝ (Eucl P), HasWeightedApproximateTangentSpaceAt n M₁ θ₁ x Q → HasWeightedApproximateTangentSpaceAt n M₂ θ₂ x Q) → ∀ (M : ℕ → Set (Eucl P)) (θ : ℕ → Eucl P → ℝ) (ξ : ℕ → Eucl P → NVector (Eucl P) n) (c : ℕ → ℤ), (∀ r, IsRectifiableTriple U n (M r) (θ r) (ξ r)) → (∀ r, ∀ x ∈ M r, ∃ k : ℕ, θ r x = k) → (∀ W, CompactlyContainedOpen W U → (∑' r, ((c r).natAbs : ℝ≥0∞) * ∫⁻ x in M r ∩ W, ENNReal.ofReal (θ r x) ∂(μHE[n] : Measure (Eucl P))) < ∞) → ∃ (M' : Set (Eucl P)) (θ' : Eucl P → ℝ) (ξ' : Eucl P → NVector (Eucl P) n), IsRectifiableTriple U n M' θ' ξ' ∧ (∀ x ∈ M', ∃ k : ℕ, θ' x = k) ∧ ∀ ω : TestFormOn U n, HasSum (fun r => (c r : ℝ) * tauAction n (M r) (θ r) (ξ r) ω) (tauAction n M' θ' ξ' ω) := by
  intro P n U hU hTL M θ ξ c hT hθN hsum
  classical
  -- `NVector (Eucl P) n` is a normed space, but instance search does not find its
  -- pseudometrizability; the operator-norm uniformity provides it.
  have : TopologicalSpace.PseudoMetrizableSpace (NVector (Eucl P) n) := by
    let u : UniformSpace (NVector (Eucl P) n) := PseudoMetricSpace.toUniformSpace
    have : (uniformity (NVector (Eucl P) n)).IsCountablyGenerated :=
      @EMetric.instIsCountablyGeneratedUniformity _ PseudoMetricSpace.toPseudoEMetricSpace
    exact @UniformSpace.pseudoMetrizableSpace _ u this
  /- Step 1: the exceptional null sets.  Off a null set, only finitely many `M r` with
  `c r ≠ 0` contain `x`, every `M r ∋ x` is oriented at `x` by `ξ r`, and the orientations of
  any two `M r, M r' ∋ x` agree up to sign. -/
  have hθ1 : ∀ r, ∀ x ∈ M r, 1 ≤ θ r x := by
    intro r x hx
    obtain ⟨k, hk⟩ := hθN r x hx
    have hpos := (hT r).pos x hx
    rw [hk] at hpos ⊢
    have hk0 : 0 < k := by exact_mod_cast hpos
    exact_mod_cast hk0
  obtain ⟨hΘ, hfin⟩ := Submission.fiw_ims_overlap_finite P n U hU M θ c
    (fun r => (hT r).subset) (fun r => (hT r).nullMeasurableSet) (fun r => (hT r).integrableOn)
    hθ1 hsum
  have horient : ∀ r, ∀ᵐ x ∂(μHE[n] : Measure (Eucl P)), x ∈ M r →
      ∃ τ : Fin n → Eucl P, Orthonormal ℝ τ ∧
        HasWeightedApproximateTangentSpaceAt n (M r) (θ r) x (Submodule.span ℝ (range τ)) ∧
        (ξ r x = simpleNVector τ ∨ ξ r x = -simpleNVector τ) := fun r =>
    (ae_restrict_iff'₀ (hT r).nullMeasurableSet).1 (hT r).orients
  have hsign : ∀ r r', ∀ᵐ x ∂(μHE[n] : Measure (Eucl P)), x ∈ M r → x ∈ M r' →
      (ξ r x = ξ r' x ∨ ξ r x = -ξ r' x) := by
    intro r r'
    have h := Submission.fiw_ims_orientation_sign P n U (M r) (M r') (θ r) (θ r') (ξ r) (ξ r')
      (hT r) (hT r') (hTL (M r) (M r') (θ r) (θ r') (hT r).subset (hT r').subset
        (hT r).nullMeasurableSet (hT r').nullMeasurableSet (hT r).pos (hT r').pos
        (hT r).integrableOn (hT r').integrableOn)
    rw [ae_restrict_iff'₀ ((hT r).nullMeasurableSet.inter (hT r').nullMeasurableSet)] at h
    filter_upwards [h] with x hx h1 h2 using hx ⟨h1, h2⟩
  set G : Set (Eucl P) := {x | {r | c r ≠ 0 ∧ x ∈ M r}.Finite ∧
    (∀ r, x ∈ M r → ∃ τ : Fin n → Eucl P, Orthonormal ℝ τ ∧
        HasWeightedApproximateTangentSpaceAt n (M r) (θ r) x (Submodule.span ℝ (range τ)) ∧
        (ξ r x = simpleNVector τ ∨ ξ r x = -simpleNVector τ)) ∧
    ∀ r r', x ∈ M r → x ∈ M r' → (ξ r x = ξ r' x ∨ ξ r x = -ξ r' x)}
  have hGae : ∀ᵐ x ∂(μHE[n] : Measure (Eucl P)), x ∈ G := by
    have h3 : ∀ᵐ x ∂(μHE[n] : Measure (Eucl P)), ∀ r r', x ∈ M r → x ∈ M r' →
        (ξ r x = ξ r' x ∨ ξ r x = -ξ r' x) :=
      ae_all_iff.2 fun r => ae_all_iff.2 (hsign r)
    filter_upwards [hfin, ae_all_iff.2 horient, h3] with x h1 h2 h3 using ⟨h1, h2, h3⟩
  have hGnm : NullMeasurableSet G (μHE[n] : Measure (Eucl P)) :=
    (NullMeasurableSet.of_null (ae_iff.1 hGae)).of_compl
  /- Step 2: the first index `rf x` of a set `M r` containing `x`, and the sets `A r` on which
  it equals `r`. -/
  let rf : Eucl P → ℕ := fun x => if h : ∃ r, x ∈ M r then Nat.find h else 0
  have hrf : ∀ r, ∀ x ∈ M r, x ∈ M (rf x) := by
    intro r x hx
    have h : ∃ r, x ∈ M r := ⟨r, hx⟩
    simp only [rf, dite_eq_left h]
    exact Nat.find_spec h
  have hrfA : ∀ r x, x ∈ M r → (∀ r' < r, x ∉ M r') → rf x = r := by
    intro r x hx hlt
    have h : ∃ r, x ∈ M r := ⟨r, hx⟩
    simp only [rf, dite_eq_left h]
    exact (Nat.find_eq_iff h).2 ⟨hx, hlt⟩
  have hMA : (⋃ r, M r) = ⋃ r, M r ∩ ⋂ r' ∈ {r' | r' < r}, (M r')ᶜ := by
    ext x
    simp only [mem_iUnion, mem_inter_iff, mem_iInter, mem_compl_iff, mem_ofPred_eq]
    constructor
    · rintro ⟨r, hr⟩
      have h : ∃ r, x ∈ M r := ⟨r, hr⟩
      exact ⟨Nat.find h, Nat.find_spec h, fun r' hr' => Nat.find_min h hr'⟩
    · rintro ⟨r, hr, -⟩
      exact ⟨r, hr⟩
  /- Step 3: the reference orientation `ξh x = ξ (rf x) x`, a.e.-strongly measurable on
  `⋃ r, M r` because it agrees with `ξ r` on `A r`. -/
  let ξh : Eucl P → NVector (Eucl P) n := fun x => ξ (rf x) x
  have hξh : AEStronglyMeasurable ξh
      ((μHE[n] : Measure (Eucl P)).restrict (⋃ r, M r)) := by
    rw [hMA, aestronglyMeasurable_iUnion_iff]
    intro r
    have hAnm : NullMeasurableSet (M r ∩ ⋂ r' ∈ {r' | r' < r}, (M r')ᶜ)
        (μHE[n] : Measure (Eucl P)) :=
      (hT r).nullMeasurableSet.inter
        (NullMeasurableSet.iInter fun r' => NullMeasurableSet.iInter fun _ =>
          (hT r').nullMeasurableSet.compl)
    refine ((hT r).aestronglyMeasurable.mono_measure
      (Measure.restrict_mono inter_subset_left le_rfl)).congr ?_
    filter_upwards [ae_restrict_mem₀ hAnm] with x hx
    simp only [mem_inter_iff, mem_iInter, mem_compl_iff] at hx
    simp only [ξh, hrfA r x hx.1 hx.2]
  /- Step 4: the signs `σ r x = ±1` with `ξ r x = σ r x • ξh x` on `G ∩ M r`. -/
  let σ : ℕ → Eucl P → ℝ := fun r x => if ξ r x = ξh x then 1 else -1
  have hσ : ∀ r, AEStronglyMeasurable (σ r) ((μHE[n] : Measure (Eucl P)).restrict (M r)) := by
    intro r
    have hE : NullMeasurableSet {x | ξ r x = ξh x}
        ((μHE[n] : Measure (Eucl P)).restrict (M r)) :=
      (hT r).aestronglyMeasurable.nullMeasurableSet_eq_fun
        (hξh.mono_measure (Measure.restrict_mono (subset_iUnion M r) le_rfl))
    have h := AEStronglyMeasurable.piecewise (f := fun _ => (1 : ℝ)) (g := fun _ => (-1 : ℝ))
      hE aestronglyMeasurable_const aestronglyMeasurable_const
    convert h using 1
    funext x
    simp only [σ, Set.piecewise, mem_ofPred_eq]
  /- Step 5: `θ r` is a.e.-strongly measurable on `M r` (local integrability). -/
  have hθm : ∀ r, AEStronglyMeasurable (θ r) ((μHE[n] : Measure (Eucl P)).restrict (M r)) := by
    intro r
    apply LocallyIntegrableOn.aestronglyMeasurable
    intro x hx
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hU x ((hT r).subset hx)
    refine ⟨M r ∩ closedBall x (ε / 2),
      inter_mem_nhdsWithin _ (closedBall_mem_nhds x (half_pos hε)), ?_⟩
    exact (hT r).integrableOn _ (isCompact_closedBall x (ε / 2))
      ((closedBall_subset_ball (half_lt_self hε)).trans hball)
  /- Step 6: the integer multiplicity `θh = ∑' r, t r`, `t r = 1_{M r} c r σ r θ r`. -/
  let t : ℕ → Eucl P → ℝ := fun r => (M r).indicator fun y => (c r : ℝ) * (σ r y * θ r y)
  have ht : ∀ r, AEStronglyMeasurable (t r) (μHE[n] : Measure (Eucl P)) := fun r =>
    (aestronglyMeasurable_indicator_iff₀ (hT r).nullMeasurableSet).2
      (((hσ r).mul (hθm r)).const_mul _)
  have ht0 : ∀ x r, ¬(c r ≠ 0 ∧ x ∈ M r) → t r x = 0 := by
    intro x r h
    by_cases hx : x ∈ M r
    · have hc : c r = 0 := by
        by_contra hc
        exact h ⟨hc, hx⟩
      simp [t, hx, hc]
    · simp [t, hx]
  let θh : Eucl P → ℝ := fun x => ∑' r, t r x
  have hθh_sum : ∀ x (hx : x ∈ G), θh x = ∑ r ∈ hx.1.toFinset, t r x := by
    intro x hx
    refine tsum_eq_sum fun r hr => ht0 x r ?_
    rwa [Set.Finite.mem_toFinset] at hr
  have hθh_hasSum : ∀ x ∈ G, HasSum (fun r => t r x) (θh x) := by
    intro x hx
    refine (summable_of_ne_finset_zero (s := hx.1.toFinset) fun r hr => ht0 x r ?_).hasSum
    rwa [Set.Finite.mem_toFinset] at hr
  have hθh : AEStronglyMeasurable θh (μHE[n] : Measure (Eucl P)) := by
    refine aestronglyMeasurable_of_tendsto_ae atTop
      (f := fun N x => ∑ r ∈ Finset.range N, t r x)
      (fun N => Finset.aestronglyMeasurable_fun_sum _ fun r _ => ht r) ?_
    filter_upwards [hGae] with x hx
    exact (hθh_hasSum x hx).tendsto_sum_nat
  -- `ofReal |t r x| = |c r| 1_{M r} ofReal (θ r x)`, so `ofReal |θh| ≤ Θ` on `G`.
  have hterm : ∀ x r, ENNReal.ofReal |t r x| =
      ((c r).natAbs : ℝ≥0∞) * (M r).indicator (fun y => ENNReal.ofReal (θ r y)) x := by
    intro x r
    by_cases hxr : x ∈ M r
    · have hσabs : |σ r x| = 1 := by
        simp only [σ]
        split_ifs <;> simp
      have htx : t r x = (c r : ℝ) * (σ r x * θ r x) := indicator_of_mem hxr _
      rw [indicator_of_mem hxr, htx, abs_mul, abs_mul, hσabs, one_mul,
        abs_of_pos ((hT r).pos x hxr), ENNReal.ofReal_mul (abs_nonneg _), ← Int.cast_abs,
        ← Nat.cast_natAbs, ENNReal.ofReal_natCast]
    · simp [t, hxr]
  have hΘx : ∀ x ∈ G, ENNReal.ofReal |θh x| ≤
      ∑' r, ((c r).natAbs : ℝ≥0∞) * (M r).indicator (fun y => ENNReal.ofReal (θ r y)) x := by
    intro x hx
    rw [hθh_sum x hx]
    calc ENNReal.ofReal |∑ r ∈ hx.1.toFinset, t r x|
        ≤ ENNReal.ofReal (∑ r ∈ hx.1.toFinset, |t r x|) :=
          ENNReal.ofReal_le_ofReal (Finset.abs_sum_le_sum_abs _ _)
      _ = ∑ r ∈ hx.1.toFinset, ENNReal.ofReal |t r x| :=
          ENNReal.ofReal_sum_of_nonneg fun r _ => abs_nonneg _
      _ = ∑ r ∈ hx.1.toFinset,
            ((c r).natAbs : ℝ≥0∞) * (M r).indicator (fun y => ENNReal.ofReal (θ r y)) x :=
          Finset.sum_congr rfl fun r _ => hterm x r
      _ ≤ _ := ENNReal.sum_le_tsum _
  /- Step 7: the new triple. -/
  set M' : Set (Eucl P) := {x | x ∈ G ∧ θh x ≠ 0} with hM'
  set θ' : Eucl P → ℝ := fun x => |θh x| with hθ'
  set ξ' : Eucl P → NVector (Eucl P) n := fun x => (θh x / |θh x|) • ξh x
  have hM'sub : M' ⊆ ⋃ r, M r := by
    intro x hx
    by_contra hcon
    simp only [mem_iUnion, not_exists] at hcon
    apply hx.2
    have h0 : ∀ r, t r x = 0 := fun r => by simp [t, hcon r]
    simp only [θh, h0, tsum_zero]
  have hM'U : M' ⊆ U := hM'sub.trans (iUnion_subset fun r => (hT r).subset)
  have hM'nm : NullMeasurableSet M' (μHE[n] : Measure (Eucl P)) := by
    have hM'eq : M' = G ∩ θh ⁻¹' {0}ᶜ := by
      ext x
      simp only [hM', mem_ofPred_eq, mem_inter_iff, mem_preimage, mem_compl_iff,
        mem_singleton_iff]
    rw [hM'eq]
    exact hGnm.inter (hθh.aemeasurable.nullMeasurable (measurableSet_singleton 0).compl)
  have hθ'pos : ∀ x ∈ M', 0 < θ' x := fun x hx => abs_pos.2 hx.2
  have hθ'N : ∀ x ∈ M', ∃ k : ℕ, θ' x = k := by
    intro x hx
    have hint : ∀ r, ∃ z : ℤ, t r x = z := by
      intro r
      by_cases hxr : x ∈ M r
      · obtain ⟨k, hk⟩ := hθN r x hxr
        have htx : t r x = (c r : ℝ) * (σ r x * θ r x) := indicator_of_mem hxr _
        refine ⟨c r * ((if ξ r x = ξh x then 1 else -1) * k), ?_⟩
        rw [htx, hk]
        simp only [σ]
        split_ifs <;> push_cast <;> ring
      · exact ⟨0, by simp [t, hxr]⟩
    obtain ⟨z, hz⟩ : ∃ z : ℤ, θh x = z := by
      rw [hθh_sum x hx.1]
      exact Finset.sum_induction (fun r => t r x) (fun a : ℝ => ∃ z : ℤ, a = z)
        (fun a b ⟨za, ha⟩ ⟨zb, hb⟩ => ⟨za + zb, by rw [ha, hb, Int.cast_add]⟩)
        ⟨0, by rw [Int.cast_zero]⟩ fun r _ => hint r
    refine ⟨z.natAbs, ?_⟩
    simp only [hθ', hz, Nat.cast_natAbs, Int.cast_abs]
  have hθ'int : ∀ K : Set (Eucl P), IsCompact K → K ⊆ U →
      IntegrableOn θ' (M' ∩ K) (μHE[n] : Measure (Eucl P)) := by
    intro K hK hKU
    refine ⟨(continuous_abs.comp_aestronglyMeasurable hθh).restrict, ?_⟩
    rw [hasFiniteIntegral_iff_enorm]
    calc ∫⁻ x in M' ∩ K, ‖θ' x‖ₑ ∂(μHE[n] : Measure (Eucl P))
        ≤ ∫⁻ x in M' ∩ K, ∑' r, ((c r).natAbs : ℝ≥0∞) *
            (M r).indicator (fun y => ENNReal.ofReal (θ r y)) x ∂(μHE[n] : Measure (Eucl P)) := by
          refine lintegral_mono_ae ?_
          filter_upwards [ae_restrict_mem₀
            (hM'nm.inter hK.isClosed.measurableSet.nullMeasurableSet)] with x hx
          rw [Real.enorm_eq_ofReal_abs, hθ', abs_abs]
          exact hΘx x hx.1.1
      _ ≤ ∫⁻ x in K, ∑' r, ((c r).natAbs : ℝ≥0∞) *
            (M r).indicator (fun y => ENNReal.ofReal (θ r y)) x ∂(μHE[n] : Measure (Eucl P)) :=
          lintegral_mono_set inter_subset_right
      _ < ∞ := hΘ K hK hKU
  have hξ'meas : AEStronglyMeasurable ξ' ((μHE[n] : Measure (Eucl P)).restrict M') := by
    have h1 : AEStronglyMeasurable (fun x => θh x / |θh x|) (μHE[n] : Measure (Eucl P)) :=
      (hθh.aemeasurable.div
        (continuous_abs.measurable.comp_aemeasurable hθh.aemeasurable)).aestronglyMeasurable
    exact h1.restrict.smul (hξh.mono_measure (Measure.restrict_mono hM'sub le_rfl))
  /- Step 10 (vii): orientation of `M'`, by tangent locality for `(M r, θ r)` and `(M', θ')`. -/
  have hloc : ∀ r, ∀ᵐ x ∂(μHE[n] : Measure (Eucl P)), x ∈ M r ∩ M' →
      ∀ Q : Submodule ℝ (Eucl P), HasWeightedApproximateTangentSpaceAt n (M r) (θ r) x Q →
        HasWeightedApproximateTangentSpaceAt n M' θ' x Q := fun r =>
    (ae_restrict_iff'₀ ((hT r).nullMeasurableSet.inter hM'nm)).1
      (hTL (M r) M' (θ r) θ' (hT r).subset hM'U (hT r).nullMeasurableSet hM'nm (hT r).pos
        hθ'pos (hT r).integrableOn hθ'int)
  have horient' : ∀ᵐ x ∂((μHE[n] : Measure (Eucl P)).restrict M'),
      ∃ τ : Fin n → Eucl P, Orthonormal ℝ τ ∧
        HasWeightedApproximateTangentSpaceAt n M' θ' x (Submodule.span ℝ (range τ)) ∧
        (ξ' x = simpleNVector τ ∨ ξ' x = -simpleNVector τ) := by
    rw [ae_restrict_iff'₀ hM'nm]
    filter_upwards [ae_all_iff.2 hloc] with x hlocx hxM'
    obtain ⟨r0, hr0⟩ := mem_iUnion.1 (hM'sub hxM')
    have hxr : x ∈ M (rf x) := hrf r0 x hr0
    obtain ⟨τ, hτ, hTx, hξτ⟩ := hxM'.1.2.1 (rf x) hxr
    refine ⟨τ, hτ, hlocx (rf x) ⟨hxr, hxM'⟩ _ hTx, ?_⟩
    have hsgn : θh x / |θh x| = 1 ∨ θh x / |θh x| = -1 := by
      rcases lt_or_gt_of_ne hxM'.2 with h | h
      · right
        rw [abs_of_neg h, div_neg, div_self hxM'.2]
      · left
        rw [abs_of_pos h, div_self hxM'.2]
    change (θh x / |θh x|) • ξ (rf x) x = simpleNVector τ ∨
      (θh x / |θh x|) • ξ (rf x) x = -simpleNVector τ
    rcases hsgn with h | h <;> rw [h] <;> rcases hξτ with h' | h' <;> rw [h']
    · exact Or.inl (one_smul ℝ _)
    · exact Or.inr (one_smul ℝ _)
    · exact Or.inr (ContinuousLinearMap.ext fun α => by
        simp only [smul_apply, neg_apply, smul_eq_mul, neg_one_mul])
    · exact Or.inl (ContinuousLinearMap.ext fun α => by
        simp only [smul_apply, neg_apply, smul_eq_mul, neg_one_mul, neg_neg])
  refine ⟨M', θ', ξ', ⟨hM'U, hM'nm,
    (Poincare.SimonGMT.Chapter03.countablyRectifiable_iUnion M
      fun r => (hT r).countablyRectifiable).mono hM'sub,
    hθ'pos, hθ'int, hξ'meas, horient'⟩, hθ'N, ?_⟩
  /- Steps 8–9: `∑' r, 1_{M r} c r θ r ⟨ω, ξ r⟩ = 1_{M'} θ' ⟨ω, ξ'⟩` a.e., and `tsum_tau`. -/
  intro ω
  have h := Submission.fiw_ims_tsum_tau P n U hU M θ ξ c hT hsum ω
  convert h using 1
  unfold tauAction
  rw [← integral_indicator₀ hM'nm]
  refine integral_congr_ae ?_
  filter_upwards [hGae] with x hx
  have hterm' : ∀ r, (M r).indicator (fun y => (c r : ℝ) *
      (θ r y * ξ r y ((ω : DifferentialForm (Eucl P) n) y))) x =
        t r x * ξh x ((ω : DifferentialForm (Eucl P) n) x) := by
    intro r
    by_cases hxr : x ∈ M r
    · have htx : t r x = (c r : ℝ) * (σ r x * θ r x) := indicator_of_mem hxr _
      rw [indicator_of_mem hxr, htx]
      have hs := hx.2.2 r (rf x) hxr (hrf r x hxr)
      simp only [σ]
      split_ifs with heq
      · rw [heq]
        ring
      · rcases hs with hs | hs
        · exact absurd hs heq
        · change (c r : ℝ) * (θ r x * ξ r x _) = (c r : ℝ) * (-1 * θ r x) * ξ (rf x) x _
          rw [hs, neg_apply]
          ring
    · simp [t, hxr]
  rw [tsum_congr hterm', tsum_mul_right]
  change _ = θh x * ξh x ((ω : DifferentialForm (Eucl P) n) x)
  by_cases hxM' : x ∈ M'
  · rw [indicator_of_mem hxM']
    have hne : |θh x| ≠ 0 := abs_ne_zero.2 hxM'.2
    simp only [θ', ξ', smul_apply, smul_eq_mul]
    field_simp
  · rw [indicator_of_notMem hxM']
    have h0 : θh x = 0 := by
      by_contra hne
      exact hxM' ⟨hx, hne⟩
    change (0 : ℝ) = θh x * _
    rw [h0, zero_mul]

/-- Simon Ch. 3, Remark 1.8(1): on a set `E` of locally finite `Hᵏ`-measure, weighted approximate
tangent spaces do not depend on the positive multiplicity.  At `Hᵏ⌞E`-a.e. `x`, both `θ` and
`θ'` have normalized Lebesgue points.  With `c θ(x) = θ'(x)`, Definition 1.7 is homogeneous in
the weight, so `Q` is tangent for `(E, c θ)`; and `|c θ - θ'| ≤ |c| |θ - θ(x)| + |θ' - θ'(x)|`
lets tangent locality pass from `(E, c θ)` to `(E, θ')`. -/
theorem Submission.deformation_imcomb_weight_change : ∀ (N k : ℕ) (E : Set (Eucl N)) (θ θ' : Eucl N → ℝ), NullMeasurableSet E (μHE[k] : Measure (Eucl N)) → (∀ K : Set (Eucl N), IsCompact K → (μHE[k] : Measure (Eucl N)) (E ∩ K) < ∞) → (∀ x ∈ E, 0 < θ x) → (∀ K : Set (Eucl N), IsCompact K → IntegrableOn θ (E ∩ K) (μHE[k] : Measure (Eucl N))) → (∀ K : Set (Eucl N), IsCompact K → IntegrableOn θ' (E ∩ K) (μHE[k] : Measure (Eucl N))) → ∀ᵐ x ∂((μHE[k] : Measure (Eucl N)).restrict E), ∀ Q : Submodule ℝ (Eucl N), HasWeightedApproximateTangentSpaceAt k E θ x Q → HasWeightedApproximateTangentSpaceAt k E θ' x Q := by
  intro N k E θ θ' hE hfin hpos hθ hθ'
  set H : Measure (Eucl N) := (μHE[k] : Measure (Eucl N))
  -- Normalized Lebesgue points of `θ` and `θ'` on `E` (with `U = ℝ^N`).
  have hleb : ∀ f : Eucl N → ℝ, (∀ K : Set (Eucl N), IsCompact K → IntegrableOn f (E ∩ K) H) →
      ∀ᵐ x ∂(H.restrict E), ∀ R : ℝ, 0 < R → Tendsto (fun r : ℝ => ENNReal.ofReal ((r ^ k)⁻¹) *
        ∫⁻ y in E ∩ closedBall x (R * r), ‖f y - f x‖ₑ ∂H) (𝓝[>] 0) (𝓝 0) := fun f hf =>
    Submission.iwl_imc_normalized_lebesgue_points N k univ E f isOpen_univ (subset_univ E) hE
      (fun K hK _ => hfin K hK) (fun K hK _ => hf K hK)
  filter_upwards [hleb θ hθ, hleb θ' hθ', ae_restrict_mem₀ hE] with x hx hx' hxE Q hQ
  obtain ⟨c, hcx⟩ : ∃ c : ℝ, c * θ x = θ' x :=
    ⟨θ' x / θ x, div_mul_cancel₀ _ (hpos x hxE).ne'⟩
  -- Definition 1.7 is homogeneous in the multiplicity: `Q` is tangent for `(E, c θ)`.
  have hQc : HasWeightedApproximateTangentSpaceAt k E (fun y => c * θ y) x Q := by
    obtain ⟨hQk, hf⟩ := hQ
    refine ⟨hQk, fun f => ?_⟩
    have h := (hf f).const_mul c
    rw [← mul_assoc] at h
    refine h.congr fun r => ?_
    rw [← integral_const_mul]
    congr 1
    funext y
    dsimp only
    ring
  -- `c θ(x) = θ'(x)`, so tangent locality applies to `(E, c θ)` and `(E, θ')`.
  refine (Submission.iwl_weighted_tangent_locality N k E E (fun y => c * θ y) θ' x hE hE hcx
    ⟨1, one_pos, Integrable.const_mul (hθ _ (isCompact_closedBall x 1)) c,
      hθ' _ (isCompact_closedBall x 1)⟩ (fun R hR => ?_) Q).1 hQc
  have hupper := (ENNReal.Tendsto.const_mul (hx R hR) (Or.inr (enorm_ne_top (x := c)))).add
    (hx' R hR)
  rw [mul_zero, zero_add] at hupper
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hupper
    (fun _ => zero_le) (fun r => ?_)
  -- `r⁻ᵏ ∫_{B̄_{Rr}(x)} |1_E c θ - 1_E θ'| ≤ |c| r⁻ᵏ ∫_{E ∩ B̄_{Rr}(x)} |θ - θ(x)| +
  -- r⁻ᵏ ∫_{E ∩ B̄_{Rr}(x)} |θ' - θ'(x)|`.
  have hEB : NullMeasurableSet E (H.restrict (closedBall x (R * r))) :=
    hE.mono Measure.restrict_le_self
  have hmeas : AEMeasurable (fun y => ‖c‖ₑ * ‖θ y - θ x‖ₑ)
      (H.restrict (E ∩ closedBall x (R * r))) :=
    ((hθ _ (isCompact_closedBall x (R * r))).aestronglyMeasurable.sub
      aestronglyMeasurable_const).enorm.const_mul _
  calc ENNReal.ofReal ((r ^ k)⁻¹) * ∫⁻ z in closedBall x (R * r),
        ‖E.indicator (fun y => c * θ y) z - E.indicator θ' z‖ₑ ∂H
      = ENNReal.ofReal ((r ^ k)⁻¹) *
          ∫⁻ z in E ∩ closedBall x (R * r), ‖c * θ z - θ' z‖ₑ ∂H := by
        rw [← setLIntegral_indicator₀ _ hEB]
        congr 1
        refine lintegral_congr fun z => ?_
        by_cases hz : z ∈ E <;> simp [hz]
    _ ≤ ENNReal.ofReal ((r ^ k)⁻¹) * ∫⁻ z in E ∩ closedBall x (R * r),
          (‖c‖ₑ * ‖θ z - θ x‖ₑ + ‖θ' z - θ' x‖ₑ) ∂H := by
        gcongr with z
        calc ‖c * θ z - θ' z‖ₑ = ‖c * (θ z - θ x) - (θ' z - θ' x)‖ₑ := by
              rw [mul_sub, hcx]
              ring_nf
          _ ≤ ‖c * (θ z - θ x)‖ₑ + ‖θ' z - θ' x‖ₑ := enorm_sub_le
          _ = ‖c‖ₑ * ‖θ z - θ x‖ₑ + ‖θ' z - θ' x‖ₑ := by rw [enorm_mul]
    _ = ‖c‖ₑ * (ENNReal.ofReal ((r ^ k)⁻¹) *
            ∫⁻ y in E ∩ closedBall x (R * r), ‖θ y - θ x‖ₑ ∂H) +
          ENNReal.ofReal ((r ^ k)⁻¹) *
            ∫⁻ y in E ∩ closedBall x (R * r), ‖θ' y - θ' x‖ₑ ∂H := by
        rw [lintegral_add_left' hmeas, lintegral_const_mul' _ _ enorm_ne_top]
        ring

/-- Weighted approximate tangent spaces (Simon Ch. 3, 1.7) of two carriers agree on their
overlap, for arbitrary positive multiplicities.  As in Ch. 3, Remark 1.8(1), the overlap is cut
into pieces on which the multiplicities have a positive lower bound: a weight integrable on
`M ∩ K` for every compact `K` is `Hᵏ⌞M`-a.e. measurable (`ℝ^N = ⋃ₘ B̄ₘ(0)`), so the sets
`E j = M₁ ∩ {θ₁ ≥ 1/(j+1)} ∩ M₂ ∩ {θ₂ ≥ 1/(j+1)}` are `Hᵏ`-null-measurable, they exhaust
`M₁ ∩ M₂`, and `Hᵏ(E j ∩ K) ≤ (j+1) ∫_{M₁ ∩ K} θ₁ dHᵏ < ∞` by Chebyshev.  For `Hᵏ`-a.e.
`x ∈ E j`, a tangent space of `(M₁, θ₁)` at `x` is one of `(E j, θ₁)`
(`deformation_imcomb_subset_locality`), hence of `(E j, θ₂)`
(`deformation_imcomb_weight_change`), hence of `(M₂, θ₂)`; a countable union over `j` gives
the claim. -/
theorem Submission.deformation_imcomb_tangent_overlap :
    ∀ (N k : ℕ) (M₁ M₂ : Set (Eucl N)) (θ₁ θ₂ : Eucl N → ℝ),
      NullMeasurableSet M₁ (μHE[k] : Measure (Eucl N)) →
      NullMeasurableSet M₂ (μHE[k] : Measure (Eucl N)) →
      (∀ x ∈ M₁, 0 < θ₁ x) → (∀ x ∈ M₂, 0 < θ₂ x) →
      (∀ K : Set (Eucl N), IsCompact K → IntegrableOn θ₁ (M₁ ∩ K) (μHE[k] : Measure (Eucl N))) →
      (∀ K : Set (Eucl N), IsCompact K → IntegrableOn θ₂ (M₂ ∩ K) (μHE[k] : Measure (Eucl N))) →
      ∀ᵐ x ∂((μHE[k] : Measure (Eucl N)).restrict (M₁ ∩ M₂)), ∀ Q : Submodule ℝ (Eucl N),
        HasWeightedApproximateTangentSpaceAt k M₁ θ₁ x Q →
          HasWeightedApproximateTangentSpaceAt k M₂ θ₂ x Q := by
  intro N k M₁ M₂ θ₁ θ₂ hM₁ hM₂ hpos₁ hpos₂ hint₁ hint₂
  -- Superlevel sets `M ∩ {θ ≥ t}` of a locally integrable weight are null-measurable: `θ` is
  -- integrable on each `M ∩ B̄ₘ(0)`, hence a.e.-strongly measurable on `M`.
  have hsup : ∀ (M : Set (Eucl N)) (θ : Eucl N → ℝ),
      NullMeasurableSet M (μHE[k] : Measure (Eucl N)) →
      (∀ K : Set (Eucl N), IsCompact K → IntegrableOn θ (M ∩ K) (μHE[k] : Measure (Eucl N))) →
      ∀ t : ℝ, NullMeasurableSet (M ∩ {y | t ≤ θ y}) (μHE[k] : Measure (Eucl N)) := by
    intro M θ hM hint t
    have hθ : AEStronglyMeasurable θ ((μHE[k] : Measure (Eucl N)).restrict M) := by
      rw [← iUnion_inter_closedBall_nat M 0, aestronglyMeasurable_iUnion_iff]
      exact fun m => (hint _ (isCompact_closedBall _ _)).aestronglyMeasurable
    obtain ⟨g, hg, hθg⟩ := hθ
    have hθg' : ∀ᵐ y ∂(μHE[k] : Measure (Eucl N)), y ∈ M → θ y = g y :=
      (ae_restrict_iff'₀ hM).1 hθg
    have hgt : NullMeasurableSet (M ∩ {y | t ≤ g y}) (μHE[k] : Measure (Eucl N)) :=
      hM.inter (measurableSet_le measurable_const hg.measurable).nullMeasurableSet
    refine hgt.congr (eventuallyEqSet_iff.2 ?_)
    filter_upwards [hθg'] with y hy
    simp only [mem_inter_iff, mem_ofPred_eq]
    exact ⟨fun h => ⟨h.1, (hy h.1).symm ▸ h.2⟩, fun h => ⟨h.1, hy h.1 ▸ h.2⟩⟩
  -- The truncated overlaps `E j`, on which both weights are `≥ 1/(j+1)`, exhaust `M₁ ∩ M₂`.
  set E : ℕ → Set (Eucl N) := fun j =>
    (M₁ ∩ {y | 1 / ((j : ℝ) + 1) ≤ θ₁ y}) ∩ (M₂ ∩ {y | 1 / ((j : ℝ) + 1) ≤ θ₂ y}) with hE
  have hU : M₁ ∩ M₂ = ⋃ j, E j := by
    ext y
    simp only [hE, mem_iUnion, mem_inter_iff, mem_ofPred_eq]
    constructor
    · rintro ⟨h₁, h₂⟩
      obtain ⟨j, hj⟩ := exists_nat_one_div_lt (lt_min (hpos₁ y h₁) (hpos₂ y h₂))
      exact ⟨j, ⟨h₁, hj.le.trans (min_le_left _ _)⟩, h₂, hj.le.trans (min_le_right _ _)⟩
    · rintro ⟨j, ⟨h₁, -⟩, h₂, -⟩
      exact ⟨h₁, h₂⟩
  have hsub₁ : ∀ j, E j ⊆ M₁ := fun j y hy => hy.1.1
  have hsub₂ : ∀ j, E j ⊆ M₂ := fun j y hy => hy.2.1
  have hEm : ∀ j, NullMeasurableSet (E j) (μHE[k] : Measure (Eucl N)) := fun j =>
    (hsup M₁ θ₁ hM₁ hint₁ _).inter (hsup M₂ θ₂ hM₂ hint₂ _)
  -- `Hᵏ⌞E j` is locally finite: Chebyshev's inequality for `θ₁ ≥ 1/(j+1)` on `E j ∩ K`.
  have hfin : ∀ j, ∀ K : Set (Eucl N), IsCompact K →
      (μHE[k] : Measure (Eucl N)) (E j ∩ K) < ∞ := by
    intro j K hK
    have hc : (0 : ℝ≥0∞) < ENNReal.ofReal (1 / ((j : ℝ) + 1)) :=
      ENNReal.ofReal_pos.2 (by positivity)
    have hsub : E j ∩ K ⊆
        {y | ENNReal.ofReal (1 / ((j : ℝ) + 1)) ≤ ‖θ₁ y‖ₑ} ∩ (M₁ ∩ K) := by
      rintro y ⟨⟨⟨hy, hyc⟩, -⟩, hyK⟩
      refine ⟨?_, hy, hyK⟩
      simp only [mem_ofPred_eq] at hyc ⊢
      rw [Real.enorm_eq_ofReal_abs]
      exact ENNReal.ofReal_le_ofReal (hyc.trans (le_abs_self _))
    have hcheb := mul_meas_ge_le_lintegral₀ (hint₁ K hK).aestronglyMeasurable.enorm
      (ENNReal.ofReal (1 / ((j : ℝ) + 1)))
    exact ((measure_mono hsub).trans (Measure.le_restrict_apply _ _)).trans_lt
      (ENNReal.lt_top_of_mul_ne_top_right (hcheb.trans_lt (hint₁ K hK).hasFiniteIntegral).ne
        hc.ne')
  -- On each `E j`: `(M₁, θ₁) ⇒ (E j, θ₁) ⇒ (E j, θ₂) ⇒ (M₂, θ₂)`; then glue over `j`.
  rw [hU, ae_restrict_iUnion_iff]
  intro j
  have h₁ := Submission.deformation_imcomb_subset_locality N k (E j) M₁ θ₁ (hsub₁ j) (hEm j)
    hM₁ hint₁
  have h₁₂ := Submission.deformation_imcomb_weight_change N k (E j) θ₁ θ₂ (hEm j) (hfin j)
    (fun x hx => hpos₁ x (hsub₁ j hx))
    (fun K hK => (hint₁ K hK).mono_set (inter_subset_inter_left _ (hsub₁ j)))
    (fun K hK => (hint₂ K hK).mono_set (inter_subset_inter_left _ (hsub₂ j)))
  have h₂ := Submission.deformation_imcomb_subset_locality N k (E j) M₂ θ₂ (hsub₂ j) (hEm j)
    hM₂ hint₂
  filter_upwards [h₁, h₁₂, h₂] with x hx₁ hx₁₂ hx₂ Q hQ
  exact (hx₂ Q).2 (hx₁₂ Q ((hx₁ Q).1 hQ))

/-- **Integer combinations of integer multiplicity currents, Simon Ch. 6, Remark 3.2(1)
(p. 146).**  If `X = τ(M₁, θ₁, ξ₁)` and `Y = τ(M₂, θ₂, ξ₂)` are integer multiplicity and
`Z = a X + b Y` with `a, b ∈ ℤ`, then `Z` is integer multiplicity.  Write `a X + b Y` as the
integer series with terms `(M₁, θ₁, ξ₁)` (`r = 0`), `(M₂, θ₂, ξ₂)` (`r ≥ 1`) and coefficients
`c = (a, b, 0, 0, …)`; it converges absolutely, since only two terms are nonzero and `θᵢ` is
integrable on `Mᵢ ∩ W̄`.  The series theorem (Simon 3.13) combines it into one integer
multiplicity triple `τ(M', θ', ξ')` whose action is the sum `a X(ω) + b Y(ω) = Z(ω)`.  That
theorem needs weighted approximate tangent planes of two carriers to agree `Hᵏ`-a.e. on their
overlap; on `ℝ^N` this is the tangent comparison (Simon Ch. 3, 1.8(1)). -/
theorem Submission.deformation_im_combination : ∀ (N k : ℕ) (X Y Z : GeometricCurrentOn (univ : Set (Eucl N)) k) (a b : ℤ), IsIntegerMultiplicity X → IsIntegerMultiplicity Y → (∀ ω, Z ω = a * X ω + b * Y ω) → IsIntegerMultiplicity Z := by
  intro N k X Y Z a b hX hY hZ
  obtain ⟨M₁, θ₁, ξ₁, hT₁, hθ₁, hX⟩ := hX
  obtain ⟨M₂, θ₂, ξ₂, hT₂, hθ₂, hY⟩ := hY
  -- The two-term series `a τ(M₁, θ₁, ξ₁) + b τ(M₂, θ₂, ξ₂)`.
  let Ms : ℕ → Set (Eucl N) := fun r => if r = 0 then M₁ else M₂
  let θs : ℕ → Eucl N → ℝ := fun r => if r = 0 then θ₁ else θ₂
  let ξs : ℕ → Eucl N → NVector (Eucl N) k := fun r => if r = 0 then ξ₁ else ξ₂
  let c : ℕ → ℤ := fun r => if r = 0 then a else if r = 1 then b else 0
  have hc : ∀ r ∉ ({0, 1} : Finset ℕ), c r = 0 := by
    intro r hr
    simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hr
    simp only [c, hr.1, hr.2, ↓reduceIte]
  have hTs : ∀ r, IsRectifiableTriple univ k (Ms r) (θs r) (ξs r) := by
    intro r
    by_cases hr : r = 0
    · simpa only [Ms, θs, ξs, hr, ↓reduceIte] using hT₁
    · simpa only [Ms, θs, ξs, hr, ↓reduceIte] using hT₂
  have hθs : ∀ r, ∀ x ∈ Ms r, ∃ m : ℕ, θs r x = m := by
    intro r
    by_cases hr : r = 0
    · simpa only [Ms, θs, hr, ↓reduceIte] using hθ₁
    · simpa only [Ms, θs, hr, ↓reduceIte] using hθ₂
  -- `∫_{M ∩ W} θ dHᵏ < ∞` for `W ⊂⊂ ℝ^N`, since `θ` is integrable on `M ∩ W̄`.
  have hfin : ∀ (A : Set (Eucl N)) (ϑ : Eucl N → ℝ) (ζ : Eucl N → NVector (Eucl N) k),
      IsRectifiableTriple univ k A ϑ ζ → ∀ W, CompactlyContainedOpen W (univ : Set (Eucl N)) →
        ∫⁻ x in A ∩ W, ENNReal.ofReal (ϑ x) ∂(μHE[k] : Measure (Eucl N)) < ∞ := by
    intro A ϑ ζ hT W hW
    exact (lintegral_mono_set (inter_subset_inter_right A subset_closure)).trans_lt
      (Integrable.lintegral_lt_top (hT.integrableOn _ hW.2.1 (subset_univ _)))
  have hsum : ∀ W, CompactlyContainedOpen W (univ : Set (Eucl N)) →
      (∑' r, ((c r).natAbs : ℝ≥0∞) * ∫⁻ x in Ms r ∩ W, ENNReal.ofReal (θs r x)
        ∂(μHE[k] : Measure (Eucl N))) < ∞ := by
    intro W hW
    have h0 : ∀ r ∉ ({0, 1} : Finset ℕ), ((c r).natAbs : ℝ≥0∞) *
        ∫⁻ x in Ms r ∩ W, ENNReal.ofReal (θs r x) ∂(μHE[k] : Measure (Eucl N)) = 0 := by
      intro r hr
      rw [hc r hr, Int.natAbs_zero, Nat.cast_zero, zero_mul]
    rw [tsum_eq_sum (L := SummationFilter.unconditional ℕ) h0, Finset.sum_pair zero_ne_one]
    exact ENNReal.add_lt_top.2 ⟨ENNReal.mul_lt_top (ENNReal.natCast_lt_top _)
      (hfin M₁ θ₁ ξ₁ hT₁ W hW), ENNReal.mul_lt_top (ENNReal.natCast_lt_top _)
      (hfin M₂ θ₂ ξ₂ hT₂ W hW)⟩
  -- Simon 3.13 for the series, with the tangent comparison on overlaps in `U = ℝ^N`.
  obtain ⟨M', θ', ξ', hT', hθ', hS⟩ := Submission.fiw_ims_combine N k univ isOpen_univ
    (fun A₁ A₂ ϑ₁ ϑ₂ _ _ hm₁ hm₂ hp₁ hp₂ hi₁ hi₂ =>
      Submission.deformation_imcomb_tangent_overlap N k A₁ A₂ ϑ₁ ϑ₂ hm₁ hm₂ hp₁ hp₂
        (fun K hK => hi₁ K hK (subset_univ K)) (fun K hK => hi₂ K hK (subset_univ K)))
    Ms θs ξs c hTs hθs hsum
  refine ⟨M', θ', ξ', hT', hθ', fun ω => ?_⟩
  -- The series has only the terms `r = 0, 1`, whose sum is `a X(ω) + b Y(ω) = Z(ω)`.
  have hfs := hasSum_sum_of_ne_finset_zero (L := SummationFilter.unconditional ℕ)
    (f := fun r => (c r : ℝ) * tauAction k (Ms r) (θs r) (ξs r) ω) (s := {0, 1})
    fun r hr => by simp only [hc r hr, Int.cast_zero, zero_mul]
  rw [Finset.sum_pair zero_ne_one] at hfs
  rw [hZ ω, hX ω, hY ω]
  exact hfs.unique (hS ω)

/-- Weighted approximate tangent spaces (Simon Ch. 3, 1.7) are invariant under the dilation
`y ↦ ρ y`, `ρ > 0`: if `Q` is the approximate tangent space of `(M, θ)` at `x`, it is the
approximate tangent space of `(ρ M, θ(ρ⁻¹ ·))` at `ρ x`.  The blow-up of `ρ M` at `ρ x` with
ratio `s` is the blow-up of `M` at `x` with ratio `ρ⁻¹ s`, and `s ↦ ρ⁻¹ s` preserves `𝓝[>] 0`. -/
theorem Submission.deformation_dilation_im_weightedTangent :
    ∀ (N k : ℕ) (ρ : ℝ) (M : Set (Eucl N)) (θ : Eucl N → ℝ) (x : Eucl N)
      (Q : Submodule ℝ (Eucl N)), 0 < ρ → HasWeightedApproximateTangentSpaceAt k M θ x Q →
        HasWeightedApproximateTangentSpaceAt k ((fun y : Eucl N => ρ • y) '' M)
          (fun y : Eucl N => θ (ρ⁻¹ • y)) (ρ • x) Q := by
  intro N k ρ M θ x Q hρ hQ
  -- The new multiplicity at `ρ x` is `θ(x)`.
  have hval : θ (ρ⁻¹ • ρ • x) = θ x := by rw [inv_smul_smul₀ hρ.ne']
  -- Blow-ups of `ρ M` at `ρ x` with ratio `s` are blow-ups of `M` at `x` with ratio `ρ⁻¹ s`.
  have hset : ∀ s : ℝ,
      Poincare.SimonGMT.Chapter03.blowUpMap (ρ • x) s '' ((fun y : Eucl N => ρ • y) '' M) =
        Poincare.SimonGMT.Chapter03.blowUpMap x (ρ⁻¹ * s) '' M := by
    intro s
    rw [Set.image_image]
    refine Set.image_congr fun z _ => ?_
    simp only [Poincare.SimonGMT.Chapter03.blowUpMap]
    rw [← smul_sub, smul_smul, mul_inv_rev, inv_inv]
  have hweight : ∀ (s : ℝ) (u : Eucl N),
      θ (ρ⁻¹ • (ρ • x + s • u)) = θ (x + (ρ⁻¹ * s) • u) := by
    intro s u
    rw [smul_add, inv_smul_smul₀ hρ.ne', smul_smul]
  -- `s ↦ ρ⁻¹ s` maps `𝓝[>] 0` to itself.
  have hlim : Tendsto (fun s : ℝ => ρ⁻¹ * s) (𝓝[>] 0) (𝓝[>] 0) := by
    have h0 : Tendsto (fun s : ℝ => ρ⁻¹ * s) (𝓝 0) (𝓝 (ρ⁻¹ * 0)) :=
      (continuous_const_mul ρ⁻¹).tendsto 0
    rw [mul_zero] at h0
    exact tendsto_nhdsWithin_iff.2 ⟨h0.mono_left nhdsWithin_le_nhds,
      eventually_nhdsWithin_of_forall fun s hs => mul_pos (inv_pos.2 hρ) hs⟩
  refine ⟨hQ.1, fun f => ?_⟩
  show Tendsto _ _ (𝓝 (θ (ρ⁻¹ • ρ • x) * _))
  rw [hval]
  refine ((hQ.2 f).comp hlim).congr fun s => ?_
  simp only [Function.comp_apply, hset, hweight]

/-- Rectifiable triples are invariant under the dilation `φ(x) = ρ x`, `ρ > 0`:
`(φ(M), θ ∘ φ⁻¹, ξ ∘ φ⁻¹)` is again a rectifiable triple, where `φ⁻¹(y) = ρ⁻¹ y`.
`φ` is a measurable embedding pushing `c Hᵏ`, `c = ρᵏ`, forward to `Hᵏ`, so
`Hᵏ(φ(S)) = c Hᵏ(S)` for every `S` and `Hᵏ ⌞ φ(M) = φ_#(c Hᵏ ⌞ M)`; an approximate tangent
space of `(M, θ)` at `x` is one of `(φ(M), θ ∘ φ⁻¹)` at `φ(x)`. -/
theorem Submission.deformation_dilation_im_rectifiableTriple :
    ∀ (N k : ℕ) (ρ : ℝ) (M : Set (Eucl N)) (θ : Eucl N → ℝ) (ξ : Eucl N → NVector (Eucl N) k),
      0 < ρ → MeasurableEmbedding (fun x : Eucl N => ρ • x) →
      MeasurePreserving (fun x : Eucl N => ρ • x)
        (ENNReal.ofReal (ρ ^ k) • (μHE[k] : Measure (Eucl N))) (μHE[k] : Measure (Eucl N)) →
      IsRectifiableTriple (univ : Set (Eucl N)) k M θ ξ →
      IsRectifiableTriple (univ : Set (Eucl N)) k ((fun x : Eucl N => ρ • x) '' M)
        (fun y : Eucl N => θ (ρ⁻¹ • y)) (fun y : Eucl N => ξ (ρ⁻¹ • y)) := by
  intro N k ρ M θ ξ hρ hemb hmp hT
  set φ : Eucl N → Eucl N := fun x => ρ • x
  set c : ℝ≥0∞ := ENNReal.ofReal (ρ ^ k)
  -- `ρ⁻¹ • φ(x) = x`, so `θ(ρ⁻¹ • ·) ∘ φ = θ` and `ξ(ρ⁻¹ • ·) ∘ φ = ξ`.
  have hinv : ∀ x, ρ⁻¹ • φ x = x := fun x => inv_smul_smul₀ hρ.ne' x
  -- `Hᵏ(φ(S)) = c Hᵏ(S)` for every `S`; in particular `φ` maps `Hᵏ`-null sets to null sets.
  have hnull : ∀ S : Set (Eucl N), (μHE[k] : Measure (Eucl N)) S = 0 →
      (μHE[k] : Measure (Eucl N)) (φ '' S) = 0 := by
    intro S hS
    rw [← hmp.map_eq, hemb.map_apply, preimage_image_eq _ hemb.injective, Measure.smul_apply, hS,
      smul_zero]
  -- `Hᵏ ⌞ φ(M) = φ_#(c Hᵏ ⌞ M)`.
  have hres : MeasurePreserving φ (c • (μHE[k] : Measure (Eucl N)).restrict M)
      ((μHE[k] : Measure (Eucl N)).restrict (φ '' M)) := by
    rw [← Measure.restrict_smul]
    exact hmp.restrict_image_emb hemb M
  refine ⟨subset_univ _, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- `φ(M) =ᵐ φ(B)` for the measurable hull `B` of `M`.
    have hB := hT.nullMeasurableSet.toMeasurable_ae_eq
    rw [ae_eq_set] at hB
    refine (hemb.measurableSet_image.2
      (measurableSet_toMeasurable (μHE[k] : Measure (Eucl N)) M)).nullMeasurableSet.congr ?_
    rw [ae_eq_set, ← image_sdiff hemb.injective, ← image_sdiff hemb.injective]
    exact ⟨hnull _ hB.1, hnull _ hB.2⟩
  · -- `φ(M) ⊆ φ(M₀) ∪ ⋃ⱼ range (φ ∘ Fⱼ)` with `φ` Lipschitz.
    obtain ⟨M₀, hM₀, F, hF, hMF⟩ := hT.countablyRectifiable
    have hφL : LipschitzWith ‖ρ‖₊ φ := LipschitzWith.of_dist_le_mul fun a b => by
      show dist (ρ • a) (ρ • b) ≤ ‖ρ‖₊ * dist a b
      rw [dist_smul₀, coe_nnnorm]
    refine ⟨φ '' M₀, hnull M₀ hM₀, fun j => φ ∘ F j, fun j => ?_, ?_⟩
    · obtain ⟨K, hK⟩ := hF j
      exact ⟨‖ρ‖₊ * K, hφL.comp hK⟩
    · rintro _ ⟨y, hy, rfl⟩
      rcases hMF hy with hy₀ | hy₁
      · exact Or.inl (mem_image_of_mem φ hy₀)
      · obtain ⟨j, w, rfl⟩ := mem_iUnion.1 hy₁
        exact Or.inr (mem_iUnion.2 ⟨j, w, rfl⟩)
  · rintro _ ⟨y, hy, rfl⟩
    show 0 < θ (ρ⁻¹ • φ y)
    rw [hinv]
    exact hT.pos y hy
  · -- `φ(M) ∩ K = φ(M ∩ φ⁻¹(K))` with `φ⁻¹(K)` compact, and `φ_#(c Hᵏ) = Hᵏ`.
    intro K hK _
    have hK' : IsCompact (φ ⁻¹' K) :=
      (Homeomorph.smulOfNeZero ρ hρ.ne').isCompact_preimage.2 hK
    have hθ : (fun y => θ (ρ⁻¹ • y)) ∘ φ = θ := funext fun y => by
      simp only [Function.comp_apply, hinv]
    rw [← image_inter_preimage, hmp.integrableOn_image hemb, hθ, IntegrableOn,
      Measure.restrict_smul]
    exact Integrable.smul_measure (hT.integrableOn _ hK' (subset_univ _)) ENNReal.ofReal_ne_top
  · have hξ : (fun y => ξ (ρ⁻¹ • y)) ∘ φ = ξ := funext fun y => by
      simp only [Function.comp_apply, hinv]
    rw [← hres.map_eq, hemb.aestronglyMeasurable_map_iff, hξ]
    exact hT.aestronglyMeasurable.smul_measure c
  · -- At `φ(x)` the frame `τ` of `(M, θ, ξ)` at `x` still orients `(φ(M), θ', ξ')`.
    rw [← hres.map_eq, hemb.ae_map_iff]
    filter_upwards [Measure.ae_smul_measure hT.orients c] with y hy
    obtain ⟨τ, hτ, htan, hξy⟩ := hy
    refine ⟨τ, hτ, Submission.deformation_dilation_im_weightedTangent N k ρ M θ y _ hρ htan, ?_⟩
    show ξ (ρ⁻¹ • φ y) = _ ∨ ξ (ρ⁻¹ • φ y) = _
    rw [hinv]
    exact hξy

/-- `τ(M, θ, ξ)` tested against `x ↦ ρᵏ ω(ρx)` equals `τ(φ(M), θ ∘ φ⁻¹, ξ ∘ φ⁻¹)` tested against
`ω`, `φ(x) = ρx`, `ρ > 0`, when `φ` is a measurable embedding pushing `ρᵏ Hᵏ` forward to `Hᵏ`:
change variables and pull `ρᵏ` out of the linear `ξ(x)`. -/
theorem Submission.deformation_dilation_im_tauAction :
    ∀ (N k : ℕ) (ρ : ℝ) (M : Set (Eucl N)) (θ : Eucl N → ℝ) (ξ : Eucl N → NVector (Eucl N) k)
      (ω : DifferentialForm (Eucl N) k), 0 < ρ → MeasurableEmbedding (fun x : Eucl N => ρ • x) →
      MeasurePreserving (fun x : Eucl N => ρ • x)
        (ENNReal.ofReal (ρ ^ k) • (μHE[k] : Measure (Eucl N))) (μHE[k] : Measure (Eucl N)) →
      tauAction k M θ ξ (fun x : Eucl N => ρ ^ k • ω (ρ • x)) =
        tauAction k ((fun x : Eucl N => ρ • x) '' M) (fun y : Eucl N => θ (ρ⁻¹ • y))
          (fun y : Eucl N => ξ (ρ⁻¹ • y)) ω := by
  intro N k ρ M θ ξ ω hρ hemb hmp
  -- Change variables `y = ρx` on the right: `∫_{φ(M)} g dHᵏ = ∫_M g ∘ φ d(ρᵏ Hᵏ)`.
  simp only [tauAction]
  rw [hmp.setIntegral_image_emb hemb (fun y => θ (ρ⁻¹ • y) * ξ (ρ⁻¹ • y) (ω y)) M,
    Measure.restrict_smul, integral_smul_measure, ENNReal.toReal_ofReal (by positivity),
    smul_eq_mul, ← integral_const_mul]
  -- Pointwise, `ρ⁻¹ • ρx = x`, and `ξ(x)` is linear.
  congr 1
  funext x
  simp only [inv_smul_smul₀ hρ.ne', map_smul, smul_eq_mul]
  ring

/-- Dilation calculus on `ℝ^N` for `η_ρ(x) = ρ x`, `ρ > 0` (Simon Ch. 6, 2.23, 2.24(1) and
§1, 1.14): `η_ρ^# ω = ρ^k ω(ρ ·)` is a test form; every current `X` has the push-forward
`Y = X ∘ η_ρ^#`, i.e. `Y(ω) = X(η_ρ^# ω)`; and push-forward commutes with `∂`, because
`d(η_ρ^# ω) = η_ρ^#(dω)`. -/
theorem Submission.deformation_dilation_calculus :
    ∀ (N : ℕ) (ρ : ℝ), 0 < ρ → ∀ k : ℕ, (∀ ω : TestFormOn (univ : Set (Eucl N)) k, ∃ η : TestFormOn (univ : Set (Eucl N)) k, ∀ x, (η : DifferentialForm (Eucl N) k) x = ρ ^ k • (ω : DifferentialForm (Eucl N) k) (ρ • x)) ∧ (∀ X : GeometricCurrentOn (univ : Set (Eucl N)) k, ∃ Y : GeometricCurrentOn (univ : Set (Eucl N)) k, (∀ ω η : TestFormOn (univ : Set (Eucl N)) k, (∀ x, (η : DifferentialForm (Eucl N) k) x = ρ ^ k • (ω : DifferentialForm (Eucl N) k) (ρ • x)) → Y ω = X η)) ∧ ∀ X Y : GeometricCurrentOn (univ : Set (Eucl N)) (k + 1), (∀ ω η : TestFormOn (univ : Set (Eucl N)) (k + 1), (∀ x, (η : DifferentialForm (Eucl N) (k + 1)) x = ρ ^ (k + 1) • (ω : DifferentialForm (Eucl N) (k + 1)) (ρ • x)) → Y ω = X η) → ∀ ω η : TestFormOn (univ : Set (Eucl N)) k, (∀ x, (η : DifferentialForm (Eucl N) k) x = ρ ^ k • (ω : DifferentialForm (Eucl N) k) (ρ • x)) → Y.boundary ω = X.boundary η := by
  intro N ρ hρ k
  -- Step 2: `x ↦ ρ • x` is a homeomorphism, so preimages of compact sets are compact.
  have hcpt : ∀ K : Set (Eucl N), IsCompact K → IsCompact ((fun x : Eucl N => ρ • x) ⁻¹' K) :=
    fun K hK => (Homeomorph.smulOfNeZero ρ hρ.ne').isCompact_preimage.2 hK
  -- Step 3(b): `tsupport (ρ ^ k • ω(ρ ·)) ⊆ (ρ ·)⁻¹ (tsupport ω)`.
  have hsupp : ∀ ω : TestFormOn (univ : Set (Eucl N)) k,
      tsupport (fun x => ρ ^ k • (ω : DifferentialForm (Eucl N) k) (ρ • x)) ⊆
        (fun x : Eucl N => ρ • x) ⁻¹' tsupport (ω : DifferentialForm (Eucl N) k) := fun ω =>
    (tsupport_smul_subset_right (fun _ => ρ ^ k) _).trans
      (tsupport_comp_subset_preimage _ (continuous_const_smul ρ))
  -- Step 3: `ρ ^ k • ω(ρ ·)` is again a test form.
  have hmem : ∀ ω : TestFormOn (univ : Set (Eucl N)) k,
      (fun x => ρ ^ k • (ω : DifferentialForm (Eucl N) k) (ρ • x)) ∈
        testFormOnSubmodule (univ : Set (Eucl N)) k := fun ω =>
    ⟨⟨(ω.property.1.1.comp (contDiff_const_smul ρ)).const_smul (ρ ^ k),
      (hcpt _ ω.property.1.2).of_isClosed_subset (isClosed_tsupport _) (hsupp ω)⟩, subset_univ _⟩
  -- Step 4: the pull-back operator `P ω = ρ ^ k • ω(ρ ·)`.
  let P : TestFormOn (univ : Set (Eucl N)) k →ₗ[ℝ] TestFormOn (univ : Set (Eucl N)) k :=
    { toFun := fun ω => ⟨fun x => ρ ^ k • (ω : DifferentialForm (Eucl N) k) (ρ • x), hmem ω⟩
      map_add' := fun ω η => by
        apply Subtype.ext
        funext x
        simp [smul_add]
      map_smul' := fun c ω => by
        apply Subtype.ext
        funext x
        simp [smul_comm c] }
  -- Iterated derivatives: `D^i (P ω) x = (ρ ^ k * ρ ^ i) • D^i ω (ρ • x)`.
  have hD : ∀ (ω : TestFormOn (univ : Set (Eucl N)) k) (i : ℕ) (x : Eucl N),
      iteratedFDeriv ℝ i (P ω : DifferentialForm (Eucl N) k) x =
        (ρ ^ k * ρ ^ i) • iteratedFDeriv ℝ i (ω : DifferentialForm (Eucl N) k) (ρ • x) := by
    intro ω i x
    have hωi : ContDiff ℝ i (ω : DifferentialForm (Eucl N) k) := ω.property.1.1.of_le (by simp)
    have hc : ContDiff ℝ i (fun y => (ω : DifferentialForm (Eucl N) k) (ρ • y)) :=
      hωi.comp (contDiff_const_smul ρ)
    show iteratedFDeriv ℝ i (fun y => ρ ^ k • (ω : DifferentialForm (Eucl N) k) (ρ • y)) x = _
    rw [iteratedFDeriv_const_smul_apply' hc.contDiffAt, iteratedFDeriv_comp_const_smul ρ hωi,
      mul_smul]
  -- Step 4(b): `P` is sequentially continuous at `0` for Simon's test-form topology.
  have hconv : ∀ ωseq : ℕ → TestFormOn (univ : Set (Eucl N)) k,
      TestFormOnConverges ωseq 0 → TestFormOnConverges (fun j => P (ωseq j)) 0 := by
    rintro ωseq ⟨K, hK, -, hseq, -, hderiv⟩
    refine ⟨(fun x : Eucl N => ρ • x) ⁻¹' K, hcpt K hK, subset_univ _,
      fun j => (hsupp (ωseq j)).trans (preimage_mono (hseq j)), by simp, fun i => ?_⟩
    have hcomp := (uniformContinuous_const_smul (ρ ^ k * ρ ^ i)).comp_tendstoUniformlyOn
      ((hderiv i).comp (fun x : Eucl N => ρ • x))
    refine (hcomp.congr (Eventually.of_forall fun j x _ => (hD (ωseq j) i x).symm)).congr_right
      fun x _ => ?_
    simp
  -- Step 1: scaling identity `α (ρ v₁, …, ρ v_j) = ρ ^ j α (v₁, …, v_j)`.
  have hscale : ∀ (j : ℕ) (α : Covector (Eucl N) j),
      α.compContinuousLinearMap (ρ • ContinuousLinearMap.id ℝ (Eucl N)) = ρ ^ j • α := by
    intro j α
    ext v
    have h := α.map_smul_univ (fun _ => ρ) v
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin] at h
    rw [ContinuousAlternatingMap.compContinuousLinearMap_apply,
      ContinuousAlternatingMap.smul_apply, ← h]
    rfl
  refine ⟨fun ω => ⟨P ω, fun x => rfl⟩,
    fun X => ⟨⟨X.toCurrent.comp P, fun ωseq h => X.continuous' _ (hconv ωseq h)⟩,
      fun ω η hη => ?_⟩, ?_⟩
  · -- Step 5: `Y ω = X (P ω) = X η`.
    show X.toCurrent (P ω) = X.toCurrent η
    congr 1
    exact Subtype.ext (funext fun x => (hη x).symm)
  · -- Step 7: apply the degree `k + 1` pair property to `(dω, dη)`.
    intro X Y hXY ω η hη
    rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.boundary_apply]
    apply hXY
    intro x
    show extDeriv (η : DifferentialForm (Eucl N) k) x =
      ρ ^ (k + 1) • extDeriv (ω : DifferentialForm (Eucl N) k) (ρ • x)
    -- Step 6: `d` commutes with the pull-back by `L = ρ • id`.
    set L : Eucl N →L[ℝ] Eucl N := ρ • ContinuousLinearMap.id ℝ (Eucl N)
    have hη' : (η : DifferentialForm (Eucl N) k) =
        fun y => ((ω : DifferentialForm (Eucl N) k) (L y)).compContinuousLinearMap
          (fderiv ℝ L y) := by
      funext y
      rw [hη y, L.fderiv, hscale]
      rfl
    rw [hη', extDeriv_pullback (r := ((⊤ : ℕ∞) : WithTop ℕ∞))
      ((ω.property.1.1.differentiable (by simp)).differentiableAt)
      L.contDiff.contDiffAt (by simp), L.fderiv, hscale]
    rfl

/-- `Hᵏ` scaling law for the dilation `φ(x) = ρ • x`, `ρ > 0`: `φ` is a measurable embedding and
pushes `ρᵏ Hᵏ` forward to `Hᵏ`, i.e. `Hᵏ(φ⁻¹(B)) = ρ⁻ᵏ Hᵏ(B)`. -/
theorem Submission.deformation_dilation_hausdorff : ∀ (N k : ℕ) (ρ : ℝ), 0 < ρ → MeasurableEmbedding (fun x : Eucl N => ρ • x) ∧ MeasurePreserving (fun x : Eucl N => ρ • x) (ENNReal.ofReal (ρ ^ k) • (μHE[k] : Measure (Eucl N))) (μHE[k] : Measure (Eucl N)) := by
  intro N k ρ hρ
  -- `φ` is the homeomorphism `Homeomorph.smulOfNeZero ρ`, hence a measurable embedding.
  have hemb : MeasurableEmbedding (fun x : Eucl N => ρ • x) :=
    (Homeomorph.smulOfNeZero ρ hρ.ne').measurableEmbedding
  refine ⟨hemb, hemb.measurable, ?_⟩
  -- For measurable `B`: `φ⁻¹(B) = ρ⁻¹ • B` and `Hᵏ(ρ⁻¹ • B) = ‖ρ⁻¹‖₊ᵏ Hᵏ(B)`.
  ext B hB
  rw [Measure.map_apply hemb.measurable hB, Measure.smul_apply, Set.preimage_smul₀ hρ.ne',
    Measure.euclideanHausdorffMeasure_smul₀ k (inv_ne_zero hρ.ne') B, ENNReal.smul_def,
    smul_eq_mul, smul_eq_mul, ← mul_assoc]
  -- `ofReal(ρᵏ) ‖ρ⁻¹‖₊ᵏ = ofReal((ρ ρ⁻¹)ᵏ) = 1`.
  have hc : ENNReal.ofReal (ρ ^ k) * ((‖ρ⁻¹‖₊ ^ k : ℝ≥0) : ℝ≥0∞) = 1 := by
    rw [← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_mul (pow_nonneg hρ.le k), NNReal.coe_pow,
      coe_nnnorm, Real.norm_of_nonneg (inv_nonneg.mpr hρ.le), ← mul_pow, mul_inv_cancel₀ hρ.ne',
      one_pow, ENNReal.ofReal_one]
  rw [hc, one_mul]

/-- Mass scaling under dilation (Simon Ch. 6, 2.23 for `η_ρ(x) = ρx`, where
`|η_ρ^# ω|(x) = ρᵏ |ω(ρx)|`): if `Y(ω) = X(η)` whenever `η(x) = ρᵏ ω(ρx)`, then `M(Y) = ρᵏ M(X)`.
For a `σ`-pair `(A, B)` and `ω` admissible for `M(B)`, the pull-back `η = σᵏ ω(σ ·)` gives the
admissible form `σ⁻ᵏ η = ω(σ ·)` for `M(A)` and `B(ω) = σᵏ A(σ⁻ᵏ η)`, so `M(B) ≤ σᵏ M(A)`.  As
`(Y, X)` is a `ρ⁻¹`-pair, also `M(X) ≤ ρ⁻ᵏ M(Y)`, and the two bounds give equality in `[0, ∞]`. -/
theorem Submission.deformation_dilation_mass : ∀ (N : ℕ) (ρ : ℝ), 0 < ρ → ∀ k : ℕ, ∀ X Y : GeometricCurrentOn (univ : Set (Eucl N)) k, (∀ ω η : TestFormOn (univ : Set (Eucl N)) k, (∀ x, (η : DifferentialForm (Eucl N) k) x = ρ ^ k • (ω : DifferentialForm (Eucl N) k) (ρ • x)) → Y ω = X η) → Y.mass = ENNReal.ofReal (ρ ^ k) * X.mass := by
  intro N ρ hρ k X Y hXY
  -- `M(B) ≤ σᵏ M(A)` for every `σ`-pair `(A, B)`, `σ > 0`.
  have half : ∀ σ : ℝ, 0 < σ → ∀ A B : GeometricCurrentOn (univ : Set (Eucl N)) k,
      (∀ ω η : TestFormOn (univ : Set (Eucl N)) k,
        (∀ x, (η : DifferentialForm (Eucl N) k) x =
          σ ^ k • (ω : DifferentialForm (Eucl N) k) (σ • x)) → B ω = A η) →
      B.mass ≤ ENNReal.ofReal (σ ^ k) * A.mass := by
    intro σ hσ A B hAB
    have hσk : σ ^ k ≠ 0 := pow_ne_zero k hσ.ne'
    apply sSup_le
    rintro _ ⟨ω, hω, rfl⟩
    show ENNReal.ofReal (B ω) ≤ _
    obtain ⟨η, hη⟩ := (Submission.deformation_dilation_calculus N σ hσ k).1 ω
    -- `σ⁻ᵏ η = ω(σ ·)` is admissible for `M(A)`.
    have hη' : ∀ x, (((σ ^ k)⁻¹ • η : TestFormOn (univ : Set (Eucl N)) k) :
        DifferentialForm (Eucl N) k) x = (ω : DifferentialForm (Eucl N) k) (σ • x) := by
      intro x
      rw [Submodule.coe_smul, Pi.smul_apply, hη x, smul_smul, inv_mul_cancel₀ hσk, one_smul]
    have hadm : (σ ^ k)⁻¹ • η ∈ massAdmissibleOn univ k univ := by
      refine ⟨subset_univ _, fun x => ?_⟩
      rw [hη' x]
      exact hω.2 _
    -- `B ω = A η = σᵏ A(σ⁻ᵏ η)`.
    have hB : B ω = σ ^ k * A ((σ ^ k)⁻¹ • η) := by
      rw [hAB ω η hη, map_smul, smul_eq_mul, ← mul_assoc, mul_inv_cancel₀ hσk, one_mul]
    rw [hB, ENNReal.ofReal_mul (pow_nonneg hσ.le k)]
    exact mul_le_mul_right (A.le_massOn hadm) _
  -- `(Y, X)` is a `ρ⁻¹`-pair: `η(x) = ρ⁻ᵏ ω(ρ⁻¹x)` for all `x` gives `ω(x) = ρᵏ η(ρx)`.
  have hYX : ∀ ω η : TestFormOn (univ : Set (Eucl N)) k,
      (∀ x, (η : DifferentialForm (Eucl N) k) x =
        ρ⁻¹ ^ k • (ω : DifferentialForm (Eucl N) k) (ρ⁻¹ • x)) → X ω = Y η := by
    intro ω η hη
    refine (hXY η ω fun x => ?_).symm
    rw [hη (ρ • x), inv_smul_smul₀ hρ.ne', smul_smul, ← mul_pow, mul_inv_cancel₀ hρ.ne',
      one_pow, one_smul]
  -- `M(Y) ≤ ρᵏ M(X)` and `ρᵏ M(X) ≤ ρᵏ ρ⁻ᵏ M(Y) = M(Y)`.
  refine le_antisymm (half ρ hρ X Y hXY) ?_
  calc ENNReal.ofReal (ρ ^ k) * X.mass
      ≤ ENNReal.ofReal (ρ ^ k) * (ENNReal.ofReal (ρ⁻¹ ^ k) * Y.mass) :=
        mul_le_mul_right (half ρ⁻¹ (inv_pos.2 hρ) Y X hYX) _
    _ = Y.mass := by
        rw [← mul_assoc, ← ENNReal.ofReal_mul (pow_nonneg hρ.le k), ← mul_pow,
          mul_inv_cancel₀ hρ.ne', one_pow, ENNReal.ofReal_one, one_mul]

/-- Support scaling under dilation (Simon Ch. 6, 2.11, for the change of scale `x ↦ ρx` used
to pass from 5.1 to 5.3).  Call `(A, B)` a `σ`-pair if `B(ω) = A(η)` whenever
`η(x) = σᵏ ω(σx)`.  If `(A, B)` is a `σ`-pair and `A` vanishes on an open `W` with compact
closure, then `B` vanishes on `σW`: the pull-back `η` of `ω` (first conjunct of
`Submission.deformation_dilation_calculus`) has `tsupport η ⊆ σ⁻¹ tsupport ω ⊆ W`.
Hence `σ zeroRegion(A) ⊆ zeroRegion(B)`.  Since `(Y, X)` is a `ρ⁻¹`-pair,
`zeroRegion(Y) = ρ zeroRegion(X)`, and complements commute with the bijection `x ↦ ρx`. -/
theorem Submission.deformation_dilation_support : ∀ (N : ℕ) (ρ : ℝ), 0 < ρ → ∀ k : ℕ, ∀ X Y : GeometricCurrentOn (univ : Set (Eucl N)) k, (∀ ω η : TestFormOn (univ : Set (Eucl N)) k, (∀ x, (η : DifferentialForm (Eucl N) k) x = ρ ^ k • (ω : DifferentialForm (Eucl N) k) (ρ • x)) → Y ω = X η) → Y.support = (fun x => ρ • x) '' X.support := by
  intro N ρ hρ k X Y hXY
  -- Step 1: for a `σ`-pair `(A, B)`, `σ zeroRegion(A) ⊆ zeroRegion(B)`.
  have hzero_image : ∀ σ : ℝ, 0 < σ → ∀ A B : GeometricCurrentOn (univ : Set (Eucl N)) k,
      (∀ ω η : TestFormOn (univ : Set (Eucl N)) k,
        (∀ x, (η : DifferentialForm (Eucl N) k) x =
          σ ^ k • (ω : DifferentialForm (Eucl N) k) (σ • x)) → B ω = A η) →
      (fun x => σ • x) '' A.zeroRegion ⊆ B.zeroRegion := by
    intro σ hσ A B hAB
    let φ : Eucl N ≃ₜ Eucl N := Homeomorph.smulOfNeZero σ hσ.ne'
    rintro _ ⟨x, ⟨W, ⟨hWo, hWc, -, hWv⟩, hxW⟩, rfl⟩
    refine ⟨φ '' W, ⟨φ.isOpenMap W hWo, ?_, subset_univ _, ?_⟩, mem_image_of_mem φ hxW⟩
    · rw [← φ.image_closure]
      exact hWc.image φ.continuous
    · -- `B(ω) = A(η)` for the pull-back `η = σᵏ ω(σ ·)`, and `tsupport η ⊆ σ⁻¹ tsupport ω ⊆ W`.
      intro ω hω
      obtain ⟨η, hη⟩ := (Submission.deformation_dilation_calculus N σ hσ k).1 ω
      rw [hAB ω η hη]
      apply hWv η
      have hηω : (η : DifferentialForm (Eucl N) k) =
          fun x => σ ^ k • ((ω : DifferentialForm (Eucl N) k) ∘ φ) x := funext hη
      calc tsupport (η : DifferentialForm (Eucl N) k)
          ⊆ tsupport ((ω : DifferentialForm (Eucl N) k) ∘ φ) := by
            rw [hηω]
            exact tsupport_smul_subset_right (fun _ => σ ^ k) _
        _ ⊆ φ ⁻¹' tsupport (ω : DifferentialForm (Eucl N) k) :=
            tsupport_comp_subset_preimage _ φ.continuous
        _ ⊆ φ ⁻¹' (φ '' W) := preimage_mono hω
        _ = W := preimage_image_eq W φ.injective
  -- Step 2: `(Y, X)` is a `ρ⁻¹`-pair.
  have hYX : ∀ ω η : TestFormOn (univ : Set (Eucl N)) k,
      (∀ x, (η : DifferentialForm (Eucl N) k) x =
        ρ⁻¹ ^ k • (ω : DifferentialForm (Eucl N) k) (ρ⁻¹ • x)) → X ω = Y η := by
    intro ω η hη
    refine (hXY η ω fun x => ?_).symm
    rw [hη, inv_smul_smul₀ hρ.ne', smul_smul, ← mul_pow, mul_inv_cancel₀ hρ.ne', one_pow,
      one_smul]
  -- Step 3: `zeroRegion(Y) = ρ zeroRegion(X)`.
  have hzero : Y.zeroRegion = (fun x => ρ • x) '' X.zeroRegion :=
    Subset.antisymm
      (fun y hy => ⟨ρ⁻¹ • y, hzero_image ρ⁻¹ (inv_pos.2 hρ) Y X hYX (mem_image_of_mem _ hy),
        smul_inv_smul₀ hρ.ne' y⟩)
      (hzero_image ρ hρ X Y hXY)
  -- Step 4: `x ↦ ρx` is bijective, so it maps `univ \ zeroRegion(X)` onto `univ \ zeroRegion(Y)`.
  have hbij : Function.Bijective fun x : Eucl N => ρ • x :=
    (Homeomorph.smulOfNeZero ρ hρ.ne').bijective
  rw [GeometricCurrentOn.support, GeometricCurrentOn.support, ← compl_eq_univ_sdiff,
    ← compl_eq_univ_sdiff, hzero, image_compl_eq hbij]

/-- Dilation preserves integer multiplicity (Simon Ch. 6, 2.23 and Lemma 3.9 for the dilation
`η_ρ(x) = ρx`, `ρ > 0`): if `X = τ(M, θ, ξ)` is integer multiplicity and `Y(ω) = X(η)` whenever
`η(x) = ρᵏ ω(ρx)`, then `Y = τ(ρM, θ(ρ⁻¹ ·), ξ(ρ⁻¹ ·))` with natural-valued `θ(ρ⁻¹ ·)`. -/
theorem Submission.deformation_dilation_integer_multiplicity : ∀ (N : ℕ) (ρ : ℝ), 0 < ρ → ∀ k : ℕ, ∀ X Y : GeometricCurrentOn (univ : Set (Eucl N)) k, (∀ ω η : TestFormOn (univ : Set (Eucl N)) k, (∀ x, (η : DifferentialForm (Eucl N) k) x = ρ ^ k • (ω : DifferentialForm (Eucl N) k) (ρ • x)) → Y ω = X η) → IsIntegerMultiplicity X → IsIntegerMultiplicity Y := by
  intro N ρ hρ k X Y hXY hX
  obtain ⟨M, θ, ξ, hT, hθ, hrep⟩ := hX
  -- `φ(x) = ρ • x` is a measurable embedding pushing `ρᵏ Hᵏ` forward to `Hᵏ`.
  obtain ⟨hemb, hmp⟩ := Submission.deformation_dilation_hausdorff N k ρ hρ
  refine ⟨(fun x : Eucl N => ρ • x) '' M, fun y => θ (ρ⁻¹ • y), fun y => ξ (ρ⁻¹ • y),
    Submission.deformation_dilation_im_rectifiableTriple N k ρ M θ ξ hρ hemb hmp hT, ?_, ?_⟩
  · -- The multiplicity at `ρ • x` is `θ(ρ⁻¹ • ρ • x) = θ x ∈ ℕ`.
    rintro _ ⟨x, hx, rfl⟩
    simpa only [inv_smul_smul₀ hρ.ne'] using hθ x hx
  · -- `Y ω = X η = τ(M, θ, ξ)(η) = τ(ρM, θ(ρ⁻¹ ·), ξ(ρ⁻¹ ·))(ω)` for the pull-back `η = ρᵏ ω(ρ ·)`.
    intro ω
    obtain ⟨η, hη⟩ := (Submission.deformation_dilation_calculus N ρ hρ k).1 ω
    rw [hXY ω η hη, hrep η, show (η : DifferentialForm (Eucl N) k) =
      fun x => ρ ^ k • (ω : DifferentialForm (Eucl N) k) (ρ • x) from funext hη]
    exact Submission.deformation_dilation_im_tauAction N k ρ M θ ξ ω hρ hemb hmp

/-- Dilation of lattice chains (the rescaling `x ↦ ρx` behind Simon Ch. 6, 5.3, p. 160).
If `Y(ω) = X(η)` whenever `η(x) = ρᵏ ω(ρx)`, and `X = ∑'_F β_F [[F]]` on the unit lattice, then
`Y = ∑'_F β_F [[ρF]]` on the `ρ`-lattice: `ρF` is the image of `F` under `x ↦ ρ • x` and
`∫_{ρF} g dHᵏ = ρᵏ ∫_F g(ρx) dHᵏ(x)`, so the two sums agree term by term. -/
theorem Submission.deformation_dilation_lattice_chain :
    ∀ (N : ℕ) (ρ : ℝ), 0 < ρ → ∀ k : ℕ, ∀ X Y : GeometricCurrentOn (univ : Set (Eucl N)) k,
      (∀ ω η : TestFormOn (univ : Set (Eucl N)) k,
        (∀ x, (η : DifferentialForm (Eucl N) k) x =
          ρ ^ k • (ω : DifferentialForm (Eucl N) k) (ρ • x)) → Y ω = X η) →
      ∀ β : LatticeFaceIndex k N → ℝ, IsLatticeChain 1 β X → IsLatticeChain ρ β Y := by
  intro N ρ hρ k X Y hXY β hX ω
  -- Step 1: `latticeFace ρ F = ρ • latticeFace 1 F`, coordinatewise.
  have hface : ∀ F : LatticeFaceIndex k N,
      latticeFace ρ F = (fun x : Eucl N => ρ • x) '' latticeFace 1 F := by
    intro F
    ext y
    constructor
    · intro hy
      refine ⟨ρ⁻¹ • y, fun i => ?_, smul_inv_smul₀ hρ.ne' y⟩
      rw [PiLp.smul_apply, smul_eq_mul, one_mul, one_mul]
      refine ⟨fun hi => ?_, fun hi => ?_⟩
      · obtain ⟨h₁, h₂⟩ := (hy i).1 hi
        exact ⟨(le_inv_mul_iff₀ hρ).2 h₁, (inv_mul_le_iff₀ hρ).2 h₂⟩
      · rw [(hy i).2 hi, inv_mul_cancel_left₀ hρ.ne']
    · rintro ⟨x, hx, rfl⟩ i
      rw [PiLp.smul_apply, smul_eq_mul]
      refine ⟨fun hi => ?_, fun hi => ?_⟩
      · obtain ⟨h₁, h₂⟩ := (hx i).1 hi
        rw [one_mul] at h₁ h₂
        exact ⟨mul_le_mul_of_nonneg_left h₁ hρ.le, mul_le_mul_of_nonneg_left h₂ hρ.le⟩
      · rw [(hx i).2 hi, one_mul]
  -- Step 2: `[[F]](ρᵏ ω(ρ ·)) = [[ρF]](ω)`, by the scaling `Hᵏ(ρ S) = ρᵏ Hᵏ(S)`.
  obtain ⟨hemb, hmp⟩ := Submission.deformation_dilation_hausdorff N k ρ hρ
  have hact : ∀ F : LatticeFaceIndex k N,
      latticeFaceAction 1 F (fun x => ρ ^ k • (ω : DifferentialForm (Eucl N) k) (ρ • x)) =
        latticeFaceAction ρ F ω := by
    intro F
    rw [latticeFaceAction, latticeFaceAction, hface F, hmp.setIntegral_image_emb hemb,
      Measure.restrict_smul, integral_smul_measure, ENNReal.toReal_ofReal (by positivity),
      smul_eq_mul, ← integral_const_mul]
    rfl
  -- Step 3: compare the two chains term by term at the pulled-back test form `η`.
  obtain ⟨η, hη⟩ := (Submission.deformation_dilation_calculus N ρ hρ k).1 ω
  rw [hXY ω η hη, hX η, funext hη]
  exact tsum_congr fun F => by rw [hact F]

/-- Dilation of currents (Simon Ch. 6, 2.23 and 2.24(1) for `η_ρ(x) = ρx`), the change of scale
used to pass from 5.1 to 5.3.  For `ρ > 0` call `(X, Y)` a `ρ`-pair in degree `k` if
`Y(ω) = X(η)` whenever `η(x) = ρᵏ ω(ρx)`, i.e. `η = η_ρ^# ω`.  Then: (1) `η_ρ^# ω` is a test form;
(2) every `X ∈ 𝒟ₖ(ℝᴺ)` has a push-forward `Y = η_ρ# X`; (3) every `ρ`-pair has `M(Y) = ρᵏ M(X)`
and `spt Y = ρ spt X`, `Y` is integer multiplicity if `X` is, and `Y = ∑ β_F [[ρF]]` if
`X = ∑ β_F [[F]]`; (4) `∂` commutes with `η_ρ#`. -/
theorem Submission.deformation_dilation : ∀ (N : ℕ) (ρ : ℝ), 0 < ρ → ∀ k : ℕ, (∀ ω : TestFormOn (univ : Set (Eucl N)) k, ∃ η : TestFormOn (univ : Set (Eucl N)) k, ∀ x, (η : DifferentialForm (Eucl N) k) x = ρ ^ k • (ω : DifferentialForm (Eucl N) k) (ρ • x)) ∧ (∀ X : GeometricCurrentOn (univ : Set (Eucl N)) k, ∃ Y : GeometricCurrentOn (univ : Set (Eucl N)) k, (∀ ω η : TestFormOn (univ : Set (Eucl N)) k, (∀ x, (η : DifferentialForm (Eucl N) k) x = ρ ^ k • (ω : DifferentialForm (Eucl N) k) (ρ • x)) → Y ω = X η)) ∧ (∀ X Y : GeometricCurrentOn (univ : Set (Eucl N)) k, (∀ ω η : TestFormOn (univ : Set (Eucl N)) k, (∀ x, (η : DifferentialForm (Eucl N) k) x = ρ ^ k • (ω : DifferentialForm (Eucl N) k) (ρ • x)) → Y ω = X η) → Y.mass = ENNReal.ofReal (ρ ^ k) * X.mass ∧ Y.support = (fun x => ρ • x) '' X.support ∧ (IsIntegerMultiplicity X → IsIntegerMultiplicity Y) ∧ ∀ β : LatticeFaceIndex k N → ℝ, IsLatticeChain 1 β X → IsLatticeChain ρ β Y) ∧ ∀ X Y : GeometricCurrentOn (univ : Set (Eucl N)) (k + 1), (∀ ω η : TestFormOn (univ : Set (Eucl N)) (k + 1), (∀ x, (η : DifferentialForm (Eucl N) (k + 1)) x = ρ ^ (k + 1) • (ω : DifferentialForm (Eucl N) (k + 1)) (ρ • x)) → Y ω = X η) → ∀ ω η : TestFormOn (univ : Set (Eucl N)) k, (∀ x, (η : DifferentialForm (Eucl N) k) x = ρ ^ k • (ω : DifferentialForm (Eucl N) k) (ρ • x)) → Y.boundary ω = X.boundary η := by
  intro N ρ hρ k
  -- (1), (2), (4): pull-back of test forms, push-forward of currents, commutation with `∂`.
  obtain ⟨hpull, hpush, hbdry⟩ := Submission.deformation_dilation_calculus N ρ hρ k
  -- (3): mass, support, integer multiplicity and lattice chains of an arbitrary `ρ`-pair.
  exact ⟨hpull, hpush, fun X Y hXY =>
    ⟨Submission.deformation_dilation_mass N ρ hρ k X Y hXY,
      Submission.deformation_dilation_support N ρ hρ k X Y hXY,
      Submission.deformation_dilation_integer_multiplicity N ρ hρ k X Y hXY,
      Submission.deformation_dilation_lattice_chain N ρ hρ k X Y hXY⟩, hbdry⟩

/-- Gradients of functions `u_k → u` that converge uniformly on an open `Ω ⊆ ℝⁿ` and are all
`C`-Lipschitz on `Ω` converge weakly-* on `Ω`: `∫_Ω Du_k(c) → ∫_Ω Du(c)` for every field `c`
integrable on `Ω`. -/
theorem Submission.slicing_im_ll_gradient_weak_star :
    ∀ (n : ℕ) (Ω : Set (Eucl n)) (C : ℝ≥0) (u : Eucl n → ℝ) (ug : ℕ → Eucl n → ℝ), IsOpen Ω →
      LipschitzOnWith C u Ω → (∀ k, LipschitzOnWith C (ug k) Ω) →
      TendstoUniformlyOn ug u atTop Ω → ∀ c : Eucl n → Eucl n,
      IntegrableOn c Ω (volume : Measure (Eucl n)) →
      Tendsto (fun k => ∫ w in Ω, fderiv ℝ (ug k) w (c w)) atTop
        (𝓝 (∫ w in Ω, fderiv ℝ u w (c w))) := by
  intro n Ω C u ug hΩ hu hug hconv c hc
  rw [Metric.tendsto_atTop]
  intro ε hε
  -- A smooth field `b` compactly supported in `Ω` with `∫_Ω |c - b| < ε / (3 (C + 1))`,
  -- so that `C ∫_Ω |c - b| < ε / 3`.
  obtain ⟨b, hb, hbc, hbΩ, hcb⟩ := Submission.slicing_im_ll_gws_smooth_dense n Ω c hΩ hc
    (ε / (3 * (C + 1))) (by positivity)
  have hCcb : (C : ℝ) * ∫ w in Ω, ‖c w - b w‖ < ε / 3 := by
    calc (C : ℝ) * ∫ w in Ω, ‖c w - b w‖ ≤ C * (ε / (3 * (C + 1))) :=
          mul_le_mul_of_nonneg_left hcb.le C.coe_nonneg
      _ < ε / 3 := by
          rw [mul_div_assoc', div_lt_div_iff₀ (by positivity) (by norm_num)]
          nlinarith
  have hbi : IntegrableOn b Ω (volume : Measure (Eucl n)) :=
    (hb.continuous.integrable_of_hasCompactSupport hbc).integrableOn
  -- The pairings against the smooth field `b` converge.
  obtain ⟨k₀, hk₀⟩ := Metric.tendsto_atTop.1
    (Submission.slicing_im_ll_gws_smooth_tendsto n Ω C u ug hΩ hu hug hconv b
      (hb.of_le (by exact_mod_cast le_top)) hbc hbΩ) (ε / 3) (by positivity)
  refine ⟨k₀, fun k hk => ?_⟩
  -- Replacing `c` by `b` moves the pairings with `Du_k` and with `Du` by at most
  -- `C ∫_Ω |c - b| < ε / 3` each.
  have h₁ := Submission.slicing_im_ll_gws_pairing_bound n Ω C (ug k) hΩ (hug k) c b hc hbi
  have h₂ := Submission.slicing_im_ll_gws_pairing_bound n Ω C u hΩ hu c b hc hbi
  have h₃ := hk₀ k hk
  rw [Real.dist_eq] at h₃ ⊢
  have h₄ := abs_sub_le (∫ w in Ω, fderiv ℝ (ug k) w (c w)) (∫ w in Ω, fderiv ℝ (ug k) w (b w))
    (∫ w in Ω, fderiv ℝ u w (c w))
  have h₅ := abs_sub_le (∫ w in Ω, fderiv ℝ (ug k) w (b w)) (∫ w in Ω, fderiv ℝ u w (b w))
    (∫ w in Ω, fderiv ℝ u w (c w))
  rw [abs_sub_comm (∫ w in Ω, fderiv ℝ u w (b w))] at h₅
  linarith

/-- Simon Ch. 6, proof of Lemma 4.5(2), (1): if the differentiable `L`-Lipschitz `g_k` converge
uniformly to `h`, whose tangential gradient on `(M, θ)` is `G`, then `∫_M Dg_k(Y) dHⁿ` tends to
`∫_M ⟨G, Y⟩ dHⁿ` for every integrable tangent field `Y`.  `M` is cut into pieces on disjoint
`C¹` chart images, where `range DΦ` is the weighted tangent plane; on each piece both integrals
are parameter integrals against one integrable field, which converge by the weak-* convergence
of the chart gradients, and dominated convergence sums the pieces. -/
theorem Submission.slicing_im_ll_tangential_weak_limit : ∀ (P n : ℕ) (U M : Set (Eucl P)) (θ : Eucl P → ℝ) (ξ : Eucl P → NVector (Eucl P) n), IsOpen U → IsRectifiableTriple U n M θ ξ → ∀ (h : Eucl P → ℝ) (L : ℝ≥0) (G : Eucl P → Eucl P), LipschitzWith L h → Measurable G → (∀ x, ‖G x‖ ≤ L) → (∀ᵐ x ∂((μHE[n] : Measure (Eucl P)).restrict M), ∀ Q : Submodule ℝ (Eucl P), HasWeightedApproximateTangentSpaceAt n M θ x Q → G x ∈ Q ∧ ∀ u ∈ Q, HasDerivAt (fun s : ℝ => h (x + s • u)) (inner ℝ (G x) u) 0) → ∀ Y : Eucl P → Eucl P, Integrable Y ((μHE[n] : Measure (Eucl P)).restrict M) → (∀ᵐ x ∂((μHE[n] : Measure (Eucl P)).restrict M), ∀ Q : Submodule ℝ (Eucl P), HasWeightedApproximateTangentSpaceAt n M θ x Q → Y x ∈ Q) → ∀ g : ℕ → Eucl P → ℝ, (∀ k, Differentiable ℝ (g k)) → (∀ k, LipschitzWith L (g k)) → TendstoUniformly g h atTop → Tendsto (fun k => ∫ x in M, fderiv ℝ (g k) x (Y x) ∂(μHE[n] : Measure (Eucl P))) atTop (𝓝 (∫ x in M, inner ℝ (G x) (Y x) ∂(μHE[n] : Measure (Eucl P)))) := by
  intro P n U M θ ξ hU hT h L G hh hG hGL hTG Y hY hYtan g hgd hgL hgu
  -- `C¹` charts `Φ j`, Lipschitz and antilipschitz on open `Ω j`, cover `M` up to an
  -- `Hⁿ`-null set (Simon Ch. 3, 1.2).
  obtain ⟨Φ, Ω, hΩ, hΦ, hLip, hanti, hcover⟩ :=
    Submission.lpf_countably_rectifiable_c1_cover P n M hT.countablyRectifiable
  -- Each chart image is Borel: `Φ j` is continuous and injective on the open set `Ω j`.
  have himg : ∀ j, MeasurableSet (Φ j '' Ω j) := by
    intro j
    obtain ⟨κ, hκ, hκΦ⟩ := hanti j
    refine (hΩ j).measurableSet.image_of_continuousOn_injOn (hΦ j).continuous.continuousOn
      fun w hw w' hw' hww' => ?_
    have h₁ := hκΦ w hw w' hw'
    rw [hww', sub_self, norm_zero] at h₁
    exact sub_eq_zero.1 (norm_le_zero_iff.1 (nonpos_of_mul_nonpos_right h₁ hκ))
  -- Disjoint Borel pieces `V j ⊆ Φ j '' Ω j`; they cover `M` up to an `Hⁿ`-null set.
  set V : ℕ → Set (Eucl P) := disjointed fun j => Φ j '' Ω j with hV
  have hVm : ∀ j, MeasurableSet (V j) := MeasurableSet.disjointed himg
  have hnull : ((μHE[n] : Measure (Eucl P)).restrict M) (⋃ j, V j)ᶜ = 0 := by
    rw [Measure.restrict_apply (MeasurableSet.iUnion hVm).compl, hV, iUnion_disjointed,
      inter_comm, ← sdiff_eq]
    exact hcover
  -- The integrands and their integrable majorant `L |Y|` (`|Dg_k| ≤ L`, `|G| ≤ L`).
  have hb : Integrable (fun x => (L : ℝ) * ‖Y x‖) ((μHE[n] : Measure (Eucl P)).restrict M) :=
    hY.norm.const_mul _
  have hFb : ∀ k x, ‖fderiv ℝ (g k) x (Y x)‖ ≤ (L : ℝ) * ‖Y x‖ := fun k x =>
    ((fderiv ℝ (g k) x).le_opNorm (Y x)).trans
      (mul_le_mul_of_nonneg_right (norm_fderiv_le_of_lipschitz ℝ (hgL k)) (norm_nonneg _))
  have hF : ∀ k, Integrable (fun x => fderiv ℝ (g k) x (Y x))
      ((μHE[n] : Measure (Eucl P)).restrict M) := fun k =>
    hb.mono' ((ContinuousLinearMap.id ℝ (Eucl P →L[ℝ] ℝ)).aestronglyMeasurable_comp₂
      (measurable_fderiv ℝ (g k)).aestronglyMeasurable hY.aestronglyMeasurable)
      (ae_of_all _ (hFb k))
  have hFlim : Integrable (fun x => inner ℝ (G x) (Y x))
      ((μHE[n] : Measure (Eucl P)).restrict M) :=
    hb.mono' (continuous_inner.comp_aestronglyMeasurable₂ (g := fun a b => inner ℝ a b)
      hG.aestronglyMeasurable hY.aestronglyMeasurable) (ae_of_all _ fun x =>
      (norm_inner_le_norm _ _).trans (mul_le_mul_of_nonneg_right (hGL x) (norm_nonneg _)))
  -- Reduce to the convergence on each piece (dominated convergence for the series).
  refine Submission.slicing_im_ll_twl_partition_tendsto (Eucl P)
    ((μHE[n] : Measure (Eucl P)).restrict M) V (fun x => (L : ℝ) * ‖Y x‖)
    (fun k x => fderiv ℝ (g k) x (Y x)) (fun x => inner ℝ (G x) (Y x)) hVm
    (disjoint_disjointed _) hnull hb hF (fun k => ae_of_all _ (hFb k)) hFlim fun j => ?_
  -- The piece `A := V j ∩ M ⊆ Φ j '' Ω j`.
  rw [Measure.restrict_restrict (hVm j)]
  have hAΦ : V j ∩ M ⊆ Φ j '' Ω j := inter_subset_left.trans (disjointed_subset _ j)
  -- For `Hⁿ`-a.e. `x = Φ j w ∈ A`, `range DΦ j (w)` is the weighted tangent plane of `(M, θ)`,
  -- so it contains `Y x` and `h` has the derivative `⟨G x, u⟩` along each of its vectors `u`.
  have hwtA := ae_restrict_of_ae_restrict_of_subset (subset_inter inter_subset_right hAΦ)
    (Submission.lpf_weighted_tangent_on_c1_chart P n U M θ (Φ j) (Ω j) hU hT.subset
      hT.nullMeasurableSet hT.pos hT.integrableOn (hΩ j) (hΦ j) (hanti j))
  -- Both integrals over `A` as parameter integrals against one integrable field `c`.
  obtain ⟨c, hc, hcf, hch⟩ := Submission.slicing_im_ll_twl_chart_representation P n (Φ j) (Ω j)
    (V j ∩ M) h L G Y (hΩ j) (hΦ j) (hLip j) (hanti j) hAΦ
    ((hVm j).nullMeasurableSet.inter hT.nullMeasurableSet) hh hG hGL
    ((show IntegrableOn Y M (μHE[n] : Measure (Eucl P)) from hY).mono_set inter_subset_right) (by
      filter_upwards [hwtA, ae_restrict_of_ae_restrict_of_subset inter_subset_right hTG,
        ae_restrict_of_ae_restrict_of_subset inter_subset_right hYtan] with x h₁ h₂ h₃ w hw hwx
      exact ⟨h₃ _ (h₁ w hw hwx), (h₂ _ (h₁ w hw hwx)).2⟩)
  -- Weak-* convergence of the chart gradients `D(g_k ∘ Φ j) → D(h ∘ Φ j)` against `c`:
  -- `g_k ∘ Φ j → h ∘ Φ j` uniformly on `Ω j`, all `L K`-Lipschitz there.
  obtain ⟨K, hK⟩ := hLip j
  rw [hch]
  exact (Submission.slicing_im_ll_gradient_weak_star n (Ω j) (L * K) (h ∘ Φ j)
    (fun k => g k ∘ Φ j) (hΩ j) (hh.comp_lipschitzOnWith hK)
    (fun k => (hgL k).comp_lipschitzOnWith hK) (hgu.comp (Φ j)).tendstoUniformlyOn c hc).congr
    fun k => (hcf (g k) L (hgd k) (hgL k)).symm

/-- Simon Ch. 6, proof of Lemma 4.5(2), (1)–(3) (p. 156): Leibniz rule for a Lipschitz `h` with
tangential gradient `G_h` on `M`, `T = τ(M, θ, ξ)`:
`∫ h ⟨ω, v'⟩ dμ' − ∫ h ⟨dω, v⟩ dμ = ∫_M θ ⟨G_h ∧ ω, ξ⟩ dHⁿ`.
For smooth `Lh`-Lipschitz `g_k → h` the smooth identity, rewritten through the tangent field `Y`
with `φ(Y) = θ ⟨φ ∧ ω, ξ⟩`, reads `∫_M Dg_k(Y) dHⁿ = ∫ g_k ⟨ω, v'⟩ dμ' − ∫ g_k ⟨dω, v⟩ dμ`; the
left side tends to `∫_M ⟨G_h, Y⟩ dHⁿ` and the right side to the left side of the claim. -/
theorem Submission.slicing_im_lipschitz_leibniz :
    ∀ (P m : ℕ) (U M : Set (Eucl P)) (θ : Eucl P → ℝ) (ξ : Eucl P → NVector (Eucl P) (m + 1)) (T : GeometricCurrentOn U (m + 1)), IsOpen U → IsRectifiableTriple U (m + 1) M θ ξ → (∀ η : TestFormOn U (m + 1), T η = tauAction (m + 1) M θ ξ η) → ∀ (μ : Measure (Eucl P)) (v : Eucl P → NVector (Eucl P) (m + 1)) (μ' : Measure (Eucl P)) (v' : Eucl P → NVector (Eucl P) m), IsMeasureRepresentation T μ v → IsMeasureRepresentation T.boundary μ' v' → ∀ (h : Eucl P → ℝ) (Lh : ℝ≥0) (Gh : Eucl P → Eucl P), LipschitzWith Lh h → Measurable Gh → (∀ x, ‖Gh x‖ ≤ Lh) → (∀ᵐ x ∂((μHE[m + 1] : Measure (Eucl P)).restrict M), ∀ Q : Submodule ℝ (Eucl P), HasWeightedApproximateTangentSpaceAt (m + 1) M θ x Q → Gh x ∈ Q ∧ ∀ u ∈ Q, HasDerivAt (fun s : ℝ => h (x + s • u)) (inner ℝ (Gh x) u) 0) → ∀ ω : TestFormOn U m, (∫ x, h x * v' x ((ω : DifferentialForm (Eucl P) m) x) ∂μ') - (∫ x, h x * v x (exteriorDerivative (ω : DifferentialForm (Eucl P) m) x) ∂μ) = ∫ x in M, θ x * ξ x (ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ (Gh x)).smulRight ((ω : DifferentialForm (Eucl P) m) x))) ∂(μHE[m + 1] : Measure (Eucl P)) := by
  intro P m U M θ ξ T hU hMθξ hT μ v μ' v' hrep hrep' h Lh Gh hh hGm hGb hTG ω
  obtain ⟨⟨hωs, hωc⟩, -⟩ := ω.2
  -- Smooth `Lh`-Lipschitz `g k → h` uniformly, and the field `Y` dual to `φ ↦ θ ⟨φ ∧ ω, ξ⟩`.
  obtain ⟨g, hg, hgL, hgh⟩ := Submission.slicing_im_ll_mollify P h Lh hh
  obtain ⟨Y, hY, hYφ, hYT⟩ := Submission.slicing_im_ll_tangent_dual_field P m U M θ ξ hMθξ ω
  -- Simon's (2): the smooth identity for `ψ = g k`, with `θ ⟨Dg_k ∧ ω, ξ⟩ = Dg_k(Y)`.
  have hk : ∀ k, ∫ x in M, fderiv ℝ (g k) x (Y x) ∂(μHE[m + 1] : Measure (Eucl P)) =
      (∫ x, g k x * v' x ((ω : DifferentialForm (Eucl P) m) x) ∂μ') -
        ∫ x, g k x * v x (exteriorDerivative (ω : DifferentialForm (Eucl P) m) x) ∂μ := by
    intro k
    rw [← Submission.slicing_im_ll_smooth_leibniz P m U M θ ξ T hT μ v μ' v' hrep hrep' ω (g k)
      (hg k)]
    exact integral_congr_ae (Eventually.of_forall fun x => hYφ x _)
  -- Representation side: `⟨ω, v'⟩ ∈ L¹(μ')` and `⟨dω, v⟩ ∈ L¹(μ)` vanish off the compact sets
  -- `spt ω` and `spt dω`, so the uniform limit `g k → h` passes inside both integrals.
  have hrhs := (Submission.slicing_im_ll_multiplier_tendsto P μ'
      (fun x => v' x ((ω : DifferentialForm (Eucl P) m) x))
      (tsupport (ω : DifferentialForm (Eucl P) m)) h g (hrep' ω).1 hωc
      (fun x hx => by simp [image_eq_zero_of_notMem_tsupport hx]) hh.continuous
      (fun k => (hg k).continuous) hgh).sub
    (Submission.slicing_im_ll_multiplier_tendsto P μ
      (fun x => v x (exteriorDerivative (ω : DifferentialForm (Eucl P) m) x))
      (tsupport (exteriorDerivative (ω : DifferentialForm (Eucl P) m))) h g
      (hrep (exteriorDerivativeTestOn U m ω)).1 (exteriorDerivative_isTestForm ⟨hωs, hωc⟩).2
      (fun x hx => by simp [image_eq_zero_of_notMem_tsupport hx]) hh.continuous
      (fun k => (hg k).continuous) hgh)
  -- Simon's (1), (3): `∫_M Dg_k(Y) dHⁿ → ∫_M ⟨G_h, Y⟩ dHⁿ`, as `Y` is tangent to `M`.
  have hlhs := Submission.slicing_im_ll_tangential_weak_limit P (m + 1) U M θ ξ hU hMθξ h Lh Gh
    hh hGm hGb hTG Y hY hYT g (fun k => (hg k).differentiable (by simp)) hgL hgh
  have hlim : ∫ x in M, inner ℝ (Gh x) (Y x) ∂(μHE[m + 1] : Measure (Eucl P)) =
      (∫ x, h x * v' x ((ω : DifferentialForm (Eucl P) m) x) ∂μ') -
        ∫ x, h x * v x (exteriorDerivative (ω : DifferentialForm (Eucl P) m) x) ∂μ :=
    tendsto_nhds_unique hlhs (hrhs.congr fun k => (hk k).symm)
  -- Finally `⟨G_h, Y⟩ = θ ⟨G_h ∧ ω, ξ⟩` pointwise (the dual property with `φ = ⟨G_h, ·⟩`).
  rw [← hlim]
  exact integral_congr_ae (Eventually.of_forall fun x => by
    dsimp only
    rw [← hYφ x (innerSL ℝ (Gh x)), innerSL_apply_apply])

/-- **Slice identity (Simon Ch. 6, Remark 4.2 and the proof of Lemma 4.5(2)).**  For
`T = τ(M, θ, ξ)`, `f` Lipschitz with tangential gradient `G` on `M` and `ω ∈ 𝒟^m(U)`: for a.e. `t`,
every slice `S` of `T` by `f` at `t` has `S(ω) = τ(M_t, θ, ξ_t)(ω)`, where
`M_t = {x ∈ M : f x = t, G x ≠ 0}` and `ξ_t = ξ ⌞ (G/|G|)`.

With `φ(r) = ∫_{M ∩ f⁻¹{r}} g dH^m` (`θ ⟨G♭∧ω, ξ⟩ = |G| g`), the Leibniz identity for the cut-off
`h_ε = ψ_ε ∘ f` (tangential gradient `-ε⁻¹ 1_{t-ε<f<t} G`) and the co-area formula give
`∫ h_ε ⟨ω, v'⟩ dμ' - ∫ h_ε ⟨dω, v⟩ dμ = -ε⁻¹ ∫_{t-ε}^t φ`; let `ε ↓ 0` at a Lebesgue point `t`. -/
theorem Submission.slicing_im_slice_identity : ∀ (P m : ℕ) (U M : Set (Eucl P)) (θ : Eucl P → ℝ) (ξ : Eucl P → NVector (Eucl P) (m + 1)) (T : GeometricCurrentOn U (m + 1)) (f : Eucl P → ℝ) (L : ℝ≥0) (G : Eucl P → Eucl P), IsOpen U → IsRectifiableTriple U (m + 1) M θ ξ → (∀ η : TestFormOn U (m + 1), T η = tauAction (m + 1) M θ ξ η) → LipschitzWith L f → Measurable G → (∀ x, ‖G x‖ ≤ L) → (∀ᵐ x ∂((μHE[m + 1] : Measure (Eucl P)).restrict M), ∀ Q : Submodule ℝ (Eucl P), HasWeightedApproximateTangentSpaceAt (m + 1) M θ x Q → G x ∈ Q ∧ ∀ u ∈ Q, HasDerivAt (fun s : ℝ => f (x + s • u)) (inner ℝ (G x) u) 0) → ∀ ω : TestFormOn U m, ∀ᵐ t ∂(volume : Measure ℝ), ∀ S : GeometricCurrentOn U m, IsSlice T f t S → S ω = tauAction m {x | x ∈ M ∧ f x = t ∧ G x ≠ 0} θ (fun x => (ξ x).comp ((ContinuousAlternatingMap.alternatizeUncurryFinCLM ℝ (Eucl P) ℝ).comp (ContinuousLinearMap.smulRightL ℝ (Eucl P) (Covector (Eucl P) m) (innerSL ℝ (‖G x‖⁻¹ • G x))))) ω := by
  intro P m U M θ ξ T f L G hU hM hT hf hGm hGL hTG ω
  have hfm : Measurable f := hf.continuous.measurable
  -- Co-area formula on `M` for `f` and its tangential gradient `G` (Simon 4.1).
  have hCA := Submission.slicing_im_coarea P m U M θ ξ f L G hU hM hf hGm hGL hTG
  -- `G = 0` a.e. on every level set of `f`, and null subsets of `M` have null slices.
  obtain ⟨hlev, hNT⟩ := Submission.slicing_im_si_coarea_null_sets P
    (μHE[m + 1] : Measure (Eucl P)) (μHE[m] : Measure (Eucl P)) M f G hfm hGm hCA
  -- Borel density `g ∈ L¹(Hⁿ⌞M)`: `θ ⟨G♭∧ω, ξ⟩ = |G| g`, and `g = θ ⟨ω, ξ_t⟩` where `G ≠ 0`.
  obtain ⟨g, hgm, hgi, hg0, hgae⟩ :=
    Submission.slicing_im_si_borel_density P m U M θ ξ G ω hM hGm
  have hGg : Integrable (fun x => ‖G x‖ * g x) ((μHE[m + 1] : Measure (Eucl P)).restrict M) :=
    hgi.bdd_mul (c := (L : ℝ)) hGm.norm.aestronglyMeasurable
      (Eventually.of_forall fun x => by rw [norm_norm]; exact hGL x)
  -- Remark 4.2: `φ(r) = ∫_{M ∩ f⁻¹{r}} g dH^m` is integrable and integrates `|G| g` over bands.
  obtain ⟨hφi, hφab⟩ := Submission.slicing_im_si_signed_coarea P
    (μHE[m + 1] : Measure (Eucl P)) (μHE[m] : Measure (Eucl P)) M f G g hfm hGm hgm hGg hCA
  -- For a.e. `t`, `φ(t)` is the action of the slice triple `(M_t, θ, ξ_t)` on `ω`.
  have htr := Submission.slicing_im_si_slice_ae_transfer P (μHE[m + 1] : Measure (Eucl P))
    (μHE[m] : Measure (Eucl P)) M {x | G x ≠ 0} f g
    (fun x => θ x *
      (ξ x).comp ((ContinuousAlternatingMap.alternatizeUncurryFinCLM ℝ (Eucl P) ℝ).comp
        (ContinuousLinearMap.smulRightL ℝ (Eucl P) (Covector (Eucl P) m)
          (innerSL ℝ (‖G x‖⁻¹ • G x)))) ((ω : DifferentialForm (Eucl P) m) x))
    hM.nullMeasurableSet (hGm (measurableSet_singleton 0).compl) hfm hNT
    (fun x hx => hg0 x (not_not.mp hx)) (hgae.mono fun x hx hxS => hx.1 hxS)
  -- Almost every `t` is a left Lebesgue point of `φ`.
  have hleb := Submission.slicing_im_si_left_lebesgue_point
    (fun r => ∫ x in M ∩ f ⁻¹' {r}, g x ∂(μHE[m] : Measure (Eucl P))) hφi.locallyIntegrable
  -- The exceptional set depends only on `ω`, not on the slice `S`.
  filter_upwards [htr, hleb] with t ht ht'
  intro S hS
  obtain ⟨A, B, ⟨-, μ₁, v₁, hrep₁, hA⟩, ⟨-, μ₂, v₂, hrep₂, hB⟩, hSAB⟩ := hS
  -- `(c w)♭∧α = c (w♭∧α)`.
  have hsmul : ∀ (c : ℝ) (w : Eucl P) (α : Covector (Eucl P) m),
      ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ (c • w)).smulRight α) =
        c • ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ w).smulRight α) := by
    intro c w α
    rw [← ContinuousAlternatingMap.alternatizeUncurryFin_smul]
    congr 1
    ext v u
    simp [mul_assoc]
  -- Leibniz identity for `h_ε = ψ_ε ∘ f`, whose tangential gradient is `-ε⁻¹ 1_{t-ε<f<t} G`
  -- (Simon (2)–(4) in the proof of 4.5(2)).
  have hkey : ∀ ε : ℝ, 0 < ε →
      (∫ x, max 0 (min 1 ((t - f x) / ε)) * v₂ x ((ω : DifferentialForm (Eucl P) m) x) ∂μ₂) -
          (∫ x, max 0 (min 1 ((t - f x) / ε)) *
            v₁ x (exteriorDerivative (ω : DifferentialForm (Eucl P) m) x) ∂μ₁) =
        -(ε⁻¹ * ∫ r in Ioo (t - ε) t, ∫ x in M ∩ f ⁻¹' {r}, g x ∂(μHE[m] : Measure (Eucl P))) := by
    intro ε hε
    obtain ⟨K, hKlip, hGεm, hGεK, hGεTG⟩ := Submission.slicing_im_si_cutoff_tangential_gradient P
      ((μHE[m + 1] : Measure (Eucl P)).restrict M)
      (HasWeightedApproximateTangentSpaceAt (m + 1) M θ) f L G t ε hε hf hGm hGL hTG
      (hlev (t - ε)) (hlev t)
    rw [Submission.slicing_im_lipschitz_leibniz P m U M θ ξ T hU hM hT μ₁ v₁ μ₂ v₂ hrep₁ hrep₂
      (fun x => max 0 (min 1 ((t - f x) / ε))) K
      ((f ⁻¹' Ioo (t - ε) t).indicator (fun y => (-ε⁻¹) • G y)) hKlip hGεm hGεK hGεTG ω]
    -- On the band `t - ε < f < t` the integrand is `-ε⁻¹ |G| g`; off the band it vanishes.
    have hpt : ∀ᵐ x ∂((μHE[m + 1] : Measure (Eucl P)).restrict M),
        θ x * ξ x (ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ
          ((f ⁻¹' Ioo (t - ε) t).indicator (fun y => (-ε⁻¹) • G y) x)).smulRight
            ((ω : DifferentialForm (Eucl P) m) x))) =
          (f ⁻¹' Ioo (t - ε) t).indicator (fun y => -ε⁻¹ * (‖G y‖ * g y)) x := by
      filter_upwards [hgae] with x hx
      by_cases hxs : x ∈ f ⁻¹' Ioo (t - ε) t
      · rw [indicator_of_mem hxs, indicator_of_mem hxs, hsmul, ← hx.2, map_smul, smul_eq_mul]
        ring
      · have h0 := hsmul 0 0 ((ω : DifferentialForm (Eucl P) m) x)
        rw [zero_smul, zero_smul] at h0
        rw [indicator_of_notMem hxs, indicator_of_notMem hxs, h0, map_zero, mul_zero]
    rw [integral_congr_ae hpt, setIntegral_indicator (hfm measurableSet_Ioo), integral_const_mul,
      hφab]
    ring
  -- `ψ_ε(s) = max 0 (min 1 ((t - s) / ε))` cuts off `{s < t}`.
  have hχm : ∀ ε : ℝ, 0 < ε → Measurable fun s : ℝ => max 0 (min 1 ((t - s) / ε)) :=
    fun ε _ => by fun_prop
  have hχb : ∀ ε s : ℝ, 0 < ε → |max 0 (min 1 ((t - s) / ε))| ≤ 1 := by
    intro ε s _
    rw [abs_of_nonneg (le_max_left _ _)]
    exact max_le zero_le_one (min_le_left _ _)
  have hχ1 : ∀ ε s : ℝ, 0 < ε → s ≤ t - ε → max 0 (min 1 ((t - s) / ε)) = 1 := by
    intro ε s hε hs
    rw [min_eq_left ((one_le_div hε).mpr (by linarith)), max_eq_right zero_le_one]
  have hχ0 : ∀ ε s : ℝ, 0 < ε → t ≤ s → max 0 (min 1 ((t - s) / ε)) = 0 := fun ε s hε hs =>
    max_eq_left ((min_le_right _ _).trans (div_nonpos_of_nonpos_of_nonneg (by linarith) hε.le))
  -- Dominated convergence for both cut-off integrals (`ω` and `dω` vanish off `U`).
  have hlim₂ := Submission.slicing_mb_pointwise_cutoff_tendsto P U hU f L hf.lipschitzOnWith μ₂
    (fun x => v₂ x ((ω : DifferentialForm (Eucl P) m) x)) (hrep₂ ω).1
    (fun x hx => by simp [image_eq_zero_of_notMem_tsupport fun h => hx (ω.property.2 h)])
    t (fun ε s => max 0 (min 1 ((t - s) / ε))) hχm hχb hχ1 hχ0
  have hlim₁ := Submission.slicing_mb_pointwise_cutoff_tendsto P U hU f L hf.lipschitzOnWith μ₁
    (fun x => v₁ x (exteriorDerivative (ω : DifferentialForm (Eucl P) m) x))
    (hrep₁ (exteriorDerivativeTestOn U m ω)).1
    (fun x hx => by
      simp [image_eq_zero_of_notMem_tsupport fun h =>
        hx (ω.property.2 (tsupport_exteriorDerivative_subset _ h))])
    t (fun ε s => max 0 (min 1 ((t - s) / ε))) hχm hχb hχ1 hχ0
  -- Both sides of the Leibniz identity converge as `ε ↓ 0`; the limits agree.
  have hBA := tendsto_nhds_unique
    ((hlim₂.sub hlim₁).congr' (eventually_nhdsWithin_of_forall (s := Ioi 0) fun ε hε => hkey ε hε))
    ht'.neg
  have hAω : A.boundary ω = ∫ x in {x | x ∈ U ∧ f x < t},
      v₁ x (exteriorDerivative (ω : DifferentialForm (Eucl P) m) x) ∂μ₁ :=
    hA (exteriorDerivativeTestOn U m ω)
  have hφt : A.boundary ω - B ω = ∫ x in M ∩ f ⁻¹' {t}, g x ∂(μHE[m] : Measure (Eucl P)) := by
    rw [hAω, hB ω]
    beta_reduce at hBA
    linarith
  rw [hSAB ω, hφt, ht]
  rfl

/-- **Countable sequential density of test forms supported in a compact `K ⊆ U`** (the
"countable dense set of `ω ∈ 𝒟ⁿ(U)`" of Simon Ch. 6, proof of 4.5, p. 157).  The value spaces
`ℝ^P [×i]→L[ℝ] Λᵏ` of `D^i ω` are second countable (by currying).  For each order `m` and scale
`1/(j+1)`, the forms whose jets `(D^i ω)_{i ≤ m}` oscillate on `K` by less than `1/(m+1)` at
scale `1/(j+1)` are approximated within `3/(m+1)` on `K` through their jets on a finite
`1/(j+1)`-net of `K`.  A choice over the orders `m` gives a sequence whose derivatives of every
order converge uniformly on `K`. -/
theorem Submission.slicing_im_td_countable_seq_dense : ∀ (P k : ℕ) (U K : Set (Eucl P)), IsCompact K → K ⊆ U → ∃ E : Set (TestFormOn U k), E.Countable ∧ ∀ ω : TestFormOn U k, tsupport (ω : DifferentialForm (Eucl P) k) ⊆ K → ∃ e : ℕ → TestFormOn U k, (∀ l, e l ∈ E) ∧ TestFormOnConverges e ω := by
  intro P k U K hK hKU
  -- The value spaces of the iterated derivatives are second countable.
  have hgen : ∀ (G : Type) [NormedAddCommGroup G] [NormedSpace ℝ G] [SecondCountableTopology G]
      (i : ℕ), SecondCountableTopology (ContinuousMultilinearMap ℝ (fun _ : Fin i => Eucl P) G) := by
    intro G _ _ _ i
    induction i with
    | zero =>
      exact (continuousMultilinearCurryFin0 ℝ (Eucl P) G).toHomeomorph.secondCountableTopology
    | succ n ih =>
      exact (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (n + 1) => Eucl P)
        G).toHomeomorph.secondCountableTopology
  have hCov : SecondCountableTopology (Covector (Eucl P) k) := by
    have := hgen ℝ k
    exact ContinuousAlternatingMap.isEmbedding_toContinuousMultilinearMap.isInducing.secondCountableTopology
  have hSC : ∀ i : ℕ, SecondCountableTopology
      (ContinuousMultilinearMap ℝ (fun _ : Fin i => Eucl P) (Covector (Eucl P) k)) :=
    fun i => hgen _ i
  -- The jet of order `m`: `J m ω x = (D^i ω x)_{i ≤ m}`.
  let J : (m : ℕ) → TestFormOn U k → Eucl P → ((i : Fin (m + 1)) →
      ContinuousMultilinearMap ℝ (fun _ : Fin i => Eucl P) (Covector (Eucl P) k)) :=
    fun m ω x i => iteratedFDeriv ℝ i (ω : DifferentialForm (Eucl P) k) x
  have hJcont : ∀ m (ω : TestFormOn U k), Continuous (J m ω) := fun m ω =>
    continuous_pi fun i => ω.2.1.1.continuous_iteratedFDeriv (by exact_mod_cast le_top)
  let D : Set (TestFormOn U k) := {ω | tsupport (ω : DifferentialForm (Eucl P) k) ⊆ K}
  -- Finite `1/(j+1)`-nets of `K` inside `K`.
  have hnet : ∀ j : ℕ, ∃ t : Finset (Eucl P), (↑t : Set (Eucl P)) ⊆ K ∧
      K ⊆ ⋃ y ∈ t, Metric.ball y (1 / ((j : ℝ) + 1)) := by
    intro j
    obtain ⟨t, htK, ht, hcov⟩ := hK.finite_cover_balls (e := 1 / ((j : ℝ) + 1)) (by positivity)
    exact ⟨ht.toFinset, by simpa using htK, by simpa using hcov⟩
  choose net hnetK hnet using hnet
  -- Order `m`, accuracy `1/(m+1)`, scale `1/(j+1)`: take a countable dense subset of the jets on
  -- the net and choose preimages.
  have key : ∀ m j : ℕ, ∃ E' : Set (TestFormOn U k), E'.Countable ∧ E' ⊆ D ∧
      ∀ ω ∈ D, (∀ x ∈ K, ∀ y ∈ K, dist x y < 1 / ((j : ℝ) + 1) →
          dist (J m ω x) (J m ω y) < 1 / ((m : ℝ) + 1)) →
        ∃ η ∈ E', ∀ x ∈ K, dist (J m ω x) (J m η x) < 3 / ((m : ℝ) + 1) := by
    intro m j
    set r : ℝ := 1 / ((m : ℝ) + 1) with hr_def
    have hr : 0 < r := by positivity
    let Dj : Set (TestFormOn U k) := {ω | ω ∈ D ∧ ∀ x ∈ K, ∀ y ∈ K,
      dist x y < 1 / ((j : ℝ) + 1) → dist (J m ω x) (J m ω y) < r}
    let g : TestFormOn U k → (net j → ((i : Fin (m + 1)) →
        ContinuousMultilinearMap ℝ (fun _ : Fin i => Eucl P) (Covector (Eucl P) k))) :=
      fun ω y => J m ω y
    obtain ⟨S, hSA, hSc, hAS⟩ :=
      (TopologicalSpace.IsSeparable.of_separableSpace (g '' Dj)).exists_countable_dense_subset
    have hpre : ∀ s : S, ∃ ω ∈ Dj, g ω = s := fun s => hSA s.2
    choose pick hpickD hpickg using hpre
    have : Countable S := hSc.to_subtype
    refine ⟨Set.range pick, Set.countable_range pick, ?_, ?_⟩
    · rintro _ ⟨s, rfl⟩
      exact (hpickD s).1
    · intro ω hωD hωmod
      obtain ⟨s, hsS, hdist⟩ := (Metric.mem_closure_iff (α := net j → (i : Fin (m + 1)) →
          ContinuousMultilinearMap ℝ (fun _ : Fin i => Eucl P) (Covector (Eucl P) k))).mp
        (hAS ⟨ω, ⟨hωD, hωmod⟩, rfl⟩) r hr
      have hηD : pick ⟨s, hsS⟩ ∈ Dj := hpickD ⟨s, hsS⟩
      have hgη : g (pick ⟨s, hsS⟩) = s := hpickg ⟨s, hsS⟩
      refine ⟨pick ⟨s, hsS⟩, ⟨⟨s, hsS⟩, rfl⟩, fun x hx => ?_⟩
      obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp (hnet j hx)
      have hyK : y ∈ K := hnetK j hy
      have hxy' : dist x y < 1 / ((j : ℝ) + 1) := Metric.mem_ball.mp hxy
      rw [← hgη] at hdist
      have h1 : dist (J m ω x) (J m ω y) < r := hωmod x hx y hyK hxy'
      have h2 : dist (J m ω y) (J m (pick ⟨s, hsS⟩) y) < r :=
        (dist_le_pi_dist (g ω) (g (pick ⟨s, hsS⟩)) ⟨y, hy⟩).trans_lt hdist
      have h3 : dist (J m (pick ⟨s, hsS⟩) y) (J m (pick ⟨s, hsS⟩) x) < r :=
        hηD.2 y hyK x hx (by rwa [dist_comm])
      have h4 := dist_triangle4 (J m ω x) (J m ω y) (J m (pick ⟨s, hsS⟩) y)
        (J m (pick ⟨s, hsS⟩) x)
      rw [show 3 / ((m : ℝ) + 1) = r + r + r by rw [hr_def]; ring]
      linarith
  choose E' hE'c hE'D hE' using key
  refine ⟨⋃ m, ⋃ j, E' m j,
    Set.countable_iUnion fun m => Set.countable_iUnion fun j => hE'c m j, ?_⟩
  intro ω hω
  -- At order `m`, `J m ω` is uniformly continuous on `K`; choose a scale and an approximant.
  have hlevel : ∀ m : ℕ, ∃ η ∈ ⋃ m', ⋃ j, E' m' j, η ∈ D ∧
      ∀ x ∈ K, dist (J m ω x) (J m η x) < 3 / ((m : ℝ) + 1) := by
    intro m
    have huc : UniformContinuousOn (J m ω) K :=
      hK.uniformContinuousOn_of_continuous (hJcont m ω).continuousOn
    obtain ⟨δ, hδ, hδ'⟩ := (Metric.uniformContinuousOn_iff (α := Eucl P) (β := (i : Fin (m + 1)) →
        ContinuousMultilinearMap ℝ (fun _ : Fin i => Eucl P) (Covector (Eucl P) k))).mp huc
      (1 / ((m : ℝ) + 1)) (by positivity)
    obtain ⟨j, hj⟩ := exists_nat_one_div_lt hδ
    obtain ⟨η, hηE, hη⟩ := hE' m j ω hω fun x hx y hy hxy => hδ' x hx y hy (hxy.trans hj)
    exact ⟨η, Set.mem_iUnion.2 ⟨m, Set.mem_iUnion.2 ⟨j, hηE⟩⟩, hE'D m j hηE, hη⟩
  choose e heE heD he using hlevel
  -- `K' := K`; for `m ≥ i` the `i`-th derivatives of `e m` are within `3/(m+1)` of those of `ω`.
  refine ⟨e, heE, K, hK, hKU, heD, hω, fun i => Metric.tendstoUniformlyOn_iff.2 fun ε hε => ?_⟩
  obtain ⟨m₀, hm₀⟩ := exists_nat_gt (3 / ε)
  filter_upwards [eventually_ge_atTop (max i m₀)] with m hm x hx
  have him : i < m + 1 := Nat.lt_succ_of_le ((le_max_left i m₀).trans hm)
  have h3 : 3 / ((m : ℝ) + 1) < ε := by
    have hm' : (m₀ : ℝ) ≤ m := by exact_mod_cast (le_max_right i m₀).trans hm
    rw [div_lt_iff₀ (by positivity)]
    rw [div_lt_iff₀ hε] at hm₀
    nlinarith
  exact (dist_le_pi_dist (J m ω x) (J m (e m) x) ⟨i, him⟩).trans_lt ((he m x hx).trans h3)

/-- Simon's currents are sequentially continuous at every test form: if `e l → ω` in `𝒟ᵏ(U)`,
then `S (e l) → S ω`.  The differences `e l - ω` converge to `0` on the same compact set, so
continuity of `S` at `0` (`GeometricCurrentOn.continuous'`) and linearity give the limit. -/
theorem Submission.slicing_im_td_current_tendsto :
    ∀ (P k : ℕ) (U : Set (Eucl P)) (S : GeometricCurrentOn U k) (e : ℕ → TestFormOn U k)
      (ω : TestFormOn U k), TestFormOnConverges e ω →
        Tendsto (fun l => S (e l)) atTop (𝓝 (S ω)) := by
  intro P k U S e ω ⟨K, hK, hKU, he, hω, hd⟩
  -- `e l - ω → 0` on the same compact `K ⊆ U`.
  have hconv : TestFormOnConverges (fun l => e l - ω) 0 := by
    refine ⟨K, hK, hKU, fun l => (tsupport_sub _ _).trans (union_subset (he l) hω), by simp,
      fun i => Metric.tendstoUniformlyOn_iff.2 fun ε hε => ?_⟩
    -- The `i`-th derivatives of the smooth forms `e l` and `ω` subtract.
    have hsub : ∀ l x, iteratedFDeriv ℝ i
        ((e l : DifferentialForm (Eucl P) k) - (ω : DifferentialForm (Eucl P) k)) x =
          iteratedFDeriv ℝ i (e l : DifferentialForm (Eucl P) k) x -
            iteratedFDeriv ℝ i (ω : DifferentialForm (Eucl P) k) x := fun l x =>
      iteratedFDeriv_sub_apply ((e l).property.1.1.of_le (by exact_mod_cast le_top)).contDiffAt
        (ω.property.1.1.of_le (by exact_mod_cast le_top)).contDiffAt
    filter_upwards [Metric.tendstoUniformlyOn_iff.1 (hd i) ε hε] with l hl x hx
    simpa [hsub, dist_eq_norm, norm_sub_rev] using hl x hx
  -- Continuity of `S` at `0`, then linearity: `S (e l) = S (e l - ω) + S ω`.
  have hlim := (S.continuous' _ hconv).add_const (S ω)
  rw [zero_add] at hlim
  refine hlim.congr fun l => ?_
  rw [S.toCurrent.map_sub (e l) ω, sub_add_cancel]

/-- A countable family of test forms determines currents (the "countable dense set of
`ω ∈ 𝒟ⁿ(U)`" in the proof of Simon Ch. 6, 4.5(2)): for open `U ⊆ ℝ^P` there is a countable
`E ⊆ 𝒟ᵏ(U)` such that two currents in `𝒟ₖ(U)` agreeing on `E` are equal. -/
theorem Submission.slicing_im_testform_determining :
    ∀ (P k : ℕ) (U : Set (Eucl P)), IsOpen U → ∃ E : Set (TestFormOn U k), E.Countable ∧
      ∀ S R : GeometricCurrentOn U k, (∀ e ∈ E, S e = R e) → S = R := by
  intro P k U hU
  -- Exhaust `U` by the compact sets `closure (W i) ⊆ U` and take, for each `i`, a countable
  -- family `E i` approximating every form supported in `closure (W i)`.
  obtain ⟨W, hW, hWK⟩ := Submission.cmb_exists_compactly_contained_exhaustion P U hU
  choose E hE hEω using fun i => Submission.slicing_im_td_countable_seq_dense P k U
    (closure (W i)) (hW i).2.1 (hW i).2.2
  refine ⟨⋃ i, E i, countable_iUnion hE, fun S R hSR => GeometricCurrentOn.ext fun ω => ?_⟩
  -- `tsupport ω` is a compact subset of `U`, hence lies in some `W i`.
  obtain ⟨i, hi⟩ := hWK _ ω.2.1.2 ω.2.2
  obtain ⟨e, heE, he⟩ := hEω i ω (hi.trans subset_closure)
  -- `S (e l) = R (e l)` for every `l`, while `S (e l) → S ω` and `R (e l) → R ω`.
  refine tendsto_nhds_unique (Submission.slicing_im_td_current_tendsto P k U S e ω he) ?_
  exact (Submission.slicing_im_td_current_tendsto P k U R e ω he).congr fun l =>
    (hSR (e l) (mem_iUnion.2 ⟨i, heE l⟩)).symm

/-- **A rectifiable triple defines a current `τ(M, θ, ξ)` (Simon Ch. 6, 3.1, p. 146).**  For a
rectifiable triple `(M, θ, ξ)` in `U`, `ω ↦ ∫_M θ(x) ⟨ω(x), ξ(x)⟩ dHᵏ(x)` is a sequentially
continuous linear functional on `𝒟ᵏ(U)`.  The integrand is integrable (`ltg_tau_integrable`) and
linear in `ω`.  If `ω_j → 0` in `𝒟ᵏ(U)`, all `ω_j` are supported in one compact `K ⊆ U` and
`ω_j → 0` uniformly; as `|⟨α, ξ⟩| ≤ ‖α‖` `Hᵏ⌞M`-a.e. (`fiw_ims_tt_unit_bound`), eventually
`|θ ⟨ω_j, ξ⟩| ≤ |θ| 1_K ∈ L¹(Hᵏ⌞M)`, and dominated convergence gives `τ(M, θ, ξ)(ω_j) → 0`. -/
theorem Submission.slicing_im_tau_current : ∀ (P k : ℕ) (U M : Set (Eucl P)) (θ : Eucl P → ℝ) (ξ : Eucl P → NVector (Eucl P) k), IsRectifiableTriple U k M θ ξ → ∃ R : GeometricCurrentOn U k, ∀ ω : TestFormOn U k, R ω = tauAction k M θ ξ ω := by
  intro P k U M θ ξ hT
  -- Step 1: for a test form `ω`, `x ↦ θ(x) ⟨ω(x), ξ(x)⟩` is `Hᵏ`-integrable on `M`.
  have hI : ∀ ω : TestFormOn U k, IntegrableOn
      (fun x => θ x * ξ x ((ω : DifferentialForm (Eucl P) k) x)) M (μHE[k] : Measure (Eucl P)) :=
    fun ω => (Submission.ltg_tau_integrable P k U M θ ξ hT).2 _
      (ContDiff.continuous ω.property.1.1) ω.property.1.2 ω.property.2
  -- Unit orientation: `|⟨α, ξ(x)⟩| ≤ ‖α‖` for `Hᵏ⌞M`-a.e. `x`.
  have hunit : ∀ᵐ x ∂((μHE[k] : Measure (Eucl P)).restrict M),
      ∀ α : Covector (Eucl P) k, |ξ x α| ≤ ‖α‖ := by
    filter_upwards [hT.orients] with x hx α
    obtain ⟨τ, hτ, -, hξ⟩ := hx
    exact Submission.fiw_ims_tt_unit_bound P k τ (ξ x) hτ hξ α
  refine ⟨⟨{ toFun := fun ω => tauAction k M θ ξ ω
             map_add' := fun ω η => ?_
             map_smul' := fun c ω => ?_ }, fun ωs hconv => ?_⟩, fun ω => rfl⟩
  · -- Step 2 (additivity): `θ ⟨ω + η, ξ⟩ = θ ⟨ω, ξ⟩ + θ ⟨η, ξ⟩`, both integrable.
    simp only [tauAction, Submodule.coe_add, Pi.add_apply, map_add, mul_add]
    exact integral_add (hI ω) (hI η)
  · -- Step 2 (homogeneity): `θ ⟨c ω, ξ⟩ = c θ ⟨ω, ξ⟩`.
    simp only [tauAction, Submodule.coe_smul, Pi.smul_apply, map_smul, smul_eq_mul,
      RingHom.id_apply]
    rw [← integral_const_mul]
    congr 1
    funext x
    ring
  · -- Step 3 (continuity): `ω_j → 0` in `𝒟ᵏ(U)`, all supported in a compact `K ⊆ U`.
    show Tendsto (fun j => tauAction k M θ ξ (ωs j)) atTop (𝓝 0)
    obtain ⟨K, hKc, hKU, hsupp, -, hderiv⟩ := hconv
    have hKm : MeasurableSet K := hKc.isClosed.measurableSet
    -- `sup_x ‖ω_j(x)‖ → 0`: zeroth derivatives converge uniformly on `K`, and `ω_j = 0` off `K`.
    have hsmall : ∀ ε > 0, ∀ᶠ j in atTop, ∀ x, ‖(ωs j : DifferentialForm (Eucl P) k) x‖ < ε := by
      intro ε hε
      filter_upwards [Metric.tendstoUniformlyOn_iff.mp (hderiv 0) ε hε] with j hj x
      by_cases hx : x ∈ K
      · simpa using hj x hx
      · rw [image_eq_zero_of_notMem_tsupport (fun h => hx (hsupp j h)), norm_zero]
        exact hε
    -- Dominated convergence on `Hᵏ⌞M` with the integrable bound `|θ| 1_K`.
    have key := tendsto_integral_filter_of_dominated_convergence
      (μ := (μHE[k] : Measure (Eucl P)).restrict M) (l := atTop)
      (F := fun j x => θ x * ξ x ((ωs j : DifferentialForm (Eucl P) k) x))
      (f := fun _ => (0 : ℝ)) (K.indicator fun x => |θ x|)
      (Eventually.of_forall fun j => (hI (ωs j)).aestronglyMeasurable)
      ?_ ?_ ?_
    · simp only [integral_zero] at key
      exact key
    · -- Domination: once `‖ω_j‖ < 1`, `|θ ⟨ω_j, ξ⟩| ≤ |θ| 1_K` `Hᵏ⌞M`-a.e.
      filter_upwards [hsmall 1 one_pos] with j hj
      filter_upwards [hunit] with x hx
      by_cases hxK : x ∈ K
      · rw [indicator_of_mem hxK, norm_mul, Real.norm_eq_abs, Real.norm_eq_abs]
        calc |θ x| * |ξ x ((ωs j : DifferentialForm (Eucl P) k) x)| ≤ |θ x| * 1 :=
              mul_le_mul_of_nonneg_left ((hx _).trans (hj x).le) (abs_nonneg _)
          _ = |θ x| := mul_one _
      · rw [indicator_of_notMem hxK, image_eq_zero_of_notMem_tsupport (fun h => hxK (hsupp j h)),
          map_zero, mul_zero, norm_zero]
    · -- `|θ| 1_K` is integrable on `M`: `θ` is integrable on `M ∩ K`.
      rw [integrable_indicator_iff hKm, IntegrableOn, Measure.restrict_restrict hKm, inter_comm]
      exact (hT.integrableOn K hKc hKU).abs
    · -- Pointwise limit: `ω_j(x) → 0`, so `θ(x) ⟨ω_j(x), ξ(x)⟩ → 0`.
      refine Eventually.of_forall fun x => ?_
      have h0 : Tendsto (fun j => (ωs j : DifferentialForm (Eucl P) k) x) atTop (𝓝 0) :=
        Metric.tendsto_nhds.mpr fun ε hε => (hsmall ε hε).mono fun j hj => by
          rw [dist_zero_right]; exact hj x
      have h1 := ((ξ x).continuous.tendsto 0).comp h0
      rw [map_zero] at h1
      simpa using (tendsto_const_nhds (x := θ x)).mul h1

/-- Simon Ch. 6, 4.4–4.5(2) (pp. 155–157): if `T` is integer multiplicity, with `M_W(T)` and
`M_W(∂T)` finite for every `W ⊂⊂ U`, and `f` is `L`-Lipschitz on `U`, then for `L¹`-a.e. `t` every
slice `S` with `IsSlice T f t S` is integer multiplicity.  Write `T = τ(M, θ, ξ)` and let `g` be
a McShane extension of `f`.  `IsSlice` only sees `f` on `U`, so slices of `T` by `f` and by `g`
coincide.  Let `G` be a tangential gradient of `g` on `M` and `E` a countable family of test forms
determining currents.  For a.e. `t`, the triple `(M_t, θ, ξ⌞(G/|G|))` with
`M_t = {x ∈ M : g(x) = t, G(x) ≠ 0}` is rectifiable, and every slice agrees on each `e ∈ E` with
the current `τ(M_t, θ, ξ⌞(G/|G|))`, hence equals it; `θ` is integer-valued on `M_t ⊆ M`. -/
theorem Submission.slicing_integer_multiplicity_ae : ∀ (P m : ℕ) (U : Set (Eucl P)), IsOpen U → ∀ T : GeometricCurrentOn U (m + 1), (∀ W, CompactlyContainedOpen W U → T.massOn W < ∞ ∧ T.boundary.massOn W < ∞) → ∀ (f : Eucl P → ℝ) (L : ℝ≥0), LipschitzOnWith L f U → IsIntegerMultiplicity T → ∀ᵐ t ∂(volume : Measure ℝ), ∀ S : GeometricCurrentOn U m, IsSlice T f t S → IsIntegerMultiplicity S := by
  intro P m U hU T _hmass f L hf hT
  obtain ⟨M, θ, ξ, hMθξ, hθ, hTM⟩ := hT
  -- Step 1: a McShane extension `g` of `f`; the sets `{f < t}` and `{g < t}` agree inside `U`.
  obtain ⟨g, hg, hfg⟩ := hf.extend_real
  have hslice : ∀ t (S : GeometricCurrentOn U m), IsSlice T f t S → IsSlice T g t S := by
    intro t S hS
    have hA : {x | x ∈ U ∧ f x < t} = {x | x ∈ U ∧ g x < t} :=
      Set.ext fun x => and_congr_right fun hx => by rw [hfg hx]
    unfold IsSlice at hS ⊢
    rwa [← hA]
  -- Step 2: a tangential gradient `G` of `g` on `M`, and a countable determining family `E`.
  obtain ⟨G, hGm, hGL, hG⟩ := Submission.slicing_im_tangential_gradient P m U M θ ξ g L hU hMθξ hg
  obtain ⟨E, hEc, hE⟩ := Submission.slicing_im_testform_determining P m U hU
  -- Step 3: for a.e. `t` the slice triple is rectifiable and every slice agrees with its current
  -- on each of the countably many `e ∈ E`.
  filter_upwards [Submission.slicing_im_slice_triple P m U M θ ξ g L G hU hMθξ hg hGm hGL hG,
    (ae_ball_iff hEc).2 fun e (_ : e ∈ E) =>
      Submission.slicing_im_slice_identity P m U M θ ξ T g L G hU hMθξ hTM hg hGm hGL hG e]
    with t ht hSE
  intro S hS
  -- Step 4: `S` equals the current `τ(M_t, θ, ξ⌞(G/|G|))`, whose multiplicity is `θ`.
  obtain ⟨R, hR⟩ := Submission.slicing_im_tau_current P m U _ θ _ ht
  have hSR : S = R := hE S R fun e he => (hSE e he S (hslice t S hS)).trans (hR e).symm
  refine ⟨_, θ, _, ht, fun x hx => hθ x hx.1, fun ω => ?_⟩
  rw [hSR, hR]

/-- **Simon Ch. 6, §4 Slicing (4.4–4.10, pp. 153–158).**  Choose for every level `t` a slice
`S t = ∂(T ⌞ {f < t}) − (∂T) ⌞ {f < t}` (4.6).  Every slice satisfies the support bound 4.8;
for integer multiplicity `T`, off one `L¹`-null set of levels every slice is integer
multiplicity (4.4, 4.5(2)); and any family of slices obeys the mass bound 4.9–4.10. -/
theorem Submission.slicing_theorem : SlicingTheorem := by
  intro P m U hU T hT f L hf
  -- 4.6: a slice at every level.
  choose S hS using Submission.slicing_exists P m U hU T hT f L hf
  refine ⟨S, hS, fun t => Submission.slicing_support_subset P m U hU T f L hf t (S t) (hS t),
    fun hIM => ?_, Submission.slicing_mass_bound P m U hU T hT f L hf S hS⟩
  -- 4.5(2): the exceptional null set of levels does not depend on the chosen slices.
  filter_upwards [Submission.slicing_integer_multiplicity_ae P m U hU T hT f L hf hIM] with t ht
  exact ht (S t) (hS t)

/-- Tangential differential of a locally Lipschitz map along a rectifiable triple (Simon Ch. 3 §2,
2.1–2.2 and p. 76; input to Simon Ch. 6, 3.6).  If `U ⊆ ℝ^P` is open, `(M, θ, ξ)` is a rectifiable
triple in `U` and `f` is locally Lipschitz on `U`, there is `L : ℝ^P → L(ℝ^P, ℝ^Q)`, strongly
measurable and bounded on `M ∩ K` for compact `K ⊆ U`, such that for `Hⁿ`-a.e. `x ∈ M`,
`t ↦ f(x + t v)` has derivative `L(x) v` at `0` for every `v` in every weighted approximate
tangent space of `(M, θ)` at `x`. -/
theorem Submission.lpf_tangential_differential_exists : ∀ (P Q n : ℕ) (U M : Set (Eucl P)) (θ : Eucl P → ℝ) (ξ : Eucl P → NVector (Eucl P) n) (f : Eucl P → Eucl Q), IsOpen U → IsRectifiableTriple U n M θ ξ → LocallyLipschitzOn U f → ∃ L : Eucl P → (Eucl P →L[ℝ] Eucl Q), (∀ᵐ x ∂((μHE[n] : Measure (Eucl P)).restrict M), ∀ Tx : Submodule ℝ (Eucl P), HasWeightedApproximateTangentSpaceAt n M θ x Tx → ∀ v ∈ Tx, HasDerivAt (fun t : ℝ => f (x + t • v)) (L x v) 0) ∧ AEStronglyMeasurable L ((μHE[n] : Measure (Eucl P)).restrict M) ∧ ∀ K : Set (Eucl P), IsCompact K → K ⊆ U → ∃ C : ℝ, ∀ x ∈ M ∩ K, ‖L x‖ ≤ C := by
  intro P Q n U M θ ξ f hU hM hf
  -- Step 1: `C¹` charts `Φ j`, Lipschitz and antilipschitz on the open `Ω j`, whose images cover
  -- `Hⁿ`-almost all of `M`.
  obtain ⟨Φ, Ω, hΩ, hΦ, hΦlip, hΦanti, hcov⟩ :=
    Submission.lpf_countably_rectifiable_c1_cover P n M hM.countablyRectifiable
  choose KΦ hKΦ using hΦlip
  have hΦd : ∀ j w, HasFDerivAt (Φ j) (fderiv ℝ (Φ j) w) w := fun j w =>
    ((hΦ j).differentiable one_ne_zero w).hasFDerivAt
  -- Steps 2–3: a strongly measurable `L`, `0` off the charts, with `L x (DΦ j(w) s) =
  -- D(f ∘ Φ j)(w) s` at a chart point `x = Φ j w`.
  obtain ⟨L, hLm, hL0, hLc⟩ :=
    Submission.lpf_tde_measurable_chart_differential P Q n Φ Ω f hΩ hΦ hΦanti
  refine ⟨L, ?_, hLm.aestronglyMeasurable, ?_⟩
  · -- Step 4 (a): `Hⁿ`-almost every point of `M` lies in a chart.
    have h₁ : ∀ᵐ x ∂((μHE[n] : Measure (Eucl P)).restrict M), x ∈ ⋃ j, Φ j '' Ω j := by
      rw [ae_restrict_iff'₀ hM.nullMeasurableSet, ae_iff]
      exact measure_mono_null (fun x hx => not_imp.1 hx) hcov
    -- Step 4 (b): Rademacher; the chart image of the non-differentiability set of `f ∘ Φ j` is
    -- `Hⁿ`-null.
    have h₂ : ∀ᵐ x ∂((μHE[n] : Measure (Eucl P)).restrict M), ∀ j,
        x ∉ Φ j '' {w | w ∈ Ω j ∧ Φ j w ∈ U ∧ ¬ DifferentiableAt ℝ (f ∘ Φ j) w} :=
      ae_restrict_of_ae (ae_all_iff.2 fun j => measure_eq_zero_iff_ae_notMem.1
        (Submission.lpf_tde_chart_nondiff_image_null P Q n U f (Φ j) (Ω j) (KΦ j) hU hf (hΩ j)
          (hKΦ j)))
    -- Step 4 (c): at `Hⁿ`-a.e. `x = Φ j w ∈ M`, `range DΦ j(w)` is a weighted approximate tangent
    -- space of `(M, θ)`.
    have h₃ : ∀ᵐ x ∂((μHE[n] : Measure (Eucl P)).restrict M), ∀ j, ∀ w ∈ Ω j, Φ j w = x →
        HasWeightedApproximateTangentSpaceAt n M θ x
          (LinearMap.range (fderiv ℝ (Φ j) w).toLinearMap) := by
      refine ae_all_iff.2 fun j => ?_
      have h := Submission.lpf_weighted_tangent_on_c1_chart P n U M θ (Φ j) (Ω j) hU hM.subset
        hM.nullMeasurableSet hM.pos hM.integrableOn (hΩ j) (hΦ j) (hΦanti j)
      -- The statement is vacuous off `Φ j '' Ω j`, so it passes from `M ∩ Φ j '' Ω j` to `M`.
      rw [ae_iff] at h ⊢
      rw [Measure.restrict_apply₀' hM.nullMeasurableSet]
      refine measure_mono_null ?_
        (nonpos_iff_eq_zero.1 ((Measure.le_restrict_apply _ _).trans h.le))
      intro x hx
      refine ⟨hx.1, hx.2, ?_⟩
      by_contra hxS
      exact hx.1 fun w hw hwx => (hxS ⟨w, hw, hwx⟩).elim
    -- Step 5: on the good set, `Tₓ = range DΦ j(w)` and fact (DD) gives the derivative.
    filter_upwards [h₁, h₂, h₃, ae_restrict_mem₀ hM.nullMeasurableSet] with x hx₁ hx₂ hx₃ hxM
    intro Tx hTx v hv
    obtain ⟨j, w, hwΩ, hwx, hLs, -⟩ := hLc x hx₁
    have hxU : x ∈ U := hM.subset hxM
    -- Uniqueness of weighted approximate tangent spaces (`θ x > 0`).
    rw [hTx.unique (hM.pos x hxM).ne' (hx₃ j w hwΩ hwx)] at hv
    obtain ⟨s, rfl⟩ := hv
    -- `f ∘ Φ j` is differentiable at `w`, since `x` avoids the image in (b).
    have hd : DifferentiableAt ℝ (f ∘ Φ j) w := by
      by_contra hnd
      exact hx₂ j ⟨w, ⟨hwΩ, by rw [hwx]; exact hxU, hnd⟩, hwx⟩
    -- `f` is Lipschitz on a ball around `x`.
    obtain ⟨C, ρ, hρ, hCρ⟩ := Submission.lpf_tde_uniform_lipschitz_near_compact P Q U {x} f hU hf
      isCompact_singleton (singleton_subset_iff.2 hxU)
    have hlip : LipschitzOnWith C f (ball (Φ j w) ρ) := by
      rw [hwx]
      exact (hCρ x (mem_singleton x)).2
    have hDD := (Submission.lpf_tde_chart_directional_deriv P Q n f (Φ j) w _ _ C ρ hρ hlip
      (hΦd j w) hd.hasFDerivAt s).1
    rw [hwx] at hDD
    rw [ContinuousLinearMap.coe_coe, hLs s]
    exact hDD
  · -- Step 6: a uniform Lipschitz constant near `K` and fact (DD) bound `‖L x‖`.
    intro K hK hKU
    obtain ⟨C, ρ, hρ, hCρ⟩ :=
      Submission.lpf_tde_uniform_lipschitz_near_compact P Q U K f hU hf hK hKU
    refine ⟨(C : ℝ), fun x hx => ?_⟩
    by_cases hx₁ : x ∈ ⋃ j, Φ j '' Ω j
    · obtain ⟨j, w, hwΩ, hwx, -, hLv⟩ := hLc x hx₁
      have hlip : LipschitzOnWith C f (ball (Φ j w) ρ) := by
        rw [hwx]
        exact (hCρ x hx.2).2
      refine ContinuousLinearMap.opNorm_le_bound _ C.coe_nonneg fun v => ?_
      obtain ⟨s, hs, hLvs⟩ := hLv v
      rw [hLvs]
      by_cases hd : DifferentiableAt ℝ (f ∘ Φ j) w
      · calc ‖fderiv ℝ (f ∘ Φ j) w s‖ ≤ C * ‖fderiv ℝ (Φ j) w s‖ :=
              (Submission.lpf_tde_chart_directional_deriv P Q n f (Φ j) w _ _ C ρ hρ hlip
                (hΦd j w) hd.hasFDerivAt s).2
          _ ≤ C * ‖v‖ := mul_le_mul_of_nonneg_left hs C.coe_nonneg
      · rw [fderiv_zero_of_not_differentiableAt hd, zero_apply, norm_zero]
        positivity
    · rw [hL0 x hx₁, norm_zero]
      exact C.coe_nonneg

/-- Simon Ch. 6, (3.6): an `n`-vector density `w` that is dominated by an integrable function on
`g⁻¹(K)` for every compact `K ⊆ V` defines a current `ω ↦ ∫ ⟨ω(g x), w x⟩ dμ(x)` in `𝒟ₙ(V)`. -/
theorem Submission.lpf_pic_current_of_dominated_density :
    ∀ (P Q n : ℕ) (V : Set (Eucl Q)) (μ : Measure (Eucl P)) (g : Eucl P → Eucl Q) (w : Eucl P → NVector (Eucl Q) n), AEMeasurable g μ → AEStronglyMeasurable w μ → (∀ K : Set (Eucl Q), IsCompact K → K ⊆ V → ∃ h : Eucl P → ℝ, Integrable h μ ∧ ∀ᵐ x ∂μ, g x ∈ K → ‖w x‖ ≤ h x) → ∃ S : GeometricCurrentOn V n, ∀ ω : TestFormOn V n, S ω = ∫ x, w x ((ω : DifferentialForm (Eucl Q) n) (g x)) ∂μ := by
  intro P Q n V μ g w hg hw hdom
  -- Step 1: `x ↦ ⟨η (g x), w x⟩` is a.e. strongly measurable for continuous `η`.
  have hmeas : ∀ η : Eucl Q → Covector (Eucl Q) n, Continuous η →
      AEStronglyMeasurable (fun x => w x (η (g x))) μ := by
    intro η hη
    have hηg : AEStronglyMeasurable (fun x => η (g x)) μ :=
      hη.comp_aestronglyMeasurable hg.aestronglyMeasurable
    have hev : Continuous (Function.uncurry
        fun (φ : NVector (Eucl Q) n) (v : Covector (Eucl Q) n) => φ v) :=
      continuous_fst.clm_apply continuous_snd
    exact hev.comp_aestronglyMeasurable₂ hw hηg
  -- Step 2: if `tsupport η ⊆ K` and `‖η‖ ≤ B`, then `|⟨η ∘ g, w⟩| ≤ B |h|` a.e.
  have hkey : ∀ (η : Eucl Q → Covector (Eucl Q) n) (K : Set (Eucl Q)) (h : Eucl P → ℝ) (B : ℝ),
      Continuous η → tsupport η ⊆ K → Integrable h μ → (∀ᵐ x ∂μ, g x ∈ K → ‖w x‖ ≤ h x) →
      (∀ y, ‖η y‖ ≤ B) →
      Integrable (fun x => w x (η (g x))) μ ∧
        ‖∫ x, w x (η (g x)) ∂μ‖ ≤ B * ∫ x, ‖h x‖ ∂μ := by
    intro η K h B hη hK hh hwh hB
    have hB0 : 0 ≤ B := (norm_nonneg _).trans (hB 0)
    have hbound : ∀ᵐ x ∂μ, ‖w x (η (g x))‖ ≤ B * ‖h x‖ := by
      filter_upwards [hwh] with x hx
      by_cases hgx : g x ∈ K
      · calc ‖w x (η (g x))‖ ≤ ‖w x‖ * ‖η (g x)‖ := (w x).le_opNorm _
          _ ≤ ‖h x‖ * B :=
            mul_le_mul ((hx hgx).trans (Real.le_norm_self _)) (hB _) (norm_nonneg _)
              (norm_nonneg _)
          _ = B * ‖h x‖ := mul_comm _ _
      · rw [image_eq_zero_of_notMem_tsupport fun hx' => hgx (hK hx'), map_zero, norm_zero]
        exact mul_nonneg hB0 (norm_nonneg _)
    have hint : Integrable (fun x => B * ‖h x‖) μ := hh.norm.const_mul B
    refine ⟨hint.mono' (hmeas η hη) hbound, ?_⟩
    calc ‖∫ x, w x (η (g x)) ∂μ‖ ≤ ∫ x, B * ‖h x‖ ∂μ := norm_integral_le_of_norm_le hint hbound
      _ = B * ∫ x, ‖h x‖ ∂μ := integral_const_mul B _
  -- Step 3: the integrand of every test form is integrable.
  have hintω : ∀ ω : TestFormOn V n,
      Integrable (fun x => w x ((ω : DifferentialForm (Eucl Q) n) (g x))) μ := by
    intro ω
    have hcont : Continuous (ω : DifferentialForm (Eucl Q) n) := ContDiff.continuous ω.property.1.1
    have hcs : HasCompactSupport (ω : DifferentialForm (Eucl Q) n) := ω.property.1.2
    obtain ⟨h, hh, hwh⟩ := hdom (tsupport (ω : DifferentialForm (Eucl Q) n)) hcs ω.property.2
    obtain ⟨B, hB⟩ := hcont.bounded_above_of_compact_support hcs
    exact (hkey _ _ h B hcont subset_rfl hh hwh hB).1
  -- Step 4: the linear functional `ω ↦ ∫ ⟨ω (g x), w x⟩ dμ`.
  let S₀ : TestFormOn V n →ₗ[ℝ] ℝ :=
    { toFun := fun ω => ∫ x, w x ((ω : DifferentialForm (Eucl Q) n) (g x)) ∂μ
      map_add' := by
        intro ω₁ ω₂
        simp only [Submodule.coe_add, Pi.add_apply, map_add]
        exact integral_add (hintω ω₁) (hintω ω₂)
      map_smul' := by
        intro c ω
        simp only [Submodule.coe_smul, Pi.smul_apply, map_smul, smul_eq_mul, RingHom.id_apply]
        exact integral_const_mul c _ }
  -- Step 5: sequential continuity at `0`, from uniform convergence of the forms themselves.
  refine ⟨⟨S₀, ?_⟩, fun ω => rfl⟩
  intro ωs hconv
  obtain ⟨K, hKc, hKV, hsupp, -, hunif⟩ := hconv
  obtain ⟨h, hh, hwh⟩ := hdom K hKc hKV
  set I := ∫ x, ‖h x‖ ∂μ
  have hI0 : 0 ≤ I := integral_nonneg fun x => norm_nonneg _
  have h0 := Metric.tendstoUniformlyOn_iff.1 (hunif 0)
  rw [Metric.tendsto_nhds]
  intro ε hε
  have hδ : 0 < ε / (I + 1) := div_pos hε (by linarith)
  filter_upwards [h0 _ hδ] with j hj
  have hBj : ∀ y, ‖(ωs j : DifferentialForm (Eucl Q) n) y‖ ≤ ε / (I + 1) := by
    intro y
    by_cases hy : y ∈ K
    · have h1 := hj y hy
      have h2 : iteratedFDeriv ℝ 0 ((0 : TestFormOn V n) : DifferentialForm (Eucl Q) n) y = 0 := by
        rw [← norm_eq_zero, norm_iteratedFDeriv_zero]
        simp
      rw [h2, dist_zero_left, norm_iteratedFDeriv_zero] at h1
      exact h1.le
    · rw [image_eq_zero_of_notMem_tsupport fun hy' => hy (hsupp j hy'), norm_zero]
      exact hδ.le
  have hcont : Continuous (ωs j : DifferentialForm (Eucl Q) n) :=
    ContDiff.continuous (ωs j).property.1.1
  have hle := (hkey _ K h _ hcont (hsupp j) hh hwh hBj).2
  rw [Real.dist_eq, sub_zero, ← Real.norm_eq_abs]
  refine lt_of_le_of_lt hle ?_
  rw [div_mul_eq_mul_div, div_lt_iff₀ (by linarith)]
  nlinarith

/-- Measurability of the push-forward density in Simon Ch. 6, (3.6) (p. 147): for a rectifiable
triple `(M, θ, ξ)` in an open `U` and an `Hⁿ⌞M`-a.e. strongly measurable `L`, the density
`x ↦ θ(x) L(x)_# ξ(x)` is `Hⁿ⌞M`-a.e. strongly measurable. -/
theorem Submission.lpf_pic_density_aestronglyMeasurable : ∀ (P Q n : ℕ) (U M : Set (Eucl P)) (θ : Eucl P → ℝ) (ξ : Eucl P → NVector (Eucl P) n) (L : Eucl P → (Eucl P →L[ℝ] Eucl Q)), IsOpen U → IsRectifiableTriple U n M θ ξ → AEStronglyMeasurable L ((μHE[n] : Measure (Eucl P)).restrict M) → AEStronglyMeasurable (fun x => θ x • nVectorPushforward n (L x) (ξ x)) ((μHE[n] : Measure (Eucl P)).restrict M) := by
  intro P Q n U M θ ξ L hU hT hL
  -- `θ` is locally `Hⁿ`-integrable on `M` (compact neighbourhoods inside the open `U`), hence
  -- `Hⁿ⌞M`-a.e. strongly measurable since `ℝ^P` is second countable.
  have hloc : LocallyIntegrableOn θ M (μHE[n] : Measure (Eucl P)) := by
    intro x hx
    obtain ⟨K, hK, hxK, hKU⟩ := exists_compact_subset hU (hT.subset hx)
    exact ⟨M ∩ K, inter_mem_nhdsWithin M (mem_interior_iff_mem_nhds.mp hxK),
      hT.integrableOn K hK hKU⟩
  have hθ : AEStronglyMeasurable θ ((μHE[n] : Measure (Eucl P)).restrict M) :=
    hloc.aestronglyMeasurable
  -- `(A, v) ↦ A_# v = v ∘ A^#` is continuous, as `A ↦ A^#` and composition are.
  have hΦ : Continuous fun p : (Eucl P →L[ℝ] Eucl Q) × NVector (Eucl P) n =>
      nVectorPushforward n p.1 p.2 :=
    continuous_snd.clm_comp
      (ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM.comp continuous_fst)
  -- Compose with `x ↦ (L x, ξ x)` and multiply by `θ`.
  exact hθ.smul (hΦ.comp_aestronglyMeasurable (hL.prodMk hT.aestronglyMeasurable))

/-- **Domination of the push-forward density on a compact preimage (Simon Ch. 6, (3.6)).**  Let
`(M, θ, ξ)` be a rectifiable triple in `U`, `Z ⊆ U` with `Hⁿ(M \ Z) = 0`, `K' = f⁻¹(K) ∩ Z`
compact and `‖L x‖ ≤ C` on `M ∩ K'`.  Then `h = 1_{K'} Cⁿ θ` is `Hⁿ ⌞ M`-integrable (`θ` is
integrable on `M ∩ K'`, as `K' ⊆ U` is compact) and `‖θ(x) L(x)_# ξ(x)‖ ≤ h(x)` for `Hⁿ ⌞ M`-a.e.
`x` with `f x ∈ K`: a.e. such `x` lies in `M ∩ K'`; `‖A_# v‖ ≤ ‖A‖ⁿ ‖v‖` because `A_# v = v ∘ A^#`
and `‖A^# β‖ ≤ ‖A‖ⁿ ‖β‖`; and `‖ξ(x)‖ ≤ 1` because `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ` with `τ` orthonormal. -/
theorem Submission.lpf_pic_density_dominated : ∀ (P Q n : ℕ) (U Z M : Set (Eucl P)) (θ : Eucl P → ℝ) (ξ : Eucl P → NVector (Eucl P) n) (f : Eucl P → Eucl Q) (L : Eucl P → (Eucl P →L[ℝ] Eucl Q)) (K : Set (Eucl Q)), IsRectifiableTriple U n M θ ξ → Z ⊆ U → (μHE[n] : Measure (Eucl P)) (M \ Z) = 0 → IsCompact (f ⁻¹' K ∩ Z) → (∃ C : ℝ, ∀ x ∈ M ∩ (f ⁻¹' K ∩ Z), ‖L x‖ ≤ C) → ∃ h : Eucl P → ℝ, Integrable h ((μHE[n] : Measure (Eucl P)).restrict M) ∧ ∀ᵐ x ∂((μHE[n] : Measure (Eucl P)).restrict M), f x ∈ K → ‖θ x • nVectorPushforward n (L x) (ξ x)‖ ≤ h x := by
  rintro P Q n U Z M θ ξ f L K hR hZU hMZ hK ⟨C, hC⟩
  -- (1) `‖A_# v‖ ≤ ‖A‖ⁿ ‖v‖`, from `A_# v = v ∘ A^#` and `‖A^# β‖ ≤ ‖A‖ⁿ ‖β‖`.
  have hpush : ∀ (A : Eucl P →L[ℝ] Eucl Q) (v : NVector (Eucl P) n),
      ‖nVectorPushforward n A v‖ ≤ ‖A‖ ^ n * ‖v‖ := by
    intro A v
    have hA : ‖covectorPullback n A‖ ≤ ‖A‖ ^ n := by
      refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) fun β => ?_
      simpa [covectorPullback, Fintype.card_fin, mul_comm] using
        ContinuousAlternatingMap.norm_compContinuousLinearMap_le β A
    calc ‖nVectorPushforward n A v‖ = ‖v.comp (covectorPullback n A)‖ := rfl
      _ ≤ ‖v‖ * ‖covectorPullback n A‖ := ContinuousLinearMap.opNorm_comp_le _ _
      _ ≤ ‖v‖ * ‖A‖ ^ n := by gcongr
      _ = ‖A‖ ^ n * ‖v‖ := mul_comm _ _
  -- (2) `‖ξ(x)‖ ≤ 1` a.e., since `ξ(x) = ±simpleNVector τ` with `τ` orthonormal.
  have hξ : ∀ᵐ x ∂((μHE[n] : Measure (Eucl P)).restrict M), ‖ξ x‖ ≤ 1 := by
    filter_upwards [hR.orients] with x hx
    obtain ⟨τ, hτ, -, hx⟩ := hx
    have hs : ‖simpleNVector τ‖ ≤ 1 :=
      calc ‖simpleNVector τ‖ ≤ ∏ i, ‖τ i‖ :=
            LinearMap.mkContinuous_norm_le _ (Finset.prod_nonneg fun i _ => norm_nonneg _) _
        _ = 1 := Finset.prod_eq_one fun i _ => hτ.1 i
    rcases hx with hx | hx
    · rw [hx]
      exact hs
    · rw [hx, norm_neg (simpleNVector τ)]
      exact hs
  -- (3) `Hⁿ ⌞ M`-a.e. point lies in `M ∩ Z`, as `M` is null measurable and `Hⁿ(M \ Z) = 0`.
  have hM : ∀ᵐ x ∂((μHE[n] : Measure (Eucl P)).restrict M), x ∈ M :=
    ae_restrict_mem₀ hR.nullMeasurableSet
  have hZ : ∀ᵐ x ∂((μHE[n] : Measure (Eucl P)).restrict M), x ∈ Z := by
    rw [ae_iff, Measure.restrict_apply₀' hR.nullMeasurableSet]
    have hset : {a | ¬a ∈ Z} ∩ M = M \ Z := by
      ext a
      simp [and_comm]
    rw [hset, hMZ]
  -- (4) `h = 1_{K'} Cⁿ θ` is `Hⁿ ⌞ M`-integrable: `K'` is compact (so measurable) and `K' ⊆ U`.
  have hKm : MeasurableSet (f ⁻¹' K ∩ Z) := hK.isClosed.measurableSet
  have hθK : IntegrableOn (fun x => C ^ n * θ x) (f ⁻¹' K ∩ Z)
      ((μHE[n] : Measure (Eucl P)).restrict M) := by
    rw [IntegrableOn, Measure.restrict_restrict hKm, inter_comm]
    exact (hR.integrableOn _ hK fun x hx => hZU hx.2).const_mul _
  refine ⟨(f ⁻¹' K ∩ Z).indicator fun x => C ^ n * θ x, hθK.integrable_indicator hKm, ?_⟩
  -- (5) For a.e. `x` with `f x ∈ K`: `x ∈ M ∩ K'`, so `‖L x‖ ≤ C`, `0 < θ x` and `‖ξ x‖ ≤ 1`.
  filter_upwards [hξ, hM, hZ] with x hξx hxM hxZ hfx
  have hxK : x ∈ f ⁻¹' K ∩ Z := ⟨hfx, hxZ⟩
  have hLC : ‖L x‖ ≤ C := hC x ⟨hxM, hxK⟩
  have hθx : 0 < θ x := hR.pos x hxM
  have hC0 : 0 ≤ C := (norm_nonneg _).trans hLC
  rw [indicator_of_mem hxK]
  calc ‖θ x • nVectorPushforward n (L x) (ξ x)‖
      = ‖θ x‖ * ‖nVectorPushforward n (L x) (ξ x)‖ :=
        (NormedSpace.toNormSMulClass).norm_smul (θ x) (nVectorPushforward n (L x) (ξ x))
    _ = θ x * ‖nVectorPushforward n (L x) (ξ x)‖ := by
        rw [Real.norm_eq_abs, abs_of_pos hθx]
    _ ≤ θ x * (‖L x‖ ^ n * ‖ξ x‖) := by
        gcongr
        exact hpush _ _
    _ ≤ θ x * (C ^ n * 1) := by gcongr
    _ = C ^ n * θ x := by ring

/-- **Simon Ch. 6, (3.6) (p. 147): the push-forward formula defines a current.**  Let
`T = τ(M, θ, ξ)` in the open `U`, `f` continuous on `U` with `f⁻¹(K) ∩ spt T` compact for every
compact `K ⊆ V`, and `L` an `Hⁿ ⌞ M`-a.e. strongly measurable field of linear maps bounded on
`M ∩ K` for every compact `K ⊆ U`.  Then `ω ↦ ∫_M θ(x) ⟨ω(f(x)), L(x)_# ξ(x)⟩ dHⁿ(x)` is a current
in `𝒟ₙ(V)`: the density `θ L_# ξ` is `Hⁿ ⌞ M`-a.e. strongly measurable, and on `{f ∈ K}` it is
dominated by `1_{K'} Cⁿ θ` with `K' = f⁻¹(K) ∩ spt T`, because `Hⁿ(M \ spt T) = 0`. -/
theorem Submission.lpf_pushforward_is_current : ∀ (P Q n : ℕ) (U : Set (Eucl P)) (V : Set (Eucl Q)), IsOpen U → IsOpen V → ∀ (T : GeometricCurrentOn U n) (M : Set (Eucl P)) (θ : Eucl P → ℝ) (ξ : Eucl P → NVector (Eucl P) n) (f : Eucl P → Eucl Q) (L : Eucl P → (Eucl P →L[ℝ] Eucl Q)), IsRectifiableTriple U n M θ ξ → (∀ ω : TestFormOn U n, T ω = tauAction n M θ ξ ω) → ContinuousOn f U → (∀ K, IsCompact K → K ⊆ V → IsCompact (f ⁻¹' K ∩ T.support)) → AEStronglyMeasurable L ((μHE[n] : Measure (Eucl P)).restrict M) → (∀ K : Set (Eucl P), IsCompact K → K ⊆ U → ∃ C : ℝ, ∀ x ∈ M ∩ K, ‖L x‖ ≤ C) → ∃ S : GeometricCurrentOn V n, ∀ ω : TestFormOn V n, S ω = ∫ x in M, θ x * nVectorPushforward n (L x) (ξ x) ((ω : DifferentialForm (Eucl Q) n) (f x)) ∂(μHE[n] : Measure (Eucl P)) := by
  intro P Q n U V hU hV T M θ ξ f L hT hTrep hf hprop hLm hLb
  -- `Hⁿ`-almost every point of `M` lies in `spt T`.
  have hnull := Submission.lpf_rectifiable_support_null P n U T M θ ξ hT hTrep
  -- `f` is `Hⁿ ⌞ M`-a.e. measurable, being continuous on the open set `U ⊇ M`.
  have hfm : AEMeasurable f ((μHE[n] : Measure (Eucl P)).restrict M) :=
    (hf.aemeasurable hU.measurableSet).mono_set hT.subset
  -- The density `θ L_# ξ` is `Hⁿ ⌞ M`-a.e. strongly measurable ...
  have hwm := Submission.lpf_pic_density_aestronglyMeasurable P Q n U M θ ξ L hU hT hLm
  -- ... and, for compact `K ⊆ V`, dominated on `{f ∈ K}` via the compact `f⁻¹(K) ∩ spt T ⊆ U`.
  have hdom : ∀ K : Set (Eucl Q), IsCompact K → K ⊆ V → ∃ h : Eucl P → ℝ,
      Integrable h ((μHE[n] : Measure (Eucl P)).restrict M) ∧
        ∀ᵐ x ∂((μHE[n] : Measure (Eucl P)).restrict M), f x ∈ K →
          ‖θ x • nVectorPushforward n (L x) (ξ x)‖ ≤ h x := fun K hK hKV =>
    Submission.lpf_pic_density_dominated P Q n U T.support M θ ξ f L K hT
      T.support_subset_domain hnull (hprop K hK hKV)
      (hLb _ (hprop K hK hKV) (inter_subset_right.trans T.support_subset_domain))
  -- The current of this density is the claimed one, as `(θ • A_# ξ) β = θ * (A_# ξ) β`.
  obtain ⟨S, hS⟩ := Submission.lpf_pic_current_of_dominated_density P Q n V
    ((μHE[n] : Measure (Eucl P)).restrict M) f
    (fun x => θ x • nVectorPushforward n (L x) (ξ x)) hfm hwm hdom
  exact ⟨S, hS⟩

/-- **Simon Ch. 6, Lemma 3.9 (p. 148).**  Write `T = τ(M, θ, ξ)` with `θ` integer valued.  The
tangential differential `d^M f` (Ch. 3, §2) supplies the linear maps `L x`; with them (3.6)
defines a current `S = f_# T` in `V`, and the area formula with 3.7–3.8 gives
`S = τ(f(M), N, ζ)` with `N` integer valued, so `S` is integer multiplicity. -/
theorem Submission.lipschitz_pushforward_integer_multiplicity :
    LipschitzPushforwardIntegerMultiplicity := by
  intro P Q n U V hU hV T f hT hf hfUV hproper
  obtain ⟨M, θ, ξ, hMθξ, hθ, hTrep⟩ := hT
  -- Ch. 3, §2: `L x` agrees with `d^M f_x` on the weighted tangent spaces of `(M, θ)`, and is
  -- measurable and locally bounded on `M`.
  obtain ⟨L, hLderiv, hLmeas, hLbdd⟩ :=
    Submission.lpf_tangential_differential_exists P Q n U M θ ξ f hU hMθξ hf
  -- (3.6) defines a current in `V`, since `f | spt T` is proper.
  obtain ⟨S, hS⟩ := Submission.lpf_pushforward_is_current P Q n U V hU hV T M θ ξ f L hMθξ hTrep
    hf.continuousOn hproper hLmeas hLbdd
  -- 3.6–3.8: by the area formula, `S = τ(f(M), N, ζ)` with `N` integer valued.
  exact ⟨S, ⟨M, θ, ξ, L, hMθξ, hTrep, hLderiv, hS⟩,
    Submission.lpf_pushforward_integrality P Q n U V hU hV T M θ ξ f L S hMθξ hθ hTrep hf hfUV
      hproper hLderiv hLmeas hS⟩

/-- **Simon Ch. 6, 5.3 (Deformation Theorem, scaled version, p. 160); `ρ = 1` is 5.1.**
Assembly of the decomposition (Part D and display (38) of the accepted proof): rescale `T` by
`x ↦ ρ⁻¹x` (`T′ = (η_{1/ρ})_# T`), deform `T′` onto the unit `n`-skeleton
(`T′ − Q = ∂R₁ + S₁`, `deformation_onto_skeleton`, which uses the slicing theorem and Lemma 3.9),
replace `Q` by a lattice chain (`Q − P = S′`, `deformation_skeleton_polyhedral`), and push
`P`, `R₁`, `S₁ + S′` forward by `x ↦ ρx` (`deformation_dilation`).  With `C₁`, `C₂` the constants
of the two deformation steps, `C = C₁ + C₁C₂`; the supports lie within `√n + √(n+ℓ) < 2√(n+ℓ)`
of `spt T′`, `spt ∂T′` before rescaling. -/
theorem Submission.deformation_theorem : DeformationTheorem := by
  intro m ℓ hℓ
  obtain ⟨C₁, hC₁⟩ := Submission.deformation_onto_skeleton Submission.slicing_theorem
    Submission.lipschitz_pushforward_integer_multiplicity m ℓ hℓ
  obtain ⟨C₂, hC₂⟩ := Submission.deformation_skeleton_polyhedral m ℓ hℓ
  refine ⟨C₁ + C₁ * C₂, fun T hT ρ hρ => ?_⟩
  set sd : ℝ := Real.sqrt ((m + 1 + ℓ : ℕ) : ℝ)
  set sn : ℝ := Real.sqrt ((m + 1 : ℕ) : ℝ)
  have hsn0 : 0 ≤ sn := Real.sqrt_nonneg _
  have hsd0 : 0 ≤ sd := Real.sqrt_nonneg _
  have hsnd : sn < sd := Real.sqrt_lt_sqrt (Nat.cast_nonneg _) (Nat.cast_lt.mpr (by omega))
  have hρ0 : ρ ≠ 0 := hρ.ne'
  have hρi : 0 < ρ⁻¹ := inv_pos.mpr hρ
  -- Dilation by `ρ⁻¹` (degrees `m + 1`, `m`) and by `ρ` (degrees `m + 1`, `m`, `m + 2`).
  obtain ⟨-, dilI, propI, -⟩ := Submission.deformation_dilation (m + 1 + ℓ) ρ⁻¹ hρi (m + 1)
  obtain ⟨-, -, propIb, bdI⟩ := Submission.deformation_dilation (m + 1 + ℓ) ρ⁻¹ hρi m
  obtain ⟨pull, dil, prop, bdR⟩ := Submission.deformation_dilation (m + 1 + ℓ) ρ hρ (m + 1)
  obtain ⟨-, -, propb, bd⟩ := Submission.deformation_dilation (m + 1 + ℓ) ρ hρ m
  obtain ⟨-, dilR, propR, -⟩ := Submission.deformation_dilation (m + 1 + ℓ) ρ hρ (m + 2)
  -- Step 1: `T′ = (η_{1/ρ})_# T`, `∂T′ = (η_{1/ρ})_# ∂T`, with scaled masses and supports.
  obtain ⟨T', hT'⟩ := dilI T
  have hbT' := bdI T T' hT'
  obtain ⟨hT'm, hT's, hT'im, -⟩ := propI T T' hT'
  obtain ⟨hbT'm, hbT's, hbT'im, -⟩ := propIb T.boundary T'.boundary hbT'
  obtain ⟨hTm, hTbm⟩ := ENNReal.add_lt_top.mp hT
  have hT'fin : T'.mass + T'.boundary.mass < ∞ := by
    rw [hT'm, hbT'm]
    exact ENNReal.add_lt_top.mpr
      ⟨ENNReal.mul_lt_top ENNReal.ofReal_lt_top hTm, ENNReal.mul_lt_top ENNReal.ofReal_lt_top hTbm⟩
  -- Step 2: deformation onto the unit skeleton, `T′ − Q = ∂R₁ + S₁`.
  obtain ⟨Q, R₁, S₁, hTQ, hQskel, hQface, hQm, hQbm, hR₁m, hS₁m, hQR₁s, hQbS₁s, hIM₁, hIM₂⟩ :=
    hC₁ T' hT'fin
  -- Step 3: the lattice chain `P = ∑ β_F [[F]]` with `Q − P = S′`.
  have hQfin : Q.mass + Q.boundary.mass < ∞ :=
    ENNReal.add_lt_top.mpr
      ⟨hQm.trans_lt (ENNReal.mul_lt_top ENNReal.coe_lt_top (ENNReal.add_lt_top.mp hT'fin).1),
        hQbm.trans_lt (ENNReal.mul_lt_top ENNReal.coe_lt_top (ENNReal.add_lt_top.mp hT'fin).2)⟩
  obtain ⟨β, P, S', hPβ, hQP, hPm, hPbm, hS'm, hPs, hPbS's, hIMP⟩ := hC₂ Q hQfin hQskel hQface
  -- Step 4: the current `S″ = S₁ + S′`, with `M(S″) ≤ M(S₁) + M(S′)` and
  -- `spt S″ ⊆ spt S₁ ∪ spt S′`.
  obtain ⟨S'', hS''⟩ : ∃ S'' : GeometricCurrentOn (univ : Set (Eucl (m + 1 + ℓ))) (m + 1),
      ∀ ω, S'' ω = S₁ ω + S' ω :=
    ⟨⟨S₁.toCurrent + S'.toCurrent, fun seq hseq => by
      simpa using (S₁.continuous' seq hseq).add (S'.continuous' seq hseq)⟩, fun _ => rfl⟩
  have hS''m : S''.mass ≤ S₁.mass + S'.mass := by
    refine sSup_le ?_
    rintro r ⟨ω, hω, rfl⟩
    simp only [hS'']
    exact ENNReal.ofReal_add_le.trans (add_le_add (S₁.le_massOn hω) (S'.le_massOn hω))
  have hS''s : S''.support ⊆ S₁.support ∪ S'.support := by
    rintro x ⟨-, hx⟩
    by_contra hx'
    rw [mem_union, not_or] at hx'
    have h₁ : x ∈ S₁.zeroRegion := by_contra fun h => hx'.1 ⟨mem_univ x, h⟩
    have h₂ : x ∈ S'.zeroRegion := by_contra fun h => hx'.2 ⟨mem_univ x, h⟩
    obtain ⟨W₁, ⟨hW₁o, hW₁c, -, hW₁⟩, hxW₁⟩ := h₁
    obtain ⟨W₂, ⟨hW₂o, -, -, hW₂⟩, hxW₂⟩ := h₂
    refine hx (mem_sUnion.mpr ⟨W₁ ∩ W₂, ⟨hW₁o.inter hW₂o,
      hW₁c.of_isClosed_subset isClosed_closure (closure_mono inter_subset_left),
      subset_univ _, fun ω hω => ?_⟩, hxW₁, hxW₂⟩)
    rw [hS'', hW₁ ω (hω.trans inter_subset_left), hW₂ ω (hω.trans inter_subset_right), add_zero]
  -- Step 5: `Pc = (η_ρ)_# P`, `R = (η_ρ)_# R₁`, `S = (η_ρ)_# S″`.
  obtain ⟨Pc, hPc⟩ := dil P
  obtain ⟨S, hS⟩ := dil S''
  obtain ⟨R, hR⟩ := dilR R₁
  have hbPc := bd P Pc hPc
  have hbR := bdR R₁ R hR
  obtain ⟨hPcm, hPcs, hPcim, hPcβ⟩ := prop P Pc hPc
  obtain ⟨hbPcm, hbPcs, -, -⟩ := propb P.boundary Pc.boundary hbPc
  obtain ⟨hSm, hSs, hSim, -⟩ := prop S'' S hS
  obtain ⟨hRm, hRs, hRim, -⟩ := propR R₁ R hR
  -- Constants and scaling of masses.
  have hC12 : (C₁ : ℝ≥0∞) * C₂ ≤ ((C₁ + C₁ * C₂ : ℝ≥0) : ℝ≥0∞) := by
    rw [ENNReal.coe_add, ENNReal.coe_mul]
    exact le_add_self
  have hC1 : (C₁ : ℝ≥0∞) ≤ ((C₁ + C₁ * C₂ : ℝ≥0) : ℝ≥0∞) := by
    rw [ENNReal.coe_add]
    exact le_self_add
  have hcancel : ∀ k : ℕ, ENNReal.ofReal (ρ ^ k) * ENNReal.ofReal (ρ⁻¹ ^ k) = 1 := by
    intro k
    rw [← ENNReal.ofReal_mul (by positivity), ← mul_pow, mul_inv_cancel₀ hρ0, one_pow,
      ENNReal.ofReal_one]
  have hpow1 : ENNReal.ofReal (ρ ^ (m + 1)) = ENNReal.ofReal ρ * ENNReal.ofReal (ρ ^ m) := by
    rw [← ENNReal.ofReal_mul hρ.le, pow_succ']
  have hpow2 : ENNReal.ofReal (ρ ^ (m + 2)) = ENNReal.ofReal ρ * ENNReal.ofReal (ρ ^ (m + 1)) := by
    rw [← ENNReal.ofReal_mul hρ.le]
    congr 1
    ring
  -- Supports: `cthickening (√n + √(n+ℓ))` around `ρ⁻¹ A`, pushed forward by `x ↦ ρx`, lies in
  -- `thickening (2√(n+ℓ) ρ) A`.
  have hscale : ∀ A B : Set (Eucl (m + 1 + ℓ)),
      B ⊆ cthickening (sn + sd) ((fun x => ρ⁻¹ • x) '' A) →
        (fun x => ρ • x) '' B ⊆ thickening (2 * sd * ρ) A := by
    intro A B hB
    rintro _ ⟨y, hy, rfl⟩
    have hy' : y ∈ thickening (2 * sd) ((fun x => ρ⁻¹ • x) '' A) :=
      cthickening_subset_thickening' (by linarith) (by linarith) _ (hB hy)
    obtain ⟨_, ⟨a, ha, rfl⟩, hya⟩ := mem_thickening_iff.mp hy'
    refine mem_thickening_iff.mpr ⟨a, ha, ?_⟩
    calc dist (ρ • y) a = dist (ρ • y) (ρ • ρ⁻¹ • a) := by
          rw [smul_smul, mul_inv_cancel₀ hρ0, one_smul]
      _ = ρ * dist y (ρ⁻¹ • a) := by rw [dist_smul₀, Real.norm_of_nonneg hρ.le]
      _ < ρ * (2 * sd) := mul_lt_mul_of_pos_left hya hρ
      _ = 2 * sd * ρ := by ring
  have hcc : ∀ A B : Set (Eucl (m + 1 + ℓ)), B ⊆ cthickening sd A →
      cthickening sn B ⊆ cthickening (sn + sd) A := fun A B h =>
    (cthickening_subset_of_subset sn h).trans (cthickening_cthickening_subset hsn0 hsd0 A)
  have hc1 : ∀ A : Set (Eucl (m + 1 + ℓ)), cthickening sd A ⊆ cthickening (sn + sd) A :=
    fun A => cthickening_mono (le_add_of_nonneg_left hsn0) A
  have hQs : Q.support ⊆ cthickening sd T'.support := subset_union_left.trans hQR₁s
  have hR₁s : R₁.support ⊆ cthickening sd T'.support := subset_union_right.trans hQR₁s
  have hQbs : Q.boundary.support ⊆ cthickening sd T'.boundary.support :=
    subset_union_left.trans hQbS₁s
  have hS₁s : S₁.support ⊆ cthickening sd T'.boundary.support := subset_union_right.trans hQbS₁s
  have hPbs : P.boundary.support ⊆ cthickening sn Q.boundary.support :=
    subset_union_left.trans hPbS's
  have hS's : S'.support ⊆ cthickening sn Q.boundary.support := subset_union_right.trans hPbS's
  refine ⟨Pc, β, R, S, hPcβ β hPβ, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- Display (38) rescaled: `T − Pc = ∂R + S`, tested on `η = η_ρ^# ω`.
    intro ω
    obtain ⟨η, hη⟩ := pull ω
    have hηω : ∀ x, (ω : DifferentialForm (Eucl (m + 1 + ℓ)) (m + 1)) x =
        ρ⁻¹ ^ (m + 1) • (η : DifferentialForm (Eucl (m + 1 + ℓ)) (m + 1)) (ρ⁻¹ • x) := by
      intro x
      rw [hη]
      simp only [smul_smul, ← mul_pow, inv_mul_cancel₀ hρ0, mul_inv_cancel₀ hρ0, one_pow,
        one_smul]
    rw [(hT' η ω hηω).symm, hPc ω η hη, hbR ω η hη, hS ω η hη, hS'']
    linarith [hTQ η, hQP η]
  · calc Pc.mass = ENNReal.ofReal (ρ ^ (m + 1)) * P.mass := hPcm
      _ ≤ ENNReal.ofReal (ρ ^ (m + 1)) * (C₂ * (C₁ * T'.mass)) := by
          gcongr
          exact hPm.trans (by gcongr)
      _ = (C₁ : ℝ≥0∞) * C₂ * (ENNReal.ofReal (ρ ^ (m + 1)) * ENNReal.ofReal (ρ⁻¹ ^ (m + 1))) *
          T.mass := by
          rw [hT'm]
          ring
      _ = (C₁ : ℝ≥0∞) * C₂ * T.mass := by rw [hcancel, mul_one]
      _ ≤ ((C₁ + C₁ * C₂ : ℝ≥0) : ℝ≥0∞) * T.mass := mul_le_mul_left hC12 _
  · calc Pc.boundary.mass = ENNReal.ofReal (ρ ^ m) * P.boundary.mass := hbPcm
      _ ≤ ENNReal.ofReal (ρ ^ m) * (C₂ * (C₁ * T'.boundary.mass)) := by
          gcongr
          exact hPbm.trans (by gcongr)
      _ = (C₁ : ℝ≥0∞) * C₂ * (ENNReal.ofReal (ρ ^ m) * ENNReal.ofReal (ρ⁻¹ ^ m)) *
          T.boundary.mass := by
          rw [hbT'm]
          ring
      _ = (C₁ : ℝ≥0∞) * C₂ * T.boundary.mass := by rw [hcancel, mul_one]
      _ ≤ ((C₁ + C₁ * C₂ : ℝ≥0) : ℝ≥0∞) * T.boundary.mass := mul_le_mul_left hC12 _
  · calc R.mass = ENNReal.ofReal (ρ ^ (m + 2)) * R₁.mass := hRm
      _ ≤ ENNReal.ofReal (ρ ^ (m + 2)) * (C₁ * T'.mass) := by gcongr
      _ = (C₁ : ℝ≥0∞) * ENNReal.ofReal ρ *
          (ENNReal.ofReal (ρ ^ (m + 1)) * ENNReal.ofReal (ρ⁻¹ ^ (m + 1))) * T.mass := by
          rw [hT'm, hpow2]
          ring
      _ = (C₁ : ℝ≥0∞) * ENNReal.ofReal ρ * T.mass := by rw [hcancel, mul_one]
      _ ≤ ((C₁ + C₁ * C₂ : ℝ≥0) : ℝ≥0∞) * ENNReal.ofReal ρ * T.mass :=
          mul_le_mul_left (mul_le_mul_left hC1 _) _
  · calc S.mass = ENNReal.ofReal (ρ ^ (m + 1)) * S''.mass := hSm
      _ ≤ ENNReal.ofReal (ρ ^ (m + 1)) *
          (C₁ * T'.boundary.mass + C₂ * (C₁ * T'.boundary.mass)) := by
          gcongr
          calc S''.mass ≤ S₁.mass + S'.mass := hS''m
            _ ≤ C₁ * T'.boundary.mass + C₂ * Q.boundary.mass := add_le_add hS₁m hS'm
            _ ≤ C₁ * T'.boundary.mass + C₂ * (C₁ * T'.boundary.mass) := by gcongr
      _ = ((C₁ : ℝ≥0∞) + C₁ * C₂) * ENNReal.ofReal ρ *
          (ENNReal.ofReal (ρ ^ m) * ENNReal.ofReal (ρ⁻¹ ^ m)) * T.boundary.mass := by
          rw [hbT'm, hpow1]
          ring
      _ = ((C₁ + C₁ * C₂ : ℝ≥0) : ℝ≥0∞) * ENNReal.ofReal ρ * T.boundary.mass := by
          rw [hcancel, mul_one, ENNReal.coe_add, ENNReal.coe_mul]
  · rw [hPcs, hRs]
    refine union_subset (hscale _ _ ?_) (hscale _ _ ?_)
    · rw [← hT's]
      exact hPs.trans (hcc _ _ hQs)
    · rw [← hT's]
      exact hR₁s.trans (hc1 _)
  · rw [hbPcs, hSs]
    refine union_subset (hscale _ _ ?_) (hscale _ _ ?_)
    · rw [← hbT's]
      exact hPbs.trans (hcc _ _ hQbs)
    · rw [← hbT's]
      exact hS''s.trans (union_subset (hS₁s.trans (hc1 _)) (hS's.trans (hcc _ _ hQbs)))
  · intro hTim
    obtain ⟨hQim, hR₁im⟩ := hIM₁ (hT'im hTim)
    obtain ⟨hβ, hPim⟩ := hIMP hQim
    exact ⟨hβ, hPcim hPim, hRim hR₁im⟩
  · intro hTim hTbim
    have hT'im' := hT'im hTim
    have hS₁im := hIM₂ hT'im' (hbT'im hTbim)
    have hQim := (hIM₁ hT'im').1
    have hPim := (hIMP hQim).2
    -- `S′ = 1·Q + (−1)·P` and `S″ = 1·S₁ + 1·S′` are integer multiplicity (Simon 3.2(1)).
    have hS'im : IsIntegerMultiplicity S' :=
      Submission.deformation_im_combination _ _ Q P S' 1 (-1) hQim hPim fun ω => by
        rw [← hQP ω]
        push_cast
        ring
    have hS''im : IsIntegerMultiplicity S'' :=
      Submission.deformation_im_combination _ _ S₁ S' S'' 1 1 hS₁im hS'im fun ω => by
        rw [hS'']
        push_cast
        ring
    exact hSim hS''im

/-- **Simon Ch. 6, 6.1 (Isoperimetric Theorem, pp. 168–169)**, by its printed proof (p. 169):
deform `T` by 5.3 in `ℝ^{(m+1)+(ℓ+1)} = ℝ^{m+2+ℓ}` at the scale `ρ` with
`ρ^{m+1} = 2(C+1)M(T)`.  Then `S = 0` as `∂T = 0`, and the lattice chain `P` vanishes because a
nonzero integer `β_F` would give `M(P) ≥ ρ^{m+1} > C M(T)`; so `T = ∂R`, and
`M(R) ≤ Cρ M(T) ≤ ρ^{m+2}` gives `M(R)^{(m+1)/(m+2)} ≤ ρ^{m+1} = 2(C+1)M(T)`. -/
theorem Submission.isoperimetric_theorem : IsoperimetricTheorem := by
  intro m ℓ hℓ
  -- 5.3 with `(m, ℓ + 1)`: its ambient space `ℝ^{(m+1)+(ℓ+1)}` is `ℝ^{m+2+ℓ}`.
  obtain ⟨C, hC⟩ := Submission.deformation_theorem m (ℓ + 1) (by omega)
  rw [show m + 1 + (ℓ + 1) = m + 2 + ℓ by omega] at hC
  refine ⟨2 * (C + 1), fun T hT hTc hTb => ?_⟩
  -- Step 1: `M(T) < ∞` and `M(∂T) = 0`.
  have hTM : T.mass < ∞ := Submission.isoperimetric_mass_lt_top _ _ T hT hTc
  have hTbM : T.boundary.mass = 0 := (Submission.isoperimetric_mass_eq_zero_iff _ _ _ _).2 hTb
  -- Steps 3–6 at any scale `ρ` with `C M(T) < ρ^{m+1}`: the deformation gives `T = ∂R`.
  have key : ∀ ρ : ℝ, 0 < ρ → (C : ℝ≥0∞) * T.mass < ENNReal.ofReal (ρ ^ (m + 1)) →
      ∃ R : GeometricCurrentOn (univ : Set (Eucl (m + 2 + ℓ))) (m + 2),
        IsIntegerMultiplicity R ∧ IsCompact R.support ∧ R.boundary = T ∧
        R.mass ≤ (C : ℝ≥0∞) * ENNReal.ofReal ρ * T.mass := by
    intro ρ hρ hρC
    obtain ⟨Pc, β, R, S, hPc, hTPc, hPcM, -, hRM, hSM, hspt, -, hIM, -⟩ :=
      hC T (by rw [hTbM, add_zero]; exact hTM) ρ hρ
    obtain ⟨hβ, -, hR⟩ := hIM hT
    -- Simon's (1): `|β_F| ρ^{m+1} ≤ M(P) ≤ C M(T) < ρ^{m+1}`, so the integer `β_F` is `0`.
    have hβ0 : ∀ F, β F = 0 := by
      intro F
      obtain ⟨k, hk⟩ := hβ F
      have hlt := ((Submission.isoperimetric_lattice_chain_mass_ge m _ ρ β Pc hρ hPc F).trans
        hPcM).trans_lt hρC
      rw [ENNReal.ofReal_lt_ofReal_iff (pow_pos hρ _)] at hlt
      have hk1 : |(k : ℝ)| < 1 := by
        rw [← hk]
        nlinarith [pow_pos hρ (m + 1), abs_nonneg (β F)]
      have hk0 : k = 0 := Int.abs_lt_one_iff.1 (by exact_mod_cast hk1)
      rw [hk, hk0, Int.cast_zero]
    -- `M(S) ≤ C ρ M(∂T) = 0`.
    have hS : S = 0 := (Submission.isoperimetric_mass_eq_zero_iff _ _ _ _).1 <| by
      simpa [hTbM] using hSM
    refine ⟨R, hR, ?_, ?_, hRM⟩
    -- `spt R` is closed and lies in the bounded `2√(m+2+ℓ) ρ`-neighbourhood of `spt T`.
    · exact Metric.isCompact_of_isClosed_isBounded (isClosed_univ.sdiff R.isOpen_zeroRegion)
        (hTc.isBounded.thickening.subset (subset_union_right.trans hspt))
    · ext ω
      have h := hTPc ω
      rw [hPc ω, hS] at h
      simpa [hβ0] using h.symm
  by_cases hT0 : T.mass = 0
  -- Step 2, `M(T) = 0`: deform at scale `1`; then `M(R) ≤ C M(T) = 0`.
  · obtain ⟨R, hR, hRc, hRT, hRM⟩ := key 1 one_pos (by simp [hT0])
    refine ⟨R, hR, hRc, hRT, ?_⟩
    rw [show R.mass = 0 by simpa [hT0] using hRM, hT0, mul_zero,
      ENNReal.zero_rpow_of_pos (by positivity)]
  -- `0 < M(T) < ∞`: deform at the scale `ρ` with `ρ^{m+1} = 2(C+1)M(T)`.
  · obtain ⟨t, ht0, hTt⟩ : ∃ t : ℝ, 0 < t ∧ T.mass = ENNReal.ofReal t :=
      ⟨T.mass.toReal, ENNReal.toReal_pos hT0 hTM.ne, (ENNReal.ofReal_toReal hTM.ne).symm⟩
    have hC1 : (0 : ℝ) < C + 1 := by positivity
    obtain ⟨ρ, hρ⟩ : ∃ ρ : ℝ, ρ = (2 * (C + 1) * t) ^ ((m + 1 : ℕ) : ℝ)⁻¹ := ⟨_, rfl⟩
    have hρ0 : 0 < ρ := by
      rw [hρ]
      exact Real.rpow_pos_of_pos (by positivity) _
    have hρk : ρ ^ (m + 1) = 2 * (C + 1) * t := by
      rw [hρ]
      exact Real.rpow_inv_natCast_pow (by positivity) (by omega)
    -- `C M(T) ≤ (C + 1) M(T) < ρ^{m+1}`.
    have hCT : (C : ℝ≥0∞) * T.mass ≤ ENNReal.ofReal ((C + 1) * t) := by
      rw [hTt, ← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_mul C.coe_nonneg]
      exact ENNReal.ofReal_le_ofReal (by nlinarith)
    obtain ⟨R, hR, hRc, hRT, hRM⟩ := key ρ hρ0 <| hCT.trans_lt <| by
      rw [ENNReal.ofReal_lt_ofReal_iff (pow_pos hρ0 _), hρk]
      nlinarith [mul_pos hC1 ht0]
    refine ⟨R, hR, hRc, hRT, ?_⟩
    -- `M(R) ≤ C ρ M(T) ≤ ρ (C + 1) M(T) ≤ ρ^{m+2}`.
    have hRρ : R.mass ≤ ENNReal.ofReal (ρ ^ (m + 2)) := by
      calc R.mass ≤ (C : ℝ≥0∞) * ENNReal.ofReal ρ * T.mass := hRM
        _ = ENNReal.ofReal ρ * ((C : ℝ≥0∞) * T.mass) := by ring
        _ ≤ ENNReal.ofReal ρ * ENNReal.ofReal ((C + 1) * t) := by gcongr
        _ = ENNReal.ofReal (ρ * ((C + 1) * t)) := (ENNReal.ofReal_mul hρ0.le).symm
        _ ≤ ENNReal.ofReal (ρ ^ (m + 2)) := by
          refine ENNReal.ofReal_le_ofReal ?_
          rw [show ρ ^ (m + 2) = ρ ^ (m + 1) * ρ from pow_succ ρ (m + 1), hρk]
          nlinarith [mul_pos (mul_pos hρ0 hC1) ht0]
    calc R.mass ^ (((m + 1 : ℕ) : ℝ) / ((m + 2 : ℕ) : ℝ))
        ≤ ENNReal.ofReal (ρ ^ (m + 2)) ^ (((m + 1 : ℕ) : ℝ) / ((m + 2 : ℕ) : ℝ)) :=
          ENNReal.rpow_le_rpow hRρ (by positivity)
      _ = ENNReal.ofReal (ρ ^ (m + 1)) := by
          rw [ENNReal.ofReal_rpow_of_nonneg (pow_pos hρ0 _).le (by positivity),
            ← Real.rpow_natCast ρ (m + 2), ← Real.rpow_mul hρ0.le, ← Real.rpow_natCast ρ (m + 1),
            ← mul_div_assoc, mul_div_cancel_left₀ _ (by positivity)]
      _ = ((2 * (C + 1) : ℝ≥0) : ℝ≥0∞) * T.mass := by
          rw [hρk, hTt, ← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_mul (by positivity)]
          push_cast
          ring_nf
/-- **Simon Ch. 6, 6.3 (Boundary Rectifiability Theorem, p. 170).**  If `T ∈ 𝒟ₙ(U)` is integer
multiplicity and `M_W(∂T) < ∞` for all `W ⊂⊂ U`, then `∂T` is integer multiplicity
(`n = m + 1`).  Integer multiplicity is local, so fix `x₀ ∈ U`.  By slicing there are `r > 0` and an
integer multiplicity `X ∈ 𝒟ₙ(ℝ^P)` with `M(X) + M(∂X) < ∞` that agrees with `T` on forms supported
in `B_r(x₀)`.  Polyhedral approximation (deformation theorem) and compactness for cycles (8.2) make
`∂X` integer multiplicity, hence also its restriction to `U`.  For `ω` supported in `B_r(x₀)`,
`spt dω ⊆ spt ω`, so `∂T(ω) = T(dω) = X(dω) = ∂X(ω)`. -/
theorem Submission.boundary_rectifiability : BoundaryRectifiability := by
  intro P m U hU T hT hbd
  -- Integer multiplicity is local: it suffices to match `∂T` near every `x₀ ∈ U`.
  refine Submission.br_isIntegerMultiplicity_of_local P m U hU T.boundary fun x₀ hx₀ => ?_
  -- Localization by slicing: `X = T` on forms supported in `B_r(x₀)`, `M(X) + M(∂X) < ∞`.
  obtain ⟨r, hr, hrU, X, hXIM, hXmass, hXbd, hXT⟩ :=
    Submission.br_local_finite_mass_extension Submission.slicing_theorem P m U hU T hT hbd x₀ hx₀
  -- The finite mass case in `ℝ^P`: `∂X` is integer multiplicity.
  have hXb : IsIntegerMultiplicity X.boundary :=
    Submission.br_boundary_isIntegerMultiplicity_of_finite_mass Submission.deformation_theorem
      Submission.integrality_of_weak_limits P m X hXIM hXmass hXbd
  -- `∂T` agrees on `B_r(x₀)` with the integer multiplicity current `(∂X)|_U`.
  refine ⟨ball x₀ r, isOpen_ball, mem_ball_self hr, hrU,
    X.boundary.restrictDomain (subset_univ U),
    Submission.br_restrictDomain_isIntegerMultiplicity P m univ U (subset_univ U) hU X.boundary hXb,
    fun ω hω => ?_⟩
  have hdω : tsupport (exteriorDerivative (ω : DifferentialForm (Eucl P) m)) ⊆ ball x₀ r :=
    (tsupport_exteriorDerivative_subset _).trans hω
  calc T.boundary ω = T (exteriorDerivativeTestOn U m ω) := GeometricCurrentOn.boundary_apply T ω
    _ = X (testFormOnInclusion (subset_univ U) (m + 1) (exteriorDerivativeTestOn U m ω)) :=
        (hXT (exteriorDerivativeTestOn U m ω) hdω).symm
    _ = X.boundary.restrictDomain (subset_univ U) ω := rfl

theorem main_theorem : CompactnessUnderMassBounds ∧ ConstancyTheorem ∧ LipschitzPushforwardIntegerMultiplicity ∧ FedererFlemingCompactness ∧ SlicingTheorem ∧ DeformationTheorem ∧ IsoperimetricTheorem ∧ PolyhedralApproximation ∧ BoundaryRectifiability ∧ FlatConvergenceIffWeakConvergence ∧ RectifiabilityTheorem ∧ IntegralityOfWeakLimits := by sorry

theorem Submission.iwl_top_dim_integrality : ∀ (m : ℕ) (U : Set (Eucl (m + 1))), IsOpen U → ∀ (Tj : ℕ → GeometricCurrentOn U (m + 1)) (T : GeometricCurrentOn U (m + 1)), (∀ j, IsIntegerMultiplicity (Tj j)) → (∀ W, CompactlyContainedOpen W U → (⨆ j, ((Tj j).massOn W + (Tj j).boundary.massOn W)) < ∞) → WeaklyConvergesOn Tj T → IsIntegerMultiplicity T := by
  intro m
  classical
  /- Notation: n = m + 1, E = Eucl n, e the standard frame, dx = e₁* ∧ ⋯ ∧ eₙ*. -/
  obtain ⟨e, he⟩ : ∃ e : Fin (m+1) → Eucl (m+1), e = fun i => EuclideanSpace.single i (1:ℝ) :=
    ⟨_, rfl⟩
  obtain ⟨dx, hdx⟩ : ∃ dx : Covector (Eucl (m+1)) (m+1),
      dx = wedgeCovectors (m+1) (fun i => (EuclideanSpace.proj i : Eucl (m+1) →L[ℝ] ℝ)) :=
    ⟨_, rfl⟩
  have hvol : (μHE[m+1] : Measure (Eucl (m+1))) = volume :=
    EuclideanSpace.euclideanHausdorffMeasure_eq_volume (m+1)
  have hT0 : ((⊤ : ℕ∞) : WithTop ℕ∞) ≠ 0 := by
    simp only [ne_eq, WithTop.coe_eq_zero, ENat.top_ne_zero, not_false_eq_true]
  have hbe : (⇑(EuclideanSpace.basisFun (Fin (m+1)) ℝ) : Fin (m+1) → Eucl (m+1)) = e := by
    rw [he]; funext i; simp only [EuclideanSpace.basisFun_apply]
  /- Step 1: top-degree covectors. -/
  have hdxe : dx e = 1 := by
    rw [hdx, he, wedgeCovectors_apply_det]
    have : (Matrix.of fun i j => (EuclideanSpace.proj i : Eucl (m+1) →L[ℝ] ℝ)
        (EuclideanSpace.single j (1:ℝ))) = 1 := by
      ext i j
      simp only [PiLp.proj_apply, PiLp.single_apply, Matrix.of_apply, Matrix.one_apply]
    rw [this, Matrix.det_one]
  have hP1 : ∀ (α : Covector (Eucl (m+1)) (m+1)) (v : Fin (m+1) → Eucl (m+1)),
      α v = α e * dx v := by
    intro α v
    classical
    let b := (EuclideanSpace.basisFun (Fin (m+1)) ℝ).toBasis
    have hbe' : (⇑b : Fin (m+1) → Eucl (m+1)) = e := by
      rw [← hbe]; exact OrthonormalBasis.coe_toBasis _
    have h1 := AlternatingMap.eq_smul_basis_det b α.toAlternatingMap
    have h2 : α v = α ⇑b * b.det v := by
      have := congrArg (fun f => f v) h1
