    filter_upwards [eventually_ge_atTop l] with k hk
    exact (lintegral_mono_set hl).trans (hfatou l k hk)
  /- Step 5: `T = [[U]] ⌞ βh`. -/
  have hTβ : ∀ ω : TestFormOn U (m+1),
      T ω = ∫ x, βh x * (ω : DifferentialForm (Eucl (m+1)) (m+1)) x e := by
    intro ω
    let a : Eucl (m+1) → ℝ := fun x => (ω : DifferentialForm (Eucl (m+1)) (m+1)) x e
    have ha : a = fun x => (ω : DifferentialForm (Eucl (m+1)) (m+1)) x e := rfl
    have hωc : Continuous (ω : DifferentialForm (Eucl (m+1)) (m+1)) := ω.property.1.1.continuous
    have hac : Continuous a := (continuous_eval_const e).comp hωc
    let KΩ := tsupport (ω : DifferentialForm (Eucl (m+1)) (m+1))
    have hKΩ : KΩ = tsupport (ω : DifferentialForm (Eucl (m+1)) (m+1)) := rfl
    have hKΩc : IsCompact KΩ := ω.property.1.2
    have hKΩU : KΩ ⊆ U := ω.property.2
    have ha0 : ∀ x, x ∉ KΩ → a x = 0 := by
      intro x hx
      simp only [a, image_eq_zero_of_notMem_tsupport hx]
      rfl
    obtain ⟨Ca, hCa⟩ : ∃ Ca : ℝ, ∀ x, |a x| ≤ Ca := by
      obtain ⟨Ca, hCa⟩ := hKΩc.exists_bound_of_continuousOn hac.continuousOn
      refine ⟨max Ca 0, fun x => ?_⟩
      by_cases hx : x ∈ KΩ
      · exact ((Real.norm_eq_abs (a x)).symm.le.trans (hCa x hx)).trans (le_max_left _ _)
      · rw [ha0 x hx, abs_zero]
        exact le_max_right _ _
    have hsupp : ∀ g : Eucl (m+1) → ℝ, Function.support (fun x => g x * a x) ⊆ KΩ := by
      intro g x hx
      by_contra h
      exact hx (show g x * a x = 0 by rw [ha0 x h, mul_zero])
    have hint : ∀ g : Eucl (m+1) → ℝ, IntegrableOn g KΩ → Integrable (fun x => g x * a x) := by
      intro g hg
      rw [← integrableOn_iff_integrable_of_support_subset (hsupp g)]
      exact hg.mul_continuousOn hac.continuousOn hKΩc
    have h1 : Tendsto (fun k => Tj (φ k) ω) atTop (𝓝 (T ω)) :=
      (hconv ω).comp hφmono.tendsto_atTop
    have h2 : Tendsto (fun k => ∫ x, β (φ k) x * a x) atTop (𝓝 (∫ x, βh x * a x)) := by
      have hbound : ∀ k, ‖(∫ x, β (φ k) x * a x) - ∫ x, βh x * a x‖ₑ ≤
          ENNReal.ofReal Ca * ∫⁻ x in KΩ, ‖β (φ k) x - βh x‖ₑ := by
        intro k
        rw [← integral_sub (hint _ (hβi (φ k) KΩ hKΩc hKΩU)) (hint _ (hβhi KΩ hKΩc hKΩU))]
        refine (enorm_integral_le_lintegral_enorm _).trans ?_
        rw [← lintegral_indicator hKΩc.measurableSet, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
        refine lintegral_mono (fun x => ?_)
        by_cases hx : x ∈ KΩ
        · rw [indicator_of_mem hx, ← sub_mul, enorm_mul, mul_comm (ENNReal.ofReal Ca)]
          gcongr
          rw [Real.enorm_eq_ofReal_abs]
          exact ENNReal.ofReal_le_ofReal (hCa x)
        · rw [indicator_of_notMem hx, ha0 x hx]
          simp
      have h3 : Tendsto (fun k => ENNReal.ofReal Ca * ∫⁻ x in KΩ, ‖β (φ k) x - βh x‖ₑ) atTop (𝓝 0) := by
        have := ENNReal.Tendsto.const_mul (a := ENNReal.ofReal Ca) (hL1 KΩ hKΩc hKΩU)
          (Or.inr ENNReal.ofReal_ne_top)
        rwa [mul_zero] at this
      have h4 : Tendsto (fun k => ‖(∫ x, β (φ k) x * a x) - ∫ x, βh x * a x‖ₑ) atTop (𝓝 0) :=
        tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds h3 (fun k => zero_le) hbound
      rw [tendsto_iff_norm_sub_tendsto_zero]
      have h5 := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp h4
      simpa [Function.comp_def, toReal_enorm] using h5
    have h1' : Tendsto (fun k => ∫ x, β (φ k) x * a x) atTop (𝓝 (T ω)) :=
      h1.congr (fun k => hβT (φ k) ω)
    exact tendsto_nhds_unique h1' h2
  /- Step 6: the tangent spaces of `({βh ≠ 0}, |βh|)`. -/
  let Mh : Set (Eucl (m+1)) := {x | x ∈ U ∧ βh x ≠ 0}
  have hMh : Mh = {x | x ∈ U ∧ βh x ≠ 0} := rfl
  have hMhm : MeasurableSet Mh := hU.measurableSet.inter (hβhm (measurableSet_singleton 0).compl)
  have htan : ∀ᵐ x ∂(volume : Measure (Eucl (m+1))), x ∈ U → βh x ≠ 0 →
      HasWeightedApproximateTangentSpaceAt (m+1) Mh (fun x => |βh x|) x ⊤ := by
    have hall := ae_all_iff.2 (fun l => hLeb βh (K l) (hKc l) (hβhi _ (hKc l) (hKU l)))
    filter_upwards [hall] with x hx hxU hx0
    obtain ⟨ρ, hρ0, hρU⟩ := Metric.nhds_basis_closedBall.mem_iff.1 (hU.mem_nhds hxU)
    obtain ⟨l, hl⟩ := hKcov _ (isCompact_closedBall x ρ) hρU
    refine (Submission.iwl_weighted_tangent_locality (m+1) (m+1) Mh univ (fun y => |βh y|)
      (fun _ => |βh x|) x ?_ ?_ rfl ?_ ?_ ⊤).2 (hconstTan _ x)
    · rw [hvol]
      exact hMhm.nullMeasurableSet
    · rw [hvol]
      exact MeasurableSet.univ.nullMeasurableSet
    · refine ⟨ρ, hρ0, ?_, ?_⟩
      · rw [hvol]
        exact IntegrableOn.mono_set (Integrable.abs (hβhi _ (isCompact_closedBall x ρ) hρU))
          inter_subset_right
      · rw [hvol]
        exact (integrableOn_const (measure_closedBall_lt_top.ne)).mono_set inter_subset_right
    · intro R hR
      rw [hvol]
      refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds (hx l ρ hρ0 hl R hR)
        (Eventually.of_forall fun r => zero_le) ?_
      filter_upwards [self_mem_nhdsWithin, eventually_nhdsWithin_of_eventually_nhds
        (eventually_le_nhds (div_pos hρ0 hR))] with r hr hrρ
      have hRrρ : R * r ≤ ρ := (le_div_iff₀' hR).1 hrρ
      refine mul_le_mul_right (setLIntegral_mono ((hβhm.sub measurable_const).enorm)
        (fun z hz => ?_)) _
      have hzU : z ∈ U := hρU (closedBall_subset_closedBall hRrρ hz)
      have hind : Mh.indicator (fun x => |βh x|) z = |βh z| := by
        by_cases h0 : βh z = 0
        · rw [indicator_of_notMem (fun h => h.2 h0), h0, abs_zero]
        · rw [indicator_of_mem (show z ∈ Mh from ⟨hzU, h0⟩)]
      rw [hind, indicator_of_mem (mem_univ z)]
      rw [Real.enorm_eq_ofReal_abs, Real.enorm_eq_ofReal_abs]
      exact ENNReal.ofReal_le_ofReal (abs_abs_sub_abs_le_abs_sub _ _)
  /- Step 6: `T = τ(Mh, |βh|, sign(βh) e₁ ∧ ⋯ ∧ eₙ)` is integer multiplicity. -/
  let ξ : Eucl (m+1) → NVector (Eucl (m+1)) (m+1) :=
    fun x => if 0 ≤ βh x then simpleNVector e else -simpleNVector e
  have hξ : ξ = fun x => if 0 ≤ βh x then simpleNVector e else -simpleNVector e := rfl
  have hval : ∀ (ω : TestFormOn U (m+1)) x,
      |βh x| * ξ x ((ω : DifferentialForm (Eucl (m+1)) (m+1)) x) =
        βh x * (ω : DifferentialForm (Eucl (m+1)) (m+1)) x e := by
    intro ω x
    by_cases h : 0 ≤ βh x
    · simp only [ξ, ite_eq_left h, simpleNVector_apply, abs_of_nonneg h]
    · simp only [ξ, ite_eq_right h, neg_apply, simpleNVector_apply,
        abs_of_neg (lt_of_not_ge h)]
      ring
  refine ⟨Mh, fun x => |βh x|, ξ, ⟨fun x hx => hx.1, (by rw [hvol]; exact hMhm.nullMeasurableSet), ?_,
    fun x hx => abs_pos.2 hx.2, fun C hC hCU => ?_, ?_, ?_⟩, fun x hx => ?_,
    fun ω => ?_⟩
  · refine ⟨∅, measure_empty, fun _ => id, fun _ => ⟨1, LipschitzWith.id⟩, fun x _ => Or.inr ?_⟩
    exact mem_iUnion.2 ⟨0, mem_range_self x⟩
  · rw [hvol]
    exact IntegrableOn.mono_set (Integrable.abs (hβhi C hC hCU)) inter_subset_right
  · exact (stronglyMeasurable_const.piecewise (measurableSet_le measurable_const hβhm)
      stronglyMeasurable_const).aestronglyMeasurable
  · rw [hvol]
    filter_upwards [ae_restrict_of_ae htan, ae_restrict_mem hMhm] with x hx hxM
    refine ⟨e, hbe ▸ (EuclideanSpace.basisFun (Fin (m+1)) ℝ).orthonormal, ?_, ?_⟩
    · have hspan : Submodule.span ℝ (range e) = ⊤ := by
        rw [← hbe, ← OrthonormalBasis.coe_toBasis]
        exact (EuclideanSpace.basisFun (Fin (m+1)) ℝ).toBasis.span_eq
      rw [hspan]
      exact hx hxM.1 hxM.2
    · by_cases h : 0 ≤ βh x
      · exact Or.inl (ite_eq_left h)
      · exact Or.inr (ite_eq_right h)
  · obtain ⟨k, hk⟩ := hβhz x
    exact ⟨k.natAbs, by simp only [hk, Nat.cast_natAbs, Int.cast_abs]⟩
  · rw [hTβ ω, tauAction, hvol]
    rw [← setIntegral_eq_integral_of_forall_compl_eq_zero (s := Mh) (fun x hx => ?_)]
    · exact setIntegral_congr_fun hMhm (fun x _ => (hval ω x).symm)
    · by_cases hxU : x ∈ U
      · have h0 : βh x = 0 := by
          by_contra h
          exact hx ⟨hxU, h⟩
        simp [h0]
      · have h0 : (ω : DifferentialForm (Eucl (m+1)) (m+1)) x = 0 :=
          image_eq_zero_of_notMem_tsupport (fun h => hxU (ω.property.2 h))
        simp [h0]

/-- **Rectifiable weak limits of integer multiplicity cycles are integer multiplicity** (Simon
Ch. 6, proof of Theorem 8.2, printed (7)–(10), pp. 178–179, with the documented corrections).
Write `T = τ(M, θ, ξ)`; it suffices that `θ(x) ∈ ℕ` for `Hⁿ`-a.e. `x ∈ M`.  After passing to a
subsequence, at a.e. `x` we have `M_{B_r(x)}(T_j) ≤ C rⁿ` for small `r` and large `j`, the
blow-ups `(η_{x,λ})_# T` converge to `θ(x) ∫_{TₓM} ⟨·, ξ(x)⟩ dHⁿ` as `λ ↓ 0`, and
`ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ` with `TₓM = span τ`.  For `λ_k ↓ 0` the rescalings
`Y_{k,j} = (η_{x,λ_k})_# T_j` are integer multiplicity cycles with
`M_{B_2(0)}(Y_{k,j}) ≤ λ_k⁻ⁿ M_{B_{2λ_k}(x)}(T_j) ≤ 2ⁿ C` for large `j`, and
`Y_{k,j} → (η_{x,λ_k})_# T` as `j → ∞`.  A diagonal sequence `Y_{k,φ'(k)}` converges in `B_2(0)`
to `c [[span τ]]` with `c = ±θ(x)`, so the planar integrality theorem gives `c ∈ ℤ`, hence
`θ(x) = |c| ∈ ℕ` as `θ(x) > 0`.  The hypothesis `m + 2 ≤ P` is not needed. -/
theorem Submission.iwl_integer_density : ∀ (P m : ℕ), m + 2 ≤ P → SlicingTheorem → LipschitzPushforwardIntegerMultiplicity → ∀ (Tj : ℕ → GeometricCurrentOn (univ : Set (Eucl P)) (m + 1)) (T : GeometricCurrentOn (univ : Set (Eucl P)) (m + 1)), (∀ j, IsIntegerMultiplicity (Tj j)) → (∀ j, (Tj j).boundary = 0) → (⨆ j, (Tj j).mass) < ∞ → WeaklyConvergesOn Tj T → IsRectifiableCurrent T → IsIntegerMultiplicity T := by
  intro P m _hP hSlice hLip Tj T hTj hbdy hmass hconv hrect
  obtain ⟨M, θ, ξ, hMθξ, hT⟩ := hrect
  -- Step 1: a subsequence `T_{φ(j)}` with `M_{B_r(x)}(T_{φ(j)}) ≤ C rⁿ` for small `r`, large `j`,
  -- at `Hⁿ`-a.e. `x`.
  obtain ⟨φ, hφ, hdens⟩ := Submission.ind_mass_density_bound P (m + 1) Tj hmass
  -- It suffices to show `θ(x) ∈ ℕ` for `Hⁿ`-a.e. `x ∈ M`.
  refine Submission.ind_ae_integer_multiplicity P (m + 1) univ T M θ ξ hMθξ hT ?_
  filter_upwards [ae_restrict_of_ae hdens, Submission.ind_ae_blowup_limit P (m + 1) M θ ξ hMθξ,
    hMθξ.orients, ae_restrict_mem₀ hMθξ.nullMeasurableSet] with x hxdens hxblow hxor hxM
  obtain ⟨C, r₀, hr₀, hC⟩ := hxdens
  obtain ⟨τ, hτ, hQ, hξx⟩ := hxor
  -- Radii `λ_k = r₀/(4(k+1)) ↓ 0`, with `2λ_k < r₀`.
  obtain ⟨lam, hlam_pos, hlam_lt, hlam_tendsto⟩ : ∃ lam : ℕ → ℝ, (∀ k, 0 < lam k) ∧
      (∀ k, 2 * lam k < r₀) ∧ Tendsto lam atTop (𝓝[>] 0) := by
    refine ⟨fun k => r₀ / 4 * (1 / ((k : ℝ) + 1)), fun k => by positivity, fun k => ?_, ?_⟩
    · have h1 : 1 / ((k : ℝ) + 1) ≤ 1 := by
        rw [div_le_one (by positivity)]
        linarith [(Nat.cast_nonneg k : (0 : ℝ) ≤ k)]
      have h2 : 0 < 1 / ((k : ℝ) + 1) := by positivity
      nlinarith
    · refine tendsto_nhdsWithin_iff.2 ⟨?_, Eventually.of_forall fun k =>
        mem_Ioi.2 (by positivity : (0 : ℝ) < r₀ / 4 * (1 / ((k : ℝ) + 1)))⟩
      simpa only [mul_zero] using
        (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)).const_mul (r₀ / 4)
  -- Step 2: the rescalings `Y_{k,j} = (η_{x,λ_k})_# T_{φ(j)}`.
  choose Y hYη hYeq hYim hYbdy hYmass using fun k j =>
    Submission.ind_rescaled_current P m (Tj (φ j)) x (lam k) (hlam_pos k)
  -- `Z_k = (η_{x,λ_k})_# T` and the blow-up limit `L = θ(x) ∫_{TₓM} ⟨·, ξ(x)⟩ dHⁿ`.
  set Z : ℕ → TestFormOn (univ : Set (Eucl P)) (m + 1) → ℝ := fun k ω =>
    tauAction (m + 1) M θ ξ (fun y => (lam k ^ (m + 1))⁻¹ •
      (ω : DifferentialForm (Eucl P) (m + 1)) ((lam k)⁻¹ • (y - x)))
  set L : TestFormOn (univ : Set (Eucl P)) (m + 1) → ℝ := fun ω =>
    θ x * ∫ z in (Submodule.span ℝ (range τ) : Set (Eucl P)),
      ξ x ((ω : DifferentialForm (Eucl P) (m + 1)) z) ∂(μHE[m + 1] : Measure (Eucl P))
    with hL_def
  -- `Y_{k,j}(ω) = T_{φ(j)}(η) → T(η) = Z_k(ω)` as `j → ∞`.
  have hYZ : ∀ (k : ℕ) (ω : TestFormOn (univ : Set (Eucl P)) (m + 1)),
      tsupport (ω : DifferentialForm (Eucl P) (m + 1)) ⊆ ball (0 : Eucl P) 2 →
      Tendsto (fun j => Y k j ω) atTop (𝓝 (Z k ω)) := by
    intro k ω _
    obtain ⟨η, hη⟩ := hYη k 0 ω
    have hTη : T η = Z k ω := by
      rw [hT η]
      exact congrArg (tauAction (m + 1) M θ ξ) (funext hη)
    rw [← hTη]
    exact ((hconv η).comp hφ.tendsto_atTop).congr fun j => (hYeq k j ω η hη).symm
  -- `Z_k(ω) → L(ω)` as `k → ∞` (blow-up of `T` at `x`).
  have hZL : ∀ ω : TestFormOn (univ : Set (Eucl P)) (m + 1),
      tsupport (ω : DifferentialForm (Eucl P) (m + 1)) ⊆ ball (0 : Eucl P) 2 →
      Tendsto (fun k => Z k ω) atTop (𝓝 (L ω)) := by
    intro ω _
    exact (hxblow _ hQ ω ω.property.1.1.continuous ω.property.1.2).comp hlam_tendsto
  -- `M_{B_2(0)}(Y_{k,j}) ≤ λ_k⁻ⁿ M_{B_{2λ_k}(x)}(T_{φ(j)}) ≤ 2ⁿ C` for large `j`.
  have hmassY : ∀ k, ∀ᶠ j in atTop,
      (Y k j).massOn (ball (0 : Eucl P) 2) ≤ ENNReal.ofReal (C * 2 ^ (m + 1)) := by
    intro k
    filter_upwards [hC (2 * lam k) ⟨by linarith [hlam_pos k], hlam_lt k⟩] with j hj
    have hsub : {y : Eucl P | (lam k)⁻¹ • (y - x) ∈ ball (0 : Eucl P) 2} ⊆
        ball x (2 * lam k) := by
      intro y hy
      have hy' : (lam k)⁻¹ • (y - x) ∈ ball (0 : Eucl P) 2 := hy
      rw [mem_ball, dist_zero_right, norm_smul, Real.norm_eq_abs,
        abs_of_pos (inv_pos.2 (hlam_pos k)), inv_mul_lt_iff₀ (hlam_pos k)] at hy'
      rw [mem_ball, dist_eq_norm]
      linarith
    calc (Y k j).massOn (ball (0 : Eucl P) 2)
        ≤ ENNReal.ofReal ((lam k ^ (m + 1))⁻¹) *
            (Tj (φ j)).massOn {y | (lam k)⁻¹ • (y - x) ∈ ball (0 : Eucl P) 2} :=
          hYmass k j _
      _ ≤ ENNReal.ofReal ((lam k ^ (m + 1))⁻¹) *
            ENNReal.ofReal (C * (2 * lam k) ^ (m + 1)) := by
          gcongr
          exact ((Tj (φ j)).massOn_mono hsub).trans hj
      _ = ENNReal.ofReal (C * 2 ^ (m + 1)) := by
          rw [← ENNReal.ofReal_mul (inv_pos.2 (pow_pos (hlam_pos k) (m + 1))).le]
          congr 1
          have hne := (pow_pos (hlam_pos k) (m + 1)).ne'
          rw [mul_pow]
          field_simp
  -- Step 3: diagonal selection `Y_k := Y_{k,φ'(k)}`, still converging to `L` in `B_2(0)`.
  obtain ⟨φ', -, hbdφ', hlimφ'⟩ := Submission.ind_diagonal_weak_limit P (m + 1) univ
    (ball (0 : Eucl P) 2) Y Z L (C * 2 ^ (m + 1)) isBounded_ball.isCompact_closure hYZ hZL
    hmassY
  -- Step 4: a planar weak limit `c [[span τ]]` of integer multiplicity cycles has `c ∈ ℤ`.
  have hplane : ∀ c : ℝ, (∀ ω : TestFormOn (univ : Set (Eucl P)) (m + 1), L ω = c *
      ∫ z in (Submodule.span ℝ (Set.range τ) : Set (Eucl P)),
        (ω : DifferentialForm (Eucl P) (m + 1)) z τ ∂(μHE[m + 1] : Measure (Eucl P))) →
      ∃ k : ℤ, c = k := by
    intro c hc
    refine Submission.ind_plane_multiplicity_integer hSlice hLip
      Submission.iwl_restriction_weak_limit Submission.iwl_smooth_pushforward
      Submission.iwl_top_dim_integrality P m τ c (fun k => Y k (φ' k)) hτ
      (fun k => hYim k (φ' k) (hTj (φ (φ' k)))) (fun k => hYbdy k (φ' k) (hbdy (φ (φ' k))))
      (lt_of_le_of_lt (iSup_le hbdφ') ENNReal.ofReal_lt_top) fun ω hω => ?_
    rw [← hc ω]
    exact hlimφ' ω hω
  -- Step 5: `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ`, so `c = ±θ(x) ∈ ℤ` and `θ(x) > 0` gives `θ(x) ∈ ℕ`.
  have hθx : 0 < θ x := hMθξ.pos x hxM
  have hnat : ∀ k : ℤ, θ x = k → ∃ n : ℕ, θ x = n := by
    intro k hk
    have hk0 : 0 ≤ k := by
      have : (0 : ℝ) ≤ k := hk ▸ hθx.le
      exact_mod_cast this
    exact ⟨k.toNat, by rw [hk]; exact_mod_cast (Int.toNat_of_nonneg hk0).symm⟩
  rcases hξx with hξx | hξx
  · obtain ⟨k, hk⟩ := hplane (θ x) fun ω => by
      simp only [hL_def, hξx, simpleNVector_apply]
    exact hnat k hk
  · obtain ⟨k, hk⟩ := hplane (-θ x) fun ω => by
      simp only [hL_def, hξx, neg_apply, simpleNVector_apply, integral_neg]
      ring
    exact hnat (-k) (by push_cast; linarith)

/-- **Simon Ch. 6, Theorem 8.2 (pp. 176–179)**, by induction on `n = m + 1` (all `U` at once).
In degree `n` the boundary-limit hypothesis (BLI) — weak limits in `ℝ^P` of integer multiplicity
boundaries `∂Y_j` with `sup_j M(∂Y_j) < ∞` are integer multiplicity — is the case `n − 1 = 0`
(`iwl_zero_dim_integrality`) for `n = 1` and the inductive hypothesis (with `∂∂ = 0`) for
`n ≥ 2`.  Given BLI:
* `P < n`: every `n`-covector on `ℝ^P` vanishes, so `T = 0 = τ(∅, 1, 0)`;
* `P = n`: Remark 3.12 (`iwl_top_dim_integrality`);
* `P ≥ n + 1`: localize to compactly supported currents in `ℝ^P` (Remark 8.3(1),
  `iwl_localization`) and reduce to cycles by cones (`iwl_cycle_reduction`).  For cycles,
  `Θ*ⁿ(μ_T, ·) > 0` `μ_T`-a.e. (printed (1)–(6), `iwl_positive_density`), so `T` is rectifiable
  by 8.1, and its multiplicity is integer valued (printed (7)–(10), `iwl_integer_density`). -/
theorem Submission.integrality_of_weak_limits : IntegralityOfWeakLimits := by
  -- A current killing every test form is `τ(∅, 1, 0)`.
  have hIM_of_eq_zero : ∀ {P k : ℕ} {U : Set (Eucl P)} (X : GeometricCurrentOn U k),
      (∀ ω, X ω = 0) → IsIntegerMultiplicity X := by
    intro P k U X hX
    refine ⟨∅, fun _ => 1, fun _ => 0,
      { subset := empty_subset U
        nullMeasurableSet := nullMeasurableSet_empty
        countablyRectifiable :=
          Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty
        pos := fun x hx => absurd hx (notMem_empty x)
        integrableOn := fun K _ _ => by simp
        aestronglyMeasurable := aestronglyMeasurable_const
        orients := by simp }, fun x hx => absurd hx (notMem_empty x), fun ω => ?_⟩
    simp [tauAction, hX ω]
  -- The zero current has zero mass.
  have hmassOn_zero : ∀ {P k : ℕ} {U : Set (Eucl P)} (W : Set (Eucl P)),
      (0 : GeometricCurrentOn U k).massOn W = 0 := by
    intro P k U W
    refine le_antisymm (sSup_le ?_) bot_le
    rintro r ⟨ω, -, rfl⟩
    simp
  intro P
  -- Degree `m + 1`, assuming (BLI) in that degree.
  have step : ∀ m : ℕ,
      (∀ (Yj : ℕ → GeometricCurrentOn (univ : Set (Eucl P)) (m + 1))
        (Y : GeometricCurrentOn (univ : Set (Eucl P)) (m + 1)),
        (∀ j, IsIntegerMultiplicity (Yj j).boundary) → (⨆ j, (Yj j).boundary.mass) < ∞ →
        WeaklyConvergesOn (fun j => (Yj j).boundary) Y.boundary →
        IsIntegerMultiplicity Y.boundary) →
      ∀ (U : Set (Eucl P)), IsOpen U →
        ∀ (Tj : ℕ → GeometricCurrentOn U (m + 1)) (T : GeometricCurrentOn U (m + 1)),
          (∀ j, IsIntegralCurrent (Tj j)) →
          (∀ W, CompactlyContainedOpen W U →
            (⨆ j, ((Tj j).massOn W + (Tj j).boundary.massOn W)) < ∞) →
          WeaklyConvergesOn Tj T → IsIntegerMultiplicity T := by
    intro m hBLI U hU Tj T hTj hmass hconv
    rcases lt_trichotomy P (m + 1) with hP | rfl | hP
    · -- Step 1, `P < m + 1`: any `m + 1` vectors in `ℝ^P` are linearly dependent, so every
      -- `(m + 1)`-covector and every test form vanishes, and `T = 0`.
      have hcov : ∀ c : Covector (Eucl P) (m + 1), c = 0 := by
        intro c
        ext v
        refine c.toAlternatingMap.map_linearDependent v fun hv => ?_
        have h := hv.fintype_card_le_finrank
        rw [Fintype.card_fin, finrank_euclideanSpace_fin] at h
        omega
      refine hIM_of_eq_zero T fun ω => ?_
      rw [show ω = 0 from Subtype.ext (funext fun x => hcov _)]
      exact T.toCurrent.map_zero
    · -- Step 2, `P = m + 1`: Remark 3.12.
      exact Submission.iwl_top_dim_integrality m U hU Tj T (fun j => (hTj j).1) hmass hconv
    · -- Steps 4–11, `P ≥ m + 2`.
      have hP2 : m + 2 ≤ P := by omega
      refine Submission.iwl_localization P m Submission.slicing_theorem ?_ U hU Tj T hTj hmass
        hconv
      refine Submission.iwl_cycle_reduction P m
        Submission.lipschitz_pushforward_integer_multiplicity hBLI ?_
      intro K _ Tj T hIM hbd _ hM hconv
      -- `∂T = 0`, and `M_W(T) ≤ liminf_j M_W(T_j) ≤ sup_j M(T_j) < ∞`.
      have hTbd : T.boundary = 0 := by
        ext ω
        refine tendsto_nhds_unique (hconv.boundary ω) ?_
        simp [hbd]
      have hTmass : ∀ W, CompactlyContainedOpen W univ →
          T.massOn W + T.boundary.massOn W < ∞ := by
        intro W _
        rw [hTbd, hmassOn_zero, add_zero]
        calc T.massOn W ≤ liminf (fun j => (Tj j).massOn W) atTop := hconv.massOn_le_liminf W
          _ ≤ ⨆ j, (Tj j).massOn W := le_trans liminf_le_limsup limsup_le_iSup
          _ ≤ ⨆ j, (Tj j).mass := iSup_mono fun j => (Tj j).massOn_mono (subset_univ W)
          _ < ∞ := hM
      -- Step 10: 8.1 applies.
      have hrect : IsRectifiableCurrent T :=
        Submission.rectifiability_theorem P m univ isOpen_univ T hTmass
          (Submission.iwl_positive_density P m hP2 Submission.slicing_theorem
            Submission.isoperimetric_theorem
            Submission.lipschitz_pushforward_integer_multiplicity hBLI Tj T hIM hbd hM hconv)
      exact Submission.iwl_integer_density P m hP2 Submission.slicing_theorem
        Submission.lipschitz_pushforward_integer_multiplicity Tj T hIM hbd hM hconv hrect
  -- Step 3: induction on `m`.
  intro m
  induction m with
  | zero =>
    refine step 0 fun Yj Y hIM hM hconv => ?_
    exact Submission.iwl_zero_dim_integrality P univ isOpen_univ (fun j => (Yj j).boundary)
      Y.boundary hIM
      (fun W _ => (iSup_mono fun j => (Yj j).boundary.massOn_mono (subset_univ W)).trans_lt hM)
      hconv
  | succ m ih =>
    refine step (m + 1) fun Yj Y hIM hM hconv => ?_
    refine ih univ isOpen_univ (fun j => (Yj j).boundary) Y.boundary
      (fun j => ⟨hIM j, ?_⟩) (fun W _ => ?_) hconv
    · rw [GeometricCurrentOn.boundary_boundary]
      exact hIM_of_eq_zero _ fun _ => rfl
    · simp only [GeometricCurrentOn.boundary_boundary, hmassOn_zero, add_zero]
      exact (iSup_mono fun j => (Yj j).boundary.massOn_mono (subset_univ W)).trans_lt hM

end GMT.Ch06
