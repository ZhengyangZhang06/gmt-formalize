      have hψ1 : ∀ x, ‖ψ x‖ ≤ 1 := fun x => by
        rw [hψ, norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hε₂1, inv_mul_le_iff₀ hε₂1,
