            = ∫ x, θ x * ξ x (ω x) ∂((μHE[k] : Measure (Eucl P)).restrict M) := by rw [heq]
          _ = 0 := h
    have hmem : ∀ᵐ x ∂((μHE[k] : Measure (Eucl P)).restrict M), x ∈ M :=
      ae_restrict_mem₀ hT.nullMeasurableSet
    have hnot : ∀ᵐ x ∂((μHE[k] : Measure (Eucl P)).restrict M), x ∉ O := by
