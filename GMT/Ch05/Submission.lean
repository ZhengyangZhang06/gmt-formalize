    intro x hx
    have h1 : ENNReal.ofReal (infDist (x - 0) (Tst : Set (Amb n ℓ))) ≤
        V.heightSup 0 (2 * δ₀ * ρ) Tst := by
      unfold RectifiableVarifold.heightSup
      refine le_iSup₂_of_le (f := fun x (_ : x ∈ V.support ∩ closedBall 0 (2 * δ₀ * ρ)) =>
