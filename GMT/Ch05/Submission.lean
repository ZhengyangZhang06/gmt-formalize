  /- **Step 3, end.** Corollary 2.7 makes `spt V` a Lipschitz graph over `B_{δ₀ρ/4}`. -/
  obtain ⟨f, hfLip, -, hgraph⟩ := hLGC L (2 * CA + 2 * Real.sqrt (CI * C₂)) hL0 (by linarith)
