  -- Steps 1–2 (`lgc_height_cone` with `τ = βL`): height bound and cone condition.
  have htilt' : ∀ ξ ∈ V.support ∩ closedBall 0 (δ * ρ / 2), ∀ σ : ℝ, 0 < σ →
