            hsNormSq (fderiv ℝ (fun x => f x - (c + A x)) y)) ≤
            Real.sqrt (CW + C12 ^ 2) * σ * Real.sqrt E0 := by
          have e : Real.sqrt ((CW + C12 ^ 2) * σ ^ 2 * E0) =
              Real.sqrt (CW + C12 ^ 2) * σ * Real.sqrt E0 := by
            rw [Real.sqrt_mul' _ hE0nn, Real.sqrt_mul' _ (sq_nonneg σ), Real.sqrt_sq hσ.le]
          rw [← e]
          apply Real.sqrt_le_sqrt
          calc 2 * (σ / 16) * ∫ y in ball (0 : Rn 1) (σ / 16),
                hsNormSq (fderiv ℝ (fun x => f x - (c + A x)) y)
              ≤ 2 * (σ / 16) * (2 * (CW * E0 * σ ^ 1) + 2 * (C12 ^ 2 * E0) * (2 * (σ / 16))) := by
                gcongr
                exact hDwI.trans (by gcongr)
            _ = (CW / 4 + C12 ^ 2 / 32) * σ ^ 2 * E0 := by ring
            _ ≤ (CW + C12 ^ 2) * σ ^ 2 * E0 := by
                gcongr <;> linarith only [hCW, sq_nonneg C12]
        calc _ ≤ Real.sqrt (CG * C9) * σ * Real.sqrt E0 +
              Real.sqrt (CW + C12 ^ 2) * σ * Real.sqrt E0 := add_le_add hs1 hs2
          _ = C17 * σ * Real.sqrt E0 := by rw [hC17def]; ring
      -- the sup of the heights over `S` near `τ`
      set κ : ℝ := (1 - CP * δ) * ω with hκdef
      clear_value κ
      have hκω : ω / 2 ≤ κ := by
        rw [hκdef]
        calc ω / 2 = (1 / 2) * ω := by ring
          _ ≤ (1 - CP * δ) * ω := mul_le_mul_of_nonneg_right (by linarith only [hCPδ]) hω.le
      have hκ : 0 < κ := lt_of_lt_of_le (by positivity) hκω
      have hlowκ : ∀ x ∈ V.support ∩ closedBall τ r, ∀ s : ℝ, 0 < s → s ≤ σ / 64 →
          ENNReal.ofReal (κ * s) ≤ V.weight (closedBall x s) := by
        intro x hx s hs hs'
        have h1 := hLow2 x hx.1 (mem_closedBall_zero_iff.1 (hBτσ hx.2)) s hs
          (by linarith only [hs', hσ])
        rw [pow_one] at h1
        calc ENNReal.ofReal (κ * s) = ENNReal.ofReal ((1 - CP * δ) * (ω * s)) := by
              rw [hκdef, mul_assoc]
          _ ≤ V.weight (closedBall x s) := h1
      have hheight2 : ∀ x ∈ V.support ∩ closedBall τ r,
          infDist (x - τ) (S : Set (Amb 1 ℓ)) ≤ 2 * (σ / 64) := by
        intro x hx
        refine (hheight x hx).trans ?_
        have := mul_le_mul_of_nonneg_right hdC14 hσ.le
        linarith only [this]
      have hHS : ∀ x ∈ V.support ∩ closedBall τ r, infDist (x - τ) (S : Set (Amb 1 ℓ)) ≤
          max (2 * (C17 * σ * Real.sqrt E0)) (2 * (C6' * E0 * σ ^ 1) / κ) :=
        Submission.tdo_graph_height_sup 1 ℓ U V q f c A (σ / 2) (σ / 16) r (σ / 64)
          (C17 * σ * Real.sqrt E0) (C6' * E0 * σ ^ 1) κ (by positivity) hκ
          (by linarith only [hrσ, hσ]) (by linarith only [hcτ, htσ, hrσ, hσ]) hsupb hbad1 hlowκ
          hheight2
      have hE0s : E0 ≤ Real.sqrt E0 := by
        calc E0 = Real.sqrt E0 * Real.sqrt E0 := (Real.mul_self_sqrt hE0nn).symm
          _ ≤ Real.sqrt E0 * 1 := by gcongr; exact Real.sqrt_le_one.2 hE01
          _ = Real.sqrt E0 := mul_one _
      have hhstar : ∀ x ∈ V.support ∩ closedBall τ r,
          infDist (x - τ) (S : Set (Amb 1 ℓ)) ≤ C18 * σ * Real.sqrt E0 := by
        intro x hx
        refine (hHS x hx).trans (max_le ?_ ?_)
        · rw [hC18def]
          have : 0 ≤ 4 * C6' / ω * σ * Real.sqrt E0 := by positivity
          linarith only [this]
        · calc 2 * (C6' * E0 * σ ^ 1) / κ ≤ 2 * (C6' * E0 * σ ^ 1) / (ω / 2) :=
                div_le_div_of_nonneg_left (by positivity) (by positivity) hκω
            _ = 4 * C6' / ω * σ * E0 := by field_simp; ring
            _ ≤ 4 * C6' / ω * σ * Real.sqrt E0 := by gcongr
            _ ≤ C18 * σ * Real.sqrt E0 := by
                gcongr
                rw [hC18def]; linarith only [hC17]
      -- Lemma A at `(τ, r)` and the `L¹` Hölder bound for `H`
      have hLA : ∫ x in closedBall τ (r / 2), hsNormSq (V.tangentProj x - S.starProjection) ∂V.weight ≤
          144 * (r ^ 2)⁻¹ * Q + 4 * (C18 * σ * Real.sqrt E0) * ∫ x in closedBall τ r, ‖H x‖ ∂V.weight := by
        rw [hQdef]
        exact Submission.ted_lemma_a_tilt_height 1 ℓ le_rfl U hU V H hGMC hmeas hTPF.2.1 τ r
          (C18 * σ * Real.sqrt E0) hr hBτrU (by positivity) S hSdim hhstar
      have hHτ : ∫ x in closedBall τ r, ‖H x‖ ∂V.weight ≤ cω * k := by
        have h1 := hHol1 τ r (2 * (ω * r ^ 1)) (by positivity) hBτσ hμτ
        have h2 := hrpow r σ 1 hr (by linarith only [hrσ, hσ]) one_pos hp1
        have h3 : r ^ (((1 : ℕ) : ℝ) - 1) = 1 := by norm_num
        calc ∫ x in closedBall τ r, ‖H x‖ ∂V.weight
            ≤ (2 * (ω * r ^ 1)) ^ (1 - 1 / p) * σ ^ (1 * (((1 : ℕ) : ℝ) - p) / p) * k := h1
          _ ≤ cω * r ^ (((1 : ℕ) : ℝ) - 1) * k := mul_le_mul_of_nonneg_right h2 hk0
          _ = cω * k := by rw [h3, mul_one]
      have hE : V.tiltExcess τ (r / 2) S ≤
          (r / 2)⁻¹ * (144 * (r ^ 2)⁻¹ * Q + 4 * (C18 * σ * Real.sqrt E0) * (cω * k)) := by
        unfold RectifiableVarifold.tiltExcess
        rw [pow_one]
        gcongr
        exact hLA.trans (by gcongr)
      have hT1 : (r / 2)⁻¹ * (144 * (r ^ 2)⁻¹ * Q) ≤ 288 * X * (16 * t) ^ 2 * E0 := by
        have hQ3 : Q ≤ X * (16 * t) ^ 2 * E0 * r ^ 3 := h20a
        rw [show (r / 2)⁻¹ * (144 * (r ^ 2)⁻¹ * Q) = 288 * (Q / r ^ 3) by field_simp; ring,
          show 288 * X * (16 * t) ^ 2 * E0 = 288 * (X * (16 * t) ^ 2 * E0) by ring]
        gcongr
        rw [div_le_iff₀ (by positivity)]
        exact hQ3
      have hT2 : (r / 2)⁻¹ * (4 * (C18 * σ * Real.sqrt E0) * (cω * k)) ≤
          2 * C18 * cω * (16 * t) ^ 2 * E0 := by
        calc (r / 2)⁻¹ * (4 * (C18 * σ * Real.sqrt E0) * (cω * k))
            ≤ (r / 2)⁻¹ * (4 * (C18 * σ * Real.sqrt E0) * (cω * (Real.sqrt δ * Real.sqrt E0))) := by
              gcongr
          _ = 2 * C18 * cω * (Real.sqrt δ / t) * (Real.sqrt E0 * Real.sqrt E0) := by
              rw [hrdef]; field_simp; ring
          _ = 2 * C18 * cω * (Real.sqrt δ / t) * E0 := by rw [Real.mul_self_sqrt hE0nn]
          _ ≤ 2 * C18 * cω * (16 * t) ^ 2 * E0 := by
              gcongr
              rw [div_le_iff₀ ht]
              calc Real.sqrt δ ≤ t * (16 * t) ^ 2 := hsδt
                _ = (16 * t) ^ 2 * t := by ring
      calc V.tiltExcess τ (r / 2) S
          ≤ (r / 2)⁻¹ * (144 * (r ^ 2)⁻¹ * Q + 4 * (C18 * σ * Real.sqrt E0) * (cω * k)) := hE
        _ = (r / 2)⁻¹ * (144 * (r ^ 2)⁻¹ * Q) +
            (r / 2)⁻¹ * (4 * (C18 * σ * Real.sqrt E0) * (cω * k)) := mul_add _ _ _
        _ ≤ 288 * X * (16 * t) ^ 2 * E0 + 2 * C18 * cω * (16 * t) ^ 2 * E0 := add_le_add hT1 hT2
        _ = (288 * X + 2 * C18 * cω) * (16 * t) ^ 2 * E0 := by ring
        _ ≤ C19 * (16 * t) ^ 2 * E0 := by
            gcongr
            rw [hC19def]
            have : 0 ≤ C21' * (X + cω) := by positivity
            linarith only [this]
  /- Step 7: back to the centre (book (21), (22)); Step 8: conclusion. -/
  refine ⟨S, hSdim, ?_⟩
  have hr2 : r / 2 = 2 * (t * σ) := by rw [hrdef]; ring
  have htσ0 : 0 < t * σ := by positivity
  have hmono := Submission.tdo_tiltExcess_le_of_subset n ℓ U V hmeas 0 τ (t * σ) (r / 2) S htσ0
    (by rw [hr2]; linarith only [htσ0])
    (closedBall_subset_closedBall' (by rw [hr2, dist_zero_left]; linarith only [hτ]))
    ((closedBall_subset_closedBall (by linarith only [hr])).trans hBτrU)
  rw [show r / 2 / (t * σ) = 2 by rw [hr2]; field_simp] at hmono
  calc V.tiltExcess 0 (t * σ) S ≤ 2 ^ n * V.tiltExcess τ (r / 2) S := hmono
    _ ≤ 2 ^ n * (C19 * (16 * t) ^ 2 * E0) := by gcongr
    _ = 2 ^ n * 256 * C19 * t ^ 2 * E0 := by ring
    _ ≤ 2 ^ n * 256 * C19 * t ^ 2 * V.tiltExcessStar H p δ 0 σ T := by gcongr

/-- **Hole estimate** (Simon Ch. 5, proof of Lemma 2.6, (9)–(10)).  If `ζ ∈ F` lies at distance
`d = 2s ∈ (0, σ₀/16]` from `spt V`, then `sⁿ ≤ C₀ (μ_V(B_{3s}(ζ) \ F) + ∫_{B_{3s}(ζ)} |p_{T_x M} − p_T|²)`.
The nearest point `y` of `spt V` has `|y − ζ| = 2s`, so `μ_V(B_s(ζ)) = 0`; monotonicity at `ζ`
between `s` and `3s` and the lower density bound on `B_s(y) ⊆ B_{3s}(ζ)` give
`s^{n+2} ≤ C ∫_{B_{3s}(ζ)} |p_{T_x M}^⊥(x − ζ)|²`, and `p_{T_x M}^⊥ = (I − p_T) + (p_T − p_{T_x M})`
with the cone condition on `F` and the upper density bound on `B_{5s}(y)` absorb the rest. -/
theorem lip_approx_hole_estimate : ∀ (n ℓ : ℕ), 1 ≤ n → ∀ p : ℝ, (n : ℝ) < p → ∃ ε δ₀ C₀ : ℝ, 0 < ε ∧ 0 < δ₀ ∧ 0 < C₀ ∧ ∀ (U : Set (Amb n ℓ)), IsOpen U → ∀ (V : RectifiableVarifold n ℓ U) (H : Amb n ℓ → Amb n ℓ) (δ ρ : ℝ), 0 < δ → δ ≤ δ₀ → V.AllardHypotheses H p δ ρ → ∀ (T : Submodule ℝ (Amb n ℓ)) (F : Set (Amb n ℓ)), IsClosed F → (∀ x ∈ F, ∀ z ∈ F, ‖(x - z) - T.starProjection (x - z)‖ ≤ ε * ‖x - z‖) → ∀ ζ ∈ F, ‖ζ‖ ≤ 17 * (δ * ρ) / 32 → 0 < infDist ζ V.support → infDist ζ V.support ≤ δ * ρ / 16 → ENNReal.ofReal ((infDist ζ V.support / 2) ^ n) ≤ ENNReal.ofReal C₀ * (V.weight (closedBall ζ (3 * (infDist ζ V.support / 2)) \ F) + ENNReal.ofReal (∫ x in closedBall ζ (3 * (infDist ζ V.support / 2)), hsNormSq (V.tangentProj x - T.starProjection) ∂V.weight)) := by
  have lip_approx_hole_support_gap : ∀ (n ℓ : ℕ) (U : Set (Amb n ℓ)) (V : RectifiableVarifold n ℓ U) (ρ : ℝ) (ζ : Amb n ℓ), closedBall (0 : Amb n ℓ) ρ ⊆ U → 0 < infDist ζ V.support → ‖ζ‖ + infDist ζ V.support < ρ → (∃ y ∈ V.support, ‖y - ζ‖ = infDist ζ V.support) ∧ V.weight (ball ζ (infDist ζ V.support)) = 0 := by
    intro n ℓ U V ρ ζ hρU hd hζd
    set d := infDist ζ V.support with hd_def
    set S := V.weight.support with hS_def
    have hsupp : V.support = U ∩ S := rfl
    -- membership in `V.support` for points of `S` close to `ζ`
    have hmem : ∀ z ∈ S, ‖z - ζ‖ < ρ - ‖ζ‖ → z ∈ V.support := by
      intro z hz hzd
      refine ⟨hρU ?_, hz⟩
      rw [mem_closedBall, dist_zero_right]
      have : ‖z‖ ≤ ‖ζ‖ + ‖z - ζ‖ := by
        have := norm_add_le ζ (z - ζ)
        simpa using this
      linarith
    have hne : V.support.Nonempty := by
      by_contra h
      rw [not_nonempty_iff_eq_empty] at h
      rw [hd_def, h, infDist_empty] at hd
      exact lt_irrefl _ hd
    have hSne : S.Nonempty := hne.mono inter_subset_right
    have hle : infDist ζ S ≤ d := infDist_le_infDist_of_subset inter_subset_right hne
    obtain ⟨y, hyS, hy⟩ := (Measure.isClosed_support (μ := V.weight)).exists_infDist_eq_dist hSne ζ
    have hyd : ‖y - ζ‖ ≤ d := by
      rw [← dist_eq_norm, dist_comm, ← hy]; exact hle
    have hyV : y ∈ V.support := hmem y hyS (by linarith)
    have hdy : d ≤ ‖y - ζ‖ := by
      rw [← dist_eq_norm, dist_comm]; exact infDist_le_dist_of_mem hyV
    refine ⟨⟨y, hyV, le_antisymm hyd hdy⟩, ?_⟩
    have hball : ball ζ d ⊆ Sᶜ := by
      intro z hz hzS
      rw [mem_ball, dist_eq_norm] at hz
      have hzV : z ∈ V.support := hmem z hzS (by linarith)
      have : d ≤ dist ζ z := infDist_le_dist_of_mem hzV
      rw [dist_comm, dist_eq_norm] at this
      linarith
    exact measure_mono_null hball Measure.measure_compl_support
  have lip_approx_hole_norm_apply_sq_le_hsNormSq : ∀ (m k : ℕ) (A : Rn m →L[ℝ] Rn k) (v : Rn m), ‖A v‖ ^ 2 ≤ hsNormSq A * ‖v‖ ^ 2 := by
    intro m k A v
    set b := EuclideanSpace.basisFun (Fin m) ℝ
    have hv : v = ∑ i, b.repr v i • b i := (b.sum_repr v).symm
    have hAv : A v = ∑ i, b.repr v i • A (EuclideanSpace.single i 1) := by
      conv_lhs => rw [hv]
      simp [b, map_sum, map_smul]
    have h1 : ‖A v‖ ≤ ∑ i, |b.repr v i| * ‖A (EuclideanSpace.single i 1)‖ := by
      rw [hAv]
      refine (norm_sum_le _ _).trans (le_of_eq ?_)
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [norm_smul, Real.norm_eq_abs]
    have h2 : (∑ i, |b.repr v i| * ‖A (EuclideanSpace.single i 1)‖) ^ 2 ≤
        (∑ i, |b.repr v i| ^ 2) * ∑ i, ‖A (EuclideanSpace.single i 1)‖ ^ 2 :=
      Finset.sum_mul_sq_le_sq_mul_sq _ _ _
    have h3 : ∑ i, |b.repr v i| ^ 2 = ‖v‖ ^ 2 := by
      have := b.repr.norm_map v
      rw [← this, EuclideanSpace.norm_sq_eq]
      simp [sq_abs]
    have h0 : 0 ≤ ‖A v‖ := norm_nonneg _
    calc ‖A v‖ ^ 2 ≤ (∑ i, |b.repr v i| * ‖A (EuclideanSpace.single i 1)‖) ^ 2 :=
          pow_le_pow_left₀ h0 h1 2
      _ ≤ (∑ i, |b.repr v i| ^ 2) * ∑ i, ‖A (EuclideanSpace.single i 1)‖ ^ 2 := h2
      _ = hsNormSq A * ‖v‖ ^ 2 := by rw [h3, hsNormSq]; ring
  have lip_approx_hole_normal_part_bound : ∀ (n ℓ : ℕ) (μ : Measure (Amb n ℓ)) (P : Amb n ℓ → Amb n ℓ →L[ℝ] Amb n ℓ) (T : Submodule ℝ (Amb n ℓ)) (F : Set (Amb n ℓ)) (ε r : ℝ) (ζ : Amb n ℓ), AEStronglyMeasurable P μ → MeasurableSet F → (∀ x ∈ F, ∀ z ∈ F, ‖(x - z) - T.starProjection (x - z)‖ ≤ ε * ‖x - z‖) → ζ ∈ F → μ (closedBall ζ r) < ⊤ → IntegrableOn (fun x => hsNormSq (P x - T.starProjection)) (closedBall ζ r) μ → IntegrableOn (fun x => ‖(x - ζ) - P x (x - ζ)‖ ^ 2) (closedBall ζ r) μ ∧ ∫ x in closedBall ζ r, ‖(x - ζ) - P x (x - ζ)‖ ^ 2 ∂μ ≤ 2 * r ^ 2 * (ε ^ 2 * μ.real (closedBall ζ r) + μ.real (closedBall ζ r \ F) + ∫ x in closedBall ζ r, hsNormSq (P x - T.starProjection) ∂μ) := by
    intro n ℓ μ P T F ε r ζ hP hF hcone hζ hfin hτ
    have hB : MeasurableSet (closedBall ζ r) := measurableSet_closedBall
    -- `v - p_T v` is the orthogonal projection onto `Tᗮ`, so it has norm `≤ ‖v‖`.
    have hQ : ∀ v : Amb n ℓ, ‖v - T.starProjection v‖ ≤ ‖v‖ := by
      intro v
      have h := Submodule.norm_sq_eq_add_norm_sq_starProjection v T
      have e2 : Tᗮ.starProjection v = v - T.starProjection v := by
        rw [Submodule.starProjection_orthogonal']; simp
      rw [e2] at h
      have h4 : ‖v - T.starProjection v‖ ^ 2 ≤ ‖v‖ ^ 2 := by
        have := sq_nonneg ‖T.starProjection v‖
        linarith
      exact (pow_le_pow_iff_left₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).mp h4
    have hτnn : ∀ x, 0 ≤ hsNormSq (P x - T.starProjection) :=
      fun x => Finset.sum_nonneg fun i _ => sq_nonneg _
    -- Pointwise: `|p_x^⊥ v|² ≤ 2|Q v|² + 2 |p_x - p_T|²_HS |v|²`.
    have hpt : ∀ x, ‖(x - ζ) - P x (x - ζ)‖ ^ 2 ≤
        2 * ‖(x - ζ) - T.starProjection (x - ζ)‖ ^ 2 +
          2 * (hsNormSq (P x - T.starProjection) * ‖x - ζ‖ ^ 2) := by
      intro x
      have hdecomp : (x - ζ) - P x (x - ζ) =
          ((x - ζ) - T.starProjection (x - ζ)) - (P x - T.starProjection) (x - ζ) := by
        rw [sub_apply]; abel
      rw [hdecomp]
      have hHS := lip_approx_hole_norm_apply_sq_le_hsNormSq _ _ (P x - T.starProjection) (x - ζ)
      have hn := norm_sub_le ((x - ζ) - T.starProjection (x - ζ)) ((P x - T.starProjection) (x - ζ))
      nlinarith [norm_nonneg ((x - ζ) - T.starProjection (x - ζ)),
        norm_nonneg ((P x - T.starProjection) (x - ζ)),
        norm_nonneg (((x - ζ) - T.starProjection (x - ζ)) - (P x - T.starProjection) (x - ζ)),
        sq_nonneg (‖(x - ζ) - T.starProjection (x - ζ)‖ - ‖(P x - T.starProjection) (x - ζ)‖)]
    -- The dominating function `g`.
    set g : Amb n ℓ → ℝ := fun x => 2 * (ε ^ 2 * r ^ 2) + 2 * r ^ 2 * Fᶜ.indicator 1 x +
      2 * r ^ 2 * hsNormSq (P x - T.starProjection) with hg_def
    have hfg : ∀ x ∈ closedBall ζ r, ‖(x - ζ) - P x (x - ζ)‖ ^ 2 ≤ g x := by
      intro x hx
      have hxr : ‖x - ζ‖ ≤ r := by rw [mem_closedBall, dist_eq_norm] at hx; exact hx
      have hsq : ‖x - ζ‖ ^ 2 ≤ r ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hxr 2
      have hτb : hsNormSq (P x - T.starProjection) * ‖x - ζ‖ ^ 2 ≤
          hsNormSq (P x - T.starProjection) * r ^ 2 := mul_le_mul_of_nonneg_left hsq (hτnn x)
      by_cases hxF : x ∈ F
      · have hc := hcone x hxF ζ hζ
        have h1 : ‖(x - ζ) - T.starProjection (x - ζ)‖ ^ 2 ≤ (ε * ‖x - ζ‖) ^ 2 :=
          pow_le_pow_left₀ (norm_nonneg _) hc 2
        have h3 : ε ^ 2 * ‖x - ζ‖ ^ 2 ≤ ε ^ 2 * r ^ 2 := mul_le_mul_of_nonneg_left hsq (sq_nonneg ε)
        have hind : Fᶜ.indicator (1 : Amb n ℓ → ℝ) x = 0 :=
          indicator_of_notMem (by simpa using hxF) _
        simp only [hg_def, hind]
        nlinarith [hpt x]
      · have h1 : ‖(x - ζ) - T.starProjection (x - ζ)‖ ^ 2 ≤ ‖x - ζ‖ ^ 2 :=
          pow_le_pow_left₀ (norm_nonneg _) (hQ (x - ζ)) 2
        have hind : Fᶜ.indicator (1 : Amb n ℓ → ℝ) x = 1 :=
          indicator_of_mem (by simpa using hxF) _
        simp only [hg_def, hind]
        nlinarith [hpt x, sq_nonneg ε, sq_nonneg r, mul_nonneg (sq_nonneg ε) (sq_nonneg r)]
    -- Measurability of the integrand.
    have hPv : AEStronglyMeasurable (fun x => P x (x - ζ)) μ :=
      (ContinuousLinearMap.id ℝ (Amb n ℓ →L[ℝ] Amb n ℓ)).aestronglyMeasurable_comp₂ hP
        (continuous_id.sub continuous_const).aestronglyMeasurable
    have hfm : AEStronglyMeasurable (fun x => ‖(x - ζ) - P x (x - ζ)‖ ^ 2) μ :=
      (((continuous_id.sub continuous_const).aestronglyMeasurable.sub hPv).norm).pow 2
    -- Integrability of `g` on the ball.
    have hfin' : μ (closedBall ζ r) ≠ ⊤ := hfin.ne
    have hc1 : IntegrableOn (fun _ : Amb n ℓ => 2 * (ε ^ 2 * r ^ 2)) (closedBall ζ r) μ :=
      integrableOn_const hfin'
    have hc2 : IntegrableOn (fun x => 2 * r ^ 2 * Fᶜ.indicator (1 : Amb n ℓ → ℝ) x) (closedBall ζ r) μ := by
      have : IntegrableOn (Fᶜ.indicator (fun _ : Amb n ℓ => (1 : ℝ))) (closedBall ζ r) μ :=
        (integrableOn_const hfin').indicator hF.compl
      exact this.const_mul _
    have hc3 : IntegrableOn (fun x => 2 * r ^ 2 * hsNormSq (P x - T.starProjection)) (closedBall ζ r) μ :=
      hτ.const_mul _
    have hgi : IntegrableOn g (closedBall ζ r) μ := (hc1.add hc2).add hc3
    have hfi : IntegrableOn (fun x => ‖(x - ζ) - P x (x - ζ)‖ ^ 2) (closedBall ζ r) μ := by
      refine Integrable.mono' hgi hfm.restrict ?_
      rw [ae_restrict_iff' hB]
      refine Eventually.of_forall fun x hx => ?_
      rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
      exact hfg x hx
    refine ⟨hfi, ?_⟩
    have hind : ∫ x in closedBall ζ r, Fᶜ.indicator (1 : Amb n ℓ → ℝ) x ∂μ =
        μ.real (closedBall ζ r \ F) := by
      rw [integral_indicator_one hF.compl, Measure.real, Measure.restrict_apply hF.compl,
        Measure.real]
      congr 1
      rw [inter_comm, sdiff_eq]
    have hint_g : ∫ x in closedBall ζ r, g x ∂μ = 2 * (ε ^ 2 * r ^ 2) * μ.real (closedBall ζ r) +
        2 * r ^ 2 * μ.real (closedBall ζ r \ F) +
        2 * r ^ 2 * ∫ x in closedBall ζ r, hsNormSq (P x - T.starProjection) ∂μ := by
      have e1 : ∫ x in closedBall ζ r, g x ∂μ =
          ∫ x in closedBall ζ r, (2 * (ε ^ 2 * r ^ 2) + 2 * r ^ 2 * Fᶜ.indicator (1 : Amb n ℓ → ℝ) x) ∂μ +
          ∫ x in closedBall ζ r, 2 * r ^ 2 * hsNormSq (P x - T.starProjection) ∂μ :=
        integral_add (hc1.add hc2) hc3
      have e2 : ∫ x in closedBall ζ r, (2 * (ε ^ 2 * r ^ 2) + 2 * r ^ 2 * Fᶜ.indicator (1 : Amb n ℓ → ℝ) x) ∂μ =
          ∫ _ in closedBall ζ r, 2 * (ε ^ 2 * r ^ 2) ∂μ +
          ∫ x in closedBall ζ r, 2 * r ^ 2 * Fᶜ.indicator (1 : Amb n ℓ → ℝ) x ∂μ :=
        integral_add hc1 hc2
      rw [e1, e2, setIntegral_const (2 * (ε ^ 2 * r ^ 2)),
        integral_const_mul (2 * r ^ 2) (fun x => Fᶜ.indicator (1 : Amb n ℓ → ℝ) x),
        integral_const_mul (2 * r ^ 2) (fun x => hsNormSq (P x - T.starProjection)), hind, smul_eq_mul]
      ring
    calc ∫ x in closedBall ζ r, ‖(x - ζ) - P x (x - ζ)‖ ^ 2 ∂μ
        ≤ ∫ x in closedBall ζ r, g x ∂μ := setIntegral_mono_on hfi hgi hB hfg
      _ = _ := hint_g
      _ = 2 * r ^ 2 * (ε ^ 2 * μ.real (closedBall ζ r) + μ.real (closedBall ζ r \ F) +
            ∫ x in closedBall ζ r, hsNormSq (P x - T.starProjection) ∂μ) := by ring
  have lip_approx_hole_annulus_integral_le : ∀ (n ℓ : ℕ) (μ : Measure (Amb n ℓ)) (f : Amb n ℓ → ℝ) (ζ : Amb n ℓ) (k : ℕ) (s r : ℝ), 0 < s → (∀ x, 0 ≤ f x) → IntegrableOn f (closedBall ζ r) μ → ∫ x in closedBall ζ r \ closedBall ζ s, f x / ‖x - ζ‖ ^ k ∂μ ≤ (s ^ k)⁻¹ * ∫ x in closedBall ζ r, f x ∂μ := by
    intro n ℓ μ f ζ k s r hs hf hfi
    have hA : MeasurableSet (closedBall ζ r \ closedBall ζ s) :=
      measurableSet_closedBall.diff measurableSet_closedBall
    have hsk : 0 < s ^ k := pow_pos hs k
    have hsub : closedBall ζ r \ closedBall ζ s ⊆ closedBall ζ r := sdiff_subset
    have h1 : ∫ x in closedBall ζ r \ closedBall ζ s, f x / ‖x - ζ‖ ^ k ∂μ ≤
        ∫ x in closedBall ζ r \ closedBall ζ s, (s ^ k)⁻¹ * f x ∂μ := by
      refine integral_mono_of_nonneg ?_ ?_ ?_
      · exact Eventually.of_forall fun x => div_nonneg (hf x) (pow_nonneg (norm_nonneg _) _)
      · exact ((hfi.mono_set hsub).const_mul _)
      · rw [EventuallyLE, ae_restrict_iff' hA]
        refine Eventually.of_forall fun x hx => ?_
        have hx' : s < ‖x - ζ‖ := by
          have := hx.2
          rw [mem_closedBall, dist_eq_norm, not_le] at this
          exact this
        have hpow : s ^ k ≤ ‖x - ζ‖ ^ k := pow_le_pow_left₀ hs.le hx'.le k
        rw [div_eq_inv_mul]
        exact mul_le_mul_of_nonneg_right (inv_anti₀ hsk hpow) (hf x)
    have h2 : ∫ x in closedBall ζ r \ closedBall ζ s, f x ∂μ ≤ ∫ x in closedBall ζ r, f x ∂μ :=
      setIntegral_mono_set hfi (Eventually.of_forall fun x => hf x) (Eventually.of_forall hsub)
    calc ∫ x in closedBall ζ r \ closedBall ζ s, f x / ‖x - ζ‖ ^ k ∂μ
        ≤ ∫ x in closedBall ζ r \ closedBall ζ s, (s ^ k)⁻¹ * f x ∂μ := h1
      _ = (s ^ k)⁻¹ * ∫ x in closedBall ζ r \ closedBall ζ s, f x ∂μ := integral_const_mul _ _
      _ ≤ (s ^ k)⁻¹ * ∫ x in closedBall ζ r, f x ∂μ :=
          mul_le_mul_of_nonneg_left h2 (inv_nonneg.mpr hsk.le)
  intro n ℓ hn p hp
  obtain ⟨δP, hδP0, hδP8, hpin⟩ := Submission.lip_approx_pinched_density n ℓ hn p hp
  have hω : 0 < unitBallVolume n := by
    unfold unitBallVolume
    exact div_pos (Real.rpow_pos_of_pos Real.pi_pos _) (Real.Gamma_pos_of_pos (by positivity))
  have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  have hpn : 0 < p - n := by linarith
  have hp0 : 0 < p := by linarith
  have he : 0 < Real.exp 1 := Real.exp_pos 1
  have h3n : (0 : ℝ) < 3 ^ n := by positivity
  have h5n : (0 : ℝ) < 5 ^ n := by positivity
  obtain ⟨A8, hA8def⟩ : ∃ A8 : ℝ, A8 = 72 * 3 ^ n * Real.exp 1 ^ 2 / unitBallVolume n := ⟨_, rfl⟩
  have hA8 : 0 < A8 := by rw [hA8def]; positivity
  obtain ⟨ε, hεdef⟩ : ∃ ε : ℝ, ε = Real.sqrt (1 / (4 * A8 * unitBallVolume n * 5 ^ n)) := ⟨_, rfl⟩
  have hε : 0 < ε := by rw [hεdef]; exact Real.sqrt_pos.mpr (by positivity)
  have hε2 : ε ^ 2 = 1 / (4 * A8 * unitBallVolume n * 5 ^ n) := by
    rw [hεdef]; exact Real.sq_sqrt (by positivity)
  obtain ⟨κ, hκdef⟩ : ∃ κ : ℝ, κ = (p - n) / (4 * p) := ⟨_, rfl⟩
  have hκ : 0 < κ := by rw [hκdef]; positivity
  obtain ⟨δ₃, hδ₃_def⟩ : ∃ δ₃ : ℝ,
      δ₃ = unitBallVolume n * (p - n) / (3 ^ n * 32 * Real.exp 1 * p) := ⟨_, rfl⟩
  have hδ₃ : 0 < δ₃ := by rw [hδ₃_def]; positivity
  refine ⟨ε, min δP (min κ δ₃), 2 * A8, hε, lt_min hδP0 (lt_min hκ hδ₃), by positivity, ?_⟩
  intro U hU V H δ ρ hδ hδ0 hA T F hFc hcone ζ hζF hζn hd hdle
  have hδP : δ ≤ δP := le_trans hδ0 (min_le_left _ _)
  have hδκ : δ ≤ κ := le_trans hδ0 (le_trans (min_le_right _ _) (min_le_left _ _))
  have hδ3 : δ ≤ δ₃ := le_trans hδ0 (le_trans (min_le_right _ _) (min_le_right _ _))
  have hδ8 : δ ≤ 1 / 8 := le_trans hδP hδP8
  have hρ : 0 < ρ := hA.1
  have hρU : closedBall (0 : Amb n ℓ) ρ ⊆ U := hA.2.2.2.2.1
  set d := infDist ζ V.support with hd_def
  set s := d / 2 with hs_def
  have hs : 0 < s := by positivity
  have hδρ : 0 < δ * ρ := mul_pos hδ hρ
  have hd2 : d = 2 * s := by rw [hs_def]; ring
  have hδρ8 : δ * ρ ≤ ρ / 8 := by
    have := mul_le_mul_of_nonneg_right hδ8 hρ.le
    linarith
  -- norm triangle helper
  have tri : ∀ a b : Amb n ℓ, ‖a‖ ≤ ‖b‖ + ‖a - b‖ := by
    intro a b
    have := norm_add_le b (a - b)
    simpa using this
  -- Step 1: nearest support point
  have hζd : ‖ζ‖ + d < ρ := by linarith
  obtain ⟨⟨y, hyV, hyζ⟩, hnull⟩ := lip_approx_hole_support_gap n ℓ U V ρ ζ hρU hd hζd
  have hBs0 : V.weight (closedBall ζ s) = 0 :=
    measure_mono_null (closedBall_subset_ball (by rw [hs_def]; linarith)) hnull
  have hyn : ‖y‖ ≤ 3 * (δ * ρ) := by
    have := tri y ζ
    linarith
  have hBy_sub : closedBall y s ⊆ closedBall ζ (3 * s) := by
    intro x hx
    rw [mem_closedBall, dist_eq_norm] at hx ⊢
    have := norm_sub_le_norm_sub_add_norm_sub x y ζ
    linarith
  have hBζ_sub : closedBall ζ (3 * s) ⊆ closedBall y (5 * s) := by
    intro x hx
    rw [mem_closedBall, dist_eq_norm] at hx ⊢
    have := norm_sub_le_norm_sub_add_norm_sub x ζ y
    have h' : ‖ζ - y‖ = ‖y - ζ‖ := norm_sub_rev ζ y
    linarith
  -- pinched density at `y`
  have hs_le : s ≤ ρ / 2 := by linarith
  have h5s_le : 5 * s ≤ ρ / 2 := by linarith
  have hlow := (hpin U hU V H δ ρ hδ hδP hA y hyn s hs hs_le).2 hyV
  have hup := (hpin U hU V H δ ρ hδ hδP hA y hyn (5 * s) (by positivity) h5s_le).1
  have hfin5 : V.weight (closedBall y (5 * s)) < ⊤ := lt_of_le_of_lt hup ENNReal.ofReal_lt_top
  have hfin3 : V.weight (closedBall ζ (3 * s)) < ⊤ := lt_of_le_of_lt (measure_mono hBζ_sub) hfin5
  -- Step 2: monotonicity at `ζ`
  obtain ⟨Λ, hΛ_def⟩ : ∃ Λ : ℝ, Λ = 4 * p * δ / (p - n) := ⟨_, rfl⟩
  have hΛ0 : 0 ≤ Λ := by rw [hΛ_def]; positivity
  have hΛ1 : Λ ≤ 1 := by
    rw [hΛ_def, div_le_one hpn]
    have h1 : δ ≤ (p - n) / (4 * p) := hκdef ▸ hδκ
    rw [le_div_iff₀ (by positivity)] at h1
    linarith
  obtain ⟨R, hR_def⟩ : ∃ R : ℝ, R = (1 - 3 * δ) * ρ := ⟨_, rfl⟩
  have hR : 0 < R := by rw [hR_def]; exact mul_pos (by linarith) hρ
  have hRsub : closedBall ζ R ⊆ closedBall 0 ρ := by
    intro x hx
    rw [mem_closedBall, dist_eq_norm] at hx
    rw [mem_closedBall, dist_zero_right]
    have := tri x ζ
    have hRe : R = ρ - 3 * (δ * ρ) := by rw [hR_def]; ring
    rw [hRe] at hx
    linarith
  have h3sR : 3 * s < R := by
    have hRe : R = ρ - 3 * (δ * ρ) := by rw [hR_def]; ring
    rw [hRe]; linarith
  have hmono := (Submission.lip_approx_monotonicity n ℓ hn p hp U hU V H δ ρ Λ hδ hA (le_of_eq hΛ_def.symm)
    hΛ1 ζ R hR hRsub s (3 * s) hs (by linarith) h3sR).2.1
  -- tangent structure
  obtain ⟨hmeas, hint, -⟩ := Submission.lip_approx_tangent_structure n ℓ hn U hU V
  have hB3sub : closedBall ζ (3 * s) ⊆ U := by
    intro x hx
    apply hρU
    rw [mem_closedBall, dist_eq_norm] at hx
    rw [mem_closedBall, dist_zero_right]
    have := tri x ζ
    linarith
  have hτ := hint T (closedBall ζ (3 * s)) (isCompact_closedBall _ _) hB3sub
  -- children C and D
  obtain ⟨hIi, hIb⟩ := lip_approx_hole_normal_part_bound n ℓ V.weight V.tangentProj T F ε (3 * s) ζ
    hmeas hFc.measurableSet hcone hζF hfin3 hτ
  have hJ := lip_approx_hole_annulus_integral_le n ℓ V.weight
    (fun x => ‖(x - ζ) - V.tangentProj x (x - ζ)‖ ^ 2) ζ (n + 2) s (3 * s) hs
    (fun x => sq_nonneg _) hIi
  beta_reduce at hJ
  set I := ∫ x in closedBall ζ (3 * s), ‖(x - ζ) - V.tangentProj x (x - ζ)‖ ^ 2 ∂V.weight with hI_def
  set J := ∫ x in closedBall ζ (3 * s) \ closedBall ζ s,
    ‖(x - ζ) - V.tangentProj x (x - ζ)‖ ^ 2 / ‖x - ζ‖ ^ (n + 2) ∂V.weight with hJ_def
  set m3 := V.weight.real (closedBall ζ (3 * s)) with hm3_def
  set M := V.weight.real (closedBall ζ (3 * s) \ F) with hM_def
  set t := ∫ x in closedBall ζ (3 * s), hsNormSq (V.tangentProj x - T.starProjection) ∂V.weight
    with ht_def
  clear_value I J m3 M t
  have hBs0' : V.weight.real (closedBall ζ s) = 0 := by simp [Measure.real, hBs0]
  have f1 : m3 / (3 * s) ^ n ≤ 2 * Real.exp Λ * Λ + Real.exp (2 * Λ) * J := by
    have h := hmono
    rw [hBs0', zero_div, mul_zero, zero_add] at h
    exact h
  have f3 : unitBallVolume n * s ^ n / 2 ≤ m3 := by
    have h1 : ENNReal.ofReal (unitBallVolume n * s ^ n / 2) ≤ V.weight (closedBall ζ (3 * s)) :=
      le_trans hlow (measure_mono hBy_sub)
    rw [hm3_def, Measure.real]
    exact (ENNReal.ofReal_le_iff_le_toReal hfin3.ne).mp h1
  have f4 : m3 ≤ 2 * unitBallVolume n * (5 * s) ^ n := by
    have h1 : V.weight (closedBall ζ (3 * s)) ≤ ENNReal.ofReal (2 * unitBallVolume n * (5 * s) ^ n) :=
      le_trans (measure_mono hBζ_sub) hup
    rw [hm3_def, Measure.real]
    exact ENNReal.toReal_le_of_le_ofReal (by positivity) h1
  have hI0 : 0 ≤ I := by rw [hI_def]; exact integral_nonneg fun x => sq_nonneg _
  have hM0 : 0 ≤ M := by rw [hM_def]; exact ENNReal.toReal_nonneg
  have ht0 : 0 ≤ t := by
    rw [ht_def]; exact integral_nonneg fun x => Finset.sum_nonneg fun i _ => sq_nonneg _
  have f6 : 2 * Real.exp 1 * Λ ≤ unitBallVolume n / (4 * 3 ^ n) := by
    have h1 : δ * (3 ^ n * 32 * Real.exp 1 * p) ≤ unitBallVolume n * (p - n) := by
      have h2 := hδ3
      rw [hδ₃_def, le_div_iff₀ (by positivity)] at h2
      exact h2
    rw [hΛ_def, le_div_iff₀ (by positivity)]
    have h3 : 2 * Real.exp 1 * (4 * p * δ / (p - n)) * (4 * 3 ^ n) =
        δ * (3 ^ n * 32 * Real.exp 1 * p) / (p - n) := by
      field_simp
      ring
    rw [h3, div_le_iff₀ hpn]
    linarith
  have hexpΛ : Real.exp Λ ≤ Real.exp 1 := Real.exp_le_exp.mpr hΛ1
  have hexp2Λ : Real.exp (2 * Λ) ≤ Real.exp 1 ^ 2 := by
    rw [two_mul, Real.exp_add, sq]
    exact mul_le_mul hexpΛ hexpΛ (Real.exp_pos _).le he.le
  have h3s : (3 * s) ^ n = 3 ^ n * s ^ n := mul_pow 3 s n
  have h5s : (5 * s) ^ n = 5 ^ n * s ^ n := mul_pow 5 s n
  have hsn2 : s ^ (n + 2) = s ^ n * s ^ 2 := pow_add s n 2
  have hX : 0 < s ^ n := pow_pos hs n
  -- Step 3: lower bound
  have g1 : m3 / (3 * s) ^ n ≤ 2 * Real.exp 1 * Λ + Real.exp 1 ^ 2 * ((s ^ (n + 2))⁻¹ * I) := by
    have hJ0 : 0 ≤ (s ^ (n + 2))⁻¹ * I := mul_nonneg (inv_nonneg.mpr (by positivity)) hI0
    have k1 : 2 * Real.exp Λ * Λ ≤ 2 * Real.exp 1 * Λ :=
      mul_le_mul_of_nonneg_right (by linarith) hΛ0
    have k2 : Real.exp (2 * Λ) * J ≤ Real.exp (2 * Λ) * ((s ^ (n + 2))⁻¹ * I) :=
      mul_le_mul_of_nonneg_left hJ (Real.exp_pos _).le
    have k3 : Real.exp (2 * Λ) * ((s ^ (n + 2))⁻¹ * I) ≤ Real.exp 1 ^ 2 * ((s ^ (n + 2))⁻¹ * I) :=
      mul_le_mul_of_nonneg_right hexp2Λ hJ0
    linarith
  have g2 : unitBallVolume n / (2 * 3 ^ n) ≤ m3 / (3 * s) ^ n := by
    rw [h3s, div_le_div_iff₀ (by positivity) (by positivity)]
    have k := mul_le_mul_of_nonneg_left f3 h3n.le
    have k' : 3 ^ n * (unitBallVolume n * s ^ n / 2) * 2 = unitBallVolume n * (3 ^ n * s ^ n) := by ring
    linarith [k, k']
  have g3 : unitBallVolume n * s ^ (n + 2) ≤ 4 * 3 ^ n * Real.exp 1 ^ 2 * I := by
    have k1 : unitBallVolume n / (4 * 3 ^ n) ≤ Real.exp 1 ^ 2 * ((s ^ (n + 2))⁻¹ * I) := by
      have : unitBallVolume n / (2 * 3 ^ n) =
          unitBallVolume n / (4 * 3 ^ n) + unitBallVolume n / (4 * 3 ^ n) := by
        field_simp
        ring
      linarith
    have hpos : 0 < s ^ (n + 2) := by positivity
    rw [div_le_iff₀ (by positivity)] at k1
    have k2 : Real.exp 1 ^ 2 * ((s ^ (n + 2))⁻¹ * I) * (4 * 3 ^ n) =
        4 * 3 ^ n * Real.exp 1 ^ 2 * I / s ^ (n + 2) := by
      field_simp
    rw [k2, le_div_iff₀ hpos] at k1
    linarith
  -- Step 4: upper bound for `I`
  have g4 : I ≤ 18 * s ^ 2 * (ε ^ 2 * (2 * unitBallVolume n * 5 ^ n * s ^ n) + M + t) := by
    have k : ε ^ 2 * m3 ≤ ε ^ 2 * (2 * unitBallVolume n * 5 ^ n * s ^ n) := by
      apply mul_le_mul_of_nonneg_left _ (sq_nonneg ε)
      have := f4
      rw [h5s] at this
      linarith
    calc I ≤ 2 * (3 * s) ^ 2 * (ε ^ 2 * m3 + M + t) := hIb
      _ ≤ 2 * (3 * s) ^ 2 * (ε ^ 2 * (2 * unitBallVolume n * 5 ^ n * s ^ n) + M + t) := by
        gcongr
      _ = 18 * s ^ 2 * (ε ^ 2 * (2 * unitBallVolume n * 5 ^ n * s ^ n) + M + t) := by ring
  -- Step 5: absorption
  have g5 : s ^ n ≤ 2 * A8 * (M + t) := by
    have hs2 : 0 < s ^ 2 := by positivity
    have k : unitBallVolume n * s ^ n * s ^ 2 ≤
        72 * 3 ^ n * Real.exp 1 ^ 2 * (ε ^ 2 * (2 * unitBallVolume n * 5 ^ n * s ^ n) + M + t) * s ^ 2 := by
      have h1 := g3
      rw [hsn2] at h1
      have h2 : 4 * 3 ^ n * Real.exp 1 ^ 2 * I ≤
          4 * 3 ^ n * Real.exp 1 ^ 2 * (18 * s ^ 2 * (ε ^ 2 * (2 * unitBallVolume n * 5 ^ n * s ^ n) + M + t)) :=
        mul_le_mul_of_nonneg_left g4 (by positivity)
      have h3 : unitBallVolume n * (s ^ n * s ^ 2) = unitBallVolume n * s ^ n * s ^ 2 := by ring
      have h4 : 4 * 3 ^ n * Real.exp 1 ^ 2 *
          (18 * s ^ 2 * (ε ^ 2 * (2 * unitBallVolume n * 5 ^ n * s ^ n) + M + t)) =
          72 * 3 ^ n * Real.exp 1 ^ 2 * (ε ^ 2 * (2 * unitBallVolume n * 5 ^ n * s ^ n) + M + t) * s ^ 2 := by
        ring
      linarith
    have k2 : unitBallVolume n * s ^ n ≤
        72 * 3 ^ n * Real.exp 1 ^ 2 * (ε ^ 2 * (2 * unitBallVolume n * 5 ^ n * s ^ n) + M + t) :=
      le_of_mul_le_mul_right k hs2
    have hA8ω : A8 * unitBallVolume n = 72 * 3 ^ n * Real.exp 1 ^ 2 := by
      rw [hA8def]; field_simp
    have hhalf : A8 * (ε ^ 2 * (2 * unitBallVolume n * 5 ^ n)) = 1 / 2 := by
      rw [hε2]; field_simp; ring
    have k3 : s ^ n ≤ A8 * (ε ^ 2 * (2 * unitBallVolume n * 5 ^ n * s ^ n) + M + t) := by
      have k4 : unitBallVolume n * s ^ n ≤
          unitBallVolume n * (A8 * (ε ^ 2 * (2 * unitBallVolume n * 5 ^ n * s ^ n) + M + t)) := by
        calc unitBallVolume n * s ^ n
            ≤ 72 * 3 ^ n * Real.exp 1 ^ 2 * (ε ^ 2 * (2 * unitBallVolume n * 5 ^ n * s ^ n) + M + t) := k2
          _ = unitBallVolume n * (A8 * (ε ^ 2 * (2 * unitBallVolume n * 5 ^ n * s ^ n) + M + t)) := by
            rw [← hA8ω]; ring
      exact le_of_mul_le_mul_left k4 hω
    have k5 : A8 * (ε ^ 2 * (2 * unitBallVolume n * 5 ^ n * s ^ n) + M + t) =
        s ^ n / 2 + A8 * (M + t) := by
      have : A8 * (ε ^ 2 * (2 * unitBallVolume n * 5 ^ n * s ^ n)) = s ^ n / 2 := by
        calc A8 * (ε ^ 2 * (2 * unitBallVolume n * 5 ^ n * s ^ n))
            = A8 * (ε ^ 2 * (2 * unitBallVolume n * 5 ^ n)) * s ^ n := by ring
          _ = s ^ n / 2 := by rw [hhalf]; ring
      linear_combination this
    linarith
  -- conversion to `[0, ∞]`
  have hMfin : V.weight (closedBall ζ (3 * s) \ F) ≠ ⊤ :=
    (lt_of_le_of_lt (measure_mono sdiff_subset) hfin3).ne
  have hMeq : V.weight (closedBall ζ (3 * s) \ F) = ENNReal.ofReal M := by
    rw [hM_def, Measure.real, ENNReal.ofReal_toReal hMfin]
  rw [hMeq, ← ENNReal.ofReal_add hM0 ht0, ← ENNReal.ofReal_mul (by positivity)]
  exact ENNReal.ofReal_le_ofReal g5

/-- **Blow-up test integrals versus normalized ball mass** (Simon Ch. 3, Remark 1.8(2)).  For
`η = η_{x,r}`, a Borel cut-off `0 ≤ φ ≤ 1` vanishing off `B_R(0)` with `B_{rR}(x) ⊆ U`, the blow-up
integral `I = ∫_{η(M)} φ(y) θ(x + r y) dHⁿ(y)` is nonnegative, and it bounds
`J = r⁻ⁿ ∫_{M ∩ B_r(x)} θ dHⁿ` from above if `φ = 1` on `B_1(0)` and from below if `φ = 0` off
`B_1(0)`. -/
theorem rsod_blowUp_integral_ballMass_bounds : ∀ (n ℓ : ℕ) (U : Set (Amb n ℓ))
    (V : RectifiableVarifold n ℓ U) (x : Amb n ℓ) (r R : ℝ) (φ : Amb n ℓ → ℝ), 0 < r → 1 ≤ R →
    closedBall x (r * R) ⊆ U → Measurable φ → (∀ y, 0 ≤ φ y ∧ φ y ≤ 1) →
    (∀ y, y ∉ closedBall (0 : Amb n ℓ) R → φ y = 0) →
    0 ≤ ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' V.carrier,
        φ y * V.mult (x + r • y) ∂(μHE[n] : Measure (Amb n ℓ)) ∧
    ((∀ y ∈ closedBall (0 : Amb n ℓ) 1, φ y = 1) →
      (r ^ n)⁻¹ * ∫ z in V.carrier ∩ closedBall x r, V.mult z ∂(μHE[n] : Measure (Amb n ℓ)) ≤
        ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' V.carrier,
          φ y * V.mult (x + r • y) ∂(μHE[n] : Measure (Amb n ℓ))) ∧
    ((∀ y, y ∉ closedBall (0 : Amb n ℓ) 1 → φ y = 0) →
      ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' V.carrier,
          φ y * V.mult (x + r • y) ∂(μHE[n] : Measure (Amb n ℓ)) ≤
        (r ^ n)⁻¹ * ∫ z in V.carrier ∩ closedBall x r, V.mult z ∂(μHE[n] : Measure (Amb n ℓ))) := by
  intro n ℓ U V x r R φ hr hR hball hφm hφ01 hφsupp
  -- Step 1: change of variables, `I = r⁻ⁿ ∫_M φ(η z) θ(z) dHⁿ(z)`.
  rw [Submission.rsod_blowUp_setIntegral_eq n ℓ V.carrier φ V.mult x r hr]
  set μ : Measure (Amb n ℓ) := (μHE[n] : Measure (Amb n ℓ))
  set η := Poincare.SimonGMT.Chapter03.blowUpMap x r with hη
  have hrpos : 0 ≤ (r ^ n)⁻¹ := inv_nonneg.mpr (pow_nonneg hr.le n)
  -- Step 2: `η z ∈ B_s(0) ↔ z ∈ B_{rs}(x)`.
  have hmem : ∀ z : Amb n ℓ, ∀ s : ℝ,
      η z ∈ closedBall (0 : Amb n ℓ) s ↔ z ∈ closedBall x (r * s) := by
    intro z s
    simp only [hη, Poincare.SimonGMT.Chapter03.blowUpMap, mem_closedBall, dist_eq_norm,
      sub_zero, norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hr)]
    rw [← div_eq_inv_mul, div_le_iff₀ hr, mul_comm s r]
  -- Step 3: `θ` is integrable on `M ∩ B_{rR}(x)` and on `M ∩ B_r(x)`, compact subsets of `U`.
  have hballr : closedBall x r ⊆ U :=
    (closedBall_subset_closedBall (le_mul_of_one_le_right hr.le hR)).trans hball
  have hintR : IntegrableOn V.mult (V.carrier ∩ closedBall x (r * R)) μ :=
    V.integrableOn_mult _ (isCompact_closedBall _ _) hball
  have hintr : IntegrableOn V.mult (V.carrier ∩ closedBall x r) μ :=
    V.integrableOn_mult _ (isCompact_closedBall _ _) hballr
  have hind : IntegrableOn ((closedBall x r).indicator V.mult) V.carrier μ := by
    rw [IntegrableOn, integrable_indicator_iff measurableSet_closedBall, IntegrableOn,
      Measure.restrict_restrict measurableSet_closedBall, inter_comm]
    exact hintr
  -- Step 4: `h = (φ ∘ η) θ` is integrable on `M`, being dominated by `1_{B_{rR}(x)} θ`.
  have hηm : Measurable η := by
    rw [hη]
    unfold Poincare.SimonGMT.Chapter03.blowUpMap
    fun_prop
  have hh : IntegrableOn (fun z => φ (η z) * V.mult z) V.carrier μ := by
    have hg : Integrable ((closedBall x (r * R)).indicator V.mult) (μ.restrict V.carrier) := by
      rw [integrable_indicator_iff measurableSet_closedBall, IntegrableOn,
        Measure.restrict_restrict measurableSet_closedBall, inter_comm]
      exact hintR
    refine hg.mono ((hφm.comp hηm).aestronglyMeasurable.mul
      V.aemeasurable_mult.aestronglyMeasurable) (Eventually.of_forall fun z => ?_)
    by_cases hz : z ∈ closedBall x (r * R)
    · rw [indicator_of_mem hz, norm_mul]
      have h1 : ‖φ (η z)‖ ≤ 1 := by
        rw [Real.norm_of_nonneg (hφ01 _).1]
        exact (hφ01 _).2
      calc ‖φ (η z)‖ * ‖V.mult z‖ ≤ 1 * ‖V.mult z‖ :=
            mul_le_mul_of_nonneg_right h1 (norm_nonneg _)
        _ = ‖V.mult z‖ := one_mul _
    · rw [indicator_of_notMem hz, hφsupp _ fun h => hz ((hmem z R).1 h), zero_mul, norm_zero]
  -- Step 5: `ν = Hⁿ ⌞ M`-a.e. point lies in `M`, where `θ > 0`.
  have hae : ∀ᵐ z ∂(μ.restrict V.carrier), z ∈ V.carrier :=
    ae_restrict_mem₀ V.nullMeasurableSet_carrier
  -- Step 7: `J = r⁻ⁿ ∫_M 1_{B_r(x)} θ dHⁿ`.
  have hJ : ∫ z in V.carrier ∩ closedBall x r, V.mult z ∂μ =
      ∫ z in V.carrier, (closedBall x r).indicator V.mult z ∂μ :=
    (setIntegral_indicator measurableSet_closedBall).symm
  refine ⟨?_, ?_, ?_⟩
  · -- Step 6, (a): `h ≥ 0` a.e. on `M`.
    refine mul_nonneg hrpos (setIntegral_nonneg_of_ae_restrict ?_)
    filter_upwards [hae] with z hz
    exact mul_nonneg (hφ01 _).1 (V.mult_pos z hz).le
  · -- Step 8, (b): `1_{B_r(x)} θ ≤ h` a.e. on `M` when `φ = 1` on `B_1(0)`.
    intro hφ1
    rw [hJ]
    refine mul_le_mul_of_nonneg_left (setIntegral_mono_ae_restrict hind hh ?_) hrpos
    filter_upwards [hae] with z hz
    by_cases hzB : z ∈ closedBall x r
    · rw [indicator_of_mem hzB, hφ1 _ ((hmem z 1).2 (by rwa [mul_one])), one_mul]
    · rw [indicator_of_notMem hzB]
      exact mul_nonneg (hφ01 _).1 (V.mult_pos z hz).le
  · -- Step 9, (c): `h ≤ 1_{B_r(x)} θ` a.e. on `M` when `φ = 0` off `B_1(0)`.
    intro hφ0
    rw [hJ]
    refine mul_le_mul_of_nonneg_left (setIntegral_mono_ae_restrict hh hind ?_) hrpos
    filter_upwards [hae] with z hz
    by_cases hzB : z ∈ closedBall x r
    · rw [indicator_of_mem hzB]
      exact mul_le_of_le_one_left (V.mult_pos z hz).le (hφ01 _).2
    · rw [indicator_of_notMem hzB,
        hφ0 _ fun h => hzB (by simpa only [mul_one] using (hmem z 1).1 h), zero_mul]

/-- **Simon Ch. 3, Remark 1.8(2)** (weighted form) for `V = v(M, θ)`.  If `P` is the approximate
tangent space of `M` at `x ∈ U` with respect to `θ` (Ch. 3, Definition 1.7), then
`r⁻ⁿ ∫_{M ∩ B_r(x)} θ dHⁿ → ω_n θ(x)` as `r ↓ 0`.  For `ε ∈ (0, 1)` take continuous cut-offs
`g_ε ≤ 1_{B_1(0)} ≤ f_ε` with `g_ε = 1` on `B_{1−ε}(0)` and `f_ε = 0` off `B_{1+ε}(0)`; for small
`r`, `∫_{η_{x,r}(M)} g_ε θ(x + r·) dHⁿ ≤ r⁻ⁿ ∫_{M ∩ B_r(x)} θ dHⁿ ≤ ∫_{η_{x,r}(M)} f_ε θ(x + r·) dHⁿ`,
and the outer terms tend to `θ(x) ∫_P g_ε ≥ θ(x) ω_n (1 − ε)ⁿ` and `θ(x) ∫_P f_ε ≤ θ(x) ω_n (1 + ε)ⁿ`
(`θ(x) ≥ 0` follows from the lower comparison). -/
theorem rsod_tendsto_scaled_mult_integral : ∀ (n ℓ : ℕ), 1 ≤ n → ∀ (U : Set (Amb n ℓ)), IsOpen U → ∀ (V : RectifiableVarifold n ℓ U) (x : Amb n ℓ) (P : Submodule ℝ (Amb n ℓ)), x ∈ U → Poincare.SimonGMT.Chapter03.HasWeightedApproximateTangentSpaceAt n V.carrier V.mult x P → Tendsto (fun r : ℝ => (r ^ n)⁻¹ * ∫ z in V.carrier ∩ closedBall x r, V.mult z ∂(μHE[n] : Measure (Amb n ℓ))) (𝓝[>] 0) (𝓝 (unitBallVolume n * V.mult x)) := by
  intro n ℓ hn U hU V x P hx hP
  -- `ω_n = π^{n/2} / Γ(n/2 + 1) > 0`, and `B_{rR}(x) ⊆ B̆_e(x) ⊆ U` for `r < e / 2`, `R ≤ 2`.
  have hω : 0 < unitBallVolume n := by
    unfold unitBallVolume
    exact div_pos (Real.rpow_pos_of_pos Real.pi_pos _) (Real.Gamma_pos_of_pos (by positivity))
  obtain ⟨e, he, heU⟩ := Metric.isOpen_iff.1 hU x hx
  have hballU : ∀ r R : ℝ, 0 < r → r < e / 2 → R ≤ 2 → closedBall x (r * R) ⊆ U := by
    intro r R hr hre hR
    refine (closedBall_subset_ball ?_).trans heU
    calc r * R ≤ r * 2 := mul_le_mul_of_nonneg_left hR hr.le
      _ < e := by linarith
  -- Continuous compactly supported cut-offs: `0 ≤ φ ≤ 1`, `φ = 1` on `B_a(0)`, `φ = 0` off
  -- `B_b(0)`, namely `φ(y) = min 1 (max 0 ((b - ‖y‖) / (b - a)))`.
  have cutoff : ∀ a b : ℝ, a < b → ∃ φ : CompactlySupportedContinuousMap (Amb n ℓ) ℝ,
      (∀ y, 0 ≤ φ y ∧ φ y ≤ 1) ∧ (∀ y ∈ closedBall (0 : Amb n ℓ) a, φ y = 1) ∧
        ∀ y, y ∉ closedBall (0 : Amb n ℓ) b → φ y = 0 := by
    intro a b hab
    have hba : 0 < b - a := sub_pos.2 hab
    let φ : Amb n ℓ → ℝ := fun y => min 1 (max 0 ((b - ‖y‖) / (b - a)))
    have hφc : Continuous φ :=
      continuous_const.min (continuous_const.max ((continuous_const.sub continuous_norm).div_const _))
    have hφ0 : ∀ y, y ∉ closedBall (0 : Amb n ℓ) b → φ y = 0 := by
      intro y hy
      rw [mem_closedBall, dist_zero_right, not_le] at hy
      have hneg : (b - ‖y‖) / (b - a) ≤ 0 := div_nonpos_of_nonpos_of_nonneg (by linarith) hba.le
      show min 1 (max 0 ((b - ‖y‖) / (b - a))) = 0
      rw [max_eq_left hneg, min_eq_right zero_le_one]
    refine ⟨⟨⟨φ, hφc⟩, HasCompactSupport.intro (isCompact_closedBall 0 b) hφ0⟩,
      fun y => ⟨le_min zero_le_one (le_max_left _ _), min_le_left _ _⟩, fun y hy => ?_, hφ0⟩
    rw [mem_closedBall, dist_zero_right] at hy
    have hone : 1 ≤ (b - ‖y‖) / (b - a) := by
      rw [le_div_iff₀ hba]
      linarith
    show min 1 (max 0 ((b - ‖y‖) / (b - a))) = 1
    rw [max_eq_right (zero_le_one.trans hone), min_eq_left hone]
  -- Plane integrals: `Hⁿ ⌞ P (B_s(0)) = ω_n sⁿ` (sibling `plane_ball_measure`).
  have hPdim : Module.finrank ℝ P = n := hP.1
  have hplane_ind : ∀ s : ℝ, 0 ≤ s →
      Integrable ((closedBall (0 : Amb n ℓ) s).indicator fun _ => (1 : ℝ))
        ((μHE[n] : Measure (Amb n ℓ)).restrict (P : Set (Amb n ℓ))) ∧
      ∫ y, (closedBall (0 : Amb n ℓ) s).indicator (fun _ => (1 : ℝ)) y
          ∂((μHE[n] : Measure (Amb n ℓ)).restrict (P : Set (Amb n ℓ))) =
        unitBallVolume n * s ^ n := by
    intro s hs
    have hmeas := Submission.rsod_planeMeasure_closedBall n ℓ hn P hPdim s hs
    refine ⟨(integrable_indicator_iff measurableSet_closedBall).2
      (integrableOn_const (hmeas ▸ ENNReal.ofReal_ne_top)), ?_⟩
    rw [integral_indicator_const _ measurableSet_closedBall, smul_eq_mul, mul_one, measureReal_def,
      hmeas, ENNReal.toReal_ofReal (mul_nonneg hω.le (pow_nonneg hs n))]
  -- `0 ≤ φ ≤ 1_{B_b(0)}` gives `φ ∈ L¹(Hⁿ ⌞ P)` and `∫_P φ ≤ ω_n bⁿ`.
  have hplane_le : ∀ (φ : CompactlySupportedContinuousMap (Amb n ℓ) ℝ) (b : ℝ), 0 ≤ b →
      (∀ y, 0 ≤ φ y ∧ φ y ≤ 1) → (∀ y, y ∉ closedBall (0 : Amb n ℓ) b → φ y = 0) →
      Integrable φ ((μHE[n] : Measure (Amb n ℓ)).restrict (P : Set (Amb n ℓ))) ∧
        ∫ y in (P : Set (Amb n ℓ)), φ y ∂(μHE[n] : Measure (Amb n ℓ)) ≤
          unitBallVolume n * b ^ n := by
    intro φ b hb hφ01 hφ0
    obtain ⟨hint, hval⟩ := hplane_ind b hb
    have hle : ∀ y, φ y ≤ (closedBall (0 : Amb n ℓ) b).indicator (fun _ => (1 : ℝ)) y := by
      intro y
      by_cases hy : y ∈ closedBall (0 : Amb n ℓ) b
      · rw [Set.indicator_of_mem hy]
        exact (hφ01 y).2
      · rw [Set.indicator_of_notMem hy, hφ0 y hy]
    have hφint : Integrable φ ((μHE[n] : Measure (Amb n ℓ)).restrict (P : Set (Amb n ℓ))) :=
      hint.mono' (map_continuous φ).aestronglyMeasurable
        (Eventually.of_forall fun y => by rw [Real.norm_of_nonneg (hφ01 y).1]; exact hle y)
    exact ⟨hφint, (integral_mono hφint hint hle).trans_eq hval⟩
  -- `1_{B_a(0)} ≤ φ` (with `φ` as above) gives `ω_n aⁿ ≤ ∫_P φ`.
  have hplane_ge : ∀ (φ : CompactlySupportedContinuousMap (Amb n ℓ) ℝ) (a b : ℝ), 0 ≤ a →
      0 ≤ b → (∀ y, 0 ≤ φ y ∧ φ y ≤ 1) → (∀ y ∈ closedBall (0 : Amb n ℓ) a, φ y = 1) →
      (∀ y, y ∉ closedBall (0 : Amb n ℓ) b → φ y = 0) →
      unitBallVolume n * a ^ n ≤ ∫ y in (P : Set (Amb n ℓ)), φ y ∂(μHE[n] : Measure (Amb n ℓ)) := by
    intro φ a b ha hb hφ01 hφ1 hφ0
    obtain ⟨hint, hval⟩ := hplane_ind a ha
    have hle : ∀ y, (closedBall (0 : Amb n ℓ) a).indicator (fun _ => (1 : ℝ)) y ≤ φ y := by
      intro y
      by_cases hy : y ∈ closedBall (0 : Amb n ℓ) a
      · rw [Set.indicator_of_mem hy, hφ1 y hy]
      · rw [Set.indicator_of_notMem hy]
        exact (hφ01 y).1
    exact hval.symm.trans_le (integral_mono hint (hplane_le φ b hb hφ01 hφ0).1 hle)
  -- `θ(x) ≥ 0`: the blow-up integrals of `g = g_{1/2} ≥ 0` are `≥ 0` (sibling
  -- `blowup_ball_mass_bounds`) and tend to `θ(x) ∫_P g` with `∫_P g ≥ ω_n 2⁻ⁿ > 0`.
  have ht : 0 ≤ V.mult x := by
    obtain ⟨g, hg01, hg1, hg0⟩ := cutoff (1 / 2) 1 (by norm_num)
    have hpos : 0 < ∫ y in (P : Set (Amb n ℓ)), g y ∂(μHE[n] : Measure (Amb n ℓ)) :=
      (mul_pos hω (pow_pos (by norm_num) n)).trans_le
        (hplane_ge g (1 / 2) 1 (by norm_num) zero_le_one hg01 hg1 hg0)
    have hnonneg :
        0 ≤ V.mult x * ∫ y in (P : Set (Amb n ℓ)), g y ∂(μHE[n] : Measure (Amb n ℓ)) := by
      refine ge_of_tendsto (hP.2 g) ?_
      filter_upwards [Ioo_mem_nhdsGT (half_pos he)] with r hr
      exact (Submission.rsod_blowUp_integral_ballMass_bounds n ℓ U V x r 1 g hr.1 le_rfl
        (hballU r 1 hr.1 hr.2 one_le_two) (map_continuous g).measurable hg01 hg0).1
    exact nonneg_of_mul_nonneg_left hnonneg hpos
  refine tendsto_order.2 ⟨fun a ha => ?_, fun b hb => ?_⟩
  · -- Lower bound: pick `ε ∈ (0, 1)` with `a < θ(x) ω_n (1 - ε)ⁿ ≤ θ(x) ∫_P g_ε`.
    have hcont : Continuous fun ε : ℝ => V.mult x * (unitBallVolume n * (1 - ε) ^ n) := by
      fun_prop
    have hev : ∀ᶠ ε in 𝓝[>] (0 : ℝ), a < V.mult x * (unitBallVolume n * (1 - ε) ^ n) :=
      ((hcont.tendsto 0).mono_left nhdsWithin_le_nhds).eventually_const_lt
        (by simpa [mul_comm] using ha)
    obtain ⟨ε, hεa, hε⟩ :=
      (hev.and (Ioo_mem_nhdsGT one_pos : ∀ᶠ ε in 𝓝[>] (0 : ℝ), ε ∈ Ioo 0 1)).exists
    obtain ⟨g, hg01, hg1, hg0⟩ := cutoff (1 - ε) 1 (by linarith [hε.1])
    have hlt : a < V.mult x * ∫ y in (P : Set (Amb n ℓ)), g y ∂(μHE[n] : Measure (Amb n ℓ)) :=
      hεa.trans_le (mul_le_mul_of_nonneg_left
        (hplane_ge g (1 - ε) 1 (by linarith [hε.2]) zero_le_one hg01 hg1 hg0) ht)
    filter_upwards [(hP.2 g).eventually_const_lt hlt, Ioo_mem_nhdsGT (half_pos he)] with r hr hr'
    exact hr.trans_le ((Submission.rsod_blowUp_integral_ballMass_bounds n ℓ U V x r 1 g hr'.1
      le_rfl (hballU r 1 hr'.1 hr'.2 one_le_two) (map_continuous g).measurable hg01 hg0).2.2 hg0)
  · -- Upper bound: pick `ε ∈ (0, 1)` with `θ(x) ∫_P f_ε ≤ θ(x) ω_n (1 + ε)ⁿ < b`.
    have hcont : Continuous fun ε : ℝ => V.mult x * (unitBallVolume n * (1 + ε) ^ n) := by
      fun_prop
    have hev : ∀ᶠ ε in 𝓝[>] (0 : ℝ), V.mult x * (unitBallVolume n * (1 + ε) ^ n) < b :=
      ((hcont.tendsto 0).mono_left nhdsWithin_le_nhds).eventually_lt_const
        (by simpa [mul_comm] using hb)
    obtain ⟨ε, hεb, hε⟩ :=
      (hev.and (Ioo_mem_nhdsGT one_pos : ∀ᶠ ε in 𝓝[>] (0 : ℝ), ε ∈ Ioo 0 1)).exists
    obtain ⟨f, hf01, hf1, hf0⟩ := cutoff 1 (1 + ε) (by linarith [hε.1])
    have hlt : V.mult x * ∫ y in (P : Set (Amb n ℓ)), f y ∂(μHE[n] : Measure (Amb n ℓ)) < b :=
      (mul_le_mul_of_nonneg_left (hplane_le f (1 + ε) (by linarith [hε.1]) hf01 hf0).2
        ht).trans_lt hεb
    filter_upwards [(hP.2 f).eventually_lt_const hlt, Ioo_mem_nhdsGT (half_pos he)] with r hr hr'
    exact ((Submission.rsod_blowUp_integral_ballMass_bounds n ℓ U V x r (1 + ε) f hr'.1
      (by linarith [hε.1]) (hballU r (1 + ε) hr'.1 hr'.2 (by linarith [hε.2]))
      (map_continuous f).measurable hf01 hf0).2.1 hf1).trans_lt hr

/-- **Weight of a ball as an integral of the multiplicity** (Simon Ch. 4, 1.1).  If
`B_r(x) ⊆ U`, then `μ_V(B_r(x)) = ∫_{M ∩ B_r(x)} θ dHⁿ`.  By definition
`μ_V(B_r(x)) = ∫⁻_{M ∩ B_r(x)} θ dHⁿ`; as `B_r(x)` is compact, `θ` is `Hⁿ`-integrable on
`M ∩ B_r(x)`, and `θ > 0` on `M`, so this lower integral is the (real) integral. -/
theorem rsod_weight_closedBall_eq_ofReal_integral : ∀ (n ℓ : ℕ) (U : Set (Amb n ℓ)) (V : RectifiableVarifold n ℓ U) (x : Amb n ℓ) (r : ℝ), closedBall x r ⊆ U → V.weight (closedBall x r) = ENNReal.ofReal (∫ z in V.carrier ∩ closedBall x r, V.mult z ∂(μHE[n] : Measure (Amb n ℓ))) := by
  intro n ℓ U V x r hU
  -- `θ` is integrable on `M ∩ B_r(x)` (the closed ball is compact and lies in `U`) ...
  have hint : IntegrableOn V.mult (V.carrier ∩ closedBall x r) (μHE[n] : Measure (Amb n ℓ)) :=
    V.integrableOn_mult _ (isCompact_closedBall x r) hU
  -- ... and nonnegative a.e. there, since a.e. point of `M ∩ B_r(x)` lies in `M`.
  have hnn : 0 ≤ᵐ[(μHE[n] : Measure (Amb n ℓ)).restrict (V.carrier ∩ closedBall x r)] V.mult := by
    filter_upwards [ae_restrict_mem₀
      (V.nullMeasurableSet_carrier.inter measurableSet_closedBall.nullMeasurableSet)] with z hz
    exact (V.mult_pos z hz.1).le
  rw [RectifiableVarifold.weight, withDensity_apply _ measurableSet_closedBall,
    Measure.restrict_restrict measurableSet_closedBall, inter_comm (closedBall x r) V.carrier,
    ofReal_integral_eq_lintegral_ofReal hint.integrable hnn]

/-- **Simon Ch. 3, Lemma 1.2, Theorem 1.9 and Remark 1.8(2)** for `V = v(M, θ)` in the open set
`U`: for `μ_V`-a.e. `x`, `p_{T_x M}` is the orthogonal projection onto an `n`-dimensional subspace,
`x ↦ p_{T_x M}` is `μ_V`-a.e. strongly measurable, and `Θⁿ(μ_V, x) = θ(x)`.  The first two
assertions are `lgc_tangent_plane_ae`: `μ_V`-a.e. `x` has a weighted approximate tangent space `P`
(of dimension `n` by Definition 1.7) with `p_{T_x M} = p_P`.  For the density, `μ_V ≪ Hⁿ ⌞ M`, so
`μ_V`-a.e. such `x` also lies in `M ⊆ U`; for small `r > 0`, `B_r(x) ⊆ U` gives
`μ_V(B_r(x)) = ∫_{M ∩ B_r(x)} θ dHⁿ` (`rsod_weight_closedBall_eq_ofReal_integral`), and
`r⁻ⁿ ∫_{M ∩ B_r(x)} θ dHⁿ → ω_n θ(x)` (`rsod_tendsto_scaled_mult_integral`), so
`μ_V(B_r(x)) / (ω_n rⁿ) → θ(x)`. -/
theorem aal_tangent_structure : ∀ (n ℓ : ℕ), 1 ≤ n → ∀ (U : Set (Amb n ℓ)), IsOpen U → ∀ V : RectifiableVarifold n ℓ U, (∀ᵐ x ∂V.weight, ∃ P : Submodule ℝ (Amb n ℓ), Module.finrank ℝ P = n ∧ V.tangentProj x = P.starProjection) ∧ AEStronglyMeasurable V.tangentProj V.weight ∧ (∀ᵐ x ∂V.weight, V.HasDensity x (V.mult x)) := by
  intro n ℓ hn U hU V
  obtain ⟨hmeas, hae⟩ := Submission.lgc_tangent_plane_ae n ℓ hn U hU V
  refine ⟨?_, hmeas, ?_⟩
  · filter_upwards [hae] with x ⟨T, hT, hTp⟩
    exact ⟨T, hT.1, hTp⟩
  -- `μ_V`-a.e. point lies in `M`, since `μ_V ≪ Hⁿ ⌞ M`; and `ω_n > 0`.
  have hcar : ∀ᵐ x ∂V.weight, x ∈ V.carrier :=
    (withDensity_absolutelyContinuous _ _).ae_le (ae_restrict_mem₀ V.nullMeasurableSet_carrier)
  have hω : 0 < unitBallVolume n := by
    unfold unitBallVolume
    exact div_pos (Real.rpow_pos_of_pos Real.pi_pos _) (Real.Gamma_pos_of_pos (by positivity))
  filter_upwards [hae, hcar] with x ⟨T, hT, _⟩ hx
  obtain ⟨e, he, heU⟩ := Metric.isOpen_iff.1 hU x (V.carrier_subset hx)
  -- `ω_n⁻¹ (r⁻ⁿ ∫_{M ∩ B_r(x)} θ dHⁿ) → ω_n⁻¹ (ω_n θ(x)) = θ(x)`.
  have hlim := (Submission.rsod_tendsto_scaled_mult_integral n ℓ hn U hU V x T
    (V.carrier_subset hx) hT).const_mul (unitBallVolume n)⁻¹
  rw [inv_mul_cancel_left₀ hω.ne'] at hlim
  show Tendsto (fun r : ℝ => V.weight (closedBall x r) / ENNReal.ofReal (unitBallVolume n * r ^ n))
    (𝓝[>] 0) (𝓝 (ENNReal.ofReal (V.mult x)))
  refine (ENNReal.tendsto_ofReal hlim).congr' ?_
  -- For `0 < r < e`, `B_r(x) ⊆ U`, so `μ_V(B_r(x)) / (ω_n rⁿ)` is the real quotient above.
  filter_upwards [Ioo_mem_nhdsGT he] with r hr
  rw [Submission.rsod_weight_closedBall_eq_ofReal_integral n ℓ U V x r
      ((closedBall_subset_ball hr.2).trans heU),
    ← ENNReal.ofReal_div_of_pos (mul_pos hω (pow_pos hr.1 n))]
  congr 1
  ring

/-- **`Lᵖ` monotonicity identity** (Simon Ch. 4, 3.2–3.6 and 4.1–4.8, with the constant
`κ = (p − n)/(4p)` in front of `Λ`).  Let `p > n`, `B_S(y) ⊆ U`, `∫_{B_S(y)} |H|ᵖ dμ_V < ∞` and
`(R^{p−n} ∫_{B_R(y)} |H|ᵖ dμ_V)^{1/p} ≤ κ Λ` with `0 < R < S`, `Λ > 0`.  Then there are `F` with
`e^{−Λ} ≤ F(r) ≤ e^Λ` and `|F(r) − 1| ≤ ½ e^{Λ/2} Λ (r/R)^{1−n/p}` (`≤ Λ (r/R)^{1−n/p}` if `Λ ≤ 1`)
for `0 < r ≤ R`, and `G` with `e^{−Λ} ≤ G(s, r) ≤ e^Λ` and
`Φ(r) − Φ(s) = G(s, r) ∫_{B_r(y) \ B_s(y)} |p_x^⊥(x − y)|² / |x − y|^{n+2} dμ_V` for `0 < s ≤ r ≤ R`,
where `Φ(t) = F(t) t⁻ⁿ μ_V(B_t(y)) + F(t) − 1`.

By `aal_tangent_structure`, `p_x` is `μ_V`-a.e. a rank-`n` orthogonal projection and `x ↦ p_x` is
a.e. strongly measurable, so `w(x) = |p_x^⊥(x − y)|² / |x − y|²` is a.e. strongly measurable with
`0 ≤ w ≤ 1` a.e.  `μ_V(B_S(y)) < ∞` and `H ∈ L¹(B_S(y))` because `B_S(y)` is a compact subset of
`U`.  `aal_radial_first_variation_identity` gives the radial identity for every cutoff profile, and
`aal_monotonicity_of_radial_identity` then yields `F` together with
`e^{−Λ} A ≤ Φ(r) − Φ(s) ≤ e^Λ A`, `A = ∫_{B_r(y) \ B_s(y)} w / |x − y|ⁿ dμ_V`; here
`w / |x − y|ⁿ = |p_x^⊥(x − y)|² / |x − y|^{n+2}`.  Finally `G(s, r) = (Φ(r) − Φ(s)) / A`, or `1`
if `A = 0` (then the squeeze forces `Φ(r) = Φ(s)`). -/
theorem aal_lp_monotonicity : ∀ (n ℓ : ℕ), 1 ≤ n → ∀ p : ℝ, (n : ℝ) < p → ∀ (U : Set (Amb n ℓ)), IsOpen U → ∀ (V : RectifiableVarifold n ℓ U) (H : Amb n ℓ → Amb n ℓ), V.HasGeneralizedMeanCurvature H → ∀ (y : Amb n ℓ) (R S Λ : ℝ), 0 < R → R < S → 0 < Λ → closedBall y S ⊆ U → ∫⁻ x in closedBall y S, ‖H x‖ₑ ^ p ∂V.weight < ⊤ → V.scaledLpNorm H p y R ≤ ENNReal.ofReal ((p - n) / (4 * p) * Λ) → ∃ (F : ℝ → ℝ) (G : ℝ → ℝ → ℝ), (∀ r : ℝ, 0 < r → r ≤ R → Real.exp (-Λ) ≤ F r ∧ F r ≤ Real.exp Λ ∧ |F r - 1| ≤ Real.exp (Λ / 2) / 2 * Λ * (r / R) ^ (1 - (n : ℝ) / p) ∧ (Λ ≤ 1 → |F r - 1| ≤ Λ * (r / R) ^ (1 - (n : ℝ) / p))) ∧ (∀ s r : ℝ, 0 < s → s ≤ r → r ≤ R → Real.exp (-Λ) ≤ G s r ∧ G s r ≤ Real.exp Λ ∧ IntegrableOn (fun x => ‖(x - y) - V.tangentProj x (x - y)‖ ^ 2 / ‖x - y‖ ^ (n + 2)) (closedBall y r \ closedBall y s) V.weight ∧ (F r * ((V.weight (closedBall y r)).toReal / r ^ n) + (F r - 1)) - (F s * ((V.weight (closedBall y s)).toReal / s ^ n) + (F s - 1)) = G s r * ∫ x in closedBall y r \ closedBall y s, ‖(x - y) - V.tangentProj x (x - y)‖ ^ 2 / ‖x - y‖ ^ (n + 2) ∂V.weight) := by
  intro n ℓ hn p hp U hU V H hH y R S Λ hR hRS hΛ hBS hHp hK
  -- Step 0: `p_x` is a.e. a rank-`n` orthogonal projection, and `x ↦ p_x` is a.e. measurable.
  obtain ⟨hproj, hmeas, -⟩ := Submission.aal_tangent_structure n ℓ hn U hU V
  -- `μ_V(B_S(y)) = ∫_{M ∩ B_S(y)} θ dHⁿ < ∞` and `H ∈ L¹(B_S(y))`, as `B_S(y) ⊆ U` is compact.
  have hμS : V.weight (closedBall y S) < ⊤ := by
    have hint := V.integrableOn_mult (closedBall y S) (isCompact_closedBall y S) hBS
    rw [RectifiableVarifold.weight, withDensity_apply _ measurableSet_closedBall,
      Measure.restrict_restrict measurableSet_closedBall, inter_comm]
    exact hint.setLIntegral_lt_top
  have hHS : IntegrableOn H (closedBall y S) V.weight :=
    hH.1.integrableOn_compact_subset hBS (isCompact_closedBall y S)
  -- The weight `w(x) = |p_x^⊥(x − y)|² / |x − y|²` is a.e. strongly measurable, with `0 ≤ w ≤ 1`.
  have hTm : AEStronglyMeasurable (fun x => V.tangentProj x (x - y)) V.weight := by
    have happ : Continuous (Function.uncurry
        fun (A : Amb n ℓ →L[ℝ] Amb n ℓ) (v : Amb n ℓ) => A v) :=
      continuous_fst.clm_apply continuous_snd
    exact happ.comp_aestronglyMeasurable₂ hmeas (continuous_sub_right y).aestronglyMeasurable
  have hwm : AEStronglyMeasurable
      (fun x => ‖(x - y) - V.tangentProj x (x - y)‖ ^ 2 / ‖x - y‖ ^ 2) V.weight := by
    have h1 : AEStronglyMeasurable (fun x => ‖(x - y) - V.tangentProj x (x - y)‖ ^ 2)
        V.weight :=
      ((continuous_sub_right y).aestronglyMeasurable.sub hTm).norm.pow 2
    have h2 : AEStronglyMeasurable (fun x : Amb n ℓ => ‖x - y‖ ^ 2) V.weight :=
      ((continuous_sub_right y).norm.pow 2).aestronglyMeasurable
    exact (h1.aemeasurable.div h2.aemeasurable).aestronglyMeasurable
  have hw01 : ∀ᵐ x ∂V.weight, 0 ≤ ‖(x - y) - V.tangentProj x (x - y)‖ ^ 2 / ‖x - y‖ ^ 2 ∧
      ‖(x - y) - V.tangentProj x (x - y)‖ ^ 2 / ‖x - y‖ ^ 2 ≤ 1 := by
    filter_upwards [hproj] with x hx
    obtain ⟨P, -, hP⟩ := hx
    refine ⟨by positivity, div_le_one_of_le₀ ?_ (sq_nonneg _)⟩
    rw [hP, ← Submodule.starProjection_orthogonal_val]
    exact pow_le_pow_left₀ (norm_nonneg _) (Submodule.norm_starProjection_apply_le _ _) 2
  -- The radial first-variation identity for every cutoff profile with `B_{Tρ}(y) ⊆ B_S(y)`.
  have hrad : ∀ (φ : ℝ → ℝ) (T ρ : ℝ), ContDiff ℝ 1 φ → (∀ t : ℝ, t ≤ 1 → φ t = 1) →
      (∀ t : ℝ, T ≤ t → φ t = 0) → 0 < ρ → T * ρ ≤ S →
      ∫ x, ((n : ℝ) * φ (‖x - y‖ / ρ) + ‖x - y‖ / ρ * deriv φ (‖x - y‖ / ρ) *
        (1 - ‖(x - y) - V.tangentProj x (x - y)‖ ^ 2 / ‖x - y‖ ^ 2)) ∂V.weight =
      -∫ x, φ (‖x - y‖ / ρ) * inner ℝ (x - y) (H x) ∂V.weight :=
    fun φ T ρ hφ h1 h0 hρ hTρ =>
      Submission.aal_radial_first_variation_identity n ℓ U V H hH hproj y φ T ρ hφ h1 h0 hρ
        ((closedBall_subset_closedBall hTρ).trans hBS)
  -- The monotonicity squeeze for the abstract weight `w`.
  obtain ⟨F, hF1, hF2⟩ := Submission.aal_monotonicity_of_radial_identity n ℓ hn p hp V.weight H
    (fun x => ‖(x - y) - V.tangentProj x (x - y)‖ ^ 2 / ‖x - y‖ ^ 2) y R S Λ hR hRS hΛ hμS hwm
    hw01 hHS hHp hK hrad
  -- `g_y = w / |x − y|ⁿ` (also at `x = y`, where both sides vanish).
  have hg : (fun x => ‖(x - y) - V.tangentProj x (x - y)‖ ^ 2 / ‖x - y‖ ^ (n + 2)) =
      fun x => ‖(x - y) - V.tangentProj x (x - y)‖ ^ 2 / ‖x - y‖ ^ 2 / ‖x - y‖ ^ n := by
    funext x
    rw [div_div, ← pow_add, add_comm 2 n]
  -- A two-sided squeeze `e^{−Λ} A ≤ D ≤ e^Λ A` gives the ratio `G = D / A` (`1` if `A = 0`).
  have hratio : ∀ A D : ℝ, Real.exp (-Λ) * A ≤ D → D ≤ Real.exp Λ * A →
      Real.exp (-Λ) ≤ (if A = 0 then 1 else D / A) ∧ (if A = 0 then 1 else D / A) ≤ Real.exp Λ ∧
        D = (if A = 0 then 1 else D / A) * A := by
    intro A D hlo hhi
    have hexp : Real.exp (-Λ) < Real.exp Λ := Real.exp_lt_exp.2 (by linarith)
    split_ifs with h0
    · subst h0
      rw [mul_zero] at hlo hhi
      exact ⟨Real.exp_le_one_iff.2 (by linarith), Real.one_le_exp hΛ.le, by linarith⟩
    · have hA : 0 < A := by
        rcases lt_or_gt_of_ne h0 with h | h
        · nlinarith
        · exact h
      exact ⟨(le_div_iff₀ hA).2 hlo, (div_le_iff₀ hA).2 hhi, (div_mul_cancel₀ D h0).symm⟩
  refine ⟨F, fun s r =>
    if (∫ x in closedBall y r \ closedBall y s,
        ‖(x - y) - V.tangentProj x (x - y)‖ ^ 2 / ‖x - y‖ ^ (n + 2) ∂V.weight) = 0 then 1
    else ((F r * ((V.weight (closedBall y r)).toReal / r ^ n) + (F r - 1)) -
        (F s * ((V.weight (closedBall y s)).toReal / s ^ n) + (F s - 1))) /
      ∫ x in closedBall y r \ closedBall y s,
        ‖(x - y) - V.tangentProj x (x - y)‖ ^ 2 / ‖x - y‖ ^ (n + 2) ∂V.weight, hF1, ?_⟩
  intro s r hs hsr hrR
  obtain ⟨hint, hlo, hhi⟩ := hF2 s r hs hsr hrR
  have hlo' : Real.exp (-Λ) * ∫ x in closedBall y r \ closedBall y s,
        ‖(x - y) - V.tangentProj x (x - y)‖ ^ 2 / ‖x - y‖ ^ (n + 2) ∂V.weight ≤
      (F r * ((V.weight (closedBall y r)).toReal / r ^ n) + (F r - 1)) -
        (F s * ((V.weight (closedBall y s)).toReal / s ^ n) + (F s - 1)) := by
    rw [hg]
    exact hlo
  have hhi' : (F r * ((V.weight (closedBall y r)).toReal / r ^ n) + (F r - 1)) -
        (F s * ((V.weight (closedBall y s)).toReal / s ^ n) + (F s - 1)) ≤
      Real.exp Λ * ∫ x in closedBall y r \ closedBall y s,
        ‖(x - y) - V.tangentProj x (x - y)‖ ^ 2 / ‖x - y‖ ^ (n + 2) ∂V.weight := by
    rw [hg]
    exact hhi
  obtain ⟨hG1, hG2, hG3⟩ := hratio _ _ hlo' hhi'
  refine ⟨hG1, hG2, ?_, hG3⟩
  rw [hg]
  exact hint

/-- **Uniform mass upper bound** (step 1a of the proof of Simon 2.5, valid for every
`δ ∈ (0, 1/4]`): under 2.3, `μ_V(B_s(y)) ≤ C₀ ω_n sⁿ` whenever `|y| ≤ ρ/4` and `s ∈ (0, ρ/2]`,
with `C₀ = e^{2Λ₁}((3/2)ⁿ(5/4) + e^{Λ₁/2}Λ₁/ω_n)` and `Λ₁ = p/(p − n)`.
For `κ = (p − n)/(4p)` and `Λ = δ/κ ≤ Λ₁`, `aal_lp_monotonicity` at `y` with `R = 2ρ/3`,
`S = 3ρ/4` (so `B_S(y) ⊆ B_ρ(0)` and, for `K(z, t) = V.scaledLpNorm H p z t`,
`K(y, R) ≤ K(0, ρ) ≤ δ = κΛ`) gives `Φ(s) ≤ Φ(R)` for
`Φ(t) = F(t) t⁻ⁿ μ(B_t(y)) + F(t) − 1`.  Then `e^{−Λ} ≤ F ≤ e^Λ`, `|F − 1| ≤ e^{Λ/2}Λ/2` and
`μ(B_R(y)) ≤ μ(B_ρ(0)) ≤ (5/4) ω_n ρⁿ` give
`s⁻ⁿ μ(B_s(y)) ≤ e^{2Λ}(3/2)ⁿ(5/4) ω_n + e^{3Λ/2}Λ ≤ C₀ ω_n`. -/
theorem aal_mass_upper_bound : ∀ (n ℓ : ℕ), 1 ≤ n → ∀ p : ℝ, (n : ℝ) < p → ∃ C₀ : ℝ, 0 < C₀ ∧
    ∀ (U : Set (Amb n ℓ)), IsOpen U → ∀ (V : RectifiableVarifold n ℓ U) (H : Amb n ℓ → Amb n ℓ)
    (δ ρ : ℝ), 0 < δ → δ ≤ 1 / 4 → V.AllardHypotheses H p δ ρ → ∀ y : Amb n ℓ, ‖y‖ ≤ ρ / 4 →
    ∀ s : ℝ, 0 < s → s ≤ ρ / 2 →
      V.weight (closedBall y s) ≤ ENNReal.ofReal (C₀ * (unitBallVolume n * s ^ n)) := by
  intro n ℓ hn p hp
  have hn1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have hp0 : 0 < p := by linarith
  have hpn : 0 < p - n := sub_pos.2 hp
  have hω : 0 < unitBallVolume n :=
    div_pos (Real.rpow_pos_of_pos Real.pi_pos _) (Real.Gamma_pos_of_pos (by positivity))
  -- Step 1: the constants `Λ₁ = (1/4)/κ = p/(p − n)` and `C₀`.
  obtain ⟨Λ₁, hΛ₁_def⟩ : ∃ Λ₁ : ℝ, Λ₁ = p / (p - n) := ⟨_, rfl⟩
  have hΛ₁ : 0 < Λ₁ := by rw [hΛ₁_def]; exact div_pos hp0 hpn
  obtain ⟨C₀, hC₀_def⟩ : ∃ C₀ : ℝ, C₀ = Real.exp (2 * Λ₁) *
      ((3 / 2) ^ n * (5 / 4) + Real.exp (Λ₁ / 2) * Λ₁ / unitBallVolume n) := ⟨_, rfl⟩
  have hC₀ : 0 < C₀ := by rw [hC₀_def]; positivity
  refine ⟨C₀, hC₀, ?_⟩
  intro U hU V H δ ρ hδ hδ4 hA y hy s hs hsρ
  obtain ⟨hρ, hH, -, -, hBU, hmass, hK⟩ := hA
  -- Step 2: `Λ = δ/κ ∈ (0, Λ₁]` for `κ = (p − n)/(4p)`, and the radii `R = 2ρ/3 < S = 3ρ/4`.
  obtain ⟨Λ, hΛ_def⟩ : ∃ Λ : ℝ, Λ = 4 * p * δ / (p - n) := ⟨_, rfl⟩
  have hΛ : 0 < Λ := by rw [hΛ_def]; exact div_pos (by positivity) hpn
  have hΛΛ₁ : Λ ≤ Λ₁ := by
    rw [hΛ_def, hΛ₁_def]
    exact div_le_div_of_nonneg_right (by nlinarith) hpn.le
  have hκΛ : (p - n) / (4 * p) * Λ = δ := by
    rw [hΛ_def]
    field_simp
  obtain ⟨R, hR_def⟩ : ∃ R : ℝ, R = 2 * ρ / 3 := ⟨_, rfl⟩
  obtain ⟨S, hS_def⟩ : ∃ S : ℝ, S = 3 * ρ / 4 := ⟨_, rfl⟩
  have hR : 0 < R := by rw [hR_def]; positivity
  have hRS : R < S := by rw [hR_def, hS_def]; linarith
  have hRρ : R ≤ ρ := by rw [hR_def]; linarith
  have hsR : s ≤ R := by rw [hR_def]; linarith
  -- `B_t(y) ⊆ B_ρ(0)` for `t ≤ S`, since `|y| ≤ ρ/4`; in particular `B_S(y) ⊆ U`.
  have hball : ∀ t : ℝ, t ≤ S → closedBall y t ⊆ closedBall (0 : Amb n ℓ) ρ := by
    intro t ht
    refine closedBall_subset_closedBall' ?_
    rw [dist_zero_right]
    rw [hS_def] at ht
    linarith
  have hSU : closedBall y S ⊆ U := (hball S le_rfl).trans hBU
  -- (A): `∫_{B_ρ(0)} |H|ᵖ dμ < ∞`, since `ρ^{p−n} > 0` and `K(0, ρ) ≤ δ < ∞`.
  have hI : ∫⁻ x in closedBall (0 : Amb n ℓ) ρ, ‖H x‖ₑ ^ p ∂V.weight < ⊤ := by
    have h1 := hK.trans_lt ENNReal.ofReal_lt_top
    rw [RectifiableVarifold.scaledLpNorm,
      ENNReal.rpow_lt_top_iff_of_pos (by positivity : (0 : ℝ) < 1 / p)] at h1
    rcases ENNReal.mul_lt_top_iff.1 h1 with h | h | h
    · exact h.2
    · exact absurd h (ENNReal.ofReal_pos.2 (Real.rpow_pos_of_pos hρ _)).ne'
    · rw [h]
      exact ENNReal.zero_lt_top
  have hIS : ∫⁻ x in closedBall y S, ‖H x‖ₑ ^ p ∂V.weight < ⊤ :=
    (lintegral_mono_set (hball S le_rfl)).trans_lt hI
  -- (K-mono): `K(y, R) ≤ K(0, ρ) ≤ δ = κΛ`.
  have hKR : V.scaledLpNorm H p y R ≤ ENNReal.ofReal ((p - n) / (4 * p) * Λ) := by
    rw [hκΛ]
    refine le_trans ?_ hK
    unfold RectifiableVarifold.scaledLpNorm
    refine ENNReal.rpow_le_rpow (mul_le_mul' (ENNReal.ofReal_le_ofReal ?_)
      (lintegral_mono_set (hball R hRS.le))) (by positivity)
    exact Real.rpow_le_rpow hR.le hRρ hpn.le
  -- Step 3: the `Lᵖ` monotonicity identity at `y`, between the radii `s ≤ R`.
  obtain ⟨F, G, hF, hG⟩ := Submission.aal_lp_monotonicity n ℓ hn p hp U hU V H hH y R S Λ hR hRS
    hΛ hSU hIS hKR
  obtain ⟨hFs, -, -, -⟩ := hF s hs hsR
  obtain ⟨-, hFR, -, -⟩ := hF R hR le_rfl
  obtain ⟨hGs, -, -, hid⟩ := hG s R hs hsR le_rfl
  -- `|F(t) − 1| ≤ e^{Λ/2}Λ/2` on `(0, R]`, because `(t/R)^{1−n/p} ≤ 1`.
  have hexp : 0 ≤ 1 - (n : ℝ) / p := by
    rw [sub_nonneg, div_le_one hp0]
    exact hp.le
  have herr : ∀ t : ℝ, 0 < t → t ≤ R → |F t - 1| ≤ Real.exp (Λ / 2) * Λ / 2 := by
    intro t ht htR
    have h1 : (t / R) ^ (1 - (n : ℝ) / p) ≤ 1 :=
      Real.rpow_le_one (div_nonneg ht.le hR.le) ((div_le_one hR).2 htR) hexp
    calc |F t - 1| ≤ Real.exp (Λ / 2) / 2 * Λ * (t / R) ^ (1 - (n : ℝ) / p) :=
          (hF t ht htR).2.2.1
      _ ≤ Real.exp (Λ / 2) / 2 * Λ * 1 := mul_le_mul_of_nonneg_left h1 (by positivity)
      _ = Real.exp (Λ / 2) * Λ / 2 := by ring
  obtain ⟨hR1, hR2⟩ := abs_le.1 (herr R hR le_rfl)
  obtain ⟨hs1, hs2⟩ := abs_le.1 (herr s hs hsR)
  -- `Φ(s) ≤ Φ(R)`: the annular integral is nonnegative and `G(s, R) ≥ e^{−Λ} > 0`.
  have hint : 0 ≤ ∫ x in closedBall y R \ closedBall y s,
      ‖(x - y) - V.tangentProj x (x - y)‖ ^ 2 / ‖x - y‖ ^ (n + 2) ∂V.weight :=
    integral_nonneg fun x => div_nonneg (sq_nonneg _) (pow_nonneg (norm_nonneg _) _)
  have hGI := mul_nonneg ((Real.exp_pos (-Λ)).le.trans hGs) hint
  -- Step 4: `R⁻ⁿ μ(B_R(y)) ≤ (5/4) ω_n (3/2)ⁿ`, from `μ(B_R(y)) ≤ μ(B_ρ(0)) ≤ (1 + δ) ω_n ρⁿ`.
  have hmass_le : ∀ t : ℝ, t ≤ S →
      V.weight (closedBall y t) ≤ ENNReal.ofReal ((1 + δ) * (unitBallVolume n * ρ ^ n)) :=
    fun t ht => (measure_mono (hball t ht)).trans hmass
  have h32 : (3 / 2) ^ n * R ^ n = ρ ^ n := by
    rw [← mul_pow, hR_def]
    congr 1
    ring
  have hqR0 : 0 ≤ (V.weight (closedBall y R)).toReal / R ^ n :=
    div_nonneg ENNReal.toReal_nonneg (pow_pos hR n).le
  have hqs0 : 0 ≤ (V.weight (closedBall y s)).toReal / s ^ n :=
    div_nonneg ENNReal.toReal_nonneg (pow_pos hs n).le
  have hqR : (V.weight (closedBall y R)).toReal / R ^ n ≤
      5 / 4 * unitBallVolume n * (3 / 2) ^ n := by
    have h1 := ENNReal.toReal_le_of_le_ofReal (by positivity) (hmass_le R hRS.le)
    rw [div_le_iff₀ (pow_pos hR n)]
    calc (V.weight (closedBall y R)).toReal ≤ (1 + δ) * (unitBallVolume n * ρ ^ n) := h1
      _ ≤ 5 / 4 * (unitBallVolume n * ρ ^ n) := by gcongr; linarith
      _ = 5 / 4 * unitBallVolume n * ((3 / 2) ^ n * R ^ n) := by rw [h32]; ring
      _ = 5 / 4 * unitBallVolume n * (3 / 2) ^ n * R ^ n := by ring
  -- `F(s) s⁻ⁿ μ(B_s(y)) ≤ Φ(R) + |F(s) − 1| ≤ e^Λ R⁻ⁿ μ(B_R(y)) + e^{Λ/2}Λ`.
  have hFq : F s * ((V.weight (closedBall y s)).toReal / s ^ n) ≤
      Real.exp Λ * (5 / 4 * unitBallVolume n * (3 / 2) ^ n) + Real.exp (Λ / 2) * Λ := by
    have h1 : F R * ((V.weight (closedBall y R)).toReal / R ^ n) ≤
        Real.exp Λ * (5 / 4 * unitBallVolume n * (3 / 2) ^ n) :=
      mul_le_mul hFR hqR hqR0 (Real.exp_pos Λ).le
    linarith
  -- Divide by `F(s) ≥ e^{−Λ}`.
  have hq : (V.weight (closedBall y s)).toReal / s ^ n ≤ Real.exp Λ *
      (Real.exp Λ * (5 / 4 * unitBallVolume n * (3 / 2) ^ n) + Real.exp (Λ / 2) * Λ) := by
    calc (V.weight (closedBall y s)).toReal / s ^ n
        = Real.exp Λ * (Real.exp (-Λ) * ((V.weight (closedBall y s)).toReal / s ^ n)) := by
          rw [← mul_assoc, ← Real.exp_add, add_neg_cancel, Real.exp_zero, one_mul]
      _ ≤ Real.exp Λ * (F s * ((V.weight (closedBall y s)).toReal / s ^ n)) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hFs hqs0) (Real.exp_pos Λ).le
      _ ≤ _ := mul_le_mul_of_nonneg_left hFq (Real.exp_pos Λ).le
  -- `e^{2Λ}(3/2)ⁿ(5/4) ω_n + e^{3Λ/2}Λ ≤ C₀ ω_n`, using `Λ ≤ Λ₁`.
  have hC : Real.exp Λ *
      (Real.exp Λ * (5 / 4 * unitBallVolume n * (3 / 2) ^ n) + Real.exp (Λ / 2) * Λ) ≤
        C₀ * unitBallVolume n := by
    have e1 : Real.exp Λ * Real.exp Λ ≤ Real.exp (2 * Λ₁) := by
      rw [← Real.exp_add]
      exact Real.exp_le_exp.2 (by linarith)
    have e2 : Real.exp Λ * Real.exp (Λ / 2) ≤ Real.exp (2 * Λ₁) * Real.exp (Λ₁ / 2) := by
      rw [← Real.exp_add, ← Real.exp_add]
      exact Real.exp_le_exp.2 (by linarith)
    have hX : 0 ≤ 5 / 4 * unitBallVolume n * (3 / 2) ^ n := by positivity
    calc Real.exp Λ *
          (Real.exp Λ * (5 / 4 * unitBallVolume n * (3 / 2) ^ n) + Real.exp (Λ / 2) * Λ)
        = Real.exp Λ * Real.exp Λ * (5 / 4 * unitBallVolume n * (3 / 2) ^ n) +
            Real.exp Λ * Real.exp (Λ / 2) * Λ := by ring
      _ ≤ Real.exp (2 * Λ₁) * (5 / 4 * unitBallVolume n * (3 / 2) ^ n) +
            Real.exp (2 * Λ₁) * Real.exp (Λ₁ / 2) * Λ₁ :=
          add_le_add (mul_le_mul_of_nonneg_right e1 hX)
            (mul_le_mul e2 hΛΛ₁ hΛ.le (by positivity))
      _ = C₀ * unitBallVolume n := by
          rw [hC₀_def]
          field_simp
  -- Conclusion: `μ(B_s(y)).toReal ≤ C₀ ω_n sⁿ`, and `μ(B_s(y)) < ∞`.
  have hms : (V.weight (closedBall y s)).toReal ≤ C₀ * (unitBallVolume n * s ^ n) := by
    have h1 := hq.trans hC
    rw [div_le_iff₀ (pow_pos hs n)] at h1
    calc (V.weight (closedBall y s)).toReal ≤ C₀ * unitBallVolume n * s ^ n := h1
      _ = C₀ * (unitBallVolume n * s ^ n) := mul_assoc _ _ _
  have hfin : V.weight (closedBall y s) ≠ ⊤ :=
    ne_top_of_le_ne_top ENNReal.ofReal_ne_top (hmass_le s (by rw [hS_def]; linarith))
  exact (ENNReal.le_ofReal_iff_toReal_le hfin (by positivity)).2 hms

/-- Simon Ch. 5, proof of Lemma 2.1 (pp. 107–108), kept in `L¹` form (Lemma A in the proof of the
Affine Approximation Lemma 2.5): if `dist(x − z, T) ≤ h` for every `x ∈ spt V ∩ B_r(z)`, then
`∫_{B_{r/2}(z)} |p_{T_x M} − p_T|² dμ_V
   ≤ 144 r⁻² ∫_{B_r(z)} dist(x − z, T)² dμ_V + 4 h ∫_{B_r(z)} |H| dμ_V`.
Test the first variation with `X = ζ² x'`, `x' = p_{T⊥}(x − z)`, `ζ` the cutoff of
`aal_l1th_exists_cutoff`; absorb the gradient term by `2ab ≤ a²/4 + 4b²`, and bound the
mean-curvature term by `|x'| ≤ h` instead of Cauchy–Schwarz (so neither `|H|²` nor a lower bound on
`θ` is needed). -/
theorem aal_l1_tilt_height : ∀ (n ℓ : ℕ), 1 ≤ n → ∀ (U : Set (Amb n ℓ)), IsOpen U → ∀ (V : RectifiableVarifold n ℓ U) (H : Amb n ℓ → Amb n ℓ), V.HasGeneralizedMeanCurvature H → ∀ (z : Amb n ℓ) (r h : ℝ), 0 < r → closedBall z r ⊆ U → 0 ≤ h → ∀ T : Submodule ℝ (Amb n ℓ), Module.finrank ℝ T = n → (∀ x ∈ V.support ∩ closedBall z r, infDist (x - z) (T : Set (Amb n ℓ)) ≤ h) → ∫ x in closedBall z (r / 2), hsNormSq (V.tangentProj x - T.starProjection) ∂V.weight ≤ 144 * (r ^ 2)⁻¹ * ∫ x in closedBall z r, infDist (x - z) (T : Set (Amb n ℓ)) ^ 2 ∂V.weight + 4 * h * ∫ x in closedBall z r, ‖H x‖ ∂V.weight := by
  intro n ℓ hn U hU V H hH z r h hr hBU hh T hT hheight
  -- Step 0: `p_x` is a rank-`n` orthogonal projection `μ`-a.e., and `x ↦ p_x` is measurable.
  obtain ⟨hae, hmeas, -⟩ := Submission.aal_tangent_structure n ℓ hn U hU V
  -- Step 1: the cutoff: `ζ = 1` on `B_{r/2}(z)`, `ζ = 0` where `|x - z| ≥ r`, `|Dζ| ≤ 3/r`.
  obtain ⟨ζ, hζC1, hζ01, hζ1, hζ0, hζd⟩ : ∃ ζ : Amb n ℓ → ℝ, ContDiff ℝ 1 ζ ∧
      (∀ x, 0 ≤ ζ x ∧ ζ x ≤ 1) ∧ (∀ x ∈ closedBall z (r / 2), ζ x = 1) ∧
      (∀ x, r ≤ dist x z → ζ x = 0) ∧ ∀ x, ‖fderiv ℝ ζ x‖ ≤ 3 / r :=
    Submission.aal_l1th_exists_cutoff (n + ℓ) z r hr
  -- Step 0: `μ(B_r(z)) < ∞` since `θ` is locally integrable, and `μ`-a.e. point lies in `spt V`.
  have hμB : V.weight (closedBall z r) < ∞ := by
    have hint := V.integrableOn_mult _ (isCompact_closedBall z r) hBU
    rw [RectifiableVarifold.weight, withDensity_apply _ measurableSet_closedBall,
      Measure.restrict_restrict measurableSet_closedBall, inter_comm]
    exact hint.lintegral_lt_top
  have : IsFiniteMeasure (V.weight.restrict (closedBall z r)) :=
    isFiniteMeasure_restrict.2 hμB.ne
  have hsupp : ∀ᵐ x ∂V.weight, x ∈ V.support := by
    have hUc : V.weight Uᶜ = 0 := by
      rw [RectifiableVarifold.weight, withDensity_apply _ hU.isClosed_compl.measurableSet,
        Measure.restrict_restrict hU.isClosed_compl.measurableSet]
      have hempty : Uᶜ ∩ V.carrier = ∅ := by
        ext x
        simp only [mem_inter_iff, mem_compl_iff, mem_empty_iff_false, iff_false, not_and]
        exact fun hxU hxM => hxU (V.carrier_subset hxM)
      rw [hempty, Measure.restrict_empty, lintegral_zero_measure]
    have hUae : ∀ᵐ x ∂V.weight, x ∈ U := by
      rw [ae_iff]
      simpa [compl_def] using hUc
    filter_upwards [hUae, Measure.support_mem_ae (μ := V.weight)] with x hx1 hx2
    exact ⟨hx1, hx2⟩
  -- Linear algebra: `‖A‖ ≤ |A|` (child `aal_l1th_projection_algebra`), `|p_{T⊥} v| = dist(v, T)`.
  have hopHS : ∀ A : Amb n ℓ →L[ℝ] Amb n ℓ, ‖A‖ ≤ hsNorm A := fun A =>
    Submission.aal_l1th_projection_algebra.1 (n + ℓ) (n + ℓ) A
  have hperp : ∀ v : Amb n ℓ, ‖Tᗮ.starProjection v‖ = infDist v (T : Set (Amb n ℓ)) := by
    intro v
    rw [Submodule.starProjection_orthogonal_val, ← dist_eq_norm,
      Submodule.dist_starProjection_eq_infDist]
  -- Notation: `g = |p_x - p_T|² = 2s`, `w = x' = p_{T⊥}(x - z)`, the gradient term `b`, and the
  -- test field `X = ζ² x'`.
  obtain ⟨g, hg⟩ : ∃ g : Amb n ℓ → ℝ, ∀ x, g x = hsNormSq (V.tangentProj x - T.starProjection) :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨w, hw⟩ : ∃ w : Amb n ℓ → Amb n ℓ, ∀ x, w x = Tᗮ.starProjection (x - z) :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨b, hb⟩ : ∃ b : Amb n ℓ → ℝ,
      ∀ x, b x = 2 * ζ x * fderiv ℝ ζ x ((V.tangentProj x - T.starProjection) (w x)) :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨X, hX⟩ : ∃ X : Amb n ℓ → Amb n ℓ, ∀ x, X x = ζ x ^ 2 • w x := ⟨_, fun _ => rfl⟩
  have hXeq : X = fun y => ζ y ^ 2 • Tᗮ.starProjection (y - z) := funext fun y => by rw [hX, hw]
  -- Pointwise bounds: `0 ≤ ζ² ≤ 1`, `|x'| ≤ r` on `B_r(z)`, `‖p_x - p_T‖ ≤ 2`, `0 ≤ g ≤ 4(n + ℓ)`.
  have hζcont : Continuous ζ := hζC1.continuous
  have hDζcont : Continuous (fderiv ℝ ζ) := hζC1.continuous_fderiv one_ne_zero
  have hwcont : Continuous w := by
    rw [show w = fun x => Tᗮ.starProjection (x - z) from funext hw]
    fun_prop
  have hXcont : Continuous X := by
    rw [show X = fun x => ζ x ^ 2 • w x from funext hX]
    exact (hζcont.pow 2).smul hwcont
  have hζout : ∀ x, x ∉ closedBall z r → ζ x = 0 := fun x hx =>
    hζ0 x (not_le.1 fun h' => hx (mem_closedBall.2 h')).le
  have hζsq : ∀ x, ζ x ^ 2 ≤ 1 := fun x => by
    obtain ⟨hz0, hz1⟩ := hζ01 x
    nlinarith
  have hw_le : ∀ x, ‖w x‖ ≤ ‖x - z‖ := by
    intro x
    rw [hw]
    calc ‖Tᗮ.starProjection (x - z)‖ ≤ ‖Tᗮ.starProjection‖ * ‖x - z‖ :=
          ContinuousLinearMap.le_opNorm _ _
      _ ≤ 1 * ‖x - z‖ := by gcongr; exact Submodule.starProjection_norm_le _
      _ = ‖x - z‖ := one_mul _
  have hwB : ∀ x ∈ closedBall z r, ‖w x‖ ≤ r := fun x hx =>
    (hw_le x).trans (by rw [← dist_eq_norm]; exact mem_closedBall.1 hx)
  have hPnorm : ∀ x, ‖V.tangentProj x‖ ≤ 1 := by
    intro x
    unfold RectifiableVarifold.tangentProj
    split_ifs
    · exact Submodule.starProjection_norm_le _
    · simp
  have hA2 : ∀ x, ‖V.tangentProj x - T.starProjection‖ ≤ 2 := fun x =>
    (norm_sub_le _ _).trans (by linarith [hPnorm x, Submodule.starProjection_norm_le T])
  have hhs0 : ∀ A : Amb n ℓ →L[ℝ] Amb n ℓ, 0 ≤ hsNormSq A := fun A => by
    unfold hsNormSq
    positivity
  have hhs_le : ∀ A : Amb n ℓ →L[ℝ] Amb n ℓ, hsNormSq A ≤ (n + ℓ : ℕ) * ‖A‖ ^ 2 := by
    intro A
    unfold hsNormSq
    calc ∑ i : Fin (n + ℓ), ‖A (EuclideanSpace.single i 1)‖ ^ 2
        ≤ ∑ _i : Fin (n + ℓ), ‖A‖ ^ 2 := by
          gcongr with i
          calc ‖A (EuclideanSpace.single i 1)‖ ≤ ‖A‖ * ‖EuclideanSpace.single i (1 : ℝ)‖ :=
                A.le_opNorm _
            _ = ‖A‖ := by simp
      _ = (n + ℓ : ℕ) * ‖A‖ ^ 2 := by simp
  have hg0 : ∀ x, 0 ≤ g x := fun x => by rw [hg]; exact hhs0 _
  have hgle : ∀ x, g x ≤ (n + ℓ : ℕ) * 4 := fun x => by
    rw [hg]
    refine (hhs_le _).trans ?_
    gcongr
    nlinarith [hA2 x, norm_nonneg (V.tangentProj x - T.starProjection)]
  -- Measurability on `B_r(z)`, from the a.e. strong measurability of `x ↦ p_x`.
  have hPm : AEStronglyMeasurable (fun x => V.tangentProj x - T.starProjection)
      (V.weight.restrict (closedBall z r)) :=
    hmeas.restrict.sub aestronglyMeasurable_const
  have hgm : AEStronglyMeasurable g (V.weight.restrict (closedBall z r)) := by
    rw [show g = fun x => hsNormSq (V.tangentProj x - T.starProjection) from funext hg]
    have hcont : Continuous fun A : Amb n ℓ →L[ℝ] Amb n ℓ => hsNormSq A := by
      unfold hsNormSq
      exact continuous_finsetSum _ fun i _ =>
        ((continuous_id.clm_apply continuous_const).norm).pow 2
    exact hcont.comp_aestronglyMeasurable hPm
  have hbm : AEStronglyMeasurable b (V.weight.restrict (closedBall z r)) := by
    rw [show b = fun x => 2 * ζ x * fderiv ℝ ζ x ((V.tangentProj x - T.starProjection) (w x))
      from funext hb]
    have happ : Continuous (Function.uncurry
        fun (A : Amb n ℓ →L[ℝ] Amb n ℓ) (v : Amb n ℓ) => A v) :=
      continuous_fst.clm_apply continuous_snd
    have happ' : Continuous (Function.uncurry
        fun (L : Amb n ℓ →L[ℝ] ℝ) (v : Amb n ℓ) => L v) :=
      continuous_fst.clm_apply continuous_snd
    exact (continuous_const.mul hζcont).aestronglyMeasurable.mul
      (happ'.comp_aestronglyMeasurable₂ hDζcont.aestronglyMeasurable
        (happ.comp_aestronglyMeasurable₂ hPm hwcont.aestronglyMeasurable))
  -- Step 3: integrability on the finite-measure ball `B_r(z)`.
  have hHint : Integrable H (V.weight.restrict (closedBall z r)) :=
    hH.1.integrableOn_compact_subset hBU (isCompact_closedBall z r)
  have hzg : Integrable (fun x => ζ x ^ 2 * g x) (V.weight.restrict (closedBall z r)) := by
    refine Integrable.of_bound ((hζcont.pow 2).aestronglyMeasurable.mul hgm) ((n + ℓ : ℕ) * 4)
      (ae_of_all _ fun x => ?_)
    rw [Real.norm_of_nonneg (mul_nonneg (sq_nonneg _) (hg0 x))]
    calc ζ x ^ 2 * g x ≤ 1 * ((n + ℓ : ℕ) * 4) :=
          mul_le_mul (hζsq x) (hgle x) (hg0 x) zero_le_one
      _ = (n + ℓ : ℕ) * 4 := one_mul _
  have hbi : Integrable b (V.weight.restrict (closedBall z r)) := by
    refine Integrable.of_bound hbm 12
      ((ae_restrict_iff' measurableSet_closedBall).2 (Eventually.of_forall fun x hx => ?_))
    obtain ⟨hz0, hz1⟩ := hζ01 x
    have hD : ‖fderiv ℝ ζ x ((V.tangentProj x - T.starProjection) (w x))‖ ≤ 3 / r * (2 * r) := by
      refine (ContinuousLinearMap.le_opNorm _ _).trans
        (mul_le_mul (hζd x) ?_ (norm_nonneg _) (by positivity))
      exact (ContinuousLinearMap.le_opNorm _ _).trans
        (mul_le_mul (hA2 x) (hwB x hx) (norm_nonneg _) zero_le_two)
    rw [hb, norm_mul, norm_mul, Real.norm_of_nonneg hz0, Real.norm_of_nonneg zero_le_two]
    calc 2 * ζ x * ‖fderiv ℝ ζ x ((V.tangentProj x - T.starProjection) (w x))‖
        ≤ 2 * 1 * (3 / r * (2 * r)) := by gcongr
      _ = 12 := by field_simp; norm_num
  have hw2 : Integrable (fun x => ‖w x‖ ^ 2) (V.weight.restrict (closedBall z r)) := by
    refine Integrable.of_bound (hwcont.norm.pow 2).aestronglyMeasurable (r ^ 2)
      ((ae_restrict_iff' measurableSet_closedBall).2 (Eventually.of_forall fun x hx => ?_))
    rw [Real.norm_of_nonneg (sq_nonneg _)]
    exact pow_le_pow_left₀ (norm_nonneg _) (hwB x hx) 2
  have hXH : Integrable (fun x => inner ℝ (X x) (H x)) (V.weight.restrict (closedBall z r)) := by
    refine Integrable.mono' (hHint.norm.const_mul r)
      (continuous_inner.comp_aestronglyMeasurable
        (hXcont.aestronglyMeasurable.prodMk hHint.aestronglyMeasurable))
      ((ae_restrict_iff' measurableSet_closedBall).2 (Eventually.of_forall fun x hx => ?_))
    rw [Real.norm_eq_abs]
    refine (abs_real_inner_le_norm _ _).trans ?_
    gcongr
    rw [hX, norm_smul, Real.norm_of_nonneg (sq_nonneg _)]
    calc ζ x ^ 2 * ‖w x‖ ≤ 1 * r := mul_le_mul (hζsq x) (hwB x hx) (norm_nonneg _) zero_le_one
      _ = r := one_mul _
  -- Step 1: `X = ζ² x'` is `C¹` with compact support in `B_r(z) ⊆ U`, so it is admissible.
  have hX1 : ContDiff ℝ 1 X := by
    rw [hXeq]
    exact (hζC1.pow 2).smul ((Tᗮ.starProjection).contDiff.comp (contDiff_id.sub contDiff_const))
  have hXout : ∀ x, x ∉ closedBall z r → X x = 0 := fun x hx => by
    rw [hX, hζout x hx]
    simp
  have hXcs : HasCompactSupport X := HasCompactSupport.intro (isCompact_closedBall z r) hXout
  have hXts : tsupport X ⊆ U := by
    refine (closure_minimal (fun x hx => ?_) isClosed_closedBall).trans hBU
    by_contra h'
    exact hx (hXout x h')
  -- Step 2: `div_M X = ζ² s + 2ζ Dζ((p_x - p_T) x')` with `s = g/2`, at `μ`-a.e. point
  -- (child `aal_l1th_test_field_divergence`, where `p_x = p_P` with `dim P = n`).
  have hdiv : ∀ᵐ x ∂V.weight, V.divM X x = 1 / 2 * (ζ x ^ 2 * g x) + b x := by
    filter_upwards [hae] with x hx
    obtain ⟨P, hP, hPx⟩ := hx
    rw [hXeq, Submission.aal_l1th_test_field_divergence n ℓ U V ζ z x P T
      (hζC1.differentiable one_ne_zero x) hP hT hPx, hg, hb, hw]
    ring
  -- Step 3: the first variation identity `∫ div_M X dμ = -∫ X · H dμ`, localized to `B_r(z)`.
  have hFV := hH.2 X hX1 hXcs hXts
  have hL : ∫ x, V.divM X x ∂V.weight =
      ∫ x in closedBall z r, (1 / 2 * (ζ x ^ 2 * g x) + b x) ∂V.weight := by
    rw [integral_congr_ae hdiv]
    refine (setIntegral_eq_integral_of_forall_compl_eq_zero fun x hx => ?_).symm
    rw [hb, hζout x hx]
    ring
  have hR : ∫ x, inner ℝ (X x) (H x) ∂V.weight =
      ∫ x in closedBall z r, inner ℝ (X x) (H x) ∂V.weight :=
    (setIntegral_eq_integral_of_forall_compl_eq_zero fun x hx => by
      rw [hXout x hx, inner_zero_left]).symm
  -- Step 4: absorption, `|b| ≤ 2ζ (3/r) |p_x - p_T| |x'| ≤ ζ² g/4 + 36 r⁻² |x'|²`.
  have hb_bd : ∀ x, -b x ≤ 1 / 4 * (ζ x ^ 2 * g x) + 36 / r ^ 2 * ‖w x‖ ^ 2 := by
    intro x
    obtain ⟨hz0, hz1⟩ := hζ01 x
    have hsq : Real.sqrt (g x) ^ 2 = g x := Real.sq_sqrt (hg0 x)
    have hD : |fderiv ℝ ζ x ((V.tangentProj x - T.starProjection) (w x))| ≤
        3 / r * (Real.sqrt (g x) * ‖w x‖) := by
      rw [← Real.norm_eq_abs]
      refine (ContinuousLinearMap.le_opNorm _ _).trans
        (mul_le_mul (hζd x) ?_ (norm_nonneg _) (by positivity))
      refine (ContinuousLinearMap.le_opNorm _ _).trans
        (mul_le_mul_of_nonneg_right ?_ (norm_nonneg _))
      rw [hg]
      exact hopHS _
    have h1 : -b x ≤ 2 * ζ x * (3 / r * (Real.sqrt (g x) * ‖w x‖)) := by
      rw [hb]
      calc -(2 * ζ x * fderiv ℝ ζ x ((V.tangentProj x - T.starProjection) (w x)))
          = 2 * ζ x * -fderiv ℝ ζ x ((V.tangentProj x - T.starProjection) (w x)) := by ring
        _ ≤ 2 * ζ x * (3 / r * (Real.sqrt (g x) * ‖w x‖)) :=
          mul_le_mul_of_nonneg_left ((neg_le_abs _).trans hD) (by positivity)
    have e : 1 / 4 * (ζ x ^ 2 * g x) + 36 / r ^ 2 * ‖w x‖ ^ 2 -
        2 * ζ x * (3 / r * (Real.sqrt (g x) * ‖w x‖)) =
        (ζ x * Real.sqrt (g x) / 2 - 6 / r * ‖w x‖) ^ 2 := by
      linear_combination (-(1 / 4) * ζ x ^ 2) * hsq
    linarith [sq_nonneg (ζ x * Real.sqrt (g x) / 2 - 6 / r * ‖w x‖)]
  -- Step 5: the mean-curvature term, using `|x'| ≤ h` at `μ`-a.e. point of `B_r(z)` (such points
  -- lie in `spt V ∩ B_r(z)`).
  have hXH_bd : ∀ᵐ x ∂(V.weight.restrict (closedBall z r)),
      -inner ℝ (X x) (H x) ≤ h * ‖H x‖ := by
    filter_upwards [ae_restrict_of_ae hsupp, ae_restrict_mem measurableSet_closedBall]
      with x hxs hxB
    have hz2 := hζsq x
    have hwx : ‖w x‖ ≤ h := by
      rw [hw, hperp]
      exact hheight x ⟨hxs, hxB⟩
    refine (neg_le_abs _).trans ((abs_real_inner_le_norm _ _).trans ?_)
    rw [hX, norm_smul, Real.norm_of_nonneg (sq_nonneg _)]
    calc ζ x ^ 2 * ‖w x‖ * ‖H x‖ ≤ 1 * h * ‖H x‖ := by gcongr
      _ = h * ‖H x‖ := by ring
  have e1 : ∫ x in closedBall z r, (1 / 2 * (ζ x ^ 2 * g x) + b x) ∂V.weight =
      1 / 2 * ∫ x in closedBall z r, ζ x ^ 2 * g x ∂V.weight +
        ∫ x in closedBall z r, b x ∂V.weight := by
    rw [integral_add (hzg.const_mul _) hbi, integral_const_mul]
  have e2 : -∫ x in closedBall z r, b x ∂V.weight ≤
      1 / 4 * ∫ x in closedBall z r, ζ x ^ 2 * g x ∂V.weight +
        36 / r ^ 2 * ∫ x in closedBall z r, ‖w x‖ ^ 2 ∂V.weight := by
    have h' := integral_mono hbi.neg ((hzg.const_mul (1 / 4)).add (hw2.const_mul (36 / r ^ 2)))
      hb_bd
    simp only [Pi.neg_apply, Pi.add_apply] at h'
    rwa [integral_neg, integral_add (hzg.const_mul _) (hw2.const_mul _), integral_const_mul,
      integral_const_mul] at h'
  have e3 : -∫ x in closedBall z r, inner ℝ (X x) (H x) ∂V.weight ≤
      h * ∫ x in closedBall z r, ‖H x‖ ∂V.weight := by
    rw [← integral_neg, ← integral_const_mul]
    exact integral_mono_ae hXH.neg (hHint.norm.const_mul h) hXH_bd
  -- `∫ ζ² g/2 = -∫ b - ∫ X · H ≤ ∫ ζ² g/4 + 36 r⁻² ∫ |x'|² + h ∫ |H|`, and `∫ ζ² g < ∞`.
  have key : ∫ x in closedBall z r, ζ x ^ 2 * g x ∂V.weight ≤
      144 / r ^ 2 * ∫ x in closedBall z r, ‖w x‖ ^ 2 ∂V.weight +
        4 * h * ∫ x in closedBall z r, ‖H x‖ ∂V.weight := by
    have hid := hFV
    rw [hL, hR, e1] at hid
    have r1 : 144 / r ^ 2 * ∫ x in closedBall z r, ‖w x‖ ^ 2 ∂V.weight =
        4 * (36 / r ^ 2 * ∫ x in closedBall z r, ‖w x‖ ^ 2 ∂V.weight) := by ring
    have r2 : 4 * h * ∫ x in closedBall z r, ‖H x‖ ∂V.weight =
        4 * (h * ∫ x in closedBall z r, ‖H x‖ ∂V.weight) := by ring
    linarith
  -- `ζ = 1` on `B_{r/2}(z)` and `ζ² g ≥ 0`.
  have hB2 : ∫ x in closedBall z (r / 2), g x ∂V.weight ≤
      ∫ x in closedBall z r, ζ x ^ 2 * g x ∂V.weight := by
    calc ∫ x in closedBall z (r / 2), g x ∂V.weight
        = ∫ x in closedBall z (r / 2), ζ x ^ 2 * g x ∂V.weight :=
          setIntegral_congr_fun measurableSet_closedBall fun x hx => by rw [hζ1 x hx]; ring
      _ ≤ ∫ x in closedBall z r, ζ x ^ 2 * g x ∂V.weight :=
          setIntegral_mono_set hzg (ae_of_all _ fun x => mul_nonneg (sq_nonneg _) (hg0 x))
            (closedBall_subset_closedBall (by linarith)).eventuallyLE
  have hId : ∫ x in closedBall z r, infDist (x - z) (T : Set (Amb n ℓ)) ^ 2 ∂V.weight =
      ∫ x in closedBall z r, ‖w x‖ ^ 2 ∂V.weight := by
    congr 1
    funext x
    rw [hw, hperp]
  calc ∫ x in closedBall z (r / 2), hsNormSq (V.tangentProj x - T.starProjection) ∂V.weight
      = ∫ x in closedBall z (r / 2), g x ∂V.weight := by simp_rw [hg]
    _ ≤ ∫ x in closedBall z r, ζ x ^ 2 * g x ∂V.weight := hB2
    _ ≤ 144 / r ^ 2 * ∫ x in closedBall z r, ‖w x‖ ^ 2 ∂V.weight +
          4 * h * ∫ x in closedBall z r, ‖H x‖ ∂V.weight := key
    _ = 144 * (r ^ 2)⁻¹ * ∫ x in closedBall z r, infDist (x - z) (T : Set (Amb n ℓ)) ^ 2 ∂V.weight +
          4 * h * ∫ x in closedBall z r, ‖H x‖ ∂V.weight := by
      rw [hId, div_eq_mul_inv]

/-- **Simon Ch. 4, 3.9–3.13, 4.9 and Remark 4.10(1)** (lower density bound on `spt V`).  Under the
hypotheses 2.3 (`AllardHypotheses`), every `y ∈ spt V` with `|y| < ρ` satisfies
`μ_V(B_s(y)) ≥ (1 − ε) ω_n sⁿ` for all small `s > 0`, for each `ε > 0`.  At `μ_V`-a.e. `x` near `y`
the `Lᵖ` monotonicity identity and `Θⁿ(μ_V, x) = θ(x) ≥ 1` give
`ω_n ≤ (1 + c(t)) t⁻ⁿ μ_V(B_t(x)) + c(t)` with `c(t) = A (t/r)^{1−n/p} → 0`; since
`y ∈ spt μ_V`, such points accumulate at `y`, which transfers the bound to `y`. -/
theorem aal_density_ge_one : ∀ (n ℓ : ℕ), 1 ≤ n → ∀ p : ℝ, (n : ℝ) < p → ∀ (U : Set (Amb n ℓ)), IsOpen U → ∀ (V : RectifiableVarifold n ℓ U) (H : Amb n ℓ → Amb n ℓ) (δ ρ : ℝ), V.AllardHypotheses H p δ ρ → ∀ y ∈ V.support ∩ ball (0 : Amb n ℓ) ρ, ∀ ε : ℝ, 0 < ε → ∀ᶠ s in 𝓝[>] (0 : ℝ), ENNReal.ofReal ((1 - ε) * (unitBallVolume n * s ^ n)) ≤ V.weight (closedBall y s) := by
  intro n ℓ hn p hp U hU V H δ ρ hA y hy ε hε
  obtain ⟨hρ, hH, hθ, -, hball0, -, hK0⟩ := hA
  have hysupp : y ∈ V.weight.support := (show y ∈ U ∩ V.weight.support from hy.1).2
  have hyρ : ‖y‖ < ρ := mem_ball_zero_iff.mp hy.2
  have hy0 : 0 ≤ ‖y‖ := norm_nonneg y
  have hn' : (0 : ℝ) < n := by exact_mod_cast hn
  have hp0 : 0 < p := lt_trans hn' hp
  have hω : 0 < unitBallVolume n := by
    unfold unitBallVolume
    exact div_pos (Real.rpow_pos_of_pos Real.pi_pos _) (Real.Gamma_pos_of_pos (by positivity))
  -- One radius `r = d/8`, `d = ρ - |y|`, for every point of `B̆_r(y)`.
  set d := ρ - ‖y‖ with hd_def
  have hd : 0 < d := by linarith
  set r := d / 8 with hr_def
  have hr : 0 < r := by positivity
  -- Balls `B_{2r}(x)`, `x ∈ B̆_r(y)`, stay inside `B_ρ(0) ⊆ U`.
  have hsub0 : ∀ x : Amb n ℓ, x ∈ ball y r → closedBall x (2 * r) ⊆ closedBall (0 : Amb n ℓ) ρ := by
    intro x hx z hz
    rw [mem_ball] at hx
    rw [mem_closedBall] at hz
    have h1 : dist z 0 ≤ dist z x + (dist x y + dist y 0) :=
      (dist_triangle z x 0).trans (add_le_add le_rfl (dist_triangle x y 0))
    simp only [dist_zero_right] at h1
    rw [mem_closedBall, dist_zero_right]
    linarith
  -- (F2): `μ_V(B_{2r}(y)) < ∞`, as `B_{2r}(y)` is a compact subset of `U`.
  have hfin2 : V.weight (closedBall y (2 * r)) < ⊤ := by
    have hKU : closedBall y (2 * r) ⊆ U := by
      intro z hz
      apply hball0
      rw [mem_closedBall] at hz ⊢
      have h1 := dist_triangle z y 0
      simp only [dist_zero_right] at h1 ⊢
      linarith
    have hKm : MeasurableSet (closedBall y (2 * r)) := measurableSet_closedBall
    unfold RectifiableVarifold.weight
    rw [withDensity_apply _ hKm, Measure.restrict_restrict hKm, Set.inter_comm]
    exact (V.integrableOn_mult _ (isCompact_closedBall _ _) hKU).lintegral_lt_top
  -- (A): `∫_{B_ρ(0)} |H|ᵖ dμ_V < ∞`, from `(ρ^{p-n} ∫_{B_ρ(0)} |H|ᵖ dμ_V)^{1/p} ≤ δ`.
  have hI0 : ∫⁻ x in closedBall (0 : Amb n ℓ) ρ, ‖H x‖ₑ ^ p ∂V.weight < ⊤ := by
    have h1 : V.scaledLpNorm H p 0 ρ < ⊤ := lt_of_le_of_lt hK0 ENNReal.ofReal_lt_top
    unfold RectifiableVarifold.scaledLpNorm at h1
    have h2 := (ENNReal.rpow_lt_top_iff_of_pos (by positivity : (0 : ℝ) < 1 / p)).mp h1
    have ha : ENNReal.ofReal (ρ ^ (p - n)) ≠ 0 := by
      rw [ne_eq, ENNReal.ofReal_eq_zero, not_le]; exact Real.rpow_pos_of_pos hρ _
    rcases ENNReal.mul_lt_top_iff.mp h2 with h | h | h
    · exact h.2
    · exact absurd h ha
    · rw [h]; exact ENNReal.zero_lt_top
  -- Step 1: constants.  `κ = (p - n)/(4p)`, `Λ = max(δ, 0)/κ + 1` (so `δ ≤ κΛ`),
  -- `A = e^{Λ/2} Λ/2`, `β = 1 - n/p > 0` and `c(t) = A (t/r)^β`.
  set κ := (p - n) / (4 * p) with hκ_def
  have hκ : 0 < κ := div_pos (by linarith) (by linarith)
  set Λ := max δ 0 / κ + 1 with hΛ_def
  have hΛ : 0 < Λ := by positivity
  have hκΛ : δ ≤ κ * Λ := by
    have h1 : κ * (max δ 0 / κ) = max δ 0 := by field_simp
    have h2 : κ * Λ = max δ 0 + κ := by rw [hΛ_def, mul_add, h1, mul_one]
    have h3 := le_max_left δ 0
    linarith
  set A := Real.exp (Λ / 2) / 2 * Λ with hA_def
  have hA0 : 0 ≤ A := by positivity
  set β := 1 - (n : ℝ) / p with hβ_def
  have hβ : 0 < β := by
    have : (n : ℝ) / p < 1 := (div_lt_one hp0).mpr hp
    linarith
  set c : ℝ → ℝ := fun t => A * (t / r) ^ β with hc_def
  have hc0 : ∀ t : ℝ, 0 < t → t ≤ r → 0 ≤ c t := fun t ht _ =>
    mul_nonneg hA0 (Real.rpow_nonneg (div_nonneg ht.le hr.le) _)
  have hclim : Tendsto c (𝓝[>] 0) (𝓝 0) := by
    have h1 : Tendsto (fun t : ℝ => A * (t / r) ^ β) (𝓝 0) (𝓝 (A * ((0 : ℝ) / r) ^ β)) := by
      apply Tendsto.const_mul
      apply Tendsto.rpow_const
      · exact (continuous_id.div_const r).tendsto 0
      · exact Or.inr hβ.le
    rw [zero_div, Real.zero_rpow hβ.ne', mul_zero] at h1
    exact h1.mono_left nhdsWithin_le_nhds
  -- Step 5: transfer the a.e. bound near `y` to the support point `y`.
  refine Submission.aal_dge1_support_density_lower_bound n ℓ V.weight y (unitBallVolume n) r c hω
    hr hysupp hfin2 hc0 hclim ?_ ε hε
  -- Step 4: `Θⁿ(μ_V, x) = θ(x) ≥ 1` for `μ_V`-a.e. `x`.
  have hts := (Submission.aal_tangent_structure n ℓ hn U hU V).2.2
  filter_upwards [hts, hθ] with x hxd hx1 hxy t ht htr
  -- Steps 2–3 at such `x ∈ B̆_r(y)`: the `Lᵖ` monotonicity identity on `(0, r]`, with `S = 2r`.
  have hsubx : closedBall x (2 * r) ⊆ U := (hsub0 x hxy).trans hball0
  have hfin : ∫⁻ z in closedBall x (2 * r), ‖H z‖ₑ ^ p ∂V.weight < ⊤ :=
    lt_of_le_of_lt (lintegral_mono_set (hsub0 x hxy)) hI0
  -- (K-mono): `K(x, r) ≤ K(0, ρ) ≤ δ ≤ κΛ`.
  have hKx : V.scaledLpNorm H p x r ≤ ENNReal.ofReal ((p - n) / (4 * p) * Λ) := by
    have hKmono : V.scaledLpNorm H p x r ≤ V.scaledLpNorm H p 0 ρ := by
      unfold RectifiableVarifold.scaledLpNorm
      apply ENNReal.rpow_le_rpow _ (by positivity)
      exact mul_le_mul'
        (ENNReal.ofReal_le_ofReal (Real.rpow_le_rpow hr.le (by linarith) (by linarith)))
        (lintegral_mono_set ((closedBall_subset_closedBall (by linarith)).trans (hsub0 x hxy)))
    exact hKmono.trans (hK0.trans (ENNReal.ofReal_le_ofReal hκΛ))
  obtain ⟨F, G, hF, hG⟩ := Submission.aal_lp_monotonicity n ℓ hn p hp U hU V H hH x r (2 * r) Λ
    hr (by linarith) hΛ hsubx hfin hKx
  -- `Φ(t) = F(t) t⁻ⁿ μ_V(B_t(x)) + F(t) - 1` is nondecreasing on `(0, r]`: `G > 0`, `∫ g ≥ 0`.
  have hmono : ∀ s t : ℝ, 0 < s → s ≤ t → t ≤ r →
      F s * ((V.weight (closedBall x s)).toReal / s ^ n) + (F s - 1) ≤
        F t * ((V.weight (closedBall x t)).toReal / t ^ n) + (F t - 1) := by
    intro s t hs hst htr
    obtain ⟨hG1, -, -, hEq⟩ := hG s t hs hst htr
    have hint : 0 ≤ ∫ z in closedBall x t \ closedBall x s,
        ‖(z - x) - V.tangentProj z (z - x)‖ ^ 2 / ‖z - x‖ ^ (n + 2) ∂V.weight :=
      integral_nonneg fun z => by positivity
    have hGpos : 0 < G s t := lt_of_lt_of_le (Real.exp_pos _) hG1
    have := mul_nonneg hGpos.le hint
    linarith
  -- `ω_n θ(x) ≤ (1 + c(t)) t⁻ⁿ μ_V(B_t(x)) + c(t)`, and `ω_n ≤ ω_n θ(x)`.
  have key := Submission.aal_dge1_density_le_monotone_bound n ℓ V.weight x (unitBallVolume n) r A β
    (V.mult x) F hω hr hβ (by linarith) (fun t ht htr => (hF t ht htr).2.2.1) hmono hxd t ht htr
  have h1 : unitBallVolume n ≤ unitBallVolume n * V.mult x := le_mul_of_one_le_right hω.le hx1
  show unitBallVolume n ≤ (1 + c t) * ((V.weight (closedBall x t)).toReal / t ^ n) + c t
  simp only [hc_def]
  linarith

/-- **Tilt bounded by height and curvature** (Simon Ch. 5, Lemma 2.5: the first inequality of (‡),
with the mean-curvature term of the documented erratum, for **every** `n`-dimensional subspace `T`).
There is `C₂ > 0` such that if 2.3 holds with `δ ∈ (0, 1/4]`, `ξ ∈ spt V ∩ B_{δρ}(0)` and
`σ ∈ (0, 2δρ]`, then
`C₂⁻¹ (σ⁻ⁿ ∫_{B_{σ/2}(ξ)} |p_{T_x M} − p_T|² dμ_V)^{1/2}
   ≤ σ⁻¹ sup{dist(x − ξ, T) : x ∈ spt V ∩ B_σ(ξ)} + (σ^{p−n} ∫_{B_σ(ξ)} |H|ᵖ dμ_V)^{1/p}`.
With `h` the height supremum and `k` the curvature term (both finite), the proof applies
`aal_l1_tilt_height` on `B_σ(ξ) ⊆ B_ρ(0)` and bounds the height integral by `h² μ_V(B_σ(ξ))`.
The mass bound `aal_mass_upper_bound` and Hölder's inequality then give
`∫_{B_σ(ξ)} |H| dμ_V ≤ (C₀ ω_n)^{1−1/p} k σ^{n−1}`. Hence
`C₂ = (max {144 C₀ ω_n, 2 (C₀ ω_n)^{1−1/p}})^{1/2}`. -/
theorem aal_tilt_height_curvature_bound : ∀ (n ℓ : ℕ), 1 ≤ n → ∀ p : ℝ, (n : ℝ) < p → ∃ C₂ : ℝ, 0 < C₂ ∧ ∀ (U : Set (Amb n ℓ)), IsOpen U → ∀ (V : RectifiableVarifold n ℓ U) (H : Amb n ℓ → Amb n ℓ) (δ ρ : ℝ), 0 < δ → δ ≤ 1 / 4 → V.AllardHypotheses H p δ ρ → ∀ ξ ∈ V.support ∩ closedBall (0 : Amb n ℓ) (δ * ρ), ∀ σ : ℝ, 0 < σ → σ ≤ 2 * δ * ρ → ∀ T : Submodule ℝ (Amb n ℓ), Module.finrank ℝ T = n → ENNReal.ofReal (C₂⁻¹ * Real.sqrt ((σ ^ n)⁻¹ * ∫ x in closedBall ξ (σ / 2), hsNormSq (V.tangentProj x - T.starProjection) ∂V.weight)) ≤ ENNReal.ofReal σ⁻¹ * V.heightSup ξ σ T + V.scaledLpNorm H p ξ σ := by
  intro n ℓ hn p hp
  have hn1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have hp0 : 0 < p := by linarith
  have hq : 0 ≤ 1 - 1 / p := by
    have : 1 / p ≤ 1 := by rw [div_le_one hp0]; linarith
    linarith
  -- Step 1: `c = C₀ ω_n`, `c' = c^{1−1/p}`, `D = max {144 c, 2 c'}` and `C₂ = √D`.
  obtain ⟨C₀, hC₀, hmass⟩ := Submission.aal_mass_upper_bound n ℓ hn p hp
  have hω : 0 < unitBallVolume n := by
    unfold unitBallVolume
    exact div_pos (Real.rpow_pos_of_pos Real.pi_pos _) (Real.Gamma_pos_of_pos (by positivity))
  obtain ⟨c, hc, hc_def⟩ : ∃ c : ℝ, 0 < c ∧ c = C₀ * unitBallVolume n := ⟨_, mul_pos hC₀ hω, rfl⟩
  obtain ⟨c', hc', hc'_def⟩ : ∃ c' : ℝ, 0 < c' ∧ c' = c ^ (1 - 1 / p) :=
    ⟨_, Real.rpow_pos_of_pos hc _, rfl⟩
  obtain ⟨D, hD1, hD2⟩ : ∃ D : ℝ, 144 * c ≤ D ∧ 2 * c' ≤ D :=
    ⟨_, le_max_left _ _, le_max_right _ _⟩
  have hDpos : 0 < D := lt_of_lt_of_le (by positivity) hD1
  refine ⟨Real.sqrt D, Real.sqrt_pos.2 hDpos, ?_⟩
  intro U hU V H δ ρ hδ hδ4 hA ξ hξ σ hσ hσρ T hT
  have hA' := hA
  obtain ⟨hρ, hGMC, -, -, hBU, -, hK0⟩ := hA'
  -- `B_σ(ξ) ⊆ B_ρ(0) ⊆ U` and `σ ≤ ρ/2`, since `|ξ| ≤ δρ ≤ ρ/4` and `σ ≤ 2δρ`.
  have hξn : ‖ξ‖ ≤ δ * ρ := by
    have := hξ.2
    rwa [mem_closedBall, dist_zero_right] at this
  have hδρ : δ * ρ ≤ ρ / 4 := by nlinarith
  have hσρ2 : σ ≤ ρ / 2 := by nlinarith
  have hBB : closedBall ξ σ ⊆ closedBall (0 : Amb n ℓ) ρ := by
    intro x hx
    rw [mem_closedBall, dist_eq_norm] at hx
    rw [mem_closedBall, dist_zero_right]
    calc ‖x‖ = ‖(x - ξ) + ξ‖ := by rw [sub_add_cancel]
      _ ≤ ‖x - ξ‖ + ‖ξ‖ := norm_add_le _ _
      _ ≤ σ + δ * ρ := add_le_add hx hξn
      _ ≤ ρ := by linarith
  -- Step 2: the height is finite: `heightSup ξ σ T = h` with `0 ≤ h` (indeed `h ≤ σ`).
  have hs_le : V.heightSup ξ σ T ≤ ENNReal.ofReal σ := by
    refine iSup₂_le fun x hx => ENNReal.ofReal_le_ofReal ?_
    have hx2 : ‖x - ξ‖ ≤ σ := by
      have := hx.2
      rwa [mem_closedBall, dist_eq_norm] at this
    calc infDist (x - ξ) (T : Set (Amb n ℓ)) ≤ dist (x - ξ) 0 :=
          infDist_le_dist_of_mem T.zero_mem
      _ = ‖x - ξ‖ := by rw [dist_zero_right]
      _ ≤ σ := hx2
  obtain ⟨h, hh0, hs_eq⟩ : ∃ h : ℝ, 0 ≤ h ∧ V.heightSup ξ σ T = ENNReal.ofReal h :=
    ⟨_, ENNReal.toReal_nonneg,
      (ENNReal.ofReal_toReal (ne_top_of_le_ne_top ENNReal.ofReal_ne_top hs_le)).symm⟩
  have hpt : ∀ x ∈ V.support ∩ closedBall ξ σ, infDist (x - ξ) (T : Set (Amb n ℓ)) ≤ h := by
    intro x hx
    have hle : ENNReal.ofReal (infDist (x - ξ) (T : Set (Amb n ℓ))) ≤ V.heightSup ξ σ T :=
      le_iSup₂ (f := fun x (_ : x ∈ V.support ∩ closedBall ξ σ) =>
        ENNReal.ofReal (infDist (x - ξ) (T : Set (Amb n ℓ)))) x hx
    rw [hs_eq] at hle
    exact (ENNReal.ofReal_le_ofReal_iff hh0).1 hle
  -- Step 3: the curvature term is finite, `K(ξ, σ) ≤ K(0, ρ) ≤ δ`; write `k = K(ξ, σ)` and
  -- `A = ∫_{B_σ(ξ)} |H|ᵖ dμ_V`, so that `k = σ^{(p−n)/p} A^{1/p}`.
  set A := ∫⁻ x in closedBall ξ σ, ‖H x‖ₑ ^ p ∂V.weight with hA_def
  have hσp : 0 < σ ^ (p - n) := Real.rpow_pos_of_pos hσ _
  have hKmono : V.scaledLpNorm H p ξ σ ≤ V.scaledLpNorm H p 0 ρ := by
    unfold RectifiableVarifold.scaledLpNorm
    refine ENNReal.rpow_le_rpow (mul_le_mul' ?_ (lintegral_mono_set hBB)) (by positivity)
    exact ENNReal.ofReal_le_ofReal (Real.rpow_le_rpow hσ.le (by linarith) (sub_nonneg.2 hp.le))
  have hK_ne : V.scaledLpNorm H p ξ σ ≠ ⊤ :=
    ne_top_of_le_ne_top ENNReal.ofReal_ne_top (hKmono.trans hK0)
  have hA_ne : A ≠ ⊤ := by
    intro hAtop
    apply hK_ne
    unfold RectifiableVarifold.scaledLpNorm
    rw [← hA_def, hAtop, ENNReal.mul_top (by simpa using hσp)]
    exact ENNReal.top_rpow_of_pos (by positivity)
  have hKeq : (V.scaledLpNorm H p ξ σ).toReal = σ ^ ((p - n) / p) * A.toReal ^ (1 / p) := by
    unfold RectifiableVarifold.scaledLpNorm
    rw [← hA_def, ← ENNReal.toReal_rpow, ENNReal.toReal_mul, ENNReal.toReal_ofReal hσp.le,
      Real.mul_rpow hσp.le ENNReal.toReal_nonneg, ← Real.rpow_mul hσ.le]
    congr 2
    ring
  obtain ⟨k, hk0, hk_eq⟩ : ∃ k : ℝ, 0 ≤ k ∧ V.scaledLpNorm H p ξ σ = ENNReal.ofReal k :=
    ⟨_, ENNReal.toReal_nonneg, (ENNReal.ofReal_toReal hK_ne).symm⟩
  have hAk : A.toReal ^ (1 / p) = σ ^ ((n - p) / p) * k := by
    rw [hk_eq, ENNReal.toReal_ofReal hk0] at hKeq
    rw [hKeq, ← mul_assoc, ← Real.rpow_add hσ]
    have : (n - p) / p + (p - n) / p = 0 := by field_simp; ring
    rw [this, Real.rpow_zero, one_mul]
  -- Step 5: the mass bound `μ_V(B_σ(ξ)) ≤ c σⁿ` (`|ξ| ≤ ρ/4`, `σ ≤ ρ/2`).
  have hm : V.weight (closedBall ξ σ) ≤ ENNReal.ofReal (c * σ ^ n) := by
    have := hmass U hU V H δ ρ hδ hδ4 hA ξ (hξn.trans hδρ) σ hσ hσρ2
    rwa [hc_def, mul_assoc]
  have hfin : V.weight (closedBall ξ σ) < ⊤ := lt_of_le_of_lt hm ENNReal.ofReal_lt_top
  have hm_le : (V.weight (closedBall ξ σ)).toReal ≤ c * σ ^ n :=
    ENNReal.toReal_le_of_le_ofReal (by positivity) hm
  -- Step 4: `aal_l1_tilt_height` on `B_σ(ξ)`, and `∫_{B_σ(ξ)} dist(x − ξ, T)² dμ_V ≤ h² c σⁿ`
  -- because `μ_V`-a.e. point lies in `spt V`, where `dist(x − ξ, T) ≤ h` on `B_σ(ξ)`.
  have hLA := Submission.aal_l1_tilt_height n ℓ hn U hU V H hGMC ξ σ h hσ (hBB.trans hBU) hh0 T hT
    hpt
  have hsupp : ∀ᵐ x ∂V.weight, x ∈ V.support := by
    have h1 : ∀ᵐ x ∂V.weight, x ∈ V.weight.support := Measure.support_mem_ae
    have h2 : ∀ᵐ x ∂V.weight, x ∈ V.carrier := by
      have : ∀ᵐ x ∂((μHE[n] : Measure (Amb n ℓ)).restrict V.carrier), x ∈ V.carrier :=
        ae_restrict_mem₀ V.nullMeasurableSet_carrier
      exact (withDensity_absolutelyContinuous _ _).ae_le this
    filter_upwards [h1, h2] with x hx1 hx2
    exact ⟨V.carrier_subset hx2, hx1⟩
  have hheight : ∫ x in closedBall ξ σ, infDist (x - ξ) (T : Set (Amb n ℓ)) ^ 2 ∂V.weight ≤
      h ^ 2 * (c * σ ^ n) := by
    have hae : ∀ᵐ x ∂(V.weight.restrict (closedBall ξ σ)), x ∈ V.support ∩ closedBall ξ σ := by
      filter_upwards [ae_restrict_of_ae hsupp, ae_restrict_mem measurableSet_closedBall]
        with x hx1 hx2
      exact ⟨hx1, hx2⟩
    have : IsFiniteMeasure (V.weight.restrict (closedBall ξ σ)) :=
      isFiniteMeasure_restrict.2 hfin.ne
    calc ∫ x in closedBall ξ σ, infDist (x - ξ) (T : Set (Amb n ℓ)) ^ 2 ∂V.weight
        ≤ ∫ x in closedBall ξ σ, h ^ 2 ∂V.weight := by
          apply integral_mono_of_nonneg
          · exact Eventually.of_forall fun x => sq_nonneg _
          · exact integrable_const _
          · filter_upwards [hae] with x hx
            exact pow_le_pow_left₀ infDist_nonneg (hpt x hx) 2
      _ = h ^ 2 * (V.weight (closedBall ξ σ)).toReal := by
          rw [setIntegral_const, smul_eq_mul, measureReal_def, mul_comm]
      _ ≤ h ^ 2 * (c * σ ^ n) := mul_le_mul_of_nonneg_left hm_le (by positivity)
  -- Step 6: Hölder, `∫_{B_σ(ξ)} |H| dμ_V ≤ A^{1/p} μ_V(B_σ(ξ))^{1−1/p} ≤ c' k σ^{n−1}`.
  have hHolder : ∫ x in closedBall ξ σ, ‖H x‖ ∂V.weight ≤
      A.toReal ^ (1 / p) * (V.weight (closedBall ξ σ)).toReal ^ (1 - 1 / p) := by
    by_cases hg : AEStronglyMeasurable (fun x => ‖H x‖) (V.weight.restrict (closedBall ξ σ))
    · rw [integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall fun x => norm_nonneg _) hg]
      have hcongr : ∫⁻ x in closedBall ξ σ, ENNReal.ofReal ‖H x‖ ∂V.weight =
          ∫⁻ x in closedBall ξ σ, ‖H x‖ₑ ∂V.weight := by
        congr 1; ext x; exact ofReal_norm (H x)
      rw [hcongr]
      have key := eLpNorm'_le_eLpNorm'_mul_rpow_measure_univ
        (μ := V.weight.restrict (closedBall ξ σ)) (f := fun x => ‖H x‖) one_pos
        (by linarith : (1 : ℝ) ≤ p) hg
      simp only [eLpNorm'_eq_lintegral_enorm, enorm_norm, ENNReal.rpow_one, div_one,
        Measure.restrict_apply_univ] at key
      rw [← hA_def] at key
      have hR : A ^ (1 / p) * V.weight (closedBall ξ σ) ^ (1 - 1 / p) ≠ ⊤ :=
        ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg (by positivity) hA_ne)
          (ENNReal.rpow_ne_top_of_nonneg hq hfin.ne)
      calc (∫⁻ x in closedBall ξ σ, ‖H x‖ₑ ∂V.weight).toReal
          ≤ (A ^ (1 / p) * V.weight (closedBall ξ σ) ^ (1 - 1 / p)).toReal :=
            ENNReal.toReal_mono hR key
        _ = A.toReal ^ (1 / p) * (V.weight (closedBall ξ σ)).toReal ^ (1 - 1 / p) := by
            rw [ENNReal.toReal_mul, ← ENNReal.toReal_rpow, ← ENNReal.toReal_rpow]
    · rw [integral_undef (fun hi => hg hi.aestronglyMeasurable)]
      positivity
  have hcurv : ∫ x in closedBall ξ σ, ‖H x‖ ∂V.weight ≤ c' * k * σ ^ (n - 1) := by
    calc ∫ x in closedBall ξ σ, ‖H x‖ ∂V.weight
        ≤ A.toReal ^ (1 / p) * (V.weight (closedBall ξ σ)).toReal ^ (1 - 1 / p) := hHolder
      _ ≤ A.toReal ^ (1 / p) * (c * σ ^ n) ^ (1 - 1 / p) :=
          mul_le_mul_of_nonneg_left (Real.rpow_le_rpow ENNReal.toReal_nonneg hm_le hq)
            (by positivity)
      _ = c' * k * σ ^ (n - 1) := by
          rw [hAk, hc'_def, Real.mul_rpow hc.le (by positivity), ← Real.rpow_natCast σ n,
            ← Real.rpow_mul hσ.le]
          have hpow : (σ : ℝ) ^ (n - 1 : ℕ) = σ ^ ((n : ℝ) - 1) := by
            rw [← Real.rpow_natCast, Nat.cast_sub hn, Nat.cast_one]
          rw [hpow]
          have : σ ^ ((n - p) / p) * k * (c ^ (1 - 1 / p) * σ ^ ((n : ℝ) * (1 - 1 / p)))
              = c ^ (1 - 1 / p) * k * (σ ^ ((n - p) / p) * σ ^ ((n : ℝ) * (1 - 1 / p))) := by
            ring
          rw [this, ← Real.rpow_add hσ]
          congr 2
          field_simp
          ring
  -- Step 7: with `X` the tilt integral and `a = σ⁻¹ h`,
  -- `σ⁻ⁿ X ≤ 144 c a² + 4 c' a k ≤ D (a + k)²`; take square roots.
  set X := ∫ x in closedBall ξ (σ / 2), hsNormSq (V.tangentProj x - T.starProjection) ∂V.weight
    with hX_def
  have hX : X ≤ 144 * (σ ^ 2)⁻¹ * (h ^ 2 * (c * σ ^ n)) + 4 * h * (c' * k * σ ^ (n - 1)) := by
    have h1 : 144 * (σ ^ 2)⁻¹ * ∫ x in closedBall ξ σ, infDist (x - ξ) (T : Set (Amb n ℓ)) ^ 2
        ∂V.weight ≤ 144 * (σ ^ 2)⁻¹ * (h ^ 2 * (c * σ ^ n)) :=
      mul_le_mul_of_nonneg_left hheight (by positivity)
    have h2 : 4 * h * ∫ x in closedBall ξ σ, ‖H x‖ ∂V.weight ≤ 4 * h * (c' * k * σ ^ (n - 1)) :=
      mul_le_mul_of_nonneg_left hcurv (by positivity)
    linarith
  obtain ⟨a, ha0, ha_def⟩ : ∃ a : ℝ, 0 ≤ a ∧ a = σ⁻¹ * h := ⟨_, by positivity, rfl⟩
  have hE : (σ ^ n)⁻¹ * (144 * (σ ^ 2)⁻¹ * (h ^ 2 * (c * σ ^ n)) + 4 * h * (c' * k * σ ^ (n - 1)))
      = 144 * c * a ^ 2 + 4 * c' * a * k := by
    obtain ⟨n', rfl⟩ : ∃ n', n = n' + 1 := ⟨n - 1, by omega⟩
    rw [ha_def, Nat.add_sub_cancel]
    field_simp
    ring
  have hcomb : (σ ^ n)⁻¹ * X ≤ D * (a + k) ^ 2 := by
    calc (σ ^ n)⁻¹ * X
        ≤ (σ ^ n)⁻¹ * (144 * (σ ^ 2)⁻¹ * (h ^ 2 * (c * σ ^ n)) + 4 * h * (c' * k * σ ^ (n - 1))) :=
          mul_le_mul_of_nonneg_left hX (by positivity)
      _ = 144 * c * a ^ 2 + 4 * c' * a * k := hE
      _ ≤ D * (a + k) ^ 2 := by
          linarith [mul_nonneg (sub_nonneg.2 hD1) (sq_nonneg a),
            mul_nonneg (mul_nonneg (sub_nonneg.2 hD2) ha0) hk0, mul_nonneg hDpos.le (sq_nonneg k)]
  have hfinal : (Real.sqrt D)⁻¹ * Real.sqrt ((σ ^ n)⁻¹ * X) ≤ σ⁻¹ * h + k := by
    rw [inv_mul_le_iff₀ (Real.sqrt_pos.2 hDpos), ← ha_def]
    calc Real.sqrt ((σ ^ n)⁻¹ * X) ≤ Real.sqrt (D * (a + k) ^ 2) := Real.sqrt_le_sqrt hcomb
      _ = Real.sqrt D * (a + k) := by
          rw [Real.sqrt_mul hDpos.le, Real.sqrt_sq (by positivity)]
  -- Step 8: back in `[0, ∞]`, `ofReal (σ⁻¹ h + k) = ofReal σ⁻¹ * heightSup + scaledLpNorm`.
  calc ENNReal.ofReal ((Real.sqrt D)⁻¹ * Real.sqrt ((σ ^ n)⁻¹ * X))
      ≤ ENNReal.ofReal (σ⁻¹ * h + k) := ENNReal.ofReal_le_ofReal hfinal
    _ = ENNReal.ofReal σ⁻¹ * V.heightSup ξ σ T + V.scaledLpNorm H p ξ σ := by
        rw [ENNReal.ofReal_add (by positivity) hk0, ENNReal.ofReal_mul (by positivity), hs_eq,
          hk_eq]

/-- **Simon Ch. 5, 2.4** (pinched density bounds, with explicit constants), `p > n`.  There are
`C_P ≥ 1` and `δ_P ∈ (0, 1/8]` with `C_P δ_P ≤ 1/2` such that if 2.3 holds with `δ ∈ (0, δ_P]`,
`|y| ≤ 3δρ` and `s ∈ (0, ρ/2]`, then `μ_V(B_s(y)) ≤ (1 + C_P δ) ω_n sⁿ`, and if `y ∈ spt V` also
`μ_V(B_s(y)) ≥ (1 − C_P δ) ω_n sⁿ` and `∫_{B_s(y)} |(x − y) − p_{T_xM}(x − y)|² / |x − y|^{n+2} dμ_V
≤ C_P ω_n δ`.  The `Lᵖ` monotonicity formula is applied at `y` with `Λ = δ/κ`, `κ = (p − n)/(4p)`,
and outer radius `R = (1 − 4δ)ρ`, inside `B_{(1−3δ)ρ}(y) ⊆ B_ρ(0)`: the monotone quantity
`Φ(t) = F(t) t⁻ⁿ μ_V(B_t(y)) + F(t) − 1` has `Φ(R) ≤ e^Λ (1 + δ)(1 − 4δ)⁻ⁿ ω_n + Λ`, and `Φ ≥ ω_n`
on `(0, R]` when `y ∈ spt V`, by the density lower bound at `y`. -/
theorem aal_pinched_density_bounds : ∀ (n ℓ : ℕ), 1 ≤ n → ∀ p : ℝ, (n : ℝ) < p → ∃ Cp δp : ℝ, 1 ≤ Cp ∧ 0 < δp ∧ δp ≤ 1 / 8 ∧ Cp * δp ≤ 1 / 2 ∧ ∀ (U : Set (Amb n ℓ)), IsOpen U → ∀ (V : RectifiableVarifold n ℓ U) (H : Amb n ℓ → Amb n ℓ) (δ ρ : ℝ), 0 < δ → δ ≤ δp → V.AllardHypotheses H p δ ρ → ∀ y : Amb n ℓ, ‖y‖ ≤ 3 * δ * ρ → ∀ s : ℝ, 0 < s → s ≤ ρ / 2 → V.weight (closedBall y s) ≤ ENNReal.ofReal ((1 + Cp * δ) * (unitBallVolume n * s ^ n)) ∧ (y ∈ V.support → ENNReal.ofReal ((1 - Cp * δ) * (unitBallVolume n * s ^ n)) ≤ V.weight (closedBall y s) ∧ ∫⁻ x in closedBall y s, ENNReal.ofReal (‖(x - y) - V.tangentProj x (x - y)‖ ^ 2 / ‖x - y‖ ^ (n + 2)) ∂V.weight ≤ ENNReal.ofReal (Cp * unitBallVolume n * δ)) := by
  intro n ℓ hn p hp
  have hp0 : 0 < p := (Nat.cast_pos.2 hn).trans hp
  obtain ⟨κ, hκ_def⟩ : ∃ κ : ℝ, κ = (p - n) / (4 * p) := ⟨_, rfl⟩
  have hκ : 0 < κ := by rw [hκ_def]; exact div_pos (sub_pos.2 hp) (by linarith)
  have hω : 0 < unitBallVolume n :=
    div_pos (Real.rpow_pos_of_pos Real.pi_pos _) (Real.Gamma_pos_of_pos (by positivity))
  have hα : 0 < 1 - (n : ℝ) / p := sub_pos.2 ((div_lt_one₀ hp0).2 hp)
  -- Steps 1–2: the constants and the elementary inequalities (E3)–(E5) at `t = δ`.
  obtain ⟨Cp, δp, hCp, hδp, hδp8, hδpκ, hCpδp, hineq⟩ :=
    Submission.aal_pinched_constants n κ (unitBallVolume n) hκ hω
  refine ⟨Cp, δp, hCp, hδp, hδp8, hCpδp, ?_⟩
  intro U hU V H δ ρ hδ hδδp hA y hy s hs hsρ
  have hρ : 0 < ρ := hA.1
  have hδ8 : δ ≤ 1 / 8 := hδδp.trans hδp8
  have hδρ : 0 ≤ (1 / 8 - δ) * ρ := mul_nonneg (by linarith) hρ.le
  obtain ⟨hi, hii, hiii⟩ := hineq δ hδ hδδp
  -- Step 3: `Λ = δ/κ ∈ (0, 1]`, `R = (1 − 4δ)ρ < S = (1 − 3δ)ρ ≤ ρ`, and `s ≤ ρ/2 ≤ R`.
  obtain ⟨Λ, hΛ_def⟩ : ∃ Λ : ℝ, Λ = δ / κ := ⟨_, rfl⟩
  rw [← hΛ_def] at hi hii hiii
  have hΛ : 0 < Λ := by rw [hΛ_def]; exact div_pos hδ hκ
  have hΛ1 : Λ ≤ 1 := by rw [hΛ_def]; exact (div_le_one₀ hκ).2 (hδδp.trans hδpκ)
  obtain ⟨R, hR_def⟩ : ∃ R : ℝ, R = (1 - 4 * δ) * ρ := ⟨_, rfl⟩
  obtain ⟨S, hS_def⟩ : ∃ S : ℝ, S = (1 - 3 * δ) * ρ := ⟨_, rfl⟩
  have hR : 0 < R := by rw [hR_def]; exact mul_pos (by linarith) hρ
  have hRS : R < S := by rw [hR_def, hS_def]; linarith [mul_pos hδ hρ]
  have hSρ : S ≤ ρ := by rw [hS_def]; linarith [mul_pos hδ hρ]
  have hsR : s ≤ R := by rw [hR_def]; linarith
  -- `B_r(y) ⊆ B_ρ(0)` for `r ≤ S`, since `|y| ≤ 3δρ`.
  have hball : ∀ r, r ≤ S → closedBall y r ⊆ closedBall 0 ρ := fun r hr =>
    closedBall_subset_closedBall' (by rw [dist_zero_right]; rw [hS_def] at hr; linarith)
  obtain ⟨hSU, hHS, -, -⟩ := Submission.aal_allard_subball_bounds n ℓ p hp U V H δ ρ hA y S
    (hR.trans hRS) hSρ (hball S le_rfl)
  obtain ⟨-, -, hKR, hmR⟩ := Submission.aal_allard_subball_bounds n ℓ p hp U V H δ ρ hA y R hR
    (hRS.le.trans hSρ) (hball R hRS.le)
  have hKR' : V.scaledLpNorm H p y R ≤ ENNReal.ofReal ((p - n) / (4 * p) * Λ) := by
    rwa [← hκ_def, hΛ_def, mul_div_cancel₀ δ hκ.ne']
  obtain ⟨F, G, hF, hG⟩ := Submission.aal_lp_monotonicity n ℓ hn p hp U hU V H hA.2.1 y R S Λ hR
    hRS hΛ hSU hHS hKR'
  -- `μ_V(B_t(y)) < ∞` for `t ≤ R`.
  have hfin : ∀ t, t ≤ R → V.weight (closedBall y t) ≠ ⊤ := fun t ht =>
    ne_top_of_le_ne_top ENNReal.ofReal_ne_top
      ((measure_mono (closedBall_subset_closedBall ht)).trans hmR)
  -- `e^{−Λ} ≤ F ≤ e^Λ` and `|F − 1| ≤ Λ` on `(0, R]`.
  have hF' : ∀ r, 0 < r → r ≤ R → Real.exp (-Λ) ≤ F r ∧ F r ≤ Real.exp Λ ∧ |F r - 1| ≤ Λ := by
    intro r hr hrR
    obtain ⟨h1, h2, -, h4⟩ := hF r hr hrR
    exact ⟨h1, h2, (h4 hΛ1).trans (mul_le_of_le_one_right hΛ.le
      (Real.rpow_le_one (div_nonneg hr.le hR.le) ((div_le_one₀ hR).2 hrR) hα.le))⟩
  -- `Φ(t) = F(t) t⁻ⁿ μ_V(B_t(y)) + F(t) − 1` is nondecreasing on `(0, R]`.
  have hmono : ∀ u t : ℝ, 0 < u → u ≤ t → t ≤ R →
      F u * ((V.weight (closedBall y u)).toReal / u ^ n) + (F u - 1) ≤
        F t * ((V.weight (closedBall y t)).toReal / t ^ n) + (F t - 1) := by
    intro u t hu hut htR
    obtain ⟨hG1, -, -, hGeq⟩ := hG u t hu hut htR
    have hI : 0 ≤ ∫ x in closedBall y t \ closedBall y u,
        ‖(x - y) - V.tangentProj x (x - y)‖ ^ 2 / ‖x - y‖ ^ (n + 2) ∂V.weight :=
      integral_nonneg fun x => div_nonneg (sq_nonneg _) (pow_nonneg (norm_nonneg _) _)
    linarith [mul_nonneg ((Real.exp_pos (-Λ)).le.trans hG1) hI]
  -- (3.1): `Φ(R) ≤ e^Λ (1 + δ)(1 − 4δ)⁻ⁿ ω_n + Λ`, from `μ_V(B_R(y)) ≤ (1 + δ) ω_n ρⁿ`.
  have hPhiR : F R * ((V.weight (closedBall y R)).toReal / R ^ n) + (F R - 1) ≤
      Real.exp Λ * ((1 + δ) / (1 - 4 * δ) ^ n * unitBallVolume n) + Λ := by
    obtain ⟨-, hF2, hF3⟩ := hF' R hR le_rfl
    have h4 : 0 < 1 - 4 * δ := by linarith
    have hX0 : 0 ≤ (V.weight (closedBall y R)).toReal / R ^ n := by positivity
    have hX : (V.weight (closedBall y R)).toReal / R ^ n ≤
        (1 + δ) / (1 - 4 * δ) ^ n * unitBallVolume n := by
      have hRn : R ^ n = (1 - 4 * δ) ^ n * ρ ^ n := by rw [hR_def, mul_pow]
      rw [div_le_iff₀ (pow_pos hR n), hRn]
      calc (V.weight (closedBall y R)).toReal ≤ (1 + δ) * (unitBallVolume n * ρ ^ n) :=
            ENNReal.toReal_le_of_le_ofReal (by positivity) hmR
        _ = (1 + δ) / (1 - 4 * δ) ^ n * unitBallVolume n * ((1 - 4 * δ) ^ n * ρ ^ n) := by
            rw [div_mul_eq_mul_div, div_mul_eq_mul_div, eq_div_iff (pow_ne_zero n h4.ne')]
            ring
    linarith [abs_le.1 hF3, mul_le_mul_of_nonneg_right hF2 hX0,
      mul_le_mul_of_nonneg_left hX (Real.exp_pos Λ).le]
  -- Step 4, (P.i): `s⁻ⁿ μ_V(B_s(y)) ≤ e^{2Λ} (1 + δ)(1 − 4δ)⁻ⁿ ω_n + 2 e^Λ Λ ≤ (1 + C_P δ) ω_n`.
  obtain ⟨hFs1, hFs2, hFs3⟩ := hF' s hs hsR
  have hXs0 : 0 ≤ (V.weight (closedBall y s)).toReal / s ^ n := by positivity
  have hXs : (V.weight (closedBall y s)).toReal / s ^ n ≤ (1 + Cp * δ) * unitBallVolume n := by
    refine le_trans ?_ hi
    have h1 : Real.exp (-Λ) * ((V.weight (closedBall y s)).toReal / s ^ n) ≤
        Real.exp Λ * ((1 + δ) / (1 - 4 * δ) ^ n * unitBallVolume n) + 2 * Λ := by
      linarith [mul_le_mul_of_nonneg_right hFs1 hXs0, abs_le.1 hFs3, hmono s R hs hsR le_rfl]
    calc (V.weight (closedBall y s)).toReal / s ^ n
        = Real.exp Λ * (Real.exp (-Λ) * ((V.weight (closedBall y s)).toReal / s ^ n)) := by
          rw [← mul_assoc, ← Real.exp_add, add_neg_cancel, Real.exp_zero, one_mul]
      _ ≤ Real.exp Λ * (Real.exp Λ * ((1 + δ) / (1 - 4 * δ) ^ n * unitBallVolume n) + 2 * Λ) := by
          gcongr
      _ = Real.exp (2 * Λ) * ((1 + δ) / (1 - 4 * δ) ^ n * unitBallVolume n) +
            2 * Real.exp Λ * Λ := by
          rw [two_mul Λ, Real.exp_add]; ring
  refine ⟨?_, fun hysupp => ?_⟩
  · rw [div_le_iff₀ (pow_pos hs n), mul_assoc] at hXs
    rw [← ENNReal.ofReal_toReal (hfin s hsR)]
    exact ENNReal.ofReal_le_ofReal hXs
  -- Step 5: `Φ ≥ ω_n` on `(0, R]`, from the lower density bound at `y ∈ spt V ∩ B̆_ρ(0)`.
  have hy_mem : y ∈ V.support ∩ ball (0 : Amb n ℓ) ρ :=
    ⟨hysupp, by rw [mem_ball, dist_zero_right]; linarith⟩
  have hPhi_ge : ∀ t, 0 < t → t ≤ R →
      unitBallVolume n ≤ F t * ((V.weight (closedBall y t)).toReal / t ^ n) + (F t - 1) := by
    intro t ht htR
    refine Submission.aal_monotone_quantity_ge_density n (1 - (n : ℝ) / p) (unitBallVolume n) R Λ
      (fun u => (V.weight (closedBall y u)).toReal) F hα hω hR
      (fun u hu huR => (hF u hu huR).2.2.2 hΛ1) hmono (fun ε hε => ?_) t ht htR
    filter_upwards [Submission.aal_density_ge_one n ℓ hn p hp U hU V H δ ρ hA y hy_mem ε hε,
      Ioo_mem_nhdsGT hR] with u hu hu'
    exact (ENNReal.ofReal_le_iff_le_toReal (hfin u hu'.2.le)).1 hu
  refine ⟨?_, ?_⟩
  · -- Step 6, (P.ii): `s⁻ⁿ μ_V(B_s(y)) ≥ e^{−Λ} (ω_n − Λ) ≥ (1 − C_P δ) ω_n`.
    have hX : Real.exp (-Λ) * (unitBallVolume n - Λ) ≤
        (V.weight (closedBall y s)).toReal / s ^ n := by
      have h1 : unitBallVolume n - Λ ≤
          Real.exp Λ * ((V.weight (closedBall y s)).toReal / s ^ n) := by
        linarith [mul_le_mul_of_nonneg_right hFs2 hXs0, abs_le.1 hFs3, hPhi_ge s hs hsR]
      calc Real.exp (-Λ) * (unitBallVolume n - Λ)
          ≤ Real.exp (-Λ) * (Real.exp Λ * ((V.weight (closedBall y s)).toReal / s ^ n)) := by
            gcongr
        _ = (V.weight (closedBall y s)).toReal / s ^ n := by
            rw [← mul_assoc, ← Real.exp_add, neg_add_cancel, Real.exp_zero, one_mul]
    have hms := (le_div_iff₀ (pow_pos hs n)).1 (hii.trans hX)
    rw [mul_assoc] at hms
    rw [← ENNReal.ofReal_toReal (hfin s hsR)]
    exact ENNReal.ofReal_le_ofReal hms
  · -- Step 7, (P.iii): each annular integral is `≤ e^Λ (Φ(R) − ω_n) ≤ C_P ω_n δ`.
    refine Submission.aal_lintegral_closedBall_le_of_annuli n ℓ V.weight
      (fun x => ‖(x - y) - V.tangentProj x (x - y)‖ ^ 2 / ‖x - y‖ ^ (n + 2)) y s
      (Cp * unitBallVolume n * δ) hs
      (fun x => div_nonneg (sq_nonneg _) (pow_nonneg (norm_nonneg _) _)) (by simp)
      fun t ht hts => ?_
    obtain ⟨hG1, -, hint, hGeq⟩ := hG t s ht hts.le hsR
    refine ⟨hint, ?_⟩
    beta_reduce
    set I := ∫ x in closedBall y s \ closedBall y t,
      ‖(x - y) - V.tangentProj x (x - y)‖ ^ 2 / ‖x - y‖ ^ (n + 2) ∂V.weight
    have hI : 0 ≤ I :=
      integral_nonneg fun x => div_nonneg (sq_nonneg _) (pow_nonneg (norm_nonneg _) _)
    have h1 : Real.exp (-Λ) * I ≤
        Real.exp Λ * ((1 + δ) / (1 - 4 * δ) ^ n * unitBallVolume n) + Λ - unitBallVolume n := by
      linarith [mul_le_mul_of_nonneg_right hG1 hI, hmono s R hs hsR le_rfl,
        hPhi_ge t ht (hts.le.trans hsR)]
    calc I = Real.exp Λ * (Real.exp (-Λ) * I) := by
          rw [← mul_assoc, ← Real.exp_add, add_neg_cancel, Real.exp_zero, one_mul]
      _ ≤ Real.exp Λ *
          (Real.exp Λ * ((1 + δ) / (1 - 4 * δ) ^ n * unitBallVolume n) + Λ - unitBallVolume n) := by
          gcongr
      _ ≤ Cp * unitBallVolume n * δ := hiii

/-- Simon Ch. 5, proof of Lemma 2.5, steps (1)–(6) (pp. 109–110), with `α = 1/(2n+2)`: for
`δ ≤ δ₁ = δ_P` put `A = δ^α`.  A maximal disjoint family of balls `B_{Aσ/2}(y)` centred in
`spt V ∩ B_σ(ξ)` gives an `Aσ`-net `F` with `#F Aⁿ ≤ 4^{n+1}`; the conical-excess bound at the net
points and Chebyshev give `x₀ ∈ B_{Aσ}(ξ)` with tangent plane `T` and `|p_{T^⊥}(x₀ − y)| < C₆ Aσ`
for `y ∈ F`, so `dist(x − ξ, T) ≤ (C₆ + 2) Aσ` on `spt V ∩ B_σ(ξ)`. -/
theorem aal_height_bound_small_delta : ∀ (n ℓ : ℕ), 1 ≤ n → ∀ p : ℝ, (n : ℝ) < p →
    ∃ δ₁ C₁ : ℝ, 0 < δ₁ ∧ 0 < C₁ ∧ ∀ (U : Set (Amb n ℓ)), IsOpen U →
    ∀ (V : RectifiableVarifold n ℓ U) (H : Amb n ℓ → Amb n ℓ) (δ ρ : ℝ), 0 < δ → δ ≤ δ₁ →
    V.AllardHypotheses H p δ ρ → ∀ ξ ∈ V.support ∩ closedBall (0 : Amb n ℓ) (δ * ρ),
    ∀ σ : ℝ, 0 < σ → σ ≤ 2 * δ * ρ → ∃ T : Submodule ℝ (Amb n ℓ), Module.finrank ℝ T = n ∧
    ∀ x ∈ V.support ∩ closedBall ξ σ,
      infDist (x - ξ) (T : Set (Amb n ℓ)) ≤ C₁ * δ ^ (1 / (2 * (n : ℝ) + 2)) * σ := by
  intro n ℓ hn p hp
  -- Step 1: `δ₁ = δ_P`, `C₅ = 4^{n+1} 2^{n+2} C_P ω_n`, `C₆ = (4 C₅ / ω_n)^{1/2}`, `C₁ = C₆ + 2`.
  obtain ⟨Cp, δp, hCp1, hδp, hδp8, hCpδp, hpinch⟩ :=
    Submission.aal_pinched_density_bounds n ℓ hn p hp
  set ω : ℝ := unitBallVolume n
  have hω : 0 < ω :=
    div_pos (Real.rpow_pos_of_pos Real.pi_pos _) (Real.Gamma_pos_of_pos (by positivity))
  have hCp : 0 < Cp := by linarith
  set C₅ : ℝ := 4 ^ (n + 1) * 2 ^ (n + 2) * Cp * ω with hC₅_def
  have hC₅ : 0 < C₅ := by positivity
  set C₆ : ℝ := Real.sqrt (4 * C₅ / ω)
  have hC₆ : 0 < C₆ := Real.sqrt_pos.2 (by positivity)
  have hC₆sq : C₆ ^ 2 = 4 * C₅ / ω := Real.sq_sqrt (by positivity)
  refine ⟨δp, C₆ + 2, hδp, by positivity, ?_⟩
  intro U hU V H δ ρ hδ hδδp hyp ξ hξ σ hσ hσδ
  -- Step 2: the pinched bounds hold at centres in `B_σ(ξ)` (`|y| ≤ 3δρ`), radii `≤ 2σ ≤ ρ/2`.
  have hρ : 0 < ρ := hyp.1
  obtain ⟨hξS, hξB⟩ := hξ
  have hξn : ‖ξ‖ ≤ δ * ρ := mem_closedBall_zero_iff.1 hξB
  have hδ8 : δ ≤ 1 / 8 := hδδp.trans hδp8
  have hCpδ : Cp * δ ≤ 1 / 2 := (mul_le_mul_of_nonneg_left hδδp hCp.le).trans hCpδp
  have h2σ : 2 * σ ≤ ρ / 2 := by nlinarith [mul_le_mul_of_nonneg_right hδ8 hρ.le]
  set α : ℝ := 1 / (2 * (n : ℝ) + 2) with hα_def
  set A : ℝ := δ ^ α with hA_def
  have hA : 0 < A := Real.rpow_pos_of_pos hδ α
  have hA1 : A ≤ 1 := Real.rpow_le_one hδ.le (by linarith) (by positivity)
  have hAσ : A * σ ≤ σ := mul_le_of_le_one_left hσ.le hA1
  have hAδ : A ^ (2 * n + 2) = δ := by
    rw [hA_def, ← Real.rpow_natCast, ← Real.rpow_mul hδ.le]
    have : α * ((2 * n + 2 : ℕ) : ℝ) = 1 := by
      rw [hα_def]; push_cast; field_simp
    rw [this, Real.rpow_one]
  set S := V.support ∩ closedBall ξ σ
  have hball : ∀ y ∈ closedBall ξ σ, ‖y‖ ≤ 3 * δ * ρ := by
    intro y hy
    have hyξ : ‖y - ξ‖ ≤ σ := by rw [← dist_eq_norm]; exact mem_closedBall.1 hy
    linarith [norm_sub_norm_le y ξ]
  have hlow : ∀ y ∈ S, ∀ t : ℝ, 0 < t → t ≤ 2 * σ →
      ENNReal.ofReal (1 / 2 * (ω * t ^ n)) ≤ V.weight (closedBall y t) := by
    intro y hy t ht ht2
    refine (ENNReal.ofReal_le_ofReal ?_).trans
      ((hpinch U hU V H δ ρ hδ hδδp hyp y (hball y hy.2) t ht (by linarith)).2 hy.1).1
    have : 0 ≤ ω * t ^ n := by positivity
    nlinarith
  have hup : V.weight (closedBall ξ (2 * σ)) ≤ ENNReal.ofReal (2 * (ω * (2 * σ) ^ n)) := by
    refine (hpinch U hU V H δ ρ hδ hδδp hyp ξ (hball ξ (mem_closedBall_self hσ.le)) (2 * σ)
      (by linarith) h2σ).1.trans (ENNReal.ofReal_le_ofReal ?_)
    have : 0 ≤ ω * (2 * σ) ^ n := by positivity
    nlinarith
  -- Step 3: for `y ∈ S`, `B_σ(ξ) ⊆ B_{2σ}(y)` and
  -- `∫_{B_{2σ}(y)} |p_x^⊥(x − y)|² dμ_V ≤ (2σ)^{n+2} C_P ω_n δ =: K`.
  set K : ℝ := (2 * σ) ^ (n + 2) * (Cp * ω * δ) with hK_def
  have hK : ∀ y ∈ S, ∫⁻ x in closedBall ξ σ,
      ENNReal.ofReal (‖(x - y) - V.tangentProj x (x - y)‖ ^ 2) ∂V.weight ≤ ENNReal.ofReal K := by
    intro y hy
    have hsub : closedBall ξ σ ⊆ closedBall y (2 * σ) :=
      closedBall_subset_closedBall' (by rw [dist_comm]; linarith [mem_closedBall.1 hy.2])
    calc ∫⁻ x in closedBall ξ σ, ENNReal.ofReal (‖(x - y) - V.tangentProj x (x - y)‖ ^ 2)
          ∂V.weight
        ≤ ∫⁻ x in closedBall y (2 * σ),
            ENNReal.ofReal (‖(x - y) - V.tangentProj x (x - y)‖ ^ 2) ∂V.weight :=
          lintegral_mono_set hsub
      _ ≤ ENNReal.ofReal ((2 * σ) ^ (n + 2)) * ∫⁻ x in closedBall y (2 * σ),
            ENNReal.ofReal (‖(x - y) - V.tangentProj x (x - y)‖ ^ 2 / ‖x - y‖ ^ (n + 2))
              ∂V.weight :=
          Submission.aal_normal_sq_lintegral_le_conical n ℓ V.weight V.tangentProj y (2 * σ)
            (by linarith)
      _ ≤ ENNReal.ofReal ((2 * σ) ^ (n + 2)) * ENNReal.ofReal (Cp * ω * δ) := by
          gcongr
          exact ((hpinch U hU V H δ ρ hδ hδδp hyp y (hball y hy.2) (2 * σ) (by linarith)
            h2σ).2 hy.1).2
      _ = ENNReal.ofReal K := (ENNReal.ofReal_mul (by positivity)).symm
  -- Step 4: a maximal disjoint family of balls `B_{Aσ/2}(y)`, `y ∈ S`, is an `Aσ`-net of `S`
  -- with `#F (1/2) ω_n (Aσ/2)ⁿ ≤ μ_V(B_{2σ}(ξ)) ≤ 2 ω_n (2σ)ⁿ`, i.e. `#F Aⁿ ≤ 4^{n+1}`.
  obtain ⟨F, hFS, hcard, hnet⟩ := Submission.aal_packing_finite_net (Amb n ℓ) V.weight S
    (closedBall ξ (2 * σ)) (A * σ / 2) (1 / 2 * (ω * (A * σ / 2) ^ n)) (2 * (ω * (2 * σ) ^ n))
    (by positivity) (by positivity) (by positivity) hup fun y hy =>
      ⟨closedBall_subset_closedBall' (by linarith [mem_closedBall.1 hy.2]),
        hlow y hy _ (by positivity) (by linarith)⟩
  have hcardA : (F.card : ℝ) * A ^ n ≤ 4 ^ (n + 1) := by
    have hc : 0 < ω * σ ^ n / (2 * 2 ^ n) := by positivity
    refine le_of_mul_le_mul_right ?_ hc
    calc (F.card : ℝ) * A ^ n * (ω * σ ^ n / (2 * 2 ^ n))
        = (F.card : ℝ) * (1 / 2 * (ω * (A * σ / 2) ^ n)) := by rw [div_pow, mul_pow]; ring
      _ ≤ 2 * (ω * (2 * σ) ^ n) := hcard
      _ = 4 ^ (n + 1) * (ω * σ ^ n / (2 * 2 ^ n)) := by
        rw [show (4 : ℝ) ^ (n + 1) = 2 * 2 ^ n * (2 * 2 ^ n) by
          rw [show (4 : ℝ) = 2 * 2 by norm_num, mul_pow, pow_succ]; ring]
        field_simp
        ring
  -- Step 5: Chebyshev with `λ = (C₆ Aσ)² = (4 C₅ / ω_n) δ^{1 − 2αn} σ²`, using
  -- `#F K ≤ C₅ A^{n+2} σ^{n+2} < λ (1/2) ω_n (Aσ)ⁿ ≤ λ μ_V(B_{Aσ}(ξ))`.
  obtain ⟨hae, hmeas, -⟩ := Submission.aal_tangent_structure n ℓ hn U hU V
  set lam : ℝ := (C₆ * A * σ) ^ 2 with hlam_def
  have hlam : 0 < lam := by positivity
  have hcheb : ENNReal.ofReal ((F.card : ℝ) * K) <
      ENNReal.ofReal lam * V.weight (closedBall ξ (A * σ)) := by
    have hlt : (F.card : ℝ) * K < lam * (1 / 2 * (ω * (A * σ) ^ n)) := by
      have hY : 0 < 2 ^ (n + 2) * σ ^ (n + 2) * Cp * ω * A ^ (n + 2) := by positivity
      calc (F.card : ℝ) * K
          = (F.card : ℝ) * A ^ n * (2 ^ (n + 2) * σ ^ (n + 2) * Cp * ω * A ^ (n + 2)) := by
            rw [hK_def, ← hAδ]; ring
        _ ≤ 4 ^ (n + 1) * (2 ^ (n + 2) * σ ^ (n + 2) * Cp * ω * A ^ (n + 2)) :=
            mul_le_mul_of_nonneg_right hcardA hY.le
        _ = C₅ * (A ^ (n + 2) * σ ^ (n + 2)) := by rw [hC₅_def]; ring
        _ < 2 * C₅ * (A ^ (n + 2) * σ ^ (n + 2)) := by
            have : 0 < C₅ * (A ^ (n + 2) * σ ^ (n + 2)) := by positivity
            linarith
        _ = lam * (1 / 2 * (ω * (A * σ) ^ n)) := by
            rw [hlam_def, mul_pow, mul_pow, hC₆sq]
            field_simp
            ring
    calc ENNReal.ofReal ((F.card : ℝ) * K)
        < ENNReal.ofReal (lam * (1 / 2 * (ω * (A * σ) ^ n))) :=
          (ENNReal.ofReal_lt_ofReal_iff (by positivity)).2 hlt
      _ = ENNReal.ofReal lam * ENNReal.ofReal (1 / 2 * (ω * (A * σ) ^ n)) :=
          ENNReal.ofReal_mul hlam.le
      _ ≤ ENNReal.ofReal lam * V.weight (closedBall ξ (A * σ)) := by
          gcongr
          exact hlow ξ ⟨hξS, mem_closedBall_self hσ.le⟩ (A * σ) (by positivity) (by linarith)
  obtain ⟨x₀, hx₀, T, hT, -, hsmall⟩ := Submission.aal_good_tangent_point n ℓ V.weight
    V.tangentProj hmeas hae ξ (A * σ) σ K lam F hlam hAσ (fun y hy => hK y (hFS hy)) hcheb
  refine ⟨T, hT, ?_⟩
  -- Steps 6–7: `|p_{T^⊥}(x₀ − y)| ≤ C₆ Aσ` on the net and `|x₀ − ξ| ≤ Aσ`, so
  -- `dist(x − ξ, T) ≤ C₆ Aσ + 2Aσ = C₁ δ^{1/(2n+2)} σ` on `spt V ∩ B_σ(ξ)`.
  have hb : ∀ y ∈ F, ‖(x₀ - y) - T.starProjection (x₀ - y)‖ ≤ C₆ * A * σ := fun y hy =>
    ((pow_lt_pow_iff_left₀ (norm_nonneg _) (by positivity) two_ne_zero).1 (hsmall y hy)).le
  have hx₀ξ : ‖x₀ - ξ‖ ≤ A * σ := by rw [← dist_eq_norm]; exact mem_closedBall.1 hx₀
  have hnet' : ∀ x ∈ S, ∃ y ∈ F, dist x y ≤ A * σ := fun x hx => by
    obtain ⟨z, hz, hd⟩ := hnet x hx
    exact ⟨z, hz, by linarith⟩
  intro x hx
  calc infDist (x - ξ) (T : Set (Amb n ℓ))
      ≤ C₆ * A * σ + 2 * (A * σ) :=
        Submission.aal_height_of_net_plane n ℓ T ξ x₀ S F (A * σ) (C₆ * A * σ) hx₀ξ hb hnet' x hx
    _ = (C₆ + 2) * A * σ := by ring

/-- **Simon Ch. 5, Lemma 2.5 (Affine Approximation Lemma, p. 108)**, corrected as in the contract.
Every `n`-plane satisfies the first inequality of (‡) with the constant `C₂` of
`aal_tilt_height_curvature_bound`.  For `δ ≤ δ₁` the plane of `aal_height_bound_small_delta` has
height `≤ C₁ δ^{1/(2n+2)} σ`; for `δ > δ₁` the plane `ℝⁿ × {0}` has height `≤ σ` and
`1 ≤ δ₁^{-1/(2n+2)} δ^{1/(2n+2)}`.  So any `C ≥ max {C₂, C₁, δ₁^{-1/(2n+2)}}` works. -/
theorem affine_approximation_lemma : AffineApproximationLemma := by
  intro n ℓ hn p hp
  obtain ⟨C₂, hC₂, htilt⟩ := Submission.aal_tilt_height_curvature_bound n ℓ hn p hp
  obtain ⟨δ₁, C₁, hδ₁, -, hheight⟩ := Submission.aal_height_bound_small_delta n ℓ hn p hp
  set a : ℝ := 1 / (2 * (n : ℝ) + 2) with ha_def
  have ha : 0 ≤ a := by rw [ha_def]; positivity
  have hδ₁a : 0 < δ₁ ^ a := Real.rpow_pos_of_pos hδ₁ a
  obtain ⟨C, hC₂C, hC₁C, hδ₁C⟩ : ∃ C : ℝ, C₂ ≤ C ∧ C₁ ≤ C ∧ (δ₁ ^ a)⁻¹ ≤ C :=
    ⟨max (max C₂ C₁) (δ₁ ^ a)⁻¹, le_max_of_le_left (le_max_left _ _),
      le_max_of_le_left (le_max_right _ _), le_max_right _ _⟩
  refine ⟨C, hC₂.trans_le hC₂C, ?_⟩
  intro U hU V H δ ρ hδ hδ4 hA ξ hξ σ hσ hσδ
  -- Step 2: the first inequality holds for every `n`-plane, since `C⁻¹ ≤ C₂⁻¹`.
  have hfirst : ∀ T : Submodule ℝ (Amb n ℓ), Module.finrank ℝ T = n →
      ENNReal.ofReal (C⁻¹ * Real.sqrt ((σ ^ n)⁻¹ *
          ∫ x in closedBall ξ (σ / 2), hsNormSq (V.tangentProj x - T.starProjection) ∂V.weight)) ≤
        ENNReal.ofReal σ⁻¹ * V.heightSup ξ σ T + V.scaledLpNorm H p ξ σ := fun T hT =>
    (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right (inv_anti₀ hC₂ hC₂C)
      (Real.sqrt_nonneg _))).trans (htilt U hU V H δ ρ hδ hδ4 hA ξ hξ σ hσ hσδ T hT)
  -- A height bound `b` on `spt V ∩ B_σ(ξ)` gives `σ⁻¹ h ≤ σ⁻¹ b`.
  have hheight_le : ∀ (T : Submodule ℝ (Amb n ℓ)) (b : ℝ),
      (∀ x ∈ V.support ∩ closedBall ξ σ, infDist (x - ξ) (T : Set (Amb n ℓ)) ≤ b) →
        ENNReal.ofReal σ⁻¹ * V.heightSup ξ σ T ≤ ENNReal.ofReal (σ⁻¹ * b) := by
    intro T b hb
    rw [ENNReal.ofReal_mul (inv_nonneg.2 hσ.le)]
    gcongr
    exact iSup₂_le fun x hx => ENNReal.ofReal_le_ofReal (hb x hx)
  by_cases hsmall : δ ≤ δ₁
  · -- Steps 4–7 (`δ ≤ δ₁`): the plane of `aal_height_bound_small_delta`.
    obtain ⟨T, hT, hTh⟩ := hheight U hU V H δ ρ hδ hsmall hA ξ hξ σ hσ hσδ
    refine ⟨T, hT, hfirst T hT, (hheight_le T _ hTh).trans (ENNReal.ofReal_le_ofReal ?_)⟩
    rw [show σ⁻¹ * (C₁ * δ ^ a * σ) = C₁ * δ ^ a by field_simp]
    exact mul_le_mul_of_nonneg_right hC₁C (Real.rpow_nonneg hδ.le a)
  · -- Step 3 (`δ > δ₁`): `T = ℝⁿ × {0}`, whose height over `B_σ(ξ)` is at most `σ`.
    have hlarge : δ₁ < δ := not_le.1 hsmall
    have hfin : Module.finrank ℝ (horizontalPlane n ℓ) = n := by
      have hli : LinearIndependent ℝ
          (fun i : Fin n => EuclideanSpace.single (Fin.castAdd ℓ i) (1 : ℝ) : Fin n → Amb n ℓ) := by
        simpa [Function.comp_def] using
          (EuclideanSpace.basisFun (Fin (n + ℓ)) ℝ).orthonormal.linearIndependent.comp
            (Fin.castAdd ℓ) (Fin.castAdd_injective n ℓ)
      rw [horizontalPlane, finrank_span_eq_card hli, Fintype.card_fin]
    refine ⟨horizontalPlane n ℓ, hfin, hfirst _ hfin,
      (hheight_le _ σ fun x hx => ?_).trans (ENNReal.ofReal_le_ofReal ?_)⟩
    · calc infDist (x - ξ) (horizontalPlane n ℓ : Set (Amb n ℓ))
          ≤ dist (x - ξ) 0 := infDist_le_dist_of_mem (horizontalPlane n ℓ).zero_mem
        _ = dist x ξ := by rw [dist_zero_right, dist_eq_norm]
        _ ≤ σ := mem_closedBall.1 hx.2
    · rw [inv_mul_cancel₀ hσ.ne']
      calc (1 : ℝ) = (δ₁ ^ a)⁻¹ * δ₁ ^ a := (inv_mul_cancel₀ hδ₁a.ne').symm
        _ ≤ C * δ ^ a := mul_le_mul hδ₁C (Real.rpow_le_rpow hδ₁.le hlarge.le ha) hδ₁a.le
            (hC₂.le.trans hC₂C)

/-- Simon Ch. 5, proof of Lemma 3.1 (p. 114), Poincaré inequality, segment step: for a `C¹`
function `φ` on `ℝⁿ` and `x, y ∈ ℝⁿ`,
`|φ(x) - φ(y)|² ≤ |x - y|² ∫_{[0,1]} |∇φ((1 - t) y + t x)|² dt` in `[0, ∞]`.  Along the segment
`γ(t) = (1 - t) y + t x` the chain rule and the fundamental theorem of calculus give
`φ(x) - φ(y) = ∫₀¹ Dφ(γ(t))(x - y) dt`; then `|Dφ(z) v| ≤ |v| |∇φ(z)|` (the gradient is the
Riesz representative of `Dφ(z)`), and Cauchy–Schwarz on the unit interval (`L¹ ≤ L²` for a
probability measure) bounds the square of `∫₀¹ |∇φ(γ(t))| dt`. -/
theorem poincare_c1_segment_sq_bound : ∀ (n : ℕ) (φ : Rn n → ℝ), ContDiff ℝ 1 φ → ∀ x y : Rn n, ‖φ x - φ y‖ₑ ^ 2 ≤ ‖x - y‖ₑ ^ 2 * ∫⁻ t in Icc (0 : ℝ) 1, ‖gradient φ ((1 - t) • y + t • x)‖ₑ ^ 2 := by
  intro n φ hφ x y
  set γ : ℝ → Rn n := fun t => (1 - t) • y + t • x with hγ
  -- 1. the segment and the chain rule
  have hγd : ∀ t, HasDerivAt γ (x - y) t := by
    intro t
    have h1 : HasDerivAt (fun t : ℝ => (1 - t) • y) (-y) t := by
      simpa using ((hasDerivAt_id t).const_sub 1).smul_const y
    have h2 : HasDerivAt (fun t : ℝ => t • x) x t := by
      simpa using (hasDerivAt_id t).smul_const x
    convert h1.add h2 using 1
    abel
  have hud : ∀ t, HasDerivAt (fun t => φ (γ t)) (fderiv ℝ φ (γ t) (x - y)) t := fun t =>
    ((hφ.differentiable one_ne_zero (γ t)).hasFDerivAt).comp_hasDerivAt t (hγd t)
  have hγc : Continuous γ := by fun_prop
  have hderc : Continuous (fun t => fderiv ℝ φ (γ t) (x - y)) :=
    ((hφ.continuous_fderiv one_ne_zero).comp hγc).clm_apply continuous_const
  -- 2. fundamental theorem of calculus
  have hFTC : ∫ t in (0:ℝ)..1, fderiv ℝ φ (γ t) (x - y) = φ x - φ y := by
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hud t)
      (hderc.intervalIntegrable 0 1)]
    simp [γ]
  have hgc : Continuous (gradient φ) :=
    (InnerProductSpace.toDual ℝ (Rn n)).symm.continuous.comp (hφ.continuous_fderiv one_ne_zero)
  -- 3. pointwise Cauchy–Schwarz: |Dφ(z) v| ≤ |v| |∇φ(z)|
  have hpt : ∀ t, ‖fderiv ℝ φ (γ t) (x - y)‖ₑ ≤ ‖x - y‖ₑ * ‖gradient φ (γ t)‖ₑ := by
    intro t
    have : ‖fderiv ℝ φ (γ t) (x - y)‖ ≤ ‖x - y‖ * ‖gradient φ (γ t)‖ := by
      calc ‖fderiv ℝ φ (γ t) (x - y)‖ ≤ ‖fderiv ℝ φ (γ t)‖ * ‖x - y‖ := (fderiv ℝ φ (γ t)).le_opNorm _
        _ = ‖x - y‖ * ‖gradient φ (γ t)‖ := by
          rw [gradient, LinearIsometryEquiv.norm_map, mul_comm]
    rw [← ofReal_norm, ← ofReal_norm, ← ofReal_norm, ← ENNReal.ofReal_mul (norm_nonneg _)]
    exact ENNReal.ofReal_le_ofReal this
  have hle : ‖φ x - φ y‖ₑ ≤ ‖x - y‖ₑ * ∫⁻ t in Ioc (0:ℝ) 1, ‖gradient φ (γ t)‖ₑ := by
    rw [← hFTC, intervalIntegral.integral_of_le zero_le_one]
    calc ‖∫ t in Ioc (0:ℝ) 1, fderiv ℝ φ (γ t) (x - y)‖ₑ
        ≤ ∫⁻ t in Ioc (0:ℝ) 1, ‖fderiv ℝ φ (γ t) (x - y)‖ₑ := enorm_integral_le_lintegral_enorm _
      _ ≤ ∫⁻ t in Ioc (0:ℝ) 1, ‖x - y‖ₑ * ‖gradient φ (γ t)‖ₑ := lintegral_mono fun t => hpt t
      _ = ‖x - y‖ₑ * ∫⁻ t in Ioc (0:ℝ) 1, ‖gradient φ (γ t)‖ₑ :=
          lintegral_const_mul' _ _ enorm_ne_top
  -- 4. Cauchy–Schwarz on (0,1] (a probability space): (∫ a)^2 ≤ ∫ a^2
  have hCS : (∫⁻ t in Ioc (0:ℝ) 1, ‖gradient φ (γ t)‖ₑ) ^ 2 ≤
      ∫⁻ t in Ioc (0:ℝ) 1, ‖gradient φ (γ t)‖ₑ ^ 2 := by
    set μ : Measure ℝ := volume.restrict (Ioc (0:ℝ) 1) with hμ
    have hμ1 : μ univ = 1 := by
      rw [hμ, Measure.restrict_apply_univ, Real.volume_Ioc, sub_zero, ENNReal.ofReal_one]
    have : IsFiniteMeasure μ := ⟨by rw [hμ1]; exact ENNReal.one_lt_top⟩
    have hh : AEStronglyMeasurable (fun t => gradient φ (γ t)) μ := (hgc.comp hγc).aestronglyMeasurable
    have key := eLpNorm_le_eLpNorm_mul_rpow_measure_univ (p := 1) (q := 2) (μ := μ) one_le_two hh
    rw [eLpNorm_one_eq_lintegral_enorm hh,
      eLpNorm_eq_lintegral_rpow_enorm_toReal two_ne_zero ENNReal.ofNat_ne_top hh] at key
    have e1 : (1 / (1 : ℝ≥0∞).toReal - 1 / (2 : ℝ≥0∞).toReal) = 1 / 2 := by norm_num
    rw [e1, hμ1, ENNReal.one_rpow, mul_one] at key
    have e2 : ∀ t, ‖gradient φ (γ t)‖ₑ ^ (2 : ℝ≥0∞).toReal = ‖gradient φ (γ t)‖ₑ ^ 2 := fun t => by
      simp
    simp_rw [e2] at key
    calc (∫⁻ t, ‖gradient φ (γ t)‖ₑ ∂μ) ^ 2
        ≤ ((∫⁻ t, ‖gradient φ (γ t)‖ₑ ^ 2 ∂μ) ^ (1 / (2 : ℝ≥0∞).toReal)) ^ 2 := by gcongr
      _ = ∫⁻ t, ‖gradient φ (γ t)‖ₑ ^ 2 ∂μ := by
        rw [← ENNReal.rpow_mul_natCast]
        norm_num
  -- 5. combine
  calc ‖φ x - φ y‖ₑ ^ 2 ≤ (‖x - y‖ₑ * ∫⁻ t in Ioc (0:ℝ) 1, ‖gradient φ (γ t)‖ₑ) ^ 2 := by gcongr
    _ = ‖x - y‖ₑ ^ 2 * (∫⁻ t in Ioc (0:ℝ) 1, ‖gradient φ (γ t)‖ₑ) ^ 2 := mul_pow _ _ _
    _ ≤ ‖x - y‖ₑ ^ 2 * ∫⁻ t in Ioc (0:ℝ) 1, ‖gradient φ (γ t)‖ₑ ^ 2 := by gcongr
    _ ≤ ‖x - y‖ₑ ^ 2 * ∫⁻ t in Icc (0 : ℝ) 1, ‖gradient φ ((1 - t) • y + t • x)‖ₑ ^ 2 := by
        gcongr
        exact Ioc_subset_Icc_self

/-- **Convex-combination averaging bound on a ball** (the change-of-variables step in the proof of
the Poincaré inequality on convex domains, Gilbarg–Trudinger Lemma 7.16; Evans §5.8.1).  For a
measurable `h ≥ 0`, `r > 0` and `t ∈ [0, 1]`,
`∫_{B_r} ∫_{B_r} h((1 - t) y + t x) dy dx ≤ 2ⁿ |B_r| ∫_{B_r} h`.

Since `B_r` is convex, `(1 - t) y + t x ∈ B_r`.  One of the two variables has coefficient
`s ≥ 1/2`; substituting `z = c + s •` (that variable) (Jacobian `sⁿ`, `Measure.map_addHaar_smul`
and translation invariance) bounds the integral in that variable by `s⁻ⁿ ∫_{B_r} h ≤ 2ⁿ ∫_{B_r} h`,
and integrating this constant over the other variable (after Tonelli when `t ≥ 1/2`) gives the
claim. -/
theorem poincare_ball_convex_combination_bound : ∀ (n : ℕ) (h : Rn n → ℝ≥0∞), Measurable h → ∀ r t : ℝ, 0 < r → 0 ≤ t → t ≤ 1 → ∫⁻ x in ball (0 : Rn n) r, ∫⁻ y in ball (0 : Rn n) r, h ((1 - t) • y + t • x) ≤ (2 : ℝ≥0∞) ^ n * volume (ball (0 : Rn n) r) * ∫⁻ z in ball (0 : Rn n) r, h z := by
  intro n h hh r t hr ht0 ht1
  set B := ball (0 : Rn n) r with hB
  -- 1. affine change of variables: ∫ F(c + s x) dx = |s|^{-n} ∫ F
  have affine : ∀ (F : Rn n → ℝ≥0∞), Measurable F → ∀ (c : Rn n) {s : ℝ}, s ≠ 0 →
      ∫⁻ x, F (c + s • x) = ENNReal.ofReal |(s ^ n)⁻¹| * ∫⁻ z, F z := by
    intro F hF c s hs
    have hm : Measurable (fun z : Rn n => F (c + z)) := hF.comp (measurable_const_add c)
    have hmap := lintegral_map (μ := (volume : Measure (Rn n))) hm
      (measurable_const_smul s : Measurable fun x : Rn n => s • x)
    rw [← hmap, Measure.map_addHaar_smul volume hs, lintegral_smul_measure,
      lintegral_add_left_eq_self (μ := (volume : Measure (Rn n))) F c, smul_eq_mul,
      finrank_euclideanSpace_fin]
  -- 2. convexity of the ball
  have hmem : ∀ x ∈ B, ∀ y ∈ B, (1 - t) • y + t • x ∈ B := fun x hx y hy =>
    convex_ball (0 : Rn n) r hy hx (by linarith) ht0 (by ring)
  -- 3. one-variable bound when the coefficient of the integration variable is ≥ 1/2
  have key : ∀ (c : Rn n) (s : ℝ), 1 / 2 ≤ s → (∀ x ∈ B, c + s • x ∈ B) →
      ∫⁻ x in B, h (c + s • x) ≤ (2 : ℝ≥0∞) ^ n * ∫⁻ z in B, h z := by
    intro c s hs hcs
    have hs' : 0 < s := by linarith
    calc ∫⁻ x in B, h (c + s • x) = ∫⁻ x in B, B.indicator h (c + s • x) := by
          refine setLIntegral_congr_fun measurableSet_ball (fun x hx => ?_)
          rw [indicator_of_mem (hcs x hx)]
      _ ≤ ∫⁻ x, B.indicator h (c + s • x) := setLIntegral_le_lintegral _ _
      _ = ENNReal.ofReal |(s ^ n)⁻¹| * ∫⁻ z, B.indicator h z :=
          affine _ (hh.indicator measurableSet_ball) c hs'.ne'
      _ = ENNReal.ofReal |(s ^ n)⁻¹| * ∫⁻ z in B, h z := by
          rw [lintegral_indicator measurableSet_ball]
      _ ≤ (2 : ℝ≥0∞) ^ n * ∫⁻ z in B, h z := by
          gcongr
          have h1 : |(s ^ n)⁻¹| ≤ (2 : ℝ) ^ n := by
            rw [abs_of_pos (by positivity), ← inv_pow]
            exact pow_le_pow_left₀ (by positivity) (inv_le_of_inv_le₀ (by norm_num) (by linarith)) n
          calc ENNReal.ofReal |(s ^ n)⁻¹| ≤ ENNReal.ofReal ((2 : ℝ) ^ n) := ENNReal.ofReal_le_ofReal h1
            _ = (2 : ℝ≥0∞) ^ n := by rw [ENNReal.ofReal_pow (by norm_num)]; simp
  have hH : Measurable (fun p : Rn n × Rn n => h ((1 - t) • p.2 + t • p.1)) :=
    hh.comp (by fun_prop : Continuous fun p : Rn n × Rn n => (1 - t) • p.2 + t • p.1).measurable
  rcases le_or_gt (1 / 2 : ℝ) t with ht | ht
  · -- 4. t ≥ 1/2: Tonelli, then substitute in x
    rw [lintegral_lintegral_swap hH.aemeasurable]
    calc ∫⁻ y in B, ∫⁻ x in B, h ((1 - t) • y + t • x)
        ≤ ∫⁻ y in B, (2 : ℝ≥0∞) ^ n * ∫⁻ z in B, h z := by
          refine setLIntegral_mono' measurableSet_ball fun y hy => ?_
          exact key ((1 - t) • y) t ht (fun x hx => hmem x hx y hy)
      _ = (2 : ℝ≥0∞) ^ n * volume B * ∫⁻ z in B, h z := by
          rw [setLIntegral_const]; ring
  · -- 5. t < 1/2: substitute in y directly
    calc ∫⁻ x in B, ∫⁻ y in B, h ((1 - t) • y + t • x)
        ≤ ∫⁻ x in B, (2 : ℝ≥0∞) ^ n * ∫⁻ z in B, h z := by
          refine setLIntegral_mono' measurableSet_ball fun x hx => ?_
          have e : ∀ y : Rn n, (1 - t) • y + t • x = t • x + (1 - t) • y := fun y => add_comm _ _
          simp_rw [e]
          exact key (t • x) (1 - t) (by linarith) (fun y hy => by rw [← e]; exact hmem x hx y hy)
      _ = (2 : ℝ≥0∞) ^ n * volume B * ∫⁻ z in B, h z := by
          rw [setLIntegral_const]; ring

/-- Simon Ch. 5, proof of Lemma 3.1 (p. 114), Poincaré inequality, smooth estimate: for a `C¹`
function `φ` on `ℝⁿ` and `0 < r ≤ 1`,
`∫_{B_r} ∫_{B_r} |φ(x) - φ(y)|² dy dx ≤ 2ⁿ⁺² |B_1| ∫_{B_r} |∇φ|²` in `[0, ∞]`.  For
`x, y ∈ B_r` we have `|x - y| < 2r ≤ 2`, so the segment bound gives
`|φ(x) - φ(y)|² ≤ 4 ∫_{[0,1]} |∇φ((1 - t) y + t x)|² dt`; integrating over `B_r × B_r`, moving the
`t`-integral outside (Tonelli) and applying the convex-combination bound
`∫_{B_r} ∫_{B_r} |∇φ((1 - t) y + t x)|² dy dx ≤ 2ⁿ |B_r| ∫_{B_r} |∇φ|²` for each `t ∈ [0, 1]`
gives the claim, since `|[0, 1]| = 1` and `|B_r| ≤ |B_1|`. -/
theorem poincare_c1_ball_double_integral_bound : ∀ (n : ℕ) (φ : Rn n → ℝ), ContDiff ℝ 1 φ → ∀ r : ℝ, 0 < r → r ≤ 1 → ∫⁻ x in ball (0 : Rn n) r, ∫⁻ y in ball (0 : Rn n) r, ‖φ x - φ y‖ₑ ^ 2 ≤ (2 : ℝ≥0∞) ^ (n + 2) * volume (ball (0 : Rn n) 1) * ∫⁻ x in ball (0 : Rn n) r, ‖gradient φ x‖ₑ ^ 2 := by
  intro n φ hφ r hr0 hr1
  set B := ball (0 : Rn n) r with hB
  -- 1. regularity: `∇φ` is continuous, so the integrands are measurable
  have hgc : Continuous (gradient φ) :=
    (InnerProductSpace.toDual ℝ (Rn n)).symm.continuous.comp (hφ.continuous_fderiv one_ne_zero)
  have hgm : Measurable (fun z => ‖gradient φ z‖ₑ ^ 2) := hgc.measurable.enorm.pow_const 2
  have hG1 : Measurable (fun p : (Rn n × Rn n) × ℝ => ‖gradient φ ((1 - p.2) • p.1.2 + p.2 • p.1.1)‖ₑ ^ 2) :=
    hgm.comp (by fun_prop : Continuous (fun p : (Rn n × Rn n) × ℝ => (1 - p.2) • p.1.2 + p.2 • p.1.1)).measurable
  have hG2 : Measurable (fun p : (Rn n × ℝ) × Rn n => ‖gradient φ ((1 - p.1.2) • p.2 + p.1.2 • p.1.1)‖ₑ ^ 2) :=
    hgm.comp (by fun_prop : Continuous (fun p : (Rn n × ℝ) × Rn n => (1 - p.1.2) • p.2 + p.1.2 • p.1.1)).measurable
  -- 2. pointwise bound on `B × B`, from the segment bound and `|x - y| ≤ 2`
  have step1 : ∀ x ∈ B, ∀ y ∈ B, ‖φ x - φ y‖ₑ ^ 2 ≤
      4 * ∫⁻ t in Icc (0:ℝ) 1, ‖gradient φ ((1 - t) • y + t • x)‖ₑ ^ 2 := by
    intro x hx y hy
    refine (poincare_c1_segment_sq_bound n φ hφ x y).trans ?_
    gcongr
    have hxy : ‖x - y‖ ≤ 2 := by
      have := norm_sub_le x y
      rw [hB, mem_ball, dist_zero_right] at hx hy
      linarith
    have : ‖x - y‖ₑ ≤ 2 := by
      rw [← ofReal_norm]
      calc ENNReal.ofReal ‖x - y‖ ≤ ENNReal.ofReal 2 := ENNReal.ofReal_le_ofReal hxy
        _ = 2 := by simp
    calc ‖x - y‖ₑ ^ 2 ≤ 2 ^ 2 := by gcongr
      _ = 4 := by norm_num
  calc ∫⁻ x in B, ∫⁻ y in B, ‖φ x - φ y‖ₑ ^ 2
      ≤ ∫⁻ x in B, ∫⁻ y in B, 4 * ∫⁻ t in Icc (0:ℝ) 1, ‖gradient φ ((1 - t) • y + t • x)‖ₑ ^ 2 := by
        refine setLIntegral_mono' measurableSet_ball fun x hx => ?_
        exact setLIntegral_mono' measurableSet_ball fun y hy => step1 x hx y hy
    -- 3. pull out the constant `4`
    _ = 4 * ∫⁻ x in B, ∫⁻ y in B, ∫⁻ t in Icc (0:ℝ) 1, ‖gradient φ ((1 - t) • y + t • x)‖ₑ ^ 2 := by
        rw [← lintegral_const_mul' _ _ (by norm_num)]
        congr 1; ext x
        rw [← lintegral_const_mul' _ _ (by norm_num)]
    -- 4. Tonelli: move the `t`-integral outside
    _ = 4 * ∫⁻ t in Icc (0:ℝ) 1, ∫⁻ x in B, ∫⁻ y in B, ‖gradient φ ((1 - t) • y + t • x)‖ₑ ^ 2 := by
        congr 1
        have inner : ∀ x, ∫⁻ y in B, ∫⁻ t in Icc (0:ℝ) 1, ‖gradient φ ((1 - t) • y + t • x)‖ₑ ^ 2
            = ∫⁻ t in Icc (0:ℝ) 1, ∫⁻ y in B, ‖gradient φ ((1 - t) • y + t • x)‖ₑ ^ 2 := by
          intro x
          refine lintegral_lintegral_swap ?_
          exact (hG1.comp (measurable_const.prodMk measurable_fst |>.prodMk measurable_snd)).aemeasurable
        simp_rw [inner]
        refine lintegral_lintegral_swap ?_
        exact (hG2.lintegral_prod_right').aemeasurable
    -- 5. the convex-combination bound for each `t ∈ [0, 1]`, and `|[0, 1]| = 1`
    _ ≤ 4 * ∫⁻ t in Icc (0:ℝ) 1, (2 : ℝ≥0∞) ^ n * volume B * ∫⁻ z in B, ‖gradient φ z‖ₑ ^ 2 := by
        gcongr 4 * ?_
        refine setLIntegral_mono' measurableSet_Icc fun t ht => ?_
        exact poincare_ball_convex_combination_bound n _ hgm r t hr0 ht.1 ht.2
    _ = 4 * ((2 : ℝ≥0∞) ^ n * volume B * ∫⁻ z in B, ‖gradient φ z‖ₑ ^ 2) := by
        rw [setLIntegral_const, Real.volume_Icc]; simp
    -- 6. `4 · 2ⁿ = 2ⁿ⁺²` and `|B_r| ≤ |B_1|`
    _ ≤ (2 : ℝ≥0∞) ^ (n + 2) * volume (ball (0 : Rn n) 1) * ∫⁻ x in B, ‖gradient φ x‖ₑ ^ 2 := by
        have hvol : volume B ≤ volume (ball (0 : Rn n) 1) := measure_mono (ball_subset_ball hr1)
        calc 4 * ((2 : ℝ≥0∞) ^ n * volume B * ∫⁻ z in B, ‖gradient φ z‖ₑ ^ 2)
            = (2 : ℝ≥0∞) ^ (n + 2) * volume B * ∫⁻ z in B, ‖gradient φ z‖ₑ ^ 2 := by
              rw [pow_add]; ring
          _ ≤ _ := by gcongr

/-- **Double-integral Poincaré bound for `L²` limits of `C¹` functions on `B_r`** (the passage to
the limit in the Poincaré inequality on balls behind Simon Ch. 5, Lemma 3.1; cf. Gilbarg–Trudinger,
Lemma 7.16 and (7.45), Evans §5.8.1).  Let `0 < r ≤ 1`, let `f`, `g` be a.e.-strongly measurable on
`B_r = B̆_r(0)`, and let `φⱼ ∈ C¹` with `φⱼ → f` and `∇φⱼ → g` in `L²(B_r)`.  Then
`∫_{B_r} ∫_{B_r} |f(x) − f(y)|² dy dx ≤ 2^{n+2} |B̆₁(0)| ∫_{B_r} |g|²` (in `[0, ∞]`).

Pass to a subsequence `φ_{ns i} → f` a.e. on `B_r`, apply Fatou's lemma in `y` and then in `x`,
bound each `φ_{ns i}` by the `C¹` estimate `poincare_c1_ball_double_integral_bound`, and use
Minkowski `‖∇φ_{ns i}‖₂ ≤ ‖g‖₂ + ‖∇φ_{ns i} − g‖₂`, whose last term tends to `0`. -/
theorem poincare_approx_ball_double_integral_bound : ∀ (n : ℕ) (f : Rn n → ℝ) (g : Rn n → Rn n) (φ : ℕ → Rn n → ℝ) (r : ℝ), 0 < r → r ≤ 1 → AEStronglyMeasurable f (volume.restrict (ball (0 : Rn n) r)) → AEStronglyMeasurable g (volume.restrict (ball (0 : Rn n) r)) → (∀ j, ContDiff ℝ 1 (φ j)) → Tendsto (fun j => ∫⁻ x in ball (0 : Rn n) r, ‖φ j x - f x‖ₑ ^ 2) atTop (𝓝 0) → Tendsto (fun j => ∫⁻ x in ball (0 : Rn n) r, ‖gradient (φ j) x - g x‖ₑ ^ 2) atTop (𝓝 0) → ∫⁻ x in ball (0 : Rn n) r, ∫⁻ y in ball (0 : Rn n) r, ‖f x - f y‖ₑ ^ 2 ≤ (2 : ℝ≥0∞) ^ (n + 2) * volume (ball (0 : Rn n) 1) * ∫⁻ x in ball (0 : Rn n) r, ‖g x‖ₑ ^ 2 := by
  intro n f g φ r hr0 hr1 hf hg hφ h1 h2
  set B := ball (0 : Rn n) r with hB
  set μ : Measure (Rn n) := volume.restrict B with hμ
  set C : ℝ≥0∞ := (2 : ℝ≥0∞) ^ (n + 2) * volume (ball (0 : Rn n) 1) with hC
  have hCtop : C ≠ ∞ := ENNReal.mul_ne_top (by simp) measure_ball_lt_top.ne
  -- `L²` bookkeeping: `eLpNorm u 2 μ = (∫⁻ ‖u‖ₑ ^ 2 dμ) ^ (1/2)` for a.e.-strongly measurable `u`.
  have eL2 : ∀ {E : Type} [NormedAddCommGroup E] {u : Rn n → E}, AEStronglyMeasurable u μ →
      eLpNorm u 2 μ = (∫⁻ x, ‖u x‖ₑ ^ 2 ∂μ) ^ (1 / 2 : ℝ) := by
    intro E _ u hu
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal two_ne_zero ENNReal.ofNat_ne_top hu]
    simp
  have eL2sq : ∀ {E : Type} [NormedAddCommGroup E] {u : Rn n → E}, AEStronglyMeasurable u μ →
      eLpNorm u 2 μ ^ 2 = ∫⁻ x, ‖u x‖ₑ ^ 2 ∂μ := by
    intro E _ u hu
    rw [eL2 hu, ← ENNReal.rpow_mul_natCast]
    norm_num
  have tL2 : ∀ {E : Type} [NormedAddCommGroup E] {u : ℕ → Rn n → E},
      (∀ j, AEStronglyMeasurable (u j) μ) → Tendsto (fun j => ∫⁻ x, ‖u j x‖ₑ ^ 2 ∂μ) atTop (𝓝 0) →
      Tendsto (fun j => eLpNorm (u j) 2 μ) atTop (𝓝 0) := by
    intro E _ u hu h
    simp_rw [eL2 (hu _)]
    have := ((ENNReal.continuous_rpow_const (y := (1 / 2 : ℝ))).tendsto 0).comp h
    rwa [ENNReal.zero_rpow_of_pos (by norm_num)] at this
  -- Step 0: replace `f` by a strongly measurable representative `f'`; nothing changes.
  have hff' := hf.ae_eq_mk
  have hfm : StronglyMeasurable (hf.mk f) := hf.stronglyMeasurable_mk
  set f' := hf.mk f
  have hdbl : ∫⁻ x in B, ∫⁻ y in B, ‖f x - f y‖ₑ ^ 2 =
      ∫⁻ x in B, ∫⁻ y in B, ‖f' x - f' y‖ₑ ^ 2 := by
    have hin : ∀ x, ∫⁻ y in B, ‖f x - f y‖ₑ ^ 2 = ∫⁻ y in B, ‖f x - f' y‖ₑ ^ 2 := fun x =>
      lintegral_congr_ae (hff'.mono fun y hy => by simp [hy])
    simp_rw [hin]
    exact lintegral_congr_ae (hff'.mono fun x hx => by simp [hx])
  rw [hdbl]
  have h1' : Tendsto (fun j => ∫⁻ x in B, ‖φ j x - f' x‖ₑ ^ 2) atTop (𝓝 0) := by
    refine h1.congr fun j => ?_
    exact lintegral_congr_ae (hff'.mono fun x hx => by simp only [hx])
  -- Step 1: `φⱼ` and `∇φⱼ = (toDual)⁻¹ ∘ Dφⱼ` are continuous.
  have hφc : ∀ j, Continuous (φ j) := fun j => (hφ j).continuous
  have hgc : ∀ j, Continuous (gradient (φ j)) := fun j =>
    (InnerProductSpace.toDual ℝ (Rn n)).symm.continuous.comp ((hφ j).continuous_fderiv one_ne_zero)
  -- Step 2: `φⱼ → f'` in `L²(μ)`, hence in measure, so a subsequence converges `μ`-a.e.
  have hconv : Tendsto (fun j => eLpNorm (φ j - f') 2 μ) atTop (𝓝 0) :=
    tL2 (fun j => (hφc j).aestronglyMeasurable.sub hfm.aestronglyMeasurable) h1'
  obtain ⟨ns, hns, hae⟩ :=
    (tendstoInMeasure_of_tendsto_eLpNorm two_ne_zero hconv).exists_seq_tendsto_ae
  -- Steps 3–4: Fatou's lemma, first in `y` (for `μ`-a.e. `x`) and then in `x`.
  have hsqc : Continuous (fun p : ℝ × ℝ => ‖p.1 - p.2‖ₑ ^ 2) :=
    (ENNReal.continuous_pow 2).comp (continuous_enorm.comp (continuous_fst.sub continuous_snd))
  have hFatou : ∫⁻ x in B, ∫⁻ y in B, ‖f' x - f' y‖ₑ ^ 2 ≤
      liminf (fun i => ∫⁻ x in B, ∫⁻ y in B, ‖φ (ns i) x - φ (ns i) y‖ₑ ^ 2) atTop := by
    have hpt : ∀ᵐ x ∂μ, ∫⁻ y in B, ‖f' x - f' y‖ₑ ^ 2 ≤
        liminf (fun i => ∫⁻ y in B, ‖φ (ns i) x - φ (ns i) y‖ₑ ^ 2) atTop := by
      filter_upwards [hae] with x hx
      calc ∫⁻ y in B, ‖f' x - f' y‖ₑ ^ 2
          = ∫⁻ y in B, liminf (fun i => ‖φ (ns i) x - φ (ns i) y‖ₑ ^ 2) atTop := by
            refine lintegral_congr_ae ?_
            filter_upwards [hae] with y hy
            exact (((hsqc.tendsto _).comp (hx.prodMk_nhds hy)).liminf_eq).symm
        _ ≤ liminf (fun i => ∫⁻ y in B, ‖φ (ns i) x - φ (ns i) y‖ₑ ^ 2) atTop :=
            lintegral_liminf_le fun i =>
              ((measurable_const.sub (hφc _).measurable).enorm.pow_const 2)
    calc ∫⁻ x in B, ∫⁻ y in B, ‖f' x - f' y‖ₑ ^ 2
        ≤ ∫⁻ x in B, liminf (fun i => ∫⁻ y in B, ‖φ (ns i) x - φ (ns i) y‖ₑ ^ 2) atTop :=
          lintegral_mono_ae hpt
      _ ≤ liminf (fun i => ∫⁻ x in B, ∫⁻ y in B, ‖φ (ns i) x - φ (ns i) y‖ₑ ^ 2) atTop :=
          lintegral_liminf_le fun i =>
            ((((hφc _).measurable.comp measurable_fst).sub
              ((hφc _).measurable.comp measurable_snd)).enorm.pow_const 2).lintegral_prod_right'
  -- Step 5: the `C¹` estimate for `φ_{ns i}` and Minkowski's inequality in `L²(μ)`.
  have hbound : ∀ i, ∫⁻ x in B, ∫⁻ y in B, ‖φ (ns i) x - φ (ns i) y‖ₑ ^ 2 ≤
      C * (eLpNorm g 2 μ + eLpNorm (gradient (φ (ns i)) - g) 2 μ) ^ 2 := by
    intro i
    refine (Submission.poincare_c1_ball_double_integral_bound n (φ (ns i)) (hφ _) r hr0
      hr1).trans ?_
    gcongr
    rw [← eL2sq (hgc _).aestronglyMeasurable]
    gcongr
    calc eLpNorm (gradient (φ (ns i))) 2 μ
        = eLpNorm (g + (gradient (φ (ns i)) - g)) 2 μ := by rw [add_sub_cancel]
      _ ≤ _ := eLpNorm_add_le one_le_two
  -- Step 6: `‖∇φ_{ns i} − g‖₂ → 0`, so the bounds tend to `C ‖g‖₂²` (`C < ∞`).
  have hε : Tendsto (fun j => eLpNorm (gradient (φ j) - g) 2 μ) atTop (𝓝 0) :=
    tL2 (fun j => (hgc j).aestronglyMeasurable.sub hg) h2
  have hlim : Tendsto (fun i => C * (eLpNorm g 2 μ + eLpNorm (gradient (φ (ns i)) - g) 2 μ) ^ 2)
      atTop (𝓝 (C * (eLpNorm g 2 μ + 0) ^ 2)) := by
    refine ENNReal.Tendsto.const_mul ?_ (Or.inr hCtop)
    exact ((ENNReal.continuous_pow 2).tendsto _).comp
      (tendsto_const_nhds.add (hε.comp hns.tendsto_atTop))
  -- Step 7: conclusion.
  calc ∫⁻ x in B, ∫⁻ y in B, ‖f' x - f' y‖ₑ ^ 2
      ≤ liminf (fun i => ∫⁻ x in B, ∫⁻ y in B, ‖φ (ns i) x - φ (ns i) y‖ₑ ^ 2) atTop := hFatou
    _ ≤ liminf (fun i => C * (eLpNorm g 2 μ + eLpNorm (gradient (φ (ns i)) - g) 2 μ) ^ 2) atTop :=
        liminf_le_liminf (Eventually.of_forall hbound)
    _ = C * (eLpNorm g 2 μ + 0) ^ 2 := hlim.liminf_eq
    _ = C * ∫⁻ x in B, ‖g x‖ₑ ^ 2 := by rw [add_zero, eL2sq hg]

/-- **Exhaustion of the unit ball for the double integral** (step `r → 1` of the `W^{1,2}`
Poincaré inequality on `B̆₁(0)`; Gilbarg–Trudinger, Lemma 7.16).  If `f` is a.e.-strongly
measurable on `B̆₁(0)` and `∫_{B̆_r}∫_{B̆_r} |f(x) - f(y)|² dy dx ≤ K` for every `r ∈ (0,1)`, then
the same bound holds on `B̆₁(0)`.  The balls `B̆_{r_m}`, `r_m = 1 - 1/(m+2)`, increase to `B̆₁(0)`;
for a strongly measurable representative of `f` the union formula for directed unions and
monotone convergence reduce the double integral over `B̆₁(0)` to the diagonal radii. -/
theorem poincare_ball_double_integral_exhaustion : ∀ (n : ℕ) (f : Rn n → ℝ) (K : ℝ≥0∞), AEStronglyMeasurable f (volume.restrict (ball (0 : Rn n) 1)) → (∀ r : ℝ, 0 < r → r < 1 → ∫⁻ x in ball (0 : Rn n) r, ∫⁻ y in ball (0 : Rn n) r, ‖f x - f y‖ₑ ^ 2 ≤ K) → ∫⁻ x in ball (0 : Rn n) 1, ∫⁻ y in ball (0 : Rn n) 1, ‖f x - f y‖ₑ ^ 2 ≤ K := by
  intro n f K hf hK
  -- double integrals over `s` only depend on the a.e.-class of `f` on `s`
  have dbl : ∀ {s : Set (Rn n)} {f₁ f₂ : Rn n → ℝ}, f₁ =ᵐ[volume.restrict s] f₂ →
      ∫⁻ x in s, ∫⁻ y in s, ‖f₁ x - f₁ y‖ₑ ^ 2 = ∫⁻ x in s, ∫⁻ y in s, ‖f₂ x - f₂ y‖ₑ ^ 2 := by
    intro s f₁ f₂ h
    have h1 : ∀ x, ∫⁻ y in s, ‖f₁ x - f₁ y‖ₑ ^ 2 = ∫⁻ y in s, ‖f₁ x - f₂ y‖ₑ ^ 2 := fun x =>
      lintegral_congr_ae (h.mono fun y hy => by simp [hy])
    simp_rw [h1]
    exact lintegral_congr_ae (h.mono fun x hx => by simp [hx])
  have hff' := hf.ae_eq_mk
  have hm : StronglyMeasurable (hf.mk f) := hf.stronglyMeasurable_mk
  set f' := hf.mk f
  -- radii `r m = 1 - 1/(m+2)` increase to `1`
  let r : ℕ → ℝ := fun m => 1 - 1 / ((m : ℝ) + 2)
  have hr0 : ∀ m, 0 < r m := fun m => by
    have : (1 : ℝ) / ((m : ℝ) + 2) < 1 := by
      rw [div_lt_one (by positivity)]; linarith [(Nat.cast_nonneg m : (0 : ℝ) ≤ m)]
    simp only [r]; linarith
  have hr1 : ∀ m, r m < 1 := fun m => by
    have : (0 : ℝ) < 1 / ((m : ℝ) + 2) := by positivity
    simp only [r]; linarith
  have hrmono : Monotone r := by
    intro a b hab
    simp only [r]
    have hab' : (a : ℝ) + 2 ≤ (b : ℝ) + 2 := by exact_mod_cast Nat.add_le_add_right hab 2
    have : (1 : ℝ) / ((b : ℝ) + 2) ≤ 1 / ((a : ℝ) + 2) :=
      one_div_le_one_div_of_le (by positivity) hab'
    linarith
  set B : ℕ → Set (Rn n) := fun m => ball 0 (r m) with hBdef
  have hBmono : Monotone B := fun a b hab => ball_subset_ball (hrmono hab)
  have hBdir : Directed (· ⊆ ·) B := hBmono.directed_le
  have hU : ⋃ m, B m = ball (0 : Rn n) 1 := by
    ext x
    simp only [mem_iUnion, mem_ball, dist_zero_right, B]
    constructor
    · rintro ⟨m, hm⟩; exact hm.trans (hr1 m)
    · intro hx
      have h1 : 0 < 1 - ‖x‖ := by linarith
      obtain ⟨m, hm⟩ := exists_nat_gt (1 / (1 - ‖x‖))
      refine ⟨m, ?_⟩
      simp only [r]
      have : 1 / ((m : ℝ) + 2) < 1 - ‖x‖ := by
        rw [div_lt_iff₀ (by positivity)]
        rw [div_lt_iff₀ h1] at hm
        nlinarith [(Nat.cast_nonneg m : (0 : ℝ) ≤ m)]
      linarith
  -- the hypothesis transfers to the representative `f'`
  have hK' : ∀ m, ∫⁻ x in B m, ∫⁻ y in B m, ‖f' x - f' y‖ₑ ^ 2 ≤ K := fun m => by
    rw [← dbl (ae_restrict_of_ae_restrict_of_subset (ball_subset_ball (hr1 m).le) hff')]
    exact hK _ (hr0 m) (hr1 m)
  rw [dbl hff', ← hU]
  have hF : Measurable (fun p : Rn n × Rn n => ‖f' p.1 - f' p.2‖ₑ ^ 2) :=
    ((hm.measurable.comp measurable_fst).sub (hm.measurable.comp measurable_snd)).enorm.pow_const 2
  -- inner integrals: union formula along the directed family `B`
  have hG : ∀ x, ∫⁻ y in ⋃ m, B m, ‖f' x - f' y‖ₑ ^ 2 = ⨆ m, ∫⁻ y in B m, ‖f' x - f' y‖ₑ ^ 2 :=
    fun x => setLIntegral_iUnion_of_directed _ hBdir
  simp_rw [hG]
  -- outer integral: union formula, then monotone convergence
  rw [setLIntegral_iUnion_of_directed _ hBdir]
  refine iSup_le fun k => ?_
  rw [lintegral_iSup (fun m => hF.lintegral_prod_right')
    (fun a b hab x => lintegral_mono_set (hBmono hab))]
  refine iSup_le fun m => ?_
  -- diagonal comparison at the radius `r (max k m)`
  calc ∫⁻ x in B k, ∫⁻ y in B m, ‖f' x - f' y‖ₑ ^ 2
      ≤ ∫⁻ x in B (max k m), ∫⁻ y in B (max k m), ‖f' x - f' y‖ₑ ^ 2 := by
        refine (lintegral_mono_set (hBmono (le_max_left k m))).trans ?_
        exact lintegral_mono fun x => lintegral_mono_set (hBmono (le_max_right k m))
    _ ≤ K := hK' _

/-- Simon Ch. 5, proof of Lemma 3.1 (p. 114), Poincaré inequality, mean-deviation step: for a
measurable `s ⊆ ℝⁿ` of finite measure and `f ∈ L²(s)`,
`∫_s |f - ⨍_s f|² ≤ |s|⁻¹ ∫_s ∫_s |f(x) - f(y)|² dy dx` in `[0, ∞]`.  If `|s| = 0` the left side
vanishes.  Otherwise `f(x) - ⨍_s f = |s|⁻¹ ∫_s (f(x) - f(y)) dy`, and Cauchy–Schwarz on `s`
(`L¹ ≤ L²` for the finite measure `volume.restrict s`) gives
`|f(x) - ⨍_s f|² ≤ |s|⁻¹ ∫_s |f(x) - f(y)|² dy` for every `x`; integrate over `x ∈ s`. -/
theorem poincare_set_mean_deviation_sq_bound : ∀ (n : ℕ) (s : Set (Rn n)) (f : Rn n → ℝ), MeasurableSet s → volume s ≠ ∞ → MemLp f 2 (volume.restrict s) → ∫⁻ x in s, ‖f x - ⨍ y in s, f y‖ₑ ^ 2 ≤ (volume s)⁻¹ * ∫⁻ x in s, ∫⁻ y in s, ‖f x - f y‖ₑ ^ 2 := by
  intro n s f hs hfin hf
  -- 1. null set: the left side vanishes
  by_cases h0 : volume s = 0
  · have : volume.restrict s = 0 := Measure.restrict_eq_zero.mpr h0
    simp [this]
  -- 2. pass to a strongly measurable representative (no side changes)
  have hfa := hf.aestronglyMeasurable
  have hff' : f =ᵐ[volume.restrict s] hfa.mk f := hfa.ae_eq_mk
  have hf'L2 : MemLp (hfa.mk f) 2 (volume.restrict s) := (memLp_congr_ae hff').mp hf
  have hdbl : ∫⁻ x in s, ∫⁻ y in s, ‖f x - f y‖ₑ ^ 2 =
      ∫⁻ x in s, ∫⁻ y in s, ‖hfa.mk f x - hfa.mk f y‖ₑ ^ 2 := by
    have h1 : ∀ x, ∫⁻ y in s, ‖f x - f y‖ₑ ^ 2 = ∫⁻ y in s, ‖f x - hfa.mk f y‖ₑ ^ 2 := fun x =>
      lintegral_congr_ae (hff'.mono fun y hy => by simp [hy])
    simp_rw [h1]
    exact lintegral_congr_ae (hff'.mono fun x hx => by simp [hx])
  rw [hdbl]
  have havg : ⨍ y in s, f y = ⨍ y in s, hfa.mk f y := by
    rw [setAverage_eq, setAverage_eq, integral_congr_ae hff']
  rw [havg]
  set f' := hfa.mk f
  set c := ⨍ y in s, f' y with hc
  rw [lintegral_congr_ae (g := fun x => ‖f' x - c‖ₑ ^ 2) (hff'.mono fun x hx => by simp only [hx])]
  have : IsFiniteMeasure (volume.restrict s) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact hfin.lt_top⟩
  rw [← lintegral_const_mul' _ _ (ENNReal.inv_ne_top.mpr h0)]
  apply lintegral_mono
  intro x
  -- 3. f(x) - λ = |s|⁻¹ ∫_s (f(x) - f(y)) dy
  have hint : Integrable f' (volume.restrict s) := hf'L2.integrable one_le_two
  have hkey : f' x - c = (volume.real s)⁻¹ * ∫ y in s, (f' x - f' y) := by
    have hu : (volume.restrict s).real univ = volume.real s := by simp [Measure.real]
    have hreal : volume.real s ≠ 0 := by
      simp [Measure.real, ENNReal.toReal_eq_zero_iff, h0, hfin]
    rw [integral_sub (integrable_const _) hint, integral_const, hu, hc, setAverage_eq]
    simp only [smul_eq_mul]
    field_simp
  -- 4. Cauchy–Schwarz on s: (∫_s |u|)^2 ≤ |s| ∫_s |u|^2
  have hCS : (∫⁻ y in s, ‖f' x - f' y‖ₑ) ^ 2 ≤ volume s * ∫⁻ y in s, ‖f' x - f' y‖ₑ ^ 2 := by
    have hh : AEStronglyMeasurable (fun y => f' x - f' y) (volume.restrict s) :=
      aestronglyMeasurable_const.sub hint.aestronglyMeasurable
    have key := eLpNorm_le_eLpNorm_mul_rpow_measure_univ (p := 1) (q := 2)
      (μ := volume.restrict s) one_le_two hh
    rw [eLpNorm_one_eq_lintegral_enorm hh,
      eLpNorm_eq_lintegral_rpow_enorm_toReal two_ne_zero ENNReal.ofNat_ne_top hh] at key
    have e1 : (1 / (1 : ℝ≥0∞).toReal - 1 / (2 : ℝ≥0∞).toReal) = 1 / 2 := by norm_num
    rw [e1, Measure.restrict_apply_univ] at key
    have e2 : ∀ y, ‖f' x - f' y‖ₑ ^ (2 : ℝ≥0∞).toReal = ‖f' x - f' y‖ₑ ^ 2 := fun y => by simp
    simp_rw [e2] at key
    calc (∫⁻ y in s, ‖f' x - f' y‖ₑ) ^ 2
        ≤ ((∫⁻ y in s, ‖f' x - f' y‖ₑ ^ 2) ^ (1 / (2 : ℝ≥0∞).toReal) *
            volume s ^ (1 / 2 : ℝ)) ^ 2 := by gcongr
      _ = volume s * ∫⁻ y in s, ‖f' x - f' y‖ₑ ^ 2 := by
        rw [mul_pow, ← ENNReal.rpow_mul_natCast, ← ENNReal.rpow_mul_natCast]
        norm_num
        rw [mul_comm]
  -- 5. pointwise bound and conclusion
  have hnorm : ‖f' x - c‖ₑ ≤ (volume s)⁻¹ * ∫⁻ y in s, ‖f' x - f' y‖ₑ := by
    rw [hkey, enorm_mul]
    gcongr
    · rw [Measure.real, Real.enorm_eq_ofReal (inv_nonneg.mpr ENNReal.toReal_nonneg),
        ENNReal.ofReal_inv_of_pos (ENNReal.toReal_pos h0 hfin), ENNReal.ofReal_toReal hfin]
    · exact enorm_integral_le_lintegral_enorm _
  calc ‖f' x - c‖ₑ ^ 2 ≤ ((volume s)⁻¹ * ∫⁻ y in s, ‖f' x - f' y‖ₑ) ^ 2 := by gcongr
    _ = (volume s)⁻¹ ^ 2 * (∫⁻ y in s, ‖f' x - f' y‖ₑ) ^ 2 := by rw [mul_pow]
    _ ≤ (volume s)⁻¹ ^ 2 * (volume s * ∫⁻ y in s, ‖f' x - f' y‖ₑ ^ 2) := by gcongr
    _ = (volume s)⁻¹ * ∫⁻ y in s, ‖f' x - f' y‖ₑ ^ 2 := by
      rw [pow_two, ← mul_assoc, mul_assoc _ _ (volume s), ENNReal.inv_mul_cancel h0 hfin, mul_one]

/-- **Dilation formula for lower integrals on `ℝⁿ`** (used in the boundary-layer estimate for the
Rellich compactness step in the proof of Simon Ch. 5, Lemma 3.1, p. 114).  For `t > 0`, every
`F : ℝⁿ → [0, ∞]` and every set `E ⊆ ℝⁿ` (neither assumed measurable),
`∫_E F(t x) dx = t^{-n} ∫_{tE} F(y) dy`, where `tE = {y : t⁻¹ y ∈ E}`.
Proof: `T x = t x` is a measurable equivalence with `T⁻¹(tE) = E`, and `T_# Lⁿ = t^{-n} Lⁿ`
(`Measure.map_addHaar_smul`, `finrank ℝ ℝⁿ = n`).  Change of variables along the measurable
embedding `T` needs no measurability of `F` or `E`. -/
theorem ble_sac_lintegral_comp_smul : ∀ (n : ℕ) (F : Rn n → ℝ≥0∞) (E : Set (Rn n)) (t : ℝ), 0 < t → ∫⁻ x in E, F (t • x) = ENNReal.ofReal ((t ^ n)⁻¹) * ∫⁻ y in (fun y => t⁻¹ • y) ⁻¹' E, F y := by
  intro n F E t ht
  -- `T x = t • x` as a measurable equivalence of `ℝⁿ`.
  let e : Rn n ≃ᵐ Rn n := (Homeomorph.smul (Units.mk0 t ht.ne')).toMeasurableEquiv
  have he : ∀ x, e x = t • x := fun x => rfl
  -- `T⁻¹(tE) = E`, since `t⁻¹ • (t • x) = x`.
  have hpre : e ⁻¹' ((fun y => t⁻¹ • y) ⁻¹' E) = E := by
    ext x
    simp only [mem_preimage, he, smul_smul, inv_mul_cancel₀ ht.ne', one_smul]
  -- `T_# Lⁿ = t^{-n} Lⁿ`.
  have hmap : Measure.map e volume = ENNReal.ofReal ((t ^ n)⁻¹) • (volume : Measure (Rn n)) := by
    have := Measure.map_addHaar_smul (volume : Measure (Rn n)) ht.ne'
    rw [finrank_euclideanSpace_fin] at this
    rw [show (e : Rn n → Rn n) = fun x => t • x from funext he, this]
    congr 2
    rw [abs_of_pos (by positivity)]
  -- Change variables along the measurable embedding `T`, then pull out the scalar.
  calc ∫⁻ x in E, F (t • x) = ∫⁻ x in e ⁻¹' ((fun y => t⁻¹ • y) ⁻¹' E), F (e x) := by
        rw [hpre]; simp only [he]
    _ = ∫⁻ y in (fun y => t⁻¹ • y) ⁻¹' E, F y ∂(Measure.map e volume) := by
        rw [e.measurableEmbedding.restrict_map, e.measurableEmbedding.lintegral_map]
    _ = _ := by rw [hmap, Measure.restrict_smul, lintegral_smul_measure, smul_eq_mul]

/-- **Pointwise ray inequality for `C¹` functions** (inequality (2.2) of the smooth annulus
estimate in the boundary-layer estimate for the Rellich compactness step in the proof of Simon
Ch. 5, Lemma 3.1, p. 114).  For `φ ∈ C¹(ℝⁿ)`, `|x| ≤ 1` and `τ ≤ 1`,
`(1 - τ) |φ(x)|² ≤ 2 ∫_τ^1 |φ(t x)|² dt + 2 (1 - τ)² ∫_τ^1 |∇φ(σ x)|² dσ`.
Proof: for `t ∈ [τ, 1]`, the fundamental theorem of calculus along the ray gives
`φ(x) - φ(t x) = ∫_t^1 ⟨∇φ(σ x), x⟩ dσ`, so `|x| ≤ 1` and Cauchy–Schwarz on `[τ, 1]` give
`|φ(x) - φ(t x)|² ≤ (1 - τ) ∫_τ^1 |∇φ(σ x)|² dσ`.  Then `(a + b)² ≤ 2a² + 2b²`, and integrate
over `t ∈ [τ, 1]`, a set of length `1 - τ`. -/
theorem ble_sac_ray_sq_bound : ∀ (n : ℕ) (φ : Rn n → ℝ), ContDiff ℝ 1 φ → ∀ (x : Rn n), ‖x‖ ≤ 1 → ∀ τ : ℝ, τ ≤ 1 → ENNReal.ofReal (1 - τ) * ‖φ x‖ₑ ^ 2 ≤ 2 * (∫⁻ t in Icc τ 1, ‖φ (t • x)‖ₑ ^ 2) + 2 * ENNReal.ofReal ((1 - τ) ^ 2) * ∫⁻ σ in Icc τ 1, ‖gradient φ (σ • x)‖ₑ ^ 2 := by
  intro n φ hφ x hx τ hτ
  have hgc : Continuous (gradient φ) :=
    (InnerProductSpace.toDual ℝ (Rn n)).symm.continuous.comp (hφ.continuous_fderiv one_ne_zero)
  have hdiff : Differentiable ℝ φ := hφ.differentiable one_ne_zero
  -- `d/dσ φ(σ x) = ⟨∇φ(σ x), x⟩`.
  have hderiv : ∀ σ : ℝ, HasDerivAt (fun σ : ℝ => φ (σ • x)) (inner ℝ (gradient φ (σ • x)) x) σ := by
    intro σ
    have h1 : HasFDerivAt φ (fderiv ℝ φ (σ • x)) (σ • x) := (hdiff (σ • x)).hasFDerivAt
    have h2 : HasDerivAt (fun σ : ℝ => σ • x) x σ := by
      simpa using (hasDerivAt_id σ).smul_const x
    have h3 := h1.comp_hasDerivAt σ h2
    rw [inner_gradient_left]
    exact h3
  have hray : Continuous (fun σ : ℝ => σ • x) := continuous_id.smul continuous_const
  have hcont_inner : Continuous (fun σ : ℝ => inner ℝ (gradient φ (σ • x)) x) :=
    (hgc.comp hray).inner continuous_const
  set G : ℝ≥0∞ := ∫⁻ σ in Icc τ 1, ‖gradient φ (σ • x)‖ₑ ^ 2 with hG_def
  set m : ℝ≥0∞ := ∫⁻ σ in Icc τ 1, ‖gradient φ (σ • x)‖ₑ with hm_def
  -- Cauchy–Schwarz on `[τ, 1]`: `m² ≤ (1 - τ) G`.
  have hcs : m ^ 2 ≤ ENNReal.ofReal (1 - τ) * G := by
    have hmeas : AEMeasurable (fun σ : ℝ => ‖gradient φ (σ • x)‖ₑ) (volume.restrict (Icc τ 1)) :=
      (hgc.comp hray).enorm.aemeasurable
    have h := ENNReal.lintegral_mul_le_Lp_mul_Lq (volume.restrict (Icc τ 1))
      Real.HolderConjugate.two_two (aemeasurable_const (b := (1 : ℝ≥0∞))) hmeas
    simp only [Pi.mul_apply, one_mul, setLIntegral_const, Real.volume_Icc,
      ENNReal.rpow_two, one_pow] at h
    calc m ^ 2 ≤ ((ENNReal.ofReal (1 - τ)) ^ (1 / 2 : ℝ) * G ^ (1 / 2 : ℝ)) ^ 2 := by
          gcongr
      _ = ENNReal.ofReal (1 - τ) * G := by
        rw [mul_pow, ← ENNReal.rpow_natCast, ← ENNReal.rpow_natCast, ← ENNReal.rpow_mul,
          ← ENNReal.rpow_mul]
        norm_num
  -- `(p + q)² ≤ 2p² + 2q²` in `[0, ∞]`.
  have hsq : ∀ p q : ℝ≥0∞, (p + q) ^ 2 ≤ 2 * p ^ 2 + 2 * q ^ 2 := by
    intro p q
    rcases eq_or_ne p ⊤ with hp | hp
    · simp [hp]
    rcases eq_or_ne q ⊤ with hq | hq
    · simp [hq]
    lift p to ℝ≥0 using hp
    lift q to ℝ≥0 using hq
    have h := add_sq_le (a := p) (b := q)
    rw [mul_add] at h
    exact_mod_cast h
  -- Pointwise inequality (2.1) for `t ∈ [τ, 1]`.
  have hpt : ∀ t ∈ Icc τ 1, ‖φ x‖ₑ ^ 2 ≤ 2 * ‖φ (t • x)‖ₑ ^ 2 + 2 * (ENNReal.ofReal (1 - τ) * G) := by
    intro t ht
    have hftc : ∫ σ in t..1, inner ℝ (gradient φ (σ • x)) x = φ x - φ (t • x) := by
      rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun σ _ => hderiv σ)
        (hcont_inner.intervalIntegrable t 1)]
      simp
    have hb : ‖φ x - φ (t • x)‖ₑ ≤ m := by
      rw [← hftc, intervalIntegral.integral_of_le ht.2]
      calc ‖∫ σ in Ioc t 1, inner ℝ (gradient φ (σ • x)) x‖ₑ
            ≤ ∫⁻ σ in Ioc t 1, ‖inner ℝ (gradient φ (σ • x)) x‖ₑ :=
              enorm_integral_le_lintegral_enorm _
        _ ≤ ∫⁻ σ in Ioc t 1, ‖gradient φ (σ • x)‖ₑ := by
            apply lintegral_mono
            intro σ
            rw [enorm_le_iff_norm_le]
            calc ‖inner ℝ (gradient φ (σ • x)) x‖ ≤ ‖gradient φ (σ • x)‖ * ‖x‖ :=
                  norm_inner_le_norm _ _
              _ ≤ ‖gradient φ (σ • x)‖ * 1 := by gcongr
              _ = _ := mul_one _
        _ ≤ m := lintegral_mono_set (Ioc_subset_Icc_self.trans (Icc_subset_Icc ht.1 le_rfl))
    have htri : ‖φ x‖ₑ ≤ ‖φ (t • x)‖ₑ + ‖φ x - φ (t • x)‖ₑ := by
      calc ‖φ x‖ₑ = ‖φ (t • x) + (φ x - φ (t • x))‖ₑ := by ring_nf
        _ ≤ _ := enorm_add_le _ _
    calc ‖φ x‖ₑ ^ 2 ≤ (‖φ (t • x)‖ₑ + ‖φ x - φ (t • x)‖ₑ) ^ 2 := by gcongr
      _ ≤ 2 * ‖φ (t • x)‖ₑ ^ 2 + 2 * ‖φ x - φ (t • x)‖ₑ ^ 2 := hsq _ _
      _ ≤ 2 * ‖φ (t • x)‖ₑ ^ 2 + 2 * m ^ 2 := by gcongr
      _ ≤ _ := by gcongr
  -- Integrate (2.1) over `t ∈ [τ, 1]`.
  calc ENNReal.ofReal (1 - τ) * ‖φ x‖ₑ ^ 2 = ∫⁻ t in Icc τ 1, ‖φ x‖ₑ ^ 2 := by
        rw [setLIntegral_const, Real.volume_Icc, mul_comm]
    _ ≤ ∫⁻ t in Icc τ 1, (2 * ‖φ (t • x)‖ₑ ^ 2 + 2 * (ENNReal.ofReal (1 - τ) * G)) :=
        setLIntegral_mono' measurableSet_Icc hpt
    _ = 2 * (∫⁻ t in Icc τ 1, ‖φ (t • x)‖ₑ ^ 2) +
          2 * (ENNReal.ofReal (1 - τ) * G) * ENNReal.ofReal (1 - τ) := by
        rw [lintegral_add_right _ measurable_const, lintegral_const_mul' _ _ (by simp),
          setLIntegral_const, Real.volume_Icc]
    _ = _ := by
        rw [ENNReal.ofReal_pow (by linarith)]
        ring

/-- **Averaged dilation over an annulus** (function term and kernel bound of the boundary-layer
estimate in the proof of Simon Ch. 5, Lemma 3.1, p. 114).  For measurable `F : ℝⁿ → [0, ∞]`,
`1/2 ≤ r < 1`, `s > 0`, `τ ≥ 1/2` and the annulus `A = B̆_s(0) \ B̆_{rs}(0)`,
`∫_{[τ,1]} ∫_A F(t x) dx dt ≤ 2^{n+1} (1 - r) ∫_{B̆_s(0)} F(y) dy`.
Proof: the dilation formula turns the inner integral into `∫ F(y) K(y, t) dy` with
`K(y, t) = t^{-n} 1_S(y, t)`, `S = {(y, t) : r s t ≤ |y| < s t}`; by Tonelli the left side is
`∫ F(y) k(y) dy` with `k(y) = ∫_{[τ,1]} K(y, t) dt`, and `k ≤ 2^{n+1} (1 - r) 1_{B̆_s(0)}`, since
`k` vanishes off `B̆_s(0)`, `t^{-n} ≤ 2^n`, and `K(y, ·)` is supported in
`(|y|/s, |y|/(r s)]`, an interval of length at most `2 (1 - r)`. -/
theorem ble_sac_annulus_dilation_avg_le : ∀ (n : ℕ) (F : Rn n → ℝ≥0∞), Measurable F → ∀ r s τ : ℝ, 1 / 2 ≤ r → r < 1 → 0 < s → 1 / 2 ≤ τ → ∫⁻ t in Icc τ 1, ∫⁻ x in ball (0 : Rn n) s \ ball 0 (r * s), F (t • x) ≤ ENNReal.ofReal (2 ^ (n + 1) * (1 - r)) * ∫⁻ y in ball (0 : Rn n) s, F y := by
  intro n F hF r s τ hr1 hr2 hs hτ
  have hr0 : 0 < r := by linarith
  -- Step 1: the kernel set `S` and the measurable weight `K(y, t) = t^{-n} 1_S(y, t)`.
  set S : Set (Rn n × ℝ) := {p | r * s * p.2 ≤ ‖p.1‖ ∧ ‖p.1‖ < s * p.2} with hS_def
  have hSm : MeasurableSet S := by
    have h1 : Measurable fun p : Rn n × ℝ => r * s * p.2 := measurable_const.mul measurable_snd
    have h2 : Measurable fun p : Rn n × ℝ => ‖p.1‖ := measurable_fst.norm
    have h3 : Measurable fun p : Rn n × ℝ => s * p.2 := measurable_const.mul measurable_snd
    exact (measurableSet_le h1 h2).inter (measurableSet_lt h2 h3)
  set K : Rn n × ℝ → ℝ≥0∞ := fun p => ENNReal.ofReal ((p.2 ^ n)⁻¹) * S.indicator 1 p with hK_def
  have hKm : Measurable K :=
    (ENNReal.measurable_ofReal.comp ((measurable_snd.pow_const n).inv)).mul
      (measurable_one.indicator hSm)
  -- Step 2: for fixed `t ∈ [τ, 1]`, the dilation formula gives `∫_A F(t x) dx = ∫ F(y) K(y, t) dy`,
  -- because `t⁻¹ y ∈ A ↔ (y, t) ∈ S`.
  have step1 : ∀ t ∈ Icc τ 1, ∫⁻ x in ball (0 : Rn n) s \ ball 0 (r * s), F (t • x) =
      ∫⁻ y, F y * K (y, t) := by
    intro t ht
    have ht0 : 0 < t := by linarith [ht.1]
    rw [Submission.ble_sac_lintegral_comp_smul n F _ t ht0]
    have hpre : (fun y => t⁻¹ • y) ⁻¹' (ball (0 : Rn n) s \ ball 0 (r * s)) =
        {y | (y, t) ∈ S} := by
      ext y
      simp only [mem_preimage, Set.mem_sdiff, mem_ball_zero_iff, norm_smul, Real.norm_eq_abs,
        abs_inv, abs_of_pos ht0, not_lt, Set.mem_ofPred_eq, hS_def]
      constructor
      · rintro ⟨h1, h2⟩
        constructor
        · rw [le_inv_mul_iff₀ ht0] at h2; linarith
        · rw [inv_mul_lt_iff₀ ht0] at h1; linarith
      · rintro ⟨h1, h2⟩
        constructor
        · rw [inv_mul_lt_iff₀ ht0]; linarith
        · rw [le_inv_mul_iff₀ ht0]; linarith
    have hSt : MeasurableSet {y : Rn n | (y, t) ∈ S} := measurable_prodMk_right hSm
    rw [hpre, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, ← lintegral_indicator hSt]
    congr 1
    funext y
    by_cases hy : (y, t) ∈ S
    · rw [indicator_of_mem (show y ∈ {y : Rn n | (y, t) ∈ S} from hy)]
      simp only [hK_def, indicator_of_mem hy, Pi.one_apply, mul_one]
      ring
    · rw [indicator_of_notMem (show y ∉ {y : Rn n | (y, t) ∈ S} from hy)]
      simp only [hK_def, indicator_of_notMem hy, mul_zero]
  -- Step 4: the kernel bound `k(y) = ∫_{[τ,1]} K(y, t) dt ≤ 2^{n+1} (1 - r) 1_{B̆_s(0)}(y)`.
  have kernel : ∀ y : Rn n, ∫⁻ t in Icc τ 1, K (y, t) ≤
      (ball (0 : Rn n) s).indicator (fun _ => ENNReal.ofReal (2 ^ (n + 1) * (1 - r))) y := by
    intro y
    by_cases hy : y ∈ ball (0 : Rn n) s
    · rw [indicator_of_mem hy]
      rw [mem_ball_zero_iff] at hy
      -- For `|y| < s`: `K(y, t) ≤ 2^n 1_{(|y|/s, |y|/(r s)]}(t)` for `t ∈ [τ, 1]`.
      have hbound : ∀ t ∈ Icc τ 1, K (y, t) ≤
          (Ioc (‖y‖ / s) (‖y‖ / (r * s))).indicator (fun _ => ENNReal.ofReal (2 ^ n)) t := by
        intro t ht
        have ht0 : 0 < t := by linarith [ht.1]
        by_cases hS : (y, t) ∈ S
        · have hmem : t ∈ Ioc (‖y‖ / s) (‖y‖ / (r * s)) := by
            constructor
            · rw [div_lt_iff₀ hs]; linarith [hS.2]
            · rw [le_div_iff₀ (by positivity)]; linarith [hS.1]
          rw [indicator_of_mem hmem]
          simp only [hK_def, indicator_of_mem hS, Pi.one_apply, mul_one]
          apply ENNReal.ofReal_le_ofReal
          rw [← inv_pow]
          apply pow_le_pow_left₀ (by positivity)
          rw [inv_le_comm₀ ht0 (by norm_num)]
          linarith [ht.1]
        · simp [hK_def, indicator_of_notMem hS]
      -- The support interval has length `|y| (1 - r) / (r s) ≤ 2 (1 - r)`.
      have hlen : ‖y‖ / (r * s) - ‖y‖ / s ≤ 2 * (1 - r) := by
        rw [show ‖y‖ / (r * s) - ‖y‖ / s = ‖y‖ * (1 - r) / (r * s) by field_simp]
        rw [div_le_iff₀ (by positivity)]
        have h1 : ‖y‖ * (1 - r) ≤ s * (1 - r) := mul_le_mul_of_nonneg_right hy.le (by linarith)
        have h2 : s * (1 - r) ≤ 2 * (1 - r) * (r * s) := by
          nlinarith [mul_nonneg (mul_nonneg hs.le (by linarith : (0:ℝ) ≤ 1 - r))
            (by linarith : (0:ℝ) ≤ 2 * r - 1)]
        linarith
      calc ∫⁻ t in Icc τ 1, K (y, t)
            ≤ ∫⁻ t in Icc τ 1, (Ioc (‖y‖ / s) (‖y‖ / (r * s))).indicator
                (fun _ => ENNReal.ofReal (2 ^ n)) t := setLIntegral_mono' measurableSet_Icc hbound
        _ ≤ ∫⁻ t, (Ioc (‖y‖ / s) (‖y‖ / (r * s))).indicator (fun _ => ENNReal.ofReal (2 ^ n)) t :=
            setLIntegral_le_lintegral _ _
        _ = ENNReal.ofReal (2 ^ n) * ENNReal.ofReal (‖y‖ / (r * s) - ‖y‖ / s) := by
            rw [lintegral_indicator_const measurableSet_Ioc, Real.volume_Ioc]
        _ ≤ ENNReal.ofReal (2 ^ n) * ENNReal.ofReal (2 * (1 - r)) := by
            gcongr
        _ = ENNReal.ofReal (2 ^ (n + 1) * (1 - r)) := by
            rw [← ENNReal.ofReal_mul (by positivity)]
            congr 1
            ring
    · -- For `|y| ≥ s`: `s t ≤ s ≤ |y|`, so `(y, t) ∉ S` and `k(y) = 0`.
      rw [indicator_of_notMem hy]
      have hz : ∀ t ∈ Icc τ 1, K (y, t) = 0 := by
        intro t ht
        have hS : (y, t) ∉ S := by
          rintro ⟨_, h2⟩
          rw [mem_ball_zero_iff, not_lt] at hy
          nlinarith [ht.2]
        simp only [hK_def, indicator_of_notMem hS, mul_zero]
      rw [setLIntegral_congr_fun measurableSet_Icc hz, lintegral_zero]
  -- Steps 3 and 5: Tonelli, then integrate the kernel bound against `F`.
  have hmeas : AEMeasurable (Function.uncurry fun (t : ℝ) (y : Rn n) => F y * K (y, t))
      ((volume.restrict (Icc τ 1)).prod volume) :=
    ((hF.comp measurable_snd).mul (hKm.comp (measurable_snd.prodMk measurable_fst))).aemeasurable
  calc ∫⁻ t in Icc τ 1, ∫⁻ x in ball (0 : Rn n) s \ ball 0 (r * s), F (t • x)
        = ∫⁻ t in Icc τ 1, ∫⁻ y, F y * K (y, t) := setLIntegral_congr_fun measurableSet_Icc step1
    _ = ∫⁻ y, ∫⁻ t in Icc τ 1, F y * K (y, t) := lintegral_lintegral_swap hmeas
    _ = ∫⁻ y, F y * ∫⁻ t in Icc τ 1, K (y, t) := by
        congr 1
        funext y
        exact lintegral_const_mul _ (hKm.comp measurable_prodMk_left)
    _ ≤ ∫⁻ y, F y * (ball (0 : Rn n) s).indicator
          (fun _ => ENNReal.ofReal (2 ^ (n + 1) * (1 - r))) y :=
        lintegral_mono (fun y => by gcongr; exact kernel y)
    _ = ∫⁻ y in ball (0 : Rn n) s, F y * ENNReal.ofReal (2 ^ (n + 1) * (1 - r)) := by
        rw [← lintegral_indicator measurableSet_ball]
        congr 1
        funext y
        by_cases hy : y ∈ ball (0 : Rn n) s
        · simp [indicator_of_mem hy]
        · simp [indicator_of_notMem hy]
    _ = _ := by rw [lintegral_mul_const _ hF, mul_comm]

/-- **Smooth annulus estimate** (the smooth step of the boundary-layer estimate for `W^{1,2}` on
balls).  Let `n ≥ 1`, `φ ∈ C¹(ℝⁿ)`, `1/2 ≤ r < 1`, `0 < s ≤ 1`, `a := √(1 - r)` and
`A := B̆_s(0) \ B̆_{rs}(0)`.  Then `∫_A |φ|² ≤ 2^{n+3} a (∫_{B̆_s(0)} |φ|² + ∫_{B̆_s(0)} |∇φ|²)`
(lintegrals of squared extended norms).  With `τ := 1 - a/2 ∈ [1/2, 1)`, integrate the ray
inequality `ble_sac_ray_sq_bound` over `A` and swap the order of integration (Tonelli).  The
dilation formula `ble_sac_lintegral_comp_smul`, with `σA ⊆ B̆_s(0)` and `σ⁻ⁿ ≤ 2ⁿ` for
`σ ∈ [τ, 1]`, bounds the gradient term by `2ⁿ (1 - τ) ∫_{B̆_s(0)} |∇φ|²`; the kernel bound
`ble_sac_annulus_dilation_avg_le` bounds the function term by `2^{n+1} (1 - r) ∫_{B̆_s(0)} |φ|²`.
Dividing by `1 - τ = a/2` and using `1 - r = a²`, `a ≤ 1` gives the constant `2^{n+3} a`. -/
theorem ble_smooth_annulus_estimate : ∀ n : ℕ, 1 ≤ n → ∀ (φ : Rn n → ℝ), ContDiff ℝ 1 φ → ∀ r s : ℝ, 1 / 2 ≤ r → r < 1 → 0 < s → s ≤ 1 → ∫⁻ x in ball (0 : Rn n) s \ ball 0 (r * s), ‖φ x‖ₑ ^ 2 ≤ ENNReal.ofReal (2 ^ (n + 3) * Real.sqrt (1 - r)) * ((∫⁻ x in ball (0 : Rn n) s, ‖φ x‖ₑ ^ 2) + ∫⁻ x in ball (0 : Rn n) s, ‖gradient φ x‖ₑ ^ 2) := by
  intro n _ φ hφ r s hr1 hr2 hs0 hs1
  -- Step 0: `a := √(1 - r) ∈ (0, 1]` with `a² = 1 - r`, and `τ := 1 - a/2 ∈ [1/2, 1]`.
  obtain ⟨a, ha_def⟩ : ∃ a : ℝ, a = Real.sqrt (1 - r) := ⟨_, rfl⟩
  rw [← ha_def]
  have ha0 : 0 < a := by rw [ha_def]; exact Real.sqrt_pos.2 (by linarith)
  have ha1 : a ≤ 1 := by
    rw [ha_def]
    calc Real.sqrt (1 - r) ≤ Real.sqrt 1 := Real.sqrt_le_sqrt (by linarith)
      _ = 1 := Real.sqrt_one
  have ha2 : a ^ 2 = 1 - r := by rw [ha_def]; exact Real.sq_sqrt (by linarith)
  obtain ⟨τ, hτ_def⟩ : ∃ τ : ℝ, τ = 1 - a / 2 := ⟨_, rfl⟩
  have hτ1 : τ ≤ 1 := by rw [hτ_def]; linarith
  have hτ2 : 1 / 2 ≤ τ := by rw [hτ_def]; linarith
  have h1τ : 1 - τ = a / 2 := by rw [hτ_def]; ring
  set A := ball (0 : Rn n) s \ ball 0 (r * s)
  have hA : MeasurableSet A := measurableSet_ball.diff measurableSet_ball
  have hA1 : ∀ x ∈ A, ‖x‖ ≤ 1 := fun x hx => by
    have h := mem_ball_zero_iff.1 hx.1
    linarith
  -- `φ` and `∇φ = (toDual ℝ ℝⁿ)⁻¹ ∘ Dφ` are continuous; measurability for Tonelli.
  have hφc : Continuous φ := hφ.continuous
  have hgc : Continuous (gradient φ) :=
    (InnerProductSpace.toDual ℝ (Rn n)).symm.continuous.comp (hφ.continuous_fderiv one_ne_zero)
  have hFm : Measurable (fun y : Rn n => ‖φ y‖ₑ ^ 2) :=
    ((ENNReal.continuous_pow 2).comp hφc.enorm).measurable
  have hH1 : Measurable (fun p : Rn n × ℝ => ‖φ (p.2 • p.1)‖ₑ ^ 2) :=
    ((ENNReal.continuous_pow 2).comp
      (hφc.comp (continuous_snd.smul continuous_fst)).enorm).measurable
  have hH2 : Measurable (fun p : Rn n × ℝ => ‖gradient φ (p.2 • p.1)‖ₑ ^ 2) :=
    ((ENNReal.continuous_pow 2).comp
      (hgc.comp (continuous_snd.smul continuous_fst)).enorm).measurable
  have hP : Measurable (fun x : Rn n => ∫⁻ t in Icc τ 1, ‖φ (t • x)‖ₑ ^ 2) :=
    hH1.lintegral_prod_right'
  have hQ : Measurable (fun x : Rn n => ∫⁻ σ in Icc τ 1, ‖gradient φ (σ • x)‖ₑ ^ 2) :=
    hH2.lintegral_prod_right'
  -- Step 3: integrate the ray inequality over `A` (where `‖x‖ < s ≤ 1`), then swap integrals.
  have h3 : ENNReal.ofReal (1 - τ) * ∫⁻ x in A, ‖φ x‖ₑ ^ 2 ≤
      2 * (∫⁻ t in Icc τ 1, ∫⁻ x in A, ‖φ (t • x)‖ₑ ^ 2) +
        2 * ENNReal.ofReal ((1 - τ) ^ 2) *
          ∫⁻ σ in Icc τ 1, ∫⁻ x in A, ‖gradient φ (σ • x)‖ₑ ^ 2 := by
    have hs1 : ∫⁻ x in A, ∫⁻ t in Icc τ 1, ‖φ (t • x)‖ₑ ^ 2 =
        ∫⁻ t in Icc τ 1, ∫⁻ x in A, ‖φ (t • x)‖ₑ ^ 2 :=
      lintegral_lintegral_swap hH1.aemeasurable
    have hs2 : ∫⁻ x in A, ∫⁻ σ in Icc τ 1, ‖gradient φ (σ • x)‖ₑ ^ 2 =
        ∫⁻ σ in Icc τ 1, ∫⁻ x in A, ‖gradient φ (σ • x)‖ₑ ^ 2 :=
      lintegral_lintegral_swap hH2.aemeasurable
    calc ENNReal.ofReal (1 - τ) * ∫⁻ x in A, ‖φ x‖ₑ ^ 2
          = ∫⁻ x in A, ENNReal.ofReal (1 - τ) * ‖φ x‖ₑ ^ 2 :=
            (lintegral_const_mul' _ _ ENNReal.ofReal_ne_top).symm
      _ ≤ ∫⁻ x in A, (2 * (∫⁻ t in Icc τ 1, ‖φ (t • x)‖ₑ ^ 2) +
            2 * ENNReal.ofReal ((1 - τ) ^ 2) * ∫⁻ σ in Icc τ 1, ‖gradient φ (σ • x)‖ₑ ^ 2) :=
            setLIntegral_mono' hA fun x hx =>
              Submission.ble_sac_ray_sq_bound n φ hφ x (hA1 x hx) τ hτ1
      _ = 2 * (∫⁻ x in A, ∫⁻ t in Icc τ 1, ‖φ (t • x)‖ₑ ^ 2) +
            2 * ENNReal.ofReal ((1 - τ) ^ 2) *
              ∫⁻ x in A, ∫⁻ σ in Icc τ 1, ‖gradient φ (σ • x)‖ₑ ^ 2 := by
          rw [lintegral_add_left (hP.const_mul 2), lintegral_const_mul _ hP,
            lintegral_const_mul _ hQ]
      _ = _ := by rw [hs1, hs2]
  -- Step 4: gradient term.  For `σ ∈ [τ, 1]`, `∫_A |∇φ(σx)|² dx ≤ 2ⁿ ∫_{B̆_s(0)} |∇φ|²` by the
  -- dilation formula, `σ⁻ⁿ ≤ 2ⁿ` and `σA ⊆ B̆_s(0)`; then integrate over `σ ∈ [τ, 1]`.
  have h4 : ∫⁻ σ in Icc τ 1, ∫⁻ x in A, ‖gradient φ (σ • x)‖ₑ ^ 2 ≤
      ENNReal.ofReal (2 ^ n * (1 - τ)) * ∫⁻ y in ball (0 : Rn n) s, ‖gradient φ y‖ₑ ^ 2 := by
    have hJ : ∀ σ ∈ Icc τ 1, ∫⁻ x in A, ‖gradient φ (σ • x)‖ₑ ^ 2 ≤
        ENNReal.ofReal (2 ^ n) * ∫⁻ y in ball (0 : Rn n) s, ‖gradient φ y‖ₑ ^ 2 := by
      intro σ hσ
      have hσ0 : 0 < σ := by linarith [hσ.1]
      rw [Submission.ble_sac_lintegral_comp_smul n (fun y => ‖gradient φ y‖ₑ ^ 2) A σ hσ0]
      gcongr ?_ * ?_
      · apply ENNReal.ofReal_le_ofReal
        rw [← inv_pow]
        apply pow_le_pow_left₀ (by positivity)
        rw [inv_le_comm₀ hσ0 (by norm_num)]
        linarith [hσ.1]
      · apply lintegral_mono_set
        intro y hy
        rw [Set.mem_preimage] at hy
        have h1 := mem_ball_zero_iff.1 hy.1
        rw [norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hσ0] at h1
        rw [mem_ball_zero_iff]
        calc ‖y‖ = σ * (σ⁻¹ * ‖y‖) := by rw [← mul_assoc, mul_inv_cancel₀ hσ0.ne', one_mul]
          _ < σ * s := by gcongr
          _ ≤ s := by nlinarith [hσ.2]
    calc ∫⁻ σ in Icc τ 1, ∫⁻ x in A, ‖gradient φ (σ • x)‖ₑ ^ 2
          ≤ ∫⁻ σ in Icc τ 1,
              ENNReal.ofReal (2 ^ n) * ∫⁻ y in ball (0 : Rn n) s, ‖gradient φ y‖ₑ ^ 2 :=
            setLIntegral_mono measurable_const hJ
      _ = _ := by
          rw [setLIntegral_const, Real.volume_Icc, ENNReal.ofReal_mul (by positivity)]
          ring
  -- Step 5: function term, by the kernel bound.
  have h5 : ∫⁻ t in Icc τ 1, ∫⁻ x in A, ‖φ (t • x)‖ₑ ^ 2 ≤
      ENNReal.ofReal (2 ^ (n + 1) * (1 - r)) * ∫⁻ y in ball (0 : Rn n) s, ‖φ y‖ₑ ^ 2 :=
    Submission.ble_sac_annulus_dilation_avg_le n (fun y => ‖φ y‖ₑ ^ 2) hFm r s τ hr1 hr2 hs0 hτ2
  -- Step 6: combine, cancel the finite nonzero factor `1 - τ = a/2`, and compare coefficients
  -- using `1 - r = a²` and `a ≤ 1`.
  set X := ∫⁻ x in A, ‖φ x‖ₑ ^ 2
  set P := ∫⁻ y in ball (0 : Rn n) s, ‖φ y‖ₑ ^ 2
  set G := ∫⁻ y in ball (0 : Rn n) s, ‖gradient φ y‖ₑ ^ 2
  have key : ENNReal.ofReal (a / 2) * X ≤
      2 * (ENNReal.ofReal (2 ^ (n + 1) * a ^ 2) * P) +
        2 * ENNReal.ofReal ((a / 2) ^ 2) * (ENNReal.ofReal (2 ^ n * (a / 2)) * G) := by
    rw [← h1τ, ha2]
    refine h3.trans ?_
    gcongr
  have hb0 : ENNReal.ofReal (a / 2) ≠ 0 := by
    rw [Ne, ENNReal.ofReal_eq_zero, not_le]
    positivity
  refine (ENNReal.mul_le_mul_iff_right hb0 ENNReal.ofReal_ne_top).1 (key.trans ?_)
  have h2 : (2 : ℝ≥0∞) = ENNReal.ofReal 2 := (ENNReal.ofReal_ofNat 2).symm
  have e1 : (2 : ℝ≥0∞) * (ENNReal.ofReal (2 ^ (n + 1) * a ^ 2) * P) =
      ENNReal.ofReal (2 * (2 ^ (n + 1) * a ^ 2)) * P := by
    rw [ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2), ← h2, mul_assoc]
  have e2 : (2 : ℝ≥0∞) * ENNReal.ofReal ((a / 2) ^ 2) * (ENNReal.ofReal (2 ^ n * (a / 2)) * G) =
      ENNReal.ofReal (2 * (a / 2) ^ 2 * (2 ^ n * (a / 2))) * G := by
    rw [ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ 2 * (a / 2) ^ 2),
      ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2), ← h2]
    ring
  have e3 : ENNReal.ofReal (a / 2) * (ENNReal.ofReal (2 ^ (n + 3) * a) * (P + G)) =
      ENNReal.ofReal (a / 2 * (2 ^ (n + 3) * a)) * P +
        ENNReal.ofReal (a / 2 * (2 ^ (n + 3) * a)) * G := by
    rw [ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ a / 2)]
    ring
  rw [e1, e2, e3]
  -- `2 · 2^{n+1} a² = (a/2) · 2^{n+3} a` and `2 (a/2)² · 2ⁿ (a/2) = 2ⁿ a² (a/4) ≤ 2ⁿ a² · 4`.
  have c1 : 2 * (2 ^ (n + 1) * a ^ 2) ≤ a / 2 * (2 ^ (n + 3) * a) := le_of_eq (by ring)
  have c2 : 2 * (a / 2) ^ 2 * (2 ^ n * (a / 2)) ≤ a / 2 * (2 ^ (n + 3) * a) := by
    have k1 : 2 * (a / 2) ^ 2 * (2 ^ n * (a / 2)) = 2 ^ n * a ^ 2 * (a / 4) := by ring
    have k2 : a / 2 * (2 ^ (n + 3) * a) = 2 ^ n * a ^ 2 * 4 := by ring
    rw [k1, k2]
    have h0 : (0 : ℝ) ≤ 2 ^ n * a ^ 2 := by positivity
    nlinarith [mul_nonneg h0 (by linarith : (0 : ℝ) ≤ 4 - a / 4)]
  exact add_le_add (mul_le_mul_of_nonneg_right (ENNReal.ofReal_le_ofReal c1) (by positivity))
    (mul_le_mul_of_nonneg_right (ENNReal.ofReal_le_ofReal c2) (by positivity))

/-- Convergence of squared `L²` norms under `L²` convergence (the step "by Minkowski the `L²` norms
converge" in the proof of the boundary-layer estimate).  If `f ∈ L²(μ)`, the `φ_j` are `μ`-a.e.
strongly measurable and `∫ |φ_j − f|² dμ → 0`, then `∫ |φ_j|² dμ → ∫ |f|² dμ` in `[0, ∞]`.
Proof: with `N(h) = eLpNorm h 2 μ`, `∫ |h|² dμ = N(h)²` for a.e. strongly measurable `h`, so
`N(φ_j − f) → 0` (`x ↦ x^{1/2}` is continuous on `[0, ∞]`).  Minkowski gives
`N(f) − N(φ_j − f) ≤ N(φ_j) ≤ N(f) + N(φ_j − f)`, and both bounds tend to `N(f) < ∞`; hence
`N(φ_j) → N(f)`, and squaring is continuous on `[0, ∞]`. -/
theorem ble_lintegral_sq_tendsto_of_l2_tendsto : ∀ {α : Type} [MeasurableSpace α] {E : Type} [NormedAddCommGroup E] (μ : Measure α) (f : α → E) (φ : ℕ → α → E), MemLp f 2 μ → (∀ j, AEStronglyMeasurable (φ j) μ) → Tendsto (fun j => ∫⁻ x, ‖φ j x - f x‖ₑ ^ 2 ∂μ) atTop (𝓝 0) → Tendsto (fun j => ∫⁻ x, ‖φ j x‖ₑ ^ 2 ∂μ) atTop (𝓝 (∫⁻ x, ‖f x‖ₑ ^ 2 ∂μ)) := by
  intro α _ E _ μ f φ hf hφ hlim
  have hfm : AEStronglyMeasurable f μ := hf.aestronglyMeasurable
  -- Step 1: `∫⁻ ‖h‖ₑ ^ 2 = (eLpNorm h 2 μ) ^ 2` for a.e. strongly measurable `h`.
  have hsq : ∀ h : α → E, AEStronglyMeasurable h μ →
      ∫⁻ x, ‖h x‖ₑ ^ 2 ∂μ = eLpNorm h 2 μ ^ 2 := by
    intro h hh
    have := eLpNorm_nnreal_pow_eq_lintegral (p := 2) (by norm_num) hh
    simp only [NNReal.coe_ofNat, ENNReal.coe_ofNat, ENNReal.rpow_two] at this
    exact this.symm
  -- Notation: `a j` is the error norm, `b j` the approximant norm, `c < ∞` the limit norm.
  set a : ℕ → ℝ≥0∞ := fun j => eLpNorm (φ j - f) 2 μ
  set b : ℕ → ℝ≥0∞ := fun j => eLpNorm (φ j) 2 μ with hb
  set c : ℝ≥0∞ := eLpNorm f 2 μ with hc
  have hc_top : c ≠ ∞ := hf.eLpNorm_lt_top.ne
  -- Step 2: `a j → 0`, as the square root of `a j ^ 2 = ∫⁻ ‖φ j - f‖ₑ ^ 2 → 0`.
  have ha0 : Tendsto a atTop (𝓝 0) := by
    have h2 : Tendsto (fun j => a j ^ 2) atTop (𝓝 0) :=
      hlim.congr fun j => hsq _ ((hφ j).sub hfm)
    have h3 : Tendsto (fun j => (a j ^ 2) ^ (1 / 2 : ℝ)) atTop (𝓝 ((0 : ℝ≥0∞) ^ (1 / 2 : ℝ))) :=
      (ENNReal.continuous_rpow_const.tendsto 0).comp h2
    rw [ENNReal.zero_rpow_of_pos (by norm_num)] at h3
    refine h3.congr fun j => ?_
    rw [← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]
    norm_num
  -- Step 3: Minkowski, `b j ≤ c + a j` and `c ≤ b j + a j`.
  have hup : ∀ j, b j ≤ c + a j := by
    intro j
    have : φ j = f + (φ j - f) := by abel
    calc b j = eLpNorm (f + (φ j - f)) 2 μ := by rw [hb]; dsimp only; rw [← this]
      _ ≤ eLpNorm f 2 μ + eLpNorm (φ j - f) 2 μ := eLpNorm_add_le (by norm_num)
  have hlow : ∀ j, c ≤ b j + a j := by
    intro j
    have : f = φ j - (φ j - f) := by abel
    calc c = eLpNorm (φ j - (φ j - f)) 2 μ := by rw [hc]; rw [← this]
      _ ≤ eLpNorm (φ j) 2 μ + eLpNorm (φ j - f) 2 μ := eLpNorm_sub_le (by norm_num)
  -- Step 4: squeeze `c - a j ≤ b j ≤ c + a j`; both bounds tend to `c` because `c ≠ ∞`.
  have hbc : Tendsto b atTop (𝓝 c) := by
    have hU : Tendsto (fun j => c + a j) atTop (𝓝 (c + 0)) := tendsto_const_nhds.add ha0
    have hL : Tendsto (fun j => c - a j) atTop (𝓝 (c - 0)) :=
      ENNReal.Tendsto.sub tendsto_const_nhds ha0 (Or.inl hc_top)
    rw [add_zero] at hU
    rw [tsub_zero] at hL
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le hL hU
      (fun j => tsub_le_iff_right.2 (hlow j)) hup
  -- Step 5: square the limit and convert back to lintegrals by Step 1.
  have := ENNReal.Tendsto.pow (n := 2) hbc
  rw [hsq f hfm]
  exact this.congr fun j => (hsq _ (hφ j)).symm

/-- **Translating a ball into a larger ball does not increase a lintegral** (translation
invariance of Lebesgue measure; Evans, *PDE*, §5.8.2 Theorem 3(i), Gilbarg–Trudinger §7.11).
If `r + ‖w‖ ≤ s`, then `x - w ∈ B̆_s(0)` for every `x ∈ B̆_r(0)`, so for an arbitrary
`F : ℝⁿ → [0, ∞]` (no measurability needed) `∫⁻_{B̆_r(0)} F(x - w) dx ≤ ∫⁻_{B̆_s(0)} F`.

Both set lintegrals are lintegrals of indicators (open balls are measurable), the integrands
compare pointwise as `1_{B̆_r}(x) F(x - w) ≤ (1_{B̆_s} F)(x - w)`, and the change of variables
`x ↦ x - w`, valid for every `[0, ∞]`-valued function, removes the translation. -/
theorem lintegral_ball_comp_sub_le : ∀ (n : ℕ) (F : Rn n → ℝ≥0∞) (r s : ℝ) (w : Rn n), r + ‖w‖ ≤ s → ∫⁻ x in ball (0 : Rn n) r, F (x - w) ≤ ∫⁻ x in ball (0 : Rn n) s, F x := by
  intro n F r s w hrs
  -- Steps 1–2: `x ∈ B̆_r(0)` gives `‖x - w‖ ≤ ‖x‖ + ‖w‖ < r + ‖w‖ ≤ s`, hence the pointwise bound.
  have hpt : ∀ x, (ball (0 : Rn n) r).indicator (fun y => F (y - w)) x ≤
      (ball (0 : Rn n) s).indicator F (x - w) := by
    intro x
    by_cases hx : x ∈ ball (0 : Rn n) r
    · have hxw : x - w ∈ ball (0 : Rn n) s :=
        mem_ball_zero_iff.2 ((norm_sub_le x w).trans_lt (by linarith [mem_ball_zero_iff.1 hx]))
      rw [indicator_of_mem hx, indicator_of_mem hxw]
    · rw [indicator_of_notMem hx]
      exact zero_le
  -- Steps 3–6: indicator form, monotonicity, and translation invariance of Lebesgue measure.
  calc ∫⁻ x in ball (0 : Rn n) r, F (x - w)
      = ∫⁻ x, (ball (0 : Rn n) r).indicator (fun y => F (y - w)) x :=
        (lintegral_indicator measurableSet_ball _).symm
    _ ≤ ∫⁻ x, (ball (0 : Rn n) s).indicator F (x - w) := lintegral_mono hpt
    _ = ∫⁻ x, (ball (0 : Rn n) s).indicator F x :=
        lintegral_sub_right_eq_self ((ball (0 : Rn n) s).indicator F) w
    _ = ∫⁻ x in ball (0 : Rn n) s, F x := lintegral_indicator measurableSet_ball F

/-- Crude `L²` bound for translation differences on balls, used for the translation estimate in
the proof of Simon Ch. 5, Lemma 3.1 (p. 114): if `r + ‖z‖ ≤ s` and `h` is a.e. strongly measurable
on `B_s`, then `∫_{B_r} |h(x - z) - h(x)|² ≤ 4 ∫_{B_s} |h|²`.  Pointwise
`|h(x - z) - h(x)|² ≤ 2 |h(x - z)|² + 2 |h(x)|²`; the translated term is bounded by
`lintegral_ball_comp_sub_le` and the untranslated one by `B_r ⊆ B_s`. -/
theorem lintegral_ball_translation_difference_le : ∀ (n : ℕ) (h : Rn n → ℝ) (r s : ℝ) (z : Rn n), r + ‖z‖ ≤ s → AEStronglyMeasurable h (volume.restrict (ball (0 : Rn n) s)) → ∫⁻ x in ball (0 : Rn n) r, ‖h (x - z) - h x‖ₑ ^ 2 ≤ 4 * ∫⁻ x in ball (0 : Rn n) s, ‖h x‖ₑ ^ 2 := by
  intro n h r s z hrs hh
  -- `B_r ⊆ B_s`, so the untranslated summand is a.e. measurable on `B_r`.
  have hsub : ball (0 : Rn n) r ⊆ ball 0 s :=
    ball_subset_ball ((le_add_of_nonneg_right (norm_nonneg z)).trans hrs)
  have hmeas : AEMeasurable (fun x => 2 * ‖h x‖ₑ ^ 2) (volume.restrict (ball (0 : Rn n) r)) :=
    ((hh.mono_measure (Measure.restrict_mono hsub le_rfl)).enorm.pow_const 2).const_mul 2
  -- `(a + b)² ≤ 2a² + 2b²` in `ℝ≥0∞` (the power-mean inequality for `p = 2`).
  have hsq : ∀ a b : ℝ≥0∞, (a + b) ^ 2 ≤ 2 * a ^ 2 + 2 * b ^ 2 := fun a b => by
    have h2 := ENNReal.rpow_add_le_mul_rpow_add_rpow a b (p := 2) (by norm_num)
    norm_num at h2
    simpa [mul_add] using h2
  calc ∫⁻ x in ball (0 : Rn n) r, ‖h (x - z) - h x‖ₑ ^ 2
      ≤ ∫⁻ x in ball (0 : Rn n) r, (2 * ‖h (x - z)‖ₑ ^ 2 + 2 * ‖h x‖ₑ ^ 2) :=
        lintegral_mono fun x => (pow_le_pow_left' enorm_sub_le 2).trans (hsq _ _)
    _ = 2 * (∫⁻ x in ball (0 : Rn n) r, ‖h (x - z)‖ₑ ^ 2) +
          2 * ∫⁻ x in ball (0 : Rn n) r, ‖h x‖ₑ ^ 2 := by
        rw [lintegral_add_right' _ hmeas, lintegral_const_mul' _ _ (by norm_num),
          lintegral_const_mul' _ _ (by norm_num)]
    _ ≤ 2 * (∫⁻ x in ball (0 : Rn n) s, ‖h x‖ₑ ^ 2) +
          2 * ∫⁻ x in ball (0 : Rn n) s, ‖h x‖ₑ ^ 2 :=
        add_le_add
          (mul_le_mul_right
            (Submission.lintegral_ball_comp_sub_le n (fun y => ‖h y‖ₑ ^ 2) r s z hrs) 2)
          (mul_le_mul_right (lintegral_mono_set hsub) 2)
    _ = 4 * ∫⁻ x in ball (0 : Rn n) s, ‖h x‖ₑ ^ 2 := by ring

/-- **Translation estimate for `C¹` functions** (Evans, *PDE*, §5.8.2 Theorem 3(i);
Gilbarg–Trudinger §7.11): for `φ ∈ C¹(ℝⁿ)`, `r ∈ ℝ` and `z ∈ ℝⁿ`,
`∫⁻_{B̆_r(0)} |φ(x - z) - φ(x)|² dx ≤ |z|² ∫⁻_{B̆_{r+|z|}(0)} |∇φ|²` in `[0, ∞]`.

The segment bound `poincare_c1_segment_sq_bound` at the pair `(x - z, x)` gives
`|φ(x - z) - φ(x)|² ≤ |z|² ∫⁻_{[0,1]} |∇φ(x - t z)|² dt` for every `x`.  Integrate over `B̆_r(0)`
and swap the integrals (Tonelli; the integrand is continuous in `(x, t)`).  For `t ∈ [0, 1]`,
`|t z| ≤ |z|`, so `lintegral_ball_comp_sub_le` bounds each inner integral by
`∫⁻_{B̆_{r+|z|}(0)} |∇φ|²`, and `[0, 1]` has measure one. -/
theorem contDiff_one_ball_translation_estimate : ∀ (n : ℕ) (φ : Rn n → ℝ), ContDiff ℝ 1 φ → ∀ (r : ℝ) (z : Rn n), ∫⁻ x in ball (0 : Rn n) r, ‖φ (x - z) - φ x‖ₑ ^ 2 ≤ ENNReal.ofReal (‖z‖ ^ 2) * ∫⁻ x in ball (0 : Rn n) (r + ‖z‖), ‖gradient φ x‖ₑ ^ 2 := by
  intro n φ hφ r z
  -- Step 0: `∇φ = toDual⁻¹ ∘ Dφ` is continuous, so the Tonelli integrand is Borel measurable.
  have hgc : Continuous (gradient φ) :=
    (InnerProductSpace.toDual ℝ (Rn n)).symm.continuous.comp (hφ.continuous_fderiv one_ne_zero)
  have hmeas : Measurable (fun p : Rn n × ℝ => ‖gradient φ (p.1 - p.2 • z)‖ₑ ^ 2) :=
    ((hgc.comp (continuous_fst.sub (continuous_snd.smul continuous_const))).measurable.enorm).pow_const 2
  -- Steps 1–4: the segment bound at the pair `(x - z, x)`, whose segment is `t ↦ x - t z`.
  have hpt : ∀ x : Rn n, ‖φ (x - z) - φ x‖ₑ ^ 2 ≤
      ‖z‖ₑ ^ 2 * ∫⁻ t in Icc (0 : ℝ) 1, ‖gradient φ (x - t • z)‖ₑ ^ 2 := by
    intro x
    have e1 : x - z - x = -z := by abel
    have e2 : ∀ t : ℝ, (1 - t) • x + t • (x - z) = x - t • z := fun t => by module
    calc ‖φ (x - z) - φ x‖ₑ ^ 2
        ≤ ‖x - z - x‖ₑ ^ 2 *
            ∫⁻ t in Icc (0 : ℝ) 1, ‖gradient φ ((1 - t) • x + t • (x - z))‖ₑ ^ 2 :=
          poincare_c1_segment_sq_bound n φ hφ (x - z) x
      _ = ‖z‖ₑ ^ 2 * ∫⁻ t in Icc (0 : ℝ) 1, ‖gradient φ (x - t • z)‖ₑ ^ 2 := by
          simp only [e1, e2, enorm_neg]
  -- Steps 5–8: integrate over `B̆_r(0)`, swap the integrals, translate by `t z`, and use
  -- `|[0, 1]| = 1` and `‖z‖ₑ² = ofReal ‖z‖²`.
  calc ∫⁻ x in ball (0 : Rn n) r, ‖φ (x - z) - φ x‖ₑ ^ 2
      ≤ ∫⁻ x in ball (0 : Rn n) r,
          ‖z‖ₑ ^ 2 * ∫⁻ t in Icc (0 : ℝ) 1, ‖gradient φ (x - t • z)‖ₑ ^ 2 :=
        lintegral_mono hpt
    _ = ‖z‖ₑ ^ 2 * ∫⁻ x in ball (0 : Rn n) r,
          ∫⁻ t in Icc (0 : ℝ) 1, ‖gradient φ (x - t • z)‖ₑ ^ 2 :=
        lintegral_const_mul' _ _ (ENNReal.pow_ne_top enorm_ne_top)
    _ = ‖z‖ₑ ^ 2 * ∫⁻ t in Icc (0 : ℝ) 1,
          ∫⁻ x in ball (0 : Rn n) r, ‖gradient φ (x - t • z)‖ₑ ^ 2 := by
        rw [lintegral_lintegral_swap hmeas.aemeasurable]
    _ ≤ ‖z‖ₑ ^ 2 * ∫⁻ t in Icc (0 : ℝ) 1,
          ∫⁻ y in ball (0 : Rn n) (r + ‖z‖), ‖gradient φ y‖ₑ ^ 2 := by
        refine mul_le_mul_right (setLIntegral_mono measurable_const fun t ht => ?_) _
        refine lintegral_ball_comp_sub_le n (fun y => ‖gradient φ y‖ₑ ^ 2) r (r + ‖z‖) (t • z) ?_
        rw [norm_smul, Real.norm_of_nonneg ht.1]
        have : t * ‖z‖ ≤ ‖z‖ := mul_le_of_le_one_left (norm_nonneg _) ht.2
        linarith
    _ = ENNReal.ofReal (‖z‖ ^ 2) * ∫⁻ x in ball (0 : Rn n) (r + ‖z‖), ‖gradient φ x‖ₑ ^ 2 := by
        rw [setLIntegral_const, Real.volume_Icc, sub_zero, ENNReal.ofReal_one, mul_one,
          ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm]

/-- **`L²` approximation preserves a quadratic energy bound** (Minkowski's inequality in `L²`; the
limit step `j → ∞` in the proof of the translation estimate, Evans §5.8.2 Thm 3(i),
Gilbarg–Trudinger §7.11).  If `aⱼ → a₀` in `L²(μ)`, `bⱼ → b₀` in `L²(ν)` and
`∫⁻ ‖aⱼ‖ₑ² dμ ≤ c ∫⁻ ‖bⱼ‖ₑ² dν` for every `j` with `c < ∞`, then `∫⁻ ‖a₀‖ₑ² dμ ≤ c ∫⁻ ‖b₀‖ₑ² dν`.

With `N = eLpNorm · 2` and `γ = c^{1/2}`, Minkowski gives
`N(a₀) ≤ N(a₀ - aⱼ) + γ (N(bⱼ - b₀) + N(b₀))` for every `j`; the error terms tend to `0`, so
`N(a₀) ≤ γ N(b₀)`, and squaring gives the claim (infinite integrals included). -/
theorem lintegral_sq_le_of_l2_approximation : ∀ {α E F : Type} [MeasurableSpace α] [NormedAddCommGroup E] [NormedAddCommGroup F] (μ ν : Measure α) (c : ℝ≥0∞) (a : ℕ → α → E) (a₀ : α → E) (b : ℕ → α → F) (b₀ : α → F), c ≠ ∞ → (∀ j, AEStronglyMeasurable (a j) μ) → AEStronglyMeasurable a₀ μ → (∀ j, AEStronglyMeasurable (b j) ν) → AEStronglyMeasurable b₀ ν → Tendsto (fun j => ∫⁻ x, ‖a j x - a₀ x‖ₑ ^ 2 ∂μ) atTop (𝓝 0) → Tendsto (fun j => ∫⁻ x, ‖b j x - b₀ x‖ₑ ^ 2 ∂ν) atTop (𝓝 0) → (∀ j, ∫⁻ x, ‖a j x‖ₑ ^ 2 ∂μ ≤ c * ∫⁻ x, ‖b j x‖ₑ ^ 2 ∂ν) → ∫⁻ x, ‖a₀ x‖ₑ ^ 2 ∂μ ≤ c * ∫⁻ x, ‖b₀ x‖ₑ ^ 2 ∂ν := by
  intro α E F _ _ _ μ ν c a a₀ b b₀ hc ha ha₀ hb hb₀ hA hB hab
  -- Step 1: `N(u) = eLpNorm u 2 m` has `N(u) ^ 2 = ∫⁻ ‖u‖ₑ ^ 2 dm` and
  -- `N(u) = (∫⁻ ‖u‖ₑ ^ 2 dm) ^ (1/2)` (`eLpNorm` is `∞` off a.e.-strongly measurable functions).
  have hsq : ∀ {G : Type} [NormedAddCommGroup G] {m : Measure α} {u : α → G},
      AEStronglyMeasurable u m → eLpNorm u 2 m ^ 2 = ∫⁻ x, ‖u x‖ₑ ^ 2 ∂m := by
    intro G _ m u hu
    simpa [ENNReal.rpow_two] using eLpNorm_nnreal_pow_eq_lintegral (p := 2) two_ne_zero hu
  have hroot : ∀ {G : Type} [NormedAddCommGroup G] {m : Measure α} {u : α → G},
      AEStronglyMeasurable u m → eLpNorm u 2 m = (∫⁻ x, ‖u x‖ₑ ^ 2 ∂m) ^ (1 / 2 : ℝ) := by
    intro G _ m u hu
    rw [← hsq hu, ← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]
    norm_num
  -- Step 2: `γ = c ^ (1/2)` is finite and `γ ^ 2 = c`.
  obtain ⟨γ, hγ, hγ2⟩ : ∃ γ : ℝ≥0∞, γ ≠ ∞ ∧ γ ^ 2 = c := by
    refine ⟨c ^ (1 / 2 : ℝ), ENNReal.rpow_ne_top_of_nonneg (by norm_num) hc, ?_⟩
    rw [← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]
    norm_num
  -- Steps 3–7: for every `j`, `N(a₀) ≤ N(a₀ - aⱼ) + γ (N(bⱼ - b₀) + N(b₀))`.
  have hbound : ∀ j, eLpNorm a₀ 2 μ ≤
      eLpNorm (a₀ - a j) 2 μ + γ * (eLpNorm (b j - b₀) 2 ν + eLpNorm b₀ 2 ν) := by
    intro j
    have h4 : eLpNorm a₀ 2 μ ≤ eLpNorm (a₀ - a j) 2 μ + eLpNorm (a j) 2 μ := by
      simpa using eLpNorm_add_le (f := a₀ - a j) (g := a j) (μ := μ) one_le_two
    -- `N(aⱼ)² ≤ c N(bⱼ)² = (γ N(bⱼ))²`, and squaring is order-reflecting on `[0, ∞]`.
    have h5 : eLpNorm (a j) 2 μ ≤ γ * eLpNorm (b j) 2 ν := by
      rw [← ENNReal.rpow_le_rpow_iff (z := 2) (by norm_num), ENNReal.rpow_two, ENNReal.rpow_two,
        mul_pow, hsq (ha j), hsq (hb j), hγ2]
      exact hab j
    have h6 : eLpNorm (b j) 2 ν ≤ eLpNorm (b j - b₀) 2 ν + eLpNorm b₀ 2 ν := by
      simpa using eLpNorm_add_le (f := b j - b₀) (g := b₀) (μ := ν) one_le_two
    calc eLpNorm a₀ 2 μ ≤ eLpNorm (a₀ - a j) 2 μ + eLpNorm (a j) 2 μ := h4
      _ ≤ eLpNorm (a₀ - a j) 2 μ + γ * eLpNorm (b j) 2 ν := by gcongr
      _ ≤ eLpNorm (a₀ - a j) 2 μ + γ * (eLpNorm (b j - b₀) 2 ν + eLpNorm b₀ 2 ν) := by gcongr
  -- Step 8: the error terms tend to `0`, since `t ↦ t ^ (1/2)` is continuous with `0 ^ (1/2) = 0`.
  have hroot0 : ∀ {f : ℕ → ℝ≥0∞}, Tendsto f atTop (𝓝 0) →
      Tendsto (fun j => f j ^ (1 / 2 : ℝ)) atTop (𝓝 0) := by
    intro f hf
    simpa [Function.comp_def, ENNReal.zero_rpow_of_pos] using
      ((ENNReal.continuous_rpow_const (y := (1 / 2 : ℝ))).tendsto 0).comp hf
  have hA' : Tendsto (fun j => eLpNorm (a₀ - a j) 2 μ) atTop (𝓝 0) :=
    (hroot0 hA).congr fun j =>
      ((eLpNorm_sub_comm a₀ (a j) 2 μ).trans (hroot ((ha j).sub ha₀))).symm
  have hB' : Tendsto (fun j => eLpNorm (b j - b₀) 2 ν) atTop (𝓝 0) :=
    (hroot0 hB).congr fun j => (hroot ((hb j).sub hb₀)).symm
  -- Step 9: pass to the limit (`γ < ∞`, so `t ↦ γ t` is continuous).
  have hlim : Tendsto (fun j => eLpNorm (a₀ - a j) 2 μ +
      γ * (eLpNorm (b j - b₀) 2 ν + eLpNorm b₀ 2 ν)) atTop (𝓝 (γ * eLpNorm b₀ 2 ν)) := by
    simpa using hA'.add (ENNReal.Tendsto.const_mul (hB'.add tendsto_const_nhds) (Or.inr hγ))
  have h9 : eLpNorm a₀ 2 μ ≤ γ * eLpNorm b₀ 2 ν := ge_of_tendsto' hlim hbound
  -- Step 10: square.
  calc ∫⁻ x, ‖a₀ x‖ₑ ^ 2 ∂μ = eLpNorm a₀ 2 μ ^ 2 := (hsq ha₀).symm
    _ ≤ (γ * eLpNorm b₀ 2 ν) ^ 2 := by gcongr
    _ = c * ∫⁻ x, ‖b₀ x‖ₑ ^ 2 ∂ν := by rw [mul_pow, hγ2, hsq hb₀]

/-- **Translates of a.e.-strongly measurable functions on balls.**  If `r + ‖z‖ ≤ s` and `h` is
a.e.-strongly measurable for Lebesgue measure on `B̆_s(0)`, then so is `x ↦ h(x - z)` on `B̆_r(0)`.

The translation `τ(x) = x - z` preserves Lebesgue measure, hence also maps Lebesgue measure on
`τ⁻¹(B̆_s(0))` to Lebesgue measure on `B̆_s(0)`; a.e.-strong measurability pulls back along such a
map, and `B̆_r(0) ⊆ τ⁻¹(B̆_s(0))` because `‖x - z‖ ≤ ‖x‖ + ‖z‖ < r + ‖z‖ ≤ s`. -/
theorem aestronglyMeasurable_ball_comp_sub : ∀ (n : ℕ) (h : Rn n → ℝ) (r s : ℝ) (z : Rn n), r + ‖z‖ ≤ s → AEStronglyMeasurable h (volume.restrict (ball (0 : Rn n) s)) → AEStronglyMeasurable (fun x => h (x - z)) (volume.restrict (ball (0 : Rn n) r)) := by
  intro n h r s z hrs hh
  -- Steps 1–2: `τ` is measure preserving, also from the restriction to `τ⁻¹(B̆_s(0))`
  -- to the restriction to `B̆_s(0)`.
  have hmp : MeasurePreserving (fun x : Rn n => x - z)
      (volume.restrict ((fun x : Rn n => x - z) ⁻¹' ball 0 s)) (volume.restrict (ball 0 s)) :=
    (measurePreserving_sub_right volume z).restrict_preimage measurableSet_ball
  -- Step 3: compose a strongly measurable representative of `h` with `τ`.
  have hcomp : AEStronglyMeasurable (fun x => h (x - z))
      (volume.restrict ((fun x : Rn n => x - z) ⁻¹' ball 0 s)) :=
    hh.comp_measurePreserving hmp
  -- Step 4: `B̆_r(0) ⊆ τ⁻¹(B̆_s(0))`.
  have hsub : ball (0 : Rn n) r ⊆ (fun x : Rn n => x - z) ⁻¹' ball 0 s := by
    intro x hx
    rw [mem_preimage, mem_ball_zero_iff]
    exact (norm_sub_le x z).trans_lt (by linarith [mem_ball_zero_iff.1 hx])
  -- Step 5: pass to the smaller measure.
  exact hcomp.mono_measure (Measure.restrict_mono hsub le_rfl)

/-- **`L²` contraction of mollification** (Young's inequality with exponents `(1, 2; 2)`;
Gilbarg–Trudinger §7.2, Evans Appendix C).  Convolution with a continuous probability kernel
`ρ ≥ 0`, `∫ ρ = 1`, does not increase the `L²` energy: `∫⁻ ‖ρ ⋆ H‖ₑ² ≤ ∫⁻ ‖H‖ₑ²`.

With the weight `a = ofReal ∘ ρ` (mass one), `‖∫ ρ(z) H(x - z) dz‖ₑ ≤ ∫⁻ a(z) ‖H(x - z)‖ₑ dz`, and
Hölder's inequality for `a^{1/2}` and `a^{1/2} ‖H(x - ·)‖ₑ` bounds the square of the right side by
`∫⁻ a(z) ‖H(x - z)‖ₑ² dz`.  Integrating in `x`, Tonelli and the translation invariance of Lebesgue
measure turn the double integral into `(∫⁻ a) ∫⁻ ‖H‖ₑ² = ∫⁻ ‖H‖ₑ²`. -/
theorem mollifier_l2_contraction : ∀ (n : ℕ) (E : Type) [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E] (ρ : Rn n → ℝ) (H : Rn n → E), Continuous ρ → (∀ z, 0 ≤ ρ z) → ∫ z, ρ z = 1 → AEStronglyMeasurable H volume → ∫⁻ x, ‖∫ z, ρ z • H (x - z)‖ₑ ^ 2 ≤ ∫⁻ x, ‖H x‖ₑ ^ 2 := by
  intro n E _ _ _ ρ H hρc hρ0 hρ1 hH
  -- Step 1: `ρ` is integrable, so the weight `a = ofReal ∘ ρ` has mass one.
  have hρi : Integrable ρ := integrable_of_integral_eq_one hρ1
  have hmass : ∫⁻ z, ENNReal.ofReal (ρ z) = 1 := by
    rw [← ofReal_integral_eq_lintegral_ofReal hρi (Eventually.of_forall hρ0), hρ1,
      ENNReal.ofReal_one]
  -- Step 2: measurability of the weight and of `‖H‖ₑ`.
  have ha : AEMeasurable (fun z => ENNReal.ofReal (ρ z)) volume :=
    (ENNReal.measurable_ofReal.comp hρc.measurable).aemeasurable
  have hh : AEMeasurable (fun y => ‖H y‖ₑ) volume := hH.enorm
  -- Steps 3–5: `‖∫ ρ(z) H(x - z) dz‖ₑ² ≤ ∫⁻ a(z) ‖H(x - z)‖ₑ² dz` for every `x`.
  have hpt : ∀ x, ‖∫ z, ρ z • H (x - z)‖ₑ ^ 2 ≤
      ∫⁻ z, ENNReal.ofReal (ρ z) * ‖H (x - z)‖ₑ ^ 2 := by
    intro x
    have h1 : ‖∫ z, ρ z • H (x - z)‖ₑ ≤ ∫⁻ z, ENNReal.ofReal (ρ z) * ‖H (x - z)‖ₑ := by
      refine (enorm_integral_le_lintegral_enorm _).trans (le_of_eq ?_)
      congr 1; funext z
      rw [enorm_smul, Real.enorm_of_nonneg (hρ0 z)]
    have hg : AEMeasurable (fun z => ‖H (x - z)‖ₑ) volume :=
      hh.comp_quasiMeasurePreserving
        (Measure.measurePreserving_sub_left volume x).quasiMeasurePreserving
    -- Hölder with `p = q = 2` for `a^{1/2}` and `a^{1/2} ‖H(x - ·)‖ₑ`, then `∫⁻ a = 1`.
    have key := ENNReal.lintegral_mul_le_Lp_mul_Lq volume Real.HolderConjugate.two_two
      (f := fun z => ENNReal.ofReal (ρ z) ^ (1 / 2 : ℝ))
      (g := fun z => ENNReal.ofReal (ρ z) ^ (1 / 2 : ℝ) * ‖H (x - z)‖ₑ)
      (ha.pow_const _) ((ha.pow_const _).mul hg)
    have e1 : ∀ t s : ℝ≥0∞, t ^ (1 / 2 : ℝ) * (t ^ (1 / 2 : ℝ) * s) = t * s := by
      intro t s
      rw [← mul_assoc, ← ENNReal.rpow_add_of_nonneg _ _ (by norm_num) (by norm_num)]
      norm_num
    have e2 : ∀ t : ℝ≥0∞, (t ^ (1 / 2 : ℝ)) ^ (2 : ℝ) = t := by
      intro t
      rw [← ENNReal.rpow_mul]; norm_num
    have e3 : ∀ t s : ℝ≥0∞, (t ^ (1 / 2 : ℝ) * s) ^ (2 : ℝ) = t * s ^ 2 := by
      intro t s
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), e2, ENNReal.rpow_two]
    simp only [Pi.mul_apply, e1, e2, e3, hmass, ENNReal.one_rpow, one_mul] at key
    calc ‖∫ z, ρ z • H (x - z)‖ₑ ^ 2 ≤ (∫⁻ z, ENNReal.ofReal (ρ z) * ‖H (x - z)‖ₑ) ^ 2 := by
          gcongr
      _ ≤ ((∫⁻ z, ENNReal.ofReal (ρ z) * ‖H (x - z)‖ₑ ^ 2) ^ (1 / 2 : ℝ)) ^ 2 := by gcongr
      _ = ∫⁻ z, ENNReal.ofReal (ρ z) * ‖H (x - z)‖ₑ ^ 2 := by
          rw [← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]; norm_num
  -- Step 7: Tonelli and translation invariance of Lebesgue measure.
  have hprod : AEMeasurable
      (Function.uncurry fun x z => ENNReal.ofReal (ρ z) * ‖H (x - z)‖ₑ ^ 2)
      ((volume : Measure (Rn n)).prod volume) := by
    have h1 : AEMeasurable (fun p : Rn n × Rn n => ENNReal.ofReal (ρ p.2))
        ((volume : Measure (Rn n)).prod volume) := ha.comp_snd
    have h2 : AEMeasurable (fun p : Rn n × Rn n => ‖H (p.1 - p.2)‖ₑ ^ 2)
        ((volume : Measure (Rn n)).prod volume) :=
      (hh.pow_const 2).comp_quasiMeasurePreserving (quasiMeasurePreserving_sub volume volume)
    exact h1.mul h2
  have hz : ∀ z, ∫⁻ x, ENNReal.ofReal (ρ z) * ‖H (x - z)‖ₑ ^ 2 =
      ENNReal.ofReal (ρ z) * ∫⁻ y, ‖H y‖ₑ ^ 2 := fun z => by
    rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
      lintegral_sub_right_eq_self (fun y => ‖H y‖ₑ ^ 2) z]
  -- Steps 6 and 8: integrate the pointwise bound and use `∫⁻ a = 1`.
  calc ∫⁻ x, ‖∫ z, ρ z • H (x - z)‖ₑ ^ 2
      ≤ ∫⁻ x, ∫⁻ z, ENNReal.ofReal (ρ z) * ‖H (x - z)‖ₑ ^ 2 := lintegral_mono hpt
    _ = ∫⁻ z, ∫⁻ x, ENNReal.ofReal (ρ z) * ‖H (x - z)‖ₑ ^ 2 := lintegral_lintegral_swap hprod
    _ = ∫⁻ z, ENNReal.ofReal (ρ z) * ∫⁻ y, ‖H y‖ₑ ^ 2 := lintegral_congr hz
    _ = ∫⁻ y, ‖H y‖ₑ ^ 2 := by rw [lintegral_mul_const'' _ ha, hmass, one_mul]

/-- **Mollifiers are an approximate identity in `L²`** (Gilbarg–Trudinger §7.2, Evans Appendix C).
If `ρ j ≥ 0` are continuous with `∫ ρ j = 1` and `ρ j = 0` outside `ball 0 (ε j)` with `ε j → 0`,
then `∫⁻ ‖ρ j ⋆ H - H‖ₑ² → 0` for every `H ∈ L¹ ∩ L²`.

For continuous compactly supported `Φ`, uniform continuity bounds `‖ρ j ⋆ Φ - Φ‖` uniformly and
the difference vanishes off a fixed ball, so `∫⁻ ‖ρ j ⋆ Φ - Φ‖ₑ² → 0`.  Such `Φ` are dense in `L²`
(simple functions, inner/outer regularity of Lebesgue measure and Urysohn's lemma), and splitting
`ρ j ⋆ H - H = ρ j ⋆ (H - Φ) + (ρ j ⋆ Φ - Φ) + (Φ - H)`, the first term is controlled by the
`L²` contraction `mollifier_l2_contraction`. -/
theorem mollifier_l2_tendsto : ∀ (n : ℕ) (E : Type) [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E] (H : Rn n → E), Integrable H → MemLp H 2 volume → ∀ (ρ : ℕ → Rn n → ℝ) (ε : ℕ → ℝ), (∀ j, Continuous (ρ j)) → (∀ j z, 0 ≤ ρ j z) → (∀ j, ∫ z, ρ j z = 1) → (∀ j z, ε j ≤ ‖z‖ → ρ j z = 0) → Tendsto ε atTop (𝓝 0) → Tendsto (fun j => ∫⁻ x, ‖(∫ z, ρ j z • H (x - z)) - H x‖ₑ ^ 2) atTop (𝓝 0) := by
  intro n E _ _ _ H hHi hH2 ρ ε hρc hρ0 hρ1 hρs hε
  -- Step 1: `ρ j` vanishes off `ball 0 (ε j)`, so it is continuous with compact support and the
  -- mollification `x ↦ ∫ ρ j z • u (x - z)` of a locally integrable `u` is continuous.
  have hρsupp : ∀ j r, ε j ≤ r → Function.support (ρ j) ⊆ ball (0 : Rn n) r := by
    intro j r hr z hz
    rw [mem_ball_zero_iff]
    by_contra h
    exact hz (hρs j z (hr.trans (not_lt.1 h)))
  have hρcs : ∀ j, HasCompactSupport (ρ j) := fun j =>
    HasCompactSupport.intro (isCompact_closedBall (0 : Rn n) (ε j)) fun z hz =>
      hρs j z (by rw [mem_closedBall_zero_iff, not_le] at hz; exact hz.le)
  have hMc : ∀ j (u : Rn n → E), LocallyIntegrable u volume →
      Continuous (fun x => ∫ z, ρ j z • u (x - z)) := fun j u hu =>
    (hρcs j).continuous_convolution_left (ContinuousLinearMap.lsmul ℝ ℝ) (hρc j) hu
  -- Step 2: `(a + b)² ≤ 2 (a² + b²)` in `ℝ≥0∞`.
  have sq2 : ∀ a b : ℝ≥0∞, (a + b) ^ 2 ≤ 2 * (a ^ 2 + b ^ 2) := by
    intro a b
    have h := ENNReal.rpow_add_le_mul_rpow_add_rpow a b (p := 2) one_le_two
    norm_num [ENNReal.rpow_two] at h
    exact h
  -- Step 3: for continuous compactly supported `Φ`, `∫⁻ ‖ρ j ⋆ Φ - Φ‖ₑ² → 0`.
  have hCc : ∀ Φ : Rn n → E, Continuous Φ → HasCompactSupport Φ → ∀ δ : ℝ≥0∞, δ ≠ 0 →
      ∀ᶠ j in atTop, ∫⁻ x, ‖(∫ z, ρ j z • Φ (x - z)) - Φ x‖ₑ ^ 2 ≤ δ := by
    intro Φ hΦc hΦcs δ hδ
    obtain ⟨R, hR⟩ := hΦcs.isCompact.isBounded.subset_closedBall (0 : Rn n)
    have hΦ0 : ∀ y : Rn n, R < ‖y‖ → Φ y = 0 := fun y hy =>
      image_eq_zero_of_notMem_tsupport fun h => not_le.2 hy (mem_closedBall_zero_iff.1 (hR h))
    obtain ⟨θ, θpos, hθ⟩ := ENNReal.exists_nnreal_pos_mul_lt
      (measure_closedBall_lt_top (μ := (volume : Measure (Rn n))) (x := 0) (r := R + 1)).ne hδ
    set η : ℝ := Real.sqrt θ with hη
    have ηpos : 0 < η := Real.sqrt_pos.2 (by exact_mod_cast θpos)
    obtain ⟨r, rpos, hr⟩ :=
      Metric.uniformContinuous_iff.1 (hΦcs.uniformContinuous_of_continuous hΦc) η ηpos
    filter_upwards [hε.eventually_lt_const (lt_min rpos one_pos)] with j hj
    have hpt : ∀ x, ‖(∫ z, ρ j z • Φ (x - z)) - Φ x‖ₑ ^ 2 ≤
        (closedBall (0 : Rn n) (R + 1)).indicator (fun _ => (θ : ℝ≥0∞)) x := by
      intro x
      by_cases hx : x ∈ closedBall (0 : Rn n) (R + 1)
      · rw [indicator_of_mem hx]
        have h1 := dist_convolution_le (μ := volume) (f := ρ j) (g := Φ) (x₀ := x) (z₀ := Φ x)
          ηpos.le (hρsupp j r (hj.le.trans (min_le_left _ _))) (hρ0 j) (hρ1 j)
          hΦc.aestronglyMeasurable fun y hy => (hr (mem_ball.1 hy)).le
        rw [convolution_lsmul, dist_eq_norm] at h1
        calc ‖(∫ z, ρ j z • Φ (x - z)) - Φ x‖ₑ ^ 2 ≤ ENNReal.ofReal η ^ 2 := by
              gcongr
              rw [← ofReal_norm]
              exact ENNReal.ofReal_le_ofReal h1
          _ = (θ : ℝ≥0∞) := by
              rw [← ENNReal.ofReal_pow ηpos.le, hη, Real.sq_sqrt θ.coe_nonneg,
                ENNReal.ofReal_coe_nnreal]
      · rw [indicator_of_notMem hx]
        rw [mem_closedBall_zero_iff, not_le] at hx
        have h1 := dist_convolution_le (μ := volume) (f := ρ j) (g := Φ) (x₀ := x) (z₀ := 0)
          le_rfl (hρsupp j 1 (hj.le.trans (min_le_right _ _))) (hρ0 j) (hρ1 j)
          hΦc.aestronglyMeasurable fun y hy => by
            have h2 : ‖x‖ - ‖y‖ ≤ ‖x - y‖ := norm_sub_norm_le x y
            rw [← dist_eq_norm, dist_comm] at h2
            rw [hΦ0 y (by linarith [mem_ball.1 hy]), dist_self]
        rw [convolution_lsmul, dist_le_zero] at h1
        rw [h1, hΦ0 x (by linarith), sub_zero, enorm_zero]
        simp
    calc ∫⁻ x, ‖(∫ z, ρ j z • Φ (x - z)) - Φ x‖ₑ ^ 2
        ≤ ∫⁻ x, (closedBall (0 : Rn n) (R + 1)).indicator (fun _ => (θ : ℝ≥0∞)) x :=
          lintegral_mono hpt
      _ = θ * volume (closedBall (0 : Rn n) (R + 1)) :=
          lintegral_indicator_const measurableSet_closedBall _
      _ ≤ δ := hθ.le
  -- Step 4: continuous compactly supported functions are dense in `L²`.
  have hdense : ∀ δ : ℝ≥0∞, δ ≠ 0 → ∃ Φ : Rn n → E,
      eLpNorm (H - Φ) 2 volume ≤ δ ∧ (Continuous Φ ∧ HasCompactSupport Φ) := by
    intro δ hδ
    refine hH2.induction_dense (by norm_num) (fun g => Continuous g ∧ HasCompactSupport g)
      ?_ ?_ hδ
    · intro c S hS hSμ η hη
      obtain ⟨θ, θpos, hθ⟩ := exists_eLpNorm_indicator_le (μ := (volume : Measure (Rn n)))
        (by norm_num : (2 : ℝ≥0∞) ≠ ∞) c hη
      have hθ2 : (θ : ℝ≥0∞) / 2 ≠ 0 := (ENNReal.div_pos (by exact_mod_cast θpos.ne')
        (by norm_num)).ne'
      obtain ⟨K, hKS, hKc, hSK⟩ := hS.exists_isCompact_sdiff_lt hSμ.ne hθ2
      obtain ⟨U, hSU, hUo, -, hUS⟩ := hS.exists_isOpen_sdiff_lt hSμ.ne hθ2
      obtain ⟨f, hf1, hf0, hfcs, hf01⟩ := exists_continuous_one_zero_of_isCompact hKc
        hUo.isClosed_compl (disjoint_compl_right_iff_subset.2 (hKS.trans hSU))
      have hfc : Continuous fun x => f x • c := f.continuous.smul continuous_const
      refine ⟨fun x => f x • c, ?_, hfc, hfcs.smul_right (f' := fun _ => c)⟩
      have hmeas : AEStronglyMeasurable ((fun x => f x • c) - S.indicator fun _ => c) volume :=
        hfc.aestronglyMeasurable.sub (aestronglyMeasurable_const.indicator hS)
      refine (eLpNorm_mono hmeas (g := (U \ K).indicator fun _ => c) fun x => ?_).trans
        (hθ _ ?_ (hUo.measurableSet.diff hKc.measurableSet).nullMeasurableSet)
      · have hf01' : ‖f x‖ ≤ 1 := by
          rw [Real.norm_eq_abs, abs_le]; constructor <;> linarith [(hf01 x).1, (hf01 x).2]
        have hf01'' : ‖f x - 1‖ ≤ 1 := by
          rw [Real.norm_eq_abs, abs_le]; constructor <;> linarith [(hf01 x).1, (hf01 x).2]
        rw [Pi.sub_apply]
        by_cases hxK : x ∈ K
        · rw [hf1 hxK, indicator_of_mem (hKS hxK)]
          simp
        by_cases hxU : x ∈ U
        · rw [indicator_of_mem (show x ∈ U \ K from ⟨hxU, hxK⟩)]
          by_cases hxS : x ∈ S
          · have h3 : f x • c - c = (f x - 1) • c := by rw [sub_smul, one_smul]
            rw [indicator_of_mem hxS, h3, norm_smul]
            exact mul_le_of_le_one_left (norm_nonneg _) hf01''
          · rw [indicator_of_notMem hxS, sub_zero, norm_smul]
            exact mul_le_of_le_one_left (norm_nonneg _) hf01'
        · rw [hf0 hxU, indicator_of_notMem fun h => hxU (hSU h)]
          simp
      · calc volume (U \ K) ≤ volume ((U \ S) ∪ (S \ K)) := by
              refine measure_mono fun x hx => ?_
              by_cases hxS : x ∈ S
              · exact Or.inr ⟨hxS, hx.2⟩
              · exact Or.inl ⟨hx.1, hxS⟩
          _ ≤ volume (U \ S) + volume (S \ K) := measure_union_le _ _
          _ ≤ θ / 2 + θ / 2 := add_le_add hUS.le hSK.le
          _ = θ := ENNReal.add_halves _
    · rintro f g ⟨hfc, hfcs⟩ ⟨hgc, hgcs⟩
      exact ⟨hfc.add hgc, hfcs.add hgcs⟩
  -- Step 5: split `ρ j ⋆ H - H` and conclude.
  rw [ENNReal.tendsto_nhds_zero]
  intro e he
  set δ := e / 10
  have hδ : δ ≠ 0 := (ENNReal.div_pos he.ne' (by norm_num)).ne'
  obtain ⟨Φ, hHΦ, hΦc, hΦcs⟩ := hdense (min δ 1) (lt_min (pos_iff_ne_zero.2 hδ) one_pos).ne'
  have hΦi : Integrable Φ volume := hΦc.integrable_of_hasCompactSupport hΦcs
  have hHΦi : Integrable (H - Φ) volume := hHi.sub hΦi
  have hC : ∫⁻ x, ‖(H - Φ) x‖ₑ ^ 2 ≤ δ := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal two_ne_zero ENNReal.ofNat_ne_top
      hHΦi.aestronglyMeasurable] at hHΦ
    simp only [ENNReal.toReal_ofNat, ENNReal.rpow_two] at hHΦ
    calc ∫⁻ x, ‖(H - Φ) x‖ₑ ^ 2 = ((∫⁻ x, ‖(H - Φ) x‖ₑ ^ 2) ^ (1 / 2 : ℝ)) ^ 2 := by
          rw [← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]; norm_num
      _ ≤ (min δ 1) ^ 2 := by gcongr
      _ ≤ min δ 1 := pow_le_of_le_one (by positivity) (min_le_right _ _) two_ne_zero
      _ ≤ δ := min_le_left _ _
  filter_upwards [hCc Φ hΦc hΦcs δ hδ] with j hj
  have hA := mollifier_l2_contraction n E (ρ j) (H - Φ) (hρc j) (hρ0 j) (hρ1 j)
    hHΦi.aestronglyMeasurable
  have hlin : ∀ x, (∫ z, ρ j z • H (x - z)) =
      (∫ z, ρ j z • (H - Φ) (x - z)) + ∫ z, ρ j z • Φ (x - z) := by
    intro x
    have h := ((hρcs j).convolutionExists_left (ContinuousLinearMap.lsmul ℝ ℝ) (hρc j)
      hHΦi.locallyIntegrable x).distrib_add
      ((hρcs j).convolutionExists_left (ContinuousLinearMap.lsmul ℝ ℝ) (hρc j)
        hΦi.locallyIntegrable x)
    rw [sub_add_cancel] at h
    simpa only [convolution_lsmul] using h
  have hpt : ∀ x, ‖(∫ z, ρ j z • H (x - z)) - H x‖ₑ ^ 2 ≤
      2 * ‖∫ z, ρ j z • (H - Φ) (x - z)‖ₑ ^ 2 +
        4 * ‖(∫ z, ρ j z • Φ (x - z)) - Φ x‖ₑ ^ 2 + 4 * ‖(H - Φ) x‖ₑ ^ 2 := by
    intro x
    have heq : (∫ z, ρ j z • H (x - z)) - H x = (∫ z, ρ j z • (H - Φ) (x - z)) +
        (((∫ z, ρ j z • Φ (x - z)) - Φ x) + -(H - Φ) x) := by
      rw [hlin x, Pi.sub_apply]; abel
    rw [heq]
    calc ‖(∫ z, ρ j z • (H - Φ) (x - z)) +
          (((∫ z, ρ j z • Φ (x - z)) - Φ x) + -(H - Φ) x)‖ₑ ^ 2
        ≤ (‖∫ z, ρ j z • (H - Φ) (x - z)‖ₑ +
          (‖(∫ z, ρ j z • Φ (x - z)) - Φ x‖ₑ + ‖(H - Φ) x‖ₑ)) ^ 2 := by
          gcongr
          refine (enorm_add_le _ _).trans ?_
          gcongr
          exact (enorm_add_le _ _).trans_eq (by rw [enorm_neg])
      _ ≤ 2 * (‖∫ z, ρ j z • (H - Φ) (x - z)‖ₑ ^ 2 +
          (‖(∫ z, ρ j z • Φ (x - z)) - Φ x‖ₑ + ‖(H - Φ) x‖ₑ) ^ 2) := sq2 _ _
      _ ≤ 2 * (‖∫ z, ρ j z • (H - Φ) (x - z)‖ₑ ^ 2 +
          2 * (‖(∫ z, ρ j z • Φ (x - z)) - Φ x‖ₑ ^ 2 + ‖(H - Φ) x‖ₑ ^ 2)) := by
          gcongr; exact sq2 _ _
      _ = 2 * ‖∫ z, ρ j z • (H - Φ) (x - z)‖ₑ ^ 2 +
          4 * ‖(∫ z, ρ j z • Φ (x - z)) - Φ x‖ₑ ^ 2 + 4 * ‖(H - Φ) x‖ₑ ^ 2 := by ring
  have hmA : AEMeasurable (fun x => 2 * ‖∫ z, ρ j z • (H - Φ) (x - z)‖ₑ ^ 2) volume :=
    (((hMc j _ hHΦi.locallyIntegrable).enorm.measurable.pow_const 2).const_mul 2).aemeasurable
  have hmB : AEMeasurable (fun x => 4 * ‖(∫ z, ρ j z • Φ (x - z)) - Φ x‖ₑ ^ 2) volume :=
    ((((hMc j _ hΦi.locallyIntegrable).sub hΦc).enorm.measurable.pow_const 2).const_mul
      4).aemeasurable
  calc ∫⁻ x, ‖(∫ z, ρ j z • H (x - z)) - H x‖ₑ ^ 2
      ≤ ∫⁻ x, (2 * ‖∫ z, ρ j z • (H - Φ) (x - z)‖ₑ ^ 2 +
        4 * ‖(∫ z, ρ j z • Φ (x - z)) - Φ x‖ₑ ^ 2 + 4 * ‖(H - Φ) x‖ₑ ^ 2) := lintegral_mono hpt
    _ = 2 * (∫⁻ x, ‖∫ z, ρ j z • (H - Φ) (x - z)‖ₑ ^ 2) +
        4 * (∫⁻ x, ‖(∫ z, ρ j z • Φ (x - z)) - Φ x‖ₑ ^ 2) + 4 * ∫⁻ x, ‖(H - Φ) x‖ₑ ^ 2 := by
      have hmAB : AEMeasurable (fun x => 2 * ‖∫ z, ρ j z • (H - Φ) (x - z)‖ₑ ^ 2 +
          4 * ‖(∫ z, ρ j z • Φ (x - z)) - Φ x‖ₑ ^ 2) volume := hmA.add hmB
      rw [lintegral_add_left' hmAB, lintegral_add_left' hmA,
        lintegral_const_mul' _ _ (by norm_num), lintegral_const_mul' _ _ (by norm_num),
        lintegral_const_mul' _ _ (by norm_num)]
    _ ≤ 2 * δ + 4 * δ + 4 * δ := by gcongr; exact hA.trans hC
    _ = 10 * δ := by ring
    _ = e := ENNReal.mul_div_cancel' (by norm_num) (by norm_num)

/-- **Mollified `W^{1,2}` functions on the unit ball** (Evans, *PDE*, §5.3.1; Gilbarg–Trudinger,
§7.3).  Let `f ∈ W^{1,2}(B)` with weak gradient `g`, `B = B̆₁(0)`, and let `ρ` be `C^∞` with
`ρ(z) = 0` for `‖z‖ ≥ ε`.  For the zero extensions `F = 1_B f`, `G = 1_B g`, the mollification
`Φ(x) = ∫ ρ(z) F(x - z) dz` is `C^∞`, and `∇Φ(x) = ∫ ρ(z) G(x - z) dz` whenever `‖x‖ < 1 - ε`.

`ρ` is supported in `B_ε(0)` and `F` is integrable (`L²` on a ball of finite measure), so
`Φ = F ⋆ ρ` is smooth with `DΦ(x) v = ∫ F(t) Dρ(x - t) v dt`, i.e. `∇Φ(x) = ∫ F(t) ∇ρ(x - t) dt`.
For `‖x‖ < 1 - ε` the reflected kernel `ζ(y) = ρ(x - y)` is a test function in `B` with
`∇ζ(y) = -∇ρ(x - y)`, so the weak identity gives `∫_B f(y) ∇ρ(x - y) dy = ∫_B ρ(x - y) g(y) dy`,
which is `∫ ρ(z) G(x - z) dz` after the substitution `z = x - y`. -/
theorem w12_ball_mollification_gradient : ∀ (n : ℕ) (f : Rn n → ℝ) (g : Rn n → Rn n), IsW12WithGradient f g (ball 0 1) → ∀ (ρ : Rn n → ℝ) (ε : ℝ), ContDiff ℝ (⊤ : ℕ∞) ρ → (∀ z, ε ≤ ‖z‖ → ρ z = 0) → ContDiff ℝ (⊤ : ℕ∞) (fun x => ∫ z, ρ z • (ball (0 : Rn n) 1).indicator f (x - z)) ∧ ∀ x : Rn n, ‖x‖ < 1 - ε → gradient (fun x => ∫ z, ρ z • (ball (0 : Rn n) 1).indicator f (x - z)) x = ∫ z, ρ z • (ball (0 : Rn n) 1).indicator g (x - z) := by
  intro n f g hW ρ ε hρ hρ0
  obtain ⟨hf2, hg2, hweak⟩ := hW
  -- Step 1: `tsupport ρ ⊆ B_ε(0)`, so `ρ` is a compactly supported `C^∞` (in particular `C¹`)
  -- kernel.
  have hts : tsupport ρ ⊆ closedBall 0 ε := by
    refine closure_minimal (fun z hz => ?_) isClosed_closedBall
    rw [mem_closedBall_zero_iff]
    by_contra h
    exact (Function.mem_support.1 hz) (hρ0 z (not_le.1 h).le)
  have hρc : HasCompactSupport ρ :=
    HasCompactSupport.of_support_subset_isCompact (isCompact_closedBall (0 : Rn n) ε)
      (subset_closure.trans hts)
  have hρ1 : ContDiff ℝ 1 ρ := hρ.of_le (by exact_mod_cast le_top)
  -- Step 2: `F = 1_B f` is integrable, since `f ∈ L²(B)` and `B` has finite measure.
  have : IsFiniteMeasure (volume.restrict (ball (0 : Rn n) 1)) :=
    isFiniteMeasure_restrict.2 measure_ball_lt_top.ne
  have hFi : Integrable ((ball (0 : Rn n) 1).indicator f) volume :=
    (integrable_indicator_iff measurableSet_ball).2 (hf2.integrable one_le_two)
  -- Step 3: `Φ = F ⋆ ρ` (kernel on the right) is `C^∞`.
  have hΦ : (fun x => ∫ z, ρ z • (ball (0 : Rn n) 1).indicator f (x - z)) =
      convolution ((ball (0 : Rn n) 1).indicator f) ρ (ContinuousLinearMap.lsmul ℝ ℝ).flip
        volume := by
    rw [convolution_flip]; rfl
  refine ⟨?_, fun x hx => ?_⟩
  · rw [hΦ]
    exact hρc.contDiff_convolution_right _ hFi.locallyIntegrable hρ
  -- Step 4: `∇Φ(x) = ∫ F(t) ∇ρ(x - t) dt`, by testing `DΦ(x) = ∫ F(t) Dρ(x - t) dt` against each
  -- `v` and commuting `⟪v, ·⟫` with the (integrable) vector integral.
  have hgrad : ∀ p v, fderiv ℝ ρ p v = inner ℝ (gradient ρ p) v := fun p v => by
    rw [gradient, InnerProductSpace.toDual_symm_apply]
  have hgc : Continuous (gradient ρ) :=
    (InnerProductSpace.toDual ℝ (Rn n)).symm.continuous.comp (hρ1.continuous_fderiv one_ne_zero)
  have hgcs : HasCompactSupport (gradient ρ) :=
    (hρc.fderiv ℝ).comp_left (g := (InnerProductSpace.toDual ℝ (Rn n)).symm) (map_zero _)
  have hint : Integrable (fun t => (ball (0 : Rn n) 1).indicator f t • gradient ρ (x - t)) volume :=
    hgcs.convolutionExists_right (ContinuousLinearMap.lsmul ℝ ℝ) hFi.locallyIntegrable hgc x
  have hD := hρc.hasFDerivAt_convolution_right (ContinuousLinearMap.lsmul ℝ ℝ).flip
    hFi.locallyIntegrable hρ1 x
  have key : gradient (fun x => ∫ z, ρ z • (ball (0 : Rn n) 1).indicator f (x - z)) x =
      ∫ t, (ball (0 : Rn n) 1).indicator f t • gradient ρ (x - t) := by
    rw [hΦ]
    refine HasGradientAt.gradient ?_
    rw [hasGradientAt_iff_hasFDerivAt]
    convert hD using 1
    ext v
    rw [convolution_precompR_apply _ hFi.locallyIntegrable (hρc.fderiv ℝ)
      (hρ1.continuous_fderiv one_ne_zero) x v, InnerProductSpace.toDual_apply_apply,
      real_inner_comm, ← innerSL_apply_apply ℝ, ← ContinuousLinearMap.integral_comp_comm _ hint,
      convolution_def]
    refine integral_congr_ae (Eventually.of_forall fun t => ?_)
    simp only [innerSL_apply_apply, real_inner_smul_right, ContinuousLinearMap.flip_apply,
      ContinuousLinearMap.lsmul_apply, smul_eq_mul, hgrad, real_inner_comm v]
    ring
  rw [key]
  -- Step 5: for `‖x‖ < 1 - ε`, `ζ(y) = ρ(x - y)` is a `C^∞` test function with
  -- `tsupport ζ ⊆ B_ε(x) ⊆ B` and `∇ζ(y) = -∇ρ(x - y)`.
  have hζ : ContDiff ℝ (⊤ : ℕ∞) (fun y => ρ (x - y)) := hρ.comp (contDiff_const.sub contDiff_id)
  have hζc : HasCompactSupport (fun y => ρ (x - y)) := hρc.comp_homeomorph (Homeomorph.subLeft x)
  have hζs : tsupport (fun y => ρ (x - y)) ⊆ ball 0 1 := by
    refine (tsupport_comp_subset_preimage ρ (continuous_const.sub continuous_id)).trans
      fun y hy => ?_
    have h1 : x - y ∈ tsupport ρ := hy
    have h2 : ‖x - y‖ ≤ ε := mem_closedBall_zero_iff.1 (hts h1)
    rw [mem_ball_zero_iff]
    calc ‖y‖ = ‖x - (x - y)‖ := by rw [sub_sub_cancel]
      _ ≤ ‖x‖ + ‖x - y‖ := norm_sub_le _ _
      _ < 1 := by linarith
  have hζg : ∀ y, gradient (fun y => ρ (x - y)) y = -gradient ρ (x - y) := fun y => by
    have hd : fderiv ℝ (fun y => ρ (x - y)) y = -(fderiv ℝ ρ (x - y)) := by
      simpa only [Function.comp_def, ContinuousLinearMap.comp_neg,
        ContinuousLinearMap.comp_id] using
        ((hρ1.differentiable one_ne_zero (x - y)).hasFDerivAt.comp y
          ((hasFDerivAt_id y).const_sub x)).fderiv
    rw [gradient, hd, map_neg, gradient]
  -- Step 6: the weak identity for `ζ`: `∫_B f(y) ∇ρ(x - y) dy = ∫_B ρ(x - y) g(y) dy`.
  have hw := hweak (fun y => ρ (x - y)) hζ hζc hζs
  simp only [hζg, smul_neg, integral_neg, neg_inj] at hw
  -- Step 7: pass to the zero extensions and substitute `z = x - y`.
  calc ∫ t, (ball (0 : Rn n) 1).indicator f t • gradient ρ (x - t)
      = ∫ y in ball (0 : Rn n) 1, f y • gradient ρ (x - y) := by
        rw [← integral_indicator measurableSet_ball]
        refine integral_congr_ae (Eventually.of_forall fun y => ?_)
        rw [indicator_smul_apply_left]
    _ = ∫ y in ball (0 : Rn n) 1, ρ (x - y) • g y := hw
    _ = ∫ y, ρ (x - y) • (ball (0 : Rn n) 1).indicator g y := by
        rw [← integral_indicator measurableSet_ball]
        refine integral_congr_ae (Eventually.of_forall fun y => ?_)
        rw [indicator_smul_apply]
    _ = ∫ z, ρ z • (ball (0 : Rn n) 1).indicator g (x - z) := by
        rw [← integral_sub_left_eq_self
          (fun z => ρ z • (ball (0 : Rn n) 1).indicator g (x - z)) volume x]
        simp only [sub_sub_cancel]

/-- Interior smooth approximation of `W^{1,2}(B)`, `B = B̆₁(0)` (Friedrichs mollification; Evans,
*PDE*, §5.3.1; Gilbarg–Trudinger §§7.2–7.3), used in the proof of Simon Ch. 5, Lemma 3.1 (p. 114):
for `0 < r < 1` there are `C^∞` functions `φ_j` with `φ_j → f` and `∇φ_j → g` in `L²(B_r)`.
With `F = 1_B f`, `G = 1_B g`, `ε_j = (1 - r)/(j + 2)` and `ρ_j` the normalized bump supported in
`B_{ε_j}`, take `φ_j = ρ_j * F`.  It is smooth with `∇φ_j = ρ_j * G` on `B_{1-ε_j} ⊇ B_r`, and
`F = f`, `G = g` on `B_r`, so the two errors on `B_r` are at most `∫_{ℝⁿ} |ρ_j * H - H|²` for
`H = F, G`, which tends to `0`. -/
theorem w12_ball_smooth_approximation : ∀ n : ℕ, 1 ≤ n → ∀ (f : Rn n → ℝ) (g : Rn n → Rn n), IsW12WithGradient f g (ball 0 1) → ∀ r : ℝ, 0 < r → r < 1 → ∃ φ : ℕ → Rn n → ℝ, (∀ j, ContDiff ℝ (⊤ : ℕ∞) (φ j)) ∧ Tendsto (fun j => ∫⁻ x in ball (0 : Rn n) r, ‖φ j x - f x‖ₑ ^ 2) atTop (𝓝 0) ∧ Tendsto (fun j => ∫⁻ x in ball (0 : Rn n) r, ‖gradient (φ j) x - g x‖ₑ ^ 2) atTop (𝓝 0) := by
  intro n _ f g hfg r hr hr1
  -- Step 1: the zero extensions `F = 1_B f` and `G = 1_B g` lie in `L¹(ℝⁿ)` and `L²(ℝⁿ)`.
  have hB : MeasurableSet (ball (0 : Rn n) 1) := measurableSet_ball
  have : IsFiniteMeasure (volume.restrict (ball (0 : Rn n) 1)) :=
    isFiniteMeasure_restrict.2 measure_ball_lt_top.ne
  have hF2 : MemLp ((ball (0 : Rn n) 1).indicator f) 2 volume :=
    (memLp_indicator_iff_restrict hB.nullMeasurableSet).2 hfg.1
  have hG2 : MemLp ((ball (0 : Rn n) 1).indicator g) 2 volume :=
    (memLp_indicator_iff_restrict hB.nullMeasurableSet).2 hfg.2.1
  have hF1 : Integrable ((ball (0 : Rn n) 1).indicator f) :=
    (integrable_indicator_iff hB).2 (hfg.1.integrable one_le_two)
  have hG1 : Integrable ((ball (0 : Rn n) 1).indicator g) :=
    (integrable_indicator_iff hB).2 (hfg.2.1.integrable one_le_two)
  -- Step 2: radii `ε_j = (1 - r)/(j + 2) ∈ (0, 1 - r)` with `ε_j → 0`, and normalized bumps
  -- `ρ_j ≥ 0` with `∫ ρ_j = 1` and `ρ_j = 0` off `B_{ε_j}`.
  obtain ⟨ε, hεpos, hεlt, hεlim⟩ : ∃ ε : ℕ → ℝ,
      (∀ j, 0 < ε j) ∧ (∀ j, ε j < 1 - r) ∧ Tendsto ε atTop (𝓝 0) := by
    refine ⟨fun j => (1 - r) / ((j : ℝ) + 2), fun j => div_pos (sub_pos.2 hr1) (by positivity),
      fun j => div_lt_self (sub_pos.2 hr1) ?_, ?_⟩
    · have := (Nat.cast_nonneg j : (0 : ℝ) ≤ j)
      linarith
    · exact tendsto_const_nhds.div_atTop
        (tendsto_atTop_add_const_right _ 2 tendsto_natCast_atTop_atTop)
  obtain ⟨ρ, hρsmooth, hρcont, hρnonneg, hρint, hρsupp⟩ : ∃ ρ : ℕ → Rn n → ℝ,
      (∀ j, ContDiff ℝ (⊤ : ℕ∞) (ρ j)) ∧ (∀ j, Continuous (ρ j)) ∧ (∀ j z, 0 ≤ ρ j z) ∧
        (∀ j, ∫ z, ρ j z = 1) ∧ ∀ j z, ε j ≤ ‖z‖ → ρ j z = 0 := by
    let b : ℕ → ContDiffBump (0 : Rn n) := fun j =>
      ⟨ε j / 2, ε j, half_pos (hεpos j), half_lt_self (hεpos j)⟩
    refine ⟨fun j => (b j).normed volume, fun j => (b j).contDiff_normed,
      fun j => (b j).continuous_normed, fun j z => (b j).nonneg_normed z,
      fun j => (b j).integral_normed, fun j z hz => ?_⟩
    have hz' : z ∉ Function.support ((b j).normed volume) := by
      rw [(b j).support_normed_eq, mem_ball_zero_iff, not_lt]
      exact hz
    exact Function.notMem_support.1 hz'
  -- Step 3: `φ_j = ρ_j * F` is smooth, and `∇φ_j = ρ_j * G` on `B_{1 - ε_j}`.
  have hmol := fun j : ℕ => Submission.w12_ball_mollification_gradient n f g hfg (ρ j) (ε j)
    (hρsmooth j) (hρsupp j)
  refine ⟨fun j x => ∫ z, ρ j z • (ball (0 : Rn n) 1).indicator f (x - z),
    fun j => (hmol j).1, ?_, ?_⟩
  · -- Step 4: `F = f` on `B_r ⊆ B`, so the error is at most `∫_{ℝⁿ} |ρ_j * F - F|² → 0`.
    have hlim := Submission.mollifier_l2_tendsto n ℝ ((ball (0 : Rn n) 1).indicator f) hF1 hF2
      ρ ε hρcont hρnonneg hρint hρsupp hεlim
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hlim (fun _ => zero_le)
      fun j => ?_
    have hpt : ∀ x ∈ ball (0 : Rn n) r,
        ‖(∫ z, ρ j z • (ball (0 : Rn n) 1).indicator f (x - z)) - f x‖ₑ ^ 2 =
          ‖(∫ z, ρ j z • (ball (0 : Rn n) 1).indicator f (x - z)) -
            (ball (0 : Rn n) 1).indicator f x‖ₑ ^ 2 := by
      intro x hx
      rw [indicator_of_mem (ball_subset_ball hr1.le hx)]
    calc ∫⁻ x in ball (0 : Rn n) r,
          ‖(∫ z, ρ j z • (ball (0 : Rn n) 1).indicator f (x - z)) - f x‖ₑ ^ 2
        = ∫⁻ x in ball (0 : Rn n) r,
          ‖(∫ z, ρ j z • (ball (0 : Rn n) 1).indicator f (x - z)) -
            (ball (0 : Rn n) 1).indicator f x‖ₑ ^ 2 := setLIntegral_congr_fun measurableSet_ball hpt
      _ ≤ ∫⁻ x, ‖(∫ z, ρ j z • (ball (0 : Rn n) 1).indicator f (x - z)) -
            (ball (0 : Rn n) 1).indicator f x‖ₑ ^ 2 := setLIntegral_le_lintegral _ _
  · -- Step 5: on `B_r` we have `‖x‖ < 1 - ε_j`, so `∇φ_j = ρ_j * G` there, and `G = g`; the error
    -- is at most `∫_{ℝⁿ} |ρ_j * G - G|² → 0`.
    have hlim := Submission.mollifier_l2_tendsto n (Rn n) ((ball (0 : Rn n) 1).indicator g) hG1
      hG2 ρ ε hρcont hρnonneg hρint hρsupp hεlim
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hlim (fun _ => zero_le)
      fun j => ?_
    have hpt : ∀ x ∈ ball (0 : Rn n) r,
        ‖gradient (fun x => ∫ z, ρ j z • (ball (0 : Rn n) 1).indicator f (x - z)) x - g x‖ₑ ^ 2 =
          ‖(∫ z, ρ j z • (ball (0 : Rn n) 1).indicator g (x - z)) -
            (ball (0 : Rn n) 1).indicator g x‖ₑ ^ 2 := by
      intro x hx
      have hx' : ‖x‖ < 1 - ε j := by
        have := mem_ball_zero_iff.1 hx
        linarith [hεlt j]
      rw [(hmol j).2 x hx', indicator_of_mem (ball_subset_ball hr1.le hx)]
    calc ∫⁻ x in ball (0 : Rn n) r,
          ‖gradient (fun x => ∫ z, ρ j z • (ball (0 : Rn n) 1).indicator f (x - z)) x - g x‖ₑ ^ 2
        = ∫⁻ x in ball (0 : Rn n) r,
          ‖(∫ z, ρ j z • (ball (0 : Rn n) 1).indicator g (x - z)) -
            (ball (0 : Rn n) 1).indicator g x‖ₑ ^ 2 := setLIntegral_congr_fun measurableSet_ball hpt
      _ ≤ ∫⁻ x, ‖(∫ z, ρ j z • (ball (0 : Rn n) 1).indicator g (x - z)) -
            (ball (0 : Rn n) 1).indicator g x‖ₑ ^ 2 := setLIntegral_le_lintegral _ _

/-- **Poincaré inequality on the unit ball** (Simon Ch. 5, fact (P) in the proof of Lemma 3.1,
p. 114; Gilbarg–Trudinger (7.45)).  If `n ≥ 1` and `f ∈ W^{1,2}(B)` has weak gradient `g`, where
`B = B̆₁(0)`, then `∫_B |f − λ|² ≤ 2^{n+2} ∫_B |g|²` with `λ = ⨍_B f`.  For `0 < r < 1`, smooth
approximation on `B_r` and the segment estimate give
`∫_{B_r}∫_{B_r} |f(x) − f(y)|² ≤ 2^{n+2} |B| ∫_{B_r} |g|²`.  Letting `r ↑ 1` and using
`∫_B |f − λ|² ≤ |B|⁻¹ ∫_B∫_B |f(x) − f(y)|²` then gives the claim. -/
theorem w12_ball_poincare_inequality : ∀ n : ℕ, 1 ≤ n → ∃ C : ℝ, 0 ≤ C ∧ ∀ (f : Rn n → ℝ) (g : Rn n → Rn n), IsW12WithGradient f g (ball 0 1) → ∫⁻ x in ball (0 : Rn n) 1, ‖f x - ⨍ y in ball (0 : Rn n) 1, f y‖ₑ ^ 2 ≤ ENNReal.ofReal C * ∫⁻ x in ball (0 : Rn n) 1, ‖g x‖ₑ ^ 2 := by
  intro n hn
  refine ⟨2 ^ (n + 2), by positivity, fun f g hfg => ?_⟩
  have hf : MemLp f 2 (volume.restrict (ball (0 : Rn n) 1)) := hfg.1
  have hg : MemLp g 2 (volume.restrict (ball (0 : Rn n) 1)) := hfg.2.1
  -- Steps 1–2: for `0 < r < 1`, approximate `f` on `B_r` by smooth `φ_j` and pass to the limit;
  -- the energy on `B_r` is at most the energy on `B`.
  have hBr : ∀ r : ℝ, 0 < r → r < 1 →
      ∫⁻ x in ball (0 : Rn n) r, ∫⁻ y in ball (0 : Rn n) r, ‖f x - f y‖ₑ ^ 2 ≤
        (2 : ℝ≥0∞) ^ (n + 2) * volume (ball (0 : Rn n) 1) *
          ∫⁻ x in ball (0 : Rn n) 1, ‖g x‖ₑ ^ 2 := by
    intro r hr0 hr1
    obtain ⟨φ, hφ, h1, h2⟩ := Submission.w12_ball_smooth_approximation n hn f g hfg r hr0 hr1
    have hsub : ball (0 : Rn n) r ⊆ ball 0 1 := ball_subset_ball hr1.le
    calc ∫⁻ x in ball (0 : Rn n) r, ∫⁻ y in ball (0 : Rn n) r, ‖f x - f y‖ₑ ^ 2
        ≤ (2 : ℝ≥0∞) ^ (n + 2) * volume (ball (0 : Rn n) 1) *
            ∫⁻ x in ball (0 : Rn n) r, ‖g x‖ₑ ^ 2 :=
          Submission.poincare_approx_ball_double_integral_bound n f g φ r hr0 hr1.le
            (hf.aestronglyMeasurable.mono_set hsub) (hg.aestronglyMeasurable.mono_set hsub)
            (fun j => (hφ j).of_le (by exact_mod_cast le_top)) h1 h2
      _ ≤ (2 : ℝ≥0∞) ^ (n + 2) * volume (ball (0 : Rn n) 1) *
            ∫⁻ x in ball (0 : Rn n) 1, ‖g x‖ₑ ^ 2 := by
          gcongr
  -- Step 3: let `r ↑ 1`.
  have hB := Submission.poincare_ball_double_integral_exhaustion n f _ hf.aestronglyMeasurable hBr
  -- Step 4: the mean.  Since `0 < |B| < ∞`, `|B|⁻¹ · 2^{n+2} |B| = 2^{n+2}`.
  have h0 : volume (ball (0 : Rn n) 1) ≠ 0 := (measure_ball_pos volume (0 : Rn n) one_pos).ne'
  have htop : volume (ball (0 : Rn n) 1) ≠ ∞ := measure_ball_lt_top.ne
  calc ∫⁻ x in ball (0 : Rn n) 1, ‖f x - ⨍ y in ball (0 : Rn n) 1, f y‖ₑ ^ 2
      ≤ (volume (ball (0 : Rn n) 1))⁻¹ *
          ∫⁻ x in ball (0 : Rn n) 1, ∫⁻ y in ball (0 : Rn n) 1, ‖f x - f y‖ₑ ^ 2 :=
        Submission.poincare_set_mean_deviation_sq_bound n _ f measurableSet_ball htop hf
    _ ≤ (volume (ball (0 : Rn n) 1))⁻¹ * ((2 : ℝ≥0∞) ^ (n + 2) * volume (ball (0 : Rn n) 1) *
          ∫⁻ x in ball (0 : Rn n) 1, ‖g x‖ₑ ^ 2) := by
        gcongr
    _ = ENNReal.ofReal (2 ^ (n + 2)) * ∫⁻ x in ball (0 : Rn n) 1, ‖g x‖ₑ ^ 2 := by
        rw [mul_comm ((2 : ℝ≥0∞) ^ (n + 2)), ← mul_assoc, ← mul_assoc,
          ENNReal.inv_mul_cancel h0 htop, one_mul, ENNReal.ofReal_pow zero_le_two,
          ENNReal.ofReal_ofNat]

/-- **Boundary-layer `L²` estimate for `W^{1,2}(B)`**, `B = B̆₁(0)` (a trace-type estimate along
rays from the origin; the boundary control of Rellich's theorem, cf. Evans §5.7,
Gilbarg–Trudinger §7.10): if `f ∈ W^{1,2}(B)` has weak gradient `g` and `0 < r < 1`, then
`∫_{B \ B̆_r(0)} |f|² ≤ 2^{n+3} √(1 − r) (∫_B |f|² + ∫_B |g|²)`.

For `r < 1/2` the constant is at least `1`.  For `r ≥ 1/2` and `0 < s < 1`, smooth `φ_j` with
`φ_j → f` and `∇φ_j → g` in `L²(B̆_s(0))` satisfy the annulus estimate on `B̆_s \ B̆_{rs}`; their
squared `L²` norms converge, so the estimate passes to `f`.  Finally `B̆_s \ B̆_r ⊆ B̆_s \ B̆_{rs}`,
and the sets `B̆_s \ B̆_r` increase to `B \ B̆_r` as `s ↑ 1`. -/
theorem w12_ball_boundary_layer_estimate : ∀ n : ℕ, 1 ≤ n → ∃ C : ℝ, 0 ≤ C ∧ ∀ (f : Rn n → ℝ) (g : Rn n → Rn n), IsW12WithGradient f g (ball 0 1) → ∀ r : ℝ, 0 < r → r < 1 → ∫⁻ x in ball (0 : Rn n) 1 \ ball 0 r, ‖f x‖ₑ ^ 2 ≤ ENNReal.ofReal (C * Real.sqrt (1 - r)) * ((∫⁻ x in ball (0 : Rn n) 1, ‖f x‖ₑ ^ 2) + ∫⁻ x in ball (0 : Rn n) 1, ‖g x‖ₑ ^ 2) := by
  intro n hn
  refine ⟨2 ^ (n + 3), by positivity, ?_⟩
  intro f g hW r hr0 hr1
  have hf2 : MemLp f 2 (volume.restrict (ball (0 : Rn n) 1)) := hW.1
  have hg2 : MemLp g 2 (volume.restrict (ball (0 : Rn n) 1)) := hW.2.1
  rcases lt_or_ge r (1 / 2) with hr | hr
  · -- Step 1: for `r < 1/2`, `√(1 − r) ≥ 1/2` and `2^{n+3} ≥ 8`, so the constant is `≥ 1`.
    have h1 : (1 / 2 : ℝ) ≤ Real.sqrt (1 - r) := by
      rw [Real.le_sqrt (by norm_num) (by linarith)]
      linarith
    have h2 : (8 : ℝ) ≤ 2 ^ (n + 3) :=
      calc (8 : ℝ) = 2 ^ 3 := by norm_num
        _ ≤ 2 ^ (n + 3) := pow_le_pow_right₀ (by norm_num) (by omega)
    have hK : 1 ≤ ENNReal.ofReal (2 ^ (n + 3) * Real.sqrt (1 - r)) := by
      rw [ENNReal.one_le_ofReal]
      linarith [mul_le_mul h2 h1 (by norm_num) (by positivity)]
    calc ∫⁻ x in ball (0 : Rn n) 1 \ ball 0 r, ‖f x‖ₑ ^ 2
        ≤ ∫⁻ x in ball (0 : Rn n) 1, ‖f x‖ₑ ^ 2 := lintegral_mono_set sdiff_subset
      _ ≤ (∫⁻ x in ball (0 : Rn n) 1, ‖f x‖ₑ ^ 2) + ∫⁻ x in ball (0 : Rn n) 1, ‖g x‖ₑ ^ 2 :=
        le_self_add
      _ ≤ _ := le_mul_of_one_le_left zero_le hK
  -- Step 3: for `0 < s < 1`, the annulus estimate for the smooth approximants on `B̆_s(0)`
  -- passes to `f` in the limit.
  have hannulus : ∀ s : ℝ, 0 < s → s < 1 →
      ∫⁻ x in ball (0 : Rn n) s \ ball 0 (r * s), ‖f x‖ₑ ^ 2 ≤
        ENNReal.ofReal (2 ^ (n + 3) * Real.sqrt (1 - r)) *
          ((∫⁻ x in ball (0 : Rn n) 1, ‖f x‖ₑ ^ 2) + ∫⁻ x in ball (0 : Rn n) 1, ‖g x‖ₑ ^ 2) := by
    intro s hs0 hs1
    obtain ⟨φ, hφ, hφf, hφg⟩ := Submission.w12_ball_smooth_approximation n hn f g hW s hs0 hs1
    have hB : ball (0 : Rn n) s ⊆ ball 0 1 := ball_subset_ball hs1.le
    have hA : ball (0 : Rn n) s \ ball 0 (r * s) ⊆ ball 0 s := sdiff_subset
    -- The approximants are `C¹`; they and their gradients are continuous.
    have hφ1 : ∀ j, ContDiff ℝ 1 (φ j) := fun j => (hφ j).of_le (by exact_mod_cast le_top)
    have hφc : ∀ j, Continuous (φ j) := fun j => (hφ j).continuous
    have hgc : ∀ j, Continuous (gradient (φ j)) := fun j =>
      (InnerProductSpace.toDual ℝ (Rn n)).symm.continuous.comp
        ((hφ1 j).continuous_fderiv one_ne_zero)
    -- Convergence of the squared `L²` norms on `B̆_s \ B̆_{rs}` and on `B̆_s`.
    have hlimA : Tendsto (fun j => ∫⁻ x in ball (0 : Rn n) s \ ball 0 (r * s), ‖φ j x‖ₑ ^ 2)
        atTop (𝓝 (∫⁻ x in ball (0 : Rn n) s \ ball 0 (r * s), ‖f x‖ₑ ^ 2)) :=
      Submission.ble_lintegral_sq_tendsto_of_l2_tendsto _ f φ
        (hf2.mono_measure (Measure.restrict_mono (hA.trans hB) le_rfl))
        (fun j => (hφc j).aestronglyMeasurable)
        (tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hφf
          (fun _ => zero_le) (fun _ => lintegral_mono_set hA))
    have hlimf : Tendsto (fun j => ∫⁻ x in ball (0 : Rn n) s, ‖φ j x‖ₑ ^ 2)
        atTop (𝓝 (∫⁻ x in ball (0 : Rn n) s, ‖f x‖ₑ ^ 2)) :=
      Submission.ble_lintegral_sq_tendsto_of_l2_tendsto _ f φ
        (hf2.mono_measure (Measure.restrict_mono hB le_rfl))
        (fun j => (hφc j).aestronglyMeasurable) hφf
    have hlimg : Tendsto (fun j => ∫⁻ x in ball (0 : Rn n) s, ‖gradient (φ j) x‖ₑ ^ 2)
        atTop (𝓝 (∫⁻ x in ball (0 : Rn n) s, ‖g x‖ₑ ^ 2)) :=
      Submission.ble_lintegral_sq_tendsto_of_l2_tendsto _ g (fun j => gradient (φ j))
        (hg2.mono_measure (Measure.restrict_mono hB le_rfl))
        (fun j => (hgc j).aestronglyMeasurable) hφg
    -- Step 2 (the smooth annulus estimate) for each `φ_j`, and the limit `j → ∞`.
    have hlim := le_of_tendsto_of_tendsto' hlimA
      (ENNReal.Tendsto.const_mul (hlimf.add hlimg) (Or.inr ENNReal.ofReal_ne_top))
      fun j => Submission.ble_smooth_annulus_estimate n hn (φ j) (hφ1 j) r s hr hr1 hs0 hs1.le
    -- Enlarge `B̆_s(0)` to `B`.
    refine hlim.trans ?_
    gcongr
  -- Step 4: `B̆_s \ B̆_r ⊆ B̆_s \ B̆_{rs}`, and `B̆_s \ B̆_r` increases to `B \ B̆_r` along radii
  -- `s_m ↑ 1`.
  obtain ⟨s, hs_mono, hs_mem, hs_lim⟩ := exists_seq_strictMono_tendsto' (zero_lt_one' ℝ)
  have hU : ball (0 : Rn n) 1 \ ball 0 r = ⋃ m, ball (0 : Rn n) (s m) \ ball 0 r := by
    rw [← iUnion_sdiff]
    congr 1
    ext x
    simp only [mem_ball, dist_zero_right, mem_iUnion]
    exact ⟨fun hx => (hs_lim.eventually (lt_mem_nhds hx)).exists,
      fun ⟨m, hm⟩ => hm.trans (hs_mem m).2⟩
  have hd : Directed (· ⊆ ·) fun m => ball (0 : Rn n) (s m) \ ball 0 r :=
    Monotone.directed_le fun i j hij =>
      sdiff_subset_sdiff_left (ball_subset_ball (hs_mono.monotone hij))
  rw [hU, setLIntegral_iUnion_of_directed _ hd]
  refine iSup_le fun m => ?_
  have hsub : ball (0 : Rn n) (s m) \ ball 0 r ⊆ ball 0 (s m) \ ball 0 (r * s m) :=
    sdiff_subset_sdiff_right (ball_subset_ball (mul_le_of_le_one_right hr0.le (hs_mem m).2.le))
  exact (lintegral_mono_set hsub).trans (hannulus (s m) (hs_mem m).1 (hs_mem m).2)

/-- Translation (difference-quotient) estimate for `W^{1,2}(B)` (Evans, *PDE*, §5.8.2, Theorem 3(i);
Gilbarg–Trudinger §7.11), used for Rellich compactness in the proof of Simon Ch. 5, Lemma 3.1
(p. 114): if `0 < r` and `‖z‖ < 1 - r`, then `∫_{B_r} |f(x - z) - f(x)|² ≤ |z|² ∫_B |g|²`.
With `s = r + ‖z‖ ∈ (0, 1)`, take smooth `φ_j` with `φ_j → f` and `∇φ_j → g` in `L²(B_s)`.  The
`C¹` estimate gives `∫_{B_r} |φ_j(x - z) - φ_j(x)|² ≤ |z|² ∫_{B_s} |∇φ_j|²`; the translation
differences of `φ_j` converge to those of `f` in `L²(B_r)`, with error at most
`4 ∫_{B_s} |φ_j - f|²`, so the estimate passes to the limit, and `B_s ⊆ B`. -/
theorem w12_ball_translation_estimate : ∀ n : ℕ, 1 ≤ n → ∀ (f : Rn n → ℝ) (g : Rn n → Rn n), IsW12WithGradient f g (ball 0 1) → ∀ (r : ℝ) (z : Rn n), 0 < r → ‖z‖ < 1 - r → ∫⁻ x in ball (0 : Rn n) r, ‖f (x - z) - f x‖ₑ ^ 2 ≤ ENNReal.ofReal (‖z‖ ^ 2) * ∫⁻ x in ball (0 : Rn n) 1, ‖g x‖ₑ ^ 2 := by
  intro n hn f g hfg r z hr hz
  -- Step 0: `B_r ⊆ B_s ⊆ B` for `s = r + ‖z‖ ∈ (0, 1)`; `f`, `g`, `f(· - z)` are measurable there.
  have hs0 : 0 < r + ‖z‖ := add_pos_of_pos_of_nonneg hr (norm_nonneg z)
  have hs1 : r + ‖z‖ < 1 := by linarith
  have hBs : ball (0 : Rn n) (r + ‖z‖) ⊆ ball 0 1 := ball_subset_ball hs1.le
  have hBr : ball (0 : Rn n) r ⊆ ball 0 (r + ‖z‖) :=
    ball_subset_ball (le_add_of_nonneg_right (norm_nonneg z))
  have hfs : AEStronglyMeasurable f (volume.restrict (ball (0 : Rn n) (r + ‖z‖))) :=
    hfg.1.aestronglyMeasurable.mono_measure (Measure.restrict_mono hBs le_rfl)
  have hgs : AEStronglyMeasurable g (volume.restrict (ball (0 : Rn n) (r + ‖z‖))) :=
    hfg.2.1.aestronglyMeasurable.mono_measure (Measure.restrict_mono hBs le_rfl)
  have hfr : AEStronglyMeasurable f (volume.restrict (ball (0 : Rn n) r)) :=
    hfs.mono_measure (Measure.restrict_mono hBr le_rfl)
  have hfzr : AEStronglyMeasurable (fun x => f (x - z)) (volume.restrict (ball (0 : Rn n) r)) :=
    Submission.aestronglyMeasurable_ball_comp_sub n f r (r + ‖z‖) z le_rfl hfs
  -- Step 1: smooth `φ_j` with `φ_j → f` and `∇φ_j → g` in `L²(B_s)`.
  obtain ⟨φ, hφ, hφf, hφg⟩ :=
    Submission.w12_ball_smooth_approximation n hn f g hfg (r + ‖z‖) hs0 hs1
  have hφ1 : ∀ j, ContDiff ℝ 1 (φ j) := fun j => (hφ j).of_le (by exact_mod_cast le_top)
  have hφc : ∀ j, Continuous (φ j) := fun j => (hφ j).continuous
  have hgradc : ∀ j, Continuous (gradient (φ j)) := fun j =>
    (InnerProductSpace.toDual ℝ (Rn n)).symm.continuous.comp
      ((hφ1 j).continuous_fderiv one_ne_zero)
  -- Step 2: the `C¹` estimate for each `φ_j`.
  have hsmooth : ∀ j, ∫⁻ x in ball (0 : Rn n) r, ‖φ j (x - z) - φ j x‖ₑ ^ 2 ≤
      ENNReal.ofReal (‖z‖ ^ 2) * ∫⁻ x in ball (0 : Rn n) (r + ‖z‖), ‖gradient (φ j) x‖ₑ ^ 2 :=
    fun j => Submission.contDiff_one_ball_translation_estimate n (φ j) (hφ1 j) r z
  -- Step 3: the translation differences of `φ_j` converge to those of `f` in `L²(B_r)`.
  have hdiff : ∀ j, ∫⁻ x in ball (0 : Rn n) r,
      ‖(φ j (x - z) - φ j x) - (f (x - z) - f x)‖ₑ ^ 2 ≤
        4 * ∫⁻ x in ball (0 : Rn n) (r + ‖z‖), ‖φ j x - f x‖ₑ ^ 2 := by
    intro j
    calc ∫⁻ x in ball (0 : Rn n) r, ‖(φ j (x - z) - φ j x) - (f (x - z) - f x)‖ₑ ^ 2
        = ∫⁻ x in ball (0 : Rn n) r, ‖(φ j (x - z) - f (x - z)) - (φ j x - f x)‖ₑ ^ 2 :=
          lintegral_congr fun x => by rw [sub_sub_sub_comm]
      _ ≤ 4 * ∫⁻ x in ball (0 : Rn n) (r + ‖z‖), ‖φ j x - f x‖ₑ ^ 2 :=
          Submission.lintegral_ball_translation_difference_le n (fun x => φ j x - f x) r
            (r + ‖z‖) z le_rfl ((hφc j).aestronglyMeasurable.sub hfs)
  have hconv : Tendsto (fun j => ∫⁻ x in ball (0 : Rn n) r,
      ‖(φ j (x - z) - φ j x) - (f (x - z) - f x)‖ₑ ^ 2) atTop (𝓝 0) := by
    have h4 := ENNReal.Tendsto.const_mul (a := 4) hφf (Or.inr (by norm_num))
    rw [mul_zero] at h4
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds h4 (fun _ => zero_le) hdiff
  -- Step 4: pass to the limit in `L²(B_r)` and `L²(B_s)`, then enlarge `B_s` to `B`.
  calc ∫⁻ x in ball (0 : Rn n) r, ‖f (x - z) - f x‖ₑ ^ 2
      ≤ ENNReal.ofReal (‖z‖ ^ 2) * ∫⁻ x in ball (0 : Rn n) (r + ‖z‖), ‖g x‖ₑ ^ 2 :=
        Submission.lintegral_sq_le_of_l2_approximation (volume.restrict (ball (0 : Rn n) r))
          (volume.restrict (ball (0 : Rn n) (r + ‖z‖))) (ENNReal.ofReal (‖z‖ ^ 2))
          (fun j x => φ j (x - z) - φ j x) (fun x => f (x - z) - f x)
          (fun j => gradient (φ j)) g ENNReal.ofReal_ne_top
          (fun j => (((hφc j).comp (continuous_sub_right z)).sub (hφc j)).aestronglyMeasurable)
          (hfzr.sub hfr) (fun j => (hgradc j).aestronglyMeasurable) hgs hconv hφg hsmooth
    _ ≤ ENNReal.ofReal (‖z‖ ^ 2) * ∫⁻ x in ball (0 : Rn n) 1, ‖g x‖ₑ ^ 2 :=
        mul_le_mul_right (lintegral_mono_set hBs) _

/-- **Rellich compactness on the unit ball** (Simon Ch. 5, fact (R) in the proof of Lemma 3.1;
Gilbarg–Trudinger, Thm. 7.26).  If `f k ∈ W^{1,2}(B̆₁(0))` with weak gradients `g k` and
`∫_B |f k|² ≤ A`, `∫_B |g k|² ≤ A` for all `k`, then a subsequence `f (φ k)` converges in
`L²(B̆₁(0))` to some `w ∈ L²(B̆₁(0))`.

Proof (parent-supplied natural proof, steps 0–6): pass to measurable representatives; mollify at
the scales `ε_m = 1/(m+2)` with the normalized tent kernel `max (ε - ‖z‖) 0 / I`.  By
`w12_ball_translation_estimate` the interior mollification error on `B̆_r(0)` is `≤ ε² A`.  For
fixed `m` the mollified functions are uniformly bounded and equi-Lipschitz, so a finite `δ`-net of
`B₁(0)` and Bolzano–Weierstrass in `ℝ^net` give, for every tolerance, a subsequence that is
uniformly Cauchy up to that tolerance; a diagonal argument over all pairs (scale, tolerance) gives
one subsequence `φ`.  `w12_ball_boundary_layer_estimate` controls the annulus
`B̆₁(0) \ B̆_r(0)`, so `f (φ k)` is Cauchy in `L²(B̆₁(0))`, and completeness of `L²` gives `w`. -/
theorem w12_ball_rellich_compactness : ∀ n : ℕ, 1 ≤ n → ∀ (A : ℝ) (f : ℕ → Rn n → ℝ) (g : ℕ → Rn n → Rn n), (∀ k, IsW12WithGradient (f k) (g k) (ball 0 1)) → (∀ k, ∫⁻ x in ball (0 : Rn n) 1, ‖f k x‖ₑ ^ 2 ≤ ENNReal.ofReal A) → (∀ k, ∫⁻ x in ball (0 : Rn n) 1, ‖g k x‖ₑ ^ 2 ≤ ENNReal.ofReal A) → ∃ (φ : ℕ → ℕ) (w : Rn n → ℝ), StrictMono φ ∧ MemLp w 2 (volume.restrict (ball (0 : Rn n) 1)) ∧ Tendsto (fun k => ∫⁻ x in ball (0 : Rn n) 1, ‖f (φ k) x - w x‖ₑ ^ 2) atTop (𝓝 0) := by
  intro n hn
  -- Step 1 (and 3): a normalized tent kernel `ρ` supported in `B_ε(0)`, and uniform sup and
  -- Lipschitz bounds for `x ↦ ∫_B ρ (x - y) u y` in terms of `∫_B |u|²`.
  have hmol : ∀ ε : ℝ, 0 < ε → ∃ (ρ : Rn n → ℝ) (C : ℝ), Continuous ρ ∧ (∀ z, 0 ≤ ρ z) ∧
      (∀ z, ε < ‖z‖ → ρ z = 0) ∧ ∫ z, ρ z = 1 ∧ ∀ (a : ℝ) (u : Rn n → ℝ),
      MemLp u 2 (volume.restrict (ball (0 : Rn n) 1)) →
      ∫⁻ y in ball (0 : Rn n) 1, ‖u y‖ₑ ^ 2 ≤ ENNReal.ofReal a → ∀ x x' : Rn n,
      |∫ y in ball (0 : Rn n) 1, ρ (x - y) * u y| ≤ C * Real.sqrt a ∧
      |(∫ y in ball (0 : Rn n) 1, ρ (x - y) * u y) - ∫ y in ball (0 : Rn n) 1, ρ (x' - y) * u y| ≤
        C * Real.sqrt a * ‖x - x'‖ := by
    intro ε hε
    -- the tent `τ z = max (ε - ‖z‖) 0` and its integral `I > 0`
    let τ : Rn n → ℝ := fun z => max (ε - ‖z‖) 0
    have hτc : Continuous τ := (continuous_const.sub continuous_norm).max continuous_const
    have hτnn : ∀ z, 0 ≤ τ z := fun z => le_max_right _ _
    have hτ0 : ∀ z, ε < ‖z‖ → τ z = 0 := fun z hz => max_eq_right (by linarith)
    have hτint : Integrable τ := hτc.integrable_of_hasCompactSupport
      (HasCompactSupport.intro (isCompact_closedBall 0 ε) fun z hz =>
        hτ0 z (by rwa [mem_closedBall_zero_iff, not_le] at hz))
    have hIpos : 0 < ∫ z, τ z := by
      rw [integral_pos_iff_support_of_nonneg (fun z => hτnn z) hτint]
      refine lt_of_lt_of_le (measure_ball_pos volume (0 : Rn n) hε) (measure_mono fun z hz => ?_)
      rw [mem_ball_zero_iff] at hz
      exact (lt_max_of_lt_left (sub_pos.mpr hz)).ne'
    set I : ℝ := ∫ z, τ z with hI
    let ρ : Rn n → ℝ := fun z => τ z / I
    have hρc : Continuous ρ := hτc.div_const I
    have hM : ∀ z, |ρ z| ≤ ε / I := fun z => by
      show |τ z / I| ≤ ε / I
      rw [abs_of_nonneg (div_nonneg (hτnn z) hIpos.le)]
      exact div_le_div_of_nonneg_right (max_le (by linarith [norm_nonneg z]) hε.le) hIpos.le
    have hL : ∀ p q, |ρ p - ρ q| ≤ 1 / I * ‖p - q‖ := fun p q => by
      show |τ p / I - τ q / I| ≤ 1 / I * ‖p - q‖
      have h1 : |τ p - τ q| ≤ ‖p - q‖ := (abs_max_sub_max_le_abs _ _ _).trans (by
        rw [show ε - ‖p‖ - (ε - ‖q‖) = ‖q‖ - ‖p‖ by ring, abs_sub_comm]
        exact abs_norm_sub_norm_le p q)
      rw [← sub_div, abs_div, abs_of_pos hIpos, one_div_mul_eq_div]
      exact div_le_div_of_nonneg_right h1 hIpos.le
    set B : Set (Rn n) := ball (0 : Rn n) 1 with hB
    set V : ℝ := (volume B).toReal with hV
    have hBfin : volume B ≠ ⊤ := measure_ball_lt_top.ne
    have : IsFiniteMeasure (volume.restrict B) := isFiniteMeasure_restrict.2 hBfin
    -- L¹ bound via Hölder (eLpNorm comparison)
    have hL1 : ∀ (a : ℝ) (u : Rn n → ℝ), MemLp u 2 (volume.restrict B) →
        ∫⁻ y in B, ‖u y‖ₑ ^ 2 ≤ ENNReal.ofReal a →
        ∫ y in B, |u y| ≤ Real.sqrt V * Real.sqrt a := by
      intro a u hu ha
      have hum : AEStronglyMeasurable u (volume.restrict B) := hu.aestronglyMeasurable
      have key1 := eLpNorm_le_eLpNorm_mul_rpow_measure_univ (p := 1) (q := 2)
        (μ := volume.restrict B) (by norm_num) hum
      rw [eLpNorm_one_eq_lintegral_enorm hum,
        eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num) hum,
        Measure.restrict_apply_univ] at key1
      have h2 : ((2 : ℝ≥0∞)).toReal = 2 := by norm_num
      simp only [h2, ENNReal.toReal_one, ENNReal.rpow_two] at key1
      have key2 : ∫⁻ y in B, ‖u y‖ₑ ≤
          ENNReal.ofReal a ^ (1 / 2 : ℝ) * volume B ^ (1 / 2 : ℝ) := by
        refine key1.trans ?_
        have e : (1 / 1 - 1 / 2 : ℝ) = 1 / 2 := by norm_num
        rw [e]
        gcongr
      have hT : ∫ y in B, |u y| = (∫⁻ y in B, ‖u y‖ₑ).toReal := by
        simp_rw [← Real.norm_eq_abs]
        exact integral_norm_eq_lintegral_enorm hum
      rw [hT]
      have hfin : ENNReal.ofReal a ^ (1 / 2 : ℝ) * volume B ^ (1 / 2 : ℝ) ≠ ⊤ := by
        apply ENNReal.mul_ne_top
        · exact ENNReal.rpow_ne_top_of_nonneg (by norm_num) ENNReal.ofReal_ne_top
        · exact ENNReal.rpow_ne_top_of_nonneg (by norm_num) hBfin
      refine (ENNReal.toReal_mono hfin key2).trans (le_of_eq ?_)
      rw [ENNReal.toReal_mul, ← ENNReal.toReal_rpow, ← ENNReal.toReal_rpow,
        ← Real.sqrt_eq_rpow, ← Real.sqrt_eq_rpow, ← hV, mul_comm]
      congr 1
      rcases le_total 0 a with h | h
      · rw [ENNReal.toReal_ofReal h]
      · rw [ENNReal.ofReal_of_nonpos h, Real.sqrt_eq_zero_of_nonpos h]
        simp
    have hML : 0 ≤ max (ε / I) (1 / I) := le_max_of_le_right (by positivity)
    refine ⟨ρ, max (ε / I) (1 / I) * Real.sqrt V, hρc, fun z => div_nonneg (hτnn z) hIpos.le,
      fun z hz => by simp only [ρ, hτ0 z hz, zero_div], ?_, ?_⟩
    · show ∫ z, τ z / I = 1
      rw [integral_div, div_self hIpos.ne']
    intro a u hu ha x x'
    have hui : Integrable u (volume.restrict B) := hu.integrable (by norm_num)
    have hT := hL1 a u hu ha
    have hTnn : 0 ≤ ∫ y in B, |u y| := integral_nonneg (fun _ => abs_nonneg _)
    have hcomp : ∀ x0 : Rn n, Continuous (fun y => ρ (x0 - y)) :=
      fun x0 => hρc.comp (continuous_const.sub continuous_id)
    have hint : ∀ x0 : Rn n, Integrable (fun y => ρ (x0 - y) * u y) (volume.restrict B) :=
      fun x0 => hui.bdd_mul (c := ε / I) (hcomp x0).aestronglyMeasurable
        (Eventually.of_forall fun y => by rw [Real.norm_eq_abs]; exact hM (x0 - y))
    have hbound : ∀ K : ℝ, ∫ y in B, K * |u y| = K * ∫ y in B, |u y| :=
      fun K => integral_const_mul K _
    constructor
    · have h1 : ‖∫ y in B, ρ (x - y) * u y‖ ≤ ∫ y in B, ε / I * |u y| :=
        norm_integral_le_of_norm_le (hui.abs.const_mul (ε / I)) (Eventually.of_forall fun y => by
          rw [norm_mul, Real.norm_eq_abs (u y), Real.norm_eq_abs]
          exact mul_le_mul_of_nonneg_right (hM (x - y)) (abs_nonneg _))
      rw [hbound, Real.norm_eq_abs] at h1
      calc |∫ y in B, ρ (x - y) * u y| ≤ ε / I * ∫ y in B, |u y| := h1
        _ ≤ max (ε / I) (1 / I) * ∫ y in B, |u y| :=
          mul_le_mul_of_nonneg_right (le_max_left _ _) hTnn
        _ ≤ max (ε / I) (1 / I) * (Real.sqrt V * Real.sqrt a) := mul_le_mul_of_nonneg_left hT hML
        _ = max (ε / I) (1 / I) * Real.sqrt V * Real.sqrt a := by ring
    · rw [← integral_sub (hint x) (hint x')]
      have h1 : ‖∫ y in B, (ρ (x - y) * u y - ρ (x' - y) * u y)‖ ≤
          ∫ y in B, (1 / I * ‖x - x'‖) * |u y| :=
        norm_integral_le_of_norm_le (hui.abs.const_mul _) (Eventually.of_forall fun y => by
          rw [← sub_mul, norm_mul, Real.norm_eq_abs (u y), Real.norm_eq_abs]
          refine mul_le_mul_of_nonneg_right ?_ (abs_nonneg _)
          have := hL (x - y) (x' - y)
          rwa [sub_sub_sub_cancel_right] at this)
      rw [hbound, Real.norm_eq_abs] at h1
      have hxx : 0 ≤ ‖x - x'‖ := norm_nonneg _
      calc |∫ y in B, (ρ (x - y) * u y - ρ (x' - y) * u y)|
          ≤ 1 / I * ‖x - x'‖ * ∫ y in B, |u y| := h1
        _ ≤ max (ε / I) (1 / I) * ‖x - x'‖ * ∫ y in B, |u y| :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_right (le_max_right _ _) hxx) hTnn
        _ ≤ max (ε / I) (1 / I) * ‖x - x'‖ * (Real.sqrt V * Real.sqrt a) :=
          mul_le_mul_of_nonneg_left hT (mul_nonneg hML hxx)
        _ = max (ε / I) (1 / I) * Real.sqrt V * Real.sqrt a * ‖x - x'‖ := by ring
  -- Step 2: the interior mollification error, by Jensen for the probability density `ρ`,
  -- Tonelli, and a translation estimate.
  have hmolerr : ∀ (ρ u : Rn n → ℝ) (ε r : ℝ) (E : ℝ≥0∞), Continuous ρ → (∀ z, 0 ≤ ρ z) →
      (∀ z, ε < ‖z‖ → ρ z = 0) → ∫ z, ρ z = 1 → Measurable u → 0 < r → ε < 1 - r →
      (∀ z : Rn n, ‖z‖ < 1 - r →
        ∫⁻ x in ball (0 : Rn n) r, ‖u (x - z) - u x‖ₑ ^ 2 ≤ ENNReal.ofReal (‖z‖ ^ 2) * E) →
      ∫⁻ x in ball (0 : Rn n) r, ‖(∫ y in ball (0 : Rn n) 1, ρ (x - y) * u y) - u x‖ₑ ^ 2 ≤
        ENNReal.ofReal (ε ^ 2) * E := by
    clear hmol
    intro ρ u ε r E hρc hρ0 hρsupp hρ1 hu hr hεr htrans
    -- preliminaries on ρ
    have hρint : Integrable ρ := by
      by_contra h
      rw [integral_undef h] at hρ1
      exact zero_ne_one hρ1
    have hρlint : ∫⁻ z, ENNReal.ofReal (ρ z) = 1 := by
      rw [← ofReal_integral_eq_lintegral_ofReal hρint (Filter.Eventually.of_forall hρ0), hρ1,
        ENNReal.ofReal_one]
    have hsupp : ∀ z, ρ z ≠ 0 → ‖z‖ ≤ ε := by
      intro z hz
      by_contra h
      exact hz (hρsupp z (lt_of_not_ge h))
    have hρm : Measurable fun z => ENNReal.ofReal (ρ z) := hρc.measurable.ennreal_ofReal
    -- change of variables `y = x - z`
    have hconv : ∀ x ∈ ball (0 : Rn n) r,
        (∫ y in ball (0 : Rn n) 1, ρ (x - y) * u y) = ∫ z, ρ z * u (x - z) := by
      intro x hx
      rw [← integral_indicator measurableSet_ball,
        ← integral_sub_left_eq_self ((ball (0 : Rn n) 1).indicator (fun y => ρ (x - y) * u y))
          (volume : Measure (Rn n)) x]
      congr 1
      ext z
      by_cases hz : ρ z = 0
      · rw [hz, zero_mul]
        by_cases hm : x - z ∈ ball (0 : Rn n) 1
        · rw [indicator_of_mem hm, sub_sub_cancel, hz, zero_mul]
        · rw [indicator_of_notMem hm]
      · have hzε := hsupp z hz
        have hm : x - z ∈ ball (0 : Rn n) 1 := by
          rw [mem_ball_zero_iff] at hx ⊢
          calc ‖x - z‖ ≤ ‖x‖ + ‖z‖ := norm_sub_le x z
            _ < r + (1 - r) := by linarith
            _ = 1 := by ring
        rw [indicator_of_mem hm, sub_sub_cancel]
    -- pointwise Cauchy–Schwarz
    have hpt : ∀ x ∈ ball (0 : Rn n) r,
        ‖(∫ y in ball (0 : Rn n) 1, ρ (x - y) * u y) - u x‖ₑ ^ 2 ≤
          ∫⁻ z, ENNReal.ofReal (ρ z) * ‖u (x - z) - u x‖ₑ ^ 2 := by
      intro x hx
      rw [hconv x hx]
      set J := ∫⁻ z, ENNReal.ofReal (ρ z) * ‖u (x - z) - u x‖ₑ ^ 2 with hJdef
      by_cases hJ : J = ⊤
      · rw [hJ]; exact le_top
      have hDm : Measurable fun z => u (x - z) - u x :=
        (hu.comp (measurable_const.sub measurable_id)).sub measurable_const
      have hHol : ∫⁻ z, ENNReal.ofReal (ρ z) * ‖u (x - z) - u x‖ₑ ≤ J ^ (1 / 2 : ℝ) := by
        have := ENNReal.lintegral_mul_norm_pow_le (μ := volume)
          (f := fun z => ENNReal.ofReal (ρ z))
          (g := fun z => ENNReal.ofReal (ρ z) * ‖u (x - z) - u x‖ₑ ^ 2)
          hρm.aemeasurable (hρm.mul (hDm.enorm.pow_const 2)).aemeasurable
          (p := 1 / 2) (q := 1 / 2) (by norm_num) (by norm_num) (by norm_num)
        rw [hρlint, ENNReal.one_rpow, one_mul] at this
        refine le_trans (le_of_eq ?_) this
        congr 1
        ext z
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 1 / 2), ← mul_assoc,
          ← ENNReal.rpow_add_of_nonneg _ _ (by norm_num) (by norm_num), ← ENNReal.rpow_natCast,
          ← ENNReal.rpow_mul]
        norm_num
      have hfin : ∫⁻ z, ENNReal.ofReal (ρ z) * ‖u (x - z) - u x‖ₑ < ⊤ :=
        lt_of_le_of_lt hHol (ENNReal.rpow_lt_top_of_nonneg (by norm_num) hJ)
      have hnorm : ∀ z, ‖ρ z * (u (x - z) - u x)‖ₑ =
          ENNReal.ofReal (ρ z) * ‖u (x - z) - u x‖ₑ := by
        intro z
        rw [enorm_mul, Real.enorm_of_nonneg (hρ0 z)]
      have hint : Integrable (fun z => ρ z * (u (x - z) - u x)) := by
        refine ⟨(hρc.measurable.mul hDm).aestronglyMeasurable, ?_⟩
        rw [hasFiniteIntegral_iff_enorm]
        simp_rw [hnorm]
        exact hfin
      have hint2 : Integrable (fun z => ρ z * u (x - z)) := by
        refine (hint.add (hρint.mul_const (u x))).congr (Filter.Eventually.of_forall fun z => ?_)
        simp only [Pi.add_apply]
        ring
      have heq : (∫ z, ρ z * u (x - z)) - u x = ∫ z, ρ z * (u (x - z) - u x) := by
        have h1 : ∫ z, ρ z * u x = u x := by rw [integral_mul_const, hρ1, one_mul]
        simp_rw [mul_sub]
        rw [integral_sub hint2 (hρint.mul_const (u x)), h1]
      rw [heq]
      calc ‖∫ z, ρ z * (u (x - z) - u x)‖ₑ ^ 2
          ≤ (∫⁻ z, ‖ρ z * (u (x - z) - u x)‖ₑ) ^ 2 := by
            gcongr
            exact enorm_integral_le_lintegral_enorm _
        _ = (∫⁻ z, ENNReal.ofReal (ρ z) * ‖u (x - z) - u x‖ₑ) ^ 2 := by simp_rw [hnorm]
        _ ≤ (J ^ (1 / 2 : ℝ)) ^ 2 := by gcongr
        _ = J := by
            rw [← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]
            norm_num
    -- integrate over `B̆_r(0)` and use Tonelli
    have hjm : Measurable (Function.uncurry fun (x z : Rn n) =>
        ENNReal.ofReal (ρ z) * ‖u (x - z) - u x‖ₑ ^ 2) := by
      have h1 : Measurable fun p : Rn n × Rn n => ENNReal.ofReal (ρ p.2) :=
        (hρc.measurable.comp measurable_snd).ennreal_ofReal
      have h2 : Measurable fun p : Rn n × Rn n => ‖u (p.1 - p.2) - u p.1‖ₑ ^ 2 :=
        ((hu.comp (measurable_fst.sub measurable_snd)).sub (hu.comp measurable_fst)).enorm.pow_const 2
      exact h1.mul h2
    calc ∫⁻ x in ball (0 : Rn n) r, ‖(∫ y in ball (0 : Rn n) 1, ρ (x - y) * u y) - u x‖ₑ ^ 2
        ≤ ∫⁻ x in ball (0 : Rn n) r, ∫⁻ z, ENNReal.ofReal (ρ z) * ‖u (x - z) - u x‖ₑ ^ 2 :=
          setLIntegral_mono' measurableSet_ball hpt
      _ = ∫⁻ z, ∫⁻ x in ball (0 : Rn n) r, ENNReal.ofReal (ρ z) * ‖u (x - z) - u x‖ₑ ^ 2 :=
          lintegral_lintegral_swap hjm.aemeasurable
      _ = ∫⁻ z, ENNReal.ofReal (ρ z) * ∫⁻ x in ball (0 : Rn n) r, ‖u (x - z) - u x‖ₑ ^ 2 := by
          congr 1
          ext z
          exact lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
      _ ≤ ∫⁻ z, ENNReal.ofReal (ρ z) * (ENNReal.ofReal (ε ^ 2) * E) := by
          apply lintegral_mono
          intro z
          dsimp only
          by_cases hz : ρ z = 0
          · rw [hz, ENNReal.ofReal_zero, zero_mul, zero_mul]
          · have hzε := hsupp z hz
            gcongr
            calc _ ≤ ENNReal.ofReal (‖z‖ ^ 2) * E := htrans z (by linarith)
              _ ≤ _ := by gcongr
      _ = (∫⁻ z, ENNReal.ofReal (ρ z)) * (ENNReal.ofReal (ε ^ 2) * E) :=
          lintegral_mul_const _ hρm
      _ = ENNReal.ofReal (ε ^ 2) * E := by rw [hρlint, one_mul]
  -- Step 4a: for uniformly bounded, equi-Lipschitz functions on a compact set `K` and a tolerance
  -- `η > 0`, every subsequence has a further subsequence that is eventually `η`-close uniformly
  -- on `K` (a finite `δ`-net of `K` and Bolzano–Weierstrass in `ℝ^net`).
  have hAA : ∀ (K : Set (Rn n)) (h : ℕ → Rn n → ℝ) (M L : ℝ), IsCompact K →
      (∀ k, ∀ x ∈ K, |h k x| ≤ M) → (∀ k, ∀ x ∈ K, ∀ y ∈ K, |h k x - h k y| ≤ L * dist x y) →
      ∀ η : ℝ, 0 < η → ∀ ψ : ℕ → ℕ, ∃ σ : ℕ → ℕ, StrictMono σ ∧ ∃ N : ℕ, ∀ k l, N ≤ k → N ≤ l →
        ∀ x ∈ K, |h (ψ (σ k)) x - h (ψ (σ l)) x| ≤ η := by
    clear hmol hmolerr
    intro K h M L hK hM hL η hη ψ
    set L' : ℝ := max L 0 with hL'
    have hL'0 : 0 ≤ L' := le_max_right _ _
    set δ : ℝ := η / (3 * (L' + 1)) with hδ
    have hδ0 : 0 < δ := by positivity
    have hδη : 3 * (L' + 1) * δ = η := by
      rw [hδ, mul_comm]
      exact div_mul_cancel₀ η (by positivity)
    obtain ⟨t, htK, htfin, hcover⟩ := finite_cover_balls_of_compact hK hδ0
    have : Fintype t := htfin.fintype
    let v : ℕ → (t → ℝ) := fun k y => h (ψ k) y
    have hvmem : ∀ k, v k ∈ Set.pi univ fun _ : t => Icc (-M) M := fun k y _ =>
      abs_le.mp (hM (ψ k) y (htK y.2))
    obtain ⟨a, -, σ, hσ, hlim⟩ :=
      (isCompact_univ_pi fun _ : t => isCompact_Icc (a := -M) (b := M)).tendsto_subseq hvmem
    obtain ⟨N, hN⟩ := Metric.cauchySeq_iff.mp hlim.cauchySeq δ hδ0
    refine ⟨σ, hσ, N, fun k l hk hl x hx => ?_⟩
    obtain ⟨y, hyt, hxy⟩ := mem_iUnion₂.mp (hcover hx)
    have hxy' : dist x y ≤ δ := (mem_ball.mp hxy).le
    have h1 : |h (ψ (σ k)) y - h (ψ (σ l)) y| ≤ δ := by
      have := (dist_le_pi_dist (v (σ k)) (v (σ l)) ⟨y, hyt⟩).trans (hN k hk l hl).le
      rwa [Real.dist_eq] at this
    have hLip : ∀ j, |h j x - h j y| ≤ L' * δ := fun j =>
      (hL j x hx y (htK hyt)).trans (mul_le_mul (le_max_left _ _) hxy' dist_nonneg hL'0)
    have h2 := hLip (ψ (σ k))
    have h3 := hLip (ψ (σ l))
    rw [abs_sub_comm] at h3
    calc |h (ψ (σ k)) x - h (ψ (σ l)) x|
        ≤ |h (ψ (σ k)) x - h (ψ (σ k)) y| + |h (ψ (σ k)) y - h (ψ (σ l)) y| +
            |h (ψ (σ l)) y - h (ψ (σ l)) x| := by
          have e1 := abs_sub_le (h (ψ (σ k)) x) (h (ψ (σ k)) y) (h (ψ (σ l)) x)
          have e2 := abs_sub_le (h (ψ (σ k)) y) (h (ψ (σ l)) y) (h (ψ (σ l)) x)
          linarith
      _ ≤ L' * δ + δ + L' * δ := by linarith
      _ ≤ η := by linarith [mul_nonneg hL'0 hδ0.le]
  -- Step 4b: the diagonal argument for countably many eventually-pairwise properties that can
  -- each be achieved along a further subsequence of any subsequence.
  have hdiag : ∀ R : ℕ → ℕ → ℕ → Prop, (∀ (j : ℕ) (ψ : ℕ → ℕ), StrictMono ψ →
      ∃ σ : ℕ → ℕ, StrictMono σ ∧ ∃ N : ℕ, ∀ k l, N ≤ k → N ≤ l → R j (ψ (σ k)) (ψ (σ l))) →
      ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ j, ∃ N : ℕ, ∀ k l, N ≤ k → N ≤ l → R j (φ k) (φ l) := by
    clear hmol hmolerr hAA
    intro R hR
    choose s hs_mono hs_cauchy using hR
    -- `Σ_0 = id`, `Σ_{m+1} = Σ_m ∘ s m Σ_m`, in the subtype of strictly increasing maps
    obtain ⟨Sig, hSigS⟩ : ∃ Sig : ℕ → {ψ : ℕ → ℕ // StrictMono ψ},
        ∀ m, (Sig (m + 1)).1 = (Sig m).1 ∘ s m (Sig m).1 (Sig m).2 :=
      ⟨fun m => Nat.rec (motive := fun _ => {ψ : ℕ → ℕ // StrictMono ψ}) ⟨id, strictMono_id⟩
        (fun m Ψ => ⟨Ψ.1 ∘ s m Ψ.1 Ψ.2, Ψ.2.comp (hs_mono m Ψ.1 Ψ.2)⟩) m, fun _ => rfl⟩
    -- nesting: for `m ≤ k`, the value of `Σ_k` at `i` is a value of `Σ_m` at some `j ≥ i`
    have nest : ∀ m k, m ≤ k → ∀ i, ∃ j, i ≤ j ∧ (Sig k).1 i = (Sig m).1 j := by
      intro m k hmk
      induction k, hmk using Nat.le_induction with
      | base => exact fun i => ⟨i, le_rfl, rfl⟩
      | succ k _ ih =>
        intro i
        obtain ⟨j, hij, hj⟩ := ih (s k (Sig k).1 (Sig k).2 i)
        exact ⟨j, (hs_mono k _ _).le_apply.trans hij, by rw [hSigS]; exact hj⟩
    -- the diagonal map `φ k = Σ_k k`
    refine ⟨fun k => (Sig k).1 k, strictMono_nat_of_lt_succ fun k => ?_, fun m => ?_⟩
    · show (Sig k).1 k < (Sig (k + 1)).1 (k + 1)
      rw [hSigS]
      exact (Sig k).2 ((Nat.lt_succ_self k).trans_le (hs_mono k _ _).le_apply)
    · obtain ⟨N, hN⟩ := hs_cauchy m (Sig m).1 (Sig m).2
      refine ⟨max N (m + 1), fun k l hk hl => ?_⟩
      obtain ⟨a, hka, ha⟩ := nest (m + 1) k ((le_max_right _ _).trans hk) k
      obtain ⟨b, hlb, hb⟩ := nest (m + 1) l ((le_max_right _ _).trans hl) l
      show R m ((Sig k).1 k) ((Sig l).1 l)
      rw [ha, hb, hSigS]
      exact hN a b ((le_max_left _ _).trans (hk.trans hka)) ((le_max_left _ _).trans (hl.trans hlb))
  -- Step 5 (criterion): uniform smallness on the annulus plus uniform interior approximation by
  -- functions that are uniformly Cauchy gives the Cauchy property in `L²(B̆₁(0))`.
  have hcrit : ∀ u : ℕ → Rn n → ℝ,
      (∀ k, AEStronglyMeasurable (u k) (volume.restrict (ball (0 : Rn n) 1))) →
      (∀ η : ℝ, 0 < η → ∃ (r : ℝ) (v : ℕ → Rn n → ℝ), 0 < r ∧ r < 1 ∧
        (∀ k, AEStronglyMeasurable (v k) (volume.restrict (ball (0 : Rn n) r))) ∧
        (∀ k, ∫⁻ x in ball (0 : Rn n) 1 \ ball 0 r, ‖u k x‖ₑ ^ 2 ≤ ENNReal.ofReal η) ∧
        (∀ k, ∫⁻ x in ball (0 : Rn n) r, ‖u k x - v k x‖ₑ ^ 2 ≤ ENNReal.ofReal η) ∧
        ∀ θ : ℝ, 0 < θ → ∃ N : ℕ, ∀ k l, N ≤ k → N ≤ l →
          ∀ x ∈ ball (0 : Rn n) r, |v k x - v l x| ≤ θ) →
      ∀ η : ℝ, 0 < η → ∃ N : ℕ, ∀ k l, N ≤ k → N ≤ l →
        ∫⁻ x in ball (0 : Rn n) 1, ‖u k x - u l x‖ₑ ^ 2 ≤ ENNReal.ofReal η := by
    clear hmol hmolerr hAA hdiag
    intro u hu H η hη
    obtain ⟨r, v, hr0, hr1, hv, ha, hb, hc⟩ := H (η / 20) (by positivity)
    have hVfin : volume (ball (0 : Rn n) 1) ≠ ∞ := measure_ball_lt_top.ne
    set V : ℝ≥0∞ := volume (ball (0 : Rn n) 1) with hV
    have hVnn : 0 ≤ V.toReal := ENNReal.toReal_nonneg
    set θ : ℝ := Real.sqrt (η / (6 * (V.toReal + 1))) with hθdef
    have hθpos : 0 < θ := Real.sqrt_pos.mpr (by positivity)
    have hθsq : θ ^ 2 = η / (6 * (V.toReal + 1)) := Real.sq_sqrt (by positivity)
    set e : ℝ≥0∞ := ENNReal.ofReal (η / 20) with he
    obtain ⟨N, hN⟩ := hc θ hθpos
    refine ⟨N, fun k l hk hl => ?_⟩
    have hsq : ∀ s : ℝ, ‖s‖ₑ ^ 2 = ENNReal.ofReal (s ^ 2) := by
      intro s
      rw [Real.enorm_eq_ofReal_abs, ← ENNReal.ofReal_pow (abs_nonneg s), sq_abs]
    have hpt2 : ∀ s t : ℝ, ‖s - t‖ₑ ^ 2 ≤ 2 * ‖s‖ₑ ^ 2 + 2 * ‖t‖ₑ ^ 2 := by
      intro s t
      rw [hsq, hsq, hsq]
      have key : (s - t) ^ 2 ≤ 2 * s ^ 2 + 2 * t ^ 2 := by linarith [sq_nonneg (s + t)]
      calc ENNReal.ofReal ((s - t) ^ 2) ≤ ENNReal.ofReal (2 * s ^ 2 + 2 * t ^ 2) :=
            ENNReal.ofReal_le_ofReal key
        _ = 2 * ENNReal.ofReal (s ^ 2) + 2 * ENNReal.ofReal (t ^ 2) := by
            rw [ENNReal.ofReal_add (by positivity) (by positivity),
              ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2),
              ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2)]
            simp
    have hpt3 : ∀ a b c d : ℝ, |c - d| ≤ θ →
        ‖a - b‖ₑ ^ 2 ≤ 3 * ‖a - c‖ₑ ^ 2 + 3 * ‖b - d‖ₑ ^ 2 + ENNReal.ofReal (3 * θ ^ 2) := by
      intro a b c d hcd
      rw [hsq, hsq, hsq]
      have hY : (c - d) ^ 2 ≤ θ ^ 2 := sq_le_sq' (abs_le.mp hcd).1 (abs_le.mp hcd).2
      have key : (a - b) ^ 2 ≤ 3 * (a - c) ^ 2 + 3 * (b - d) ^ 2 + 3 * θ ^ 2 := by
        linarith [sq_nonneg ((a - c) - (c - d)), sq_nonneg ((c - d) - (d - b)),
          sq_nonneg ((a - c) - (d - b))]
      calc ENNReal.ofReal ((a - b) ^ 2)
          ≤ ENNReal.ofReal (3 * (a - c) ^ 2 + 3 * (b - d) ^ 2 + 3 * θ ^ 2) :=
            ENNReal.ofReal_le_ofReal key
        _ = 3 * ENNReal.ofReal ((a - c) ^ 2) + 3 * ENNReal.ofReal ((b - d) ^ 2)
              + ENNReal.ofReal (3 * θ ^ 2) := by
            rw [ENNReal.ofReal_add (by positivity) (by positivity),
              ENNReal.ofReal_add (by positivity) (by positivity),
              ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 3) (q := (a - c) ^ 2),
              ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 3) (q := (b - d) ^ 2)]
            simp
    have hBr : ball (0 : Rn n) r ⊆ ball (0 : Rn n) 1 := ball_subset_ball hr1.le
    -- splitting `B = B_r ∪ (B \ B_r)`
    have hsplit : ∫⁻ x in ball (0 : Rn n) 1, ‖u k x - u l x‖ₑ ^ 2 ≤
        (∫⁻ x in ball (0 : Rn n) r, ‖u k x - u l x‖ₑ ^ 2) +
          ∫⁻ x in ball (0 : Rn n) 1 \ ball 0 r, ‖u k x - u l x‖ₑ ^ 2 := by
      calc ∫⁻ x in ball (0 : Rn n) 1, ‖u k x - u l x‖ₑ ^ 2
          = ∫⁻ x in ball (0 : Rn n) r ∪ (ball (0 : Rn n) 1 \ ball 0 r),
              ‖u k x - u l x‖ₑ ^ 2 := by
            rw [Set.union_sdiff_cancel hBr]
        _ ≤ _ := lintegral_union_le _ _ _
    -- the annulus
    have hbd : ∫⁻ x in ball (0 : Rn n) 1 \ ball 0 r, ‖u k x - u l x‖ₑ ^ 2 ≤ 2 * e + 2 * e := by
      have hmk : AEMeasurable (fun x => 2 * ‖u k x‖ₑ ^ 2)
          (volume.restrict (ball (0 : Rn n) 1 \ ball 0 r)) :=
        ((((hu k).mono_set sdiff_subset).enorm).pow_const 2).const_mul 2
      calc ∫⁻ x in ball (0 : Rn n) 1 \ ball 0 r, ‖u k x - u l x‖ₑ ^ 2
          ≤ ∫⁻ x in ball (0 : Rn n) 1 \ ball 0 r, (2 * ‖u k x‖ₑ ^ 2 + 2 * ‖u l x‖ₑ ^ 2) :=
            lintegral_mono fun x => hpt2 _ _
        _ = 2 * (∫⁻ x in ball (0 : Rn n) 1 \ ball 0 r, ‖u k x‖ₑ ^ 2) +
              2 * ∫⁻ x in ball (0 : Rn n) 1 \ ball 0 r, ‖u l x‖ₑ ^ 2 := by
            rw [lintegral_add_left' hmk, lintegral_const_mul' _ _ (by norm_num),
              lintegral_const_mul' _ _ (by norm_num)]
        _ ≤ 2 * e + 2 * e := by
            gcongr
            · exact ha k
            · exact ha l
    -- the interior
    have hint : ∫⁻ x in ball (0 : Rn n) r, ‖u k x - u l x‖ₑ ^ 2 ≤
        3 * e + 3 * e + ENNReal.ofReal (3 * θ ^ 2) * V := by
      have hmk : AEMeasurable (fun x => 3 * ‖u k x - v k x‖ₑ ^ 2)
          (volume.restrict (ball (0 : Rn n) r)) :=
        (((((hu k).mono_set hBr).sub (hv k)).enorm).pow_const 2).const_mul 3
      calc ∫⁻ x in ball (0 : Rn n) r, ‖u k x - u l x‖ₑ ^ 2
          ≤ ∫⁻ x in ball (0 : Rn n) r,
              (3 * ‖u k x - v k x‖ₑ ^ 2 + 3 * ‖u l x - v l x‖ₑ ^ 2
                + ENNReal.ofReal (3 * θ ^ 2)) :=
            setLIntegral_mono' measurableSet_ball fun x hx => hpt3 _ _ _ _ (hN k l hk hl x hx)
        _ = 3 * (∫⁻ x in ball (0 : Rn n) r, ‖u k x - v k x‖ₑ ^ 2) +
              3 * (∫⁻ x in ball (0 : Rn n) r, ‖u l x - v l x‖ₑ ^ 2) +
              ENNReal.ofReal (3 * θ ^ 2) * volume (ball (0 : Rn n) r) := by
            rw [lintegral_add_right' _ aemeasurable_const, lintegral_add_left' hmk,
              lintegral_const_mul' _ _ (by norm_num), lintegral_const_mul' _ _ (by norm_num),
              setLIntegral_const]
        _ ≤ 3 * e + 3 * e + ENNReal.ofReal (3 * θ ^ 2) * V := by
            gcongr
            · exact hb k
            · exact hb l
            · exact measure_mono hBr
    have hθV : ENNReal.ofReal (3 * θ ^ 2) * V ≤ 10 * e := by
      rw [← ENNReal.ofReal_toReal hVfin, ← ENNReal.ofReal_mul (by positivity), he,
        show (10 : ℝ≥0∞) = ENNReal.ofReal 10 by simp, ← ENNReal.ofReal_mul (by norm_num)]
      apply ENNReal.ofReal_le_ofReal
      rw [hθsq]
      have hq : 0 ≤ η / (6 * (V.toReal + 1)) := by positivity
      have hq1 : η / (6 * (V.toReal + 1)) * (V.toReal + 1) = η / 6 := by
        rw [← div_div, div_mul_cancel₀ _ (by positivity)]
      linarith
    have he20 : ENNReal.ofReal η = 20 * e := by
      rw [he, show (20 : ℝ≥0∞) = ENNReal.ofReal 20 by simp, ← ENNReal.ofReal_mul (by norm_num)]
      congr 1
      ring
    calc ∫⁻ x in ball (0 : Rn n) 1, ‖u k x - u l x‖ₑ ^ 2
        ≤ _ := hsplit
      _ ≤ (3 * e + 3 * e + ENNReal.ofReal (3 * θ ^ 2) * V) + (2 * e + 2 * e) :=
          add_le_add hint hbd
      _ ≤ (3 * e + 3 * e + 10 * e) + (2 * e + 2 * e) := by gcongr
      _ = 20 * e := by ring
      _ = ENNReal.ofReal η := he20.symm
  -- Step 6 (completeness): a sequence that is Cauchy in `L²(μ)` has a limit in `L²(μ)`.
  have hcomplete : ∀ (μ : Measure (Rn n)) (u : ℕ → Rn n → ℝ), (∀ k, MemLp (u k) 2 μ) →
      (∀ η : ℝ, 0 < η → ∃ N : ℕ, ∀ k l, N ≤ k → N ≤ l →
        ∫⁻ x, ‖u k x - u l x‖ₑ ^ 2 ∂μ ≤ ENNReal.ofReal η) →
      ∃ w : Rn n → ℝ, MemLp w 2 μ ∧ Tendsto (fun k => ∫⁻ x, ‖u k x - w x‖ₑ ^ 2 ∂μ) atTop (𝓝 0) := by
    clear hmol hmolerr hAA hdiag hcrit
    intro μ u hu hC
    -- the norm identity `‖v‖₂ ^ 2 = ∫⁻ ‖v‖ₑ ^ 2` (for a.e.-strongly measurable `v`)
    have key : ∀ v : Rn n → ℝ, AEStronglyMeasurable v μ →
        ∫⁻ x, ‖v x‖ₑ ^ 2 ∂μ = eLpNorm v 2 μ ^ 2 := by
      intro v hv
      have h := eLpNorm_nnreal_pow_eq_lintegral (p := (2 : ℝ≥0)) (μ := μ) two_ne_zero hv
      simpa using h.symm
    have : Fact ((1 : ℝ≥0∞) ≤ 2) := ⟨by norm_num⟩
    -- the classes `G k` of `u k` in `L²(μ)` form a Cauchy sequence
    let G : ℕ → Lp ℝ 2 μ := fun k => (hu k).toLp (u k)
    have hG : CauchySeq G := by
      rw [EMetric.cauchySeq_iff]
      intro ε hε
      obtain ⟨r, hr0, hr1, hr2⟩ := ENNReal.lt_iff_exists_real_btwn.1 hε
      have hr : 0 < r := ENNReal.ofReal_pos.1 hr1
      obtain ⟨N, hN⟩ := hC (r ^ 2) (by positivity)
      refine ⟨N, fun k hk l hl => ?_⟩
      calc edist (G k) (G l) = eLpNorm (u k - u l) 2 μ := Lp.edist_toLp_toLp _ _ _ _
        _ ≤ ENNReal.ofReal r := by
          rw [← ENNReal.pow_le_pow_left_iff two_ne_zero,
            ← key _ ((hu k).aestronglyMeasurable.sub (hu l).aestronglyMeasurable),
            ← ENNReal.ofReal_pow hr0]
          exact hN k l hk hl
        _ < ε := hr2
    -- completeness of `L²(μ)` (Riesz–Fischer)
    obtain ⟨W, hW⟩ := cauchySeq_tendsto_of_complete hG
    refine ⟨W, Lp.memLp W, ?_⟩
    rw [Lp.tendsto_Lp_iff_tendsto_eLpNorm'] at hW
    have h2 : ∀ k, eLpNorm (⇑(G k) - ⇑W) 2 μ = eLpNorm (u k - ⇑W) 2 μ := fun k =>
      eLpNorm_congr_ae ((hu k).coeFn_toLp.sub EventuallyEq.rfl)
    have h3 : ∀ k, ∫⁻ x, ‖u k x - W x‖ₑ ^ 2 ∂μ = eLpNorm (u k - ⇑W) 2 μ ^ 2 := fun k =>
      key _ ((hu k).aestronglyMeasurable.sub (Lp.memLp W).aestronglyMeasurable)
    have h4 := ENNReal.Tendsto.pow (n := 2) hW
    simp only [h2, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow] at h4
    simpa only [h3] using h4
  -- Assembly.
  intro A f g hW hf hg
  -- Step 0: measurable representatives `F k` of `f k` on the unit ball.
  let F : ℕ → Rn n → ℝ := fun k => (hW k).1.aestronglyMeasurable.mk (f k)
  have hFmeas : ∀ k, Measurable (F k) := fun k =>
    (hW k).1.aestronglyMeasurable.stronglyMeasurable_mk.measurable
  have hFae : ∀ k, f k =ᵐ[volume.restrict (ball (0 : Rn n) 1)] F k := fun k =>
    (hW k).1.aestronglyMeasurable.ae_eq_mk
  have hWF : ∀ k, IsW12WithGradient (F k) (g k) (ball 0 1) := by
    intro k
    obtain ⟨h1, h2, h3⟩ := hW k
    refine ⟨h1.ae_eq (hFae k), h2, ?_⟩
    intro ζ hζ hζc hζB
    rw [← h3 ζ hζ hζc hζB]
    refine integral_congr_ae ?_
    filter_upwards [hFae k] with x hx
    rw [hx]
  have hFbd : ∀ k, ∫⁻ x in ball (0 : Rn n) 1, ‖F k x‖ₑ ^ 2 ≤ ENNReal.ofReal A := by
    intro k
    calc ∫⁻ x in ball (0 : Rn n) 1, ‖F k x‖ₑ ^ 2 = ∫⁻ x in ball (0 : Rn n) 1, ‖f k x‖ₑ ^ 2 := by
          refine lintegral_congr_ae ?_
          filter_upwards [hFae k] with x hx
          rw [hx]
      _ ≤ _ := hf k
  -- The sibling estimates R1 (boundary layer) and R2 (translation).
  obtain ⟨C1, hC1, hR1⟩ := Submission.w12_ball_boundary_layer_estimate n hn
  have hR2 := Submission.w12_ball_translation_estimate n hn
  -- Mollifiers at the scales `ε_m = 1/(m+2)` and the mollified functions `H m k`.
  choose ρ C hρc hρnn hρsupp hρint hρbd using fun m : ℕ => hmol (1 / ((m : ℝ) + 2)) (by positivity)
  let H : ℕ → ℕ → Rn n → ℝ := fun m k x => ∫ y in ball (0 : Rn n) 1, ρ m (x - y) * F k y
  have hHbd : ∀ m k x x', |H m k x| ≤ C m * Real.sqrt A ∧
      |H m k x - H m k x'| ≤ C m * Real.sqrt A * ‖x - x'‖ := fun m k x x' =>
    hρbd m A (F k) (hWF k).1 (hFbd k) x x'
  have hHcont : ∀ m k, Continuous (H m k) := by
    intro m k
    refine (LipschitzWith.of_dist_le' (K := C m * Real.sqrt A) fun x x' => ?_).continuous
    rw [Real.dist_eq, dist_eq_norm]
    exact (hHbd m k x x').2
  -- Step 4: one subsequence `φ` along which every `H m` is uniformly Cauchy on `B₁(0)`
  -- (diagonal argument over the pairs `(m, i) = Nat.unpair j`, tolerance `1/(i+1)`).
  obtain ⟨φ, hφmono, hφ⟩ := hdiag
    (fun j p q => ∀ x ∈ closedBall (0 : Rn n) 1,
      |H (Nat.unpair j).1 p x - H (Nat.unpair j).1 q x| ≤ 1 / (((Nat.unpair j).2 : ℝ) + 1))
    (fun j ψ _ => hAA (closedBall 0 1) (H (Nat.unpair j).1) (C (Nat.unpair j).1 * Real.sqrt A)
      (C (Nat.unpair j).1 * Real.sqrt A) (isCompact_closedBall 0 1)
      (fun k x _ => (hHbd _ k x x).1)
      (fun k x _ y _ => by rw [dist_eq_norm]; exact (hHbd _ k x y).2)
      _ (by positivity) ψ)
  have hφ' : ∀ (m : ℕ) (θ : ℝ), 0 < θ → ∃ N : ℕ, ∀ k l, N ≤ k → N ≤ l →
      ∀ x ∈ closedBall (0 : Rn n) 1, |H m (φ k) x - H m (φ l) x| ≤ θ := by
    intro m θ hθ
    obtain ⟨i, hi⟩ := exists_nat_one_div_lt hθ
    obtain ⟨N, hN⟩ := hφ (Nat.pair m i)
    refine ⟨N, fun k l hk hl x hx => ?_⟩
    have h := hN k l hk hl x hx
    simp only [Nat.unpair_pair] at h
    exact h.trans hi.le
  -- Step 5: the Cauchy criterion, applied to `u k = F (φ k)`.
  have hcauchy := hcrit (fun k => F (φ k)) (fun k => (hFmeas (φ k)).aestronglyMeasurable) (by
    intro η hη
    obtain ⟨A', hA'⟩ : ∃ A' : ℝ, A' = max A 0 := ⟨_, rfl⟩
    have hA'0 : 0 ≤ A' := by rw [hA']; exact le_max_right A 0
    have hAA' : ENNReal.ofReal A ≤ ENNReal.ofReal A' := by
      rw [hA']; exact ENNReal.ofReal_le_ofReal (le_max_left A 0)
    -- the radius `r = 1 - t`
    have hden : 0 < 2 * C1 * A' + 1 := by positivity
    obtain ⟨t, ht⟩ : ∃ t : ℝ, t = min (1 / 2) ((η / (2 * C1 * A' + 1)) ^ 2) := ⟨_, rfl⟩
    have ht0 : 0 < t := by rw [ht]; exact lt_min (by norm_num) (by positivity)
    have ht1 : t ≤ 1 / 2 := by rw [ht]; exact min_le_left _ _
    have htsq : Real.sqrt t ≤ η / (2 * C1 * A' + 1) := by
      rw [Real.sqrt_le_left (by positivity), ht]
      exact min_le_right _ _
    -- the scale `ε_m`
    obtain ⟨m, hm⟩ := exists_nat_one_div_lt (lt_min ht0 (by positivity : 0 < η / (A' + 1)))
    have hεm : 1 / ((m : ℝ) + 2) ≤ 1 / ((m : ℝ) + 1) :=
      one_div_le_one_div_of_le (by positivity) (by linarith)
    have hεt : 1 / ((m : ℝ) + 2) < t := lt_of_le_of_lt hεm (lt_of_lt_of_le hm (min_le_left _ _))
    have hεη : 1 / ((m : ℝ) + 2) < η / (A' + 1) :=
      lt_of_le_of_lt hεm (lt_of_lt_of_le hm (min_le_right _ _))
    have hε0 : 0 < 1 / ((m : ℝ) + 2) := by positivity
    have hε1 : 1 / ((m : ℝ) + 2) ≤ 1 := by
      rw [div_le_one (by positivity)]; linarith [(Nat.cast_nonneg m : (0 : ℝ) ≤ m)]
    have hεA : (1 / ((m : ℝ) + 2)) ^ 2 * A' ≤ η := by
      have h1 : (1 / ((m : ℝ) + 2)) ^ 2 ≤ 1 / ((m : ℝ) + 2) := by
        rw [sq]; exact mul_le_of_le_one_left hε0.le hε1
      have h2 : 1 / ((m : ℝ) + 2) * A' ≤ η / (A' + 1) * A' :=
        mul_le_mul_of_nonneg_right hεη.le hA'0
      have h3 : η / (A' + 1) * A' ≤ η := by
        rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
        exact mul_le_mul_of_nonneg_left (by linarith) hη.le
      calc (1 / ((m : ℝ) + 2)) ^ 2 * A' ≤ 1 / ((m : ℝ) + 2) * A' :=
            mul_le_mul_of_nonneg_right h1 hA'0
        _ ≤ η := h2.trans h3
    refine ⟨1 - t, fun k => H m (φ k), by linarith, by linarith,
      fun k => (hHcont m (φ k)).aestronglyMeasurable, ?_, ?_, ?_⟩
    · -- (a) the annulus, from R1
      intro k
      have h := hR1 (F (φ k)) (g (φ k)) (hWF (φ k)) (1 - t) (by linarith) (by linarith)
      rw [sub_sub_cancel] at h
      refine h.trans ?_
      calc ENNReal.ofReal (C1 * Real.sqrt t) * ((∫⁻ x in ball (0 : Rn n) 1, ‖F (φ k) x‖ₑ ^ 2) +
            ∫⁻ x in ball (0 : Rn n) 1, ‖g (φ k) x‖ₑ ^ 2)
          ≤ ENNReal.ofReal (C1 * Real.sqrt t) * (ENNReal.ofReal A' + ENNReal.ofReal A') := by
            gcongr
            · exact (hFbd (φ k)).trans hAA'
            · exact (hg (φ k)).trans hAA'
        _ = ENNReal.ofReal (C1 * Real.sqrt t * (A' + A')) := by
            rw [← ENNReal.ofReal_add hA'0 hA'0, ← ENNReal.ofReal_mul (by positivity)]
        _ ≤ ENNReal.ofReal η := by
            refine ENNReal.ofReal_le_ofReal ?_
            have h1 : C1 * Real.sqrt t * (A' + A') ≤
                C1 * (η / (2 * C1 * A' + 1)) * (A' + A') := by
              gcongr
            have h2 : C1 * (η / (2 * C1 * A' + 1)) * (A' + A') ≤ η := by
              rw [mul_comm C1, mul_assoc, div_mul_eq_mul_div, div_le_iff₀ hden]
              exact mul_le_mul_of_nonneg_left (by linarith) hη.le
            exact h1.trans h2
    · -- (b) the interior mollification error, from Step 2 and R2
      intro k
      have h := hmolerr (ρ m) (F (φ k)) (1 / ((m : ℝ) + 2)) (1 - t)
        (∫⁻ x in ball (0 : Rn n) 1, ‖g (φ k) x‖ₑ ^ 2) (hρc m) (hρnn m) (hρsupp m) (hρint m)
        (hFmeas (φ k)) (by linarith) (by linarith)
        (fun z hz => hR2 (F (φ k)) (g (φ k)) (hWF (φ k)) (1 - t) z (by linarith) hz)
      calc ∫⁻ x in ball (0 : Rn n) (1 - t), ‖F (φ k) x - H m (φ k) x‖ₑ ^ 2
          = ∫⁻ x in ball (0 : Rn n) (1 - t), ‖H m (φ k) x - F (φ k) x‖ₑ ^ 2 :=
            lintegral_congr fun x => by rw [enorm_sub_rev]
        _ ≤ ENNReal.ofReal ((1 / ((m : ℝ) + 2)) ^ 2) *
              ∫⁻ x in ball (0 : Rn n) 1, ‖g (φ k) x‖ₑ ^ 2 := h
        _ ≤ ENNReal.ofReal ((1 / ((m : ℝ) + 2)) ^ 2) * ENNReal.ofReal A' := by
            gcongr; exact (hg (φ k)).trans hAA'
        _ = ENNReal.ofReal ((1 / ((m : ℝ) + 2)) ^ 2 * A') := by
            rw [← ENNReal.ofReal_mul (by positivity)]
        _ ≤ ENNReal.ofReal η := ENNReal.ofReal_le_ofReal hεA
    · -- (c) the uniform Cauchy property of the mollified subsequence, from Step 4
      intro θ hθ
      obtain ⟨N, hN⟩ := hφ' m θ hθ
      exact ⟨N, fun k l hk hl x hx => hN k l hk hl x
        (ball_subset_closedBall (ball_subset_ball (by linarith) hx))⟩)
  -- Step 6: completeness of `L²(B̆₁(0))`, and back from `F` to `f`.
  obtain ⟨w, hw, hlim⟩ := hcomplete (volume.restrict (ball (0 : Rn n) 1)) (fun k => F (φ k))
    (fun k => (hWF (φ k)).1) hcauchy
  refine ⟨φ, w, hφmono, hw, Tendsto.congr (fun k => ?_) hlim⟩
  refine lintegral_congr_ae ?_
  filter_upwards [hFae (φ k)] with x hx
  rw [hx]

/-- **Weak compactness in `L²(B; ℝⁿ)`** (Simon Ch. 5, proof of Lemma 3.1, p. 114: `∇f_{k'} → ∇w`
weakly in `L²` with `∫_B |∇w|² ≤ 1`).  If `∫_B |G_k|² ≤ 1` for every `k`, then a subsequence
`G_{φ(k)}` converges weakly in `L²(B; ℝⁿ)` to some `g` with `∫_B |g|² ≤ 1`.

`L²(B; ℝⁿ)` is made a real Hilbert space with `⟪u, v⟫ = ∫_B ⟨u, v⟩`, as in Mathlib's `L2Space`
(not among the frozen imports).  A diagonal subsequence makes `⟪G_{φ(k)}, G_j⟫` converge for every
`j`; the uniform bound extends this to the closed span `K` of the `G_j`, and the orthogonal
projection onto `K` to all of `L²`.  The limit functional has norm `≤ 1`; `g` is its Riesz
representative. -/
theorem l2_ball_weak_subsequence : ∀ (n : ℕ) (G : ℕ → Rn n → Rn n), (∀ k, MemLp (G k) 2 (volume.restrict (ball (0 : Rn n) 1))) → (∀ k, ∫⁻ x in ball (0 : Rn n) 1, ‖G k x‖ₑ ^ 2 ≤ 1) → ∃ (φ : ℕ → ℕ) (g : Rn n → Rn n), StrictMono φ ∧ MemLp g 2 (volume.restrict (ball (0 : Rn n) 1)) ∧ ∫⁻ x in ball (0 : Rn n) 1, ‖g x‖ₑ ^ 2 ≤ 1 ∧ ∀ h : Rn n → Rn n, MemLp h 2 (volume.restrict (ball (0 : Rn n) 1)) → Tendsto (fun k => ∫ x in ball (0 : Rn n) 1, inner ℝ (G (φ k) x) (h x)) atTop (𝓝 (∫ x in ball (0 : Rn n) 1, inner ℝ (g x) (h x))) := by
  -- Step 1: a bounded sequence in a real Hilbert space has a weakly convergent subsequence
  -- whose limit lies in the same closed ball.
  have weak : ∀ (H : Type) [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
      (u : ℕ → H), (∀ k, ‖u k‖ ≤ 1) → ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∃ γ : H, ‖γ‖ ≤ 1 ∧
        ∀ v, Tendsto (fun k => inner ℝ (u (φ k)) v) atTop (𝓝 (inner ℝ γ v)) := by
    intro H _ _ _ u hu
    have hbd : ∀ k v, |inner ℝ (u k) v| ≤ ‖v‖ := fun k v =>
      (abs_real_inner_le_norm _ _).trans (mul_le_of_le_one_left (norm_nonneg _) (hu k))
    -- Diagonal extraction: `⟪u (φ k), u j⟫` converges for every `j` (Tychonoff).
    have hmem : ∀ k, (fun j => inner ℝ (u k) (u j)) ∈ Set.pi univ fun _ : ℕ => Icc (-1 : ℝ) 1 :=
      fun k j _ => abs_le.mp ((hbd k (u j)).trans (hu j))
    obtain ⟨a, -, φ, hφ, hlim⟩ := (isCompact_univ_pi fun _ => isCompact_Icc).tendsto_subseq hmem
    have hconv₀ : ∀ j, Tendsto (fun k => inner ℝ (u (φ k)) (u j)) atTop (𝓝 (a j)) :=
      fun j => tendsto_pi_nhds.mp hlim j
    -- Convergence against the span of the sequence.
    have hspan : ∀ v ∈ Submodule.span ℝ (Set.range u),
        ∃ l, Tendsto (fun k => inner ℝ (u (φ k)) v) atTop (𝓝 l) := by
      intro v hv
      induction hv using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨j, rfl⟩ := hx
        exact ⟨a j, hconv₀ j⟩
      | zero => exact ⟨0, by simp⟩
      | add x y _ _ hx hy =>
        obtain ⟨l₁, h₁⟩ := hx
        obtain ⟨l₂, h₂⟩ := hy
        exact ⟨l₁ + l₂, by simpa only [inner_add_right] using h₁.add h₂⟩
      | smul c x _ hx =>
        obtain ⟨l, h⟩ := hx
        exact ⟨c * l, by simpa only [real_inner_smul_right] using h.const_mul c⟩
    -- Convergence against its closure, by the uniform bound `‖u k‖ ≤ 1`.
    set K := (Submodule.span ℝ (Set.range u)).topologicalClosure with hK
    have hclos : ∀ v ∈ K, ∃ l, Tendsto (fun k => inner ℝ (u (φ k)) v) atTop (𝓝 l) := by
      intro v hv
      rw [← SetLike.mem_coe, hK, Submodule.topologicalClosure_coe, Metric.mem_closure_iff] at hv
      apply cauchySeq_tendsto_of_complete
      rw [Metric.cauchySeq_iff']
      intro ε hε
      obtain ⟨w, hw, hvw⟩ := hv (ε / 3) (by positivity)
      obtain ⟨l, hl⟩ := hspan w hw
      obtain ⟨N, hN⟩ := Metric.cauchySeq_iff'.mp hl.cauchySeq (ε / 3) (by positivity)
      refine ⟨N, fun k hk => ?_⟩
      have e₁ := hbd (φ k) (v - w)
      have e₂ := hbd (φ N) (v - w)
      have e₃ := hN k hk
      rw [Real.dist_eq] at e₃ ⊢
      rw [dist_eq_norm] at hvw
      rw [inner_sub_right] at e₁ e₂
      have := abs_le.mp e₁
      have := abs_le.mp e₂
      have := abs_lt.mp e₃
      rw [abs_lt]
      constructor <;> linarith
    -- Convergence against every vector, via the orthogonal projection onto `K`.
    have hall : ∀ v : H, ∃ l, Tendsto (fun k => inner ℝ (u (φ k)) v) atTop (𝓝 l) := by
      intro v
      obtain ⟨l, hl⟩ := hclos (K.starProjection v) (K.starProjection_apply_mem v)
      refine ⟨l, hl.congr fun k => ?_⟩
      have hmemK : u (φ k) ∈ K :=
        Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨φ k, rfl⟩)
      have h0 :=
        Submodule.inner_right_of_mem_orthogonal hmemK (K.sub_starProjection_mem_orthogonal v)
      rw [inner_sub_right] at h0
      linarith
    -- The limit functional and its Riesz representative.
    choose L hL using hall
    have Ladd : ∀ v w, L (v + w) = L v + L w := fun v w =>
      tendsto_nhds_unique (hL (v + w)) (by simpa only [inner_add_right] using (hL v).add (hL w))
    have Lsmul : ∀ (c : ℝ) v, L (c • v) = c * L v := fun c v => tendsto_nhds_unique (hL (c • v))
      (by simpa only [real_inner_smul_right] using (hL v).const_mul c)
    have Lbound : ∀ v, ‖L v‖ ≤ 1 * ‖v‖ := fun v => by
      rw [one_mul, Real.norm_eq_abs]
      exact le_of_tendsto (hL v).abs (Eventually.of_forall fun k => hbd (φ k) v)
    let Lc : StrongDual ℝ H := LinearMap.mkContinuous
      { toFun := L, map_add' := Ladd, map_smul' := fun c v => by simpa using Lsmul c v } 1 Lbound
    refine ⟨φ, hφ, (InnerProductSpace.toDual ℝ H).symm Lc, ?_, fun v => ?_⟩
    · rw [LinearIsometryEquiv.norm_map]
      exact LinearMap.mkContinuous_norm_le _ zero_le_one _
    · rw [InnerProductSpace.toDual_symm_apply]
      exact hL v
  -- Step 2: the Hilbert space `L²(B; ℝⁿ)`.
  intro n G hG hGb
  set μ : Measure (Rn n) := volume.restrict (ball (0 : Rn n) 1)
  have hsq : ∀ f : Rn n → Rn n, AEStronglyMeasurable f μ →
      eLpNorm f 2 μ ^ 2 = ∫⁻ x, ‖f x‖ₑ ^ 2 ∂μ := fun f hf => by
    simpa [ENNReal.rpow_two] using eLpNorm_nnreal_pow_eq_lintegral (p := 2) two_ne_zero hf
  have hint : ∀ f g : Lp (Rn n) 2 μ, Integrable (fun x => inner ℝ (f x) (g x)) μ := by
    intro f g
    refine (((Lp.memLp f).integrable_norm_pow two_ne_zero).add
      ((Lp.memLp g).integrable_norm_pow two_ne_zero)).mono'
      (continuous_inner.comp_aestronglyMeasurable₂ (Lp.aestronglyMeasurable f)
        (Lp.aestronglyMeasurable g)) (Eventually.of_forall fun x => ?_)
    rw [Real.norm_eq_abs, Pi.add_apply]
    refine (abs_real_inner_le_norm _ _).trans ?_
    nlinarith [norm_nonneg (f x), norm_nonneg (g x), sq_nonneg (‖f x‖ - ‖g x‖)]
  have hnorm : ∀ f : Lp (Rn n) 2 μ, ‖f‖ ^ 2 = (∫⁻ x, ‖f x‖ₑ ^ 2 ∂μ).toReal := fun f => by
    rw [Lp.norm_def, ← ENNReal.toReal_pow, hsq _ (Lp.aestronglyMeasurable f)]
  have hnorm' : ∀ f : Lp (Rn n) 2 μ, ‖f‖ ^ 2 = ∫ x, inner ℝ (f x) (f x) ∂μ := fun f => by
    simp_rw [real_inner_self_eq_norm_sq]
    rw [hnorm, integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall fun x => sq_nonneg _)
      ((Lp.aestronglyMeasurable f).norm.pow 2)]
    congr 1
    refine lintegral_congr fun x => ?_
    rw [ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm]
  let _ : Inner ℝ (Lp (Rn n) 2 μ) := ⟨fun f g => ∫ x, inner ℝ (f x) (g x) ∂μ⟩
  let _ : InnerProductSpace ℝ (Lp (Rn n) 2 μ) :=
    { norm_sq_eq_re_inner := fun f => by rw [RCLike.re_to_real]; exact hnorm' f
      conj_inner_symm := fun f g => by
        rw [conj_trivial]
        exact integral_congr_ae (Eventually.of_forall fun x => real_inner_comm _ _)
      add_left := fun f f' g => by
        change ∫ x, inner ℝ ((f + f') x) (g x) ∂μ =
          ∫ x, inner ℝ (f x) (g x) ∂μ + ∫ x, inner ℝ (f' x) (g x) ∂μ
        rw [← integral_add (hint f g) (hint f' g)]
        refine integral_congr_ae ((Lp.coeFn_add f f').mono fun x hx => ?_)
        simp only [hx, Pi.add_apply, inner_add_left]
      smul_left := fun f g r => by
        change ∫ x, inner ℝ ((r • f) x) (g x) ∂μ =
          (starRingEnd ℝ) r * ∫ x, inner ℝ (f x) (g x) ∂μ
        rw [conj_trivial, ← integral_const_mul]
        refine integral_congr_ae ((Lp.coeFn_smul r f).mono fun x hx => ?_)
        simp only [hx, Pi.smul_apply, real_inner_smul_left] }
  -- Step 3: apply Step 1 to the classes of the `G k` and return to functions.
  have hGn : ∀ k, ‖(hG k).toLp (G k)‖ ≤ 1 := fun k => by
    have h1 : ‖(hG k).toLp (G k)‖ ^ 2 ≤ 1 := by
      rw [hnorm, lintegral_congr_ae ((hG k).coeFn_toLp.mono fun x hx => by rw [hx])]
      exact ENNReal.toReal_le_of_le_ofReal zero_le_one (by simpa using hGb k)
    nlinarith [norm_nonneg ((hG k).toLp (G k))]
  obtain ⟨φ, hφ, γ, hγ, hconv⟩ := weak (Lp (Rn n) 2 μ) (fun k => (hG k).toLp (G k)) hGn
  refine ⟨φ, γ, hφ, Lp.memLp γ, ?_, fun h hh => ?_⟩
  · have h1 : eLpNorm γ 2 μ ≤ 1 := by
      rw [← ENNReal.ofReal_toReal (Lp.eLpNorm_ne_top γ), ← Lp.norm_def]
      exact ENNReal.ofReal_le_one.mpr hγ
    rw [← hsq _ (Lp.aestronglyMeasurable γ)]
    exact pow_le_one₀ (by positivity) h1
  · have key : ∀ f : Lp (Rn n) 2 μ, inner ℝ f (hh.toLp h) = ∫ x, inner ℝ (f x) (h x) ∂μ :=
      fun f => integral_congr_ae (hh.coeFn_toLp.mono fun x hx => by simp only [hx])
    have h2 := hconv (hh.toLp h)
    rw [key] at h2
    refine h2.congr fun k => ?_
    rw [key]
    exact integral_congr_ae ((hG (φ k)).coeFn_toLp.mono fun x hx => by simp only [hx])

/-- **Weak harmonicity in Laplacian form** (step 1 of the proof of Weyl's lemma).  If
`w ∈ W^{1,2}(B)`, `B = B̆₁(0)`, has weak gradient `g` with `∫_B ⟨g, ∇ζ⟩ = 0` for every
`ζ ∈ C^∞_c(B)`, then `∫_B w Δζ = 0` for every such `ζ`.
Proof: each partial derivative `ζᵢ = Dζ(·)[eᵢ]` is again a test function, and pairing the
weak-gradient identity for `ζᵢ` with `eᵢ` gives `∫_B w D²ζ[eᵢ, eᵢ] = -∫_B ζᵢ ⟨g, eᵢ⟩`.  Summing
over `i`, with `Δζ = Σᵢ D²ζ[eᵢ, eᵢ]` and `⟨g, ∇ζ⟩ = Σᵢ ζᵢ ⟨g, eᵢ⟩`, gives
`∫_B w Δζ = -∫_B ⟨g, ∇ζ⟩ = 0`. -/
theorem w12_ball_weak_laplacian_eq_zero : ∀ n : ℕ, 1 ≤ n → ∀ (w : Rn n → ℝ) (g : Rn n → Rn n), IsW12WithGradient w g (ball 0 1) → (∀ ζ : Rn n → ℝ, ContDiff ℝ (⊤ : ℕ∞) ζ → HasCompactSupport ζ → tsupport ζ ⊆ ball 0 1 → ∫ x in ball (0 : Rn n) 1, inner ℝ (g x) (gradient ζ x) = 0) → ∀ ζ : Rn n → ℝ, ContDiff ℝ (⊤ : ℕ∞) ζ → HasCompactSupport ζ → tsupport ζ ⊆ ball 0 1 → ∫ x in ball (0 : Rn n) 1, w x * Laplacian.laplacian ζ x = 0 := by
  intro n _ w g hw hharm ζ hζ hζc hζB
  obtain ⟨hwL, hgL, hweak⟩ := hw
  -- `w` and `g` are integrable on the ball, which has finite measure.
  have : IsFiniteMeasure (volume.restrict (ball (0 : Rn n) 1)) :=
    isFiniteMeasure_restrict.2 measure_ball_lt_top.ne
  have hwi : Integrable w (volume.restrict (ball (0 : Rn n) 1)) := hwL.integrable one_le_two
  have hgi : Integrable g (volume.restrict (ball (0 : Rn n) 1)) := hgL.integrable one_le_two
  -- Their products with continuous compactly supported (hence bounded) functions are integrable.
  have hint_w : ∀ φ : Rn n → ℝ, Continuous φ → HasCompactSupport φ →
      Integrable (fun x => w x * φ x) (volume.restrict (ball (0 : Rn n) 1)) := by
    intro φ hφ hφc
    obtain ⟨C, hC⟩ := hφ.bounded_above_of_compact_support hφc
    exact hwi.mul_bdd hφ.aestronglyMeasurable (Eventually.of_forall hC)
  have hint_g : ∀ (φ : Rn n → ℝ) (c : Rn n), Continuous φ → HasCompactSupport φ →
      Integrable (fun x => φ x * inner ℝ (g x) c) (volume.restrict (ball (0 : Rn n) 1)) := by
    intro φ c hφ hφc
    obtain ⟨C, hC⟩ := hφ.bounded_above_of_compact_support hφc
    have hgc : Integrable (fun x => inner ℝ (g x) c) (volume.restrict (ball (0 : Rn n) 1)) := by
      have := (innerSL ℝ c).integrable_comp hgi
      refine this.congr (Eventually.of_forall fun x => ?_)
      simp [real_inner_comm]
    exact hgc.bdd_mul hφ.aestronglyMeasurable (Eventually.of_forall hC)
  -- The partial derivatives `ζᵢ = Dζ(·)[eᵢ]` are test functions.
  set b := EuclideanSpace.basisFun (Fin n) ℝ
  have hDζ : ContDiff ℝ (⊤ : ℕ∞) (fderiv ℝ ζ) := (contDiff_infty_iff_fderiv.1 hζ).2
  set ζ' : Fin n → Rn n → ℝ := fun i x => fderiv ℝ ζ x (b i) with hζ'
  have hζ's : ∀ i, ContDiff ℝ (⊤ : ℕ∞) (ζ' i) := fun i => hDζ.clm_apply contDiff_const
  have hζ'c : ∀ i, HasCompactSupport (ζ' i) := fun i => hζc.fderiv_apply ℝ (b i)
  have hζ'B : ∀ i, tsupport (ζ' i) ⊆ ball 0 1 := fun i =>
    (tsupport_fderiv_apply_subset ℝ (b i)).trans hζB
  -- The `i`-th coordinate of the weak-gradient identity for `ζᵢ`:
  -- `∫_B w Dζᵢ[eᵢ] = -∫_B ζᵢ ⟨g, eᵢ⟩`.
  have hcoord : ∀ i, ∫ x in ball (0 : Rn n) 1, w x * fderiv ℝ (ζ' i) x (b i) =
      -∫ x in ball (0 : Rn n) 1, ζ' i x * inner ℝ (g x) (b i) := by
    intro i
    have h := hweak (ζ' i) (hζ's i) (hζ'c i) (hζ'B i)
    have hgrad : Continuous (gradient (ζ' i)) :=
      (InnerProductSpace.toDual ℝ (Rn n)).symm.continuous.comp
        ((hζ's i).continuous_fderiv (by simp))
    have hgradc : HasCompactSupport (gradient (ζ' i)) := by
      refine (hζ'c i).mono' fun x hx => ?_
      by_contra h'
      exact hx (by rw [gradient, fderiv_of_notMem_tsupport ℝ h', map_zero])
    have hA : Integrable (fun x => w x • gradient (ζ' i) x)
        (volume.restrict (ball (0 : Rn n) 1)) := by
      obtain ⟨C, hC⟩ := hgrad.bounded_above_of_compact_support hgradc
      exact hwi.smul_bdd C hgrad.aestronglyMeasurable (Eventually.of_forall hC)
    have hB : Integrable (fun x => ζ' i x • g x) (volume.restrict (ball (0 : Rn n) 1)) := by
      obtain ⟨C, hC⟩ := (hζ's i).continuous.bounded_above_of_compact_support (hζ'c i)
      exact hgi.bdd_smul C (hζ's i).continuous.aestronglyMeasurable (Eventually.of_forall hC)
    have h1 := (innerSL ℝ (b i)).integral_comp_comm hA
    have h2 := (innerSL ℝ (b i)).integral_comp_comm hB
    calc ∫ x in ball (0 : Rn n) 1, w x * fderiv ℝ (ζ' i) x (b i)
        = ∫ x in ball (0 : Rn n) 1, innerSL ℝ (b i) (w x • gradient (ζ' i) x) := by
          refine integral_congr_ae (Eventually.of_forall fun x => ?_)
          simp
      _ = innerSL ℝ (b i) (∫ x in ball (0 : Rn n) 1, w x • gradient (ζ' i) x) := h1
      _ = innerSL ℝ (b i) (-∫ x in ball (0 : Rn n) 1, ζ' i x • g x) := by rw [h]
      _ = -innerSL ℝ (b i) (∫ x in ball (0 : Rn n) 1, ζ' i x • g x) := map_neg _ _
      _ = -∫ x in ball (0 : Rn n) 1, innerSL ℝ (b i) (ζ' i x • g x) := by rw [h2]
      _ = -∫ x in ball (0 : Rn n) 1, ζ' i x * inner ℝ (g x) (b i) := by
          congr 1
          refine integral_congr_ae (Eventually.of_forall fun x => ?_)
          simp [real_inner_comm]
  -- `Dζᵢ(x)[eᵢ] = D²ζ(x)[eᵢ, eᵢ]`.
  have hD2 : ∀ i x, fderiv ℝ (ζ' i) x (b i) = fderiv ℝ (fderiv ℝ ζ) x (b i) (b i) := by
    intro i x
    have hd : DifferentiableAt ℝ (fderiv ℝ ζ) x := (hDζ.differentiable (by simp)) x
    rw [hζ', fderiv_clm_apply hd (differentiableAt_const _)]
    simp
  -- `Δζ = Σᵢ D²ζ[eᵢ, eᵢ]` and `⟨g, ∇ζ⟩ = Σᵢ ζᵢ ⟨g, eᵢ⟩`.
  have hlap : ∀ x, Laplacian.laplacian ζ x = ∑ i, fderiv ℝ (fderiv ℝ ζ) x (b i) (b i) := by
    intro x
    rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis ζ b]
    simp [iteratedFDeriv_two_apply]
  have hpars : ∀ x, inner ℝ (g x) (gradient ζ x) = ∑ i, ζ' i x * inner ℝ (g x) (b i) := by
    intro x
    rw [← b.sum_inner_mul_inner (g x) (gradient ζ x)]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [inner_gradient_right]
    simp [hζ', mul_comm]
  -- Summing over `i`: `∫_B w Δζ = -∫_B ⟨g, ∇ζ⟩ = 0`.
  have hcont2 : ∀ i, Continuous (fun x => fderiv ℝ (ζ' i) x (b i)) := fun i =>
    ((hζ's i).continuous_fderiv (by simp)).clm_apply continuous_const
  have hcomp2 : ∀ i, HasCompactSupport (fun x => fderiv ℝ (ζ' i) x (b i)) := fun i =>
    (hζ'c i).fderiv_apply ℝ (b i)
  calc ∫ x in ball (0 : Rn n) 1, w x * Laplacian.laplacian ζ x
      = ∫ x in ball (0 : Rn n) 1, ∑ i, w x * fderiv ℝ (ζ' i) x (b i) := by
        refine integral_congr_ae (Eventually.of_forall fun x => ?_)
        simp only [hlap, Finset.mul_sum, hD2]
    _ = ∑ i, ∫ x in ball (0 : Rn n) 1, w x * fderiv ℝ (ζ' i) x (b i) :=
        integral_finsetSum _ (fun i _ => hint_w _ (hcont2 i) (hcomp2 i))
    _ = ∑ i, -∫ x in ball (0 : Rn n) 1, ζ' i x * inner ℝ (g x) (b i) :=
        Finset.sum_congr rfl fun i _ => hcoord i
    _ = -∫ x in ball (0 : Rn n) 1, ∑ i, ζ' i x * inner ℝ (g x) (b i) := by
        rw [integral_finsetSum _ (fun i _ => hint_g _ _ (hζ's i).continuous (hζ'c i)),
          Finset.sum_neg_distrib]
    _ = -∫ x in ball (0 : Rn n) 1, inner ℝ (g x) (gradient ζ x) := by
        congr 1
        refine integral_congr_ae (Eventually.of_forall fun x => ?_)
        exact (hpars x).symm
    _ = 0 := by rw [hharm ζ hζ hζc hζB, neg_zero]

/-- **Mollifications of a weakly harmonic function are harmonic** (step 2 of the proof of
Weyl's lemma, used for Simon Ch. 5, Lemma 3.1).  Let `w` be integrable on `B = B̆₁(0)` with
`∫_B w Δζ = 0` for every `ζ ∈ C^∞_c(B)`, and let `κ` be `C^∞` with `κ(z) = 0` whenever `|z| ≥ ε`.
Then `v(x) = ∫_B κ(x - y) w(y) dy` is `C^∞` on `ℝⁿ` and `Δv = 0` on `B̆_{1-ε}(0)`.

With `W = 1_B w`, `v = W ⋆ κ` is the convolution of an integrable function with a smooth
compactly supported kernel, so `v` is smooth and its derivatives fall on the kernel; summing over
an orthonormal basis gives `Δv(x) = ∫_B Δκ(x - t) w(t) dt`.  For `|x| < 1 - ε`,
`ζ(y) = κ(x - y)` is a test function with `tsupport ζ ⊆ B̄_ε(x) ⊆ B` and `Δζ(y) = Δκ(x - y)`, so
`Δv(x) = ∫_B w Δζ = 0`. -/
theorem ball_convolution_contDiff_laplacian_eq_zero : ∀ n : ℕ, 1 ≤ n → ∀ w : Rn n → ℝ, IntegrableOn w (ball (0 : Rn n) 1) → (∀ ζ : Rn n → ℝ, ContDiff ℝ (⊤ : ℕ∞) ζ → HasCompactSupport ζ → tsupport ζ ⊆ ball 0 1 → ∫ x in ball (0 : Rn n) 1, w x * Laplacian.laplacian ζ x = 0) → ∀ (κ : Rn n → ℝ) (ε : ℝ), ContDiff ℝ (⊤ : ℕ∞) κ → (∀ z : Rn n, ε ≤ ‖z‖ → κ z = 0) → ContDiff ℝ (⊤ : ℕ∞) (fun x => ∫ y in ball (0 : Rn n) 1, κ (x - y) * w y) ∧ ∀ x ∈ ball (0 : Rn n) (1 - ε), Laplacian.laplacian (fun x => ∫ y in ball (0 : Rn n) 1, κ (x - y) * w y) x = 0 := by
  intro n _hn w hw hharm κ ε hκ hκε
  -- Step 1: `W = 1_B w` is integrable and `v = W ⋆ κ` (convolution with `L = lsmul`).
  set W : Rn n → ℝ := (ball (0 : Rn n) 1).indicator w with hWdef
  have hWloc : LocallyIntegrable W :=
    ((integrable_indicator_iff measurableSet_ball).2 hw).locallyIntegrable
  set L : ℝ →L[ℝ] ℝ →L[ℝ] ℝ := ContinuousLinearMap.lsmul ℝ ℝ with hLdef
  have hv : (fun x => ∫ y in ball (0 : Rn n) 1, κ (x - y) * w y) =
      convolution (𝕜 := ℝ) W κ L volume := by
    funext x
    rw [convolution_def, ← integral_indicator measurableSet_ball]
    congr 1
    funext t
    by_cases ht : t ∈ ball (0 : Rn n) 1
    · simp [hWdef, hLdef, Set.indicator_of_mem ht, mul_comm]
    · simp [hWdef, hLdef, Set.indicator_of_notMem ht]
  -- Step 2: `κ = 0` off `B̄_ε(0)`, so `κ`, `Dκ` and `D²κ` are smooth with compact support.
  have hκc : HasCompactSupport κ := by
    refine HasCompactSupport.intro (isCompact_closedBall (0 : Rn n) ε) (fun z hz => hκε z ?_)
    rw [mem_closedBall, dist_zero_right, not_le] at hz
    exact hz.le
  have hκ1 : ContDiff ℝ (⊤ : ℕ∞) (fderiv ℝ κ) := (contDiff_infty_iff_fderiv.1 hκ).2
  have hκ2 : ContDiff ℝ (⊤ : ℕ∞) (fderiv ℝ (fderiv ℝ κ)) := (contDiff_infty_iff_fderiv.1 hκ1).2
  have hκ1c : HasCompactSupport (fderiv ℝ κ) := hκc.fderiv ℝ
  have hκ2c : HasCompactSupport (fderiv ℝ (fderiv ℝ κ)) := hκ1c.fderiv ℝ
  have hκ2cont : Continuous (fderiv ℝ (fderiv ℝ κ)) := hκ2.continuous
  -- Step 3: `v = W ⋆ κ` is smooth.
  refine ⟨?_, ?_⟩
  · rw [hv]
    exact hκc.contDiff_convolution_right L hWloc hκ
  -- Steps 4–5: derivatives fall on the kernel, `D²v(x)[e, e] = ∫ W(t) D²κ(x - t)[e, e] dt`.
  have hD2 : fderiv ℝ (fderiv ℝ (convolution (𝕜 := ℝ) W κ L volume)) =
      convolution (𝕜 := ℝ) W (fderiv ℝ (fderiv ℝ κ)) ((L.precompR (Rn n)).precompR (Rn n))
        volume := by
    have hD1 : fderiv ℝ (convolution (𝕜 := ℝ) W κ L volume) =
        convolution (𝕜 := ℝ) W (fderiv ℝ κ) (L.precompR (Rn n)) volume := by
      funext x
      exact (hκc.hasFDerivAt_convolution_right L hWloc (hκ.of_le (mod_cast le_top)) x).fderiv
    rw [hD1]
    funext x
    exact (hκ1c.hasFDerivAt_convolution_right (L.precompR (Rn n)) hWloc
      (hκ1.of_le (mod_cast le_top)) x).fderiv
  have hD2v : ∀ x e : Rn n, fderiv ℝ (fderiv ℝ (convolution (𝕜 := ℝ) W κ L volume)) x e e =
      ∫ t, W t * fderiv ℝ (fderiv ℝ κ) (x - t) e e := by
    intro x e
    rw [hD2, convolution_precompR_apply (L.precompR (Rn n)) hWloc hκ2c hκ2cont x e,
      convolution_precompR_apply L hWloc (hκ1c.fderiv_apply ℝ e)
        (hκ2cont.clm_apply continuous_const) x e, convolution_def]
    simp [hLdef]
  -- Each `t ↦ W(t) D²κ(x - t)[e, e]` is integrable: `D²κ(·)[e, e]` is continuous with compact
  -- support.
  have hint : ∀ x e : Rn n, Integrable (fun t => W t * fderiv ℝ (fderiv ℝ κ) (x - t) e e) := by
    intro x e
    have hc : HasCompactSupport (fun a => fderiv ℝ (fderiv ℝ κ) a e e) :=
      (hκ1c.fderiv_apply ℝ e).comp_left (g := fun T : Rn n →L[ℝ] ℝ => T e) (by simp)
    exact hc.convolutionExists_right L hWloc
      ((hκ2cont.clm_apply continuous_const).clm_apply continuous_const) x
  -- Step 6: `Δf(x) = ∑ᵢ D²f(x)[bᵢ, bᵢ]` for the standard orthonormal basis `b`.
  set b := EuclideanSpace.basisFun (Fin n) ℝ
  have hlap : ∀ (f : Rn n → ℝ) (x : Rn n),
      Laplacian.laplacian f x = ∑ i, fderiv ℝ (fderiv ℝ f) x (b i) (b i) := by
    intro f x
    rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis f b]
    simp [iteratedFDeriv_two_apply]
  -- Step 7: for `|x| < 1 - ε`, `ζ(y) = κ(x - y)` is a test function with `tsupport ζ ⊆ B`.
  intro x hx
  set ζ : Rn n → ℝ := fun y => κ (x - y) with hζdef
  have hζ : ContDiff ℝ (⊤ : ℕ∞) ζ := hκ.comp (contDiff_const.sub contDiff_id)
  have hζsupp : Function.support ζ ⊆ closedBall x ε := by
    intro y hy
    rw [mem_closedBall, dist_comm, dist_eq_norm]
    by_contra h
    exact hy (hκε _ (not_le.1 h).le)
  have hζc : HasCompactSupport ζ :=
    HasCompactSupport.intro (isCompact_closedBall x ε)
      (fun y hy => by_contra (fun h => hy (hζsupp h)))
  have hζB : tsupport ζ ⊆ ball 0 1 := by
    refine (closure_minimal hζsupp isClosed_closedBall).trans (closedBall_subset_ball' ?_)
    rw [mem_ball] at hx
    linarith
  -- Step 8: `Δζ(t) = Δκ(x - t)`, writing `ζ = κ(x + ·) ∘ (-id)`.
  have hκx : ContDiff ℝ (⊤ : ℕ∞) (fun z => κ (x + z)) := hκ.comp (contDiff_const.add contDiff_id)
  have hcomp : ζ = (fun z => κ (x + z)) ∘ (-(ContinuousLinearMap.id ℝ (Rn n))) := by
    funext y
    simp [hζdef, sub_eq_add_neg]
  have hlapζ : ∀ t,
      Laplacian.laplacian ζ t = ∑ i, fderiv ℝ (fderiv ℝ κ) (x - t) (b i) (b i) := by
    intro t
    rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis ζ b]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hcomp, ContinuousLinearMap.iteratedFDeriv_comp_right (i := 2) _ hκx t
        (WithTop.coe_le_coe.2 le_top),
      ContinuousMultilinearMap.compContinuousLinearMap_apply, iteratedFDeriv_comp_add_left,
      iteratedFDeriv_two_apply]
    simp [sub_eq_add_neg]
  -- Steps 6 and 9: `Δv(x) = ∑ᵢ ∫ W(t) D²κ(x - t)[bᵢ, bᵢ] dt = ∫_B w(t) Δζ(t) dt = 0`.
  rw [hv, hlap]
  simp_rw [hD2v]
  rw [← integral_finsetSum _ (fun i _ => hint x (b i)), ← hharm ζ hζ hζc hζB,
    ← integral_indicator measurableSet_ball]
  congr 1
  funext t
  by_cases ht : t ∈ ball (0 : Rn n) 1
  · rw [Set.indicator_of_mem ht, hlapζ t, Finset.mul_sum]
    simp [hWdef, Set.indicator_of_mem ht]
  · rw [Set.indicator_of_notMem ht]
    simp [hWdef, Set.indicator_of_notMem ht]

/-- Simon Ch. 5, proof of Lemma 3.1 (p. 114), Weyl's lemma for the weak limit `w`: the mean-value
kernel.  With `E(σ) = expNegInvGlue (1 − σ)` (`C^∞`, `≥ 0`, `0` for `σ ≥ 1`, `> 0` for `σ < 1`),
`ρ(z) = c E(|z|²)` with `c = (∫ E(|z|²) dz)⁻¹` is `C^∞`, even, zero for `|z| ≥ 1` and of mass `1`;
`Ψ(z) = (c/2) P(|z|²)` with `P(σ) = ∫_1^σ E` is `C^∞` (`P' = E` by FTC), zero for `|z| ≥ 1`, and
`DΨ(z)[v] = (c/2) E(|z|²) 2⟨z, v⟩ = ρ(z)⟨z, v⟩` by the chain rule. -/
theorem mvk_exists_kernel_potential : ∀ n : ℕ, ∃ ρ Ψ : Rn n → ℝ, ContDiff ℝ (⊤ : ℕ∞) ρ ∧ ContDiff ℝ (⊤ : ℕ∞) Ψ ∧ (∀ z : Rn n, 1 ≤ ‖z‖ → ρ z = 0) ∧ (∀ z : Rn n, 1 ≤ ‖z‖ → Ψ z = 0) ∧ (∀ z : Rn n, ρ (-z) = ρ z) ∧ ∫ z, ρ z = 1 ∧ ∀ z v : Rn n, fderiv ℝ Ψ z v = ρ z * inner ℝ z v := by
  intro n
  -- The profile `E(σ) = expNegInvGlue (1 - σ)`: `C^∞`, `≥ 0`, `0` for `σ ≥ 1`, `> 0` for `σ < 1`.
  set E : ℝ → ℝ := fun σ => expNegInvGlue (1 - σ)
  have hE_smooth : ContDiff ℝ (⊤ : ℕ∞) E :=
    expNegInvGlue.contDiff.comp (contDiff_const.sub contDiff_id)
  have hE_cont : Continuous E := hE_smooth.continuous
  have hE_nonneg : ∀ σ, 0 ≤ E σ := fun σ => expNegInvGlue.nonneg _
  have hE_zero : ∀ σ, 1 ≤ σ → E σ = 0 := fun σ hσ =>
    expNegInvGlue.zero_of_nonpos (by linarith)
  have hE_pos : ∀ σ, σ < 1 → 0 < E σ := fun σ hσ =>
    expNegInvGlue.pos_of_pos (by linarith)
  -- The unnormalized kernel `ρ₀(z) = E(‖z‖²)`: `C^∞`, zero for `‖z‖ ≥ 1`, of positive mass.
  set ρ₀ : Rn n → ℝ := fun z => E (‖z‖ ^ 2) with hρ₀_def
  have hρ₀_smooth : ContDiff ℝ (⊤ : ℕ∞) ρ₀ := hE_smooth.comp (contDiff_norm_sq ℝ)
  have hρ₀_zero : ∀ z : Rn n, 1 ≤ ‖z‖ → ρ₀ z = 0 := fun z hz =>
    hE_zero _ (one_le_pow₀ hz)
  have hρ₀_supp : HasCompactSupport ρ₀ :=
    HasCompactSupport.intro (isCompact_closedBall (0 : Rn n) 1) fun z hz =>
      hρ₀_zero z (by rw [mem_closedBall_zero_iff, not_le] at hz; exact hz.le)
  have hρ₀_int : Integrable ρ₀ := hρ₀_smooth.continuous.integrable_of_hasCompactSupport hρ₀_supp
  have hI₀_pos : 0 < ∫ z, ρ₀ z := by
    rw [integral_pos_iff_support_of_nonneg (fun z => hE_nonneg _) hρ₀_int]
    refine (measure_ball_pos volume (0 : Rn n) one_pos).trans_le (measure_mono fun z hz => ?_)
    rw [mem_ball_zero_iff] at hz
    exact (hE_pos _ (pow_lt_one₀ (norm_nonneg z) hz two_ne_zero)).ne'
  set c : ℝ := (∫ z, ρ₀ z)⁻¹ with hc_def
  -- The primitive `P(σ) = ∫_1^σ E`: `P' = E` (FTC), so `P` is `C^∞`; `P = 0` on `[1, ∞)`.
  set P : ℝ → ℝ := fun σ => ∫ s in (1 : ℝ)..σ, E s with hP_def
  have hP_deriv : ∀ σ, HasDerivAt P (E σ) σ := fun σ =>
    (hE_cont.integral_hasStrictDerivAt 1 σ).hasDerivAt
  have hP_smooth : ContDiff ℝ (⊤ : ℕ∞) P :=
    contDiff_infty_iff_deriv.2 ⟨fun σ => (hP_deriv σ).differentiableAt,
      (funext fun σ => (hP_deriv σ).deriv : deriv P = E) ▸ hE_smooth⟩
  have hP_zero : ∀ σ, 1 ≤ σ → P σ = 0 := fun σ hσ => by
    simp only [hP_def]
    rw [intervalIntegral.integral_congr (g := fun _ => (0 : ℝ)) ?_]
    · simp
    · intro s hs
      rw [uIcc_of_le hσ] at hs
      exact hE_zero s hs.1
  -- `ρ = c ρ₀` and `Ψ(z) = (c/2) P(‖z‖²)`.
  refine ⟨fun z => c * ρ₀ z, fun z => c / 2 * P (‖z‖ ^ 2), contDiff_const.mul hρ₀_smooth,
    contDiff_const.mul (hP_smooth.comp (contDiff_norm_sq ℝ)), fun z hz => ?_, fun z hz => ?_,
    fun z => ?_, ?_, fun z v => ?_⟩
  · show c * ρ₀ z = 0
    rw [hρ₀_zero z hz, mul_zero]
  · show c / 2 * P (‖z‖ ^ 2) = 0
    rw [hP_zero _ (one_le_pow₀ hz), mul_zero]
  · simp only [hρ₀_def, norm_neg]
  · rw [integral_const_mul, hc_def, inv_mul_cancel₀ hI₀_pos.ne']
  · -- Chain rule: `DΨ(z)[v] = (c/2) E(‖z‖²) 2⟨z, v⟩ = ρ(z) ⟨z, v⟩`.
    have h : HasFDerivAt (fun z : Rn n => c / 2 * P (‖z‖ ^ 2))
        ((c / 2) • (E (‖z‖ ^ 2) • (2 • innerSL ℝ z))) z :=
      ((hP_deriv _).comp_hasFDerivAt z (hasStrictFDerivAt_norm_sq z).hasFDerivAt).const_mul _
    rw [h.fderiv]
    simp only [smul_apply, innerSL_apply_apply, smul_eq_mul, nsmul_eq_mul, hρ₀_def]
    push_cast
    ring

/-- Fundamental theorem of calculus along rays, averaged against a kernel (used for the mean value
kernel in Weyl's lemma, Simon Ch. 5, proof of Lemma 3.1): for continuous `ρ` vanishing where
`‖z‖ ≥ 1`, `h ∈ C¹` and `t ≥ 0`,
`∫ ρ(z) h(x₀ + t z) dz = (∫ ρ) h(x₀) + ∫₀ᵗ ∫ ρ(z) Dh(x₀ + σ z)[z] dz dσ`.  Raywise FTC, then
Fubini for the continuous integrand, which vanishes off `[0, t] × B₁(0)`. -/
theorem mvk_integral_ray_fubini : ∀ (n : ℕ) (ρ h : Rn n → ℝ) (x₀ : Rn n) (t : ℝ), 0 ≤ t → Continuous ρ → (∀ z : Rn n, 1 ≤ ‖z‖ → ρ z = 0) → ContDiff ℝ 1 h → ∫ z, ρ z * h (x₀ + t • z) = (∫ z, ρ z) * h x₀ + ∫ σ in (0 : ℝ)..t, ∫ z, ρ z * fderiv ℝ h (x₀ + σ • z) z := by
  intro n ρ h x₀ t ht hρ hρ0 hh
  -- `ρ` vanishes off the compact closed unit ball, so it has compact support.
  have hρs : HasCompactSupport ρ := by
    refine HasCompactSupport.intro (isCompact_closedBall (0 : Rn n) 1) fun z hz => hρ0 z ?_
    rw [mem_closedBall, dist_zero_right, not_le] at hz
    exact hz.le
  have hhd : Differentiable ℝ h := hh.differentiable one_ne_zero
  have hDh : Continuous (fderiv ℝ h) := hh.continuous_fderiv one_ne_zero
  -- Products of `ρ` with continuous functions are integrable.
  have hint : ∀ g : Rn n → ℝ, Continuous g → Integrable fun z => ρ z * g z := fun g hg =>
    (hρ.mul hg).integrable_of_hasCompactSupport hρs.mul_right
  -- FTC along the ray `σ ↦ x₀ + σ • z`, multiplied by the constant `ρ z`.
  have hftc : ∀ z : Rn n, ∫ σ in (0 : ℝ)..t, ρ z * fderiv ℝ h (x₀ + σ • z) z =
      ρ z * h (x₀ + t • z) - ρ z * h x₀ := by
    intro z
    have hderiv : ∀ σ : ℝ,
        HasDerivAt (fun σ : ℝ => h (x₀ + σ • z)) (fderiv ℝ h (x₀ + σ • z) z) σ := by
      intro σ
      have hray : HasDerivAt (fun σ : ℝ => x₀ + σ • z) z σ := by
        simpa using ((hasDerivAt_id σ).smul_const z).const_add x₀
      exact (hhd (x₀ + σ • z)).hasFDerivAt.comp_hasDerivAt σ hray
    have hcont : Continuous fun σ : ℝ => fderiv ℝ h (x₀ + σ • z) z := by fun_prop
    rw [intervalIntegral.integral_const_mul,
      intervalIntegral.integral_eq_sub_of_hasDerivAt (fun σ _ => hderiv σ)
        (hcont.intervalIntegrable _ _), zero_smul, add_zero, mul_sub]
  -- The integrand is integrable on `(0, t] × ℝⁿ`: it is continuous and vanishes off the compact
  -- set `[0, t] × B₁(0)`.
  have hF : Integrable
      (Function.uncurry fun (σ : ℝ) (z : Rn n) => ρ z * fderiv ℝ h (x₀ + σ • z) z)
      ((volume.restrict (uIoc (0 : ℝ) t)).prod volume) := by
    rw [Measure.restrict_prod_eq_prod_univ]
    have hK : IntegrableOn
        (Function.uncurry fun (σ : ℝ) (z : Rn n) => ρ z * fderiv ℝ h (x₀ + σ • z) z)
        (Icc (0 : ℝ) t ×ˢ closedBall (0 : Rn n) 1) (volume.prod volume) :=
      (Continuous.continuousOn (by fun_prop)).integrableOn_compact
        (isCompact_Icc.prod (isCompact_closedBall _ _))
    refine hK.of_forall_sdiff_eq_zero (measurableSet_uIoc.prod MeasurableSet.univ) ?_
    rintro ⟨σ, z⟩ ⟨⟨hσ, -⟩, hnot⟩
    rw [uIoc_of_le ht] at hσ
    have hz : z ∉ closedBall (0 : Rn n) 1 := fun hz => hnot ⟨Ioc_subset_Icc_self hσ, hz⟩
    rw [mem_closedBall, dist_zero_right, not_le] at hz
    simp [hρ0 z hz.le]
  -- Fubini, then integrate the raywise identity over `z`.
  rw [MeasureTheory.intervalIntegral_integral_swap hF]
  simp_rw [hftc]
  rw [integral_sub (hint (fun z => h (x₀ + t • z)) (by fun_prop))
    (hint (fun _ => h x₀) continuous_const), integral_mul_const]
  ring

/-- Green's first identity on `ℝⁿ` against a compactly supported `C¹` function (used for the mean
value kernel in Weyl's lemma, Simon Ch. 5, proof of Lemma 3.1): if `H` is `C²`, `Ψ` is `C¹` with
compact support and `w = ∇Ψ`, then `∫ DH(z)[w(z)] dz = -∫ ΔH(z) Ψ(z) dz`.  Each coordinate
integration by parts reduces to `∫ DG(z)[v] dz = 0` for a compactly supported `C¹` function `G`,
which holds because `t ↦ ∫ G(z + t v) dz` is constant by translation invariance. -/
theorem mvk_integral_fderiv_grad_eq_neg_laplacian : ∀ (n : ℕ) (H Ψ : Rn n → ℝ) (w : Rn n → Rn n), ContDiff ℝ 2 H → ContDiff ℝ 1 Ψ → HasCompactSupport Ψ → (∀ z v : Rn n, fderiv ℝ Ψ z v = inner ℝ (w z) v) → ∫ z, fderiv ℝ H z (w z) = -∫ z, Laplacian.laplacian H z * Ψ z := by
  intro n H Ψ w hH hΨ hΨc hw
  -- For a compactly supported `C¹` function `G` and a direction `v`, `∫ DG(z)[v] dz = 0`:
  -- `t ↦ ∫ G(z + t v) dz` is constant by translation invariance, and its derivative at `0` is
  -- `∫ DG(z)[v] dz` by differentiation under the integral sign.
  have key : ∀ G : Rn n → ℝ, ContDiff ℝ 1 G → HasCompactSupport G → ∀ v : Rn n,
      ∫ z, fderiv ℝ G z v = 0 := by
    intro G hG hGc v
    have hGd : Differentiable ℝ G := hG.differentiable one_ne_zero
    have hG' : Continuous fun y => fderiv ℝ G y v :=
      (hG.continuous_fderiv one_ne_zero).clm_apply continuous_const
    obtain ⟨C, hC⟩ := hG'.bounded_above_of_compact_support (hGc.fderiv_apply ℝ v)
    obtain ⟨R, -, hR⟩ := (hGc.fderiv_apply ℝ v).exists_pos_le_norm
    -- For `|t| < 1`, `|DG(z + t v)[v]|` is bounded by `C` times the indicator of `B_{R + |v|}(0)`.
    have hbound : Integrable ((closedBall (0 : Rn n) (R + ‖v‖)).indicator fun _ => C) :=
      (integrable_indicator_iff measurableSet_closedBall).2
        (integrableOn_const measure_closedBall_lt_top.ne)
    have hb : ∀ z : Rn n, ∀ t ∈ ball (0 : ℝ) 1,
        ‖fderiv ℝ G (z + t • v) v‖ ≤ (closedBall (0 : Rn n) (R + ‖v‖)).indicator (fun _ => C) z := by
      intro z t ht
      by_cases hz : z ∈ closedBall (0 : Rn n) (R + ‖v‖)
      · rw [indicator_of_mem hz]
        exact hC _
      · rw [mem_closedBall, dist_zero_right, not_le] at hz
        rw [mem_ball, dist_zero_right, Real.norm_eq_abs] at ht
        have h1 : ‖t • v‖ ≤ ‖v‖ := by
          rw [norm_smul, Real.norm_eq_abs]
          exact mul_le_of_le_one_left (norm_nonneg _) ht.le
        have h2 : ‖z‖ ≤ ‖z + t • v‖ + ‖t • v‖ := by
          calc ‖z‖ = ‖(z + t • v) - t • v‖ := by rw [add_sub_cancel_right]
            _ ≤ ‖z + t • v‖ + ‖t • v‖ := norm_sub_le _ _
        have hRz : R ≤ ‖z + t • v‖ := by linarith
        rw [hR _ hRz, norm_zero]
        exact indicator_nonneg (fun _ _ => (norm_nonneg _).trans (hC 0)) _
    have hdiff : ∀ z : Rn n, ∀ t ∈ ball (0 : ℝ) 1,
        HasDerivAt (fun t : ℝ => G (z + t • v)) (fderiv ℝ G (z + t • v) v) t := by
      intro z t _
      have h1 : HasDerivAt (fun t : ℝ => z + t • v) v t := by
        simpa using ((hasDerivAt_id t).smul_const v).const_add z
      exact (hGd (z + t • v)).hasFDerivAt.comp_hasDerivAt t h1
    have hd : HasDerivAt (fun t : ℝ => ∫ z, G (z + t • v)) (∫ z, fderiv ℝ G (z + (0 : ℝ) • v) v) 0 :=
      (hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := volume)
        (F := fun (t : ℝ) (z : Rn n) => G (z + t • v))
        (F' := fun (t : ℝ) (z : Rn n) => fderiv ℝ G (z + t • v) v)
        (x₀ := 0) (ball_mem_nhds (0 : ℝ) one_pos)
        (Eventually.of_forall fun t =>
          (hG.continuous.comp (continuous_id.add continuous_const)).aestronglyMeasurable)
        (by simpa using hG.continuous.integrable_of_hasCompactSupport hGc)
        ((hG'.comp (continuous_id.add continuous_const)).aestronglyMeasurable)
        (Eventually.of_forall hb) hbound (Eventually.of_forall hdiff)).2
    have hd0 : HasDerivAt (fun t : ℝ => ∫ z, G (z + t • v)) 0 0 := by
      have hconst : (fun t : ℝ => ∫ z, G (z + t • v)) = fun _ => ∫ z, G z :=
        funext fun t => integral_add_right_eq_self G (t • v)
      rw [hconst]
      exact hasDerivAt_const _ _
    simpa using hd.unique hd0
  -- Integration by parts in the direction `v` against `Ψ`, applying `key` to `f Ψ`.
  have hΨd : Differentiable ℝ Ψ := hΨ.differentiable one_ne_zero
  have ibp : ∀ f : Rn n → ℝ, ContDiff ℝ 1 f → ∀ v : Rn n,
      Integrable (fun z => fderiv ℝ f z v * Ψ z) ∧ Integrable (fun z => f z * fderiv ℝ Ψ z v) ∧
        ∫ z, f z * fderiv ℝ Ψ z v = -∫ z, fderiv ℝ f z v * Ψ z := by
    intro f hf v
    have hfd : Differentiable ℝ f := hf.differentiable one_ne_zero
    have h1 : Integrable (fun z => fderiv ℝ f z v * Ψ z) :=
      (((hf.continuous_fderiv one_ne_zero).clm_apply continuous_const).mul
        hΨ.continuous).integrable_of_hasCompactSupport hΨc.mul_left
    have h2 : Integrable (fun z => f z * fderiv ℝ Ψ z v) :=
      (hf.continuous.mul ((hΨ.continuous_fderiv one_ne_zero).clm_apply
        continuous_const)).integrable_of_hasCompactSupport (hΨc.fderiv_apply ℝ v).mul_left
    refine ⟨h1, h2, ?_⟩
    have h3 := key (fun z => f z * Ψ z) (hf.mul hΨ) hΨc.mul_left v
    have h4 : ∀ z, fderiv ℝ (fun z => f z * Ψ z) z v =
        fderiv ℝ f z v * Ψ z + f z * fderiv ℝ Ψ z v := by
      intro z
      rw [show (fun z => f z * Ψ z) = f * Ψ from rfl, fderiv_mul (hfd z) (hΨd z)]
      simp only [add_apply, smul_apply, smul_eq_mul]
      ring
    simp only [h4] at h3
    rw [integral_add h1 h2] at h3
    linarith
  -- Second derivatives: `D(DH(·)[v])(z)[v] = D²H(z)[v, v]`.
  have hH1 : ContDiff ℝ 1 (fderiv ℝ H) := hH.fderiv_right (by norm_num)
  have hd2 : ∀ v z : Rn n,
      fderiv ℝ (fun y => fderiv ℝ H y v) z v = iteratedFDeriv ℝ 2 H z ![v, v] := by
    intro v z
    rw [iteratedFDeriv_two_apply,
      fderiv_clm_apply ((hH1.differentiable one_ne_zero) z) (differentiableAt_const v)]
    simp
  set e := EuclideanSpace.basisFun (Fin n) ℝ
  -- `DH(z)[w(z)] = Σᵢ ∂ᵢH(z) ∂ᵢΨ(z)`, expanding `w(z)` in the standard orthonormal basis.
  have hexp : ∀ z, fderiv ℝ H z (w z) = ∑ i, fderiv ℝ H z (e i) * fderiv ℝ Ψ z (e i) := by
    intro z
    conv_lhs => rw [← e.sum_repr' (w z)]
    rw [map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_smul, smul_eq_mul, hw, real_inner_comm (w z) (e i)]
    ring
  -- `ΔH(z) = Σᵢ D²H(z)[eᵢ, eᵢ]`.
  have hlap : ∀ z, Laplacian.laplacian H z * Ψ z =
      ∑ i, fderiv ℝ (fun y => fderiv ℝ H y (e i)) z (e i) * Ψ z := by
    intro z
    simp only [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis H e, Finset.sum_mul]
    exact Finset.sum_congr rfl fun i _ => by rw [hd2]
  have hfC : ∀ i, ContDiff ℝ 1 (fun y => fderiv ℝ H y (e i)) := fun i => hH1.clm_apply contDiff_const
  calc ∫ z, fderiv ℝ H z (w z) = ∫ z, ∑ i, fderiv ℝ H z (e i) * fderiv ℝ Ψ z (e i) := by
        simp only [hexp]
    _ = ∑ i, ∫ z, fderiv ℝ H z (e i) * fderiv ℝ Ψ z (e i) :=
        integral_finsetSum _ fun i _ => (ibp _ (hfC i) (e i)).2.1
    _ = ∑ i, -∫ z, fderiv ℝ (fun y => fderiv ℝ H y (e i)) z (e i) * Ψ z :=
        Finset.sum_congr rfl fun i _ => (ibp _ (hfC i) (e i)).2.2
    _ = -∫ z, ∑ i, fderiv ℝ (fun y => fderiv ℝ H y (e i)) z (e i) * Ψ z := by
        rw [integral_finsetSum _ fun i _ => (ibp _ (hfC i) (e i)).1, Finset.sum_neg_distrib]
    _ = -∫ z, Laplacian.laplacian H z * Ψ z := by
        simp only [hlap]

/-- **Laplacian of an affinely rescaled `C²` function** (scaling step in the mean value property
behind Weyl's lemma, used for Simon Ch. 5, Lemma 3.1, p. 114).  If `h : ℝⁿ → ℝ` is `C²`, then
`Δ(y ↦ h(x₀ + σ y))(z) = σ² Δh(x₀ + σ z)` for all `x₀, z ∈ ℝⁿ` and `σ ∈ ℝ`.
Proof: `y ↦ h(x₀ + σ y) = h₀ ∘ L` with `h₀ = h(x₀ + ·)` of class `C²` and `L = σ • id`.  Expanding
both Laplacians in the standard orthonormal basis `(eᵢ)`, it suffices that
`D²(h₀ ∘ L)(z)[eᵢ, eᵢ] = D²h₀(σ z)[σ eᵢ, σ eᵢ] = σ² D²h₀(σ z)[eᵢ, eᵢ]` (composition with a linear
map on the right, then multilinearity) and `D²h₀(σ z) = D²h(x₀ + σ z)` (translation). -/
theorem mvk_laplacian_comp_add_smul : ∀ (n : ℕ) (h : Rn n → ℝ) (x₀ : Rn n) (σ : ℝ), ContDiff ℝ 2 h → ∀ z : Rn n, Laplacian.laplacian (fun y => h (x₀ + σ • y)) z = σ ^ 2 * Laplacian.laplacian h (x₀ + σ • z) := by
  intro n h x₀ σ hh z
  -- Step 1: `y ↦ h (x₀ + σ • y) = h₀ ∘ L`, where `h₀ y = h (x₀ + y)` is `C²` and `L = σ • id`.
  have h₀ : ContDiff ℝ 2 (fun y : Rn n => h (x₀ + y)) := hh.comp (contDiff_const.add contDiff_id)
  set L : Rn n →L[ℝ] Rn n := σ • ContinuousLinearMap.id ℝ (Rn n)
  have hcomp : (fun y => h (x₀ + σ • y)) = (fun y => h (x₀ + y)) ∘ L := by
    ext y
    simp [L]
  -- Step 2: expand both Laplacians in the standard orthonormal basis `eᵢ`.
  set e := EuclideanSpace.basisFun (Fin n) ℝ
  rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis _ e,
    InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis _ e, Finset.mul_sum, hcomp]
  refine Finset.sum_congr rfl fun i _ => ?_
  -- Step 3: `D²(h₀ ∘ L)(z)[eᵢ, eᵢ] = D²h₀(σ z)[σ eᵢ, σ eᵢ] = σ² D²h₀(σ z)[eᵢ, eᵢ]`.
  rw [L.iteratedFDeriv_comp_right h₀ z le_rfl, ContinuousMultilinearMap.compContinuousLinearMap_apply]
  have hsmul : (fun j => L (![e i, e i] j)) = fun j => σ • ![e i, e i] j := by
    ext1 j
    simp [L]
  rw [hsmul, ContinuousMultilinearMap.map_smul_univ, Finset.prod_const, Finset.card_univ,
    Fintype.card_fin, smul_eq_mul]
  -- Step 4: `D²h₀(σ z) = D²h(x₀ + σ z)`.
  rw [iteratedFDeriv_comp_add_left]
  simp [L]

/-- Rescaling and reflection of the convolution integral for an even kernel (used for the mean
value kernel in Weyl's lemma, Simon Ch. 5, proof of Lemma 3.1): for `t > 0` and `ρ` even,
`∫ t⁻ⁿ ρ(t⁻¹ y) h(x₀ − y) dy = ∫ ρ(z) h(x₀ + t z) dz`.  No integrability is needed: the Haar
scaling formula, constant factors and the reflection `z ↦ −z` hold for the Bochner integral of an
arbitrary function. -/
theorem mvk_integral_rescale_reflect : ∀ (n : ℕ) (ρ h : Rn n → ℝ) (x₀ : Rn n) (t : ℝ), 0 < t → (∀ z : Rn n, ρ (-z) = ρ z) → ∫ y, t⁻¹ ^ n * ρ (t⁻¹ • y) * h (x₀ - y) = ∫ z, ρ z * h (x₀ + t • z) := by
  intro n ρ h x₀ t ht hρ
  -- The integrand is `f (t⁻¹ • y)` for `f z = t⁻ⁿ ρ(z) h(x₀ − t z)`, since `t • t⁻¹ • y = y`.
  calc ∫ y, t⁻¹ ^ n * ρ (t⁻¹ • y) * h (x₀ - y)
      = ∫ y, (fun z : Rn n => t⁻¹ ^ n * (ρ z * h (x₀ - t • z))) (t⁻¹ • y) := by
        refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
        simp only [smul_inv_smul₀ ht.ne', mul_assoc]
    -- Scaling of Lebesgue measure: `∫ f (t⁻¹ • y) dy = tⁿ ∫ f`, since `finrank ℝ ℝⁿ = n`.
    _ = t ^ n • ∫ z, t⁻¹ ^ n * (ρ z * h (x₀ - t • z)) := by
        have hs := Measure.integral_comp_inv_smul_of_nonneg (volume : Measure (Rn n))
          (fun z : Rn n => t⁻¹ ^ n * (ρ z * h (x₀ - t • z))) ht.le
        rw [finrank_euclideanSpace_fin] at hs
        exact hs
    -- Pull out the constant `t⁻ⁿ` and cancel `tⁿ t⁻ⁿ = 1`.
    _ = ∫ z, ρ z * h (x₀ - t • z) := by
        rw [integral_const_mul, smul_eq_mul, ← mul_assoc, ← mul_pow, mul_inv_cancel₀ ht.ne',
          one_pow, one_mul]
    -- `ρ` is even and `t • -z = -(t • z)`.
    _ = ∫ z, ρ (-z) * h (x₀ + t • -z) := by
        congr 1
        ext z
        rw [hρ, smul_neg, sub_eq_add_neg]
    -- Lebesgue measure is invariant under `z ↦ -z`.
    _ = ∫ z, ρ z * h (x₀ + t • z) := integral_neg_eq_self (fun z => ρ z * h (x₀ + t • z)) volume

/-- Simon Ch. 5, proof of Lemma 3.1 (p. 114), mean value step of Weyl's lemma: integration by parts
of the radial derivative against the kernel potential.  If `h` is `C²`, `σ ≠ 0`, and the `C¹`
function `Ψ` vanishes for `‖z‖ ≥ 1` and has `DΨ(z)[v] = ρ(z) ⟨z, v⟩`, then
`∫ ρ(z) Dh(x₀ + σ z)[z] dz = -σ ∫ Δh(x₀ + σ z) Ψ(z) dz`.  For `H(y) = h(x₀ + σ y)` the chain rule
gives `ρ(z) Dh(x₀ + σ z)[z] = σ⁻¹ DH(z)[ρ(z) z]`.  Green's first identity
(`mvk_integral_fderiv_grad_eq_neg_laplacian`, applied to the compactly supported `Ψ` with
gradient `ρ(z) z`) gives `∫ DH(z)[ρ(z) z] dz = -∫ ΔH(z) Ψ(z) dz`, and
`ΔH(z) = σ² Δh(x₀ + σ z)` (`mvk_laplacian_comp_add_smul`). -/
theorem mvk_integral_radial_fderiv_eq_neg_laplacian : ∀ (n : ℕ) (ρ Ψ h : Rn n → ℝ) (x₀ : Rn n) (σ : ℝ), σ ≠ 0 → ContDiff ℝ 2 h → ContDiff ℝ 1 Ψ → (∀ z : Rn n, 1 ≤ ‖z‖ → Ψ z = 0) → (∀ z v : Rn n, fderiv ℝ Ψ z v = ρ z * inner ℝ z v) → ∫ z, ρ z * fderiv ℝ h (x₀ + σ • z) z = -σ * ∫ z, Laplacian.laplacian h (x₀ + σ • z) * Ψ z := by
  intro n ρ Ψ h x₀ σ hσ hh hΨ hΨ1 hdΨ
  -- Step 1: `H(y) = h(x₀ + σ y)` is `C²`, with `DH(z)[v] = σ Dh(x₀ + σ z)[v]`.
  have hH : ContDiff ℝ 2 (fun y : Rn n => h (x₀ + σ • y)) :=
    hh.comp (contDiff_const.add (contDiff_id.const_smul σ))
  have hdH : ∀ z v : Rn n,
      fderiv ℝ (fun y => h (x₀ + σ • y)) z v = σ * fderiv ℝ h (x₀ + σ • z) v := by
    intro z v
    have hA : HasFDerivAt (fun y : Rn n => x₀ + σ • y) (σ • ContinuousLinearMap.id ℝ (Rn n)) z :=
      ((hasFDerivAt_id z).const_smul σ).const_add x₀
    have hc : HasFDerivAt (fun y => h (x₀ + σ • y))
        ((fderiv ℝ h (x₀ + σ • z)).comp (σ • ContinuousLinearMap.id ℝ (Rn n))) z :=
      (hh.differentiable (by norm_num) (x₀ + σ • z)).hasFDerivAt.comp z hA
    rw [hc.fderiv]
    simp
  -- Step 2: `Ψ` vanishes off the closed unit ball, so it has compact support.
  have hΨc : HasCompactSupport Ψ :=
    HasCompactSupport.intro (isCompact_closedBall 0 1) fun z hz =>
      hΨ1 z (le_of_lt (by simpa using hz))
  -- Step 3: `w(z) = ρ(z) z` is the gradient of `Ψ`.
  have hw : ∀ z v : Rn n, fderiv ℝ Ψ z v = inner ℝ (ρ z • z) v := fun z v => by
    rw [hdΨ, real_inner_smul_left]
  -- Step 4: `ρ(z) Dh(x₀ + σ z)[z] = σ⁻¹ DH(z)[w(z)]`.
  have hpt : ∀ z, ρ z * fderiv ℝ h (x₀ + σ • z) z =
      σ⁻¹ * fderiv ℝ (fun y => h (x₀ + σ • y)) z (ρ z • z) := fun z => by
    rw [hdH, map_smul, smul_eq_mul, inv_mul_cancel_left₀ hσ]
  -- Steps 5–6: Green's first identity for `H`, `Ψ`, `w`, and `ΔH(z) = σ² Δh(x₀ + σ z)`.
  have hG := Submission.mvk_integral_fderiv_grad_eq_neg_laplacian n
    (fun y => h (x₀ + σ • y)) Ψ (fun z => ρ z • z) hH hΨ hΨc hw
  have hL := Submission.mvk_laplacian_comp_add_smul n h x₀ σ hh
  -- Step 7: pull out the constants.
  calc ∫ z, ρ z * fderiv ℝ h (x₀ + σ • z) z
      = ∫ z, σ⁻¹ * fderiv ℝ (fun y => h (x₀ + σ • y)) z (ρ z • z) :=
        integral_congr_ae (Eventually.of_forall hpt)
    _ = σ⁻¹ * -∫ z, Laplacian.laplacian (fun y => h (x₀ + σ • y)) z * Ψ z := by
        rw [integral_const_mul, hG]
    _ = σ⁻¹ * -∫ z, σ ^ 2 * (Laplacian.laplacian h (x₀ + σ • z) * Ψ z) := by
        simp only [hL, mul_assoc]
    _ = -σ * ∫ z, Laplacian.laplacian h (x₀ + σ • z) * Ψ z := by
        rw [integral_const_mul]
        field_simp

/-- Simon Ch. 5, proof of Lemma 3.1 (p. 114), mean value step of Weyl's lemma: there is a smooth
kernel `ρ` vanishing off the open unit ball with `∫ t⁻ⁿ ρ(t⁻¹ y) h(x₀ - y) dy = h(x₀)` for every
`t > 0` and every `C²` function `h` with `Δh = 0` on `B_t(x₀)`.  Take `ρ` (even, `∫ ρ = 1`) and
its potential `Ψ` (`DΨ(z)[v] = ρ(z) ⟨z, v⟩`, `Ψ = 0` off the unit ball); rescaling and reflecting
turn the left side into `∫ ρ(z) h(x₀ + t z) dz`, the fundamental theorem of calculus along rays
and Fubini give `h(x₀) + ∫₀ᵗ I(σ) dσ` with `I(σ) = ∫ ρ(z) Dh(x₀ + σ z)[z] dz`, and integration by
parts against `Ψ` gives `I(σ) = -σ ∫ Δh(x₀ + σ z) Ψ(z) dz = 0` for `0 < σ ≤ t`. -/
theorem exists_smooth_mean_value_kernel : ∀ n : ℕ, 1 ≤ n → ∃ ρ : Rn n → ℝ, ContDiff ℝ (⊤ : ℕ∞) ρ ∧ (∀ z : Rn n, 1 ≤ ‖z‖ → ρ z = 0) ∧ ∀ (h : Rn n → ℝ) (x₀ : Rn n) (t : ℝ), 0 < t → ContDiff ℝ 2 h → (∀ y ∈ closedBall x₀ t, Laplacian.laplacian h y = 0) → ∫ y, t⁻¹ ^ n * ρ (t⁻¹ • y) * h (x₀ - y) = h x₀ := by
  intro n _
  -- Step 1: the kernel `ρ` and its potential `Ψ`.
  obtain ⟨ρ, Ψ, hρ, hΨ, hρ1, hΨ1, hρneg, hρint, hdΨ⟩ := Submission.mvk_exists_kernel_potential n
  refine ⟨ρ, hρ, hρ1, fun h x₀ t ht hh hΔ => ?_⟩
  -- Step 2: `I(σ) = -σ ∫ Δh(x₀ + σ z) Ψ(z) dz = 0` for `0 < σ ≤ t`, since `Ψ(z) = 0` for
  -- `‖z‖ ≥ 1` and `x₀ + σ z ∈ B_t(x₀)` for `‖z‖ < 1`.
  have hI : ∀ σ ∈ Ioc (0 : ℝ) t, ∫ z, ρ z * fderiv ℝ h (x₀ + σ • z) z = 0 := by
    rintro σ ⟨hσ, hσt⟩
    rw [Submission.mvk_integral_radial_fderiv_eq_neg_laplacian n ρ Ψ h x₀ σ hσ.ne' hh
      (hΨ.of_le (by exact_mod_cast le_top)) hΨ1 hdΨ]
    have hzero : ∀ z, Laplacian.laplacian h (x₀ + σ • z) * Ψ z = 0 := by
      intro z
      rcases le_or_gt 1 ‖z‖ with hz | hz
      · rw [hΨ1 z hz, mul_zero]
      · have hmem : x₀ + σ • z ∈ closedBall x₀ t := by
          rw [mem_closedBall, dist_eq_norm, add_sub_cancel_left, norm_smul,
            Real.norm_of_nonneg hσ.le]
          nlinarith [norm_nonneg z]
        rw [hΔ _ hmem, zero_mul]
    simp only [hzero, integral_zero, mul_zero]
  -- Step 3: so `∫₀ᵗ I(σ) dσ = 0`, the endpoint `σ = 0` being outside `(0, t]`.
  have hint : ∫ σ in (0 : ℝ)..t, ∫ z, ρ z * fderiv ℝ h (x₀ + σ • z) z = 0 :=
    intervalIntegral.integral_zero_ae (Eventually.of_forall fun σ hσ =>
      hI σ (by rwa [uIoc_of_le ht.le] at hσ))
  -- Step 4: rescale and reflect, then integrate along rays:
  -- `∫ ρ(z) h(x₀ + t z) dz = (∫ ρ) h(x₀) + ∫₀ᵗ I(σ) dσ = h(x₀)`.
  rw [Submission.mvk_integral_rescale_reflect n ρ h x₀ t ht hρneg,
    Submission.mvk_integral_ray_fubini n ρ h x₀ t ht.le hρ.continuous hρ1
      (hh.of_le (by norm_num)), hρint, one_mul, hint, add_zero]

/-- **Local harmonic representatives of a weakly harmonic function** (step 5 of the proof of
Weyl's lemma, used for Simon Ch. 5, Lemma 3.1).  Let `w` be integrable on `B = B̆₁(0)` with
`∫_B w Δζ = 0` for every `ζ ∈ C^∞_c(B)`, and let `0 < ε < 1/2`.  Then some `v`, harmonic near every
point of `B̆_{1-ε}(0)`, agrees with `w` a.e. on `B̆_{1-2ε}(0)`.

Take `v(x) = ∫_B κ(x - y) w(y) dy` with the mean-value kernel scaled to `κ(z) = ε⁻ⁿ ρ(z/ε)`; it
is harmonic on `B̆_{1-ε}(0)`.  For normalized bumps `ψⱼ` supported in `B̆_{sⱼ}(0)`, `sⱼ = ε/(j+2)`,
the mollifications `vⱼ = ψⱼ ⋆ 1_B w` are harmonic on `B̆_{1-ε}(0)` too, so for `|x₀| < 1 - 2ε` the
mean value property and Fubini give `vⱼ(x₀) = (ψⱼ ⋆ v)(x₀)`.  As `j → ∞` this tends to `v(x₀)` by
continuity of `v`, and to `w(x₀)` for a.e. `x₀` by Lebesgue differentiation. -/
theorem ball_weakly_harmonic_local_representative : ∀ n : ℕ, 1 ≤ n → ∀ w : Rn n → ℝ, IntegrableOn w (ball (0 : Rn n) 1) → (∀ ζ : Rn n → ℝ, ContDiff ℝ (⊤ : ℕ∞) ζ → HasCompactSupport ζ → tsupport ζ ⊆ ball 0 1 → ∫ x in ball (0 : Rn n) 1, w x * Laplacian.laplacian ζ x = 0) → ∀ ε : ℝ, 0 < ε → ε < 1 / 2 → ∃ v : Rn n → ℝ, InnerProductSpace.HarmonicOnNhd v (ball (0 : Rn n) (1 - ε)) ∧ ∀ᵐ x ∂(volume.restrict (ball (0 : Rn n) (1 - 2 * ε))), v x = w x := by
  -- Steps 3 and 6: normalized bumps `ψⱼ` vanishing off `B̆_{sⱼ}(0)`, `sⱼ = δ/(j+2) → 0`, with
  -- `ψⱼ ⋆ v → v` pointwise for continuous `v`, and `ψⱼ ⋆ 1_B w → w` a.e. on `B`.
  have hA : ∀ n : ℕ, ∀ δ : ℝ, 0 < δ → ∃ ψ : ℕ → Rn n → ℝ, (∀ j, ContDiff ℝ (⊤ : ℕ∞) (ψ j)) ∧ (∀ j, ∀ z : Rn n, δ ≤ ‖z‖ → ψ j z = 0) ∧ (∀ v : Rn n → ℝ, Continuous v → ∀ x : Rn n, Tendsto (fun j => ∫ b, ψ j b * v (x - b)) atTop (𝓝 (v x))) ∧ ∀ w : Rn n → ℝ, IntegrableOn w (ball (0 : Rn n) 1) → ∀ᵐ x ∂(volume.restrict (ball (0 : Rn n) 1)), Tendsto (fun j => ∫ y in ball (0 : Rn n) 1, ψ j (x - y) * w y) atTop (𝓝 (w x)) := by
    intro n δ hδ
    -- The radii `sⱼ = δ/(j+2)` lie in `(0, δ)` and tend to `0`.
    set s : ℕ → ℝ := fun j => δ / ((j : ℝ) + 2) with hs
    have hs_pos : ∀ j, 0 < s j := fun j => div_pos hδ (by positivity)
    have hs_lt : ∀ j, s j < δ := by
      intro j
      simp only [s]
      rw [div_lt_iff₀ (by positivity)]
      have : (0 : ℝ) ≤ j := Nat.cast_nonneg j
      nlinarith
    have hs_tend : Tendsto s atTop (𝓝 0) := by
      have h1 : Tendsto (fun j : ℕ => (j : ℝ) + 2) atTop atTop :=
        tendsto_atTop_add_const_right _ 2 tendsto_natCast_atTop_atTop
      exact h1.const_div_atTop δ
    -- `φⱼ` is the bump equal to `1` on `B_{sⱼ/2}(0)` with support `B̆_{sⱼ}(0)`; `ψⱼ = φⱼ / ∫ φⱼ`.
    let φ : ℕ → ContDiffBump (0 : Rn n) := fun j =>
      ⟨s j / 2, s j, half_pos (hs_pos j), half_lt_self (hs_pos j)⟩
    have hφint : ∀ j, Integrable (φ j) volume := fun j =>
      (φ j).continuous.integrable_of_hasCompactSupport (φ j).hasCompactSupport
    have hIpos : ∀ j, 0 < ∫ x, φ j x := by
      intro j
      refine (integral_pos_iff_support_of_nonneg (fun x => (φ j).nonneg) (hφint j)).mpr ?_
      rw [(φ j).support_eq]
      exact measure_ball_pos volume 0 (φ j).rOut_pos
    set ψ : ℕ → Rn n → ℝ := fun j x => φ j x / ∫ y, φ j y with hψdef
    have hψ_nonneg : ∀ j x, 0 ≤ ψ j x := fun j x => div_nonneg (φ j).nonneg (hIpos j).le
    have hψ_int1 : ∀ j, ∫ x, ψ j x = 1 := by
      intro j
      simp only [ψ]
      rw [integral_div]
      exact div_self (hIpos j).ne'
    have hψ_supp : ∀ j, Function.support (ψ j) = ball (0 : Rn n) (s j) := by
      intro j
      have : ψ j = fun x => φ j x / ∫ y, φ j y := rfl
      rw [this, Function.support_div, (φ j).support_eq, Function.support_const (hIpos j).ne',
        inter_univ]
    -- `|B_{sⱼ/2}(0)| ≤ ∫ φⱼ` and `|B_{sⱼ}(0)| = 2ᵈ |B_{sⱼ/2}(0)|`, so `|ψⱼ| ≤ 2ᵈ / |B_{sⱼ}(0)|`.
    have hIge : ∀ j, volume.real (closedBall (0 : Rn n) (s j / 2)) ≤ ∫ x, φ j x := by
      intro j
      calc volume.real (closedBall (0 : Rn n) (s j / 2))
          = ∫ x in closedBall (0 : Rn n) (s j / 2), (1 : ℝ) := by simp
        _ = ∫ x in closedBall (0 : Rn n) (s j / 2), φ j x := by
            refine setIntegral_congr_fun measurableSet_closedBall (fun x hx => ?_)
            exact ((φ j).one_of_mem_closedBall hx).symm
        _ ≤ ∫ x, φ j x :=
            setIntegral_le_integral (hφint j) (Eventually.of_forall (fun x => (φ j).nonneg))
    have hvol : ∀ j, volume.real (closedBall (0 : Rn n) (s j))
        = 2 ^ Module.finrank ℝ (Rn n) * volume.real (closedBall (0 : Rn n) (s j / 2)) := by
      intro j
      rw [Measure.addHaar_real_closedBall' _ _ (hs_pos j).le,
        Measure.addHaar_real_closedBall' _ _ (half_pos (hs_pos j)).le, ← mul_assoc, ← mul_pow]
      congr 2
      ring
    have hvolpos : ∀ j, 0 < volume.real (closedBall (0 : Rn n) (s j / 2)) := by
      intro j
      exact ENNReal.toReal_pos (measure_closedBall_pos _ _ (half_pos (hs_pos j))).ne'
        measure_closedBall_lt_top.ne
    have hψ_bound : ∀ j x, |ψ j x| ≤
        2 ^ Module.finrank ℝ (Rn n) / volume.real (closedBall (0 : Rn n) (s j)) := by
      intro j x
      rw [abs_of_nonneg (hψ_nonneg j x), hvol j]
      have h2 : (0 : ℝ) < 2 ^ Module.finrank ℝ (Rn n) := by positivity
      rw [div_mul_cancel_left₀ h2.ne']
      calc ψ j x = φ j x / ∫ y, φ j y := rfl
        _ ≤ 1 / ∫ y, φ j y := by
            gcongr
            · exact (hIpos j).le
            · exact (φ j).le_one
        _ ≤ 1 / volume.real (closedBall (0 : Rn n) (s j / 2)) := by
            gcongr
            · exact hvolpos j
            · exact hIge j
        _ = (volume.real (closedBall (0 : Rn n) (s j / 2)))⁻¹ := one_div _
    refine ⟨ψ, ?_, ?_, ?_, ?_⟩
    · -- `ψⱼ` is `C^∞`.
      intro j
      exact (φ j).contDiff.div_const _
    · -- `ψⱼ(z) = 0` for `|z| ≥ δ > sⱼ`.
      intro j z hz
      by_contra hne
      have hmem : z ∈ Function.support (ψ j) := hne
      rw [hψ_supp j, mem_ball, dist_zero_right] at hmem
      linarith [hs_lt j]
    · -- Approximate identity: `ψⱼ ⋆ v → v` at every point for continuous `v`.
      intro v hv x
      have hsmall : Tendsto (fun j => Function.support (ψ j)) atTop (𝓝 (0 : Rn n)).smallSets := by
        rw [nhds_basis_ball.smallSets.tendsto_right_iff]
        intro r hr
        have := (tendsto_order.1 hs_tend).2 r hr
        filter_upwards [this] with j hj
        rw [hψ_supp j]
        exact ball_subset_ball hj.le
      have h := convolution_tendsto_right (μ := volume) (Eventually.of_forall hψ_nonneg)
        (Eventually.of_forall hψ_int1) hsmall (Eventually.of_forall fun _ => hv.aestronglyMeasurable)
        ((hv.tendsto x).comp tendsto_snd) tendsto_const_nhds
      simpa only [convolution_def, ContinuousLinearMap.lsmul_apply, smul_eq_mul] using h
    · -- Lebesgue differentiation for `W = 1_B w` along the closed balls `B_{sⱼ}(x)`, with
      -- kernels `y ↦ ψⱼ(x - y)` bounded by `2ᵈ / |B_{sⱼ}(x)|`.
      intro w hw
      set W : Rn n → ℝ := (ball (0 : Rn n) 1).indicator w with hWdef
      have hWi : Integrable W := (integrable_indicator_iff measurableSet_ball).mpr hw
      have hleb := (Besicovitch.vitaliFamily (volume : Measure (Rn n))).ae_tendsto_average_norm_sub
        hWi.locallyIntegrable
      filter_upwards [ae_restrict_of_ae hleb, ae_restrict_mem measurableSet_ball] with x hx hxB
      have hs' : Tendsto s atTop (𝓝[>] 0) :=
        tendsto_nhdsWithin_iff.2 ⟨hs_tend, Eventually.of_forall hs_pos⟩
      have hav := (hx.comp (Besicovitch.tendsto_filterAt volume x)).comp hs'
      have key := tendsto_integral_smul_of_tendsto_average_norm_sub
        (μ := volume) (a := fun j => closedBall x (s j)) (f := W) (c := W x)
        (g := fun j y => ψ j (x - y)) (2 ^ Module.finrank ℝ (Rn n)) hav
        (Eventually.of_forall fun j => hWi.integrableOn)
        (by
          refine tendsto_const_nhds.congr (fun j => ?_)
          rw [integral_sub_left_eq_self (fun y => ψ j y) volume x, hψ_int1 j])
        (Eventually.of_forall fun j => by
          intro y hy
          have hmem : x - y ∈ Function.support (ψ j) := hy
          rw [hψ_supp j, mem_ball, dist_zero_right] at hmem
          rw [mem_closedBall, dist_eq_norm, ← norm_neg, neg_sub]
          exact hmem.le)
        (Eventually.of_forall fun j y => by
          rw [Measure.addHaar_real_closedBall_center]
          exact hψ_bound j (x - y))
      have hconv : ∀ j, ∫ y in ball (0 : Rn n) 1, ψ j (x - y) * w y = ∫ y, ψ j (x - y) • W y := by
        intro j
        rw [← integral_indicator measurableSet_ball]
        congr 1
        funext y
        simp only [smul_eq_mul, W]
        exact Set.indicator_mul_right _ (fun y => ψ j (x - y)) w
      have hWx : W x = w x := Set.indicator_of_mem hxB w
      simp_rw [hconv]
      rw [← hWx]
      exact key
  -- Step 5: Fubini exchanges two ball mollifications of `w`:
  -- `∫ κ(a) (ψ ⋆ 1_B w)(x₀ - a) da = ∫ ψ(b) (κ ⋆ 1_B w)(x₀ - b) db`.
  have hB : ∀ n : ℕ, ∀ κ ψ w : Rn n → ℝ, Continuous κ → HasCompactSupport κ → Continuous ψ → HasCompactSupport ψ → IntegrableOn w (ball (0 : Rn n) 1) → ∀ x₀ : Rn n, ∫ a, κ a * ∫ y in ball (0 : Rn n) 1, ψ (x₀ - a - y) * w y = ∫ b, ψ b * ∫ y in ball (0 : Rn n) 1, κ (x₀ - b - y) * w y := by
    intro n κ ψ w hκc hκs hψc hψs hw x₀
    set W : Rn n → ℝ := (ball (0 : Rn n) 1).indicator w with hWdef
    have hWi : Integrable W := (integrable_indicator_iff measurableSet_ball).mpr hw
    have conv : ∀ (φ : Rn n → ℝ) (x : Rn n),
        ∫ y in ball (0 : Rn n) 1, φ (x - y) * w y = ∫ t, φ t * W (x - t) := by
      intro φ x
      rw [← integral_indicator measurableSet_ball]
      have h1 : (ball (0 : Rn n) 1).indicator (fun y => φ (x - y) * w y)
          = fun y => φ (x - y) * W y := by
        funext y
        exact Set.indicator_mul_right _ (fun y => φ (x - y)) w
      rw [h1, ← integral_sub_left_eq_self _ volume x]
      simp only [sub_sub_cancel]
    simp_rw [conv]
    -- `(a, t) ↦ κ(a) ψ(t) W(x₀ - a - t)` is integrable on `ℝⁿ × ℝⁿ`: multiply the convolution
    -- integrand `ψ(t) W(a - t)` by the bounded `κ(x₀ - a)`, then substitute `a ↦ x₀ - a`.
    obtain ⟨Cκ, hCκ⟩ := hκc.bounded_above_of_compact_support hκs
    have hG : Integrable (fun p : Rn n × Rn n => κ (x₀ - p.1) * (ψ p.2 * W (p.1 - p.2)))
        (volume.prod volume) := by
      have h0 : Integrable (fun p : Rn n × Rn n => ψ p.2 * W (p.1 - p.2)) (volume.prod volume) := by
        have := (hψc.integrable_of_hasCompactSupport hψs : Integrable ψ volume).convolution_integrand
          (ContinuousLinearMap.mul ℝ ℝ) (μ := volume) hWi
        simpa using this
      refine h0.bdd_mul (c := Cκ) ?_ ?_
      · exact ((hκc.comp (continuous_const.sub continuous_fst))).aestronglyMeasurable
      · exact Eventually.of_forall (fun p => hCκ _)
    have hR : MeasurePreserving (fun p : Rn n × Rn n => (x₀ - p.1, p.2))
        (volume.prod volume) (volume.prod volume) :=
      (Measure.measurePreserving_sub_left volume x₀).prod (MeasurePreserving.id volume)
    have hF : Integrable (Function.uncurry fun a t => κ a * (ψ t * W (x₀ - a - t)))
        (volume.prod volume) := by
      have := (hR.integrable_comp hG.aestronglyMeasurable).mpr hG
      refine this.congr (Eventually.of_forall fun p => ?_)
      simp [Function.uncurry, sub_sub_cancel]
    calc ∫ a, κ a * ∫ t, ψ t * W (x₀ - a - t)
        = ∫ a, ∫ t, κ a * (ψ t * W (x₀ - a - t)) := by
          congr 1; funext a; rw [integral_const_mul]
      _ = ∫ t, ∫ a, κ a * (ψ t * W (x₀ - a - t)) := integral_integral_swap hF
      _ = ∫ b, ψ b * ∫ t, κ t * W (x₀ - b - t) := by
          congr 1; funext b; rw [← integral_const_mul]
          congr 1; funext a
          rw [sub_right_comm x₀ a b]; ring
  intro n hn w hint hlap ε hε hε2
  -- Step 1: the mean-value kernel `ρ`, scaled to `κ(z) = ε⁻ⁿ ρ(z/ε)`, vanishes for `|z| ≥ ε`.
  obtain ⟨ρ, hρs, hρv, hρm⟩ := Submission.exists_smooth_mean_value_kernel n hn
  set κ : Rn n → ℝ := fun z => ε⁻¹ ^ n * ρ (ε⁻¹ • z) with hκdef
  have hκs : ContDiff ℝ (⊤ : ℕ∞) κ :=
    contDiff_const.mul (hρs.comp (contDiff_const_smul _))
  have hκv : ∀ z : Rn n, ε ≤ ‖z‖ → κ z = 0 := by
    intro z hz
    have h1 : 1 ≤ ‖ε⁻¹ • z‖ := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hε), inv_mul_eq_div,
        le_div_iff₀ hε]
      linarith
    simp only [κ, hρv _ h1, mul_zero]
  have hcs : ∀ (φ : Rn n → ℝ), (∀ z : Rn n, ε ≤ ‖z‖ → φ z = 0) → HasCompactSupport φ := by
    intro φ hφ
    refine HasCompactSupport.intro (isCompact_closedBall (0 : Rn n) ε) (fun z hz => hφ z ?_)
    rw [mem_closedBall, dist_zero_right, not_le] at hz
    exact hz.le
  -- Step 2: `v = κ ⋆ 1_B w` is `C^∞` with `Δv = 0` on `B̆_{1-ε}(0)`, hence harmonic there.
  obtain ⟨hvs, hvl⟩ :=
    Submission.ball_convolution_contDiff_laplacian_eq_zero n hn w hint hlap κ ε hκs hκv
  set v : Rn n → ℝ := fun x => ∫ y in ball (0 : Rn n) 1, κ (x - y) * w y with hvdef
  have h2top : (2 : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := WithTop.coe_le_coe.mpr le_top
  refine ⟨v, ?_, ?_⟩
  · intro x hx
    refine ⟨hvs.contDiffAt.of_le h2top, ?_⟩
    filter_upwards [isOpen_ball.mem_nhds hx] with y hy
    exact hvl y hy
  -- Step 4: for `|x₀| < 1 - 2ε`, `vⱼ = ψⱼ ⋆ 1_B w` is harmonic on `B_ε(x₀) ⊆ B̆_{1-ε}(0)`, so the
  -- mean value property and step 5 give `vⱼ(x₀) = (ψⱼ ⋆ v)(x₀)`.
  obtain ⟨ψ, hψs, hψv, hψc, hψa⟩ := hA n ε hε
  have key : ∀ x₀ ∈ ball (0 : Rn n) (1 - 2 * ε), ∀ j : ℕ,
      (∫ y in ball (0 : Rn n) 1, ψ j (x₀ - y) * w y) = ∫ b, ψ j b * v (x₀ - b) := by
    intro x₀ hx₀ j
    obtain ⟨hvjs, hvjl⟩ :=
      Submission.ball_convolution_contDiff_laplacian_eq_zero n hn w hint hlap (ψ j) ε (hψs j)
        (hψv j)
    have hlapj : ∀ y ∈ closedBall x₀ ε,
        Laplacian.laplacian (fun x => ∫ y in ball (0 : Rn n) 1, ψ j (x - y) * w y) y = 0 := by
      intro y hy
      apply hvjl
      rw [mem_ball, dist_zero_right]
      rw [mem_ball, dist_zero_right] at hx₀
      rw [mem_closedBall, dist_eq_norm] at hy
      calc ‖y‖ = ‖(y - x₀) + x₀‖ := by rw [sub_add_cancel]
        _ ≤ ‖y - x₀‖ + ‖x₀‖ := norm_add_le _ _
        _ < 1 - ε := by linarith
    have hmvp := hρm (fun x => ∫ y in ball (0 : Rn n) 1, ψ j (x - y) * w y) x₀ ε hε
      (hvjs.of_le h2top) hlapj
    have hswap := hB n κ (ψ j) w hκs.continuous (hcs κ hκv)
      (hψs j).continuous (hcs (ψ j) (hψv j)) hint x₀
    rw [← hmvp]
    exact hswap
  -- Step 7: for a.e. `x₀ ∈ B̆_{1-2ε}(0)`, `vⱼ(x₀) = (ψⱼ ⋆ v)(x₀)` tends both to `w(x₀)` and,
  -- by continuity of `v`, to `v(x₀)`.
  have hae := hψa w hint
  have hae' : ∀ᵐ x ∂(volume.restrict (ball (0 : Rn n) (1 - 2 * ε))),
      Tendsto (fun j => ∫ y in ball (0 : Rn n) 1, ψ j (x - y) * w y) atTop (𝓝 (w x)) :=
    ae_restrict_of_ae_restrict_of_subset (ball_subset_ball (by linarith)) hae
  filter_upwards [hae', ae_restrict_mem (measurableSet_ball :
    MeasurableSet (ball (0 : Rn n) (1 - 2 * ε)))] with x hx hxm
  have hlim1 : Tendsto (fun j => ∫ y in ball (0 : Rn n) 1, ψ j (x - y) * w y) atTop (𝓝 (v x)) := by
    have := hψc v hvs.continuous x
    refine this.congr (fun j => ?_)
    exact (key x hxm j).symm
  exact tendsto_nhds_unique hlim1 hx

/-- **Gluing local harmonic representatives on the unit ball** (the patching step of Weyl's lemma).
If for every `ε ∈ (0, 1/2)` some `v_ε` is harmonic near every point of `B̆_{1-ε}(0)` and agrees with
`w` almost everywhere on `B̆_{1-2ε}(0)`, then some `u` is harmonic near every point of `B̆₁(0)` and
agrees with `w` almost everywhere on `B̆₁(0)`.
Proof: two representatives `v_ε, v_ε'` are continuous and a.e. equal on the open ball
`B̆_{1-2 max(ε, ε')}(0)`, hence equal there.  So `u(x) = v_{(1-|x|)/4}(x)` coincides with
`v_{ε₀}`, `ε₀ = (1-|x₀|)/4`, on `B̆_{ε₀}(x₀)` and is harmonic at `x₀`; and `u(x) = v_{1/(m+3)}(x)`
as soon as `1/(m+3) < (1-|x|)/4`, so `u = w` off a countable union of null sets. -/
theorem ball_harmonic_patching : ∀ n : ℕ, 1 ≤ n → ∀ w : Rn n → ℝ, (∀ ε : ℝ, 0 < ε → ε < 1 / 2 → ∃ v : Rn n → ℝ, InnerProductSpace.HarmonicOnNhd v (ball (0 : Rn n) (1 - ε)) ∧ ∀ᵐ x ∂(volume.restrict (ball (0 : Rn n) (1 - 2 * ε))), v x = w x) → ∃ u : Rn n → ℝ, InnerProductSpace.HarmonicOnNhd u (ball (0 : Rn n) 1) ∧ ∀ᵐ x ∂(volume.restrict (ball (0 : Rn n) 1)), u x = w x := by
  intro n _ w hw
  -- A representative `v ε` for every `ε` (any function outside `(0, 1/2)`).
  have hw' : ∀ ε : ℝ, ∃ v : Rn n → ℝ, 0 < ε → ε < 1 / 2 →
      InnerProductSpace.HarmonicOnNhd v (ball (0 : Rn n) (1 - ε)) ∧
        ∀ᵐ x ∂(volume.restrict (ball (0 : Rn n) (1 - 2 * ε))), v x = w x := by
    intro ε
    by_cases h : 0 < ε ∧ ε < 1 / 2
    · obtain ⟨v, hv⟩ := hw ε h.1 h.2
      exact ⟨v, fun _ _ => hv⟩
    · exact ⟨w, fun h1 h2 => absurd ⟨h1, h2⟩ h⟩
  choose v hv using hw'
  -- Compatibility: two representatives agree everywhere on `B̆_{1 - 2 max(ε, ε')}(0)`.
  have compat : ∀ ε ε' : ℝ, 0 < ε → ε < 1 / 2 → 0 < ε' → ε' < 1 / 2 →
      ∀ x ∈ ball (0 : Rn n) (1 - 2 * max ε ε'), v ε x = v ε' x := by
    intro ε ε' hε hε2 hε' hε'2
    have hU : ball (0 : Rn n) (1 - 2 * max ε ε') ⊆ ball 0 (1 - 2 * ε) :=
      ball_subset_ball (by linarith [le_max_left ε ε'])
    have hU' : ball (0 : Rn n) (1 - 2 * max ε ε') ⊆ ball 0 (1 - 2 * ε') :=
      ball_subset_ball (by linarith [le_max_right ε ε'])
    have hc : ContinuousOn (v ε) (ball (0 : Rn n) (1 - 2 * max ε ε')) :=
      (hv ε hε hε2).1.continuousOn.mono (hU.trans (ball_subset_ball (by linarith)))
    have hc' : ContinuousOn (v ε') (ball (0 : Rn n) (1 - 2 * max ε ε')) :=
      (hv ε' hε' hε'2).1.continuousOn.mono (hU'.trans (ball_subset_ball (by linarith)))
    have h1 : v ε =ᵐ[volume.restrict (ball (0 : Rn n) (1 - 2 * max ε ε'))] w :=
      ae_restrict_of_ae_restrict_of_subset hU (hv ε hε hε2).2
    have h2 : v ε' =ᵐ[volume.restrict (ball (0 : Rn n) (1 - 2 * max ε ε'))] w :=
      ae_restrict_of_ae_restrict_of_subset hU' (hv ε' hε' hε'2).2
    exact fun x hx => Measure.eqOn_open_of_ae_eq (h1.trans h2.symm) isOpen_ball hc hc' hx
  -- The patched function `u(x) = v_{(1 - |x|)/4}(x)`.
  refine ⟨fun x => v ((1 - ‖x‖) / 4) x, ?_, ?_⟩
  · -- Near `x₀`, `u = v_{ε₀}` with `ε₀ = (1 - |x₀|)/4`.
    intro x₀ hx₀
    rw [mem_ball_zero_iff] at hx₀
    obtain ⟨d, hd⟩ : ∃ d : ℝ, d = 1 - ‖x₀‖ := ⟨_, rfl⟩
    have hε₀ : 0 < d / 4 := by linarith
    have hε₀' : d / 4 < 1 / 2 := by linarith [norm_nonneg x₀]
    have heq : (fun x => v ((1 - ‖x‖) / 4) x) =ᶠ[𝓝 x₀] v (d / 4) := by
      filter_upwards [ball_mem_nhds x₀ hε₀] with x hx
      rw [mem_ball_iff_norm] at hx
      have h1 : ‖x‖ - ‖x₀‖ ≤ ‖x - x₀‖ := norm_sub_norm_le x x₀
      have h2 : ‖x₀‖ - ‖x‖ ≤ ‖x₀ - x‖ := norm_sub_norm_le x₀ x
      rw [norm_sub_rev] at h2
      have hex : 0 < (1 - ‖x‖) / 4 := by linarith
      have hex' : (1 - ‖x‖) / 4 < 1 / 2 := by linarith [norm_nonneg x]
      refine compat _ _ hex hex' hε₀ hε₀' x ?_
      rw [mem_ball_zero_iff]
      have hmax : max ((1 - ‖x‖) / 4) (d / 4) < 5 * d / 16 :=
        max_lt (by linarith) (by linarith)
      linarith
    exact (InnerProductSpace.harmonicAt_congr_nhds heq).2
      ((hv (d / 4) hε₀ hε₀').1 x₀ (by rw [mem_ball_zero_iff]; linarith))
  · -- Off the null set where some `v_{1/(m+3)}` differs from `w`, `u = w`.
    have hmem : ∀ m : ℕ, 0 < 1 / ((m : ℝ) + 3) ∧ 1 / ((m : ℝ) + 3) < 1 / 2 := by
      intro m
      have hm : (0 : ℝ) ≤ m := m.cast_nonneg
      exact ⟨by positivity, one_div_lt_one_div_of_lt (by norm_num) (by linarith)⟩
    have hall : ∀ᵐ x ∂(volume : Measure (Rn n)), ∀ m : ℕ,
        x ∈ ball (0 : Rn n) (1 - 2 * (1 / ((m : ℝ) + 3))) → v (1 / ((m : ℝ) + 3)) x = w x := by
      rw [ae_all_iff]
      intro m
      exact (ae_restrict_iff' measurableSet_ball).1 (hv _ (hmem m).1 (hmem m).2).2
    rw [ae_restrict_iff' measurableSet_ball]
    filter_upwards [hall] with x hx hxB
    show v ((1 - ‖x‖) / 4) x = w x
    rw [mem_ball_zero_iff] at hxB
    have hex : 0 < (1 - ‖x‖) / 4 := by linarith
    have hex' : (1 - ‖x‖) / 4 < 1 / 2 := by linarith [norm_nonneg x]
    obtain ⟨m, hm⟩ := exists_nat_one_div_lt hex
    have hm0 : (0 : ℝ) ≤ m := m.cast_nonneg
    have hm3 : 1 / ((m : ℝ) + 3) < (1 - ‖x‖) / 4 :=
      lt_of_le_of_lt (one_div_le_one_div_of_le (by linarith) (by linarith)) hm
    rw [compat _ _ hex hex' (hmem m).1 (hmem m).2 x
      (by rw [mem_ball_zero_iff, max_eq_left hm3.le]; linarith)]
    exact hx m (by rw [mem_ball_zero_iff]; linarith)

/-- Simon Ch. 5, proof of Lemma 3.1 (p. 114), Weyl's lemma step "thus `w` is harmonic in `B`":
if `w ∈ W^{1,2}(B)` has weak gradient `g` and `u` is `C¹` on the open unit ball `B` with `u = w`
a.e. on `B`, then `∇u = g` a.e. on `B`.  For a test function `ζ`, `φ = u ζ` is `C¹` with compact
support in `B`, so translation invariance of Lebesgue measure gives `∫ Dφ = 0`, i.e.
`∫ u ∇ζ = -∫ ζ ∇u`.  With `u = w` a.e. and the weak-gradient identity this yields
`∫ ζ (∇u - g) = 0`, and the fundamental lemma of the calculus of variations on the open ball `B`
gives `∇u = g` a.e. on `B`. -/
theorem w12_ball_gradient_ae_eq_of_contDiffAt : ∀ n : ℕ, 1 ≤ n → ∀ (w u : Rn n → ℝ) (g : Rn n → Rn n), IsW12WithGradient w g (ball 0 1) → (∀ x ∈ ball (0 : Rn n) 1, ContDiffAt ℝ 1 u x) → (∀ᵐ x ∂(volume.restrict (ball (0 : Rn n) 1)), u x = w x) → ∀ᵐ x ∂(volume.restrict (ball (0 : Rn n) 1)), gradient u x = g x := by
  intro n _ w u g hw hu huw
  obtain ⟨-, hgL, hweak⟩ := hw
  -- `∇u` is continuous on `B` and `g` is integrable on `B`, so `∇u - g` is locally integrable.
  have hgu : ∀ x ∈ ball (0 : Rn n) 1, ContinuousAt (gradient u) x := fun x hx =>
    (InnerProductSpace.toDual ℝ (Rn n)).symm.continuous.continuousAt.comp
      ((hu x hx).continuousAt_fderiv one_ne_zero)
  have : IsFiniteMeasure (volume.restrict (ball (0 : Rn n) 1)) :=
    isFiniteMeasure_restrict.2 measure_ball_lt_top.ne
  have hg : IntegrableOn g (ball (0 : Rn n) 1) := hgL.integrable one_le_two
  have hloc : LocallyIntegrableOn (fun x => gradient u x - g x) (ball (0 : Rn n) 1) :=
    ((continuousOn_of_forall_continuousAt hgu).locallyIntegrableOn measurableSet_ball).sub
      hg.locallyIntegrableOn
  -- `∫ ζ (∇u - g) = 0` for every test function `ζ` supported in `B`.
  have key : ∀ ζ : Rn n → ℝ, ContDiff ℝ (⊤ : ℕ∞) ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ ball 0 1 → ∫ x, ζ x • (gradient u x - g x) = 0 := by
    intro ζ hζ hζc hζB
    have hζ1 : ContDiff ℝ 1 ζ := hζ.of_le (by exact_mod_cast le_top)
    have hgζ : Continuous (gradient ζ) :=
      (InnerProductSpace.toDual ℝ (Rn n)).symm.continuous.comp
        (hζ1.continuous_fderiv one_ne_zero)
    -- `ζ` and `∇ζ` vanish on the open set `(tsupport ζ)ᶜ`.
    have hζ0 : ∀ x ∉ tsupport ζ, ζ x = 0 := fun x hx => image_eq_zero_of_notMem_tsupport hx
    have hgζ0 : ∀ x ∉ tsupport ζ, gradient ζ x = 0 := fun x hx => by
      rw [gradient, fderiv_of_notMem_tsupport ℝ hx, map_zero]
    have hK : ∀ x ∉ tsupport ζ, ∀ᶠ y in 𝓝 x, y ∉ tsupport ζ := fun x hx =>
      (isClosed_tsupport ζ).isOpen_compl.mem_nhds hx
    -- `φ = u ζ` is `C¹` with compact support in `B`, and `∇φ = u ∇ζ + ζ ∇u`.
    set φ : Rn n → ℝ := fun x => u x * ζ x
    have hφ0 : ∀ x ∉ tsupport ζ, φ =ᶠ[𝓝 x] fun _ => 0 := fun x hx => by
      filter_upwards [hK x hx] with y hy
      simp [φ, hζ0 y hy]
    have hφ1 : ContDiff ℝ 1 φ := by
      rw [contDiff_iff_contDiffAt]
      intro x
      by_cases hx : x ∈ tsupport ζ
      · exact (hu x (hζB hx)).mul hζ1.contDiffAt
      · exact contDiffAt_const.congr_of_eventuallyEq (hφ0 x hx)
    have hφc : HasCompactSupport φ := hζc.mul_left
    have hφB : tsupport φ ⊆ ball 0 1 := tsupport_mul_subset_right.trans hζB
    have hφg : ∀ x, gradient φ x = u x • gradient ζ x + ζ x • gradient u x := by
      intro x
      by_cases hx : x ∈ tsupport ζ
      · have hd : HasFDerivAt φ (u x • fderiv ℝ ζ x + ζ x • fderiv ℝ u x) x :=
          (((hu x (hζB hx)).differentiableAt one_ne_zero).hasFDerivAt).mul
            ((hζ1.differentiable one_ne_zero x).hasFDerivAt)
        rw [gradient, hd.fderiv, map_add, map_smulₛₗ, map_smulₛₗ]
        simp [gradient]
      · rw [gradient, (hφ0 x hx).fderiv_eq, hζ0 x hx, hgζ0 x hx]
        simp
    -- Translation invariance: `y ↦ ∫ φ (x + y) dx` is constant, so `∫ Dφ = 0`.
    have hdφ : Continuous (fderiv ℝ φ) := hφ1.continuous_fderiv one_ne_zero
    obtain ⟨M, hM⟩ := hdφ.bounded_above_of_compact_support (hφc.fderiv ℝ)
    have hDφ : ∫ x, fderiv ℝ φ x = 0 := by
      have hderiv : HasFDerivAt (fun y : Rn n => ∫ x, φ (x + y)) (∫ x, fderiv ℝ φ (x + 0)) 0 := by
        refine hasFDerivAt_integral_of_dominated_of_fderiv_le
          (F' := fun y x => fderiv ℝ φ (x + y))
          (bound := (ball (0 : Rn n) 2).indicator fun _ => M) (ball_mem_nhds 0 one_pos)
          (Eventually.of_forall fun y =>
            (hφ1.continuous.comp (continuous_id.add_const y)).aestronglyMeasurable)
          ?_ (hdφ.comp (continuous_id.add_const 0)).aestronglyMeasurable ?_ ?_ ?_
        · simpa using hφ1.continuous.integrable_of_hasCompactSupport hφc
        · refine Eventually.of_forall fun x y hy => ?_
          by_cases hx : x ∈ ball (0 : Rn n) 2
          · rw [indicator_of_mem hx]
            exact hM _
          · rw [indicator_of_notMem hx]
            have hxy : x + y ∉ tsupport φ := by
              intro h
              have h1 := hφB h
              rw [mem_ball_zero_iff] at h1 hy
              rw [mem_ball_zero_iff, not_lt] at hx
              have h2 := norm_sub_le (x + y) y
              rw [add_sub_cancel_right] at h2
              linarith
            rw [fderiv_of_notMem_tsupport ℝ hxy, norm_zero]
        · exact (integrableOn_const (measure_ball_lt_top).ne).integrable_indicator
            measurableSet_ball
        · exact Eventually.of_forall fun x y _ =>
            (hasFDerivAt_comp_add_left x).2 (hφ1.differentiable one_ne_zero (x + y)).hasFDerivAt
      have hconst : (fun y : Rn n => ∫ x, φ (x + y)) = fun _ => ∫ x, φ x := by
        funext y
        exact integral_add_right_eq_self φ y
      rw [hconst] at hderiv
      simpa using hderiv.unique (hasFDerivAt_const _ _)
    have hgφ : ∫ x, gradient φ x = 0 := by
      have h := ContinuousLinearMap.integral_comp_commSL (σ := starRingEnd ℝ) (by simp)
        ((InnerProductSpace.toDual ℝ (Rn n)).symm.toContinuousLinearEquiv :
          StrongDual ℝ (Rn n) →SL[starRingEnd ℝ] Rn n)
        (μ := volume) (hdφ.integrable_of_hasCompactSupport (hφc.fderiv ℝ))
      simpa [gradient, hDφ] using h
    -- Integrability of the three pieces.
    have hA : Integrable (fun x => u x • gradient ζ x) := by
      refine Continuous.integrable_of_hasCompactSupport ?_ ?_
      · refine continuous_iff_continuousAt.2 fun x => ?_
        by_cases hx : x ∈ tsupport ζ
        · exact ((hu x (hζB hx)).continuousAt).smul hgζ.continuousAt
        · refine ContinuousAt.congr (f := fun _ => (0 : Rn n)) continuousAt_const ?_
          filter_upwards [hK x hx] with y hy
          simp [hgζ0 y hy]
      · refine hζc.mono' fun x hx => ?_
        by_contra h
        exact hx (by simp [hgζ0 x h])
    have hC : Integrable (fun x => ζ x • gradient u x) := by
      refine Continuous.integrable_of_hasCompactSupport ?_ ?_
      · refine continuous_iff_continuousAt.2 fun x => ?_
        by_cases hx : x ∈ tsupport ζ
        · exact hζ.continuous.continuousAt.smul (hgu x (hζB hx))
        · refine ContinuousAt.congr (f := fun _ => (0 : Rn n)) continuousAt_const ?_
          filter_upwards [hK x hx] with y hy
          simp [hζ0 y hy]
      · refine hζc.mono' fun x hx => ?_
        by_contra h
        exact hx (by simp [hζ0 x h])
    have hD : Integrable (fun x => ζ x • g x) := by
      obtain ⟨Cζ, hCζ⟩ := hζ.continuous.bounded_above_of_compact_support hζc
      refine IntegrableOn.integrable_of_forall_notMem_eq_zero
        (hg.bdd_smul Cζ hζ.continuous.aestronglyMeasurable (Eventually.of_forall hCζ)) ?_
      intro x hx
      simp [hζ0 x fun h => hx (hζB h)]
    -- `∫ u ∇ζ = -∫ ζ ∇u` and `∫ ζ g = -∫ u ∇ζ`.
    have hibp : (∫ x, u x • gradient ζ x) + ∫ x, ζ x • gradient u x = 0 := by
      rw [← integral_add hA hC, ← hgφ]
      exact integral_congr_ae (Eventually.of_forall fun x => (hφg x).symm)
    have hζg : ∫ x, ζ x • g x = -∫ x, u x • gradient ζ x := by
      have h1 : ∫ x in ball (0 : Rn n) 1, ζ x • g x = ∫ x, ζ x • g x :=
        setIntegral_eq_integral_of_forall_compl_eq_zero fun x hx => by
          simp [hζ0 x fun h => hx (hζB h)]
      have h2 : ∫ x in ball (0 : Rn n) 1, u x • gradient ζ x = ∫ x, u x • gradient ζ x :=
        setIntegral_eq_integral_of_forall_compl_eq_zero fun x hx => by
          simp [hgζ0 x fun h => hx (hζB h)]
      have h3 : ∫ x in ball (0 : Rn n) 1, w x • gradient ζ x =
          ∫ x in ball (0 : Rn n) 1, u x • gradient ζ x :=
        integral_congr_ae (by filter_upwards [huw] with x hx; rw [hx])
      rw [← h1, ← h2, ← h3, hweak ζ hζ hζc hζB, neg_neg]
    have hsub : ∫ x, ζ x • (gradient u x - g x) =
        (∫ x, ζ x • gradient u x) - ∫ x, ζ x • g x := by
      rw [← integral_sub hC hD]
      simp only [smul_sub]
    rw [hsub, hζg, sub_neg_eq_add, add_comm, hibp]
  -- Fundamental lemma of the calculus of variations on the open ball.
  have h0 := isOpen_ball.ae_eq_zero_of_integral_contDiff_smul_eq_zero hloc key
  rw [ae_restrict_iff' measurableSet_ball]
  filter_upwards [h0] with x hx hxB
  exact sub_eq_zero.1 (hx hxB)

/-- **Weyl's lemma** for `W^{1,2}(B)`, `B = B̆₁(0)` (Simon Ch. 5, proof of Lemma 3.1, p. 114: "Thus
`w` is harmonic in `B`"; Weyl 1940, cf. Hörmander, ALPDO I, Thm. 4.4.1).  If `w` has weak gradient
`g` on `B` and `∫_B ⟨g, ∇ζ⟩ = 0` for every `ζ ∈ C^∞_c(B)`, then `w` agrees a.e. on `B` with a
function `u` harmonic near every point of `B`, and `∇u = g` a.e. on `B`.  Since `w ∈ L²(B) ⊆ L¹(B)`,
`w` is weakly harmonic in Laplacian form; mollification and the mean value property give harmonic
representatives on each `B_{1-ε}`, which glue to `u`; and the weak gradient of a `C¹`
representative is its classical gradient. -/
theorem w12_ball_weyl_lemma : ∀ n : ℕ, 1 ≤ n → ∀ (w : Rn n → ℝ) (g : Rn n → Rn n), IsW12WithGradient w g (ball 0 1) → (∀ ζ : Rn n → ℝ, ContDiff ℝ (⊤ : ℕ∞) ζ → HasCompactSupport ζ → tsupport ζ ⊆ ball 0 1 → ∫ x in ball (0 : Rn n) 1, inner ℝ (g x) (gradient ζ x) = 0) → ∃ u : Rn n → ℝ, InnerProductSpace.HarmonicOnNhd u (ball 0 1) ∧ (∀ᵐ x ∂(volume.restrict (ball (0 : Rn n) 1)), u x = w x) ∧ ∀ᵐ x ∂(volume.restrict (ball (0 : Rn n) 1)), gradient u x = g x := by
  intro n hn w g hwg hg
  -- `w ∈ L²(B)` and `|B| < ∞`, so `w ∈ L¹(B)`.
  have hint : IntegrableOn w (ball (0 : Rn n) 1) := by
    have : IsFiniteMeasure (volume.restrict (ball (0 : Rn n) 1)) :=
      isFiniteMeasure_restrict.2 measure_ball_lt_top.ne
    exact hwg.1.integrable one_le_two
  -- Weak harmonicity in Laplacian form: `∫_B w Δζ = 0` for every test function `ζ`.
  have hlap := Submission.w12_ball_weak_laplacian_eq_zero n hn w g hwg hg
  -- Harmonic representatives on the balls `B_{1-ε}`, glued into `u` harmonic on `B`, `u = w` a.e.
  obtain ⟨u, hu, huw⟩ := Submission.ball_harmonic_patching n hn w
    (Submission.ball_weakly_harmonic_local_representative n hn w hint hlap)
  -- `u` is `C²`, hence `C¹`, near each point of `B`, so its gradient is the weak gradient `g`.
  exact ⟨u, hu, huw, Submission.w12_ball_gradient_ae_eq_of_contDiffAt n hn w u g hwg
    (fun x hx => (hu x hx).1.of_le one_le_two) huw⟩

/-- **Simon Ch. 5, Lemma 3.1 (Harmonic approximation, p. 114)**, by the book's compactness
argument.  A counterexample sequence for `δ = 1/(k+1)` is normalized by its means over `B`; the
Poincaré inequality, Rellich's theorem and weak compactness of `L²(B; ℝⁿ)` give a subsequence
converging to some `w ∈ W^{1,2}(B)` with weak gradient `g`, `∫_B |g|² ≤ 1`.  The defect bound
`|∫_B g_k · ∇ζ| ≤ sup|∇ζ| / (k+1)` makes `w` weakly harmonic, so by Weyl's lemma `w = u₀` a.e.
for a harmonic `u₀` with `∇u₀ = g` a.e.; then `u₀ + mean` contradicts the choice of the sequence. -/
theorem harmonic_approximation_lemma : HarmonicApproximationLemma := by
  have hPoinc := Submission.w12_ball_poincare_inequality
  have hRellich := Submission.w12_ball_rellich_compactness
  have hWeak := Submission.l2_ball_weak_subsequence
  have hWeyl := Submission.w12_ball_weyl_lemma
  intro n hn ε hε
  -- Step 1: a contradiction sequence `F k, G k` for `δ = 1/(k+1)`.
  by_contra hcon
  push Not at hcon
  choose F G hFG hGle hGδ hFu using fun k : ℕ => hcon (1 / ((k : ℝ) + 1)) (by positivity)
  have hfin : IsFiniteMeasure (volume.restrict (ball (0 : Rn n) 1)) :=
    isFiniteMeasure_restrict.2 measure_ball_lt_top.ne
  have htop : ((⊤ : ℕ∞) : WithTop ℕ∞) ≠ 0 := by simp
  -- Test functions: their gradients are continuous, compactly supported, and integrate to `0`.
  have hgradCont : ∀ ζ : Rn n → ℝ, ContDiff ℝ (⊤ : ℕ∞) ζ → Continuous (gradient ζ) :=
    fun ζ hζ => (InnerProductSpace.toDual ℝ (Rn n)).symm.continuous.comp
      (hζ.continuous_fderiv htop)
  have hgradSupp : ∀ ζ : Rn n → ℝ, HasCompactSupport ζ → HasCompactSupport (gradient ζ) :=
    fun ζ hζc => (hζc.fderiv (𝕜 := ℝ)).comp_left
      (g := (InnerProductSpace.toDual ℝ (Rn n)).symm) (map_zero _)
  have hgradTop : ∀ ζ : Rn n → ℝ, ContDiff ℝ (⊤ : ℕ∞) ζ → HasCompactSupport ζ →
      MemLp (gradient ζ) ⊤ (volume.restrict (ball (0 : Rn n) 1)) := fun ζ hζ hζc =>
    ((hgradCont ζ hζ).memLp_of_hasCompactSupport (hgradSupp ζ hζc)).restrict _
  have hgradInt : ∀ ζ : Rn n → ℝ, ContDiff ℝ (⊤ : ℕ∞) ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ ball 0 1 → ∫ x in ball (0 : Rn n) 1, gradient ζ x = 0 := by
    intro ζ hζ hζc hζB
    have hout : ∀ x, x ∉ ball (0 : Rn n) 1 → gradient ζ x = 0 := by
      intro x hx
      have hx' : fderiv ℝ ζ x = 0 := fderiv_of_notMem_tsupport ℝ fun h => hx (hζB h)
      simp [gradient, hx']
    rw [setIntegral_eq_integral_of_forall_compl_eq_zero hout]
    have hint : Integrable (gradient ζ) volume :=
      (hgradCont ζ hζ).integrable_of_hasCompactSupport (hgradSupp ζ hζc)
    refine ext_inner_left ℝ fun v => ?_
    have hcomm := (innerSL ℝ v).integral_comp_comm hint
    simp only [innerSL_apply_apply] at hcomm
    rw [inner_zero_right, ← hcomm]
    simp only [inner_gradient_right, conj_trivial]
    -- `∫ ∂ᵥζ = 0`: differentiate the translation-invariant `t ↦ ∫ ζ (x + t • v)` at `t = 0`.
    obtain ⟨C, hC⟩ := (hζ.continuous_fderiv htop).bounded_above_of_compact_support
      (hζc.fderiv (𝕜 := ℝ))
    have hbound : ∀ x : Rn n, ∀ t ∈ ball (0 : ℝ) 1, ‖fderiv ℝ ζ (x + t • v) v‖ ≤
        (ball (0 : Rn n) (1 + ‖v‖)).indicator (fun _ => C * ‖v‖) x := by
      intro x t ht
      by_cases hx : x + t • v ∈ tsupport ζ
      · have hxB : x ∈ ball (0 : Rn n) (1 + ‖v‖) := by
          have h1 : ‖x + t • v‖ < 1 := mem_ball_zero_iff.1 (hζB hx)
          have h2 : ‖t • v‖ ≤ ‖v‖ := by
            rw [norm_smul]
            have : ‖t‖ < 1 := mem_ball_zero_iff.1 ht
            nlinarith [norm_nonneg v, norm_nonneg t]
          rw [mem_ball_zero_iff]
          calc ‖x‖ = ‖(x + t • v) - t • v‖ := by rw [add_sub_cancel_right]
            _ ≤ ‖x + t • v‖ + ‖t • v‖ := norm_sub_le _ _
            _ < 1 + ‖v‖ := by linarith
        rw [indicator_of_mem hxB]
        exact (ContinuousLinearMap.le_opNorm _ _).trans
          (mul_le_mul_of_nonneg_right (hC _) (norm_nonneg _))
      · rw [fderiv_of_notMem_tsupport ℝ hx]
        refine (le_of_eq (by simp)).trans (indicator_nonneg
          (fun _ _ => mul_nonneg ((norm_nonneg _).trans (hC 0)) (norm_nonneg _)) x)
    have hhas : ∀ x : Rn n, ∀ t ∈ ball (0 : ℝ) 1,
        HasDerivAt (fun t : ℝ => ζ (x + t • v)) (fderiv ℝ ζ (x + t • v) v) t := by
      intro x t _
      have h1 : HasDerivAt (fun t : ℝ => x + t • v) v t := by
        simpa using ((hasDerivAt_id t).smul_const v).const_add x
      exact ((hζ.differentiable htop) (x + t • v)).hasFDerivAt.comp_hasDerivAt t h1
    have hderiv := (hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := volume) (𝕜 := ℝ)
      (F := fun (t : ℝ) (x : Rn n) => ζ (x + t • v))
      (F' := fun (t : ℝ) (x : Rn n) => fderiv ℝ ζ (x + t • v) v)
      (ball_mem_nhds (0 : ℝ) one_pos)
      (Eventually.of_forall fun t =>
        (hζ.continuous.comp (continuous_id.add continuous_const)).aestronglyMeasurable)
      (by simpa using hζ.continuous.integrable_of_hasCompactSupport hζc)
      ((((hζ.continuous_fderiv htop).comp (continuous_id.add continuous_const)).clm_apply
        continuous_const).aestronglyMeasurable)
      (Eventually.of_forall hbound)
      ((integrable_indicator_iff measurableSet_ball).2
        (integrableOn_const measure_ball_lt_top.ne))
      (Eventually.of_forall hhas)).2
    have hzero : HasDerivAt (fun t : ℝ => ∫ x, ζ (x + t • v)) 0 0 := by
      have hconst : (fun t : ℝ => ∫ x, ζ (x + t • v)) = fun _ => ∫ x, ζ x :=
        funext fun t => integral_add_right_eq_self ζ (t • v)
      rw [hconst]
      exact hasDerivAt_const _ _
    simpa using hderiv.unique hzero
  -- Step 2: subtract the means `lam k`; the normalized functions keep the weak gradients `G k`.
  obtain ⟨lam, hlam⟩ : ∃ lam : ℕ → ℝ, ∀ k, lam k = ⨍ y in ball (0 : Rn n) 1, F k y :=
    ⟨fun k => ⨍ y in ball (0 : Rn n) 1, F k y, fun _ => rfl⟩
  have hW12 : ∀ k, IsW12WithGradient (fun x => F k x - lam k) (G k) (ball 0 1) := by
    intro k
    obtain ⟨hF2, hG2, hFid⟩ := hFG k
    refine ⟨hF2.sub (memLp_const (lam k)), hG2, fun ζ hζ hζc hζB => ?_⟩
    have h1 : Integrable (fun x => F k x • gradient ζ x)
        (volume.restrict (ball (0 : Rn n) 1)) :=
      (hF2.integrable one_le_two).smul_of_top_left (hgradTop ζ hζ hζc)
    have h2 : Integrable (fun x => lam k • gradient ζ x)
        (volume.restrict (ball (0 : Rn n) 1)) :=
      ((hgradTop ζ hζ hζc).integrable le_top).smul (lam k)
    simp_rw [sub_smul]
    rw [integral_sub h1 h2, integral_smul, hgradInt ζ hζ hζc hζB, smul_zero, sub_zero]
    exact hFid ζ hζ hζc hζB
  -- Step 3: Poincaré bounds the normalized functions in `L²(B)`.
  obtain ⟨CP, -, hCP⟩ := hPoinc n hn
  have hWbd : ∀ k, ∫⁻ x in ball (0 : Rn n) 1, ‖F k x - lam k‖ₑ ^ 2 ≤
      ENNReal.ofReal (max CP 1) := by
    intro k
    rw [hlam k]
    calc ∫⁻ x in ball (0 : Rn n) 1, ‖F k x - ⨍ y in ball (0 : Rn n) 1, F k y‖ₑ ^ 2
        ≤ ENNReal.ofReal CP * ∫⁻ x in ball (0 : Rn n) 1, ‖G k x‖ₑ ^ 2 := hCP (F k) (G k) (hFG k)
      _ ≤ ENNReal.ofReal CP * 1 := by gcongr; exact hGle k
      _ ≤ ENNReal.ofReal (max CP 1) := by
        rw [mul_one]; exact ENNReal.ofReal_le_ofReal (le_max_left _ _)
  have hGbd : ∀ k, ∫⁻ x in ball (0 : Rn n) 1, ‖G k x‖ₑ ^ 2 ≤ ENNReal.ofReal (max CP 1) :=
    fun k => (hGle k).trans (by
      rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (le_max_right _ _))
  -- Step 4: Rellich (strong `L²` limit `w`) and weak compactness (weak `L²` limit `g`).
  obtain ⟨φ1, w, hφ1, hw2, hwconv⟩ :=
    hRellich n hn (max CP 1) (fun k x => F k x - lam k) G hW12 hWbd hGbd
  obtain ⟨φ2, g, hφ2, hg2, hgle, hgweak⟩ :=
    hWeak n (fun k => G (φ1 k)) (fun k => (hFG (φ1 k)).2.1) (fun k => hGle (φ1 k))
  have hψ : Tendsto (fun k => φ1 (φ2 k)) atTop atTop :=
    hφ1.tendsto_atTop.comp hφ2.tendsto_atTop
  have hconv2 : Tendsto (fun k => ∫⁻ x in ball (0 : Rn n) 1,
      ‖F (φ1 (φ2 k)) x - lam (φ1 (φ2 k)) - w x‖ₑ ^ 2) atTop (𝓝 0) :=
    hwconv.comp hφ2.tendsto_atTop
  -- `L²` convergence on the finite-measure ball gives `L¹` convergence (Cauchy–Schwarz).
  have hL1 : Tendsto (fun k => ∫⁻ x in ball (0 : Rn n) 1,
      ‖F (φ1 (φ2 k)) x - lam (φ1 (φ2 k)) - w x‖ₑ) atTop (𝓝 0) := by
    have hbound : ∀ k, ∫⁻ x in ball (0 : Rn n) 1, ‖F (φ1 (φ2 k)) x - lam (φ1 (φ2 k)) - w x‖ₑ ≤
        (∫⁻ x in ball (0 : Rn n) 1, ‖F (φ1 (φ2 k)) x - lam (φ1 (φ2 k)) - w x‖ₑ ^ 2) ^ (1 / 2 : ℝ) *
          volume (ball (0 : Rn n) 1) ^ (1 / 2 : ℝ) := by
      intro k
      have hmeas : AEMeasurable (fun x => ‖F (φ1 (φ2 k)) x - lam (φ1 (φ2 k)) - w x‖ₑ)
          (volume.restrict (ball (0 : Rn n) 1)) :=
        ((hW12 (φ1 (φ2 k))).1.sub hw2).aestronglyMeasurable.enorm
      have hCS := ENNReal.lintegral_mul_le_Lp_mul_Lq (volume.restrict (ball (0 : Rn n) 1))
        Real.HolderConjugate.two_two hmeas (aemeasurable_const (b := (1 : ℝ≥0∞)))
      simpa [ENNReal.rpow_two] using hCS
    have hlim : Tendsto (fun k => (∫⁻ x in ball (0 : Rn n) 1,
        ‖F (φ1 (φ2 k)) x - lam (φ1 (φ2 k)) - w x‖ₑ ^ 2) ^ (1 / 2 : ℝ) *
          volume (ball (0 : Rn n) 1) ^ (1 / 2 : ℝ)) atTop (𝓝 0) := by
      have h1 := ((ENNReal.continuous_rpow_const (y := (1 / 2 : ℝ))).tendsto 0).comp hconv2
      rw [ENNReal.zero_rpow_of_pos (by norm_num : (0 : ℝ) < 1 / 2)] at h1
      have h2 := ENNReal.Tendsto.mul_const h1
        (Or.inr (ENNReal.rpow_ne_top_of_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2)
          (measure_ball_lt_top (μ := (volume : Measure (Rn n))) (x := 0) (r := 1)).ne))
      rw [zero_mul] at h2
      exact h2
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hlim
      (fun _ => zero_le) hbound
  -- Passing to the limit in `∫ W_k ∇ζ` along the subsequence.
  have hLHS : ∀ ζ : Rn n → ℝ, ContDiff ℝ (⊤ : ℕ∞) ζ → HasCompactSupport ζ →
      Tendsto (fun k => ∫ x in ball (0 : Rn n) 1,
        (F (φ1 (φ2 k)) x - lam (φ1 (φ2 k))) • gradient ζ x) atTop
        (𝓝 (∫ x in ball (0 : Rn n) 1, w x • gradient ζ x)) := by
    intro ζ hζ hζc
    obtain ⟨M, hM⟩ := (hgradCont ζ hζ).bounded_above_of_compact_support (hgradSupp ζ hζc)
    have hle : ∀ k, ∫⁻ x in ball (0 : Rn n) 1,
        ‖(F (φ1 (φ2 k)) x - lam (φ1 (φ2 k))) • gradient ζ x - w x • gradient ζ x‖ₑ ≤
          ENNReal.ofReal M * ∫⁻ x in ball (0 : Rn n) 1,
            ‖F (φ1 (φ2 k)) x - lam (φ1 (φ2 k)) - w x‖ₑ := by
      intro k
      rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
      refine lintegral_mono fun x => ?_
      rw [← sub_smul, enorm_smul, mul_comm]
      gcongr
      rw [← ofReal_norm]
      exact ENNReal.ofReal_le_ofReal (hM x)
    have hlim := ENNReal.Tendsto.const_mul hL1 (Or.inr (ENNReal.ofReal_ne_top (r := M)))
    rw [mul_zero] at hlim
    refine tendsto_integral_of_L1 _
      (hw2.aestronglyMeasurable.smul (hgradTop ζ hζ hζc).aestronglyMeasurable)
      (Eventually.of_forall fun k =>
        ((hW12 (φ1 (φ2 k))).1.integrable one_le_two).smul_of_top_left (hgradTop ζ hζ hζc))
      (tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hlim (fun _ => zero_le) hle)
  -- Step 5: the limit `w` lies in `W^{1,2}(B)` with weak gradient `g`.
  have hwW12 : IsW12WithGradient w g (ball 0 1) := by
    refine ⟨hw2, hg2, fun ζ hζ hζc hζB => ?_⟩
    have hζtop : MemLp ζ ⊤ (volume.restrict (ball (0 : Rn n) 1)) :=
      (hζ.continuous.memLp_of_hasCompactSupport hζc).restrict _
    -- `⟪v, ∫_B ζ • H⟫ = ∫_B ⟪H, ζ • v⟫` for `H ∈ L²(B)`.
    have hpair : ∀ H : Rn n → Rn n, MemLp H 2 (volume.restrict (ball (0 : Rn n) 1)) →
        ∀ v : Rn n, inner ℝ v (∫ x in ball (0 : Rn n) 1, ζ x • H x) =
          ∫ x in ball (0 : Rn n) 1, inner ℝ (H x) (ζ x • v) := by
      intro H hH v
      have hi : Integrable (fun x => ζ x • H x) (volume.restrict (ball (0 : Rn n) 1)) :=
        (hH.integrable one_le_two).smul_of_top_right hζtop
      have hcomm := (innerSL ℝ v).integral_comp_comm hi
      simp only [innerSL_apply_apply] at hcomm
      rw [← hcomm]
      refine integral_congr_ae (Eventually.of_forall fun x => ?_)
      simp only [real_inner_smul_right, real_inner_comm]
    refine ext_inner_left ℝ fun v => ?_
    have hh : MemLp (fun x => ζ x • v) 2 (volume.restrict (ball (0 : Rn n) 1)) :=
      ((hζ.continuous.smul continuous_const).memLp_of_hasCompactSupport
        (hζc.smul_right (f' := fun _ => v))).restrict _
    have hlimL := (tendsto_const_nhds (x := v)).inner (𝕜 := ℝ) (hLHS ζ hζ hζc)
    have hlimR : Tendsto (fun k => inner ℝ v (∫ x in ball (0 : Rn n) 1,
        (F (φ1 (φ2 k)) x - lam (φ1 (φ2 k))) • gradient ζ x)) atTop
        (𝓝 (-∫ x in ball (0 : Rn n) 1, inner ℝ (g x) (ζ x • v))) := by
      refine ((hgweak (fun x => ζ x • v) hh).neg).congr fun k => ?_
      rw [(hW12 (φ1 (φ2 k))).2.2 ζ hζ hζc hζB, inner_neg_right,
        hpair (G (φ1 (φ2 k))) (hFG (φ1 (φ2 k))).2.1 v]
    rw [tendsto_nhds_unique hlimL hlimR, inner_neg_right, hpair g hg2 v]
  -- Step 6: `w` is weakly harmonic, since the defect `≤ M/(k+1)` vanishes in the limit.
  have hharm0 : ∀ ζ : Rn n → ℝ, ContDiff ℝ (⊤ : ℕ∞) ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ ball 0 1 → ∫ x in ball (0 : Rn n) 1, inner ℝ (g x) (gradient ζ x) = 0 := by
    intro ζ hζ hζc hζB
    obtain ⟨M, hM⟩ := (hgradCont ζ hζ).bounded_above_of_compact_support (hgradSupp ζ hζc)
    have hgrad2 : MemLp (gradient ζ) 2 (volume.restrict (ball (0 : Rn n) 1)) :=
      ((hgradCont ζ hζ).memLp_of_hasCompactSupport (hgradSupp ζ hζc)).restrict _
    have hδ : Tendsto (fun k => 1 / ((φ1 (φ2 k) : ℝ) + 1) * M) atTop (𝓝 0) := by
      have := (tendsto_one_div_add_atTop_nhds_zero_nat.comp hψ).mul_const M
      rw [zero_mul] at this
      exact this
    have hzero : Tendsto (fun k => ∫ x in ball (0 : Rn n) 1,
        inner ℝ (G (φ1 (φ2 k)) x) (gradient ζ x)) atTop (𝓝 0) := by
      refine squeeze_zero_norm (fun k => ?_) hδ
      rw [Real.norm_eq_abs]
      exact hGδ (φ1 (φ2 k)) ζ hζ hζc hζB M hM
    exact tendsto_nhds_unique (hgweak (gradient ζ) hgrad2) hzero
  -- Step 7: Weyl's lemma, and the harmonic approximants `u₀ + lam k` contradict Step 1.
  obtain ⟨u0, hu0, hu0w, hu0g⟩ := hWeyl n hn w g hwW12 hharm0
  obtain ⟨k, hk⟩ := ((tendsto_order.1 hconv2).2 (ENNReal.ofReal ε)
    (ENNReal.ofReal_pos.2 hε)).exists
  have hharm : InnerProductSpace.HarmonicOnNhd (fun x => u0 x + lam (φ1 (φ2 k))) (ball 0 1) :=
    hu0.add (InnerProductSpace.harmonicOnNhd_const _)
  have henergy : ∫⁻ x in ball (0 : Rn n) 1,
      ‖gradient (fun x => u0 x + lam (φ1 (φ2 k))) x‖ₑ ^ 2 ≤ 1 := by
    have hgradu : ∀ x, gradient (fun x => u0 x + lam (φ1 (φ2 k))) x = gradient u0 x := by
      intro x
      simp only [gradient, fderiv_add_const]
    simp_rw [hgradu]
    calc ∫⁻ x in ball (0 : Rn n) 1, ‖gradient u0 x‖ₑ ^ 2
        = ∫⁻ x in ball (0 : Rn n) 1, ‖g x‖ₑ ^ 2 :=
          lintegral_congr_ae (hu0g.mono fun x hx => by dsimp only; rw [hx])
      _ ≤ 1 := hgle
  have hclose : ENNReal.ofReal ε < ∫⁻ x in ball (0 : Rn n) 1,
      ‖u0 x + lam (φ1 (φ2 k)) - F (φ1 (φ2 k)) x‖ₑ ^ 2 :=
    hFu (φ1 (φ2 k)) _ hharm henergy
  have heq : ∫⁻ x in ball (0 : Rn n) 1, ‖u0 x + lam (φ1 (φ2 k)) - F (φ1 (φ2 k)) x‖ₑ ^ 2 =
      ∫⁻ x in ball (0 : Rn n) 1, ‖F (φ1 (φ2 k)) x - lam (φ1 (φ2 k)) - w x‖ₑ ^ 2 := by
    refine lintegral_congr_ae (hu0w.mono fun x hx => ?_)
    dsimp only
    rw [hx, show w x + lam (φ1 (φ2 k)) - F (φ1 (φ2 k)) x =
      -(F (φ1 (φ2 k)) x - lam (φ1 (φ2 k)) - w x) by ring, enorm_neg]
  rw [heq] at hclose
  exact lt_irrefl _ (hclose.trans hk)

/-- **Hole measure of a Lipschitz graph** (Simon Ch. 5, proof of Lemma 2.6: the covering argument
after (10), with graph points far from `spt V` reached along a path).  Take `ε_h, δ_h, C_h` from the
hole estimate `lip_approx_hole_estimate` and put `ε = min{ε_h, 1}`, `δ₀ = min{δ_h, 1/8}`,
`C₀ = 2^{n/2} ω_n 16ⁿ C_h`.  With `σ₀ = δρ`, `μ = μ_V`, `τ(x) = |p_{T_x M} − p_{T₀}|²` and
`F̂ = q(graph f)` over `ℝⁿ`, the graph coordinates make `F̂` closed with the `ε`-cone property
relative to `T₀ = q(ℝⁿ × {0})`, and every `ζ ∈ Z = B_{σ₀/2}(0) ∩ (q(graph f|B_{σ₀/2}(0)) \ spt V)`
has `d(ζ) = dist(ζ, spt V) > 0`.
* If `d(ζ) > σ₀/16` for some `ζ ∈ Z`, the intermediate value theorem along `t ↦ q(t x_ζ, f(t x_ζ))`
  gives `ζ' ∈ F̂` with `|ζ'| ≤ 17σ₀/32` and `d(ζ') = σ₀/16`; the hole estimate at `ζ'` and the
  graph measure bound give `Hⁿ(Z) ≤ 2^{n/2} ω_n (σ₀/2)ⁿ ≤ C₀ [⋯]`.
* Otherwise the hole estimate at every `ζ ∈ Z` with `r(ζ) = 3d(ζ)/2 ≤ 3σ₀/32`, the graph measure
  bound on `B_{5r(ζ)}(ζ)` and the Vitali bound for `Ψ = μ ⌞ F̂ᶜ + τ μ` and `W = B_{3σ₀/4}(0)` give
  `Hⁿ(Z) ≤ 2^{n/2} ω_n 15ⁿ C_h Ψ(W) ≤ C₀ [⋯]`. -/
theorem lip_approx_graph_hole_measure : ∀ (n ℓ : ℕ), 1 ≤ n → ∀ p : ℝ, (n : ℝ) < p → ∃ ε δ₀ C₀ : ℝ, 0 < ε ∧ 0 < δ₀ ∧ 0 ≤ C₀ ∧ ∀ (U : Set (Amb n ℓ)), IsOpen U → ∀ (V : RectifiableVarifold n ℓ U) (H : Amb n ℓ → Amb n ℓ) (δ ρ : ℝ), 0 < δ → δ ≤ δ₀ → V.AllardHypotheses H p δ ρ → ∀ (q : Amb n ℓ ≃ₗᵢ[ℝ] Amb n ℓ) (f : Rn n → Rn ℓ), (∀ x z, ‖f x - f z‖ ≤ ε * ‖x - z‖) → (∀ x ∈ closedBall (0 : Rn n) (δ * ρ / 2), ‖f x‖ ≤ δ * ρ / 32) → (μHE[n] : Measure (Amb n ℓ)) (closedBall 0 (δ * ρ / 2) ∩ (q '' graphOver f (closedBall 0 (δ * ρ / 2)) \ V.support)) ≤ ENNReal.ofReal C₀ * (V.weight (closedBall 0 (3 * (δ * ρ) / 4) \ q '' graphOver f univ) + ENNReal.ofReal (∫ x in closedBall 0 (δ * ρ), hsNormSq (V.tangentProj x - (rotatedPlane q).starProjection) ∂V.weight)) := by
  -- Step 1 (a)–(d): geometry of `F̂ = q(graph f)` over `ℝⁿ`, from the graph coordinates.
  have graph_geometry : ∀ (n ℓ : ℕ) (q : Amb n ℓ ≃ₗᵢ[ℝ] Amb n ℓ) (f : Rn n → Rn ℓ) (ε : ℝ),
      0 ≤ ε → (∀ x z, ‖f x - f z‖ ≤ ε * ‖x - z‖) →
      (∀ (a a' : Rn n) (b b' : Rn ℓ),
        graphPoint a b - graphPoint a' b' = graphPoint (a - a') (b - b')) →
      (∀ (a : Rn n) (b : Rn ℓ), ‖graphPoint a b‖ ^ 2 = ‖a‖ ^ 2 + ‖b‖ ^ 2) →
      (∀ (a : Rn n) (b : Rn ℓ),
        (rotatedPlane q).starProjection (q (graphPoint a b)) = q (graphPoint a 0)) →
      Continuous (fun a : Rn n => q (graphPoint a (f a))) ∧ IsClosed (q '' graphOver f univ) ∧
      (∀ x ∈ q '' graphOver f univ, ∀ z ∈ q '' graphOver f univ,
        ‖(x - z) - (rotatedPlane q).starProjection (x - z)‖ ≤ ε * ‖x - z‖) ∧
      (∀ (a : Rn n) (t : ℝ), q '' graphOver f univ ∩ closedBall (q (graphPoint a (f a))) t ⊆
        q '' graphOver f (closedBall a t)) ∧
      ∀ (a : Rn n) (b : Rn ℓ), ‖q (graphPoint a b)‖ ≤ ‖a‖ + ‖b‖ := by
    intro n ℓ q f ε hε hf hi hii hiv
    set g : Rn n → Amb n ℓ := fun a => q (graphPoint a (f a)) with hg_def
    have hdiff : ∀ a a', g a - g a' = q (graphPoint (a - a') (f a - f a')) := by
      intro a a'
      simp only [hg_def, ← map_sub, hi]
    have hdist : ∀ a a', ‖g a - g a'‖ ^ 2 = ‖a - a'‖ ^ 2 + ‖f a - f a'‖ ^ 2 := by
      intro a a'
      rw [hdiff, LinearIsometryEquiv.norm_map, hii]
    -- `|a − a'| ≤ |g a − g a'| ≤ (1 + ε)|a − a'|`
    have hlow : ∀ a a', ‖a - a'‖ ≤ ‖g a - g a'‖ := by
      intro a a'
      have h := hdist a a'
      have h' : ‖a - a'‖ ^ 2 ≤ ‖g a - g a'‖ ^ 2 := by nlinarith [sq_nonneg ‖f a - f a'‖]
      exact (pow_le_pow_iff_left₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).mp h'
    have hup : ∀ a a', ‖g a - g a'‖ ≤ (1 + ε) * ‖a - a'‖ := by
      intro a a'
      have h1 := hdist a a'
      have h2 := hf a a'
      have hn1 := norm_nonneg (a - a')
      have hn2 := norm_nonneg (f a - f a')
      have h3 : ‖g a - g a'‖ ^ 2 ≤ ((1 + ε) * ‖a - a'‖) ^ 2 := by
        rw [h1]
        have : ‖f a - f a'‖ ^ 2 ≤ (ε * ‖a - a'‖) ^ 2 := pow_le_pow_left₀ hn2 h2 2
        nlinarith [mul_nonneg hε hn1]
      exact (pow_le_pow_iff_left₀ (norm_nonneg _) (by positivity) two_ne_zero).mp h3
    have hlip : LipschitzWith (Real.toNNReal (1 + ε)) g := by
      apply LipschitzWith.of_dist_le_mul
      intro a a'
      rw [dist_eq_norm, dist_eq_norm, Real.coe_toNNReal _ (by linarith)]
      exact hup a a'
    have hanti : AntilipschitzWith 1 g := by
      apply AntilipschitzWith.of_le_mul_dist
      intro a a'
      rw [dist_eq_norm, dist_eq_norm, NNReal.coe_one, one_mul]
      exact hlow a a'
    have hrange : q '' graphOver f univ = range g := by
      ext w
      simp only [graphOver, image_univ, mem_image, mem_range, hg_def]
      constructor
      · rintro ⟨_, ⟨a, rfl⟩, rfl⟩
        exact ⟨a, rfl⟩
      · rintro ⟨a, rfl⟩
        exact ⟨_, ⟨a, rfl⟩, rfl⟩
    have hmem : ∀ x ∈ q '' graphOver f univ, ∃ a, g a = x := by
      intro x hx
      rw [hrange] at hx
      exact hx
    refine ⟨hlip.continuous, ?_, ?_, ?_, ?_⟩
    · -- (a) `F̂` is the range of the antilipschitz map `g` on the complete space `ℝⁿ`.
      rw [hrange]
      exact hanti.isClosed_range hlip.uniformContinuous
    · -- (b) the `ε`-cone property: `(x − z) − P(x − z) = q(0, f a − f a')`.
      intro x hx z hz
      obtain ⟨a, rfl⟩ := hmem x hx
      obtain ⟨a', rfl⟩ := hmem z hz
      have hP : (rotatedPlane q).starProjection (g a - g a') = q (graphPoint (a - a') 0) := by
        rw [hdiff, hiv]
      have hQ : (g a - g a') - (rotatedPlane q).starProjection (g a - g a') =
          q (graphPoint 0 (f a - f a')) := by
        rw [hP, hdiff, ← map_sub, hi, sub_self, sub_zero]
      have hnQ : ‖q (graphPoint (0 : Rn n) (f a - f a'))‖ = ‖f a - f a'‖ := by
        rw [LinearIsometryEquiv.norm_map]
        have h := hii 0 (f a - f a')
        rw [norm_zero] at h
        have h' : ‖graphPoint (0 : Rn n) (f a - f a')‖ ^ 2 = ‖f a - f a'‖ ^ 2 := by rw [h]; ring
        exact (pow_left_inj₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).mp h'
      rw [hQ, hnQ]
      calc ‖f a - f a'‖ ≤ ε * ‖a - a'‖ := hf a a'
        _ ≤ ε * ‖g a - g a'‖ := mul_le_mul_of_nonneg_left (hlow a a') hε
    · -- (c) `F̂ ∩ B_t(g a) ⊆ q(graph f|B_t(a))`, since `|a'' − a| ≤ |g a'' − g a|`.
      intro a t x hx
      obtain ⟨a'', rfl⟩ := hmem x hx.1
      have hd : ‖a'' - a‖ ≤ t := (hlow a'' a).trans (by rw [← dist_eq_norm]; exact hx.2)
      exact ⟨graphPoint a'' (f a''),
        ⟨a'', by rw [mem_closedBall, dist_eq_norm]; exact hd, rfl⟩, rfl⟩
    · -- (d) `|q(a, b)| ≤ |a| + |b|`.
      intro a b
      rw [LinearIsometryEquiv.norm_map]
      have h := hii a b
      have hab : ‖graphPoint a b‖ ^ 2 ≤ (‖a‖ + ‖b‖) ^ 2 := by
        rw [h]; nlinarith [norm_nonneg a, norm_nonneg b]
      exact (pow_le_pow_iff_left₀ (norm_nonneg _) (by positivity) two_ne_zero).mp hab
  -- Step 3 (path point): along `t ↦ q(t x, f(t x))` the distance to `S` passes through `d`.
  have path_point : ∀ (n ℓ : ℕ) (q : Amb n ℓ ≃ₗᵢ[ℝ] Amb n ℓ) (f : Rn n → Rn ℓ),
      Continuous (fun a : Rn n => q (graphPoint a (f a))) →
      (∀ (a : Rn n) (b : Rn ℓ), ‖q (graphPoint a b)‖ ≤ ‖a‖ + ‖b‖) →
      ∀ (S : Set (Amb n ℓ)), (0 : Amb n ℓ) ∈ S → ∀ (R c d : ℝ),
      (∀ a ∈ closedBall (0 : Rn n) R, ‖f a‖ ≤ c) → c ≤ d →
      ∀ x ∈ closedBall (0 : Rn n) R, d ≤ infDist (q (graphPoint x (f x))) S →
      ∃ a ∈ closedBall (0 : Rn n) R,
        infDist (q (graphPoint a (f a))) S = d ∧ ‖q (graphPoint a (f a))‖ ≤ R + c := by
    intro n ℓ q f hg hnorm S hS R c d hfc hcd x hx hd
    have hxR : ‖x‖ ≤ R := mem_closedBall_zero_iff.mp hx
    have hR : 0 ≤ R := (norm_nonneg x).trans hxR
    have hseg : ∀ t ∈ Icc (0 : ℝ) 1, t • x ∈ closedBall (0 : Rn n) R := by
      intro t ht
      rw [mem_closedBall_zero_iff, norm_smul, Real.norm_eq_abs, abs_of_nonneg ht.1]
      calc t * ‖x‖ ≤ 1 * ‖x‖ := mul_le_mul_of_nonneg_right ht.2 (norm_nonneg _)
        _ = ‖x‖ := one_mul _
        _ ≤ R := hxR
    have hcont : Continuous (fun t : ℝ => infDist (q (graphPoint (t • x) (f (t • x)))) S) :=
      (continuous_infDist_pt S).comp (hg.comp (continuous_id.smul continuous_const))
    have h0 : infDist (q (graphPoint ((0 : ℝ) • x) (f ((0 : ℝ) • x)))) S ≤ d := by
      rw [zero_smul]
      calc infDist (q (graphPoint (0 : Rn n) (f 0))) S ≤ dist (q (graphPoint (0 : Rn n) (f 0))) 0 :=
            infDist_le_dist_of_mem hS
        _ = ‖q (graphPoint (0 : Rn n) (f 0))‖ := dist_zero_right _
        _ ≤ ‖(0 : Rn n)‖ + ‖f 0‖ := hnorm 0 (f 0)
        _ ≤ c := by rw [norm_zero, zero_add]; exact hfc 0 (mem_closedBall_self hR)
        _ ≤ d := hcd
    have h1 : d ≤ infDist (q (graphPoint ((1 : ℝ) • x) (f ((1 : ℝ) • x)))) S := by
      rw [one_smul]; exact hd
    obtain ⟨t, ht, hteq⟩ := intermediate_value_Icc zero_le_one hcont.continuousOn ⟨h0, h1⟩
    refine ⟨t • x, hseg t ht, hteq, ?_⟩
    calc ‖q (graphPoint (t • x) (f (t • x)))‖ ≤ ‖t • x‖ + ‖f (t • x)‖ := hnorm _ _
      _ ≤ R + c := add_le_add (mem_closedBall_zero_iff.mp (hseg t ht)) (hfc _ (hseg t ht))
  -- Constants: `ε = min{ε_h, 1}`, `δ₀ = min{δ_h, 1/8}`, `C₀ = 2^{n/2} ω_n 16ⁿ C_h`.
  intro n ℓ hn p hp
  obtain ⟨εh, δh, Ch, hεh, hδh, hCh, hhole⟩ := lip_approx_hole_estimate n ℓ hn p hp
  have hω : 0 < unitBallVolume n := by
    unfold unitBallVolume
    exact div_pos (Real.rpow_pos_of_pos Real.pi_pos _) (Real.Gamma_pos_of_pos (by positivity))
  set K : ℝ := 2 ^ ((n : ℝ) / 2) * unitBallVolume n
  have hK : 0 ≤ K := by positivity
  refine ⟨min εh 1, min δh (1 / 8), K * 16 ^ n * Ch, lt_min hεh one_pos, lt_min hδh (by norm_num),
    by positivity, ?_⟩
  intro U hU V H δ ρ hδ hδ₀ hA q f hf hfb
  have hA' := hA
  unfold RectifiableVarifold.AllardHypotheses at hA'
  obtain ⟨hρ, -, -, h0, hρU, -, -⟩ := hA'
  have hδ8 : δ ≤ 1 / 8 := le_trans hδ₀ (min_le_right _ _)
  have hδh' : δ ≤ δh := le_trans hδ₀ (min_le_left _ _)
  set σ : ℝ := δ * ρ with hσ_def
  have hσ : 0 < σ := mul_pos hδ hρ
  have hσρ : σ ≤ ρ := by
    have : δ * ρ ≤ 1 / 8 * ρ := mul_le_mul_of_nonneg_right hδ8 hρ.le
    linarith
  set μ := V.weight
  set P := (rotatedPlane q).starProjection
  set τ : Amb n ℓ → ℝ := fun x => hsNormSq (V.tangentProj x - P) with hτ_def
  have hτ : ∀ x, 0 ≤ τ x := by
    intro x
    simp only [hτ_def, hsNormSq]
    positivity
  -- `τ` is integrable on closed balls in `B_ρ(0) ⊆ U` (tangent structure), so the tilt over any
  -- ball inside `B_{σ₀}(0)` is at most `I = ∫_{B_{σ₀}(0)} τ dμ`.
  obtain ⟨-, hint, -⟩ := lip_approx_tangent_structure n ℓ hn U hU V
  have hintB : ∀ (c : Amb n ℓ) (r : ℝ), closedBall c r ⊆ closedBall 0 ρ →
      IntegrableOn τ (closedBall c r) μ :=
    fun c r h => hint (rotatedPlane q) _ (isCompact_closedBall c r) (h.trans hρU)
  set I : ℝ := ∫ x in closedBall 0 σ, τ x ∂μ
  have hImono : ∀ (c : Amb n ℓ) (r : ℝ), closedBall c r ⊆ closedBall 0 σ →
      ∫ x in closedBall c r, τ x ∂μ ≤ I := by
    intro c r h
    exact setIntegral_mono_set (hintB 0 σ (closedBall_subset_closedBall hσρ))
      (ae_of_all _ hτ) (LE.le.eventuallySubset h)
  -- Step 1: `F̂` is closed with the `ε_h`-cone property, and `f` is `1`-Lipschitz.
  set ε := min εh 1
  have hε0 : 0 ≤ ε := (lt_min hεh one_pos).le
  have hεh' : ε ≤ εh := min_le_left _ _
  have hε1 : ε ≤ 1 := min_le_right _ _
  obtain ⟨gi, gii, -, giv⟩ := lip_approx_graph_coordinates n ℓ q
  obtain ⟨gcont, gclosed, gcone, gloc, gnorm⟩ := graph_geometry n ℓ q f ε hε0 hf gi gii giv
  set Fhat := q '' graphOver f univ
  have hcone_h : ∀ x ∈ Fhat, ∀ z ∈ Fhat, ‖(x - z) - P (x - z)‖ ≤ εh * ‖x - z‖ :=
    fun x hx z hz => (gcone x hx z hz).trans (mul_le_mul_of_nonneg_right hεh' (norm_nonneg _))
  have hf1 : ∀ x z, ‖f x - f z‖ ≤ ‖x - z‖ :=
    fun x z => (hf x z).trans (mul_le_of_le_one_left (norm_nonneg _) hε1)
  have hmemF : ∀ a : Rn n, q (graphPoint a (f a)) ∈ Fhat :=
    fun a => ⟨graphPoint a (f a), ⟨a, mem_univ _, rfl⟩, rfl⟩
  -- Step 2: the hole set `Z` and `d(ζ) = dist(ζ, spt V) > 0` on it.
  set F := q '' graphOver f (closedBall 0 (σ / 2))
  set Z := closedBall (0 : Amb n ℓ) (σ / 2) ∩ (F \ V.support)
  have hZF : ∀ ζ ∈ Z, ∃ a ∈ closedBall (0 : Rn n) (σ / 2), q (graphPoint a (f a)) = ζ := by
    intro ζ hζ
    obtain ⟨w, ⟨a, ha, hw⟩, hqw⟩ := hζ.2.1
    exact ⟨a, ha, by subst hw; exact hqw⟩
  have hZpos : ∀ ζ ∈ Z, 0 < infDist ζ V.support := by
    intro ζ hζ
    have hζU : ζ ∈ U := hρU (closedBall_subset_closedBall (by linarith) hζ.1)
    have hsub : V.support ⊆ V.weight.support := fun x hx => hx.2
    have hζ' : ζ ∉ V.weight.support := fun h => hζ.2.2 ⟨hζU, h⟩
    have hne : V.support.Nonempty := ⟨0, h0⟩
    have hpos : 0 < infDist ζ V.weight.support :=
      (infDist_pos_iff_notMem_closure (hne.mono hsub)).mp
        (by rwa [Measure.isClosed_support.closure_eq])
    exact hpos.trans_le (infDist_le_infDist_of_subset hsub hne)
  by_cases hfar : ∃ ζ ∈ Z, σ / 16 < infDist ζ V.support
  · -- Step 3 (far case): a path point at distance exactly `σ₀/16` and one hole estimate.
    obtain ⟨ζ, hζZ, hζfar⟩ := hfar
    obtain ⟨x, hx, hxζ⟩ := hZF ζ hζZ
    obtain ⟨a, ha, hda, hna⟩ := path_point n ℓ q f gcont gnorm V.support h0
      (σ / 2) (σ / 32) (σ / 16) hfb (by linarith) x hx (by rw [hxζ]; exact hζfar.le)
    have hhn : ‖q (graphPoint a (f a))‖ ≤ 17 * σ / 32 := by linarith
    have hh := hhole U hU V H δ ρ hδ hδh' hA (rotatedPlane q) Fhat gclosed hcone_h
      (q (graphPoint a (f a))) (hmemF a) hhn (by rw [hda]; positivity) (by rw [hda])
    rw [hda] at hh
    have hsub1 : closedBall (q (graphPoint a (f a))) (3 * (σ / 16 / 2)) ⊆
        closedBall 0 (3 * σ / 4) := by
      apply closedBall_subset_closedBall'
      rw [dist_zero_right]
      linarith
    have hsub2 : closedBall (q (graphPoint a (f a))) (3 * (σ / 16 / 2)) ⊆ closedBall 0 σ := by
      apply closedBall_subset_closedBall'
      rw [dist_zero_right]
      linarith
    have hgm := lip_approx_graph_measure n ℓ hn q f hf1 0 (σ / 2) (by positivity)
    calc (μHE[n] : Measure (Amb n ℓ)) Z ≤ (μHE[n] : Measure (Amb n ℓ)) F :=
          measure_mono (fun y hy => hy.2.1)
      _ ≤ ENNReal.ofReal (K * (σ / 2) ^ n) := hgm
      _ = ENNReal.ofReal (K * 16 ^ n) * ENNReal.ofReal ((σ / 16 / 2) ^ n) := by
          rw [← ENNReal.ofReal_mul (by positivity)]
          congr 1
          rw [show σ / 2 = 16 * (σ / 16 / 2) by ring, mul_pow]
          ring
      _ ≤ ENNReal.ofReal (K * 16 ^ n) * (ENNReal.ofReal Ch *
            (μ (closedBall (q (graphPoint a (f a))) (3 * (σ / 16 / 2)) \ Fhat) +
              ENNReal.ofReal
                (∫ x in closedBall (q (graphPoint a (f a))) (3 * (σ / 16 / 2)), τ x ∂μ))) := by
          gcongr
      _ ≤ ENNReal.ofReal (K * 16 ^ n) * (ENNReal.ofReal Ch *
            (μ (closedBall 0 (3 * σ / 4) \ Fhat) + ENNReal.ofReal I)) := by
          have h2 := hImono _ _ hsub2
          gcongr
      _ = ENNReal.ofReal (K * 16 ^ n * Ch) *
            (μ (closedBall 0 (3 * σ / 4) \ Fhat) + ENNReal.ofReal I) := by
          rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
  · -- Step 4 (near case): hole estimates at every `ζ ∈ Z` and the Vitali bound.
    push Not at hfar
    set W := closedBall (0 : Amb n ℓ) (3 * σ / 4)
    set Ψ : Measure (Amb n ℓ) := μ.restrict Fhatᶜ + μ.withDensity (fun x => ENNReal.ofReal (τ x))
      with hΨ_def
    have hΨapp : ∀ B : Set (Amb n ℓ), MeasurableSet B → IntegrableOn τ B μ →
        Ψ B = μ (B \ Fhat) + ENNReal.ofReal (∫ x in B, τ x ∂μ) := by
      intro B hB hintB'
      rw [hΨ_def, Measure.add_apply, Measure.restrict_apply hB, withDensity_apply _ hB, ← sdiff_eq,
        ofReal_integral_eq_lintegral_ofReal hintB' (ae_of_all _ hτ)]
    set r : Amb n ℓ → ℝ := fun y => 3 * (infDist y V.support / 2) with hr_def
    set M : ℝ≥0∞ := ENNReal.ofReal (K * 15 ^ n * Ch) with hM_def
    have hv := lip_approx_vitali_bound (n + ℓ) (μHE[n] : Measure (Amb n ℓ)) Ψ Z W r (3 * σ / 32)
      M ?_
    · -- Step 5: `Ψ(W) = μ(W \ F̂) + ∫_W τ dμ` and `M ≤ C₀`.
      have hWρ : W ⊆ closedBall 0 ρ := closedBall_subset_closedBall (by linarith)
      have hΨW : Ψ W = μ (W \ Fhat) + ENNReal.ofReal (∫ x in W, τ x ∂μ) :=
        hΨapp W measurableSet_closedBall (hintB 0 _ hWρ)
      calc (μHE[n] : Measure (Amb n ℓ)) Z ≤ M * Ψ W := hv
        _ = M * (μ (W \ Fhat) + ENNReal.ofReal (∫ x in W, τ x ∂μ)) := by rw [hΨW]
        _ ≤ ENNReal.ofReal (K * 16 ^ n * Ch) * (μ (W \ Fhat) + ENNReal.ofReal I) := by
          gcongr
          · rw [hM_def]
            apply ENNReal.ofReal_le_ofReal
            gcongr
            norm_num
          · exact hImono _ _ (closedBall_subset_closedBall (by linarith))
    · intro y hy
      have hd0 := hZpos y hy
      have hd1 := hfar y hy
      have hyn : dist y 0 ≤ σ / 2 := hy.1
      obtain ⟨a, ha, hay⟩ := hZF y hy
      refine ⟨by simp only [hr_def]; positivity, by simp only [hr_def]; linarith, ?_, ?_⟩
      · apply closedBall_subset_closedBall'
        simp only [hr_def]
        linarith
      · have hball : closedBall y (r y) ⊆ closedBall 0 ρ := by
          apply closedBall_subset_closedBall'
          simp only [hr_def]
          linarith
        have hΨy : Ψ (closedBall y (r y)) = μ (closedBall y (r y) \ Fhat) +
            ENNReal.ofReal (∫ x in closedBall y (r y), τ x ∂μ) :=
          hΨapp _ measurableSet_closedBall (hintB y _ hball)
        have hyF : y ∈ Fhat := by rw [← hay]; exact hmemF a
        have hhy := hhole U hU V H δ ρ hδ hδh' hA (rotatedPlane q) Fhat gclosed hcone_h
          y hyF (by have := mem_closedBall_zero_iff.mp hy.1; linarith [hσ_def]) hd0
          (by linarith [hσ_def])
        -- `Z ∩ B_{5r}(y) ⊆ F̂ ∩ B_{5r}(q(a, f a)) ⊆ q(graph f|B_{5r}(a))`
        have hsubZ : Z ∩ closedBall y (5 * r y) ⊆ q '' graphOver f (closedBall a (5 * r y)) := by
          intro w hw
          have hwF : w ∈ Fhat := image_mono (image_mono (subset_univ _)) hw.1.2.1
          exact gloc a (5 * r y) ⟨hwF, by rw [hay]; exact hw.2⟩
        have hgm := lip_approx_graph_measure n ℓ hn q f hf1 a (5 * r y)
          (by simp only [hr_def]; positivity)
        calc (μHE[n] : Measure (Amb n ℓ)) (Z ∩ closedBall y (5 * r y))
            ≤ (μHE[n] : Measure (Amb n ℓ)) (q '' graphOver f (closedBall a (5 * r y))) :=
              measure_mono hsubZ
          _ ≤ ENNReal.ofReal (K * (5 * r y) ^ n) := hgm
          _ = ENNReal.ofReal (K * 15 ^ n) * ENNReal.ofReal ((infDist y V.support / 2) ^ n) := by
              rw [← ENNReal.ofReal_mul (by positivity)]
              congr 1
              simp only [hr_def]
              rw [show 5 * (3 * (infDist y V.support / 2)) = 15 * (infDist y V.support / 2) by ring,
                mul_pow]
              ring
          _ ≤ ENNReal.ofReal (K * 15 ^ n) * (ENNReal.ofReal Ch *
                (μ (closedBall y (3 * (infDist y V.support / 2)) \ Fhat) +
                  ENNReal.ofReal
                    (∫ x in closedBall y (3 * (infDist y V.support / 2)), τ x ∂μ))) := by
              gcongr
          _ = M * Ψ (closedBall y (r y)) := by
              rw [hΨy, hM_def, ← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]

end Submission

/-- **Simon Ch. 5, Lemma 2.6 (Lipschitz Approximation Lemma).**  Steps A1–A11 of the accepted
decomposition.  If the tilt of `T₀ = q(ℝⁿ × {0})` on `B_{σ₀}(0)` exceeds `β²L²σ₀ⁿ`, then `f = 0`
works (pinched density and `lip_approx_graph_measure`).  Otherwise the good set `G` is a graph over
`T₀` with Lipschitz constant `2C₈βL` (`lip_approx_good_set_flat`, with the sibling
`affine_approximation_lemma`); `f` is its bounded extension, and the two error terms are bounded by
`lip_approx_good_set_complement` and `lip_approx_graph_hole_measure`. -/
theorem Submission.lipschitz_approximation_lemma : LipschitzApproximationLemma := by
  intro n ℓ hn p hp
  obtain ⟨δP, hδP, -, hPD⟩ := Submission.lip_approx_pinched_density n ℓ hn p hp
  obtain ⟨δ₇, C₇, hδ₇, hC₇, hGC⟩ := Submission.lip_approx_good_set_complement n ℓ hn p hp
  obtain ⟨C₈, δ₈, hC₈, hδ₈, hGF⟩ :=
    Submission.lip_approx_good_set_flat Submission.affine_approximation_lemma n ℓ hn p hp
  obtain ⟨ε₁₀, δ₁₀, C₁₀, hε₁₀, hδ₁₀, hC₁₀, hGH⟩ :=
    Submission.lip_approx_graph_hole_measure n ℓ hn p hp
  have hω : 0 < unitBallVolume n :=
    div_pos (Real.rpow_pos_of_pos Real.pi_pos _) (Real.Gamma_pos_of_pos (by positivity))
  -- A1: the choice of `β`
  obtain ⟨β, hβ0, hβ4, hβD, hβC₈, hβc⟩ : ∃ β : ℝ, 0 < β ∧ β ≤ 1 / 4 ∧
      β ≤ min (min δP δ₇) (min δ₈ δ₁₀) ∧ C₈ * β ≤ 1 / 32 ∧
      2 * Real.sqrt ℓ * C₈ * β ≤ min 1 ε₁₀ := by
    have hc : 0 ≤ 2 * Real.sqrt ℓ * C₈ := by positivity
    have hm : 0 < min 1 ε₁₀ := lt_min one_pos hε₁₀
    obtain ⟨β, hβ0, hβ1, hβ2, hβ3⟩ : ∃ β : ℝ, 0 < β ∧
        β ≤ min (1 / 4) (min (min δP δ₇) (min δ₈ δ₁₀)) ∧ β ≤ 1 / (32 * C₈) ∧
        β ≤ min 1 ε₁₀ / (2 * Real.sqrt ℓ * C₈ + 1) :=
      ⟨min (min (1 / 4) (min (min δP δ₇) (min δ₈ δ₁₀)))
          (min (1 / (32 * C₈)) (min 1 ε₁₀ / (2 * Real.sqrt ℓ * C₈ + 1))),
        lt_min (lt_min (by norm_num) (lt_min (lt_min hδP hδ₇) (lt_min hδ₈ hδ₁₀)))
          (lt_min (by positivity) (by positivity)),
        min_le_left _ _, (min_le_right _ _).trans (min_le_left _ _),
        (min_le_right _ _).trans (min_le_right _ _)⟩
    refine ⟨β, hβ0, hβ1.trans (min_le_left _ _), hβ1.trans (min_le_right _ _), ?_, ?_⟩
    · have h' := (le_div_iff₀ (by positivity)).1 hβ2
      linarith
    · have h' := (le_div_iff₀ (by positivity)).1 hβ3
      linarith
  refine ⟨β, max ((2 * unitBallVolume n + 2 ^ ((n : ℝ) / 2) * unitBallVolume n) / β ^ 2)
    ((1 + C₁₀) * (C₇ / β ^ 2) + C₁₀), hβ0, hβ4, ?_⟩
  intro L K hL hL1 hK U hU V H δ ρ hδ hδβL hAll q hK'
  have hρ : 0 < ρ := hAll.1
  have hσ : 0 < δ * ρ := mul_pos hδ hρ
  -- A2: `δ ≤ β` gives every smallness threshold
  have hδβ : δ ≤ β := by
    have h1 : β * L ≤ β := mul_le_of_le_one_right hβ0.le hL1
    have h2 : (β * L) ^ (2 * n + 2) ≤ β * L :=
      pow_le_of_le_one (by positivity) (h1.trans (by linarith)) (by omega)
    linarith
  have hδP' : δ ≤ δP := hδβ.trans (hβD.trans ((min_le_left _ _).trans (min_le_left _ _)))
  have hδ₇' : δ ≤ δ₇ := hδβ.trans (hβD.trans ((min_le_left _ _).trans (min_le_right _ _)))
  have hδ₈' : δ ≤ δ₈ := hδβ.trans (hβD.trans ((min_le_right _ _).trans (min_le_left _ _)))
  have hδ₁₀' : δ ≤ δ₁₀ := hδβ.trans (hβD.trans ((min_le_right _ _).trans (min_le_right _ _)))
  have hδ1 : δ ≤ 1 := by linarith
  set tilt : ℝ := ∫ x in closedBall 0 (δ * ρ),
    hsNormSq (V.tangentProj x - (rotatedPlane q).starProjection) ∂V.weight with htilt
  have ht0 : 0 ≤ tilt := integral_nonneg fun x => Finset.sum_nonneg fun i _ => sq_nonneg _
  have hu1 : 1 ≤ (L ^ 2)⁻¹ := (one_le_inv₀ (by positivity)).2 (pow_le_one₀ hL.le hL1)
  by_cases hB : tilt ≤ β ^ 2 * L ^ 2 * (δ * ρ) ^ n
  · -- Case B (A4–A11)
    obtain ⟨hH, hFlat⟩ := hGF β L hβ0 hL hL1 U hU V H δ ρ hδ hδ₈' hδβL hAll q hB
    obtain ⟨hsub, hnorm, hsurj, hproj⟩ := Submission.lip_approx_graph_coordinates n ℓ q
    -- A5: coordinates `y = q (graphPoint (a y) (b y))`
    have hsurj' : ∀ y : Amb n ℓ, ∃ (u : Rn n) (v : Rn ℓ), y = q (graphPoint u v) := by
      intro y
      obtain ⟨u, v, h⟩ := hsurj (q.symm y)
      exact ⟨u, v, by rw [← h, LinearIsometryEquiv.apply_symm_apply]⟩
    choose a b hab using hsurj'
    have hgp0 : ∀ v : Rn ℓ, ‖graphPoint (0 : Rn n) v‖ = ‖v‖ := fun v =>
      (pow_left_inj₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).1 (by simpa using hnorm 0 v)
    have hQy : ∀ y, y - (rotatedPlane q).starProjection y = q (graphPoint 0 (b y)) := by
      intro y
      calc y - (rotatedPlane q).starProjection y
          = q (graphPoint (a y) (b y)) -
              (rotatedPlane q).starProjection (q (graphPoint (a y) (b y))) := by rw [← hab y]
        _ = q (graphPoint (a y) (b y)) - q (graphPoint (a y) 0) := by rw [hproj]
        _ = q (graphPoint (a y) (b y) - graphPoint (a y) 0) := (q.map_sub _ _).symm
        _ = q (graphPoint 0 (b y)) := by rw [hsub, sub_self, sub_zero]
    have hQdiff : ∀ y z, (y - z) - (rotatedPlane q).starProjection (y - z) =
        q (graphPoint 0 (b y - b z)) := by
      intro y z
      rw [map_sub, sub_sub_sub_comm, hQy, hQy, ← q.map_sub, hsub, sub_self]
    have hnormy : ∀ y, ‖y‖ ^ 2 = ‖a y‖ ^ 2 + ‖b y‖ ^ 2 := by
      intro y
      calc ‖y‖ ^ 2 = ‖q (graphPoint (a y) (b y))‖ ^ 2 := by rw [← hab y]
        _ = ‖a y‖ ^ 2 + ‖b y‖ ^ 2 := by rw [q.norm_map, hnorm]
    have hnormdiff : ∀ y z, ‖y - z‖ ^ 2 = ‖a y - a z‖ ^ 2 + ‖b y - b z‖ ^ 2 := by
      intro y z
      have hyz : y - z = q (graphPoint (a y - a z) (b y - b z)) := by
        rw [← hsub, q.map_sub, ← hab y, ← hab z]
      rw [hyz, q.norm_map, hnorm]
    have hbdist : ∀ y, infDist y (rotatedPlane q : Set (Amb n ℓ)) = ‖b y‖ := by
      intro y
      rw [← (rotatedPlane q).dist_starProjection_eq_infDist y, dist_eq_norm, hQy y, q.norm_map,
        hgp0]
    -- the good set `G` of A4 and its part `Gb` in `B_{3σ₀/4}(0)`
    set G : Set (Amb n ℓ) := {y | y ∈ V.support ∧ ∀ s : ℝ, 0 < s → s ≤ δ * ρ / 2 →
      ∫ x in closedBall y (s / 2), hsNormSq (V.tangentProj x - (rotatedPlane q).starProjection)
        ∂V.weight ≤ β ^ 2 * L ^ 2 * s ^ n}
    set Gb : Set (Amb n ℓ) := G ∩ closedBall 0 (3 * (δ * ρ) / 4)
    have hκ0 : 0 ≤ C₈ * β * L := by positivity
    have hκ : C₈ * β * L ≤ 1 / 32 := by
      have : C₈ * β * L ≤ C₈ * β := mul_le_of_le_one_right (by positivity) hL1
      linarith
    -- A6: `b` is a `2 C₈ β L`-Lipschitz function of `a` on `Gb`
    have hLipG : ∀ y₁ ∈ Gb, ∀ y₂ ∈ Gb, ‖b y₁ - b y₂‖ ≤ 2 * (C₈ * β * L) * ‖a y₁ - a y₂‖ := by
      rintro y₁ ⟨⟨hy₁s, hy₁g⟩, hy₁b⟩ y₂ ⟨⟨hy₂s, -⟩, hy₂b⟩
      have h1 := hFlat y₁ ⟨hy₁s, hy₁b⟩ y₂ ⟨hy₂s, hy₂b⟩ hy₁g
      rw [hQdiff, q.norm_map, hgp0] at h1
      have hA := norm_nonneg (a y₂ - a y₁)
      have hB' := norm_nonneg (b y₂ - b y₁)
      have hX := norm_nonneg (y₂ - y₁)
      have h2 : ‖y₂ - y₁‖ ≤ ‖a y₂ - a y₁‖ + ‖b y₂ - b y₁‖ := by
        have h := hnormdiff y₂ y₁
        exact (pow_le_pow_iff_left₀ hX (by positivity) two_ne_zero).1
          (by rw [add_sq]; linarith [mul_nonneg hA hB'])
      rw [norm_sub_rev (b y₁), norm_sub_rev (a y₁)]
      linarith [mul_le_mul_of_nonneg_left h2 hκ0,
        mul_nonneg (by linarith : (0 : ℝ) ≤ 1 - 2 * (C₈ * β * L)) hB']
    let g : Rn n → Rn ℓ := fun x => b (Classical.epsilon fun y => y ∈ Gb ∧ a y = x)
    have hgval : ∀ y ∈ Gb, g (a y) = b y := by
      intro y hy
      obtain ⟨hy'G, hy'a⟩ : Classical.epsilon (fun y' => y' ∈ Gb ∧ a y' = a y) ∈ Gb ∧
          a (Classical.epsilon fun y' => y' ∈ Gb ∧ a y' = a y) = a y :=
        Classical.epsilon_spec (p := fun y' => y' ∈ Gb ∧ a y' = a y) ⟨y, hy, rfl⟩
      have h' := hLipG _ hy'G y hy
      rw [hy'a, sub_self, norm_zero, mul_zero] at h'
      exact sub_eq_zero.1 (norm_le_zero_iff.1 h')
    have hgLip : ∀ x ∈ a '' Gb, ∀ z ∈ a '' Gb,
        ‖g x - g z‖ ≤ 2 * (C₈ * β * L) * ‖x - z‖ := by
      rintro _ ⟨y₁, hy₁, rfl⟩ _ ⟨y₂, hy₂, rfl⟩
      rw [hgval y₁ hy₁, hgval y₂ hy₂]
      exact hLipG y₁ hy₁ y₂ hy₂
    have hR₀ : 0 ≤ min (K * δ ^ (1 / (2 * (n : ℝ) + 2)) * (δ * ρ)) (C₈ * β * L * (δ * ρ)) :=
      le_min (by positivity) (by positivity)
    have hgbd : ∀ x ∈ a '' Gb,
        ‖g x‖ ≤ min (K * δ ^ (1 / (2 * (n : ℝ) + 2)) * (δ * ρ)) (C₈ * β * L * (δ * ρ)) := by
      rintro _ ⟨y, hy, rfl⟩
      rw [hgval y hy, ← hbdist y]
      have hy2 : y ∈ V.support ∩ closedBall 0 (2 * (δ * ρ)) := by
        refine ⟨hy.1.1, ?_⟩
        have := hy.2
        rw [mem_closedBall] at this ⊢
        linarith
      exact le_min (hK' y hy2) (hH y hy2)
    -- A7: the extension `f`
    obtain ⟨f, hfg, hfLip, hfbd⟩ := Submission.lip_approx_bounded_extension n ℓ (a '' Gb) g
      (2 * (C₈ * β * L)) _ (by positivity) hR₀ hgLip hgbd
    have hcL : 2 * Real.sqrt ℓ * C₈ * β * L ≤ min 1 ε₁₀ * L :=
      mul_le_mul_of_nonneg_right hβc hL.le
    have hcL1 : 2 * Real.sqrt ℓ * C₈ * β * L ≤ L :=
      hcL.trans (mul_le_of_le_one_left hL.le (min_le_left _ _))
    have hcLε : 2 * Real.sqrt ℓ * C₈ * β * L ≤ ε₁₀ :=
      hcL.trans ((mul_le_of_le_one_right (le_min zero_le_one hε₁₀.le) hL1).trans
        (min_le_right _ _))
    have hfLip' : ∀ x z, ‖f x - f z‖ ≤ 2 * Real.sqrt ℓ * C₈ * β * L * ‖x - z‖ := by
      intro x z
      calc ‖f x - f z‖ ≤ Real.sqrt ℓ * (2 * (C₈ * β * L)) * ‖x - z‖ := hfLip x z
        _ = 2 * Real.sqrt ℓ * C₈ * β * L * ‖x - z‖ := by ring
    -- A8: `Gb` lies on the graph of `f`
    have hfa : ∀ y ∈ Gb, f (a y) = b y := fun y hy => (hfg _ ⟨y, hy, rfl⟩).trans (hgval y hy)
    have hGbF : ∀ y ∈ Gb, y = q (graphPoint (a y) (f (a y))) := by
      intro y hy
      rw [hfa y hy]
      exact hab y
    refine ⟨f, ?_, fun x _ => (hfbd x).trans (min_le_left _ _), ?_⟩
    · refine LipschitzOnWith.of_dist_le' fun x _ z _ => ?_
      rw [dist_eq_norm, dist_eq_norm]
      calc ‖f x - f z‖ ≤ 2 * Real.sqrt ℓ * C₈ * β * L * ‖x - z‖ := hfLip' x z
        _ ≤ L * ‖x - z‖ := mul_le_mul_of_nonneg_right hcL1 (norm_nonneg _)
    · -- A9: the first error term
      have hb0 : 0 < β ^ 2 * L ^ 2 := by positivity
      have hC7 := hGC U hU V H δ ρ hδ hδ₇' hAll (rotatedPlane q) (β ^ 2 * L ^ 2) hb0
      rw [← htilt] at hC7
      have hT1 : V.weight (closedBall 0 (δ * ρ / 2) ∩
          (V.support \ q '' graphOver f (closedBall 0 (δ * ρ / 2)))) ≤
            V.weight (closedBall 0 (3 * (δ * ρ) / 4) \ G) := by
        apply measure_mono
        rintro y ⟨hyb, -, hyF⟩
        have hyb' : y ∈ closedBall (0 : Amb n ℓ) (3 * (δ * ρ) / 4) := by
          rw [mem_closedBall] at hyb ⊢
          linarith
        refine ⟨hyb', fun hyG => hyF ?_⟩
        have hyGb : y ∈ Gb := ⟨hyG, hyb'⟩
        refine ⟨graphPoint (a y) (f (a y)), ⟨a y, ?_, rfl⟩, (hGbF y hyGb).symm⟩
        rw [mem_closedBall, dist_zero_right] at hyb ⊢
        have h := hnormy y
        have hay : ‖a y‖ ≤ ‖y‖ :=
          (pow_le_pow_iff_left₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).1
            (by linarith [sq_nonneg ‖b y‖])
        linarith
      -- A10: the second error term
      have hfε : ∀ x z, ‖f x - f z‖ ≤ ε₁₀ * ‖x - z‖ := fun x z =>
        (hfLip' x z).trans (mul_le_mul_of_nonneg_right hcLε (norm_nonneg _))
      have hfsmall : ∀ x ∈ closedBall (0 : Rn n) (δ * ρ / 2), ‖f x‖ ≤ δ * ρ / 32 := by
        intro x _
        refine (hfbd x).trans ((min_le_right _ _).trans ?_)
        have := mul_le_mul_of_nonneg_right hκ hσ.le
        linarith
      have hT2 := hGH U hU V H δ ρ hδ hδ₁₀' hAll q f hfε hfsmall
      rw [← htilt] at hT2
      have hT2' : V.weight (closedBall 0 (3 * (δ * ρ) / 4) \ q '' graphOver f univ) ≤
          V.weight (closedBall 0 (3 * (δ * ρ) / 4) \ G) := by
        apply measure_mono
        rintro y ⟨hyb, hyF⟩
        exact ⟨hyb, fun hyG => hyF ⟨graphPoint (a y) (f (a y)), ⟨a y, mem_univ _, rfl⟩,
          (hGbF y ⟨hyG, hyb⟩).symm⟩⟩
      -- A11
      have hk : 0 ≤ C₇ / (β ^ 2 * L ^ 2) * tilt := mul_nonneg (by positivity) ht0
      calc _ ≤ ENNReal.ofReal (C₇ / (β ^ 2 * L ^ 2) * tilt) + ENNReal.ofReal C₁₀ *
              (ENNReal.ofReal (C₇ / (β ^ 2 * L ^ 2) * tilt) + ENNReal.ofReal tilt) :=
            add_le_add (hT1.trans hC7)
              (hT2.trans (mul_le_mul' le_rfl (add_le_add (hT2'.trans hC7) le_rfl)))
        _ = ENNReal.ofReal (C₇ / (β ^ 2 * L ^ 2) * tilt +
              C₁₀ * (C₇ / (β ^ 2 * L ^ 2) * tilt + tilt)) := by
            rw [ENNReal.ofReal_add hk (mul_nonneg hC₁₀ (add_nonneg hk ht0)),
              ENNReal.ofReal_mul hC₁₀, ENNReal.ofReal_add hk ht0]
        _ ≤ _ := by
            apply ENNReal.ofReal_le_ofReal
            rw [div_mul_eq_div_div, div_eq_mul_inv (C₇ / β ^ 2)]
            have hmax := le_max_right
              ((2 * unitBallVolume n + 2 ^ ((n : ℝ) / 2) * unitBallVolume n) / β ^ 2)
              ((1 + C₁₀) * (C₇ / β ^ 2) + C₁₀)
            linarith [mul_le_mul_of_nonneg_right hmax
                (mul_nonneg (by positivity : (0 : ℝ) ≤ (L ^ 2)⁻¹) ht0),
              mul_nonneg (mul_nonneg hC₁₀ ht0) (sub_nonneg.2 hu1)]
  · -- Case A (A3): `f = 0`
    replace hB := not_le.1 hB
    refine ⟨fun _ => 0, LipschitzOnWith.of_dist_le' fun x _ z _ => ?_, fun x _ => ?_, ?_⟩
    · rw [dist_self]
      positivity
    · rw [norm_zero]
      positivity
    · have hs0 : (0 : ℝ) < δ * ρ / 2 := by positivity
      have hσρ : δ * ρ ≤ ρ := mul_le_of_le_one_left hρ.le hδ1
      have h1 := (hPD U hU V H δ ρ hδ hδP' hAll 0 (by rw [norm_zero]; positivity) (δ * ρ / 2)
        hs0 (by linarith)).1
      have h2 := Submission.lip_approx_graph_measure n ℓ hn q (fun _ => (0 : Rn ℓ))
        (fun x z => by simp) 0 (δ * ρ / 2) hs0.le
      calc _ ≤ V.weight (closedBall 0 (δ * ρ / 2)) + (μHE[n] : Measure (Amb n ℓ))
              (q '' graphOver (fun _ => (0 : Rn ℓ)) (closedBall 0 (δ * ρ / 2))) :=
            add_le_add (measure_mono inter_subset_left)
              (measure_mono (inter_subset_right.trans sdiff_subset))
        _ ≤ ENNReal.ofReal (2 * unitBallVolume n * (δ * ρ / 2) ^ n) +
            ENNReal.ofReal (2 ^ ((n : ℝ) / 2) * unitBallVolume n * (δ * ρ / 2) ^ n) :=
            add_le_add h1 h2
        _ = ENNReal.ofReal (2 * unitBallVolume n * (δ * ρ / 2) ^ n +
            2 ^ ((n : ℝ) / 2) * unitBallVolume n * (δ * ρ / 2) ^ n) :=
            (ENNReal.ofReal_add (by positivity) (by positivity)).symm
        _ ≤ _ := by
            apply ENNReal.ofReal_le_ofReal
            have hσn : (δ * ρ / 2) ^ n ≤ (δ * ρ) ^ n := pow_le_pow_left₀ hs0.le (by linarith) n
            have hA0 : 0 ≤ 2 * unitBallVolume n + 2 ^ ((n : ℝ) / 2) * unitBallVolume n := by
              positivity
            calc 2 * unitBallVolume n * (δ * ρ / 2) ^ n +
                  2 ^ ((n : ℝ) / 2) * unitBallVolume n * (δ * ρ / 2) ^ n
                = (2 * unitBallVolume n + 2 ^ ((n : ℝ) / 2) * unitBallVolume n) *
                    (δ * ρ / 2) ^ n := by ring
              _ ≤ (2 * unitBallVolume n + 2 ^ ((n : ℝ) / 2) * unitBallVolume n) * (δ * ρ) ^ n :=
                  mul_le_mul_of_nonneg_left hσn hA0
              _ = (2 * unitBallVolume n + 2 ^ ((n : ℝ) / 2) * unitBallVolume n) / β ^ 2 *
                    (L ^ 2)⁻¹ * (β ^ 2 * L ^ 2 * (δ * ρ) ^ n) := by
                  field_simp
              _ ≤ (2 * unitBallVolume n + 2 ^ ((n : ℝ) / 2) * unitBallVolume n) / β ^ 2 *
                    (L ^ 2)⁻¹ * tilt := mul_le_mul_of_nonneg_left hB.le (by positivity)
              _ ≤ _ := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (le_max_left _ _)
                    (by positivity)) ht0

namespace Submission

/-- **Simon Ch. 5, Theorem 4.5 (Tilt-excess Decay Theorem, p. 116).**

Step 1 of the accepted proof: re-centre at `ξ` (`ted_translate_varifold`) with the enlarged
parameter `δ'' = C_P δ` and the radius `ρ'' = σ / δ''`, so that `δ''ρ'' = σ`; the hypotheses 2.3
for `V − ξ` with `(δ'', ρ'')` follow from the mass bound (P.i) of `ted_allard_density_bounds` at
`y = ξ` and the monotonicity of `K = scaledLpNorm` in the ball.  Steps 2–8 are
`ted_decay_at_origin` with contraction `η`, which bounds `E(ξ, ησ, S)` by
`C η² E_*^{δ''}(ξ, σ, T) ≤ C η² E_*(ξ, σ, T)`.  Step 9: `η` is chosen with `C η² ≤ η^{2(1−n/p)}`,
and `δ⁻¹ K(ξ, ησ)² ≤ η^{2(1−n/p)} δ⁻¹ K(ξ, σ)²` because `K(ξ, ησ) ≤ η^{1−n/p} K(ξ, σ)`. -/
theorem tilt_excess_decay_theorem : TiltExcessDecayTheorem := by
  intro n ℓ hn p hp
  have hp0 : 0 < p := (Nat.cast_nonneg n).trans_lt hp
  have hp1 : (0 : ℝ) ≤ 1 / p := one_div_nonneg.2 hp0.le
  obtain ⟨C, hC, hdecay⟩ := Submission.ted_decay_at_origin Submission.tilt_excess_height_estimate
    Submission.affine_approximation_lemma Submission.lipschitz_approximation_lemma
    Submission.harmonic_approximation_lemma n ℓ hn p hp
  obtain ⟨CP, δP, hCP, hδP, hδP8, -, hbounds⟩ := Submission.ted_allard_density_bounds n ℓ hn p hp
  have hCP0 : 0 < CP := one_pos.trans_le hCP
  -- Choice of `η` (step 9): with `e = 2n/p = 2 − 2(1 − n/p) > 0`, `η^e ≤ C⁻¹` gives
  -- `C η² ≤ η^{2(1−n/p)}`.
  set e : ℝ := 2 * ((n : ℝ) / p) with he_def
  have he : 0 < e := mul_pos two_pos (div_pos (Nat.cast_pos.2 hn) hp0)
  set η : ℝ := min (1 / 128) (C⁻¹ ^ e⁻¹) with hη_def
  have hη0 : 0 < η := lt_min (by norm_num) (Real.rpow_pos_of_pos (inv_pos.2 hC) _)
  have hη128 : η ≤ 1 / 128 := min_le_left _ _
  have hη1 : η ≤ 1 := hη128.trans (by norm_num)
  have hCη : C * η ^ 2 ≤ η ^ (2 * (1 - (n : ℝ) / p)) := by
    have hηe : η ^ e ≤ C⁻¹ :=
      (Real.rpow_le_rpow hη0.le (min_le_right _ _) he.le).trans_eq
        (Real.rpow_inv_rpow (inv_nonneg.2 hC.le) he.ne')
    have hsplit : η ^ (2 * (1 - (n : ℝ) / p)) = η ^ 2 / η ^ e := by
      rw [show 2 * (1 - (n : ℝ) / p) = 2 - e by rw [he_def]; ring, Real.rpow_sub hη0,
        Real.rpow_two]
    rw [hsplit, le_div_iff₀ (Real.rpow_pos_of_pos hη0 e)]
    calc C * η ^ 2 * η ^ e = η ^ 2 * (C * η ^ e) := by ring
      _ ≤ η ^ 2 * (C * C⁻¹) := by gcongr
      _ = η ^ 2 := by rw [mul_inv_cancel₀ hC.ne', mul_one]
  obtain ⟨δ₁, hδ₁, hdec₁⟩ := hdecay η hη0 hη128
  refine ⟨η, min δP (δ₁ / CP), hη0, hη128.trans (by norm_num), lt_min hδP (div_pos hδ₁ hCP0),
    (min_le_left _ _).trans (hδP8.trans (by norm_num)), ?_⟩
  intro U hU V H δ ρ hδ hδδ₀ hA σ hσ hσδρ ξ hξ T hT
  obtain ⟨hρ, hHV, hmultV, -, hballU, -, hLpV⟩ := id hA
  -- `K(z, s) ≤ K(y, r)` (`K` = `scaledLpNorm`) when `B_s(z) ⊆ B_r(y)` and `0 ≤ s ≤ r`: the
  -- integral is over a smaller set and `s^{p−n} ≤ r^{p−n}` because `p > n`.
  have hKmono : ∀ {y z : Amb n ℓ} {r s : ℝ}, 0 ≤ s → s ≤ r → closedBall z s ⊆ closedBall y r →
      V.scaledLpNorm H p z s ≤ V.scaledLpNorm H p y r := by
    intro y z r s hs hsr hball
    unfold RectifiableVarifold.scaledLpNorm
    exact ENNReal.rpow_le_rpow (mul_le_mul'
      (ENNReal.ofReal_le_ofReal (Real.rpow_le_rpow hs hsr (sub_nonneg.2 hp.le)))
      (lintegral_mono_set hball)) hp1
  have hδP' : δ ≤ δP := hδδ₀.trans (min_le_left _ _)
  have hδ'' : CP * δ ≤ δ₁ := (le_div_iff₀' hCP0).1 (hδδ₀.trans (min_le_right _ _))
  have hδle : δ ≤ CP * δ := le_mul_of_one_le_left hδ.le hCP
  have hδρ : 0 ≤ δ * ρ := mul_nonneg hδ.le hρ.le
  have hδρ8 : δ * ρ ≤ ρ / 8 := by
    have := mul_le_mul_of_nonneg_right (hδP'.trans hδP8) hρ.le
    linarith
  have hξn : ‖ξ‖ ≤ δ * ρ := mem_closedBall_zero_iff.1 hξ.2
  -- Step 1: the re-centred scale `ρ'' = σ / (C_P δ)`, with `δ''ρ'' = σ` and `ρ'' ≤ ρ/2`.
  obtain ⟨ρ'', hρ''0, hρ''2, hσ''⟩ : ∃ r : ℝ, 0 < r ∧ r ≤ ρ / 2 ∧ CP * δ * r = σ := by
    have hCPδ : 0 < CP * δ := mul_pos hCP0 hδ
    refine ⟨σ / (CP * δ), div_pos hσ hCPδ, ?_, mul_div_cancel₀ σ hCPδ.ne'⟩
    rw [div_le_iff₀ hCPδ]
    nlinarith [mul_nonneg (sub_nonneg.2 hCP) hδρ]
  obtain ⟨V', -, hweight, hmult', -, hsupp', hGMC', htilt', hLp'⟩ :=
    Submission.ted_translate_varifold n ℓ U V ξ
  have hU' : IsOpen ((fun x => x + ξ) ⁻¹' U) := hU.preimage (by fun_prop)
  have hpre : (fun x => x - ξ) ⁻¹' closedBall (0 : Amb n ℓ) ρ'' = closedBall ξ ρ'' := by
    ext x
    simp [dist_eq_norm]
  -- The hypotheses 2.3 for `V' = V − ξ` with parameters `(C_P δ, ρ'')`.
  have hA' : V'.AllardHypotheses (fun x => H (x + ξ)) p (CP * δ) ρ'' := by
    refine ⟨hρ''0, hGMC' H hHV, ?_, ?_, ?_, ?_, ?_⟩
    · rw [hweight]
      refine (measurableEmbedding_subRight ξ).ae_map_iff.2 ?_
      filter_upwards [hmultV] with x hx
      show 1 ≤ V'.mult (x - ξ)
      rwa [hmult', sub_add_cancel]
    · exact (hsupp' 0).2 (by rw [zero_add]; exact hξ.1)
    · intro x hx
      show x + ξ ∈ U
      refine hballU (mem_closedBall_zero_iff.2 ?_)
      calc ‖x + ξ‖ ≤ ‖x‖ + ‖ξ‖ := norm_add_le _ _
        _ ≤ ρ'' + δ * ρ := add_le_add (mem_closedBall_zero_iff.1 hx) hξn
        _ ≤ ρ := by linarith
    · rw [hweight, (measurableEmbedding_subRight ξ).map_apply, hpre]
      exact (hbounds U hU V H δ ρ hδ hδP' hA).1 ξ (by linarith) ρ'' hρ''0 hρ''2
    · rw [hLp' H p 0 ρ'', zero_add]
      calc V.scaledLpNorm H p ξ ρ'' ≤ V.scaledLpNorm H p 0 ρ :=
            hKmono hρ''0.le (by linarith)
              (closedBall_subset_closedBall' (by rw [dist_zero_right]; linarith))
        _ ≤ ENNReal.ofReal δ := hLpV
        _ ≤ ENNReal.ofReal (CP * δ) := ENNReal.ofReal_le_ofReal hδle
  -- Steps 2–8: decay at the origin for `V'` at the scale `δ''ρ'' = σ`.
  obtain ⟨S, hS, hdec⟩ :=
    hdec₁ _ hU' V' (fun x => H (x + ξ)) (CP * δ) ρ'' (mul_pos hCP0 hδ) hδ'' hA' T hT
  rw [hσ'', htilt', zero_add] at hdec
  have hstar : V'.tiltExcessStar (fun x => H (x + ξ)) p (CP * δ) 0 σ T ≤
      V.tiltExcessStar H p δ ξ σ T := by
    unfold RectifiableVarifold.tiltExcessStar
    rw [htilt', hLp' H p 0 σ, zero_add]
    exact max_le_max le_rfl (mul_le_mul_of_nonneg_right (inv_anti₀ hδ hδle) (sq_nonneg _))
  have hEstar : 0 ≤ V.tiltExcessStar H p δ ξ σ T :=
    (mul_nonneg (inv_nonneg.2 hδ.le) (sq_nonneg (V.scaledLpNorm H p ξ σ).toReal)).trans
      (le_max_right _ _)
  -- Step 9, curvature term: `K(ξ, σ) ≤ K(0, ρ) ≤ δ` is finite and `K(ξ, ησ) ≤ η^{1−n/p} K(ξ, σ)`,
  -- since `(ησ)^{p−n} = η^{p−n} σ^{p−n}` and `B_{ησ}(ξ) ⊆ B_σ(ξ)`.
  have hKfin : V.scaledLpNorm H p ξ σ ≠ ⊤ :=
    ne_top_of_le_ne_top ENNReal.ofReal_ne_top
      ((hKmono hσ.le (by linarith)
        (closedBall_subset_closedBall' (by rw [dist_zero_right]; linarith))).trans hLpV)
  have hKscale : V.scaledLpNorm H p ξ (η * σ) ≤
      ENNReal.ofReal (η ^ (1 - (n : ℝ) / p)) * V.scaledLpNorm H p ξ σ := by
    have hexp : η ^ (1 - (n : ℝ) / p) = (η ^ (p - n)) ^ (1 / p) := by
      rw [← Real.rpow_mul hη0.le]
      congr 1
      field_simp
    unfold RectifiableVarifold.scaledLpNorm
    rw [hexp, ← ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg hη0.le (p - n)) hp1,
      ← ENNReal.mul_rpow_of_nonneg _ _ hp1, ← mul_assoc,
      ← ENNReal.ofReal_mul (Real.rpow_nonneg hη0.le (p - n)), ← Real.mul_rpow hη0.le hσ.le]
    exact ENNReal.rpow_le_rpow (mul_le_mul' le_rfl
      (lintegral_mono_set (closedBall_subset_closedBall (mul_le_of_le_one_left hσ.le hη1)))) hp1
  have hK : (V.scaledLpNorm H p ξ (η * σ)).toReal ≤
      η ^ (1 - (n : ℝ) / p) * (V.scaledLpNorm H p ξ σ).toReal := by
    have h := ENNReal.toReal_mono (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hKfin) hKscale
    rwa [ENNReal.toReal_mul, ENNReal.toReal_ofReal (Real.rpow_nonneg hη0.le _)] at h
  refine ⟨S, hS, max_le ?_ ?_⟩
  · calc V.tiltExcess ξ (η * σ) S
        ≤ C * η ^ 2 * V'.tiltExcessStar (fun x => H (x + ξ)) p (CP * δ) 0 σ T := hdec
      _ ≤ C * η ^ 2 * V.tiltExcessStar H p δ ξ σ T :=
          mul_le_mul_of_nonneg_left hstar (mul_nonneg hC.le (sq_nonneg η))
      _ ≤ η ^ (2 * (1 - (n : ℝ) / p)) * V.tiltExcessStar H p δ ξ σ T :=
          mul_le_mul_of_nonneg_right hCη hEstar
  · calc δ⁻¹ * (V.scaledLpNorm H p ξ (η * σ)).toReal ^ 2
        ≤ δ⁻¹ * (η ^ (1 - (n : ℝ) / p) * (V.scaledLpNorm H p ξ σ).toReal) ^ 2 :=
          mul_le_mul_of_nonneg_left (pow_le_pow_left₀ ENNReal.toReal_nonneg hK 2)
            (inv_nonneg.2 hδ.le)
      _ = η ^ (2 * (1 - (n : ℝ) / p)) * (δ⁻¹ * (V.scaledLpNorm H p ξ σ).toReal ^ 2) := by
          rw [mul_pow, ← Real.rpow_two (η ^ (1 - (n : ℝ) / p)), ← Real.rpow_mul hη0.le,
            mul_comm (1 - (n : ℝ) / p) 2]
          ring
      _ ≤ η ^ (2 * (1 - (n : ℝ) / p)) * V.tiltExcessStar H p δ ξ σ T :=
          mul_le_mul_of_nonneg_left (le_max_right _ _) (Real.rpow_nonneg hη0.le _)

/-- Simon Ch. 5, proof of Lemma 2.6 (p. 112) and of Corollary 2.7 (p. 113): a Lipschitz graph is
close to its base plane. For a linear isometry `q` of `ℝ^{n+ℓ}` and `f : ℝⁿ → ℝ^ℓ` with
`Lip f ≤ ε`, the rotated graph `F̂ = q(graph f)` is closed, and every chord of `F̂` is `ε`-close to
`T₀ = q(ℝⁿ × {0})`: `|p_{T₀^⊥}(x − z)| = |(x − z) − p_{T₀}(x − z)| ≤ ε |x − z|` for `x, z ∈ F̂`
(the book's `|p_{(ℝⁿ×{0})^⊥}(x − ζ)| ≤ Cβ |x − ζ|` on `F`).
The map `u ↦ (u, f u)` is antilipschitz and Lipschitz, so its range `graph f` is closed, and `q` is a
homeomorphism. For `x = q(u, f u)` and `z = q(v, f v)`, the point `q(u − v, 0)` lies in `T₀`, so
`dist(x − z, T₀) ≤ |q(0, f u − f v)| = |f u − f v| ≤ ε |u − v| ≤ ε |(u − v, f u − f v)| = ε |x − z|`. -/
theorem lgc_rotated_graph_slope : ∀ (n ℓ : ℕ) (q : Amb n ℓ ≃ₗᵢ[ℝ] Amb n ℓ) (f : Rn n → Rn ℓ) (ε : ℝ), 0 ≤ ε → LipschitzWith (Real.toNNReal ε) f → IsClosed (q '' graphOver f univ) ∧ ∀ x ∈ q '' graphOver f univ, ∀ z ∈ q '' graphOver f univ, ‖(x - z) - (rotatedPlane q).starProjection (x - z)‖ ≤ ε * ‖x - z‖ := by
  intro n ℓ q f ε hε hf
  -- coordinates of `(a, b) = graphPoint a b`: differences, `|(a, b)|² = |a|² + |b|²`, and
  -- `(a, 0) = Σᵢ aᵢ e_{castAdd ℓ i} ∈ ℝⁿ × {0}`
  have gsub : ∀ (a a' : Rn n) (b b' : Rn ℓ),
      graphPoint a b - graphPoint a' b' = graphPoint (a - a') (b - b') := by
    intro a a' b b'
    ext i
    refine Fin.addCases (fun i => ?_) (fun i => ?_) i <;> simp [graphPoint]
  have gnorm : ∀ (a : Rn n) (b : Rn ℓ), ‖graphPoint a b‖ ^ 2 = ‖a‖ ^ 2 + ‖b‖ ^ 2 := by
    intro a b
    rw [EuclideanSpace.norm_sq_eq, EuclideanSpace.norm_sq_eq, EuclideanSpace.norm_sq_eq,
      Fin.sum_univ_add]
    simp [graphPoint]
  have gmem : ∀ a : Rn n, graphPoint a (0 : Rn ℓ) ∈ horizontalPlane n ℓ := by
    intro a
    have : graphPoint a (0 : Rn ℓ) =
        ∑ i : Fin n, a i • EuclideanSpace.single (Fin.castAdd ℓ i) (1 : ℝ) := by
      ext j
      refine Fin.addCases (fun j => ?_) (fun j => ?_) j
      · simp [graphPoint, Pi.single_apply]
      · simp only [graphPoint]
        simp only [Fin.append_right, PiLp.zero_apply, WithLp.ofLp_sum, WithLp.ofLp_smul,
          PiLp.ofLp_single, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
        symm
        refine Finset.sum_eq_zero fun x _ => ?_
        have hne : Fin.natAdd n j ≠ Fin.castAdd ℓ x := by
          intro h
          have := congrArg Fin.val h
          simp at this
          omega
        rw [Pi.single_eq_of_ne hne, mul_zero]
    rw [this]
    refine Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ ?_
    exact Submodule.subset_span ⟨i, rfl⟩
  have gnorm_le : ∀ (a : Rn n) (b : Rn ℓ), ‖a‖ ≤ ‖graphPoint a b‖ := by
    intro a b
    have h := gnorm a b
    have := sq_nonneg ‖b‖
    nlinarith [norm_nonneg a, norm_nonneg (graphPoint a b)]
  have gnorm0 : ∀ b : Rn ℓ, ‖graphPoint (0 : Rn n) b‖ = ‖b‖ := by
    intro b
    have h := gnorm 0 b
    rw [norm_zero] at h
    have h' : ‖graphPoint (0 : Rn n) b‖ ^ 2 = ‖b‖ ^ 2 := by rw [h]; ring
    exact (pow_left_inj₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).1 h'
  have hfl : ∀ u v : Rn n, ‖f u - f v‖ ≤ ε * ‖u - v‖ := by
    intro u v
    have := hf.dist_le_mul u v
    rwa [Real.coe_toNNReal ε hε, dist_eq_norm, dist_eq_norm] at this
  constructor
  · -- `u ↦ (u, f u)` is antilipschitz and Lipschitz, so `graph f` is closed; `q` is a homeomorphism
    have hanti : AntilipschitzWith 1 (fun u : Rn n => graphPoint u (f u)) := by
      refine AntilipschitzWith.of_le_mul_dist fun u v => ?_
      simp only [NNReal.coe_one, one_mul]
      rw [dist_eq_norm, dist_eq_norm, gsub]
      exact gnorm_le _ _
    have hlip : LipschitzWith (1 + Real.toNNReal ε) (fun u : Rn n => graphPoint u (f u)) := by
      refine LipschitzWith.of_dist_le_mul fun u v => ?_
      rw [dist_eq_norm, dist_eq_norm, gsub]
      have h1 : ‖graphPoint (u - v) (f u - f v)‖ ≤ ‖u - v‖ + ‖f u - f v‖ := by
        have h := gnorm (u - v) (f u - f v)
        have hsq : ‖graphPoint (u - v) (f u - f v)‖ ^ 2 ≤ (‖u - v‖ + ‖f u - f v‖) ^ 2 := by
          rw [h]; nlinarith [norm_nonneg (u - v), norm_nonneg (f u - f v)]
        exact (pow_le_pow_iff_left₀ (norm_nonneg _) (by positivity) two_ne_zero).1 hsq
      push_cast
      rw [Real.coe_toNNReal ε hε]
      nlinarith [hfl u v]
    have hclosed : IsClosed (graphOver f univ) := by
      rw [graphOver, image_univ]
      exact hanti.isClosed_range hlip.uniformContinuous
    have := q.toHomeomorph.isClosedMap _ hclosed
    simpa [LinearIsometryEquiv.coe_toHomeomorph] using this
  · -- `x = q(u, f u)`, `z = q(v, f v)`; compare `x - z` with `q(u - v, 0) ∈ T₀`
    rintro x ⟨_, ⟨u, -, rfl⟩, rfl⟩ z ⟨_, ⟨v, -, rfl⟩, rfl⟩
    have hw : q (graphPoint (u - v) (0 : Rn ℓ)) ∈ rotatedPlane q :=
      Submodule.mem_map_of_mem (gmem (u - v))
    have hxz : q (graphPoint u (f u)) - q (graphPoint v (f v)) =
        q (graphPoint (u - v) (f u - f v)) := by
      rw [← map_sub, gsub]
    have hsplit : q (graphPoint u (f u)) - q (graphPoint v (f v)) - q (graphPoint (u - v) 0) =
        q (graphPoint 0 (f u - f v)) := by
      rw [hxz, ← map_sub, gsub]
      simp
    calc ‖(q (graphPoint u (f u)) - q (graphPoint v (f v))) -
          (rotatedPlane q).starProjection (q (graphPoint u (f u)) - q (graphPoint v (f v)))‖
        = infDist (q (graphPoint u (f u)) - q (graphPoint v (f v)))
            (rotatedPlane q : Set (Amb n ℓ)) := by
          rw [← dist_eq_norm, Submodule.dist_starProjection_eq_infDist]
      _ ≤ dist (q (graphPoint u (f u)) - q (graphPoint v (f v))) (q (graphPoint (u - v) 0)) :=
          infDist_le_dist_of_mem hw
      _ = ‖f u - f v‖ := by
          rw [dist_eq_norm, hsplit, LinearIsometryEquiv.norm_map, gnorm0]
      _ ≤ ε * ‖u - v‖ := hfl u v
      _ ≤ ε * ‖graphPoint (u - v) (f u - f v)‖ := mul_le_mul_of_nonneg_left (gnorm_le _ _) hε
      _ = ε * ‖q (graphPoint u (f u)) - q (graphPoint v (f v))‖ := by
          rw [hxz, LinearIsometryEquiv.norm_map]

/-- **Nearest point of `spt V` and the empty ball around it** (closest-point step of the hole
estimate in Simon's proof of Lemma 2.6, (9)–(10), pp. 112–113, as used for Corollary 2.7).
Let `d = dist(ζ, spt V)`.  If `0 ∈ spt V`, `B_ρ(0) ⊆ U` and `|ζ| + d ≤ ρ`, then some `y ∈ spt V`
has `|y − ζ| = d`, and `μ_V(B̆_d(ζ)) = 0`.
Proof: `spt μ_V` is closed and contains `spt V = U ∩ spt μ_V ∋ 0`, so (`ℝ^{n+ℓ}` being proper) it
has a point `y` nearest to `ζ`, and `|ζ − y| = dist(ζ, spt μ_V) ≤ d`.  Then `|y| ≤ |ζ| + d ≤ ρ`, so
`y ∈ B_ρ(0) ⊆ U`, hence `y ∈ spt V` and `|ζ − y| = d`.  Thus `B̆_d(ζ)` misses `spt μ_V`, whose
complement is `μ_V`-null (`ℝ^{n+ℓ}` is second countable, hence hereditarily Lindelöf). -/
theorem lgc_support_closest_point : ∀ (n ℓ : ℕ) (U : Set (Amb n ℓ)) (V : RectifiableVarifold n ℓ U) (ρ : ℝ) (ζ : Amb n ℓ), (0 : Amb n ℓ) ∈ V.support → closedBall (0 : Amb n ℓ) ρ ⊆ U → ‖ζ‖ + infDist ζ V.support ≤ ρ → ∃ y ∈ V.support, dist y ζ = infDist ζ V.support ∧ V.weight (ball ζ (infDist ζ V.support)) = 0 := by
  intro n ℓ U V ρ ζ h0 hB hsum
  set S := V.weight.support with hS
  -- `S = spt μ_V` is closed, and `spt V = U ∩ S ⊆ S` is nonempty
  have hSc : IsClosed S := Measure.isClosed_support
  have hVS : V.support ⊆ S := fun x hx => hx.2
  have hVne : V.support.Nonempty := ⟨0, h0⟩
  have hSne : S.Nonempty := hVne.mono hVS
  -- a point `y ∈ S` nearest to `ζ`; `dist(ζ, S) ≤ dist(ζ, spt V)`
  obtain ⟨y, hyS, hy⟩ := hSc.exists_infDist_eq_dist hSne ζ
  have hle : infDist ζ S ≤ infDist ζ V.support := infDist_le_infDist_of_subset hVS hVne
  -- `|y| ≤ |ζ| + |ζ − y| ≤ ρ`, so `y ∈ B_ρ(0) ⊆ U` and `y ∈ spt V`
  have hyU : y ∈ U := by
    apply hB
    rw [mem_closedBall, dist_zero_right]
    have : ‖y‖ ≤ ‖ζ‖ + dist ζ y := by
      rw [dist_eq_norm]
      calc ‖y‖ = ‖ζ - (ζ - y)‖ := by rw [sub_sub_cancel]
        _ ≤ ‖ζ‖ + ‖ζ - y‖ := norm_sub_le _ _
    linarith
  have hyV : y ∈ V.support := ⟨hyU, hyS⟩
  have hge : infDist ζ V.support ≤ dist ζ y := infDist_le_dist_of_mem hyV
  have heq : dist ζ y = infDist ζ V.support := le_antisymm (hy ▸ hle) hge
  refine ⟨y, hyV, by rw [dist_comm]; exact heq, ?_⟩
  -- `B̆_d(ζ)` misses `S`, and `μ_V(Sᶜ) = 0`
  apply measure_mono_null _ (Measure.measure_compl_support (μ := V.weight))
  intro x hx hxS
  rw [mem_ball] at hx
  have : infDist ζ S ≤ dist ζ x := infDist_le_dist_of_mem hxS
  rw [dist_comm] at hx
  linarith

/-- **Lower bound at a hole from annular monotonicity** (Simon Ch. 5, proof of Lemma 2.6,
display (9), and Corollary 2.7).  Let `μ` be a measure on `ℝ^{n+ℓ}` and `p` a `μ`-a.e. strongly
measurable field of continuous linear maps with `‖p x‖ ≤ 1`.  Let `s > 0`, `ω > 0`, and suppose
`μ(B_s(ζ)) = 0`, `μ(B_{3s}(ζ)) < ∞`, `|y − ζ| ≤ 2s`, `ω s^n / 2 ≤ μ(B_s(y))`, `c ≤ ω/(4·3^n)` and
the monotonicity inequality on the annulus `B_{3s}(ζ) \ B_s(ζ)`.  Then
`s^{n+2} ≤ (4·3^n e²/ω) ∫_{B_{3s}(ζ)} |(x − ζ) − p(x)(x − ζ)|² dμ`.
Proof: `B_s(y) ⊆ B_{3s}(ζ)` gives `ω/(2·3^n) ≤ (3s)^{-n} μ(B_{3s}(ζ))`, and the hole removes the
`B_s(ζ)` term.  On the annulus `|x − ζ| > s`, so the annular integral is at most `s^{-(n+2)}`
times the integral over `B_{3s}(ζ)` of the integrand, which is bounded by `36 s²` and hence
integrable there.  Absorbing `c ≤ ω/(4·3^n)` gives the claim. -/
theorem lgc_hole_annulus_lower : ∀ (n ℓ : ℕ) (μ : Measure (Amb n ℓ)) (p : Amb n ℓ → (Amb n ℓ →L[ℝ] Amb n ℓ)) (ζ y : Amb n ℓ) (s ω c : ℝ), 0 < s → 0 < ω → AEStronglyMeasurable p μ → (∀ x, ‖p x‖ ≤ 1) → μ (closedBall ζ s) = 0 → μ (closedBall ζ (3 * s)) ≠ ⊤ → dist y ζ ≤ 2 * s → ENNReal.ofReal (ω * s ^ n / 2) ≤ μ (closedBall y s) → c ≤ ω / (4 * 3 ^ n) → ((3 * s) ^ n)⁻¹ * (μ (closedBall ζ (3 * s))).toReal ≤ Real.exp 2 * ((s ^ n)⁻¹ * (μ (closedBall ζ s)).toReal) + c + Real.exp 2 * ∫ x in closedBall ζ (3 * s) \ closedBall ζ s, ‖(x - ζ) - p x (x - ζ)‖ ^ 2 / ‖x - ζ‖ ^ (n + 2) ∂μ → s ^ (n + 2) ≤ 4 * 3 ^ n * Real.exp 2 / ω * ∫ x in closedBall ζ (3 * s), ‖(x - ζ) - p x (x - ζ)‖ ^ 2 ∂μ := by
  intro n ℓ μ p ζ y s ω c hs hω hp hpb hhole hfin hy hlow hc hmono
  -- Step 1: `g x = ‖(x - ζ) - p x (x - ζ)‖²` is a.e. strongly measurable, since evaluation
  -- `(L, v) ↦ L v` is continuous.
  have hgm : AEStronglyMeasurable (fun x => ‖(x - ζ) - p x (x - ζ)‖ ^ 2) μ := by
    have h1 : AEStronglyMeasurable (fun x => p x (x - ζ)) μ :=
      Continuous.comp_aestronglyMeasurable₂
        (g := fun (L : Amb n ℓ →L[ℝ] Amb n ℓ) (v : Amb n ℓ) => L v)
        (continuous_fst.clm_apply continuous_snd) hp
        (continuous_id.sub continuous_const).aestronglyMeasurable
    exact (((continuous_id.sub continuous_const).aestronglyMeasurable.sub h1).norm.pow 2)
  -- Step 2: `0 ≤ g ≤ 36 s²` on `B_{3s}(ζ)`, which has finite mass, so `g` is integrable there.
  have hgb : ∀ x ∈ closedBall ζ (3 * s), ‖‖(x - ζ) - p x (x - ζ)‖ ^ 2‖ ≤ 36 * s ^ 2 := by
    intro x hx
    have hxz : ‖x - ζ‖ ≤ 3 * s := by rw [← dist_eq_norm]; exact hx
    have h1 : ‖(x - ζ) - p x (x - ζ)‖ ≤ 6 * s := by
      calc ‖(x - ζ) - p x (x - ζ)‖ ≤ ‖x - ζ‖ + ‖p x (x - ζ)‖ := norm_sub_le _ _
        _ ≤ ‖x - ζ‖ + ‖p x‖ * ‖x - ζ‖ := by gcongr; exact (p x).le_opNorm _
        _ ≤ 3 * s + 1 * (3 * s) := by gcongr; exact hpb x
        _ = 6 * s := by ring
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    calc ‖(x - ζ) - p x (x - ζ)‖ ^ 2 ≤ (6 * s) ^ 2 := by gcongr
      _ = 36 * s ^ 2 := by ring
  have hgi : IntegrableOn (fun x => ‖(x - ζ) - p x (x - ζ)‖ ^ 2) (closedBall ζ (3 * s)) μ :=
    Measure.integrableOn_of_bounded hfin hgm
      (ae_restrict_of_forall_mem measurableSet_closedBall hgb)
  -- Step 3: on the annulus `|x - ζ| > s`, so the annular integral is `≤ s^{-(n+2)} ∫_{B_{3s}(ζ)} g`.
  have hAm : MeasurableSet (closedBall ζ (3 * s) \ closedBall ζ s) :=
    measurableSet_closedBall.diff measurableSet_closedBall
  have hpos : 0 < s ^ (n + 2) := by positivity
  have hJ : ∫ x in closedBall ζ (3 * s) \ closedBall ζ s,
        ‖(x - ζ) - p x (x - ζ)‖ ^ 2 / ‖x - ζ‖ ^ (n + 2) ∂μ ≤
      (s ^ (n + 2))⁻¹ * ∫ x in closedBall ζ (3 * s), ‖(x - ζ) - p x (x - ζ)‖ ^ 2 ∂μ := by
    calc ∫ x in closedBall ζ (3 * s) \ closedBall ζ s,
          ‖(x - ζ) - p x (x - ζ)‖ ^ 2 / ‖x - ζ‖ ^ (n + 2) ∂μ
        ≤ ∫ x in closedBall ζ (3 * s) \ closedBall ζ s,
            (s ^ (n + 2))⁻¹ * ‖(x - ζ) - p x (x - ζ)‖ ^ 2 ∂μ := by
          apply integral_mono_of_nonneg
          · exact Eventually.of_forall (fun x => by positivity)
          · exact (hgi.mono_set sdiff_subset).const_mul _
          · filter_upwards [ae_restrict_mem hAm] with x hx
            have hxs : s < ‖x - ζ‖ := by
              have := hx.2
              rw [mem_closedBall, not_le, dist_eq_norm] at this
              exact this
            have hpow : s ^ (n + 2) ≤ ‖x - ζ‖ ^ (n + 2) := pow_le_pow_left₀ hs.le hxs.le _
            rw [div_eq_inv_mul]
            exact mul_le_mul_of_nonneg_right (inv_anti₀ hpos hpow) (by positivity)
      _ = (s ^ (n + 2))⁻¹ * ∫ x in closedBall ζ (3 * s) \ closedBall ζ s,
            ‖(x - ζ) - p x (x - ζ)‖ ^ 2 ∂μ := integral_const_mul _ _
      _ ≤ (s ^ (n + 2))⁻¹ * ∫ x in closedBall ζ (3 * s), ‖(x - ζ) - p x (x - ζ)‖ ^ 2 ∂μ := by
          apply mul_le_mul_of_nonneg_left _ (by positivity)
          exact setIntegral_mono_set hgi (Eventually.of_forall (fun x => by positivity))
            (Eventually.of_forall sdiff_subset)
  -- Step 4: `B_s(y) ⊆ B_{3s}(ζ)`, so `ω s^n / 2 ≤ μ(B_{3s}(ζ))`.
  have hsub : closedBall y s ⊆ closedBall ζ (3 * s) := by
    intro x hx
    rw [mem_closedBall] at hx ⊢
    calc dist x ζ ≤ dist x y + dist y ζ := dist_triangle _ _ _
      _ ≤ s + 2 * s := add_le_add hx hy
      _ = 3 * s := by ring
  have hmB : ω * s ^ n / 2 ≤ (μ (closedBall ζ (3 * s))).toReal := by
    have h1 : ENNReal.ofReal (ω * s ^ n / 2) ≤ μ (closedBall ζ (3 * s)) :=
      hlow.trans (measure_mono hsub)
    exact (ENNReal.ofReal_le_iff_le_toReal hfin).1 h1
  -- Step 5: the hole `μ(B_s(ζ)) = 0` removes the first term of the monotonicity inequality.
  rw [hhole, ENNReal.toReal_zero, mul_zero, mul_zero, zero_add] at hmono
  have h3n : ((3 * s) ^ n)⁻¹ * (ω * s ^ n / 2) = ω / (2 * 3 ^ n) := by
    rw [mul_pow]; field_simp
  have hlow2 : ω / (2 * 3 ^ n) ≤ c + Real.exp 2 * ((s ^ (n + 2))⁻¹ *
      ∫ x in closedBall ζ (3 * s), ‖(x - ζ) - p x (x - ζ)‖ ^ 2 ∂μ) := by
    calc ω / (2 * 3 ^ n) = ((3 * s) ^ n)⁻¹ * (ω * s ^ n / 2) := h3n.symm
      _ ≤ ((3 * s) ^ n)⁻¹ * (μ (closedBall ζ (3 * s))).toReal :=
          mul_le_mul_of_nonneg_left hmB (by positivity)
      _ ≤ _ := hmono
      _ ≤ _ := by gcongr
  -- Step 6: absorb `c ≤ ω/(4·3^n)` and multiply by `4·3^n s^{n+2}/ω > 0`.
  have hkey : ω / (4 * 3 ^ n) ≤ Real.exp 2 * ((s ^ (n + 2))⁻¹ *
      ∫ x in closedBall ζ (3 * s), ‖(x - ζ) - p x (x - ζ)‖ ^ 2 ∂μ) := by
    have : ω / (2 * 3 ^ n) = ω / (4 * 3 ^ n) + ω / (4 * 3 ^ n) := by field_simp; ring
    linarith
  have h4 : 0 < 4 * 3 ^ n / ω := by positivity
  calc s ^ (n + 2) = (4 * 3 ^ n / ω) * (ω / (4 * 3 ^ n)) * s ^ (n + 2) := by field_simp
    _ ≤ (4 * 3 ^ n / ω) * (Real.exp 2 * ((s ^ (n + 2))⁻¹ *
          ∫ x in closedBall ζ (3 * s), ‖(x - ζ) - p x (x - ζ)‖ ^ 2 ∂μ)) * s ^ (n + 2) := by
        gcongr
    _ = 4 * 3 ^ n * Real.exp 2 / ω *
          ∫ x in closedBall ζ (3 * s), ‖(x - ζ) - p x (x - ζ)‖ ^ 2 ∂μ := by
        field_simp

/-- **Splitting the normal part on `B_{3s}(ζ)`** (Simon Ch. 5, proof of Lemma 2.6, the estimate
following (9), p. 112), as used in the hole estimate of the proof of Corollary 2.7.  Write
`v = x − ζ`, `P = p_T` and `h(x) = |p(x) − P|²`.  Since `v − p(x) v = (v − P v) − (p(x) − P) v`,
`|v − p(x) v|² ≤ 2 |v − P v|² + 2 h(x) |v|²` (`lgc_hsNormSq_bounds`).  On `F` the slope hypothesis
gives `|v − P v| ≤ ε |v|`; off `F`, `|v − P v| = dist(v, T) ≤ |v|` as `0 ∈ T`.  With `|v| ≤ 3s` this
gives `|v − p(x) v|² ≤ 18 s² (ε² + 1_{Fᶜ}(x) + h(x))` on `B_{3s}(ζ)`, which integrates to the
stated bound since `h` is measurable and bounded (`‖p(x) − P‖ ≤ 2`) and `μ(B_{3s}(ζ)) < ∞`. -/
theorem lgc_hole_split_upper : ∀ (n ℓ : ℕ) (μ : Measure (Amb n ℓ)) (p : Amb n ℓ → (Amb n ℓ →L[ℝ] Amb n ℓ)) (T : Submodule ℝ (Amb n ℓ)) (F : Set (Amb n ℓ)) (ζ : Amb n ℓ) (s ε : ℝ), 0 < s → AEStronglyMeasurable p μ → (∀ x, ‖p x‖ ≤ 1) → MeasurableSet F → μ (closedBall ζ (3 * s)) ≠ ⊤ → (∀ x ∈ F, ‖(x - ζ) - T.starProjection (x - ζ)‖ ≤ ε * ‖x - ζ‖) → ∫ x in closedBall ζ (3 * s), ‖(x - ζ) - p x (x - ζ)‖ ^ 2 ∂μ ≤ 18 * s ^ 2 * (ε ^ 2 * (μ (closedBall ζ (3 * s))).toReal + (μ (closedBall ζ (3 * s) \ F)).toReal + ∫ x in closedBall ζ (3 * s), hsNormSq (p x - T.starProjection) ∂μ) := by
  intro n ℓ μ p T F ζ s ε hs hp hpb hF hfin hslope
  obtain ⟨hcont, hHS⟩ := lgc_hsNormSq_bounds (n + ℓ) (n + ℓ)
  have hPn : ‖T.starProjection‖ ≤ 1 := Submodule.starProjection_norm_le T
  -- `h(x) = |p(x) − P|²` is a.e. strongly measurable and bounded by `4 (n + ℓ)`.
  have hhm : AEStronglyMeasurable (fun x => hsNormSq (p x - T.starProjection)) μ :=
    hcont.comp_aestronglyMeasurable (hp.sub aestronglyMeasurable_const)
  have hhb : ∀ x, ‖hsNormSq (p x - T.starProjection)‖ ≤ 4 * ((n + ℓ : ℕ) : ℝ) := by
    intro x
    obtain ⟨h0, h1, -⟩ := hHS (p x - T.starProjection)
    rw [Real.norm_eq_abs, abs_of_nonneg h0]
    have h2 : ‖p x - T.starProjection‖ ≤ 2 := by
      calc ‖p x - T.starProjection‖ ≤ ‖p x‖ + ‖T.starProjection‖ := norm_sub_le _ _
        _ ≤ 1 + 1 := add_le_add (hpb x) hPn
        _ = 2 := by norm_num
    calc hsNormSq (p x - T.starProjection) ≤ ((n + ℓ : ℕ) : ℝ) * ‖p x - T.starProjection‖ ^ 2 := h1
      _ ≤ ((n + ℓ : ℕ) : ℝ) * 2 ^ 2 := by gcongr
      _ = 4 * ((n + ℓ : ℕ) : ℝ) := by ring
  have hhi : IntegrableOn (fun x => hsNormSq (p x - T.starProjection)) (closedBall ζ (3 * s)) μ :=
    Measure.integrableOn_of_bounded hfin hhm (Eventually.of_forall hhb)
  have hci : IntegrableOn (fun _ => (1:ℝ)) (closedBall ζ (3 * s)) μ :=
    integrableOn_const hfin
  have hii : IntegrableOn (Fᶜ.indicator (fun _ => (1:ℝ))) (closedBall ζ (3 * s)) μ :=
    hci.indicator hF.compl
  -- The pointwise bound `|v − p(x) v|² ≤ 18 s² (ε² + 1_{Fᶜ}(x) + h(x))` on `B_{3s}(ζ)`.
  have hpt : ∀ x ∈ closedBall ζ (3 * s), ‖(x - ζ) - p x (x - ζ)‖ ^ 2 ≤
      18 * s ^ 2 * (ε ^ 2 + Fᶜ.indicator (fun _ => (1:ℝ)) x + hsNormSq (p x - T.starProjection)) := by
    intro x hx
    have hxz : ‖x - ζ‖ ≤ 3 * s := by rw [← dist_eq_norm]; exact hx
    have hsplit : (x - ζ) - p x (x - ζ) =
        ((x - ζ) - T.starProjection (x - ζ)) + (-((p x - T.starProjection) (x - ζ))) := by
      simp only [sub_apply]
      abel
    have h1 : ‖(x - ζ) - p x (x - ζ)‖ ^ 2 ≤
        2 * ‖(x - ζ) - T.starProjection (x - ζ)‖ ^ 2 + 2 * ‖(p x - T.starProjection) (x - ζ)‖ ^ 2 := by
      rw [hsplit]
      have h := norm_add_le ((x - ζ) - T.starProjection (x - ζ)) (-((p x - T.starProjection) (x - ζ)))
      rw [norm_neg] at h
      have hn := norm_nonneg ((x - ζ) - T.starProjection (x - ζ) + -((p x - T.starProjection) (x - ζ)))
      have hsq := pow_le_pow_left₀ hn h 2
      nlinarith [sq_nonneg (‖(x - ζ) - T.starProjection (x - ζ)‖ -
        ‖(p x - T.starProjection) (x - ζ)‖)]
    have h2 : ‖(p x - T.starProjection) (x - ζ)‖ ^ 2 ≤ hsNormSq (p x - T.starProjection) * (9 * s ^ 2) := by
      obtain ⟨h0, -, h3⟩ := hHS (p x - T.starProjection)
      calc ‖(p x - T.starProjection) (x - ζ)‖ ^ 2
          ≤ hsNormSq (p x - T.starProjection) * ‖x - ζ‖ ^ 2 := h3 (x - ζ)
        _ ≤ hsNormSq (p x - T.starProjection) * (3 * s) ^ 2 := by gcongr
        _ = hsNormSq (p x - T.starProjection) * (9 * s ^ 2) := by ring
    -- Off `F`: `|v − P v| = dist(v, T) ≤ dist(v, 0) = |v|`.
    have hQ : ‖(x - ζ) - T.starProjection (x - ζ)‖ ≤ ‖x - ζ‖ := by
      rw [← dist_eq_norm, Submodule.dist_starProjection_eq_infDist]
      have := infDist_le_dist_of_mem (x := x - ζ) (Submodule.zero_mem T)
      rwa [dist_zero_right] at this
    by_cases hxF : x ∈ F
    · have hind : Fᶜ.indicator (fun _ => (1:ℝ)) x = 0 :=
        indicator_of_notMem (by simpa using hxF) _
      have h3 : ‖(x - ζ) - T.starProjection (x - ζ)‖ ^ 2 ≤ ε ^ 2 * (9 * s ^ 2) := by
        have h0 : 0 ≤ ‖(x - ζ) - T.starProjection (x - ζ)‖ := norm_nonneg _
        calc ‖(x - ζ) - T.starProjection (x - ζ)‖ ^ 2 ≤ (ε * ‖x - ζ‖) ^ 2 :=
              pow_le_pow_left₀ h0 (hslope x hxF) 2
          _ = ε ^ 2 * ‖x - ζ‖ ^ 2 := by ring
          _ ≤ ε ^ 2 * (3 * s) ^ 2 := by gcongr
          _ = ε ^ 2 * (9 * s ^ 2) := by ring
      rw [hind]
      nlinarith
    · have hind : Fᶜ.indicator (fun _ => (1:ℝ)) x = 1 := indicator_of_mem hxF _
      have h3 : ‖(x - ζ) - T.starProjection (x - ζ)‖ ^ 2 ≤ 9 * s ^ 2 := by
        calc ‖(x - ζ) - T.starProjection (x - ζ)‖ ^ 2 ≤ ‖x - ζ‖ ^ 2 :=
              pow_le_pow_left₀ (norm_nonneg _) hQ 2
          _ ≤ (3 * s) ^ 2 := by gcongr
          _ = 9 * s ^ 2 := by ring
      rw [hind]
      nlinarith [sq_nonneg ε, sq_nonneg s]
  -- Integrate the pointwise bound and evaluate the constant and indicator integrals.
  have hsum : IntegrableOn (fun x => ε ^ 2 + Fᶜ.indicator (fun _ => (1:ℝ)) x +
      hsNormSq (p x - T.starProjection)) (closedBall ζ (3 * s)) μ :=
    ((integrableOn_const hfin).add hii).add hhi
  calc ∫ x in closedBall ζ (3 * s), ‖(x - ζ) - p x (x - ζ)‖ ^ 2 ∂μ
      ≤ ∫ x in closedBall ζ (3 * s), 18 * s ^ 2 * (ε ^ 2 + Fᶜ.indicator (fun _ => (1:ℝ)) x +
          hsNormSq (p x - T.starProjection)) ∂μ := by
        apply integral_mono_of_nonneg (Eventually.of_forall fun x => by positivity)
          (hsum.const_mul (18 * s ^ 2))
        filter_upwards [ae_restrict_mem measurableSet_closedBall] with x hx
        exact hpt x hx
    _ = 18 * s ^ 2 * (ε ^ 2 * (μ (closedBall ζ (3 * s))).toReal +
          (μ (closedBall ζ (3 * s) \ F)).toReal +
          ∫ x in closedBall ζ (3 * s), hsNormSq (p x - T.starProjection) ∂μ) := by
        have h12 : IntegrableOn (fun x => ε ^ 2 + Fᶜ.indicator (fun _ => (1:ℝ)) x)
            (closedBall ζ (3 * s)) μ := (integrableOn_const hfin).add hii
        have hc2 : IntegrableOn (fun _ => ε ^ 2) (closedBall ζ (3 * s)) μ := integrableOn_const hfin
        have e1 : ∫ x in closedBall ζ (3 * s), (ε ^ 2 + Fᶜ.indicator (fun _ => (1:ℝ)) x +
              hsNormSq (p x - T.starProjection)) ∂μ =
            ∫ x in closedBall ζ (3 * s), (ε ^ 2 + Fᶜ.indicator (fun _ => (1:ℝ)) x) ∂μ +
              ∫ x in closedBall ζ (3 * s), hsNormSq (p x - T.starProjection) ∂μ :=
          integral_add h12 hhi
        have e2 : ∫ x in closedBall ζ (3 * s), (ε ^ 2 + Fᶜ.indicator (fun _ => (1:ℝ)) x) ∂μ =
            ∫ x in closedBall ζ (3 * s), ε ^ 2 ∂μ +
              ∫ x in closedBall ζ (3 * s), Fᶜ.indicator (fun _ => (1:ℝ)) x ∂μ :=
          integral_add hc2 hii
        have e3 : ∫ x in closedBall ζ (3 * s), ε ^ 2 ∂μ = ε ^ 2 * (μ (closedBall ζ (3 * s))).toReal := by
          rw [setIntegral_const, smul_eq_mul, measureReal_def, mul_comm]
        have e4 : ∫ x in closedBall ζ (3 * s), Fᶜ.indicator (fun _ => (1:ℝ)) x ∂μ =
            (μ (closedBall ζ (3 * s) \ F)).toReal := by
          rw [integral_indicator hF.compl, setIntegral_const, smul_eq_mul, mul_one, measureReal_def,
            Measure.restrict_apply hF.compl, inter_comm, ← sdiff_eq]
        rw [integral_const_mul, e1, e2, e3, e4]

/-- **Density bounds and annular monotonicity under 2.3** (Simon Ch. 5, 2.4 and 2.6 (9); the
monotonicity identity of Ch. 4, §§3–4 with the plus sign of the mean-curvature term forced by the
contract's convention `∫ div_M X = -∫ X·H`).  For `n ≥ 1` and `p > n` there are `δ₀ ∈ (0, 1/8]`
and `C₀ ≥ 0` such that, under 2.3 with `δ ≤ δ₀`, for `|y| ≤ 3δρ` and `0 < s ≤ r ≤ ρ/2`:
(i) `μ_V(B_s(y)) ≤ 2 ωₙ sⁿ`; (ii) `μ_V(B_s(y)) ≥ ωₙ sⁿ / 2` if `y ∈ spt V`;
(iii) `r⁻ⁿ μ_V(B_r(y)) ≤ e² s⁻ⁿ μ_V(B_s(y)) + C₀ δ + e² ∫_{B_r(y) \ B_s(y)} |p_x^⊥(x-y)|²/|x-y|^{n+2}`.

Proof.  For a ball `B_R(c) ⊆ B_ρ(0)` and the smooth cutoffs `Ψ_ε(t, x) = Φ_ε(|x-c|²/t²)`, the first
variation of `X = Ψ_ε(t, ·)(x - c)` (with `p_x` a rank-`n` orthogonal projection a.e., by
`lgc_tangent_plane_ae`) gives the radial identity `n I - t I' + t J' = -C`; Hölder bounds the
curvature term `C` by `2δR^{-κ}t^κ(tⁿ + I)`, `κ = 1 - n/p`, so the factors
`exp(±(2δ/κ)R^{-κ}t^κ)` make `t ↦ F⁺(1 + t⁻ⁿI)` nondecreasing and bound the increase of
`F⁻(1 + t⁻ⁿI)` by the defect integral; `ε ↓ 0` gives the closed-ball inequalities.  (i) and (iii)
follow with `δ₀ = min{1/(16n), κωₙ/(16(1+ωₙ))}`, `C₀ = 4/κ`; (ii) uses the weighted blow-up at a
good point `z` near `y` (`θ(z) ≥ 1`, weighted approximate tangent plane) to get `ωₙ ≤` the
monotone bound, and `B_{s(1-1/(8n))}(z) ⊆ B_s(y)`. -/
theorem lgc_density_monotonicity : ∀ (n ℓ : ℕ), 1 ≤ n → ∀ p : ℝ, (n : ℝ) < p → ∃ δ₀ C₀ : ℝ, 0 < δ₀ ∧ δ₀ ≤ 1 / 8 ∧ 0 ≤ C₀ ∧ ∀ (U : Set (Amb n ℓ)), IsOpen U → ∀ (V : RectifiableVarifold n ℓ U) (H : Amb n ℓ → Amb n ℓ) (δ ρ : ℝ), 0 < δ → δ ≤ δ₀ → V.AllardHypotheses H p δ ρ → (∀ y : Amb n ℓ, ‖y‖ ≤ 3 * δ * ρ → ∀ s : ℝ, 0 < s → s ≤ ρ / 2 → V.weight (closedBall y s) ≤ ENNReal.ofReal (2 * unitBallVolume n * s ^ n)) ∧ (∀ y ∈ V.support, ‖y‖ ≤ 3 * δ * ρ → ∀ s : ℝ, 0 < s → s ≤ ρ / 2 → ENNReal.ofReal (unitBallVolume n * s ^ n / 2) ≤ V.weight (closedBall y s)) ∧ (∀ y : Amb n ℓ, ‖y‖ ≤ 3 * δ * ρ → ∀ s r : ℝ, 0 < s → s ≤ r → r ≤ ρ / 2 → (r ^ n)⁻¹ * (V.weight (closedBall y r)).toReal ≤ Real.exp 2 * ((s ^ n)⁻¹ * (V.weight (closedBall y s)).toReal) + C₀ * δ + Real.exp 2 * ∫ x in closedBall y r \ closedBall y s, ‖(x - y) - V.tangentProj x (x - y)‖ ^ 2 / ‖x - y‖ ^ (n + 2) ∂V.weight) := by
  intro n ℓ hn p hp
  have hn1 : (1 : ℝ) ≤ n := Nat.one_le_cast.2 hn
  have hp0 : 0 < p := (Nat.cast_nonneg n).trans_lt hp
  obtain ⟨κ, hκ⟩ : ∃ κ : ℝ, κ = 1 - n / p := ⟨_, rfl⟩
  have hκ0 : 0 < κ := by rw [hκ, sub_pos, div_lt_one hp0]; exact hp
  have hω : 0 < unitBallVolume n :=
    div_pos (Real.rpow_pos_of_pos Real.pi_pos _) (Real.Gamma_pos_of_pos (by positivity))
  refine ⟨min (1 / (16 * n)) (κ * unitBallVolume n / (16 * (1 + unitBallVolume n))), 4 / κ,
    lt_min (one_div_pos.2 (by linarith only [hn1]))
      (div_pos (mul_pos hκ0 hω) (by linarith only [hω])),
    (min_le_left _ _).trans ((one_div_le_one_div (by linarith only [hn1]) (by norm_num)).2
      (by linarith only [hn1])), div_nonneg (by norm_num) hκ0.le, ?_⟩
  intro U hU V H δ ρ hδ hδ₀ hA
  obtain ⟨hρ, hH, hθ, -, hBU, hmass, hLp⟩ := hA
  -- numerical consequences of `δ ≤ δ₀`
  have hδn : (n : ℝ) * δ ≤ 1 / 16 := by
    have h := hδ₀.trans (min_le_left _ _)
    rw [le_div_iff₀ (by linarith only [hn1])] at h
    linarith only [h]
  have hδ16 : δ ≤ 1 / 16 := by
    linarith only [hδn, mul_le_mul_of_nonneg_right hn1 hδ.le]
  have hL0 : 0 ≤ 2 * δ / κ := div_nonneg (by linarith only [hδ]) hκ0.le
  have hLω : 2 * δ / κ * (1 + unitBallVolume n) ≤ unitBallVolume n / 8 := by
    have h := hδ₀.trans (min_le_right _ _)
    rw [le_div_iff₀ (by linarith only [hω] : (0 : ℝ) < 16 * (1 + unitBallVolume n))] at h
    rw [div_mul_eq_mul_div, div_le_iff₀ hκ0]
    linarith only [h]
  have hL8 : 2 * δ / κ ≤ 1 / 8 := le_of_mul_le_mul_right
    (hLω.trans (by linarith only [hω] : unitBallVolume n / 8 ≤ 1 / 8 * (1 + unitBallVolume n)))
    (by linarith only [hω] : (0 : ℝ) < 1 + unitBallVolume n)
  have hexpL : Real.exp (2 * δ / κ) ≤ 1 + 2 * (2 * δ / κ) := by
    have h := Real.abs_exp_sub_one_le (x := 2 * δ / κ) (by rw [abs_of_nonneg hL0]; linarith only [hL8])
    rw [abs_of_nonneg hL0] at h
    linarith only [(le_abs_self _).trans h]
  -- the `Lᵖ` hypothesis
  have hρpn : 0 < ρ ^ (p - n) := Real.rpow_pos_of_pos hρ _
  have hHfin : ∫⁻ x in closedBall (0 : Amb n ℓ) ρ, ‖H x‖ₑ ^ p ∂V.weight < ∞ := by
    by_contra h
    rw [not_lt, top_le_iff] at h
    rw [RectifiableVarifold.scaledLpNorm, h, ENNReal.mul_top (ENNReal.ofReal_pos.2 hρpn).ne',
      ENNReal.top_rpow_of_pos (one_div_pos.2 hp0)] at hLp
    exact ENNReal.ofReal_ne_top (top_le_iff.1 hLp)
  have hJ : ρ ^ κ * ((∫⁻ x in closedBall (0 : Amb n ℓ) ρ, ‖H x‖ₑ ^ p ∂V.weight).toReal) ^ (1 / p) ≤ δ := by
    rw [RectifiableVarifold.scaledLpNorm, ← ENNReal.ofReal_toReal hHfin.ne,
      ← ENNReal.ofReal_mul hρpn.le, ENNReal.ofReal_rpow_of_nonneg
        (mul_nonneg hρpn.le ENNReal.toReal_nonneg) (one_div_pos.2 hp0).le,
      ENNReal.ofReal_le_ofReal_iff hδ.le, Real.mul_rpow hρpn.le ENNReal.toReal_nonneg,
      ← Real.rpow_mul hρ.le, sub_mul, mul_one_div_cancel hp0.ne', mul_one_div, ← hκ] at hLp
    exact hLp
  -- tangent planes
  obtain ⟨hPmeas, hPae⟩ := lgc_tangent_plane_ae n ℓ hn U hU V
  have hproj : ∀ᵐ x ∂V.weight, ∃ T : Submodule ℝ (Amb n ℓ), Module.finrank ℝ T = n ∧
      V.tangentProj x = T.starProjection := by
    filter_upwards [hPae] with x hx
    obtain ⟨T, hT, hPx⟩ := hx
    exact ⟨T, hT.1, hPx⟩
  have hfin : V.weight (closedBall 0 ρ) < ∞ := hmass.trans_lt ENNReal.ofReal_lt_top
  have hsubball : ∀ (c : Amb n ℓ) (t : ℝ), ‖c‖ + t ≤ ρ → closedBall c t ⊆ closedBall 0 ρ :=
    fun c t hct x hx => by
      rw [mem_closedBall, dist_eq_norm] at hx
      rw [mem_closedBall, dist_zero_right]
      exact (norm_le_norm_add_norm_sub' x c).trans (by linarith only [hx, hct])
  have hballfin : ∀ (c : Amb n ℓ) (t : ℝ), ‖c‖ + t ≤ ρ → V.weight (closedBall c t) ≠ ∞ :=
    fun c t hct => ((measure_mono (hsubball c t hct)).trans_lt hfin).ne
  have hmassR : V.weight.real (closedBall 0 ρ) ≤ (1 + δ) * (unitBallVolume n * ρ ^ n) :=
    ENNReal.toReal_le_of_le_ofReal (mul_nonneg (by linarith only [hδ])
      (mul_nonneg hω.le (pow_pos hρ n).le)) hmass
  have hpowlim : Tendsto (fun ε : ℝ => (1 + ε) ^ n) (𝓝[>] 0) (𝓝 1) := by
    have h : Tendsto (fun ε : ℝ => (1 + ε) ^ n) (𝓝 0) (𝓝 ((1 + 0) ^ n)) :=
      ((continuous_const.add continuous_id).pow n).tendsto 0
    rw [add_zero, one_pow] at h
    exact h.mono_left nhdsWithin_le_nhds
  -- the cutoff profiles
  obtain ⟨Φ, hΦc, hΦ01, hΦd, hΦ1, hΦ0, hΦd0⟩ : ∃ Φ : ℝ → ℝ → ℝ, (∀ ε, ContDiff ℝ 1 (Φ ε)) ∧
      (∀ ε u, 0 ≤ Φ ε u ∧ Φ ε u ≤ 1) ∧ (∀ ε, 0 < ε → ∀ u, deriv (Φ ε) u ≤ 0) ∧
      (∀ ε, 0 < ε → ∀ u, u ≤ 1 → Φ ε u = 1) ∧ (∀ ε, 0 < ε → ∀ u, 1 + ε ≤ u → Φ ε u = 0) ∧
      (∀ ε, 0 < ε → ∀ u, (u < 1 ∨ 1 + ε < u) → deriv (Φ ε) u = 0) := by
    refine ⟨fun ε u => 1 - Real.smoothTransition ((u - 1) / ε), fun ε => ?_, fun ε u => ?_,
      fun ε hε u => ?_, fun ε hε u hu => ?_, fun ε hε u hu => ?_, fun ε hε u hu => ?_⟩
    · exact contDiff_const.sub (Real.smoothTransition.contDiff.comp
        ((contDiff_id.sub contDiff_const).div_const ε))
    · exact ⟨sub_nonneg.2 (Real.smoothTransition.le_one _),
        sub_le_self _ (Real.smoothTransition.nonneg _)⟩
    · exact Antitone.deriv_nonpos fun a b hab => sub_le_sub_left (Real.smoothTransition.monotone
        (div_le_div_of_nonneg_right (sub_le_sub_right hab 1) hε.le)) 1
    · show 1 - Real.smoothTransition ((u - 1) / ε) = 1
      rw [Real.smoothTransition.zero_of_nonpos
        (div_nonpos_of_nonpos_of_nonneg (sub_nonpos.2 hu) hε.le), sub_zero]
    · show 1 - Real.smoothTransition ((u - 1) / ε) = 0
      rw [Real.smoothTransition.one_of_one_le ((one_le_div hε).2 (by linarith only [hu])),
        sub_self]
    · rcases hu with hu | hu
      · refine (Filter.EventuallyEq.deriv_eq (f := fun _ => (1 : ℝ)) ?_).trans (deriv_const u 1)
        filter_upwards [gt_mem_nhds hu] with v hv
        show 1 - Real.smoothTransition ((v - 1) / ε) = 1
        rw [Real.smoothTransition.zero_of_nonpos
          (div_nonpos_of_nonpos_of_nonneg (sub_nonpos.2 hv.le) hε.le), sub_zero]
      · refine (Filter.EventuallyEq.deriv_eq (f := fun _ => (0 : ℝ)) ?_).trans (deriv_const u 0)
        filter_upwards [lt_mem_nhds hu] with v hv
        show 1 - Real.smoothTransition ((v - 1) / ε) = 0
        rw [Real.smoothTransition.one_of_one_le ((one_le_div hε).2 (by linarith only [hv, hε])),
          sub_self]
  have hΦD : ∀ ε, 0 < ε → ∃ D, ∀ u, |deriv (Φ ε) u * u| ≤ D := by
    intro ε hε
    obtain ⟨C, hC⟩ := isCompact_Icc.exists_bound_of_continuousOn (s := Icc (1 : ℝ) (1 + ε))
      (((hΦc ε).continuous_deriv le_rfl).mul continuous_id).continuousOn
    refine ⟨C, fun u => ?_⟩
    by_cases hu : u ∈ Icc 1 (1 + ε)
    · exact hC u hu
    · rw [hΦd0 ε hε u (by
        rcases not_and_or.1 hu with h | h
        · exact Or.inl (lt_of_not_ge h)
        · exact Or.inr (lt_of_not_ge h)), zero_mul, abs_zero]
      exact (abs_nonneg _).trans (hC 1 ⟨le_rfl, by linarith only [hε]⟩)
  -- CORE
  suffices core : ∀ (c : Amb n ℓ) (R : ℝ), 0 < R → ‖c‖ + R ≤ ρ → ∀ s r : ℝ, 0 < s → s ≤ r → r < R →
      1 + (s ^ n)⁻¹ * V.weight.real (closedBall c s) ≤
          Real.exp (2 * δ / κ) * (1 + (r ^ n)⁻¹ * V.weight.real (closedBall c r)) ∧
        Real.exp (-(2 * δ / κ)) * (1 + (r ^ n)⁻¹ * V.weight.real (closedBall c r)) ≤
          1 + (s ^ n)⁻¹ * V.weight.real (closedBall c s) +
            ∫ x in closedBall c r \ closedBall c s,
              ‖(x - c) - V.tangentProj x (x - c)‖ ^ 2 / ‖x - c‖ ^ (n + 2) ∂V.weight by
    -- DENSITY LOWER BOUND
    suffices DLB : ∀ (z : Amb n ℓ) (T : Submodule ℝ (Amb n ℓ)),
        Poincare.SimonGMT.Chapter03.HasWeightedApproximateTangentSpaceAt n V.carrier V.mult z T →
        1 ≤ V.mult z → ∀ s₀ K : ℝ, 0 < s₀ → V.weight (closedBall z s₀) ≠ ∞ →
        (∀ t, 0 < t → t ≤ s₀ → (t ^ n)⁻¹ * V.weight.real (closedBall z t) ≤ K) →
        unitBallVolume n ≤ K by
      have hδρ : 0 < δ * ρ := mul_pos hδ hρ
      have hδρ16 : δ * ρ ≤ 1 / 16 * ρ := mul_le_mul_of_nonneg_right hδ16 hρ.le
      have hreal0 : ∀ (c : Amb n ℓ) (t : ℝ), 0 < t → 0 ≤ (t ^ n)⁻¹ * V.weight.real (closedBall c t) :=
        fun c t ht => mul_nonneg (inv_nonneg.2 (pow_pos ht n).le) measureReal_nonneg
      refine ⟨fun y hy s hs hsρ => ?_, fun y hysupp hy s hs hsρ => ?_, fun y hy s r hs hsr hrρ => ?_⟩
      · -- (i): the upper mass bound
        have hr₁ : 0 < (1 - 4 * δ) * ρ := mul_pos (by linarith only [hδ16]) hρ
        have hr₁e : (1 - 4 * δ) * ρ = ρ - 4 * (δ * ρ) := by ring
        obtain ⟨h1, -⟩ := core y (ρ - ‖y‖) (by linarith only [hy, hδρ16, hρ]) (by linarith only [])
          s ((1 - 4 * δ) * ρ) hs (by linarith only [hsρ, hδρ16, hr₁e, hρ])
          (by linarith only [hy, hδρ, hr₁e])
        have hbern : (3 : ℝ) / 4 ≤ (1 - 4 * δ) ^ n := by
          have h := one_add_mul_le_pow (a := -(4 * δ)) (by linarith only [hδ16]) n
          rw [← sub_eq_add_neg] at h
          linarith only [h, hδn]
        have hm : V.weight.real (closedBall y ((1 - 4 * δ) * ρ)) ≤ (1 + δ) * (unitBallVolume n * ρ ^ n) :=
          (measureReal_mono (hsubball y _ (by linarith only [hy, hδρ, hr₁e])) hfin.ne).trans hmassR
        have ha : (((1 - 4 * δ) * ρ) ^ n)⁻¹ * V.weight.real (closedBall y ((1 - 4 * δ) * ρ)) ≤
            17 / 12 * unitBallVolume n := by
          have hb0 : 0 < (1 - 4 * δ) ^ n := lt_of_lt_of_le (by norm_num) hbern
          have hρn : (ρ ^ n)⁻¹ * ρ ^ n = 1 := inv_mul_cancel₀ (pow_pos hρ n).ne'
          have hinvb : ((1 - 4 * δ) ^ n)⁻¹ ≤ 4 / 3 :=
            (inv_le_comm₀ hb0 (by norm_num)).2 (le_of_eq_of_le (by norm_num) hbern)
          rw [mul_pow, mul_inv]
          calc ((1 - 4 * δ) ^ n)⁻¹ * (ρ ^ n)⁻¹ * V.weight.real (closedBall y ((1 - 4 * δ) * ρ))
              ≤ ((1 - 4 * δ) ^ n)⁻¹ * (ρ ^ n)⁻¹ * ((1 + δ) * (unitBallVolume n * ρ ^ n)) :=
                mul_le_mul_of_nonneg_left hm (mul_nonneg (inv_nonneg.2 hb0.le)
                  (inv_nonneg.2 (pow_pos hρ n).le))
            _ = ((1 - 4 * δ) ^ n)⁻¹ * ((1 + δ) * unitBallVolume n) := by
                linear_combination (((1 - 4 * δ) ^ n)⁻¹ * ((1 + δ) * unitBallVolume n)) * hρn
            _ ≤ 4 / 3 * ((1 + δ) * unitBallVolume n) :=
                mul_le_mul_of_nonneg_right hinvb (mul_nonneg (by linarith only [hδ]) hω.le)
            _ ≤ 17 / 12 * unitBallVolume n := by
                linarith only [mul_le_mul_of_nonneg_right hδ16 hω.le]
        have hLa := mul_le_mul_of_nonneg_left ha hL0
        have h2 := mul_le_mul_of_nonneg_right hexpL (by
          linarith only [hreal0 y _ hr₁] : (0 : ℝ) ≤ 1 + (((1 - 4 * δ) * ρ) ^ n)⁻¹ *
            V.weight.real (closedBall y ((1 - 4 * δ) * ρ)))
        have has : (s ^ n)⁻¹ * V.weight.real (closedBall y s) ≤ 2 * unitBallVolume n := by
          linarith only [h1, h2, hLa, ha, hLω, hω, hL0]
        rw [← ENNReal.ofReal_toReal (hballfin y s (by linarith only [hy, hδρ16, hsρ, hρ]))]
        refine ENNReal.ofReal_le_ofReal ?_
        have h3 := (inv_mul_le_iff₀ (pow_pos hs n)).1 has
        rw [← measureReal_def]
        linarith only [h3]
      · -- (ii): the lower mass bound
        have hgood : ∀ᵐ z ∂V.weight, 1 ≤ V.mult z ∧ ∃ T : Submodule ℝ (Amb n ℓ),
            Poincare.SimonGMT.Chapter03.HasWeightedApproximateTangentSpaceAt n V.carrier V.mult z T := by
          filter_upwards [hθ, hPae] with z hz1 hz2
          obtain ⟨T, hT, -⟩ := hz2
          exact ⟨hz1, T, hT⟩
        have hτ0 : 0 < 1 / (8 * (n : ℝ)) := one_div_pos.2 (by linarith only [hn1])
        have hnτ : (n : ℝ) * (1 / (8 * n)) = 1 / 8 := by
          rw [mul_one_div, mul_comm 8 (n : ℝ), ← div_div, div_self (by linarith only [hn1] : (n : ℝ) ≠ 0)]
        have hτ8 : 1 / (8 * (n : ℝ)) ≤ 1 / 8 := by
          linarith only [hnτ, mul_le_mul_of_nonneg_right hn1 hτ0.le]
