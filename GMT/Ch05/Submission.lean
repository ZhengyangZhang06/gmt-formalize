        have h3 : ‖x‖ * (|s - inner ℝ x ξ / ‖x‖ ^ 2| * ‖x‖) < ‖x‖ * (2 * ρ) := by
          calc ‖x‖ * (|s - inner ℝ x ξ / ‖x‖ ^ 2| * ‖x‖) =
