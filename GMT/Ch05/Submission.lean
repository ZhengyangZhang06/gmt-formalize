        fun h => hζV ⟨hζU, h⟩) (infDist_le_infDist_of_subset hsuppV ⟨0, h0⟩)
    -- Move along `t ↦ q(t x_ζ, f(t x_ζ))` to a graph point at distance `≤ σ₀/64` from `spt V`.
    obtain ⟨ζ', hζ'mem, hζ'norm, hdpos, hdle⟩ : ∃ ζ' ∈ q '' graphOver f univ,
