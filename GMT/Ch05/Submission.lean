      _ = (2 * CA + 2 * Real.sqrt (CI * C₂)) * t₀ * (δ₀ * ρ) := by ring
  have htilt7 : ∀ ξ ∈ V.support ∩ closedBall 0 (δ₀ * ρ / 2), ∀ σ : ℝ, 0 < σ → σ ≤ δ₀ * ρ / 2 →
