  obtain ⟨hT₀dim, hT₀Tst, -⟩ := hS 0 h0mem'
  obtain ⟨q₀, hq₀⟩ := hGPA5 (S 0) hT₀dim
  have hCIC₂ : 0 ≤ CI * C₂ := mul_nonneg hCI (by linarith)
  have hheight : ∀ x ∈ V.support ∩ closedBall 0 (2 * (δ₀ * ρ)),
