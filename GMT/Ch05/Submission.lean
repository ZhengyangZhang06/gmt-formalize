              s' ^ n := by
        rw [← integral_sub (hwφint r' hr' hεR) (hwφint s' hs' hsR),
          ← measureReal_sdiff hsub measurableSet_closedBall (hfinB _ hεR.le).ne]
        have h2 : V.weight.real (closedBall z ((1 + ε) * r') \ closedBall z r') / s' ^ n =
