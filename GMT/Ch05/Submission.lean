          apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg n)
          exact inv_anti₀ (pow_pos hσ _) (pow_le_pow_left₀ hσ.le hxσ.le _)
      obtain ⟨b, hbdef⟩ : ∃ b : Amb n ℓ → ℝ, b = fun x =>
