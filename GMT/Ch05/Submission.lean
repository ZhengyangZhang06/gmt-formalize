                mul_le_mul_of_nonneg_left (hHδ σ ⟨le_rfl, hσ1⟩) (by positivity)
            _ = δ / n := by
              have : σ ^ n = σ ^ (n - 1) * σ := (pow_sub_one_mul hn0 σ).symm
