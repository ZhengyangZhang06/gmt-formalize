            have hle : 2 + (n - 1) * Real.log σ⁻¹ ≤ (2 + Real.log σ⁻¹) * n := by linarith
            calc δ + δ * (1 + (n - 1) * Real.log σ⁻¹) = δ * (2 + (n - 1) * Real.log σ⁻¹) := by ring
              _ ≤ δ * ((2 + Real.log σ⁻¹) * n) := mul_le_mul_of_nonneg_left hle hδ0
              _ = δ * (2 + Real.log σ⁻¹) * n := by ring
