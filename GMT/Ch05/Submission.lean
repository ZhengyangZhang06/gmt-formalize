  · -- Step 6: a graph point over `Bⁿ_{σ₀/4}(0)` in `B_{σ₀/4}(0)` lies in `spt V`.
    rintro ζ ⟨⟨g, ⟨xz, hxz, rfl⟩, rfl⟩, hζB⟩
    refine ⟨?_, hζB⟩
    by_contra hζV
    have hxz0 : ‖xz‖ ≤ δ * ρ / 4 := mem_closedBall_zero_iff.1 hxz
