    as_aux_lemma =>
      intro n ℓ hn g hg τ hτ hτ1 x
      have hgd : Differentiable ℝ g := hg.differentiable one_ne_zero
      have hg'c : Continuous (fderiv ℝ g) := hg.continuous_fderiv one_ne_zero
      have hd : ∀ s ∈ uIcc (1 : ℝ) τ⁻¹, HasDerivAt (fun s : ℝ => s ^ n * g (s • x))
