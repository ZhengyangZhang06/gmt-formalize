    · have hzn : 0 < ‖z‖ := norm_pos_iff.mpr hz
      have hmem : z + (t / ‖z‖) • z ∈ closedBall z t := by
        rw [mem_closedBall, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_eq_abs,
