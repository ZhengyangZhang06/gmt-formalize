      have := hx.2
      rwa [show 2 * (δ₀ * ρ) = 2 * δ₀ * ρ by ring] at this
    have h2 := (mul_le_mul_right h1 (ENNReal.ofReal (2 * δ₀ * ρ)⁻¹)).trans hTst_ht
    rw [← ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_le_ofReal_iff (by positivity),
