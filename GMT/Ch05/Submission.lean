          rw [hpow]; field_simp
      _ ≤ 4 ^ n * (CA * (CA + 1) * t₀) ^ 2 := mul_le_mul_of_nonneg_left hTst_X (by positivity)
  have hTst_Estar : ∀ ξ ∈ V.support ∩ closedBall 0 (δ₀ * ρ / 2),
