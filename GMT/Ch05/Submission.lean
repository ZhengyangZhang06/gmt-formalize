  -- `d/ds (sⁿ g(s x)) = n s^{n-1} g(s x) + sⁿ Dg(s x) x`, integrated over `[1, 1/τ]`.
  have conical_FTC : ∀ {n ℓ : ℕ} (hn : 1 ≤ n) (g : Amb n ℓ → ℝ) (hg : ContDiff ℝ 1 g) (τ : ℝ) (hτ : 0 < τ) (hτ1 : τ ≤ 1) (x : Amb n ℓ),
