    show |Real.log (lam d) * lam d ^ (1 / 4 : ℝ)| = qq d * |Real.log (lam d)|
    rw [abs_mul, abs_of_nonneg (Real.rpow_nonneg (hlam_pos d hd).le _), hqq d, mul_comm]
  have tA : Tendsto (fun d => ea d * ((1 + d) * ω * ((1 - κ₀) ^ n)⁻¹) + eb d) (𝓝[>] 0)
