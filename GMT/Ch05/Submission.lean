              field_simp
        have e2 : ∫ x in closedBall (0 : Amb n ℓ) 1 \ closedBall 0 σ,
            (‖x‖ ^ (n - 1))⁻¹ / n * ‖H x‖ ∂V.weight ≤
            δ * (1 + ((n - 1 : ℕ) : ℝ) * Real.log σ⁻¹) / n := by
          have hfun : (fun x : Amb n ℓ => (‖x‖ ^ (n - 1))⁻¹ / n * ‖H x‖) =
