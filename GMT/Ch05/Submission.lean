          ((ν.restrict A).prod (volume.restrict (Ioc a R))) := by
        have hG : Integrable (fun z : Amb n ℓ × ℝ => ((m : ℝ) * (a ^ (m + 1))⁻¹ * w z.1) * (1 : ℝ))
