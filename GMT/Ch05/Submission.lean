      exact tendsto_nhds_unique h1 h2
    have hsp : (Q : Amb n ℓ →ₗ[ℝ] Amb n ℓ).IsSymmetricProjection := ⟨hidemL Q hidem, hsym⟩
    obtain ⟨hinst, hQeq'⟩ := LinearMap.isSymmetricProjection_iff_eq_coe_starProjection_range.mp hsp
