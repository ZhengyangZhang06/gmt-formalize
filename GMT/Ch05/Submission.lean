        calc _ ≤ δ / n + δ * (1 + ((n - 1 : ℕ) : ℝ) * Real.log σ⁻¹) / n := add_le_add e1 e2
          _ ≤ δ * (2 + Real.log σ⁻¹) := by
            rw [Nat.cast_sub hn, Nat.cast_one, ← add_div, div_le_iff₀ hn']
