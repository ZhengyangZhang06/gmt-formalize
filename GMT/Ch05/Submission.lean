        intro y
        rw [hgdef]
        exact ⟨mul_nonneg (hχb _).1 (hφb _).1,
          mul_le_one₀ (hχb _).2 (hφb _).1 (hφb _).2⟩
      -- the topological support of `g` lies in the shell `a ≤ ‖y‖ ≤ b`
