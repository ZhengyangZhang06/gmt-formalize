        · rw [hw, indicator_of_notMem (show x ∉ {x | s' < ‖x - z‖} from hxs), zero_mul]
          exact add_nonneg hi1 hi2
      have hpos1 := Real.exp_pos (c * s' ^ α)
      have hpos2 := Real.exp_pos (c * r' ^ α)
      have hpos3 := Real.exp_pos (-(c * r' ^ α))
      have hpos4 := Real.exp_pos (-(c * s' ^ α))
