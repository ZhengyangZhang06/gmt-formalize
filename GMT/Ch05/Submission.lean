  have hσρ : δ * ρ ≤ ρ / 4 := by nlinarith
  have hτ : δ ^ (1 / (2 * (n : ℝ) + 2)) ≤ β * L := by
    have hα : (1 / (2 * (n : ℝ) + 2)) = ((2 * n + 2 : ℕ) : ℝ)⁻¹ := by push_cast; ring
    rw [hα]
    calc δ ^ ((2 * n + 2 : ℕ) : ℝ)⁻¹ ≤ ((β * L) ^ (2 * n + 2)) ^ ((2 * n + 2 : ℕ) : ℝ)⁻¹ :=
