    · have hbQ : b ∈ Uᶜ ∩ closedBall a 1 := ⟨hb, mem_closedBall.2 (by linarith)⟩
      have hd : dist b a * (8 * K + 1) ≤ e * ρ := by
        rw [← le_div_iff₀ (by positivity)]; linarith
      refine ContinuousLinearMap.opNorm_le_of_shell (c := (2 : ℝ)) hρ he.le
        (by norm_num) fun w hw1 hw2 => ?_
      rw [Real.norm_two] at hw1
      have h1 := hρU b hbQ w hw2
      have h2 := hρU a haQ w hw2
      have h3 := hf.dist_le_mul (b + w) (a + w)
      have h4 := hf.dist_le_mul b a
      rw [Real.dist_eq, dist_add_right] at h3
      rw [Real.dist_eq] at h4
      have h5 : e * ρ ≤ e * (2 * ‖w‖) := mul_le_mul_of_nonneg_left (by linarith) he.le
      have h6 : 0 ≤ dist b a := dist_nonneg
      rw [sub_apply, Real.norm_eq_abs]
      have e1 : fderiv ℝ f b w - fderiv ℝ f a w = (f (b + w) - f (a + w)) - (f b - f a) -
          (f (b + w) - f b - fderiv ℝ f b w) + (f (a + w) - f a - fderiv ℝ f a w) := by ring
      rw [e1]
      have := abs_add_le ((f (b + w) - f (a + w)) - (f b - f a) -
          (f (b + w) - f b - fderiv ℝ f b w)) (f (a + w) - f a - fderiv ℝ f a w)
      have := abs_sub ((f (b + w) - f (a + w)) - (f b - f a)) (f (b + w) - f b - fderiv ℝ f b w)
      have := abs_sub (f (b + w) - f (a + w)) (f b - f a)
      linarith
    · have hbQ : b ∈ Uᶜ ∩ closedBall a 1 := ⟨hb, mem_closedBall.2 (by linarith)⟩
      have hcb : ‖c - b‖ < ρ := by
        have := dist_triangle c a b
        rw [dist_comm a b, dist_eq_norm] at this
        linarith
      have h1 := hρU b hbQ (c - b) hcb
      rw [add_sub_cancel] at h1
      exact h1.trans (mul_le_mul_of_nonneg_right (by linarith) (norm_nonneg _))
  obtain ⟨g, hg, hgA⟩ := whitney Uᶜ f (fderiv ℝ f) hUo.isClosed_compl hW2
  refine ⟨g, hg, (measure_mono fun x hx => ?_).trans_lt hUε⟩
  by_contra hxU
  exact hx (hgA x hxU).symm

/-- **Countably rectifiable sets are covered by `C¹` pieces with injective differential** (Simon
Ch. 3, proof of Lemma 1.2, "only if").  If `M ⊆ ℝ^{n+ℓ}` is countably `n`-rectifiable, then up to a
Borel `Hⁿ`-null set `Z₀` it is covered by countably many images `G_k(B̆_{r_k}(c_k))` of open balls
under `C¹` maps `G_k : ℝⁿ → ℝ^{n+ℓ}` whose differential is injective on the ball and which satisfy
the lower Lipschitz bound `σ_k |b₁ - b₂| ≤ |G_k b₁ - G_k b₂|` there.
Proof: approximate the coordinates of the Lipschitz maps `F_j` of Definition 1.1 by `C¹` functions
(Simon Ch. 2, Theorem 1.5, `aetp_lipschitz_c1_approximation`); the set where `F_j` differs from all
approximations is Lebesgue-null, so its image is `Hⁿ`-null.  The image of the critical set of a `C¹`
map `G : ℝⁿ → ℝ^{n+ℓ}` is `Hⁿ`-null: on a piece where `G` is `η`-close to a non-injective linear `A`
with kernel vector `u`, `G` factors through the linear map `Θ = id - (1 - η) u ⊗ u` (which has
determinant `η`) via an `(‖A‖ + 1)`-Lipschitz map, so the Lipschitz image bound gives
`Hⁿ(G(piece)) ≤ (‖A‖ + 1)ⁿ η Lⁿ(piece)`.  Near a point with injective differential, the
differential is antilipschitz and the mean value inequality gives the injectivity and the lower
Lipschitz bound on a small ball; Lindelöf selects countably many such balls, which are enumerated
(padded with an injective linear map). -/
theorem aetp_rectifiable_c1_piece_cover : ∀ (n ℓ : ℕ), 1 ≤ n → ∀ (M : Set (Amb n ℓ)), Poincare.SimonGMT.Chapter03.CountablyRectifiable n M → ∃ Z₀ : Set (Amb n ℓ), MeasurableSet Z₀ ∧ (μHE[n] : Measure (Amb n ℓ)) Z₀ = 0 ∧ ∃ (G : ℕ → Rn n → Amb n ℓ) (c : ℕ → Rn n) (r σ : ℕ → ℝ), (∀ k, ContDiff ℝ 1 (G k)) ∧ (∀ k, 0 < r k) ∧ (∀ k, 0 < σ k) ∧ (∀ k, ∀ b ∈ ball (c k) (r k), Function.Injective (fderiv ℝ (G k) b)) ∧ (∀ k, ∀ b₁ ∈ ball (c k) (r k), ∀ b₂ ∈ ball (c k) (r k), σ k * ‖b₁ - b₂‖ ≤ ‖G k b₁ - G k b₂‖) ∧ M ⊆ Z₀ ∪ ⋃ k, G k '' ball (c k) (r k) := by
  intro n ℓ hn M hM
  obtain ⟨M₀, hM₀, F, hF, hMcov⟩ := hM
  choose K hK using hF
  have hHvol : (μHE[n] : Measure (Rn n)) = volume := EuclideanSpace.euclideanHausdorffMeasure_eq_volume n
  -- The map squeezing the direction of a unit vector `u` by the factor `η` has determinant `η`.
  have hdet : ∀ (u : Rn n), ‖u‖ = 1 → ∀ (η : ℝ),
      LinearMap.det ((ContinuousLinearMap.id ℝ (Rn n) - (1 - η) • (innerSL ℝ u).smulRight u :
        Rn n →L[ℝ] Rn n) : Rn n →ₗ[ℝ] Rn n) = η := by
    intro u hu η
    set Θ : Rn n →L[ℝ] Rn n := ContinuousLinearMap.id ℝ (Rn n) - (1 - η) • (innerSL ℝ u).smulRight u
    have hΘ : ∀ x, Θ x = x - ((1 - η) * inner ℝ u x) • u := by
      intro x; simp [Θ, mul_smul]
    have hu0 : u ≠ 0 := by rintro rfl; simp at hu
    set P : Submodule ℝ (Rn n) := ℝ ∙ u
    have hP : ∀ k ∈ P, Θ k = η • k := by
      intro k hk
      obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 hk
      rw [hΘ]
      have : inner ℝ u (c • u) = c := by rw [real_inner_smul_right, real_inner_self_eq_norm_sq, hu]; ring
      rw [this, smul_smul, ← sub_smul]; congr 1; ring
    have hP' : ∀ k ∈ Pᗮ, Θ k = k := by
      intro k hk
      rw [hΘ]
      have : inner ℝ u k = 0 :=
        Submodule.inner_right_of_mem_orthogonal (Submodule.mem_span_singleton_self u) hk
      simp [this]
    let e := P.prodEquivOfIsCompl Pᗮ P.isCompl_orthogonal
    have hconj : e.symm.toLinearMap ∘ₗ (Θ : Rn n →ₗ[ℝ] Rn n) ∘ₗ e.symm.symm.toLinearMap =
        LinearMap.prodMap (η • LinearMap.id) LinearMap.id := by
      refine LinearMap.ext fun p => ?_
      obtain ⟨k, k'⟩ := p
      have hep : e.symm.symm (k, k') = (k : Rn n) + k' := rfl
      have hΘp : Θ ((k : Rn n) + k') = e (η • k, k') := by
        rw [map_add, hP k k.2, hP' k' k'.2]; rfl
      simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, ContinuousLinearMap.coe_coe, hep, hΘp,
        LinearEquiv.symm_apply_apply, LinearMap.prodMap_apply, LinearMap.smul_apply,
        LinearMap.id_apply]
    rw [← LinearMap.det_conj (Θ : Rn n →ₗ[ℝ] Rn n) e.symm, hconj, LinearMap.det_prodMap,
      LinearMap.det_smul, LinearMap.det_id, LinearMap.det_id, finrank_span_singleton hu0]
    ring
  -- On a set where `H` is `η`-approximated by a non-injective linear map `A`, the `Hⁿ`-measure of
  -- the image is at most `(‖A‖ + 1)ⁿ η Lⁿ`.
  have key : ∀ (H : Rn n → Amb n ℓ) (A : Rn n →L[ℝ] Amb n ℓ) (s : Set (Rn n)) (L : ℝ) (η : ℝ≥0),
      ¬ Function.Injective A → ‖A‖ ≤ L → η ≤ 1 → ApproximatesLinearOn H A s η →
      (μHE[n] : Measure (Amb n ℓ)) (H '' s) ≤ ENNReal.ofReal (L + 1) ^ n * ((η : ℝ≥0∞) * volume s) := by
    intro H A s L η hA hAL hη1 hHA
    obtain ⟨v, hv0, hAv⟩ : ∃ v, v ≠ 0 ∧ A v = 0 := by
      by_contra h
      push Not at h
      exact hA ((injective_iff_map_eq_zero A).2 fun v hv => by_contra fun hne => h v hne hv)
    set u : Rn n := ‖v‖⁻¹ • v with hu_def
    have hu : ‖u‖ = 1 := norm_smul_inv_norm hv0
    have hAu : A u = 0 := by rw [hu_def, map_smul, hAv, smul_zero]
    have hL0 : 0 ≤ L := (norm_nonneg A).trans hAL
    have hη0 : (0 : ℝ) ≤ η := η.2
    have hη1' : (η : ℝ) ≤ 1 := hη1
    set Θ : Rn n →L[ℝ] Rn n := ContinuousLinearMap.id ℝ (Rn n) - (1 - (η : ℝ)) • (innerSL ℝ u).smulRight u
    have hΘ : ∀ x, Θ x = x - ((1 - (η : ℝ)) * inner ℝ u x) • u := by
      intro x; simp [Θ, mul_smul]
    have hΘn : ∀ x, ‖A x‖ + η * ‖x‖ ≤ (L + 1) * ‖Θ x‖ := by
      intro x
      set a := inner ℝ u x with ha
      have ha2 : a ^ 2 ≤ ‖x‖ ^ 2 := by
        have := abs_real_inner_le_norm u x
        rw [hu, one_mul] at this
        exact sq_le_sq' (abs_le.1 this).1 (abs_le.1 this).2
      have hΘsq : ‖Θ x‖ ^ 2 = ‖x‖ ^ 2 - (1 - (η : ℝ) ^ 2) * a ^ 2 := by
        rw [hΘ, norm_sub_sq_real, real_inner_smul_right, norm_smul, hu, mul_one, Real.norm_eq_abs,
          sq_abs, real_inner_comm u x, ← ha]
        ring
      set w := x - a • u with hw
      have hwsq : ‖w‖ ^ 2 = ‖x‖ ^ 2 - a ^ 2 := by
        rw [hw, norm_sub_sq_real, real_inner_smul_right, norm_smul, hu, mul_one, Real.norm_eq_abs,
          sq_abs, real_inner_comm u x, ← ha]
        ring
      have hAx : A x = A w := by rw [hw, map_sub, map_smul, hAu, smul_zero, sub_zero]
      have h1 : ‖w‖ ≤ ‖Θ x‖ := by
        apply le_of_sq_le_sq _ (norm_nonneg _)
        rw [hwsq, hΘsq]; nlinarith [sq_nonneg (η : ℝ), sq_nonneg a]
      have h2 : (η : ℝ) * ‖x‖ ≤ ‖Θ x‖ := by
        apply le_of_sq_le_sq _ (norm_nonneg _)
        rw [hΘsq, mul_pow]
        have : 0 ≤ 1 - (η : ℝ) ^ 2 := by nlinarith
        nlinarith [mul_le_mul_of_nonneg_left ha2 this]
      calc ‖A x‖ + η * ‖x‖ = ‖A w‖ + η * ‖x‖ := by rw [hAx]
        _ ≤ L * ‖w‖ + ‖Θ x‖ :=
          add_le_add ((A.le_opNorm w).trans (mul_le_mul_of_nonneg_right hAL (norm_nonneg w))) h2
        _ ≤ L * ‖Θ x‖ + ‖Θ x‖ := by gcongr
        _ = (L + 1) * ‖Θ x‖ := by ring
    have hHΘ : ∀ x ∈ s, ∀ y ∈ s, ‖H x - H y‖ ≤ (L + 1) * ‖Θ x - Θ y‖ := by
      intro x hx y hy
      have h := hHA x hx y hy
      calc ‖H x - H y‖ = ‖(H x - H y - A (x - y)) + A (x - y)‖ := by rw [sub_add_cancel]
        _ ≤ ‖H x - H y - A (x - y)‖ + ‖A (x - y)‖ := norm_add_le _ _
        _ ≤ η * ‖x - y‖ + ‖A (x - y)‖ := by gcongr
        _ = ‖A (x - y)‖ + η * ‖x - y‖ := add_comm _ _
        _ ≤ (L + 1) * ‖Θ (x - y)‖ := hΘn (x - y)
        _ = (L + 1) * ‖Θ x - Θ y‖ := by rw [map_sub]
    classical
    let Φ : Rn n → Amb n ℓ := fun y => H (Function.invFunOn Θ s y)
    have hΦ : ∀ x ∈ s, Φ (Θ x) = H x := by
      intro x hx
      have hex : ∃ a ∈ s, Θ a = Θ x := ⟨x, hx, rfl⟩
      have h1 := Function.invFunOn_mem hex
      have h2 := Function.invFunOn_eq hex
      have := hHΘ _ h1 x hx
      rw [h2, sub_self, norm_zero, mul_zero] at this
      exact sub_eq_zero.1 (norm_le_zero_iff.1 this)
    have hΦlip : LipschitzOnWith (Real.toNNReal (L + 1)) Φ (Θ '' s) := by
      refine LipschitzOnWith.of_dist_le_mul fun y₁ hy₁ y₂ hy₂ => ?_
      obtain ⟨x₁, hx₁, rfl⟩ := hy₁
      obtain ⟨x₂, hx₂, rfl⟩ := hy₂
      rw [hΦ x₁ hx₁, hΦ x₂ hx₂, dist_eq_norm, dist_eq_norm, Real.coe_toNNReal _ (by linarith)]
      exact hHΘ x₁ hx₁ x₂ hx₂
    have himg : H '' s = Φ '' (Θ '' s) := by
      rw [image_image]; exact image_congr fun x hx => (hΦ x hx).symm
    have hvolΘ : (μHE[n] : Measure (Rn n)) (Θ '' s) = (η : ℝ≥0∞) * volume s := by
      rw [hHvol]
      have := MeasureTheory.Measure.addHaar_image_linearMap volume (Θ : Rn n →ₗ[ℝ] Rn n) s
      rw [ContinuousLinearMap.coe_coe] at this
      rw [this, hdet u hu, abs_of_nonneg hη0, ENNReal.ofReal_coe_nnreal]
    calc (μHE[n] : Measure (Amb n ℓ)) (H '' s) = μHE[n] (Φ '' (Θ '' s)) := by rw [himg]
      _ ≤ (Real.toNNReal (L + 1) : ℝ≥0∞) ^ n * μHE[n] (Θ '' s) :=
          Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n hΦlip
      _ = ENNReal.ofReal (L + 1) ^ n * ((η : ℝ≥0∞) * volume s) := by rw [hvolΘ]; rfl
  -- The image of the critical set of a `C¹` map `ℝⁿ → ℝ^{n+ℓ}` is `Hⁿ`-null.
  have sard : ∀ H : Rn n → Amb n ℓ, ContDiff ℝ 1 H →
      (μHE[n] : Measure (Amb n ℓ)) (H '' {b | ¬ Function.Injective (fderiv ℝ H b)}) = 0 := by
    intro H hH
    set C := {b | ¬ Function.Injective (fderiv ℝ H b)}
    have hdiff : Differentiable ℝ H := hH.differentiable one_ne_zero
    have hcont : Continuous (fderiv ℝ H) := hH.continuous_fderiv one_ne_zero
    have hCclosed : IsClosed C := by
      have : IsOpen {b | Function.Injective (fderiv ℝ H b)} :=
        ContinuousLinearMap.isOpen_injective.preimage hcont
      exact this.isClosed_compl
    have hcov : H '' C ⊆ ⋃ R : ℕ, H '' (C ∩ closedBall 0 R) := by
      rintro _ ⟨x, hx, rfl⟩
      obtain ⟨R, hR⟩ := exists_nat_ge ‖x‖
      exact mem_iUnion.2 ⟨R, x, ⟨hx, mem_closedBall_zero_iff.2 hR⟩, rfl⟩
    refine measure_mono_null hcov (measure_iUnion_null fun R => ?_)
    set s := C ∩ closedBall (0 : Rn n) R
    obtain ⟨L, hL⟩ :=
      (isCompact_closedBall (0 : Rn n) R).exists_bound_of_continuousOn hcont.continuousOn
    have hsmeas : MeasurableSet s := (hCclosed.inter isClosed_closedBall).measurableSet
    have hbound : ∀ η : ℝ≥0, η ≤ 1 → 0 < η → (μHE[n] : Measure (Amb n ℓ)) (H '' s) ≤
        ENNReal.ofReal (L + 1) ^ n * ((η : ℝ≥0∞) * volume s) := by
      intro η hη1 hη0
      rcases s.eq_empty_or_nonempty with hse | hsne
      · simp [hse]
      obtain ⟨t, A, hdisj, htm, hst, hap, hA⟩ :=
        exists_partition_approximatesLinearOn_of_hasFDerivWithinAt H s (fderiv ℝ H)
          (fun x _ => (hdiff x).hasFDerivAt.hasFDerivWithinAt) (fun _ => η) (fun _ => hη0.ne')
      have hsU : s = ⋃ m, s ∩ t m := by rw [← inter_iUnion]; exact (inter_eq_left.2 hst).symm
      calc (μHE[n] : Measure (Amb n ℓ)) (H '' s) = μHE[n] (⋃ m, H '' (s ∩ t m)) := by
            rw [← image_iUnion, ← hsU]
        _ ≤ ∑' m, (μHE[n] : Measure (Amb n ℓ)) (H '' (s ∩ t m)) := measure_iUnion_le _
        _ ≤ ∑' m, ENNReal.ofReal (L + 1) ^ n * ((η : ℝ≥0∞) * volume (s ∩ t m)) := by
            refine ENNReal.tsum_le_tsum fun m => ?_
            obtain ⟨y, hy, hAy⟩ := hA hsne m
            refine key H (A m) (s ∩ t m) L η ?_ ?_ hη1 (hap m)
            · rw [hAy]; exact hy.1
            · rw [hAy]; exact hL y hy.2
        _ = ENNReal.ofReal (L + 1) ^ n * ((η : ℝ≥0∞) * volume (⋃ m, s ∩ t m)) := by
            rw [ENNReal.tsum_mul_left, ENNReal.tsum_mul_left, measure_iUnion]
            · intro i j hij
              exact (hdisj hij).mono inter_subset_right inter_subset_right
            · exact fun m => hsmeas.inter (htm m)
        _ = ENNReal.ofReal (L + 1) ^ n * ((η : ℝ≥0∞) * volume s) := by rw [← hsU]
    have hV : volume s ≠ ∞ :=
      ((measure_mono inter_subset_right).trans_lt measure_closedBall_lt_top).ne
    have hc : ENNReal.ofReal (L + 1) ^ n ≠ ∞ := ENNReal.pow_ne_top ENNReal.ofReal_ne_top
    have hlim := ENNReal.Tendsto.const_mul
      (ENNReal.Tendsto.mul_const ENNReal.tendsto_inv_nat_nhds_zero (Or.inr hV)) (Or.inr hc)
    rw [zero_mul, mul_zero] at hlim
    refine le_antisymm (ge_of_tendsto hlim ?_) zero_le
    filter_upwards [eventually_ge_atTop 1] with m hm
    have hm0 : (m : ℝ≥0) ≠ 0 := Nat.cast_ne_zero.2 (Nat.one_le_iff_ne_zero.1 hm)
    have := hbound ((m : ℝ≥0)⁻¹) (inv_le_one_of_one_le₀ (by exact_mod_cast hm))
      (inv_pos.2 (Nat.cast_pos.2 hm))
    rwa [ENNReal.coe_inv hm0, ENNReal.coe_natCast] at this
  -- Near a point with injective differential: injectivity and a lower Lipschitz bound on a ball.
  have loc : ∀ (H : Rn n → Amb n ℓ), ContDiff ℝ 1 H → ∀ b, Function.Injective (fderiv ℝ H b) →
      ∃ ρ > 0, ∃ σ > 0, (∀ b' ∈ ball b ρ, Function.Injective (fderiv ℝ H b')) ∧
        ∀ b₁ ∈ ball b ρ, ∀ b₂ ∈ ball b ρ, σ * ‖b₁ - b₂‖ ≤ ‖H b₁ - H b₂‖ := by
    intro H hH b hinj
    set D := fderiv ℝ H b
    obtain ⟨Ka, hKpos, hKa⟩ := (LinearMap.injective_iff_antilipschitz (D : Rn n →ₗ[ℝ] Amb n ℓ)).1 hinj
    have hKpos' : (0 : ℝ) < Ka := hKpos
    have hlow : ∀ x, ‖x‖ ≤ Ka * ‖D x‖ := by
      intro x
      have := hKa.le_mul_dist x 0
      simpa [dist_eq_norm] using this
    set s₀ : ℝ := (Ka : ℝ)⁻¹ with hs₀
    have hs₀pos : 0 < s₀ := inv_pos.2 hKpos'
    have hlow' : ∀ x, s₀ * ‖x‖ ≤ ‖D x‖ := by
      intro x
      rw [hs₀, inv_mul_le_iff₀ hKpos']
      exact hlow x
    have hcont : Continuous (fderiv ℝ H) := hH.continuous_fderiv one_ne_zero
    have hdiff : Differentiable ℝ H := hH.differentiable one_ne_zero
    obtain ⟨ρ, hρ, hρD⟩ := Metric.continuous_iff.1 hcont b (s₀ / 2) (by positivity)
    have hnear : ∀ b' ∈ ball b ρ, ‖fderiv ℝ H b' - D‖ < s₀ / 2 := fun b' hb' => by
      rw [← dist_eq_norm]; exact hρD b' hb'
    refine ⟨ρ, hρ, s₀ / 2, by positivity, ?_, ?_⟩
    · intro b' hb' x y hxy
      by_contra hne
      have hz : x - y ≠ 0 := sub_ne_zero.2 hne
      have h0 : fderiv ℝ H b' (x - y) = 0 := by rw [map_sub, hxy, sub_self]
      have h1 : ‖fderiv ℝ H b' (x - y) - D (x - y)‖ ≤ ‖fderiv ℝ H b' - D‖ * ‖x - y‖ :=
        (fderiv ℝ H b' - D).le_opNorm (x - y)
      rw [h0, zero_sub, norm_neg] at h1
      have h2 := hlow' (x - y)
      have h3 := hnear b' hb'
      have hpos : 0 < ‖x - y‖ := norm_pos_iff.2 hz
      nlinarith
    · intro b₁ hb₁ b₂ hb₂
      have hmv : ‖(H b₁ - D b₁) - (H b₂ - D b₂)‖ ≤ s₀ / 2 * ‖b₁ - b₂‖ := by
        have := (convex_ball b ρ).norm_image_sub_le_of_norm_fderiv_le (𝕜 := ℝ)
          (f := fun x => H x - D x) (C := s₀ / 2) (fun x _ => (hdiff x).sub D.differentiableAt)
          (fun x hx => ?_) hb₂ hb₁
        · simpa using this
        · rw [fderiv_fun_sub (hdiff x) D.differentiableAt, ContinuousLinearMap.fderiv]
          exact (hnear x hx).le
      have h2 := hlow' (b₁ - b₂)
      have h3 : ‖D (b₁ - b₂)‖ ≤ ‖H b₁ - H b₂‖ + ‖(H b₁ - D b₁) - (H b₂ - D b₂)‖ := by
        rw [map_sub]
        calc ‖D b₁ - D b₂‖ = ‖(H b₁ - H b₂) - ((H b₁ - D b₁) - (H b₂ - D b₂))‖ := by
              congr 1; abel
          _ ≤ ‖H b₁ - H b₂‖ + ‖(H b₁ - D b₁) - (H b₂ - D b₂)‖ := norm_sub_le _ _
      linarith
  -- A `C¹` map with injective differential at `0`, used to pad the enumeration.
  obtain ⟨G₀, hG₀, hG₀inj⟩ :
      ∃ G₀ : Rn n → Amb n ℓ, ContDiff ℝ 1 G₀ ∧ Function.Injective (fderiv ℝ G₀ 0) := by
    let p : Fin (n + ℓ) → Fin n := fun q => ⟨q % n, Nat.mod_lt _ hn⟩
    have hp : Function.Surjective p := fun i => ⟨Fin.castAdd ℓ i, Fin.ext (Nat.mod_eq_of_lt i.2)⟩
    let E₀ : Rn n →ₗ[ℝ] Amb n ℓ := (WithLp.linearEquiv 2 ℝ (Fin (n + ℓ) → ℝ)).symm.toLinearMap ∘ₗ
      LinearMap.funLeft ℝ ℝ p ∘ₗ (WithLp.linearEquiv 2 ℝ (Fin n → ℝ)).toLinearMap
    have hE₀ : Function.Injective E₀ :=
      (WithLp.linearEquiv 2 ℝ (Fin (n + ℓ) → ℝ)).symm.injective.comp
        ((LinearMap.funLeft_injective_of_surjective ℝ ℝ p hp).comp
          (WithLp.linearEquiv 2 ℝ (Fin n → ℝ)).injective)
    refine ⟨LinearMap.toContinuousLinearMap E₀, (LinearMap.toContinuousLinearMap E₀).contDiff, ?_⟩
    rw [ContinuousLinearMap.fderiv]
    exact hE₀
  -- `C¹` approximation of the coordinates of the Lipschitz maps `F j`.
  have happrox : ∀ (i j : ℕ) (q : Fin (n + ℓ)), ∃ g : Rn n → ℝ, ContDiff ℝ 1 g ∧
      volume {x | (F j x).ofLp q ≠ g x} < ((i : ℝ≥0∞) + 1)⁻¹ := by
    intro i j q
    exact aetp_lipschitz_c1_approximation n hn (fun x => (F j x).ofLp q) _
      ((EuclideanSpace.proj q : Amb n ℓ →L[ℝ] ℝ).lipschitzWith.comp (hK j)) _
      (ENNReal.inv_pos.2 (by simp))
  choose g hg hgvol using happrox
  let G : ℕ → ℕ → Rn n → Amb n ℓ := fun i j x => WithLp.toLp 2 (fun q => g i j q x)
  have hGC1 : ∀ i j, ContDiff ℝ 1 (G i j) := fun i j => contDiff_euclidean.2 fun q => hg i j q
  -- The points where `F j` differs from every approximation form a Lebesgue-null set.
  let Z : ℕ → Set (Rn n) := fun j => ⋂ i, {x | F j x ≠ G i j x}
  have hZvol : ∀ j, volume (Z j) = 0 := by
    intro j
    have hle : ∀ i : ℕ, volume (Z j) ≤ ((n + ℓ : ℕ) : ℝ≥0∞) * ((i : ℝ≥0∞) + 1)⁻¹ := by
      intro i
      calc volume (Z j) ≤ volume (⋃ q, {x | (F j x).ofLp q ≠ g i j q x}) := by
            refine measure_mono fun x hx => ?_
            have hx' : F j x ≠ G i j x := mem_iInter.1 hx i
            by_contra hcon
            simp only [mem_iUnion, mem_ofPred_eq, not_exists, not_not] at hcon
            exact hx' (PiLp.ext fun q => hcon q)
        _ ≤ ∑ q, volume {x | (F j x).ofLp q ≠ g i j q x} := measure_iUnion_fintype_le _ _
        _ ≤ ∑ _q : Fin (n + ℓ), ((i : ℝ≥0∞) + 1)⁻¹ :=
            Finset.sum_le_sum fun q _ => (hgvol i j q).le
        _ = ((n + ℓ : ℕ) : ℝ≥0∞) * ((i : ℝ≥0∞) + 1)⁻¹ := by simp
    have h0 : Tendsto (fun i : ℕ => ((n + ℓ : ℕ) : ℝ≥0∞) * ((i : ℝ≥0∞) + 1)⁻¹) atTop (𝓝 0) := by
      have h1 : Tendsto (fun i : ℕ => ((i : ℝ≥0∞) + 1)⁻¹) atTop (𝓝 0) := by
        have := ENNReal.tendsto_inv_nat_nhds_zero.comp (tendsto_add_atTop_nat 1)
        simpa [Function.comp_def] using this
      simpa using ENNReal.Tendsto.const_mul h1 (Or.inr (ENNReal.natCast_ne_top (n + ℓ)))
    exact le_antisymm (ge_of_tendsto' h0 hle) zero_le
  have hFZ : ∀ j, (μHE[n] : Measure (Amb n ℓ)) (F j '' Z j) = 0 := by
    intro j
    refine le_antisymm ((Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn
      n ((hK j).lipschitzOnWith)).trans ?_) zero_le
    rw [hHvol, hZvol j, mul_zero]
  -- Radii and lower Lipschitz constants around the points with injective differential.
  have hloc' : ∀ (i j : ℕ) (b : Rn n), ∃ ρ : ℝ, 0 < ρ ∧ ∃ σ : ℝ, 0 < σ ∧
      (Function.Injective (fderiv ℝ (G i j) b) →
        (∀ b' ∈ ball b ρ, Function.Injective (fderiv ℝ (G i j) b')) ∧
          ∀ b₁ ∈ ball b ρ, ∀ b₂ ∈ ball b ρ, σ * ‖b₁ - b₂‖ ≤ ‖G i j b₁ - G i j b₂‖) := by
    intro i j b
    by_cases hb : Function.Injective (fderiv ℝ (G i j) b)
    · obtain ⟨ρ, hρ, σ, hσ, h1, h2⟩ := loc _ (hGC1 i j) b hb
      exact ⟨ρ, hρ, σ, hσ, fun _ => ⟨h1, h2⟩⟩
    · exact ⟨1, one_pos, 1, one_pos, fun h => absurd h hb⟩
  choose ρ hρ σ hσ hρσ using hloc'
  obtain ⟨ρ₀, hρ₀, σ₀, hσ₀, hG₀ball, hG₀low⟩ := loc G₀ hG₀ 0 hG₀inj
  -- Lindelöf: countably many of these balls cover the non-critical set of each `G i j`.
  have hT : ∀ i j, ∃ T : Set (Rn n), T.Countable ∧
      ⋃ b ∈ T, (ball b (ρ i j b) ∩ {_x | Function.Injective (fderiv ℝ (G i j) b)}) =
        ⋃ b, (ball b (ρ i j b) ∩ {_x | Function.Injective (fderiv ℝ (G i j) b)}) :=
    fun i j => TopologicalSpace.isOpen_iUnion_countable _ fun b => isOpen_ball.inter isOpen_const
  choose T hTc hTU using hT
  -- Enumerate the countably many pieces.
  let S : Set (ℕ × ℕ × Rn n) := ⋃ i, ⋃ j, (fun b => (i, j, b)) '' T i j
  have hS : S.Countable := countable_iUnion fun i => countable_iUnion fun j => (hTc i j).image _
  obtain ⟨e, he⟩ := (hS.insert (0, 0, 0)).exists_eq_range (insert_nonempty _ _)
  classical
  let valid : ℕ → Prop := fun k => Function.Injective (fderiv ℝ (G (e k).1 (e k).2.1) (e k).2.2)
  let Gk : ℕ → Rn n → Amb n ℓ := fun k => if valid k then G (e k).1 (e k).2.1 else G₀
  let ck : ℕ → Rn n := fun k => if valid k then (e k).2.2 else 0
  let rk : ℕ → ℝ := fun k => if valid k then ρ (e k).1 (e k).2.1 (e k).2.2 else ρ₀
  let σk : ℕ → ℝ := fun k => if valid k then σ (e k).1 (e k).2.1 (e k).2.2 else σ₀
  -- The exceptional set and its Borel null hull.
  let Zbad : Set (Amb n ℓ) := M₀ ∪ (⋃ j, F j '' Z j) ∪
    ⋃ i, ⋃ j, G i j '' {b | ¬ Function.Injective (fderiv ℝ (G i j) b)}
  have hZbad : (μHE[n] : Measure (Amb n ℓ)) Zbad = 0 :=
    measure_union_null (measure_union_null hM₀ (measure_iUnion_null hFZ))
      (measure_iUnion_null fun i => measure_iUnion_null fun j => sard _ (hGC1 i j))
  refine ⟨toMeasurable μHE[n] Zbad, measurableSet_toMeasurable _ _,
    by rw [measure_toMeasurable]; exact hZbad, Gk, ck, rk, σk, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro k
    by_cases h : valid k
    · simp only [Gk, h, ↓reduceIte]; exact hGC1 _ _
    · simp only [Gk, h, ↓reduceIte]; exact hG₀
  · intro k
    by_cases h : valid k
    · simp only [rk, h, ↓reduceIte]; exact hρ _ _ _
    · simp only [rk, h, ↓reduceIte]; exact hρ₀
  · intro k
    by_cases h : valid k
    · simp only [σk, h, ↓reduceIte]; exact hσ _ _ _
    · simp only [σk, h, ↓reduceIte]; exact hσ₀
  · intro k
    by_cases h : valid k
    · simp only [Gk, ck, rk, h, ↓reduceIte]; exact ((hρσ _ _ _) h).1
    · simp only [Gk, ck, rk, h, ↓reduceIte]; exact hG₀ball
  · intro k
    by_cases h : valid k
    · simp only [Gk, ck, rk, σk, h, ↓reduceIte]; exact ((hρσ _ _ _) h).2
    · simp only [Gk, ck, rk, σk, h, ↓reduceIte]; exact hG₀low
  · intro x hx
    rcases hMcov hx with hx0 | hx1
    · exact Or.inl (subset_toMeasurable _ _ (Or.inl (Or.inl hx0)))
    · obtain ⟨j, z, rfl⟩ := mem_iUnion.1 hx1
      by_cases hz : z ∈ Z j
      · exact Or.inl (subset_toMeasurable _ _ (Or.inl (Or.inr (mem_iUnion.2 ⟨j, mem_image_of_mem _ hz⟩))))
      · simp only [Z, mem_iInter, mem_ofPred_eq, not_forall, not_not] at hz
        obtain ⟨i, hi⟩ := hz
        by_cases hzC : Function.Injective (fderiv ℝ (G i j) z)
        · have hzU : z ∈ ⋃ b, (ball b (ρ i j b) ∩ {_x | Function.Injective (fderiv ℝ (G i j) b)}) :=
            mem_iUnion.2 ⟨z, mem_ball_self (hρ i j z), hzC⟩
          rw [← hTU i j] at hzU
          simp only [mem_iUnion, mem_inter_iff, mem_ofPred_eq, exists_prop] at hzU
          obtain ⟨b, hbT, hzb, hbinj⟩ := hzU
          have hmem : (i, j, b) ∈ range e := by
            rw [← he]
            exact Or.inr (mem_iUnion.2 ⟨i, mem_iUnion.2 ⟨j, mem_image_of_mem _ hbT⟩⟩)
          obtain ⟨k, hk⟩ := hmem
          have hv : valid k := by simp only [valid, hk]; exact hbinj
          refine Or.inr (mem_iUnion.2 ⟨k, ?_⟩)
          simp only [Gk, ck, rk, hv, ↓reduceIte, hk]
          exact ⟨z, hzb, hi.symm⟩
        · exact Or.inl (subset_toMeasurable _ _
            (Or.inr (mem_iUnion.2 ⟨i, mem_iUnion.2 ⟨j, ⟨z, hzC, hi.symm⟩⟩⟩)))

/-- Simon Ch. 3, 1.4 for an embedded `C¹` piece: if `G : ℝⁿ → ℝ^{n+ℓ}` is `C¹` with injective
derivative on `B = B̆_r(c)` and `σ|b₁ - b₂| ≤ |G(b₁) - G(b₂)|` on `B` (`σ > 0`), then `N = G(B)` is
Borel with `Hⁿ(N) < ∞`, and `DG(b)(ℝⁿ)` is the approximate tangent space of `N` at every `G(b)`.
Borel: Lusin–Souslin.  Finite: `G` is Lipschitz on `B`.  Tangent: by strict differentiability,
`‖G u - G v - DG(b)(u - v)‖ ≤ η‖u - v‖` near `b`; with `L = DG(b)`, `K = B_{R/σ}(0)` and
`Γ_λ(z) = λ⁻¹(G(b + λz) - G(b))`, the map `Φ = Γ_λ ∘ L⁻¹` is `(1 ± δ)`-bi-Lipschitz from `L(K)`
onto a piece of `η_{G(b),λ}(N)` containing `η_{G(b),λ}(N) ∩ {f ≠ 0}`; hence
`(1 - δ)ⁿ Φ_#(Hⁿ ⌞ L(K)) ≤ Hⁿ ⌞ Φ(L(K)) ≤ (1 + δ)ⁿ Φ_#(Hⁿ ⌞ L(K))`, and `|f ∘ Φ - f|` is
uniformly small on `L(K)`, while `Hⁿ ⌞ L(K)` carries `∫_P f dHⁿ`. -/
theorem aetp_c1_piece_approxTangent : ∀ (n ℓ : ℕ) (G : Rn n → Amb n ℓ) (c : Rn n) (r σ : ℝ), ContDiff ℝ 1 G → 0 < σ → (∀ b ∈ ball c r, Function.Injective (fderiv ℝ G b)) → (∀ b₁ ∈ ball c r, ∀ b₂ ∈ ball c r, σ * ‖b₁ - b₂‖ ≤ ‖G b₁ - G b₂‖) → MeasurableSet (G '' ball c r) ∧ (μHE[n] : Measure (Amb n ℓ)) (G '' ball c r) < ⊤ ∧ ∀ b ∈ ball c r, Poincare.SimonGMT.Chapter03.HasApproximateTangentSpaceAt n (G '' ball c r) (G b) (LinearMap.range (fderiv ℝ G b).toLinearMap) := by
  intro n ℓ G c r σ hG hσ hinj hlow
  have hGc : Continuous G := hG.continuous
  -- `G` is injective on `B` by the lower bound.
  have hGinj : InjOn G (ball c r) := by
    intro b₁ h₁ b₂ h₂ heq
    have h := hlow b₁ h₁ b₂ h₂
    rw [heq, sub_self, norm_zero] at h
    have h' : ‖b₁ - b₂‖ ≤ 0 := le_of_mul_le_mul_left (by rwa [mul_zero]) hσ
    exact sub_eq_zero.1 (norm_le_zero_iff.1 h')
  -- (i) Borel: Lusin–Souslin.
  have hNmeas : MeasurableSet (G '' ball c r) :=
    measurableSet_ball.image_of_continuousOn_injOn hGc.continuousOn hGinj
  refine ⟨hNmeas, ?_, ?_⟩
  · -- (ii) `G` is Lipschitz on the convex set `B`, so `Hⁿ(G(B)) ≤ Cⁿ Lⁿ(B) < ∞`.
    obtain ⟨C, hC⟩ := (isCompact_closedBall c r).exists_bound_of_continuousOn
      (hG.continuous_fderiv one_ne_zero).continuousOn
    have hlip : LipschitzOnWith (Real.toNNReal C) G (ball c r) := by
      refine (convex_ball c r).lipschitzOnWith_of_nnnorm_fderiv_le (𝕜 := ℝ)
        (fun x _ => hG.differentiable one_ne_zero x) fun x hx => ?_
      rw [← NNReal.coe_le_coe, coe_nnnorm, Real.coe_toNNReal']
      exact le_max_of_le_left (hC x (ball_subset_closedBall hx))
    calc (μHE[n] : Measure (Amb n ℓ)) (G '' ball c r)
        ≤ (Real.toNNReal C : ℝ≥0∞) ^ n * (μHE[n] : Measure (Rn n)) (ball c r) :=
          Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n hlip
      _ < ⊤ := by
          rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
          exact ENNReal.mul_lt_top (ENNReal.pow_lt_top ENNReal.coe_lt_top) measure_ball_lt_top
  · -- (iii) the approximate tangent space at `G b`.
    intro b hb
    set L : Rn n →L[ℝ] Amb n ℓ := fderiv ℝ G b
    have hLinj : Function.Injective L := hinj b hb
    refine ⟨?_, fun f => ?_⟩
    · rw [LinearMap.finrank_range_of_inj (f := (L : Rn n →ₗ[ℝ] Amb n ℓ)) hLinj,
        finrank_euclideanSpace_fin]
    -- Strict differentiability at `b`, in the form of a local two-point estimate.
    have hstrict : HasStrictFDerivAt G L b := hG.contDiffAt.hasStrictFDerivAt one_ne_zero
    have hloc : ∀ η > 0, ∃ ρ > 0, ball b ρ ⊆ ball c r ∧
        ∀ u ∈ ball b ρ, ∀ v ∈ ball b ρ, ‖G u - G v - L (u - v)‖ ≤ η * ‖u - v‖ := by
      intro η hη
      obtain ⟨ρ₁, hρ₁, h₁⟩ :=
        Metric.eventually_nhds_iff.1 (Asymptotics.isLittleO_iff.1 hstrict.isLittleO hη)
      obtain ⟨ρ₂, hρ₂, h₂⟩ := Metric.isOpen_iff.1 isOpen_ball b hb
      refine ⟨min ρ₁ ρ₂, lt_min hρ₁ hρ₂, (ball_subset_ball (min_le_right _ _)).trans h₂, ?_⟩
      intro u hu v hv
      have hu' : dist u b < ρ₁ := lt_of_lt_of_le (mem_ball.1 hu) (min_le_left _ _)
      have hv' : dist v b < ρ₁ := lt_of_lt_of_le (mem_ball.1 hv) (min_le_left _ _)
      exact @h₁ (u, v) (by rw [Prod.dist_eq]; exact max_lt hu' hv')
    -- The lower bound passes to the derivative: `σ‖v‖ ≤ ‖L v‖`.
    have hLlow : ∀ v, σ * ‖v‖ ≤ ‖L v‖ := by
      intro v
      apply le_of_forall_pos_le_add
      intro ε hε
      obtain ⟨ρ, hρ, hρB, hρest⟩ := hloc (ε / (‖v‖ + 1)) (by positivity)
      set t : ℝ := ρ / (2 * (‖v‖ + 1)) with ht
      have ht0 : 0 < t := by positivity
      have htv : t * ‖v‖ < ρ := by
        rw [ht, div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
        exact mul_lt_mul_of_pos_left (by linarith only [norm_nonneg v]) hρ
      have hu : b + t • v ∈ ball b ρ := by
        rw [mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg ht0.le]
        exact htv
      have e1 := hlow (b + t • v) (hρB hu) b hb
      have e2 := hρest (b + t • v) hu b (mem_ball_self hρ)
      rw [add_sub_cancel_left, norm_smul, Real.norm_of_nonneg ht0.le] at e1 e2
      rw [map_smul] at e2
      have e3 : ‖G (b + t • v) - G b‖ ≤ t * ‖L v‖ + ε / (‖v‖ + 1) * (t * ‖v‖) := by
        calc ‖G (b + t • v) - G b‖ = ‖(G (b + t • v) - G b - t • L v) + t • L v‖ := by
              congr 1; abel
          _ ≤ ‖G (b + t • v) - G b - t • L v‖ + ‖t • L v‖ := norm_add_le _ _
          _ ≤ ε / (‖v‖ + 1) * (t * ‖v‖) + t * ‖L v‖ := by
              rw [norm_smul, Real.norm_of_nonneg ht0.le]; exact add_le_add e2 le_rfl
          _ = t * ‖L v‖ + ε / (‖v‖ + 1) * (t * ‖v‖) := by ring
      have e4 : t * (σ * ‖v‖) ≤ t * (‖L v‖ + ε / (‖v‖ + 1) * ‖v‖) := by
        linarith only [e1, e3]
      have e5 : σ * ‖v‖ ≤ ‖L v‖ + ε / (‖v‖ + 1) * ‖v‖ := le_of_mul_le_mul_left e4 ht0
      have e6 : ε / (‖v‖ + 1) * ‖v‖ ≤ ε := by
        rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
        exact mul_le_mul_of_nonneg_left (le_add_of_nonneg_right zero_le_one) hε.le
      linarith only [e5, e6]
    -- A linear left inverse `M` of `L`.
    obtain ⟨Mlin, hMlin⟩ :=
      LinearMap.exists_leftInverse_of_injective (L : Rn n →ₗ[ℝ] Amb n ℓ)
        (LinearMap.ker_eq_bot.2 hLinj)
    have hML : ∀ z, Mlin (L z) = z := fun z => by
      simpa using LinearMap.congr_fun hMlin z
    have hMc : Continuous Mlin := LinearMap.continuous_of_finiteDimensional Mlin
    -- Data of the test function `f`.
    have hfc : Continuous f := map_continuous f
    have hfcs : HasCompactSupport f := f.hasCompactSupport
    obtain ⟨R₀, hR₀⟩ := hfcs.isCompact.isBounded.subset_closedBall 0
    set R : ℝ := max R₀ 1
    have hR0 : 0 < R := lt_of_lt_of_le one_pos (le_max_right _ _)
    have hsupp : ∀ y, f y ≠ 0 → ‖y‖ ≤ R := by
      intro y hy
      have h := hR₀ (subset_tsupport f hy)
      rw [mem_closedBall, dist_zero_right] at h
      exact h.trans (le_max_left _ _)
    obtain ⟨Mf₀, hMf₀⟩ := hfc.bounded_above_of_compact_support hfcs
    set Mf : ℝ := max Mf₀ 0
    have hMf0 : 0 ≤ Mf := le_max_right _ _
    have hfM : ∀ y, |f y| ≤ Mf := fun y => by
      rw [← Real.norm_eq_abs]; exact (hMf₀ y).trans (le_max_left _ _)
    have hfuc : UniformContinuous f := hfcs.uniformContinuous_of_continuous hfc
    -- The compact parameter set `K` and the plane piece `A = L(K)`.
    set R' : ℝ := R / σ with hR'
    have hR'0 : 0 < R' := div_pos hR0 hσ
    set K : Set (Rn n) := closedBall 0 R' with hK
    set A : Set (Amb n ℓ) := L '' K
    have hKc : IsCompact K := isCompact_closedBall 0 R'
    have hAc : IsCompact A := hKc.image L.continuous
    have hAmeas : MeasurableSet A := hAc.isClosed.measurableSet
    have hAfin : (μHE[n] : Measure (Amb n ℓ)) A < ⊤ := by
      calc (μHE[n] : Measure (Amb n ℓ)) A
          ≤ (‖L‖₊ : ℝ≥0∞) ^ n * (μHE[n] : Measure (Rn n)) K :=
            Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
              L.lipschitzWith.lipschitzOnWith
        _ < ⊤ := by
            rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
            exact ENNReal.mul_lt_top (ENNReal.pow_lt_top ENNReal.coe_lt_top) hKc.measure_lt_top
    set HA : ℝ := ((μHE[n] : Measure (Amb n ℓ)) A).toReal
    have hHA0 : 0 ≤ HA := ENNReal.toReal_nonneg
    -- The limit integral lives on `A`.
    have hI0 : ∫ y in (LinearMap.range (L : Rn n →ₗ[ℝ] Amb n ℓ) : Set (Amb n ℓ)), f y ∂μHE[n] =
        ∫ y in A, f y ∂μHE[n] := by
      apply setIntegral_eq_of_subset_of_forall_sdiff_eq_zero
      · exact (Submodule.closed_of_finiteDimensional _).measurableSet
      · rintro _ ⟨z, -, rfl⟩
        exact LinearMap.mem_range_self (L : Rn n →ₗ[ℝ] Amb n ℓ) z
      · rintro y ⟨hyP, hyA⟩
        by_contra hfy
        obtain ⟨v, rfl⟩ := LinearMap.mem_range.1 hyP
        apply hyA
        refine ⟨v, ?_, rfl⟩
        rw [hK, mem_closedBall, dist_zero_right, hR', le_div_iff₀ hσ]
        have h1 := hsupp _ hfy
        have h2 := hLlow v
        simp only [ContinuousLinearMap.coe_coe] at h1
        linarith
    rw [Metric.tendsto_nhds]
    intro ε hε
    -- Choice of the parameters.
    obtain ⟨τ, hτ, hτf⟩ := Metric.uniformContinuous_iff.1 hfuc (ε / (2 * (HA + 1))) (by positivity)
    have hκcont : Tendsto (fun d : ℝ => (((1 - d)⁻¹) ^ n - 1) * ((1 - d)⁻¹) ^ n) (𝓝 0) (𝓝 0) := by
      have h1 : ContinuousAt (fun d : ℝ => (1 - d)⁻¹) 0 :=
        ((continuous_const.sub continuous_id).continuousAt).inv₀ (by norm_num)
      have h2 : ContinuousAt (fun d : ℝ => (((1 - d)⁻¹) ^ n - 1) * ((1 - d)⁻¹) ^ n) 0 :=
        ((h1.pow n).sub continuousAt_const).mul (h1.pow n)
      simpa using h2.tendsto
    obtain ⟨d₀, hd₀, hd₀'⟩ := Metric.eventually_nhds_iff.1
      (hκcont.eventually (eventually_lt_nhds
        (show (0 : ℝ) < ε / (4 * (Mf + 1) * (HA + 1)) by positivity)))
    set δ : ℝ := min (d₀ / 2) (1 / 2)
    have hδ0 : 0 < δ := lt_min (by positivity) (by norm_num)
    have hδ1 : δ ≤ 1 / 2 := min_le_right _ _
    set κ : ℝ := ((1 - δ)⁻¹) ^ n
    have hκbound : (κ - 1) * κ < ε / (4 * (Mf + 1) * (HA + 1)) := by
      apply hd₀'
      rw [Real.dist_eq, sub_zero, abs_of_pos hδ0]
      exact lt_of_le_of_lt (min_le_left _ _) (half_lt_self hd₀)
    have hκ1 : 1 ≤ κ :=
      one_le_pow₀ ((one_le_inv₀ (by linarith only [hδ1])).2 (by linarith only [hδ0]))
    set η : ℝ := min (δ * σ) (τ / (2 * (R' + 1)))
    have hη0 : 0 < η := lt_min (by positivity) (by positivity)
    obtain ⟨ρ, hρ, hρB, hρest⟩ := hloc η hη0
    filter_upwards [Ioo_mem_nhdsGT (show (0 : ℝ) < ρ / (R' + 1) by positivity)] with lam hlam
    obtain ⟨hlam0, hlam1⟩ := hlam
    -- The rescaled parametrization `Γ` and the comparison map `Φ = Γ ∘ M`.
    set Γ : Rn n → Amb n ℓ := fun z => lam⁻¹ • (G (b + lam • z) - G b) with hΓ
    set Φ : Amb n ℓ → Amb n ℓ := fun y => Γ (Mlin y) with hΦ
    have hΦL : ∀ z, Φ (L z) = Γ z := fun z => by
      simp only [hΦ, hML]
    have hΦc : Continuous Φ := by
      simp only [hΦ, hΓ]
      fun_prop
    have hΦm : Measurable Φ := hΦc.measurable
    have hball : ∀ z ∈ K, b + lam • z ∈ ball b ρ := by
      intro z hz
      rw [mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hlam0.le]
      have hz' : ‖z‖ ≤ R' := mem_closedBall_zero_iff.1 hz
      have h1 : lam * (R' + 1) < ρ := by rwa [lt_div_iff₀ (by positivity)] at hlam1
      calc lam * ‖z‖ ≤ lam * (R' + 1) :=
          mul_le_mul_of_nonneg_left (by linarith only [hz']) hlam0.le
        _ < ρ := h1
    have hΓest : ∀ z ∈ K, ∀ w ∈ K, ‖Γ z - Γ w - L (z - w)‖ ≤ η * ‖z - w‖ := by
      intro z hz w hw
      have h := hρest _ (hball z hz) _ (hball w hw)
      have heq : Γ z - Γ w - L (z - w) =
          lam⁻¹ • (G (b + lam • z) - G (b + lam • w) - L (lam • (z - w))) := by
        simp only [hΓ, map_sub, map_smul, smul_sub, inv_smul_smul₀ hlam0.ne']
        abel
      rw [heq, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hlam0.le)]
      rw [add_sub_add_left_eq_sub, ← smul_sub, norm_smul, Real.norm_of_nonneg hlam0.le] at h
      calc lam⁻¹ * ‖G (b + lam • z) - G (b + lam • w) - L (lam • (z - w))‖
          ≤ lam⁻¹ * (η * (lam * ‖z - w‖)) := mul_le_mul_of_nonneg_left h (inv_nonneg.2 hlam0.le)
        _ = η * ‖z - w‖ := by rw [mul_left_comm, inv_mul_cancel_left₀ hlam0.ne']
    -- `Φ` is `(1 ± δ)`-bi-Lipschitz on `A`.
    have hΦest : ∀ p ∈ A, ∀ q ∈ A, ‖(Φ p - Φ q) - (p - q)‖ ≤ δ * ‖p - q‖ := by
      rintro _ ⟨z, hz, rfl⟩ _ ⟨w, hw, rfl⟩
      rw [hΦL, hΦL, ← map_sub]
      calc ‖Γ z - Γ w - L (z - w)‖ ≤ η * ‖z - w‖ := hΓest z hz w hw
        _ ≤ (δ * σ) * ‖z - w‖ := mul_le_mul_of_nonneg_right (min_le_left _ _) (norm_nonneg _)
        _ = δ * (σ * ‖z - w‖) := mul_assoc _ _ _
        _ ≤ δ * ‖L (z - w)‖ := mul_le_mul_of_nonneg_left (hLlow _) hδ0.le
    have hΦup : ∀ p ∈ A, ∀ q ∈ A, dist (Φ p) (Φ q) ≤ (1 + δ) * dist p q := by
      intro p hp q hq
      rw [dist_eq_norm, dist_eq_norm]
      have h := hΦest p hp q hq
      calc ‖Φ p - Φ q‖ = ‖(Φ p - Φ q - (p - q)) + (p - q)‖ := by congr 1; abel
        _ ≤ ‖Φ p - Φ q - (p - q)‖ + ‖p - q‖ := norm_add_le _ _
        _ ≤ (1 + δ) * ‖p - q‖ := by linarith only [h]
    have hΦlow : ∀ p ∈ A, ∀ q ∈ A, (1 - δ) * dist p q ≤ dist (Φ p) (Φ q) := by
      intro p hp q hq
      rw [dist_eq_norm, dist_eq_norm]
      have h := hΦest p hp q hq
      have h2 : ‖p - q‖ ≤ ‖Φ p - Φ q‖ + ‖Φ p - Φ q - (p - q)‖ := by
        calc ‖p - q‖ = ‖(Φ p - Φ q) - (Φ p - Φ q - (p - q))‖ := by congr 1; abel
          _ ≤ ‖Φ p - Φ q‖ + ‖Φ p - Φ q - (p - q)‖ := norm_sub_le _ _
      linarith only [h, h2]
    have hlip1 : LipschitzOnWith (Real.toNNReal (1 + δ)) Φ A := by
      apply LipschitzOnWith.of_dist_le_mul
      intro p hp q hq
      rw [Real.coe_toNNReal _ (by linarith only [hδ0])]
      exact hΦup p hp q hq
    have hΦinj : InjOn Φ A := by
      intro p hp q hq hpq
      have h := hΦlow p hp q hq
      rw [hpq, dist_self] at h
      have h' : dist p q ≤ 0 :=
        le_of_mul_le_mul_left (by rwa [mul_zero]) (by linarith only [hδ1] : (0 : ℝ) < 1 - δ)
      exact dist_le_zero.1 h'
    set Ψ : Amb n ℓ → Amb n ℓ := Function.invFunOn Φ A
    have hΨΦ : LeftInvOn Ψ Φ A := hΦinj.leftInvOn_invFunOn
    have hlip2 : LipschitzOnWith (Real.toNNReal (1 - δ)⁻¹) Ψ (Φ '' A) := by
      apply LipschitzOnWith.of_dist_le_mul
      rintro _ ⟨p, hp, rfl⟩ _ ⟨q, hq, rfl⟩
      rw [hΨΦ hp, hΨΦ hq, Real.coe_toNNReal _ (inv_nonneg.2 (by linarith only [hδ1])),
        le_inv_mul_iff₀ (by linarith only [hδ1])]
      exact hΦlow p hp q hq
    -- The three measures and their comparison.
    set μ₃ : Measure (Amb n ℓ) := (μHE[n] : Measure (Amb n ℓ)).restrict A with hμ₃
    set μ₂ : Measure (Amb n ℓ) := μ₃.map Φ with hμ₂
    set μ₁ : Measure (Amb n ℓ) := (μHE[n] : Measure (Amb n ℓ)).restrict (Φ '' A) with hμ₁
    set κ₁ : ℝ≥0∞ := (Real.toNNReal (1 + δ) : ℝ≥0∞) ^ n with hκ₁
    set κ₂ : ℝ≥0∞ := (Real.toNNReal (1 - δ)⁻¹ : ℝ≥0∞) ^ n with hκ₂
    have hκ₁top : κ₁ ≠ ⊤ := ENNReal.pow_ne_top ENNReal.coe_ne_top
    have hκ₂top : κ₂ ≠ ⊤ := ENNReal.pow_ne_top ENNReal.coe_ne_top
    have hκ₁le : κ₁.toReal ≤ κ := by
      rw [hκ₁, ENNReal.toReal_pow, ENNReal.coe_toReal, Real.coe_toNNReal _ (by linarith only [hδ0])]
      apply pow_le_pow_left₀ (by linarith only [hδ0])
      rw [← one_div, le_div_iff₀ (by linarith only [hδ1])]
      linarith only [mul_self_nonneg δ]
    have hκ₂eq : κ₂.toReal = κ := by
      rw [hκ₂, ENNReal.toReal_pow, ENNReal.coe_toReal,
        Real.coe_toNNReal _ (inv_nonneg.2 (by linarith only [hδ1]))]
    have hμ12 : μ₁ ≤ κ₁ • μ₂ := by
      rw [Measure.le_iff]
      intro S hS
      rw [Measure.smul_apply, smul_eq_mul, hμ₂, Measure.map_apply hΦm hS, hμ₁, hμ₃,
        Measure.restrict_apply hS, Measure.restrict_apply (hS.preimage hΦm), ← image_preimage_inter]
      exact Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
        (hlip1.mono inter_subset_right)
    have hμ21 : μ₂ ≤ κ₂ • μ₁ := by
      rw [Measure.le_iff]
      intro S hS
      rw [Measure.smul_apply, smul_eq_mul, hμ₂, Measure.map_apply hΦm hS, hμ₁, hμ₃,
        Measure.restrict_apply hS, Measure.restrict_apply (hS.preimage hΦm)]
      have hT : Ψ '' (Φ '' (Φ ⁻¹' S ∩ A)) = Φ ⁻¹' S ∩ A :=
        (hΨΦ.mono inter_subset_right).image_image
      calc (μHE[n] : Measure (Amb n ℓ)) (Φ ⁻¹' S ∩ A)
          = (μHE[n] : Measure (Amb n ℓ)) (Ψ '' (Φ '' (Φ ⁻¹' S ∩ A))) := by rw [hT]
        _ ≤ κ₂ * (μHE[n] : Measure (Amb n ℓ)) (Φ '' (Φ ⁻¹' S ∩ A)) :=
            Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
              (hlip2.mono (image_mono inter_subset_right))
        _ = κ₂ * (μHE[n] : Measure (Amb n ℓ)) (S ∩ Φ '' A) := by rw [image_preimage_inter]
    have hμ₃fin : IsFiniteMeasure μ₃ := ⟨by rw [hμ₃, Measure.restrict_apply_univ]; exact hAfin⟩
    have hμ₂fin : IsFiniteMeasure μ₂ := Measure.isFiniteMeasure_map μ₃ Φ
    have hμ₁fin : IsFiniteMeasure μ₁ := ⟨by
      calc μ₁ univ ≤ (κ₁ • μ₂) univ := hμ12 univ
        _ < ⊤ := by
          rw [Measure.smul_apply, smul_eq_mul]
          exact ENNReal.mul_lt_top (lt_top_iff_ne_top.2 hκ₁top) (measure_lt_top μ₂ univ)⟩
    have hμ₃univ : μ₃.real univ = HA := by
      rw [measureReal_def, hμ₃, Measure.restrict_apply_univ]
    have hμ₂univ : μ₂.real univ = HA := by
      rw [measureReal_def, hμ₂, Measure.map_apply hΦm MeasurableSet.univ, preimage_univ,
        ← measureReal_def, hμ₃univ]
    -- Sandwich estimate for nonnegative bounded continuous functions.
    have hsand : ∀ g : Amb n ℓ → ℝ, Continuous g → (∀ y, 0 ≤ g y) → (∀ y, g y ≤ Mf) →
        |∫ y, g y ∂μ₁ - ∫ y, g y ∂μ₂| ≤ (κ - 1) * κ * (Mf * HA) := by
      intro g hgc hg0 hgM
      have hgb : ∀ y, ‖g y‖ ≤ Mf := fun y => by rw [Real.norm_of_nonneg (hg0 y)]; exact hgM y
      have hg1 : Integrable g μ₁ :=
        Integrable.of_bound hgc.aestronglyMeasurable Mf (ae_of_all _ hgb)
      have hg2 : Integrable g μ₂ :=
        Integrable.of_bound hgc.aestronglyMeasurable Mf (ae_of_all _ hgb)
      have ha0 : 0 ≤ ∫ y, g y ∂μ₂ := integral_nonneg hg0
      have hb0 : 0 ≤ ∫ y, g y ∂μ₁ := integral_nonneg hg0
      have haM : ∫ y, g y ∂μ₂ ≤ Mf * HA := by
        have h := norm_integral_le_of_norm_le_const (μ := μ₂) (ae_of_all _ hgb)
        rwa [Real.norm_of_nonneg ha0, hμ₂univ] at h
      have h1 : ∫ y, g y ∂μ₁ ≤ κ * ∫ y, g y ∂μ₂ := by
        calc ∫ y, g y ∂μ₁ ≤ ∫ y, g y ∂(κ₁ • μ₂) :=
              integral_mono_measure hμ12 (ae_of_all _ hg0) (hg2.smul_measure hκ₁top)
          _ = κ₁.toReal * ∫ y, g y ∂μ₂ := by rw [integral_smul_measure, smul_eq_mul]
          _ ≤ κ * ∫ y, g y ∂μ₂ := mul_le_mul_of_nonneg_right hκ₁le ha0
      have h2 : ∫ y, g y ∂μ₂ ≤ κ * ∫ y, g y ∂μ₁ := by
        calc ∫ y, g y ∂μ₂ ≤ ∫ y, g y ∂(κ₂ • μ₁) :=
              integral_mono_measure hμ21 (ae_of_all _ hg0) (hg1.smul_measure hκ₂top)
          _ = κ₂.toReal * ∫ y, g y ∂μ₁ := by rw [integral_smul_measure, smul_eq_mul]
          _ = κ * ∫ y, g y ∂μ₁ := by rw [hκ₂eq]
      have hk0 : 0 ≤ κ - 1 := sub_nonneg.2 hκ1
      have h3 : (κ - 1) * ∫ y, g y ∂μ₁ ≤ (κ - 1) * (κ * ∫ y, g y ∂μ₂) :=
        mul_le_mul_of_nonneg_left h1 hk0
      have h4 : (κ - 1) * κ * ∫ y, g y ∂μ₂ ≤ (κ - 1) * κ * (Mf * HA) :=
        mul_le_mul_of_nonneg_left haM (mul_nonneg hk0 (zero_le_one.trans hκ1))
      have h5 : (κ - 1) * ∫ y, g y ∂μ₂ ≤ (κ - 1) * κ * ∫ y, g y ∂μ₂ := by
        have := mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hκ1 ha0) hk0
        linarith only [this]
      rw [abs_le]
      constructor <;> linarith only [h1, h2, h3, h4, h5]
    -- The blown-up piece: `η_{G b, λ}(N) ∩ {f ≠ 0} ⊆ Φ(A) ⊆ η_{G b, λ}(N)`.
    have hNlam :
        ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap (G b) lam '' (G '' ball c r), f y ∂μHE[n] =
          ∫ y, f y ∂μ₁ := by
      rw [hμ₁]
      apply setIntegral_eq_of_subset_of_forall_sdiff_eq_zero
      · rw [Set.image_eq_preimage_of_inverse (g := fun y => G b + lam • y)
          (fun w => by
            simp only [Poincare.SimonGMT.Chapter03.blowUpMap]
            rw [smul_inv_smul₀ hlam0.ne', add_sub_cancel])
          (fun y => by
            simp only [Poincare.SimonGMT.Chapter03.blowUpMap]
            rw [add_sub_cancel_left, inv_smul_smul₀ hlam0.ne'])]
        exact hNmeas.preimage (continuous_const.add (continuous_const_smul lam)).measurable
      · rintro _ ⟨_, ⟨z, hz, rfl⟩, rfl⟩
        rw [hΦL]
        exact ⟨G (b + lam • z), ⟨b + lam • z, hρB (hball z hz), rfl⟩, rfl⟩
      · rintro y ⟨⟨_, ⟨b', hb', rfl⟩, rfl⟩, hyA⟩
        by_contra hfy
        apply hyA
        have hy := hsupp _ hfy
        simp only [Poincare.SimonGMT.Chapter03.blowUpMap, norm_smul,
          Real.norm_of_nonneg (inv_nonneg.2 hlam0.le)] at hy
        have h2 := hlow b' hb' b hb
        have hz : ‖lam⁻¹ • (b' - b)‖ ≤ R' := by
          rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hlam0.le), hR', le_div_iff₀ hσ]
          calc lam⁻¹ * ‖b' - b‖ * σ = lam⁻¹ * (σ * ‖b' - b‖) := by ring
            _ ≤ lam⁻¹ * ‖G b' - G b‖ := mul_le_mul_of_nonneg_left h2 (inv_nonneg.2 hlam0.le)
            _ ≤ R := hy
        refine ⟨L (lam⁻¹ • (b' - b)), ⟨lam⁻¹ • (b' - b), mem_closedBall_zero_iff.2 hz, rfl⟩, ?_⟩
        rw [hΦL]
        simp only [hΓ, Poincare.SimonGMT.Chapter03.blowUpMap, smul_smul,
          mul_inv_cancel₀ hlam0.ne', one_smul, add_sub_cancel]
    -- `f ∘ Φ` is uniformly close to `f` on `A`.
    have hclose : ∀ y ∈ A, |f (Φ y) - f y| < ε / (2 * (HA + 1)) := by
      rintro _ ⟨z, hz, rfl⟩
      have h0K : (0 : Rn n) ∈ K := mem_closedBall_self hR'0.le
      have h := hΓest z hz 0 h0K
      have hΓ0 : Γ 0 = 0 := by simp only [hΓ, smul_zero, add_zero, sub_self]
      rw [hΓ0, sub_zero, sub_zero] at h
      have hzR : ‖z‖ ≤ R' := mem_closedBall_zero_iff.1 hz
      have hηR : η * R' < τ := by
        have h1 : η ≤ τ / (2 * (R' + 1)) := min_le_right _ _
        have h2 : τ / (2 * (R' + 1)) * R' < τ := by
          rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
          exact mul_lt_mul_of_pos_left (by linarith only [hR'0]) hτ
        calc η * R' ≤ τ / (2 * (R' + 1)) * R' := mul_le_mul_of_nonneg_right h1 hR'0.le
          _ < τ := h2
      have hd : dist (Φ (L z)) (L z) < τ := by
        rw [hΦL, dist_eq_norm]
        calc ‖Γ z - L z‖ ≤ η * ‖z‖ := h
          _ ≤ η * R' := mul_le_mul_of_nonneg_left hzR hη0.le
          _ < τ := hηR
      have h' := hτf hd
      rwa [Real.dist_eq] at h'
    have hfi : ∀ μ : Measure (Amb n ℓ), IsFiniteMeasure μ → ∀ g : Amb n ℓ → ℝ, Continuous g →
        (∀ y, |g y| ≤ Mf) → Integrable g μ := fun μ _ g hgc hgM =>
      Integrable.of_bound hgc.aestronglyMeasurable Mf
        (ae_of_all _ fun y => by rw [Real.norm_eq_abs]; exact hgM y)
    have hE1 : |∫ y, f (Φ y) ∂μ₃ - ∫ y, f y ∂μ₃| ≤ ε / (2 * (HA + 1)) * HA := by
      rw [← integral_sub (hfi μ₃ hμ₃fin (fun y => f (Φ y)) (hfc.comp hΦc) fun y => hfM _)
        (hfi μ₃ hμ₃fin _ hfc hfM)]
      have h := norm_integral_le_of_norm_le_const (μ := μ₃) (f := fun y => f (Φ y) - f y)
        (C := ε / (2 * (HA + 1)))
        ((ae_restrict_iff' hAmeas).2 (ae_of_all _ fun y hy => by
          rw [Real.norm_eq_abs]; exact (hclose y hy).le))
      rwa [Real.norm_eq_abs, hμ₃univ] at h
    have hE2 : |∫ y, f y ∂μ₁ - ∫ y, f y ∂μ₂| ≤ 2 * ((κ - 1) * κ * (Mf * HA)) := by
      have hpm : ∀ μ : Measure (Amb n ℓ), IsFiniteMeasure μ →
          ∫ y, f y ∂μ = ∫ y, max (f y) 0 ∂μ - ∫ y, max (-f y) 0 ∂μ := by
        intro μ hμ
        rw [← integral_sub]
        · congr 1
          funext y
          rw [max_zero_sub_max_neg_zero_eq_self]
        · exact hfi μ hμ _ (hfc.max continuous_const) fun y => by
            rw [abs_of_nonneg (le_max_right _ _)]
            exact max_le ((le_abs_self _).trans (hfM y)) hMf0
        · exact hfi μ hμ _ (hfc.neg.max continuous_const) fun y => by
            rw [abs_of_nonneg (le_max_right _ _)]
            exact max_le ((neg_le_abs _).trans (hfM y)) hMf0
      have e1 := hsand (fun y => max (f y) 0) (hfc.max continuous_const) (fun y => le_max_right _ _)
        fun y => max_le ((le_abs_self _).trans (hfM y)) hMf0
      have e2 := hsand (fun y => max (-f y) 0) (hfc.neg.max continuous_const)
        (fun y => le_max_right _ _) fun y => max_le ((neg_le_abs _).trans (hfM y)) hMf0
      rw [hpm μ₁ hμ₁fin, hpm μ₂ hμ₂fin]
      calc |(∫ y, max (f y) 0 ∂μ₁ - ∫ y, max (-f y) 0 ∂μ₁) -
            (∫ y, max (f y) 0 ∂μ₂ - ∫ y, max (-f y) 0 ∂μ₂)|
          = |(∫ y, max (f y) 0 ∂μ₁ - ∫ y, max (f y) 0 ∂μ₂) -
            (∫ y, max (-f y) 0 ∂μ₁ - ∫ y, max (-f y) 0 ∂μ₂)| := by congr 1; ring
        _ ≤ |∫ y, max (f y) 0 ∂μ₁ - ∫ y, max (f y) 0 ∂μ₂| +
            |∫ y, max (-f y) 0 ∂μ₁ - ∫ y, max (-f y) 0 ∂μ₂| := abs_sub _ _
        _ ≤ 2 * ((κ - 1) * κ * (Mf * HA)) := by linarith only [e1, e2]
    have hmap : ∫ y, f y ∂μ₂ = ∫ y, f (Φ y) ∂μ₃ :=
      integral_map hΦm.aemeasurable hfc.aestronglyMeasurable
    -- Conclusion.
    rw [Real.dist_eq, hNlam, show (LinearMap.range (fderiv ℝ G b).toLinearMap : Set (Amb n ℓ)) =
      (LinearMap.range (L : Rn n →ₗ[ℝ] Amb n ℓ) : Set (Amb n ℓ)) from rfl, hI0]
    have hX0 : 0 ≤ (κ - 1) * κ := mul_nonneg (sub_nonneg.2 hκ1) (zero_le_one.trans hκ1)
    have hX : (κ - 1) * κ * (4 * (Mf + 1) * (HA + 1)) < ε := by
      rwa [lt_div_iff₀ (by positivity)] at hκbound
    have hMH : Mf * HA ≤ (Mf + 1) * (HA + 1) := by
      calc Mf * HA ≤ Mf * HA + (Mf + HA + 1) :=
            le_add_of_nonneg_right (by linarith only [hMf0, hHA0])
        _ = (Mf + 1) * (HA + 1) := by ring
    have hfin1 : 2 * ((κ - 1) * κ * (Mf * HA)) ≤ ε / 2 := by
      have := mul_le_mul_of_nonneg_left hMH hX0
      linarith only [this, hX]
    have hfin2 : ε / (2 * (HA + 1)) * HA < ε / 2 := by
      rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
      linarith only [hε]
    calc |∫ y, f y ∂μ₁ - ∫ y in A, f y ∂μHE[n]|
        ≤ |∫ y, f y ∂μ₁ - ∫ y, f y ∂μ₂| + |∫ y, f y ∂μ₂ - ∫ y in A, f y ∂μHE[n]| :=
          abs_sub_le _ _ _
      _ = |∫ y, f y ∂μ₁ - ∫ y, f y ∂μ₂| + |∫ y, f (Φ y) ∂μ₃ - ∫ y, f y ∂μ₃| := by
          rw [hmap]
      _ < ε := by linarith only [hE1, hE2, hfin1, hfin2]

/-- **Blow-up integrals over a set of zero `n`-density vanish** (the error estimate in Simon Ch. 3,
proof of Theorem 1.6 `⇒`): if `Hⁿ(S ∩ B_r(x)) / rⁿ → 0` as `r ↓ 0`, then
`∫_{η_{x,r}(S)} f dHⁿ → 0` as `r ↓ 0` for every `f ∈ C_c(ℝ^{n+ℓ}, ℝ)`, where
`η_{x,r}(y) = r⁻¹(y − x)`.  No measurability or finiteness of `S` is needed.

Simon's estimate, inline (SimonGMT's `Chapter04.hausdorff_blowUp_image` is outside the frozen
import closure).  Choose `R > 0` with `f = 0` off `B_R(0)` and `C` with `|f| ≤ C`.  For `r > 0`,
`η_{x,r}` is a translation followed by the dilation by `r⁻¹`, so `Hⁿ(η_{x,r}(T)) = r⁻ⁿ Hⁿ(T)`;
since `η_{x,r}⁻¹(B_R(0)) = B_{rR}(x)`, this gives
`Hⁿ(η_{x,r}(S) ∩ B_R(0)) = r⁻ⁿ Hⁿ(S ∩ B_{rR}(x)) = Rⁿ · Hⁿ(S ∩ B_{rR}(x)) / (rR)ⁿ → 0`.  Hence
`|∫_{η_{x,r}(S)} f dHⁿ| = |∫_{B_R(0)} f d(Hⁿ ⌞ η_{x,r}(S))| ≤ C Hⁿ(η_{x,r}(S) ∩ B_R(0)) → 0`. -/
theorem aetp_blowUp_integral_tendsto_zero_of_density_zero : ∀ (n ℓ : ℕ) (x : Amb n ℓ) (S : Set (Amb n ℓ)), Tendsto (fun r : ℝ => (μHE[n] : Measure (Amb n ℓ)) (S ∩ closedBall x r) / ENNReal.ofReal (r ^ n)) (𝓝[>] 0) (𝓝 0) → ∀ f : CompactlySupportedContinuousMap (Amb n ℓ) ℝ, Tendsto (fun r : ℝ => ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' S, f y ∂(μHE[n] : Measure (Amb n ℓ))) (𝓝[>] 0) (𝓝 0) := by
  intro n ℓ x S hS f
  -- `f` vanishes off `B_R(0)` and `|f| ≤ C`.
  obtain ⟨R₀, hR₀⟩ := f.hasCompactSupport.isCompact.isBounded.subset_closedBall (0 : Amb n ℓ)
  obtain ⟨R, hRpos, hf0⟩ : ∃ R : ℝ, 0 < R ∧ ∀ y, y ∉ closedBall (0 : Amb n ℓ) R → f y = 0 :=
    ⟨max R₀ 1, zero_lt_one.trans_le (le_max_right _ _), fun y hy => by
      by_contra hfy
      exact hy (closedBall_subset_closedBall (le_max_left _ _) (hR₀ (subset_tsupport _ hfy)))⟩
  obtain ⟨C, hC⟩ := f.continuous.bounded_above_of_compact_support f.hasCompactSupport
  -- Scaling: `Hⁿ(η_{x,r}(T)) = ofReal(rⁿ)⁻¹ Hⁿ(T)` for `r > 0`.
  have hscale : ∀ r : ℝ, 0 < r → ∀ T : Set (Amb n ℓ),
      (μHE[n] : Measure (Amb n ℓ)) (Poincare.SimonGMT.Chapter03.blowUpMap x r '' T) =
        (ENNReal.ofReal (r ^ n))⁻¹ * (μHE[n] : Measure (Amb n ℓ)) T := by
    intro r hr T
    have h := Measure.euclideanHausdorffMeasure_smul₀ (E := Amb n ℓ) n (inv_ne_zero hr.ne')
      ((IsometryEquiv.subRight x) '' T)
    rw [← Set.image_smul, Set.image_image,
      (IsometryEquiv.subRight x).isometry.euclideanHausdorffMeasure_image, ENNReal.smul_def,
      smul_eq_mul] at h
    refine Eq.trans h ?_
    congr 1
    rw [← ENNReal.ofReal_inv_of_pos (pow_pos hr n), ← ENNReal.ofReal_coe_nnreal, NNReal.coe_pow,
      coe_nnnorm, Real.norm_of_nonneg (inv_nonneg.2 hr.le), inv_pow]
  -- Ball identity: `η_{x,r}⁻¹(B_R(0)) = B_{rR}(x)` for `r > 0`.
  have hpre : ∀ r : ℝ, 0 < r →
      Poincare.SimonGMT.Chapter03.blowUpMap x r ⁻¹' closedBall 0 R = closedBall x (r * R) := by
    intro r hr
    ext y
    simp only [Set.mem_preimage, mem_closedBall_iff_norm, sub_zero,
      Poincare.SimonGMT.Chapter03.blowUpMap, norm_smul, norm_inv, Real.norm_eq_abs, abs_of_pos hr]
    exact inv_mul_le_iff₀ hr
  -- `Hⁿ(η_{x,r}(S) ∩ B_R(0)) = ofReal(Rⁿ) · Hⁿ(S ∩ B_{rR}(x)) / ofReal((rR)ⁿ) → 0` as `r ↓ 0`.
  have hmul : Tendsto (fun r : ℝ => r * R) (𝓝[>] 0) (𝓝[>] 0) := by
    refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ ?_ ?_
    · have h := (tendsto_id (x := 𝓝 (0 : ℝ))).mul_const R
      rw [zero_mul] at h
      exact h.mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with r hr
      exact mul_pos hr hRpos
  have hg : Tendsto (fun r : ℝ => (μHE[n] : Measure (Amb n ℓ))
      (Poincare.SimonGMT.Chapter03.blowUpMap x r '' S ∩ closedBall 0 R)) (𝓝[>] 0) (𝓝 0) := by
    have h1 := ENNReal.Tendsto.const_mul (hS.comp hmul) (Or.inr ENNReal.ofReal_ne_top)
      (a := ENNReal.ofReal (R ^ n))
    rw [mul_zero] at h1
    refine h1.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with r hr
    have hR' : ENNReal.ofReal (R ^ n) ≠ 0 := (ENNReal.ofReal_pos.2 (pow_pos hRpos n)).ne'
    rw [Function.comp_apply, ← Set.image_inter_preimage, hpre r hr, hscale r hr, mul_pow,
      ENNReal.ofReal_mul (pow_nonneg hr.le n), ← mul_div_assoc, mul_comm (ENNReal.ofReal (R ^ n)),
      ENNReal.mul_div_mul_right _ _ hR' ENNReal.ofReal_ne_top, ENNReal.div_eq_inv_mul]
  -- `|∫_{η_{x,r}(S)} f dHⁿ| ≤ C Hⁿ(η_{x,r}(S) ∩ B_R(0))` once the latter is finite.
  have hbound : ∀ᶠ r in 𝓝[>] (0 : ℝ),
      ‖∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' S, f y ∂(μHE[n] : Measure (Amb n ℓ))‖ ≤
        C * ((μHE[n] : Measure (Amb n ℓ))
          (Poincare.SimonGMT.Chapter03.blowUpMap x r '' S ∩ closedBall 0 R)).toReal := by
    filter_upwards [hg.eventually (gt_mem_nhds ENNReal.zero_lt_top)] with r hr
    have h2 : ((μHE[n] : Measure (Amb n ℓ)).restrict
        (Poincare.SimonGMT.Chapter03.blowUpMap x r '' S)) (closedBall 0 R) =
        (μHE[n] : Measure (Amb n ℓ))
          (Poincare.SimonGMT.Chapter03.blowUpMap x r '' S ∩ closedBall 0 R) := by
      rw [Measure.restrict_apply measurableSet_closedBall, Set.inter_comm]
    rw [← setIntegral_eq_integral_of_forall_compl_eq_zero hf0, ← h2]
    exact norm_setIntegral_le_of_norm_le_const (h2 ▸ hr) (fun y _ => hC y)
  have hlim : Tendsto (fun r : ℝ => C * ((μHE[n] : Measure (Amb n ℓ))
      (Poincare.SimonGMT.Chapter03.blowUpMap x r '' S ∩ closedBall 0 R)).toReal)
      (𝓝[>] 0) (𝓝 0) := by
    simpa using ((ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp hg).const_mul C
  exact squeeze_zero_norm' hbound hlim

/-- **Simon Ch. 3, Remark 1.5(2) / proof of Theorem 1.6 "⇒" at a single point** (locality of the
approximate tangent space): let `A, N ⊆ ℝ^{n+ℓ}` be Borel with `Hⁿ(A), Hⁿ(N) < ∞`, such that
`A \ N` and `N \ A` both have `n`-density `0` at `x`.  If `Q` is the approximate tangent space of
`N` at `x`, then it is also the approximate tangent space of `A` at `x`.

Simon's proof, with `M ↦ A`, `N_j ↦ N`, `M_j ↦ A ∩ N`.  For `r > 0` the blow-up `η_{x,r}` is a
homeomorphism with inverse `z ↦ x + r • z` that scales `Hⁿ` by `r⁻ⁿ`.  So every `f ∈ C_c` is
integrable on the images of `A ∩ N`, `A \ N` and `N \ A`, and additivity gives
`∫_{η_r(A)} f = ∫_{η_r(N)} f - ∫_{η_r(N \ A)} f + ∫_{η_r(A \ N)} f`.  As `r ↓ 0` the first term
tends to `∫_Q f` by hypothesis, and the two error terms tend to `0` by
`aetp_blowUp_integral_tendsto_zero_of_density_zero`. -/
theorem aetp_approxTangent_of_density_zero_symmDiff : ∀ (n ℓ : ℕ) (A N : Set (Amb n ℓ)) (x : Amb n ℓ) (Q : Submodule ℝ (Amb n ℓ)), MeasurableSet A → MeasurableSet N → (μHE[n] : Measure (Amb n ℓ)) A < ⊤ → (μHE[n] : Measure (Amb n ℓ)) N < ⊤ → Tendsto (fun r : ℝ => (μHE[n] : Measure (Amb n ℓ)) ((A \ N) ∩ closedBall x r) / ENNReal.ofReal (r ^ n)) (𝓝[>] 0) (𝓝 0) → Tendsto (fun r : ℝ => (μHE[n] : Measure (Amb n ℓ)) ((N \ A) ∩ closedBall x r) / ENNReal.ofReal (r ^ n)) (𝓝[>] 0) (𝓝 0) → Poincare.SimonGMT.Chapter03.HasApproximateTangentSpaceAt n N x Q → Poincare.SimonGMT.Chapter03.HasApproximateTangentSpaceAt n A x Q := by
  intro n ℓ A N x Q hA hN hAμ hNμ hAN hNA hNQ
  -- Step 1: `finrank Q = n` is part of the hypothesis on `N`; fix a test function `f`.
  refine ⟨hNQ.1, fun f => ?_⟩
  -- Step 2: `∫_{η_r(N)} f - ∫_{η_r(N \ A)} f + ∫_{η_r(A \ N)} f → ∫_Q f - 0 + 0`.
  have hlim := ((hNQ.2 f).sub
    (Submission.aetp_blowUp_integral_tendsto_zero_of_density_zero n ℓ x (N \ A) hNA f)).add
    (Submission.aetp_blowUp_integral_tendsto_zero_of_density_zero n ℓ x (A \ N) hAN f)
  rw [sub_zero, add_zero] at hlim
  -- Step 3: it suffices to prove the decomposition identity `(∗)` for each fixed `r > 0`.
  refine hlim.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with r (hr : 0 < r)
  -- Step 4: `η_r` has the continuous inverse `g z = x + r • z`, so `η_r(S) = g⁻¹(S)`: images of
  -- Borel sets are Borel, and unions and disjointness pass to images.
  set g : Amb n ℓ → Amb n ℓ := fun z => x + r • z
  have hg : Continuous g := continuous_const.add (continuous_const_smul r)
  have himg : ∀ S : Set (Amb n ℓ), Poincare.SimonGMT.Chapter03.blowUpMap x r '' S = g ⁻¹' S := by
    intro S
    refine congrFun (image_eq_preimage_of_inverse (fun y => ?_) (fun z => ?_)) S
    · simp [g, Poincare.SimonGMT.Chapter03.blowUpMap, smul_smul, hr.ne']
    · simp [g, Poincare.SimonGMT.Chapter03.blowUpMap, smul_smul, hr.ne']
  -- Step 5: `Hⁿ(η_r(T)) = r⁻ⁿ Hⁿ(T)` (an isometric translation followed by a homothety), so
  -- `η_r` preserves finiteness of `Hⁿ`.
  have hshift : Isometry fun y : Amb n ℓ => y - x := by
    apply Isometry.of_dist_eq
    intro y z
    simp only [dist_eq_norm]
    congr 1
    abel
  have hfin : ∀ T : Set (Amb n ℓ), (μHE[n] : Measure (Amb n ℓ)) T < ⊤ →
      (μHE[n] : Measure (Amb n ℓ)) (g ⁻¹' T) < ⊤ := by
    intro T hT
    have himage : g ⁻¹' T =
        AffineMap.homothety (0 : Amb n ℓ) r⁻¹ '' ((fun y : Amb n ℓ => y - x) '' T) := by
      rw [← himg, ← image_comp]
      congr 1
      funext y
      simp [Poincare.SimonGMT.Chapter03.blowUpMap, AffineMap.homothety_apply]
    rw [himage, euclideanHausdorffMeasure_homothety_image n (0 : Amb n ℓ) (inv_ne_zero hr.ne'),
      hshift.euclideanHausdorffMeasure_image, ENNReal.smul_def, smul_eq_mul]
    exact ENNReal.mul_lt_top ENNReal.coe_lt_top hT
  -- Step 6: `f` is bounded, hence integrable on every set of finite measure.
  obtain ⟨C, hC⟩ := f.continuous.bounded_above_of_compact_support f.hasCompactSupport
  have hint : ∀ T : Set (Amb n ℓ), (μHE[n] : Measure (Amb n ℓ)) T < ⊤ →
      IntegrableOn f (g ⁻¹' T) (μHE[n] : Measure (Amb n ℓ)) := fun T hT =>
    Measure.integrableOn_of_bounded (hfin T hT).ne f.continuous.aestronglyMeasurable
      (ae_of_all _ hC)
  have hANμ : (μHE[n] : Measure (Amb n ℓ)) (A ∩ N) < ⊤ :=
    (measure_mono inter_subset_left).trans_lt hAμ
  have hAdNμ : (μHE[n] : Measure (Amb n ℓ)) (A \ N) < ⊤ := (measure_mono sdiff_subset).trans_lt hAμ
  have hNdAμ : (μHE[n] : Measure (Amb n ℓ)) (N \ A) < ⊤ := (measure_mono sdiff_subset).trans_lt hNμ
  -- Step 7: additivity over `A = (A ∩ N) ∪ (A \ N)` and `N = (A ∩ N) ∪ (N \ A)`; eliminating
  -- `∫_{η_r(A ∩ N)} f` gives `(∗)`.
  have hAsplit : g ⁻¹' A = g ⁻¹' (A ∩ N) ∪ g ⁻¹' (A \ N) := by
    rw [← preimage_union, inter_union_sdiff]
  have hNsplit : g ⁻¹' N = g ⁻¹' (A ∩ N) ∪ g ⁻¹' (N \ A) := by
    rw [← preimage_union, inter_comm A N, inter_union_sdiff]
  simp only [himg]
  rw [hAsplit, hNsplit,
    setIntegral_union ((disjoint_sdiff_right.mono_left inter_subset_right).preimage g)
      (hg.measurable (hA.diff hN)) (hint _ hANμ) (hint _ hAdNμ),
    setIntegral_union ((disjoint_sdiff_right.mono_left inter_subset_left).preimage g)
      (hg.measurable (hN.diff hA)) (hint _ hANμ) (hint _ hNdAμ)]
  ring

/-- **Simon Ch. 3, Remark 1.5(2)** (locality of approximate tangent spaces, from the proof of
Theorem 1.6 "⇒"): if `A, N ⊆ ℝ^{n+ℓ}` are Borel with `Hⁿ(A), Hⁿ(N) < ∞` and `P(x) = T_x N` for
every `x ∈ N`, then `P(x) = T_x A` for `Hⁿ`-a.e. `x ∈ A ∩ N`.

The Upper Density Theorem (`aetp_upper_density_zero_ae` with `ν = Hⁿ`) applied to `A \ N` and to
`N \ A` gives `Hⁿ((A \ N) ∩ B_r(x)) / rⁿ → 0` and `Hⁿ((N \ A) ∩ B_r(x)) / rⁿ → 0` as `r ↓ 0` for
`Hⁿ`-a.e. `x` outside the respective set, hence for `Hⁿ`-a.e. `x ∈ A ∩ N`.  At such `x` the blow-ups
`η_{x,r}(A)` and `η_{x,r}(N)` differ by the images of these two sets, whose integrals vanish in the
limit, so `T_x A = T_x N = P(x)` (`aetp_approxTangent_of_density_zero_symmDiff`). -/
theorem aetp_approxTangent_ae_of_inter : ∀ (n ℓ : ℕ) (A N : Set (Amb n ℓ)) (P : Amb n ℓ → Submodule ℝ (Amb n ℓ)), MeasurableSet A → MeasurableSet N → (μHE[n] : Measure (Amb n ℓ)) A < ⊤ → (μHE[n] : Measure (Amb n ℓ)) N < ⊤ → (∀ x ∈ N, Poincare.SimonGMT.Chapter03.HasApproximateTangentSpaceAt n N x (P x)) → ∀ᵐ x ∂(μHE[n] : Measure (Amb n ℓ)).restrict (A ∩ N), Poincare.SimonGMT.Chapter03.HasApproximateTangentSpaceAt n A x (P x) := by
  intro n ℓ A N P hA hN hAfin hNfin hP
  -- Upper density zero for `A \ N` and `N \ A` (Borel, of finite `Hⁿ` measure), with `ν = Hⁿ`.
  have hAN := Submission.aetp_upper_density_zero_ae n ℓ (μHE[n]) (A \ N) (hA.diff hN)
    ((measure_mono sdiff_subset).trans_lt hAfin)
  have hNA := Submission.aetp_upper_density_zero_ae n ℓ (μHE[n]) (N \ A) (hN.diff hA)
    ((measure_mono sdiff_subset).trans_lt hNfin)
  -- A point of `A ∩ N` lies in neither `A \ N` nor `N \ A`, so both limits hold
  -- `Hⁿ ⌞ (A ∩ N)`-a.e.
  filter_upwards [ae_restrict_mem (hA.inter hN), ae_restrict_of_ae hAN, ae_restrict_of_ae hNA]
    with x hx hxAN hxNA
  -- At such `x ∈ N`, `T_x N = P(x)` transfers to `A`.
  exact Submission.aetp_approxTangent_of_density_zero_symmDiff n ℓ A N x (P x) hA hN hAfin hNfin
    (hxAN fun h => h.2 hx.2) (hxNA fun h => h.2 hx.1) (hP x hx.2)

/-- **`Hⁿ ⌞ P` on balls about `0`** (the normalization `Hⁿ = Lⁿ` on `n`-planes, Simon's Notation
p. ix, with scaling).  If `P ⊆ ℝ^{n+ℓ}` is an `n`-dimensional subspace and `s ≥ 0`, then
`Hⁿ(P ∩ B_s(0)) = ω_n sⁿ`.  The inclusion `P → ℝ^{n+ℓ}` is an isometry, so `Hⁿ ⌞ P` is the image
of `Hⁿ` on `P`, which is Lebesgue measure of the `n`-dimensional inner product space `P`; there
`|B_s(0)| = sⁿ |B_1(0)|`.  Mathlib's value of `|B_1(0)|` lies outside the frozen import closure, so
it is computed here by evaluating `I = ∫_P e^{-|x|²} dx` twice: in orthonormal coordinates
`I = (∫_ℝ e^{-t²} dt)ⁿ = π^{n/2}` (Fubini), while the layer-cake formula with
`{e^{-|x|²} > t} = B_{√(-log t)}(0)` and the substitution `t = e^{-u}` give
`I = |B_1(0)| ∫_0^∞ u^{n/2} e^{-u} du = |B_1(0)| Γ(n/2 + 1)`. -/
theorem rsod_planeMeasure_closedBall : ∀ (n ℓ : ℕ), 1 ≤ n → ∀ (P : Submodule ℝ (Amb n ℓ)), Module.finrank ℝ P = n → ∀ s : ℝ, 0 ≤ s → ((μHE[n] : Measure (Amb n ℓ)).restrict (P : Set (Amb n ℓ))) (closedBall 0 s) = ENNReal.ofReal (unitBallVolume n * s ^ n) := by
  intro n ℓ hn P hP s hs
  have : Nontrivial P := Module.nontrivial_of_finrank_pos (R := ℝ) (by omega)
  -- `Hⁿ ⌞ P` is the image of `Hⁿ` on `P` under the isometric inclusion `ι : P → ℝ^{n+ℓ}`, and
  -- `ι⁻¹(B_s(0))` is the closed ball `B_s(0)` of `P`.
  have hrange : range (P.subtypeₗᵢ : P → Amb n ℓ) = (P : Set (Amb n ℓ)) := by ext x; simp
  rw [← hrange, ← P.subtypeₗᵢ.isometry.map_euclideanHausdorffMeasure,
    Measure.map_apply P.subtypeₗᵢ.continuous.measurable measurableSet_closedBall]
  have hpre : (P.subtypeₗᵢ : P → Amb n ℓ) ⁻¹' closedBall (0 : Amb n ℓ) s =
      closedBall (0 : P) s := by
    ext x; simp [mem_closedBall, dist_eq_norm]
  -- On the `n`-dimensional inner product space `P`, `Hⁿ` is Lebesgue measure.
  have hvol : (μHE[n] : Measure P) = volume := by
    have h := InnerProductSpace.euclideanHausdorffMeasure_eq_volume (V := P); rwa [hP] at h
  -- `∫_ℝ e^{-t²} dt = √π`.
  have hA : ∫⁻ x : ℝ, ENNReal.ofReal (Real.exp (-x ^ 2)) = ENNReal.ofReal (√Real.pi) := by
    have h := integral_gaussian 1
    simp only [neg_mul, one_mul, div_one] at h
    rw [← h, ofReal_integral_eq_lintegral_ofReal]
    · simpa using integrable_exp_neg_mul_sq (b := 1) one_pos
    · exact ae_of_all _ (fun x => (Real.exp_pos _).le)
  -- Fubini, splitting off the first coordinate: `∫_{ℝᵐ} e^{-|y|²} dy = (√π)ᵐ`.
  have hB : ∀ m : ℕ, ∫⁻ x : Fin m → ℝ, ENNReal.ofReal (Real.exp (-∑ i, x i ^ 2)) =
      ENNReal.ofReal (√Real.pi) ^ m := by
    intro m
    induction m with
    | zero => simp [volume_pi]
    | succ m ih =>
      have e := volume_preserving_piFinSuccAbove (fun _ : Fin (m + 1) => ℝ) 0
      have hf : Measurable fun p : ℝ × (Fin m → ℝ) =>
          ENNReal.ofReal (Real.exp (-p.1 ^ 2)) * ENNReal.ofReal (Real.exp (-∑ i, p.2 i ^ 2)) := by
        fun_prop
      calc ∫⁻ x : Fin (m + 1) → ℝ, ENNReal.ofReal (Real.exp (-∑ i, x i ^ 2))
          = ∫⁻ x : Fin (m + 1) → ℝ, (fun p : ℝ × (Fin m → ℝ) =>
              ENNReal.ofReal (Real.exp (-p.1 ^ 2)) * ENNReal.ofReal (Real.exp (-∑ i, p.2 i ^ 2)))
                (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (m + 1) => ℝ) 0 x) := by
            refine lintegral_congr fun x => ?_
            simp only [MeasurableEquiv.piFinSuccAbove_apply, Fin.sum_univ_succ]
            rw [← ENNReal.ofReal_mul (Real.exp_pos _).le, ← Real.exp_add, neg_add]
            rfl
        _ = ∫⁻ p : ℝ × (Fin m → ℝ), ENNReal.ofReal (Real.exp (-p.1 ^ 2)) *
              ENNReal.ofReal (Real.exp (-∑ i, p.2 i ^ 2)) := e.lintegral_comp hf
        _ = (∫⁻ a : ℝ, ENNReal.ofReal (Real.exp (-a ^ 2))) *
              ∫⁻ y : Fin m → ℝ, ENNReal.ofReal (Real.exp (-∑ i, y i ^ 2)) :=
            lintegral_prod_mul (f := fun a : ℝ => ENNReal.ofReal (Real.exp (-a ^ 2)))
              (g := fun y : Fin m → ℝ => ENNReal.ofReal (Real.exp (-∑ i, y i ^ 2)))
              (by fun_prop) (Measurable.aemeasurable (by fun_prop))
        _ = ENNReal.ofReal (√Real.pi) ^ (m + 1) := by rw [hA, ih, pow_succ']
  -- In orthonormal coordinates on `P`: `∫_P e^{-|x|²} dx = (√π)^{dim P}`.
  have hC : ∫⁻ x : P, ENNReal.ofReal (Real.exp (-‖x‖ ^ 2)) =
      ENNReal.ofReal (√Real.pi) ^ Module.finrank ℝ P := by
    have e := (PiLp.volume_preserving_ofLp (Fin (Module.finrank ℝ P))).comp
      (stdOrthonormalBasis ℝ P).measurePreserving_repr
    rw [← hB, ← e.lintegral_comp (by fun_prop)]
    refine lintegral_congr fun x => ?_
    rw [← (stdOrthonormalBasis ℝ P).repr.norm_map x, EuclideanSpace.norm_sq_eq]
    simp [Real.norm_eq_abs, sq_abs]
  -- `t = e^{-u}`: `∫_0^∞ (√(-log t))^{dim P} dt = ∫_0^∞ u^{dim P/2} e^{-u} du = Γ(dim P/2 + 1)`.
  have hE : ∫⁻ t in Ioi (0 : ℝ), ENNReal.ofReal (√(-Real.log t) ^ Module.finrank ℝ P) =
      ENNReal.ofReal (Real.Gamma ((Module.finrank ℝ P : ℝ) / 2 + 1)) := by
    have himg : (fun u : ℝ => Real.exp (-u)) '' univ = Ioi 0 := by
      rw [image_univ]; ext t; simp only [mem_range, mem_Ioi]
      constructor
      · rintro ⟨u, rfl⟩; exact Real.exp_pos _
      · intro ht; exact ⟨-Real.log t, by rw [neg_neg, Real.exp_log ht]⟩
    rw [← himg, lintegral_image_eq_lintegral_abs_deriv_mul MeasurableSet.univ
        (fun u _ => (hasDerivAt_neg u).exp.hasDerivWithinAt)
        (fun u _ v _ h => by simpa using h), Measure.restrict_univ]
    simp only [mul_neg, mul_one, abs_neg, abs_of_pos (Real.exp_pos _), Real.log_exp, neg_neg]
    rw [Real.Gamma_eq_integral (by positivity), ofReal_integral_eq_lintegral_ofReal
      (Real.GammaIntegral_convergent (by positivity))
      (ae_restrict_of_forall_mem measurableSet_Ioi fun u hu => by
        have : 0 < u := hu
        positivity)]
    rw [← setLIntegral_eq_of_support_subset (s := Ioi 0)]
    · refine setLIntegral_congr_fun measurableSet_Ioi fun u hu => ?_
      have hu : 0 < u := hu
      rw [← ENNReal.ofReal_mul (Real.exp_pos _).le, Real.sqrt_eq_rpow, ← Real.rpow_natCast,
        ← Real.rpow_mul hu.le]
      congr 3
      ring
    · intro u hu
      by_contra h
      simp only [mem_Ioi, not_lt] at h
      apply hu
      simp [Real.sqrt_eq_zero'.2 h, zero_pow (by omega : Module.finrank ℝ P ≠ 0)]
  -- Layer cake: `{x ∈ P : e^{-|x|²} > t}` is the ball `B_{√(-log t)}(0)` of `P`.
  have hD : ∫⁻ x : P, ENNReal.ofReal (Real.exp (-‖x‖ ^ 2)) =
      ENNReal.ofReal (Real.Gamma ((Module.finrank ℝ P : ℝ) / 2 + 1)) * volume (ball (0 : P) 1) := by
    rw [lintegral_eq_lintegral_meas_lt volume (ae_of_all _ fun x => (Real.exp_pos _).le)
      (by fun_prop), ← hE, ← lintegral_mul_const _ (by fun_prop)]
    refine setLIntegral_congr_fun measurableSet_Ioi fun t ht => ?_
    have ht : 0 < t := ht
    have hset : {a : P | t < Real.exp (-‖a‖ ^ 2)} = ball (0 : P) √(-Real.log t) := by
      ext a
      rw [mem_ofPred_eq, mem_ball_zero_iff, ← Real.log_lt_iff_lt_exp ht,
        Real.lt_sqrt (norm_nonneg _)]
      constructor <;> intro h <;> linarith
    rw [hset, Measure.addHaar_ball volume 0 (Real.sqrt_nonneg _)]
  -- Hence `|B_1(0)| = (√π)ⁿ / Γ(n/2 + 1) = π^{n/2} / Γ(n/2 + 1) = ω_n`.
  have hΓ : 0 < Real.Gamma ((Module.finrank ℝ P : ℝ) / 2 + 1) :=
    Real.Gamma_pos_of_pos (by positivity)
  have hω : unitBallVolume n = √Real.pi ^ n / Real.Gamma ((n : ℝ) / 2 + 1) := by
    unfold unitBallVolume
    rw [Real.sqrt_eq_rpow, ← Real.rpow_natCast, ← Real.rpow_mul Real.pi_pos.le]
    congr 2
    ring
  have hball : volume (ball (0 : P) 1) = ENNReal.ofReal (unitBallVolume n) := by
    rw [hP] at hC hD hΓ
    rw [hω, ENNReal.ofReal_div_of_pos hΓ,
      ENNReal.eq_div_iff (ENNReal.ofReal_pos.2 hΓ).ne' ENNReal.ofReal_ne_top, ← hD, hC,
      ENNReal.ofReal_pow (Real.sqrt_nonneg _)]
  rw [hpre, hvol, Measure.addHaar_closedBall volume (0 : P) hs, hball, hP,
    ← ENNReal.ofReal_mul (pow_nonneg hs n), mul_comm]

/-- **Simon Ch. 3, Remark 1.8(1)** (with the boundedness of Remark 1.5(3)).  Let `V = v(M, θ)` be a
rectifiable `n`-varifold in the open set `U`, `K ⊆ M` compact with `θ|K` continuous, `x ∈ K`, and
`P` the approximate tangent space of `K` at `x` (Ch. 3, 1.4).  If
`μ_V((M \ K) ∩ B_{Rλ}(x)) / λⁿ → 0` as `λ ↓ 0` for every `R > 0`, then `P` is the approximate
tangent space of `M` with respect to `θ` at `x` (Ch. 3, 1.7). -/
theorem aetp_weightedTangent_of_lusin_compact : ∀ (n ℓ : ℕ) (U : Set (Amb n ℓ)), IsOpen U → ∀ (V : RectifiableVarifold n ℓ U) (K : Set (Amb n ℓ)) (x : Amb n ℓ) (P : Submodule ℝ (Amb n ℓ)), IsCompact K → K ⊆ V.carrier → x ∈ K → ContinuousOn V.mult K → (∀ R : ℝ, 0 < R → Tendsto (fun r : ℝ => V.weight ((V.carrier \ K) ∩ closedBall x (R * r)) / ENNReal.ofReal (r ^ n)) (𝓝[>] 0) (𝓝 0)) → Poincare.SimonGMT.Chapter03.HasApproximateTangentSpaceAt n K x P → Poincare.SimonGMT.Chapter03.HasWeightedApproximateTangentSpaceAt n V.carrier V.mult x P := by
  intro n ℓ U hU V K x P hK hKM hxK hθK hdens hT
  refine ⟨hT.1, fun f => ?_⟩
  -- Step 1: a closed ball `B_ρ(x) ⊆ U`, bounds for `f`, and the radius `R` of its support.
  have hxU : x ∈ U := V.carrier_subset (hKM hxK)
  obtain ⟨ρ, hρ, hρU⟩ : ∃ ρ > 0, closedBall x ρ ⊆ U := by
    obtain ⟨ε, hε, hεU⟩ := Metric.isOpen_iff.mp hU x hxU
    exact ⟨ε / 2, half_pos hε, (closedBall_subset_ball (half_lt_self hε)).trans hεU⟩
  have hKmeas : MeasurableSet K := hK.isClosed.measurableSet
  obtain ⟨Cf, hCf⟩ : ∃ C, ∀ y, ‖f y‖ ≤ C :=
    (map_continuous f).bounded_above_of_compact_support f.hasCompactSupport
  have hCf0 : 0 ≤ Cf := (norm_nonneg _).trans (hCf 0)
  obtain ⟨R, hR, hfR⟩ := f.hasCompactSupport.exists_pos_le_norm
  -- A cutoff `g ∈ C_c` with `0 ≤ g ≤ 1` and `g = 1` on `B_R(0)`.
  obtain ⟨g₀, hg₀1, -, hg₀cs, hg₀01⟩ := exists_continuous_one_zero_of_isCompact
    (isCompact_closedBall (0 : Amb n ℓ) R)
    (isOpen_ball (x := (0 : Amb n ℓ)) (ε := R + 1)).isClosed_compl
    (disjoint_compl_right_iff_subset.mpr (closedBall_subset_ball (by linarith)))
  let g : CompactlySupportedContinuousMap (Amb n ℓ) ℝ := ⟨g₀, hg₀cs⟩
  have hg01 : ∀ y, g y ∈ Icc (0 : ℝ) 1 := hg₀01
  -- Step 2: `Hⁿ(K) < ∞`, since `θ ≥ θ(z₀) > 0` on `K` and `θ` is integrable on `K`.
  have hθKint : IntegrableOn V.mult K (μHE[n] : Measure (Amb n ℓ)) := by
    have h := V.integrableOn_mult K hK (hKM.trans V.carrier_subset)
    rwa [inter_eq_right.mpr hKM] at h
  obtain ⟨z₀, hz₀K, hz₀min⟩ := hK.exists_isMinOn ⟨x, hxK⟩ hθK
  have hc : 0 < V.mult z₀ := V.mult_pos z₀ (hKM hz₀K)
  have hμK : (μHE[n] : Measure (Amb n ℓ)) K < ∞ := by
    have h1 : ∫⁻ _ in K, ENNReal.ofReal (V.mult z₀) ∂(μHE[n] : Measure (Amb n ℓ)) ≤
        ∫⁻ z in K, ‖V.mult z‖ₑ ∂(μHE[n] : Measure (Amb n ℓ)) := by
      apply setLIntegral_mono' hKmeas
      intro z hz
      rw [Real.enorm_eq_ofReal_abs]
      exact ENNReal.ofReal_le_ofReal ((hz₀min hz).trans (le_abs_self _))
    rw [setLIntegral_const] at h1
    exact ENNReal.lt_top_of_mul_ne_top_right (h1.trans_lt hθKint.2).ne
      (ENNReal.ofReal_pos.mpr hc).ne'
  -- Step 3: change of variables for the blow-up `η_r = blowUpMap x r`.
  have hcont : ∀ r : ℝ, Continuous (Poincare.SimonGMT.Chapter03.blowUpMap x r) := by
    intro r
    show Continuous fun y => r⁻¹ • (y - x)
    fun_prop
  have hemb : ∀ r : ℝ, 0 < r → MeasurableEmbedding (Poincare.SimonGMT.Chapter03.blowUpMap x r) :=
    fun r hr => ((Homeomorph.subRight x).trans
      (Homeomorph.smulOfNeZero r⁻¹ (inv_ne_zero hr.ne'))).measurableEmbedding
  have hscale : ∀ r : ℝ, 0 < r → ∀ T : Set (Amb n ℓ),
      (μHE[n] : Measure (Amb n ℓ)) (Poincare.SimonGMT.Chapter03.blowUpMap x r '' T) =
        ENNReal.ofReal r⁻¹ ^ n * (μHE[n] : Measure (Amb n ℓ)) T := by
    intro r hr T
    have himage : Poincare.SimonGMT.Chapter03.blowUpMap x r '' T =
        AffineMap.homothety (0 : Amb n ℓ) r⁻¹ '' ((fun y => y - x) '' T) := by
      rw [Set.image_image]
      congr 1
      funext y
      simp [Poincare.SimonGMT.Chapter03.blowUpMap, AffineMap.homothety_apply]
    have hiso : Isometry (fun y : Amb n ℓ => y - x) := (IsometryEquiv.subRight x).isometry
    rw [himage, euclideanHausdorffMeasure_homothety_image n (0 : Amb n ℓ) (inv_ne_zero hr.ne'),
      hiso.euclideanHausdorffMeasure_image, ENNReal.smul_def, smul_eq_mul, ENNReal.coe_pow]
    congr 2
    rw [← ENNReal.ofReal_coe_nnreal, coe_nnnorm, Real.norm_of_nonneg (inv_pos.mpr hr).le]
  have hmap : ∀ r : ℝ, 0 < r → ∀ S : Set (Amb n ℓ),
      (μHE[n] : Measure (Amb n ℓ)).restrict (Poincare.SimonGMT.Chapter03.blowUpMap x r '' S) =
        ENNReal.ofReal r⁻¹ ^ n • ((μHE[n] : Measure (Amb n ℓ)).restrict S).map
          (Poincare.SimonGMT.Chapter03.blowUpMap x r) := by
    intro r hr S
    ext A hA
    rw [Measure.restrict_apply hA, Measure.smul_apply, smul_eq_mul,
      Measure.map_apply (hcont r).measurable hA,
      Measure.restrict_apply ((hcont r).measurable hA), ← hscale r hr,
      inter_comm _ S, Set.image_inter_preimage, inter_comm]
  have hcv : ∀ r : ℝ, 0 < r → ∀ (S : Set (Amb n ℓ)) (G : Amb n ℓ → ℝ),
      ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' S, G y ∂(μHE[n] : Measure (Amb n ℓ)) =
        r⁻¹ ^ n * ∫ z in S, G (Poincare.SimonGMT.Chapter03.blowUpMap x r z)
          ∂(μHE[n] : Measure (Amb n ℓ)) := by
    intro r hr S G
    rw [hmap r hr S, integral_smul_measure, (hemb r hr).integral_map, ENNReal.toReal_pow,
      ENNReal.toReal_ofReal (inv_nonneg.mpr hr.le), smul_eq_mul]
  -- Step 4: `f ∘ η_r` vanishes off `B_{Rr}(x)`, and `g ∘ η_r = 1` on `B_{Rr}(x)`.
  have hnorm : ∀ r : ℝ, 0 < r → ∀ z : Amb n ℓ,
      ‖Poincare.SimonGMT.Chapter03.blowUpMap x r z‖ = r⁻¹ * ‖z - x‖ := by
    intro r hr z
    show ‖r⁻¹ • (z - x)‖ = _
    rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hr.le)]
  have hf0 : ∀ r : ℝ, 0 < r → ∀ z : Amb n ℓ, R * r ≤ ‖z - x‖ →
      f (Poincare.SimonGMT.Chapter03.blowUpMap x r z) = 0 := by
    intro r hr z hz
    apply hfR
    rw [hnorm r hr z, le_inv_mul_iff₀ hr]
    linarith
  have hg1 : ∀ r : ℝ, 0 < r → ∀ z : Amb n ℓ, ‖z - x‖ ≤ R * r →
      g (Poincare.SimonGMT.Chapter03.blowUpMap x r z) = 1 := by
    intro r hr z hz
    apply hg₀1
    rw [mem_closedBall, dist_zero_right, hnorm r hr z, inv_mul_le_iff₀ hr]
    linarith
  -- Step 5: integrability of the three integrands.
  have hfK : ∀ r : ℝ, IntegrableOn (fun z => f (Poincare.SimonGMT.Chapter03.blowUpMap x r z)) K
      (μHE[n] : Measure (Amb n ℓ)) := fun r =>
    Measure.integrableOn_of_bounded hμK.ne
      ((map_continuous f).comp (hcont r)).aestronglyMeasurable
      (M := Cf) (Eventually.of_forall fun z => hCf _)
  have hgK : ∀ r : ℝ, IntegrableOn (fun z => g (Poincare.SimonGMT.Chapter03.blowUpMap x r z)) K
      (μHE[n] : Measure (Amb n ℓ)) := fun r =>
    Measure.integrableOn_of_bounded hμK.ne
      ((map_continuous g).comp (hcont r)).aestronglyMeasurable
      (M := 1) (Eventually.of_forall fun z => by
        rw [Real.norm_of_nonneg (hg01 _).1]
        exact (hg01 _).2)
  have hhM : ∀ r : ℝ, 0 < r → R * r ≤ ρ →
      IntegrableOn (fun z => f (Poincare.SimonGMT.Chapter03.blowUpMap x r z) * V.mult z) V.carrier
        (μHE[n] : Measure (Amb n ℓ)) := by
    intro r hr hRr
    have hθint : IntegrableOn V.mult (closedBall x ρ)
        ((μHE[n] : Measure (Amb n ℓ)).restrict V.carrier) := by
      have h := V.integrableOn_mult (closedBall x ρ) (isCompact_closedBall x ρ) hρU
      rw [IntegrableOn, Measure.restrict_restrict measurableSet_closedBall, inter_comm]
      exact h
    have hind : (fun z => f (Poincare.SimonGMT.Chapter03.blowUpMap x r z) * V.mult z) =
        (closedBall x ρ).indicator
          (fun z => f (Poincare.SimonGMT.Chapter03.blowUpMap x r z) * V.mult z) := by
      funext z
      by_cases hz : z ∈ closedBall x ρ
      · rw [indicator_of_mem hz]
      · rw [indicator_of_notMem hz, hf0 r hr z ?_, zero_mul]
        rw [mem_closedBall, dist_eq_norm, not_le] at hz
        linarith
    rw [IntegrableOn, hind, integrable_indicator_iff measurableSet_closedBall]
    exact hθint.bdd_mul ((map_continuous f).comp (hcont r)).aestronglyMeasurable
      (Eventually.of_forall fun z => hCf _)
  -- Step 6: the splitting `∫_{η_r(M)} f θ(x + r ·) = θ(x) I₁ + I₂ + I₃`.
  have hdecomp : ∀ᶠ r in 𝓝[>] (0 : ℝ),
      ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' V.carrier, f y * V.mult (x + r • y)
          ∂(μHE[n] : Measure (Amb n ℓ)) =
        V.mult x * (r⁻¹ ^ n * ∫ z in K, f (Poincare.SimonGMT.Chapter03.blowUpMap x r z)
          ∂(μHE[n] : Measure (Amb n ℓ))) +
        r⁻¹ ^ n * ∫ z in K, (f (Poincare.SimonGMT.Chapter03.blowUpMap x r z) * V.mult z -
          V.mult x * f (Poincare.SimonGMT.Chapter03.blowUpMap x r z))
          ∂(μHE[n] : Measure (Amb n ℓ)) +
        r⁻¹ ^ n * ∫ z in V.carrier \ K, f (Poincare.SimonGMT.Chapter03.blowUpMap x r z) * V.mult z
          ∂(μHE[n] : Measure (Amb n ℓ)) := by
    filter_upwards [Ioo_mem_nhdsGT (div_pos hρ hR)] with r hr
    obtain ⟨hr0, hrρ⟩ := hr
    have hRr : R * r ≤ ρ := by
      rw [lt_div_iff₀ hR] at hrρ
      linarith
    rw [hcv r hr0]
    have hback : ∀ z : Amb n ℓ, x + r • Poincare.SimonGMT.Chapter03.blowUpMap x r z = z := by
      intro z
      show x + r • (r⁻¹ • (z - x)) = z
      rw [smul_smul, mul_inv_cancel₀ hr0.ne', one_smul, add_sub_cancel]
    simp only [hback]
    have hint := hhM r hr0 hRr
    rw [← integral_inter_add_sdiff hKmeas hint, inter_eq_right.mpr hKM,
      integral_sub (hint.mono_set hKM) ((hfK r).const_mul (V.mult x)), integral_const_mul]
    ring
  -- Step 7: the main term converges by `T_x K = P`.
  have hT1 : Tendsto (fun r : ℝ => V.mult x * (r⁻¹ ^ n * ∫ z in K,
      f (Poincare.SimonGMT.Chapter03.blowUpMap x r z) ∂(μHE[n] : Measure (Amb n ℓ))))
      (𝓝[>] 0) (𝓝 (V.mult x * ∫ y in (P : Set (Amb n ℓ)), f y ∂(μHE[n] : Measure (Amb n ℓ)))) := by
    apply Tendsto.const_mul
    apply (hT.2 f).congr'
    filter_upwards [self_mem_nhdsWithin] with r hr
    exact hcv r hr K f
  -- Step 8: the oscillation term `I₂` tends to `0` by continuity of `θ|K` at `x`.
  have hT2 : Tendsto (fun r : ℝ => r⁻¹ ^ n * ∫ z in K,
      (f (Poincare.SimonGMT.Chapter03.blowUpMap x r z) * V.mult z -
        V.mult x * f (Poincare.SimonGMT.Chapter03.blowUpMap x r z)) ∂(μHE[n] : Measure (Amb n ℓ)))
      (𝓝[>] 0) (𝓝 0) := by
    set Lg := ∫ y in (P : Set (Amb n ℓ)), g y ∂(μHE[n] : Measure (Amb n ℓ))
    have hglim : Tendsto (fun r : ℝ => r⁻¹ ^ n * ∫ z in K,
        g (Poincare.SimonGMT.Chapter03.blowUpMap x r z) ∂(μHE[n] : Measure (Amb n ℓ)))
        (𝓝[>] 0) (𝓝 Lg) := by
      apply (hT.2 g).congr'
      filter_upwards [self_mem_nhdsWithin] with r hr
      exact hcv r hr K g
    have hgev := hglim.eventually_lt_const (lt_add_one Lg)
    rw [Metric.tendsto_nhds]
    intro ε hε
    obtain ⟨ε', hε'0, hε'⟩ : ∃ ε' : ℝ, 0 < ε' ∧ Cf * ε' * (|Lg| + 1) < ε := by
      refine ⟨ε / (2 * (Cf * (|Lg| + 1) + 1)), by positivity, ?_⟩
      have hA : 0 ≤ Cf * (|Lg| + 1) := by positivity
      rw [show Cf * (ε / (2 * (Cf * (|Lg| + 1) + 1))) * (|Lg| + 1) =
          ε * (Cf * (|Lg| + 1)) / (2 * (Cf * (|Lg| + 1) + 1)) by ring,
        div_lt_iff₀ (by positivity)]
      nlinarith
    obtain ⟨δ, hδ, hθδ⟩ := Metric.continuousOn_iff.mp hθK x hxK ε' hε'0
    filter_upwards [hgev, Ioo_mem_nhdsGT (div_pos hδ hR)] with r hgr hr
    obtain ⟨hr0, hrδ⟩ := hr
    have hRr : R * r < δ := by
      rw [lt_div_iff₀ hR] at hrδ
      linarith
    have hbound : ‖∫ z in K, (f (Poincare.SimonGMT.Chapter03.blowUpMap x r z) * V.mult z -
        V.mult x * f (Poincare.SimonGMT.Chapter03.blowUpMap x r z)) ∂(μHE[n] : Measure (Amb n ℓ))‖ ≤
        ∫ z in K, Cf * ε' * g (Poincare.SimonGMT.Chapter03.blowUpMap x r z)
          ∂(μHE[n] : Measure (Amb n ℓ)) := by
      apply norm_integral_le_of_norm_le ((hgK r).const_mul (Cf * ε'))
      apply ae_restrict_of_forall_mem hKmeas
      intro z hz
      have heq : f (Poincare.SimonGMT.Chapter03.blowUpMap x r z) * V.mult z -
          V.mult x * f (Poincare.SimonGMT.Chapter03.blowUpMap x r z) =
          f (Poincare.SimonGMT.Chapter03.blowUpMap x r z) * (V.mult z - V.mult x) := by ring
      rw [heq, norm_mul]
      by_cases hzb : ‖z - x‖ ≤ R * r
      · rw [hg1 r hr0 z hzb, mul_one]
        have h1 : dist (V.mult z) (V.mult x) < ε' :=
          hθδ z hz (by rw [dist_eq_norm]; linarith)
        rw [dist_eq_norm] at h1
        exact mul_le_mul (hCf _) h1.le (norm_nonneg _) hCf0
      · rw [not_le] at hzb
        rw [hf0 r hr0 z hzb.le, norm_zero, zero_mul]
        exact mul_nonneg (mul_nonneg hCf0 hε'0.le) (hg01 _).1
    rw [integral_const_mul] at hbound
    have hpow : 0 ≤ r⁻¹ ^ n := pow_nonneg (inv_nonneg.mpr hr0.le) n
    rw [dist_zero_right, norm_mul, Real.norm_of_nonneg hpow]
    calc r⁻¹ ^ n * ‖∫ z in K, (f (Poincare.SimonGMT.Chapter03.blowUpMap x r z) * V.mult z -
          V.mult x * f (Poincare.SimonGMT.Chapter03.blowUpMap x r z)) ∂(μHE[n] : Measure (Amb n ℓ))‖
        ≤ r⁻¹ ^ n * (Cf * ε' * ∫ z in K, g (Poincare.SimonGMT.Chapter03.blowUpMap x r z)
            ∂(μHE[n] : Measure (Amb n ℓ))) := mul_le_mul_of_nonneg_left hbound hpow
      _ = Cf * ε' * (r⁻¹ ^ n * ∫ z in K, g (Poincare.SimonGMT.Chapter03.blowUpMap x r z)
            ∂(μHE[n] : Measure (Amb n ℓ))) := by ring
      _ ≤ Cf * ε' * (|Lg| + 1) := by
          apply mul_le_mul_of_nonneg_left _ (mul_nonneg hCf0 hε'0.le)
          linarith [le_abs_self Lg]
      _ < ε := hε'
  -- Step 9: the term `I₃` over `M \ K` tends to `0` by the density hypothesis.
  have hT3 : Tendsto (fun r : ℝ => r⁻¹ ^ n * ∫ z in V.carrier \ K,
      f (Poincare.SimonGMT.Chapter03.blowUpMap x r z) * V.mult z ∂(μHE[n] : Measure (Amb n ℓ)))
      (𝓝[>] 0) (𝓝 0) := by
    rw [tendsto_iff_edist_tendsto_0]
    simp only [edist_zero_right]
    have hlim := ENNReal.Tendsto.const_mul (hdens R hR) (Or.inr (ENNReal.ofReal_ne_top (r := Cf)))
    rw [mul_zero] at hlim
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hlim
      (Eventually.of_forall fun _ => zero_le) ?_
    filter_upwards [self_mem_nhdsWithin] with r hr
    have hr0 : (0 : ℝ) < r := hr
    have hpt : ∀ᵐ z ∂((μHE[n] : Measure (Amb n ℓ)).restrict V.carrier).restrict (V.carrier \ K),
        ‖f (Poincare.SimonGMT.Chapter03.blowUpMap x r z) * V.mult z‖ₑ ≤
          (closedBall x (R * r)).indicator
            (fun z => ENNReal.ofReal Cf * ENNReal.ofReal (V.mult z)) z := by
      filter_upwards [ae_restrict_of_ae (ae_restrict_mem₀ V.nullMeasurableSet_carrier)] with z hz
      by_cases hzb : z ∈ closedBall x (R * r)
      · rw [indicator_of_mem hzb, enorm_mul, Real.enorm_of_nonneg (V.mult_pos z hz).le,
          ← ofReal_norm]
        gcongr
        exact hCf _
      · rw [mem_closedBall, dist_eq_norm, not_le] at hzb
        rw [hf0 r hr0 z hzb.le, zero_mul, enorm_zero]
        exact zero_le
    have hint : ‖∫ z in V.carrier \ K, f (Poincare.SimonGMT.Chapter03.blowUpMap x r z) * V.mult z
        ∂(μHE[n] : Measure (Amb n ℓ))‖ₑ ≤
        ENNReal.ofReal Cf * V.weight ((V.carrier \ K) ∩ closedBall x (R * r)) :=
      calc ‖∫ z in V.carrier \ K, f (Poincare.SimonGMT.Chapter03.blowUpMap x r z) * V.mult z
            ∂(μHE[n] : Measure (Amb n ℓ))‖ₑ
          ≤ ∫⁻ z in V.carrier \ K, ‖f (Poincare.SimonGMT.Chapter03.blowUpMap x r z) * V.mult z‖ₑ
            ∂(μHE[n] : Measure (Amb n ℓ)) := enorm_integral_le_lintegral_enorm _
        _ = ∫⁻ z in V.carrier \ K, ‖f (Poincare.SimonGMT.Chapter03.blowUpMap x r z) * V.mult z‖ₑ
            ∂((μHE[n] : Measure (Amb n ℓ)).restrict V.carrier) := by
            rw [Measure.restrict_restrict_of_subset sdiff_subset]
        _ ≤ ∫⁻ z in V.carrier \ K, (closedBall x (R * r)).indicator
              (fun z => ENNReal.ofReal Cf * ENNReal.ofReal (V.mult z)) z
            ∂((μHE[n] : Measure (Amb n ℓ)).restrict V.carrier) := lintegral_mono_ae hpt
        _ = ENNReal.ofReal Cf * ∫⁻ z in (V.carrier \ K) ∩ closedBall x (R * r),
              ENNReal.ofReal (V.mult z) ∂((μHE[n] : Measure (Amb n ℓ)).restrict V.carrier) := by
            rw [lintegral_indicator measurableSet_closedBall,
              Measure.restrict_restrict measurableSet_closedBall,
              lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, inter_comm (closedBall x (R * r))]
        _ ≤ ENNReal.ofReal Cf * V.weight ((V.carrier \ K) ∩ closedBall x (R * r)) := by
            gcongr
            exact withDensity_apply_le _ _
    calc ‖r⁻¹ ^ n * ∫ z in V.carrier \ K, f (Poincare.SimonGMT.Chapter03.blowUpMap x r z) *
          V.mult z ∂(μHE[n] : Measure (Amb n ℓ))‖ₑ
        = (ENNReal.ofReal (r ^ n))⁻¹ * ‖∫ z in V.carrier \ K,
            f (Poincare.SimonGMT.Chapter03.blowUpMap x r z) * V.mult z
            ∂(μHE[n] : Measure (Amb n ℓ))‖ₑ := by
          rw [enorm_mul, Real.enorm_of_nonneg (pow_nonneg (inv_nonneg.mpr hr0.le) n), inv_pow,
            ENNReal.ofReal_inv_of_pos (pow_pos hr0 n)]
      _ ≤ (ENNReal.ofReal (r ^ n))⁻¹ *
          (ENNReal.ofReal Cf * V.weight ((V.carrier \ K) ∩ closedBall x (R * r))) := by
          gcongr
      _ = ENNReal.ofReal Cf * (V.weight ((V.carrier \ K) ∩ closedBall x (R * r)) /
          ENNReal.ofReal (r ^ n)) := by
          rw [div_eq_mul_inv]
          ring
  -- Step 10: conclusion.
  have hsum := (hT1.add hT2).add hT3
  rw [add_zero, add_zero] at hsum
  exact hsum.congr' (hdecomp.mono fun r hr => hr.symm)

/-- **Approximate tangent spaces of a bi-Lipschitz `C¹` chart image** (Simon Ch. 3, Def. 1.4):
if `G : ℝⁿ → ℝ^{n+ℓ}` is `C¹`, `DG(v)` is injective and `κ|v − w| ≤ |G v − G w|` on the open ball
`B̆_ρ(c)`, then `N = G(B̆_ρ(c))` is Borel with `Hⁿ(N) < ∞`, and `T(x) = DG(ψ x)(ℝⁿ)` (`ψ` the inverse
chart) is the approximate tangent space of `N` at every `x ∈ N`, with `x ↦ p_{T(x)}` continuous on
`N`.  Proof: `N` is `σ`-compact, and the Lipschitz image bound gives `Hⁿ(N) < ∞`; the projection
onto `L(ℝⁿ)` is `L (Lᵀ L)⁻¹ Lᵀ`, continuous in injective `L`.  For the tangent limit at `x = G w`,
the rescaled chart `Φ_r(s) = r⁻¹ (G(w + r s) − G w)`, reparametrized over an isometry
`ι : ℝⁿ → DG(w)(ℝⁿ)`, is `(1 ± ε)`-bi-Lipschitz on a fixed ball `D` for small `r` (mean value
inequality); so `Hⁿ` on its image is squeezed between `(1 ± ε)ⁿ` times the pushforward of Lebesgue
measure on `D` (the Lipschitz image bound replaces the area formula), and dominated convergence
gives `∫_{η_{x,r}(N)} f dHⁿ → ∫_D f ∘ ι = ∫_{T(x)} f dHⁿ`; the lower bound `κ` keeps the support of
`f ∘ Φ_r` inside `D`. -/
theorem tae_c1_chart_image_approxTangent : ∀ {n ℓ : ℕ} (G : Rn n → Amb n ℓ) (c : Rn n) (ρ κ : ℝ), 1 ≤ n → ContDiff ℝ 1 G → 0 < κ → (∀ v ∈ ball c ρ, Function.Injective (fderiv ℝ G v)) → (∀ v ∈ ball c ρ, ∀ w ∈ ball c ρ, κ * ‖v - w‖ ≤ ‖G v - G w‖) → MeasurableSet (G '' ball c ρ) ∧ (μHE[n] : Measure (Amb n ℓ)) (G '' ball c ρ) < ⊤ ∧ ∃ T : Amb n ℓ → Submodule ℝ (Amb n ℓ), ContinuousOn (fun x => (T x).starProjection) (G '' ball c ρ) ∧ ∀ x ∈ G '' ball c ρ, Poincare.SimonGMT.Chapter03.HasApproximateTangentSpaceAt n (G '' ball c ρ) x (T x) := by
  intro n ℓ G c ρ κ hn hG hκ hinj hlow
  -- Step A (parent steps 0, 1, 3): `N = G(B')` is Borel and `Hⁿ(N) < ∞`.
  have hmeasfin : MeasurableSet (G '' ball c ρ) ∧ (μHE[n] : Measure (Amb n ℓ)) (G '' ball c ρ) < ⊤ := by
    have hGc : Continuous G := hG.continuous
    constructor
    · have hσ : IsSigmaCompact (ball c ρ) := by
        refine ⟨fun m : ℕ => closedBall c (ρ - 1 / ((m : ℝ) + 1)),
          fun m => isCompact_closedBall _ _, ?_⟩
        ext v
        simp only [mem_iUnion, mem_closedBall, mem_ball]
        constructor
        · rintro ⟨m, hm⟩
          have : 0 < 1 / ((m : ℝ) + 1) := by positivity
          linarith
        · intro hv
          obtain ⟨m, hm⟩ := exists_nat_one_div_lt (sub_pos.mpr hv)
          exact ⟨m, by linarith⟩
      obtain ⟨K, hK, hKU⟩ := hσ.image hGc
      rw [← hKU]
      exact MeasurableSet.iUnion fun j => (hK j).measurableSet
    · rcases le_or_gt ρ 0 with hρ | hρ
      · rw [ball_eq_empty.mpr hρ, image_empty, measure_empty]
        exact ENNReal.zero_lt_top
      · have hcont : Continuous (fun v => ‖fderiv ℝ G v‖₊) :=
          (hG.continuous_fderiv one_ne_zero).nnnorm
        obtain ⟨v₀, -, hv₀⟩ := (isCompact_closedBall c ρ).exists_isMaxOn
          (nonempty_closedBall.mpr hρ.le) hcont.continuousOn
        have hLip : LipschitzOnWith ‖fderiv ℝ G v₀‖₊ G (ball c ρ) :=
          (convex_ball c ρ).lipschitzOnWith_of_nnnorm_fderiv_le
            (fun v _ => (hG.differentiable one_ne_zero).differentiableAt)
            (fun v hv => hv₀ (ball_subset_closedBall hv))
        have himg := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n hLip
        refine lt_of_le_of_lt himg (ENNReal.mul_lt_top (ENNReal.pow_lt_top ENNReal.coe_lt_top) ?_)
        rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
        exact measure_ball_lt_top
  -- Step B (parent step 5): `L ↦ p_{L(ℝⁿ)}` is continuous on injective `L`, via `L (Lᵀ L)⁻¹ Lᵀ`.
  have hproj : ContinuousOn (fun L : Rn n →L[ℝ] Amb n ℓ => (LinearMap.range L.toLinearMap).starProjection) {L : Rn n →L[ℝ] Amb n ℓ | Function.Injective L} := by
    -- The transpose `T L = Lᵀ`, built from the standard basis `e i` of `ℝⁿ`.
    let e : Fin n → Rn n := fun i => EuclideanSpace.single i (1 : ℝ)
    let T : (Rn n →L[ℝ] Amb n ℓ) → (Amb n ℓ →L[ℝ] Rn n) :=
      fun L => ∑ i, (innerSL ℝ (L (e i))).smulRight (e i)
    have hT : ∀ L (w : Amb n ℓ) (v : Rn n), inner ℝ (T L w) v = inner ℝ w (L v) := by
      intro L w v
      have hv : v = ∑ i, v i • e i := by
        simpa [e] using ((EuclideanSpace.basisFun (Fin n) ℝ).sum_repr v).symm
      have hTw : T L w = ∑ i, inner ℝ (L (e i)) w • e i := by
        simp [T]
      rw [hTw]
      conv_rhs => rw [hv]
      simp only [sum_inner, inner_sum, map_sum, map_smul, real_inner_smul_left,
        real_inner_smul_right, e, EuclideanSpace.inner_single_left, one_mul, map_one]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [real_inner_comm]
      ring
    have hTc : Continuous T := by
      refine continuous_finsetSum _ fun i _ => ?_
      have h1 : Continuous fun L : Rn n →L[ℝ] Amb n ℓ => innerSL ℝ (L (e i)) :=
        (innerSL ℝ).continuous.comp (continuous_id.clm_apply continuous_const)
      exact ((ContinuousLinearMap.smulRightL ℝ (Amb n ℓ) (Rn n)).continuous.comp h1).clm_apply
        continuous_const
    -- The Gram operator `A L = Lᵀ L` and the candidate projection `Q L = L (Lᵀ L)⁻¹ Lᵀ`.
    let A : (Rn n →L[ℝ] Amb n ℓ) → (Rn n →L[ℝ] Rn n) := fun L => (T L).comp L
    let Q : (Rn n →L[ℝ] Amb n ℓ) → (Amb n ℓ →L[ℝ] Amb n ℓ) :=
      fun L => L.comp ((Ring.inverse (A L)).comp (T L))
    -- `A L` is a unit for injective `L`: `A L v = 0` gives `|L v|² = ⟨A L v, v⟩ = 0`.
    have hA : ∀ L : Rn n →L[ℝ] Amb n ℓ, Function.Injective L → IsUnit (A L) := by
      intro L hL
      rw [ContinuousLinearMap.isUnit_iff_isUnit_toLinearMap, LinearMap.isUnit_iff_ker_eq_bot,
        LinearMap.ker_eq_bot']
      intro v hv
      have h0 : T L (L v) = 0 := hv
      have h1 : inner ℝ (L v) (L v) = 0 := by
        rw [← hT, h0, inner_zero_left]
      exact hL (by rw [inner_self_eq_zero.mp h1, map_zero])
    -- `Q L = p_{L(ℝⁿ)}` for injective `L`: `Q L w ∈ L(ℝⁿ)` and `Lᵀ (w − Q L w) = 0`.
    have hQ : ∀ L : Rn n →L[ℝ] Amb n ℓ, Function.Injective L →
        (LinearMap.range L.toLinearMap).starProjection = Q L := by
      intro L hL
      ext1 w
      apply Submodule.eq_starProjection_of_mem_of_inner_eq_zero
      · exact ⟨_, rfl⟩
      · rintro _ ⟨v, rfl⟩
        have h1 : T L (L (Ring.inverse (A L) (T L w))) = T L w := by
          have h2 := congrArg (fun S : Rn n →L[ℝ] Rn n => S (T L w))
            (Ring.mul_inverse_cancel _ (hA L hL))
          simpa [A] using h2
        rw [inner_sub_left, ContinuousLinearMap.coe_coe, ← hT, ← hT]
        simp only [Q, ContinuousLinearMap.coe_comp, Function.comp_apply]
        rw [h1, sub_self]
    -- `Q` is continuous at every injective `L`, since inversion is continuous at units.
    have hQc : ∀ L : Rn n →L[ℝ] Amb n ℓ, Function.Injective L → ContinuousAt Q L := by
      intro L hL
      have hAc : Continuous A := hTc.clm_comp continuous_id
      obtain ⟨u, hu⟩ := hA L hL
      have hinv : ContinuousAt (fun L => Ring.inverse (A L)) L := by
        have h1 := NormedRing.inverse_continuousAt u
        rw [hu] at h1
        exact h1.comp hAc.continuousAt
      exact continuous_id.continuousAt.clm_comp (hinv.clm_comp hTc.continuousAt)
    intro L hL
    exact (hQc L hL).continuousWithinAt.congr (fun L' hL' => hQ L' hL') (hQ L hL)
  -- Step C (parent steps 6-8): `DG(w)(ℝⁿ)` is the approximate tangent space of `N` at `G w`.
  have htan : ∀ w ∈ ball c ρ, Poincare.SimonGMT.Chapter03.HasApproximateTangentSpaceAt n (G '' ball c ρ) (G w) (LinearMap.range (fderiv ℝ G w).toLinearMap) := by
    intro w hw
    have hGd : Differentiable ℝ G := hG.differentiable one_ne_zero
    have hDc : Continuous (fderiv ℝ G) := hG.continuous_fderiv one_ne_zero
    set L := fderiv ℝ G w
    have hLinj : Function.Injective L := hinj w hw
    set P : Submodule ℝ (Amb n ℓ) := LinearMap.range L.toLinearMap with hPdef
    have hPdim : Module.finrank ℝ P = n := by
      rw [hPdef, LinearMap.finrank_range_of_inj hLinj, finrank_euclideanSpace_fin]
    refine ⟨hPdim, fun f => ?_⟩
    -- An isometric parametrization `ιL` of the plane `P`, and `A = ιL⁻¹ ∘ L` with inverse `Bc`.
    let e : P ≃ₗᵢ[ℝ] Rn n := ((stdOrthonormalBasis ℝ P).reindex (finCongr hPdim)).repr
    let ιL : Rn n →ₗᵢ[ℝ] Amb n ℓ := P.subtypeₗᵢ.comp e.symm.toLinearIsometry
    have hιrange : Set.range ιL = (P : Set (Amb n ℓ)) := by
      ext y
      constructor
      · rintro ⟨z, rfl⟩
        exact (e.symm z).2
      · intro hy
        exact ⟨e ⟨y, hy⟩, by simp [ιL]⟩
    let A : Rn n ≃ₗ[ℝ] Rn n := (LinearEquiv.ofInjective L.toLinearMap hLinj).trans e.toLinearEquiv
    have hιA : ∀ s, ιL (A s) = L s := by
      intro s
      simp [ιL, A]
    let Bc : Rn n →L[ℝ] Rn n := LinearMap.toContinuousLinearMap (A.symm : Rn n →ₗ[ℝ] Rn n)
    have hBc : ∀ z, Bc z = A.symm z := fun z => by simp [Bc]
    have hBA : ∀ s, Bc (A s) = s := fun s => by rw [hBc, LinearEquiv.symm_apply_apply]
    have hLB : ∀ z, L (Bc z) = ιL z := by
      intro z
      have h := hιA (A.symm z)
      simp only [LinearEquiv.apply_symm_apply] at h
      rw [hBc, h]
    have hAn : ∀ s, ‖A s‖ = ‖L s‖ := by
      intro s
      rw [← hιA, LinearIsometry.norm_map]
    set CB : ℝ := ‖Bc‖
    have hCB0 : 0 ≤ CB := norm_nonneg _
    have hB : ∀ z, ‖Bc z‖ ≤ CB * ‖z‖ := fun z => Bc.le_opNorm z
    -- The support radius `R` of `f` and the parameter ball `D`.
    obtain ⟨R₀, hR₀⟩ := f.hasCompactSupport.isCompact.isBounded.subset_closedBall (0 : Amb n ℓ)
    set R : ℝ := max R₀ 0
    have hR0 : 0 ≤ R := le_max_right _ _
    have hfR : ∀ y : Amb n ℓ, R < ‖y‖ → f y = 0 := by
      intro y hy
      apply image_eq_zero_of_notMem_tsupport
      intro hmem
      have := hR₀ hmem
      rw [mem_closedBall_zero_iff] at this
      linarith [le_max_left R₀ 0]
    set M : ℝ := R + ‖L‖ * R / κ
    have hRM : R ≤ M := by
      have : 0 ≤ ‖L‖ * R / κ := div_nonneg (mul_nonneg (norm_nonneg _) hR0) hκ.le
      linarith
    have hM0 : 0 ≤ M := hR0.trans hRM
    set D : Set (Rn n) := closedBall (0 : Rn n) M with hDdef
    have hCB1 : 0 < CB + 1 := add_pos_of_nonneg_of_pos hCB0 one_pos
    have hCBM : 0 < CB * M + 1 := add_pos_of_nonneg_of_pos (mul_nonneg hCB0 hM0) one_pos
    -- The rescaled chart `Φ r s = r⁻¹ (G (w + r s) - G w)` and its reparametrization `H r = Φ r ∘ Bc`.
    set Φ : ℝ → Rn n → Amb n ℓ := fun r s => r⁻¹ • (G (w + r • s) - G w) with hΦdef
    set Bp : ℝ → Set (Rn n) := fun r => (fun s => w + r • s) ⁻¹' ball c ρ with hBdef
    set H : ℝ → Rn n → Amb n ℓ := fun r z => Φ r (Bc z) with hHdef
    have haff : ∀ r : ℝ, Continuous (fun s : Rn n => w + r • s) := fun r =>
      continuous_const.add (continuous_id.const_smul r)
    have hΦc : ∀ r, Continuous (Φ r) := fun r =>
      ((hG.continuous.comp (haff r)).sub continuous_const).const_smul r⁻¹
    have hHc : ∀ r, Continuous (H r) := fun r => (hΦc r).comp Bc.continuous
    have hderiv : ∀ r : ℝ, r ≠ 0 → ∀ s, HasFDerivAt (Φ r) (fderiv ℝ G (w + r • s)) s := by
      intro r hr0 s
      have h1 : HasFDerivAt (fun s : Rn n => w + r • s) (r • ContinuousLinearMap.id ℝ (Rn n)) s :=
        ((hasFDerivAt_id s).const_smul r).const_add w
      have h2 := (((hGd (w + r • s)).hasFDerivAt.comp s h1).sub_const (G w)).const_smul r⁻¹
      have hfun : (r⁻¹ • fun x => (G ∘ fun s => w + r • s) x - G w) = Φ r := by
        funext x
        simp only [hΦdef, Pi.smul_apply, Function.comp_apply]
      have hlin : r⁻¹ • (fderiv ℝ G (w + r • s)).comp (r • ContinuousLinearMap.id ℝ (Rn n)) =
          fderiv ℝ G (w + r • s) := by
        refine ContinuousLinearMap.ext fun v => ?_
        rw [smul_apply, ContinuousLinearMap.comp_apply,
          smul_apply, ContinuousLinearMap.id_apply, map_smul, smul_smul,
          inv_mul_cancel₀ hr0, one_smul]
      rw [hfun, hlin] at h2
      exact h2
    -- pointwise convergence `Φ r s → L s`
    have hΦt : ∀ s, Tendsto (fun r => Φ r s) (𝓝[>] 0) (𝓝 (L s)) := by
      intro s
      have hd : HasDerivAt (fun t : ℝ => G (w + t • s)) (L s) 0 := by
        have h1 : HasDerivAt (fun t : ℝ => w + t • s) s 0 := by
          simpa using ((hasDerivAt_id (0 : ℝ)).smul_const s).const_add w
        have h2 := (hGd (w + (0 : ℝ) • s)).hasFDerivAt.comp_hasDerivAt (0 : ℝ) h1
        rw [zero_smul, add_zero] at h2
        exact h2
      have h3 := hd.tendsto_slope_zero_right
      simpa [hΦdef] using h3
    have hHt : ∀ z, Tendsto (fun r => H r z) (𝓝[>] 0) (𝓝 (ιL z)) := by
      intro z
      rw [← hLB z]
      exact hΦt (Bc z)
    -- the blown-up set is `Φ r '' Bp r`, and it is measurable
    have himg : ∀ r : ℝ, r ≠ 0 →
        Poincare.SimonGMT.Chapter03.blowUpMap (G w) r '' (G '' ball c ρ) = Φ r '' Bp r := by
      intro r hr0
      ext y
      simp only [mem_image, mem_preimage, hΦdef, hBdef, Poincare.SimonGMT.Chapter03.blowUpMap]
      constructor
      · rintro ⟨_, ⟨v, hv, rfl⟩, rfl⟩
        refine ⟨r⁻¹ • (v - w), ?_, ?_⟩
        · rw [smul_smul, mul_inv_cancel₀ hr0, one_smul, add_sub_cancel]
          exact hv
        · rw [smul_smul, mul_inv_cancel₀ hr0, one_smul, add_sub_cancel]
      · rintro ⟨s, hs, rfl⟩
        exact ⟨G (w + r • s), ⟨w + r • s, hs, rfl⟩, rfl⟩
    have hmeasη : ∀ r : ℝ, r ≠ 0 →
        MeasurableSet (Poincare.SimonGMT.Chapter03.blowUpMap (G w) r '' (G '' ball c ρ)) := by
      intro r hr0
      have hpre : Poincare.SimonGMT.Chapter03.blowUpMap (G w) r '' (G '' ball c ρ) =
          (fun y => G w + r • y) ⁻¹' (G '' ball c ρ) := by
        ext y
        constructor
        · rintro ⟨y₀, hy₀, rfl⟩
          show G w + r • (r⁻¹ • (y₀ - G w)) ∈ G '' ball c ρ
          rw [smul_smul, mul_inv_cancel₀ hr0, one_smul, add_sub_cancel]
          exact hy₀
        · intro hy
          refine ⟨G w + r • y, hy, ?_⟩
          show r⁻¹ • (G w + r • y - G w) = y
          rw [add_sub_cancel_left, smul_smul, inv_mul_cancel₀ hr0, one_smul]
      rw [hpre]
      exact hmeasfin.1.preimage (continuous_const.add (continuous_id.const_smul r)).measurable
    -- `f` vanishes on `Φ r s` unless `s = Bc z` with `z ∈ D` (lower bound `κ`)
    have hfar : ∀ r : ℝ, 0 < r → ∀ s ∈ Bp r, (∀ z ∈ D, Bc z ≠ s) → f (Φ r s) = 0 := by
      intro r hr s hs hsD
      apply hfR
      have hAs : M < ‖A s‖ := by
        by_contra hcon
        exact hsD (A s) (mem_closedBall_zero_iff.mpr (not_lt.mp hcon)) (hBA s)
      have hsR : R / κ < ‖s‖ := by
        by_contra hcon
        have h1 : ‖L s‖ ≤ ‖L‖ * (R / κ) :=
          (L.le_opNorm s).trans (mul_le_mul_of_nonneg_left (not_lt.mp hcon) (norm_nonneg _))
        rw [hAn] at hAs
        have h2 : ‖L‖ * (R / κ) = ‖L‖ * R / κ := by ring
        linarith
      have h1 := hlow (w + r • s) hs w hw
      rw [add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hr.le] at h1
      have h2 : ‖Φ r s‖ = r⁻¹ * ‖G (w + r • s) - G w‖ := by
        simp only [hΦdef]
        rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hr.le)]
      rw [h2]
      have h3 : κ * ‖s‖ ≤ r⁻¹ * ‖G (w + r • s) - G w‖ := by
        rw [le_inv_mul_iff₀ hr]
        calc r * (κ * ‖s‖) = κ * (r * ‖s‖) := by ring
          _ ≤ _ := h1
      have h4 : R < κ * ‖s‖ := by
        rw [div_lt_iff₀ hκ] at hsR
        linarith
      linarith
    -- for small `r`, `Bc '' D ⊆ Bp r`, so the blow-up integral is an integral over `H r '' D`
    have hr₀ : 0 < (ρ - dist w c) / (CB * M + 1) :=
      div_pos (sub_pos.mpr (mem_ball.mp hw)) hCBM
    have hcover : ∀ r ∈ Ioo (0 : ℝ) ((ρ - dist w c) / (CB * M + 1)), ∀ z ∈ D, Bc z ∈ Bp r := by
      rintro r ⟨hr0, hr1⟩ z hz
      show w + r • Bc z ∈ ball c ρ
      rw [mem_ball]
      have h1 : ‖r • Bc z‖ ≤ r * (CB * M) := by
        rw [norm_smul, Real.norm_of_nonneg hr0.le]
        exact mul_le_mul_of_nonneg_left ((hB z).trans
          (mul_le_mul_of_nonneg_left (mem_closedBall_zero_iff.mp hz) hCB0)) hr0.le
      have h2 : r * (CB * M) < ρ - dist w c := by
        rw [lt_div_iff₀ hCBM] at hr1
        linarith
      calc dist (w + r • Bc z) c ≤ dist (w + r • Bc z) w + dist w c := dist_triangle _ _ _
        _ = ‖r • Bc z‖ + dist w c := by rw [dist_eq_norm, add_sub_cancel_left]
        _ < ρ := by linarith
    have hsetint : ∀ r ∈ Ioo (0 : ℝ) ((ρ - dist w c) / (CB * M + 1)),
        ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap (G w) r '' (G '' ball c ρ), f y
          ∂(μHE[n] : Measure (Amb n ℓ)) =
        ∫ y in H r '' D, f y ∂(μHE[n] : Measure (Amb n ℓ)) := by
      intro r hr
      have hr0 : r ≠ 0 := hr.1.ne'
      apply setIntegral_eq_of_subset_of_forall_sdiff_eq_zero (hmeasη r hr0)
      · rw [himg r hr0]
        rintro _ ⟨z, hz, rfl⟩
        exact ⟨Bc z, hcover r hr z hz, rfl⟩
      · rintro y ⟨hy, hyH⟩
        rw [himg r hr0] at hy
        obtain ⟨s, hs, rfl⟩ := hy
        refine hfar r hr.1 s hs fun z hz hzs => hyH ⟨z, hz, ?_⟩
        simp only [hHdef, hzs]
    -- `H r` is `C¹`-close to the isometry `ιL` on `D` for small `r` (mean value inequality)
    have hLip : ∀ ε > 0, ∀ᶠ r in 𝓝[>] (0 : ℝ), ∀ z ∈ D, ∀ z' ∈ D,
        ‖H r z - H r z' - (ιL z - ιL z')‖ ≤ ε * ‖z - z'‖ := by
      intro ε hε
      have hε' : 0 < ε / (CB + 1) := div_pos hε hCB1
      obtain ⟨η, hη, hηD⟩ := Metric.continuousAt_iff.mp hDc.continuousAt (ε / (CB + 1)) hε'
      have hr₁ : 0 < η / (CB * M + 1) := div_pos hη hCBM
      filter_upwards [Ioo_mem_nhdsGT hr₁] with r hr
      obtain ⟨hr0, hr1⟩ := hr
      intro z hz z' hz'
      have hsK : ∀ z ∈ D, Bc z ∈ closedBall (0 : Rn n) (CB * M) := fun z hz => by
        rw [mem_closedBall_zero_iff]
        exact (hB z).trans (mul_le_mul_of_nonneg_left (mem_closedBall_zero_iff.mp hz) hCB0)
      set ψ : Rn n → Amb n ℓ := fun t => Φ r t - L t with hψdef
      have hψd : ∀ t ∈ closedBall (0 : Rn n) (CB * M),
          HasFDerivWithinAt ψ (fderiv ℝ G (w + r • t) - L) (closedBall (0 : Rn n) (CB * M)) t :=
        fun t _ => ((hderiv r hr0.ne' t).sub L.hasFDerivAt).hasFDerivWithinAt
      have hψb : ∀ t ∈ closedBall (0 : Rn n) (CB * M), ‖fderiv ℝ G (w + r • t) - L‖ ≤ ε / (CB + 1) := by
        intro t ht
        have h1 : dist (w + r • t) w < η := by
          rw [dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hr0.le]
          have h2 : r * ‖t‖ ≤ r * (CB * M) :=
            mul_le_mul_of_nonneg_left (mem_closedBall_zero_iff.mp ht) hr0.le
          rw [lt_div_iff₀ hCBM] at hr1
          linarith
        have h3 := hηD h1
        rw [dist_eq_norm] at h3
        exact h3.le
      have hmvt := (convex_closedBall (0 : Rn n) (CB * M)).norm_image_sub_le_of_norm_hasFDerivWithin_le
        hψd hψb (hsK z' hz') (hsK z hz)
      have hkey : H r z - H r z' - (ιL z - ιL z') = ψ (Bc z) - ψ (Bc z') := by
        simp only [hψdef, hHdef]
        rw [hLB z, hLB z']
        abel
      rw [hkey]
      calc ‖ψ (Bc z) - ψ (Bc z')‖ ≤ ε / (CB + 1) * ‖Bc z - Bc z'‖ := hmvt
        _ = ε / (CB + 1) * ‖Bc (z - z')‖ := by rw [map_sub]
        _ ≤ ε / (CB + 1) * (CB * ‖z - z'‖) := mul_le_mul_of_nonneg_left (hB _) hε'.le
        _ ≤ ε * ‖z - z'‖ := by
          rw [div_mul_eq_mul_div, div_le_iff₀ hCB1]
          have h1 : 0 ≤ ε * ‖z - z'‖ := mul_nonneg hε.le (norm_nonneg _)
          linarith
    have hDfin : (volume : Measure (Rn n)) D < ∞ := measure_closedBall_lt_top
    -- Squeeze: for continuous `g ≥ 0`, `∫_{H r '' D} g dHⁿ → ∫_D g ∘ ιL` (bi-Lipschitz comparison
    -- of `Hⁿ ⌞ H r '' D` with the pushforward of Lebesgue measure on `D`)
    have hinner : ∀ g : Amb n ℓ → ℝ, Continuous g → (∀ y, 0 ≤ g y) → ∀ Cg : ℝ, (∀ y, g y ≤ Cg) →
        Tendsto (fun r => ∫ y in H r '' D, g y ∂(μHE[n] : Measure (Amb n ℓ))) (𝓝[>] 0)
          (𝓝 (∫ z in D, g (ιL z))) := by
      intro g hgc hg0 Cg hgC
      have hCg : 0 ≤ Cg := (hg0 0).trans (hgC 0)
      have hY : Tendsto (fun r => ∫ z in D, g (H r z)) (𝓝[>] 0) (𝓝 (∫ z in D, g (ιL z))) := by
        refine tendsto_integral_filter_of_dominated_convergence (fun _ => Cg) ?_ ?_ ?_ ?_
        · exact Eventually.of_forall fun r => (hgc.comp (hHc r)).aestronglyMeasurable
        · refine Eventually.of_forall fun r => Eventually.of_forall fun z => ?_
          rw [Real.norm_of_nonneg (hg0 _)]
          exact hgC _
        · exact integrableOn_const hDfin.ne
        · exact Eventually.of_forall fun z => (hgc.tendsto _).comp (hHt z)
      set K : ℝ := Cg * (volume : Measure (Rn n)).real D
      have hK0 : 0 ≤ K := mul_nonneg hCg measureReal_nonneg
      have hXY : Tendsto (fun r => ∫ y in H r '' D, g y ∂(μHE[n] : Measure (Amb n ℓ)) -
          ∫ z in D, g (H r z)) (𝓝[>] 0) (𝓝 0) := by
        rw [Metric.tendsto_nhds]
        intro δ hδ
        -- choose `ε` with `((1 + ε)ⁿ - (1 - ε)ⁿ) K < δ`
        have hφc : Continuous fun ε : ℝ => ((1 + ε) ^ n - (1 - ε) ^ n) * K := by fun_prop
        have hφ0 : ((1 + (0 : ℝ)) ^ n - (1 - 0) ^ n) * K < δ := by simpa using hδ
        obtain ⟨ε, hεδ, hεI⟩ := ((((hφc.tendsto 0).eventually (gt_mem_nhds hφ0)).filter_mono
          nhdsWithin_le_nhds).and (Ioc_mem_nhdsGT (show (0 : ℝ) < 1 / 2 by norm_num))).exists
        obtain ⟨hε0, hε1⟩ := hεI
        filter_upwards [hLip ε hε0, self_mem_nhdsWithin] with r hr hr0
        rw [mem_Ioi] at hr0
        -- bi-Lipschitz bounds for `H r` on `D`
        have hιsub : ∀ z z', ‖ιL z - ιL z'‖ = ‖z - z'‖ := fun z z' => by
          rw [← map_sub, LinearIsometry.norm_map]
        have hup : ∀ z ∈ D, ∀ z' ∈ D, ‖H r z - H r z'‖ ≤ (1 + ε) * ‖z - z'‖ := by
          intro z hz z' hz'
          have h1 := hr z hz z' hz'
          calc ‖H r z - H r z'‖ = ‖(H r z - H r z' - (ιL z - ιL z')) + (ιL z - ιL z')‖ := by
                rw [sub_add_cancel]
            _ ≤ ‖H r z - H r z' - (ιL z - ιL z')‖ + ‖ιL z - ιL z'‖ := norm_add_le _ _
            _ ≤ (1 + ε) * ‖z - z'‖ := by rw [hιsub]; linarith
        have hlo : ∀ z ∈ D, ∀ z' ∈ D, (1 - ε) * ‖z - z'‖ ≤ ‖H r z - H r z'‖ := by
          intro z hz z' hz'
          have h1 := hr z hz z' hz'
          have h2 : ‖ιL z - ιL z'‖ ≤ ‖H r z - H r z'‖ + ‖H r z - H r z' - (ιL z - ιL z')‖ := by
            calc ‖ιL z - ιL z'‖ = ‖(H r z - H r z') - (H r z - H r z' - (ιL z - ιL z'))‖ := by
                  rw [sub_sub_cancel]
              _ ≤ _ := norm_sub_le _ _
          rw [hιsub] at h2
          linarith
        have h1ε : 0 < 1 - ε := by linarith
        have hLipH : LipschitzOnWith (Real.toNNReal (1 + ε)) (H r) D := by
          refine LipschitzOnWith.of_dist_le_mul fun z hz z' hz' => ?_
          rw [dist_eq_norm, dist_eq_norm, Real.coe_toNNReal _ (by linarith)]
          exact hup z hz z' hz'
        have hInjH : InjOn (H r) D := by
          intro z hz z' hz' hzz
          have h1 := hlo z hz z' hz'
          rw [hzz, sub_self, norm_zero] at h1
          have h2 : ‖z - z'‖ ≤ 0 := by
            by_contra hcon
            have h3 := mul_pos h1ε (lt_of_not_ge hcon)
            linarith
          exact sub_eq_zero.mp (norm_le_zero_iff.mp h2)
        set Hinv : Amb n ℓ → Rn n := Function.invFunOn (H r) D
        have hHinv : ∀ z ∈ D, Hinv (H r z) = z := fun z hz => hInjH.leftInvOn_invFunOn hz
        have hLipInv : LipschitzOnWith (Real.toNNReal (1 - ε)⁻¹) Hinv (H r '' D) := by
          refine LipschitzOnWith.of_dist_le_mul ?_
          rintro _ ⟨z, hz, rfl⟩ _ ⟨z', hz', rfl⟩
          rw [hHinv z hz, hHinv z' hz', dist_eq_norm, dist_eq_norm,
            Real.coe_toNNReal _ (inv_nonneg.mpr h1ε.le), inv_mul_eq_div, le_div_iff₀ h1ε]
          linarith [hlo z hz z' hz']
        -- comparison of `μ₁ = Hⁿ ⌞ H r '' D` with `ν = (H r)_# (Lⁿ ⌞ D)`
        have hHm : Measurable (H r) := (hHc r).measurable
        set μ₁ : Measure (Amb n ℓ) := (μHE[n] : Measure (Amb n ℓ)).restrict (H r '' D) with hμ₁def
        set ν : Measure (Amb n ℓ) := Measure.map (H r) ((volume : Measure (Rn n)).restrict D)
          with hνdef
        have hM1 : μ₁ ≤ ENNReal.ofReal ((1 + ε) ^ n) • ν := by
          rw [Measure.le_iff]
          intro S hS
          rw [Measure.smul_apply, hνdef, Measure.map_apply hHm hS,
            Measure.restrict_apply (hS.preimage hHm), hμ₁def, Measure.restrict_apply hS, smul_eq_mul]
          have h1 : S ∩ H r '' D = H r '' (D ∩ H r ⁻¹' S) := by
            rw [image_inter_preimage, inter_comm]
          have h2 := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
            (hLipH.mono (inter_subset_left : D ∩ H r ⁻¹' S ⊆ D))
          rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume] at h2
          rw [h1, inter_comm (H r ⁻¹' S) D, ENNReal.ofReal_pow (by linarith)]
          exact h2
        have hM2 : ENNReal.ofReal ((1 - ε) ^ n) • ν ≤ μ₁ := by
          rw [Measure.le_iff]
          intro S hS
          rw [Measure.smul_apply, hνdef, Measure.map_apply hHm hS,
            Measure.restrict_apply (hS.preimage hHm), hμ₁def, Measure.restrict_apply hS, smul_eq_mul]
          have h1 : H r ⁻¹' S ∩ D ⊆ Hinv '' (S ∩ H r '' D) := by
            rintro z ⟨hzS, hzD⟩
            exact ⟨H r z, ⟨hzS, z, hzD, rfl⟩, hHinv z hzD⟩
          have h2 := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
            (hLipInv.mono (inter_subset_right : S ∩ H r '' D ⊆ H r '' D))
          rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume] at h2
          have h3 : ENNReal.ofReal ((1 - ε) ^ n) * (ENNReal.ofReal (1 - ε)⁻¹) ^ n = 1 := by
            rw [← ENNReal.ofReal_pow (inv_nonneg.mpr h1ε.le),
              ← ENNReal.ofReal_mul (pow_nonneg h1ε.le n), ← mul_pow, mul_inv_cancel₀ h1ε.ne',
              one_pow, ENNReal.ofReal_one]
          calc ENNReal.ofReal ((1 - ε) ^ n) * volume (H r ⁻¹' S ∩ D)
              ≤ ENNReal.ofReal ((1 - ε) ^ n) * volume (Hinv '' (S ∩ H r '' D)) :=
                mul_le_mul_right (measure_mono h1) _
            _ ≤ ENNReal.ofReal ((1 - ε) ^ n) * ((ENNReal.ofReal (1 - ε)⁻¹) ^ n *
                (μHE[n] : Measure (Amb n ℓ)) (S ∩ H r '' D)) :=
                mul_le_mul_right h2 _
            _ = (μHE[n] : Measure (Amb n ℓ)) (S ∩ H r '' D) := by
                rw [← mul_assoc, h3, one_mul]
        -- integral comparison
        have : IsFiniteMeasure ν := by
          refine ⟨?_⟩
          rw [hνdef, Measure.map_apply hHm MeasurableSet.univ, preimage_univ,
            Measure.restrict_apply MeasurableSet.univ, univ_inter]
          exact hDfin
        have hμ₁fin : μ₁ univ < ∞ := by
          calc μ₁ univ ≤ (ENNReal.ofReal ((1 + ε) ^ n) • ν) univ := hM1 univ
            _ < ∞ := by
              rw [Measure.smul_apply, smul_eq_mul]
              exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top (measure_lt_top ν univ)
        have : IsFiniteMeasure μ₁ := ⟨hμ₁fin⟩
        have hgbd : ∀ y, ‖g y‖ ≤ Cg := fun y => by
          rw [Real.norm_of_nonneg (hg0 y)]
          exact hgC y
        have hgν : Integrable g ν :=
          Integrable.of_bound hgc.aestronglyMeasurable Cg (Eventually.of_forall hgbd)
        have hgμ₁ : Integrable g μ₁ :=
          Integrable.of_bound hgc.aestronglyMeasurable Cg (Eventually.of_forall hgbd)
        have hYeq : ∫ y, g y ∂ν = ∫ z in D, g (H r z) :=
          integral_map hHm.aemeasurable hgc.aestronglyMeasurable
        have hXle : ∫ y in H r '' D, g y ∂(μHE[n] : Measure (Amb n ℓ)) ≤
            (1 + ε) ^ n * ∫ z in D, g (H r z) := by
          have h := integral_mono_measure hM1 (Eventually.of_forall fun y => hg0 y)
            (hgν.smul_measure ENNReal.ofReal_ne_top)
          rw [integral_smul_measure, ENNReal.toReal_ofReal (pow_nonneg (by linarith) n), smul_eq_mul,
            hYeq] at h
          exact h
        have hXge : (1 - ε) ^ n * ∫ z in D, g (H r z) ≤
            ∫ y in H r '' D, g y ∂(μHE[n] : Measure (Amb n ℓ)) := by
          have h := integral_mono_measure hM2 (Eventually.of_forall fun y => hg0 y) hgμ₁
          rw [integral_smul_measure, ENNReal.toReal_ofReal (pow_nonneg h1ε.le n), smul_eq_mul,
            hYeq] at h
          exact h
        have hY0 : 0 ≤ ∫ z in D, g (H r z) :=
          setIntegral_nonneg measurableSet_closedBall fun z _ => hg0 _
        have hYK : ∫ z in D, g (H r z) ≤ K :=
          (Real.le_norm_self _).trans (norm_setIntegral_le_of_norm_le_const hDfin fun z _ => hgbd _)
        have hpow1 : 1 ≤ (1 + ε) ^ n := one_le_pow₀ (by linarith)
        have hpow2 : (1 - ε) ^ n ≤ 1 := pow_le_one₀ h1ε.le (by linarith)
        rw [dist_zero_right, Real.norm_eq_abs, abs_lt]
        have ha := mul_le_mul_of_nonneg_left hYK (sub_nonneg.mpr hpow1)
        have hb := mul_le_mul_of_nonneg_left hYK (sub_nonneg.mpr hpow2)
        have ha0 := mul_nonneg (sub_nonneg.mpr hpow1) hK0
        have hb0 := mul_nonneg (sub_nonneg.mpr hpow2) hK0
        constructor
        · linarith
        · linarith
      have h := hXY.add hY
      simp only [sub_add_cancel, zero_add] at h
      exact h
    -- `f = f⁺ - f⁻` with `f^± ≥ 0` continuous; apply the squeeze to both parts
    obtain ⟨Cf, hCf⟩ := f.continuous.bounded_above_of_compact_support f.hasCompactSupport
    have hCf' : ∀ y, |f y| ≤ Cf := fun y => by
      rw [← Real.norm_eq_abs]
      exact hCf y
    have hCf0 : 0 ≤ Cf := (abs_nonneg _).trans (hCf' 0)
    set fp : Amb n ℓ → ℝ := fun y => max (f y) 0
    set fm : Amb n ℓ → ℝ := fun y => max (-f y) 0
    have hfpc : Continuous fp := f.continuous.max continuous_const
    have hfmc : Continuous fm := f.continuous.neg.max continuous_const
    have hfpm : ∀ y, fp y - fm y = f y := fun y => max_zero_sub_max_neg_zero_eq_self (f y)
    have hfpC : ∀ y, fp y ≤ Cf := fun y => max_le ((le_abs_self _).trans (hCf' y)) hCf0
    have hfmC : ∀ y, fm y ≤ Cf := fun y => max_le ((neg_le_abs _).trans (hCf' y)) hCf0
    have hp := hinner fp hfpc (fun y => le_max_right _ _) Cf hfpC
    have hm := hinner fm hfmc (fun y => le_max_right _ _) Cf hfmC
    have hev : ∀ᶠ r in 𝓝[>] (0 : ℝ),
        ∫ y in H r '' D, fp y ∂(μHE[n] : Measure (Amb n ℓ)) -
          ∫ y in H r '' D, fm y ∂(μHE[n] : Measure (Amb n ℓ)) =
        ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap (G w) r '' (G '' ball c ρ), f y
          ∂(μHE[n] : Measure (Amb n ℓ)) := by
      filter_upwards [hLip 1 one_pos, Ioo_mem_nhdsGT hr₀] with r hr hr'
      have hLipH : LipschitzOnWith (Real.toNNReal 2) (H r) D := by
        refine LipschitzOnWith.of_dist_le_mul fun z hz z' hz' => ?_
        rw [dist_eq_norm, dist_eq_norm, Real.coe_toNNReal _ (by norm_num)]
        have h1 := hr z hz z' hz'
        have h2 : ‖ιL z - ιL z'‖ = ‖z - z'‖ := by rw [← map_sub, LinearIsometry.norm_map]
        calc ‖H r z - H r z'‖ = ‖(H r z - H r z' - (ιL z - ιL z')) + (ιL z - ιL z')‖ := by
              rw [sub_add_cancel]
          _ ≤ ‖H r z - H r z' - (ιL z - ιL z')‖ + ‖ιL z - ιL z'‖ := norm_add_le _ _
          _ ≤ 2 * ‖z - z'‖ := by rw [h2]; linarith
      have hfin : (μHE[n] : Measure (Amb n ℓ)) (H r '' D) ≠ ∞ := by
        have h := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n hLipH
        rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume] at h
        exact (h.trans_lt (ENNReal.mul_lt_top (ENNReal.pow_lt_top ENNReal.coe_lt_top) hDfin)).ne
      have hip : IntegrableOn fp (H r '' D) (μHE[n] : Measure (Amb n ℓ)) :=
        Measure.integrableOn_of_bounded hfin hfpc.aestronglyMeasurable (M := Cf)
          (Eventually.of_forall fun y => by
            rw [Real.norm_of_nonneg (le_max_right _ _)]
            exact hfpC y)
      have him : IntegrableOn fm (H r '' D) (μHE[n] : Measure (Amb n ℓ)) :=
        Measure.integrableOn_of_bounded hfin hfmc.aestronglyMeasurable (M := Cf)
          (Eventually.of_forall fun y => by
            rw [Real.norm_of_nonneg (le_max_right _ _)]
            exact hfmC y)
      rw [hsetint r hr', ← integral_sub hip him]
      congr 1
      funext y
      exact hfpm y
    have hlim : (∫ z in D, fp (ιL z)) - ∫ z in D, fm (ιL z) =
        ∫ y in (P : Set (Amb n ℓ)), f y ∂(μHE[n] : Measure (Amb n ℓ)) := by
      have hιc : Continuous ιL := ιL.continuous
      have hi1 : IntegrableOn (fun z => fp (ιL z)) D (volume : Measure (Rn n)) :=
        (hfpc.comp hιc).continuousOn.integrableOn_compact (isCompact_closedBall _ _)
      have hi2 : IntegrableOn (fun z => fm (ιL z)) D (volume : Measure (Rn n)) :=
        (hfmc.comp hιc).continuousOn.integrableOn_compact (isCompact_closedBall _ _)
      rw [← integral_sub hi1 hi2]
      have h1 : ∫ z in D, (fp (ιL z) - fm (ιL z)) = ∫ z in D, f (ιL z) := by
        congr 1
        funext z
        exact hfpm _
      have hfc : Continuous (fun y : Amb n ℓ => f y) := f.continuous
      rw [h1, setIntegral_eq_integral_of_forall_compl_eq_zero, ← integral_map hιc.aemeasurable
        hfc.aestronglyMeasurable, ← EuclideanSpace.euclideanHausdorffMeasure_eq_volume n,
        ιL.isometry.map_euclideanHausdorffMeasure, hιrange]
      intro z hz
      apply hfR
      rw [LinearIsometry.norm_map]
      rw [hDdef, mem_closedBall_zero_iff, not_le] at hz
      linarith
    rw [← hlim]
    exact (hp.sub hm).congr' hev
  -- Assembly (parent steps 2, 4): inverse chart `ψ`, `T x = DG(ψ x)(ℝⁿ)`.
  obtain ⟨hmeas, hfin⟩ := hmeasfin
  refine ⟨hmeas, hfin, ?_⟩
  -- the lower bound makes `G` injective on the ball
  have hInjOn : InjOn G (ball c ρ) := by
    intro v hv w hw hvw
    have h := hlow v hv w hw
    rw [hvw, sub_self, norm_zero] at h
    have h0 : ‖v - w‖ ≤ 0 := by
      by_contra hcon
      have := mul_pos hκ (lt_of_not_ge hcon)
      linarith
    exact sub_eq_zero.mp (norm_le_zero_iff.mp h0)
  -- the inverse chart `ψ` on `N = G(B')`, Lipschitz with constant `κ⁻¹`
  set ψ : Amb n ℓ → Rn n := Function.invFunOn G (ball c ρ) with hψdef
  have hψG : ∀ v ∈ ball c ρ, ψ (G v) = v := fun v hv => hInjOn.leftInvOn_invFunOn hv
  have hψmaps : MapsTo ψ (G '' ball c ρ) (ball c ρ) := by
    rintro _ ⟨v, hv, rfl⟩
    rw [hψG v hv]
    exact hv
  have hψcont : ContinuousOn ψ (G '' ball c ρ) := by
    have hL : LipschitzOnWith (Real.toNNReal κ⁻¹) ψ (G '' ball c ρ) := by
      rw [lipschitzOnWith_iff_dist_le_mul]
      rintro _ ⟨v, hv, rfl⟩ _ ⟨w, hw, rfl⟩
      rw [hψG v hv, hψG w hw, dist_eq_norm, dist_eq_norm,
        Real.coe_toNNReal _ (inv_nonneg.mpr hκ.le), inv_mul_eq_div, le_div_iff₀ hκ, mul_comm]
      exact hlow v hv w hw
    exact hL.continuousOn
  -- `T x = DG(ψ x)(ℝⁿ)`
  refine ⟨fun x => LinearMap.range (fderiv ℝ G (ψ x)).toLinearMap, ?_, ?_⟩
  · have hD : ContinuousOn (fun x => fderiv ℝ G (ψ x)) (G '' ball c ρ) :=
      (hG.continuous_fderiv one_ne_zero).comp_continuousOn hψcont
    have hmaps : MapsTo (fun x => fderiv ℝ G (ψ x)) (G '' ball c ρ)
        {L : Rn n →L[ℝ] Amb n ℓ | Function.Injective L} :=
      fun x hx => hinj _ (hψmaps hx)
    exact hproj.comp hD hmaps
  · rintro x ⟨w, hw, rfl⟩
    simp only [hψG w hw]
    exact htan w hw

/-- Simon Ch. 3, Theorem 1.9 (measurability of `x ↦ p_{T_x M}`, used for Ch. 5, Lemma 2.1): for
injective `L : ℝⁿ → ℝ^{n+ℓ}` the orthogonal projection onto `L(ℝⁿ)` is `L (Lᵀ L)⁻¹ Lᵀ`, hence it
depends continuously on `L`.  Here `Lᵀ w = Σᵢ ⟨L eᵢ, w⟩ eᵢ` is the transpose, `Lᵀ L` is a unit of
`End(ℝⁿ)` because `⟨Lᵀ L v, v⟩ = |L v|²`, inversion is continuous at units, and
`w − L (Lᵀ L)⁻¹ Lᵀ w ⊥ L(ℝⁿ)` identifies the formula with `p_{L(ℝⁿ)}`. -/
theorem aetp_starProjection_range_continuousOn : ∀ (n ℓ : ℕ), ContinuousOn (fun L : Rn n →L[ℝ] Amb n ℓ => (LinearMap.range L.toLinearMap).starProjection) {L : Rn n →L[ℝ] Amb n ℓ | Function.Injective L} := by
  intro n ℓ
  -- The transpose `T L = Lᵀ`, built from the standard basis `e i` of `ℝⁿ`.
  let e : Fin n → Rn n := fun i => EuclideanSpace.single i (1 : ℝ)
  let T : (Rn n →L[ℝ] Amb n ℓ) → (Amb n ℓ →L[ℝ] Rn n) :=
    fun L => ∑ i, (innerSL ℝ (L (e i))).smulRight (e i)
  have hT : ∀ L (w : Amb n ℓ) (v : Rn n), inner ℝ (T L w) v = inner ℝ w (L v) := by
    intro L w v
    have hv : v = ∑ i, v i • e i := by
      simpa [e] using ((EuclideanSpace.basisFun (Fin n) ℝ).sum_repr v).symm
    have hTw : T L w = ∑ i, inner ℝ (L (e i)) w • e i := by
      simp [T]
    rw [hTw]
    conv_rhs => rw [hv]
    simp only [sum_inner, inner_sum, map_sum, map_smul, real_inner_smul_left,
      real_inner_smul_right, e, EuclideanSpace.inner_single_left, one_mul, map_one]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [real_inner_comm]
    ring
  have hTc : Continuous T := by
    refine continuous_finsetSum _ fun i _ => ?_
    have h1 : Continuous fun L : Rn n →L[ℝ] Amb n ℓ => innerSL ℝ (L (e i)) :=
      (innerSL ℝ).continuous.comp (continuous_id.clm_apply continuous_const)
    exact ((ContinuousLinearMap.smulRightL ℝ (Amb n ℓ) (Rn n)).continuous.comp h1).clm_apply
      continuous_const
  -- The Gram operator `A L = Lᵀ L` and the candidate projection `Q L = L (Lᵀ L)⁻¹ Lᵀ`.
  let A : (Rn n →L[ℝ] Amb n ℓ) → (Rn n →L[ℝ] Rn n) := fun L => (T L).comp L
  let Q : (Rn n →L[ℝ] Amb n ℓ) → (Amb n ℓ →L[ℝ] Amb n ℓ) :=
    fun L => L.comp ((Ring.inverse (A L)).comp (T L))
  -- `A L` is a unit for injective `L`: `A L v = 0` gives `|L v|² = ⟨A L v, v⟩ = 0`.
  have hA : ∀ L : Rn n →L[ℝ] Amb n ℓ, Function.Injective L → IsUnit (A L) := by
    intro L hL
    rw [ContinuousLinearMap.isUnit_iff_isUnit_toLinearMap, LinearMap.isUnit_iff_ker_eq_bot,
      LinearMap.ker_eq_bot']
    intro v hv
    have h0 : T L (L v) = 0 := hv
    have h1 : inner ℝ (L v) (L v) = 0 := by
      rw [← hT, h0, inner_zero_left]
    exact hL (by rw [inner_self_eq_zero.mp h1, map_zero])
  -- `Q L = p_{L(ℝⁿ)}` for injective `L`: `Q L w ∈ L(ℝⁿ)` and `Lᵀ (w − Q L w) = 0`.
  have hQ : ∀ L : Rn n →L[ℝ] Amb n ℓ, Function.Injective L →
      (LinearMap.range L.toLinearMap).starProjection = Q L := by
    intro L hL
    ext1 w
    apply Submodule.eq_starProjection_of_mem_of_inner_eq_zero
    · exact ⟨_, rfl⟩
    · rintro _ ⟨v, rfl⟩
      have h1 : T L (L (Ring.inverse (A L) (T L w))) = T L w := by
        have h2 := congrArg (fun S : Rn n →L[ℝ] Rn n => S (T L w))
          (Ring.mul_inverse_cancel _ (hA L hL))
        simpa [A] using h2
      rw [inner_sub_left, ContinuousLinearMap.coe_coe, ← hT, ← hT]
      simp only [Q, ContinuousLinearMap.coe_comp, Function.comp_apply]
      rw [h1, sub_self]
  -- `Q` is continuous at every injective `L`, since inversion is continuous at units.
  have hQc : ∀ L : Rn n →L[ℝ] Amb n ℓ, Function.Injective L → ContinuousAt Q L := by
    intro L hL
    have hAc : Continuous A := hTc.clm_comp continuous_id
    obtain ⟨u, hu⟩ := hA L hL
    have hinv : ContinuousAt (fun L => Ring.inverse (A L)) L := by
      have h1 := NormedRing.inverse_continuousAt u
      rw [hu] at h1
      exact h1.comp hAc.continuousAt
    exact continuous_id.continuousAt.clm_comp (hinv.clm_comp hTc.continuousAt)
  intro L hL
  exact (hQc L hL).continuousWithinAt.congr (fun L' hL' => hQ L' hL') (hQ L hL)
/-- The operator norm of a linear map `A : ℝᵐ → ℝᵏ` is at most its Hilbert–Schmidt norm,
`‖A‖ ≤ |A| = (Σᵢ |A eᵢ|²)^{1/2}` (Simon, Notation p. ix).  Proof: writing `x = Σᵢ xᵢ eᵢ`, the
triangle inequality gives `|A x| ≤ Σᵢ |xᵢ| |A eᵢ|`, and Cauchy–Schwarz for finite sums bounds this
by `|A| |x|`; `opNorm_le_bound` then gives the claim. -/
theorem arp_opNorm_le_hsNorm : ∀ {m k : ℕ} (A : Rn m →L[ℝ] Rn k), ‖A‖ ≤ hsNorm A := by
  intro m k A
  -- Step 1: `hsNorm A ≥ 0`, so it suffices to show `|A x| ≤ hsNorm A * |x|` for every `x`.
  refine A.opNorm_le_bound (Real.sqrt_nonneg _) fun x => ?_
  -- Step 2: expand `x = Σᵢ xᵢ eᵢ` in the standard basis `eᵢ = EuclideanSpace.single i 1`.
  have hx : ∑ i, x i • EuclideanSpace.single i (1 : ℝ) = x := by
    simpa only [EuclideanSpace.basisFun_apply, EuclideanSpace.basisFun_repr] using
      (EuclideanSpace.basisFun (Fin m) ℝ).sum_repr x
  calc ‖A x‖ = ‖∑ i, x i • A (EuclideanSpace.single i 1)‖ := by
        conv_lhs => rw [← hx]
        rw [map_sum]
        simp only [map_smul]
    _ ≤ ∑ i, ‖x i‖ * ‖A (EuclideanSpace.single i 1)‖ := by
        refine (norm_sum_le _ _).trans_eq ?_
        simp only [norm_smul]
    -- Step 3: Cauchy–Schwarz for finite real sums.
    _ ≤ √(∑ i, ‖x i‖ ^ 2) * √(∑ i, ‖A (EuclideanSpace.single i 1)‖ ^ 2) :=
        Real.sum_mul_le_sqrt_mul_sqrt _ _ _
    -- Step 4: the two factors are `|x|` and `hsNorm A`.
    _ = hsNorm A * ‖x‖ := by
        rw [hsNorm, hsNormSq, EuclideanSpace.norm_eq x, mul_comm]
/-- Quantitative right inverse on balls of a near-linear self-map of `ℝⁿ`: if
`|A h| ≥ (11/12)|h|` and `Φ` is `ε`-close to `A` on `B_r(0)` with `ε ≤ 1/24`, then every
`w ∈ B_{r/2}(Φ 0)` has a preimage `X w ∈ B_{3r/5}(0)`, unique in `B_r(0)`, and `X` is
`8/7`-Lipschitz on `B_{r/2}(Φ 0)`. -/
theorem arp_rgr_ball_right_inverse : ∀ {n : ℕ} (Φ : Rn n → Rn n) (A : Rn n →L[ℝ] Rn n) (c : Rn n) (r ε : ℝ), 0 < r → 0 ≤ ε → ε ≤ 1 / 24 → (∀ h : Rn n, 11 / 12 * ‖h‖ ≤ ‖A h‖) → (∀ x₁ ∈ closedBall (0 : Rn n) r, ∀ x₂ ∈ closedBall (0 : Rn n) r, ‖Φ x₁ - Φ x₂ - A (x₁ - x₂)‖ ≤ ε * ‖x₁ - x₂‖) → Φ 0 = c → ∃ X : Rn n → Rn n, (∀ w ∈ closedBall c (r / 2), X w ∈ closedBall (0 : Rn n) (3 * r / 5) ∧ Φ (X w) = w) ∧ (∀ x ∈ closedBall (0 : Rn n) r, ∀ w ∈ closedBall c (r / 2), Φ x = w → x = X w) ∧ (∀ w₁ ∈ closedBall c (r / 2), ∀ w₂ ∈ closedBall c (r / 2), 7 / 8 * ‖X w₁ - X w₂‖ ≤ ‖w₁ - w₂‖) := by
  intro n Φ A c r ε hr hε0 hε hA hΦ hc
  -- Step 1: `(7/8)|x₁ − x₂| ≤ |Φ(x₁) − Φ(x₂)|` for `x₁, x₂ ∈ B_r(0)`.
  have hinj : ∀ x₁ ∈ closedBall (0 : Rn n) r, ∀ x₂ ∈ closedBall (0 : Rn n) r,
      7 / 8 * ‖x₁ - x₂‖ ≤ ‖Φ x₁ - Φ x₂‖ := by
    intro x₁ hx₁ x₂ hx₂
    have h₁ := hA (x₁ - x₂)
    have h₂ := hΦ x₁ hx₁ x₂ hx₂
    have h₃ : ‖A (x₁ - x₂)‖ ≤ ‖Φ x₁ - Φ x₂‖ + ‖Φ x₁ - Φ x₂ - A (x₁ - x₂)‖ :=
      calc ‖A (x₁ - x₂)‖ = ‖(Φ x₁ - Φ x₂) - (Φ x₁ - Φ x₂ - A (x₁ - x₂))‖ := by
            rw [sub_sub_cancel]
        _ ≤ _ := norm_sub_le _ _
    have h₄ : ε * ‖x₁ - x₂‖ ≤ 1 / 24 * ‖x₁ - x₂‖ :=
      mul_le_mul_of_nonneg_right hε (norm_nonneg _)
    linarith
  -- Step 2: `A` is injective, hence bijective, with a right inverse of norm `≤ 12/11`.
  have hAinj : Function.Injective A := by
    intro a b hab
    have h := hA (a - b)
    rw [map_sub, hab, sub_self, norm_zero] at h
    have h' : ‖a - b‖ = 0 := le_antisymm (by linarith [norm_nonneg (a - b)]) (norm_nonneg _)
    exact sub_eq_zero.mp (norm_eq_zero.mp h')
  have hAsurj : Function.Surjective A :=
    (LinearMap.injective_iff_surjective (f := (A : Rn n →ₗ[ℝ] Rn n))).mp hAinj
  let Ainv : A.NonlinearRightInverse :=
    { toFun := Function.surjInv hAsurj
      nnnorm := 12 / 11
      bound' := fun k => by
        have h := hA (Function.surjInv hAsurj k)
        rw [Function.surjInv_eq hAsurj] at h
        push_cast
        linarith
      right_inv' := Function.surjInv_eq hAsurj }
  -- Step 3: `B_{r/2}(c) ⊆ Φ(B_{3r/5}(0))`, by the contraction argument packaged in
  -- `ApproximatesLinearOn.surjOn_closedBall_of_nonlinearRightInverse`.
  have happrox : ApproximatesLinearOn Φ A (closedBall 0 r) ⟨ε, hε0⟩ := hΦ
  have hsurj := happrox.surjOn_closedBall_of_nonlinearRightInverse Ainv (ε := 3 * r / 5)
    (b := 0) (by positivity) (closedBall_subset_closedBall (by linarith))
  have hball : closedBall c (r / 2) ⊆
      closedBall (Φ 0) (((Ainv.nnnorm : ℝ)⁻¹ - ((⟨ε, hε0⟩ : ℝ≥0) : ℝ)) * (3 * r / 5)) := by
    rw [hc]
    refine closedBall_subset_closedBall ?_
    show r / 2 ≤ (((12 / 11 : ℝ≥0) : ℝ)⁻¹ - ε) * (3 * r / 5)
    push_cast
    nlinarith
  have hex : ∀ w ∈ closedBall c (r / 2), ∃ x ∈ closedBall (0 : Rn n) (3 * r / 5), Φ x = w :=
    fun w hw => hsurj (hball hw)
  -- Step 4: `X(w)` is a chosen preimage for `w ∈ B_{r/2}(c)`, and `0` otherwise.
  classical
  let X : Rn n → Rn n := fun w =>
    if hw : w ∈ closedBall c (r / 2) then (hex w hw).choose else 0
  have hX : ∀ w ∈ closedBall c (r / 2),
      X w ∈ closedBall (0 : Rn n) (3 * r / 5) ∧ Φ (X w) = w := by
    intro w hw
    simp only [X, hw, ↓reduceDIte]
    exact (hex w hw).choose_spec
  have hXr : ∀ w ∈ closedBall c (r / 2), X w ∈ closedBall (0 : Rn n) r := fun w hw =>
    closedBall_subset_closedBall (by linarith) (hX w hw).1
  refine ⟨X, hX, ?_, ?_⟩
  · -- Step 5: a preimage in `B_r(0)` is `X(w)`.
    intro x hx w hw hxw
    have h := hinj x hx (X w) (hXr w hw)
    rw [hxw, (hX w hw).2, sub_self, norm_zero] at h
    have h' : ‖x - X w‖ = 0 := le_antisymm (by linarith [norm_nonneg (x - X w)]) (norm_nonneg _)
    exact sub_eq_zero.mp (norm_eq_zero.mp h')
  · -- Step 6: `(7/8)|X(w₁) − X(w₂)| ≤ |w₁ − w₂|`.
    intro w₁ hw₁ w₂ hw₂
    have h := hinj (X w₁) (hXr w₁ hw₁) (X w₂) (hXr w₂ hw₂)
    rwa [(hX w₁ hw₁).2, (hX w₂ hw₂).2] at h
/-- Simon Ch. 5, proof of Theorem 5.2 / Remark 5.3 (re-graphing over a rotated plane): regularity
of a continuous right inverse.  Let `U, W ⊆ ℝⁿ` be open, `κ > 0`, `Φ` `C¹` on `U` with
`κ |h| ≤ |DΦ(x) h|` for `x ∈ U`, and `X` continuous on `W` with `X(w) ∈ U` and `Φ(X(w)) = w` for
`w ∈ W`.  Then `X` is `C¹` on `W` and `‖DX(w)‖ ≤ κ⁻¹`.  Each `DΦ(x)` is injective, hence (finite
dimension) invertible with `‖DΦ(x)⁻¹‖ ≤ κ⁻¹`; the local-left-inverse rule gives
`DX(w) = DΦ(X(w))⁻¹ = Ring.inverse (DΦ(X(w)))`, which is continuous in `w` because `X`, `DΦ` and
`Ring.inverse` (at units of the complete normed ring of endomorphisms) are. -/
theorem arp_rgr_right_inverse_contDiffOn : ∀ {n : ℕ} (Φ X : Rn n → Rn n) (U W : Set (Rn n)) (κ : ℝ), IsOpen U → IsOpen W → 0 < κ → ContDiffOn ℝ 1 Φ U → (∀ x ∈ U, ∀ h : Rn n, κ * ‖h‖ ≤ ‖fderiv ℝ Φ x h‖) → ContinuousOn X W → (∀ w ∈ W, X w ∈ U ∧ Φ (X w) = w) → ContDiffOn ℝ 1 X W ∧ ∀ w ∈ W, ‖fderiv ℝ X w‖ ≤ κ⁻¹ := by
  intro n Φ X U W κ hU hW hκ hΦ hlow hX hXW
  -- Step 1: for `x ∈ U`, `DΦ(x)` is a continuous linear equivalence `E x` with `‖(E x)⁻¹‖ ≤ κ⁻¹`.
  have hequiv : ∀ x ∈ U, ∃ L : Rn n ≃L[ℝ] Rn n, (L : Rn n →L[ℝ] Rn n) = fderiv ℝ Φ x ∧
      ‖(L.symm : Rn n →L[ℝ] Rn n)‖ ≤ κ⁻¹ := by
    intro x hx
    -- `κ |a − b| ≤ |DΦ(x)(a − b)|`, so `DΦ(x)` is injective, hence bijective (finite dimension).
    have hinj : Function.Injective (fderiv ℝ Φ x) := by
      intro a b hab
      have h1 := hlow x hx (a - b)
      rw [map_sub, hab, sub_self, norm_zero] at h1
      have h2 : ‖a - b‖ ≤ 0 := by nlinarith [norm_nonneg (a - b)]
      exact sub_eq_zero.1 (norm_le_zero_iff.1 h2)
    let L : Rn n ≃L[ℝ] Rn n :=
      (LinearEquiv.ofInjectiveEndo (fderiv ℝ Φ x).toLinearMap hinj).toContinuousLinearEquiv
    refine ⟨L, ContinuousLinearMap.ext fun v => rfl, ?_⟩
    -- `κ |L⁻¹ k| ≤ |L (L⁻¹ k)| = |k|`.
    refine ContinuousLinearMap.opNorm_le_bound _ (inv_nonneg.2 hκ.le) fun k => ?_
    rw [le_inv_mul_iff₀ hκ]
    have h1 := hlow x hx (L.symm k)
    have h2 : fderiv ℝ Φ x (L.symm k) = k := L.apply_symm_apply k
    rw [h2] at h1
    exact h1
  choose! E hE hEn using hequiv
  -- Step 2: `Φ` has derivative `E x` at each `x ∈ U`, and `DΦ` is continuous on `U`.
  have hΦd : ∀ x ∈ U, HasFDerivAt Φ (E x : Rn n →L[ℝ] Rn n) x := by
    intro x hx
    rw [hE x hx]
    exact ((hΦ.differentiableOn one_ne_zero x hx).differentiableAt (hU.mem_nhds hx)).hasFDerivAt
  have hΦc : ContinuousOn (fderiv ℝ Φ) U := hΦ.continuousOn_fderiv_of_isOpen hU le_rfl
  -- Step 3: by the local-left-inverse rule, `X` has derivative `(E (X w))⁻¹` at `w ∈ W`.
  have hXd : ∀ w ∈ W, HasFDerivAt X ((E (X w)).symm : Rn n →L[ℝ] Rn n) w := by
    intro w hw
    have hfg : ∀ᶠ y in 𝓝 w, Φ (X y) = y :=
      Filter.eventually_of_mem (hW.mem_nhds hw) fun y hy => (hXW y hy).2
    exact HasFDerivAt.of_local_left_inverse (hX.continuousAt (hW.mem_nhds hw))
      (hΦd (X w) (hXW w hw).1) hfg
  have hXfd : ∀ w ∈ W, fderiv ℝ X w = ((E (X w)).symm : Rn n →L[ℝ] Rn n) :=
    fun w hw => (hXd w hw).fderiv
  -- Step 4: `DX(w) = Ring.inverse (DΦ(X w))`, the inverse of the unit `(E (X w)).toUnit`.
  have hXinv : ∀ w ∈ W, fderiv ℝ X w = Ring.inverse (fderiv ℝ Φ (X w)) := by
    intro w hw
    rw [hXfd w hw, ← hE (X w) (hXW w hw).1]
    have : ((E (X w)).toUnit : Rn n →L[ℝ] Rn n) = (E (X w) : Rn n →L[ℝ] Rn n) := rfl
    rw [← this, Ring.inverse_unit]
    rfl
  -- Step 5: `DX` is continuous on `W`: `X`, `DΦ` and `Ring.inverse` (at units) are continuous.
  have hcont : ContinuousOn (fderiv ℝ X) W := by
    intro w hw
    have hxU := (hXW w hw).1
    have h1 : ContinuousAt (fun w' => fderiv ℝ Φ (X w')) w :=
      (hΦc.continuousAt (hU.mem_nhds hxU)).comp (hX.continuousAt (hW.mem_nhds hw))
    have h2 : ContinuousAt Ring.inverse (fderiv ℝ Φ (X w)) := by
      rw [← hE (X w) hxU]
      exact NormedRing.inverse_continuousAt (E (X w)).toUnit
    have h3 : ContinuousAt (fun w' => Ring.inverse (fderiv ℝ Φ (X w'))) w :=
      ContinuousAt.comp (f := fun w' => fderiv ℝ Φ (X w')) h2 h1
    have h4 : (fun w' => Ring.inverse (fderiv ℝ Φ (X w'))) =ᶠ[𝓝 w] fderiv ℝ X :=
      Filter.eventually_of_mem (hW.mem_nhds hw) fun y hy => (hXinv y hy).symm
    exact (h3.congr h4).continuousWithinAt
  refine ⟨?_, fun w hw => ?_⟩
  · -- Step 6: differentiable with continuous derivative on the open set `W`, so `C¹` on `W`.
    rw [show (1 : WithTop ℕ∞) = 0 + 1 from (zero_add 1).symm,
      contDiffOn_succ_iff_fderiv_of_isOpen hW]
    exact ⟨fun w hw => (hXd w hw).differentiableAt.differentiableWithinAt, by simp,
      contDiffOn_zero.2 hcont⟩
  · rw [hXfd w hw]
    exact hEn (X w) (hXW w hw).1
/-- Simon Ch. 5, proof of Theorem 5.2 / Remark 5.3 (re-graphing over a rotated plane): for a linear
isometry `q` of `ℝ^{n+ℓ}`, `y ∈ ℝ^{n+ℓ}` and `v` `C¹` on the open set `U ⊆ ℝⁿ`, the graph map
`Ψ(x) = y + q(x, v(x))` is `C¹` on `U` with `DΨ(x) h = q(h, Dv(x) h)`.  With
`E = EuclideanSpace.finAddEquivProd` we have `graphPoint a b = E⁻¹ (a, b)`, so
`Ψ = y + L ∘ (id, v)` for the continuous linear map `L = q ∘ E⁻¹`; then apply the product and chain
rules. -/
theorem arp_rgr_graph_map_fderiv : ∀ {n ℓ : ℕ} (q : Amb n ℓ ≃ₗᵢ[ℝ] Amb n ℓ) (v : Rn n → Rn ℓ) (y : Amb n ℓ) (U : Set (Rn n)), IsOpen U → ContDiffOn ℝ 1 v U → ContDiffOn ℝ 1 (fun x => y + q (graphPoint x (v x))) U ∧ ∀ x ∈ U, ∀ h : Rn n, fderiv ℝ (fun x => y + q (graphPoint x (v x))) x h = q (graphPoint h (fderiv ℝ v x h)) := by
  intro n ℓ q v y U hU hv
  -- Step 1: `graphPoint a b = E⁻¹ (a, b)`, checked coordinatewise (`Fin.append_left/right`).
  have hgp : ∀ (a : Rn n) (b : Rn ℓ), graphPoint a b =
      (EuclideanSpace.finAddEquivProd : Amb n ℓ ≃L[ℝ] Rn n × Rn ℓ).symm (a, b) := by
    intro a b
    apply (EuclideanSpace.finAddEquivProd : Amb n ℓ ≃L[ℝ] Rn n × Rn ℓ).injective
    rw [ContinuousLinearEquiv.apply_symm_apply]
    ext i <;> simp [graphPoint]
  -- Step 2: `Ψ(x) = y + L (x, v x)` for the continuous linear map `L = q ∘ E⁻¹`.
  let L : Rn n × Rn ℓ →L[ℝ] Amb n ℓ :=
    (q.toContinuousLinearEquiv : Amb n ℓ →L[ℝ] Amb n ℓ).comp
      ((EuclideanSpace.finAddEquivProd : Amb n ℓ ≃L[ℝ] Rn n × Rn ℓ).symm :
        Rn n × Rn ℓ →L[ℝ] Amb n ℓ)
  have hL : ∀ a b, L (a, b) = q (graphPoint a b) := by
    intro a b
    simp [L, hgp]
  have hΨ : (fun x => y + q (graphPoint x (v x))) = fun x => y + L (x, v x) := by
    funext x
    rw [hL]
  refine ⟨?_, ?_⟩
  · -- Step 3: `x ↦ (x, v x)` is `C¹` on `U`; compose with `L` and add the constant `y`.
    rw [hΨ]
    exact contDiffOn_const.add (L.contDiff.comp_contDiffOn (contDiffOn_id.prodMk hv))
  · -- Step 4: `U` is open, so `v` is differentiable at `x`; then the product and chain rules.
    intro x hx h
    have hvx : HasFDerivAt v (fderiv ℝ v x) x :=
      ((hv.differentiableOn one_ne_zero).differentiableAt (hU.mem_nhds hx)).hasFDerivAt
    have hpair : HasFDerivAt (fun x' => (x', v x'))
        ((ContinuousLinearMap.id ℝ (Rn n)).prod (fderiv ℝ v x)) x :=
      (hasFDerivAt_id x).prodMk hvx
    have hΨx : HasFDerivAt (fun x' => y + L (x', v x'))
        (L.comp ((ContinuousLinearMap.id ℝ (Rn n)).prod (fderiv ℝ v x))) x :=
      (L.hasFDerivAt.comp x hpair).const_add y
    rw [hΨ, hΨx.fderiv]
    simp [hL]
/-- Ball cover step of the patching argument for Simon Ch. 5, Remark 5.3 (p. 122): a closed set
`D ∋ c` that is relatively open in the open ball `B̆_R(c)` (every `w ∈ D ∩ B̆_R(c)` has
`B̆_ε(w) ∩ B̆_R(c) ⊆ D` for some `ε > 0`) contains `B̆_R(c)`.  The set `U = D ∩ B̆_R(c)` is open,
meets the preconnected ball at `c`, and `closure U ∩ B̆_R(c) ⊆ U` since `D` is closed, so
`IsPreconnected.subset_of_closure_inter_subset` gives `B̆_R(c) ⊆ U`. -/
theorem arp_ball_subset_of_closed_rel_open : ∀ {m : ℕ} (D : Set (Rn m)) (c : Rn m) (R : ℝ), 0 < R → IsClosed D → c ∈ D → (∀ w ∈ D ∩ ball c R, ∃ ε : ℝ, 0 < ε ∧ ball w ε ∩ ball c R ⊆ D) → ball c R ⊆ D := by
  intro m D c R hR hD hc hloc
  -- Step 1: `U = D ∩ B̆_R(c)` is open; each `w ∈ U` has the neighbourhood `B̆_ε(w) ∩ B̆_R(c) ⊆ U`.
  have hU : IsOpen (D ∩ ball c R) := by
    refine isOpen_iff_mem_nhds.2 fun w hw => ?_
    obtain ⟨ε, hε, hεD⟩ := hloc w hw
    exact Filter.mem_of_superset
      (Filter.inter_mem (ball_mem_nhds w hε) (isOpen_ball.mem_nhds hw.2)) fun x hx => ⟨hεD hx, hx.2⟩
  -- Step 4: `closure U ⊆ closure D = D`.
  have hcl : closure (D ∩ ball c R) ⊆ D :=
    (closure_mono inter_subset_left).trans hD.closure_eq.subset
  -- Steps 2, 3 and 5: the convex ball is preconnected and meets `U` at `c`.
  have hsub : ball c R ⊆ D ∩ ball c R :=
    (convex_ball c R).isPreconnected.subset_of_closure_inter_subset hU
      ⟨c, mem_ball_self hR, hc, mem_ball_self hR⟩ fun x hx => ⟨hcl hx.1, hx.2⟩
  exact hsub.trans inter_subset_left

end Submission
/-- **`C¹` regularity with a derivative bound is local** (the final part of patching local graphs
into a single graph for Simon's Remark 5.3).  If near each `x₀ ∈ Ω` the map `u` agrees on
`B̆_ε(x₀) ∩ Ω` with some `f` that is `C¹` on `B̆_ε(x₀)` with operator norm `‖Df(x₀)‖ ≤ L`, then
`u = f` on a neighbourhood of `x₀`, so `u` is `C¹` at `x₀` and `Du(x₀) = Df(x₀)`; hence `u` is
`C¹` on `Ω` and `‖Du‖ ≤ L` there. -/
theorem Submission.arp_contDiffOn_of_local_C1_reps : ∀ {m k : ℕ} (u : Rn m → Rn k) (Ω : Set (Rn m)) (L : ℝ), IsOpen Ω → (∀ x₀ ∈ Ω, ∃ (ε : ℝ) (f : Rn m → Rn k), 0 < ε ∧ ContDiffOn ℝ 1 f (ball x₀ ε) ∧ ‖fderiv ℝ f x₀‖ ≤ L ∧ ∀ w ∈ ball x₀ ε ∩ Ω, u w = f w) → ContDiffOn ℝ 1 u Ω ∧ ∀ x ∈ Ω, ‖fderiv ℝ u x‖ ≤ L := by
  intro m k u Ω L hΩ hloc
  -- at `x₀ ∈ Ω`, `u` agrees with the representative `f` on the neighbourhood `B̆_ε(x₀) ∩ Ω`
  have key : ∀ x₀ ∈ Ω, ContDiffAt ℝ 1 u x₀ ∧ ‖fderiv ℝ u x₀‖ ≤ L := by
    intro x₀ hx₀
    obtain ⟨ε, f, hε, hf, hfL, hfu⟩ := hloc x₀ hx₀
    have hball : ball x₀ ε ∈ 𝓝 x₀ := Metric.ball_mem_nhds x₀ hε
    have heq : u =ᶠ[𝓝 x₀] f :=
      Filter.eventually_of_mem (Filter.inter_mem hball (hΩ.mem_nhds hx₀)) hfu
    refine ⟨(hf.contDiffAt hball).congr_of_eventuallyEq heq, ?_⟩
    rw [heq.fderiv_eq]
    exact hfL
  exact ⟨fun x hx => (key x hx).1.contDiffWithinAt, fun x hx => (key x hx).2⟩

namespace Submission

/-- The Euclidean Hausdorff measure under the similarity `ψ(x) = c + R x` (`R > 0`):
`ψ_# Hⁿ = R⁻ⁿ Hⁿ`.  `ψ⁻¹B` is the preimage of `τ⁻¹B`, `τ(z) = c + z`, under the homothety
`x ↦ R • x`, and preimages under that homothety scale `Hⁿ` by `‖R‖₊⁻¹ ^ n = R⁻ⁿ`; the isometry
`τ` preserves `Hⁿ`. -/
theorem any_radius_rv_map_hausdorff : ∀ (n ℓ : ℕ) (c : Amb n ℓ) (R : ℝ), 0 < R → (μHE[n] : Measure (Amb n ℓ)).map (fun x => c + R • x) = (ENNReal.ofReal (R ^ n))⁻¹ • (μHE[n] : Measure (Amb n ℓ)) := by
  intro n ℓ c R hR
  -- The constant: `(ofReal Rⁿ)⁻¹ = ‖R‖₊⁻¹ ^ n` since `R > 0`.
  have hκ : (ENNReal.ofReal (R ^ n))⁻¹ = ((‖R‖₊⁻¹ ^ n : ℝ≥0) : ℝ≥0∞) := by
    rw [← ENNReal.ofReal_inv_of_pos (pow_pos hR n), ← ENNReal.ofReal_coe_nnreal]
    congr 1
    push_cast
    rw [Real.norm_of_nonneg hR.le, inv_pow]
  -- The translation `τ(z) = c + z` is an isometric equivalence, so it preserves `Hⁿ`.
  have hτ : MeasurePreserving (fun z : Amb n ℓ => c + z) μHE[n] μHE[n] :=
    (IsometryEquiv.addLeft c).measurePreserving_euclideanHausdorffMeasure n
  ext B hB
  -- `ψ⁻¹B` is the preimage of `τ⁻¹B` under the homothety `x ↦ R • x` (center `0`).
  have hpre : (fun x : Amb n ℓ => c + R • x) ⁻¹' B =
      AffineMap.homothety (0 : Amb n ℓ) R ⁻¹' ((fun z => c + z) ⁻¹' B) := by
    ext x
    simp [AffineMap.homothety_apply]
  rw [Measure.map_apply (by fun_prop) hB, Measure.smul_apply, hκ, hpre,
    euclideanHausdorffMeasure_homothety_preimage n 0 hR.ne',
    hτ.measure_preimage hB.nullMeasurableSet, ENNReal.smul_def]
/-- Rescaling a rectifiable varifold (used for the rescaled varifold in Simon Ch. 5, Remark 5.3):
for `ψ(x) = c + R x` with `R > 0`, `v(ψ⁻¹M, θ ∘ ψ)` is a rectifiable `n`-varifold in `ψ⁻¹U`.  `ψ` is
a homeomorphism (a dilation followed by a translation), hence a measurable embedding, and
`ψ_# Hⁿ = R⁻ⁿ Hⁿ` (`any_radius_rv_map_hausdorff`), so `ψ` is quasi-measure-preserving and pulls
`Hⁿ`-null sets back to `Hⁿ`-null sets.  Null-measurability, countable rectifiability (via `ψ⁻¹M₀`
and the Lipschitz maps `R⁻¹(F_j − c)`), a.e.-measurability of `θ ∘ ψ` on `ψ⁻¹M` and its
integrability on `ψ⁻¹M ∩ K` (through the compact set `ψ(K) ⊆ U`) all transfer. -/
theorem any_radius_rv_exists_structure : ∀ (n ℓ : ℕ) (U : Set (Amb n ℓ)) (V : RectifiableVarifold n ℓ U) (c : Amb n ℓ) (R : ℝ), 0 < R → ∃ W : RectifiableVarifold n ℓ ((fun x => c + R • x) ⁻¹' U), W.carrier = (fun x => c + R • x) ⁻¹' V.carrier ∧ ∀ x, W.mult x = V.mult (c + R • x) := by
  intro n ℓ U V c R hR
  -- `ψ(x) = c + R • x` is the homeomorphism `x ↦ R • x` followed by `z ↦ c + z`, hence a
  -- continuous measurable embedding.
  have hψ : Continuous (fun x : Amb n ℓ => c + R • x) :=
    ((Homeomorph.smulOfNeZero R hR.ne').trans (Homeomorph.addLeft c)).continuous
  have hψe : MeasurableEmbedding (fun x : Amb n ℓ => c + R • x) :=
    ((Homeomorph.smulOfNeZero R hR.ne').trans (Homeomorph.addLeft c)).measurableEmbedding
  -- `ψ_# Hⁿ = κ • Hⁿ` with `κ = R⁻ⁿ ≠ ∞`.
  have hmap : (μHE[n] : Measure (Amb n ℓ)).map (fun x => c + R • x) =
      (ENNReal.ofReal (R ^ n))⁻¹ • (μHE[n] : Measure (Amb n ℓ)) :=
    Submission.any_radius_rv_map_hausdorff n ℓ c R hR
  have hκ : (ENNReal.ofReal (R ^ n))⁻¹ ≠ ∞ :=
    ENNReal.inv_ne_top.2 (ENNReal.ofReal_pos.2 (pow_pos hR n)).ne'
  -- Hence `ψ` is quasi-measure-preserving and `ψ⁻¹` maps `Hⁿ`-null sets to `Hⁿ`-null sets.
  have hqmp : Measure.QuasiMeasurePreserving (fun x : Amb n ℓ => c + R • x) μHE[n] μHE[n] :=
    ⟨hψe.measurable, by rw [hmap]; exact Measure.smul_absolutelyContinuous⟩
  have hnull : ∀ B : Set (Amb n ℓ), (μHE[n] : Measure (Amb n ℓ)) B = 0 →
      (μHE[n] : Measure (Amb n ℓ)) ((fun x => c + R • x) ⁻¹' B) = 0 := fun B hB => by
    rw [← hψe.map_apply, hmap, Measure.smul_apply, hB, smul_zero]
  refine ⟨{
    carrier := (fun x => c + R • x) ⁻¹' V.carrier
    mult := fun x => V.mult (c + R • x)
    carrier_subset := preimage_mono V.carrier_subset
    nullMeasurableSet_carrier := V.nullMeasurableSet_carrier.preimage hqmp
    countablyRectifiable := ?_
    mult_pos := fun x hx => V.mult_pos (c + R • x) hx
    aemeasurable_mult := ?_
    integrableOn_mult := ?_ }, rfl, fun x => rfl⟩
  · -- Pull back the null set `M₀` and compose the Lipschitz pieces `F j` with `ψ⁻¹`.
    obtain ⟨M₀, hM₀, F, hF, hcover⟩ := V.countablyRectifiable
    refine ⟨(fun x => c + R • x) ⁻¹' M₀, hnull M₀ hM₀, fun j z => R⁻¹ • (F j z - c),
      fun j => ?_, fun x hx => ?_⟩
    · obtain ⟨K, hK⟩ := hF j
      exact ⟨‖R⁻¹‖₊ * (K + 0), (lipschitzWith_smul R⁻¹).comp (hK.sub (LipschitzWith.const c))⟩
    · rcases hcover hx with h | h
      · exact Or.inl h
      · obtain ⟨j, z, hz⟩ := mem_iUnion.1 h
        refine Or.inr (mem_iUnion.2 ⟨j, z, ?_⟩)
        simp only [hz, add_sub_cancel_left, smul_smul, inv_mul_cancel₀ hR.ne', one_smul]
  · -- `ψ` maps `Hⁿ⌞ψ⁻¹M` to `κ • Hⁿ⌞M`, for which `θ` is a.e.-measurable.
    have h : AEMeasurable V.mult
        (((μHE[n] : Measure (Amb n ℓ)).restrict ((fun x => c + R • x) ⁻¹' V.carrier)).map
          (fun x => c + R • x)) := by
      rw [← hψe.restrict_map, hmap, Measure.restrict_smul]
      exact V.aemeasurable_mult.smul_measure _
    exact h.comp_measurable hψe.measurable
  · -- `ψ(K)` is a compact subset of `U`, and `ψ⁻¹(M ∩ ψ(K)) = ψ⁻¹M ∩ K`.
    intro K hK hKU
    have h : IntegrableOn V.mult (V.carrier ∩ (fun x => c + R • x) '' K)
        ((μHE[n] : Measure (Amb n ℓ)).map (fun x => c + R • x)) := by
      rw [hmap, IntegrableOn, Measure.restrict_smul]
      exact (V.integrableOn_mult _ (hK.image hψ)
        (by rintro _ ⟨k, hk, rfl⟩; exact hKU hk)).smul_measure hκ
    have h' := hψe.integrableOn_map_iff.1 h
    rwa [preimage_inter, hψe.injective.preimage_image] at h'
/-- Weight of the rescaled varifold (the rescaling `ψ(x) = c + R x` behind Simon Ch. 5, Remark 5.3):
if `W = v(ψ⁻¹M, θ ∘ ψ)`, then `μ_W = R⁻ⁿ φ_# μ_V` with `φ(y) = R⁻¹(y − c)`.  On a measurable set
`A`, `A ∩ ψ⁻¹M = ψ⁻¹(φ⁻¹A ∩ M)` because `φ ∘ ψ = id`, so `μ_W(A) = ∫_{ψ⁻¹(φ⁻¹A ∩ M)} θ ∘ ψ dHⁿ`;
the change of variables `∫_{ψ⁻¹S} g ∘ ψ dHⁿ = R⁻ⁿ ∫_S g dHⁿ`, from `ψ_# Hⁿ = R⁻ⁿ Hⁿ`
(`any_radius_rv_map_hausdorff`), turns this into `R⁻ⁿ μ_V(φ⁻¹A)`. -/
theorem any_radius_rv_weight_eq : ∀ (n ℓ : ℕ) (U U' : Set (Amb n ℓ)) (V : RectifiableVarifold n ℓ U) (W : RectifiableVarifold n ℓ U') (c : Amb n ℓ) (R : ℝ), 0 < R → W.carrier = (fun x => c + R • x) ⁻¹' V.carrier → (∀ x, W.mult x = V.mult (c + R • x)) → W.weight = (ENNReal.ofReal (R ^ n))⁻¹ • V.weight.map (fun x => R⁻¹ • (x - c)) := by
  intro n ℓ U U' V W c R hR hW hθ
  -- `ψ(x) = c + R x` is a measurable embedding, `φ(y) = R⁻¹(y − c)` is measurable, `φ ∘ ψ = id`.
  have hψ : MeasurableEmbedding (fun x : Amb n ℓ => c + R • x) :=
    (measurableEmbedding_addLeft c).comp (measurableEmbedding_const_smul₀ hR.ne')
  have hφ : Measurable (fun y : Amb n ℓ => R⁻¹ • (y - c)) :=
    ((continuous_id.sub continuous_const).const_smul R⁻¹).measurable
  have hφψ : ∀ x : Amb n ℓ, R⁻¹ • (c + R • x - c) = x := fun x => by
    rw [add_sub_cancel_left, inv_smul_smul₀ hR.ne']
  -- Change of variables: `∫_{ψ⁻¹S} g ∘ ψ dHⁿ = R⁻ⁿ ∫_S g dHⁿ`, from `ψ_# Hⁿ = R⁻ⁿ Hⁿ`.
  have hcv : ∀ (S : Set (Amb n ℓ)) (g : Amb n ℓ → ℝ≥0∞),
      ∫⁻ x in (fun x => c + R • x) ⁻¹' S, g (c + R • x) ∂(μHE[n] : Measure (Amb n ℓ)) =
        (ENNReal.ofReal (R ^ n))⁻¹ * ∫⁻ y in S, g y ∂(μHE[n] : Measure (Amb n ℓ)) := by
    intro S g
    have h := hψ.lintegral_map (μ := (μHE[n] : Measure (Amb n ℓ)).restrict
      ((fun x => c + R • x) ⁻¹' S)) g
    rw [← hψ.restrict_map, Submission.any_radius_rv_map_hausdorff n ℓ c R hR,
      Measure.restrict_smul, lintegral_smul_measure, smul_eq_mul] at h
    exact h.symm
  -- Compare both measures on a measurable set `A`.
  ext A hA
  rw [Measure.smul_apply, Measure.map_apply hφ hA, smul_eq_mul, RectifiableVarifold.weight,
    RectifiableVarifold.weight, withDensity_apply _ hA, withDensity_apply _ (hφ hA),
    Measure.restrict_restrict hA, Measure.restrict_restrict (hφ hA)]
  -- `A ∩ ψ⁻¹M = ψ⁻¹(φ⁻¹A ∩ M)` (as `φ ∘ ψ = id`) and `θ_W = θ ∘ ψ`.
  have hA' : A ∩ W.carrier =
      (fun x => c + R • x) ⁻¹' ((fun y => R⁻¹ • (y - c)) ⁻¹' A ∩ V.carrier) := by
    rw [hW, preimage_inter]
    congr 1
    ext x
    simp only [mem_preimage, hφψ]
  rw [hA']
  simp only [hθ]
  exact hcv _ fun y => ENNReal.ofReal (V.mult y)
/-- Support of a rescaled varifold (the rescaling `ψ(x) = c + R x` behind Simon Ch. 5, Remark 5.3):
if `μ_W = R⁻ⁿ φ_# μ_V` with `φ(y) = R⁻¹(y − c)`, then `spt W = ψ⁻¹(spt V)`.  `φ` is the inverse of
the homeomorphism `ψ`, so `μ_W(G) = R⁻ⁿ μ_V(φ⁻¹G)` for every set `G`; neighbourhoods of `x` and of
`ψ(x)` correspond under `ψ⁻¹` and `φ⁻¹`, and the factor `R⁻ⁿ ∈ (0, ∞)` does not change positivity. -/
theorem any_radius_rv_support_eq : ∀ (n ℓ : ℕ) (U : Set (Amb n ℓ)) (V : RectifiableVarifold n ℓ U) (c : Amb n ℓ) (R : ℝ), 0 < R → ∀ W : RectifiableVarifold n ℓ ((fun x => c + R • x) ⁻¹' U), W.weight = (ENNReal.ofReal (R ^ n))⁻¹ • V.weight.map (fun x => R⁻¹ • (x - c)) → W.support = (fun x => c + R • x) ⁻¹' V.support := by
  intro n ℓ U V c R hR W hW
  have hR0 : R ≠ 0 := hR.ne'
  -- `κ = (Rⁿ)⁻¹ ≠ 0` in `[0, ∞]`, since `Rⁿ < ∞`.
  have hκ : (ENNReal.ofReal (R ^ n))⁻¹ ≠ 0 := ENNReal.inv_ne_zero.2 ENNReal.ofReal_ne_top
  -- `ψ(x) = c + R x` and `φ(y) = R⁻¹ (y − c)` are mutually inverse homeomorphisms.
  have hψφ : ∀ y : Amb n ℓ, c + R • (R⁻¹ • (y - c)) = y := fun y => by
    rw [smul_smul, mul_inv_cancel₀ hR0, one_smul, add_sub_cancel]
  have hφψ : ∀ x : Amb n ℓ, R⁻¹ • ((c + R • x) - c) = x := fun x => by
    rw [add_sub_cancel_left, smul_smul, inv_mul_cancel₀ hR0, one_smul]
  have hψc : Continuous fun x : Amb n ℓ => c + R • x := by fun_prop
  have hφc : Continuous fun y : Amb n ℓ => R⁻¹ • (y - c) := by fun_prop
  let e : Amb n ℓ ≃ₜ Amb n ℓ :=
    { toFun := fun y => R⁻¹ • (y - c)
      invFun := fun x => c + R • x
      left_inv := hψφ
      right_inv := hφψ
      continuous_toFun := hφc
      continuous_invFun := hψc }
  -- Hence `φ` is a measurable embedding and `μ_W(G) = κ μ_V(φ⁻¹G)` for every set `G`.
  have hφe : MeasurableEmbedding fun y : Amb n ℓ => R⁻¹ • (y - c) := e.measurableEmbedding
  have hWG : ∀ G : Set (Amb n ℓ),
      W.weight G = (ENNReal.ofReal (R ^ n))⁻¹ * V.weight ((fun y => R⁻¹ • (y - c)) ⁻¹' G) := by
    intro G
    rw [hW, Measure.smul_apply, hφe.map_apply, smul_eq_mul]
  -- `x ∈ spt μ_W ↔ ψ(x) ∈ spt μ_V`.
  have key : ∀ x : Amb n ℓ, x ∈ W.weight.support ↔ c + R • x ∈ V.weight.support := by
    intro x
    rw [Measure.mem_support_iff_forall, Measure.mem_support_iff_forall]
    constructor
    · -- `ψ⁻¹G` is a neighbourhood of `x`, and `φ⁻¹(ψ⁻¹G) = G`.
      intro h G hG
      have hpos := h _ (hψc.continuousAt.preimage_mem_nhds hG)
      have hpre : (fun y => R⁻¹ • (y - c)) ⁻¹' ((fun x => c + R • x) ⁻¹' G) = G := by
        ext y
        simp only [mem_preimage, hψφ]
      rw [hWG, hpre] at hpos
      exact (ENNReal.mul_pos_iff.1 hpos).2
    · -- `φ⁻¹G` is a neighbourhood of `ψ(x)`, since `φ(ψ(x)) = x`.
      intro h G hG
      rw [hWG]
      refine ENNReal.mul_pos hκ (h _ ?_).ne'
      refine hφc.continuousAt.preimage_mem_nhds ?_
      rw [hφψ]
      exact hG
  -- `spt W = ψ⁻¹U ∩ spt μ_W = ψ⁻¹U ∩ ψ⁻¹(spt μ_V) = ψ⁻¹(spt V)`.
  ext x
  simp only [RectifiableVarifold.support, mem_inter_iff, mem_preimage, key]
/-- Scaling invariance of tangent planes (Simon Ch. 3, 1.7; Ch. 4, 1.3): if
`W = v(ψ⁻¹ M, θ ∘ ψ)` with `ψ(x) = c + R x`, `R > 0`, then `η_{x,r}(ψ⁻¹ M) = η_{ψ x,R r}(M)` and
the blown-up multiplicities agree, and `r ↦ R r` preserves `𝓝[>] 0` (with inverse `s ↦ R⁻¹ s`), so
the weighted approximate tangent planes of `W` at `x` are those of `V` at `ψ x`, and `W`, `V` choose
the same tangent projection there. -/
theorem any_radius_rv_tangentProj_eq : ∀ (n ℓ : ℕ) (U U' : Set (Amb n ℓ))
    (V : RectifiableVarifold n ℓ U) (W : RectifiableVarifold n ℓ U') (c : Amb n ℓ) (R : ℝ),
    0 < R → W.carrier = (fun x => c + R • x) ⁻¹' V.carrier →
    (∀ x, W.mult x = V.mult (c + R • x)) → ∀ x, W.tangentProj x = V.tangentProj (c + R • x) := by
  intro n ℓ U U' V W c R hR hc hm x
  have hR0 : R ≠ 0 := hR.ne'
  -- `η_{x,r}(ψ⁻¹ M) = η_{ψ x,R r}(M)`, since `ψ z - ψ x = R (z - x)` and `(R r)⁻¹ R = r⁻¹`.
  have himg : ∀ r : ℝ, Poincare.SimonGMT.Chapter03.blowUpMap x r '' W.carrier =
      Poincare.SimonGMT.Chapter03.blowUpMap (c + R • x) (R * r) '' V.carrier := by
    intro r
    rw [hc]
    ext w
    constructor
    · rintro ⟨z, hz, rfl⟩
      refine ⟨c + R • z, hz, ?_⟩
      simp only [Poincare.SimonGMT.Chapter03.blowUpMap]
      rw [show c + R • z - (c + R • x) = R • (z - x) by rw [smul_sub]; abel, smul_smul,
        mul_inv_rev, mul_assoc, inv_mul_cancel₀ hR0, mul_one]
    · rintro ⟨m, hm', rfl⟩
      refine ⟨R⁻¹ • (m - c), ?_, ?_⟩
      · show c + R • R⁻¹ • (m - c) ∈ V.carrier
        rwa [smul_smul, mul_inv_cancel₀ hR0, one_smul, add_sub_cancel]
      · simp only [Poincare.SimonGMT.Chapter03.blowUpMap]
        rw [show R⁻¹ • (m - c) - x = R⁻¹ • (m - (c + R • x)) by
            rw [smul_sub, smul_sub, smul_add, smul_smul, inv_mul_cancel₀ hR0, one_smul]; abel,
          smul_smul, mul_inv_rev]
  -- `θ_W(x + r y) = θ(ψ x + (R r) y)`.
  have hmult : ∀ (r : ℝ) (y : Amb n ℓ), W.mult (x + r • y) = V.mult (c + R • x + (R * r) • y) := by
    intro r y
    rw [hm, smul_add, mul_smul, add_assoc]
  -- `r ↦ a r` maps `𝓝[>] 0` to `𝓝[>] 0` for `a > 0`.
  have hfil : ∀ a : ℝ, 0 < a → Tendsto (fun r : ℝ => a * r) (𝓝[>] 0) (𝓝[>] 0) := by
    intro a ha
    refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ ?_ ?_
    · have h0 : Tendsto (fun r : ℝ => a * r) (𝓝 0) (𝓝 (a * 0)) :=
        (continuous_const.mul continuous_id).tendsto 0
      rw [mul_zero] at h0
      exact h0.mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with r hr
      exact mul_pos ha hr
  -- Hence the limits along `r` and along `R r` agree, and the two predicates coincide.
  have key : ∀ P : Submodule ℝ (Amb n ℓ),
      Poincare.SimonGMT.Chapter03.HasWeightedApproximateTangentSpaceAt n W.carrier W.mult x P ↔
      Poincare.SimonGMT.Chapter03.HasWeightedApproximateTangentSpaceAt n V.carrier V.mult
        (c + R • x) P := by
    intro P
    simp only [Poincare.SimonGMT.Chapter03.HasWeightedApproximateTangentSpaceAt]
    refine and_congr_right fun _ => forall_congr' fun f => ?_
    simp only [himg, hmult]
    rw [hm x]
    constructor
    · intro h
      refine (h.comp (hfil R⁻¹ (inv_pos.2 hR))).congr fun s => ?_
      simp only [Function.comp_apply, mul_inv_cancel_left₀ hR0]
    · intro h
      exact h.comp (hfil R hR)
  -- So `W` at `x` and `V` at `ψ x` choose the same tangent plane.
  have hchoose : ∀ (p q : Submodule ℝ (Amb n ℓ) → Prop) (h₁ : ∃ P, p P) (h₂ : ∃ P, q P),
      p = q → Classical.choose h₁ = Classical.choose h₂ := by
    rintro p q h₁ h₂ rfl
    rfl
  unfold RectifiableVarifold.tangentProj
  by_cases h₁ : ∃ P,
      Poincare.SimonGMT.Chapter03.HasWeightedApproximateTangentSpaceAt n W.carrier W.mult x P
  · have h₂ := (exists_congr key).1 h₁
    rw [dite_eq_left h₁, dite_eq_left h₂]
    congr 1
    exact hchoose _ _ h₁ h₂ (funext fun P => propext (key P))
  · have h₂ : ¬∃ P, Poincare.SimonGMT.Chapter03.HasWeightedApproximateTangentSpaceAt n V.carrier
        V.mult (c + R • x) P := fun h => h₁ ((exists_congr key).2 h)
    rw [dite_eq_right h₁, dite_eq_right h₂]
/-- **Generalized mean curvature of a rescaled varifold** (Simon Ch. 4, Definition 3.14; used for
the rescalings behind Ch. 5, Remark 5.3).  Let `ψ(x) = c + R x` and `φ(y) = R⁻¹ (y − c)`, `R > 0`.
If `μ_W = R⁻ⁿ φ_# μ_V` and `p_{T_x W} = p_{T_{ψ x} V}`, then `W` has generalized mean curvature
`R H ∘ ψ` in `ψ⁻¹ U`: neighbourhoods `t ∈ 𝓝[U] (ψ x)` pull back to `ψ⁻¹ t ∈ 𝓝[ψ⁻¹ U] x`, and for
`X ∈ C¹_c(ψ⁻¹ U)` the field `X̃ = R X ∘ φ ∈ C¹_c(U)` has `DX̃ = DX ∘ φ`, so `div_W X ∘ φ = div_V X̃`
and `X ∘ φ · R H = X̃ · H`; changing variables along `φ` turns the first variation of `W` at `X`
into `R⁻ⁿ` times that of `V` at `X̃`. -/
theorem any_radius_rv_meanCurvature : ∀ (n ℓ : ℕ) (U : Set (Amb n ℓ)) (V : RectifiableVarifold n ℓ U) (c : Amb n ℓ) (R : ℝ), 0 < R → ∀ W : RectifiableVarifold n ℓ ((fun x => c + R • x) ⁻¹' U), W.weight = (ENNReal.ofReal (R ^ n))⁻¹ • V.weight.map (fun x => R⁻¹ • (x - c)) → (∀ x, W.tangentProj x = V.tangentProj (c + R • x)) → ∀ H : Amb n ℓ → Amb n ℓ, V.HasGeneralizedMeanCurvature H → W.HasGeneralizedMeanCurvature (fun x => R • H (c + R • x)) := by
  intro n ℓ U V c R hR W hw hT H hH
  obtain ⟨hHloc, hHfv⟩ := hH
  have hR0 : R ≠ 0 := hR.ne'
  -- `κ = R⁻ⁿ` is finite.
  have hκ : (ENNReal.ofReal (R ^ n))⁻¹ ≠ ∞ :=
    ENNReal.inv_ne_top.2 (ENNReal.ofReal_pos.2 (pow_pos hR n)).ne'
  -- `ψ (φ y) = y` and `φ (ψ x) = x`.
  have hψφ : ∀ y : Amb n ℓ, c + R • R⁻¹ • (y - c) = y := fun y => by
    rw [smul_smul, mul_inv_cancel₀ hR0, one_smul, add_sub_cancel]
  have hφψ : ∀ x : Amb n ℓ, R⁻¹ • (c + R • x - c) = x := fun x => by
    rw [add_sub_cancel_left, smul_smul, inv_mul_cancel₀ hR0, one_smul]
  have hψc : Continuous (fun x : Amb n ℓ => c + R • x) :=
    continuous_const.add (continuous_const_smul R)
  -- `φ` is a homeomorphism with inverse `ψ`; as a measurable equivalence, `μ_W = κ • φ_# μ_V`.
  let φ : Amb n ℓ ≃ₜ Amb n ℓ :=
    { toFun := fun y => R⁻¹ • (y - c)
      invFun := fun x => c + R • x
      left_inv := hψφ
      right_inv := hφψ
      continuous_toFun := (continuous_sub_right c).const_smul R⁻¹
      continuous_invFun := hψc }
  have hw' : W.weight = (ENNReal.ofReal (R ^ n))⁻¹ • V.weight.map φ.toMeasurableEquiv := hw
  refine ⟨?_, ?_⟩
  · -- Local integrability: transport `t ∈ 𝓝[U] (ψ x)` to `ψ⁻¹ t ∈ 𝓝[ψ⁻¹ U] x`.
    intro x hx
    obtain ⟨t, ht, hti⟩ := hHloc (c + R • x) hx
    refine ⟨(fun x => c + R • x) ⁻¹' t, ?_, ?_⟩
    · exact (hψc.continuousWithinAt.tendsto_nhdsWithin (mapsTo_preimage _ _)) ht
    · -- `(κ • ν)⌞s = κ • ν⌞s` with `κ ≠ ∞`, and
      -- `IntegrableOn (R H ∘ ψ) (ψ⁻¹ t) (φ_# μ_V) ↔ IntegrableOn (R H) t μ_V`.
      rw [hw', IntegrableOn, Measure.restrict_smul]
      refine Integrable.smul_measure ?_ hκ
      change IntegrableOn _ _ (V.weight.map φ.toMeasurableEquiv)
      rw [integrableOn_map_equiv]
      have h1 : (fun x => R • H (c + R • x)) ∘ φ.toMeasurableEquiv = R • H := by
        funext y
        show R • H (c + R • R⁻¹ • (y - c)) = R • H y
        rw [hψφ]
      have h2 : φ.toMeasurableEquiv ⁻¹' ((fun x => c + R • x) ⁻¹' t) = t := by
        ext y
        show c + R • R⁻¹ • (y - c) ∈ t ↔ y ∈ t
        rw [hψφ]
      rw [h1, h2]
      exact Integrable.smul R hti
  · -- First variation: test `V` with the transported field `X̃(y) = R X(φ y)`.
    intro X hX hXc hXs
    have hXd : Differentiable ℝ X := hX.differentiable one_ne_zero
    have hX'c : ContDiff ℝ 1 (fun y => R • X (R⁻¹ • (y - c))) :=
      (hX.comp ((contDiff_id.sub contDiff_const).const_smul R⁻¹)).const_smul R
    have hX'cs : HasCompactSupport (fun y => R • X (R⁻¹ • (y - c))) :=
      (hXc.comp_homeomorph φ).comp_left (g := fun v : Amb n ℓ => R • v) (smul_zero R)
    -- `y ∈ tsupport X̃` gives `φ y ∈ tsupport X ⊆ ψ⁻¹ U`, i.e. `y = ψ (φ y) ∈ U`.
    have hX's : tsupport (fun y => R • X (R⁻¹ • (y - c))) ⊆ U := by
      intro y hy
      have h1 := tsupport_smul_subset_right (fun _ => R) (fun y => X (R⁻¹ • (y - c))) hy
      have h2 := hXs (tsupport_comp_subset_preimage X φ.continuous h1)
      have h3 : c + R • R⁻¹ • (y - c) ∈ U := h2
      rwa [hψφ] at h3
    have key := hHfv _ hX'c hX'cs hX's
    -- `DX̃(y) = R • (DX(φ y) ∘ R⁻¹ • id) = DX(φ y)`.
    have hder : ∀ y, fderiv ℝ (fun y => R • X (R⁻¹ • (y - c))) y =
        fderiv ℝ X (R⁻¹ • (y - c)) := by
      intro y
      have h1 : HasFDerivAt (fun y : Amb n ℓ => R⁻¹ • (y - c))
          (R⁻¹ • ContinuousLinearMap.id ℝ (Amb n ℓ)) y :=
        ((hasFDerivAt_id y).sub_const c).const_smul R⁻¹
      have h2 : HasFDerivAt (fun y => R • X (R⁻¹ • (y - c)))
          (R • ((fderiv ℝ X (R⁻¹ • (y - c))).comp (R⁻¹ • ContinuousLinearMap.id ℝ (Amb n ℓ)))) y :=
        ((hXd (R⁻¹ • (y - c))).hasFDerivAt.comp y h1).const_smul R
      rw [h2.fderiv]
      refine ContinuousLinearMap.ext fun v => ?_
      rw [smul_apply, ContinuousLinearMap.comp_apply, smul_apply, ContinuousLinearMap.id_apply,
        ContinuousLinearMap.map_smul, smul_smul, mul_inv_cancel₀ hR0, one_smul]
    -- `div_W X (φ y) = div_V X̃ (y)`, by the tangent hypothesis and `ψ (φ y) = y`.
    have hdiv : ∀ y, W.divM X (R⁻¹ • (y - c)) = V.divM (fun y => R • X (R⁻¹ • (y - c))) y := by
      intro y
      simp only [RectifiableVarifold.divM, hT, hψφ, hder]
    -- `X (φ y) · R H (ψ (φ y)) = X̃ (y) · H (y)`.
    have hpair : ∀ y, inner ℝ (X (R⁻¹ • (y - c))) (R • H (c + R • R⁻¹ • (y - c))) =
        inner ℝ (R • X (R⁻¹ • (y - c))) (H y) := by
      intro y
      rw [hψφ, real_inner_smul_right, real_inner_smul_left]
    -- `∫ g dμ_W = κ.toReal • ∫ g ∘ φ dμ_V` on both sides, then the first variation of `V` at `X̃`.
    rw [hw', integral_smul_measure, integral_smul_measure, integral_map_equiv, integral_map_equiv]
    show (ENNReal.ofReal (R ^ n))⁻¹.toReal • ∫ y, W.divM X (R⁻¹ • (y - c)) ∂V.weight =
      -((ENNReal.ofReal (R ^ n))⁻¹.toReal •
        ∫ y, inner ℝ (X (R⁻¹ • (y - c))) (R • H (c + R • R⁻¹ • (y - c))) ∂V.weight)
    simp only [hdiv, hpair, key, smul_neg]
/-- **Translation and dilation of rectifiable varifolds** (fact (Inv) for Simon 5.3).  For
`ψ(x) = c + R x` with `R > 0`, there is a varifold `V' = v(ψ⁻¹M, θ ∘ ψ)` in `U' = ψ⁻¹(U)` with
weight `R⁻ⁿ φ_# μ_V` (`φ(y) = R⁻¹(y − c)`), support `ψ⁻¹(spt V)` and tangent projections
`p_{T_x M'} = p_{T_{ψ(x)} M}`; if `V` has generalized mean curvature `H` in `U`, then `V'` has
generalized mean curvature `R H ∘ ψ` in `U'`.
Proof: `any_radius_rv_exists_structure` gives `V'` with carrier `ψ⁻¹M` and multiplicity `θ ∘ ψ`.
These two identities give the weight (`any_radius_rv_weight_eq`) and the tangent projections
(`any_radius_rv_tangentProj_eq`), and the weight and tangent projections in turn give the support
(`any_radius_rv_support_eq`) and the mean curvature (`any_radius_rv_meanCurvature`). -/
theorem any_radius_rescaled_varifold : ∀ (n ℓ : ℕ) (U : Set (Amb n ℓ)), IsOpen U → ∀ (V : RectifiableVarifold n ℓ U) (c : Amb n ℓ) (R : ℝ), 0 < R → ∃ V' : RectifiableVarifold n ℓ ((fun x => c + R • x) ⁻¹' U), V'.carrier = (fun x => c + R • x) ⁻¹' V.carrier ∧ (∀ x, V'.mult x = V.mult (c + R • x)) ∧ V'.weight = (ENNReal.ofReal (R ^ n))⁻¹ • V.weight.map (fun x => R⁻¹ • (x - c)) ∧ V'.support = (fun x => c + R • x) ⁻¹' V.support ∧ (∀ x, V'.tangentProj x = V.tangentProj (c + R • x)) ∧ ∀ H : Amb n ℓ → Amb n ℓ, V.HasGeneralizedMeanCurvature H → V'.HasGeneralizedMeanCurvature (fun x => R • H (c + R • x)) := by
  intro n ℓ U _ V c R hR
  -- Steps 1–2: `V' = v(ψ⁻¹M, θ ∘ ψ)` is a rectifiable varifold in `ψ⁻¹(U)`.
  obtain ⟨V', hcarrier, hmult⟩ := Submission.any_radius_rv_exists_structure n ℓ U V c R hR
  -- Step 3: `μ_{V'} = R⁻ⁿ φ_# μ_V`, by change of variables.
  have hweight := Submission.any_radius_rv_weight_eq n ℓ U _ V V' c R hR hcarrier hmult
  -- Step 5: the blow-ups of `(ψ⁻¹M, θ ∘ ψ)` at `x` are those of `(M, θ)` at `ψ(x)`.
  have htangent := Submission.any_radius_rv_tangentProj_eq n ℓ U _ V V' c R hR hcarrier hmult
  -- Steps 4 and 6: support and first variation depend only on the weight and tangent planes.
  exact ⟨V', hcarrier, hmult, hweight,
    Submission.any_radius_rv_support_eq n ℓ U V c R hR V' hweight, htangent,
    fun H hH => Submission.any_radius_rv_meanCurvature n ℓ U V c R hR V' hweight htangent H hH⟩
set_option maxHeartbeats 10000000 in
open scoped CompactlySupported in
/-- A map `f : ℝⁿ → ℝ^ℓ` that is `K`-Lipschitz on the closed ball `B_R(0)` (graph estimates in the
proof of Simon Ch. 5, Theorem 4.5, displays (8)–(12), pp. 118–119): the set of points of the open
ball `B̆_R(0)` where `f` is not differentiable is Borel and `Lⁿ`-null (Rademacher's theorem),
`‖Df(x)‖ ≤ K` on `B̆_R(0)`, and where `f` is differentiable the gradient of the coordinate
`fʲ = (y ↦ f(y)ⱼ)` represents the `j`-th row of `Df(x)`: `⟨∇fʲ(x), v⟩ = (Df(x) v)ⱼ`. -/
theorem gte_lipschitz_ball_calculus : ∀ (n ℓ : ℕ) (f : Rn n → Rn ℓ) (K : ℝ≥0) (R : ℝ), LipschitzOnWith K f (closedBall 0 R) → MeasurableSet (ball (0 : Rn n) R ∩ {x | ¬DifferentiableAt ℝ f x}) ∧ volume (ball (0 : Rn n) R ∩ {x | ¬DifferentiableAt ℝ f x}) = 0 ∧ ∀ x ∈ ball (0 : Rn n) R, ‖fderiv ℝ f x‖ ≤ K ∧ (DifferentiableAt ℝ f x → ∀ (j : Fin ℓ) (v : Rn n), inner ℝ (gradient (fun y => f y j) x) v = fderiv ℝ f x v j) := by
  intro n ℓ f K R hf
  -- (i): the differentiability set of any map into a complete space is Borel
  refine ⟨measurableSet_ball.inter (measurableSet_of_differentiableAt ℝ f).compl, ?_, ?_⟩
  -- (ii): Rademacher on the open ball, where differentiability within it is differentiability
  · have hae := (hf.mono ball_subset_closedBall).ae_differentiableWithinAt_of_mem
      (μ := (volume : Measure (Rn n)))
    rw [measure_eq_zero_iff_ae_notMem]
    filter_upwards [hae] with x hx hxZ
    exact hxZ.2 ((hx hxZ.1).differentiableAt (isOpen_ball.mem_nhds hxZ.1))
  · intro x hx
    -- (iii): `B_R(0)` is a neighbourhood of `x` on which `f` is `K`-Lipschitz
    refine ⟨norm_fderiv_le_of_lipschitzOn ℝ
      (mem_of_superset (isOpen_ball.mem_nhds hx) ball_subset_closedBall) hf, ?_⟩
    -- gradient rows: `fʲ = proj_j ∘ f`, the chain rule, and `⟪(toDual)⁻¹ L, v⟫ = L v`
    intro hfx j v
    have hd : HasFDerivAt (fun y => f y j)
        ((EuclideanSpace.proj j : Rn ℓ →L[ℝ] ℝ).comp (fderiv ℝ f x)) x :=
      (EuclideanSpace.proj j : Rn ℓ →L[ℝ] ℝ).hasFDerivAt.comp x hfx.hasFDerivAt
    rw [inner_gradient_left, hd.fderiv]
    rfl

/-- Simon Ch. 5, proof of Lemma 2.1 (p. 108): a cutoff `ζ ∈ C^∞(ℝᵐ)` with `0 ≤ ζ ≤ 1`, `ζ ≡ 1` on
`B_{ρ/2}(ξ)`, `ζ ≡ 0` outside `B̆_ρ(ξ)` and `|Dζ| ≤ 3/ρ`.  Take `ζ(x) = φ(|x − ξ|/ρ)` for the smooth
`3`-Lipschitz step profile `φ` (`φ = 1` on `(-∞, 1/2]`, `φ = 0` on `[1, ∞)`): `ζ` is smooth since it
is constant near `ξ`, and the radial lift of a `3`-Lipschitz profile has `|Dζ| ≤ 3/ρ`. -/
theorem exists_smooth_cutoff_half_ball_grad_le : ∀ (m : ℕ) (ξ : Rn m) (ρ : ℝ), 0 < ρ → ∃ ζ : Rn m → ℝ, ContDiff ℝ (⊤ : ℕ∞) ζ ∧ (∀ x, 0 ≤ ζ x ∧ ζ x ≤ 1) ∧ (∀ x ∈ Metric.closedBall ξ (ρ / 2), ζ x = 1) ∧ (∀ x, ρ ≤ dist x ξ → ζ x = 0) ∧ ∀ x, ‖fderiv ℝ ζ x‖ ≤ 3 / ρ := by
  intro m ξ ρ hρ
  obtain ⟨φ, hφ_smooth, hφ_bounds, hφ_one, hφ_zero, hφ_lip⟩ :=
    Submission.exists_smooth_step_profile_lipschitz_three
  refine ⟨fun x => φ (‖x - ξ‖ / ρ),
    Submission.contDiff_radial_profile_of_eq_one_le_half m ξ ρ φ hρ hφ_smooth hφ_one,
    fun x => hφ_bounds _, fun x hx => hφ_one _ ?_, fun x hx => hφ_zero _ ?_, fun x => ?_⟩
  · -- `|x − ξ| ≤ ρ/2`, so `|x − ξ|/ρ ≤ 1/2`.
    rw [Metric.mem_closedBall, dist_eq_norm] at hx
    rw [div_le_iff₀ hρ]
    linarith
  · -- `ρ ≤ |x − ξ|`, so `1 ≤ |x − ξ|/ρ`.
    rw [dist_eq_norm] at hx
    rw [le_div_iff₀ hρ]
    linarith
  · -- The profile is `3`-Lipschitz, so `|Dζ(x)| ≤ 3/ρ`.
    have h := Submission.norm_fderiv_radial_profile_le_of_lipschitzWith m ξ ρ 3 φ hρ hφ_lip x
    rwa [NNReal.coe_ofNat] at h

/-- **Density of the varifold weight with respect to `Hⁿ`** (Simon Ch. 4, 1.1: `μ_V = Hⁿ ⌞ θ`,
with `θ = 0` off `M`).  Writing `g = 1_M θ`: (i) `g` has a Borel representative that is `≥ 0`
everywhere; (ii) `∫_S φ dμ_V = ∫_S g φ dHⁿ` for every Borel `S` and every `φ ≥ 0` (not necessarily
measurable).  `g ≥ 0` because `θ > 0` on `M`, and `g` is `Hⁿ`-a.e. measurable since `M` is
`Hⁿ`-null-measurable and `θ` is a.e. measurable on `M`; `max(mk g, 0)` is the representative.
For (ii), `μ_V⌞S = ((Hⁿ⌞M)⌞S) ⌞ ofReal ∘ θ`, the finite density can be multiplied in without
measurability of `φ`, `(Hⁿ⌞M)⌞S = (Hⁿ⌞S)⌞M`, and integrating over `M` is integrating `1_M`. -/
theorem gwe_vgt_weight_density : ∀ (n ℓ : ℕ) (U : Set (Amb n ℓ)) (V : RectifiableVarifold n ℓ U), (∃ g : Amb n ℓ → ℝ, Measurable g ∧ (∀ y, 0 ≤ g y) ∧ g =ᵐ[(μHE[n] : Measure (Amb n ℓ))] V.carrier.indicator V.mult) ∧ ∀ S : Set (Amb n ℓ), MeasurableSet S → ∀ φ : Amb n ℓ → ℝ≥0∞, ∫⁻ y in S, φ y ∂V.weight = ∫⁻ y in S, ENNReal.ofReal (V.carrier.indicator V.mult y) * φ y ∂(μHE[n] : Measure (Amb n ℓ)) := by
  intro n ℓ U V
  have hM : NullMeasurableSet V.carrier (μHE[n] : Measure (Amb n ℓ)) :=
    V.nullMeasurableSet_carrier
  -- `g = 1_M θ ≥ 0` everywhere, since `θ > 0` on `M`.
  have hg0 : ∀ y, 0 ≤ V.carrier.indicator V.mult y := by
    intro y
    by_cases hy : y ∈ V.carrier
    · rw [indicator_of_mem hy]
      exact (V.mult_pos y hy).le
    · rw [indicator_of_notMem hy]
  refine ⟨?_, ?_⟩
  · -- (i) `g` is `Hⁿ`-a.e. measurable; `max(mk g, 0)` is a nonnegative Borel representative.
    have hae : AEMeasurable (V.carrier.indicator V.mult) (μHE[n] : Measure (Amb n ℓ)) :=
      (aemeasurable_indicator_iff₀ hM).2 V.aemeasurable_mult
    refine ⟨fun y => max (hae.mk _ y) 0, hae.measurable_mk.max measurable_const,
      fun y => le_max_right _ _, ?_⟩
    filter_upwards [hae.ae_eq_mk] with y hy
    rw [← hy]
    exact max_eq_left (hg0 y)
  · -- (ii) Remove the finite density `ofReal ∘ θ`, then rearrange the restrictions.
    intro S hS φ
    have hρ : AEMeasurable (fun x => ENNReal.ofReal (V.mult x))
        (((μHE[n] : Measure (Amb n ℓ)).restrict V.carrier).restrict S) :=
      V.aemeasurable_mult.ennreal_ofReal.restrict
    have hMS : NullMeasurableSet V.carrier ((μHE[n] : Measure (Amb n ℓ)).restrict S) :=
      hM.mono Measure.restrict_le_self
    rw [RectifiableVarifold.weight, restrict_withDensity hS,
      lintegral_withDensity_eq_lintegral_mul_non_measurable₀ _ hρ
        (ae_of_all _ fun _ => ENNReal.ofReal_lt_top),
      Measure.restrict_restrict hS, inter_comm, ← Measure.restrict_restrict₀ hMS,
      ← lintegral_indicator₀ hMS]
    refine lintegral_congr fun y => ?_
    by_cases hy : y ∈ V.carrier
    · simp [indicator_of_mem hy]
    · simp [indicator_of_notMem hy]

/-- **Measurability of the graph map and of the graph Jacobian** over a closed ball `B = B_R(0)`.
Let `F(x) = q(graphPoint x (f x))` with `f` continuous on `B`, and `J_f(x) =
√det(Iₙ + (⟨Df(x) e_a, Df(x) e_b⟩)_{a,b})`.  (i) `F(A)` is Borel for every Borel `A ⊆ B`:
`(a, b) ↦ graphPoint a b` is continuous coordinatewise, so `F` is continuous on `B`; `F` is
injective, since the first `n` coordinates of `F(x)` determine `x` after undoing `q`; apply
Lusin–Souslin.  (ii) `F` agrees on `B` with the Borel map `B.piecewise F 0` (`B` closed).
(iii) `J_f = Φ ∘ Df` with `Φ` continuous on `ℝⁿ →L[ℝ] ℝ^ℓ` and `Df` Borel. -/
theorem gwe_vgt_graph_measurability : ∀ (n ℓ : ℕ) (q : Amb n ℓ ≃ₗᵢ[ℝ] Amb n ℓ) (f : Rn n → Rn ℓ) (R : ℝ), ContinuousOn f (closedBall 0 R) → (∀ A : Set (Rn n), MeasurableSet A → A ⊆ closedBall 0 R → MeasurableSet (q '' graphOver f A)) ∧ (∃ Fh : Rn n → Amb n ℓ, Measurable Fh ∧ ∀ x ∈ closedBall (0 : Rn n) R, Fh x = q (graphPoint x (f x))) ∧ Measurable (fun x : Rn n => Real.sqrt (Matrix.det ((1 : Matrix (Fin n) (Fin n) ℝ) + Matrix.of fun a b : Fin n => inner ℝ (fderiv ℝ f x (EuclideanSpace.single a (1 : ℝ))) (fderiv ℝ f x (EuclideanSpace.single b (1 : ℝ)))))) := by
  intro n ℓ q f R hf
  -- `(a, b) ↦ graphPoint a b` is continuous: each coordinate is a coordinate of `a` or of `b`.
  have hgp : Continuous (fun p : Rn n × Rn ℓ => graphPoint p.1 p.2) := by
    unfold graphPoint
    refine (PiLp.continuous_toLp 2 _).comp (continuous_pi fun i => ?_)
    refine Fin.addCases (fun j => ?_) (fun k => ?_) i
    · simp only [Fin.append_left]
      exact (continuous_apply j).comp ((PiLp.continuous_ofLp 2 _).comp continuous_fst)
    · simp only [Fin.append_right]
      exact (continuous_apply k).comp ((PiLp.continuous_ofLp 2 _).comp continuous_snd)
  -- `F = q ∘ (x ↦ graphPoint x (f x))` is continuous on `B` and injective.
  have hFc : ContinuousOn (fun x => q (graphPoint x (f x))) (closedBall 0 R) :=
    q.continuous.comp_continuousOn (hgp.comp_continuousOn (continuousOn_id.prodMk hf))
  have hFi : Function.Injective (fun x => q (graphPoint x (f x))) := by
    intro x y hxy
    have h := congrArg (fun (z : Amb n ℓ) (j : Fin n) => z (Fin.castAdd ℓ j)) (q.injective hxy)
    ext j
    simpa [graphPoint] using congrFun h j
  refine ⟨fun A hA hAB => ?_, ?_, ?_⟩
  · -- (i) Lusin–Souslin for the continuous injective map `F` on the Borel set `A`.
    rw [graphOver, image_image]
    exact hA.image_of_continuousOn_injOn (hFc.mono hAB) hFi.injOn
  · -- (ii) `B.piecewise F 0` is Borel and equals `F` on `B`.
    classical
    exact ⟨(closedBall 0 R).piecewise (fun x => q (graphPoint x (f x))) fun _ => 0,
      hFc.measurable_piecewise continuousOn_const measurableSet_closedBall,
      fun x hx => piecewise_eq_of_mem _ _ _ hx⟩
  · -- (iii) `J_f = Φ ∘ fderiv ℝ f` with `Φ` continuous and `fderiv ℝ f` Borel.
    have hΦ : Continuous fun D : Rn n →L[ℝ] Rn ℓ => Real.sqrt (Matrix.det
        ((1 : Matrix (Fin n) (Fin n) ℝ) + Matrix.of fun a b : Fin n =>
          inner ℝ (D (EuclideanSpace.single a (1 : ℝ)))
            (D (EuclideanSpace.single b (1 : ℝ))))) := by
      refine Real.continuous_sqrt.comp (Continuous.matrix_det (continuous_const.add
        (continuous_matrix fun a b => ?_)))
      simp only [Matrix.of_apply]
      exact (continuous_eval_const _).inner (continuous_eval_const _)
    exact hΦ.measurable.comp (measurable_fderiv ℝ f)

end Submission

/-- **Bochner and null-set transfer** (steps 5 and 6 of the varifold graph transfer).  The
`lintegral` transfer identity says `μ ⌞ S = G_#((Lⁿ ⌞ A) ⌞ W)`; pushing Bochner integrals through
`G` and the density `W ≥ 0` gives (i) for every Borel `φ`, and testing it on `φ = 1_{Z'}` for a Borel
`μ`-null `Z' ⊇ Z` gives `W = 0` a.e. on `A ∩ G⁻¹(Z)`. -/
theorem Submission.gwe_vgt_transfer_consequences : ∀ (n ℓ : ℕ) (μ : Measure (Amb n ℓ)) (S : Set (Amb n ℓ)) (A : Set (Rn n)) (G : Rn n → Amb n ℓ) (W : Rn n → ℝ), MeasurableSet A → Measurable G → Measurable W → (∀ x, 0 ≤ W x) → (∀ φ : Amb n ℓ → ℝ≥0∞, Measurable φ → ∫⁻ y in S, φ y ∂μ = ∫⁻ x in A, ENNReal.ofReal (W x) * φ (G x)) → (∀ φ : Amb n ℓ → ℝ, Measurable φ → ∫ y in S, φ y ∂μ = ∫ x in A, W x * φ (G x)) ∧ ∀ Z : Set (Amb n ℓ), μ Z = 0 → ∀ᵐ x ∂(volume : Measure (Rn n)), x ∈ A → G x ∈ Z → W x = 0 := by
  intro n ℓ μ S A G W hA hG hW hW0 hT
  -- Step 1: `μ ⌞ S = G_# ν` with `ν = (Lⁿ ⌞ A).withDensity (ofReal ∘ W)`, tested on Borel `T`.
  have hpush : μ.restrict S =
      Measure.map G ((volume.restrict A).withDensity fun x => ENNReal.ofReal (W x)) := by
    ext T hTm
    calc μ.restrict S T = ∫⁻ y in S, T.indicator 1 y ∂μ := (lintegral_indicator_one hTm).symm
      _ = ∫⁻ x in A, ENNReal.ofReal (W x) * T.indicator 1 (G x) :=
          hT _ (measurable_one.indicator hTm)
      _ = ∫⁻ x in A, (G ⁻¹' T).indicator (fun x => ENNReal.ofReal (W x)) x := by
          refine lintegral_congr fun x => ?_
          by_cases hx : G x ∈ T <;> simp [hx]
      _ = ∫⁻ x in G ⁻¹' T, ENNReal.ofReal (W x) ∂(volume.restrict A) :=
          lintegral_indicator (hG hTm) _
      _ = Measure.map G ((volume.restrict A).withDensity fun x => ENNReal.ofReal (W x)) T := by
          rw [Measure.map_apply hG hTm, withDensity_apply _ (hG hTm)]
  refine ⟨fun φ hφ => ?_, fun Z hZ => ?_⟩
  · -- Step 2: push the Bochner integral through `G`, then through the density `ofReal ∘ W`.
    rw [hpush, integral_map hG.aemeasurable hφ.aestronglyMeasurable,
      integral_withDensity_eq_integral_toReal_smul hW.ennreal_ofReal
        (ae_of_all _ fun _ => ENNReal.ofReal_lt_top)]
    refine integral_congr_ae (ae_of_all _ fun x => ?_)
    simp only [ENNReal.toReal_ofReal (hW0 x), smul_eq_mul]
  · -- Steps 3–5: test the identity on `1_{Z'}` for a Borel `μ`-null `Z' ⊇ Z`.
    obtain ⟨Z', hZZ', hZ'm, hZ'0⟩ := exists_measurable_superset_of_null hZ
    have hmeas : Measurable fun x => ENNReal.ofReal (W x) * Z'.indicator 1 (G x) :=
      hW.ennreal_ofReal.mul ((measurable_one.indicator hZ'm).comp hG)
    have h0 : ∫⁻ x in A, ENNReal.ofReal (W x) * Z'.indicator 1 (G x) = 0 := by
      rw [← hT _ (measurable_one.indicator hZ'm), lintegral_indicator_one hZ'm]
      exact nonpos_iff_eq_zero.1 ((Measure.restrict_apply_le _ _).trans hZ'0.le)
    filter_upwards [(ae_restrict_iff' hA).1 ((lintegral_eq_zero_iff hmeas).1 h0)]
      with x hx hxA hGx
    have h1 := hx hxA
    simp only [Set.indicator_of_mem (hZZ' hGx), Pi.one_apply, mul_one, Pi.zero_apply,
      ENNReal.ofReal_eq_zero] at h1
    exact le_antisymm h1 (hW0 x)

namespace Submission

/-- **The Gram matrix of a linear map** (Simon Ch. 5, proof of Theorem 4.5, p. 119: the graph
Jacobian `J_F = √det(δ_ij + D_i f · D_j f)`).  For `D : ℝⁿ →L[ℝ] ℝ^ℓ` let `G_ab = ⟨D e_a, D e_b⟩`.
Then (i) `G` is symmetric, since the real inner product is; (ii) `G` is positive semidefinite:
`x · Gx = Σ_{a,b} x_a x_b ⟨D e_a, D e_b⟩ = |Σ_a x_a D e_a|² ≥ 0` by bilinearity; and
(iii) `trace G = Σ_a |D e_a|² = |D|²` (`hsNormSq`). -/
theorem gwe_gjb_gram_symm_psd_trace : ∀ (n ℓ : ℕ) (D : Rn n →L[ℝ] Rn ℓ), Matrix.IsSymm (Matrix.of fun a b : Fin n => inner ℝ (D (EuclideanSpace.single a (1 : ℝ))) (D (EuclideanSpace.single b (1 : ℝ)))) ∧ (∀ x : Fin n → ℝ, 0 ≤ dotProduct x (Matrix.mulVec (Matrix.of fun a b : Fin n => inner ℝ (D (EuclideanSpace.single a (1 : ℝ))) (D (EuclideanSpace.single b (1 : ℝ)))) x)) ∧ Matrix.trace (Matrix.of fun a b : Fin n => inner ℝ (D (EuclideanSpace.single a (1 : ℝ))) (D (EuclideanSpace.single b (1 : ℝ)))) = hsNormSq D := by
  intro n ℓ D
  refine ⟨?_, fun x => ?_, ?_⟩
  · -- (i) `G_ba = ⟨D e_b, D e_a⟩ = ⟨D e_a, D e_b⟩ = G_ab`.
    refine Matrix.IsSymm.ext fun a b => ?_
    simp only [Matrix.of_apply]
    exact real_inner_comm _ _
  · -- (ii) `x · Gx = ⟨w, w⟩` for `w = Σ_a x_a • D e_a`, by bilinearity.
    have h : dotProduct x (Matrix.mulVec (Matrix.of fun a b : Fin n =>
        inner ℝ (D (EuclideanSpace.single a (1 : ℝ))) (D (EuclideanSpace.single b (1 : ℝ)))) x) =
        inner ℝ (∑ a, x a • D (EuclideanSpace.single a (1 : ℝ)))
          (∑ b, x b • D (EuclideanSpace.single b (1 : ℝ))) := by
      simp only [dotProduct, Matrix.mulVec, Matrix.of_apply, sum_inner, inner_sum,
        real_inner_smul_left, real_inner_smul_right, Finset.mul_sum]
      refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
      rw [real_inner_comm (D (EuclideanSpace.single a (1 : ℝ)))]
      ring
    rw [h]
    exact real_inner_self_nonneg
  · -- (iii) `trace G = Σ_a ⟨D e_a, D e_a⟩ = Σ_a ‖D e_a‖² = hsNormSq D`.
    simp only [Matrix.trace, Matrix.diag, Matrix.of_apply, hsNormSq, real_inner_self_eq_norm_sq]

/-- **Determinant bounds for `I + G`** (graph Jacobian bounds in the tilt-excess decay argument):
if `G` is a symmetric real `n × n` matrix with `0 ≤ x ⬝ᵥ G x` for all `x`, then
`1 ≤ det (I + G) ≤ exp (trace G)`.  By Gaussian elimination: `A = I + G` satisfies
`x ⬝ᵥ x ≤ x ⬝ᵥ A x`, so its pivot `a = A₀₀` is at least `1`, and clearing the first column gives
`det A = a * det S` for the Schur complement `S = C - a⁻¹ b bᵀ`.  `S` is again symmetric with
`x ⬝ᵥ x ≤ x ⬝ᵥ S x` (test `A` on `(-(b ⬝ᵥ x) / a, x)`) and `trace S ≤ trace A - a`, so induction
gives `1 ≤ det A ≤ exp (trace A - n)` using `a ≤ exp (a - 1)`; finally `trace (I + G) = n + trace G`.
-/
theorem gwe_gjb_det_one_add_bounds : ∀ (n : ℕ) (G : Matrix (Fin n) (Fin n) ℝ), Matrix.IsSymm G → (∀ x : Fin n → ℝ, 0 ≤ dotProduct x (Matrix.mulVec G x)) → 1 ≤ Matrix.det ((1 : Matrix (Fin n) (Fin n) ℝ) + G) ∧ Matrix.det ((1 : Matrix (Fin n) (Fin n) ℝ) + G) ≤ Real.exp (Matrix.trace G) := by
  -- Induction on the size: a symmetric `A` with `x ⬝ᵥ x ≤ x ⬝ᵥ A x` for all `x` satisfies
  -- `1 ≤ det A ≤ exp (trace A - m)`.
  have key : ∀ (m : ℕ) (A : Matrix (Fin m) (Fin m) ℝ), (∀ i j, A j i = A i j) →
      (∀ x : Fin m → ℝ, dotProduct x x ≤ dotProduct x (Matrix.mulVec A x)) →
      1 ≤ A.det ∧ A.det ≤ Real.exp (A.trace - m) := by
    intro m
    induction m with
    | zero =>
      intro A _ _
      simp [Matrix.det_fin_zero, Matrix.trace]
    | succ m ih =>
      intro A hA hq
      -- The pivot `a = A₀₀ = e₀ ⬝ᵥ A e₀` is at least `e₀ ⬝ᵥ e₀ = 1`.
      have ha : 1 ≤ A 0 0 := by
        have h := hq (Pi.single 0 1)
        simpa using h
      have ha0 : A 0 0 ≠ 0 := (by linarith : (0 : ℝ) < A 0 0).ne'
      -- The Schur complement `S = C - a⁻¹ b bᵀ` of the pivot.
      obtain ⟨S, hS⟩ : ∃ S : Matrix (Fin m) (Fin m) ℝ,
          S = Matrix.of fun i j => A i.succ j.succ - A i.succ 0 / A 0 0 * A 0 j.succ := ⟨_, rfl⟩
      have hSs : ∀ i j, S j i = S i j := by
        intro i j
        rw [hS, Matrix.of_apply, Matrix.of_apply, hA i.succ j.succ, hA 0 i.succ, hA 0 j.succ]
        ring
      -- `x ⬝ᵥ S x = y ⬝ᵥ A y` for `y = (-(b ⬝ᵥ x) / a, x)`, and `y ⬝ᵥ y ≥ x ⬝ᵥ x`.
      have hSq : ∀ x : Fin m → ℝ, dotProduct x x ≤ dotProduct x (Matrix.mulVec S x) := by
        intro x
        obtain ⟨b, hb⟩ : ∃ b : ℝ, b = ∑ j : Fin m, A 0 j.succ * x j := ⟨_, rfl⟩
        obtain ⟨Q, hQ⟩ : ∃ Q : ℝ, Q = ∑ i : Fin m, x i * ∑ j : Fin m, A i.succ j.succ * x j :=
          ⟨_, rfl⟩
        have hrow : ∀ i : Fin m,
            Matrix.mulVec S x i = ∑ j, A i.succ j.succ * x j - A 0 i.succ / A 0 0 * b := by
          intro i
          simp only [Matrix.mulVec, dotProduct, hS, Matrix.of_apply]
          rw [hb, Finset.mul_sum, ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [hA 0 i.succ]
          ring
        have eS : dotProduct x (Matrix.mulVec S x) = Q - b * b / A 0 0 := by
          calc dotProduct x (Matrix.mulVec S x)
              = ∑ i, (x i * ∑ j, A i.succ j.succ * x j - A 0 i.succ * x i * (b / A 0 0)) := by
                simp only [dotProduct]
                refine Finset.sum_congr rfl fun i _ => ?_
                rw [hrow i]
                ring
            _ = Q - b * b / A 0 0 := by
                rw [Finset.sum_sub_distrib, ← Finset.sum_mul, ← hQ, ← hb]
                ring
        have eA : ∀ t : ℝ, dotProduct (Fin.cons t x : Fin (m + 1) → ℝ)
            (Matrix.mulVec A (Fin.cons t x)) = A 0 0 * t * t + 2 * t * b + Q := by
          intro t
          simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ]
          have h1 : ∑ i : Fin m, x i * (A i.succ 0 * t + ∑ j, A i.succ j.succ * x j) =
              t * b + Q := by
            rw [hb, hQ, Finset.mul_sum, ← Finset.sum_add_distrib]
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [hA 0 i.succ]
            ring
          rw [h1, ← hb]
          ring
        have eI : ∀ t : ℝ, dotProduct (Fin.cons t x : Fin (m + 1) → ℝ) (Fin.cons t x) =
            t * t + dotProduct x x := by
          intro t
          simp only [dotProduct, Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ]
        have h := hq (Fin.cons (-b / A 0 0) x)
        rw [eA, eI] at h
        rw [eS]
        have e : A 0 0 * (-b / A 0 0) * (-b / A 0 0) + 2 * (-b / A 0 0) * b + Q =
            Q - b * b / A 0 0 := by
          field_simp
          ring
        nlinarith [mul_self_nonneg (-b / A 0 0)]
      -- Eliminating the first column below the pivot: `det A = a * det S`.
      have hdet : A.det = A 0 0 * S.det := by
        obtain ⟨c, hc⟩ : ∃ c : Fin (m + 1) → ℝ,
            c = Fin.cons 0 (fun i : Fin m => A i.succ 0 / A 0 0) := ⟨_, rfl⟩
        obtain ⟨E, hE⟩ : ∃ E : Matrix (Fin (m + 1)) (Fin (m + 1)) ℝ,
            E = Matrix.of fun i j => A i j - c i * A 0 j := ⟨_, rfl⟩
        have hc0 : c 0 = 0 := by rw [hc]; rfl
        have hE0 : ∀ j, E 0 j = A 0 j := by
          intro j
          rw [hE, Matrix.of_apply, hc0]
          ring
        have hAE : A.det = E.det :=
          Matrix.det_eq_of_forall_row_eq_smul_add_const c 0 hc0 fun i j => by
            rw [hE0, hE, Matrix.of_apply]
            ring
        have hcol : ∀ i : Fin m, E i.succ 0 = 0 := by
          intro i
          rw [hE, Matrix.of_apply, hc, Fin.cons_succ, div_mul_cancel₀ _ ha0, sub_self]
        have hsub : E.submatrix Fin.succ Fin.succ = S := by
          ext i j
          simp only [Matrix.submatrix_apply, hE, hS, Matrix.of_apply, hc, Fin.cons_succ]
        rw [hAE, Matrix.det_succ_column_zero, Fin.sum_univ_succ]
        simp only [hcol, mul_zero, zero_mul, Finset.sum_const_zero, add_zero, Fin.val_zero,
          pow_zero, one_mul, Fin.succAbove_zero, hE0, hsub]
      -- `trace A = a + trace S + Σᵢ bᵢ² / a`.
      have htr : A.trace = A 0 0 + S.trace + ∑ i : Fin m, A 0 i.succ ^ 2 / A 0 0 := by
        simp only [Matrix.trace, Matrix.diag, Fin.sum_univ_succ, hS, Matrix.of_apply]
        rw [Finset.sum_sub_distrib]
        have e : ∀ i : Fin m, A i.succ 0 / A 0 0 * A 0 i.succ = A 0 i.succ ^ 2 / A 0 0 := by
          intro i
          rw [hA 0 i.succ]
          ring
        simp only [e]
        ring
      obtain ⟨h1, h2⟩ := ih S hSs hSq
      have hsum : 0 ≤ ∑ i : Fin m, A 0 i.succ ^ 2 / A 0 0 :=
        Finset.sum_nonneg fun i _ => div_nonneg (sq_nonneg _) (by linarith)
      have hexp : A 0 0 ≤ Real.exp (A 0 0 - 1) := by
        have := Real.add_one_le_exp (A 0 0 - 1)
        linarith
      refine ⟨?_, ?_⟩
      · rw [hdet]
        nlinarith
      · rw [hdet]
        calc A 0 0 * S.det ≤ Real.exp (A 0 0 - 1) * Real.exp (S.trace - m) :=
              mul_le_mul hexp h2 (by linarith) (Real.exp_pos _).le
          _ = Real.exp (A 0 0 - 1 + (S.trace - m)) := (Real.exp_add _ _).symm
          _ ≤ Real.exp (A.trace - ↑(m + 1)) := by
              apply Real.exp_le_exp.mpr
              rw [htr]
              push_cast
              linarith
  intro n G hG hpos
  have hsymm : ∀ i j, ((1 : Matrix (Fin n) (Fin n) ℝ) + G) j i =
      ((1 : Matrix (Fin n) (Fin n) ℝ) + G) i j :=
    (Matrix.isSymm_one.add hG).apply
  have hquad : ∀ x : Fin n → ℝ,
      dotProduct x x ≤ dotProduct x (Matrix.mulVec ((1 : Matrix (Fin n) (Fin n) ℝ) + G) x) := by
    intro x
    rw [Matrix.add_mulVec, Matrix.one_mulVec, dotProduct_add]
    linarith [hpos x]
  obtain ⟨h1, h2⟩ := key n _ hsymm hquad
  refine ⟨h1, h2.trans_eq ?_⟩
  rw [Matrix.trace_add, Matrix.trace_one, Fintype.card_fin]
  congr 1
  ring

/-- **Scalar exponential bound** for the area Jacobian of a linear graph (used with `s = |D|²`,
`T = n` in `J(D) ≤ exp(|D|²/2) ≤ 1 + (e^{n/2}/2)|D|²`): for `0 ≤ s ≤ T`,
`exp(s/2) ≤ 1 + (exp(T/2)/2) s`.  With `t = s/2`, `1 - t ≤ exp(-t)` (`add_one_le_exp` at `-t`)
times `exp t > 0` gives `exp t ≤ 1 + t exp t`, and `t exp t ≤ t exp(T/2)` by monotonicity of
`exp` and `0 ≤ t ≤ T/2`. -/
theorem gwe_gjb_exp_half_le : ∀ (s T : ℝ), 0 ≤ s → s ≤ T → Real.exp (s / 2) ≤ 1 + Real.exp (T / 2) / 2 * s := by
  intro s T hs hsT
  -- `1 - s/2 ≤ exp (-(s/2))`: `add_one_le_exp` at `-(s/2)`.
  have h1 : 1 - s / 2 ≤ Real.exp (-(s / 2)) := by
    linarith [Real.add_one_le_exp (-(s / 2))]
  -- Multiply by `exp (s/2) > 0`, using `exp (-(s/2)) * exp (s/2) = exp 0 = 1`.
  have h2 : (1 - s / 2) * Real.exp (s / 2) ≤ 1 := by
    calc (1 - s / 2) * Real.exp (s / 2) ≤ Real.exp (-(s / 2)) * Real.exp (s / 2) :=
          mul_le_mul_of_nonneg_right h1 (Real.exp_pos _).le
      _ = 1 := by rw [← Real.exp_add, neg_add_cancel, Real.exp_zero]
  -- `exp` is monotone, `s/2 ≤ T/2` and `0 ≤ s/2`.
  have h4 : s / 2 * Real.exp (s / 2) ≤ s / 2 * Real.exp (T / 2) :=
    mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (by linarith)) (by linarith)
  -- `exp (s/2) ≤ 1 + (s/2) exp (s/2) ≤ 1 + (s/2) exp (T/2)`.
  linarith

/-- **Hilbert–Schmidt versus operator norm** (Simon, Notation p. ix), as used in the hole estimate
of the proof of Ch. 5, Corollary 2.7 (`‖A‖ ≤ |A|`).  For `A : ℝᵐ →L ℝᵏ` the squared Hilbert–Schmidt
norm `|A|² = Σᵢ |A eᵢ|²` is continuous in `A` (a finite sum of squared norms of the evaluations
`A ↦ A eᵢ`) and satisfies `0 ≤ |A|² ≤ m ‖A‖²` (`|A eᵢ| ≤ ‖A‖ |eᵢ| = ‖A‖`).  Moreover
`|A v|² ≤ |A|² |v|²`: expanding `v = Σᵢ vᵢ eᵢ` gives `|A v| ≤ Σᵢ |vᵢ| |A eᵢ|`, and Cauchy–Schwarz
bounds the square of the right side by `(Σᵢ |vᵢ|²)(Σᵢ |A eᵢ|²) = |v|² |A|²`. -/
theorem lgc_hsNormSq_bounds : ∀ (m k : ℕ), Continuous (fun A : Rn m →L[ℝ] Rn k => hsNormSq A) ∧ ∀ A : Rn m →L[ℝ] Rn k, 0 ≤ hsNormSq A ∧ hsNormSq A ≤ m * ‖A‖ ^ 2 ∧ ∀ v : Rn m, ‖A v‖ ^ 2 ≤ hsNormSq A * ‖v‖ ^ 2 := by
  intro m k
  refine ⟨?_, fun A => ⟨?_, ?_, fun v => ?_⟩⟩
  · -- Continuity: a finite sum of `‖A eᵢ‖ ^ 2`, each continuous in `A`.
    unfold hsNormSq
    fun_prop
  · unfold hsNormSq
    positivity
  · -- `‖A eᵢ‖ ≤ ‖A‖ ‖eᵢ‖ = ‖A‖` for each of the `m` summands.
    unfold hsNormSq
    calc ∑ i, ‖A (EuclideanSpace.single i 1)‖ ^ 2 ≤ ∑ _i : Fin m, ‖A‖ ^ 2 := by
          gcongr with i
          calc ‖A (EuclideanSpace.single i 1)‖ ≤ ‖A‖ * ‖EuclideanSpace.single i (1:ℝ)‖ :=
                A.le_opNorm _
            _ = ‖A‖ := by simp
      _ = m * ‖A‖ ^ 2 := by simp
  · unfold hsNormSq
    set e : Fin m → Rn m := fun i => EuclideanSpace.single i 1 with he
    -- Expand `v` in the standard basis and apply the triangle inequality.
    have hv : v = ∑ i, v i • e i := by
      ext j
      simp [he, Pi.single_apply]
    have hAv : A v = ∑ i, v i • A (e i) := by
      conv_lhs => rw [hv]
      simp [map_sum, map_smul]
    have h1 : ‖A v‖ ≤ ∑ i, |v i| * ‖A (e i)‖ := by
      rw [hAv]
      calc _ ≤ ∑ i, ‖v i • A (e i)‖ := norm_sum_le _ _
        _ = _ := by simp [norm_smul]
    -- Cauchy–Schwarz for the finite sums, and `‖v‖² = Σᵢ |vᵢ|²`.
    have h2 : (∑ i, |v i| * ‖A (e i)‖) ^ 2 ≤ (∑ i, |v i| ^ 2) * (∑ i, ‖A (e i)‖ ^ 2) :=
      Finset.sum_mul_sq_le_sq_mul_sq _ _ _
    have h3 : ‖v‖ ^ 2 = ∑ i, |v i| ^ 2 := by
      rw [EuclideanSpace.norm_sq_eq]
      simp [sq_abs]
    have h0 : 0 ≤ ‖A v‖ := norm_nonneg _
    calc ‖A v‖ ^ 2 ≤ (∑ i, |v i| * ‖A (e i)‖) ^ 2 := by gcongr
      _ ≤ (∑ i, |v i| ^ 2) * (∑ i, ‖A (e i)‖ ^ 2) := h2
      _ = (∑ i, ‖A (e i)‖ ^ 2) * ‖v‖ ^ 2 := by rw [h3, mul_comm]

/-- Simon Ch. 5, Lemma 2.6 and its proof (pp. 110–111): the distance from `q(a, b)` to the plane
`T₀ = q(ℝⁿ × {0})` is `|b|`. By `lip_approx_graph_coordinates`, the points of `T₀` are exactly the
`q(c, 0)` (each `q(c, 0) = p_{T₀}(q(c, 0))` lies in `T₀`, and `p ∈ T₀` with `q⁻¹(p) = (c, d)` gives
`p = p_{T₀}(p) = q(c, 0)`), and `|q(a, b) − q(c, 0)| = |(a − c, b)| ≥ |b|`, with equality at
`c = a`. -/
theorem tdo_gpd_infDist_rotatedPlane_graphPoint : ∀ (n ℓ : ℕ) (q : Amb n ℓ ≃ₗᵢ[ℝ] Amb n ℓ) (a : Rn n) (b : Rn ℓ), infDist (q (graphPoint a b)) (rotatedPlane q : Set (Amb n ℓ)) = ‖b‖ := by
  intro n ℓ q a b
  obtain ⟨hsub, hnorm, hsurj, hproj⟩ := lip_approx_graph_coordinates n ℓ q
  -- `|b| ≤ |(c, b)|` and `|(0, b)| = |b|`
  have hge : ∀ (c : Rn n) (d : Rn ℓ), ‖d‖ ≤ ‖graphPoint c d‖ := by
    intro c d
    have h := hnorm c d
    have h0 : 0 ≤ ‖graphPoint c d‖ := norm_nonneg _
    nlinarith [sq_nonneg ‖c‖, norm_nonneg d]
  have hzero : ∀ d : Rn ℓ, ‖graphPoint (0 : Rn n) d‖ = ‖d‖ := by
    intro d
    have h := hnorm 0 d
    rw [norm_zero, zero_pow two_ne_zero, zero_add] at h
    exact (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp h
  -- every `q(c, 0)` lies in `T₀`
  have hmem : ∀ c : Rn n, q (graphPoint c 0) ∈ rotatedPlane q := by
    intro c
    rw [← hproj c 0]
    exact Submodule.starProjection_apply_mem _ _
  -- every point of `T₀` is some `q(c, 0)`
  have hform : ∀ p ∈ rotatedPlane q, ∃ c : Rn n, p = q (graphPoint c 0) := by
    intro p hp
    obtain ⟨c, d, hcd⟩ := hsurj (q.symm p)
    have hp' : p = q (graphPoint c d) := by
      rw [← hcd]
      simp
    refine ⟨c, ?_⟩
    have h := hproj c d
    rw [← hp', Submodule.starProjection_eq_self_iff.mpr hp] at h
    exact h
  apply le_antisymm
  -- upper bound: compare with `q(a, 0) ∈ T₀`
  · calc infDist (q (graphPoint a b)) (rotatedPlane q : Set (Amb n ℓ))
        ≤ dist (q (graphPoint a b)) (q (graphPoint a 0)) := infDist_le_dist_of_mem (hmem a)
      _ = ‖b‖ := by
        rw [dist_eq_norm, ← map_sub, LinearIsometryEquiv.norm_map, hsub, sub_self, sub_zero,
          hzero]
  -- lower bound: `|q(a, b) − q(c, 0)| = |(a − c, b)| ≥ |b|` for every `q(c, 0) ∈ T₀`
  · rw [le_infDist ⟨0, (rotatedPlane q).zero_mem⟩]
    intro p hp
    obtain ⟨c, rfl⟩ := hform p hp
    rw [dist_eq_norm, ← map_sub, LinearIsometryEquiv.norm_map, hsub, sub_zero]
    exact hge _ _

/-- Simon Ch. 5, proof of Theorem 4.5 (p. 120): the `n`-dimensional subspace `S`, the graph of the
linear part of the affine `λ`, in rotated coordinates.  For a linear isometry `q` of `ℝ^{n+ℓ}` and a
linear `A : ℝⁿ → ℝ^ℓ` let `S = span{q(v, A v) : v ∈ ℝⁿ}` and `T₀ = q(ℝⁿ × {0})`.  Then
(i) `dim S = n`; (ii) `dist(x, S) ≤ dist(x, T₀) + |A| |x|`;
(iii) `dist(q(x', y) − q(0, c), S) ≤ |y − (c + A x')|`
(the book's `dist(x, ξ + S) ≤ |f(x') − λ(x')|` for `x = (x', f(x'))`, `ξ = (0, λ(0))`);
(iv) `|x'| ≤ |q(x', y) − q(0, c)|`; (v) `|q(0, c)| = |c|`.
(i) is `tdo_gpd_graph_plane_finrank`.  The points `Φ(v) = q(v, A v)` lie in `S`, `q` is a linear
isometry, and `(a, b) − (a', b') = (a − a', b − b')`, `|(a, b)|² = |a|² + |b|²`
(`lip_approx_graph_coordinates`).  Hence `q(x', y) − q(0, c) = q(x', y − c)`, which gives (iv) and
(v), and its difference with `Φ(x')` is `q(0, y − (c + A x'))`, which gives (iii).  For (ii) write
`x = q(a, b)`: then `dist(x, T₀) = |b|` (`tdo_gpd_infDist_rotatedPlane_graphPoint`) and
`dist(x, S) ≤ |x − Φ(a)| = |b − A a| ≤ |b| + |A| |a| ≤ |b| + |A| |x|`, by `|A a| ≤ |A| |a|`
(Cauchy–Schwarz, `lgc_hsNormSq_bounds`) and `|a| ≤ |(a, b)| = |x|`. -/
theorem tdo_graph_plane_dist : ∀ (n ℓ : ℕ) (q : Amb n ℓ ≃ₗᵢ[ℝ] Amb n ℓ) (A : Rn n →L[ℝ] Rn ℓ), Module.finrank ℝ (Submodule.span ℝ (Set.range fun v : Rn n => q (graphPoint v (A v)))) = n ∧ (∀ x : Amb n ℓ, infDist x (Submodule.span ℝ (Set.range fun v : Rn n => q (graphPoint v (A v))) : Set (Amb n ℓ)) ≤ infDist x (rotatedPlane q : Set (Amb n ℓ)) + hsNorm A * ‖x‖) ∧ (∀ (x' : Rn n) (y c : Rn ℓ), infDist (q (graphPoint x' y) - q (graphPoint (0 : Rn n) c)) (Submodule.span ℝ (Set.range fun v : Rn n => q (graphPoint v (A v))) : Set (Amb n ℓ)) ≤ ‖y - (c + A x')‖) ∧ (∀ (x' : Rn n) (y c : Rn ℓ), ‖x'‖ ≤ ‖q (graphPoint x' y) - q (graphPoint (0 : Rn n) c)‖) ∧ ∀ c : Rn ℓ, ‖q (graphPoint (0 : Rn n) c)‖ = ‖c‖ := by
  intro n ℓ q A
  obtain ⟨hsub, hnorm, hsurj, -⟩ := lip_approx_graph_coordinates n ℓ q
  set S := Submodule.span ℝ (Set.range fun v : Rn n => q (graphPoint v (A v)))
  -- `‖a‖ ≤ ‖(a, b)‖` and `‖(0, b)‖ = ‖b‖`
  have hle : ∀ (a : Rn n) (b : Rn ℓ), ‖a‖ ≤ ‖graphPoint a b‖ := by
    intro a b
    refine (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mp ?_
    rw [hnorm]
    exact le_add_of_nonneg_right (sq_nonneg _)
  have hzero : ∀ b : Rn ℓ, ‖graphPoint (0 : Rn n) b‖ = ‖b‖ := by
    intro b
    refine (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp ?_
    rw [hnorm, norm_zero, zero_pow two_ne_zero, zero_add]
  -- `‖A a‖ ≤ |A| ‖a‖`, the square root of `‖A a‖² ≤ |A|² ‖a‖²`
  have hA : ∀ a : Rn n, ‖A a‖ ≤ hsNorm A * ‖a‖ := by
    intro a
    obtain ⟨h0, -, hAa⟩ := (lgc_hsNormSq_bounds n ℓ).2 A
    calc ‖A a‖ = Real.sqrt (‖A a‖ ^ 2) := (Real.sqrt_sq (norm_nonneg _)).symm
      _ ≤ Real.sqrt (hsNormSq A * ‖a‖ ^ 2) := Real.sqrt_le_sqrt (hAa a)
      _ = hsNorm A * ‖a‖ := by rw [Real.sqrt_mul h0, Real.sqrt_sq (norm_nonneg _), hsNorm]
  -- the points `Φ(v) = q(v, A v)` of `S`, and `q(x', y) - q(0, c) = q(x', y - c)`
  have hmem : ∀ v : Rn n, q (graphPoint v (A v)) ∈ S := fun v => Submodule.subset_span ⟨v, rfl⟩
  have hdiff : ∀ (x' : Rn n) (y c : Rn ℓ),
      q (graphPoint x' y) - q (graphPoint (0 : Rn n) c) = q (graphPoint x' (y - c)) := by
    intro x' y c
    rw [← map_sub, hsub, sub_zero]
  refine ⟨Submission.tdo_gpd_graph_plane_finrank n ℓ q A, fun x => ?_, fun x' y c => ?_,
    fun x' y c => ?_, fun c => ?_⟩
  -- (ii): write `x = q(a, b)`; then `dist(x, T₀) = ‖b‖` and `dist(x, S) ≤ ‖x - Φ(a)‖`
  · obtain ⟨a, b, hab⟩ := hsurj (q.symm x)
    obtain rfl : x = q (graphPoint a b) := by rw [← hab, LinearIsometryEquiv.apply_symm_apply]
    rw [Submission.tdo_gpd_infDist_rotatedPlane_graphPoint n ℓ q a b,
      LinearIsometryEquiv.norm_map]
    calc infDist (q (graphPoint a b)) (S : Set (Amb n ℓ))
        ≤ dist (q (graphPoint a b)) (q (graphPoint a (A a))) := infDist_le_dist_of_mem (hmem a)
      _ = ‖b - A a‖ := by
        rw [dist_eq_norm, ← map_sub, LinearIsometryEquiv.norm_map, hsub, sub_self, hzero]
      _ ≤ ‖b‖ + ‖A a‖ := norm_sub_le _ _
      _ ≤ ‖b‖ + hsNorm A * ‖graphPoint a b‖ := by
        gcongr
        exact (hA a).trans (mul_le_mul_of_nonneg_left (hle a b) (Real.sqrt_nonneg _))
  -- (iii): compare with `Φ(x') ∈ S`
  · calc infDist (q (graphPoint x' y) - q (graphPoint (0 : Rn n) c)) (S : Set (Amb n ℓ))
        ≤ dist (q (graphPoint x' y) - q (graphPoint (0 : Rn n) c)) (q (graphPoint x' (A x'))) :=
          infDist_le_dist_of_mem (hmem x')
      _ = ‖y - (c + A x')‖ := by
        rw [hdiff, dist_eq_norm, ← map_sub, LinearIsometryEquiv.norm_map, hsub, sub_self, hzero,
          sub_sub]
  -- (iv)
  · rw [hdiff, LinearIsometryEquiv.norm_map]
    exact hle x' (y - c)
  -- (v)
  · rw [LinearIsometryEquiv.norm_map, hzero]

/-- Sup bound for the height of `spt V` over a graph plane, from a sup bound for the graph and a
lower density bound (a step of the proof of Simon Ch. 5, Theorem 4.5, p. 116; the missing-ball
argument is the one in the proofs of Lemma 2.6 and Corollary 2.7, pp. 112–113).  Let
`τ = q(0, c)`, `S = q(graph A)`, `λ(x') = c + A x'`, `Γ = q(graph f|B̄ⁿ_R(0))`, and let `b ≥ 0`,
`κ > 0`, `r + s₀ ≤ a`, `|c| + r + s₀ ≤ R`.  If `|f − λ| ≤ b` on `B̄ⁿ_a(0)`,
`μ_V(B̄_R(0) ∩ (spt V \ Γ)) ≤ β`, and `μ_V(B̄_s(x)) ≥ κ s` and `dist(x − τ, S) ≤ 2 s₀` for all
`x ∈ spt V ∩ B̄_r(τ)` and `s ∈ (0, s₀]`, then `dist(x − τ, S) ≤ max{2b, 2β/κ}` on `spt V ∩ B̄_r(τ)`.
Since `spt V` is `μ_V`-conull, it suffices that if `h = dist(x − τ, S) > 2b`, then the ball
`B̄_{h/2}(x)` lies in `B̄_R(0)` and misses `Γ`.  A point `y = q(y', f y')` of `Γ` in that ball has
`|y'| ≤ |y − τ| ≤ s₀ + r ≤ a`, hence `dist(y − τ, S) ≤ |f y' − λ(y')| ≤ b < h/2`.  This contradicts
`h ≤ dist(y − τ, S) + |x − y|`.  So `κ h/2 ≤ μ_V(B̄_{h/2}(x)) ≤ β`. -/
theorem tdo_graph_height_sup : ∀ (n ℓ : ℕ) (U : Set (Amb n ℓ)) (V : RectifiableVarifold n ℓ U) (q : Amb n ℓ ≃ₗᵢ[ℝ] Amb n ℓ) (f : Rn n → Rn ℓ) (c : Rn ℓ) (A : Rn n →L[ℝ] Rn ℓ) (R a r s₀ b β κ : ℝ), 0 ≤ b → 0 < κ → r + s₀ ≤ a → ‖c‖ + r + s₀ ≤ R → (∀ x' ∈ closedBall (0 : Rn n) a, ‖f x' - (c + A x')‖ ≤ b) → V.weight (closedBall 0 R ∩ (V.support \ q '' graphOver f (closedBall 0 R))) ≤ ENNReal.ofReal β → (∀ x ∈ V.support ∩ closedBall (q (graphPoint (0 : Rn n) c)) r, ∀ s : ℝ, 0 < s → s ≤ s₀ → ENNReal.ofReal (κ * s) ≤ V.weight (closedBall x s)) → (∀ x ∈ V.support ∩ closedBall (q (graphPoint (0 : Rn n) c)) r, infDist (x - q (graphPoint (0 : Rn n) c)) (Submodule.span ℝ (Set.range fun v : Rn n => q (graphPoint v (A v))) : Set (Amb n ℓ)) ≤ 2 * s₀) → ∀ x ∈ V.support ∩ closedBall (q (graphPoint (0 : Rn n) c)) r, infDist (x - q (graphPoint (0 : Rn n) c)) (Submodule.span ℝ (Set.range fun v : Rn n => q (graphPoint v (A v))) : Set (Amb n ℓ)) ≤ max (2 * b) (2 * β / κ) := by
  intro n ℓ U V q f c A R a r s₀ b β κ hb hκ hra hR hf hβ hdens hh x hx
  -- (iii) `dist(q(x', y) − τ, S) ≤ |y − λ(x')|`, (iv) `|x'| ≤ |q(x', y) − τ|` and (v) `|τ| = |c|`
  -- from the graph-plane distance estimates, at our `c`
  obtain ⟨-, -, hiii, hiv, hv⟩ := Submission.tdo_graph_plane_dist n ℓ q A
  have hiii := fun x' y => hiii x' y c
  have hiv := fun x' y => hiv x' y c
  have hv := hv c
  set τ := q (graphPoint (0 : Rn n) c)
  set S : Set (Amb n ℓ) :=
    (Submodule.span ℝ (Set.range fun v : Rn n => q (graphPoint v (A v))) : Set (Amb n ℓ))
  set Γ := q '' graphOver f (closedBall (0 : Rn n) R)
  -- Step 1: `μ_V` is carried by `M ⊆ U` and by `spt μ_V`, so `μ_V((spt V)ᶜ) = 0`
  have hnull : V.weight V.supportᶜ = 0 := by
    have hM : (μHE[n] : Measure (Amb n ℓ)).restrict V.carrier V.carrierᶜ = 0 :=
      ae_iff.1 (ae_restrict_mem₀ V.nullMeasurableSet_carrier)
    have hU : V.weight Uᶜ = 0 := withDensity_absolutelyContinuous _ _
      (measure_mono_null (compl_subset_compl.2 V.carrier_subset) hM)
    rw [RectifiableVarifold.support, compl_inter]
    exact measure_union_null hU Measure.measure_compl_support
  -- Step 2: we may assume `h = dist(x − τ, S) > 2b`; then `h/2 ∈ (b, s₀]`
  rcases le_or_gt (infDist (x - τ) S) (2 * b) with hle | hgt
  · exact le_max_of_le_left hle
  set h := infDist (x - τ) S
  have hh2 : h ≤ 2 * s₀ := hh x hx
  have hs : 0 < h / 2 := by linarith
  have hss₀ : h / 2 ≤ s₀ := by linarith
  have hbs : b < h / 2 := by linarith
  have hxτ : dist x τ ≤ r := mem_closedBall.1 hx.2
  -- Steps 3–5: `B̄_{h/2}(x) ⊆ B̄_R(0) \ Γ` (step 3, `x ∉ Γ`, is the case `z = x`)
  have hball : closedBall x (h / 2) ⊆ closedBall 0 R \ Γ := by
    intro z hz
    rw [mem_closedBall] at hz
    refine ⟨?_, ?_⟩
    · -- `|z| ≤ |z − x| + |x − τ| + |τ| ≤ s₀ + r + |c| ≤ R`
      have h4 := dist_triangle4 z x τ 0
      rw [dist_zero_right τ, hv] at h4
      rw [mem_closedBall]
      linarith
    · -- a point `y = q(y', f y')` of `Γ` in the ball would have `dist(y − τ, S) ≤ b < h/2`, while
      -- `dist(· − τ, S)` is `1`-Lipschitz and `|x − y| ≤ h/2`
      rintro ⟨w, ⟨y', -, rfl⟩, rfl⟩
      have hy' : ‖y'‖ ≤ a := by
        have h1 := hiv y' (f y')
        rw [← dist_eq_norm] at h1
        linarith [dist_triangle (q (graphPoint y' (f y'))) x τ]
      have hL : h ≤ infDist (q (graphPoint y' (f y')) - τ) S +
          dist (x - τ) (q (graphPoint y' (f y')) - τ) := infDist_le_infDist_add_dist
      rw [dist_sub_right, dist_comm] at hL
      linarith [hiii y' (f y'), hf y' (mem_closedBall_zero_iff.2 hy')]
  -- Step 6: `κ h/2 ≤ μ_V(B̄_{h/2}(x)) ≤ μ_V(B̄_R(0) ∩ (spt V \ Γ)) ≤ β`
  have hmass : ENNReal.ofReal (κ * (h / 2)) ≤ ENNReal.ofReal β :=
    calc ENNReal.ofReal (κ * (h / 2)) ≤ V.weight (closedBall x (h / 2)) := hdens x hx _ hs hss₀
      _ = V.weight (closedBall x (h / 2) ∩ V.support) := (measure_inter_conull hnull).symm
      _ ≤ V.weight (closedBall 0 R ∩ (V.support \ Γ)) :=
          measure_mono fun z hz => ⟨(hball hz.1).1, hz.2, (hball hz.1).2⟩
      _ ≤ ENNReal.ofReal β := hβ
  have hκβ : κ * (h / 2) ≤ β :=
    (ENNReal.ofReal_le_ofReal_iff'.1 hmass).resolve_right (not_le.2 (mul_pos hκ hs))
  refine le_max_of_le_right ((le_div_iff₀ hκ).2 ?_)
  linarith

/-- Simon Ch. 5, proof of Theorem 5.2, (10)–(11): for `f` `1`-Lipschitz on `D ⊆ ℝⁿ` and a linear
isometry `q` of `ℝ^{n+ℓ}`, the graph map `F(x) = q(x, f(x))` is `√2`-Lipschitz on `D`, and
`|F(x)| ≤ √2 |x|` on `D` when `f(0) = 0` and `0 ∈ D`. By the graph coordinates
(`lip_approx_graph_coordinates` (i), (ii)) and since `q` is a linear isometry,
`|F(x) − F(x')|² = |x − x'|² + |f(x) − f(x')|² ≤ 2 |x − x'|²`; and `F(0) = q(0, 0) = 0`. -/
theorem allard52_cft_graph_map_sqrt_two : ∀ (n ℓ : ℕ) (q : Amb n ℓ ≃ₗᵢ[ℝ] Amb n ℓ) (f : Rn n → Rn ℓ) (D : Set (Rn n)), LipschitzOnWith 1 f D → (∀ x ∈ D, ∀ x' ∈ D, ‖q (graphPoint x (f x)) - q (graphPoint x' (f x'))‖ ≤ Real.sqrt 2 * ‖x - x'‖) ∧ (f 0 = 0 → (0 : Rn n) ∈ D → ∀ x ∈ D, ‖q (graphPoint x (f x))‖ ≤ Real.sqrt 2 * ‖x‖) := by
  intro n ℓ q f D hf
  obtain ⟨hsub, hnorm, -, -⟩ := lip_approx_graph_coordinates n ℓ q
  have hlip : ∀ x ∈ D, ∀ x' ∈ D,
      ‖q (graphPoint x (f x)) - q (graphPoint x' (f x'))‖ ≤ Real.sqrt 2 * ‖x - x'‖ := by
    intro x hx x' hx'
    -- `|f(x) − f(x')| ≤ |x − x'|`
    have hf' : ‖f x - f x'‖ ≤ ‖x - x'‖ := by
      have h := hf.dist_le_mul x hx x' hx'
      rwa [NNReal.coe_one, one_mul, dist_eq_norm, dist_eq_norm] at h
    -- `|F(x) − F(x')| = |(x − x', f(x) − f(x'))|`, whose square is at most `2 |x − x'|²`
    rw [← map_sub, q.norm_map, hsub]
    have hsq : ‖graphPoint (x - x') (f x - f x')‖ ^ 2 ≤ (Real.sqrt 2 * ‖x - x'‖) ^ 2 := by
      rw [hnorm, mul_pow, Real.sq_sqrt zero_le_two, two_mul]
      exact add_le_add le_rfl (pow_le_pow_left₀ (norm_nonneg _) hf' 2)
    exact (pow_le_pow_iff_left₀ (norm_nonneg _)
      (mul_nonneg (Real.sqrt_nonneg _) (norm_nonneg _)) two_ne_zero).mp hsq
  refine ⟨hlip, fun hf0 h0 x hx => ?_⟩
  -- `(0, 0) = (0, 0) − (0, 0) = 0`, so `F(0) = 0`; compare `F(x)` with `F(0)`
  have hzero : graphPoint (0 : Rn n) (0 : Rn ℓ) = 0 := by
    have h := hsub 0 0 0 0
    rw [sub_self, sub_self, sub_self] at h
    exact h.symm
  have h := hlip x hx 0 h0
  rwa [hf0, hzero, map_zero, sub_zero, sub_zero] at h

/-- Simon Ch. 5, proof of Theorem 4.5 (pp. 116–120), integrals over a Lipschitz image: if
`F : ℝⁿ → ℝ^N` is `K`-Lipschitz on the measurable set `D`, then for measurable `g ≥ 0`
`∫_{F(D)} g dHⁿ ≤ Kⁿ ∫_D g(F(x')) dx'`.  For `E ⊆ D` the image bound gives
`Hⁿ(F(E)) ≤ Kⁿ Hⁿ(E) = Kⁿ Lⁿ(E)`.  With `ν = F_#(Lⁿ ⌞ D)` (`F` is continuous on `D`, hence
a.e. measurable for `Lⁿ ⌞ D`) and `B ∩ F(D) = F(F⁻¹(B) ∩ D)`, this gives
`(Hⁿ ⌞ F(D))(B) ≤ Kⁿ ν(B)` for measurable `B`, i.e. `Hⁿ ⌞ F(D) ≤ Kⁿ ν`; integrate `g` and
change variables. -/
theorem tdo_gl_lintegral_image_le : ∀ (n N : ℕ) (F : Rn n → EuclideanSpace ℝ (Fin N)) (D : Set (Rn n)) (K : ℝ≥0), MeasurableSet D → LipschitzOnWith K F D → ∀ g : EuclideanSpace ℝ (Fin N) → ℝ≥0∞, Measurable g → ∫⁻ x in F '' D, g x ∂(μHE[n] : Measure (EuclideanSpace ℝ (Fin N))) ≤ (K : ℝ≥0∞) ^ n * ∫⁻ x' in D, g (F x') := by
  intro n N F D K hD hF g hg
  -- `F` is continuous on the measurable set `D`, hence a.e. measurable for `Lⁿ ⌞ D`
  have hFm : AEMeasurable F ((volume : Measure (Rn n)).restrict D) :=
    hF.continuousOn.aemeasurable hD
  -- `Hⁿ ⌞ F(D) ≤ Kⁿ F_#(Lⁿ ⌞ D)`, tested on measurable `B` via `B ∩ F(D) = F(F⁻¹(B) ∩ D)`
  have hle : (μHE[n] : Measure (EuclideanSpace ℝ (Fin N))).restrict (F '' D) ≤
      ((K : ℝ≥0∞) ^ n) • Measure.map F ((volume : Measure (Rn n)).restrict D) := by
    refine Measure.le_iff.2 fun B hB => ?_
    rw [Measure.restrict_apply hB, Measure.smul_apply, Measure.map_apply_of_aemeasurable hFm hB,
      Measure.restrict_apply' hD, smul_eq_mul]
    have hset : B ∩ F '' D = F '' (F ⁻¹' B ∩ D) := by
      ext y
      constructor
      · rintro ⟨hyB, x, hxD, rfl⟩
        exact ⟨x, ⟨hyB, hxD⟩, rfl⟩
      · rintro ⟨x, ⟨hxB, hxD⟩, rfl⟩
        exact ⟨hxB, x, hxD, rfl⟩
    rw [hset, ← EuclideanSpace.euclideanHausdorffMeasure_eq_volume n]
    exact Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
      (hF.mono Set.inter_subset_right)
  calc ∫⁻ x in F '' D, g x ∂(μHE[n] : Measure (EuclideanSpace ℝ (Fin N)))
      ≤ ∫⁻ x, g x ∂(((K : ℝ≥0∞) ^ n) • Measure.map F ((volume : Measure (Rn n)).restrict D)) :=
        lintegral_mono' hle le_rfl
    _ = (K : ℝ≥0∞) ^ n * ∫⁻ x, g x ∂(Measure.map F ((volume : Measure (Rn n)).restrict D)) := by
        rw [lintegral_smul_measure, smul_eq_mul]
    _ = (K : ℝ≥0∞) ^ n * ∫⁻ x' in D, g (F x') := by
        rw [lintegral_map' hg.aemeasurable hFm]

/-- **Simon Ch. 5, proof of Theorem 4.5, display (14) on p. 119** (the area-formula step, Ch. 2,
3.5, with `JF ≤ (1 + L²)^{n/2}`).  Let `q` be a linear isometry of `ℝ^{n+ℓ}`, `D ⊆ ℝⁿ` measurable
and `f` `L`-Lipschitz on `D`, and put `F x' = q (x', f x')`.  Then for every measurable `g ≥ 0`,
`∫_{q(graph f|D)} g dHⁿ ≤ √(1 + L²)ⁿ ∫_D g ∘ F dLⁿ`.  Indeed `q(graph f|D) = F(D)`, `F` is
`√(1 + L²)`-Lipschitz on `D`, and the Lipschitz image bound for `Hⁿ`-integrals applies with
`K = √(1 + L²)`. -/
theorem tdo_graph_lintegral_le : ∀ (n ℓ : ℕ) (q : Amb n ℓ ≃ₗᵢ[ℝ] Amb n ℓ) (f : Rn n → Rn ℓ) (D : Set (Rn n)) (L : ℝ≥0), MeasurableSet D → LipschitzOnWith L f D → ∀ g : Amb n ℓ → ℝ≥0∞, Measurable g → ∫⁻ x in q '' graphOver f D, g x ∂(μHE[n] : Measure (Amb n ℓ)) ≤ ENNReal.ofReal (Real.sqrt (1 + (L : ℝ) ^ 2) ^ n) * ∫⁻ x' in D, g (q (graphPoint x' (f x'))) := by
  intro n ℓ q f D L hD hf g hg
  -- Step (i): `q(graph f|D) = F(D)` for the rotated graph map `F x' = q (x', f x')`.
  have hΓ : q '' graphOver f D = (fun x' => q (graphPoint x' (f x'))) '' D := by
    rw [graphOver, Set.image_image]
  -- Step (ii): `F` is `√(1 + L²)`-Lipschitz on `D`.
  have hF := Submission.tdo_gl_graph_map_lipschitzOn n ℓ q f D L hf
  -- Step (iv): the constant `√(1 + L²)ⁿ`, as the `n`-th power of `K = √(1 + L²) ∈ ℝ≥0`.
  have hK : ENNReal.ofReal (Real.sqrt (1 + (L : ℝ) ^ 2) ^ n) =
      ((NNReal.sqrt (1 + L ^ 2) : ℝ≥0) : ℝ≥0∞) ^ n := by
    rw [ENNReal.ofReal_pow (Real.sqrt_nonneg _), ← ENNReal.ofReal_coe_nnreal, Real.coe_sqrt,
      NNReal.coe_add, NNReal.coe_one, NNReal.coe_pow]
  rw [hΓ, hK]
  -- Step (iii): the Lipschitz image bound with `N = n + ℓ` and `K = √(1 + L²)`.
  exact Submission.tdo_gl_lintegral_image_le n (n + ℓ) _ D _ hD hF g hg

/-- Integrals over the open ball `B̆_a(0)` of `ℝ¹` are integrals over the interval `(-a, a)`, for
every function `φ` and every radius `a` (no integrability hypothesis).  The coordinate map
`e := toLp 2 ∘ (funUnique (Fin 1) ℝ).symm : ℝ ≃ᵐ ℝ¹` sends `t` to `EuclideanSpace.single 0 t` and is
volume preserving (`volume_preserving_funUnique`, `PiLp.volume_preserving_toLp`), so
`MeasurePreserving.setIntegral_preimage_emb` transfers the integral; the preimage of the ball is
`{t | |t| < a} = Ioo (-a) a` since `‖single 0 t‖ = |t|` (`PiLp.norm_single`). -/
theorem tdo_ods_ball_integral_eq_interval : ∀ (φ : Rn 1 → ℝ) (a : ℝ),
    (∫ y in ball (0 : Rn 1) a, φ y) =
      ∫ t in Ioo (-a) a, φ (EuclideanSpace.single (0 : Fin 1) t) := by
  intro φ a
  set e : ℝ ≃ᵐ Rn 1 :=
    (MeasurableEquiv.funUnique (Fin 1) ℝ).symm.trans (MeasurableEquiv.toLp 2 (Fin 1 → ℝ))
  have he : ∀ t, e t = EuclideanSpace.single (0 : Fin 1) t := by
    intro t
    ext i
    fin_cases i
    simp [e]
  have hmp : MeasurePreserving e volume volume :=
    (PiLp.volume_preserving_toLp (Fin 1)).comp (volume_preserving_funUnique (Fin 1) ℝ).symm
  have hpre : e ⁻¹' ball (0 : Rn 1) a = Ioo (-a) a := by
    ext t
    simp [he, abs_lt]
  rw [← hmp.setIntegral_preimage_emb e.measurableEmbedding φ (ball 0 a), hpre]
  simp_rw [he]

/-- On `ℝ¹` the squared Hilbert–Schmidt norm of `Dw` at `single 0 t` is the squared norm of the
derivative of `s ↦ w (single 0 s)` at `t`, for every map `w` (Mathlib's `fderiv`/`deriv` vanish at
points of non-differentiability).  `hsNormSq B = ‖B e‖²` with `e := single 0 1` (`Fin 1` is a
singleton) and `single 0 s = s • e`.  If `w` is differentiable at `single 0 t`, the chain rule
(`HasFDerivAt.comp_hasDerivAt`) gives `deriv (w ∘ single 0) t = Dw(single 0 t) e`.  Otherwise
`w ∘ single 0` is not differentiable at `t` either, since `w = (w ∘ single 0) ∘ π` for the
coordinate projection `π := EuclideanSpace.proj 0`, so both sides vanish. -/
theorem tdo_ods_hsNormSq_fderiv_single : ∀ (ℓ : ℕ) (w : Rn 1 → Rn ℓ) (t : ℝ),
    hsNormSq (fderiv ℝ w (EuclideanSpace.single (0 : Fin 1) t)) =
      ‖deriv (fun s : ℝ => w (EuclideanSpace.single (0 : Fin 1) s)) t‖ ^ 2 := by
  intro ℓ w t
  set e : Rn 1 := EuclideanSpace.single (0 : Fin 1) (1 : ℝ)
  have hsing : ∀ s : ℝ, EuclideanSpace.single (0 : Fin 1) s = s • e := by
    intro s
    ext i
    fin_cases i
    simp [e]
  have hLHS : hsNormSq (fderiv ℝ w (EuclideanSpace.single (0 : Fin 1) t)) =
      ‖fderiv ℝ w (EuclideanSpace.single (0 : Fin 1) t) e‖ ^ 2 := by
    simp [hsNormSq, e]
  rw [hLHS]
  by_cases hw : DifferentiableAt ℝ w (EuclideanSpace.single (0 : Fin 1) t)
  · have hι : HasDerivAt (fun s : ℝ => EuclideanSpace.single (0 : Fin 1) s) e t := by
      simpa [hsing] using (hasDerivAt_id t).smul_const e
    have hW : HasDerivAt (fun s : ℝ => w (EuclideanSpace.single (0 : Fin 1) s))
        (fderiv ℝ w (EuclideanSpace.single (0 : Fin 1) t) e) t :=
      hw.hasFDerivAt.comp_hasDerivAt t hι
    rw [hW.deriv]
  · have hW : ¬ DifferentiableAt ℝ (fun s : ℝ => w (EuclideanSpace.single (0 : Fin 1) s)) t := by
      intro hW
      apply hw
      set π : Rn 1 →L[ℝ] ℝ := EuclideanSpace.proj (0 : Fin 1)
      have hπt : π (EuclideanSpace.single (0 : Fin 1) t) = t := by simp [π]
      have hcomp := DifferentiableAt.comp (EuclideanSpace.single (0 : Fin 1) t)
        (by rw [hπt]; exact hW) π.differentiableAt
      have hw_eq : ((fun s : ℝ => w (EuclideanSpace.single (0 : Fin 1) s)) ∘ π) = w := by
        funext z
        simp only [Function.comp_apply]
        congr 1
        ext i
        fin_cases i
        simp [π]
      rwa [hw_eq] at hcomp
    rw [fderiv_zero_of_not_differentiableAt hw, deriv_zero_of_not_differentiableAt hW]
    simp

/-- **Integrability of `‖W'‖` for a Lipschitz curve.**  If `W : ℝ → ℝ^ℓ` is `K`-Lipschitz on
`[-a, a]`, then `r ↦ ‖deriv W r‖` is integrable on `(-a, a)`: it is measurable
(`measurable_deriv`), bounded by `K` on `(-a, a)` because `[-a, a]` is a neighbourhood of each
point there (`norm_deriv_le_of_lipschitzOn`), and `(-a, a)` has finite measure. -/
theorem Submission.tdo_ods_integrableOn_norm_deriv : ∀ (ℓ : ℕ) (W : ℝ → Rn ℓ) (a : ℝ) (K : ℝ≥0), LipschitzOnWith K W (Icc (-a) a) → IntegrableOn (fun r => ‖deriv W r‖) (Ioo (-a) a) := by
  intro ℓ W a K hW
  -- (1) measurability of `‖W'‖`, (4) finite measure of `(-a, a)`
  refine Measure.integrableOn_of_bounded (M := K) measure_Ioo_lt_top.ne
    (measurable_deriv W).norm.aestronglyMeasurable ?_
  -- (3) the a.e. bound on `(-a, a)` follows from the pointwise one
  rw [ae_restrict_iff' measurableSet_Ioo]
  refine Filter.Eventually.of_forall fun r hr => ?_
  -- (2) `[-a, a]` is a neighbourhood of `r ∈ (-a, a)`, so `‖W'(r)‖ ≤ K`
  rw [norm_norm]
  exact norm_deriv_le_of_lipschitzOn (Icc_mem_nhds hr.1 hr.2) hW

/-- A.e. derivative comparison for the one-dimensional sup bound in the tilt-excess decay
(Simon Ch. 5, Theorem 4.5): if `W : ℝ → ℝ^ℓ` is `K`-Lipschitz on `[-a, a]` and `‖u‖ ≤ 1`, then
`|(d/dr)⟨u, W(r)⟩| ≤ ‖W'(r)‖` for a.e. `r ∈ (-a, a)`.  By Rademacher's theorem `W` is
differentiable within `[-a, a]` at a.e. point of `[-a, a]`, hence differentiable at a.e.
`r ∈ (-a, a)`, where `[-a, a]` is a neighbourhood of `r`; there `x ↦ ⟨u, W x⟩` has derivative
`⟨u, W'(r)⟩`, and Cauchy–Schwarz with `‖u‖ ≤ 1` gives the bound. -/
theorem tdo_ods_ae_abs_deriv_inner_le : ∀ (ℓ : ℕ) (W : ℝ → Rn ℓ) (a : ℝ) (K : ℝ≥0) (u : Rn ℓ), LipschitzOnWith K W (Icc (-a) a) → ‖u‖ ≤ 1 → ∀ᵐ r ∂(volume : Measure ℝ), r ∈ Ioo (-a) a → |deriv (fun x => inner ℝ u (W x)) r| ≤ ‖deriv W r‖ := by
  intro ℓ W a K u hW hu
  -- Step 1 (Rademacher): for a.e. `r ∈ [-a, a]`, `W` is differentiable within `[-a, a]` at `r`.
  filter_upwards [hW.ae_differentiableWithinAt_of_mem (μ := volume)] with r hr hrI
  -- Step 2: for `r ∈ (-a, a)`, `[-a, a]` is a neighbourhood of `r`, so `W` is differentiable at `r`.
  have hWr : DifferentiableAt ℝ W r :=
    (hr (Ioo_subset_Icc_self hrI)).differentiableAt (Icc_mem_nhds hrI.1 hrI.2)
  -- Step 3: `x ↦ ⟨u, W x⟩` has derivative `⟨u, W'(r)⟩ + ⟨0, W r⟩ = ⟨u, W'(r)⟩` at `r`.
  have hd : HasDerivAt (fun x => inner ℝ u (W x)) (inner ℝ u (deriv W r)) r := by
    simpa using (hasDerivAt_const r u).inner ℝ hWr.hasDerivAt
  rw [hd.deriv]
  -- Step 4: Cauchy–Schwarz and `‖u‖ ≤ 1`.
  calc |inner ℝ u (deriv W r)| ≤ ‖u‖ * ‖deriv W r‖ := abs_real_inner_le_norm u (deriv W r)
    _ ≤ 1 * ‖deriv W r‖ := mul_le_mul_of_nonneg_right hu (norm_nonneg _)
    _ = ‖deriv W r‖ := one_mul _

/-- Interval integral bounded by an a.e. dominating function, for the FTC bound in the
one-dimensional sup estimate of the tilt-excess decay (Simon Ch. 5, Theorem 4.5): if `h` is
integrable on `(-a, a)`, `s, t ∈ [-a, a]`, `g` is interval integrable between `s` and `t` and
`|g| ≤ h` a.e. on `(-a, a)`, then `∫_s^t g ≤ ∫_{(-a,a)} h`.  Since `uIoc s t ⊆ (-a, a]` and the
endpoint `a` is Lebesgue-null,
`∫_s^t g ≤ ‖∫_s^t g‖ ≤ ∫_{uIoc s t} ‖g‖ ≤ ∫_{uIoc s t} h ≤ ∫_{(-a,a]} h = ∫_{(-a,a)} h`,
where the fourth step uses `0 ≤ |g| ≤ h` a.e. on `(-a, a]`. -/
theorem tdo_ods_intervalIntegral_le_of_ae_abs_le : ∀ (g h : ℝ → ℝ) (a s t : ℝ), IntegrableOn h (Ioo (-a) a) → s ∈ Icc (-a) a → t ∈ Icc (-a) a → IntervalIntegrable g volume s t → (∀ᵐ r ∂(volume : Measure ℝ), r ∈ Ioo (-a) a → |g r| ≤ h r) → ∫ r in s..t, g r ≤ ∫ r in Ioo (-a) a, h r := by
  intro g h a s t hh hs ht hg hgh
  -- Step 1: `uIoc s t ⊆ (-a, a]`, since `s, t ∈ [-a, a]`.
  have hsub : uIoc s t ⊆ Ioc (-a) a := by
    intro r hr
    rcases mem_uIoc.1 hr with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact ⟨hs.1.trans_lt h1, h2.trans ht.2⟩
    · exact ⟨ht.1.trans_lt h1, h2.trans hs.2⟩
  -- Step 2: `h` is integrable on `(-a, a]` (the endpoint `a` is null and `h a` is finite),
  -- hence on `uIoc s t`.
  have hhIoc : IntegrableOn h (Ioc (-a) a) :=
    (integrableOn_Ioc_iff_integrableOn_Ioo enorm_ne_top).2 hh
  have hhI : IntegrableOn h (uIoc s t) := hhIoc.mono_set hsub
  -- Step 3: `‖g‖` is integrable on `uIoc s t`.
  have hgI : IntegrableOn (fun r => ‖g r‖) (uIoc s t) := (intervalIntegrable_iff.1 hg).norm
  -- Step 4: `|g| ≤ h` a.e. on `(-a, a]` (a.e. `r ≠ a`), hence `0 ≤ h` a.e. there.
  have hdom : ∀ᵐ r ∂(volume : Measure ℝ), r ∈ Ioc (-a) a → |g r| ≤ h r := by
    filter_upwards [hgh, Measure.ae_ne volume a] with r hr hra hrI
    exact hr ⟨hrI.1, lt_of_le_of_ne hrI.2 hra⟩
  have hnonneg : 0 ≤ᵐ[volume.restrict (Ioc (-a) a)] h := by
    rw [EventuallyLE, ae_restrict_iff' measurableSet_Ioc]
    filter_upwards [hdom] with r hr hrI
    exact (abs_nonneg _).trans (hr hrI)
  -- Step 5: the chain of inequalities.
  calc ∫ r in s..t, g r ≤ ‖∫ r in s..t, g r‖ := Real.le_norm_self _
    _ ≤ ∫ r in uIoc s t, ‖g r‖ := intervalIntegral.norm_integral_le_integral_norm_uIoc
    _ ≤ ∫ r in uIoc s t, h r := by
        refine setIntegral_mono_on_ae hgI hhI measurableSet_uIoc ?_
        filter_upwards [hdom] with r hr hrI
        rw [Real.norm_eq_abs]
        exact hr (hsub hrI)
    _ ≤ ∫ r in Ioc (-a) a, h r := setIntegral_mono_set hhIoc hnonneg (ae_of_all _ hsub)
    _ = ∫ r in Ioo (-a) a, h r := integral_Ioc_eq_integral_Ioo

/-- **FTC bound for a Lipschitz curve** (used for the one-dimensional sup bound in the proof of the
Tilt-excess Decay Theorem, Simon Ch. 5, 4.5).  If `W : ℝ → ℝ^ℓ` is `K`-Lipschitz on `[-a, a]`, then
`|W(t) - W(s)| ≤ ∫_{(-a,a)} |W'|` for all `s, t ∈ [-a, a]`.

Proof: if `W(t) = W(s)` the right side is the integral of a nonnegative function.  Otherwise put
`v = W(t) - W(s)` and `u = |v|⁻¹ v`, so `|u| = 1` and `⟨u, v⟩ = |v|`.  The scalar function
`φ = ⟨u, W⟩` is `K`-Lipschitz on `[-a, a] ⊇ uIcc s t`, hence absolutely continuous there, so
`|v| = φ(t) - φ(s) = ∫_s^t φ'` (`AbsolutelyContinuousOnInterval.integral_deriv_eq_sub`) and `φ'` is
interval integrable.  Since `|W'|` is integrable on `(-a, a)` (`tdo_ods_integrableOn_norm_deriv`)
and `|φ'| ≤ |W'|` a.e. on `(-a, a)` (`tdo_ods_ae_abs_deriv_inner_le`), the dominated interval
bound `tdo_ods_intervalIntegral_le_of_ae_abs_le` gives `∫_s^t φ' ≤ ∫_{(-a,a)} |W'|`. -/
theorem tdo_ods_norm_sub_le_integral_deriv : ∀ (ℓ : ℕ) (W : ℝ → Rn ℓ) (a : ℝ) (K : ℝ≥0), LipschitzOnWith K W (Icc (-a) a) → ∀ s ∈ Icc (-a) a, ∀ t ∈ Icc (-a) a, ‖W t - W s‖ ≤ ∫ r in Ioo (-a) a, ‖deriv W r‖ := by
  intro ℓ W a K hW s hs t ht
  -- The trivial case `W t = W s`: the integrand is nonnegative.
  by_cases hv : W t - W s = 0
  · rw [hv, norm_zero]
    exact integral_nonneg fun r => norm_nonneg _
  -- The unit vector `u = |v|⁻¹ v` for `v = W t - W s`.
  have hvn : ‖W t - W s‖ ≠ 0 := norm_ne_zero_iff.mpr hv
  set u : Rn ℓ := ‖W t - W s‖⁻¹ • (W t - W s) with hu_def
  have hu : ‖u‖ ≤ 1 := by
    have h1 : ‖u‖ = 1 := by rw [hu_def, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hvn]
    exact h1.le
  -- `φ = ⟨u, W⟩` is `K`-Lipschitz on `[-a, a]`, hence absolutely continuous on `uIcc s t`.
  set φ : ℝ → ℝ := fun x => inner ℝ u (W x) with hφ_def
  have hφ : LipschitzOnWith K φ (Icc (-a) a) := by
    refine LipschitzOnWith.of_dist_le_mul fun x hx y hy => ?_
    calc dist (φ x) (φ y) = |inner ℝ u (W x - W y)| := by
          rw [Real.dist_eq, inner_sub_right]
      _ ≤ ‖u‖ * ‖W x - W y‖ := abs_real_inner_le_norm _ _
      _ ≤ ‖W x - W y‖ := mul_le_of_le_one_left (norm_nonneg _) hu
      _ = dist (W x) (W y) := (dist_eq_norm _ _).symm
      _ ≤ K * dist x y := hW.dist_le_mul x hx y hy
  have hac := (hφ.mono (uIcc_subset_Icc hs ht)).absolutelyContinuousOnInterval
  -- `φ(t) - φ(s) = ⟨u, v⟩ = |v|`.
  have hφst : φ t - φ s = ‖W t - W s‖ := by
    show inner ℝ u (W t) - inner ℝ u (W s) = ‖W t - W s‖
    rw [← inner_sub_right, hu_def, real_inner_smul_left, real_inner_self_eq_norm_sq, sq,
      ← mul_assoc, inv_mul_cancel₀ hvn, one_mul]
  calc ‖W t - W s‖ = φ t - φ s := hφst.symm
    _ = ∫ r in s..t, deriv φ r := hac.integral_deriv_eq_sub.symm
    _ ≤ ∫ r in Ioo (-a) a, ‖deriv W r‖ :=
      Submission.tdo_ods_intervalIntegral_le_of_ae_abs_le (deriv φ) (fun r => ‖deriv W r‖) a s t
        (Submission.tdo_ods_integrableOn_norm_deriv ℓ W a K hW) hs ht hac.intervalIntegrable_deriv
        (Submission.tdo_ods_ae_abs_deriv_inner_le ℓ W a K u hW hu)

/-- Cauchy–Schwarz on `(-a, a)`: `∫_{(-a,a)} g ≤ √(2a ∫_{(-a,a)} g²)`.  If `g` is not integrable on
`(-a, a)`, the left side is `0` (`integral_undef`).  Otherwise put `I := ∫ g²`, `J := ∫ |g|` and
`m := J / (2a)`.  Then `∫ g ≤ J` (`integral_mono`), the measure of `(-a, a)` is `2a`
(`Real.volume_real_Ioo_of_le`), and the variance identity
`0 ≤ ∫ (|g| - m)² = I - 2mJ + 2a m² = I - J² / (2a)` gives `J² ≤ 2a I`, so
`J ≤ |J| ≤ √(2a I)` (`Real.abs_le_sqrt`). -/
theorem tdo_ods_integral_le_sqrt : ∀ (g : ℝ → ℝ) (a : ℝ), 0 < a →
    IntegrableOn (fun s => g s ^ 2) (Ioo (-a) a) →
    (∫ s in Ioo (-a) a, g s) ≤ Real.sqrt (2 * a * ∫ s in Ioo (-a) a, g s ^ 2) := by
  intro g a ha hg2
  by_cases hg : IntegrableOn g (Ioo (-a) a)
  swap
  · rw [integral_undef hg]
    exact Real.sqrt_nonneg _
  set I := ∫ s in Ioo (-a) a, g s ^ 2
  set J := ∫ s in Ioo (-a) a, |g s|
  have hgJ : (∫ s in Ioo (-a) a, g s) ≤ J :=
    integral_mono hg hg.abs fun s => le_abs_self (g s)
  have hvol : volume.real (Ioo (-a) a) = 2 * a := by
    rw [Real.volume_real_Ioo_of_le (by linarith)]; ring
  set m := J / (2 * a) with hm
  have hvar : ∫ s in Ioo (-a) a, (|g s| - m) ^ 2 = I - 2 * m * J + 2 * a * m ^ 2 := by
    have hpt : ∀ s, (|g s| - m) ^ 2 = (g s ^ 2 - 2 * m * |g s|) + m ^ 2 := by
      intro s; rw [sub_sq, sq_abs]; ring
    have hgm : IntegrableOn (fun s => 2 * m * |g s|) (Ioo (-a) a) := hg.abs.const_mul (2 * m)
    have hsub : IntegrableOn (fun s => g s ^ 2 - 2 * m * |g s|) (Ioo (-a) a) := hg2.sub hgm
    have hc : IntegrableOn (fun _ : ℝ => m ^ 2) (Ioo (-a) a) :=
      integrableOn_const measure_Ioo_lt_top.ne
    simp_rw [hpt]
    rw [integral_add hsub hc, integral_sub hg2 hgm, integral_const_mul, setIntegral_const, hvol,
      smul_eq_mul]
  have hnn : 0 ≤ ∫ s in Ioo (-a) a, (|g s| - m) ^ 2 :=
    setIntegral_nonneg measurableSet_Ioo fun s _ => sq_nonneg _
  have hJ2 : J ^ 2 ≤ 2 * a * I := by
    rw [hvar, hm] at hnn
    have h2a : (0 : ℝ) < 2 * a := by linarith
    have key : I - 2 * (J / (2 * a)) * J + 2 * a * (J / (2 * a)) ^ 2 = I - J ^ 2 / (2 * a) := by
      field_simp; ring
    rw [key, sub_nonneg, div_le_iff₀ h2a] at hnn
    linarith
  calc (∫ s in Ioo (-a) a, g s) ≤ J := hgJ
    _ ≤ |J| := le_abs_self J
    _ ≤ Real.sqrt (2 * a * I) := Real.abs_le_sqrt hJ2

end Submission

/-- One-dimensional sup bound (used for the one-dimensional sup estimate in the proof of the
Tilt-excess Decay Theorem, Simon Ch. 5, 4.5): if `W : ℝ → ℝ^ℓ` is `K`-Lipschitz on `[-a, a]`, then
for every `t ∈ [-a, a]`,
`|W(t)| ≤ ((2a)⁻¹ ∫_{(-a,a)} |W|²)^{1/2} + (2a ∫_{(-a,a)} |W'|²)^{1/2}`.

Proof: `|W|` and `|W|²` are continuous on `[-a, a]`, and `|W'|² ≤ K²` on `(-a, a)`
(`norm_deriv_le_of_lipschitzOn`), so all three integrands are integrable on `(-a, a)`.  By
`tdo_ods_norm_sub_le_integral_deriv`, `|W(t)| ≤ |W(s)| + D` for all `s ∈ (-a, a)`, where
`D = ∫_{(-a,a)} |W'|`; averaging over `s` gives `|W(t)| ≤ (2a)⁻¹ ∫_{(-a,a)} |W| + D`, and
`tdo_ods_integral_le_sqrt` (Cauchy–Schwarz) bounds `∫_{(-a,a)} |W|` and `D`. -/
theorem Submission.tdo_ods_interval_sup_le : ∀ (ℓ : ℕ) (W : ℝ → Rn ℓ) (a : ℝ) (K : ℝ≥0), 0 < a → LipschitzOnWith K W (Icc (-a) a) → ∀ t ∈ Icc (-a) a, ‖W t‖ ≤ Real.sqrt ((2 * a)⁻¹ * ∫ s in Ioo (-a) a, ‖W s‖ ^ 2) + Real.sqrt (2 * a * ∫ s in Ioo (-a) a, ‖deriv W s‖ ^ 2) := by
  intro ℓ W a K ha hW t ht
  have h2a : 0 < 2 * a := by linarith
  have hfin : volume (Ioo (-a) a) ≠ ∞ := measure_Ioo_lt_top.ne
  -- Step 1: `|W|` and `|W|²` are continuous on `[-a, a]`, hence integrable on `(-a, a)`.
  have hcont : ContinuousOn (fun s => ‖W s‖) (Icc (-a) a) := hW.continuousOn.norm
  have hW1 : IntegrableOn (fun s => ‖W s‖) (Ioo (-a) a) :=
    hcont.integrableOn_Icc.mono_set Ioo_subset_Icc_self
  have hW2 : IntegrableOn (fun s => ‖W s‖ ^ 2) (Ioo (-a) a) :=
    (hcont.pow 2).integrableOn_Icc.mono_set Ioo_subset_Icc_self
  -- Step 2: `deriv W` is measurable and `|W'|² ≤ K²` on `(-a, a)`.
  have hD2 : IntegrableOn (fun s => ‖deriv W s‖ ^ 2) (Ioo (-a) a) := by
    refine Measure.integrableOn_of_bounded (M := (K : ℝ) ^ 2) hfin
      ((measurable_deriv W).norm.pow_const 2).aestronglyMeasurable
      ((ae_restrict_iff' measurableSet_Ioo).2 (ae_of_all _ fun r hr => ?_))
    rw [Real.norm_of_nonneg (sq_nonneg _)]
    exact pow_le_pow_left₀ (norm_nonneg _)
      (norm_deriv_le_of_lipschitzOn (Icc_mem_nhds hr.1 hr.2) hW) 2
  -- Step 3: `|W(t)| ≤ |W(s)| + D` for every `s ∈ (-a, a)`.
  set D := ∫ r in Ioo (-a) a, ‖deriv W r‖
  have hpt : ∀ s ∈ Ioo (-a) a, ‖W t‖ ≤ ‖W s‖ + D := fun s hs =>
    (norm_le_norm_add_norm_sub' (W t) (W s)).trans (add_le_add le_rfl
      (Submission.tdo_ods_norm_sub_le_integral_deriv ℓ W a K hW s (Ioo_subset_Icc_self hs) t ht))
  -- Step 4: average over `s ∈ (-a, a)`, an interval of length `2a`.
  have hvol : volume.real (Ioo (-a) a) = 2 * a := by
    rw [Real.volume_real_Ioo_of_le (by linarith)]
    ring
  have hconst : IntegrableOn (fun _ : ℝ => ‖W t‖) (Ioo (-a) a) := integrableOn_const hfin
  have hconstD : IntegrableOn (fun _ : ℝ => D) (Ioo (-a) a) := integrableOn_const hfin
  have hsum : IntegrableOn (fun s => ‖W s‖ + D) (Ioo (-a) a) := hW1.add hconstD
  have havg : 2 * a * ‖W t‖ ≤ (∫ s in Ioo (-a) a, ‖W s‖) + 2 * a * D := by
    have h := setIntegral_mono_on hconst hsum measurableSet_Ioo hpt
    rwa [setIntegral_const, integral_add hW1 hconstD, setIntegral_const, hvol, smul_eq_mul,
      smul_eq_mul] at h
  have hinv : (2 * a)⁻¹ * (2 * a) = 1 := inv_mul_cancel₀ h2a.ne'
  have hmean : ‖W t‖ ≤ (2 * a)⁻¹ * (∫ s in Ioo (-a) a, ‖W s‖) + D :=
    calc ‖W t‖ = (2 * a)⁻¹ * (2 * a * ‖W t‖) := by rw [← mul_assoc, hinv, one_mul]
      _ ≤ (2 * a)⁻¹ * ((∫ s in Ioo (-a) a, ‖W s‖) + 2 * a * D) :=
        mul_le_mul_of_nonneg_left havg (inv_nonneg.2 h2a.le)
      _ = (2 * a)⁻¹ * (∫ s in Ioo (-a) a, ‖W s‖) + D := by
        rw [mul_add, ← mul_assoc, hinv, one_mul]
  -- Step 5: Cauchy–Schwarz for `|W|`.
  have hW_cs : (2 * a)⁻¹ * (∫ s in Ioo (-a) a, ‖W s‖) ≤
      Real.sqrt ((2 * a)⁻¹ * ∫ s in Ioo (-a) a, ‖W s‖ ^ 2) :=
    calc (2 * a)⁻¹ * (∫ s in Ioo (-a) a, ‖W s‖)
        ≤ (2 * a)⁻¹ * Real.sqrt (2 * a * ∫ s in Ioo (-a) a, ‖W s‖ ^ 2) :=
          mul_le_mul_of_nonneg_left
            (Submission.tdo_ods_integral_le_sqrt (fun s => ‖W s‖) a ha hW2)
            (inv_nonneg.2 h2a.le)
      _ = Real.sqrt ((2 * a)⁻¹ ^ 2 * (2 * a * ∫ s in Ioo (-a) a, ‖W s‖ ^ 2)) := by
          rw [Real.sqrt_mul (sq_nonneg (2 * a)⁻¹), Real.sqrt_sq (inv_nonneg.2 h2a.le)]
      _ = Real.sqrt ((2 * a)⁻¹ * ∫ s in Ioo (-a) a, ‖W s‖ ^ 2) := by
          rw [sq, mul_assoc, ← mul_assoc (2 * a)⁻¹ (2 * a), hinv, one_mul]
  -- Step 6: Cauchy–Schwarz for `|W'|`.
  have hD_cs : D ≤ Real.sqrt (2 * a * ∫ s in Ioo (-a) a, ‖deriv W s‖ ^ 2) :=
    Submission.tdo_ods_integral_le_sqrt (fun s => ‖deriv W s‖) a ha hD2
  -- Step 7: combine.
  exact hmean.trans (add_le_add hW_cs hD_cs)

namespace Submission

/-- **One-dimensional sup bound** (used for `n = 1 < p < 2` in the proof of the Tilt-excess Decay
Theorem, Simon Ch. 5, 4.5).  If `w : ℝ¹ → ℝ^ℓ` is `K`-Lipschitz on the closed ball `B̄_a(0)` with
`a > 0`, then for every `x ∈ B̄_a(0)`
`|w(x)| ≤ ((2a)⁻¹ ∫_{B_a(0)} |w|²)^{1/2} + (2a ∫_{B_a(0)} |Dw|²)^{1/2}`.

Proof: `ι(t) = t e₁` maps `[-a, a]` isometrically into `B̄_a(0)`, so `W = w ∘ ι` is `K`-Lipschitz on
`[-a, a]`, and `x = ι(x₁)` with `x₁ ∈ [-a, a]`.  The interval bound `tdo_ods_interval_sup_le` at
`t = x₁` is the claim once both ball integrals are written as integrals over `(-a, a)`
(`tdo_ods_ball_integral_eq_interval`) and `|Dw(ι t)|² = |W'(t)|²`
(`tdo_ods_hsNormSq_fderiv_single`). -/
theorem tdo_one_dim_sup_le : ∀ (ℓ : ℕ) (w : Rn 1 → Rn ℓ) (a : ℝ) (K : ℝ≥0), 0 < a → LipschitzOnWith K w (closedBall 0 a) → ∀ x ∈ closedBall (0 : Rn 1) a, ‖w x‖ ≤ Real.sqrt ((2 * a)⁻¹ * ∫ y in ball (0 : Rn 1) a, ‖w y‖ ^ 2) + Real.sqrt (2 * a * ∫ y in ball (0 : Rn 1) a, hsNormSq (fderiv ℝ w y)) := by
  intro ℓ w a K ha hw x hx
  -- Step 2: the curve `W(t) = w(t e₁)` is `K`-Lipschitz on `[-a, a]`.
  set W : ℝ → Rn ℓ := fun s => w (EuclideanSpace.single (0 : Fin 1) s)
  have hmaps : ∀ s ∈ Icc (-a) a,
      EuclideanSpace.single (0 : Fin 1) s ∈ closedBall (0 : Rn 1) a := by
    intro s hs
    rw [mem_closedBall_zero_iff, PiLp.norm_single, Real.norm_eq_abs]
    exact abs_le.mpr hs
  have hWlip : LipschitzOnWith K W (Icc (-a) a) := by
    intro s hs t ht
    simpa only [W, PiLp.edist_single_same] using hw (hmaps s hs) (hmaps t ht)
  -- `x = x₁ e₁` with `x₁ ∈ [-a, a]`.
  have hx_eq : EuclideanSpace.single (0 : Fin 1) (x 0) = x := by
    ext i
    rw [Subsingleton.elim i 0, PiLp.single_eq_same]
  have hx0 : x 0 ∈ Icc (-a) a := by
    have h := mem_closedBall_zero_iff.mp hx
    rw [← hx_eq, PiLp.norm_single, Real.norm_eq_abs] at h
    exact abs_le.mp h
  -- Step 8: both ball integrals are integrals over `(-a, a)` along `W`.
  have h1 : (∫ y in ball (0 : Rn 1) a, ‖w y‖ ^ 2) = ∫ s in Ioo (-a) a, ‖W s‖ ^ 2 :=
    Submission.tdo_ods_ball_integral_eq_interval (fun y => ‖w y‖ ^ 2) a
  have h2 : (∫ y in ball (0 : Rn 1) a, hsNormSq (fderiv ℝ w y)) =
      ∫ s in Ioo (-a) a, ‖deriv W s‖ ^ 2 := by
    rw [Submission.tdo_ods_ball_integral_eq_interval (fun y => hsNormSq (fderiv ℝ w y)) a]
    exact integral_congr_ae (ae_of_all _ fun s =>
      Submission.tdo_ods_hsNormSq_fderiv_single ℓ w s)
  -- Steps 2–7: the interval bound for `W` at `t = x₁`.
  have hWx : W (x 0) = w x := congrArg w hx_eq
  rw [h1, h2, ← hWx]
  exact Submission.tdo_ods_interval_sup_le ℓ W a K ha hWlip (x 0) hx0

/-- **Distance to a nearby plane** (Simon Ch. 5, proof of 4.5): for subspaces `P`, `Q` of
`ℝ^{n+ℓ}` and `x ∈ ℝ^{n+ℓ}`, `dist(x, P) ≤ dist(x, Q) + |p_P − p_Q| |x|`.  The orthogonal
projections are nearest points, `x − p_P x = (x − p_Q x) − (p_P − p_Q) x`, and
`|(p_P − p_Q) x| ≤ |p_P − p_Q| |x|` by taking square roots in `lgc_hsNormSq_bounds`. -/
theorem tdo_stp_infDist_le_infDist_add_hsNorm : ∀ (n ℓ : ℕ) (P Q : Submodule ℝ (Amb n ℓ)) (x : Amb n ℓ), infDist x (P : Set (Amb n ℓ)) ≤ infDist x (Q : Set (Amb n ℓ)) + hsNorm (P.starProjection - Q.starProjection) * ‖x‖ := by
  intro n ℓ P Q x
  set A := P.starProjection - Q.starProjection with hA
  have hb := (lgc_hsNormSq_bounds (n + ℓ) (n + ℓ)).2 A
  -- `|A x| ≤ |A| |x|`: square roots of `|A x|² ≤ |A|² |x|²`.
  have hAx : ‖A x‖ ≤ hsNorm A * ‖x‖ := by
    unfold hsNorm
    rw [← Real.sqrt_sq (norm_nonneg (A x)), ← Real.sqrt_sq (norm_nonneg x),
      ← Real.sqrt_mul hb.1]
    exact Real.sqrt_le_sqrt (hb.2.2 x)
  -- The orthogonal projections are nearest points.
  rw [← P.dist_starProjection_eq_infDist x, ← Q.dist_starProjection_eq_infDist x,
    dist_eq_norm, dist_eq_norm]
  have hx : x - P.starProjection x = (x - Q.starProjection x) - A x := by
    rw [hA, sub_apply]
    abel
  calc ‖x - P.starProjection x‖ ≤ ‖x - Q.starProjection x‖ + ‖A x‖ := by
        rw [hx]
        exact norm_sub_le _ _
    _ ≤ ‖x - Q.starProjection x‖ + hsNorm A * ‖x‖ := by gcongr

/-- **Comparison of two planes by their tilt-excess** (proof of Simon Ch. 5, Theorem 4.5, p. 117:
`E(0, ρ, T)` and `E(0, ρ, T̃)` small give `|p_T − p_T̃|` small).  If `x ↦ p_{T_x M}` is
`μ_V`-a.e. strongly measurable and `μ_V(B_s(z)) < ∞`, then for all subspaces `P, Q`
`μ_V(B_s(z)) |p_P − p_Q|² ≤ 2 sⁿ (E(z, s, P) + E(z, s, Q))`: column by column,
`|a − b|² ≤ 2|a|² + 2|b|²` gives `|p_P − p_Q|² ≤ 2|p_{T_x M} − p_P|² + 2|p_{T_x M} − p_Q|²`
for every `x`, and integrating over `B_s(z)` gives the claim (the integrands are bounded since
all projections have operator norm `≤ 1`). -/
theorem tdo_stp_hsNormSq_sub_le_tiltExcess : ∀ (n ℓ : ℕ) (U : Set (Amb n ℓ)) (V : RectifiableVarifold n ℓ U), AEStronglyMeasurable V.tangentProj V.weight → ∀ (z : Amb n ℓ) (s : ℝ), 0 < s → V.weight (closedBall z s) ≠ ⊤ → ∀ P Q : Submodule ℝ (Amb n ℓ), (V.weight (closedBall z s)).toReal * hsNormSq (P.starProjection - Q.starProjection) ≤ 2 * s ^ n * (V.tiltExcess z s P + V.tiltExcess z s Q) := by
  intro n ℓ U V hmeas z s hs hfin P Q
  obtain ⟨hcont, hbd⟩ := lgc_hsNormSq_bounds (n + ℓ) (n + ℓ)
  -- Tangent projections are orthogonal projections or `0`, so of operator norm `≤ 1`.
  have hproj : ∀ x, ‖V.tangentProj x‖ ≤ 1 := by
    intro x
    unfold RectifiableVarifold.tangentProj
    split_ifs
    · exact Submodule.starProjection_norm_le _
    · simp
  -- `x ↦ |p_{T_x M} − p_R|²` is a.e. strongly measurable and bounded by `4(n+ℓ)`, hence
  -- integrable on the ball of finite measure.
  have hint : ∀ R : Submodule ℝ (Amb n ℓ), IntegrableOn
      (fun x => hsNormSq (V.tangentProj x - R.starProjection)) (closedBall z s) V.weight := by
    intro R
    refine Measure.integrableOn_of_bounded (M := ((n + ℓ : ℕ) : ℝ) * 2 ^ 2) hfin
      (hcont.comp_aestronglyMeasurable (hmeas.sub aestronglyMeasurable_const))
      (Filter.Eventually.of_forall fun x => ?_)
    obtain ⟨h0, h1, -⟩ := hbd (V.tangentProj x - R.starProjection)
    rw [Real.norm_eq_abs, abs_of_nonneg h0]
    refine h1.trans ?_
    gcongr
    calc ‖V.tangentProj x - R.starProjection‖
        ≤ ‖V.tangentProj x‖ + ‖R.starProjection‖ := norm_sub_le _ _
      _ ≤ 1 + 1 := add_le_add (hproj x) R.starProjection_norm_le
      _ = 2 := by norm_num
  -- Pointwise `|p_P − p_Q|² ≤ 2|p_{T_x M} − p_P|² + 2|p_{T_x M} − p_Q|²`, column by column.
  have hpt : ∀ x, hsNormSq (P.starProjection - Q.starProjection) ≤
      2 * hsNormSq (V.tangentProj x - P.starProjection) +
        2 * hsNormSq (V.tangentProj x - Q.starProjection) := by
    intro x
    unfold hsNormSq
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_le_sum fun i _ => ?_
    simp only [sub_apply]
    set a := V.tangentProj x (EuclideanSpace.single i 1) - Q.starProjection (EuclideanSpace.single i 1)
    set b := V.tangentProj x (EuclideanSpace.single i 1) - P.starProjection (EuclideanSpace.single i 1)
    have hab : P.starProjection (EuclideanSpace.single i 1) - Q.starProjection (EuclideanSpace.single i 1)
        = a - b := by
      simp only [a, b]
      abel
    rw [hab]
    nlinarith [norm_sub_le a b, sq_nonneg (‖a‖ - ‖b‖), norm_nonneg a, norm_nonneg b,
      norm_nonneg (a - b)]
  -- Integrate the pointwise inequality over the ball.
  have hP := (hint P).const_mul 2
  have hQ := (hint Q).const_mul 2
  have key := setIntegral_ge_of_const_le_real measurableSet_closedBall hfin
    (fun x _ => hpt x) (hP.add hQ)
  rw [integral_add hP hQ, integral_const_mul, integral_const_mul, measureReal_def] at key
  -- `sⁿ E(z, s, R) = ∫_{B_s(z)} |p_{T_x M} − p_R|² dμ_V` since `s > 0`.
  unfold RectifiableVarifold.tiltExcess
  have hsn : s ^ n ≠ 0 := pow_ne_zero _ hs.ne'
  have hrw : 2 * s ^ n * ((s ^ n)⁻¹ *
        ∫ x in closedBall z s, hsNormSq (V.tangentProj x - P.starProjection) ∂V.weight +
      (s ^ n)⁻¹ *
        ∫ x in closedBall z s, hsNormSq (V.tangentProj x - Q.starProjection) ∂V.weight) =
      2 * ∫ x in closedBall z s, hsNormSq (V.tangentProj x - P.starProjection) ∂V.weight +
        2 * ∫ x in closedBall z s, hsNormSq (V.tangentProj x - Q.starProjection) ∂V.weight := by
    field_simp
  rw [hrw]
  linarith [key]

/-- **Simon Ch. 5, proof of Theorem 4.5, steps (1)–(2): the plane `T(0, 2δρ)`.**  Assume the Affine
Approximation Lemma 2.5, with constant `C_A = C_A(n, ℓ, p)`.  If 2.3 holds with `δ ∈ (0, 1/4]` and
`(σ^{p−n} ∫_{B_σ(0)} |H|ᵖ dμ_V)^{1/p} ≤ δ` for `σ = 2δρ`, then the plane `T` given by 2.5 at
`ξ = 0 ∈ spt V` and radius `2δρ` satisfies `E(0, δρ, T) ≤ C (δ^{1/(2n+2)})²` and
`dist(x, T) ≤ C δ^{1/(2n+2)} δρ` for `x ∈ spt V ∩ B_{2δρ}(0)`, with `C = 2ⁿ C_A² (C_A + 1)² + 2 C_A`.
Indeed `δ ≤ δ^{1/(2n+2)}`, so the right side of the first inequality of 2.5 is
`≤ (C_A + 1) δ^{1/(2n+2)}`, and `E(0, δρ, T) = 2ⁿ (2δρ)⁻ⁿ ∫_{B_{δρ}(0)} |p_{T_x M} − p_T|² dμ_V`;
each `dist(x, T)` is a term of the height supremum, so the second inequality of 2.5 gives
`dist(x, T) ≤ 2 C_A δ^{1/(2n+2)} δρ`. -/
theorem tdo_stp_origin_affine_plane : AffineApproximationLemma → ∀ n ℓ : ℕ, 1 ≤ n → ∀ p : ℝ, (n : ℝ) < p → ∃ C : ℝ, 0 < C ∧ ∀ (U : Set (Amb n ℓ)), IsOpen U → ∀ (V : RectifiableVarifold n ℓ U) (H : Amb n ℓ → Amb n ℓ) (δ ρ : ℝ), 0 < δ → δ ≤ 1 / 4 → V.AllardHypotheses H p δ ρ → V.scaledLpNorm H p 0 (2 * (δ * ρ)) ≤ ENNReal.ofReal δ → ∃ T : Submodule ℝ (Amb n ℓ), Module.finrank ℝ T = n ∧ V.tiltExcess 0 (δ * ρ) T ≤ C * (δ ^ (1 / (2 * (n : ℝ) + 2))) ^ 2 ∧ ∀ x ∈ V.support ∩ closedBall 0 (2 * (δ * ρ)), infDist x (T : Set (Amb n ℓ)) ≤ C * δ ^ (1 / (2 * (n : ℝ) + 2)) * (δ * ρ) := by
  intro hAff n ℓ hn p hp
  -- The constant `C_A` of the Affine Approximation Lemma 2.5 for `(n, ℓ, p)`.
  obtain ⟨CA, hCA, hA⟩ := hAff n ℓ hn p hp
  refine ⟨2 ^ n * CA ^ 2 * (CA + 1) ^ 2 + 2 * CA, by positivity, ?_⟩
  intro U hU V H δ ρ hδ hδ4 hAH hK
  have hρ : 0 < ρ := hAH.1
  have h0 : (0 : Amb n ℓ) ∈ V.support := hAH.2.2.2.1
  have hσ : 0 < δ * ρ := mul_pos hδ hρ
  -- Lemma 2.5 at `ξ = 0` with radius `2δρ`.
  obtain ⟨T, hT, h2a, h2b⟩ := hA U hU V H δ ρ hδ hδ4 hAH 0 ⟨h0, mem_closedBall_self hσ.le⟩
    (2 * (δ * ρ)) (by positivity) (le_of_eq (by ring))
  set σ := δ * ρ
  set g := δ ^ (1 / (2 * (n : ℝ) + 2))
  have hg0 : 0 ≤ g := Real.rpow_nonneg hδ.le _
  -- `δ = δ ^ 1 ≤ δ ^ (1 / (2n + 2))` since `δ ≤ 1` and `1 / (2n + 2) ≤ 1`.
  have hδg : δ ≤ g := by
    have hn' : (1 : ℝ) ≤ n := by exact_mod_cast hn
    have hexp : 1 / (2 * (n : ℝ) + 2) ≤ 1 := by
      rw [div_le_one₀ (by positivity)]
      linarith
    calc δ = δ ^ (1 : ℝ) := (Real.rpow_one δ).symm
      _ ≤ g := Real.rpow_le_rpow_of_exponent_ge hδ (by linarith) hexp
  refine ⟨T, hT, ?_, ?_⟩
  · -- Tilt bound.
    rw [show 2 * σ / 2 = σ by ring] at h2a
    set J := ∫ x in closedBall (0 : Amb n ℓ) σ,
      hsNormSq (V.tangentProj x - T.starProjection) ∂V.weight
    have hrhs : ENNReal.ofReal (2 * σ)⁻¹ * V.heightSup 0 (2 * σ) T +
        V.scaledLpNorm H p 0 (2 * σ) ≤ ENNReal.ofReal ((CA + 1) * g) := by
      calc _ ≤ ENNReal.ofReal (CA * g) + ENNReal.ofReal g :=
            add_le_add h2b (hK.trans (ENNReal.ofReal_le_ofReal hδg))
        _ = ENNReal.ofReal (CA * g + g) := (ENNReal.ofReal_add (by positivity) hg0).symm
        _ = ENNReal.ofReal ((CA + 1) * g) := by congr 1; ring
    have h3 := (ENNReal.ofReal_le_ofReal_iff (by positivity)).1 (h2a.trans hrhs)
    rw [inv_mul_le_iff₀ hCA] at h3
    have h4 : ((2 * σ) ^ n)⁻¹ * J ≤ (CA * ((CA + 1) * g)) ^ 2 :=
      (Real.sqrt_le_left (by positivity)).1 h3
    -- `σ⁻ⁿ J = 2ⁿ (2σ)⁻ⁿ J`.
    have h5 : V.tiltExcess 0 σ T = 2 ^ n * (((2 * σ) ^ n)⁻¹ * J) := by
      have h2n : (2 : ℝ) ^ n ≠ 0 := by positivity
      have key : ∀ s j : ℝ, (s ^ n)⁻¹ * j = 2 ^ n * (((2 * s) ^ n)⁻¹ * j) := fun s j => by
        rw [mul_pow, mul_inv, ← mul_assoc, ← mul_assoc, mul_inv_cancel₀ h2n, one_mul]
      exact key σ J
    rw [h5]
    calc 2 ^ n * (((2 * σ) ^ n)⁻¹ * J) ≤ 2 ^ n * (CA * ((CA + 1) * g)) ^ 2 := by gcongr
      _ = 2 ^ n * CA ^ 2 * (CA + 1) ^ 2 * g ^ 2 := by ring
      _ ≤ 2 ^ n * CA ^ 2 * (CA + 1) ^ 2 * g ^ 2 + 2 * CA * g ^ 2 :=
          le_add_of_nonneg_right (by positivity)
      _ = (2 ^ n * CA ^ 2 * (CA + 1) ^ 2 + 2 * CA) * g ^ 2 := by ring
  · -- Height bound.
    intro x hx
    have hle : ENNReal.ofReal (infDist x (T : Set (Amb n ℓ))) ≤ V.heightSup 0 (2 * σ) T :=
      calc ENNReal.ofReal (infDist x (T : Set (Amb n ℓ)))
          = ENNReal.ofReal (infDist (x - 0) (T : Set (Amb n ℓ))) := by rw [sub_zero]
        _ ≤ V.heightSup 0 (2 * σ) T :=
          le_iSup₂ (f := fun y (_ : y ∈ V.support ∩ closedBall (0 : Amb n ℓ) (2 * σ)) =>
            ENNReal.ofReal (infDist (y - 0) (T : Set (Amb n ℓ)))) x hx
    have h1 : ENNReal.ofReal (2 * σ)⁻¹ * ENNReal.ofReal (infDist x (T : Set (Amb n ℓ))) ≤
        ENNReal.ofReal (CA * g) :=
      le_trans (by gcongr) h2b
    rw [← ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_le_ofReal_iff (by positivity),
      inv_mul_le_iff₀ (by positivity)] at h1
    calc infDist x (T : Set (Amb n ℓ)) ≤ 2 * σ * (CA * g) := h1
      _ = 2 * CA * g * σ := by ring
      _ ≤ (2 ^ n * CA ^ 2 * (CA + 1) ^ 2 + 2 * CA) * g * σ := by
          gcongr
          exact le_add_of_nonneg_left (by positivity)

/-- Hölder's inequality on a set `B` for an arbitrary (not necessarily measurable) function
`g : X → [0, ∞]` and exponents `0 < q ≤ p`:
`∫⁻_B g^q dμ ≤ (∫⁻_B g^p dμ)^{q/p} μ(B)^{1-q/p}`, as used for the scaled `Lᵖ` bounds of the mean
curvature in the tilt-excess decay (cf. Simon Ch. 5, Remark 2.2, p. 107).
Replace `g^q` by a measurable minorant `G` with the same integral over `B`
(`exists_measurable_le_lintegral_eq`), write `G = (G^{p/q})^{q/p} · 1^{1-q/p}`, apply the
two-exponent Hölder inequality `ENNReal.lintegral_mul_norm_pow_le` for `μ.restrict B`, and use
`G^{p/q} ≤ (g^q)^{p/q} = g^p` with the monotonicity of the lower integral. -/
theorem tdo_slb_setLIntegral_rpow_le_holder : ∀ (X : Type) [MeasurableSpace X] (μ : Measure X) (B : Set X) (g : X → ℝ≥0∞) (p q : ℝ), 0 < q → q ≤ p → ∫⁻ x in B, g x ^ q ∂μ ≤ (∫⁻ x in B, g x ^ p ∂μ) ^ (q / p) * μ B ^ (1 - q / p) := by
  intro X _ μ B g p q hq hqp
  -- 1. the exponents: `q / p, 1 - q / p ≥ 0` sum to `1`, and `(p / q) (q / p) = 1`, `q (p / q) = p`
  have hp : 0 < p := hq.trans_le hqp
  have ha : 0 ≤ q / p := (div_pos hq hp).le
  have hb : 0 ≤ 1 - q / p := sub_nonneg.mpr ((div_le_one hp).mpr hqp)
  have hab : q / p + (1 - q / p) = 1 := add_sub_cancel _ _
  have hpq : p / q * (q / p) = 1 := by field_simp
  have hqp' : q * (p / q) = p := by field_simp
  -- 2. a measurable minorant `G ≤ g ^ q` with the same integral over `B`
  obtain ⟨G, hGm, hGg, hG⟩ := exists_measurable_le_lintegral_eq (μ.restrict B) fun x => g x ^ q
  -- 3. `G = (G ^ (p / q)) ^ (q / p) * 1 ^ (1 - q / p)` pointwise
  have hGF : ∀ x, (G x ^ (p / q)) ^ (q / p) * (1 : ℝ≥0∞) ^ (1 - q / p) = G x := fun x => by
    rw [ENNReal.one_rpow, mul_one, ← ENNReal.rpow_mul, hpq, ENNReal.rpow_one]
  -- 4. Hölder for `G ^ (p / q)` and `1` with the exponents `q / p` and `1 - q / p` on `μ.restrict B`
  have hH := ENNReal.lintegral_mul_norm_pow_le (μ := μ.restrict B)
    (hGm.pow_const (p / q)).aemeasurable (aemeasurable_const (b := (1 : ℝ≥0∞))) ha hb hab
  -- 5. `G ^ (p / q) ≤ (g ^ q) ^ (p / q) = g ^ p`
  have hGp : ∀ x, G x ^ (p / q) ≤ g x ^ p := fun x => by
    calc G x ^ (p / q) ≤ (g x ^ q) ^ (p / q) := ENNReal.rpow_le_rpow (hGg x) (div_pos hp hq).le
      _ = g x ^ p := by rw [← ENNReal.rpow_mul, hqp']
  -- 6. chain the steps; `∫⁻_B 1 dμ = μ(B)`
  calc ∫⁻ x in B, g x ^ q ∂μ = ∫⁻ x in B, G x ∂μ := hG
    _ = ∫⁻ x in B, (G x ^ (p / q)) ^ (q / p) * (1 : ℝ≥0∞) ^ (1 - q / p) ∂μ := by
        simp only [hGF]
    _ ≤ (∫⁻ x in B, G x ^ (p / q) ∂μ) ^ (q / p) * (∫⁻ _ in B, (1 : ℝ≥0∞) ∂μ) ^ (1 - q / p) := hH
    _ = (∫⁻ x in B, G x ^ (p / q) ∂μ) ^ (q / p) * μ B ^ (1 - q / p) := by
        rw [setLIntegral_one]
    _ ≤ (∫⁻ x in B, g x ^ p ∂μ) ^ (q / p) * μ B ^ (1 - q / p) := by
        gcongr
        exact hGp _

/-- Scaling of the scaled `Lᵖ` norm of `H` on nested closed balls (Simon Ch. 5, end of the proof of
4.5, p. 121, where `B_{θσ}(0) ⊆ B_σ(0)` gives
`((θσ)^{p−n} ∫_{B_{θσ}(0)} |H|ᵖ dμ_V)^{1/p} ≤ θ^{1−n/p} (σ^{p−n} ∫_{B_σ(0)} |H|ᵖ dμ_V)^{1/p}`):
if `p > 0`, `0 < s ≤ t` and `B_s(z) ⊆ B_t(w)`, then
`(s^{p−n} ∫_{B_s(z)} |H|ᵖ dμ_V)^{1/p} ≤ (s/t)^{(p−n)/p} (t^{p−n} ∫_{B_t(w)} |H|ᵖ dμ_V)^{1/p}`.
The integral over the smaller ball is at most the one over the larger ball, the weight splits as
`s^{p−n} = (s/t)^{p−n} t^{p−n}`, and `x ↦ x^{1/p}` is monotone and multiplicative on `[0, ∞]`. -/
theorem tdo_slb_scaledLpNorm_le_of_subset : ∀ (n ℓ : ℕ) (U : Set (Amb n ℓ)) (V : RectifiableVarifold n ℓ U) (H : Amb n ℓ → Amb n ℓ) (p : ℝ) (z w : Amb n ℓ) (s t : ℝ), 0 < p → 0 < s → s ≤ t → closedBall z s ⊆ closedBall w t → V.scaledLpNorm H p z s ≤ ENNReal.ofReal ((s / t) ^ ((p - n) / p)) * V.scaledLpNorm H p w t := by
  intro n ℓ U V H p z w s t hp hs hst hsub
  -- Step 1: `t > 0` and `s / t > 0`
  have ht : 0 < t := hs.trans_le hst
  have hst' : 0 ≤ s / t := (div_pos hs ht).le
  -- Step 2: monotonicity of the lower integral in the domain (no measurability needed)
  have hI : ∫⁻ x in closedBall z s, ‖H x‖ₑ ^ p ∂V.weight
      ≤ ∫⁻ x in closedBall w t, ‖H x‖ₑ ^ p ∂V.weight :=
    lintegral_mono_set hsub
  -- Step 3: `ofReal (s^{p−n}) = ofReal ((s/t)^{p−n}) * ofReal (t^{p−n})`
  have hsplit : ENNReal.ofReal (s ^ (p - n))
      = ENNReal.ofReal ((s / t) ^ (p - n)) * ENNReal.ofReal (t ^ (p - n)) := by
    rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hst' _), Real.div_rpow hs.le ht.le,
      div_mul_cancel₀ _ (Real.rpow_pos_of_pos ht _).ne']
  have hp' : 0 ≤ 1 / p := (one_div_pos.mpr hp).le
  unfold RectifiableVarifold.scaledLpNorm
  -- Steps 4–6: compare inside, take `1/p`-th powers, and simplify the coefficient
  calc (ENNReal.ofReal (s ^ (p - n)) * ∫⁻ x in closedBall z s, ‖H x‖ₑ ^ p ∂V.weight) ^ (1 / p)
      ≤ (ENNReal.ofReal ((s / t) ^ (p - n)) * (ENNReal.ofReal (t ^ (p - n))
          * ∫⁻ x in closedBall w t, ‖H x‖ₑ ^ p ∂V.weight)) ^ (1 / p) := by
        refine ENNReal.rpow_le_rpow ?_ hp'
        rw [hsplit, mul_assoc]
        gcongr
    _ = ENNReal.ofReal ((s / t) ^ (p - n)) ^ (1 / p) * (ENNReal.ofReal (t ^ (p - n))
          * ∫⁻ x in closedBall w t, ‖H x‖ₑ ^ p ∂V.weight) ^ (1 / p) :=
        ENNReal.mul_rpow_of_nonneg _ _ hp'
    _ = ENNReal.ofReal ((s / t) ^ ((p - n) / p)) * (ENNReal.ofReal (t ^ (p - n))
          * ∫⁻ x in closedBall w t, ‖H x‖ₑ ^ p ∂V.weight) ^ (1 / p) := by
        rw [ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg hst' _) hp', ← Real.rpow_mul hst',
          mul_one_div]

/-- Simon Ch. 5, Remark 2.2 (p. 107): the Hölder estimate of `∫_{B_s(z)} |H|^q dμ_V` by the scaled
`Lᵖ` norm on a larger ball `B_t(w) ⊇ B_s(z)`.  If `0 < q ≤ p` and `μ_V(B_s(z)) ≤ m`, then
`∫_{B_s(z)} |H|^q dμ_V ≤ m^{1−q/p} t^{q(n−p)/p} (t^{p−n} ∫_{B_t(w)} |H|ᵖ dμ_V)^{q/p}`
(lower integrals in `[0, ∞]`; no measurability of `H` and no condition on `s`). -/
theorem tdo_slb_lintegral_rpow_le_scaledLpNorm : ∀ (n ℓ : ℕ) (U : Set (Amb n ℓ)) (V : RectifiableVarifold n ℓ U) (H : Amb n ℓ → Amb n ℓ) (p q : ℝ) (z w : Amb n ℓ) (s t m : ℝ), 0 < q → q ≤ p → 0 < t → 0 ≤ m → closedBall z s ⊆ closedBall w t → V.weight (closedBall z s) ≤ ENNReal.ofReal m → ∫⁻ x in closedBall z s, ‖H x‖ₑ ^ q ∂V.weight ≤ ENNReal.ofReal (m ^ (1 - q / p) * t ^ (q * (n - p) / p)) * V.scaledLpNorm H p w t ^ q := by
  intro n ℓ U V H p q z w s t m hq hqp ht hm hsub hmass
  -- Step 1: `p > 0`, `a = q/p ≥ 0`, `b = 1 - q/p ≥ 0`.
  have hp : 0 < p := hq.trans_le hqp
  have ha : 0 ≤ q / p := (div_pos hq hp).le
  have hb : 0 ≤ 1 - q / p := sub_nonneg.2 ((div_le_one hp).2 hqp)
  -- Step 5: `I^a = ofReal(t^{q(n-p)/p}) · K(w, t)^q` with `I = ∫⁻_{B_t(w)} |H|ᵖ`.
  have hkey : ENNReal.ofReal (t ^ (q * (n - p) / p)) * V.scaledLpNorm H p w t ^ q =
      (∫⁻ x in closedBall w t, ‖H x‖ₑ ^ p ∂V.weight) ^ (q / p) := by
    have hexp : q * (n - p) / p + (p - n) * (q / p) = 0 := by
      field_simp
      ring
    rw [RectifiableVarifold.scaledLpNorm, ← ENNReal.rpow_mul, one_div_mul_eq_div,
      ENNReal.mul_rpow_of_nonneg _ _ ha,
      ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg ht.le _) ha, ← Real.rpow_mul ht.le,
      ← mul_assoc, ← ENNReal.ofReal_mul (Real.rpow_nonneg ht.le _), ← Real.rpow_add ht, hexp,
      Real.rpow_zero, ENNReal.ofReal_one, one_mul]
  calc ∫⁻ x in closedBall z s, ‖H x‖ₑ ^ q ∂V.weight
      ≤ (∫⁻ x in closedBall z s, ‖H x‖ₑ ^ p ∂V.weight) ^ (q / p) *
          V.weight (closedBall z s) ^ (1 - q / p) :=
        Submission.tdo_slb_setLIntegral_rpow_le_holder (Amb n ℓ) V.weight (closedBall z s)
          (fun x => ‖H x‖ₑ) p q hq hqp
    -- Step 3: enlarge the domain to `B_t(w)` and bound the mass by `m`.
    _ ≤ (∫⁻ x in closedBall w t, ‖H x‖ₑ ^ p ∂V.weight) ^ (q / p) *
          ENNReal.ofReal m ^ (1 - q / p) :=
        mul_le_mul' (ENNReal.rpow_le_rpow (lintegral_mono_set hsub) ha)
          (ENNReal.rpow_le_rpow hmass hb)
    -- Steps 4 and 6: recombine the constants.
    _ = ENNReal.ofReal (m ^ (1 - q / p) * t ^ (q * (n - p) / p)) * V.scaledLpNorm H p w t ^ q := by
        rw [ENNReal.ofReal_mul (Real.rpow_nonneg hm _), mul_assoc, hkey,
          ← ENNReal.ofReal_rpow_of_nonneg hm hb, mul_comm]

/-- **Scaling and Hölder bounds for the scaled `Lᵖ` norm** (used in the proof of Simon Ch. 5,
Theorem 4.5, pp. 117–121; part (b) generalizes the Hölder step of Remark 2.2, p. 107).  Write
`K(y, r) = (r^{p−n} ∫_{B_r(y)} |H|ᵖ dμ_V)^{1/p} ∈ [0, ∞]` (`V.scaledLpNorm`, closed balls, lower
integrals, `H` arbitrary).
(a) If `p > 0`, `0 < s ≤ t` and `B_s(z) ⊆ B_t(w)`, then `K(z, s) ≤ (s/t)^{(p−n)/p} K(w, t)`.
(b) If `0 < q ≤ p`, `t > 0`, `m ≥ 0`, `B_s(z) ⊆ B_t(w)` and `μ_V(B_s(z)) ≤ m`, then
`∫_{B_s(z)} |H|^q dμ_V ≤ m^{1−q/p} t^{q(n−p)/p} K(w, t)^q`.

Part (a) is `tdo_slb_scaledLpNorm_le_of_subset`: monotonicity of the `p`-integral in the ball and
`s^{p−n} = (s/t)^{p−n} t^{p−n}`, followed by taking `1/p`-th powers.  Part (b) is
`tdo_slb_lintegral_rpow_le_scaledLpNorm`: Hölder's inequality on `B_s(z)` for the possibly
non-measurable `|H|` (`tdo_slb_setLIntegral_rpow_le_holder`), the bounds
`∫_{B_s(z)} |H|ᵖ ≤ ∫_{B_t(w)} |H|ᵖ` and `μ_V(B_s(z)) ≤ m`, and the identity
`(∫_{B_t(w)} |H|ᵖ dμ_V)^{q/p} = t^{q(n−p)/p} K(w, t)^q`. -/
theorem tdo_scaledLpNorm_bounds : (∀ (n ℓ : ℕ) (U : Set (Amb n ℓ)) (V : RectifiableVarifold n ℓ U) (H : Amb n ℓ → Amb n ℓ) (p : ℝ) (z w : Amb n ℓ) (s t : ℝ), 0 < p → 0 < s → s ≤ t → closedBall z s ⊆ closedBall w t → V.scaledLpNorm H p z s ≤ ENNReal.ofReal ((s / t) ^ ((p - n) / p)) * V.scaledLpNorm H p w t) ∧ (∀ (n ℓ : ℕ) (U : Set (Amb n ℓ)) (V : RectifiableVarifold n ℓ U) (H : Amb n ℓ → Amb n ℓ) (p q : ℝ) (z w : Amb n ℓ) (s t m : ℝ), 0 < q → q ≤ p → 0 < t → 0 ≤ m → closedBall z s ⊆ closedBall w t → V.weight (closedBall z s) ≤ ENNReal.ofReal m → ∫⁻ x in closedBall z s, ‖H x‖ₑ ^ q ∂V.weight ≤ ENNReal.ofReal (m ^ (1 - q / p) * t ^ (q * (n - p) / p)) * V.scaledLpNorm H p w t ^ q) :=
  ⟨Submission.tdo_slb_scaledLpNorm_le_of_subset, Submission.tdo_slb_lintegral_rpow_le_scaledLpNorm⟩

/-- **Simon Ch. 5, Remark 4.6 (p. 116)**: the trivial comparison of tilt-excesses on nested balls.
If `0 < s ≤ t` and `B_s(z) ⊆ B_t(w) ⊆ U` (closed balls), then for every subspace `S`
`E(z, s, S) ≤ (t/s)ⁿ E(w, t, S)`.  The integrand `φ(x) = |p_{T_x M} − p_S|²` satisfies
`0 ≤ φ ≤ 4(n + ℓ)`, since both projections have operator norm `≤ 1`, and it is `μ_V`-a.e. strongly
measurable because `A ↦ |A − p_S|²` is continuous.  As `B_t(w) ⊆ U` is compact,
`μ_V(B_t(w)) = ∫_{M ∩ B_t(w)} θ dHⁿ < ∞`, so `φ` is integrable on `B_t(w)` and
`∫_{B_s(z)} φ dμ_V ≤ ∫_{B_t(w)} φ dμ_V`; finally `s⁻ⁿ = (t/s)ⁿ t⁻ⁿ`. -/
theorem tdo_tiltExcess_le_of_subset : ∀ (n ℓ : ℕ) (U : Set (Amb n ℓ)) (V : RectifiableVarifold n ℓ U), AEStronglyMeasurable V.tangentProj V.weight → ∀ (z w : Amb n ℓ) (s t : ℝ) (S : Submodule ℝ (Amb n ℓ)), 0 < s → s ≤ t → closedBall z s ⊆ closedBall w t → closedBall w t ⊆ U → V.tiltExcess z s S ≤ (t / s) ^ n * V.tiltExcess w t S := by
  intro n ℓ U V hmeas z w s t S hs hst hsub hU
  -- Notation: `φ(x) = |p_{T_x M} − p_S|²`.
  set φ : Amb n ℓ → ℝ := fun x => hsNormSq (V.tangentProj x - S.starProjection)
  -- Step 1: `0 ≤ φ ≤ 4(n + ℓ)`, as `‖p_{T_x M}‖ ≤ 1` (a projection, or `0`) and `‖p_S‖ ≤ 1`.
  have hnorm : ∀ x, ‖V.tangentProj x‖ ≤ 1 := by
    intro x
    unfold RectifiableVarifold.tangentProj
    split_ifs
    · exact Submodule.starProjection_norm_le _
    · simp
  have hφ0 : ∀ x, 0 ≤ φ x := fun x => Finset.sum_nonneg fun i _ => sq_nonneg _
  have hφle : ∀ x, ‖φ x‖ ≤ 4 * ((n + ℓ : ℕ) : ℝ) := by
    intro x
    rw [Real.norm_of_nonneg (hφ0 x)]
    have hA : ‖V.tangentProj x - S.starProjection‖ ≤ 2 :=
      (norm_sub_le _ _).trans (by linarith [hnorm x, S.starProjection_norm_le])
    calc φ x ≤ ∑ _i : Fin (n + ℓ), (2 : ℝ) ^ 2 := by
          refine Finset.sum_le_sum fun i _ => pow_le_pow_left₀ (norm_nonneg _) ?_ 2
          calc _ ≤ ‖V.tangentProj x - S.starProjection‖ * ‖EuclideanSpace.single i (1 : ℝ)‖ :=
                (V.tangentProj x - S.starProjection).le_opNorm _
            _ ≤ 2 := by simpa using hA
      _ = 4 * ((n + ℓ : ℕ) : ℝ) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
          ring
  -- Step 2: `φ` is `μ_V`-a.e. strongly measurable, since `A ↦ |A − p_S|²` is continuous.
  have hcont : Continuous fun A : Amb n ℓ →L[ℝ] Amb n ℓ => hsNormSq (A - S.starProjection) := by
    unfold hsNormSq
    exact continuous_finsetSum _ fun i _ =>
      (((continuous_id.sub continuous_const).clm_apply continuous_const).norm).pow 2
  have hφmeas : AEStronglyMeasurable φ V.weight := hcont.comp_aestronglyMeasurable hmeas
  -- Step 3: `μ_V(B_t(w)) = ∫_{M ∩ B_t(w)} θ dHⁿ < ∞`, as `B_t(w) ⊆ U` is compact.
  have hK : IsCompact (closedBall w t) := isCompact_closedBall w t
  have hfin : V.weight (closedBall w t) < ⊤ := by
    rw [RectifiableVarifold.weight, withDensity_apply _ hK.isClosed.measurableSet,
      Measure.restrict_restrict hK.isClosed.measurableSet, inter_comm (closedBall w t) V.carrier]
    exact (V.integrableOn_mult _ hK hU).lintegral_lt_top
  -- Step 4: `φ` is integrable on `B_t(w)`, so `∫_{B_s(z)} φ dμ_V ≤ ∫_{B_t(w)} φ dμ_V`.
  have hint : IntegrableOn φ (closedBall w t) V.weight :=
    Measure.integrableOn_of_bounded hfin.ne hφmeas (Eventually.of_forall hφle)
  have hmono : ∫ x in closedBall z s, φ x ∂V.weight ≤ ∫ x in closedBall w t, φ x ∂V.weight :=
    setIntegral_mono_set hint (Eventually.of_forall hφ0) (Eventually.of_forall hsub)
  -- Step 5: `s⁻ⁿ = (t/s)ⁿ t⁻ⁿ`, as `0 < s ≤ t`.
  have ht : 0 < t := lt_of_lt_of_le hs hst
  have hscale : (s ^ n)⁻¹ = (t / s) ^ n * (t ^ n)⁻¹ := by
    rw [div_pow]
    field_simp
  unfold RectifiableVarifold.tiltExcess
  calc (s ^ n)⁻¹ * ∫ x in closedBall z s, φ x ∂V.weight
      ≤ (s ^ n)⁻¹ * ∫ x in closedBall w t, φ x ∂V.weight :=
        mul_le_mul_of_nonneg_left hmono (inv_nonneg.2 (pow_nonneg hs.le n))
    _ = (t / s) ^ n * ((t ^ n)⁻¹ * ∫ x in closedBall w t, φ x ∂V.weight) := by
        rw [hscale, mul_assoc]

/-- **Reduction to a plane of small tilt and small height** (Simon Ch. 5, proof of Theorem 4.5,
steps (1), (2)).  Write `g = δ^{1/(2n+2)}`, `σ = δρ` and `K(y, r) = V.scaledLpNorm H p y r`.  The
scaling bound gives `K(0, 2σ) ≤ K(0, ρ) ≤ δ`, so affine approximation at the origin and scale `2σ`
yields a plane `T̃` with `E(0, σ, T̃) ≤ C₀ g²` and `dist(x, T̃) ≤ C₀ g σ` on `spt V ∩ B_{2σ}(0)`.
If `E(0, σ, T) > C₀ g²` we take `T' = T̃`, which does not increase `E_*`.  Otherwise `T' = T`:
integrating `|p_T − p_T̃|² ≤ 2|p_x − p_T|² + 2|p_x − p_T̃|²` against the lower mass bound
`μ_V(B_σ(0)) ≥ ω_n σⁿ/2` gives `|p_T − p_T̃| ≤ (8 C₀/ω_n)^{1/2} g`, and
`dist(x, T) ≤ dist(x, T̃) + |p_T − p_T̃| |x|` transfers the height bound to `T`. -/
theorem tdo_small_tilt_plane : AffineApproximationLemma → ∀ n ℓ : ℕ, 1 ≤ n → ∀ p : ℝ, (n : ℝ) < p → ∃ C : ℝ, 0 < C ∧ ∀ (U : Set (Amb n ℓ)), IsOpen U → ∀ (V : RectifiableVarifold n ℓ U) (H : Amb n ℓ → Amb n ℓ) (δ ρ : ℝ), 0 < δ → δ ≤ 1 / 4 → V.AllardHypotheses H p δ ρ → AEStronglyMeasurable V.tangentProj V.weight → ENNReal.ofReal (unitBallVolume n * (δ * ρ) ^ n / 2) ≤ V.weight (closedBall 0 (δ * ρ)) → ∀ T : Submodule ℝ (Amb n ℓ), Module.finrank ℝ T = n → ∃ T' : Submodule ℝ (Amb n ℓ), Module.finrank ℝ T' = n ∧ V.tiltExcessStar H p δ 0 (δ * ρ) T' ≤ V.tiltExcessStar H p δ 0 (δ * ρ) T ∧ V.tiltExcess 0 (δ * ρ) T' ≤ C * (δ ^ (1 / (2 * (n : ℝ) + 2))) ^ 2 ∧ ∀ x ∈ V.support ∩ closedBall 0 (2 * (δ * ρ)), infDist x (T' : Set (Amb n ℓ)) ≤ C * δ ^ (1 / (2 * (n : ℝ) + 2)) * (δ * ρ) := by
  intro hAff n ℓ hn p hnp
  obtain ⟨C₀, hC₀, hA⟩ := tdo_stp_origin_affine_plane hAff n ℓ hn p hnp
  -- `ω_n = π^{n/2} / Γ(n/2 + 1) > 0`.
  have hω : 0 < unitBallVolume n :=
    div_pos (Real.rpow_pos_of_pos Real.pi_pos _) (Real.Gamma_pos_of_pos (by positivity))
  set C₁ : ℝ := Real.sqrt (8 * C₀ / unitBallVolume n) with hC₁
  have hC₁0 : 0 ≤ C₁ := Real.sqrt_nonneg _
  refine ⟨C₀ + 2 * C₁, by linarith, ?_⟩
  intro U hU V H δ ρ hδ hδ4 hAH hmeas hmass T hT
  have hρ : 0 < ρ := hAH.1
  have hσ : 0 < δ * ρ := mul_pos hδ hρ
  have h2σ : 2 * (δ * ρ) ≤ ρ := by
    have := mul_le_mul_of_nonneg_right hδ4 hρ.le
    linarith
  have hp : 0 < p := (Nat.cast_nonneg n).trans_lt hnp
  -- Step (1a): `K(0, 2δρ) ≤ (2δρ/ρ)^{(p-n)/p} K(0, ρ) ≤ K(0, ρ) ≤ δ`.
  have hK2σ : V.scaledLpNorm H p 0 (2 * (δ * ρ)) ≤ ENNReal.ofReal δ := by
    have hr : (2 * (δ * ρ) / ρ) ^ ((p - n) / p) ≤ 1 :=
      Real.rpow_le_one (div_nonneg (by linarith) hρ.le) ((div_le_one hρ).2 h2σ)
        (div_nonneg (sub_nonneg.2 hnp.le) hp.le)
    calc V.scaledLpNorm H p 0 (2 * (δ * ρ))
        ≤ ENNReal.ofReal ((2 * (δ * ρ) / ρ) ^ ((p - n) / p)) * V.scaledLpNorm H p 0 ρ :=
          tdo_scaledLpNorm_bounds.1 n ℓ U V H p 0 0 (2 * (δ * ρ)) ρ hp (by linarith) h2σ
            (closedBall_subset_closedBall h2σ)
      _ ≤ V.scaledLpNorm H p 0 ρ :=
          mul_le_of_le_one_left zero_le (ENNReal.ofReal_le_one.2 hr)
      _ ≤ ENNReal.ofReal δ := hAH.2.2.2.2.2.2
  -- The plane `T̃` of affine approximation at the origin and scale `2δρ`.
  obtain ⟨T₁, hT₁, hE₁, hH₁⟩ := hA U hU V H δ ρ hδ hδ4 hAH hK2σ
  set g : ℝ := δ ^ (1 / (2 * (n : ℝ) + 2))
  have hg0 : 0 ≤ g := Real.rpow_nonneg hδ.le _
  by_cases hcase : C₀ * g ^ 2 < V.tiltExcess 0 (δ * ρ) T
  · -- Case A: replace `T` by `T̃`, which does not increase `E_*`.
    refine ⟨T₁, hT₁, ?_, hE₁.trans (mul_le_mul_of_nonneg_right (by linarith) (sq_nonneg g)),
      fun x hx => (hH₁ x hx).trans ?_⟩
    · unfold RectifiableVarifold.tiltExcessStar
      exact max_le_max (hE₁.trans hcase.le) le_rfl
    · exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (by linarith) hg0) hσ.le
  · -- Case B: keep `T` and transfer the height bound from `T̃` to `T`.
    have hET : V.tiltExcess 0 (δ * ρ) T ≤ C₀ * g ^ 2 := not_lt.1 hcase
    refine ⟨T, hT, le_rfl, hET.trans (mul_le_mul_of_nonneg_right (by linarith) (sq_nonneg g)),
      fun x hx => ?_⟩
    -- `ω_n (δρ)ⁿ/2 ≤ μ_V(B_{δρ}(0)) ≤ μ_V(B_ρ(0)) < ∞`.
    have hfin : V.weight (closedBall 0 (δ * ρ)) ≠ ⊤ :=
      ne_top_of_le_ne_top (ne_top_of_le_ne_top ENNReal.ofReal_ne_top hAH.2.2.2.2.2.1)
        (measure_mono (closedBall_subset_closedBall (by linarith)))
    have hw : unitBallVolume n * (δ * ρ) ^ n / 2 ≤ (V.weight (closedBall 0 (δ * ρ))).toReal :=
      (ENNReal.ofReal_le_iff_le_toReal hfin).1 hmass
    have hD0 : 0 ≤ hsNormSq (T.starProjection - T₁.starProjection) := by
      unfold hsNormSq
      positivity
    -- `|p_T − p_T̃|² ≤ 8 C₀ g²/ω_n`.
    have hDsq : hsNormSq (T.starProjection - T₁.starProjection) ≤
        8 * C₀ / unitBallVolume n * g ^ 2 := by
      have h1 : unitBallVolume n * (δ * ρ) ^ n / 2 *
          hsNormSq (T.starProjection - T₁.starProjection) ≤
          2 * (δ * ρ) ^ n * (C₀ * g ^ 2 + C₀ * g ^ 2) :=
        calc _ ≤ (V.weight (closedBall 0 (δ * ρ))).toReal *
              hsNormSq (T.starProjection - T₁.starProjection) :=
              mul_le_mul_of_nonneg_right hw hD0
          _ ≤ 2 * (δ * ρ) ^ n * (V.tiltExcess 0 (δ * ρ) T + V.tiltExcess 0 (δ * ρ) T₁) :=
              tdo_stp_hsNormSq_sub_le_tiltExcess n ℓ U V hmeas 0 (δ * ρ) hσ hfin T T₁
          _ ≤ 2 * (δ * ρ) ^ n * (C₀ * g ^ 2 + C₀ * g ^ 2) :=
              mul_le_mul_of_nonneg_left (add_le_add hET hE₁)
                (mul_nonneg zero_le_two (pow_pos hσ n).le)
      have h2 : unitBallVolume n * hsNormSq (T.starProjection - T₁.starProjection) ≤
          8 * C₀ * g ^ 2 :=
        le_of_mul_le_mul_right (by linarith) (pow_pos hσ n)
      rw [div_mul_eq_mul_div, le_div_iff₀ hω]
      linarith
    have hDn : hsNorm (T.starProjection - T₁.starProjection) ≤ C₁ * g :=
      calc hsNorm (T.starProjection - T₁.starProjection)
          = Real.sqrt (hsNormSq (T.starProjection - T₁.starProjection)) := rfl
        _ ≤ Real.sqrt (8 * C₀ / unitBallVolume n * g ^ 2) := Real.sqrt_le_sqrt hDsq
        _ = C₁ * g := by rw [hC₁, Real.sqrt_mul' _ (sq_nonneg g), Real.sqrt_sq hg0]
    calc infDist x (T : Set (Amb n ℓ))
        ≤ infDist x (T₁ : Set (Amb n ℓ)) + hsNorm (T.starProjection - T₁.starProjection) * ‖x‖ :=
          tdo_stp_infDist_le_infDist_add_hsNorm n ℓ T T₁ x
      _ ≤ C₀ * g * (δ * ρ) + C₁ * g * (2 * (δ * ρ)) :=
          add_le_add (hH₁ x hx)
            (mul_le_mul hDn (mem_closedBall_zero_iff.1 hx.2) (norm_nonneg x) (mul_nonneg hC₁0 hg0))
      _ = (C₀ + 2 * C₁) * g * (δ * ρ) := by ring

/-- **Simon Ch. 5, proof of Theorem 4.5, the height bound before (20)** (pp. 119–120).  Let `q` be a
linear isometry of `ℝ^{n+ℓ}`, `f` `1`-Lipschitz on `B̄ⁿ_R(0)`, `λ(x') = c + A x'`,
`τ = q(0, c)`, `S = q{(v, A v)}` and `Γ = q(graph f|B̄ⁿ_R(0))`.  If `B̄_r(τ) ⊆ B̄_R(0)`,
`θ ≤ 2` `μ_V`-a.e. on `B̄_r(τ)`, `dist(x − τ, S) ≤ h` on `spt V ∩ B̄_r(τ)` and
`μ_V(B̄_R(0) ∩ (spt V \ Γ)) ≤ β`, then
`∫_{B̄_r(τ)} dist(x − τ, S)² dμ_V ≤ 2 · 2^{n/2} ∫_{Bⁿ_r(0)} |f − λ|² dLⁿ + h² β`.
Split `B̄_r(τ)` along the compact set `Γ` (compact as `x' ↦ q(x', f x')` is `√2`-Lipschitz,
`allard52_cft_graph_map_sqrt_two`).  On `Γ`, `θ ≤ 2` turns `μ_V` into `2 Hⁿ`
(`tdo_ghe_setLIntegral_weight_le_mul`), the area bound `tdo_graph_lintegral_le` with `L = 1` gives
the factor `√2ⁿ`, and at `x = q(x', f x') ∈ B̄_r(τ)` one has `|x'| ≤ r` and
`dist(x − τ, S) ≤ |f(x') − λ(x')|` (`tdo_graph_plane_dist` (iv), (iii)); the closed ball is then
traded for the open one (`tdo_ghe_lintegral_closedBall_ofReal_eq`).  Off `Γ`, `μ_V`-a.e. point
lies in `spt V` (`tdo_ghe_ae_mem_support`), where `dist(x − τ, S)² ≤ h²`, and these points have
weight at most `β`. -/
theorem tdo_graph_height_excess : ∀ (n ℓ : ℕ) (U : Set (Amb n ℓ)) (V : RectifiableVarifold n ℓ U) (q : Amb n ℓ ≃ₗᵢ[ℝ] Amb n ℓ) (f : Rn n → Rn ℓ) (c : Rn ℓ) (A : Rn n →L[ℝ] Rn ℓ) (R r h β : ℝ), 0 < r → r ≤ R → closedBall 0 R ⊆ U → LipschitzOnWith 1 f (closedBall (0 : Rn n) R) → closedBall (q (graphPoint (0 : Rn n) c)) r ⊆ closedBall 0 R → 0 ≤ β → (∀ᵐ x ∂V.weight, x ∈ closedBall (q (graphPoint (0 : Rn n) c)) r → V.mult x ≤ 2) → (∀ x ∈ V.support ∩ closedBall (q (graphPoint (0 : Rn n) c)) r, infDist (x - q (graphPoint (0 : Rn n) c)) (Submodule.span ℝ (Set.range fun v : Rn n => q (graphPoint v (A v))) : Set (Amb n ℓ)) ≤ h) → V.weight (closedBall 0 R ∩ (V.support \ q '' graphOver f (closedBall 0 R))) ≤ ENNReal.ofReal β → ∫ x in closedBall (q (graphPoint (0 : Rn n) c)) r, infDist (x - q (graphPoint (0 : Rn n) c)) (Submodule.span ℝ (Set.range fun v : Rn n => q (graphPoint v (A v))) : Set (Amb n ℓ)) ^ 2 ∂V.weight ≤ 2 * Real.sqrt 2 ^ n * (∫ x' in ball (0 : Rn n) r, ‖f x' - (c + A x')‖ ^ 2) + h ^ 2 * β := by
  intro n ℓ U V q f c A R r h β hr hrR _hRU hf hBR hβ hθ hh hweight
  set τ : Amb n ℓ := q (graphPoint (0 : Rn n) c)
  set S : Submodule ℝ (Amb n ℓ) :=
    Submodule.span ℝ (Set.range fun v : Rn n => q (graphPoint v (A v)))
  set B : Set (Amb n ℓ) := closedBall τ r
  set Γ : Set (Amb n ℓ) := q '' graphOver f (closedBall 0 R) with hΓ
  set X : ℝ := ∫ x' in ball (0 : Rn n) r, ‖f x' - (c + A x')‖ ^ 2
  -- `d(x) = dist(x − τ, S)` is continuous, so `ofReal (d²)` is measurable
  have hd : Continuous fun x : Amb n ℓ => infDist (x - τ) (S : Set (Amb n ℓ)) :=
    (continuous_infDist_pt _).comp (continuous_id.sub continuous_const)
  have hdm : Measurable fun x : Amb n ℓ =>
      ENNReal.ofReal (infDist (x - τ) (S : Set (Amb n ℓ)) ^ 2) :=
    ENNReal.measurable_ofReal.comp (hd.pow 2).measurable
  have hBm : MeasurableSet B := measurableSet_closedBall
  -- `Γ` is the image of the compact `B̄ⁿ_R(0)` under the `√2`-Lipschitz map `x' ↦ q(x', f x')`
  have hF : ContinuousOn (fun x' => q (graphPoint x' (f x'))) (closedBall (0 : Rn n) R) := by
    have h2 := (allard52_cft_graph_map_sqrt_two n ℓ q f (closedBall 0 R) hf).1
    refine (LipschitzOnWith.of_dist_le_mul (K := (Real.sqrt 2).toNNReal)
      fun x hx y hy => ?_).continuousOn
    rw [dist_eq_norm, dist_eq_norm, Real.coe_toNNReal _ (Real.sqrt_nonneg _)]
    exact h2 x hx y hy
  have hΓm : MeasurableSet Γ := by
    have hΓF : Γ = (fun x' => q (graphPoint x' (f x'))) '' closedBall (0 : Rn n) R := by
      rw [hΓ, graphOver, Set.image_image]
    rw [hΓF]
    exact ((isCompact_closedBall _ _).image_of_continuousOn hF).isClosed.measurableSet
  have hX0 : 0 ≤ 2 * Real.sqrt 2 ^ n * X :=
    mul_nonneg (by positivity) (setIntegral_nonneg measurableSet_ball fun _ _ => sq_nonneg _)
  have hhβ : 0 ≤ h ^ 2 * β := mul_nonneg (sq_nonneg h) hβ
  -- at `x = q(x', f x') ∈ B̄_r(τ)`: `|x'| ≤ r` and `d(x) ≤ |f(x') − λ(x')|`
  have hpt : ∀ x' ∈ closedBall (0 : Rn n) R,
      B.indicator (fun x => ENNReal.ofReal (infDist (x - τ) (S : Set (Amb n ℓ)) ^ 2))
          (q (graphPoint x' (f x'))) ≤
        (closedBall (0 : Rn n) r).indicator
          (fun x' => ENNReal.ofReal (‖f x' - (c + A x')‖ ^ 2)) x' := by
    intro x' _
    obtain ⟨-, -, hdist, hnorm, -⟩ := tdo_graph_plane_dist n ℓ q A
    by_cases hx : q (graphPoint x' (f x')) ∈ B
    · have hx' : x' ∈ closedBall (0 : Rn n) r := by
        rw [mem_closedBall, dist_zero_right]
        exact (hnorm x' (f x') c).trans (by rw [← dist_eq_norm]; exact hx)
      rw [indicator_of_mem hx, indicator_of_mem hx']
      exact ENNReal.ofReal_le_ofReal (pow_le_pow_left₀ infDist_nonneg (hdist x' (f x') c) 2)
    · rw [indicator_of_notMem hx]
      exact zero_le
  -- the part on `Γ`: `θ ≤ 2`, the area bound with `L = 1`, the pointwise bound, `B̄ⁿ_r ⊆ B̄ⁿ_R`
  have hφ : ContinuousOn (fun x' => ‖f x' - (c + A x')‖ ^ 2) (closedBall (0 : Rn n) r) :=
    (((hf.continuousOn.mono (closedBall_subset_closedBall hrR)).sub
      (continuousOn_const.add A.continuous.continuousOn)).norm).pow 2
  have hon : ∫⁻ x in B ∩ Γ, ENNReal.ofReal (infDist (x - τ) (S : Set (Amb n ℓ)) ^ 2) ∂V.weight ≤
      ENNReal.ofReal (2 * Real.sqrt 2 ^ n * X) := by
    calc ∫⁻ x in B ∩ Γ, ENNReal.ofReal (infDist (x - τ) (S : Set (Amb n ℓ)) ^ 2) ∂V.weight
        ≤ ENNReal.ofReal 2 * ∫⁻ x in B ∩ Γ, ENNReal.ofReal (infDist (x - τ) (S : Set (Amb n ℓ)) ^ 2)
            ∂(μHE[n] : Measure (Amb n ℓ)) :=
          Submission.tdo_ghe_setLIntegral_weight_le_mul n ℓ U V (B ∩ Γ) 2 _ (hBm.inter hΓm) hdm
            (hθ.mono fun x hx hxE => hx hxE.1)
      _ = ENNReal.ofReal 2 * ∫⁻ x in Γ, B.indicator
            (fun x => ENNReal.ofReal (infDist (x - τ) (S : Set (Amb n ℓ)) ^ 2)) x
            ∂(μHE[n] : Measure (Amb n ℓ)) := by
          rw [setLIntegral_indicator hBm]
      _ ≤ ENNReal.ofReal 2 * (ENNReal.ofReal (Real.sqrt (1 + ((1 : ℝ≥0) : ℝ) ^ 2) ^ n) *
            ∫⁻ x' in closedBall (0 : Rn n) R, B.indicator
              (fun x => ENNReal.ofReal (infDist (x - τ) (S : Set (Amb n ℓ)) ^ 2))
              (q (graphPoint x' (f x')))) := by
          gcongr
          exact tdo_graph_lintegral_le n ℓ q f (closedBall 0 R) 1 measurableSet_closedBall hf _
            (hdm.indicator hBm)
      _ ≤ ENNReal.ofReal 2 * (ENNReal.ofReal (Real.sqrt 2 ^ n) *
            ∫⁻ x' in closedBall (0 : Rn n) r, ENNReal.ofReal (‖f x' - (c + A x')‖ ^ 2)) := by
          have h12 : Real.sqrt (1 + ((1 : ℝ≥0) : ℝ) ^ 2) = Real.sqrt 2 := by norm_num
          rw [h12]
          gcongr ENNReal.ofReal 2 * (ENNReal.ofReal (Real.sqrt 2 ^ n) * ?_)
          calc ∫⁻ x' in closedBall (0 : Rn n) R, B.indicator
                (fun x => ENNReal.ofReal (infDist (x - τ) (S : Set (Amb n ℓ)) ^ 2))
                (q (graphPoint x' (f x')))
              ≤ ∫⁻ x' in closedBall (0 : Rn n) R, (closedBall (0 : Rn n) r).indicator
                (fun x' => ENNReal.ofReal (‖f x' - (c + A x')‖ ^ 2)) x' :=
                setLIntegral_mono' measurableSet_closedBall hpt
            _ ≤ ∫⁻ x', (closedBall (0 : Rn n) r).indicator
                (fun x' => ENNReal.ofReal (‖f x' - (c + A x')‖ ^ 2)) x' :=
                setLIntegral_le_lintegral _ _
            _ = ∫⁻ x' in closedBall (0 : Rn n) r, ENNReal.ofReal (‖f x' - (c + A x')‖ ^ 2) :=
                lintegral_indicator measurableSet_closedBall _
      _ = ENNReal.ofReal (2 * Real.sqrt 2 ^ n * X) := by
          rw [Submission.tdo_ghe_lintegral_closedBall_ofReal_eq n
              (fun x' => ‖f x' - (c + A x')‖ ^ 2) r hr hφ fun _ _ => sq_nonneg _,
            ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by norm_num), mul_assoc]
  -- the part off `Γ`: `μ_V`-a.e. such point lies in `spt V ∩ B̄_r(τ)`, where `d ≤ h`
  have hae := Submission.tdo_ghe_ae_mem_support n ℓ U V
  have hoff : ∫⁻ x in B \ Γ, ENNReal.ofReal (infDist (x - τ) (S : Set (Amb n ℓ)) ^ 2) ∂V.weight ≤
      ENNReal.ofReal (h ^ 2 * β) := by
    calc ∫⁻ x in B \ Γ, ENNReal.ofReal (infDist (x - τ) (S : Set (Amb n ℓ)) ^ 2) ∂V.weight
        ≤ ∫⁻ _ in B \ Γ, ENNReal.ofReal (h ^ 2) ∂V.weight := by
          refine setLIntegral_mono_ae' (hBm.diff hΓm) ?_
          filter_upwards [hae] with x hxV hx
          exact ENNReal.ofReal_le_ofReal
            (pow_le_pow_left₀ infDist_nonneg (hh x ⟨hxV, hx.1⟩) 2)
      _ = ENNReal.ofReal (h ^ 2) * V.weight (B \ Γ) := setLIntegral_const _ _
      _ ≤ ENNReal.ofReal (h ^ 2) * ENNReal.ofReal β := by
          gcongr
          refine (measure_mono_ae ?_).trans hweight
          filter_upwards [hae] with x hxV hx
          exact ⟨hBR hx.1, hxV, hx.2⟩
      _ = ENNReal.ofReal (h ^ 2 * β) := (ENNReal.ofReal_mul (sq_nonneg h)).symm
  -- add the two parts and return to the Bochner integral
  have htot : ∫⁻ x in B, ENNReal.ofReal (infDist (x - τ) (S : Set (Amb n ℓ)) ^ 2) ∂V.weight ≤
      ENNReal.ofReal (2 * Real.sqrt 2 ^ n * X + h ^ 2 * β) := by
    rw [← lintegral_inter_add_sdiff _ B hΓm, ENNReal.ofReal_add hX0 hhβ]
    exact add_le_add hon hoff
  have hint : ∫ x in B, infDist (x - τ) (S : Set (Amb n ℓ)) ^ 2 ∂V.weight =
      (∫⁻ x in B, ENNReal.ofReal (infDist (x - τ) (S : Set (Amb n ℓ)) ^ 2) ∂V.weight).toReal :=
    integral_eq_lintegral_of_nonneg_ae (ae_of_all _ fun _ => sq_nonneg _)
      (hd.pow 2).aestronglyMeasurable
  rw [hint]
  exact ENNReal.toReal_le_of_le_ofReal (add_nonneg hX0 hhβ) htot

set_option maxHeartbeats 10000000 in
open scoped CompactlySupported in
/-- **Simon Ch. 3, 1.6–1.9 and Rem. 1.8, with the Lipschitz-graph form of Ch. 3, 1.9** for a
rectifiable varifold `V = v(M, θ)` in `U`, `μ = μ_V`: (0) the weighted approximate tangent plane
exists `μ`-a.e.; (1) `p_x = V.tangentProj x` is `μ`-a.e. the projection onto an `n`-plane; (2)
`x ↦ p_x` is `μ`-a.e. strongly measurable; (3) `Θⁿ(μ, x) = θ(x)` `μ`-a.e.; (4) on a rotated
Lipschitz graph `x = q(x', f(x'))`, `p_x` is `μ`-a.e. the projection onto
`q(graph Df(x'))` wherever `f` is differentiable.  Proof: `M` is covered, up to an `Hⁿ`-null set,
by compact Lusin pieces `K` of `θ` (Simon 1.17, proved inline) intersected with images `S = F(A)`
of bounded Borel pieces on which a Lipschitz chart `F` approximates an injective linear map
(`exists_partition_approximatesLinearOn_of_hasFDerivWithinAt`), hence is bi-Lipschitz; a rotated
Lipschitz graph `w ↦ q(w, f̃(w))` (`f̃` a Lipschitz extension of `f`) is globally bi-Lipschitz.
The injective Lipschitz area formula `Hⁿ ⌞ F(A) = F_#(J_F 𝓛ⁿ ⌞ A)`, Lebesgue points of `1_A J_F`
and the derivative of `F` give the blow-up of `Hⁿ ⌞ S` (limit `Hⁿ ⌞ DF(a)(ℝⁿ)`); the blow-up
identity `rsod_blowUp_setIntegral_eq`, the upper density theorem
`upperDensity_ne_zero_outside_hausdorff_null` (for `μ ⌞ (M \ K)`, `Hⁿ ⌞ (K \ S)`, `Hⁿ ⌞ (S \ K)`)
and continuity of `θ` on `K` give the weighted plane, unique as `θ > 0`; squeezing with cutoffs
gives the density, and `p_{range L} = L (L* L)⁻¹ L*` with a Borel inverse of `F` on `A` gives
measurability. -/
theorem ted_tangent_plane_facts : ∀ n ℓ : ℕ, 1 ≤ n → ∀ (U : Set (Amb n ℓ)), IsOpen U → ∀ V : RectifiableVarifold n ℓ U, (∀ᵐ x ∂V.weight, ∃ P : Submodule ℝ (Amb n ℓ), Poincare.SimonGMT.Chapter03.HasWeightedApproximateTangentSpaceAt n V.carrier V.mult x P) ∧ (∀ᵐ x ∂V.weight, ∃ P : Submodule ℝ (Amb n ℓ), Module.finrank ℝ P = n ∧ V.tangentProj x = P.starProjection) ∧ AEStronglyMeasurable V.tangentProj V.weight ∧ (∀ᵐ x ∂V.weight, V.HasDensity x (V.mult x)) ∧ ∀ (q : Amb n ℓ ≃ₗᵢ[ℝ] Amb n ℓ) (f : Rn n → Rn ℓ) (R : ℝ) (L : ℝ≥0), LipschitzOnWith L f (closedBall 0 R) → ∀ᵐ x ∂V.weight, ∀ x' ∈ ball (0 : Rn n) R, x = q (graphPoint x' (f x')) → DifferentiableAt ℝ f x' → V.tangentProj x = (Submodule.span ℝ (Set.range fun v : Rn n => q (graphPoint v (fderiv ℝ f x' v)))).starProjection := by
  intro n ℓ hn U hU V
  -- Simon Ch. 3, Remark 1.8(1): Lusin exhaustion of the carrier by compact pieces on which `θ`
  -- is continuous (Lusin's theorem, Simon 1.17, proved inline).
  have lusin_exhaustion : ∃ K : ℕ → Set (Amb n ℓ), (∀ m, IsCompact (K m)) ∧ (∀ m, K m ⊆ V.carrier) ∧ (∀ m, ContinuousOn V.mult (K m)) ∧ (∀ m, (μHE[n] : Measure (Amb n ℓ)) (K m) < ⊤) ∧ (μHE[n] : Measure (Amb n ℓ)) (V.carrier \ ⋃ m, K m) = 0 := by
    -- A Borel representative `f` of `θ`.
    set f : Amb n ℓ → ℝ := V.aemeasurable_mult.mk V.mult
    have hfm : Measurable f := V.aemeasurable_mult.measurable_mk
    have hfae : V.mult =ᵐ[(μHE[n] : Measure (Amb n ℓ)).restrict V.carrier] f :=
      V.aemeasurable_mult.ae_eq_mk
    -- A Borel `G ⊆ M` of full `Hⁿ`-measure in `M` on which `θ = f`.
    obtain ⟨M₁, hM₁M, hM₁m, hM₁ae⟩ := V.nullMeasurableSet_carrier.exists_measurable_subset_ae_eq
    obtain ⟨T, hTsub, hTm, hT0⟩ := exists_measurable_superset_of_null (ae_iff.1 hfae)
    rw [Measure.restrict_apply hTm] at hT0
    set G : Set (Amb n ℓ) := M₁ \ T
    have hGm : MeasurableSet G := hM₁m.diff hTm
    have hGM : G ⊆ V.carrier := sdiff_subset.trans hM₁M
    have hGf : ∀ x ∈ G, V.mult x = f x := fun x hx => by_contra fun h => hx.2 (hTsub h)
    have hMG : (μHE[n] : Measure (Amb n ℓ)) (V.carrier \ G) = 0 := by
      refine measure_mono_null (fun x hx => ?_) (measure_union_null (ae_eq_set.1 hM₁ae).2 hT0)
      by_cases hx₁ : x ∈ M₁
      · exact Or.inr ⟨by_contra fun h => hx.2 ⟨hx₁, h⟩, hx.1⟩
      · exact Or.inl ⟨hx.1, hx₁⟩
    -- Compact exhaustion `Q i` of `U`.
    set Q : ℕ → Set (Amb n ℓ) :=
      fun i => closedBall 0 (i : ℝ) ∩ {x | (i : ℝ≥0∞)⁻¹ ≤ infEDist x Uᶜ}
    have hQc : ∀ i, IsCompact (Q i) := fun i =>
      (isCompact_closedBall _ _).inter_right (isClosed_le continuous_const continuous_infEDist)
    have hQU : ∀ i, Q i ⊆ U := by
      intro i x hx
      by_contra hxU
      have h0 : (i : ℝ≥0∞)⁻¹ ≤ infEDist x Uᶜ := hx.2
      rw [infEDist_zero_of_mem (show x ∈ Uᶜ from hxU)] at h0
      exact ENNReal.inv_ne_zero.2 (ENNReal.natCast_ne_top i) (le_antisymm h0 bot_le)
    have hUQ : ∀ x ∈ U, ∃ i, x ∈ Q i := by
      intro x hx
      have h0 : infEDist x Uᶜ ≠ 0 :=
        (infEDist_pos_iff_notMem_closure.2 (by rw [hU.isClosed_compl.closure_eq]; exact fun h => h hx)).ne'
      obtain ⟨k, hk⟩ := ENNReal.exists_inv_nat_lt h0
      obtain ⟨j, hj⟩ := exists_nat_ge ‖x‖
      refine ⟨max j k, ?_, ?_⟩
      · rw [mem_closedBall, dist_zero_right]
        exact hj.trans (Nat.cast_le.2 (le_max_left j k))
      · exact (ENNReal.inv_le_inv.2 (Nat.cast_le.2 (le_max_right j k))).trans hk.le
    -- Lusin's theorem (Simon 1.17) for `f` and a finite Borel measure.
    have lusin : ∀ (ν : Measure (Amb n ℓ)), IsFiniteMeasure ν → ∀ A : Set (Amb n ℓ), MeasurableSet A →
        ∀ ε : ℝ≥0∞, ε ≠ 0 → ∃ C ⊆ A, IsClosed C ∧ ν (A \ C) < ε ∧ ContinuousOn f C := by
      intro ν hν A hA ε hε
      have : ν.WeaklyRegular := Measure.WeaklyRegular.of_pseudoMetrizableSpace_of_isFiniteMeasure ν
      obtain ⟨δ, hδpos, hδsum⟩ := ENNReal.exists_pos_sum_of_countable hε (ℚ × ℚ)
      -- For each rational interval, closed sets inside the parts of `A` where `f` is in / not in it.
      have hsplit : ∀ q : ℚ × ℚ, ∃ F ⊆ A ∩ f ⁻¹' Ioo (q.1 : ℝ) q.2, IsClosed F ∧
          ∃ F' ⊆ A \ f ⁻¹' Ioo (q.1 : ℝ) q.2, IsClosed F' ∧ ν (A \ (F ∪ F')) ≤ δ q := by
        intro q
        have hP : MeasurableSet (A ∩ f ⁻¹' Ioo (q.1 : ℝ) q.2) := hA.inter (hfm measurableSet_Ioo)
        have hN : MeasurableSet (A \ f ⁻¹' Ioo (q.1 : ℝ) q.2) := hA.diff (hfm measurableSet_Ioo)
        have hδ2 : (δ q : ℝ≥0∞) / 2 ≠ 0 :=
          (ENNReal.half_pos (ENNReal.coe_ne_zero.2 (hδpos q).ne')).ne'
        obtain ⟨F, hFP, hFc, hF⟩ := hP.exists_isClosed_sdiff_lt (measure_ne_top ν _) hδ2
        obtain ⟨F', hFN, hF'c, hF'⟩ := hN.exists_isClosed_sdiff_lt (measure_ne_top ν _) hδ2
        refine ⟨F, hFP, hFc, F', hFN, hF'c, ?_⟩
        calc ν (A \ (F ∪ F'))
            ≤ ν ((A ∩ f ⁻¹' Ioo (q.1 : ℝ) q.2) \ F ∪ (A \ f ⁻¹' Ioo (q.1 : ℝ) q.2) \ F') := by
              refine measure_mono fun x hx => ?_
              by_cases hfx : f x ∈ Ioo (q.1 : ℝ) q.2
              · exact Or.inl ⟨⟨hx.1, hfx⟩, fun h => hx.2 (Or.inl h)⟩
              · exact Or.inr ⟨⟨hx.1, hfx⟩, fun h => hx.2 (Or.inr h)⟩
          _ ≤ ν ((A ∩ f ⁻¹' Ioo (q.1 : ℝ) q.2) \ F) + ν ((A \ f ⁻¹' Ioo (q.1 : ℝ) q.2) \ F') :=
              measure_union_le _ _
          _ ≤ δ q / 2 + δ q / 2 := add_le_add hF.le hF'.le
          _ = δ q := ENNReal.add_halves _
      choose F hFP hFc F' hFN hF'c hFF' using hsplit
      refine ⟨⋂ q, (F q ∪ F' q), fun x hx => ?_, isClosed_iInter fun q => (hFc q).union (hF'c q),
        ?_, ?_⟩
      · rcases mem_iInter.1 hx (0, 0) with h | h
        · exact (hFP _ h).1
        · exact (hFN _ h).1
      · rw [sdiff_iInter]
        calc ν (⋃ q, A \ (F q ∪ F' q)) ≤ ∑' q, ν (A \ (F q ∪ F' q)) := measure_iUnion_le _
          _ ≤ ∑' q, (δ q : ℝ≥0∞) := ENNReal.tsum_le_tsum hFF'
          _ < ε := hδsum
      · rw [Metric.continuousOn_iff]
        intro x hx e he
        obtain ⟨a, ha₁, ha₂⟩ := exists_rat_btwn (show f x - e < f x by linarith)
        obtain ⟨b, hb₁, hb₂⟩ := exists_rat_btwn (show f x < f x + e by linarith)
        have hxF' : x ∉ F' (a, b) := fun h => (hFN _ h).2 ⟨ha₂, hb₁⟩
        obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.1 (hF'c (a, b)).isOpen_compl x hxF'
        refine ⟨r, hr, fun y hy hyx => ?_⟩
        have hyF : y ∈ F (a, b) := by
          rcases mem_iInter.1 hy (a, b) with h | h
          · exact h
          · exact absurd h (hball (mem_ball.2 hyx))
        obtain ⟨hy₁, hy₂⟩ := (hFP _ hyF).2
        rw [Real.dist_eq, abs_sub_lt_iff]
        constructor <;> linarith
    -- The Borel pieces `B i k` have finite `Hⁿ`-measure.
    set B : ℕ → ℕ → Set (Amb n ℓ) := fun i k => G ∩ Q i ∩ {x | 1 / ((k : ℝ) + 1) < f x}
    have hBm : ∀ i k, MeasurableSet (B i k) := fun i k =>
      (hGm.inter (hQc i).isClosed.measurableSet).inter (measurableSet_lt measurable_const hfm)
    have hBfin : ∀ i k, (μHE[n] : Measure (Amb n ℓ)) (B i k) < ⊤ := by
      intro i k
      have hc : (0 : ℝ) < 1 / ((k : ℝ) + 1) := by positivity
      have hint : ∫⁻ x in V.carrier ∩ Q i, ENNReal.ofReal (V.mult x) ∂(μHE[n] : Measure (Amb n ℓ)) < ⊤ :=
        Integrable.lintegral_lt_top (V.integrableOn_mult (Q i) (hQc i) (hQU i))
      have hle : ENNReal.ofReal (1 / ((k : ℝ) + 1)) * (μHE[n] : Measure (Amb n ℓ)) (B i k) ≤
          ∫⁻ x in V.carrier ∩ Q i, ENNReal.ofReal (V.mult x) ∂(μHE[n] : Measure (Amb n ℓ)) :=
        calc ENNReal.ofReal (1 / ((k : ℝ) + 1)) * (μHE[n] : Measure (Amb n ℓ)) (B i k)
            = ∫⁻ _ in B i k, ENNReal.ofReal (1 / ((k : ℝ) + 1)) ∂(μHE[n] : Measure (Amb n ℓ)) :=
              (setLIntegral_const _ _).symm
          _ ≤ ∫⁻ x in B i k, ENNReal.ofReal (V.mult x) ∂(μHE[n] : Measure (Amb n ℓ)) :=
              setLIntegral_mono' (hBm i k) fun x hx =>
                ENNReal.ofReal_le_ofReal (by rw [hGf x hx.1.1]; exact hx.2.le)
          _ ≤ ∫⁻ x in V.carrier ∩ Q i, ENNReal.ofReal (V.mult x) ∂(μHE[n] : Measure (Amb n ℓ)) :=
              lintegral_mono_set fun x hx => ⟨hGM hx.1.1, hx.1.2⟩
      exact ENNReal.lt_top_of_mul_ne_top_right (hle.trans_lt hint).ne (ENNReal.ofReal_pos.2 hc).ne'
    -- Lusin pieces `C i k m ⊆ B i k`.
    have hC : ∀ i k m : ℕ, ∃ C ⊆ B i k, IsClosed C ∧
        (μHE[n] : Measure (Amb n ℓ)) (B i k \ C) < (m : ℝ≥0∞)⁻¹ ∧ ContinuousOn f C := by
      intro i k m
      obtain ⟨C, hCB, hCc, hCμ, hCf⟩ := lusin ((μHE[n] : Measure (Amb n ℓ)).restrict (B i k))
        (isFiniteMeasure_restrict.2 (hBfin i k).ne) (B i k) (hBm i k) (m : ℝ≥0∞)⁻¹
        (ENNReal.inv_ne_zero.2 (ENNReal.natCast_ne_top m))
      refine ⟨C, hCB, hCc, ?_, hCf⟩
      rwa [Measure.restrict_apply ((hBm i k).diff hCc.measurableSet),
        inter_eq_left.2 sdiff_subset] at hCμ
    choose C hCB hCc hCμ hCf using hC
    have hBnull : ∀ i k, (μHE[n] : Measure (Amb n ℓ)) (B i k \ ⋃ m, C i k m) = 0 := by
      intro i k
      by_contra h
      obtain ⟨m, hm⟩ := ENNReal.exists_inv_nat_lt h
      exact lt_asymm hm ((measure_mono (sdiff_subset_sdiff_right (subset_iUnion _ m))).trans_lt
        (hCμ i k m))
    -- Enumerate the pieces.
    refine ⟨fun j => C (Nat.unpair j).1 (Nat.unpair (Nat.unpair j).2).1
      (Nat.unpair (Nat.unpair j).2).2, fun j => ?_, fun j => ?_, fun j => ?_, fun j => ?_, ?_⟩
    · exact (hQc _).of_isClosed_subset (hCc _ _ _) ((hCB _ _ _).trans fun x hx => hx.1.2)
    · exact (hCB _ _ _).trans fun x hx => hGM hx.1.1
    · exact (hCf _ _ _).congr fun x hx => hGf x (hCB _ _ _ hx).1.1
    · exact (measure_mono (hCB _ _ _)).trans_lt (hBfin _ _)
    · refine measure_mono_null (fun x hx => ?_) (measure_union_null hMG
        (measure_iUnion_null fun i => measure_iUnion_null fun k => hBnull i k))
      by_cases hxG : x ∈ G
      · obtain ⟨i, hi⟩ := hUQ x (V.carrier_subset hx.1)
        have hfx : 0 < f x := by rw [← hGf x hxG]; exact V.mult_pos x hx.1
        obtain ⟨k, hk⟩ := exists_nat_one_div_lt hfx
        refine Or.inr (mem_iUnion₂.2 ⟨i, k, ⟨⟨hxG, hi⟩, hk⟩, fun hxC => ?_⟩)
        obtain ⟨m, hm⟩ := mem_iUnion.1 hxC
        refine hx.2 (mem_iUnion.2 ⟨Nat.pair i (Nat.pair k m), ?_⟩)
        simpa only [Nat.unpair_pair] using hm
      · exact Or.inl ⟨hx.1, hxG⟩
  have area_measure_eq : ∀ (F : Rn n → Amb n ℓ) {K : ℝ≥0} (hF : LipschitzWith K F) (A : Set (Rn n)) (hA : MeasurableSet A) (hinj : InjOn F A),
      (μHE[n] : Measure (Amb n ℓ)).restrict (F '' A) = ((volume.restrict A).withDensity (fun b => ((Poincare.SimonGMT.Chapter02.areaJacobianAt F b).toNNReal : ℝ≥0∞))).map F := by
    intro F K hF A hA hinj
    ext B hB
    have hFB : MeasurableSet (F ⁻¹' B) := hF.continuous.measurable hB
    rw [Measure.restrict_apply hB, Measure.map_apply hF.continuous.measurable hB,
      withDensity_apply _ hFB]
    have h := Poincare.SimonGMT.Chapter02.weighted_area_formula_lipschitz_injOn hF hA hinj
      (B.indicator 1)
    rw [finrank_euclideanSpace_fin] at h
    rw [lintegral_indicator_one hB, Measure.restrict_apply hB] at h
    rw [h, ← lintegral_indicator hFB]
    refine lintegral_congr fun b => ?_
    by_cases hb : F b ∈ B
    · simp [hb, ENNReal.ofReal]
    · simp [hb]
  have linear_area_measure_eq : ∀ (L : Rn n →L[ℝ] Amb n ℓ),
      (μHE[n] : Measure (Amb n ℓ)).restrict (Set.range L) = (ENNReal.ofReal (L : Rn n →ₗ[ℝ] Amb n ℓ).normDet • (volume : Measure (Rn n))).map L := by
    intro L
    ext B hB
    have hLB : MeasurableSet (L ⁻¹' B) := L.continuous.measurable hB
    rw [Measure.restrict_apply hB, Measure.map_apply L.continuous.measurable hB,
      Measure.smul_apply, smul_eq_mul]
    have h := LinearMap.euclideanHausdorffMeasure_image_eq_normDet_mul_volume
      (L : Rn n →ₗ[ℝ] Amb n ℓ) (L ⁻¹' B)
    rw [finrank_euclideanSpace_fin] at h
    rw [← h]
    congr 1
    ext y
    simp only [mem_inter_iff, mem_range, mem_image, mem_preimage, ContinuousLinearMap.coe_coe]
    constructor
    · rintro ⟨hy, c, rfl⟩
      exact ⟨c, hy, rfl⟩
    · rintro ⟨c, hc, rfl⟩
      exact ⟨hc, c, rfl⟩
  have blowup_area_tendsto : ∀ (F : Rn n → Amb n ℓ) {K : ℝ≥0} (hF : LipschitzWith K F) (A : Set (Rn n)) (hA : MeasurableSet A) {lam : ℝ} (hlam : 0 < lam) (hbi : ∀ a ∈ A, ∀ b ∈ A, lam * ‖a - b‖ ≤ ‖F a - F b‖) (hgint : ∀ (c : Rn n) (t : ℝ), IntegrableOn (A.indicator (Poincare.SimonGMT.Chapter02.areaJacobianAt F)) (closedBall c t) volume) {a : Rn n} (ha : a ∈ A) (hdiff : DifferentiableAt ℝ F a) (hLinj : Function.Injective (fderiv ℝ F a)) (hleb : ∀ ρ : ℝ, 0 < ρ → Tendsto (fun r : ℝ => (r ^ n)⁻¹ * ∫ y in closedBall a (ρ * r), ‖A.indicator (Poincare.SimonGMT.Chapter02.areaJacobianAt F) y - A.indicator (Poincare.SimonGMT.Chapter02.areaJacobianAt F) a‖) (𝓝[>] 0) (𝓝 0)) (f : Amb n ℓ → ℝ) (hfc : Continuous f) (hfs : HasCompactSupport f),
      Tendsto (fun r : ℝ => (r ^ n)⁻¹ * ∫ z in F '' A, f (Poincare.SimonGMT.Chapter03.blowUpMap (F a) r z) ∂(μHE[n] : Measure (Amb n ℓ))) (𝓝[>] 0) (𝓝 (∫ y in Set.range (fderiv ℝ F a), f y ∂(μHE[n] : Measure (Amb n ℓ)))) := by
    intro F K hF A hA lam hlam hbi hgint a ha hdiff hLinj hleb f hfc hfs
    set J := Poincare.SimonGMT.Chapter02.areaJacobianAt F with hJ
    set g : Rn n → ℝ := A.indicator J with hg
    set L := fderiv ℝ F a with hL
    have hη : ∀ (x : Amb n ℓ) (r : ℝ) (y : Amb n ℓ),
        Poincare.SimonGMT.Chapter03.blowUpMap x r y = r⁻¹ • (y - x) := fun _ _ _ => rfl
    have hinj : InjOn F A := fun b hb c hc h => by
      have h1 := hbi b hb c hc
      rw [h, sub_self, norm_zero] at h1
      have h2 : ‖b - c‖ ≤ 0 := by nlinarith [norm_nonneg (b - c)]
      exact sub_eq_zero.1 (norm_le_zero_iff.1 h2)
    have hJm : Measurable J := Poincare.SimonGMT.Chapter02.measurable_areaJacobianAt F
    have hJnn : ∀ b, 0 ≤ J b := Poincare.SimonGMT.Chapter02.areaJacobianAt_nonneg F
    set Ja : ℝ := J a with hJa
    have hJa_nn : 0 ≤ Ja := hJnn a
    have hga : g a = Ja := by rw [hg, Set.indicator_of_mem ha]
    -- Step 1: the blown-up area integral as an integral over the parameter space
    have hLHS : ∀ r : ℝ, ∫ z in F '' A, f (Poincare.SimonGMT.Chapter03.blowUpMap (F a) r z)
        ∂(μHE[n] : Measure (Amb n ℓ)) = ∫ b, g b * f (r⁻¹ • (F b - F a)) := by
      intro r
      rw [area_measure_eq F hF A hA hinj, integral_map hF.continuous.aemeasurable
        (by simp only [hη]; fun_prop : Continuous fun z =>
          f (Poincare.SimonGMT.Chapter03.blowUpMap (F a) r z)).aestronglyMeasurable,
        integral_withDensity_eq_integral_smul hJm.real_toNNReal, ← integral_indicator hA]
      congr 1
      ext b
      by_cases hb : b ∈ A
      · simp only [Set.indicator_of_mem hb, hg, hη, NNReal.smul_def, smul_eq_mul,
          Real.coe_toNNReal _ (hJnn b)]
      · simp [Set.indicator_of_notMem hb, hg]
    -- Step 2: the plane integral
    have hJL : (L : Rn n →ₗ[ℝ] Amb n ℓ).normDet = Ja := rfl
    have hRHS : ∫ y in Set.range L, f y ∂(μHE[n] : Measure (Amb n ℓ)) = Ja * ∫ c, f (L c) := by
      rw [linear_area_measure_eq L, integral_map L.continuous.aemeasurable
        hfc.aestronglyMeasurable, integral_smul_measure, hJL, ENNReal.toReal_ofReal hJa_nn,
        smul_eq_mul]
    have hscale : ∀ r : ℝ, 0 < r →
        ∫ c, f (L c) = (r ^ n)⁻¹ * ∫ b, f (r⁻¹ • L (b - a)) := by
      intro r hr
      have h1 : ∫ b, f (r⁻¹ • L (b - a)) = ∫ c, f (L (r⁻¹ • c)) := by
        have := integral_sub_right_eq_self (μ := (volume : Measure (Rn n)))
          (fun c => f (L (r⁻¹ • c))) a
        simpa only [map_smul] using this
      rw [h1, Measure.integral_comp_smul (volume : Measure (Rn n)) (fun c => f (L c)) r⁻¹,
        finrank_euclideanSpace_fin, inv_pow, inv_inv, abs_of_pos (pow_pos hr n), smul_eq_mul,
        ← mul_assoc, inv_mul_cancel₀ (pow_pos hr n).ne', one_mul]
    -- bounds for `f`
    obtain ⟨Cf, hCf⟩ := hfc.bounded_above_of_compact_support hfs
    have hCf0 : 0 ≤ Cf := (norm_nonneg _).trans (hCf 0)
    obtain ⟨R, hR0, hR⟩ : ∃ R : ℝ, 0 < R ∧ ∀ y, R < ‖y‖ → f y = 0 := by
      obtain ⟨R₀, hR₀⟩ := hfs.isCompact.isBounded.subset_closedBall 0
      refine ⟨max R₀ 1, lt_of_lt_of_le one_pos (le_max_right _ _), fun y hy => ?_⟩
      apply image_eq_zero_of_notMem_tsupport
      intro hyt
      have h1 := hR₀ hyt
      rw [mem_closedBall, dist_zero_right] at h1
      linarith [le_max_left R₀ 1]
    -- a lower bound for the injective derivative
    obtain ⟨KL, hKLpos, hKL⟩ :=
      (LinearMap.injective_iff_antilipschitz (L : Rn n →ₗ[ℝ] Amb n ℓ)).1 hLinj
    set lamL : ℝ := ((KL : ℝ))⁻¹ with hlamL_def
    have hKL0 : (0 : ℝ) < KL := by exact_mod_cast hKLpos
    have hlamL : 0 < lamL := inv_pos.2 hKL0
    have hLlow : ∀ v, lamL * ‖v‖ ≤ ‖L v‖ := by
      intro v
      have h1 := hKL.le_mul_dist v 0
      simp only [dist_zero_right, map_zero, ContinuousLinearMap.coe_coe] at h1
      rw [hlamL_def, inv_mul_le_iff₀ hKL0]
      exact h1
    set ρ : ℝ := (R + 1) / lam + (R + 1) / lamL with hρ_def
    have hρ : 0 < ρ := by positivity
    -- outside `B_{ρ r}(a)` both integrands vanish
    have hsupp1 : ∀ r : ℝ, 0 < r → ∀ b, b ∉ closedBall a (ρ * r) →
