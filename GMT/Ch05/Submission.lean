  have hf0 : f 0 = 0 := by
    have h0in : (0 : Amb n ℓ) ∈ V.support ∩ closedBall 0 R₂ := ⟨h0spt, mem_closedBall_self hR₂0.le⟩
    rw [hgraph] at h0in
