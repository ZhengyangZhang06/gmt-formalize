              hx1 (by have := h.1; rwa [mem_closedBall, dist_zero_right] at this)
            rw [if_neg hxσ, if_neg hxσ, if_neg hx1, if_neg hx1, indicator_of_notMem hxA]
            ring
      have hq_int : ∫ x, q x * (Li x - n * Fi x) ∂V.weight =
