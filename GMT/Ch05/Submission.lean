    intro ξ hξ
    have hξn : ‖ξ‖ ≤ δ₀ * ρ / 2 := mem_closedBall_zero_iff.1 hξ.2
    unfold RectifiableVarifold.tiltExcess
    have hsub : closedBall ξ (δ₀ * ρ / 2) ⊆ closedBall 0 (δ₀ * ρ) := hball_sub ξ _ _ (by linarith)
    have hint := htilt_int Tst (closedBall 0 (δ₀ * ρ))
