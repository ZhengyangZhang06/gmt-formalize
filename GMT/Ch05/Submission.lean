          ring
        · by_cases hx1 : ‖x‖ ≤ 1
          · have hx0 : 0 < ‖x‖ := lt_trans hσ (not_le.1 hxσ)
            have hxA : x ∈ closedBall (0 : Amb n ℓ) 1 \ closedBall 0 σ :=
