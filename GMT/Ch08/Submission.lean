  have GPx : ∀ (E F : Type) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
      [NormedAddCommGroup F] [InnerProductSpace ℝ F] [FiniteDimensional ℝ F]
      (NJ : (E →L[ℝ] F) → ℝ) (φ : E → F) (ζ : E → ℝ) (u v : E) (Y : E → E)
