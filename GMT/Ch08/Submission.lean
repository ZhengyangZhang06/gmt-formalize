      apply hy
      simp only [hg₀def]
      rw [hψzero _ h, zero_mul]
    · by_contra h
      push Not at h
      apply hy
      simp only [hg₀def]
      rw [hχzero _ h, mul_zero]
  have hg₀ball : ∀ y, g₀ y ≠ 0 → y ∈ closedBall (0 : Euclidean N) 2 := by
    intro y hy
    obtain ⟨h1, h2⟩ := hg₀supp y hy
    rw [mem_closedBall, dist_zero_right]
    calc ‖y‖ = ‖p y + (y - p y)‖ := by congr 1; abel
