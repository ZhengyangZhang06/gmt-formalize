    simp only [hg₀def, hpa, sub_self, norm_zero, hχzero', mul_one]
  -- Step 5: `∫ g₀ dμ_{W_k} → θ₀ ∫_P g₀ dH^n = θ₀ I₀`.
  have hlim := Submission.intcpt_fli_weight_integral_tendsto N n P θ₀ W hconv g₀ hg₀cont hg₀cs
    hg₀sub5
