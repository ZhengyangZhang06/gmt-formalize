      rw [this]
      congr 1
      rw [hc, ← Matrix.det_transpose]
      congr 1
      ext i j
      simp [real_inner_comm]
    obtain ⟨α₀, hα₀, -⟩ := Submission.unit_orientations_common_unit_covector P n Q Ξ Ξ
