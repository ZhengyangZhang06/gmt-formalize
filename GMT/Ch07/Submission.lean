    -- **null sets have null slices** (Eilenberg's inequality for `p`, `Hⁿ`-null case)
    have hT4 : ∀ Z : Set F, μHE[n] Z = 0 → ∀ᵐ t ∂(μHE[d].restrict (L : Set F)),
