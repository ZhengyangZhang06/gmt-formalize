      rw [← real_inner_self_eq_norm_sq, hpars _ (hDW a)]
      refine Finset.sum_congr rfl fun d _ => ?_
      rw [hH, real_inner_comm (D (τ a : Euclid P)) (τ d : Euclid P)]
