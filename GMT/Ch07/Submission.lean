        simp only [hζ, ContinuousLinearMap.comp_apply]
        rw [hcb, hlift β g hfg, one_mul]
      · right; intro β
        simp only [hζ, ContinuousLinearMap.comp_apply]
        rw [hcb, hlift β g hfg, neg_one_mul]
    · simp only [hζ, ContinuousLinearMap.comp_apply]
      rw [hcb, hcb, hlift (flat α) g hfg, hflat α g]
