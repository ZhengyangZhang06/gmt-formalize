          LinearMap.range ((L p : E →L[ℝ] Pz) : E →ₗ[ℝ] Pz) := by
        have hset : (LinearMap.range ((L p : E →L[ℝ] Pz) : E →ₗ[ℝ] Pz) : Set Pz) =
            Set.range (L p) := by
          rw [LinearMap.coe_range, ContinuousLinearMap.coe_coe]
