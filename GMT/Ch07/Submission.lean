    Submission.cmc_fc_extend_to_univ hIMC.2.1 hMR P d U (closedBall x₀ r) R' hU
      (isCompact_closedBall x₀ r) hrU hR'im hR'spt
  -- `spt Y = ℝ^P ∖ Z(Y)` is closed and lies in the compact `B̄_r(x₀)`
  have hYcpt : IsCompact Y.support := by
