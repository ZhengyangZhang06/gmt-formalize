        have e : Gs j x - Fs j x = (Gs j x - G x) + (G x - F x) + (F x - Fs j x) := by abel
        rw [e]
        have n1 := norm_add_le (Gs j x - G x + (G x - F x)) (F x - Fs j x)
        have n2 := norm_add_le (Gs j x - G x) (G x - F x)
        linarith
      have ht1 : |t| ≤ 1 := abs_le.mpr ⟨by linarith [ht.1], ht.2⟩
