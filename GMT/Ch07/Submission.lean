        _ = ε * ‖x - a‖ := by ring
  -- `Dg` is continuous at the points of `A`
  have hgcont : ∀ a ∈ A, ContinuousAt (fderiv ℝ g) a := by
    intro a ha
    apply Metric.continuousAt_iff.mpr
    intro ε hε
    obtain ⟨η, hη_def⟩ : ∃ η : ℝ, η = ε / (2 * (1 + 700 * M)) := ⟨_, rfl⟩
    have hη : 0 < η := by rw [hη_def]; positivity
    have heq : η * (1 + 700 * M) = ε / 2 := by rw [hη_def]; field_simp
    have hηε : η ≤ ε / 2 := by nlinarith [mul_pos hη hM]
    obtain ⟨δ, hδ, hδ1, hDδ, hremδ⟩ := hloc a ha η hη
    refine ⟨δ / 4, by positivity, fun {x} hxa => ?_⟩
    rw [(hgd a ha).fderiv, dist_eq_norm]
    apply lt_of_le_of_lt (b := ε / 2) ?_ (by linarith)
    by_cases hxA : x ∈ A
    · rw [(hgd x hxA).fderiv]
      exact (hDδ x hxA (by linarith)).trans hηε
    · have hrx := hrpos x hxA
      have hxx : dist x x < r x := by simpa using hrx
      have hbA := hprA x
      have hbaδ : dist (pr x) a < δ := by
        linarith [hpr2 x a ha, dist_nonneg (x := x) (y := a)]
      have hDb := hDδ (pr x) hbA hbaδ
      have hdx : infDist x A ≤ 1 := by
        have hi := infDist_le_dist_of_mem (x := x) ha
        linarith
      have hscale : infDist x A = 100 * r x := by
        rw [hr x, min_eq_right hdx]
        ring
      have hD' : ∀ c ∈ F x, ‖D (pr c) - D a‖ ≤ η := by
        intro c hc
        apply hDδ _ (hprA c)
        have hi := hanc2 x hxA a ha c hc
        linarith [dist_nonneg (x := x) (y := a)]
      have hP' : ∀ c ∈ F x, ‖P (pr c) x - P (pr x) x‖ ≤ 700 * η * r x := by
        intro c hc
        have hdA := hprA (c : Euclid n)
        have hda := hanc2 x hxA a ha c hc
        have hdaδ : dist (pr c) a < δ := by linarith [dist_nonneg (x := x) (y := a)]
        have hxd := hanc1 x hxA c hc
        have hxb : dist x (pr x) = infDist x A := (hprd x).symm
        have hdb : dist (pr c) (pr x) ≤ 3 * infDist x A := by
          have ht := dist_triangle (pr c) x (pr x)
          rw [dist_comm (pr c) x, hxb] at ht
          linarith
        have hDd : ‖D (pr c) - D (pr x)‖ ≤ 2 * η := by
          calc ‖D (pr c) - D (pr x)‖ = ‖(D (pr c) - D a) - (D (pr x) - D a)‖ := by
                congr 1; abel
            _ ≤ ‖D (pr c) - D a‖ + ‖D (pr x) - D a‖ := norm_sub_le _ _
            _ ≤ η + η := add_le_add (hD' c hc) hDb
            _ = 2 * η := by ring
        have hre := hremδ (pr x) hbA hbaδ (pr c) hdA hdaδ
        have hdb' : ‖pr c - pr x‖ ≤ 3 * infDist x A := by
          simpa only [dist_eq_norm] using hdb
        have hxd' : ‖x - pr c‖ ≤ 2 * infDist x A := by simpa only [dist_eq_norm] using hxd
        calc ‖P (pr c) x - P (pr x) x‖
            ≤ ‖h (pr c) - h (pr x) - D (pr x) (pr c - pr x)‖ +
                ‖D (pr c) - D (pr x)‖ * ‖x - pr c‖ := hPsub (pr x) (pr c) x
          _ ≤ η * ‖pr c - pr x‖ + (2 * η) * ‖x - pr c‖ :=
              add_le_add hre (mul_le_mul_of_nonneg_right hDd (norm_nonneg _))
          _ ≤ η * (3 * infDist x A) + (2 * η) * (2 * infDist x A) :=
              add_le_add (mul_le_mul_of_nonneg_left hdb' hη.le)
                (mul_le_mul_of_nonneg_left hxd' (by positivity))
          _ = 700 * η * r x := by rw [hscale]; ring
      have hsplit : fderiv ℝ g x - D a = (∑ c ∈ F x, w c x • (D (pr c) - D a)) +
          ∑ c ∈ F x, (P (pr c) x - P (pr x) x) • fderiv ℝ (w c) x := by
        rw [hgfd x hxA]
        simp_rw [smul_sub, sub_smul]
        rw [Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_sub_distrib,
          ← Finset.sum_smul, ← Finset.smul_sum, hwsum x hxA x hxx, hwdsum x hxA,
          one_smul, smul_zero, sub_zero]
        abel
      rw [hsplit]
      calc ‖(∑ c ∈ F x, w c x • (D (pr c) - D a)) +
            ∑ c ∈ F x, (P (pr c) x - P (pr x) x) • fderiv ℝ (w c) x‖
          ≤ ‖∑ c ∈ F x, w c x • (D (pr c) - D a)‖ +
              ‖∑ c ∈ F x, (P (pr c) x - P (pr x) x) • fderiv ℝ (w c) x‖ := norm_add_le _ _
        _ ≤ η + (700 * η * r x) * ∑ c ∈ F x, ‖fderiv ℝ (w c) x‖ := by
            apply add_le_add
            · exact hconv (F x) (fun c => w c x) (fun c => D (pr c) - D a) η
                (fun c _ => hw0 c x hxA) (hwsum x hxA x hxx) hD'
            · calc ‖∑ c ∈ F x, (P (pr c) x - P (pr x) x) • fderiv ℝ (w c) x‖
                  ≤ ∑ c ∈ F x, ‖(P (pr c) x - P (pr x) x) • fderiv ℝ (w c) x‖ :=
                    norm_sum_le _ _
                _ ≤ ∑ c ∈ F x, (700 * η * r x) * ‖fderiv ℝ (w c) x‖ := by
                    apply Finset.sum_le_sum
                    intro c hc
                    rw [norm_smul]
                    exact mul_le_mul_of_nonneg_right (hP' c hc) (norm_nonneg _)
                _ = (700 * η * r x) * ∑ c ∈ F x, ‖fderiv ℝ (w c) x‖ :=
                    (Finset.mul_sum ..).symm
        _ ≤ η + (700 * η * r x) * (M / r x) :=
            add_le_add le_rfl (mul_le_mul_of_nonneg_left (hMb x hxA) (by positivity))
        _ = η * (1 + 700 * M) := by field_simp
        _ = ε / 2 := heq
  refine ⟨g, ?_, fun a ha => hgA a ha, hgd⟩
  refine contDiff_one_iff_fderiv.mpr ⟨fun x => ?_, continuous_iff_continuousAt.mpr fun x => ?_⟩
  · by_cases hx : x ∈ A
    · exact (hgd x hx).differentiableAt
    · exact (hgc x hx).differentiableAt one_ne_zero
  · by_cases hx : x ∈ A
    · exact hgcont x hx
    · exact (hgc x hx).continuousAt_fderiv one_ne_zero
/-- **Test form of the chart perimeter estimate** (Simon 7.5; the forms of Simon Ch. 6, 2.35
transported to the graph chart `G(v) = x + ιv + u(v)`).  With `π(w) = ι*(w − x)`,
`p^⊥(w) = w − x − ιπ(w)` and the cut-off `ζ = χ(|p^⊥|²)`, `χ` smooth, `χ = 1` on
`[0, (δ₂/2)²]`, `χ = 0` on `[(3δ₂/4)², ∞)`, the form `ω(w) = Λ(ζ(w)φ(π(w)))`,
`Λ(p)(a) = det[p, ι*a₀, …, ι*aₙ₋₁]`, is supported in `{π ∈ spt φ, |p^⊥| ≤ 3δ₂/4} ⊆ Z` and has
coefficient norm `≤ (n+1)! √(Pⁿ)`.  On `B_{δ₁}(0)`, `π ∘ G = id`, `p^⊥ ∘ G = u` (so `ζ ∘ G = 1`)
and `ι* ∘ DG = id`, so the `j`-th coefficient of the pull-back is
`(−1)ʲ det[φ(v), e_{j.succAbove 0}, …, e_{j.succAbove (n−1)}] = (−1)ʲ (−1)ʲ φⱼ(v) = φⱼ(v)`. -/
theorem Submission.codim1_lur_chart_test_form_exists : ∀ (P n : ℕ) (U : Set (Euclid P)) (x : Euclid P) (ι : Euclid (n + 1) →ₗᵢ[ℝ] Euclid P) (u : Euclid (n + 1) → Euclid P) (δ₁ δ₂ : ℝ) (φ : Euclid (n + 1) → Euclid (n + 1)), 0 < δ₂ → closedBall x (δ₁ + δ₂) ⊆ U → DifferentiableOn ℝ u (ball 0 δ₁) → (∀ v ∈ ball (0 : Euclid (n + 1)) δ₁, ∀ w : Euclid (n + 1), inner ℝ (ι w) (u v) = 0) → (∀ v ∈ ball (0 : Euclid (n + 1)) δ₁, ‖u v‖ < δ₂ / 2) → ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ → tsupport φ ⊆ ball 0 δ₁ → (∀ y, ‖φ y‖ ≤ 1) → ∃ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ {w : Euclid P | ‖ContinuousLinearMap.adjoint ι.toContinuousLinearMap (w - x)‖ < δ₁ ∧ ‖w - x - ι (ContinuousLinearMap.adjoint ι.toContinuousLinearMap (w - x))‖ < δ₂} ∧ tsupport (ω : DifferentialForm (Euclid P) n) ⊆ closedBall x (δ₁ + δ₂) ∧ (∀ w, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) w) ≤ ((n + 1).factorial : ℝ) * Real.sqrt ((P : ℝ) ^ n)) ∧ φ = (ball (0 : Euclid (n + 1)) δ₁).indicator (fun v => ∑ j : Fin (n + 1), ((-1 : ℝ) ^ (j : ℕ) * (ω : DifferentialForm (Euclid P) n) (x + ι v + u v) (fun k => fderiv ℝ (fun y => x + ι y + u y) v (EuclideanSpace.single (j.succAbove k) 1))) • EuclideanSpace.single j (1 : ℝ)) := by
  intro P n U x ι u δ₁ δ₂ φ hδ₂ hball hu horth hsmall hφ hφc hφD hφ1
  -- `‖ι*‖ ≤ 1`; on `B_{δ₁}(0)`: `π(G(v)) = v`, `p^⊥(G(v)) = u(v)`, `ι*(DG(v)y) = y`
  obtain ⟨hA, -, hG⟩ := Submission.codim1_lur_graph_chart_adjoint_identities P n x ι u δ₁ hu horth
  set A := ContinuousLinearMap.adjoint ι.toContinuousLinearMap
  -- `Λ(p)(a) = det[p, Aa₀, …, Aaₙ₋₁]`, continuous linear in `p`
  obtain ⟨Λ, hΛ⟩ := Submission.codim1_lur_det_covector_clm P n A
  -- the chart projections `π(w) = ι*(w − x)` and `p^⊥(w) = w − x − ιπ(w)`
  set π : Euclid P → Euclid (n + 1) := fun w => A (w - x) with hπdef
  set q : Euclid P → Euclid P := fun w => w - x - ι (A (w - x)) with hqdef
  have hπc : ContDiff ℝ (⊤ : ℕ∞) π := A.contDiff.comp (contDiff_id.sub contDiff_const)
  have hqc : ContDiff ℝ (⊤ : ℕ∞) q :=
    (contDiff_id.sub contDiff_const).sub (ι.toContinuousLinearMap.contDiff.comp hπc)
  have hdecomp : ∀ w, ‖w - x‖ ≤ ‖π w‖ + ‖q w‖ := by
    intro w
    have : w - x = ι (π w) + q w := by simp only [hπdef, hqdef]; abel
    rw [this]
    exact (norm_add_le _ _).trans (by rw [ι.norm_map])
  -- the cut-off `ζ(w) = χ(|p^⊥(w)|²)`, `χ = 1` on `[0, (δ₂/2)²]`, `χ = 0` on `[(3δ₂/4)², ∞)`
  set a : ℝ := (δ₂ / 2) ^ 2 with ha
  set b : ℝ := (3 * δ₂ / 4) ^ 2 with hb
  have hab : 0 < b - a := by rw [ha, hb]; nlinarith
  set ζ : Euclid P → ℝ := fun w => Real.smoothTransition ((b - ‖q w‖ ^ 2) / (b - a))
  have hζc : ContDiff ℝ (⊤ : ℕ∞) ζ :=
    Real.smoothTransition.contDiff.comp
      ((contDiff_const.sub ((contDiff_norm_sq ℝ).comp hqc)).div_const _)
  have hζ0 : ∀ w, 0 ≤ ζ w := fun w => Real.smoothTransition.nonneg _
  have hζ1 : ∀ w, ζ w ≤ 1 := fun w => Real.smoothTransition.le_one _
  have hζsupp : ∀ w, ζ w ≠ 0 → ‖q w‖ < 3 * δ₂ / 4 := by
    intro w hw
    by_contra hcon
    push Not at hcon
    apply hw
    apply Real.smoothTransition.zero_of_nonpos
    apply div_nonpos_of_nonpos_of_nonneg _ hab.le
    have : (3 * δ₂ / 4) ^ 2 ≤ ‖q w‖ ^ 2 := pow_le_pow_left₀ (by positivity) hcon 2
    rw [hb]; linarith
  -- the test form `ω(w) = Λ(ζ(w) φ(π(w))) = ζ(w) det[φ(π(w)), ι*·, …, ι*·]`
  set ω₀ : DifferentialForm (Euclid P) n := fun w => Λ (ζ w • φ (π w)) with hω₀def
  have hω₀c : ContDiff ℝ (⊤ : ℕ∞) ω₀ := Λ.contDiff.comp (hζc.smul (hφ.comp hπc))
  -- `spt ω ⊆ S = {π ∈ spt φ, |p^⊥| ≤ 3δ₂/4}`, a compact subset of `Z ⊆ B̄_{δ₁+δ₂}(x) ⊆ U`
  set S : Set (Euclid P) := {w | π w ∈ tsupport φ ∧ ‖q w‖ ≤ 3 * δ₂ / 4}
  have hSclosed : IsClosed S :=
    ((isClosed_tsupport φ).preimage hπc.continuous).inter
      (isClosed_le (continuous_norm.comp hqc.continuous) continuous_const)
  have hsuppS : support ω₀ ⊆ S := by
    intro w hw
    have hne : ζ w • φ (π w) ≠ 0 := by
      intro h0; apply hw; simp only [hω₀def, h0, map_zero]
    refine ⟨subset_tsupport _ (right_ne_zero_of_smul hne), (hζsupp w (left_ne_zero_of_smul hne)).le⟩
  have htsS : tsupport ω₀ ⊆ S := closure_minimal hsuppS hSclosed
  obtain ⟨R, hR⟩ := hφc.isBounded.subset_closedBall 0
  have hSball : S ⊆ closedBall x (R + 3 * δ₂ / 4) := by
    intro w hw
    rw [mem_closedBall, dist_eq_norm]
    have h1 : ‖π w‖ ≤ R := by simpa using hR hw.1
    linarith [hdecomp w, hw.2]
  have hcpt : HasCompactSupport ω₀ :=
    (isCompact_closedBall x _).of_isClosed_subset (isClosed_tsupport _) (htsS.trans hSball)
  have hSZ : S ⊆
      {w : Euclid P | ‖ContinuousLinearMap.adjoint ι.toContinuousLinearMap (w - x)‖ < δ₁ ∧
        ‖w - x - ι (ContinuousLinearMap.adjoint ι.toContinuousLinearMap (w - x))‖ < δ₂} := by
    intro w hw
    refine ⟨?_, ?_⟩
    · have h1 := hφD hw.1
      rw [mem_ball_zero_iff] at h1
      exact h1
    · have := hw.2; show ‖q w‖ < δ₂; linarith
  have hZB : {w : Euclid P | ‖ContinuousLinearMap.adjoint ι.toContinuousLinearMap (w - x)‖ < δ₁ ∧
      ‖w - x - ι (ContinuousLinearMap.adjoint ι.toContinuousLinearMap (w - x))‖ < δ₂} ⊆
      closedBall x (δ₁ + δ₂) := by
    intro w hw
    rw [mem_closedBall, dist_eq_norm]
    have h1 : ‖π w‖ < δ₁ := hw.1
    have h2 : ‖q w‖ < δ₂ := hw.2
    linarith [hdecomp w]
  let ω : TestFormOn U n := ⟨ω₀, ⟨⟨hω₀c, hcpt⟩, (htsS.trans hSZ).trans (hZB.trans hball)⟩⟩
  refine ⟨ω, htsS.trans hSZ, (htsS.trans hSZ).trans hZB, ?_, ?_⟩
  · -- coefficient bound: `ω(w) = Λ(p)` with `|p| = ζ(w) |φ(π(w))| ≤ 1`
    intro w
    -- Leibniz: a real `m × m` matrix with entries of absolute value `≤ 1` has `|det| ≤ m!`
    have hleib : ∀ (m : ℕ) (M : Matrix (Fin m) (Fin m) ℝ), (∀ r c, |M r c| ≤ 1) →
        |M.det| ≤ (m.factorial : ℝ) := by
      intro m M hM
      rw [Matrix.det_apply]
      calc |∑ σ : Equiv.Perm (Fin m), Equiv.Perm.sign σ • ∏ i, M (σ i) i|
          ≤ ∑ σ : Equiv.Perm (Fin m), |Equiv.Perm.sign σ • ∏ i, M (σ i) i| :=
            Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ _σ : Equiv.Perm (Fin m), (1 : ℝ) := by
            refine Finset.sum_le_sum fun σ _ => ?_
            rw [Units.smul_def, zsmul_eq_mul, abs_mul]
            have hs : |((Equiv.Perm.sign σ : ℤ) : ℝ)| = 1 := by
              rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h | h <;> simp [h]
            rw [hs, one_mul, Finset.abs_prod]
            exact Finset.prod_le_one₀ (fun i _ => abs_nonneg _) (fun i _ => hM _ _)
        _ = (m.factorial : ℝ) := by
            simp [Finset.card_univ, Fintype.card_perm]
    -- `|Λ(p)(e_I)| = |det[p, Ae_{I(1)}, …, Ae_{I(n)}]| ≤ (n+1)!` for every index tuple `I`
    have hcoef : ∀ (p : Euclid (n + 1)), ‖p‖ ≤ 1 → ∀ I : Fin n → Fin P,
        |Λ p (fun i => EuclideanSpace.basisFun (Fin P) ℝ (I i))| ≤ ((n + 1).factorial : ℝ) := by
      intro p hp I
      rw [hΛ]
      apply hleib
      intro r c
      refine Fin.cases ?_ (fun k => ?_) c
      · simpa [Real.norm_eq_abs] using (PiLp.norm_apply_le p r).trans hp
      · simp only [Matrix.of_apply, Fin.cons_succ]
        have h1 := PiLp.norm_apply_le (A (EuclideanSpace.basisFun (Fin P) ℝ (I k))) r
        have h2 : ‖A (EuclideanSpace.basisFun (Fin P) ℝ (I k))‖ ≤ 1 := by
          calc ‖A (EuclideanSpace.basisFun (Fin P) ℝ (I k))‖
              ≤ ‖A‖ * ‖EuclideanSpace.basisFun (Fin P) ℝ (I k)‖ := A.le_opNorm _
            _ = ‖A‖ := by simp
            _ ≤ 1 := hA
        rw [← Real.norm_eq_abs]
        exact h1.trans h2
    have hp : ‖ζ w • φ (π w)‖ ≤ 1 := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (hζ0 w)]
      calc ζ w * ‖φ (π w)‖ ≤ 1 * 1 := mul_le_mul (hζ1 w) (hφ1 _) (norm_nonneg _) zero_le_one
        _ = 1 := one_mul 1
    -- sum the squared coefficients over the `Pⁿ` index tuples
    show covectorEuclideanNorm (Λ (ζ w • φ (π w))) ≤ _
    unfold covectorEuclideanNorm
    have hF : (0 : ℝ) ≤ ((n + 1).factorial : ℝ) := by positivity
    calc Real.sqrt (∑ I : Fin n → Fin P, if StrictMono I then
          (Λ (ζ w • φ (π w)) (fun i => EuclideanSpace.basisFun (Fin P) ℝ (I i))) ^ 2 else 0)
        ≤ Real.sqrt (∑ _I : Fin n → Fin P, ((n + 1).factorial : ℝ) ^ 2) := by
          apply Real.sqrt_le_sqrt
          refine Finset.sum_le_sum fun I _ => ?_
          split_ifs
          · exact sq_le_sq' (abs_le.1 (hcoef _ hp I)).1 (abs_le.1 (hcoef _ hp I)).2
          · positivity
      _ = ((n + 1).factorial : ℝ) * Real.sqrt ((P : ℝ) ^ n) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fun, Fintype.card_fin,
            Fintype.card_fin, nsmul_eq_mul, Real.sqrt_mul (by positivity), Real.sqrt_sq hF,
            mul_comm]
          push_cast
          ring
  · -- the pulled-back field is `φ`: both sides vanish off `B_{δ₁}(0)`
    funext v
    by_cases hv : v ∈ ball (0 : Euclid (n + 1)) δ₁
    · rw [Set.indicator_of_mem hv]
      obtain ⟨hπv, hqv, hdv⟩ := hG v hv
      have hζv : ζ (x + ι v + u v) = 1 := by
        apply Real.smoothTransition.one_of_one_le
        rw [le_div_iff₀ hab, one_mul]
        have hq' : q (x + ι v + u v) = u v := hqv
        rw [hq']
        have h0 := hsmall v hv
        have : ‖u v‖ ^ 2 < (δ₂ / 2) ^ 2 := pow_lt_pow_left₀ h0 (norm_nonneg _) two_ne_zero
        rw [ha]; linarith
      -- `ω(G(v))(DG(v)e_{j.succAbove ·}) = det[φ(v), e_{j.succAbove ·}] = (−1)ʲ φⱼ(v)`
      have hterm : ∀ j : Fin (n + 1),
          (ω : DifferentialForm (Euclid P) n) (x + ι v + u v) (fun k =>
            fderiv ℝ (fun y => x + ι y + u y) v (EuclideanSpace.single (j.succAbove k) 1)) =
          (-1 : ℝ) ^ (j : ℕ) * φ v j := by
        intro j
        show Λ (ζ (x + ι v + u v) • φ (π (x + ι v + u v))) _ = _
        have hπ' : π (x + ι v + u v) = v := hπv
        rw [hζv, one_smul, hπ', hΛ]
        simp only [hdv]
        exact Submission.codim1_lur_det_laplace_first_column n (φ v) j
      simp only [hterm]
      have hsq : ∀ j : Fin (n + 1), (-1 : ℝ) ^ (j : ℕ) * ((-1 : ℝ) ^ (j : ℕ) * φ v j) = φ v j := by
        intro j
        rw [← mul_assoc, ← pow_add, ← two_mul, pow_mul, neg_one_sq, one_pow, one_mul]
      simp only [hsq]
      ext i
      simp [Pi.single_apply]
    · rw [Set.indicator_of_notMem hv]
      exact image_eq_zero_of_notMem_tsupport fun h => hv (hφD h)

/-- Step 6 of the graph chart in the proof of **Simon 7.5.8** (orientations as in Ch. 6, 1.1–2.2):
if `ξN` orients `N`, `ξN(x) = ιe₀ ∧ ⋯ ∧ ιeₙ`, and `u` is `C¹` on `D = B_δ(0)` with `u(0) = 0`,
`Du(0) = 0`, `u ⊥ range ι` and `G(v) = x + ιv + u(v) ∈ N`, then on `D`
`ξN(G(v)) = J(v)⁻¹ a₀(v) ∧ ⋯ ∧ aₙ(v)`, where `aᵢ(v) = ιeᵢ + Du(v)eᵢ` and
`J(v) = det(⟨aᵢ(v), aⱼ(v)⟩)^{1/2}`.  Since `Du(v) ⊥ range ι`, `a(v)` is linearly independent, so
`η(v) = J(v)⁻¹ a₀(v) ∧ ⋯ ∧ aₙ(v)` is a unit orientation of `span a(v) = T_{G(v)}N`, and
`ξN(G(v)) = ±η(v)`.  The sign `s(v) = ξN(G(v))(L(η(v))) = ±1` is continuous on the connected
set `D` and `s(0) = 1`, so `s = 1` on `D`. -/
theorem Submission.codim1_rdo_gc_orientation_along_graph : ∀ (P n : ℕ) (N : Set (Euclid P)) (ξN : Euclid P → MultiVector P (n + 1)) (x : Euclid P) (ι : Euclid (n + 1) →ₗᵢ[ℝ] Euclid P) (u : Euclid (n + 1) → Euclid P) (δ : ℝ), IsOrientation (n + 1) N ξN → (∀ α : Covector (Euclid P) (n + 1), ξN x α = α (fun i => ι (EuclideanSpace.single i 1))) → 0 < δ → u 0 = 0 → fderiv ℝ u 0 = 0 → ContDiffOn ℝ 1 u (ball 0 δ) → (∀ v ∈ ball (0 : Euclid (n + 1)) δ, ∀ w : Euclid (n + 1), inner ℝ (ι w) (u v) = 0) → (∀ v ∈ ball (0 : Euclid (n + 1)) δ, x + ι v + u v ∈ N) → ∀ v ∈ ball (0 : Euclid (n + 1)) δ, ∀ α : Covector (Euclid P) (n + 1), ξN (x + ι v + u v) α * Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (n + 1) => inner ℝ (ι (EuclideanSpace.single i 1) + fderiv ℝ u v (EuclideanSpace.single i 1)) (ι (EuclideanSpace.single j 1) + fderiv ℝ u v (EuclideanSpace.single j 1)))) = α (fun i => ι (EuclideanSpace.single i 1) + fderiv ℝ u v (EuclideanSpace.single i 1)) := by
  intro P n N ξN x ι u δ hξ hιξ hδ hu0 hDu0 hu horth hmem
  set D := ball (0 : Euclid (n + 1)) δ with hD
  have hDopen : IsOpen D := isOpen_ball
  let e : Fin (n + 1) → Euclid (n + 1) := fun i => EuclideanSpace.single i 1
  -- the graph map `G`, its derivative `A(v) = ι + Du(v)`, the frame `a(v)` and `J(v)`
  let G : Euclid (n + 1) → Euclid P := fun v => x + ι v + u v
  let A : Euclid (n + 1) → (Euclid (n + 1) →L[ℝ] Euclid P) :=
    fun v => ι.toContinuousLinearMap + fderiv ℝ u v
  let a : Euclid (n + 1) → Fin (n + 1) → Euclid P := fun v i => ι (e i) + fderiv ℝ u v (e i)
  let gram : Euclid (n + 1) → ℝ := fun v => Matrix.det (Matrix.of fun i j => inner ℝ (a v i) (a v j))
  let J : Euclid (n + 1) → ℝ := fun v => Real.sqrt (gram v)
  -- (1) calculus on the open ball `D`
  have hudiff : ∀ v ∈ D, HasFDerivAt u (fderiv ℝ u v) v := fun v hv =>
    ((hu.contDiffAt (hDopen.mem_nhds hv)).differentiableAt (by norm_num)).hasFDerivAt
  have hGderiv : ∀ v ∈ D, HasFDerivAt G (A v) v := fun v hv => by
    have h1 : HasFDerivAt (fun v : Euclid (n + 1) => x + ι v) ι.toContinuousLinearMap v :=
      (ι.toContinuousLinearMap.hasFDerivAt).const_add x
    exact h1.add (hudiff v hv)
  have hAe : ∀ v ∈ D, ∀ i, fderiv ℝ G v (e i) = a v i := fun v hv i => by
    rw [(hGderiv v hv).fderiv]; rfl
  have hDuc : ContinuousOn (fderiv ℝ u) D := hu.continuousOn_fderiv_of_isOpen hDopen le_rfl
  have hGc : ContDiffOn ℝ 1 G D :=
    (contDiffOn_const.add ι.toContinuousLinearMap.contDiff.contDiffOn).add hu
  -- (2) `Du(v)` is orthogonal to `range ι`: `v' ↦ ⟨ιw, u(v')⟩` vanishes on `D`
  have hDorth : ∀ v ∈ D, ∀ w a', inner ℝ (ι w) (fderiv ℝ u v a') = 0 := by
    intro v hv w a'
    have hloc : (fun v' => inner ℝ (ι w) (u v')) =ᶠ[𝓝 v] fun _ => (0 : ℝ) :=
      Filter.eventually_of_mem (hDopen.mem_nhds hv) (fun v' hv' => horth v' hv' w)
    have hd : HasFDerivAt (fun v' => inner ℝ (ι w) (u v'))
        ((innerSL ℝ (ι w)).comp (fderiv ℝ u v)) v :=
      (innerSL ℝ (ι w)).hasFDerivAt.comp v (hudiff v hv)
    have hd0 : HasFDerivAt (fun v' => inner ℝ (ι w) (u v')) (0 : Euclid (n + 1) →L[ℝ] ℝ) v :=
      (hasFDerivAt_const (0 : ℝ) v).congr_of_eventuallyEq hloc
    have h2 := congrArg (fun L => L a') (hd.unique hd0)
    simpa using h2
  -- (3) `‖A(v)c‖ ≥ ‖c‖`, so `A(v)` is injective and `a(v)` is linearly independent
  have hnorm : ∀ v ∈ D, ∀ c : Euclid (n + 1), ‖c‖ ^ 2 ≤ ‖A v c‖ ^ 2 := by
    intro v hv c
    have h1 : A v c = ι c + fderiv ℝ u v c := rfl
    rw [h1, norm_add_sq_real, hDorth v hv c c, LinearIsometry.norm_map]
    nlinarith [sq_nonneg ‖fderiv ℝ u v c‖]
  have hinj : ∀ v ∈ D, Injective (A v) := by
    intro v hv c₁ c₂ h12
    have h1 := hnorm v hv (c₁ - c₂)
    rw [map_sub, h12, sub_self, norm_zero] at h1
    have h2 : ‖c₁ - c₂‖ = 0 := by nlinarith [norm_nonneg (c₁ - c₂)]
    exact sub_eq_zero.mp (norm_eq_zero.mp h2)
  have hlin : ∀ v ∈ D, LinearIndependent ℝ (a v) := by
    intro v hv
    have hb := (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis.linearIndependent
    have hker : LinearMap.ker (A v : Euclid (n + 1) →ₗ[ℝ] Euclid P) = ⊥ :=
      LinearMap.ker_eq_bot.mpr (hinj v hv)
    have := hb.map' (A v : Euclid (n + 1) →ₗ[ℝ] Euclid P) hker
    convert this using 1
    funext i
    simp [a, A, e]
  -- (4) `η(v) = J(v)⁻¹ a₀(v) ∧ ⋯ ∧ aₙ(v)` is a unit orientation of `span a(v)`
  obtain ⟨ev, hevc, hev⟩ := Submission.dgoj_exists_continuous_covector_eval P (n + 1)
  let η : Euclid (n + 1) → MultiVector P (n + 1) := fun v => (J v)⁻¹ • ev (a v)
  have hgpos : ∀ v ∈ D, 0 < gram v := fun v hv =>
    (Submission.codim1_rdo_gc_gram_unitOrientation P (n + 1) (a v) (hlin v hv)).1
  have hJpos : ∀ v ∈ D, 0 < J v := fun v hv => Real.sqrt_pos.2 (hgpos v hv)
  have hηJ : ∀ v ∈ D, ∀ α, η v α * J v = α (a v) := by
    intro v hv α
    simp only [η, smul_apply, hev, smul_eq_mul]
    field_simp [(hJpos v hv).ne']
  have hηunit : ∀ v ∈ D, IsUnitOrientationOf (η v) (Submodule.span ℝ (Set.range (a v))) :=
    fun v hv => (Submission.codim1_rdo_gc_gram_unitOrientation P (n + 1) (a v) (hlin v hv)).2 _
      (hηJ v hv)
  -- (5)–(6) `span a(v) = T_{G(v)}N`, hence `ξN(G(v)) = ±η(v)`
  have hrange := Submission.dsmc_chart_range_subset_tangentSpace P 1 (n + 1) N D G le_rfl hDopen
    (by simpa using hGc) (by rintro _ ⟨v, hv, rfl⟩; exact hmem v hv)
  have hsign : ∀ v ∈ D, ξN (G v) = η v ∨ ξN (G v) = -η v := by
    intro v hv
    obtain ⟨Q, hQ, hQξ⟩ := hξ.2 (G v) (hmem v hv)
    have hle : Submodule.span ℝ (Set.range (a v)) ≤ Q := by
      rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      have h1 : a v i ∈ tangentSpace N (G v) := hrange v hv ⟨e i, hAe v hv i⟩
      rw [← hQ] at h1
      exact h1
    have hfin1 : Module.finrank ℝ (Submodule.span ℝ (Set.range (a v))) = n + 1 := by
      rw [finrank_span_eq_card (hlin v hv)]; simp
    have hfin2 : Module.finrank ℝ Q = n + 1 := by
      obtain ⟨τ, hτ, hτspan, -⟩ := hQξ
      rw [← hτspan, finrank_span_eq_card hτ.linearIndependent]; simp
    have hEq := Submodule.eq_of_le_of_finrank_eq hle (hfin1.trans hfin2.symm)
    have hηQ : IsUnitOrientationOf (η v) Q := hEq ▸ hηunit v hv
    exact Submission.rsdic_unitOrientation_eq_or_eq_neg P (n + 1) (η v) (ξN (G v)) Q hηQ hQξ
  -- (7) the sign function `s(v) = ξN(G(v))(L(η(v))) ∈ {1, -1}` is continuous on `D`
  obtain ⟨L, hL⟩ := Submission.dor_ims_unitOrientation_dual P (n + 1)
  have hηL : ∀ v ∈ D, η v (L (η v)) = 1 := fun v hv => (hL _ _ (hηunit v hv)).2.2
  let s : Euclid (n + 1) → ℝ := fun v => ξN (G v) (L (η v))
  have hs : ∀ v ∈ D, s v = 1 ∨ s v = -1 := by
    intro v hv
    rcases hsign v hv with h | h
    · left; simp only [s, h]; exact hηL v hv
    · right; simp only [s, h, neg_apply]; rw [hηL v hv]
  have hGcont : ContinuousOn G D := hGc.continuousOn
  have hξG : ContinuousOn (fun v => ξN (G v)) D := hξ.1.comp hGcont (fun v hv => hmem v hv)
  have hac : ContinuousOn a D := continuousOn_pi.2 fun i =>
    continuousOn_const.add (hDuc.clm_apply continuousOn_const)
  have hgramc : ContinuousOn gram D := by
    have hM : ContinuousOn (fun v => (Matrix.of fun i j => inner ℝ (a v i) (a v j) :
        Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ)) D :=
      continuousOn_pi.2 fun i => continuousOn_pi.2 fun j =>
        ((continuousOn_pi.1 hac) i).inner ((continuousOn_pi.1 hac) j)
    exact (continuous_id.matrix_det).comp_continuousOn hM
  have hJc : ContinuousOn J D := Real.continuous_sqrt.comp_continuousOn hgramc
  have hηc : ContinuousOn η D :=
    (hJc.inv₀ (fun v hv => (hJpos v hv).ne')).smul (hevc.comp_continuousOn hac)
  have hsc : ContinuousOn s D := hξG.clm_apply (L.continuous.comp_continuousOn hηc)
  -- (8) at the centre: `G(0) = x`, `a(0) = ιe`, `J(0) = 1`, so `η(0) = ξN(x)` and `s(0) = 1`
  have h0D : (0 : Euclid (n + 1)) ∈ D := mem_ball_self hδ
  have hG0 : G 0 = x := by simp [G, hu0]
  have ha0 : a 0 = fun i => ι (e i) := by funext i; simp [a, hDu0]
  have hgram0 : gram 0 = 1 := by
    have hM : (Matrix.of fun i j => inner ℝ (a 0 i) (a 0 j) : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ) = 1 := by
      ext i j
      rw [ha0, Matrix.of_apply, LinearIsometry.inner_map_map, Matrix.one_apply]
      simp [e, EuclideanSpace.inner_single_left]
    simp only [gram, hM, Matrix.det_one]
  have hJ0 : J 0 = 1 := by simp [J, hgram0]
  have hη0 : η 0 = ξN x := by
    ext α
    simp only [η, hJ0, inv_one, one_smul, hev, ha0, hιξ]
    rfl
  have hs0 : s 0 = 1 := by
    show ξN (G 0) (L (η 0)) = 1
    rw [hG0, ← hη0]; exact hηL 0 h0D
  -- (9) `D` is connected, so the intermediate value theorem gives `s = 1` on `D`
  have hsconst : ∀ v ∈ D, s v = 1 := by
    intro v hv
    rcases hs v hv with h | h
    · exact h
    · exfalso
      have hpre : IsPreconnected D := (convex_ball (0 : Euclid (n + 1)) δ).isPreconnected
      have hivt := hpre.intermediate_value hv h0D hsc
      rw [h, hs0] at hivt
      obtain ⟨w, hw, hw0⟩ := hivt (show (0 : ℝ) ∈ Icc (-1 : ℝ) 1 by norm_num)
      rcases hs w hw with h' | h' <;> rw [hw0] at h' <;> norm_num at h'
  -- (10) hence `ξN(G(v)) = η(v)`, which is the claim
  intro v hv α
  have hpos : ξN (G v) = η v := by
    rcases hsign v hv with h | h
    · exact h
    · exfalso
      have h1 := hsconst v hv
      simp only [s, h, neg_apply] at h1
      rw [hηL v hv] at h1
      norm_num at h1
  show ξN (G v) α * J v = α (a v)
  rw [hpos]
  exact hηJ v hv α

/-- **Oriented graph chart** (Simon Ch. 2, §4 and 6.2.2).  Let `N` be an embedded `C²`
`(n+1)`-submanifold oriented by `ξN`, and `x ∈ N ∩ U`.  Near `x`, `N` is the graph
`G(v) = x + ιv + u(v)`, `v ∈ B_{δ₁}(0)`, of a `C²` map `u ⊥ ι(ℝⁿ⁺¹)` over the tangent plane
`T_xN = ι(ℝⁿ⁺¹)` (`ι` a linear isometry), with `u(0) = 0`, `‖Du‖ ≤ 1` and `‖u‖ < δ₂/2`; a point
`x + ιv + h ∈ N` with `|v| < δ₁`, `|h| < δ₂`, `h ⊥ ι(ℝⁿ⁺¹)` has `h = u(v)`; and
`ξN(G(v)) · J(v) = DG(v)e₁ ∧ ⋯ ∧ DG(v)eₙ₊₁` with `J(v) = det(⟨DG(v)eᵢ, DG(v)eⱼ⟩)^{1/2}`.
`ξN(x)` is a unit orientation of `T_xN`, so `ξN(x) = ιe₁ ∧ ⋯ ∧ ιeₙ₊₁` for some `ι` onto `T_xN`;
the inverse function theorem gives the graph over `ι(ℝⁿ⁺¹)` with `Du(0) = 0`; and the
orientation identity, true at `v = 0`, is transported over the connected ball `B_{δ₁}(0)`. -/
theorem Submission.codim1_rdo_graph_chart : ∀ (P n : ℕ) (U N : Set (Euclid P)) (ξN : Euclid P → MultiVector P (n + 1)) (x : Euclid P), IsOpen U → IsEmbeddedSubmanifold 2 (n + 1) N → IsOrientation (n + 1) N ξN → x ∈ N ∩ U → ∃ (ι : Euclid (n + 1) →ₗᵢ[ℝ] Euclid P) (u : Euclid (n + 1) → Euclid P) (δ₁ δ₂ : ℝ), 0 < δ₁ ∧ 0 < δ₂ ∧ closedBall x (δ₁ + δ₂) ⊆ U ∧ u 0 = 0 ∧ ContDiffOn ℝ 2 u (ball 0 δ₁) ∧ (∀ v ∈ ball (0 : Euclid (n + 1)) δ₁, (∀ w : Euclid (n + 1), inner ℝ (ι w) (u v) = 0) ∧ ‖fderiv ℝ u v‖ ≤ 1 ∧ ‖u v‖ < δ₂ / 2 ∧ x + ι v + u v ∈ N ∧ ∀ α : Covector (Euclid P) (n + 1), ξN (x + ι v + u v) α * Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (n + 1) => inner ℝ (ι (EuclideanSpace.single i 1) + fderiv ℝ u v (EuclideanSpace.single i 1)) (ι (EuclideanSpace.single j 1) + fderiv ℝ u v (EuclideanSpace.single j 1)))) = α (fun i => ι (EuclideanSpace.single i 1) + fderiv ℝ u v (EuclideanSpace.single i 1))) ∧ ∀ (v : Euclid (n + 1)) (h : Euclid P), ‖v‖ < δ₁ → ‖h‖ < δ₂ → (∀ w : Euclid (n + 1), inner ℝ (ι w) h = 0) → x + ι v + h ∈ N → h = u v := by
  intro P n U N ξN x hU hN hξ hx
  -- `ξN(x)` orients `Q = T_xN`; write it as `ξN(x) = ιe₁ ∧ ⋯ ∧ ιeₙ₊₁` with `ι(ℝⁿ⁺¹) = Q`
  obtain ⟨Q, hQ, hQξ⟩ := hξ.2 x hx.1
  obtain ⟨ι, hιQ, hιξ⟩ := Submission.codim1_rdo_gc_unitOrientation_isometry P n (ξN x) Q hQξ
  -- near `x`, `N` is the `C²` graph of `u ⊥ ι(ℝⁿ⁺¹)` over `ι(ℝⁿ⁺¹) = T_xN`, and `Du(0) = 0`
  obtain ⟨u, δ₁, δ₂, hδ₁, hδ₂, hball, hu0, hDu0, hu, hgraph, huniq⟩ :=
    Submission.codim1_rdo_gc_graph_over_tangent P (n + 1) U N x ι hU hN hx (hιQ.trans hQ)
  -- the orientation identity at `v = 0` propagates over `B_{δ₁}(0)` along the graph
  have horient := Submission.codim1_rdo_gc_orientation_along_graph P n N ξN x ι u δ₁ hξ hιξ hδ₁
    hu0 hDu0 (hu.of_le (by norm_num)) (fun v hv => (hgraph v hv).1)
    (fun v hv => (hgraph v hv).2.2.2)
  exact ⟨ι, u, δ₁, δ₂, hδ₁, hδ₂, hball, hu0, hu, fun v hv =>
    ⟨(hgraph v hv).1, (hgraph v hv).2.1, (hgraph v hv).2.2.1, (hgraph v hv).2.2.2, horient v hv⟩,
    huniq⟩
/-- `Λⁿ(ℝᴾ)` is finite-dimensional: `α ↦ (α(e_{I(1)}, …, e_{I(n)}))_{I : Fin n → Fin P}` is a linear
map into the finite-dimensional space `(Fin n → Fin P) → ℝ`, injective because an alternating map
is determined by its values on tuples of basis vectors. -/
theorem Submission.dor_ims_lusin_covector_finiteDimensional : ∀ (P n : ℕ), FiniteDimensional ℝ (Covector (Euclid P) n) := by
  intro P n
  let e := (EuclideanSpace.basisFun (Fin P) ℝ).toBasis
  -- `L α = (α(e ∘ I))_I`
  let L : Covector (Euclid P) n →ₗ[ℝ] (Fin n → Fin P) → ℝ :=
    { toFun := fun α I => α fun k => e (I k)
      map_add' := fun α β => rfl
      map_smul' := fun c α => rfl }
  refine FiniteDimensional.of_injective L fun α β h => ?_
  apply ContinuousAlternatingMap.toAlternatingMap_injective
  exact e.ext_alternating fun v _ => congrFun h v
/-- **Lusin's theorem**, compact form (Simon 1.17), for a measurable `g : ℝᴾ → Y` into a
second-countable `Y`.  If `μ(A) < ∞` and `ε ≠ 0`, there is a compact `K ⊆ A` with
`μ(A \ K) < ε` on which `g` is continuous.  `μ⌞A` is finite, hence inner regular on `ℝᴾ`.  For a
countable basis `(O_k)` of `Y` and weights `η_k > 0` with `∑ η_k < ε`, choose compact
`C_k ⊆ A ∩ g⁻¹(O_k)` and `D_k ⊆ A \ g⁻¹(O_k)` with defects `< η_k / 2`, and put
`K = ⋂ₖ (C_k ∪ D_k)`.  On `K`, `g x ∈ O_k ↔ x ∉ D_k`, so every `g⁻¹(O_k) ∩ K` is relatively
open. -/
theorem Submission.dor_ims_lusin_measurable_continuousOn : ∀ (P : ℕ) {Y : Type} [TopologicalSpace Y] [SecondCountableTopology Y] [MeasurableSpace Y] [OpensMeasurableSpace Y] (μ : Measure (Euclid P)) (A : Set (Euclid P)) (g : Euclid P → Y) (ε : ℝ≥0∞), Measurable g → MeasurableSet A → μ A ≠ ∞ → ε ≠ 0 → ∃ K : Set (Euclid P), IsCompact K ∧ K ⊆ A ∧ μ (A \ K) < ε ∧ ContinuousOn g K := by
  intro P Y _ _ _ _ μ A g ε hg hA hμA hε
  -- `μ⌞A` is finite, hence regular on the σ-compact metric space `ℝᴾ`, so every measurable
  -- `B ⊆ A` contains a compact `C` with `μ (B \ C) = μ⌞A (B \ C)` arbitrarily small
  have : IsFiniteMeasure (μ.restrict A) := isFiniteMeasure_restrict.mpr hμA
  have approx : ∀ B, B ⊆ A → MeasurableSet B → ∀ η : ℝ≥0∞, η ≠ 0 →
      ∃ C ⊆ B, IsCompact C ∧ μ (B \ C) < η := by
    intro B hBA hB η hη
    obtain ⟨C, hCB, hC, hlt⟩ :=
      hB.exists_isCompact_sdiff_lt (μ := μ.restrict A) (measure_ne_top _ _) hη
    exact ⟨C, hCB, hC, by rwa [Measure.restrict_eq_self _ (sdiff_subset.trans hBA)] at hlt⟩
  -- a countable basis `(O_k)` of `Y`, and weights `η_k > 0` with `∑ η_k < ε`
  obtain ⟨O, hO⟩ := TopologicalSpace.exists_seq_basis Y
  obtain ⟨η, hη, hηε⟩ := ENNReal.exists_pos_sum_of_countable' hε ℕ
  have hS : ∀ k, MeasurableSet (g ⁻¹' O k) :=
    fun k => hg (hO.isOpen (mem_range_self k)).measurableSet
  -- compact `C_k ⊆ A ∩ g⁻¹(O_k)` and `D_k ⊆ A \ g⁻¹(O_k)`, each with defect `< η_k / 2`
  choose C hCA hC hCμ using fun k =>
    approx (A ∩ g ⁻¹' O k) inter_subset_left (hA.inter (hS k)) (η k / 2)
      (ENNReal.half_pos (hη k).ne').ne'
  choose D hDA hD hDμ using fun k =>
    approx (A \ g ⁻¹' O k) sdiff_subset (hA.diff (hS k)) (η k / 2)
      (ENNReal.half_pos (hη k).ne').ne'
  -- `E_k = C_k ∪ D_k` misses less than `η_k` of `A`
  have hE : ∀ k, μ (A \ (C k ∪ D k)) < η k := by
    intro k
    calc μ (A \ (C k ∪ D k))
        ≤ μ ((A ∩ g ⁻¹' O k) \ C k ∪ (A \ g ⁻¹' O k) \ D k) := by
          refine measure_mono fun x hx => ?_
          by_cases hxO : g x ∈ O k
          · exact Or.inl ⟨⟨hx.1, hxO⟩, fun hxC => hx.2 (Or.inl hxC)⟩
          · exact Or.inr ⟨⟨hx.1, hxO⟩, fun hxD => hx.2 (Or.inr hxD)⟩
      _ ≤ μ ((A ∩ g ⁻¹' O k) \ C k) + μ ((A \ g ⁻¹' O k) \ D k) := measure_union_le _ _
      _ < η k / 2 + η k / 2 := ENNReal.add_lt_add (hCμ k) (hDμ k)
      _ = η k := ENNReal.add_halves _
  -- `K = ⋂ₖ E_k` is closed inside the compact `E_0 ⊆ A`
  refine ⟨⋂ k, (C k ∪ D k), ?_, ?_, ?_, ?_⟩
  · exact ((hC 0).union (hD 0)).of_isClosed_subset
      (isClosed_iInter fun k => ((hC k).union (hD k)).isClosed) (iInter_subset _ 0)
  · exact (iInter_subset _ 0).trans
      (union_subset ((hCA 0).trans inter_subset_left) ((hDA 0).trans sdiff_subset))
  · calc μ (A \ ⋂ k, (C k ∪ D k)) = μ (⋃ k, A \ (C k ∪ D k)) := by rw [sdiff_iInter]
      _ ≤ ∑' k, μ (A \ (C k ∪ D k)) := measure_iUnion_le _
      _ ≤ ∑' k, η k := ENNReal.tsum_le_tsum fun k => (hE k).le
      _ < ε := hηε
  -- on `K`, `g x ∈ O_k ↔ x ∉ D_k`, so `g⁻¹(O_k) ∩ K = D_kᶜ ∩ K` is relatively open
  · rw [hO.continuousOn_iff]
    rintro _ ⟨k, rfl⟩
    refine ⟨(D k)ᶜ, (hD k).isClosed.isOpen_compl, ?_⟩
    ext x
    refine ⟨fun ⟨hxO, hxK⟩ => ⟨fun hxD => (hDA k hxD).2 hxO, hxK⟩, fun ⟨hxD, hxK⟩ => ⟨?_, hxK⟩⟩
    rcases mem_iInter.mp hxK k with hxC | hxD'
    · exact (hCA k hxC).2
    · exact absurd hxD' hxD

/-- **Lusin's theorem** for `Lⁿ` with a closed set, `Lⁿ(B) = ∞` allowed (Simon Ch. 2, proof of
1.5, step 2, glued as in the infinite-measure case of Simon 1.15(2)).  On the bounded Borel shells
`S_j = {j ≤ ‖x‖ < j + 1}`, the compact form `dor_ims_lusin_measurable_continuousOn` gives compact
`K_j ⊆ B ∩ S_j` with `Lⁿ((B ∩ S_j) \ K_j) < δ_j` on which `g` is continuous, where `∑ δ_j < ε`.
As `K_j ⊆ S_j`, the family `(K_j)` is locally finite, so `C = ⋃ⱼ K_j` is closed and `g` is
continuous on `C`; and `B \ C ⊆ ⋃ⱼ (B ∩ S_j) \ K_j` has measure `< ε`. -/
theorem Submission.codim1_rdo_c1a_lusin_isClosed : ∀ (n : ℕ) {Y : Type} [TopologicalSpace Y] [SecondCountableTopology Y] [MeasurableSpace Y] [OpensMeasurableSpace Y] (g : Euclid n → Y) (B : Set (Euclid n)), Measurable g → MeasurableSet B → ∀ ε : ℝ≥0∞, 0 < ε → ∃ C : Set (Euclid n), C ⊆ B ∧ IsClosed C ∧ ContinuousOn g C ∧ volume (B \ C) < ε := by
  intro n Y _ _ _ _ g B hg hB ε hε
  -- bounded Borel shells `S_j = {j ≤ ‖x‖ < j + 1}`, each of finite measure; `x ∈ S_⌊‖x‖⌋`
  set S : ℕ → Set (Euclid n) := fun j => {x | (j : ℝ) ≤ ‖x‖ ∧ ‖x‖ < j + 1}
  have hSm : ∀ j, MeasurableSet (S j) := fun j =>
    (measurableSet_le measurable_const measurable_norm).inter
      (measurableSet_lt measurable_norm measurable_const)
  have hSμ : ∀ j, volume (S j) ≠ ∞ := fun j =>
    ((measure_mono fun x hx => mem_closedBall_zero_iff.mpr hx.2.le).trans_lt
      measure_closedBall_lt_top).ne
  have hxS : ∀ x : Euclid n, x ∈ S ⌊‖x‖⌋₊ := fun x =>
    ⟨Nat.floor_le (norm_nonneg x), Nat.lt_floor_add_one _⟩
  -- weights `δ_j > 0` with `∑ δ_j < ε`
  obtain ⟨δ, hδ, hδε⟩ := ENNReal.exists_pos_sum_of_countable' hε.ne' ℕ
  -- Lusin on each shell: compact `K_j ⊆ B ∩ S_j`, defect `< δ_j`, `g` continuous on `K_j`
  choose K hK hKB hKμ hKg using fun j =>
    Submission.dor_ims_lusin_measurable_continuousOn n volume (B ∩ S j) g (δ j) hg
      (hB.inter (hSm j)) (ne_top_of_le_ne_top (hSμ j) (measure_mono inter_subset_right))
      (hδ j).ne'
  -- `K_j ⊆ S_j`, so `ball x 1` meets `K_j` only for the finitely many `j < ‖x‖ + 1`
  have hlf : LocallyFinite K := by
    intro x
    refine ⟨ball x 1, ball_mem_nhds x one_pos, (finite_lt_nat ⌈‖x‖ + 1⌉₊).subset ?_⟩
    rintro j ⟨y, hyK, hyx⟩
    refine Nat.lt_ceil.mpr ((hKB j hyK).2.1.trans_lt ?_)
    calc ‖y‖ ≤ ‖x‖ + dist y x := norm_le_norm_add_const_of_dist_le le_rfl
      _ < ‖x‖ + 1 := by linarith [mem_ball.mp hyx]
  -- hence `C = ⋃ⱼ K_j` is closed and `g` is continuous on `C`
  refine ⟨⋃ j, K j, iUnion_subset fun j => (hKB j).trans inter_subset_left,
    hlf.isClosed_iUnion fun j => (hK j).isClosed,
    hlf.continuousOn_iUnion (fun j => (hK j).isClosed) hKg, ?_⟩
  -- `x ∈ B \ C` lies in `(B ∩ S_j) \ K_j` for `j = ⌊‖x‖⌋`
  calc volume (B \ ⋃ j, K j) ≤ volume (⋃ j, (B ∩ S j) \ K j) :=
        measure_mono fun x hx => mem_iUnion.mpr
          ⟨⌊‖x‖⌋₊, ⟨hx.1, hxS x⟩, fun hxK => hx.2 (mem_iUnion_of_mem _ hxK)⟩
    _ ≤ ∑' j, volume ((B ∩ S j) \ K j) := measure_iUnion_le _
    _ ≤ ∑' j, δ j := ENNReal.tsum_le_tsum fun j => (hKμ j).le
    _ < ε := hδε
/-- **Egoroff's theorem** on `ℝⁿ` with a closed good set (steps 5–6 of Simon's proof of Ch. 2,
1.5).  If `C` is measurable (possibly `|C| = ∞`), `η_k` and `g` are measurable and `η_k → g`
pointwise on `C`, then for every `ε > 0` there is a closed `A ⊆ C` with `|C \ A| < ε` such that
`η_k → g` uniformly on every compact `Q ⊆ A`.  For weights `δ_j > 0` with `∑ δ_j < ε`, Egoroff on
the finite-measure sets `C ∩ B_{j+1}(0)` gives `t_j` with `|t_j| ≤ δ_j / 2`; put
`A₀ = C \ ⋃ t_j`.  Outer regularity gives open `U_j ⊇ A₀ᶜ ∩ B_{j+1}(0)` with excess `< δ_j / 2`,
so `A = (⋃ U_j)ᶜ ⊆ A₀` is closed and `C \ A ⊆ ⋃ (t_j ∪ (U_j \ (A₀ᶜ ∩ B_{j+1}(0))))`.  A compact
`Q ⊆ A` is bounded, so `Q ⊆ (C ∩ B_{j+1}(0)) \ t_j` for large `j`. -/
theorem Submission.codim1_rdo_c1a_egorov_isClosed : ∀ (n : ℕ) (C : Set (Euclid n)) (η : ℕ → Euclid n → ℝ) (g : Euclid n → ℝ), MeasurableSet C → (∀ k, Measurable (η k)) → Measurable g → (∀ x ∈ C, Tendsto (fun k => η k x) atTop (𝓝 (g x))) → ∀ ε : ℝ≥0∞, 0 < ε → ∃ A : Set (Euclid n), A ⊆ C ∧ IsClosed A ∧ volume (C \ A) < ε ∧ ∀ Q : Set (Euclid n), IsCompact Q → Q ⊆ A → TendstoUniformlyOn η g atTop Q := by
  intro n C η g hC hη hg hconv ε hε
  -- weights `δ_j > 0` with `∑ δ_j < ε`; every `s ∩ B_{j+1}(0)` has finite measure
  obtain ⟨δ, hδ, hδε⟩ := ENNReal.exists_pos_sum_of_countable' hε.ne' ℕ
  have hB : ∀ (j : ℕ) (s : Set (Euclid n)), volume (s ∩ ball 0 (j + 1)) ≠ ∞ := fun j s =>
    ((measure_mono inter_subset_right).trans_lt measure_ball_lt_top).ne
  -- Egoroff on `C_j = C ∩ B_{j+1}(0)`: `η_k → g` uniformly on `C_j \ t_j`, `|t_j| ≤ δ_j / 2`
  choose t htC htm htμ htu using fun j : ℕ =>
    tendstoUniformlyOn_of_ae_tendsto (μ := volume) (fun k => (hη k).stronglyMeasurable)
      hg.stronglyMeasurable (hC.inter measurableSet_ball) (hB j C)
      (ae_of_all _ fun x hx => hconv x hx.1) (ENNReal.half_pos (hδ j).ne')
  -- `A₀ = C \ ⋃ t_j`; outer regularity gives open `U_j ⊇ A₀ᶜ ∩ B_{j+1}(0)` with small excess
  have hA₀ : MeasurableSet (C \ ⋃ j, t j) := hC.diff (MeasurableSet.iUnion htm)
  choose U hUD hUo hUf hUμ using fun j : ℕ =>
    (hA₀.compl.inter measurableSet_ball).exists_isOpen_sdiff_lt (hB j _)
      (ENNReal.half_pos (hδ j).ne').ne'
  -- the balls cover `A₀ᶜ`, so the closed set `A = (⋃ U_j)ᶜ` lies in `A₀`
  have hAA₀ : (⋃ j, U j)ᶜ ⊆ C \ ⋃ j, t j := by
    refine compl_subset_comm.1 fun x hx => ?_
    obtain ⟨j, hj⟩ := exists_nat_gt (dist x 0)
    exact mem_iUnion.2 ⟨j, hUD j ⟨hx, mem_ball.2 (by linarith)⟩⟩
  refine ⟨(⋃ j, U j)ᶜ, hAA₀.trans sdiff_subset, (isOpen_iUnion hUo).isClosed_compl, ?_, ?_⟩
  -- `C \ A ⊆ ⋃_j (t_j ∪ (U_j \ (A₀ᶜ ∩ B_{j+1}(0))))`, and each piece has measure `≤ δ_j`
  · calc volume (C \ (⋃ j, U j)ᶜ)
        ≤ volume (⋃ j, (t j ∪ (U j \ ((C \ ⋃ i, t i)ᶜ ∩ ball 0 (j + 1))))) := by
          refine measure_mono fun x ⟨hxC, hxU⟩ => ?_
          obtain ⟨j, hj⟩ := mem_iUnion.1 (not_not.1 hxU)
          by_cases hxt : x ∈ ⋃ i, t i
          · obtain ⟨i, hi⟩ := mem_iUnion.1 hxt
            exact mem_iUnion.2 ⟨i, Or.inl hi⟩
          · exact mem_iUnion.2 ⟨j, Or.inr ⟨hj, fun h => h.1 ⟨hxC, hxt⟩⟩⟩
      _ ≤ ∑' j, volume (t j ∪ (U j \ ((C \ ⋃ i, t i)ᶜ ∩ ball 0 (j + 1)))) :=
          measure_iUnion_le _
      _ ≤ ∑' j, δ j := ENNReal.tsum_le_tsum fun j => (measure_union_le _ _).trans <|
          (add_le_add (htμ j) (hUμ j).le).trans (ENNReal.add_halves _).le
      _ < ε := hδε
  -- a compact `Q ⊆ A` is bounded, so `Q ⊆ C_j \ t_j` for large `j`
  · intro Q hQ hQA
    obtain ⟨R, hR⟩ := hQ.isBounded.subset_ball 0
    obtain ⟨j, hj⟩ := exists_nat_ge R
    refine (htu j).mono fun x hx => ⟨⟨(hAA₀ (hQA hx)).1, ?_⟩, fun hxt => ?_⟩
    · exact ball_subset_ball (by linarith) (hR hx)
    · exact (hAA₀ (hQA hx)).2 (mem_iUnion.2 ⟨j, hxt⟩)
/-- **Whitney's hypothesis 1.6(∗) on a large closed set** (Simon Ch. 2, proof of Theorem 1.5).
Let `f : ℝⁿ → ℝ` be `L`-Lipschitz and differentiable at every point of the closed set `C`, with
`Df` continuous on `C`.  The remainder quotient `R(x, y) = |f(y) − f(x) − Df(x)(y − x)| / |y − x|`
is at most `2L`, and `η_k(x) = sup {R(x, y) : y ∈ C, 0 < |y − x| < 1/(k + 1)}` (`0` off `C`)
tends to `0` on `C`.  Each `{η_k > t}`, `t ≥ 0`, is relatively open in `C`, so `η_k` is Borel,
and Egorov's theorem in closed form gives a closed `A ⊆ C` with `Lⁿ(C \ A) < ε` such that
`η_k → 0` uniformly on every compact `Q ⊆ A`.  Then `R(x, y) ≤ η_k(x) < ε'` for `x ∈ Q`,
`y ∈ A`, `0 < |x − y| < 1/(k + 1)`. -/
theorem Submission.codim1_rdo_c1a_whitney_remainder : ∀ (n : ℕ) (f : Euclid n → ℝ) (L : NNReal) (C : Set (Euclid n)), LipschitzWith L f → IsClosed C → (∀ x ∈ C, DifferentiableAt ℝ f x) → ContinuousOn (fderiv ℝ f) C → ∀ ε : ℝ≥0∞, 0 < ε → ∃ A : Set (Euclid n), A ⊆ C ∧ IsClosed A ∧ volume (C \ A) < ε ∧ ∀ Q : Set (Euclid n), IsCompact Q → Q ⊆ A → ∀ ε' : ℝ, 0 < ε' → ∃ δ : ℝ, 0 < δ ∧ ∀ x ∈ Q, ∀ y ∈ A, dist x y < δ → ‖f y - f x - fderiv ℝ f x (y - x)‖ ≤ ε' * ‖y - x‖ := by
  intro n f L C hf hC hdiff hDf ε hε
  classical
  -- the remainder quotient `R(x, y)`, bounded by `2L` since `‖Df(x)‖ ≤ L`
  let R : Euclid n → Euclid n → ℝ := fun x y => ‖f y - f x - fderiv ℝ f x (y - x)‖ / ‖y - x‖
  have hR_le : ∀ x y, R x y ≤ 2 * L := by
    intro x y
    refine div_le_of_le_mul₀ (norm_nonneg _) (by positivity) ?_
    calc ‖f y - f x - fderiv ℝ f x (y - x)‖ ≤ ‖f y - f x‖ + ‖fderiv ℝ f x (y - x)‖ :=
          norm_sub_le _ _
      _ ≤ L * ‖y - x‖ + L * ‖y - x‖ := by
          refine add_le_add ?_ ?_
          · rw [← dist_eq_norm, ← dist_eq_norm]
            exact hf.dist_le_mul y x
          · exact (ContinuousLinearMap.le_opNorm _ _).trans
              (mul_le_mul_of_nonneg_right (norm_fderiv_le_of_lipschitz ℝ hf) (norm_nonneg _))
      _ = 2 * L * ‖y - x‖ := by ring
  -- `η_k(x) = sup E_k(x)`, `E_k(x) = {R(x, y) : y ∈ C, 0 < |y − x| < 1/(k + 1)}`, on `C`
  let E : ℕ → Euclid n → Set ℝ := fun k x =>
    R x '' {y | y ∈ C ∧ 0 < dist y x ∧ dist y x < 1 / ((k : ℝ) + 1)}
  let η : ℕ → Euclid n → ℝ := fun k x => if x ∈ C then sSup (E k x) else 0
  have hη_nonneg : ∀ k x, 0 ≤ η k x := by
    intro k x
    by_cases hx : x ∈ C
    · simp only [η, ite_eq_left hx]
      exact Real.sSup_nonneg (by
        rintro _ ⟨y, -, rfl⟩
        exact div_nonneg (norm_nonneg _) (norm_nonneg _))
    · simp only [η, ite_eq_right hx, le_refl]
  have hR_le_η : ∀ (k : ℕ) x y, x ∈ C → y ∈ C → 0 < dist y x → dist y x < 1 / ((k : ℝ) + 1) →
      R x y ≤ η k x := by
    intro k x y hx hy h0 h1
    simp only [η, ite_eq_left hx]
    exact le_csSup ⟨2 * L, by rintro _ ⟨z, -, rfl⟩; exact hR_le x z⟩ ⟨y, ⟨hy, h0, h1⟩, rfl⟩
  -- `η_k(x) → 0` for `x ∈ C`, by differentiability of `f` at `x`
  have hη_tendsto : ∀ x ∈ C, Tendsto (fun k => η k x) atTop (𝓝 0) := by
    intro x hx
    rw [Metric.tendsto_atTop]
    intro e he
    obtain ⟨ρ, hρ, hρx⟩ :=
      Metric.eventually_nhds_iff.mp ((hdiff x hx).hasFDerivAt.isLittleO.bound (half_pos he))
    obtain ⟨N, hN⟩ := exists_nat_one_div_lt hρ
    refine ⟨N, fun k hk => ?_⟩
    have hle : η k x ≤ e / 2 := by
      simp only [η, ite_eq_left hx]
      refine Real.sSup_le ?_ (half_pos he).le
      rintro _ ⟨y, ⟨-, -, h1⟩, rfl⟩
      exact div_le_of_le_mul₀ (norm_nonneg _) (half_pos he).le
        (hρx (h1.trans_le ((Nat.one_div_le_one_div hk).trans hN.le)))
    rw [Real.dist_eq, sub_zero, abs_of_nonneg (hη_nonneg k x)]
    exact hle.trans_lt (half_lt_self he)
  -- `{η_k > t}` is relatively open in the closed set `C` for `t ≥ 0`, so `η_k` is Borel
  have hη_meas : ∀ k, Measurable (η k) := by
    intro k
    refine measurable_of_Ioi fun t => ?_
    rcases lt_or_ge t 0 with ht | ht
    · convert MeasurableSet.univ
      exact eq_univ_of_forall fun x => ht.trans_le (hη_nonneg k x)
    have hUC : η k ⁻¹' Ioi t ⊆ C := by
      intro x hx
      by_contra hxC
      have hx' : t < η k x := hx
      simp only [η, ite_eq_right hxC] at hx'
      exact absurd hx' (not_lt.mpr ht)
    have hnhds : ∀ x ∈ η k ⁻¹' Ioi t, η k ⁻¹' Ioi t ∪ Cᶜ ∈ 𝓝 x := by
      intro x hx
      have hxC := hUC hx
      have hxt : t < sSup (E k x) := by
        have hx' : t < η k x := hx
        simpa only [η, ite_eq_left hxC] using hx'
      have hne : (E k x).Nonempty := by
        by_contra hemp
        rw [not_nonempty_iff_eq_empty] at hemp
        rw [hemp, Real.sSup_empty] at hxt
        exact absurd hxt (not_lt.mpr ht)
      obtain ⟨_, ⟨y, ⟨hy, h0, h1⟩, rfl⟩, hty⟩ := exists_lt_of_lt_csSup hne hxt
      -- `z ↦ R(z, y)` is continuous within `C` at `x`, as `f` and `Df|_C` are continuous
      have hsub : ContinuousWithinAt (fun z => y - z) C x :=
        continuousWithinAt_const.sub continuousWithinAt_id
      have hnum : ContinuousWithinAt (fun z => ‖f y - f z - fderiv ℝ f z (y - z)‖) C x :=
        ((continuousWithinAt_const.sub hf.continuous.continuousWithinAt).sub
          ((hDf x hxC).clm_apply hsub)).norm
      have hRy : ContinuousWithinAt (fun z => R z y) C x :=
        hnum.div hsub.norm (norm_sub_pos_iff.mpr (dist_pos.mp h0)).ne'
      have hdist : Tendsto (fun z => dist y z) (𝓝 x) (𝓝 (dist y x)) :=
        tendsto_const_nhds.dist tendsto_id
      -- near `x`, every `z ∈ C` has `η_k(z) ≥ R(z, y) > t`
      filter_upwards [eventually_nhdsWithin_iff.mp (Filter.Tendsto.eventually_const_lt hty hRy),
        hdist.eventually_const_lt h0, hdist.eventually_lt_const h1] with z hz hz0 hz1
      by_cases hzC : z ∈ C
      · exact Or.inl ((hz hzC).trans_le (hR_le_η k z y hzC hy hz0 hz1))
      · exact Or.inr hzC
    have heq : η k ⁻¹' Ioi t = C ∩ interior (η k ⁻¹' Ioi t ∪ Cᶜ) := by
      refine Subset.antisymm
        (fun x hx => ⟨hUC hx, mem_interior_iff_mem_nhds.mpr (hnhds x hx)⟩) ?_
      rintro x ⟨hxC, hxI⟩
      rcases interior_subset hxI with hx | hx
      · exact hx
      · exact absurd hxC hx
    rw [heq]
    exact hC.measurableSet.inter isOpen_interior.measurableSet
  -- Egorov on `C`: a closed `A ⊆ C`, `Lⁿ(C \ A) < ε`, with `η_k → 0` uniformly on compact `Q ⊆ A`
  obtain ⟨A, hAC, hA, hCA, hunif⟩ := Submission.codim1_rdo_c1a_egorov_isClosed n C η
    (fun _ => 0) hC.measurableSet hη_meas measurable_const hη_tendsto ε hε
  refine ⟨A, hAC, hA, hCA, fun Q hQ hQA ε' hε' => ?_⟩
  -- `η_k < ε'` on `Q` for some `k`; take `δ = 1/(k + 1)`
  obtain ⟨k, hk⟩ := (Metric.tendstoUniformlyOn_iff.mp (hunif Q hQ hQA) ε' hε').exists
  refine ⟨1 / ((k : ℝ) + 1), Nat.one_div_pos_of_nat, fun x hx y hy hxy => ?_⟩
  rcases eq_or_ne y x with rfl | hyx
  · simp
  have h0 : 0 < dist y x := dist_pos.mpr hyx
  have hηx : η k x < ε' := by
    have hkx := hk x hx
    rw [dist_comm, Real.dist_eq, sub_zero] at hkx
    exact (le_abs_self _).trans_lt hkx
  have hR : R x y ≤ ε' :=
    (hR_le_η k x y (hAC (hQA hx)) (hAC hy) h0 (by rwa [dist_comm])).trans hηx.le
  exact (div_le_iff₀ (norm_sub_pos_iff.mpr hyx)).mp hR

/-- **`C¹` approximation** (Simon Ch. 2, Theorem 1.5).  If `f : ℝⁿ → ℝ` is `K`-Lipschitz and
`ε > 0`, there is `g ∈ C¹(ℝⁿ)` with `Lⁿ({f ≠ g} ∪ {Df ≠ Dg}) < ε`.  By Rademacher (1.4) `f` is
differentiable on a Borel set `B` of full measure.  Lusin gives a closed `C ⊆ B` with `Df|C`
continuous and `Lⁿ(B \ C) < ε/2`; the remainder estimate gives a closed `A ⊆ C` with
`Lⁿ(C \ A) < ε/2` on which `f, Df` satisfy Whitney's condition 1.6(∗); Whitney's extension
theorem (1.6) gives `g ∈ C¹` with `g = f` and `Dg = Df` on `A`.  The exceptional set lies in
`Aᶜ ⊆ Bᶜ ∪ (B \ C) ∪ (C \ A)`. -/
theorem Submission.codim1_rdo_c1_approximation : ∀ (n : ℕ) (f : Euclid n → ℝ) (K : NNReal), LipschitzWith K f → ∀ ε : ℝ≥0∞, 0 < ε → ∃ g : Euclid n → ℝ, ContDiff ℝ 1 g ∧ volume {x | f x ≠ g x ∨ fderiv ℝ f x ≠ fderiv ℝ g x} < ε := by
  intro n f K hf ε hε
  -- Rademacher: `f` is differentiable on the Borel set `B`, whose complement is null
  set B : Set (Euclid n) := {x | DifferentiableAt ℝ f x}
  have hBm : MeasurableSet B := measurableSet_of_differentiableAt ℝ f
  have hBc : volume Bᶜ = 0 := ae_iff.mp hf.ae_differentiableAt
  -- Lusin: a closed `C ⊆ B` with `Df` continuous on `C` and `Lⁿ(B \ C) < ε/2`
  obtain ⟨C, hCB, hC, hDC, hBC⟩ := Submission.codim1_rdo_c1a_lusin_isClosed n (fderiv ℝ f) B
    (measurable_fderiv ℝ f) hBm (ε / 2) (ENNReal.half_pos hε.ne')
  -- a closed `A ⊆ C` with `Lⁿ(C \ A) < ε/2` on which Whitney's condition 1.6(∗) holds
  obtain ⟨A, hAC, hA, hCA, hR⟩ := Submission.codim1_rdo_c1a_whitney_remainder n f K C hf hC
    (fun x hx => hCB hx) hDC (ε / 2) (ENNReal.half_pos hε.ne')
  -- Whitney: `g ∈ C¹` with `g = f` and `Dg = Df` on `A`
  obtain ⟨g, hg, hgf, hDg⟩ := Submission.codim1_rdo_c1a_whitney_extension n A f (fderiv ℝ f) hA
    hf.continuous.continuousOn (hDC.mono hAC) hR
  refine ⟨g, hg, ?_⟩
  -- the exceptional set misses `A`, and `Aᶜ ⊆ Bᶜ ∪ (B \ C) ∪ (C \ A)`
  calc volume {x | f x ≠ g x ∨ fderiv ℝ f x ≠ fderiv ℝ g x}
      ≤ volume (Bᶜ ∪ (B \ C) ∪ (C \ A)) := by
        refine measure_mono fun x hx => ?_
        by_cases hxA : x ∈ A
        · rcases hx with hfg | hfg
          · exact absurd (hgf hxA).symm hfg
          · exact absurd (hDg x hxA).fderiv.symm hfg
        by_cases hxC : x ∈ C
        · exact Or.inr ⟨hxC, hxA⟩
        by_cases hxB : x ∈ B
        · exact Or.inl (Or.inr ⟨hxB, hxC⟩)
        · exact Or.inl (Or.inl hxB)
    _ ≤ volume (Bᶜ ∪ (B \ C)) + volume (C \ A) := measure_union_le _ _
    _ ≤ volume Bᶜ + volume (B \ C) + volume (C \ A) := by gcongr; exact measure_union_le _ _
    _ < ε / 2 + ε / 2 := by
        rw [hBc, zero_add]
        exact ENNReal.add_lt_add hBC hCA
    _ = ε := ENNReal.add_halves ε

/-- **Simon Ch. 3, Lemma 1.2, "only if"** (chapter-03.txt lines 39–65, in the lemma at lines
25–66), in quantitative form: a countably `n`-rectifiable `M ⊆ ℝᴾ` is covered, up to an
`Hⁿ`-null set, by countably many images `Nₖ = gₖ(B_{rₖ}(cₖ))` of open balls under C¹ maps
`gₖ : ℝⁿ → ℝᴾ` with lower Lipschitz bounds `mₖ|a − b| ≤ |gₖ(a) − gₖ(b)|` on the balls, each `Nₖ`
Borel with `Hⁿ(Nₖ) < ∞`.  By Definition 1.1, `M ⊆ M₀ ∪ ⋃ⱼ Fⱼ(ℝⁿ)` with `Hⁿ(M₀) = 0` and `Fⱼ`
Lipschitz.  The C¹ approximation theorem (Simon Ch. 2, 1.5) covers `Fⱼ(ℝⁿ)` by C¹ images
`Gⱼᵢ(ℝⁿ)` up to a null set, and `Gⱼᵢ(ℝⁿ)` is covered, up to its null critical image, by images of
balls carrying lower Lipschitz bounds.  The triples `(j, i, q)` are enumerated by applying
`Nat.unpair` twice. -/
theorem Submission.codim1_rdo_rectifiable_c1_cover : ∀ (P n : ℕ) (M : Set (Euclid P)), CountablyRectifiable n M → ∃ (g : ℕ → Euclid n → Euclid P) (c : ℕ → Euclid n) (r m : ℕ → ℝ), (∀ k, ContDiff ℝ 1 (g k)) ∧ (∀ k, 0 < m k) ∧ (∀ k, ∀ a ∈ ball (c k) (r k), ∀ b ∈ ball (c k) (r k), m k * ‖a - b‖ ≤ ‖g k a - g k b‖) ∧ (∀ k, MeasurableSet (g k '' ball (c k) (r k))) ∧ (∀ k, μHE[n] (g k '' ball (c k) (r k)) ≠ ∞) ∧ μHE[n] (M \ ⋃ k, g k '' ball (c k) (r k)) = 0 := by
  intro P n M hM
  -- Step 1 (Definition 1.1): `M ⊆ M₀ ∪ ⋃ⱼ Fⱼ(ℝⁿ)` with `Hⁿ(M₀) = 0` and `Fⱼ` `Kⱼ`-Lipschitz.
  obtain ⟨M₀, hM₀, F, hF, hcover⟩ := hM
  choose K hK using hF
  -- Steps 2–3: C¹ maps `Gⱼᵢ` with `Hⁿ(Fⱼ(ℝⁿ) ∖ ⋃ᵢ Gⱼᵢ(ℝⁿ)) = 0`, by the C¹ approximation theorem.
  choose G hG hFG using fun j => Submission.codim1_rdo_c1cov_lipschitz_range_c1_cover P n
    (Submission.codim1_rdo_c1_approximation n) (F j) (K j) (hK j)
  -- Steps 4–6: balls `B_{rⱼᵢq}(cⱼᵢq)` on which `Gⱼᵢ` has lower Lipschitz constant `mⱼᵢq > 0`,
  -- whose images cover `Gⱼᵢ(ℝⁿ)` up to an `Hⁿ`-null set.
  choose c r m hm hlow hGB using fun j i => Submission.codim1_rdo_c1cov_regular_ball_cover P n
    (G j i) (hG j i)
  -- Step 7: `k ↦ (J k, I k, Q k)` maps `ℕ` onto `ℕ³` (`Nat.unpair` applied twice).
  obtain ⟨J, I, Q, hJIQ⟩ : ∃ J I Q : ℕ → ℕ, ∀ j i q, ∃ k, J k = j ∧ I k = i ∧ Q k = q :=
    ⟨fun k => k.unpair.1, fun k => k.unpair.2.unpair.1, fun k => k.unpair.2.unpair.2,
      fun j i q => ⟨Nat.pair j (Nat.pair i q), by simp⟩⟩
  -- Step 8: the pieces `Nₖ` are Borel with finite `Hⁿ`-measure.
  have hN k := Submission.codim1_rdo_c1cov_image_ball_borel_finite P n (G (J k) (I k))
    (c (J k) (I k) (Q k)) (r (J k) (I k) (Q k)) (hG (J k) (I k))
  refine ⟨fun k => G (J k) (I k), fun k => c (J k) (I k) (Q k), fun k => r (J k) (I k) (Q k),
    fun k => m (J k) (I k) (Q k), fun k => hG _ _, fun k => hm _ _ _, fun k => hlow _ _ _,
    fun k => (hN k).1, fun k => (hN k).2, ?_⟩
  -- Step 9: `M ∖ ⋃ₖ Nₖ` lies in the countable union of `Hⁿ`-null sets
  -- `M₀ ∪ ⋃ⱼ (Fⱼ(ℝⁿ) ∖ ⋃ᵢ Gⱼᵢ(ℝⁿ)) ∪ ⋃ⱼ ⋃ᵢ (Gⱼᵢ(ℝⁿ) ∖ ⋃_q Gⱼᵢ(B_{rⱼᵢq}(cⱼᵢq)))`.
  refine measure_mono_null ?_ (measure_union_null hM₀ (measure_union_null (measure_iUnion_null hFG)
    (measure_iUnion_null fun j => measure_iUnion_null (hGB j))))
  rintro y ⟨hyM, hyN⟩
  rcases hcover hyM with hy₀ | hyF
  · exact Or.inl hy₀
  obtain ⟨j, hyj⟩ := mem_iUnion.1 hyF
  by_cases hyG : y ∈ ⋃ i, range (G j i)
  · obtain ⟨i, hyi⟩ := mem_iUnion.1 hyG
    by_cases hyB : y ∈ ⋃ q, G j i '' ball (c j i q) (r j i q)
    · obtain ⟨q, hyq⟩ := mem_iUnion.1 hyB
      obtain ⟨k, rfl, rfl, rfl⟩ := hJIQ j i q
      exact absurd (mem_iUnion.2 ⟨k, hyq⟩) hyN
    · exact Or.inr (Or.inr (mem_iUnion.2 ⟨j, mem_iUnion.2 ⟨i, hyi, hyB⟩⟩))
  · exact Or.inr (Or.inl (mem_iUnion.2 ⟨j, hyj, hyG⟩))
/-- A lower Lipschitz bound at a point passes to the derivative (step 1 of the `C¹`-piece tangent
argument, Simon Ch. 3, 1.6): if `U` is open, `a ∈ U`, `g` is differentiable at `a` and
`m|x − a| ≤ |g(x) − g(a)|` on `U`, then `m|v| ≤ |Dg(a)v|`.  For small `t > 0`, `a + tv ∈ U`
gives `m|v| ≤ |t⁻¹(g(a + tv) − g(a))|`, and the quotients tend to `Dg(a)v` as `t ↓ 0`. -/
theorem Submission.codim1_rdo_c1pt_fderiv_lower_bound : ∀ (P n : ℕ) (g : Euclid n → Euclid P) (U : Set (Euclid n)) (a : Euclid n) (m : ℝ), IsOpen U → a ∈ U → DifferentiableAt ℝ g a → (∀ x ∈ U, m * ‖x - a‖ ≤ ‖g x - g a‖) → ∀ v : Euclid n, m * ‖v‖ ≤ ‖fderiv ℝ g a v‖ := by
  intro P n g U a m hU ha hg hm v
  -- difference quotients `q(t) = t⁻¹ • (g (a + t • v) - g a)` tend to `Dg(a) v` as `t ↓ 0`
  have hq : Tendsto (fun t : ℝ => t⁻¹ • (g (a + t • v) - g a)) (𝓝[>] 0)
      (𝓝 (fderiv ℝ g a v)) := by
    simpa only [inv_inv] using hg.hasFDerivAt.lim v (c := fun t : ℝ => t⁻¹)
      (tendsto_norm_atTop_atTop.comp tendsto_inv_nhdsGT_zero)
  -- `a + t • v → a` as `t → 0`, so `a + t • v ∈ U` for small `t` (`U` is a neighbourhood of `a`)
  have hline : Tendsto (fun t : ℝ => a + t • v) (𝓝 0) (𝓝 a) :=
    (continuous_const.add (continuous_id.smul continuous_const)).tendsto' 0 a (by simp)
  -- for small `t > 0`: `t * (m‖v‖) ≤ ‖g (a + t • v) - g a‖`, i.e. `m‖v‖ ≤ ‖q(t)‖`
  have hle : ∀ᶠ t in 𝓝[>] (0 : ℝ), m * ‖v‖ ≤ ‖t⁻¹ • (g (a + t • v) - g a)‖ := by
    filter_upwards [nhdsWithin_le_nhds (hline (hU.mem_nhds ha)), self_mem_nhdsWithin]
      with t htU ht
    have ht : (0 : ℝ) < t := ht
    have h := hm _ htU
    rw [add_sub_cancel_left, norm_smul, Real.norm_of_nonneg ht.le, mul_left_comm] at h
    rwa [norm_smul, Real.norm_of_nonneg (inv_nonneg.2 ht.le), le_inv_mul_iff₀ ht]
  -- the non-strict inequality passes to the limit along the nontrivial filter `𝓝[>] 0`
  exact ge_of_tendsto hq.norm hle
/-- **Simon Ch. 2, (3.2) and (3.5)** (area formula for the blow-ups of an injective regular
image): if `g` is differentiable on the Borel set `B`, injective on `B` and `Dg(a)` is injective
for `a ∈ B`, then for `s > 0`, every `z` and every `f`,
`∫_{η_{g(z),s}(g(B))} f dHⁿ = ∫_{B_s} J_g(z + s b) f(s⁻¹(g(z + s b) − g(z))) dLⁿ(b)`, where
`B_s = {b | z + s b ∈ B}` and `J_g = √det(Dg* ∘ Dg)`.  The rescaled map
`φ(b) = s⁻¹(g(z + s b) − g(z))` is injective on `B_s` with `Dφ(b) = Dg(z + s b)` and
`φ(B_s) = η_{g(z),s}(g(B))`, so this is the area formula for `φ`.  That formula is proved in
place: the linear case (3.1), sharp `Hⁿ` estimates for maps close to an injective linear map,
a measurable partition into such pieces, and the transport of the Jacobian-weighted measure,
following the pinned SimonGMT `Chapter02.AreaApproximation`, `AreaDerivative`, `AreaFormula`
and `WeightedArea` proofs, which lie outside this file's imports. -/
theorem Submission.codim1_rdo_c1pt_rescaled_area_formula : ∀ (P n : ℕ) (g : Euclid n → Euclid P) (B : Set (Euclid n)) (z : Euclid n) (s : ℝ) (f : Euclid P → ℝ), MeasurableSet B → (∀ a ∈ B, DifferentiableAt ℝ g a) → InjOn g B → (∀ a ∈ B, Injective (fderiv ℝ g a)) → 0 < s → ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap (g z) s '' (g '' B), f y ∂μHE[n] = ∫ b in {b : Euclid n | z + s • b ∈ B}, Real.sqrt (((fderiv ℝ g (z + s • b)).adjoint ∘L fderiv ℝ g (z + s • b)).det) * f (s⁻¹ • (g (z + s • b) - g z)) := by
  intro P n g B z s f hB hdiff hinj hreg hs
  classical
  -- `J(L) = √det(L* ∘ L)` is the metric Jacobian of a linear map `L : ℝⁿ → ℝᴾ`
  obtain ⟨J, hJdef⟩ : ∃ J : (Euclid n →L[ℝ] Euclid P) → ℝ,
      J = fun L => Real.sqrt ((L.adjoint ∘L L).det) := ⟨_, rfl⟩
  have hJnonneg : ∀ L, 0 ≤ J L := fun L => by rw [hJdef]; exact Real.sqrt_nonneg _
  have hJcont : Continuous J := by
    rw [hJdef]
    exact Real.continuous_sqrt.comp (ContinuousLinearMap.continuous_det.comp
      (Continuous.clm_comp ContinuousLinearMap.adjoint.continuous continuous_id))
  /- Simon (3.1), the linear area formula: an injective `L` factors as `ι ∘ M` with `ι` a
  linear isometry onto its range and `M` an endomorphism of `ℝⁿ`, so
  `Hⁿ(L(A)) = Lⁿ(M(A)) = |det M| Lⁿ(A)`, and `J(L)² = det(M* M) = (det M)² ≠ 0`. -/
  have hlin : ∀ L : Euclid n →L[ℝ] Euclid P, Injective L →
      0 < J L ∧ ∀ A : Set (Euclid n), μHE[n] (L '' A) = ENNReal.ofReal (J L) * volume A := by
    intro L hL
    have hV : Module.finrank ℝ (LinearMap.range (L : Euclid n →ₗ[ℝ] Euclid P)) = n := by
      rw [LinearMap.finrank_range_of_inj hL, finrank_euclideanSpace_fin]
    let e : LinearMap.range (L : Euclid n →ₗ[ℝ] Euclid P) ≃ₗᵢ[ℝ] Euclid n :=
      ((stdOrthonormalBasis ℝ _).reindex (finCongr hV)).repr
    let ιI : Euclid n →ₗᵢ[ℝ] Euclid P :=
      (LinearMap.range (L : Euclid n →ₗ[ℝ] Euclid P)).subtypeₗᵢ.comp e.symm.toLinearIsometry
    let M : Euclid n →L[ℝ] Euclid n := (e : _ →L[ℝ] Euclid n) ∘L L.rangeRestrict
    have hLιM : L = ιI.toContinuousLinearMap ∘L M := by
      ext1 x
      show L x = ((e.symm (e (L.rangeRestrict x)) :
        LinearMap.range (L : Euclid n →ₗ[ℝ] Euclid P)) : Euclid P)
      rw [LinearIsometryEquiv.symm_apply_apply]
      rfl
    have hιadj : ιI.toContinuousLinearMap.adjoint ∘L ιI.toContinuousLinearMap = 1 :=
      (ContinuousLinearMap.norm_map_iff_adjoint_comp_self _).mp ιI.norm_map
    have hdetadj : (ContinuousLinearMap.adjoint M).det = M.det := by
      have h := congrArg Matrix.det (LinearMap.toMatrix_adjoint (EuclideanSpace.basisFun (Fin n) ℝ)
        (EuclideanSpace.basisFun (Fin n) ℝ) (M : Euclid n →ₗ[ℝ] Euclid n))
      rw [Matrix.det_conjTranspose, LinearMap.det_toMatrix, LinearMap.det_toMatrix] at h
      simp only [star_trivial] at h
      exact h
    have hdet : (L.adjoint ∘L L).det = M.det ^ 2 := by
      have h1 : L.adjoint ∘L L = M.adjoint ∘L M := by
        rw [hLιM, ContinuousLinearMap.adjoint_comp, ContinuousLinearMap.comp_assoc,
          ← ContinuousLinearMap.comp_assoc _ _ M, hιadj, ContinuousLinearMap.one_def,
          ContinuousLinearMap.id_comp]
      have h2 : (M.adjoint ∘L M).det = M.adjoint.det * M.det :=
        LinearMap.det_comp _ _
      rw [h1, h2, hdetadj, sq]
    have hJ : J L = |M.det| := by
      rw [hJdef]
      dsimp only
      rw [hdet, Real.sqrt_sq_eq_abs]
    have hMinj : LinearMap.ker (M : Euclid n →ₗ[ℝ] Euclid n) = ⊥ := by
      rw [LinearMap.ker_eq_bot]
      intro x y hxy
      apply hL
      have h := congrArg (fun v => ((e.symm v : LinearMap.range (L : Euclid n →ₗ[ℝ] Euclid P)) :
        Euclid P)) hxy
      simpa [M] using h
    refine ⟨?_, fun A => ?_⟩
    · rw [hJ]
      exact abs_pos.mpr (fun h => (LinearMap.det_eq_zero_iff_ker_ne_bot.mp h) hMinj)
    · rw [hJ, hLιM, ContinuousLinearMap.coe_comp, Set.image_comp,
        LinearIsometry.coe_toContinuousLinearMap, ιI.isometry.euclideanHausdorffMeasure_image,
        EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
      exact MeasureTheory.Measure.addHaar_image_linearMap volume (M : Euclid n →ₗ[ℝ] Euclid n) A
  -- comparison of pairwise distances gives comparison of the `Hⁿ` measures of the images
  have hdistcmp : ∀ (u v : Euclid n → Euclid P) (T : Set (Euclid n)) (K : NNReal), InjOn v T →
      (∀ x ∈ T, ∀ y ∈ T, dist (u x) (u y) ≤ K * dist (v x) (v y)) →
      μHE[n] (u '' T) ≤ (K : ℝ≥0∞) ^ n * μHE[n] (v '' T) := by
    intro u v T K hv hK
    have hh : LipschitzOnWith K (u ∘ invFunOn v T) (v '' T) := by
      rw [lipschitzOnWith_iff_dist_le_mul]
      rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
      simpa only [comp_apply, hv.leftInvOn_invFunOn hx, hv.leftInvOn_invFunOn hy] using hK x hx y hy
    have himage : (u ∘ invFunOn v T) '' (v '' T) = u '' T := by
      rw [image_comp, hv.invFunOn_image Subset.rfl]
    simpa only [himage] using
      Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n hh
  /- Near an injective `L`, one radius `δ` controls both the Jacobian of nearby linear maps and
  the `Hⁿ` measure of images under maps `δ`-approximating `L`, up to a factor `q > 1`. -/
  have hradius : ∀ L : Euclid n →L[ℝ] Euclid P, Injective L → ∀ q : NNReal, 1 < q →
      ∃ δ : NNReal, 0 < δ ∧
        (∀ L' : Euclid n →L[ℝ] Euclid P, ‖L' - L‖ ≤ δ →
          ENNReal.ofReal (J L') ≤ q * ENNReal.ofReal (J L) ∧
            ENNReal.ofReal (J L) ≤ q * ENNReal.ofReal (J L')) ∧
        (∀ (T : Set (Euclid n)) (u : Euclid n → Euclid P), ApproximatesLinearOn u L T δ →
          μHE[n] (u '' T) ≤ q * μHE[n] (L '' T) ∧ μHE[n] (L '' T) ≤ q * μHE[n] (u '' T)) := by
    intro L hL q hq
    obtain ⟨K, -, hK⟩ := (L : Euclid n →ₗ[ℝ] Euclid P).exists_antilipschitzWith
      (LinearMap.ker_eq_bot.mpr hL)
    have hqR : (1 : ℝ) < q := hq
    have hJpos := (hlin L hL).1
    have hmul : J L < (q : ℝ) * J L := lt_mul_of_one_lt_left hJpos hqR
    have hnear : ∀ᶠ L' in 𝓝 L, J L' < (q : ℝ) * J L ∧ J L < (q : ℝ) * J L' :=
      (hJcont.continuousAt.eventually_lt continuousAt_const hmul).and
        (continuousAt_const.eventually_lt (continuousAt_const.mul hJcont.continuousAt) hmul)
    obtain ⟨ε, hε, hnear⟩ := Metric.eventually_nhds_iff.mp hnear
    have hsmall : ∀ᶠ δ : NNReal in 𝓝 0, δ * K < 1 :=
      (continuousAt_id.mul continuousAt_const).eventually_lt continuousAt_const (by simp)
    have hupper : ∀ᶠ δ : NNReal in 𝓝 0, (1 + δ * K) ^ n < q :=
      ((continuousAt_const.add (continuousAt_id.mul continuousAt_const)).pow _).eventually_lt
        continuousAt_const (by simpa using hq)
    have hlower : ∀ᶠ δ : NNReal in 𝓝 0, ((1 - δ * K)⁻¹) ^ n < q := by
      apply ContinuousAt.eventually_lt _ continuousAt_const (by simpa using hq)
      apply ContinuousAt.pow
      apply ContinuousAt.inv₀
      · exact continuousAt_const.sub (continuousAt_id.mul continuousAt_const)
      · simp
    have hεev : ∀ᶠ δ : NNReal in 𝓝 0, (δ : ℝ) < ε :=
      (NNReal.continuous_coe.continuousAt.eventually_lt continuousAt_const (by simpa using hε))
    have hevent : ∀ᶠ δ : NNReal in 𝓝[>] 0,
        0 < δ ∧ δ * K < 1 ∧ (1 + δ * K) ^ n < q ∧ ((1 - δ * K)⁻¹) ^ n < q ∧ (δ : ℝ) < ε := by
      filter_upwards [self_mem_nhdsWithin, hsmall.filter_mono nhdsWithin_le_nhds,
        hupper.filter_mono nhdsWithin_le_nhds, hlower.filter_mono nhdsWithin_le_nhds,
        hεev.filter_mono nhdsWithin_le_nhds] with δ hδ h1 h2 h3 h4
      exact ⟨hδ, h1, h2, h3, h4⟩
    obtain ⟨δ, hδ, hδK, hδupper, hδlower, hδε⟩ := hevent.exists
    -- `‖(u x - u y) - L(x - y)‖ ≤ δ K ‖L x - L y‖` on `T`
    have herror : ∀ (T : Set (Euclid n)) (u : Euclid n → Euclid P),
        ApproximatesLinearOn u L T δ → ∀ x ∈ T, ∀ y ∈ T,
          ‖u x - u y - (L x - L y)‖ ≤ (δ : ℝ) * K * ‖L x - L y‖ := by
      intro T u hu x hx y hy
      have hb : ‖x - y‖ ≤ K * ‖L x - L y‖ := by
        simpa only [dist_eq_norm, ContinuousLinearMap.coe_coe] using hK.le_mul_dist x y
      calc ‖u x - u y - (L x - L y)‖ ≤ δ * ‖x - y‖ := by simpa only [map_sub] using hu x hx y hy
        _ ≤ δ * (K * ‖L x - L y‖) := mul_le_mul_of_nonneg_left hb δ.2
        _ = (δ : ℝ) * K * ‖L x - L y‖ := by ring
    refine ⟨δ, hδ, fun L' hL' => ?_, fun T u hu => ⟨?_, ?_⟩⟩
    · have hdist : dist L' L < ε := by
        rw [dist_eq_norm]
        exact hL'.trans_lt hδε
      obtain ⟨h1, h2⟩ := hnear hdist
      constructor
      · rw [← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_mul (NNReal.coe_nonneg q)]
        exact ENNReal.ofReal_le_ofReal h1.le
      · rw [← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_mul (NNReal.coe_nonneg q)]
        exact ENNReal.ofReal_le_ofReal h2.le
    · refine (hdistcmp u L T (1 + δ * K) hL.injOn fun x hx y hy => ?_).trans ?_
      · simp only [dist_eq_norm, NNReal.coe_add, NNReal.coe_one, NNReal.coe_mul]
        calc ‖u x - u y‖ ≤ ‖u x - u y - (L x - L y)‖ + ‖L x - L y‖ := norm_le_norm_sub_add _ _
          _ ≤ (δ : ℝ) * K * ‖L x - L y‖ + ‖L x - L y‖ :=
            add_le_add (herror T u hu x hx y hy) le_rfl
          _ = (1 + (δ : ℝ) * K) * ‖L x - L y‖ := by ring
      · gcongr
        rw [← ENNReal.coe_pow]
        exact ENNReal.coe_le_coe.mpr hδupper.le
    · have hδR : (δ : ℝ) * K < 1 := hδK
      have hdist : ∀ x ∈ T, ∀ y ∈ T,
          dist (L x) (L y) ≤ ((1 - δ * K)⁻¹ : NNReal) * dist (u x) (u y) := by
        intro x hx y hy
        have h1 := herror T u hu x hx y hy
        have htriangle := norm_le_norm_add_norm_sub (u x - u y) (L x - L y)
        rw [dist_eq_norm, dist_eq_norm, NNReal.coe_inv, NNReal.coe_sub hδK.le, NNReal.coe_one,
          NNReal.coe_mul, inv_mul_eq_div, le_div_iff₀ (sub_pos.mpr hδR)]
        linarith only [h1, htriangle]
      have huinj : InjOn u T := by
        intro x hx y hy hxy
        apply hL
        apply dist_le_zero.mp
        simpa only [hxy, dist_self, mul_zero] using hdist x hx y hy
      refine (hdistcmp L u T _ huinj hdist).trans ?_
      gcongr
      rw [← ENNReal.coe_pow]
      exact ENNReal.coe_le_coe.mpr hδlower.le
  /- On almost every point of a measurable piece where `u` is `δ`-approximated by `A`, the
  derivative is `δ`-close to `A` (the density-point argument of Mathlib's
  `ApproximatesLinearOn.norm_fderiv_sub_le`, for rectangular derivatives). -/
  have hderivbound : ∀ (u : Euclid n → Euclid P) (T : Set (Euclid n)) (A : Euclid n →L[ℝ] Euclid P)
      (δ : NNReal) (u' : Euclid n → Euclid n →L[ℝ] Euclid P), ApproximatesLinearOn u A T δ →
      MeasurableSet T → (∀ x ∈ T, HasFDerivWithinAt u (u' x) T x) →
      ∀ᵐ x ∂(volume.restrict T), ‖u' x - A‖₊ ≤ δ := by
    intro u T A δ u' hf hT hf'
    filter_upwards [Besicovitch.ae_tendsto_measure_inter_div volume T, ae_restrict_mem hT]
    intro x hx xT
    apply ContinuousLinearMap.opNorm_le_bound _ δ.2 fun w => ?_
    suffices H : ∀ ε, 0 < ε → ‖(u' x - A) w‖ ≤ (δ + ε) * (‖w‖ + ε) + ‖u' x - A‖ * ε by
      have : Tendsto (fun ε : ℝ => ((δ : ℝ) + ε) * (‖w‖ + ε) + ‖u' x - A‖ * ε) (𝓝[>] 0)
          (𝓝 ((δ + 0) * (‖w‖ + 0) + ‖u' x - A‖ * 0)) :=
        Tendsto.mono_left (Continuous.tendsto (by fun_prop) 0) nhdsWithin_le_nhds
      simp only [add_zero, mul_zero] at this
      apply le_of_tendsto_of_tendsto tendsto_const_nhds this
      filter_upwards [self_mem_nhdsWithin]
      exact H
    intro ε εpos
    have B₁ := MeasureTheory.Measure.eventually_nonempty_inter_smul_of_density_one volume T x hx
      (closedBall w ε) measurableSet_closedBall (measure_closedBall_pos volume w εpos).ne'
    obtain ⟨ρ, ρpos, hρ⟩ :
        ∃ ρ > 0, ball x ρ ∩ T ⊆ {y : Euclid n | ‖u y - u x - (u' x) (y - x)‖ ≤ ε * ‖y - x‖} :=
      mem_nhdsWithin_iff.1 (Asymptotics.isLittleO_iff.mp (hf' x xT).isLittleO εpos)
    have B₂ := (eventually_singleton_add_smul_subset (𝕜 := ℝ) (x := x)
      (isBounded_closedBall (x := w) (r := ε)) (ball_mem_nhds x ρpos)).filter_mono
        (nhdsWithin_le_nhds (s := Ioi (0 : ℝ)))
    obtain ⟨r, ⟨y, ⟨yT, hy⟩⟩, rρ, rpos⟩ := (B₁.and (B₂.and self_mem_nhdsWithin)).exists
    obtain ⟨a, aw, ya⟩ : ∃ a, a ∈ closedBall w ε ∧ y = x + r • a := by
      have hy' := hy
      simp only [mem_smul_set, image_add_left, mem_preimage, singleton_add] at hy'
      rcases hy' with ⟨a, aw, ha⟩
      exact ⟨a, aw, by simp only [ha, add_neg_cancel_left]⟩
    have norm_a : ‖a‖ ≤ ‖w‖ + ε :=
      calc ‖a‖ = ‖w + (a - w)‖ := by simp only [add_sub_cancel]
        _ ≤ ‖w‖ + ‖a - w‖ := norm_add_le _ _
        _ ≤ ‖w‖ + ε := by grw [mem_closedBall_iff_norm.1 aw]
    have I : r * ‖(u' x - A) a‖ ≤ r * (δ + ε) * (‖w‖ + ε) :=
      calc r * ‖(u' x - A) a‖ = ‖(u' x - A) (r • a)‖ := by
            simp only [map_smul, norm_smul, Real.norm_eq_abs, abs_of_nonneg rpos.le]
        _ = ‖u y - u x - A (y - x) - (u y - u x - (u' x) (y - x))‖ := by
            simp only [ya, add_sub_cancel_left, sub_sub_sub_cancel_left, FunLike.coe_sub,
              Pi.sub_apply, map_smul, smul_sub]
        _ ≤ ‖u y - u x - A (y - x)‖ + ‖u y - u x - (u' x) (y - x)‖ := norm_sub_le _ _
        _ ≤ δ * ‖y - x‖ + ε * ‖y - x‖ := add_le_add (hf _ yT _ xT) (hρ ⟨rρ hy, yT⟩)
        _ = r * (δ + ε) * ‖a‖ := by
            simp only [ya, add_sub_cancel_left, norm_smul, Real.norm_eq_abs, abs_of_nonneg rpos.le]
            ring
        _ ≤ r * (δ + ε) * (‖w‖ + ε) := by gcongr
    calc ‖(u' x - A) w‖ = ‖(u' x - A) a + (u' x - A) (w - a)‖ := by
          congr 1
          simp only [FunLike.coe_sub, map_sub, Pi.sub_apply]
          abel
      _ ≤ ‖(u' x - A) a‖ + ‖(u' x - A) (w - a)‖ := norm_add_le _ _
      _ ≤ (δ + ε) * (‖w‖ + ε) + ‖u' x - A‖ * ‖w - a‖ := by
          apply add_le_add
          · rw [mul_assoc] at I
            exact (mul_le_mul_iff_right₀ rpos).1 I
          · apply ContinuousLinearMap.le_opNorm
      _ ≤ (δ + ε) * (‖w‖ + ε) + ‖u' x - A‖ * ε := by
          rw [mem_closedBall_iff_norm'] at aw
          gcongr
  /- Simon (3.2), measure form: for `u` injective on a measurable `T`, differentiable along `T`
  with injective derivative `u'`, `Hⁿ(u(T)) = ∫_T J(u'(x)) dLⁿ(x)`.  Partition `T` into
  measurable pieces on which `u` is close to linear maps `A i = u'(yᵢ)`, compare on each piece
  up to a factor `q²`, sum, and let `q ↓ 1`. -/
  have hmeasure : ∀ (T : Set (Euclid n)) (u : Euclid n → Euclid P)
      (u' : Euclid n → Euclid n →L[ℝ] Euclid P), MeasurableSet T →
      (∀ x ∈ T, HasFDerivWithinAt u (u' x) T x) → (∀ x ∈ T, Injective (u' x)) → InjOn u T →
      μHE[n] (u '' T) = ∫⁻ x in T, ENNReal.ofReal (J (u' x)) := by
    intro T u u' hT hu' hreg' hinj'
    have hcmp : ∀ q : NNReal, 1 < q →
        μHE[n] (u '' T) ≤ (q : ℝ≥0∞) ^ 2 * ∫⁻ x in T, ENNReal.ofReal (J (u' x)) ∧
          ∫⁻ x in T, ENNReal.ofReal (J (u' x)) ≤ (q : ℝ≥0∞) ^ 2 * μHE[n] (u '' T) := by
      intro q hq
      rcases eq_empty_or_nonempty T with rfl | hTne
      · simp
      have hchoice : ∀ L : Euclid n →L[ℝ] Euclid P, ∃ δ : NNReal, 0 < δ ∧ (Injective L →
          (∀ L' : Euclid n →L[ℝ] Euclid P, ‖L' - L‖ ≤ δ →
            ENNReal.ofReal (J L') ≤ q * ENNReal.ofReal (J L) ∧
              ENNReal.ofReal (J L) ≤ q * ENNReal.ofReal (J L')) ∧
          (∀ (T' : Set (Euclid n)) (v : Euclid n → Euclid P), ApproximatesLinearOn v L T' δ →
            μHE[n] (v '' T') ≤ q * μHE[n] (L '' T') ∧
              μHE[n] (L '' T') ≤ q * μHE[n] (v '' T'))) := by
        intro L
        by_cases hL : Injective L
        · obtain ⟨δ, hδ, h1, h2⟩ := hradius L hL q hq
          exact ⟨δ, hδ, fun _ => ⟨h1, h2⟩⟩
        · exact ⟨1, one_pos, fun h => (hL h).elim⟩
      choose δ hδpos hδ using hchoice
      obtain ⟨t, A, hdisj, ht, hcover, happrox, hactual⟩ :=
        exists_partition_approximatesLinearOn_of_hasFDerivWithinAt u T u' hu' δ
          (fun L => (hδpos L).ne')
      have hAreg : ∀ i, Injective (A i) := by
        intro i
        obtain ⟨x, hx, hA⟩ := hactual hTne i
        rw [hA]
        exact hreg' x hx
      have hTeq : T = ⋃ i, T ∩ t i := by
        rw [← inter_iUnion]
        exact Subset.antisymm (subset_inter Subset.rfl hcover) inter_subset_left
      have hsumimage : μHE[n] (u '' T) = ∑' i, μHE[n] (u '' (T ∩ t i)) := by
        conv_lhs => rw [hTeq, image_iUnion]
        apply measure_iUnion
        · intro i j hij
          exact Disjoint.image (Disjoint.mono inter_subset_right inter_subset_right (hdisj hij))
            hinj' inter_subset_left inter_subset_left
        · intro i
          apply (hT.inter (ht i)).image_of_continuousOn_injOn
          · exact fun x hx => (hu' x hx.1).continuousWithinAt.mono inter_subset_left
          · exact hinj'.mono inter_subset_left
      have hsumintegral : ∫⁻ x in T, ENNReal.ofReal (J (u' x)) =
          ∑' i, ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x)) := by
        conv_lhs => rw [hTeq]
        exact lintegral_iUnion (fun i => hT.inter (ht i))
          (pairwise_disjoint_mono hdisj (fun _ => inter_subset_right)) _
      have hpiece : ∀ i, μHE[n] (u '' (T ∩ t i)) ≤
            (q : ℝ≥0∞) ^ 2 * ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x)) ∧
          ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x)) ≤
            (q : ℝ≥0∞) ^ 2 * μHE[n] (u '' (T ∩ t i)) := by
        intro i
        have hJ := (hδ (A i) (hAreg i)).1
        obtain ⟨harea_upper, harea_lower⟩ := (hδ (A i) (hAreg i)).2 (T ∩ t i) u (happrox i)
        have hlinA := (hlin (A i) (hAreg i)).2 (T ∩ t i)
        rw [hlinA] at harea_upper harea_lower
        have hderiv := hderivbound u (T ∩ t i) (A i) (δ (A i)) u' (happrox i) (hT.inter (ht i))
          (fun x hx => (hu' x hx.1).mono inter_subset_left)
        have hJupper : ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x)) ≤
            q * (ENNReal.ofReal (J (A i)) * volume (T ∩ t i)) := by
          calc ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x))
              ≤ ∫⁻ _ in T ∩ t i, (q : ℝ≥0∞) * ENNReal.ofReal (J (A i)) := by
                apply lintegral_mono_ae
                filter_upwards [hderiv] with x hx
                exact (hJ (u' x) hx).1
            _ = q * (ENNReal.ofReal (J (A i)) * volume (T ∩ t i)) := by
                rw [setLIntegral_const, mul_assoc]
        have hJlower : ENNReal.ofReal (J (A i)) * volume (T ∩ t i) ≤
            q * ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x)) := by
          calc ENNReal.ofReal (J (A i)) * volume (T ∩ t i)
              = ∫⁻ _ in T ∩ t i, ENNReal.ofReal (J (A i)) := (setLIntegral_const _ _).symm
            _ ≤ ∫⁻ x in T ∩ t i, (q : ℝ≥0∞) * ENNReal.ofReal (J (u' x)) := by
                apply lintegral_mono_ae
                filter_upwards [hderiv] with x hx
                exact (hJ (u' x) hx).2
            _ = q * ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x)) :=
                lintegral_const_mul' _ _ ENNReal.coe_ne_top
        constructor
        · calc μHE[n] (u '' (T ∩ t i)) ≤ q * (ENNReal.ofReal (J (A i)) * volume (T ∩ t i)) :=
                harea_upper
            _ ≤ q * (q * ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x))) := by gcongr
            _ = (q : ℝ≥0∞) ^ 2 * ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x)) := by
                rw [pow_two, mul_assoc]
        · calc ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x))
              ≤ q * (ENNReal.ofReal (J (A i)) * volume (T ∩ t i)) := hJupper
            _ ≤ q * (q * μHE[n] (u '' (T ∩ t i))) := by gcongr
            _ = (q : ℝ≥0∞) ^ 2 * μHE[n] (u '' (T ∩ t i)) := by rw [pow_two, mul_assoc]
      rw [hsumimage, hsumintegral]
      constructor
      · calc ∑' i, μHE[n] (u '' (T ∩ t i))
            ≤ ∑' i, (q : ℝ≥0∞) ^ 2 * ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x)) :=
              ENNReal.tsum_le_tsum (fun i => (hpiece i).1)
          _ = (q : ℝ≥0∞) ^ 2 * ∑' i, ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x)) :=
              ENNReal.tsum_mul_left
      · calc ∑' i, ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x))
            ≤ ∑' i, (q : ℝ≥0∞) ^ 2 * μHE[n] (u '' (T ∩ t i)) :=
              ENNReal.tsum_le_tsum (fun i => (hpiece i).2)
          _ = (q : ℝ≥0∞) ^ 2 * ∑' i, μHE[n] (u '' (T ∩ t i)) := ENNReal.tsum_mul_left
    have hlimit : ∀ a : ℝ≥0∞, Tendsto (fun q : NNReal => (q : ℝ≥0∞) ^ 2 * a) (𝓝[>] 1) (𝓝 a) := by
      intro a
      have hcoe : Tendsto (fun q : NNReal => (q : ℝ≥0∞)) (𝓝[>] 1) (𝓝 1) :=
        (ENNReal.tendsto_coe.2 tendsto_id).mono_left nhdsWithin_le_nhds
      simpa only [one_pow, one_mul] using
        ENNReal.Tendsto.mul_const (ENNReal.Tendsto.pow (n := 2) hcoe) (Or.inl (by simp))
    apply le_antisymm
    · apply ge_of_tendsto (hlimit _)
      filter_upwards [self_mem_nhdsWithin] with q hq
      exact (hcmp q hq).1
    · apply ge_of_tendsto (hlimit _)
      filter_upwards [self_mem_nhdsWithin] with q hq
      exact (hcmp q hq).2
  /- Simon (3.5), Bochner form: the Jacobian-weighted measure on `S` is transported by `u`
  to `Hⁿ ⌞ u(S)`, so `∫_{u(S)} f dHⁿ = ∫_S J(u'(x)) f(u(x)) dLⁿ(x)` for every `f`. -/
  have hbochner : ∀ (S : Set (Euclid n)) (u : Euclid n → Euclid P)
      (u' : Euclid n → Euclid n →L[ℝ] Euclid P), MeasurableSet S →
      (∀ x ∈ S, HasFDerivAt u (u' x) x) → (∀ x ∈ S, Injective (u' x)) → InjOn u S →
      Measurable u' → ∫ y in u '' S, f y ∂μHE[n] = ∫ x in S, J (u' x) * f (u x) := by
    intro S u u' hS hu' hreg' hinj' hmeas'
    have hcont : ContinuousOn u S := fun x hx => (hu' x hx).continuousAt.continuousWithinAt
    have hemb := hcont.measurableEmbedding hS hinj'
    have hsub := MeasurableEmbedding.subtype_coe hS
    have hJm : Measurable (fun x => J (u' x)) := hJcont.measurable.comp hmeas'
    have hmap : Measure.map (S.domRestrict u)
        ((volume.withDensity (fun x => ENNReal.ofReal (J (u' x)))).comap
          (Subtype.val : S → Euclid n)) = μHE[n].restrict (u '' S) := by
      ext t ht
      rw [Measure.map_apply hemb.measurable ht, hsub.comap_apply]
      have hBm : MeasurableSet (Subtype.val '' ((S.domRestrict u) ⁻¹' t)) :=
        hsub.measurableSet_image' (hemb.measurable ht)
      have hBS : Subtype.val '' ((S.domRestrict u) ⁻¹' t) ⊆ S := by
        rintro x ⟨w, _, rfl⟩
        exact w.property
      rw [withDensity_apply _ hBm, ← hmeasure _ u u' hBm
        (fun x hx => (hu' x (hBS hx)).hasFDerivWithinAt) (fun x hx => hreg' x (hBS hx))
        (hinj'.mono hBS), Measure.restrict_apply ht]
      congr 1
      ext y
      constructor
      · rintro ⟨x, ⟨w, hw, rfl⟩, rfl⟩
        exact ⟨hw, ⟨w, w.property, rfl⟩⟩
      · rintro ⟨hy, x, hx, rfl⟩
        exact ⟨x, ⟨⟨x, hx⟩, hy, rfl⟩, rfl⟩
    rw [← hmap, hemb.integral_map]
    simp only [Set.domRestrict_apply, ← Function.comp_apply (f := f), ENNReal.ofReal]
    rw [← hsub.integral_map, map_comap_subtype_coe hS,
      setIntegral_withDensity_eq_setIntegral_smul₀ (hJm.real_toNNReal.aemeasurable) _ hS]
    congr with x
    rw [NNReal.smul_def, Real.coe_toNNReal _ (hJnonneg _), smul_eq_mul, comp_apply]
  -- the rescaled map `φ(b) = s⁻¹ • (g (z + s • b) - g z)` on `B_s = {b | z + s • b ∈ B}`
  have hs0 : s ≠ 0 := hs.ne'
  have hBs : MeasurableSet {b : Euclid n | z + s • b ∈ B} :=
    hB.preimage ((measurable_const_add z).comp (measurable_const_smul s))
  have hderiv : ∀ b ∈ {b : Euclid n | z + s • b ∈ B},
      HasFDerivAt (fun b : Euclid n => s⁻¹ • (g (z + s • b) - g z)) (fderiv ℝ g (z + s • b)) b := by
    intro b hb
    have h1 : HasFDerivAt (fun b' : Euclid n => z + s • b')
        (s • ContinuousLinearMap.id ℝ (Euclid n)) b :=
      ((hasFDerivAt_id b).const_smul s).const_add z
    refine ((((hdiff _ hb).hasFDerivAt.comp b h1).sub_const (g z)).const_smul s⁻¹).congr_fderiv ?_
    ext1 v
    simp [smul_smul, inv_mul_cancel₀ hs0]
  have hinjφ : InjOn (fun b : Euclid n => s⁻¹ • (g (z + s • b) - g z))
      {b : Euclid n | z + s • b ∈ B} := by
    intro b hb b' hb' h
    have h' : g (z + s • b) = g (z + s • b') := by
      simpa [hs0] using h
    exact smul_right_injective _ hs0 (add_left_cancel (hinj hb hb' h'))
  have himage :
      (fun b : Euclid n => s⁻¹ • (g (z + s • b) - g z)) '' {b : Euclid n | z + s • b ∈ B} =
        Poincare.SimonGMT.Chapter03.blowUpMap (g z) s '' (g '' B) := by
    ext y
    constructor
    · rintro ⟨b, hb, rfl⟩
      exact ⟨g (z + s • b), ⟨z + s • b, hb, rfl⟩, rfl⟩
    · rintro ⟨_, ⟨a, ha, rfl⟩, rfl⟩
      refine ⟨s⁻¹ • (a - z), ?_, ?_⟩
      · show z + s • s⁻¹ • (a - z) ∈ B
        rwa [smul_smul, mul_inv_cancel₀ hs0, one_smul, add_sub_cancel]
      · show s⁻¹ • (g (z + s • s⁻¹ • (a - z)) - g z) = s⁻¹ • (g a - g z)
        rw [smul_smul, mul_inv_cancel₀ hs0, one_smul, add_sub_cancel]
  have hmeasf' : Measurable (fun b : Euclid n => fderiv ℝ g (z + s • b)) :=
    (measurable_fderiv ℝ g).comp ((measurable_const_add z).comp (measurable_const_smul s))
  rw [← himage, hbochner _ _ (fun b : Euclid n => fderiv ℝ g (z + s • b)) hBs hderiv
    (fun b hb => hreg _ hb) hinjφ hmeasf', hJdef]
/-- **Borel gluing along disjoint injective continuous images** (definition of the weight `J` in
the area formula for the local unit representation).  Let `Fᵢ : ℝᵐ → ℝᵈ` be continuous and
injective on the Borel set `Bᵢ`, with the images `Fᵢ(Bᵢ)` pairwise disjoint, and let `hᵢ ≥ 0` be
Borel.  By Lusin–Souslin `Fᵢ|_{Bᵢ}` is a measurable embedding, so `Jᵢ = hᵢ ∘ (Fᵢ|_{Bᵢ})⁻¹` on
`Fᵢ(Bᵢ)`, `Jᵢ = 0` off it, is Borel; `J = Σᵢ Jᵢ` is Borel and `≥ 0`, and at `Fᵢ(b)` every term
but the `i`-th vanishes. -/
theorem Submission.codim1_lura_glue_measurable_on_pieces : ∀ (m d : ℕ) (F : ℕ → Euclid m → Euclid d) (B : ℕ → Set (Euclid m)) (h : ℕ → Euclid m → ℝ), (∀ i, Continuous (F i)) → (∀ i, MeasurableSet (B i)) → (∀ i, InjOn (F i) (B i)) → Pairwise (fun i j => Disjoint (F i '' B i) (F j '' B j)) → (∀ i, Measurable (h i)) → (∀ i a, 0 ≤ h i a) → ∃ J : Euclid d → ℝ, Measurable J ∧ (∀ v, 0 ≤ J v) ∧ ∀ i, ∀ b ∈ B i, J (F i b) = h i b := by
  intro m d F B h hF hB hFi hdisj hh hpos
  -- Lusin–Souslin: `Fᵢ|_{Bᵢ}` is a measurable embedding
  have he : ∀ i, MeasurableEmbedding ((B i).domRestrict (F i)) := fun i =>
    (hF i).continuousOn.measurableEmbedding (hB i) (hFi i)
  -- `Jᵢ = hᵢ ∘ (Fᵢ|_{Bᵢ})⁻¹` on `Fᵢ(Bᵢ)` and `Jᵢ = 0` off it
  let G : ℕ → Euclid d → ℝ := fun i =>
    Function.extend ((B i).domRestrict (F i)) (fun b : B i => h i b) 0
  have hGm : ∀ i, Measurable (G i) := fun i =>
    (he i).measurable_extend ((hh i).comp measurable_subtype_coe) measurable_const
  have hGF : ∀ i, ∀ b ∈ B i, G i (F i b) = h i b := fun i b hb =>
    (he i).injective.extend_apply (fun b : B i => h i b) 0 ⟨b, hb⟩
  have hG0 : ∀ i v, v ∉ F i '' B i → G i v = 0 := fun i v hv =>
    Function.extend_apply' _ _ v fun ⟨a, ha⟩ => hv ⟨a, a.2, ha⟩
  have hGnn : ∀ i v, 0 ≤ G i v := by
    intro i v
    by_cases hv : v ∈ F i '' B i
    · obtain ⟨b, hb, rfl⟩ := hv
      rw [hGF i b hb]
      exact hpos i b
    · rw [hG0 i v hv]
  -- `J = Σᵢ Jᵢ`; at `Fᵢ(b)` the terms `j ≠ i` vanish since `Fᵢ(Bᵢ) ∩ Fⱼ(Bⱼ) = ∅`
  refine ⟨fun v => ∑' i, G i v, Measurable.tsum hGm, fun v => tsum_nonneg fun i => hGnn i v,
    fun i b hb => ?_⟩
  show ∑' j, G j (F i b) = h i b
  rw [tsum_eq_single i fun j hj =>
    hG0 j (F i b) fun hv => Set.disjoint_left.mp (hdisj hj) hv ⟨b, hb, rfl⟩]
  exact hGF i b hb
/-- **Splitting `∫_{G(M)}` along a Borel decomposition of `M`.**  Let `G : ℝᵈ → ℝᴾ` be continuous
and injective on `M`, let `Aᵢ ⊆ M` (`i ∈ ℕ`) be pairwise disjoint Borel sets, and let
`Hᵐ(G(M \ ⋃ᵢ Aᵢ)) = 0`.  Then `∫_{G(M)} g dHᵐ = Σᵢ ∫_{G(Aᵢ)} g dHᵐ` for every `g : ℝᴾ → [0, ∞]`.
The `G(Aᵢ)` are Borel (Lusin–Souslin) and pairwise disjoint, `⋃ᵢ G(Aᵢ) ⊆ G(M)`, and
`G(M) \ ⋃ᵢ G(Aᵢ) ⊆ G(M \ ⋃ᵢ Aᵢ)` is `Hᵐ`-null. -/
theorem Submission.codim1_lura_lintegral_image_eq_tsum_pieces : ∀ (m d P : ℕ) (M : Set (Euclid d)) (A : ℕ → Set (Euclid d)) (G : Euclid d → Euclid P), ContinuousOn G M → InjOn G M → (∀ i, MeasurableSet (A i)) → (∀ i, A i ⊆ M) → Pairwise (fun i j => Disjoint (A i) (A j)) → μHE[m] (G '' (M \ ⋃ i, A i)) = 0 → ∀ g : Euclid P → ℝ≥0∞, ∫⁻ w in G '' M, g w ∂μHE[m] = ∑' i, ∫⁻ w in G '' A i, g w ∂μHE[m] := by
  intro m d P M A G hG hinj hA hAM hdisj hnull g
  -- each `G(Aᵢ)` is Borel: `G` is continuous and injective on `Aᵢ ⊆ M` (Lusin–Souslin)
  have hmeas : ∀ i, MeasurableSet (G '' A i) := fun i =>
    (hA i).image_of_continuousOn_injOn (hG.mono (hAM i)) (hinj.mono (hAM i))
  -- the `G(Aᵢ)` are pairwise disjoint, as `G` is injective on `M`
  have hdisj' : Pairwise (Disjoint on fun i => G '' A i) := fun i j hij =>
    disjoint_image_image fun a ha b hb hab =>
      (hdisj hij).ne_of_mem ha hb (hinj (hAM i ha) (hAM j hb) hab)
  -- `⋃ᵢ G(Aᵢ) ⊆ G(M)`
  have hsub : (⋃ i, G '' A i) ⊆ G '' M := iUnion_subset fun i => image_mono (hAM i)
  -- `G(M) \ ⋃ᵢ G(Aᵢ) ⊆ G(M \ ⋃ᵢ Aᵢ)`, which is `Hᵐ`-null by hypothesis
  have hdiff : G '' M \ ⋃ i, G '' A i ⊆ G '' (M \ ⋃ i, A i) := by
    rintro y ⟨⟨x, hxM, rfl⟩, hy⟩
    refine ⟨x, ⟨hxM, fun hx => hy ?_⟩, rfl⟩
    obtain ⟨i, hi⟩ := mem_iUnion.mp hx
    exact mem_iUnion.mpr ⟨i, mem_image_of_mem G hi⟩
  -- so `G(M) = ⋃ᵢ G(Aᵢ)` `Hᵐ`-a.e., and the integral is countably additive over the `G(Aᵢ)`
  have hae : G '' M =ᵐ[μHE[m]] ⋃ i, G '' A i :=
    ae_eq_set.mpr ⟨measure_mono_null hdiff hnull, by rw [sdiff_eq_empty.mpr hsub, measure_empty]⟩
  rw [setLIntegral_congr hae, lintegral_iUnion hmeas hdisj' g]
/-- **Bochner form of the area formula** (Simon Ch. 3, 2.4–2.6, as used in the proof of 7.5.8).
Let `B ⊆ ℝᵈ` be Borel, `G` continuous and injective on `B`, `J ≥ 0` Borel, and suppose
`∫⁻_{G(B)} g dμ = ∫⁻_B J·(g ∘ G) dν` for every `g ≥ 0`.  Then `∫_{G(B)} f dμ = ∫_B J·(f ∘ G) dν`
for every `f` (Bochner integrals, `0` when not integrable).  By Lusin–Souslin `G|_B` is a
measurable embedding; testing with `g = 1_T` shows that `μ⌞G(B)` is the image under `G|_B` of
`ν.withDensity J` pulled back to `B`, so `MeasurableEmbedding.integral_map` transports `f`, and
the density is removed by `integral_withDensity_eq_integral_toReal_smul₀`. -/
theorem Submission.codim1_lura_integral_image_of_lintegral : ∀ (d P : ℕ) (μ : Measure (Euclid P)) (ν : Measure (Euclid d)) (B : Set (Euclid d)) (G : Euclid d → Euclid P) (J : Euclid d → ℝ), MeasurableSet B → ContinuousOn G B → InjOn G B → Measurable J → (∀ v, 0 ≤ J v) → (∀ g : Euclid P → ℝ≥0∞, ∫⁻ w in G '' B, g w ∂μ = ∫⁻ v in B, ENNReal.ofReal (J v) * g (G v) ∂ν) → ∀ f : Euclid P → ℝ, ∫ w in G '' B, f w ∂μ = ∫ v in B, J v * f (G v) ∂ν := by
  intro d P μ ν B G J hB hGc hGi hJ hJ0 hg f
  -- `G|_B : B → ℝᴾ` is a measurable embedding (Lusin–Souslin), `ρ = ofReal ∘ J` is finite
  have he : MeasurableEmbedding (B.domRestrict G) := hGc.measurableEmbedding hB hGi
  have hρ : Measurable fun v => ENNReal.ofReal (J v) := ENNReal.measurable_ofReal.comp hJ
  have hρ_lt : ∀ v, ENNReal.ofReal (J v) < ∞ := fun _ => ENNReal.ofReal_lt_top
  -- `∫⁻ g d((G|_B)₊ ι^*(ν.withDensity ρ)) = ∫⁻_B ρ (g ∘ G) dν` for every `g`
  have hlin : ∀ g : Euclid P → ℝ≥0∞,
      ∫⁻ w, g w ∂((Measure.comap Subtype.val (ν.withDensity fun v => ENNReal.ofReal (J v))).map
        (B.domRestrict G)) = ∫⁻ v in B, ENNReal.ofReal (J v) * g (G v) ∂ν := by
    intro g
    rw [he.lintegral_map]
    simp only [Set.domRestrict_apply]
    rw [lintegral_subtype_comap hB (fun v => g (G v)), restrict_withDensity hB,
      lintegral_withDensity_eq_lintegral_mul_non_measurable _ hρ (ae_of_all _ hρ_lt)]
    rfl
  -- testing with `g = 1_T`: this image measure is `μ⌞G(B)`
  have hmap : (Measure.comap Subtype.val (ν.withDensity fun v => ENNReal.ofReal (J v))).map
      (B.domRestrict G) = μ.restrict (G '' B) := by
    ext T hT
    rw [← lintegral_indicator_one hT, hlin, ← hg (T.indicator 1)]
    exact lintegral_indicator_one hT
  -- transport `f` along the two measurable embeddings, then remove the density (`J ≥ 0`)
  rw [← hmap, he.integral_map]
  simp only [Set.domRestrict_apply]
  rw [integral_subtype_comap hB (fun v => f (G v)), restrict_withDensity hB,
    integral_withDensity_eq_integral_toReal_smul₀ hρ.aemeasurable (ae_of_all _ hρ_lt)]
  refine integral_congr_ae (ae_of_all _ fun v => ?_)
  simp only [ENNReal.toReal_ofReal (hJ0 v), smul_eq_mul]
/-- **A.e. transfer through Lipschitz pieces** (step 6 of the image tangent transport).  Let
`M ⊆ ℝᴾ` be Borel with `Hⁿ(M \ ⋃ᵢ Fᵢ(Bᵢ)) = 0` for Lipschitz `Fᵢ : ℝⁿ → ℝᴾ`.  If `p (Fᵢ b)` holds
for Lebesgue-a.e. `b ∈ Bᵢ`, then `p x` holds for `Hⁿ`-a.e. `x ∈ M`: the bad parameters
`Nᵢ ⊆ Bᵢ` are Lebesgue-null, so `Hⁿ(Fᵢ(Nᵢ)) ≤ Lᵢⁿ Hⁿ(Nᵢ) = 0` (`Hⁿ = Lⁿ` on `ℝⁿ`), and every
`x ∈ M` with `¬p x` lies in `(M \ ⋃ᵢ Fᵢ(Bᵢ)) ∪ ⋃ᵢ Fᵢ(Nᵢ)`. -/
theorem Submission.dpf_itt_ae_of_ae_pieces : ∀ (P n : ℕ) (M : Set (Euclid P)) (F : ℕ → Euclid n → Euclid P) (B : ℕ → Set (Euclid n)) (p : Euclid P → Prop), MeasurableSet M → (∀ i, ∃ L : NNReal, LipschitzWith L (F i)) → μHE[n] (M \ ⋃ i, F i '' B i) = 0 → (∀ i, ∀ᵐ b ∂(volume.restrict (B i)), p (F i b)) → ∀ᵐ x ∂(μHE[n].restrict M), p x := by
  intro P n M F B p hM hF hcov hp
  -- `μHE[n] = c • μH[n]` with `c ≠ 0`
  have hc := Measure.addHaarScalarFactor_volume_hausdorffMeasure_ne_zero n
  -- the bad parameters `Nᵢ = {b ∈ Bᵢ | ¬p (Fᵢ b)}` have `μHE[n]`-null images
  have hnull : ∀ i, μHE[n] (F i '' {b | ¬(b ∈ B i → p (F i b))}) = 0 := by
    intro i
    obtain ⟨L, hL⟩ := hF i
    have hN : μHE[n] {b | ¬(b ∈ B i → p (F i b))} = 0 := by
      rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
      exact ae_iff.mp (ae_imp_of_ae_restrict (hp i))
    rw [Measure.euclideanHausdorffMeasure_def, Measure.smul_apply, smul_eq_zero] at hN ⊢
    exact Or.inr (le_zero_iff.mp ((hL.hausdorffMeasure_image_le (Nat.cast_nonneg n) _).trans_eq
      (by rw [hN.resolve_left hc, mul_zero])))
  -- every bad point of `M` lies in `(M \ ⋃ᵢ Fᵢ(Bᵢ)) ∪ ⋃ᵢ Fᵢ(Nᵢ)`
  rw [ae_restrict_iff' hM, ae_iff]
  refine measure_mono_null (fun x hx => ?_) (measure_union_null hcov (measure_iUnion_null hnull))
  obtain ⟨hxM, hpx⟩ := not_imp.mp hx
  by_cases hxU : x ∈ ⋃ i, F i '' B i
  · obtain ⟨i, b, hb, rfl⟩ := mem_iUnion.mp hxU
    exact Or.inr (mem_iUnion.mpr ⟨i, b, fun h => hpx (h hb), rfl⟩)
  · exact Or.inl ⟨hxM, hxU⟩
/-- **Simon Ch. 3, Lemma 1.2 and Remark 1.3**, with bi-Lipschitz Borel pieces in place of `C¹`
submanifolds: a Borel countably `n`-rectifiable `M ⊆ ℝᴾ` is, up to an `Hⁿ`-null set, the disjoint
union of Borel sets `Fᵢ(Bᵢ) ⊆ M`, where `Fᵢ : ℝⁿ → ℝᴾ` is Lipschitz, `Bᵢ` is Borel,
`mᵢ|a − a'| ≤ |Fᵢ(a) − Fᵢ(a')|` on `Bᵢ` for some `mᵢ > 0`, and `DFᵢ` exists and is injective on
`Bᵢ`.  Each Lipschitz `Fⱼ` of the cover maps its non-differentiability points (Rademacher) and
its critical points (the image of `{JFⱼ = 0}`) to `Hⁿ`-null sets.  Mathlib's partition lemma cuts
the regular points into pieces on which `Fⱼ` is close to an injective linear map, hence
bi-Lipschitz; the images of the pieces are Borel (Lusin–Souslin) and are made disjoint as in
Remark 1.3. -/
theorem Submission.dpf_rectifiable_bilipschitz_pieces : ∀ (P n : ℕ) (M : Set (Euclid P)), MeasurableSet M → CountablyRectifiable n M → ∃ (F : ℕ → Euclid n → Euclid P) (B : ℕ → Set (Euclid n)) (m : ℕ → ℝ), (∀ i, ∃ L : NNReal, LipschitzWith L (F i)) ∧ (∀ i, MeasurableSet (B i)) ∧ (∀ i, 0 < m i) ∧ (∀ i, ∀ a ∈ B i, ∀ a' ∈ B i, m i * ‖a - a'‖ ≤ ‖F i a - F i a'‖) ∧ (∀ i, ∀ a ∈ B i, DifferentiableAt ℝ (F i) a ∧ Injective (fderiv ℝ (F i) a)) ∧ (∀ i, MeasurableSet (F i '' B i)) ∧ (∀ i, F i '' B i ⊆ M) ∧ Pairwise (fun i j => Disjoint (F i '' B i) (F j '' B j)) ∧ μHE[n] (M \ ⋃ i, F i '' B i) = 0 := by
  intro P n M hM hrect
  have hvol : (μHE[n] : Measure (Euclid n)) = volume :=
    EuclideanSpace.euclideanHausdorffMeasure_eq_volume n
  -- Step 1: the rectifiable cover `M ⊆ M₀ ∪ ⋃ⱼ Fⱼ(ℝⁿ)`
  obtain ⟨M₀, hM₀, F₀, hF₀, hcover⟩ := hrect
  choose K hK using hF₀
  -- Step 2: the regular sets `Gⱼ` are Borel and `Hⁿ(Fⱼ(ℝⁿ ∖ Gⱼ)) = 0`
  have hGmeas : ∀ f : Euclid n → Euclid P,
      MeasurableSet {a | DifferentiableAt ℝ f a ∧ Injective (fderiv ℝ f a)} := fun f =>
    (measurableSet_of_differentiableAt ℝ f).inter
      (measurable_fderiv ℝ f ContinuousLinearMap.isOpen_injective.measurableSet)
  -- Step 2(a): nondifferentiability points have null image (Rademacher)
  have hrad : ∀ (f : Euclid n → Euclid P) (L : NNReal), LipschitzWith L f →
      μHE[n] (f '' {a | ¬ DifferentiableAt ℝ f a}) = 0 := by
    intro f L hf
    have hz : volume {a : Euclid n | ¬ DifferentiableAt ℝ f a} = 0 :=
      ae_iff.mp (hf.ae_differentiableAt (μ := volume))
    have hle := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
      (hf.lipschitzOnWith (s := {a | ¬ DifferentiableAt ℝ f a}))
    rw [hvol, hz, mul_zero] at hle
    exact le_antisymm hle bot_le
  -- Step 2(b): critical points have null image.  On a piece where `f` is `ε`-close to a
  -- rank-deficient `A` (`Av = 0`, `‖v‖ = 1`), `|f a - f a'| ≤ (L + 1)|D a - D a'|` for
  -- `D = id - (1 - ε) v ⊗ v`, and `det D = ε`.
  have hsard : ∀ (f : Euclid n → Euclid P) (L : NNReal), LipschitzWith L f →
      μHE[n] (f '' {a | DifferentiableAt ℝ f a ∧ ¬ Injective (fderiv ℝ f a)}) = 0 := by
    intro f L hf
    set S := {a | DifferentiableAt ℝ f a ∧ ¬ Injective (fderiv ℝ f a)}
    have hSmeas : MeasurableSet S :=
      (measurableSet_of_differentiableAt ℝ f).inter
        (measurable_fderiv ℝ f ContinuousLinearMap.isOpen_injective.measurableSet).compl
    have hR : ∀ R : ℕ, μHE[n] (f '' (S ∩ ball (0 : Euclid n) R)) = 0 := by
      intro R
      set s := S ∩ ball (0 : Euclid n) R
      have hsmeas : MeasurableSet s := hSmeas.inter measurableSet_ball
      have hbound : ∀ ε : NNReal, 0 < ε → ε ≤ 1 →
          μHE[n] (f '' s) ≤ ((L : ℝ≥0∞) + 1) ^ n * volume (ball (0 : Euclid n) R) * ε := by
        intro ε hε hε1
        rcases s.eq_empty_or_nonempty with hse | hsne
        · rw [hse, image_empty, measure_empty]; exact bot_le
        obtain ⟨t, A, htdisj, htmeas, hst, hA, hAy⟩ :=
          exists_partition_approximatesLinearOn_of_hasFDerivWithinAt f s (fderiv ℝ f)
            (fun x hx => hx.1.1.hasFDerivAt.hasFDerivWithinAt) (fun _ => ε) (fun _ => hε.ne')
        have hpiece : ∀ k, μHE[n] (f '' (s ∩ t k)) ≤
            ((L : ℝ≥0∞) + 1) ^ n * volume (s ∩ t k) * ε := by
          intro k
          obtain ⟨y, hy, hAk⟩ := hAy hsne k
          have hAnorm : ‖A k‖ ≤ L := hAk ▸ norm_fderiv_le_of_lipschitz ℝ hf
          have hAni : ¬ Injective (A k) := hAk ▸ hy.1.2
          obtain ⟨v, hv1, hv0⟩ : ∃ v : Euclid n, ‖v‖ = 1 ∧ A k v = 0 := by
            simp only [Injective, not_forall] at hAni
            obtain ⟨a, b, hab, hne⟩ := hAni
            have hne' : a - b ≠ 0 := sub_ne_zero.mpr hne
            refine ⟨‖a - b‖⁻¹ • (a - b), norm_smul_inv_norm hne', ?_⟩
            rw [map_smul, map_sub, hab, sub_self, smul_zero]
          set c : ℝ := 1 - (ε : ℝ) with hc
          have hc0 : 0 ≤ c := by
            rw [hc]; linarith [show (ε : ℝ) ≤ 1 from hε1]
          set D : Euclid n →L[ℝ] Euclid n :=
            ContinuousLinearMap.id ℝ (Euclid n) - c • (innerSL ℝ v).smulRight v with hD
          have hDapp : ∀ h, D h = h - (c * inner ℝ v h) • v := by
            intro h
            simp [hD, mul_smul]
          have hAD : ∀ h, A k (D h) = A k h := by
            intro h
            rw [hDapp, map_sub, map_smul, hv0, smul_zero, sub_zero]
          have hinD : ∀ h, inner ℝ v (D h) = (ε : ℝ) * inner ℝ v h := by
            intro h
            rw [hDapp, inner_sub_right, inner_smul_right, real_inner_self_eq_norm_sq, hv1, hc]
            ring
          have hεD : ∀ h, (ε : ℝ) * ‖h‖ ≤ ‖D h‖ := by
            intro h
            have heq : (ε : ℝ) • h = (ε : ℝ) • D h + (c * inner ℝ v (D h)) • v := by
              rw [hinD, hDapp, smul_sub, ← sub_eq_zero]
              rw [hc]
              module
            calc (ε : ℝ) * ‖h‖ = ‖(ε : ℝ) • h‖ := by
                  rw [norm_smul, NNReal.norm_eq]
              _ ≤ ‖(ε : ℝ) • D h‖ + ‖(c * inner ℝ v (D h)) • v‖ := heq ▸ norm_add_le _ _
              _ ≤ (ε : ℝ) * ‖D h‖ + c * ‖D h‖ := by
                  gcongr
                  · rw [norm_smul, NNReal.norm_eq]
                  · rw [norm_smul, hv1, mul_one, Real.norm_eq_abs, abs_mul, abs_of_nonneg hc0]
                    gcongr
                    exact (abs_real_inner_le_norm v (D h)).trans (by rw [hv1, one_mul])
              _ = ‖D h‖ := by rw [hc]; ring
          have hfD : ∀ a ∈ s ∩ t k, ∀ a' ∈ s ∩ t k,
              ‖f a - f a'‖ ≤ ((L : ℝ) + 1) * ‖D a - D a'‖ := by
            intro a ha a' ha'
            have h1 := hA k a ha a' ha'
            have h2 : ‖A k (a - a')‖ ≤ L * ‖D a - D a'‖ := by
              rw [← map_sub, ← hAD (a - a')]
              exact (ContinuousLinearMap.le_opNorm _ _).trans (by gcongr)
            have h3 : (ε : ℝ) * ‖a - a'‖ ≤ ‖D a - D a'‖ := by
              rw [← map_sub]
              exact hεD (a - a')
            have h4 := norm_sub_norm_le (f a - f a') (A k (a - a'))
            linarith
          have himg : μHE[n] (f '' (s ∩ t k)) ≤
              ((L + 1 : NNReal) : ℝ≥0∞) ^ n * μHE[n] (D '' (s ∩ t k)) := by
            set X := s ∩ t k
            set g := Function.invFunOn D X
            have hg : ∀ y ∈ D '' X, g y ∈ X ∧ D (g y) = y :=
              fun y hy => ⟨Function.invFunOn_mem hy, Function.invFunOn_eq hy⟩
            have hLip : LipschitzOnWith (L + 1) (f ∘ g) (D '' X) := by
              refine LipschitzOnWith.of_dist_le_mul fun y hy y' hy' => ?_
              obtain ⟨hgy, hDy⟩ := hg y hy
              obtain ⟨hgy', hDy'⟩ := hg y' hy'
              simp only [comp_apply, dist_eq_norm, NNReal.coe_add, NNReal.coe_one]
              calc ‖f (g y) - f (g y')‖ ≤ ((L : ℝ) + 1) * ‖D (g y) - D (g y')‖ :=
                    hfD _ hgy _ hgy'
                _ = _ := by rw [hDy, hDy']
            have hsub : f '' X ⊆ (f ∘ g) '' (D '' X) := by
              rintro _ ⟨a, ha, rfl⟩
              refine ⟨D a, mem_image_of_mem D ha, ?_⟩
              obtain ⟨hga, hDa⟩ := hg (D a) (mem_image_of_mem D ha)
              have := hfD _ hga _ ha
              rw [hDa, sub_self, norm_zero, mul_zero] at this
              exact sub_eq_zero.mp (norm_le_zero_iff.mp this)
            exact (measure_mono hsub).trans
              (Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n hLip)
          have hdet : LinearMap.det (D : Euclid n →ₗ[ℝ] Euclid n) = ε := by
            rw [← LinearMap.det_toMatrix (EuclideanSpace.basisFun (Fin n) ℝ).toBasis]
            have hM : LinearMap.toMatrix (EuclideanSpace.basisFun (Fin n) ℝ).toBasis
                (EuclideanSpace.basisFun (Fin n) ℝ).toBasis (D : Euclid n →ₗ[ℝ] Euclid n) =
                1 + Matrix.replicateCol Unit (fun i => -c * v i) *
                  Matrix.replicateRow Unit (fun j => v j) := by
              ext i j
              simp [hD, LinearMap.toMatrix_apply, Matrix.one_apply,
                EuclideanSpace.inner_single_right, Matrix.mul_apply, Matrix.replicateCol_apply,
                Matrix.replicateRow_apply]
              ring
            rw [hM, Matrix.det_one_add_replicateCol_mul_replicateRow]
            have h2 : ∑ i, v i ^ 2 = 1 := by
              have := EuclideanSpace.norm_sq_eq v
              simp only [hv1, one_pow, Real.norm_eq_abs, sq_abs] at this
              exact this.symm
            simp only [dotProduct]
            calc 1 + ∑ i, v i * (-c * v i) = 1 - c * ∑ i, v i ^ 2 := by
                  rw [Finset.mul_sum, sub_eq_add_neg, ← Finset.sum_neg_distrib]
                  exact congrArg _ (Finset.sum_congr rfl fun i _ => by ring)
              _ = ε := by rw [h2, mul_one, hc]; ring
          calc μHE[n] (f '' (s ∩ t k)) ≤
                ((L + 1 : NNReal) : ℝ≥0∞) ^ n * μHE[n] (D '' (s ∩ t k)) := himg
            _ = ((L : ℝ≥0∞) + 1) ^ n * volume (s ∩ t k) * ε := by
              rw [hvol, MeasureTheory.Measure.addHaar_image_continuousLinearMap, hdet,
                NNReal.abs_eq, ENNReal.ofReal_coe_nnreal]
              push_cast
              ring
        calc μHE[n] (f '' s) ≤ μHE[n] (⋃ k, f '' (s ∩ t k)) := by
              apply measure_mono
              rintro _ ⟨a, ha, rfl⟩
              obtain ⟨k, hk⟩ := mem_iUnion.mp (hst ha)
              exact mem_iUnion.mpr ⟨k, a, ⟨ha, hk⟩, rfl⟩
          _ ≤ ∑' k, μHE[n] (f '' (s ∩ t k)) := measure_iUnion_le _
          _ ≤ ∑' k, ((L : ℝ≥0∞) + 1) ^ n * volume (s ∩ t k) * ε := ENNReal.tsum_le_tsum hpiece
          _ = ((L : ℝ≥0∞) + 1) ^ n * volume (⋃ k, s ∩ t k) * ε := by
              rw [ENNReal.tsum_mul_right, ENNReal.tsum_mul_left, measure_iUnion]
              · exact fun i j hij => (htdisj hij).mono inter_subset_right inter_subset_right
              · exact fun k => hsmeas.inter (htmeas k)
          _ ≤ ((L : ℝ≥0∞) + 1) ^ n * volume (ball (0 : Euclid n) R) * ε := by
              gcongr
              exact iUnion_subset fun k => inter_subset_left.trans inter_subset_right
      have hfin : ((L : ℝ≥0∞) + 1) ^ n * volume (ball (0 : Euclid n) R) ≠ ∞ :=
        ENNReal.mul_ne_top (ENNReal.pow_ne_top (by simp)) measure_ball_lt_top.ne
      have htend : Tendsto (fun ε : NNReal =>
          ((L : ℝ≥0∞) + 1) ^ n * volume (ball (0 : Euclid n) R) * (ε : ℝ≥0∞)) (𝓝[>] 0)
          (𝓝 0) := by
        have h0 : Tendsto (fun ε : NNReal => (ε : ℝ≥0∞)) (𝓝[>] 0) (𝓝 0) := by
          rw [← ENNReal.coe_zero]
          exact (ENNReal.tendsto_coe.mpr tendsto_id).mono_left nhdsWithin_le_nhds
        simpa using ENNReal.Tendsto.const_mul h0 (Or.inr hfin)
      refine le_antisymm (ge_of_tendsto htend ?_) bot_le
      filter_upwards [Ioc_mem_nhdsGT (zero_lt_one' NNReal)] with ε hε
      exact hbound ε hε.1 hε.2
    refine measure_mono_null ?_ (measure_iUnion_null hR)
    rintro _ ⟨a, ha, rfl⟩
    obtain ⟨R, hR'⟩ := exists_nat_gt ‖a‖
    exact mem_iUnion.mpr ⟨R, a, ⟨ha, mem_ball_zero_iff.mpr hR'⟩, rfl⟩
  set G : ℕ → Set (Euclid n) := fun j =>
    {a | DifferentiableAt ℝ (F₀ j) a ∧ Injective (fderiv ℝ (F₀ j) a)}
  have hGnull : ∀ j, μHE[n] (F₀ j '' (G j)ᶜ) = 0 := by
    intro j
    refine measure_mono_null ?_ (measure_union_null (hrad _ _ (hK j)) (hsard _ _ (hK j)))
    rintro _ ⟨a, ha, rfl⟩
    by_cases hd : DifferentiableAt ℝ (F₀ j) a
    · exact Or.inr ⟨a, ⟨hd, fun hi => ha ⟨hd, hi⟩⟩, rfl⟩
    · exact Or.inl ⟨a, hd, rfl⟩
  -- Step 3: a coercivity constant `c(A)` for every injective `A`; radius `r(A) = c(A)/2 ≠ 0`
  have hcoer : ∀ A : Euclid n →L[ℝ] Euclid P, ∃ c : NNReal, 0 < c ∧
      (Injective A → ∀ h, (c : ℝ) * ‖h‖ ≤ ‖A h‖) := by
    intro A
    by_cases hA : Injective A
    · obtain ⟨C, Cpos, hC⟩ := A.injective_iff_antilipschitz.mp hA
      refine ⟨C⁻¹, inv_pos.mpr Cpos, fun _ h => ?_⟩
      have hb := A.bound_of_antilipschitz hC h
      have hC0 : (0 : ℝ) < C := Cpos
      rw [NNReal.coe_inv]
      calc (C : ℝ)⁻¹ * ‖h‖ ≤ (C : ℝ)⁻¹ * (C * ‖A h‖) := by gcongr
        _ = ‖A h‖ := by field_simp
    · exact ⟨1, one_pos, fun h => absurd h hA⟩
  choose c hcpos hc using hcoer
  -- Step 4: Mathlib's partition of `Gⱼ` into pieces on which `Fⱼ` is close to linear
  have hpart : ∀ j, ∃ (t : ℕ → Set (Euclid n)) (A : ℕ → Euclid n →L[ℝ] Euclid P),
      Pairwise (Disjoint on t) ∧ (∀ k, MeasurableSet (t k)) ∧ G j ⊆ ⋃ k, t k ∧
      (∀ k, ApproximatesLinearOn (F₀ j) (A k) (G j ∩ t k) (c (A k) / 2)) ∧
      ((G j).Nonempty → ∀ k, ∃ y ∈ G j, A k = fderiv ℝ (F₀ j) y) := fun j =>
    exists_partition_approximatesLinearOn_of_hasFDerivWithinAt (F₀ j) (G j) (fderiv ℝ (F₀ j))
      (fun x hx => hx.1.hasFDerivAt.hasFDerivWithinAt) (fun A => c A / 2)
      (fun A => (div_pos (hcpos A) two_pos).ne')
  choose t A htdisj htmeas hGt hAapprox hAy using hpart
  -- Step 5: `Fⱼ` is bi-Lipschitz on `Gⱼ ∩ tⱼₖ` with lower constant `c(Aⱼₖ)/2`
  have hlow : ∀ j k, ∀ a ∈ G j ∩ t j k, ∀ a' ∈ G j ∩ t j k,
      ((c (A j k) / 2 : NNReal) : ℝ) * ‖a - a'‖ ≤ ‖F₀ j a - F₀ j a'‖ := by
    intro j k a ha a' ha'
    obtain ⟨y, hy, hAk⟩ := hAy j ⟨a, ha.1⟩ k
    have hinj : Injective (A j k) := hAk ▸ hy.2
    have h1 := hc (A j k) hinj (a - a')
    have h2 := hAapprox j k a ha a' ha'
    have h3 := norm_sub_norm_le (A j k (a - a')) (F₀ j a - F₀ j a')
    rw [norm_sub_rev (A j k (a - a'))] at h3
    push_cast at h2 ⊢
    linarith
  -- Step 6: enumerate the pieces by `i ↦ (unpair i)`; their images are Borel (Lusin–Souslin)
  set Fi : ℕ → Euclid n → Euclid P := fun i => F₀ (Nat.unpair i).1 with hFi
  set Di : ℕ → Set (Euclid n) := fun i =>
    G (Nat.unpair i).1 ∩ t (Nat.unpair i).1 (Nat.unpair i).2 with hDi
  set mi : ℕ → ℝ := fun i =>
    ((c (A (Nat.unpair i).1 (Nat.unpair i).2) / 2 : NNReal) : ℝ) with hmi
  have hDmeas : ∀ i, MeasurableSet (Di i) := fun i =>
    (hGmeas _).inter (htmeas _ _)
  have hmipos : ∀ i, 0 < mi i := fun i => by
    simp only [hmi, NNReal.coe_div, NNReal.coe_ofNat]
    exact div_pos (hcpos _) two_pos
  have hlowi : ∀ i, ∀ a ∈ Di i, ∀ a' ∈ Di i, mi i * ‖a - a'‖ ≤ ‖Fi i a - Fi i a'‖ :=
    fun i => hlow _ _
  have hNmeas : ∀ i, MeasurableSet (Fi i '' Di i) := by
    intro i
    refine (hDmeas i).image_of_continuousOn_injOn (hK _).continuous.continuousOn ?_
    intro a ha a' ha' h
    have := hlowi i a ha a' ha'
    rw [h, sub_self, norm_zero] at this
    have h0 : ‖a - a'‖ = 0 := by
      rcases (norm_nonneg (a - a')).eq_or_lt with h0 | h0
      · exact h0.symm
      · linarith [mul_pos (hmipos i) h0]
    exact sub_eq_zero.mp (norm_eq_zero.mp h0)
  -- Step 7: disjointify the images inside `M`
  set Ñ : ℕ → Set (Euclid P) := fun i => Fi i '' Di i ∩ M
  have hÑmeas : ∀ i, MeasurableSet (Ñ i) := fun i => (hNmeas i).inter hM
  set B : ℕ → Set (Euclid n) := fun i => Di i ∩ Fi i ⁻¹' disjointed Ñ i with hB
  have himg : ∀ i, Fi i '' B i = disjointed Ñ i := by
    intro i
    rw [hB, image_inter_preimage]
    exact inter_eq_right.mpr ((disjointed_subset Ñ i).trans inter_subset_left)
  refine ⟨Fi, B, mi, fun i => ⟨K _, hK _⟩,
    fun i => (hDmeas i).inter ((hK _).continuous.measurable (MeasurableSet.disjointed hÑmeas i)),
    hmipos, fun i a ha a' ha' => hlowi i a ha.1 a' ha'.1, fun i a ha => ha.1.1,
    fun i => himg i ▸ MeasurableSet.disjointed hÑmeas i,
    fun i => himg i ▸ ((disjointed_subset Ñ i).trans inter_subset_right), ?_, ?_⟩
  · intro i j hij
    rw [himg i, himg j]
    exact disjoint_disjointed Ñ hij
  -- Step 8: the remainder lies in `M₀ ∪ ⋃ⱼ Fⱼ(ℝⁿ ∖ Gⱼ)`
  · have hU : (⋃ i, Fi i '' B i) = ⋃ i, Ñ i := by
      simp_rw [himg]
      exact iUnion_disjointed
    rw [hU]
    refine measure_mono_null ?_ (measure_union_null hM₀ (measure_iUnion_null hGnull))
    rintro x ⟨hxM, hxN⟩
    rcases hcover hxM with hx0 | hx
    · exact Or.inl hx0
    · obtain ⟨j, a, rfl⟩ := mem_iUnion.mp hx
      by_cases ha : a ∈ G j
      · exfalso
        obtain ⟨k, hk⟩ := mem_iUnion.mp (hGt j ha)
        apply hxN
        refine mem_iUnion.mpr ⟨Nat.pair j k, ⟨a, ?_, ?_⟩, hxM⟩
        · simp only [hDi, Nat.unpair_pair]
          exact ⟨ha, hk⟩
        · simp only [hFi, Nat.unpair_pair]
      · exact Or.inr (mem_iUnion.mpr ⟨j, a, ha, rfl⟩)
/-- Basis independence of the Gram determinant `det(Dᵢf · Dⱼf)` of the Jacobian (Simon Ch. 6,
3.4–3.7; push-forward of an orientation in 7.1.2): if the orthonormal `n`-frame `τ` spans `Q`, then
`det(⟨L eᵢ, L eⱼ⟩) = det(⟨L τₐ, L τ_b⟩)` for `e = stdOrthonormalBasis ℝ Q`.  With
`L' = L ∘ ι_Q` and `T = L'^* L'`, the matrix of `T` in any orthonormal basis `b` of `Q` is the
Gram matrix `(⟨L bᵢ, L bⱼ⟩)`, so both determinants equal `det T`. -/
theorem Submission.dpf_det_gram_stdOrthonormalBasis_eq : ∀ (P n : ℕ) (Q : Submodule ℝ (Euclid P)) (L : Euclid P →L[ℝ] Euclid P) (τ : Fin n → Euclid P), Orthonormal ℝ τ → Submodule.span ℝ (Set.range τ) = Q → Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ Q) => inner ℝ (L (stdOrthonormalBasis ℝ Q i)) (L (stdOrthonormalBasis ℝ Q j))) = Matrix.det (Matrix.of fun i j : Fin n => inner ℝ (L (τ i)) (L (τ j))) := by
  intro P n Q L τ hτ hQ
  -- `L' = L ∘ ι_Q : Q → ℝᴾ` and the endomorphism `T = L'^* L'` of `Q`
  let L' : Q →ₗ[ℝ] Euclid P := (L : Euclid P →ₗ[ℝ] Euclid P) ∘ₗ Q.subtype
  let T : Q →ₗ[ℝ] Q := LinearMap.adjoint L' ∘ₗ L'
  -- in an orthonormal basis `b` of `Q`, the matrix of `T` is the Gram matrix `(⟨L bᵢ, L bⱼ⟩)`
  have key : ∀ {ι : Type} [Fintype ι] [DecidableEq ι] (b : OrthonormalBasis ι ℝ Q),
      Matrix.det (Matrix.of fun i j : ι => inner ℝ (L (b i : Euclid P)) (L (b j : Euclid P))) =
        LinearMap.det T := by
    intro ι _ _ b
    rw [← LinearMap.det_toMatrix b.toBasis T]
    congr 1
    ext i j
    rw [LinearMap.toMatrix_apply, OrthonormalBasis.coe_toBasis,
      OrthonormalBasis.coe_toBasis_repr_apply, OrthonormalBasis.repr_apply_apply]
    simp only [T, LinearMap.comp_apply, LinearMap.adjoint_inner_right, Matrix.of_apply]
    rfl
  -- `τ`, regarded in `Q`, is an orthonormal basis of `Q`
  have hmem : ∀ a, τ a ∈ Q := fun a => hQ ▸ Submodule.subset_span (Set.mem_range_self a)
  let τ' : Fin n → Q := fun a => ⟨τ a, hmem a⟩
  have hτ' : Orthonormal ℝ τ' := by
    rw [orthonormal_iff_ite] at hτ ⊢
    exact hτ
  have hspan' : ⊤ ≤ Submodule.span ℝ (Set.range τ') := by
    have hmap : Submodule.map Q.subtype (Submodule.span ℝ (Set.range τ')) =
        Submodule.map Q.subtype ⊤ := by
      rw [Submodule.map_span, ← Set.range_comp, Submodule.map_top, Submodule.range_subtype]
      exact hQ
    rw [Submodule.map_injective_of_injective Q.injective_subtype hmap]
  have h2 := key (OrthonormalBasis.mk hτ' hspan')
  simp only [OrthonormalBasis.coe_mk] at h2
  exact (key (stdOrthonormalBasis ℝ Q)).trans h2.symm
/-- **Simon Ch. 2, 4.11–4.12, (2.1)**: the Jacobian of `Φ ∘ ψ` factors through a chart.  Let
`ψ : V → W` be a local representation of `N` as in (4.1), `Q(x) = T_xN` on `N`, `v ∈ V` and `Φ`
differentiable at `ψ(v)`.  With `A = Dψ(v)`, `L = DΦ(ψ(v))` and `G(T) = det[⟨Teₖ, Teₗ⟩]`,
`G(A) > 0` and `√G(D(Φ ∘ ψ)(v)) = J^NΦ(ψ(v)) · √G(A)`, where `J^NΦ(y) = √det[⟨Lτᵢ, Lτⱼ⟩]` for
`τ = stdOrthonormalBasis ℝ (Q y)`.  Indeed `D(Φ ∘ ψ)(v) = L ∘ A` and `Q(ψ(v)) = T_{ψ(v)}N = range A`,
of dimension `m` as `A` is injective; for an orthonormal frame `σ` of `range A`,
`G(L ∘ A) = det[⟨Lσᵢ, Lσⱼ⟩] · G(A)` and `det[⟨Lσᵢ, Lσⱼ⟩] = det[⟨Lτᵢ, Lτⱼ⟩]`. -/
theorem Submission.codim1_ac_saf_chart_gram_factor : ∀ (P m r : ℕ) (N W : Set (Euclid P)) (V : Set (Euclid m)) (ψ : Euclid m → Euclid P) (Q : Euclid P → Submodule ℝ (Euclid P)) (Φ : Euclid P → Euclid P) (v : Euclid m), 1 ≤ r → IsOpen V → IsOpen W → ContDiffOn ℝ r ψ V → InjOn ψ V → ψ '' V = W ∩ N → (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → (∀ z ∈ V, Injective (fderiv ℝ ψ z)) → (∀ x ∈ N, (Q x : Set (Euclid P)) = tangentSpace N x) → DifferentiableAt ℝ Φ (ψ v) → v ∈ V → 0 < Matrix.det (Matrix.of fun k l : Fin m => inner ℝ (fderiv ℝ ψ v (EuclideanSpace.single k 1)) (fderiv ℝ ψ v (EuclideanSpace.single l 1))) ∧ Real.sqrt (Matrix.det (Matrix.of fun k l : Fin m => inner ℝ (fderiv ℝ (Φ ∘ ψ) v (EuclideanSpace.single k 1)) (fderiv ℝ (Φ ∘ ψ) v (EuclideanSpace.single l 1)))) = Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ (Q (ψ v))) => inner ℝ (fderiv ℝ Φ (ψ v) (stdOrthonormalBasis ℝ (Q (ψ v)) i)) (fderiv ℝ Φ (ψ v) (stdOrthonormalBasis ℝ (Q (ψ v)) j)))) * Real.sqrt (Matrix.det (Matrix.of fun k l : Fin m => inner ℝ (fderiv ℝ ψ v (EuclideanSpace.single k 1)) (fderiv ℝ ψ v (EuclideanSpace.single l 1)))) := by
  intro P m r N W V ψ Q Φ v hr hV hW hψ hinj hψV hprop hDψ hQ hΦ hv
  -- chain rule: `ψ` is `C¹` on the open set `V`, so `D(Φ ∘ ψ)(v) = DΦ(ψ(v)) ∘ Dψ(v)`
  have hψ1 : ContDiffOn ℝ 1 ψ V := hψ.of_le (by exact_mod_cast hr)
  have hψd : DifferentiableAt ℝ ψ v :=
    (hψ1.differentiableOn one_ne_zero v hv).differentiableAt (hV.mem_nhds hv)
  have hchain : fderiv ℝ (Φ ∘ ψ) v = (fderiv ℝ Φ (ψ v)).comp (fderiv ℝ ψ v) :=
    fderiv_comp v hΦ hψd
  -- `Q(ψ(v)) = T_{ψ(v)}N = range Dψ(v)`, as `ψ(v) ∈ ψ(V) = W ∩ N`
  have hT := Submission.chart_tangentSpace_eq_range_fderiv P m r N W V ψ v hr hV hW hψ hinj hψV
    hprop hDψ hv
  have hψvWN : ψ v ∈ W ∩ N := hψV ▸ mem_image_of_mem ψ hv
  set A : Euclid m →L[ℝ] Euclid P := fderiv ℝ ψ v
  set L : Euclid P →L[ℝ] Euclid P := fderiv ℝ Φ (ψ v)
  have hQv : Q (ψ v) = LinearMap.range (A : Euclid m →ₗ[ℝ] Euclid P) := by
    apply SetLike.coe_injective
    rw [hQ _ hψvWN.2, hT, LinearMap.coe_range]
    rfl
  -- an orthonormal frame `σ : Fin m → ℝᴾ` of `S = range A`, which has dimension `m` (`A` injective)
  have hAinj : Injective A := hDψ v hv
  set S : Submodule ℝ (Euclid P) := LinearMap.range (A : Euclid m →ₗ[ℝ] Euclid P) with hS
  have hfr : Module.finrank ℝ S = m := by
    rw [hS, LinearMap.finrank_range_of_inj (f := (A : Euclid m →ₗ[ℝ] Euclid P)) hAinj,
      finrank_euclideanSpace_fin]
  let b : OrthonormalBasis (Fin m) ℝ S := (stdOrthonormalBasis ℝ S).reindex (finCongr hfr)
  let σ : Fin m → Euclid P := fun i => (b i : Euclid P)
  have hσ : Orthonormal ℝ σ := b.orthonormal.comp_linearIsometry S.subtypeₗᵢ
  have hspan : Submodule.span ℝ (Set.range σ) = S := by
    have hrange : Set.range σ = S.subtype '' Set.range b := by
      ext x
      simp [σ]
    rw [hrange, Submodule.span_image]
    have htop : Submodule.span ℝ (Set.range b) = ⊤ := by
      simpa [OrthonormalBasis.coe_toBasis] using b.toBasis.span_eq
    rw [htop, Submodule.map_top, Submodule.range_subtype]
  -- `G(A) > 0` and `G(L ∘ A) = det[⟨Lσᵢ, Lσⱼ⟩] · G(A) = det[⟨Lτᵢ, Lτⱼ⟩] · G(A)`
  have hcomp := Submission.codim1_lura_gram_det_comp_orthonormal m P P A
  have hpos := hcomp.1 hAinj
  have hmul := hcomp.2 L σ hσ hspan
  have hstd := Submission.dpf_det_gram_stdOrthonormalBasis_eq P m (Q (ψ v)) L σ hσ
    (hspan.trans hQv.symm)
  refine ⟨hpos, ?_⟩
  rw [hchain]
  simp only [ContinuousLinearMap.comp_apply]
  rw [hmul, hstd, Real.sqrt_mul' _ hpos.le]
/-- **Graph chart of an embedded `C¹` submanifold** (Simon Ch. 2, §4, (4.4)).  Take a chart
`ψ : V → W₀` at `p = ψ(v₀)` and, in place of Simon's coordinate projection, `pr = ‖A‖⁻¹ A*`,
`A = Dψ(v₀)`, so `‖pr‖ ≤ 1` and `pr ∘ A` is injective.  The inverse function theorem for
`Φ = pr(ψ − p)` gives a `C¹` local inverse `χ` near `Φ(v₀) = 0`, and `G = ψ ∘ χ` satisfies
`pr(G(a) − p) = a`.  Continuity of `ψ⁻¹` at `p` and a small radius `r` give `M ∩ W = G(B_r(0))`
for `W = W₀ ∩ B_δ(p) ∩ {z : pr(z − p) ∈ B_r(0)}`; `DG` is bounded on `B̄_r(0)`, so `G` is
Lipschitz on `B_r(0)`.  Differentiating `pr(G(a) − p) = a` gives `pr ∘ DG(a) = id`, and `Dχ(a)`
is invertible, so `T_{G(a)}M = Dψ(χ(a))(ℝᵐ) = DG(a)(ℝᵐ)`. -/
theorem Submission.codim1_hcp_lsa_c1_graph_chart : ∀ (P m : ℕ) (M : Set (Euclid P)) (p : Euclid P), IsEmbeddedSubmanifold 1 m M → p ∈ M → ∃ (pr : Euclid P →L[ℝ] Euclid m) (G : Euclid m → Euclid P) (r : ℝ) (W : Set (Euclid P)) (Λ : NNReal), 0 < r ∧ IsOpen W ∧ p ∈ W ∧ ‖pr‖ ≤ 1 ∧ G 0 = p ∧ ContDiffOn ℝ 1 G (ball 0 r) ∧ LipschitzOnWith Λ G (ball 0 r) ∧ M ∩ W = G '' ball 0 r ∧ (∀ a ∈ ball (0 : Euclid m) r, pr (G a - p) = a) ∧ (∀ a ∈ ball (0 : Euclid m) r, pr ∘L fderiv ℝ G a = ContinuousLinearMap.id ℝ (Euclid m)) ∧ ∀ a ∈ ball (0 : Euclid m) r, tangentSpace M (G a) = Set.range (fderiv ℝ G a) := by
  intro P m M p hM hp
  -- step 1: a chart `(V, W₀, ψ)` at `p = ψ(v₀)`
  obtain ⟨V, W₀, ψ, hVo, hW₀o, hpW₀, hψc, hψinj, hψV, hproper, hDψinj⟩ := hM p hp
  obtain ⟨v₀, hv₀, hψv₀⟩ : p ∈ ψ '' V := by rw [hψV]; exact ⟨hpW₀, hp⟩
  have hψd : ∀ v ∈ V, HasFDerivAt ψ (fderiv ℝ ψ v) v := fun v hv =>
    ((hψc.contDiffAt (hVo.mem_nhds hv)).differentiableAt one_ne_zero).hasFDerivAt
  -- step 2: the projection `pr = ‖A‖⁻¹ • A*`, `A = Dψ(v₀)`
  set A : Euclid m →L[ℝ] Euclid P := fderiv ℝ ψ v₀ with hA
  set pr : Euclid P →L[ℝ] Euclid m := ‖A‖⁻¹ • ContinuousLinearMap.adjoint A with hprdef
  have hpr : ‖pr‖ ≤ 1 := by
    rw [hprdef, norm_smul, LinearIsometryEquiv.norm_map, norm_inv, norm_norm]
    rcases eq_or_ne ‖A‖ 0 with h | h
    · rw [h]; simp
    · rw [inv_mul_cancel₀ h]
  have hprA : Injective (pr.comp A) := by
    refine (injective_iff_map_eq_zero (pr.comp A)).2 fun h hh => ?_
    have hh' : pr (A h) = 0 := hh
    rcases eq_or_ne ‖A‖ 0 with h0 | h0
    · have hA0 : A = 0 := norm_eq_zero.1 h0
      apply hDψinj v₀ hv₀
      rw [← hA, hA0, map_zero]; rfl
    · have h1 : ContinuousLinearMap.adjoint A (A h) = 0 := by
        have : ‖A‖⁻¹ • ContinuousLinearMap.adjoint A (A h) = 0 := hh'
        exact (smul_eq_zero.1 this).resolve_left (inv_ne_zero h0)
      have h2 : ‖A h‖ ^ 2 = 0 := by
        rw [← real_inner_self_eq_norm_sq, ← ContinuousLinearMap.adjoint_inner_left, h1,
          inner_zero_left]
      have h3 : A h = 0 := norm_eq_zero.1 (pow_eq_zero_iff two_ne_zero |>.1 h2)
      exact hDψinj v₀ hv₀ (by rw [← hA, h3, map_zero])
  -- step 3: the coordinate map `Φ = pr(ψ − p)` and its local inverse `χ`
  set Φ : Euclid m → Euclid m := fun v => pr (ψ v - p) with hΦ
  have hΦc : ContDiffOn ℝ 1 Φ V := pr.contDiff.comp_contDiffOn (hψc.sub contDiffOn_const)
  have hΦd : ∀ v ∈ V, HasFDerivAt Φ (pr.comp (fderiv ℝ ψ v)) v := fun v hv =>
    pr.hasFDerivAt.comp v ((hψd v hv).sub_const p)
  have hΦinj : Injective (fderiv ℝ Φ v₀) := by rw [(hΦd v₀ hv₀).fderiv]; exact hprA
  obtain ⟨V₀, O, χ, hV₀o, hOo, hv₀V₀, hV₀V, hχc, hχmaps, hΦχ, hχΦ⟩ :=
    Submission.codim1_zsl_gc_local_inverse m Φ V v₀ hVo hv₀ hΦc hΦinj
  -- step 4: the embedding margin `δ`
  obtain ⟨ε, hε, hεV₀⟩ := Metric.isOpen_iff.1 hV₀o v₀ hv₀V₀
  obtain ⟨δ, hδ, hδε⟩ := Submission.dsmc_chart_inverse_continuity P m V W₀ ψ hψc.continuousOn
    hψinj (by rw [hψV]; exact inter_subset_left) hproper v₀ hv₀ ε hε
  have hΦv₀ : Φ v₀ = 0 := by simp [hΦ, hψv₀]
  have h0O : (0 : Euclid m) ∈ O := by rw [← hΦv₀]; exact (hχΦ v₀ hv₀V₀).1
  have hχ0 : χ 0 = v₀ := by rw [← hΦv₀]; exact (hχΦ v₀ hv₀V₀).2
  -- step 5: the graph map `G = ψ ∘ χ` and the radius `r`
  set G : Euclid m → Euclid P := fun a => ψ (χ a) with hGdef
  have hG0 : G 0 = p := by simp [hGdef, hχ0, hψv₀]
  have hGc : ContDiffOn ℝ 1 G O := hψc.comp hχc fun a ha => hV₀V (hχmaps ha)
  obtain ⟨r₁, hr₁, hr₁O⟩ := Metric.isOpen_iff.1 hOo 0 h0O
  have hGcont0 : ContinuousAt G 0 := hGc.continuousOn.continuousAt (hOo.mem_nhds h0O)
  obtain ⟨r₂, hr₂, hr₂δ⟩ := Metric.mem_nhds_iff.1
    (hGcont0.preimage_mem_nhds (by rw [hG0]; exact ball_mem_nhds p hδ))
  set r : ℝ := min (r₁ / 2) r₂ with hr
  have hrpos : 0 < r := lt_min (by positivity) hr₂
  have hcbO : closedBall (0 : Euclid m) r ⊆ O :=
    (closedBall_subset_ball (lt_of_le_of_lt (min_le_left _ _) (by linarith))).trans hr₁O
  have hbO : ball (0 : Euclid m) r ⊆ O := ball_subset_closedBall.trans hcbO
  have hbδ : ∀ a ∈ ball (0 : Euclid m) r, G a ∈ ball p δ := fun a ha =>
    hr₂δ (ball_subset_ball (min_le_right _ _) ha)
  -- the Lipschitz bound on `B_r(0)`: `DG` is bounded on the compact set `B̄_r(0)`
  obtain ⟨Cb, hCb⟩ := (isCompact_closedBall (0 : Euclid m) r).exists_bound_of_continuousOn
    ((hGc.continuousOn_fderiv_of_isOpen hOo le_rfl).mono hcbO)
  have hGda : ∀ a ∈ O, HasFDerivAt G (fderiv ℝ G a) a := fun a ha =>
    ((hGc.contDiffAt (hOo.mem_nhds ha)).differentiableAt one_ne_zero).hasFDerivAt
  have hGL : LipschitzOnWith (Real.toNNReal Cb) G (ball 0 r) := by
    refine (convex_ball (0 : Euclid m) r).lipschitzOnWith_of_nnnorm_fderiv_le
      (fun a ha => (hGda a (hbO ha)).differentiableAt) fun a ha => ?_
    rw [← NNReal.coe_le_coe, coe_nnnorm]
    exact (hCb a (ball_subset_closedBall ha)).trans (Real.le_coe_toNNReal Cb)
  -- step 6: the chart domain `W`
  set W : Set (Euclid P) := W₀ ∩ ball p δ ∩ (fun z => pr (z - p)) ⁻¹' ball 0 r with hW
  have hWo : IsOpen W := (hW₀o.inter isOpen_ball).inter (isOpen_ball.preimage (by fun_prop))
  have hpW : p ∈ W := ⟨⟨hpW₀, mem_ball_self hδ⟩, by simp [hrpos]⟩
  -- step 7: `pr(G(a) − p) = a`
  have hleft : ∀ a ∈ ball (0 : Euclid m) r, pr (G a - p) = a := fun a ha => hΦχ a (hbO ha)
  -- step 8: `M ∩ W = G(B_r(0))`
  have hMW : M ∩ W = G '' ball 0 r := by
    ext x
    constructor
    · rintro ⟨hxM, ⟨hxW₀, hxδ⟩, hxr⟩
      obtain ⟨v', hv', rfl⟩ : x ∈ ψ '' V := by rw [hψV]; exact ⟨hxW₀, hxM⟩
      have hv'ε : dist v' v₀ < ε := hδε v' hv' (by rw [hψv₀]; exact hxδ)
      have hv'V₀ : v' ∈ V₀ := hεV₀ hv'ε
      refine ⟨Φ v', hxr, ?_⟩
      show ψ (χ (Φ v')) = ψ v'
      rw [(hχΦ v' hv'V₀).2]
    · rintro ⟨a, ha, rfl⟩
      have hχV : χ a ∈ V := hV₀V (hχmaps (hbO ha))
      have hGa : G a ∈ W₀ ∩ M := by rw [← hψV]; exact mem_image_of_mem ψ hχV
      refine ⟨hGa.2, ⟨hGa.1, hbδ a ha⟩, ?_⟩
      show pr (G a - p) ∈ ball 0 r
      rw [hleft a ha]; exact ha
  -- step 9: `pr ∘ DG(a) = id`
  have hderiv : ∀ a ∈ ball (0 : Euclid m) r,
      pr ∘L fderiv ℝ G a = ContinuousLinearMap.id ℝ (Euclid m) := by
    intro a ha
    have h1 : HasFDerivAt (fun b => pr (G b - p)) (pr.comp (fderiv ℝ G a)) a :=
      pr.hasFDerivAt.comp a ((hGda a (hbO ha)).sub_const p)
    have h2 : (fun b => pr (G b - p)) =ᶠ[𝓝 a] fun b => b := by
      filter_upwards [isOpen_ball.mem_nhds ha] with b hb using hleft b hb
    rw [← h1.fderiv, h2.fderiv_eq, fderiv_fun_id]
  -- step 10: `T_{G(a)}M = DG(a)(ℝᵐ)`
  have htan : ∀ a ∈ ball (0 : Euclid m) r,
      tangentSpace M (G a) = Set.range (fderiv ℝ G a) := by
    intro a ha
    have haO : a ∈ O := hbO ha
    have hχV : χ a ∈ V := hV₀V (hχmaps haO)
    have hχd : HasFDerivAt χ (fderiv ℝ χ a) a :=
      ((hχc.contDiffAt (hOo.mem_nhds haO)).differentiableAt one_ne_zero).hasFDerivAt
    have hGfd : fderiv ℝ G a = (fderiv ℝ ψ (χ a)).comp (fderiv ℝ χ a) :=
      ((hψd (χ a) hχV).comp a hχd).fderiv
    -- `Dχ(a)` is injective, hence surjective
    have hsurj : Surjective (fderiv ℝ χ a) := by
      have hid : (fderiv ℝ Φ (χ a)).comp (fderiv ℝ χ a) = ContinuousLinearMap.id ℝ (Euclid m) := by
        have h1 : HasFDerivAt (fun b => Φ (χ b)) ((fderiv ℝ Φ (χ a)).comp (fderiv ℝ χ a)) a :=
          (hΦd (χ a) hχV).differentiableAt.hasFDerivAt.comp a hχd
        have h2 : (fun b => Φ (χ b)) =ᶠ[𝓝 a] fun b => b := by
          filter_upwards [hOo.mem_nhds haO] with b hb using hΦχ b hb
        rw [← h1.fderiv, h2.fderiv_eq, fderiv_fun_id]
      have hinj : Injective (fderiv ℝ χ a) := by
        intro u v huv
        have := congrArg (fderiv ℝ Φ (χ a)) huv
        have hu := congrArg (fun L => L u) hid
        have hv := congrArg (fun L => L v) hid
        simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.id_apply] at hu hv
        rw [← hu, ← hv]; exact this
      exact (LinearMap.injective_iff_surjective (f := ((fderiv ℝ χ a : Euclid m →L[ℝ] Euclid m) :
        Euclid m →ₗ[ℝ] Euclid m))).1 hinj
    rw [show G a = ψ (χ a) from rfl, Submission.chart_tangentSpace_eq_range_fderiv P m 1 M W₀ V ψ
      (χ a) le_rfl hVo hW₀o hψc hψinj hψV hproper hDψinj hχV, hGfd, ContinuousLinearMap.coe_comp,
      hsurj.range_comp]
  exact ⟨pr, G, r, W, Real.toNNReal Cb, hrpos, hWo, hpW, hpr, hG0, hGc.mono hbO, hGL, hMW, hleft,
    hderiv, htan⟩

/-- Derivatives within a set are unique on the span of its curve tangent vectors (Simon Ch. 2,
§4, p. 55; cf. (4.6)–(4.7)), for an arbitrary set `M ⊆ ℝᴾ`.  If `f` has derivative `f'` within
`M` at `x`, then so does `L = fderivWithin ℝ f M x`, and two derivatives within `M` agree on the
tangent cone of `M` at `x`.  Each `w = γ'(0) ∈ T_xM` lies in that cone: as `t → 0`, `t ≠ 0`,
`γ(t) − x → 0`, `x + (γ(t) − x) = γ(t) ∈ M` and `t⁻¹(γ(t) − x) → w`.  So `L = f'` on `T_xM`,
hence on its linear span. -/
theorem Submission.codim1_hcp_lsa_fderivWithin_eq_on_tangent_span : ∀ (P : ℕ) (M : Set (Euclid P)) (f : Euclid P → ℝ) (f' : Euclid P →L[ℝ] ℝ) (x v : Euclid P), HasFDerivWithinAt f f' M x → v ∈ Submodule.span ℝ (tangentSpace M x) → fderivWithin ℝ f M x v = f' v := by
  intro P M f f' x v hf hv
  -- `L = fderivWithin ℝ f M x` and `f'` are both derivatives of `f` within `M` at `x`, so they
  -- agree on the tangent cone of `M` at `x`
  have huniq : EqOn (fderivWithin ℝ f M x) f' (tangentConeAt ℝ M x) :=
    hf.differentiableWithinAt.hasFDerivWithinAt.unique_on hf
  -- the velocity `w = γ'(0)` of a curve `γ` in `M` through `x` lies in the tangent cone:
  -- take `c(t) = t⁻¹` and `d(t) = γ(t) − x` as `t → 0`, `t ≠ 0`
  have hcone : tangentSpace M x ⊆ tangentConeAt ℝ M x := by
    rintro w ⟨γ, -, hγM, hγ0, hγw⟩
    refine mem_tangentConeAt_of_seq (𝓝[≠] (0 : ℝ)) (fun t => t⁻¹) (fun t => γ t - x) ?_ ?_ ?_
    · -- `γ(t) − x → 0`, since `γ` is continuous at `0` and `γ(0) = x`
      rw [tendsto_sub_nhds_zero_iff, ← hγ0]
      exact hγw.continuousAt.tendsto.mono_left nhdsWithin_le_nhds
    · -- `x + (γ(t) − x) = γ(t) ∈ M` for `t ∈ (−1, 1)`
      filter_upwards [nhdsWithin_le_nhds (Ioo_mem_nhds (by norm_num : (-1 : ℝ) < 0) one_pos)]
        with t ht
      rw [add_sub_cancel]
      exact hγM ht
    · -- `t⁻¹(γ(t) − x) = t⁻¹(γ(0 + t) − γ(0)) → γ'(0) = w`
      simpa [hγ0] using hγw.tendsto_slope_zero
  -- `L = f'` on `T_xM`, hence on its linear span
  exact LinearMap.eqOn_span (f := (fderivWithin ℝ f M x : Euclid P →ₗ[ℝ] ℝ))
    (g := (f' : Euclid P →ₗ[ℝ] ℝ)) (fun w hw => huniq (hcone hw)) hv
/-- Near-isometric local parametrizations of an embedded `C¹` submanifold `M` (charts as in
Simon Ch. 2, (4.1)): for `z ∈ M` and `ε > 0` there are `χ` with `χ(0) = z` and `δ, δ' > 0` such
that `χ` is `(1 ± ε)`-bi-Lipschitz on `B_δ(0)`, `χ(B_δ(0)) ⊆ M` and `M ∩ B_{δ'}(z) ⊆ χ(B_δ(0))`.
Take a chart `ψ` with `ψ(v₀) = z`, choose `L ∈ GL(ℝⁿ)` with `Dψ(v₀) ∘ L` a linear isometry (an
orthonormal basis of `Dψ(v₀)(ℝⁿ)`) and put `χ(w) = ψ(v₀ + Lw)`; strict differentiability of `χ`
at `0` gives the two-point bounds, and continuity of the chart inverse
(`Submission.dsmc_chart_inverse_continuity`) gives the covering of `M ∩ B_{δ'}(z)`. -/
theorem Submission.dimred_rpd_near_isometric_chart : ∀ (P n : ℕ) (M : Set (Euclid P)) (z : Euclid P), IsEmbeddedSubmanifold 1 n M → z ∈ M → ∀ ε : ℝ, 0 < ε → ∃ (χ : Euclid n → Euclid P) (δ δ' : ℝ), 0 < δ ∧ 0 < δ' ∧ χ 0 = z ∧ (∀ a ∈ ball (0 : Euclid n) δ, ∀ b ∈ ball (0 : Euclid n) δ, (1 - ε) * ‖a - b‖ ≤ ‖χ a - χ b‖ ∧ ‖χ a - χ b‖ ≤ (1 + ε) * ‖a - b‖) ∧ χ '' ball 0 δ ⊆ M ∧ M ∩ ball z δ' ⊆ χ '' ball 0 δ := by
  intro P n M z hM hz ε hε
  obtain ⟨V, W, ψ, hV, hW, hzW, hψ, hinj, himg, hprop, hder⟩ := hM z hz
  obtain ⟨v₀, hv₀V, hψv₀⟩ : z ∈ ψ '' V := by rw [himg]; exact ⟨hzW, hz⟩
  set A : Euclid n →L[ℝ] Euclid P := fderiv ℝ ψ v₀
  have hA : Injective A := hder v₀ hv₀V
  have hstrict : HasStrictFDerivAt ψ A v₀ :=
    (hψ.contDiffAt (hV.mem_nhds hv₀V)).hasStrictFDerivAt one_ne_zero
  -- isometric normalization
  obtain ⟨L, hLJ⟩ : ∃ L : Euclid n ≃L[ℝ] Euclid n, ∀ w, ‖A (L w)‖ = ‖w‖ := by
    let Q := LinearMap.range (A : Euclid n →ₗ[ℝ] Euclid P)
    have hfin : Module.finrank ℝ Q = n := by
      rw [LinearMap.finrank_range_of_inj hA, finrank_euclideanSpace_fin]
    let b : OrthonormalBasis (Fin n) ℝ Q := (stdOrthonormalBasis ℝ Q).reindex (finCongr hfin)
    let A' : Euclid n ≃ₗ[ℝ] Q := LinearEquiv.ofInjective (A : Euclid n →ₗ[ℝ] Euclid P) hA
    let L₀ : Euclid n ≃ₗ[ℝ] Euclid n := b.repr.symm.toLinearEquiv.trans A'.symm
    refine ⟨L₀.toContinuousLinearEquiv, fun w => ?_⟩
    have h1 : A' (L₀ w) = b.repr.symm w := by simp [L₀]
    have h2 : A (L₀ w) = ((A' (L₀ w) : Q) : Euclid P) := rfl
    change ‖A (L₀ w)‖ = ‖w‖
    rw [h2, h1]
    exact b.repr.symm.norm_map w
  set χ : Euclid n → Euclid P := fun w => ψ (v₀ + L w)
  have hχ0 : χ 0 = z := by simp [χ, hψv₀]
  have hχstrict : HasStrictFDerivAt χ (A.comp (L : Euclid n →L[ℝ] Euclid n)) 0 := by
    have h1 : HasStrictFDerivAt (fun w : Euclid n => v₀ + L w) (L : Euclid n →L[ℝ] Euclid n) 0 :=
      (L.hasStrictFDerivAt).const_add v₀
    have h2 : HasStrictFDerivAt ψ A (v₀ + L 0) := by simpa using hstrict
    exact h2.comp (0 : Euclid n) h1
  -- two-point estimate
  have h1 := (hasStrictFDerivAt_iff_isLittleO.1 hχstrict).bound hε
  have h2 : ∀ᶠ w in 𝓝 (0 : Euclid n), v₀ + L w ∈ V := by
    have hc : Continuous (fun w : Euclid n => v₀ + L w) := continuous_const.add L.continuous
    have : (fun w : Euclid n => v₀ + L w) 0 ∈ V := by simpa using hv₀V
    exact hc.continuousAt.preimage_mem_nhds (hV.mem_nhds this)
  obtain ⟨δ₁, hδ₁, hball1⟩ := Metric.eventually_nhds_iff_ball.1 h1
  obtain ⟨δ₂, hδ₂, hball2⟩ := Metric.eventually_nhds_iff_ball.1 h2
  set δ := min δ₁ δ₂
  have hδ : 0 < δ := lt_min hδ₁ hδ₂
  have hδV : ∀ w ∈ ball (0 : Euclid n) δ, v₀ + L w ∈ V :=
    fun w hw => hball2 w (ball_subset_ball (min_le_right _ _) hw)
  have hbil : ∀ a ∈ ball (0 : Euclid n) δ, ∀ b ∈ ball (0 : Euclid n) δ,
      (1 - ε) * ‖a - b‖ ≤ ‖χ a - χ b‖ ∧ ‖χ a - χ b‖ ≤ (1 + ε) * ‖a - b‖ := by
    intro a ha b hb
    have hab : (a, b) ∈ ball ((0 : Euclid n), (0 : Euclid n)) δ₁ := by
      rw [← ball_prod_same]
      exact ⟨ball_subset_ball (min_le_left _ _) ha, ball_subset_ball (min_le_left _ _) hb⟩
    have he := hball1 (a, b) hab
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearEquiv.coe_coe] at he
    have hn : ‖A (L (a - b))‖ = ‖a - b‖ := hLJ _
    have t1 := norm_sub_norm_le (χ a - χ b) (A (L (a - b)))
    have t2 := norm_sub_norm_le (A (L (a - b))) (χ a - χ b)
    rw [norm_sub_rev (A (L (a - b))) (χ a - χ b)] at t2
    constructor <;> linarith
  -- local surjectivity
  have hinvc := Submission.dsmc_chart_inverse_continuity P n V W ψ hψ.continuousOn hinj
    (by rw [himg]; exact inter_subset_left) hprop v₀ hv₀V
  set C : ℝ := ‖((L.symm : Euclid n ≃L[ℝ] Euclid n) : Euclid n →L[ℝ] Euclid n)‖ with hCdef
  have hC : 0 ≤ C := norm_nonneg _
  obtain ⟨η, hη, hηprop⟩ := hinvc (δ / (C + 1)) (div_pos hδ (by linarith))
  obtain ⟨r₀, hr₀, hr₀W⟩ := Metric.isOpen_iff.1 hW z hzW
  refine ⟨χ, δ, min η r₀, hδ, lt_min hη hr₀, hχ0, hbil, ?_, ?_⟩
  · rintro _ ⟨w, hw, rfl⟩
    have : ψ (v₀ + L w) ∈ W ∩ M := by rw [← himg]; exact ⟨_, hδV w hw, rfl⟩
    exact this.2
  · rintro x ⟨hxM, hxb⟩
    have hxW : x ∈ W := hr₀W (ball_subset_ball (min_le_right _ _) hxb)
    obtain ⟨v', hv'V, rfl⟩ : x ∈ ψ '' V := by rw [himg]; exact ⟨hxW, hxM⟩
    have hd : dist (ψ v') (ψ v₀) < η := by
      rw [hψv₀]; exact lt_of_lt_of_le (mem_ball.1 hxb) (min_le_left _ _)
    have hv' := hηprop v' hv'V hd
    refine ⟨L.symm (v' - v₀), ?_, ?_⟩
    · rw [mem_ball, dist_zero_right]
      calc ‖L.symm (v' - v₀)‖ ≤ C * ‖v' - v₀‖ := by
            rw [hCdef]
            exact ContinuousLinearMap.le_opNorm
              ((L.symm : Euclid n ≃L[ℝ] Euclid n) : Euclid n →L[ℝ] Euclid n) (v' - v₀)
        _ ≤ C * (δ / (C + 1)) := by
            apply mul_le_mul_of_nonneg_left _ hC
            rw [← dist_eq_norm]; exact hv'.le
        _ < δ := by
            rw [mul_div_assoc', div_lt_iff₀ (by linarith)]
            nlinarith
    · simp [χ]
/-- **Bi-Lipschitz images** (Simon Ch. 2, 1.8(i), applied to `χ` and to its inverse): if
`c₁|a − b| ≤ |χ(a) − χ(b)| ≤ c₂|a − b|` on `E ⊆ ℝⁿ`, then `c₁ⁿ Lⁿ(E) ≤ Hⁿ(χ(E)) ≤ c₂ⁿ Lⁿ(E)`.
`Hⁿ = μHE[n]` is `c · μH[n]` with one constant `c` on every metric space and equals `volume` on
`ℝⁿ`; `χ` is `c₂`-Lipschitz on `E`, and it is injective there with `c₁⁻¹`-Lipschitz inverse on
`χ(E)`. -/
theorem Submission.dimred_rpd_bilipschitz_image_measure : ∀ (P n : ℕ) (χ : Euclid n → Euclid P) (E : Set (Euclid n)) (c₁ c₂ : ℝ), 0 < c₁ → 0 ≤ c₂ → (∀ a ∈ E, ∀ b ∈ E, c₁ * ‖a - b‖ ≤ ‖χ a - χ b‖ ∧ ‖χ a - χ b‖ ≤ c₂ * ‖a - b‖) → ENNReal.ofReal (c₁ ^ n) * volume E ≤ μHE[n] (χ '' E) ∧ μHE[n] (χ '' E) ≤ ENNReal.ofReal (c₂ ^ n) * volume E := by
  intro P n χ E c₁ c₂ hc₁ hc₂ h
  -- `Lⁿ = Hⁿ` on `ℝⁿ`, and `Hⁿ = c · μH[n]` on every metric space
  have hvol : (volume : Measure (Euclid n)) = μHE[n] :=
    (EuclideanSpace.euclideanHausdorffMeasure_eq_volume n).symm
  have hscale : ∀ {X : Type} [EMetricSpace X] [MeasurableSpace X] [BorelSpace X] (S : Set X),
      (μHE[n] : Measure X) S = (Measure.addHaarScalarFactor
        (volume : Measure (EuclideanSpace ℝ (Fin n))) μH[n] : ℝ≥0∞) * μH[(n : ℝ)] S := by
    intro X _ _ _ S
    rw [Measure.euclideanHausdorffMeasure_def, Measure.smul_apply, ENNReal.smul_def, smul_eq_mul]
  constructor
  · -- lower bound: `χ` is injective on `E` and its inverse on `χ(E)` is `c₁⁻¹`-Lipschitz
    have hinj : InjOn χ E := by
      intro a ha b hb hab
      have := (h a ha b hb).1
      rw [hab, sub_self, norm_zero] at this
      have : ‖a - b‖ = 0 := le_antisymm (by nlinarith [norm_nonneg (a - b)]) (norm_nonneg _)
      exact sub_eq_zero.1 (norm_eq_zero.1 this)
    set g := Function.invFunOn χ E
    have hleft : LeftInvOn g χ E := hinj.leftInvOn_invFunOn
    have hgL : LipschitzOnWith (Real.toNNReal c₁⁻¹) g (χ '' E) := by
      apply LipschitzOnWith.of_dist_le_mul
      rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩
      rw [hleft ha, hleft hb, dist_eq_norm, dist_eq_norm,
        Real.coe_toNNReal _ (inv_nonneg.2 hc₁.le)]
      have := (h a ha b hb).1
      rw [inv_mul_eq_div, le_div_iff₀ hc₁]
      linarith
    have himg : g '' (χ '' E) = E := hleft.image_image
    have hle := hgL.hausdorffMeasure_image_le (d := (n : ℝ)) (Nat.cast_nonneg n)
    rw [himg] at hle
    rw [hvol, hscale, hscale (χ '' E)]
    set c : ℝ≥0∞ := (Measure.addHaarScalarFactor
      (volume : Measure (EuclideanSpace ℝ (Fin n))) μH[n] : ℝ≥0∞)
    have hK : ((Real.toNNReal c₁⁻¹ : NNReal) : ℝ≥0∞) ^ (n : ℝ) = ENNReal.ofReal (c₁ ^ n)⁻¹ := by
      rw [ENNReal.rpow_natCast, ← ENNReal.ofReal_coe_nnreal,
        Real.coe_toNNReal _ (inv_nonneg.2 hc₁.le), ← ENNReal.ofReal_pow (inv_nonneg.2 hc₁.le),
        inv_pow]
    rw [hK] at hle
    have hpos : ENNReal.ofReal (c₁ ^ n) ≠ 0 := (ENNReal.ofReal_pos.2 (pow_pos hc₁ n)).ne'
    have hinv : ENNReal.ofReal (c₁ ^ n)⁻¹ = (ENNReal.ofReal (c₁ ^ n))⁻¹ :=
      ENNReal.ofReal_inv_of_pos (pow_pos hc₁ n)
    rw [hinv] at hle
    calc ENNReal.ofReal (c₁ ^ n) * (c * μH[(n : ℝ)] E)
        ≤ ENNReal.ofReal (c₁ ^ n) * (c * ((ENNReal.ofReal (c₁ ^ n))⁻¹ * μH[(n : ℝ)] (χ '' E))) := by
          gcongr
      _ = c * μH[(n : ℝ)] (χ '' E) := by
          rw [← mul_assoc, mul_comm (ENNReal.ofReal (c₁ ^ n)) c, mul_assoc,
            ← mul_assoc (ENNReal.ofReal (c₁ ^ n)), ENNReal.mul_inv_cancel hpos ENNReal.ofReal_ne_top,
            one_mul]
  · -- upper bound: `χ` is `c₂`-Lipschitz on `E`
    have hL : LipschitzOnWith (Real.toNNReal c₂) χ E := by
      apply LipschitzOnWith.of_dist_le_mul
      intro a ha b hb
      rw [dist_eq_norm, dist_eq_norm, Real.coe_toNNReal _ hc₂]
      exact (h a ha b hb).2
    have hle := hL.hausdorffMeasure_image_le (d := (n : ℝ)) (Nat.cast_nonneg n)
    rw [hvol, hscale, hscale E]
    have hK : ((Real.toNNReal c₂ : NNReal) : ℝ≥0∞) ^ (n : ℝ) = ENNReal.ofReal (c₂ ^ n) := by
      rw [ENNReal.rpow_natCast, ← ENNReal.ofReal_coe_nnreal, Real.coe_toNNReal _ hc₂,
        ← ENNReal.ofReal_pow hc₂]
    rw [hK] at hle
    calc _ ≤ (Measure.addHaarScalarFactor (volume : Measure (EuclideanSpace ℝ (Fin n))) μH[n] : ℝ≥0∞) *
          (ENNReal.ofReal (c₂ ^ n) * μH[(n : ℝ)] E) := by gcongr
      _ = _ := by ring

/-- **Density one on an embedded `C¹` submanifold** (the fact `Θⁿ(Hⁿ⌞M, z) = 1` behind
`Θⁿ(μ_T, z) = |m|` for `T = m[[M]]` near `z ∈ reg T`, Simon 7.4.1):
`Hⁿ(M ∩ B_s(z)) / (ωₙsⁿ) → 1` as `s ↓ 0`.  For `ε ∈ (0, 1)`, a `(1 ± ε)`-bi-Lipschitz chart `χ`
with `χ(0) = z` gives `χ(B_{s/(1+ε)}(0)) ⊆ M ∩ B_s(z) ⊆ χ(B_{s/(1−ε)}(0))` for small `s > 0`.  With
the bi-Lipschitz measure bounds (Simon Ch. 2, 1.8(i)) and `Lⁿ(B_r(0)) = ωₙrⁿ` this gives
`((1 − ε)/(1 + ε))ⁿ ≤ Hⁿ(M ∩ B_s(z)) / (ωₙsⁿ) ≤ ((1 + ε)/(1 − ε))ⁿ`, and both bounds tend to `1`
as `ε → 0`. -/
theorem Submission.dimred_rpd_submanifold_density_one : ∀ (P n : ℕ) (M : Set (Euclid P)) (z : Euclid P), IsEmbeddedSubmanifold 1 n M → z ∈ M → Tendsto (fun s : ℝ => μHE[n] (M ∩ ball z s) / (unitBallVolume n * ENNReal.ofReal (s ^ n))) (𝓝[>] 0) (𝓝 1) := by
  intro P n M z hM hz
  -- `ωₙ ∈ (0, ∞)`, and `Lⁿ(B_r(0)) = rⁿωₙ` for `r > 0`
  have hω0 : unitBallVolume n ≠ 0 := (measure_ball_pos volume (0 : Euclid n) one_pos).ne'
  have hωT : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
  have hvol : ∀ r : ℝ, 0 < r →
      volume (ball (0 : Euclid n) r) = ENNReal.ofReal (r ^ n) * unitBallVolume n := by
    intro r hr; rw [Measure.addHaar_ball_of_pos _ _ hr, finrank_euclideanSpace_fin]; rfl
  -- Step 1: for `ε ∈ (0, 1)`, `((1 − ε)/(1 + ε))ⁿ ≤ Hⁿ(M ∩ B_s(z)) / (ωₙsⁿ) ≤ ((1 + ε)/(1 − ε))ⁿ`
  -- for all small `s > 0`
  have hbounds : ∀ ε : ℝ, 0 < ε → ε < 1 → ∀ᶠ s in 𝓝[>] (0 : ℝ),
      ENNReal.ofReal (((1 - ε) / (1 + ε)) ^ n) ≤
          μHE[n] (M ∩ ball z s) / (unitBallVolume n * ENNReal.ofReal (s ^ n)) ∧
        μHE[n] (M ∩ ball z s) / (unitBallVolume n * ENNReal.ofReal (s ^ n)) ≤
          ENNReal.ofReal (((1 + ε) / (1 - ε)) ^ n) := by
    intro ε hε hε1
    -- the `(1 ± ε)`-bi-Lipschitz chart `χ : B_δ(0) → M` with `χ(0) = z`, onto `M` near `z`
    obtain ⟨χ, δ, δ', hδ, hδ', hχ0, hbil, hχM, hMχ⟩ :=
      Submission.dimred_rpd_near_isometric_chart P n M z hM hz ε hε
    have h1ε : 0 < 1 - ε := by linarith
    have h1ε' : 0 < 1 + ε := by linarith
    have hs₀ : 0 < min δ' ((1 - ε) * δ) := lt_min hδ' (mul_pos h1ε hδ)
    filter_upwards [Ioo_mem_nhdsGT hs₀] with s hs
    obtain ⟨hs0, hs1⟩ := hs
    have hsδ' : s < δ' := lt_of_lt_of_le hs1 (min_le_left _ _)
    have hsδ : s < (1 - ε) * δ := lt_of_lt_of_le hs1 (min_le_right _ _)
    -- `0 < r₁ = s/(1 + ε) ≤ r₂ = s/(1 − ε) < δ`
    set r₁ := s / (1 + ε) with hr₁def
    set r₂ := s / (1 - ε) with hr₂def
    have hr₁ : 0 < r₁ := div_pos hs0 h1ε'
    have hr₂ : 0 < r₂ := div_pos hs0 h1ε
    have hr₂δ : r₂ < δ := by rw [hr₂def, div_lt_iff₀ h1ε]; linarith
    have hr₁r₂ : r₁ ≤ r₂ := div_le_div_of_nonneg_left hs0.le h1ε (by linarith)
    have hb₁ : ball (0 : Euclid n) r₁ ⊆ ball 0 δ := ball_subset_ball (by linarith)
    have hb₂ : ball (0 : Euclid n) r₂ ⊆ ball 0 δ := ball_subset_ball hr₂δ.le
    -- (a) `χ(B_{r₁}(0)) ⊆ M ∩ B_s(z)`: `|χ(w) − z| ≤ (1 + ε)|w| < (1 + ε)r₁ = s`
    have hinc₁ : χ '' ball 0 r₁ ⊆ M ∩ ball z s := by
      rintro _ ⟨w, hw, rfl⟩
      refine ⟨hχM ⟨w, hb₁ hw, rfl⟩, ?_⟩
      rw [mem_ball, dist_eq_norm, ← hχ0]
      have h := (hbil w (hb₁ hw) 0 (mem_ball_self hδ)).2
      rw [sub_zero] at h
      rw [mem_ball, dist_zero_right] at hw
      calc ‖χ w - χ 0‖ ≤ (1 + ε) * ‖w‖ := h
        _ < (1 + ε) * r₁ := mul_lt_mul_of_pos_left hw h1ε'
        _ = s := by rw [hr₁def]; field_simp
    -- (b) `M ∩ B_s(z) ⊆ χ(B_{r₂}(0))`: `x = χ(w)` with `(1 − ε)|w| ≤ |x − z| < s`
    have hinc₂ : M ∩ ball z s ⊆ χ '' ball 0 r₂ := by
      rintro x ⟨hxM, hxs⟩
      obtain ⟨w, hw, rfl⟩ := hMχ ⟨hxM, ball_subset_ball hsδ'.le hxs⟩
      refine ⟨w, ?_, rfl⟩
      have h := (hbil w hw 0 (mem_ball_self hδ)).1
      rw [sub_zero] at h
      rw [mem_ball, dist_eq_norm, ← hχ0] at hxs
      rw [mem_ball, dist_zero_right, hr₂def, lt_div_iff₀ h1ε]
      nlinarith [norm_nonneg w]
    -- (c) the bi-Lipschitz measure bounds on `B_{r₁}(0), B_{r₂}(0) ⊆ B_δ(0)`
    have hlow := (Submission.dimred_rpd_bilipschitz_image_measure P n χ (ball 0 r₁) (1 - ε) (1 + ε)
      h1ε h1ε'.le (fun a ha b hb => hbil a (hb₁ ha) b (hb₁ hb))).1
    have hupp := (Submission.dimred_rpd_bilipschitz_image_measure P n χ (ball 0 r₂) (1 - ε) (1 + ε)
      h1ε h1ε'.le (fun a ha b hb => hbil a (hb₂ ha) b (hb₂ hb))).2
    rw [hvol r₁ hr₁] at hlow
    rw [hvol r₂ hr₂] at hupp
    have hm1 := hlow.trans (measure_mono hinc₁)
    have hm2 := (measure_mono hinc₂).trans hupp
    -- divide by `ωₙsⁿ ∈ (0, ∞)`
    have hden0 : unitBallVolume n * ENNReal.ofReal (s ^ n) ≠ 0 :=
      mul_ne_zero hω0 (ENNReal.ofReal_pos.2 (pow_pos hs0 n)).ne'
    have hdenT : unitBallVolume n * ENNReal.ofReal (s ^ n) ≠ ∞ :=
      ENNReal.mul_ne_top hωT ENNReal.ofReal_ne_top
    constructor
    · rw [ENNReal.le_div_iff_mul_le (Or.inl hden0) (Or.inl hdenT)]
      have e : ((1 - ε) / (1 + ε)) ^ n * s ^ n = (1 - ε) ^ n * r₁ ^ n := by
        rw [hr₁def, div_pow, div_pow]; field_simp
      calc ENNReal.ofReal (((1 - ε) / (1 + ε)) ^ n) * (unitBallVolume n * ENNReal.ofReal (s ^ n))
          = ENNReal.ofReal (((1 - ε) / (1 + ε)) ^ n * s ^ n) * unitBallVolume n := by
            rw [ENNReal.ofReal_mul (by positivity)]; ring
        _ = ENNReal.ofReal ((1 - ε) ^ n * r₁ ^ n) * unitBallVolume n := by rw [e]
        _ = ENNReal.ofReal ((1 - ε) ^ n) * (ENNReal.ofReal (r₁ ^ n) * unitBallVolume n) := by
            rw [ENNReal.ofReal_mul (by positivity)]; ring
        _ ≤ _ := hm1
    · rw [ENNReal.div_le_iff hden0 hdenT]
      have e : ((1 + ε) / (1 - ε)) ^ n * s ^ n = (1 + ε) ^ n * r₂ ^ n := by
        rw [hr₂def, div_pow, div_pow]; field_simp
      calc μHE[n] (M ∩ ball z s)
          ≤ ENNReal.ofReal ((1 + ε) ^ n) * (ENNReal.ofReal (r₂ ^ n) * unitBallVolume n) := hm2
        _ = ENNReal.ofReal ((1 + ε) ^ n * r₂ ^ n) * unitBallVolume n := by
            rw [ENNReal.ofReal_mul (by positivity)]; ring
        _ = ENNReal.ofReal (((1 + ε) / (1 - ε)) ^ n * s ^ n) * unitBallVolume n := by rw [e]
        _ = ENNReal.ofReal (((1 + ε) / (1 - ε)) ^ n) *
              (unitBallVolume n * ENNReal.ofReal (s ^ n)) := by
            rw [ENNReal.ofReal_mul (by positivity)]; ring
  -- Step 2: both bounds tend to `1` as `ε → 0`, so `Hⁿ(M ∩ B_s(z)) / (ωₙsⁿ) → 1` (`tendsto_order`)
  have hg₁ : Tendsto (fun ε : ℝ => ENNReal.ofReal (((1 - ε) / (1 + ε)) ^ n)) (𝓝 0) (𝓝 1) := by
    have h : Tendsto (fun ε : ℝ => ((1 - ε) / (1 + ε)) ^ n) (𝓝 0) (𝓝 (((1 - 0) / (1 + 0)) ^ n)) :=
      ((tendsto_const_nhds.sub tendsto_id).div (tendsto_const_nhds.add tendsto_id)
        (by norm_num)).pow n
    simpa using ENNReal.tendsto_ofReal h
  have hg₂ : Tendsto (fun ε : ℝ => ENNReal.ofReal (((1 + ε) / (1 - ε)) ^ n)) (𝓝 0) (𝓝 1) := by
    have h : Tendsto (fun ε : ℝ => ((1 + ε) / (1 - ε)) ^ n) (𝓝 0) (𝓝 (((1 + 0) / (1 - 0)) ^ n)) :=
      ((tendsto_const_nhds.add tendsto_id).div (tendsto_const_nhds.sub tendsto_id)
        (by norm_num)).pow n
    simpa using ENNReal.tendsto_ofReal h
  have hsmall : ∀ᶠ ε in 𝓝[>] (0 : ℝ), 0 < ε ∧ ε < 1 := by
    filter_upwards [self_mem_nhdsWithin,
      eventually_nhdsWithin_of_eventually_nhds (eventually_lt_nhds one_pos)] with ε h1 h2
    exact ⟨h1, h2⟩
  refine tendsto_order.2 ⟨fun a ha => ?_, fun b hb => ?_⟩
  · -- `a < 1`: choose `ε ∈ (0, 1)` with `a < ((1 − ε)/(1 + ε))ⁿ`
    obtain ⟨ε, hεa, hε0, hε1⟩ :=
      (((hg₁.mono_left nhdsWithin_le_nhds).eventually (lt_mem_nhds ha)).and hsmall).exists
    filter_upwards [hbounds ε hε0 hε1] with s hs
    exact lt_of_lt_of_le hεa hs.1
  · -- `1 < b`: choose `ε ∈ (0, 1)` with `((1 + ε)/(1 − ε))ⁿ < b`
    obtain ⟨ε, hεb, hε0, hε1⟩ :=
      (((hg₂.mono_left nhdsWithin_le_nhds).eventually (gt_mem_nhds hb)).and hsmall).exists
    filter_upwards [hbounds ε hε0 hε1] with s hs
    exact lt_of_le_of_lt hs.2 hεb
/-- **Simon Ch. 2, (3.1)** in integral form (area formula for an injective linear map): for an
injective linear `L : ℝⁿ → ℝᴾ` and every `f`, `∫_{L(ℝⁿ)} f dHⁿ = √det(L* ∘ L) ∫_{ℝⁿ} f(Lb) dLⁿ(b)`.
Write `L = W ∘ A` with `W` a linear isometry of `ℝⁿ` onto `L(ℝⁿ)` and `A` an automorphism of `ℝⁿ`;
then `Hⁿ⌞L(ℝⁿ) = W#Lⁿ`, `Lⁿ = |det A| A#Lⁿ` and `det(L* ∘ L) = det(A* ∘ A) = (det A)²`. -/
theorem Submission.codim1_rdo_c1pt_linear_range_integral : ∀ (P n : ℕ) (L : Euclid n →L[ℝ] Euclid P) (f : Euclid P → ℝ), Injective L → ∫ y in (LinearMap.range (L : Euclid n →ₗ[ℝ] Euclid P) : Set (Euclid P)), f y ∂μHE[n] = Real.sqrt ((L.adjoint ∘L L).det) * ∫ b, f (L b) := by
  intro P n L f hL
  -- `L = W ∘ A`: `W` is a linear isometry of `ℝⁿ` onto `R = L(ℝⁿ)` (via an orthonormal basis of
  -- `R`, which has dimension `n`) and `A` is a surjective endomorphism of `ℝⁿ`
  obtain ⟨W, A, hWA, hA⟩ : ∃ (W : Euclid n →ₗᵢ[ℝ] Euclid P) (A : Euclid n →L[ℝ] Euclid n),
      (∀ x, W (A x) = L x) ∧ Surjective A := by
    let R := LinearMap.range (L : Euclid n →ₗ[ℝ] Euclid P)
    have hrank : Module.finrank ℝ R = n :=
      (LinearMap.finrank_range_of_inj (f := (L : Euclid n →ₗ[ℝ] Euclid P)) hL).trans
        finrank_euclideanSpace_fin
    let bv : OrthonormalBasis (Fin n) ℝ R := (stdOrthonormalBasis ℝ R).reindex (finCongr hrank)
    refine ⟨R.subtypeₗᵢ.comp bv.repr.symm.toLinearIsometry,
      bv.repr.toContinuousLinearEquiv.toContinuousLinearMap ∘L
        L.codRestrict R (fun x => LinearMap.mem_range_self _ x), fun x => by simp, fun z => ?_⟩
    obtain ⟨x, hx⟩ := LinearMap.mem_range.mp (bv.repr.symm z).2
    refine ⟨x, ?_⟩
    have hx' : L.codRestrict R (fun x => LinearMap.mem_range_self _ x) x = bv.repr.symm z :=
      Subtype.ext hx
    simp [hx']
  have hAinj : Injective A := fun x y h => hL (by rw [← hWA x, ← hWA y, h])
  -- `L(ℝⁿ) = W(ℝⁿ)`
  have hrange : (LinearMap.range (L : Euclid n →ₗ[ℝ] Euclid P) : Set (Euclid P)) =
      Set.range W := by
    rw [LinearMap.coe_range, ContinuousLinearMap.coe_coe, ← hA.range_comp W]
    congr 1
    funext x
    exact (hWA x).symm
  -- `Hⁿ⌞W(ℝⁿ) = W#Hⁿ` (`W` is an isometry) and `Hⁿ = Lⁿ` on `ℝⁿ`
  have hW : ∫ y in Set.range W, f y ∂μHE[n] = ∫ x, f (W x) := by
    rw [← W.isometry.map_euclideanHausdorffMeasure,
      W.isometry.isClosedEmbedding.measurableEmbedding.integral_map,
      EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
  -- change of variables `x = A b` on `ℝⁿ`
  have hAcv : ∫ x, f (W x) = |A.det| * ∫ b, f (W (A b)) := by
    have h := integral_image_eq_integral_abs_det_fderiv_smul volume MeasurableSet.univ
      (fun x _ => A.hasFDerivAt.hasFDerivWithinAt) hAinj.injOn (fun x => f (W x))
    rw [Set.image_univ, hA.range_eq, Measure.restrict_univ] at h
    rw [h, ← integral_const_mul]
    simp only [smul_eq_mul]
  -- `L* ∘ L = A* ∘ W* ∘ W ∘ A = A* ∘ A`, so `det (L* ∘ L) = (det A)²`
  have hdet : (L.adjoint ∘L L).det = A.det ^ 2 := by
    have hL' : L = W.toContinuousLinearMap ∘L A := ContinuousLinearMap.ext fun x => (hWA x).symm
    have h1 : L.adjoint ∘L L = A.adjoint ∘L A := by
      rw [hL', ContinuousLinearMap.adjoint_comp, ← ContinuousLinearMap.comp_assoc,
        ContinuousLinearMap.comp_assoc (ContinuousLinearMap.adjoint _), W.adjoint_comp_self,
        ContinuousLinearMap.one_def, ContinuousLinearMap.comp_id]
    have hadj : LinearMap.det (LinearMap.adjoint (A : Euclid n →ₗ[ℝ] Euclid n)) =
        LinearMap.det (A : Euclid n →ₗ[ℝ] Euclid n) := by
      let b := EuclideanSpace.basisFun (Fin n) ℝ
      rw [← LinearMap.det_toMatrix b.toBasis, LinearMap.toMatrix_adjoint b b,
        Matrix.det_conjTranspose, LinearMap.det_toMatrix, star_trivial]
    rw [h1, ContinuousLinearMap.det, ContinuousLinearMap.det,
      ContinuousLinearMap.toLinearMap_comp, LinearMap.det_comp,
      ← ContinuousLinearMap.adjoint_toLinearMap, hadj, sq]
  rw [hrange, hW, hAcv, hdet, Real.sqrt_sq_eq_abs]
  simp only [hWA]
/-- Rescaled integrals over a `C¹` piece converge to the integral over its tangent map (proof of
Simon Ch. 3, Theorem 1.6, with a continuous weight `h`).  With `L = Dg(z)`,
`B_s = {b : z + s b ∈ B}` and `φ_s(b) = s⁻¹ (g(z + s b) − g(z))`:
`∫_{B_s} h(z + s b) f(φ_s(b)) db → h(z) ∫ f(L b) db` as `s ↓ 0`.  Take `f = 0` off `B_R(0)` and
`B̄_ρ(z) ⊆ B`.  For `0 < s < mρ/R`, `K = B̄_{R/m}(0) ⊆ B_s`, and the integrand vanishes on
`B_s \ K` because `|φ_s(b)| ≥ m|b| > R`.  On `K` it is bounded by `sup_{B̄_ρ(z)} |h| · sup |f|` and
tends pointwise to `h(z) f(L b)`, so dominated convergence applies.  Finally `f(L b) = 0` off `K`
because `|L b| ≥ m|b| > R`. -/
theorem Submission.codim1_rdo_c1pt_rescaled_integral_tendsto : ∀ (P n : ℕ) (g : Euclid n → Euclid P) (h : Euclid n → ℝ) (B : Set (Euclid n)) (z : Euclid n) (m : ℝ) (f : Euclid P → ℝ), Continuous g → DifferentiableAt ℝ g z → Continuous h → IsOpen B → z ∈ B → 0 < m → (∀ a ∈ B, m * ‖a - z‖ ≤ ‖g a - g z‖) → (∀ v : Euclid n, m * ‖v‖ ≤ ‖fderiv ℝ g z v‖) → Continuous f → HasCompactSupport f → Tendsto (fun s : ℝ => ∫ b in {b : Euclid n | z + s • b ∈ B}, h (z + s • b) * f (s⁻¹ • (g (z + s • b) - g z))) (𝓝[>] 0) (𝓝 (h z * ∫ b, f (fderiv ℝ g z b))) := by
  intro P n g h B z m f hg hgz hh hB hzB hm hgB hL hf hfs
  -- Step 1: `f = 0` off `closedBall 0 R`
  obtain ⟨R, hR, hRf⟩ : ∃ R : ℝ, 0 < R ∧ ∀ y, R < ‖y‖ → f y = 0 := by
    obtain ⟨R, hR, hsub⟩ := hfs.isCompact.isBounded.subset_closedBall_lt 0 0
    refine ⟨R, hR, fun y hy => ?_⟩
    by_contra hne
    have hy' := hsub (subset_tsupport f hne)
    rw [mem_closedBall, dist_zero_right] at hy'
    linarith
  -- Step 2: `closedBall z ρ ⊆ B`
  obtain ⟨ρ, hρ, hρB⟩ : ∃ ρ : ℝ, 0 < ρ ∧ closedBall z ρ ⊆ B := by
    obtain ⟨ε, hε, hεB⟩ := Metric.isOpen_iff.1 hB z hzB
    exact ⟨ε / 2, half_pos hε, (closedBall_subset_ball (half_lt_self hε)).trans hεB⟩
  -- Step 3: `K = closedBall 0 (R / m)`, `s₀ = m ρ / R`
  have hs₀ : 0 < m * ρ / R := div_pos (mul_pos hm hρ) hR
  have hKB : ∀ s : ℝ, 0 < s → s ≤ m * ρ / R → ∀ b ∈ closedBall (0 : Euclid n) (R / m),
      z + s • b ∈ closedBall z ρ := by
    intro s hs hss b hb
    rw [mem_closedBall, dist_zero_right] at hb
    rw [mem_closedBall, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hs.le]
    calc s * ‖b‖ ≤ m * ρ / R * (R / m) := mul_le_mul hss hb (norm_nonneg _) hs₀.le
      _ = ρ := by field_simp
  have hout : ∀ s : ℝ, 0 < s → ∀ b : Euclid n, z + s • b ∈ B →
      b ∉ closedBall (0 : Euclid n) (R / m) → f (s⁻¹ • (g (z + s • b) - g z)) = 0 := by
    intro s hs b hbB hbK
    apply hRf
    rw [mem_closedBall, dist_zero_right, not_le, div_lt_iff₀ hm] at hbK
    have h1 := hgB _ hbB
    rw [add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hs.le] at h1
    rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hs.le)]
    calc R < ‖b‖ * m := hbK
      _ = s⁻¹ * (m * (s * ‖b‖)) := by field_simp
      _ ≤ s⁻¹ * ‖g (z + s • b) - g z‖ := by gcongr
  -- Step 4: localisation to `K`
  have hloc : ∀ᶠ s in 𝓝[>] (0 : ℝ),
      (∫ b in closedBall (0 : Euclid n) (R / m), h (z + s • b) * f (s⁻¹ • (g (z + s • b) - g z))) =
        ∫ b in {b : Euclid n | z + s • b ∈ B}, h (z + s • b) * f (s⁻¹ • (g (z + s • b) - g z)) := by
    filter_upwards [Ioo_mem_nhdsGT hs₀] with s hs
    symm
    apply setIntegral_eq_of_subset_of_forall_sdiff_eq_zero
    · exact (hB.preimage (continuous_const.add (continuous_const_smul s))).measurableSet
    · intro b hb
      exact hρB (hKB s hs.1 hs.2.le b hb)
    · rintro b ⟨hbB, hbK⟩
      rw [hout s hs.1 b hbB hbK, mul_zero]
  -- Step 5: uniform bounds
  obtain ⟨Λ, hΛ⟩ := (isCompact_closedBall z ρ).exists_bound_of_continuousOn hh.continuousOn
  obtain ⟨C, hC⟩ := hf.bounded_above_of_compact_support hfs
  -- Steps 6–8: dominated convergence on `K`
  have hdom : Tendsto (fun s : ℝ => ∫ b in closedBall (0 : Euclid n) (R / m),
      h (z + s • b) * f (s⁻¹ • (g (z + s • b) - g z))) (𝓝[>] 0)
      (𝓝 (∫ b in closedBall (0 : Euclid n) (R / m), h z * f (fderiv ℝ g z b))) := by
    refine tendsto_integral_filter_of_dominated_convergence (fun _ => Λ * C) ?_ ?_ ?_ ?_
    · refine Eventually.of_forall fun s => Continuous.aestronglyMeasurable ?_
      have hz : Continuous fun b : Euclid n => z + s • b :=
        continuous_const.add (continuous_const_smul s)
      exact (hh.comp hz).mul (hf.comp (((hg.comp hz).sub continuous_const).const_smul s⁻¹))
    · filter_upwards [Ioo_mem_nhdsGT hs₀] with s hs
      filter_upwards [ae_restrict_mem measurableSet_closedBall] with b hb
      have hmem := hKB s hs.1 hs.2.le b hb
      rw [norm_mul]
      exact mul_le_mul (hΛ _ hmem) (hC _) (norm_nonneg _) ((norm_nonneg _).trans (hΛ _ hmem))
    · exact integrableOn_const measure_closedBall_lt_top.ne
    · refine Eventually.of_forall fun b => Tendsto.mul ?_ ?_
      · -- `h (z + s • b) → h z`
        have h1 : Tendsto (fun s : ℝ => z + s • b) (𝓝 0) (𝓝 (z + (0 : ℝ) • b)) :=
          (continuous_const.add (continuous_id.smul continuous_const)).tendsto 0
        rw [zero_smul, add_zero] at h1
        exact (hh.tendsto z).comp (h1.mono_left nhdsWithin_le_nhds)
      · -- difference quotients: `s⁻¹ • (g (z + s • b) - g z) → L b`
        have hc : Tendsto (fun s : ℝ => ‖s⁻¹‖) (𝓝[>] 0) atTop :=
          tendsto_norm_atTop_atTop.comp tendsto_inv_nhdsGT_zero
        have hlim := hgz.hasFDerivAt.lim b hc
        simp only [inv_inv] at hlim
        exact (hf.tendsto _).comp hlim
  -- Step 9: identification of the limit
  have hid : ∫ b in closedBall (0 : Euclid n) (R / m), h z * f (fderiv ℝ g z b) =
      h z * ∫ b, f (fderiv ℝ g z b) := by
    rw [setIntegral_eq_integral_of_forall_compl_eq_zero, integral_const_mul]
    intro b hb
    rw [mem_closedBall, dist_zero_right, not_le, div_lt_iff₀ hm] at hb
    rw [hRf _ (hb.trans_le ((mul_comm _ _).le.trans (hL b))), mul_zero]
  rw [← hid]
  exact hdom.congr' hloc

/-- **Approximate tangent space of a `C¹` piece** (Simon Ch. 3, 1.4; the step "since `x ∈ Nⱼ` and
`Nⱼ` is a `C¹` submanifold, `lim_{λ↓0} ∫_{η_{x,λ}(Nⱼ)} f dHⁿ = ∫_{TₓNⱼ} f dHⁿ`" of the proof of
1.6 "⇒", chapter-03.txt lines 113–125).  Let `g` be `C¹` with `m|a − b| ≤ |g(a) − g(b)|` on
`B = B_r(c)`, `m > 0`, and `z ∈ B`.  Then `|Dg(a)v| ≥ m|v|`, so `Dg(a)` is injective for `a ∈ B`,
`g` is injective on `B` and `T = Dg(z)(ℝⁿ)` has dimension `n`.  By the area formula (Ch. 2, 3.2,
3.3, 3.5), `∫_{η_{g(z),s}(g(B))} f dHⁿ = ∫_{B_s} J_g(z + sb) f(s⁻¹(g(z + sb) − g(z))) db` for
`s > 0`.  The Jacobian `J_g = √det(Dg* ∘ Dg)` is continuous, so these integrals tend to
`J_g(z) ∫ f(Dg(z)b) db`, which is `∫_T f dHⁿ` by the linear area formula (Ch. 2, 3.1). -/
theorem Submission.codim1_rdo_c1_piece_approxTangent : ∀ (P n : ℕ) (g : Euclid n → Euclid P) (c : Euclid n) (r m : ℝ), ContDiff ℝ 1 g → 0 < m → (∀ a ∈ ball c r, ∀ b ∈ ball c r, m * ‖a - b‖ ≤ ‖g a - g b‖) → ∀ z ∈ ball c r, HasApproximateTangentSpaceAt n (g '' ball c r) (g z) (LinearMap.range (fderiv ℝ g z : Euclid n →ₗ[ℝ] Euclid P)) := by
  intro P n g c r m hg hm hlip z hz
  have hdiff : Differentiable ℝ g := hg.differentiable one_ne_zero
  -- a vector `x` with `m|x| ≤ 0` vanishes, since `m > 0`
  have hzero : ∀ x : Euclid n, m * ‖x‖ ≤ 0 → x = 0 := fun x hx =>
    norm_le_zero_iff.1 (nonpos_of_mul_nonpos_right hx hm)
  -- Step 1, `m|v| ≤ |Dg(a)v|` for `a ∈ B`, so `Dg(a)` is injective; `g` is injective on `B`.
  have hlow : ∀ a ∈ ball c r, ∀ v : Euclid n, m * ‖v‖ ≤ ‖fderiv ℝ g a v‖ := fun a ha =>
    Submission.codim1_rdo_c1pt_fderiv_lower_bound P n g (ball c r) a m isOpen_ball ha (hdiff a)
      fun x hx => hlip x hx a ha
  have hinj : ∀ a ∈ ball c r, Injective (fderiv ℝ g a) := by
    intro a ha v w hvw
    have h := hlow a ha (v - w)
    rw [map_sub, hvw, sub_self, norm_zero] at h
    exact sub_eq_zero.1 (hzero _ h)
  have hinjOn : InjOn g (ball c r) := by
    intro a ha b hb hab
    have h := hlip a ha b hb
    rw [hab, sub_self, norm_zero] at h
    exact sub_eq_zero.1 (hzero _ h)
  -- Step 2, the Jacobian `J_g(a) = √det(Dg(a)* ∘ Dg(a))` is continuous.
  have hcont : Continuous (fderiv ℝ g) := hg.continuous_fderiv one_ne_zero
  have hJ : Continuous fun a => Real.sqrt (((fderiv ℝ g a).adjoint ∘L fderiv ℝ g a).det) :=
    Real.continuous_sqrt.comp (ContinuousLinearMap.continuous_det.comp
      ((ContinuousLinearMap.adjoint.continuous.comp hcont).clm_comp hcont))
  refine ⟨?_, fun f => ?_⟩
  · -- `dim T = n`
    rw [LinearMap.finrank_range_of_inj (f := (fderiv ℝ g z : Euclid n →ₗ[ℝ] Euclid P))
      (hinj z hz), finrank_euclideanSpace_fin]
  · -- Steps 3–8, `∫_T f dHⁿ = J_g(z) ∫ f(Dg(z)b) db` is the limit of the rescaled area formulas.
    rw [Submission.codim1_rdo_c1pt_linear_range_integral P n (fderiv ℝ g z) f (hinj z hz)]
    refine (Submission.codim1_rdo_c1pt_rescaled_integral_tendsto P n g
      (fun a => Real.sqrt (((fderiv ℝ g a).adjoint ∘L fderiv ℝ g a).det)) (ball c r) z m f
      hdiff.continuous (hdiff z) hJ isOpen_ball hz hm (fun a ha => hlip a ha z hz) (hlow z hz)
      f.continuous f.hasCompactSupport).congr' ?_
    filter_upwards [self_mem_nhdsWithin] with s hs
    exact (Submission.codim1_rdo_c1pt_rescaled_area_formula P n g (ball c r) z s f
      measurableSet_ball (fun a _ => hdiff a) hinjOn hinj hs).symm
/-- **Simon Ch. 3, proof of 1.6 "⇒"** (p. 71, "since `x ∈ Nⱼ` and `Nⱼ` is a `C¹` submanifold"):
if `ψ` is `C¹` on the open `V ⊆ ℝᵐ`, `v₀ ∈ V` and `Dψ(v₀)` is injective, then for some `ρ > 0`
with `B_ρ(v₀) ⊆ V`, `T = Dψ(v₀)(ℝᵐ)` is the approximate tangent space of `ψ(B_ρ(v₀))` at
`ψ(v₀)`.  A globally `C¹` map `g` equals `ψ` on some `B_{ρ₁}(v₀) ⊆ V`, so `g(v₀) = ψ(v₀)` and
`Dg(v₀) = Dψ(v₀)` (equal germs).  `Dg(v₀)` is injective, so `μ|a − b| ≤ |g(a) − g(b)|` on some
`B_δ(v₀)` (Ch. 3, Lemma 1.2), and the `C¹`-piece argument applies to `g` on `B_ρ(v₀)`,
`ρ = min(ρ₁, δ)`, where `g(B_ρ(v₀)) = ψ(B_ρ(v₀))`. -/
theorem Submission.codim1_ac_sat_chart_ball_approxTangent : ∀ (P m : ℕ) (V : Set (Euclid m)) (ψ : Euclid m → Euclid P) (v₀ : Euclid m), IsOpen V → ContDiffOn ℝ 1 ψ V → v₀ ∈ V → Injective (fderiv ℝ ψ v₀) → ∃ ρ : ℝ, 0 < ρ ∧ ball v₀ ρ ⊆ V ∧ HasApproximateTangentSpaceAt m (ψ '' ball v₀ ρ) (ψ v₀) (LinearMap.range (fderiv ℝ ψ v₀ : Euclid m →ₗ[ℝ] Euclid P)) := by
  intro P m V ψ v₀ hV hψ hv₀ hinj
  -- Step 1, a globally `C¹` map `g` with `g = ψ` on `B_{ρ₁}(v₀) ⊆ V`
  obtain ⟨g, ρ₁, hρ₁, hρ₁V, hg, hgψ⟩ :=
    Submission.codim1_ac_sat_c1_local_extension P m V ψ v₀ hV hψ hv₀
  -- Step 2, `g = ψ` near `v₀`, so `g(v₀) = ψ(v₀)` and `Dg(v₀) = Dψ(v₀)`
  have hv₀ρ₁ : v₀ ∈ ball v₀ ρ₁ := mem_ball_self hρ₁
  have hgv₀ : g v₀ = ψ v₀ := hgψ hv₀ρ₁
  have hDg : fderiv ℝ g v₀ = fderiv ℝ ψ v₀ :=
    (hgψ.eventuallyEq_of_mem (isOpen_ball.mem_nhds hv₀ρ₁)).fderiv_eq
  -- Step 3, `Dg(v₀)` is injective, so `μ|a − b| ≤ |g(a) − g(b)|` on `B_δ(v₀)`
  obtain ⟨δ, μ, hδ, hμ, hlip⟩ :=
    Submission.codim1_rdo_c1cov_local_lower_lipschitz P m g v₀ hg (by rwa [hDg])
  -- Step 4, `ρ = min(ρ₁, δ)`: `B_ρ(v₀) ⊆ B_{ρ₁}(v₀) ⊆ V` and `B_ρ(v₀) ⊆ B_δ(v₀)`
  have hρ : 0 < min ρ₁ δ := lt_min hρ₁ hδ
  have hρρ₁ : ball v₀ (min ρ₁ δ) ⊆ ball v₀ ρ₁ := ball_subset_ball (min_le_left ρ₁ δ)
  have hρδ : ball v₀ (min ρ₁ δ) ⊆ ball v₀ δ := ball_subset_ball (min_le_right ρ₁ δ)
  refine ⟨min ρ₁ δ, hρ, hρρ₁.trans hρ₁V, ?_⟩
  -- Step 5, the `C¹` piece `g(B_ρ(v₀))` has approximate tangent space `Dg(v₀)(ℝᵐ)` at `g(v₀)`
  have h := Submission.codim1_rdo_c1_piece_approxTangent P m g v₀ (min ρ₁ δ) μ hg hμ
    (fun a ha b hb => hlip a (hρδ ha) b (hρδ hb)) v₀ (mem_ball_self hρ)
  -- Step 6, `g(B_ρ(v₀)) = ψ(B_ρ(v₀))`, `g(v₀) = ψ(v₀)` and `Dg(v₀) = Dψ(v₀)`
  rwa [(hgψ.mono hρρ₁).image_eq, hgv₀, hDg] at h
/-- **Chart localization** (Simon Ch. 2, §4, (4.1)–(4.2)).  Let `ψ` be continuous, 1:1 and proper
on `V` with `ψ(V) = W₀ ∩ N`, `W₀` open, and let `v₀ ∈ V` with `x = ψ(v₀)` in the open set `W` and
`B_ρ(v₀) ⊆ V`.  Then `N ∩ W ∩ B_δ(x) = ψ(B_ρ(v₀)) ∩ B_δ(x)` for some `δ > 0`.  Take
`δ = min(δ₁, δ₂)`, where `δ₁` is the inverse-continuity radius of `ψ` at `v₀` for `ρ` and
`B_{δ₂}(x) ⊆ W ∩ W₀`.  A point `y ∈ N ∩ W ∩ B_δ(x)` lies in `W₀ ∩ N = ψ(V)`, so `y = ψ(v)` with
`v ∈ V`, and `|ψ(v) − x| < δ₁` gives `|v − v₀| < ρ`.  Conversely `ψ(B_ρ(v₀)) ⊆ ψ(V) ⊆ N` and
`B_δ(x) ⊆ W`. -/
theorem Submission.codim1_ac_sat_chart_localization : ∀ (P m : ℕ) (N W W₀ : Set (Euclid P)) (V : Set (Euclid m)) (ψ : Euclid m → Euclid P) (v₀ : Euclid m) (ρ : ℝ), IsOpen W → IsOpen W₀ → ContinuousOn ψ V → InjOn ψ V → ψ '' V = W₀ ∩ N → (∀ K ⊆ W₀, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → v₀ ∈ V → ψ v₀ ∈ W → 0 < ρ → ball v₀ ρ ⊆ V → ∃ δ : ℝ, 0 < δ ∧ N ∩ W ∩ ball (ψ v₀) δ = ψ '' ball v₀ ρ ∩ ball (ψ v₀) δ := by
  intro P m N W W₀ V ψ v₀ ρ hW hW₀ hψ hinj hψV hproper hv₀ hv₀W hρ hball
  -- `ψ(V) = W₀ ∩ N` lies in `W₀` and in `N`; in particular `ψ(v₀) ∈ W₀`
  have hVW₀ : ψ '' V ⊆ W₀ := hψV ▸ inter_subset_left
  have hVN : ψ '' V ⊆ N := hψV ▸ inter_subset_right
  have hxW₀ : ψ v₀ ∈ W₀ := hVW₀ (mem_image_of_mem ψ hv₀)
  -- inverse continuity at `v₀` for `ε = ρ`: `v ∈ V` and `|ψ(v) − ψ(v₀)| < δ₁` give `|v − v₀| < ρ`
  obtain ⟨δ₁, hδ₁, hδ₁V⟩ := Submission.dsmc_chart_inverse_continuity P m V W₀ ψ hψ hinj hVW₀
    hproper v₀ hv₀ ρ hρ
  -- `B_{δ₂}(ψ(v₀)) ⊆ W ∩ W₀`, hence `B_δ(ψ(v₀)) ⊆ W ∩ W₀` for `δ = min(δ₁, δ₂)`
  obtain ⟨δ₂, hδ₂, hδ₂W⟩ := Metric.isOpen_iff.1 (hW.inter hW₀) (ψ v₀) ⟨hv₀W, hxW₀⟩
  have hδW : ball (ψ v₀) (min δ₁ δ₂) ⊆ W ∩ W₀ :=
    (ball_subset_ball (min_le_right δ₁ δ₂)).trans hδ₂W
  refine ⟨min δ₁ δ₂, lt_min hδ₁ hδ₂, Subset.antisymm ?_ ?_⟩
  · -- `⊆`: `y ∈ W₀ ∩ N = ψ(V)`, so `y = ψ(v)` with `v ∈ V` and `|v − v₀| < ρ`
    rintro y ⟨⟨hyN, -⟩, hyδ⟩
    obtain ⟨v, hvV, rfl⟩ : y ∈ ψ '' V := hψV ▸ ⟨(hδW hyδ).2, hyN⟩
    exact ⟨⟨v, mem_ball.2 (hδ₁V v hvV ((mem_ball.1 hyδ).trans_le (min_le_left δ₁ δ₂))), rfl⟩,
      hyδ⟩
  · -- `⊇`: `ψ(B_ρ(v₀)) ⊆ ψ(V) ⊆ N` and `B_δ(ψ(v₀)) ⊆ W`
    rintro _ ⟨⟨v, hv, rfl⟩, hyδ⟩
    exact ⟨⟨hVN (mem_image_of_mem ψ (hball hv)), (hδW hyδ).1⟩, hyδ⟩
/-- **Simon Ch. 3, 1.4 (locality of approximate tangent spaces)**: if `S ∩ B_δ(x) = S' ∩ B_δ(x)`
for some `δ > 0` and `Q` is the approximate tangent space of `S'` at `x`, then `Q` is also the
approximate tangent space of `S` at `x`; no measurability of `S`, `S'` is needed.  For
`f ∈ C_c(ℝᴾ)` with `spt f ⊆ B_R(0)`, `∫_T f dHⁿ = ∫_{B_R(0) ∩ T} f dHⁿ` for every set `T`, and for
`0 < r < δ / R`, `B_R(0) ∩ η_{x,r}(T) = B_R(0) ∩ η_{x,r}(T ∩ B_δ(x))`; so the blown-up integrals
over `S` and `S'` agree for all small `r > 0` and have the same limit `∫_Q f dHⁿ`. -/
theorem Submission.codim1_ac_sat_approxTangent_of_local_eq : ∀ (P n : ℕ) (S S' : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)) (δ : ℝ), 0 < δ → S ∩ ball x δ = S' ∩ ball x δ → HasApproximateTangentSpaceAt n S' x Q → HasApproximateTangentSpaceAt n S x Q := by
  intro P n S S' x Q δ hδ hSS' hQ
  -- Step 1: the dimension conjunct `dim Q = n` does not involve the set
  refine ⟨hQ.1, fun f => ?_⟩
  -- Step 2: `spt f ⊆ B_R(0)` for some `R > 0`, so `f` vanishes off `B_R(0)`
  obtain ⟨R₀, hR₀⟩ := (isBounded_iff_subset_ball (0 : Euclid P)).1 f.hasCompactSupport.isBounded
  obtain ⟨R, hR, hf0⟩ : ∃ R : ℝ, 0 < R ∧ ∀ y, y ∉ ball (0 : Euclid P) R → f y = 0 :=
    ⟨max R₀ 1, lt_max_of_lt_right one_pos, fun y hy => image_eq_zero_of_notMem_tsupport
      fun h => hy (ball_subset_ball (le_max_left _ _) (hR₀ h))⟩
  -- Step 3: `∫_T f dHⁿ = ∫_{B_R(0) ∩ T} f dHⁿ` for every set `T`, as `B_R(0)` is Borel
  have hcut : ∀ T : Set (Euclid P),
      ∫ y in T, f y ∂μHE[n] = ∫ y in ball 0 R ∩ T, f y ∂μHE[n] := by
    intro T
    rw [← Measure.restrict_restrict measurableSet_ball]
    exact (setIntegral_eq_integral_of_forall_compl_eq_zero hf0).symm
  -- Step 6: it suffices that the blown-up integrals over `S'` and `S` agree for `0 < r < δ / R`
  refine (hQ.2 f).congr' ?_
  filter_upwards [Ioo_mem_nhdsGT (div_pos hδ hR)] with r hr
  -- Step 4: `B_R(0) ∩ η_{x,r}(T) = B_R(0) ∩ η_{x,r}(T ∩ B_δ(x))`, as `|t − x| = r |η_{x,r}(t)|`
  have hloc : ∀ T : Set (Euclid P),
      ball 0 R ∩ Poincare.SimonGMT.Chapter03.blowUpMap x r '' T =
        ball 0 R ∩ Poincare.SimonGMT.Chapter03.blowUpMap x r '' (T ∩ ball x δ) := by
    intro T
    refine Subset.antisymm ?_ (inter_subset_inter_right _ (image_mono inter_subset_left))
    rintro _ ⟨hy, t, ht, rfl⟩
    refine ⟨hy, t, ⟨ht, mem_ball.2 ?_⟩, rfl⟩
    have hy' : ‖r⁻¹ • (t - x)‖ < R := mem_ball_zero_iff.1 hy
    calc dist t x = ‖t - x‖ := dist_eq_norm t x
      _ = r * ‖r⁻¹ • (t - x)‖ := by
        rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hr.1.le), ← mul_assoc,
          mul_inv_cancel₀ hr.1.ne', one_mul]
      _ < r * R := mul_lt_mul_of_pos_left hy' hr.1
      _ < δ := (lt_div_iff₀ hR).1 hr.2
  -- Step 5: hence, by `S ∩ B_δ(x) = S' ∩ B_δ(x)`, the two blown-up integrals coincide
  rw [hcut (Poincare.SimonGMT.Chapter03.blowUpMap x r '' S'),
    hcut (Poincare.SimonGMT.Chapter03.blowUpMap x r '' S), hloc S', hloc S, hSS']
/-- **Simon Ch. 2, (3.2) and (3.5) on a chart (4.1)**: let `ψ : V → W` be a local representation
of `N` as in (4.1), `Q(x) = TₓN` on `N`, and `Φ : ℝᴾ → ℝᴾ` a 1:1 `C¹` map with `DΦ` injective;
write `J(x) = √det(⟨DΦ(x)τᵢ, DΦ(x)τⱼ⟩)`, `τ` the standard orthonormal basis of `Q(x)`.  Then
`∫_{Φ(B)} g dHᵐ = ∫_B J(x) g(Φ(x)) dHᵐ(x)` for Borel `B ⊆ W ∩ N` and every `g ≥ 0`.  With
`A = V ∩ ψ⁻¹(B)` (Borel, `ψ(A) = B`), the weighted parametric area formula for `Φ ∘ ψ` and for
`ψ` turns both sides into integrals over `A` against Lebesgue measure, and the integrands agree
on `A` because `J_{Φ∘ψ} = (J ∘ ψ) · J_ψ` there. -/
theorem Submission.codim1_ac_saf_chart_area_formula : ∀ (P m r : ℕ) (N W : Set (Euclid P)) (V : Set (Euclid m)) (ψ : Euclid m → Euclid P) (Q : Euclid P → Submodule ℝ (Euclid P)) (Φ : Euclid P → Euclid P), 1 ≤ r → IsOpen V → IsOpen W → ContDiffOn ℝ r ψ V → InjOn ψ V → ψ '' V = W ∩ N → (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → (∀ z ∈ V, Injective (fderiv ℝ ψ z)) → (∀ x ∈ N, (Q x : Set (Euclid P)) = tangentSpace N x) → ContDiff ℝ 1 Φ → Injective Φ → (∀ x, Injective (fderiv ℝ Φ x)) → ∀ B : Set (Euclid P), B ⊆ W ∩ N → MeasurableSet B → ∀ g : Euclid P → ℝ≥0∞, ∫⁻ y in Φ '' B, g y ∂μHE[m] = ∫⁻ x in B, ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ (Q x)) => inner ℝ (fderiv ℝ Φ x (stdOrthonormalBasis ℝ (Q x) i)) (fderiv ℝ Φ x (stdOrthonormalBasis ℝ (Q x) j))))) * g (Φ x) ∂μHE[m] := by
  intro P m r N W V ψ Q Φ hr hV hW hψ hinj hψV hprop hDψ hQ hΦ hΦinj hDΦ B hBWN hB g
  classical
  -- `ψ` is `C¹` on the open set `V`, hence differentiable on `V`; `Φ` is differentiable
  have hψ1 : ContDiffOn ℝ 1 ψ V := hψ.of_le (by exact_mod_cast hr)
  have hψd : ∀ v ∈ V, DifferentiableAt ℝ ψ v := fun v hv =>
    (hψ1.differentiableOn one_ne_zero v hv).differentiableAt (hV.mem_nhds hv)
  have hΦd : ∀ x, DifferentiableAt ℝ Φ x := fun x => hΦ.differentiable one_ne_zero x
  -- Step 1: the parameter set `A = V ∩ ψ⁻¹(B)` has `ψ(A) = B`
  set A : Set (Euclid m) := V ∩ ψ ⁻¹' B with hAdef
  have hAV : A ⊆ V := inter_subset_left
  have hAimg : ψ '' A = B := by
    apply Subset.antisymm
    · rintro _ ⟨v, hv, rfl⟩
      exact hv.2
    · intro b hb
      have : b ∈ ψ '' V := hψV ▸ hBWN hb
      obtain ⟨v, hv, rfl⟩ := this
      exact ⟨v, ⟨hv, hb⟩, rfl⟩
  -- `A` is Borel: on `V` it is the preimage of `B` under the Borel map `ψ` on `V`, `0` off `V`
  have hAmeas : MeasurableSet A := by
    have hm : Measurable (V.piecewise ψ (fun _ => (0 : Euclid P))) :=
      ContinuousOn.measurable_piecewise hψ1.continuousOn continuousOn_const hV.measurableSet
    have : A = V ∩ (V.piecewise ψ (fun _ => (0 : Euclid P))) ⁻¹' B := by
      ext v
      simp only [hAdef, mem_inter_iff, mem_preimage]
      constructor
      · rintro ⟨hv, hb⟩
        exact ⟨hv, by rw [Set.piecewise_eq_of_mem _ _ _ hv]; exact hb⟩
      · rintro ⟨hv, hb⟩
        exact ⟨hv, by rw [Set.piecewise_eq_of_mem _ _ _ hv] at hb; exact hb⟩
    rw [this]
    exact hV.measurableSet.inter (hm hB)
  -- Steps 2–3: the weighted area formula for `Φ ∘ ψ` on `A` (`D(Φ ∘ ψ) = DΦ ∘ Dψ` is injective)
  have h1 := (Submission.codim1_lura_gram_area_formula m P (Φ ∘ ψ)).2 A hAmeas
    (fun v hv => (hΦd (ψ v)).comp v (hψd v (hAV hv)))
    (fun v hv => by
      rw [fderiv_comp v (hΦd (ψ v)) (hψd v (hAV hv))]
      exact (hDΦ (ψ v)).comp (hDψ v (hAV hv)))
    (fun a ha b hb hab => hinj (hAV ha) (hAV hb) (hΦinj hab)) g
  -- Step 4: the weighted area formula for `ψ` on `A` with weight `J · (g ∘ Φ)`
  have h2 := (Submission.codim1_lura_gram_area_formula m P ψ).2 A hAmeas
    (fun v hv => hψd v (hAV hv)) (fun v hv => hDψ v (hAV hv)) (hinj.mono hAV)
    (fun x => ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ (Q x)) => inner ℝ (fderiv ℝ Φ x (stdOrthonormalBasis ℝ (Q x) i)) (fderiv ℝ Φ x (stdOrthonormalBasis ℝ (Q x) j))))) * g (Φ x))
  rw [image_comp, hAimg] at h1
  rw [hAimg] at h2
  rw [h1, h2]
  -- Steps 5–6: on `A`, `J_{Φ∘ψ} = (J ∘ ψ) · J_ψ`, so the two integrands over `A` agree
  apply setLIntegral_congr_fun hAmeas
  intro v hv
  have hfac := Submission.codim1_ac_saf_chart_gram_factor P m r N W V ψ Q Φ v hr hV hW hψ hinj hψV
    hprop hDψ hQ (hΦd (ψ v)) (hAV hv)
  simp only [Function.comp_apply]
  rw [hfac.2, ENNReal.ofReal_mul (Real.sqrt_nonneg _)]
  ring
/-- **Gluing a change of variables over a countable chart cover** (Simon Ch. 2, 4.11–4.13).  Let
`Φ : ℝᴾ → ℝᴾ` be continuous and injective, and let every `y ∈ N` have an open `W ∋ y` with
`∫_{Φ(B)} g dμ = ∫_B w · g ∘ Φ dμ` for all Borel `B ⊆ W ∩ N` and all `g ≥ 0`.  Then the same
holds for every Borel `B ⊆ N`.  By Lusin–Souslin, `Φ` maps Borel sets to Borel sets.  Countably
many `W_{y_k}` cover `N` (Lindelöf); the disjointed pieces `B_k ⊆ W_{y_k} ∩ N` of `B ∩ W_{y_k}`
are Borel with union `B`, and the `Φ(B_k)` are disjoint with union `Φ(B)`.  Both sides are
countably additive over disjoint Borel sets. -/
theorem Submission.codim1_ac_saf_lintegral_image_of_local : ∀ (P : ℕ) (μ : Measure (Euclid P)) (N : Set (Euclid P)) (Φ : Euclid P → Euclid P) (w : Euclid P → ℝ≥0∞), Continuous Φ → Injective Φ → (∀ y ∈ N, ∃ W : Set (Euclid P), IsOpen W ∧ y ∈ W ∧ ∀ B : Set (Euclid P), B ⊆ W ∩ N → MeasurableSet B → ∀ g : Euclid P → ℝ≥0∞, ∫⁻ z in Φ '' B, g z ∂μ = ∫⁻ x in B, w x * g (Φ x) ∂μ) → ∀ B : Set (Euclid P), B ⊆ N → MeasurableSet B → ∀ g : Euclid P → ℝ≥0∞, ∫⁻ z in Φ '' B, g z ∂μ = ∫⁻ x in B, w x * g (Φ x) ∂μ := by
  intro P μ N Φ w hΦc hΦinj hloc B hBN hB g
  classical
  -- Lusin–Souslin: `Φ` is continuous and injective on the Polish space `ℝᴾ`
  have hemb : MeasurableEmbedding Φ := hΦc.measurableEmbedding hΦinj
  -- `N = ∅` forces `B = ∅`, and both sides vanish
  rcases N.eq_empty_or_nonempty with hN0 | hNne
  · have hB0 : B = ∅ := subset_empty_iff.1 (hN0 ▸ hBN)
    subst hB0
    simp
  -- countably many of the neighbourhoods `W_y`, `y ∈ N`, cover `N` (Lindelöf)
  choose! Wf hWo hyW hform using hloc
  have : Nonempty N := hNne.to_subtype
  obtain ⟨j, hj⟩ := (HereditarilyLindelofSpace.isLindelof N).indexed_countable_subcover
    (fun y : N => Wf y) (fun y => hWo y y.2) (fun y hy => mem_iUnion.2 ⟨⟨y, hy⟩, hyW y hy⟩)
  -- disjoint Borel pieces `B_k ⊆ W_{y_k} ∩ N` of `B ∩ W_{y_k}` with union `B`
  set S : ℕ → Set (Euclid P) := fun k => B ∩ Wf (j k)
  set D : ℕ → Set (Euclid P) := disjointed S with hDdef
  have hDm : ∀ k, MeasurableSet (D k) :=
    MeasurableSet.disjointed (fun k => hB.inter (hWo _ (j k).2).measurableSet)
  have hDdisj : Pairwise (Disjoint on D) := disjoint_disjointed S
  have hDU : ⋃ k, D k = B := by
    rw [hDdef, iUnion_disjointed]
    apply Subset.antisymm
    · exact iUnion_subset fun k => inter_subset_left
    · intro x hx
      obtain ⟨k, hk⟩ := mem_iUnion.1 (hj (hBN hx))
      exact mem_iUnion.2 ⟨k, hx, hk⟩
  have hDsub : ∀ k, D k ⊆ Wf (j k) ∩ N := fun k x hx =>
    ⟨(disjointed_subset S k hx).2, hBN (disjointed_subset S k hx).1⟩
  -- `Φ` is injective, so the Borel images `Φ(B_k)` are disjoint
  have hImDisj : Pairwise (Disjoint on fun k => Φ '' D k) := fun a b hab =>
    (hDdisj hab).image hΦinj.injOn (subset_univ _) (subset_univ _)
  -- countable additivity on both sides, and the local formula on each piece
  calc ∫⁻ z in Φ '' B, g z ∂μ = ∫⁻ z in ⋃ k, Φ '' D k, g z ∂μ := by rw [← image_iUnion, hDU]
    _ = ∑' k, ∫⁻ z in Φ '' D k, g z ∂μ :=
        lintegral_iUnion (fun k => hemb.measurableSet_image.2 (hDm k)) hImDisj g
    _ = ∑' k, ∫⁻ x in D k, w x * g (Φ x) ∂μ := by
        congr 1; funext k; exact hform (j k) (j k).2 (D k) (hDsub k) (hDm k) g
    _ = ∫⁻ x in ⋃ k, D k, w x * g (Φ x) ∂μ := (lintegral_iUnion hDm hDdisj _).symm
    _ = ∫⁻ x in B, w x * g (Φ x) ∂μ := by rw [hDU]

/-- **Continuity of the tangential Jacobian on a `C¹` submanifold** (Simon Ch. 2, (4.1)–(4.2) and
4.11–4.12).  Let `N ⊆ ℝᴾ` be an embedded `m`-dimensional `C¹` submanifold, `Q(x) = TₓN` for
`x ∈ N`, and `Φ : ℝᴾ → ℝᴾ` a `C¹` map; write `J(x) = √det(⟨DΦ(x)τᵢ, DΦ(x)τⱼ⟩)`, `τ` the standard
orthonormal basis of `Q(x)`.  Then `J` is continuous on `N`.  Near `y = ψ(v₀) ∈ N` take a chart
`ψ : V → W` as in (4.1) and put `γ(T) = √det(⟨Teₖ, Teₗ⟩)`, a continuous function of `T`.  By the
chart Gram factorization, `γ(Dψ) > 0` and `J ∘ ψ = γ(D(Φ ∘ ψ)) / γ(Dψ)` on `V`, which is
continuous because `Dψ` and `D(Φ ∘ ψ)` are continuous on the open set `V`.  Since `ψ⁻¹` is
continuous at `y` on `ψ(V) = W ∩ N` and `W` is open, `J` is continuous at `y` within `N`. -/
theorem Submission.codim1_ac_saf_jacobian_continuousOn : ∀ (P m : ℕ) (N : Set (Euclid P)) (Q : Euclid P → Submodule ℝ (Euclid P)) (Φ : Euclid P → Euclid P), IsEmbeddedSubmanifold 1 m N → (∀ x ∈ N, (Q x : Set (Euclid P)) = tangentSpace N x) → ContDiff ℝ 1 Φ → ContinuousOn (fun x => Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ (Q x)) => inner ℝ (fderiv ℝ Φ x (stdOrthonormalBasis ℝ (Q x) i)) (fderiv ℝ Φ x (stdOrthonormalBasis ℝ (Q x) j))))) N := by
  intro P m N Q Φ hN hQ hΦ y hy
  -- Step 1: a chart `ψ : V → W` of `N` as in (4.1), with `y = ψ(v₀)`
  obtain ⟨V, W, ψ, hV, hW, hyW, hψ, hinj, hψV, hproper, hDψ⟩ := hN y hy
  have hψ1 : ContDiffOn ℝ 1 ψ V := by exact_mod_cast hψ
  obtain ⟨v₀, hv₀, rfl⟩ : y ∈ ψ '' V := hψV ▸ ⟨hyW, hy⟩
  -- Step 2: `γ(T) = √det(⟨Teₖ, Teₗ⟩)` is continuous in `T`
  set γ : (Euclid m →L[ℝ] Euclid P) → ℝ := fun T => Real.sqrt (Matrix.det (Matrix.of
    fun k l : Fin m => inner ℝ (T (EuclideanSpace.single k 1)) (T (EuclideanSpace.single l 1))))
  have hγ : Continuous γ := by
    refine Continuous.sqrt (Continuous.matrix_det ?_)
    refine continuous_pi fun k => continuous_pi fun l => ?_
    exact (continuous_id.clm_apply continuous_const).inner
      (continuous_id.clm_apply continuous_const)
  -- Step 3: `Dψ` and `D(Φ ∘ ψ)` are continuous on the open set `V`
  have hDψc : ContinuousOn (fderiv ℝ ψ) V := hψ1.continuousOn_fderiv_of_isOpen hV le_rfl
  have hDΦψc : ContinuousOn (fderiv ℝ (Φ ∘ ψ)) V :=
    (hΦ.comp_contDiffOn hψ1).continuousOn_fderiv_of_isOpen hV le_rfl
  -- Step 4: chart Gram factorization, `γ(Dψ(v)) > 0` and `γ(D(Φ ∘ ψ)(v)) = J(ψ(v)) γ(Dψ(v))`
  have hfac : ∀ v ∈ V, 0 < γ (fderiv ℝ ψ v) ∧ γ (fderiv ℝ (Φ ∘ ψ) v) =
      Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ (Q (ψ v))) =>
        inner ℝ (fderiv ℝ Φ (ψ v) (stdOrthonormalBasis ℝ (Q (ψ v)) i))
          (fderiv ℝ Φ (ψ v) (stdOrthonormalBasis ℝ (Q (ψ v)) j)))) * γ (fderiv ℝ ψ v) := by
    intro v hv
    obtain ⟨hpos, hmul⟩ := Submission.codim1_ac_saf_chart_gram_factor P m 1 N W V ψ Q Φ v le_rfl
      hV hW hψ hinj hψV hproper hDψ hQ (hΦ.differentiable one_ne_zero (ψ v)) hv
    exact ⟨Real.sqrt_pos.2 hpos, hmul⟩
  -- hence `J ∘ ψ = γ(D(Φ ∘ ψ)) / γ(Dψ)` on `V`
  have hJ : ∀ v ∈ V, Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ (Q (ψ v))) =>
      inner ℝ (fderiv ℝ Φ (ψ v) (stdOrthonormalBasis ℝ (Q (ψ v)) i))
        (fderiv ℝ Φ (ψ v) (stdOrthonormalBasis ℝ (Q (ψ v)) j)))) =
      γ (fderiv ℝ (Φ ∘ ψ) v) / γ (fderiv ℝ ψ v) := by
    intro v hv
    rw [(hfac v hv).2, mul_div_cancel_right₀ _ (hfac v hv).1.ne']
  -- Step 5: `γ(D(Φ ∘ ψ)) / γ(Dψ)` is continuous on `V`
  have hGc : ContinuousOn (fun v => γ (fderiv ℝ (Φ ∘ ψ) v) / γ (fderiv ℝ ψ v)) V :=
    (hγ.comp_continuousOn hDΦψc).div (hγ.comp_continuousOn hDψc) fun v hv => (hfac v hv).1.ne'
  -- Steps 6–7: `ψ⁻¹` is continuous at `ψ(v₀)` on `ψ(V) = W ∩ N`, and `W` is open
  rw [Metric.continuousWithinAt_iff]
  intro ε hε
  obtain ⟨δ₁, hδ₁, hG⟩ := Metric.continuousWithinAt_iff.1 (hGc v₀ hv₀) ε hε
  have hVW : ψ '' V ⊆ W := hψV ▸ inter_subset_left
  obtain ⟨δ₂, hδ₂, hinv⟩ := Submission.dsmc_chart_inverse_continuity P m V W ψ hψ1.continuousOn
    hinj hVW hproper v₀ hv₀ δ₁ hδ₁
  obtain ⟨δ₃, hδ₃, hball⟩ := Metric.isOpen_iff.1 hW (ψ v₀) hyW
  refine ⟨min δ₂ δ₃, lt_min hδ₂ hδ₃, ?_⟩
  intro y' hy' hy'd
  -- `y' = ψ(v')` with `v' ∈ V` and `|v' − v₀| < δ₁`, so `|J(y') − J(ψ(v₀))| < ε`
  obtain ⟨v', hv', rfl⟩ : y' ∈ ψ '' V :=
    hψV ▸ ⟨hball (mem_ball.2 (hy'd.trans_le (min_le_right _ _))), hy'⟩
  rw [hJ v' hv', hJ v₀ hv₀]
  exact hG hv' (hinv v' hv' (hy'd.trans_le (min_le_left _ _)))
/-- **Simon Ch. 6, 3.1 (‡), 3.2(3)**: for `R = (M, θ, ξ)` and `ω ∈ 𝒟ⁿ(U)`, the function
`x ↦ ⟨ω(x), ξ(x)⟩` is `μ_R`-integrable and `τ(M, θ, ξ)(ω) = ∫ ⟨ω, ξ⟩ dμ_R`, `μ_R = θ Hⁿ⌞M`.
`μ_R`-a.e. `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ` with `τ` orthonormal, so `|⟨ω(x), ξ(x)⟩| ≤ ‖ω(x)‖`; this is
bounded and vanishes off the compact `spt ω ⊆ U`, which has finite `μ_R`-measure. -/
theorem Submission.dor_ims_action_eq_integral : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (ω : TestFormOn U n), Integrable (fun x => R.orient x ((ω : DifferentialForm (Euclid P) n) x)) R.measure ∧ R.action (ω : DifferentialForm (Euclid P) n) = ∫ x, R.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂R.measure := by
  intro P n U R ω
  obtain ⟨⟨hsmooth, hcpt⟩, hU⟩ := ω.2
  set f : DifferentialForm (Euclid P) n := (ω : DifferentialForm (Euclid P) n)
  have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) := measurable_from_nat.comp R.measurable_mult
  have hac : R.measure ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
  -- `x ↦ ξ(x)(ω(x))` is `μ_R`-a.e. strongly measurable
  have hmeas : AEStronglyMeasurable (fun x => R.orient x (f x)) R.measure :=
    isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable₂
      (R.aestronglyMeasurable_orient.mono_ac hac) hsmooth.continuous.aestronglyMeasurable
  -- `|ξ(x)(ω(x))| ≤ C 1_K(x)`, `K = spt ω`
  obtain ⟨C, hC⟩ := hsmooth.continuous.bounded_above_of_compact_support hcpt
  have hKm : MeasurableSet (tsupport f) := (isClosed_tsupport f).measurableSet
  have hbound : ∀ᵐ x ∂R.measure, ‖R.orient x (f x)‖ ≤ (tsupport f).indicator (fun _ => C) x := by
    filter_upwards [hac.ae_le R.orients] with x hx
    obtain ⟨Q, -, τ, hτ, -, hξ⟩ := hx
    by_cases hxK : x ∈ tsupport f
    · rw [Set.indicator_of_mem hxK]
      have hτ1 : ‖f x τ‖ ≤ ‖f x‖ := by
        simpa [hτ.norm_eq_one] using (f x).le_opNorm τ
      rcases hξ with h | h
      · rw [h]
        exact hτ1.trans (hC x)
      · rw [h, norm_neg]
        exact hτ1.trans (hC x)
    · rw [Set.indicator_of_notMem hxK, image_eq_zero_of_notMem_tsupport hxK, map_zero, norm_zero]
  -- `μ_R(K) = ∫_{M ∩ K} θ dHⁿ < ∞`
  have hKfin : R.measure (tsupport f) ≠ ∞ := by
    rw [IMRep.measure, withDensity_apply _ hKm, Measure.restrict_restrict hKm,
      Set.inter_comm (tsupport f) R.carrier]
    exact R.locallyIntegrable_mult _ hcpt hU
  have hint : Integrable (fun x => R.orient x (f x)) R.measure :=
    ((integrable_indicator_iff hKm).2 (integrableOn_const hKfin)).mono' hmeas hbound
  refine ⟨hint, ?_⟩
  -- `∫ g d(θ Hⁿ⌞M) = ∫_M θ g dHⁿ`
  rw [IMRep.measure, integral_withDensity_eq_integral_toReal_smul hθ
    (ae_of_all _ fun x => ENNReal.natCast_lt_top _), IMRep.action]
  simp only [ENNReal.toReal_natCast, smul_eq_mul]

/-- **Simon Ch. 6, 3.2(3), upper bound**: if `T = τ(M, θ, ξ)` then `M_W(T) ≤ μ_T(W)` for every
`W`.  For admissible `ω`, `⟨ω, ξ⟩ ≤ |ω| ≤ 1` `μ_T`-a.e. (`|ξ(α)| ≤ |α|` for unit orientations)
and `⟨ω, ξ⟩ = 0` off `spt ω`, so `T(ω) = ∫ ⟨ω, ξ⟩ dμ_T ≤ μ_T(spt ω) ≤ μ_T(W)`. -/
theorem Submission.dor_ims_massOn_le_measure : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), R.Represents T → ∀ W : Set (Euclid P), T.massOn W ≤ R.measure W := by
  intro P n U T R hR W
  obtain ⟨L, hL⟩ := Submission.dor_ims_unitOrientation_dual P n
  -- `|ξ(x)(α)| ≤ |α|` for `μ_T`-a.e. `x`: `ξ(x)` is a unit orientation `Hⁿ⌞M`-a.e., and
  -- `μ_T = θ Hⁿ⌞M ≪ Hⁿ⌞M`
  have hdual : ∀ᵐ x ∂R.measure, ∀ α : Covector (Euclid P) n,
      |R.orient x α| ≤ covectorEuclideanNorm α := by
    have hac : R.measure ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
    refine hac.ae_le ?_
    filter_upwards [R.orients] with x hx
    obtain ⟨Q, -, hQ⟩ := hx
    exact (hL _ Q hQ).1
  apply sSup_le
  rintro r ⟨ω, ⟨hωW, hω1⟩, rfl⟩
  -- `K = spt ω` is a compact subset of `U`, so `μ_T(K) = ∫_{M ∩ K} θ dHⁿ < ∞`
  set K := tsupport (ω : DifferentialForm (Euclid P) n)
  have hKm : MeasurableSet K := (isClosed_tsupport _).measurableSet
  have hμK : R.measure K ≠ ∞ := by
    rw [IMRep.measure, withDensity_apply _ hKm, Measure.restrict_restrict hKm, inter_comm]
    exact R.locallyIntegrable_mult K ω.2.1.2.isCompact ω.2.2
  obtain ⟨hint, haction⟩ := Submission.dor_ims_action_eq_integral P n U R ω
  -- `⟨ω, ξ⟩ ≤ 1_K` `μ_T`-a.e.: `⟨ω(x), ξ(x)⟩ ≤ |ω(x)| ≤ 1` on `K` and `ω = 0` off `K`
  have hle : (fun x => R.orient x ((ω : DifferentialForm (Euclid P) n) x)) ≤ᵐ[R.measure]
      K.indicator fun _ => (1 : ℝ) := by
    filter_upwards [hdual] with x hx
    by_cases hxK : x ∈ K
    · rw [indicator_of_mem hxK]
      exact (le_abs_self _).trans ((hx _).trans (hω1 x))
    · rw [indicator_of_notMem hxK, image_eq_zero_of_notMem_tsupport hxK, map_zero]
  calc ENNReal.ofReal (T ω)
      = ENNReal.ofReal (∫ x, R.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂R.measure) := by
        rw [hR ω, haction]
    _ ≤ ENNReal.ofReal (∫ x, K.indicator (fun _ => (1 : ℝ)) x ∂R.measure) :=
        ENNReal.ofReal_le_ofReal (integral_mono_ae hint
          ((integrableOn_const hμK).integrable_indicator hKm) hle)
    _ = R.measure K := by
        rw [integral_indicator_const _ hKm, smul_eq_mul, mul_one, measureReal_def,
          ENNReal.ofReal_toReal hμK]
    _ ≤ R.measure W := measure_mono hωW

/-- **Simon 6.2.2, 6.3.1, 6.3.2(3) with `θ ≡ 1`**: a Borel, countably `m`-rectifiable `M ⊆ ℝᴾ`
with `Hᵐ(M ∩ K) < ∞` for compact `K`, oriented `Hᵐ`-a.e. by a unit orientation `η` of its
approximate tangent space, defines the integer multiplicity current `D = [[M]] = τ(M, 1, η)`:
`⟨ω, η⟩` is `Hᵐ⌞M`-integrable, `D(ω) = ∫_M ⟨ω, η⟩ dHᵐ`, and `M_W(D) ≤ μ_{τ(M,1,η)}(W) =
Hᵐ(M ∩ W)` for every `W`. -/
theorem Submission.codim1_ac_pp_unit_rectifiable_current : ∀ (P m : ℕ) (M : Set (Euclid P)) (η : Euclid P → MultiVector P m), MeasurableSet M → CountablyRectifiable m M → (∀ K : Set (Euclid P), IsCompact K → μHE[m] (M ∩ K) ≠ ∞) → AEStronglyMeasurable η (μHE[m].restrict M) → (∀ᵐ y ∂(μHE[m].restrict M), ∃ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt m M y Q ∧ IsUnitOrientationOf (η y) Q) → ∃ D : GeometricCurrentOn (univ : Set (Euclid P)) m, IsIntegerMultiplicity D ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) m, Integrable (fun y => η y ((ω : DifferentialForm (Euclid P) m) y)) (μHE[m].restrict M) ∧ D ω = ∫ y in M, η y ((ω : DifferentialForm (Euclid P) m) y) ∂μHE[m]) ∧ ∀ W' : Set (Euclid P), D.massOn W' ≤ μHE[m] (M ∩ W') := by
  intro P m M η hM hrect hfin hη horient
  -- the multiplicity-one triple `R = (M, 1, η)` in `ℝᴾ`; `∫_{M ∩ K} 1 dHᵐ = Hᵐ(M ∩ K) < ∞`
  let R : IMRep (univ : Set (Euclid P)) m :=
    { carrier := M
      mult := fun _ => 1
      orient := η
      measurableSet_carrier := hM
      carrier_subset := subset_univ M
      rectifiable := hrect
      measurable_mult := measurable_const
      mult_pos := fun _ _ => Nat.one_pos
      locallyIntegrable_mult := fun K hK _ => by
        simp only [Nat.cast_one, setLIntegral_const, one_mul]
        exact hfin K hK
      aestronglyMeasurable_orient := hη
      orients := horient }
  -- `D = τ(M, 1, η)` is an integer multiplicity current
  obtain ⟨D, hD⟩ := Submission.dtc_imrep_current P m univ R
  refine ⟨D, ⟨R, hD⟩, fun ω => ?_, fun W' => ?_⟩
  · -- `1 · ⟨ω, η⟩` is `Hᵐ⌞M`-integrable and `D(ω) = ∫_M 1 · ⟨ω, η⟩ dHᵐ`
    have hi := Submission.regcomp_rim_action_integrable P m univ R ω
    simp only [R, Nat.cast_one, one_mul] at hi
    refine ⟨hi, ?_⟩
    rw [hD ω]
    simp only [IMRep.action, R, Nat.cast_one, one_mul]
  · -- `M_W(D) ≤ μ_R(W)`, and `μ_R = 1 · Hᵐ⌞M`, so `μ_R(W) = Hᵐ(W ∩ M)` (`M` Borel)
    have hm := Submission.dor_ims_massOn_le_measure P m univ D R hD W'
    have hmeas : R.measure = μHE[m].restrict M := by
      simp only [IMRep.measure, R, Nat.cast_one]
      exact withDensity_one
    rw [hmeas, Measure.restrict_apply' hM, inter_comm] at hm
    exact hm

/-- **Simon Ch. 3, Lemma 1.2 ("if" part)**: an embedded `C¹` `m`-submanifold `N ⊆ ℝᴾ` is Borel
and countably `m`-rectifiable.  By Lindelöf countably many charts `ψⱼ(Vⱼ) = Wⱼ ∩ N` cover `N`.
Each open `Vⱼ ⊆ ℝᵐ` is σ-compact, so `ψⱼ(Vⱼ)` is σ-compact, hence Borel; and `ψⱼ` is Lipschitz
on each compact piece of `Vⱼ`, so extends to a Lipschitz map `ℝᵐ → ℝᴾ` (Ch. 2, 1.2).  This is
the argument of SimonGMT's `measurableSet_of_isSimonSubmanifold` and
`countablyRectifiable_of_isSimonSubmanifold`. -/
theorem Submission.codim1_ac_pp_embedded_measurable_rectifiable : ∀ (P m : ℕ) (N : Set (Euclid P)), IsEmbeddedSubmanifold 1 m N → MeasurableSet N ∧ CountablyRectifiable m N := by
  intro P m N hN
  rcases N.eq_empty_or_nonempty with rfl | hne
  · exact ⟨MeasurableSet.empty,
      Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty⟩
  have : Nonempty N := hne.to_subtype
  -- a chart `ψ_y : V_y → W_y` with `ψ_y(V_y) = W_y ∩ N` at each `y ∈ N`
  choose V W ψ hV hW hyW hψ _ himg _ _ using fun y : N => hN y y.2
  -- Lindelöf: countably many `W_{c j}` cover `N`, so `N = ⋃ⱼ ψ_{c j}(V_{c j})`
  obtain ⟨c, hc⟩ := (HereditarilyLindelofSpace.isLindelof N).indexed_countable_subcover W hW
    fun y hy => mem_iUnion_of_mem ⟨y, hy⟩ (hyW ⟨y, hy⟩)
  have hNeq : N = ⋃ j, ψ (c j) '' V (c j) := by
    refine Subset.antisymm (fun y hy => ?_)
      (iUnion_subset fun j => (himg (c j)).trans_subset inter_subset_right)
    obtain ⟨j, hyj⟩ := mem_iUnion.mp (hc hy)
    exact mem_iUnion_of_mem j ((himg (c j)).symm ▸ ⟨hyj, hy⟩)
  -- each chart domain is σ-compact (open in `ℝᵐ`): `V = ⋃ₖ Kₖ` with `Kₖ` compact
  have hσ : ∀ y : N, IsSigmaCompact (V y) := fun y => by
    have : LocallyCompactSpace (V y) := (hV y).locallyCompactSpace
    exact isSigmaCompact_iff_sigmaCompactSpace.mpr inferInstance
  rw [hNeq]
  refine ⟨MeasurableSet.iUnion fun j => ?_,
    Poincare.SimonGMT.Chapter03.countablyRectifiable_iUnion _ fun j => ?_⟩
  · -- Borel: `ψ(V)` is σ-compact, a countable union of compact sets
    obtain ⟨K, hK, hKeq⟩ := (hσ (c j)).image_of_continuousOn (hψ (c j)).continuousOn
    rw [← hKeq]
    exact MeasurableSet.iUnion fun k => (hK k).measurableSet
  · -- rectifiable: the `C¹` map `ψ` is Lipschitz on each compact `Kₖ ⊆ V`; extend it to `ℝᵐ`
    obtain ⟨K, hK, hKeq⟩ := hσ (c j)
    have hLip : ∀ k, ∃ L, LipschitzOnWith L (ψ (c j)) (K k) := fun k =>
      LocallyLipschitzOn.exists_lipschitzOnWith_of_compact (hK k) fun x hx => by
        obtain ⟨L, t, ht, hLt⟩ := ((hψ (c j)).contDiffAt
          ((hV (c j)).mem_nhds (hKeq ▸ mem_iUnion_of_mem k hx))).exists_lipschitzOnWith
        exact ⟨L, t, mem_nhdsWithin_of_mem_nhds ht, hLt⟩
    choose L hL using hLip
    choose g hg hgeq using fun k => (hL k).extend_finite_dimension
    refine (Poincare.SimonGMT.Chapter03.countablyRectifiable_iUnion _ fun k =>
      Poincare.SimonGMT.Chapter03.countablyRectifiable_range (hg k)).mono ?_
    rintro _ ⟨x, hx, rfl⟩
    obtain ⟨k, hxk⟩ := mem_iUnion.mp (hKeq.symm ▸ hx)
    exact mem_iUnion_of_mem k ⟨x, (hgeq k hxk).symm⟩
/-- **Signed area transfer** (Simon Ch. 2, 3.5 and 4.13, stated there for `h ≥ 0`): if
`∫⁻_B g dν = ∫⁻_A ofReal(J)·(g ∘ Φ) dμ` for every `g : β → [0, ∞]` and `J ≥ 0`, then for `f`
integrable on `B`, `J·(f ∘ Φ)` is integrable on `A` and `∫_B f dν = ∫_A J·(f ∘ Φ) dμ`.  The
identity at `g = ‖f‖ₑ` gives integrability (`‖J t‖ₑ = ofReal(J)·‖t‖ₑ`); at `g = ofReal(±f)` it
matches the positive and negative parts (`ofReal(J)·ofReal(±t) = ofReal(±J t)`). -/
theorem Submission.codim1_ac_pp_setIntegral_transfer : ∀ (α β : Type) [MeasurableSpace α] [MeasurableSpace β] (μ : Measure α) (ν : Measure β) (Φ : α → β) (A : Set α) (B : Set β) (J : α → ℝ) (f : β → ℝ), (∀ x, 0 ≤ J x) → (∀ g : β → ℝ≥0∞, ∫⁻ y in B, g y ∂ν = ∫⁻ x in A, ENNReal.ofReal (J x) * g (Φ x) ∂μ) → Integrable f (ν.restrict B) → AEStronglyMeasurable (fun x => J x * f (Φ x)) (μ.restrict A) → Integrable (fun x => J x * f (Φ x)) (μ.restrict A) ∧ ∫ y in B, f y ∂ν = ∫ x in A, J x * f (Φ x) ∂μ := by
  intro α β _ _ μ ν Φ A B J f hJ harea hf hmeas
  -- `∫⁻_A ‖J·(f ∘ Φ)‖ₑ dμ = ∫⁻_B ‖f‖ₑ dν < ∞`
  have hint : Integrable (fun x => J x * f (Φ x)) (μ.restrict A) := by
    refine ⟨hmeas, ?_⟩
    have h1 : ∫⁻ x in A, ‖J x * f (Φ x)‖ₑ ∂μ = ∫⁻ y in B, ‖f y‖ₑ ∂ν := by
      rw [harea (fun y => ‖f y‖ₑ)]
      congr 1
      funext x
      rw [enorm_mul, Real.enorm_of_nonneg (hJ x)]
    rw [HasFiniteIntegral, h1]
    exact hf.2
  refine ⟨hint, ?_⟩
  -- both integrals as differences of the integrals of their positive and negative parts
  rw [integral_eq_lintegral_pos_part_sub_lintegral_neg_part hf,
    integral_eq_lintegral_pos_part_sub_lintegral_neg_part hint,
    harea (fun y => ENNReal.ofReal (f y)), harea (fun y => ENNReal.ofReal (-f y))]
  congr 2
  · congr 1
    funext x
    rw [ENNReal.ofReal_mul (hJ x)]
  · congr 1
    funext x
    rw [← ENNReal.ofReal_mul (hJ x), mul_neg]
/-- **Approximate tangent space of an embedded `C¹` submanifold** (Simon Ch. 3, 1.4; the step
"since `x ∈ Nⱼ` and `Nⱼ` is a `C¹` submanifold, `lim_{λ↓0} ∫_{η_{x,λ}(Nⱼ)} f dHⁿ = ∫_{TₓNⱼ} f dHⁿ`"
of the proof of 1.6 "⇒", chapter-03.txt lines 113–126).  Let `ψ : V → W₀` be a local
representation of `N` (Ch. 2, (4.1)) with `x = ψ(v₀)`, so that `Q = TₓN = Dψ(v₀)(ℝᵐ)` (Ch. 2,
(4.3)).  For a small ball `B_ρ(v₀) ⊆ V`, `Dψ(v₀)(ℝᵐ)` is the approximate tangent space of
`ψ(B_ρ(v₀))` at `x` (area formula and dominated convergence).  As `ψ` is proper and 1:1,
`N ∩ W` and `ψ(B_ρ(v₀))` agree on some ball `B_δ(x)`, and approximate tangent spaces at `x` only
depend on the set near `x`. -/
theorem Submission.codim1_ac_submanifold_approxTangent : ∀ (P m : ℕ) (N W : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)), 1 ≤ m → IsEmbeddedSubmanifold 1 m N → IsOpen W → x ∈ N ∩ W → (Q : Set (Euclid P)) = tangentSpace N x → HasApproximateTangentSpaceAt m (N ∩ W) x Q := by
  intro P m N W x Q _ hN hW hx hQ
  -- Step 1, a local representation `ψ : V → W₀` of `N` with `x = ψ(v₀)`
  obtain ⟨V, W₀, ψ, hV, hW₀, hxW₀, hψ, hinj, hψV, hproper, hDψ⟩ := hN x hx.1
  obtain ⟨v₀, hv₀, rfl⟩ : x ∈ ψ '' V := hψV ▸ ⟨hxW₀, hx.1⟩
  have hψ1 : ContDiffOn ℝ 1 ψ V := by exact_mod_cast hψ
  -- `Q = T_{ψ(v₀)}N = Dψ(v₀)(ℝᵐ)`
  have hQA : Q = LinearMap.range (fderiv ℝ ψ v₀ : Euclid m →ₗ[ℝ] Euclid P) := by
    refine SetLike.ext' ?_
    rw [hQ, LinearMap.coe_range, Submission.chart_tangentSpace_eq_range_fderiv P m 1 N W₀ V ψ v₀
      le_rfl hV hW₀ hψ hinj hψV hproper hDψ hv₀]
    rfl
  subst hQA
  -- Step 2, `Dψ(v₀)(ℝᵐ)` is the approximate tangent space of `ψ(B_ρ(v₀))` at `ψ(v₀)`
  obtain ⟨ρ, hρ, hρV, hT⟩ :=
    Submission.codim1_ac_sat_chart_ball_approxTangent P m V ψ v₀ hV hψ1 hv₀ (hDψ v₀ hv₀)
  -- Step 3, `N ∩ W` and `ψ(B_ρ(v₀))` agree on a ball `B_δ(ψ(v₀))`
  obtain ⟨δ, hδ, hloc⟩ := Submission.codim1_ac_sat_chart_localization P m N W W₀ V ψ v₀ ρ hW hW₀
    hψ.continuousOn hinj hψV hproper hv₀ hx.2 hρ hρV
  -- Step 4, approximate tangent spaces only depend on the set near the point
  exact Submission.codim1_ac_sat_approxTangent_of_local_eq P m (N ∩ W) (ψ '' ball v₀ ρ) (ψ v₀) _ δ
    hδ hloc hT
/-- **Area formula on an embedded `C¹` submanifold** (Simon Ch. 2, 4.11–4.13, from the parametric
area formula 3.2).  Let `N ⊆ ℝᴾ` be an embedded `m`-dimensional `C¹` submanifold, `Q(x) = T_xN`
for `x ∈ N`, and `Φ : ℝᴾ → ℝᴾ` injective and `C¹` with `DΦ(x)` injective.  Put
`J(x) = √det(⟨DΦ(x)eᵢ, DΦ(x)eⱼ⟩)`, `e` the standard orthonormal basis of `Q(x)`.  Then `J` is
continuous on `N`, and `∫_{Φ(B)} g dHᵐ = ∫_B J · (g ∘ Φ) dHᵐ` for every Borel `B ⊆ N` and every
`g ≥ 0`.  Each `y ∈ N` lies in the open set `W` of a local representation `ψ : V → W` (4.1), and
the chart area formula gives the identity for every Borel `B ⊆ W ∩ N` and every `g`; as `Φ` is
continuous and injective, these local identities glue over a countable subcover of `N`. -/
theorem Submission.codim1_ac_submanifold_area_formula : ∀ (P m : ℕ) (N : Set (Euclid P)) (Q : Euclid P → Submodule ℝ (Euclid P)) (Φ : Euclid P → Euclid P), 1 ≤ m → IsEmbeddedSubmanifold 1 m N → (∀ x ∈ N, (Q x : Set (Euclid P)) = tangentSpace N x) → ContDiff ℝ 1 Φ → Injective Φ → (∀ x, Injective (fderiv ℝ Φ x)) → ContinuousOn (fun x => Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ (Q x)) => inner ℝ (fderiv ℝ Φ x (stdOrthonormalBasis ℝ (Q x) i)) (fderiv ℝ Φ x (stdOrthonormalBasis ℝ (Q x) j))))) N ∧ ∀ B : Set (Euclid P), B ⊆ N → MeasurableSet B → ∀ g : Euclid P → ℝ≥0∞, ∫⁻ y in Φ '' B, g y ∂μHE[m] = ∫⁻ x in B, ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ (Q x)) => inner ℝ (fderiv ℝ Φ x (stdOrthonormalBasis ℝ (Q x) i)) (fderiv ℝ Φ x (stdOrthonormalBasis ℝ (Q x) j))))) * g (Φ x) ∂μHE[m] := by
  intro P m N Q Φ _ hN hQ hΦ hΦinj hDΦ
  -- `J` is continuous on `N`
  refine ⟨Submission.codim1_ac_saf_jacobian_continuousOn P m N Q Φ hN hQ hΦ, ?_⟩
  -- the area formula on `N` glues from its restrictions to the chart sets `W ∩ N`
  refine Submission.codim1_ac_saf_lintegral_image_of_local P μHE[m] N Φ _ hΦ.continuous hΦinj ?_
  intro y hy
  -- `y` lies in the open set `W` of a local representation `ψ : V → W` of `N` (`r = 1`)
  obtain ⟨V, W, ψ, hV, hW, hyW, hψ, hψinj, hψV, hproper, hDψ⟩ := hN y hy
  exact ⟨W, hW, hyW, Submission.codim1_ac_saf_chart_area_formula P m 1 N W V ψ Q Φ le_rfl hV hW
    hψ hψinj hψV hproper hDψ hQ hΦ hΦinj hDΦ⟩
/-- Orientation of the push-forward by an injective linear map (Simon Ch. 6, 3.4–3.5 and 3.7:
`L_#ξ = J η`): if `ξ` is a unit orientation of `Q`, `ζ(β) = ξ(β ∘ L)` and
`J = (det(Leₐ · Le_b))^{1/2}` for the orthonormal basis `e` of `Q`, then `0 < J ≤ ‖L‖ⁿ` and `J⁻¹ζ`
is a unit orientation of `L(Q)`.  With `ξ = ±τ₁ ∧ ⋯ ∧ τₙ` and `σ` an orthonormal frame of
`span (Lτ) = L(Q)`, `β(Lτ) = det A · β(σ)` for `A = (⟨σᵢ, Lτⱼ⟩)`, and `J = |det A|`. -/
theorem Submission.dpf_unitOrientation_map_gramNormalized : ∀ (P n : ℕ) (Q : Submodule ℝ (Euclid P)) (ξ : MultiVector P n) (L : Euclid P →L[ℝ] Euclid P) (J : ℝ), IsUnitOrientationOf ξ Q → Injective L → J = Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ Q) => inner ℝ (L (stdOrthonormalBasis ℝ Q i)) (L (stdOrthonormalBasis ℝ Q j)))) → 0 < J ∧ J ≤ ‖L‖ ^ n ∧ IsUnitOrientationOf (J⁻¹ • ξ.comp (ContinuousAlternatingMap.compContinuousLinearMapCLM L)) (Submodule.map (L : Euclid P →ₗ[ℝ] Euclid P) Q) := by
  intro P n Q ξ L J hξ hL hJ
  -- `ξ = ±τ₁ ∧ ⋯ ∧ τₙ` for an orthonormal basis `τ` of `Q`
  obtain ⟨τ, hτ, hτQ, hξτ⟩ := hξ
  -- `Lτ` is linearly independent; let `σ` be an orthonormal frame of `span (Lτ)` (Gram–Schmidt)
  have hv : LinearIndependent ℝ fun i => L (τ i) :=
    hτ.linearIndependent.map' (L : Euclid P →ₗ[ℝ] Euclid P) (LinearMap.ker_eq_bot.mpr hL)
  obtain ⟨σ, hσ, hσv, hdet, hA0, hAle⟩ :=
    Submission.dpf_exists_orthonormal_frame_det_gram P n (fun i => L (τ i)) hv
  -- `α(Lτ) = det A · α(σ)` for every `n`-covector `α`, where `A = (⟨σᵢ, Lτⱼ⟩)`: the restriction
  -- of `α` to `span σ` is `α(σ) det_σ`, and the coordinates of `Lτⱼ` in the basis `σ` are `Aᵢⱼ`
  have hcov : ∀ α : Covector (Euclid P) n, α (fun j => L (τ j)) =
      (Matrix.of fun i j => inner ℝ (σ i) (L (τ j))).det * α σ := by
    intro α
    set S := Submodule.span ℝ (Set.range σ)
    have hvS : ∀ j, L (τ j) ∈ S := fun j => by
      rw [hσv]
      exact Submodule.subset_span (Set.mem_range_self j)
    let e : Module.Basis (Fin n) ℝ S := Module.Basis.span hσ.linearIndependent
    have he : ∀ i, (e i : Euclid P) = σ i := fun i => by
      rw [Module.Basis.span_apply hσ.linearIndependent i]
    let αS : S [⋀^Fin n]→ₗ[ℝ] ℝ := α.toAlternatingMap.compLinearMap S.subtype
    let w : Fin n → S := fun j => ⟨L (τ j), hvS j⟩
    have h1 : α (fun j => L (τ j)) = αS w := rfl
    have h2 : α σ = αS e := by
      show α σ = α (fun i => (e i : Euclid P))
      congr 1
      funext i
      exact (he i).symm
    have hrepr : ∀ i j, e.repr (w j) i = inner ℝ (σ i) (L (τ j)) := by
      intro i j
      have hs : L (τ j) = ∑ l, e.repr (w j) l • σ l := by
        have := congrArg Subtype.val (e.sum_repr (w j))
        simp only [Submodule.coe_sum, Submodule.coe_smul, he] at this
        exact this.symm
      rw [hs, hσ.inner_right_fintype]
    have hmat : e.toMatrix w = Matrix.of fun i j => inner ℝ (σ i) (L (τ j)) := by
      ext i j
      rw [Module.Basis.toMatrix_apply, hrepr, Matrix.of_apply]
    have h3 : αS w = αS e * e.det w := by
      conv_lhs => rw [AlternatingMap.eq_smul_basis_det e αS]
      rfl
    rw [h1, h2, h3, Module.Basis.det_apply, hmat, mul_comm]
  generalize (Matrix.of fun i j => inner ℝ (σ i) (L (τ j))).det = d at hdet hA0 hAle hcov
  -- `J = √(det G(Le)) = √(det G(Lτ)) = √((det A)²) = |det A|`
  have hJd : J = |d| := by
    rw [hJ, Submission.dpf_det_gram_stdOrthonormalBasis_eq P n Q L τ hτ hτQ, hdet,
      Real.sqrt_sq_eq_abs]
  refine ⟨by rw [hJd]; exact abs_pos.mpr hA0, ?_, σ, hσ, ?_, ?_⟩
  · -- `J = |det A| ≤ ∏ᵢ ‖Lτᵢ‖ ≤ ‖L‖ⁿ`
    rw [hJd]
    refine hAle.trans ?_
    calc ∏ i, ‖L (τ i)‖ ≤ ∏ _i : Fin n, ‖L‖ :=
          Finset.prod_le_prod₀ (fun i _ => norm_nonneg _) fun i _ => by
            simpa [hτ.1 i] using L.le_opNorm (τ i)
      _ = ‖L‖ ^ n := by simp
  · -- `span σ = span (Lτ) = L(span τ) = L(Q)`
    rw [hσv, ← hτQ, Submodule.map_span, ← Set.range_comp]
    rfl
  · -- `(J⁻¹ζ)(α) = J⁻¹ ξ(α ∘ L) = ±J⁻¹ α(Lτ) = ±(J⁻¹ det A) α(σ)` with `J⁻¹ det A = ±1`
    have hζ : ∀ α : Covector (Euclid P) n,
        (J⁻¹ • ξ.comp (ContinuousAlternatingMap.compContinuousLinearMapCLM L)) α =
          J⁻¹ * ξ (α.compContinuousLinearMap L) := fun α => rfl
    have hατ : ∀ α : Covector (Euclid P) n, α.compContinuousLinearMap L τ = d * α σ :=
      fun α => hcov α
    have hsign : J⁻¹ * d = 1 ∨ J⁻¹ * d = -1 := by
      rw [hJd]
      rcases hA0.lt_or_gt with h | h
      · exact Or.inr (by rw [abs_of_neg h, inv_neg, neg_mul, inv_mul_cancel₀ hA0])
      · exact Or.inl (by rw [abs_of_pos h, inv_mul_cancel₀ hA0])
    rcases hξτ with hξτ | hξτ <;> rcases hsign with hs | hs
    · exact Or.inl fun α => by rw [hζ, hξτ, hατ]; linear_combination α σ * hs
    · exact Or.inr fun α => by rw [hζ, hξτ, hατ]; linear_combination α σ * hs
    · exact Or.inr fun α => by rw [hζ, hξτ, hατ]; linear_combination -α σ * hs
    · exact Or.inl fun α => by rw [hζ, hξτ, hατ]; linear_combination -α σ * hs
/-- The derivative bound behind Simon 6.2.24(2)–(3) (push-forward by a `C¹` map): if `φ` is `C¹`
on `ℝᴾ` and `φ(x) = x` off a compact set `K`, then `‖Dφ(x)‖ ≤ Λ` for some `Λ ≥ 0` and all `x`.
`Dφ` is continuous, hence bounded by some `c` on `K`; off the closed set `K`, `φ = id` near `x`,
so `Dφ(x) = id` has norm `≤ 1`.  Take `Λ = max(1, c)`. -/
theorem Submission.dpf_pfc_fderiv_norm_le_of_eq_id_off_compact : ∀ (P : ℕ) (K : Set (Euclid P)) (φ : Euclid P → Euclid P), IsCompact K → ContDiff ℝ 1 φ → (∀ x, x ∉ K → φ x = x) → ∃ Λ : ℝ, 0 ≤ Λ ∧ ∀ x, ‖fderiv ℝ φ x‖ ≤ Λ := by
  intro P K φ hK hφ hid
  -- `Dφ` is continuous, so it is bounded by some `c` on the compact set `K`
  obtain ⟨c, hc⟩ := hK.exists_bound_of_continuousOn (hφ.continuous_fderiv one_ne_zero).continuousOn
  refine ⟨max 1 c, zero_le_one.trans (le_max_left _ _), fun x => ?_⟩
  by_cases hx : x ∈ K
  · exact (hc x hx).trans (le_max_right _ _)
  · -- off the closed set `K`, `φ = id` near `x`, so `Dφ(x) = id` has norm `≤ 1`
    have h : φ =ᶠ[𝓝 x] id := eventually_of_mem (hK.isClosed.isOpen_compl.mem_nhds hx) hid
    rw [h.fderiv_eq, fderiv_id]
    exact ContinuousLinearMap.norm_id_le.trans (le_max_left _ _)
/-- Simon 6.3.1: `Hⁿ`-a.e. on `M` the orientation `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ` of an integer
multiplicity triple is a unit simple `n`-vector (`τ` orthonormal), so every `n`-covector `β`
satisfies `|⟨β, ξ(x)⟩| = |β(τ₁, …, τₙ)| ≤ ‖β‖ ∏ᵢ ‖τᵢ‖ = ‖β‖` (operator norm). -/
theorem Submission.dpf_pfc_imrep_orient_abs_apply_le : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ β : Covector (Euclid P) n, |R.orient x β| ≤ ‖β‖ := by
  intro P n U R
  filter_upwards [R.orients] with x hx β
  -- `ξ(x)` is `±` evaluation at an orthonormal frame `τ`
  obtain ⟨Q, -, τ, hτ, -, hξ⟩ := hx
  have hβ : |β τ| ≤ ‖β‖ :=
    calc |β τ| = ‖β τ‖ := (Real.norm_eq_abs _).symm
      _ ≤ ‖β‖ * ∏ i, ‖τ i‖ := β.le_opNorm τ
      _ = ‖β‖ := by rw [Finset.prod_eq_one fun i _ => hτ.1 i, mul_one]
  rcases hξ with h | h
  · rw [h β]
    exact hβ
  · rw [h β, abs_neg]
    exact hβ

/-- **Pairing bound for `τ(M, θ, ξ)`** (the estimate behind Simon 6.2.24(2)).  If `F` is
`Hⁿ⌞M`-a.e. strongly measurable, vanishes off the compact `C ⊆ U` and `‖F‖ ≤ B`, then
`θ ⟨F, ξ⟩` is `Hⁿ⌞M`-integrable and `|∫_M θ ⟨F, ξ⟩ dHⁿ| ≤ B ∫_{M ∩ C} θ dHⁿ`.  By
`dpf_pfc_imrep_orient_abs_apply_le`, `|θ ⟨F, ξ⟩| ≤ B θ 1_C` a.e., and `θ 1_C` is integrable by
the local integrability of `θ`. -/
theorem Submission.dpf_pfc_imrep_pairing_integrable_abs_le : ∀ (P n : ℕ) (U C : Set (Euclid P)) (R : IMRep U n) (F : Euclid P → Covector (Euclid P) n) (B : ℝ), IsCompact C → C ⊆ U → AEStronglyMeasurable F (μHE[n].restrict R.carrier) → (∀ x, x ∉ C → F x = 0) → (∀ x, ‖F x‖ ≤ B) → Integrable (fun x => (R.mult x : ℝ) * R.orient x (F x)) (μHE[n].restrict R.carrier) ∧ |∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (F x) ∂μHE[n]| ≤ B * (∫⁻ x in R.carrier ∩ C, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal := by
  intro P n U C R F B hC hCU hF hF0 hFB
  -- Step 1: `C` is measurable; step 2: `θ` is measurable
  have hCm : MeasurableSet C := hC.isClosed.measurableSet
  have hθm : Measurable fun x => (R.mult x : ℝ) :=
    (measurable_from_nat (f := fun k : ℕ => (k : ℝ))).comp R.measurable_mult
  -- Step 3: `μ.restrict C = Hⁿ⌞(M ∩ C)`
  have hres : (μHE[n].restrict R.carrier).restrict C = μHE[n].restrict (R.carrier ∩ C) := by
    rw [Measure.restrict_restrict hCm, inter_comm]
  -- Step 4: `θ` is integrable on `C`, so `g = B · 1_C θ` is integrable
  have hθC : IntegrableOn (fun x => (R.mult x : ℝ)) C (μHE[n].restrict R.carrier) := by
    refine ⟨hθm.aestronglyMeasurable, ?_⟩
    rw [HasFiniteIntegral, hres]
    simpa using (R.locallyIntegrable_mult C hC hCU).lt_top
  have hg : Integrable (fun x => B * C.indicator (fun y => (R.mult y : ℝ)) x)
      (μHE[n].restrict R.carrier) :=
    ((integrable_indicator_iff hCm).2 hθC).const_mul B
  -- Step 5: `h = θ · ξ(F)` is a.e. strongly measurable
  have hh : AEStronglyMeasurable (fun x => (R.mult x : ℝ) * R.orient x (F x))
      (μHE[n].restrict R.carrier) :=
    hθm.aestronglyMeasurable.mul ((continuous_fst.clm_apply continuous_snd).comp_aestronglyMeasurable₂
      R.aestronglyMeasurable_orient hF)
  -- Step 6: `|h| ≤ g` a.e., by `orient_bound`
  have hdom : ∀ᵐ x ∂(μHE[n].restrict R.carrier),
      ‖(R.mult x : ℝ) * R.orient x (F x)‖ ≤ B * C.indicator (fun y => (R.mult y : ℝ)) x := by
    filter_upwards [Submission.dpf_pfc_imrep_orient_abs_apply_le P n U R] with x hx
    by_cases hxC : x ∈ C
    · rw [indicator_of_mem hxC, Real.norm_eq_abs, abs_mul, Nat.abs_cast, mul_comm B]
      exact mul_le_mul_of_nonneg_left ((hx (F x)).trans (hFB x)) (Nat.cast_nonneg _)
    · simp [indicator_of_notMem hxC, hF0 x hxC]
  -- Step 7: integrability
  refine ⟨hg.mono' hh hdom, ?_⟩
  -- Step 8: `∫ g dμ = B · (∫⁻_{M ∩ C} θ dHⁿ).toReal`
  have hgval : ∫ x, B * C.indicator (fun y => (R.mult y : ℝ)) x ∂(μHE[n].restrict R.carrier) =
      B * (∫⁻ x in R.carrier ∩ C, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal := by
    rw [integral_const_mul, integral_indicator hCm, hres,
      integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall fun x => Nat.cast_nonneg _)
        hθm.aestronglyMeasurable]
    simp
  -- Step 9: `|∫ h dμ| ≤ ∫ g dμ`
  rw [← Real.norm_eq_abs, ← hgval]
  exact norm_integral_le_of_norm_le hg hdom
/-- **Simon §6.1** (the test-form topology, the case `β = 0`): if `ωⱼ → 0` in `𝒟ⁿ(U)`, the
`ωⱼ` vanish outside one compact `C ⊆ U`, and `supₓ ‖ωⱼ(x)‖ → 0`.  The compact set is the one in
`TestFormOnConverges`; uniform convergence of the `0`-th iterated derivatives on `C` gives the
bound on `C`, and `ωⱼ = 0` off `C`. -/
theorem Submission.dpf_pfc_testFormOnConverges_zero_uniform : ∀ (P n : ℕ) (U : Set (Euclid P)) (ωs : ℕ → TestFormOn U n), TestFormOnConverges ωs 0 → ∃ C : Set (Euclid P), IsCompact C ∧ C ⊆ U ∧ (∀ j x, x ∉ C → (ωs j : DifferentialForm (Euclid P) n) x = 0) ∧ ∀ ε : ℝ, 0 < ε → ∀ᶠ j in atTop, ∀ x, ‖(ωs j : DifferentialForm (Euclid P) n) x‖ ≤ ε := by
  intro P n U ωs h
  obtain ⟨C, hC, hCU, hsupp, -, hderiv⟩ := h
  have hzero : ∀ j x, x ∉ C → (ωs j : DifferentialForm (Euclid P) n) x = 0 := fun j x hx =>
    image_eq_zero_of_notMem_tsupport fun hx' => hx (hsupp j hx')
  refine ⟨C, hC, hCU, hzero, fun ε hε => ?_⟩
  filter_upwards [Metric.tendstoUniformlyOn_iff.mp (hderiv 0) ε hε] with j hj x
  by_cases hx : x ∈ C
  · have hjx := hj x hx
    simp only [ZeroMemClass.coe_zero, iteratedFDeriv_zero, Pi.zero_apply, dist_zero_left,
      norm_iteratedFDeriv_zero] at hjx
    exact hjx.le
  · rw [hzero j x hx, norm_zero]
    exact hε.le

/-- **Simon 6.2.23–2.24 (2)–(3)** (chapter-06.txt lines 403–440): for a triple `R = (M, θ, ξ)` in
`U` and a `C¹` map `φ` equal to the identity off a compact `K ⊆ U`, the push-forward formula
`ω ↦ ∫_M θ(x) ⟨ω(φ(x)) ∘ Dφ(x), ξ(x)⟩ dHⁿ(x)` defines a current in `U`.  With `‖Dφ‖ ≤ Λ`, the
covector field `F_ω(x) = ω(φ(x)) ∘ Dφ(x)` is continuous, vanishes off the compact set
`tsupport ω ∪ K ⊆ U` and has `‖F_ω‖ ≤ sup ‖ω‖ · Λⁿ`; this gives integrability, hence linearity.
If `ωⱼ → 0`, then `F_{ωⱼ}` vanishes off a fixed compact `C ∪ K` and is eventually bounded by
`η Λⁿ`, which gives sequential continuity. -/
theorem Submission.dpf_pushforward_formula_current_exists : ∀ (P n : ℕ) (U K : Set (Euclid P)) (R : IMRep U n) (φ : Euclid P → Euclid P), IsCompact K → K ⊆ U → ContDiff ℝ 1 φ → (∀ x, x ∉ K → φ x = x) → ∃ S : GeometricCurrentOn U n, ∀ ω : TestFormOn U n, S ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (φ x)).compContinuousLinearMap (fderiv ℝ φ x)) ∂μHE[n] := by
  intro P n U K R φ hK hKU hφ hid
  -- step 1: `‖Dφ(x)‖ ≤ Λ` for every `x`
  obtain ⟨Λ, hΛ0, hΛ⟩ := Submission.dpf_pfc_fderiv_norm_le_of_eq_id_off_compact P K φ hK hφ hid
  -- the pulled-back covector field `F ω x = ω(φ(x)) ∘ Dφ(x)`
  set F : DifferentialForm (Euclid P) n → Euclid P → Covector (Euclid P) n :=
    fun ω x => (ω (φ x)).compContinuousLinearMap (fderiv ℝ φ x) with hFdef
  have hFcont : ∀ ω : DifferentialForm (Euclid P) n, Continuous ω → Continuous (F ω) := by
    intro ω hω
    have h := (ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM (𝕜 := ℝ)
      (ι := Fin n) (G := ℝ) |>.comp (hφ.continuous_fderiv one_ne_zero)).clm_apply
      (hω.comp hφ.continuous)
    simpa only [Function.comp_apply, ContinuousAlternatingMap.compContinuousLinearMapCLM_apply]
      using h
  -- step 2: `‖F ω‖ ≤ B Λⁿ` when `‖ω‖ ≤ B`
  have hFnorm : ∀ (ω : DifferentialForm (Euclid P) n) (B : ℝ), (∀ y, ‖ω y‖ ≤ B) →
      ∀ x, ‖F ω x‖ ≤ B * Λ ^ n := by
    intro ω B hB x
    calc ‖F ω x‖ ≤ ‖ω (φ x)‖ * ‖fderiv ℝ φ x‖ ^ n := by
          simpa only [Fintype.card_fin] using
            ContinuousAlternatingMap.norm_compContinuousLinearMap_le (ω (φ x)) (fderiv ℝ φ x)
      _ ≤ B * Λ ^ n := mul_le_mul (hB _) (pow_le_pow_left₀ (norm_nonneg _) (hΛ x) n)
          (pow_nonneg (norm_nonneg _) n) ((norm_nonneg _).trans (hB (φ x)))
  -- step 3: `F ω` vanishes off `C ∪ K` when `ω` vanishes off `C`
  have hFzero : ∀ (ω : DifferentialForm (Euclid P) n) (C : Set (Euclid P)),
      (∀ y, y ∉ C → ω y = 0) → ∀ x, x ∉ C ∪ K → F ω x = 0 := by
    intro ω C hC x hx
    rw [mem_union, not_or] at hx
    ext v
    simp [hFdef, hid x hx.2, hC x hx.1]
  -- `F ω x` is linear in `ω`
  have hFadd : ∀ (ω₁ ω₂ : DifferentialForm (Euclid P) n) x, F (ω₁ + ω₂) x = F ω₁ x + F ω₂ x := by
    intro ω₁ ω₂ x
    ext v
    simp [hFdef]
  have hFsmul : ∀ (c : ℝ) (ω : DifferentialForm (Euclid P) n) x, F (c • ω) x = c • F ω x := by
    intro c ω x
    ext v
    simp [hFdef]
  -- step 4: the integrand of a test form is integrable
  have hint : ∀ ω : TestFormOn U n, Integrable
      (fun x => (R.mult x : ℝ) * R.orient x (F (ω : DifferentialForm (Euclid P) n) x))
      (μHE[n].restrict R.carrier) := by
    intro ω
    have hωc : Continuous (ω : DifferentialForm (Euclid P) n) := ContDiff.continuous ω.property.1.1
    obtain ⟨B, hB⟩ := hωc.bounded_above_of_compact_support ω.property.1.2
    exact (Submission.dpf_pfc_imrep_pairing_integrable_abs_le P n U
      (tsupport (ω : DifferentialForm (Euclid P) n) ∪ K) R (F ω) (B * Λ ^ n)
      (ω.property.1.2.isCompact.union hK) (union_subset ω.property.2 hKU)
      (hFcont _ hωc).aestronglyMeasurable
      (hFzero _ _ fun y hy => image_eq_zero_of_notMem_tsupport hy) (hFnorm _ _ hB)).1
  -- step 5: the action is linear
  let S₀ : TestFormOn U n →ₗ[ℝ] ℝ :=
    { toFun := fun ω =>
        ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (F (ω : DifferentialForm (Euclid P) n) x)
          ∂μHE[n]
      map_add' := fun ω₁ ω₂ => by
        rw [← integral_add (hint ω₁) (hint ω₂)]
        congr 1
        ext x
        rw [Submodule.coe_add, hFadd, map_add, mul_add]
      map_smul' := fun c ω => by
        rw [RingHom.id_apply, smul_eq_mul, ← integral_const_mul]
        congr 1
        ext x
        rw [Submodule.coe_smul, hFsmul, map_smul, smul_eq_mul, mul_left_comm] }
  -- steps 6–7: sequential continuity, and the action is the push-forward formula by definition
  refine ⟨⟨S₀, fun ωs hωs => ?_⟩, fun ω => rfl⟩
  obtain ⟨C, hC, hCU, hCzero, hsmall⟩ :=
    Submission.dpf_pfc_testFormOnConverges_zero_uniform P n U ωs hωs
  set I : ℝ := (∫⁻ x in R.carrier ∩ (C ∪ K), (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal
  have hI : 0 ≤ Λ ^ n * I := mul_nonneg (pow_nonneg hΛ0 n) ENNReal.toReal_nonneg
  rw [Metric.tendsto_nhds]
  intro ε hε
  have hη : 0 < ε / (Λ ^ n * I + 1) := div_pos hε (by linarith)
  filter_upwards [hsmall _ hη] with j hj
  have hb := (Submission.dpf_pfc_imrep_pairing_integrable_abs_le P n U (C ∪ K) R
    (F (ωs j : DifferentialForm (Euclid P) n)) (ε / (Λ ^ n * I + 1) * Λ ^ n) (hC.union hK)
    (union_subset hCU hKU)
    (hFcont _ (ContDiff.continuous (ωs j).property.1.1)).aestronglyMeasurable
    (hFzero _ _ (hCzero j)) (hFnorm _ _ hj)).2
  rw [Real.dist_eq, sub_zero]
  calc |S₀ (ωs j)| ≤ ε / (Λ ^ n * I + 1) * Λ ^ n * I := hb
    _ = ε * (Λ ^ n * I / (Λ ^ n * I + 1)) := by ring
    _ < ε := mul_lt_of_lt_one_right hε ((div_lt_one (by linarith)).2 (lt_add_one _))

/-- **Push-forward of an oriented `C¹` piece** (Simon 6.2.24(3), 6.3.1–3.2; chapter-06.txt
lines 425–440, 733–768): if `N` is an embedded `C¹` `m`-submanifold oriented by `ξ`, `W` is open
with `Hᵐ(N ∩ W) < ∞` and `Φ` is a `C¹` bijection of `ℝᴾ` with injective derivative, `Λ`-Lipschitz
and `Λ`-antilipschitz, then `ω ↦ ∫_{N∩W} ⟨ω(Φ(x)) ∘ DΦ(x), ξ(x)⟩ dHᵐ` is an integer multiplicity
current `D ∈ 𝒟_m(ℝᴾ)` with `M_{W'}(D) ≤ Hᵐ(Φ(N ∩ W) ∩ W')`.  `Φ` is a homeomorphism and `Φ(N)`
an embedded `C¹` submanifold with `T_{Φ(x)}Φ(N) = DΦ(x)(TₓN)`.  With the Jacobian
`J = (det(DΦ eᵢ · DΦ eⱼ))^{1/2}` and the unit orientation `ζ = J⁻¹ Λ_m DΦ ξ` of `DΦ(TₓN)`, the
triple `(Φ(N ∩ W), 1, ζ ∘ Φ⁻¹)` defines `D` (`Hᵐ(Φ(N ∩ W)) ≤ Λᵐ Hᵐ(N ∩ W)`), and the area formula
on `N` turns `∫_{Φ(N∩W)} ⟨ω, ζ ∘ Φ⁻¹⟩ dHᵐ` into `∫_{N∩W} J ⟨ω ∘ Φ, ζ⟩ dHᵐ`, where
`J(x) ⟨ω(Φ(x)), ζ(x)⟩ = ⟨ω(Φ(x)) ∘ DΦ(x), ξ(x)⟩`. -/
theorem Submission.codim1_ac_oriented_piece_pushforward : ∀ (P m : ℕ) (N W : Set (Euclid P)) (ξ : Euclid P → MultiVector P m) (Φ : Euclid P → Euclid P) (Λ : NNReal), 1 ≤ m → IsEmbeddedSubmanifold 1 m N → IsOrientation m N ξ → IsOpen W → μHE[m] (N ∩ W) ≠ ∞ → ContDiff ℝ 1 Φ → Bijective Φ → (∀ x, Injective (fderiv ℝ Φ x)) → LipschitzWith Λ Φ → AntilipschitzWith Λ Φ → ∃ D : GeometricCurrentOn (univ : Set (Euclid P)) m, IsIntegerMultiplicity D ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) m, Integrable (fun x => ξ x (((ω : DifferentialForm (Euclid P) m) (Φ x)).compContinuousLinearMap (fderiv ℝ Φ x))) (μHE[m].restrict (N ∩ W)) ∧ D ω = ∫ x in N ∩ W, ξ x (((ω : DifferentialForm (Euclid P) m) (Φ x)).compContinuousLinearMap (fderiv ℝ Φ x)) ∂μHE[m]) ∧ ∀ W' : Set (Euclid P), D.massOn W' ≤ μHE[m] (Φ '' (N ∩ W) ∩ W') := by
  intro P m N W ξ Φ Λ hm hN hξ hW hfin hΦ hbij hDΦ hlip hanti
  -- Step 1: `Φ` is a homeomorphism (`Φ⁻¹` is `Λ`-Lipschitz), hence a measurable embedding and
  -- an open map; `N`, `N ∩ W` and `C' = Φ(N ∩ W)` are Borel
  obtain ⟨H, hH⟩ : ∃ H : Euclid P ≃ₜ Euclid P, ⇑H = Φ :=
    ⟨{ toEquiv := Equiv.ofBijective Φ hbij
       continuous_toFun := hΦ.continuous
       continuous_invFun :=
        (hanti.to_rightInverse (Equiv.ofBijective Φ hbij).rightInverse_symm).continuous }, rfl⟩
  have hHΦ : ∀ x, H.symm (Φ x) = x := fun x => by
    rw [← hH]
    exact H.symm_apply_apply x
  have hBm : MeasurableSet (N ∩ W) :=
    (Submission.codim1_ac_pp_embedded_measurable_rectifiable P m N hN).1.inter hW.measurableSet
  have hCm : MeasurableSet (Φ '' (N ∩ W)) := by
    rw [← hH]
    exact H.measurableEmbedding.measurableSet_image' hBm
  have hO : IsOpen (Φ '' W) := by
    rw [← hH]
    exact H.isOpenMap W hW
  -- Step 2: `Q(x) = TₓN` is oriented by `ξ(x)`; `Φ(N)` is an embedded `C¹` submanifold with
  -- `T_{Φ(x)}Φ(N) = DΦ(x)(TₓN)`
  obtain ⟨hξc, hξQ⟩ := hξ
  choose! Q hQT hQξ using hξQ
  obtain ⟨hN', hT'⟩ :=
    Submission.codim1_ac_diffeo_image_submanifold P m N Φ Λ hN hΦ hbij hDΦ hanti
  -- Step 3: the Jacobian `J` and the area formula on `N`; `ζ = J⁻¹ Λ_m DΦ ξ` is a unit
  -- orientation of `DΦ(x)(Q(x))`, and `0 < J ≤ ‖DΦ‖ᵐ ≤ Λᵐ` on `N`
  obtain ⟨hJc, harea⟩ :=
    Submission.codim1_ac_submanifold_area_formula P m N Q Φ hm hN hQT hΦ hbij.injective hDΦ
  set J : Euclid P → ℝ := fun x => Real.sqrt (Matrix.det
    (Matrix.of fun i j : Fin (Module.finrank ℝ (Q x)) =>
      inner ℝ (fderiv ℝ Φ x (stdOrthonormalBasis ℝ (Q x) i))
        (fderiv ℝ Φ x (stdOrthonormalBasis ℝ (Q x) j))))
  set ζ : Euclid P → MultiVector P m := fun x =>
    (J x)⁻¹ • (ξ x).comp (ContinuousAlternatingMap.compContinuousLinearMapCLM (fderiv ℝ Φ x))
  have hpush : ∀ x ∈ N, 0 < J x ∧ J x ≤ ‖fderiv ℝ Φ x‖ ^ m ∧
      IsUnitOrientationOf (ζ x) (Submodule.map (fderiv ℝ Φ x : Euclid P →ₗ[ℝ] Euclid P) (Q x)) :=
    fun x hx => Submission.dpf_unitOrientation_map_gramNormalized P m (Q x) (ξ x)
      (fderiv ℝ Φ x) (J x) (hQξ x hx) (hDΦ x) rfl
  have hJΛ : ∀ x ∈ N, J x ≤ (Λ : ℝ) ^ m := fun x hx =>
    (hpush x hx).2.1.trans
      (pow_le_pow_left₀ (norm_nonneg _) (norm_fderiv_le_of_lipschitz ℝ hlip) m)
  -- Step 4: the image orientation `ξ' = ζ ∘ Φ⁻¹` is continuous on `Φ(N)`
  have hζc : ContinuousOn ζ N := by
    have hDc := (ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM (𝕜 := ℝ)
      (ι := Fin m) (G := ℝ)).comp (hΦ.continuous_fderiv one_ne_zero)
    exact (hJc.inv₀ fun x hx => (hpush x hx).1.ne').smul (hξc.clm_comp hDc.continuousOn)
  set ξ' : Euclid P → MultiVector P m := fun y => ζ (H.symm y)
  have hξ'c : ContinuousOn ξ' (Φ '' N) := by
    refine hζc.comp H.symm.continuous.continuousOn ?_
    rintro _ ⟨x, hx, rfl⟩
    rw [hHΦ x]
    exact hx
  -- Step 5: at `y = Φ(x) ∈ C' = Φ(N) ∩ Φ(W)` the approximate tangent plane of `C'` is
  -- `DΦ(x)(Q(x))`, oriented by `ξ'(y) = ζ(x)`
  have horient : ∀ y ∈ Φ '' (N ∩ W), ∃ Q' : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt m (Φ '' (N ∩ W)) y Q' ∧ IsUnitOrientationOf (ξ' y) Q' := by
    rintro _ ⟨x, ⟨hxN, hxW⟩, rfl⟩
    refine ⟨Submodule.map (fderiv ℝ Φ x : Euclid P →ₗ[ℝ] Euclid P) (Q x), ?_, ?_⟩
    · rw [image_inter hbij.injective]
      refine Submission.codim1_ac_submanifold_approxTangent P m (Φ '' N) (Φ '' W) (Φ x) _ hm hN'
        hO ⟨mem_image_of_mem Φ hxN, mem_image_of_mem Φ hxW⟩ ?_
      rw [Submodule.map_coe, ContinuousLinearMap.coe_coe, hQT x hxN, hT' x hxN]
    · show IsUnitOrientationOf (ζ (H.symm (Φ x))) _
      rw [hHΦ x]
      exact (hpush x hxN).2.2
  -- Step 6: `Hᵐ(C') = ∫_{N∩W} J dHᵐ ≤ Λᵐ Hᵐ(N ∩ W) < ∞`
  have hCfin : μHE[m] (Φ '' (N ∩ W)) ≠ ∞ := by
    have h1 : ∫⁻ y in Φ '' (N ∩ W), 1 ∂μHE[m] =
        ∫⁻ x in N ∩ W, ENNReal.ofReal (J x) * 1 ∂μHE[m] :=
      harea (N ∩ W) inter_subset_left hBm fun _ => 1
    have hle : ∫⁻ x in N ∩ W, ENNReal.ofReal (J x) * 1 ∂μHE[m] ≤
        ENNReal.ofReal ((Λ : ℝ) ^ m) * μHE[m] (N ∩ W) :=
      calc ∫⁻ x in N ∩ W, ENNReal.ofReal (J x) * 1 ∂μHE[m]
          ≤ ∫⁻ _ in N ∩ W, ENNReal.ofReal ((Λ : ℝ) ^ m) ∂μHE[m] :=
            setLIntegral_mono measurable_const fun x hx => by
              rw [mul_one]
              exact ENNReal.ofReal_le_ofReal (hJΛ x hx.1)
        _ = ENNReal.ofReal ((Λ : ℝ) ^ m) * μHE[m] (N ∩ W) := setLIntegral_const _ _
    rw [setLIntegral_one] at h1
    rw [h1]
    exact ne_top_of_le_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hfin) hle
  -- Step 7: the multiplicity-one triple `(C', 1, ξ')` defines the integer multiplicity current
  -- `D`, with `D(ω) = ∫_{C'} ⟨ω, ξ'⟩ dHᵐ` and `M_{W'}(D) ≤ Hᵐ(C' ∩ W')`
  have hCrect : CountablyRectifiable m (Φ '' (N ∩ W)) :=
    (Submission.codim1_ac_pp_embedded_measurable_rectifiable P m (Φ '' N) hN').2.mono
      (image_mono inter_subset_left)
  have : TopologicalSpace.PseudoMetrizableSpace (MultiVector P m) :=
    @PseudoEMetricSpace.pseudoMetrizableSpace _
      (inferInstance : PseudoEMetricSpace (MultiVector P m))
  have hξ'm : AEStronglyMeasurable ξ' (μHE[m].restrict (Φ '' (N ∩ W))) :=
    (hξ'c.mono (image_mono inter_subset_left)).aestronglyMeasurable hCm
  obtain ⟨D, hDim, hDact, hDmass⟩ := Submission.codim1_ac_pp_unit_rectifiable_current P m
    (Φ '' (N ∩ W)) ξ' hCm hCrect
    (fun K _ => ne_top_of_le_ne_top hCfin (measure_mono inter_subset_left)) hξ'm
    (ae_restrict_of_forall_mem hCm horient)
  refine ⟨D, hDim, fun ω => ?_, hDmass⟩
  -- Step 8: `J(x) ⟨ω(Φ(x)), ξ'(Φ(x))⟩ = ⟨ω(Φ(x)) ∘ DΦ(x), ξ(x)⟩` on `N`, and the signed area
  -- formula transfers `∫_{C'} ⟨ω, ξ'⟩ dHᵐ` to `N ∩ W`
  obtain ⟨hfint, hDω⟩ := hDact ω
  have hpt : ∀ x ∈ N, J x * ξ' (Φ x) ((ω : DifferentialForm (Euclid P) m) (Φ x)) =
      ξ x (((ω : DifferentialForm (Euclid P) m) (Φ x)).compContinuousLinearMap (fderiv ℝ Φ x)) := by
    intro x hx
    show J x * ζ (H.symm (Φ x)) ((ω : DifferentialForm (Euclid P) m) (Φ x)) = _
    rw [hHΦ x]
    exact mul_inv_cancel_left₀ (hpush x hx).1.ne' _
  have hωc : Continuous (ω : DifferentialForm (Euclid P) m) :=
    ContDiff.continuous ω.property.1.1
  have hFc : Continuous fun x =>
      ((ω : DifferentialForm (Euclid P) m) (Φ x)).compContinuousLinearMap (fderiv ℝ Φ x) := by
    have h := (ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM (𝕜 := ℝ)
      (ι := Fin m) (G := ℝ) |>.comp (hΦ.continuous_fderiv one_ne_zero)).clm_apply
      (hωc.comp hΦ.continuous)
    simpa only [Function.comp_apply, ContinuousAlternatingMap.compContinuousLinearMapCLM_apply]
      using h
  have hhm : AEStronglyMeasurable (fun x =>
      ξ x (((ω : DifferentialForm (Euclid P) m) (Φ x)).compContinuousLinearMap (fderiv ℝ Φ x)))
      (μHE[m].restrict (N ∩ W)) :=
    ((hξc.clm_apply hFc.continuousOn).mono inter_subset_left).aestronglyMeasurable hBm
  have heq : (fun x => J x * ξ' (Φ x) ((ω : DifferentialForm (Euclid P) m) (Φ x)))
      =ᵐ[μHE[m].restrict (N ∩ W)] fun x =>
        ξ x (((ω : DifferentialForm (Euclid P) m) (Φ x)).compContinuousLinearMap (fderiv ℝ Φ x)) :=
    ae_restrict_of_forall_mem hBm fun x hx => hpt x hx.1
  obtain ⟨hint, hint_eq⟩ := Submission.codim1_ac_pp_setIntegral_transfer (Euclid P) (Euclid P)
    μHE[m] μHE[m] Φ (N ∩ W) (Φ '' (N ∩ W)) J
    (fun y => ξ' y ((ω : DifferentialForm (Euclid P) m) y)) (fun x => Real.sqrt_nonneg _)
    (harea (N ∩ W) inter_subset_left hBm) hfint (hhm.congr heq.symm)
  exact ⟨hint.congr heq, hDω.trans (hint_eq.trans (integral_congr_ae heq))⟩
/-- **Pull-back of a test form by a compactly supported perturbation of the identity**
(Simon 6.2.23–6.2.24).  Let `K'` be compact and `ψ` a `C^∞` map with `ψ = id` off `K'`.  For a
test form `α ∈ 𝒟ᵈ`, the pull-back `ψ^#α(x) = α(ψ(x)) ∘ Dψ(x)` is a test form with
`spt ψ^#α ⊆ spt α ∪ K'`.  It is `C^∞` as `ψ^#α(x) = Φ(Dψ(x))(α(ψ(x)))`, where the precomposition
`Φ(L) = (γ ↦ γ ∘ L)` is analytic in `L`.  Off the closed compact set `spt α ∪ K'` we have
`ψ(z) = z` and `α(z) = 0`, so `ψ^#α(z) = 0`. -/
theorem Submission.dpf_pb_smooth_pullback_isTestForm : ∀ (P d : ℕ) (K' : Set (Euclid P)) (ψ : Euclid P → Euclid P) (α : DifferentialForm (Euclid P) d), IsCompact K' → ContDiff ℝ (⊤ : ℕ∞) ψ → (∀ x, x ∉ K' → ψ x = x) → IsTestForm α → IsTestForm (fun x => (α (ψ x)).compContinuousLinearMap (fderiv ℝ ψ x)) ∧ tsupport (fun x => (α (ψ x)).compContinuousLinearMap (fderiv ℝ ψ x)) ⊆ tsupport α ∪ K' := by
  intro P d K' ψ α hK hψ hfix hα
  -- `α` is `C^∞` with compact support
  obtain ⟨hαs, hαc⟩ := hα
  -- the precomposition `Φ(L) = (γ ↦ γ ∘ L)` on `d`-covectors is analytic, hence `C^∞`
  have hΦ : ContDiff ℝ (⊤ : ℕ∞) (ContinuousAlternatingMap.compContinuousLinearMapCLM :
      (Euclid P →L[ℝ] Euclid P) →
        (Euclid P [⋀^Fin d]→L[ℝ] ℝ) →L[ℝ] (Euclid P [⋀^Fin d]→L[ℝ] ℝ)) :=
    (ContinuousAlternatingMap.analyticOnNhd_compContinuousLinearMapCLM univ).contDiff
  -- `Dψ` and `α ∘ ψ` are `C^∞`, so `ψ^#α = Φ(Dψ)(α ∘ ψ)` is `C^∞`
  have hDψ : ContDiff ℝ (⊤ : ℕ∞) (fderiv ℝ ψ) := (contDiff_infty_iff_fderiv.mp hψ).2
  have hαψ : ContDiff ℝ (⊤ : ℕ∞) (fun x => α (ψ x)) := hαs.comp hψ
  have hsmooth : IsSmoothForm (fun x => (α (ψ x)).compContinuousLinearMap (fderiv ℝ ψ x)) :=
    (hΦ.comp hDψ).clm_apply hαψ
  -- off the closed set `spt α ∪ K'`, `ψ(z) = z` and `α(z) = 0`, so `ψ^#α(z) = 0`
  have hsupp : tsupport (fun x => (α (ψ x)).compContinuousLinearMap (fderiv ℝ ψ x)) ⊆
      tsupport α ∪ K' := by
    refine closure_minimal ?_ ((isClosed_tsupport α).union hK.isClosed)
    intro z hz
    by_contra hzF
    rw [mem_union, not_or] at hzF
    refine Function.mem_support.mp hz ?_
    show (α (ψ z)).compContinuousLinearMap (fderiv ℝ ψ z) = 0
    rw [hfix z hzF.2, image_eq_zero_of_notMem_tsupport hzF.1]
    ext v
    simp
  -- `spt ψ^#α` is a closed subset of the compact set `spt α ∪ K'`
  exact ⟨⟨hsmooth, (IsCompact.union hαc hK).of_isClosed_subset (isClosed_tsupport _) hsupp⟩,
    hsupp⟩
/-- **Dominated convergence for pulled-back integrals** (Simon 6.2.23–6.2.24, the limit step in the
push-forward by a `C¹` map).  Let `R = (M, θ, ξ)` be an integer multiplicity triple in `U`, `α` a
continuous `n`-form with compact support in `U`, and `ψₖ` `C¹` maps equal to the identity off the
compact `K' ⊆ U`, with `‖Dψₖ‖ ≤ C`, `ψₖ → φ` and `Dψₖ → Dφ` pointwise.  Then
`∫_M θ ⟨α(ψₖ)∘Dψₖ, ξ⟩ dHⁿ → ∫_M θ ⟨α(φ)∘Dφ, ξ⟩ dHⁿ`: the integrands are dominated by
`A Cⁿ θ 1_{spt α ∪ K'}` (`‖α‖ ≤ A`, `|ξ(γ)| ≤ ‖γ‖` a.e.), which is integrable since `θ` is locally
`Hⁿ⌞M`-integrable in `U`. -/
theorem Submission.dpf_pb_imrep_pullback_integral_tendsto : ∀ (P n : ℕ) (U K' : Set (Euclid P)) (R : IMRep U n) (α : DifferentialForm (Euclid P) n) (ψ : ℕ → Euclid P → Euclid P) (φ : Euclid P → Euclid P) (C : ℝ), IsCompact K' → K' ⊆ U → Continuous α → HasCompactSupport α → tsupport α ⊆ U → (∀ k, ContDiff ℝ 1 (ψ k)) → (∀ k x, x ∉ K' → ψ k x = x) → (∀ k x, ‖fderiv ℝ (ψ k) x‖ ≤ C) → (∀ x, Tendsto (fun k => ψ k x) atTop (𝓝 (φ x))) → (∀ x, Tendsto (fun k => fderiv ℝ (ψ k) x) atTop (𝓝 (fderiv ℝ φ x))) → Tendsto (fun k => ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x ((α (ψ k x)).compContinuousLinearMap (fderiv ℝ (ψ k) x)) ∂μHE[n]) atTop (𝓝 (∫ x in R.carrier, (R.mult x : ℝ) * R.orient x ((α (φ x)).compContinuousLinearMap (fderiv ℝ φ x)) ∂μHE[n])) := by
  intro P n U K' R α ψ φ C hK' hK'U hα hαc hαU hψ hψid hψC hψφ hDψ
  -- `C₀ = spt α ∪ K'` is compact, closed (hence measurable) and contained in `U`
  have hC₀ : IsCompact (tsupport α ∪ K') := hαc.isCompact.union hK'
  have hC₀m : MeasurableSet (tsupport α ∪ K') := hC₀.isClosed.measurableSet
  -- `‖α‖ ≤ A` everywhere, so `0 ≤ A`
  obtain ⟨A, hA⟩ := hα.bounded_above_of_compact_support hαc
  have hA0 : 0 ≤ A := (norm_nonneg _).trans (hA 0)
  -- `θ` is measurable
  have hθm : Measurable fun x => (R.mult x : ℝ) := measurable_from_nat.comp R.measurable_mult
  -- orientation bound: `|ξ(x)(γ)| = |γ(τ)| ≤ ‖γ‖ ∏ ‖τᵢ‖ = ‖γ‖` for `Hⁿ⌞M`-a.e. `x`
  have hξ : ∀ᵐ x ∂μHE[n].restrict R.carrier, ∀ γ : Covector (Euclid P) n,
      |R.orient x γ| ≤ ‖γ‖ := by
    filter_upwards [R.orients] with x ⟨Q, _, τ, hτ, _, hor⟩ γ
    have hγ : |γ τ| ≤ ‖γ‖ := by
      have h := γ.le_opNorm τ
      simp only [hτ.1, Finset.prod_const_one, mul_one] at h
      rwa [Real.norm_eq_abs] at h
    rcases hor with h | h
    · rw [h γ]; exact hγ
    · rw [h γ, abs_neg]; exact hγ
  -- `x ↦ α(ψₖ(x))∘Dψₖ(x)` is continuous
  have hβ : ∀ k, Continuous fun x =>
      (α (ψ k x)).compContinuousLinearMap (fderiv ℝ (ψ k) x) := by
    intro k
    have h1 : Continuous fun x => (ContinuousAlternatingMap.compContinuousLinearMapCLM
        (fderiv ℝ (ψ k) x) : Covector (Euclid P) n →L[ℝ] Covector (Euclid P) n) :=
      ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM.comp
        ((hψ k).continuous_fderiv one_ne_zero)
    exact h1.clm_apply (hα.comp (hψ k).continuous)
  refine tendsto_integral_of_dominated_convergence
    ((tsupport α ∪ K').indicator fun x => A * C ^ n * (R.mult x : ℝ)) ?_ ?_ ?_ ?_
  · -- each integrand is a.e. strongly measurable
    intro k
    refine hθm.aestronglyMeasurable.mul ?_
    have hev : Continuous fun p : MultiVector P n × Covector (Euclid P) n => p.1 p.2 :=
      isBoundedBilinearMap_apply.continuous
    exact Continuous.comp_aestronglyMeasurable₂
      (g := fun (L : MultiVector P n) (v : Covector (Euclid P) n) => L v) hev
      R.aestronglyMeasurable_orient (hβ k).aestronglyMeasurable
  · -- the bound `A Cⁿ θ 1_{C₀}` is integrable, as `θ` is integrable on `M ∩ C₀`
    refine IntegrableOn.integrable_indicator ?_ hC₀m
    refine Integrable.const_mul ?_ _
    show Integrable _ ((μHE[n].restrict R.carrier).restrict (tsupport α ∪ K'))
    rw [Measure.restrict_restrict hC₀m, inter_comm]
    refine ⟨hθm.aestronglyMeasurable, ?_⟩
    show ∫⁻ x in R.carrier ∩ (tsupport α ∪ K'), ‖(R.mult x : ℝ)‖ₑ ∂μHE[n] < ∞
    simp only [Real.enorm_natCast]
    exact lt_top_iff_ne_top.2 (R.locallyIntegrable_mult _ hC₀ (union_subset hαU hK'U))
  · -- domination `|hₖ| ≤ A Cⁿ θ 1_{C₀}` a.e.
    intro k
    filter_upwards [hξ] with x hx
    by_cases hxC : x ∈ tsupport α ∪ K'
    · rw [indicator_of_mem hxC]
      have hβle : ‖(α (ψ k x)).compContinuousLinearMap (fderiv ℝ (ψ k) x)‖ ≤ A * C ^ n := by
        refine (ContinuousAlternatingMap.norm_compContinuousLinearMap_le _ _).trans ?_
        rw [Fintype.card_fin]
        exact mul_le_mul (hA _) (pow_le_pow_left₀ (norm_nonneg _) (hψC k x) n)
          (pow_nonneg (norm_nonneg _) n) hA0
      rw [norm_mul, Real.norm_natCast, Real.norm_eq_abs]
      calc (R.mult x : ℝ) * |R.orient x ((α (ψ k x)).compContinuousLinearMap (fderiv ℝ (ψ k) x))|
          ≤ (R.mult x : ℝ) * (A * C ^ n) :=
            mul_le_mul_of_nonneg_left ((hx _).trans hβle) (Nat.cast_nonneg _)
        _ = A * C ^ n * (R.mult x : ℝ) := mul_comm _ _
    · -- off `C₀`: `ψₖ(x) = x` and `α(x) = 0`, so the integrand vanishes
      rw [indicator_of_notMem hxC]
      have hxK : x ∉ K' := fun h => hxC (Or.inr h)
      have hxα : x ∉ tsupport α := fun h => hxC (Or.inl h)
      have h0 : (0 : Covector (Euclid P) n).compContinuousLinearMap (fderiv ℝ (ψ k) x) = 0 :=
        map_zero (ContinuousAlternatingMap.compContinuousLinearMapCLM (fderiv ℝ (ψ k) x))
      rw [hψid k x hxK, image_eq_zero_of_notMem_tsupport hxα, h0, map_zero, mul_zero, norm_zero]
  · -- pointwise convergence, by continuity of `α`, of `L ↦ (· ∘ L)` and of evaluation
    refine Eventually.of_forall fun x => ?_
    refine tendsto_const_nhds.mul (((R.orient x).continuous.tendsto _).comp ?_)
    have h1 : Tendsto (fun k => (ContinuousAlternatingMap.compContinuousLinearMapCLM
        (fderiv ℝ (ψ k) x) : Covector (Euclid P) n →L[ℝ] Covector (Euclid P) n)) atTop
        (𝓝 (ContinuousAlternatingMap.compContinuousLinearMapCLM (fderiv ℝ φ x))) :=
      (ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM.tendsto _).comp (hDψ x)
    have h2 : Tendsto (fun k => α (ψ k x)) atTop (𝓝 (α (φ x))) := (hα.tendsto _).comp (hψφ x)
    exact (isBoundedBilinearMap_apply.continuous.tendsto _).comp (h1.prodMk_nhds h2)
/-- **Gram determinant of a restricted adjoint square** (the Jacobian notation of the area
formula, Simon Ch. 2, 4.11–4.13).  Let `T ⊆ ℝᴾ` be a subspace with the induced inner product,
`B : ℝᴾ → ℝᴾ` linear and `σ` an orthonormal frame spanning `T`.  Then
`det((B ∘ ι_T)*(B ∘ ι_T)) = det[⟨Bσᵢ, Bσⱼ⟩]`.  Viewed in `T`, `σ` is orthonormal, and it spans
`T` since `dim T = k`, so it is an orthonormal basis `b` of `T`.  In `b` the matrix of
`(B ∘ ι_T)*(B ∘ ι_T)` has entries `⟨bᵢ, (B ∘ ι_T)*(B ∘ ι_T) bⱼ⟩ = ⟨Bσᵢ, Bσⱼ⟩` (adjoint). -/
theorem Submission.codim1_hcp_af_adjoint_det_eq_gram : ∀ (P k : ℕ) (T : Submodule ℝ (Euclid P)) (B : Euclid P →L[ℝ] Euclid P) (σ : Fin k → Euclid P), Orthonormal ℝ σ → Submodule.span ℝ (Set.range σ) = T → ((B.comp T.subtypeL).adjoint ∘L (B.comp T.subtypeL)).det = Matrix.det (Matrix.of fun i j : Fin k => inner ℝ (B (σ i)) (B (σ j))) := by
  intro P k T B σ hσ hT
  -- each `σ i` lies in `T`, and `σ`, viewed in `T`, is orthonormal
  have hσT : ∀ i, σ i ∈ T := fun i => hT ▸ Submodule.subset_span (mem_range_self i)
  have hb : Orthonormal ℝ fun i => (⟨σ i, hσT i⟩ : T) := hσ.codRestrict T hσT
  -- `dim T = k`, so this family spans `T` and is an orthonormal basis `b` of `T`
  have hk : Fintype.card (Fin k) = Module.finrank ℝ T := by
    rw [← hT, finrank_span_eq_card hσ.linearIndependent]
  obtain ⟨b, hbσ⟩ : ∃ b : OrthonormalBasis (Fin k) ℝ T, ∀ i, (b i : Euclid P) = σ i :=
    ⟨OrthonormalBasis.mk hb (hb.linearIndependent.span_eq_top_of_card_eq_finrank' hk).ge,
      fun i => by simp only [OrthonormalBasis.coe_mk]⟩
  -- the determinant is that of the matrix in `b`, whose `(i, j)` entry is
  -- `⟪b i, (B ∘ ι_T)† ((B ∘ ι_T) (b j))⟫ = ⟪B (σ i), B (σ j)⟫`
  rw [ContinuousLinearMap.det, ← LinearMap.det_toMatrix b.toBasis]
  congr 1
  ext i j
  rw [LinearMap.toMatrix_apply, OrthonormalBasis.coe_toBasis_repr_apply,
    OrthonormalBasis.repr_apply_apply, OrthonormalBasis.coe_toBasis, ContinuousLinearMap.coe_coe,
    ContinuousLinearMap.comp_apply, ContinuousLinearMap.adjoint_inner_right]
  simp only [ContinuousLinearMap.comp_apply, Submodule.coe_subtypeL, Submodule.subtype_apply, hbσ,
    Matrix.of_apply]
/-- **Countable chart partition** (Simon Ch. 2, §4, (4.1), as used for the area formula on a
submanifold, 4.11–4.13).  Let `M ⊂ ℝᴾ` be an embedded `m`-dimensional `C¹` submanifold and `E ⊆ M`
Borel.  Each `y ∈ M` has a chart `ψ_y : V_y → W_y` as in (4.1) with `y ∈ W_y` (each `y ∉ M` gets
the empty chart), and by Lindelöf countably many `W_{y_k}` already cover `M`.  The pieces
`E_k = (E ∩ W_{y_k}) \ ⋃_{j<k} (E ∩ W_{y_j})` are Borel, pairwise disjoint, have union `E`, and
`E_k ⊆ W_{y_k} ∩ M`. -/
theorem Submission.codim1_hcp_af_chart_partition : ∀ (P m : ℕ) (M E : Set (Euclid P)), IsEmbeddedSubmanifold 1 m M → MeasurableSet E → E ⊆ M → ∃ (Es : ℕ → Set (Euclid P)) (Vs : ℕ → Set (Euclid m)) (Ws : ℕ → Set (Euclid P)) (ψs : ℕ → Euclid m → Euclid P), (∀ k, MeasurableSet (Es k)) ∧ Pairwise (fun i j => Disjoint (Es i) (Es j)) ∧ (⋃ k, Es k) = E ∧ ∀ k, IsOpen (Vs k) ∧ IsOpen (Ws k) ∧ ContDiffOn ℝ 1 (ψs k) (Vs k) ∧ InjOn (ψs k) (Vs k) ∧ ψs k '' Vs k = Ws k ∩ M ∧ (∀ K ⊆ Ws k, IsCompact K → IsCompact (Vs k ∩ ψs k ⁻¹' K)) ∧ (∀ z ∈ Vs k, Injective (fderiv ℝ (ψs k) z)) ∧ Es k ⊆ Ws k ∩ M := by
  intro P m M E hM hE hEM
  -- every `y` has a chart `(V_y, W_y, ψ_y)` satisfying (4.1), with `y ∈ W_y` if `y ∈ M`
  -- (for `y ∉ M` the empty chart `(∅, ∅, 0)`)
  have hchart : ∀ y : Euclid P, ∃ (V : Set (Euclid m)) (W : Set (Euclid P))
      (ψ : Euclid m → Euclid P), IsOpen V ∧ IsOpen W ∧ ContDiffOn ℝ 1 ψ V ∧ InjOn ψ V ∧
        ψ '' V = W ∩ M ∧ (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) ∧
        (∀ z ∈ V, Injective (fderiv ℝ ψ z)) ∧ (y ∈ M → y ∈ W) := by
    intro y
    by_cases hy : y ∈ M
    · obtain ⟨V, W, ψ, hV, hW, hyW, hψ, hinj, himg, hprop, hD⟩ := hM y hy
      exact ⟨V, W, ψ, hV, hW, by exact_mod_cast hψ, hinj, himg, hprop, hD, fun _ => hyW⟩
    · exact ⟨∅, ∅, 0, isOpen_empty, isOpen_empty, contDiffOn_empty, injOn_empty _, by simp,
        by simp, by simp, fun h => absurd h hy⟩
  choose V W ψ hV hW hψ hinj himg hprop hD hyW using hchart
  -- Lindelöf: countably many `W_y`, `y ∈ T`, have the same union `⋃_y W_y ⊇ M`
  obtain ⟨T, hTc, hTU⟩ := TopologicalSpace.isOpen_iUnion_countable W hW
  -- enumerate `T ⊆ {y_0, y_1, …}`, so that `M ⊆ ⋃_k W_{y_k}`
  obtain ⟨f, hf⟩ := Set.countable_iff_exists_subset_range.1 hTc
  have hcover : M ⊆ ⋃ k, W (f k) := by
    intro y hy
    have hyT : y ∈ ⋃ i ∈ T, W i := by
      rw [hTU]
      exact mem_iUnion.2 ⟨y, hyW y hy⟩
    obtain ⟨i, hiT, hyi⟩ := mem_iUnion₂.1 hyT
    obtain ⟨k, rfl⟩ := hf hiT
    exact mem_iUnion.2 ⟨k, hyi⟩
  -- the pieces `E_k = (E ∩ W_{y_k}) \ ⋃_{j<k} (E ∩ W_{y_j})` and the charts at `y_k`
  refine ⟨disjointed fun k => E ∩ W (f k), fun k => V (f k), fun k => W (f k),
    fun k => ψ (f k), MeasurableSet.disjointed fun k => hE.inter (hW (f k)).measurableSet,
    disjoint_disjointed _, ?_, fun k => ⟨hV (f k), hW (f k), hψ (f k), hinj (f k), himg (f k),
      hprop (f k), hD (f k), fun x hx => ?_⟩⟩
  -- `⋃_k E_k = ⋃_k (E ∩ W_{y_k}) = E ∩ ⋃_k W_{y_k} = E`, as `E ⊆ M ⊆ ⋃_k W_{y_k}`
  · rw [iUnion_disjointed, ← inter_iUnion]
    exact inter_eq_left.2 (hEM.trans hcover)
  -- `E_k ⊆ E ∩ W_{y_k} ⊆ W_{y_k} ∩ M`
  · have hx' := disjointed_subset _ k hx
    exact ⟨hx'.2, hEM hx'.1⟩

/-- **Jacobian factorization at a chart point** (Simon Ch. 2, 4.11 with §4, (4.3)).  Let
`ψ : V → W` be a local representation of `M` as in (4.1), `v ∈ V`, `Λ = Dψ(v)`,
`T = span T_{ψ(v)}M` and `B : ℝᴾ → ℝᴾ` linear.  Then
`√det[⟨BΛeₖ, BΛeₗ⟩] = √det[⟨Λeₖ, Λeₗ⟩] · √det((B ∘ ι_T)* (B ∘ ι_T))`.  By (4.3),
`T_{ψ(v)}M = Λ(ℝᵐ)`, so `T = range Λ`, of dimension `m` as `Λ` is injective.  For an orthonormal
frame `σ` of `range Λ`, `det[⟨BΛeₖ, BΛeₗ⟩] = det[⟨Bσᵢ, Bσⱼ⟩] · det[⟨Λeₖ, Λeₗ⟩]` with
`det[⟨Λeₖ, Λeₗ⟩] > 0`, and `det[⟨Bσᵢ, Bσⱼ⟩] = det((B ∘ ι_T)* (B ∘ ι_T))`; take square roots. -/
theorem Submission.codim1_hcp_af_chart_jacobian_factor : ∀ (P m : ℕ) (M W : Set (Euclid P)) (V : Set (Euclid m)) (ψ : Euclid m → Euclid P) (B : Euclid P →L[ℝ] Euclid P) (v : Euclid m), IsOpen V → IsOpen W → ContDiffOn ℝ 1 ψ V → InjOn ψ V → ψ '' V = W ∩ M → (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → (∀ z ∈ V, Injective (fderiv ℝ ψ z)) → v ∈ V → Real.sqrt (Matrix.det (Matrix.of fun k l : Fin m => inner ℝ (B (fderiv ℝ ψ v (EuclideanSpace.single k 1))) (B (fderiv ℝ ψ v (EuclideanSpace.single l 1))))) = Real.sqrt (Matrix.det (Matrix.of fun k l : Fin m => inner ℝ (fderiv ℝ ψ v (EuclideanSpace.single k 1)) (fderiv ℝ ψ v (EuclideanSpace.single l 1)))) * Real.sqrt (((B.comp (Submodule.span ℝ (tangentSpace M (ψ v))).subtypeL).adjoint ∘L (B.comp (Submodule.span ℝ (tangentSpace M (ψ v))).subtypeL)).det) := by
  intro P m M W V ψ B v hV hW hψ hinj hψV hproper hDψ hv
  -- `T_{ψ(v)}M = range Λ`, hence `T = span (range Λ) = range Λ`
  set L := LinearMap.range (fderiv ℝ ψ v : Euclid m →ₗ[ℝ] Euclid P) with hL
  have hT : Submodule.span ℝ (tangentSpace M (ψ v)) = L := by
    rw [Submission.chart_tangentSpace_eq_range_fderiv P m 1 M W V ψ v le_rfl hV hW
      (by exact_mod_cast hψ) hinj hψV hproper hDψ hv]
    exact Submodule.span_eq L
  -- `Λ` is injective, so `range Λ` has dimension `m`; `σ` is an orthonormal frame of `range Λ`
  have hdim : Module.finrank ℝ L = m := by
    rw [hL, LinearMap.finrank_range_of_inj (hDψ v hv), finrank_euclideanSpace_fin]
  set b : OrthonormalBasis (Fin m) ℝ L := (stdOrthonormalBasis ℝ L).reindex (finCongr hdim)
  have hσ : Orthonormal ℝ (fun a => (b a : Euclid P)) :=
    b.orthonormal.comp_linearIsometry L.subtypeₗᵢ
  have hspan : Submodule.span ℝ (Set.range fun a => (b a : Euclid P)) = L := by
    rw [show (fun a => (b a : Euclid P)) = L.subtype ∘ b from rfl, Set.range_comp,
      Submodule.span_image, ← b.coe_toBasis, b.toBasis.span_eq, Submodule.map_top,
      Submodule.range_subtype]
  -- `det[⟨BΛeₖ, BΛeₗ⟩] = det[⟨Bσᵢ, Bσⱼ⟩] · det[⟨Λeₖ, Λeₗ⟩]` with `det[⟨Λeₖ, Λeₗ⟩] > 0`,
  -- and `det[⟨Bσᵢ, Bσⱼ⟩] = det((B ∘ ι_T)* (B ∘ ι_T))`
  obtain ⟨hpos, hchain⟩ :=
    Submission.codim1_lura_gram_det_comp_orthonormal m P P (fderiv ℝ ψ v)
  rw [hchain B _ hσ hspan,
    Submission.codim1_hcp_af_adjoint_det_eq_gram P m _ B _ hσ (hspan.trans hT.symm),
    Real.sqrt_mul' _ (hpos (hDψ v hv)).le]
  exact mul_comm _ _

/-- **Area formula on a Borel subset of one chart** (Simon Ch. 2, 4.11–4.13).  Let `(V, W, ψ)` be
a chart of `M` as in (4.1), `E ⊆ W ∩ M` Borel, and `Φ : ℝᴾ → ℝᴾ` a `C¹` map, injective on `E`,
with `DΦ(x)` injective for `x ∈ E`.  With `ι` the inclusion of `span T_xM` and
`J^MΦ(x) = √det((DΦ(x) ∘ ι)*(DΦ(x) ∘ ι))`, `Hᵐ(Φ(E)) = ∫_E J^MΦ dHᵐ`.  The coordinate piece
`F = V ∩ ψ⁻¹(E)` is Borel with `ψ(F) = E`.  The Euclidean area formula for `Φ ∘ ψ` (weight `1`)
and for `ψ` (weight `J^MΦ`) turns both sides into integrals over `F`, and the integrands agree:
`J_{Φ∘ψ} = J_ψ · (J^MΦ ∘ ψ)` by the chain rule and the chart Jacobian factorization. -/
theorem Submission.codim1_hcp_af_chart_area_formula : ∀ (P m : ℕ) (M E W : Set (Euclid P)) (V : Set (Euclid m)) (ψ : Euclid m → Euclid P) (Φ : Euclid P → Euclid P), IsOpen V → IsOpen W → ContDiffOn ℝ 1 ψ V → InjOn ψ V → ψ '' V = W ∩ M → (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → (∀ z ∈ V, Injective (fderiv ℝ ψ z)) → MeasurableSet E → E ⊆ W ∩ M → ContDiff ℝ 1 Φ → InjOn Φ E → (∀ x ∈ E, Injective (fderiv ℝ Φ x)) → μHE[m] (Φ '' E) = ∫⁻ x in E, ENNReal.ofReal (Real.sqrt ((((fderiv ℝ Φ x).comp (Submodule.span ℝ (tangentSpace M x)).subtypeL).adjoint ∘L ((fderiv ℝ Φ x).comp (Submodule.span ℝ (tangentSpace M x)).subtypeL)).det)) ∂μHE[m] := by
  classical
  intro P m M E W V ψ Φ hV hW hψ hinj hψV hproper hDψ hE hEWM hΦ hΦinj hDΦ
  -- Step 1: `F = V ∩ ψ⁻¹(E)` is Borel: on the open set `V`, `ψ` agrees with the Borel map equal
  -- to `ψ` on `V` and to `0` off `V`
  have hF : MeasurableSet (V ∩ ψ ⁻¹' E) := by
    have hψm : Measurable (V.piecewise ψ fun _ => (0 : Euclid P)) :=
      hψ.continuousOn.measurable_piecewise continuousOn_const hV.measurableSet
    have hFeq : V ∩ ψ ⁻¹' E = V ∩ V.piecewise ψ (fun _ => (0 : Euclid P)) ⁻¹' E := by
      ext v
      simp only [mem_inter_iff, mem_preimage]
      exact and_congr_right fun hv => by rw [piecewise_eq_of_mem _ _ _ hv]
    rw [hFeq]
    exact hV.measurableSet.inter (hψm hE)
  -- Step 2: `ψ(F) = E`, as `E ⊆ W ∩ M = ψ(V)`; hence `(Φ ∘ ψ)(F) = Φ(E)`
  have hψF : ψ '' (V ∩ ψ ⁻¹' E) = E := by
    refine Subset.antisymm (image_subset_iff.2 inter_subset_right) fun x hx => ?_
    obtain ⟨v, hv, rfl⟩ : x ∈ ψ '' V := hψV ▸ hEWM hx
    exact ⟨v, ⟨hv, hx⟩, rfl⟩
  have hΦψF : (Φ ∘ ψ) '' (V ∩ ψ ⁻¹' E) = Φ '' E := by rw [image_comp, hψF]
  -- Step 3: `ψ` is differentiable on the open set `V`, `Φ` everywhere, and
  -- `D(Φ ∘ ψ)(v) = DΦ(ψ(v)) ∘ Dψ(v)` (chain rule)
  have hψd : ∀ v ∈ V, DifferentiableAt ℝ ψ v := fun v hv =>
    (hψ.differentiableOn one_ne_zero v hv).differentiableAt (hV.mem_nhds hv)
  have hΦd : Differentiable ℝ Φ := hΦ.differentiable one_ne_zero
  have hchain : ∀ v ∈ V, fderiv ℝ (Φ ∘ ψ) v = (fderiv ℝ Φ (ψ v)).comp (fderiv ℝ ψ v) :=
    fun v hv => fderiv_comp v (hΦd (ψ v)) (hψd v hv)
  -- Step 4: on `F`, `ψ` and `Φ ∘ ψ` are injective with injective derivatives
  have hinjF : InjOn ψ (V ∩ ψ ⁻¹' E) := hinj.mono inter_subset_left
  have hΦψinjF : InjOn (Φ ∘ ψ) (V ∩ ψ ⁻¹' E) := fun v hv w hw hvw =>
    hinjF hv hw (hΦinj hv.2 hw.2 hvw)
  have hDΦψ : ∀ v ∈ V ∩ ψ ⁻¹' E, Injective (fderiv ℝ (Φ ∘ ψ) v) := fun v hv => by
    rw [hchain v hv.1, ContinuousLinearMap.coe_comp]
    exact (hDΦ (ψ v) hv.2).comp (hDψ v hv.1)
  -- Step 5: the area formula for `Φ ∘ ψ` on `F` with weight `1`: `Hᵐ(Φ(E)) = ∫_F J_{Φ∘ψ}`
  have h5 := (Submission.codim1_lura_gram_area_formula m P (Φ ∘ ψ)).2 (V ∩ ψ ⁻¹' E) hF
    (fun v hv => (hΦd (ψ v)).comp v (hψd v hv.1)) hDΦψ hΦψinjF fun _ => 1
  rw [hΦψF, setLIntegral_one] at h5
  -- Step 6: the area formula for `ψ` on `F` with weight `J^MΦ`:
  -- `∫_E J^MΦ dHᵐ = ∫_F J_ψ · (J^MΦ ∘ ψ)`
  have h6 := (Submission.codim1_lura_gram_area_formula m P ψ).2 (V ∩ ψ ⁻¹' E) hF
    (fun v hv => hψd v hv.1) (fun v hv => hDψ v hv.1) hinjF fun x => ENNReal.ofReal
      (Real.sqrt ((((fderiv ℝ Φ x).comp (Submodule.span ℝ (tangentSpace M x)).subtypeL).adjoint ∘L
        ((fderiv ℝ Φ x).comp (Submodule.span ℝ (tangentSpace M x)).subtypeL)).det))
  rw [hψF] at h6
  rw [h5, h6]
  -- Steps 7–8: `J_{Φ∘ψ}(v) = J_ψ(v) · J^MΦ(ψ(v))` on `F` (chart Jacobian with `B = DΦ(ψ(v))`)
  refine setLIntegral_congr_fun hF fun v hv => ?_
  simp only [mul_one, hchain v hv.1, ContinuousLinearMap.comp_apply]
  rw [Submission.codim1_hcp_af_chart_jacobian_factor P m M W V ψ (fderiv ℝ Φ (ψ v)) v hV hW hψ
    hinj hψV hproper hDψ hv.1, ENNReal.ofReal_mul (Real.sqrt_nonneg _)]
/-- **Simon Ch. 2, §5** (frame trace bound for a first-order perturbation of the identity): if
`‖B‖ ≤ A`, `‖L − I − tB‖ ≤ η|t|` with `η ≤ 1`, and `τ₁, …, τₙ` is orthonormal in `ℝᴾ`, then
(i) `|Σₐ τₐ · Bτₐ| ≤ nA` and (ii) `Σₐ |Lτₐ|² − n ≤ 2t Σₐ τₐ · Bτₐ + 2nη|t| + n(A + 1)²t²`.
With `E = L − I − tB` and `wₐ = tBτₐ + Eτₐ` we have `Lτₐ = τₐ + wₐ`, `|wₐ| ≤ (A + 1)|t|` and
`τₐ · Eτₐ ≤ η|t|`; expand `|τₐ + wₐ|² = 1 + 2t τₐ · Bτₐ + 2 τₐ · Eτₐ + |wₐ|²` and sum over `a`. -/
theorem Submission.fvmb_perturbed_frame_sum_norm_sq_sub_le : ∀ (P n : ℕ) (A η t : ℝ) (B L : Euclid P →L[ℝ] Euclid P) (τ : Fin n → Euclid P), η ≤ 1 → ‖B‖ ≤ A → ‖L - ContinuousLinearMap.id ℝ (Euclid P) - t • B‖ ≤ η * |t| → Orthonormal ℝ τ → |∑ a, inner ℝ (τ a) (B (τ a))| ≤ (n : ℝ) * A ∧ ∑ a, ‖L (τ a)‖ ^ 2 - (n : ℝ) ≤ 2 * t * (∑ a, inner ℝ (τ a) (B (τ a))) + 2 * (n : ℝ) * η * |t| + (n : ℝ) * (A + 1) ^ 2 * t ^ 2 := by
  intro P n A η t B L τ hη hB hE hτ
  -- `E = L − I − tB`, so `‖E‖ ≤ η|t|`
  set E : Euclid P →L[ℝ] Euclid P := L - ContinuousLinearMap.id ℝ (Euclid P) - t • B with hEdef
  have hτ1 : ∀ a, ‖τ a‖ = 1 := hτ.1
  -- unit vectors: `|Bτₐ| ≤ A`, `|Eτₐ| ≤ η|t|` and `|τₐ · Bτₐ| ≤ A`
  have hBa : ∀ a, ‖B (τ a)‖ ≤ A := fun a =>
    calc ‖B (τ a)‖ ≤ ‖B‖ * ‖τ a‖ := B.le_opNorm _
      _ = ‖B‖ := by rw [hτ1 a, mul_one]
      _ ≤ A := hB
  have hEa : ∀ a, ‖E (τ a)‖ ≤ η * |t| := fun a =>
    calc ‖E (τ a)‖ ≤ ‖E‖ * ‖τ a‖ := E.le_opNorm _
      _ = ‖E‖ := by rw [hτ1 a, mul_one]
      _ ≤ η * |t| := hE
  have hDa : ∀ a, |inner ℝ (τ a) (B (τ a))| ≤ A := fun a =>
    calc |inner ℝ (τ a) (B (τ a))| ≤ ‖τ a‖ * ‖B (τ a)‖ := abs_real_inner_le_norm _ _
      _ = ‖B (τ a)‖ := by rw [hτ1 a, one_mul]
      _ ≤ A := hBa a
  refine ⟨?_, ?_⟩
  · calc |∑ a, inner ℝ (τ a) (B (τ a))| ≤ ∑ a, |inner ℝ (τ a) (B (τ a))| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _a : Fin n, A := Finset.sum_le_sum fun a _ => hDa a
      _ = (n : ℝ) * A := by rw [Finset.sum_const, Finset.card_fin, nsmul_eq_mul]
  · -- one column: `|Lτₐ|² = |τₐ + wₐ|²` with `wₐ = tBτₐ + Eτₐ`
    have hcol : ∀ a, ‖L (τ a)‖ ^ 2 ≤
        1 + 2 * t * inner ℝ (τ a) (B (τ a)) + 2 * η * |t| + (A + 1) ^ 2 * t ^ 2 := by
      intro a
      have hL : L (τ a) = τ a + (t • B (τ a) + E (τ a)) := by
        simp only [hEdef, sub_apply, smul_apply, ContinuousLinearMap.id_apply]
        abel
      have hw : ‖t • B (τ a) + E (τ a)‖ ≤ (A + 1) * |t| :=
        calc ‖t • B (τ a) + E (τ a)‖ ≤ ‖t • B (τ a)‖ + ‖E (τ a)‖ := norm_add_le _ _
          _ = |t| * ‖B (τ a)‖ + ‖E (τ a)‖ := by rw [norm_smul, Real.norm_eq_abs]
          _ ≤ |t| * A + η * |t| :=
              add_le_add (mul_le_mul_of_nonneg_left (hBa a) (abs_nonneg t)) (hEa a)
          _ ≤ |t| * A + 1 * |t| := by gcongr
          _ = (A + 1) * |t| := by ring
      have hwsq : ‖t • B (τ a) + E (τ a)‖ ^ 2 ≤ (A + 1) ^ 2 * t ^ 2 :=
        calc ‖t • B (τ a) + E (τ a)‖ ^ 2 ≤ ((A + 1) * |t|) ^ 2 :=
              pow_le_pow_left₀ (norm_nonneg _) hw 2
          _ = (A + 1) ^ 2 * t ^ 2 := by rw [mul_pow, sq_abs]
      have hcross : inner ℝ (τ a) (E (τ a)) ≤ η * |t| :=
        calc inner ℝ (τ a) (E (τ a)) ≤ ‖τ a‖ * ‖E (τ a)‖ := real_inner_le_norm _ _
          _ = ‖E (τ a)‖ := by rw [hτ1 a, one_mul]
          _ ≤ η * |t| := hEa a
      rw [hL, norm_add_sq_real, hτ1 a, inner_add_right, real_inner_smul_right]
      linarith
    calc ∑ a, ‖L (τ a)‖ ^ 2 - (n : ℝ)
        ≤ ∑ a, (1 + 2 * t * inner ℝ (τ a) (B (τ a)) + 2 * η * |t| + (A + 1) ^ 2 * t ^ 2) -
            (n : ℝ) := by
          gcongr with a
          exact hcol a
      _ = 2 * t * (∑ a, inner ℝ (τ a) (B (τ a))) + 2 * (n : ℝ) * η * |t| +
            (n : ℝ) * (A + 1) ^ 2 * t ^ 2 := by
          rw [Finset.sum_add_distrib, Finset.sum_add_distrib, Finset.sum_add_distrib,
            Finset.sum_const, Finset.sum_const, Finset.sum_const, ← Finset.mul_sum,
            Finset.card_fin, nsmul_eq_mul, nsmul_eq_mul, nsmul_eq_mul]
          ring
/-- **Simon Ch. 2, §5** (the expansion `J_t = 1 + t div_M X + O(t²)` behind the first variation
formula 5.3), scalar one-sided step: given `n`, `A ≥ 0`, `ε > 0` there are `0 < η ≤ 1` and
`δ > 0` such that `|t| < δ`, `|D| ≤ nA` and `g ≤ exp(2tD + 2nη|t| + n(A + 1)²t²)` imply
`√g ≤ 1 + tD + ε|t|`.  With `σ = tD + nη|t| + n(A + 1)²t²/2` the hypothesis gives
`√g ≤ √(e^σ e^σ) = e^σ`; `|σ| ≤ c₀|t| ≤ 1` for `c₀ = (n + 1)(A + 2 + (A + 1)²)`, so
`e^σ ≤ 1 + σ + σ² ≤ 1 + tD + nη|t| + Kt²` with `K = n(A + 1)²/2 + c₀²`.  Take
`η = min(1, ε/(2n + 1))` (so `nη ≤ ε/2`) and `δ = min(1, 1/c₀, ε/(2K))` (so `Kt² ≤ (ε/2)|t|`). -/
theorem Submission.fvmb_sqrt_le_first_order_of_le_exp : ∀ (n : ℕ) (A ε : ℝ), 0 ≤ A → 0 < ε → ∃ η : ℝ, 0 < η ∧ η ≤ 1 ∧ ∃ δ : ℝ, 0 < δ ∧ ∀ t D g : ℝ, |t| < δ → |D| ≤ (n : ℝ) * A → g ≤ Real.exp (2 * t * D + 2 * (n : ℝ) * η * |t| + (n : ℝ) * (A + 1) ^ 2 * t ^ 2) → Real.sqrt g ≤ 1 + t * D + ε * |t| := by
  intro n A ε hA hε
  have hn : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  -- Step 1: the constants `c₀`, `K`, `η`, `δ`
  obtain ⟨c₀, hc₀⟩ : ∃ c₀ : ℝ, c₀ = ((n : ℝ) + 1) * (A + 2 + (A + 1) ^ 2) := ⟨_, rfl⟩
  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = (n : ℝ) * (A + 1) ^ 2 / 2 + c₀ ^ 2 := ⟨_, rfl⟩
  have hc₀pos : 0 < c₀ := by rw [hc₀]; positivity
  have hKpos : 0 < K := by
    rw [hK]; exact add_pos_of_nonneg_of_pos (by positivity) (pow_pos hc₀pos 2)
  obtain ⟨η, hη⟩ : ∃ η : ℝ, η = min 1 (ε / (2 * (n : ℝ) + 1)) := ⟨_, rfl⟩
  have h2n : (0 : ℝ) < 2 * (n : ℝ) + 1 := by positivity
  have hηpos : 0 < η := by rw [hη]; exact lt_min one_pos (div_pos hε h2n)
  have hη1 : η ≤ 1 := by rw [hη]; exact min_le_left _ _
  -- Step 2: `nη ≤ ε/2`
  have hnη : (n : ℝ) * η ≤ ε / 2 := by
    have h1 : η * (2 * (n : ℝ) + 1) ≤ ε := by
      rw [← le_div_iff₀ h2n, hη]; exact min_le_right _ _
    linarith
  refine ⟨η, hηpos, hη1, min 1 (min (1 / c₀) (ε / (2 * K))),
    lt_min one_pos (lt_min (one_div_pos.mpr hc₀pos) (div_pos hε (mul_pos two_pos hKpos))), ?_⟩
  intro t D g ht hD hg
  -- Step 3: `|t| ≤ 1`, `|t| ≤ 1/c₀`, `|t| ≤ ε/(2K)`, `t² ≤ |t|`
  have ht1 : |t| ≤ 1 := (ht.trans_le (min_le_left _ _)).le
  have htc : |t| ≤ 1 / c₀ := (ht.trans_le ((min_le_right _ _).trans (min_le_left _ _))).le
  have htK : |t| ≤ ε / (2 * K) := (ht.trans_le ((min_le_right _ _).trans (min_le_right _ _))).le
  have hta : 0 ≤ |t| := abs_nonneg t
  have ht2 : t ^ 2 ≤ |t| := by
    rw [← sq_abs]; nlinarith [mul_nonneg hta (sub_nonneg.mpr ht1)]
  -- Step 4: `√g ≤ exp σ`
  obtain ⟨σ, hσ⟩ : ∃ σ : ℝ, σ = t * D + (n : ℝ) * η * |t| + (n : ℝ) * (A + 1) ^ 2 * t ^ 2 / 2 :=
    ⟨_, rfl⟩
  have hsqrt : Real.sqrt g ≤ Real.exp σ := by
    have h2σ : 2 * t * D + 2 * (n : ℝ) * η * |t| + (n : ℝ) * (A + 1) ^ 2 * t ^ 2 = σ + σ := by
      rw [hσ]; ring
    rw [h2σ, Real.exp_add] at hg
    calc Real.sqrt g ≤ Real.sqrt (Real.exp σ * Real.exp σ) := Real.sqrt_le_sqrt hg
      _ = Real.exp σ := Real.sqrt_mul_self (Real.exp_pos σ).le
  -- Step 5: `|σ| ≤ c₀|t|`
  have hσabs : |σ| ≤ c₀ * |t| := by
    have h1 : |t * D| ≤ |t| * ((n : ℝ) * A) := by
      rw [abs_mul]; exact mul_le_mul_of_nonneg_left hD hta
    have h2 : abs ((n : ℝ) * η * |t|) ≤ (n : ℝ) * |t| := by
      rw [abs_of_nonneg (mul_nonneg (mul_nonneg hn hηpos.le) hta)]
      exact mul_le_mul_of_nonneg_right (mul_le_of_le_one_right hn hη1) hta
    have h3 : |(n : ℝ) * (A + 1) ^ 2 * t ^ 2 / 2| ≤ (n : ℝ) * (A + 1) ^ 2 * |t| := by
      have hc : (0 : ℝ) ≤ (n : ℝ) * (A + 1) ^ 2 := by positivity
      have hc2 : (0 : ℝ) ≤ (n : ℝ) * (A + 1) ^ 2 * t ^ 2 := by positivity
      rw [abs_of_nonneg (by positivity)]
      calc (n : ℝ) * (A + 1) ^ 2 * t ^ 2 / 2 ≤ (n : ℝ) * (A + 1) ^ 2 * t ^ 2 := by linarith
        _ ≤ (n : ℝ) * (A + 1) ^ 2 * |t| := mul_le_mul_of_nonneg_left ht2 hc
    have htri : |σ| ≤ |t * D| + abs ((n : ℝ) * η * |t|) + |(n : ℝ) * (A + 1) ^ 2 * t ^ 2 / 2| := by
      rw [hσ]
      exact (abs_add_le _ _).trans (add_le_add (abs_add_le _ _) le_rfl)
    have hcoef : (n : ℝ) * (A + 1 + (A + 1) ^ 2) ≤ c₀ := by
      rw [hc₀]; nlinarith [sq_nonneg (A + 1)]
    calc |σ| ≤ |t| * ((n : ℝ) * A) + (n : ℝ) * |t| + (n : ℝ) * (A + 1) ^ 2 * |t| := by linarith
      _ = (n : ℝ) * (A + 1 + (A + 1) ^ 2) * |t| := by ring
      _ ≤ c₀ * |t| := mul_le_mul_of_nonneg_right hcoef hta
  -- Step 6: `|σ| ≤ 1` and `σ² ≤ c₀²t²`
  have hσ1 : |σ| ≤ 1 := by
    calc |σ| ≤ c₀ * |t| := hσabs
      _ ≤ c₀ * (1 / c₀) := mul_le_mul_of_nonneg_left htc hc₀pos.le
      _ = 1 := mul_one_div_cancel hc₀pos.ne'
  have hσsq : σ ^ 2 ≤ c₀ ^ 2 * t ^ 2 := by
    have h := pow_le_pow_left₀ (abs_nonneg σ) hσabs 2
    rwa [sq_abs, mul_pow, sq_abs] at h
  -- Step 7: `exp σ ≤ 1 + σ + σ²`
  have hexp : Real.exp σ ≤ 1 + σ + σ ^ 2 := by
    have h := (le_abs_self _).trans (Real.abs_exp_sub_one_sub_id_le hσ1)
    linarith
  -- Step 8: the error terms `nη|t| ≤ (ε/2)|t|` and `Kt² ≤ (ε/2)|t|`
  have hnηt : (n : ℝ) * η * |t| ≤ ε / 2 * |t| := mul_le_mul_of_nonneg_right hnη hta
  have hKt : K * t ^ 2 ≤ ε / 2 * |t| := by
    have hK' : K * |t| ≤ ε / 2 := by
      calc K * |t| ≤ K * (ε / (2 * K)) := mul_le_mul_of_nonneg_left htK hKpos.le
        _ = ε / 2 := by field_simp
    calc K * t ^ 2 = (K * |t|) * |t| := by rw [← sq_abs t]; ring
      _ ≤ ε / 2 * |t| := mul_le_mul_of_nonneg_right hK' hta
  have hKt2 : K * t ^ 2 = (n : ℝ) * (A + 1) ^ 2 * t ^ 2 / 2 + c₀ ^ 2 * t ^ 2 := by
    rw [hK]; ring
  -- Step 9: `√g ≤ exp σ ≤ 1 + σ + σ² ≤ 1 + tD + nη|t| + Kt² ≤ 1 + tD + ε|t|`
  linarith
/-- **Gram determinant bound** (Simon Ch. 4, 1.9 and Ch. 2, §5, where the Jacobian is the square
root of such a Gram determinant): `det(vᵢ · vⱼ) ≤ exp(Σₐ |vₐ|² − n)` for `v₁, …, vₙ ∈ ℝᴾ`.
With `V eₐ = vₐ` on `ℝⁿ`, the Gram matrix is the matrix of `S = V*V` in the standard basis, so
`det G = Πᵢ λᵢ` and `Σₐ |vₐ|² = trace S = Σᵢ λᵢ` for the eigenvalues `λᵢ = |V uᵢ|² ≥ 0` of `S`;
multiply `λᵢ ≤ e^{λᵢ − 1}` (`s + 1 ≤ eˢ`) over `i`. -/
theorem Submission.fvmb_gram_det_le_exp_sum_norm_sq_sub : ∀ (P n : ℕ) (v : Fin n → Euclid P), Matrix.det (Matrix.of fun i j => inner ℝ (v i) (v j)) ≤ Real.exp (∑ a, ‖v a‖ ^ 2 - (n : ℝ)) := by
  intro P n v
  classical
  -- `V eₐ = vₐ` and the symmetric operator `S = V*V` on `ℝⁿ`
  let b := EuclideanSpace.basisFun (Fin n) ℝ
  let V : EuclideanSpace ℝ (Fin n) →ₗ[ℝ] Euclid P := b.toBasis.constr ℝ v
  let S := LinearMap.adjoint V ∘ₗ V
  have hS : S.IsSymmetric := LinearMap.isSymmetric_adjoint_comp_self V
  have hn : Module.finrank ℝ (EuclideanSpace ℝ (Fin n)) = n := finrank_euclideanSpace_fin
  have hVe : ∀ a, V (b a) = v a := by
    intro a
    have := b.toBasis.constr_basis ℝ v a
    rw [OrthonormalBasis.coe_toBasis] at this
    exact this
  have hSinner : ∀ x y, inner ℝ x (S y) = inner ℝ (V x) (V y) := by
    intro x y
    simp [S, LinearMap.adjoint_inner_right]
  -- the matrix of `S` is the Gram matrix, and `trace S = Σₐ |vₐ|²`
  have hmat :
      LinearMap.toMatrix b.toBasis b.toBasis S = Matrix.of fun i j => inner ℝ (v i) (v j) := by
    ext i j
    rw [LinearMap.toMatrix_apply, OrthonormalBasis.coe_toBasis_repr_apply,
      OrthonormalBasis.repr_apply_apply, OrthonormalBasis.coe_toBasis, hSinner, hVe, hVe]
    rfl
  have hdet : LinearMap.det S = Matrix.det (Matrix.of fun i j => inner ℝ (v i) (v j)) := by
    rw [← LinearMap.det_toMatrix b.toBasis, hmat]
  have htr : LinearMap.trace ℝ _ S = ∑ a, ‖v a‖ ^ 2 := by
    rw [LinearMap.trace_eq_sum_inner S b]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [hSinner, hVe, real_inner_self_eq_norm_sq]
  -- spectral theorem: `det S = Πᵢ λᵢ`, `trace S = Σᵢ λᵢ`, with `λᵢ = ⟪uᵢ, S uᵢ⟫ = |V uᵢ|² ≥ 0`
  rw [← hdet, hS.det_eq_prod_eigenvalues hn, ← htr, hS.trace_eq_sum_eigenvalues hn]
  have hnonneg : ∀ i, 0 ≤ hS.eigenvalues hn i := by
    intro i
    have h1 := hS.apply_eigenvectorBasis hn i
    have hu : ‖hS.eigenvectorBasis hn i‖ = 1 := (hS.eigenvectorBasis hn).orthonormal.1 i
    have h2 : inner ℝ (hS.eigenvectorBasis hn i) (S (hS.eigenvectorBasis hn i)) =
        hS.eigenvalues hn i := by
      rw [h1, inner_smul_right, real_inner_self_eq_norm_sq, hu]
      simp
    rw [← h2, hSinner]
    exact real_inner_self_nonneg
  -- `0 ≤ λᵢ ≤ e^{λᵢ − 1}`, multiplied over `i`
  simp only [RCLike.ofReal_real_eq_id, id]
  calc ∏ i, hS.eigenvalues hn i ≤ ∏ i, Real.exp (hS.eigenvalues hn i - 1) := by
        refine Finset.prod_le_prod₀ (fun i _ => hnonneg i) (fun i _ => ?_)
        have := Real.add_one_le_exp (hS.eigenvalues hn i - 1)
        linarith
    _ = Real.exp (∑ i, hS.eigenvalues hn i - n) := by
        rw [← Real.exp_sum, Finset.sum_sub_distrib]
        simp

/-- **First-order Jacobian bound** (Simon Ch. 2, §5, where `J_t = 1 + t div_M X + O(t²)` gives the
first variation formula 5.3; here only `‖L − I − tB‖ ≤ η|t|` is assumed): for `|t| < δ`,
`‖B‖ ≤ A` and orthonormal `τ₁, …, τₙ`, `(det(Lτᵢ · Lτⱼ))^{1/2} ≤ 1 + t Σₐ τₐ · Bτₐ + ε|t|`.
With `D = Σₐ τₐ · Bτₐ`, the frame bound gives `|D| ≤ nA` and
`Σₐ |Lτₐ|² − n ≤ 2tD + 2nη|t| + n(A + 1)²t²`, so the Gram determinant bound gives
`det G ≤ exp(2tD + 2nη|t| + n(A + 1)²t²)`; the scalar bound (which supplies `0 < η ≤ 1` and
`δ`) turns this into the claim. -/
theorem Submission.fvmb_orthonormal_gram_sqrt_det_le_first_order : ∀ (P n : ℕ) (A ε : ℝ), 0 ≤ A → 0 < ε → ∃ η : ℝ, 0 < η ∧ ∃ δ : ℝ, 0 < δ ∧ ∀ t : ℝ, |t| < δ → ∀ B L : Euclid P →L[ℝ] Euclid P, ‖B‖ ≤ A → ‖L - ContinuousLinearMap.id ℝ (Euclid P) - t • B‖ ≤ η * |t| → ∀ τ : Fin n → Euclid P, Orthonormal ℝ τ → Real.sqrt (Matrix.det (Matrix.of fun i j => inner ℝ (L (τ i)) (L (τ j)))) ≤ 1 + t * ∑ a, inner ℝ (τ a) (B (τ a)) + ε * |t| := by
  intro P n A ε hA hε
  -- `0 < η ≤ 1` and `δ` depend only on `n`, `A` and `ε`
  obtain ⟨η, hη, hη1, δ, hδ, hsqrt⟩ := Submission.fvmb_sqrt_le_first_order_of_le_exp n A ε hA hε
  refine ⟨η, hη, δ, hδ, fun t ht B L hB hL τ hτ => ?_⟩
  -- `|D| ≤ nA` and `Σₐ |Lτₐ|² − n ≤ 2tD + 2nη|t| + n(A + 1)²t²`
  obtain ⟨hD, htr⟩ :=
    Submission.fvmb_perturbed_frame_sum_norm_sq_sub_le P n A η t B L τ hη1 hB hL hτ
  refine hsqrt t _ _ ht hD ?_
  -- `det G ≤ exp(Σₐ |Lτₐ|² − n) ≤ exp(2tD + 2nη|t| + n(A + 1)²t²)`
  exact (Submission.fvmb_gram_det_le_exp_sum_norm_sq_sub P n fun a => L (τ a)).trans
    (Real.exp_le_exp.mpr htr)
/-- Simon 6.2.24(1), reduction from `C¹` to smooth maps (step 3 of the push-forward proof): a `C¹`
map `φ` of `ℝᴾ` with `φ = id` off the compact set `K ⊆ U` is the pointwise `C¹` limit of `C^∞`
maps `ψₖ` that equal `id` off one compact `K' ⊆ U` and have uniformly bounded differentials.
`K' = cthickening δ K ⊆ U` and `ψₖ = id + ρₖ ⋆ (φ − id)`, `ρₖ` a normalized smooth bump supported
in `B_{δ/(k+2)}(0)`; then `Dψₖ = I + ρₖ ⋆ D(φ − id)`, so `‖Dψₖ‖ ≤ 1 + sup ‖D(φ − id)‖`, and the
mollifications of the continuous `φ − id` and `D(φ − id)` converge pointwise. -/
theorem Submission.dpf_smooth_approx_compact_perturbation : ∀ (P : ℕ) (U K : Set (Euclid P)) (φ : Euclid P → Euclid P), IsOpen U → IsCompact K → K ⊆ U → ContDiff ℝ 1 φ → (∀ x, x ∉ K → φ x = x) → ∃ (ψ : ℕ → Euclid P → Euclid P) (K' : Set (Euclid P)) (C : ℝ), IsCompact K' ∧ K' ⊆ U ∧ (∀ k, ContDiff ℝ (⊤ : ℕ∞) (ψ k)) ∧ (∀ k x, x ∉ K' → ψ k x = x) ∧ (∀ k x, ‖fderiv ℝ (ψ k) x‖ ≤ C) ∧ (∀ x, Tendsto (fun k => ψ k x) atTop (𝓝 (φ x))) ∧ ∀ x, Tendsto (fun k => fderiv ℝ (ψ k) x) atTop (𝓝 (fderiv ℝ φ x)) := by
  intro P U K φ hU hK hKU hφ hfix
  -- Step 1: a margin `δ > 0` with `K' = cthickening δ K ⊆ U`
  obtain ⟨δ, hδ, hδU⟩ := hK.exists_cthickening_subset_open hU hKU
  -- Step 2: the perturbation `g = φ - id` is `C¹` and vanishes off `K`; `‖Dg‖ ≤ A`
  obtain ⟨g, hg⟩ : ∃ g : Euclid P → Euclid P, ∀ x, g x = φ x - x := ⟨fun x => φ x - x, fun _ => rfl⟩
  have hgφ : g = fun x => φ x - x := funext hg
  have hg1 : ContDiff ℝ 1 g := by
    rw [hgφ]
    exact hφ.sub contDiff_id
  have hgK : ∀ x, x ∉ K → g x = 0 := fun x hx => by rw [hg, hfix x hx, sub_self]
  have hgcs : HasCompactSupport g := HasCompactSupport.intro hK hgK
  have hgc : Continuous g := hg1.continuous
  have hDgc : Continuous (fderiv ℝ g) := hg1.continuous_fderiv one_ne_zero
  have hDg : ∀ x, fderiv ℝ g x = fderiv ℝ φ x - ContinuousLinearMap.id ℝ (Euclid P) := by
    intro x
    rw [hgφ]
    exact (((hφ.differentiable one_ne_zero) x).hasFDerivAt.sub (hasFDerivAt_id x)).fderiv
  obtain ⟨A, hA⟩ := hDgc.bounded_above_of_compact_support (hgcs.fderiv ℝ)
  have hA0 : 0 ≤ A := (norm_nonneg _).trans (hA 0)
  -- Step 3: nonnegative smooth `ρ k` with `∫ ρ k = 1`, supported in `ball 0 (r k)`, where
  -- `r k = δ / (k + 2)`: the bump `β k` with `rOut = r k`, divided by its integral
  obtain ⟨r, hr0, hrδ, hrlim⟩ : ∃ r : ℕ → ℝ, (∀ k, 0 < r k) ∧ (∀ k, r k ≤ δ) ∧
      Tendsto r atTop (𝓝 0) := by
    refine ⟨fun k => δ / ((k : ℝ) + 2), fun k => by positivity, fun k => ?_, ?_⟩
    · exact div_le_self hδ.le (by linarith [(Nat.cast_nonneg k : (0 : ℝ) ≤ k)])
    · exact tendsto_const_nhds.div_atTop
        (tendsto_atTop_add_const_right _ 2 tendsto_natCast_atTop_atTop)
  obtain ⟨ρ, hρs, hρn, hρi, hρsupp⟩ : ∃ ρ : ℕ → Euclid P → ℝ,
      (∀ k, ContDiff ℝ (⊤ : ℕ∞) (ρ k)) ∧ (∀ k x, 0 ≤ ρ k x) ∧ (∀ k, ∫ x, ρ k x = 1) ∧
      (∀ k, support (ρ k) ⊆ ball 0 (r k)) := by
    let β : ∀ k, ContDiffBump (0 : Euclid P) := fun k =>
      ⟨r k / 2, r k, half_pos (hr0 k), half_lt_self (hr0 k)⟩
    have hβi : ∀ k, 0 < ∫ x, β k x := fun k => by
      rw [integral_pos_iff_support_of_nonneg (fun x => (β k).nonneg)
        ((β k).continuous.integrable_of_hasCompactSupport (β k).hasCompactSupport),
        (β k).support_eq]
      exact measure_ball_pos _ _ (hr0 k)
    refine ⟨fun k x => (∫ y, β k y)⁻¹ * β k x, fun k => contDiff_const.mul (β k).contDiff,
      fun k x => mul_nonneg (inv_nonneg.2 (hβi k).le) (β k).nonneg, fun k => ?_,
      fun k x hx => ?_⟩
    · rw [integral_const_mul, inv_mul_cancel₀ (hβi k).ne']
    · have hx' : x ∈ support (β k) := right_ne_zero_of_mul hx
      rwa [(β k).support_eq] at hx'
  have hρc : ∀ k, HasCompactSupport (ρ k) := fun k =>
    HasCompactSupport.intro (isCompact_closedBall 0 (r k)) fun x hx =>
      notMem_support.1 fun h => hx (ball_subset_closedBall (hρsupp k h))
  have hρloc : ∀ k, LocallyIntegrable (ρ k) volume := fun k => (hρs k).continuous.locallyIntegrable
  have hsmall : Tendsto (fun k => support (ρ k)) atTop (𝓝 (0 : Euclid P)).smallSets := by
    rw [tendsto_smallSets_iff]
    intro t ht
    obtain ⟨ε, hε, hεt⟩ := Metric.mem_nhds_iff.1 ht
    filter_upwards [(tendsto_order.1 hrlim).2 ε hε] with k hk
    exact (hρsupp k).trans ((ball_subset_ball hk.le).trans hεt)
  -- Steps 4 and 6: `ψ k = id + ρ k ⋆ g` has derivative `I + ρ k ⋆ Dg` (the `precompR`
  -- convolution of `hasFDerivAt_convolution_right` is the scalar one)
  have hL : (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] Euclid P →L[ℝ] Euclid P).precompR (Euclid P) =
      (ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] (Euclid P →L[ℝ] Euclid P) →L[ℝ] (Euclid P →L[ℝ] Euclid P)) := by
    ext a f v
    simp [ContinuousLinearMap.precompR]
  have hderiv : ∀ k x, HasFDerivAt
      (fun y => y + convolution (ρ k) g (ContinuousLinearMap.lsmul ℝ ℝ) volume y)
      (ContinuousLinearMap.id ℝ (Euclid P) +
        convolution (ρ k) (fderiv ℝ g) (ContinuousLinearMap.lsmul ℝ ℝ) volume x) x := by
    intro k x
    have h := hgcs.hasFDerivAt_convolution_right (ContinuousLinearMap.lsmul ℝ ℝ) (hρloc k) hg1 x
    rw [hL] at h
    exact (hasFDerivAt_id x).add h
  -- Step 5: off `K'`, `g = 0` on `ball x (r k)`, so `(ρ k ⋆ g) x = 0`
  have hsupp : ∀ k x, x ∉ cthickening δ K →
      convolution (ρ k) g (ContinuousLinearMap.lsmul ℝ ℝ) volume x = 0 := by
    intro k x hx
    have hgy : ∀ y ∈ ball x (r k), g y = 0 := fun y hy => hgK y fun hyK =>
      hx (mem_cthickening_of_dist_le x y δ K hyK ((mem_ball'.1 hy).le.trans (hrδ k)))
    rw [convolution_eq_right' _ (hρsupp k) fun y hy =>
      (hgy y hy).trans (hgy x (mem_ball_self (hr0 k))).symm, hgy x (mem_ball_self (hr0 k))]
    simp
  refine ⟨fun k x => x + convolution (ρ k) g (ContinuousLinearMap.lsmul ℝ ℝ) volume x,
    cthickening δ K, 1 + A, hK.cthickening, hδU, fun k => ?_, fun k x hx => ?_, fun k x => ?_,
    fun x => ?_, fun x => ?_⟩
  · exact contDiff_id.add
      ((hρc k).contDiff_convolution_left (ContinuousLinearMap.lsmul ℝ ℝ) (hρs k)
        hgc.locallyIntegrable)
  · simp only [hsupp k x hx, add_zero]
  · -- Step 6: `‖Dψ k‖ ≤ ‖I‖ + sup ‖Dg‖ ≤ 1 + A`
    rw [(hderiv k x).fderiv]
    refine (norm_add_le _ _).trans (add_le_add ContinuousLinearMap.norm_id_le ?_)
    have h := dist_convolution_le (x₀ := x) (z₀ := 0) (μ := volume) hA0 (hρsupp k) (hρn k) (hρi k)
      hDgc.aestronglyMeasurable fun y _ => by rw [dist_zero_right]; exact hA y
    rwa [dist_zero_right] at h
  · -- Step 7: `ψ k x → x + g x = φ x`
    have h := convolution_tendsto_right (μ := volume) (φ := ρ) (g := fun _ => g)
      (k := fun _ => x) (Eventually.of_forall hρn) (Eventually.of_forall hρi) hsmall
      (Eventually.of_forall fun _ => hgc.aestronglyMeasurable) ((hgc.tendsto x).comp tendsto_snd)
      tendsto_const_nhds
    have h2 := (tendsto_const_nhds : Tendsto (fun _ : ℕ => x) atTop (𝓝 x)).add h
    rwa [hg x, add_sub_cancel] at h2
  · -- Step 7: `Dψ k x → I + Dg x = Dφ x`
    have h := convolution_tendsto_right (μ := volume) (φ := ρ) (g := fun _ => fderiv ℝ g)
      (k := fun _ => x) (Eventually.of_forall hρn) (Eventually.of_forall hρi) hsmall
      (Eventually.of_forall fun _ => hDgc.aestronglyMeasurable)
      ((hDgc.tendsto x).comp tendsto_snd) tendsto_const_nhds
    have h2 := (tendsto_const_nhds : Tendsto (fun _ : ℕ => ContinuousLinearMap.id ℝ (Euclid P))
      atTop (𝓝 (ContinuousLinearMap.id ℝ (Euclid P)))).add h
    rw [hDg x, add_sub_cancel] at h2
    exact h2.congr fun k => ((hderiv k x).fderiv).symm

/-- Simon 6.2.24(1), `∂f_#T = f_#∂T`, for the `C¹` push-forward formula of 6.2.24(2) (step 3
of the push-forward proof): if `T = τ(M, θ, ξ)` has `∂T = 0` in `U` and
`S(ω) = ∫_M θ ⟨ω(φ(x)) ∘ Dφ(x), ξ⟩ dHⁿ`, where the `C¹` map `φ` is the identity off a compact
`K ⊆ U`, then `∂S = 0` in `U`.  Take `C^∞` maps `ψₖ`, equal to the identity off one compact
`K' ⊆ U`, with `‖Dψₖ‖ ≤ C`, `ψₖ → φ` and `Dψₖ → Dφ` pointwise.  For `η ∈ 𝒟ⁿ⁻¹(U)`,
`ψₖ^#η ∈ 𝒟ⁿ⁻¹(U)` and `d(ψₖ^#η) = ψₖ^#(dη)`, so `0 = ∂T(ψₖ^#η) = ∫_M θ ⟨ψₖ^#(dη), ξ⟩ dHⁿ`;
by dominated convergence these integrals tend to `S(dη) = ∂S(η)`. -/
theorem Submission.dpf_pushforward_formula_boundaryVanishes : ∀ (P n : ℕ) (U K : Set (Euclid P)) (T S : GeometricCurrentOn U n) (R : IMRep U n) (φ : Euclid P → Euclid P), IsOpen U → R.Represents T → IsCompact K → K ⊆ U → ContDiff ℝ 1 φ → (∀ x, x ∉ K → φ x = x) → (∀ ω : TestFormOn U n, S ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (φ x)).compContinuousLinearMap (fderiv ℝ φ x)) ∂μHE[n]) → BoundaryVanishes T → BoundaryVanishes S := by
  intro P n U K T S R φ hU hRT hK hKU hφ hφK hS hT
  -- Step 1: `∂ = 0` in degree `0`; for `n = m + 1` show `∂S(η) = S(dη) = 0` for every `η`
  rcases n with _ | m
  · trivial
  change T.boundary = 0 at hT
  change S.boundary = 0
  -- Step 2: `C^∞` maps `ψₖ = id` off a compact `K' ⊆ U`, `‖Dψₖ‖ ≤ C`, `ψₖ → φ`, `Dψₖ → Dφ`
  obtain ⟨ψ, K', C, hK', hK'U, hψ, hψK', hψC, hψφ, hDψφ⟩ :=
    Submission.dpf_smooth_approx_compact_perturbation P U K φ hU hK hKU hφ hφK
  ext η
  rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.zero_apply, hS]
  -- the test form `α = dη ∈ 𝒟ⁿ(U)`
  set α : DifferentialForm (Euclid P) (m + 1) :=
    (exteriorDerivativeTestOn U m η : DifferentialForm (Euclid P) (m + 1))
  have hα : IsTestForm α ∧ tsupport α ⊆ U := (exteriorDerivativeTestOn U m η).property
  -- Steps 3–5: `∫_M θ ⟨ψₖ^#α, ξ⟩ dHⁿ = ∂T(ψₖ^#η) = 0` for every `k`
  have hI : ∀ k, ∫ x in R.carrier, (R.mult x : ℝ) *
      R.orient x ((α (ψ k x)).compContinuousLinearMap (fderiv ℝ (ψ k) x)) ∂μHE[m + 1] = 0 := by
    intro k
    -- Step 3: `ψₖ^#η` is a test form supported in `tsupport η ∪ K' ⊆ U`
    obtain ⟨hηk, hηkK⟩ := Submission.dpf_pb_smooth_pullback_isTestForm P m K' (ψ k)
      (η : DifferentialForm (Euclid P) m) hK' (hψ k) (hψK' k) η.property.1
    let ηk : TestFormOn U m :=
      ⟨fun x => ((η : DifferentialForm (Euclid P) m) (ψ k x)).compContinuousLinearMap
        (fderiv ℝ (ψ k) x), hηk, hηkK.trans (union_subset η.property.2 hK'U)⟩
    -- Step 4: `d(ψₖ^#η) = ψₖ^#(dη)` (Simon 6.1.14; Mathlib `extDeriv_pullback`)
    have hnat : (exteriorDerivativeTestOn U m ηk : DifferentialForm (Euclid P) (m + 1)) =
        fun x => (α (ψ k x)).compContinuousLinearMap (fderiv ℝ (ψ k) x) := by
      funext x
      exact extDeriv_pullback (η.property.1.1.differentiable (by simp)).differentiableAt
        (hψ k).contDiffAt (by simp)
    -- Step 5: `0 = ∂T(ψₖ^#η) = T(d(ψₖ^#η)) = ∫_M θ ⟨ψₖ^#α, ξ⟩ dHⁿ`
    have h0 : T (exteriorDerivativeTestOn U m ηk) = 0 := by
      rw [← GeometricCurrentOn.boundary_apply, hT, GeometricCurrentOn.zero_apply]
    rw [hRT, IMRep.action, hnat] at h0
    exact h0
  -- Step 6: dominated convergence, `∫_M θ ⟨ψₖ^#α, ξ⟩ dHⁿ → ∫_M θ ⟨φ^#α, ξ⟩ dHⁿ = S(dη)`
  have hlim := Submission.dpf_pb_imrep_pullback_integral_tendsto P (m + 1) U K' R α ψ φ C hK'
    hK'U hα.1.1.continuous hα.1.2 hα.2 (fun k => (hψ k).of_le (by exact_mod_cast le_top)) hψK'
    hψC hψφ hDψφ
  -- Step 7: the limit of the vanishing integrals is `0`
  exact tendsto_nhds_unique hlim (tendsto_const_nhds.congr fun k => (hI k).symm)
/-- **The support of a cone is invariant under positive dilations** (Simon 7.3.1(2), 6.2.11).
If `C ∈ 𝒟ₙ(ℝᴾ)` is a cone, `t > 0` and `x ∈ spt C`, then `tx ∈ spt C`.  If `C` vanishes on an
open `W` with compact closure, it vanishes on `tW`: for `tsupport ω ⊆ tW`, the dilation pullback
identity with `λ = t⁻¹` gives `C(ω) = C(ω')` with `ω'(y) = tⁿ ω(ty)` and `tsupport ω' ⊆ W`.
So `t·Z(C) ⊆ Z(C)` for every `t > 0`, and `tx ∈ Z(C)` would give `x = t⁻¹(tx) ∈ Z(C)`. -/
theorem Submission.codim1_ovr_cone_support_smul : ∀ (P n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n), IsConeCurrent C → ∀ t : ℝ, 0 < t → ∀ x ∈ C.support, t • x ∈ C.support := by
  intro P n C hC
  -- Step 1: `t·Z(C) ⊆ Z(C)` for `t > 0`; here `tW` is the image of `W` under `y ↦ ty`.
  have hZ : ∀ t : ℝ, 0 < t → ∀ z ∈ C.zeroRegion, t • z ∈ C.zeroRegion := by
    intro t ht z hz
    obtain ⟨W, ⟨hWo, hWc, -, hWv⟩, hzW⟩ := hz
    refine ⟨(fun y => t • y) '' W, ⟨isOpenMap_smul₀ ht.ne' W hWo, ?_, subset_univ _, ?_⟩,
      ⟨z, hzW, rfl⟩⟩
    -- (b) `closure (tW) = t·closure W` is compact.
    · rw [← (isHomeomorph_smul₀ ht.ne').image_closure W]
      exact hWc.image (continuous_const_smul t)
    -- (c) `C` vanishes on `tW`, via `ω'(y) = tⁿ ω(ty)` from the cone pullback identity.
    · intro ω hω
      obtain ⟨ω', hω'eq, hω'C⟩ :=
        Submission.cone_current_apply_dilation_pullback P n C hC t⁻¹ (inv_pos.2 ht) ω
      rw [← hω'C]
      apply hWv
      have hsupp : support (ω' : DifferentialForm (Euclid P) n) ⊆
          (fun y => t • y) ⁻¹' tsupport (ω : DifferentialForm (Euclid P) n) := by
        intro y hy
        rw [mem_support, hω'eq y, inv_inv] at hy
        exact subset_tsupport _ (fun h => hy (by rw [h, smul_zero]))
      have hcl : IsClosed ((fun y : Euclid P => t • y) ⁻¹'
          tsupport (ω : DifferentialForm (Euclid P) n)) :=
        (isClosed_tsupport _).preimage (continuous_const_smul t)
      -- `y ∈ tsupport ω'` gives `ty ∈ tsupport ω ⊆ tW`, so `ty = tw` with `w ∈ W`, and `w = y`.
      intro y hy
      obtain ⟨w, hwW, hw⟩ := hω (closure_minimal hsupp hcl hy)
      rwa [← smul_right_injective (Euclid P) ht.ne' hw]
  -- Step 2: `tx ∈ Z(C)` would give `x = t⁻¹(tx) ∈ Z(C)`.
  intro t ht x hx
  refine ⟨mem_univ _, fun htx => hx.2 ?_⟩
  have h := hZ t⁻¹ (inv_pos.2 ht) (t • x) htx
  rwa [smul_smul, inv_mul_cancel₀ ht.ne', one_smul] at h
/-- **Simon Ch. 6, Remark 3.2(1)**, steps 2–3, for two triples `R₁ = (C₁, θ₁, ξ₁)` and
`R₂ = (C₂, θ₂, ξ₂)` in `U`: if, `Hⁿ`-a.e. on `C₁ ∩ C₂`, every approximate tangent space of `C₁`
and every approximate tangent space of `C₂` is one of `C₁ ∩ C₂`, then `ξ₂ = ±ξ₁` `Hⁿ`-a.e. on
`C₁ ∩ C₂`.  At such a point `ξ₁(x)` and `ξ₂(x)` orient approximate tangent spaces of `C₁ ∩ C₂`,
which coincide (Ch. 3, Remark 1.5(1)), so they differ by a sign. -/
theorem Submission.regcomp_ims_overlap_orient_eq_or_neg : ∀ (P n : ℕ) (U : Set (Euclid P)) (R₁ R₂ : IMRep U n), (∀ᵐ x ∂(μHE[n].restrict (R₁.carrier ∩ R₂.carrier)), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n R₁.carrier x Q → HasApproximateTangentSpaceAt n (R₁.carrier ∩ R₂.carrier) x Q) → (∀ᵐ x ∂(μHE[n].restrict (R₁.carrier ∩ R₂.carrier)), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n R₂.carrier x Q → HasApproximateTangentSpaceAt n (R₁.carrier ∩ R₂.carrier) x Q) → ∀ᵐ x ∂(μHE[n].restrict (R₁.carrier ∩ R₂.carrier)), R₂.orient x = R₁.orient x ∨ R₂.orient x = -R₁.orient x := by
  intro P n U R₁ R₂ h₁ h₂
  -- the orientation conditions of `R₁` and `R₂` hold a.e. on `C₁ ∩ C₂`
  have o₁ := ae_restrict_of_ae_restrict_of_subset
    (inter_subset_left : R₁.carrier ∩ R₂.carrier ⊆ R₁.carrier) R₁.orients
  have o₂ := ae_restrict_of_ae_restrict_of_subset
    (inter_subset_right : R₁.carrier ∩ R₂.carrier ⊆ R₂.carrier) R₂.orients
  filter_upwards [o₁, o₂, h₁, h₂] with x hx₁ hx₂ hx₁' hx₂'
  obtain ⟨Q₁, hT₁, hξ₁⟩ := hx₁
  obtain ⟨Q₂, hT₂, hξ₂⟩ := hx₂
  -- both planes are approximate tangent spaces of `C₁ ∩ C₂` at `x`, hence equal
  have hQ : Q₁ = Q₂ := (hx₁' Q₁ hT₁).unique (hx₂' Q₂ hT₂)
  subst hQ
  exact Submission.rsdic_unitOrientation_eq_or_eq_neg P n (R₁.orient x) (R₂.orient x) Q₁ hξ₁ hξ₂
/-- **Simon Ch. 6, Remark 3.2(1)**, measurable bookkeeping for `τ(C₁, θ₁, ξ₁) − τ(C₂, θ₂, ξ₂)` when
`ξ₂ = ±ξ₁` a.e. on `C₁ ∩ C₂`.  With Borel versions `ηᵢ` of `ξᵢ`, the Borel sign `σ = ±1`
(`σ = 1` iff `η₂ = η₁`, so `ξ₂ = σξ₁` a.e. on `C₁ ∩ C₂`) and `d = θ₁ − σθ₂`, take
`C = (C₁ \ C₂) ∪ (C₂ \ C₁) ∪ {x ∈ C₁ ∩ C₂ : d(x) ≠ 0}`, and `θ = θ₁, θ₂, |d|`,
`ξ = η₁, −η₂, sign(d) η₁` on `C₁ \ C₂`, `C₂ \ C₁`, `C₁ ∩ C₂`; then
`1_C θ ξ = 1_{C₁} θ₁ ξ₁ − 1_{C₂} θ₂ ξ₂` a.e., since `|d| sign(d) = d`. -/
theorem Submission.regcomp_ims_difference_data : ∀ (P n : ℕ) (U : Set (Euclid P)) (R₁ R₂ : IMRep U n), (∀ᵐ x ∂(μHE[n].restrict (R₁.carrier ∩ R₂.carrier)), R₂.orient x = R₁.orient x ∨ R₂.orient x = -R₁.orient x) → ∃ (C : Set (Euclid P)) (θ : Euclid P → ℕ) (ξ : Euclid P → MultiVector P n), MeasurableSet C ∧ C ⊆ R₁.carrier ∪ R₂.carrier ∧ Measurable θ ∧ (∀ x ∈ C, 0 < θ x) ∧ (∀ x ∈ C, θ x ≤ R₁.carrier.indicator R₁.mult x + R₂.carrier.indicator R₂.mult x) ∧ AEStronglyMeasurable ξ (μHE[n].restrict C) ∧ (∀ᵐ x ∂(μHE[n].restrict (C ∩ R₁.carrier)), ξ x = R₁.orient x ∨ ξ x = -R₁.orient x) ∧ (∀ᵐ x ∂(μHE[n].restrict (C \ R₁.carrier)), ξ x = R₂.orient x ∨ ξ x = -R₂.orient x) ∧ ∀ᵐ x ∂μHE[n], C.indicator (fun y => (θ y : ℝ) • ξ y) x = R₁.carrier.indicator (fun y => (R₁.mult y : ℝ) • R₁.orient y) x - R₂.carrier.indicator (fun y => (R₂.mult y : ℝ) • R₂.orient y) x := by
  intro P n U R₁ R₂ hH
  classical
  have : TopologicalSpace.MetrizableSpace (MultiVector P n) :=
    { toPseudoMetrizableSpace := ⟨⟨PseudoMetricSpace.toUniformSpace, rfl,
        Metric.uniformity_basis_dist_inv_nat_succ.isCountablyGenerated⟩⟩,
      toT0Space := inferInstance }
  have : ContinuousNeg (MultiVector P n) :=
    @IsTopologicalAddGroup.toContinuousNeg _ _ _ ContinuousLinearMap.isTopologicalAddGroup
  have hC₁ := R₁.measurableSet_carrier
  have hC₂ := R₂.measurableSet_carrier
  -- Borel versions `ηᵢ` of the orientations `ξᵢ`: `ξᵢ = ηᵢ` a.e. on `Cᵢ`
  obtain ⟨η₁, hη₁, hA₁⟩ : ∃ η : Euclid P → MultiVector P n, StronglyMeasurable η ∧
      ∀ᵐ x ∂μHE[n], x ∈ R₁.carrier → R₁.orient x = η x :=
    ⟨_, R₁.aestronglyMeasurable_orient.stronglyMeasurable_mk,
      (ae_restrict_iff' hC₁).mp R₁.aestronglyMeasurable_orient.ae_eq_mk⟩
  obtain ⟨η₂, hη₂, hA₂⟩ : ∃ η : Euclid P → MultiVector P n, StronglyMeasurable η ∧
      ∀ᵐ x ∂μHE[n], x ∈ R₂.carrier → R₂.orient x = η x :=
    ⟨_, R₂.aestronglyMeasurable_orient.stronglyMeasurable_mk,
      (ae_restrict_iff' hC₂).mp R₂.aestronglyMeasurable_orient.ae_eq_mk⟩
  have hH' := (ae_restrict_iff' (hC₁.inter hC₂)).mp hH
  -- the Borel sign `σ`: `σ = 1` where `η₂ = η₁`, `σ = -1` elsewhere
  obtain ⟨σ, hσm, hσ⟩ : ∃ σ : Euclid P → ℤ, Measurable σ ∧
      ∀ x, (η₂ x = η₁ x ∧ σ x = 1) ∨ (η₂ x ≠ η₁ x ∧ σ x = -1) := by
    refine ⟨fun x => if η₂ x = η₁ x then 1 else -1,
      Measurable.ite (hη₂.measurableSet_eq_fun hη₁) measurable_const measurable_const, fun x => ?_⟩
    by_cases h : η₂ x = η₁ x
    · exact Or.inl ⟨h, by simp [h]⟩
    · exact Or.inr ⟨h, by simp [h]⟩
  -- `ξ₂ = σ ξ₁` a.e. on `C₁ ∩ C₂`
  have hS : ∀ᵐ x ∂μHE[n], x ∈ R₁.carrier → x ∈ R₂.carrier →
      R₂.orient x = (σ x : ℝ) • R₁.orient x := by
    filter_upwards [hA₁, hA₂, hH'] with x h1 h2 hx hx1 hx2
    rcases hσ x with ⟨he, hs⟩ | ⟨he, hs⟩
    · rw [hs, h1 hx1, h2 hx2, he]
      ext α; simp
    · rcases hx ⟨hx1, hx2⟩ with h | h
      · exact absurd (by rw [← h1 hx1, ← h2 hx2, h]) he
      · rw [hs, h]
        ext α; simp
  -- the multiplicity difference `d = θ₁ - σ θ₂` on the overlap
  obtain ⟨d, hdm, hd⟩ : ∃ d : Euclid P → ℤ, Measurable d ∧
      ∀ x, d x = (R₁.mult x : ℤ) - σ x * (R₂.mult x : ℤ) :=
    ⟨_, (measurable_from_nat.comp R₁.measurable_mult).sub
      (hσm.mul (measurable_from_nat.comp R₂.measurable_mult)), fun x => rfl⟩
  -- the new carrier `C = (C₁ \ C₂) ∪ (C₂ \ C₁) ∪ {x ∈ C₁ ∩ C₂ : d x ≠ 0}`
  obtain ⟨C, hCm, hC⟩ : ∃ C : Set (Euclid P), MeasurableSet C ∧ ∀ x, x ∈ C ↔
      (x ∈ R₁.carrier ∧ x ∉ R₂.carrier) ∨ (x ∉ R₁.carrier ∧ x ∈ R₂.carrier) ∨
        (x ∈ R₁.carrier ∧ x ∈ R₂.carrier ∧ d x ≠ 0) :=
    ⟨(R₁.carrier \ R₂.carrier) ∪ (R₂.carrier \ R₁.carrier) ∪
        (R₁.carrier ∩ R₂.carrier ∩ {x | d x ≠ 0}),
      ((hC₁.diff hC₂).union (hC₂.diff hC₁)).union
        ((hC₁.inter hC₂).inter (hdm (measurableSet_singleton 0).compl)),
      fun x => by
        simp only [Set.mem_union, Set.mem_sdiff, Set.mem_inter_iff, Set.mem_ofPred_eq]; tauto⟩
  -- the new multiplicity `θ` and orientation `ξ`, piece by piece
  obtain ⟨θ, hθm, hθ12, hθ1, hθ2⟩ : ∃ θ : Euclid P → ℕ, Measurable θ ∧
      (∀ x ∈ R₁.carrier, x ∈ R₂.carrier → θ x = (d x).natAbs) ∧
      (∀ x ∈ R₁.carrier, x ∉ R₂.carrier → θ x = R₁.mult x) ∧
      (∀ x ∉ R₁.carrier, x ∈ R₂.carrier → θ x = R₂.mult x) :=
    ⟨fun x => if x ∈ R₁.carrier then (if x ∈ R₂.carrier then (d x).natAbs else R₁.mult x)
        else (if x ∈ R₂.carrier then R₂.mult x else 0),
      Measurable.ite hC₁ (Measurable.ite hC₂ ((measurable_of_countable Int.natAbs).comp hdm)
        R₁.measurable_mult) (Measurable.ite hC₂ R₂.measurable_mult measurable_const),
      fun x hx1 hx2 => by simp [hx1, hx2], fun x hx1 hx2 => by simp [hx1, hx2],
      fun x hx1 hx2 => by simp [hx1, hx2]⟩
  obtain ⟨ξ, hξm, hξ12, hξ1, hξ2⟩ : ∃ ξ : Euclid P → MultiVector P n, StronglyMeasurable ξ ∧
      (∀ x ∈ R₁.carrier, x ∈ R₂.carrier → ξ x = ((d x).sign : ℝ) • η₁ x) ∧
      (∀ x ∈ R₁.carrier, x ∉ R₂.carrier → ξ x = η₁ x) ∧
      (∀ x ∉ R₁.carrier, ξ x = -η₂ x) :=
    ⟨fun x => if x ∈ R₁.carrier then (if x ∈ R₂.carrier then ((d x).sign : ℝ) • η₁ x else η₁ x)
        else -η₂ x,
      StronglyMeasurable.ite hC₁ (StronglyMeasurable.ite hC₂
        (((measurable_of_countable fun k : ℤ => (k.sign : ℝ)).comp hdm).stronglyMeasurable.smul
          hη₁) hη₁) hη₂.neg,
      fun x hx1 hx2 => by simp [hx1, hx2], fun x hx1 hx2 => by simp [hx1, hx2],
      fun x hx1 => by simp [hx1]⟩
  refine ⟨C, θ, ξ, hCm, ?_, hθm, ?_, ?_, hξm.aestronglyMeasurable, ?_, ?_, ?_⟩
  · intro x hx
    rcases (hC x).mp hx with ⟨hx1, -⟩ | ⟨-, hx2⟩ | ⟨hx1, -⟩
    exacts [Or.inl hx1, Or.inr hx2, Or.inl hx1]
  · intro x hx
    rcases (hC x).mp hx with ⟨hx1, hx2⟩ | ⟨hx1, hx2⟩ | ⟨hx1, hx2, hdx⟩
    · rw [hθ1 x hx1 hx2]; exact R₁.mult_pos x hx1
    · rw [hθ2 x hx1 hx2]; exact R₂.mult_pos x hx2
    · rw [hθ12 x hx1 hx2]; exact Int.natAbs_pos.mpr hdx
  · intro x hx
    rcases (hC x).mp hx with ⟨hx1, hx2⟩ | ⟨hx1, hx2⟩ | ⟨hx1, hx2, -⟩
    · rw [hθ1 x hx1 hx2, Set.indicator_of_mem hx1, Set.indicator_of_notMem hx2]; omega
    · rw [hθ2 x hx1 hx2, Set.indicator_of_mem hx2, Set.indicator_of_notMem hx1]; omega
    · rw [hθ12 x hx1 hx2, Set.indicator_of_mem hx1, Set.indicator_of_mem hx2, hd x]
      rcases hσ x with ⟨-, hs⟩ | ⟨-, hs⟩ <;> rw [hs] <;> omega
  · refine (ae_restrict_iff' (hCm.inter hC₁)).mpr ?_
    filter_upwards [hA₁] with x h1 ⟨hxC, hx1⟩
    rw [h1 hx1]
    by_cases hx2 : x ∈ R₂.carrier
    · have hdx : d x ≠ 0 := by
        rcases (hC x).mp hxC with ⟨-, h⟩ | ⟨h, -⟩ | ⟨-, -, h⟩
        exacts [absurd hx2 h, absurd hx1 h, h]
      rw [hξ12 x hx1 hx2]
      rcases lt_or_gt_of_ne hdx with h | h
      · rw [Int.sign_eq_neg_one_of_neg h]
        right; ext α; simp
      · rw [Int.sign_eq_one_of_pos h]
        left; ext α; simp
    · left; exact hξ1 x hx1 hx2
  · refine (ae_restrict_iff' (hCm.diff hC₁)).mpr ?_
    filter_upwards [hA₂] with x h2 ⟨hxC, hx1⟩
    have hx2 : x ∈ R₂.carrier := by
      rcases (hC x).mp hxC with ⟨h, -⟩ | ⟨-, h⟩ | ⟨h, -, -⟩
      exacts [absurd h hx1, h, absurd h hx1]
    right; rw [hξ2 x hx1, h2 hx2]
  · filter_upwards [hA₁, hA₂, hS] with x h1 h2 hs
    by_cases hx1 : x ∈ R₁.carrier <;> by_cases hx2 : x ∈ R₂.carrier
    · rw [Set.indicator_of_mem hx1, Set.indicator_of_mem hx2, hs hx1 hx2, h1 hx1]
      have hdx' : ((d x : ℤ) : ℝ) = (R₁.mult x : ℝ) - (σ x : ℝ) * (R₂.mult x : ℝ) := by
        rw [hd x]; push_cast; ring
      by_cases hdx : d x = 0
      · rw [Set.indicator_of_notMem (fun h => by
          rcases (hC x).mp h with ⟨-, h⟩ | ⟨h, -⟩ | ⟨-, -, h⟩
          exacts [h hx2, h hx1, h hdx])]
        rw [hdx, Int.cast_zero] at hdx'
        ext α
        simp only [smul_apply, sub_apply, smul_eq_mul, zero_apply]
        linear_combination (η₁ x α) * hdx'
      · rw [Set.indicator_of_mem ((hC x).mpr (Or.inr (Or.inr ⟨hx1, hx2, hdx⟩))),
          hθ12 x hx1 hx2, hξ12 x hx1 hx2]
        have key : ((d x).natAbs : ℝ) * ((d x).sign : ℝ) = (d x : ℝ) := by
          have h := congrArg (fun z : ℤ => (z : ℝ)) (Int.sign_mul_natAbs (d x))
          simp only [Int.cast_mul, Int.cast_natCast] at h
          rw [mul_comm]; exact h
        ext α
        simp only [smul_apply, sub_apply, smul_eq_mul]
        linear_combination (η₁ x α) * (key.trans hdx')
    · rw [Set.indicator_of_mem hx1, Set.indicator_of_notMem hx2,
        Set.indicator_of_mem ((hC x).mpr (Or.inl ⟨hx1, hx2⟩)), hθ1 x hx1 hx2, hξ1 x hx1 hx2,
        h1 hx1]
      ext α; simp
    · rw [Set.indicator_of_notMem hx1, Set.indicator_of_mem hx2,
        Set.indicator_of_mem ((hC x).mpr (Or.inr (Or.inl ⟨hx1, hx2⟩))), hθ2 x hx1 hx2,
        hξ2 x hx1, h2 hx2]
      ext α; simp
    · rw [Set.indicator_of_notMem hx1, Set.indicator_of_notMem hx2,
        Set.indicator_of_notMem (fun h => by
          rcases (hC x).mp h with ⟨h, -⟩ | ⟨-, h⟩ | ⟨h, -, -⟩
          exacts [hx1 h, hx2 h, hx1 h])]
      ext α; simp
/-- Gluing two integer multiplicity triples `R₁ = (C₁, θ₁, ξ₁)` and `R₂ = (C₂, θ₂, ξ₂)` in `U`
along a Borel carrier `C ⊆ C₁ ∪ C₂`, with multiplicity `0 < θ ≤ 1_{C₁} θ₁ + 1_{C₂} θ₂` on `C` and
orientation `ξ = ±ξ₁` `Hⁿ`-a.e. on `C ∩ C₁`, `ξ = ±ξ₂` `Hⁿ`-a.e. on `C \ C₁`, gives a triple
`(C, θ, ξ)` in `U`, provided `Hⁿ`-a.e. point of `C ∩ C₁`, resp. `C \ C₁`, inherits the approximate
tangent spaces of `C₁`, resp. `C₂` (Simon Ch. 6, 3.1).

`C ⊆ C₁ ∪ C₂ ⊆ U` is countably rectifiable, `∫_{C ∩ K} θ dHⁿ ≤ ∫_{C₁ ∩ K} θ₁ dHⁿ +
∫_{C₂ ∩ K} θ₂ dHⁿ < ∞`, and on each of the pieces `C ∩ C₁` and `C \ C₁ ⊆ C₂`, which cover `C`,
the orientation condition of `R₁`, resp. `R₂`, passes to `(C, ξ)`: `T_x Cᵢ = Q` is transferred to
`T_x C = Q`, and `±` a unit orientation of `Q` is again one. -/
theorem Submission.regcomp_ims_imrep_of_signed_pieces : ∀ (P n : ℕ) (U C : Set (Euclid P)) (R₁ R₂ : IMRep U n) (θ : Euclid P → ℕ) (ξ : Euclid P → MultiVector P n), MeasurableSet C → C ⊆ R₁.carrier ∪ R₂.carrier → Measurable θ → (∀ x ∈ C, 0 < θ x) → (∀ x ∈ C, θ x ≤ R₁.carrier.indicator R₁.mult x + R₂.carrier.indicator R₂.mult x) → AEStronglyMeasurable ξ (μHE[n].restrict C) → (∀ᵐ x ∂(μHE[n].restrict (C ∩ R₁.carrier)), ξ x = R₁.orient x ∨ ξ x = -R₁.orient x) → (∀ᵐ x ∂(μHE[n].restrict (C \ R₁.carrier)), ξ x = R₂.orient x ∨ ξ x = -R₂.orient x) → (∀ᵐ x ∂(μHE[n].restrict (C ∩ R₁.carrier)), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n R₁.carrier x Q → HasApproximateTangentSpaceAt n C x Q) → (∀ᵐ x ∂(μHE[n].restrict (C \ R₁.carrier)), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n R₂.carrier x Q → HasApproximateTangentSpaceAt n C x Q) → ∃ R : IMRep U n, R.carrier = C ∧ R.mult = θ ∧ R.orient = ξ := by
  intro P n U C R₁ R₂ θ ξ hC hCsub hθ hpos hle hξ hsgn₁ hsgn₂ htan₁ htan₂
  have hC₁ := R₁.measurableSet_carrier
  have hC₂ := R₂.measurableSet_carrier
  -- Step 3: `C ⊆ C₁ ∪ C₂` is countably rectifiable
  have hrect : CountablyRectifiable n C := by
    refine (Poincare.SimonGMT.Chapter03.countablyRectifiable_iUnion
      (fun i : ℕ => if i = 0 then R₁.carrier else R₂.carrier) fun i => ?_).mono ?_
    · split_ifs
      exacts [R₁.rectifiable, R₂.rectifiable]
    · intro x hx
      rcases hCsub hx with h | h
      · exact mem_iUnion.2 ⟨0, by simpa using h⟩
      · exact mem_iUnion.2 ⟨1, by simpa using h⟩
  -- Step 5: `∫_{C ∩ K} θ ≤ ∫_K (1_{C₁} θ₁ + 1_{C₂} θ₂) = ∫_{C₁ ∩ K} θ₁ + ∫_{C₂ ∩ K} θ₂ < ∞`
  have hint : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
      ∫⁻ x in C ∩ K, (θ x : ℝ≥0∞) ∂μHE[n] ≠ ∞ := by
    intro K hK hKU
    have hθ₁ : Measurable fun x => (R₁.mult x : ℝ≥0∞) :=
      (measurable_from_nat (f := fun k : ℕ => (k : ℝ≥0∞))).comp R₁.measurable_mult
    refine ne_top_of_le_ne_top (ENNReal.add_ne_top.2
      ⟨R₁.locallyIntegrable_mult K hK hKU, R₂.locallyIntegrable_mult K hK hKU⟩) ?_
    calc ∫⁻ x in C ∩ K, (θ x : ℝ≥0∞) ∂μHE[n]
        ≤ ∫⁻ x in C ∩ K, (R₁.carrier.indicator (fun y => (R₁.mult y : ℝ≥0∞)) x
            + R₂.carrier.indicator (fun y => (R₂.mult y : ℝ≥0∞)) x) ∂μHE[n] := by
          refine setLIntegral_mono' (hC.inter hK.measurableSet) fun x hx => ?_
          have h := hle x hx.1
          simp only [Set.indicator] at h ⊢
          split_ifs at h ⊢ <;> exact_mod_cast h
      _ ≤ ∫⁻ x in K, (R₁.carrier.indicator (fun y => (R₁.mult y : ℝ≥0∞)) x
            + R₂.carrier.indicator (fun y => (R₂.mult y : ℝ≥0∞)) x) ∂μHE[n] :=
          lintegral_mono_set inter_subset_right
      _ = ∫⁻ x in R₁.carrier ∩ K, (R₁.mult x : ℝ≥0∞) ∂μHE[n]
            + ∫⁻ x in R₂.carrier ∩ K, (R₂.mult x : ℝ≥0∞) ∂μHE[n] := by
          rw [lintegral_add_left (hθ₁.indicator hC₁), lintegral_indicator hC₁,
            lintegral_indicator hC₂, Measure.restrict_restrict hC₁, Measure.restrict_restrict hC₂]
  -- Step 7(a): `w = ±v` is a unit orientation of `Q` whenever `v` is
  have hsign : ∀ (v w : MultiVector P n) (Q : Submodule ℝ (Euclid P)),
      IsUnitOrientationOf v Q → (w = v ∨ w = -v) → IsUnitOrientationOf w Q := by
    rintro v w Q ⟨τ, hτ, hspan, hv⟩ hw
    refine ⟨τ, hτ, hspan, ?_⟩
    rcases hw with rfl | rfl
    · exact hv
    · rcases hv with hv | hv
      · exact Or.inr fun α => by simp [hv α]
      · exact Or.inl fun α => by simp [hv α]
  -- Step 7(b): on `C ∩ C₁`, from `R₁.orients`
  have hor₁ : ∀ᵐ x ∂(μHE[n].restrict (C ∩ R₁.carrier)), ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n C x Q ∧ IsUnitOrientationOf (ξ x) Q := by
    filter_upwards [ae_restrict_of_ae_restrict_of_subset
      (inter_subset_right : C ∩ R₁.carrier ⊆ R₁.carrier) R₁.orients, hsgn₁, htan₁]
      with x hx hxs hxt
    obtain ⟨Q, hQ, hξQ⟩ := hx
    exact ⟨Q, hxt Q hQ, hsign _ _ Q hξQ hxs⟩
  -- Step 7(c): on `C \ C₁ ⊆ C₂`, from `R₂.orients`
  have hsub₂ : C \ R₁.carrier ⊆ R₂.carrier := fun x hx => (hCsub hx.1).resolve_left hx.2
  have hor₂ : ∀ᵐ x ∂(μHE[n].restrict (C \ R₁.carrier)), ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n C x Q ∧ IsUnitOrientationOf (ξ x) Q := by
    filter_upwards [ae_restrict_of_ae_restrict_of_subset hsub₂ R₂.orients, hsgn₂, htan₂]
      with x hx hxs hxt
    obtain ⟨Q, hQ, hξQ⟩ := hx
    exact ⟨Q, hxt Q hQ, hsign _ _ Q hξQ hxs⟩
  -- Step 7(d): the pieces cover `C`; rewrite only the measure, since `C` also occurs in `T_x C`
  have hor : ∀ᵐ x ∂(μHE[n].restrict C), ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n C x Q ∧ IsUnitOrientationOf (ξ x) Q := by
    have h := (ae_restrict_union_iff (C ∩ R₁.carrier) (C \ R₁.carrier) _).2 ⟨hor₁, hor₂⟩
    rwa [Set.inter_union_sdiff] at h
  -- Step 8: assemble `R = (C, θ, ξ)`
  exact ⟨IMRep.mk C θ ξ hC (hCsub.trans (union_subset R₁.carrier_subset R₂.carrier_subset))
    hrect hθ hpos hint hξ hor, rfl, rfl, rfl⟩
/-- **Simon Ch. 6, Remark 3.2(1)** (the representation step): if `1_M θ ξ = p₁ 1_{M₁} θ₁ ξ₁ +
p₂ 1_{M₂} θ₂ ξ₂` holds `Hⁿ`-a.e., then `τ(M, θ, ξ)(ω) = p₁ τ(M₁, θ₁, ξ₁)(ω) + p₂ τ(M₂, θ₂, ξ₂)(ω)`
for every `ω ∈ 𝒟ⁿ(U)`.  A unit orientation has `|⟨α, ξ⟩| ≤ ‖α‖`, so on each carrier `θ⟨ω, ξ⟩` is
dominated by `sup ‖ω‖ · θ 1_{spt ω}`, integrable by local integrability of `θ`.  Thus each action
is `∫ ⟨ω, 1_M θ ξ⟩ dHⁿ` with an integrable integrand, and the identity integrates linearly. -/
theorem Submission.rsdic_imrep_action_int_combination : ∀ (P n : ℕ) (U : Set (Euclid P)) (R₁ R₂ R : IMRep U n) (p₁ p₂ : ℤ), (∀ᵐ x ∂μHE[n], R.carrier.indicator (fun y => (R.mult y : ℝ) • R.orient y) x = (p₁ : ℝ) • R₁.carrier.indicator (fun y => (R₁.mult y : ℝ) • R₁.orient y) x + (p₂ : ℝ) • R₂.carrier.indicator (fun y => (R₂.mult y : ℝ) • R₂.orient y) x) → ∀ ω : TestFormOn U n, R.action (ω : DifferentialForm (Euclid P) n) = (p₁ : ℝ) * R₁.action (ω : DifferentialForm (Euclid P) n) + (p₂ : ℝ) * R₂.action (ω : DifferentialForm (Euclid P) n) := by
  intro P n U R₁ R₂ R p₁ p₂ hF ω
  -- `ω` is continuous, bounded by `W`, and supported in the compact `K = spt ω ⊆ U`
  obtain ⟨⟨hsmooth, hcpt⟩, hωU⟩ := ω.2
  have hωc : Continuous (ω : DifferentialForm (Euclid P) n) := ContDiff.continuous hsmooth
  obtain ⟨W, hW⟩ := hωc.bounded_above_of_compact_support hcpt
  -- Step 1: a unit orientation `ξ = ±τ₁ ∧ ⋯ ∧ τₙ` has `|ξ(α)| = |α(τ)| ≤ ‖α‖ ∏ᵢ ‖τᵢ‖ = ‖α‖`
  have hunit : ∀ (ξ : MultiVector P n) (Q : Submodule ℝ (Euclid P)), IsUnitOrientationOf ξ Q →
      ∀ α : Covector (Euclid P) n, ‖ξ α‖ ≤ ‖α‖ := by
    rintro ξ Q ⟨τ, hτ, -, hξ⟩ α
    have h : ‖α τ‖ ≤ ‖α‖ := by
      calc ‖α τ‖ ≤ ‖α‖ * ∏ i, ‖τ i‖ := α.le_opNorm τ
        _ = ‖α‖ := by simp [hτ.norm_eq_one]
    rcases hξ with h' | h'
    · rw [h' α]; exact h
    · rw [h' α, norm_neg]; exact h
  -- Steps 2–3: for every `R' = (M', θ', ξ')`, `x ↦ (1_{M'} θ' ξ')(x)(ω(x))` is integrable with
  -- integral `τ(R')(ω)`
  have key : ∀ R' : IMRep U n,
      Integrable (fun x => R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x
        ((ω : DifferentialForm (Euclid P) n) x)) μHE[n] ∧
      ∫ x, R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x
        ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n] =
        R'.action (ω : DifferentialForm (Euclid P) n) := by
    intro R'
    have hfun : (fun x => R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x
        ((ω : DifferentialForm (Euclid P) n) x)) = R'.carrier.indicator
          (fun y => (R'.mult y : ℝ) * R'.orient y ((ω : DifferentialForm (Euclid P) n) y)) := by
      funext x
      by_cases hx : x ∈ R'.carrier
      · simp [Set.indicator_of_mem hx]
      · simp [Set.indicator_of_notMem hx]
    rw [hfun, integrable_indicator_iff R'.measurableSet_carrier,
      integral_indicator R'.measurableSet_carrier]
    refine ⟨?_, rfl⟩
    -- `θ'⟨ω, ξ'⟩` is a.e. strongly measurable: `(L, α) ↦ L(α)` is continuous
    have hmult : Measurable fun y => (R'.mult y : ℝ) := measurable_from_nat.comp R'.measurable_mult
    have hev : Continuous fun p : MultiVector P n × Covector (Euclid P) n => p.1 p.2 :=
      continuous_fst.clm_apply continuous_snd
    have hmeas : AEStronglyMeasurable
        (fun y => (R'.mult y : ℝ) * R'.orient y ((ω : DifferentialForm (Euclid P) n) y))
        (μHE[n].restrict R'.carrier) :=
      hmult.aestronglyMeasurable.mul (hev.comp_aestronglyMeasurable
        (R'.aestronglyMeasurable_orient.prodMk hωc.aestronglyMeasurable))
    -- the dominating function `W θ' 1_K` is integrable on `M'`, as `∫_{M' ∩ K} θ' dHⁿ < ∞`
    have hKm : MeasurableSet (tsupport (ω : DifferentialForm (Euclid P) n)) :=
      (isClosed_tsupport _).measurableSet
    have hint : Integrable (fun y => W * (tsupport (ω : DifferentialForm (Euclid P) n)).indicator
        (fun y => (R'.mult y : ℝ)) y) (μHE[n].restrict R'.carrier) := by
      refine Integrable.const_mul ?_ W
      rw [integrable_indicator_iff hKm, IntegrableOn, Measure.restrict_restrict hKm]
      have h := integrable_toReal_of_lintegral_ne_top
        (μ := μHE[n].restrict (tsupport (ω : DifferentialForm (Euclid P) n) ∩ R'.carrier))
        (f := fun y => (R'.mult y : ℝ≥0∞))
        (measurable_from_nat.comp R'.measurable_mult).aemeasurable
        (by rw [Set.inter_comm]; exact R'.locallyIntegrable_mult _ hcpt hωU)
      simpa using h
    refine hint.mono' hmeas ?_
    filter_upwards [R'.orients] with y hyQ
    obtain ⟨Q, -, hQ⟩ := hyQ
    by_cases hy : y ∈ tsupport (ω : DifferentialForm (Euclid P) n)
    · rw [Set.indicator_of_mem hy]
      calc ‖(R'.mult y : ℝ) * R'.orient y ((ω : DifferentialForm (Euclid P) n) y)‖
          = (R'.mult y : ℝ) * ‖R'.orient y ((ω : DifferentialForm (Euclid P) n) y)‖ := by
            rw [norm_mul, Real.norm_natCast]
        _ ≤ (R'.mult y : ℝ) * ‖(ω : DifferentialForm (Euclid P) n) y‖ :=
            mul_le_mul_of_nonneg_left (hunit _ _ hQ _) (Nat.cast_nonneg _)
        _ ≤ (R'.mult y : ℝ) * W := mul_le_mul_of_nonneg_left (hW y) (Nat.cast_nonneg _)
        _ = W * (R'.mult y : ℝ) := mul_comm _ _
    · rw [Set.indicator_of_notMem hy, image_eq_zero_of_notMem_tsupport hy, map_zero, mul_zero,
        norm_zero, mul_zero]
  -- Step 4: integrate the a.e. identity evaluated at `ω(x)`, using linearity of the integral
  obtain ⟨-, he⟩ := key R
  obtain ⟨hi₁, he₁⟩ := key R₁
  obtain ⟨hi₂, he₂⟩ := key R₂
  rw [← he, ← he₁, ← he₂, ← integral_const_mul, ← integral_const_mul,
    ← integral_add (hi₁.const_mul _) (hi₂.const_mul _)]
  refine integral_congr_ae ?_
  filter_upwards [hF] with x hx
  rw [hx, add_apply, smul_apply, smul_apply, smul_eq_mul, smul_eq_mul]
/-- **Upper density theorem for `Hⁿ` off a Borel set of finite measure** (Simon Ch. 1, 3.3 and
3.6, with the crude covering constant `6ⁿ`; chapter-01.txt lines 602–721).  If `S ⊆ ℝᴾ` is Borel
with `Hⁿ(S) < ∞`, then for `Hⁿ`-a.e. `x ∉ S`, `Hⁿ(S ∩ B̄_ρ(x)) / ρⁿ → 0` as `ρ ↓ 0`.  A failure
at `x` puts `x` in a threshold set `{x ∉ S : Hⁿ(S ∩ B̄_ρ(x)) > t ρⁿ frequently as ρ ↓ 0}` with
`t = (k + 1)⁻¹`.  Vitali's lemma (factor `2`, enlarged radius `3ρ`) and separability give
`t · μH[n](E) ≤ 6ⁿ Hⁿ(G)` whenever each `x ∈ E` has arbitrarily small `ρ` with
`t ρⁿ ≤ Hⁿ(G ∩ B̄_ρ(x))`.  Taking `G = S \ F` for a closed `F ⊆ S` with `Hⁿ(S \ F)` small (weak
regularity of the finite measure `Hⁿ⌞S`), which agrees with `S` near `x ∉ F`, every threshold set
is `μH[n]`-null, hence `Hⁿ`-null. -/
theorem Submission.regcomp_atl_upper_density_zero : ∀ (P n : ℕ) (S : Set (Euclid P)), MeasurableSet S → μHE[n] S ≠ ∞ → ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)), x ∉ S → Tendsto (fun ρ : ℝ => μHE[n] (S ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n) (𝓝[>] 0) (𝓝 0) := by
  intro P n S hS hfin
  -- Step 2, Vitali selection (Simon 1.3.4): a countable disjoint subfamily whose
  -- 3-fold enlargements cover the centres.
  have vitali : ∀ (E : Set (Euclid P)) (p : Euclid P → ℝ → Prop) (δ : ℝ),
      (∀ x ∈ E, ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ ∧ p x ρ) →
      ∃ u : Set (Euclid P × ℝ), u.Countable ∧ (∀ a ∈ u, a.1 ∈ E ∧ 0 < a.2 ∧ a.2 < δ ∧ p a.1 a.2) ∧
        u.PairwiseDisjoint (fun a => closedBall a.1 a.2) ∧
        E ⊆ ⋃ a ∈ u, closedBall a.1 (3 * a.2) := by
    intro E p δ hE
    obtain ⟨u, huT, hdisj, hcov⟩ := Vitali.exists_disjoint_subfamily_covering_enlargement
      (fun a : Euclid P × ℝ => closedBall a.1 a.2)
      {a : Euclid P × ℝ | a.1 ∈ E ∧ 0 < a.2 ∧ a.2 < δ ∧ p a.1 a.2} (fun a => a.2) 2 (by norm_num)
      (fun a ha => ha.2.1.le) δ (fun a ha => ha.2.2.1.le)
      (fun a ha => nonempty_closedBall.2 ha.2.1.le)
    refine ⟨u, ?_, fun a ha => huT ha, hdisj, ?_⟩
    · apply hdisj.countable_of_nonempty_interior
      intro a ha
      refine ⟨a.1, interior_mono ball_subset_closedBall ?_⟩
      rw [isOpen_ball.interior_eq]
      exact mem_ball_self (huT ha).2.1
    · intro x hx
      obtain ⟨ρ, hρ0, hρδ, hp⟩ := hE x hx
      obtain ⟨b, hbu, ⟨w, hw1, hw2⟩, hle⟩ := hcov (x, ρ) ⟨hx, hρ0, hρδ, hp⟩
      refine mem_iUnion₂.2 ⟨b, hbu, ?_⟩
      rw [mem_closedBall]
      have h1 : dist w x ≤ ρ := hw1
      have h2 : dist w b.1 ≤ b.2 := hw2
      have hle' : ρ ≤ 2 * b.2 := hle
      calc dist x b.1 ≤ dist x w + dist w b.1 := dist_triangle _ _ _
        _ ≤ ρ + b.2 := add_le_add (by rw [dist_comm]; exact h1) h2
        _ ≤ 3 * b.2 := by linarith
  -- Step 2, comparison (Simon 1.3.3 with the crude constant 6 ^ n).
  have comparison : ∀ (t : ℝ≥0∞) (E G : Set (Euclid P)), t ≠ 0 → t ≠ ∞ → MeasurableSet G →
      (∀ x ∈ E, ∀ δ : ℝ, 0 < δ → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ ∧
        t * ENNReal.ofReal ρ ^ n ≤ μHE[n] (G ∩ closedBall x ρ)) →
      t * μH[(n : ℝ)] E ≤ 6 ^ n * μHE[n] G := by
    intro t E G ht0 httop hG hE
    have hfam : ∀ j : ℕ, ∃ u : Set (Euclid P × ℝ), u.Countable ∧
        (∀ a ∈ u, a.1 ∈ E ∧ 0 < a.2 ∧ a.2 < 1 / ((j : ℝ) + 1) ∧
          t * ENNReal.ofReal a.2 ^ n ≤ μHE[n] (G ∩ closedBall a.1 a.2)) ∧
        u.PairwiseDisjoint (fun a => closedBall a.1 a.2) ∧
        E ⊆ ⋃ a ∈ u, closedBall a.1 (3 * a.2) :=
      fun j => vitali E (fun c ρ => t * ENNReal.ofReal ρ ^ n ≤ μHE[n] (G ∩ closedBall c ρ))
        (1 / ((j : ℝ) + 1)) (fun x hx => hE x hx _ (by positivity))
    choose u hucount hu hdisj hcover using hfam
    have : ∀ j, Countable (u j) := fun j => (hucount j).to_subtype
    -- packing estimate
    have hsum : ∀ j, t * ∑' a : u j, ENNReal.ofReal (a : Euclid P × ℝ).2 ^ n ≤ μHE[n] G := by
      intro j
      rw [← ENNReal.tsum_mul_left]
      calc ∑' a : u j, t * ENNReal.ofReal (a : Euclid P × ℝ).2 ^ n
          ≤ ∑' a : u j, μHE[n] (G ∩ closedBall (a : Euclid P × ℝ).1 (a : Euclid P × ℝ).2) :=
            ENNReal.tsum_le_tsum fun a => (hu j a a.2).2.2.2
        _ = μHE[n] (⋃ a ∈ u j, G ∩ closedBall a.1 a.2) :=
            (measure_biUnion (hucount j) ((hdisj j).mono fun a => inter_subset_right)
              fun a _ => hG.inter measurableSet_closedBall).symm
        _ ≤ μHE[n] G := measure_mono (iUnion₂_subset fun a _ => inter_subset_left)
    -- diameter estimate
    have hdiam : ∀ j (a : u j), ediam (closedBall (a : Euclid P × ℝ).1 (3 * (a : Euclid P × ℝ).2))
        ≤ ENNReal.ofReal (6 * (a : Euclid P × ℝ).2) := by
      intro j a
      apply ediam_le_of_forall_dist_le
      intro y hy z hz
      rw [mem_closedBall] at hy hz
      calc dist y z ≤ dist y (a : Euclid P × ℝ).1 + dist z (a : Euclid P × ℝ).1 :=
            dist_triangle_right _ _ _
        _ ≤ 6 * (a : Euclid P × ℝ).2 := by linarith
    have hterm : ∀ j, t * ∑' a : u j,
        ediam (closedBall (a : Euclid P × ℝ).1 (3 * (a : Euclid P × ℝ).2)) ^ (n : ℝ) ≤
          6 ^ n * μHE[n] G := by
      intro j
      calc t * ∑' a : u j, ediam (closedBall (a : Euclid P × ℝ).1 (3 * (a : Euclid P × ℝ).2)) ^ (n : ℝ)
          ≤ t * ∑' a : u j, 6 ^ n * ENNReal.ofReal (a : Euclid P × ℝ).2 ^ n := by
            gcongr with a
            rw [ENNReal.rpow_natCast]
            calc ediam (closedBall (a : Euclid P × ℝ).1 (3 * (a : Euclid P × ℝ).2)) ^ n
                ≤ ENNReal.ofReal (6 * (a : Euclid P × ℝ).2) ^ n := by gcongr; exact hdiam j a
              _ = 6 ^ n * ENNReal.ofReal (a : Euclid P × ℝ).2 ^ n := by
                rw [ENNReal.ofReal_mul (show (0 : ℝ) ≤ 6 by norm_num), mul_pow]
                norm_num
        _ = 6 ^ n * (t * ∑' a : u j, ENNReal.ofReal (a : Euclid P × ℝ).2 ^ n) := by
            rw [ENNReal.tsum_mul_left]; ring
        _ ≤ 6 ^ n * μHE[n] G := by gcongr; exact hsum j
    have hH := MeasureTheory.Measure.hausdorffMeasure_le_liminf_tsum (X := Euclid P)
      (ι := fun j => (u j)) (n : ℝ) E (l := atTop)
      (fun j : ℕ => ENNReal.ofReal (6 * (1 / ((j : ℝ) + 1))))
      (by
        rw [← ENNReal.ofReal_zero]
        apply ENNReal.tendsto_ofReal
        have := tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)
        simpa using this.const_mul 6)
      (fun j a => closedBall (a : Euclid P × ℝ).1 (3 * (a : Euclid P × ℝ).2))
      (Eventually.of_forall fun j a => (hdiam j a).trans (ENNReal.ofReal_le_ofReal (by
        have := (hu j a a.2).2.2.1
        linarith)))
      (Eventually.of_forall fun j x hx => by
        obtain ⟨a, ha, hxa⟩ := mem_iUnion₂.1 (hcover j hx)
        exact mem_iUnion.2 ⟨⟨a, ha⟩, hxa⟩)
    have hbound : ∀ j, ∑' a : u j,
        ediam (closedBall (a : Euclid P × ℝ).1 (3 * (a : Euclid P × ℝ).2)) ^ (n : ℝ) ≤
          6 ^ n * μHE[n] G / t := by
      intro j
      rw [ENNReal.le_div_iff_mul_le (Or.inl ht0) (Or.inl httop), mul_comm]
      exact hterm j
    have hlim : μH[(n : ℝ)] E ≤ 6 ^ n * μHE[n] G / t :=
      hH.trans (liminf_le_of_frequently_le' (Frequently.of_forall hbound))
    calc t * μH[(n : ℝ)] E ≤ t * (6 ^ n * μHE[n] G / t) := by gcongr
      _ = 6 ^ n * μHE[n] G := ENNReal.mul_div_cancel ht0 httop
  -- Step 3, each threshold set is null (Simon 1.3.6).
  have threshold : ∀ t : ℝ≥0∞, t ≠ 0 → t ≠ ∞ →
      μHE[n] {x : Euclid P | x ∉ S ∧ ∃ᶠ ρ in 𝓝[>] (0 : ℝ),
        t < μHE[n] (S ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n} = 0 := by
    intro t ht0 httop
    set N := {x : Euclid P | x ∉ S ∧ ∃ᶠ ρ in 𝓝[>] (0 : ℝ),
      t < μHE[n] (S ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n} with hN
    have key : ∀ ε : ℝ≥0∞, ε ≠ 0 → μH[(n : ℝ)] N < ε := by
      intro ε hε
      have : IsFiniteMeasure ((μHE[n] : Measure (Euclid P)).restrict S) :=
        ⟨by rw [Measure.restrict_apply_univ]; exact hfin.lt_top⟩
      have : ((μHE[n] : Measure (Euclid P)).restrict S).WeaklyRegular :=
        Measure.WeaklyRegular.of_pseudoMetrizableSpace_of_isFiniteMeasure _
      have hpos : t * ε / 6 ^ n ≠ 0 := by
        apply ENNReal.div_ne_zero.2
        exact ⟨mul_ne_zero ht0 hε, ENNReal.pow_ne_top (by norm_num)⟩
      obtain ⟨F, hFS, hFc, hFlt⟩ := hS.exists_isClosed_sdiff_lt
        (μ := (μHE[n] : Measure (Euclid P)).restrict S)
        (by rw [Measure.restrict_apply hS, inter_self]; exact hfin) hpos
      have hG : MeasurableSet (S \ F) := hS.diff hFc.measurableSet
      have hμG : μHE[n] (S \ F) < t * ε / 6 ^ n := by
        rwa [Measure.restrict_apply hG, inter_eq_left.2 sdiff_subset] at hFlt
      have hhyp : ∀ x ∈ N, ∀ δ : ℝ, 0 < δ → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ ∧
          t * ENNReal.ofReal ρ ^ n ≤ μHE[n] ((S \ F) ∩ closedBall x ρ) := by
        intro x hx δ hδ
        obtain ⟨hxS, hfreq⟩ := hx
        have hxF : x ∉ F := fun h => hxS (hFS h)
        obtain ⟨r₁, hr₁, hball⟩ := Metric.isOpen_iff.1 hFc.isOpen_compl x hxF
        have hev : ∀ᶠ ρ in 𝓝[>] (0 : ℝ), ρ ∈ Ioo 0 (min δ (r₁ / 2)) :=
          Ioo_mem_nhdsGT (by positivity)
        obtain ⟨ρ, hρq, hρ⟩ := (hfreq.and_eventually hev).exists
        refine ⟨ρ, hρ.1, lt_of_lt_of_le hρ.2 (min_le_left _ _), ?_⟩
        have hρpos : ENNReal.ofReal ρ ^ n ≠ 0 :=
          pow_ne_zero _ (ENNReal.ofReal_pos.2 hρ.1).ne'
        have hρtop : ENNReal.ofReal ρ ^ n ≠ ∞ := ENNReal.pow_ne_top ENNReal.ofReal_ne_top
        have h1 : t * ENNReal.ofReal ρ ^ n < μHE[n] (S ∩ closedBall x ρ) :=
          (ENNReal.lt_div_iff_mul_lt (Or.inl hρpos) (Or.inl hρtop)).1 hρq
        have h2 : S ∩ closedBall x ρ = (S \ F) ∩ closedBall x ρ := by
          ext y
          constructor
          · rintro ⟨hyS, hyB⟩
            refine ⟨⟨hyS, fun hyF => hball ?_ hyF⟩, hyB⟩
            rw [mem_ball]
            have := mem_closedBall.1 hyB
            have := hρ.2
            have := min_le_right δ (r₁ / 2)
            linarith
          · rintro ⟨⟨hyS, _⟩, hyB⟩
            exact ⟨hyS, hyB⟩
        rw [← h2]
        exact h1.le
      have hcomp := comparison t N (S \ F) ht0 httop hG hhyp
      have h6 : (6 : ℝ≥0∞) ^ n ≠ 0 := pow_ne_zero _ (by norm_num)
      have h6' : (6 : ℝ≥0∞) ^ n ≠ ∞ := ENNReal.pow_ne_top (by norm_num)
      have hlt : t * μH[(n : ℝ)] N < t * ε := by
        calc t * μH[(n : ℝ)] N ≤ 6 ^ n * μHE[n] (S \ F) := hcomp
          _ < 6 ^ n * (t * ε / 6 ^ n) := ENNReal.mul_lt_mul_right h6 h6' hμG
          _ = t * ε := ENNReal.mul_div_cancel h6 h6'
      exact (ENNReal.mul_lt_mul_iff_right ht0 httop).1 hlt
    have hH : μH[(n : ℝ)] N = 0 := by
      by_contra h
      exact lt_irrefl _ (key _ h)
    rw [Measure.euclideanHausdorffMeasure_def, Measure.smul_apply, hH, smul_zero]
  -- Steps 1 and 4, every failure of convergence lies in a threshold set.
  rw [ae_iff]
  apply measure_mono_null (t := ⋃ k : ℕ, {x : Euclid P | x ∉ S ∧ ∃ᶠ ρ in 𝓝[>] (0 : ℝ),
    ((k : ℝ≥0∞) + 1)⁻¹ < μHE[n] (S ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n})
  · intro x hx
    simp only [mem_ofPred_eq, Classical.not_imp] at hx
    obtain ⟨hxS, hnt⟩ := hx
    rw [ENNReal.tendsto_nhds_zero] at hnt
    push Not at hnt
    obtain ⟨ε, hε, hfreq⟩ := hnt
    obtain ⟨k, hk⟩ := ENNReal.exists_inv_nat_lt hε.ne'
    refine mem_iUnion.2 ⟨k, hxS, hfreq.mono fun ρ hρ => ?_⟩
    calc ((k : ℝ≥0∞) + 1)⁻¹ ≤ (k : ℝ≥0∞)⁻¹ := ENNReal.inv_le_inv.2 le_self_add
      _ < ε := hk
      _ < _ := hρ
  · exact measure_iUnion_null fun k => threshold _ (by simp) (by simp)

/-- **Upper density theorem for `Hⁿ` off a Borel set of locally finite measure in an open set**
(Simon Ch. 1, 3.6 and Remark 3.7(2); chapter-01.txt lines 700–711).  If `U ⊆ ℝᴾ` is open and
`S ⊆ ℝᴾ` is Borel with `Hⁿ(S ∩ K) < ∞` for every compact `K ⊆ U`, then for `Hⁿ`-a.e.
`x ∈ U \ S`, `Hⁿ(S ∩ B̄_ρ(x)) / ρⁿ → 0` as `ρ ↓ 0`.  Countably many balls `B(y, r_y)` with
`B̄(y, r_y) ⊆ U` cover `U` (Lindelöf); the upper density theorem applies to each piece
`S ∩ B(y, r_y)`, of finite measure, and the piece agrees with `S` on small balls about
`x ∈ B(y, r_y)`. -/
theorem Submission.doraggt_local_density_zero : ∀ (P n : ℕ) (U S : Set (Euclid P)), IsOpen U → MeasurableSet S → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (S ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)), x ∈ U → x ∉ S → Tendsto (fun ρ : ℝ => μHE[n] (S ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n) (𝓝[>] 0) (𝓝 0) := by
  intro P n U S hU hS hfin
  -- Step 1, a countable cover of `U` by balls `B(y, r y)` with `B̄(y, r y) ⊆ U` (Lindelöf).
  have hrad : ∀ y ∈ U, ∃ r : ℝ, 0 < r ∧ closedBall y r ⊆ U := by
    intro y hy
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hU y hy
    exact ⟨ε / 2, half_pos hε, (closedBall_subset_ball (half_lt_self hε)).trans hball⟩
  choose! r hr0 hrU using hrad
  obtain ⟨D, hDU, hDc, hcover⟩ := TopologicalSpace.countable_cover_nhdsWithin
    (f := fun y => ball y (r y)) (s := U)
    (fun y hy => mem_nhdsWithin_of_mem_nhds (ball_mem_nhds y (hr0 y hy)))
  -- Steps 2 and 3, the upper density theorem for each finite-measure piece `S ∩ B(y, r y)`,
  -- simultaneously for the countably many `y ∈ D`.
  have hae : ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)), ∀ y ∈ D, x ∉ S ∩ ball y (r y) →
      Tendsto (fun ρ : ℝ => μHE[n] ((S ∩ ball y (r y)) ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n)
        (𝓝[>] 0) (𝓝 0) := by
    rw [ae_ball_iff hDc]
    intro y hy
    refine Submission.regcomp_atl_upper_density_zero P n _ (hS.inter measurableSet_ball) ?_
    exact ne_top_of_le_ne_top (hfin _ (isCompact_closedBall y (r y)) (hrU y (hDU hy)))
      (measure_mono (inter_subset_inter_right _ ball_subset_closedBall))
  -- Step 4, near `x ∈ B(y, r y)` the piece and `S` agree.
  filter_upwards [hae] with x hx hxU hxS
  obtain ⟨y, hyD, hxy⟩ := mem_iUnion₂.1 (hcover hxU)
  obtain ⟨ε, hε, hεball⟩ := Metric.isOpen_iff.1 isOpen_ball x hxy
  refine (hx y hyD fun h => hxS h.1).congr' ?_
  filter_upwards [Ioo_mem_nhdsGT hε] with ρ hρ
  rw [inter_assoc, inter_eq_right.2 ((closedBall_subset_ball hρ.2).trans hεball)]
/-- Asymptotically equal blow-up integrals give equal approximate tangent spaces (Simon Ch. 3,
Definition 1.4; last step of the proof of 3.1.6).  With `η_r = η_{x,r}`, `I(r) = ∫_{η_r(M)} f dHⁿ`,
`I'(r) = ∫_{η_r(M')} f dHⁿ` and `I(r) − I'(r) → 0` as `r ↓ 0` for every `f ∈ C_c(ℝᴾ)`:
`I' = I − (I − I')` and `I = I' + (I − I')` have the same limit `∫_Q f dHⁿ` as `I`, resp. `I'`,
while the condition `dim Q = n` does not involve `M`, `M'`. -/
theorem Submission.regcomp_atl_pc_tangent_iff_of_integral_sub_tendsto : ∀ (P n : ℕ) (M M' : Set (Euclid P)) (x : Euclid P), (∀ f : CompactlySupportedContinuousMap (Euclid P) ℝ, Tendsto (fun r : ℝ => (∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, f y ∂μHE[n]) - ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M', f y ∂μHE[n]) (𝓝[>] 0) (𝓝 0)) → ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q := by
  intro P n M M' x hD Q
  constructor
  · -- (⇒) `I' = I − (I − I') → L − 0 = L`
    rintro ⟨hQ, hM⟩
    refine ⟨hQ, fun f => ?_⟩
    have h := (hM f).sub (hD f)
    rw [sub_zero] at h
    exact h.congr fun r => sub_sub_cancel _ _
  · -- (⇐) `I = I' + (I − I') → L + 0 = L`
    rintro ⟨hQ, hM'⟩
    refine ⟨hQ, fun f => ?_⟩
    have h := (hM' f).add (hD f)
    rw [add_zero] at h
    exact h.congr fun r => add_sub_cancel _ _
/-- **Upper density theorem for `Hⁿ` off a Borel set of locally finite measure in `U`** (Simon
Ch. 1, Remark 3.7(2); chapter-01.txt lines 705–711).  If `U ⊆ ℝᴾ` is open and `S` is Borel with
`Hⁿ(S ∩ K) < ∞` for every compact `K ⊆ U`, then for `Hⁿ`-a.e. `x ∈ U ∖ S`,
`Hⁿ(S ∩ B̄_ρ(x)) / ρⁿ → 0` as `ρ ↓ 0`.  Countably many balls `B_{r_y}(y)` with
`B̄_{r_y}(y) ⊆ U` cover `U` (Lindelöf); the finite-measure version applies to each piece
`S ∩ B_{r_y}(y)`, and near `x ∈ B_{r_y}(y)` the piece agrees with `S`. -/
theorem Submission.regcomp_atl_local_density_zero : ∀ (P n : ℕ) (U S : Set (Euclid P)), IsOpen U → MeasurableSet S → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (S ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)), x ∈ U → x ∉ S → Tendsto (fun ρ : ℝ => μHE[n] (S ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n) (𝓝[>] 0) (𝓝 0) := by
  intro P n U S hU hS hfin
  -- Step 1, a countable cover of `U` by balls `B(y, r y)` with `B̄(y, r y) ⊆ U`.
  have hr : ∀ x ∈ U, ∃ r : ℝ, 0 < r ∧ closedBall x r ⊆ U := by
    intro x hx
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hU x hx
    exact ⟨ε / 2, half_pos hε, (closedBall_subset_ball (half_lt_self hε)).trans hball⟩
  choose! r hr0 hrU using hr
  obtain ⟨D, hDU, hDc, hcov⟩ := TopologicalSpace.countable_cover_nhdsWithin
    (f := fun y => ball y (r y)) (s := U)
    fun x hx => mem_nhdsWithin_of_mem_nhds (ball_mem_nhds x (hr0 x hx))
  -- Steps 2 and 3, the finite-measure theorem on each piece `S ∩ B(y, r y)`, simultaneously
  -- for the countably many `y ∈ D`.
  have hpiece : ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)), ∀ y ∈ D, x ∉ S ∩ ball y (r y) →
      Tendsto (fun ρ : ℝ => μHE[n] (S ∩ ball y (r y) ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n)
        (𝓝[>] 0) (𝓝 0) := by
    rw [ae_ball_iff hDc]
    intro y hy
    apply Submission.regcomp_atl_upper_density_zero P n _ (hS.inter measurableSet_ball)
    exact ne_top_of_le_ne_top (hfin _ (isCompact_closedBall y (r y)) (hrU y (hDU hy)))
      (measure_mono (inter_subset_inter_right S ball_subset_closedBall))
  -- Step 4, localization: for small `ρ`, `B̄(x, ρ) ⊆ B(y, r y)`, so the piece agrees with `S`.
  filter_upwards [hpiece] with x hx hxU hxS
  obtain ⟨y, hyD, hxy⟩ := mem_iUnion₂.1 (hcov hxU)
  obtain ⟨ε, hε, hεy⟩ := Metric.isOpen_iff.1 isOpen_ball x hxy
  refine (hx y hyD fun h => hxS h.1).congr' ?_
  filter_upwards [Ioo_mem_nhdsGT hε] with ρ hρ
  rw [inter_assoc, inter_eq_right.2 ((closedBall_subset_ball hρ.2).trans hεy)]
/-- Comparison of blow-up integrals (proof of Simon 3.1.6): for Borel `A ⊆ B`, `r > 0` and a
continuous `f` with `|f| ≤ C` vanishing off `B̄_R(0)`,
`|∫_{η_{x,r}(B)} f dHⁿ − ∫_{η_{x,r}(A)} f dHⁿ| ≤ C Hⁿ(η_{x,r}(B \ A) ∩ B̄_R(0))`.  Since `η_{x,r}` is
injective, `η_{x,r}(B)` is the disjoint union of `η_{x,r}(A)` and `η_{x,r}(B \ A)`, both Borel
(`η_{x,r}(T)` is the preimage of `T` under `y ↦ x + ry`); the difference of the integrals is the
integral over `η_{x,r}(B \ A)`, which equals the integral over `η_{x,r}(B \ A) ∩ B̄_R(0)`. -/
theorem Submission.regcomp_atl_pc_blowUp_setIntegral_sub_le : ∀ (P n : ℕ) (A B : Set (Euclid P)) (x : Euclid P) (r R C : ℝ) (f : Euclid P → ℝ), Continuous f → MeasurableSet A → MeasurableSet B → A ⊆ B → 0 < r → μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' B ∩ closedBall 0 R) ≠ ∞ → (∀ y : Euclid P, ‖f y‖ ≤ C) → (∀ y : Euclid P, y ∉ closedBall (0 : Euclid P) R → f y = 0) → ‖(∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' B, f y ∂μHE[n]) - ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' A, f y ∂μHE[n]‖ ≤ C * (μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' (B \ A) ∩ closedBall 0 R)).toReal := by
  intro P n A B x r R C f hf hA hB hAB hr hfin hC hzero
  -- Step 1: `η = η_{x,r}` is injective
  have hinj : Injective (Poincare.SimonGMT.Chapter03.blowUpMap x r : Euclid P → Euclid P) := by
    intro z w h
    have h' : z - x = w - x :=
      smul_right_injective (Euclid P) (inv_ne_zero hr.ne') h
    simpa using h'
  -- Step 2: `η(T) = g⁻¹(T)` for `g y = x + r • y`, so `η` maps Borel sets to Borel sets
  have himage : ∀ T : Set (Euclid P),
      Poincare.SimonGMT.Chapter03.blowUpMap x r '' T = (fun y : Euclid P => x + r • y) ⁻¹' T := by
    intro T
    ext y
    constructor
    · rintro ⟨z, hz, rfl⟩
      simpa [Poincare.SimonGMT.Chapter03.blowUpMap, smul_smul, mul_inv_cancel₀ hr.ne'] using hz
    · intro hy
      refine ⟨x + r • y, hy, ?_⟩
      simp [Poincare.SimonGMT.Chapter03.blowUpMap, smul_smul, inv_mul_cancel₀ hr.ne']
  have hmeas : ∀ T : Set (Euclid P), MeasurableSet T →
      MeasurableSet (Poincare.SimonGMT.Chapter03.blowUpMap x r '' T) := by
    intro T hT
    rw [himage T]
    exact (by fun_prop : Continuous fun y : Euclid P => x + r • y).measurable hT
  -- Step 3: `f` is integrable on `η(T)` for Borel `T ⊆ B`
  have hint : ∀ T : Set (Euclid P), MeasurableSet T → T ⊆ B →
      IntegrableOn f (Poincare.SimonGMT.Chapter03.blowUpMap x r '' T) μHE[n] := by
    intro T hT hTB
    have hfinT : μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' T ∩ closedBall 0 R) ≠ ∞ :=
      ne_top_of_le_ne_top hfin (measure_mono (inter_subset_inter_left _ (image_mono hTB)))
    exact (Measure.integrableOn_of_bounded hfinT hf.aestronglyMeasurable
      (Eventually.of_forall hC)).of_forall_sdiff_eq_zero (hmeas T hT)
      fun y hy => hzero y fun h => hy.2 ⟨hy.1, h⟩
  -- Step 4: `∫_{η(B)} f − ∫_{η(A)} f = ∫_{η(B∖A)} f`
  have hBA : MeasurableSet (B \ A) := hB.diff hA
  have hunion : ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' B, f y ∂μHE[n] =
      (∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' A, f y ∂μHE[n]) +
        ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' (B \ A), f y ∂μHE[n] := by
    rw [← setIntegral_union ((disjoint_image_iff hinj).mpr disjoint_sdiff_right) (hmeas _ hBA)
      (hint A hA hAB) (hint _ hBA sdiff_subset), ← image_union, union_sdiff_cancel hAB]
  -- Step 5: localization to `B̄_R(0)`
  have hloc : ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' (B \ A), f y ∂μHE[n] =
      ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' (B \ A) ∩ closedBall 0 R, f y ∂μHE[n] :=
    setIntegral_eq_of_subset_of_forall_sdiff_eq_zero (hmeas _ hBA) inter_subset_left
      fun y hy => hzero y fun h => hy.2 ⟨hy.1, h⟩
  -- Step 6: the estimate
  have hfinS : μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' (B \ A) ∩ closedBall 0 R) < ∞ :=
    (measure_mono (inter_subset_inter_left _ (image_mono sdiff_subset))).trans_lt hfin.lt_top
  rw [hunion, add_sub_cancel_left, hloc, ← measureReal_def]
  exact norm_setIntegral_le_of_norm_le_const hfinS fun y _ => hC y
/-- Rescaling a vanishing `n`-density quotient (the final limit in the proof of Simon 3.1.6): if
`g(ρ)/ρⁿ → 0` as `ρ ↓ 0` and `R > 0`, then `r⁻ⁿ g(rR) → 0` as `r ↓ 0`.  The substitution
`ρ = rR` maps `𝓝[>] 0` to itself, multiplying by the finite constant `Rⁿ` keeps the limit `0`,
and `Rⁿ · g(rR)/(rR)ⁿ = r⁻ⁿ g(rR)` for `r > 0`. -/
theorem Submission.regcomp_atl_pc_density_rescale_tendsto : ∀ (n : ℕ) (g : ℝ → ℝ≥0∞) (R : ℝ), 0 < R → Tendsto (fun ρ : ℝ => g ρ / ENNReal.ofReal ρ ^ n) (𝓝[>] 0) (𝓝 0) → Tendsto (fun r : ℝ => (ENNReal.ofReal r)⁻¹ ^ n * g (r * R)) (𝓝[>] 0) (𝓝 0) := by
  intro n g R hR hg
  -- Step 1: `r ↦ r * R` maps `𝓝[>] 0` to `𝓝[>] 0`
  have hmap : Tendsto (fun r : ℝ => r * R) (𝓝[>] 0) (𝓝[>] 0) := by
    refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ ?_ ?_
    · exact ((continuous_mul_const R).tendsto' 0 0 (zero_mul R)).mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with r (hr : 0 < r)
      exact mul_pos hr hR
  -- Step 2: `g (r * R) / ofReal (r * R) ^ n → 0`
  have hcomp : Tendsto (fun r : ℝ => g (r * R) / ENNReal.ofReal (r * R) ^ n) (𝓝[>] 0) (𝓝 0) :=
    hg.comp hmap
  -- Step 3: multiplication by the finite constant `ofReal R ^ n`
  have hbtop : ENNReal.ofReal R ^ n ≠ ∞ := ENNReal.pow_ne_top ENNReal.ofReal_ne_top
  have hconst : Tendsto
      (fun r : ℝ => ENNReal.ofReal R ^ n * (g (r * R) / ENNReal.ofReal (r * R) ^ n))
      (𝓝[>] 0) (𝓝 0) := by
    have h := ENNReal.Tendsto.const_mul hcomp (Or.inr hbtop)
    rwa [mul_zero] at h
  -- Step 4: for `r > 0`, `Rⁿ · g(rR)/(rR)ⁿ = r⁻ⁿ g(rR)`
  have heq : (fun r : ℝ => ENNReal.ofReal R ^ n * (g (r * R) / ENNReal.ofReal (r * R) ^ n))
      =ᶠ[𝓝[>] 0] fun r : ℝ => (ENNReal.ofReal r)⁻¹ ^ n * g (r * R) := by
    filter_upwards [self_mem_nhdsWithin] with r (hr : 0 < r)
    have ha0 : ENNReal.ofReal r ^ n ≠ 0 := ENNReal.pow_ne_zero (ENNReal.ofReal_pos.mpr hr).ne' n
    have hatop : ENNReal.ofReal r ^ n ≠ ∞ := ENNReal.pow_ne_top ENNReal.ofReal_ne_top
    have hb0 : ENNReal.ofReal R ^ n ≠ 0 := ENNReal.pow_ne_zero (ENNReal.ofReal_pos.mpr hR).ne' n
    calc ENNReal.ofReal R ^ n * (g (r * R) / ENNReal.ofReal (r * R) ^ n)
        = ENNReal.ofReal R ^ n *
            ((ENNReal.ofReal r ^ n)⁻¹ * (ENNReal.ofReal R ^ n)⁻¹ * g (r * R)) := by
          rw [ENNReal.ofReal_mul hr.le, mul_pow, ENNReal.div_eq_inv_mul,
            ENNReal.mul_inv (Or.inl ha0) (Or.inl hatop)]
      _ = ENNReal.ofReal R ^ n * (ENNReal.ofReal R ^ n)⁻¹ *
            ((ENNReal.ofReal r ^ n)⁻¹ * g (r * R)) := by ring
      _ = (ENNReal.ofReal r)⁻¹ ^ n * g (r * R) := by
          rw [ENNReal.mul_inv_cancel hb0 hbtop, one_mul, ENNReal.inv_pow]
  -- Step 5: the two functions agree eventually along `𝓝[>] 0`
  exact hconst.congr' heq
/-- Scaling of `Hⁿ` under the blow-up `η_{x,r}(z) = r⁻¹(z − x)`, `r > 0` (proof of Simon 3.1.6):
`Hⁿ(η_{x,r}(S) ∩ B̄_R(0)) = r⁻ⁿ Hⁿ(S ∩ B̄_{rR}(x))`.  Since `‖η_{x,r}(z)‖ = r⁻¹‖z − x‖`, the left
side is `Hⁿ(η_{x,r}(S ∩ B̄_{rR}(x)))`; `η_{x,r}` is the homothety of centre `x` and ratio `r⁻¹`
followed by the translation by `−x`, which preserves `Hⁿ`, while the homothety multiplies it by
`‖r⁻¹‖₊ⁿ = r⁻ⁿ`. -/
theorem Submission.regcomp_atl_blowUp_measure_scaling : ∀ (P n : ℕ) (x : Euclid P) (r R : ℝ) (S : Set (Euclid P)), 0 < r → μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' S ∩ closedBall 0 R) = (ENNReal.ofReal r)⁻¹ ^ n * μHE[n] (S ∩ closedBall x (r * R)) := by
  intro P n x r R S hr
  -- `‖η(z)‖ = r⁻¹‖z − x‖`
  have hnorm : ∀ z : Euclid P,
      ‖Poincare.SimonGMT.Chapter03.blowUpMap x r z‖ = r⁻¹ * ‖z - x‖ := by
    intro z
    rw [Poincare.SimonGMT.Chapter03.blowUpMap, norm_smul, Real.norm_eq_abs,
      abs_of_pos (inv_pos.mpr hr)]
  -- Step 1: `η(S) ∩ B̄(0, R) = η(S ∩ B̄(x, rR))`
  have hset : Poincare.SimonGMT.Chapter03.blowUpMap x r '' S ∩ closedBall 0 R =
      Poincare.SimonGMT.Chapter03.blowUpMap x r '' (S ∩ closedBall x (r * R)) := by
    ext y
    constructor
    · rintro ⟨⟨z, hz, rfl⟩, hy⟩
      refine ⟨z, ⟨hz, ?_⟩, rfl⟩
      rw [mem_closedBall_zero_iff, hnorm] at hy
      rw [mem_closedBall, dist_eq_norm]
      calc ‖z - x‖ = r * (r⁻¹ * ‖z - x‖) := by field_simp
        _ ≤ r * R := mul_le_mul_of_nonneg_left hy hr.le
    · rintro ⟨z, ⟨hz, hzx⟩, rfl⟩
      refine ⟨⟨z, hz, rfl⟩, ?_⟩
      rw [mem_closedBall, dist_eq_norm] at hzx
      rw [mem_closedBall_zero_iff, hnorm]
      calc r⁻¹ * ‖z - x‖ ≤ r⁻¹ * (r * R) := mul_le_mul_of_nonneg_left hzx (inv_pos.mpr hr).le
        _ = R := by field_simp
  -- Step 2: `η = τ ∘ h` with `h = homothety x r⁻¹` and `τ y = y + (-x)`
  have hcomp : Poincare.SimonGMT.Chapter03.blowUpMap x r =
      (fun y : Euclid P => y + -x) ∘ AffineMap.homothety x r⁻¹ := by
    funext z
    simp [Poincare.SimonGMT.Chapter03.blowUpMap, AffineMap.homothety_apply]
  -- Step 3: `μ(η(T)) = (ENNReal.ofReal r)⁻¹ ^ n * μ(T)`
  have hscale : ∀ T : Set (Euclid P), μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' T) =
      (ENNReal.ofReal r)⁻¹ ^ n * μHE[n] T := by
    intro T
    rw [hcomp, Set.image_comp, (isometry_add_right (-x)).euclideanHausdorffMeasure_image,
      euclideanHausdorffMeasure_homothety_image n x (inv_ne_zero hr.ne') T, ENNReal.smul_def,
      smul_eq_mul, ENNReal.coe_pow, nnnorm_inv, ENNReal.coe_inv (nnnorm_ne_zero_iff.mpr hr.ne'),
      Real.nnnorm_of_nonneg hr.le, ← ENNReal.ofReal_eq_coe_nnreal hr.le]
  -- Step 4: conclusion
  rw [hset, hscale]

/-- Locality of approximate tangent spaces (Simon 3.1.5(2), from the proof of 3.1.6 "⇒"): if
`A ⊆ B` are Borel, `Hⁿ(B ∩ B̄_{r₀}(x)) < ∞` and `Hⁿ((B \ A) ∩ B̄_ρ(x))/ρⁿ → 0` as `ρ ↓ 0`, then
`B` and `A` have the same approximate tangent spaces at `x`.  For `f ∈ C_c(ℝᴾ)` with `|f| ≤ C`
and `f = 0` off `B̄_R(0)`, and `0 < r < r₀/R`, the integrals of `f` over `η_{x,r}(B)` and
`η_{x,r}(A)` differ by at most `C Hⁿ(η_{x,r}(B \ A) ∩ B̄_R(0)) = C r⁻ⁿ Hⁿ((B \ A) ∩ B̄_{rR}(x))`,
which tends to `0` as `r ↓ 0`. -/
theorem Submission.regcomp_atl_tangent_iff_of_density_zero : ∀ (P n : ℕ) (A B : Set (Euclid P)) (x : Euclid P) (r₀ : ℝ), MeasurableSet A → MeasurableSet B → A ⊆ B → 0 < r₀ → μHE[n] (B ∩ closedBall x r₀) ≠ ∞ → Tendsto (fun ρ : ℝ => μHE[n] ((B \ A) ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n) (𝓝[>] 0) (𝓝 0) → ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q := by
  intro P n A B x r₀ hA hB hAB hr₀ hfin hdens
  refine Submission.regcomp_atl_pc_tangent_iff_of_integral_sub_tendsto P n B A x fun f => ?_
  -- `‖f‖ ≤ C` everywhere, and `f = 0` off `B̄_R(0)` with `R > 0`
  obtain ⟨C, hC⟩ := (map_continuous f).bounded_above_of_compact_support f.hasCompactSupport
  obtain ⟨R₁, hR₁⟩ := f.hasCompactSupport.isCompact.isBounded.subset_closedBall (0 : Euclid P)
  set R := max R₁ 1
  have hR : 0 < R := lt_of_lt_of_le one_pos (le_max_right R₁ 1)
  have hf0 : ∀ y : Euclid P, y ∉ closedBall (0 : Euclid P) R → f y = 0 := by
    intro y hy
    by_contra hne
    exact hy (closedBall_subset_closedBall (le_max_left R₁ 1) (hR₁ (subset_tsupport f hne)))
  -- the bound `C r⁻ⁿ Hⁿ((B \ A) ∩ B̄_{rR}(x))` tends to `0` as `r ↓ 0`
  have hlim : Tendsto (fun r : ℝ => C * ((ENNReal.ofReal r)⁻¹ ^ n *
      μHE[n] ((B \ A) ∩ closedBall x (r * R))).toReal) (𝓝[>] 0) (𝓝 0) := by
    have h := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp
      (Submission.regcomp_atl_pc_density_rescale_tendsto n
        (fun ρ : ℝ => μHE[n] ((B \ A) ∩ closedBall x ρ)) R hR hdens)
    rw [ENNReal.toReal_zero] at h
    have h' := h.const_mul C
    rw [mul_zero] at h'
    exact h'
  refine squeeze_zero_norm' ?_ hlim
  -- for `0 < r < r₀ / R` the fixed-scale comparison applies, and the scaling identity rewrites
  -- its bound
  filter_upwards [Ioo_mem_nhdsGT (div_pos hr₀ hR)] with r hr
  have hrR : r * R ≤ r₀ := ((lt_div_iff₀ hR).1 hr.2).le
  have hBfin : μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' B ∩ closedBall 0 R) ≠ ∞ := by
    rw [Submission.regcomp_atl_blowUp_measure_scaling P n x r R B hr.1]
    exact ENNReal.mul_ne_top
      (ENNReal.pow_ne_top (ENNReal.inv_ne_top.2 (ENNReal.ofReal_pos.2 hr.1).ne'))
      (ne_top_of_le_ne_top hfin
        (measure_mono (inter_subset_inter_right B (closedBall_subset_closedBall hrR))))
  have key := Submission.regcomp_atl_pc_blowUp_setIntegral_sub_le P n A B x r R C f
    (map_continuous f) hA hB hAB hr.1 hBfin hC hf0
  rwa [Submission.regcomp_atl_blowUp_measure_scaling P n x r R (B \ A) hr.1] at key

/-- Almost-everywhere locality of approximate tangent spaces (Simon Ch. 3, Remark 1.5(2), from the
proof of 3.1.6 "⇒"): if `U` is open, `A ⊆ B ⊆ U` are Borel and `Hⁿ(B ∩ K) < ∞` for compact
`K ⊆ U`, then for `Hⁿ`-a.e. `x ∈ A`, `B` and `A` have the same approximate tangent spaces at `x`.
The upper density theorem in `U` (Simon Ch. 1, Remark 3.7(2)) applied to `B \ A` gives
`Hⁿ((B \ A) ∩ B̄_ρ(x))/ρⁿ → 0` for `Hⁿ`-a.e. `x ∈ A ⊆ U \ (B \ A)`; at such `x` choose `r₀ > 0`
with `B̄_{r₀}(x) ⊆ U`, so that `Hⁿ(B ∩ B̄_{r₀}(x)) < ∞`, and compare the blow-ups of `B` and `A`. -/
theorem Submission.regcomp_approx_tangent_locality : ∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q := by
  intro P n U A B hU hA hB hAB hBU hfin
  -- Step 1: `B \ A` has zero `n`-density at `Hⁿ`-a.e. `x ∈ U \ (B \ A)`
  have hdens := Submission.regcomp_atl_local_density_zero P n U (B \ A) hU (hB.diff hA)
    fun K hK hKU => ne_top_of_le_ne_top (hfin K hK hKU)
      (measure_mono (inter_subset_inter_left K sdiff_subset))
  -- Step 2: pass to `Hⁿ⌞A`, almost every point of which lies in `A`
  filter_upwards [ae_restrict_of_ae hdens, ae_restrict_mem hA] with x hx hxA
  have hxU : x ∈ U := hBU (hAB hxA)
  -- Step 3: a closed ball `B̄_{r₀}(x) ⊆ U`, `r₀ = ε / 2`, on which `Hⁿ⌞B` is finite
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hU x hxU
  have hsub : closedBall x (ε / 2) ⊆ U := (closedBall_subset_ball (half_lt_self hε)).trans hball
  -- Step 4: the pointwise comparison of the blow-ups of `B` and `A`
  exact Submission.regcomp_atl_tangent_iff_of_density_zero P n A B x (ε / 2) hA hB hAB
    (half_pos hε) (hfin _ (isCompact_closedBall x (ε / 2)) hsub) (hx hxU fun h => h.2 hxA)
/-- Borel image and null-set pullback along a bi-Lipschitz piece: if `F : ℝⁿ → ℝᴾ` is Lipschitz,
`B ⊆ ℝⁿ` is Borel and `m‖a − a'‖ ≤ ‖F a − F a'‖` on `B` (`m > 0`), then `F(B)` is Borel
(Lusin–Souslin), and a property holding `Hⁿ⌞F(B)`-a.e. holds at `F b` for Lebesgue-a.e. `b ∈ B`:
`invFunOn F B` is `m⁻¹`-Lipschitz on `F(B)` (Simon Ch. 2, 1.8(i)) and maps the `Hⁿ`-null bad
image set onto a superset of the bad parameters, and `Hⁿ` is Lebesgue measure on `ℝⁿ`. -/
theorem Submission.ptd_piece_image_measurable_ae_pullback : ∀ (P n : ℕ) (F : Euclid n → Euclid P) (B : Set (Euclid n)) (L : NNReal) (m : ℝ), LipschitzWith L F → MeasurableSet B → 0 < m → (∀ a ∈ B, ∀ a' ∈ B, m * ‖a - a'‖ ≤ ‖F a - F a'‖) → MeasurableSet (F '' B) ∧ ∀ p : Euclid P → Prop, (∀ᵐ y ∂(μHE[n].restrict (F '' B)), p y) → ∀ᵐ b ∂(volume.restrict B), p (F b) := by
  intro P n F B L m hF hB hm hlow
  -- Step 1: the lower bound makes `F` injective on `B`
  have hinj : InjOn F B := fun a ha a' ha' h => by
    have hle := hlow a ha a' ha'
    rw [h, sub_self, norm_zero] at hle
    exact sub_eq_zero.1 (norm_le_zero_iff.1 (nonpos_of_mul_nonpos_right hle hm))
  -- Step 2: Lusin–Souslin
  have hFB : MeasurableSet (F '' B) := hB.image_of_continuousOn_injOn hF.continuous.continuousOn hinj
  refine ⟨hFB, fun p hp => ?_⟩
  -- Step 3: `G = invFunOn F B` is `m⁻¹`-Lipschitz on `F '' B`
  have hG : LipschitzOnWith (Real.toNNReal m⁻¹) (invFunOn F B) (F '' B) := by
    refine LipschitzOnWith.of_dist_le' ?_
    rintro _ ⟨a, ha, rfl⟩ _ ⟨a', ha', rfl⟩
    rw [hinj.leftInvOn_invFunOn ha, hinj.leftInvOn_invFunOn ha', dist_eq_norm, dist_eq_norm,
      inv_mul_eq_div, le_div_iff₀' hm]
    exact hlow a ha a' ha'
  -- Step 4: the bad parameters lie in the `G`-image of the `Hⁿ`-null bad image set
  rw [ae_restrict_iff' hFB, ae_iff] at hp
  rw [ae_restrict_iff' hB, ae_iff, ← EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
  have hnull : μHE[n] (invFunOn F B '' {y | ¬(y ∈ F '' B → p y)}) = 0 := by
    refine le_zero_iff.1 ?_
    calc μHE[n] (invFunOn F B '' {y | ¬(y ∈ F '' B → p y)})
        ≤ (Real.toNNReal m⁻¹ : ℝ≥0∞) ^ n * μHE[n] {y | ¬(y ∈ F '' B → p y)} :=
          Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
            (hG.mono fun y hy => (not_imp.1 hy).1)
      _ = 0 := by rw [hp, mul_zero]
  refine measure_mono_null (fun b hb => ?_) hnull
  obtain ⟨hbB, hpb⟩ := not_imp.1 (show ¬(b ∈ B → p (F b)) from hb)
  exact ⟨F b, show ¬(F b ∈ F '' B → p (F b)) from not_imp.2 ⟨mem_image_of_mem F hbB, hpb⟩,
    hinj.leftInvOn_invFunOn hbB⟩
/-- Changing a set by parts of vanishing `n`-density at `x` does not change its approximate
tangent spaces at `x` (Simon Ch. 3, Definition 1.4 and Remark 1.5(2); proof of 3.1.6).  For
`f ∈ C_c(ℝᴾ)` with `|f| ≤ C`, `f = 0` off `B̄_R(0)` and `0 < r < r₀/R`, comparing both blow-up
integrals with the one over `η_{x,r}(A ∩ B)` gives `|∫_{η_{x,r}(A)} f dHⁿ − ∫_{η_{x,r}(B)} f dHⁿ| ≤
C Hⁿ(η_{x,r}(A \ B) ∩ B̄_R(0)) + C Hⁿ(η_{x,r}(B \ A) ∩ B̄_R(0))`, and
`Hⁿ(η_{x,r}(S) ∩ B̄_R(0)) = r⁻ⁿ Hⁿ(S ∩ B̄_{rR}(x)) → 0` for `S = A \ B`, `B \ A`. -/
theorem Submission.doraggt_approxTangent_iff_of_density_zero : ∀ (P n : ℕ) (A B : Set (Euclid P)) (x : Euclid P) (r₀ : ℝ), MeasurableSet A → MeasurableSet B → 0 < r₀ → μHE[n] (A ∩ closedBall x r₀) ≠ ∞ → μHE[n] (B ∩ closedBall x r₀) ≠ ∞ → Tendsto (fun ρ : ℝ => μHE[n] ((A \ B) ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n) (𝓝[>] 0) (𝓝 0) → Tendsto (fun ρ : ℝ => μHE[n] ((B \ A) ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n) (𝓝[>] 0) (𝓝 0) → ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n A x Q ↔ HasApproximateTangentSpaceAt n B x Q := by
  intro P n A B x r₀ hA hB hr₀ hAfin hBfin hAB hBA
  -- Step 1: it suffices that `∫_{η_r(A)} f − ∫_{η_r(B)} f → 0` for every `f ∈ C_c`
  refine Submission.regcomp_atl_pc_tangent_iff_of_integral_sub_tendsto P n A B x fun f => ?_
  -- Step 2: `|f| ≤ C`, and `f = 0` off `B̄_R(0)` for some `R > 0`
  obtain ⟨C, hC⟩ := f.continuous.bounded_above_of_compact_support f.hasCompactSupport
  obtain ⟨R, hR, hzero⟩ : ∃ R : ℝ, 0 < R ∧
      ∀ y : Euclid P, y ∉ closedBall (0 : Euclid P) R → f y = 0 := by
    obtain ⟨R₁, hR₁⟩ := (isBounded_iff_subset_closedBall (0 : Euclid P)).mp
      f.hasCompactSupport.isCompact.isBounded
    exact ⟨max R₁ 1, lt_max_of_lt_right one_pos, fun y hy => image_eq_zero_of_notMem_tsupport
      fun h => hy (closedBall_subset_closedBall (le_max_left _ _) (hR₁ h))⟩
  -- Step 3: for `0 < r < r₀ / R`, `Hⁿ(η_r(S) ∩ B̄_R(0)) ≤ r⁻ⁿ Hⁿ(S ∩ B̄_{r₀}(x)) < ∞`
  have hfin : ∀ S : Set (Euclid P), μHE[n] (S ∩ closedBall x r₀) ≠ ∞ → ∀ r ∈ Ioo 0 (r₀ / R),
      μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' S ∩ closedBall 0 R) ≠ ∞ := by
    intro S hS r hr
    rw [Submission.regcomp_atl_blowUp_measure_scaling P n x r R S hr.1]
    exact ENNReal.mul_ne_top
      (ENNReal.pow_ne_top (ENNReal.inv_ne_top.mpr (ENNReal.ofReal_pos.mpr hr.1).ne'))
      (ne_top_of_le_ne_top hS (measure_mono (inter_subset_inter_right _
        (closedBall_subset_closedBall ((lt_div_iff₀ hR).mp hr.2).le))))
  -- Step 4: `C Hⁿ(η_r(S) ∩ B̄_R(0)) = C r⁻ⁿ Hⁿ(S ∩ B̄_{rR}(x)) → 0` for `S = A \ B`, `B \ A`
  have herr : ∀ S : Set (Euclid P),
      Tendsto (fun ρ : ℝ => μHE[n] (S ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n) (𝓝[>] 0) (𝓝 0) →
      Tendsto (fun r : ℝ => C *
        (μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' S ∩ closedBall 0 R)).toReal)
        (𝓝[>] 0) (𝓝 0) := by
    intro S hS
    have h := ((ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp
      (Submission.regcomp_atl_pc_density_rescale_tendsto n
        (fun ρ => μHE[n] (S ∩ closedBall x ρ)) R hR hS)).const_mul C
    rw [ENNReal.toReal_zero, mul_zero] at h
    refine h.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with r (hr : 0 < r)
    rw [Function.comp_apply, Submission.regcomp_atl_blowUp_measure_scaling P n x r R S hr]
  -- Step 5: for `0 < r < r₀ / R`, compare both integrals with the one over `η_r(A ∩ B)`
  have hle : ∀ᶠ r in 𝓝[>] (0 : ℝ),
      ‖(∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' A, f y ∂μHE[n]) -
          ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' B, f y ∂μHE[n]‖ ≤
        C * (μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' (A \ B) ∩
            closedBall 0 R)).toReal +
          C * (μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' (B \ A) ∩
            closedBall 0 R)).toReal := by
    filter_upwards [Ioo_mem_nhdsGT (div_pos hr₀ hR)] with r hr
    have hA' := Submission.regcomp_atl_pc_blowUp_setIntegral_sub_le P n (A ∩ B) A x r R C f
      f.continuous (hA.inter hB) hA inter_subset_left hr.1 (hfin A hAfin r hr) hC hzero
    have hB' := Submission.regcomp_atl_pc_blowUp_setIntegral_sub_le P n (A ∩ B) B x r R C f
      f.continuous (hA.inter hB) hB inter_subset_right hr.1 (hfin B hBfin r hr) hC hzero
    rw [Set.sdiff_self_inter] at hA'
    rw [Set.sdiff_inter_self_eq_sdiff] at hB'
    rw [← sub_sub_sub_cancel_right _ _
      (∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' (A ∩ B), f y ∂μHE[n])]
    exact (norm_sub_le _ _).trans (add_le_add hA' hB')
  -- Step 6: squeeze
  have hlim := (herr _ hAB).add (herr _ hBA)
  rw [add_zero] at hlim
  exact squeeze_zero_norm' hle hlim

/-- **Approximate tangent planes of two locally finite sets agree a.e. on their overlap** (Simon
Ch. 3, Remark 1.5(2) and the proof of Theorem 1.6 "⇒", chapter-03.txt lines 86–90 and 113–146,
stated symmetrically for two sets).  Let `W ⊆ ℝᴾ` be open and `A`, `B` Borel with `Hⁿ(A ∩ K)` and
`Hⁿ(B ∩ K)` finite for every compact `K ⊆ W`.  By the upper density theorem the densities of
`A ∖ B` and `B ∖ A` vanish at `Hⁿ`-a.e. `x ∈ W ∩ A ∩ B`; a closed ball about such `x` inside `W`
has finite measure in `A` and in `B`, so `A` and `B` have the same approximate tangent planes at
`x`. -/
theorem Submission.doraggt_ae_approxTangent_transfer : ∀ (P n : ℕ) (W A B : Set (Euclid P)), IsOpen W → MeasurableSet A → MeasurableSet B → (∀ K : Set (Euclid P), IsCompact K → K ⊆ W → μHE[n] (A ∩ K) ≠ ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ W → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)), x ∈ W → x ∈ A → x ∈ B → ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n A x Q ↔ HasApproximateTangentSpaceAt n B x Q := by
  intro P n W A B hW hA hB hAfin hBfin
  -- Step 1, the densities of `A ∖ B` and `B ∖ A` vanish `Hⁿ`-a.e. on `W` off these sets.
  have hAB := Submission.doraggt_local_density_zero P n W (A \ B) hW (hA.diff hB)
    fun K hK hKW => ne_top_of_le_ne_top (hAfin K hK hKW)
      (measure_mono (inter_subset_inter_left K sdiff_subset))
  have hBA := Submission.doraggt_local_density_zero P n W (B \ A) hW (hB.diff hA)
    fun K hK hKW => ne_top_of_le_ne_top (hBfin K hK hKW)
      (measure_mono (inter_subset_inter_left K sdiff_subset))
  -- Step 2, at such `x ∈ W ∩ A ∩ B`, `x ∉ A ∖ B` and `x ∉ B ∖ A`, so both densities vanish.
  filter_upwards [hAB, hBA] with x hxAB hxBA hxW hxA hxB
  -- Step 3, `B̄(x, ε/2) ⊆ B(x, ε) ⊆ W` is compact, so `A` and `B` have finite measure in it.
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hW x hxW
  have hsub : closedBall x (ε / 2) ⊆ W := (closedBall_subset_ball (half_lt_self hε)).trans hball
  -- Step 4, the approximate tangent planes of `A` and `B` at `x` agree.
  exact Submission.doraggt_approxTangent_iff_of_density_zero P n A B x (ε / 2) hA hB
    (half_pos hε) (hAfin _ (isCompact_closedBall x (ε / 2)) hsub)
    (hBfin _ (isCompact_closedBall x (ε / 2)) hsub) (hxAB hxW fun h => h.2 hxB)
    (hxBA hxW fun h => h.2 hxA)

/-- **A countably `n`-rectifiable set has approximate tangent planes `Hⁿ`-a.e.** (Simon Ch. 3,
Theorem 1.6 "⇒", chapter-03.txt lines 109–143, with Lemma 1.2 and Remark 1.3, lines 25–76).  Let
`M ⊆ ℝᴾ` be Borel and countably `n`-rectifiable with `Hⁿ(M ∩ K) < ∞` for every compact `K`.  Up to
an `Hⁿ`-null set, `M` is covered by Borel pieces `N_k = g_k(B_{r_k}(c_k))` of finite measure, with
`g_k` of class `C¹` and `m_k|a − b| ≤ |g_k(a) − g_k(b)|` on the ball (Lemma 1.2).  `N_k` has the
approximate tangent plane `Dg_k(z)(ℝⁿ)` at each `g_k(z)`, and by the upper density theorem `M` and
`N_k` have the same approximate tangent planes at `Hⁿ`-a.e. point of `M ∩ N_k`.  The countably many
exceptional null sets combine, so `T_w M` exists for `Hⁿ`-a.e. `w ∈ M`.  The pieces need not be
disjoint (Remark 1.3). -/
theorem Submission.codim1_rdo_rectifiable_ae_approxTangent : ∀ (P n : ℕ) (M : Set (Euclid P)), MeasurableSet M → CountablyRectifiable n M → (∀ K : Set (Euclid P), IsCompact K → μHE[n] (M ∩ K) ≠ ∞) → ∀ᵐ w ∂(μHE[n].restrict M), ∃ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M w Q := by
  intro P n M hM hrect hloc
  -- Step 1, `M` is covered up to an `Hⁿ`-null set by the `C¹` pieces `N_k = g_k(B_{r_k}(c_k))`.
  obtain ⟨g, c, r, m, hg, hm, hlow, hmeas, hfin, hnull⟩ :=
    Submission.codim1_rdo_rectifiable_c1_cover P n M hrect
  -- Step 2, `M` and `N_k` have the same approximate tangent planes `Hⁿ`-a.e. on `M ∩ N_k`.
  have hpiece : ∀ k, ∀ᵐ w ∂(μHE[n] : Measure (Euclid P)), w ∈ (univ : Set (Euclid P)) → w ∈ M →
      w ∈ g k '' ball (c k) (r k) → ∀ Q : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt n M w Q ↔
          HasApproximateTangentSpaceAt n (g k '' ball (c k) (r k)) w Q :=
    fun k => Submission.doraggt_ae_approxTangent_transfer P n univ M (g k '' ball (c k) (r k))
      isOpen_univ hM (hmeas k) (fun K hK _ => hloc K hK)
      (fun K _ _ => ne_top_of_le_ne_top (hfin k) (measure_mono inter_subset_left))
  -- Step 3, the exceptional sets of Steps 1 and 2 form countably many `Hⁿ`-null sets.
  have hall := ae_all_iff.2 hpiece
  have hcov : ∀ᵐ w ∂(μHE[n] : Measure (Euclid P)), w ∉ M \ ⋃ k, g k '' ball (c k) (r k) :=
    measure_eq_zero_iff_ae_notMem.1 hnull
  -- Step 4, off them, `w = g_k(z) ∈ M ∩ N_k` for some `k`, and `T_w M = T_w N_k = Dg_k(z)(ℝⁿ)`.
  rw [ae_restrict_iff' hM]
  filter_upwards [hall, hcov] with w hw hw' hwM
  have hU : w ∈ ⋃ k, g k '' ball (c k) (r k) := by
    by_contra h
    exact hw' ⟨hwM, h⟩
  obtain ⟨k, z, hz, rfl⟩ := mem_iUnion.1 hU
  exact ⟨_, (hw k (mem_univ _) hwM ⟨z, hz, rfl⟩ _).2
    (Submission.codim1_rdo_c1_piece_approxTangent P n (g k) (c k) (r k) (m k) (hg k) (hm k)
      (hlow k) z hz)⟩
/-- An approximate tangent plane forces unit `Hⁿ`-density on closed balls (Simon Ch. 3,
Remark 1.5(3), with Definition 1.4).  If `Hⁿ(M ∩ B̄_s(x)) < ∞` and `Q` is an approximate tangent
space of `M` at `x`, then `Hⁿ(M ∩ B̄_ρ(x)) / (ωₙρⁿ) → 1` as `ρ ↓ 0`.  Since
`Hⁿ(η_{x,r}(M) ∩ B̄_1(0)) = r⁻ⁿHⁿ(M ∩ B̄_r(x))` and `Hⁿ(Q ∩ B̄_t(0)) = ωₙtⁿ`, the radial cut-offs
`g_{1-ε,1} ≤ 1_{B̄_1(0)} ≤ g_{1,1+ε}` in `C_c` squeeze `r⁻ⁿHⁿ(M ∩ B̄_r(x))` between blow-up integrals
whose limits lie within `ωₙ(1 ∓ ε)ⁿ`. -/
theorem Submission.rsd_tendsto_closedBall_density_of_approxTangent : ∀ (P n : ℕ) (M : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)) (s : ℝ), 0 < s → μHE[n] (M ∩ closedBall x s) ≠ ∞ → HasApproximateTangentSpaceAt n M x Q → Tendsto (fun ρ : ℝ => μHE[n] (M ∩ closedBall x ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) (𝓝 1) := by
  intro P n M x Q s hs hfin hT
  obtain ⟨hQ, hconv⟩ := hT
  -- Step 1: `ωₙ ∈ (0, ∞)`
  set ω := unitBallVolume n with hωdef
  have hω0 : ω ≠ 0 := (measure_ball_pos volume (0 : Euclid n) one_pos).ne'
  have hωtop : ω ≠ ∞ := measure_ball_lt_top.ne
  set w := ω.toReal with hwdef
  have hw : 0 < w := ENNReal.toReal_pos hω0 hωtop
  -- Step 2: `Hⁿ(Q ∩ B̄_t(0)) = ωₙ tⁿ`, via a linear isometry `ℝⁿ ≅ Q`
  have hplane0 : ∀ t : ℝ, 0 ≤ t →
      μHE[n] ((Q : Set (Euclid P)) ∩ closedBall 0 t) = ω * ENNReal.ofReal (t ^ n) := by
    intro t ht
    let b : OrthonormalBasis (Fin n) ℝ Q := (stdOrthonormalBasis ℝ Q).reindex (finCongr hQ)
    let ι : Euclid n →ₗᵢ[ℝ] Euclid P := Q.subtypeₗᵢ.comp b.repr.symm.toLinearIsometry
    have himage : ι '' closedBall 0 t = (Q : Set (Euclid P)) ∩ closedBall 0 t := by
      ext y
      constructor
      · rintro ⟨v, hv, rfl⟩
        refine ⟨(b.repr.symm v).2, ?_⟩
        rw [mem_closedBall, dist_zero_right] at hv ⊢
        have : ‖((b.repr.symm v : Q) : Euclid P)‖ = ‖v‖ := b.repr.symm.norm_map v
        simpa [ι, this] using hv
      · rintro ⟨hyQ, hy⟩
        refine ⟨b.repr ⟨y, hyQ⟩, ?_, ?_⟩
        · rw [mem_closedBall, dist_zero_right] at hy ⊢
          simpa using hy
        · simp [ι]
    rw [← himage, ι.isometry.euclideanHausdorffMeasure_image,
      EuclideanSpace.euclideanHausdorffMeasure_eq_volume,
      Measure.addHaar_closedBall _ _ ht, finrank_euclideanSpace_fin, hωdef, unitBallVolume, mul_comm]
  -- Step 3: scaling `Hⁿ(η_{x,r}(A)) = r⁻ⁿ Hⁿ(A)` and `η_{x,r}(M) ∩ B̄_t(0) = η_{x,r}(M ∩ B̄_{tr}(x))`
  have hscale : ∀ r : ℝ, 0 < r → ∀ A : Set (Euclid P),
      μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' A) = ENNReal.ofReal (r⁻¹ ^ n) * μHE[n] A := by
    intro r hr A
    have h1 : Poincare.SimonGMT.Chapter03.blowUpMap x r '' A =
        (fun y => r⁻¹ • y) '' ((fun y => y - x) '' A) := by
      rw [image_image]
      rfl
    have hiso : Isometry (fun y : Euclid P => y - x) :=
      Isometry.of_dist_eq (fun a c => by simp [dist_eq_norm])
    rw [h1, Set.image_smul, Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hr.ne'),
      hiso.euclideanHausdorffMeasure_image, ENNReal.smul_def, smul_eq_mul]
    congr 1
    rw [← ENNReal.ofReal_coe_nnreal]
    congr 1
    simp [abs_of_pos hr]
  have himg : ∀ r : ℝ, 0 < r → ∀ t : ℝ,
      Poincare.SimonGMT.Chapter03.blowUpMap x r '' M ∩ closedBall 0 t =
        Poincare.SimonGMT.Chapter03.blowUpMap x r '' (M ∩ closedBall x (t * r)) := by
    intro r hr t
    have key : ∀ z : Euclid P,
        ‖Poincare.SimonGMT.Chapter03.blowUpMap x r z‖ ≤ t ↔ dist z x ≤ t * r := by
      intro z
      simp only [Poincare.SimonGMT.Chapter03.blowUpMap, norm_smul, Real.norm_eq_abs, abs_inv,
        abs_of_pos hr, dist_eq_norm]
      rw [inv_mul_le_iff₀ hr, mul_comm r t]
    ext y
    constructor
    · rintro ⟨⟨z, hz, rfl⟩, hy⟩
      rw [mem_closedBall, dist_zero_right, key] at hy
      exact ⟨z, ⟨hz, hy⟩, rfl⟩
    · rintro ⟨z, ⟨hz, hzb⟩, rfl⟩
      refine ⟨⟨z, hz, rfl⟩, ?_⟩
      rw [mem_closedBall, dist_zero_right, key]
      exact hzb
  have hνball : ∀ r : ℝ, 0 < r → ∀ t : ℝ,
      (μHE[n].restrict (Poincare.SimonGMT.Chapter03.blowUpMap x r '' M)) (closedBall 0 t) =
        ENNReal.ofReal (r⁻¹ ^ n) * μHE[n] (M ∩ closedBall x (t * r)) := by
    intro r hr t
    rw [Measure.restrict_apply measurableSet_closedBall, inter_comm, himg r hr t, hscale r hr]
  have hmfin : ∀ r : ℝ, r ≤ s → μHE[n] (M ∩ closedBall x r) ≠ ∞ := fun r hr =>
    ne_top_of_le_ne_top hfin (measure_mono (inter_subset_inter_right _ (closedBall_subset_closedBall hr)))
  have hνfin : ∀ r : ℝ, 0 < r → ∀ t : ℝ, t * r ≤ s →
      (μHE[n].restrict (Poincare.SimonGMT.Chapter03.blowUpMap x r '' M)) (closedBall 0 t) ≠ ∞ := by
    intro r hr t ht
    rw [hνball r hr t]
    exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top (hmfin _ ht)
  -- Step 4: radial cut-off functions `g_{a,b}` in `C_c`
  have hbump : ∀ a b : ℝ, 0 < a → a < b →
      ∃ f : CompactlySupportedContinuousMap (Euclid P) ℝ, Continuous f ∧ (0 ≤ ⇑f) ∧
        (closedBall (0 : Euclid P) a).indicator 1 ≤ ⇑f ∧ ⇑f ≤ (closedBall (0 : Euclid P) b).indicator 1 := by
    intro a b ha hab
    have hcont : Continuous (fun y : Euclid P => max 0 (min 1 ((b - ‖y‖) / (b - a)))) :=
      continuous_const.max (continuous_const.min ((continuous_const.sub continuous_norm).div_const _))
    have hzero : ∀ y : Euclid P, b ≤ ‖y‖ → max 0 (min 1 ((b - ‖y‖) / (b - a))) = 0 := by
      intro y hy
      have h1 : (b - ‖y‖) / (b - a) ≤ 0 := div_nonpos_of_nonpos_of_nonneg (by linarith) (by linarith)
      rw [max_eq_left ((min_le_right _ _).trans h1)]
    let f : CompactlySupportedContinuousMap (Euclid P) ℝ :=
      { toFun := fun y => max 0 (min 1 ((b - ‖y‖) / (b - a)))
        continuous_toFun := hcont
        hasCompactSupport' := by
          refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid P) b) ?_
          intro y hy
          rw [mem_closedBall, dist_zero_right, not_le] at hy
          exact hzero y hy.le }
    have hf : ∀ y, f y = max 0 (min 1 ((b - ‖y‖) / (b - a))) := fun y => rfl
    refine ⟨f, f.continuous, fun y => by rw [hf]; exact le_max_left _ _, ?_, ?_⟩
    · intro y
      by_cases hy : y ∈ closedBall (0 : Euclid P) a
      · rw [indicator_of_mem hy, Pi.one_apply, hf]
        rw [mem_closedBall, dist_zero_right] at hy
        have : 1 ≤ (b - ‖y‖) / (b - a) := by
          rw [le_div_iff₀ (by linarith)]; linarith
        rw [min_eq_left this, max_eq_right zero_le_one]
      · rw [indicator_of_notMem hy, hf]; exact le_max_left _ _
    · intro y
      by_cases hy : y ∈ closedBall (0 : Euclid P) b
      · rw [indicator_of_mem hy, Pi.one_apply, hf]
        exact max_le zero_le_one (min_le_left _ _)
      · rw [indicator_of_notMem hy, hf, hzero]
        rw [mem_closedBall, dist_zero_right, not_le] at hy
        exact hy.le
  -- Step 5: integrability of functions dominated by the indicator of a finite-measure closed ball
  have hindint : ∀ (ν : Measure (Euclid P)) (t : ℝ), ν (closedBall 0 t) ≠ ∞ →
      Integrable ((closedBall (0 : Euclid P) t).indicator (1 : Euclid P → ℝ)) ν := fun ν t h =>
    (integrable_indicator_iff measurableSet_closedBall).2 (integrableOn_const h)
  have hdomint : ∀ (ν : Measure (Euclid P)) (f : Euclid P → ℝ) (t : ℝ), Continuous f →
      ν (closedBall 0 t) ≠ ∞ → 0 ≤ f → f ≤ (closedBall (0 : Euclid P) t).indicator 1 →
      Integrable f ν := by
    intro ν f t hf hfin' h0 hle
    refine (hindint ν t hfin').mono' hf.aestronglyMeasurable (Eventually.of_forall fun y => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (h0 y)]
    exact hle y
  -- Step 6: the normalised mass `a(r) = r⁻ⁿ Hⁿ(M ∩ B̄_r(x))` and the plane-ball values
  set a : ℝ → ℝ := fun r => (r⁻¹) ^ n * (μHE[n] (M ∩ closedBall x r)).toReal with hadef
  have hareal : ∀ r : ℝ, 0 < r →
      (μHE[n].restrict (Poincare.SimonGMT.Chapter03.blowUpMap x r '' M)).real (closedBall 0 1) = a r := by
    intro r hr
    rw [measureReal_def, hνball r hr 1, one_mul, ENNReal.toReal_mul,
      ENNReal.toReal_ofReal (by positivity)]
  have hplane : ∀ t : ℝ, 0 ≤ t →
      (μHE[n].restrict (Q : Set (Euclid P))) (closedBall 0 t) = ω * ENNReal.ofReal (t ^ n) := by
    intro t ht
    rw [Measure.restrict_apply measurableSet_closedBall, inter_comm, hplane0 t ht]
  have hplanefin : ∀ t : ℝ, 0 ≤ t → (μHE[n].restrict (Q : Set (Euclid P))) (closedBall 0 t) ≠ ∞ := by
    intro t ht
    rw [hplane t ht]
    exact ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top
  have hplanereal : ∀ t : ℝ, 0 ≤ t →
      (μHE[n].restrict (Q : Set (Euclid P))).real (closedBall 0 t) = w * t ^ n := by
    intro t ht
    rw [measureReal_def, hplane t ht, ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity)]
  -- Step 7: `a r → ωₙ`
  have ha : Tendsto a (𝓝[>] 0) (𝓝 w) := by
    rw [tendsto_order]
    constructor
    · intro c hc
      have hcont : Tendsto (fun ε : ℝ => w * (1 - ε) ^ n) (𝓝[>] 0) (𝓝 w) := by
        have : Continuous (fun ε : ℝ => w * (1 - ε) ^ n) := by fun_prop
        simpa using (this.tendsto 0).mono_left nhdsWithin_le_nhds
      obtain ⟨ε, hcε, hε⟩ :=
        ((hcont.eventually (lt_mem_nhds hc)).and (Ioo_mem_nhdsGT one_pos)).exists
      obtain ⟨f, hfc, hf0, hfge, hfle⟩ := hbump (1 - ε) 1 (by linarith [hε.2]) (by linarith [hε.1])
      -- `∫_Q f ≥ ωₙ (1-ε)ⁿ`
      have hQ1 : w * (1 - ε) ^ n ≤ ∫ y in (Q : Set (Euclid P)), f y ∂μHE[n] := by
        rw [← hplanereal (1 - ε) (by linarith [hε.2]), ← integral_indicator_one measurableSet_closedBall]
        exact integral_mono (hindint _ _ (hplanefin _ (by linarith [hε.2])))
          (hdomint _ _ 1 hfc (hplanefin _ zero_le_one) hf0 hfle) hfge
      filter_upwards [(tendsto_order.1 (hconv f)).1 c (hcε.trans_le hQ1),
        Ioc_mem_nhdsGT (half_pos hs)] with r hr1 hr2
      -- `∫_{η(M)} f ≤ a r`
      have h1 : (1 : ℝ) * r ≤ s := by linarith [hr2.2]
      have hle : ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, f y ∂μHE[n] ≤ a r := by
        rw [← hareal r hr2.1, ← integral_indicator_one measurableSet_closedBall]
        exact integral_mono (hdomint _ _ 1 hfc (hνfin r hr2.1 1 h1) hf0 hfle)
          (hindint _ _ (hνfin r hr2.1 1 h1)) hfle
      exact hr1.trans_le hle
    · intro c hc
      have hcont : Tendsto (fun ε : ℝ => w * (1 + ε) ^ n) (𝓝[>] 0) (𝓝 w) := by
        have : Continuous (fun ε : ℝ => w * (1 + ε) ^ n) := by fun_prop
        simpa using (this.tendsto 0).mono_left nhdsWithin_le_nhds
      obtain ⟨ε, hcε, hε⟩ :=
        ((hcont.eventually (gt_mem_nhds hc)).and (Ioo_mem_nhdsGT one_pos)).exists
      obtain ⟨f, hfc, hf0, hfge, hfle⟩ := hbump 1 (1 + ε) one_pos (by linarith [hε.1])
      -- `∫_Q f ≤ ωₙ (1+ε)ⁿ`
      have hQ2 : ∫ y in (Q : Set (Euclid P)), f y ∂μHE[n] ≤ w * (1 + ε) ^ n := by
        rw [← hplanereal (1 + ε) (by linarith [hε.1]), ← integral_indicator_one measurableSet_closedBall]
        exact integral_mono (hdomint _ _ (1 + ε) hfc (hplanefin _ (by linarith [hε.1])) hf0 hfle)
          (hindint _ _ (hplanefin _ (by linarith [hε.1]))) hfle
      filter_upwards [(tendsto_order.1 (hconv f)).2 c (hQ2.trans_lt hcε),
        Ioc_mem_nhdsGT (half_pos hs)] with r hr1 hr2
      -- `a r ≤ ∫_{η(M)} f`
      have h1 : (1 : ℝ) * r ≤ s := by linarith [hr2.2]
      have h2 : (1 + ε) * r ≤ s := by nlinarith [hr2.1, hr2.2, hε.2]
      have hge : a r ≤ ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, f y ∂μHE[n] := by
        rw [← hareal r hr2.1, ← integral_indicator_one measurableSet_closedBall]
        exact integral_mono (hindint _ _ (hνfin r hr2.1 1 h1))
          (hdomint _ _ (1 + ε) hfc (hνfin r hr2.1 _ h2) hf0 hfle) hfge
      exact hge.trans_lt hr1
  -- Step 8: back to the `ℝ≥0∞` quotient
  have hconvert : ∀ ρ : ℝ, 0 < ρ → ρ ≤ s →
      μHE[n] (M ∩ closedBall x ρ) / (ω * ENNReal.ofReal (ρ ^ n)) = ENNReal.ofReal (a ρ / w) := by
    intro ρ hρ hρs
    have hρn : 0 < ρ ^ n := pow_pos hρ n
    rw [← ENNReal.ofReal_toReal (hmfin ρ hρs), ← ENNReal.ofReal_toReal hωtop,
      ← ENNReal.ofReal_mul ENNReal.toReal_nonneg,
      ← ENNReal.ofReal_div_of_pos (mul_pos hw hρn)]
    congr 1
    simp only [hadef, inv_pow]
    field_simp
  have hlim : Tendsto (fun ρ : ℝ => ENNReal.ofReal (a ρ / w)) (𝓝[>] 0) (𝓝 1) := by
    have := ENNReal.tendsto_ofReal (ha.div_const w)
    rwa [div_self hw.ne', ENNReal.ofReal_one] at this
  refine hlim.congr' ?_
  filter_upwards [Ioc_mem_nhdsGT hs] with ρ hρ
  exact (hconvert ρ hρ.1 hρ.2).symm
/-- **Simon Ch. 1, 3.1–3.2** (densities may be computed with closed or open balls; cf. 6.2.8 and
`HasMassDensity`): if `ν(B̄_ρ(x)) / (ωₙρⁿ) → θ ∈ [0, ∞]` as `ρ ↓ 0`, then also
`ν(B_ρ(x)) / (ωₙρⁿ) → θ`.  The upper bound follows from `B_ρ(x) ⊆ B̄_ρ(x)`.  For the lower
bound, given `a < θ` pick `t ∈ (0, 1)` with `a < tⁿθ`; then `B̄_{tρ}(x) ⊆ B_ρ(x)` and
`ωₙ(tρ)ⁿ = tⁿ ωₙρⁿ` give `ν(B_ρ(x)) / (ωₙρⁿ) ≥ tⁿ · ν(B̄_{tρ}(x)) / (ωₙ(tρ)ⁿ) > a` for small
`ρ`. -/
theorem Submission.rsd_tendsto_ball_density_of_closedBall : ∀ (P n : ℕ) (ν : Measure (Euclid P)) (x : Euclid P) (θ : ℝ≥0∞), Tendsto (fun ρ : ℝ => ν (closedBall x ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) (𝓝 θ) → Tendsto (fun ρ : ℝ => ν (ball x ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) (𝓝 θ) := by
  intro P n ν x θ hg
  set ω := unitBallVolume n
  rw [tendsto_order]
  refine ⟨fun a ha => ?_, fun b hb => ?_⟩
  · -- Step 2: choose `t ∈ (0, 1)` with `a < tⁿθ`, using `tⁿθ → θ` as `t ↑ 1`
    have hlim : Tendsto (fun t : ℝ => ENNReal.ofReal (t ^ n) * θ) (𝓝[<] 1) (𝓝 (1 * θ)) := by
      refine ENNReal.Tendsto.mul_const ?_ (Or.inl one_ne_zero)
      have : Tendsto (fun t : ℝ => ENNReal.ofReal (t ^ n)) (𝓝 1) (𝓝 (ENNReal.ofReal (1 ^ n))) :=
        (ENNReal.continuous_ofReal.comp (continuous_pow n)).tendsto 1
      simpa using this.mono_left nhdsWithin_le_nhds
    rw [one_mul] at hlim
    obtain ⟨t, hta, ht0, ht1⟩ : ∃ t : ℝ, a < ENNReal.ofReal (t ^ n) * θ ∧ 0 < t ∧ t < 1 := by
      have h1 := (tendsto_order.1 hlim).1 a ha
      have h2 : ∀ᶠ t in 𝓝[<] (1 : ℝ), t ∈ Ioo (0 : ℝ) 1 := Ioo_mem_nhdsLT (by norm_num)
      obtain ⟨t, ht, ht'⟩ := (h1.and h2).exists
      exact ⟨t, ht, ht'.1, ht'.2⟩
    have hc0 : ENNReal.ofReal (t ^ n) ≠ 0 := by
      rw [Ne, ENNReal.ofReal_eq_zero, not_le]
      positivity
    have hctop : ENNReal.ofReal (t ^ n) ≠ ∞ := ENNReal.ofReal_ne_top
    have ha' : a / ENNReal.ofReal (t ^ n) < θ := by
      rw [ENNReal.div_lt_iff (Or.inl hc0) (Or.inl hctop), mul_comm]
      exact hta
    -- Step 3: the rescaled closed-ball ratio `g(tρ)` still tends to `θ`
    have hmap : Tendsto (fun ρ : ℝ => t * ρ) (𝓝[>] 0) (𝓝[>] 0) := by
      refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ ?_ ?_
      · have h0 : Tendsto (fun ρ : ℝ => t * ρ) (𝓝 0) (𝓝 0) := by
          simpa using (tendsto_id (x := 𝓝 (0 : ℝ))).const_mul t
        exact h0.mono_left nhdsWithin_le_nhds
      · filter_upwards [self_mem_nhdsWithin] with ρ hρ
        exact mul_pos ht0 hρ
    have hev := (tendsto_order.1 (hg.comp hmap)).1 _ ha'
    filter_upwards [hev, self_mem_nhdsWithin] with ρ hρ hρpos
    simp only [Function.comp] at hρ
    have hρpos' : (0 : ℝ) < ρ := hρpos
    -- Step 4: `ν(B̄_{tρ}(x)) / (ωₙ(tρ)ⁿ) · tⁿ = ν(B̄_{tρ}(x)) / (ωₙρⁿ)`
    have hid : ν (closedBall x (t * ρ)) / (ω * ENNReal.ofReal ((t * ρ) ^ n)) * ENNReal.ofReal (t ^ n)
        = ν (closedBall x (t * ρ)) / (ω * ENNReal.ofReal (ρ ^ n)) := by
      rw [mul_pow, ENNReal.ofReal_mul (by positivity), mul_comm (ENNReal.ofReal (t ^ n)),
        ← mul_assoc, div_eq_mul_inv, div_eq_mul_inv, ENNReal.mul_inv (Or.inr hctop) (Or.inr hc0),
        mul_assoc, mul_assoc, ENNReal.inv_mul_cancel hc0 hctop, mul_one]
    -- Step 5: `a < tⁿ g(tρ) ≤ h(ρ)`, as `B̄_{tρ}(x) ⊆ B_ρ(x)`
    calc a = a / ENNReal.ofReal (t ^ n) * ENNReal.ofReal (t ^ n) :=
          (ENNReal.div_mul_cancel hc0 hctop).symm
      _ < ν (closedBall x (t * ρ)) / (ω * ENNReal.ofReal ((t * ρ) ^ n)) * ENNReal.ofReal (t ^ n) :=
          (ENNReal.mul_lt_mul_iff_left hc0 hctop).2 hρ
      _ = ν (closedBall x (t * ρ)) / (ω * ENNReal.ofReal (ρ ^ n)) := hid
      _ ≤ ν (ball x ρ) / (ω * ENNReal.ofReal (ρ ^ n)) := by
          gcongr
          exact closedBall_subset_ball (by nlinarith)
  · -- Step 1: `h(ρ) ≤ g(ρ)`, as `B_ρ(x) ⊆ B̄_ρ(x)`
    filter_upwards [(tendsto_order.1 hg).2 b hb] with ρ hρ
    refine lt_of_le_of_lt ?_ hρ
    gcongr
    exact ball_subset_closedBall
/-- **Step 1 of Corollary 7.5.11** (`k ≥ 1`, Simon 7.5; Ch. 2, §4, (4.1)).  A nonempty embedded
`d`-dimensional `Cʳ` submanifold `M` of `ℝᴾ` has `d ≤ P`: for `y ∈ M` and a chart `ψ : V → W` at
`y`, `y ∈ W ∩ M = ψ(V)` gives `z ∈ V`, and the injective linear map `Dψ(z) : ℝᵈ → ℝᴾ` gives
`d = dim ℝᵈ ≤ dim ℝᴾ = P`. -/
theorem Submission.regcomp_cop_dim_le_of_embedded : ∀ (P d r : ℕ) (M : Set (Euclid P)), IsEmbeddedSubmanifold r d M → M.Nonempty → d ≤ P := by
  intro P d r M hM ⟨y, hy⟩
  -- a chart `ψ : V → W` of `M` at `y`
  obtain ⟨V, W, ψ, -, -, hyW, -, -, hψV, -, hDψ⟩ := hM y hy
  -- `y ∈ W ∩ M = ψ(V)`, so `y = ψ(z)` for some `z ∈ V`
  obtain ⟨z, hz, -⟩ : y ∈ ψ '' V := hψV ▸ ⟨hyW, hy⟩
  -- `Dψ(z) : ℝᵈ → ℝᴾ` is injective, so `d = dim ℝᵈ ≤ dim ℝᴾ = P`
  simpa using LinearMap.finrank_le_finrank_of_injective
    (f := (fderiv ℝ ψ z : Euclid d →ₗ[ℝ] Euclid P)) (hDψ z hz)
/-- **Simon 7.5** (`T = ∂[[E]]` with `E ⊆ N`): if `(N̄ \ N) ∩ U = ∅`, `E ⊆ N` and
`T(ω) = ∫_E ⟨dω, ξN⟩ dH^{n+1}` for `ω ∈ 𝒟ⁿ(U)`, then `spt T ⊆ N`.  A point `x ∈ spt T \ N` lies
outside `N̄`, so `B_ε(x) ⊆ U \ N̄` for some `ε > 0`.  `W = B_{ε/2}(x)` is open with `W̄` compact
in `U`, and every `ω` with `spt ω ⊆ W` has `spt dω ⊆ spt ω` disjoint from `E`.  So the integrand
vanishes on `E`, `T(ω) = 0`, and `x ∈ W` lies in the zero region of `T`. -/
theorem Submission.regcomp_cop_region_support_subset : ∀ (P n : ℕ) (U N E : Set (Euclid P)) (ξN : Euclid P → MultiVector P (n + 1)) (T : GeometricCurrentOn U n), IsOpen U → (closure N \ N) ∩ U = ∅ → E ⊆ N → IsBoundaryOfRegion T E ξN → T.support ⊆ N := by
  intro P n U N E ξN T hU hN hEN hT x hx
  obtain ⟨hxU, hxZ⟩ := hx
  by_contra hxN
  -- `x ∉ N̄`, since `(N̄ \ N) ∩ U = ∅`
  have hxN' : x ∉ closure N := fun h => hN.subset ⟨⟨h, hxN⟩, hxU⟩
  -- a ball `B_ε(x) ⊆ U \ N̄`
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp (hU.sdiff isClosed_closure) x ⟨hxU, hxN'⟩
  -- `W = B_{ε/2}(x)` is open, and `W̄ ⊆ B̄_{ε/2}(x)` is compact and contained in `B_ε(x) ⊆ U`
  have hcl : closure (ball x (ε / 2)) ⊆ ball x ε :=
    closure_ball_subset_closedBall.trans (closedBall_subset_ball (by linarith))
  refine hxZ ⟨ball x (ε / 2), ⟨isOpen_ball,
    (isCompact_closedBall x (ε / 2)).of_isClosed_subset isClosed_closure
      closure_ball_subset_closedBall, hcl.trans (hball.trans sdiff_subset), ?_⟩,
    mem_ball_self (half_pos hε)⟩
  -- `T` vanishes on `W`: for `spt ω ⊆ W`, `dω = 0` on `E ⊆ N`, so the integrand vanishes on `E`
  intro ω hω
  rw [hT ω]
  refine setIntegral_eq_zero_of_forall_eq_zero fun z hz => ?_
  have hzω : z ∉ tsupport (exteriorDerivative (ω : DifferentialForm (Euclid P) n)) := fun h =>
    (hball (ball_subset_ball (by linarith) (hω (tsupport_exteriorDerivative_subset _ h)))).2
      (subset_closure (hEN hz))
  rw [image_eq_zero_of_notMem_tsupport hzω, map_zero]
/-- **`∂[[E]]` is a cycle**: Simon 7.5.1 (`T = ∂[[E]]`, chapter-07.txt line 752) with (6.1.12)
`d²ω = 0` (chapter-06.txt line 150) and the boundary (6.2.3) `∂T(ω) = T(dω)`, `∂T = 0` if `n = 0`
(chapter-06.txt lines 216–220).  If `T(ω) = ∫_E ⟨dω, ξ_N⟩ dH^{n+1}` for every `ω ∈ 𝒟ⁿ(U)`, then
`∂T = 0` in `U`: for `n = m + 1` and `φ ∈ 𝒟ᵐ(U)`, `∂T(φ) = T(dφ) = ∫_E ⟨d(dφ), ξ_N⟩ dH^{m+2} = 0`,
since `d(dφ) = 0` for the smooth form `φ`.  No hypothesis on `U`, `E` or `ξ_N` is needed. -/
theorem Submission.regcomp_cop_region_boundary_vanishes : ∀ (P n : ℕ) (U E : Set (Euclid P)) (ξN : Euclid P → MultiVector P (n + 1)) (T : GeometricCurrentOn U n), IsBoundaryOfRegion T E ξN → BoundaryVanishes T := by
  intro P n
  cases n with
  | zero =>
    -- Degree `0`: `BoundaryVanishes T` is `True` (Simon's convention `∂T = 0`, 6.2.3).
    intro U E ξN T _
    trivial
  | succ m =>
    -- Degree `m + 1`: show `∂T = 0` by testing on every `φ ∈ 𝒟ᵐ(U)`.
    intro U E ξN T hT
    show T.boundary = 0
    apply GeometricCurrentOn.ext
    intro φ
    -- `∂T(φ) = T(dφ) = ∫_E ⟨d(dφ), ξ_N⟩ dH^{m+2}`: (6.2.3) and the hypothesis at `dφ ∈ 𝒟^{m+1}(U)`.
    rw [GeometricCurrentOn.boundary_apply, hT (exteriorDerivativeTestOn U m φ),
      GeometricCurrentOn.zero_apply]
    -- `d(dφ) = 0` for the smooth form `φ` (6.1.12), so the integrand is `ξ_N(x)(0) = 0`.
    have hdd : exteriorDerivative ((exteriorDerivativeTestOn U m φ : TestFormOn U (m + 1)) :
        DifferentialForm (Euclid P) (m + 1)) = 0 :=
      exteriorDerivative_sq φ.property.1.1
    simp only [hdd, Pi.zero_apply, map_zero, integral_zero]

/-- **Simon 7.5.1** (`T = ∂[[E]]` in `U`, `N ∈ 𝒪`, `E ⊆ N ∩ U`; Ch. 6, 2.3 and 2.11; Ch. 2, §4).
If `U` is open, `N ∈ 𝒪` is oriented by `ξN`, `E ⊆ N ∩ U` and `T(ω) = ∫_E ⟨dω, ξN⟩ dH^{n+1}` for
`ω ∈ 𝒟ⁿ(U)`, then `n + 1 ≤ P`, `spt T ⊆ U ∩ N` and `∂T = 0` in `U`.  A chart of `N` at a point
of `N ∩ U ≠ ∅` has injective derivative `ℝ^{n+1} → ℝᴾ`, so `n + 1 ≤ P`; `spt T ⊆ U` by
definition and `spt T ⊆ N` because `(N̄ \ N) ∩ U = ∅` and `E ⊆ N`; and
`∂T(φ) = T(dφ) = ∫_E ⟨d(dφ), ξN⟩ dH^{n+1} = 0`.  Minimality of `T` is not needed. -/
theorem Submission.codim1_region_support_cycle : ∀ (P n : ℕ) (U N E : Set (Euclid P)) (ξN : Euclid P → MultiVector P (n + 1)) (T : GeometricCurrentOn U n), IsOpen U → InClassO n U N ξN → E ⊆ N ∩ U → IsBoundaryOfRegion T E ξN → n + 1 ≤ P ∧ T.support ⊆ U ∩ N ∧ BoundaryVanishes T := by
  intro P n U N E ξN T hU hO hE hT
  obtain ⟨hN, -, hNU, hne⟩ := hO
  refine ⟨?_, fun x hx => ⟨T.support_subset_domain hx, ?_⟩, ?_⟩
  · -- `n + 1 ≤ P`: `N` is a nonempty embedded `(n + 1)`-dimensional submanifold of `ℝᴾ`
    exact Submission.regcomp_cop_dim_le_of_embedded P (n + 1) 2 N hN (hne.mono inter_subset_left)
  · -- `spt T ⊆ N`, since `(N̄ \ N) ∩ U = ∅` and `E ⊆ N`
    exact Submission.regcomp_cop_region_support_subset P n U N E ξN T hU hNU
      (hE.trans inter_subset_left) hT hx
  · -- `∂T = 0`: `∂T(φ) = T(dφ) = ∫_E ⟨d(dφ), ξN⟩ dH^{n+1} = 0`
    exact Submission.regcomp_cop_region_boundary_vanishes P n U E ξN T hT

/-- **Simon Ch. 6, Remark 3.2(1)** (chapter-06.txt lines 755–756, stated there without proof): if
`U` is open and `S, T ∈ 𝒟ₙ(U)` are integer multiplicity, so is `S − T`.  Let `S = τ(M₁, θ₁, ξ₁)`
and `T = τ(M₂, θ₂, ξ₂)`.  As `θᵢ ≥ 1` on `Mᵢ`, `Hⁿ(Mᵢ ∩ K) ≤ ∫_{Mᵢ ∩ K} θᵢ dHⁿ < ∞` for compact
`K ⊆ U`.  Locality of approximate tangent spaces (Simon Ch. 3, Remark 1.5(2)) gives
`TₓM₁ = Tₓ(M₁ ∩ M₂) = TₓM₂` for `Hⁿ`-a.e. `x ∈ M₁ ∩ M₂`, so `ξ₂ = ±ξ₁` there.  On the overlap
`1_{M₁} θ₁ ξ₁ − 1_{M₂} θ₂ ξ₂ = (θ₁ − σ θ₂) ξ₁` with `σ = ±1`, which yields a carrier
`C ⊆ M₁ ∪ M₂`, a multiplicity `1 ≤ θ ≤ θ₁ + θ₂` and a signed orientation `ξ` with
`1_C θ ξ = 1_{M₁} θ₁ ξ₁ − 1_{M₂} θ₂ ξ₂` `Hⁿ`-a.e.  Locality again (`C ∩ M₁ ⊆ M₁`, `C \ M₁ ⊆ M₂`,
both `⊆ C`) shows that `ξ` orients `TₓC`, so `(C, θ, ξ)` is a triple in `U`, and integrating the
pointwise identity against `ω ∈ 𝒟ⁿ(U)` shows that it represents `S − T`. -/
theorem Submission.regcomp_integer_multiplicity_sub : ∀ (P n : ℕ) (U : Set (Euclid P)) (S T : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity S → IsIntegerMultiplicity T → IsIntegerMultiplicity (S - T) := by
  rintro P n U S T hU ⟨R₁, hR₁⟩ ⟨R₂, hR₂⟩
  have hM₁ := R₁.measurableSet_carrier
  have hM₂ := R₂.measurableSet_carrier
  -- Step 1: a carrier has locally finite `Hⁿ`-measure in `U`, its multiplicity being `≥ 1`
  have hfin : ∀ R : IMRep U n, ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
      μHE[n] (R.carrier ∩ K) ≠ ∞ := by
    intro R K hK hKU
    refine ne_top_of_le_ne_top (R.locallyIntegrable_mult K hK hKU) ?_
    calc μHE[n] (R.carrier ∩ K) = ∫⁻ _ in R.carrier ∩ K, 1 ∂μHE[n] := (setLIntegral_one _).symm
      _ ≤ ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] :=
        setLIntegral_mono' (R.measurableSet_carrier.inter hK.measurableSet)
          fun x hx => Nat.one_le_cast.2 (R.mult_pos x hx.1)
  -- Step 2: `M₁` and `M₂` have the approximate tangent spaces of `M₁ ∩ M₂` a.e. on `M₁ ∩ M₂`
  have h₁ : ∀ᵐ x ∂(μHE[n].restrict (R₁.carrier ∩ R₂.carrier)), ∀ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n R₁.carrier x Q →
        HasApproximateTangentSpaceAt n (R₁.carrier ∩ R₂.carrier) x Q := by
    filter_upwards [Submission.regcomp_approx_tangent_locality P n U (R₁.carrier ∩ R₂.carrier)
      R₁.carrier hU (hM₁.inter hM₂) hM₁ inter_subset_left R₁.carrier_subset (hfin R₁)]
      with x hx Q hQ
    exact (hx Q).1 hQ
  have h₂ : ∀ᵐ x ∂(μHE[n].restrict (R₁.carrier ∩ R₂.carrier)), ∀ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n R₂.carrier x Q →
        HasApproximateTangentSpaceAt n (R₁.carrier ∩ R₂.carrier) x Q := by
    filter_upwards [Submission.regcomp_approx_tangent_locality P n U (R₁.carrier ∩ R₂.carrier)
      R₂.carrier hU (hM₁.inter hM₂) hM₂ inter_subset_right R₂.carrier_subset (hfin R₂)]
      with x hx Q hQ
    exact (hx Q).1 hQ
  -- Step 3: hence `ξ₂ = ±ξ₁` a.e. on `M₁ ∩ M₂`
  have hsign := Submission.regcomp_ims_overlap_orient_eq_or_neg P n U R₁ R₂ h₁ h₂
  -- Step 4: the data `(C, θ, ξ)` of the difference, `1_C θ ξ = 1_{M₁} θ₁ ξ₁ − 1_{M₂} θ₂ ξ₂` a.e.
  obtain ⟨C, θ, ξ, hC, hCsub, hθ, hθpos, hθle, hξ, hξ₁, hξ₂, hid⟩ :=
    Submission.regcomp_ims_difference_data P n U R₁ R₂ hsign
  -- Step 5: `C ⊆ M₁ ∪ M₂ ⊆ U` has locally finite `Hⁿ`-measure in `U`, and its approximate tangent
  -- spaces are those of `M₁` a.e. on `C ∩ M₁` and those of `M₂` a.e. on `C \ M₁ ⊆ M₂`
  have hCU : C ⊆ U := hCsub.trans (union_subset R₁.carrier_subset R₂.carrier_subset)
  have hCfin : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (C ∩ K) ≠ ∞ := by
    intro K hK hKU
    refine ne_top_of_le_ne_top (ENNReal.add_ne_top.2 ⟨hfin R₁ K hK hKU, hfin R₂ K hK hKU⟩) ?_
    calc μHE[n] (C ∩ K) ≤ μHE[n] (R₁.carrier ∩ K ∪ R₂.carrier ∩ K) := by
          rw [← union_inter_distrib_right]
          exact measure_mono (inter_subset_inter_left K hCsub)
      _ ≤ μHE[n] (R₁.carrier ∩ K) + μHE[n] (R₂.carrier ∩ K) := measure_union_le _ _
  have hl₁ : ∀ᵐ x ∂(μHE[n].restrict (C ∩ R₁.carrier)), ∀ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n R₁.carrier x Q → HasApproximateTangentSpaceAt n C x Q := by
    filter_upwards [Submission.regcomp_approx_tangent_locality P n U (C ∩ R₁.carrier) R₁.carrier hU
        (hC.inter hM₁) hM₁ inter_subset_right R₁.carrier_subset (hfin R₁),
      Submission.regcomp_approx_tangent_locality P n U (C ∩ R₁.carrier) C hU (hC.inter hM₁) hC
        inter_subset_left hCU hCfin] with x hx hxC Q hQ
    exact (hxC Q).2 ((hx Q).1 hQ)
  have hl₂ : ∀ᵐ x ∂(μHE[n].restrict (C \ R₁.carrier)), ∀ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n R₂.carrier x Q → HasApproximateTangentSpaceAt n C x Q := by
    have hsub : C \ R₁.carrier ⊆ R₂.carrier := fun x hx => (hCsub hx.1).resolve_left hx.2
    filter_upwards [Submission.regcomp_approx_tangent_locality P n U (C \ R₁.carrier) R₂.carrier hU
        (hC.diff hM₁) hM₂ hsub R₂.carrier_subset (hfin R₂),
      Submission.regcomp_approx_tangent_locality P n U (C \ R₁.carrier) C hU (hC.diff hM₁) hC
        sdiff_subset hCU hCfin] with x hx hxC Q hQ
    exact (hxC Q).2 ((hx Q).1 hQ)
  -- so `(C, θ, ξ)` is a triple in `U`
  obtain ⟨R, hRC, hRθ, hRξ⟩ := Submission.regcomp_ims_imrep_of_signed_pieces P n U C R₁ R₂ θ ξ
    hC hCsub hθ hθpos hθle hξ hξ₁ hξ₂ hl₁ hl₂
  -- Step 6: integrating the a.e. identity of Step 4, `τ(C, θ, ξ)(ω) = S(ω) − T(ω)`
  have hact := Submission.rsdic_imrep_action_int_combination P n U R₁ R₂ R 1 (-1) (by
    filter_upwards [hid] with x hx
    rw [hRC, hRθ, hRξ, hx]
    module)
  refine ⟨R, fun ω => ?_⟩
  calc (S - T) ω = S ω - T ω := rfl
    _ = R.action (ω : DifferentialForm (Euclid P) n) := by
      rw [hR₁ ω, hR₂ ω, hact ω]
      push_cast
      ring
/-- **Lusin's theorem** (Simon 1.17) for a `μ`-a.e. strongly measurable covector field
`f : ℝᴾ → Λⁿ(ℝᴾ)`.  `Λⁿ(ℝᴾ)` is finite-dimensional, hence second countable; give it the Borel
σ-algebra.  `f` agrees with the Borel modification `f' = hf.mk f` off a measurable `μ`-null set
`Z`, and Lusin's theorem for `f'` on `A \ Z` gives a compact `K ⊆ A \ Z` with
`μ((A \ Z) \ K) < ε` on which `f = f'` is continuous.  As `μ(Z) = 0`,
`μ(A \ K) = μ((A \ K) \ Z) = μ((A \ Z) \ K)`. -/
theorem Submission.dor_ims_lusin_continuousOn : ∀ (P n : ℕ) (μ : Measure (Euclid P)) (A : Set (Euclid P)) (f : Euclid P → Covector (Euclid P) n) (ε : ℝ), MeasurableSet A → μ A ≠ ∞ → AEStronglyMeasurable f μ → 0 < ε → ∃ K : Set (Euclid P), IsCompact K ∧ K ⊆ A ∧ μ (A \ K) < ENNReal.ofReal ε ∧ ContinuousOn f K := by
  intro P n μ A f ε hA hμA hf hε
  -- `Λⁿ(ℝᴾ)` is finite-dimensional, hence proper and second countable
  have := Submission.dor_ims_lusin_covector_finiteDimensional P n
  borelize (Covector (Euclid P) n)
  -- `f = f'` off a measurable null set `Z`
  obtain ⟨Z, hfZ, hZ, hZ0⟩ := exists_measurable_superset_of_null (ae_iff.mp hf.ae_eq_mk)
  obtain ⟨K, hK, hKA, hKμ, hfK⟩ := Submission.dor_ims_lusin_measurable_continuousOn P μ (A \ Z)
    (hf.mk f) (ENNReal.ofReal ε) hf.measurable_mk (hA.diff hZ)
    (ne_top_of_le_ne_top hμA (measure_mono sdiff_subset)) (ENNReal.ofReal_pos.mpr hε).ne'
  refine ⟨K, hK, hKA.trans sdiff_subset, ?_, hfK.congr fun x hx => ?_⟩
  · rwa [← measure_sdiff_null hZ0, sdiff_right_comm]
  · by_contra hfx
    exact (hKA hx).2 (hfZ hfx)
/-- **The Euclidean coefficient norm is a pulled-back Euclidean norm** (Simon Ch. 6, 1.2 and 1.5;
used by the smooth unit approximation behind the mass of `τ(M, θ, ξ)`).  With `e` the standard
basis of `ℝᴾ`, let `c_I α = α(e_{I(0)}, …, e_{I(n-1)})` for strictly increasing `I : Fin n → Fin P`
and `c_I = 0` otherwise.  Each `c_I` is a continuous linear functional, so
`A α = (c_I α)_I ∈ EuclideanSpace ℝ (Fin n → Fin P)` is continuous linear, and termwise
`‖A α‖ = √(∑_I c_I(α)²)` is the defining sum of `covectorEuclideanNorm α`. -/
theorem Submission.dor_ims_sua_coeff_norm_rep : ∀ (P n : ℕ), ∃ A : Covector (Euclid P) n →L[ℝ] EuclideanSpace ℝ (Fin n → Fin P), ∀ α : Covector (Euclid P) n, covectorEuclideanNorm α = ‖A α‖ := by
  intro P n
  -- Step 1: the coefficient functionals `c_I : α ↦ α(e_I)` for increasing `I`, else `0`
  let c : (Fin n → Fin P) → Covector (Euclid P) n →L[ℝ] ℝ := fun I =>
    if StrictMono I then
      ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ fun i => EuclideanSpace.basisFun (Fin P) ℝ (I i)
    else 0
  -- Step 2: `A α = (c_I α)_I`, moved into `EuclideanSpace ℝ (Fin n → Fin P)`
  refine ⟨(EuclideanSpace.equiv (Fin n → Fin P) ℝ).symm.toContinuousLinearMap.comp
    (ContinuousLinearMap.pi c), fun α => ?_⟩
  -- Step 3: `‖A α‖ = √(∑_I |c_I α|²)` and `|c_I α|² = [StrictMono I] α(e_I)²` termwise
  rw [EuclideanSpace.norm_eq, covectorEuclideanNorm]
  congr 1
  refine Finset.sum_congr rfl fun I _ => ?_
  by_cases hI : StrictMono I <;> simp [c, hI]
/-- **`Λⁿ(ℝᴾ)` is finite-dimensional** (Simon Ch. 6, 1.2; used by Tietze in the smooth unit
approximation behind the mass of `τ(M, θ, ξ)`).  With `e` the standard basis of `ℝᴾ`, the map
`Φ α = (α(e_{v(0)}, …, e_{v(n-1)}))_{v : Fin n → Fin P}` is linear into the finite-dimensional
space `ℝ^(Fin n → Fin P)`, and injective: alternating maps agreeing on distinct basis vectors are
equal, and a continuous alternating map is determined by its underlying alternating map. -/
theorem Submission.dor_ims_sua_covector_finiteDimensional : ∀ (P n : ℕ), FiniteDimensional ℝ (Covector (Euclid P) n) := by
  intro P n
  -- Step 1: the standard basis `e` of `ℝᴾ`
  let e := (EuclideanSpace.basisFun (Fin P) ℝ).toBasis
  -- Step 2: `Φ α = (α(e ∘ v))_v`, linear since covector operations are pointwise
  let Φ : Covector (Euclid P) n →ₗ[ℝ] ((Fin n → Fin P) → ℝ) :=
    { toFun := fun α v => α fun i => e (v i)
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  -- Steps 3–4: `Φ` is injective into the finite-dimensional `(Fin n → Fin P) → ℝ`
  refine FiniteDimensional.of_injective Φ fun α α' h => ?_
  exact ContinuousAlternatingMap.toAlternatingMap_injective
    (e.ext_alternating fun v _ => congr_fun h v)
/-- **Continuous unit extension** (steps 0 and 2–5 of the smooth unit approximation behind the
mass of `τ(M, θ, ξ)`).  Let `K ⊆ V ⊆ ℝᴾ`, `K` compact, `V` open, and let `β : ℝᴾ → Λⁿ(ℝᴾ)` be
continuous on `K` with `|β| ≤ 1` there, `|·|` the Euclidean coefficient norm.  Then `β|_K`
extends to a continuous `g` with compact support in `V` and `|g| ≤ 1` everywhere.  Tietze is
proved in place for the complete normed space `Λⁿ(ℝᴾ)`: partitions of unity subordinate to
finite `δ`-nets of `K` give continuous `G_k` with `‖G_k - β‖ ≤ 2⁻ᵏ` on `K`, and
`B = G₀ + ∑ₖ D_k`, with `D_k` the difference `G_{k+1} - G_k` clamped to the ball of radius
`2 · 2⁻ᵏ`, is a uniformly convergent series of continuous maps equal to `β` on `K`.  Then retract
radially by `ρ(α) = max(1, |α|)⁻¹ α` and cut off by `χ = max(0, 1 − dist(·, K)/r)` with
`cthickening r K ⊆ V`; `g = χ · (ρ ∘ B)`. -/
theorem Submission.dor_ims_sua_continuous_unit_extension : ∀ (P n : ℕ) (K V : Set (Euclid P)) (β : Euclid P → Covector (Euclid P) n), IsCompact K → IsOpen V → K ⊆ V → ContinuousOn β K → (∀ x ∈ K, covectorEuclideanNorm (β x) ≤ 1) → ∃ g : Euclid P → Covector (Euclid P) n, Continuous g ∧ HasCompactSupport g ∧ tsupport g ⊆ V ∧ (∀ x, covectorEuclideanNorm (g x) ≤ 1) ∧ ∀ x ∈ K, g x = β x := by
  intro P n K V β hK hV hKV hβ hβ1
  -- Step 0: if `K = ∅`, take `g = 0`
  rcases K.eq_empty_or_nonempty with rfl | hKne
  · exact ⟨0, continuous_zero, HasCompactSupport.zero, by simp, by simp, by simp⟩
  -- Step 1: `|α| = ‖A α‖`, so `|·|` is continuous and `|c • α| = |c| |α|`
  obtain ⟨A, hA⟩ := Submission.dor_ims_sua_coeff_norm_rep P n
  have hN1 : Continuous fun α : Covector (Euclid P) n => covectorEuclideanNorm α := by
    simpa only [hA] using A.continuous.norm
  have hN2 : ∀ (c : ℝ) (α : Covector (Euclid P) n),
      covectorEuclideanNorm (c • α) = |c| * covectorEuclideanNorm α := by
    intro c α
    rw [hA, hA, map_smul, norm_smul, Real.norm_eq_abs]
  -- Step 2: Tietze, a continuous `B` with `B = β` on `K`
  obtain ⟨B, hBc, hBK⟩ : ∃ B : Euclid P → Covector (Euclid P) n, Continuous B ∧
      ∀ x ∈ K, B x = β x := by
    -- (a) a partition of unity on a finite `δ`-net of `K` averages `β` to within `ε` on `K`
    have happrox : ∀ ε > 0, ∃ G : Euclid P → Covector (Euclid P) n, Continuous G ∧
        ∀ x ∈ K, ‖G x - β x‖ ≤ ε := by
      intro ε hε
      obtain ⟨δ, hδ, hβδ⟩ :=
        Metric.uniformContinuousOn_iff.1 (hK.uniformContinuousOn_of_continuous hβ) ε hε
      obtain ⟨t, htK, hKt⟩ :=
        hK.elim_nhds_subcover (fun a => ball a δ) fun a _ => ball_mem_nhds a hδ
      obtain ⟨φ, hφ⟩ := PartitionOfUnity.exists_isSubordinate hK.isClosed
        (fun a : t => ball (a : Euclid P) δ) (fun a => isOpen_ball) fun x hx => by
          obtain ⟨a, ha, hxa⟩ := mem_iUnion₂.1 (hKt hx)
          exact mem_iUnion.2 ⟨⟨a, ha⟩, hxa⟩
      refine ⟨fun x => ∑ a : t, φ a x • β a,
        continuous_finsetSum _ fun a _ => (φ a).continuous.smul continuous_const, fun x hx => ?_⟩
      have h1 : ∑ a : t, φ a x = 1 := by
        rw [← finsum_eq_sum_of_fintype]
        exact φ.sum_eq_one hx
      calc ‖∑ a : t, φ a x • β a - β x‖ = ‖∑ a : t, φ a x • (β a - β x)‖ := by
            simp only [smul_sub, Finset.sum_sub_distrib, ← Finset.sum_smul, h1, one_smul]
        _ ≤ ∑ a : t, ‖φ a x • (β a - β x)‖ := norm_sum_le _ _
        _ ≤ ∑ a : t, φ a x * ε := by
            refine Finset.sum_le_sum fun a _ => ?_
            rw [norm_smul, Real.norm_of_nonneg (φ.nonneg a x)]
            rcases eq_or_ne (φ a x) 0 with h | h
            · simp [h]
            · refine mul_le_mul_of_nonneg_left ?_ (φ.nonneg a x)
              rw [← dist_eq_norm]
              exact (hβδ a (htK a a.2) x hx (mem_ball'.1 (hφ a (subset_tsupport _ h)))).le
        _ = ε := by rw [← Finset.sum_mul, h1, one_mul]
    choose G hGc hGK using fun k : ℕ => happrox ((1 / 2) ^ k) (by positivity)
    -- (b) clamp `G_{k+1} - G_k` to the ball of radius `2 · 2⁻ᵏ`; on `K` nothing changes
    have hc : ∀ k : ℕ, 0 < 2 * (1 / 2 : ℝ) ^ k := fun k => by positivity
    obtain ⟨D, hD⟩ : ∃ D : ℕ → Euclid P → Covector (Euclid P) n, ∀ k x,
        D k x = (max 1 (‖G (k + 1) x - G k x‖ / (2 * (1 / 2) ^ k)))⁻¹ • (G (k + 1) x - G k x) :=
      ⟨_, fun _ _ => rfl⟩
    have hDc : ∀ k, Continuous (D k) := by
      intro k
      have hv : Continuous fun x => G (k + 1) x - G k x := (hGc (k + 1)).sub (hGc k)
      refine Continuous.congr ?_ fun x => (hD k x).symm
      exact ((continuous_const.max (hv.norm.div_const _)).inv₀ fun x =>
        (zero_lt_one.trans_le (le_max_left _ _)).ne').smul hv
    have hDb : ∀ k x, ‖D k x‖ ≤ 2 * (1 / 2) ^ k := by
      intro k x
      have hm : 0 < max 1 (‖G (k + 1) x - G k x‖ / (2 * (1 / 2) ^ k)) :=
        zero_lt_one.trans_le (le_max_left _ _)
      rw [hD, norm_smul, norm_inv, Real.norm_of_nonneg hm.le, inv_mul_le_iff₀ hm]
      calc ‖G (k + 1) x - G k x‖
          = ‖G (k + 1) x - G k x‖ / (2 * (1 / 2) ^ k) * (2 * (1 / 2) ^ k) :=
            (div_mul_cancel₀ _ (hc k).ne').symm
        _ ≤ max 1 (‖G (k + 1) x - G k x‖ / (2 * (1 / 2) ^ k)) * (2 * (1 / 2) ^ k) :=
            mul_le_mul_of_nonneg_right (le_max_right _ _) (hc k).le
    have hDK : ∀ k, ∀ x ∈ K, D k x = G (k + 1) x - G k x := by
      intro k x hx
      have h2 : ‖G (k + 1) x - G k x‖ ≤ 2 * (1 / 2) ^ k := by
        calc ‖G (k + 1) x - G k x‖ = ‖(G (k + 1) x - β x) - (G k x - β x)‖ := by
              rw [sub_sub_sub_cancel_right]
          _ ≤ ‖G (k + 1) x - β x‖ + ‖G k x - β x‖ := norm_sub_le _ _
          _ ≤ (1 / 2) ^ (k + 1) + (1 / 2) ^ k := add_le_add (hGK _ x hx) (hGK _ x hx)
          _ ≤ 2 * (1 / 2) ^ k := by
              rw [pow_succ]
              linarith [pow_pos (by norm_num : (0 : ℝ) < 1 / 2) k]
      rw [hD, max_eq_left ((div_le_one (hc k)).2 h2), inv_one, one_smul]
    -- (c) `B = G₀ + ∑ D_k` converges uniformly; on `K` the series telescopes to `β - G₀`
    refine ⟨fun x => G 0 x + ∑' k, D k x,
      (hGc 0).add (continuous_tsum hDc (summable_geometric_two.mul_left 2) hDb), fun x hx => ?_⟩
    have hs : Summable fun k => D k x :=
      Summable.of_norm_bounded (summable_geometric_two.mul_left 2) fun k => hDb k x
    have hTel : ∀ N, ∑ k ∈ Finset.range N, D k x = G N x - G 0 x := by
      intro N
      induction N with
      | zero => simp
      | succ N ih => rw [Finset.sum_range_succ, ih, hDK N x hx]; abel
    have hG : Tendsto (fun N => G N x) atTop (𝓝 (β x)) := by
      rw [tendsto_iff_norm_sub_tendsto_zero]
      exact squeeze_zero (fun N => norm_nonneg _) (fun N => hGK N x hx)
        (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num))
    have hlim := tendsto_nhds_unique hs.hasSum.tendsto_sum_nat
      ((hG.sub_const (G 0 x)).congr fun N => (hTel N).symm)
    show G 0 x + ∑' k, D k x = β x
    rw [hlim]
    abel
  -- Step 3: the radial retraction `ρ(α) = max(1, |α|)⁻¹ α` onto `{|α| ≤ 1}`
  let ρ : Covector (Euclid P) n → Covector (Euclid P) n :=
    fun α => (max 1 (covectorEuclideanNorm α))⁻¹ • α
  have hm : ∀ α : Covector (Euclid P) n, 0 < max 1 (covectorEuclideanNorm α) :=
    fun α => zero_lt_one.trans_le (le_max_left _ _)
  have hρ : Continuous ρ :=
    ((continuous_const.max hN1).inv₀ fun α => (hm α).ne').smul continuous_id
  have hρ1 : ∀ α, covectorEuclideanNorm (ρ α) ≤ 1 := by
    intro α
    rw [hN2, abs_of_pos (inv_pos.2 (hm α))]
    exact inv_mul_le_one_of_le₀ (le_max_right _ _) (hm α).le
  have hρid : ∀ α, covectorEuclideanNorm α ≤ 1 → ρ α = α := by
    intro α hα
    simp [ρ, max_eq_left hα]
  -- Step 4: the cut-off `χ = max(0, 1 − dist(·, K)/r)`, where `cthickening r K ⊆ V`
  obtain ⟨r, hr, hrV⟩ := hK.exists_cthickening_subset_open hV hKV
  let χ : Euclid P → ℝ := fun x => max 0 (1 - infDist x K / r)
  have hχ : Continuous χ :=
    continuous_const.max (continuous_const.sub ((continuous_infDist_pt K).div_const r))
  have hχ0 : ∀ x, 0 ≤ χ x := fun x => le_max_left _ _
  have hχ1 : ∀ x, χ x ≤ 1 := fun x =>
    max_le zero_le_one (sub_le_self _ (div_nonneg infDist_nonneg hr.le))
  have hχK : ∀ x ∈ K, χ x = 1 := by
    intro x hx
    simp [χ, infDist_zero_of_mem hx]
  have hχr : ∀ x, χ x ≠ 0 → x ∈ thickening r K := by
    intro x hx
    rw [mem_thickening_iff_infDist_lt hKne]
    by_contra h
    refine hx (max_eq_left ?_)
    rw [sub_nonpos, le_div_iff₀ hr, one_mul]
    exact not_lt.1 h
  -- Step 5: `g = χ · (ρ ∘ B)` has `tsupport g ⊆ cthickening r K ⊆ V`, compact
  have hsupp : support (fun x => χ x • ρ (B x)) ⊆ thickening r K := fun x hx =>
    hχr x fun h => hx (by simp [h])
  have htsupp : tsupport (fun x => χ x • ρ (B x)) ⊆ cthickening r K :=
    (closure_mono hsupp).trans (closure_thickening_subset_cthickening r K)
  refine ⟨fun x => χ x • ρ (B x), hχ.smul (hρ.comp hBc),
    hK.cthickening.of_isClosed_subset (isClosed_tsupport _) htsupp, htsupp.trans hrV,
    fun x => ?_, fun x hx => ?_⟩
  · -- `|g x| = χ x |ρ (B x)| ≤ χ x ≤ 1`
    rw [hN2, abs_of_nonneg (hχ0 x)]
    exact (mul_le_of_le_one_right (hχ0 x) (hρ1 _)).trans (hχ1 x)
  · -- on `K`: `χ = 1`, `B = β` and `|β| ≤ 1`, so `g = ρ ∘ β = β`
    simp only [hχK x hx, one_smul, hBK x hx, hρid _ (hβ1 x hx)]


/-- **Mollifying a unit covector field** (smooth unit approximation, step 6).  A continuous,
compactly supported `n`-covector field `g` with `tsupport g ⊆ V` (`V` open) and `|g| ≤ 1` for the
Euclidean coefficient norm `|·|` is uniformly `ε`-approximated in `|·|` by a test form `ω` with
`tsupport ω ⊆ V` and `|ω| ≤ 1`.

Write `|α| = ‖Aα‖` for a continuous linear coefficient map `A` (`dor_ims_sua_coeff_norm_rep`), so
`|α| ≤ ‖A‖‖α‖`.  Take `r > 0` with `cthickening r (tsupport g) ⊆ V`, and `s ≤ r` such that
`‖g y − g x‖ < ε/(‖A‖+1)` when `dist y x < s` (uniform continuity).  Let `ω = ψ ⋆ g`, where
`ψ = φ / ∫ φ` normalizes a smooth bump `φ ≥ 0` with `support φ = B_s(0)`.  Then `ω` is `C^∞` with
compact support and `tsupport ω ⊆ cthickening s (tsupport g) ⊆ V`; `Aω(x) = (ψ ⋆ (A ∘ g))(x)` is
an average of values of norm `|g| ≤ 1`; and `‖ω(x) − g(x)‖ ≤ ε/(‖A‖+1)`, whence
`|ω(x) − g(x)| ≤ ε`. -/
theorem Submission.dor_ims_sua_mollify_unit_field : ∀ (P n : ℕ) (V : Set (Euclid P)) (g : Euclid P → Covector (Euclid P) n) (ε : ℝ), IsOpen V → Continuous g → HasCompactSupport g → tsupport g ⊆ V → (∀ x, covectorEuclideanNorm (g x) ≤ 1) → 0 < ε → ∃ ω : DifferentialForm (Euclid P) n, IsTestForm ω ∧ tsupport ω ⊆ V ∧ (∀ x, covectorEuclideanNorm (ω x) ≤ 1) ∧ ∀ x, covectorEuclideanNorm (ω x - g x) ≤ ε := by
  intro P n V g ε hV hgc hgs hgV hg1 hε
  -- (1) the coefficient map `A` with `|α| = ‖A α‖ ≤ ‖A‖ ‖α‖`
  obtain ⟨A, hA⟩ := Submission.dor_ims_sua_coeff_norm_rep P n
  have hC : 0 < ‖A‖ + 1 := by positivity
  -- (2) a support margin `r`
  obtain ⟨r, hr, hrV⟩ := hgs.isCompact.exists_cthickening_subset_open hV hgV
  -- (3) uniform continuity of `g`, and the radius `s = min s₀ r`
  obtain ⟨s₀, hs₀, hgs₀⟩ := Metric.uniformContinuous_iff.mp
    (hgs.uniformContinuous_of_continuous hgc) (ε / (‖A‖ + 1)) (div_pos hε hC)
  have hs : 0 < min s₀ r := lt_min hs₀ hr
  -- (4) a smooth bump `φ` with `support φ = B_s(0)`, and `ψ = φ / ∫ φ`: `ψ ≥ 0`, `∫ ψ = 1`
  let φ : ContDiffBump (0 : Euclid P) := ⟨min s₀ r / 2, min s₀ r, half_pos hs, half_lt_self hs⟩
  have hφ : 0 < ∫ y, φ y := by
    refine (integral_pos_iff_support_of_nonneg φ.nonneg'
      (φ.continuous.integrable_of_hasCompactSupport φ.hasCompactSupport)).mpr ?_
    rw [φ.support_eq]
    exact measure_ball_pos volume 0 hs
  let ψ : Euclid P → ℝ := fun y => φ y / ∫ y, φ y
  have hψφ : support ψ ⊆ support φ := fun y hy h => hy (by simp [ψ, h])
  have hψs : support ψ ⊆ ball 0 (min s₀ r) := hψφ.trans φ.support_eq.subset
  have hψc : HasCompactSupport ψ := φ.hasCompactSupport.mono hψφ
  have hψ0 : ∀ y, 0 ≤ ψ y := fun y => div_nonneg φ.nonneg hφ.le
  have hψ1 : ∫ y, ψ y = 1 := by rw [integral_div, div_self hφ.ne']
  -- (5) `ω = ψ ⋆ g`
  let ω : DifferentialForm (Euclid P) n :=
    convolution ψ g (ContinuousLinearMap.lsmul ℝ ℝ) volume
  have hgi : LocallyIntegrable g volume := hgc.locallyIntegrable
  have hω : ConvolutionExists ψ g (ContinuousLinearMap.lsmul ℝ ℝ) volume :=
    hψc.convolutionExists_left _ (φ.continuous.div_const _) hgi
  refine ⟨ω, ⟨?_, ?_⟩, ?_, ?_, ?_⟩
  · -- (6) smoothness
    exact hψc.contDiff_convolution_left _ (φ.contDiff.div_const _) hgi
  · exact hψc.convolution _ hgs
  · -- (7) `spt ω ⊆ cthickening s (tsupport g) ⊆ V`
    have hsupp : support ω ⊆ thickening (min s₀ r) (tsupport g) := by
      refine (support_convolution_subset _).trans ?_
      rintro _ ⟨t, ht, z, hz, rfl⟩
      have ht' : ‖t‖ < min s₀ r := mem_ball_zero_iff.mp (hψs ht)
      exact mem_thickening_iff.mpr ⟨z, subset_tsupport g hz, by
        rwa [dist_eq_norm, add_sub_cancel_right]⟩
    calc tsupport ω ⊆ closure (thickening (min s₀ r) (tsupport g)) := closure_mono hsupp
      _ ⊆ cthickening (min s₀ r) (tsupport g) := closure_thickening_subset_cthickening _ _
      _ ⊆ cthickening r (tsupport g) := cthickening_mono (min_le_right _ _) _
      _ ⊆ V := hrV
  · -- (8) `|ω x| = ‖(ψ ⋆ (A ∘ g)) x‖ ≤ 1`
    intro x
    have hAω : A (ω x) = convolution ψ (fun y => A (g y))
        (ContinuousLinearMap.lsmul ℝ ℝ) volume x := by
      calc A (ω x) = ∫ t, A (ContinuousLinearMap.lsmul ℝ ℝ (ψ t) (g (x - t))) :=
            (A.integral_comp_comm (hω x).integrable).symm
        _ = _ := by simp only [convolution_def, ContinuousLinearMap.lsmul_apply, map_smul]
    rw [hA, hAω, ← dist_zero_right]
    exact dist_convolution_le zero_le_one hψs hψ0 hψ1
      (A.continuous.comp hgc).aestronglyMeasurable fun y _ => by
        rw [dist_zero_right, ← hA]
        exact hg1 y
  · -- (9) `‖ω x − g x‖ ≤ ε/(‖A‖+1)`, hence `|ω x − g x| ≤ ‖A‖ ε/(‖A‖+1) ≤ ε`
    intro x
    have hd : dist (ω x) (g x) ≤ ε / (‖A‖ + 1) :=
      dist_convolution_le (div_pos hε hC).le hψs hψ0 hψ1 hgc.aestronglyMeasurable fun y hy =>
        (hgs₀ ((mem_ball.mp hy).trans_le (min_le_left _ _))).le
    calc covectorEuclideanNorm (ω x - g x) = ‖A (ω x - g x)‖ := hA _
      _ ≤ ‖A‖ * dist (ω x) (g x) := by rw [dist_eq_norm]; exact A.le_opNorm _
      _ ≤ ‖A‖ * (ε / (‖A‖ + 1)) := by gcongr
      _ ≤ ε := by
        rw [mul_div_assoc', div_le_iff₀ hC]
        nlinarith [norm_nonneg A]

/-- **Smooth unit approximation** (Simon Ch. 6, 1.15 and 2.5; steps 4(c)–(d) of the mass formula
`M_W(T) = μ_T(W)` of Remark 3.2(3) for `T = τ(M, θ, ξ)`).  Extend `β|_K` to a continuous unit
field `g` with compact support in `V` and `g = β` on `K` (Tietze extension, radial retraction,
cut-off), then mollify: `ω = ψ ⋆ g` with `ψ = φ / ∫ φ` for a smooth bump `φ` supported in
`B_s(0)`, where `cthickening s (spt g) ⊆ V` and `s` is a modulus of uniform continuity of `𝒜 ∘ g`
for `δ`, `𝒜` being the coefficient map with `|α| = ‖𝒜 α‖`.  As `𝒜` commutes with the Bochner
integral, `𝒜 (ω x)` is a `ψ`-average of the values `𝒜 (g y)`, `|y - x| < s`; hence `|ω x| ≤ 1`
and `|ω x - g x| ≤ δ`, which is `|ω x - β x| ≤ δ` on `K`. -/
theorem Submission.dor_ims_smooth_unit_approx : ∀ (P n : ℕ) (K V : Set (Euclid P)) (β : Euclid P → Covector (Euclid P) n) (δ : ℝ), IsCompact K → IsOpen V → K ⊆ V → ContinuousOn β K → (∀ x ∈ K, covectorEuclideanNorm (β x) ≤ 1) → 0 < δ → ∃ ω : DifferentialForm (Euclid P) n, IsTestForm ω ∧ tsupport ω ⊆ V ∧ (∀ x, covectorEuclideanNorm (ω x) ≤ 1) ∧ ∀ x ∈ K, covectorEuclideanNorm (ω x - β x) ≤ δ := by
  intro P n K V β δ hK hV hKV hβ hβ1 hδ
  -- Steps 2–5: a continuous unit field `g`, compactly supported in `V`, with `g = β` on `K`
  obtain ⟨g, hg, hgc, hgV, hg1, hgK⟩ :=
    Submission.dor_ims_sua_continuous_unit_extension P n K V β hK hV hKV hβ hβ1
  -- Step 6: mollify `g` into a test form `ω` in `V` with `|ω| ≤ 1` and `|ω - g| ≤ δ` everywhere
  obtain ⟨ω, hω, hωV, hω1, hωg⟩ : ∃ ω : DifferentialForm (Euclid P) n, IsTestForm ω ∧
      tsupport ω ⊆ V ∧ (∀ x, covectorEuclideanNorm (ω x) ≤ 1) ∧
      ∀ x, covectorEuclideanNorm (ω x - g x) ≤ δ := by
    -- Step 1: the coefficient map `𝒜`, with `|α| = ‖𝒜 α‖`
    obtain ⟨A, hA⟩ := Submission.dor_ims_sua_coeff_norm_rep P n
    -- `cthickening r (spt g) ⊆ V`, as in step 4
    obtain ⟨r, hr, hrV⟩ := hgc.isCompact.exists_cthickening_subset_open hV hgV
    -- `𝒜 ∘ g` is continuous with compact support, so uniformly continuous; `s₀` is a modulus
    -- for `δ`
    have hAg : Continuous fun y => A (g y) := A.continuous.comp hg
    obtain ⟨s₀, hs₀, hs₀δ⟩ := Metric.uniformContinuous_iff.1
      ((hgc.comp_left (map_zero A)).uniformContinuous_of_continuous hAg) δ hδ
    -- the kernel: `ψ = φ / ∫ φ` for the bump `φ` with `support φ = B_s(0)`, `s = min r s₀`, is
    -- `C^∞` with compact support, `ψ ≥ 0`, `∫ ψ = 1` and `support ψ ⊆ B_s(0)`
    have hs : 0 < min r s₀ := lt_min hr hs₀
    obtain ⟨ψ, hψ, hψc, hψ0, hψ1, hψs⟩ : ∃ ψ : Euclid P → ℝ, ContDiff ℝ (⊤ : ℕ∞) ψ ∧
        HasCompactSupport ψ ∧ (∀ y, 0 ≤ ψ y) ∧ ∫ y, ψ y = 1 ∧
        support ψ ⊆ ball 0 (min r s₀) := by
      let φ : ContDiffBump (0 : Euclid P) := ⟨min r s₀ / 2, min r s₀, half_pos hs, half_lt_self hs⟩
      have hφ : 0 < ∫ y, φ y := by
        rw [integral_pos_iff_support_of_nonneg φ.nonneg'
          (φ.continuous.integrable_of_hasCompactSupport φ.hasCompactSupport), φ.support_eq]
        exact measure_ball_pos _ _ hs
      have hsupp : support (fun y => φ y / ∫ y, φ y) ⊆ support φ := fun y hy =>
        (div_ne_zero_iff.1 hy).1
      exact ⟨fun y => φ y / ∫ y, φ y, φ.contDiff.div_const _, φ.hasCompactSupport.mono hsupp,
        fun y => div_nonneg φ.nonneg hφ.le, by rw [integral_div, div_self hφ.ne'],
        hsupp.trans φ.support_eq.subset⟩
    -- `ω = ψ ⋆ g`, and (N4): `𝒜` commutes with the Bochner integral, so `𝒜 ∘ ω = ψ ⋆ (𝒜 ∘ g)`
    have hψg : ∀ x, ConvolutionExistsAt ψ g x (ContinuousLinearMap.lsmul ℝ ℝ) volume :=
      hψc.convolutionExists_left _ hψ.continuous hg.locallyIntegrable
    have hAω : ∀ x, A (convolution ψ g (ContinuousLinearMap.lsmul ℝ ℝ) volume x) =
        convolution ψ (fun y => A (g y)) (ContinuousLinearMap.lsmul ℝ ℝ) volume x := by
      intro x
      rw [convolution_def, convolution_def, ← A.integral_comp_comm (hψg x).integrable]
      simp only [ContinuousLinearMap.lsmul_apply, map_smul]
    refine ⟨convolution ψ g (ContinuousLinearMap.lsmul ℝ ℝ) volume, ⟨?_, ?_⟩, ?_, ?_, ?_⟩
    -- 6(i): `ω` is `C^∞` with compact support
    · exact hψc.contDiff_convolution_left _ hψ hg.locallyIntegrable
    · exact hψc.convolution _ hgc
    -- 6(ii): `support ω ⊆ B_s(0) + spt g = thickening s (spt g)`, so
    -- `spt ω ⊆ cthickening s (spt g) ⊆ cthickening r (spt g) ⊆ V`
    · have hsupp : support (convolution ψ g (ContinuousLinearMap.lsmul ℝ ℝ) volume) ⊆
          thickening (min r s₀) (tsupport g) := by
        refine (support_convolution_subset _).trans ?_
        rw [← ball_add_zero]
        exact add_subset_add hψs (subset_tsupport g)
      exact (closure_minimal (hsupp.trans (thickening_subset_cthickening _ _))
        isClosed_cthickening).trans ((cthickening_mono (min_le_left r s₀) _).trans hrV)
    -- 6(iii): `|ω x| = ‖(ψ ⋆ 𝒜 ∘ g) x‖ ≤ 1`, since `‖𝒜 (g y)‖ = |g y| ≤ 1`
    · intro x
      rw [hA, hAω, ← dist_zero_right]
      exact dist_convolution_le zero_le_one hψs hψ0 hψ1 hAg.aestronglyMeasurable fun y _ => by
        rw [dist_zero_right, ← hA]
        exact hg1 y
    -- 6(iv): `|ω x - g x| = ‖(ψ ⋆ 𝒜 ∘ g) x - 𝒜 (g x)‖ ≤ δ`, since `|y - x| < s ≤ s₀`
    · intro x
      rw [hA, map_sub, hAω, ← dist_eq_norm]
      exact dist_convolution_le hδ.le hψs hψ0 hψ1 hAg.aestronglyMeasurable fun y hy =>
        (hs₀δ ((mem_ball.1 hy).trans_le (min_le_right r s₀))).le
  -- Step 7: `g = β` on `K`
  refine ⟨ω, hω, hωV, hω1, fun x hx => ?_⟩
  rw [← hgK x hx]
  exact hωg x

/-- **Local mass of `m₀[[M]]`** (Simon Ch. 6, 2.5 and Remark 3.2(3) with constant multiplicity;
step 3 of the density computation at points of `reg T`).  If `T(ω) = m₀ ∫_M ⟨ω, ξ⟩ dHⁿ` for every
test form `ω` with `spt ω ⊆ W`, where `W ⊆ U` is open, `ξ` is a continuous unit orientation on `M`
and `Hⁿ(M ∩ W) < ∞`, then `M_W(T) = |m₀| Hⁿ(M ∩ W)`.  Upper bound: `|ξ(α)| ≤ |α|`, so
`|⟨ω, ξ⟩| ≤ 1_W` on `M` and `T(ω) ≤ |m₀| Hⁿ(M ∩ W)` for admissible `ω`.  Lower bound: take a
compact `K ⊆ M ∩ W` with `Hⁿ((M ∩ W) \ K) < η` (inner regularity of the finite measure
`Hⁿ⌞(M ∩ W)`) and an admissible `ω` with `|ω - β| ≤ η` on `K`, where `β = sgn(m₀) L(ξ)` has
`m₀ ⟨β, ξ⟩ = |m₀|`; then `T(ω) ≥ |m₀| a - |m₀| η (2 + a)` with `a = Hⁿ(M ∩ W)`, and `η → 0`. -/
theorem Submission.dimred_rpd_massOn_eq_mult_measure : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (M W : Set (Euclid P)) (m₀ : ℤ) (ξ : Euclid P → MultiVector P n), IsOpen W → W ⊆ U → MeasurableSet M → ContinuousOn ξ M → (∀ x ∈ M, ∃ Q : Submodule ℝ (Euclid P), IsUnitOrientationOf (ξ x) Q) → μHE[n] (M ∩ W) ≠ ∞ → (∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ W → T ω = m₀ * ∫ x in M, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → T.massOn W = (m₀.natAbs : ℝ≥0∞) * μHE[n] (M ∩ W) := by
  intro P n U T M W m₀ ξ hW hWU hM hξc hξu hfin hrep
  -- Step 1: the dual map `L`, and `|ξ x α| ≤ |α|` for `x ∈ M`
  obtain ⟨L, hL⟩ := Submission.dor_ims_unitOrientation_dual P n
  have hMW : MeasurableSet (M ∩ W) := hM.inter hW.measurableSet
  have hdual : ∀ x ∈ M, ∀ α : Covector (Euclid P) n, |ξ x α| ≤ covectorEuclideanNorm α := by
    intro x hx α
    obtain ⟨Q, hQ⟩ := hξu x hx
    exact (hL (ξ x) Q hQ).1 α
  -- Step 2: `1_W` is integrable on `M` with integral `Hⁿ(M ∩ W)`
  have hind : Integrable (W.indicator (fun _ => (1 : ℝ)))
      ((μHE[n] : Measure (Euclid P)).restrict M) := by
    rw [integrable_indicator_iff hW.measurableSet]
    refine integrableOn_const ?_
    rw [Measure.restrict_apply hW.measurableSet, inter_comm]
    exact hfin
  have hind_int : ∫ x in M, W.indicator (fun _ => (1 : ℝ)) x ∂μHE[n] =
      (μHE[n] : Measure (Euclid P)).real (M ∩ W) := by
    rw [integral_indicator hW.measurableSet, setIntegral_const, smul_eq_mul, mul_one,
      Measure.real, Measure.real, Measure.restrict_apply hW.measurableSet, inter_comm]
  -- `|⟨ω, ξ⟩| ≤ 1_W` on `M` if `spt ω ⊆ W` and `|ω| ≤ 1`, so `⟨ω, ξ⟩` is integrable on `M`
  have hbound : ∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ W →
      (∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) x) ≤ 1) →
      ∀ x ∈ M, ‖ξ x ((ω : DifferentialForm (Euclid P) n) x)‖ ≤
        W.indicator (fun _ => (1 : ℝ)) x := by
    intro ω hωW hω1 x hx
    by_cases hxW : x ∈ W
    · rw [indicator_of_mem hxW, Real.norm_eq_abs]
      exact (hdual x hx _).trans (hω1 x)
    · rw [indicator_of_notMem hxW]
      have h0 : (ω : DifferentialForm (Euclid P) n) x = 0 :=
        image_eq_zero_of_notMem_tsupport (fun h => hxW (hωW h))
      simp [h0]
  have hcontf : ∀ ω : TestFormOn U n,
      ContinuousOn (fun x => ξ x ((ω : DifferentialForm (Euclid P) n) x)) M := by
    intro ω
    have hωc : Continuous (ω : DifferentialForm (Euclid P) n) := ω.property.1.1.continuous
    exact hξc.clm_apply hωc.continuousOn
  have hintf : ∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ W →
      (∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) x) ≤ 1) →
      Integrable (fun x => ξ x ((ω : DifferentialForm (Euclid P) n) x))
        ((μHE[n] : Measure (Euclid P)).restrict M) := by
    intro ω hωW hω1
    refine hind.mono' ((hcontf ω).aestronglyMeasurable hM) ?_
    exact (ae_restrict_iff' hM).2 (Eventually.of_forall (hbound ω hωW hω1))
  have hcast : ENNReal.ofReal |(m₀ : ℝ)| = (m₀.natAbs : ℝ≥0∞) := by
    rw [← Int.cast_abs, ← Int.natCast_natAbs, Int.cast_natCast, ENNReal.ofReal_natCast]
  apply le_antisymm
  · -- Step 3: upper bound, `T(ω) ≤ |m₀| Hⁿ(M ∩ W)` for every admissible `ω`
    apply sSup_le
    rintro r ⟨ω, ⟨hωW, hω1⟩, rfl⟩
    have hI : ‖∫ x in M, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]‖ ≤
        (μHE[n] : Measure (Euclid P)).real (M ∩ W) := by
      calc ‖∫ x in M, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]‖
          ≤ ∫ x in M, ‖ξ x ((ω : DifferentialForm (Euclid P) n) x)‖ ∂μHE[n] :=
            norm_integral_le_integral_norm _
        _ ≤ ∫ x in M, W.indicator (fun _ => (1 : ℝ)) x ∂μHE[n] :=
            integral_mono_of_nonneg (Eventually.of_forall fun _ => norm_nonneg _) hind
              ((ae_restrict_iff' hM).2 (Eventually.of_forall (hbound ω hωW hω1)))
        _ = _ := hind_int
    have hTω : T ω ≤ |(m₀ : ℝ)| * (μHE[n] : Measure (Euclid P)).real (M ∩ W) := by
      rw [hrep ω hωW]
      calc (m₀ : ℝ) * ∫ x in M, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]
          ≤ |(m₀ : ℝ) * ∫ x in M, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]| :=
            le_abs_self _
        _ = |(m₀ : ℝ)| * ‖∫ x in M, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]‖ := by
            rw [abs_mul, Real.norm_eq_abs]
        _ ≤ _ := mul_le_mul_of_nonneg_left hI (abs_nonneg _)
    calc ENNReal.ofReal (T ω)
        ≤ ENNReal.ofReal (|(m₀ : ℝ)| * (μHE[n] : Measure (Euclid P)).real (M ∩ W)) :=
          ENNReal.ofReal_le_ofReal hTω
      _ = (m₀.natAbs : ℝ≥0∞) * μHE[n] (M ∩ W) := by
          rw [ENNReal.ofReal_mul (abs_nonneg _), Measure.real, ENNReal.ofReal_toReal hfin, hcast]
  · -- Step 4: lower bound; `m₀ = 0` is trivial, otherwise `s₀ = sgn m₀` has `m₀ s₀ = |m₀|`
    rcases eq_or_ne m₀ 0 with rfl | hm₀
    · simp
    set a : ℝ := (μHE[n] : Measure (Euclid P)).real (M ∩ W) with ha
    have ha0 : 0 ≤ a := measureReal_nonneg
    set s₀ : ℝ := if (0 : ℝ) < m₀ then 1 else -1 with hs₀
    have hs₀m : (m₀ : ℝ) * s₀ = |(m₀ : ℝ)| := by
      rw [hs₀]
      split_ifs with h
      · rw [mul_one, abs_of_pos h]
      · rw [abs_of_nonpos (not_lt.1 h)]; ring
    have hs₀abs : s₀ = 1 ∨ s₀ = -1 := by
      rw [hs₀]; split_ifs <;> simp
    -- Step 5: the dual field `β = s₀ L(ξ)`: continuous on `M`, `|β| ≤ 1` and `m₀ ⟨β, ξ⟩ = |m₀|`
    set β : Euclid P → Covector (Euclid P) n := fun x => s₀ • L (ξ x) with hβ
    have hβc : ContinuousOn β M :=
      (L.continuous.comp_continuousOn hξc).const_smul s₀
    have hβ1 : ∀ x ∈ M, covectorEuclideanNorm (β x) ≤ 1 := by
      intro x hx
      obtain ⟨Q, hQ⟩ := hξu x hx
      have h1 := (hL (ξ x) Q hQ).2.1
      rcases hs₀abs with h | h
      · have hx' : β x = L (ξ x) := by
          simp only [hβ, h]; exact one_smul ℝ (L (ξ x))
        rw [hx']; exact h1
      · have hx' : β x = -(L (ξ x)) := by
          simp only [hβ, h]; exact neg_one_smul ℝ (L (ξ x))
        rw [hx', covectorEuclideanNorm_neg]; exact h1
    have hβξ : ∀ x ∈ M, (m₀ : ℝ) * ξ x (β x) = |(m₀ : ℝ)| := by
      intro x hx
      obtain ⟨Q, hQ⟩ := hξu x hx
      have h1 := (hL (ξ x) Q hQ).2.2
      simp only [hβ, map_smul, smul_eq_mul, h1, mul_one]
      exact hs₀m
    -- Steps 6–7: `|m₀| a - |m₀| η (2 + a) ≤ M_W(T)` for every `η > 0`
    have hmain : ∀ η : ℝ, 0 < η →
        ENNReal.ofReal (|(m₀ : ℝ)| * a - |(m₀ : ℝ)| * η * (2 + a)) ≤ T.massOn W := by
      intro η hη
      -- Step 6(a): a compact `K ⊆ M ∩ W` with `Hⁿ((M ∩ W) \ K) < η`
      have : IsFiniteMeasure ((μHE[n] : Measure (Euclid P)).restrict (M ∩ W)) :=
        ⟨by rw [Measure.restrict_apply_univ]; exact hfin.lt_top⟩
      have hνA : ((μHE[n] : Measure (Euclid P)).restrict (M ∩ W)) (M ∩ W) ≠ ∞ := measure_ne_top _ _
      obtain ⟨K, hKA, hKc, hKsmall⟩ :=
        hMW.exists_isCompact_sdiff_lt (μ := (μHE[n] : Measure (Euclid P)).restrict (M ∩ W)) hνA
          (ENNReal.ofReal_pos.2 hη).ne'
      rw [Measure.restrict_apply (hMW.diff hKc.measurableSet)] at hKsmall
      have hdiffeq : (M ∩ W) \ K ∩ (M ∩ W) = (M ∩ W) \ K := by
        ext x; simp only [mem_inter_iff, Set.mem_sdiff]; tauto
      rw [hdiffeq] at hKsmall
      -- Step 6(b)–(c): an admissible `ω` with `|ω - β| ≤ η` on `K`
      obtain ⟨ω₀, hω₀test, hω₀W, hω₀1, hω₀K⟩ := Submission.dor_ims_smooth_unit_approx P n K W β η
        hKc hW (hKA.trans inter_subset_right) (hβc.mono (hKA.trans inter_subset_left))
        (fun x hx => hβ1 x (hKA hx).1) hη
      let ω : TestFormOn U n := ⟨ω₀, hω₀test, hω₀W.trans hWU⟩
      have hωW : tsupport (ω : DifferentialForm (Euclid P) n) ⊆ W := hω₀W
      have hω1 : ∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) x) ≤ 1 := hω₀1
      have hadm : ω ∈ massAdmissibleOn U n W := ⟨hωW, hω1⟩
      have hle := T.le_massOn hadm
      refine le_trans ?_ hle
      apply ENNReal.ofReal_le_ofReal
      -- Step 7: `T(ω) = ∫_K f + ∫_{M \ K} f` with `f = m₀ ⟨ω, ξ⟩`
      set f : Euclid P → ℝ := fun x => (m₀ : ℝ) * ξ x ((ω : DifferentialForm (Euclid P) n) x)
        with hf
      have hfint : Integrable f ((μHE[n] : Measure (Euclid P)).restrict M) :=
        (hintf ω hωW hω1).const_mul _
      have hTω : T ω = ∫ x in M, f x ∂μHE[n] := by
        rw [hrep ω hωW, hf, integral_const_mul]
      have hKM : K ⊆ M := hKA.trans inter_subset_left
      have hsplit : ∫ x in M, f x ∂μHE[n] = ∫ x in K, f x ∂μHE[n] + ∫ x in M \ K, f x ∂μHE[n] := by
        rw [← setIntegral_union disjoint_sdiff_right (hM.diff hKc.measurableSet)
          (hfint.mono_measure (Measure.restrict_mono hKM le_rfl))
          (hfint.mono_measure (Measure.restrict_mono sdiff_subset le_rfl)),
          union_sdiff_cancel hKM]
      -- Step 7(c): `a - η ≤ Hⁿ(K) ≤ a`
      have hKfin : μHE[n] K ≠ ∞ := ne_top_of_le_ne_top hfin (measure_mono hKA)
      have hKle : (μHE[n] : Measure (Euclid P)).real K ≤ a :=
        measureReal_mono hKA hfin
      have hKge : a - η ≤ (μHE[n] : Measure (Euclid P)).real K := by
        have h1 : (μHE[n] : Measure (Euclid P)) (M ∩ W) ≤ μHE[n] K + μHE[n] ((M ∩ W) \ K) := by
          calc (μHE[n] : Measure (Euclid P)) (M ∩ W) ≤ μHE[n] (K ∪ (M ∩ W) \ K) :=
                measure_mono (fun x hx => by by_cases h : x ∈ K <;> simp_all)
            _ ≤ _ := measure_union_le _ _
        have h2 : (μHE[n] : Measure (Euclid P)) (M ∩ W) ≤ μHE[n] K + ENNReal.ofReal η :=
          h1.trans (add_le_add le_rfl hKsmall.le)
        have h3 := ENNReal.toReal_mono (by finiteness) h2
        rw [ENNReal.toReal_add hKfin ENNReal.ofReal_ne_top, ENNReal.toReal_ofReal hη.le] at h3
        simp only [Measure.real, ha] at h3 ⊢
        linarith
      -- Step 7(a): on `K`, `f ≥ |m₀| (1 - η)`
      have hKpart : |(m₀ : ℝ)| * (1 - η) * (μHE[n] : Measure (Euclid P)).real K ≤
          ∫ x in K, f x ∂μHE[n] := by
        have hconst : ∀ x ∈ K, |(m₀ : ℝ)| * (1 - η) ≤ f x := by
          intro x hxK
          have hxM : x ∈ M := hKM hxK
          have hsplitx : f x = (m₀ : ℝ) * ξ x (β x) +
              (m₀ : ℝ) * ξ x ((ω : DifferentialForm (Euclid P) n) x - β x) := by
            simp only [hf, map_sub]; ring
          rw [hsplitx, hβξ x hxM]
          have hd : |(m₀ : ℝ) * ξ x ((ω : DifferentialForm (Euclid P) n) x - β x)| ≤
              |(m₀ : ℝ)| * η := by
            rw [abs_mul]
            exact mul_le_mul_of_nonneg_left ((hdual x hxM _).trans (hω₀K x hxK)) (abs_nonneg _)
          have := neg_abs_le ((m₀ : ℝ) * ξ x ((ω : DifferentialForm (Euclid P) n) x - β x))
          nlinarith
        have := setIntegral_ge_of_const_le_real hKc.measurableSet hKfin hconst
          (hfint.mono_measure (Measure.restrict_mono hKM le_rfl))
        simpa [Measure.real] using this
      -- Step 7(b): on `M \ K`, `|f| ≤ |m₀| 1_W`, so `|∫_{M \ K} f| ≤ |m₀| Hⁿ((M ∩ W) \ K) ≤ |m₀| η`
      have hRest : |∫ x in M \ K, f x ∂μHE[n]| ≤ |(m₀ : ℝ)| * η := by
        have hb : ∀ x ∈ M \ K, ‖f x‖ ≤ |(m₀ : ℝ)| * W.indicator (fun _ => (1 : ℝ)) x := by
          intro x hx
          rw [hf, norm_mul, Real.norm_eq_abs]
          exact mul_le_mul_of_nonneg_left (hbound ω hωW hω1 x hx.1) (abs_nonneg _)
        have hint2 : Integrable (fun x => |(m₀ : ℝ)| * W.indicator (fun _ => (1 : ℝ)) x)
            ((μHE[n] : Measure (Euclid P)).restrict (M \ K)) :=
          (hind.mono_measure (Measure.restrict_mono sdiff_subset le_rfl)).const_mul _
        calc |∫ x in M \ K, f x ∂μHE[n]| = ‖∫ x in M \ K, f x ∂μHE[n]‖ := (Real.norm_eq_abs _).symm
          _ ≤ ∫ x in M \ K, ‖f x‖ ∂μHE[n] := norm_integral_le_integral_norm _
          _ ≤ ∫ x in M \ K, |(m₀ : ℝ)| * W.indicator (fun _ => (1 : ℝ)) x ∂μHE[n] :=
              integral_mono_of_nonneg (Eventually.of_forall fun _ => norm_nonneg _) hint2
                ((ae_restrict_iff' (hM.diff hKc.measurableSet)).2 (Eventually.of_forall hb))
          _ = |(m₀ : ℝ)| * (μHE[n] : Measure (Euclid P)).real ((M \ K) ∩ W) := by
              rw [integral_const_mul, integral_indicator hW.measurableSet, setIntegral_const,
                smul_eq_mul, mul_one, Measure.real, Measure.real,
                Measure.restrict_apply hW.measurableSet, inter_comm]
          _ ≤ |(m₀ : ℝ)| * η := by
              apply mul_le_mul_of_nonneg_left _ (abs_nonneg _)
              have hset : (M \ K) ∩ W = (M ∩ W) \ K := by
                ext x; simp only [mem_inter_iff, Set.mem_sdiff]; tauto
              rw [hset]
              have := ENNReal.toReal_mono ENNReal.ofReal_ne_top hKsmall.le
              rwa [ENNReal.toReal_ofReal hη.le] at this
      -- combining (a)–(c): `T(ω) ≥ |m₀| a - |m₀| η (2 + a)`
      rw [hTω, hsplit]
      have hRest' := neg_abs_le (∫ x in M \ K, f x ∂μHE[n])
      have hm0 : 0 ≤ |(m₀ : ℝ)| := abs_nonneg _
      have e1 := mul_le_mul_of_nonneg_left hKge hm0
      have e2 := mul_le_mul_of_nonneg_left hKle (mul_nonneg hm0 hη.le)
      nlinarith [e1, e2, hKpart, hRest, hRest']
    -- Step 8: let `η → 0`
    have hlim : Tendsto (fun η : ℝ => ENNReal.ofReal (|(m₀ : ℝ)| * a - |(m₀ : ℝ)| * η * (2 + a)))
        (𝓝[>] 0) (𝓝 (ENNReal.ofReal (|(m₀ : ℝ)| * a))) := by
      apply ENNReal.tendsto_ofReal
      have : Tendsto (fun η : ℝ => |(m₀ : ℝ)| * a - |(m₀ : ℝ)| * η * (2 + a)) (𝓝 0)
          (𝓝 (|(m₀ : ℝ)| * a - |(m₀ : ℝ)| * 0 * (2 + a))) := by
        exact (tendsto_const_nhds.sub ((tendsto_const_nhds.mul tendsto_id).mul tendsto_const_nhds))
      simpa using this.mono_left nhdsWithin_le_nhds
    have hge := le_of_tendsto hlim (eventually_nhdsWithin_of_forall fun η hη => hmain η hη)
    calc (m₀.natAbs : ℝ≥0∞) * μHE[n] (M ∩ W) = ENNReal.ofReal (|(m₀ : ℝ)| * a) := by
          rw [ENNReal.ofReal_mul (abs_nonneg _), ha, Measure.real, ENNReal.ofReal_toReal hfin,
            hcast]
      _ ≤ T.massOn W := hge

/-- **Density of `k[[M]]` at a point of `M`** (Simon 7.4.1: `Θᵐ(μ_T, y) = |k|` when `T = k[[M]]`
in `B_ρ(y)` and `y ∈ M`).  For `0 < s < ρ` the ball `B_s(y)` is open, `B_s(y) ⊆ B_ρ(y) ⊆ U`, and
`Hᵐ(M ∩ B_s(y)) ≤ Hᵐ(M ∩ B̄_s(y)) < ∞` since `B̄_s(y) ⊆ B_ρ(y)` is compact; `M` is Borel and `ξ`
is a continuous unit orientation, so the local mass identity gives
`M_{B_s(y)}(T) = |k| Hᵐ(M ∩ B_s(y))`.  The density ratio of `T` is thus `|k|` times that of
`Hᵐ⌞M`, which tends to `1` as `s ↓ 0` (density one on an embedded `C¹` submanifold). -/
theorem Submission.codim1_dolr_rep_hasMassDensity : ∀ (P m : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U m) (y : Euclid P) (ρ : ℝ) (k : ℤ) (M : Set (Euclid P)) (ξ : Euclid P → MultiVector P m), 0 < ρ → ball y ρ ⊆ U → y ∈ M → IsEmbeddedSubmanifold 1 m M → IsOrientation m M ξ → (∀ K : Set (Euclid P), IsCompact K → K ⊆ ball y ρ → μHE[m] (M ∩ K) ≠ ∞) → (∀ ω : TestFormOn U m, tsupport (ω : DifferentialForm (Euclid P) m) ⊆ ball y ρ → T ω = k * ∫ x in M, ξ x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m]) → HasMassDensity T y (k.natAbs : ℝ) := by
  intro P m U T y ρ k M ξ hρ hballU hyM hMemb hξ hfin hrep
  -- Step 1: `M` is Borel; `ξ(x)` is a unit orientation of some subspace at every `x ∈ M`
  obtain ⟨hMmeas, -⟩ := Submission.dimred_rpd_embedded_locally_closed P 1 m M hMemb
  have hunit : ∀ x ∈ M, ∃ Q : Submodule ℝ (Euclid P), IsUnitOrientationOf (ξ x) Q := by
    intro x hx
    obtain ⟨Q, -, hQ⟩ := hξ.2 x hx
    exact ⟨Q, hQ⟩
  -- Step 2: `M_{B_s(y)}(T) = |k| Hᵐ(M ∩ B_s(y))` for `0 < s < ρ`
  have hmass : ∀ s : ℝ, 0 < s → s < ρ →
      T.massOn (ball y s) = (k.natAbs : ℝ≥0∞) * μHE[m] (M ∩ ball y s) := by
    intro s _hs hsρ
    have hsub : ball y s ⊆ ball y ρ := ball_subset_ball hsρ.le
    refine Submission.dimred_rpd_massOn_eq_mult_measure P m U T M (ball y s) k ξ isOpen_ball
      (hsub.trans hballU) hMmeas hξ.1 hunit ?_ ?_
    · exact ne_top_of_le_ne_top (hfin _ (isCompact_closedBall y s) (closedBall_subset_ball hsρ))
        (measure_mono (inter_subset_inter_right _ ball_subset_closedBall))
    · intro ω hω
      exact hrep ω (hω.trans hsub)
  -- Steps 3–5: the density ratio of `T` is `|k|` times that of `Hᵐ⌞M`, which tends to `1`
  refine ⟨Nat.cast_nonneg _, ?_⟩
  rw [ENNReal.ofReal_natCast]
  have hlim := ENNReal.Tendsto.const_mul (a := (k.natAbs : ℝ≥0∞))
    (Submission.dimred_rpd_submanifold_density_one P m M y hMemb hyM)
    (Or.inr (ENNReal.natCast_ne_top _))
  rw [mul_one] at hlim
  refine hlim.congr' ?_
  filter_upwards [Ioo_mem_nhdsGT hρ] with s hs
  rw [hmass s hs.1 hs.2, mul_div_assoc]
/-- **Support of a locally represented current** (Simon Ch. 6, 2.11, for `T = k[[M]]` as in Simon
7.4.1): let `W ⊆ U` be open, `k ≠ 0`, and `M` an embedded `C¹` submanifold oriented by `ξ`,
relatively closed in `W`, with `Hᵐ(M ∩ K) < ∞` for compact `K ⊆ W`.  If `T(ω) = k ∫_M ⟨ω, ξ⟩ dHᵐ`
whenever `spt ω ⊆ W`, then `spt T ∩ W = M ∩ W`.  A point of `W \ M` is the center of a ball with
compact closure in `W` that misses `M`, and `T` vanishes on that ball.  If `T` vanished near
`w ∈ M ∩ W`, a small ball `B` about `w` would have `M_B(T) = 0`, whereas the mass identity and
density one give `M_B(T) = |k| Hᵐ(M ∩ B) > 0`. -/
theorem Submission.codim1_dolr_rep_support_inter : ∀ (P m : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U m) (W M : Set (Euclid P)) (k : ℤ) (ξ : Euclid P → MultiVector P m), IsOpen W → W ⊆ U → k ≠ 0 → IsEmbeddedSubmanifold 1 m M → IsOrientation m M ξ → closure M ∩ W ⊆ M → (∀ K : Set (Euclid P), IsCompact K → K ⊆ W → μHE[m] (M ∩ K) ≠ ∞) → (∀ ω : TestFormOn U m, tsupport (ω : DifferentialForm (Euclid P) m) ⊆ W → T ω = k * ∫ x in M, ξ x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m]) → T.support ∩ W = M ∩ W := by
  intro P m U T W M k ξ hW hWU hk hMemb hξ hcl hfin hrep
  -- Step 0: `M` is Borel, and `ξ(x)` is a unit orientation of a subspace for every `x ∈ M`
  obtain ⟨hMmeas, -⟩ := Submission.dimred_rpd_embedded_locally_closed P 1 m M hMemb
  have hunit : ∀ x ∈ M, ∃ Q : Submodule ℝ (Euclid P), IsUnitOrientationOf (ξ x) Q := by
    intro x hx
    obtain ⟨Q, -, hQ⟩ := hξ.2 x hx
    exact ⟨Q, hQ⟩
  ext x
  constructor
  -- Step 1 (`spt T ∩ W ⊆ M`): for `x ∈ W \ M`, `T` vanishes on a ball about `x` whose closure is
  -- compact, lies in `W` and misses `closure M`; so `x ∈ T.zeroRegion`
  · rintro ⟨hxS, hxW⟩
    refine ⟨?_, hxW⟩
    by_contra hxM
    have hxcl : x ∉ closure M := fun h => hxM (hcl ⟨h, hxW⟩)
    obtain ⟨r₁, hr₁, hr₁s⟩ := Metric.isOpen_iff.mp isClosed_closure.isOpen_compl x hxcl
    obtain ⟨r₂, hr₂, hr₂s⟩ := Metric.isOpen_iff.mp hW x hxW
    have hr : 0 < min r₁ r₂ / 2 := half_pos (lt_min hr₁ hr₂)
    have hcb : closedBall x (min r₁ r₂ / 2) ⊆ ball x (min r₁ r₂) :=
      closedBall_subset_ball (half_lt_self (lt_min hr₁ hr₂))
    have hb1 : ball x (min r₁ r₂) ⊆ ball x r₁ := ball_subset_ball (min_le_left _ _)
    have hb2 : ball x (min r₁ r₂) ⊆ ball x r₂ := ball_subset_ball (min_le_right _ _)
    apply hxS.2
    refine Set.mem_sUnion.mpr ⟨ball x (min r₁ r₂ / 2), ⟨isOpen_ball, ?_, ?_, ?_⟩, mem_ball_self hr⟩
    · rw [closure_ball x hr.ne']
      exact isCompact_closedBall x _
    · rw [closure_ball x hr.ne']
      exact hcb.trans (hb2.trans (hr₂s.trans hWU))
    -- a test form supported in the ball vanishes on `M`, so `T(ω) = k ∫_M 0 = 0`
    · intro ω hω
      have hωb : tsupport (ω : DifferentialForm (Euclid P) m) ⊆ ball x (min r₁ r₂) :=
        hω.trans (ball_subset_closedBall.trans hcb)
      rw [hrep ω (hωb.trans (hb2.trans hr₂s)), setIntegral_eq_zero_of_forall_eq_zero, mul_zero]
      intro z hz
      have hz' : z ∉ tsupport (ω : DifferentialForm (Euclid P) m) := by
        intro h
        exact hr₁s (hb1 (hωb h)) (subset_closure hz)
      rw [image_eq_zero_of_notMem_tsupport hz']
      simp
  -- Step 2 (`M ∩ W ⊆ spt T`): suppose `x ∈ M ∩ W` lies in an open `O` on which `T` vanishes, and
  -- take the ball `B = B_{r₁/2}(x)` with `closedBall x (r₁ / 2) ⊆ O ∩ W`
  · rintro ⟨hxM, hxW⟩
    refine ⟨⟨hWU hxW, ?_⟩, hxW⟩
    intro hz
    obtain ⟨O, ⟨hO, -, -, hvan⟩, hxO⟩ := Set.mem_sUnion.mp hz
    obtain ⟨r₁, hr₁, hr₁s⟩ := Metric.isOpen_iff.mp (hO.inter hW) x ⟨hxO, hxW⟩
    have hr : 0 < r₁ / 2 := half_pos hr₁
    have hcb : closedBall x (r₁ / 2) ⊆ O ∩ W :=
      (closedBall_subset_ball (half_lt_self hr₁)).trans hr₁s
    have hballW : ball x (r₁ / 2) ⊆ W := ball_subset_closedBall.trans (hcb.trans inter_subset_right)
    -- every admissible `ω` has `spt ω ⊆ B ⊆ O`, so `T(ω) = 0` and `M_B(T) = 0`
    have hzero : T.massOn (ball x (r₁ / 2)) = 0 := by
      refine nonpos_iff_eq_zero.mp ?_
      unfold GeometricCurrentOn.massOn
      refine sSup_le ?_
      rintro _ ⟨ω, hω, rfl⟩
      dsimp only
      rw [hvan ω (hω.1.trans (ball_subset_closedBall.trans (hcb.trans inter_subset_left)))]
      simp
    -- the mass identity on `B`: `M_B(T) = |k| Hᵐ(M ∩ B)`, where `Hᵐ(M ∩ B) < ∞` because
    -- `closedBall x (r₁ / 2) ⊆ W` is compact
    have hmass := Submission.dimred_rpd_massOn_eq_mult_measure P m U T M (ball x (r₁ / 2)) k ξ
      isOpen_ball (hballW.trans hWU) hMmeas hξ.1 hunit
      (ne_top_of_le_ne_top (hfin _ (isCompact_closedBall x _) (hcb.trans inter_subset_right))
        (measure_mono (inter_subset_inter_right _ ball_subset_closedBall)))
      (fun ω hω => hrep ω (hω.trans hballW))
    -- density one at `x`: `Hᵐ(M ∩ B_s(x)) / (ωₘsᵐ) > 0` for some `s ∈ (0, r₁/2)`, so
    -- `Hᵐ(M ∩ B) ≠ 0`
    have hpos : μHE[m] (M ∩ ball x (r₁ / 2)) ≠ 0 := by
      have hlim := Submission.dimred_rpd_submanifold_density_one P m M x hMemb hxM
      obtain ⟨s, hs1, hs2⟩ :=
        ((hlim.eventually (lt_mem_nhds zero_lt_one)).and (Ioo_mem_nhdsGT hr)).exists
      intro h0
      have : μHE[m] (M ∩ ball x s) = 0 :=
        measure_mono_null (inter_subset_inter_right _ (ball_subset_ball hs2.2.le)) h0
      rw [this, ENNReal.zero_div] at hs1
      exact lt_irrefl _ hs1
    -- `|k| ≠ 0`, so `|k| Hᵐ(M ∩ B) ≠ 0`, contradicting `M_B(T) = 0`
    have hk' : (k.natAbs : ℝ≥0∞) ≠ 0 := by simpa using hk
    rw [hmass] at hzero
    exact mul_ne_zero hk' hpos hzero

/-- **Multiplicity one near a regular point of density one** (Simon 7.4.1; Ch. 3, 1.8(2);
Ch. 6, 2.5 and 2.11).  Let `y ∈ reg T`, so `T = k[[M]]` in `B_{ρ_y}(y)` with `k ≠ 0` and
`y ∈ M`, and let `Θᵐ(μ_T, y) = 1`.  The density of `k[[M]]` at `y` is `|k|`, so `k = ±1` by
uniqueness of limits.  Take `ρ₀ = min(ε, ρ_y/2)`, where `M ∩ closedBall(y, ε)` is compact; then
`M` is relatively closed in `B_ρ(y)` for `ρ ≤ ρ₀`, so `spt T ∩ B_ρ(y) = M ∩ B_ρ(y)`.  This open
piece of `M` is an embedded `C¹` submanifold with the tangent spaces of `M`, it is oriented by
`ξ = kξ_y = ±ξ_y`, its `Hᵐ`-measure is at most `Hᵐ(M ∩ closedBall(y, ρ)) < ∞`, and
`T(ω) = ∫_M ⟨ω, ξ⟩ dHᵐ = ∫_{M ∩ B_ρ(y)} ⟨ω, ξ⟩ dHᵐ` when `spt ω ⊆ B_ρ(y)`. -/
theorem Submission.codim1_density_one_regular_local_rep : ∀ (P m : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U m) (y : Euclid P), 1 ≤ m → IsOpen U → y ∈ regularSet T → HasMassDensity T y 1 → ∃ ρ₀ : ℝ, 0 < ρ₀ ∧ ball y ρ₀ ⊆ U ∧ ∀ ρ : ℝ, 0 < ρ → ρ ≤ ρ₀ → ∃ ξ : Euclid P → MultiVector P m, IsEmbeddedSubmanifold 1 m (T.support ∩ ball y ρ) ∧ IsOrientation m (T.support ∩ ball y ρ) ξ ∧ μHE[m] (T.support ∩ ball y ρ) ≠ ∞ ∧ ∀ ω : TestFormOn U m, tsupport (ω : DifferentialForm (Euclid P) m) ⊆ ball y ρ → T ω = ∫ x in T.support ∩ ball y ρ, ξ x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m] := by
  intro P m U T y _h1m _hU hy hd
  -- Step 1: `y ∈ reg T` gives `T = k[[M]]` in `B_{ρ_y}(y)` with `k ≠ 0` and `y ∈ M`
  obtain ⟨_hyS, ρy, hρy, hballU, k, M, ξy, hk, hyM, hMemb, hξ, hfin, hrep⟩ := hy
  -- Step 2: `Θᵐ(μ_T, y) = |k|` and `Θᵐ(μ_T, y) = 1`, so `k = ±1`
  have hdk := Submission.codim1_dolr_rep_hasMassDensity P m U T y ρy k M ξy hρy hballU hyM
    hMemb hξ hfin hrep
  have hk1 : k.natAbs = 1 := by
    have h := tendsto_nhds_unique hd.2 hdk.2
    rw [ENNReal.ofReal_one, ENNReal.ofReal_natCast] at h
    exact_mod_cast h.symm
  have hkpm : k = 1 ∨ k = -1 := by
    rcases Int.natAbs_eq_iff.mp hk1 with h | h
    · left; simpa using h
    · right; simpa using h
  -- Step 3: `ρ₀ = min(ε, ρ_y/2)`, with `M` Borel and `M ∩ closedBall(y, ε)` compact
  obtain ⟨hMmeas, hloc⟩ := Submission.dimred_rpd_embedded_locally_closed P 1 m M hMemb
  obtain ⟨ε, hε, hcpt⟩ := hloc y hyM
  refine ⟨min ε (ρy / 2), lt_min hε (half_pos hρy), ?_, ?_⟩
  · exact (ball_subset_ball ((min_le_right _ _).trans (half_le_self hρy.le))).trans hballU
  intro ρ hρ hρle
  have hρε : ρ ≤ ε := hρle.trans (min_le_left _ _)
  have hρρy : ρ < ρy := lt_of_le_of_lt (hρle.trans (min_le_right _ _)) (half_lt_self hρy)
  have hballsub : ball y ρ ⊆ ball y ρy := ball_subset_ball hρρy.le
  -- Step 4: `M` is relatively closed in `B_ρ(y)`, and `T = k[[M]]` in `B_ρ(y)`
  have hcl : closure M ∩ ball y ρ ⊆ M := by
    intro x hx
    have h1 : x ∈ closure (M ∩ ball y ρ) := isOpen_ball.closure_inter hx
    have h2 : closure (M ∩ ball y ρ) ⊆ M ∩ closedBall y ε := by
      rw [← hcpt.isClosed.closure_eq]
      exact closure_mono (inter_subset_inter_right _
        (ball_subset_closedBall.trans (closedBall_subset_closedBall hρε)))
    exact (h2 h1).1
  have hfinW : ∀ K : Set (Euclid P), IsCompact K → K ⊆ ball y ρ → μHE[m] (M ∩ K) ≠ ∞ :=
    fun K hK hKs => hfin K hK (hKs.trans hballsub)
  have hrepW : ∀ ω : TestFormOn U m, tsupport (ω : DifferentialForm (Euclid P) m) ⊆ ball y ρ →
      T ω = k * ∫ x in M, ξy x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m] :=
    fun ω hω => hrep ω (hω.trans hballsub)
  -- Step 5: `spt T ∩ B_ρ(y) = M ∩ B_ρ(y)`
  have hsupp := Submission.codim1_dolr_rep_support_inter P m U T (ball y ρ) M k ξy isOpen_ball
    (hballsub.trans hballU) hk hMemb hξ hcl hfinW hrepW
  -- Step 6: the open piece `M ∩ B_ρ(y)` is an embedded `C¹` submanifold with the tangent
  -- spaces of `M`
  obtain ⟨hemb, htan⟩ := Submission.codim1_dolr_embedded_inter_open P 1 m M (ball y ρ) hMemb
    isOpen_ball
  -- Step 7: `ξ = kξ_y = ±ξ_y` on `spt T ∩ B_ρ(y) = M ∩ B_ρ(y)`
  refine ⟨fun x => (k : ℝ) • ξy x, ?_, ?_, ?_, ?_⟩
  · -- (i) an embedded `C¹` `m`-submanifold
    rw [hsupp]
    exact hemb
  · -- (ii) `±ξ_y` is continuous and orients the (unchanged) tangent spaces
    rw [hsupp]
    refine ⟨(hξ.1.mono inter_subset_left).const_smul (k : ℝ), fun w hw => ?_⟩
    obtain ⟨Q, hQ, τ, horth, hspan, hsign⟩ := hξ.2 w hw.1
    refine ⟨Q, by rw [htan w hw.2]; exact hQ, τ, horth, hspan, ?_⟩
    rcases hkpm with rfl | rfl
    · simpa using hsign
    · rcases hsign with h | h
      · right; intro α; simp [h α]
      · left; intro α; simp [h α]
  · -- (iii) `Hᵐ(M ∩ B_ρ(y)) ≤ Hᵐ(M ∩ closedBall(y, ρ)) < ∞`
    rw [hsupp]
    exact ne_top_of_le_ne_top (hfin _ (isCompact_closedBall y ρ) (closedBall_subset_ball hρρy))
      (measure_mono (inter_subset_inter_right _ ball_subset_closedBall))
  · -- (iv) `T(ω) = ∫_M ⟨ω, kξ_y⟩ dHᵐ`, and `ω = 0` on `M \ B_ρ(y)`
    intro ω hω
    rw [hsupp, hrepW ω hω, ← integral_const_mul,
      setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hMmeas
        (inter_subset_left : M ∩ ball y ρ ⊆ M)]
    · refine setIntegral_congr_fun (hMmeas.inter isOpen_ball.measurableSet) fun x _ => ?_
      simp
    · intro x hx
      have hx' : x ∉ tsupport (ω : DifferentialForm (Euclid P) m) := fun h => hx.2 ⟨hx.1, hω h⟩
      rw [image_eq_zero_of_notMem_tsupport hx']
      simp
/-- **Local-to-global gluing** (the partition-of-unity argument of Simon Ch. 6, 2.11).  Suppose
every point of the open set `O` has an open neighbourhood `B` such that
`C(ω) = ∫_M ⟨ω(z), ξ(z)⟩ dHᵐ(z)` for every test form `ω` with `spt ω ⊆ B`.  Then the identity
holds for every `ω ∈ 𝒟ᵐ(ℝᴾ)` with `spt ω ⊆ O`.  Finitely many such `B₁, …, B_N` cover the compact
set `K = spt ω`.  A smooth partition of unity `ψ₁, …, ψ_N` on `K` subordinate to them splits
`ω = Σⱼ ψⱼω` into test forms with `spt (ψⱼω) ⊆ Bⱼ`.  Each integrand `⟨ψⱼω, ξ⟩` is continuous on the
Borel set `M` and bounded by `(sup |ψⱼω|) · 1_K`, which is integrable as `Hᵐ(M ∩ K) < ∞`; so the
integral is additive over `j`. -/
theorem Submission.codim1_ovr_partition_glue_rep : ∀ (P m : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) m) (M O : Set (Euclid P)) (ξ : Euclid P → MultiVector P m), IsOpen O → MeasurableSet M → ContinuousOn ξ M → (∀ x ∈ M, ∀ α : Covector (Euclid P) m, |ξ x α| ≤ covectorEuclideanNorm α) → (∀ K : Set (Euclid P), IsCompact K → μHE[m] (M ∩ K) ≠ ∞) → (∀ x ∈ O, ∃ B : Set (Euclid P), IsOpen B ∧ x ∈ B ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) m, tsupport (ω : DifferentialForm (Euclid P) m) ⊆ B → C ω = ∫ z in M, ξ z ((ω : DifferentialForm (Euclid P) m) z) ∂μHE[m]) → ∀ ω : TestFormOn (univ : Set (Euclid P)) m, tsupport (ω : DifferentialForm (Euclid P) m) ⊆ O → C ω = ∫ z in M, ξ z ((ω : DifferentialForm (Euclid P) m) z) ∂μHE[m] := by
  intro P m C M O ξ hO hMm hξc hξb hfin hloc ω hωO
  classical
  set ω₀ : DifferentialForm (Euclid P) m := (ω : DifferentialForm (Euclid P) m) with hω₀
  -- `K = spt ω` is compact, and `ω` is smooth
  set K := tsupport ω₀ with hKdef
  have hKc : IsCompact K := ω.property.1.2
  have hωs : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) ω₀ := ω.property.1.1
  -- the Euclidean covector norm is continuous
  have hnc : Continuous fun α : Covector (Euclid P) m => covectorEuclideanNorm α := by
    unfold covectorEuclideanNorm
    refine Real.continuous_sqrt.comp (continuous_finsetSum _ fun I _ => ?_)
    split_ifs
    · exact ((ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ
        (fun i => EuclideanSpace.basisFun (Fin P) ℝ (I i))).continuous).pow 2
    · exact continuous_const
  -- finitely many of the local neighbourhoods `B x`, `x ∈ K`, cover `K`
  choose! B hBo hxB hBrep using hloc
  obtain ⟨t, ht⟩ := hKc.elim_finite_subcover (fun x : K => B x) (fun x => hBo x (hωO x.2))
    (fun x hx => mem_iUnion.2 ⟨⟨x, hx⟩, hxB x (hωO hx)⟩)
  let Wt : t → Set (Euclid P) := fun i => B ((i : K) : Euclid P)
  have hKt : K ⊆ ⋃ i, Wt i := by
    intro x hx
    obtain ⟨y, hy, hxy⟩ := mem_iUnion₂.1 (ht hx)
    exact mem_iUnion.2 ⟨⟨y, hy⟩, hxy⟩
  -- a smooth partition of unity `ψᵢ` on `K` with `spt ψᵢ ⊆ Wᵢ`
  obtain ⟨ψ, hψ⟩ := SmoothPartitionOfUnity.exists_isSubordinate
    (modelWithCornersSelf ℝ (Euclid P)) hKc.isClosed Wt (fun i => hBo _ (hωO (i : K).2)) hKt
  have hψs : ∀ i, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (ψ i) :=
    fun i => contMDiff_iff_contDiff.mp (ψ i).contMDiff
  -- each `ψᵢω` is a test form supported in `Wᵢ`
  have hmem : ∀ i, (fun x => ψ i x • ω₀ x) ∈ TestFormOn (univ : Set (Euclid P)) m ∧
      tsupport (fun x => ψ i x • ω₀ x) ⊆ Wt i := by
    intro i
    have hsK : tsupport (fun x => ψ i x • ω₀ x) ⊆ K := tsupport_smul_subset_right _ _
    refine ⟨⟨⟨?_, ?_⟩, subset_univ _⟩, (tsupport_smul_subset_left _ _).trans (hψ i)⟩
    · exact (hψs i).smul hωs
    · exact IsCompact.of_isClosed_subset hKc (isClosed_tsupport _) hsK
  let ωi : t → TestFormOn (univ : Set (Euclid P)) m := fun i => ⟨_, (hmem i).1⟩
  -- `ω = Σᵢ ψᵢω`, since `Σᵢ ψᵢ = 1` on `K` and `ω = 0` off `K`
  have hpt : ∀ x, ω₀ x = ∑ i, ψ i x • ω₀ x := by
    intro x
    by_cases hx : x ∈ K
    · rw [← Finset.sum_smul, ← finsum_eq_sum_of_fintype, ψ.sum_eq_one hx, one_smul]
    · have h0 : ω₀ x = 0 := image_eq_zero_of_notMem_tsupport hx
      simp [h0]
  have hsum : ω = ∑ i, ωi i := by
    apply Subtype.ext
    funext x
    rw [Submodule.coe_sum, Finset.sum_apply]
    exact hpt x
  -- each piece is represented, and its integrand is integrable on `M`
  have hpiece : ∀ i, C (ωi i) = ∫ z in M, ξ z (ψ i z • ω₀ z) ∂μHE[m] :=
    fun i => hBrep _ (hωO (i : K).2) (ωi i) (hmem i).2
  have hint : ∀ i, IntegrableOn (fun z => ξ z (ψ i z • ω₀ z)) M μHE[m] := by
    intro i
    have hcont : Continuous fun x => ψ i x • ω₀ x := (hψs i).continuous.smul hωs.continuous
    obtain ⟨S, hS⟩ := (hnc.comp hcont).bounded_above_of_compact_support
      (((hmem i).1.1.2).comp_left (covectorEuclideanNorm_zero P m))
    refine Integrable.mono' (g := K.indicator fun _ => S) ?_ ?_ ?_
    · refine IntegrableOn.integrable_indicator ?_ hKc.isClosed.measurableSet
      show IntegrableOn (fun _ => S) K (μHE[m].restrict M)
      refine integrableOn_const ?_
      rw [Measure.restrict_apply hKc.isClosed.measurableSet, inter_comm]
      exact hfin _ hKc
    · exact (hξc.clm_apply hcont.continuousOn).aestronglyMeasurable hMm
    · refine (ae_restrict_iff' hMm).2 (Eventually.of_forall fun z hz => ?_)
      by_cases hzK : z ∈ K
      · rw [indicator_of_mem hzK, Real.norm_eq_abs]
        refine (hξb z hz _).trans ?_
        have := hS z
        rw [Function.comp_apply, Real.norm_eq_abs] at this
        exact (le_abs_self _).trans this
      · rw [indicator_of_notMem hzK, image_eq_zero_of_notMem_tsupport hzK, smul_zero, map_zero,
          norm_zero]
  -- linearity of `C` and of the integral: sum the pieces
  calc C ω = ∑ i, C (ωi i) := by
        rw [hsum]; exact map_sum (C.toCurrent : TestFormOn (univ : Set (Euclid P)) m →ₗ[ℝ] ℝ) _ _
    _ = ∑ i, ∫ z in M, ξ z (ψ i z • ω₀ z) ∂μHE[m] := Finset.sum_congr rfl fun i _ => hpiece i
    _ = ∫ z in M, ∑ i, ξ z (ψ i z • ω₀ z) ∂μHE[m] :=
        (integral_finsetSum _ fun i _ => hint i).symm
    _ = ∫ z in M, ξ z (ω₀ z) ∂μHE[m] := by
        congr 1; funext z
        rw [← map_sum, ← hpt z]
/-- **Gluing local orientations** (the off-vertex representation of a regular cone, used with
Simons' theorem in the proof of Simon 7.5.8; orientations as in 6.2.2, `[[M]]` as in 6.2.16).
Let `M` be a Borel embedded `C¹` `m`-submanifold and, for `y ∈ M`, let `C = [[M ∩ B_y]]` (with an
orientation `ξ_y` of `M ∩ B_y`) on forms supported in `B_y = B_{ρ(y)}(y)`, `Hᵐ(M ∩ B_y) < ∞`.
Then `ξ(x) := ξ_x(x)` orients `M`, agrees with every `ξ_y` on `M ∩ B_y`, and `C = [[M]]` (oriented
by `ξ`) on forms supported in some `B_y`.  The pieces `M ∩ B_y` have the tangent spaces of `M`
(`Submission.codim1_ovr_embedded_submanifold_local`), so `ξ_{y'} = ±ξ_y` at a common point `w`
(`Submission.rsdic_unitOrientation_eq_or_eq_neg`).  The sign `−` is impossible: for
`β = L(ξ_y(w))` (`Submission.dor_ims_unitOrientation_dual`) and a bump `φ` near `w`, the two
representations give `C(φβ) > 0` and `C(−φβ) > 0`, because `Hᵐ(M ∩ B_s(w)) > 0` for `s > 0`
(`Submission.dimred_rpd_submanifold_density_one`). -/
theorem Submission.codim1_ovr_orientation_glue : ∀ (P m : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) m) (M : Set (Euclid P)) (ρ : Euclid P → ℝ) (ξs : Euclid P → Euclid P → MultiVector P m), IsEmbeddedSubmanifold 1 m M → MeasurableSet M → (∀ y ∈ M, 0 < ρ y ∧ IsOrientation m (M ∩ ball y (ρ y)) (ξs y) ∧ μHE[m] (M ∩ ball y (ρ y)) ≠ ∞ ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) m, tsupport (ω : DifferentialForm (Euclid P) m) ⊆ ball y (ρ y) → C ω = ∫ x in M ∩ ball y (ρ y), ξs y x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m]) → ∃ ξ : Euclid P → MultiVector P m, IsOrientation m M ξ ∧ (∀ y ∈ M, ∀ x ∈ M ∩ ball y (ρ y), ξ x = ξs y x) ∧ ∀ y ∈ M, ∀ ω : TestFormOn (univ : Set (Euclid P)) m, tsupport (ω : DifferentialForm (Euclid P) m) ⊆ ball y (ρ y) → C ω = ∫ x in M, ξ x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m] := by
  intro P m C M ρ ξs hM hMm hloc
  -- Step 1: the pieces `M ∩ B_y` have the tangent spaces of `M`
  have hloc2 := (Submission.codim1_ovr_embedded_submanifold_local P 1 m M le_rfl
    (fun y _ => ⟨univ, isOpen_univ, mem_univ y, by rwa [inter_univ]⟩)).2
  have htan : ∀ y ∈ M, ∀ w ∈ M ∩ ball y (ρ y),
      tangentSpace (M ∩ ball y (ρ y)) w = tangentSpace M w :=
    fun y _ w hw => (hloc2 (ball y (ρ y)) isOpen_ball).2 w hw
  -- Step 2: `Hᵐ(M ∩ B_s(w)) ≠ 0`, else the density ratio would tend to `0`, not `1`
  have hpos : ∀ w ∈ M, ∀ s : ℝ, 0 < s → μHE[m] (M ∩ ball w s) ≠ 0 := by
    intro w hw s hs h0
    have hlim := Submission.dimred_rpd_submanifold_density_one P m M w hM hw
    have hev : (fun _ : ℝ => (0 : ℝ≥0∞)) =ᶠ[𝓝[>] (0 : ℝ)]
        fun s' : ℝ => μHE[m] (M ∩ ball w s') / (unitBallVolume m * ENNReal.ofReal (s' ^ m)) := by
      filter_upwards [Ioo_mem_nhdsGT hs] with s' hs'
      have h' : μHE[m] (M ∩ ball w s') = 0 :=
        measure_mono_null (inter_subset_inter_right _ (ball_subset_ball hs'.2.le)) h0
      rw [h', ENNReal.zero_div]
    have h01 := tendsto_nhds_unique (tendsto_const_nhds.congr' hev) hlim
    exact zero_ne_one h01
  -- Step 3: `ξ_{y'} = ξ_y` on `M ∩ B_y ∩ B_{y'}`
  have hagree : ∀ y ∈ M, ∀ y' ∈ M, ∀ w ∈ M ∩ ball y (ρ y), w ∈ ball y' (ρ y') →
      ξs y' w = ξs y w := by
    intro y hy y' hy' w hw hw'
    -- (a) both orient `T_wM`, so `ξ_{y'}(w) = ±ξ_y(w)`
    obtain ⟨Q, hQ, hQξ⟩ := (hloc y hy).2.1.2 w hw
    obtain ⟨Q', hQ', hQξ'⟩ := (hloc y' hy').2.1.2 w ⟨hw.1, hw'⟩
    have hQQ : Q' = Q := by
      apply SetLike.coe_injective
      rw [hQ, hQ', htan y hy w hw, htan y' hy' w ⟨hw.1, hw'⟩]
    subst hQQ
    rcases Submission.rsdic_unitOrientation_eq_or_eq_neg P m (ξs y w) (ξs y' w) Q' hQξ hQξ' with h | h
    · exact h
    · exfalso
      -- (b) `β = L(ξ_y(w))` has `ξ_y(w)(β) = 1` and `ξ_{y'}(w)(β) = -1`
      obtain ⟨L, hL⟩ := Submission.dor_ims_unitOrientation_dual P m
      have hβ1 : ξs y w (L (ξs y w)) = 1 := (hL (ξs y w) Q' hQξ).2.2
      have hβ2 : ξs y' w (L (ξs y w)) = -1 := by
        rw [h, neg_apply, hβ1]
      set β := L (ξs y w) with hβdef
      have hwM : w ∈ M := hw.1
      -- (c) by continuity, `ξ_y(β) > 1/2` and `ξ_{y'}(β) < -1/2` on `M ∩ B_r(w) ⊆ B_y ∩ B_{y'}`
      have hny : M ∩ ball y (ρ y) ∈ 𝓝[M] w :=
        inter_mem_nhdsWithin M (isOpen_ball.mem_nhds hw.2)
      have hny' : M ∩ ball y' (ρ y') ∈ 𝓝[M] w :=
        inter_mem_nhdsWithin M (isOpen_ball.mem_nhds hw')
      have hcy : ContinuousWithinAt (fun x => ξs y x β) M w :=
        (((hloc y hy).2.1.1 w hw).mono_of_mem_nhdsWithin hny).clm_apply continuousWithinAt_const
      have hcy' : ContinuousWithinAt (fun x => ξs y' x β) M w :=
        (((hloc y' hy').2.1.1 w ⟨hwM, hw'⟩).mono_of_mem_nhdsWithin hny').clm_apply
          continuousWithinAt_const
      have hev1 : ∀ᶠ x in 𝓝[M] w, (1 / 2 : ℝ) < ξs y x β :=
        hcy.eventually (lt_mem_nhds (by show (1 / 2 : ℝ) < ξs y w β; rw [hβ1]; norm_num))
      have hev2 : ∀ᶠ x in 𝓝[M] w, ξs y' x β < -(1 / 2 : ℝ) :=
        hcy'.eventually (gt_mem_nhds (by show ξs y' w β < -(1 / 2 : ℝ); rw [hβ2]; norm_num))
      obtain ⟨r₁, hr₁, hr₁sub⟩ := Metric.mem_nhdsWithin_iff.1 (hev1.and hev2)
      obtain ⟨r₂, hr₂, hr₂sub⟩ := Metric.isOpen_iff.1 (isOpen_ball.inter (isOpen_ball (x := y') (ε := ρ y')))
        w ⟨hw.2, hw'⟩
      set r := min r₁ r₂ with hrdef
      have hr : 0 < r := lt_min hr₁ hr₂
      have hrB : ball w r ⊆ ball y (ρ y) ∩ ball y' (ρ y') :=
        (ball_subset_ball (min_le_right _ _)).trans hr₂sub
      have hrM : ∀ x ∈ M ∩ ball w r, (1 / 2 : ℝ) < ξs y x β ∧ ξs y' x β < -(1 / 2 : ℝ) :=
        fun x hx => hr₁sub ⟨ball_subset_ball (min_le_left _ _) hx.2, hx.1⟩
      -- (d) the bump `φ` (`= 1` on `B̄_{r/4}(w)`, supported in `B̄_{r/2}(w)`) and the forms `φγ`
      let φ : ContDiffBump w := ⟨r / 4, r / 2, by positivity, by linarith⟩
      have hφsupp : tsupport φ ⊆ ball w r := by
        rw [φ.tsupport_eq]; exact closedBall_subset_ball (by simp [φ]; linarith)
      have hform : ∀ γ : Covector (Euclid P) m,
          (fun x => φ x • γ) ∈ TestFormOn (univ : Set (Euclid P)) m := by
        intro γ
        refine ⟨⟨?_, ?_⟩, subset_univ _⟩
        · exact (φ.contDiff (n := ⊤)).smul contDiff_const
        · exact φ.hasCompactSupport.smul_right
      have htsupp : ∀ γ : Covector (Euclid P) m,
          tsupport (fun x => φ x • γ) ⊆ ball w r :=
        fun γ => (tsupport_smul_subset_left _ _).trans hφsupp
      -- (e) `C(φγ) > 0` if `B_r(w) ⊆ B_z` and `ξ_z(γ) ≥ 1/2` on `M ∩ B_r(w)`
      have hposC : ∀ z ∈ M, ball w r ⊆ ball z (ρ z) → ∀ γ : Covector (Euclid P) m,
          (∀ x ∈ M ∩ ball w r, (1 / 2 : ℝ) ≤ ξs z x γ) →
          0 < C ⟨fun x => φ x • γ, hform γ⟩ := by
        intro z hz hrz γ hγ
        rw [(hloc z hz).2.2.2 ⟨fun x => φ x • γ, hform γ⟩ ((htsupp γ).trans hrz)]
        simp only [map_smul, smul_eq_mul]
        have hmeasB : MeasurableSet (M ∩ ball z (ρ z)) := hMm.inter measurableSet_ball
        have hmeas4 : MeasurableSet (M ∩ ball w (r / 4)) := hMm.inter measurableSet_ball
        have hsub4 : M ∩ ball w (r / 4) ⊆ M ∩ ball z (ρ z) :=
          inter_subset_inter_right _ ((ball_subset_ball (by linarith)).trans hrz)
        have hfinB := (hloc z hz).2.2.1
        have hfin4 : μHE[m] (M ∩ ball w (r / 4)) ≠ ∞ :=
          ne_top_of_le_ne_top hfinB (measure_mono hsub4)
        have hpos4 : 0 < μHE[m].real (M ∩ ball w (r / 4)) :=
          ENNReal.toReal_pos (hpos w hwM (r / 4) (by positivity)) hfin4
        -- the integrand is bounded by `|γ|`, hence integrable on `M ∩ B_z`
        have hint : IntegrableOn (fun x => φ x * ξs z x γ) (M ∩ ball z (ρ z)) μHE[m] := by
          refine IntegrableOn.of_bound (lt_top_iff_ne_top.2 hfinB) ?_ (covectorEuclideanNorm γ) ?_
          · exact (((φ.continuous.continuousOn).mul
              (((hloc z hz).2.1.1).clm_apply continuousOn_const))).aestronglyMeasurable hmeasB
          · refine (ae_restrict_iff' hmeasB).2 (Eventually.of_forall fun x hx => ?_)
            obtain ⟨Q, -, hQ⟩ := (hloc z hz).2.1.2 x hx
            have hb := (hL (ξs z x) Q hQ).1 γ
            rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg φ.nonneg]
            calc φ x * |ξs z x γ| ≤ 1 * |ξs z x γ| :=
                  mul_le_mul_of_nonneg_right φ.le_one (abs_nonneg _)
              _ ≤ covectorEuclideanNorm γ := by rw [one_mul]; exact hb
        have hnonneg : ∀ x ∈ M ∩ ball z (ρ z), 0 ≤ φ x * ξs z x γ := by
          intro x hx
          by_cases hxr : x ∈ ball w r
          · exact mul_nonneg φ.nonneg (le_trans (by norm_num) (hγ x ⟨hx.1, hxr⟩))
          · rw [image_eq_zero_of_notMem_tsupport (fun h => hxr (hφsupp h)), zero_mul]
        have hge : ∀ x ∈ M ∩ ball w (r / 4), (1 / 2 : ℝ) ≤ φ x * ξs z x γ := by
          intro x hx
          have hx1 : φ x = 1 := φ.one_of_mem_closedBall (by
            show x ∈ closedBall w (r / 4); exact ball_subset_closedBall hx.2)
          rw [hx1, one_mul]
          exact hγ x ⟨hx.1, ball_subset_ball (by linarith) hx.2⟩
        calc (0 : ℝ) < 1 / 2 * μHE[m].real (M ∩ ball w (r / 4)) := by positivity
          _ ≤ ∫ x in M ∩ ball w (r / 4), φ x * ξs z x γ ∂μHE[m] :=
              setIntegral_ge_of_const_le_real hmeas4 hfin4 hge (hint.mono_set hsub4)
          _ ≤ ∫ x in M ∩ ball z (ρ z), φ x * ξs z x γ ∂μHE[m] :=
              setIntegral_mono_set hint
                ((ae_restrict_iff' hmeasB).2 (Eventually.of_forall hnonneg))
                (Eventually.of_forall hsub4)
      -- (f) `C(φβ) > 0` and `C(−φβ) > 0`, contradicting linearity of `C`
      have h1 := hposC y hy (hrB.trans inter_subset_left) β
        (fun x hx => (hrM x hx).1.le)
      have h2 := hposC y' hy' (hrB.trans inter_subset_right) (-β)
        (fun x hx => by rw [map_neg]; linarith [(hrM x hx).2])
      have hneg : (⟨fun x => φ x • (-β), hform (-β)⟩ : TestFormOn (univ : Set (Euclid P)) m) =
          -⟨fun x => φ x • β, hform β⟩ := by
        apply Subtype.ext
        funext x
        simp [smul_neg]
      have hC : C ⟨fun x => φ x • (-β), hform (-β)⟩ = -C ⟨fun x => φ x • β, hform β⟩ := by
        rw [hneg]; exact map_neg (C.toCurrent : TestFormOn (univ : Set (Euclid P)) m →ₗ[ℝ] ℝ) _
      rw [hC] at h2
      linarith
  -- Step 4: `ξ(x) := ξ_x(x)` is an orientation of `M` that agrees with every `ξ_y`
  refine ⟨fun x => ξs x x, ⟨?_, ?_⟩, ?_, ?_⟩
  · -- continuity within `M` at `y`: `ξ = ξ_y` on the relative neighbourhood `M ∩ B_y`
    intro y hy
    have hcont : ContinuousWithinAt (ξs y) (M ∩ ball y (ρ y)) y :=
      (hloc y hy).2.1.1 y ⟨hy, mem_ball_self (hloc y hy).1⟩
    have hnhds : M ∩ ball y (ρ y) ∈ 𝓝[M] y :=
      inter_mem_nhdsWithin M (isOpen_ball.mem_nhds (mem_ball_self (hloc y hy).1))
    have hc2 : ContinuousWithinAt (ξs y) M y := hcont.mono_of_mem_nhdsWithin hnhds
    refine hc2.congr_of_eventuallyEq ?_ rfl
    filter_upwards [hnhds] with x hx
    exact hagree y hy x hx.1 x hx (mem_ball_self (hloc x hx.1).1)
  · -- `ξ(x) = ξ_x(x)` orients `T_x(M ∩ B_x) = T_xM`
    intro x hx
    obtain ⟨Q, hQ, hQξ⟩ := (hloc x hx).2.1.2 x ⟨hx, mem_ball_self (hloc x hx).1⟩
    exact ⟨Q, by rw [hQ, htan x hx x ⟨hx, mem_ball_self (hloc x hx).1⟩], hQξ⟩
  · intro y hy x hx
    exact hagree y hy x hx.1 x hx (mem_ball_self (hloc x hx.1).1)
  · -- Step 5: `C(ω) = ∫_{M ∩ B_y} ⟨ω, ξ⟩ dHᵐ = ∫_M ⟨ω, ξ⟩ dHᵐ`, as `ω = 0` on `M \ B_y`
    intro y hy ω hω
    rw [(hloc y hy).2.2.2 ω hω]
    have hmeas : MeasurableSet (M ∩ ball y (ρ y)) := hMm.inter measurableSet_ball
    have h1 : ∫ x in M ∩ ball y (ρ y), ξs y x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m] =
        ∫ x in M ∩ ball y (ρ y), ξs x x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m] :=
      setIntegral_congr_fun hmeas (fun x hx => by
        simp only [hagree y hy x hx.1 x hx (mem_ball_self (hloc x hx.1).1)])
    rw [h1]
    symm
    apply setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hMm inter_subset_left
    intro x hx
    have hxω : x ∉ tsupport (ω : DifferentialForm (Euclid P) m) := fun h => hx.2 ⟨hx.1, hω h⟩
    rw [image_eq_zero_of_notMem_tsupport hxω, map_zero]
/-- **A dilation-invariant set that is locally `Hᵐ`-finite away from `0` has `Hᵐ`-finite
intersection with every compact set** (`m ≥ 1`).  Here `0 ∉ M`, `M̄ ⊆ M ∪ {0}`, `tM ⊆ M` for
`t > 0`, and each `y ∈ M` has an open `B ∋ y` with `Hᵐ(M ∩ B) < ∞`.  For compact `K ∌ 0`, `M ∩ K`
is compact, hence covered by finitely many such `B`.  So the annulus `A = {R/2 ≤ |x| ≤ R}` has
`Hᵐ(M ∩ A) < ∞`, and `M ∩ B̄_R(0) ⊆ ⋃ₖ 2⁻ᵏ(M ∩ A)` gives
`Hᵐ(M ∩ B̄_R(0)) ≤ Σₖ 2⁻ᵏᵐ Hᵐ(M ∩ A) < ∞`; every compact set lies in some `B̄_R(0)`. -/
theorem Submission.codim1_ovr_cone_locally_finite_measure : ∀ (P m : ℕ) (M : Set (Euclid P)), 1 ≤ m → (0 : Euclid P) ∉ M → closure M ⊆ insert 0 M → (∀ t : ℝ, 0 < t → ∀ x ∈ M, t • x ∈ M) → (∀ y ∈ M, ∃ B : Set (Euclid P), IsOpen B ∧ y ∈ B ∧ μHE[m] (M ∩ B) ≠ ∞) → ∀ K : Set (Euclid P), IsCompact K → μHE[m] (M ∩ K) ≠ ∞ := by
  intro P m M hm h0M hcl hcone hloc
  choose! B hBo hyB hBfin using hloc
  -- Step 1: compact sets avoiding the vertex.
  have h6a : ∀ K : Set (Euclid P), IsCompact K → (0 : Euclid P) ∉ K → μHE[m] (M ∩ K) ≠ ∞ := by
    intro K hK h0K
    -- `M ∩ K` is closed: its closure lies in `(M ∪ {0}) ∩ K = M ∩ K`.
    have hMKc : IsCompact (M ∩ K) := by
      refine hK.of_isClosed_subset (isClosed_of_closure_subset fun x hx => ?_) inter_subset_right
      have hx1 : x ∈ closure M := closure_mono inter_subset_left hx
      have hx2 : x ∈ K := hK.isClosed.closure_subset (closure_mono inter_subset_right hx)
      rcases hcl hx1 with h | h
      · exact absurd (h ▸ hx2) h0K
      · exact ⟨h, hx2⟩
    obtain ⟨t, ht⟩ := hMKc.elim_finite_subcover (fun y : ↥(M ∩ K) => B y)
      (fun y => hBo y y.2.1) (fun x hx => mem_iUnion.2 ⟨⟨x, hx⟩, hyB x hx.1⟩)
    have hsub : M ∩ K ⊆ ⋃ y ∈ t, M ∩ B y := by
      intro x hx
      obtain ⟨y, hyt, hxy⟩ := mem_iUnion₂.1 (ht hx)
      exact mem_iUnion₂.2 ⟨y, hyt, hx.1, hxy⟩
    refine ne_top_of_le_ne_top ?_ ((measure_mono hsub).trans (measure_biUnion_finset_le t _))
    exact ENNReal.sum_ne_top.2 fun y _ => hBfin y y.2.1
  -- Step 2: closed balls about the vertex, by dyadic scaling of the annulus `A`.
  have h6b : ∀ R : ℝ, 0 < R → μHE[m] (M ∩ closedBall 0 R) ≠ ∞ := by
    intro R hR
    set A : Set (Euclid P) := {x | R / 2 ≤ ‖x‖} ∩ closedBall 0 R with hAdef
    have hA : IsCompact A :=
      (isCompact_closedBall 0 R).of_isClosed_subset
        ((isClosed_le continuous_const continuous_norm).inter isClosed_closedBall) inter_subset_right
    have h0A : (0 : Euclid P) ∉ A := by
      rintro ⟨h1, -⟩
      simp only [mem_ofPred_eq, norm_zero] at h1
      linarith
    have ha := h6a A hA h0A
    -- `x ∈ M`, `0 < ‖x‖ ≤ R`: with `2ᵏ ≤ R/‖x‖ < 2ᵏ⁺¹`, `2ᵏx ∈ M ∩ A` and `x = 2⁻ᵏ(2ᵏx)`.
    have hcover : M ∩ closedBall 0 R ⊆ ⋃ k : ℕ, (fun x => ((2 : ℝ)⁻¹ ^ k) • x) '' (M ∩ A) := by
      rintro x ⟨hxM, hxR⟩
      have hx0 : x ≠ 0 := fun h => h0M (h ▸ hxM)
      have hxpos : 0 < ‖x‖ := norm_pos_iff.2 hx0
      have hxR' : ‖x‖ ≤ R := by simpa using hxR
      obtain ⟨k, hk1, hk2⟩ := exists_nat_pow_near (x := R / ‖x‖) (y := (2 : ℝ))
        (by rw [le_div_iff₀ hxpos, one_mul]; exact hxR') one_lt_two
      refine mem_iUnion.2 ⟨k, ⟨(2 : ℝ) ^ k • x, ⟨hcone _ (by positivity) x hxM, ?_, ?_⟩, ?_⟩⟩
      · show R / 2 ≤ ‖(2 : ℝ) ^ k • x‖
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos (by positivity)]
        rw [div_lt_iff₀ hxpos, pow_succ] at hk2
        nlinarith
      · rw [mem_closedBall, dist_zero_right, norm_smul, Real.norm_eq_abs,
          abs_of_pos (by positivity)]
        rw [le_div_iff₀ hxpos] at hk1
        exact hk1
      · show (2 : ℝ)⁻¹ ^ k • (2 : ℝ) ^ k • x = x
        rw [smul_smul, ← mul_pow, inv_mul_cancel₀ two_ne_zero, one_pow, one_smul]
    -- Scaling law `Hᵐ(cE) = |c|ᵐ Hᵐ(E)` with `c = 2⁻ᵏ`.
    have hnorm : ∀ k : ℕ, ((‖(2 : ℝ)⁻¹ ^ k‖₊ : NNReal) : ℝ≥0∞) = (2 : ℝ≥0∞)⁻¹ ^ k := by
      intro k
      rw [nnnorm_pow, nnnorm_inv, ENNReal.coe_pow, ENNReal.coe_inv (by simp)]
      simp
    have hscale : ∀ k : ℕ, μHE[m] ((fun x => ((2 : ℝ)⁻¹ ^ k) • x) '' (M ∩ A)) =
        ((2 : ℝ≥0∞)⁻¹ ^ m) ^ k * μHE[m] (M ∩ A) := by
      intro k
      rw [Set.image_smul, Measure.euclideanHausdorffMeasure_smul₀ m (by positivity) (M ∩ A),
        ENNReal.smul_def, smul_eq_mul, ENNReal.coe_pow, hnorm k]
      congr 1
      rw [← pow_mul, ← pow_mul, Nat.mul_comm]
    have hr : (2 : ℝ≥0∞)⁻¹ ^ m < 1 := by
      have h2 : (2 : ℝ≥0∞)⁻¹ < 1 := ENNReal.inv_lt_one.2 (by norm_num)
      exact pow_lt_one₀ bot_le h2 (by omega)
    -- Geometric series: `Σₖ (2⁻ᵐ)ᵏ Hᵐ(M ∩ A) = (1 - 2⁻ᵐ)⁻¹ Hᵐ(M ∩ A) < ∞`.
    refine ne_top_of_le_ne_top ?_ ((measure_mono hcover).trans (measure_iUnion_le _))
    simp_rw [hscale]
    rw [ENNReal.tsum_mul_right, ENNReal.tsum_geometric]
    refine ENNReal.mul_ne_top ?_ ha
    exact ENNReal.inv_ne_top.2 (tsub_pos_of_lt hr).ne'
  -- Step 3: a compact set lies in a closed ball `B̄_R(0)`, `R ≥ 1`.
  intro K hK
  obtain ⟨R₁, hR₁⟩ := hK.isBounded.subset_closedBall (0 : Euclid P)
  have hKR : K ⊆ closedBall 0 (max R₁ 1) :=
    hR₁.trans (closedBall_subset_closedBall (le_max_left _ _))
  exact ne_top_of_le_ne_top (h6b _ (lt_of_lt_of_le one_pos (le_max_right _ _)))
    (measure_mono (inter_subset_inter_right _ hKR))

/-- **Simon Ch. 6, 3.1**: an integer multiplicity `m`-current, `m ≥ 1`, does not charge the
origin.  If `ωₖ(x) = 0` for `|x| ≥ rₖ`, `rₖ → 0`, and `|ωₖ| ≤ c`, then `C(ωₖ) → 0`.  Writing
`C(ωₖ) = ∫_M θ ⟨ωₖ, ξ⟩ dHᵐ`, the integrands are bounded by `c θ 1_{B(0, R₀)}` (`|ξ(α)| ≤ |α|`)
and vanish eventually off `0`, and `Hᵐ({0}) = 0`; dominated convergence applies. -/
theorem Submission.codim1_ovr_imrep_vanish_at_vertex : ∀ (P m : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) m) (ωs : ℕ → TestFormOn (univ : Set (Euclid P)) m) (r : ℕ → ℝ) (c : ℝ), 1 ≤ m → IsIntegerMultiplicity C → Tendsto r atTop (𝓝 0) → (∀ (k : ℕ) (x : Euclid P), r k ≤ ‖x‖ → (ωs k : DifferentialForm (Euclid P) m) x = 0) → (∀ (k : ℕ) (x : Euclid P), covectorEuclideanNorm ((ωs k : DifferentialForm (Euclid P) m) x) ≤ c) → Tendsto (fun k => C (ωs k)) atTop (𝓝 0) := by
  intro P m C ωs r c hm hIM hr hsupp hbd
  obtain ⟨R, hR⟩ := hIM
  obtain ⟨L, hL⟩ := Submission.dor_ims_unitOrientation_dual P m
  -- `rₖ ≤ R₀` for all `k`, so every `ωₖ` vanishes off `closedBall 0 R₀`
  obtain ⟨R₀, hR₀⟩ : ∃ R₀ : ℝ, ∀ k, r k ≤ R₀ := by
    obtain ⟨b, hb⟩ := hr.bddAbove_range
    exact ⟨b, fun k => hb ⟨k, rfl⟩⟩
  have hθm : Measurable fun x => (R.mult x : ℝ) := measurable_from_nat.comp R.measurable_mult
  have hK : IsCompact (closedBall (0 : Euclid P) R₀) := isCompact_closedBall 0 R₀
  have hKm : MeasurableSet (closedBall (0 : Euclid P) R₀) := measurableSet_closedBall
  -- `|ξ(x)(γ)| ≤ |γ|` for `Hᵐ`-a.e. `x ∈ M`
  have hξ : ∀ᵐ x ∂μHE[m].restrict R.carrier, ∀ γ : Covector (Euclid P) m,
      |R.orient x γ| ≤ covectorEuclideanNorm γ := by
    filter_upwards [R.orients] with x ⟨Q, _, hQ⟩ γ
    exact (hL (R.orient x) Q hQ).1 γ
  -- `Hᵐ({0}) = 0` as `m ≥ 1`
  have h0null : μHE[m] ({0} : Set (Euclid P)) = 0 := by
    rw [Measure.euclideanHausdorffMeasure_def, Measure.smul_apply]
    have := Measure.nullSingletonClass_hausdorff (Euclid P) (d := (m : ℝ))
      (by exact_mod_cast hm)
    simp
  have hrep : ∀ k, C (ωs k) = ∫ x in R.carrier, (R.mult x : ℝ) *
      R.orient x ((ωs k : DifferentialForm (Euclid P) m) x) ∂μHE[m] := fun k => hR (ωs k)
  simp_rw [hrep]
  have hlim0 : (∫ x in R.carrier, (0 : ℝ) ∂μHE[m]) = 0 := integral_zero _ _
  rw [← hlim0]
  refine tendsto_integral_of_dominated_convergence
    ((closedBall (0 : Euclid P) R₀).indicator fun x => c * (R.mult x : ℝ)) ?_ ?_ ?_ ?_
  · -- measurability: `θ`, `ξ` and `ωₖ` are, and `(η, α) ↦ η(α)` is continuous
    intro k
    refine hθm.aestronglyMeasurable.mul ?_
    have hev : Continuous fun p : MultiVector P m × Covector (Euclid P) m => p.1 p.2 :=
      isBoundedBilinearMap_apply.continuous
    exact Continuous.comp_aestronglyMeasurable₂
      (g := fun (L : MultiVector P m) (v : Covector (Euclid P) m) => L v) hev
      R.aestronglyMeasurable_orient (ContDiff.continuous (ωs k).property.1.1).aestronglyMeasurable
  · -- `c θ 1_{B(0, R₀)}` is integrable on `M` since `θ` is locally integrable
    refine IntegrableOn.integrable_indicator ?_ hKm
    refine Integrable.const_mul ?_ _
    show Integrable _ ((μHE[m].restrict R.carrier).restrict (closedBall (0 : Euclid P) R₀))
    rw [Measure.restrict_restrict hKm, inter_comm]
    refine ⟨hθm.aestronglyMeasurable, ?_⟩
    show ∫⁻ x in R.carrier ∩ closedBall (0 : Euclid P) R₀, ‖(R.mult x : ℝ)‖ₑ ∂μHE[m] < ∞
    simp only [Real.enorm_natCast]
    exact lt_top_iff_ne_top.2 (R.locallyIntegrable_mult _ hK (subset_univ _))
  · -- domination `|θ ξ(ωₖ)| ≤ c θ 1_{B(0, R₀)}`
    intro k
    filter_upwards [hξ] with x hx
    by_cases hxK : x ∈ closedBall (0 : Euclid P) R₀
    · rw [indicator_of_mem hxK, norm_mul, Real.norm_natCast, Real.norm_eq_abs, mul_comm c]
      exact mul_le_mul_of_nonneg_left ((hx _).trans (hbd k x)) (Nat.cast_nonneg _)
    · rw [indicator_of_notMem hxK]
      have hxr : r k ≤ ‖x‖ := by
        rw [mem_closedBall, dist_zero_right, not_le] at hxK
        exact (hR₀ k).trans hxK.le
      rw [hsupp k x hxr, map_zero, mul_zero, norm_zero]
  · -- at `x ≠ 0`, `rₖ < |x|` eventually, so the integrand is eventually `0`
    have hae : ∀ᵐ x ∂μHE[m].restrict R.carrier, x ≠ 0 := by
      apply ae_restrict_of_ae
      rw [ae_iff]
      simpa using h0null
    filter_upwards [hae] with x hx
    have hxpos : 0 < ‖x‖ := norm_pos_iff.2 hx
    have hev : ∀ᶠ k in atTop, r k < ‖x‖ := hr.eventually (gt_mem_nhds hxpos)
    apply tendsto_const_nhds.congr'
    filter_upwards [hev] with k hk
    rw [hsupp k x hk.le, map_zero, mul_zero]
/-- **Extending an off-vertex representation across the vertex** (vertex negligibility and
passage to all test forms).  Let `C ∈ 𝒟ₘ(ℝᴾ)` be integer multiplicity, `m ≥ 1`, and `M` a Borel set
with `0 ∉ M` and `Hᵐ(M ∩ K) < ∞` for compact `K`, carrying `ξ` continuous on `M` with
`|⟨α, ξ⟩| ≤ |α|`.  If `C(ω) = ∫_M ⟨ω, ξ⟩ dHᵐ` whenever `0 ∉ spt ω`, then this holds for every
`ω ∈ 𝒟ᵐ(ℝᴾ)`.  Split `ω = χₖω + (1 − χₖ)ω` with smooth bumps `χₖ = 1` on `B̄_{εₖ}(0)`,
supported in `B_{2εₖ}(0)`, `εₖ = 1/(k+1)`: `C(χₖω) → 0` by
`codim1_ovr_imrep_vanish_at_vertex`, while `C((1 − χₖ)ω) = ∫_M (1 − χₖ)⟨ω, ξ⟩ dHᵐ` tends to
`∫_M ⟨ω, ξ⟩ dHᵐ` by dominated convergence, with bound `sup |ω| · 1_{spt ω}`. -/
theorem Submission.codim1_ovr_extend_rep_across_vertex : ∀ (P m : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) m) (M : Set (Euclid P)) (ξ : Euclid P → MultiVector P m), 1 ≤ m → IsIntegerMultiplicity C → MeasurableSet M → (0 : Euclid P) ∉ M → ContinuousOn ξ M → (∀ x ∈ M, ∀ α : Covector (Euclid P) m, |ξ x α| ≤ covectorEuclideanNorm α) → (∀ K : Set (Euclid P), IsCompact K → μHE[m] (M ∩ K) ≠ ∞) → (∀ ω : TestFormOn (univ : Set (Euclid P)) m, (0 : Euclid P) ∉ tsupport (ω : DifferentialForm (Euclid P) m) → C ω = ∫ x in M, ξ x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m]) → ∀ ω : TestFormOn (univ : Set (Euclid P)) m, C ω = ∫ x in M, ξ x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m] := by
  intro P m C M ξ hm hIM hMm h0M hξc hξb hfin hoff ω
  set ω₀ : DifferentialForm (Euclid P) m := (ω : DifferentialForm (Euclid P) m) with hω₀
  have hωs : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) ω₀ := ω.property.1.1
  have hωc : HasCompactSupport ω₀ := ω.property.1.2
  -- Step 1: the Euclidean covector norm is continuous and absolutely homogeneous, and
  -- `|ω(x)| ≤ S` for all `x`.
  have hnc : Continuous fun α : Covector (Euclid P) m => covectorEuclideanNorm α := by
    unfold covectorEuclideanNorm
    refine Real.continuous_sqrt.comp (continuous_finsetSum _ fun I _ => ?_)
    split_ifs
    · exact ((ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ
        (fun i => EuclideanSpace.basisFun (Fin P) ℝ (I i))).continuous).pow 2
    · exact continuous_const
  have hsmul : ∀ (a : ℝ) (α : Covector (Euclid P) m),
      covectorEuclideanNorm (a • α) = |a| * covectorEuclideanNorm α := by
    intro a α
    unfold covectorEuclideanNorm
    rw [← Real.sqrt_sq_eq_abs, ← Real.sqrt_mul (sq_nonneg a), Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl fun I _ => ?_
    split_ifs
    · simp only [ContinuousAlternatingMap.smul_apply, smul_eq_mul]; ring
    · simp
  obtain ⟨S, hS⟩ : ∃ S, ∀ x, covectorEuclideanNorm (ω₀ x) ≤ S := by
    obtain ⟨S, hS⟩ := (hnc.comp hωs.continuous).bounded_above_of_compact_support
      (hωc.comp_left (covectorEuclideanNorm_zero P m))
    exact ⟨S, fun x => (le_abs_self _).trans (by simpa [Real.norm_eq_abs] using hS x)⟩
  -- Step 2: cut-offs `χₖ = 1` on `closedBall 0 εₖ`, supported in `ball 0 (2εₖ)`, and the split
  -- `ω = χₖω + (1 − χₖ)ω` into test forms.
  let ε : ℕ → ℝ := fun k => 1 / ((k : ℝ) + 1)
  have hε : ∀ k, 0 < ε k := fun k => by positivity
  have hε0 : Tendsto (fun k => 2 * ε k) atTop (𝓝 0) := by
    have : Tendsto ε atTop (𝓝 0) := tendsto_one_div_add_atTop_nhds_zero_nat
    simpa using this.const_mul 2
  let χ : ℕ → ContDiffBump (0 : Euclid P) := fun k => ⟨ε k, 2 * ε k, hε k, by linarith [hε k]⟩
  have hχ0 : ∀ k (x : Euclid P), 2 * ε k ≤ ‖x‖ → χ k x = 0 := by
    intro k x hx
    have hxs : x ∉ support (χ k) := by
      rw [(χ k).support_eq, mem_ball, dist_zero_right, not_lt]; exact hx
    exact notMem_support.1 hxs
  have hin : ∀ k, (fun x => χ k x • ω₀ x) ∈ TestFormOn (univ : Set (Euclid P)) m := by
    intro k
    have h1 : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun x => χ k x • ω₀ x) :=
      ((χ k).contDiff (n := ⊤)).smul hωs
    have h2 : HasCompactSupport (fun x => χ k x • ω₀ x) :=
      hωc.mono (support_smul_subset_right (fun x => χ k x) ω₀)
    exact ⟨⟨h1, h2⟩, subset_univ _⟩
  have hout : ∀ k, (fun x => (1 - χ k x) • ω₀ x) ∈ TestFormOn (univ : Set (Euclid P)) m := by
    intro k
    have h1 : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun x => (1 - χ k x) • ω₀ x) :=
      (contDiff_const.sub ((χ k).contDiff (n := ⊤))).smul hωs
    have h2 : HasCompactSupport (fun x => (1 - χ k x) • ω₀ x) :=
      hωc.mono (support_smul_subset_right (fun x => 1 - χ k x) ω₀)
    exact ⟨⟨h1, h2⟩, subset_univ _⟩
  let ωin : ℕ → TestFormOn (univ : Set (Euclid P)) m := fun k => ⟨_, hin k⟩
  let ωout : ℕ → TestFormOn (univ : Set (Euclid P)) m := fun k => ⟨_, hout k⟩
  have hsplit : ∀ k, C ω = C (ωin k) + C (ωout k) := by
    intro k
    have hsum : ω = ωin k + ωout k := by
      apply Subtype.ext; funext x
      show ω₀ x = χ k x • ω₀ x + (1 - χ k x) • ω₀ x
      rw [← add_smul]; simp
    rw [hsum]; exact map_add (C.toCurrent : TestFormOn (univ : Set (Euclid P)) m →ₗ[ℝ] ℝ) _ _
  -- Step 3 (vertex negligibility): `C(χₖω) → 0`.
  have h1 : Tendsto (fun k => C (ωin k)) atTop (𝓝 0) := by
    refine Submission.codim1_ovr_imrep_vanish_at_vertex P m C ωin (fun k => 2 * ε k) S hm hIM
      hε0 ?_ ?_
    · intro k x hx
      show χ k x • ω₀ x = 0
      rw [hχ0 k x hx, zero_smul]
    · intro k x
      show covectorEuclideanNorm (χ k x • ω₀ x) ≤ S
      rw [hsmul, abs_of_nonneg (χ k).nonneg]
      calc χ k x * covectorEuclideanNorm (ω₀ x) ≤ 1 * covectorEuclideanNorm (ω₀ x) :=
            mul_le_mul_of_nonneg_right (χ k).le_one (covectorEuclideanNorm_nonneg _)
        _ ≤ S := by rw [one_mul]; exact hS x
  -- Step 4: `0 ∉ spt((1 − χₖ)ω)`, so `C((1 − χₖ)ω) = ∫_M (1 − χₖ)⟨ω, ξ⟩ dHᵐ`.
  have h2 : ∀ k, C (ωout k) = ∫ x in M, (1 - χ k x) * ξ x (ω₀ x) ∂μHE[m] := by
    intro k
    rw [hoff (ωout k) ?_]
    · refine setIntegral_congr_fun hMm fun x _ => ?_
      show ξ x ((1 - χ k x) • ω₀ x) = _
      rw [map_smul, smul_eq_mul]
    · intro h0
      have hnhds : ball (0 : Euclid P) (ε k) ∈ 𝓝 (0 : Euclid P) := ball_mem_nhds 0 (hε k)
      have hzero : ∀ x ∈ ball (0 : Euclid P) (ε k), (1 - χ k x) • ω₀ x = 0 := by
        intro x hx
        rw [(χ k).one_of_mem_closedBall (ball_subset_closedBall hx), sub_self, zero_smul]
      exact (notMem_tsupport_iff_eventuallyEq.2
        (Filter.eventually_of_mem hnhds hzero)) h0
  -- Step 5: dominated convergence on `M`, with bound `S · 1_{spt ω}`.
  have hK : IsCompact (tsupport ω₀) := hωc
  have h3 : Tendsto (fun k => ∫ x in M, (1 - χ k x) * ξ x (ω₀ x) ∂μHE[m]) atTop
      (𝓝 (∫ x in M, ξ x (ω₀ x) ∂μHE[m])) := by
    refine tendsto_integral_of_dominated_convergence
      ((tsupport ω₀).indicator fun _ => S) ?_ ?_ ?_ ?_
    · intro k
      exact (((continuousOn_const (c := (1 : ℝ))).sub (χ k).continuous.continuousOn).mul
        (hξc.clm_apply hωs.continuous.continuousOn)).aestronglyMeasurable hMm
    · refine IntegrableOn.integrable_indicator ?_ hK.isClosed.measurableSet
      show IntegrableOn (fun _ => S) (tsupport ω₀) (μHE[m].restrict M)
      refine integrableOn_const ?_
      rw [Measure.restrict_apply hK.isClosed.measurableSet, inter_comm]
      exact hfin _ hK
    · intro k
      refine (ae_restrict_iff' hMm).2 (Eventually.of_forall fun x hx => ?_)
      by_cases hxK : x ∈ tsupport ω₀
      · rw [indicator_of_mem hxK, norm_mul, Real.norm_eq_abs, Real.norm_eq_abs]
        have h01 : |1 - χ k x| ≤ 1 := by
          rw [abs_le]; constructor <;> linarith [(χ k).nonneg (x := x), (χ k).le_one (x := x)]
        calc |1 - χ k x| * |ξ x (ω₀ x)| ≤ 1 * covectorEuclideanNorm (ω₀ x) :=
              mul_le_mul h01 (hξb x hx _) (abs_nonneg _) zero_le_one
          _ ≤ S := by rw [one_mul]; exact hS x
      · rw [indicator_of_notMem hxK, image_eq_zero_of_notMem_tsupport hxK, map_zero, mul_zero,
          norm_zero]
    · refine (ae_restrict_iff' hMm).2 (Eventually.of_forall fun x hx => ?_)
      have hx0 : x ≠ 0 := fun h => h0M (h ▸ hx)
      have hev : ∀ᶠ k in atTop, 2 * ε k < ‖x‖ := hε0.eventually (gt_mem_nhds (norm_pos_iff.2 hx0))
      apply tendsto_const_nhds.congr'
      filter_upwards [hev] with k hk
      rw [hχ0 k x hk.le, sub_zero, one_mul]
  -- Step 6: `C(ω) = C(χₖω) + C((1 − χₖ)ω) → 0 + ∫_M ⟨ω, ξ⟩ dHᵐ`; the left side is constant.
  have h4 : Tendsto (fun k => C (ωin k) + C (ωout k)) atTop
      (𝓝 (0 + ∫ x in M, ξ x (ω₀ x) ∂μHE[m])) := by
    refine h1.add ?_
    simp_rw [h2]; exact h3
  rw [zero_add] at h4
  have h5 : (fun k => C (ωin k) + C (ωout k)) = fun _ => C ω := funext fun k => (hsplit k).symm
  rw [h5] at h4
  exact tendsto_nhds_unique tendsto_const_nhds h4
/-- **Simon Ch. 6, 2.5 and 3.2(3)**, upper bound: if `T(ω) = ∫_{M'} θ' ⟨ω, ξ'⟩ dHᵏ` for every
`ω` supported in `V`, with `θ' ≥ 0` and `ξ'` a unit orientation `Hᵏ`-a.e. on `M'`, then
`M_W(T) ≤ ∫_{M' ∩ W} θ' dHᵏ` for measurable `W ⊆ V`.  For admissible `ω`, `|ξ'(ω)| ≤ |ω| ≤ 1`
a.e. on `M'` and `ω = 0` off `W`, so `T(ω) ≤ |∫_{M'} θ' ξ'(ω)| ≤ ∫⁻_{M'} 1_W θ'`; no
integrability or measurability of `θ'`, `ξ'` is needed. -/
theorem Submission.codim1_oriented_rep_massOn_le_lintegral : ∀ (P k : ℕ) (U V M' : Set (Euclid P)) (T : GeometricCurrentOn U k) (θ' : Euclid P → ℝ) (ξ' : Euclid P → MultiVector P k), (∀ x, 0 ≤ θ' x) → (∀ᵐ x ∂(μHE[k].restrict M'), ∃ Q : Submodule ℝ (Euclid P), IsUnitOrientationOf (ξ' x) Q) → (∀ ω : TestFormOn U k, tsupport (ω : DifferentialForm (Euclid P) k) ⊆ V → T ω = ∫ x in M', θ' x * ξ' x ((ω : DifferentialForm (Euclid P) k) x) ∂μHE[k]) → ∀ W : Set (Euclid P), MeasurableSet W → W ⊆ V → T.massOn W ≤ ∫⁻ x in M' ∩ W, ENNReal.ofReal (θ' x) ∂μHE[k] := by
  intro P k U V M' T θ' ξ' hθ hξ hT W hW hWV
  obtain ⟨_, hL⟩ := Submission.dor_ims_unitOrientation_dual P k
  -- `|ξ'(x)(α)| ≤ |α|` for `Hᵏ⌞M'`-a.e. `x`
  have hgood : ∀ᵐ x ∂(μHE[k].restrict M'),
      ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α := by
    filter_upwards [hξ] with x ⟨Q, hQ⟩
    exact (hL (ξ' x) Q hQ).1
  -- it suffices to bound `T(ω)` for each admissible `ω`
  refine sSup_le ?_
  rintro r ⟨ω, ⟨hωW, hω1⟩, rfl⟩
  dsimp only
  rw [hT ω (hωW.trans hWV)]
  -- `|θ' ξ'(ω)| ≤ 1_W θ'` a.e. on `M'`: `ω = 0` off `W` and `|ξ'(ω)| ≤ |ω| ≤ 1`
  have hdom : ∀ᵐ x ∂(μHE[k].restrict M'),
      ‖θ' x * ξ' x ((ω : DifferentialForm (Euclid P) k) x)‖ₑ ≤
        W.indicator (fun x => ENNReal.ofReal (θ' x)) x := by
    filter_upwards [hgood] with x hx
    by_cases hxW : x ∈ W
    · rw [indicator_of_mem hxW, Real.enorm_eq_ofReal_abs, abs_mul, abs_of_nonneg (hθ x)]
      refine ENNReal.ofReal_le_ofReal ?_
      calc θ' x * |ξ' x ((ω : DifferentialForm (Euclid P) k) x)|
          ≤ θ' x * 1 := mul_le_mul_of_nonneg_left ((hx _).trans (hω1 x)) (hθ x)
        _ = θ' x := mul_one _
    · rw [image_eq_zero_of_notMem_tsupport fun h => hxW (hωW h), map_zero, mul_zero,
        enorm_zero]
      exact zero_le
  -- `T(ω) ≤ |∫ g| ≤ ∫⁻ |g| ≤ ∫⁻_{M'} 1_W θ' = ∫⁻_{M' ∩ W} θ'`
  calc ENNReal.ofReal (∫ x in M', θ' x * ξ' x ((ω : DifferentialForm (Euclid P) k) x) ∂μHE[k])
      ≤ ‖∫ x in M', θ' x * ξ' x ((ω : DifferentialForm (Euclid P) k) x) ∂μHE[k]‖ₑ := by
        rw [Real.enorm_eq_ofReal_abs]
        exact ENNReal.ofReal_le_ofReal (le_abs_self _)
    _ ≤ ∫⁻ x in M', ‖θ' x * ξ' x ((ω : DifferentialForm (Euclid P) k) x)‖ₑ ∂μHE[k] :=
        enorm_integral_le_lintegral_enorm _
    _ ≤ ∫⁻ x in M', W.indicator (fun x => ENNReal.ofReal (θ' x)) x ∂μHE[k] :=
        lintegral_mono_ae hdom
    _ = ∫⁻ x in M' ∩ W, ENNReal.ofReal (θ' x) ∂μHE[k] := by
        rw [lintegral_indicator hW, Measure.restrict_restrict hW, inter_comm]
/-- **Lower mass bound for an oriented representation** (Simon Ch. 6, 2.5 and 3.2(3)).  If
`T(ω) = ∫_{M'} θ' ⟨ω, ξ'⟩ dHᵏ` for the test forms supported in `V`, with `θ' ≥ 0` measurable and
`ξ'` a.e. a unit orientation, then `I = ∫_{M' ∩ W} θ' dHᵏ ≤ M_W(T)` for every open `W ⊆ V` with
`I < ∞`.  Let `ν = θ' Hᵏ⌞M'` and let `L` be the dual map of `dor_ims_unitOrientation_dual`, so
`ν`-a.e. `|ξ'(α)| ≤ |α|`, `|L(ξ')| ≤ 1` and `ξ'(L(ξ')) = 1`.  Lusin gives a compact `K ⊆ W` of such
points with `ν(W \ K) < η` on which `L ∘ ξ'` is continuous, and the smooth unit approximation an
admissible `ω` with `|ω − L ∘ ξ'| ≤ δ = η/(I + 1)` on `K`.  Then `ξ'(ω) ≥ (1 − δ) 1_K − 1_{W \ K}`
`ν`-a.e., so `T(ω) = ∫ ξ'(ω) dν ≥ (1 − δ) ν(K) − ν(W \ K) > I − 3η`. -/
theorem Submission.codim1_oriented_rep_lintegral_le_massOn : ∀ (P k : ℕ) (U V M' : Set (Euclid P)) (T : GeometricCurrentOn U k) (θ' : Euclid P → ℝ) (ξ' : Euclid P → MultiVector P k), V ⊆ U → Measurable θ' → (∀ x, 0 ≤ θ' x) → AEStronglyMeasurable ξ' (μHE[k].restrict M') → (∀ᵐ x ∂(μHE[k].restrict M'), ∃ Q : Submodule ℝ (Euclid P), IsUnitOrientationOf (ξ' x) Q) → (∀ ω : TestFormOn U k, tsupport (ω : DifferentialForm (Euclid P) k) ⊆ V → T ω = ∫ x in M', θ' x * ξ' x ((ω : DifferentialForm (Euclid P) k) x) ∂μHE[k]) → ∀ W : Set (Euclid P), IsOpen W → W ⊆ V → ∫⁻ x in M' ∩ W, ENNReal.ofReal (θ' x) ∂μHE[k] ≠ ∞ → ∫⁻ x in M' ∩ W, ENNReal.ofReal (θ' x) ∂μHE[k] ≤ T.massOn W := by
  intro P k U V M' T θ' ξ' hVU hθm hθ0 hξm hξo hT W hW hWV hI
  -- Step 1: the dual map `L` of the unit orientations
  obtain ⟨L, hL⟩ := Submission.dor_ims_unitOrientation_dual P k
  -- Step 2: `ν = θ' Hᵏ⌞M'`, with `ν ≪ Hᵏ⌞M'`, `ν(W) = I < ∞` and `∫ g dν = ∫_{M'} θ' g dHᵏ`
  set ν : Measure (Euclid P) :=
    (μHE[k].restrict M').withDensity fun x => ENNReal.ofReal (θ' x) with hν
  have hνμ : ν ≪ μHE[k].restrict M' := withDensity_absolutelyContinuous _ _
  have hνW : ν W = ∫⁻ x in M' ∩ W, ENNReal.ofReal (θ' x) ∂μHE[k] := by
    rw [hν, withDensity_apply _ hW.measurableSet, Measure.restrict_restrict hW.measurableSet,
      inter_comm]
  have hνW' : ν W ≠ ∞ := hνW ▸ hI
  -- `ν`-a.e. `x` is good, and the bad points lie in a measurable `ν`-null set `Z`
  have hgood : ∀ᵐ x ∂ν, (∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) ∧
      covectorEuclideanNorm (L (ξ' x)) ≤ 1 ∧ ξ' x (L (ξ' x)) = 1 :=
    hνμ.ae_le (hξo.mono fun x ⟨Q, hQ⟩ => hL (ξ' x) Q hQ)
  obtain ⟨Z, hZ, hZm, hZ0⟩ := exists_measurable_superset_of_null (ae_iff.mp hgood)
  have hξν : AEStronglyMeasurable ξ' ν := hξm.mono_ac hνμ
  have hdens : ∀ g : Euclid P → ℝ, ∫ x, g x ∂ν = ∫ x in M', θ' x * g x ∂μHE[k] := by
    intro g
    rw [hν, integral_withDensity_eq_integral_toReal_smul hθm.ennreal_ofReal
      (ae_of_all _ fun x => ENNReal.ofReal_lt_top)]
    refine integral_congr_ae (ae_of_all _ fun x => ?_)
    simp only [ENNReal.toReal_ofReal (hθ0 x), smul_eq_mul]
  set m : ℝ := ν.real W
  have hm0 : 0 ≤ m := measureReal_nonneg
  -- Steps 4–8: for every `η > 0` some admissible `ω` has `T(ω) > m - 3η`
  have key : ∀ η : ℝ, 0 < η →
      ∃ ω : TestFormOn U k, ω ∈ massAdmissibleOn U k W ∧ m - 3 * η < T ω := by
    intro η hη
    -- Step 4: Lusin on `W \ Z` gives a compact `K` of good points with `ν(W \ K) < η`
    obtain ⟨K, hKc, hKA, hKν, hLK⟩ := Submission.dor_ims_lusin_continuousOn P k ν (W \ Z)
      (fun x => L (ξ' x)) η (hW.measurableSet.diff hZm)
      (measure_ne_top_of_subset sdiff_subset hνW')
      (L.continuous.comp_aestronglyMeasurable hξν) hη
    have hKW : K ⊆ W := hKA.trans sdiff_subset
    have hKm : MeasurableSet K := hKc.measurableSet
    have hLK1 : ∀ x ∈ K, covectorEuclideanNorm (L (ξ' x)) ≤ 1 := by
      intro x hx
      by_contra h
      exact (hKA hx).2 (hZ fun hg => h hg.2.1)
    have hWK : ν.real (W \ K) < η := by
      refine ENNReal.toReal_lt_of_lt_ofReal ?_
      rwa [← measure_sdiff_null hZ0, sdiff_right_comm]
    -- Step 5: an admissible `ω` with `|ω - L ∘ ξ'| ≤ δ` on `K`
    set δ : ℝ := η / (m + 1) with hδ
    have hδ0 : 0 < δ := div_pos hη (by linarith)
    obtain ⟨ω₀, hω₀, hω₀W, hω₀1, hω₀K⟩ := Submission.dor_ims_smooth_unit_approx P k K W
      (fun x => L (ξ' x)) δ hKc hW hKW hLK hLK1 hδ0
    let ω : TestFormOn U k := ⟨ω₀, hω₀, hω₀W.trans (hWV.trans hVU)⟩
    refine ⟨ω, ⟨hω₀W, hω₀1⟩, ?_⟩
    have hω₀0 : ∀ x, x ∉ W → ω₀ x = 0 := fun x hx =>
      image_eq_zero_of_notMem_tsupport fun h => hx (hω₀W h)
    -- Step 6: `f = ξ'(ω₀)` is `ν`-integrable, as `|f| ≤ 1_W`, and `T(ω) = ∫ f dν`
    have hTω : T ω = ∫ x, ξ' x (ω₀ x) ∂ν := by
      rw [hdens]
      exact hT ω (hω₀W.trans hWV)
    have hfm : AEStronglyMeasurable (fun x => ξ' x (ω₀ x)) ν :=
      isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable
        (hξν.prodMk (ContDiff.continuous hω₀.1).aestronglyMeasurable)
    have hWi : Integrable (W.indicator (1 : Euclid P → ℝ)) ν :=
      (integrable_indicator_iff hW.measurableSet).mpr (integrableOn_const hνW')
    have hfi : Integrable (fun x => ξ' x (ω₀ x)) ν := by
      refine hWi.mono' hfm (hgood.mono fun x hx => ?_)
      by_cases hxW : x ∈ W
      · rw [indicator_of_mem hxW, Pi.one_apply, Real.norm_eq_abs]
        exact (hx.1 _).trans (hω₀1 x)
      · rw [indicator_of_notMem hxW, hω₀0 x hxW, map_zero, norm_zero]
    -- Step 7: `f ≥ (1 - δ) 1_K - 1_{W \ K}` `ν`-a.e.
    have hKi : Integrable (K.indicator (1 : Euclid P → ℝ)) ν :=
      (integrable_indicator_iff hKm).mpr (integrableOn_const (measure_ne_top_of_subset hKW hνW'))
    have hWKi : Integrable ((W \ K).indicator (1 : Euclid P → ℝ)) ν :=
      (integrable_indicator_iff (hW.measurableSet.diff hKm)).mpr
        (integrableOn_const (measure_ne_top_of_subset sdiff_subset hνW'))
    have hlow : ∀ᵐ x ∂ν,
        (1 - δ) * K.indicator 1 x - (W \ K).indicator 1 x ≤ ξ' x (ω₀ x) := by
      refine hgood.mono fun x hx => ?_
      by_cases hxK : x ∈ K
      · -- `f = 1 + ξ'(ω₀ - L(ξ')) ≥ 1 - |ω₀ - L(ξ')| ≥ 1 - δ`
        rw [indicator_of_mem hxK, indicator_of_notMem fun h => h.2 hxK, Pi.one_apply, mul_one,
          sub_zero]
        have h1 : ξ' x (ω₀ x) = 1 + ξ' x (ω₀ x - L (ξ' x)) := by
          rw [map_sub, hx.2.2]
          ring
        have h2 := (hx.1 (ω₀ x - L (ξ' x))).trans (hω₀K x hxK)
        rw [h1]
        linarith [neg_abs_le (ξ' x (ω₀ x - L (ξ' x)))]
      · rw [indicator_of_notMem hxK, mul_zero, zero_sub]
        by_cases hxW : x ∈ W
        · -- `f ≥ -|ω₀| ≥ -1`
          rw [indicator_of_mem (s := W \ K) ⟨hxW, hxK⟩, Pi.one_apply]
          linarith [neg_abs_le (ξ' x (ω₀ x)), (hx.1 (ω₀ x)).trans (hω₀1 x)]
        · -- `ω₀ = 0` off `W`
          rw [indicator_of_notMem fun h => hxW h.1, hω₀0 x hxW, map_zero, neg_zero]
    -- Step 8: `T(ω) ≥ (1 - δ) ν(K) - ν(W \ K) > m - 3η`, as `δ ν(K) ≤ δ m < η`,
    -- `ν(W \ K) < η` and `ν(K) = m - ν(W \ K)`
    have hge : (1 - δ) * ν.real K - ν.real (W \ K) ≤ T ω := by
      rw [hTω, ← integral_indicator_one hKm, ← integral_indicator_one (hW.measurableSet.diff hKm),
        ← integral_const_mul, ← integral_sub (hKi.const_mul _) hWKi]
      exact integral_mono_ae ((hKi.const_mul _).sub hWKi) hfi hlow
    have hsplit : ν.real (W \ K) = m - ν.real K := measureReal_sdiff hKW hKm hνW'
    have hKle : ν.real K ≤ m := measureReal_mono hKW hνW'
    have hδm : δ * m < η := by
      rw [hδ, div_mul_eq_mul_div, div_lt_iff₀ (by linarith)]
      nlinarith
    have hδK : δ * ν.real K ≤ δ * m := mul_le_mul_of_nonneg_left hKle hδ0.le
    have hexp : (1 - δ) * ν.real K = ν.real K - δ * ν.real K := by ring
    linarith
  -- Steps 3 and 9: every `r < I` is at most `M_W(T)`, via `key` for `η = (m - r)/3`
  refine ENNReal.le_of_forall_nnreal_lt fun r hr => ?_
  rw [← hνW] at hr
  have hrm : (r : ℝ) < m := ENNReal.toReal_strict_mono hνW' hr
  obtain ⟨ω, hω, hTω⟩ := key ((m - r) / 3) (by linarith)
  calc (r : ℝ≥0∞) = ENNReal.ofReal r := ENNReal.ofReal_coe_nnreal.symm
    _ ≤ ENNReal.ofReal (T ω) := ENNReal.ofReal_le_ofReal (by linarith)
    _ ≤ T.massOn W := T.le_massOn hω

/-- **Mass of a current given on `V` by an oriented weighted set** (Simon Ch. 6, 2.5 and 3.2(3):
`M_W(T) = ∫_{M ∩ W} θ dHᵏ` for `T = τ(M, θ, ξ)`, with a general weight `θ' ≥ 0`).  Let
`I(W) = ∫⁻_{M' ∩ W} θ' dHᵏ` for an open `W ⊆ V`.  Step 2: `|θ' ξ'(ω)| ≤ θ' 1_W` a.e. on `M'` for
every admissible `ω`, so `M_W(T) ≤ I(W)`.  Step 3: if `I(W) < ∞`, a smooth admissible form close
to `L ∘ ξ'` on a compact `K ⊆ M' ∩ W` of almost full `θ' Hᵏ`-measure gives `I(W) ≤ M_W(T)`, and
equality follows by antisymmetry. -/
theorem Submission.codim1_massOn_eq_lintegral_of_oriented_rep : ∀ (P k : ℕ) (U V M' : Set (Euclid P)) (T : GeometricCurrentOn U k) (θ' : Euclid P → ℝ) (ξ' : Euclid P → MultiVector P k), IsOpen V → V ⊆ U → MeasurableSet M' → M' ⊆ V → Measurable θ' → (∀ x, 0 ≤ θ' x) → AEStronglyMeasurable ξ' (μHE[k].restrict M') → (∀ᵐ x ∂(μHE[k].restrict M'), ∃ Q : Submodule ℝ (Euclid P), IsUnitOrientationOf (ξ' x) Q) → (∀ ω : TestFormOn U k, tsupport (ω : DifferentialForm (Euclid P) k) ⊆ V → T ω = ∫ x in M', θ' x * ξ' x ((ω : DifferentialForm (Euclid P) k) x) ∂μHE[k]) → ∀ W : Set (Euclid P), IsOpen W → W ⊆ V → T.massOn W ≤ ∫⁻ x in M' ∩ W, ENNReal.ofReal (θ' x) ∂μHE[k] ∧ (∫⁻ x in M' ∩ W, ENNReal.ofReal (θ' x) ∂μHE[k] ≠ ∞ → T.massOn W = ∫⁻ x in M' ∩ W, ENNReal.ofReal (θ' x) ∂μHE[k]) := by
  intro P k U V M' T θ' ξ' _hV hVU _hM' _hM'V hθ hθ0 hξ hξQ hT W hW hWV
  -- Step 2: `M_W(T) ≤ I(W)`; the open set `W` is Borel
  have hle := Submission.codim1_oriented_rep_massOn_le_lintegral P k U V M' T θ' ξ' hθ0 hξQ hT W
    hW.measurableSet hWV
  -- Step 3: `I(W) ≤ M_W(T)` when `I(W) < ∞`, hence `M_W(T) = I(W)`
  exact ⟨hle, fun hI => le_antisymm hle
    (Submission.codim1_oriented_rep_lintegral_le_massOn P k U V M' T θ' ξ' hVU hθ hθ0 hξ hξQ hT W hW
      hWV hI)⟩
/-- **Countably `n`-rectifiable sets of finite measure have density one a.e.** (general fact
(G7); Simon Ch. 3, Lemma 1.2, Remark 1.3, the proof of Theorem 1.6 "⇒" and Remark 1.5(3),
chapter-03.txt lines 25–144).  Let `M ⊆ ℝᴾ` be Borel and countably `n`-rectifiable with
`Hⁿ(M) < ∞`.  Then `Hⁿ(M ∩ K) ≤ Hⁿ(M) < ∞` for every compact `K`, so by Theorem 1.6 "⇒" the
approximate tangent space `T_wM` exists for `Hⁿ`-a.e. `w ∈ M`.  At such `w`, `Hⁿ(M ∩ B̄_1(w))` is
finite, so `Hⁿ(M ∩ B̄_t(w)) / (ωₙtⁿ) → 1` by Remark 1.5(3); for the measure `Hⁿ⌞M` this
closed-ball limit gives the open-ball limit `Hⁿ(M ∩ B_t(w)) / (ωₙtⁿ) → 1` as `t ↓ 0`. -/
theorem Submission.codim1_rdo_rectifiable_ae_density_one : ∀ (P n : ℕ) (M : Set (Euclid P)), 1 ≤ n → MeasurableSet M → CountablyRectifiable n M → μHE[n] M ≠ ∞ → ∀ᵐ w ∂(μHE[n].restrict M), Tendsto (fun t : ℝ => μHE[n] (M ∩ ball w t) / (unitBallVolume n * ENNReal.ofReal (t ^ n))) (𝓝[>] 0) (𝓝 1) := by
  intro P n M _ hM hrect hfin
  -- Step 1: `Hⁿ(M ∩ K) ≤ Hⁿ(M) < ∞` for every `K`
  have hloc : ∀ K : Set (Euclid P), μHE[n] (M ∩ K) ≠ ∞ := fun K =>
    ne_top_of_le_ne_top hfin (measure_mono inter_subset_left)
  -- Step 2 (Lemma 1.2, Remark 1.3, Theorem 1.6 "⇒"): approximate tangent spaces `Hⁿ`-a.e. on `M`
  have htan := Submission.codim1_rdo_rectifiable_ae_approxTangent P n M hM hrect fun K _ => hloc K
  -- Step 3: `Hⁿ⌞M` evaluates as `Hⁿ(M ∩ ·)`
  have hν : ∀ s : Set (Euclid P), μHE[n].restrict M s = μHE[n] (M ∩ s) := fun s => by
    rw [Measure.restrict_apply' hM, inter_comm]
  filter_upwards [htan] with w ⟨Q, hQ⟩
  -- Step 4 (Remark 1.5(3)): closed-ball density one at `w`, as `Hⁿ(M ∩ B̄_1(w)) < ∞`
  have hclosed := Submission.rsd_tendsto_closedBall_density_of_approxTangent P n M w Q 1 one_pos
    (hloc _) hQ
  -- Step 5: from closed to open balls, for the measure `Hⁿ⌞M`
  exact (Submission.rsd_tendsto_ball_density_of_closedBall P n (μHE[n].restrict M) w 1
    (hclosed.congr fun ρ => by rw [hν])).congr fun ρ => by rw [hν]
/-- **`μ = Hᵐ⌞B` with approximate tangent planes `ν(y)^⊥`** (Simon Ch. 3, 4.3, first part, given
the rectifiable density theorem (RD)).  Let `μ` be locally finite in the open set `D ⊆ ℝ^{m+1}`,
carried by `D`, with flat tangent measure `Hᵐ⌞ν(y)^⊥` at `μ`-a.e. `y`.  Then `μ = Hᵐ⌞B` for a
Borel countably `m`-rectifiable `B ⊆ D` whose approximate tangent space (Ch. 3, 1.4) at
`Hᵐ`-a.e. `y ∈ B` is `ν(y)^⊥`.  Take `B = (D ∩ R) \ N`, with `R` from
`codim1_rdo_dg_rectifiable_of_flat_tangent` and `N` a Borel `μ`-null set off which the flat
tangent exists, so `Θᵐ(μ, y) = 1` on `B` (`codim1_rdo_dg_flat_tangent_density_cone`).  A Vitali
`5r`-covering bounds `Hᵐ⌞B` locally by `μ`, and small covers give `μ ≪ Hᵐ⌞B`; (RD) gives
`Θᵐ(Hᵐ⌞B, w) = 1` a.e., so Besicovitch differentiation yields `dμ/d(Hᵐ⌞B) = 1` and `μ = Hᵐ⌞B`.
Finally `Hᵐ(η_{y,r}(A)) = r⁻ᵐ Hᵐ(A)` turns the flat tangent measure into Definition 1.4. -/
theorem Submission.codim1_rdo_dg_measure_eq_hausdorff : ∀ (m : ℕ) (D : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)), 1 ≤ m → IsOpen D → μ Dᶜ = 0 → (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μ K ≠ ∞) → Measurable ν → (∀ y, ‖ν y‖ = 1) → (∀ᵐ y ∂μ, ∀ f : Euclid (m + 1) → ℝ, Continuous f → HasCompactSupport f → Tendsto (fun r : ℝ => (r ^ m)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) ∂μ) (𝓝[>] 0) (𝓝 (∫ z in ((Submodule.span ℝ {ν y})ᗮ : Set (Euclid (m + 1))), f z ∂μHE[m]))) → (∀ S : Set (Euclid (m + 1)), MeasurableSet S → CountablyRectifiable m S → μHE[m] S ≠ ∞ → ∀ᵐ w ∂(μHE[m].restrict S), Tendsto (fun t : ℝ => μHE[m] (S ∩ ball w t) / (unitBallVolume m * ENNReal.ofReal (t ^ m))) (𝓝[>] 0) (𝓝 1)) → ∃ B : Set (Euclid (m + 1)), MeasurableSet B ∧ B ⊆ D ∧ CountablyRectifiable m B ∧ μ = μHE[m].restrict B ∧ ∀ᵐ y ∂(μHE[m].restrict B), HasApproximateTangentSpaceAt m B y (Submodule.span ℝ {ν y})ᗮ := by
  intro m D μ ν hm hD hμD hμK hνm hν1 hflat hRD
  -- (step 3 tool) local copy of the accepted `dorag_sn_hausdorff_le_mul_of_lower_density`
  have hcmp_gen : ∀ (N n : ℕ) (c : ℝ), 0 < c → ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ (ν : Measure (Euclid N)) (A O : Set (Euclid N)), IsOpen O → A ⊆ O → (∀ x ∈ A, ∃ t₀ : ℝ, 0 < t₀ ∧ ∀ t : ℝ, 0 < t → t < t₀ → ENNReal.ofReal (c * t ^ n) ≤ ν (closedBall x t)) → μHE[n] A ≤ C * ν O := by
    intro N n c hc
    -- `μHE[n] = k • μH[n]` with a finite factor `k`; take `C = k · 10ⁿ / c`
    set k : NNReal :=
      Measure.addHaarScalarFactor (volume : Measure (EuclideanSpace ℝ (Fin n))) μH[(n : ℝ)]
    refine ⟨(k : ℝ≥0∞) * ENNReal.ofReal (10 ^ n / c),
      ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.ofReal_ne_top, ?_⟩
    intro ν A O hO hAO hA
    have hdiam : ∀ (y : Euclid N) (ρ : ℝ), ediam (closedBall y ρ) ≤ ENNReal.ofReal (2 * ρ) := by
      intro y ρ
      apply ediam_le_of_forall_dist_le
      intro z hz w hw
      rw [mem_closedBall] at hz hw
      linarith [dist_triangle_right z w y]
    -- scale `δ = 1 / (m + 1)`: a countable disjoint family of admissible balls whose 5-times
    -- enlargements cover `A`, of total cost at most `(10ⁿ/c) ν(O)`
    have step : ∀ m : ℕ, ∃ u : Set (Euclid N × ℝ), u.Countable ∧
        (∀ p ∈ u, ediam (closedBall p.1 (5 * p.2)) ≤ ENNReal.ofReal (1 / ((m : ℝ) + 1))) ∧
        A ⊆ ⋃ p : u, closedBall (p : Euclid N × ℝ).1 (5 * (p : Euclid N × ℝ).2) ∧
        ∑' p : u, ediam (closedBall (p : Euclid N × ℝ).1 (5 * (p : Euclid N × ℝ).2)) ^ (n : ℝ) ≤
          ENNReal.ofReal (10 ^ n / c) * ν O := by
      intro m
      set δ : ℝ := 1 / ((m : ℝ) + 1)
      have hδpos : 0 < δ := by positivity
      -- the admissible balls, as (center, radius) pairs
      set T : Set (Euclid N × ℝ) := {p | p.1 ∈ A ∧ 0 < p.2 ∧ 10 * p.2 ≤ δ ∧
        closedBall p.1 p.2 ⊆ O ∧ ENNReal.ofReal (c * p.2 ^ n) ≤ ν (closedBall p.1 p.2)}
      obtain ⟨u, huT, hudisj, hucov⟩ :=
        Vitali.exists_disjoint_subfamily_covering_enlargement_closedBall T (fun p => p.1)
          (fun p => p.2) δ (fun p hp => by linarith [hp.2.2.1, hp.2.1]) 5 (by norm_num)
      -- disjoint balls with nonempty interiors in the separable space `ℝᴺ`
      have hucount : u.Countable := by
        refine hudisj.countable_of_nonempty_interior fun p hp => ?_
        exact ⟨p.1, ball_subset_interior_closedBall (mem_ball_self (huT hp).2.1)⟩
      refine ⟨u, hucount, fun p hp => ?_, ?_, ?_⟩
      · obtain ⟨-, -, hpδ, -, -⟩ := huT hp
        refine (hdiam _ _).trans (ENNReal.ofReal_le_ofReal ?_)
        linarith
      · -- each `x ∈ A` is the center of a small admissible ball
        intro x hx
        obtain ⟨t₀, ht₀, hbound⟩ := hA x hx
        obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hO x (hAO hx)
        set r : ℝ := min (t₀ / 2) (min (ε / 2) (δ / 10))
        have hrpos : 0 < r := by positivity
        have hr₁ := min_le_left (t₀ / 2) (min (ε / 2) (δ / 10))
        have hr₂ := min_le_right (t₀ / 2) (min (ε / 2) (δ / 10))
        have hr₃ := min_le_left (ε / 2) (δ / 10)
        have hr₄ := min_le_right (ε / 2) (δ / 10)
        have hmem : (x, r) ∈ T :=
          ⟨hx, hrpos, by linarith, (closedBall_subset_ball (by linarith)).trans hball,
            hbound r hrpos (by linarith)⟩
        obtain ⟨b, hbu, hsub⟩ := hucov (x, r) hmem
        exact mem_iUnion.2 ⟨⟨b, hbu⟩, hsub (mem_closedBall_self hrpos.le)⟩
      · calc ∑' p : u, ediam (closedBall (p : Euclid N × ℝ).1 (5 * (p : Euclid N × ℝ).2)) ^ (n : ℝ)
            ≤ ∑' p : u, ENNReal.ofReal (10 ^ n / c) *
                ν (closedBall (p : Euclid N × ℝ).1 (p : Euclid N × ℝ).2) := by
              refine ENNReal.tsum_le_tsum fun p => ?_
              obtain ⟨-, hp0, -, -, hpν⟩ := huT p.2
              calc ediam (closedBall (p : Euclid N × ℝ).1 (5 * (p : Euclid N × ℝ).2)) ^ (n : ℝ)
                  ≤ ENNReal.ofReal (2 * (5 * (p : Euclid N × ℝ).2)) ^ (n : ℝ) :=
                    ENNReal.rpow_le_rpow (hdiam _ _) (Nat.cast_nonneg n)
                _ = ENNReal.ofReal (10 ^ n / c) * ENNReal.ofReal (c * (p : Euclid N × ℝ).2 ^ n) := by
                    rw [ENNReal.rpow_natCast, ← ENNReal.ofReal_pow (by positivity),
                      ← ENNReal.ofReal_mul (by positivity)]
                    congr 1
                    field_simp
                    ring
                _ ≤ ENNReal.ofReal (10 ^ n / c) *
                      ν (closedBall (p : Euclid N × ℝ).1 (p : Euclid N × ℝ).2) := by
                    gcongr
          _ = ENNReal.ofReal (10 ^ n / c) * ν (⋃ p ∈ u, closedBall p.1 p.2) := by
              rw [ENNReal.tsum_mul_left,
                measure_biUnion hucount hudisj fun p _ => measurableSet_closedBall]
          _ ≤ ENNReal.ofReal (10 ^ n / c) * ν O := by
              gcongr
              exact iUnion₂_subset fun p hp => (huT hp).2.2.2.1
    choose u hucount hudiam hucov husum using step
    have : ∀ m, Countable (u m) := fun m => (hucount m).to_subtype
    -- covers of mesh `1 / (m + 1) → 0`
    have main : μH[(n : ℝ)] A ≤ ENNReal.ofReal (10 ^ n / c) * ν O := by
      calc μH[(n : ℝ)] A
          ≤ liminf (fun m => ∑' p : u m,
              ediam (closedBall (p : Euclid N × ℝ).1 (5 * (p : Euclid N × ℝ).2)) ^ (n : ℝ)) atTop := by
            refine Measure.hausdorffMeasure_le_liminf_tsum (ι := fun m => u m) (n : ℝ) A
              (fun m : ℕ => ENNReal.ofReal (1 / ((m : ℝ) + 1))) ?_
              (fun m p => closedBall (p : Euclid N × ℝ).1 (5 * (p : Euclid N × ℝ).2))
              (Eventually.of_forall fun m p => hudiam m p p.2) (Eventually.of_forall hucov)
            simpa using ENNReal.tendsto_ofReal (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ))
        _ ≤ ENNReal.ofReal (10 ^ n / c) * ν O :=
            liminf_le_of_frequently_le' (Frequently.of_forall husum)
    calc μHE[n] A = (k : ℝ≥0∞) * μH[(n : ℝ)] A := by
          rw [Measure.euclideanHausdorffMeasure_def, Measure.smul_apply, ENNReal.smul_def,
            smul_eq_mul]
      _ ≤ (k : ℝ≥0∞) * (ENNReal.ofReal (10 ^ n / c) * ν O) := by gcongr
      _ = (k : ℝ≥0∞) * ENNReal.ofReal (10 ^ n / c) * ν O := by rw [mul_assoc]
  -- (step 4 tool) `Hⁿ`-null sets of closed-ball density-one points of `μ` are `μ`-null
  have hnull_gen : ∀ (P n : ℕ) (μ : Measure (Euclid P)) (A : Set (Euclid P)), (∀ x ∈ A, Tendsto (fun r : ℝ => μ (closedBall x r) / (unitBallVolume n * ENNReal.ofReal (r ^ n))) (𝓝[>] 0) (𝓝 1)) → μHE[n] A = 0 → μ A = 0 := by
    intro P n μ A hdens hA
    have hω0 : unitBallVolume n ≠ 0 := (measure_ball_pos _ _ zero_lt_one).ne'
    have hωtop : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
    set C : ℝ≥0∞ := 2 * unitBallVolume n with hCdef
    have hC0 : C ≠ 0 := mul_ne_zero two_ne_zero hω0
    have hCtop : C ≠ ∞ := ENNReal.mul_ne_top ENNReal.ofNat_ne_top hωtop
    -- the pieces `A_k` on which `μ` has uniform growth below radius `1/(k+1)`
    set Ak : ℕ → Set (Euclid P) := fun k => {x | x ∈ A ∧ ∀ r : ℝ, 0 < r → r ≤ 1 / ((k : ℝ) + 1) →
      μ (closedBall x r) ≤ C * ENNReal.ofReal r ^ n} with hAkdef
    have hcover : A ⊆ ⋃ k, Ak k := by
      intro x hx
      have h2 : ∀ᶠ r in 𝓝[>] (0 : ℝ),
          μ (closedBall x r) / (unitBallVolume n * ENNReal.ofReal (r ^ n)) < 2 :=
        (hdens x hx).eventually (gt_mem_nhds (by norm_num))
      obtain ⟨δ, hδ, hδsub⟩ := (nhdsGT_basis (0 : ℝ)).mem_iff.mp h2
      obtain ⟨k, hk⟩ := exists_nat_one_div_lt hδ
      refine mem_iUnion.mpr ⟨k, hx, fun r hr hrk => ?_⟩
      have hq := hδsub ⟨hr, hrk.trans_lt hk⟩
      have hc0 : unitBallVolume n * ENNReal.ofReal (r ^ n) ≠ 0 :=
        mul_ne_zero hω0 (ENNReal.ofReal_pos.mpr (pow_pos hr n)).ne'
      have hctop : unitBallVolume n * ENNReal.ofReal (r ^ n) ≠ ∞ :=
        ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top
      have := ((ENNReal.div_lt_iff (Or.inl hc0) (Or.inl hctop)).mp hq).le
      calc μ (closedBall x r) ≤ 2 * (unitBallVolume n * ENNReal.ofReal (r ^ n)) := this
        _ = C * ENNReal.ofReal r ^ n := by rw [hCdef, ENNReal.ofReal_pow hr.le, mul_assoc]
    -- every `A_k` is `μ`-null
    have hnull : ∀ k, μ (Ak k) = 0 := by
      intro k
      set R : ℝ := 1 / ((k : ℝ) + 1) with hRdef
      have hR : 0 < R := by positivity
      have hHk : μH[(n : ℝ)] (Ak k) = 0 := by
        have h0 : μHE[n] (Ak k) = 0 := measure_mono_null (fun x hx => hx.1) hA
        rw [Measure.euclideanHausdorffMeasure_def, Measure.smul_apply, ENNReal.smul_def,
          smul_eq_mul] at h0
        exact (mul_eq_zero.mp h0).resolve_left (by
          simpa using Measure.addHaarScalarFactor_volume_hausdorffMeasure_ne_zero n)
      have hdiam : ∀ s : Set (Euclid P), ediam s ≤ ENNReal.ofReal R →
          OuterMeasure.restrict (Ak k) μ.toOuterMeasure s ≤ C * ediam s ^ n := by
        intro s hs
        rw [OuterMeasure.restrict_apply, Measure.toOuterMeasure_apply]
        rcases (s ∩ Ak k).eq_empty_or_nonempty with he | ⟨x, hxs, hxA⟩
        · simp only [he, measure_empty, zero_le]
        have hsfin : ediam s ≠ ∞ := ne_top_of_le_ne_top ENNReal.ofReal_ne_top hs
        have hdR : (ediam s).toReal ≤ R := ENNReal.toReal_le_of_le_ofReal hR.le hs
        have hsub : s ∩ Ak k ⊆ closedBall x (ediam s).toReal := by
          intro y hy
          change dist y x ≤ (ediam s).toReal
          simpa only [edist_dist, ENNReal.toReal_ofReal dist_nonneg] using
            (ENNReal.toReal_mono hsfin (edist_le_ediam_of_mem hy.1 hxs))
        apply (measure_mono hsub).trans
        by_cases hd : 0 < (ediam s).toReal
        · simpa only [ENNReal.ofReal_toReal hsfin] using hxA.2 _ hd hdR
        · have hd0 : (ediam s).toReal = 0 := le_antisymm (not_lt.mp hd) ENNReal.toReal_nonneg
          have hed0 : ediam s = 0 := by
            rw [← ENNReal.ofReal_toReal hsfin, hd0, ENNReal.ofReal_zero]
          rw [hd0, hed0]
          -- zero radius: let the radius tend to zero in the growth bound
          have hid : Tendsto (fun r : ℝ ↦ r) (𝓝[>] 0) (𝓝 0) :=
            tendsto_id.mono_left inf_le_left
          have hlim : Tendsto (fun r : ℝ ↦ C * (ENNReal.ofReal r) ^ n) (𝓝[>] 0)
              (𝓝 (C * (0 : ℝ≥0∞) ^ n)) := by
            simpa only [ENNReal.ofReal_zero, Function.comp_def] using
              ENNReal.Tendsto.const_mul
                (ENNReal.Tendsto.pow (ENNReal.continuous_ofReal.continuousAt.tendsto.comp hid))
                (Or.inr hCtop)
          apply ge_of_tendsto hlim
          filter_upwards [Ioo_mem_nhdsGT hR] with r hr
          exact (measure_mono (closedBall_subset_closedBall hr.1.le)).trans
            (hxA.2 r hr.1 hr.2.le)
      have hm := OuterMeasure.le_mkMetric (fun d : ℝ≥0∞ ↦ C * d ^ n)
        (OuterMeasure.restrict (Ak k) μ.toOuterMeasure) (ENNReal.ofReal R)
        (ENNReal.ofReal_pos.mpr hR) hdiam
      have hcost : (fun d : ℝ≥0∞ ↦ C * d ^ n) = C • (fun d : ℝ≥0∞ ↦ d ^ (n : ℝ)) := by
        funext d
        simp only [Pi.smul_apply, smul_eq_mul, ENNReal.rpow_natCast]
      rw [hcost, OuterMeasure.mkMetric_smul _ hCtop hC0] at hm
      have hk := hm (Ak k)
      rw [OuterMeasure.restrict_apply, inter_self, Measure.toOuterMeasure_apply,
        smul_apply, smul_eq_mul] at hk
      have hH : OuterMeasure.mkMetric (fun d : ℝ≥0∞ ↦ d ^ (n : ℝ)) (Ak k) = 0 := by
        have : (μH[(n : ℝ)] : Measure (Euclid P)).toOuterMeasure =
            OuterMeasure.mkMetric (fun d : ℝ≥0∞ ↦ d ^ (n : ℝ)) := by
          rw [Measure.hausdorffMeasure, Measure.mkMetric_toOuterMeasure]
        rw [← this, Measure.toOuterMeasure_apply, hHk]
      rw [hH, mul_zero] at hk
      exact le_antisymm hk zero_le
    exact measure_mono_null hcover (measure_iUnion_null hnull)
  -- (step 5 tool) (RD) on pieces `B ∩ ball` gives closed-ball density one of `Hⁿ⌞B` a.e.
  have hdens_gen : ∀ (P n : ℕ) (D B : Set (Euclid P)), IsOpen D → MeasurableSet B → B ⊆ D → CountablyRectifiable n B → (∀ K : Set (Euclid P), IsCompact K → K ⊆ D → μHE[n] (B ∩ K) ≠ ∞) → (∀ S : Set (Euclid P), MeasurableSet S → CountablyRectifiable n S → μHE[n] S ≠ ∞ → ∀ᵐ w ∂(μHE[n].restrict S), Tendsto (fun t : ℝ => μHE[n] (S ∩ ball w t) / (unitBallVolume n * ENNReal.ofReal (t ^ n))) (𝓝[>] 0) (𝓝 1)) → ∀ᵐ w ∂(μHE[n].restrict B), Tendsto (fun t : ℝ => (μHE[n].restrict B) (closedBall w t) / (unitBallVolume n * ENNReal.ofReal (t ^ n))) (𝓝[>] 0) (𝓝 1) := by
    intro P n D B hD hBm hBD hBrect hloc hRD
    have hω0 : unitBallVolume n ≠ 0 := (measure_ball_pos _ _ zero_lt_one).ne'
    have hωtop : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
    -- Step 1: open-ball density one of `Hⁿ⌞B` at `Hⁿ⌞B`-a.e. point, from (RD) on pieces
    have hopen : ∀ᵐ w ∂(μHE[n].restrict B), Tendsto (fun t : ℝ => μHE[n] (B ∩ ball w t) /
        (unitBallVolume n * ENNReal.ofReal (t ^ n))) (𝓝[>] 0) (𝓝 1) := by
      have hrad : ∀ x : D, ∃ ε : ℝ, 0 < ε ∧ closedBall (x : Euclid P) ε ⊆ D := by
        intro x
        obtain ⟨ε, hε, hεD⟩ := Metric.isOpen_iff.mp hD x x.2
        exact ⟨ε / 2, half_pos hε, (closedBall_subset_ball (half_lt_self hε)).trans hεD⟩
      choose ε hε hεD using hrad
      obtain ⟨T, hTc, hT⟩ := TopologicalSpace.isOpen_iUnion_countable
        (fun x : D => ball (x : Euclid P) (ε x)) (fun _ => isOpen_ball)
      have hcov : (⋃ x ∈ T, ball (x : Euclid P) (ε x)) = D := by
        rw [hT]
        apply subset_antisymm
        · exact iUnion_subset fun x => ball_subset_closedBall.trans (hεD x)
        · intro y hy
          exact mem_iUnion.mpr ⟨⟨y, hy⟩, mem_ball_self (hε ⟨y, hy⟩)⟩
      have hBae : ∀ᵐ w ∂(μHE[n].restrict B), w ∈ D :=
        (ae_restrict_mem hBm).mono fun w hw => hBD hw
      rw [← Measure.restrict_eq_self_of_ae_mem hBae, ← hcov,
        ae_restrict_biUnion_iff _ hTc]
      intro x _
      rw [Measure.restrict_restrict measurableSet_ball]
      have hSm : MeasurableSet (ball (x : Euclid P) (ε x) ∩ B) := measurableSet_ball.inter hBm
      have hSrect : CountablyRectifiable n (ball (x : Euclid P) (ε x) ∩ B) :=
        hBrect.mono inter_subset_right
      have hSfin : μHE[n] (ball (x : Euclid P) (ε x) ∩ B) ≠ ∞ :=
        ne_top_of_le_ne_top (hloc _ (isCompact_closedBall _ _) (hεD x))
          (measure_mono fun y hy => ⟨hy.2, ball_subset_closedBall hy.1⟩)
      filter_upwards [hRD _ hSm hSrect hSfin, ae_restrict_mem hSm] with w hw hwS
      refine hw.congr' ?_
      obtain ⟨δ, hδ, hδW⟩ := Metric.isOpen_iff.mp isOpen_ball w hwS.1
      filter_upwards [Ioo_mem_nhdsGT hδ] with t ht
      have hset : ball (x : Euclid P) (ε x) ∩ B ∩ ball w t = B ∩ ball w t := by
        ext y
        constructor
        · rintro ⟨⟨_, hyB⟩, hyt⟩
          exact ⟨hyB, hyt⟩
        · rintro ⟨hyB, hyt⟩
          exact ⟨⟨hδW (ball_subset_ball ht.2.le hyt), hyB⟩, hyt⟩
      rw [hset]
    -- Step 2: pass from open to closed balls by squeezing between radii `t` and `t + t²`
    filter_upwards [hopen] with w hw
    set c : ℝ → ℝ≥0∞ := fun t => unitBallVolume n * ENNReal.ofReal (t ^ n) with hcdef
    set q : ℝ → ℝ≥0∞ := fun t => μHE[n] (B ∩ ball w t) / c t with hqdef
    have hs : Tendsto (fun t : ℝ => t + t ^ 2) (𝓝[>] 0) (𝓝[>] 0) := by
      apply tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within
      · have : Tendsto (fun t : ℝ => t + t ^ 2) (𝓝 0) (𝓝 (0 + 0 ^ 2)) :=
          (continuous_id.add (continuous_pow 2)).tendsto 0
        simpa using this.mono_left nhdsWithin_le_nhds
      · filter_upwards [self_mem_nhdsWithin] with t ht
        exact add_pos_of_pos_of_nonneg ht (sq_nonneg t)
    have hk : Tendsto (fun t : ℝ => ENNReal.ofReal ((1 + t) ^ n)) (𝓝[>] 0) (𝓝 1) := by
      have : Tendsto (fun t : ℝ => ENNReal.ofReal ((1 + t) ^ n)) (𝓝 0)
          (𝓝 (ENNReal.ofReal ((1 + 0) ^ n))) :=
        (ENNReal.continuous_ofReal.comp
          ((continuous_const.add continuous_id).pow n)).tendsto 0
      simpa using this.mono_left nhdsWithin_le_nhds
    have hupper : Tendsto (fun t : ℝ => ENNReal.ofReal ((1 + t) ^ n) * q (t + t ^ 2))
        (𝓝[>] 0) (𝓝 1) := by
      have := ENNReal.Tendsto.mul hk (Or.inl one_ne_zero) (hw.comp hs) (Or.inl one_ne_zero)
      simpa using this
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le' hw hupper ?_ ?_
    · filter_upwards [self_mem_nhdsWithin] with t ht
      show μHE[n] (B ∩ ball w t) / c t ≤ (μHE[n].restrict B) (closedBall w t) / c t
      rw [Measure.restrict_apply measurableSet_closedBall]
      have hsub : B ∩ ball w t ⊆ closedBall w t ∩ B := fun y hy =>
        ⟨ball_subset_closedBall hy.2, hy.1⟩
      exact ENNReal.div_le_div_right (measure_mono hsub) _
    · filter_upwards [self_mem_nhdsWithin] with t ht
      have ht0 : (0 : ℝ) < t := ht
      have hk0 : ENNReal.ofReal ((1 + t) ^ n) ≠ 0 :=
        (ENNReal.ofReal_pos.mpr (pow_pos (by linarith) n)).ne'
      have hktop : ENNReal.ofReal ((1 + t) ^ n) ≠ ∞ := ENNReal.ofReal_ne_top
      have hc0 : c t ≠ 0 := mul_ne_zero hω0 (ENNReal.ofReal_pos.mpr (pow_pos ht0 n)).ne'
      have hctop : c t ≠ ∞ := ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top
      have hcs : c (t + t ^ 2) = c t * ENNReal.ofReal ((1 + t) ^ n) := by
        simp only [hcdef]
        rw [mul_assoc, ← ENNReal.ofReal_mul (pow_nonneg ht0.le n), ← mul_pow]
        congr 3
        ring
      show (μHE[n].restrict B) (closedBall w t) / c t ≤
        ENNReal.ofReal ((1 + t) ^ n) * (μHE[n] (B ∩ ball w (t + t ^ 2)) / c (t + t ^ 2))
      rw [Measure.restrict_apply measurableSet_closedBall, hcs]
      have hsub : closedBall w t ∩ B ⊆ B ∩ ball w (t + t ^ 2) := fun y hy =>
        ⟨hy.2, closedBall_subset_ball (by nlinarith) hy.1⟩
      calc μHE[n] (closedBall w t ∩ B) / c t
          ≤ μHE[n] (B ∩ ball w (t + t ^ 2)) / c t := ENNReal.div_le_div_right (measure_mono hsub) _
        _ = ENNReal.ofReal ((1 + t) ^ n) *
            (μHE[n] (B ∩ ball w (t + t ^ 2)) / (c t * ENNReal.ofReal ((1 + t) ^ n))) := by
          rw [ENNReal.div_eq_inv_mul, ENNReal.div_eq_inv_mul,
            ENNReal.mul_inv (Or.inl hc0) (Or.inl hctop), ← mul_assoc, ← mul_assoc,
            mul_comm (ENNReal.ofReal _) (c t)⁻¹, mul_assoc (c t)⁻¹,
            ENNReal.mul_inv_cancel hk0 hktop, mul_one]
  -- (step 6 tool) `μ ≪ ρ` and ball ratios `μ/ρ → 1` `ρ`-a.e. force `μ = ρ` (Besicovitch)
  have heq_gen : ∀ (P : ℕ) (D : Set (Euclid P)) (μ ρ : Measure (Euclid P)), IsOpen D → μ Dᶜ = 0 → ρ Dᶜ = 0 → (∀ K : Set (Euclid P), IsCompact K → K ⊆ D → μ K ≠ ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ D → ρ K ≠ ∞) → μ ≪ ρ → (∀ᵐ w ∂ρ, Tendsto (fun t : ℝ => μ (closedBall w t) / ρ (closedBall w t)) (𝓝[>] 0) (𝓝 1)) → μ = ρ := by
    intro P D μ ρ hD hμD hρD hμK hρK hac hratio
    -- Step 1: equality on every open ball whose closure lies in `D`
    have hlocal : ∀ c : Euclid P, ∀ s : ℝ, closedBall c s ⊆ D →
        μ.restrict (ball c s) = ρ.restrict (ball c s) := by
      intro c s hcs
      have hfinμ : μ (ball c s) ≠ ∞ := ne_top_of_le_ne_top
        (hμK _ (isCompact_closedBall c s) hcs) (measure_mono ball_subset_closedBall)
      have hfinρ : ρ (ball c s) ≠ ∞ := ne_top_of_le_ne_top
        (hρK _ (isCompact_closedBall c s) hcs) (measure_mono ball_subset_closedBall)
      have : IsFiniteMeasure (μ.restrict (ball c s)) :=
        ⟨by rw [Measure.restrict_apply_univ]; exact hfinμ.lt_top⟩
      have : IsFiniteMeasure (ρ.restrict (ball c s)) :=
        ⟨by rw [Measure.restrict_apply_univ]; exact hfinρ.lt_top⟩
      have hacW : μ.restrict (ball c s) ≪ ρ.restrict (ball c s) := hac.restrict _
      have hone : (μ.restrict (ball c s)).rnDeriv (ρ.restrict (ball c s))
          =ᵐ[ρ.restrict (ball c s)] 1 := by
        filter_upwards [Besicovitch.ae_tendsto_rnDeriv (μ.restrict (ball c s))
            (ρ.restrict (ball c s)), ae_restrict_mem measurableSet_ball,
            ae_restrict_of_ae hratio] with w hw hwW hwr
        obtain ⟨ε, hε, hεW⟩ := Metric.isOpen_iff.mp isOpen_ball w hwW
        have heq : (fun t : ℝ => μ (closedBall w t) / ρ (closedBall w t)) =ᶠ[𝓝[>] 0]
            (fun t : ℝ => μ.restrict (ball c s) (closedBall w t) /
              ρ.restrict (ball c s) (closedBall w t)) := by
          filter_upwards [Ioo_mem_nhdsGT hε] with t ht
          have hsub : closedBall w t ⊆ ball c s := (closedBall_subset_ball ht.2).trans hεW
          rw [Measure.restrict_apply measurableSet_closedBall,
            Measure.restrict_apply measurableSet_closedBall, inter_eq_left.mpr hsub]
        exact tendsto_nhds_unique hw (hwr.congr' heq)
      calc μ.restrict (ball c s)
          = (ρ.restrict (ball c s)).withDensity
              ((μ.restrict (ball c s)).rnDeriv (ρ.restrict (ball c s))) :=
            by
              have h := Measure.singularPart_add_rnDeriv (μ.restrict (ball c s)) (ρ.restrict (ball c s))
              rw [Measure.singularPart_eq_zero_of_ac hacW, zero_add] at h
              exact h.symm
        _ = (ρ.restrict (ball c s)).withDensity 1 := withDensity_congr_ae hone
        _ = ρ.restrict (ball c s) := withDensity_one
    -- Step 2: countably many such balls cover `D`
    have hrad : ∀ x : D, ∃ ε : ℝ, 0 < ε ∧ closedBall (x : Euclid P) ε ⊆ D := by
      intro x
      obtain ⟨ε, hε, hεD⟩ := Metric.isOpen_iff.mp hD x x.2
      exact ⟨ε / 2, half_pos hε, (closedBall_subset_ball (half_lt_self hε)).trans hεD⟩
    choose ε hε hεD using hrad
    obtain ⟨T, hTc, hT⟩ := TopologicalSpace.isOpen_iUnion_countable
      (fun x : D => ball (x : Euclid P) (ε x)) (fun _ => isOpen_ball)
    have hcov : (⋃ x ∈ T, ball (x : Euclid P) (ε x)) = D := by
      rw [hT]
      apply subset_antisymm
      · exact iUnion_subset fun x => ball_subset_closedBall.trans (hεD x)
      · intro y hy
        exact mem_iUnion.mpr ⟨⟨y, hy⟩, mem_ball_self (hε ⟨y, hy⟩)⟩
    have hD' : μ.restrict D = ρ.restrict D := by
      rw [← hcov]
      exact (Measure.restrict_biUnion_congr hTc).mpr fun x _ => hlocal x (ε x) (hεD x)
    have hμae : ∀ᵐ x ∂μ, x ∈ D := by
      rw [ae_iff]
      exact hμD
    have hρae : ∀ᵐ x ∂ρ, x ∈ D := by
      rw [ae_iff]
      exact hρD
    rw [← Measure.restrict_eq_self_of_ae_mem hμae, ← Measure.restrict_eq_self_of_ae_mem hρae, hD']
  -- (step 7 tool) local copy of the accepted `setIntegral_blowUpMap_image_eq_inv_pow_mul`
  have hcov_gen : ∀ (P n : ℕ) (M : Set (Euclid P)) (x : Euclid P) (r : ℝ), 0 < r → ∀ f : Euclid P → ℝ, ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, f y ∂μHE[n] = r⁻¹ ^ n * ∫ y in M, f (Poincare.SimonGMT.Chapter03.blowUpMap x r y) ∂μHE[n] := by
    intro P n M x r hr f
    -- `η_{x,r} = (r⁻¹ • ·) ∘ (· - x)` is a homeomorphism
    obtain ⟨e, he⟩ : ∃ e : Euclid P ≃ₜ Euclid P,
        ⇑e = Poincare.SimonGMT.Chapter03.blowUpMap x r :=
      ⟨(Homeomorph.subRight x).trans (Homeomorph.smulOfNeZero r⁻¹ (inv_ne_zero hr.ne')), rfl⟩
    -- `Hⁿ(η_{x,r}(S)) = ‖r⁻¹‖₊ⁿ Hⁿ(S)` for every set `S`
    have hscale : ∀ S : Set (Euclid P), μHE[n] (e '' S) = ‖r⁻¹‖₊ ^ n • μHE[n] S := by
      intro S
      have hS : e '' S = (fun y => r⁻¹ • y) '' ((IsometryEquiv.subRight x) '' S) := by
        rw [image_image, he]
        rfl
      rw [hS, image_smul, Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hr.ne'),
        (IsometryEquiv.subRight x).isometry.euclideanHausdorffMeasure_image]
    -- `Hⁿ⌞η_{x,r}(M) = ‖r⁻¹‖₊ⁿ η_{x,r#}(Hⁿ⌞M)`, checked on Borel sets
    have hmeas : μHE[n].restrict (e '' M) = (‖r⁻¹‖₊ ^ n) • (μHE[n].restrict M).map e := by
      ext A hA
      rw [Measure.restrict_apply hA, Measure.smul_apply, Measure.map_apply e.measurable hA,
        Measure.restrict_apply (hA.preimage e.measurable), ← hscale, image_inter e.injective,
        e.image_preimage]
    -- change of variables, with `‖r⁻¹‖₊ⁿ = r⁻¹ ^ n`
    rw [← he, hmeas, integral_smul_nnreal_measure, e.measurableEmbedding.integral_map,
      NNReal.smul_def, smul_eq_mul, NNReal.coe_pow, coe_nnnorm, Real.norm_eq_abs,
      abs_of_pos (inv_pos.2 hr)]
  -- Step 1: the good set `G` of flat-tangent points, of full `μ`-measure
  set G : Set (Euclid (m + 1)) := {y | ∀ f : Euclid (m + 1) → ℝ, Continuous f →
    HasCompactSupport f → Tendsto (fun r : ℝ => (r ^ m)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) ∂μ)
      (𝓝[>] 0) (𝓝 (∫ z in ((Submodule.span ℝ {ν y})ᗮ : Set (Euclid (m + 1))), f z ∂μHE[m]))}
    with hGdef
  have hGc : μ Gᶜ = 0 := hflat
  -- Step 2: rectifiable carrier `B = (D ∩ R) \ N`
  obtain ⟨R, hRm, hRrect, hRc⟩ :=
    Submission.codim1_rdo_dg_rectifiable_of_flat_tangent m D μ ν hm hD hμD hμK hνm hν1 hflat
  set N : Set (Euclid (m + 1)) := toMeasurable μ Gᶜ with hNdef
  set B : Set (Euclid (m + 1)) := (D ∩ R) \ N with hBdef
  have hBm : MeasurableSet B :=
    (hD.measurableSet.inter hRm).diff (measurableSet_toMeasurable _ _)
  have hBD : B ⊆ D := fun y hy => hy.1.1
  have hBrect : CountablyRectifiable m B := hRrect.mono fun y hy => hy.1.2
  have hBG : ∀ y ∈ B, y ∈ G := by
    intro y hy
    by_contra h
    exact hy.2 (subset_toMeasurable μ Gᶜ h)
  have hN : μ N = 0 := by rw [hNdef, measure_toMeasurable]; exact hGc
  have hμBc : μ Bᶜ = 0 := by
    have hsub : Bᶜ ⊆ Dᶜ ∪ Rᶜ ∪ N := by
      intro y hy
      by_cases hyD : y ∈ D
      · by_cases hyR : y ∈ R
        · right
          by_contra hyN
          exact hy ⟨⟨hyD, hyR⟩, hyN⟩
        · left; right; exact hyR
      · left; left; exact hyD
    exact measure_mono_null hsub (measure_union_null (measure_union_null hμD hRc) hN)
  -- Step 1 (cont.): density one of `μ` at every point of `B`
  have hdens : ∀ y ∈ B, Tendsto (fun r : ℝ => μ (closedBall y r) /
      (unitBallVolume m * ENNReal.ofReal (r ^ m))) (𝓝[>] 0) (𝓝 1) := by
    intro y hy
    obtain ⟨ε, hε, hεD⟩ := Metric.isOpen_iff.mp hD y (hBD hy)
    have hfin : ∃ r₀ : ℝ, 0 < r₀ ∧ μ (closedBall y r₀) ≠ ∞ :=
      ⟨ε / 2, half_pos hε, hμK _ (isCompact_closedBall y (ε / 2))
        ((closedBall_subset_ball (half_lt_self hε)).trans hεD)⟩
    exact (Submission.codim1_rdo_dg_flat_tangent_density_cone m μ y (ν y) hm (hν1 y) hfin
      (hBG y hy)).1
  have hω0 : unitBallVolume m ≠ 0 := (measure_ball_pos _ _ zero_lt_one).ne'
  have hωtop : unitBallVolume m ≠ ∞ := measure_ball_lt_top.ne
  -- Step 3: local finiteness of `Hᵐ⌞B` by the density comparison
  have hω2top : unitBallVolume m / 2 ≠ ∞ := ENNReal.div_ne_top hωtop two_ne_zero
  set c : ℝ := (unitBallVolume m / 2).toReal with hcdef
  have hc : 0 < c := ENNReal.toReal_pos (ENNReal.div_ne_zero.mpr ⟨hω0, ENNReal.ofNat_ne_top⟩)
    hω2top
  obtain ⟨C, hCtop, hcmp⟩ := hcmp_gen (m + 1) m c hc
  have hlow : ∀ x ∈ B, ∃ t₀ : ℝ, 0 < t₀ ∧ ∀ t : ℝ, 0 < t → t < t₀ →
      ENNReal.ofReal (c * t ^ m) ≤ μ (closedBall x t) := by
    intro x hx
    have h := (hdens x hx).eventually (lt_mem_nhds (by norm_num : (2⁻¹ : ℝ≥0∞) < 1))
    obtain ⟨t₀, ht₀, hsub⟩ := (nhdsGT_basis (0 : ℝ)).mem_iff.mp h
    refine ⟨t₀, ht₀, fun t ht htt => ?_⟩
    have hq : 2⁻¹ < μ (closedBall x t) / (unitBallVolume m * ENNReal.ofReal (t ^ m)) :=
      hsub ⟨ht, htt⟩
    have hden0 : unitBallVolume m * ENNReal.ofReal (t ^ m) ≠ 0 :=
      mul_ne_zero hω0 (ENNReal.ofReal_pos.mpr (pow_pos ht m)).ne'
    have hdentop : unitBallVolume m * ENNReal.ofReal (t ^ m) ≠ ∞ :=
      ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top
    have hlt := (ENNReal.lt_div_iff_mul_lt (Or.inl hden0) (Or.inl hdentop)).mp hq
    calc ENNReal.ofReal (c * t ^ m) = unitBallVolume m / 2 * ENNReal.ofReal (t ^ m) := by
          rw [ENNReal.ofReal_mul hc.le, hcdef, ENNReal.ofReal_toReal hω2top]
      _ = 2⁻¹ * (unitBallVolume m * ENNReal.ofReal (t ^ m)) := by
          rw [ENNReal.div_eq_inv_mul, mul_assoc]
      _ ≤ μ (closedBall x t) := hlt.le
  have hloc : ∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μHE[m] (B ∩ K) ≠ ∞ := by
    intro K hK hKD
    obtain ⟨δ, hδ, hδD⟩ := hK.exists_cthickening_subset_open hD hKD
    have hle := hcmp μ (B ∩ K) (thickening δ K) isOpen_thickening
      (inter_subset_right.trans (self_subset_thickening hδ K)) (fun x hx => hlow x hx.1)
    exact ne_top_of_le_ne_top (ENNReal.mul_ne_top hCtop (hμK _ hK.cthickening hδD))
      (hle.trans (mul_le_mul' le_rfl (measure_mono (thickening_subset_cthickening δ K))))
  set ρ : Measure (Euclid (m + 1)) := μHE[m].restrict B with hρdef
  have hρDc : ρ Dᶜ = 0 := by
    rw [hρdef, Measure.restrict_apply hD.measurableSet.compl]
    have : Dᶜ ∩ B = ∅ := by
      ext y
      simp only [mem_inter_iff, mem_compl_iff, mem_empty_iff_false, iff_false, not_and]
      intro hyD hyB
      exact hyD (hBD hyB)
    rw [this, measure_empty]
  have hρK : ∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → ρ K ≠ ∞ := by
    intro K hK hKD
    rw [hρdef, Measure.restrict_apply' hBm, inter_comm]
    exact hloc K hK hKD
  -- Step 4: `μ ≪ Hᵐ⌞B`
  have hac : μ ≪ ρ := by
    intro A hA
    rw [hρdef, Measure.restrict_apply' hBm] at hA
    have h1 : μ (A ∩ B) = 0 :=
      hnull_gen (m + 1) m μ (A ∩ B)
        (fun x hx => hdens x hx.2) hA
    refine measure_mono_null (fun y hy => ?_) (measure_union_null h1 hμBc)
    by_cases hyB : y ∈ B
    · exact Or.inl ⟨hy, hyB⟩
    · exact Or.inr hyB
  -- Step 5: density one of `Hᵐ⌞B`
  have hρdens := hdens_gen (m + 1) m D B hD hBm
    hBD hBrect hloc hRD
  -- Step 6: ball ratios and identification
  have hratio : ∀ᵐ w ∂ρ, Tendsto (fun t : ℝ => μ (closedBall w t) / ρ (closedBall w t))
      (𝓝[>] 0) (𝓝 1) := by
    filter_upwards [hρdens, ae_restrict_mem hBm] with w hw hwB
    have h := ENNReal.Tendsto.div (hdens w hwB) (Or.inl one_ne_zero) hw
      (Or.inl ENNReal.one_ne_top)
    rw [ENNReal.div_self one_ne_zero ENNReal.one_ne_top] at h
    refine h.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with t ht
    have hc0 : unitBallVolume m * ENNReal.ofReal (t ^ m) ≠ 0 :=
      mul_ne_zero hω0 (ENNReal.ofReal_pos.mpr (pow_pos ht m)).ne'
    have hctop : unitBallVolume m * ENNReal.ofReal (t ^ m) ≠ ∞ :=
      ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top
    show μ (closedBall w t) / (unitBallVolume m * ENNReal.ofReal (t ^ m)) /
        (ρ (closedBall w t) / (unitBallVolume m * ENNReal.ofReal (t ^ m))) =
      μ (closedBall w t) / ρ (closedBall w t)
    conv_lhs => rw [div_eq_mul_inv (μ (closedBall w t)), div_eq_mul_inv (ρ (closedBall w t))]
    exact ENNReal.mul_div_mul_right _ _ (ENNReal.inv_ne_zero.mpr hctop)
      (ENNReal.inv_ne_top.mpr hc0)
  have hμeq : μ = μHE[m].restrict B :=
    heq_gen (m + 1) D μ ρ hD hμD hρDc hμK hρK hac hratio
  refine ⟨B, hBm, hBD, hBrect, hμeq, ?_⟩
  -- Step 7: approximate tangent planes by scaling
  filter_upwards [ae_restrict_mem hBm] with y hy
  have hν0 : ν y ≠ 0 := by
    intro h
    have := hν1 y
    rw [h, norm_zero] at this
    exact zero_ne_one this
  have hflaty : y ∈ G := hBG y hy
  simp only [hGdef, mem_ofPred_eq] at hflaty
  rw [hμeq] at hflaty
  refine ⟨?_, fun f => ?_⟩
  · have : Fact (Module.finrank ℝ (Euclid (m + 1)) = m + 1) := ⟨finrank_euclideanSpace_fin⟩
    exact Submodule.finrank_orthogonal_span_singleton hν0
  · refine (hflaty f f.continuous f.hasCompactSupport).congr' ?_
    filter_upwards [self_mem_nhdsWithin] with r hr
    rw [hcov_gen (m + 1) m B y r hr f, inv_pow]
    rfl
/-- Coefficient bound for a determinant covector (Simon 7.5, the test form of the chart
perimeter estimate).  If `α(a₁, …, aₙ) = det[p, Aa₁, …, Aaₙ]` with `‖A‖ ≤ 1` and `|p| ≤ 1`, then
every entry of the matrix `[p, Ae_{I(1)}, …, Ae_{I(n)}]` has absolute value `≤ 1`, so the Leibniz
formula gives `|α(e_I)| ≤ (n+1)!`; summing over the `Pⁿ` index tuples `I` yields
`|α| ≤ (Pⁿ ((n+1)!)²)^{1/2} = (n+1)! √(Pⁿ)`. -/
theorem Submission.codim1_lur_det_covector_norm_le : ∀ (P n : ℕ) (A : Euclid P →L[ℝ] Euclid (n + 1)) (p : Euclid (n + 1)) (α : Covector (Euclid P) n), ‖A‖ ≤ 1 → ‖p‖ ≤ 1 → (∀ a : Fin n → Euclid P, α a = Matrix.det (Matrix.of fun r c : Fin (n + 1) => (Fin.cons p (fun k : Fin n => A (a k)) : Fin (n + 1) → Euclid (n + 1)) c r)) → covectorEuclideanNorm α ≤ ((n + 1).factorial : ℝ) * Real.sqrt ((P : ℝ) ^ n) := by
  intro P n A p α hA hp hα
  -- Leibniz: a real `m × m` matrix with entries of absolute value `≤ 1` has `|det| ≤ m!`
  have hleib : ∀ (m : ℕ) (M : Matrix (Fin m) (Fin m) ℝ), (∀ r c, |M r c| ≤ 1) →
      |M.det| ≤ (m.factorial : ℝ) := by
    intro m M hM
    rw [Matrix.det_apply]
    calc |∑ σ : Equiv.Perm (Fin m), Equiv.Perm.sign σ • ∏ i, M (σ i) i|
        ≤ ∑ σ : Equiv.Perm (Fin m), |Equiv.Perm.sign σ • ∏ i, M (σ i) i| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _σ : Equiv.Perm (Fin m), (1 : ℝ) := by
          refine Finset.sum_le_sum fun σ _ => ?_
          rw [Units.smul_def, zsmul_eq_mul, abs_mul]
          have hs : |((Equiv.Perm.sign σ : ℤ) : ℝ)| = 1 := by
            rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h | h <;> simp [h]
          rw [hs, one_mul, Finset.abs_prod]
          exact Finset.prod_le_one₀ (fun i _ => abs_nonneg _) (fun i _ => hM _ _)
      _ = (m.factorial : ℝ) := by
          simp [Finset.card_univ, Fintype.card_perm]
  -- every coefficient `α(e_I) = det[p, Ae_{I(1)}, …, Ae_{I(n)}]` is bounded by `(n+1)!`
  have hcoef : ∀ I : Fin n → Fin P,
      |α (fun i => EuclideanSpace.basisFun (Fin P) ℝ (I i))| ≤ ((n + 1).factorial : ℝ) := by
    intro I
    rw [hα]
    apply hleib
    intro r c
    refine Fin.cases ?_ (fun k => ?_) c
    · simpa [Real.norm_eq_abs] using (PiLp.norm_apply_le p r).trans hp
    · simp only [Matrix.of_apply, Fin.cons_succ]
      have h1 := PiLp.norm_apply_le (A (EuclideanSpace.basisFun (Fin P) ℝ (I k))) r
      have h2 : ‖A (EuclideanSpace.basisFun (Fin P) ℝ (I k))‖ ≤ 1 := by
        calc ‖A (EuclideanSpace.basisFun (Fin P) ℝ (I k))‖
            ≤ ‖A‖ * ‖EuclideanSpace.basisFun (Fin P) ℝ (I k)‖ := A.le_opNorm _
          _ = ‖A‖ := by simp
          _ ≤ 1 := hA
      rw [← Real.norm_eq_abs]
      exact h1.trans h2
  -- sum the squared coefficients over the `Pⁿ` index tuples
  unfold covectorEuclideanNorm
  have hF : (0 : ℝ) ≤ ((n + 1).factorial : ℝ) := by positivity
  calc Real.sqrt (∑ I : Fin n → Fin P, if StrictMono I then
        (α (fun i => EuclideanSpace.basisFun (Fin P) ℝ (I i))) ^ 2 else 0)
      ≤ Real.sqrt (∑ _I : Fin n → Fin P, ((n + 1).factorial : ℝ) ^ 2) := by
        apply Real.sqrt_le_sqrt
        refine Finset.sum_le_sum fun I _ => ?_
        split_ifs
        · exact sq_le_sq' (abs_le.1 (hcoef I)).1 (abs_le.1 (hcoef I)).2
        · positivity
    _ = ((n + 1).factorial : ℝ) * Real.sqrt ((P : ℝ) ^ n) := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fun, Fintype.card_fin,
          Fintype.card_fin, nsmul_eq_mul, Real.sqrt_mul (by positivity), Real.sqrt_sq hF,
          mul_comm]
        push_cast
        ring
/-- Local finiteness of an integer multiplicity representation `(M, θ, ξ)` in `U` (Simon Ch. 6,
Definition 3.1).  For compact `K ⊆ U`, `μ_R(K) = ∫_{M ∩ K} θ dHⁿ < ∞` by the local integrability
of `θ`, and `Hⁿ(M ∩ K) = ∫_{M ∩ K} 1 dHⁿ ≤ ∫_{M ∩ K} θ dHⁿ < ∞` since `θ ≥ 1` on `M`. -/
theorem Submission.rsd_imrep_compact_measure_ne_top : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (K : Set (Euclid P)), IsCompact K → K ⊆ U → μHE[n] (R.carrier ∩ K) ≠ ∞ ∧ R.measure K ≠ ∞ := by
  intro P n U R K hK hKU
  have hint := R.locallyIntegrable_mult K hK hKU
  -- `μ_R(K) = ∫_K θ d(Hⁿ⌞M) = ∫_{M ∩ K} θ dHⁿ`, `K` being closed, hence Borel
  have hmeas : R.measure K = ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
    rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
      Measure.restrict_restrict hK.measurableSet, inter_comm]
  refine ⟨?_, by rw [hmeas]; exact hint⟩
  refine ne_top_of_le_ne_top hint ?_
  -- `Hⁿ(M ∩ K) = ∫_{M ∩ K} 1 dHⁿ ≤ ∫_{M ∩ K} θ dHⁿ`, as `1 ≤ θ` on `M`
  calc μHE[n] (R.carrier ∩ K) = ∫⁻ _ in R.carrier ∩ K, (1 : ℝ≥0∞) ∂μHE[n] := by
        rw [setLIntegral_one]
    _ ≤ ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
        refine setLIntegral_mono (measurable_from_nat.comp R.measurable_mult) ?_
        intro x hx
        exact_mod_cast R.mult_pos x hx.1
/-- **Simon 6.2.5** (evaluation bound by local mass): if `M_W(T) < ∞`, `spt ω ⊆ W` and
`|ω(x)| ≤ r` for every `x`, then `|T(ω)| ≤ r · M_W(T)`.  The Euclidean coefficient norm is
homogeneous, `|cα| = |c| |α|`, so for `s > 0` with `r ≤ s` both forms `±s⁻¹ω` are admissible for
`M_W(T)`; hence `|T(ω)| ≤ s · M_W(T)`, and `s ↓ r` gives the claim. -/
theorem Submission.cmr_abs_apply_le_massOn : ∀ (P n : ℕ) (U W : Set (Euclid P)) (T : GeometricCurrentOn U n) (ω : TestFormOn U n) (r : ℝ), T.massOn W ≠ ∞ → tsupport (ω : DifferentialForm (Euclid P) n) ⊆ W → (∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) x) ≤ r) → |T ω| ≤ r * (T.massOn W).toReal := by
  intro P n U W T ω r hM hW hr
  -- homogeneity of the Euclidean coefficient norm
  have hsmul : ∀ (c : ℝ) (α : Covector (Euclid P) n),
      covectorEuclideanNorm (c • α) = |c| * covectorEuclideanNorm α := by
    intro c α
    unfold covectorEuclideanNorm
    rw [← Real.sqrt_sq_eq_abs, ← Real.sqrt_mul (sq_nonneg c), Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl fun I _ => ?_
    split_ifs
    · rw [ContinuousAlternatingMap.smul_apply, smul_eq_mul, mul_pow]
    · rw [mul_zero]
  have hr0 : 0 ≤ r := (covectorEuclideanNorm_nonneg _).trans (hr 0)
  -- `|T(ω)| ≤ s M_W(T)` for `0 < s`, `r ≤ s`: every `c • ω` with `|c| ≤ s⁻¹` is admissible
  have hbound : ∀ s : ℝ, 0 < s → r ≤ s → |T ω| ≤ s * (T.massOn W).toReal := by
    intro s hs hrs
    have hadm : ∀ c : ℝ, |c| ≤ s⁻¹ → c * T ω ≤ (T.massOn W).toReal := by
      intro c hc
      have hmem : c • ω ∈ massAdmissibleOn U n W := by
        refine ⟨(tsupport_smul_subset_right (fun _ => c) _).trans hW, fun x => ?_⟩
        show covectorEuclideanNorm (c • (ω : DifferentialForm (Euclid P) n) x) ≤ 1
        rw [hsmul]
        calc |c| * covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) x) ≤ s⁻¹ * s :=
              mul_le_mul hc ((hr x).trans hrs) (covectorEuclideanNorm_nonneg _)
                (inv_nonneg.2 hs.le)
          _ = 1 := inv_mul_cancel₀ hs.ne'
      have h := (ENNReal.ofReal_le_iff_le_toReal hM).1 (T.le_massOn hmem)
      rwa [show T (c • ω) = c * T ω from T.toCurrent.map_smul c ω] at h
    have h1 := hadm s⁻¹ (abs_of_pos (inv_pos.2 hs)).le
    have h2 := hadm (-s⁻¹) (by rw [abs_neg, abs_of_pos (inv_pos.2 hs)])
    rw [neg_mul, ← mul_neg] at h2
    rw [abs_le]
    exact ⟨neg_le.1 ((inv_mul_le_iff₀ hs).1 h2), (inv_mul_le_iff₀ hs).1 h1⟩
  -- let `s ↓ r`
  have hlim : Tendsto (fun s : ℝ => s * (T.massOn W).toReal) (𝓝[>] r)
      (𝓝 (r * (T.massOn W).toReal)) :=
    ((continuous_mul_const _).tendsto r).mono_left nhdsWithin_le_nhds
  exact ge_of_tendsto hlim
    (eventually_nhdsWithin_of_forall fun s hs => hbound s (hr0.trans_lt hs) (le_of_lt hs))
/-- **Simon 7.5** (codimension one, oriented normal frame): for a unit vector `ν ∈ ℝ^{n+1}`,
`n ≥ 1`, some orthonormal basis `σ` of `ν^⊥` has `det[ν, σ] = −1`, where `[ν, σ]` is the matrix
with columns `ν, σ₀, …, σₙ₋₁`.  For an orthonormal basis `τ` of `ν^⊥`, `W = [ν, τ]` has
orthonormal columns, so `WᵀW = 1` and `d = det W` has `d² = 1`; `σ` replaces `τ₀` by `−d τ₀`,
which keeps the frame orthonormal with the same span and gives `det[ν, σ] = −d² = −1`. -/
theorem Submission.codim1_lur_no_oriented_normal_frame : ∀ (n : ℕ) (ν : Euclid (n + 1)), 1 ≤ n → ‖ν‖ = 1 → ∃ σ : Fin n → Euclid (n + 1), Orthonormal ℝ σ ∧ Submodule.span ℝ (Set.range σ) = (Submodule.span ℝ {ν})ᗮ ∧ Matrix.det (Matrix.of fun r c : Fin (n + 1) => (Fin.cons ν σ : Fin (n + 1) → Euclid (n + 1)) c r) = -1 := by
  intro n ν hn hν
  -- `Q = ν^⊥` has dimension `n`
  have hν0 : ν ≠ 0 := by
    rintro rfl
    simp at hν
  have : Fact (Module.finrank ℝ (Euclid (n + 1)) = n + 1) := ⟨finrank_euclideanSpace_fin⟩
  have hQn : Module.finrank ℝ (Submodule.span ℝ {ν})ᗮ = n :=
    Submodule.finrank_orthogonal_span_singleton hν0
  -- an orthonormal basis `τ` of `Q` indexed by `Fin n`: it spans `Q` and is orthogonal to `ν`
  let b : OrthonormalBasis (Fin n) ℝ (Submodule.span ℝ {ν})ᗮ :=
    (stdOrthonormalBasis ℝ (Submodule.span ℝ {ν})ᗮ).reindex (finCongr hQn)
  let τ : Fin n → Euclid (n + 1) := fun k => (b k : Euclid (n + 1))
  have hτo : Orthonormal ℝ τ :=
    b.orthonormal.comp_linearIsometry (Submodule.span ℝ {ν})ᗮ.subtypeₗᵢ
  have hτs : Submodule.span ℝ (Set.range τ) = (Submodule.span ℝ {ν})ᗮ := by
    have hr : Set.range τ = (Submodule.span ℝ {ν})ᗮ.subtype '' Set.range b := by
      rw [← Set.range_comp]
      rfl
    have hb : Submodule.span ℝ (Set.range b) = ⊤ := by
      rw [← b.coe_toBasis]
      exact b.toBasis.span_eq
    rw [hr, Submodule.span_image, hb, Submodule.map_top, Submodule.range_subtype]
  have hτν : ∀ k, inner ℝ ν (τ k) = 0 := fun k =>
    Submodule.mem_orthogonal_singleton_iff_inner_right.mp (b k).2
  -- `u = (ν, τ₀, …, τₙ₋₁)` is orthonormal
  let u : Fin (n + 1) → Euclid (n + 1) := Fin.cons ν τ
  have hu : Orthonormal ℝ u := by
    rw [orthonormal_iff_ite]
    intro i j
    induction i using Fin.cases with
    | zero =>
      induction j using Fin.cases with
      | zero => simp [u, hν]
      | succ j => simp [u, hτν, (Fin.succ_ne_zero j).symm]
    | succ i =>
      induction j using Fin.cases with
      | zero => simp [u, real_inner_comm, hτν, Fin.succ_ne_zero]
      | succ j => simp [u, (orthonormal_iff_ite.mp hτo) i j]
  -- `W = [ν, τ]` has `WᵀW = 1`, so `d = det W` satisfies `d * d = 1`
  let W : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ := Matrix.of fun r c => u c r
  have hWW : W.transpose * W = 1 := by
    ext c c'
    rw [Matrix.mul_apply, Matrix.one_apply, ← (orthonormal_iff_ite.mp hu) c c']
    simp [W, PiLp.inner_apply, mul_comm]
  set d := W.det with hd_def
  have hd : d * d = 1 := by
    calc d * d = (W.transpose * W).det := by rw [Matrix.det_mul, Matrix.det_transpose]
      _ = 1 := by rw [hWW, Matrix.det_one]
  -- `σ` replaces `τ i₀` by `(-d) • τ i₀` (`i₀ = 0`, as `n ≥ 1`)
  let i0 : Fin n := ⟨0, hn⟩
  let σ : Fin n → Euclid (n + 1) := Function.update τ i0 ((-d) • τ i0)
  have hσo : Orthonormal ℝ σ := by
    rw [orthonormal_iff_ite]
    intro i j
    have hτ := orthonormal_iff_ite.mp hτo
    by_cases hi : i = i0 <;> by_cases hj : j = i0
    · subst hi hj
      simp only [σ, Function.update_self, real_inner_smul_left, real_inner_smul_right, hτ,
        ↓reduceIte, mul_one]
      linear_combination hd
    · subst hi
      simp [σ, real_inner_smul_left, Function.update_of_ne hj, hτ, Ne.symm hj]
    · subst hj
      simp [σ, real_inner_smul_right, hτ, hi]
    · simp [σ, Function.update_of_ne hi, Function.update_of_ne hj, hτ]
  have hσs : Submodule.span ℝ (Set.range σ) = Submodule.span ℝ (Set.range τ) := by
    apply le_antisymm
    · rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      by_cases hi : i = i0
      · subst hi
        simp only [σ, Function.update_self]
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i0, rfl⟩)
      · simp only [σ, Function.update_of_ne hi]
        exact Submodule.subset_span ⟨i, rfl⟩
    · rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      by_cases hi : i = i0
      · subst hi
        have h : τ i0 = (-d) • σ i0 := by
          simp only [σ, Function.update_self, smul_smul, neg_mul_neg, hd, one_smul]
        rw [h]
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i0, rfl⟩)
      · have h : τ i = σ i := by simp only [σ, Function.update_of_ne hi]
        rw [h]
        exact Submodule.subset_span ⟨i, rfl⟩
  refine ⟨σ, hσo, hσs.trans hτs, ?_⟩
  -- `[ν, σ]` is `W` with column `i₀ + 1` multiplied by `-d`, so its determinant is `-d * d`
  have hM : (Matrix.of fun r c : Fin (n + 1) => (Fin.cons ν σ : Fin (n + 1) → Euclid (n + 1)) c r)
      = W.updateCol i0.succ ((-d) • fun r => W r i0.succ) := by
    ext r c
    simp only [σ, Fin.cons_update, Matrix.of_apply, Matrix.updateCol_apply, Function.update_apply,
      W, u]
    split_ifs with h
    · subst h
      simp
    · rfl
  rw [hM, Matrix.det_updateCol_smul, Matrix.updateCol_eq_self, ← hd_def, neg_mul, hd]
/-- **An `n`-covector on `ℝ^{n+1}` is a determinant with first column `φ_β`** (linear algebra
for the normal orientation of `T = ∂[[E]]`, Simon §7.5).  With `b_j = β(e ∘ j.succAbove)` and
`φ_β = ∑ⱼ (-1)ʲ b_j e_j`, `β a = det[φ_β, a]`, the matrix with columns `φ_β, a₀, …, a_{n-1}`.
Both sides are alternating in `a`, so it suffices to compare them on injective basis tuples
`e ∘ v` (`Module.Basis.ext_alternating`).  An injective `v` misses an index `m` and equals
`m.succAbove ∘ σ` for a permutation `σ`, so both sides acquire the factor `sign σ`.  At the
sorted tuple `e ∘ m.succAbove` only the column term `j = m` survives (for `j ≠ m`, `e_j` is
repeated), and `det[e_m, e ∘ m.succAbove] = sign (cycleRange m)⁻¹ = (-1)ᵐ`, so both sides equal
`(-1)ᵐ (-1)ᵐ b_m = b_m`. -/
theorem Submission.codim1_lur_no_covector_eq_det_cons : ∀ (n : ℕ) (β : Covector (Euclid (n + 1)) n) (a : Fin n → Euclid (n + 1)), β a = Matrix.det (Matrix.of fun r c : Fin (n + 1) => (Fin.cons (∑ j : Fin (n + 1), ((-1 : ℝ) ^ (j : ℕ) * β (fun k => EuclideanSpace.single (j.succAbove k) (1 : ℝ))) • EuclideanSpace.single j (1 : ℝ)) a : Fin (n + 1) → Euclid (n + 1)) c r) := by
  intro n β a
  -- the standard basis `e` of `ℝ^{n+1}`, `e j = EuclideanSpace.single j 1`
  set e : Module.Basis (Fin (n + 1)) ℝ (Euclid (n + 1)) :=
    (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis with he_def
  have he : ∀ j, e j = EuclideanSpace.single j (1 : ℝ) := fun j => by
    rw [he_def, OrthonormalBasis.coe_toBasis, EuclideanSpace.basisFun_apply]
  set φ : Euclid (n + 1) := ∑ j : Fin (n + 1), ((-1 : ℝ) ^ (j : ℕ) *
    β (fun k => EuclideanSpace.single (j.succAbove k) (1 : ℝ))) • EuclideanSpace.single j (1 : ℝ)
    with hφ
  -- Step 0: the matrix determinant is `e.det` of the column family `[φ, a]`
  have hdet : ∀ w : Fin (n + 1) → Euclid (n + 1),
      Matrix.det (Matrix.of fun r c : Fin (n + 1) => w c r) = e.det w := by
    intro w
    rw [Module.Basis.det_apply]
    congr 1
  rw [hdet]
  -- Step 1: both sides are alternating in `a`; compare `β` with `e.det.curryLeft φ`
  suffices hFG : β.toAlternatingMap = e.det.curryLeft φ from DFunLike.congr_fun hFG a
  refine Module.Basis.ext_alternating e fun v hv => ?_
  -- Step 2: an injective `v` misses some index `m`
  obtain ⟨m, hm⟩ : ∃ m : Fin (n + 1), ∀ l, v l ≠ m := by
    by_contra h
    have hs : Function.Surjective v := fun m => by
      by_contra hm
      exact h ⟨m, fun l hl => hm ⟨l, hl⟩⟩
    have := Fintype.card_le_of_surjective v hs
    simp at this
  -- `v = m.succAbove ∘ σ` for a permutation `σ` of `Fin n`
  choose ρ hρ using fun l => Fin.exists_succAbove_eq (hm l)
  have hρinj : Function.Injective ρ := fun l l' h => hv (by rw [← hρ l, ← hρ l', h])
  set σ : Equiv.Perm (Fin n) := Equiv.ofBijective ρ (Finite.injective_iff_bijective.mp hρinj)
  have hvσ : (fun i => e (v i)) = (fun k => e (m.succAbove k)) ∘ σ := by
    funext i
    simp [σ, hρ]
  -- both sides change by `sign σ`
  rw [hvσ, AlternatingMap.map_perm, AlternatingMap.map_perm]
  congr 1
  -- Step 3: the sorted tuple `e ∘ m.succAbove`; only the column term `j = m` survives
  have hcol : ∀ j : Fin (n + 1), e.det.curryLeft (e j) (fun k => e (m.succAbove k)) =
      if j = m then (-1 : ℝ) ^ (m : ℕ) else 0 := by
    intro j
    rw [AlternatingMap.curryLeft_apply_apply]
    split_ifs with hjm
    · subst hjm
      have hcyc : (Matrix.vecCons (e j) fun k => e (j.succAbove k)) = e ∘ ⇑j.cycleRange.symm := by
        funext i
        refine Fin.cases ?_ (fun k => ?_) i <;> simp
      rw [hcyc, AlternatingMap.map_perm, Module.Basis.det_self, Equiv.Perm.sign_symm,
        Fin.sign_cycleRange]
      simp [Units.smul_def]
    · obtain ⟨l, hl⟩ := Fin.exists_succAbove_eq hjm
      refine AlternatingMap.map_eq_zero_of_eq _ _ (i := 0) (j := l.succ) ?_ (Fin.succ_ne_zero l).symm
      simp [hl]
  have hφe : φ = ∑ j : Fin (n + 1), ((-1 : ℝ) ^ (j : ℕ) *
      β (fun k => EuclideanSpace.single (j.succAbove k) (1 : ℝ))) • e j := by
    simp only [hφ, he]
  -- evaluation at a tuple is additive
  have hsum : ∀ (g : Fin (n + 1) → Euclid (n + 1) [⋀^Fin n]→ₗ[ℝ] ℝ) (w : Fin n → Euclid (n + 1)),
      (∑ j, g j) w = ∑ j, g j w := fun g w =>
    map_sum (AddMonoidHom.mk' (fun f : Euclid (n + 1) [⋀^Fin n]→ₗ[ℝ] ℝ => f w) fun _ _ => rfl) g
      Finset.univ
  rw [hφe, map_sum, hsum]
  simp only [map_smul, AlternatingMap.smul_apply, hcol, smul_eq_mul, mul_ite, mul_zero,
    Finset.sum_ite_eq', Finset.mem_univ, ite_true]
  simp only [ContinuousAlternatingMap.coe_toAlternatingMap, he]
  rw [mul_comm, ← mul_assoc, ← pow_add, ← two_mul, pow_mul, neg_one_sq, one_pow, one_mul]
/-- **Normal decomposition of a column determinant** (the determinant step of the normal
orientation of a codimension-one current).  If `‖ν‖ = 1` and `σ₀, …, σₙ₋₁` span `ν^⊥`, then
`det[w, σ] = ⟨w, ν⟩ det[ν, σ]`.  The column determinant is the standard-basis determinant of
`(x, σ)`, linear in the first column `x`, and `w - ⟨w, ν⟩ν ∈ ν^⊥ = span σ`, so the columns
`(w - ⟨w, ν⟩ν, σ)` are linearly dependent and contribute `0`.  Orthonormality of `σ` is not
used. -/
theorem Submission.codim1_lur_no_det_cons_normal_decomp : ∀ (n : ℕ) (ν w : Euclid (n + 1)) (σ : Fin n → Euclid (n + 1)), ‖ν‖ = 1 → Submodule.span ℝ (Set.range σ) = (Submodule.span ℝ {ν})ᗮ → Matrix.det (Matrix.of fun r c : Fin (n + 1) => (Fin.cons w σ : Fin (n + 1) → Euclid (n + 1)) c r) = inner ℝ w ν * Matrix.det (Matrix.of fun r c : Fin (n + 1) => (Fin.cons ν σ : Fin (n + 1) → Euclid (n + 1)) c r) := by
  intro n ν w σ hν hspan
  -- `det[x, σ]` is the standard-basis determinant of the columns `(x, σ)`
  have hD : ∀ x : Euclid (n + 1), Matrix.det (Matrix.of fun r c : Fin (n + 1) =>
      (Fin.cons x σ : Fin (n + 1) → Euclid (n + 1)) c r) =
        (PiLp.basisFun 2 ℝ (Fin (n + 1))).det (Matrix.vecCons x σ) := fun _ => rfl
  -- `q = w - ⟨w, ν⟩ν` lies in `ν^⊥ = span σ`, so the columns `(q, σ)` are linearly dependent
  have hq : w - inner ℝ w ν • ν ∈ Submodule.span ℝ (Set.range σ) := by
    rw [hspan, Submodule.mem_orthogonal_singleton_iff_inner_right, inner_sub_right,
      real_inner_smul_right, real_inner_self_eq_norm_sq, hν, real_inner_comm w ν]
    ring
  have h0 : (PiLp.basisFun 2 ℝ (Fin (n + 1))).det (Matrix.vecCons (w - inner ℝ w ν • ν) σ) = 0 :=
    AlternatingMap.map_linearDependent _ _ fun h => (linearIndependent_finCons.mp h).2 hq
  -- linearity in the first column along `w = q + ⟨w, ν⟩ν`
  have hw : Matrix.vecCons w σ = Matrix.vecCons (w - inner ℝ w ν • ν + inner ℝ w ν • ν) σ := by
    rw [sub_add_cancel]
  rw [hD, hD, hw, AlternatingMap.map_vecCons_add, h0, zero_add, AlternatingMap.map_vecCons_smul,
    smul_eq_mul]

/-- **Orienting `∂[[E]]` by the unit normal** (Simon 7.5.2 (∗), the orientation computation of
the local unit representation).  For a unit vector `ν ∈ ℝ^{n+1}`, `n ≥ 1`, some orthonormal frame
`σ` of `ν^⊥` has `β(σ) = −⟨φ_β, ν⟩` for every `n`-covector `β`, where
`φ_β = Σⱼ (−1)ʲ β(e_{j.succAbove 0}, …, e_{j.succAbove (n−1)}) eⱼ`: take `σ` with
`det[ν, σ] = −1`; then `β(σ) = det[φ_β, σ] = ⟨φ_β, ν⟩ det[ν, σ]`. -/
theorem Submission.codim1_lur_normal_covector_orientation : ∀ (n : ℕ) (ν : Euclid (n + 1)), 1 ≤ n → ‖ν‖ = 1 → ∃ σ : Fin n → Euclid (n + 1), Orthonormal ℝ σ ∧ Submodule.span ℝ (Set.range σ) = (Submodule.span ℝ {ν})ᗮ ∧ ∀ β : Covector (Euclid (n + 1)) n, β σ = -∑ j : Fin (n + 1), (-1 : ℝ) ^ (j : ℕ) * β (fun k => EuclideanSpace.single (j.succAbove k) (1 : ℝ)) * inner ℝ (EuclideanSpace.single j (1 : ℝ)) ν := by
  intro n ν hn hν
  obtain ⟨σ, hσ, hspan, hdet⟩ := Submission.codim1_lur_no_oriented_normal_frame n ν hn hν
  refine ⟨σ, hσ, hspan, fun β => ?_⟩
  -- `β(σ) = det[φ_β, σ] = ⟨φ_β, ν⟩ det[ν, σ] = −⟨φ_β, ν⟩`, then expand `⟨φ_β, ν⟩` linearly
  rw [Submission.codim1_lur_no_covector_eq_det_cons n β σ,
    Submission.codim1_lur_no_det_cons_normal_decomp n ν _ σ hν hspan, hdet, sum_inner]
  simp only [real_inner_smul_left]
  ring
/-- Step 4(d) of the local unit representation of `∂[[E]]` (Simon 7.5; Gram–Schmidt as in the
graph chart): if `a₁, …, aₙ` are linearly independent in `ℝᴾ`, the Gram determinant
`Γ = det(⟨aᵢ, aⱼ⟩)` is positive and `ξ = Γ^{-1/2} a₁ ∧ ⋯ ∧ aₙ`, i.e.
`⟨α, ξ⟩ = Γ^{-1/2} α(a₁, …, aₙ)`, is a unit orientation of `span a`.  For an orthonormal frame
`σ` of `span a` and `R = (⟨σᵢ, aⱼ⟩)`, `Γ = (det R)²` and `α(a) = det R · α(σ)`, so
`ξ = sign(det R) σ₁ ∧ ⋯ ∧ σₙ`. -/
theorem Submission.codim1_lur_normalized_wedge_orientation : ∀ (P n : ℕ) (a : Fin n → Euclid P), LinearIndependent ℝ a → 0 < Matrix.det (Matrix.of fun i j : Fin n => inner ℝ (a i) (a j)) ∧ ∀ ξ : MultiVector P n, (∀ α : Covector (Euclid P) n, ξ α = (Real.sqrt (Matrix.det (Matrix.of fun i j : Fin n => inner ℝ (a i) (a j))))⁻¹ * α a) → IsUnitOrientationOf ξ (Submodule.span ℝ (Set.range a)) := by
  intro P n a ha
  -- an orthonormal frame `σ` of `span a` with `Γ = (det R)²`, `R = (⟨σᵢ, aⱼ⟩)` invertible
  obtain ⟨σ, hσ, hspan, hgram, hdet, -⟩ :=
    Submission.dpf_exists_orthonormal_frame_det_gram P n a ha
  set d := Matrix.det (Matrix.of fun i j => inner ℝ (σ i) (a j))
  refine ⟨hgram ▸ sq_pos_of_ne_zero hdet, fun ξ hξ => ⟨σ, hσ, hspan, ?_⟩⟩
  -- `α(a) = det R · α(σ)`, hence `⟨α, ξ⟩ = |det R|⁻¹ det R · α(σ)`
  have hξ' : ∀ α : Covector (Euclid P) n, ξ α = |d|⁻¹ * d * α σ := fun α => by
    rw [hξ, hgram, Real.sqrt_sq_eq_abs, mul_assoc,
      Submission.dgoj_covector_eq_det_mul_of_mem_span P n σ a hσ
        (fun j => hspan ▸ Submodule.subset_span ⟨j, rfl⟩) α]
  rcases hdet.lt_or_gt with hneg | hpos
  · exact Or.inr fun α => by
      rw [hξ', abs_of_neg hneg, inv_neg, neg_mul, inv_mul_cancel₀ hdet, neg_one_mul]
  · exact Or.inl fun α => by
      rw [hξ', abs_of_pos hpos, inv_mul_cancel₀ hdet, one_mul]
/-- **Simon Ch. 3, 1.4 for one bi-Lipschitz Lipschitz piece** (the blow-up argument of the proof
of 1.6 '⇒'): let `F : ℝⁿ → ℝᴾ` be `L`-Lipschitz, `B ⊆ ℝⁿ` Borel and `m > 0` with
`m|a − a'| ≤ |F a − F a'|` on `B`, and let `F` be differentiable at every point of `B` with
injective derivative.  Then for a.e. `b ∈ B`, `range DF(b)` is the approximate tangent space of
`F(B)` at `F b`.
`F` is injective on `B`, so the area formula holds on `B` with a Borel Jacobian `0 ≤ J ≤ Lⁿ`
satisfying `Hⁿ(DF(a)(S)) = J(a) λ(S)`.  At every Lebesgue point `b ∈ B` of `1_B J`,
`∫_{η_{F b,r}(F(B))} f dHⁿ = ∫ 1_B J(b + rc) f(r⁻¹(F(b + rc) − F b)) dc` tends to
`J(b) ∫ f(DF(b)c) dc = ∫_{range DF(b)} f dHⁿ` as `r ↓ 0`. -/
theorem Submission.codim1_lur_piece_image_approxTangent_ae : ∀ (P n : ℕ) (F : Euclid n → Euclid P) (B : Set (Euclid n)) (L : NNReal) (m : ℝ), LipschitzWith L F → MeasurableSet B → 0 < m → (∀ a ∈ B, ∀ a' ∈ B, m * ‖a - a'‖ ≤ ‖F a - F a'‖) → (∀ a ∈ B, DifferentiableAt ℝ F a ∧ Injective (fderiv ℝ F a)) → ∀ᵐ b ∂(volume.restrict B), HasApproximateTangentSpaceAt n (F '' B) (F b) (LinearMap.range (fderiv ℝ F b : Euclid n →ₗ[ℝ] Euclid P)) := by
  intro P n F B L m hF hB hm hcolip hreg
  -- 0(a): `F` is injective on `B` (`F a = F a'` forces `m|a − a'| ≤ 0`)
  have hinjOn : InjOn F B := by
    intro a ha a' ha' hFa
    have h := hcolip a ha a' ha'
    rw [hFa, sub_self, norm_zero] at h
    have h' : ‖a - a'‖ ≤ 0 := by
      by_contra hcon
      have := mul_pos hm (not_le.1 hcon)
      linarith
    exact sub_eq_zero.1 (norm_le_zero_iff.1 h')
  -- 0(b)–(c): Borel Jacobian `0 ≤ J ≤ Lⁿ`, area formula on `B`, `Hⁿ(DF(a)(S)) = J(a) λ(S)`
  obtain ⟨J, hJmeas, hJ, harea, hJlin⟩ :=
    Submission.codim1_lurpt_piece_area_jacobian P n F B L hF hB hinjOn
  -- 1: `1_B J` is Borel and bounded by `Lⁿ`, hence locally integrable
  have hloc : LocallyIntegrable (B.indicator J) volume := by
    refine (locallyIntegrable_const ((L : ℝ) ^ n)).mono (hJmeas.indicator hB).aestronglyMeasurable
      (Eventually.of_forall fun a => ?_)
    have hLn : (0 : ℝ) ≤ (L : ℝ) ^ n := by positivity
    calc ‖B.indicator J a‖ ≤ ‖J a‖ := norm_indicator_le_norm_self J a
      _ = J a := Real.norm_of_nonneg (hJ a).1
      _ ≤ (L : ℝ) ^ n := (hJ a).2
      _ = ‖(L : ℝ) ^ n‖ := (Real.norm_of_nonneg hLn).symm
  -- a.e. `b ∈ B` is a Lebesgue point of `1_B J`, in the rescaled form
  filter_upwards [ae_restrict_mem hB,
    ae_restrict_of_ae (Submission.doraggt_ae_rescaled_lebesgue_point n _ hloc)] with b hbB hleb
  obtain ⟨hdb, hinj⟩ := hreg b hbB
  have hJb : B.indicator J b = J b := Set.indicator_of_mem hbB J
  refine ⟨?_, fun f => ?_⟩
  · -- `dim range DF(b) = n`, `DF(b)` being injective
    rw [LinearMap.finrank_range_of_inj (f := (fderiv ℝ F b : Euclid n →ₗ[ℝ] Euclid P)) hinj,
      finrank_euclideanSpace_fin]
  · -- 6: `∫_{range DF(b)} f dHⁿ = J(b) ∫ f(DF(b)c) dc`
    rw [Submission.pit_setIntegral_range_linear P n (fderiv ℝ F b) (J b) f (hJ b).1 (hJlin b)
      (map_continuous f)]
    -- 2–5: the rescaled integrals tend to `J(b) ∫ f(DF(b)c) dc`
    refine (Submission.codim1_lurpt_rescaled_integral_tendsto P n F B J ((L : ℝ) ^ n) m b f
      hF.continuous hB hJmeas hJ hm (fun a ha => hcolip a ha b hbB) hdb hinj
      (fun R hR => by simpa only [hJb] using hleb R hR) (map_continuous f)
      f.hasCompactSupport).congr' ?_
    -- 3: for `r > 0` they are the integrals over the blow-ups `η_{F b,r}(F(B))`
    filter_upwards [self_mem_nhdsWithin] with r (hr : 0 < r)
    exact (Submission.pit_blowUp_image_setIntegral_eq_rescaled P n F B J b r f hF.continuous hB
      hJmeas (fun a => (hJ a).1) harea hr (map_continuous f)).symm

/-- A `d`-dimensional `C²` submanifold `N ⊆ ℝ^{d+k}` is, near `x ∈ N`, a `C¹` graph over its
tangent directions (Simon Ch. 2, §4, (4.1)): if `ℝ^{d+k} = ι(ℝᵈ) ⊕ ι'(ℝᵏ)` orthogonally and
`TₓN ⊆ ι(ℝᵈ)`, then `N ∩ B_s(x) ⊆ {x + ιv + ι'u(v) : v ∈ O} ⊆ N` with `u(0) = 0`, `Du(0) = 0`.
With `A = ι*`, `A' = ι'*` (so `y = ιAy + ι'A'y`) and a chart `ψ : V → W` with `ψ(z₀) = x`, the
map `Φ = A(ψ - x)` has `DΦ(z₀) = A Dψ(z₀)` injective since `Dψ(z₀)(ℝᵈ) ⊆ TₓN ⊆ ι(ℝᵈ)`; a local
inverse `χ : O → V₀` of `Φ` gives `u = A'(ψ ∘ χ - x)`, and `s` comes from the continuity of `ψ⁻¹`
at `x`. -/
theorem Submission.codim1_zsl_gc_local_graph : ∀ (d k : ℕ) (N : Set (Euclid (d + k))) (x : Euclid (d + k)) (ι : Euclid d →ₗᵢ[ℝ] Euclid (d + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (d + k)), IsEmbeddedSubmanifold 2 d N → x ∈ N → (∀ v w, inner ℝ (ι v) (ι' w) = 0) → (∀ y : Euclid (d + k), ∃ v w, y = ι v + ι' w) → tangentSpace N x ⊆ Set.range ι → ∃ (O : Set (Euclid d)) (u : Euclid d → Euclid k) (s : ℝ), IsOpen O ∧ (0 : Euclid d) ∈ O ∧ 0 < s ∧ ContDiffOn ℝ 1 u O ∧ u 0 = 0 ∧ fderiv ℝ u 0 = 0 ∧ (∀ v ∈ O, x + ι v + ι' (u v) ∈ N) ∧ ∀ y ∈ N, dist y x < s → ∃ v ∈ O, y = x + ι v + ι' (u v) := by
  intro d k N x ι ι' hN hx horth hdecomp htan
  -- Step 0: left inverses of `ι`, `ι'` (the adjoints)
  obtain ⟨A, hAι, hAι'⟩ : ∃ A : Euclid (d + k) →L[ℝ] Euclid d,
      (∀ v, A (ι v) = v) ∧ (∀ w, A (ι' w) = 0) := by
    refine ⟨ContinuousLinearMap.adjoint ι.toContinuousLinearMap, fun v => ?_, fun w => ?_⟩
    · refine ext_inner_right ℝ fun v' => ?_
      rw [ContinuousLinearMap.adjoint_inner_left, LinearIsometry.coe_toContinuousLinearMap,
        LinearIsometry.inner_map_map]
    · refine ext_inner_right ℝ fun v' => ?_
      rw [ContinuousLinearMap.adjoint_inner_left, LinearIsometry.coe_toContinuousLinearMap,
        inner_zero_left, real_inner_comm]
      exact horth v' w
  obtain ⟨A', hA'ι, hA'ι'⟩ : ∃ A' : Euclid (d + k) →L[ℝ] Euclid k,
      (∀ v, A' (ι v) = 0) ∧ (∀ w, A' (ι' w) = w) := by
    refine ⟨ContinuousLinearMap.adjoint ι'.toContinuousLinearMap, fun v => ?_, fun w => ?_⟩
    · refine ext_inner_right ℝ fun w' => ?_
      rw [ContinuousLinearMap.adjoint_inner_left, LinearIsometry.coe_toContinuousLinearMap,
        inner_zero_left]
      exact horth v w'
    · refine ext_inner_right ℝ fun w' => ?_
      rw [ContinuousLinearMap.adjoint_inner_left, LinearIsometry.coe_toContinuousLinearMap,
        LinearIsometry.inner_map_map]
  have hdec : ∀ y, y = ι (A y) + ι' (A' y) := by
    intro y
    obtain ⟨v, w, rfl⟩ := hdecomp y
    simp only [map_add, hAι, hAι', hA'ι, hA'ι', add_zero, zero_add]
  -- Step 1: a chart at `x`
  obtain ⟨V, W, ψ, hVo, hWo, hxW, hψ, hinj, himg, hprop, hfinj⟩ := hN x hx
  obtain ⟨z₀, hz₀V, hψz₀⟩ : x ∈ ψ '' V := by rw [himg]; exact ⟨hxW, hx⟩
  have hψN : ψ '' V ⊆ N := by rw [himg]; exact inter_subset_right
  -- Step 2: the range of `Dψ(z₀)` lies in `range ι`
  have hrange : Set.range (fderiv ℝ ψ z₀) ⊆ Set.range ι := by
    have h := Submission.dsmc_chart_range_subset_tangentSpace (d + k) 2 d N V ψ (by norm_num)
      hVo hψ hψN z₀ hz₀V
    rw [hψz₀] at h
    exact h.trans htan
  -- Step 3: `Φ z = A (ψ z - x)` has injective derivative at `z₀`
  have hψ1 : ContDiffOn ℝ 1 ψ V := hψ.of_le (by norm_num)
  have hψdiff : ∀ z ∈ V, DifferentiableAt ℝ ψ z := fun z hz =>
    (hψ1.differentiableOn_one z hz).differentiableAt (hVo.mem_nhds hz)
  have hΦC : ContDiffOn ℝ 1 (fun z => A (ψ z - x)) V :=
    A.contDiff.comp_contDiffOn (hψ1.sub contDiffOn_const)
  have hΦd : HasFDerivAt (fun z => A (ψ z - x)) (A.comp (fderiv ℝ ψ z₀)) z₀ :=
    A.hasFDerivAt.comp z₀ ((hψdiff z₀ hz₀V).hasFDerivAt.sub_const x)
  have hΦinj : Injective (fderiv ℝ (fun z => A (ψ z - x)) z₀) := by
    rw [hΦd.fderiv, injective_iff_map_eq_zero]
    intro h hh
    obtain ⟨v, hv⟩ := hrange (Set.mem_range_self h)
    rw [ContinuousLinearMap.comp_apply, ← hv, hAι] at hh
    apply hfinj z₀ hz₀V
    rw [← hv, hh, map_zero, map_zero]
  -- Step 4: local inverse `χ` of `Φ`
  obtain ⟨V₀, O, χ, hV₀o, hOo, hz₀V₀, hV₀V, hχC, hχmaps, hΦχ, hχΦ⟩ :=
    Submission.codim1_zsl_gc_local_inverse d (fun z => A (ψ z - x)) V z₀ hVo hz₀V hΦC hΦinj
  have hΦχ' : ∀ a ∈ O, A (ψ (χ a) - x) = a := hΦχ
  have hχΦ' : ∀ z ∈ V₀, A (ψ z - x) ∈ O ∧ χ (A (ψ z - x)) = z := hχΦ
  have hΦz₀ : A (ψ z₀ - x) = 0 := by rw [hψz₀, sub_self, map_zero]
  have h0O : (0 : Euclid d) ∈ O := hΦz₀ ▸ (hχΦ' z₀ hz₀V₀).1
  have hχ0 : χ 0 = z₀ := hΦz₀ ▸ (hχΦ' z₀ hz₀V₀).2
  -- Step 5: the graph identity
  have hkey : ∀ v ∈ O, ψ (χ v) = x + ι v + ι' (A' (ψ (χ v) - x)) := by
    intro v hv
    have h1 := hdec (ψ (χ v) - x)
    rw [hΦχ' v hv] at h1
    rw [add_assoc, ← h1, add_sub_cancel]
  -- Step 6: the radius `s`
  obtain ⟨ε, hε, hεball⟩ := Metric.isOpen_iff.mp hV₀o z₀ hz₀V₀
  obtain ⟨r, hr, hrball⟩ := Metric.isOpen_iff.mp hWo x hxW
  obtain ⟨δ, hδ, hδprop⟩ := Submission.dsmc_chart_inverse_continuity (d + k) d V W ψ
    hψ1.continuousOn hinj (by rw [himg]; exact inter_subset_left) hprop z₀ hz₀V ε hε
  refine ⟨O, fun v => A' (ψ (χ v) - x), min δ r, hOo, h0O, lt_min hδ hr, ?_, ?_, ?_, ?_, ?_⟩
  · exact A'.contDiff.comp_contDiffOn
      ((hψ1.comp hχC (hχmaps.mono_right hV₀V)).sub contDiffOn_const)
  · show A' (ψ (χ 0) - x) = 0
    rw [hχ0, hψz₀, sub_self, map_zero]
  · have hχd : HasFDerivAt χ (fderiv ℝ χ 0) 0 :=
      ((hχC.differentiableOn_one 0 h0O).differentiableAt (hOo.mem_nhds h0O)).hasFDerivAt
    have hψd : HasFDerivAt ψ (fderiv ℝ ψ (χ 0)) (χ 0) :=
      (hψdiff (χ 0) (hχ0 ▸ hz₀V)).hasFDerivAt
    have hud : HasFDerivAt (fun v => A' (ψ (χ v) - x))
        (A'.comp ((fderiv ℝ ψ (χ 0)).comp (fderiv ℝ χ 0))) 0 :=
      A'.hasFDerivAt.comp 0 ((hψd.comp 0 hχd).sub_const x)
    rw [hud.fderiv]
    ext1 h
    obtain ⟨v, hv⟩ := hrange (Set.mem_range_self (fderiv ℝ χ 0 h))
    rw [ContinuousLinearMap.comp_apply, ContinuousLinearMap.comp_apply, hχ0, ← hv, hA'ι,
      zero_apply]
  · intro v hv
    show x + ι v + ι' (A' (ψ (χ v) - x)) ∈ N
    rw [← hkey v hv]
    exact hψN (mem_image_of_mem ψ (hV₀V (hχmaps hv)))
  · intro y hy hys
    have hyW : y ∈ W := hrball (mem_ball.mpr (lt_of_lt_of_le hys (min_le_right _ _)))
    obtain ⟨z, hzV, rfl⟩ : y ∈ ψ '' V := by rw [himg]; exact ⟨hyW, hy⟩
    have hzV₀ : z ∈ V₀ := hεball (mem_ball.mpr (hδprop z hzV
      (by rw [hψz₀]; exact lt_of_lt_of_le hys (min_le_left _ _))))
    refine ⟨A (ψ z - x), (hχΦ' z hzV₀).1, ?_⟩
    exact (congrArg ψ (hχΦ' z hzV₀).2).symm.trans (hkey _ (hχΦ' z hzV₀).1)
/-- Steps 9–10 of the oriented graph chart of an embedded `(n+1)`-submanifold used for the
zero-scale limits of Simon 7.5.3–7.5.5 (codimension-one regularity, 7.5.8).  Let `ι`, `ι'` be
linear isometries with orthogonal ranges and `Γ(v) = x + ιv + ι'u(v)`, `u` continuous at `0` with
`u(0) = 0`.  If `Γ(O) ⊆ N` for an open `O ∋ 0` and every point of `N ∩ B_s(x)` is some `Γ(v)`,
`v ∈ O`, then for `δ₂ = s/2` and a small `δ₁ > 0`: `B_{δ₁} ⊆ O`, `u(B_{δ₁}) ⊆ B_{δ₂}` and the part
of `N` in the cylinder `{x + ιv + ι'w : |v| < δ₁, |w| < δ₂}` is exactly `Γ(B_{δ₁})`.  The cylinder
lies in `B_s(x)`, and `ιa + ι'b = 0` forces `a = 0` (Pythagoras), so the `ι`-coordinate of a point
of `N` in the cylinder is that of a graph point. -/
theorem Submission.codim1_zsl_gc_graph_cylinder : ∀ (d k : ℕ) (N : Set (Euclid (d + k))) (x : Euclid (d + k)) (ι : Euclid d →ₗᵢ[ℝ] Euclid (d + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (d + k)) (O : Set (Euclid d)) (u : Euclid d → Euclid k) (s : ℝ), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → IsOpen O → (0 : Euclid d) ∈ O → ContinuousAt u 0 → u 0 = 0 → 0 < s → (∀ v ∈ O, x + ι v + ι' (u v) ∈ N) → (∀ y ∈ N, dist y x < s → ∃ v ∈ O, y = x + ι v + ι' (u v)) → ∃ δ₁ δ₂ : ℝ, 0 < δ₁ ∧ 0 < δ₂ ∧ ball (0 : Euclid d) δ₁ ⊆ O ∧ (∀ v ∈ ball (0 : Euclid d) δ₁, u v ∈ ball (0 : Euclid k) δ₂) ∧ N ∩ {y | ∃ v ∈ ball (0 : Euclid d) δ₁, ∃ w ∈ ball (0 : Euclid k) δ₂, y = x + ι v + ι' w} = (fun v => x + ι v + ι' (u v)) '' ball (0 : Euclid d) δ₁ := by
  intro d k N x ι ι' O u s horth hO h0O hu hu0 hs hN hfib
  -- `ι a + ι' b = 0` forces `a = 0` (Pythagoras)
  have hinj : ∀ a b, ι a + ι' b = 0 → a = 0 := by
    intro a b h
    have h1 := norm_add_sq_real (ι a) (ι' b)
    rw [h, horth, ι.norm_map, ι'.norm_map, norm_zero] at h1
    have h2 : ‖a‖ = 0 := by nlinarith [norm_nonneg a, sq_nonneg ‖b‖]
    exact norm_eq_zero.mp h2
  -- radii: `δ₂ = s / 2`, `δ₁ = min (min η ρ) (s / 2)`
  obtain ⟨η, hη, hηu⟩ := Metric.continuousAt_iff.mp hu (s / 2) (half_pos hs)
  obtain ⟨ρ, hρ, hρO⟩ := Metric.isOpen_iff.mp hO 0 h0O
  have hδ₁ : 0 < min (min η ρ) (s / 2) := lt_min (lt_min hη hρ) (half_pos hs)
  have hballO : ball (0 : Euclid d) (min (min η ρ) (s / 2)) ⊆ O :=
    (ball_subset_ball ((min_le_left _ _).trans (min_le_right _ _))).trans hρO
  have hball2 : ∀ v ∈ ball (0 : Euclid d) (min (min η ρ) (s / 2)),
      u v ∈ ball (0 : Euclid k) (s / 2) := by
    intro v hv
    have hv' : dist v 0 < η :=
      lt_of_lt_of_le (mem_ball.mp hv) ((min_le_left _ _).trans (min_le_left _ _))
    have h := hηu hv'
    rw [hu0] at h
    exact mem_ball.mpr h
  refine ⟨min (min η ρ) (s / 2), s / 2, hδ₁, half_pos hs, hballO, hball2, ?_⟩
  ext y
  constructor
  · -- `N ∩ Z ⊆ Γ(B_{δ₁})`: a point of the cylinder lies in `B_s(x)`
    rintro ⟨hyN, v', hv', w', hw', rfl⟩
    have hv's : ‖v'‖ < s / 2 :=
      lt_of_lt_of_le (mem_ball_zero_iff.mp hv') (min_le_right _ _)
    have hw's : ‖w'‖ < s / 2 := mem_ball_zero_iff.mp hw'
    have hdist : dist (x + ι v' + ι' w') x < s := by
      rw [dist_eq_norm, add_assoc, add_sub_cancel_left]
      calc ‖ι v' + ι' w'‖ ≤ ‖ι v'‖ + ‖ι' w'‖ := norm_add_le _ _
        _ = ‖v'‖ + ‖w'‖ := by rw [ι.norm_map, ι'.norm_map]
        _ < s / 2 + s / 2 := add_lt_add hv's hw's
        _ = s := add_halves s
    obtain ⟨v, -, hv⟩ := hfib _ hyN hdist
    have hv2 : ι v' + ι' w' = ι v + ι' (u v) := by
      rw [add_assoc, add_assoc] at hv
      exact add_left_cancel hv
    have h3 : ι (v' - v) + ι' (w' - u v) = 0 := by
      rw [map_sub, map_sub, sub_add_sub_comm, hv2, sub_self]
    have hvv : v' = v := sub_eq_zero.mp (hinj _ _ h3)
    exact ⟨v, hvv ▸ hv', hv.symm⟩
  · -- `Γ(B_{δ₁}) ⊆ N ∩ Z`
    rintro ⟨v, hv, rfl⟩
    exact ⟨hN v (hballO hv), v, hv, u v, hball2 v hv, rfl⟩

/-- **The orientation of `N` along a `C¹` graph through `x` is the normalized Jacobian
orientation** (steps 11–15 of the oriented graph chart of `N` at `x` used for Simon 7.5.3–7.5.5;
tangent spaces as in Ch. 2, §4, orientations as in Ch. 6, 2.2).  Let `Γ(v) = x + ιv + ι'u(v)` on
`B = B_δ(0)`, with `u` of class `C¹`, `u(0) = 0`, `Du(0) = 0`, `Γ(B) ⊆ N` and
`ξ_N(x) = ιe₀ ∧ ⋯ ∧ ιeₙ`.  The Jacobian orientation `ξ` of the graph (with `ξ(β) = 1` on `Γ(B)`)
satisfies `α(DΓ(v)e) = J(v) ξ(Γ v)(α)`, `J = √det(DΓ* ∘ DΓ)`, and orients `range DΓ(v)`, which
lies in `T_{Γ(v)}N` and has the same dimension `n + 1`; so `ξ_N(Γ v) = ±ξ(Γ v)`.  The sign
`s(v) = ξ_N(Γ v)(β(Γ v)) = ±1` is continuous on the connected ball, and `s(0) = 1` since
`DΓ(0) = ι` and `J(0) = 1`; hence `ξ_N ∘ Γ = ξ ∘ Γ` on `B`. -/
theorem Submission.codim1_zsl_gc_orientation_along_graph : ∀ (n k : ℕ) (N : Set (Euclid (n + 1 + k))) (ξN : Euclid (n + 1 + k) → MultiVector (n + 1 + k) (n + 1)) (x : Euclid (n + 1 + k)) (ι : Euclid (n + 1) →ₗᵢ[ℝ] Euclid (n + 1 + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + 1 + k)) (u : Euclid (n + 1) → Euclid k) (δ : ℝ), IsOrientation (n + 1) N ξN → (∀ v w, inner ℝ (ι v) (ι' w) = 0) → 0 < δ → ContDiffOn ℝ 1 u (ball 0 δ) → u 0 = 0 → fderiv ℝ u 0 = 0 → (∀ v ∈ ball (0 : Euclid (n + 1)) δ, x + ι v + ι' (u v) ∈ N) → (∀ α : Covector (Euclid (n + 1 + k)) (n + 1), ξN x α = α (fun j => ι (EuclideanSpace.single j (1 : ℝ)))) → ∀ v ∈ ball (0 : Euclid (n + 1)) δ, ∀ α : Covector (Euclid (n + 1 + k)) (n + 1), α (fun j => fderiv ℝ (fun v => x + ι v + ι' (u v)) v (EuclideanSpace.single j (1 : ℝ))) = Real.sqrt (((fderiv ℝ (fun v => x + ι v + ι' (u v)) v).adjoint ∘L fderiv ℝ (fun v => x + ι v + ι' (u v)) v).det) * ξN (x + ι v + ι' (u v)) α := by
  intro n k N ξN x ι ι' u δ hor horth hδ hu hu0 hDu0 hΓN hξx
  -- the Jacobian orientation `ξ` of the graph `Γ(B)` and its dual covector field `β`
  obtain ⟨ξ, β, hξc, hβc, hξβ, hξor, hJ⟩ :=
    Submission.dgcr_graph_orientation_jacobian (n + 1) k ι ι' u x δ (Nat.succ_pos n) horth hδ hu
  have h0 : (0 : Euclid (n + 1)) ∈ ball (0 : Euclid (n + 1)) δ := mem_ball_self hδ
  -- `Γ` is `C¹` on the ball and maps it into `N`
  have hΓC1 : ContDiffOn ℝ 1 (fun v => x + ι v + ι' (u v)) (ball (0 : Euclid (n + 1)) δ) := by
    have h1 : ContDiffOn ℝ 1 (fun v : Euclid (n + 1) => x + ι v) (ball (0 : Euclid (n + 1)) δ) :=
      contDiffOn_const.add ι.contDiff.contDiffOn
    exact h1.add (ι'.contDiff.comp_contDiffOn hu)
  have hΓcont : ContinuousOn (fun v => x + ι v + ι' (u v)) (ball (0 : Euclid (n + 1)) δ) :=
    hΓC1.continuousOn
  have hΓmaps : MapsTo (fun v => x + ι v + ι' (u v)) (ball (0 : Euclid (n + 1)) δ) N :=
    fun v hv => hΓN v hv
  have hΓimg : (fun v => x + ι v + ι' (u v)) '' (ball (0 : Euclid (n + 1)) δ) ⊆ N :=
    hΓmaps.image_subset
  -- `range DΓ(v) ⊆ T_{Γ(v)}N`
  have hrange := Submission.dsmc_chart_range_subset_tangentSpace (n + 1 + k) 1 (n + 1) N
    (ball (0 : Euclid (n + 1)) δ) (fun v => x + ι v + ι' (u v)) le_rfl isOpen_ball
    (by exact_mod_cast hΓC1) hΓimg
  -- a subspace with a unit `(n + 1)`-orientation has dimension `n + 1`
  have hfin : ∀ (ζ : MultiVector (n + 1 + k) (n + 1)) (Q : Submodule ℝ (Euclid (n + 1 + k))),
      IsUnitOrientationOf ζ Q → Module.finrank ℝ Q = n + 1 := by
    rintro ζ Q ⟨τ, hτ, hspan, -⟩
    rw [← hspan, finrank_span_eq_card hτ.linearIndependent, Fintype.card_fin]
  -- pointwise, `range DΓ(v) = T_{Γ(v)}N` and so `ξ_N(Γ v) = ±ξ(Γ v)`
  have hsign : ∀ v ∈ ball (0 : Euclid (n + 1)) δ,
      ξN (x + ι v + ι' (u v)) = ξ (x + ι v + ι' (u v)) ∨
        ξN (x + ι v + ι' (u v)) = -ξ (x + ι v + ι' (u v)) := by
    intro v hv
    obtain ⟨Q, hQ, hξNQ⟩ := hor.2 _ (hΓN v hv)
    have hle : LinearMap.range (fderiv ℝ (fun v => x + ι v + ι' (u v)) v :
        Euclid (n + 1) →ₗ[ℝ] Euclid (n + 1 + k)) ≤ Q := by
      rintro y ⟨w, rfl⟩
      have hmem : (fderiv ℝ (fun v => x + ι v + ι' (u v)) v) w ∈
          tangentSpace N (x + ι v + ι' (u v)) := hrange v hv ⟨w, rfl⟩
      rw [← hQ] at hmem
      exact hmem
    have heq := Submodule.eq_of_le_of_finrank_eq hle
      (by rw [hfin _ _ (hξor v hv), hfin _ _ hξNQ])
    have hξQ : IsUnitOrientationOf (ξ (x + ι v + ι' (u v))) Q := heq ▸ hξor v hv
    exact Submission.rsdic_unitOrientation_eq_or_eq_neg _ _ _ _ Q hξQ hξNQ
  -- the sign `s(v) = ξ_N(Γ v)(β(Γ v))` is continuous on the ball and takes the values `±1`
  have hs_cont : ContinuousOn (fun v => ξN (x + ι v + ι' (u v)) (β (x + ι v + ι' (u v))))
      (ball (0 : Euclid (n + 1)) δ) := by
    have h1 : ContinuousOn (fun v => ξN (x + ι v + ι' (u v))) (ball (0 : Euclid (n + 1)) δ) :=
      hor.1.comp hΓcont hΓmaps
    have h2 : ContinuousOn (fun v => β (x + ι v + ι' (u v))) (ball (0 : Euclid (n + 1)) δ) :=
      hβc.comp hΓcont (mapsTo_image _ _)
    exact h1.clm_apply h2
  have hs_val : ∀ v ∈ ball (0 : Euclid (n + 1)) δ,
      ξN (x + ι v + ι' (u v)) (β (x + ι v + ι' (u v))) = 1 ∨
        ξN (x + ι v + ι' (u v)) (β (x + ι v + ι' (u v))) = -1 := by
    intro v hv
    have h1 : ξ (x + ι v + ι' (u v)) (β (x + ι v + ι' (u v))) = 1 := hξβ _ ⟨v, hv, rfl⟩
    rcases hsign v hv with h | h
    · left; rw [h, h1]
    · right; rw [h, neg_apply, h1]
  -- at `0`: `Γ(0) = x`, `DΓ(0) = ι`, `J(0) = 1`, so `ξ_N(x) = ξ(x)` and `s(0) = 1`
  have hΓ0 : x + ι 0 + ι' (u 0) = x := by simp [hu0]
  have hu_diff : DifferentiableAt ℝ u 0 :=
    (hu.differentiableOn one_ne_zero).differentiableAt (isOpen_ball.mem_nhds h0)
  have hD0 : fderiv ℝ (fun v => x + ι v + ι' (u v)) 0 = ι.toContinuousLinearMap := by
    have h1 : HasFDerivAt (fun v : Euclid (n + 1) => x + ι v) ι.toContinuousLinearMap 0 :=
      ι.toContinuousLinearMap.hasFDerivAt.const_add x
    have h2 : HasFDerivAt (fun v => ι' (u v)) (ι'.toContinuousLinearMap.comp (fderiv ℝ u 0)) 0 :=
      ι'.toContinuousLinearMap.hasFDerivAt.comp 0 hu_diff.hasFDerivAt
    rw [hDu0, ContinuousLinearMap.comp_zero] at h2
    have h3 := h1.add h2
    rw [add_zero] at h3
    exact h3.fderiv
  have hdet0 : Real.sqrt (((fderiv ℝ (fun v => x + ι v + ι' (u v)) 0).adjoint ∘L
      fderiv ℝ (fun v => x + ι v + ι' (u v)) 0).det) = 1 := by
    rw [hD0, LinearIsometry.adjoint_comp_self]
    show Real.sqrt (LinearMap.det ((1 : Euclid (n + 1) →L[ℝ] Euclid (n + 1)) :
      Euclid (n + 1) →ₗ[ℝ] Euclid (n + 1))) = 1
    rw [ContinuousLinearMap.toLinearMap_one, map_one, Real.sqrt_one]
  have hξ0 : ξN x = ξ x := by
    ext α
    have h1 := hJ 0 h0 α
    rw [hdet0, one_mul, hΓ0, hD0] at h1
    rw [hξx α, ← h1]
    rfl
  have hs0 : ξN (x + ι 0 + ι' (u 0)) (β (x + ι 0 + ι' (u 0))) = 1 := by
    have h1 := hξβ (x + ι 0 + ι' (u 0)) ⟨0, h0, rfl⟩
    rw [hΓ0] at h1 ⊢
    rw [hξ0]
    exact h1
  -- `s ≡ 1` on the preconnected ball, by the intermediate value theorem
  have hconst : ∀ v ∈ ball (0 : Euclid (n + 1)) δ,
      ξN (x + ι v + ι' (u v)) (β (x + ι v + ι' (u v))) = 1 := by
    intro v hv
    rcases hs_val v hv with h | h
    · exact h
    · exfalso
      have hIcc := (convex_ball (0 : Euclid (n + 1)) δ).isPreconnected.intermediate_value hv h0
        hs_cont
      have hmem : (0 : ℝ) ∈ Icc (ξN (x + ι v + ι' (u v)) (β (x + ι v + ι' (u v))))
          (ξN (x + ι 0 + ι' (u 0)) (β (x + ι 0 + ι' (u 0)))) := by
        rw [h, hs0]
        constructor <;> norm_num
      obtain ⟨w, hw, hw0⟩ := hIcc hmem
      have hw0' : ξN (x + ι w + ι' (u w)) (β (x + ι w + ι' (u w))) = 0 := hw0
      rcases hs_val w hw with h' | h' <;> rw [h'] at hw0' <;> norm_num at hw0'
  -- hence `ξ_N(Γ v) = ξ(Γ v)`, and the Jacobian identity of `ξ` is the claim
  intro v hv α
  have hpos : ξN (x + ι v + ι' (u v)) = ξ (x + ι v + ι' (u v)) := by
    rcases hsign v hv with h | h
    · exact h
    · exfalso
      have h1 := hconst v hv
      have h2 : ξ (x + ι v + ι' (u v)) (β (x + ι v + ι' (u v))) = 1 := hξβ _ ⟨v, hv, rfl⟩
      rw [h, neg_apply, h2] at h1
      norm_num at h1
  rw [hpos]
  exact hJ v hv α

/-- Step 4 of the zero-scale limit plane argument (Simon 7.5.3–7.5.5; embedded submanifolds and
tangent spaces: Ch. 2, §4 (4.1); orientations: Ch. 6, 2.2): near `x ∈ N`, an oriented embedded `C²`
`(n+1)`-submanifold `N ⊆ ℝ^{n+1+k}` is an oriented `C¹` graph over its tangent plane.
`IsOrientation` gives `T_xN = Q₀` with `ξ_N(x)` a unit orientation of `Q₀`; isometries `ι` onto
`Q₀`, adapted to `ξ_N(x)`, and `ι'` orthogonal to it give (a) and (d).  As `T_xN ⊆ range ι`, `N`
is near `x` the graph of `Γ(v) = x + ιv + ι'u(v)` with `u` of class `C¹`, `u(0) = 0`, `Du(0) = 0`;
inside a cylinder `{x + ιv + ι'w : |v| < δ₁, |w| < δ₂}` this gives (b) and (c).  Along `Γ`, `ξ_N`
is the Jacobian orientation `α ↦ α(DΓ(v)e₀, …, DΓ(v)eₙ)/√det(DΓ(v)*DΓ(v))`, which is (e). -/
theorem Submission.codim1_zsl_oriented_graph_chart : ∀ (n k : ℕ) (N : Set (Euclid (n + 1 + k))) (ξN : Euclid (n + 1 + k) → MultiVector (n + 1 + k) (n + 1)) (x : Euclid (n + 1 + k)), IsEmbeddedSubmanifold 2 (n + 1) N → IsOrientation (n + 1) N ξN → x ∈ N → ∃ (ι : Euclid (n + 1) →ₗᵢ[ℝ] Euclid (n + 1 + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + 1 + k)) (u : Euclid (n + 1) → Euclid k) (δ₁ δ₂ : ℝ), (∀ v w, inner ℝ (ι v) (ι' w) = 0) ∧ (∀ y : Euclid (n + 1 + k), ∃ v w, y = ι v + ι' w) ∧ 0 < δ₁ ∧ 0 < δ₂ ∧ ContDiffOn ℝ 1 u (ball 0 δ₁) ∧ u 0 = 0 ∧ fderiv ℝ u 0 = 0 ∧ (∀ v ∈ ball (0 : Euclid (n + 1)) δ₁, u v ∈ ball (0 : Euclid k) δ₂) ∧ N ∩ {y | ∃ v ∈ ball (0 : Euclid (n + 1)) δ₁, ∃ w ∈ ball (0 : Euclid k) δ₂, y = x + ι v + ι' w} = (fun v => x + ι v + ι' (u v)) '' ball (0 : Euclid (n + 1)) δ₁ ∧ (∀ α : Covector (Euclid (n + 1 + k)) (n + 1), ξN x α = α (fun j => ι (EuclideanSpace.single j (1 : ℝ)))) ∧ ∀ v ∈ ball (0 : Euclid (n + 1)) δ₁, ∀ α : Covector (Euclid (n + 1 + k)) (n + 1), α (fun j => fderiv ℝ (fun v => x + ι v + ι' (u v)) v (EuclideanSpace.single j (1 : ℝ))) = Real.sqrt (((fderiv ℝ (fun v => x + ι v + ι' (u v)) v).adjoint ∘L fderiv ℝ (fun v => x + ι v + ι' (u v)) v).det) * ξN (x + ι v + ι' (u v)) α := by
  intro n k N ξN x hN hξN hx
  -- `T_xN = Q₀`, and `ξ_N(x)` is a unit orientation of `Q₀`
  obtain ⟨Q₀, hQ₀, hξx⟩ := hξN.2 x hx
  -- (a), (d): `ι` maps onto `Q₀` and is adapted to `ξ_N(x)`; `ι'` is orthogonal to `ι`
  obtain ⟨ι, ι', hperp, hspan, hrange, hframe⟩ :=
    Submission.codim1_zsl_gc_oriented_frame n k Q₀ (ξN x) hξx
  -- near `x`, `N` is the graph of `Γ(v) = x + ιv + ι'u(v)` over an open `O ∋ 0`
  obtain ⟨O, u, s, hO, hO0, hs, hu, hu0, hDu0, hΓN, hcover⟩ :=
    Submission.codim1_zsl_gc_local_graph (n + 1) k N x ι ι' hN hx hperp hspan
      (hQ₀.symm.trans hrange.symm).subset
  -- (b), (c): inside the cylinder `{x + ιv + ι'w : |v| < δ₁, |w| < δ₂}`, `N` is `Γ(B_{δ₁})`
  obtain ⟨δ₁, δ₂, hδ₁, hδ₂, hO₁, hmaps, hcyl⟩ :=
    Submission.codim1_zsl_gc_graph_cylinder (n + 1) k N x ι ι' O u s hperp hO hO0
      (hu.continuousOn.continuousAt (hO.mem_nhds hO0)) hu0 hs hΓN hcover
  have hu₁ : ContDiffOn ℝ 1 u (ball 0 δ₁) := hu.mono hO₁
  -- (e): along `Γ`, `ξ_N` is the Jacobian orientation normalized by `√det(DΓ*DΓ)`
  exact ⟨ι, ι', u, δ₁, δ₂, hperp, hspan, hδ₁, hδ₂, hu₁, hu0, hDu0, hmaps, hcyl, hframe,
    Submission.codim1_zsl_gc_orientation_along_graph n k N ξN x ι ι' u δ₁ hξN hperp hδ₁ hu₁ hu0
      hDu0 (fun v hv => hΓN v (hO₁ hv)) hframe⟩
/-- **Area formula for a `C¹` graph over an `m`-plane** (Simon Ch. 2, 3.1–3.3).  Let
`G(w) = ιw + ι'g(w)` with `ι`, `ι'` isometries onto orthogonal subspaces and `g` of class `C¹` on
the open set `D ⊇ A`, and `J(w) = √det(DG(w)* ∘ DG(w))`.  Then
`∫_{G(A)} f dHᵐ = ∫_A J(w) f(G(w)) dw` for every `f`.  `G` is continuous on `A` and injective
(`ι(w - w') = ι'(g w' - g w)` is orthogonal to itself), `J` is Borel as a continuous function of
`fderiv ℝ G`, and `Hᵐ(G(B)) = ∫_B J` for every measurable `B ⊆ A` (`codim1_zsl_ga_set_identity`);
`codim1_zsl_ga_integral_transfer` turns this weighted set identity into the Bochner identity. -/
theorem Submission.codim1_zsl_graph_area_formula : ∀ (m k : ℕ) (ι : Euclid m →ₗᵢ[ℝ] Euclid (m + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (m + k)) (g : Euclid m → Euclid k) (D A : Set (Euclid m)) (f : Euclid (m + k) → ℝ), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → IsOpen D → ContDiffOn ℝ 1 g D → MeasurableSet A → A ⊆ D → ∫ y in (fun w => ι w + ι' (g w)) '' A, f y ∂μHE[m] = ∫ w in A, Real.sqrt (((fderiv ℝ (fun w => ι w + ι' (g w)) w).adjoint ∘L fderiv ℝ (fun w => ι w + ι' (g w)) w).det) * f (ι w + ι' (g w)) := by
  intro m k ι ι' g D A f horth hD hg hA hAD
  -- `G` is continuous on `A ⊆ D`, where `g` is `C¹`
  have hGc : ContinuousOn (fun w => ι w + ι' (g w)) A :=
    ι.continuous.continuousOn.add (ι'.continuous.comp_continuousOn (hg.continuousOn.mono hAD))
  -- `G` is injective: `ι (w - w') = ι' (g w' - g w)` is orthogonal to itself
  have hGi : Injective fun w => ι w + ι' (g w) := by
    intro w w' h
    have h1 : ι (w - w') = ι' (g w' - g w) := by
      rw [map_sub, map_sub, sub_eq_sub_iff_add_eq_add, add_comm (ι' (g w'))]
      exact h
    have h2 := horth (w - w') (g w' - g w)
    rw [← h1, inner_self_eq_zero] at h2
    exact sub_eq_zero.1 (ι.injective (h2.trans (map_zero ι).symm))
  -- `J = √det(DG* ∘ DG)` is Borel: a continuous function of the Borel map `fderiv ℝ G`
  have hJm : Measurable fun w => Real.sqrt (((fderiv ℝ (fun w => ι w + ι' (g w)) w).adjoint ∘L
      fderiv ℝ (fun w => ι w + ι' (g w)) w).det) := by
    have hc : Continuous fun T : Euclid m →L[ℝ] Euclid (m + k) =>
        Real.sqrt ((T.adjoint ∘L T).det) :=
      Real.continuous_sqrt.comp (ContinuousLinearMap.continuous_det.comp
        ((ContinuousLinearMap.adjoint (𝕜 := ℝ) (E := Euclid m)
          (F := Euclid (m + k))).continuous.clm_comp continuous_id))
    exact hc.measurable.comp (measurable_fderiv ℝ fun w => ι w + ι' (g w))
  -- `Hᵐ(G(B)) = ∫_B J` for measurable `B ⊆ A ⊆ D`; transfer to Bochner integrals
  exact Submission.codim1_zsl_ga_integral_transfer m (m + k) μHE[m] (fun w => ι w + ι' (g w))
    (fun w => Real.sqrt (((fderiv ℝ (fun w => ι w + ι' (g w)) w).adjoint ∘L
      fderiv ℝ (fun w => ι w + ι' (g w)) w).det)) A f hA hGc hGi.injOn hJm
    (fun w _ => Real.sqrt_nonneg _) fun B hB hBA =>
      Submission.codim1_zsl_ga_set_identity m k ι ι' g D B horth hD hg hB (hBA.trans hAD)
/-- **Compactness for sets of locally bounded perimeter** (Simon Ch. 2, 2.6, for the indicators
`uᵢ = 1_{Fᵢ}`).  If for each `R > 0` the perimeters of the `Fᵢ` in `B_R(0)` are eventually at most
`c(R)` (`∫_{Fᵢ} div φ ≤ c(R)` for smooth `φ` with `spt φ ⊆ B_R(0)` and `|φ| ≤ 1`), then a
subsequence converges in `L¹_loc`: `L^m((F_{σ i} Δ F') ∩ B_R(0)) → 0` for every `R`.
For `R > 0` and `i ≥ i_{R+2}`, `codim1_zsl_pc_translation_estimate` (steps 1–4: mollify, integrate
by parts, use the fundamental theorem of calculus, let `ε → 0`) turns the bound `c(R + 2)` into
`L^m(((Fᵢ − h) Δ Fᵢ) ∩ B_R(0)) ≤ c(R + 2)|h|` for `|h| ≤ 1`.  From this uniform local translation
estimate, `codim1_zsl_pc_compact_of_translation` (steps 5–8: cube averages, a diagonal
subsequence, a fast Cauchy subsequence and its `liminf` set) gives `σ` and `F'`. -/
theorem Submission.codim1_zsl_perimeter_compactness : ∀ (m : ℕ) (F : ℕ → Set (Euclid m)), (∀ i, MeasurableSet (F i)) → (∀ R : ℝ, 0 < R → ∃ c : ℝ, ∀ᶠ i in atTop, ∀ φ : Euclid m → Euclid m, ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ → tsupport φ ⊆ ball 0 R → (∀ v, ‖φ v‖ ≤ 1) → ∫ v in F i, LinearMap.trace ℝ (Euclid m) (fderiv ℝ φ v).toLinearMap ≤ c) → ∃ (σ : ℕ → ℕ) (F' : Set (Euclid m)), StrictMono σ ∧ MeasurableSet F' ∧ ∀ R : ℝ, Tendsto (fun i => volume (symmDiff (F (σ i)) F' ∩ ball 0 R)) atTop (𝓝 0) := by
  intro m F hF hP
  -- Steps 5–8: a uniform local translation estimate gives `σ` and `F'`.
  refine Submission.codim1_zsl_pc_compact_of_translation m F hF fun R hR => ?_
  -- Steps 1–4: for `i ≥ i_{R+2}`, the perimeter bound `c(R + 2)` gives the estimate with `C = c`.
  obtain ⟨c, hc⟩ := hP (R + 2) (by linarith)
  exact ⟨c, hc.mono fun i hi =>
    Submission.codim1_zsl_pc_translation_estimate m (F i) R c (hF i) hi⟩

/-- **Graph integrals under `C¹`-flattening graphs and `L¹_loc`-convergent domains** (Simon 7.5.3,
7.5.5).  For `G_i(w) = ιw + ι'gᵢ(w)` on `B = B_R(0)` with `gᵢ → b`, `Dgᵢ → 0` uniformly on `B` and
`Lᵐ((Aᵢ Δ A) ∩ B) → 0`, `∫_{Aᵢ∩B} β(Gᵢ)(DGᵢ e₀, …, DGᵢ e_{m−1}) → ∫_{A∩B} β(ιw + ι'b)(ιe₀, …)`.
`β` is bounded by `M` and uniformly continuous, and `DGᵢ(w) = ι + ι' ∘ Dgᵢ(w)`, so the multilinear
bounds `le_opNorm` and `norm_image_sub_le` give `|hᵢ − h| ≤ 2ᵐ|β(Gᵢ) − β(ιw + ι'b)| + Mm2ᵐ‖Dgᵢ‖`
for the integrands, which therefore converge uniformly on `B`; the integrals then differ by at most
`Lᵐ(B) sup_B |hᵢ − h| + 2M Lᵐ((Aᵢ Δ A) ∩ B) → 0`. -/
theorem Submission.codim1_zsl_fl_graph_integral_tendsto : ∀ (m k P : ℕ) (ι : Euclid m →ₗᵢ[ℝ] Euclid P) (ι' : Euclid k →ₗᵢ[ℝ] Euclid P) (b : Euclid k) (R : ℝ) (β : Euclid P → Covector (Euclid P) m) (gs : ℕ → Euclid m → Euclid k) (As : ℕ → Set (Euclid m)) (A : Set (Euclid m)), Continuous β → HasCompactSupport β → (∀ i, MeasurableSet (As i)) → MeasurableSet A → Tendsto (fun i => volume (symmDiff (As i) A ∩ ball (0 : Euclid m) R)) atTop (𝓝 0) → (∀ᶠ i in atTop, ∀ w ∈ ball (0 : Euclid m) R, DifferentiableAt ℝ (gs i) w) → (∀ ε : ℝ, 0 < ε → ∀ᶠ i in atTop, ∀ w ∈ ball (0 : Euclid m) R, ‖gs i w - b‖ < ε ∧ ‖fderiv ℝ (gs i) w‖ < ε) → Tendsto (fun i => ∫ w in As i ∩ ball 0 R, β (ι w + ι' (gs i w)) (fun j => fderiv ℝ (fun w => ι w + ι' (gs i w)) w (EuclideanSpace.single j (1 : ℝ)))) atTop (𝓝 (∫ w in A ∩ ball 0 R, β (ι w + ι' b) (fun j => ι (EuclideanSpace.single j (1 : ℝ))))) := by
  intro m k P ι ι' b R β gs As A hβc hβs hAs hA hsymm hH1 hH2
  classical
  set B : Set (Euclid m) := ball (0 : Euclid m) R with hB
  have hBmeas : MeasurableSet B := measurableSet_ball
  have hBfin : volume B < ⊤ := measure_ball_lt_top
  obtain ⟨M, hM⟩ := hβc.bounded_above_of_compact_support hβs
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  have hβu : UniformContinuous β := hβs.uniformContinuous_of_continuous hβc
  set e : Fin m → Euclid m := fun j => EuclideanSpace.single j (1 : ℝ) with he
  have hej : ∀ j, ‖e j‖ = 1 := by intro j; simp [he]
  set Φ : Euclid P × (Euclid m →L[ℝ] Euclid P) → ℝ := fun p => β p.1 (fun j => p.2 (e j)) with hΦ
  have hΦc : Continuous Φ := by
    have h1 : Continuous fun p : Euclid P × (Euclid m →L[ℝ] Euclid P) => β p.1 :=
      hβc.comp continuous_fst
    have h2 : Continuous fun p : Euclid P × (Euclid m →L[ℝ] Euclid P) => (fun j => p.2 (e j)) :=
      continuous_pi fun j => (continuous_eval_const (e j)).comp continuous_snd
    exact continuous_eval.comp (h1.prodMk h2)
  set G : ℕ → Euclid m → Euclid P := fun i w => ι w + ι' (gs i w) with hG
  set H : ℕ → Euclid m → ℝ := fun i w => Φ (G i w, fderiv ℝ (G i) w) with hH
  set H' : Euclid m → ℝ := fun w => β (ι w + ι' b) (fun j => ι (e j)) with hH'
  change Tendsto (fun i => ∫ w in As i ∩ B, H i w) atTop (𝓝 (∫ w in A ∩ B, H' w))
  have hD : ∀ i w, DifferentiableAt ℝ (gs i) w →
      fderiv ℝ (G i) w = ι.toContinuousLinearMap + ι'.toContinuousLinearMap.comp (fderiv ℝ (gs i) w) := by
    intro i w hw
    have hι : HasFDerivAt (fun w => ι w) ι.toContinuousLinearMap w :=
      ι.toContinuousLinearMap.hasFDerivAt
    have hι' : HasFDerivAt (fun w => ι' (gs i w))
        (ι'.toContinuousLinearMap.comp (fderiv ℝ (gs i) w)) w :=
      ι'.toContinuousLinearMap.hasFDerivAt.comp w hw.hasFDerivAt
    exact (hι.add hι').fderiv
  have hH'b : ∀ w, ‖H' w‖ ≤ M := by
    intro w
    calc ‖H' w‖ ≤ ‖β (ι w + ι' b)‖ * ∏ j, ‖ι (e j)‖ := ContinuousAlternatingMap.le_opNorm _ _
      _ = ‖β (ι w + ι' b)‖ := by simp [hej]
      _ ≤ M := hM _
  have hH'c : Continuous H' := by
    have h1 : Continuous fun w : Euclid m => β (ι w + ι' b) :=
      hβc.comp (ι.continuous.add continuous_const)
    exact (continuous_eval_const (fun j => ι (e j))).comp h1
  -- pointwise estimate
  have hpt : ∀ i w, DifferentiableAt ℝ (gs i) w → ‖fderiv ℝ (gs i) w‖ ≤ 1 →
      ‖H i w - H' w‖ ≤ 2 ^ m * ‖β (G i w) - β (ι w + ι' b)‖ +
        M * m * 2 ^ m * ‖fderiv ℝ (gs i) w‖ := by
    intro i w hd hL1
    set L := fderiv ℝ (gs i) w with hL
    set u : Fin m → Euclid P := fun j => fderiv ℝ (G i) w (e j) with hueq
    set u' : Fin m → Euclid P := fun j => ι (e j) with hu'eq
    have hu : ∀ j, u j = ι (e j) + ι' (L (e j)) := by
      intro j
      simp [u, hD i w hd, L]
    have hunorm : ‖u‖ ≤ 2 := by
      rw [pi_norm_le_iff_of_nonneg (by norm_num)]
      intro j
      rw [hu j]
      calc ‖ι (e j) + ι' (L (e j))‖ ≤ ‖ι (e j)‖ + ‖ι' (L (e j))‖ := norm_add_le _ _
        _ = 1 + ‖L (e j)‖ := by rw [LinearIsometry.norm_map, LinearIsometry.norm_map, hej]
        _ ≤ 1 + ‖L‖ * ‖e j‖ := by gcongr; exact L.le_opNorm _
        _ ≤ 2 := by rw [hej]; linarith
    have hu'norm : ‖u'‖ ≤ 1 := by
      rw [pi_norm_le_iff_of_nonneg zero_le_one]
      intro j
      simp [u', hej]
    have hdiff : ‖u - u'‖ ≤ ‖L‖ := by
      rw [pi_norm_le_iff_of_nonneg (norm_nonneg _)]
      intro j
      rw [Pi.sub_apply, hu j]
      simp only [u', add_sub_cancel_left, LinearIsometry.norm_map]
      calc ‖L (e j)‖ ≤ ‖L‖ * ‖e j‖ := L.le_opNorm _
        _ = ‖L‖ := by rw [hej, mul_one]
    have h1 : ‖β (G i w) u - β (ι w + ι' b) u‖ ≤ 2 ^ m * ‖β (G i w) - β (ι w + ι' b)‖ := by
      rw [← ContinuousAlternatingMap.sub_apply]
      calc _ ≤ ‖β (G i w) - β (ι w + ι' b)‖ * ∏ j, ‖u j‖ :=
            ContinuousAlternatingMap.le_opNorm _ _
        _ ≤ ‖β (G i w) - β (ι w + ι' b)‖ * 2 ^ m := by
          gcongr
          calc ∏ j, ‖u j‖ ≤ ∏ _j : Fin m, (2 : ℝ) :=
                Finset.prod_le_prod₀ (fun j _ => norm_nonneg _)
                  (fun j _ => (norm_le_pi_norm u j).trans hunorm)
            _ = 2 ^ m := by simp
        _ = _ := mul_comm _ _
    have h2 : ‖β (ι w + ι' b) u - β (ι w + ι' b) u'‖ ≤ M * m * 2 ^ m * ‖L‖ := by
      calc _ ≤ ‖β (ι w + ι' b)‖ * (Fintype.card (Fin m)) *
              (max ‖u‖ ‖u'‖) ^ (Fintype.card (Fin m) - 1) * ‖u - u'‖ :=
            ContinuousAlternatingMap.norm_image_sub_le _ _ _
        _ ≤ M * m * 2 ^ m * ‖L‖ := by
            rw [Fintype.card_fin]
            have hmax : max ‖u‖ ‖u'‖ ≤ 2 := max_le hunorm (hu'norm.trans (by norm_num))
            have hpow : (max ‖u‖ ‖u'‖) ^ (m - 1) ≤ 2 ^ m :=
              (pow_le_pow_left₀ (le_max_of_le_left (norm_nonneg _)) hmax _).trans
                (pow_le_pow_right₀ (by norm_num) (Nat.sub_le _ _))
            gcongr
            exact hM _
    have hsplit : H i w - H' w =
        (β (G i w) u - β (ι w + ι' b) u) + (β (ι w + ι' b) u - β (ι w + ι' b) u') := by
      simp only [H, H', Φ, u, u']
      ring
    rw [hsplit]
    exact (norm_add_le _ _).trans (add_le_add h1 h2)
  -- uniform convergence on B
  have hunif : ∀ ε > 0, ∀ᶠ i in atTop, ∀ w ∈ B, ‖H i w - H' w‖ ≤ ε := by
    intro ε hε
    obtain ⟨δ, hδ, hδβ⟩ := Metric.uniformContinuous_iff.1 hβu (ε / (2 * 2 ^ m)) (by positivity)
    set X : ℝ := M * m * 2 ^ m with hX
    have hX0 : 0 ≤ X := by positivity
    set η : ℝ := min 1 (ε / (2 * (X + 1))) with hη
    have hηpos : 0 < η := lt_min one_pos (by positivity)
    filter_upwards [hH1, hH2 δ hδ, hH2 η hηpos] with i hi1 hi2 hi3
    intro w hw
    have hd := hi1 w hw
    have hL1 : ‖fderiv ℝ (gs i) w‖ ≤ 1 := (hi3 w hw).2.le.trans (min_le_left _ _)
    have hLη : ‖fderiv ℝ (gs i) w‖ ≤ ε / (2 * (X + 1)) :=
      (hi3 w hw).2.le.trans (min_le_right _ _)
    have hβd : ‖β (G i w) - β (ι w + ι' b)‖ ≤ ε / (2 * 2 ^ m) := by
      rw [← dist_eq_norm]
      apply le_of_lt
      apply hδβ
      rw [dist_eq_norm]
      simp only [G]
      rw [add_sub_add_left_eq_sub, ← map_sub, LinearIsometry.norm_map]
      exact (hi2 w hw).1
    refine (hpt i w hd hL1).trans ?_
    have e1 : 2 ^ m * ‖β (G i w) - β (ι w + ι' b)‖ ≤ ε / 2 := by
      calc 2 ^ m * ‖β (G i w) - β (ι w + ι' b)‖ ≤ 2 ^ m * (ε / (2 * 2 ^ m)) := by gcongr
        _ = ε / 2 := by field_simp
    have e2 : X * ‖fderiv ℝ (gs i) w‖ ≤ ε / 2 := by
      calc X * ‖fderiv ℝ (gs i) w‖ ≤ X * (ε / (2 * (X + 1))) := by gcongr
        _ ≤ ε / 2 := by
          rw [mul_div_assoc', div_le_div_iff₀ (by positivity) (by positivity)]
          nlinarith
    linarith
  -- measurability
  have hHmeas : ∀ᶠ i in atTop, AEStronglyMeasurable (H i) (volume.restrict B) := by
    filter_upwards [hH1] with i hi
    have hGc : ContinuousOn (G i) B := fun w hw =>
      (ι.continuous.continuousAt.add
        (ι'.continuous.continuousAt.comp (hi w hw).continuousAt)).continuousWithinAt
    have h1 : AEStronglyMeasurable (G i) (volume.restrict B) := hGc.aestronglyMeasurable hBmeas
    have h2 : AEStronglyMeasurable (fderiv ℝ (G i)) (volume.restrict B) :=
      (measurable_fderiv ℝ (G i)).aestronglyMeasurable
    exact hΦc.comp_aestronglyMeasurable (h1.prodMk h2)
  -- the symmetric differences
  have hsymm' : Tendsto (fun i => (volume (symmDiff (As i) A ∩ B)).toReal) atTop (𝓝 0) := by
    have := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp hsymm
    simpa [Function.comp_def] using this
  set VB : ℝ := (volume B).toReal with hVB
  have hVB0 : 0 ≤ VB := ENNReal.toReal_nonneg
  rw [Metric.tendsto_nhds]
  intro ε hε
  filter_upwards [hunif (ε / (2 * (VB + 1))) (by positivity), hunif 1 one_pos, hHmeas,
    hsymm'.eventually (gt_mem_nhds (show (0 : ℝ) < ε / (4 * (M + 1)) by positivity))]
    with i hi1 hi1' hi2 hi3
  have hsB : As i ∩ B ⊆ B := inter_subset_right
  have hsfin : volume (As i ∩ B) < ⊤ := (measure_mono hsB).trans_lt hBfin
  have htfin : volume (A ∩ B) < ⊤ := (measure_mono inter_subset_right).trans_lt hBfin
  have hsmeas : MeasurableSet (As i ∩ B) := (hAs i).inter hBmeas
  have htmeas : MeasurableSet (A ∩ B) := hA.inter hBmeas
  have hHi_int : IntegrableOn (H i) (As i ∩ B) := by
    refine IntegrableOn.of_bound hsfin (hi2.mono_measure (Measure.restrict_mono hsB le_rfl)) (M + 1) ?_
    refine (ae_restrict_iff' hsmeas).2 (Eventually.of_forall fun w hw => ?_)
    have h := hi1' w hw.2
    calc ‖H i w‖ = ‖(H i w - H' w) + H' w‖ := by rw [sub_add_cancel]
      _ ≤ ‖H i w - H' w‖ + ‖H' w‖ := norm_add_le _ _
      _ ≤ 1 + M := add_le_add h (hH'b w)
      _ = M + 1 := add_comm _ _
  have hH'_int : ∀ s : Set (Euclid m), volume s < ⊤ → IntegrableOn H' s := fun s hs =>
    IntegrableOn.of_bound hs hH'c.aestronglyMeasurable M (Eventually.of_forall hH'b)
  -- first term
  have hT1 : ‖(∫ w in As i ∩ B, H i w) - ∫ w in As i ∩ B, H' w‖ ≤ ε / (2 * (VB + 1)) * VB := by
    rw [← integral_sub hHi_int (hH'_int _ hsfin)]
    refine (norm_setIntegral_le_of_norm_le_const hsfin fun w hw => hi1 w hw.2).trans ?_
    gcongr
    exact measureReal_mono hsB hBfin.ne
  -- second term
  have hT2 : ‖(∫ w in As i ∩ B, H' w) - ∫ w in A ∩ B, H' w‖ ≤
      2 * M * (volume (symmDiff (As i) A ∩ B)).toReal := by
    have e1 := integral_inter_add_sdiff htmeas (hH'_int _ hsfin)
    have e2 := integral_inter_add_sdiff hsmeas (hH'_int _ htfin)
    rw [inter_comm (A ∩ B)] at e2
    have hsub1 : (As i ∩ B) \ (A ∩ B) ⊆ symmDiff (As i) A ∩ B := by
      rintro w ⟨⟨hwA, hwB⟩, hw⟩
      exact ⟨Or.inl ⟨hwA, fun h => hw ⟨h, hwB⟩⟩, hwB⟩
    have hsub2 : (A ∩ B) \ (As i ∩ B) ⊆ symmDiff (As i) A ∩ B := by
      rintro w ⟨⟨hwA, hwB⟩, hw⟩
      exact ⟨Or.inr ⟨hwA, fun h => hw ⟨h, hwB⟩⟩, hwB⟩
    have hΔfin : volume (symmDiff (As i) A ∩ B) < ⊤ :=
      (measure_mono inter_subset_right).trans_lt hBfin
    have b1 : ‖∫ w in (As i ∩ B) \ (A ∩ B), H' w‖ ≤ M * (volume (symmDiff (As i) A ∩ B)).toReal := by
      refine (norm_setIntegral_le_of_norm_le_const ((measure_mono hsub1).trans_lt hΔfin)
        fun w _ => hH'b w).trans ?_
      gcongr
      exact measureReal_mono hsub1 hΔfin.ne
    have b2 : ‖∫ w in (A ∩ B) \ (As i ∩ B), H' w‖ ≤ M * (volume (symmDiff (As i) A ∩ B)).toReal := by
      refine (norm_setIntegral_le_of_norm_le_const ((measure_mono hsub2).trans_lt hΔfin)
        fun w _ => hH'b w).trans ?_
      gcongr
      exact measureReal_mono hsub2 hΔfin.ne
    have : (∫ w in As i ∩ B, H' w) - ∫ w in A ∩ B, H' w =
        (∫ w in (As i ∩ B) \ (A ∩ B), H' w) - ∫ w in (A ∩ B) \ (As i ∩ B), H' w := by
      linarith
    rw [this]
    calc _ ≤ ‖∫ w in (As i ∩ B) \ (A ∩ B), H' w‖ + ‖∫ w in (A ∩ B) \ (As i ∩ B), H' w‖ :=
          norm_sub_le _ _
      _ ≤ _ := by linarith
  rw [dist_eq_norm]
  have hsum : (∫ w in As i ∩ B, H i w) - ∫ w in A ∩ B, H' w =
      ((∫ w in As i ∩ B, H i w) - ∫ w in As i ∩ B, H' w) +
        ((∫ w in As i ∩ B, H' w) - ∫ w in A ∩ B, H' w) := by ring
  rw [hsum]
  have hlt1 : ε / (2 * (VB + 1)) * VB < ε / 2 := by
    rw [div_mul_eq_mul_div, div_lt_div_iff₀ (by positivity) (by positivity)]
    nlinarith
  have hlt2 : 2 * M * (volume (symmDiff (As i) A ∩ B)).toReal ≤ ε / 2 := by
    have h3 : (volume (symmDiff (As i) A ∩ B)).toReal < ε / (4 * (M + 1)) := hi3
    have h4 : 0 ≤ (volume (symmDiff (As i) A ∩ B)).toReal := ENNReal.toReal_nonneg
    calc 2 * M * (volume (symmDiff (As i) A ∩ B)).toReal
        ≤ 2 * (M + 1) * (volume (symmDiff (As i) A ∩ B)).toReal := by gcongr; linarith
      _ ≤ 2 * (M + 1) * (ε / (4 * (M + 1))) := by gcongr
      _ = ε / 2 := by field_simp; ring
  calc _ ≤ _ := norm_add_le _ _
    _ < ε := by linarith
/-- **Integrals over the image of a measurable set under an affine isometry `ℝᵐ → ℝᴾ`** (Simon
7.5.5 regards the limit set `F` as an `Hⁿ⁺¹`-measurable subset of the plane `TₓN` in this way).
`G(w) = ιw + c` is an isometry of the complete space `ℝᵐ`, hence a measurable embedding, so `G(A)`
is measurable.  `Hᵐ` is invariant under isometries and equals `Lᵐ` on `ℝᵐ`, so
`G_#Lᵐ = Hᵐ⌞G(ℝᵐ)` and, by injectivity, `Hᵐ⌞G(A) = G_#(Lᵐ⌞A)`; hence
`∫_{G(A)} f dHᵐ = ∫_A f(G(w)) dw` for every `f`. -/
theorem Submission.codim1_zsl_fl_isometry_image_setIntegral : ∀ (m P : ℕ) (ι : Euclid m →ₗᵢ[ℝ] Euclid P) (c : Euclid P) (A : Set (Euclid m)), MeasurableSet A → MeasurableSet ((fun w => ι w + c) '' A) ∧ ∀ f : Euclid P → ℝ, ∫ y in (fun w => ι w + c) '' A, f y ∂μHE[m] = ∫ w in A, f (ι w + c) := by
  intro m P ι c A hA
  -- `G` is an isometry of the complete space `ℝᵐ`, hence a measurable embedding.
  have hiso : Isometry (fun w => ι w + c) := by
    refine Isometry.of_dist_eq fun x y => ?_
    rw [dist_eq_norm, dist_eq_norm, add_sub_add_right_eq_sub, ← map_sub, LinearIsometry.norm_map]
  have hemb : MeasurableEmbedding (fun w => ι w + c) :=
    hiso.isClosedEmbedding.measurableEmbedding
  have hAimg : MeasurableSet ((fun w => ι w + c) '' A) := hemb.measurableSet_image' hA
  refine ⟨hAimg, fun f => ?_⟩
  -- `G_#Lᵐ = Hᵐ⌞G(ℝᵐ)`, hence `Hᵐ⌞G(A) = G_#(Lᵐ⌞A)`.
  have hmap : (volume : Measure (Euclid m)).map (fun w => ι w + c) =
      (μHE[m] : Measure (Euclid P)).restrict (range (fun w => ι w + c)) := by
    rw [← hiso.map_euclideanHausdorffMeasure, EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
  have hres : (μHE[m] : Measure (Euclid P)).restrict ((fun w => ι w + c) '' A) =
      ((volume : Measure (Euclid m)).restrict A).map (fun w => ι w + c) := by
    rw [← preimage_image_eq A hemb.injective, ← hemb.restrict_map, hmap,
      Measure.restrict_restrict hAimg, inter_eq_left.mpr (image_subset_range _ _),
      preimage_image_eq A hemb.injective]
  rw [hres, hemb.integral_map]

/-- Chapter 7 of Simon's *Introduction to GMT*: the headline results above. -/
theorem main_theorem : MinimizingImpliesStationary ∧ ExistenceOfMinimizingFilling ∧ CompactnessOfMinimizingCurrents ∧ DensityAndTangentCones ∧ IntegerDensityAndTangentPlanes ∧ RegularSetDense ∧ DensityOneImpliesRegular ∧ SingularSetSmallWhereDensityBelowTwo ∧ HalfSpaceConeLiesInBoundary ∧ CodimensionOneRegularity ∧ RegularComponentsAreMinimizing := by sorry

namespace Submission

/-- Mollification by an even `C¹` kernel `η` with compact support commutes with `D` and is
self-adjoint: `∫ D(η * u)(x)(s x) dx = −∫ u div(η * s)` for integrable `u`, `s` (Simon Ch. 2,
Lemma 2.5).  Both derivatives are convolutions with the odd, bounded `Dη`, and Fubini applies to
`Dη(x − z)(s x) u(z)`, which is dominated by `C ‖s x‖ |u z|`. -/
theorem codim1_rdo_dg_sp_mollifier_adjoint : ∀ (P : ℕ) (η u : Euclid P → ℝ) (s : Euclid P → Euclid P), ContDiff ℝ 1 η → HasCompactSupport η → (∀ z, η (-z) = η z) → Integrable u → Integrable s → ∫ x, fderiv ℝ (convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume) x (s x) = -∫ z, u z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ (convolution η s (ContinuousLinearMap.lsmul ℝ ℝ) volume) z : Euclid P →ₗ[ℝ] Euclid P) := by
  intro P η u s hη hηc heven hu hs
  -- Step 0: `Dη` is continuous with compact support, hence bounded by some `C`.
  have hDc : Continuous (fderiv ℝ η) := hη.continuous_fderiv one_ne_zero
  have hDcs : HasCompactSupport (fderiv ℝ η) := hηc.fderiv ℝ
  obtain ⟨C, hC⟩ := hDc.bounded_above_of_compact_support hDcs
  -- Step 1: `η` is even, so `Dη` is odd (chain rule for `η = η ∘ (−id)`).
  have hodd : ∀ y, fderiv ℝ η (-y) = -fderiv ℝ η y := by
    intro y
    have h1 : HasFDerivAt (η ∘ fun z => -z)
        ((fderiv ℝ η (-y)).comp (-ContinuousLinearMap.id ℝ (Euclid P))) y :=
      ((hη.differentiable one_ne_zero) (-y)).hasFDerivAt.comp y (hasFDerivAt_id y).neg
    rw [show (η ∘ fun z => -z) = η from funext heven] at h1
    ext v
    rw [h1.fderiv]
    simp
  -- Step 2: `D(η * u)(x) = (Dη * u)(x)`, so `D(η * u)(x)(s x) = ∫ Dη(x − z)(s x) u(z) dz`.
  have hLHS : ∀ x, fderiv ℝ (convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume) x (s x) =
      ∫ z, fderiv ℝ η (x - z) (s x) * u z := by
    intro x
    rw [(hηc.hasFDerivAt_convolution_left _ hη hu.locallyIntegrable x).fderiv, convolution_eq_swap,
      ContinuousLinearMap.integral_apply
        ((hDcs.convolutionExists_left _ hDc hu.locallyIntegrable x).integrable_swap)]
    simp
  -- Step 3: `div(η * s)(z) = trace D(η * s)(z) = ∫ Dη(z − x)(s x) dx`: the trace `T` is a
  -- continuous linear functional, and the trace of the rank-one map `v ↦ a(v) w` is `a(w)`.
  have hRHS : ∀ z, LinearMap.trace ℝ (Euclid P)
      (fderiv ℝ (convolution η s (ContinuousLinearMap.lsmul ℝ ℝ) volume) z :
        Euclid P →ₗ[ℝ] Euclid P) = ∫ x, fderiv ℝ η (z - x) (s x) := by
    let T : (Euclid P →L[ℝ] Euclid P) →L[ℝ] ℝ := LinearMap.toContinuousLinearMap
      (LinearMap.trace ℝ (Euclid P) ∘ₗ ContinuousLinearMap.coeLM ℝ)
    have hTA : ∀ A : Euclid P →L[ℝ] Euclid P,
        T A = LinearMap.trace ℝ (Euclid P) (A : Euclid P →ₗ[ℝ] Euclid P) := fun A => rfl
    have hrk : ∀ (a : Euclid P →L[ℝ] ℝ) (w : Euclid P), T (ContinuousLinearMap.precompL (Euclid P)
        (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] Euclid P →L[ℝ] Euclid P) a w) = a w := by
      intro a w
      have h : ((ContinuousLinearMap.precompL (Euclid P)
          (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] Euclid P →L[ℝ] Euclid P) a w :
            Euclid P →L[ℝ] Euclid P) : Euclid P →ₗ[ℝ] Euclid P) =
          (a : Euclid P →ₗ[ℝ] ℝ).smulRight w := by
        ext v
        simp
      rw [hTA, h, LinearMap.trace_smulRight]
      rfl
    intro z
    rw [(hηc.hasFDerivAt_convolution_left _ hη hs.locallyIntegrable z).fderiv, convolution_eq_swap]
    have hT := ContinuousLinearMap.integral_comp_comm T
      ((hDcs.convolutionExists_left (ContinuousLinearMap.precompL (Euclid P)
        (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] Euclid P →L[ℝ] Euclid P)) hDc
          hs.locallyIntegrable z).integrable_swap)
    simp_rw [hrk] at hT
    exact hT.symm
  -- Step 4: Fubini for `H(x, z) = Dη(x − z)(s x) u(z)`, dominated by `C ‖s x‖ |u z|`.
  have hint : Integrable (uncurry fun x z => fderiv ℝ η (x - z) (s x) * u z)
      ((volume : Measure (Euclid P)).prod volume) := by
    refine Integrable.mono' ((hs.norm.mul_prod hu.norm).const_mul C) ?_ (Eventually.of_forall ?_)
    · exact ((ContinuousLinearMap.apply ℝ ℝ).aestronglyMeasurable_comp₂
        hs.aestronglyMeasurable.comp_fst
        (hDc.comp (continuous_fst.sub continuous_snd)).aestronglyMeasurable).mul
        hu.aestronglyMeasurable.comp_snd
    · rintro ⟨x, z⟩
      simp only [uncurry_apply_pair, norm_mul]
      calc ‖fderiv ℝ η (x - z) (s x)‖ * ‖u z‖ ≤ (C * ‖s x‖) * ‖u z‖ := by
            gcongr
            exact ((fderiv ℝ η (x - z)).le_opNorm (s x)).trans (by gcongr; exact hC _)
        _ = C * (‖s x‖ * ‖u z‖) := by ring
  -- Step 5: combine, using `Dη(z − x) = −Dη(x − z)` to identify the swapped integral.
  calc ∫ x, fderiv ℝ (convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume) x (s x)
      = ∫ x, ∫ z, fderiv ℝ η (x - z) (s x) * u z := by simp_rw [hLHS]
    _ = ∫ z, ∫ x, fderiv ℝ η (x - z) (s x) * u z := integral_integral_swap hint
    _ = -∫ z, u z * LinearMap.trace ℝ (Euclid P)
          (fderiv ℝ (convolution η s (ContinuousLinearMap.lsmul ℝ ℝ) volume) z :
            Euclid P →ₗ[ℝ] Euclid P) := by
      rw [← integral_neg]
      congr 1
      funext z
      rw [hRHS z, ← integral_const_mul, ← integral_neg]
      congr 1
      funext x
      rw [← neg_sub x z, hodd, neg_apply]
      ring
/-- Mollification does not increase the variation (Simon Ch. 2, Lemma 2.5, formula (4)): if
`|∫ u div g| ≤ M` for every `g ∈ C¹_c(ℝᴾ; ℝᴾ)` with `|g| ≤ 1`, then `∫ |D(η * u)| ≤ M` for an even
mollifier `η ≥ 0` with `∫ η = 1`.  With `w = η * u`, the field `s = 1_{spt w} |∇w|⁻¹ ∇w`
(`0⁻¹ = 0`) is Borel, bounded by `1`, compactly supported and has `Dw(s) = |Dw|`;
`codim1_rdo_dg_sp_mollifier_adjoint` moves `η` onto `s`, and `g = η * s` is admissible. -/
theorem codim1_rdo_dg_sp_mollify_variation : ∀ (P : ℕ) (u : Euclid P → ℝ) (M : ℝ), Integrable u → HasCompactSupport u → (∀ g : Euclid P → Euclid P, ContDiff ℝ 1 g → HasCompactSupport g → (∀ z, ‖g z‖ ≤ 1) → |∫ z, u z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ g z : Euclid P →ₗ[ℝ] Euclid P)| ≤ M) → ∀ η : Euclid P → ℝ, ContDiff ℝ 1 η → HasCompactSupport η → (∀ z, 0 ≤ η z) → (∀ z, η (-z) = η z) → ∫ z, η z = 1 → ∫ z, ‖fderiv ℝ (convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume) z‖ ≤ M := by
  intro P u M hu huc hM η hη hηc hη0 heven hη1
  -- Step 1: `w = η * u` is `C¹` with compact support `S = spt w`.
  set w := convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume
  have hwc : HasCompactSupport w := hηc.convolution _ huc
  have hDw : Continuous (fderiv ℝ w) :=
    (hηc.contDiff_convolution_left _ hη hu.locallyIntegrable).continuous_fderiv one_ne_zero
  set S := tsupport w
  have hSm : MeasurableSet S := (isClosed_tsupport w).measurableSet
  -- Step 2: the gradient `∇w = (toDual)⁻¹ Dw` is continuous, `|∇w| = |Dw|`, `Dw(∇w) = |∇w|²`.
  set grad : Euclid P → Euclid P :=
    fun x => (InnerProductSpace.toDual ℝ (Euclid P)).symm (fderiv ℝ w x)
  have hgc : Continuous grad := (InnerProductSpace.toDual ℝ (Euclid P)).symm.continuous.comp hDw
  have hgn : ∀ x, ‖grad x‖ = ‖fderiv ℝ w x‖ := fun x => LinearIsometryEquiv.norm_map _ _
  have hgg : ∀ x, fderiv ℝ w x (grad x) = ‖grad x‖ ^ 2 := by
    intro x
    rw [← InnerProductSpace.toDual_symm_apply (𝕜 := ℝ) (x := grad x) (y := fderiv ℝ w x)]
    exact real_inner_self_eq_norm_sq _
  -- Step 3: the unit field `f = |∇w|⁻¹ ∇w` (`0⁻¹ = 0`) and `s = 1_S f`.
  set f : Euclid P → Euclid P := fun x => ‖grad x‖⁻¹ • grad x with hf
  have hfm : Measurable f := hgc.norm.measurable.inv.smul hgc.measurable
  have hf1 : ∀ x, ‖f x‖ ≤ 1 := by
    intro x
    simp only [hf, norm_smul, norm_inv, norm_norm]
    rcases eq_or_ne ‖grad x‖ 0 with h | h
    · simp [h]
    · rw [inv_mul_cancel₀ h]
  set s : Euclid P → Euclid P := S.indicator f with hs
  have hs1 : ∀ x, ‖s x‖ ≤ 1 := fun x => (norm_indicator_le_norm_self f x).trans (hf1 x)
  have hsc : HasCompactSupport s :=
    HasCompactSupport.intro hwc.isCompact fun x hx => indicator_of_notMem hx f
  have hsi : Integrable s := by
    rw [hs, integrable_indicator_iff hSm]
    exact Measure.integrableOn_of_bounded hwc.isCompact.measure_lt_top.ne
      hfm.aestronglyMeasurable (Eventually.of_forall hf1)
  -- Step 4: `Dw(x)(s x) = |Dw(x)|` for all `x`.
  have hDs : ∀ x, fderiv ℝ w x (s x) = ‖fderiv ℝ w x‖ := by
    intro x
    by_cases hx : x ∈ S
    · simp only [hs, indicator_of_mem hx, hf, map_smul, hgg, smul_eq_mul, ← hgn]
      rcases eq_or_ne ‖grad x‖ 0 with h | h
      · simp [h]
      · field_simp
    · rw [fderiv_of_notMem_tsupport ℝ hx]
      simp
  -- Step 5: `g = η * s` is admissible: `C¹`, compact support, `|g| ≤ ∫ η = 1`.
  set g := convolution η s (ContinuousLinearMap.lsmul ℝ ℝ) volume with hg
  have hgC1 : ContDiff ℝ 1 g := hηc.contDiff_convolution_left _ hη hsi.locallyIntegrable
  have hgcs : HasCompactSupport g := hηc.convolution _ hsc
  have hηi : Integrable η := hη.continuous.integrable_of_hasCompactSupport hηc
  have hg1 : ∀ z, ‖g z‖ ≤ 1 := by
    intro z
    rw [hg, convolution_def]
    refine (norm_integral_le_of_norm_le hηi (Eventually.of_forall fun t => ?_)).trans hη1.le
    rw [ContinuousLinearMap.lsmul_apply, norm_smul, Real.norm_of_nonneg (hη0 t)]
    exact mul_le_of_le_one_right (hη0 t) (hs1 _)
  -- Steps 6–7: the adjoint identity, then the hypothesis for `g`.
  calc ∫ z, ‖fderiv ℝ w z‖ = ∫ z, fderiv ℝ w z (s z) :=
        integral_congr_ae (Eventually.of_forall fun z => (hDs z).symm)
    _ = -∫ z, u z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ g z : Euclid P →ₗ[ℝ] Euclid P) :=
        Submission.codim1_rdo_dg_sp_mollifier_adjoint P η u s hη hηc heven hu hsi
    _ ≤ |∫ z, u z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ g z : Euclid P →ₗ[ℝ] Euclid P)| :=
        neg_le_abs _
    _ ≤ M := hM g hgC1 hgcs hg1

/-- **Sobolev inequality in the limit of symmetric mollifications** (Simon Ch. 3, proof of
Theorem 4.3 (De Giorgi), Sobolev step, chapter-03.txt lines 689–712, with the mollification
Lemma Ch. 2, 2.5, chapter-02.txt lines 543–596).  Assume the Sobolev inequality
`(∫ |w|^p)^{1/p} ≤ c ∫ |Dw|` for `C¹` compactly supported `w`, let `u` be integrable with compact
support and `|∫ u div g| ≤ M` for `C¹_c` fields `|g| ≤ 1`, and let `η_k` be even, nonnegative,
`C¹`, compactly supported with `∫ η_k = 1` and `η_k * u → u` a.e.  Then `(∫ |u|^p)^{1/p} ≤ c M`:
`g = 0` gives `M ≥ 0`; each `w_k = η_k * u` is `C¹` with compact support and
`∫ |Dw_k| ≤ M` (`codim1_rdo_dg_sp_mollify_variation`), so `∫⁻ ‖w_k‖ₑ^p ≤ (cM)^p` by the Sobolev
inequality; Fatou's lemma along `w_k → u` a.e. gives `∫⁻ ‖u‖ₑ^p ≤ (cM)^p`, and taking `toReal`
and the `1/p` power concludes. -/
theorem codim1_rdo_dg_sp_sobolev_limit : ∀ (P : ℕ) (p c : ℝ), 0 < p → 0 ≤ c → (∀ w : Euclid P → ℝ, ContDiff ℝ 1 w → HasCompactSupport w → (∫ z, |w z| ^ p) ^ p⁻¹ ≤ c * ∫ z, ‖fderiv ℝ w z‖) → ∀ (u : Euclid P → ℝ) (M : ℝ), Integrable u → HasCompactSupport u → (∀ g : Euclid P → Euclid P, ContDiff ℝ 1 g → HasCompactSupport g → (∀ z, ‖g z‖ ≤ 1) → |∫ z, u z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ g z : Euclid P →ₗ[ℝ] Euclid P)| ≤ M) → ∀ η : ℕ → Euclid P → ℝ, (∀ k, ContDiff ℝ 1 (η k)) → (∀ k, HasCompactSupport (η k)) → (∀ k z, 0 ≤ η k z) → (∀ k z, η k (-z) = η k z) → (∀ k, ∫ z, η k z = 1) → (∀ᵐ x, Tendsto (fun k => convolution (η k) u (ContinuousLinearMap.lsmul ℝ ℝ) volume x) atTop (𝓝 (u x))) → (∫ z, |u z| ^ p) ^ p⁻¹ ≤ c * M := by
  intro P p c hp hc hS u M hu hcu hM η hη hηc hη0 hηs hη1 hae
  -- Step 1: testing the variation bound with `g = 0` gives `M ≥ 0`, hence `c M ≥ 0`
  have hM0 : 0 ≤ M := by
    simpa using hM (fun _ => 0) contDiff_const HasCompactSupport.zero fun _ => by simp
  have hcM : 0 ≤ c * M := mul_nonneg hc hM0
  -- Step 2: the mollifications `w_k = η_k * u` are `C¹` with compact support
  set w : ℕ → Euclid P → ℝ :=
    fun k => convolution (η k) u (ContinuousLinearMap.lsmul ℝ ℝ) volume
  have hwC : ∀ k, ContDiff ℝ 1 (w k) := fun k =>
    (hηc k).contDiff_convolution_left (ContinuousLinearMap.lsmul ℝ ℝ) (hη k) hu.locallyIntegrable
  have hwcs : ∀ k, HasCompactSupport (w k) := fun k =>
    (hηc k).convolution (ContinuousLinearMap.lsmul ℝ ℝ) hcu
  -- `ofReal (|t|^p) = ‖t‖ₑ^p`
  have henorm : ∀ t : ℝ, ENNReal.ofReal (|t| ^ p) = ‖t‖ₑ ^ p := fun t => by
    rw [Real.enorm_eq_ofReal_abs, ENNReal.ofReal_rpow_of_nonneg (abs_nonneg t) hp.le]
  -- Step 3: `∫ |Dw_k| ≤ M` and the Sobolev inequality give `∫ |w_k|^p ≤ (c M)^p`
  have hbound : ∀ k, ∫ z, |w k z| ^ p ≤ (c * M) ^ p := by
    intro k
    have hvar : ∫ z, ‖fderiv ℝ (w k) z‖ ≤ M :=
      Submission.codim1_rdo_dg_sp_mollify_variation P u M hu hcu hM (η k) (hη k) (hηc k)
        (hη0 k) (hηs k) (hη1 k)
    have h1 : (∫ z, |w k z| ^ p) ^ p⁻¹ ≤ c * M :=
      (hS (w k) (hwC k) (hwcs k)).trans (mul_le_mul_of_nonneg_left hvar hc)
    have ha : 0 ≤ ∫ z, |w k z| ^ p :=
      integral_nonneg fun z => Real.rpow_nonneg (abs_nonneg _) p
    calc ∫ z, |w k z| ^ p = ((∫ z, |w k z| ^ p) ^ p⁻¹) ^ p :=
          (Real.rpow_inv_rpow ha hp.ne').symm
      _ ≤ (c * M) ^ p := Real.rpow_le_rpow (Real.rpow_nonneg ha _) h1 hp.le
  -- Step 4: `|w_k|^p` is continuous with compact support, so `∫⁻ ‖w_k‖ₑ^p ≤ ofReal ((c M)^p)`
  have hlow : ∀ k, ∫⁻ x, ‖w k x‖ₑ ^ p ≤ ENNReal.ofReal ((c * M) ^ p) := by
    intro k
    have hint : Integrable fun z => |w k z| ^ p :=
      ((hwC k).continuous.abs.rpow_const fun _ => Or.inr hp.le).integrable_of_hasCompactSupport
        ((hwcs k).abs.rpow_const hp.ne')
    calc ∫⁻ x, ‖w k x‖ₑ ^ p = ∫⁻ x, ENNReal.ofReal (|w k x| ^ p) :=
          lintegral_congr fun x => (henorm (w k x)).symm
      _ = ENNReal.ofReal (∫ z, |w k z| ^ p) :=
          (ofReal_integral_eq_lintegral_ofReal hint
            (Eventually.of_forall fun z => Real.rpow_nonneg (abs_nonneg _) p)).symm
      _ ≤ ENNReal.ofReal ((c * M) ^ p) := ENNReal.ofReal_le_ofReal (hbound k)
  -- Step 5: Fatou's lemma along `w_k → u` a.e.
  have hfatou : ∫⁻ x, ‖u x‖ₑ ^ p ≤ ENNReal.ofReal ((c * M) ^ p) :=
    calc ∫⁻ x, ‖u x‖ₑ ^ p = ∫⁻ x, liminf (fun k => ‖w k x‖ₑ ^ p) atTop := by
          refine lintegral_congr_ae ?_
          filter_upwards [hae] with x hx
          exact ((hx.enorm.ennrpow_const p).liminf_eq).symm
      _ ≤ liminf (fun k => ∫⁻ x, ‖w k x‖ₑ ^ p) atTop :=
          lintegral_liminf_le fun k => (hwC k).continuous.measurable.enorm.pow_const p
      _ ≤ ENNReal.ofReal ((c * M) ^ p) := liminf_le_of_frequently_le' (Frequently.of_forall hlow)
  -- Step 6: `∫ |u|^p = (∫⁻ ‖u‖ₑ^p).toReal ≤ (c M)^p`; take the `1/p` power
  have hup : 0 ≤ ∫ z, |u z| ^ p := integral_nonneg fun z => Real.rpow_nonneg (abs_nonneg _) p
  have hU : ∫ z, |u z| ^ p ≤ (c * M) ^ p := by
    rw [integral_eq_lintegral_of_nonneg_ae
      (Eventually.of_forall fun z => Real.rpow_nonneg (abs_nonneg (u z)) p)
      ((continuous_abs.rpow_const fun _ => Or.inr hp.le).comp_aestronglyMeasurable
        hu.aestronglyMeasurable)]
    refine ENNReal.toReal_le_of_le_ofReal (Real.rpow_nonneg hcM p) ?_
    calc ∫⁻ x, ENNReal.ofReal (|u x| ^ p) = ∫⁻ x, ‖u x‖ₑ ^ p :=
          lintegral_congr fun x => henorm (u x)
      _ ≤ ENNReal.ofReal ((c * M) ^ p) := hfatou
  calc (∫ z, |u z| ^ p) ^ p⁻¹ ≤ ((c * M) ^ p) ^ p⁻¹ :=
        Real.rpow_le_rpow hup hU (inv_nonneg.2 hp.le)
    _ = c * M := Real.rpow_rpow_inv hcM hp.ne'

/-- **The Sobolev inequality for `ζ 1_F`** (Simon Ch. 3, proof of Theorem 4.3 (De Giorgi),
chapter-03.txt lines 689–712: `(∫ (ζ 1_F)^{(n+1)/n})^{n/(n+1)} ≤ c ∫ |D(ζ 1_F)| ≤
c (∫ ζ dμ + ∫_F |Dζ|)`, with the mollification Lemma Ch. 2, 2.5).  For `m ≥ 1` the exponent
`p = (m+1)/m` is the Hölder conjugate of `dim ℝ^{m+1} = m+1`, so Mathlib's Gagliardo–Nirenberg–
Sobolev inequality gives the constant `c`.  Given the Gauss–Green identity, `u = 1_F ζ` has
variation at most `M = ∫ ζ dμ + ∫_F |Dζ|`; the normalized bump functions of radius `1/(k+1)` are
even, nonnegative, unit-mass `C¹` kernels whose mollifications converge to `u` a.e. (Lebesgue
differentiation), and the Sobolev bound passes from the mollifications to `u`. -/
theorem codim1_rdo_dg_sobolev_perimeter : ∀ (m : ℕ), 1 ≤ m → ∃ c : ℝ, 0 < c ∧ ∀ (D F : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)), IsOpen D → MeasurableSet F → μ Dᶜ = 0 → (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μ K ≠ ∞) → Measurable ν → (∀ z, ‖ν z‖ = 1) → (∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ z in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -∫ z, inner ℝ (φ z) (ν z) ∂μ) → ∀ ζ : Euclid (m + 1) → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ → tsupport ζ ⊆ D → (∀ z, 0 ≤ ζ z) → (∫ z in F, ζ z ^ ((m + 1 : ℝ) / m)) ^ ((m : ℝ) / (m + 1)) ≤ c * (∫ z, ζ z ∂μ + ∫ z in F, ‖fderiv ℝ ζ z‖) := by
  intro m hm
  -- Step 0: `p = (m+1)/m` is the Hölder conjugate of `m + 1`; GNS gives the constant `c`
  have hm0 : (0 : ℝ) < m := by exact_mod_cast hm
  have hp : (0 : ℝ) < (m + 1 : ℝ) / m := by positivity
  have hHC : Real.HolderConjugate (Module.finrank ℝ (Euclid (m + 1)) : ℝ) ((m + 1 : ℝ) / m) := by
    rw [finrank_euclideanSpace_fin]
    refine ⟨?_, by positivity, hp⟩
    push_cast
    field_simp
    ring
  obtain ⟨c, hc, hS⟩ := Submission.codim1_rdo_dg_sp_gns_real_of_lintegral (m + 1)
    ((m + 1 : ℝ) / m) (lintegralPowLePowLIntegralFDerivConst volume ((m + 1 : ℝ) / m)) hp
    fun w hw hwc => lintegral_pow_le_pow_lintegral_fderiv volume hw hwc hHC
  refine ⟨c, hc, ?_⟩
  intro D F μ ν hD hF hμD hμK hν hν1 hGG ζ hζ hζc hζD hζ0
  -- Step 1: `u = 1_F ζ` is integrable with compact support; its variation bound `M` is
  -- `gauss_green_variation` (used below)
  have hu : Integrable (F.indicator ζ) :=
    (hζ.continuous.integrable_of_hasCompactSupport hζc).indicator hF
  have huc : HasCompactSupport (F.indicator ζ) :=
    hζc.mono fun z hz h0 => hz (by simp [h0])
  -- Step 2: even, nonnegative, unit-mass `C¹` kernels of radius `1/(k+1)`
  let φ : ℕ → ContDiffBump (0 : Euclid (m + 1)) := fun k =>
    { rIn := 1 / ((k : ℝ) + 1) / 2
      rOut := 1 / ((k : ℝ) + 1)
      rIn_pos := by positivity
      rIn_lt_rOut := by
        have : (0 : ℝ) < 1 / ((k : ℝ) + 1) := by positivity
        linarith }
  have hφ0 : Tendsto (fun k => (φ k).rOut) atTop (𝓝 0) :=
    tendsto_one_div_add_atTop_nhds_zero_nat
  have hφK : ∀ᶠ k in atTop, (φ k).rOut ≤ 2 * (φ k).rIn :=
    Eventually.of_forall fun k => by
      change 1 / ((k : ℝ) + 1) ≤ 2 * (1 / ((k : ℝ) + 1) / 2)
      linarith
  -- Lebesgue differentiation: the mollifications converge to `u` almost everywhere
  have hae := ContDiffBump.ae_convolution_tendsto_right_of_locallyIntegrable (μ := volume)
    hφ0 hφK hu.locallyIntegrable
  -- Steps 3–4: GNS for the mollifications and passage to the limit
  have key := Submission.codim1_rdo_dg_sp_sobolev_limit (m + 1) ((m + 1 : ℝ) / m) c hp hc.le hS
    (F.indicator ζ) (∫ z, ζ z ∂μ + ∫ z in F, ‖fderiv ℝ ζ z‖) hu huc
    (fun g hg hgc hg1 => Submission.codim1_rdo_dg_sp_gauss_green_variation (m + 1) D F μ ν hD hF
      hμD hμK hν hν1 hGG ζ hζ hζc hζD hζ0 g hg hgc hg1)
    (fun k => (φ k).normed volume) (fun k => (φ k).contDiff_normed)
    (fun k => (φ k).hasCompactSupport_normed) (fun k => (φ k).nonneg_normed)
    (fun k => (φ k).normed_neg) (fun k => (φ k).integral_normed) hae
  -- Conclusion: `∫ |1_F ζ|^p = ∫_F ζ^p` and `p⁻¹ = m/(m+1)`
  have hint : ∫ z, |F.indicator ζ z| ^ ((m + 1 : ℝ) / m) = ∫ z in F, ζ z ^ ((m + 1 : ℝ) / m) := by
    rw [← integral_indicator hF]
    congr 1
    ext z
    by_cases hz : z ∈ F
    · simp [hz, abs_of_nonneg (hζ0 z)]
    · simp [hz, Real.zero_rpow hp.ne']
  rwa [hint, inv_div] at key

/-- **Lower volume density** of `F` and of its complement (Simon Ch. 3, proof of Theorem 4.3,
(10)–(11)) at a point `y` where the normal averages of the Gauss–Green measure `μ` tend to a unit
vector `v`.  `codim1_rdo_dg_cutoff_estimates` gives `ρ₁ > 0` and `C₁ ≥ 0` with `B̄_{ρ₁}(y) ⊆ D` and
the annular bounds `δ μ(B̄_ρ(y)) ≤ C₁ L(F ∩ (B_{ρ+δ}(y) \ B̄_ρ(y)))` and
`δ μ(B̄_ρ(y)) ≤ C₁ L((B_{ρ+δ}(y) \ B̄_ρ(y)) \ F)` for `ρ + δ < ρ₁`, and
`codim1_rdo_dg_sobolev_perimeter` gives `c_S > 0` with
`(∫_F ζ^{(m+1)/m})^{m/(m+1)} ≤ c_S (∫ ζ dμ + ∫_F |Dζ|)`.  Since `v ≠ 0`, every closed ball about
`y` has positive `μ`-measure, and `μ(B̄_{ρ₁}(y)) < ∞` by local finiteness.  The finite-difference
isoperimetric inequality and its discrete integration (`codim1_rdo_dg_vdl_one_sided_density`)
give `L(F ∩ B_ρ(y)) ≥ c₁ ρ^{m+1}` for `ρ < ρ₁` (printed (10)).  Since `∫ div φ = 0`, `Fᶜ`
satisfies the Gauss–Green identity with normal `−ν`, so the Sobolev inequality and the annular
bound hold for `Fᶜ` as well, and the same argument gives `L(B_ρ(y) \ F) ≥ c₂ ρ^{m+1}`
(printed (11)).  Take `c = min c₁ c₂` and `ρ₂ = ρ₁`. -/
theorem codim1_rdo_dg_volume_density_lower : ∀ (m : ℕ) (D F : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)) (y v : Euclid (m + 1)), 1 ≤ m → IsOpen D → MeasurableSet F → μ Dᶜ = 0 → (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μ K ≠ ∞) → Measurable ν → (∀ z, ‖ν z‖ = 1) → (∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ z in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -∫ z, inner ℝ (φ z) (ν z) ∂μ) → y ∈ D → ‖v‖ = 1 → Tendsto (fun ρ : ℝ => (μ (closedBall y ρ)).toReal⁻¹ • ∫ z in closedBall y ρ, ν z ∂μ) (𝓝[>] 0) (𝓝 v) → ∃ c ρ₂ : ℝ, 0 < c ∧ 0 < ρ₂ ∧ ∀ ρ : ℝ, 0 < ρ → ρ < ρ₂ → ENNReal.ofReal (c * ρ ^ (m + 1)) ≤ volume (F ∩ ball y ρ) ∧ ENNReal.ofReal (c * ρ ^ (m + 1)) ≤ volume (ball y ρ \ F) := by
  intro m D F μ ν y v hm hD hF hμD hμK hν hν1 hGG hy hv hT
  -- step 1: `ρ₁`, `C₁` and the annular bounds (a) for `F` and (b) for its complement
  obtain ⟨ρ₁, C₁, hρ₁, hC₁, hρ₁D, hann, -⟩ :=
    Submission.codim1_rdo_dg_cutoff_estimates m D F μ ν y v hD hF hμD hμK hν hν1 hGG hy hv hT
  -- step 2: the Sobolev inequality, with a constant `c_S` independent of `(D, F, μ, ν)`
  obtain ⟨cS, hcS, hS⟩ := Submission.codim1_rdo_dg_sobolev_perimeter m hm
  -- step 3: every closed ball about `y` has positive mass, and `μ(B̄_{ρ₁}(y)) < ∞`
  have hv0 : v ≠ 0 := norm_ne_zero_iff.mp (by rw [hv]; exact one_ne_zero)
  have hpos : ∀ r : ℝ, 0 < r → μ (closedBall y r) ≠ 0 :=
    Submission.codim1_rdo_dg_vdl_measure_closedBall_ne_zero (m + 1) μ ν y v hv0 hT
  have hfin : μ (closedBall y ρ₁) ≠ ∞ := hμK _ (isCompact_closedBall y ρ₁) hρ₁D
  -- step 4: the lower bound for `F` (printed (10))
  obtain ⟨c₁, hc₁, h₁⟩ := Submission.codim1_rdo_dg_vdl_one_sided_density m D F μ y ρ₁ C₁ cS hm
    hF hcS hC₁ hρ₁D hfin hpos (hS D F μ ν hD hF hμD hμK hν hν1 hGG)
    fun ρ δ hρ hδ hρδ => (hann ρ δ hρ hδ hρδ).1
  -- step 5: `Fᶜ` satisfies the Gauss–Green identity with normal `−ν`, so the Sobolev inequality
  -- holds for `Fᶜ`; with (b) this gives the lower bound for `Fᶜ` (printed (11))
  have hGGc := Submission.codim1_rdo_dg_vdl_gauss_green_compl (m + 1) D F μ ν hF hGG
  obtain ⟨c₂, hc₂, h₂⟩ := Submission.codim1_rdo_dg_vdl_one_sided_density m D Fᶜ μ y ρ₁ C₁ cS hm
    hF.compl hcS hC₁ hρ₁D hfin hpos
    (hS D Fᶜ μ (fun z => -ν z) hD hF.compl hμD hμK hν.neg
      (fun z => (norm_neg (ν z)).trans (hν1 z)) hGGc)
    fun ρ δ hρ hδ hρδ => by
      rw [← Set.sdiff_eq_compl_inter]
      exact (hann ρ δ hρ hδ hρδ).2
  -- step 6: `c = min c₁ c₂` and `ρ₂ = ρ₁`, using `B_ρ(y) \ F = Fᶜ ∩ B_ρ(y)`
  refine ⟨min c₁ c₂, ρ₁, lt_min hc₁ hc₂, hρ₁, fun ρ hρ hρρ₁ => ⟨?_, ?_⟩⟩
  · exact (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right (min_le_left c₁ c₂)
      (pow_nonneg hρ.le _))).trans (h₁ ρ hρ hρρ₁)
  · rw [Set.sdiff_eq_compl_inter]
    exact (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right (min_le_right c₁ c₂)
      (pow_nonneg hρ.le _))).trans (h₂ ρ hρ hρρ₁)

/-- The tangent space of the translate `{z | z + a ∈ Q} = Q − a` at any of its points `y` is `Q`:
slopes `t⁻¹(γ t − γ 0)` of a curve in the translate lie in the closed subspace `Q` and tend to
`γ'(0)`, and the line `t ↦ y + t • v` realizes each `v ∈ Q` as a velocity. -/
theorem codim1_zsl_op_translate_tangentSpace_eq : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (a y : Euclid P), y + a ∈ Q → tangentSpace {z | z + a ∈ Q} y = (Q : Set (Euclid P)) := by
  intro P Q a y hy
  -- Step 1: `Q` is finite-dimensional, hence closed.
  have hQ : IsClosed (Q : Set (Euclid P)) := Q.closed_of_finiteDimensional
  ext v
  constructor
  · -- Step 2: the slopes `t⁻¹(γ t − γ 0)` lie in `Q` for `t ∈ (−1, 1)` and tend to `v`.
    rintro ⟨γ, -, hγA, hγ0, hγv⟩
    have hIoo : Ioo (-1 : ℝ) 1 ∈ 𝓝[≠] (0 : ℝ) :=
      nhdsWithin_le_nhds (Ioo_mem_nhds (by norm_num) (by norm_num))
    refine hQ.mem_of_tendsto (hasDerivAt_iff_tendsto_slope.mp hγv) ?_
    filter_upwards [hIoo] with t ht
    have h1 : γ t + a ∈ Q := hγA ht
    have h2 : γ 0 + a ∈ Q := hγ0 ▸ hy
    rw [slope_def_module]
    exact Q.smul_mem _ (by simpa using Q.sub_mem h1 h2)
  · -- Step 3: the line `t ↦ y + t • v` witnesses `v ∈ tangentSpace {z | z + a ∈ Q} y`.
    intro hv
    refine ⟨fun t => y + t • v, ?_, ?_, by simp, ?_⟩
    · exact (contDiff_const.add (contDiff_id.smul contDiff_const)).contDiffOn
    · intro t _
      show y + t • v + a ∈ Q
      rw [add_right_comm]
      exact Q.add_mem hy (Q.smul_mem t hv)
    · simpa using ((hasDerivAt_id (0 : ℝ)).smul_const v).const_add y

end Submission

/-- **Blow-up of `F` at `y` is the half-space `{⟨w, v⟩ > 0}`** (Simon Ch. 3, proof of Theorem 4.3
(De Giorgi), printed (7)–(11) and the paragraph "Now given any sequence `λ_k ↓ 0` …",
chapter-03.txt lines 652–744; for the inward normal the limit is `{⟨w, v⟩ > 0}`, the OCR's
inequality being reversed).  Given `r_k ↓ 0`, the rescaled sets `F_{y,r_k}` have locally bounded
perimeter (`μ(B̄_ρ(y)) ≤ C₁ ρ^m`), so a subsequence converges in `L¹_loc` to some `F₀`; since the
normal averages tend to `v`, `F₀` has vanishing tangential and nonpositive normal distributional
derivative, hence is (a.e.) `∅`, `ℝ^{m+1}` or `{⟨w, v⟩ > c}`; the scale-invariant two-sided volume
bounds force `c = 0`.  The limit being independent of the sequence, the whole family converges. -/
theorem Submission.codim1_rdo_dg_blowup_halfspace : ∀ (m : ℕ) (D F : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)) (y v : Euclid (m + 1)), 1 ≤ m → IsOpen D → MeasurableSet F → μ Dᶜ = 0 → (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μ K ≠ ∞) → Measurable ν → (∀ z, ‖ν z‖ = 1) → (∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ z in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -∫ z, inner ℝ (φ z) (ν z) ∂μ) → y ∈ D → ‖v‖ = 1 → Tendsto (fun ρ : ℝ => (μ (closedBall y ρ)).toReal⁻¹ • ∫ z in closedBall y ρ, ν z ∂μ) (𝓝[>] 0) (𝓝 v) → ∀ R : ℝ, Tendsto (fun r : ℝ => volume (symmDiff ((fun w => y + r • w) ⁻¹' F) {w | 0 < inner ℝ w v} ∩ ball (0 : Euclid (m + 1)) R)) (𝓝[>] 0) (𝓝 0) := by
  intro m D F μ ν y v hm hD hF hμD hμK hν hν1 hGG hy hv hA R
  -- step 1: `μ(B̄_ρ(y)) ≤ C₁ ρ^m` for `ρ < ρ₁`, and `L(F ∩ B_ρ(y)), L(B_ρ(y) \ F) ≥ c₂ ρ^{m+1}`
  -- for `ρ < ρ₂`
  obtain ⟨ρ₁, C₁, hρ₁, hC₁, hball, -, hmass⟩ :=
    Submission.codim1_rdo_dg_cutoff_estimates m D F μ ν y v hD hF hμD hμK hν hν1 hGG hy hv hA
  obtain ⟨c₂, ρ₂, hc₂, hρ₂, hvol⟩ :=
    Submission.codim1_rdo_dg_volume_density_lower m D F μ ν y v hm hD hF hμD hμK hν hν1 hGG hy
      hv hA
  -- step 7: it suffices that every sequence `r_k → 0⁺` has a subsequence along which the
  -- quantity tends to `0`
  apply Filter.tendsto_of_subseq_tendsto
  intro rs hrs
  have hrs0 : Tendsto rs atTop (𝓝 0) := hrs.mono_right nhdsWithin_le_nhds
  have hrs_pos : ∀ᶠ k in atTop, 0 < rs k := hrs.eventually self_mem_nhdsWithin
  set Fs : ℕ → Set (Euclid (m + 1)) := fun k => (fun w => y + rs k • w) ⁻¹' F with hFs_def
  have hFs : ∀ k, MeasurableSet (Fs k) := fun k =>
    (measurable_const.add (measurable_id.const_smul (rs k))) hF
  -- step 4: perimeter bounds `C₁ R^m` on `B_R`, hence an `L¹_loc` limit `F₀` of a subsequence
  have hper : ∀ R' : ℝ, 0 < R' → ∃ C : ℝ, ∀ᶠ k in atTop, ∀ g : Euclid (m + 1) → Euclid (m + 1),
      ContDiff ℝ 1 g → HasCompactSupport g → tsupport g ⊆ ball (0 : Euclid (m + 1)) R' →
      (∀ z, ‖g z‖ ≤ 1) →
      ∫ z in Fs k, LinearMap.trace ℝ (Euclid (m + 1))
        (fderiv ℝ g z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) ≤ C := by
    intro R' hR'
    refine ⟨C₁ * R' ^ m, ?_⟩
    have h1 : ∀ᶠ k in atTop, rs k * R' < ρ₁ := by
      have : Tendsto (fun k => rs k * R') atTop (𝓝 0) := by simpa using hrs0.mul_const R'
      exact this.eventually (gt_mem_nhds hρ₁)
    filter_upwards [hrs_pos, h1] with k hk1 hk2
    intro g hg hgc hgs hg1
    exact Submission.codim1_rdo_dg_bh_perimeter_bound m D F μ ν y ρ₁ C₁ hF hν hν1 hGG hρ₁ hC₁
      hball hmass R' (rs k) hR' hk1 hk2 g hg hgc hgs hg1
  obtain ⟨ψ, F₀, hψ, hF₀, hconv⟩ := Submission.codim1_rdo_dg_bv_set_compactness m Fs hFs hper
  refine ⟨ψ, ?_⟩
  have hrsψ : Tendsto (fun j => rs (ψ j)) atTop (𝓝[>] 0) := hrs.comp hψ.tendsto_atTop
  obtain ⟨hint, hin, hout⟩ :=
    Submission.codim1_rdo_dg_bh_l1loc_transfer m (fun j => Fs (ψ j)) F₀ (fun j => hFs _) hF₀ hconv
  -- step 5: `F₀` has vanishing tangential and nonpositive normal derivative
  have htan : ∀ ζ : Euclid (m + 1) → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ →
      ∀ w : Euclid (m + 1), inner ℝ w v = 0 → ∫ z in F₀, fderiv ℝ ζ z w = 0 := by
    intro ζ hζ hζc w hw
    have h1 := (Submission.codim1_rdo_dg_bh_tangential_vanish m D F μ ν y v ρ₁ C₁ hF hν hν1 hGG hv
      hA hρ₁ hC₁ hball hmass ζ hζ hζc w hw).comp hrsψ
    have h2 := hint (fun z => fderiv ℝ ζ z w)
      ((hζ.continuous_fderiv one_ne_zero).clm_apply continuous_const) (hζc.fderiv_apply (𝕜 := ℝ) w)
    exact tendsto_nhds_unique h2 h1
  have hnor : ∀ ζ : Euclid (m + 1) → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ →
      (∀ z, 0 ≤ ζ z) → ∫ z in F₀, fderiv ℝ ζ z v ≤ 0 := by
    intro ζ hζ hζc hζ0
    have h2 := hint (fun z => fderiv ℝ ζ z v)
      ((hζ.continuous_fderiv one_ne_zero).clm_apply continuous_const) (hζc.fderiv_apply (𝕜 := ℝ) v)
    refine le_of_forall_pos_le_add fun δ hδ => ?_
    have h1 := Submission.codim1_rdo_dg_bh_normal_limsup m D F μ ν y v ρ₁ C₁ hF hν hν1 hGG hv hA
      hρ₁ hC₁ hball hmass ζ hζ hζc hζ0 δ hδ
    have h3 : ∀ᶠ j in atTop, ∫ z in Fs (ψ j), fderiv ℝ ζ z v ≤ δ := hrsψ.eventually h1
    simpa using le_of_tendsto h2 h3
  -- so `F₀` is a.e. `∅`, `ℝ^{m+1}` or `{⟨w, v⟩ > c}`
  have htri := Submission.codim1_rdo_dg_halfspace_rigidity m F₀ v hv hF₀ htan hnor
  -- step 6: the scale-invariant two-sided volume bounds pass to the limit, which forces `c = 0`
  have hpos : ∀ s : ℝ, 0 < s → 0 < volume (F₀ ∩ ball (0 : Euclid (m + 1)) s) ∧
      0 < volume (ball (0 : Euclid (m + 1)) s \ F₀) := by
    intro s hs
    have hpos' : ∀ᶠ j in atTop, 0 < rs (ψ j) := hrsψ.eventually self_mem_nhdsWithin
    have hsmall : ∀ᶠ j in atTop, rs (ψ j) * s < ρ₂ := by
      have : Tendsto (fun j => rs (ψ j) * s) atTop (𝓝 0) := by
        simpa using (hrsψ.mono_right nhdsWithin_le_nhds).mul_const s
      exact this.eventually (gt_mem_nhds hρ₂)
    have hlow : ∀ᶠ j in atTop,
        ENNReal.ofReal (c₂ * s ^ (m + 1)) ≤ volume (Fs (ψ j) ∩ ball (0 : Euclid (m + 1)) s) ∧
          ENNReal.ofReal (c₂ * s ^ (m + 1)) ≤ volume (ball (0 : Euclid (m + 1)) s \ Fs (ψ j)) := by
      filter_upwards [hpos', hsmall] with j h1 h2
      exact Submission.codim1_rdo_dg_bh_rescaled_volume_lower m F y c₂ ρ₂ hF hvol s (rs (ψ j)) hs
        h1 h2
    have hc : 0 < ENNReal.ofReal (c₂ * s ^ (m + 1)) :=
      ENNReal.ofReal_pos.mpr (mul_pos hc₂ (pow_pos hs _))
    exact ⟨lt_of_lt_of_le hc (ge_of_tendsto (hin s) (hlow.mono fun j h => h.1)),
      lt_of_lt_of_le hc (ge_of_tendsto (hout s) (hlow.mono fun j h => h.2))⟩
  have hH := Submission.codim1_rdo_dg_bh_offset_zero m F₀ v hv hpos htri
  -- step 7: `L((F_{r_{ψ j}} Δ H) ∩ B_R) ≤ L((F_{r_{ψ j}} Δ F₀) ∩ B_R) + L(F₀ Δ H) → 0`
  have hle : ∀ j, volume (symmDiff (Fs (ψ j)) {w | 0 < inner ℝ w v} ∩ ball (0 : Euclid (m + 1)) R) ≤
      volume (symmDiff (Fs (ψ j)) F₀ ∩ ball (0 : Euclid (m + 1)) R) := by
    intro j
    calc volume (symmDiff (Fs (ψ j)) {w | 0 < inner ℝ w v} ∩ ball (0 : Euclid (m + 1)) R)
        ≤ volume (symmDiff (Fs (ψ j)) F₀ ∩ ball (0 : Euclid (m + 1)) R ∪
            symmDiff F₀ {w | 0 < inner ℝ w v}) := by
          apply measure_mono
          intro x hx
          rcases symmDiff_triangle (Fs (ψ j)) F₀ {w | 0 < inner ℝ w v} hx.1 with h | h
          · exact Or.inl ⟨h, hx.2⟩
          · exact Or.inr h
      _ ≤ volume (symmDiff (Fs (ψ j)) F₀ ∩ ball (0 : Euclid (m + 1)) R) +
            volume (symmDiff F₀ {w | 0 < inner ℝ w v}) :=
          measure_union_le _ _
      _ = volume (symmDiff (Fs (ψ j)) F₀ ∩ ball (0 : Euclid (m + 1)) R) := by rw [hH, add_zero]
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds (hconv R) (fun j => by simp) hle

/-- **Blow-ups of the Gauss–Green measure converge to `Hᵐ⌞ν(y)ᗮ`** (Simon Ch. 3, proof of
Theorem 4.3 (De Giorgi), 4.3 (†), chapter-03.txt lines 734–746).  By `normal_average_ae`,
`μ`-a.e. `y` lies in `D` and has normal averages `A(ρ) → ν(y)`; fix such `y` and put
`v = ν(y)`.  `cutoff_estimates` gives `B̄_{ρ₁}(y) ⊆ D` and `μ(B̄_ρ(y)) ≤ C ρᵐ`,
`blowup_halfspace` gives `F_{y,r} → {⟨w, v⟩ > 0}` in `L¹_loc`, and `hyperplane_param` shows
that `τ = Hᵐ⌞vᗮ` is finite on balls.  By `continuous_extension` it suffices to treat `C¹`
test functions `g`; by `normal_defect` it suffices to show
`r⁻ᵐ ∫ g(r⁻¹(z − y)) ⟨v, ν(z)⟩ dμ(z) → ∫_{vᗮ} g dHᵐ`, which is the vector convergence (3a)
(`vector_convergence`) for the field `g v`, since `⟨g v, ν⟩ = g ⟨v, ν⟩` and `⟨g v, v⟩ = g`. -/
theorem Submission.codim1_rdo_dg_tangent_measure_ae : ∀ (m : ℕ) (D F : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)), 1 ≤ m → IsOpen D → MeasurableSet F → μ Dᶜ = 0 → (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μ K ≠ ∞) → Measurable ν → (∀ z, ‖ν z‖ = 1) → (∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ z in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -∫ z, inner ℝ (φ z) (ν z) ∂μ) → ∀ᵐ y ∂μ, ∀ f : Euclid (m + 1) → ℝ, Continuous f → HasCompactSupport f → Tendsto (fun r : ℝ => (r ^ m)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) ∂μ) (𝓝[>] 0) (𝓝 (∫ z in ((Submodule.span ℝ {ν y})ᗮ : Set (Euclid (m + 1))), f z ∂μHE[m])) := by
  intro m D F μ ν hm hD hF hDc hloc hνm hν1 hGG
  -- Step 1: good points `y` (`y ∈ D`, `A(ρ) → ν(y)`), with `v = ν(y)`
  filter_upwards [Submission.codim1_rdo_dg_normal_average_ae m D μ ν hD hDc hloc hνm hν1]
    with y hy
  obtain ⟨hyD, hA⟩ := hy
  have hv : ‖ν y‖ = 1 := hν1 y
  obtain ⟨ρ₁, C, hρ₁, hC, hball, -, hdens⟩ :=
    Submission.codim1_rdo_dg_cutoff_estimates m D F μ ν y (ν y) hD hF hDc hloc hνm hν1 hGG
      hyD hv hA
  have hblow := Submission.codim1_rdo_dg_blowup_halfspace m D F μ ν y (ν y) hm hD hF hDc hloc
    hνm hν1 hGG hyD hv hA
  -- `τ = Hᵐ⌞ν(y)ᗮ = ι_# Lᵐ` is finite on closed balls
  have hv0 : ν y ≠ 0 := by
    intro h
    rw [h, norm_zero] at hv
    exact zero_ne_one hv
  obtain ⟨ι, -, hmap⟩ := Submission.codim1_rdo_dg_tma_hyperplane_param m (ν y) hv0
  have hfin : ∀ R : ℝ, ((μHE[m] : Measure (Euclid (m + 1))).restrict
      ((Submodule.span ℝ {ν y})ᗮ : Set (Euclid (m + 1)))) (closedBall (0 : Euclid (m + 1)) R)
      ≠ ∞ := by
    intro R
    rw [hmap, Measure.map_apply ι.continuous.measurable measurableSet_closedBall]
    have hpre : (ι : Euclid m → Euclid (m + 1)) ⁻¹' closedBall 0 R = closedBall 0 R := by
      ext x
      simp [ι.norm_map]
    rw [hpre]
    exact measure_closedBall_lt_top.ne
  -- Step 5: it suffices to treat `C¹` test functions
  intro f hf hfc
  refine Submission.codim1_rdo_dg_tma_continuous_extension (m + 1) m μ _ y ρ₁ C hρ₁ hC hdens hfin
    ?_ f hf hfc
  -- Step 4: it suffices to treat the integrals weighted by `⟨ν(y), ν⟩`
  intro g hg hgc
  refine Submission.codim1_rdo_dg_tma_normal_defect (m + 1) m μ ν y (ν y) ρ₁ C _ g hνm hν1 hv hρ₁
    hC hdens hA hg.continuous hgc ?_
  -- Step 3: the vector convergence (3a) for the field `g ν(y)`
  have key := Submission.codim1_rdo_dg_tma_vector_convergence m D F μ ν y (ν y) ρ₁ hF hGG hρ₁
    hball hv hblow (fun w => g w • ν y) (hg.smul contDiff_const) hgc.smul_right
  simpa [real_inner_smul_left, real_inner_self_eq_norm_sq, hv] using key

/-- **De Giorgi's structure theorem**, Gauss–Green form (Simon Ch. 3, 4.1–4.3).  Let `m ≥ 1`,
`D ⊆ ℝ^{m+1}` open and `F` Borel with locally finite perimeter in `D`.  Then there are a
countably `m`-rectifiable Borel set `B ⊆ D`, with `Hᵐ(B ∩ K) < ∞` for compact `K ⊆ D`, and a
Borel `ν`, with `|ν| = 1` on `B` and approximate tangent space `ν(y)^⊥` at `Hᵐ`-a.e. `y ∈ B`,
such that `∫_F div φ = −∫_B ⟨φ, ν⟩ dHᵐ` for `φ ∈ C¹_c(D; ℝ^{m+1})`.  The Riesz representation
of the perimeter functional gives a Gauss–Green pair `(μ, ν)` (4.1).  At `μ`-a.e. `y` the
blow-ups of `μ` converge to `Hᵐ⌞ν(y)^⊥` (4.3 (†)).  Since countably `m`-rectifiable sets of finite
measure have `Hᵐ`-density one a.e., this gives `μ = Hᵐ⌞B`, with approximate tangent planes
`ν^⊥`, and then (4.1) is the Gauss–Green formula over `B`. -/
theorem Submission.codim1_rdo_de_giorgi_gauss_green : ∀ (m : ℕ) (D F : Set (Euclid (m + 1))), 1 ≤ m → IsOpen D → MeasurableSet F → (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → ∃ C : ℝ, ∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ → tsupport φ ⊆ K → (∀ y, ‖φ y‖ ≤ 1) → ∫ y in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ y : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) ≤ C) → ∃ (B : Set (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)), MeasurableSet B ∧ B ⊆ D ∧ CountablyRectifiable m B ∧ (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μHE[m] (B ∩ K) ≠ ∞) ∧ Measurable ν ∧ (∀ y ∈ B, ‖ν y‖ = 1) ∧ (∀ᵐ y ∂(μHE[m].restrict B), HasApproximateTangentSpaceAt m B y (Submodule.span ℝ {ν y})ᗮ) ∧ ∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ y in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ y : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -∫ y in B, inner ℝ (φ y) (ν y) ∂μHE[m] := by
  intro m D F hm hD hF hper
  -- Steps 1–2: the Gauss–Green pair `(μ, ν)` of (4.1), `|ν| ≡ 1`
  obtain ⟨μ, ν, hμD, hμK, hν, hν1, hGG⟩ :=
    Submission.codim1_rdo_dg_gauss_green_measure m D F hD hF hper
  -- Steps 3–4: at `μ`-a.e. `y` the blow-ups of `μ` converge to `Hᵐ⌞ν(y)^⊥` (4.3 (†))
  have htan :=
    Submission.codim1_rdo_dg_tangent_measure_ae m D F μ ν hm hD hF hμD hμK hν hν1 hGG
  -- Steps 5–8: `μ = Hᵐ⌞B`, using `Hᵐ`-density one of rectifiable sets (`P = m + 1`, `n = m`)
  obtain ⟨B, hB, hBD, hBrect, rfl, hBtan⟩ :=
    Submission.codim1_rdo_dg_measure_eq_hausdorff m D μ ν hm hD hμD hμK hν hν1 htan
      fun S hS hSrect hSfin =>
        Submission.codim1_rdo_rectifiable_ae_density_one (m + 1) m S hm hS hSrect hSfin
  -- Step 9: `Hᵐ(B ∩ K) = μ(K) < ∞`, and (4.1) for `μ = Hᵐ⌞B` is the Gauss–Green formula
  refine ⟨B, ν, hB, hBD, hBrect, fun K hK hKD => ?_, hν, fun y _ => hν1 y, hBtan, hGG⟩
  rw [inter_comm, ← Measure.restrict_apply' hB]
  exact hμK K hK hKD

/-- **Locally finite perimeter of the chart region** (Simon Ch. 6, 2.35; the chart step of the
local unit representation in the proof of 7.5.8).  Let `G(v) = x + ιv + u(v)` on `D = B_{δ₁}(0)`
and `F = D ∩ G⁻¹(E)`.  `F` is Borel: `G` is continuous on the open ball `D`, so
`F = D ∩ G̃⁻¹(E)` for the Borel map `G̃ = D.piecewise G x`.  Let `K̂ = B̄_{δ₁+δ₂}(x)`, a compact
subset of `U`.  For an integer multiplicity representation `R` of `T`,
`M_{K̂}(T) ≤ μ_R(K̂) < ∞`.  Given `φ ∈ C^∞_c` with `spt φ ⊆ K ⊆ D` and `|φ| ≤ 1`, the test form
`ω_φ` of `codim1_lur_chart_test_form_exists` is supported in `Z ∩ K̂` and has
`|ω_φ| ≤ (n+1)! √(Pⁿ)`.  Its pull-back field is `φ`, so the chart divergence formula gives
`∫_F div φ = T(ω_φ) ≤ |T(ω_φ)| ≤ (n+1)! √(Pⁿ) M_{K̂}(T)`, a bound independent of `φ`. -/
theorem Submission.codim1_lur_chart_locally_finite_perimeter : ∀ (P n : ℕ) (U N E : Set (Euclid P)) (ξN : Euclid P → MultiVector P (n + 1)) (T : GeometricCurrentOn U n) (x : Euclid P) (ι : Euclid (n + 1) →ₗᵢ[ℝ] Euclid P) (u : Euclid (n + 1) → Euclid P) (δ₁ δ₂ : ℝ), MeasurableSet E → E ⊆ N ∩ U → IsBoundaryOfRegion T E ξN → IsIntegerMultiplicity T → 0 < δ₁ → 0 < δ₂ → closedBall x (δ₁ + δ₂) ⊆ U → ContDiffOn ℝ 2 u (ball 0 δ₁) → (∀ v ∈ ball (0 : Euclid (n + 1)) δ₁, (∀ w : Euclid (n + 1), inner ℝ (ι w) (u v) = 0) ∧ ‖fderiv ℝ u v‖ ≤ 1 ∧ ‖u v‖ < δ₂ / 2 ∧ x + ι v + u v ∈ N ∧ ∀ α : Covector (Euclid P) (n + 1), ξN (x + ι v + u v) α * Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (n + 1) => inner ℝ (ι (EuclideanSpace.single i 1) + fderiv ℝ u v (EuclideanSpace.single i 1)) (ι (EuclideanSpace.single j 1) + fderiv ℝ u v (EuclideanSpace.single j 1)))) = α (fun i => ι (EuclideanSpace.single i 1) + fderiv ℝ u v (EuclideanSpace.single i 1))) → (∀ (v : Euclid (n + 1)) (h : Euclid P), ‖v‖ < δ₁ → ‖h‖ < δ₂ → (∀ w : Euclid (n + 1), inner ℝ (ι w) h = 0) → x + ι v + h ∈ N → h = u v) → MeasurableSet (ball 0 δ₁ ∩ (fun y => x + ι y + u y) ⁻¹' E) ∧ ∀ K : Set (Euclid (n + 1)), IsCompact K → K ⊆ ball 0 δ₁ → ∃ C : ℝ, ∀ φ : Euclid (n + 1) → Euclid (n + 1), ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ → tsupport φ ⊆ K → (∀ y, ‖φ y‖ ≤ 1) → ∫ y in ball 0 δ₁ ∩ (fun y => x + ι y + u y) ⁻¹' E, LinearMap.trace ℝ (Euclid (n + 1)) (fderiv ℝ φ y : Euclid (n + 1) →ₗ[ℝ] Euclid (n + 1)) ≤ C := by
  intro P n U N E ξN T x ι u δ₁ δ₂ hE hEU hTE hTim hδ₁ hδ₂ hxU hu hchart huniq
  -- on `D = B_{δ₁}(0)`: `u` is differentiable, `u ⊥ range ι` and `|u| < δ₂/2`
  have hud : DifferentiableOn ℝ u (ball 0 δ₁) := hu.differentiableOn two_ne_zero
  have huι : ∀ v ∈ ball (0 : Euclid (n + 1)) δ₁, ∀ w : Euclid (n + 1), inner ℝ (ι w) (u v) = 0 :=
    fun v hv => (hchart v hv).1
  have hus : ∀ v ∈ ball (0 : Euclid (n + 1)) δ₁, ‖u v‖ < δ₂ / 2 := fun v hv => (hchart v hv).2.2.1
  refine ⟨?_, fun K hK hKD => ?_⟩
  · -- `F = D ∩ G̃⁻¹(E)` for the Borel map `G̃ = D.piecewise G x`, `G` being continuous on `D`
    classical
    have hGc : ContinuousOn (fun y => x + ι y + u y) (ball (0 : Euclid (n + 1)) δ₁) :=
      (continuousOn_const.add ι.continuous.continuousOn).add hu.continuousOn
    have hGpw := hGc.measurable_piecewise (continuousOn_const (c := x)) measurableSet_ball
    convert measurableSet_ball.inter (hGpw hE) using 1
    ext y
    simp only [mem_inter_iff, mem_preimage]
    exact and_congr_right fun hy => by rw [piecewise_eq_of_mem _ _ _ hy]
  · -- `K̂ = B̄_{δ₁+δ₂}(x)` is a compact subset of `U`, so `M_{K̂}(T) ≤ μ_R(K̂) < ∞`
    obtain ⟨R, hR⟩ := hTim
    have hM : T.massOn (closedBall x (δ₁ + δ₂)) ≠ ∞ :=
      ne_top_of_le_ne_top (Submission.rsd_imrep_compact_measure_ne_top P n U R _
          (isCompact_closedBall x (δ₁ + δ₂)) hxU).2
        (Submission.dor_ims_massOn_le_measure P n U T R hR _)
    refine ⟨((n + 1).factorial : ℝ) * Real.sqrt ((P : ℝ) ^ n) *
        (T.massOn (closedBall x (δ₁ + δ₂))).toReal, fun φ hφ hφc hφK hφ1 => ?_⟩
    -- the test form `ω_φ`: support in `Z ∩ K̂`, `|ω_φ| ≤ (n+1)! √(Pⁿ)`, pull-back field `φ`
    obtain ⟨ω, hωZ, hωK, hω, hφω⟩ := Submission.codim1_lur_chart_test_form_exists P n U x ι u δ₁ δ₂
      φ hδ₂ hxU hud huι hus hφ hφc (hφK.trans hKD) hφ1
    -- the chart divergence formula with `Φ = φ`: `T(ω_φ) = ∫_F div φ`
    rw [← (Submission.codim1_lur_chart_divergence_formula P n U N E ξN T x ι u δ₁ δ₂ hE hEU hTE
      hδ₁ hδ₂ hu hchart huniq ω φ hωZ hφω).2.2.2]
    -- `T(ω_φ) ≤ |T(ω_φ)| ≤ (n+1)! √(Pⁿ) M_{K̂}(T)`
    exact (le_abs_self _).trans (Submission.cmr_abs_apply_le_massOn P n U _ T ω _ hM hωK hω)
/-- **Area formula on a countably rectifiable set for an injective `C¹` immersion** (Simon Ch. 3,
2.1–2.6; used for the local unit representation in the proof of 7.5.8).  Let `D ⊆ ℝᵈ` be open,
`G : ℝᵈ → ℝᴾ` be `C¹` and injective on `D` with `DG(v)` injective, and let `B ⊆ D` be Borel and
countably `m`-rectifiable, with `Hᵐ(B ∩ K) < ∞` for compact `K ⊆ D` and approximate tangent space
`Q(v)` at `Hᵐ`-a.e. `v ∈ B`.  Then `G(B)` is countably `m`-rectifiable, `Hᵐ(G(B ∩ K)) < ∞`, and a
Borel `J ≥ 0`, equal `Hᵐ`-a.e. on `B` to `√det[⟨DG σᵢ, DG σⱼ⟩]` for every orthonormal frame `σ` of
`Q(v)`, has `∫_{G(B)} g dHᵐ = ∫_B J (g ∘ G) dHᵐ` (lower and Bochner integrals).  Up to an
`Hᵐ`-null set, `B` is the disjoint union of bi-Lipschitz pieces `Aᵢ = Fᵢ(Bᵢ)`, and
`Q(Fᵢ b) = range DFᵢ(b)` for a.e. `b ∈ Bᵢ` (tangent spaces of the pieces, locality, uniqueness).
On `Aᵢ`, `J = J_{G ∘ Fᵢ} / J_{Fᵢ}` is the Gram Jacobian of `DG` along `Q` by the chain rule; the
injective area formula for `G ∘ Fᵢ` and for `Fᵢ` on `Bᵢ`, summed over the pieces, gives the lower
integral identity, and the measurable embedding `G|_B` gives the Bochner identity. -/
theorem Submission.codim1_lur_rectifiable_area_formula : ∀ (m d P : ℕ) (D B : Set (Euclid d)) (G : Euclid d → Euclid P) (Q : Euclid d → Submodule ℝ (Euclid d)), 1 ≤ m → IsOpen D → ContDiffOn ℝ 1 G D → InjOn G D → (∀ v ∈ D, Injective (fderiv ℝ G v)) → MeasurableSet B → B ⊆ D → CountablyRectifiable m B → (∀ K : Set (Euclid d), IsCompact K → K ⊆ D → μHE[m] (B ∩ K) ≠ ∞) → (∀ᵐ v ∂(μHE[m].restrict B), HasApproximateTangentSpaceAt m B v (Q v)) → CountablyRectifiable m (G '' B) ∧ (∀ K : Set (Euclid d), IsCompact K → K ⊆ D → μHE[m] (G '' (B ∩ K)) ≠ ∞) ∧ ∃ J : Euclid d → ℝ, Measurable J ∧ (∀ v, 0 ≤ J v) ∧ (∀ᵐ v ∂(μHE[m].restrict B), ∀ σ : Fin m → Euclid d, Orthonormal ℝ σ → Submodule.span ℝ (Set.range σ) = Q v → J v = Real.sqrt (Matrix.det (Matrix.of fun i j : Fin m => inner ℝ (fderiv ℝ G v (σ i)) (fderiv ℝ G v (σ j))))) ∧ (∀ g : Euclid P → ℝ≥0∞, ∫⁻ w in G '' B, g w ∂μHE[m] = ∫⁻ v in B, ENNReal.ofReal (J v) * g (G v) ∂μHE[m]) ∧ ∀ f : Euclid P → ℝ, ∫ w in G '' B, f w ∂μHE[m] = ∫ v in B, J v * f (G v) ∂μHE[m] := by
  intro m d P D B G Q hm hD hG hGinj hDG hB hBD hBrect hBfin hQ
  -- Step 0: `G` is Lipschitz on compacta of `D` and maps null, resp. countably `m`-rectifiable,
  -- subsets of `D` to null, resp. countably `m`-rectifiable, sets
  obtain ⟨hGlip, hGnull, hGrect⟩ :=
    Submission.codim1_lura_c1_image_lipschitz_null_rectifiable m d P D G hD hG
  have hGd : ∀ v ∈ D, DifferentiableAt ℝ G v := fun v hv =>
    (hG.contDiffAt (hD.mem_nhds hv)).differentiableAt one_ne_zero
  have hGc : ContinuousOn G B := hG.continuousOn.mono hBD
  have hGi : InjOn G B := hGinj.mono hBD
  -- Step 1: Borel pieces `Aᵢ = Fᵢ(Bᵢ) ⊆ B`, pairwise disjoint and covering `B` up to an
  -- `Hᵐ`-null set, with `Fᵢ` Lipschitz, `cᵢ|a − a'| ≤ |Fᵢ a − Fᵢ a'|` and `DFᵢ` injective on `Bᵢ`
  obtain ⟨F, S, c, hFL, hSm, hc, hlow, hFd, hAm, hAB, hAdisj, hN⟩ :=
    Submission.dpf_rectifiable_bilipschitz_pieces d m B hB hBrect
  have hFi : ∀ i, InjOn (F i) (S i) := fun i a ha a' ha' h => by
    have hle := hlow i a ha a' ha'
    rw [h, sub_self, norm_zero] at hle
    exact sub_eq_zero.1 (norm_le_zero_iff.1 (nonpos_of_mul_nonpos_right hle (hc i)))
  have hFc : ∀ i, Continuous (F i) := fun i => (hFL i).choose_spec.continuous
  have hFD : ∀ i, ∀ b ∈ S i, F i b ∈ D := fun i b hb => hBD (hAB i (mem_image_of_mem _ hb))
  -- `G ∘ Fᵢ` is differentiable at `b ∈ Bᵢ`, with `D(G ∘ Fᵢ)(b) = DG(Fᵢ b) ∘ DFᵢ(b)` injective, and
  -- `G ∘ Fᵢ` is injective on `Bᵢ`
  have hcomp : ∀ i, ∀ b ∈ S i,
      fderiv ℝ (G ∘ F i) b = (fderiv ℝ G (F i b)).comp (fderiv ℝ (F i) b) := fun i b hb =>
    fderiv_comp b (hGd _ (hFD i b hb)) (hFd i b hb).1
  have hGFd : ∀ i, ∀ b ∈ S i, DifferentiableAt ℝ (G ∘ F i) b := fun i b hb =>
    (hGd _ (hFD i b hb)).comp b (hFd i b hb).1
  have hGFinj : ∀ i, ∀ b ∈ S i, Injective (fderiv ℝ (G ∘ F i) b) := fun i b hb => by
    rw [hcomp i b hb, ContinuousLinearMap.coe_comp]
    exact (hDG _ (hFD i b hb)).comp (hFd i b hb).2
  have hGFi : ∀ i, InjOn (G ∘ F i) (S i) := fun i => hGinj.comp (hFi i) (hFD i)
  -- Step 2: `Q(Fᵢ b) = range DFᵢ(b)` for a.e. `b ∈ Bᵢ`
  have htan : ∀ i, ∀ᵐ b ∂(volume.restrict (S i)),
      Q (F i b) = LinearMap.range (fderiv ℝ (F i) b : Euclid m →ₗ[ℝ] Euclid d) := by
    intro i
    obtain ⟨L, hL⟩ := hFL i
    -- (a) `Aᵢ` has approximate tangent space `range DFᵢ(b)` at `Fᵢ b`, for a.e. `b ∈ Bᵢ`
    have ha := Submission.codim1_lur_piece_image_approxTangent_ae d m (F i) (S i) L (c i) hL
      (hSm i) (hc i) (hlow i) (hFd i)
    -- (b) `B` and `Aᵢ` have the same approximate tangent spaces `Hᵐ`-a.e. on `Aᵢ`
    have hb := Submission.regcomp_approx_tangent_locality d m D (F i '' S i) B hD (hAm i) hB
      (hAB i) hBD hBfin
    -- (c) `B` has approximate tangent space `Q` `Hᵐ`-a.e. on `Aᵢ ⊆ B`
    have hcQ := ae_restrict_of_ae_restrict_of_subset (hAB i) hQ
    -- (d) pull (b) ∧ (c) back to a.e. `b ∈ Bᵢ`
    have hd := (Submission.ptd_piece_image_measurable_ae_pullback d m (F i) (S i) L (c i) hL
      (hSm i) (hc i) (hlow i)).2 _ (hb.and hcQ)
    -- (e) uniqueness of the approximate tangent space of `Aᵢ` at `Fᵢ b`
    filter_upwards [ha, hd] with b hab hdb
    exact ((hdb.1 (Q (F i b))).1 hdb.2).unique hab
  -- Step 3: the Jacobians `J_{Fᵢ}`, `J_{G ∘ Fᵢ}` (`√det` of the Gram matrices) are Borel,
  -- `J_{Fᵢ} > 0` on `Bᵢ`, and `J_{G ∘ Fᵢ} = √det[⟨DG σₐ, DG σ_b⟩] · J_{Fᵢ}` along an orthonormal
  -- frame `σ` of `range DFᵢ(b)`
  obtain ⟨JF, hJF⟩ : ∃ JF : ℕ → Euclid m → ℝ, ∀ i b, JF i b = Real.sqrt (Matrix.det
      (Matrix.of fun k l : Fin m => inner ℝ (fderiv ℝ (F i) b (EuclideanSpace.single k 1))
        (fderiv ℝ (F i) b (EuclideanSpace.single l 1)))) := ⟨_, fun _ _ => rfl⟩
  obtain ⟨JGF, hJGF⟩ : ∃ JGF : ℕ → Euclid m → ℝ, ∀ i b, JGF i b = Real.sqrt (Matrix.det
      (Matrix.of fun k l : Fin m => inner ℝ (fderiv ℝ (G ∘ F i) b (EuclideanSpace.single k 1))
        (fderiv ℝ (G ∘ F i) b (EuclideanSpace.single l 1)))) := ⟨_, fun _ _ => rfl⟩
  have hJFm : ∀ i, Measurable (JF i) := fun i => by
    rw [show JF i = _ from funext (hJF i)]
    exact (Submission.codim1_lura_gram_area_formula m d (F i)).1
  have hJGFm : ∀ i, Measurable (JGF i) := fun i => by
    rw [show JGF i = _ from funext (hJGF i)]
    exact (Submission.codim1_lura_gram_area_formula m P (G ∘ F i)).1
  have hJFpos : ∀ i, ∀ b ∈ S i, 0 < JF i b := fun i b hb => by
    rw [hJF]
    exact Real.sqrt_pos.2
      ((Submission.codim1_lura_gram_det_comp_orthonormal m d P (fderiv ℝ (F i) b)).1 (hFd i b hb).2)
  have hchain : ∀ i, ∀ b ∈ S i, ∀ σ : Fin m → Euclid d, Orthonormal ℝ σ →
      Submodule.span ℝ (Set.range σ) =
        LinearMap.range (fderiv ℝ (F i) b : Euclid m →ₗ[ℝ] Euclid d) →
      JGF i b = Real.sqrt (Matrix.det (Matrix.of fun a a' : Fin m =>
        inner ℝ (fderiv ℝ G (F i b) (σ a)) (fderiv ℝ G (F i b) (σ a')))) * JF i b := by
    intro i b hb σ hσ hspan
    obtain ⟨hpos, hdet⟩ :=
      Submission.codim1_lura_gram_det_comp_orthonormal m d P (fderiv ℝ (F i) b)
    rw [hJGF, hJF, hcomp i b hb]
    simp only [ContinuousLinearMap.comp_apply]
    rw [hdet (fderiv ℝ G (F i b)) σ hσ hspan, Real.sqrt_mul' _ (hpos (hFd i b hb).2).le]
  -- Step 4: a Borel `J ≥ 0` with `J(Fᵢ b) = J_{G ∘ Fᵢ}(b) / J_{Fᵢ}(b)` for `b ∈ Bᵢ`
  obtain ⟨J, hJm, hJ0, hJ⟩ := Submission.codim1_lura_glue_measurable_on_pieces m d F S
    (fun i b => JGF i b / JF i b) hFc hSm hFi hAdisj (fun i => (hJGFm i).div (hJFm i))
    (fun i b => div_nonneg (hJGF i b ▸ Real.sqrt_nonneg _) (hJF i b ▸ Real.sqrt_nonneg _))
  -- (‡) `J(Fᵢ b) · J_{Fᵢ}(b) = J_{G ∘ Fᵢ}(b)` on `Bᵢ`
  have hJmul : ∀ i, ∀ b ∈ S i, JF i b * J (F i b) = JGF i b := fun i b hb => by
    rw [hJ i b hb, mul_div_cancel₀ _ (hJFpos i b hb).ne']
  -- Step 5: the Gram identity for `J`, first at `Fᵢ b` for a.e. `b ∈ Bᵢ`, then `Hᵐ`-a.e. on `B`
  have hgram : ∀ᵐ v ∂(μHE[m].restrict B), ∀ σ : Fin m → Euclid d, Orthonormal ℝ σ →
      Submodule.span ℝ (Set.range σ) = Q v → J v = Real.sqrt (Matrix.det
        (Matrix.of fun i j : Fin m => inner ℝ (fderiv ℝ G v (σ i)) (fderiv ℝ G v (σ j)))) := by
    refine Submission.dpf_itt_ae_of_ae_pieces d m B F S _ hB hFL hN fun i => ?_
    filter_upwards [htan i, ae_restrict_mem (hSm i)] with b hbQ hb σ hσ hspan
    have hne := (hJFpos i b hb).ne'
    rw [← mul_left_inj' hne, mul_comm (J (F i b)), hJmul i b hb,
      hchain i b hb σ hσ (hspan.trans hbQ)]
  -- Step 6: the area formula, first on each piece (applied to `G ∘ Fᵢ` and to `Fᵢ`), then summed
  have hpiece : ∀ i (g : Euclid P → ℝ≥0∞), ∫⁻ w in G '' (F i '' S i), g w ∂μHE[m] =
      ∫⁻ v in F i '' S i, ENNReal.ofReal (J v) * g (G v) ∂μHE[m] := by
    intro i g
    rw [← image_comp, (Submission.codim1_lura_gram_area_formula m P (G ∘ F i)).2 (S i) (hSm i)
      (hGFd i) (hGFinj i) (hGFi i) g, (Submission.codim1_lura_gram_area_formula m d (F i)).2
      (S i) (hSm i) (fun b hb => (hFd i b hb).1) (fun b hb => (hFd i b hb).2) (hFi i)
      (fun v => ENNReal.ofReal (J v) * g (G v))]
    refine setLIntegral_congr_fun (hSm i) fun b hb => ?_
    simp only [← hJF, ← hJGF, comp_apply]
    rw [← mul_assoc, ← ENNReal.ofReal_mul (hJFpos i b hb).le, hJmul i b hb]
  have hlint : ∀ g : Euclid P → ℝ≥0∞,
      ∫⁻ w in G '' B, g w ∂μHE[m] = ∫⁻ v in B, ENNReal.ofReal (J v) * g (G v) ∂μHE[m] := by
    intro g
    have hGN : μHE[m] (G '' (B \ ⋃ i, F i '' S i)) = 0 := hGnull _ (sdiff_subset.trans hBD) hN
    have hid := Submission.codim1_lura_lintegral_image_eq_tsum_pieces m d d B
      (fun i => F i '' S i) id continuousOn_id (injOn_id B) hAm hAB hAdisj (by rwa [image_id])
      (fun v => ENNReal.ofReal (J v) * g (G v))
    simp only [image_id] at hid
    rw [Submission.codim1_lura_lintegral_image_eq_tsum_pieces m d P B (fun i => F i '' S i) G hGc
      hGi hAm hAB hAdisj hGN g, hid]
    exact tsum_congr fun i => hpiece i g
  -- Step 7: the Bochner identity, from the lintegral identity along the embedding `G|_B`
  refine ⟨hGrect B hBD hBrect, fun K hK hKD => ?_, J, hJm, hJ0, hgram, hlint,
    Submission.codim1_lura_integral_image_of_lintegral d P (μHE[m]) (μHE[m]) B G J hB hGc hGi hJm
      hJ0 hlint⟩
  -- `Hᵐ(G(B ∩ K)) ≤ Lᵐ Hᵐ(B ∩ K) < ∞`, `G` being `L`-Lipschitz on `K`
  obtain ⟨L, hL⟩ := hGlip K hK hKD
  exact ne_top_of_le_ne_top
    (ENNReal.mul_ne_top (ENNReal.pow_ne_top ENNReal.coe_ne_top) (hBfin K hK hKD))
    (Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn m
      (hL.mono inter_subset_right))

/-- **A cone regular with density one off the vertex is a multiplicity-one oriented cone**
(Simon 7.3.1(2), 7.4.1; Ch. 6, 2.11, 2.23, 3.1).  Let `C ∈ 𝒟ₘ(ℝᴾ)`, `m ≥ 1`, be an integer
multiplicity cone such that every `y ∈ spt C \ {0}` lies in `reg C` with `Θᵐ(μ_C, y) = 1`.  Then
`M = spt C \ {0}` is an embedded `C¹` submanifold, invariant under dilations, of locally finite
`Hᵐ`-measure, with an orientation `ξ` such that `C(ω) = ∫_M ⟨ω, ξ⟩ dHᵐ` for every `ω ∈ 𝒟ᵐ(ℝᴾ)`.
The multiplicity-one pieces `M ∩ B_y` (`y ∈ M`, radius `≤ |y|/2`) glue to an orientation of `M`;
a partition of unity gives the representation away from `0`, and the vertex is negligible since
`C` is integer multiplicity and `m ≥ 1`. -/
theorem Submission.codim1_cone_offvertex_unit_multiplicity_rep : ∀ (P m : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) m), 1 ≤ m → IsIntegerMultiplicity C → IsConeCurrent C → (∀ y ∈ C.support, y ≠ 0 → y ∈ regularSet C ∧ HasMassDensity C y 1) → ∃ ξ : Euclid P → MultiVector P m, IsEmbeddedSubmanifold 1 m (C.support \ {0}) ∧ IsOrientation m (C.support \ {0}) ξ ∧ (∀ t : ℝ, 0 < t → ∀ x ∈ C.support \ {0}, t • x ∈ C.support \ {0}) ∧ (∀ K : Set (Euclid P), IsCompact K → μHE[m] ((C.support \ {0}) ∩ K) ≠ ∞) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) m, C ω = ∫ x in C.support \ {0}, ξ x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m] := by
  intro P m C hm hIM hcone hreg
  set M : Set (Euclid P) := C.support \ {0}
  -- `spt C` is closed (the complement of the open zero region), so `M` is Borel
  have hsuppC : IsClosed C.support := by
    have h : C.support = (C.zeroRegion)ᶜ := by
      ext x; simp [GeometricCurrentOn.support]
    rw [h]; exact C.isOpen_zeroRegion.isClosed_compl
  have hMmeas : MeasurableSet M := hsuppC.measurableSet.diff (measurableSet_singleton 0)
  have h0M : (0 : Euclid P) ∉ M := fun h => h.2 (mem_singleton 0)
  -- local multiplicity-one pieces `spt C ∩ B_y`, with radius `≤ |y|/2`
  have hloc : ∀ y : Euclid P, ∃ (r : ℝ) (ξ : Euclid P → MultiVector P m), y ∈ M →
      0 < r ∧ r ≤ ‖y‖ / 2 ∧ IsEmbeddedSubmanifold 1 m (C.support ∩ ball y r) ∧
      IsOrientation m (C.support ∩ ball y r) ξ ∧ μHE[m] (C.support ∩ ball y r) ≠ ∞ ∧
      ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
        tsupport (ω : DifferentialForm (Euclid P) m) ⊆ ball y r →
        C ω = ∫ x in C.support ∩ ball y r, ξ x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m] := by
    intro y
    by_cases hy : y ∈ M
    · obtain ⟨hyS, hy0⟩ := hy
      have hy0' : y ≠ 0 := fun h => hy0 (by rw [h]; exact mem_singleton 0)
      obtain ⟨hyreg, hyden⟩ := hreg y hyS hy0'
      obtain ⟨ρ₀, hρ₀, -, hρ⟩ :=
        Submission.codim1_density_one_regular_local_rep P m univ C y hm isOpen_univ hyreg hyden
      have hny : 0 < ‖y‖ := norm_pos_iff.2 hy0'
      have hrpos : 0 < min ρ₀ (‖y‖ / 2) := lt_min hρ₀ (by linarith)
      obtain ⟨ξ, h1, h2, h3, h4⟩ := hρ (min ρ₀ (‖y‖ / 2)) hrpos (min_le_left _ _)
      exact ⟨min ρ₀ (‖y‖ / 2), ξ, fun _ => ⟨hrpos, min_le_right _ _, h1, h2, h3, h4⟩⟩
    · exact ⟨1, 0, fun h => absurd h hy⟩
  choose ρ ξs hρξ using hloc
  -- `0 ∉ B_y`, so `spt C ∩ B_y = M ∩ B_y`
  have hSeq : ∀ y ∈ M, C.support ∩ ball y (ρ y) = M ∩ ball y (ρ y) := by
    intro y hy
    obtain ⟨hρpos, hρle, -⟩ := hρξ y hy
    ext x
    constructor
    · rintro ⟨hxS, hxB⟩
      refine ⟨⟨hxS, fun hx0 => ?_⟩, hxB⟩
      rw [mem_singleton_iff] at hx0
      subst hx0
      rw [mem_ball, dist_zero_left] at hxB
      linarith [norm_nonneg y]
    · rintro ⟨⟨hxS, -⟩, hxB⟩
      exact ⟨hxS, hxB⟩
  have hlocM : ∀ y ∈ M, 0 < ρ y ∧ IsEmbeddedSubmanifold 1 m (M ∩ ball y (ρ y)) ∧
      IsOrientation m (M ∩ ball y (ρ y)) (ξs y) ∧ μHE[m] (M ∩ ball y (ρ y)) ≠ ∞ ∧
      ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
        tsupport (ω : DifferentialForm (Euclid P) m) ⊆ ball y (ρ y) →
        C ω = ∫ x in M ∩ ball y (ρ y), ξs y x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m] := by
    intro y hy
    obtain ⟨hρpos, -, h1, h2, h3, h4⟩ := hρξ y hy
    rw [hSeq y hy] at h1 h2 h3 h4
    exact ⟨hρpos, h1, h2, h3, h4⟩
  -- `M` is an embedded `C¹` submanifold
  have hMsub : IsEmbeddedSubmanifold 1 m M :=
    (Submission.codim1_ovr_embedded_submanifold_local P 1 m M le_rfl (fun y hy =>
      ⟨ball y (ρ y), isOpen_ball, mem_ball_self (hlocM y hy).1, (hlocM y hy).2.1⟩)).1
  -- a global orientation `ξ` of `M` representing `C` on every ball `B_y`
  obtain ⟨ξ, hξor, -, hξrep⟩ := Submission.codim1_ovr_orientation_glue P m C M ρ ξs hMsub hMmeas
    (fun y hy => ⟨(hlocM y hy).1, (hlocM y hy).2.2.1, (hlocM y hy).2.2.2.1, (hlocM y hy).2.2.2.2⟩)
  -- `M` is invariant under dilations
  have hconeM : ∀ t : ℝ, 0 < t → ∀ x ∈ M, t • x ∈ M := by
    intro t ht x hx
    refine ⟨Submission.codim1_ovr_cone_support_smul P m C hcone t ht x hx.1, fun h => hx.2 ?_⟩
    rw [mem_singleton_iff] at h ⊢
    exact (smul_eq_zero.1 h).resolve_left ht.ne'
  -- `Hᵐ(M ∩ K) < ∞` for compact `K`
  have hclos : closure M ⊆ insert 0 M := by
    intro x hx
    have hxS : x ∈ C.support := closure_minimal sdiff_subset hsuppC hx
    by_cases hx0 : x = 0
    · exact Or.inl hx0
    · exact Or.inr ⟨hxS, fun h => hx0 (mem_singleton_iff.1 h)⟩
  have hfin : ∀ K : Set (Euclid P), IsCompact K → μHE[m] (M ∩ K) ≠ ∞ :=
    Submission.codim1_ovr_cone_locally_finite_measure P m M hm h0M hclos hconeM (fun y hy =>
      ⟨ball y (ρ y), isOpen_ball, mem_ball_self (hlocM y hy).1, (hlocM y hy).2.2.2.1⟩)
  -- `|⟨α, ξ(x)⟩| ≤ |α|` on `M`
  obtain ⟨L, hL⟩ := Submission.dor_ims_unitOrientation_dual P m
  have hbound : ∀ x ∈ M, ∀ α : Covector (Euclid P) m, |ξ x α| ≤ covectorEuclideanNorm α := by
    intro x hx α
    obtain ⟨Q, -, hQ⟩ := hξor.2 x hx
    exact (hL (ξ x) Q hQ).1 α
  -- the representation for test forms supported away from the vertex: near a point of `M` use
  -- `B_y`; off `spt C` both sides vanish
  have hoff : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
      (0 : Euclid P) ∉ tsupport (ω : DifferentialForm (Euclid P) m) →
      C ω = ∫ x in M, ξ x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m] := by
    intro ω hω
    refine Submission.codim1_ovr_partition_glue_rep P m C M {0}ᶜ ξ isOpen_compl_singleton hMmeas
      hξor.1 hbound hfin ?_ ω (subset_compl_singleton_iff.2 hω)
    intro x hx
    by_cases hxS : x ∈ C.support
    · have hxM : x ∈ M := ⟨hxS, hx⟩
      exact ⟨ball x (ρ x), isOpen_ball, mem_ball_self (hlocM x hxM).1, hξrep x hxM⟩
    · refine ⟨C.supportᶜ, hsuppC.isOpen_compl, hxS, fun η hη => ?_⟩
      rw [Submission.dtc_vanish_off_support P m univ C η (subset_compl_iff_disjoint_right.1 hη)]
      symm
      refine setIntegral_eq_zero_of_forall_eq_zero fun z hz => ?_
      have hzη : z ∉ tsupport (η : DifferentialForm (Euclid P) m) := fun h => hη h hz.1
      rw [image_eq_zero_of_notMem_tsupport hzη, map_zero]
  -- the vertex is negligible, so the representation holds for every test form
  have hrep := Submission.codim1_ovr_extend_rep_across_vertex P m C M ξ hm hIM hMmeas h0M hξor.1
    hbound hfin hoff
  exact ⟨ξ, hMsub, hξor, hconeM, hfin, hrep⟩
/-- **Area comparison from minimality** (Simon 7.1.1; Appendix B, the competitors `(id + tZ)_#C`
for `H^n(M_t) ≥ H^n(M_0)`).  Let `K = spt Z ⊆ V` and choose an open `W ⊇ K` with `closure W` a
compact subset of `V`, so `H^m(M ∩ W) < ∞`.  For `|t| < t₀`, `Φ = id + tZ` is a bi-Lipschitz
`C^∞` bijection with injective derivative, `Φ = id` off `K` and `Φ(K) ⊆ K`.  The push-forward
`S = Φ_#C`, `S(ω) = C(Φ^#ω)`, has `∂S = 0`.  For `D₁ = [[M ∩ W]]` and `D₂ = Φ_#[[M ∩ W]]`
(integer multiplicity), `S − C = D₂ − D₁`, because `Φ^#ω − ω` vanishes off `K ⊆ W` and `C = [[M]]`
on forms supported in `V`.  Hence `S = C − (D₁ − D₂)` is integer multiplicity, `∂S = ∂C`, and
`spt(S − C) ⊆ K`.  Minimality and `S = D₂` on forms supported in `W` give
`H^m(M ∩ W) ≤ M_W(C) ≤ M_W(S) ≤ M_W(D₂) ≤ H^m(Φ(M ∩ W))`.  Finally `Φ(M ∩ W) ∩ K = Φ(M ∩ K)` and
`Φ(M ∩ W) \ K = (M ∩ W) \ K`; cancelling the finite measure of `(M ∩ W) \ K` gives the claim. -/
theorem Submission.codim1_minimizing_piece_area_comparison : ∀ (P m : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) m) (V M : Set (Euclid P)) (ξ : Euclid P → MultiVector P m), 1 ≤ m → IsMinimizingIn C univ → BoundaryVanishes C → IsOpen V → M ⊆ V → IsEmbeddedSubmanifold 1 m M → IsOrientation m M ξ → (∀ K : Set (Euclid P), IsCompact K → K ⊆ V → μHE[m] (M ∩ K) ≠ ∞) → (∀ ω : TestFormOn (univ : Set (Euclid P)) m, tsupport (ω : DifferentialForm (Euclid P) m) ⊆ V → C ω = ∫ x in M, ξ x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m]) → (∀ W : Set (Euclid P), IsOpen W → W ⊆ V → μHE[m] (M ∩ W) ≠ ∞ → μHE[m] (M ∩ W) ≤ C.massOn W) → ∀ Z : Euclid P → Euclid P, ContDiff ℝ (⊤ : ℕ∞) Z → HasCompactSupport Z → tsupport Z ⊆ V → ∃ t₀ : ℝ, 0 < t₀ ∧ ∀ t : ℝ, |t| < t₀ → μHE[m] (M ∩ tsupport Z) ≤ μHE[m] ((fun x => x + t • Z x) '' (M ∩ tsupport Z)) := by
  intro P m C V M ξ hm hmin hbdry hV _hMV hM hξ hLF hRep hmass Z hZ hZc hZV
  -- currents with `∂ = 0` have the same boundary (vacuous in degree `0`)
  have hsame : ∀ {n : ℕ} (A B : GeometricCurrentOn (univ : Set (Euclid P)) n),
      BoundaryVanishes A → BoundaryVanishes B → SameBoundary A B := by
    intro n A B hA hB
    cases n with
    | zero => trivial
    | succ k => exact (hA : A.boundary = 0).trans (hB : B.boundary = 0).symm
  -- Step 1: `K = spt Z` is compact; an open `W ⊇ K` with `closure W` a compact subset of `V`
  set K : Set (Euclid P) := tsupport Z
  have hKc : IsCompact K := hZc.isCompact
  have hKm : MeasurableSet K := hKc.isClosed.measurableSet
  obtain ⟨W, hW, hKW, hWV', hWc⟩ := exists_open_between_and_isCompact_closure hKc hV hZV
  have hWV : W ⊆ V := subset_closure.trans hWV'
  have hMW : μHE[m] (M ∩ W) ≠ ∞ := ne_top_of_le_ne_top (hLF _ hWc hWV')
    (measure_mono (inter_subset_inter_right M subset_closure))
  -- integrals over `M` of functions vanishing off `W` are integrals over `M ∩ W`
  have hloc : ∀ g : Euclid P → ℝ, (∀ x, x ∉ W → g x = 0) →
      ∫ x in M, g x ∂μHE[m] = ∫ x in M ∩ W, g x ∂μHE[m] := by
    intro g hg
    rw [inter_comm, ← Measure.restrict_restrict hW.measurableSet,
      setIntegral_eq_integral_of_forall_compl_eq_zero hg]
  -- Step 2: `Φ = id + tZ` is a bi-Lipschitz bijection with injective derivative for `|t| < t₀`
  have hZ1 : ContDiff ℝ 1 Z := hZ.of_le (by exact_mod_cast le_top)
  obtain ⟨t₀, ht₀, hpert⟩ := Submission.codim1_ac_perturbation_diffeo P Z hZ1 hZc
  refine ⟨t₀, ht₀, fun t ht => ?_⟩
  obtain ⟨hbij, hDΦ, Λ, hlip, hanti⟩ := hpert t ht
  set Φ : Euclid P → Euclid P := fun x => x + t • Z x
  have hΦsm : ContDiff ℝ (⊤ : ℕ∞) Φ := contDiff_id.add (hZ.const_smul t)
  have hΦ1 : ContDiff ℝ 1 Φ := contDiff_id.add (hZ1.const_smul t)
  -- `Φ = id` off `K`, so `DΦ = I` off `K`; `Φ(K) ⊆ K` since `Φ` is injective
  have hΦid : ∀ x, x ∉ K → Φ x = x := fun x hx => by
    show x + t • Z x = x
    rw [image_eq_zero_of_notMem_tsupport hx, smul_zero, add_zero]
  have hDΦid : ∀ x, x ∉ K → fderiv ℝ Φ x = ContinuousLinearMap.id ℝ (Euclid P) := by
    intro x hx
    have h : Φ =ᶠ[𝓝 x] id := eventually_of_mem (hKc.isClosed.isOpen_compl.mem_nhds hx) hΦid
    rw [h.fderiv_eq, fderiv_id]
  have hΦK : ∀ x ∈ K, Φ x ∈ K := by
    intro x hx
    by_contra h
    have hx' : Φ x = x := hbij.injective (hΦid (Φ x) h)
    rw [hx'] at h
    exact h hx
  -- Step 3: the pull-back `Φ^#ω = ω(Φ) ∘ DΦ` of a test form is a test form
  obtain ⟨pb, hpb⟩ : ∃ pb : TestFormOn (univ : Set (Euclid P)) m →
      TestFormOn (univ : Set (Euclid P)) m, ∀ ω, (pb ω : DifferentialForm (Euclid P) m) =
        fun x => ((ω : DifferentialForm (Euclid P) m) (Φ x)).compContinuousLinearMap
          (fderiv ℝ Φ x) :=
    ⟨fun ω => ⟨fun x => ((ω : DifferentialForm (Euclid P) m) (Φ x)).compContinuousLinearMap
        (fderiv ℝ Φ x), (Submission.dpf_pb_smooth_pullback_isTestForm P m K Φ
          (ω : DifferentialForm (Euclid P) m) hKc hΦsm hΦid ω.property.1).1, subset_univ _⟩,
      fun ω => rfl⟩
  -- `Φ^#ω = ω` off `K`, and everywhere when `ω` vanishes on `K`
  have hpb_off : ∀ ω x, x ∉ K →
      (pb ω : DifferentialForm (Euclid P) m) x = (ω : DifferentialForm (Euclid P) m) x := by
    intro ω x hx
    simp only [hpb]
    rw [hΦid x hx, hDΦid x hx]
    ext v
    simp
  have hpb_eq : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
      (∀ y ∈ K, (ω : DifferentialForm (Euclid P) m) y = 0) → pb ω = ω := by
    intro ω hω
    refine Subtype.ext (funext fun x => ?_)
    by_cases hx : x ∈ K
    · simp only [hpb]
      rw [hω _ (hΦK x hx), hω x hx]
      ext v
      simp
    · exact hpb_off ω x hx
  -- Step 4: the competitor `S = Φ_#C`, with `S(ω) = C(Φ^#ω)` and `∂S = 0`
  obtain ⟨R, hR⟩ := hmin.1
  obtain ⟨S, hS⟩ := Submission.dpf_pushforward_formula_current_exists P m univ K R Φ hKc
    (subset_univ K) hΦ1 hΦid
  have hSC : ∀ ω, S ω = C (pb ω) := by
    intro ω
    rw [hS ω, hR (pb ω), IMRep.action, hpb ω]
  have hSb : BoundaryVanishes S := Submission.dpf_pushforward_formula_boundaryVanishes P m univ K
    C S R Φ isOpen_univ hR hKc (subset_univ K) hΦ1 hΦid hS hbdry
  -- Step 5: `D₁ = [[M ∩ W]]` and `D₂ = Φ_#[[M ∩ W]]`, integer multiplicity currents
  obtain ⟨D₁, hD₁im, hD₁, -⟩ := Submission.codim1_ac_oriented_piece_pushforward P m M W ξ id 1 hm
    hM hξ hW hMW contDiff_id bijective_id
    (fun x => by rw [fderiv_id, ContinuousLinearMap.coe_id']; exact injective_id)
    LipschitzWith.id AntilipschitzWith.id
  obtain ⟨D₂, hD₂im, hD₂, hD₂mass⟩ := Submission.codim1_ac_oriented_piece_pushforward P m M W ξ Φ
    Λ hm hM hξ hW hMW hΦ1 hbij hDΦ hlip hanti
  have hD₁' : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
      Integrable (fun x => ξ x ((ω : DifferentialForm (Euclid P) m) x))
        (μHE[m].restrict (M ∩ W)) ∧
      D₁ ω = ∫ x in M ∩ W, ξ x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m] := by
    intro ω
    have hid : ∀ x, ((ω : DifferentialForm (Euclid P) m) (id x)).compContinuousLinearMap
        (fderiv ℝ id x) = (ω : DifferentialForm (Euclid P) m) x := by
      intro x
      rw [fderiv_id]
      ext v
      simp
    simpa only [hid] using hD₁ ω
  -- Step 6: `S − C = D₂ − D₁`: `Φ^#ω − ω` vanishes off `K ⊆ W ⊆ V`, where `C = [[M]]`
  have key : ∀ ω : TestFormOn (univ : Set (Euclid P)) m, S ω - C ω = D₂ ω - D₁ ω := by
    intro ω
    set β : TestFormOn (univ : Set (Euclid P)) m := pb ω - ω with hβ_def
    have hβ : ∀ x, (β : DifferentialForm (Euclid P) m) x =
        ((ω : DifferentialForm (Euclid P) m) (Φ x)).compContinuousLinearMap (fderiv ℝ Φ x) -
          (ω : DifferentialForm (Euclid P) m) x := by
      intro x
      rw [hβ_def, Submodule.coe_sub, Pi.sub_apply, hpb ω]
    have hβK : ∀ x, x ∉ K → (β : DifferentialForm (Euclid P) m) x = 0 := by
      intro x hx
      rw [hβ_def, Submodule.coe_sub, Pi.sub_apply, hpb_off ω x hx, sub_self]
    have hβs : tsupport (β : DifferentialForm (Euclid P) m) ⊆ K :=
      closure_minimal (fun x hx => by_contra fun hxK => hx (hβK x hxK)) hKc.isClosed
    calc S ω - C ω = C β := by rw [hSC ω, hβ_def]; exact (map_sub C.toCurrent (pb ω) ω).symm
      _ = ∫ x in M, ξ x ((β : DifferentialForm (Euclid P) m) x) ∂μHE[m] :=
          hRep β (hβs.trans hZV)
      _ = ∫ x in M ∩ W, ξ x ((β : DifferentialForm (Euclid P) m) x) ∂μHE[m] :=
          hloc _ fun x hx => by simp only [hβK x fun hxK => hx (hKW hxK), map_zero]
      _ = ∫ x in M ∩ W, (ξ x (((ω : DifferentialForm (Euclid P) m) (Φ x)).compContinuousLinearMap
            (fderiv ℝ Φ x)) - ξ x ((ω : DifferentialForm (Euclid P) m) x)) ∂μHE[m] := by
          congr 1
          ext x
          rw [hβ x, map_sub]
      _ = D₂ ω - D₁ ω := by
          rw [integral_sub (hD₂ ω).1 (hD₁' ω).1, (hD₂ ω).2, (hD₁' ω).2]
  -- Step 7: `S = C − (D₁ − D₂)` is integer multiplicity, `∂S = ∂C`, `spt(S − C) ⊆ K`
  have hSim : IsIntegerMultiplicity S := by
    have hSeq : S = C - (D₁ - D₂) := GeometricCurrentOn.ext fun ω => by
      show S ω = C ω - (D₁ ω - D₂ ω)
      linarith [key ω]
    rw [hSeq]
    exact Submission.regcomp_integer_multiplicity_sub P m univ C (D₁ - D₂) isOpen_univ hmin.1
      (Submission.regcomp_integer_multiplicity_sub P m univ D₁ D₂ isOpen_univ hD₁im hD₂im)
  have hvan : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
      tsupport (ω : DifferentialForm (Euclid P) m) ⊆ Kᶜ → (S - C) ω = 0 := by
    intro ω hω
    have h := hpb_eq ω fun y hy => image_eq_zero_of_notMem_tsupport fun h => hω h hy
    show S ω - C ω = 0
    rw [hSC ω, h, sub_self]
  have hsuppK : (S - C).support ⊆ K := by
    intro x hx
    by_contra hxK
    obtain ⟨r, hr, hrK⟩ := Metric.isOpen_iff.mp hKc.isClosed.isOpen_compl x hxK
    exact hx.2 (mem_sUnion.mpr ⟨ball x r, ⟨isOpen_ball,
      (isCompact_closedBall x r).of_isClosed_subset isClosed_closure closure_ball_subset_closedBall,
      subset_univ _, fun ω hω => hvan ω (hω.trans hrK)⟩, mem_ball_self hr⟩)
  -- minimality of `C` against `S`
  have hCS : C.massOn W ≤ S.massOn W :=
    hmin.2 W S hW ⟨hWc, subset_univ _⟩ hSim (hsame S C hSb hbdry)
      (hKc.of_isClosed_subset (isClosed_univ.sdiff (S - C).isOpen_zeroRegion) hsuppK)
      fun x hx => ⟨mem_univ x, hKW (hsuppK hx)⟩
  -- Step 8: `M_W(S) ≤ M_W(D₂) ≤ H^m(Φ(M ∩ W))`, since `C = D₁` on forms supported in `W`
  have hSmass : S.massOn W ≤ μHE[m] (Φ '' (M ∩ W)) := by
    refine sSup_le ?_
    rintro r ⟨ω, hω, rfl⟩
    have hCD : C ω = D₁ ω := by
      rw [hRep ω (hω.1.trans hWV), (hD₁' ω).2]
      exact hloc _ fun x hx => by
        simp only [image_eq_zero_of_notMem_tsupport fun h => hx (hω.1 h), map_zero]
    have hSD : S ω = D₂ ω := by linarith [key ω]
    show ENNReal.ofReal (S ω) ≤ _
    rw [hSD]
    exact (D₂.le_massOn hω).trans ((hD₂mass W).trans (measure_mono inter_subset_left))
  -- Step 9: cancel the finite common part `(M ∩ W) \ K`, using `Φ = id` off `K`, `Φ(K) ⊆ K`
  have himK : Φ '' (M ∩ W) ∩ K = Φ '' (M ∩ K) := by
    ext y
    constructor
    · rintro ⟨⟨x, ⟨hxM, -⟩, rfl⟩, hy⟩
      refine ⟨x, ⟨hxM, ?_⟩, rfl⟩
      by_contra hx
      rw [hΦid x hx] at hy
      exact hx hy
    · rintro ⟨x, ⟨hxM, hxK⟩, rfl⟩
      exact ⟨⟨x, ⟨hxM, hKW hxK⟩, rfl⟩, hΦK x hxK⟩
  have himW : Φ '' (M ∩ W) \ K = (M ∩ W) \ K := by
    ext y
    constructor
    · rintro ⟨⟨x, hx, rfl⟩, hy⟩
      have hxK : x ∉ K := fun hxK => hy (hΦK x hxK)
      rw [hΦid x hxK]
      exact ⟨hx, hxK⟩
    · rintro ⟨hy, hyK⟩
      exact ⟨⟨y, hy, hΦid y hyK⟩, hyK⟩
  have hb : μHE[m] ((M ∩ W) \ K) ≠ ∞ := ne_top_of_le_ne_top hMW (measure_mono sdiff_subset)
  have h1 := measure_inter_add_sdiff (μ := μHE[m]) (M ∩ W) hKm
  have h2 := measure_inter_add_sdiff (μ := μHE[m]) (Φ '' (M ∩ W)) hKm
  rw [inter_assoc, inter_eq_right.mpr hKW] at h1
  rw [himK, himW] at h2
  refine ENNReal.le_of_add_le_add_right hb ?_
  rw [h1, h2]
  exact ((hmass W hW hWV hMW).trans hCS).trans hSmass
/-- **Tangent projections of an embedded `C¹` submanifold** (Simon Ch. 2, §4, (4.1)–(4.3)).  Let
`M ⊆ ℝᴾ` be an embedded `C¹` `m`-dimensional submanifold, `S_x = span T_xM` and `P_x` the
orthogonal projection onto `S_x`.  Then (a) `dim S_x = m` on `M`, (b) `x ↦ P_x` is continuous on
`M`, and (c) `x ↦ trace(P_x ∘ DX(x))` is continuous on `M` for every `C¹` field `X`.  For a chart
`(V, W, ψ)`, `S_{ψ(v)} = Dψ(v)(ℝᵐ)` by `dsmc_chart_tangentSpace_eq_range`, and for injective `D`
the projection onto `D(ℝᵐ)` is `D (D*D)⁻¹ D*`, continuous in `v` since `Dψ` is continuous and
inversion is continuous at units.  Continuity of `ψ⁻¹` on `W ∩ M` moves this to `x = ψ(v)`; (c)
follows as the trace is linear on the finite-dimensional space `L(ℝᴾ)`. -/
theorem Submission.codim1_hcp_fv_tangent_projection_continuousOn : ∀ (P m : ℕ) (M : Set (Euclid P)), IsEmbeddedSubmanifold 1 m M → (∀ x ∈ M, Module.finrank ℝ (Submodule.span ℝ (tangentSpace M x)) = m) ∧ ContinuousOn (fun x => (Submodule.span ℝ (tangentSpace M x)).starProjection) M ∧ ∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → ContinuousOn (fun x => LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ X x).toLinearMap)) M := by
  intro P m M hM
  -- step 1: the span of the range of a continuous linear map is its range
  have hspan_range : ∀ D : Euclid m →L[ℝ] Euclid P,
      Submodule.span ℝ (Set.range D) = LinearMap.range (D : Euclid m →ₗ[ℝ] Euclid P) := by
    intro D
    rw [← ContinuousLinearMap.coe_coe, ← LinearMap.coe_range, Submodule.span_eq]
  -- step 2: for injective `D`, `G = D*D` is a unit and `P_{range D} = D G⁻¹ D*`
  have hproj : ∀ D : Euclid m →L[ℝ] Euclid P, Injective D →
      IsUnit (ContinuousLinearMap.adjoint D ∘L D) ∧
      (LinearMap.range (D : Euclid m →ₗ[ℝ] Euclid P)).starProjection =
        D ∘L (Ring.inverse (ContinuousLinearMap.adjoint D ∘L D) ∘L ContinuousLinearMap.adjoint D) := by
    intro D hD
    set G := ContinuousLinearMap.adjoint D ∘L D
    -- (a) `Gw = 0` gives `|Dw|² = ⟨Gw, w⟩ = 0`, so `w = 0`; injective endomorphisms are units
    have hGinj : Injective G := by
      rw [injective_iff_map_eq_zero]
      intro w hw
      apply hD
      rw [map_zero]
      have hnorm : ‖D w‖ ^ 2 = 0 := by
        rw [← real_inner_self_eq_norm_sq, ← ContinuousLinearMap.adjoint_inner_left]
        change inner ℝ (G w) w = 0
        rw [hw, inner_zero_left]
      exact norm_eq_zero.mp (pow_eq_zero_iff two_ne_zero |>.mp hnorm)
    have hGunit : IsUnit G := ContinuousLinearMap.isUnit_iff_bijective.mpr
      ⟨hGinj, (LinearMap.injective_iff_surjective (f := (G : Euclid m →ₗ[ℝ] Euclid m))).mp hGinj⟩
    refine ⟨hGunit, ?_⟩
    -- (b) with `y = G⁻¹D*h`, `Dy ∈ range D` and `h - Dy ⊥ range D`, so `P h = Dy`
    ext1 h
    set y := Ring.inverse G (ContinuousLinearMap.adjoint D h)
    have hGy : G y = ContinuousLinearMap.adjoint D h := by
      rw [← mul_apply_eq_comp, Ring.mul_inverse_cancel _ hGunit, one_apply_eq_self]
    change _ = D y
    refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero
      (LinearMap.mem_range_self (D : Euclid m →ₗ[ℝ] Euclid P) y) ?_
    rintro _ ⟨x, rfl⟩
    rw [ContinuousLinearMap.coe_coe, ← ContinuousLinearMap.adjoint_inner_left, map_sub]
    change inner ℝ (_ - G y) x = 0
    rw [hGy, sub_self, inner_zero_left]
  -- step 3: chart data at `y ∈ M`: `span T_{ψ v}M = range Dψ(v)` and `ψ⁻¹` is continuous
  have hlocal : ∀ y ∈ M, ∃ (V : Set (Euclid m)) (W : Set (Euclid P)) (ψ : Euclid m → Euclid P),
      IsOpen V ∧ IsOpen W ∧ y ∈ W ∧ ContDiffOn ℝ 1 ψ V ∧ ψ '' V = W ∩ M ∧
      (∀ z ∈ V, Injective (fderiv ℝ ψ z)) ∧
      (∀ v ∈ V, Submodule.span ℝ (tangentSpace M (ψ v)) =
        LinearMap.range (fderiv ℝ ψ v : Euclid m →ₗ[ℝ] Euclid P)) ∧
      (∀ v ∈ V, ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧
        ∀ v' ∈ V, dist (ψ v') (ψ v) < δ → dist v' v < ε) := by
    intro y hy
    obtain ⟨V, W, ψ, hV, hW, hyW, hψ, hinj, himg, hprop, hder⟩ := hM y hy
    refine ⟨V, W, ψ, hV, hW, hyW, hψ, himg, hder, fun v hv => ?_, fun v hv => ?_⟩
    · have h := (Submission.dsmc_chart_tangentSpace_eq_range P 1 m M V W ψ le_rfl hV hW hψ hinj
        himg hprop hder v hv).1
      rw [h, hspan_range]
    · exact (Submission.dsmc_chart_tangentSpace_eq_range P 1 m M V W ψ le_rfl hV hW hψ hinj
        himg hprop hder v hv).2.1
  -- step 4, (a): `S_{ψ v} = range Dψ(v)` with `Dψ(v)` injective has dimension `m`
  have hfin : ∀ x ∈ M, Module.finrank ℝ (Submodule.span ℝ (tangentSpace M x)) = m := by
    intro x hx
    obtain ⟨V, W, ψ, hV, hW, hxW, hψ, himg, hder, hsp, -⟩ := hlocal x hx
    obtain ⟨v, hv, rfl⟩ : x ∈ ψ '' V := by rw [himg]; exact ⟨hxW, hx⟩
    rw [hsp v hv, LinearMap.finrank_range_of_inj (hder v hv), finrank_euclideanSpace_fin]
  -- step 5, (b): `x ↦ P_x` is continuous within `M` at every `y = ψ(v₀)`
  have hcont : ContinuousOn (fun x => (Submodule.span ℝ (tangentSpace M x)).starProjection) M := by
    intro y hy
    obtain ⟨V, W, ψ, hV, hW, hyW, hψ, himg, hder, hsp, hinv⟩ := hlocal y hy
    obtain ⟨v₀, hv₀, rfl⟩ : y ∈ ψ '' V := by rw [himg]; exact ⟨hyW, hy⟩
    -- (a) `v ↦ D(v)`, `v ↦ D(v)*` and `v ↦ G(v) = D(v)*D(v)` are continuous on `V`
    have hD : ContinuousOn (fun v => fderiv ℝ ψ v) V := hψ.continuousOn_fderiv_of_isOpen hV le_rfl
    have hadj : Continuous (fun A : Euclid m →L[ℝ] Euclid P => ContinuousLinearMap.adjoint A) :=
      (ContinuousLinearMap.adjoint (𝕜 := ℝ) (E := Euclid m) (F := Euclid P)).continuous
    have hDt : ContinuousOn (fun v => ContinuousLinearMap.adjoint (fderiv ℝ ψ v)) V :=
      hadj.comp_continuousOn hD
    have hG : ContinuousOn
        (fun v => ContinuousLinearMap.adjoint (fderiv ℝ ψ v) ∘L fderiv ℝ ψ v) V :=
      hDt.clm_comp hD
    -- (b) each `G(v)` is a unit and inversion is continuous at units, so `R(v)` is continuous
    have hGinv : ContinuousOn (fun v =>
        Ring.inverse (ContinuousLinearMap.adjoint (fderiv ℝ ψ v) ∘L fderiv ℝ ψ v)) V := by
      intro v hv
      obtain ⟨u, hu⟩ := (hproj _ (hder v hv)).1
      have hinvc := NormedRing.inverse_continuousAt u
      rw [hu] at hinvc
      exact hinvc.comp_continuousWithinAt
        (f := fun v => ContinuousLinearMap.adjoint (fderiv ℝ ψ v) ∘L fderiv ℝ ψ v) (hG v hv)
    have hR : ContinuousOn (fun v => fderiv ℝ ψ v ∘L (Ring.inverse
        (ContinuousLinearMap.adjoint (fderiv ℝ ψ v) ∘L fderiv ℝ ψ v) ∘L
          ContinuousLinearMap.adjoint (fderiv ℝ ψ v))) V :=
      hD.clm_comp (hGinv.clm_comp hDt)
    -- (c) `P_{ψ v} = R(v)` on `V`
    have hPR : ∀ v ∈ V, (Submodule.span ℝ (tangentSpace M (ψ v))).starProjection =
        fderiv ℝ ψ v ∘L (Ring.inverse (ContinuousLinearMap.adjoint (fderiv ℝ ψ v) ∘L
          fderiv ℝ ψ v) ∘L ContinuousLinearMap.adjoint (fderiv ℝ ψ v)) := by
      intro v hv
      rw [← (hproj _ (hder v hv)).2]
      congr 1
      exact hsp v hv
    -- (d) `x ∈ M` near `ψ v₀` is `ψ v` with `v ∈ V` near `v₀`, so `P_x` is near `P_{ψ v₀}`
    rw [Metric.continuousWithinAt_iff]
    intro ε hε
    have hRat : ContinuousAt (fun v => fderiv ℝ ψ v ∘L (Ring.inverse
        (ContinuousLinearMap.adjoint (fderiv ℝ ψ v) ∘L fderiv ℝ ψ v) ∘L
          ContinuousLinearMap.adjoint (fderiv ℝ ψ v))) v₀ :=
      hR.continuousAt (hV.mem_nhds hv₀)
    obtain ⟨ρ, hρ, hρR⟩ := Metric.continuousAt_iff.mp hRat ε hε
    obtain ⟨δ₁, hδ₁, hδ₁inv⟩ := hinv v₀ hv₀ ρ hρ
    obtain ⟨δ₂, hδ₂, hδ₂W⟩ := Metric.isOpen_iff.mp hW (ψ v₀) hyW
    refine ⟨min δ₁ δ₂, lt_min hδ₁ hδ₂, fun {x} hxM hxy => ?_⟩
    have hxW : x ∈ W := hδ₂W (lt_of_lt_of_le hxy (min_le_right _ _))
    obtain ⟨v, hv, rfl⟩ : x ∈ ψ '' V := by rw [himg]; exact ⟨hxW, hxM⟩
    have hvv : dist v v₀ < ρ := hδ₁inv v hv (lt_of_lt_of_le hxy (min_le_left _ _))
    rw [hPR v hv, hPR v₀ hv₀]
    exact hρR hvv
  -- step 6, (c): `T ↦ trace T` is linear on `L(ℝᴾ)`, hence continuous; compose with `P_x ∘ DX(x)`
  refine ⟨hfin, hcont, fun X hX => ?_⟩
  have htr : Continuous (fun T : Euclid P →L[ℝ] Euclid P =>
      LinearMap.trace ℝ (Euclid P) (T : Euclid P →ₗ[ℝ] Euclid P)) :=
    LinearMap.continuous_of_finiteDimensional
      ((LinearMap.trace ℝ (Euclid P)).comp (ContinuousLinearMap.coeLM ℝ))
  have hcomp : ContinuousOn (fun x =>
      (Submodule.span ℝ (tangentSpace M x)).starProjection ∘L fderiv ℝ X x) M :=
    hcont.clm_comp (hX.continuous_fderiv one_ne_zero).continuousOn
  refine (htr.comp_continuousOn hcomp).congr fun x _ => ?_
  simp

/-- **Simon Ch. 2, (4.18)–(4.20)** (trace bound for a projected linear map): for a subspace `K` of
`ℝᴾ` and a continuous linear `L`, `|trace(p_K ∘ L)| ≤ (dim K) ‖L‖`.  For an orthonormal basis
`τ₁, …, τₙ` of `K`, `trace(p_K ∘ L) = Σₐ τₐ · Lτₐ`, and `|τₐ · Lτₐ| ≤ |τₐ| |Lτₐ| ≤ ‖L‖` by
Cauchy–Schwarz. -/
theorem Submission.codim1_hcp_fv_trace_comp_abs_le : ∀ (P : ℕ) (K : Submodule ℝ (Euclid P)) (L : Euclid P →L[ℝ] Euclid P), |LinearMap.trace ℝ (Euclid P) (K.starProjection.toLinearMap ∘ₗ L.toLinearMap)| ≤ (Module.finrank ℝ K : ℝ) * ‖L‖ := by
  intro P K L
  -- step 1: the standard orthonormal basis `e` of `K`, as vectors of `ℝᴾ`, is orthonormal
  set e := stdOrthonormalBasis ℝ K
  have hon : Orthonormal ℝ (fun i => ((e i : K) : Euclid P)) :=
    e.orthonormal.comp_linearIsometry K.subtypeₗᵢ
  -- step 2: it spans `K`, the image of `span (range e) = ⊤` under the inclusion
  have hspan : Submodule.span ℝ (Set.range (fun i => ((e i : K) : Euclid P))) = K := by
    have h : Set.range (fun i => ((e i : K) : Euclid P)) = K.subtype '' Set.range e := by
      rw [← Set.range_comp]; rfl
    have htop : Submodule.span ℝ (Set.range e) = ⊤ := by
      simpa using e.toBasis.span_eq
    rw [h, Submodule.span_image, htop, Submodule.map_top, Submodule.range_subtype]
  -- step 3: `trace(p_K ∘ L) = Σₐ ⟪τₐ, Lτₐ⟫`
  rw [Submission.fvmb_trace_starProjection_comp_eq_sum_inner P (Module.finrank ℝ K) K _ L hon hspan]
  -- steps 4-5: triangle inequality, then `|⟪τₐ, Lτₐ⟫| ≤ ‖τₐ‖ ‖L‖ ‖τₐ‖ = ‖L‖` termwise
  calc |∑ a, inner ℝ ((e a : K) : Euclid P) (L ((e a : K) : Euclid P))|
      ≤ ∑ a, |inner ℝ ((e a : K) : Euclid P) (L ((e a : K) : Euclid P))| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _a : Fin (Module.finrank ℝ K), ‖L‖ := by
        refine Finset.sum_le_sum fun a _ => ?_
        refine (abs_real_inner_le_norm _ _).trans ?_
        rw [hon.1 a, one_mul]
        exact (L.le_opNorm _).trans (by rw [hon.1 a, mul_one])
    _ = (Module.finrank ℝ K : ℝ) * ‖L‖ := by simp

/-- **Simon Ch. 2, §5** (the expansion `J_t = 1 + t div_M X + O(t²)` behind the first variation
formula 5.3, for the linear map `I + tB` on an `n`-plane): given `P`, `n`, `A ≥ 0` and `ε > 0`
there is `δ > 0` such that for `|t| < δ`, every subspace `K ⊆ ℝᴾ` with `dim K = n` and every `B`
with `‖B‖ ≤ A`, `(det(((I + tB) ∘ ι_K)* ((I + tB) ∘ ι_K)))^{1/2} ≤ 1 + t trace(p_K ∘ B) + ε|t|`.
In an orthonormal basis `e` of `K` the matrix of `((I + tB) ∘ ι_K)* ((I + tB) ∘ ι_K)` is the Gram
matrix `((I + tB)eᵢ · (I + tB)eⱼ)`, so the orthonormal-frame first-order bound applies with
`L = I + tB` (`‖L − I − tB‖ = 0`), and `Σₐ eₐ · Beₐ = trace(p_K ∘ B)` by the frame trace formula. -/
theorem Submission.codim1_hcp_fv_subspace_jacobian_first_order : ∀ (P n : ℕ) (A ε : ℝ), 0 ≤ A → 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ t : ℝ, |t| < δ → ∀ (K : Submodule ℝ (Euclid P)) (B : Euclid P →L[ℝ] Euclid P), Module.finrank ℝ K = n → ‖B‖ ≤ A → Real.sqrt ((((ContinuousLinearMap.id ℝ (Euclid P) + t • B).comp K.subtypeL).adjoint ∘L ((ContinuousLinearMap.id ℝ (Euclid P) + t • B).comp K.subtypeL)).det) ≤ 1 + t * LinearMap.trace ℝ (Euclid P) (K.starProjection.toLinearMap ∘ₗ B.toLinearMap) + ε * |t| := by
  intro P n A ε hA hε
  -- step 1: `η` and `δ` of the orthonormal-frame bound depend only on `P`, `n`, `A` and `ε`
  obtain ⟨η, hη, δ, hδ, hgram⟩ :=
    Submission.fvmb_orthonormal_gram_sqrt_det_le_first_order P n A ε hA hε
  refine ⟨δ, hδ, fun t ht K B hK hB => ?_⟩
  -- step 3: the standard orthonormal basis `e` of `K` is an orthonormal frame of `ℝᴾ` spanning `K`
  subst hK
  set e := stdOrthonormalBasis ℝ K
  have hon : Orthonormal ℝ (fun i => ((e i : K) : Euclid P)) :=
    e.orthonormal.comp_linearIsometry K.subtypeₗᵢ
  have hspan : Submodule.span ℝ (Set.range (fun i => ((e i : K) : Euclid P))) = K := by
    have h : Set.range (fun i => ((e i : K) : Euclid P)) = K.subtype '' Set.range e := by
      rw [← Set.range_comp]; rfl
    have htop : Submodule.span ℝ (Set.range e) = ⊤ := by
      simpa using e.toBasis.span_eq
    rw [h, Submodule.span_image, htop, Submodule.map_top, Submodule.range_subtype]
  -- step 4: the determinant on `K` is the Gram determinant of the frame `(L eᵢ)`
  have hgramdet : ∀ L : Euclid P →L[ℝ] Euclid P,
      ((L.comp K.subtypeL).adjoint ∘L (L.comp K.subtypeL)).det =
        Matrix.det (Matrix.of fun i j => inner ℝ (L ((e i : K) : Euclid P))
          (L ((e j : K) : Euclid P))) := by
    intro L
    rw [ContinuousLinearMap.det, ← LinearMap.det_toMatrix e.toBasis]
    congr 1
    ext i j
    rw [LinearMap.toMatrix_apply, OrthonormalBasis.coe_toBasis_repr_apply,
      OrthonormalBasis.coe_toBasis, OrthonormalBasis.repr_apply_apply, Matrix.of_apply]
    rw [ContinuousLinearMap.coe_coe, ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.adjoint_inner_right]
    rfl
  -- steps 5-6: the frame bound for `L = I + tB`, where `‖L − I − tB‖ = 0`, and the frame trace
  rw [hgramdet, Submission.fvmb_trace_starProjection_comp_eq_sum_inner P _ K _ B hon hspan]
  refine hgram t ht B _ hB ?_ _ hon
  have : ContinuousLinearMap.id ℝ (Euclid P) + t • B - ContinuousLinearMap.id ℝ (Euclid P) -
      t • B = 0 := by abel
  rw [this, norm_zero]
  exact mul_nonneg hη.le (abs_nonneg t)

/-- Small deformations `x ↦ x + t • Z x` by a compactly supported `C¹` field `Z` are injective
immersions (the maps `φ_t` of Simon Ch. 2, 5.1–5.2).  `DZ` is continuous with compact support, so
`‖DZ‖ ≤ Λ` for some `Λ ≥ 0`, and `|t| < 1 / (Λ + 1)` gives `|t| Λ < 1`.  By the mean value
inequality `Z` is `Λ`-Lipschitz, so `a + t • Z a = b + t • Z b` forces `‖a - b‖ ≤ |t| Λ ‖a - b‖`,
i.e. `a = b`; in the same way the derivative `I + t • DZ(x)` is injective. -/
theorem Submission.codim1_hcp_fv_perturbation_injective : ∀ (P : ℕ) (Z : Euclid P → Euclid P), ContDiff ℝ 1 Z → HasCompactSupport Z → ∃ c : ℝ, 0 < c ∧ ∀ t : ℝ, |t| < c → Injective (fun x => x + t • Z x) ∧ ∀ x, Injective (fderiv ℝ (fun x => x + t • Z x) x) := by
  intro P Z hZ hZc
  have hdiff : Differentiable ℝ Z := hZ.differentiable one_ne_zero
  -- step 1: `DZ` is continuous with compact support, hence bounded by some `Λ ≥ 0`
  obtain ⟨Λ₀, hΛ₀⟩ := (hZ.continuous_fderiv one_ne_zero).bounded_above_of_compact_support
    (hZc.fderiv (𝕜 := ℝ))
  obtain ⟨Λ, hΛ0, hΛ⟩ : ∃ Λ : ℝ, 0 ≤ Λ ∧ ∀ x, ‖fderiv ℝ Z x‖ ≤ Λ :=
    ⟨max Λ₀ 0, le_max_right _ _, fun x => (hΛ₀ x).trans (le_max_left _ _)⟩
  -- step 2: `c = 1 / (Λ + 1)`, so `|t| < c` gives `|t| Λ < 1`
  refine ⟨1 / (Λ + 1), by positivity, fun t ht => ?_⟩
  have htΛ : |t| * Λ < 1 := by
    have h1 : |t| * (Λ + 1) < 1 := by
      rwa [lt_div_iff₀ (by positivity)] at ht
    nlinarith [abs_nonneg t]
  -- step 3: mean value inequality, `‖Z a - Z b‖ ≤ Λ ‖a - b‖`
  have hlip : ∀ a b, ‖Z a - Z b‖ ≤ Λ * ‖a - b‖ := fun a b =>
    convex_univ.norm_image_sub_le_of_norm_fderiv_le (fun x _ => hdiff x) (fun x _ => hΛ x)
      (Set.mem_univ b) (Set.mem_univ a)
  refine ⟨fun a b hab => ?_, fun x => ?_⟩
  · -- step 4: `a - b = t • (Z b - Z a)` gives `‖a - b‖ ≤ |t| Λ ‖a - b‖`, so `a = b`
    have hab' : a - b = t • Z b - t • Z a := by
      rw [sub_eq_sub_iff_add_eq_add, add_comm (t • Z b) b]; exact hab
    have hn : ‖a - b‖ ≤ |t| * Λ * ‖a - b‖ := by
      calc ‖a - b‖ = |t| * ‖Z b - Z a‖ := by
            rw [hab', ← smul_sub, norm_smul, Real.norm_eq_abs]
        _ ≤ |t| * (Λ * ‖b - a‖) := mul_le_mul_of_nonneg_left (hlip b a) (abs_nonneg t)
        _ = |t| * Λ * ‖a - b‖ := by rw [norm_sub_rev]; ring
    have h0 : ‖a - b‖ = 0 := by
      by_contra hne
      have hpos : 0 < ‖a - b‖ := lt_of_le_of_ne (norm_nonneg _) (Ne.symm hne)
      nlinarith
    exact sub_eq_zero.mp (norm_eq_zero.mp h0)
  · -- step 5: `D(x + t • Z x) = I + t • DZ(x)`, and `‖v - w‖ ≤ |t| Λ ‖v - w‖` as in step 4
    have hfd : fderiv ℝ (fun x => x + t • Z x) x =
        ContinuousLinearMap.id ℝ (Euclid P) + t • fderiv ℝ Z x :=
      ((hasFDerivAt_id x).add ((hdiff x).hasFDerivAt.const_smul t)).fderiv
    rw [hfd]
    intro v w hvw
    have hvw' : v - w = t • fderiv ℝ Z x w - t • fderiv ℝ Z x v := by
      rw [sub_eq_sub_iff_add_eq_add, add_comm (t • fderiv ℝ Z x w) w]; exact hvw
    have hn : ‖v - w‖ ≤ |t| * Λ * ‖v - w‖ := by
      calc ‖v - w‖ = |t| * ‖fderiv ℝ Z x (w - v)‖ := by
            conv_lhs => rw [hvw']
            rw [← smul_sub, ← map_sub, norm_smul, Real.norm_eq_abs]
        _ ≤ |t| * (Λ * ‖w - v‖) :=
          mul_le_mul_of_nonneg_left ((fderiv ℝ Z x).le_of_opNorm_le (hΛ x) (w - v))
            (abs_nonneg t)
        _ = |t| * Λ * ‖v - w‖ := by rw [norm_sub_rev]; ring
    have h0 : ‖v - w‖ = 0 := by
      by_contra hne
      have hpos : 0 < ‖v - w‖ := lt_of_le_of_ne (norm_nonneg _) (Ne.symm hne)
      nlinarith
    exact sub_eq_zero.mp (norm_eq_zero.mp h0)
/-- Simon Ch. 2, §5 (first variation, 5.1–5.3), in one-sided form: if `M` is an embedded `C¹`
`m`-submanifold, `Z` is `C¹` with compact support, `E = M ∩ spt Z` has `Hᵐ(E) < ∞`, and
`Hᵐ(E) ≤ ∫_E J_t dHᵐ` for `|t| < t₀`, where `J_t` is the Jacobian of `Φ_t = id + tZ` along
`span T_xM`, then `∫_M div_M Z dHᵐ = 0`.  Instead of differentiating under the integral sign:
`J_t ≤ 1 + t div_M Z + ε|t|` uniformly on `E` for small `|t|`, so monotonicity of the lower
integral gives `0 ≤ t ∫_E div_M Z + ε|t| Hᵐ(E)`; `t = ±T/2` and `ε → 0` give
`∫_E div_M Z = 0`, and `div_M Z = 0` off `spt Z`. -/
theorem Submission.codim1_hcp_fv_jacobian_minimal_stationary : ∀ (P m : ℕ) (M : Set (Euclid P)) (Z : Euclid P → Euclid P), IsEmbeddedSubmanifold 1 m M → ContDiff ℝ 1 Z → HasCompactSupport Z → μHE[m] (M ∩ tsupport Z) ≠ ∞ → (∃ t₀ : ℝ, 0 < t₀ ∧ ∀ t : ℝ, |t| < t₀ → μHE[m] (M ∩ tsupport Z) ≤ ∫⁻ x in M ∩ tsupport Z, ENNReal.ofReal (Real.sqrt ((((fderiv ℝ (fun y => y + t • Z y) x).comp (Submodule.span ℝ (tangentSpace M x)).subtypeL).adjoint ∘L ((fderiv ℝ (fun y => y + t • Z y) x).comp (Submodule.span ℝ (tangentSpace M x)).subtypeL)).det)) ∂μHE[m]) → ∫ x in M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ Z x).toLinearMap) ∂μHE[m] = 0 := by
  intro P m M Z hM hZ hZc hfin ⟨t₀, ht₀, hmin⟩
  set τ : Euclid P → ℝ := fun x => LinearMap.trace ℝ (Euclid P)
    ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
      (fderiv ℝ Z x).toLinearMap) with hτ_def
  have hMmeas : MeasurableSet M := (Submission.dimred_rpd_embedded_locally_closed P 1 m M hM).1
  have hEmeas : MeasurableSet (M ∩ tsupport Z) := hMmeas.inter (isClosed_tsupport Z).measurableSet
  obtain ⟨hfr, -, hdivc⟩ := Submission.codim1_hcp_fv_tangent_projection_continuousOn P m M hM
  have hdiff : Differentiable ℝ Z := hZ.differentiable one_ne_zero
  obtain ⟨Λ₀, hΛ₀⟩ := (hZ.continuous_fderiv one_ne_zero).bounded_above_of_compact_support
    (hZc.fderiv (𝕜 := ℝ))
  set Λ := max Λ₀ 0 with hΛ_def
  have hΛ : ∀ x, ‖fderiv ℝ Z x‖ ≤ Λ := fun x => (hΛ₀ x).trans (le_max_left _ _)
  have hΛ0 : 0 ≤ Λ := le_max_right _ _
  -- |div_M Z| ≤ mΛ on M
  have hτb : ∀ x ∈ M, |τ x| ≤ m * Λ := by
    intro x hx
    have h := Submission.codim1_hcp_fv_trace_comp_abs_le P (Submodule.span ℝ (tangentSpace M x))
      (fderiv ℝ Z x)
    rw [hfr x hx] at h
    exact h.trans (mul_le_mul_of_nonneg_left (hΛ x) (Nat.cast_nonneg m))
  -- measurability and integrability of div_M Z on E = M ∩ tsupport Z
  have hτmeas : AEStronglyMeasurable τ (μHE[m].restrict M) :=
    (hdivc Z hZ).aestronglyMeasurable hMmeas
  have hτmeasE : AEStronglyMeasurable τ (μHE[m].restrict (M ∩ tsupport Z)) :=
    hτmeas.mono_measure (Measure.restrict_mono inter_subset_left le_rfl)
  have hτint : IntegrableOn τ (M ∩ tsupport Z) μHE[m] :=
    IntegrableOn.of_bound hfin.lt_top hτmeasE (m * Λ)
      (ae_restrict_of_forall_mem hEmeas fun x hx => by
        rw [Real.norm_eq_abs]; exact hτb x hx.1)
  -- derivative of the deformation Φ_t = id + tZ
  have hfd : ∀ (t : ℝ) (x : Euclid P), fderiv ℝ (fun y => y + t • Z y) x =
      ContinuousLinearMap.id ℝ (Euclid P) + t • fderiv ℝ Z x := fun t x =>
    ((hasFDerivAt_id x).add ((hdiff x).hasFDerivAt.const_smul t)).fderiv
  set a := (μHE[m] (M ∩ tsupport Z)).toReal with ha_def
  have ha0 : 0 ≤ a := ENNReal.toReal_nonneg
  set I := ∫ x in M ∩ tsupport Z, τ x ∂μHE[m] with hI_def
  -- one-sided first-order inequality: 0 ≤ t I + ε |t| a for small |t|
  have key : ∀ ε : ℝ, 0 < ε → ∃ T : ℝ, 0 < T ∧ ∀ t : ℝ, |t| < T → 0 ≤ t * I + ε * |t| * a := by
    intro ε hε
    obtain ⟨δ, hδ, hJ⟩ := Submission.codim1_hcp_fv_subspace_jacobian_first_order P m Λ ε hΛ0 hε
    refine ⟨min t₀ (min δ (1 / (m * Λ + 1))), lt_min ht₀ (lt_min hδ (by positivity)),
      fun t ht => ?_⟩
    have ht₀' : |t| < t₀ := lt_of_lt_of_le ht (min_le_left _ _)
    have htδ : |t| < δ := lt_of_lt_of_le ht ((min_le_right _ _).trans (min_le_left _ _))
    have htc : |t| < 1 / (m * Λ + 1) :=
      lt_of_lt_of_le ht ((min_le_right _ _).trans (min_le_right _ _))
    have htmΛ : |t| * (m * Λ) ≤ 1 := by
      have hpos : 0 < (m : ℝ) * Λ + 1 := by positivity
      rw [lt_div_iff₀ hpos] at htc
      nlinarith [abs_nonneg t, mul_nonneg (Nat.cast_nonneg m : (0:ℝ) ≤ m) hΛ0]
    have hnn : ∀ x ∈ M ∩ tsupport Z, 0 ≤ 1 + t * τ x + ε * |t| := by
      intro x hx
      have h1 : |t * τ x| ≤ 1 := by
        rw [abs_mul]
        exact (mul_le_mul_of_nonneg_left (hτb x hx.1) (abs_nonneg t)).trans htmΛ
      have h2 : -1 ≤ t * τ x := (abs_le.mp h1).1
      nlinarith [abs_nonneg t]
    have hpt : ∀ x ∈ M ∩ tsupport Z,
        ENNReal.ofReal (Real.sqrt ((((fderiv ℝ (fun y => y + t • Z y) x).comp
          (Submodule.span ℝ (tangentSpace M x)).subtypeL).adjoint ∘L
            ((fderiv ℝ (fun y => y + t • Z y) x).comp
              (Submodule.span ℝ (tangentSpace M x)).subtypeL)).det)) ≤
          ENNReal.ofReal (1 + t * τ x + ε * |t|) := by
      intro x hx
      apply ENNReal.ofReal_le_ofReal
      rw [hfd t x]
      exact hJ t htδ _ _ (hfr x hx.1) (hΛ x)
    have hc : IntegrableOn (fun _ : Euclid P => (1 : ℝ)) (M ∩ tsupport Z) μHE[m] :=
      integrableOn_const hfin
    have hc' : IntegrableOn (fun _ : Euclid P => ε * |t|) (M ∩ tsupport Z) μHE[m] :=
      integrableOn_const hfin
    have hint : IntegrableOn (fun x => 1 + t * τ x + ε * |t|) (M ∩ tsupport Z) μHE[m] :=
      (hc.add (hτint.const_mul t)).add hc'
    have h2 := (hmin t ht₀').trans (setLIntegral_mono' hEmeas hpt)
    rw [← ofReal_integral_eq_lintegral_ofReal hint (ae_restrict_of_forall_mem hEmeas hnn)] at h2
    have hcalc : ∫ x in M ∩ tsupport Z, (1 + t * τ x + ε * |t|) ∂μHE[m] =
        a + t * I + ε * |t| * a := by
      have e1 : ∫ x in M ∩ tsupport Z, (1 + t * τ x + ε * |t|) ∂μHE[m] =
          ∫ x in M ∩ tsupport Z, (1 + t * τ x) ∂μHE[m] +
            ∫ x in M ∩ tsupport Z, ε * |t| ∂μHE[m] :=
        integral_add (hc.add (hτint.const_mul t)) hc'
      have e2 : ∫ x in M ∩ tsupport Z, (1 + t * τ x) ∂μHE[m] =
          ∫ x in M ∩ tsupport Z, (1 : ℝ) ∂μHE[m] + ∫ x in M ∩ tsupport Z, t * τ x ∂μHE[m] :=
        integral_add hc (hτint.const_mul t)
      rw [e1, e2, integral_const_mul, setIntegral_const, setIntegral_const]
      simp only [smul_eq_mul, Measure.real, ha_def, hI_def]
      ring
    rw [hcalc] at h2
    have hrhs : 0 ≤ a + t * I + ε * |t| * a := by
      rw [← hcalc]
      exact setIntegral_nonneg hEmeas hnn
    rw [← ENNReal.ofReal_toReal hfin, ENNReal.ofReal_le_ofReal_iff hrhs] at h2
    linarith
  -- Fermat: |I| ≤ ε a for every ε > 0, hence I = 0
  have hI0 : I = 0 := by
    have hbound : ∀ ε : ℝ, 0 < ε → |I| ≤ ε * a := by
      intro ε hε
      obtain ⟨T, hT, hTI⟩ := key ε hε
      have hpos := hTI (T / 2) (by rw [abs_of_pos (by positivity)]; linarith)
      have hneg := hTI (-(T / 2)) (by rw [abs_neg, abs_of_pos (by positivity)]; linarith)
      rw [abs_of_pos (by positivity : (0:ℝ) < T / 2)] at hpos
      rw [abs_neg, abs_of_pos (by positivity : (0:ℝ) < T / 2)] at hneg
      have h1 : -(ε * a) ≤ I := by nlinarith
      have h2 : I ≤ ε * a := by nlinarith
      exact abs_le.mpr ⟨h1, h2⟩
    by_contra hne
    have hIpos : 0 < |I| := abs_pos.mpr hne
    have := hbound (|I| / (2 * (a + 1))) (by positivity)
    have hlt : |I| / (2 * (a + 1)) * a < |I| := by
      rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
      nlinarith
    linarith
  -- div_M Z vanishes on M \ tsupport Z, so ∫_M = ∫_{M ∩ tsupport Z}
  have hzero : ∀ x ∈ M \ (M ∩ tsupport Z), τ x = 0 := by
    intro x hx
    have hxs : x ∉ tsupport Z := fun h => hx.2 ⟨hx.1, h⟩
    have hD : fderiv ℝ Z x = 0 := by
      by_contra hne
      exact hxs (support_fderiv_subset ℝ hne)
    simp only [hτ_def, hD, ContinuousLinearMap.toLinearMap_zero, LinearMap.comp_zero, map_zero]
  rw [setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hMmeas inter_subset_left hzero]
  exact hI0
/-- Simon Ch. 2, §5 (p. 63), stationarity tested with `C¹` fields: if `M` is an embedded `C¹`
`m`-submanifold with `Hᵐ(M ∩ K) < ∞` for compact `K ⊆ U` and `∫_M div_M Z dHᵐ = 0` for every `C^∞`
field `Z` with compact support in `U`, then the same holds for every `C¹` such field `X`.  The `C^∞`
maps `ψₖ → id + X` of `dpf_smooth_approx_compact_perturbation` equal `id` off one compact `K' ⊆ U`,
so `Xₖ = ψₖ − id` are admissible, `‖DXₖ‖ ≤ C + 1`, `DXₖ = 0` off `K'` and `DXₖ → DX` pointwise.
With `dim T_xM = m`, `|div_M Xₖ| ≤ m(C + 1)·1_{K'}`, which is `Hᵐ⌞M`-integrable, so dominated
convergence gives `∫_M div_M X = lim ∫_M div_M Xₖ = 0`. -/
theorem Submission.codim1_hcp_fv_smooth_to_C1_stationary : ∀ (P m : ℕ) (U M : Set (Euclid P)), IsOpen U → IsEmbeddedSubmanifold 1 m M → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[m] (M ∩ K) ≠ ∞) → (∀ Z : Euclid P → Euclid P, ContDiff ℝ (⊤ : ℕ∞) Z → HasCompactSupport Z → tsupport Z ⊆ U → ∫ x in M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ Z x).toLinearMap) ∂μHE[m] = 0) → ∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ U → ∫ x in M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ X x).toLinearMap) ∂μHE[m] = 0 := by
  intro P m U M hU hM hfin hsmooth X hX hXc hXU
  -- Step 1: `M` is Borel, `dim T_xM = m` on `M`, and `div_M Y` is continuous on `M` for `C¹` `Y`
  have hMmeas : MeasurableSet M := (Submission.dimred_rpd_embedded_locally_closed P 1 m M hM).1
  obtain ⟨hfr, -, hdivc⟩ := Submission.codim1_hcp_fv_tangent_projection_continuousOn P m M hM
  -- Step 2: `C^∞` maps `ψ k` equal to `id` off one compact `K' ⊆ U`, with `‖Dψ k‖ ≤ C` and
  -- `Dψ k → D(id + X)` pointwise
  obtain ⟨ψ, K', C, hK', hK'U, hψs, hψid, hψC, -, hψD⟩ :=
    Submission.dpf_smooth_approx_compact_perturbation P U (tsupport X) (fun x => x + X x) hU hXc
      hXU (contDiff_id.add hX) (fun x hx => by simp [image_eq_zero_of_notMem_tsupport hx])
  -- Step 3: the `C^∞` fields `Xk k = ψ k - id` vanish off `K'`, so `∫_M div_M (Xk k) = 0`
  set Xk : ℕ → Euclid P → Euclid P := fun k x => ψ k x - x
  have hXks : ∀ k, ContDiff ℝ (⊤ : ℕ∞) (Xk k) := fun k => (hψs k).sub contDiff_id
  have hXk0 : ∀ k x, x ∉ K' → Xk k x = 0 := fun k x hx => by simp [Xk, hψid k x hx]
  have hXkts : ∀ k, tsupport (Xk k) ⊆ K' := fun k =>
    closure_minimal (support_subset_iff'.2 (hXk0 k)) hK'.isClosed
  have hstat : ∀ k, ∫ x in M, LinearMap.trace ℝ (Euclid P)
      ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
        (fderiv ℝ (Xk k) x).toLinearMap) ∂μHE[m] = 0 := fun k =>
    hsmooth (Xk k) (hXks k) (HasCompactSupport.intro hK' (hXk0 k)) ((hXkts k).trans hK'U)
  -- Step 4: `D(Xk k) = Dψ k - I`, so `‖D(Xk k)‖ ≤ C + 1`, `D(Xk k) → DX` and `D(Xk k) = 0` off `K'`
  have hψd : ∀ k, Differentiable ℝ (ψ k) := fun k => (hψs k).differentiable (by simp)
  have hDXk : ∀ k x, fderiv ℝ (Xk k) x = fderiv ℝ (ψ k) x - ContinuousLinearMap.id ℝ (Euclid P) :=
    fun k x => ((hψd k x).hasFDerivAt.sub (hasFDerivAt_id x)).fderiv
  have hDφ : ∀ x, fderiv ℝ (fun x => x + X x) x =
      ContinuousLinearMap.id ℝ (Euclid P) + fderiv ℝ X x :=
    fun x => ((hasFDerivAt_id x).add ((hX.differentiable one_ne_zero) x).hasFDerivAt).fderiv
  have hconv : ∀ x, Tendsto (fun k => fderiv ℝ (Xk k) x) atTop (𝓝 (fderiv ℝ X x)) := by
    intro x
    have h := (hψD x).sub_const (ContinuousLinearMap.id ℝ (Euclid P))
    rw [hDφ x, add_sub_cancel_left] at h
    simpa only [hDXk] using h
  have hDXkb : ∀ k x, ‖fderiv ℝ (Xk k) x‖ ≤ C + 1 := by
    intro k x
    rw [hDXk]
    exact (norm_sub_le _ _).trans (add_le_add (hψC k x) ContinuousLinearMap.norm_id_le)
  have hDXk0 : ∀ k x, x ∉ K' → fderiv ℝ (Xk k) x = 0 := fun k x hx =>
    fderiv_of_notMem_tsupport ℝ fun h => hx (hXkts k h)
  -- Step 5: the dominating function `g = m (C + 1) 1_{K'}` is integrable, `Hᵐ(M ∩ K') < ∞`
  set g : Euclid P → ℝ := K'.indicator (fun _ => (m : ℝ) * (C + 1)) with hg_def
  have hg : Integrable g (μHE[m].restrict M) := by
    rw [hg_def, integrable_indicator_iff hK'.isClosed.measurableSet]
    refine integrableOn_const ?_
    rw [Measure.restrict_apply hK'.isClosed.measurableSet, inter_comm]
    exact hfin K' hK' hK'U
  -- `|div_M (Xk k)| ≤ dim T_xM ‖D(Xk k)‖ ≤ m (C + 1)` on `M ∩ K'`, and `div_M (Xk k) = 0` off `K'`
  have hbound : ∀ k, ∀ᵐ x ∂(μHE[m].restrict M), ‖LinearMap.trace ℝ (Euclid P)
      ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
        (fderiv ℝ (Xk k) x).toLinearMap)‖ ≤ g x := by
    intro k
    filter_upwards [ae_restrict_mem hMmeas] with x hx
    by_cases hxK : x ∈ K'
    · rw [hg_def, indicator_of_mem hxK, Real.norm_eq_abs]
      have h := Submission.codim1_hcp_fv_trace_comp_abs_le P
        (Submodule.span ℝ (tangentSpace M x)) (fderiv ℝ (Xk k) x)
      rw [hfr x hx] at h
      exact h.trans (mul_le_mul_of_nonneg_left (hDXkb k x) (Nat.cast_nonneg m))
    · rw [hg_def, indicator_of_notMem hxK, hDXk0 k x hxK]
      simp
  -- Step 6: `div_M (Xk k) → div_M X` pointwise, `L ↦ trace (P_x ∘ L)` being linear on a
  -- finite-dimensional space
  have hlim : ∀ᵐ x ∂(μHE[m].restrict M), Tendsto (fun k => LinearMap.trace ℝ (Euclid P)
      ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
        (fderiv ℝ (Xk k) x).toLinearMap)) atTop
      (𝓝 (LinearMap.trace ℝ (Euclid P)
        ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
          (fderiv ℝ X x).toLinearMap))) := by
    refine Eventually.of_forall fun x => ?_
    have htr : Continuous (fun T : Euclid P →L[ℝ] Euclid P =>
        LinearMap.trace ℝ (Euclid P) (T : Euclid P →ₗ[ℝ] Euclid P)) :=
      LinearMap.continuous_of_finiteDimensional
        ((LinearMap.trace ℝ (Euclid P)).comp (ContinuousLinearMap.coeLM ℝ))
    have hF : Continuous (fun L : Euclid P →L[ℝ] Euclid P => LinearMap.trace ℝ (Euclid P)
        ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ L.toLinearMap)) := by
      have := htr.comp (Continuous.clm_comp
        (g := fun _ : Euclid P →L[ℝ] Euclid P =>
          (Submodule.span ℝ (tangentSpace M x)).starProjection)
        (f := id) continuous_const continuous_id)
      refine this.congr fun L => ?_
      simp only [Function.comp_apply, id]
      rfl
    exact (hF.tendsto _).comp (hconv x)
  -- Step 7: `div_M (Xk k)` is continuous on the Borel set `M`, hence measurable
  have hmeas : ∀ k, AEStronglyMeasurable (fun x => LinearMap.trace ℝ (Euclid P)
      ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
        (fderiv ℝ (Xk k) x).toLinearMap)) (μHE[m].restrict M) :=
    fun k => (hdivc (Xk k) ((hXks k).of_le (by exact_mod_cast le_top))).aestronglyMeasurable hMmeas
  -- Step 8: dominated convergence, `∫_M div_M X = lim ∫_M div_M (Xk k) = 0`
  have hT := tendsto_integral_of_dominated_convergence g hmeas hg hbound hlim
  simp only [hstat] at hT
  exact tendsto_nhds_unique hT tendsto_const_nhds

/-- **Area formula on an embedded `C¹` submanifold** (Simon Ch. 2, 4.11–4.13, as used in Ch. 2,
5.1–5.2).  Let `M ⊂ ℝᴾ` be an embedded `m`-dimensional `C¹` submanifold, `E ⊆ M` Borel, and
`Φ : ℝᴾ → ℝᴾ` a `C¹` map that is injective on `E` with `DΦ(x)` injective for `x ∈ E`.  Then
`Hᵐ(Φ(E)) = ∫_E J^M Φ dHᵐ`, where `J^M Φ(x) = √det((DΦ(x) ∘ ι_x)*(DΦ(x) ∘ ι_x))` and
`ι_x : span T_xM → ℝᴾ` is the inclusion.  By Lindelöf countably many charts `W_k` cover `M`; on
each of the disjoint Borel pieces `E_k = (E ∩ W_k) \ ⋃_{j<k} (E ∩ W_j)` this is the area formula
in one chart.  Summing over `k` gives the claim: the integral is countably additive over the
`E_k`, and so is `Hᵐ(Φ(·))`, since the images `Φ(E_k)` are Borel (Lusin–Souslin) and pairwise
disjoint (`Φ` is injective on `E`). -/
theorem Submission.codim1_hcp_submanifold_area_formula : ∀ (P m : ℕ) (M E : Set (Euclid P)) (Φ : Euclid P → Euclid P), IsEmbeddedSubmanifold 1 m M → MeasurableSet E → E ⊆ M → ContDiff ℝ 1 Φ → InjOn Φ E → (∀ x ∈ E, Injective (fderiv ℝ Φ x)) → μHE[m] (Φ '' E) = ∫⁻ x in E, ENNReal.ofReal (Real.sqrt ((((fderiv ℝ Φ x).comp (Submodule.span ℝ (tangentSpace M x)).subtypeL).adjoint ∘L ((fderiv ℝ Φ x).comp (Submodule.span ℝ (tangentSpace M x)).subtypeL)).det)) ∂μHE[m] := by
  intro P m M E Φ hM hE hEM hΦ hΦinj hDΦ
  -- step 2: countably many charts `(V_k, W_k, ψ_k)` of `M` as in (4.1) and pairwise disjoint
  -- Borel pieces `E_k ⊆ W_k ∩ M` with `⋃_k E_k = E`
  obtain ⟨Es, Vs, Ws, ψs, hEs, hdisj, hunion, hcharts⟩ : ∃ (Es : ℕ → Set (Euclid P)) (Vs : ℕ → Set (Euclid m)) (Ws : ℕ → Set (Euclid P)) (ψs : ℕ → Euclid m → Euclid P), (∀ k, MeasurableSet (Es k)) ∧ Pairwise (fun i j => Disjoint (Es i) (Es j)) ∧ (⋃ k, Es k) = E ∧ ∀ k, IsOpen (Vs k) ∧ IsOpen (Ws k) ∧ ContDiffOn ℝ 1 (ψs k) (Vs k) ∧ InjOn (ψs k) (Vs k) ∧ ψs k '' Vs k = Ws k ∩ M ∧ (∀ K ⊆ Ws k, IsCompact K → IsCompact (Vs k ∩ ψs k ⁻¹' K)) ∧ (∀ z ∈ Vs k, Injective (fderiv ℝ (ψs k) z)) ∧ Es k ⊆ Ws k ∩ M := by
    -- every `y ∈ M` has a chart `(V_y, W_y, ψ_y)` with `y ∈ W_y`; every `y ∉ M` gets the empty
    -- chart `(∅, ∅, 0)`, which satisfies all chart conditions
    have hchart : ∀ y : Euclid P, ∃ (V : Set (Euclid m)) (W : Set (Euclid P))
        (ψ : Euclid m → Euclid P), IsOpen V ∧ IsOpen W ∧ ContDiffOn ℝ 1 ψ V ∧ InjOn ψ V ∧
          ψ '' V = W ∩ M ∧ (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) ∧
          (∀ z ∈ V, Injective (fderiv ℝ ψ z)) ∧ (y ∈ M → y ∈ W) := by
      intro y
      by_cases hy : y ∈ M
      · obtain ⟨V, W, ψ, hV, hW, hyW, hψ, hinj, himg, hprop, hD⟩ := hM y hy
        exact ⟨V, W, ψ, hV, hW, by exact_mod_cast hψ, hinj, himg, hprop, hD, fun _ => hyW⟩
      · exact ⟨∅, ∅, 0, isOpen_empty, isOpen_empty, contDiffOn_empty, injOn_empty _, by simp,
          by simp, by simp, fun h => absurd h hy⟩
    choose V W ψ hV hW hψ hinj himg hprop hD hyW using hchart
    -- Lindelöf: the `W_y` with `y` in a countable set `T ⊆ {y_0, y_1, …}` already cover `M`
    obtain ⟨T, hTc, hTU⟩ := TopologicalSpace.isOpen_iUnion_countable W hW
    obtain ⟨f, hf⟩ := Set.countable_iff_exists_subset_range.1 hTc
    have hcover : M ⊆ ⋃ k, W (f k) := by
      intro y hy
      have hyT : y ∈ ⋃ i ∈ T, W i := by
        rw [hTU]
        exact mem_iUnion.2 ⟨y, hyW y hy⟩
      obtain ⟨i, hiT, hyi⟩ := mem_iUnion₂.1 hyT
      obtain ⟨k, rfl⟩ := hf hiT
      exact mem_iUnion.2 ⟨k, hyi⟩
    -- `E_k = (E ∩ W_{y_k}) \ ⋃_{j<k} (E ∩ W_{y_j})`, with the chart at `y_k`
    refine ⟨disjointed fun k => E ∩ W (f k), fun k => V (f k), fun k => W (f k),
      fun k => ψ (f k), MeasurableSet.disjointed fun k => hE.inter (hW (f k)).measurableSet,
      disjoint_disjointed _, ?_, fun k => ⟨hV (f k), hW (f k), hψ (f k), hinj (f k), himg (f k),
        hprop (f k), hD (f k), fun x hx => ?_⟩⟩
    -- `⋃_k E_k = E ∩ ⋃_k W_{y_k} = E`, as `E ⊆ M ⊆ ⋃_k W_{y_k}`
    · rw [iUnion_disjointed, ← inter_iUnion]
      exact inter_eq_left.2 (hEM.trans hcover)
    -- `E_k ⊆ E ∩ W_{y_k} ⊆ W_{y_k} ∩ M`
    · have hx' := disjointed_subset _ k hx
      exact ⟨hx'.2, hEM hx'.1⟩
  choose hV hW hψ hinj himg hprop hD hEW using hcharts
  have hEsE : ∀ k, Es k ⊆ E := fun k => (subset_iUnion Es k).trans hunion.subset
  -- steps 4–8 on each piece `E_k ⊆ W_k ∩ M`: the area formula inside the chart `ψ_k`
  have hpiece := fun k => Submission.codim1_hcp_af_chart_area_formula P m M (Es k) (Ws k) (Vs k)
    (ψs k) Φ (hV k) (hW k) (hψ k) (hinj k) (himg k) (hprop k) (hD k) (hEs k) (hEW k) hΦ
    (hΦinj.mono (hEsE k)) fun x hx => hDΦ x (hEsE k hx)
  -- step 9: the images `Φ(E_k)` are Borel (Lusin–Souslin) and pairwise disjoint (`Φ` is
  -- injective on `E`), so `Hᵐ(Φ(E)) = Σ_k Hᵐ(Φ(E_k))`; the integral over `E` splits likewise
  have hΦEs : ∀ k, MeasurableSet (Φ '' Es k) := fun k =>
    (hEs k).image_of_continuousOn_injOn hΦ.continuous.continuousOn (hΦinj.mono (hEsE k))
  have hΦdisj : Pairwise (Disjoint on fun k => Φ '' Es k) := fun i j hij =>
    (hdisj hij).image hΦinj (hEsE i) (hEsE j)
  rw [← hunion, image_iUnion, measure_iUnion hΦdisj hΦEs, lintegral_iUnion hEs hdisj]
  exact tsum_congr hpiece

/-- **Simon Ch. 2, §5 (5.1–5.4)**: a deformation-minimal `C¹` submanifold is stationary.  Let
`M ⊆ U` be an embedded `C¹` `m`-submanifold with `Hᵐ(M ∩ K) < ∞` for compact `K ⊆ U`, whose area
does not decrease under the deformations `x ↦ x + tZ(x)`, `Z` smooth with compact support in `U`.
Then `∫_M div_M X dHᵐ = 0` for every `C¹` field `X` with compact support in `U`.  By smooth
approximation of `X` it suffices to take `X = Z` smooth.  `E = M ∩ spt Z` is Borel with
`Hᵐ(E) < ∞`, and for small `|t|` the map `Φₜ = id + tZ` is `C¹`, injective and has injective
differential.  So the area formula turns `Hᵐ(E) ≤ Hᵐ(Φₜ(E))` into `Hᵐ(E) ≤ ∫_E Jₜ dHᵐ`, and the
first-order expansion of the Jacobian `Jₜ` at `t = 0` gives `∫_M div_M Z dHᵐ = 0`. -/
theorem Submission.codim1_hcp_deformation_minimal_stationary : ∀ (P m : ℕ) (U M : Set (Euclid P)), IsOpen U → M ⊆ U → IsEmbeddedSubmanifold 1 m M → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[m] (M ∩ K) ≠ ∞) → (∀ Z : Euclid P → Euclid P, ContDiff ℝ (⊤ : ℕ∞) Z → HasCompactSupport Z → tsupport Z ⊆ U → ∃ t₀ : ℝ, 0 < t₀ ∧ ∀ t : ℝ, |t| < t₀ → μHE[m] (M ∩ tsupport Z) ≤ μHE[m] ((fun x => x + t • Z x) '' (M ∩ tsupport Z))) → ∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ U → ∫ x in M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ X x).toLinearMap) ∂μHE[m] = 0 := by
  intro P m U M hU _ hM hfin hdef
  -- it suffices to prove `∫_M div_M Z dHᵐ = 0` for smooth `Z` with compact support in `U`
  refine Submission.codim1_hcp_fv_smooth_to_C1_stationary P m U M hU hM hfin
    fun Z hZ hZc hZU => ?_
  have hZ1 : ContDiff ℝ 1 Z := hZ.of_le (by exact_mod_cast le_top)
  -- `E = M ∩ spt Z` is Borel (`M` is) and `Hᵐ(E) < ∞` (`spt Z` is a compact subset of `U`)
  have hE : MeasurableSet (M ∩ tsupport Z) :=
    (Submission.dimred_rpd_embedded_locally_closed P 1 m M hM).1.inter
      (isClosed_tsupport Z).measurableSet
  refine Submission.codim1_hcp_fv_jacobian_minimal_stationary P m M Z hM hZ1 hZc
    (hfin _ hZc.isCompact hZU) ?_
  -- for `|t| < min(t₀, c)`, `Φₜ = id + tZ` is `C¹`, injective and has injective differential, so
  -- the area formula rewrites `Hᵐ(Φₜ(E))` as `∫_E Jₜ dHᵐ`
  obtain ⟨t₀, ht₀, hmin⟩ := hdef Z hZ hZc hZU
  obtain ⟨c, hc, hinj⟩ := Submission.codim1_hcp_fv_perturbation_injective P Z hZ1 hZc
  refine ⟨min t₀ c, lt_min ht₀ hc, fun t ht => ?_⟩
  obtain ⟨hΦ, hDΦ⟩ := hinj t (ht.trans_le (min_le_right t₀ c))
  exact (hmin t (ht.trans_le (min_le_left t₀ c))).trans_eq
    (Submission.codim1_hcp_submanifold_area_formula P m M (M ∩ tsupport Z) (fun x => x + t • Z x)
      hM hE inter_subset_left (contDiff_id.add (hZ1.const_smul t)) hΦ.injOn fun x _ => hDΦ x)

/-- **Higher regularity of stationary `C¹` submanifolds** (Simon Ch. 5, Theorem 7.1, last part,
with `N = ℝᴾ`).  Let `G` be the minimal surface operator of `codim1_hcp_sr_stationary_mss`
(`Δu = div G(Du)` weakly, `G(0) = 0`, `DG(0) = 0`; Simon Ch. 5, §1) in codimension `P - m`, and
`ε₀` the small-gradient threshold of the Schauder theory `codim1_hcp_sr_quasilinear_smooth` for
`G`.  Given `y ∈ M`, take `δ > 0` with `B_δ(y) ⊆ U` and a graph chart `F(a) = y + ι a + ι' (u a)`
of `M` over `T_yM` (`codim1_hcp_sr_graph_chart`) with `‖Du‖ ≤ ε₀` whose cylinder
`Z = {y + ι a + ι' b : ‖a‖ < s, ‖b‖ < t}` has `s + t ≤ δ`, so `Z ⊆ B_δ(y) ⊆ U`.  Stationarity of
`M` in `U` makes `u` a weak solution of `Δu = div G(Du)` on `B_s(0)`, hence `u` is `Cʳ` there for
every `r`, and `(B_s(0), Z, F)` is a `Cʳ` chart of `M` at `y`. -/
theorem Submission.codim1_hcp_stationary_c1_smooth : ∀ (P m : ℕ) (U M : Set (Euclid P)), 1 ≤ m → IsOpen U → M ⊆ U → IsEmbeddedSubmanifold 1 m M → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[m] (M ∩ K) ≠ ∞) → (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ U → ∫ x in M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ X x).toLinearMap) ∂μHE[m] = 0) → ∀ r : ℕ, IsEmbeddedSubmanifold r m M := by
  intro P m U M hm hU hMU hM hfin hstat r
  -- step 1: the minimal surface operator `G` and the Schauder threshold `ε₀` (codimension `P - m`)
  obtain ⟨G, hG, hG0, hDG0, hmss⟩ := Submission.codim1_hcp_sr_stationary_mss m (P - m) hm
  obtain ⟨ε₀, hε₀, hqs⟩ := Submission.codim1_hcp_sr_quasilinear_smooth m (P - m) G hm hG hG0 hDG0
  intro y hy
  -- step 2: a graph chart at `y` with slope `≤ ε₀` whose cylinder `Z` lies in `B_δ(y) ⊆ U`
  obtain ⟨δ, hδ, hδU⟩ := Metric.isOpen_iff.1 hU y (hMU hy)
  obtain ⟨ι, ι', horth, hspan, hchart⟩ := Submission.codim1_hcp_sr_graph_chart P m M y hm hM hy
  obtain ⟨s, t, u, hs, ht, hst, hu, -, hbd, hZ, hMZ, hinj, hDF, hprop⟩ := hchart ε₀ δ hε₀ hδ
  have hZU : {z : Euclid P | ∃ a ∈ ball (0 : Euclid m) s, ∃ b ∈ ball (0 : Euclid (P - m)) t,
      z = y + ι a + ι' b} ⊆ U := by
    rintro z ⟨a, ha, b, hb, rfl⟩
    rw [mem_ball_zero_iff] at ha hb
    apply hδU
    rw [mem_ball, dist_eq_norm, add_assoc, add_sub_cancel_left]
    calc ‖ι a + ι' b‖ ≤ ‖ι a‖ + ‖ι' b‖ := norm_add_le _ _
      _ = ‖a‖ + ‖b‖ := by rw [ι.norm_map, ι'.norm_map]
      _ < s + t := add_lt_add ha hb
      _ ≤ δ := hst
  -- step 3: stationarity gives `Δu = div G(Du)` weakly on `B_s(0)`; Schauder theory: `u ∈ Cʳ`
  have hweak := hmss P U M y ι ι' s t u horth hspan hs ht hU hZU hu (fun a ha => (hbd a ha).2) hMZ
    (fun a ha => (hDF a ha).2) hfin hstat
  have hur : ContDiffOn ℝ r u (ball 0 s) :=
    hqs (ball 0 s) u isOpen_ball hu (fun a ha => (hbd a ha).1) hweak r
  -- step 4: `(B_s(0), Z, a ↦ y + ι a + ι' (u a))` is a `Cʳ` chart of `M` at `y`
  refine ⟨ball 0 s, _, fun a => y + ι a + ι' (u a), isOpen_ball, hZ,
    ⟨0, mem_ball_self hs, 0, mem_ball_self ht, by simp⟩,
    (contDiffOn_const.add ι.contDiff.contDiffOn).add (ι'.contDiff.comp_contDiffOn hur), hinj,
    hMZ.symm.trans (inter_comm _ _), hprop, fun a ha => (hDF a ha).1⟩
/-- Hausdorff measure and lower integrals over Lipschitz images (Simon Ch. 2, Theorem 1.8(i)):
if `G : ℝᵐ → ℝᴾ` is `Λ`-Lipschitz on `D`, then `Hᵐ(G(N)) ≤ Λᵐ Lᵐ(N)` for every `N ⊆ D`, measurable
or not, and for Borel `D` and Borel `H ≥ 0`, `∫_{G(D)} H dHᵐ ≤ Λᵐ ∫_D H ∘ G dLᵐ`.  The first
bound is the `μH[m]` estimate for Lipschitz images scaled by the common normalizing constant of
`μHE[m]`, with `μHE[m] = Lᵐ` on `ℝᵐ`.  Applied to `N = G⁻¹(s) ∩ D` it gives
`Hᵐ⌞G(D) ≤ Λᵐ G₊(Lᵐ⌞D)` on Borel sets `s`; integrating `H` against this measure inequality and
changing variables gives the second bound.  Injectivity of `G` is not needed. -/
theorem Submission.codim1_hcp_lsa_lipschitz_image_lintegral_le : ∀ (m P : ℕ) (G : Euclid m → Euclid P) (D : Set (Euclid m)) (Λ : NNReal), LipschitzOnWith Λ G D → (∀ N ⊆ D, μHE[m] (G '' N) ≤ (Λ : ℝ≥0∞) ^ m * volume N) ∧ (MeasurableSet D → ∀ H : Euclid P → ℝ≥0∞, Measurable H → ∫⁻ x in G '' D, H x ∂μHE[m] ≤ (Λ : ℝ≥0∞) ^ m * ∫⁻ a in D, H (G a)) := by
  intro m P G D Λ hG
  -- part (a): `μH[m](G(N)) ≤ Λᵐ μH[m](N)`, scaled by the normalizing constant of `μHE[m]`
  have hset : ∀ N ⊆ D, μHE[m] (G '' N) ≤ (Λ : ℝ≥0∞) ^ m * volume N := by
    intro N hN
    have h := (hG.mono hN).hausdorffMeasure_image_le (d := (m : ℝ)) (Nat.cast_nonneg m)
    rw [ENNReal.rpow_natCast] at h
    rw [← EuclideanSpace.euclideanHausdorffMeasure_eq_volume m,
      Measure.euclideanHausdorffMeasure_def, Measure.euclideanHausdorffMeasure_def]
    simp only [Measure.smul_apply, ENNReal.smul_def, smul_eq_mul]
    calc _ ≤ _ := mul_le_mul_right h _
      _ = _ := by ring
  refine ⟨hset, fun hD H hH => ?_⟩
  -- part (b): the measure inequality `Hᵐ⌞G(D) ≤ Λᵐ G₊(Lᵐ⌞D)`, from (a) with `N = G⁻¹(s) ∩ D`
  have hGae : AEMeasurable G (volume.restrict D) := hG.continuousOn.aemeasurable hD
  have hle : μHE[m].restrict (G '' D) ≤ ((Λ : ℝ≥0∞) ^ m) • (volume.restrict D).map G := by
    refine Measure.le_iff.2 fun s hs => ?_
    rw [Measure.restrict_apply hs, Measure.smul_apply, Measure.map_apply_of_aemeasurable hGae hs,
      Measure.restrict_apply' hD, smul_eq_mul]
    calc μHE[m] (s ∩ G '' D) ≤ μHE[m] (G '' (G ⁻¹' s ∩ D)) := by
          refine measure_mono ?_
          rintro _ ⟨hy, a, ha, rfl⟩
          exact ⟨a, ⟨hy, ha⟩, rfl⟩
      _ ≤ (Λ : ℝ≥0∞) ^ m * volume (G ⁻¹' s ∩ D) := hset _ inter_subset_right
  -- integrate `H` against the measure inequality and change variables along `G`
  calc ∫⁻ x in G '' D, H x ∂μHE[m] ≤ ∫⁻ x, H x ∂(((Λ : ℝ≥0∞) ^ m) • (volume.restrict D).map G) :=
        lintegral_mono' hle le_rfl
    _ = (Λ : ℝ≥0∞) ^ m * ∫⁻ a in D, H (G a) := by
        rw [lintegral_smul_measure, lintegral_map' hH.aemeasurable hGae, smul_eq_mul]
/-- The tangent projection `x ↦ P_x` of an embedded `C¹` submanifold `M ⊆ ℝᴾ`, `P_x` the
orthogonal projection onto `span T_xM`, is continuous on `M`.  Near `x₀ ∈ M` take a `C¹` graph
chart `G` on `B_r(0) ⊆ ℝᵐ`: `M ∩ W = G(B_r(0))`, `pr(G(a) − x₀) = a`, `pr ∘ DG(a) = id` and
`T_{G(a)}M = DG(a)(ℝᵐ)`.  `A = DG(a)` is injective, so the Gram operator `A*A` is invertible,
and `P_{G(a)} = A(A*A)⁻¹A*` by the orthogonality characterization of the projection.  This is
continuous in `a`, as `DG` is continuous, the adjoint is an isometry and inversion is continuous
at units; composing with `x ↦ pr(x − x₀)` gives continuity on the neighbourhood `M ∩ W` of `x₀`
in `M`. -/
theorem Submission.codim1_hcp_lsa_tangent_projection_continuousOn : ∀ (P m : ℕ) (M : Set (Euclid P)), IsEmbeddedSubmanifold 1 m M → ContinuousOn (fun x => (Submodule.span ℝ (tangentSpace M x)).starProjection) M := by
  intro P m M hM x₀ hx₀
  -- step 1: a `C¹` graph chart `G` on `B_r(0)` at `x₀`, with `M ∩ W = G(B_r(0))`
  obtain ⟨pr, G, r, W, -, -, hWo, hx₀W, -, -, hGc, -, hMW, hleft, hderiv, htan⟩ :=
    Submission.codim1_hcp_lsa_c1_graph_chart P m M x₀ hM hx₀
  -- step 2: `A(a) = DG(a)` is continuous on `B_r(0)`, and injective since `pr ∘ A(a) = id`
  set A : Euclid m → (Euclid m →L[ℝ] Euclid P) := fun a => fderiv ℝ G a
  have hAc : ContinuousOn A (ball 0 r) := hGc.continuousOn_fderiv_of_isOpen isOpen_ball le_rfl
  have hAinj : ∀ a ∈ ball (0 : Euclid m) r, Injective (A a) := by
    intro a ha u v huv
    have h1 := congrArg (fun L => L u) (hderiv a ha)
    have h2 := congrArg (fun L => L v) (hderiv a ha)
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.id_apply] at h1 h2
    rw [← h1, ← h2]
    exact congrArg pr huv
  -- step 3: the Gram operator `Γ(a) = A(a)* A(a)` is injective, hence a unit of `L(ℝᵐ)`
  set Γ : Euclid m → (Euclid m →L[ℝ] Euclid m) := fun a =>
    (ContinuousLinearMap.adjoint (A a)).comp (A a) with hΓ
  have hΓunit : ∀ a ∈ ball (0 : Euclid m) r, IsUnit (Γ a) := by
    intro a ha
    rw [ContinuousLinearMap.isUnit_iff_bijective]
    have hinj : Injective (Γ a) := by
      intro u v huv
      -- `⟨Γ(a) h, h⟩ = ‖A(a) h‖²` vanishes for `h = u - v`
      have h0 : Γ a (u - v) = 0 := by rw [map_sub, huv, sub_self]
      have h1 : inner ℝ (Γ a (u - v)) (u - v) = ‖A a (u - v)‖ ^ 2 := by
        simp only [hΓ, ContinuousLinearMap.comp_apply, ContinuousLinearMap.adjoint_inner_left]
        exact real_inner_self_eq_norm_sq _
      rw [h0, inner_zero_left] at h1
      have h2 : A a (u - v) = 0 := by
        have : ‖A a (u - v)‖ = 0 := by nlinarith [norm_nonneg (A a (u - v))]
        exact norm_eq_zero.1 this
      exact sub_eq_zero.1 (hAinj a ha (by rw [h2, map_zero]))
    exact ⟨hinj, (LinearMap.injective_iff_surjective
      (f := ((Γ a : Euclid m →L[ℝ] Euclid m) : Euclid m →ₗ[ℝ] Euclid m))).1 hinj⟩
  -- step 4: `P_{G(a)} = Q(a) = A(a) Γ(a)⁻¹ A(a)*`, by the orthogonality characterization
  set Q : Euclid m → (Euclid P →L[ℝ] Euclid P) := fun a =>
    (A a).comp ((Ring.inverse (Γ a)).comp (ContinuousLinearMap.adjoint (A a))) with hQ
  have hQeq : ∀ a ∈ ball (0 : Euclid m) r,
      (Submodule.span ℝ (tangentSpace M (G a))).starProjection = Q a := by
    intro a ha
    -- `T_{G(a)}M = A(a)(ℝᵐ)` is already a linear subspace
    have hspan : Submodule.span ℝ (tangentSpace M (G a)) =
        LinearMap.range ((A a : Euclid m →L[ℝ] Euclid P) : Euclid m →ₗ[ℝ] Euclid P) := by
      apply le_antisymm
      · rw [Submodule.span_le, htan a ha]
        rintro _ ⟨y, rfl⟩
        exact ⟨y, rfl⟩
      · rintro _ ⟨y, rfl⟩
        apply Submodule.subset_span
        rw [htan a ha]
        exact ⟨y, rfl⟩
    have hinvr : Γ a * Ring.inverse (Γ a) = 1 := Ring.mul_inverse_cancel _ (hΓunit a ha)
    ext1 u
    refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero ?_ ?_
    · rw [hspan]
      exact ⟨_, rfl⟩
    · -- `⟨u − Q(a) u, A(a) h⟩ = ⟨A(a)* u − Γ(a) Γ(a)⁻¹ A(a)* u, h⟩ = 0`
      intro w hw
      rw [hspan] at hw
      obtain ⟨h, rfl⟩ := hw
      simp only [hQ, ContinuousLinearMap.coe_coe]
      rw [inner_sub_left, ← ContinuousLinearMap.adjoint_inner_left,
        ← ContinuousLinearMap.adjoint_inner_left]
      have : ContinuousLinearMap.adjoint (A a) ((A a).comp ((Ring.inverse (Γ a)).comp
          (ContinuousLinearMap.adjoint (A a))) u) = ContinuousLinearMap.adjoint (A a) u := by
        have h4 := congrArg
          (fun L : Euclid m →L[ℝ] Euclid m => L (ContinuousLinearMap.adjoint (A a) u)) hinvr
        simpa [hΓ, mul_apply_eq_comp] using h4
      rw [this, sub_self]
  -- step 5: `Q` is continuous on `B_r(0)`: the adjoint is a linear isometry, and inversion is
  -- continuous at every unit
  have hQc : ContinuousOn Q (ball 0 r) := by
    have hadj : ContinuousOn (fun a => ContinuousLinearMap.adjoint (A a)) (ball 0 r) :=
      (ContinuousLinearMap.adjoint (𝕜 := ℝ) (E := Euclid m) (F := Euclid P)).continuous
        |>.comp_continuousOn hAc
    have hΓc : ContinuousOn Γ (ball 0 r) := hadj.clm_comp hAc
    have hinv : ContinuousOn (fun a => Ring.inverse (Γ a)) (ball 0 r) := by
      intro a ha
      obtain ⟨u, hu⟩ := hΓunit a ha
      have := NormedRing.inverse_continuousAt u
      rw [hu] at this
      exact this.comp_continuousWithinAt (hΓc a ha)
    exact hAc.clm_comp (hinv.clm_comp hadj)
  -- step 6: on `M ∩ W`, `x = G(a)` with `a = pr(x − x₀) ∈ B_r(0)`, so `P_x = Q(pr(x − x₀))`
  have hPQ : ∀ x ∈ M ∩ W,
      (Submodule.span ℝ (tangentSpace M x)).starProjection = Q (pr (x - x₀)) := by
    intro x hx
    rw [hMW] at hx
    obtain ⟨a, ha, rfl⟩ := hx
    rw [hleft a ha]
    exact hQeq a ha
  have hcont : ContinuousOn (fun x => Q (pr (x - x₀))) (M ∩ W) := by
    refine hQc.comp (by fun_prop) fun x hx => ?_
    rw [hMW] at hx
    obtain ⟨a, ha, rfl⟩ := hx
    rw [hleft a ha]
    exact ha
  -- step 7: `M ∩ W` is a neighbourhood of `x₀` in `M`
  exact (hcont.congr hPQ x₀ ⟨hx₀, hx₀W⟩).mono_of_mem_nhdsWithin
    (inter_mem_nhdsWithin M (hWo.mem_nhds hx₀W))

/-- **Mollifying a compactly supported Lipschitz function** (the smoothing step of the Lipschitz
approximation used for Simons' theorem, Simon B.2): if `g : ℝᵐ → ℝ` is `K`-Lipschitz and vanishes
off the compact set `S`, and `δ > 0`, then there are `C^∞` functions `gₖ`, vanishing off the closed
`δ`-neighbourhood of `S`, with `gₖ → g` uniformly and `Dgₖ → Dg` in `L²`.  Take `gₖ = ρₖ ⋆ g` for
normalized bumps `ρₖ ≥ 0` supported in `B_{εₖ}(0)`, `εₖ = δ / (k + 2)`, with
`ρₖ ≤ 2ᵐ / Lᵐ(B̄_{εₖ})`.  Then `|gₖ − g| ≤ K εₖ`, and `Dgₖ = ρₖ ⋆ Dg` by dominated convergence of
difference quotients (`g` is differentiable a.e. by Rademacher), so `Dgₖ → Dg` at every Lebesgue
point of `Dg` (Besicovitch differentiation).  As `|Dgₖ − Dg|² ≤ (2K)²` on the compact
`δ`-neighbourhood of `S` and `= 0` off it, dominated convergence gives the `L²` limit. -/
theorem Submission.codim1_hcp_lsa_mollify_lipschitz_compact_support : ∀ (m : ℕ) (g : Euclid m → ℝ) (K : NNReal) (S : Set (Euclid m)) (δ : ℝ), LipschitzWith K g → IsCompact S → (∀ a, a ∉ S → g a = 0) → 0 < δ → ∃ gs : ℕ → Euclid m → ℝ, (∀ k, ContDiff ℝ (⊤ : ℕ∞) (gs k)) ∧ (∀ k a, a ∉ Metric.cthickening δ S → gs k a = 0) ∧ TendstoUniformly gs g atTop ∧ Tendsto (fun k => ∫⁻ a, ENNReal.ofReal (‖fderiv ℝ (gs k) a - fderiv ℝ g a‖ ^ 2)) atTop (𝓝 0) := by
  intro m g K S δ hg hS hg0 hδ
  classical
  -- the a.e. derivative `F = Dg`
  set F : Euclid m → (Euclid m →L[ℝ] ℝ) := fderiv ℝ g with hFdef
  have hFm : Measurable F := measurable_fderiv ℝ g
  have hFb : ∀ y, ‖F y‖ ≤ K := fun y => norm_fderiv_le_of_lipschitz ℝ hg
  have hF0 : ∀ y, y ∉ S → F y = 0 := by
    intro y hy
    have h : g =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
      filter_upwards [hS.isClosed.isOpen_compl.mem_nhds hy] with z hz using hg0 z hz
    rw [hFdef, h.fderiv_eq]; simp
  have hFint : Integrable F := by
    refine Integrable.mono' (g := S.indicator fun _ => (K : ℝ)) ?_ hFm.aestronglyMeasurable ?_
    · exact (integrable_indicator_iff hS.isClosed.measurableSet).2
        (integrableOn_const hS.measure_lt_top.ne)
    · filter_upwards with y
      by_cases hy : y ∈ S
      · rw [indicator_of_mem hy]; exact hFb y
      · rw [indicator_of_notMem hy, hF0 y hy, norm_zero]
  -- radii
  set ε : ℕ → ℝ := fun k => δ / ((k : ℝ) + 2) with hεdef
  have hε : ∀ k, 0 < ε k := fun k => by positivity
  have hεδ : ∀ k, ε k < δ := fun k => by
    simp only [hεdef]
    rw [div_lt_iff₀ (by positivity)]
    nlinarith [(k.cast_nonneg : (0 : ℝ) ≤ k)]
  have hεlim : Tendsto ε atTop (𝓝 0) := by
    have h := (tendsto_const_nhds (x := δ)).div_atTop
      (tendsto_atTop_add_const_right atTop (2 : ℝ) tendsto_natCast_atTop_atTop)
    simpa [hεdef] using h
  -- normalized bumps
  let φ : ℕ → ContDiffBump (0 : Euclid m) := fun k =>
    ⟨ε k / 2, ε k, by linarith [hε k], by linarith [hε k]⟩
  set I : ℕ → ℝ := fun k => ∫ x, (φ k) x with hIdef
  have hφint : ∀ k, Integrable (fun x => (φ k) x) := fun k =>
    (φ k).continuous.integrable_of_hasCompactSupport (φ k).hasCompactSupport
  -- the volume of balls
  have hvol : ∀ (y : Euclid m) (s : ℝ), 0 ≤ s →
      volume.real (closedBall y s) = s ^ m * volume.real (ball (0 : Euclid m) 1) := by
    intro y s hs
    rw [measureReal_def, Measure.addHaar_closedBall volume y hs, finrank_euclideanSpace_fin,
      ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity), measureReal_def]
  have hc : 0 < volume.real (ball (0 : Euclid m) 1) := by
    rw [measureReal_def]
    exact ENNReal.toReal_pos (measure_ball_pos volume 0 one_pos).ne' measure_ball_lt_top.ne
  have hI : ∀ k, volume.real (closedBall (0 : Euclid m) (ε k / 2)) ≤ I k := by
    intro k
    have hle : (closedBall (0 : Euclid m) (ε k / 2)).indicator (fun _ => (1 : ℝ)) ≤
        fun x => (φ k) x := by
      intro x
      by_cases hx : x ∈ closedBall (0 : Euclid m) (ε k / 2)
      · rw [indicator_of_mem hx]; exact ((φ k).one_of_mem_closedBall hx).ge
      · rw [indicator_of_notMem hx]; exact (φ k).nonneg
    have hint1 : Integrable ((closedBall (0 : Euclid m) (ε k / 2)).indicator fun _ => (1 : ℝ)) :=
      (integrable_indicator_iff measurableSet_closedBall).2
        (integrableOn_const measure_closedBall_lt_top.ne)
    calc volume.real (closedBall (0 : Euclid m) (ε k / 2))
        = ∫ x, (closedBall (0 : Euclid m) (ε k / 2)).indicator (fun _ => (1 : ℝ)) x := by
          rw [integral_indicator measurableSet_closedBall]; simp
      _ ≤ I k := integral_mono hint1 (hφint k) hle
  have hIpos : ∀ k, 0 < I k := fun k =>
    lt_of_lt_of_le (by rw [hvol 0 _ (by linarith [hε k])]; exact mul_pos (pow_pos (by linarith [hε k]) _) hc)
      (hI k)
  set ρ : ℕ → Euclid m → ℝ := fun k x => (I k)⁻¹ * (φ k) x with hρdef
  have hρ0 : ∀ k x, 0 ≤ ρ k x := fun k x => mul_nonneg (inv_nonneg.2 (hIpos k).le) (φ k).nonneg
  have hρint1 : ∀ k, ∫ x, ρ k x = 1 := fun k => by
    have hIk : ∫ x, (φ k) x = I k := rfl
    simp only [hρdef]; rw [integral_const_mul, hIk, inv_mul_cancel₀ (hIpos k).ne']
  have hρsupp : ∀ k, Function.support (ρ k) ⊆ ball 0 (ε k) := fun k =>
    (Function.support_mul_subset_right _ _).trans (φ k).support_eq.subset
  have hρsmooth : ∀ k, ContDiff ℝ (⊤ : ℕ∞) (ρ k) := fun k => contDiff_const.mul (φ k).contDiff
  have hρcs : ∀ k, HasCompactSupport (ρ k) := fun k => (φ k).hasCompactSupport.mul_left
  have hρcont : ∀ k, Continuous (ρ k) := fun k => continuous_const.mul (φ k).continuous
  have hρintg : ∀ k, Integrable (ρ k) := fun k => (hρcont k).integrable_of_hasCompactSupport (hρcs k)
  have hρle : ∀ k x (y : Euclid m), ρ k x ≤ 2 ^ m / volume.real (closedBall y (ε k)) := by
    intro k x y
    have h1 : ρ k x ≤ (I k)⁻¹ := by
      simp only [hρdef]
      calc (I k)⁻¹ * (φ k) x ≤ (I k)⁻¹ * 1 :=
            mul_le_mul_of_nonneg_left (φ k).le_one (inv_nonneg.2 (hIpos k).le)
        _ = (I k)⁻¹ := mul_one _
    have hpos2 : 0 < (ε k / 2) ^ m * volume.real (ball (0 : Euclid m) 1) :=
      mul_pos (pow_pos (by linarith [hε k]) _) hc
    have h2 : (I k)⁻¹ ≤ ((ε k / 2) ^ m * volume.real (ball (0 : Euclid m) 1))⁻¹ := by
      rw [← hvol 0 _ (by linarith [hε k])]
      exact inv_anti₀ (by rw [hvol 0 _ (by linarith [hε k])]; exact hpos2) (hI k)
    have h3 : ((ε k / 2) ^ m * volume.real (ball (0 : Euclid m) 1))⁻¹ =
        2 ^ m / volume.real (closedBall y (ε k)) := by
      rw [hvol y _ (hε k).le, div_pow]
      field_simp
    linarith [h1, h2, h3.le, h3.ge]
  -- the approximants
  set gs : ℕ → Euclid m → ℝ := fun k => convolution (ρ k) g (ContinuousLinearMap.lsmul ℝ ℝ) volume
    with hgsdef
  have hgs_apply : ∀ k a, gs k a = ∫ t, ρ k t * g (a - t) := by
    intro k a
    simp only [hgsdef, convolution_def, ContinuousLinearMap.lsmul_apply, smul_eq_mul]
  have hgs_smooth : ∀ k, ContDiff ℝ (⊤ : ℕ∞) (gs k) := fun k =>
    (hρcs k).contDiff_convolution_left (ContinuousLinearMap.lsmul ℝ ℝ) (hρsmooth k)
      hg.continuous.locallyIntegrable
  set T : Set (Euclid m) := Metric.cthickening δ S with hT
  have hgs_supp : ∀ k a, a ∉ T → gs k a = 0 := by
    intro k a ha
    rw [hgs_apply]
    refine integral_eq_zero_of_ae (Eventually.of_forall fun t => ?_)
    by_cases ht : ρ k t = 0
    · simp [ht]
    · have htb : t ∈ ball (0 : Euclid m) (ε k) := hρsupp k ht
      rw [mem_ball_zero_iff] at htb
      have hS' : a - t ∉ S := by
        intro hmem
        exact ha (Metric.mem_cthickening_of_dist_le a (a - t) δ S hmem
          (by rw [dist_eq_norm, sub_sub_cancel]; linarith [hεδ k]))
      simp [hg0 _ hS']
  refine ⟨gs, hgs_smooth, hgs_supp, ?_, ?_⟩
  · -- uniform convergence
    rw [Metric.tendstoUniformly_iff]
    intro e he
    have hK : Tendsto (fun k => (K : ℝ) * ε k) atTop (𝓝 0) := by
      simpa using hεlim.const_mul (K : ℝ)
    filter_upwards [hK.eventually (gt_mem_nhds he)] with k hk a
    rw [dist_comm]
    refine lt_of_le_of_lt ?_ hk
    refine dist_convolution_le (by positivity) (hρsupp k) (hρ0 k) (hρint1 k)
      hg.continuous.aestronglyMeasurable fun x hx => ?_
    calc dist (g x) (g a) ≤ K * dist x a := hg.dist_le_mul x a
      _ ≤ K * ε k := by gcongr; exact (mem_ball.1 hx).le
  · -- the derivative of `gs k` is the mollification of `F`
    have hFae : ∀ a : Euclid m, ∀ᵐ t ∂(volume : Measure (Euclid m)), DifferentiableAt ℝ g (a - t) :=
      fun a => (Measure.measurePreserving_sub_left volume a).quasiMeasurePreserving.ae
        hg.ae_differentiableAt
    have hsl : Tendsto (fun n : ℕ => (1 : ℝ) / ((n : ℝ) + 1)) atTop (𝓝[≠] 0) := by
      refine tendsto_nhdsWithin_iff.2 ⟨tendsto_one_div_add_atTop_nhds_zero_nat, Eventually.of_forall
        fun n => ?_⟩
      simp only [mem_compl_iff, mem_singleton_iff]; positivity
    have hderiv : ∀ k a, fderiv ℝ (gs k) a = ∫ t, ρ k t • F (a - t) := by
      intro k a
      have hint : Integrable (fun t => ρ k t • F (a - t)) := by
        refine Integrable.mono' ((hρintg k).mul_const (K : ℝ)) ?_ (Eventually.of_forall fun t => ?_)
        · exact (hρcont k).aestronglyMeasurable.smul
            (hFm.comp (measurable_const.sub measurable_id)).aestronglyMeasurable
        · rw [norm_smul, Real.norm_of_nonneg (hρ0 k t)]
          exact mul_le_mul_of_nonneg_left (hFb _) (hρ0 k t)
      ext v
      rw [ContinuousLinearMap.integral_apply hint]
      simp only [_root_.smul_apply, smul_eq_mul]
      set s : ℕ → ℝ := fun n => 1 / ((n : ℝ) + 1) with hsdef
      have hspos : ∀ n, 0 < s n := fun n => by positivity
      -- difference quotients of `gs k` along `v`
      have hline : HasDerivAt (fun r : ℝ => gs k (a + r • v)) (fderiv ℝ (gs k) a v) 0 := by
        have h1 : HasDerivAt (fun r : ℝ => a + r • v) v 0 := by
          simpa using ((hasDerivAt_id (0 : ℝ)).smul_const v).const_add a
        have h2 : HasFDerivAt (gs k) (fderiv ℝ (gs k) a) (a + (0 : ℝ) • v) := by
          rw [zero_smul, add_zero]
          exact ((hgs_smooth k).differentiable (by simp) a).hasFDerivAt
        exact h2.comp_hasDerivAt (0 : ℝ) h1
      have hq1 : Tendsto (fun n => (s n)⁻¹ * (gs k (a + s n • v) - gs k a)) atTop
          (𝓝 (fderiv ℝ (gs k) a v)) := by
        have := (hasDerivAt_iff_tendsto_slope_zero.1 hline).comp hsl
        simpa [Function.comp_def, smul_eq_mul, hsdef] using this
      have hgint : ∀ w : Euclid m, Integrable (fun t => ρ k t * g (w - t)) := fun w =>
        ((hρcont k).mul (hg.continuous.comp (continuous_const.sub continuous_id))).integrable_of_hasCompactSupport
          ((hρcs k).mul_right)
      have hrepr : ∀ n, (s n)⁻¹ * (gs k (a + s n • v) - gs k a) =
          ∫ t, ρ k t * ((s n)⁻¹ * (g (a - t + s n • v) - g (a - t))) := by
        intro n
        rw [hgs_apply, hgs_apply, ← integral_sub (hgint _) (hgint _), ← integral_const_mul]
        congr 1
        ext t
        rw [show a + s n • v - t = a - t + s n • v by abel]
        ring
      have hq2 : Tendsto (fun n => (s n)⁻¹ * (gs k (a + s n • v) - gs k a)) atTop
          (𝓝 (∫ t, ρ k t * F (a - t) v)) := by
        simp_rw [hrepr]
        refine tendsto_integral_of_dominated_convergence (fun t => ρ k t * (K * ‖v‖)) (fun n => ?_)
          ((hρintg k).mul_const _) (fun n => Eventually.of_forall fun t => ?_) ?_
        · exact ((hρcont k).mul (continuous_const.mul ((hg.continuous.comp
            ((continuous_const.sub continuous_id).add continuous_const)).sub
            (hg.continuous.comp (continuous_const.sub continuous_id))))).aestronglyMeasurable
        · rw [norm_mul, Real.norm_of_nonneg (hρ0 k t)]
          refine mul_le_mul_of_nonneg_left ?_ (hρ0 k t)
          have hL := hg.dist_le_mul (a - t + s n • v) (a - t)
          rw [dist_eq_norm, dist_eq_norm, add_sub_cancel_left, norm_smul,
            Real.norm_of_nonneg (hspos n).le] at hL
          rw [norm_mul, norm_inv, Real.norm_of_nonneg (hspos n).le, Real.norm_eq_abs]
          calc (s n)⁻¹ * |g (a - t + s n • v) - g (a - t)|
              ≤ (s n)⁻¹ * (K * (s n * ‖v‖)) := by gcongr; exact hL
            _ = K * ‖v‖ := by
                rw [show (s n)⁻¹ * (K * (s n * ‖v‖)) = (s n)⁻¹ * s n * (K * ‖v‖) by ring,
                  inv_mul_cancel₀ (hspos n).ne', one_mul]
        · filter_upwards [hFae a] with t ht
          refine Tendsto.const_mul _ ?_
          have hl : HasDerivAt (fun r : ℝ => g (a - t + r • v)) (F (a - t) v) 0 := by
            have h1 : HasDerivAt (fun r : ℝ => a - t + r • v) v 0 := by
              simpa using ((hasDerivAt_id (0 : ℝ)).smul_const v).const_add (a - t)
            have h2 : HasFDerivAt g (F (a - t)) (a - t + (0 : ℝ) • v) := by
              rw [zero_smul, add_zero]; exact ht.hasFDerivAt
            exact h2.comp_hasDerivAt (0 : ℝ) h1
          have := (hasDerivAt_iff_tendsto_slope_zero.1 hl).comp hsl
          simpa [Function.comp_def, smul_eq_mul, hsdef] using this
      exact tendsto_nhds_unique hq1 hq2
    -- bounds and support of the derivatives
    have hDgsb : ∀ k a, ‖fderiv ℝ (gs k) a‖ ≤ K := by
      intro k a
      rw [hderiv k a]
      calc ‖∫ t, ρ k t • F (a - t)‖ ≤ ∫ t, ρ k t * K := by
            refine norm_integral_le_of_norm_le ((hρintg k).mul_const _) (Eventually.of_forall fun t => ?_)
            rw [norm_smul, Real.norm_of_nonneg (hρ0 k t)]
            exact mul_le_mul_of_nonneg_left (hFb _) (hρ0 k t)
        _ = K := by rw [integral_mul_const, hρint1 k, one_mul]
    have hDgs0 : ∀ k a, a ∉ T → fderiv ℝ (gs k) a = 0 := by
      intro k a ha
      have h : gs k =ᶠ[𝓝 a] fun _ => (0 : ℝ) := by
        filter_upwards [Metric.isClosed_cthickening.isOpen_compl.mem_nhds ha] with b hb
        exact hgs_supp k b hb
      rw [h.fderiv_eq]; simp
    -- Lebesgue points: `D gs k → F` a.e.
    have hεlim' : Tendsto ε atTop (𝓝[>] 0) := tendsto_nhdsWithin_iff.2 ⟨hεlim, Eventually.of_forall hε⟩
    have hae : ∀ᵐ a ∂(volume : Measure (Euclid m)), Tendsto (fun k => fderiv ℝ (gs k) a) atTop (𝓝 (F a)) := by
      filter_upwards [(Besicovitch.vitaliFamily (volume : Measure (Euclid m))).ae_tendsto_average_norm_sub
        hFint.locallyIntegrable] with a ha
      have havg : Tendsto (fun k => ⨍ y in closedBall a (ε k), ‖F y - F a‖) atTop (𝓝 0) :=
        ha.comp ((Besicovitch.tendsto_filterAt volume a).comp hεlim')
      have hconv := tendsto_integral_smul_of_tendsto_average_norm_sub (μ := volume)
        (g := fun k y => ρ k (a - y)) (2 ^ m) havg
        (Eventually.of_forall fun k => hFint.integrableOn)
        (tendsto_const_nhds.congr' (Eventually.of_forall fun k => by
          simp only
          rw [integral_sub_left_eq_self (fun y => ρ k y) volume a, hρint1 k]))
        (Eventually.of_forall fun k y hy => by
          have h := hρsupp k hy
          rw [mem_ball_zero_iff] at h
          rw [mem_closedBall, dist_eq_norm, ← norm_neg, neg_sub]
          exact h.le)
        (Eventually.of_forall fun k y => by
          rw [abs_of_nonneg (hρ0 k _)]; exact hρle k _ a)
      refine hconv.congr' (Eventually.of_forall fun k => ?_)
      show _ = fderiv ℝ (gs k) a
      rw [hderiv k a]
      have := integral_sub_left_eq_self (fun t => ρ k t • F (a - t)) volume a
      simp only [sub_sub_cancel] at this
      exact this
    -- dominated convergence in `L²`
    have hTc : IsCompact T := hS.cthickening
    have hkey := tendsto_lintegral_of_dominated_convergence (μ := volume)
      (F := fun k a => ENNReal.ofReal (‖fderiv ℝ (gs k) a - F a‖ ^ 2)) (f := fun _ => 0)
      (T.indicator fun _ => ENNReal.ofReal ((2 * K) ^ 2))
      (fun k => (((measurable_fderiv ℝ (gs k)).sub hFm).norm.pow_const 2).ennreal_ofReal)
      (fun k => Eventually.of_forall fun a => by
        by_cases ha : a ∈ T
        · rw [indicator_of_mem ha]
          refine ENNReal.ofReal_le_ofReal ?_
          have h1 : ‖fderiv ℝ (gs k) a - F a‖ ≤ 2 * K :=
            (norm_sub_le _ _).trans (by linarith [hDgsb k a, hFb a])
          exact pow_le_pow_left₀ (norm_nonneg _) h1 2
        · have haS : a ∉ S := fun h => ha (Metric.self_subset_cthickening S h)
          rw [indicator_of_notMem ha]
          show ENNReal.ofReal (‖fderiv ℝ (gs k) a - F a‖ ^ 2) ≤ 0
          rw [hDgs0 k a ha, hF0 a haS, sub_zero, norm_zero]
          simp)
      (by
        rw [lintegral_indicator_const hTc.isClosed.measurableSet]
        exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top hTc.measure_lt_top.ne)
      (by
        filter_upwards [hae] with a ha
        have h1 : Tendsto (fun k => ‖fderiv ℝ (gs k) a - F a‖) atTop (𝓝 0) :=
          tendsto_iff_norm_sub_tendsto_zero.1 ha
        have h2 := ENNReal.tendsto_ofReal (h1.pow 2)
        simpa using h2)
    simpa using hkey

/-- **Rademacher's theorem on a `C¹` submanifold** (Simon Ch. 2, 1.4 and §4).  If `M ⊆ ℝᴾ` is an
embedded `C¹` `m`-dimensional submanifold and `ζ` is locally Lipschitz on `M`, then `ζ` is
differentiable within `M` at `Hᵐ`-a.e. point of `M`.  Near `p ∈ M`, a graph chart `G` over
`B_r(0) ⊆ ℝᵐ` with `pr(G(a) − p) = a` is shrunk to `B_{r₁}(0)` so that `ζ ∘ G` is Lipschitz there
and every `x ∈ M ∩ O` is `G(pr(x − p))`, for an open `O ∋ p`.  By Rademacher `ζ ∘ G` is
differentiable off an `Lᵐ`-null set `N`, and `G(N)` is `Hᵐ`-null because `G` is Lipschitz; off
`G(N)`, `ζ` agrees on `M ∩ O` with the differentiable function `(ζ ∘ G)(pr(· − p))`.  Countably
many such `O` cover `M`. -/
theorem Submission.codim1_hcp_lsa_rademacher_on_submanifold : ∀ (P m : ℕ) (M : Set (Euclid P)) (ζ : Euclid P → ℝ), IsEmbeddedSubmanifold 1 m M → LocallyLipschitzOn M ζ → ∀ᵐ x ∂(μHE[m].restrict M), DifferentiableWithinAt ℝ ζ M x := by
  intro P m M ζ hM hζ
  -- step 1: `M` is Borel
  have hMmeas : MeasurableSet M := (Submission.dimred_rpd_embedded_locally_closed P 1 m M hM).1
  -- step 2: near each `p ∈ M`, `ζ` is differentiable within `M` off an `Hᵐ`-null set
  have hloc : ∀ p ∈ M, ∃ O : Set (Euclid P), IsOpen O ∧ p ∈ O ∧ ∃ E : Set (Euclid P),
      μHE[m] E = 0 ∧ ∀ x ∈ M ∩ O, x ∉ E → DifferentiableWithinAt ℝ ζ M x := by
    intro p hp
    -- (a) a graph chart `G` of `M ∩ W` over `B_r(0)`, inverted by `z ↦ pr(z − p)`
    obtain ⟨pr, G, r, W, Λ, hr, hWo, hpW, -, hG0, hGc, hGL, hMW, hleft, -, -⟩ :=
      Submission.codim1_hcp_lsa_c1_graph_chart P m M p hM hp
    -- (b) `ζ` is `K`-Lipschitz on `t ⊇ M ∩ U`, with `U ∋ p` open
    obtain ⟨K, t, ht, hKt⟩ := hζ hp
    obtain ⟨U, hUo, hpU, hUt⟩ : ∃ U : Set (Euclid P), IsOpen U ∧ p ∈ U ∧ M ∩ U ⊆ t := by
      obtain ⟨U, hUo, hpU, hUt⟩ := mem_nhdsWithin.1 ht
      exact ⟨U, hUo, hpU, fun x hx => hUt ⟨hx.2, hx.1⟩⟩
    -- (c) shrink the chart so that `G(B_{r₁}(0)) ⊆ U`; `O = W ∩ {pr(z − p) ∈ B_{r₁}(0)}`
    obtain ⟨r₁, hr₁, hr₁r, hGU⟩ : ∃ r₁ : ℝ, 0 < r₁ ∧ r₁ ≤ r ∧ G '' ball 0 r₁ ⊆ U := by
      have hGcont : ContinuousAt G 0 :=
        hGc.continuousOn.continuousAt (isOpen_ball.mem_nhds (mem_ball_self hr))
      have hpre : G ⁻¹' U ∈ 𝓝 (0 : Euclid m) :=
        hGcont.preimage_mem_nhds (hUo.mem_nhds (by rw [hG0]; exact hpU))
      obtain ⟨ε, hε, hεU⟩ := Metric.mem_nhds_iff.1 hpre
      refine ⟨min ε r, lt_min hε hr, min_le_right _ _, ?_⟩
      rintro _ ⟨a, ha, rfl⟩
      exact hεU (ball_subset_ball (min_le_left _ _) ha)
    have hball : ball (0 : Euclid m) r₁ ⊆ ball 0 r := ball_subset_ball hr₁r
    let O : Set (Euclid P) := W ∩ (fun z => pr (z - p)) ⁻¹' ball 0 r₁
    have hOo : IsOpen O := hWo.inter (isOpen_ball.preimage (by fun_prop))
    have hpO : p ∈ O := ⟨hpW, by simp [hr₁]⟩
    -- (d) every `x ∈ M ∩ O` is `G(a)` with `a = pr(x − p) ∈ B_{r₁}(0)`
    have hMO : ∀ x ∈ M ∩ O, pr (x - p) ∈ ball (0 : Euclid m) r₁ ∧ G (pr (x - p)) = x := by
      intro x hx
      have hxW : x ∈ M ∩ W := ⟨hx.1, hx.2.1⟩
      rw [hMW] at hxW
      obtain ⟨a, ha, rfl⟩ := hxW
      have h2 : pr (G a - p) ∈ ball (0 : Euclid m) r₁ := hx.2.2
      rw [hleft a ha] at h2 ⊢
      exact ⟨h2, rfl⟩
    -- (e) `ζ ∘ G` is `KΛ`-Lipschitz on `B_{r₁}(0)`
    have hGM : ∀ a ∈ ball (0 : Euclid m) r, G a ∈ M := fun a ha =>
      ((hMW.symm ▸ mem_image_of_mem G ha : G a ∈ M ∩ W)).1
    have hgL : LipschitzOnWith (K * Λ) (ζ ∘ G) (ball 0 r₁) :=
      hKt.comp (hGL.mono hball) fun a ha => hUt ⟨hGM a (hball ha), hGU (mem_image_of_mem G ha)⟩
    -- (f) Rademacher: `ζ ∘ G` is differentiable off the `Lᵐ`-null set `N`
    let N : Set (Euclid m) := {a | a ∈ ball (0 : Euclid m) r₁ ∧ ¬ DifferentiableAt ℝ (ζ ∘ G) a}
    have hN : volume N = 0 := by
      have hrad := hgL.ae_differentiableWithinAt_of_mem (μ := volume)
      rw [ae_iff] at hrad
      refine measure_mono_null (fun a ha => ?_) hrad
      simp only [mem_ofPred_eq, not_imp]
      exact ⟨ha.1, fun hd => ha.2 (hd.differentiableAt (isOpen_ball.mem_nhds ha.1))⟩
    refine ⟨O, hOo, hpO, G '' N, ?_, ?_⟩
    · -- (g) `Hᵐ(G(N)) ≤ Λᵐ Lᵐ(N) = 0`
      have h := (Submission.codim1_hcp_lsa_lipschitz_image_lintegral_le m P G (ball 0 r₁) Λ
        (hGL.mono hball)).1 N (fun a ha => ha.1)
      rw [hN, mul_zero] at h
      exact le_antisymm h zero_le
    · -- (h) off `G(N)`, `ζ` agrees on `M ∩ O` with `(ζ ∘ G)(pr(· − p))`, differentiable at `x`
      intro x hx hxE
      obtain ⟨ha, hGa⟩ := hMO x hx
      have hdiffa : DifferentiableAt ℝ (ζ ∘ G) (pr (x - p)) := by
        by_contra hnd
        exact hxE ⟨pr (x - p), ⟨ha, hnd⟩, hGa⟩
      have hpr' : DifferentiableAt ℝ (fun z : Euclid P => pr (z - p)) x := by fun_prop
      have hf : DifferentiableAt ℝ ((ζ ∘ G) ∘ fun z : Euclid P => pr (z - p)) x :=
        hdiffa.comp x hpr'
      refine hf.differentiableWithinAt.congr_of_eventuallyEq ?_ ?_
      · filter_upwards [inter_mem_nhdsWithin M (hOo.mem_nhds hx.2)] with y hy
        simp only [Function.comp_apply, (hMO y ⟨hy.1, hy.2⟩).2]
      · simp only [Function.comp_apply, hGa]
  -- step 3: countably many of the neighbourhoods `O p` cover `M` (second countability)
  choose! O hOo hpO E hE hdiff using hloc
  obtain ⟨T, hTM, hTc, hTU⟩ := TopologicalSpace.isOpen_biUnion_countable M O hOo
  have hnull : μHE[m] (⋃ p ∈ T, E p) = 0 :=
    (measure_biUnion_null_iff hTc).2 fun p hp => hE p (hTM hp)
  -- step 4: every point of `M` where `ζ` is not differentiable within `M` lies in `⋃_{p ∈ T} E p`
  rw [ae_restrict_iff' hMmeas, ae_iff]
  refine measure_mono_null (fun x hx => ?_) hnull
  simp only [mem_ofPred_eq, not_imp] at hx
  obtain ⟨hxM, hxnd⟩ := hx
  have hxU : x ∈ ⋃ p ∈ M, O p := mem_iUnion₂.2 ⟨x, hxM, hpO x hxM⟩
  rw [← hTU] at hxU
  obtain ⟨p, hpT, hxO⟩ := mem_iUnion₂.1 hxU
  refine mem_iUnion₂.2 ⟨p, hpT, ?_⟩
  by_contra hxE
  exact hxnd (hdiff p (hTM hpT) x ⟨hxM, hxO⟩ hxE)
/-- **Measurability of the tangential derivative of a Lipschitz function** (Simon Ch. 2, §4; used
in 7.5).  Let `M ⊆ ℝᴾ` be an embedded `C¹` `m`-dimensional submanifold, `ζ` locally Lipschitz on
`M`, and `P_x` the orthogonal projection onto `T_xM`.  Then `x ↦ d^M_xζ ∘ P_x` is `Hᵐ⌞M`-a.e.
strongly measurable.  On a graph chart `G : B_r(0) → M ∩ W` about `p` with `pr(G(a) − p) = a`,
`pr ∘ DG(a) = id` and `T_{G(a)}M = DG(a)(ℝᵐ)`, the map `Ψ(x) = D(ζ ∘ G)(pr(x − p)) ∘ pr ∘ P_x` is
a.e. strongly measurable (`D(ζ ∘ G)` is Borel and `x ↦ P_x` is continuous on `M`).  Where `ζ` is
differentiable within `M` (`Hᵐ`-a.e. on `M`, by Rademacher), the chain rule gives
`D(ζ ∘ G)(a) = d^M_xζ ∘ DG(a)` and `P_xv = DG(a)(pr P_xv)`, so `Ψ(x) = d^M_xζ ∘ P_x`.  Countably
many chart domains cover `M`. -/
theorem Submission.codim1_hcp_lsa_tangential_derivative_aesm : ∀ (P m : ℕ) (M : Set (Euclid P)) (ζ : Euclid P → ℝ), IsEmbeddedSubmanifold 1 m M → LocallyLipschitzOn M ζ → AEStronglyMeasurable (fun x => (fderivWithin ℝ ζ M x).comp (Submodule.span ℝ (tangentSpace M x)).starProjection) (μHE[m].restrict M) := by
  intro P m M ζ hM hζ
  -- step 1: `M` is Borel, `ζ` is differentiable within `M` a.e. on `M`, `x ↦ P_x` is continuous
  have hMmeas : MeasurableSet M := (Submission.dimred_rpd_embedded_locally_closed P 1 m M hM).1
  have hdiff := Submission.codim1_hcp_lsa_rademacher_on_submanifold P m M ζ hM hζ
  have hPc := Submission.codim1_hcp_lsa_tangent_projection_continuousOn P m M hM
  set F : Euclid P → (Euclid P →L[ℝ] ℝ) := fun x =>
    (fderivWithin ℝ ζ M x).comp (Submodule.span ℝ (tangentSpace M x)).starProjection with hF
  -- step 2: `F` is a.e. strongly measurable on `M ∩ W` for a graph-chart domain `W ∋ p`
  have hloc : ∀ p ∈ M, ∃ O : Set (Euclid P), IsOpen O ∧ p ∈ O ∧
      AEStronglyMeasurable F (μHE[m].restrict (M ∩ O)) := by
    intro p hp
    obtain ⟨pr, G, r, W, -, -, hWo, hpW, -, -, hGc, -, hMW, hleft, hderiv, htan⟩ :=
      Submission.codim1_hcp_lsa_c1_graph_chart P m M p hM hp
    refine ⟨W, hWo, hpW, ?_⟩
    have hMWm : MeasurableSet (M ∩ W) := hMmeas.inter hWo.measurableSet
    -- (b) the chart representative `Ψ(x) = D(ζ ∘ G)(pr(x − p)) ∘ pr ∘ P_x` is measurable
    set Ψ : Euclid P → (Euclid P →L[ℝ] ℝ) := fun x =>
      (fderiv ℝ (ζ ∘ G) (pr (x - p))).comp
        (pr.comp (Submodule.span ℝ (tangentSpace M x)).starProjection) with hΨ
    have hΨm : AEStronglyMeasurable Ψ (μHE[m].restrict (M ∩ W)) := by
      have h1 : Measurable (fun x : Euclid P => fderiv ℝ (ζ ∘ G) (pr (x - p))) :=
        (measurable_fderiv ℝ (ζ ∘ G)).comp (by fun_prop)
      have h2 : ContinuousOn (fun x => pr.comp (Submodule.span ℝ (tangentSpace M x)).starProjection)
          (M ∩ W) :=
        ((ContinuousLinearMap.compL ℝ (Euclid P) (Euclid P) (Euclid m) pr).continuous
          |>.comp_continuousOn hPc).mono inter_subset_left
      exact isBoundedBilinearMap_comp.continuous.comp_aestronglyMeasurable
        (h1.aestronglyMeasurable.prodMk (h2.aestronglyMeasurable hMWm))
    -- (c) `Ψ = F` at every `x ∈ M ∩ W` where `ζ` is differentiable within `M`
    refine hΨm.congr ?_
    have hdiff' : ∀ᵐ x ∂(μHE[m].restrict (M ∩ W)), DifferentiableWithinAt ℝ ζ M x :=
      ae_restrict_of_ae_restrict_of_subset inter_subset_left hdiff
    filter_upwards [hdiff', ae_restrict_mem hMWm] with x hxd hxMW
    -- `x = G a` with `a = pr (x - p)`
    have hxMW' := hxMW
    rw [hMW] at hxMW'
    obtain ⟨a, ha, rfl⟩ := hxMW'
    simp only [hΨ, hF]
    rw [hleft a ha]
    -- chain rule: `D(ζ ∘ G)(a) = d^M_{G a}ζ ∘ DG(a)`
    have hGM : MapsTo G (ball 0 r) M :=
      fun b hb => (hMW.symm ▸ mem_image_of_mem G hb : G b ∈ M ∩ W).1
    have hGd : HasFDerivAt G (fderiv ℝ G a) a :=
      ((hGc.contDiffAt (isOpen_ball.mem_nhds ha)).differentiableAt one_ne_zero).hasFDerivAt
    have hcomp : HasFDerivAt (ζ ∘ G) ((fderivWithin ℝ ζ M (G a)).comp (fderiv ℝ G a)) a :=
      (hxd.hasFDerivWithinAt.comp a hGd.hasFDerivWithinAt hGM).hasFDerivAt
        (isOpen_ball.mem_nhds ha)
    rw [hcomp.fderiv]
    ext v
    simp only [ContinuousLinearMap.comp_apply]
    -- `P_x v ∈ T_{G a}M = DG(a)(ℝᵐ)`, so `P_x v = DG(a) h` and `pr (P_x v) = h`
    have hmem0 := Submodule.starProjection_apply_mem (Submodule.span ℝ (tangentSpace M (G a))) v
    have hle : Submodule.span ℝ (tangentSpace M (G a)) ≤
        LinearMap.range ((fderiv ℝ G a : Euclid m →L[ℝ] Euclid P) : Euclid m →ₗ[ℝ] Euclid P) := by
      rw [Submodule.span_le, htan a ha]
      rintro _ ⟨y, rfl⟩
      exact ⟨y, rfl⟩
    have hmem : ∃ h, (fderiv ℝ G a) h =
        (Submodule.span ℝ (tangentSpace M (G a))).starProjection v :=
      LinearMap.mem_range.1 (hle hmem0)
    obtain ⟨h, hh⟩ := hmem
    rw [← hh]
    congr 1
    have := congrArg (fun L => L h) (hderiv a ha)
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.id_apply] at this
    rw [this]
  -- step 3: countably many chart domains `O p`, `p ∈ T`, cover `M`
  choose! O hOo hpO hO using hloc
  obtain ⟨T, hTM, hTc, hTU⟩ := TopologicalSpace.isOpen_biUnion_countable M O hOo
  have hcount : Countable T := hTc.to_subtype
  have hMU : M = ⋃ i : T, M ∩ O i := by
    ext x
    simp only [mem_iUnion, mem_inter_iff]
    constructor
    · intro hx
      have hxU : x ∈ ⋃ p ∈ M, O p := mem_iUnion₂.2 ⟨x, hx, hpO x hx⟩
      rw [← hTU] at hxU
      obtain ⟨p, hpT, hxO⟩ := mem_iUnion₂.1 hxU
      exact ⟨⟨p, hpT⟩, hx, hxO⟩
    · rintro ⟨i, hx, -⟩
      exact hx
  -- step 4: a.e. strong measurability passes to the countable union
  rw [hMU]
  exact aestronglyMeasurable_iUnion_iff.2 fun i => hO i.1 (hTM i.2)

/-- **Smooth approximation in one graph chart** (Simon Ch. 2, §4, 4.4–4.9; Lipschitz test
functions in App. B, proof of B.2, used for 7.5.8).  `W` is the domain of a `C¹` graph chart at `p`:
`M ∩ W = G(B_r(0))`, `pr(G(a) − p) = a`.  If `ζ` is locally Lipschitz on `M` and vanishes off a
compact `C ⊆ M ∩ W`, then `g = ζ ∘ G` on `B_r(0)` (`0` outside) is Lipschitz and vanishes off
`S = pr(C − p)`.  Mollify `g` to `gₖ`, supported in `T = cthickening δ S`, and put
`ζₖ = β · gₖ ∘ pr(· − p)` with `β` smooth, `= 1` near `C' = G(T)` and `tsupport β ⊆ W`.
`H^m`-a.e. on `M ∩ W` (Rademacher) the tangential error is `(Dgₖ(a) − Dg(a))(pr Pₓeⱼ)`,
`a = pr(x − p)`, whose squares sum to at most `‖Dgₖ(a) − Dg(a)‖²`; off `W` it vanishes.  The
Lipschitz area bound moves the error integral to `B_r(0)`, where it tends to `0`. -/
theorem Submission.codim1_hcp_lsa_local_chart_approx : ∀ (P m : ℕ) (M : Set (Euclid P)), IsEmbeddedSubmanifold 1 m M → ∀ p ∈ M, ∃ W : Set (Euclid P), IsOpen W ∧ p ∈ W ∧ ∀ ζ : Euclid P → ℝ, LocallyLipschitzOn M ζ → (∃ C : Set (Euclid P), IsCompact C ∧ C ⊆ M ∩ W ∧ ∀ x ∈ M, x ∉ C → ζ x = 0) → ∃ (C' : Set (Euclid P)) (ζs : ℕ → Euclid P → ℝ), IsCompact C' ∧ C' ⊆ M ∧ (∀ k, ContDiff ℝ (⊤ : ℕ∞) (ζs k) ∧ HasCompactSupport (ζs k)) ∧ (∀ k, ∀ x ∈ M, x ∉ C' → ζs k x = 0) ∧ TendstoUniformlyOn ζs ζ atTop M ∧ Tendsto (fun k => ∫⁻ x in M, ENNReal.ofReal (∑ j : Fin P, (fderiv ℝ (ζs k) x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1)) - fderivWithin ℝ ζ M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) ^ 2) ∂μHE[m]) atTop (𝓝 0) := by
  classical
  intro P m M hM p hp
  -- step 1: the graph chart at `p`; its domain `W` is the asserted neighbourhood
  obtain ⟨pr, G, r, W, Λ, hr, hWo, hpW, hpr, hG0, hGc, hGL, hMW, hleft, hderiv, htan⟩ :=
    Submission.codim1_hcp_lsa_c1_graph_chart P m M p hM hp
  have hMmeas : MeasurableSet M := (Submission.dimred_rpd_embedded_locally_closed P 1 m M hM).1
  refine ⟨W, hWo, hpW, ?_⟩
  rintro ζ hζ ⟨C, hCc, hCMW, hζC⟩
  have hGMW : ∀ a ∈ ball (0 : Euclid m) r, G a ∈ M ∩ W := fun a ha => by
    rw [hMW]; exact mem_image_of_mem G ha
  have hrep : ∀ x ∈ M ∩ W, pr (x - p) ∈ ball (0 : Euclid m) r ∧ G (pr (x - p)) = x := by
    intro x hx
    rw [hMW] at hx
    obtain ⟨a, ha, rfl⟩ := hx
    rw [hleft a ha]; exact ⟨ha, rfl⟩
  have hGcont : ContinuousOn G (ball 0 r) := hGc.continuousOn
  -- step 2: the compact parameter sets `S = pr(C − p) ⊆ T = cthickening δ S ⊆ B_r(0)`
  set S : Set (Euclid m) := (fun x => pr (x - p)) '' C with hS
  have hSc : IsCompact S := hCc.image (by fun_prop)
  have hSball : S ⊆ ball 0 r := by
    rintro _ ⟨x, hx, rfl⟩; exact (hrep x (hCMW hx)).1
  obtain ⟨δ₀, hδ₀, hδ₀sub⟩ := hSc.exists_cthickening_subset_open isOpen_ball hSball
  set δ : ℝ := δ₀ / 2 with hδ
  have hδpos : 0 < δ := by positivity
  set T : Set (Euclid m) := Metric.cthickening δ S with hT
  have hTc : IsCompact T := hSc.cthickening
  have hTball : T ⊆ ball 0 r := (Metric.cthickening_mono (by linarith) S).trans hδ₀sub
  have hST : S ⊆ T := Metric.self_subset_cthickening S
  -- step 3: the coordinate function `g = ζ ∘ G` on `B_r(0)`, `0` outside; `g = 0` off `S`
  set g : Euclid m → ℝ := fun a => if a ∈ ball (0 : Euclid m) r then ζ (G a) else 0 with hg
  have hg_ball : ∀ a ∈ ball (0 : Euclid m) r, g a = ζ (G a) := fun a ha => ite_eq_left ha
  have hg0 : ∀ a, a ∉ S → g a = 0 := by
    intro a ha
    by_cases hab : a ∈ ball (0 : Euclid m) r
    · rw [hg_ball a hab]
      refine hζC (G a) (hGMW a hab).1 fun hGC => ha ?_
      exact ⟨G a, hGC, hleft a hab⟩
    · exact ite_eq_right hab
  -- (b) `ζ ∘ G` is locally Lipschitz on the ball, hence Lipschitz and bounded on `T`
  have hζG : LocallyLipschitzOn (ball (0 : Euclid m) r) (ζ ∘ G) := by
    intro a ha
    obtain ⟨K, t, ht, hKt⟩ := hζ (hGMW a ha).1
    have ht' : t ∈ 𝓝[G '' ball 0 r] (G a) :=
      nhdsWithin_mono _ (fun y hy => by rw [← hMW] at hy; exact hy.1) ht
    refine ⟨K * Λ, G ⁻¹' t ∩ ball 0 r, ?_, ?_⟩
    · exact inter_mem ((hGcont a ha).preimage_mem_nhdsWithin' ht') self_mem_nhdsWithin
    · exact hKt.comp (hGL.mono inter_subset_right) fun b hb => hb.1
  obtain ⟨K₁, hK₁⟩ := (hζG.mono hTball).exists_lipschitzOnWith_of_compact hTc
  obtain ⟨B, hB⟩ := hTc.exists_bound_of_continuousOn (hK₁.continuousOn)
  -- (c) `g` is globally Lipschitz with constant `max(K₁, B/δ)`
  have hgLip : LipschitzWith (max K₁ (Real.toNNReal (B / δ))) g := by
    have hgT : ∀ a ∈ T, g a = ζ (G a) := fun a ha => hg_ball a (hTball ha)
    have hfar : ∀ a b, a ∈ S → b ∉ T →
        dist (g a) (g b) ≤ max K₁ (Real.toNNReal (B / δ)) * dist a b := by
      intro a b ha hb
      have hgb : g b = 0 := hg0 b fun h => hb (hST h)
      have hdist : δ < dist a b := by
        by_contra hle
        exact hb (Metric.mem_cthickening_of_dist_le b a δ S ha (by rw [dist_comm]; linarith))
      rw [hgb, dist_zero_right]
      have hBa : ‖g a‖ ≤ B := by rw [hgT a (hST ha)]; exact hB a (hST ha)
      have hB0 : 0 ≤ B := le_trans (norm_nonneg _) hBa
      calc ‖g a‖ ≤ B := hBa
        _ ≤ B / δ * dist a b := by
            rw [div_mul_eq_mul_div, le_div_iff₀ hδpos]
            exact mul_le_mul_of_nonneg_left hdist.le hB0
        _ ≤ (Real.toNNReal (B / δ) : ℝ) * dist a b :=
            mul_le_mul_of_nonneg_right (Real.le_coe_toNNReal _) dist_nonneg
        _ ≤ (max K₁ (Real.toNNReal (B / δ)) : ℝ) * dist a b := by
            gcongr; exact le_max_right _ _
    refine LipschitzWith.of_dist_le_mul fun a b => ?_
    by_cases ha : a ∈ T <;> by_cases hb : b ∈ T
    · rw [hgT a ha, hgT b hb]
      calc dist (ζ (G a)) (ζ (G b)) ≤ K₁ * dist a b := hK₁.dist_le_mul a ha b hb
        _ ≤ _ := by gcongr; exact le_max_left _ _
    · by_cases haS : a ∈ S
      · exact hfar a b haS hb
      · rw [hg0 a haS, hg0 b fun h => hb (hST h), dist_self]; positivity
    · by_cases hbS : b ∈ S
      · rw [dist_comm, dist_comm a b]; exact hfar b a hbS ha
      · rw [hg0 a fun h => ha (hST h), hg0 b hbS, dist_self]; positivity
    · rw [hg0 a fun h => ha (hST h), hg0 b fun h => hb (hST h), dist_self]; positivity
  -- step 4: mollification
  obtain ⟨gs, hgs_smooth, hgs_supp, hgs_unif, hgs_L2⟩ :=
    Submission.codim1_hcp_lsa_mollify_lipschitz_compact_support m g _ S δ hgLip hSc hg0 hδpos
  -- step 5: the cutoff `β`, smooth, `= 1` near `K' = G(T)`, `tsupport β ⊆ W`
  set K' : Set (Euclid P) := G '' T with hK'
  have hK'c : IsCompact K' := hTc.image_of_continuousOn (hGcont.mono hTball)
  have hK'MW : K' ⊆ M ∩ W := by rintro _ ⟨a, ha, rfl⟩; exact hGMW a (hTball ha)
  obtain ⟨ε, hε, hεW⟩ := hK'c.exists_cthickening_subset_open hWo fun x hx => (hK'MW hx).2
  obtain ⟨β, hβs, hβr, hβsupp, hβ1⟩ := exists_contDiff_support_eq_eq_one_iff (n := (⊤ : ℕ∞))
    (Metric.isOpen_thickening (δ := ε) (E := K'))
    (Metric.isClosed_cthickening (δ := ε / 2) (E := K'))
    (Metric.cthickening_subset_thickening' hε (by linarith) K')
  have htsβ : tsupport β ⊆ Metric.cthickening ε K' := by
    rw [tsupport, hβsupp]; exact Metric.closure_thickening_subset_cthickening ε K'
  have hβcs : HasCompactSupport β :=
    hK'c.cthickening.of_isClosed_subset (isClosed_tsupport β) htsβ
  have hβ0 : ∀ x, x ∉ W → x ∉ tsupport β := fun x hx h => hx (hεW (htsβ h))
  have hβone : ∀ x ∈ Metric.thickening (ε / 2) K', β x = 1 := fun x hx =>
    (hβ1 x).1 (Metric.thickening_subset_cthickening _ _ hx)
  have hK'thick : K' ⊆ Metric.thickening (ε / 2) K' :=
    Metric.self_subset_thickening (by positivity) K'
  have hprc : ContDiff ℝ (⊤ : ℕ∞) (fun z : Euclid P => pr (z - p)) := by fun_prop
  -- step 6: the approximants `ζₖ = β · gₖ ∘ pr(· − p)` and `C' = K'`
  refine ⟨K', fun k z => β z * gs k (pr (z - p)), hK'c, fun x hx => (hK'MW hx).1,
    fun k => ⟨hβs.mul ((hgs_smooth k).comp hprc), hβcs.mul_right⟩, ?_, ?_, ?_⟩
  · -- step 7: `ζₖ = 0` on `M \ K'`
    intro k x hxM hxK
    by_cases hxW : x ∈ W
    · obtain ⟨ha, hGa⟩ := hrep x ⟨hxM, hxW⟩
      have haT : pr (x - p) ∉ T := fun h => hxK ⟨_, h, hGa⟩
      simp only [hgs_supp k _ haT, mul_zero]
    · simp only [image_eq_zero_of_notMem_tsupport (hβ0 x hxW), zero_mul]
  · -- step 8: uniform convergence on `M`, read off in chart coordinates
    rw [Metric.tendstoUniformlyOn_iff]
    intro ε' hε'
    filter_upwards [Metric.tendstoUniformly_iff.1 hgs_unif ε' hε'] with k hk x hxM
    by_cases hxW : x ∈ W
    · obtain ⟨ha, hGa⟩ := hrep x ⟨hxM, hxW⟩
      have hζx : ζ x = g (pr (x - p)) := by rw [hg_ball _ ha, hGa]
      by_cases haT : pr (x - p) ∈ T
      · rw [hβone x (hK'thick ⟨_, haT, hGa⟩), one_mul, hζx]; exact hk _
      · rw [hgs_supp k _ haT, mul_zero, hζx, hg0 _ fun h => haT (hST h), dist_self]; exact hε'
    · rw [image_eq_zero_of_notMem_tsupport (hβ0 x hxW), zero_mul,
        hζC x hxM fun h => hxW (hCMW h).2, dist_self]
      exact hε'
  · -- steps 9–11: the tangential gradient error
    set w : Euclid P → Fin P → Euclid P := fun x j =>
      (Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1) with hw
    -- step 9: `∑ⱼ λ(pr(Pₓeⱼ))² ≤ ‖λ‖²`, via the Riesz vector of `λ ∘ pr ∘ Pₓ`
    have halg : ∀ (l : Euclid m →L[ℝ] ℝ) (x : Euclid P),
        ∑ j : Fin P, (l (pr (w x j))) ^ 2 ≤ ‖l‖ ^ 2 := by
      intro l x
      set ℓ : Euclid P →L[ℝ] ℝ :=
        (l.comp pr).comp (Submodule.span ℝ (tangentSpace M x)).starProjection
      set u : Euclid P := (InnerProductSpace.toDual ℝ (Euclid P)).symm ℓ
      have hu : ∀ v, ℓ v = inner ℝ u v := fun v => (InnerProductSpace.toDual_symm_apply).symm
      have hcoord : ∀ j : Fin P, l (pr (w x j)) = u j := by
        intro j
        have := hu (EuclideanSpace.single j 1)
        rw [EuclideanSpace.inner_single_right] at this
        simpa [ℓ, w] using this
      have hnorm : ‖u‖ = ‖ℓ‖ := LinearIsometryEquiv.norm_map _ _
      have hℓ : ‖ℓ‖ ≤ ‖l‖ := by
        calc ‖ℓ‖ ≤ ‖l.comp pr‖ * ‖(Submodule.span ℝ (tangentSpace M x)).starProjection‖ :=
              ContinuousLinearMap.opNorm_comp_le _ _
          _ ≤ (‖l‖ * ‖pr‖) * 1 := by
              gcongr
              · exact ContinuousLinearMap.opNorm_comp_le _ _
              · exact Submodule.starProjection_norm_le _
          _ ≤ ‖l‖ * 1 * 1 := by gcongr
          _ = ‖l‖ := by ring
      calc ∑ j : Fin P, (l (pr (w x j))) ^ 2 = ∑ j : Fin P, (u j) ^ 2 := by simp_rw [hcoord]
        _ = ‖u‖ ^ 2 := (EuclideanSpace.real_norm_sq_eq u).symm
        _ ≤ ‖l‖ ^ 2 := by rw [hnorm]; gcongr
    -- the Borel chart majorant `Hₖ(z) = ‖Dgₖ(pr(z − p)) − Dg(pr(z − p))‖²`
    set H : ℕ → Euclid P → ℝ≥0∞ := fun k z =>
      ENNReal.ofReal (‖fderiv ℝ (gs k) (pr (z - p)) - fderiv ℝ g (pr (z - p))‖ ^ 2) with hH
    have hHm : ∀ k, Measurable (H k) := by
      intro k
      have h1 : Measurable fun z : Euclid P => fderiv ℝ (gs k) (pr (z - p)) :=
        (measurable_fderiv ℝ (gs k)).comp (by fun_prop)
      have h2 : Measurable fun z : Euclid P => fderiv ℝ g (pr (z - p)) :=
        (measurable_fderiv ℝ g).comp (by fun_prop)
      exact ((h1.sub h2).norm.pow_const 2).ennreal_ofReal
    have hζdiff := Submission.codim1_hcp_lsa_rademacher_on_submanifold P m M ζ hM hζ
    -- step 10: the pointwise bound by `1_W · Hₖ`, `H^m`-a.e. on `M`
    have hpt : ∀ k, ∀ᵐ x ∂(μHE[m].restrict M), ENNReal.ofReal (∑ j : Fin P,
        (fderiv ℝ (fun z => β z * gs k (pr (z - p))) x (w x j) -
          fderivWithin ℝ ζ M x (w x j)) ^ 2) ≤ W.indicator (H k) x := by
      intro k
      filter_upwards [hζdiff, ae_restrict_mem hMmeas] with x hxd hxM
      by_cases hxW : x ∈ W
      · rw [indicator_of_mem hxW]
        obtain ⟨ha, hGa⟩ := hrep x ⟨hxM, hxW⟩
        set a := pr (x - p) with ha_def
        -- (i) `Dg(a) = d^M_xζ ∘ DG(a)`
        have hGd : HasFDerivAt G (fderiv ℝ G a) a :=
          ((hGc.contDiffAt (isOpen_ball.mem_nhds ha)).differentiableAt one_ne_zero).hasFDerivAt
        have hGM : MapsTo G (ball 0 r) M := fun b hb => (hGMW b hb).1
        have hcomp : HasFDerivAt (ζ ∘ G) ((fderivWithin ℝ ζ M x).comp (fderiv ℝ G a)) a := by
          have hxd' : HasFDerivWithinAt ζ (fderivWithin ℝ ζ M x) M (G a) := by
            rw [hGa]; exact hxd.hasFDerivWithinAt
          exact (hxd'.comp a hGd.hasFDerivWithinAt hGM).hasFDerivAt (isOpen_ball.mem_nhds ha)
        have hgeq : g =ᶠ[𝓝 a] ζ ∘ G := by
          filter_upwards [isOpen_ball.mem_nhds ha] with b hb
          exact hg_ball b hb
        have hDg : fderiv ℝ g a = (fderivWithin ℝ ζ M x).comp (fderiv ℝ G a) :=
          (hcomp.congr_of_eventuallyEq hgeq).fderiv
        -- (ii) `Dζₖ(x) = Dgₖ(a) ∘ pr`
        have hDζs : fderiv ℝ (fun z => β z * gs k (pr (z - p))) x =
            (fderiv ℝ (gs k) a).comp pr := by
          have hprd : HasFDerivAt (fun z : Euclid P => pr (z - p)) pr x := by
            have h := (pr.hasFDerivAt (x := x - p)).comp x ((hasFDerivAt_id x).sub_const p)
            rw [ContinuousLinearMap.comp_id] at h
            exact h
          by_cases haT : a ∈ T
          · have hxK : x ∈ Metric.thickening (ε / 2) K' := hK'thick ⟨a, haT, hGa⟩
            have heq : (fun z => β z * gs k (pr (z - p))) =ᶠ[𝓝 x]
                fun z => gs k (pr (z - p)) := by
              filter_upwards [Metric.isOpen_thickening.mem_nhds hxK] with z hz
              rw [hβone z hz, one_mul]
            rw [heq.fderiv_eq]
            have hgsd : HasFDerivAt (gs k) (fderiv ℝ (gs k) a) a :=
              ((hgs_smooth k).differentiable (by simp) a).hasFDerivAt
            exact (hgsd.comp x hprd).fderiv
          · have hnhds : (fun z : Euclid P => pr (z - p)) ⁻¹' Tᶜ ∈ 𝓝 x :=
              (Metric.isClosed_cthickening.isOpen_compl.preimage (by fun_prop)).mem_nhds haT
            have heq : (fun z => β z * gs k (pr (z - p))) =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
              filter_upwards [hnhds] with z hz
              rw [hgs_supp k _ hz, mul_zero]
            have hga : gs k =ᶠ[𝓝 a] fun _ => (0 : ℝ) := by
              filter_upwards [Metric.isClosed_cthickening.isOpen_compl.mem_nhds haT] with b hb
              exact hgs_supp k b hb
            rw [heq.fderiv_eq, hga.fderiv_eq]
            simp
        -- (iii) `Pₓeⱼ = DG(a)(pr(Pₓeⱼ))`, since `T_xM = range DG(a)` and `pr ∘ DG(a) = id`
        have hwj : ∀ j, fderiv ℝ G a (pr (w x j)) = w x j := by
          intro j
          have hmem0 := Submodule.starProjection_apply_mem (Submodule.span ℝ (tangentSpace M x))
            (EuclideanSpace.single j (1 : ℝ))
          have hle : Submodule.span ℝ (tangentSpace M x) ≤ LinearMap.range
              ((fderiv ℝ G a : Euclid m →L[ℝ] Euclid P) : Euclid m →ₗ[ℝ] Euclid P) := by
            rw [Submodule.span_le, ← hGa, htan a ha]
            rintro _ ⟨y, rfl⟩
            exact ⟨y, rfl⟩
          obtain ⟨h, hh⟩ := LinearMap.mem_range.1 (hle hmem0)
          have hh' : fderiv ℝ G a h = w x j := hh
          rw [← hh']
          congr 1
          have := congrArg (fun T => T h) (hderiv a ha)
          simpa using this
        -- (iv) the error is `(Dgₖ(a) − Dg(a))(pr(Pₓeⱼ))`; apply step 9
        have herr : ∀ j, fderiv ℝ (fun z => β z * gs k (pr (z - p))) x (w x j) -
            fderivWithin ℝ ζ M x (w x j) = (fderiv ℝ (gs k) a - fderiv ℝ g a) (pr (w x j)) := by
          intro j
          rw [hDζs, hDg]
          simp only [ContinuousLinearMap.comp_apply, sub_apply, hwj j]
        simp_rw [herr]
        exact ENNReal.ofReal_le_ofReal (halg _ x)
      · rw [indicator_of_notMem hxW]
        -- off `W`: `ζₖ = 0` near `x`, and `ζ` has derivative `0` within `M` at `x`
        have hxC : x ∉ C := fun h => hxW (hCMW h).2
        have hz1 : (fun z => β z * gs k (pr (z - p))) =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
          filter_upwards [(notMem_tsupport_iff_eventuallyEq.1 (hβ0 x hxW))] with z hz
          rw [hz, Pi.zero_apply, zero_mul]
        have hz2 : HasFDerivWithinAt ζ (0 : Euclid P →L[ℝ] ℝ) M x := by
          have h0 : HasFDerivWithinAt (fun _ : Euclid P => (0 : ℝ)) (0 : Euclid P →L[ℝ] ℝ) M x :=
            hasFDerivWithinAt_const 0 x M
          refine h0.congr_of_eventuallyEq ?_ (hζC x hxM hxC)
          filter_upwards [inter_mem_nhdsWithin M (hCc.isClosed.isOpen_compl.mem_nhds hxC)]
            with y hy
          exact hζC y hy.1 hy.2
        have hterm : ∀ j, fderiv ℝ (fun z => β z * gs k (pr (z - p))) x (w x j) -
            fderivWithin ℝ ζ M x (w x j) = 0 := by
          intro j
          rw [hz1.fderiv_eq,
            Submission.codim1_hcp_lsa_fderivWithin_eq_on_tangent_span P M ζ 0 x (w x j) hz2
              (Submodule.starProjection_apply_mem _ _)]
          simp
        have hsum0 : ∑ j : Fin P, (fderiv ℝ (fun z => β z * gs k (pr (z - p))) x (w x j) -
            fderivWithin ℝ ζ M x (w x j)) ^ 2 = 0 := by
          simp only [hterm]; simp
        rw [hsum0, ENNReal.ofReal_zero]
    -- step 11: integrate, transfer to the chart ball, and pass to the limit
    have hint : ∀ k, ∫⁻ x in M, ENNReal.ofReal (∑ j : Fin P,
        (fderiv ℝ (fun z => β z * gs k (pr (z - p))) x (w x j) -
          fderivWithin ℝ ζ M x (w x j)) ^ 2) ∂μHE[m] ≤ (Λ : ℝ≥0∞) ^ m *
            ∫⁻ a, ENNReal.ofReal (‖fderiv ℝ (gs k) a - fderiv ℝ g a‖ ^ 2) := by
      intro k
      have hWm : MeasurableSet W := hWo.measurableSet
      calc _ ≤ ∫⁻ x in M, W.indicator (H k) x ∂μHE[m] := lintegral_mono_ae (hpt k)
        _ = ∫⁻ x in G '' ball 0 r, H k x ∂μHE[m] := by
            rw [lintegral_indicator hWm, Measure.restrict_restrict hWm, inter_comm, hMW]
        _ ≤ (Λ : ℝ≥0∞) ^ m * ∫⁻ a in ball (0 : Euclid m) r, H k (G a) :=
            (Submission.codim1_hcp_lsa_lipschitz_image_lintegral_le m P G (ball 0 r) Λ hGL).2
              measurableSet_ball (H k) (hHm k)
        _ = (Λ : ℝ≥0∞) ^ m * ∫⁻ a in ball (0 : Euclid m) r,
              ENNReal.ofReal (‖fderiv ℝ (gs k) a - fderiv ℝ g a‖ ^ 2) := by
            congr 1
            refine setLIntegral_congr_fun measurableSet_ball fun a ha => ?_
            simp only [hH, hleft a ha]
        _ ≤ _ := mul_le_mul_right (setLIntegral_le_lintegral _ _) _
    have hlim : Tendsto (fun k => (Λ : ℝ≥0∞) ^ m *
        ∫⁻ a, ENNReal.ofReal (‖fderiv ℝ (gs k) a - fderiv ℝ g a‖ ^ 2)) atTop (𝓝 0) := by
      have := ENNReal.Tendsto.const_mul (a := (Λ : ℝ≥0∞) ^ m) hgs_L2
        (Or.inr (ENNReal.pow_ne_top ENNReal.coe_ne_top))
      simpa using this
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hlim (fun k => zero_le) hint
/-- **Calculus of locally Lipschitz functions on a `C¹` submanifold** (Simon Ch. 2, 4.4–4.9).
Let `M ⊆ ℝᴾ` be an embedded `C¹` `m`-submanifold and `P_x` the orthogonal projection onto
`span T_xM`.  (i) For `ζ` locally Lipschitz on `M`, `x ↦ d^M_xζ(P_xe_j)` is a.e. strongly
measurable for `Hᵐ⌞M`: evaluate the a.e. strongly measurable operator `d^M_xζ ∘ P_x` at `e_j`.
(ii) If moreover `ζ = 0` on `M` off a compact `C ⊆ M`, cover `C` by finitely many open sets
`W_p ∩ B₁(p)`, `p ∈ C`, where `W_p` carries one-chart approximations, and split `ζ = Σᵢ χᵢζ` on
`M` by a smooth partition of unity `χᵢ` on `C` subordinate to this cover.  Each piece `χᵢζ` is
locally Lipschitz on `M` and vanishes on `M` off the compact `C ∩ spt χᵢ`, so it has approximants
`ζ_{i,k}`; put `ζ_k = Σᵢ ζ_{i,k}`.  At `Hᵐ`-a.e. `x ∈ M` every piece is differentiable within `M`,
so `d^M_xζ = Σᵢ d^M_x(χᵢζ)` on `span T_xM`, and Cauchy–Schwarz over the pieces bounds the
gradient error of `ζ_k` by `#pieces` times the sum of the (a.e. measurable) errors of the pieces,
each of which tends to `0`. -/
theorem Submission.codim1_hcp_lipschitz_smooth_approx : ∀ (P m : ℕ) (M : Set (Euclid P)), IsEmbeddedSubmanifold 1 m M → (∀ (ζ : Euclid P → ℝ), LocallyLipschitzOn M ζ → ∀ j : Fin P, AEStronglyMeasurable (fun x => fderivWithin ℝ ζ M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) (μHE[m].restrict M)) ∧ ∀ (ζ : Euclid P → ℝ), LocallyLipschitzOn M ζ → (∃ C : Set (Euclid P), IsCompact C ∧ C ⊆ M ∧ ∀ x ∈ M, x ∉ C → ζ x = 0) → ∃ (C' : Set (Euclid P)) (ζs : ℕ → Euclid P → ℝ), IsCompact C' ∧ C' ⊆ M ∧ (∀ k, ContDiff ℝ (⊤ : ℕ∞) (ζs k) ∧ HasCompactSupport (ζs k)) ∧ (∀ k, ∀ x ∈ M, x ∉ C' → ζs k x = 0) ∧ TendstoUniformlyOn ζs ζ atTop M ∧ Tendsto (fun k => ∫⁻ x in M, ENNReal.ofReal (∑ j : Fin P, (fderiv ℝ (ζs k) x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1)) - fderivWithin ℝ ζ M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) ^ 2) ∂μHE[m]) atTop (𝓝 0) := by
  intro P m M hM
  have hMmeas : MeasurableSet M := (Submission.dimred_rpd_embedded_locally_closed P 1 m M hM).1
  -- the tangent projections `P_x e_j` are a.e. strongly measurable on `M`
  have hPj : ∀ j : Fin P, AEStronglyMeasurable
      (fun x => (Submodule.span ℝ (tangentSpace M x)).starProjection
        (EuclideanSpace.single j (1 : ℝ))) (μHE[m].restrict M) := by
    intro j
    have hc := Submission.codim1_hcp_lsa_tangent_projection_continuousOn P m M hM
    exact ((ContinuousLinearMap.apply ℝ (Euclid P)
      (EuclideanSpace.single j (1 : ℝ))).continuous.comp_continuousOn hc).aestronglyMeasurable
        hMmeas
  -- part (i): evaluate the operator `d^M_xζ ∘ P_x` at `e_j`
  have part_i : ∀ (ζ : Euclid P → ℝ), LocallyLipschitzOn M ζ → ∀ j : Fin P,
      AEStronglyMeasurable (fun x => fderivWithin ℝ ζ M x
        ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1)))
        (μHE[m].restrict M) := by
    intro ζ hζ j
    exact (ContinuousLinearMap.apply ℝ ℝ
      (EuclideanSpace.single j (1 : ℝ))).continuous.comp_aestronglyMeasurable
        (Submission.codim1_hcp_lsa_tangential_derivative_aesm P m M ζ hM hζ)
  refine ⟨part_i, ?_⟩
  -- part (ii)
  rintro ζ hζ ⟨C, hCc, hCM, hζC⟩
  -- open sets `W p ∋ p` carrying one-chart approximations
  choose! W hWo hpW hWapprox using Submission.codim1_hcp_lsa_local_chart_approx P m M hM
  -- a finite subcover of `C` by the sets `W p ∩ B₁(p)`, `p ∈ C`
  obtain ⟨t, htC, hCt⟩ := hCc.elim_nhds_subcover (fun p => W p ∩ ball p 1) fun p hp =>
    ((hWo p (hCM hp)).inter isOpen_ball).mem_nhds ⟨hpW p (hCM hp), mem_ball_self one_pos⟩
  let ι := {p // p ∈ t}
  let U : ι → Set (Euclid P) := fun i => W i.1 ∩ ball i.1 1
  have hUo : ∀ i, IsOpen (U i) := fun i => (hWo i.1 (hCM (htC i.1 i.2))).inter isOpen_ball
  have hCU : C ⊆ ⋃ i, U i := by
    intro x hx
    obtain ⟨p, hp, hxp⟩ := mem_iUnion₂.1 (hCt hx)
    exact mem_iUnion.2 ⟨⟨p, hp⟩, hxp⟩
  -- a smooth partition of unity `χᵢ = f i` on `C` subordinate to the cover
  obtain ⟨f, hf⟩ := SmoothPartitionOfUnity.exists_isSubordinate
    (modelWithCornersSelf ℝ (Euclid P)) hCc.isClosed U hUo hCU
  have hfsmooth : ∀ i, ContDiff ℝ (⊤ : ℕ∞) (f i) := fun i =>
    contMDiff_iff_contDiff.1 (f i).contMDiff
  have hfsum : ∀ x ∈ C, ∑ i, f i x = 1 := by
    intro x hx
    rw [← finsum_eq_sum_of_fintype]
    exact f.sum_eq_one hx
  -- the pieces `ζᵢ = χᵢ ζ`, with `ζ = Σᵢ ζᵢ` on `M`
  let ζi : ι → Euclid P → ℝ := fun i x => f i x * ζ x
  have hζeq : ∀ x ∈ M, ζ x = ∑ i, ζi i x := by
    intro x hx
    by_cases hxC : x ∈ C
    · simp only [ζi, ← Finset.sum_mul, hfsum x hxC, one_mul]
    · simp [ζi, hζC x hx hxC]
  -- each piece is locally Lipschitz on `M`: near `x`, `χᵢ` is Lipschitz with values in `[0, 1]`
  -- and `ζ` is Lipschitz and bounded by `|ζ x| + K`
  have hζiLip : ∀ i, LocallyLipschitzOn M (ζi i) := by
    intro i x hx
    obtain ⟨K, s, hs, hKs⟩ := hζ hx
    obtain ⟨L, u, hu, hLu⟩ := ((hfsmooth i).of_le (by exact_mod_cast le_top)).locallyLipschitz x
    have hxs : x ∈ s := mem_of_mem_nhdsWithin hx hs
    refine ⟨K + Real.toNNReal (|ζ x| + K) * L, s ∩ u ∩ closedBall x 1,
      inter_mem (inter_mem hs (mem_nhdsWithin_of_mem_nhds hu))
        (mem_nhdsWithin_of_mem_nhds (closedBall_mem_nhds x one_pos)), ?_⟩
    refine LipschitzOnWith.of_dist_le_mul fun y hy z hz => ?_
    have hζyz := hKs.dist_le_mul y hy.1.1 z hz.1.1
    have hfyz := hLu.dist_le_mul y hy.1.2 z hz.1.2
    have hζz : |ζ z| ≤ |ζ x| + K := by
      have h1 := hKs.dist_le_mul z hz.1.1 x hxs
      have h2 : dist z x ≤ 1 := hz.2
      rw [Real.dist_eq] at h1
      have h3 : |ζ z| ≤ |ζ x| + |ζ z - ζ x| := by
        have := abs_add_le (ζ x) (ζ z - ζ x); simpa using this
      nlinarith [abs_nonneg (ζ z - ζ x), NNReal.coe_nonneg K]
    have hfy : |f i y| ≤ 1 := by rw [abs_of_nonneg (f.nonneg i y)]; exact f.le_one i y
    rw [Real.dist_eq] at hζyz hfyz ⊢
    have hkey : f i y * ζ y - f i z * ζ z =
        f i y * (ζ y - ζ z) + ζ z * (f i y - f i z) := by ring
    simp only [ζi]
    rw [hkey]
    have hdist : 0 ≤ dist y z := dist_nonneg
    calc |f i y * (ζ y - ζ z) + ζ z * (f i y - f i z)|
        ≤ |f i y| * |ζ y - ζ z| + |ζ z| * |f i y - f i z| := by
          refine (abs_add_le _ _).trans ?_; rw [abs_mul, abs_mul]
      _ ≤ 1 * (K * dist y z) + (|ζ x| + K) * (L * dist y z) := by gcongr
      _ = ((K + Real.toNNReal (|ζ x| + K) * L : NNReal) : ℝ) * dist y z := by
          rw [NNReal.coe_add, NNReal.coe_mul, Real.coe_toNNReal _ (by positivity)]; ring
  -- one-chart approximations of the pieces
  have happ : ∀ i : ι, ∃ (C' : Set (Euclid P)) (ζs : ℕ → Euclid P → ℝ), IsCompact C' ∧
      C' ⊆ M ∧ (∀ k, ContDiff ℝ (⊤ : ℕ∞) (ζs k) ∧ HasCompactSupport (ζs k)) ∧
      (∀ k, ∀ x ∈ M, x ∉ C' → ζs k x = 0) ∧ TendstoUniformlyOn ζs (ζi i) atTop M ∧
      Tendsto (fun k => ∫⁻ x in M, ENNReal.ofReal (∑ j : Fin P,
        (fderiv ℝ (ζs k) x ((Submodule.span ℝ (tangentSpace M x)).starProjection
          (EuclideanSpace.single j 1)) - fderivWithin ℝ (ζi i) M x
          ((Submodule.span ℝ (tangentSpace M x)).starProjection
            (EuclideanSpace.single j 1))) ^ 2) ∂μHE[m]) atTop (𝓝 0) := by
    intro i
    refine hWapprox i.1 (hCM (htC i.1 i.2)) (ζi i) (hζiLip i)
      ⟨C ∩ tsupport (f i), hCc.inter_right (isClosed_tsupport _), ?_, ?_⟩
    · -- `C ∩ spt χᵢ ⊆ M ∩ W pᵢ`
      intro x hx
      exact ⟨hCM hx.1, (hf i hx.2).1⟩
    · -- `ζᵢ = 0` on `M` off `C ∩ spt χᵢ`
      intro x hxM hx
      by_cases hxC : x ∈ C
      · have hxt : x ∉ tsupport (f i) := fun h => hx ⟨hxC, h⟩
        simp [ζi, image_eq_zero_of_notMem_tsupport hxt]
      · simp [ζi, hζC x hxM hxC]
  choose C'i ζsi hC'c hC'M hζsi hζsi0 hζsiU hζsiL using happ
  -- `C' = ⋃ᵢ C'ᵢ` and `ζ_k = Σᵢ ζ_{i,k}`
  refine ⟨⋃ i, C'i i, fun k => ∑ i, ζsi i k, isCompact_iUnion hC'c, iUnion_subset hC'M,
    fun k => ⟨?_, HasCompactSupport.finset_sum fun i _ => (hζsi i k).2⟩, ?_, ?_, ?_⟩
  · -- smoothness
    show ContDiff ℝ _ (∑ i, ζsi i k)
    rw [Finset.sum_fn]
    exact ContDiff.sum fun i _ => (hζsi i k).1
  · -- `ζ_k = 0` on `M ∖ C'`
    intro k x hx hxC'
    show (∑ i, ζsi i k) x = 0
    rw [Finset.sum_apply]
    exact Finset.sum_eq_zero fun i _ => hζsi0 i k x hx fun h => hxC' (mem_iUnion.2 ⟨i, h⟩)
  · -- uniform convergence on `M`
    have hsum : ∀ s : Finset ι, TendstoUniformlyOn (fun k x => ∑ i ∈ s, ζsi i k x)
        (fun x => ∑ i ∈ s, ζi i x) atTop M := by
      intro s
      induction s using Finset.induction_on with
      | empty =>
        simp only [Finset.sum_empty]
        exact Metric.tendstoUniformlyOn_iff.2 fun ε hε =>
          Eventually.of_forall fun k x _ => by simpa using hε
      | insert a s ha ih =>
        simp only [Finset.sum_insert ha]
        exact (hζsiU a).add ih
    refine ((hsum Finset.univ).congr_right fun x hx => (hζeq x hx).symm).congr ?_
    exact Eventually.of_forall fun k x _ => by simp [Finset.sum_apply]
  · -- convergence of the tangential gradients
    set w : Euclid P → Fin P → Euclid P := fun x j =>
      (Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1)
    have hwmem : ∀ x j, w x j ∈ Submodule.span ℝ (tangentSpace M x) := fun x j =>
      Submodule.starProjection_apply_mem _ _
    -- `Hᵐ`-a.e. on `M` every piece is differentiable within `M`
    have hdiff : ∀ᵐ x ∂(μHE[m].restrict M),
        x ∈ M ∧ ∀ i, DifferentiableWithinAt ℝ (ζi i) M x := by
      have h1 : ∀ i, ∀ᵐ x ∂(μHE[m].restrict M), DifferentiableWithinAt ℝ (ζi i) M x :=
        fun i => Submission.codim1_hcp_lsa_rademacher_on_submanifold P m M (ζi i) hM (hζiLip i)
      filter_upwards [ae_restrict_mem hMmeas, Filter.eventually_all.2 h1] with x hx hx'
      exact ⟨hx, hx'⟩
    -- there `d^M_xζ = Σᵢ d^M_xζᵢ` on `span T_xM`, so the error of `ζ_k` is the sum of the errors
    -- of the pieces
    have hsplit : ∀ k, ∀ᵐ x ∂(μHE[m].restrict M), ∀ j,
        fderiv ℝ (∑ i, ζsi i k) x (w x j) - fderivWithin ℝ ζ M x (w x j) =
          ∑ i, (fderiv ℝ (ζsi i k) x (w x j) - fderivWithin ℝ (ζi i) M x (w x j)) := by
      intro k
      filter_upwards [hdiff] with x hx j
      obtain ⟨hxM, hxd⟩ := hx
      have hsum : HasFDerivWithinAt (∑ i, ζi i) (∑ i, fderivWithin ℝ (ζi i) M x) M x :=
        HasFDerivWithinAt.sum fun i _ => (hxd i).hasFDerivWithinAt
      have hζd : HasFDerivWithinAt ζ (∑ i, fderivWithin ℝ (ζi i) M x) M x :=
        hsum.congr (fun y hy => by rw [Finset.sum_apply]; exact hζeq y hy)
          (by rw [Finset.sum_apply]; exact hζeq x hxM)
      have hW := Submission.codim1_hcp_lsa_fderivWithin_eq_on_tangent_span P M ζ _ x (w x j)
        hζd (hwmem x j)
      have hD : fderiv ℝ (∑ i, ζsi i k) x = ∑ i, fderiv ℝ (ζsi i k) x :=
        fderiv_sum fun i _ => ((hζsi i k).1.differentiable (by simp)).differentiableAt
      rw [hW, hD, sum_apply, sum_apply, ← Finset.sum_sub_distrib]
    -- the errors of the pieces are a.e. measurable
    set n : ℕ := Fintype.card ι with hn
    let Fi : ι → ℕ → Euclid P → ℝ≥0∞ := fun i k x => ENNReal.ofReal (∑ j : Fin P,
      (fderiv ℝ (ζsi i k) x (w x j) - fderivWithin ℝ (ζi i) M x (w x j)) ^ 2)
    have hFi_meas : ∀ i k, AEMeasurable (Fi i k) (μHE[m].restrict M) := by
      intro i k
      refine AEMeasurable.ennreal_ofReal ?_
      refine (Finset.aestronglyMeasurable_fun_sum _ fun j _ => ?_).aemeasurable
      have hcont : Continuous (fderiv ℝ (ζsi i k)) := (hζsi i k).1.continuous_fderiv (by simp)
      have h1 : AEStronglyMeasurable (fun x => fderiv ℝ (ζsi i k) x (w x j))
          (μHE[m].restrict M) :=
        isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable
          (hcont.aestronglyMeasurable.prodMk (hPj j))
      exact (h1.sub (part_i (ζi i) (hζiLip i) j)).pow 2
    -- pointwise Cauchy–Schwarz over the pieces
    have hbound : ∀ k, ∀ᵐ x ∂(μHE[m].restrict M), ENNReal.ofReal (∑ j : Fin P,
        (fderiv ℝ (∑ i, ζsi i k) x (w x j) - fderivWithin ℝ ζ M x (w x j)) ^ 2) ≤
          (n : ℝ≥0∞) * ∑ i, Fi i k x := by
      intro k
      filter_upwards [hsplit k] with x hx
      have hcs : ∀ j : Fin P,
          (∑ i, (fderiv ℝ (ζsi i k) x (w x j) - fderivWithin ℝ (ζi i) M x (w x j))) ^ 2 ≤
            (n : ℝ) * ∑ i, (fderiv ℝ (ζsi i k) x (w x j) -
              fderivWithin ℝ (ζi i) M x (w x j)) ^ 2 := by
        intro j
        have := Finset.sum_mul_sq_le_sq_mul_sq Finset.univ (fun _ : ι => (1 : ℝ))
          (fun i => fderiv ℝ (ζsi i k) x (w x j) - fderivWithin ℝ (ζi i) M x (w x j))
        simpa [hn] using this
      calc ENNReal.ofReal (∑ j : Fin P,
            (fderiv ℝ (∑ i, ζsi i k) x (w x j) - fderivWithin ℝ ζ M x (w x j)) ^ 2)
          = ENNReal.ofReal (∑ j : Fin P, (∑ i, (fderiv ℝ (ζsi i k) x (w x j) -
              fderivWithin ℝ (ζi i) M x (w x j))) ^ 2) := by simp_rw [hx]
        _ ≤ ENNReal.ofReal (∑ j : Fin P, (n : ℝ) * ∑ i, (fderiv ℝ (ζsi i k) x (w x j) -
              fderivWithin ℝ (ζi i) M x (w x j)) ^ 2) :=
            ENNReal.ofReal_le_ofReal (Finset.sum_le_sum fun j _ => hcs j)
        _ = (n : ℝ≥0∞) * ∑ i, Fi i k x := by
            rw [← Finset.mul_sum, Finset.sum_comm, ENNReal.ofReal_mul (by positivity),
              ENNReal.ofReal_natCast, ENNReal.ofReal_sum_of_nonneg fun i _ => by positivity]
    -- integrate, split the finite sum, and pass to the limit
    have hint : ∀ k, ∫⁻ x in M, ENNReal.ofReal (∑ j : Fin P,
        (fderiv ℝ (∑ i, ζsi i k) x (w x j) - fderivWithin ℝ ζ M x (w x j)) ^ 2) ∂μHE[m] ≤
          (n : ℝ≥0∞) * ∑ i, ∫⁻ x in M, Fi i k x ∂μHE[m] := by
      intro k
      calc _ ≤ ∫⁻ x in M, (n : ℝ≥0∞) * ∑ i, Fi i k x ∂μHE[m] :=
            lintegral_mono_ae (hbound k)
        _ = (n : ℝ≥0∞) * ∫⁻ x in M, ∑ i, Fi i k x ∂μHE[m] :=
            lintegral_const_mul' _ _ (ENNReal.natCast_ne_top n)
        _ = (n : ℝ≥0∞) * ∑ i, ∫⁻ x in M, Fi i k x ∂μHE[m] := by
            rw [lintegral_finsetSum' _ fun i _ => hFi_meas i k]
    have hlim : Tendsto (fun k => (n : ℝ≥0∞) * ∑ i, ∫⁻ x in M, Fi i k x ∂μHE[m])
        atTop (𝓝 0) := by
      have := ENNReal.Tendsto.const_mul (tendsto_finsetSum Finset.univ fun i _ => hζsiL i)
        (Or.inr (ENNReal.natCast_ne_top n))
      simpa using this
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hlim (fun k => zero_le) hint

/-- **Tangential derivatives are well defined** (Simon Ch. 2, §4, p. 55; the tangential gradient
of the Simons cone step): for any set `M ⊆ ℝᴾ` and real normed space `E`, if `f : ℝᴾ → E` has
derivative `f'` within `M` at `x`, then `fderivWithin ℝ f M x` agrees with `f'` on the span of
`T_xM`.  `L = fderivWithin ℝ f M x` is itself a derivative of `f` within `M` at `x`, and two
derivatives within `M` agree on the tangent cone of `M` at `x`.  Each `w = γ'(0) ∈ T_xM` lies in
that cone: with `sₙ = 1/(n+2) ∈ (−1, 1)` and `dₙ = γ(sₙ) − x`, `dₙ → 0`, `x + dₙ = γ(sₙ) ∈ M` and
`(n+2) dₙ = sₙ⁻¹(γ(sₙ) − γ(0)) → w`.  So `L = f'` on `T_xM`, hence on its linear span. -/
theorem Submission.codim1_hcp_sc_fderivWithin_tangent_eq : ∀ (P : ℕ) (E : Type) [NormedAddCommGroup E] [NormedSpace ℝ E] (M : Set (Euclid P)) (f : Euclid P → E) (f' : Euclid P →L[ℝ] E) (x : Euclid P), HasFDerivWithinAt f f' M x → ∀ v ∈ Submodule.span ℝ (tangentSpace M x), fderivWithin ℝ f M x v = f' v := by
  intro P E _ _ M f f' x hf v hv
  -- steps 2–3: `L = fderivWithin ℝ f M x` and `f'` are both derivatives of `f` within `M` at
  -- `x`, so they agree on the tangent cone of `M` at `x`
  have huniq : EqOn (fderivWithin ℝ f M x) f' (tangentConeAt ℝ M x) :=
    hf.differentiableWithinAt.hasFDerivWithinAt.unique_on hf
  -- step 1: the velocity `w = γ'(0)` of a curve `γ` in `M` through `x` lies in the tangent cone
  have hcone : tangentSpace M x ⊆ tangentConeAt ℝ M x := by
    rintro w ⟨γ, -, hγM, hγ0, hγw⟩
    -- `sₙ = 1/(n+2)` tends to `0` through nonzero values and lies in `(−1, 1)`
    have hs : Tendsto (fun n : ℕ => 1 / ((n : ℝ) + 2)) atTop (𝓝[≠] 0) :=
      tendsto_nhdsWithin_iff.2 ⟨tendsto_const_nhds.div_atTop
        (tendsto_atTop_add_const_right _ 2 tendsto_natCast_atTop_atTop),
        Eventually.of_forall fun n => by simp only [mem_compl_singleton_iff]; positivity⟩
    have hsI : ∀ n : ℕ, 1 / ((n : ℝ) + 2) ∈ Ioo (-1 : ℝ) 1 := fun n => by
      have hn : (0 : ℝ) ≤ n := n.cast_nonneg
      have hpos : 0 < 1 / ((n : ℝ) + 2) := by positivity
      refine ⟨by linarith, ?_⟩
      rw [div_lt_one (by positivity)]
      linarith
    -- `cₙ = n + 2` and `dₙ = γ(sₙ) − x`
    refine mem_tangentConeAt_of_seq atTop (fun n : ℕ => (n : ℝ) + 2)
      (fun n => γ (1 / ((n : ℝ) + 2)) - x) ?_ ?_ ?_
    · -- `dₙ → γ(0) − x = 0`, since `γ` is continuous at `0`
      rw [tendsto_sub_nhds_zero_iff, ← hγ0]
      exact hγw.continuousAt.tendsto.comp (hs.mono_right nhdsWithin_le_nhds)
    · -- `x + dₙ = γ(sₙ) ∈ M`, as `sₙ ∈ (−1, 1)`
      refine Eventually.of_forall fun n => ?_
      simp only [add_sub_cancel]
      exact hγM (hsI n)
    · -- `cₙ dₙ = sₙ⁻¹(γ(0 + sₙ) − γ(0)) → γ'(0) = w`
      refine (hγw.tendsto_slope_zero.comp hs).congr fun n => ?_
      simp [hγ0]
  -- step 4: `L = f'` on `T_xM`; the set where the linear maps `L` and `f'` agree is a subspace,
  -- so it contains the linear span of `T_xM`
  exact LinearMap.eqOn_span (f := (fderivWithin ℝ f M x : Euclid P →ₗ[ℝ] E))
    (g := (f' : Euclid P →ₗ[ℝ] E)) (fun w hw => huniq (hcone hw)) hv
/-- **The unit normal of a cone is homogeneous of degree `0`** (Simon, Appendix B, proof of
Lemma B.11, (1)–(2)).  Let `M ⊆ A₀` be an embedded `C¹` `m`-submanifold with `tM ⊆ M` for
`t > 0`, and `ν` a `C^∞` unit normal to `M` in `A₀`.  By
`Submission.codim1_hcp_sc_tangent_normal_complement`, `T_yM = {v ∈ A₀ : ν(y) · v = 0}` is a
linear subspace.  The curve `s ↦ eˢx` gives `x ∈ T_xM`, and scaling curves gives
`tT_xM ⊆ T_{tx}M`, hence `T_{tx}M = T_xM`.  So `ν(tx)` is a unit vector in
`A₀ ∩ (T_xM)^⊥ = ℝν(x)`, i.e. `ν(tx) = ±ν(x)`; `t ↦ ν(x) · ν(tx)` is continuous on `(0, ∞)`
and equals `1` at `t = 1`, so the intermediate value theorem gives `ν(tx) = ν(x)`.
Differentiating `ν(tγ(s)) = ν(γ(s))` at `s = 0` along curves `γ` in `M` gives
`tDν(tx)v = Dν(x)v`, and differentiating the constant map `t ↦ ν(tx)` at `t = 1` gives
`Dν(x)x = 0`. -/
theorem Submission.codim1_hcp_sc_cone_normal_homogeneous : ∀ (P m : ℕ) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)) (ν : Euclid P → Euclid P), Module.finrank ℝ A₀ = m + 1 → M ⊆ (A₀ : Set (Euclid P)) → IsEmbeddedSubmanifold 1 m M → (∀ t : ℝ, 0 < t → ∀ x ∈ M, t • x ∈ M) → (∃ O : Set (Euclid P), IsOpen O ∧ M ⊆ O ∧ ContDiffOn ℝ (⊤ : ℕ∞) ν O) → (∀ x ∈ M, ν x ∈ A₀ ∧ ‖ν x‖ = 1 ∧ ∀ v ∈ tangentSpace M x, inner ℝ (ν x) v = 0) → ∀ x ∈ M, x ∈ tangentSpace M x ∧ fderiv ℝ ν x x = 0 ∧ ∀ t : ℝ, 0 < t → tangentSpace M (t • x) = tangentSpace M x ∧ ν (t • x) = ν x ∧ ∀ v ∈ tangentSpace M x, t • fderiv ℝ ν (t • x) v = fderiv ℝ ν x v := by
  intro P m A₀ M ν hdim hMA hM hcone hO hν x hx
  obtain ⟨O, hOo, hMO, hνO⟩ := hO
  -- Step 0: `ν` is differentiable at every point of `M ⊆ O`, and `T_yM = {v ∈ A₀ : ν(y) · v = 0}`
  have hνd : ∀ y ∈ M, HasFDerivAt ν (fderiv ℝ ν y) y := fun y hy =>
    ((hνO.contDiffAt (hOo.mem_nhds (hMO hy))).differentiableAt (by simp)).hasFDerivAt
  have hT : ∀ y ∈ M, tangentSpace M y = {v : Euclid P | v ∈ A₀ ∧ inner ℝ (ν y) v = 0} :=
    fun y hy =>
      (Submission.codim1_hcp_sc_tangent_normal_complement P m A₀ M ν hdim hMA hM hν y hy).1
  -- in particular each `T_yM`, `y ∈ M`, is closed under scalar multiplication
  have hTsmul : ∀ y ∈ M, ∀ (c : ℝ) (v : Euclid P), v ∈ tangentSpace M y →
      c • v ∈ tangentSpace M y := by
    intro y hy c v hv
    rw [hT y hy] at hv ⊢
    exact ⟨A₀.smul_mem c hv.1, by rw [real_inner_smul_right, hv.2, mul_zero]⟩
  -- Step 1: `x ∈ T_xM`, via the curve `s ↦ eˢx` in `M`
  have hxT : x ∈ tangentSpace M x := by
    refine ⟨fun s => Real.exp s • x, (Real.contDiff_exp.smul contDiff_const).contDiffOn,
      fun s _ => hcone _ (Real.exp_pos s) x hx, by simp, ?_⟩
    simpa using (Real.hasDerivAt_exp 0).smul_const x
  -- Step 2: `t • T_yM ⊆ T_{ty}M` for `t > 0`: scale the curves
  have hscale : ∀ t : ℝ, 0 < t → ∀ y v : Euclid P, v ∈ tangentSpace M y →
      t • v ∈ tangentSpace M (t • y) := by
    rintro t ht y v ⟨γ, hγ, hγM, hγ0, hγv⟩
    exact ⟨fun s => t • γ s, hγ.const_smul t, fun s hs => hcone t ht _ (hγM hs),
      by simp [hγ0], hγv.const_smul t⟩
  -- Step 3: `T_{ty}M = T_yM` for `y ∈ M` and `t > 0`
  have hTeq : ∀ y ∈ M, ∀ t : ℝ, 0 < t → tangentSpace M (t • y) = tangentSpace M y := by
    intro y hy t ht
    ext w
    constructor
    · intro hw
      have h1 := hscale t⁻¹ (inv_pos.2 ht) (t • y) w hw
      rw [inv_smul_smul₀ ht.ne'] at h1
      have h2 := hTsmul y hy t _ h1
      rwa [smul_inv_smul₀ ht.ne'] at h2
    · intro hw
      have h1 := hscale t ht y _ (hTsmul y hy t⁻¹ w hw)
      rwa [smul_inv_smul₀ ht.ne'] at h1
  -- Step 4: `ν(ty) = λν(y)` with `λ = ν(y) · ν(ty) ∈ {1, −1}`
  have hpm : ∀ y ∈ M, ∀ t : ℝ, 0 < t →
      ν (t • y) = inner ℝ (ν y) (ν (t • y)) • ν y ∧
        (inner ℝ (ν y) (ν (t • y)) = 1 ∨ inner ℝ (ν y) (ν (t • y)) = -1) := by
    intro y hy t ht
    obtain ⟨hνyA, hνy1, -⟩ := hν y hy
    obtain ⟨hνtA, hνt1, hνtT⟩ := hν (t • y) (hcone t ht y hy)
    set lam : ℝ := inner ℝ (ν y) (ν (t • y)) with hlam
    have hyy : inner ℝ (ν y) (ν y) = (1 : ℝ) := by
      rw [real_inner_self_eq_norm_sq, hνy1, one_pow]
    -- `h = ν(ty) − λν(y) ∈ A₀` is orthogonal to `ν(y)`, so `h ∈ T_yM = T_{ty}M`
    have hhT : ν (t • y) - lam • ν y ∈ tangentSpace M y := by
      rw [hT y hy]
      refine ⟨A₀.sub_mem hνtA (A₀.smul_mem lam hνyA), ?_⟩
      rw [inner_sub_right, real_inner_smul_right, hyy, mul_one, ← hlam, sub_self]
    have e1 : inner ℝ (ν (t • y)) (ν (t • y) - lam • ν y) = (0 : ℝ) :=
      hνtT _ (by rw [hTeq y hy t ht]; exact hhT)
    have e2 : inner ℝ (ν y) (ν (t • y) - lam • ν y) = (0 : ℝ) := by
      rw [hT y hy] at hhT
      exact hhT.2
    -- `|h|² = ν(ty) · h − λ ν(y) · h = 0`
    have hh0 : ν (t • y) - lam • ν y = 0 := by
      apply (inner_self_eq_zero (𝕜 := ℝ)).1
      rw [inner_sub_left, real_inner_smul_left, e1, e2, mul_zero, sub_zero]
    have hνt : ν (t • y) = lam • ν y := sub_eq_zero.1 hh0
    refine ⟨hνt, (abs_eq zero_le_one).1 ?_⟩
    -- `1 = |ν(ty)| = |λ| |ν(y)| = |λ|`
    have := congrArg norm hνt
    rw [norm_smul, hνt1, hνy1, mul_one, Real.norm_eq_abs] at this
    exact this.symm
  -- Step 5: `ν(ty) = ν(y)` for `y ∈ M` and `t > 0`: `g(s) = ν(y) · ν(sy)` is continuous on
  -- `(0, ∞)` with values in `{1, −1}` and `g(1) = 1`, so `g(t) = −1` contradicts the IVT
  have hhom : ∀ y ∈ M, ∀ t : ℝ, 0 < t → ν (t • y) = ν y := by
    intro y hy t ht
    have hg : ContinuousOn (fun s : ℝ => inner ℝ (ν y) (ν (s • y))) (Ioi 0) :=
      continuousOn_const.inner (hνO.continuousOn.comp
        (continuous_id.smul continuous_const).continuousOn fun s hs => hMO (hcone s hs y hy))
    obtain ⟨hνt, h1 | h1⟩ := hpm y hy t ht
    · rw [hνt, h1, one_smul]
    · exfalso
      have hg1 : inner ℝ (ν y) (ν ((1 : ℝ) • y)) = (1 : ℝ) := by
        rw [one_smul, real_inner_self_eq_norm_sq, (hν y hy).2.1, one_pow]
      obtain ⟨s, hs, hs0⟩ := isPreconnected_Ioi.intermediate_value (show t ∈ Ioi (0 : ℝ) from ht)
        (Set.mem_Ioi.2 one_pos) hg
        (show (0 : ℝ) ∈ Icc (inner ℝ (ν y) (ν (t • y))) (inner ℝ (ν y) (ν ((1 : ℝ) • y))) by
          rw [h1, hg1]
          constructor <;> norm_num)
      have hs0' : inner ℝ (ν y) (ν (s • y)) = (0 : ℝ) := hs0
      rcases (hpm y hy s hs).2 with h2 | h2 <;> linarith
  refine ⟨hxT, ?_, fun t ht => ⟨hTeq x hx t ht, hhom x hx t ht, ?_⟩⟩
  · -- Step 7: `Dν(x)x = 0`: `t ↦ ν(tx)` is constant near `t = 1`, with derivative `Dν(x)x` there
    have h1 : HasDerivAt (fun t : ℝ => ν (t • x)) (fderiv ℝ ν x x) 1 := by
      have hl : HasDerivAt (fun t : ℝ => t • x) x 1 := by
        simpa using (hasDerivAt_id (1 : ℝ)).smul_const x
      exact (hνd x hx).comp_hasDerivAt_of_eq 1 hl (one_smul ℝ x).symm
    have h2 : HasDerivAt (fun t : ℝ => ν (t • x)) 0 1 := by
      refine (hasDerivAt_const (1 : ℝ) (ν x)).congr_of_eventuallyEq ?_
      filter_upwards [Ioi_mem_nhds one_pos] with t ht using hhom x hx t ht
    exact h1.unique h2
  · -- Step 6: `tDν(tx)v = Dν(x)v`: differentiate `ν(tγ(s)) = ν(γ(s))` at `s = 0`
    rintro v ⟨γ, -, hγM, hγ0, hγv⟩
    have h1 : HasDerivAt (fun s => ν (t • γ s)) (fderiv ℝ ν (t • x) (t • v)) 0 :=
      (hνd (t • x) (hcone t ht x hx)).comp_hasDerivAt_of_eq 0 (hγv.const_smul t) (by simp [hγ0])
    have h2 : HasDerivAt (fun s => ν (t • γ s)) (fderiv ℝ ν x v) 0 := by
      refine ((hνd x hx).comp_hasDerivAt_of_eq 0 hγv hγ0.symm).congr_of_eventuallyEq ?_
      filter_upwards [Ioo_mem_nhds (by norm_num : (-1 : ℝ) < 0) (by norm_num : (0 : ℝ) < 1)]
        with s hs using hhom (γ s) (hγM hs) t ht
    rw [← map_smul]
    exact h1.unique h2
/-- **Hausdorff measure on a cone** (Simon, Appendix B, proof of B.2: the finiteness that the
polar formula (5) provides, obtained here by dyadic scaling of `Hᵐ`).  Let `M ⊆ ℝᴾ` with `0 ∉ M`,
`M̄ ⊆ M ∪ {0}`, `tM ⊆ M` for `t > 0` and `Hᵐ(M ∩ K) < ∞` for compact `K`.  Then `tM = M`, so
`Hᵐ(M ∩ tS) = Hᵐ(t(M ∩ S)) = tᵐHᵐ(M ∩ S)`, and `M = M̄ \ {0}` is Borel.  (a) The sets
`M ∩ ∂B_{cₙ}(0)`, `cₙ = 1 + 1/(n+1) ∈ (1, 2]`, are disjoint subsets of `M ∩ B̄₂(0)` of measure
`cₙᵐHᵐ(M ∩ ∂B₁(0)) ≥ Hᵐ(M ∩ ∂B₁(0))`, so `Hᵐ(M ∩ ∂B₁(0)) = 0`; scale to radius `c`.  (b), (c) With
`B = Hᵐ(M ∩ B̄₁(0)) < ∞`, the shell `{x ∈ M : asᵏ ≤ |x| ≤ bsᵏ}` has measure `≤ (bsᵏ)ᵐB`, and
`|x|^γ ≤ (asᵏ)^γ` on it for `γ ≤ 0`, so the integral over a union of such shells is at most a
geometric series of ratio `s^γsᵐ`.  The shells `2⁻ᵏ⁻¹ ≤ |x| ≤ 2⁻ᵏ` cover `M ∩ B₁(0)` (ratio
`2^{-(m+α)} < 1` for `−m < α < 0`; for `α ≥ 0` use `|x|^α ≤ 1`), and `2ᵏ ≤ |x| ≤ 2ᵏ⁺¹` cover
`M \ B₁(0)` (ratio `2^{m+β} < 1`, as `β < −m ≤ 0`). -/
theorem Submission.codim1_hcp_sc_cone_annuli_measure : ∀ (P m : ℕ) (M : Set (Euclid P)), (0 : Euclid P) ∉ M → closure M ⊆ insert 0 M → (∀ t : ℝ, 0 < t → ∀ x ∈ M, t • x ∈ M) → (∀ K : Set (Euclid P), IsCompact K → μHE[m] (M ∩ K) ≠ ∞) → (∀ c : ℝ, 0 < c → μHE[m] (M ∩ sphere (0 : Euclid P) c) = 0) ∧ (∀ α : ℝ, -(m : ℝ) < α → ∫⁻ x in M ∩ ball (0 : Euclid P) 1, ENNReal.ofReal (‖x‖ ^ α) ∂μHE[m] ≠ ∞) ∧ (∀ β : ℝ, β < -(m : ℝ) → ∫⁻ x in M \ ball (0 : Euclid P) 1, ENNReal.ofReal (‖x‖ ^ β) ∂μHE[m] ≠ ∞) := by
  intro P m M h0 hcl hcone hfin
  open scoped Pointwise in
  -- Step 1: `tM = M`, hence `M ∩ tS = t(M ∩ S)`, for `t > 0`
  have hMt : ∀ t : ℝ, 0 < t → ∀ S : Set (Euclid P), M ∩ t • S = t • (M ∩ S) := by
    intro t ht S
    ext x
    simp only [mem_inter_iff, mem_smul_set_iff_inv_smul_mem₀ ht.ne']
    constructor
    · rintro ⟨hx, hS⟩
      exact ⟨hcone _ (inv_pos.2 ht) x hx, hS⟩
    · rintro ⟨hx, hS⟩
      refine ⟨?_, hS⟩
      simpa [smul_inv_smul₀ ht.ne'] using hcone t ht _ hx
  -- Step 2: `M = M̄ \ {0}` is Borel
  have hMeas : MeasurableSet M := by
    have hM : M = closure M \ {0} := by
      ext x
      constructor
      · intro hx
        refine ⟨subset_closure hx, ?_⟩
        rintro rfl
        exact h0 hx
      · rintro ⟨hx, hx0⟩
        rcases hcl hx with h | h
        · exact absurd h hx0
        · exact h
    rw [hM]
    exact isClosed_closure.measurableSet.diff (measurableSet_singleton 0)
  -- Step 3: `Hᵐ(tS) = tᵐHᵐ(S)` (`hausdorffMeasure_smul₀`), so `Hᵐ(M ∩ tS) = tᵐHᵐ(M ∩ S)`
  have hsc : ∀ t : ℝ, 0 < t → ∀ S : Set (Euclid P),
      μHE[m] (M ∩ t • S) = ENNReal.ofReal (t ^ m) * μHE[m] (M ∩ S) := by
    intro t ht S
    have hc : ((‖t‖₊ ^ (m : ℝ) : NNReal) : ℝ≥0∞) = ENNReal.ofReal (t ^ m) := by
      rw [NNReal.rpow_natCast, ENNReal.ofReal_pow ht.le, ENNReal.coe_pow, Real.nnnorm_of_nonneg ht.le,
        ENNReal.ofReal_eq_coe_nnreal ht.le]
    rw [hMt t ht S, Measure.euclideanHausdorffMeasure_def, Measure.smul_apply, Measure.smul_apply,
      Measure.hausdorffMeasure_smul₀ (Nat.cast_nonneg m) ht.ne', smul_comm, ENNReal.smul_def,
      smul_eq_mul, hc]
  -- Step 4: `Hᵐ(M ∩ B̄ᵣ(0)) = rᵐB` with `B = Hᵐ(M ∩ B̄₁(0)) < ∞`
  set B := μHE[m] (M ∩ closedBall (0 : Euclid P) 1)
  have hBfin : B ≠ ∞ := hfin _ (isCompact_closedBall 0 1)
  have hball : ∀ r : ℝ, 0 < r →
      μHE[m] (M ∩ closedBall (0 : Euclid P) r) = ENNReal.ofReal (r ^ m) * B := by
    intro r hr
    have : closedBall (0 : Euclid P) r = r • closedBall (0 : Euclid P) 1 := by
      rw [smul_closedBall' hr.ne', smul_zero, Real.norm_of_nonneg hr.le, mul_one]
    rw [this, hsc r hr]
  -- Step 5: on the shell `{x ∈ M : asᵏ ≤ |x| ≤ bsᵏ}`, `|x|^γ ≤ (asᵏ)^γ` (`γ ≤ 0`) and the shell
  -- lies in `M ∩ B̄_{bsᵏ}(0)`; summing over `k` gives a geometric series of ratio `s^γsᵐ < 1`
  have hgeo : ∀ (γ a b s : ℝ) (Ω : Set (Euclid P)), γ ≤ 0 → 0 < a → 0 < b → 0 < s →
      s ^ γ * s ^ m < 1 → Ω ⊆ ⋃ k : ℕ, M ∩ {x | a * s ^ k ≤ ‖x‖ ∧ ‖x‖ ≤ b * s ^ k} →
      ∫⁻ x in Ω, ENNReal.ofReal (‖x‖ ^ γ) ∂μHE[m] ≠ ∞ := by
    intro γ a b s Ω hγ ha hb hs hρ hΩ
    have hterm : ∀ k : ℕ, ∫⁻ x in M ∩ {x | a * s ^ k ≤ ‖x‖ ∧ ‖x‖ ≤ b * s ^ k},
        ENNReal.ofReal (‖x‖ ^ γ) ∂μHE[m] ≤
          ENNReal.ofReal (a ^ γ * b ^ m) * B * ENNReal.ofReal (s ^ γ * s ^ m) ^ k := by
      intro k
      have hsk : 0 < s ^ k := pow_pos hs k
      calc ∫⁻ x in M ∩ {x | a * s ^ k ≤ ‖x‖ ∧ ‖x‖ ≤ b * s ^ k}, ENNReal.ofReal (‖x‖ ^ γ) ∂μHE[m]
          ≤ ∫⁻ x in M ∩ {x | a * s ^ k ≤ ‖x‖ ∧ ‖x‖ ≤ b * s ^ k},
              ENNReal.ofReal ((a * s ^ k) ^ γ) ∂μHE[m] := by
            apply setLIntegral_mono measurable_const
            rintro x ⟨-, hx1, -⟩
            exact ENNReal.ofReal_le_ofReal (Real.rpow_le_rpow_of_nonpos (mul_pos ha hsk) hx1 hγ)
        _ = ENNReal.ofReal ((a * s ^ k) ^ γ) *
              μHE[m] (M ∩ {x | a * s ^ k ≤ ‖x‖ ∧ ‖x‖ ≤ b * s ^ k}) := setLIntegral_const _ _
        _ ≤ ENNReal.ofReal ((a * s ^ k) ^ γ) * μHE[m] (M ∩ closedBall 0 (b * s ^ k)) := by
            gcongr
            intro x hx
            exact mem_closedBall_zero_iff.2 hx.2
        _ = ENNReal.ofReal ((a * s ^ k) ^ γ) * (ENNReal.ofReal ((b * s ^ k) ^ m) * B) := by
            rw [hball _ (mul_pos hb hsk)]
        _ = ENNReal.ofReal (a ^ γ * b ^ m) * B * ENNReal.ofReal (s ^ γ * s ^ m) ^ k := by
            rw [← ENNReal.ofReal_pow (by positivity), ← mul_assoc,
              ← ENNReal.ofReal_mul (by positivity), mul_right_comm,
              ← ENNReal.ofReal_mul (by positivity)]
            congr 2
            rw [Real.mul_rpow ha.le hsk.le, ← Real.rpow_pow_comm hs.le]
            ring
    have hρ' : ENNReal.ofReal (s ^ γ * s ^ m) < 1 := ENNReal.ofReal_lt_one.2 hρ
    refine ne_top_of_le_ne_top ?_ ((lintegral_mono_set hΩ).trans
      ((lintegral_iUnion_le _ _).trans (ENNReal.tsum_le_tsum hterm)))
    rw [ENNReal.tsum_mul_left, ENNReal.tsum_geometric]
    exact ENNReal.mul_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hBfin)
      (ENNReal.inv_ne_top.2 (tsub_pos_iff_lt.2 hρ').ne')
  refine ⟨?_, ?_, ?_⟩
  · -- (a) `Hᵐ(M ∩ ∂B_c(0)) = cᵐHᵐ(M ∩ ∂B₁(0))`, and `Hᵐ(M ∩ ∂B₁(0)) = 0`
    have hsph : ∀ c : ℝ, 0 < c → μHE[m] (M ∩ sphere (0 : Euclid P) c) =
        ENNReal.ofReal (c ^ m) * μHE[m] (M ∩ sphere (0 : Euclid P) 1) := by
      intro c hc
      have : sphere (0 : Euclid P) c = c • sphere (0 : Euclid P) 1 := by
        rw [smul_sphere' hc.ne', smul_zero, Real.norm_of_nonneg hc.le, mul_one]
      rw [this, hsc c hc]
    have h1 : μHE[m] (M ∩ sphere (0 : Euclid P) 1) = 0 := by
      by_contra hne
      -- the radii `cₙ = 1 + 1/(n+1) ∈ (1, 2]` are distinct
      set c : ℕ → ℝ := fun n => 1 + 1 / ((n : ℝ) + 1) with hc_def
      have hc1 : ∀ n, 1 ≤ c n := fun n => by
        have : (0 : ℝ) ≤ 1 / ((n : ℝ) + 1) := by positivity
        simp only [hc_def]; linarith
      have hc2 : ∀ n, c n ≤ 2 := fun n => by
        have : 1 / ((n : ℝ) + 1) ≤ 1 := by
          rw [div_le_one (by positivity)]; linarith [(Nat.cast_nonneg n : (0 : ℝ) ≤ n)]
        simp only [hc_def]; linarith
      have hcinj : Function.Injective c := by
        intro i j hij
        simp only [hc_def, add_right_inj, one_div, inv_inj, add_left_inj, Nat.cast_inj] at hij
        exact hij
      -- so the spheres `M ∩ ∂B_{cₙ}(0) ⊆ M ∩ B̄₂(0)` are disjoint Borel sets
      have hdisj : Pairwise (Disjoint on fun n => M ∩ sphere (0 : Euclid P) (c n)) := by
        intro i j hij
        rw [Function.onFun, Set.disjoint_left]
        rintro x ⟨-, hxi⟩ ⟨-, hxj⟩
        rw [mem_sphere_zero_iff_norm] at hxi hxj
        exact hij (hcinj (hxi.symm.trans hxj))
      have hmeas : ∀ n, MeasurableSet (M ∩ sphere (0 : Euclid P) (c n)) := fun n =>
        hMeas.inter isClosed_sphere.measurableSet
      have hsum : ∑' n, μHE[m] (M ∩ sphere (0 : Euclid P) (c n)) ≤
          μHE[m] (M ∩ closedBall (0 : Euclid P) 2) := by
        rw [← measure_iUnion hdisj hmeas]
        refine measure_mono (iUnion_subset fun n => ?_)
        exact inter_subset_inter_right _
          (sphere_subset_closedBall.trans (closedBall_subset_closedBall (hc2 n)))
      -- each has measure `cₙᵐHᵐ(M ∩ ∂B₁(0)) ≥ Hᵐ(M ∩ ∂B₁(0)) > 0`, so their sum is infinite
      have htop : ∑' n, μHE[m] (M ∩ sphere (0 : Euclid P) (c n)) = ∞ := by
        refine top_unique ?_
        rw [← ENNReal.tsum_const_eq_top_of_ne_zero (α := ℕ) hne]
        refine ENNReal.tsum_le_tsum fun n => ?_
        rw [hsph (c n) (by linarith [hc1 n])]
        calc μHE[m] (M ∩ sphere (0 : Euclid P) 1) = 1 * μHE[m] (M ∩ sphere (0 : Euclid P) 1) :=
              (one_mul _).symm
          _ ≤ _ := by gcongr; exact ENNReal.one_le_ofReal.2 (one_le_pow₀ (hc1 n))
      exact hfin _ (isCompact_closedBall 0 2) (top_unique (htop ▸ hsum))
    intro c hc
    rw [hsph c hc, h1, mul_zero]
  · -- (b) for `α ≥ 0`, `|x|^α ≤ 1` on `B₁(0)`; for `−m < α < 0`, shells `2⁻ᵏ⁻¹ ≤ |x| ≤ 2⁻ᵏ`
    intro α hα
    rcases le_or_gt 0 α with hα0 | hα0
    · refine ne_top_of_le_ne_top (hfin _ (isCompact_closedBall (0 : Euclid P) 1)) ?_
      calc ∫⁻ x in M ∩ ball (0 : Euclid P) 1, ENNReal.ofReal (‖x‖ ^ α) ∂μHE[m]
          ≤ ∫⁻ x in M ∩ ball (0 : Euclid P) 1, 1 ∂μHE[m] := by
            apply setLIntegral_mono measurable_const
            rintro x ⟨-, hx⟩
            rw [mem_ball_zero_iff] at hx
            exact ENNReal.ofReal_le_one.2 (Real.rpow_le_one (norm_nonneg x) hx.le hα0)
        _ = μHE[m] (M ∩ ball (0 : Euclid P) 1) := by rw [setLIntegral_const, one_mul]
        _ ≤ μHE[m] (M ∩ closedBall (0 : Euclid P) 1) :=
            measure_mono (inter_subset_inter_right _ ball_subset_closedBall)
    · refine hgeo α (1 / 2) 1 (1 / 2) _ hα0.le (by norm_num) one_pos (by norm_num) ?_ ?_
      · -- `2^{-α}2^{-m} = 2^{-(m+α)} < 1`
        rw [← Real.rpow_natCast, ← Real.rpow_add (by norm_num)]
        exact Real.rpow_lt_one (by norm_num) (by norm_num) (by linarith)
      · -- `0 < |x| < 1` as `0 ∉ M`, so `2⁻ᵏ⁻¹ < |x| ≤ 2⁻ᵏ` for some `k`
        rintro x ⟨hxM, hx⟩
        rw [mem_ball_zero_iff] at hx
        have hxpos : 0 < ‖x‖ := norm_pos_iff.2 (by rintro rfl; exact h0 hxM)
        obtain ⟨k, hk1, hk2⟩ := exists_nat_pow_near_of_lt_one hxpos hx.le
          (by norm_num : (0 : ℝ) < 1 / 2) (by norm_num : (1 / 2 : ℝ) < 1)
        refine mem_iUnion.2 ⟨k, hxM, ?_, ?_⟩
        · rw [← pow_succ']; exact hk1.le
        · rw [one_mul]; exact hk2
  · -- (c) `β < −m ≤ 0`; shells `2ᵏ ≤ |x| ≤ 2ᵏ⁺¹`
    intro β hβ
    have hβ0 : β < 0 := by linarith [(Nat.cast_nonneg m : (0 : ℝ) ≤ m)]
    refine hgeo β 1 2 2 _ hβ0.le one_pos two_pos two_pos ?_ ?_
    · -- `2^β2^m = 2^{m+β} < 1`
      rw [← Real.rpow_natCast, ← Real.rpow_add two_pos]
      exact Real.rpow_lt_one_of_one_lt_of_neg one_lt_two (by linarith)
    · -- `|x| ≥ 1`, so `2ᵏ ≤ |x| < 2ᵏ⁺¹` for some `k`
      rintro x ⟨hxM, hx⟩
      rw [mem_ball_zero_iff, not_lt] at hx
      obtain ⟨k, hk1, hk2⟩ := exists_nat_pow_near hx one_lt_two
      refine mem_iUnion.2 ⟨k, hxM, ?_, ?_⟩
      · rw [one_mul]; exact hk1
      · rw [← pow_succ']; exact hk2.le
/-- **Rademacher's theorem on an embedded `C¹` submanifold** (Simon Ch. 2, 4.8–4.9, via
Rademacher's theorem 1.4 in local coordinates).  If `M ⊆ ℝᴾ` is an embedded `C¹` `m`-dimensional
submanifold and `f` is locally Lipschitz on `M`, then `f` is differentiable within `M` at
`Hᵐ`-a.e. point of `M`.  The given charts `(V, W, ψ)` are used directly.  As `ψ` is proper and
injective, `M ∩ B_δ(ψ(b)) ⊆ ψ(V₀)` for every open `V₀ ∋ b`.  With `Q` a linear left inverse of
`Dψ(b)`, the inverse function theorem for `Q ∘ ψ` gives a local inverse `Θ`, differentiable at
`Q(ψ(b))`, so `f = (f ∘ ψ) ∘ Θ ∘ Q` on `M` near `ψ(b)`: if `f ∘ ψ` is differentiable at `b`, then
`f` is differentiable within `M` at `ψ(b)`.  On an open `B ∋ a` where `ψ` and `f ∘ ψ` are
Lipschitz, Rademacher's theorem makes `f ∘ ψ` differentiable off an `Lᵐ`-null set `N`, and
`Hᵐ(ψ(N)) ≤ Λᵐ Lᵐ(N) = 0`.  `M = O ∩ closure M` (`O` the union of the chart domains) is Borel,
and countably many of these neighbourhoods cover `M`. -/
theorem Submission.codim1_hcp_sc_rademacher_submanifold : ∀ (P m : ℕ) (M : Set (Euclid P)) (f : Euclid P → ℝ), IsEmbeddedSubmanifold 1 m M → LocallyLipschitzOn M f → ∀ᵐ x ∂(μHE[m].restrict M), DifferentiableWithinAt ℝ f M x := by
  intro P m M f hM hf
  -- step 1: `M` is Borel, as `M = O ∩ closure M` with `O` the union of the chart domains
  have hMmeas : MeasurableSet M := by
    have key : ∀ y ∈ M, ∃ W : Set (Euclid P), IsOpen W ∧ y ∈ W ∧
        ∀ K ⊆ W, IsCompact K → IsClosed (M ∩ K) := by
      intro y hy
      obtain ⟨V, W, ψ, -, hW, hyW, hψ, -, himg, hprop, -⟩ := hM y hy
      refine ⟨W, hW, hyW, fun K hKW hK => ?_⟩
      have hEq : M ∩ K = ψ '' (V ∩ ψ ⁻¹' K) := by
        ext x
        constructor
        · rintro ⟨hxM, hxK⟩
          obtain ⟨v, hv, rfl⟩ : x ∈ ψ '' V := by rw [himg]; exact ⟨hKW hxK, hxM⟩
          exact ⟨v, ⟨hv, hxK⟩, rfl⟩
        · rintro ⟨v, ⟨hv, hvK⟩, rfl⟩
          exact ⟨(himg ▸ mem_image_of_mem ψ hv : ψ v ∈ W ∩ M).2, hvK⟩
      rw [hEq]
      exact ((hprop K hKW hK).image_of_continuousOn
        (hψ.continuousOn.mono inter_subset_left)).isClosed
    choose! Wf hWo hyW hcl using key
    have hMeq : M = (⋃ y ∈ M, Wf y) ∩ closure M := by
      refine Subset.antisymm (fun x hx => ⟨mem_biUnion hx (hyW x hx), subset_closure hx⟩) ?_
      rintro p ⟨hpO, hpcl⟩
      obtain ⟨y, hy, hpW⟩ := mem_iUnion₂.1 hpO
      obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.1 (hWo y hy) p hpW
      have hC := hcl y hy (closedBall p (r / 2))
        ((closedBall_subset_ball (by linarith)).trans hball) (isCompact_closedBall p (r / 2))
      have h1 : p ∈ ball p (r / 2) ∩ closure M := ⟨mem_ball_self (by linarith), hpcl⟩
      have hsub : ball p (r / 2) ∩ M ⊆ M ∩ closedBall p (r / 2) :=
        fun x hx => ⟨hx.2, ball_subset_closedBall hx.1⟩
      have h3 : p ∈ closure (M ∩ closedBall p (r / 2)) :=
        closure_mono hsub (isOpen_ball.inter_closure h1)
      rw [hC.closure_eq] at h3
      exact h3.1
    rw [hMeq]
    exact (isOpen_biUnion fun y hy => hWo y hy).measurableSet.inter isClosed_closure.measurableSet
  -- step 2: near each `p ∈ M`, `f` is differentiable within `M` off an `Hᵐ`-null set
  have hloc : ∀ p ∈ M, ∃ O : Set (Euclid P), IsOpen O ∧ p ∈ O ∧ ∃ E : Set (Euclid P),
      μHE[m] E = 0 ∧ ∀ x ∈ M ∩ O, x ∉ E → DifferentiableWithinAt ℝ f M x := by
    intro p hp
    obtain ⟨V, W, ψ, hV, hW, hpW, hψ, hinj, himg, hprop, hDψ⟩ := hM p hp
    have hψ1 : ContDiffOn ℝ 1 ψ V := by exact_mod_cast hψ
    have hψM : ∀ c ∈ V, ψ c ∈ M := fun c hc => (himg ▸ mem_image_of_mem ψ hc : ψ c ∈ W ∩ M).2
    -- (a) `M ∩ B_δ(ψ(b)) ⊆ ψ(V₀)` for open `V₀ ∋ b`, as `ψ` is proper and injective
    have himgnhds : ∀ b ∈ V, ∀ V₀ : Set (Euclid m), IsOpen V₀ → V₀ ⊆ V → b ∈ V₀ →
        ∃ δ : ℝ, 0 < δ ∧ M ∩ ball (ψ b) δ ⊆ ψ '' V₀ := by
      intro b hb V₀ hV₀ hV₀V hbV₀
      have hbW : ψ b ∈ W := (himg ▸ mem_image_of_mem ψ hb : ψ b ∈ W ∩ M).1
      obtain ⟨ε, hε, hεW⟩ := Metric.isOpen_iff.1 hW _ hbW
      have hKW : closedBall (ψ b) (ε / 2) ⊆ W :=
        (closedBall_subset_ball (by linarith)).trans hεW
      -- `C = (V ∩ ψ⁻¹(K)) \ V₀` is compact, so its image is closed and misses `ψ(b)`
      have hCc : IsClosed (ψ '' ((V ∩ ψ ⁻¹' closedBall (ψ b) (ε / 2)) \ V₀)) :=
        (((hprop _ hKW (isCompact_closedBall _ _)).diff hV₀).image_of_continuousOn
          (hψ1.continuousOn.mono fun c hc => hc.1.1)).isClosed
      have hbC : ψ b ∉ ψ '' ((V ∩ ψ ⁻¹' closedBall (ψ b) (ε / 2)) \ V₀) := by
        rintro ⟨c, ⟨⟨hcV, -⟩, hcV₀⟩, hc⟩
        exact hcV₀ (hinj hcV hb hc ▸ hbV₀)
      obtain ⟨δ, hδ, hδC⟩ := Metric.isOpen_iff.1 hCc.isOpen_compl _ hbC
      refine ⟨min (ε / 2) δ, lt_min (by linarith) hδ, fun y hy => ?_⟩
      have hyK : y ∈ closedBall (ψ b) (ε / 2) :=
        ball_subset_closedBall (ball_subset_ball (min_le_left _ _) hy.2)
      obtain ⟨c, hcV, rfl⟩ : y ∈ ψ '' V := by rw [himg]; exact ⟨hKW hyK, hy.1⟩
      refine ⟨c, ?_, rfl⟩
      by_contra hcV₀
      exact hδC (ball_subset_ball (min_le_right _ _) hy.2) ⟨c, ⟨⟨hcV, hyK⟩, hcV₀⟩, rfl⟩
    -- (b) if `f ∘ ψ` is differentiable at `b`, then `f` is differentiable within `M` at `ψ(b)`
    have htransfer : ∀ b ∈ V, DifferentiableAt ℝ (f ∘ ψ) b →
        DifferentiableWithinAt ℝ f M (ψ b) := by
      intro b hb hdiff
      -- a continuous linear left inverse `Q` of the injective `Dψ(b)`
      obtain ⟨Q₀, hQ₀⟩ := LinearMap.exists_leftInverse_of_injective
        (fderiv ℝ ψ b : Euclid m →ₗ[ℝ] Euclid P) (LinearMap.ker_eq_bot.2 (hDψ b hb))
      let Q : Euclid P →L[ℝ] Euclid m := LinearMap.toContinuousLinearMap Q₀
      have hQ : ∀ v, Q (fderiv ℝ ψ b v) = v := fun v => LinearMap.congr_fun hQ₀ v
      -- `Φ = Q ∘ ψ` has strict derivative `id` at `b`
      have hψs : HasStrictFDerivAt ψ (fderiv ℝ ψ b) b :=
        (hψ1.contDiffAt (hV.mem_nhds hb)).hasStrictFDerivAt one_ne_zero
      have hΦ : HasStrictFDerivAt (Q ∘ ψ)
          ((ContinuousLinearEquiv.refl ℝ (Euclid m) : Euclid m ≃L[ℝ] Euclid m) :
            Euclid m →L[ℝ] Euclid m) b := by
        have hQψ : Q.comp (fderiv ℝ ψ b) =
            ((ContinuousLinearEquiv.refl ℝ (Euclid m) : Euclid m ≃L[ℝ] Euclid m) :
              Euclid m →L[ℝ] Euclid m) :=
          ContinuousLinearMap.ext fun v => hQ v
        rw [← hQψ]
        exact Q.hasStrictFDerivAt.comp b hψs
      -- the inverse function theorem: a local inverse `Θ` of `Φ`, differentiable at `Φ(b)`
      set Θ := hΦ.localInverse (Q ∘ ψ) _ b
      have hΘ := hΦ.to_localInverse
      have hleft : ∀ᶠ c in 𝓝 b, Θ ((Q ∘ ψ) c) = c := hΦ.eventually_left_inverse
      obtain ⟨V₁, hV₁sub, hV₁o, hbV₁⟩ := _root_.mem_nhds_iff.1 hleft
      obtain ⟨δ, hδ, hδsub⟩ :=
        himgnhds b hb (V₁ ∩ V) (hV₁o.inter hV) inter_subset_right ⟨hbV₁, hb⟩
      have hΘb : Θ (Q (ψ b)) = b := hleft.self_of_nhds
      -- `f = (f ∘ ψ) ∘ Θ ∘ Q` on `M ∩ B_δ(ψ(b))`, and the right side is differentiable at `ψ(b)`
      have hg : DifferentiableAt ℝ ((f ∘ ψ) ∘ Θ ∘ Q) (ψ b) := by
        have h1 : DifferentiableAt ℝ (f ∘ ψ) (Θ (Q (ψ b))) := by rw [hΘb]; exact hdiff
        exact h1.comp (ψ b) (hΘ.differentiableAt.comp (ψ b) Q.differentiableAt)
      refine hg.differentiableWithinAt.congr_of_eventuallyEq ?_ ?_
      · filter_upwards [inter_mem_nhdsWithin M (ball_mem_nhds (ψ b) hδ)] with y hy
        obtain ⟨c, ⟨hc₁, -⟩, rfl⟩ := hδsub hy
        have hc : Θ (Q (ψ c)) = c := hV₁sub hc₁
        simp only [Function.comp_apply, hc]
      · simp only [Function.comp_apply, hΘb]
    -- (c) `ψ` and `f ∘ ψ` are Lipschitz on an open `B ∋ a`, where `ψ(a) = p`
    obtain ⟨a, haV, rfl⟩ : p ∈ ψ '' V := by rw [himg]; exact ⟨hpW, hp⟩
    obtain ⟨K, t, ht, hft⟩ := hf hp
    obtain ⟨U, hUo, haU, hUt⟩ := mem_nhdsWithin.1 ht
    have hψa : ContDiffAt ℝ 1 ψ a := hψ1.contDiffAt (hV.mem_nhds haV)
    obtain ⟨Λ, s, hs, hψs⟩ := hψa.exists_lipschitzOnWith
    obtain ⟨B, hBsub, hBo, haB⟩ := _root_.mem_nhds_iff.1 (inter_mem (inter_mem (hV.mem_nhds haV) hs)
      (hψa.continuousAt.preimage_mem_nhds (hUo.mem_nhds haU)))
    have hBV : B ⊆ V := fun c hc => (hBsub hc).1.1
    have hψB : LipschitzOnWith Λ ψ B := hψs.mono fun c hc => (hBsub hc).1.2
    have hfB : LipschitzOnWith (K * Λ) (f ∘ ψ) B :=
      hft.comp hψB fun c hc => hUt ⟨(hBsub hc).2, hψM c (hBV hc)⟩
    -- (d) Rademacher: `f ∘ ψ` is differentiable on `B` off the `Lᵐ`-null set `N`
    let N : Set (Euclid m) := {c | c ∈ B ∧ ¬ DifferentiableAt ℝ (f ∘ ψ) c}
    have hN : volume N = 0 := by
      have hrad := hfB.ae_differentiableWithinAt_of_mem (μ := volume)
      rw [ae_iff] at hrad
      refine measure_mono_null (fun c hc => ?_) hrad
      simp only [mem_ofPred_eq, not_imp]
      exact ⟨hc.1, fun hd => hc.2 (hd.differentiableAt (hBo.mem_nhds hc.1))⟩
    obtain ⟨δ, hδ, hδB⟩ := himgnhds a haV B hBo hBV haB
    refine ⟨ball (ψ a) δ, isOpen_ball, mem_ball_self hδ, ψ '' N, ?_, ?_⟩
    · -- (e) `Hᵐ(ψ(N)) ≤ Λᵐ Lᵐ(N) = 0`
      have h := (hψB.mono fun c (hc : c ∈ N) => hc.1).hausdorffMeasure_image_le
        (d := (m : ℝ)) (Nat.cast_nonneg m)
      rw [ENNReal.rpow_natCast] at h
      have h2 : μHE[m] (ψ '' N) ≤ (Λ : ℝ≥0∞) ^ m * volume N := by
        rw [← EuclideanSpace.euclideanHausdorffMeasure_eq_volume m,
          Measure.euclideanHausdorffMeasure_def, Measure.euclideanHausdorffMeasure_def]
        simp only [Measure.smul_apply, ENNReal.smul_def, smul_eq_mul]
        calc _ ≤ _ := mul_le_mul_right h _
          _ = _ := by ring
      rw [hN, mul_zero] at h2
      exact le_antisymm h2 zero_le
    · -- (f) off `ψ(N)`, each `x ∈ M ∩ B_δ(ψ(a))` is `ψ(c)` with `f ∘ ψ` differentiable at `c`
      intro x hx hxE
      obtain ⟨c, hcB, rfl⟩ := hδB hx
      refine htransfer c (hBV hcB) ?_
      by_contra hnd
      exact hxE ⟨c, ⟨hcB, hnd⟩, rfl⟩
  -- step 3: countably many of the neighbourhoods `O p` cover `M` (second countability)
  choose! O hOo hpO E hE hdiff using hloc
  obtain ⟨T, hTM, hTc, hTU⟩ := TopologicalSpace.isOpen_biUnion_countable M O hOo
  have hnull : μHE[m] (⋃ p ∈ T, E p) = 0 :=
    (measure_biUnion_null_iff hTc).2 fun p hp => hE p (hTM hp)
  rw [ae_restrict_iff' hMmeas, ae_iff]
  refine measure_mono_null (fun x hx => ?_) hnull
  simp only [mem_ofPred_eq, not_imp] at hx
  obtain ⟨hxM, hxnd⟩ := hx
  have hxU : x ∈ ⋃ p ∈ M, O p := mem_iUnion₂.2 ⟨x, hxM, hpO x hxM⟩
  rw [← hTU] at hxU
  obtain ⟨p, hpT, hxO⟩ := mem_iUnion₂.1 hxU
  refine mem_iUnion₂.2 ⟨p, hpT, ?_⟩
  by_contra hxE
  exact hxnd (hdiff p (hTM hpT) x ⟨hxM, hxO⟩ hxE)
/-- **Weingarten map and Codazzi equations of a hypersurface** (Simon, Appendix B, B.4–B.5,
p. 231; cf. Ch. 2, 4.26).  Let `M ⊆ A₀` be an `m`-dimensional submanifold of the
`(m + 1)`-dimensional subspace `A₀`, `C^r` for every `r`, with unit normal `ν` in `A₀` that is
`C^∞` on an open `O ⊇ M`, and let `C(y) = Dν(y) ∘ P_y`.  For `x ∈ M` and `a, b, d ∈ T_xM`:
(i) `Dν(x)a ∈ T_xM`; (ii) `Dν(x)a · b = Dν(x)b · a` (B.4); (iii) `(D_aC)(b) · d = (D_bC)(a) · d`
(Codazzi, B.5); (iv) `(D_aC)(b) · d = (D_aC)(d) · b`.
(i): differentiate `ν(γ(t)) ∈ A₀` and `|ν(γ(t))|² = 1` along a curve `γ` with `γ'(0) = a`, and
use `T_xM = A₀ ∩ ν(x)^⊥` (`Submission.codim1_hcp_sc_tangent_normal_complement`).  (ii): in a
`C²` chart `ψ`, differentiate `ν(ψ(v)) · Dψ(v)e = 0` and use the symmetry of `D²ψ`.  On `M`,
`C = C̃ := Dν ∘ (Π − ν ⊗ ν)`, which is differentiable at `x`, so `D_aC = DC̃(x)a`
(`Submission.codim1_hcp_sc_fderivWithin_tangent_eq`) and
`(D_aC)(b) = D²ν(x)(a, b) − (Dν(x)a · b) Dν(x)ν(x)`; (iii) follows from the symmetry of
`D²ν(x)` and (ii).  (iv): by (i) and (ii), `C(y)u · w = C(y)w · u` for `y ∈ M`; differentiate
this identity along `M`. -/
theorem Submission.codim1_hcp_sc_weingarten_codazzi : ∀ (P m : ℕ) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)) (ν : Euclid P → Euclid P), Module.finrank ℝ A₀ = m + 1 → M ⊆ (A₀ : Set (Euclid P)) → (∀ r : ℕ, IsEmbeddedSubmanifold r m M) → (∃ O : Set (Euclid P), IsOpen O ∧ M ⊆ O ∧ ContDiffOn ℝ (⊤ : ℕ∞) ν O) → (∀ x ∈ M, ν x ∈ A₀ ∧ ‖ν x‖ = 1 ∧ ∀ v ∈ tangentSpace M x, inner ℝ (ν x) v = 0) → ∀ x ∈ M, ∀ a ∈ tangentSpace M x, ∀ b ∈ tangentSpace M x, fderiv ℝ ν x a ∈ tangentSpace M x ∧ inner ℝ (fderiv ℝ ν x a) b = inner ℝ (fderiv ℝ ν x b) a ∧ ∀ d ∈ tangentSpace M x, inner ℝ (fderivWithin ℝ (fun y => (fderiv ℝ ν y).comp (Submodule.span ℝ (tangentSpace M y)).starProjection) M x a b) d = inner ℝ (fderivWithin ℝ (fun y => (fderiv ℝ ν y).comp (Submodule.span ℝ (tangentSpace M y)).starProjection) M x b a) d ∧ inner ℝ (fderivWithin ℝ (fun y => (fderiv ℝ ν y).comp (Submodule.span ℝ (tangentSpace M y)).starProjection) M x a b) d = inner ℝ (fderivWithin ℝ (fun y => (fderiv ℝ ν y).comp (Submodule.span ℝ (tangentSpace M y)).starProjection) M x a d) b := by
  intro P m A₀ M ν hA hMA hM hO hν x hx a ha b hb
  obtain ⟨O, hOo, hMO, hνO⟩ := hO
  -- Step 0: `T_y = {v ∈ A₀ : ν(y) · v = 0}` and `P_y w = Π w − (ν(y) · w) ν(y)` on `M`
  have hNC := Submission.codim1_hcp_sc_tangent_normal_complement P m A₀ M ν hA hMA (hM 1) hν
  -- `ν` is `C^∞` near every point of `M`
  have hνc : ∀ y ∈ M, ContDiffAt ℝ (⊤ : ℕ∞) ν y := fun y hy =>
    hνO.contDiffAt (hOo.mem_nhds (hMO hy))
  have hνd : ∀ y ∈ M, HasFDerivAt ν (fderiv ℝ ν y) y := fun y hy =>
    ((hνc y hy).differentiableAt (by simp)).hasFDerivAt
  -- `T_y` is a linear subspace, so `span T_y = T_y`
  have hspan : ∀ y ∈ M, ∀ v ∈ Submodule.span ℝ (tangentSpace M y), v ∈ tangentSpace M y := by
    intro y hy v hv
    rw [(hNC y hy).1] at hv ⊢
    induction hv using Submodule.span_induction with
    | mem w hw => exact hw
    | zero => exact ⟨A₀.zero_mem, inner_zero_right _⟩
    | add u w _ _ hu hw =>
      exact ⟨A₀.add_mem hu.1 hw.1, by rw [inner_add_right, hu.2, hw.2, add_zero]⟩
    | smul c u _ hu => exact ⟨A₀.smul_mem c hu.1, by rw [inner_smul_right, hu.2, mul_zero]⟩
  -- Step 1 (i): `Dν(y) a ∈ T_y`, differentiating `ν(γ(t)) ∈ A₀` and `|ν(γ(t))|² = 1`
  have hi : ∀ y ∈ M, ∀ a ∈ tangentSpace M y, fderiv ℝ ν y a ∈ tangentSpace M y := by
    intro y hy a ha
    obtain ⟨γ, -, hγM, hγ0, hγa⟩ := ha
    have hc : HasDerivAt (ν ∘ γ) (fderiv ℝ ν y a) 0 :=
      (hνd y hy).comp_hasDerivAt_of_eq 0 hγa hγ0.symm
    have hI : Ioo (-1 : ℝ) 1 ∈ 𝓝 (0 : ℝ) := Ioo_mem_nhds (by norm_num) (by norm_num)
    have h0I : (0 : ℝ) ∈ Ioo (-1 : ℝ) 1 := ⟨by norm_num, by norm_num⟩
    rw [(hNC y hy).1]
    refine ⟨?_, ?_⟩
    · -- the difference quotients of `ν ∘ γ` lie in the closed subspace `A₀`
      refine A₀.closed_of_finiteDimensional.mem_of_tendsto hc.tendsto_slope ?_
      filter_upwards [nhdsWithin_le_nhds hI] with t ht
      rw [slope_def_module]
      exact A₀.smul_mem _ (A₀.sub_mem (hν _ (hγM ht)).1 (hν _ (hγM h0I)).1)
    · -- `|ν ∘ γ|² = 1` near `0`, so `2 ν(y) · Dν(y) a = 0`
      have hconst : (fun t => ‖(ν ∘ γ) t‖ ^ 2) =ᶠ[𝓝 0] fun _ => (1 : ℝ) := by
        filter_upwards [hI] with t ht
        simp [(hν _ (hγM ht)).2.1]
      have h0 := hc.norm_sq.unique ((hasDerivAt_const (0 : ℝ) (1 : ℝ)).congr_of_eventuallyEq hconst)
      simp only [Function.comp_apply, hγ0] at h0
      linarith
  -- Step 2 (ii): `Dν(y) a · b = Dν(y) b · a`, from a `C²` chart and the symmetry of `D²ψ`
  have hii : ∀ y ∈ M, ∀ a ∈ tangentSpace M y, ∀ b ∈ tangentSpace M y,
      inner ℝ (fderiv ℝ ν y a) b = inner ℝ (fderiv ℝ ν y b) a := by
    intro y hy a ha b hb
    obtain ⟨V, W, ψ, hV, hW, hyW, hψ, hinj, himg, hprop, hder⟩ := hM 2 y hy
    obtain ⟨v₀, hv₀, rfl⟩ : y ∈ ψ '' V := by rw [himg]; exact ⟨hyW, hy⟩
    have hT : ∀ v ∈ V, tangentSpace M (ψ v) = range (fderiv ℝ ψ v) := fun v hv =>
      Submission.chart_tangentSpace_eq_range_fderiv P m 2 M W V ψ v (by norm_num) hV hW hψ hinj
        himg hprop hder hv
    rw [hT v₀ hv₀] at ha hb
    obtain ⟨e₁, rfl⟩ := ha
    obtain ⟨e₂, rfl⟩ := hb
    have hψc := hψ.contDiffAt (hV.mem_nhds hv₀)
    have hψd : HasFDerivAt ψ (fderiv ℝ ψ v₀) v₀ := (hψc.differentiableAt (by simp)).hasFDerivAt
    have hDψd : HasFDerivAt (fderiv ℝ ψ) (fderiv ℝ (fderiv ℝ ψ) v₀) v₀ :=
      ((hψc.fderiv_right (m := 1) (by norm_num)).differentiableAt (by simp)).hasFDerivAt
    have hsymm : IsSymmSndFDerivAt ℝ ψ v₀ := hψc.isSymmSndFDerivAt (by simp)
    -- `v ↦ ν(ψ(v)) · Dψ(v) e` vanishes on `V`; its derivative in direction `e'` at `v₀`
    have key : ∀ e e' : Euclid m, inner ℝ (ν (ψ v₀)) (fderiv ℝ (fderiv ℝ ψ) v₀ e' e) +
        inner ℝ (fderiv ℝ ν (ψ v₀) (fderiv ℝ ψ v₀ e')) (fderiv ℝ ψ v₀ e) = 0 := by
      intro e e'
      have hzero : (fun v => inner ℝ ((ν ∘ ψ) v) (fderiv ℝ ψ v e)) =ᶠ[𝓝 v₀] fun _ => (0 : ℝ) := by
        filter_upwards [hV.mem_nhds hv₀] with v hv
        have hvM : ψ v ∈ M := (himg ▸ mem_image_of_mem ψ hv : ψ v ∈ W ∩ M).2
        exact (hν (ψ v) hvM).2.2 _ (by rw [hT v hv]; exact mem_range_self e)
      have hd := ((hνd (ψ v₀) hy).comp v₀ hψd).inner ℝ (hDψd.clm_apply (hasFDerivAt_const e v₀))
      have h0 := congrArg (fun L => L e')
        (hd.unique ((hasFDerivAt_const (0 : ℝ) v₀).congr_of_eventuallyEq hzero))
      simpa using h0
    have h1 := key e₂ e₁
    have h2 := key e₁ e₂
    rw [hsymm e₁ e₂] at h1
    linarith
  -- Step 3: `C = C̃` on `M`, where `C̃(y) = Dν(y) ∘ (Π − ν(y) ⊗ ν(y))` is differentiable at `x`
  set Ct : Euclid P → (Euclid P →L[ℝ] Euclid P) := fun y =>
    (fderiv ℝ ν y).comp (A₀.starProjection - (innerSL ℝ (ν y)).smulRight (ν y)) with hCt
  have hCeq : ∀ y ∈ M,
      (fderiv ℝ ν y).comp (Submodule.span ℝ (tangentSpace M y)).starProjection = Ct y := by
    intro y hy
    refine ContinuousLinearMap.ext fun w => ?_
    simp [hCt, (hNC y hy).2 w]
  have hν1 : ContDiffAt ℝ 1 ν x := (hνc x hx).of_le (by simp)
  have hDν1 : ContDiffAt ℝ 1 (fderiv ℝ ν) x := (hνc x hx).fderiv_right (by simp)
  have hD2 : HasFDerivAt (fderiv ℝ ν) (fderiv ℝ (fderiv ℝ ν) x) x :=
    (hDν1.differentiableAt (by simp)).hasFDerivAt
  have hCtd : HasFDerivAt Ct (fderiv ℝ Ct x) x := by
    have hCt1 : ContDiffAt ℝ 1 Ct x := hDν1.clm_comp (contDiffAt_const.sub
      ((((innerSL ℝ : Euclid P →L[ℝ] Euclid P →L[ℝ] ℝ).contDiff.contDiffAt).comp x hν1).smulRight
        hν1))
    exact (hCt1.differentiableAt (by simp)).hasFDerivAt
  -- `D_a C = DC̃(x) a` for `a ∈ T_x` (sibling `tangent_fderiv`)
  have hDC : ∀ a' ∈ tangentSpace M x, fderivWithin ℝ (fun y => (fderiv ℝ ν y).comp
      (Submodule.span ℝ (tangentSpace M y)).starProjection) M x a' = fderiv ℝ Ct x a' :=
    fun a' ha' => Submission.codim1_hcp_sc_fderivWithin_tangent_eq P (Euclid P →L[ℝ] Euclid P) M _ _
      x (hCtd.hasFDerivWithinAt.congr hCeq (hCeq x hx)) a' (Submodule.subset_span ha')
  have hmemT : ∀ v ∈ tangentSpace M x, v ∈ A₀ ∧ inner ℝ (ν x) v = 0 := fun v hv => by
    rw [(hNC x hx).1] at hv
    exact hv
  -- `(D_a C)(b) = D²ν(x)(a, b) − (Dν(x) a · b) Dν(x) ν(x)` for `b ∈ A₀` with `ν(x) · b = 0`
  have hformula : ∀ a' b', b' ∈ A₀ → inner ℝ (ν x) b' = 0 → fderiv ℝ Ct x a' b' =
      fderiv ℝ (fderiv ℝ ν) x a' b' - inner ℝ (fderiv ℝ ν x a') b' • fderiv ℝ ν x (ν x) := by
    intro a' b' hbA hbν
    have hF : (fun y => Ct y b') =
        fun y => fderiv ℝ ν y b' - inner ℝ (ν y) b' • fderiv ℝ ν y (ν y) := by
      funext y
      simp [hCt, Submodule.starProjection_eq_self_iff.mpr hbA]
    have h1 := hCtd.clm_apply (hasFDerivAt_const b' x)
    rw [hF] at h1
    have h2 := (hD2.clm_apply (hasFDerivAt_const b' x)).sub
      (((hνd x hx).inner ℝ (hasFDerivAt_const b' x)).smul (hD2.clm_apply (hνd x hx)))
    have h3 := congrArg (fun L => L a') (h1.unique h2)
    simpa [hbν] using h3
  have hsymmν : IsSymmSndFDerivAt ℝ ν x := (hνc x hx).isSymmSndFDerivAt (by simp)
  refine ⟨hi x hx a ha, hii x hx a ha b hb, fun d hd => ⟨?_, ?_⟩⟩
  · -- Step 4 (iii), Codazzi: symmetry of `D²ν(x)` and (ii)
    rw [hDC a ha, hDC b hb, hformula a b (hmemT b hb).1 (hmemT b hb).2,
      hformula b a (hmemT a ha).1 (hmemT a ha).2, hsymmν a b, hii x hx a ha b hb]
  · -- Step 5 (iv): `C(y) u · w = C(y) w · u` on `M`; differentiate along `M`
    have hsymC : ∀ y ∈ M, ∀ u w : Euclid P, inner ℝ (Ct y u) w = inner ℝ (Ct y w) u := by
      intro y hy u w
      rw [← hCeq y hy]
      set K := Submodule.span ℝ (tangentSpace M y)
      have hPu : K.starProjection u ∈ tangentSpace M y :=
        hspan y hy _ (K.starProjection_apply_mem u)
      have hPw : K.starProjection w ∈ tangentSpace M y :=
        hspan y hy _ (K.starProjection_apply_mem w)
      have h1 : fderiv ℝ ν y (K.starProjection u) ∈ K := Submodule.subset_span (hi y hy _ hPu)
      have h2 : fderiv ℝ ν y (K.starProjection w) ∈ K := Submodule.subset_span (hi y hy _ hPw)
      simp only [ContinuousLinearMap.comp_apply]
      calc inner ℝ (fderiv ℝ ν y (K.starProjection u)) w
          = inner ℝ (K.starProjection (fderiv ℝ ν y (K.starProjection u))) w := by
            rw [Submodule.starProjection_eq_self_iff.mpr h1]
        _ = inner ℝ (fderiv ℝ ν y (K.starProjection u)) (K.starProjection w) :=
            K.inner_starProjection_left_eq_right _ _
        _ = inner ℝ (fderiv ℝ ν y (K.starProjection w)) (K.starProjection u) :=
            hii y hy _ hPu _ hPw
        _ = inner ℝ (K.starProjection (fderiv ℝ ν y (K.starProjection w))) u :=
            (K.inner_starProjection_left_eq_right _ _).symm
        _ = inner ℝ (fderiv ℝ ν y (K.starProjection w)) u := by
            rw [Submodule.starProjection_eq_self_iff.mpr h2]
    have hs0 : EqOn (fun y => inner ℝ (Ct y b) d - inner ℝ (Ct y d) b) (fun _ => (0 : ℝ)) M :=
      fun y hy => sub_eq_zero.mpr (hsymC y hy b d)
    have hsd : HasFDerivAt (fun y => inner ℝ (Ct y b) d - inner ℝ (Ct y d) b) _ x :=
      ((hCtd.clm_apply (hasFDerivAt_const b x)).inner ℝ (hasFDerivAt_const d x)).sub
        ((hCtd.clm_apply (hasFDerivAt_const d x)).inner ℝ (hasFDerivAt_const b x))
    have e1 := Submission.codim1_hcp_sc_fderivWithin_tangent_eq P ℝ M _ _ x
      ((hasFDerivWithinAt_const (0 : ℝ) x M).congr hs0 (hs0 hx)) a (Submodule.subset_span ha)
    have e2 := Submission.codim1_hcp_sc_fderivWithin_tangent_eq P ℝ M _ _ x
      hsd.hasFDerivWithinAt a (Submodule.subset_span ha)
    rw [e1] at e2
    rw [hDC a ha]
    exact sub_eq_zero.mp (by simpa using e2.symm)

/-- **Simon, Appendix B, B.8 (Simons' identity) for a minimal hypersurface of `A₀`**: for every
`x ∈ M`, `Δ_M |A|²(x) = 2 |∇A|²(x) − 2 (|A|²(x))²`, where `δⱼ g = D^M g (P eⱼ)`,
`Δ_M = Σⱼ δⱼ δⱼ`, `|A|² = Σᵢ |Dν(P eᵢ)|²` and `∇A` is the tangential derivative of
`C = Dν ∘ P`.

The proof is the frame-free form of B.4–B.9 (the elementary derivation of [Giu84, Ch. 10] that
Simon cites before B.4).  On the open `O ⊇ M` put `Q(z) w = Π w − ⟨ν(z), w⟩ ν(z)` (`Π` the
projection onto `A₀`), `C(z) = Dν(z) ∘ Q(z)` and `δ_b f(z) = Df(z) (Q(z) b)`.  By
`codim1_hcp_sc_tangent_normal_complement`, `Q(y) = P_y` on `M`, and by
`codim1_hcp_sc_fderivWithin_tangent_eq`, `fderivWithin` along `T_y M` is the derivative of any
ambient smooth extension; so every quantity of the statement is an ambient one.  Then:
* `δ`-derivatives only see values on `M`;
* `δ_a δ_b f − δ_b δ_a f = ⟨ν, a⟩ Df(C b) − ⟨ν, b⟩ Df(C a)` on `M`, by the symmetry of `D²f` and
  of the Weingarten map (B.4, `codim1_hcp_sc_weingarten_codazzi`).  For `f = ν` this is Codazzi
  (B.5); applied to `f = C` it replaces the Gauss and Ricci identities (B.6–B.7);
* contracting Codazzi and using `H = tr C = 0` on `M`: `Σⱼ δⱼ C eⱼ = −|A|² ν` on `M`;
* B.8–B.9: the product rule, the splitting `Σⱼ |δⱼ C|² = |∇A|² + 2 Σⱼ |C² eⱼ|²` and
  `Σᵢ ⟨C eᵢ, Σⱼ δⱼ δⱼ C eᵢ⟩ = −|A|⁴ − 2 Σⱼ |C² eⱼ|²` give `Δ_M |A|² = 2 |∇A|² − 2 |A|⁴`. -/
theorem Submission.codim1_hcp_sc_simons_identity : ∀ (P m : ℕ) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)) (ν : Euclid P → Euclid P), Module.finrank ℝ A₀ = m + 1 → M ⊆ (A₀ : Set (Euclid P)) → (∀ r : ℕ, IsEmbeddedSubmanifold r m M) → (∃ O : Set (Euclid P), IsOpen O ∧ M ⊆ O ∧ ContDiffOn ℝ (⊤ : ℕ∞) ν O) → (∀ x ∈ M, ν x ∈ A₀ ∧ ‖ν x‖ = 1 ∧ ∀ v ∈ tangentSpace M x, inner ℝ (ν x) v = 0) → (∀ x ∈ M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ ν x).toLinearMap) = 0) → ∀ x ∈ M, (∑ j : Fin P, fderivWithin ℝ (fun y => fderivWithin ℝ (fun z => ∑ i : Fin P, ‖fderiv ℝ ν z ((Submodule.span ℝ (tangentSpace M z)).starProjection (EuclideanSpace.single i 1))‖ ^ 2) M y ((Submodule.span ℝ (tangentSpace M y)).starProjection (EuclideanSpace.single j 1))) M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) = 2 * (∑ i : Fin P, ∑ j : Fin P, ∑ k : Fin P, (inner ℝ (fderivWithin ℝ (fun y => (fderiv ℝ ν y).comp (Submodule.span ℝ (tangentSpace M y)).starProjection) M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single k 1)) ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single i 1))) ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) ^ 2) - 2 * (∑ i : Fin P, ‖fderiv ℝ ν x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single i 1))‖ ^ 2) ^ 2 := by
  intro P m A₀ M ν hdim hMA hM hO hν htr x hx
  refine Exists.elim hO fun O hO' => ?_
  have hOo : IsOpen O := hO'.1
  have hMO : M ⊆ O := hO'.2.1
  have hνO : ContDiffOn ℝ (⊤ : ℕ∞) ν O := hO'.2.2
  have hxO : x ∈ O := hMO hx
  have NC' := Submission.codim1_hcp_sc_tangent_normal_complement P m A₀ M ν hdim hMA (hM 1) hν
  have WC' := Submission.codim1_hcp_sc_weingarten_codazzi P m A₀ M ν hdim hMA hM
    ⟨O, hOo, hMO, hνO⟩ hν
  /- The standard basis `eⱼ` of `ℝᴾ`: Parseval's identity and its consequences. -/
  refine Exists.elim (⟨_, rfl⟩ : ∃ e : Fin P → Euclid P, e = fun i => EuclideanSpace.single i 1)
    fun e he => ?_
  have hpar : ∀ u v : Euclid P, ∑ i, inner ℝ u (e i) * inner ℝ v (e i) = inner ℝ u v := by
    intro u v
    have h := (EuclideanSpace.basisFun (Fin P) ℝ).sum_inner_mul_inner u v
    simp only [EuclideanSpace.basisFun_apply] at h
    rw [← h, he]
    exact Finset.sum_congr rfl fun j _ => by rw [real_inner_comm v]
  have hexp : ∀ u : Euclid P, ∑ i, inner ℝ u (e i) • e i = u := by
    intro u
    have h := (EuclideanSpace.basisFun (Fin P) ℝ).sum_repr' u
    simp only [EuclideanSpace.basisFun_apply] at h
    conv_rhs => rw [← h]
    rw [he]
    exact Finset.sum_congr rfl fun j _ => by rw [real_inner_comm]
  have hsq : ∀ u : Euclid P, ∑ i, inner ℝ u (e i) ^ 2 = ‖u‖ ^ 2 := by
    intro u
    rw [← real_inner_self_eq_norm_sq, ← hpar]
    exact Finset.sum_congr rfl fun j _ => sq _
  have hinclm : ∀ (W : Euclid P →L[ℝ] Euclid P) (n v : Euclid P),
      ∑ i, inner ℝ n (e i) * inner ℝ (W (e i)) v = inner ℝ (W n) v := by
    intro W n v
    conv_rhs => rw [← hexp n]
    rw [map_sum, sum_inner]
    exact Finset.sum_congr rfl fun i _ => by rw [map_smul, real_inner_smul_left]
  have hsmclm : ∀ (T : Euclid P →L[ℝ] Euclid P) (u : Euclid P),
      ∑ i, inner ℝ u (e i) • T (e i) = T u := by
    intro T u
    conv_rhs => rw [← hexp u]
    rw [map_sum]
    exact Finset.sum_congr rfl fun i _ => (map_smul T _ _).symm
  /- Step B (linear algebra): `Σⱼ |L_j|²` splits into the tangential block and twice
  `Σⱼ |S² eⱼ|²`, given the normal parts of `L_j` in both slots. -/
  have hstepB : ∀ (n : Euclid P) (S R : Euclid P →L[ℝ] Euclid P)
      (L : Fin P → Euclid P →L[ℝ] Euclid P), ‖n‖ = 1 → R n = 0 →
      (∀ w, inner ℝ n (R w) = 0) → (∀ w, inner ℝ n (S w) = 0) →
      (∀ u v, inner ℝ (R u) v = inner ℝ u (R v)) → (∀ w, S (R w) = S w) →
      (∀ u v, inner ℝ (S u) v = inner ℝ u (S v)) →
      (∀ j b, L j b - L j (R b) = -(inner ℝ n b • S (S (e j)))) →
      (∀ j b, L j b - R (L j b) = -(inner ℝ (S (e j)) (S b) • n)) →
      ∑ j, ∑ i, ‖L j (e i)‖ ^ 2 =
        ∑ j, ∑ i, ∑ k, inner ℝ (L j (R (e i))) (R (e k)) ^ 2 + 2 * ∑ j, ‖S (S (e j))‖ ^ 2 := by
    intro n S R L hn hRn hnR hnS hRsymm hSR hSsymm hLin' hLout'
    rw [Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    have hnn : inner ℝ n n = 1 := by rw [real_inner_self_eq_norm_sq, hn]; norm_num
    have hnw : inner ℝ n (S (S (e j))) = 0 := hnS _
    -- `L_j eᵢ = R L_j R eᵢ − ⟨n, eᵢ⟩ S² eⱼ − ⟨S² eⱼ, eᵢ⟩ n`
    have hdec : ∀ i, L j (e i) = R (L j (R (e i))) - inner ℝ n (e i) • S (S (e j)) -
        inner ℝ (S (S (e j))) (e i) • n := by
      intro i
      have h1 := hLin' j (e i)
      have h2 := hLout' j (R (e i))
      rw [hSR, ← hSsymm (S (e j)) (e i)] at h2
      calc L j (e i) = (L j (e i) - L j (R (e i))) + (L j (R (e i)) - R (L j (R (e i)))) +
            R (L j (R (e i))) := by abel
        _ = R (L j (R (e i))) - inner ℝ n (e i) • S (S (e j)) -
            inner ℝ (S (S (e j))) (e i) • n := by rw [h1, h2]; abel
    have hnorm : ∀ i, ‖L j (e i)‖ ^ 2 = ‖R (L j (R (e i)))‖ ^ 2 -
        2 * (inner ℝ n (e i) * inner ℝ (R (L j (R (e i)))) (S (S (e j)))) +
        inner ℝ n (e i) ^ 2 * ‖S (S (e j))‖ ^ 2 + inner ℝ (S (S (e j))) (e i) ^ 2 := by
      intro i
      have hnY : inner ℝ n (R (L j (R (e i)))) = 0 := hnR _
      have hYn : inner ℝ (R (L j (R (e i)))) n = 0 := by rw [real_inner_comm]; exact hnY
      have hwn : inner ℝ (S (S (e j))) n = 0 := by rw [real_inner_comm]; exact hnw
      rw [hdec i]
      simp only [← real_inner_self_eq_norm_sq, inner_sub_left, inner_sub_right,
        real_inner_smul_left, real_inner_smul_right, hYn, hnY, hwn, hnw, hnn,
        real_inner_comm (R (L j (R (e i)))) (S (S (e j)))]
      ring
    simp_rw [hnorm]
    rw [Finset.sum_add_distrib, Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum,
      ← Finset.sum_mul]
    have hA : ∑ i, ‖R (L j (R (e i)))‖ ^ 2 =
        ∑ i, ∑ k, inner ℝ (L j (R (e i))) (R (e k)) ^ 2 := by
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [← hsq]
      exact Finset.sum_congr rfl fun k _ => by rw [hRsymm]
    have hB : ∑ i, inner ℝ n (e i) * inner ℝ (R (L j (R (e i)))) (S (S (e j))) = 0 := by
      have := hinclm (R.comp ((L j).comp R)) n (S (S (e j)))
      simp only [ContinuousLinearMap.comp_apply, hRn, map_zero, inner_zero_left] at this
      exact this
    have hC1 : ∑ i, inner ℝ n (e i) ^ 2 = 1 := by
      rw [hsq, hn]; norm_num
    rw [hA, hB, hC1, hsq]
    ring
  /- Step C (algebra): `Σᵢ ⟨S eᵢ, Λ eᵢ⟩ = −|S|⁴ − 2 Σᵢ |S² eᵢ|²` for `Λ` of the form below. -/
  have hstepCalg : ∀ (n : Euclid P) (S : Euclid P →L[ℝ] Euclid P), S n = 0 →
      (∀ w, inner ℝ n (S w) = 0) → (∀ u v, inner ℝ (S u) v = inner ℝ u (S v)) →
      ∀ (Λ : Euclid P → Euclid P) (κ : Euclid P → ℝ) (V : Euclid P),
      (∀ b, Λ b = κ b • n - (∑ i, ‖S (e i)‖ ^ 2) • S b - (2 : ℝ) • S (S (S b)) -
        inner ℝ n b • V) →
      ∑ i, inner ℝ (S (e i)) (Λ (e i)) =
        -(∑ i, ‖S (e i)‖ ^ 2) ^ 2 - 2 * ∑ i, ‖S (S (e i))‖ ^ 2 := by
    intro n S hSn hnS hSsymm Λ κ V hΛ
    have h1 : ∀ i, inner ℝ (S (e i)) n = 0 := fun i => by rw [real_inner_comm]; exact hnS _
    have h2 : ∀ i, inner ℝ (S (e i)) (S (S (S (e i)))) = ‖S (S (e i))‖ ^ 2 := fun i => by
      rw [← hSsymm, real_inner_self_eq_norm_sq]
    have h3 : ∑ i, inner ℝ n (e i) * inner ℝ (S (e i)) V = 0 := by
      rw [hinclm, hSn, inner_zero_left]
    simp_rw [hΛ, inner_sub_right, real_inner_smul_right, h1, h2, real_inner_self_eq_norm_sq]
    simp only [mul_zero, zero_sub, Finset.sum_sub_distrib, Finset.sum_neg_distrib]
    rw [h3, ← Finset.mul_sum, ← Finset.mul_sum]
    ring
  /- The ambient projection field `Q(z) w = Π w − ⟨ν(z), w⟩ ν(z)`. -/
  refine Exists.elim (⟨_, rfl⟩ : ∃ Q : Euclid P → Euclid P →L[ℝ] Euclid P,
      Q = fun z => A₀.starProjection - (innerSL ℝ (ν z)).smulRight (ν z)) fun Q hQdef => ?_
  have hQ : ∀ z w, Q z w = A₀.starProjection w - inner ℝ (ν z) w • ν z := fun z w => by
    rw [hQdef]; simp
  have hQsymm : ∀ z u v, inner ℝ (Q z u) v = inner ℝ u (Q z v) := by
    intro z u v
    rw [hQ, hQ, inner_sub_left, inner_sub_right, real_inner_smul_left, real_inner_smul_right,
      Submodule.inner_starProjection_left_eq_right, real_inner_comm (ν z) u]
    ring
  -- where `ν ∈ A₀` is a unit vector, `Q` is the orthogonal projection onto `A₀ ∩ ν^⊥`
  have hQfacts : ∀ y, ν y ∈ A₀ → ‖ν y‖ = 1 →
      (∀ w, inner ℝ (ν y) (Q y w) = 0) ∧ (∀ w, Q y w ∈ A₀) ∧ Q y (ν y) = 0 ∧
        (∀ v ∈ A₀, inner ℝ (ν y) v = 0 → Q y v = v) ∧ (∀ w, Q y (Q y w) = Q y w) := by
    intro y hA h1
    have hPν : A₀.starProjection (ν y) = ν y := (Submodule.starProjection_eq_self_iff).2 hA
    have hνν : inner ℝ (ν y) (ν y) = 1 := by rw [real_inner_self_eq_norm_sq, h1]; norm_num
    have h1' : ∀ w, inner ℝ (ν y) (Q y w) = 0 := by
      intro w
      rw [hQ, inner_sub_right, real_inner_smul_right, hνν,
        ← Submodule.inner_starProjection_left_eq_right, hPν]
      ring
