      rw [← integral_const_mul]
      refine integral_congr_ae ?_
      filter_upwards [hpair] with x hx
      rw [← hVapp]
      simp only [hH, hq]
      split_ifs
      · rw [hVsmul, smul_apply, map_smul, smul_eq_mul, hx]
        ring
      · rw [hV0, zero_apply, map_zero]
        ring
    -- the co-area formula (4.2) for `q`: `∫_M |G| q dH^{m+2} = ∫_a^b τ(R_t)(ω) dt`
    obtain ⟨-, -, hco⟩ := hsigned q hqm' (hqfin ω q hqm' hqle)
    have hslice : (fun t => ∫ x in RT.carrier ∩ f ⁻¹' {t}, q x ∂μHE[m + 1]) =ᵐ[volume]
        (Ioo a b).indicator fun s => (Rs s).action (ω : DifferentialForm (Euclid P) (m + 1)) := by
      filter_upwards [hRae] with t ⟨hc, hm, ho⟩
      have hcongr : ∫ x in RT.carrier ∩ f ⁻¹' {t}, q x ∂μHE[m + 1] =
          ∫ x in RT.carrier ∩ f ⁻¹' {t}, (if a < t ∧ t < b then
            (RT.mult x : ℝ) * ζ x ((ω : DifferentialForm (Euclid P) (m + 1)) x) else 0)
            ∂μHE[m + 1] := by
        refine setIntegral_congr_fun (hSm t) fun x hx => ?_
        have hfx : f x = t := hx.2
        simp only [hq, hfx]
      rw [hcongr]
      by_cases ht : a < t ∧ t < b
      · rw [indicator_of_mem (show t ∈ Ioo a b from ht), IMRep.action, hc, hm, ho]
        simp only [ht, and_self, ↓reduceIte]
      · rw [indicator_of_notMem (show t ∉ Ioo a b from ht)]
        simp only [ht, ↓reduceIte, integral_zero]
    have key : ∫ s in a..b, (Rs s).action (ω : DifferentialForm (Euclid P) (m + 1)) =
        ∫ x in RT.carrier, ‖G x‖ * q x ∂μHE[m + 2] := by
      rw [intervalIntegral.integral_of_le hab.le, integral_Ioc_eq_integral_Ioo,
        ← integral_indicator measurableSet_Ioo, ← integral_congr_ae hslice]
      exact hco
    rw [key]
    have h3 := hLeib.trans hRHS
    have hinv : (b - a) * (b - a)⁻¹ = 1 := mul_inv_cancel₀ hba.ne'
    linear_combination (b - a) * h3 - (∫ x in RT.carrier, ‖G x‖ * q x ∂μHE[m + 2]) * hinv

/-- **Simon Ch. 6, Remark 4.2 and the end of the proof of 4.5(2)** (p. 157): the averaged slice
identity gives the slice identity for `L¹`-a.e. `t`, simultaneously for all test forms.  Fix `ω`.
By Lebesgue differentiation (`LocallyIntegrable.ae_hasDerivAt_integral`) and (ii) with
`a = t + h`, `b = t`, for a.e. `t` the value `τ(R_t)(ω)` is the limit as `h ↑ 0` of the cut-off
integrals.  Since `γ_{t+h,t}(f) → 1_{f<t}`, dominated convergence identifies this limit with
`J(t, ω) = ∫_{M ∩ {f<t}} θ⟨dω, ξ⟩ - ∫_{M' ∩ {f<t}} θ'⟨ω, ξ'⟩`.  For the countable family `D` of
`dor_lmbs_testForm_countable_approx` the null sets have a null union.  Off it, both sides are
continuous along `ωₖ → ω`, `dωₖ → dω` uniformly with supports in a fixed compact `K`
(`dpf_pfc_imrep_pairing_integrable_abs_le`), so the identity extends from `D` to every `ω`. -/
theorem Submission.dtc_bc_lc_sl_slice_identity : ∀ (P m : ℕ) (RT : IMRep (univ : Set (Euclid P)) (m + 2)) (RB : IMRep (univ : Set (Euclid P)) (m + 1)) (Rs : ℝ → IMRep (univ : Set (Euclid P)) (m + 1)) (f : Euclid P → ℝ), Measurable f → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), LocallyIntegrable (fun s => (Rs s).action (ω : DifferentialForm (Euclid P) (m + 1)))) → (∀ (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)) (a b : ℝ), a < b → ∫ s in a..b, (Rs s).action (ω : DifferentialForm (Euclid P) (m + 1)) = (b - a) * ((∫ x in RT.carrier, (RT.mult x : ℝ) * min 1 (max 0 ((b - f x) / (b - a))) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 2]) - ∫ x in RB.carrier, (RB.mult x : ℝ) * min 1 (max 0 ((b - f x) / (b - a))) * RB.orient x ((ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 1])) → ∀ᵐ t, ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), (Rs t).action (ω : DifferentialForm (Euclid P) (m + 1)) = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 2]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 1] := by
  intro P m RT RB Rs f hf hloc hav
  -- Step 2 (dominated convergence): for `ε = -h ↓ 0` the cut-off `γ_{t-ε,t}(f)` tends to `1_{f<t}`
  have dct : ∀ (n : ℕ) (R : IMRep (univ : Set (Euclid P)) n) (β : Euclid P → Covector (Euclid P) n)
      (t : ℝ), Continuous β → HasCompactSupport β →
      Tendsto (fun h : ℝ => ∫ x in R.carrier, (R.mult x : ℝ) * min 1 (max 0 ((t - f x) / (t - (t + h)))) *
          R.orient x (β x) ∂μHE[n]) (𝓝[<] 0)
        (𝓝 (∫ x in R.carrier ∩ {x | f x < t}, (R.mult x : ℝ) * R.orient x (β x) ∂μHE[n])) := by
    intro n R β t hβc hβs
    obtain ⟨B, hB⟩ := hβc.bounded_above_of_compact_support hβs
    have hint := (Submission.dpf_pfc_imrep_pairing_integrable_abs_le P n univ (tsupport β) R β B
      hβs.isCompact (subset_univ _) hβc.aestronglyMeasurable
      (fun x hx => image_eq_zero_of_notMem_tsupport hx) hB).1
    have hθ : Measurable fun x => (R.mult x : ℝ) :=
      (measurable_from_nat (f := fun k : ℕ => (k : ℝ))).comp R.measurable_mult
    have hξβ : AEStronglyMeasurable (fun x => R.orient x (β x)) (μHE[n].restrict R.carrier) :=
      (continuous_fst.clm_apply continuous_snd).comp_aestronglyMeasurable₂
        R.aestronglyMeasurable_orient hβc.aestronglyMeasurable
    rw [← setIntegral_indicator (measurableSet_lt hf measurable_const)]
    refine tendsto_integral_filter_of_dominated_convergence
      (fun x => ‖(R.mult x : ℝ) * R.orient x (β x)‖) (Eventually.of_forall fun h => ?_)
      (Eventually.of_forall fun h => Eventually.of_forall fun x => ?_) hint.norm
      (Eventually.of_forall fun x => ?_)
    · have hγ : Measurable fun x => min (1 : ℝ) (max 0 ((t - f x) / (t - (t + h)))) :=
        measurable_const.min (measurable_const.max ((measurable_const.sub hf).div_const _))
      exact (hθ.mul hγ).aestronglyMeasurable.mul hξβ
    · -- `0 ≤ γ ≤ 1`
      have h0 : 0 ≤ min (1 : ℝ) (max 0 ((t - f x) / (t - (t + h)))) :=
        le_min zero_le_one (le_max_left _ _)
      have h1 : min (1 : ℝ) (max 0 ((t - f x) / (t - (t + h)))) ≤ 1 := min_le_left _ _
      rw [norm_mul, norm_mul, norm_mul, Real.norm_of_nonneg h0]
      exact mul_le_mul_of_nonneg_right (mul_le_of_le_one_right (norm_nonneg _) h1) (norm_nonneg _)
    · by_cases hx : f x < t
      · -- `γ = 1` once `f x - t < h < 0`
        rw [indicator_of_mem (show x ∈ {x | f x < t} from hx)]
        refine tendsto_const_nhds.congr' ?_
        filter_upwards [(eventually_gt_nhds (sub_neg.2 hx)).filter_mono nhdsWithin_le_nhds,
          self_mem_nhdsWithin] with h hh1 hh2
        have hh2 : h < 0 := hh2
        have hq : 1 ≤ (t - f x) / (t - (t + h)) := by
          rw [le_div_iff₀ (by linarith)]
          linarith
        rw [min_eq_left (le_max_of_le_right hq), mul_one]
      · -- `γ = 0` for `h < 0`
        rw [indicator_of_notMem (show x ∉ {x | f x < t} from hx)]
        refine tendsto_const_nhds.congr' ?_
        filter_upwards [self_mem_nhdsWithin] with h hh2
        have hh2 : h < 0 := hh2
        have hq : (t - f x) / (t - (t + h)) ≤ 0 :=
          div_nonpos_of_nonpos_of_nonneg (by linarith [not_lt.1 hx]) (by linarith)
        rw [max_eq_left hq, min_eq_right zero_le_one, mul_zero, zero_mul]
  -- Step 3 (Lebesgue differentiation): for each `ω`, the identity holds off an `ω`-dependent null set
  have hω : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), ∀ᵐ t,
      (Rs t).action (ω : DifferentialForm (Euclid P) (m + 1)) =
        (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) *
          RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 2]) -
        ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) *
          RB.orient x ((ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 1] := by
    intro ω
    have hdω := exteriorDerivative_isTestForm ω.property.1
    filter_upwards [LocallyIntegrable.ae_hasDerivAt_integral (hloc ω)] with t ht
    have h1 := (ht t).tendsto_slope_zero_left
    have h2 := (dct (m + 2) RT (exteriorDerivative (ω : DifferentialForm (Euclid P) (m + 1))) t
      hdω.1.continuous hdω.2).sub (dct (m + 1) RB ω t ω.property.1.1.continuous ω.property.1.2)
    refine tendsto_nhds_unique (h1.congr' ?_) h2
    filter_upwards [self_mem_nhdsWithin] with h hh
    have hh : h < 0 := hh
    have alg : ∀ X : ℝ, h⁻¹ * -((t - (t + h)) * X) = X := fun X => by
      rw [show t - (t + h) = -h by ring, neg_mul, neg_neg, ← mul_assoc, inv_mul_cancel₀ hh.ne,
        one_mul]
    rw [intervalIntegral.integral_same, sub_zero, intervalIntegral.integral_symm,
      hav ω (t + h) t (by linarith), smul_eq_mul]
    exact alg _
  -- Step 6 (continuity): the pairings converge along `C¹`-uniformly convergent forms in a fixed `K`
  have conv : ∀ (n : ℕ) (R : IMRep (univ : Set (Euclid P)) n) (E K : Set (Euclid P))
      (βs : ℕ → Euclid P → Covector (Euclid P) n) (β : Euclid P → Covector (Euclid P) n),
      MeasurableSet E → IsCompact K → (∀ k, Continuous (βs k)) → Continuous β →
      (∀ k x, x ∉ K → βs k x = 0) → (∀ x, x ∉ K → β x = 0) → TendstoUniformly βs β atTop →
      Tendsto (fun k => ∫ x in R.carrier ∩ E, (R.mult x : ℝ) * R.orient x (βs k x) ∂μHE[n]) atTop
        (𝓝 (∫ x in R.carrier ∩ E, (R.mult x : ℝ) * R.orient x (β x) ∂μHE[n])) := by
    intro n R E K βs β hE hK hβsc hβc hβs0 hβ0 hu
    have hint : ∀ γ : Euclid P → Covector (Euclid P) n, Continuous γ → (∀ x, x ∉ K → γ x = 0) →
        IntegrableOn (fun x => (R.mult x : ℝ) * R.orient x (γ x)) (R.carrier ∩ E) μHE[n] := by
      intro γ hγc hγ0
      obtain ⟨B, hB⟩ := hγc.bounded_above_of_compact_support (HasCompactSupport.intro hK hγ0)
      exact IntegrableOn.mono_set (Submission.dpf_pfc_imrep_pairing_integrable_abs_le P n univ K R γ B
        hK (subset_univ K) hγc.aestronglyMeasurable hγ0 hB).1 inter_subset_left
    set C := (∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal with hC
    have hC0 : 0 ≤ C := ENNReal.toReal_nonneg
    refine Metric.tendsto_nhds.2 fun ε hε => ?_
    have hδ : 0 < ε / (C + 1) := div_pos hε (by linarith)
    filter_upwards [Metric.tendstoUniformly_iff.1 hu _ hδ] with k hk
    have hG := Submission.dpf_pfc_imrep_pairing_integrable_abs_le P n univ K R
      (E.indicator fun x => βs k x - β x) (ε / (C + 1)) hK (subset_univ K)
      (((hβsc k).sub hβc).aestronglyMeasurable.indicator hE)
      (fun x hx => indicator_apply_eq_zero.2 fun _ => by rw [hβs0 k x hx, hβ0 x hx, sub_zero])
      (fun x => (norm_indicator_le_norm_self _ x).trans (by
        rw [← dist_eq_norm, dist_comm]
        exact (hk x).le))
    have heq : (∫ x in R.carrier ∩ E, (R.mult x : ℝ) * R.orient x (βs k x) ∂μHE[n]) -
        ∫ x in R.carrier ∩ E, (R.mult x : ℝ) * R.orient x (β x) ∂μHE[n] =
        ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (E.indicator (fun y => βs k y - β y) x)
          ∂μHE[n] := by
      rw [← integral_sub (hint _ (hβsc k) (hβs0 k)) (hint _ hβc hβ0), ← setIntegral_indicator hE]
      refine integral_congr_ae (Eventually.of_forall fun x => ?_)
      by_cases hx : x ∈ E
      · simp only [indicator_of_mem hx, map_sub, mul_sub]
      · simp only [indicator_of_notMem hx, map_zero, mul_zero]
    rw [Real.dist_eq, heq]
    calc _ ≤ ε / (C + 1) * C := hG.2
      _ < ε := by
        rw [div_mul_eq_mul_div, div_lt_iff₀ (by linarith)]
        exact mul_lt_mul_of_pos_left (lt_add_one C) hε
  -- Steps 4–5: a countable family `D` of test forms, and the union of the null sets over `D`
  obtain ⟨D, hDc, hDapprox⟩ :=
    Submission.dor_lmbs_testForm_countable_approx P (m + 1) univ isOpen_univ
  have hDae : ∀ᵐ t, ∀ η ∈ D, (Rs t).action (η : DifferentialForm (Euclid P) (m + 1)) =
      (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) *
        RT.orient x (exteriorDerivative (η : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 2]) -
      ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) *
        RB.orient x ((η : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 1] :=
    (ae_ball_iff hDc).2 fun η _ => hω η
  -- Step 6: extend from `D` to every `ω` by approximation
  filter_upwards [hDae] with t ht ω
  obtain ⟨K, ωs, hK, -, hωK, hωsD, hωsK, hu, hdu⟩ := hDapprox ω
  have h0 : ∀ η : TestFormOn (univ : Set (Euclid P)) (m + 1),
      tsupport (η : DifferentialForm (Euclid P) (m + 1)) ⊆ K → ∀ x, x ∉ K →
        (η : DifferentialForm (Euclid P) (m + 1)) x = 0 ∧
          exteriorDerivative (η : DifferentialForm (Euclid P) (m + 1)) x = 0 := fun η hη x hx =>
    ⟨image_eq_zero_of_notMem_tsupport fun h => hx (hη h),
      image_eq_zero_of_notMem_tsupport fun h => hx (hη (tsupport_exteriorDerivative_subset _ h))⟩
  have hft : MeasurableSet {x | f x < t} := measurableSet_lt hf measurable_const
  have e1 := conv (m + 1) (Rs t) univ K (fun k => (ωs k : DifferentialForm (Euclid P) (m + 1))) ω
    MeasurableSet.univ hK (fun k => (ωs k).property.1.1.continuous) ω.property.1.1.continuous
    (fun k x hx => (h0 _ (hωsK k) x hx).1) (fun x hx => (h0 _ hωK x hx).1) hu
  have e2 := conv (m + 2) RT {x | f x < t} K
    (fun k => exteriorDerivative (ωs k : DifferentialForm (Euclid P) (m + 1)))
    (exteriorDerivative (ω : DifferentialForm (Euclid P) (m + 1))) hft hK
    (fun k => (exteriorDerivative_isTestForm (ωs k).property.1).1.continuous)
    (exteriorDerivative_isTestForm ω.property.1).1.continuous
    (fun k x hx => (h0 _ (hωsK k) x hx).2) (fun x hx => (h0 _ hωK x hx).2) hdu
  have e3 := conv (m + 1) RB {x | f x < t} K (fun k => (ωs k : DifferentialForm (Euclid P) (m + 1)))
    ω hft hK (fun k => (ωs k).property.1.1.continuous) ω.property.1.1.continuous
    (fun k x hx => (h0 _ (hωsK k) x hx).1) (fun x hx => (h0 _ hωK x hx).1) hu
  simp only [inter_univ] at e1
  exact tendsto_nhds_unique e1 ((e2.sub e3).congr fun k => (ht (ωs k) (hωsD k)).symm)

/-- **Simon Ch. 6, Lemma 4.5 and 4.8** (slicing an integer multiplicity current by a Lipschitz
function).  Let `T = τ(M, θ, ξ) ∈ 𝒟_{m+2}(ℝᴾ)`, `∂T = τ(M', θ', ξ')` and `f` `L`-Lipschitz.  Then
`P_t := ∂(T ⌞ {f < t}) − (∂T) ⌞ {f < t}` (4.6) has `t ↦ M_W(P_t)` a.e.-measurable with
`∫ M_W(P_t) dt ≤ L M_W(T)` for open `W` (4.5(1)), and for a.e. `t` it is integer multiplicity and
vanishes on forms supported off `f⁻¹(t)` (4.5(2), 4.8).  The hypothesis `m + 1 < P` is not used.

Proof sketch:
* For every `t`, the restrictions `A_t = T ⌞ {f < t}` and `B_t = (∂T) ⌞ {f < t}` are represented by
  `(M ∩ {f < t}, θ, ξ)` and `(M' ∩ {f < t}, θ', ξ')`; then `P_t = ∂A_t − B_t` is given by the
  stated integral formula for every `t`.
* The slices `⟨T, f, t⟩ = τ(R_t)` (4.3–4.4) are carried by `f⁻¹(t)`, with
  `∫ μ_{R_t}(W) dt ≤ L μ_T(W)` and the averaged identity of the proof of 4.5(2).
* Remark 4.2 and a countable dense family of forms give `τ(R_t) = P_t` for a.e. `t`.
* Hence `P_t` is integer multiplicity and vanishes on forms supported off `f⁻¹(t)` for a.e.
  `t`, and `M_W(P_t) = μ_{R_t}(W)` (6.3.2(3)) gives the mass bound. -/
theorem Submission.dtc_bc_lc_slice : ∀ (P m : ℕ) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (RT : IMRep (univ : Set (Euclid P)) (m + 2)) (RB : IMRep (univ : Set (Euclid P)) (m + 1)) (f : Euclid P → ℝ) (L : NNReal), m + 1 < P → RT.Represents T → RB.Represents T.boundary → LipschitzWith L f → ∃ Ps : ℝ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), (∀ W : Set (Euclid P), IsOpen W → AEMeasurable (fun t => (Ps t).massOn W) ∧ ∫⁻ t, (Ps t).massOn W ≤ (L : ℝ≥0∞) * T.massOn W) ∧ ∀ᵐ t, IsIntegerMultiplicity (Ps t) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (f ⁻¹' {t}) → Ps t ω = 0) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Ps t ω = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 2]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 1] := by
  intro P m T RT RB f L _ hRT hRB hf
  have hfm : Measurable f := hf.continuous.measurable
  have hE : ∀ t : ℝ, MeasurableSet {x | f x < t} := fun t =>
    (isOpen_lt hf.continuous continuous_const).measurableSet
  -- (1) the restrictions `A_t = T ⌞ {f < t}` and `B_t = (∂T) ⌞ {f < t}`, for every `t`
  have hres := Submission.cmc_imRep_locality_restrict_sub.2.1
  choose A RA hRA hRAc hRAm hRAo using fun t : ℝ =>
    hres P (m + 2) univ RT {x | f x < t} isOpen_univ (hE t)
  choose B RB' hRB' hRB'c hRB'm hRB'o using fun t : ℝ =>
    hres P (m + 1) univ RB {x | f x < t} isOpen_univ (hE t)
  -- `P_t = ∂A_t − B_t` is given by the integral formula for every `t`
  have hPs : ∀ (t : ℝ) (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)),
      ((A t).boundary - B t) ω = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) *
        RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 2]) -
        ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) *
          RB.orient x ((ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 1] := by
    intro t ω
    change (A t).boundary ω - B t ω = _
    rw [GeometricCurrentOn.boundary_apply, hRA t, hRB' t]
    simp only [IMRep.action]
    rw [hRAc t, hRAm t, hRAo t, hRB'c t, hRB'm t, hRB'o t]
    rfl
  -- (2) the slices `R_t`, and `τ(R_t) = P_t` for a.e. `t`
  obtain ⟨Rs, hRsc, hRsm, hRsi, hRsa⟩ :=
    Submission.dtc_bc_lc_sl_slice_family P m T RT RB f L hRT hRB hf
  have hid := Submission.dtc_bc_lc_sl_slice_identity P m RT RB Rs f hfm
    (fun ω => (hRsi ω).locallyIntegrable) hRsa
  have hrep : ∀ᵐ t, (Rs t).Represents ((A t).boundary - B t) := by
    filter_upwards [hid] with t ht ω
    rw [hPs t ω, ht ω]
  refine ⟨fun t => (A t).boundary - B t, fun W hW => ?_, ?_⟩
  · -- (3) mass: `M_W(P_t) = μ_{R_t}(W)` for a.e. `t` and `M_W(T) = μ_T(W)`
    have hmeq : (fun t => (Rs t).measure W) =ᵐ[volume]
        fun t => ((A t).boundary - B t).massOn W := by
      filter_upwards [hrep] with t ht
      exact (Submission.dtc_mass_eq_measure P (m + 1) univ W _ (Rs t) isOpen_univ hW
        (subset_univ W) ht).symm
    refine ⟨(hRsm W hW.measurableSet).1.congr hmeq, ?_⟩
    calc ∫⁻ t, ((A t).boundary - B t).massOn W = ∫⁻ t, (Rs t).measure W :=
          (lintegral_congr_ae hmeq).symm
      _ ≤ (L : ℝ≥0∞) * RT.measure W := (hRsm W hW.measurableSet).2
      _ = (L : ℝ≥0∞) * T.massOn W := by
          rw [Submission.dtc_mass_eq_measure P (m + 2) univ W T RT isOpen_univ hW
            (subset_univ W) hRT]
  · -- (4) integer multiplicity, support in `f⁻¹(t)` and the slice formula, for a.e. `t`
    filter_upwards [hrep] with t ht
    refine ⟨⟨Rs t, ht⟩, fun ω hω => (ht ω).trans ?_, hPs t⟩
    rw [IMRep.action]
    refine setIntegral_eq_zero_of_forall_eq_zero fun x hx => ?_
    have hx' : x ∉ tsupport (ω : DifferentialForm (Euclid P) (m + 1)) :=
      fun h => Set.disjoint_left.mp hω h (hRsc t hx)
    rw [image_eq_zero_of_notMem_tsupport hx', map_zero, mul_zero]

Joint induction on the degree `d`: `CL(0)` is `cbr_closure_degree_zero`, `CL(d) ⇒ BR(d)` is
`cbr_boundary_isIntegerMultiplicity` (deformation theorem) and `CL(d) ∧ BR(d) ⇒ CL(d + 1)` is
`cbr_closure_succ` (localization by slicing).  The three steps receive the mass representation,
`M_W(T) = μ_R(W)`, the IM calculus, slicing, the deformation theorem and vanishing off the
support. -/
theorem Submission.cmc_closure_and_boundary_rectifiability : (∀ (P d : ℕ) (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U d) (T : GeometricCurrentOn U d), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T) ∧ (∀ (P d : ℕ) (U : Set (Euclid P)) (R : GeometricCurrentOn U (d + 1)), IsOpen U → IsIntegerMultiplicity R → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → R.boundary.massOn W < ∞) → IsIntegerMultiplicity R.boundary) := by
  -- `BR(d)` from `CL(d)`
  have hBR := Submission.cbr_boundary_isIntegerMultiplicity
    Submission.cmc_exists_massRepresentation Submission.cmc_massOn_eq_imRep_measure
    Submission.cmc_imRep_locality_restrict_sub Submission.cmc_slice_mass_bounds
    Submission.cmc_deformation_theorem Submission.dtc_vanish_off_support
  -- `CL(d)` for every `d`: `CL(0)`, and `CL(d) ∧ BR(d) ⇒ CL(d + 1)`
  have hCL : ∀ d : ℕ, ∀ (P : ℕ) (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U d)
      (T : GeometricCurrentOn U d), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) →
      (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U →
        ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) →
      WeaklyConvergesOn Ts T → IsIntegerMultiplicity T := by
    intro d
    induction d with
    | zero =>
      exact Submission.cbr_closure_degree_zero Submission.cmc_exists_massRepresentation
        Submission.cmc_massOn_eq_imRep_measure Submission.cmc_imRep_locality_restrict_sub
    | succ d ih =>
      exact Submission.cbr_closure_succ Submission.cmc_exists_massRepresentation
        Submission.cmc_massOn_eq_imRep_measure Submission.cmc_imRep_locality_restrict_sub
        Submission.cmc_slice_mass_bounds Submission.cmc_deformation_theorem
        Submission.dtc_vanish_off_support d ih (hBR d ih)
  exact ⟨fun P d => hCL d P, fun P d => hBR d (hCL d) P⟩

/-- **Simon Ch. 6, Theorem 7.2 ("only if")**: flat convergence of a weakly convergent sequence of
integer multiplicity currents.  Let `U ⊆ ℝᴾ` be open and `Tⱼ, T ∈ 𝒟ₙ(U)`, `n = m + 1`, integer
multiplicity with `sup_j (M_W(Tⱼ) + M_W(∂Tⱼ)) < ∞` for every open `W ⊂⊂ U` and `Tⱼ ⇀ T` in `U`.
Then for every open `W ⊂⊂ U` there are integer multiplicity `Rⱼ ∈ 𝒟ₙ₊₁(U)`, `Sⱼ ∈ 𝒟ₙ(U)` with
`T − Tⱼ − Sⱼ = ∂Rⱼ` and `M_W(Rⱼ) + M_W(Sⱼ) → 0`.

Let `d_W(X)` be the infimum of `M_W(R) + M_W(S)` over integer multiplicity `R`, `S` with
`X − S = ∂R`.  The pair `R = 0`, `S = T − Tⱼ` is admissible for `X = T − Tⱼ`, so it suffices that
`d_W(T − Tⱼ) → 0`, and by the subsequence principle that every subsequence `T_{ν(j)}` has a
further subsequence along which `d_W(T − T_{ν(j)}) → 0`.
* Localization near `closure W` (`cmc_fc_localize`) gives a subsequence `φ` and integer
  multiplicity `T'ⱼ ⇀ T'`, supported in one compact `K ⊆ U`, with `M(T'ⱼ), M(∂T'ⱼ) ≤ Λ`, that
  agree with `T_{ν(φ(j))}` and `T` on forms supported in `W`.
* By the deformation theorem these `T'ⱼ` are totally bounded for the integral flat distance
  (`cmc_fc_total_bounded`), so a subsequence `T'_{ψ(r)}` is flat-Cauchy (`cmc_fc_cauchy_subseq`);
  summing it against its weak limit gives `T' − T'_{ψ(ℓ)} − S' = ∂R'` with
  `M(R') + M(S') ≤ 2·2^{−ℓ}` (`cmc_fc_series_limit`, the closure theorem replacing Simon's 3.13).
* `S♯ = (T − T_{ν(φ(ψ(ℓ)))}) − ((T' − T'_{ψ(ℓ)}) − S')` is integer multiplicity,
  `T − T_{ν(φ(ψ(ℓ)))} − S♯ = ∂R'`, and `S♯ = S'` on forms supported in `W`, so
  `d_W(T − T_{ν(φ(ψ(ℓ)))}) ≤ M(R') + M(S') ≤ 2·2^{−ℓ}`. -/
theorem Submission.cmc_flat_convergence : ∀ (P m : ℕ) (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U (m + 1)) (T : GeometricCurrentOn U (m + 1)), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → IsIntegerMultiplicity T → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + (Ts j).boundary.massOn W) < ∞) → WeaklyConvergesOn Ts T → ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ∃ (R : ℕ → GeometricCurrentOn U (m + 2)) (S : ℕ → GeometricCurrentOn U (m + 1)), (∀ j, IsIntegerMultiplicity (R j) ∧ IsIntegerMultiplicity (S j) ∧ T - Ts j - S j = (R j).boundary) ∧ Tendsto (fun j => (R j).massOn W + (S j).massOn W) atTop (𝓝 0) := by
  intro P m U Ts T hU hTs hT hbd hconv W _ hWU
  -- (IR), (IS), (IO) of the integer multiplicity calculus, (CL), (BR) and (ME)
  obtain ⟨-, hIR, hIS, hIO⟩ := Submission.cmc_imRep_locality_restrict_sub
  obtain ⟨hCL, hBR⟩ := Submission.cmc_closure_and_boundary_rectifiability
  have hME := Submission.cmc_massOn_eq_imRep_measure
  have hWU' : W ⊆ U := subset_closure.trans hWU.2
  -- the zero current is integer multiplicity: `0 = τ(∅, 0, 0)`
  have hIM0 : IsIntegerMultiplicity (0 : GeometricCurrentOn U (m + 2)) := by
    refine ⟨{ carrier := ∅
              mult := fun _ => 0
              orient := fun _ => 0
              measurableSet_carrier := MeasurableSet.empty
              carrier_subset := empty_subset U
              rectifiable :=
                Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty
              measurable_mult := measurable_const
              mult_pos := fun x hx => absurd hx (notMem_empty x)
              locallyIntegrable_mult := fun K _ _ => by simp
              aestronglyMeasurable_orient := aestronglyMeasurable_const
              orients := by simp }, fun ω => ?_⟩
    simp [IMRep.action]
  -- every subsequence `T_{ν(j)}` has a further subsequence `T_{ν(μ(ℓ))}` with
  -- `T − T_{ν(μ(ℓ))} − S = ∂R`, `R`, `S` integer multiplicity, `M_W(R) + M_W(S) ≤ 2·2^{−ℓ}`
  have hsub : ∀ ν : ℕ → ℕ, Tendsto ν atTop atTop → ∃ μ : ℕ → ℕ, ∀ ℓ,
      ∃ (R : GeometricCurrentOn U (m + 2)) (S : GeometricCurrentOn U (m + 1)),
        (IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ T - Ts (ν (μ ℓ)) - S = R.boundary) ∧
          R.massOn W + S.massOn W ≤ 2 * (2⁻¹ : ℝ≥0∞) ^ ℓ := by
    intro ν hν
    -- `T_{ν(j)}` inherits the hypotheses
    have hbdν : ∀ V : Set (Euclid P), IsOpen V → CompactlyContained V U →
        ⨆ j, ((Ts (ν j)).massOn V + (Ts (ν j)).boundary.massOn V) < ∞ := fun V hV hVU =>
      (iSup_comp_le (fun j => (Ts j).massOn V + (Ts j).boundary.massOn V) ν).trans_lt
        (hbd V hV hVU)
    have hconvν : WeaklyConvergesOn (fun j => Ts (ν j)) T := fun ω => (hconv ω).comp hν
    -- localization: `T'ⱼ = X j ⇀ T' = X'`, supported in `K`, with `M(T'ⱼ), M(∂T'ⱼ) ≤ Λ`, equal
    -- to `T_{ν(φ(j))}` and `T` on forms supported in `W`
    obtain ⟨φ, K, Λ, X, X', -, hK, hKU, hX, hX', hXK, hXΛ, hXconv, hXW, hX'W⟩ :=
      Submission.cmc_fc_localize Submission.cmc_slice_mass_bounds hBR hIR hIO hME P m U
        (fun j => Ts (ν j)) T W hU (fun j => hTs (ν j)) hT hbdν hconvν hWU
    -- total boundedness (deformation theorem) and a flat-Cauchy subsequence `X ∘ ψ`
    obtain ⟨ψ, hψ, hcauchy⟩ := Submission.cmc_fc_cauchy_subseq hIS P m U X hU fun η hη => by
      obtain ⟨𝒬, h𝒬, hnet⟩ := Submission.cmc_fc_total_bounded Submission.cmc_deformation_theorem
        hBR hIR hIS hME P m U K Λ η hU hK hKU hη
      exact ⟨𝒬, h𝒬, fun j => hnet (X j) (hX j) (hXK j) (hXΛ j).1 (hXΛ j).2⟩
    choose Rc Sc hc using hcauchy
    -- summation against the weak limit: `X' − X (ψ ℓ) − S' = ∂R'`, `M(R') + M(S') ≤ 2·2^{−ℓ}`
    have hlim := Submission.cmc_fc_series_limit hCL hIS P m U (fun r => X (ψ r)) X' Λ Rc Sc hU
      (fun ω => (hXconv ω).comp hψ.tendsto_atTop) (fun r => hXΛ (ψ r)) hc
    refine ⟨fun ℓ => φ (ψ ℓ), fun ℓ => ?_⟩
    obtain ⟨R', S', hR', hS', hRS', hM'⟩ := hlim ℓ
    -- back to `T − T_{ν(φ(ψ(ℓ)))}`, with `S♯ = (T − T_{ν(φ(ψ(ℓ)))}) − ((X' − X (ψ ℓ)) − S')`
    refine ⟨R', (T - Ts (ν (φ (ψ ℓ)))) - ((X' - X (ψ ℓ)) - S'), ⟨hR', ?_, ?_⟩, ?_⟩
    · exact hIS P (m + 1) U _ _ hU (hIS P (m + 1) U _ _ hU hT (hTs _))
        (hIS P (m + 1) U _ _ hU (hIS P (m + 1) U _ _ hU hX' (hX (ψ ℓ))) hS')
    · rw [← hRS']
      ext ω
      show T ω - Ts (ν (φ (ψ ℓ))) ω - (T ω - Ts (ν (φ (ψ ℓ))) ω - (X' ω - X (ψ ℓ) ω - S' ω)) =
        X' ω - X (ψ ℓ) ω - S' ω
      ring
    · -- `S♯ = S'` on forms supported in `W`, so `M_W(S♯) = M_W(S') ≤ M(S')`
      have hSW : ((T - Ts (ν (φ (ψ ℓ)))) - ((X' - X (ψ ℓ)) - S')).massOn W = S'.massOn W := by
        refine congrArg sSup (Set.image_congr fun ω hω => ?_)
        have h1 : X' ω = T ω := hX'W ω hω.1
        have h2 : X (ψ ℓ) ω = Ts (ν (φ (ψ ℓ))) ω := hXW (ψ ℓ) ω hω.1
        show ENNReal.ofReal (T ω - Ts (ν (φ (ψ ℓ))) ω - (X' ω - X (ψ ℓ) ω - S' ω)) =
          ENNReal.ofReal (S' ω)
        rw [h1, h2, sub_sub_cancel]
      rw [hSW]
      exact (add_le_add (R'.massOn_mono hWU') (S'.massOn_mono hWU')).trans hM'
  -- `d_W(T − Tⱼ) → 0` by the subsequence principle
  let d : ℕ → ℝ≥0∞ := fun j => ⨅ (R : GeometricCurrentOn U (m + 2))
    (S : GeometricCurrentOn U (m + 1))
    (_ : IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ T - Ts j - S = R.boundary),
      R.massOn W + S.massOn W
  have hgeom : Tendsto (fun ℓ : ℕ => (2⁻¹ : ℝ≥0∞) ^ ℓ) atTop (𝓝 0) :=
    ENNReal.tendsto_pow_atTop_nhds_zero_iff.2 (ENNReal.inv_lt_one.2 ENNReal.one_lt_two)
  have hd : Tendsto d atTop (𝓝 0) := by
    refine tendsto_of_subseq_tendsto fun ν hν => ?_
    obtain ⟨μ, hμ⟩ := hsub ν hν
    have h2 := ENNReal.Tendsto.const_mul hgeom (Or.inr (ENNReal.ofNat_ne_top : (2 : ℝ≥0∞) ≠ ∞))
    rw [mul_zero] at h2
    refine ⟨μ, tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds h2
      (fun ℓ => zero_le) fun ℓ => ?_⟩
    obtain ⟨R, S, hRS, hle⟩ := hμ ℓ
    exact iInf_le_of_le R (iInf_le_of_le S (iInf_le_of_le hRS hle))
  -- for every `j` an admissible pair with `M_W(Rⱼ) + M_W(Sⱼ) ≤ d_W(T − Tⱼ) + 2^{−j}`
  have hpair : ∀ j, ∃ (R : GeometricCurrentOn U (m + 2)) (S : GeometricCurrentOn U (m + 1)),
      (IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ T - Ts j - S = R.boundary) ∧
        R.massOn W + S.massOn W ≤ d j + (2⁻¹ : ℝ≥0∞) ^ j := by
    intro j
    by_cases hdj : d j = ∞
    · -- the pair `R = 0`, `S = T − Tⱼ`
      refine ⟨0, T - Ts j, ⟨hIM0, hIS P (m + 1) U T (Ts j) hU hT (hTs j), ?_⟩, ?_⟩
      · ext ω
        show T ω - Ts j ω - (T ω - Ts j ω) = (0 : GeometricCurrentOn U (m + 2)).boundary ω
        simp
      · rw [hdj, top_add]
        exact le_top
    · obtain ⟨R, hR⟩ :=
        iInf_lt_iff.1 (ENNReal.lt_add_right (b := (2⁻¹ : ℝ≥0∞) ^ j) hdj (by simp))
      obtain ⟨S, hS⟩ := iInf_lt_iff.1 hR
      obtain ⟨hRS, hlt⟩ := iInf_lt_iff.1 hS
      exact ⟨R, S, hRS, hlt.le⟩
  choose R S hRS hle using hpair
  have hdg := hd.add hgeom
  rw [add_zero] at hdg
  exact ⟨R, S, hRS, tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hdg
    (fun j => zero_le) hle⟩

/-- **Local comparison inequality** (Simon 7.2.4, proof of (1)–(11)).  Let `Tⱼ ∈ 𝒟ₙ(U)`,
`n = m + 1`, be minimizing in `U` with locally bounded `M_W(Tⱼ) + M_W(∂Tⱼ)`, `Tⱼ ⇀ T` and `T`
integer multiplicity.  For compact `K ⊆ U` and `ε > 0` there are an open `W` with
`K ⊆ W ⊆ thickening ε K`, `W ⊂⊂ U`, a subsequence `φ` and `eⱼ → 0` such that
`M_W(T_{φ(j)}) ≤ M_W(S) + eⱼ` for every integer multiplicity `S` with `∂S = ∂T`, `spt(S − T) ⊆ K`.

* Cut-off `ψ = 1` on `K`, `W₀ = {ψ > 0} ⊂⊂ U`; slice by `f = −ψ`, so `W = {f < t} = {ψ > −t}`.
* Flat convergence on `W₀`: `T − Tⱼ − Sⱼ = ∂Rⱼ`, `M_{W₀}(Rⱼ) + M_{W₀}(Sⱼ) → 0`.
* Slicing `Rⱼ` by `f`; a level `t ∈ (−1, 0)` and `φ` with `μ_{Tⱼ}({f = t}) = 0` and
  `M(Pⱼ) ≤ M_{W₀}(Pⱼ) ≤ L Dⱼ`, `D_{φ(j)} → 0`, where `Pⱼ = ∂(Rⱼ⌞W) − (∂Rⱼ)⌞W` lives on `{f = t}`;
  `∂(Rⱼ⌞W)` is integer multiplicity by boundary rectifiability.
* `Z = Tᵢ + (S − T) + ∂(Rᵢ⌞W)` is an integer multiplicity competitor with `∂Z = ∂Tᵢ` and
  `spt(Z − Tᵢ) ⊆ {f ≤ t}`; minimality on all `G ⊇ {f ≤ t}`, `G ⊂⊂ U`, gives
  `μ_{Tᵢ}({f ≤ t}) ≤ μ_Z({f ≤ t})`, and `μ_Z({f = t}) ≤ M(Pᵢ)`, so `M_W(Tᵢ) ≤ M_W(Z) + M(Pᵢ)`.
* On `W`, `Z = S − Sᵢ`; hence `M_W(T_{φ(j)}) ≤ M_W(S) + eⱼ`, `eⱼ = M_W(S_{φ(j)}) + M(P_{φ(j)})`. -/
theorem Submission.cmc_local_comparison_inequality : ∀ (P m : ℕ) (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U (m + 1)) (T : GeometricCurrentOn U (m + 1)), IsOpen U → (∀ j, IsMinimizingIn (Ts j) U) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + (Ts j).boundary.massOn W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T → ∀ (K : Set (Euclid P)) (ε : ℝ), IsCompact K → K ⊆ U → 0 < ε → ∃ W : Set (Euclid P), IsOpen W ∧ K ⊆ W ∧ W ⊆ thickening ε K ∧ CompactlyContained W U ∧ ∃ (φ : ℕ → ℕ) (e : ℕ → ℝ≥0∞), StrictMono φ ∧ Tendsto e atTop (𝓝 0) ∧ ∀ S : GeometricCurrentOn U (m + 1), IsIntegerMultiplicity S → S.boundary = T.boundary → (S - T).support ⊆ K → ∀ j, (Ts (φ j)).massOn W ≤ S.massOn W + e j := by
  intro P m U Ts T hU hmin hbd hconv hTim K ε hK hKU hε
  -- (F4), (F5): integer multiplicity calculus; local finiteness of weights; (F1) `M_G = μ(G)`
  obtain ⟨-, himRestrict, himSub, himOrient⟩ := Submission.cmc_imRep_locality_restrict_sub
  have hfin : ∀ (d : ℕ) (R : IMRep U d) (K' : Set (Euclid P)), IsCompact K' → K' ⊆ U →
      R.measure K' < ∞ := fun d R K' hK' hK'U =>
    lt_top_iff_ne_top.2 (Submission.rsd_imrep_compact_measure_ne_top P d U R K' hK' hK'U).2
  have hmass : ∀ (d : ℕ) (X : GeometricCurrentOn U d) (R : IMRep U d), R.Represents X →
      ∀ G : Set (Euclid P), IsOpen G → X.massOn G = R.measure G := fun d X R hR G hG =>
    Submission.cmc_massOn_eq_imRep_measure P d U X R hU hR G hG
  -- the integral form `τ(M, θ, ξ)(ω) = ∫ ⟨ω, ξ⟩ dμ_R` (restriction calculus with `E = ℝᴾ`)
  have hact : ∀ (d : ℕ) (R : IMRep U d) (ω : DifferentialForm (Euclid P) d),
      R.action ω = ∫ x, R.orient x (ω x) ∂R.measure := fun d R ω => by
    have h := ((Submission.lcmp_imRep_measure_restrict P d U R).2.2 univ R MeasurableSet.univ
      (inter_univ _).symm rfl rfl).2 ω
    rwa [Measure.restrict_univ] at h
  -- Step 2: the cut-off `ψ`, `W₀ = {ψ > 0} ⊂⊂ U`, and the slicing function `f = -ψ`
  obtain ⟨ψ, L, hψL, -, hψK, hW₀th, hW₀cc⟩ :=
    Submission.lcmp_exists_lipschitz_cutoff P U K ε hU hK hKU hε
  set W₀ : Set (Euclid P) := {x | 0 < ψ x}
  have hW₀o : IsOpen W₀ := isOpen_lt continuous_const hψL.continuous
  obtain ⟨f, hf⟩ : ∃ f : Euclid P → ℝ, f = fun x => -ψ x := ⟨_, rfl⟩
  have hfx : ∀ x, f x = -ψ x := fun x => by subst hf; rfl
  have hfL : LipschitzWith L f := by subst hf; exact hψL.neg
  have hfc : Continuous f := hfL.continuous
  have hfK : ∀ x ∈ K, f x = -1 := fun x hx => by rw [hfx, hψK x hx]
  have hfW₀ : ∀ x, f x < 0 → x ∈ W₀ := fun x hx => by
    rw [hfx] at hx
    show 0 < ψ x
    linarith
  have hW₀U : ∀ x, f x < 0 → x ∈ U := fun x hx => hW₀cc.2 (subset_closure (hfW₀ x hx))
  -- Step 3: flat convergence on `W₀`: `T - Tⱼ - Sⱼ = ∂Rⱼ`
  obtain ⟨Rf, Sf, hRS, hlim⟩ := Submission.cmc_flat_convergence P m U Ts T hU (fun j => (hmin j).1)
    hTim hbd hconv W₀ hW₀o hW₀cc
  have hRim : ∀ j, ∃ Rr : IMRep U (m + 2), Rr.Represents (Rf j) := fun j => (hRS j).1
  choose Rr hRr using hRim
  have hbim : ∀ j, ∃ Rb : IMRep U (m + 1), Rb.Represents (Rf j).boundary := by
    intro j
    have h := himSub P (m + 1) U (T - Ts j) (Sf j) hU
      (himSub P (m + 1) U T (Ts j) hU hTim (hmin j).1) (hRS j).2.1
    rw [(hRS j).2.2] at h
    exact h
  choose Rb hRb using hbim
  have hTim' : ∀ j, ∃ RT : IMRep U (m + 1), RT.Represents (Ts j) := fun j => (hmin j).1
  choose RT hRT using hTim'
  -- Step 4: slicing `Rⱼ` by `f` (F7), with the representations `(μ_{Rⱼ}, ξ)` and `(μ_{∂Rⱼ}, ξ')`
  choose A B hA hB hAB hPm hPint using fun j => Submission.cmc_slice_mass_bounds P (m + 1) U
    (Rf j) (Rr j).measure (Rb j).measure (Rr j).orient (Rb j).orient f L hU
    (hfin (m + 2) (Rr j)) (hfin (m + 1) (Rb j))
    (Submission.lcmp_imRep_measure_restrict P (m + 2) U (Rr j)).2.1
    (Submission.lcmp_imRep_measure_restrict P (m + 1) U (Rb j)).2.1
    ((Submission.lcmp_imRep_measure_restrict P (m + 2) U (Rr j)).1.ae_le
      (himOrient P (m + 2) U (Rr j)))
    ((Submission.lcmp_imRep_measure_restrict P (m + 1) U (Rb j)).1.ae_le
      (himOrient P (m + 1) U (Rb j)))
    (fun ω => (hRr j ω).trans (hact _ (Rr j) ω)) (fun η => (hRb j η).trans (hact _ (Rb j) η))
    hfL
  -- Step 5: a good level `t ∈ (-1, 0)` (`α = -t`) and a subsequence `φ`
  have hsub01 : {x | -1 < f x ∧ f x < 0} ⊆ W₀ := fun x hx => hfW₀ x hx.2
  obtain ⟨t, ⟨ht1, ht0⟩, φ, hφ, hκ0, hDfin, hDlim⟩ := Submission.lcmp_exists_good_slice_level P
    (fun j => (Rr j).measure) (fun j => (RT j).measure) f (-1) 0 hfc.measurable (by norm_num)
    (fun j => (measure_mono (hsub01.trans subset_closure)).trans_lt
      (hfin _ (Rr j) _ hW₀cc.1 hW₀cc.2))
    (tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hlim (fun j => zero_le)
      fun j => calc (Rr j).measure {x | -1 < f x ∧ f x < 0}
          ≤ (Rr j).measure W₀ := measure_mono hsub01
        _ = (Rf j).massOn W₀ := (hmass _ _ _ (hRr j) W₀ hW₀o).symm
        _ ≤ (Rf j).massOn W₀ + (Sf j).massOn W₀ := le_self_add)
    (fun j => (measure_mono (hsub01.trans subset_closure)).trans_lt
      (hfin _ (RT j) _ hW₀cc.1 hW₀cc.2))
  -- `W = {f < t}`, the level set `C = {f = t}` and `F = {f ≤ t} = W ∪ C`
  set W : Set (Euclid P) := {x | f x < t}
  set C : Set (Euclid P) := {x | f x = t}
  set F : Set (Euclid P) := {x | f x ≤ t}
  have hWo : IsOpen W := isOpen_lt hfc continuous_const
  have hWW₀ : W ⊆ W₀ := fun x hx => hfW₀ x (lt_trans hx ht0)
  have hKW : K ⊆ W := fun x hx => by
    show f x < t
    rw [hfK x hx]
    exact ht1
  have hWcc : CompactlyContained W U :=
    ⟨hW₀cc.1.of_isClosed_subset isClosed_closure (closure_mono hWW₀),
      (closure_mono hWW₀).trans hW₀cc.2⟩
  have hFc : IsCompact F := hW₀cc.1.of_isClosed_subset (isClosed_le hfc continuous_const)
    fun x hx => subset_closure (hfW₀ x (lt_of_le_of_lt hx ht0))
  have hFU : F ⊆ U := fun x hx => hW₀U x (lt_of_le_of_lt hx ht0)
  have hCc : IsCompact C := hW₀cc.1.of_isClosed_subset (isClosed_eq hfc continuous_const)
    fun x hx => subset_closure (hfW₀ x (lt_of_eq_of_lt hx ht0))
  have hCW₀ : C ⊆ W₀ := fun x hx => hfW₀ x (lt_of_eq_of_lt hx ht0)
  have hCU : C ⊆ U := fun x hx => hW₀U x (lt_of_eq_of_lt hx ht0)
  have hCK : C ⊆ Kᶜ := fun x hx hxK => by
    have h1 : f x = t := hx
    rw [hfK x hxK] at h1
    linarith
  have hCW : C ∩ W = ∅ := by
    ext x
    simp only [mem_inter_iff, mem_empty_iff_false, iff_false, not_and]
    intro hx hxW
    have h1 : f x = t := hx
    have h2 : f x < t := hxW
    linarith
  have hWF : W ⊆ F := fun x (hx : f x < t) => show f x ≤ t from le_of_lt hx
  have hKF : K ⊆ F := hKW.trans hWF
  have hFWC : F ⊆ W ∪ C := fun x (hx : f x ≤ t) => (lt_or_eq_of_le hx).elim Or.inl Or.inr
  -- (F5): `Rᵢ⌞W` and `(∂Rᵢ)⌞W` are integer multiplicity, with weights `μ_{Rᵢ}⌞W`, `μ_{∂Rᵢ}⌞W`
  have hAim : ∀ i, ∃ RA : IMRep U (m + 2), RA.Represents (A i t) ∧
      RA.measure = (Rr i).measure.restrict W := by
    intro i
    obtain ⟨-, R', -, hcar, hmult, hor⟩ := himRestrict P (m + 2) U (Rr i) W hU hWo.measurableSet
    obtain ⟨hmeas, hRact⟩ := (Submission.lcmp_imRep_measure_restrict P (m + 2) U (Rr i)).2.2 W R'
      hWo.measurableSet hcar hmult hor
    exact ⟨R', fun ω => (hA i t ω).trans (hRact ω).symm, hmeas⟩
  choose RA hRA hRAm using hAim
  have hBim : ∀ i, ∃ RB : IMRep U (m + 1), RB.Represents (B i t) ∧
      RB.measure = (Rb i).measure.restrict W := by
    intro i
    obtain ⟨-, R', -, hcar, hmult, hor⟩ := himRestrict P (m + 1) U (Rb i) W hU hWo.measurableSet
    obtain ⟨hmeas, hRact⟩ := (Submission.lcmp_imRep_measure_restrict P (m + 1) U (Rb i)).2.2 W R'
      hWo.measurableSet hcar hmult hor
    exact ⟨R', fun η => (hB i t η).trans (hRact η).symm, hmeas⟩
  choose RB hRB hRBm using hBim
  -- `Pᵢ = ∂(Rᵢ⌞W) - (∂Rᵢ)⌞W` vanishes away from `C`; Step 4(a): `M(Pᵢ) ≤ M_{W₀}(Pᵢ) ≤ L Dᵢ`
  have hPvan : ∀ i (η : TestFormOn U (m + 1)),
      Disjoint (tsupport (η : DifferentialForm (Euclid P) (m + 1))) C →
        ((A i t).boundary - B i t) η = 0 := by
    intro i η hη
    show (A i t).boundary η - B i t η = 0
    rw [hAB i t η hη, sub_self]
  have hPbd : ∀ i (G : Set (Euclid P)), ((A i t).boundary - B i t).massOn G ≤
      (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ *
        (Rr i).measure {x | t - h < f x ∧ f x < t}) (𝓝[>] 0) := by
    intro i G
    refine (Submission.lcmp_massOn_le_of_vanish_off_compact P (m + 1) U W₀ C _ hCc hW₀o hCW₀
      (hPvan i) G).trans ((hPm i W₀ t hW₀o).trans ?_)
    exact mul_le_mul' le_rfl (liminf_le_liminf (Eventually.of_forall fun h =>
      mul_le_mul' le_rfl (measure_mono inter_subset_right)))
  have hPfin : ∀ i (G : Set (Euclid P)), ((A i t).boundary - B i t).massOn G < ∞ := fun i G =>
    (hPbd i G).trans_lt (ENNReal.mul_lt_top ENNReal.coe_lt_top (hDfin i))
  -- Step 4(b): `∂(Rᵢ⌞W) = (∂Rᵢ)⌞W + Pᵢ` has locally finite mass, so it is integer multiplicity (F8)
  have hdAim : ∀ i, IsIntegerMultiplicity (A i t).boundary := by
    intro i
    refine (Submission.cmc_closure_and_boundary_rectifiability).2 P (m + 1) U (A i t) hU
      ⟨RA i, hRA i⟩ fun G hGo hGcc => ?_
    have hBG : (B i t).massOn G < ∞ := by
      rw [hmass _ _ _ (hRB i) G hGo]
      exact (measure_mono subset_closure).trans_lt (hfin _ (RB i) _ hGcc.1 hGcc.2)
    calc (A i t).boundary.massOn G
        ≤ (B i t).massOn G + ((A i t).boundary - B i t).massOn G :=
          Submission.lcmp_massOn_le_add_of_eval_eq P (m + 1) U G (B i t)
            ((A i t).boundary - B i t) (A i t).boundary 1 (by norm_num) fun η _ => by
              show (A i t).boundary η = B i t η + 1 * ((A i t).boundary η - B i t η)
              ring
      _ < ∞ := ENNReal.add_lt_top.2 ⟨hBG, hPfin i G⟩
  -- Steps 6–9 for a competitor `S` and an index `i`
  have hmain : ∀ S : GeometricCurrentOn U (m + 1), IsIntegerMultiplicity S →
      S.boundary = T.boundary → (S - T).support ⊆ K → ∀ i, (Ts i).massOn W ≤
        S.massOn W + ((Sf i).massOn W + ((A i t).boundary - B i t).massOn univ) := by
    intro S hSim hSb hSK i
    -- `X = S - T` is integer multiplicity and vanishes away from `K` (F2)
    have hXim : IsIntegerMultiplicity (S - T) := himSub P (m + 1) U S T hU hSim hTim
    have hXvan : ∀ ω : TestFormOn U (m + 1),
        Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) K → (S - T) ω = 0 :=
      fun ω hω => Submission.dtc_vanish_off_support P (m + 1) U (S - T) ω (hω.mono_right hSK)
    -- the competitor `Z = Tᵢ + X + ∂(Rᵢ⌞W)`
    set Z : GeometricCurrentOn U (m + 1) := Ts i - ((T - S) - (A i t).boundary)
    have hZev : ∀ ω, Z ω = Ts i ω + (S ω - T ω) + (A i t).boundary ω := fun ω => by
      show Ts i ω - ((T ω - S ω) - (A i t).boundary ω) = _
      ring
    have hZim : IsIntegerMultiplicity Z := himSub P (m + 1) U (Ts i) _ hU (hmin i).1
      (himSub P (m + 1) U _ _ hU (himSub P (m + 1) U T S hU hTim hSim) (hdAim i))
    have hZb : Z.boundary = (Ts i).boundary := by
      apply GeometricCurrentOn.ext
      intro η
      have h1 : S.boundary η = T.boundary η := by rw [hSb]
      have h2 : (A i t).boundary.boundary η = 0 := by
        rw [GeometricCurrentOn.boundary_boundary]
        rfl
      have h3 : Z.boundary η = (Ts i).boundary η -
          ((T.boundary η - S.boundary η) - (A i t).boundary.boundary η) := rfl
      rw [h3, h1, h2]
      ring
    -- `Z - Tᵢ = X + ∂(Rᵢ⌞W)` vanishes away from `F`, so `spt(Z - Tᵢ) ⊆ F` is compact
    have hYvan : ∀ ω : TestFormOn U (m + 1),
        Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) F → (Z - Ts i) ω = 0 := by
      intro ω hω
      have h1 : S ω - T ω = 0 := hXvan ω (hω.mono_right hKF)
      have h2 : (A i t).boundary ω = 0 := by
        rw [GeometricCurrentOn.boundary_apply, hA i t]
        apply setIntegral_eq_zero_of_forall_eq_zero
        intro x hx
        have hxω : x ∉ tsupport (ω : DifferentialForm (Euclid P) (m + 1)) := fun h =>
          Set.disjoint_left.mp hω h (hWF hx)
        have h0 : exteriorDerivative (ω : DifferentialForm (Euclid P) (m + 1)) x = 0 :=
          image_eq_zero_of_notMem_tsupport fun h => hxω (tsupport_exteriorDerivative_subset _ h)
        show (Rr i).orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) (m + 1)) x) = 0
        rw [h0, map_zero]
      show Z ω - Ts i ω = 0
      rw [hZev, h1, h2]
      ring
    obtain ⟨hYF, hYc⟩ := Submission.rsd_cmr_support_subset_of_vanish P (m + 1) U F (Z - Ts i) hU
      hFc hFU hYvan
    -- Step 7: minimality of `Tᵢ` on every open `G ⊇ F` with `G ⊂⊂ U`
    have hminG : ∀ G : Set (Euclid P), IsOpen G → F ⊆ G → CompactlyContained G U →
        (Ts i).massOn G ≤ Z.massOn G := fun G hGo hFG hGcc =>
      (hmin i).2 G Z hGo hGcc hZim hZb hYc fun x hx => ⟨hFU (hYF hx), hFG (hYF hx)⟩
    obtain ⟨RZ, hRZ⟩ := hZim
    obtain ⟨RX, hRX⟩ := hXim
    -- Step 8: `μ_{Tᵢ}(F) ≤ μ_Z(F)` (`γ ↑ α`)
    have hTF : (RT i).measure F ≤ RZ.measure F := by
      have h := Submission.lcmp_measure_le_add_of_open_nhds P U F (RT i).measure RZ.measure 0 hU
        hFc hFU (hfin _ RZ) fun G hGo hFG hGcc => by
          rw [add_zero, ← hmass _ _ _ (hRT i) G hGo, ← hmass _ _ _ hRZ G hGo]
          exact hminG G hGo hFG hGcc
      rwa [add_zero] at h
    -- Step 8: `μ_Z(C) ≤ μ_{Tᵢ}(C) + μ_X(C) + μ_{(∂Rᵢ)⌞W}(C) + M(Pᵢ) = M(Pᵢ)`
    have hZC : RZ.measure C ≤ ((A i t).boundary - B i t).massOn univ := by
      have key := Submission.lcmp_measure_le_add_of_open_nhds P U C RZ.measure
        ((RT i).measure + RX.measure + (RB i).measure) (((A i t).boundary - B i t).massOn univ)
        hU hCc hCU (fun K' hK' hK'U => by
          simp only [Measure.coe_add, Pi.add_apply]
          exact ENNReal.add_lt_top.2 ⟨ENNReal.add_lt_top.2 ⟨hfin _ _ K' hK' hK'U,
            hfin _ _ K' hK' hK'U⟩, hfin _ _ K' hK' hK'U⟩) fun G hGo _ _ => by
          simp only [Measure.coe_add, Pi.add_apply]
          rw [← hmass _ _ _ hRZ G hGo, ← hmass _ _ _ (hRT i) G hGo, ← hmass _ _ _ hRX G hGo,
            ← hmass _ _ _ (hRB i) G hGo]
          have e1 := Submission.lcmp_massOn_le_add_of_eval_eq P (m + 1) U G (Ts i) (Z - Ts i) Z 1
            (by norm_num) fun ω _ => by
              show Z ω = Ts i ω + 1 * (Z ω - Ts i ω)
              ring
          have e2 := Submission.lcmp_massOn_le_add_of_eval_eq P (m + 1) U G (S - T)
            (A i t).boundary (Z - Ts i) 1 (by norm_num) fun ω _ => by
              show Z ω - Ts i ω = (S ω - T ω) + 1 * (A i t).boundary ω
              rw [hZev]
              ring
          have e3 := Submission.lcmp_massOn_le_add_of_eval_eq P (m + 1) U G (B i t)
            ((A i t).boundary - B i t) (A i t).boundary 1 (by norm_num) fun ω _ => by
              show (A i t).boundary ω = B i t ω + 1 * ((A i t).boundary ω - B i t ω)
              ring
          have e4 := ((A i t).boundary - B i t).massOn_mono (subset_univ G)
          calc Z.massOn G ≤ (Ts i).massOn G + (Z - Ts i).massOn G := e1
            _ ≤ (Ts i).massOn G + ((S - T).massOn G + ((B i t).massOn G +
                ((A i t).boundary - B i t).massOn univ)) :=
              add_le_add le_rfl (e2.trans (add_le_add le_rfl (e3.trans (add_le_add le_rfl e4))))
            _ = (Ts i).massOn G + (S - T).massOn G + (B i t).massOn G +
                ((A i t).boundary - B i t).massOn univ := by ring
      -- `μ_{Tᵢ}(C) = 0` by the choice of `t`
      have hTC : (RT i).measure C = 0 := hκ0 i
      -- `μ_X(C) ≤ μ_X(ℝᴾ \ K) = M_{ℝᴾ \ K}(X) = 0`
      have hXC : RX.measure C = 0 := by
        refine le_antisymm ?_ zero_le
        calc RX.measure C ≤ RX.measure Kᶜ := measure_mono hCK
          _ = (S - T).massOn Kᶜ := (hmass _ _ _ hRX Kᶜ hK.isClosed.isOpen_compl).symm
          _ ≤ 0 := by
            apply sSup_le
            rintro _ ⟨ω, hω, rfl⟩
            show ENNReal.ofReal ((S - T) ω) ≤ 0
            rw [hXvan ω (Set.subset_compl_iff_disjoint_right.mp hω.1), ENNReal.ofReal_zero]
      -- `μ_{(∂Rᵢ)⌞W}(C) = μ_{∂Rᵢ}(C ∩ W) = 0`
      have hBC : (RB i).measure C = 0 := by
        rw [hRBm i, Measure.restrict_apply hCc.isClosed.measurableSet, hCW, measure_empty]
      simp only [Measure.coe_add, Pi.add_apply, hTC, hXC, hBC, zero_add] at key
      exact key
    -- (10): `M_W(Tᵢ) ≤ M_W(Z) + M(Pᵢ)`
    have h10 : (Ts i).massOn W ≤ Z.massOn W + ((A i t).boundary - B i t).massOn univ := by
      rw [hmass _ _ _ (hRT i) W hWo, hmass _ _ _ hRZ W hWo]
      calc (RT i).measure W ≤ (RT i).measure F := measure_mono hWF
        _ ≤ RZ.measure F := hTF
        _ ≤ RZ.measure (W ∪ C) := measure_mono hFWC
        _ ≤ RZ.measure W + RZ.measure C := measure_union_le W C
        _ ≤ RZ.measure W + ((A i t).boundary - B i t).massOn univ := add_le_add le_rfl hZC
    -- (11): on `W`, `∂(Rᵢ⌞W) = ∂Rᵢ = T - Tᵢ - Sᵢ`, so `Z = S - Sᵢ` and `M_W(Z) ≤ M_W(S) + M_W(Sᵢ)`
    have h11 : Z.massOn W ≤ S.massOn W + (Sf i).massOn W := by
      apply Submission.lcmp_massOn_le_add_of_eval_eq P (m + 1) U W S (Sf i) Z (-1) (by norm_num)
      intro ω hω
      have h1 : (A i t).boundary ω = (Rf i).boundary ω := by
        rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.boundary_apply, hA i t, hRr i,
          hact]
        apply setIntegral_eq_integral_of_forall_compl_eq_zero
        intro x hx
        have h0 : exteriorDerivative (ω : DifferentialForm (Euclid P) (m + 1)) x = 0 :=
          image_eq_zero_of_notMem_tsupport fun h => hx (hω (tsupport_exteriorDerivative_subset _ h))
        show (Rr i).orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) (m + 1)) x) = 0
        rw [h0, map_zero]
      have h2 : (Rf i).boundary ω = T ω - Ts i ω - Sf i ω := by
        rw [← (hRS i).2.2]
        rfl
      rw [hZev, h1, h2]
      ring
    calc (Ts i).massOn W ≤ Z.massOn W + ((A i t).boundary - B i t).massOn univ := h10
      _ ≤ S.massOn W + (Sf i).massOn W + ((A i t).boundary - B i t).massOn univ :=
        add_le_add h11 le_rfl
      _ = S.massOn W + ((Sf i).massOn W + ((A i t).boundary - B i t).massOn univ) :=
        add_assoc _ _ _
  refine ⟨W, hWo, hKW, hWW₀.trans hW₀th, hWcc, φ,
    fun j => (Sf (φ j)).massOn W + ((A (φ j) t).boundary - B (φ j) t).massOn univ, hφ, ?_,
    fun S hSim hSb hSK j => hmain S hSim hSb hSK (φ j)⟩
  -- `eⱼ ≤ (M_{W₀}(R_{φ(j)}) + M_{W₀}(S_{φ(j)})) + L D_{φ(j)} → 0`
  have h1 : Tendsto (fun j => (Rf (φ j)).massOn W₀ + (Sf (φ j)).massOn W₀) atTop (𝓝 0) :=
    hlim.comp hφ.tendsto_atTop
  have h2 : Tendsto (fun j => (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ *
      (Rr (φ j)).measure {x | t - h < f x ∧ f x < t}) (𝓝[>] 0)) atTop (𝓝 0) := by
    simpa only [mul_zero] using
      ENNReal.Tendsto.const_mul (a := (L : ℝ≥0∞)) hDlim (Or.inr ENNReal.coe_ne_top)
  have h3 := h1.add h2
  rw [add_zero] at h3
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds h3 (fun j => zero_le)
    fun j => add_le_add (((Sf (φ j)).massOn_mono hWW₀).trans le_add_self) (hPbd (φ j) univ)

/-- **Simon 7.2.4** (compactness of minimizing currents, with Remark 7.2.5(1)).  For `n = 0` the
`Tⱼ` vanish, hence so does `T`, and every representation of `0` has zero measure.  For `n ≥ 1`,
`T` is integer multiplicity by the closure theorem (Ch. 6, 3.11).  For a competitor `S`, the local
comparison inequality (Simon (1)–(11)) on a neighbourhood `W₀` of `K = spt (S − T)` and lower
semicontinuity of mass give `M_{W₀}(T) ≤ M_{W₀}(S)`, which extends to `W ⊇ W₀`.  With `S = T`
it gives `limsup μ_{Tⱼ}(K) ≤ μ_T({dist(·, K) < ε})` along a subsequence of any subsequence, hence
(13) for the whole sequence as `ε ↓ 0`; lower semicontinuity gives (14), and (13), (14) give
`∫ f dμ_{Tⱼ} → ∫ f dμ_T`. -/
theorem Submission.compactness_of_minimizing_currents : CompactnessOfMinimizingCurrents := by
  intro n
  cases n with
  | zero =>
    intro k U Ts T hU hmin _ hconv
    -- minimizing `0`-currents vanish, hence so does their weak limit
    have hTs : ∀ j, Ts j = 0 := fun j =>
      Submission.cmc_zeroDim_minimizing_eq_zero _ U (Ts j) hU (hmin j)
    have hT : T = 0 := by
      ext ω
      have h := hconv ω
      simp only [hTs, GeometricCurrentOn.zero_apply] at h
      exact tendsto_nhds_unique h tendsto_const_nhds
    -- every representation of the zero current has zero measure (`M(0) = μ_R(ℝᴾ)`)
    have hrep : ∀ (S : GeometricCurrentOn U 0) (R : IMRep U 0), S = 0 → R.Represents S →
        R.measure = 0 := by
      intro S R hS hR
      have hm : S.massOn univ = 0 := by
        subst hS
        refine le_antisymm (sSup_le ?_) zero_le
        rintro r ⟨ω, -, rfl⟩
        simp
      rw [← Measure.measure_univ_eq_zero,
        ← Submission.cmc_massOn_eq_imRep_measure _ _ U S R hU hR univ isOpen_univ, hm]
    refine ⟨?_, ?_⟩
    · rw [show T = Ts 0 from hT.trans (hTs 0).symm]
      exact hmin 0
    · intro Rs hRs R hR f _ _ _
      have hRs0 : ∀ j, (Rs j).measure = 0 := fun j => hrep (Ts j) (Rs j) (hTs j) (hRs j)
      simp only [hRs0, hrep T R hT hR, integral_zero_measure]
      exact tendsto_const_nhds
  | succ m =>
    intro k U Ts T hU hmin hbd hconv
    -- in positive degree `boundaryMassOn` is the mass of the boundary
    have hbd' : ∀ W : Set (Euclid (m + 1 + k)), IsOpen W → CompactlyContained W U →
        ⨆ j, ((Ts j).massOn W + (Ts j).boundary.massOn W) < ∞ := hbd
    -- `T` is integer multiplicity (Remark 7.2.5(1), Ch. 6, 3.11)
    have hTIM : IsIntegerMultiplicity T :=
      Submission.cmc_closure_and_boundary_rectifiability.1 _ _ U Ts T hU (fun j => (hmin j).1)
        hbd hconv
    -- subsequences satisfy the hypotheses of the theorem
    have hsub : ∀ ψ : ℕ → ℕ, StrictMono ψ →
        (∀ j, IsMinimizingIn (Ts (ψ j)) U) ∧
        (∀ W : Set (Euclid (m + 1 + k)), IsOpen W → CompactlyContained W U →
          ⨆ j, ((Ts (ψ j)).massOn W + (Ts (ψ j)).boundary.massOn W) < ∞) ∧
        WeaklyConvergesOn (fun j => Ts (ψ j)) T := by
      intro ψ hψ
      refine ⟨fun j => hmin (ψ j), fun W hW hWU => lt_of_le_of_lt ?_ (hbd' W hW hWU),
        fun ω => (hconv ω).comp hψ.tendsto_atTop⟩
      exact iSup_le fun j => le_iSup (fun i => (Ts i).massOn W + (Ts i).boundary.massOn W) (ψ j)
    -- `a + e j → a` when `e j → 0`
    have hadd : ∀ (a : ℝ≥0∞) (e : ℕ → ℝ≥0∞), Tendsto e atTop (𝓝 0) →
        Tendsto (fun j => a + e j) atTop (𝓝 a) := fun a e he => by
      simpa using (tendsto_const_nhds (x := a)).add he
    -- `T` is minimizing in `U` (Simon (8))
    have hTmin : IsMinimizingIn T U := by
      refine ⟨hTIM, fun W S hW hWU hSIM hSB hKc hKWU => ?_⟩
      have hKU : (S - T).support ⊆ U := fun x hx => (hKWU hx).1
      have hKW : (S - T).support ⊆ W := fun x hx => (hKWU hx).2
      obtain ⟨ε, hε, hεW⟩ := hKc.exists_thickening_subset_open hW hKW
      obtain ⟨W₀, hW₀, hKW₀, hW₀ε, -, φ, e, hφ, he, hcmp⟩ :=
        Submission.cmc_local_comparison_inequality _ _ U Ts T hU hmin hbd' hconv hTIM
          (S - T).support ε hKc hKU hε
      -- lower semicontinuity of mass along `T_{φ j} ⇀ T`
      have hW₀le : T.massOn W₀ ≤ S.massOn W₀ :=
        calc T.massOn W₀ ≤ liminf (fun j => (Ts (φ j)).massOn W₀) atTop :=
              (hsub φ hφ).2.2.massOn_le_liminf W₀
          _ ≤ liminf (fun j => S.massOn W₀ + e j) atTop :=
              liminf_le_liminf (Eventually.of_forall fun j => hcmp S hSIM hSB subset_rfl j)
          _ = S.massOn W₀ := (hadd _ e he).liminf_eq
      exact Submission.cmc_massOn_le_of_le_near_support _ _ U S T (S - T).support W₀ W hU hSIM
        hTIM hKc subset_rfl hW₀ hW hKW₀ (hW₀ε.trans hεW) hWU hW₀le
    refine ⟨hTmin, ?_⟩
    -- `μ_{Tⱼ} → μ_T` as Radon measures in `U`
    intro Rs hRs R hR f hf hfc hfU
    -- masses on open sets are the representation measures (Ch. 6, 3.2(3))
    have hRsW : ∀ j W, IsOpen W → (Rs j).measure W = (Ts j).massOn W := fun j W hW =>
      (Submission.cmc_massOn_eq_imRep_measure _ _ U (Ts j) (Rs j) hU (hRs j) W hW).symm
    have hRW : ∀ W, IsOpen W → R.measure W = T.massOn W := fun W hW =>
      (Submission.cmc_massOn_eq_imRep_measure _ _ U T R hU hR W hW).symm
    -- `μ_T` is finite on compact subsets of `U`
    have hfin : ∀ K : Set (Euclid (m + 1 + k)), IsCompact K → K ⊆ U → R.measure K < ∞ := by
      intro K hK hKU
      rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
        Measure.restrict_restrict hK.measurableSet, Set.inter_comm]
      exact lt_top_iff_ne_top.mpr (R.locallyIntegrable_mult K hK hKU)
    refine Submission.cmc_tendsto_integral_of_limsup_liminf _ U (fun j => (Rs j).measure)
      R.measure hfin ?_ ?_ f hf hfc hfU
    · -- (13): `limsup_j μ_{Tⱼ}(K) ≤ μ_T(K)`
      intro K hK hKU
      -- `spt (T − T) = ∅`
      have hTT : (T - T).support ⊆ K := by
        rintro x ⟨hxU, hxZ⟩
        exfalso
        apply hxZ
        obtain ⟨r, hr, hrU⟩ := Metric.isOpen_iff.mp hU x hxU
        refine Set.mem_sUnion.mpr ⟨ball x (r / 2), ⟨isOpen_ball, isBounded_ball.isCompact_closure,
          closure_ball_subset_closedBall.trans ((closedBall_subset_ball (half_lt_self hr)).trans
            hrU), fun ω _ => sub_self (T ω)⟩, mem_ball_self (half_pos hr)⟩
      -- along a subsequence of any subsequence, `limsup ≤ μ_T({dist(·, K) < ε})`
      have hεK : ∀ ε : ℝ, 0 < ε →
          limsup (fun j => (Rs j).measure K) atTop ≤ R.measure (thickening ε K) := by
        intro ε hε
        by_contra hlt
        obtain ⟨c, hc₁, hc₂⟩ := exists_between (not_le.mp hlt)
        obtain ⟨ψ, hψ, hψc⟩ :=
          extraction_of_frequently_atTop (frequently_lt_of_lt_limsup (h := hc₂))
        obtain ⟨hminψ, hbdψ, hconvψ⟩ := hsub ψ hψ
        obtain ⟨W₀, hW₀, hKW₀, hW₀ε, -, φ, e, -, he, hcmp⟩ :=
          Submission.cmc_local_comparison_inequality _ _ U (fun j => Ts (ψ j)) T hU hminψ hbdψ
            hconvψ hTIM K ε hK hKU hε
        have hj : ∀ j, (Rs (ψ (φ j))).measure K ≤ R.measure (thickening ε K) + e j := fun j =>
          calc (Rs (ψ (φ j))).measure K ≤ (Rs (ψ (φ j))).measure W₀ := measure_mono hKW₀
            _ = (Ts (ψ (φ j))).massOn W₀ := hRsW _ W₀ hW₀
            _ ≤ T.massOn W₀ + e j := hcmp T hTIM rfl hTT j
            _ = R.measure W₀ + e j := by rw [hRW W₀ hW₀]
            _ ≤ R.measure (thickening ε K) + e j := add_le_add (measure_mono hW₀ε) le_rfl
        have hc : c ≤ R.measure (thickening ε K) :=
          calc c ≤ limsup (fun j => (Rs (ψ (φ j))).measure K) atTop :=
                le_limsup_of_frequently_le (Frequently.of_forall fun j => (hψc (φ j)).le)
            _ ≤ limsup (fun j => R.measure (thickening ε K) + e j) atTop :=
                limsup_le_limsup (Eventually.of_forall hj)
            _ = R.measure (thickening ε K) := (hadd _ e he).limsup_eq
        exact absurd hc (not_le.mpr hc₁)
      -- let `ε ↓ 0`; some thickening of `K` has compact closure in `U`
      have hthick : ∃ δ > 0, R.measure (thickening δ K) ≠ ∞ := by
        obtain ⟨δ, hδ, hδU⟩ := hK.exists_cthickening_subset_open hU hKU
        exact ⟨δ, hδ, ne_top_of_le_ne_top (hfin _ hK.cthickening hδU).ne
          (measure_mono (thickening_subset_cthickening δ K))⟩
      exact ge_of_tendsto (tendsto_measure_thickening_of_isClosed hthick hK.isClosed)
        (eventually_nhdsWithin_of_forall hεK)
    · -- (14): `μ_T(G) ≤ liminf_j μ_{Tⱼ}(G)` for open `G ⊆ U`
      intro G hG _
      calc R.measure G = T.massOn G := hRW G hG
        _ ≤ liminf (fun j => (Ts j).massOn G) atTop := hconv.massOn_le_liminf G
        _ = liminf (fun j => (Rs j).measure G) atTop := by
          congr 1
          funext j
          exact (hRsW j G hG).symm
/-- **De Giorgi's structure theorem**, Gauss–Green form (Simon Ch. 3, 4.1–4.3).  Let `m ≥ 1`,
`D ⊆ ℝ^{m+1}` open and `F` Borel with locally finite perimeter in `D`.  Then there are a
countably `m`-rectifiable Borel set `B ⊆ D`, with `Hᵐ(B ∩ K) < ∞` for compact `K ⊆ D`, and a
Borel `ν`, with `|ν| = 1` on `B` and approximate tangent space `ν(y)^⊥` at `Hᵐ`-a.e. `y ∈ B`,
such that `∫_F div φ = −∫_B ⟨φ, ν⟩ dHᵐ` for `φ ∈ C¹_c(D; ℝ^{m+1})`.  The Riesz representation
of the perimeter functional gives a Gauss–Green pair `(μ, ν)` (4.1).  At `μ`-a.e. `y` the
blow-ups of `μ` converge to `Hᵐ⌞ν(y)^⊥` (4.3 (†)).  Since countably `m`-rectifiable sets of finite
measure have `Hᵐ`-density one a.e., this gives `μ = Hᵐ⌞B`, with approximate tangent planes
`ν^⊥`, and then (4.1) is the Gauss–Green formula over `B`. -/
theorem Submission.codim1_rdo_de_giorgi_gauss_green : ∀ (m : ℕ) (D F : Set (Euclid (m + 1))), 1 ≤ m → IsOpen D → MeasurableSet F → (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → ∃ C : ℝ, ∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ → tsupport φ ⊆ K → (∀ y, ‖φ y‖ ≤ 1) → ∫ y in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ y : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) ≤ C) → ∃ (B : Set (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)), MeasurableSet B ∧ B ⊆ D ∧ CountablyRectifiable m B ∧ (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μHE[m] (B ∩ K) ≠ ∞) ∧ Measurable ν ∧ (∀ y ∈ B, ‖ν y‖ = 1) ∧ (∀ᵐ y ∂(μHE[m].restrict B), HasApproximateTangentSpaceAt m B y (Submodule.span ℝ {ν y})ᗮ) ∧ ∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ y in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ y : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -∫ y in B, inner ℝ (φ y) (ν y) ∂μHE[m] := by
  intro m D F hm hD hF hper
  -- Steps 1–2: the Gauss–Green pair `(μ, ν)` of (4.1), `|ν| ≡ 1`
  obtain ⟨μ, ν, hμD, hμK, hν, hν1, hGG⟩ :=
    Submission.codim1_rdo_dg_gauss_green_measure m D F hD hF hper
  -- Steps 3–4: at `μ`-a.e. `y` the blow-ups of `μ` converge to `Hᵐ⌞ν(y)^⊥` (4.3 (†))
  have htan :=
    Submission.codim1_rdo_dg_tangent_measure_ae m D F μ ν hm hD hF hμD hμK hν hν1 hGG
  -- Steps 5–8: `μ = Hᵐ⌞B`, using `Hᵐ`-density one of rectifiable sets (`P = m + 1`, `n = m`)
  obtain ⟨B, hB, hBD, hBrect, rfl, hBtan⟩ :=
    Submission.codim1_rdo_dg_measure_eq_hausdorff m D μ ν hm hD hμD hμK hν hν1 htan
      fun S hS hSrect hSfin =>
        Submission.codim1_rdo_rectifiable_ae_density_one (m + 1) m S hm hS hSrect hSfin
  -- Step 9: `Hᵐ(B ∩ K) = μ(K) < ∞`, and (4.1) for `μ = Hᵐ⌞B` is the Gauss–Green formula
  refine ⟨B, ν, hB, hBD, hBrect, fun K hK hKD => ?_, hν, fun y _ => hν1 y, hBtan, hGG⟩
  rw [inter_comm, ← Measure.restrict_apply' hB]
  exact hμK K hK hKD

/-- **De Giorgi's structure theorem** for a set of finite perimeter in `ℝⁿ⁺¹` (Simon Ch. 3,
4.1–4.3, with `U = ℝⁿ⁺¹`).  The Gauss–Green pair `(μ, ν)` of (4.1) comes from
`codim1_rdo_dg_gauss_green_measure` with `D = ℝⁿ⁺¹`.  At `μ`-a.e. `y` the normal averages tend to
`ν(y)` (4.2), so `½ μ(B̄_r(y)) ≤ ∫_{B̄_r(y)} ⟨ν, ν(y)⟩ dμ` for small `r`; a Besicovitch covering by
disjoint such balls, tested against `φ = ∑ ζ_x ν(x)` with disjoint smooth bumps `ζ_x`, gives
`μ(ℝⁿ⁺¹) ≤ 2 (C + 1)`.  The blow-ups of `μ` are flat (4.3 (†)), so `μ = Hⁿ⌞B` for a Borel countably
`n`-rectifiable `B` with approximate tangent planes `ν^⊥` (`codim1_rdo_dg_measure_eq_hausdorff`,
with (RD) from `codim1_rdo_rectifiable_ae_density_one`), and the blow-ups of `E` converge to the
half-space `{⟨w, ν(y)⟩ > 0}` (4.3 (‡)). -/
theorem Submission.dtc_bc_lc_fd_bim_de_giorgi : ∀ (n : ℕ) (E : Set (Euclid (n + 1))) (C : ℝ), 1 ≤ n → MeasurableSet E → (∀ φ : Euclid (n + 1) → Euclid (n + 1), ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ → (∀ y, ‖φ y‖ ≤ 1) → ∫ y in E, LinearMap.trace ℝ (Euclid (n + 1)) (fderiv ℝ φ y : Euclid (n + 1) →ₗ[ℝ] Euclid (n + 1)) ≤ C) → ∃ (B : Set (Euclid (n + 1))) (ν : Euclid (n + 1) → Euclid (n + 1)), MeasurableSet B ∧ CountablyRectifiable n B ∧ μHE[n] B ≠ ∞ ∧ Measurable ν ∧ (∀ y ∈ B, ‖ν y‖ = 1) ∧ (∀ᵐ y ∂(μHE[n].restrict B), HasApproximateTangentSpaceAt n B y (Submodule.span ℝ {ν y})ᗮ) ∧ (∀ φ : Euclid (n + 1) → Euclid (n + 1), ContDiff ℝ 1 φ → HasCompactSupport φ → ∫ y in E, LinearMap.trace ℝ (Euclid (n + 1)) (fderiv ℝ φ y : Euclid (n + 1) →ₗ[ℝ] Euclid (n + 1)) = -∫ y in B, inner ℝ (φ y) (ν y) ∂μHE[n]) ∧ ∀ᵐ y ∂(μHE[n].restrict B), ∀ ρ : ℝ, Tendsto (fun r : ℝ => volume (symmDiff ((fun w => y + r • w) ⁻¹' E) {w | 0 < inner ℝ w (ν y)} ∩ ball (0 : Euclid (n + 1)) ρ)) (𝓝[>] 0) (𝓝 0) := by
  intro n E C hn hE hper
  -- Step 1 (Simon Ch. 3, 4.1): the Gauss–Green measure `μ` and Borel unit normal `ν`, `D = ℝⁿ⁺¹`
  obtain ⟨μ, ν, hμD, hμK, hν, hν1, hGG⟩ :=
    Submission.codim1_rdo_dg_gauss_green_measure n univ E isOpen_univ hE
      fun K _ _ => ⟨C, fun φ h1 h2 _ h4 => hper φ h1 h2 h4⟩
  have hμK' : ∀ K : Set (Euclid (n + 1)), IsCompact K → μ K ≠ ∞ := fun K hK =>
    hμK K hK (subset_univ K)
  -- Step 2(a): the perimeter bound in dual form, `∫ ⟨φ, ν⟩ dμ ≤ C`
  have hdual : ∀ φ : Euclid (n + 1) → Euclid (n + 1), ContDiff ℝ (⊤ : ℕ∞) φ →
      HasCompactSupport φ → (∀ y, ‖φ y‖ ≤ 1) → ∫ y, inner ℝ (φ y) (ν y) ∂μ ≤ C := by
    intro φ hφ hφc hφ1
    have h1 := hper (-φ) hφ.neg hφc.neg fun y => by rw [Pi.neg_apply, norm_neg]; exact hφ1 y
    rw [hGG (-φ) (hφ.neg.of_le (by exact_mod_cast le_top)) hφc.neg (subset_univ _)] at h1
    simpa only [Pi.neg_apply, inner_neg_left, integral_neg, neg_neg] using h1
  -- Step 3 (Simon Ch. 3, 4.2): at `μ`-a.e. `y` the normal averages tend to `ν(y)`, so
  -- `½ μ(B̄_r(y)) ≤ ∫_{B̄_r(y)} ⟨ν, ν(y)⟩ dμ` for small `r`
  have hnormal := Submission.codim1_rdo_dg_normal_average_ae n univ μ ν isOpen_univ hμD hμK hν hν1
  set s : Set (Euclid (n + 1)) := {y | ∃ ρ₂ : ℝ, 0 < ρ₂ ∧ ∀ r : ℝ, 0 < r → r < ρ₂ →
    (1 / 2 : ℝ) * (μ (closedBall y r)).toReal ≤ ∫ z in closedBall y r, inner ℝ (ν z) (ν y) ∂μ}
    with hsdef
  have hs : μ sᶜ = 0 := by
    have h : ∀ᵐ y ∂μ, y ∈ s := by
      filter_upwards [hnormal] with y hy
      obtain ⟨ρ₂, hρ₂, -, hlow⟩ :=
        Submission.codim1_rdo_dg_ce_normal_average_lower (n + 1) μ ν y (ν y) 1 one_pos
          (hμK' _ (isCompact_closedBall _ _)) hν (fun z => (hν1 z).le) (hν1 y) hy.2
      exact ⟨ρ₂, hρ₂, hlow⟩
    exact mem_ae_iff.1 h
  -- Step 2(b): a Besicovitch covering of `s` by disjoint closed balls carrying the lower bound
  have : IsFiniteMeasureOnCompacts μ := ⟨fun K hK => (hμK' K hK).lt_top⟩
  obtain ⟨t, r, htc, hts, htr, htcov, htdisj⟩ :=
    Besicovitch.exists_disjoint_closedBall_covering_ae μ
      (fun y => {ρ : ℝ | (1 / 2 : ℝ) * (μ (closedBall y ρ)).toReal ≤
        ∫ z in closedBall y ρ, inner ℝ (ν z) (ν y) ∂μ}) s
      (fun y hy δ hδ => by
        obtain ⟨ρ₂, hρ₂, hlow⟩ := hy
        have h0 : 0 < min ρ₂ δ / 2 := by positivity
        have h1 : min ρ₂ δ / 2 < min ρ₂ δ := half_lt_self (lt_min hρ₂ hδ)
        exact ⟨min ρ₂ δ / 2, hlow _ h0 (h1.trans_le (min_le_left _ _)), h0,
          h1.trans_le (min_le_right _ _)⟩)
      (fun _ => 1) fun _ _ => one_pos
  -- disjoint closed balls have separated centres
  have hsep : ∀ (a b : Euclid (n + 1)) (ra rb : ℝ), 0 < ra → 0 < rb →
      Disjoint (closedBall a ra) (closedBall b rb) → ra + rb < dist a b := by
    intro a b ra rb ha hb hd
    by_contra hle
    push Not at hle
    have hab : ra + rb ≠ 0 := (add_pos ha hb).ne'
    refine hd.ne_of_mem (a := a + (ra / (ra + rb)) • (b - a))
      (b := a + (ra / (ra + rb)) • (b - a)) ?_ ?_ rfl
    · rw [mem_closedBall, dist_eq_norm, add_sub_cancel_left, norm_smul,
        Real.norm_of_nonneg (by positivity), ← dist_eq_norm, dist_comm]
      calc ra / (ra + rb) * dist a b ≤ ra / (ra + rb) * (ra + rb) :=
            mul_le_mul_of_nonneg_left hle (by positivity)
        _ = ra := div_mul_cancel₀ ra hab
    · have h1 : a + (ra / (ra + rb)) • (b - a) - b = (rb / (ra + rb)) • (a - b) := by
        have h2 : rb / (ra + rb) = 1 - ra / (ra + rb) := by
          rw [eq_sub_iff_add_eq, ← add_div, add_comm rb ra, div_self hab]
        rw [h2, sub_smul, one_smul, smul_sub, smul_sub]
        abel
      rw [mem_closedBall, dist_eq_norm, h1, norm_smul, Real.norm_of_nonneg (by positivity),
        ← dist_eq_norm]
      calc rb / (ra + rb) * dist a b ≤ rb / (ra + rb) * (ra + rb) :=
            mul_le_mul_of_nonneg_left hle (by positivity)
        _ = rb := div_mul_cancel₀ rb hab
  -- Step 2(c): finitely many of the balls carry total mass at most `2 (C + 1)`
  have hkey : ∀ t' : Finset (Euclid (n + 1)), (t' : Set (Euclid (n + 1))) ⊆ t →
      ∑ x ∈ t', (μ (closedBall x (r x))).toReal ≤ 2 * (C + 1) := by
    intro t' ht'
    have hε : (0 : ℝ) < 1 / (t'.card + 1) := by positivity
    -- `δ > 0` such that the enlarged balls stay disjoint and gain mass `< 1 / (#t' + 1)`
    have hev1 : ∀ x ∈ t', ∀ᶠ δ in 𝓝[>] (0 : ℝ),
        μ (ball x (r x + δ) \ closedBall x (r x)) < ENNReal.ofReal (1 / (t'.card + 1)) := by
      intro x _
      have hlim : Tendsto (μ ∘ fun δ : ℝ => ball x (r x + δ) \ closedBall x (r x)) (𝓝[>] 0)
          (𝓝 (μ (⋂ δ > (0 : ℝ), ball x (r x + δ) \ closedBall x (r x)))) :=
        tendsto_measure_biInter_gt
          (fun δ _ => (measurableSet_ball.diff measurableSet_closedBall).nullMeasurableSet)
          (fun i j _ hij => sdiff_subset_sdiff_left (ball_subset_ball (by linarith)))
          ⟨1, one_pos, ne_top_of_le_ne_top (hμK' _ (isCompact_closedBall x (r x + 1)))
            (measure_mono (sdiff_subset.trans ball_subset_closedBall))⟩
      have hempty : (⋂ δ > (0 : ℝ), ball x (r x + δ) \ closedBall x (r x)) = ∅ := by
        refine eq_empty_of_forall_notMem fun z hz => ?_
        simp only [mem_iInter, Set.mem_sdiff, mem_ball, mem_closedBall] at hz
        exact (hz 1 one_pos).2 (le_of_forall_pos_lt_add fun δ hδ => (hz δ hδ).1)
      rw [hempty, measure_empty] at hlim
      exact hlim.eventually (gt_mem_nhds (ENNReal.ofReal_pos.2 hε))
    have hev2 : ∀ x ∈ t', ∀ x' ∈ t', ∀ᶠ δ in 𝓝[>] (0 : ℝ),
        x ≠ x' → Disjoint (ball x (r x + δ)) (ball x' (r x' + δ)) := by
      intro x hx x' hx'
      by_cases hxx : x = x'
      · exact Eventually.of_forall fun _ h => absurd hxx h
      · have hd := hsep x x' (r x) (r x') (htr x (ht' hx)).2.1 (htr x' (ht' hx')).2.1
          (htdisj (ht' hx) (ht' hx') hxx)
        filter_upwards [Ioo_mem_nhdsGT (by linarith : (0 : ℝ) < (dist x x' - r x - r x') / 2)]
          with δ hδ _
        exact ball_disjoint_ball (by linarith [hδ.2])
    obtain ⟨δ, ⟨hδ1, hδ2⟩, hδ0⟩ := ((((eventually_all_finset t').2 hev1).and
      ((eventually_all_finset t').2 fun x hx => (eventually_all_finset t').2 (hev2 x hx))).and
        self_mem_nhdsWithin).exists
    have hδ0' : 0 < δ := hδ0
    -- smooth bumps `b x = 1` on `B̄_{r x}(x)`, supported in `B_{r x + δ}(x)`
    set r' : Euclid (n + 1) → ℝ := fun x => if 0 < r x then r x else 1 with hrpdef
    have hr'pos : ∀ x, 0 < r' x := fun x => by
      simp only [hrpdef]
      split_ifs with h
      exacts [h, one_pos]
    have hr'eq : ∀ x ∈ t', r' x = r x := fun x hx => by
      simp only [hrpdef]
      rw [ite_eq_left (htr x (ht' hx)).2.1]
    let b : ∀ x : Euclid (n + 1), ContDiffBump x := fun x =>
      ⟨r' x, r' x + δ, hr'pos x, lt_add_of_pos_right _ hδ0'⟩
    have hbz : ∀ x z, z ∉ ball x (r' x + δ) → b x z = 0 := fun x z hz =>
      Function.notMem_support.1 fun h => hz (by rw [(b x).support_eq] at h; exact h)
    -- the test field `φ = ∑ b x · ν(x)`, smooth with `|φ| ≤ 1`
    set φ : Euclid (n + 1) → Euclid (n + 1) := fun z => ∑ x ∈ t', b x z • ν x with hφdef
    have hφs : ContDiff ℝ (⊤ : ℕ∞) φ :=
      ContDiff.sum fun x _ => (b x).contDiff.smul contDiff_const
    have hφc : HasCompactSupport φ := by
      refine HasCompactSupport.intro
        (t'.isCompact_biUnion fun x _ => isCompact_closedBall x (r' x + δ)) fun z hz => ?_
      simp only [mem_iUnion, not_exists] at hz
      exact Finset.sum_eq_zero fun x hx => by
        rw [hbz x z fun h => hz x hx (ball_subset_closedBall h), zero_smul]
    have hφ1 : ∀ z, ‖φ z‖ ≤ 1 := by
      intro z
      by_cases hz : ∃ x ∈ t', z ∈ ball x (r' x + δ)
      · obtain ⟨x, hx, hzx⟩ := hz
        have hsum : φ z = b x z • ν x := by
          refine Finset.sum_eq_single_of_mem x hx fun x' hx' hne => ?_
          rw [hbz x' z fun h => ?_, zero_smul]
          rw [hr'eq x hx] at hzx
          rw [hr'eq x' hx'] at h
          exact (hδ2 x hx x' hx' (Ne.symm hne)).ne_of_mem hzx h rfl
        rw [hsum, norm_smul, hν1, mul_one, Real.norm_of_nonneg (b x).nonneg]
        exact (b x).le_one
      · push Not at hz
        have h0 : φ z = 0 := Finset.sum_eq_zero fun x hx => by rw [hbz x z (hz x hx), zero_smul]
        rw [h0, norm_zero]
        exact zero_le_one
    -- integrability of the summands of `⟨φ, ν⟩`
    have hint : ∀ x ∈ t', Integrable (fun z => b x z * inner ℝ (ν x) (ν z)) μ := by
      intro x _
      have hg : Integrable ((closedBall x (r' x + δ)).indicator fun _ => (1 : ℝ)) μ :=
        (integrableOn_const (hμK' _ (isCompact_closedBall x (r' x + δ)))).integrable_indicator
          measurableSet_closedBall
      refine Integrable.mono' hg
        (((b x).continuous.measurable.mul
          (Continuous.measurable2 continuous_inner measurable_const hν)).aestronglyMeasurable)
        (Eventually.of_forall fun z => ?_)
      by_cases hz : z ∈ ball x (r' x + δ)
      · rw [indicator_of_mem (ball_subset_closedBall hz), Real.norm_eq_abs, abs_mul,
          abs_of_nonneg (b x).nonneg]
        calc b x z * |inner ℝ (ν x) (ν z)| ≤ 1 * 1 :=
              mul_le_mul (b x).le_one ((abs_real_inner_le_norm _ _).trans
                (by rw [hν1, hν1, one_mul])) (abs_nonneg _) zero_le_one
          _ = 1 := one_mul 1
      · rw [hbz x z hz, zero_mul, norm_zero]
        exact indicator_nonneg (fun _ _ => zero_le_one) z
    have hφint : ∫ z, inner ℝ (φ z) (ν z) ∂μ =
        ∑ x ∈ t', ∫ z, b x z * inner ℝ (ν x) (ν z) ∂μ := by
      rw [← integral_finsetSum _ hint]
      refine integral_congr_ae (Eventually.of_forall fun z => ?_)
      simp only [hφdef, sum_inner, real_inner_smul_left]
    -- each summand is at least `½ μ(B̄_{r x}(x)) - 1 / (#t' + 1)`
    have hlow : ∀ x ∈ t', (1 / 2 : ℝ) * (μ (closedBall x (r x))).toReal - 1 / (t'.card + 1) ≤
        ∫ z, b x z * inner ℝ (ν x) (ν z) ∂μ := by
      intro x hx
      have hrx := hr'eq x hx
      have hA : MeasurableSet (ball x (r x + δ) \ closedBall x (r x)) :=
        measurableSet_ball.diff measurableSet_closedBall
      have hAfin : μ (ball x (r x + δ) \ closedBall x (r x)) ≠ ∞ := (hδ1 x hx).ne_top
      have hpt : ∀ z, (closedBall x (r x)).indicator (fun z => inner ℝ (ν z) (ν x)) z -
          (ball x (r x + δ) \ closedBall x (r x)).indicator (1 : Euclid (n + 1) → ℝ) z ≤
            b x z * inner ℝ (ν x) (ν z) := by
        intro z
        by_cases h1 : z ∈ closedBall x (r x)
        · have hb1 : b x z = 1 := (b x).one_of_mem_closedBall
            (by show z ∈ closedBall x (r' x); rw [hrx]; exact h1)
          rw [indicator_of_mem h1, indicator_of_notMem (fun h => h.2 h1), hb1, one_mul,
            real_inner_comm, sub_zero]
        · rw [indicator_of_notMem h1, zero_sub]
          by_cases h2 : z ∈ ball x (r x + δ)
          · rw [indicator_of_mem (show z ∈ ball x (r x + δ) \ closedBall x (r x) from ⟨h2, h1⟩),
              Pi.one_apply]
            have habs : |b x z * inner ℝ (ν x) (ν z)| ≤ 1 := by
              rw [abs_mul, abs_of_nonneg (b x).nonneg]
              calc b x z * |inner ℝ (ν x) (ν z)| ≤ 1 * 1 :=
                    mul_le_mul (b x).le_one ((abs_real_inner_le_norm _ _).trans
                      (by rw [hν1, hν1, one_mul])) (abs_nonneg _) zero_le_one
                _ = 1 := one_mul 1
            linarith [neg_abs_le (b x z * inner ℝ (ν x) (ν z))]
          · rw [indicator_of_notMem (fun h => h2 h.1),
              hbz x z (by rw [hrx]; exact h2), zero_mul, neg_zero]
      have hI1 : Integrable ((closedBall x (r x)).indicator fun z => inner ℝ (ν z) (ν x)) μ := by
        refine IntegrableOn.integrable_indicator ?_ measurableSet_closedBall
        have : IsFiniteMeasure (μ.restrict (closedBall x (r x))) :=
          isFiniteMeasure_restrict.2 (hμK' _ (isCompact_closedBall _ _))
        refine (integrable_const (1 : ℝ)).mono'
          (Continuous.measurable2 continuous_inner hν measurable_const).aestronglyMeasurable
          (Eventually.of_forall fun z => ?_)
        rw [Real.norm_eq_abs]
        exact (abs_real_inner_le_norm _ _).trans (by rw [hν1, hν1, one_mul])
      have hI2 : Integrable
          ((ball x (r x + δ) \ closedBall x (r x)).indicator (1 : Euclid (n + 1) → ℝ)) μ :=
        (integrableOn_const hAfin).integrable_indicator hA
      have hmono : ∫ z, ((closedBall x (r x)).indicator (fun z => inner ℝ (ν z) (ν x)) z -
          (ball x (r x + δ) \ closedBall x (r x)).indicator (1 : Euclid (n + 1) → ℝ) z) ∂μ ≤
            ∫ z, b x z * inner ℝ (ν x) (ν z) ∂μ :=
        integral_mono (hI1.sub hI2) (hint x hx) hpt
      rw [integral_sub hI1 hI2, integral_indicator measurableSet_closedBall,
        integral_indicator_one hA, measureReal_def] at hmono
      have hAε : (μ (ball x (r x + δ) \ closedBall x (r x))).toReal ≤ 1 / (t'.card + 1) :=
        ENNReal.toReal_le_of_le_ofReal hε.le (hδ1 x hx).le
      have hball : (1 / 2 : ℝ) * (μ (closedBall x (r x))).toReal ≤
          ∫ z in closedBall x (r x), inner ℝ (ν z) (ν x) ∂μ := (htr x (ht' hx)).1
      linarith
    -- sum up and compare with the dual bound
    have h2 : ∑ x ∈ t', ((1 / 2 : ℝ) * (μ (closedBall x (r x))).toReal - 1 / (t'.card + 1)) ≤ C :=
      (Finset.sum_le_sum hlow).trans (hφint ▸ hdual φ hφs hφc hφ1)
    rw [Finset.sum_sub_distrib, ← Finset.mul_sum, Finset.sum_const, nsmul_eq_mul] at h2
    have h3 : (t'.card : ℝ) * (1 / (t'.card + 1)) ≤ 1 := by
      rw [mul_one_div, div_le_one (by positivity)]
      linarith
    linarith
  -- Step 2(d): `μ(ℝⁿ⁺¹) ≤ 2 (C + 1)`
  have hfin : μ univ ≠ ∞ := by
    have hcov : (univ : Set (Euclid (n + 1))) ⊆
        sᶜ ∪ (s \ ⋃ x ∈ t, closedBall x (r x)) ∪ ⋃ x ∈ t, closedBall x (r x) := by
      intro z _
      by_cases h1 : z ∈ s
      · by_cases h2 : z ∈ ⋃ x ∈ t, closedBall x (r x)
        · exact Or.inr h2
        · exact Or.inl (Or.inr ⟨h1, h2⟩)
      · exact Or.inl (Or.inl h1)
    have hU : μ univ ≤ ENNReal.ofReal (2 * (C + 1)) :=
      calc μ univ ≤ μ (sᶜ ∪ (s \ ⋃ x ∈ t, closedBall x (r x)) ∪ ⋃ x ∈ t, closedBall x (r x)) :=
            measure_mono hcov
        _ ≤ μ sᶜ + μ (s \ ⋃ x ∈ t, closedBall x (r x)) + μ (⋃ x ∈ t, closedBall x (r x)) :=
            (measure_union_le _ _).trans (add_le_add (measure_union_le _ _) le_rfl)
        _ = μ (⋃ x ∈ t, closedBall x (r x)) := by rw [hs, htcov, zero_add, zero_add]
        _ ≤ ∑' x : t, μ (closedBall x (r x)) := measure_biUnion_le μ htc _
        _ ≤ ENNReal.ofReal (2 * (C + 1)) := by
            rw [ENNReal.tsum_eq_iSup_sum]
            refine iSup_le fun F => ?_
            have hsub : ((F.map (Function.Embedding.subtype (· ∈ t)) : Finset (Euclid (n + 1))) :
                Set (Euclid (n + 1))) ⊆ t := by
              intro x hx
              simp only [Finset.coe_map, Function.Embedding.coe_subtype, mem_image,
                Finset.mem_coe] at hx
              obtain ⟨y, -, rfl⟩ := hx
              exact y.2
            calc ∑ y ∈ F, μ (closedBall (y : Euclid (n + 1)) (r y))
                = ∑ x ∈ F.map (Function.Embedding.subtype (· ∈ t)), μ (closedBall x (r x)) :=
                  (Finset.sum_map F (Function.Embedding.subtype (· ∈ t))
                    fun x => μ (closedBall x (r x))).symm
              _ = ∑ x ∈ F.map (Function.Embedding.subtype (· ∈ t)),
                    ENNReal.ofReal (μ (closedBall x (r x))).toReal :=
                  Finset.sum_congr rfl fun x _ =>
                    (ENNReal.ofReal_toReal (hμK' _ (isCompact_closedBall _ _))).symm
              _ = ENNReal.ofReal (∑ x ∈ F.map (Function.Embedding.subtype (· ∈ t)),
                    (μ (closedBall x (r x))).toReal) :=
                  (ENNReal.ofReal_sum_of_nonneg fun x _ => ENNReal.toReal_nonneg).symm
              _ ≤ ENNReal.ofReal (2 * (C + 1)) := ENNReal.ofReal_le_ofReal (hkey _ hsub)
    exact ne_top_of_le_ne_top ENNReal.ofReal_ne_top hU
  -- Step 4 (Simon Ch. 3, 4.3 (†)): at `μ`-a.e. `y` the blow-ups of `μ` converge to `Hⁿ⌞ν(y)^⊥`
  have htan := Submission.codim1_rdo_dg_tangent_measure_ae n univ E μ ν hn isOpen_univ hE hμD hμK
    hν hν1 hGG
  -- Step 5: `μ = Hⁿ⌞B`, `B` Borel and countably `n`-rectifiable with approximate tangents `ν^⊥`
  obtain ⟨B, hB, -, hBrect, hμB, hBtan⟩ :=
    Submission.codim1_rdo_dg_measure_eq_hausdorff n univ μ ν hn isOpen_univ hμD hμK hν hν1 htan
      fun S hS hSrect hSfin =>
        Submission.codim1_rdo_rectifiable_ae_density_one (n + 1) n S hn hS hSrect hSfin
  -- Step 6: output
  have hBμ : μHE[n] B = μ univ := by rw [hμB, Measure.restrict_apply_univ]
  refine ⟨B, ν, hB, hBrect, hBμ ▸ hfin, hν, fun y _ => hν1 y, hBtan, fun φ hφ hφc => ?_, ?_⟩
  · rw [hGG φ hφ hφc (subset_univ _), hμB]
  · rw [← hμB]
    filter_upwards [hnormal] with y hy
    exact Submission.codim1_rdo_dg_blowup_halfspace n univ E μ ν y (ν y) hn isOpen_univ hE hμD hμK
      hν hν1 hGG hy.1 (hν1 y) hy.2
/-- **Simon 7.3.3**, step 1 of the class reduction (Remark 3.4, proof of 3.3(2)): for any measure
`μ` on `ℝᴾ` the upper density `limsup_{ρ↓0} μ(B_ρ(x))/(ωₙρⁿ)` is Borel in `x`.  `x ↦ μ(B_ρ(x))`
is lower semicontinuous by continuity from below on the balls `B_{ρ−1/(m+1)}(x) ↑ B_ρ(x)`;
dividing by `ωₙρⁿ ≠ 0` and taking suprema over `ρ ∈ (0, 1/(m+1))` keeps lower semicontinuity,
and the `limsup` along `𝓝[>] 0` is the infimum over `m ∈ ℕ` of these suprema. -/
theorem Submission.idtp_fons_cr_density_measurable : ∀ (P n : ℕ) (μ : Measure (Euclid P)), Measurable (fun x : Euclid P => (limsup (fun ρ : ℝ => μ (ball x ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0)).toReal) := by
  intro P n μ
  -- `x ↦ μ(B_ρ(x))` is lower semicontinuous: `B_ρ(x)` is the increasing union of the balls
  -- `B_{ρ - 1/(m+1)}(x)`, each contained in `B_ρ(x')` for `|x' - x| < 1/(m+1)`
  have hball : ∀ ρ : ℝ, LowerSemicontinuous fun x : Euclid P => μ (ball x ρ) := by
    intro ρ x t ht
    have hU : ⋃ m : ℕ, ball x (ρ - 1 / ((m : ℝ) + 1)) = ball x ρ := by
      ext z
      simp only [mem_iUnion, mem_ball]
      constructor
      · rintro ⟨m, hm⟩
        linarith [Nat.one_div_pos_of_nat (α := ℝ) (n := m)]
      · intro hz
        obtain ⟨m, hm⟩ := exists_nat_one_div_lt (sub_pos.2 hz)
        exact ⟨m, by linarith⟩
    have hmono : Monotone fun m : ℕ => ball x (ρ - 1 / ((m : ℝ) + 1)) := fun a b hab =>
      ball_subset_ball (sub_le_sub_left (Nat.one_div_le_one_div hab) ρ)
    have ht' : t < μ (⋃ m : ℕ, ball x (ρ - 1 / ((m : ℝ) + 1))) := by
      rw [hU]
      exact ht
    obtain ⟨m, hm⟩ := ((tendsto_measure_iUnion_atTop (μ := μ) hmono).eventually
      (lt_mem_nhds ht')).exists
    filter_upwards [ball_mem_nhds x (Nat.one_div_pos_of_nat (α := ℝ) (n := m))] with x' hx'
    refine hm.trans_le (measure_mono (ball_subset_ball' ?_))
    rw [mem_ball, dist_comm] at hx'
    linarith
  -- dividing by `ωₙρⁿ ≠ 0` preserves lower semicontinuity
  have hω : unitBallVolume n ≠ 0 := (measure_ball_pos volume (0 : Euclid n) one_pos).ne'
  have hg : ∀ ρ : ℝ, 0 < ρ → LowerSemicontinuous fun x : Euclid P =>
      μ (ball x ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n)) := fun ρ hρ =>
    (ENNReal.continuous_div_const _ (mul_ne_zero hω (ENNReal.ofReal_pos.2 (pow_pos hρ n)).ne')
      ).comp_lowerSemicontinuous (hball ρ) fun a b hab => ENNReal.div_le_div_right hab _
  -- the `limsup` along `𝓝[>] 0` is the countable infimum over the basis `(0, 1/(m+1))`
  have hbasis := nhdsWithin_hasBasis (nhds_basis_ball_inv_nat_succ (x := (0 : ℝ))) (Ioi 0)
  simp_rw [hbasis.limsup_eq_iInf_iSup]
  exact Measurable.ennreal_toReal (Measurable.iInf fun m => Measurable.iInf fun _ =>
    (lowerSemicontinuous_biSup fun ρ hρ => hg ρ hρ.2).measurable)
/-- **Simon 7.3.3, proof of 3.3(2)**, rescaling (chapter-07.txt lines 512–583, with Remark 3.4,
lines 380–398): for `t > 0` let `μ^{y,t} = t⁻ⁿ (η_{y,t})_# μ`.  As
`η_{y,t}⁻¹(B_ρ(w)) = B_{tρ}(y + tw)`, `μ^{y,t}(B_ρ(w)) = t⁻ⁿ μ(B_{tρ}(y + tw))`, so the density
ratio of `μ^{y,t}` at `(w, ρ)` is that of `μ` at `(y + tw, tρ)`; since `ρ ↦ tρ` maps `𝓝[>] 0`
onto itself the upper densities agree, and since `t⁻ⁿ ≠ 0` every ball about `w` has positive
`μ^{y,t}`-measure iff every ball about `y + tw` has positive `μ`-measure. -/
theorem Submission.idtp_fons_cr_density_rescale : ∀ (P n : ℕ) (μ : Measure (Euclid P)) (y : Euclid P) (t : ℝ), 0 < t → (∀ w : Euclid P, limsup (fun ρ : ℝ => (ENNReal.ofReal (t⁻¹ ^ n) • μ.map (dilation y t)) (ball w ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) = limsup (fun ρ : ℝ => μ (ball (y + t • w) ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0)) ∧ ∀ w : Euclid P, (∀ ε : ℝ, 0 < ε → (ENNReal.ofReal (t⁻¹ ^ n) • μ.map (dilation y t)) (ball w ε) ≠ 0) ↔ ∀ ε : ℝ, 0 < ε → μ (ball (y + t • w) ε) ≠ 0 := by
  intro P n μ y t ht
  -- `η_{y,t}⁻¹(B_ρ(w)) = B_{tρ}(y + tw)`, so `μ^{y,t}(B_ρ(w)) = t⁻ⁿ μ(B_{tρ}(y + tw))`
  have hball : ∀ (w : Euclid P) (ρ : ℝ), (ENNReal.ofReal (t⁻¹ ^ n) • μ.map (dilation y t))
      (ball w ρ) = ENNReal.ofReal (t⁻¹ ^ n) * μ (ball (y + t • w) (t * ρ)) := by
    intro w ρ
    have hmeas : Measurable (dilation y t) :=
      (continuous_const.add (dilationCLM P t).continuous).measurable
    have hpre : dilation y t ⁻¹' ball w ρ = ball (y + t • w) (t * ρ) := by
      ext z
      have hz : dilation y t z - w = t⁻¹ • (z - (y + t • w)) := by
        change -(t⁻¹ • y) + t⁻¹ • z - w = _
        rw [smul_sub, smul_add, smul_smul, inv_mul_cancel₀ ht.ne', one_smul]
        abel
      rw [mem_preimage, mem_ball, mem_ball, dist_eq_norm, dist_eq_norm, hz, norm_smul,
        Real.norm_of_nonneg (inv_nonneg.2 ht.le), inv_mul_lt_iff₀ ht]
    rw [Measure.smul_apply, Measure.map_apply hmeas measurableSet_ball, hpre, smul_eq_mul]
  refine ⟨fun w => ?_, fun w => ?_⟩
  · -- the density ratio of `μ^{y,t}` at `(w, ρ)` is that of `μ` at `(y + tw, tρ)`
    set H : ℝ → ℝ≥0∞ := fun r => μ (ball (y + t • w) r) / (unitBallVolume n * ENNReal.ofReal (r ^ n))
    have hk0 : ENNReal.ofReal (t ^ n) ≠ 0 := (ENNReal.ofReal_pos.2 (pow_pos ht n)).ne'
    have hfun : (fun ρ : ℝ => (ENNReal.ofReal (t⁻¹ ^ n) • μ.map (dilation y t)) (ball w ρ) /
        (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) = H ∘ (t * ·) := by
      funext ρ
      rw [comp_apply, hball]
      simp only [H, mul_pow, ENNReal.ofReal_mul (pow_nonneg ht.le n), inv_pow,
        ENNReal.ofReal_inv_of_pos (pow_pos ht n), div_eq_mul_inv]
      rw [mul_left_comm (unitBallVolume n), ENNReal.mul_inv (Or.inl hk0) (Or.inl ENNReal.ofReal_ne_top)]
      ring
    -- `ρ ↦ tρ` maps `𝓝[>] 0` onto itself
    have hmap : map (t * ·) (𝓝[>] (0 : ℝ)) = 𝓝[>] 0 := by
      conv_lhs => rw [← comap_mulLeft_nhdsGT_zero ht]
      exact map_comap_of_surjective (mul_left_surjective₀ ht.ne') _
    rw [hfun, limsup_comp, hmap]
  · -- `t⁻ⁿ ≠ 0` and `ε ↦ tε` is a bijection of `(0, ∞)`
    have hc : ENNReal.ofReal (t⁻¹ ^ n) ≠ 0 := (ENNReal.ofReal_pos.2 (pow_pos (inv_pos.2 ht) n)).ne'
    simp only [hball, ne_eq, mul_eq_zero, hc, false_or]
    constructor
    · intro h δ hδ
      have := h (δ / t) (div_pos hδ ht)
      rwa [mul_div_cancel₀ δ ht.ne'] at this
    · intro h ε hε
      exact h (t * ε) (mul_pos ht hε)
/-- **Homogeneous measures have dilation-invariant upper density ratios** (the weight of a
tangent cone in the proof of Simon 7.3.3, homogeneous of degree `n` by
`cone_current_imrep_measure_smul_image` since `η_{0,λ#}C = C`, 7.3.1(2)).  If `ν(λA) = λⁿ ν(A)`
for every `λ > 0` and Borel `A`, then for `t > 0` the ratios `r_ν(y, ρ) = ν(B_ρ(y))/(ωₙρⁿ)` (in
`[0, ∞]`, no finiteness of `ωₙ` used) satisfy `limsup_{ρ↓0} r_ν(tw, ρ) = limsup_{ρ↓0} r_ν(w, ρ)`:
`B_ρ(tw) = t B_{ρ/t}(w)` and `ωₙρⁿ = tⁿ ωₙ(ρ/t)ⁿ`, so cancelling the finite nonzero factor `tⁿ`
gives `r_ν(tw, ρ) = r_ν(w, ρ/t)` for `ρ > 0`, and `ρ ↦ ρ/t` maps `𝓝[>] 0` onto itself. -/
theorem Submission.idtp_fons_cc_tm_density_homogeneous : ∀ (P n : ℕ) (ν : Measure (Euclid P)), (∀ lam : ℝ, 0 < lam → ∀ A : Set (Euclid P), MeasurableSet A → ν ((fun x => lam • x) '' A) = ENNReal.ofReal (lam ^ n) * ν A) → ∀ t : ℝ, 0 < t → ∀ w : Euclid P, limsup (fun ρ : ℝ => ν (ball (t • w) ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) = limsup (fun ρ : ℝ => ν (ball w ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) := by
  intro P n ν hν t ht w
  -- steps 1–4: `r_ν(tw, ρ) = r_ν(w, ρ/t)` for every `ρ > 0`
  have hratio : ∀ ρ : ℝ, 0 < ρ →
      ν (ball (t • w) ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n)) =
        ν (ball w (ρ / t)) / (unitBallVolume n * ENNReal.ofReal ((ρ / t) ^ n)) := by
    intro ρ _
    -- step 1: `B_ρ(tw) = t • B_{ρ/t}(w)`, as `‖t‖ (ρ/t) = ρ`
    have hball : ball (t • w) ρ = (fun x => t • x) '' ball w (ρ / t) := by
      rw [image_smul, smul_ball ht.ne', Real.norm_of_nonneg ht.le, mul_div_cancel₀ ρ ht.ne']
    -- step 3: `ωₙρⁿ = tⁿ (ωₙ(ρ/t)ⁿ)`, as `ρⁿ = tⁿ(ρ/t)ⁿ`
    have hden : unitBallVolume n * ENNReal.ofReal (ρ ^ n) =
        ENNReal.ofReal (t ^ n) * (unitBallVolume n * ENNReal.ofReal ((ρ / t) ^ n)) := by
      rw [mul_left_comm, ← ENNReal.ofReal_mul (pow_nonneg ht.le n), ← mul_pow,
        mul_div_cancel₀ ρ ht.ne']
    -- steps 2 and 4: `ν(B_ρ(tw)) = tⁿ ν(B_{ρ/t}(w))`, and cancel the finite nonzero `tⁿ`
    rw [hball, hν t ht _ measurableSet_ball, hden,
      ENNReal.mul_div_mul_left _ _ (ENNReal.ofReal_pos.2 (pow_pos ht n)).ne' ENNReal.ofReal_ne_top]
  -- step 7: `ρ ↦ ρ/t` maps `𝓝[>] 0` onto itself, its inverse being `ρ ↦ tρ`
  have hmap : map (fun ρ : ℝ => ρ / t) (𝓝[>] 0) = 𝓝[>] 0 := by
    rw [map_eq_comap_of_inverse (m := fun ρ : ℝ => ρ / t) (n := fun ρ : ℝ => t * ρ)
      (funext fun ρ => mul_div_cancel_left₀ ρ ht.ne') (funext fun ρ => mul_div_cancel₀ ρ ht.ne'),
      comap_mulLeft_nhdsGT_zero ht]
  -- steps 5, 6 and 8: eventual equality along `𝓝[>] 0`, then change variables `ρ ↦ ρ/t`
  calc limsup (fun ρ : ℝ => ν (ball (t • w) ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n)))
        (𝓝[>] 0)
      = limsup ((fun ρ : ℝ => ν (ball w ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) ∘
          fun ρ => ρ / t) (𝓝[>] 0) :=
        limsup_congr (eventually_nhdsWithin_of_forall fun ρ hρ => hratio ρ hρ)
    _ = limsup (fun ρ : ℝ => ν (ball w ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n)))
          (map (fun ρ => ρ / t) (𝓝[>] 0)) := limsup_comp _ _ _
    _ = limsup (fun ρ : ℝ => ν (ball w ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n)))
          (𝓝[>] 0) := by rw [hmap]
/-- **Normalization** (Simon 7.3.3, proof of 3.3(2); Remark 3.4): `μHE[n] = a • μH[n]` with
`a = addHaarScalarFactor(volume, μH[n]) ≠ 0` depending only on `n`, so `c = a⁻¹`.  If
`μ = μHE[n]⌞g` is finite on compact sets, then `∫⁻_K g dμH[n] = a⁻¹ μ(K) < ∞` for compact `K`,
so `g • e` is locally `μH[n]`-integrable, and
`∫ f (g • e) dμH[n] = (∫ f g dμH[n]) • e = (a⁻¹ ∫ f g dμHE[n]) • e = (a⁻¹ ∫ f dμ) • e`. -/
theorem Submission.idtp_fons_cr_density_normalization : ∀ (P n : ℕ), ∃ c : ℝ, 0 < c ∧ ∀ (Q : ℕ) (μ : Measure (Euclid P)) (g : Euclid P → ℝ) (e : Euclid Q), Measurable g → (∀ x, 0 ≤ g x) → (∀ K : Set (Euclid P), IsCompact K → μ K ≠ ∞) → μ = (μHE[n] : Measure (Euclid P)).withDensity (fun x => ENNReal.ofReal (g x)) → LocallyIntegrable (fun x => g x • e) μH[(n : ℝ)] ∧ ∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → ∫ x, f x • (g x • e) ∂μH[(n : ℝ)] = (c * ∫ x, f x ∂μ) • e := by
  intro P n
  -- `μHE[n] = a • μH[n]`, where `a ≠ 0` depends only on `n`
  obtain ⟨a, ha0, hE⟩ : ∃ a : NNReal, a ≠ 0 ∧
      (μHE[n] : Measure (Euclid P)) = a • μH[(n : ℝ)] :=
    ⟨_, Measure.addHaarScalarFactor_volume_hausdorffMeasure_ne_zero n,
      Measure.euclideanHausdorffMeasure_def n⟩
  refine ⟨(a : ℝ)⁻¹, inv_pos.2 (NNReal.coe_pos.2 (pos_iff_ne_zero.2 ha0)), ?_⟩
  intro Q μ g e hg hg0 hμK hμ
  -- `μ = a • μH[n]⌞g`
  have hμ' : μ = (a : ℝ≥0∞) • (μH[(n : ℝ)] : Measure (Euclid P)).withDensity
      (fun x => ENNReal.ofReal (g x)) := by
    rw [hμ, hE, ← withDensity_smul_measure]
    rfl
  refine ⟨?_, fun f hf hfc => ?_⟩
  · -- local integrability: `∫⁻_K g dμH[n] = a⁻¹ μ(K) < ∞` for compact `K`
    rw [locallyIntegrable_iff]
    intro K hK
    refine Integrable.smul_const ⟨hg.aestronglyMeasurable, ?_⟩ e
    rw [hasFiniteIntegral_iff_ofReal (ae_of_all _ hg0), ← withDensity_apply _ hK.measurableSet]
    have hK' := hμK K hK
    rw [hμ', Measure.smul_apply, smul_eq_mul] at hK'
    exact ENNReal.lt_top_of_mul_ne_top_right hK' (by exact_mod_cast ha0)
  · -- pull out `e`, then pass from `μH[n]` to `μHE[n] = a • μH[n]` and to `μ = μHE[n]⌞g`
    have h1 : ∀ x, f x • (g x • e) = (f x * g x) • e := fun x => smul_smul _ _ _
    simp_rw [h1]
    rw [integral_smul_const]
    congr 1
    have h2 : ∫ x, f x ∂μ = (a : ℝ) * ∫ x, f x * g x ∂μH[(n : ℝ)] := by
      rw [hμ, hE, integral_withDensity_eq_integral_toReal_smul (by fun_prop)
        (ae_of_all _ fun x => ENNReal.ofReal_lt_top), integral_smul_nnreal_measure,
        NNReal.smul_def, smul_eq_mul]
      congr 1
      refine integral_congr_ae (ae_of_all _ fun x => ?_)
      simp only [ENNReal.toReal_ofReal (hg0 x), smul_eq_mul, mul_comm]
    rw [h2, ← mul_assoc, inv_mul_cancel₀ (NNReal.coe_ne_zero.2 ha0), one_mul]

/-- **`n`-homogeneity of `f Hⁿ` for a dilation-invariant density `f`** (Simon Lemma 7.3.5,
chapter-07.txt lines 407–420, whose proof is "left to the reader": part (ii) of the invariance of
the mass measure `μ = Θ Hⁿ` of `S` when its density `Θ` is invariant under `w ↦ λw`, with an
arbitrary `f : ℝᴾ → [0, ∞]` in place of `ofReal ∘ Θ`).  If `λ > 0` and `f(λx) = f(x)` for all `x`,
then `(f Hⁿ)(λA) = λⁿ (f Hⁿ)(A)` for every Borel `A ⊆ ℝᴾ`.  `δ(x) = λx` is a homeomorphism, so
`λA = δ(A)` is Borel and `δ⁻¹(λA) = A`; the change of variables (ii) of
`Submission.euclid_hausdorff_dilation_change_of_variables` with `g = f` and `f ∘ δ = f` gives
`(f Hⁿ)(A) = λ⁻ⁿ (f Hⁿ)(λA)`, and `λⁿ λ⁻ⁿ = 1`. -/
theorem Submission.dimred_cs_mi_withDensity_dilate : ∀ (P n : ℕ) (f : Euclid P → ℝ≥0∞) (lam : ℝ), 0 < lam → (∀ x : Euclid P, f (lam • x) = f x) → ∀ A : Set (Euclid P), MeasurableSet A → (μHE[n] : Measure (Euclid P)).withDensity f ((fun x => lam • x) '' A) = ENNReal.ofReal (lam ^ n) * (μHE[n] : Measure (Euclid P)).withDensity f A := by
  intro P n f lam hlam hf A hA
  -- Step 1: `δ(x) = λx` is a homeomorphism, hence a measurable embedding: `D = δ(A)` is Borel and
  -- `δ⁻¹(D) = A` by injectivity.
  have hδ : MeasurableEmbedding (fun x : Euclid P => lam • x) :=
    (Homeomorph.smulOfNeZero lam hlam.ne').measurableEmbedding
  have hD : MeasurableSet ((fun x : Euclid P => lam • x) '' A) := hδ.measurableSet_image.2 hA
  have hpre : (fun x : Euclid P => lam • x) ⁻¹' ((fun x : Euclid P => lam • x) '' A) = A :=
    Set.preimage_image_eq A hδ.injective
  -- Steps 2–3: change of variables (ii) with `c = λ`, `M = D`, `g = f`; with `δ⁻¹(D) = A` and
  -- `f(λz) = f(z)` it reads `∫⁻_A f dHⁿ = λ⁻ⁿ ∫⁻_D f dHⁿ`.
  have h := (Submission.euclid_hausdorff_dilation_change_of_variables P n lam hlam
    ((fun x : Euclid P => lam • x) '' A)).2.1 f
  rw [hpre] at h
  simp only [hf] at h
  -- Steps 4–5: `ν(A) = λ⁻ⁿ ν(D)` by `withDensity_apply` (`A`, `D` Borel), and
  -- `ofReal(λⁿ) ofReal(λ⁻ⁿ) = ofReal((λλ⁻¹)ⁿ) = 1`.
  rw [withDensity_apply _ hD, withDensity_apply _ hA, h, ← mul_assoc,
    ← ENNReal.ofReal_mul (pow_nonneg hlam.le n), ← mul_pow, mul_inv_cancel₀ hlam.ne', one_pow,
    ENNReal.ofReal_one, one_mul]

/-- **A measure of finite positive mass is not `f Hⁿ` with `f` dilation-invariant** (`n ≥ 1`;
non-homogeneity of the positive-scale members `η_{x,λ#}T`, `λ > 0`, of the class `𝒯` in the proof
of Simon 7.3.3(1), chapter-07.txt lines 444–472).  If `f(tw) = f(w)` for all `t > 0`, then
`ρ = f Hⁿ` has `ρ(B_t(0)) = tⁿ ρ(B_1(0))` for `t > 0`, by
`Submission.dimred_cs_mi_withDensity_dilate` with `A = B_1(0)` and `tB_1(0) = B_t(0)`.  If
`ρ(B_1(0)) = 0`, the null balls `B_{m+1}(0)` cover `ℝᴾ` and `ρ(ℝᴾ) = 0`; otherwise
`t ρ(B_1(0)) ≤ tⁿ ρ(B_1(0)) ≤ ρ(ℝᴾ)` for `t ≥ 1`, with `t ρ(B_1(0)) → ∞`, so `ρ(ℝᴾ) = ∞`.  Either
way `ρ ≠ ν` when `0 < ν(ℝᴾ) < ∞`. -/
theorem Submission.idtp_fons_cc_psf_nonhomogeneous : ∀ (P n : ℕ) (ν : Measure (Euclid P)) (f : Euclid P → ℝ≥0∞), 1 ≤ n → ν univ ≠ 0 → ν univ ≠ ∞ → (∀ t : ℝ, 0 < t → ∀ w : Euclid P, f (t • w) = f w) → ν ≠ (μHE[n] : Measure (Euclid P)).withDensity f := by
  intro P n ν f hn h0 htop hf hν
  -- Step 1: suppose `ν = ρ := f Hⁿ`; then `ρ(ℝᴾ) ≠ 0` and `ρ(ℝᴾ) ≠ ∞`.
  subst hν
  set ρ := (μHE[n] : Measure (Euclid P)).withDensity f
  -- Step 2: `ρ(B_t(0)) = ofReal(tⁿ) ρ(B_1(0))` for `t > 0`, by the dilation homogeneity with
  -- `A = B_1(0)` and `(w ↦ tw)(B_1(0)) = tB_1(0) = B_t(0)`.
  have hball : ∀ t : ℝ, 0 < t → ρ (ball 0 t) = ENNReal.ofReal (t ^ n) * ρ (ball 0 1) := by
    intro t ht
    have h := Submission.dimred_cs_mi_withDensity_dilate P n f t ht (hf t ht) (ball 0 1)
      measurableSet_ball
    rwa [Set.image_smul, smul_unitBall_of_pos ht] at h
  by_cases h1 : ρ (ball 0 1) = 0
  -- Step 3: if `ρ(B_1(0)) = 0`, every ball `B_{m+1}(0)` is null, and these balls cover `ℝᴾ`.
  · refine h0 ?_
    rw [← iUnion_ball_nat_succ (0 : Euclid P)]
    refine measure_iUnion_null fun m => ?_
    rw [hball (m + 1) (by positivity), h1, mul_zero]
  -- Step 4: otherwise `ofReal(t) ρ(B_1(0)) → ∞ · ρ(B_1(0)) = ∞`, while for `t ≥ 1` (and `n ≥ 1`)
  -- `ofReal(t) ρ(B_1(0)) ≤ ofReal(tⁿ) ρ(B_1(0)) = ρ(B_t(0)) ≤ ρ(ℝᴾ)`; so `ρ(ℝᴾ) = ∞`.
  · have hlim : Tendsto (fun t : ℝ => ENNReal.ofReal t * ρ (ball 0 1)) atTop (𝓝 ∞) := by
      have h := ENNReal.Tendsto.mul_const ENNReal.tendsto_ofReal_atTop
        (Or.inl ENNReal.top_ne_zero) (b := ρ (ball 0 1))
      rwa [ENNReal.top_mul h1] at h
    refine htop (top_le_iff.mp (le_of_tendsto hlim ?_))
    filter_upwards [eventually_ge_atTop 1] with t ht
    calc ENNReal.ofReal t * ρ (ball 0 1) ≤ ENNReal.ofReal (t ^ n) * ρ (ball 0 1) := by
          gcongr
          simpa only [pow_one] using pow_le_pow_right₀ ht hn
      _ = ρ (ball 0 t) := (hball t (by linarith)).symm
      _ ≤ ρ univ := measure_mono (subset_univ _)
/-- **Density from a monotone density ratio** (existence of `Θⁿ` from the monotonicity formula,
Simon 7.3.1(1); chapter-07.txt lines 326–328).  Let `m : ℝ → [0, ∞]` be finite on `(0, R)` with
`g(ρ) = e^{Λρ}ρ⁻ⁿ m(ρ)` nondecreasing on `(0, R)`, and put `q(ρ) = m(ρ)/(ωₙρⁿ)`,
`Θ = (lim sup_{ρ↓0} q(ρ)).toReal`.  Then `q(ρ) → Θ` as `ρ ↓ 0`, and `ωₙΘσⁿe^{−Λσ} ≤ m(σ)` for
`σ ∈ (0, R)`.  Indeed `g(ρ) → L = inf g((0, R)) ≤ g(R/2) < ∞` and
`q(ρ) = ωₙ⁻¹e^{−Λρ}g(ρ) → ωₙ⁻¹L`, so `Θ = ωₙ⁻¹L` and
`ωₙΘσⁿe^{−Λσ} = Lσⁿe^{−Λσ} ≤ g(σ)σⁿe^{−Λσ} = m(σ)`. -/
theorem Submission.dimred_tr_mcr_tl_monotone_density : (∀ (n : ℕ) (Λ R : ℝ) (m : ℝ → ℝ≥0∞), 0 < R → (∀ ρ ∈ Ioo 0 R, m ρ ≠ ∞) → MonotoneOn (fun ρ : ℝ => ENNReal.ofReal (Real.exp (Λ * ρ) / ρ ^ n) * m ρ) (Ioo 0 R) → Tendsto (fun ρ : ℝ => m ρ / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) (𝓝 (ENNReal.ofReal (limsup (fun ρ : ℝ => m ρ / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0)).toReal)) ∧ ∀ σ ∈ Ioo 0 R, unitBallVolume n * ENNReal.ofReal (limsup (fun ρ : ℝ => m ρ / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0)).toReal * ENNReal.ofReal (σ ^ n * Real.exp (-(Λ * σ))) ≤ m σ) := by
  intro n Λ R m hR hfin hmono
  -- Step 1: `0 < ωₙ < ∞`
  have hω0 : unitBallVolume n ≠ 0 :=
    (measure_ball_pos (volume : Measure (Euclid n)) (0 : Euclid n) one_pos).ne'
  have hωt : unitBallVolume n ≠ ∞ :=
    (measure_ball_lt_top (μ := (volume : Measure (Euclid n))) (x := (0 : Euclid n)) (r := 1)).ne
  set ω : ℝ≥0∞ := unitBallVolume n
  -- Step 2: `g(ρ) → L = inf g((0, R))` as `ρ ↓ 0`, and `L ≤ g(R/2) < ∞`
  set g : ℝ → ℝ≥0∞ := fun ρ => ENNReal.ofReal (Real.exp (Λ * ρ) / ρ ^ n) * m ρ with hg_def
  set L : ℝ≥0∞ := sInf (g '' Ioo 0 R)
  have hgL : Tendsto g (𝓝[>] 0) (𝓝 L) :=
    hmono.tendsto_nhdsWithin_Ioo_right (nonempty_Ioo.2 hR) (OrderBot.bddBelow _)
  have hLle : ∀ σ ∈ Ioo (0 : ℝ) R, L ≤ g σ := fun σ hσ => sInf_le (mem_image_of_mem g hσ)
  have hR2 : R / 2 ∈ Ioo (0 : ℝ) R := ⟨by linarith, by linarith⟩
  have hLt : L ≠ ∞ :=
    ne_top_of_le_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top (hfin _ hR2)) (hLle _ hR2)
  -- Step 3: `q(ρ) = (e^{−Λρ}/ωₙ) g(ρ)` for `ρ > 0`
  set q : ℝ → ℝ≥0∞ := fun ρ => m ρ / (ω * ENNReal.ofReal (ρ ^ n)) with hq_def
  have hq_eq : ∀ ρ : ℝ, 0 < ρ →
      q ρ = (ENNReal.ofReal (Real.exp (-(Λ * ρ))) / ω) * g ρ := by
    intro ρ hρ
    have hρn : 0 < ρ ^ n := pow_pos hρ n
    have h1 : ENNReal.ofReal (Real.exp (-(Λ * ρ))) * ENNReal.ofReal (Real.exp (Λ * ρ) / ρ ^ n)
        = (ENNReal.ofReal (ρ ^ n))⁻¹ := by
      rw [← ENNReal.ofReal_mul (Real.exp_pos _).le, ← ENNReal.ofReal_inv_of_pos hρn,
        mul_div_assoc', ← Real.exp_add, neg_add_cancel, Real.exp_zero, one_div]
    simp only [hq_def, hg_def]
    rw [div_eq_mul_inv, ENNReal.mul_inv (Or.inl hω0) (Or.inl hωt), div_eq_mul_inv, ← h1]
    ring
  -- Step 4: `e^{−Λρ}/ωₙ → 1/ωₙ`, hence `q(ρ) → L/ωₙ`
  have hexp : Tendsto (fun ρ : ℝ => ENNReal.ofReal (Real.exp (-(Λ * ρ)))) (𝓝[>] 0) (𝓝 1) := by
    have hc : Continuous (fun ρ : ℝ => ENNReal.ofReal (Real.exp (-(Λ * ρ)))) :=
      ENNReal.continuous_ofReal.comp (by fun_prop)
    have := hc.tendsto 0
    simp only [mul_zero, neg_zero, Real.exp_zero, ENNReal.ofReal_one] at this
    exact this.mono_left nhdsWithin_le_nhds
  have hdiv : Tendsto (fun ρ : ℝ => ENNReal.ofReal (Real.exp (-(Λ * ρ))) / ω) (𝓝[>] 0)
      (𝓝 (1 / ω)) := ENNReal.Tendsto.div_const hexp (Or.inr hω0)
  have hprod : Tendsto (fun ρ : ℝ => (ENNReal.ofReal (Real.exp (-(Λ * ρ))) / ω) * g ρ) (𝓝[>] 0)
      (𝓝 (1 / ω * L)) :=
    ENNReal.Tendsto.mul hdiv (Or.inr hLt) hgL (Or.inr (ENNReal.div_ne_top ENNReal.one_ne_top hω0))
  have hq : Tendsto q (𝓝[>] 0) (𝓝 (1 / ω * L)) := by
    refine hprod.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with ρ hρ
    exact (hq_eq ρ hρ).symm
  -- Step 5: `lim sup q = L/ωₙ < ∞`, so `ofReal Θ = L/ωₙ`; this gives (i)
  have hfinlim : 1 / ω * L ≠ ∞ :=
    ENNReal.mul_ne_top (ENNReal.div_ne_top ENNReal.one_ne_top hω0) hLt
  have hΘ : ENNReal.ofReal (limsup q (𝓝[>] 0)).toReal = 1 / ω * L := by
    rw [hq.limsup_eq, ENNReal.ofReal_toReal hfinlim]
  refine ⟨?_, ?_⟩
  · rw [hΘ]
    exact hq
  -- Step 6: `ωₙ Θ σⁿe^{−Λσ} = L σⁿe^{−Λσ} ≤ g(σ) σⁿe^{−Λσ} = m(σ)`; this gives (ii)
  · intro σ hσ
    have hσn : 0 < σ ^ n := pow_pos hσ.1 n
    have hone : ENNReal.ofReal (Real.exp (Λ * σ) / σ ^ n) *
        ENNReal.ofReal (σ ^ n * Real.exp (-(Λ * σ))) = 1 := by
      rw [← ENNReal.ofReal_mul (div_nonneg (Real.exp_pos _).le hσn.le)]
      have : Real.exp (Λ * σ) / σ ^ n * (σ ^ n * Real.exp (-(Λ * σ))) = 1 := by
        rw [show Real.exp (Λ * σ) / σ ^ n * (σ ^ n * Real.exp (-(Λ * σ)))
            = (Real.exp (Λ * σ) * Real.exp (-(Λ * σ))) * (σ ^ n / σ ^ n) by ring,
          div_self hσn.ne', ← Real.exp_add, add_neg_cancel, Real.exp_zero, mul_one]
      rw [this, ENNReal.ofReal_one]
    have hωinv : ω * (1 / ω) = 1 := by
      rw [one_div, ENNReal.mul_inv_cancel hω0 hωt]
    show ω * ENNReal.ofReal (limsup q (𝓝[>] 0)).toReal *
      ENNReal.ofReal (σ ^ n * Real.exp (-(Λ * σ))) ≤ m σ
    rw [hΘ, ← mul_assoc, hωinv, one_mul]
    calc L * ENNReal.ofReal (σ ^ n * Real.exp (-(Λ * σ)))
        ≤ g σ * ENNReal.ofReal (σ ^ n * Real.exp (-(Λ * σ))) := by
          gcongr
          exact hLle σ hσ
      _ = m σ * (ENNReal.ofReal (Real.exp (Λ * σ) / σ ^ n) *
            ENNReal.ofReal (σ ^ n * Real.exp (-(Λ * σ)))) := by
          simp only [hg_def]
          ring
      _ = m σ := by rw [hone, mul_one]
/-- **Lower bounds on balls with moving centres pass to the limit measure.**  This is the
moving-centre semicontinuity behind Simon 7.3.3, proof of 3.3(1), display (12)
(chapter-07.txt lines 478–482: `Θⁿ(S, y) ≥ lim sup Θⁿ(Sᵢ, yᵢ)`).  Let `limsup μⱼ(K) ≤ μ(K)` for
compact `K`, `wⱼ → w`, and `h` continuous with, for all large `j`, `h(ρ) ≤ μⱼ(B_ρ(wⱼ))` for
`ρ ∈ (0, s)`.  Then `h(t) ≤ μ(B_t(w))` for `t ∈ (0, s)`.  For `ρ ∈ (0, t)`, eventually
`B_ρ(wⱼ) ⊆ B̄_{(t+ρ)/2}(w) ⊆ B_t(w)`, so `h(ρ) ≤ μ(B_t(w))`; let `ρ → t⁻`. -/
theorem Submission.dimred_tr_mcr_tl_lower_bound_transfer : ∀ (P : ℕ) (μ : Measure (Euclid P)) (μs : ℕ → Measure (Euclid P)) (ws : ℕ → Euclid P) (w : Euclid P) (s : ℝ) (h : ℝ → ℝ≥0∞), (∀ K : Set (Euclid P), IsCompact K → limsup (fun j => μs j K) atTop ≤ μ K) → Tendsto ws atTop (𝓝 w) → Continuous h → (∀ᶠ j in atTop, ∀ ρ ∈ Ioo 0 s, h ρ ≤ μs j (ball (ws j) ρ)) → ∀ t ∈ Ioo 0 s, h t ≤ μ (ball w t) := by
  intro P μ μs ws w s h hK hws hh hlow t ht
  -- Steps 1–3: for `ρ ∈ (0, t)`, once `|wⱼ - w| < (t - ρ)/2` the ball `B_ρ(wⱼ)` lies in the
  -- compact ball `K = B̄_{(t+ρ)/2}(w) ⊆ B_t(w)`, so `h ρ ≤ limsup μⱼ(K) ≤ μ(K) ≤ μ(B_t(w))`
  have hclaim : ∀ ρ ∈ Ioo 0 t, h ρ ≤ μ (ball w t) := by
    intro ρ hρ
    calc h ρ ≤ limsup (fun j => μs j (closedBall w ((t + ρ) / 2))) atTop := by
          refine le_limsup_of_frequently_le (Eventually.frequently ?_)
          filter_upwards [hlow, Metric.tendsto_nhds.mp hws ((t - ρ) / 2) (by linarith [hρ.2])]
            with j hj hjw
          refine (hj ρ ⟨hρ.1, hρ.2.trans ht.2⟩).trans (measure_mono fun z hz => ?_)
          rw [mem_ball] at hz
          rw [mem_closedBall]
          linarith [dist_triangle z (ws j) w]
      _ ≤ μ (closedBall w ((t + ρ) / 2)) := hK _ (isCompact_closedBall w _)
      _ ≤ μ (ball w t) := measure_mono (closedBall_subset_ball (by linarith [hρ.2]))
  -- Step 4: `h` is continuous and `(0, t) ∈ 𝓝[<] t`, so the claim passes to the limit `ρ → t⁻`
  exact le_of_tendsto ((hh.tendsto t).mono_left nhdsWithin_le_nhds)
    (eventually_of_mem (Ioo_mem_nhdsLT ht.1) hclaim)
/-- **Simon 7.3.3, proof of (12)** (its final limit, left to the reader): if
`ωₙ c tⁿ e^{−Λt} ≤ m(t)` for `0 < t < s` and `m(t)/(ωₙtⁿ) → L` as `t ↓ 0`, then `c ≤ L` (in
`[0, ∞]`).  As `0 < ωₙtⁿ < ∞`, dividing gives `c e^{−Λt} ≤ m(t)/(ωₙtⁿ)` on `(0, s)`, and the
left side tends to `c` as `t ↓ 0`. -/
theorem Submission.dimred_tr_mcr_tl_density_lower_bound : ∀ (n : ℕ) (Λ c s : ℝ) (m : ℝ → ℝ≥0∞) (L : ℝ≥0∞), 0 < s → (∀ t ∈ Ioo 0 s, unitBallVolume n * ENNReal.ofReal c * ENNReal.ofReal (t ^ n * Real.exp (-(Λ * t))) ≤ m t) → Tendsto (fun t : ℝ => m t / (unitBallVolume n * ENNReal.ofReal (t ^ n))) (𝓝[>] 0) (𝓝 L) → ENNReal.ofReal c ≤ L := by
  intro n Λ c s m L hs hlow hlim
  -- `0 < ωₙ < ∞`
  have hω0 : unitBallVolume n ≠ 0 := (measure_ball_pos volume (0 : Euclid n) one_pos).ne'
  have hωtop : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
  -- dividing by `ωₙtⁿ ∈ (0, ∞)`: `c e^{−Λt} ≤ m(t)/(ωₙtⁿ)` on `(0, s)`
  have hratio : ∀ t ∈ Ioo 0 s, ENNReal.ofReal c * ENNReal.ofReal (Real.exp (-(Λ * t))) ≤
      m t / (unitBallVolume n * ENNReal.ofReal (t ^ n)) := by
    intro t ht
    have htn : 0 < t ^ n := pow_pos ht.1 n
    rw [ENNReal.le_div_iff_mul_le (Or.inl (mul_ne_zero hω0 (ENNReal.ofReal_pos.mpr htn).ne'))
      (Or.inl (ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top))]
    calc ENNReal.ofReal c * ENNReal.ofReal (Real.exp (-(Λ * t))) *
          (unitBallVolume n * ENNReal.ofReal (t ^ n))
        = unitBallVolume n * ENNReal.ofReal c * ENNReal.ofReal (t ^ n * Real.exp (-(Λ * t))) := by
          rw [ENNReal.ofReal_mul htn.le]; ring
      _ ≤ m t := hlow t ht
  -- the left side is continuous in `t`, with value `ofReal c` at `t = 0`
  have hcont : Continuous fun t : ℝ => ENNReal.ofReal c * ENNReal.ofReal (Real.exp (-(Λ * t))) :=
    (ENNReal.continuous_const_mul ENNReal.ofReal_ne_top).comp <| ENNReal.continuous_ofReal.comp <|
      Real.continuous_exp.comp (continuous_const.mul continuous_id).neg
  have hleft : Tendsto (fun t : ℝ => ENNReal.ofReal c * ENNReal.ofReal (Real.exp (-(Λ * t))))
      (𝓝[>] 0) (𝓝 (ENNReal.ofReal c)) := by
    simpa using (hcont.tendsto 0).mono_left nhdsWithin_le_nhds
  -- `(0, s) ∈ 𝓝[>] 0`, so the bound passes to the limit
  exact le_of_tendsto_of_tendsto hleft hlim (eventually_of_mem (Ioo_mem_nhdsGT hs) hratio)

/-- **Density lower bounds pass to vague limits** (Simon 7.3.3, display (12), chapter-07.txt
lines 478–482, in threshold form; the densities exist by the monotonicity formula as in the proof
of 7.3.1(1), lines 326–328).  Let `μⱼ → μ` vaguely in `ℝᴾ`, all finite on compact sets and all
satisfying the monotonicity hypothesis (`ρ ↦ e^{Λρ} ρ⁻ⁿ ν(B_ρ(y))` nondecreasing on `(0, R)`
whenever `B̄_R(y) ⊆ B̄₂(0)`), and let `wⱼ → w` with `|w| < 2`.  If `c ≤ Θ(μⱼ, wⱼ)` for every `j`,
then `c ≤ Θ(μ, w)`.  With `r = (2 - |w|)/4`, monotonicity at `wⱼ` gives
`ωₙ c ρⁿ e^{-Λρ} ≤ μⱼ(B_ρ(wⱼ))` for `ρ < 2r` and large `j`; `limsup μⱼ(K) ≤ μ(K)` transfers this
to `μ(B_t(w))`, and dividing by `ωₙ tⁿ` and letting `t ↓ 0` (monotonicity at `w`) gives the
claim. -/
theorem Submission.dimred_tr_mcr_threshold_limit : ∀ (P n : ℕ) (Λ c : ℝ) (μ : Measure (Euclid P)) (μs : ℕ → Measure (Euclid P)) (ws : ℕ → Euclid P) (w : Euclid P), (∀ K : Set (Euclid P), IsCompact K → μ K ≠ ∞) → (∀ (j : ℕ) (K : Set (Euclid P)), IsCompact K → μs j K ≠ ∞) → (∀ (y : Euclid P) (R : ℝ), closedBall y R ⊆ closedBall 0 2 → MonotoneOn (fun ρ : ℝ => ENNReal.ofReal (Real.exp (Λ * ρ) / ρ ^ n) * μ (ball y ρ)) (Ioo 0 R)) → (∀ (j : ℕ) (y : Euclid P) (R : ℝ), closedBall y R ⊆ closedBall 0 2 → MonotoneOn (fun ρ : ℝ => ENNReal.ofReal (Real.exp (Λ * ρ) / ρ ^ n) * μs j (ball y ρ)) (Ioo 0 R)) → (∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → Tendsto (fun j => ∫ x, f x ∂(μs j)) atTop (𝓝 (∫ x, f x ∂μ))) → Tendsto ws atTop (𝓝 w) → ‖w‖ < 2 → (∀ j, c ≤ (limsup (fun ρ : ℝ => μs j (ball (ws j) ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0)).toReal) → c ≤ (limsup (fun ρ : ℝ => μ (ball w ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0)).toReal := by
  intro P n Λ c μ μs ws w hμ hμs hmono hmonos hconv hws hw hc
  -- Step 3 (the case `c ≤ 0`) needs no separate treatment: the final `ofReal_le_ofReal_iff` only
  -- uses `0 ≤ Θ(μ, w)`.
  -- Step 4: radii.  With `r = (2 - |w|)/4 > 0`, `B̄_{2r}(wⱼ) ⊆ B̄₂(0)` once `|wⱼ - w| < r`, and
  -- `B̄_{4r}(w) ⊆ B̄₂(0)`
  set r : ℝ := (2 - ‖w‖) / 4 with hr_def
  have hr : 0 < r := by linarith
  have hsubj : ∀ j, dist (ws j) w < r → closedBall (ws j) (2 * r) ⊆ closedBall 0 2 := by
    intro j hj
    refine closedBall_subset_closedBall' ?_
    have h0 := dist_triangle (ws j) w 0
    rw [dist_zero_right w] at h0
    linarith
  have hsub : closedBall w (4 * r) ⊆ closedBall 0 2 :=
    closedBall_subset_closedBall' (by rw [dist_zero_right]; linarith)
  -- open balls lie in compact closed balls, so they have finite measure
  have hfin : ∀ ν : Measure (Euclid P), (∀ K : Set (Euclid P), IsCompact K → ν K ≠ ∞) →
      ∀ (y : Euclid P) (ρ : ℝ), ν (ball y ρ) ≠ ∞ := fun ν hν y ρ =>
    measure_ne_top_of_subset ball_subset_closedBall (hν _ (isCompact_closedBall y ρ))
  -- the comparison function `h(ρ) = ωₙ ofReal(c) ofReal(ρⁿ e^{-Λρ})` is continuous (`ωₙ < ∞`)
  have hω : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
  have hcont : Continuous fun ρ : ℝ =>
      unitBallVolume n * ENNReal.ofReal c * ENNReal.ofReal (ρ ^ n * Real.exp (-(Λ * ρ))) :=
    (ENNReal.continuous_const_mul (ENNReal.mul_ne_top hω ENNReal.ofReal_ne_top)).comp
      (ENNReal.continuous_ofReal.comp (by fun_prop))
  -- Step 5: for large `j`, the monotone density lemma at `wⱼ` (radius `2r`) and `c ≤ Θ(μⱼ, wⱼ)`
  -- give `h(ρ) ≤ μⱼ(B_ρ(wⱼ))` for `0 < ρ < 2r`
  have hlow : ∀ᶠ j in atTop, ∀ ρ ∈ Ioo 0 (2 * r), unitBallVolume n * ENNReal.ofReal c *
      ENNReal.ofReal (ρ ^ n * Real.exp (-(Λ * ρ))) ≤ μs j (ball (ws j) ρ) := by
    filter_upwards [Metric.tendsto_nhds.mp hws r hr] with j hj ρ hρ
    calc unitBallVolume n * ENNReal.ofReal c * ENNReal.ofReal (ρ ^ n * Real.exp (-(Λ * ρ)))
        ≤ unitBallVolume n * ENNReal.ofReal (limsup (fun ρ : ℝ => μs j (ball (ws j) ρ) /
            (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0)).toReal *
            ENNReal.ofReal (ρ ^ n * Real.exp (-(Λ * ρ))) := by
          gcongr
          exact hc j
      _ ≤ μs j (ball (ws j) ρ) :=
          (Submission.dimred_tr_mcr_tl_monotone_density n Λ (2 * r)
            (fun ρ => μs j (ball (ws j) ρ)) (by linarith) (fun ρ _ => hfin _ (hμs j) _ _)
            (hmonos j (ws j) (2 * r) (hsubj j hj))).2 ρ hρ
  -- Step 6: vague convergence gives `limsup μⱼ(K) ≤ μ(K)` for compact `K` (portmanteau, `U = ℝᴾ`)
  have hvague : ∀ K : Set (Euclid P), IsCompact K → limsup (fun j => μs j K) atTop ≤ μ K :=
    fun K hK => (Submission.cbr_vague_portmanteau P univ μs μ isOpen_univ
      (fun j K hK _ => (hμs j K hK).lt_top) (fun K hK _ => (hμ K hK).lt_top)
      (fun f hf hfs _ => hconv f hf hfs)).1 K hK (subset_univ K)
  -- Step 7: the lower bound passes to the limit: `h(t) ≤ μ(B_t(w))` for `0 < t < 2r`
  have htr := Submission.dimred_tr_mcr_tl_lower_bound_transfer P μ μs ws w (2 * r) _ hvague hws
    hcont hlow
  -- Steps 8–9: by the monotone density lemma at `w` (radius `4r`) the ratio tends to
  -- `ofReal Θ(μ, w)`, so `ofReal c ≤ ofReal Θ(μ, w)`, i.e. `c ≤ Θ(μ, w)` as `Θ(μ, w) ≥ 0`
  have hlim := (Submission.dimred_tr_mcr_tl_monotone_density n Λ (4 * r)
    (fun ρ => μ (ball w ρ)) (by linarith) (fun ρ _ => hfin _ hμ _ _) (hmono w (4 * r) hsub)).1
  exact (ENNReal.ofReal_le_ofReal_iff ENNReal.toReal_nonneg).1
    (Submission.dimred_tr_mcr_tl_density_lower_bound n Λ c (2 * r) (fun t => μ (ball w t)) _
      (by linarith) htr hlim)
/-- **Simon, Appendix A, A.3(3) (p. 226)**, as used in the proof of 7.3.3 (p. 191): if every limit
of points `z_k ∈ B_1(0) ∩ S_{sub(k)}` along a strictly increasing `sub` lies in `S`, then for each
`ε > 0` the sets `B_1(0) ∩ S_k` lie in the `ε`-neighbourhood of `S` for all large `k`.  Otherwise
there are a strictly increasing `sub` and points `w_j ∈ B_1(0) ∩ S_{sub(j)}` at distance `≥ ε` from
every point of `S`; a subsequence converges in the compact `B̄_1(0)` to some `x`, which lies in `S`
by hypothesis, and then `dist(w_j, x) < ε` for some `j` of that subsequence. -/
theorem Submission.dimred_tr_mcr_eventually_near : ∀ (P : ℕ) (S : Set (Euclid P)) (Ss : ℕ → Set (Euclid P)), (∀ (sub : ℕ → ℕ) (z : ℕ → Euclid P) (x : Euclid P), StrictMono sub → (∀ k, z k ∈ ball (0 : Euclid P) 1 ∩ Ss (sub k)) → Tendsto z atTop (𝓝 x) → x ∈ S) → ∀ ε : ℝ, 0 < ε → ∃ k₀ : ℕ, ∀ k ≥ k₀, ball (0 : Euclid P) 1 ∩ Ss k ⊆ {x | ∃ z ∈ S, dist x z < ε} := by
  intro P S Ss hS ε hε
  by_contra hcon
  simp only [not_exists, not_forall, exists_prop] at hcon
  -- step 1: for arbitrarily large `k` some `x ∈ B_1(0) ∩ S_k` is `ε`-far from every point of `S`
  have hfreq : ∃ᶠ k in atTop, ∃ x ∈ ball (0 : Euclid P) 1 ∩ Ss k, ∀ z ∈ S, ε ≤ dist x z := by
    refine frequently_atTop.2 fun k₀ => ?_
    obtain ⟨k, hk, hsub⟩ := hcon k₀
    obtain ⟨x, hx, hxn⟩ := Set.not_subset.1 hsub
    exact ⟨k, hk, x, hx, fun z hz => not_lt.1 fun h => hxn ⟨z, hz, h⟩⟩
  -- step 2: a strictly increasing `sub` and far points `w j ∈ B_1(0) ∩ S_{sub(j)}`
  obtain ⟨sub, hsub, hbad⟩ := extraction_of_frequently_atTop hfreq
  choose w hw hwfar using hbad
  -- step 3: `B̄_1(0)` is compact, so `w ∘ ψ → x` for some strictly increasing `ψ`
  obtain ⟨x, -, ψ, hψ, hlim⟩ := (isCompact_closedBall (0 : Euclid P) 1).tendsto_subseq
    fun j => ball_subset_closedBall (hw j).1
  -- step 4: the hypothesis along the indices `sub ∘ ψ` gives `x ∈ S`
  have hxS : x ∈ S := hS (sub ∘ ψ) (w ∘ ψ) x (hsub.comp hψ) (fun i => hw (ψ i)) hlim
  -- step 5: `dist (w (ψ i)) x < ε` for large `i`, contradicting step 2
  obtain ⟨i, hi⟩ := Metric.tendsto_atTop.1 hlim ε hε
  exact (hwfar (ψ i) x hxS).not_gt (hi i le_rfl)

/-- **A measure `g Hⁿ` whose own density `g` is dilation-invariant and positive somewhere has
infinite mass** (`n ≥ 1`; used for the density-threshold `sing` in the dimension-reducing argument
of Simon Appendix A for 7.3.3: hypothesis A.3(1), chapter-A.txt lines 26–27, and the final step
`ν(B_{tR}(0)) = tⁿ ν(B_R(0)) → ∞`).  Let `g(x) = (limsup_{ρ↓0} μ(B_ρ(x))/(ωₙρⁿ)).toReal` for every
`x`, `μ = (ofReal ∘ g) Hⁿ`, `g(tx) = g(x)` for `t > 0`, and `g(x₀) > 0`.  If `μ(ℝᴾ) = 0`, then
`μ = 0`, every ratio `μ(B_ρ(x₀))/(ωₙρⁿ)` is `0` and `g(x₀) = 0`; so `μ(ℝᴾ) ≠ 0`, and
`Submission.idtp_fons_cc_psf_nonhomogeneous` with the dilation-invariant `f = ofReal ∘ g` excludes
`μ(ℝᴾ) < ∞`. -/
theorem Submission.dimred_tr_mcr_homogeneous_infinite_mass : ∀ (P n : ℕ) (μ : Measure (Euclid P)) (g : Euclid P → ℝ) (x₀ : Euclid P), 1 ≤ n → (∀ x, g x = (limsup (fun ρ : ℝ => μ (ball x ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0)).toReal) → μ = (μHE[n] : Measure (Euclid P)).withDensity (fun x => ENNReal.ofReal (g x)) → (∀ t : ℝ, 0 < t → ∀ x, g (t • x) = g x) → 0 < g x₀ → μ univ = ∞ := by
  intro P n μ g x₀ hn hg hμ hhom hx₀
  -- Step 1: `μ(ℝᴾ) ≠ 0`.  Otherwise `μ = 0`, so every ratio `μ(B_ρ(x₀))/(ωₙρⁿ)` is `0`, its
  -- limsup along the nontrivial filter `𝓝[>] 0` is `0`, and `g(x₀) = 0 < g(x₀)`.
  have h0 : μ univ ≠ 0 := by
    intro h
    rw [Measure.measure_univ_eq_zero] at h
    have hgx₀ : g x₀ = 0 := by
      rw [hg x₀, h]
      simp
    exact hx₀.ne' hgx₀
  -- Step 2: `μ(ℝᴾ) = ∞`.  Otherwise `0 < μ(ℝᴾ) < ∞` while `μ = f Hⁿ` with `f = ofReal ∘ g` and
  -- `f(tw) = f(w)` for `t > 0`, which the sibling non-homogeneity lemma excludes.
  by_contra htop
  exact Submission.idtp_fons_cc_psf_nonhomogeneous P n μ (fun x => ENNReal.ofReal (g x)) hn h0
    htop (fun t ht w => congrArg ENNReal.ofReal (hhom t ht w)) hμ

/-- **Class reduction for the density threshold** (Simon 7.3.3, proof of 3.3(1),
chapter-07.txt lines 472–494, with Remark 3.4, lines 380–398).  `𝓜` is a class of measures
`μ = Θ_μ Hⁿ` (`Θ_μ = dens μ`, the upper density), finite on compact sets, closed under the
rescalings `μ^{y,λ} = λ⁻ⁿ η_{y,λ#}μ` (Simon's (10)), with `n`-homogeneous vague blow-up limits,
satisfying the monotonicity bound, and containing no infinite flat measure of density `≥ c`.
Simon's data (13), (14) become `F = {Θ_μ e₁ : μ ∈ 𝓜}` and `sing φ = closure {c ≤ ⟨φ, e₁⟩}`; the
closure makes `sing φ` closed and, by the threshold limit (Simon's (12)), adds no points inside
`B₂(0)`.  The normalized pairings `∫ f Θ_μ e₁ dμH[n] = c₀ (∫ f dμ) e₁` turn the weak convergence
of A.2 and A.3(3) into vague convergence of the measures; A.3(1) follows from (6) and
`dimred_tr_mcr_homogeneous_infinite_mass`, and A.3(3) from the threshold limit and
`dimred_tr_mcr_eventually_near`.  The alternatives of A.4 then pass to the superlevel sets
`{c ≤ Θ_μ}`; an extremal `ν` has `Θ_ν` constant on `L`, so `{c ≤ Θ_ν} = L`, and, being nonzero and
`n`-homogeneous, has infinite mass. -/
theorem Submission.dimred_tr_measure_class_reduction : (∀ (P n Q : ℕ) (F : Set (Euclid P → Euclid Q)) (sing : (Euclid P → Euclid Q) → Set (Euclid P)), (∀ φ ∈ F, ∀ ψ ∈ F, (∀ᵐ x ∂μH[(n : ℝ)], φ x = ψ x) → φ = ψ) → (∀ φ ∈ F, LocallyIntegrable φ μH[(n : ℝ)]) → (∀ φ ∈ F, ∀ (y : Euclid P) (lam : ℝ), 0 < lam → lam < 1 → ‖y‖ ≤ 1 - lam → (fun x => φ (y + lam • x)) ∈ F) → (∀ φ ∈ F, ∀ y : Euclid P, ‖y‖ < 1 → ∀ lams : ℕ → ℝ, (∀ k, 0 < lams k) → StrictAnti lams → Tendsto lams atTop (𝓝 0) → ∃ (sub : ℕ → ℕ) (ψ : Euclid P → Euclid Q), StrictMono sub ∧ ψ ∈ F ∧ (∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → Tendsto (fun k => ∫ x, f x • φ (y + lams (sub k) • x) ∂μH[(n : ℝ)]) atTop (𝓝 (∫ x, f x • ψ x ∂μH[(n : ℝ)]))) ∧ ∀ lam : ℝ, 0 < lam → ∀ x, ψ (lam • x) = ψ x) → (∀ φ ∈ F, IsClosed (sing φ)) → (∀ φ ∈ F, ∀ (L : Submodule ℝ (Euclid P)) (c : Euclid Q), Module.finrank ℝ L = n → φ = Set.indicator (L : Set (Euclid P)) (fun _ => c) → sing φ = ∅) → (∀ φ ∈ F, ∀ (y : Euclid P) (lam : ℝ), 0 < lam → lam < 1 → ‖y‖ ≤ 1 - lam → sing (fun x => φ (y + lam • x)) = (fun x => y + lam • x) ⁻¹' sing φ) → (∀ φ ∈ F, ∀ φs : ℕ → Euclid P → Euclid Q, (∀ k, φs k ∈ F) → (∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → Tendsto (fun k => ∫ x, f x • φs k x ∂μH[(n : ℝ)]) atTop (𝓝 (∫ x, f x • φ x ∂μH[(n : ℝ)]))) → ∀ ε : ℝ, 0 < ε → ∃ k₀ : ℕ, ∀ k ≥ k₀, ball (0 : Euclid P) 1 ∩ sing (φs k) ⊆ {x | ∃ z ∈ sing φ, dist x z < ε}) → (∀ φ ∈ F, ball (0 : Euclid P) 1 ∩ sing φ = ∅) ∨ ∃ d : ℕ, d + 1 ≤ n ∧ (∀ φ ∈ F, ∀ α : ℝ, 0 < α → μH[(d : ℝ) + α] (sing φ ∩ ball (0 : Euclid P) 1) = 0) ∧ (∃ ψ ∈ F, ∃ L : Submodule ℝ (Euclid P), Module.finrank ℝ L = d ∧ sing ψ = (L : Set (Euclid P)) ∧ ∀ y ∈ L, ∀ lam : ℝ, 0 < lam → ∀ x, ψ (y + lam • x) = ψ x) ∧ (d = 0 → ∀ φ ∈ F, ∀ σ : ℝ, σ < 1 → (sing φ ∩ ball (0 : Euclid P) σ).Finite)) → ∀ (P n : ℕ) (c Λ : ℝ) (𝓜 : Set (Measure (Euclid P))) (dens : Measure (Euclid P) → Euclid P → ℝ), 1 ≤ n → 0 < c → (∀ (μ : Measure (Euclid P)) (x : Euclid P), dens μ x = (limsup (fun ρ : ℝ => μ (ball x ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0)).toReal) → (∀ μ ∈ 𝓜, ∀ K : Set (Euclid P), IsCompact K → μ K ≠ ∞) → (∀ μ ∈ 𝓜, μ = (μHE[n] : Measure (Euclid P)).withDensity (fun x => ENNReal.ofReal (dens μ x))) → (∀ μ ∈ 𝓜, ∀ (y : Euclid P) (lam : ℝ), 0 < lam → lam < 1 → ‖y‖ ≤ 1 - lam → ENNReal.ofReal (lam⁻¹ ^ n) • μ.map (dilation y lam) ∈ 𝓜) → (∀ μ ∈ 𝓜, ∀ y : Euclid P, ‖y‖ < 1 → ∀ lams : ℕ → ℝ, (∀ j, 0 < lams j) → StrictAnti lams → Tendsto lams atTop (𝓝 0) → ∃ (sub : ℕ → ℕ) (ν : Measure (Euclid P)), StrictMono sub ∧ ν ∈ 𝓜 ∧ (∀ lam : ℝ, 0 < lam → ∀ s : Set (Euclid P), MeasurableSet s → ν ((fun x => lam • x) '' s) = ENNReal.ofReal (lam ^ n) * ν s) ∧ ∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → Tendsto (fun j => ∫ x, f x ∂(ENNReal.ofReal ((lams (sub j))⁻¹ ^ n) • μ.map (dilation y (lams (sub j))))) atTop (𝓝 (∫ x, f x ∂ν))) → (∀ μ ∈ 𝓜, ∀ (y : Euclid P) (R : ℝ), closedBall y R ⊆ closedBall 0 2 → MonotoneOn (fun ρ : ℝ => ENNReal.ofReal (Real.exp (Λ * ρ) / ρ ^ n) * μ (ball y ρ)) (Ioo 0 R)) → (∀ μ ∈ 𝓜, μ univ = ∞ → ∀ (Q : Submodule ℝ (Euclid P)) (c' : ℝ), Module.finrank ℝ Q = n → c ≤ c' → (∀ x, dens μ x = Set.indicator (Q : Set (Euclid P)) (fun _ => c') x) → False) → (∀ μ ∈ 𝓜, {x | x ∈ ball (0 : Euclid P) 1 ∧ c ≤ dens μ x} = ∅) ∨ ∃ d : ℕ, d + 1 ≤ n ∧ (∀ μ ∈ 𝓜, ∀ α : ℝ, 0 < α → μH[(d : ℝ) + α] {x | x ∈ ball (0 : Euclid P) 1 ∧ c ≤ dens μ x} = 0) ∧ (d = 0 → ∀ μ ∈ 𝓜, ∀ σ : ℝ, σ < 1 → {x | x ∈ ball (0 : Euclid P) σ ∧ c ≤ dens μ x}.Finite) ∧ ∃ ν ∈ 𝓜, ν univ = ∞ ∧ ∃ L : Submodule ℝ (Euclid P), Module.finrank ℝ L = d ∧ {x | c ≤ dens ν x} = (L : Set (Euclid P)) ∧ ∀ y ∈ L, ∀ lam : ℝ, 0 < lam → ∀ x, dens ν (y + lam • x) = dens ν x := by
  intro hADR P n c Λ 𝓜 dens hn hc hdens hfin hrep hres hblow hmono hflat
  -- `e = e₁ ∈ ℝ¹`, `φ_μ = dens μ • e`, `F = {φ_μ : μ ∈ 𝓜}`, `sing φ = closure {c ≤ ⟨φ, e⟩}`
  obtain ⟨e, he0⟩ : ∃ e : Euclid 1, e 0 = 1 := ⟨EuclideanSpace.single 0 1, by simp⟩
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : Measure (Euclid P) → Euclid P → Euclid 1,
      ∀ μ, Φ μ = fun x => dens μ x • e := ⟨_, fun _ => rfl⟩
  obtain ⟨F, hF⟩ : ∃ F : Set (Euclid P → Euclid 1), F = Φ '' 𝓜 := ⟨_, rfl⟩
  obtain ⟨sing, hsing⟩ : ∃ sing : (Euclid P → Euclid 1) → Set (Euclid P),
      ∀ ψ, sing ψ = closure {x | c ≤ ψ x 0} := ⟨_, fun _ => rfl⟩
  have hΦ0 : ∀ μ x, Φ μ x 0 = dens μ x := fun μ x => by
    rw [hΦ, PiLp.smul_apply, he0, smul_eq_mul, mul_one]
  have hΦF : ∀ μ ∈ 𝓜, Φ μ ∈ F := fun μ hμ => by
    rw [hF]
    exact mem_image_of_mem Φ hμ
  have hsingΦ : ∀ μ, sing (Φ μ) = closure {x | c ≤ dens μ x} := fun μ => by
    rw [hsing]
    simp only [hΦ0]
  -- Step 1: `dens μ` is Borel and nonnegative
  have hmeas : ∀ μ, Measurable (dens μ) := fun μ => by
    rw [show dens μ = _ from funext (hdens μ)]
    exact Submission.idtp_fons_cr_density_measurable P n μ
  have hnn : ∀ μ x, 0 ≤ dens μ x := fun μ x => by
    rw [hdens]
    exact ENNReal.toReal_nonneg
  -- Step 2: `dens μ^{y,λ} = dens μ (y + λ ·)`
  have hdres : ∀ (μ : Measure (Euclid P)) (y : Euclid P) (lam : ℝ), 0 < lam → ∀ x,
      dens (ENNReal.ofReal (lam⁻¹ ^ n) • μ.map (dilation y lam)) x = dens μ (y + lam • x) := by
    intro μ y lam hlam x
    rw [hdens, hdens, (Submission.idtp_fons_cr_density_rescale P n μ y lam hlam).1 x]
  -- Step 4: normalized pairings `∫ f φ_μ dμH[n] = (c₀ ∫ f dμ) e`, and local integrability
  obtain ⟨c₀, hc₀, hnorm⟩ := Submission.idtp_fons_cr_density_normalization P n
  have hint : ∀ μ ∈ 𝓜, ∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f →
      ∫ x, f x • Φ μ x ∂μH[(n : ℝ)] = (c₀ * ∫ x, f x ∂μ) • e := by
    intro μ hμ f hf hfc
    rw [hΦ]
    exact (hnorm 1 μ (dens μ) e (hmeas μ) (hnn μ) (hfin μ hμ) (hrep μ hμ)).2 f hf hfc
  -- Step 6: upper semicontinuity on `B₂(0)`, by the threshold limit along a constant sequence
  have husc : ∀ μ ∈ 𝓜, ∀ x : Euclid P, ‖x‖ < 2 → x ∈ closure {z | c ≤ dens μ z} →
      c ≤ dens μ x := by
    intro μ hμ x hx hcl
    obtain ⟨xs, hxs, hlim⟩ := mem_closure_iff_seq_limit.1 hcl
    rw [hdens]
    exact Submission.dimred_tr_mcr_threshold_limit P n Λ c μ (fun _ => μ) xs x (hfin μ hμ)
      (fun _ => hfin μ hμ) (hmono μ hμ) (fun _ => hmono μ hμ) (fun _ _ _ => tendsto_const_nhds)
      hlim hx fun j => by
        have h : c ≤ dens μ (xs j) := hxs j
        rw [hdens] at h
        exact h
  -- Step 7: the hypotheses of (ADR) for `(P, n, 1, F, sing)`
  -- (H0)
  have hH0 : ∀ φ ∈ F, ∀ ψ ∈ F, (∀ᵐ x ∂μH[(n : ℝ)], φ x = ψ x) → φ = ψ := by
    intro φ hφ ψ hψ hae
    rw [hF] at hφ hψ
    obtain ⟨μ, hμ, rfl⟩ := hφ
    obtain ⟨ν, hν, rfl⟩ := hψ
    have hae' : ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)),
        ENNReal.ofReal (dens μ x) = ENNReal.ofReal (dens ν x) := by
      rw [Measure.euclideanHausdorffMeasure_def]
      refine Measure.ae_smul_measure (hae.mono fun x hx => ?_) _
      rw [← hΦ0 μ x, ← hΦ0 ν x, hx]
    have hμν : μ = ν := by
      rw [hrep μ hμ, hrep ν hν]
      exact withDensity_congr_ae hae'
    rw [hμν]
  -- (Loc)
  have hLoc : ∀ φ ∈ F, LocallyIntegrable φ μH[(n : ℝ)] := by
    intro φ hφ
    rw [hF] at hφ
    obtain ⟨μ, hμ, rfl⟩ := hφ
    rw [hΦ]
    exact (hnorm 1 μ (dens μ) e (hmeas μ) (hnn μ) (hfin μ hμ) (hrep μ hμ)).1
  -- (A.1)
  have hA1 : ∀ φ ∈ F, ∀ (y : Euclid P) (lam : ℝ), 0 < lam → lam < 1 → ‖y‖ ≤ 1 - lam →
      (fun x => φ (y + lam • x)) ∈ F := by
    intro φ hφ y lam hlam hlam1 hy
    rw [hF] at hφ
    obtain ⟨μ, hμ, rfl⟩ := hφ
    convert hΦF _ (hres μ hμ y lam hlam hlam1 hy) using 1
    funext x
    simp only [hΦ]
    rw [hdres μ y lam hlam x]
  -- (A.2)
  have hA2 : ∀ φ ∈ F, ∀ y : Euclid P, ‖y‖ < 1 → ∀ lams : ℕ → ℝ, (∀ k, 0 < lams k) →
      StrictAnti lams → Tendsto lams atTop (𝓝 0) →
      ∃ (sub : ℕ → ℕ) (ψ : Euclid P → Euclid 1), StrictMono sub ∧ ψ ∈ F ∧
        (∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f →
          Tendsto (fun k => ∫ x, f x • φ (y + lams (sub k) • x) ∂μH[(n : ℝ)]) atTop
            (𝓝 (∫ x, f x • ψ x ∂μH[(n : ℝ)]))) ∧
        ∀ lam : ℝ, 0 < lam → ∀ x, ψ (lam • x) = ψ x := by
    intro φ hφ y hy lams hpos hanti hlim
    rw [hF] at hφ
    obtain ⟨μ, hμ, rfl⟩ := hφ
    obtain ⟨sub, ν, hsub, hν, hhom, hconv⟩ := hblow μ hμ y hy lams hpos hanti hlim
    refine ⟨sub, Φ ν, hsub, hΦF ν hν, fun f hf hfc => ?_, fun lam hlam x => ?_⟩
    · -- for large `k`, `λ_{sub k} < 1 − |y|`, so `μ^{y,λ_{sub k}} ∈ 𝓜` and step 4 applies
      have hev : ∀ᶠ k in atTop, lams (sub k) < 1 - ‖y‖ :=
        (hlim.comp hsub.tendsto_atTop).eventually (gt_mem_nhds (sub_pos.2 hy))
      have heq : ∀ᶠ k in atTop, (c₀ * ∫ x, f x ∂(ENNReal.ofReal ((lams (sub k))⁻¹ ^ n) •
          μ.map (dilation y (lams (sub k))))) • e =
            ∫ x, f x • Φ μ (y + lams (sub k) • x) ∂μH[(n : ℝ)] := by
        filter_upwards [hev] with k hk
        have hk0 := hpos (sub k)
        have hmem := hres μ hμ y (lams (sub k)) hk0 (by linarith [norm_nonneg y]) (by linarith)
        rw [← hint _ hmem f hf hfc]
        refine integral_congr_ae (ae_of_all _ fun x => ?_)
        simp only [hΦ]
        rw [hdres μ y _ hk0 x]
      rw [hint ν hν f hf hfc]
      exact ((tendsto_const_nhds.mul (hconv f hf hfc)).smul_const e).congr' heq
    · -- step 3: a homogeneous `ν` has dilation-invariant density
      rw [hΦ]
      show dens ν (lam • x) • e = dens ν x • e
      rw [hdens, hdens, Submission.idtp_fons_cc_tm_density_homogeneous P n ν hhom lam hlam x]
  -- (A.3): closedness
  have hclosed : ∀ φ ∈ F, IsClosed (sing φ) := fun φ _ => by
    rw [hsing]
    exact isClosed_closure
  -- (A.3)(1): a flat `φ_μ = 1_L c''` has empty singular set
  have hplane : ∀ φ ∈ F, ∀ (L : Submodule ℝ (Euclid P)) (c'' : Euclid 1),
      Module.finrank ℝ L = n → φ = Set.indicator (L : Set (Euclid P)) (fun _ => c'') →
        sing φ = ∅ := by
    intro φ hφ L c'' hL hφL
    rw [hF] at hφ
    obtain ⟨μ, hμ, rfl⟩ := hφ
    have hind : ∀ x, dens μ x = Set.indicator (L : Set (Euclid P)) (fun _ => c'' 0) x := by
      intro x
      rw [← hΦ0 μ x, hφL]
      by_cases hx : x ∈ (L : Set (Euclid P))
      · rw [Set.indicator_of_mem hx, Set.indicator_of_mem hx]
      · rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem hx, PiLp.zero_apply]
    rw [hsingΦ]
    by_cases hcc : c ≤ c'' 0
    · -- `c'' 0 ≥ c`: `μ` would be an infinite flat measure, excluded by (6)
      exfalso
      have hinv : ∀ t : ℝ, 0 < t → ∀ x, dens μ (t • x) = dens μ x := by
        intro t ht x
        rw [hind, hind]
        by_cases hx : x ∈ (L : Set (Euclid P))
        · rw [Set.indicator_of_mem (L.smul_mem t hx), Set.indicator_of_mem hx]
        · have htx : t • x ∉ (L : Set (Euclid P)) := fun h => hx ((L.smul_mem_iff ht.ne').1 h)
          rw [Set.indicator_of_notMem htx, Set.indicator_of_notMem hx]
      have h0 : 0 < dens μ 0 := by
        rw [hind, Set.indicator_of_mem (L.zero_mem : (0 : Euclid P) ∈ (L : Set (Euclid P)))]
        exact lt_of_lt_of_le hc hcc
      have hinf : μ univ = ∞ := Submission.dimred_tr_mcr_homogeneous_infinite_mass P n μ (dens μ) 0
        hn (hdens μ) (hrep μ hμ) hinv h0
      exact hflat μ hμ hinf L (c'' 0) hL hcc hind
    · -- `c'' 0 < c`: the superlevel set `{c ≤ dens μ}` is empty
      have hE : {x | c ≤ dens μ x} = (∅ : Set (Euclid P)) := by
        refine eq_empty_of_forall_notMem fun x hx => ?_
        change c ≤ dens μ x at hx
        rw [hind] at hx
        by_cases hxL : x ∈ (L : Set (Euclid P))
        · rw [Set.indicator_of_mem hxL] at hx
          exact hcc hx
        · rw [Set.indicator_of_notMem hxL] at hx
          exact absurd hx (not_le.2 hc)
      rw [hE, closure_empty]
  -- (A.3)(2): `w ↦ y + λw` is a homeomorphism
  have hA32 : ∀ φ ∈ F, ∀ (y : Euclid P) (lam : ℝ), 0 < lam → lam < 1 → ‖y‖ ≤ 1 - lam →
      sing (fun x => φ (y + lam • x)) = (fun x => y + lam • x) ⁻¹' sing φ := by
    intro φ _ y lam hlam _ _
    rw [hsing, hsing]
    exact (((Homeomorph.smulOfNeZero lam hlam.ne').trans (Homeomorph.addLeft y)).preimage_closure
      {x | c ≤ φ x 0}).symm
  -- (A.3)(3): limits of singular points of `φ_{μ_k}` are singular points of `φ_μ`
  have hA33 : ∀ φ ∈ F, ∀ φs : ℕ → Euclid P → Euclid 1, (∀ k, φs k ∈ F) →
      (∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f →
        Tendsto (fun k => ∫ x, f x • φs k x ∂μH[(n : ℝ)]) atTop
          (𝓝 (∫ x, f x • φ x ∂μH[(n : ℝ)]))) →
      ∀ ε : ℝ, 0 < ε → ∃ k₀ : ℕ, ∀ k ≥ k₀,
        ball (0 : Euclid P) 1 ∩ sing (φs k) ⊆ {x | ∃ z ∈ sing φ, dist x z < ε} := by
    intro φ hφ φs hφs hconv
    rw [hF] at hφ
    obtain ⟨μ, hμ, rfl⟩ := hφ
    simp only [hF, mem_image] at hφs
    choose μs hμs hμsφ using hφs
    obtain rfl : φs = fun k => Φ (μs k) := funext fun k => (hμsφ k).symm
    -- step 4: weak convergence of the `φ_{μ_k}` is vague convergence of the `μ_k`
    have hvague : ∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f →
        Tendsto (fun k => ∫ x, f x ∂(μs k)) atTop (𝓝 (∫ x, f x ∂μ)) := by
      intro f hf hfc
      have h := hconv f hf hfc
      simp only [hint _ (hμs _) f hf hfc, hint μ hμ f hf hfc] at h
      have h0 := ((PiLp.continuous_apply 2 (fun _ : Fin 1 => ℝ) 0).tendsto _).comp h
      simp only [Function.comp_def, PiLp.smul_apply, he0, smul_eq_mul, mul_one] at h0
      have h2 := h0.const_mul c₀⁻¹
      simp only [← mul_assoc, inv_mul_cancel₀ hc₀.ne', one_mul] at h2
      exact h2
    refine Submission.dimred_tr_mcr_eventually_near P (sing (Φ μ)) (fun k => sing (Φ (μs k)))
      ?_
    intro sub z x hsub hz hzx
    -- each `z k` lies in `B₁(0) ∩ closure {c ≤ dens μ_{sub k}}`, so `c ≤ dens μ_{sub k} (z k)`
    have hzk : ∀ k, c ≤ dens (μs (sub k)) (z k) := by
      intro k
      obtain ⟨hzb, hzs⟩ := hz k
      change z k ∈ sing (Φ (μs (sub k))) at hzs
      rw [hsingΦ] at hzs
      refine husc _ (hμs _) (z k) ?_ hzs
      have := mem_ball_zero_iff.1 hzb
      linarith
    have hx1 : ‖x‖ ≤ 1 := by
      have : x ∈ closedBall (0 : Euclid P) 1 := isClosed_closedBall.mem_of_tendsto hzx
        (Eventually.of_forall fun k => ball_subset_closedBall (hz k).1)
      exact mem_closedBall_zero_iff.1 this
    -- the threshold limit along the subsequence gives `c ≤ dens μ x`
    have hcx : c ≤ dens μ x := by
      rw [hdens]
      exact Submission.dimred_tr_mcr_threshold_limit P n Λ c μ (fun k => μs (sub k)) z x
        (hfin μ hμ) (fun k => hfin _ (hμs (sub k))) (hmono μ hμ) (fun k => hmono _ (hμs (sub k)))
        (fun f hf hfc => (hvague f hf hfc).comp hsub.tendsto_atTop) hzx (by linarith)
        fun k => by
          have h := hzk k
          rw [hdens] at h
          exact h
    rw [hsingΦ]
    exact subset_closure hcx
  -- Step 8: apply (ADR)
  have hsub : ∀ μ ∈ 𝓜, ∀ σ : ℝ,
      {x | x ∈ ball (0 : Euclid P) σ ∧ c ≤ dens μ x} ⊆ sing (Φ μ) ∩ ball (0 : Euclid P) σ := by
    intro μ _ σ x hx
    rw [hsingΦ]
    exact ⟨subset_closure hx.2, hx.1⟩
  rcases hADR P n 1 F sing hH0 hLoc hA1 hA2 hclosed hplane hA32 hA33 with
    hI | ⟨d, hd, hnull, ⟨ψ, hψ, L, hL, hsingψ, hinvψ⟩, hfin0⟩
  · -- (I)
    refine Or.inl fun μ hμ => subset_eq_empty (hsub μ hμ 1) ?_
    rw [inter_comm]
    exact hI _ (hΦF μ hμ)
  · -- (II)
    rw [hF] at hψ
    obtain ⟨ν, hν, rfl⟩ := hψ
    have hinvν : ∀ y ∈ L, ∀ lam : ℝ, 0 < lam → ∀ x, dens ν (y + lam • x) = dens ν x := by
      intro y hy lam hlam x
      rw [← hΦ0 ν, ← hΦ0 ν, hinvψ y hy lam hlam x]
    -- `dens ν` is constant on `L`
    have hconst : ∀ y ∈ L, dens ν y = dens ν 0 := by
      intro y hy
      have h := hinvν y hy 1 one_pos 0
      rwa [smul_zero, add_zero] at h
    -- `E = {c ≤ dens ν}` has closure `L`, hence is a nonempty subset of `L`, hence equals `L`
    have hclE : closure {x | c ≤ dens ν x} = (L : Set (Euclid P)) := by
      rw [← hsingΦ, hsingψ]
    have hEL : {x | c ≤ dens ν x} ⊆ (L : Set (Euclid P)) := hclE ▸ subset_closure
    obtain ⟨x₀, hx₀⟩ : ({x | c ≤ dens ν x} : Set (Euclid P)).Nonempty := by
      rw [nonempty_iff_ne_empty]
      intro hne
      rw [hne, closure_empty] at hclE
      have h0 : (0 : Euclid P) ∈ (L : Set (Euclid P)) := L.zero_mem
      rw [← hclE] at h0
      exact h0
    have hc0 : c ≤ dens ν 0 := by
      rw [← hconst x₀ (hEL hx₀)]
      exact hx₀
    have hE : {x | c ≤ dens ν x} = (L : Set (Euclid P)) := by
      refine Subset.antisymm hEL fun y hy => ?_
      show c ≤ dens ν y
      rw [hconst y hy]
      exact hc0
    -- `ν` is nonzero and `n`-homogeneous, so `ν(ℝᴾ) = ∞`
    have hνinf : ν univ = ∞ := by
      refine Submission.dimred_tr_mcr_homogeneous_infinite_mass P n ν (dens ν) 0 hn (hdens ν)
        (hrep ν hν) (fun t ht x => ?_) (lt_of_lt_of_le hc hc0)
      have h := hinvν 0 L.zero_mem t ht x
      rwa [zero_add] at h
    refine Or.inr ⟨d, hd, fun μ hμ α hα => ?_, fun hd0 μ hμ σ hσ => ?_, ν, hν, hνinf, L, hL, hE,
      hinvν⟩
    · exact measure_mono_null (hsub μ hμ 1) (hnull _ (hΦF μ hμ) α hα)
    · exact (hfin0 hd0 _ (hΦF μ hμ) σ hσ).subset (hsub μ hμ σ)

/-- **Nested sets of finite perimeter** (Simon Ch. 6, proof of 3.14, (8)–(9), and Remark 3.15;
Ch. 3, 4.3(‡)).  Let `n ≥ 1`, `U_{j+1} ⊆ U_j` Borel in `ℝ^{n+1}`, `X_j = [[U_j]]` with
`M(∂X_j) < ∞`, `T = Σⱼ ∂X_j` weakly, and `M(Σ_{|j| ≤ N} ∂X_j) ≤ C < ∞` for every `N`.  Then `T` is
integer multiplicity.
* `∂X_j(⋆φ) = ∫_{U_j} div φ`, so `U_j` has finite perimeter, and De Giorgi gives `B_j`, `ν_j` with
  `∂X_j(η) = ∫_{B_j} ξ_{ν_j}(η) dHⁿ`, where `ξ_v(α) = -⟨φ_α, v⟩` is a unit orientation of `v^⊥`
  (normal_orientation).
* Nested sets have nested half-space blow-ups, so `ν_j = ν_k` a.e. on `B_j ∩ B_k`, and one Borel
  normal `ν` serves every `j`.
* oriented_mass_lower gives `Σ_{|j| ≤ N} Hⁿ(B_j) ≤ M(Σ_{|j| ≤ N} ∂X_j) ≤ C`, so `h = Σⱼ 1_{B_j}`
  is integrable.
* `(⋃ⱼ B_j ∩ {h < ∞}, h, ξ_ν)` is an integer multiplicity representation (tangent planes by
  im_calculus (a)), and dominated convergence for the series shows that it represents `T`. -/
theorem Submission.dtc_bc_lc_fd_bim_nested_im : ∀ (n : ℕ) (U : ℤ → Set (Euclid (n + 1))) (X : ℤ → GeometricCurrentOn (univ : Set (Euclid (n + 1))) (n + 1)) (T : GeometricCurrentOn (univ : Set (Euclid (n + 1))) n) (C : ℝ≥0∞), 1 ≤ n → (∀ j, MeasurableSet (U j)) → (∀ j, U (j + 1) ⊆ U j) → (∀ (j : ℤ) (ω : TestFormOn (univ : Set (Euclid (n + 1))) (n + 1)), X j ω = ∫ x in U j, (ω : DifferentialForm (Euclid (n + 1)) (n + 1)) x (fun i => EuclideanSpace.single i (1 : ℝ))) → (∀ j, (X j).boundary.mass < ∞) → (∀ η : TestFormOn (univ : Set (Euclid (n + 1))) n, HasSum (fun j => (X j).boundary η) (T η)) → C < ∞ → (∀ (N : ℕ) (Y : GeometricCurrentOn (univ : Set (Euclid (n + 1))) n), (∀ η : TestFormOn (univ : Set (Euclid (n + 1))) n, Y η = ∑ j ∈ Finset.Icc (-(N : ℤ)) N, (X j).boundary η) → Y.mass ≤ C) → IsIntegerMultiplicity T := by
  intro n U X T C hn hUm hUsucc hX hXmass hT hC hYC
  classical
  /- Hodge correspondence on `ℝ^{n+1}`.  For an `n`-covector `α`, `φ_α = Σᵢ (-1)ⁱ α_î eᵢ` with
  `α_î = α(e ∘ i.succAbove)`; for a vector `v`, `ξ_v(α) = -⟨φ_α, v⟩`. -/
  let hodge : Covector (Euclid (n + 1)) n →L[ℝ] Euclid (n + 1) :=
    ∑ i : Fin (n + 1), ((-1 : ℝ) ^ (i : ℕ)) • (ContinuousAlternatingMap.apply ℝ (Euclid (n + 1)) ℝ
      (fun k => EuclideanSpace.single (i.succAbove k) (1 : ℝ))).smulRight
        (EuclideanSpace.single i (1 : ℝ))
  have hodge_apply : ∀ α : Covector (Euclid (n + 1)) n, hodge α = ∑ i : Fin (n + 1),
      ((-1 : ℝ) ^ (i : ℕ) * α (fun k => EuclideanSpace.single (i.succAbove k) (1 : ℝ))) •
        EuclideanSpace.single i (1 : ℝ) := by
    intro α
    simp [hodge, smul_smul]
  have hodge_coord : ∀ (α : Covector (Euclid (n + 1)) n) (i : Fin (n + 1)), hodge α i =
      (-1 : ℝ) ^ (i : ℕ) * α (fun k => EuclideanSpace.single (i.succAbove k) (1 : ℝ)) := by
    intro α i
    rw [hodge_apply]
    simp [Pi.single_apply]
  clear_value hodge
  let Ξ : Euclid (n + 1) →L[ℝ] MultiVector (n + 1) n := LinearMap.toContinuousLinearMap
    { toFun := fun v => -((innerSL ℝ v).comp hodge)
      map_add' := fun v w => by ext α; simp; ring
      map_smul' := fun c v => by ext α; simp }
  have Ξ_apply : ∀ (v : Euclid (n + 1)) (α : Covector (Euclid (n + 1)) n),
      Ξ v α = -inner ℝ (hodge α) v := by
    intro v α
    simp [Ξ, real_inner_comm]
  clear_value Ξ
  -- `ξ_v = σ₁ ∧ ⋯ ∧ σₙ` for an orthonormal basis `σ` of `v^⊥` (normal_orientation)
  have Ξ_orient : ∀ v : Euclid (n + 1), ‖v‖ = 1 →
      IsUnitOrientationOf (Ξ v) (Submodule.span ℝ {v})ᗮ := by
    intro v hv
    obtain ⟨σ, hσ, hspan, hβ⟩ := Submission.codim1_lur_normal_covector_orientation n v hn hv
    refine ⟨σ, hσ, hspan, Or.inl fun α => ?_⟩
    rw [Ξ_apply, hβ α, hodge_apply, sum_inner]
    simp only [real_inner_smul_left]
  -- (S3) `dη(x)(e₀, …, eₙ) = div φ_η(x)`
  have hS3 : ∀ (η : DifferentialForm (Euclid (n + 1)) n) (x : Euclid (n + 1)),
      DifferentiableAt ℝ η x →
      exteriorDerivative η x (fun i => EuclideanSpace.single i (1 : ℝ)) =
        LinearMap.trace ℝ (Euclid (n + 1))
          (fderiv ℝ (fun y => hodge (η y)) x : Euclid (n + 1) →ₗ[ℝ] Euclid (n + 1)) := by
    intro η x hηx
    have hfd : fderiv ℝ (fun y => hodge (η y)) x = hodge.comp (fderiv ℝ η x) :=
      (hodge.hasFDerivAt.comp x hηx.hasFDerivAt).fderiv
    rw [hfd, LinearMap.trace_eq_matrix_trace ℝ (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis,
      Matrix.trace]
    simp only [LinearMap.toMatrix_apply, OrthonormalBasis.coe_toBasis,
      EuclideanSpace.basisFun_apply, OrthonormalBasis.coe_toBasis_repr_apply,
      EuclideanSpace.basisFun_repr, ContinuousLinearMap.coe_coe, ContinuousLinearMap.comp_apply,
      Matrix.diag_apply]
    simp only [hodge_coord]
    rw [exteriorDerivative, extDeriv, ContinuousAlternatingMap.alternatizeUncurryFin_apply]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [zsmul_eq_mul, Int.cast_pow, Int.cast_neg, Int.cast_one]
    rfl
  /- (S1) `⋆w = det[w, ·]` has `(⋆w)_m̂ = (-1)ᵐ wₘ`, so `φ_{⋆w} = w`. -/
  set b : Module.Basis (Fin (n + 1)) ℝ (Euclid (n + 1)) :=
    (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis with hb_def
  have hb : ∀ j, b j = EuclideanSpace.single j (1 : ℝ) := fun j => by
    rw [hb_def, OrthonormalBasis.coe_toBasis, EuclideanSpace.basisFun_apply]
  have hbrepr : ∀ (w : Euclid (n + 1)) (j : Fin (n + 1)), b.repr w j = w j := fun w j => by
    rw [hb_def, OrthonormalBasis.coe_toBasis_repr_apply, EuclideanSpace.basisFun_repr]
  have hDcont : Continuous fun v : Fin (n + 1) → Euclid (n + 1) => b.det v := by
    simp only [Module.Basis.det_apply]
    refine Continuous.matrix_det (continuous_pi fun i => continuous_pi fun j => ?_)
    simp only [Module.Basis.toMatrix_apply, hbrepr]
    exact (EuclideanSpace.proj i).continuous.comp (continuous_apply j)
  let D : Euclid (n + 1) [⋀^Fin (n + 1)]→L[ℝ] ℝ := { b.det with cont := hDcont }
  let star : Euclid (n + 1) →L[ℝ] Covector (Euclid (n + 1)) n := D.curryLeft
  have hcol : ∀ j m : Fin (n + 1), b.det.curryLeft (b j) (fun k => b (m.succAbove k)) =
      if j = m then (-1 : ℝ) ^ (m : ℕ) else 0 := by
    intro j m
    rw [AlternatingMap.curryLeft_apply_apply]
    split_ifs with hjm
    · subst hjm
      have hcyc : (Matrix.vecCons (b j) fun k => b (j.succAbove k)) = b ∘ ⇑j.cycleRange.symm := by
        funext i
        refine Fin.cases ?_ (fun k => ?_) i <;> simp
      rw [hcyc, AlternatingMap.map_perm, Module.Basis.det_self, Equiv.Perm.sign_symm,
        Fin.sign_cycleRange]
      simp [Units.smul_def]
    · obtain ⟨l, hl⟩ := Fin.exists_succAbove_eq hjm
      refine AlternatingMap.map_eq_zero_of_eq _ _ (i := 0) (j := l.succ) ?_
        (Fin.succ_ne_zero l).symm
      simp [hl]
  have hsumap : ∀ (g : Fin (n + 1) → Euclid (n + 1) [⋀^Fin n]→ₗ[ℝ] ℝ) (v : Fin n → Euclid (n + 1)),
      (∑ j, g j) v = ∑ j, g j v := fun g v =>
    map_sum (AddMonoidHom.mk' (fun f : Euclid (n + 1) [⋀^Fin n]→ₗ[ℝ] ℝ => f v) fun _ _ => rfl) g
      Finset.univ
  have hS1 : ∀ (w : Euclid (n + 1)) (m : Fin (n + 1)),
      star w (fun k => EuclideanSpace.single (m.succAbove k) (1 : ℝ)) =
        (-1 : ℝ) ^ (m : ℕ) * w m := by
    intro w m
    have h1 : star w (fun k => EuclideanSpace.single (m.succAbove k) (1 : ℝ)) =
        b.det.curryLeft w (fun k => b (m.succAbove k)) := by
      simp only [hb]
      rfl
    rw [h1]
    conv_lhs => rw [← b.sum_repr w]
    rw [map_sum, hsumap]
    simp only [map_smul, AlternatingMap.smul_apply, hcol, smul_eq_mul, mul_ite, mul_zero,
      Finset.sum_ite_eq', Finset.mem_univ, ite_true, hbrepr]
    ring
  have hodge_star : ∀ w : Euclid (n + 1), hodge (star w) = w := by
    intro w
    ext i
    rw [hodge_coord, hS1, ← mul_assoc, ← pow_add, ← two_mul, pow_mul, neg_one_sq, one_pow, one_mul]
  clear_value star D
  /- Step 1 (finite perimeter).  The Euclidean coefficient norm has `|cα| = |c| |α|` and
  `|α| ≤ √L ‖α‖` (each of its `L` coefficients is at most the operator norm), so
  `|⋆w| ≤ (K - 1)|w|`; for smooth compactly supported `|φ| ≤ 1` the test form `K⁻¹ ⋆φ` is
  admissible and `K⁻¹ ∫_{U_j} div φ = ∂X_j(K⁻¹ ⋆φ) ≤ M(∂X_j)`. -/
  have hcen_smul : ∀ (c : ℝ) (α : Covector (Euclid (n + 1)) n),
      covectorEuclideanNorm (c • α) = |c| * covectorEuclideanNorm α := by
    intro c α
    simp only [covectorEuclideanNorm, ContinuousAlternatingMap.smul_apply, smul_eq_mul, mul_pow]
    rw [← Real.sqrt_sq_eq_abs, ← Real.sqrt_mul (sq_nonneg c), Finset.mul_sum]
    refine congrArg Real.sqrt (Finset.sum_congr rfl fun I _ => ?_)
    split_ifs <;> simp
  have hcen_le : ∀ α : Covector (Euclid (n + 1)) n, covectorEuclideanNorm α ≤
      Real.sqrt (Fintype.card (Fin n → Fin (n + 1))) * ‖α‖ := by
    intro α
    rw [covectorEuclideanNorm, ← Real.sqrt_sq (norm_nonneg α),
      ← Real.sqrt_mul (Nat.cast_nonneg _)]
    refine Real.sqrt_le_sqrt ?_
    rw [← nsmul_eq_mul, ← Finset.card_univ, ← Finset.sum_const]
    refine Finset.sum_le_sum fun I _ => ?_
    split_ifs
    · have h1 := α.le_opNorm fun i => EuclideanSpace.basisFun (Fin (n + 1)) ℝ (I i)
      simp only [(EuclideanSpace.basisFun (Fin (n + 1)) ℝ).orthonormal.1, Finset.prod_const_one,
        mul_one, Real.norm_eq_abs] at h1
      exact sq_le_sq' (neg_le_of_abs_le h1) (le_of_abs_le h1)
    · positivity
  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = Real.sqrt (Fintype.card (Fin n → Fin (n + 1))) * ‖star‖ + 1 :=
    ⟨_, rfl⟩
  have hK0 : 0 < K := by
    rw [hK]
    positivity
  have hdiv : ∀ j : ℤ, ∀ φ : Euclid (n + 1) → Euclid (n + 1), ContDiff ℝ (⊤ : ℕ∞) φ →
      HasCompactSupport φ → (∀ y, ‖φ y‖ ≤ 1) →
      ∫ y in U j, LinearMap.trace ℝ (Euclid (n + 1))
        (fderiv ℝ φ y : Euclid (n + 1) →ₗ[ℝ] Euclid (n + 1)) ≤
          K * ((X j).boundary.mass).toReal := by
    intro j φ hφ hφc hφ1
    let ω0 : DifferentialForm (Euclid (n + 1)) n := fun y => K⁻¹ • star (φ y)
    have hω0s : ContDiff ℝ (⊤ : ℕ∞) ω0 := (star.contDiff.comp hφ).const_smul K⁻¹
    have hω0c : HasCompactSupport ω0 :=
      (hφc.comp_left star.map_zero).comp_left (g := fun α => K⁻¹ • α) (smul_zero _)
    let ω : TestFormOn (univ : Set (Euclid (n + 1))) n := ⟨ω0, ⟨hω0s, hω0c⟩, subset_univ _⟩
    have hω1 : ∀ y, covectorEuclideanNorm (ω0 y) ≤ 1 := by
      intro y
      have hL : 0 ≤ Real.sqrt (Fintype.card (Fin n → Fin (n + 1))) := Real.sqrt_nonneg _
      have hle : Real.sqrt (Fintype.card (Fin n → Fin (n + 1))) * ‖star (φ y)‖ ≤ K := by
        rw [hK]
        nlinarith [mul_le_mul_of_nonneg_left (star.le_opNorm (φ y)) hL,
          mul_le_mul_of_nonneg_left (hφ1 y) (mul_nonneg hL (norm_nonneg star))]
      calc covectorEuclideanNorm (ω0 y) = K⁻¹ * covectorEuclideanNorm (star (φ y)) := by
            rw [show ω0 y = K⁻¹ • star (φ y) from rfl, hcen_smul, abs_of_pos (inv_pos.mpr hK0)]
        _ ≤ K⁻¹ * (Real.sqrt (Fintype.card (Fin n → Fin (n + 1))) * ‖star (φ y)‖) :=
            mul_le_mul_of_nonneg_left (hcen_le _) (inv_nonneg.mpr hK0.le)
        _ ≤ K⁻¹ * K := mul_le_mul_of_nonneg_left hle (inv_nonneg.mpr hK0.le)
        _ = 1 := inv_mul_cancel₀ hK0.ne'
    have hle := (X j).boundary.le_massOn (W := univ) (omega := ω) ⟨subset_univ _, hω1⟩
    have hle' : (X j).boundary ω ≤ ((X j).boundary.mass).toReal :=
      (ENNReal.ofReal_le_iff_le_toReal (hXmass j).ne).mp hle
    have hval : (X j).boundary ω = K⁻¹ * ∫ y in U j, LinearMap.trace ℝ (Euclid (n + 1))
        (fderiv ℝ φ y : Euclid (n + 1) →ₗ[ℝ] Euclid (n + 1)) := by
      rw [GeometricCurrentOn.boundary_apply, hX, ← integral_const_mul]
      refine integral_congr_ae (ae_of_all _ fun x => ?_)
      change exteriorDerivative ω0 x (fun i => EuclideanSpace.single i (1 : ℝ)) = _
      rw [hS3 ω0 x (hω0s.differentiable (by simp)).differentiableAt]
      have hfun : (fun y => hodge (ω0 y)) = fun y => K⁻¹ • φ y :=
        funext fun y => by simp [ω0, hodge_star]
      rw [hfun, fderiv_fun_const_smul (hφ.differentiable (by simp)).differentiableAt,
        ContinuousLinearMap.toLinearMap_smul, map_smul, smul_eq_mul]
    rw [hval] at hle'
    exact (inv_mul_le_iff₀ hK0).mp hle'
  /- Step 2 (De Giorgi): `B_j`, `ν_j` for each `U_j`. -/
  choose B ν' hBm hBrect hBfin hν'm hν'1 hν'tan hGG hblow using fun j : ℤ =>
    Submission.dtc_bc_lc_fd_bim_de_giorgi n (U j) (K * ((X j).boundary.mass).toReal) hn (hUm j)
      (hdiv j)
  /- Step 3: `∂X_j(η) = X_j(dη) = ∫_{U_j} div φ_η = -∫_{B_j} ⟨φ_η, ν_j⟩ dHⁿ`. -/
  have hbd : ∀ (j : ℤ) (η : TestFormOn (univ : Set (Euclid (n + 1))) n),
      (X j).boundary η =
        ∫ y in B j, Ξ (ν' j y) ((η : DifferentialForm (Euclid (n + 1)) n) y) ∂μHE[n] := by
    intro j η
    have hηs : ContDiff ℝ (⊤ : ℕ∞) (η : DifferentialForm (Euclid (n + 1)) n) := η.property.1.1
    have hηc : HasCompactSupport (η : DifferentialForm (Euclid (n + 1)) n) := η.property.1.2
    rw [GeometricCurrentOn.boundary_apply, hX]
    have hint : ∫ x in U j, ((exteriorDerivativeTestOn univ n η :
        TestFormOn (univ : Set (Euclid (n + 1))) (n + 1)) :
          DifferentialForm (Euclid (n + 1)) (n + 1)) x (fun i => EuclideanSpace.single i (1 : ℝ)) =
        ∫ x in U j, LinearMap.trace ℝ (Euclid (n + 1)) (fderiv ℝ
          (fun y => hodge ((η : DifferentialForm (Euclid (n + 1)) n) y)) x :
            Euclid (n + 1) →ₗ[ℝ] Euclid (n + 1)) :=
      integral_congr_ae (ae_of_all _ fun x =>
        hS3 _ x (hηs.differentiable (by simp)).differentiableAt)
    rw [hint, hGG j (fun y => hodge ((η : DifferentialForm (Euclid (n + 1)) n) y))
      ((hodge.contDiff.comp hηs).of_le (by simp)) (hηc.comp_left hodge.map_zero), ← integral_neg]
    refine integral_congr_ae (ae_of_all _ fun y => ?_)
    simp only [Ξ_apply]
  /- Step 4 (nested normals; Simon 3.14 with Ch. 3, 4.3(‡)).  If `W ⊆ V` blow up at `y` to the
  half-spaces `{⟨w, c⟩ > 0}` and `{⟨w, a⟩ > 0}`, then `{⟨w, c⟩ > 0} \ {⟨w, a⟩ > 0}` is
  Lebesgue-null in `B₁(0)`; for unit vectors `a ≠ c` it contains a ball around `(c - a)/4`. -/
  have hUanti : Antitone U := antitone_int_of_succ_le hUsucc
  have hgeom : ∀ (V W : Set (Euclid (n + 1))) (a c y : Euclid (n + 1)), W ⊆ V → ‖a‖ = 1 →
      ‖c‖ = 1 →
      Tendsto (fun r : ℝ => volume (symmDiff ((fun w => y + r • w) ⁻¹' V) {w | 0 < inner ℝ w a} ∩
        ball (0 : Euclid (n + 1)) 1)) (𝓝[>] 0) (𝓝 0) →
      Tendsto (fun r : ℝ => volume (symmDiff ((fun w => y + r • w) ⁻¹' W) {w | 0 < inner ℝ w c} ∩
        ball (0 : Euclid (n + 1)) 1)) (𝓝[>] 0) (𝓝 0) → a = c := by
    intro V W a c y hWV ha hc hV hW
    by_contra hac
    set S : Set (Euclid (n + 1)) := {w | 0 < inner ℝ w c} ∩ {w | inner ℝ w a < 0} ∩ ball 0 1
    have hSo : IsOpen S :=
      ((isOpen_lt continuous_const (continuous_id.inner continuous_const)).inter
        (isOpen_lt (continuous_id.inner continuous_const) continuous_const)).inter isOpen_ball
    have hac1 : inner ℝ a c < 1 := by
      have h1 : 0 < ‖a - c‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hac)
      have h2 := norm_sub_sq_real a c
      rw [ha, hc] at h2
      nlinarith
    have hca1 : inner ℝ c a < 1 := by
      rw [real_inner_comm]
      exact hac1
    have hSne : S.Nonempty := by
      refine ⟨(1 / 4 : ℝ) • (c - a), ⟨?_, ?_⟩, ?_⟩
      · show 0 < inner ℝ ((1 / 4 : ℝ) • (c - a)) c
        rw [real_inner_smul_left, inner_sub_left, real_inner_self_eq_norm_sq, hc]
        nlinarith
      · show inner ℝ ((1 / 4 : ℝ) • (c - a)) a < 0
        rw [real_inner_smul_left, inner_sub_left, real_inner_self_eq_norm_sq, ha]
        nlinarith
      · rw [mem_ball_zero_iff, norm_smul]
        have := norm_sub_le c a
        rw [ha, hc] at this
        norm_num
        linarith
    have hSpos : 0 < volume S := hSo.measure_pos volume hSne
    have hle : ∀ r : ℝ, volume S ≤
        volume (symmDiff ((fun w => y + r • w) ⁻¹' W) {w | 0 < inner ℝ w c} ∩
          ball (0 : Euclid (n + 1)) 1) +
        volume (symmDiff ((fun w => y + r • w) ⁻¹' V) {w | 0 < inner ℝ w a} ∩
          ball (0 : Euclid (n + 1)) 1) := by
      intro r
      refine (measure_mono ?_).trans (measure_union_le _ _)
      rintro w ⟨⟨hwc, hwa⟩, hw1⟩
      by_cases hwW : y + r • w ∈ W
      · right
        refine ⟨Or.inl ⟨hWV hwW, fun h => ?_⟩, hw1⟩
        exact absurd (show (0 : ℝ) < inner ℝ w a from h) (not_lt.mpr hwa.le)
      · left
        exact ⟨Or.inr ⟨hwc, hwW⟩, hw1⟩
    have h0 : volume S ≤ 0 + 0 := ge_of_tendsto' (hW.add hV) hle
    rw [add_zero] at h0
    exact absurd h0 (not_le.mpr hSpos)
  -- `ν_j = ν_k` `Hⁿ`-a.e. on `B_j ∩ B_k`
  have hcompat : ∀ j k : ℤ, ∀ᵐ y ∂(μHE[n].restrict (B j)), y ∈ B k → ν' k y = ν' j y := by
    intro j k
    have hj := (ae_restrict_iff' (hBm j)).mp (hblow j)
    have hk := (ae_restrict_iff' (hBm k)).mp (hblow k)
    rw [ae_restrict_iff' (hBm j)]
    filter_upwards [hj, hk] with y hyj hyk hyBj hyBk
    rcases le_total j k with hjk | hkj
    · exact (hgeom (U j) (U k) (ν' j y) (ν' k y) y (hUanti hjk) (hν'1 j y hyBj)
        (hν'1 k y hyBk) (hyj hyBj 1) (hyk hyBk 1)).symm
    · exact hgeom (U k) (U j) (ν' k y) (ν' j y) y (hUanti hkj) (hν'1 k y hyBk)
        (hν'1 j y hyBj) (hyk hyBk 1) (hyj hyBj 1)
  /- Step 5 (common normal).  `ν(x) = ν_{κ(i)}(x)` for the least `i` with `x ∈ B_{κ(i)}`, where
  `κ : ℕ → ℤ` is onto; `ν` is Borel, `|ν| = 1` on `⋃ⱼ B_j` and `ν = ν_j` a.e. on `B_j`. -/
  obtain ⟨κ, hκ⟩ := exists_surjective_nat ℤ
  obtain ⟨Bu, hBu_def⟩ : ∃ Bu : Set (Euclid (n + 1)), Bu = ⋃ j, B j := ⟨_, rfl⟩
  have hmemBu : ∀ x, x ∈ Bu ↔ ∃ j, x ∈ B j := fun x => by rw [hBu_def, mem_iUnion]
  have hBum : MeasurableSet Bu := by
    rw [hBu_def]
    exact MeasurableSet.iUnion hBm
  have hex : ∀ x, ∃ m, x ∈ B (κ m) ∨ x ∉ Bu := by
    intro x
    by_cases hx : x ∈ Bu
    · obtain ⟨j, hj⟩ := (hmemBu x).mp hx
      obtain ⟨m, rfl⟩ := hκ j
      exact ⟨m, Or.inl hj⟩
    · exact ⟨0, Or.inr hx⟩
  obtain ⟨ν, hν_def⟩ : ∃ ν : Euclid (n + 1) → Euclid (n + 1),
      ν = fun x => ν' (κ (Nat.find (hex x))) x := ⟨_, rfl⟩
  have hνm : Measurable ν := by
    rw [hν_def]
    exact Measurable.find (p := fun m x => x ∈ B (κ m) ∨ x ∉ Bu) (fun m => hν'm (κ m))
      (fun m => (hBm (κ m)).union hBum.compl) hex
  have hνB : ∀ x ∈ Bu, x ∈ B (κ (Nat.find (hex x))) := fun x hx =>
    (Nat.find_spec (hex x)).resolve_right (not_not.mpr hx)
  have hνx : ∀ x, ν x = ν' (κ (Nat.find (hex x))) x := fun x => by rw [hν_def]
  have hν1 : ∀ x ∈ Bu, ‖ν x‖ = 1 := fun x hx => by
    rw [hνx]
    exact hν'1 _ x (hνB x hx)
  have hνeq : ∀ j, ∀ᵐ x ∂(μHE[n].restrict (B j)), ν x = ν' j x := by
    intro j
    have hall : ∀ᵐ x ∂(μHE[n].restrict (B j)), ∀ k, x ∈ B k → ν' k x = ν' j x :=
      ae_all_iff.mpr fun k => hcompat j k
    filter_upwards [hall, ae_restrict_mem (hBm j)] with x hx hxj
    rw [hνx]
    exact hx _ (hνB x ((hmemBu x).mpr ⟨j, hxj⟩))
  -- `∂X_j(η) = ∫_{B_j} ξ(η) dHⁿ` with the common orientation `ξ = ξ_ν`
  have hrep : ∀ (j : ℤ) (η : TestFormOn (univ : Set (Euclid (n + 1))) n),
      (X j).boundary η =
        ∫ y in B j, Ξ (ν y) ((η : DifferentialForm (Euclid (n + 1)) n) y) ∂μHE[n] := by
    intro j η
    rw [hbd j η]
    refine integral_congr_ae ?_
    filter_upwards [hνeq j] with y hy
    rw [hy]
  -- `ξ(η)` is measurable, bounded on `⋃ⱼ B_j`, and integrable on each `B_j`
  have hξm : ∀ μ : Measure (Euclid (n + 1)), AEStronglyMeasurable (fun x => Ξ (ν x)) μ :=
    fun μ => Ξ.continuous.comp_aestronglyMeasurable hνm.aestronglyMeasurable
  have hgm : ∀ (η : TestFormOn (univ : Set (Euclid (n + 1))) n) (μ : Measure (Euclid (n + 1))),
      AEStronglyMeasurable (fun y => Ξ (ν y) ((η : DifferentialForm (Euclid (n + 1)) n) y)) μ :=
    fun η μ => isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable
      ((hξm μ).prodMk η.property.1.1.continuous.aestronglyMeasurable)
  have hgb : ∀ η : TestFormOn (univ : Set (Euclid (n + 1))) n, ∃ Mη : ℝ,
      ∀ y ∈ Bu, ‖Ξ (ν y) ((η : DifferentialForm (Euclid (n + 1)) n) y)‖ ≤ Mη := by
    intro η
    have hcont : Continuous fun y => hodge ((η : DifferentialForm (Euclid (n + 1)) n) y) :=
      hodge.continuous.comp η.property.1.1.continuous
    obtain ⟨M0, hM0⟩ :=
      hcont.bounded_above_of_compact_support (η.property.1.2.comp_left hodge.map_zero)
    refine ⟨M0, fun y hy => ?_⟩
    rw [Ξ_apply, norm_neg, Real.norm_eq_abs]
    calc |inner ℝ (hodge ((η : DifferentialForm (Euclid (n + 1)) n) y)) (ν y)|
        ≤ ‖hodge ((η : DifferentialForm (Euclid (n + 1)) n) y)‖ * ‖ν y‖ :=
          abs_real_inner_le_norm _ _
      _ = ‖hodge ((η : DifferentialForm (Euclid (n + 1)) n) y)‖ := by rw [hν1 y hy, mul_one]
      _ ≤ M0 := hM0 y
  have hgi : ∀ (η : TestFormOn (univ : Set (Euclid (n + 1))) n) (j : ℤ),
      IntegrableOn (fun y => Ξ (ν y) ((η : DifferentialForm (Euclid (n + 1)) n) y)) (B j)
        μHE[n] := by
    intro η j
    obtain ⟨Mη, hMη⟩ := hgb η
    exact Measure.integrableOn_of_bounded (hBfin j) (hgm η _)
      ((ae_restrict_iff' (hBm j)).mpr (ae_of_all _ fun y hy => hMη y ((hmemBu y).mpr ⟨j, hy⟩)))
  /- Step 6 (mass bound; Simon (7)–(8)).  `Y_N = Σ_{|j| ≤ N} ∂X_j = τ(⋃_{|j| ≤ N} B_j, h_N, ξ)`
  with `h_N = Σ_{|j| ≤ N} 1_{B_j}`, so `Σ_{|j| ≤ N} Hⁿ(B_j) ≤ M(Y_N) ≤ C` (oriented_mass_lower). -/
  have hmassN : ∀ N : ℕ, ∑ j ∈ Finset.Icc (-(N : ℤ)) N, μHE[n] (B j) ≤ C := by
    intro N
    let Y : GeometricCurrentOn (univ : Set (Euclid (n + 1))) n :=
      { toCurrent := ∑ j ∈ Finset.Icc (-(N : ℤ)) N, (X j).boundary.toCurrent
        continuous' := fun ωs hωs => by
          simpa [FunLike.coe_sum, Finset.sum_apply] using
            tendsto_finsetSum (Finset.Icc (-(N : ℤ)) N) fun j _ =>
              (X j).boundary.continuous' ωs hωs }
    have hYapp : ∀ η : TestFormOn (univ : Set (Euclid (n + 1))) n,
        Y η = ∑ j ∈ Finset.Icc (-(N : ℤ)) N, (X j).boundary η := by
      intro η
      simp [Y, Finset.sum_apply]
    obtain ⟨MJ, hMJ_def⟩ : ∃ MJ : Set (Euclid (n + 1)), MJ = ⋃ j ∈ Finset.Icc (-(N : ℤ)) N, B j :=
      ⟨_, rfl⟩
    have hmemMJ : ∀ x, x ∈ MJ ↔ ∃ j ∈ Finset.Icc (-(N : ℤ)) N, x ∈ B j := fun x => by
      rw [hMJ_def, mem_iUnion₂]
      simp only [exists_prop]
    have hMJm : MeasurableSet MJ := by
      rw [hMJ_def]
      exact Finset.measurableSet_biUnion _ fun j _ => hBm j
    have hMJB : MJ ⊆ Bu := fun x hx => by
      obtain ⟨j, -, hxj⟩ := (hmemMJ x).mp hx
      exact (hmemBu x).mpr ⟨j, hxj⟩
    obtain ⟨θJ, hθJ_def⟩ : ∃ θJ : Euclid (n + 1) → ℝ,
        θJ = fun x => ∑ j ∈ Finset.Icc (-(N : ℤ)) N, (B j).indicator (1 : Euclid (n + 1) → ℝ) x :=
      ⟨_, rfl⟩
    have hθJx : ∀ x, θJ x = ∑ j ∈ Finset.Icc (-(N : ℤ)) N,
        (B j).indicator (1 : Euclid (n + 1) → ℝ) x := fun x => by rw [hθJ_def]
    have hθJm : Measurable θJ := by
      rw [hθJ_def]
      exact Finset.measurable_sum _ fun j _ => measurable_one.indicator (hBm j)
    have hθJ0 : ∀ x, 0 ≤ θJ x := fun x => by
      rw [hθJx]
      exact Finset.sum_nonneg fun j _ => Set.indicator_nonneg (fun _ _ => zero_le_one) x
    have hYrep : ∀ ω : TestFormOn (univ : Set (Euclid (n + 1))) n,
        tsupport (ω : DifferentialForm (Euclid (n + 1)) n) ⊆ univ →
        Y ω = ∫ x in MJ, θJ x * Ξ (ν x) ((ω : DifferentialForm (Euclid (n + 1)) n) x) ∂μHE[n] := by
      intro ω _
      rw [hYapp]
      have h1 : ∀ j, (X j).boundary ω = ∫ y, (B j).indicator
          (fun y => Ξ (ν y) ((ω : DifferentialForm (Euclid (n + 1)) n) y)) y ∂μHE[n] :=
        fun j => (hrep j ω).trans (integral_indicator (hBm j)).symm
      simp_rw [h1]
      rw [← integral_finsetSum _ fun j _ => (hgi ω j).integrable_indicator (hBm j),
        setIntegral_eq_integral_of_forall_compl_eq_zero fun x hx => ?_]
      · refine integral_congr_ae (ae_of_all _ fun x => ?_)
        simp only [hθJx, Finset.sum_mul]
        refine Finset.sum_congr rfl fun j _ => ?_
        by_cases hxj : x ∈ B j <;> simp [hxj]
      · have h0 : θJ x = 0 := by
          rw [hθJx]
          exact Finset.sum_eq_zero fun j hj =>
            indicator_of_notMem (fun hxj => hx ((hmemMJ x).mpr ⟨j, hj, hxj⟩)) _
        rw [h0, zero_mul]
    have hlint : ∫⁻ x in MJ ∩ univ, ENNReal.ofReal (θJ x) ∂μHE[n] =
        ∑ j ∈ Finset.Icc (-(N : ℤ)) N, μHE[n] (B j) := by
      rw [inter_univ]
      have hpt : ∀ x, ENNReal.ofReal (θJ x) =
          ∑ j ∈ Finset.Icc (-(N : ℤ)) N, (B j).indicator (1 : Euclid (n + 1) → ℝ≥0∞) x := by
        intro x
        rw [hθJx, ENNReal.ofReal_sum_of_nonneg]
        · refine Finset.sum_congr rfl fun j _ => ?_
          by_cases hxj : x ∈ B j <;> simp [hxj]
        · exact fun j _ => Set.indicator_nonneg (fun _ _ => zero_le_one) x
      simp_rw [hpt]
      rw [lintegral_finsetSum _ fun j _ => measurable_one.indicator (hBm j)]
      refine Finset.sum_congr rfl fun j hj => ?_
      rw [lintegral_indicator_one (hBm j), Measure.restrict_apply (hBm j),
        inter_eq_left.mpr (show B j ⊆ MJ from fun x hx => (hmemMJ x).mpr ⟨j, hj, hx⟩)]
    have hfinJ : ∑ j ∈ Finset.Icc (-(N : ℤ)) N, μHE[n] (B j) ≠ ∞ :=
      ENNReal.sum_ne_top.mpr fun j _ => hBfin j
    have hlow := Submission.codim1_oriented_rep_lintegral_le_massOn (n + 1) n univ univ MJ Y θJ
      (fun x => Ξ (ν x)) subset_rfl hθJm hθJ0 (hξm _)
      ((ae_restrict_iff' hMJm).mpr (ae_of_all _ fun x hx => ⟨_, Ξ_orient (ν x) (hν1 x (hMJB hx))⟩))
      hYrep univ isOpen_univ subset_rfl (by rw [hlint]; exact hfinJ)
    rw [hlint] at hlow
    exact hlow.trans (hYC N Y hYapp)
  -- letting `N → ∞`: `Σⱼ Hⁿ(B_j) ≤ C`
  have htot : ∑' j, μHE[n] (B j) ≤ C := by
    rw [ENNReal.tsum_eq_iSup_sum]
    refine iSup_le fun s => ?_
    have hsub : s ⊆ Finset.Icc (-((s.sup Int.natAbs : ℕ) : ℤ)) (s.sup Int.natAbs : ℕ) := by
      intro j hj
      have := Finset.le_sup (f := Int.natAbs) hj
      rw [Finset.mem_Icc]
      omega
    exact (Finset.sum_le_sum_of_subset hsub).trans (hmassN _)
  have hCtop : C ≠ ∞ := hC.ne
  /- Step 7 (multiplicity).  `h = Σⱼ 1_{B_j}` has `∫ h dHⁿ = Σⱼ Hⁿ(B_j) ≤ C`, so `h < ∞` a.e.;
  where finite, `h(x)` is the number of `j` with `x ∈ B_j`, and `θ = ⌊h⌋`. -/
  obtain ⟨h, hh_def⟩ : ∃ h : Euclid (n + 1) → ℝ≥0∞,
      h = fun x => ∑' j, (B j).indicator (1 : Euclid (n + 1) → ℝ≥0∞) x := ⟨_, rfl⟩
  have hhx : ∀ x, h x = ∑' j, (B j).indicator (1 : Euclid (n + 1) → ℝ≥0∞) x := fun x => by
    rw [hh_def]
  have hhm : Measurable h := by
    rw [hh_def]
    exact Measurable.tsum fun j => measurable_one.indicator (hBm j)
  have hhint : ∫⁻ x, h x ∂μHE[n] = ∑' j, μHE[n] (B j) := by
    simp_rw [hhx]
    rw [lintegral_tsum fun j => (measurable_one.indicator (hBm j)).aemeasurable]
    exact tsum_congr fun j => lintegral_indicator_one (hBm j)
  have hhfin : ∫⁻ x, h x ∂μHE[n] ≠ ∞ := by
    rw [hhint]
    exact ne_top_of_le_ne_top hCtop htot
  have hhae : ∀ᵐ x ∂μHE[n], h x < ∞ := ae_lt_top hhm hhfin
  have hnat : ∀ x, h x < ∞ → ∃ m : ℕ, h x = m := by
    intro x hx
    have hS : {j : ℤ | x ∈ B j}.Finite := by
      by_contra hinf
      refine hx.ne (ENNReal.eq_top_of_forall_nnreal_le fun r => ?_)
      obtain ⟨s, hsS, hs⟩ := Set.Infinite.exists_subset_card_eq hinf ⌈r⌉₊
      calc (r : ℝ≥0∞) ≤ (⌈r⌉₊ : ℝ≥0∞) := by exact_mod_cast Nat.le_ceil r
        _ = ∑ j ∈ s, (B j).indicator (1 : Euclid (n + 1) → ℝ≥0∞) x := by
          rw [Finset.sum_congr rfl fun j hj => indicator_of_mem (show x ∈ B j from hsS hj) _]
          simp [hs]
        _ ≤ h x := by
          rw [hhx]
          exact ENNReal.sum_le_tsum s
    refine ⟨hS.toFinset.card, ?_⟩
    rw [hhx, tsum_eq_sum (s := hS.toFinset) fun j hj => indicator_of_notMem
      (show x ∉ B j from fun hxj => hj ((Set.Finite.mem_toFinset hS).mpr hxj)) _]
    rw [Finset.card_eq_sum_ones, Nat.cast_sum]
    refine Finset.sum_congr rfl fun j hj => ?_
    rw [indicator_of_mem (show x ∈ B j from (Set.Finite.mem_toFinset hS).mp hj)]
    simp
  obtain ⟨θ, hθ_def⟩ : ∃ θ : Euclid (n + 1) → ℕ, θ = fun x => ⌊(h x).toReal⌋₊ := ⟨_, rfl⟩
  have hθm : Measurable θ := by
    rw [hθ_def]
    exact Nat.floor_mono.measurable.comp (ENNReal.measurable_toReal.comp hhm)
  have hθh : ∀ x, h x < ∞ → (θ x : ℝ≥0∞) = h x := by
    intro x hx
    obtain ⟨m, hm⟩ := hnat x hx
    simp [hθ_def, hm]
  have hθle : ∀ x, (θ x : ℝ≥0∞) ≤ h x := by
    intro x
    rcases lt_or_eq_of_le (le_top : h x ≤ ∞) with hx | hx
    · exact (hθh x hx).le
    · rw [hx]
      exact le_top
  obtain ⟨M, hM_def⟩ : ∃ M : Set (Euclid (n + 1)), M = Bu ∩ {x | h x < ∞} := ⟨_, rfl⟩
  have hmemM : ∀ x, x ∈ M ↔ x ∈ Bu ∧ h x < ∞ := fun x => by
    rw [hM_def]
    rfl
  have hMm : MeasurableSet M := by
    rw [hM_def]
    exact hBum.inter (measurableSet_lt hhm measurable_const)
  have hθpos : ∀ x ∈ M, 0 < θ x := by
    intro x hxM
    obtain ⟨hxB, hxh⟩ := (hmemM x).mp hxM
    obtain ⟨j, hj⟩ := (hmemBu x).mp hxB
    have h1 : (1 : ℝ≥0∞) ≤ h x := by
      rw [hhx]
      calc (1 : ℝ≥0∞) = (B j).indicator (1 : Euclid (n + 1) → ℝ≥0∞) x := by simp [hj]
        _ ≤ ∑' j, (B j).indicator (1 : Euclid (n + 1) → ℝ≥0∞) x :=
          ENNReal.le_tsum (f := fun j => (B j).indicator (1 : Euclid (n + 1) → ℝ≥0∞) x) j
    rw [← hθh x hxh] at h1
    exact Nat.one_le_cast.mp h1
  /- Step 8 (rectifiability and tangent planes).  `M ⊆ ⋃ⱼ B_j` is countably `n`-rectifiable with
  `Hⁿ(M) < ∞`; by im_calculus (a) for `B_j ∩ M ⊆ M` and `B_j ∩ M ⊆ B_j`, a.e. on `B_j ∩ M` the
  approximate tangent space of `M` is that of `B_j`, namely `ν_j^⊥ = ν^⊥`. -/
  have hBurect : CountablyRectifiable n Bu := by
    rw [hBu_def, ← sUnion_range]
    exact Poincare.SimonGMT.Chapter03.countablyRectifiable_sUnion (countable_range B)
      (by rintro _ ⟨j, rfl⟩; exact hBrect j)
  have hBufin : μHE[n] Bu ≠ ∞ := by
    rw [hBu_def]
    exact ne_top_of_le_ne_top hCtop ((measure_iUnion_le B).trans htot)
  have hMB : M ⊆ Bu := fun x hx => ((hmemM x).mp hx).1
  have hMfin : μHE[n] M ≠ ∞ := ne_top_of_le_ne_top hBufin (measure_mono hMB)
  have htanM : ∀ᵐ x ∂(μHE[n].restrict M),
      HasApproximateTangentSpaceAt n M x (Submodule.span ℝ {ν x})ᗮ := by
    have hMU : (⋃ j, B j ∩ M) = M := by
      ext x
      simp only [mem_iUnion, mem_inter_iff]
      constructor
      · rintro ⟨j, -, hx⟩
        exact hx
      · intro hx
        obtain ⟨j, hj⟩ := (hmemBu x).mp (hMB hx)
        exact ⟨j, hj, hx⟩
    have key : ∀ j, ∀ᵐ x ∂(μHE[n].restrict (B j ∩ M)),
        HasApproximateTangentSpaceAt n M x (Submodule.span ℝ {ν x})ᗮ := by
      intro j
      have hBjM : MeasurableSet (B j ∩ M) := (hBm j).inter hMm
      have h1 := Submission.cmc_imRep_locality_restrict_sub.1 (n + 1) n univ (B j ∩ M) M
        isOpen_univ hBjM hMm inter_subset_right (subset_univ _)
        (fun K _ _ => ne_top_of_le_ne_top hMfin (measure_mono inter_subset_left))
      have h2 := Submission.cmc_imRep_locality_restrict_sub.1 (n + 1) n univ (B j ∩ M) (B j)
        isOpen_univ hBjM (hBm j) inter_subset_left (subset_univ _)
        (fun K _ _ => ne_top_of_le_ne_top (hBfin j) (measure_mono inter_subset_left))
      have h3 : ∀ᵐ x ∂(μHE[n].restrict (B j ∩ M)),
          HasApproximateTangentSpaceAt n (B j) x (Submodule.span ℝ {ν' j x})ᗮ :=
        ae_restrict_of_ae_restrict_of_subset inter_subset_left (hν'tan j)
      have h4 : ∀ᵐ x ∂(μHE[n].restrict (B j ∩ M)), ν x = ν' j x :=
        ae_restrict_of_ae_restrict_of_subset inter_subset_left (hνeq j)
      filter_upwards [h1, h2, h3, h4] with x hx1 hx2 hx3 hx4
      rw [hx4]
      exact (hx1 _).mp ((hx2 _).mpr hx3)
    have := (ae_restrict_iUnion_iff (fun j => B j ∩ M)
      fun x => HasApproximateTangentSpaceAt n M x (Submodule.span ℝ {ν x})ᗮ).mpr key
    rwa [hMU] at this
  /- Step 9: `(M, θ, ξ)` is an integer multiplicity representation in `ℝ^{n+1}`. -/
  let R : IMRep (univ : Set (Euclid (n + 1))) n :=
    { carrier := M
      mult := θ
      orient := fun x => Ξ (ν x)
      measurableSet_carrier := hMm
      carrier_subset := subset_univ _
      rectifiable := hBurect.mono hMB
      measurable_mult := hθm
      mult_pos := hθpos
      locallyIntegrable_mult := fun K _ _ => ne_top_of_le_ne_top hhfin
        ((setLIntegral_le_lintegral _ _).trans (lintegral_mono hθle))
      aestronglyMeasurable_orient := hξm _
      orients := by
        filter_upwards [htanM, ae_restrict_mem hMm] with x hx hxM
        exact ⟨_, hx, Ξ_orient (ν x) (hν1 x (hMB hxM))⟩ }
  /- Step 10: `T(η) = Σⱼ ∫_{B_j} ξ(η) dHⁿ = ∫ Σⱼ 1_{B_j} ξ(η) dHⁿ = ∫_M θ ξ(η) dHⁿ`, by dominated
  convergence for series (`Σⱼ ∫ |1_{B_j} ξ(η)| ≤ sup |φ_η| · Σⱼ Hⁿ(B_j) < ∞`). -/
  refine ⟨R, fun η => ?_⟩
  show T η = ∫ x in M, (θ x : ℝ) * Ξ (ν x) ((η : DifferentialForm (Euclid (n + 1)) n) x) ∂μHE[n]
  obtain ⟨Mη, hMη⟩ := hgb η
  obtain ⟨g, hg_def⟩ : ∃ g : Euclid (n + 1) → ℝ,
      g = fun y => Ξ (ν y) ((η : DifferentialForm (Euclid (n + 1)) n) y) := ⟨_, rfl⟩
  have hsum : HasSum (fun j => ∫ y in B j, g y ∂μHE[n]) (T η) := by
    rw [hg_def]
    simpa only [hrep] using hT η
  have hF : ∀ j, AEStronglyMeasurable ((B j).indicator g) μHE[n] := fun j => by
    rw [hg_def]
    exact (hgm η _).indicator (hBm j)
  have hF' : ∑' j, ∫⁻ x, ‖(B j).indicator g x‖ₑ ∂μHE[n] ≠ ∞ := by
    have hle : ∀ j, ∫⁻ x, ‖(B j).indicator g x‖ₑ ∂μHE[n] ≤ ENNReal.ofReal Mη * μHE[n] (B j) := by
      intro j
      simp_rw [enorm_indicator_eq_indicator_enorm]
      rw [lintegral_indicator (hBm j), ← setLIntegral_const]
      refine setLIntegral_mono measurable_const fun x hx => ?_
      rw [← ofReal_norm, hg_def]
      exact ENNReal.ofReal_le_ofReal (hMη x ((hmemBu x).mpr ⟨j, hx⟩))
    refine ne_top_of_le_ne_top ?_ (ENNReal.tsum_le_tsum hle)
    rw [ENNReal.tsum_mul_left]
    exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top (ne_top_of_le_ne_top hCtop htot)
  have hind : ∀ j, ∫ y in B j, g y ∂μHE[n] = ∫ y, (B j).indicator g y ∂μHE[n] :=
    fun j => (integral_indicator (hBm j)).symm
  have hgoal : ∫ x in M, (θ x : ℝ) * Ξ (ν x) ((η : DifferentialForm (Euclid (n + 1)) n) x) ∂μHE[n] =
      ∫ x in M, (θ x : ℝ) * g x ∂μHE[n] := by
    rw [hg_def]
  rw [hgoal, ← hsum.tsum_eq]
  simp_rw [hind]
  rw [← integral_tsum hF hF', ← integral_indicator hMm]
  refine integral_congr_ae ?_
  filter_upwards [hhae] with x hx
  have h1 : ∀ j, (B j).indicator g x = (B j).indicator (1 : Euclid (n + 1) → ℝ) x * g x := by
    intro j
    by_cases hxj : x ∈ B j <;> simp [hxj]
  have h2 : ∑' j, (B j).indicator (1 : Euclid (n + 1) → ℝ) x = (h x).toReal := by
    rw [hhx, ENNReal.tsum_toReal_eq fun j => ?_]
    · refine tsum_congr fun j => ?_
      by_cases hxj : x ∈ B j <;> simp [hxj]
    · by_cases hxj : x ∈ B j <;> simp [hxj]
  simp_rw [h1]
  rw [tsum_mul_right, h2, ← hθh x hx, ENNReal.toReal_natCast]
  by_cases hxM : x ∈ M
  · rw [indicator_of_mem hxM]
  · rw [indicator_of_notMem hxM]
    have hxB : x ∉ Bu := fun hxB => hxM ((hmemM x).mpr ⟨hxB, hx⟩)
    have hh0 : h x = 0 := by
      rw [hhx]
      exact ENNReal.tsum_eq_zero.mpr fun j =>
        indicator_of_notMem (fun hxj => hxB ((hmemBu x).mpr ⟨j, hxj⟩)) _
    have hθ0 : θ x = 0 := by simp [hθ_def, hh0]
    rw [hθ0, Nat.cast_zero, zero_mul]

/-- **Boundary rectifiability for compactly supported currents of finite mass** (Simon Ch. 6,
Theorem 6.3 = 6.2 + 3.11, needed only for cycles by Remark 6.4; in codimension zero Simon 3.14).
Let `m + 1 < P` and let `R ∈ 𝒟_{m+2}(ℝᴾ)` be integer multiplicity with compact support,
`M(R) < ∞` and `M(∂R) < ∞`.  Then `∂R` is integer multiplicity.
* `P ≥ m + 3` (first case of Simon's proof of 6.2): the deformation theorem with `K = spt R`,
  `Λ = max(M(R), M(∂R))` and `ε = (k+1)⁻¹` gives `R − Q_k − S_k = ∂R_k` with
  `M(R_k) + M(S_k) ≤ (k+1)⁻¹`, `∂Q_k` integer multiplicity and `M(∂Q_k) ≤ c M(∂R)`.  For
  `η ∈ 𝒟^{m+1}`, evaluating at `dη` and using `ddη = 0` gives `∂Q_k(η) = ∂R(η) − S_k(dη)`, and
  `|S_k(dη)| ≤ sup|dη| M(S_k) → 0`.  So the integer multiplicity cycles `∂Q_k` have bounded mass
  and converge weakly to `∂R`, and the closure theorem for cycles (Simon 8.2) applies.
* `P = m + 2` (Simon 3.14): the layers `U_j = {θ̃ ≥ j}` of the integer density of `R` give
  `∂R = Σ_j ∂[[U_j]]` with all partial sums of mass `≤ M(∂R)`, and a sum of boundaries of nested
  sets with bounded partial masses is integer multiplicity (Simon 3.14 (8)–(9)). -/
theorem Submission.dtc_bc_lc_fd_boundary_im : ∀ (P m : ℕ) (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)), m + 1 < P → IsIntegerMultiplicity R → IsCompact R.support → R.mass < ∞ → R.boundary.mass < ∞ → IsIntegerMultiplicity R.boundary := by
  intro P m R hmP hR hRc hRm hRb
  rcases Nat.lt_or_ge (m + 2) P with hP | hP
  · -- Case 1: `P ≥ m + 3`.
    -- Step 1: the deformation theorem at degree `m + 2` with `ε = (k+1)⁻¹`
    obtain ⟨c, hc⟩ := Submission.dtc_bc_lc_fd_deformation P (m + 1) hP
    set Λ : NNReal := max R.mass.toNNReal R.boundary.mass.toNNReal
    have hRΛ : R.mass ≤ Λ := by
      rw [← ENNReal.coe_toNNReal hRm.ne]
      exact ENNReal.coe_le_coe.2 (le_max_left _ _)
    have hbΛ : R.boundary.mass ≤ Λ := by
      rw [← ENNReal.coe_toNNReal hRb.ne]
      exact ENNReal.coe_le_coe.2 (le_max_right _ _)
    have hk : ∀ k : ℕ, ∃ (Q S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2))
        (R' : GeometricCurrentOn (univ : Set (Euclid P)) (m + 3)),
        IsIntegerMultiplicity Q.boundary ∧ R - Q - S = R'.boundary ∧
          R'.mass + S.mass ≤ ENNReal.ofReal (1 / ((k : ℝ) + 1)) ∧
          Q.boundary.mass ≤ c * R.boundary.mass := by
      intro k
      obtain ⟨𝒬, -, h𝒬⟩ := hc R.support Λ (ENNReal.ofReal (1 / ((k : ℝ) + 1))) hRc
        (ENNReal.ofReal_pos.2 (by positivity))
      obtain ⟨Q, -, R', S, -, hQ, hdec, hmass, hQb, -⟩ := h𝒬 R hR subset_rfl hRΛ hbΛ
      exact ⟨Q, S, R', hQ, hdec, hmass, hQb⟩
    choose Q S R' hQ hdec hmass hQb using hk
    -- the evaluation bound `|T(ω)| ≤ b M(T)` when the coefficient norm of `ω` is `≤ b`
    obtain ⟨A, hA⟩ := Submission.dor_ims_sua_coeff_norm_rep P (m + 2)
    have hbound : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 2), ∃ b : ℝ, 0 < b ∧
        ∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) (m + 2)) x) ≤ b := by
      intro ω
      have hcont : Continuous fun x => A ((ω : DifferentialForm (Euclid P) (m + 2)) x) :=
        A.continuous.comp ω.property.1.1.continuous
      have hcs : HasCompactSupport fun x => A ((ω : DifferentialForm (Euclid P) (m + 2)) x) :=
        ω.property.1.2.comp_left (map_zero A)
      obtain ⟨C, hC⟩ := hcont.bounded_above_of_compact_support hcs
      refine ⟨|C| + 1, by positivity, fun x => ?_⟩
      rw [hA]
      linarith [hC x, le_abs_self C]
    have heval : ∀ (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2))
        (ω : TestFormOn (univ : Set (Euclid P)) (m + 2)) (b : ℝ), 0 < b →
        (∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) (m + 2)) x) ≤ b) →
        ENNReal.ofReal |T ω| ≤ ENNReal.ofReal b * T.mass := by
      intro T ω b hb hωb
      -- `±b⁻¹ ω` are admissible for `M(T)`
      have hadm : ∀ s : ℝ, |s| = b⁻¹ →
          s • ω ∈ massAdmissibleOn (univ : Set (Euclid P)) (m + 2) univ := by
        intro s hs
        refine ⟨subset_univ _, fun x => ?_⟩
        change covectorEuclideanNorm (s • (ω : DifferentialForm (Euclid P) (m + 2)) x) ≤ 1
        rw [hA, map_smul, norm_smul, ← hA, Real.norm_eq_abs, hs]
        calc b⁻¹ * covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) (m + 2)) x)
            ≤ b⁻¹ * b := by gcongr; exact hωb x
          _ = 1 := inv_mul_cancel₀ hb.ne'
      have hT : ∀ s : ℝ, T (s • ω) = s * T ω := fun s => by
        rw [map_smul, smul_eq_mul]
      have hb' : 0 < b⁻¹ := inv_pos.2 hb
      have h₁ := T.le_massOn (hadm b⁻¹ (abs_of_pos hb'))
      have h₂ := T.le_massOn (hadm (-b⁻¹) (by rw [abs_neg, abs_of_pos hb']))
      rw [hT] at h₁ h₂
      have h₃ : ENNReal.ofReal (b⁻¹ * |T ω|) ≤ T.mass := by
        rcases abs_cases (T ω) with ⟨h, -⟩ | ⟨h, -⟩
        · rw [h]
          exact h₁
        · rw [h, mul_neg, ← neg_mul]
          exact h₂
      calc ENNReal.ofReal |T ω| = ENNReal.ofReal (b * (b⁻¹ * |T ω|)) := by
            rw [mul_inv_cancel_left₀ hb.ne']
        _ = ENNReal.ofReal b * ENNReal.ofReal (b⁻¹ * |T ω|) := ENNReal.ofReal_mul hb.le
        _ ≤ ENNReal.ofReal b * T.mass := by gcongr
    -- Steps 2–3: `∂Q_k(η) = ∂R(η) − S_k(dη)`, since `∂(R − Q_k − S_k) = ∂∂R_k = 0`
    have hid : ∀ (k : ℕ) (η : TestFormOn (univ : Set (Euclid P)) (m + 1)),
        (Q k).boundary η = R.boundary η - S k (exteriorDerivativeTestOn univ (m + 1) η) := by
      intro k η
      have h0 : (R' k).boundary.boundary η = 0 := by
        rw [GeometricCurrentOn.boundary_boundary]
        rfl
      have h1 : (R - Q k - S k).boundary η = (R' k).boundary.boundary η := by
        rw [hdec k]
      rw [h0] at h1
      change R (exteriorDerivativeTestOn univ (m + 1) η) -
        Q k (exteriorDerivativeTestOn univ (m + 1) η) -
          S k (exteriorDerivativeTestOn univ (m + 1) η) = 0 at h1
      rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.boundary_apply]
      linarith
    -- `∂Q_k ⇀ ∂R`, as `|S_k(dη)| ≤ sup|dη| M(S_k) ≤ sup|dη| (k+1)⁻¹ → 0`
    have hweak : WeaklyConvergesOn (fun k => (Q k).boundary) R.boundary := by
      intro η
      obtain ⟨b, hb, hωb⟩ := hbound (exteriorDerivativeTestOn univ (m + 1) η)
      have hb0 : Tendsto (fun k : ℕ => b * (1 / ((k : ℝ) + 1))) atTop (𝓝 0) := by
        have h := tendsto_one_div_add_atTop_nhds_zero_nat.const_mul b
        rwa [mul_zero] at h
      have hS : Tendsto (fun k => S k (exteriorDerivativeTestOn univ (m + 1) η)) atTop (𝓝 0) := by
        refine squeeze_zero_norm (fun k => ?_) hb0
        rw [Real.norm_eq_abs]
        have h₂ : ENNReal.ofReal b * (S k).mass ≤ ENNReal.ofReal (b * (1 / ((k : ℝ) + 1))) := by
          rw [ENNReal.ofReal_mul hb.le]
          gcongr
          exact le_add_self.trans (hmass k)
        exact (ENNReal.ofReal_le_ofReal_iff (by positivity)).1
          ((heval (S k) _ b hb hωb).trans h₂)
      have hlim := (tendsto_const_nhds (x := R.boundary η)).sub hS
      rw [sub_zero] at hlim
      exact hlim.congr fun k => (hid k η).symm
    -- Step 4: closure for the integer multiplicity cycles `∂Q_k` of mass `≤ c M(∂R)`
    refine Submission.dtc_bc_lc_fd_bim_closure_cycles P (m + 1) (fun k => (Q k).boundary)
      R.boundary hmP hQ (fun k => ?_) ?_ hweak
    · show (Q k).boundary.boundary = 0
      exact GeometricCurrentOn.boundary_boundary (Q k)
    · exact (iSup_le hQb).trans_lt (ENNReal.mul_lt_top ENNReal.coe_lt_top hRb)
  · -- Case 2: `P = m + 2`, codimension zero (Simon 3.14).
    obtain rfl : P = m + 1 + 1 := by omega
    obtain ⟨U, X, hU, hUmono, hX, hsum, hXb, hpart⟩ :=
      Submission.dtc_bc_lc_fd_bim_layers (m + 1) R hR hRc
    exact Submission.dtc_bc_lc_fd_bim_nested_im (m + 1) U X R.boundary R.boundary.mass
      (by omega) hU hUmono hX (fun j => (hXb j).trans_lt hRb) hsum hRb hpart

/-- **Simon Ch. 6, proof of 7.2 (summing the flat decomposition)**.  Let `n = m + 1 < P`, `L` be
compact, and `X_r, Z_r, Y ∈ 𝒟ₙ(ℝᴾ)`, `R_r ∈ 𝒟ₙ₊₁(ℝᴾ)`, `S_r ∈ 𝒟ₙ(ℝᴾ)` with `Y`, `Z_r`, `R_r` integer
multiplicity, `M(X_r) ≤ Λ`, `spt R_r ⊆ L`, `X_{r+1} − X_r − S_r = ∂R_r`, `M(R_r) + M(S_r) ≤ 2^{−r}`,
and `Z_r(ω) = X_r(ω) → Y(ω)` whenever `spt ω ⊆ V`.  Then for every `q` there are integer
multiplicity `R'`, `S'` with `Y − Z_q − S' = ∂R'` and `M_V(R') + M_V(S') ≤ 2·2^{−q}`.
* The series `R^{(q)} = Σᵢ R_{q+i}` and `S^{(q)} = Σᵢ S_{q+i}` converge in mass; `R^{(q)}` is
  integer multiplicity, `spt R^{(q)} ⊆ L`, and `M(R^{(q)}) + M(S^{(q)}) ≤ Σᵢ 2^{−(q+i)} = 2·2^{−q}`.
* Telescoping: `X_{q+N}(ω) → X_q(ω) + ∂R^{(q)}(ω) + S^{(q)}(ω)` for every `ω`.
* Testing with `±ω`, `M(∂R^{(q)}) ≤ 2Λ + M(S^{(q)}) < ∞`; `spt R^{(q)}` is compact, so boundary
  rectifiability makes `∂R^{(q)}` integer multiplicity.
* For `spt ω ⊆ V`, `Y(ω) = Z_q(ω) + ∂R^{(q)}(ω) + S^{(q)}(ω)`.  So `R' = R^{(q)}` and
  `S' = Y − Z_q − ∂R^{(q)}` work: `S'` is integer multiplicity, and `S' = S^{(q)}` on `V` gives
  `M_V(S') ≤ M(S^{(q)})`. -/
theorem Submission.dtc_bc_lc_fd_series_limit : ∀ (P m : ℕ) (X Z : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (V L : Set (Euclid P)) (Λ : NNReal), m + 1 < P → IsCompact L → IsIntegerMultiplicity Y → (∀ r, IsIntegerMultiplicity (Z r)) → (∀ r, (X r).mass ≤ Λ) → (∀ r, IsIntegerMultiplicity (R r) ∧ (R r).support ⊆ L ∧ X (r + 1) - X r - S r = (R r).boundary ∧ (R r).mass + (S r).mass ≤ (2⁻¹ : ℝ≥0∞) ^ r) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ V → (∀ r, Z r ω = X r ω) ∧ Tendsto (fun r => X r ω) atTop (𝓝 (Y ω))) → ∀ q : ℕ, ∃ (R' : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S' : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity R' ∧ IsIntegerMultiplicity S' ∧ Y - Z q - S' = R'.boundary ∧ R'.massOn V + S'.massOn V ≤ 2 * (2⁻¹ : ℝ≥0∞) ^ q := by
  intro P m X Z Y R S V L Λ hP hL hY hZ hXΛ hRS hV q
  -- Step 1: `M(R_r), M(S_r) ≤ 2^{−r}`, and `Σᵢ 2^{−(q+i)} = 2·2^{−q} < ∞`
  have hgeom : ∑' i, (2⁻¹ : ℝ≥0∞) ^ (q + i) = 2 * (2⁻¹ : ℝ≥0∞) ^ q := by
    simp_rw [pow_add]
    rw [ENNReal.tsum_mul_left, ENNReal.tsum_geometric, ENNReal.one_sub_inv_two, inv_inv, mul_comm]
  have hfin : 2 * (2⁻¹ : ℝ≥0∞) ^ q < ∞ :=
    ENNReal.mul_lt_top ENNReal.ofNat_lt_top (ENNReal.pow_lt_top (ENNReal.inv_lt_top.2 two_pos))
  have hRsum : ∑' i, (R (q + i)).mass ≤ 2 * (2⁻¹ : ℝ≥0∞) ^ q :=
    (ENNReal.tsum_le_tsum fun i => le_self_add.trans (hRS (q + i)).2.2.2).trans hgeom.le
  have hSsum : ∑' i, (S (q + i)).mass ≤ 2 * (2⁻¹ : ℝ≥0∞) ^ q :=
    (ENNReal.tsum_le_tsum fun i => le_add_self.trans (hRS (q + i)).2.2.2).trans hgeom.le
  -- Step 2: the mass-convergent series `R^{(q)} = Σᵢ R_{q+i}` and `S^{(q)} = Σᵢ S_{q+i}`
  obtain ⟨RQ, hRQ, hRQm, hRQs, hRQim⟩ :=
    Submission.dtc_bc_lc_fd_series P (m + 1) (fun i => R (q + i)) (hRsum.trans_lt hfin)
  obtain ⟨SQ, hSQ, hSQm, -, -⟩ :=
    Submission.dtc_bc_lc_fd_series P m (fun i => S (q + i)) (hSsum.trans_lt hfin)
  have hRQim' : IsIntegerMultiplicity RQ := hRQim fun i => (hRS (q + i)).1
  have hRQL : RQ.support ⊆ L :=
    hRQs.trans (closure_minimal (iUnion_subset fun i => (hRS (q + i)).2.1) hL.isClosed)
  -- Step 3: telescoping, `X_{q+N}(ω) → X_q(ω) + ∂R^{(q)}(ω) + S^{(q)}(ω)` for every `ω`
  have htel : ∀ (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)) (N : ℕ),
      X (q + N) ω = X q ω + ∑ i ∈ Finset.range N, (R (q + i)).boundary ω +
        ∑ i ∈ Finset.range N, S (q + i) ω := by
    intro ω N
    induction N with
    | zero => simp
    | succ N ih =>
      have h : X (q + N + 1) ω - X (q + N) ω - S (q + N) ω = (R (q + N)).boundary ω :=
        congrArg (fun T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1) => T ω)
          (hRS (q + N)).2.2.1
      rw [Finset.sum_range_succ, Finset.sum_range_succ]
      show X (q + N + 1) ω = _
      linarith
  have hlim : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1),
      Tendsto (fun N => X (q + N) ω) atTop (𝓝 (X q ω + RQ.boundary ω + SQ ω)) := by
    intro ω
    have h1 : Tendsto (fun N => ∑ i ∈ Finset.range N, (R (q + i)).boundary ω) atTop
        (𝓝 (RQ.boundary ω)) :=
      (hRQ (exteriorDerivativeTestOn univ (m + 1) ω)).tendsto_sum_nat
    have h2 : Tendsto (fun N => ∑ i ∈ Finset.range N, S (q + i) ω) atTop (𝓝 (SQ ω)) :=
      (hSQ ω).tendsto_sum_nat
    exact ((tendsto_const_nhds (x := X q ω)).add h1 |>.add h2).congr fun N => (htel ω N).symm
  -- Step 4: `M(∂R^{(q)}) ≤ 2Λ + M(S^{(q)}) < ∞`, testing the limit in Step 3 with `±ω`
  have hneg : ∀ ω ∈ massAdmissibleOn univ (m + 1) (univ : Set (Euclid P)),
      -ω ∈ massAdmissibleOn univ (m + 1) (univ : Set (Euclid P)) := by
    intro ω hω
    refine ⟨subset_univ _, fun x => ?_⟩
    have hx : ((-ω : TestFormOn (univ : Set (Euclid P)) (m + 1)) :
        DifferentialForm (Euclid P) (m + 1)) x = -((ω : DifferentialForm (Euclid P) (m + 1)) x) :=
      rfl
    rw [hx, covectorEuclideanNorm_neg]
    exact hω.2 x
  have hle : ∀ (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (c : ℝ≥0∞)
      (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)), c ≠ ∞ → T.mass ≤ c →
      ω ∈ massAdmissibleOn univ (m + 1) univ → T ω ≤ c.toReal := fun T c ω hc hT hω =>
    (ENNReal.ofReal_le_iff_le_toReal hc).1 ((T.le_massOn hω).trans hT)
  have hSQfin : SQ.mass ≠ ∞ := (hSQm.trans_lt (hSsum.trans_lt hfin)).ne
  have hbd : RQ.boundary.mass ≤ ENNReal.ofReal (2 * Λ + SQ.mass.toReal) := by
    apply sSup_le
    rintro _ ⟨ω, hω, rfl⟩
    show ENNReal.ofReal (RQ.boundary ω) ≤ _
    apply ENNReal.ofReal_le_ofReal
    have h0 : X q ω + RQ.boundary ω + SQ ω ≤ Λ :=
      le_of_tendsto (hlim ω) (Eventually.of_forall fun N => by
        simpa using hle (X (q + N)) Λ ω ENNReal.coe_ne_top (hXΛ _) hω)
    have h1 : -X q ω ≤ Λ := by
      have h := hle (X q) Λ (-ω) ENNReal.coe_ne_top (hXΛ q) (hneg ω hω)
      rw [(X q).toCurrent.map_neg ω] at h
      simpa using h
    have h2 : -SQ ω ≤ SQ.mass.toReal := by
      have h := hle SQ SQ.mass (-ω) hSQfin le_rfl (hneg ω hω)
      rwa [SQ.toCurrent.map_neg ω] at h
    linarith
  -- Step 5: `spt R^{(q)}` is closed in the compact `L`, so boundary rectifiability applies
  have hRQcpt : IsCompact RQ.support :=
    hL.of_isClosed_subset (isClosed_univ.sdiff RQ.isOpen_zeroRegion) hRQL
  have hbdim : IsIntegerMultiplicity RQ.boundary :=
    Submission.dtc_bc_lc_fd_boundary_im P m RQ hP hRQim' hRQcpt
      (hRQm.trans_lt (hRsum.trans_lt hfin)) (hbd.trans_lt ENNReal.ofReal_lt_top)
  -- Step 6: for `spt ω ⊆ V`, `Y(ω) = Z_q(ω) + ∂R^{(q)}(ω) + S^{(q)}(ω)`
  have hid : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1),
      tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ V →
      Y ω = Z q ω + RQ.boundary ω + SQ ω := by
    intro ω hω
    obtain ⟨hZX, hXY⟩ := hV ω hω
    have hshift : Tendsto (fun N => X (q + N) ω) atTop (𝓝 (Y ω)) :=
      ((tendsto_add_atTop_iff_nat q).2 hXY).congr fun N =>
        congrArg (fun r => X r ω) (Nat.add_comm N q)
    rw [hZX q]
    exact tendsto_nhds_unique hshift (hlim ω)
  -- Step 7: `R' = R^{(q)}` and `S' = Y − Z_q − ∂R^{(q)}`, integer multiplicity as a difference
  have hsub := Submission.cmc_imRep_locality_restrict_sub.2.2.1
  refine ⟨RQ, Y - Z q - RQ.boundary, hRQim',
    hsub P (m + 1) univ _ _ isOpen_univ (hsub P (m + 1) univ _ _ isOpen_univ hY (hZ q)) hbdim,
    ?_, ?_⟩
  · ext ω
    show Y ω - Z q ω - (Y ω - Z q ω - RQ.boundary ω) = RQ.boundary ω
    ring
  -- Step 8: `M_V(R') ≤ M(R^{(q)})`, and `M_V(S') ≤ M(S^{(q)})` since `S' = S^{(q)}` on `V`
  · have hS' : (Y - Z q - RQ.boundary).massOn V ≤ SQ.mass := by
      apply sSup_le
      rintro _ ⟨ω, hω, rfl⟩
      show ENNReal.ofReal (Y ω - Z q ω - RQ.boundary ω) ≤ SQ.mass
      have heq : Y ω - Z q ω - RQ.boundary ω = SQ ω := by
        rw [hid ω hω.1]
        ring
      rw [heq]
      exact SQ.le_massOn ⟨subset_univ _, hω.2⟩
    calc RQ.massOn V + (Y - Z q - RQ.boundary).massOn V ≤ RQ.mass + SQ.mass :=
          add_le_add (RQ.massOn_mono (subset_univ V)) hS'
      _ ≤ ∑' i, (R (q + i)).mass + ∑' i, (S (q + i)).mass := add_le_add hRQm hSQm
      _ = ∑' i, ((R (q + i)).mass + (S (q + i)).mass) := ENNReal.tsum_add.symm
      _ ≤ ∑' i, (2⁻¹ : ℝ≥0∞) ^ (q + i) := ENNReal.tsum_le_tsum fun i => (hRS (q + i)).2.2.2
      _ = 2 * (2⁻¹ : ℝ≥0∞) ^ q := hgeom

/-- **Simon Ch. 6, Definition 7.1 and Theorem 7.2 ("only if")** with `U = ℝᴾ`: if the integer
multiplicity `Tⱼ ⇀ T` in `𝒟ₙ(ℝᴾ)`, `n = m + 1 < P`, and `supⱼ (M_V(Tⱼ) + M_V(∂Tⱼ)) < ∞` for every
bounded open `V`, then for bounded open `W` there are integer multiplicity `Rⱼ`, `Sⱼ` with
`T − Tⱼ − Sⱼ = ∂Rⱼ` and `M_W(Rⱼ) + M_W(Sⱼ) → 0`.

Proof sketch:
* `aⱼ := inf {M_W(R) + M_W(S) : R, S integer multiplicity, T − Tⱼ − S = ∂R}` is Simon's
  `d_W(Tⱼ, T)`; it suffices that every subsequence `T_{ns j}` has a further subsequence along
  which `a → 0` (`tendsto_of_subseq_tendsto`).
* Localise: `T'ⱼ = T_{ns (φ j)}` on forms supported in `W`, `spt T'ⱼ ⊆ K` compact,
  `M(T'ⱼ), M(∂T'ⱼ) ≤ Λ` (`dtc_bc_lc_fd_localize`).
* The deformation theorem gives finite nets (`dtc_bc_lc_fd_deformation`), hence a subsequence `ψ`
  with `T'_{ψ(r+1)} − T'_{ψ r} − S_r = ∂R_r`, `M(R_r) + M(S_r) ≤ 2^{-r}`, `spt R_r ⊆ L`
  (`dtc_bc_lc_fd_cauchy_subseq`).
* Summing against the weak limit, `a_{ns (φ (ψ q))} ≤ 2 · 2^{-q}` (`dtc_bc_lc_fd_series_limit`).
* Choose decompositions with `M_W(Rⱼ) + M_W(Sⱼ) ≤ aⱼ + 2^{-j}`; if `aⱼ = ∞`, take the trivial
  `T − Tⱼ − (T − Tⱼ) = ∂0`, where `0 = τ(∅, 1, 0)` and `T − Tⱼ` is integer multiplicity
  (`cmc_imRep_locality_restrict_sub` (c)). -/
theorem Submission.dtc_bc_lc_flat_decomposition : ∀ (P m : ℕ) (Ts : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), m + 1 < P → (∀ j, IsIntegerMultiplicity (Ts j)) → IsIntegerMultiplicity T → (∀ W : Set (Euclid P), IsOpen W → Bornology.IsBounded W → ⨆ j, ((Ts j).massOn W + (Ts j).boundary.massOn W) < ∞) → WeaklyConvergesOn Ts T → ∀ W : Set (Euclid P), IsOpen W → Bornology.IsBounded W → ∃ (R : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ j, IsIntegerMultiplicity (R j) ∧ IsIntegerMultiplicity (S j) ∧ T - Ts j - S j = (R j).boundary) ∧ Tendsto (fun j => (R j).massOn W + (S j).massOn W) atTop (𝓝 0) := by
  intro P m Ts T hmP hTs hT hbd hconv W _hW hWb
  -- `D j`: the values `M_W(R) + M_W(S)` over the integer multiplicity decompositions
  -- `T − T_j − S = ∂R`; `sInf (D j)` is Simon's `d_W(T_j, T)`
  obtain ⟨D, hD⟩ : ∃ D : ℕ → Set ℝ≥0∞, ∀ j x, x ∈ D j ↔
      ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2))
        (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity R ∧
          IsIntegerMultiplicity S ∧ T - Ts j - S = R.boundary ∧ R.massOn W + S.massOn W = x :=
    ⟨fun j => {x | ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2))
        (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity R ∧
          IsIntegerMultiplicity S ∧ T - Ts j - S = R.boundary ∧ R.massOn W + S.massOn W = x},
      fun _ _ => Iff.rfl⟩
  -- `d_W(T_j, T) → 0`: every subsequence has a further subsequence with `d_W ≤ 2 · 2^{-q}`
  have ha : Tendsto (fun j => sInf (D j)) atTop (𝓝 0) := by
    refine tendsto_of_subseq_tendsto fun ns hns => ?_
    -- localisation: `T'_j = T_{ns (φ j)}` on forms supported in `W`, `spt T'_j ⊆ K`,
    -- `M(T'_j), M(∂T'_j) ≤ Λ`
    obtain ⟨K, φ, Λ, Ts', hK, hφ, hTs'IM, hTs'K, hTs'mass, hTs'eq⟩ :=
      Submission.dtc_bc_lc_fd_localize P m (fun j => Ts (ns j)) W hWb (fun j => hTs (ns j))
        fun V hV hVb => lt_of_le_of_lt
          (iSup_le fun j => le_iSup (fun i => (Ts i).massOn V + (Ts i).boundary.massOn V) (ns j))
          (hbd V hV hVb)
    -- finite nets from the deformation theorem, with `spt R ⊆ L = cthickening 1 K`
    obtain ⟨c, hc⟩ := Submission.dtc_bc_lc_fd_deformation P m hmP
    have hL : IsCompact (cthickening 1 K) := hK.cthickening
    -- a flat-Cauchy subsequence: `T'_{ψ(r+1)} − T'_{ψ r} − S_r = ∂R_r`, `M(R_r) + M(S_r) ≤ 2^{-r}`
    obtain ⟨ψ, hψ, hstep⟩ := Submission.dtc_bc_lc_fd_cauchy_subseq P m (cthickening 1 K) Ts' hL
      fun ε hε => by
        obtain ⟨𝒬, h𝒬, hnet⟩ := hc K Λ ε hK hε
        refine ⟨𝒬, h𝒬, fun j => ?_⟩
        obtain ⟨Q, hQ, R, S, hR, -, hdec, hmass, -, hspt⟩ :=
          hnet (Ts' j) (hTs'IM j) (hTs'K j) (hTs'mass j).1 (hTs'mass j).2
        exact ⟨Q, hQ, R, S, hR, hspt, hdec, hmass⟩
    choose R S hRS using hstep
    -- on forms supported in `W`, `T'_{ψ r} = T_{ns (φ (ψ r))} ⇀ T`; summing the series gives
    -- `T − T_{ns (φ (ψ q))} − S' = ∂R'` with `M_W(R') + M_W(S') ≤ 2 · 2^{-q}`
    have hlim := Submission.dtc_bc_lc_fd_series_limit P m (fun r => Ts' (ψ r))
      (fun r => Ts (ns (φ (ψ r)))) T R S W (cthickening 1 K) Λ hmP hL hT (fun _ => hTs _)
      (fun r => (hTs'mass (ψ r)).1) hRS fun ω hω => by
        have hω' : ∀ r, Ts' (ψ r) ω = Ts (ns (φ (ψ r))) ω := fun r => hTs'eq (ψ r) ω hω
        exact ⟨fun r => (hω' r).symm, ((hconv ω).comp
          (hns.comp (hφ.tendsto_atTop.comp hψ.tendsto_atTop))).congr fun r => (hω' r).symm⟩
    refine ⟨fun q => φ (ψ q), ?_⟩
    have h2 : Tendsto (fun q : ℕ => 2 * (2⁻¹ : ℝ≥0∞) ^ q) atTop (𝓝 0) := by
      simpa using ENNReal.Tendsto.const_mul (a := 2)
        (ENNReal.tendsto_pow_atTop_nhds_zero_of_lt_one (r := 2⁻¹) (by norm_num))
        (Or.inr (by norm_num))
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds h2 (fun _ => zero_le)
      fun q => ?_
    obtain ⟨R', S', hR', hS', hdec, hmass⟩ := hlim q
    exact (sInf_le ((hD _ _).2 ⟨R', S', hR', hS', hdec, rfl⟩)).trans hmass
  -- the zero `(m + 2)`-current `τ(∅, 1, 0)` is integer multiplicity
  have hIM0 : IsIntegerMultiplicity (0 : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) := by
    refine ⟨{ carrier := ∅
              mult := fun _ => 1
              orient := fun _ => 0
              measurableSet_carrier := MeasurableSet.empty
              carrier_subset := empty_subset _
              rectifiable :=
                Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty
              measurable_mult := measurable_const
              mult_pos := fun _ hx => by simp at hx
              locallyIntegrable_mult := fun _ _ _ => by simp
              aestronglyMeasurable_orient := aestronglyMeasurable_const
              orients := by simp }, fun ω => ?_⟩
    simp [IMRep.action]
  -- near-optimal decompositions: `M_W(R) + M_W(S) ≤ d_W(T_j, T) + 2^{-j}`, and the trivial
  -- `T − T_j − (T − T_j) = ∂0` when `d_W(T_j, T) = ∞`
  have hchoice : ∀ j, ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2))
      (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)),
      (IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ T - Ts j - S = R.boundary) ∧
        R.massOn W + S.massOn W ≤ sInf (D j) + (2⁻¹ : ℝ≥0∞) ^ j := by
    intro j
    by_cases htop : sInf (D j) = ⊤
    · refine ⟨0, T - Ts j, ⟨hIM0, Submission.cmc_imRep_locality_restrict_sub.2.2.1 P (m + 1) univ
        T (Ts j) isOpen_univ hT (hTs j), ?_⟩, by simp [htop]⟩
      ext ω
      show T ω - Ts j ω - (T ω - Ts j ω) = _
      simp
    · obtain ⟨x, hx, hlt⟩ := sInf_lt_iff.1
        (ENNReal.lt_add_right htop (pow_ne_zero j (by norm_num) : (2⁻¹ : ℝ≥0∞) ^ j ≠ 0))
      obtain ⟨R, S, hR, hS, hdec, rfl⟩ := (hD j x).1 hx
      exact ⟨R, S, ⟨hR, hS, hdec⟩, hlt.le⟩
  choose R S hRS hle using hchoice
  refine ⟨R, S, hRS, tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds ?_
    (fun _ => zero_le) hle⟩
  simpa using ha.add (ENNReal.tendsto_pow_atTop_nhds_zero_of_lt_one (r := 2⁻¹) (by norm_num))

/-- **Simon 7.2.4, (1)–(11), with Remark 7.2.5(2)** (local comparison).  Let `S_j` minimize in
`A_j ⊇ spt S_j` with locally bounded masses, let `π_j` be `C¹` retractions onto `A_j` that are
eventually `(1 + η)`-Lipschitz on balls, and let the integer multiplicity `Ŝ_j ⇀ C` (with locally
bounded `M + M ∘ ∂`) agree with `S_j` on `B_{ρ_j}(0)`, `ρ_j → ∞`.  Given a compact `K`, `ε > 0` and
a subsequence `ψ`, there are an open `W` with `K ⊆ W ⊆ {dist(·, K) < ε}` and a further subsequence
`φ'` with `limsup M_W(S_{ψ(φ'(i))}) ≤ M_W(S)` whenever `S` is integer multiplicity, `∂S = ∂C` and
`spt(S − C) ⊆ K`.

Put `f = dist(·, K)`, `W₀ = {f < ε/2}` and choose `G` with `{f ≤ ε} ⊆ B_{G/2}(0)`.  Flat
convergence gives `C − Ŝ_{ψ(j)} − S'_j = ∂R_j` with `M_{W₀}(R_j) + M_{W₀}(S'_j) → 0`, at most
`2⁻ⁱ` along `φ' = φ₁`.  Slicing `R_{φ₁(i)}` by `f` at a good level `t ∈ (0, ε/2)` gives
`∂(R_i⌞W) = (∂R_i)⌞W + P_i` for `W = {f < t}`, with `Σᵢ M_{W₀}(P_i) < ∞` and `μ_{S_i}{f = t} = 0`.
Then `Y_i = (S − C) + ∂(R_i⌞W)` is an integer multiplicity cycle supported in `{f ≤ t}`, and the
retraction comparison gives `M_{B_G}(S_i) ≤ (1 + η)ⁿ M_{B_G}(S_i + Y_i)`.  Split
`B_G = W ∪ {f = t} ∪ O'`, `O' = B_G ∩ {f > t}`: on `W`, `S_i + Y_i = S − S'_i`; on `O'`,
`S_i + Y_i = S_i`; and `μ_{S_i + Y_i}{f = t} ≤ M_{W₀}(P_i)` by subadditivity of the weights.  So
`M_W(S_i) ≤ (1 + η)ⁿ (M_W(S) + e_i) + ((1 + η)ⁿ − 1) c_G` with `e_i → 0`; let `i → ∞`, `η ↓ 0`. -/
theorem Submission.dtc_bc_local_comparison : ∀ (P m : ℕ) (Us As : ℕ → Set (Euclid P)) (Ss : (j : ℕ) → GeometricCurrentOn (Us j) (m + 1)) (Ŝ : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (C : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (ρ : ℕ → ℝ), m + 1 < P → (∀ j, IsOpen (Us j)) → (∀ j, IsMinimizingIn (Ss j) (As j)) → (∀ j, (Ss j).support ⊆ As j) → (∀ R : ℝ, ∃ c : ℝ≥0∞, c ≠ ∞ ∧ ∀ᶠ j in atTop, (Ss j).massOn (ball 0 R) ≤ c) → (∀ G : ℝ, 0 < G → ∃ πs : ℕ → Euclid P → Euclid P, (∀ᶠ j in atTop, ContDiffOn ℝ 1 (πs j) (ball 0 G) ∧ MapsTo (πs j) (ball 0 G) (As j) ∧ (∀ y ∈ As j ∩ ball 0 G, πs j y = y) ∧ ∀ y ∈ ball 0 G, ‖πs j y‖ ≤ 2 * ‖y‖) ∧ ∀ η : ℝ, 0 < η → ∀ᶠ j in atTop, ∀ y ∈ ball 0 G, ∀ z ∈ ball 0 G, ‖πs j y - πs j z‖ ≤ (1 + η) * ‖y - z‖) → IsIntegerMultiplicity C → (∀ j, IsIntegerMultiplicity (Ŝ j)) → (∀ W : Set (Euclid P), IsOpen W → Bornology.IsBounded W → ⨆ j, ((Ŝ j).massOn W + (Ŝ j).boundary.massOn W) < ∞) → WeaklyConvergesOn Ŝ C → Tendsto ρ atTop atTop → (∀ j, closedBall (0 : Euclid P) (ρ j) ⊆ Us j) → (∀ (j : ℕ) (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ ball 0 (ρ j) → Ŝ j ω = currentEval (Ss j) (ω : DifferentialForm (Euclid P) (m + 1))) → ∀ (K : Set (Euclid P)) (ε : ℝ), IsCompact K → 0 < ε → ∀ ψ : ℕ → ℕ, StrictMono ψ → ∃ W : Set (Euclid P), IsOpen W ∧ K ⊆ W ∧ W ⊆ thickening ε K ∧ ∃ φ' : ℕ → ℕ, StrictMono φ' ∧ ∀ S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity S → SameBoundary S C → (S - C).support ⊆ K → limsup (fun j => (Ss (ψ (φ' j))).massOn W) atTop ≤ S.massOn W := by
  intro P m Us As Ss Ŝ C ρ hmP hUs hmin hsptA hmass hπ hCim hŜim hsup hconv hρ hρU hŜS K ε hK hε
    ψ hψ
  -- Step 0: facts about integer multiplicity currents (parent proof, step 0)
  -- (G) differences and sums of integer multiplicity currents are integer multiplicity
  have hsub_im : ∀ (U : Set (Euclid P)) (A B : GeometricCurrentOn U (m + 1)), IsOpen U →
      IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B) :=
    fun U A B hU hA hB => Submission.cmc_imRep_locality_restrict_sub.2.2.1 P (m + 1) U A B hU hA hB
  have hadd_im : ∀ (U : Set (Euclid P)) (A B T : GeometricCurrentOn U (m + 1)), IsOpen U →
      IsIntegerMultiplicity A → IsIntegerMultiplicity B →
        (∀ ω : TestFormOn U (m + 1), T ω = A ω + B ω) → IsIntegerMultiplicity T := by
    intro U A B T hU hA hB h
    -- `T = A - ((B - B) - B)`
    have hT : T = A - ((B - B) - B) := GeometricCurrentOn.ext fun ω => by
      rw [h ω]
      show A ω + B ω = A ω - ((B ω - B ω) - B ω)
      ring
    rw [hT]
    exact hsub_im U _ _ hU hA (hsub_im U _ _ hU (hsub_im U _ _ hU hB hB) hB)
  -- `currentEval T ω = T(ω)` for `ω ∈ 𝒟ⁿ(U)`
  have hce : ∀ (U : Set (Euclid P)) (T : GeometricCurrentOn U (m + 1)) (ω : TestFormOn U (m + 1)),
      currentEval T (ω : DifferentialForm (Euclid P) (m + 1)) = T ω := by
    intro U T ω
    rw [currentEval, dite_eq_left ⟨ω.property.1, ω.property.2⟩]
  -- a current vanishing on the forms supported in `O` has no mass in `O`
  have hmass_zero : ∀ (U O : Set (Euclid P)) (T : GeometricCurrentOn U (m + 1)),
      (∀ ω : TestFormOn U (m + 1), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ O →
        T ω = 0) → T.massOn O = 0 := by
    intro U O T h
    refine le_antisymm (sSup_le ?_) zero_le
    rintro _ ⟨ω, hω, rfl⟩
    dsimp only
    rw [h ω hω.1, ENNReal.ofReal_zero]
  -- (F1), (F3): the weight vanishes on an open set on whose forms the current vanishes
  have hmeas_zero : ∀ (U O : Set (Euclid P)) (T : GeometricCurrentOn U (m + 1))
      (R : IMRep U (m + 1)), IsOpen U → IsOpen O → O ⊆ U → R.Represents T →
        (∀ ω : TestFormOn U (m + 1), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ O →
          T ω = 0) → R.measure O = 0 := by
    intro U O T R hU hO hOU hR h
    rw [← Submission.dtc_mass_eq_measure P (m + 1) U O T R hU hO hOU hR]
    exact hmass_zero U O T h
  -- `M_W(Z) ≤ M_W(X) + M_W(Y)` if `Z = X - Y` on the forms supported in `W`
  have hmass_sub : ∀ (U W : Set (Euclid P)) (Z : GeometricCurrentOn U (m + 1))
      (X Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)),
      (∀ ω : TestFormOn U (m + 1), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ W →
        Z ω = X (testFormOnInclusion (subset_univ U) (m + 1) ω) -
          Y (testFormOnInclusion (subset_univ U) (m + 1) ω)) →
        Z.massOn W ≤ X.massOn W + Y.massOn W := by
    intro U W Z X Y h
    refine sSup_le ?_
    rintro _ ⟨ω, hω, rfl⟩
    dsimp only
    -- `ω` and `-ω` are admissible for `M_W` in `ℝᴾ`
    set ω' := testFormOnInclusion (subset_univ U) (m + 1) ω
    have hω' : ω' ∈ massAdmissibleOn univ (m + 1) W := hω
    have hω'' : -ω' ∈ massAdmissibleOn univ (m + 1) W := by
      refine ⟨?_, fun x => ?_⟩
      · rw [Submodule.coe_neg, tsupport_neg]
        exact hω'.1
      · rw [Submodule.coe_neg, Pi.neg_apply, covectorEuclideanNorm_neg]
        exact hω'.2 x
    rw [h ω hω.1, sub_eq_add_neg, ← map_neg Y.toCurrent ω']
    exact ENNReal.ofReal_add_le.trans (add_le_add (X.le_massOn hω') (Y.le_massOn hω''))
  -- (F5) the restriction `R' = (M ∩ E, θ, ξ)` of `R = (M, θ, ξ)` agrees with `R` on forms
  -- supported in `E` and vanishes on forms supported off `E`
  have hrestr_eq : ∀ (k : ℕ) (R R' : IMRep (univ : Set (Euclid P)) k) (E : Set (Euclid P)),
      R'.carrier = R.carrier ∩ E → R'.mult = R.mult → R'.orient = R.orient →
        ∀ ω : DifferentialForm (Euclid P) k, tsupport ω ⊆ E → R'.action ω = R.action ω := by
    intro k R R' E hc hm ho ω hω
    rw [IMRep.action, IMRep.action, hc, hm, ho]
    symm
    refine setIntegral_eq_of_subset_of_forall_sdiff_eq_zero R.measurableSet_carrier
      inter_subset_left fun x hx => ?_
    have hxω : x ∉ tsupport ω := fun h => hx.2 ⟨hx.1, hω h⟩
    rw [image_eq_zero_of_notMem_tsupport hxω, map_zero, mul_zero]
  have hrestr_zero : ∀ (k : ℕ) (R R' : IMRep (univ : Set (Euclid P)) k) (E : Set (Euclid P)),
      R'.carrier = R.carrier ∩ E → R'.mult = R.mult → R'.orient = R.orient →
        ∀ ω : DifferentialForm (Euclid P) k, Disjoint (tsupport ω) E → R'.action ω = 0 := by
    intro k R R' E hc hm ho ω hω
    rw [IMRep.action]
    refine setIntegral_eq_zero_of_forall_eq_zero fun x hx => ?_
    rw [hc] at hx
    have hxω : x ∉ tsupport ω := fun h => Set.disjoint_left.mp hω h hx.2
    rw [image_eq_zero_of_notMem_tsupport hxω, map_zero, mul_zero]
  -- the algebra of step 8(e): `u + x ≤ l(b + x)`, `x ≤ c < ∞`, `l ≥ 1` give
  -- `u ≤ lb + (l - 1)c`
  have halg : ∀ (u b x c l : ℝ≥0∞), x ≤ c → c ≠ ∞ → 1 ≤ l → u + x ≤ l * (b + x) →
      u ≤ l * b + (l - 1) * c := by
    intro u b x c l hxc hc hl h
    have hx : x ≠ ∞ := ne_top_of_le_ne_top hc hxc
    have h1 : l * (b + x) = l * b + (l - 1) * x + x := by
      rw [mul_add, add_assoc]
      congr 1
      conv_lhs => rw [← tsub_add_cancel_of_le hl]
      rw [add_mul, one_mul]
    rw [h1] at h
    calc u ≤ l * b + (l - 1) * x := ENNReal.le_of_add_le_add_right hx h
      _ ≤ l * b + (l - 1) * c := by gcongr
  -- Step 1: if `K = ∅`, take `W = ∅` (all masses in `∅` vanish) and `φ' = id`
  rcases K.eq_empty_or_nonempty with rfl | hKne
  · refine ⟨∅, isOpen_empty, subset_rfl, empty_subset _, id, strictMono_id, fun S _ _ _ => ?_⟩
    have h0 : ∀ (U : Set (Euclid P)) (T : GeometricCurrentOn U (m + 1)), T.massOn ∅ = 0 := by
      intro U T
      refine hmass_zero U ∅ T fun ω hω => ?_
      have hω0 : ω = 0 := Subtype.ext (tsupport_eq_empty_iff.mp (subset_empty_iff.mp hω))
      rw [hω0]
      exact map_zero T.toCurrent
    simp only [h0, limsup_const, le_refl]
  -- Step 2: the `1`-Lipschitz cut-off `f = dist(·, K)` (whose sublevel sets `{f < s}` are the
  -- sets `W_α` of the book) and radii `r = ε/2 < ε`, `D`, `G = 2D` with `{f ≤ ε} ⊆ B_D(0)`
  obtain ⟨RK, hRK⟩ := hK.isBounded.subset_closedBall (0 : Euclid P)
  set D : ℝ := max RK 0 + ε + 1 with hD_def
  have hRK0 : 0 ≤ max RK 0 := le_max_right _ _
  have hD : 0 < D := by linarith
  set G : ℝ := 2 * D with hG_def
  have hG : 0 < G := by linarith
  have hDG : D ≤ G := by linarith
  have hG2 : G / 2 = D := by rw [hG_def]; ring
  set r : ℝ := ε / 2 with hr_def
  have hr : 0 < r := by linarith
  have hrε : r < ε := by linarith
  set f : Euclid P → ℝ := fun x => infDist x K
  have hf_cont : Continuous f := continuous_infDist_pt K
  have hf_lip : LipschitzWith 1 f := lipschitz_infDist_pt K
  have hfK : ∀ x ∈ K, f x = 0 := fun x hx => infDist_zero_of_mem hx
  have hf_ball : ∀ x, f x ≤ ε → x ∈ ball (0 : Euclid P) D := by
    intro x hx
    have hlt : infDist x K < ε + 1 := by
      have : f x = infDist x K := rfl
      linarith
    obtain ⟨y, hyK, hxy⟩ := (infDist_lt_iff hKne).1 hlt
    have hy : ‖y‖ ≤ max RK 0 := (mem_closedBall_zero_iff.1 (hRK hyK)).trans (le_max_left _ _)
    have htri := dist_triangle x y 0
    rw [dist_zero_right, dist_zero_right] at htri
    rw [mem_ball_zero_iff]
    linarith
  -- Step 3: the retractions `π_j` on `B_{2G}(0)` and the mass bound `c_G` on `B_G(0)`; (R1)–(R3)
  -- hold for all large `j`
  obtain ⟨πs, hπ_ev, hπ_lip⟩ := hπ (2 * G) (by linarith)
  obtain ⟨cG, hcG, hcG_ev⟩ := hmass G
  have hgood_ev := hπ_ev.and ((hρ.eventually_ge_atTop G).and hcG_ev)
  -- Step 4 (book (2)): flat convergence, `C - Ŝ_{ψ(j)} - S'_j = ∂R_j` with
  -- `M_{W₀}(R_j) + M_{W₀}(S'_j) → 0`, `W₀ = {f < r}`
  set W₀ : Set (Euclid P) := {x | f x < r}
  have hW₀_open : IsOpen W₀ := isOpen_lt hf_cont continuous_const
  have hW₀_ball : W₀ ⊆ ball (0 : Euclid P) D := fun x hx =>
    hf_ball x (le_of_lt (lt_trans hx hrε))
  have hW₀_bdd : Bornology.IsBounded W₀ := isBounded_ball.subset hW₀_ball
