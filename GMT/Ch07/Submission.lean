    -- step 2(d): `e ∈ Q'`, since `μ(B_{λr}(a + λe)) ≥ ω₂(λr)²` once `λ < l₀`
    have heτ : e ∈ Submodule.span ℝ (Set.range τ) :=
      Submission.idtp_cse_etp_rescaled_limit_mem P R₀.measure
        (Submodule.span ℝ (Set.range τ) : Set (Euclid P)) a e (c.natAbs : ℝ)
        (fun j => lams (φ j)) (fun _ => e) (Submodule.closed_of_finiteDimensional _) hfin
        (fun j => hlams (φ j)) tendsto_const_nhds (hV R₀ hR₀) fun r hr => by
          filter_upwards [(hlams0.comp hφ.tendsto_atTop).eventually_lt_const hl₀] with j hj
          exact hlow _ (hedge _ (hlams (φ j)) hj) _ (mul_pos (hlams (φ j)) hr)
    -- step 2(e): `Q' = Q` and `α(τ) = ε α(a, e)` with `ε = ±1`
    obtain ⟨hQ', ε, hε, hατ⟩ :=
      Submission.idtp_cse_etp_plane_frame_sign P Q a e τ hQ haQ heQ ha he hae hτ haτ heτ
    refine ⟨φ, C', ε * c, hφ, ?_, hconv, fun ω => ?_, fun R hR g hg hgc => ?_⟩
    · rw [Int.natAbs_mul, hε, one_mul, hcc₀]
    · rw [hC' ω, hQ']
      simp_rw [hατ]
      rw [integral_const_mul]
      push_cast
      ring
    · have h := hV R hR g hg hgc
      rwa [hQ', hcc₀] at h
  refine ⟨c₀.natAbs, hc₀, hc₀dens, hblow, ?_⟩
  -- step 3: the cusp, `|x − π_Q x| ≤ |x − a|/20` for `x ∈ spt C` near `a`
  obtain ⟨s₁, hs₁, hcusp⟩ := Submission.idtp_cse_etp_cusp P R₀.measure C.support Q a
    (c₀.natAbs : ℝ) haQ hfin hlow (fun lams hlams hlams0 => by
      obtain ⟨φ, _, _, hφ, _, _, _, hV⟩ := hblow lams hlams hlams0
      exact ⟨φ, hφ, hV R₀ hR₀⟩) (1 / 20) (by norm_num)
  -- step 4: the localization in the box around `a`
  exact Submission.idtp_cse_etp_localization P Q a e C.support s₁ hQ haQ heQ ha he hae hs₁ hcusp
/-- **Mass and rotational-flux limits in the boxes `Z(s, s')` at the edge point** (step 10(a)–(c)
of the sector-endpoint density argument in the proof of Simon 7.3.3).  Let `R = (M, θ, ξ)`
represent the 2-dimensional minimizing cone `C`, `μ = θ H²⌞M`, and let
`Z(s, s') = {⟨x, a⟩ > 0, ||x| − 1| < s', |f(x)| < s', |x − πx| < s|x|}` and
`G(x) = |p_{TₓM}(⟨x, a⟩e − ⟨x, e⟩a)|²/|πx|²`.  Then `μ(Z(s, s'))/s'² → 4m` and
`(∫_{Z(s, s')} G dμ)/s'² → 4m` as `s' ↓ 0`.

* The sibling `idtp_cse_edge_tangent_plane` gives the blow-up property (BP) at `a` for a density
  `m'`, and `m' = m` by uniqueness of the density limit; `idtp_cse_cone_stationary_radial` gives
  `p_{TₓM}x = x` for `μ`-a.e. `x`.  `μ` is finite on compact sets (local integrability of `θ`).
* (Supp) `μ` does not charge the zero region `(spt C)ᶜ`: it is a countable union of open sets `W`
  on which `C` vanishes.  Testing `C` with `g·α` (`g ∈ C^∞_c(W)`, `α` a constant 2-covector) and
  the fundamental lemma of the calculus of variations give `θ ξ(α) = 0` `H²⌞M`-a.e. on `W`.
  Taking for `α` the covectors `u♭ ∧ v♭` (`idtp_cse_bml_wedge_covector`) of a dense sequence,
  `(u♭ ∧ v♭)(τ) = 0` for all `u, v` by continuity, contradicting `ξ = ±τ₀ ∧ τ₁` with `τ`
  orthonormal.  Hence `μ(W) = 0`.
* Step 1: by `Loc(s)` and (Supp), `μ(Z(s, s') \ B_{3s'}(a)) = 0`; then
  `idtp_cse_bml_box_mass_limit` gives the mass limit.
* Steps 6–8: with `β = a♭ ∧ e♭` (`β(a, e) = 1`), `idtp_cse_bml_tilt_pointwise_bound` gives
  `G ≤ 1` on `{⟨x, a⟩ > 0}` and `1 − 2(1 − |ξ(β)|) ≤ G` `μ`-a.e. there, so
  `∫_Z G dμ ≤ μ(Z) ≤ ∫_Z G dμ + 2∫_{B_{3s'}(a)} (1 − |ξ(β)|) dμ`; the tilt-excess decay
  `idtp_cse_bml_tilt_excess_decay` squeezes the flux to `4m`. -/
theorem Submission.idtp_cse_edge_box_mass_limits : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (δ : ℝ) (k : ℕ), IsMinimizingIn C univ → BoundaryVanishes C → IsConeCurrent C → Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → 0 < δ → 1 ≤ k → a ∈ C.support → (∀ t φ : ℝ, 0 < t → 0 < φ → φ < δ → HasMassDensity C (t • (Real.cos φ • a + Real.sin φ • e)) k ∧ ∃ r : ℝ, 0 < r ∧ C.support ∩ ball (t • (Real.cos φ • a + Real.sin φ • e)) r ⊆ (Q : Set (Euclid P))) → ∀ (R : IMRep (univ : Set (Euclid P)) 2) (m : ℕ) (s : ℝ), R.Represents C → HasMassDensity C a m → 0 < s → s ≤ 1 / 4 → (∀ s' : ℝ, 0 < s' → s' ≤ s → ∀ x ∈ C.support, 0 < inner ℝ x a → |‖x‖ - 1| < s' → |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' → ‖x - Q.starProjection x‖ ≤ 2 * s * ‖x‖ → ‖x - Q.starProjection x‖ < s' / 4 * ‖x‖ ∧ dist x a < 3 * s') → Tendsto (fun s' : ℝ => R.measure {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s' ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} / ENNReal.ofReal (s' ^ 2)) (𝓝[>] 0) (𝓝 (4 * (m : ℝ≥0∞))) ∧ Tendsto (fun s' : ℝ => (∫⁻ x in {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s' ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' ∧ ‖x - Q.starProjection x‖ < s * ‖x‖}, ENNReal.ofReal (‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2) ∂R.measure) / ENNReal.ofReal (s' ^ 2)) (𝓝[>] 0) (𝓝 (4 * (m : ℝ≥0∞))) := by
  intro P C Q a e δ k hmin hbd hcone hQ haQ heQ ha he hae hδ hk haC hsector R m s hR hm hs hs4
    hloc
  -- step 0: the blow-up property at `a` (sibling), with density `m' = m`
  obtain ⟨m', -, hm', hBP, -⟩ := Submission.idtp_cse_edge_tangent_plane P C Q a e δ k hmin hbd
    hcone hQ haQ heQ ha he hae hδ hk haC hsector
  have hmm : m' = m := by
    obtain ⟨-, hm'2⟩ := hm'
    obtain ⟨-, hm2⟩ := hm
    have h := tendsto_nhds_unique hm'2 hm2
    rw [ENNReal.ofReal_natCast, ENNReal.ofReal_natCast] at h
    exact_mod_cast h
  rw [hmm] at hBP
  -- radial tangency `p_{TₓM}x = x` for `μ`-a.e. `x` (sibling)
  have hrad := (Submission.idtp_cse_cone_stationary_radial P 2 C R hmin hbd hcone hR).2
  -- `μ` is finite on compact sets
  have hfin : IsFiniteMeasureOnCompacts R.measure := by
    refine ⟨fun K hK => ?_⟩
    rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
      Measure.restrict_restrict hK.measurableSet, Set.inter_comm K R.carrier]
    exact lt_top_iff_ne_top.2 (R.locallyIntegrable_mult K hK (subset_univ K))
  -- (Supp): the zero region of `C`, i.e. the complement of `spt C`, is `μ`-null
  have hzero : R.measure C.zeroRegion = 0 := by
    -- `μ(W) = 0` for every open `W` on which `C` vanishes
    have hW0 : ∀ W : Set (Euclid P), IsOpen W → C.VanishesOn W → R.measure W = 0 := by
      intro W hWo hWv
      -- `θ ξ(α) = 0` `H²⌞M`-a.e. on `W`, for every constant covector `α`
      have hα : ∀ α : Covector (Euclid P) 2, ∀ᵐ x ∂(μHE[2].restrict R.carrier),
          x ∈ W → (R.mult x : ℝ) * R.orient x α = 0 := by
        intro α
        refine hWo.ae_eq_zero_of_integral_contDiff_smul_eq_zero ?_ ?_
        · -- `θ ξ(α)` is locally integrable: `|ξ(α)| ≤ ‖α‖` a.e. and `θ` is locally integrable
          refine (locallyIntegrable_iff.2 fun K hK => ?_).locallyIntegrableOn W
          have hmK : Integrable (fun x => (R.mult x : ℝ))
              ((μHE[2].restrict R.carrier).restrict K) := by
            have h := integrable_toReal_of_lintegral_ne_top
              (μ := (μHE[2].restrict R.carrier).restrict K) (f := fun x => (R.mult x : ℝ≥0∞))
              ((measurable_from_nat (f := fun n : ℕ => (n : ℝ≥0∞))).comp
                R.measurable_mult).aemeasurable (by
                rw [Measure.restrict_restrict hK.measurableSet, Set.inter_comm K R.carrier]
                exact R.locallyIntegrable_mult K hK (subset_univ K))
            simpa using h
          refine Integrable.mono' (hmK.mul_const ‖α‖) ?_ ?_
          · exact (((measurable_from_nat (f := fun n : ℕ => (n : ℝ))).comp
              R.measurable_mult).aestronglyMeasurable.mul
              (R.aestronglyMeasurable_orient.apply_continuousLinearMap α)).restrict
          · refine ae_restrict_of_ae (R.orients.mono fun x hx => ?_)
            obtain ⟨-, -, τ, hτ, -, hσ⟩ := hx
            have hατ : ‖α τ‖ ≤ ‖α‖ := by
              simpa [Fin.prod_univ_two, hτ.1 0, hτ.1 1] using α.le_opNorm τ
            have hξ : |R.orient x α| ≤ ‖α‖ := by
              rcases hσ with hσ | hσ
              · rw [hσ, ← Real.norm_eq_abs]
                exact hατ
              · rw [hσ, abs_neg, ← Real.norm_eq_abs]
                exact hατ
            rw [norm_mul, Real.norm_natCast, Real.norm_eq_abs]
            exact mul_le_mul_of_nonneg_left hξ (Nat.cast_nonneg _)
        · -- `∫ g θ ξ(α) dH²⌞M = C(g·α) = 0` for `g ∈ C^∞_c(W)`
          intro g hg hgc hgW
          have hωt : IsTestForm (fun x => g x • α : DifferentialForm (Euclid P) 2) :=
            ⟨hg.smul contDiff_const, hgc.smul_right (f' := fun _ => α)⟩
          have h2 : R.action (fun x => g x • α) = 0 :=
            (hR ⟨fun x => g x • α, hωt, subset_univ _⟩).symm.trans
              (hWv ⟨fun x => g x • α, hωt, subset_univ _⟩
                ((tsupport_smul_subset_left g fun _ => α).trans hgW))
          refine Eq.trans ?_ h2
          simp only [IMRep.action, map_smul, smul_eq_mul]
          congr 1
          funext x
          ring
      -- the covectors `u♭ ∧ v♭`, `u, v` in a dense sequence
      choose βf hβf using fun u v : Euclid P => Submission.idtp_cse_bml_wedge_covector P u v
      have hall : ∀ᵐ x ∂(μHE[2].restrict R.carrier), ∀ i j : ℕ, x ∈ W →
          (R.mult x : ℝ) * R.orient x (βf (TopologicalSpace.denseSeq (Euclid P) i)
            (TopologicalSpace.denseSeq (Euclid P) j)) = 0 := by
        rw [ae_all_iff]
        intro i
        rw [ae_all_iff]
        intro j
        exact hα _
      have hνW : μHE[2].restrict R.carrier W = 0 := by
        rw [measure_eq_zero_iff_ae_notMem]
        filter_upwards [hall, ae_restrict_mem R.measurableSet_carrier, R.orients]
          with x hx hxc hxo hxW
        obtain ⟨-, -, τ, hτ, -, hσ⟩ := hxo
        have hpos : (0 : ℝ) < R.mult x := Nat.cast_pos.2 (R.mult_pos x hxc)
        -- `(u♭ ∧ v♭)(τ) = 0` on the dense sequence
        have key : ∀ i j : ℕ,
            inner ℝ (TopologicalSpace.denseSeq (Euclid P) i) (τ 0) *
                inner ℝ (TopologicalSpace.denseSeq (Euclid P) j) (τ 1) -
              inner ℝ (TopologicalSpace.denseSeq (Euclid P) i) (τ 1) *
                inner ℝ (TopologicalSpace.denseSeq (Euclid P) j) (τ 0) = 0 := by
          intro i j
          have h0 := (mul_eq_zero.1 (hx i j hxW)).resolve_left hpos.ne'
          rcases hσ with hσ | hσ
          · rwa [hσ, hβf] at h0
          · rwa [hσ, hβf, neg_eq_zero] at h0
        -- hence everywhere by continuity, while `(τ₀♭ ∧ τ₁♭)(τ) = 1`
        have heq := ((TopologicalSpace.denseRange_denseSeq (Euclid P)).prodMap
          (TopologicalSpace.denseRange_denseSeq (Euclid P))).equalizer
          (g := fun p : Euclid P × Euclid P =>
            inner ℝ p.1 (τ 0) * inner ℝ p.2 (τ 1) - inner ℝ p.1 (τ 1) * inner ℝ p.2 (τ 0))
          (h := fun _ => 0)
          (((continuous_fst.inner continuous_const).mul
              (continuous_snd.inner continuous_const)).sub
            ((continuous_fst.inner continuous_const).mul
              (continuous_snd.inner continuous_const)))
          continuous_const (funext fun p => key p.1 p.2)
        have h1 := congr_fun heq (τ 0, τ 1)
        have h01 : inner ℝ (τ 0) (τ 1) = (0 : ℝ) := hτ.2 (by decide)
        have h10 : inner ℝ (τ 1) (τ 0) = (0 : ℝ) := hτ.2 (by decide)
        simp [h01, h10, hτ.1 0, hτ.1 1] at h1
      exact withDensity_absolutelyContinuous _ _ hνW
    -- the zero region is a countable union of such open sets
    obtain ⟨T, hTc, hTS, hTU⟩ := TopologicalSpace.isOpen_sUnion_countable
      {W : Set (Euclid P) | IsOpen W ∧ IsCompact (closure W) ∧
        closure W ⊆ (univ : Set (Euclid P)) ∧ C.VanishesOn W} fun W hW => hW.1
    have hZR : C.zeroRegion = ⋃₀ T := by
      rw [hTU]
      rfl
    rw [hZR, measure_sUnion_null_iff hTc]
    intro W hW
    exact hW0 W (hTS hW).1 (hTS hW).2.2.2
  -- step 1: by `Loc(s)`, `μ`-almost all of `Z(s, s')` lies in `B_{3s'}(a)`
  have hnull : ∀ s' : ℝ, 0 < s' → s' ≤ s → R.measure ({x : Euclid P | 0 < inner ℝ x a ∧
      |‖x‖ - 1| < s' ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' ∧
      ‖x - Q.starProjection x‖ < s * ‖x‖} \ ball a (3 * s')) = 0 := by
    intro s' hs' hs's
    refine measure_mono_null ?_ hzero
    rintro x ⟨⟨hxa, hx1, hx2, hx3⟩, hxb⟩
    by_contra hxz
    have hxC : x ∈ C.support := ⟨mem_univ x, hxz⟩
    exact hxb (mem_ball.2 (hloc s' hs' hs's x hxC hxa hx1 hx2
      (by linarith [mul_nonneg hs.le (norm_nonneg x)])).2)
  -- steps 2–5: the mass limit
  have hmass := Submission.idtp_cse_bml_box_mass_limit P R.measure Q a e m s hfin hQ haQ heQ ha
    he hae hs hnull fun lams hlams hlim => by
      obtain ⟨φ, C', c, hφ, -, -, -, hV⟩ := hBP lams hlams hlim
      exact ⟨φ, hφ, hV R hR⟩
  refine ⟨hmass, ?_⟩
  -- step 6: the covector `β = a♭ ∧ e♭`, `β(a, e) = 1`, and the pointwise tilt bound
  obtain ⟨β, hβ⟩ := Submission.idtp_cse_bml_wedge_covector P a e
  have hea : inner ℝ e a = (0 : ℝ) := by
    rw [real_inner_comm]
    exact hae
  have hβae : β ![a, e] = 1 := by
    rw [hβ]
    simp [hae, hea, ha, he]
  obtain ⟨hG1, hGae⟩ := Submission.idtp_cse_bml_tilt_pointwise_bound P R Q a e β hQ haQ heQ ha he
    hae hβ hrad
  -- step 7: tilt-excess decay on `B_{3s'}(a)`
  have hdecay := Submission.idtp_cse_bml_tilt_excess_decay P C R Q a e m β hR hβae
    (hGae.mono fun x hx => hx.1) fun lams hlams hlim => by
      obtain ⟨φ, C', c, hφ, hc, hconv, hC', hV⟩ := hBP lams hlams hlim
      exact ⟨φ, C', c, hφ, hc, hconv, hC', hV R hR⟩
  -- step 8: `∫_Z G ≤ μ(Z) ≤ ∫_Z G + 2∫_{B_{3s'}(a)} (1 − |ξ(β)|)` and a squeeze
  have hdm : AEMeasurable (fun x => R.orient x β) R.measure :=
    ((R.aestronglyMeasurable_orient.mono_ac (withDensity_absolutelyContinuous
      (μHE[2].restrict R.carrier) fun x => (R.mult x : ℝ≥0∞))).apply_continuousLinearMap
      β).aemeasurable
  have hd1 : AEMeasurable (fun x => ENNReal.ofReal (1 - |R.orient x β|)) R.measure :=
    ENNReal.measurable_ofReal.comp_aemeasurable
      (aemeasurable_const.sub (continuous_abs.measurable.comp_aemeasurable hdm))
  have key2 : ∀ (Zs : Set (Euclid P)) (s' : ℝ), R.measure (Zs \ ball a (3 * s')) = 0 →
      Zs ⊆ {x : Euclid P | 0 < inner ℝ x a} →
      (∫⁻ x in Zs, ENNReal.ofReal (‖(approxTangentPlane 2 R.carrier x).starProjection
          (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2) ∂R.measure) ≤
        R.measure Zs ∧
      R.measure Zs ≤ (∫⁻ x in Zs, ENNReal.ofReal (‖(approxTangentPlane 2 R.carrier x).starProjection
          (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2) ∂R.measure) +
        2 * ∫⁻ x in ball a (3 * s'), ENNReal.ofReal (1 - |R.orient x β|) ∂R.measure := by
    intro Zs s' hZnull hZΩ
    refine ⟨(setLIntegral_mono measurable_const fun x hx =>
      ENNReal.ofReal_le_one.2 (hG1 x (hZΩ hx))).trans (setLIntegral_one _).le, ?_⟩
    have hΩ : MeasurableSet {x : Euclid P | 0 < inner ℝ x a} :=
      (isOpen_lt continuous_const (continuous_id.inner continuous_const)).measurableSet
    have hZa : ∀ᵐ x ∂(R.measure.restrict Zs), 0 < inner ℝ x a :=
      (ae_restrict_mem hΩ).filter_mono (ae_mono (Measure.restrict_mono hZΩ le_rfl))
    have hpt : ∀ᵐ x ∂(R.measure.restrict Zs), (1 : ℝ≥0∞) ≤
        ENNReal.ofReal (‖(approxTangentPlane 2 R.carrier x).starProjection
          (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2) +
        2 * ENNReal.ofReal (1 - |R.orient x β|) := by
      filter_upwards [hZa, ae_restrict_of_ae hGae] with x hxa hx
      have h1 := hx.2 hxa
      have h2 : ENNReal.ofReal (2 * (1 - |R.orient x β|)) =
          2 * ENNReal.ofReal (1 - |R.orient x β|) := by
        rw [ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2), ENNReal.ofReal_ofNat]
      rw [← h2, ← ENNReal.ofReal_one]
      exact (ENNReal.ofReal_le_ofReal (by linarith)).trans ENNReal.ofReal_add_le
    have hg : AEMeasurable (fun x => 2 * ENNReal.ofReal (1 - |R.orient x β|))
        (R.measure.restrict Zs) :=
      (hd1.const_mul 2).restrict
    refine (setLIntegral_one Zs).symm.le.trans ((lintegral_mono_ae hpt).trans ?_)
    rw [lintegral_add_right' _ hg, lintegral_const_mul' (2 : ℝ≥0∞) _ (by simp)]
    exact add_le_add le_rfl (mul_le_mul_of_nonneg_left
      (lintegral_mono' (Measure.restrict_mono_ae (ae_le_set.2 hZnull)) le_rfl) zero_le)
  have key : ∀ M F X : ℝ → ℝ≥0∞,
      Tendsto (fun s' : ℝ => M s' / ENNReal.ofReal (s' ^ 2)) (𝓝[>] 0) (𝓝 (4 * (m : ℝ≥0∞))) →
      Tendsto (fun s' : ℝ => X s' / ENNReal.ofReal (s' ^ 2)) (𝓝[>] 0) (𝓝 0) →
      (∀ s' : ℝ, 0 < s' → s' ≤ s → F s' ≤ M s' ∧ M s' ≤ F s' + 2 * X s') →
      Tendsto (fun s' : ℝ => F s' / ENNReal.ofReal (s' ^ 2)) (𝓝[>] 0)
        (𝓝 (4 * (m : ℝ≥0∞))) := by
    intro M F X hM hX hMF
    have hlow : Tendsto (fun s' : ℝ => M s' / ENNReal.ofReal (s' ^ 2) -
        2 * (X s' / ENNReal.ofReal (s' ^ 2))) (𝓝[>] 0) (𝓝 (4 * (m : ℝ≥0∞))) := by
      have h := ENNReal.Tendsto.sub hM
        (ENNReal.Tendsto.const_mul (a := (2 : ℝ≥0∞)) hX (Or.inr (by simp))) (Or.inr (by simp))
      rwa [mul_zero, tsub_zero] at h
    have hev : ∀ᶠ s' in 𝓝[>] (0 : ℝ), F s' ≤ M s' ∧ M s' ≤ F s' + 2 * X s' := by
      filter_upwards [Ioc_mem_nhdsGT hs] with s' hs'
      exact hMF s' hs'.1 hs'.2
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le' hlow hM ?_ ?_
    · filter_upwards [hev] with s' hs'
      rw [tsub_le_iff_right, ← mul_div_assoc, ← ENNReal.add_div]
      exact ENNReal.div_le_div_right hs'.2 _
    · filter_upwards [hev] with s' hs'
      exact ENNReal.div_le_div_right hs'.1 _
  exact key _ _ _ hmass hdecay fun s' hs' hs's =>
    key2 _ s' (hnull s' hs' hs's) fun x hx => hx.1

/-- **The rotational flux density at the edge of the sector is `m t`** (steps 6–10 of the
cone-sector endpoint density argument for Simon 7.3.3).  Let `C` be a 2-dimensional minimizing
cone in `ℝᴾ` with `∂C = 0`, `R = (M, θ, ξ)` a representation of `C`, `μ = θ H²⌞M`,
`Q = span{a, e}`, `m = Θ²(μ_C, a)` and `0 < s ≤ 1/4` with the localization property `Loc(s)`.
With `Ax = ⟨x, a⟩e − ⟨x, e⟩a`, `G = |p_{T_x}(Ax)|² / |πx|²` and `F̃(x) = (|x|, f(x))`, the fibre
sum `H(p) = Σ_{x ∈ M ∩ Z_s ∩ F̃⁻¹{p}} θ(x) |p_{T_x}(Ax)|` equals `m p₁` for a.e. `p` near
`(1, 0)`.  Stationarity, radial tangency and the gap given by `Loc(s)` yield the conservation law
`∫_{Z_s} ψ′(f) l(|x|) G dμ = 0`; the fibre area identity turns it, together with the dilation
invariance of the cone, into the rotation test (α) and the dilation test (β) for `toReal ∘ H`, so
`H(p) = c p₁` a.e. near `(1, 0)`; the box identity `∫_{Sq(s')} H = ∫_{Z(s, s')} G dμ` and the box
limit `s'⁻² ∫_{Z(s, s')} G dμ → 4m` force `c = m`. -/
theorem Submission.idtp_cse_flux_density_eq : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (δ : ℝ) (k : ℕ), IsMinimizingIn C univ → BoundaryVanishes C → IsConeCurrent C → Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → 0 < δ → 1 ≤ k → a ∈ C.support → (∀ t φ : ℝ, 0 < t → 0 < φ → φ < δ → HasMassDensity C (t • (Real.cos φ • a + Real.sin φ • e)) k ∧ ∃ r : ℝ, 0 < r ∧ C.support ∩ ball (t • (Real.cos φ • a + Real.sin φ • e)) r ⊆ (Q : Set (Euclid P))) → ∀ (R : IMRep (univ : Set (Euclid P)) 2) (m : ℕ) (s : ℝ), R.Represents C → HasMassDensity C a m → 0 < s → s ≤ 1 / 4 → (∀ s' : ℝ, 0 < s' → s' ≤ s → ∀ x ∈ C.support, 0 < inner ℝ x a → |‖x‖ - 1| < s' → |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' → ‖x - Q.starProjection x‖ ≤ 2 * s * ‖x‖ → ‖x - Q.starProjection x‖ < s' / 4 * ‖x‖ ∧ dist x a < 3 * s') → ∃ s₂ : ℝ, 0 < s₂ ∧ ∀ᵐ p : ℝ × ℝ, p ∈ Ioo (1 - s₂) (1 + s₂) ×ˢ Ioo (-s₂) s₂ → ∑' x : ↥(R.carrier ∩ {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} ∩ (fun x : Euclid P => (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a))) ⁻¹' {p}), (R.mult x : ℝ≥0∞) * ENNReal.ofReal ‖(approxTangentPlane 2 R.carrier (x : Euclid P)).starProjection (inner ℝ (x : Euclid P) a • e - inner ℝ (x : Euclid P) e • a)‖ = ENNReal.ofReal ((m : ℝ) * p.1) := by
  intro P C Q a e δ k hmin hbdry hcone hQ haQ heQ ha he hae hδ hk haC hsect R m s hR hm hs hs4 hloc
  -- step 0: `δV(X) = 0` for `C¹` compactly supported `X`, and `x ∈ T_x` for `μ`-a.e. `x`
  obtain ⟨hfv, hrad⟩ :=
    Submission.idtp_cse_cone_stationary_radial P 2 C R hmin hbdry hcone hR
  -- step 1: the gap `|q(x)| < s|x|/2` or `|q(x)| > 2s|x|`, `μ`-a.e. on the sector
  have hgap := Submission.idtp_cse_fd_gap_ae P C Q a e R s hR hs hloc
  -- step 3: `H` is a.e. measurable and `∫ b H = ∫_Z b(F̃) G dμ` for Borel `b ≥ 0`
  obtain ⟨hHm, -, hHb⟩ :=
    Submission.idtp_cse_fibre_area_identities P R Q a e s hQ haQ heQ ha he hae hrad
  -- step 3(a), (b): `H < ∞` a.e., `H_ℝ = toReal ∘ H` is integrable, the signed identity for
  -- bounded Borel `b`, and the box identity `∫_{Sq(s')} H = ∫_{Z(s, s')} G dμ`
  obtain ⟨hfin, hint, hsigned, hbox⟩ :=
    Submission.idtp_cse_fd_fibre_signed_identity P R Q a e s _ hQ haQ heQ ha he hae hHm
      fun b hb => (hHb b hb).1
  -- step 2: the conservation law `∫_Z ψ′(f) l(|x|) G dμ = 0`
  have hrc := Submission.idtp_cse_rotation_conservation P R Q a e s hQ haQ heQ ha he hae hs hs4
    hfv hrad hgap
  -- steps 4–6: the rotation test (α) and the dilation test (β) for `H_ℝ`, using `T_{rx} = T_x`
  obtain ⟨hα, hβ⟩ := Submission.idtp_cse_fd_alpha_beta P C R Q a e s _ hcone hR hs hs4
    (Submission.idtp_cse_cone_approxTangent_smul P 2 C R hcone hR) hsigned
    fun ψ l hψ hl hψs hls => (hrc ψ l hψ hl hψs hls).2
  -- step 7: `H_ℝ(p) = c p₁` for a.e. `p ∈ (1 - s/8, 1 + s/8) × (-s, s)`
  obtain ⟨c, hc⟩ := Submission.idtp_cse_alpha_invariant_homogeneous s _ hs (by linarith)
    hint.integrableOn hα hβ
  -- step 8: `∫_{Z(s, s')} G dμ / s'² → 4m` as `s' → 0⁺`
  have hlim := (Submission.idtp_cse_edge_box_mass_limits P C Q a e δ k hmin hbdry hcone hQ haQ
    heQ ha he hae hδ hk haC hsect R m s hR hm hs hs4 hloc).2
  -- steps 8–9: `c = m`, so `H(p) = m p₁` for a.e. `p` in the box of size `s₂ = s/8`
  refine ⟨s / 8, by linarith, ?_⟩
  exact Submission.idtp_cse_fd_identify_constant s c m _ _ hs (by linarith) hfin hc
    (fun s' _ hs' => hbox s' (by linarith)) hlim

/-- **Fibre count for the cone-sector endpoint density** (Simon 7.3.3; the classification of
`2`-dimensional minimizing cones used there, which the book cites to [Whi82]).  Let
`N(p) = Σ_{x ∈ X(p)} θ(x)` be the multiplicity of the fibre `X(p) = M ∩ Z_s ∩ F̃⁻¹{p}` of
`F̃(x) = (|x|, f(x))`, `f(x) = arctan(⟨x, e⟩/⟨x, a⟩)`, and `s₃ = min(s₂, δ/2, s/2)`, where `s₂` is
the radius of the flux identity `H(p) = m p₁` (`idtp_cse_flux_density_eq`).  For a.e.
`p ∈ (1 − s₃, 1 + s₃) × (−s₃, s₃)` the flux identity and, if `p₂ > 0`, the sector point
`x_Q(p) ∈ M` of multiplicity `k` with `T_{x_Q(p)}M = Q` (`idtp_cse_sector_carrier_points`) give
`m ≤ N(p)`, `k ≤ m` and, if `k < m`, `m + 1 ≤ N(p)` (`idtp_cse_fc_fibre_pointwise`).  A good point
of the positive-measure half box gives `k ≤ m`.  If `k < m` and `0 < s' ≤ s₃`, then
`ofReal((4m + 2)s'²) ≤ ∫_{Sq(s')} N` (`idtp_cse_fc_square_lintegral_lower`); the `N`-identity of
`idtp_cse_fibre_area_identities` (with radial tangency, `idtp_cse_cone_stationary_radial`) for
`b = 1_{Sq(s')}` turns this into `∫_{Z(s, s')} J dμ`, since `Z_s ∩ F̃⁻¹(Sq(s')) = Z(s, s')`, and
`idtp_cse_fc_jacobian_upper` (with `μ`-a.e. `x ∈ spt C`, `idtp_cse_fc_ae_mem_support`, and the
localization `Loc(s)` at `s'`) bounds that by `μ(Z(s, s'))/(1 − 2s')`. -/
theorem Submission.idtp_cse_fibre_count_bound : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (δ : ℝ) (k : ℕ), IsMinimizingIn C univ → BoundaryVanishes C → IsConeCurrent C → Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → 0 < δ → 1 ≤ k → a ∈ C.support → (∀ t φ : ℝ, 0 < t → 0 < φ → φ < δ → HasMassDensity C (t • (Real.cos φ • a + Real.sin φ • e)) k ∧ ∃ r : ℝ, 0 < r ∧ C.support ∩ ball (t • (Real.cos φ • a + Real.sin φ • e)) r ⊆ (Q : Set (Euclid P))) → ∀ (R : IMRep (univ : Set (Euclid P)) 2) (m : ℕ) (s : ℝ), R.Represents C → HasMassDensity C a m → 0 < s → s ≤ 1 / 4 → (∀ s' : ℝ, 0 < s' → s' ≤ s → ∀ x ∈ C.support, 0 < inner ℝ x a → |‖x‖ - 1| < s' → |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' → ‖x - Q.starProjection x‖ ≤ 2 * s * ‖x‖ → ‖x - Q.starProjection x‖ < s' / 4 * ‖x‖ ∧ dist x a < 3 * s') → k ≤ m ∧ (k < m → ∃ s₃ : ℝ, 0 < s₃ ∧ ∀ s' : ℝ, 0 < s' → s' ≤ s₃ → ENNReal.ofReal ((4 * (m : ℝ) + 2) * s' ^ 2 * (1 - 2 * s')) ≤ R.measure {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s' ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' ∧ ‖x - Q.starProjection x‖ < s * ‖x‖}) := by
  intro P C Q a e δ k hmin hbd hcone hQ haQ heQ ha he hae hδ hk haC hsect R m s hR ham hs hs4 hloc
  -- Step 0: radial tangency, the fibre identities, the flux identity and the sector points
  have hrad := (Submission.idtp_cse_cone_stationary_radial P 2 C R hmin hbd hcone hR).2
  have hid := (Submission.idtp_cse_fibre_area_identities P R Q a e s hQ haQ heQ ha he hae hrad).2.2
  obtain ⟨s₂, hs₂, hflux⟩ := Submission.idtp_cse_flux_density_eq P C Q a e δ k hmin hbd hcone hQ
    haQ heQ ha he hae hδ hk haC hsect R m s hR ham hs hs4 hloc
  have hsec := Submission.idtp_cse_sector_carrier_points P C Q a e δ k R hQ haQ heQ ha he hae hδ hk
    hsect hR
  -- the fibre multiplicity `N(p) = Σ_{x ∈ X(p)} θ(x)`
  set N : ℝ × ℝ → ℝ≥0∞ := fun p => ∑' x : ↥(R.carrier ∩ {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} ∩ (fun x : Euclid P => (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a))) ⁻¹' {p}), (R.mult x : ℝ≥0∞)
  -- `s₃ = min(s₂, δ/2, s/2)`, so `s₃ ≤ 1/8`
  set s₃ := min s₂ (min (δ / 2) (s / 2))
  have hs₃0 : 0 < s₃ := lt_min hs₂ (lt_min (half_pos hδ) (half_pos hs))
  have hs₃₂ : s₃ ≤ s₂ := min_le_left _ _
  have hs₃δ : s₃ ≤ δ / 2 := (min_le_right _ _).trans (min_le_left _ _)
  have hs₃s : s₃ ≤ s / 2 := (min_le_right _ _).trans (min_le_right _ _)
  -- Step 2: a.e. on `Box(s₃)`, `m ≤ N(p)`, and for `p₂ > 0`, `k ≤ m` and `k < m → m + 1 ≤ N(p)`
  have hgood : ∀ᵐ p : ℝ × ℝ, p ∈ Ioo (1 - s₃) (1 + s₃) ×ˢ Ioo (-s₃) s₃ →
      (m : ℝ≥0∞) ≤ N p ∧ (0 < p.2 → k ≤ m ∧ (k < m → (m : ℝ≥0∞) + 1 ≤ N p)) := by
    filter_upwards [hflux, hsec] with p hpH hpsec hp
    obtain ⟨⟨hp1l, hp1u⟩, hp2l, hp2u⟩ := hp
    obtain ⟨hmN, hcount⟩ := Submission.idtp_cse_fc_fibre_pointwise P R Q a e s m k p hQ haQ heQ ha
      he hae hs hs4 (abs_lt.2 ⟨by linarith, by linarith⟩) (abs_lt.2 ⟨by linarith, by linarith⟩)
      (hpH ⟨⟨by linarith, by linarith⟩, by linarith, by linarith⟩)
    refine ⟨hmN, fun hp2 => ?_⟩
    obtain ⟨hM, hθ, hT⟩ := hpsec (by linarith) hp2 (by linarith) (by linarith)
    exact hcount hM hθ hT
  -- Step 3: `k ≤ m`, read off at a good point of the half box `(1 - s₃, 1 + s₃) × (0, s₃)`
  have hkm : k ≤ m := by
    have hvol : volume (Ioo (1 - s₃) (1 + s₃) ×ˢ Ioo 0 s₃ : Set (ℝ × ℝ)) ≠ 0 := by
      rw [Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Ioo, Real.volume_Ioo]
      exact mul_ne_zero (ENNReal.ofReal_pos.2 (by linarith)).ne'
        (ENNReal.ofReal_pos.2 (by linarith)).ne'
    obtain ⟨p, ⟨⟨hp1l, hp1u⟩, hp2l, hp2u⟩, hp⟩ :=
      Measure.exists_mem_of_measure_ne_zero_of_ae hvol (ae_restrict_of_ae hgood)
    exact ((hp ⟨⟨hp1l, hp1u⟩, by linarith, hp2u⟩).2 hp2l).1
  refine ⟨hkm, fun hlt => ⟨s₃, hs₃0, fun s' hs' hs's₃ => ?_⟩⟩
  -- Steps 5–7 for `0 < s' ≤ s₃`: the square `Sq(s') ⊆ Box(s₃)`
  have hs's : s' ≤ s / 2 := hs's₃.trans hs₃s
  have hSq : MeasurableSet (Ioo (1 - s') (1 + s') ×ˢ Ioo (-s') s' : Set (ℝ × ℝ)) :=
    measurableSet_Ioo.prod measurableSet_Ioo
  have hSqbox : Ioo (1 - s') (1 + s') ×ˢ Ioo (-s') s' ⊆ Ioo (1 - s₃) (1 + s₃) ×ˢ Ioo (-s₃) s₃ :=
    prod_mono (Ioo_subset_Ioo (by linarith) (by linarith)) (Ioo_subset_Ioo (by linarith) hs's₃)
  -- Step 5: `ofReal((4m + 2)s'²) ≤ ∫⁻_{Sq(s')} N`
  have hlow := Submission.idtp_cse_fc_square_lintegral_lower N m s' hs'
    (hgood.mono fun p hp hpSq => (hp (hSqbox hpSq)).1)
    (hgood.mono fun p hp hpSq hp2 => ((hp (hSqbox hpSq)).2 hp2).2 hlt)
  -- Step 6: `∫⁻_{Sq(s')} N = ∫⁻ 1_{Sq(s')} N`, which the `N`-identity turns into an integral over `Z_s`
  have hb : Measurable ((Ioo (1 - s') (1 + s') ×ˢ Ioo (-s') s').indicator (1 : ℝ × ℝ → ℝ≥0∞)) :=
    measurable_one.indicator hSq
  have hNSq : ∫⁻ p in Ioo (1 - s') (1 + s') ×ˢ Ioo (-s') s', N p =
      ∫⁻ p, (Ioo (1 - s') (1 + s') ×ˢ Ioo (-s') s').indicator 1 p * N p := by
    rw [← lintegral_indicator hSq]
    refine lintegral_congr fun p => ?_
    by_cases hp : p ∈ Ioo (1 - s') (1 + s') ×ˢ Ioo (-s') s'
    · rw [indicator_of_mem hp, indicator_of_mem hp, Pi.one_apply, one_mul]
    · rw [indicator_of_notMem hp, indicator_of_notMem hp, zero_mul]
  -- `Z_s` and `Z(s, s')` are Borel
  have hZ : ∀ r : ℝ, MeasurableSet {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < r ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < r ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} := by
    intro r
    simp only [ofPred_and]
    refine (measurableSet_lt measurable_const ?_).inter ((measurableSet_lt ?_ measurable_const).inter
      ((measurableSet_lt ?_ measurable_const).inter (measurableSet_lt ?_ ?_))) <;> fun_prop
  -- on `Z_s`, `F̃(x) ∈ Sq(s')` iff `x ∈ Z(s, s')`, so the integral over `Z_s` is one over `Z(s, s')`
  have hmid : ∫⁻ x in {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖}, (Ioo (1 - s') (1 + s') ×ˢ Ioo (-s') s').indicator 1 (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a)) * ENNReal.ofReal (‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ / ‖Q.starProjection x‖ ^ 2) ∂R.measure ≤ ∫⁻ x in {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s' ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' ∧ ‖x - Q.starProjection x‖ < s * ‖x‖}, ENNReal.ofReal (‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ / ‖Q.starProjection x‖ ^ 2) ∂R.measure := by
    rw [← lintegral_indicator (hZ s')]
    refine (setLIntegral_congr_fun (hZ s) fun x hx => ?_).trans_le (setLIntegral_le_lintegral _ _)
    obtain ⟨hxa, -, -, hxq⟩ := hx
    have hiff : (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a)) ∈
        Ioo (1 - s') (1 + s') ×ˢ Ioo (-s') s' ↔ x ∈ {x : Euclid P | 0 < inner ℝ x a ∧
          |‖x‖ - 1| < s' ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' ∧
          ‖x - Q.starProjection x‖ < s * ‖x‖} := by
      simp only [mem_prod, mem_Ioo, mem_ofPred_eq, abs_lt]
      constructor
      · rintro ⟨⟨h1, h2⟩, h3, h4⟩
        exact ⟨hxa, ⟨by linarith, by linarith⟩, ⟨h3, h4⟩, hxq⟩
      · rintro ⟨-, ⟨h1, h2⟩, ⟨h3, h4⟩, -⟩
        exact ⟨⟨by linarith, by linarith⟩, h3, h4⟩
    by_cases hxZ : x ∈ {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s' ∧
        |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' ∧ ‖x - Q.starProjection x‖ < s * ‖x‖}
    · rw [indicator_of_mem (hiff.2 hxZ), indicator_of_mem hxZ, Pi.one_apply, one_mul]
    · rw [indicator_of_notMem (mt hiff.1 hxZ), indicator_of_notMem hxZ, zero_mul]
  -- `J ≤ 1/(1 − 2s')` `μ`-a.e. on `Z(s, s')`: `μ`-a.e. point lies in `spt C`, where `Loc(s)` applies
  have hjac := Submission.idtp_cse_fc_jacobian_upper P R Q a e C.support s s' hQ haQ heQ ha he hae
    (Submission.idtp_cse_fc_ae_mem_support P 2 C R hR) hs' (by linarith)
    fun x hx hxa hx1 hxf hxq => (hloc s' hs' (by linarith) x hx hxa hx1 hxf
      (hxq.le.trans (by linarith [mul_nonneg hs.le (norm_nonneg x)]))).1
  have hkey := hlow.trans (hNSq.trans_le ((hid _ hb).2.trans_le (hmid.trans hjac)))
  -- Step 7: multiply by `ofReal(1 − 2s') > 0`
  have h2s' : 0 < 1 - 2 * s' := by linarith
  calc ENNReal.ofReal ((4 * (m : ℝ) + 2) * s' ^ 2 * (1 - 2 * s'))
      = ENNReal.ofReal ((4 * (m : ℝ) + 2) * s' ^ 2) * ENNReal.ofReal (1 - 2 * s') :=
        ENNReal.ofReal_mul (by positivity)
    _ ≤ ENNReal.ofReal (1 / (1 - 2 * s')) * R.measure {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s' ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} * ENNReal.ofReal (1 - 2 * s') := by
        gcongr
    _ = R.measure {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s' ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} := by
        rw [mul_right_comm, ← ENNReal.ofReal_mul (by positivity), one_div_mul_cancel h2s'.ne',
          ENNReal.ofReal_one, one_mul]
/-- Planar discs of a fixed radius accumulating at an unstable point contradict finite mass
(proof of Simon 7.3.3(1), chapter-07.txt lines 497–510, where the book cites [Whi82] for the
classification of 2-dimensional minimizing cones; steps 11–14 of the proof that the density of
such a cone is locally constant off `0`).  Two discs `Dᵢ = Qᵢ ∩ B_ρ(zᵢ)` on distinct planes are
disjoint: near a common point both planes coincide with `spt C`.  A plane `Q'` with `Qᵢ = Q'` for
infinitely many `i` contains `b = lim zᵢ`, so `b` lies in one of its discs and `Θ²(μ_C, ·)` is
constant near `b`.  Hence infinitely many distinct planes occur; their discs are pairwise disjoint,
have bounded centres and carry the mass bound `H²(W ∩ Qᵢ) ≤ M_W(C)`, which
`idtp_tdc_no_infinite_planar_pieces` excludes. -/
theorem Submission.idtp_tdc_dlc_accumulating_discs : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2) (Q : ℕ → Submodule ℝ (Euclid P)) (z : ℕ → Euclid P) (k : ℕ → ℕ) (b : Euclid P) (ρ : ℝ), IsIntegerMultiplicity C → 0 < ρ → (∀ i, Module.finrank ℝ (Q i) = 2) → (∀ i, z i ∈ Q i) → Tendsto z atTop (𝓝 b) → (∀ i, ∀ x ∈ (Q i : Set (Euclid P)) ∩ ball (z i) ρ, ∃ ε : ℝ, 0 < ε ∧ C.support ∩ ball x ε = (Q i : Set (Euclid P)) ∩ ball x ε ∧ (∀ y ∈ C.support, y ∈ ball x ε → HasMassDensity C y (k i)) ∧ ∀ W : Set (Euclid P), IsOpen W → W ⊆ ball x ε → μHE[2] (W ∩ (Q i : Set (Euclid P))) ≤ C.massOn W) → (¬ ∃ (ε : ℝ) (m : ℕ), 0 < ε ∧ ∀ y ∈ C.support, y ∈ ball b ε → HasMassDensity C y m) → False := by
  intro P C Q z k b ρ hIM hρ hdim hzQ hz hgood hunst
  -- `spt C ∩ B_ε(x) = Q' ∩ B_ε(x)` persists on the smaller balls `B_t(x)`, `t ≤ ε`
  have hrestr : ∀ (Q' : Submodule ℝ (Euclid P)) (x : Euclid P) (ε t : ℝ), t ≤ ε →
      C.support ∩ ball x ε = (Q' : Set (Euclid P)) ∩ ball x ε →
      C.support ∩ ball x t = (Q' : Set (Euclid P)) ∩ ball x t := by
    intro Q' x ε t htε h
    have hball : ball x ε ∩ ball x t = ball x t := Set.inter_eq_right.mpr (ball_subset_ball htε)
    rw [← hball, ← inter_assoc, h, inter_assoc]
  -- (1) discs on distinct planes are disjoint: near a common point both planes equal `spt C`
  have hdisj : ∀ i j, Q i ≠ Q j →
      Disjoint ((Q i : Set (Euclid P)) ∩ ball (z i) ρ) ((Q j : Set (Euclid P)) ∩ ball (z j) ρ) := by
    intro i j hij
    refine Set.disjoint_left.mpr fun x hxi hxj => hij ?_
    obtain ⟨ε₁, hε₁, hspt₁, -⟩ := hgood i x hxi
    obtain ⟨ε₂, hε₂, hspt₂, -⟩ := hgood j x hxj
    exact Submission.idtp_tdc_dlc_subspace_eq_of_inter_ball_eq P (Q i) (Q j) x (min ε₁ ε₂) hxi.1
      (lt_min hε₁ hε₂) ((hrestr (Q i) x ε₁ _ (min_le_left ε₁ ε₂) hspt₁).symm.trans
        (hrestr (Q j) x ε₂ _ (min_le_right ε₁ ε₂) hspt₂))
  -- (2) each plane occurs for only finitely many `i`
  have hfin : ∀ Q' : Submodule ℝ (Euclid P), (Q ⁻¹' {Q'}).Finite := by
    intro Q'
    by_contra hinf
    have hclose : ∀ η > 0, ∃ i, Q i = Q' ∧ dist (z i) b < η := by
      intro η hη
      obtain ⟨N, hN⟩ := Metric.tendsto_atTop.mp hz η hη
      obtain ⟨i, hi, hNi⟩ := Set.Infinite.exists_gt hinf N
      exact ⟨i, hi, hN i hNi.le⟩
    -- (2a) `b ∈ Q'`: the closed subspace `Q'` contains `zᵢ` for infinitely many `i`, and `zᵢ → b`
    have hbQ : b ∈ (Q' : Set (Euclid P)) := by
      refine (Submodule.closed_of_finiteDimensional Q').closure_subset
        (Metric.mem_closure_iff.mpr fun η hη => ?_)
      obtain ⟨i, hi, hd⟩ := hclose η hη
      exact ⟨z i, hi ▸ hzQ i, by rwa [dist_comm]⟩
    -- (2b) then `b` lies in a disc `Dᵢ` with `Qᵢ = Q'`, so `Θ²(μ_C, ·) = kᵢ` on `spt C` near `b`,
    -- against the instability of `b`
    obtain ⟨i, hi, hd⟩ := hclose ρ hρ
    obtain ⟨ε, hε, -, hdens, -⟩ := hgood i b ⟨hi ▸ hbQ, mem_ball'.mpr hd⟩
    exact hunst ⟨ε, k i, hε, hdens⟩
  -- (3) hence infinitely many distinct planes occur: indices `iₗ` with pairwise distinct `Q iₗ`
  have hrange : (range Q).Infinite := by
    intro hfinr
    have h := hfinr.preimage' fun Q' _ => hfin Q'
    rw [preimage_range] at h
    exact Set.infinite_univ h
  obtain ⟨e⟩ : Nonempty (ℕ ↪ range Q) := ⟨hrange.natEmbedding _⟩
  choose idx hidx using fun l => Set.mem_range.mp (e l).2
  have hne : ∀ l l', l ≠ l' → Q (idx l) ≠ Q (idx l') := fun l l' hll' h =>
    hll' (e.injective (Subtype.ext ((hidx l).symm.trans (h.trans (hidx l')))))
  -- (4) the centres converge, so they are bounded
  obtain ⟨R, hR⟩ := isBounded_iff_forall_norm_le.mp (Metric.isBounded_range_of_tendsto z hz)
  -- (5) infinitely many pairwise disjoint discs of radius `ρ` with bounded centres, each carrying
  -- the mass bound `H²(W ∩ Qᵢ) ≤ M_W(C)`, contradict the local finiteness of `μ_C`
  exact Submission.idtp_tdc_no_infinite_planar_pieces P C (fun l => Q (idx l))
    (fun l => z (idx l)) ρ R hIM hρ (fun l => hdim (idx l)) (fun l => hzQ (idx l))
    (fun l => hR _ (mem_range_self (idx l))) (fun l l' hll' => hdisj _ _ (hne l l' hll'))
    (fun l w hw => by
      obtain ⟨ε, hε, -, -, hmass⟩ := hgood (idx l) w hw
      exact ⟨ε, hε, hmass⟩)

/-- **Density at the edge of a planar sector of a 2-dimensional minimizing cone** (proof of
7.3.3(1), case `n − d = 2`, chapter-07.txt lines 497–510, where the structure of 2-dimensional
minimizing cones is cited to [Whi82]).  Let `C ∈ 𝒟₂(ℝᴾ)` be a minimizing cone with `∂C = 0`, let
`a, e` be an orthonormal basis of the plane `Q`, and let `a ∈ spt C`.  If every point
`y = t(cos φ·a + sin φ·e)` (`t > 0`, `0 < φ < δ`) has `Θ²(μ_C, y) = k ≥ 1` and
`spt C ∩ B_r(y) ⊆ Q` for some `r > 0`, then `Θ²(μ_C, a) = k`.  The tangent cones at `a` give
`m = Θ²(μ_C, a) ≥ 1` and localize `spt C` near `a`; the integrality of the fibre multiplicities
gives `k ≤ m`, and for `k < m` the boxes `Z(s₀, s')` at `a` would have mass at least
`(4m + 2)s'²(1 − 2s')`, against `μ_C(Z(s₀, s'))/s'² → 4m`. -/
theorem Submission.idtp_cone_sector_endpoint_density : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (δ : ℝ) (k : ℕ), IsMinimizingIn C univ → BoundaryVanishes C → IsConeCurrent C → Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → 0 < δ → 1 ≤ k → a ∈ C.support → (∀ t φ : ℝ, 0 < t → 0 < φ → φ < δ → HasMassDensity C (t • (Real.cos φ • a + Real.sin φ • e)) k ∧ ∃ r : ℝ, 0 < r ∧ C.support ∩ ball (t • (Real.cos φ • a + Real.sin φ • e)) r ⊆ (Q : Set (Euclid P))) → HasMassDensity C a k := by
  intro P C Q a e δ k hC hCb hCcone hQ haQ heQ ha he hae hδ hk haC hsec
  -- Step 0: an integer multiplicity representation `R` of `C`.
  obtain ⟨R, hR⟩ := hC.1
  -- Steps 0–2 and 4(a): `m = Θ²(μ_C, a) ≥ 1` and the localization property `Loc(s₀)` at `a`.
  obtain ⟨m, -, hma, -, s₀, hs₀, hs₀le, hloc⟩ := Submission.idtp_cse_edge_tangent_plane P C Q a e
    δ k hC hCb hCcone hQ haQ heQ ha he hae hδ hk haC hsec
  -- Steps 11–12: `k ≤ m`, and for `k < m` the boxes `Z(s₀, s')` carry excess mass.
  obtain ⟨hkm, hexcess⟩ := Submission.idtp_cse_fibre_count_bound P C Q a e δ k hC hCb hCcone hQ
    haQ heQ ha he hae hδ hk haC hsec R m s₀ hR hma hs₀ hs₀le hloc
  rcases hkm.lt_or_eq with hkm | rfl
  · exfalso
    obtain ⟨s₃, hs₃, hbound⟩ := hexcess hkm
    -- Step 10(c): `μ_C(Z(s₀, s'))/s'² → 4m` as `s' → 0⁺`.
    have hlim := (Submission.idtp_cse_edge_box_mass_limits P C Q a e δ k hC hCb hCcone hQ haQ
      heQ ha he hae hδ hk haC hsec R m s₀ hR hma hs₀ hs₀le hloc).1
    -- The excess bound gives `(4m + 2)(1 − 2s') ≤ μ_C(Z(s₀, s'))/s'²` for `0 < s' < s₃`.
    have hlow : Tendsto (fun s' : ℝ => ENNReal.ofReal ((4 * (m : ℝ) + 2) * (1 - 2 * s')))
        (𝓝[>] 0) (𝓝 (ENNReal.ofReal (4 * (m : ℝ) + 2))) :=
      ENNReal.tendsto_ofReal (tendsto_nhdsWithin_of_tendsto_nhds
        (Continuous.tendsto' (by fun_prop) _ _ (by norm_num)))
    have hle := le_of_tendsto_of_tendsto hlow hlim (by
      filter_upwards [Ioo_mem_nhdsGT hs₃] with s' hs'
      rw [ENNReal.le_div_iff_mul_le (Or.inl (ENNReal.ofReal_pos.2 (pow_pos hs'.1 2)).ne')
        (Or.inl ENNReal.ofReal_ne_top), ← ENNReal.ofReal_mul' (sq_nonneg s'),
        show (4 * (m : ℝ) + 2) * (1 - 2 * s') * s' ^ 2 = (4 * (m : ℝ) + 2) * s' ^ 2 * (1 - 2 * s')
          by ring]
      exact hbound s' hs'.1 hs'.2.le)
    -- Hence `4m + 2 ≤ 4m`, which is absurd.
    rw [show (4 * (m : ℝ≥0∞)) = ENNReal.ofReal (4 * (m : ℝ)) by
        rw [ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 4), ENNReal.ofReal_natCast,
          ENNReal.ofReal_ofNat],
      ENNReal.ofReal_le_ofReal_iff (by positivity)] at hle
    linarith
  · exact hma

/-- The endpoint of a planar constant-density arc of a 2-dimensional minimizing cone (used in the
proof of Simon 7.3.3(1), pp. 191–192, for 2-dimensional minimizing cones).  Let
`γ(φ) = cos φ z + sin φ e` run along the unit circle of `Q`, and let each `γ(φ)`, `0 < φ < φ₀`,
have a ball on which `spt C` agrees with `Q` and has density `k`.  The centres `γ(φ)` lie in
`spt C` with density `k`; as `γ` is `1`-Lipschitz and `spt C` is closed, `a := γ(φ₀) ∈ spt C`.
With `e_a = sin φ₀ z − cos φ₀ e` one has `cos ψ a + sin ψ e_a = γ(φ₀ − ψ)`
(`idtp_tdc_acont_great_circle`), and the dilations `x ↦ tx`, `t > 0`, carry the density `k` and
the inclusion `spt C ∩ B_ε(γ(φ₀ − ψ)) ⊆ Q` to `tγ(φ₀ − ψ)` and `B_{tε}(tγ(φ₀ − ψ))`
(`idtp_tdc_cone_dilation`).  The sector lemma `idtp_cone_sector_endpoint_density` with `δ = φ₀`
then gives `Θ²(μ_C, a) = k`. -/
theorem Submission.idtp_tdc_acont_endpoint_density : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (z e : Euclid P) (k : ℕ) (φ₀ : ℝ), IsMinimizingIn C univ → BoundaryVanishes C → IsConeCurrent C → Module.finrank ℝ Q = 2 → z ∈ Q → e ∈ Q → ‖z‖ = 1 → ‖e‖ = 1 → inner ℝ z e = 0 → 1 ≤ k → 0 < φ₀ → (∀ φ : ℝ, 0 < φ → φ < φ₀ → ∃ ε : ℝ, 0 < ε ∧ C.support ∩ ball (Real.cos φ • z + Real.sin φ • e) ε = (Q : Set (Euclid P)) ∩ ball (Real.cos φ • z + Real.sin φ • e) ε ∧ ∀ y ∈ C.support, y ∈ ball (Real.cos φ • z + Real.sin φ • e) ε → HasMassDensity C y k) → Real.cos φ₀ • z + Real.sin φ₀ • e ∈ C.support ∧ HasMassDensity C (Real.cos φ₀ • z + Real.sin φ₀ • e) k := by
  intro P C Q z e k φ₀ hmin hbd hcone hQ hzQ heQ hz he hze hk hφ₀ harc
  -- `γ` is a `1`-Lipschitz unit circle; `e_a` is a unit vector orthogonal to `a = γ(φ₀)`, and
  -- `cos ψ a + sin ψ e_a = γ(φ₀ − ψ)`
  obtain ⟨hnorm, hlip, hframe⟩ := Submission.idtp_tdc_acont_great_circle P z e hz he hze
  obtain ⟨hea, hae, hrot⟩ := hframe φ₀
  -- `γ(φ) ∈ Q` and `e_a ∈ Q`, as `z, e ∈ Q`
  have hγQ : ∀ φ : ℝ, Real.cos φ • z + Real.sin φ • e ∈ Q := fun φ =>
    Q.add_mem (Q.smul_mem _ hzQ) (Q.smul_mem _ heQ)
  have heaQ : Real.sin φ₀ • z - Real.cos φ₀ • e ∈ Q :=
    Q.sub_mem (Q.smul_mem _ hzQ) (Q.smul_mem _ heQ)
  -- the centres `γ(φ)`, `0 < φ < φ₀`, of the balls lie in `spt C` and have density `k`
  have harcpt : ∀ φ : ℝ, 0 < φ → φ < φ₀ → Real.cos φ • z + Real.sin φ • e ∈ C.support ∧
      HasMassDensity C (Real.cos φ • z + Real.sin φ • e) k := by
    intro φ hφ hφφ₀
    obtain ⟨ε, hε, hspt, hdens⟩ := harc φ hφ hφφ₀
    have hmem : Real.cos φ • z + Real.sin φ • e ∈
        C.support ∩ ball (Real.cos φ • z + Real.sin φ • e) ε := by
      rw [hspt]
      exact ⟨hγQ φ, mem_ball_self hε⟩
    exact ⟨hmem.1, hdens _ hmem.1 hmem.2⟩
  -- `a ∈ spt C`: `|a − γ(φ₀ − η)| ≤ η` for small `η > 0`, and `spt C = ℝᴾ ∖ (zero region)` is
  -- closed
  have hclosed : IsClosed C.support := isClosed_univ.sdiff C.isOpen_zeroRegion
  have hasupp : Real.cos φ₀ • z + Real.sin φ₀ • e ∈ C.support := by
    refine hclosed.closure_subset (Metric.mem_closure_iff.2 fun r hr => ?_)
    obtain ⟨η, hη, hηφ₀, hηr⟩ : ∃ η : ℝ, 0 < η ∧ η < φ₀ ∧ η < r :=
      ⟨min φ₀ r / 2, half_pos (lt_min hφ₀ hr),
        (half_lt_self (lt_min hφ₀ hr)).trans_le (min_le_left _ _),
        (half_lt_self (lt_min hφ₀ hr)).trans_le (min_le_right _ _)⟩
    refine ⟨_, (harcpt (φ₀ - η) (sub_pos.2 hηφ₀) (sub_lt_self φ₀ hη)).1, ?_⟩
    rw [dist_eq_norm]
    calc _ ≤ |φ₀ - (φ₀ - η)| := hlip φ₀ (φ₀ - η)
      _ = η := by rw [sub_sub_cancel, abs_of_pos hη]
      _ < r := hηr
  -- the sector hypothesis at `a`: for `t > 0` and `0 < ψ < φ₀`, the point
  -- `t (cos ψ a + sin ψ e_a) = tγ(φ₀ − ψ)` has density `k`, and `spt C ⊆ Q` near it, since
  -- `B_{tε}(tγ(φ₀ − ψ)) = t B_ε(γ(φ₀ − ψ))` and `spt C` is invariant under `x ↦ tx`
  have hsector : ∀ t ψ : ℝ, 0 < t → 0 < ψ → ψ < φ₀ →
      HasMassDensity C (t • (Real.cos ψ • (Real.cos φ₀ • z + Real.sin φ₀ • e) +
        Real.sin ψ • (Real.sin φ₀ • z - Real.cos φ₀ • e))) k ∧
      ∃ r : ℝ, 0 < r ∧ C.support ∩ ball (t • (Real.cos ψ • (Real.cos φ₀ • z + Real.sin φ₀ • e) +
        Real.sin ψ • (Real.sin φ₀ • z - Real.cos φ₀ • e))) r ⊆ (Q : Set (Euclid P)) := by
    intro t ψ ht hψ hψφ₀
    have hφ : 0 < φ₀ - ψ := sub_pos.2 hψφ₀
    have hφφ₀ : φ₀ - ψ < φ₀ := sub_lt_self φ₀ hψ
    have hdil := Submission.idtp_tdc_cone_dilation P 2 C hmin.1 hcone t ht
    have hball : ∀ (w : Euclid P) (r : ℝ), ball (t • w) (t * r) = (fun y => t • y) '' ball w r :=
      fun w r => by rw [image_smul, smul_ball ht.ne', Real.norm_of_nonneg ht.le]
    obtain ⟨ε, hε, hspt, -⟩ := harc (φ₀ - ψ) hφ hφφ₀
    rw [hrot ψ]
    refine ⟨(hdil.2.2 _ _).2 (harcpt _ hφ hφφ₀).2, t * ε, mul_pos ht hε, ?_⟩
    rintro x ⟨hx, hxball⟩
    rw [hball] at hxball
    obtain ⟨y, hy, rfl⟩ := hxball
    have hyQ : y ∈ (Q : Set (Euclid P)) ∩
        ball (Real.cos (φ₀ - ψ) • z + Real.sin (φ₀ - ψ) • e) ε := by
      rw [← hspt]
      exact ⟨(hdil.2.1 y).1 hx, hy⟩
    exact Q.smul_mem t hyQ.1
  exact ⟨hasupp, Submission.idtp_cone_sector_endpoint_density P C Q
    (Real.cos φ₀ • z + Real.sin φ₀ • e) (Real.sin φ₀ • z - Real.cos φ₀ • e) φ₀ k hmin hbd hcone hQ
    (hγQ φ₀) heaQ (hnorm φ₀) hea hae hφ₀ hk hasupp hsector⟩

/-- **Continuation along a great circle of a 2-dimensional minimizing cone** (proof of 7.3.3(1),
case `n − d = 2`, chapter-07.txt lines 497–510, where the structure of 2-dimensional minimizing
cones is cited to [Whi82]).  Let `C ∈ 𝒟₂(ℝᴾ)` be a minimizing cone with `∂C = 0`, let `z, e` be
an orthonormal pair in the 2-plane `Q`, let `γ(φ) = cos φ·z + sin φ·e`, and call `γ(φ)` *good* if
for some `ε > 0`, `spt C ∩ B_ε(γ(φ)) = Q ∩ B_ε(γ(φ))` and `Θ²(μ_C, y) = k` for every
`y ∈ spt C ∩ B_ε(γ(φ))`.  If `γ(0) = z` is good and the density of `C` is locally constant near
every `γ(φ) ∈ spt C` with `Θ²(μ_C, γ(φ)) = k`, `0 < φ < L`, then `γ(φ)` is good for every
`0 ≤ φ < L`.  Goodness of `γ(φ)` with radius `ε` passes to `γ(ψ)` with radius `ε/2` for
`φ < ψ < φ + ε/2`, as `γ` is `1`-Lipschitz (`idtp_tdc_acont_great_circle`).  If `γ(ψ)` is good for
all `0 ≤ ψ < φ`, then `a = γ(φ) ∈ spt C` and `Θ²(μ_C, a) = k`
(`idtp_tdc_acont_endpoint_density`); the constant density `k'` near `a` is `Θ²(μ_C, a) = k` by
uniqueness of densities, so `a` is good (`idtp_tdc_acont_endpoint_plane`).  Real induction on
`[0, L)` (`idtp_tdc_acont_real_induction`) concludes. -/
theorem Submission.idtp_tdc_arc_continuation : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (z e : Euclid P) (k : ℕ) (L : ℝ), IsMinimizingIn C univ → BoundaryVanishes C → IsConeCurrent C → Module.finrank ℝ Q = 2 → z ∈ Q → e ∈ Q → ‖z‖ = 1 → ‖e‖ = 1 → inner ℝ z e = 0 → 1 ≤ k → (∃ ε : ℝ, 0 < ε ∧ C.support ∩ ball z ε = (Q : Set (Euclid P)) ∩ ball z ε ∧ ∀ y ∈ C.support, y ∈ ball z ε → HasMassDensity C y k) → (∀ φ : ℝ, 0 < φ → φ < L → Real.cos φ • z + Real.sin φ • e ∈ C.support → HasMassDensity C (Real.cos φ • z + Real.sin φ • e) k → ∃ (δ : ℝ) (k' : ℕ), 0 < δ ∧ ∀ y ∈ C.support, y ∈ ball (Real.cos φ • z + Real.sin φ • e) δ → HasMassDensity C y k') → ∀ φ : ℝ, 0 ≤ φ → φ < L → ∃ ε : ℝ, 0 < ε ∧ C.support ∩ ball (Real.cos φ • z + Real.sin φ • e) ε = (Q : Set (Euclid P)) ∩ ball (Real.cos φ • z + Real.sin φ • e) ε ∧ ∀ y ∈ C.support, y ∈ ball (Real.cos φ • z + Real.sin φ • e) ε → HasMassDensity C y k := by
  intro P C Q z e k L hmin hbd hcone hQ hzQ heQ hz he hze hk hstart hconst
  -- Step 0: `γ` is `1`-Lipschitz
  obtain ⟨-, hlip, -⟩ := Submission.idtp_tdc_acont_great_circle P z e hz he hze
  -- Step 2 (first failure): real induction on `[0, L)` for `G(φ)` := "`γ(φ)` is good"
  refine Submission.idtp_tdc_acont_real_induction (fun φ => ∃ ε : ℝ, 0 < ε ∧
      C.support ∩ ball (Real.cos φ • z + Real.sin φ • e) ε =
        (Q : Set (Euclid P)) ∩ ball (Real.cos φ • z + Real.sin φ • e) ε ∧
      ∀ y ∈ C.support, y ∈ ball (Real.cos φ • z + Real.sin φ • e) ε → HasMassDensity C y k)
    L ?_ ?_ ?_
  -- `G(0)` is hypothesis (i), as `γ(0) = z`
  · simpa only [Real.cos_zero, Real.sin_zero, one_smul, zero_smul, add_zero] using hstart
  -- Step 1 (goodness is open): `G(φ)` with radius `ε` gives `G(ψ)` with radius `ε/2` for
  -- `φ < ψ < φ + ε/2`, since `|γ(ψ) − γ(φ)| ≤ ψ − φ < ε/2` gives `B_{ε/2}(γ(ψ)) ⊆ B_ε(γ(φ))`
  · rintro φ - - ⟨ε, hε, hsupp, hdens⟩
    refine ⟨ε / 2, half_pos hε, fun ψ hφψ hψε => ?_⟩
    have hsub : ball (Real.cos ψ • z + Real.sin ψ • e) (ε / 2) ⊆
        ball (Real.cos φ • z + Real.sin φ • e) ε := by
      refine ball_subset_ball' ?_
      have hψφ := hlip ψ φ
      rw [abs_of_pos (sub_pos.2 hφψ)] at hψφ
      rw [dist_eq_norm]
      linarith
    refine ⟨ε / 2, half_pos hε, ?_, fun y hy hyψ => hdens y hy (hsub hyψ)⟩
    rw [← inter_eq_right.2 hsub, ← inter_assoc, hsupp, inter_assoc]
  -- `G` on `[0, φ)` with `0 < φ < L` gives `G(φ)`
  · intro φ hφ0 hφL hbelow
    -- Steps 3–4: `a = γ(φ) ∈ spt C` and `Θ²(μ_C, a) = k`
    obtain ⟨ha, hak⟩ := Submission.idtp_tdc_acont_endpoint_density P C Q z e k φ hmin hbd hcone
      hQ hzQ heQ hz he hze hk hφ0 fun ψ hψ0 hψφ => hbelow ψ hψ0.le hψφ
    -- Step 5: hypothesis (ii) gives density `k'` on `spt C ∩ B_δ(a)`, and `k' = Θ²(μ_C, a) = k`
    obtain ⟨δ, k', hδ, hdens⟩ := hconst φ hφ0 hφL ha hak
    have hk' : k' = k := by
      exact_mod_cast Submission.dimred_cs_mi_hasMassDensity_unique P 2 univ C _ _ _
        (hdens _ ha (mem_ball_self hδ)) hak
    rw [hk'] at hdens
    -- Steps 6–7: the arc `γ((0, φ))` lies in `spt C` (each `γ(ψ)` is the centre of a good ball),
    -- so the plane at `a` is `Q` and `a` is good
    refine Submission.idtp_tdc_acont_endpoint_plane P C Q z e k φ δ hmin hbd hcone hQ hzQ heQ hz
      he hze hφ0 (fun ψ hψ0 hψφ => ?_) ha hδ hdens
    obtain ⟨ε, hε, hsupp, -⟩ := hbelow ψ hψ0.le hψφ
    have hψQ : Real.cos ψ • z + Real.sin ψ • e ∈ Q :=
      Q.add_mem (Q.smul_mem _ hzQ) (Q.smul_mem _ heQ)
    have hψ : Real.cos ψ • z + Real.sin ψ • e ∈
        (Q : Set (Euclid P)) ∩ ball (Real.cos ψ • z + Real.sin ψ • e) ε :=
      ⟨hψQ, mem_ball_self hε⟩
    rw [← hsupp] at hψ
    exact hψ.1

/-- **Mass of a planar piece** (step 6 of the proof of `idtp_tdc_dlc_light_disc`, toward the local
constancy of the density of a two-dimensional minimizing cone away from `0`, Simon 7.3.3(1)).  Let
`C` be a `2`-dimensional minimizing cone in `ℝᴾ` with `∂C = 0`, `Q` a linear subspace, `x ∈ Q`,
`x ≠ 0`, `k ≥ 1` and `ε > 0`, with `spt C ∩ B_ε(x) = Q ∩ B_ε(x)` and density `k` on
`spt C ∩ B_ε(x)`.  Then some `ε' > 0` keeps both properties and has `H²(W ∩ Q) ≤ M_W(C)` for every
open `W ⊆ B_ε'(x)`.  As `x ∈ Q ∩ B_ε(x) = spt C ∩ B_ε(x)`, `idtp_cone_constant_density_planar`
gives `δ > 0` and a plane `Q₂` with `spt C ∩ B_δ(x) = Q₂ ∩ B_δ(x)` and `M_W(C) = k H²(W ∩ Q₂)` for
open `W ⊆ B_δ(x)`.  Take `ε' = min(ε, δ)`.  Then `Q ∩ B_ε'(x) = spt C ∩ B_ε'(x) = Q₂ ∩ B_ε'(x)`, so
`W ∩ Q = W ∩ Q₂` for `W ⊆ B_ε'(x)`, and `H²(W ∩ Q) ≤ k H²(W ∩ Q) = M_W(C)` as `k ≥ 1`. -/
theorem Submission.idtp_tdc_dlc_ld_piece_mass_bound : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (x : Euclid P) (k : ℕ) (ε : ℝ), IsMinimizingIn C univ → BoundaryVanishes C → IsConeCurrent C → 1 ≤ k → x ∈ Q → x ≠ 0 → 0 < ε → C.support ∩ ball x ε = (Q : Set (Euclid P)) ∩ ball x ε → (∀ y ∈ C.support, y ∈ ball x ε → HasMassDensity C y k) → ∃ ε' : ℝ, 0 < ε' ∧ C.support ∩ ball x ε' = (Q : Set (Euclid P)) ∩ ball x ε' ∧ (∀ y ∈ C.support, y ∈ ball x ε' → HasMassDensity C y k) ∧ ∀ W : Set (Euclid P), IsOpen W → W ⊆ ball x ε' → μHE[2] (W ∩ (Q : Set (Euclid P))) ≤ C.massOn W := by
  intro P C Q x k ε hmin hbd hcone hk hxQ hx0 hε hA hB
  -- Step 1: `x ∈ spt C`, as `x ∈ Q ∩ B_ε(x) = spt C ∩ B_ε(x)`
  have hxC : x ∈ C.support := (hA.symm.subset ⟨hxQ, mem_ball_self hε⟩).1
  -- Step 2: the planar structure at `x`: `spt C ∩ B_δ(x) = Q₂ ∩ B_δ(x)` and
  -- `M_W(C) = k H²(W ∩ Q₂)` for open `W ⊆ B_δ(x)`
  obtain ⟨δ, Q₂, hδ, -, -, hC₂, hmass⟩ :=
    Submission.idtp_cone_constant_density_planar P C x k ε hmin hbd hcone hxC hx0 hε hB
  -- Step 3: `ε' = min ε δ`; restricting both equations to `B_ε'(x)` gives
  -- `spt C ∩ B_ε'(x) = Q ∩ B_ε'(x)` and `Q ∩ B_ε'(x) = Q₂ ∩ B_ε'(x)`
  have hε' : ball x (min ε δ) ⊆ ball x ε := ball_subset_ball (min_le_left ε δ)
  have hδ' : ball x (min ε δ) ⊆ ball x δ := ball_subset_ball (min_le_right ε δ)
  have hrestrict : ∀ (S₁ S₂ : Set (Euclid P)) (r : ℝ), ball x (min ε δ) ⊆ ball x r →
      S₁ ∩ ball x r = S₂ ∩ ball x r → S₁ ∩ ball x (min ε δ) = S₂ ∩ ball x (min ε δ) := by
    intro S₁ S₂ r hr h
    rw [← inter_eq_right.2 hr, ← inter_assoc, ← inter_assoc, h]
  have hA' := hrestrict _ _ ε hε' hA
  have hQQ₂ : (Q : Set (Euclid P)) ∩ ball x (min ε δ) = (Q₂ : Set (Euclid P)) ∩ ball x (min ε δ) :=
    hA'.symm.trans (hrestrict _ _ δ hδ' hC₂)
  -- Step 4: the support equation and the density `k` hold on `B_ε'(x) ⊆ B_ε(x)`
  refine ⟨min ε δ, lt_min hε hδ, hA', fun y hy hyx => hB y hy (hε' hyx), fun W hW hWx => ?_⟩
  -- Step 5: `W ∩ Q = W ∩ Q₂`, as `W ⊆ B_ε'(x)`
  have hWQ : W ∩ (Q : Set (Euclid P)) = W ∩ (Q₂ : Set (Euclid P)) := by
    ext y
    exact ⟨fun hy => ⟨hy.1, (hQQ₂.subset ⟨hy.2, hWx hy.1⟩).1⟩,
      fun hy => ⟨hy.1, (hQQ₂.symm.subset ⟨hy.2, hWx hy.1⟩).1⟩⟩
  -- Step 6: `H²(W ∩ Q) ≤ k H²(W ∩ Q) = M_W(C)`, as `k ≥ 1`
  rw [hmass W hW (hWx.trans hδ'), ← hWQ]
  exact le_mul_of_one_le_left zero_le (Nat.one_le_cast.2 hk)

/-- **Planar disc around a light point** (steps 7–10 of the proof of
`idtp_tdc_density_locally_constant`, the local constancy of the density of a two-dimensional
minimizing cone away from `0`; proof of Simon 7.3.3(1), case `n − d = 2`, chapter-07.txt
lines 497–510, where the structure of 2-dimensional minimizing cones is cited to [Whi82]).  Let
`C ∈ 𝒟₂(ℝᴾ)` be a minimizing cone with `∂C = 0`, `z ∈ spt C` with `|z| = 1`, `k ≥ 1`, with
`Θ²(μ_C, y) = k` for every `y ∈ spt C ∩ B_δ(z)`, and suppose that every `a ∈ spt C ∩ B_L(z)` with
`|a| = 1` and `Θ²(μ_C, a) = k` has a neighbourhood `B_δ'(a)` on which the density of `C` is a
constant `k'`.  Then there is a 2-plane `Q ∋ z` such that every `x ∈ Q ∩ B_ρ(z)`,
`ρ = min(1/2, L/4)`, has `ε > 0` with `spt C ∩ B_ε(x) = Q ∩ B_ε(x)`, `Θ²(μ_C, y) = k` on
`spt C ∩ B_ε(x)` and `H²(W ∩ Q) ≤ M_W(C)` for open `W ⊆ B_ε(x)`.  The plane `Q` at `z` comes from
`idtp_cone_constant_density_planar`, and `idtp_tdc_dlc_ld_orthonormal_partner` gives a unit
`e ∈ Q` with `e ⊥ z`.  The arc continuation along `±e` (`idtp_tdc_arc_continuation`) makes every
`cos φ·z + sin φ·(±e)`, `0 ≤ φ < L`, good; its endpoint hypothesis is the assumption on `a`, since
the arc point `a` is a unit vector with `|a − z| ≤ φ < L` (`idtp_tdc_dlc_ld_arc_point_bounds`).
Every unit `w ∈ Q` with `|w − z| < L/2` is such an arc point
(`idtp_tdc_dlc_ld_unit_vector_angle`).  For `x ∈ Q ∩ B_ρ(z)`, `|x| > 1/2` and `w = x/|x|` has
`|w − z| ≤ 2|x − z| < L/2` (`idtp_tdc_dlc_normalize_dist_le`); dilating the good ball of `w` by
`|x|` (`idtp_tdc_dlc_ld_cone_scale_piece`) makes `x` good, and
`idtp_tdc_dlc_ld_piece_mass_bound` shrinks its radius to add the mass bound. -/
theorem Submission.idtp_tdc_dlc_light_disc : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2) (z : Euclid P) (k : ℕ) (δ L : ℝ), IsMinimizingIn C univ → BoundaryVanishes C → IsConeCurrent C → z ∈ C.support → ‖z‖ = 1 → 1 ≤ k → 0 < δ → 0 < L → (∀ y ∈ C.support, y ∈ ball z δ → HasMassDensity C y k) → (∀ a ∈ C.support, ‖a‖ = 1 → a ∈ ball z L → HasMassDensity C a k → ∃ (δ' : ℝ) (k' : ℕ), 0 < δ' ∧ ∀ y ∈ C.support, y ∈ ball a δ' → HasMassDensity C y k') → ∃ Q : Submodule ℝ (Euclid P), Module.finrank ℝ Q = 2 ∧ z ∈ Q ∧ ∀ x ∈ (Q : Set (Euclid P)) ∩ ball z (min (1 / 2) (L / 4)), ∃ ε : ℝ, 0 < ε ∧ C.support ∩ ball x ε = (Q : Set (Euclid P)) ∩ ball x ε ∧ (∀ y ∈ C.support, y ∈ ball x ε → HasMassDensity C y k) ∧ ∀ W : Set (Euclid P), IsOpen W → W ⊆ ball x ε → μHE[2] (W ∩ (Q : Set (Euclid P))) ≤ C.massOn W := by
  intro P C z k δ L hmin hbd hcone hzC hz hk hδ hL hdens hconst
  have hz0 : z ≠ 0 := by
    rintro rfl
    rw [norm_zero] at hz
    exact zero_ne_one hz
  -- Step 1: the plane `Q ∋ z` with `spt C ∩ B_δ₁(z) = Q ∩ B_δ₁(z)`
  obtain ⟨δ₁, Q, hδ₁, hQ, hzQ, hC₁, -⟩ :=
    Submission.idtp_cone_constant_density_planar P C z k δ hmin hbd hcone hzC hz0 hδ hdens
  -- Step 2: a unit `e ∈ Q` with `e ⊥ z` and `w = ⟨w, z⟩ z + ⟨w, e⟩ e` for `w ∈ Q`
  obtain ⟨e, heQ, he, hze, hdecomp⟩ :=
    Submission.idtp_tdc_dlc_ld_orthonormal_partner P Q z hQ hzQ hz
  -- Step 3: for `v = ±e`, every arc point `cos φ • z + sin φ • v`, `0 ≤ φ < L`, is good
  have harc : ∀ v : Euclid P, (v = e ∨ v = -e) → ∀ φ : ℝ, 0 ≤ φ → φ < L → ∃ ε : ℝ, 0 < ε ∧
      C.support ∩ ball (Real.cos φ • z + Real.sin φ • v) ε =
        (Q : Set (Euclid P)) ∩ ball (Real.cos φ • z + Real.sin φ • v) ε ∧
      ∀ y ∈ C.support, y ∈ ball (Real.cos φ • z + Real.sin φ • v) ε → HasMassDensity C y k := by
    intro v hv
    have hvQ : v ∈ Q := by
      rcases hv with h | h <;> rw [h]
      · exact heQ
      · exact Q.neg_mem heQ
    have hv1 : ‖v‖ = 1 := by
      rcases hv with h | h <;> rw [h]
      · exact he
      · rw [norm_neg, he]
    have hzv : inner ℝ z v = (0 : ℝ) := by
      rcases hv with h | h <;> rw [h]
      · exact hze
      · rw [inner_neg_right, hze, neg_zero]
    refine Submission.idtp_tdc_arc_continuation P C Q z v k L hmin hbd hcone hQ hzQ hvQ hz hv1 hzv
      hk ?_ ?_
    -- (i) `z` is good with radius `min δ δ₁`
    · have hsub : ball z (min δ δ₁) ⊆ ball z δ₁ := ball_subset_ball (min_le_right δ δ₁)
      refine ⟨min δ δ₁, lt_min hδ hδ₁, ?_,
        fun y hy hyz => hdens y hy (ball_subset_ball (min_le_left δ δ₁) hyz)⟩
      rw [← inter_eq_right.2 hsub, ← inter_assoc, hC₁, inter_assoc]
    -- (ii) an arc point `a` of density `k` is a unit vector with `|a − z| ≤ φ < L`, so the
    -- hypothesis on `a` gives a constant density near `a`
    · intro φ hφ0 hφL ha hak
      obtain ⟨ha1, haz⟩ :=
        Submission.idtp_tdc_dlc_ld_arc_point_bounds P z v φ hz hv1 hzv hφ0.le
      refine hconst _ ha ha1 ?_ hak
      rw [mem_ball, dist_eq_norm]
      linarith
  -- Step 4: every unit `w ∈ Q` with `|w − z| < L/2` is an arc point, hence good
  have hunit : ∀ w ∈ Q, ‖w‖ = 1 → ‖w - z‖ < L / 2 → ∃ ε : ℝ, 0 < ε ∧
      C.support ∩ ball w ε = (Q : Set (Euclid P)) ∩ ball w ε ∧
      ∀ y ∈ C.support, y ∈ ball w ε → HasMassDensity C y k := by
    intro w hwQ hw hwz
    obtain ⟨θ, v, hθ0, hθL, hv, hwv⟩ :=
      Submission.idtp_tdc_dlc_ld_unit_vector_angle P z e w L hz he hze hw (hdecomp w hwQ) hwz
    rw [hwv]
    exact harc v hv θ hθ0 hθL
  refine ⟨Q, hQ, hzQ, ?_⟩
  rintro x ⟨hxQ, hxz⟩
  rw [mem_ball, dist_eq_norm] at hxz
  have hρ₁ : min (1 / 2 : ℝ) (L / 4) ≤ 1 / 2 := min_le_left _ _
  have hρ₂ : min (1 / 2 : ℝ) (L / 4) ≤ L / 4 := min_le_right _ _
  -- Step 5: `|x| > 1/2`, and `w = x/|x| ∈ Q` is a unit vector with `|w − z| ≤ 2|x − z| < L/2`
  have hx : 1 / 2 < ‖x‖ := by
    have h := norm_sub_norm_le z x
    rw [norm_sub_rev, hz] at h
    linarith
  have hx0 : x ≠ 0 := by
    rintro rfl
    rw [norm_zero] at hx
    linarith
  have hs : 0 < ‖x‖ := norm_pos_iff.mpr hx0
  have hw1 : ‖‖x‖⁻¹ • x‖ = 1 := by
    rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hs.ne']
  have hwz : ‖‖x‖⁻¹ • x - z‖ < L / 2 := by
    have h := Submission.idtp_tdc_dlc_normalize_dist_le P x z hx0 hz
    linarith
  -- `w` is good with some radius `ε`; dilating by `|x|` makes `x` good with radius `|x| ε`
  obtain ⟨ε, hε, hA, hB⟩ := hunit (‖x‖⁻¹ • x) (Q.smul_mem _ hxQ) hw1 hwz
  obtain ⟨hA', hB'⟩ :=
    Submission.idtp_tdc_dlc_ld_cone_scale_piece P C Q x k ‖x‖ ε hmin.1 hcone hs hA hB
  -- Step 6: shrink the radius to add `H²(W ∩ Q) ≤ M_W(C)` for open `W ⊆ B_ε(x)`
  exact Submission.idtp_tdc_dlc_ld_piece_mass_bound P C Q x k (‖x‖ * ε) hmin hbd hcone hk hxQ hx0
    (mul_pos hs hε) hA' hB'

/-- **Simon 7.3.3(1)**, display (15) and Lemma 3.5: if `S` is minimizing in `ℝᴾ`, `∂S = 0`, and
the density of `S` is invariant under `w ↦ y + λw` (`y ∈ L`, `λ > 0`) for a subspace `L` with
`dim L < n ≤ dim L + 2`, then `Θⁿ(μ_S, 0) ∈ ℕ`.  Splitting off the spine (Lemma 3.5) gives a
minimizing cone `S₀` of degree `n − dim L ∈ {1, 2}` with `∂S₀ = 0` and `Θ(μ_{S₀}, 0) = Θ(μ_S, 0)`;
its density at `0` is an integer by the classification of one- and two-dimensional minimizing
cones, and densities are unique. -/
theorem Submission.idod_spine_invariant_density_nat : ∀ (P n : ℕ) (S : GeometricCurrentOn (univ : Set (Euclid P)) n) (L : Submodule ℝ (Euclid P)) (θ₀ : ℝ), Module.finrank ℝ L < n → n ≤ Module.finrank ℝ L + 2 → IsMinimizingIn S univ → BoundaryVanishes S → (∀ y ∈ L, ∀ lam : ℝ, 0 < lam → ∀ (w : Euclid P) (θ : ℝ), HasMassDensity S w θ → HasMassDensity S (y + lam • w) θ) → HasMassDensity S 0 θ₀ → ∃ m : ℕ, θ₀ = m := by
  intro P n S L θ₀ hlt hle hmin hbd hinv hθ₀
  -- densities are unique: both limits live in the Hausdorff space `[0, ∞]`
  have huniq : ∀ (j : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) j) (a b : ℝ),
      HasMassDensity C 0 a → HasMassDensity C 0 b → a = b := fun _ _ _ _ ha hb =>
    (ENNReal.ofReal_eq_ofReal_iff ha.1 hb.1).1 (tendsto_nhds_unique ha.2 hb.2)
  -- Lemma 3.5: `S` splits as `L × S₀`, `S₀` a minimizing cone with `∂S₀ = 0`
  obtain ⟨-, -, S₀, hmin₀, hbd₀, hcone₀, -, -, hdens⟩ :=
    Submission.dimred_invariant_cone_splitting P n S L hlt hmin hbd hinv
  -- `Θ(μ_{S₀}, 0) = Θ(μ_S, 0 + 0) = θ₀`
  have h₀ : HasMassDensity S₀ 0 θ₀ :=
    (hdens 0 L.zero_mem 0 Lᗮ.zero_mem θ₀).1 (by rwa [add_zero])
  -- the degree `n − dim L` of `S₀` is `1` or `2`
  suffices key : ∀ (j : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) j), (j = 1 ∨ j = 2) →
      IsMinimizingIn C univ → BoundaryVanishes C → IsConeCurrent C → HasMassDensity C 0 θ₀ →
      ∃ m : ℕ, θ₀ = m from
    key _ S₀ (by omega) hmin₀ hbd₀ hcone₀ h₀
  rintro j C (rfl | rfl) hminC hbdC hconeC hC
  · -- a one-dimensional minimizing cone has density `m ∈ ℕ` along its line, in particular at `0`
    obtain ⟨e, m, -, -, hm⟩ := Submission.dimred_one_dim_minimizing_cone P C hminC hbdC hconeC
    exact ⟨m, huniq 1 C θ₀ m hC (hm 0 (Submodule.zero_mem _))⟩
  · -- a two-dimensional minimizing cone has density `m ∈ ℕ` at `0` ([Whi82])
    obtain ⟨m, hm⟩ := Submission.idtp_two_dim_cone_integer_density P C hminC hbdC hconeC
    exact ⟨m, huniq 2 C θ₀ m hC hm⟩

/-- Chapter 7 of Simon's *Introduction to GMT*: the headline results above. -/
theorem main_theorem : MinimizingImpliesStationary ∧ ExistenceOfMinimizingFilling ∧ CompactnessOfMinimizingCurrents ∧ DensityAndTangentCones ∧ IntegerDensityAndTangentPlanes ∧ RegularSetDense ∧ DensityOneImpliesRegular ∧ SingularSetSmallWhereDensityBelowTwo ∧ HalfSpaceConeLiesInBoundary ∧ CodimensionOneRegularity ∧ RegularComponentsAreMinimizing := by sorry
/-- **The density of a 2-dimensional minimizing cone is locally constant away from its vertex**
(proof of Simon 7.3.3(1), p. 191, for 2-dimensional minimizing cones; chapter-07.txt lines
497–510 cite [Whi82] for their structure).  Let `C ∈ 𝒟₂(ℝᴾ)` be a minimizing cone with `∂C = 0`
and `p ∈ spt C \ {0}`.  Then `Θ²(μ_C, ·)` is a constant `k ∈ ℕ` on `spt C ∩ B_δ(p)` for some
`δ > 0`.  Call a point *stable* if this holds there.  Stability is dilation invariant, so if `p`
is unstable, so is `p/|p|`; choose an unstable `b` with `|b| = 1` of least density `m₀`.  The
density `Θ` is upper semicontinuous, so `Θ ≤ m₀` on `spt C ∩ B_r(b)` and `Θ = m₀` at the unstable
unit points of `B_r(b)`.  As `b` is unstable, stable unit points `zᵢ → b` of density `kᵢ < m₀`
exist.  Each carries a planar disc `Qᵢ ∩ B_ρ(zᵢ)` of a fixed radius `ρ` with `μ_C ≥ H²⌞Qᵢ`
(`idtp_tdc_dlc_light_disc`).  Discs of this kind accumulating at an unstable point contradict the
finiteness of mass (`idtp_tdc_dlc_accumulating_discs`). -/
theorem Submission.idtp_tdc_density_locally_constant : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2), IsMinimizingIn C univ → BoundaryVanishes C → IsConeCurrent C → ∀ p ∈ C.support, p ≠ 0 → ∃ (δ : ℝ) (k : ℕ), 0 < δ ∧ ∀ y ∈ C.support, y ∈ ball p δ → HasMassDensity C y k := by
  intro P C hmin hbd hcone p hp hp0
  classical
  -- `q` is stable if `Θ²(μ_C, ·)` is a constant natural number on `spt C ∩ B_δ(q)`, some `δ > 0`
  set Stable : Euclid P → Prop := fun q => ∃ (δ : ℝ) (k : ℕ), 0 < δ ∧
    ∀ y ∈ C.support, y ∈ ball q δ → HasMassDensity C y k
  -- Steps 2–3: the density `Θ` is upper semicontinuous, a positive integer on `spt C \ {0}` and
  -- dilation invariant
  obtain ⟨Θ, hΘ, hΘusc, hΘint, hΘdil⟩ :=
    Submission.idtp_tdc_dlc_cone_density_function P C hmin hbd hcone ⟨p, hp, hp0⟩
  -- Fact (a): densities are unique
  have huniq : ∀ (y : Euclid P) (θ : ℝ), HasMassDensity C y θ → θ = Θ y := fun y θ h =>
    Submission.dimred_cs_mi_hasMassDensity_unique P 2 univ C y θ (Θ y) h (hΘ y)
  -- Step 4: stability is invariant under the dilations `x ↦ sx`, `s > 0`
  have hstab : ∀ (s : ℝ) (q : Euclid P), 0 < s → Stable (s • q) → Stable q := by
    rintro s q hs ⟨δ, k, hδ, hk⟩
    have hdil := Submission.idtp_tdc_cone_dilation P 2 C hmin.1 hcone s hs
    refine ⟨δ / s, k, div_pos hδ hs, fun y hy hyq => (hdil.2.2 y k).1
      (hk _ ((hdil.2.1 y).2 hy) ?_)⟩
    rw [mem_ball, dist_smul₀, Real.norm_of_nonneg hs.le]
    calc s * dist y q < s * (δ / s) := mul_lt_mul_of_pos_left (mem_ball.1 hyq) hs
      _ = δ := mul_div_cancel₀ δ hs.ne'
  -- Step 1: argue by contradiction; then `p/|p|` is an unstable point of the unit sphere
  by_contra hpS
  have hnp : 0 < ‖p‖ := norm_pos_iff.2 hp0
  have hex : ∃ m : ℕ, ∃ q ∈ C.support, ‖q‖ = 1 ∧ ¬ Stable q ∧ Θ q = m := by
    have hb' : ‖p‖⁻¹ • p ∈ C.support :=
      ((Submission.idtp_tdc_cone_dilation P 2 C hmin.1 hcone _ (inv_pos.2 hnp)).2.1 p).2 hp
    have hb'1 : ‖‖p‖⁻¹ • p‖ = 1 := by
      rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hnp.ne']
    obtain ⟨m, -, hm⟩ := hΘint _ hb' fun h => by
      rw [h, norm_zero] at hb'1
      exact zero_ne_one hb'1
    exact ⟨m, _, hb', hb'1, fun h => hpS (hstab _ p (inv_pos.2 hnp) h), hm⟩
  -- Step 5: an unstable unit point `b` of least density `m₀`
  obtain ⟨m₀, ⟨b, hb, hb1, hbS, hbΘ⟩, hm₀min⟩ : ∃ m₀ : ℕ,
      (∃ q ∈ C.support, ‖q‖ = 1 ∧ ¬ Stable q ∧ Θ q = m₀) ∧
        ∀ m : ℕ, (∃ q ∈ C.support, ‖q‖ = 1 ∧ ¬ Stable q ∧ Θ q = m) → m₀ ≤ m :=
    ⟨Nat.find hex, Nat.find_spec hex, fun m hm => Nat.find_min' hex hm⟩
  have hm₀le : ∀ q ∈ C.support, ‖q‖ = 1 → ¬ Stable q → (m₀ : ℝ) ≤ Θ q := by
    intro q hq hq1 hqS
    obtain ⟨m, -, hm⟩ := hΘint q hq fun h => by
      rw [h, norm_zero] at hq1
      exact zero_ne_one hq1
    rw [hm]
    exact_mod_cast hm₀min m ⟨q, hq, hq1, hqS, hm⟩
  -- upper semicontinuity at `b`: `Θ < m₀ + 1` on `B_r(b)`, `r ≤ 1/2`
  obtain ⟨r₀, hr₀, hr₀Θ⟩ := Metric.eventually_nhds_iff.1
    (hΘusc b ((m₀ : ℝ) + 1) (by show Θ b < (m₀ : ℝ) + 1; rw [hbΘ]; exact lt_add_one _))
  obtain ⟨r, hr0, hrr₀, hr12⟩ : ∃ r : ℝ, 0 < r ∧ r ≤ r₀ ∧ r ≤ 1 / 2 :=
    ⟨min r₀ (1 / 2), lt_min hr₀ (by norm_num), min_le_left _ _, min_le_right _ _⟩
  -- (5a) on `spt C ∩ B_r(b)` the density is a natural number in `[1, m₀]`
  have h5a : ∀ y ∈ C.support, dist y b < r → y ≠ 0 ∧ ∃ m : ℕ, 1 ≤ m ∧ m ≤ m₀ ∧ Θ y = m := by
    intro y hy hyb
    have hy0 : y ≠ 0 := by
      rintro rfl
      rw [dist_comm, dist_zero_right, hb1] at hyb
      linarith
    obtain ⟨m, hm1, hm⟩ := hΘint y hy hy0
    have hlt : (m : ℝ) < m₀ + 1 := hm ▸ hr₀Θ (lt_of_lt_of_le hyb hrr₀)
    exact ⟨hy0, m, hm1, Nat.lt_succ_iff.1 (by exact_mod_cast hlt), hm⟩
  -- (5b) the unstable unit points of `B_r(b)` have density exactly `m₀`
  have h5b : ∀ q ∈ C.support, ‖q‖ = 1 → ¬ Stable q → dist q b < r → Θ q = m₀ := by
    intro q hq hq1 hqS hqb
    obtain ⟨-, m, -, hm, hΘq⟩ := h5a q hq hqb
    have hle := hm₀le q hq hq1 hqS
    rw [hΘq] at hle ⊢
    exact_mod_cast le_antisymm hm (by exact_mod_cast hle)
  -- Step 6: stable unit points of density `< m₀` accumulate at `b`
  have hlight : ∀ η : ℝ, 0 < η → η ≤ r → ∃ (z : Euclid P) (k : ℕ) (δ : ℝ), z ∈ C.support ∧
      ‖z‖ = 1 ∧ dist z b < η ∧ 1 ≤ k ∧ k < m₀ ∧ 0 < δ ∧
      ∀ y ∈ C.support, y ∈ ball z δ → HasMassDensity C y k := by
    intro η hη hηr
    -- `b` is unstable: some `w ∈ spt C ∩ B_{η/2}(b)` has density `≠ m₀`, hence `< m₀`
    obtain ⟨w, hw, hwb, hwΘ⟩ : ∃ w ∈ C.support, w ∈ ball b (η / 2) ∧
        ¬ HasMassDensity C w m₀ := by
      by_contra h
      exact hbS ⟨η / 2, m₀, half_pos hη, fun w hw hwb =>
        Classical.byContradiction fun hwΘ => h ⟨w, hw, hwb, hwΘ⟩⟩
    obtain ⟨hw0, m, hm1, hmm₀, hΘw⟩ := h5a w hw (lt_of_lt_of_le (mem_ball.1 hwb) (by linarith))
    have hmlt : m < m₀ := lt_of_le_of_ne hmm₀ fun h => hwΘ (by rw [← h, ← hΘw]; exact hΘ w)
    -- `z = w/|w|` is a unit point of `spt C` with `|z − b| ≤ 2|w − b| < η` and `Θ(z) = m`
    have hnw : 0 < ‖w‖ := norm_pos_iff.2 hw0
    have hzC : ‖w‖⁻¹ • w ∈ C.support :=
      ((Submission.idtp_tdc_cone_dilation P 2 C hmin.1 hcone _ (inv_pos.2 hnw)).2.1 w).2 hw
    have hz1 : ‖‖w‖⁻¹ • w‖ = 1 := by
      rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hnw.ne']
    have hzb : dist (‖w‖⁻¹ • w) b < η := by
      rw [dist_eq_norm]
      calc ‖‖w‖⁻¹ • w - b‖ ≤ 2 * ‖w - b‖ :=
            Submission.idtp_tdc_dlc_normalize_dist_le P w b hw0 hb1
        _ < 2 * (η / 2) := mul_lt_mul_of_pos_left (mem_ball_iff_norm.1 hwb) two_pos
        _ = η := by ring
    have hΘz : Θ (‖w‖⁻¹ • w) = m := by rw [hΘdil _ _ (inv_pos.2 hnw), hΘw]
    -- `z` is stable by (5b), and its constant nearby density is `Θ(z) = m`
    have hzS : Stable (‖w‖⁻¹ • w) := by
      by_contra hzS'
      have h := h5b _ hzC hz1 hzS' (lt_of_lt_of_le hzb hηr)
      rw [hΘz] at h
      exact hmlt.ne (by exact_mod_cast h)
    obtain ⟨δ, k, hδ, hk⟩ := hzS
    have hkm : k = m := by
      have h := huniq _ _ (hk _ hzC (mem_ball_self hδ))
      rw [hΘz] at h
      exact_mod_cast h
    rw [hkm] at hk
    exact ⟨_, m, δ, hzC, hz1, hzb, hm1, hmlt, hδ, hk⟩
  -- the light points `zᵢ`, with `|zᵢ − b| < ηᵢ = (r/4)/(i + 1) → 0`
  have hη : ∀ i : ℕ, 0 < r / 4 * (1 / ((i : ℝ) + 1)) ∧ r / 4 * (1 / ((i : ℝ) + 1)) ≤ r / 4 := by
    intro i
    have h1 : 1 / ((i : ℝ) + 1) ≤ 1 := by
      rw [div_le_one (by positivity)]
      linarith [(Nat.cast_nonneg i : (0 : ℝ) ≤ i)]
    exact ⟨by positivity, mul_le_of_le_one_right (by positivity) h1⟩
  choose z k δ hzC hz1 hzb hk1 hkm₀ hδ hkδ using fun i : ℕ =>
    hlight (r / 4 * (1 / ((i : ℝ) + 1))) (hη i).1 (by linarith [(hη i).2])
  -- Steps 7–10: each `zᵢ` carries a planar disc `Qᵢ ∩ B_ρ(zᵢ)`, `ρ = min(1/2, r/8)`, near whose
  -- points `spt C = Qᵢ`, `Θ = kᵢ` and `μ_C ≥ H²⌞Qᵢ`
  have hdisc : ∀ i, ∃ Q : Submodule ℝ (Euclid P), Module.finrank ℝ Q = 2 ∧ z i ∈ Q ∧
      ∀ x ∈ (Q : Set (Euclid P)) ∩ ball (z i) (min (1 / 2) (r / 2 / 4)), ∃ ε : ℝ, 0 < ε ∧
        C.support ∩ ball x ε = (Q : Set (Euclid P)) ∩ ball x ε ∧
        (∀ y ∈ C.support, y ∈ ball x ε → HasMassDensity C y (k i)) ∧
        ∀ W : Set (Euclid P), IsOpen W → W ⊆ ball x ε →
          μHE[2] (W ∩ (Q : Set (Euclid P))) ≤ C.massOn W := by
    intro i
    refine Submission.idtp_tdc_dlc_light_disc P C (z i) (k i) (δ i) (r / 2) hmin hbd hcone
      (hzC i) (hz1 i) (hk1 i) (hδ i) (half_pos hr0) (hkδ i) ?_
    -- a unit point `a ∈ spt C ∩ B_{r/2}(zᵢ)` of density `kᵢ < m₀` lies in `B_r(b)`; were it
    -- unstable, (5b) would give it density `m₀`
    intro a ha ha1 haz hak
    by_contra haS
    have hab : dist a b < r := by
      calc dist a b ≤ dist a (z i) + dist (z i) b := dist_triangle _ _ _
        _ < r / 2 + r / 4 := add_lt_add (mem_ball.1 haz) ((hzb i).trans_le (hη i).2)
        _ < r := by linarith
    have h := h5b a ha ha1 haS hab
    rw [← huniq a _ hak] at h
    exact (hkm₀ i).ne (by exact_mod_cast h)
  choose Q hQ2 hzQ hQdisc using hdisc
  -- Steps 11–14: planar discs of a fixed radius accumulating at the unstable point `b`
  -- contradict the finiteness of mass
  have hlim : Tendsto z atTop (𝓝 b) := by
    rw [tendsto_iff_dist_tendsto_zero]
    refine squeeze_zero (fun i => dist_nonneg) (fun i => (hzb i).le) ?_
    simpa only [mul_zero] using tendsto_one_div_add_atTop_nhds_zero_nat.const_mul (r / 4)
  exact Submission.idtp_tdc_dlc_accumulating_discs P C Q z k b (min (1 / 2) (r / 2 / 4)) hmin.1
    (lt_min (by norm_num) (by positivity)) hQ2 hzQ hlim hQdisc hbS
/-- Uniqueness of planes in the proof of Simon 7.3.3(1) (p. 191: `spt S₀` lies in finitely many
2-planes `Pᵢ` with `Pᵢ ∩ Pⱼ = {0}`): linear subspaces `Q₁, Q₂` of `ℝᴾ` that agree on a ball
`B_t(x)`, `t > 0`, about a point `x ∈ Q₁` are equal.  First, `x ∈ Q₁ ∩ B_t(x) = Q₂ ∩ B_t(x)`
gives `x ∈ Q₂`.  For `v ∈ Q₁` and `s = t / (2(|v| + 1)) > 0` we have `|s v| < t`, so `x + s v`
lies in `Q₁ ∩ B_t(x) = Q₂ ∩ B_t(x)`; hence `s v ∈ Q₂` and `v ∈ Q₂`.  Exchanging `Q₁` and `Q₂`,
antisymmetry gives `Q₁ = Q₂`. -/
theorem Submission.idtp_tdc_csfp_subspace_eq_of_inter_ball : ∀ (P : ℕ) (Q₁ Q₂ : Submodule ℝ (Euclid P)) (x : Euclid P) (t : ℝ), x ∈ Q₁ → 0 < t → (Q₁ : Set (Euclid P)) ∩ ball x t = (Q₂ : Set (Euclid P)) ∩ ball x t → Q₁ = Q₂ := by
  intro P Q₁ Q₂ x t hx ht h
  -- Step 1: `x ∈ Q₁ ∩ B_t(x) = Q₂ ∩ B_t(x)`, so `x ∈ Q₂`
  have hx₂ : x ∈ Q₂ := by
    have hx' : x ∈ (Q₁ : Set (Euclid P)) ∩ ball x t := ⟨hx, mem_ball_self ht⟩
    rw [h] at hx'
    exact hx'.1
  -- Step 2: if `x ∈ A`, `x ∈ B` and `A ∩ B_t(x) = B ∩ B_t(x)`, then `A ≤ B`
  have key : ∀ A B : Submodule ℝ (Euclid P), x ∈ A → x ∈ B →
      (A : Set (Euclid P)) ∩ ball x t = (B : Set (Euclid P)) ∩ ball x t → A ≤ B := by
    intro A B hxA hxB hAB v hv
    -- `s := t / (2(|v| + 1)) > 0` has `s |v| ≤ s (|v| + 1) = t / 2 < t`
    obtain ⟨s, hs, hsv⟩ : ∃ s : ℝ, 0 < s ∧ s * ‖v‖ < t := by
      refine ⟨t / (2 * (‖v‖ + 1)), by positivity, ?_⟩
      calc t / (2 * (‖v‖ + 1)) * ‖v‖ ≤ t / (2 * (‖v‖ + 1)) * (‖v‖ + 1) := by gcongr; linarith
        _ = t / 2 := by field_simp
        _ < t := half_lt_self ht
    -- `y := x + s v ∈ A ∩ B_t(x) = B ∩ B_t(x)`, so `s v = y − x ∈ B` and `v = s⁻¹ (s v) ∈ B`
    have hy : x + s • v ∈ (A : Set (Euclid P)) ∩ ball x t := ⟨A.add_mem hxA (A.smul_mem s hv), by
      rwa [mem_ball, dist_self_add_left, norm_smul_of_nonneg hs.le]⟩
    rw [hAB] at hy
    exact (B.smul_mem_iff hs.ne').1 ((B.add_mem_iff_right hxB).1 hy.1)
  -- Step 3: `Q₁ ≤ Q₂` and `Q₂ ≤ Q₁`
  exact le_antisymm (key Q₁ Q₂ hx hx₂ h) (key Q₂ Q₁ hx₂ hx h.symm)

/-- Propagation along the great circle in the proof of Simon 7.3.3(1) (p. 191: `spt S₀` lies in
finitely many 2-planes `Pᵢ` with `Pᵢ ∩ Pⱼ = {0}`): if a closed set `S ⊆ ℝᴾ` is a 2-plane near each
of its nonzero points and agrees with the 2-plane `Q` near one unit vector `x₀ ∈ Q`, then `S`
agrees with `Q` near every unit vector of `Q`.  The great circle `K = Q ∩ 𝕊` is preconnected: two
non-antipodal points of `K` lie on the radial projection of the segment joining them, which
avoids `0`, and antipodal points are joined through a third unit vector of `Q` (`dim Q = 2`).  The
set `A` of points near which `S` agrees with `Q` is open, contains `x₀`, and `A ∩ Q ⊆ S`.  A point
of `K` outside `A` has a ball free of `A ∩ Q`: off `S` because `S` is closed, and on `S` because
its local plane `Q' ≠ Q` would agree with `Q` near a point of `A ∩ Q`
(`idtp_tdc_csfp_subspace_eq_of_inter_ball`).  So the open sets `A` and `(closure (A ∩ Q))ᶜ`
would separate `K` unless `K ⊆ A`. -/
theorem Submission.idtp_tdc_csfp_great_circle_local_plane : ∀ (P : ℕ) (S : Set (Euclid P)) (Q : Submodule ℝ (Euclid P)) (x₀ : Euclid P) (ε₀ : ℝ), IsClosed S → (∀ p ∈ S, p ≠ 0 → ∃ (δ : ℝ) (Q' : Submodule ℝ (Euclid P)), 0 < δ ∧ Module.finrank ℝ Q' = 2 ∧ S ∩ ball p δ = (Q' : Set (Euclid P)) ∩ ball p δ) → Module.finrank ℝ Q = 2 → x₀ ∈ Q → ‖x₀‖ = 1 → 0 < ε₀ → S ∩ ball x₀ ε₀ = (Q : Set (Euclid P)) ∩ ball x₀ ε₀ → ∀ x : Euclid P, x ∈ Q → ‖x‖ = 1 → ∃ ε : ℝ, 0 < ε ∧ S ∩ ball x ε = (Q : Set (Euclid P)) ∩ ball x ε := by
  intro P S Q x₀ ε₀ hS hloc hQ hx₀Q hx₀ hε₀ hx₀ε₀
  -- Agreement of two sets on a set `U` persists on every `V ⊆ U`
  have hres : ∀ {T₁ T₂ U V : Set (Euclid P)}, V ⊆ U → T₁ ∩ U = T₂ ∩ U → T₁ ∩ V = T₂ ∩ V := by
    intro T₁ T₂ U V hVU h
    rw [← inter_eq_right.2 hVU, ← inter_assoc, h, inter_assoc]
  -- Step 1: the great circle `K = Q ∩ 𝕊` is preconnected
  set K : Set (Euclid P) := (Q : Set (Euclid P)) ∩ sphere 0 1
  have hx₀K : x₀ ∈ K := ⟨hx₀Q, mem_sphere_zero_iff_norm.2 hx₀⟩
  have hKconn : IsPreconnected K := by
    -- (i) `a, b ∈ K` with `a + b ≠ 0` lie on the arc `z ↦ z / |z|` of the segment `[a, b] ∌ 0`
    have harc : ∀ a ∈ K, ∀ b ∈ K, a + b ≠ 0 → ∃ t ⊆ K, a ∈ t ∧ b ∈ t ∧ IsPreconnected t := by
      rintro a ⟨haQ, ha⟩ b ⟨hbQ, hb⟩ hab
      rw [mem_sphere_zero_iff_norm] at ha hb
      -- `s a + t b = 0` with `s, t ≥ 0`, `s + t = 1` forces `s = t = 1 / 2` and `a + b = 0`
      have h0 : ∀ z ∈ segment ℝ a b, z ≠ 0 := by
        rintro _ ⟨s, t, hs, ht, hst, rfl⟩ h0
        have hts : s = t := by
          have h := congrArg norm (eq_neg_of_add_eq_zero_left h0)
          rwa [norm_neg, norm_smul, norm_smul, ha, hb, Real.norm_of_nonneg hs,
            Real.norm_of_nonneg ht, mul_one, mul_one] at h
        subst hts
        rw [← smul_add] at h0
        exact hab ((smul_eq_zero.1 h0).resolve_left (by linarith))
      refine ⟨(fun z => ‖z‖⁻¹ • z) '' segment ℝ a b, ?_,
        ⟨a, left_mem_segment ℝ a b, by simp [ha]⟩, ⟨b, right_mem_segment ℝ a b, by simp [hb]⟩,
        (convex_segment a b).isPreconnected.image _ ?_⟩
      · rintro _ ⟨z, hz, rfl⟩
        refine ⟨Q.smul_mem _ (Q.convex.segment_subset haQ hbQ hz), ?_⟩
        rw [mem_sphere_zero_iff_norm, norm_smul, norm_inv, norm_norm,
          inv_mul_cancel₀ (norm_ne_zero_iff.2 (h0 z hz))]
      · exact (continuous_norm.continuousOn.inv₀ fun z hz => norm_ne_zero_iff.2 (h0 z hz)).smul
          continuousOn_id
    -- (ii) as `dim Q = 2 > 1 = dim ℝx₀`, some unit vector `w ∈ Q` is neither `x₀` nor `-x₀`
    obtain ⟨w, hwK, hw₁, hw₂⟩ : ∃ w ∈ K, x₀ + w ≠ 0 ∧ w + -x₀ ≠ 0 := by
      have hx₀0 : x₀ ≠ 0 := norm_ne_zero_iff.1 (by rw [hx₀]; exact one_ne_zero)
      obtain ⟨q, hqQ, hq⟩ : ∃ q ∈ Q, q ∉ Submodule.span ℝ {x₀} := by
        by_contra! h
        have h' := Submodule.finrank_mono (show Q ≤ Submodule.span ℝ {x₀} from h)
        rw [hQ, finrank_span_singleton hx₀0] at h'
        norm_num at h'
      have hq0 : ‖q‖ ≠ 0 := norm_ne_zero_iff.2 fun h => hq (h ▸ Submodule.zero_mem _)
      have hw : ∀ c : ℝ, ‖q‖⁻¹ • q ≠ c • x₀ := fun c h => hq <| by
        rw [← smul_inv_smul₀ hq0 q, h]
        exact Submodule.smul_mem _ _ (Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self x₀))
      refine ⟨‖q‖⁻¹ • q, ⟨Q.smul_mem _ hqQ, ?_⟩, fun h => hw (-1) ?_, fun h => hw 1 ?_⟩
      · rw [mem_sphere_zero_iff_norm, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hq0]
      · rw [neg_one_smul]
        exact eq_neg_of_add_eq_zero_right h
      · rw [one_smul]
        exact add_neg_eq_zero.1 h
    -- (iii) each `y ∈ K` is joined to `x₀` by one arc, or by two arcs through `w` if `y = -x₀`
    refine isPreconnected_of_forall x₀ fun y hy => ?_
    by_cases hxy : x₀ + y = 0
    · obtain ⟨t₁, ht₁K, hx₀t₁, hwt₁, ht₁⟩ := harc x₀ hx₀K w hwK hw₁
      obtain ⟨t₂, ht₂K, hwt₂, hyt₂, ht₂⟩ :=
        harc w hwK y hy (by rwa [eq_neg_of_add_eq_zero_right hxy])
      exact ⟨t₁ ∪ t₂, union_subset ht₁K ht₂K, Or.inl hx₀t₁, Or.inr hyt₂,
        IsPreconnected.union w hwt₁ hwt₂ ht₁ ht₂⟩
    · exact harc x₀ hx₀K y hy hxy
  -- Step 2: the set `A` of points near which `S` agrees with `Q` is open
  set A : Set (Euclid P) :=
    {y | ∃ ε : ℝ, 0 < ε ∧ S ∩ ball y ε = (Q : Set (Euclid P)) ∩ ball y ε}
  have hAopen : IsOpen A := by
    refine Metric.isOpen_iff.2 fun y hy => ?_
    obtain ⟨ε, hε, hyε⟩ := hy
    refine ⟨ε, hε, fun y' hy' => ⟨ε - dist y' y, sub_pos.2 (mem_ball.1 hy'), ?_⟩⟩
    exact hres (ball_subset_ball' (sub_add_cancel _ _).le) hyε
  -- Step 3: `A ∩ Q ⊆ S`
  have hAQS : ∀ y ∈ A, y ∈ Q → y ∈ S := by
    rintro y ⟨ε, hε, hyε⟩ hyQ
    exact (hyε.ge ⟨hyQ, mem_ball_self hε⟩).1
  -- Step 4: a point of `K` outside `A` is not in `closure (A ∩ Q)`
  have hfar : ∀ x ∈ K, x ∉ A → x ∉ closure (A ∩ (Q : Set (Euclid P))) := by
    intro x hxK hxA hxcl
    rw [Metric.mem_closure_iff] at hxcl
    by_cases hxS : x ∈ S
    · -- (b) `S` is a plane `Q' ≠ Q` on `B_δ(x)`; for `y ∈ A ∩ Q` with `|x - y| < δ / 2`, `Q`
      -- and `Q'` agree with `S` on `B_τ(y)`, `τ = min(ε_y, δ / 2)`, so `Q = Q'`
      have hx0 : x ≠ 0 :=
        norm_ne_zero_iff.1 (by rw [mem_sphere_zero_iff_norm.1 hxK.2]; exact one_ne_zero)
      obtain ⟨δ, Q', hδ, -, hxδ⟩ := hloc x hxS hx0
      have hQ' : Q' ≠ Q := by
        rintro rfl
        exact hxA ⟨δ, hδ, hxδ⟩
      obtain ⟨y, ⟨⟨εy, hεy, hyεy⟩, hyQ⟩, hxy⟩ := hxcl (δ / 2) (half_pos hδ)
      obtain ⟨τ, hτ, hτy, hτδ⟩ : ∃ τ : ℝ, 0 < τ ∧ τ ≤ εy ∧ τ ≤ δ / 2 :=
        ⟨min εy (δ / 2), lt_min hεy (half_pos hδ), min_le_left _ _, min_le_right _ _⟩
      have hτx : ball y τ ⊆ ball x δ := ball_subset_ball' (by rw [dist_comm]; linarith)
      exact hQ' (Submission.idtp_tdc_csfp_subspace_eq_of_inter_ball P Q Q' y τ hyQ hτ
        ((hres (ball_subset_ball hτy) hyεy).symm.trans (hres hτx hxδ))).symm
    · -- (a) a ball around `x` misses the closed set `S ⊇ A ∩ Q`
      obtain ⟨r, hr, hrS⟩ := Metric.isOpen_iff.1 hS.isOpen_compl x hxS
      obtain ⟨y, ⟨hyA, hyQ⟩, hxy⟩ := hxcl r hr
      exact hrS (mem_ball'.2 hxy) (hAQS y hyA hyQ)
  -- Step 5: `A` and `(closure (A ∩ Q))ᶜ` are open and cover `K` (Step 4); both meet `K` if
  -- `K ⊄ A`, but no point of `K ∩ A ⊆ A ∩ Q` lies outside `closure (A ∩ Q)`
  have hKA : K ⊆ A := by
    intro x hxK
    by_contra hxA
    obtain ⟨z, hzK, hzA, hzv⟩ := hKconn A (closure (A ∩ (Q : Set (Euclid P))))ᶜ hAopen
      isClosed_closure.isOpen_compl (fun y hy => (em (y ∈ A)).imp id (hfar y hy))
      ⟨x₀, hx₀K, ε₀, hε₀, hx₀ε₀⟩ ⟨x, hxK, hfar x hxK hxA⟩
    exact hzv (subset_closure ⟨hzA, hzK.1⟩)
  -- Step 6: every unit vector of `Q` lies in `K ⊆ A`
  intro x hxQ hx
  exact hKA ⟨hxQ, mem_sphere_zero_iff_norm.2 hx⟩

/-- Two seeded 2-planes of a closed, locally planar set are equal or meet only in `0` (proof of
Simon 7.3.3(1), pp. 191–192: `spt S₀` lies in 2-planes `P₁, …, P_q` with `Pᵢ ∩ Pⱼ = {0}` for
`i ≠ j`).  Here `S ⊆ ℝᴾ` is closed and locally a 2-plane near each `p ∈ S ∖ {0}`, and
`S ∩ B_{δᵢ}(pᵢ) = Qᵢ ∩ B_{δᵢ}(pᵢ)` for 2-planes `Qᵢ` and unit vectors `pᵢ ∈ Qᵢ`.  If
`Q₁ ⊓ Q₂ ≠ ⊥`, normalise a nonzero common vector to a unit vector `u ∈ Q₁ ∩ Q₂`.  Propagating
local planarity along the great circles of `Q₁` and `Q₂` gives `S ∩ B_{εᵢ}(u) = Qᵢ ∩ B_{εᵢ}(u)`,
so `Q₁` and `Q₂` agree on `B_t(u)`, `t = min(ε₁, ε₂)`, whence `Q₁ = Q₂`. -/
theorem Submission.idtp_tdc_csfp_planes_eq_or_inf_bot : ∀ (P : ℕ) (S : Set (Euclid P)) (Q₁ Q₂ : Submodule ℝ (Euclid P)) (p₁ p₂ : Euclid P) (δ₁ δ₂ : ℝ), IsClosed S → (∀ p ∈ S, p ≠ 0 → ∃ (δ : ℝ) (Q : Submodule ℝ (Euclid P)), 0 < δ ∧ Module.finrank ℝ Q = 2 ∧ S ∩ ball p δ = (Q : Set (Euclid P)) ∩ ball p δ) → Module.finrank ℝ Q₁ = 2 → Module.finrank ℝ Q₂ = 2 → p₁ ∈ Q₁ → ‖p₁‖ = 1 → 0 < δ₁ → S ∩ ball p₁ δ₁ = (Q₁ : Set (Euclid P)) ∩ ball p₁ δ₁ → p₂ ∈ Q₂ → ‖p₂‖ = 1 → 0 < δ₂ → S ∩ ball p₂ δ₂ = (Q₂ : Set (Euclid P)) ∩ ball p₂ δ₂ → Q₁ = Q₂ ∨ Q₁ ⊓ Q₂ = ⊥ := by
  intro P S Q₁ Q₂ p₁ p₂ δ₁ δ₂ hS hloc hQ₁ hQ₂ hp₁ hp₁n hδ₁ hS₁ hp₂ hp₂n hδ₂ hS₂
  -- if `Q₁ ⊓ Q₂ ≠ ⊥`, there is a nonzero `v ∈ Q₁ ∩ Q₂`
  rcases eq_or_ne (Q₁ ⊓ Q₂) ⊥ with hbot | hbot
  · exact Or.inr hbot
  refine Or.inl ?_
  obtain ⟨v, hv, hv0⟩ := (Submodule.ne_bot_iff _).1 hbot
  obtain ⟨hv₁, hv₂⟩ := Submodule.mem_inf.1 hv
  -- `u = |v|⁻¹ v` is a common unit vector
  obtain ⟨u, hu₁, hu₂, hun⟩ : ∃ u : Euclid P, u ∈ Q₁ ∧ u ∈ Q₂ ∧ ‖u‖ = 1 :=
    ⟨‖v‖⁻¹ • v, Q₁.smul_mem _ hv₁, Q₂.smul_mem _ hv₂, by
      rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ (norm_ne_zero_iff.2 hv0)]⟩
  -- along the great circles through `p₁` and `p₂`, `S` is locally `Q₁` and locally `Q₂` at `u`
  obtain ⟨ε₁, hε₁, h₁⟩ := Submission.idtp_tdc_csfp_great_circle_local_plane P S Q₁ p₁ δ₁ hS hloc
    hQ₁ hp₁ hp₁n hδ₁ hS₁ u hu₁ hun
  obtain ⟨ε₂, hε₂, h₂⟩ := Submission.idtp_tdc_csfp_great_circle_local_plane P S Q₂ p₂ δ₂ hS hloc
    hQ₂ hp₂ hp₂n hδ₂ hS₂ u hu₂ hun
  -- so `Q₁ ∩ B_t(u) = S ∩ B_t(u) = Q₂ ∩ B_t(u)` for `t = min(ε₁, ε₂)`, and `Q₁ = Q₂`
  obtain ⟨t, ht, ht₁, ht₂⟩ : ∃ t : ℝ, 0 < t ∧ t ≤ ε₁ ∧ t ≤ ε₂ :=
    ⟨min ε₁ ε₂, lt_min hε₁ hε₂, min_le_left _ _, min_le_right _ _⟩
  have hshrink : ∀ (A : Set (Euclid P)) (ε : ℝ), t ≤ ε → A ∩ ball u ε ∩ ball u t = A ∩ ball u t :=
    fun A ε hε => by rw [inter_assoc, inter_eq_right.2 (ball_subset_ball hε)]
  refine Submission.idtp_tdc_csfp_subspace_eq_of_inter_ball P Q₁ Q₂ u t hu₁ ht ?_
  calc (Q₁ : Set (Euclid P)) ∩ ball u t = (Q₁ : Set (Euclid P)) ∩ ball u ε₁ ∩ ball u t :=
        (hshrink _ _ ht₁).symm
    _ = S ∩ ball u ε₁ ∩ ball u t := by rw [h₁]
    _ = S ∩ ball u t := hshrink _ _ ht₁
    _ = S ∩ ball u ε₂ ∩ ball u t := (hshrink _ _ ht₂).symm
    _ = (Q₂ : Set (Euclid P)) ∩ ball u ε₂ ∩ ball u t := by rw [h₂]
    _ = (Q₂ : Set (Euclid P)) ∩ ball u t := hshrink _ _ ht₂

/-- Finitely many planes in the proof of Simon 7.3.3(1) (p. 191: `spt S₀` lies in 2-planes
`P₁, …, P_q` with `Pᵢ ∩ Pⱼ = {0}` for `i ≠ j`): a closed dilation-invariant set `S ⊆ ℝᴾ` that is
a 2-plane near each `p ∈ S ∖ {0}` has `S ∖ {0}` inside finitely many 2-planes meeting pairwise
only in `0`.  Choose `δ_p`, `Q_p` with `S ∩ B_{δ_p}(p) = Q_p ∩ B_{δ_p}(p)` (so `p ∈ Q_p`).  The
link `Σ = S ∩ 𝕊` is compact, so finitely many balls `B_{δ_p}(p)`, `p ∈ F ⊆ Σ`, cover it; enumerate
the finite set `{Q_p : p ∈ F}` injectively.  Distinct planes of it meet only in `0`
(`idtp_tdc_csfp_planes_eq_or_inf_bot`).  For `x ∈ S ∖ {0}`, `x̂ = |x|⁻¹ x ∈ Σ` by dilation
invariance; it lies in some `S ∩ B_{δ_p}(p) = Q_p ∩ B_{δ_p}(p)`, `p ∈ F`, so `x = |x| x̂ ∈ Q_p`. -/
theorem Submission.idtp_tdc_cone_set_finite_planes : ∀ (P : ℕ) (S : Set (Euclid P)), IsClosed S → (∀ x ∈ S, ∀ s : ℝ, 0 < s → s • x ∈ S) → (∀ p ∈ S, p ≠ 0 → ∃ (δ : ℝ) (Q : Submodule ℝ (Euclid P)), 0 < δ ∧ Module.finrank ℝ Q = 2 ∧ S ∩ ball p δ = (Q : Set (Euclid P)) ∩ ball p δ) → ∃ (q : ℕ) (Ps : Fin q → Submodule ℝ (Euclid P)), (∀ i, Module.finrank ℝ (Ps i) = 2) ∧ (∀ i j, i ≠ j → Ps i ⊓ Ps j = ⊥) ∧ ∀ x ∈ S, x ≠ 0 → ∃ i, x ∈ Ps i := by
  intro P S hS hdil hloc
  classical
  -- Step 1: a radius `δ p` and a plane `Q p` with `S ∩ B_{δ p}(p) = Q p ∩ B_{δ p}(p)` for every
  -- `p ∈ S ∖ {0}`; then `p ∈ Q p`
  have hloc' := hloc
  choose! δ Q hδ hQ hSQ using hloc'
  have hpQ : ∀ p ∈ S, p ≠ 0 → p ∈ Q p := by
    intro p hp hp0
    have h : p ∈ S ∩ ball p (δ p) := ⟨hp, mem_ball_self (hδ p hp hp0)⟩
    rw [hSQ p hp hp0] at h
    exact h.1
  -- Step 2: the link `L = S ∩ 𝕊` is compact and consists of nonzero unit vectors of `S`
  set L : Set (Euclid P) := S ∩ sphere 0 1
  have hLc : IsCompact L := (isCompact_sphere 0 1).inter_left hS
  have hL : ∀ p ∈ L, p ∈ S ∧ p ≠ 0 ∧ ‖p‖ = 1 := by
    rintro p ⟨hp, hp1⟩
    rw [mem_sphere_zero_iff_norm] at hp1
    exact ⟨hp, norm_ne_zero_iff.1 (by rw [hp1]; exact one_ne_zero), hp1⟩
  -- Step 3: finitely many balls `B_{δ p}(p)`, `p ∈ F ⊆ L`, cover `L`
  obtain ⟨F, hFL, hcov⟩ := hLc.elim_nhds_subcover (fun p => ball p (δ p))
    fun p hp => ball_mem_nhds p (hδ p (hL p hp).1 (hL p hp).2.1)
  -- Step 4: enumerate the finite set of planes `{Q p : p ∈ F}` injectively by `Fin q`
  set planes : Finset (Submodule ℝ (Euclid P)) := F.image Q
  have hplanes : ∀ R ∈ planes, ∃ p ∈ L, Q p = R := by
    intro R hR
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.1 hR
    exact ⟨p, hFL p hp, rfl⟩
  refine ⟨planes.card, fun i => planes.equivFin.symm i, fun i => ?_, fun i j hij => ?_,
    fun x hx hx0 => ?_⟩
  · -- each plane is some `Q p`, `p ∈ L`, of dimension 2
    obtain ⟨p, hp, hpR⟩ := hplanes _ (planes.equivFin.symm i).2
    show Module.finrank ℝ (planes.equivFin.symm i : Submodule ℝ (Euclid P)) = 2
    rw [← hpR]
    exact hQ p (hL p hp).1 (hL p hp).2.1
  · -- distinct planes `Q p ≠ Q p'` meet only in `0`
    obtain ⟨p, hp, hpR⟩ := hplanes _ (planes.equivFin.symm i).2
    obtain ⟨p', hp', hp'R⟩ := hplanes _ (planes.equivFin.symm j).2
    obtain ⟨hpS, hp0, hp1⟩ := hL p hp
    obtain ⟨hp'S, hp'0, hp'1⟩ := hL p' hp'
    show (planes.equivFin.symm i : Submodule ℝ (Euclid P)) ⊓ planes.equivFin.symm j = ⊥
    rw [← hpR, ← hp'R]
    refine (Submission.idtp_tdc_csfp_planes_eq_or_inf_bot P S (Q p) (Q p') p p' (δ p) (δ p') hS
      hloc (hQ p hpS hp0) (hQ p' hp'S hp'0) (hpQ p hpS hp0) hp1 (hδ p hpS hp0) (hSQ p hpS hp0)
      (hpQ p' hp'S hp'0) hp'1 (hδ p' hp'S hp'0) (hSQ p' hp'S hp'0)).resolve_left fun h => hij ?_
    exact planes.equivFin.symm.injective (Subtype.ext (hpR.symm.trans (h.trans hp'R)))
  · -- `x̂ = |x|⁻¹ x ∈ L` lies in a ball `B_{δ p}(p)`, `p ∈ F`, so `x̂ ∈ Q p` and `x = |x| x̂ ∈ Q p`
    have hxn : 0 < ‖x‖ := norm_pos_iff.2 hx0
    have hxL : ‖x‖⁻¹ • x ∈ L := ⟨hdil x hx _ (inv_pos.2 hxn), by
      rw [mem_sphere_zero_iff_norm, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hxn.ne']⟩
    obtain ⟨p, hpF, hxp⟩ := mem_iUnion₂.1 (hcov hxL)
    obtain ⟨hpS, hp0, -⟩ := hL p (hFL p hpF)
    have hxQ : ‖x‖⁻¹ • x ∈ Q p := by
      have h : ‖x‖⁻¹ • x ∈ S ∩ ball p (δ p) := ⟨hxL.1, hxp⟩
      rw [hSQ p hpS hp0] at h
      exact h.1
    have hxQ' : x ∈ Q p := by
      have h := (Q p).smul_mem ‖x‖ hxQ
      rwa [smul_inv_smul₀ hxn.ne'] at h
    have hQp : Q p ∈ planes := Finset.mem_image_of_mem Q hpF
    refine ⟨planes.equivFin ⟨Q p, hQp⟩, ?_⟩
    show x ∈ (planes.equivFin.symm (planes.equivFin ⟨Q p, hQp⟩) : Submodule ℝ (Euclid P))
    rw [Equiv.symm_apply_apply]
    exact hxQ'
/-- **The mass measure of a current carried by planes through `0` splits over the punctured
planes** (used in the proof of Simon 7.3.3(1), pp. 191–192, for a 2-dimensional minimizing cone
with `spt S₀ ⊆ ⋃ᵢ Pᵢ`, `Pᵢ ∩ Pⱼ = {0}`).  Let `C = τ(M, θ, ξ)` in `ℝᴾ`, `n ≥ 1`, `μ = θHⁿ⌞M`, and
let `P₁, …, P_q` be linear subspaces with `Pᵢ ∩ Pⱼ = {0}` for `i ≠ j` and `spt C ∖ {0} ⊆ ⋃ᵢ Pᵢ`.
Then `μ(A) = Σᵢ μ(A ∩ (Pᵢ ∖ {0}))` for every Borel `A`.  `Hⁿ({0}) = 0` and `μ ≪ Hⁿ` give
`μ({0}) = 0`; `spt μ ⊆ spt C` (`dimred_im_mass_measure`) and `μ(ℝᴾ ∖ spt μ) = 0`, so
`A ∖ ⋃ᵢ Aᵢ ⊆ {0} ∪ (ℝᴾ ∖ spt μ)` is `μ`-null, where the `Aᵢ = A ∩ (Pᵢ ∖ {0})` are Borel and
pairwise disjoint. -/
theorem Submission.idtp_tdc_puvd_measure_eq_sum_planes : ∀ (P n q : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n) (Ps : Fin q → Submodule ℝ (Euclid P)), 1 ≤ n → R.Represents C → (∀ i j, i ≠ j → Ps i ⊓ Ps j = ⊥) → (∀ x ∈ C.support, x ≠ 0 → ∃ i, x ∈ Ps i) → ∀ A : Set (Euclid P), MeasurableSet A → R.measure A = ∑ i, R.measure (A ∩ ((Ps i : Set (Euclid P)) \ {0})) := by
  intro P n q C R Ps hn hR hPs hspt A hA
  -- `Hⁿ({0}) = 0` for `n ≥ 1`: otherwise `H⁰({0}) = ∞`, while `H⁰({0}) = 1`
  have hH0 : μHE[n] ({0} : Set (Euclid P)) = 0 := by
    refine (Measure.euclideanHausdorffMeasure_zero_or_top (d₁ := 0) (by omega) _).resolve_right ?_
    rw [Measure.euclideanHausdorffMeasure_zero, Measure.hausdorffMeasure_zero_singleton]
    exact ENNReal.one_ne_top
  -- `μ = θHⁿ⌞M ≪ Hⁿ`, so `μ({0}) = 0`
  have h0 : R.measure {0} = 0 :=
    (withDensity_absolutelyContinuous _ _).trans Measure.restrict_le_self.absolutelyContinuous hH0
  -- `spt μ ⊆ spt C`: every ball about a point of `spt μ` has positive `μ`-measure
  have hsupp : ∀ x ∈ R.measure.support, x ∈ C.support := fun x hx =>
    ((Submission.dimred_im_mass_measure P n univ C R isOpen_univ hR).2.1 x (mem_univ x)).2
      fun ε hε => (Metric.nhds_basis_ball.mem_measureSupport.1 hx ε hε).ne'
  -- the pieces `Aᵢ = A ∩ (Pᵢ ∖ {0})` are Borel and pairwise disjoint (`Pᵢ ∩ Pⱼ = {0}`)
  have hBm : ∀ i, MeasurableSet (A ∩ ((Ps i : Set (Euclid P)) \ {0})) := fun i =>
    hA.inter ((Ps i).closed_of_finiteDimensional.measurableSet.diff (measurableSet_singleton 0))
  have hBd : Pairwise (Disjoint on fun i => A ∩ ((Ps i : Set (Euclid P)) \ {0})) :=
    fun i j hij => Set.disjoint_left.2 fun x hxi hxj => by
      have hx : x ∈ Ps i ⊓ Ps j := Submodule.mem_inf.2 ⟨hxi.2.1, hxj.2.1⟩
      rw [hPs i j hij, Submodule.mem_bot] at hx
      exact hxi.2.2 hx
  -- `A ∖ ⋃ᵢ Aᵢ ⊆ {0} ∪ (ℝᴾ ∖ spt μ)`, a `μ`-null set
  have hrem : R.measure (A \ ⋃ i, A ∩ ((Ps i : Set (Euclid P)) \ {0})) = 0 := by
    refine measure_mono_null (fun x hx => ?_)
      (measure_union_null h0 (Measure.measure_compl_support (μ := R.measure)))
    by_cases hx0 : x = 0
    · exact Or.inl hx0
    · refine Or.inr fun hxs => ?_
      obtain ⟨i, hi⟩ := hspt x (hsupp x hxs) hx0
      exact hx.2 (mem_iUnion.2 ⟨i, hx.1, hi, hx0⟩)
  -- `μ(A) = μ(⋃ᵢ Aᵢ) = Σᵢ μ(Aᵢ)`
  rw [← measure_eq_measure_of_null_sdiff (iUnion_subset fun i => inter_subset_left) hrem,
    measure_iUnion hBd hBm, tsum_fintype]

/-- **A cycle carried by an `n`-plane `Q` in an open set `V` has constant multiplicity there**
(the constancy step in the proof of Simon 7.3.3(1), p. 191, by the constancy theorem, Simon Ch. 6,
2.34).  Let `C = τ(M, θ, ξ) ∈ 𝒟ₙ(ℝᴾ)` with `∂C = 0`, `n ≥ 1`, `spt C ∩ V ⊆ Q`, `dim Q = n` and
`V ∩ Q` connected.  The restriction `C⌞V = τ(M ∩ V, θ, ξ) ∈ 𝒟ₙ(V)` is integer multiplicity
(approximate tangent planes are local), `∂(C⌞V) = 0` (as `ι(dβ) = d(ιβ)` for the inclusion `ι` of
test forms) and `spt(C⌞V) ⊆ spt C ∩ V ⊆ Q` (as `μ_{C⌞V} = μ_C⌞V`).  For an orthonormal basis `τ`
of `Q` the planar constancy theorem gives `c ∈ ℤ` with `μ_C(W) = M_W(C⌞V) = |c| Hⁿ(W ∩ Q)` for
open `W ⊆ V`.  So `μ_C⌞V` and `|c| Hⁿ⌞Q⌞V` agree on open sets, which form a π-system generating
the Borel sets, and are finite on balls (`θ` is locally `Hⁿ`-integrable); hence they are equal. -/
theorem Submission.idtp_tdc_puvd_planar_piece_measure : ∀ (P n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n) (V : Set (Euclid P)) (Q : Submodule ℝ (Euclid P)), 1 ≤ n → IsOpen V → BoundaryVanishes C → R.Represents C → Module.finrank ℝ Q = n → IsConnected (V ∩ (Q : Set (Euclid P))) → C.support ∩ V ⊆ (Q : Set (Euclid P)) → ∃ c : ℕ, ∀ E : Set (Euclid P), MeasurableSet E → E ⊆ V → R.measure E = (c : ℝ≥0∞) * μHE[n] (E ∩ (Q : Set (Euclid P))) := by
  intro P n C R V Q hn hV hbd hR hQ hconn hsupp
  -- an orthonormal basis `τ` of `Q`, pushed into `ℝᴾ`, is orthonormal with `span τ = Q`
  obtain ⟨τ, hτ, hτQ⟩ : ∃ τ : Fin n → Euclid P, Orthonormal ℝ τ ∧
      Submodule.span ℝ (range τ) = Q := by
    let b := (stdOrthonormalBasis ℝ Q).reindex (finCongr hQ)
    refine ⟨fun k => (b k : Euclid P), b.orthonormal.comp_linearIsometry Q.subtypeₗᵢ, ?_⟩
    have hrange : range (fun k => (b k : Euclid P)) = Q.subtype '' range b := by
      rw [← range_comp]; rfl
    rw [hrange, Submodule.span_image, ← b.coe_toBasis, b.toBasis.span_eq,
      Submodule.map_subtype_top]
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  have hbd' : C.boundary = 0 := hbd
  -- the restriction `C⌞V ∈ 𝒟ₙ(V)`, `C⌞V(ω) = C(ιω)`
  set CV := C.restrictDomain (subset_univ V) with hCV
  -- at `x ∈ V`, an approximate tangent plane of `M` is one of `M ∩ V`: the blow-ups of `M` and
  -- of `M ∩ V` agree in `B_L(0) ⊇ spt f` once `B_{rL}(x) ⊆ V`
  have htan : ∀ x ∈ V, ∀ T : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt (m + 1) R.carrier x T →
        HasApproximateTangentSpaceAt (m + 1) (R.carrier ∩ V) x T := by
    intro x hxV T hT
    refine ⟨hT.1, fun f => ?_⟩
    obtain ⟨s, hs, hsV⟩ := Metric.isOpen_iff.mp hV x hxV
    obtain ⟨L, hL, hfL⟩ := f.hasCompactSupport.isCompact.isBounded.subset_ball_lt 0 0
    refine (hT.2 f).congr' ?_
    filter_upwards [Ioo_mem_nhdsGT (div_pos hs hL)] with r hr
    have hr0 : 0 < r := hr.1
    have hη : Poincare.SimonGMT.Chapter03.blowUpMap x r = fun y => r⁻¹ • (y - x) := rfl
    rw [hη]
    -- `f` vanishes off `B_L(0)`, so each blow-up integral may be cut to `B_L(0)`
    have hfB : ∀ y, y ∉ ball (0 : Euclid P) L → f y = 0 := fun y hy =>
      image_eq_zero_of_notMem_tsupport fun h => hy (hfL h)
    have hcut : ∀ S : Set (Euclid P),
        ∫ y in S, f y ∂μHE[m + 1] = ∫ y in ball (0 : Euclid P) L ∩ S, f y ∂μHE[m + 1] := by
      intro S
      rw [← Measure.restrict_restrict measurableSet_ball]
      exact (setIntegral_eq_integral_of_forall_compl_eq_zero hfB).symm
    -- `η_{x,r}(z) ∈ B_L(0)` forces `z ∈ B_{rL}(x) ⊆ B_s(x) ⊆ V`
    have hset : ball (0 : Euclid P) L ∩ (fun y : Euclid P => r⁻¹ • (y - x)) '' R.carrier =
        ball (0 : Euclid P) L ∩ (fun y : Euclid P => r⁻¹ • (y - x)) '' (R.carrier ∩ V) := by
      refine Subset.antisymm ?_ (inter_subset_inter_right _ (image_mono inter_subset_left))
      rintro y ⟨hyB, z, hz, rfl⟩
      refine ⟨hyB, z, ⟨hz, hsV ?_⟩, rfl⟩
      rw [mem_ball_zero_iff, norm_smul, norm_inv, Real.norm_of_nonneg hr0.le,
        inv_mul_lt_iff₀ hr0] at hyB
      have hrL := (lt_div_iff₀ hL).mp hr.2
      rw [mem_ball, dist_eq_norm]
      linarith
    rw [hcut, hcut ((fun y : Euclid P => r⁻¹ • (y - x)) '' (R.carrier ∩ V)), hset]
  -- the restricted triple `R' = (M ∩ V, θ, ξ)` in `V`
  let R' : IMRep V (m + 1) :=
    { carrier := R.carrier ∩ V
      mult := R.mult
      orient := R.orient
      measurableSet_carrier := R.measurableSet_carrier.inter hV.measurableSet
      carrier_subset := inter_subset_right
      rectifiable := R.rectifiable.mono inter_subset_left
      measurable_mult := R.measurable_mult
      mult_pos := fun x hx => R.mult_pos x hx.1
      locallyIntegrable_mult := fun K hK hKV => by
        rw [inter_assoc, inter_eq_right.2 hKV]
        exact R.locallyIntegrable_mult K hK (subset_univ K)
      aestronglyMeasurable_orient :=
        R.aestronglyMeasurable_orient.mono_measure (Measure.restrict_mono inter_subset_left le_rfl)
      orients := by
        filter_upwards [ae_restrict_of_ae_restrict_of_subset
          (inter_subset_left : R.carrier ∩ V ⊆ R.carrier) R.orients,
          ae_restrict_mem (R.measurableSet_carrier.inter hV.measurableSet)] with x hx hxMV
        obtain ⟨T, hT, hξT⟩ := hx
        exact ⟨T, htan x hxMV.2 T hT, hξT⟩ }
  -- `C⌞V = τ(M ∩ V, θ, ξ)`: a test form supported in `V` vanishes on `M ∖ V`
  have hR' : R'.Represents CV := by
    intro ω
    rw [hCV, GeometricCurrentOn.restrictDomain_apply, hR, testFormOnInclusion_coe]
    change ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x
        ((ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 1] =
      ∫ x in R.carrier ∩ V, (R.mult x : ℝ) * R.orient x
        ((ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 1]
    refine setIntegral_eq_of_subset_of_forall_sdiff_eq_zero R.measurableSet_carrier
      inter_subset_left fun x hx => ?_
    have hxω : x ∉ tsupport (ω : DifferentialForm (Euclid P) (m + 1)) :=
      fun h => hx.2 ⟨hx.1, ω.property.2 h⟩
    rw [image_eq_zero_of_notMem_tsupport hxω, map_zero, mul_zero]
  -- `μ_{R'} = θHⁿ⌞(M ∩ V) = μ_R⌞V`
  have hR'meas : R'.measure = R.measure.restrict V := by
    change (μHE[m + 1].restrict (R.carrier ∩ V)).withDensity (fun x => (R.mult x : ℝ≥0∞)) =
      ((μHE[m + 1].restrict R.carrier).withDensity fun x => (R.mult x : ℝ≥0∞)).restrict V
    rw [restrict_withDensity hV.measurableSet, Measure.restrict_restrict hV.measurableSet,
      inter_comm]
  -- `∂(C⌞V) = 0`: `∂(C⌞V)(β) = C(ι(dβ)) = C(d(ιβ)) = ∂C(ιβ) = 0`
  have hbdV : BoundaryVanishes CV := by
    change CV.boundary = 0
    ext β
    have hι : testFormOnInclusion (subset_univ V) (m + 1) (exteriorDerivativeTestOn V m β) =
        exteriorDerivativeTestOn univ m (testFormOnInclusion (subset_univ V) m β) :=
      Subtype.ext rfl
    rw [GeometricCurrentOn.boundary_apply, hCV, GeometricCurrentOn.restrictDomain_apply, hι,
      ← GeometricCurrentOn.boundary_apply, hbd', GeometricCurrentOn.zero_apply,
      GeometricCurrentOn.zero_apply]
  -- `spt(C⌞V) ⊆ spt C ∩ V ⊆ Q`: balls about `x ∈ spt(C⌞V)` have positive `μ_R⌞V ≤ μ_R` measure
  have hsptV : CV.support ⊆ (Q : Set (Euclid P)) := by
    intro x hx
    have hxV : x ∈ V := CV.support_subset_domain hx
    refine hsupp ⟨?_, hxV⟩
    rw [(Submission.dimred_im_mass_measure P (m + 1) univ C R isOpen_univ hR).2.1 x (mem_univ x)]
    intro ε hε h0
    refine ((Submission.dimred_im_mass_measure P (m + 1) V CV R' hV hR').2.1 x hxV).mp hx ε hε ?_
    rw [hR'meas]
    exact nonpos_iff_eq_zero.mp ((Measure.restrict_apply_le _ _).trans h0.le)
  -- constancy: `M_W(C⌞V) = |c| Hⁿ(W ∩ Q)` for open `W ⊆ V`
  obtain ⟨c, -, hmass⟩ := Submission.idtp_planar_cycle_eq_const_mul P (m + 1) V CV τ hn hV hτ
    ⟨R', hR'⟩ hbdV (by rw [hτQ]; exact hsptV) (by rw [hτQ]; exact hconn)
  rw [hτQ] at hmass
  -- `μ_R(W) = μ_{R'}(W) = M_W(C⌞V) = |c| Hⁿ(W ∩ Q)` for open `W ⊆ V`
  have hopen : ∀ W : Set (Euclid P), IsOpen W → W ⊆ V →
      R.measure W = (c.natAbs : ℝ≥0∞) * μHE[m + 1] (W ∩ (Q : Set (Euclid P))) := by
    intro W hW hWV
    rw [← hmass W hW hWV, (Submission.dimred_im_mass_measure P (m + 1) V CV R' hV hR').1 W hW hWV,
      hR'meas, Measure.restrict_eq_self _ hWV]
  -- `μ_R(K) = ∫_{M ∩ K} θ dHⁿ < ∞` for compact `K`
  have hfin : ∀ K : Set (Euclid P), IsCompact K → R.measure K ≠ ∞ := by
    intro K hK
    change (μHE[m + 1].restrict R.carrier).withDensity (fun x => (R.mult x : ℝ≥0∞)) K ≠ ∞
    rw [withDensity_apply _ hK.measurableSet, Measure.restrict_restrict hK.measurableSet,
      inter_comm]
    exact R.locallyIntegrable_mult K hK (subset_univ K)
  -- `μ_R⌞V = |c| Hⁿ⌞Q⌞V`: they agree on the open sets and are finite on the balls `B_i(0)`
  have hext : R.measure.restrict V =
      ((c.natAbs : ℝ≥0∞) • μHE[m + 1].restrict (Q : Set (Euclid P))).restrict V := by
    refine Measure.ext_of_generateFrom_of_iUnion {s | IsOpen s}
      (fun i : ℕ => ball (0 : Euclid P) i) BorelSpace.measurable_eq isPiSystem_isOpen
      (iUnion_ball_nat 0) (fun i => show IsOpen (ball (0 : Euclid P) i) from isOpen_ball)
      (fun i => ?_) (fun s hs => ?_)
    · exact ne_top_of_le_ne_top (hfin _ (isCompact_closedBall 0 i))
        ((Measure.restrict_apply_le _ _).trans (measure_mono ball_subset_closedBall))
    · have hs' : IsOpen s := hs
      rw [Measure.restrict_apply hs'.measurableSet, Measure.restrict_apply hs'.measurableSet,
        Measure.smul_apply, Measure.restrict_apply (hs'.measurableSet.inter hV.measurableSet),
        smul_eq_mul]
      exact hopen _ (hs'.inter hV) inter_subset_right
  -- for Borel `E ⊆ V`: `μ_R(E) = (μ_R⌞V)(E) = |c| Hⁿ(E ∩ Q)`
  refine ⟨c.natAbs, fun E hE hEV => ?_⟩
  rw [← Measure.restrict_eq_self R.measure hEV, hext, Measure.restrict_eq_self _ hEV,
    Measure.smul_apply, Measure.restrict_apply hE, smul_eq_mul]
/-- **An open domain around a punctured 2-plane** (the domains `Vᵢ` in the proof of Simon
7.3.3(1), pp. 191–192, where the Constancy Theorem, Ch. 6, 2.34, makes the density of a
2-dimensional minimizing cone constant on each of its planes `Pᵢ ∖ {0}`).  Let `dim Pᵢ = 2` and
`Pᵢ ∩ Pⱼ = {0}` for `j ≠ i`.  Then `V = ℝᴾ ∖ ⋃_{j ≠ i} Pⱼ` is open (finitely many closed
subspaces are removed), contains `Pᵢ ∖ {0}` and misses every `Pⱼ`, `j ≠ i`.  `V ∩ Pᵢ` is `Pᵢ` if
there is no `j ≠ i`, and `Pᵢ ∖ {0}` otherwise; the latter is connected as the image of `ℂ` under
the polar coordinates `w ↦ L(eʷ)`, `L : ℂ ≃ Pᵢ` a linear isomorphism. -/
theorem Submission.idtp_tdc_puvd_plane_domain : ∀ (P q : ℕ) (Ps : Fin q → Submodule ℝ (Euclid P)) (i : Fin q), Module.finrank ℝ (Ps i) = 2 → (∀ j, j ≠ i → Ps i ⊓ Ps j = ⊥) → ∃ V : Set (Euclid P), IsOpen V ∧ IsConnected (V ∩ (Ps i : Set (Euclid P))) ∧ (Ps i : Set (Euclid P)) \ {0} ⊆ V ∧ ∀ j, j ≠ i → Disjoint V (Ps j : Set (Euclid P)) := by
  intro P q Ps i h2 hdisj
  -- step 1: `F = ⋃_{j ≠ i} Pⱼ` is a finite union of closed subspaces, so `V = ℝᴾ ∖ F` is open
  set F : Set (Euclid P) := ⋃ j ∈ {j : Fin q | j ≠ i}, (Ps j : Set (Euclid P))
  have hFc : IsClosed F :=
    (Set.toFinite _).isClosed_biUnion fun j _ => (Ps j).closed_of_finiteDimensional
  -- step 2: `Pᵢ ∖ {0} ⊆ V`, since `Pᵢ ∩ Pⱼ = {0}` for `j ≠ i`
  have hsub : (Ps i : Set (Euclid P)) \ {0} ⊆ Fᶜ := by
    rintro x ⟨hx, hx0⟩ hxF
    obtain ⟨j, hj, hxj⟩ := mem_iUnion₂.1 hxF
    have hxij : x ∈ Ps i ⊓ Ps j := Submodule.mem_inf.2 ⟨hx, hxj⟩
    rw [hdisj j hj, Submodule.mem_bot] at hxij
    exact hx0 hxij
  refine ⟨Fᶜ, hFc.isOpen_compl, ?_, hsub, fun j hj => ?_⟩
  · -- step 4: `V ∩ Pᵢ` is connected
    by_cases hq : ∃ j, j ≠ i
    · -- case (b): `0 ∈ Pⱼ ⊆ F` for some `j ≠ i`, so `V ∩ Pᵢ = Pᵢ ∖ {0}`
      obtain ⟨j, hj⟩ := hq
      have h0 : (0 : Euclid P) ∈ F := mem_biUnion hj (Ps j).zero_mem
      have hV : Fᶜ ∩ (Ps i : Set (Euclid P)) = (Ps i : Set (Euclid P)) \ {0} := by
        ext x
        refine ⟨fun hx => ⟨hx.2, fun hx0 => hx.1 ?_⟩, fun hx => ⟨hsub hx, hx.1⟩⟩
        rw [mem_singleton_iff.1 hx0]
        exact h0
      -- polar coordinates: for a linear isomorphism `L : ℂ ≃ Pᵢ`, `w ↦ L(eʷ)` is continuous and
      -- maps `ℂ` onto `Pᵢ ∖ {0}` (`exp` maps `ℂ` onto `ℂ ∖ {0}`)
      let L : ℂ ≃ₗ[ℝ] Ps i :=
        Module.Basis.equiv Complex.basisOneI (Module.finBasisOfFinrankEq ℝ (Ps i) h2) (Equiv.refl _)
      have hcont : Continuous fun w : ℂ => ((L (Complex.exp w) : Ps i) : Euclid P) :=
        continuous_subtype_val.comp
          (L.toLinearMap.continuous_of_finiteDimensional.comp Complex.continuous_exp)
      have hrange : range (fun w : ℂ => ((L (Complex.exp w) : Ps i) : Euclid P)) =
          (Ps i : Set (Euclid P)) \ {0} := by
        ext x
        constructor
        · rintro ⟨w, rfl⟩
          exact ⟨(L (Complex.exp w)).2, fun h => Complex.exp_ne_zero w
            (L.map_eq_zero_iff.1 (Submodule.coe_eq_zero.1 (mem_singleton_iff.1 h)))⟩
        · rintro ⟨hx, hx0⟩
          have hz : L.symm ⟨x, hx⟩ ≠ 0 := by
            rw [L.symm.map_ne_zero_iff, Ne, Submodule.mk_eq_zero]
            exact hx0
          refine ⟨Complex.log (L.symm ⟨x, hx⟩), ?_⟩
          show ((L (Complex.exp (Complex.log (L.symm ⟨x, hx⟩))) : Ps i) : Euclid P) = x
          rw [Complex.exp_log hz, LinearEquiv.apply_symm_apply]
      rw [hV, ← hrange]
      exact isConnected_range hcont
    · -- case (a): there is no `j ≠ i`, so `F = ∅` and `V ∩ Pᵢ = Pᵢ` is convex and nonempty
      have hV : Fᶜ ∩ (Ps i : Set (Euclid P)) = Ps i := by
        refine inter_eq_right.2 fun x _ hxF => ?_
        obtain ⟨j, hj, -⟩ := mem_iUnion₂.1 hxF
        exact hq ⟨j, hj⟩
      rw [hV]
      exact (Ps i).convex.isConnected ⟨0, (Ps i).zero_mem⟩
  · -- step 3: `Pⱼ ⊆ F = ℝᴾ ∖ V` for `j ≠ i`
    exact disjoint_compl_left_iff_subset.2
      (subset_biUnion_of_mem (u := fun j => (Ps j : Set (Euclid P))) hj)
/-- **Exact homogeneous ball mass gives the density** (step 7 of the density computation for the
planes of a 2-dimensional minimizing cone, Simon 7.3.3(1), p. 191).  If `θ ≥ 0`, `r > 0` and
`M_{B_ρ(x)}(T) = θ ωₙρⁿ` for `0 < ρ < r`, then `Θⁿ(μ_T, x) = θ`.  `ωₙ` is the volume of the
nonempty bounded open unit ball of `ℝⁿ`, so `0 < ωₙρⁿ < ∞` and the ratio
`M_{B_ρ(x)}(T)/(ωₙρⁿ)` equals `θ` for `0 < ρ < r`; `(0, r) ∈ 𝓝[>] 0`, so it tends to `θ`. -/
theorem Submission.idtp_tdc_puvd_density_of_ball_mass : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (x : Euclid P) (θ r : ℝ), 0 ≤ θ → 0 < r → (∀ ρ : ℝ, 0 < ρ → ρ < r → T.massOn (ball x ρ) = ENNReal.ofReal θ * (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) → HasMassDensity T x θ := by
  intro P n U T x θ r hθ hr hmass
  -- `0 < ωₙ < ∞`: `ωₙ` is the volume of the nonempty bounded open unit ball of `ℝⁿ`
  have hω₀ : unitBallVolume n ≠ 0 := (measure_ball_pos volume (0 : Euclid n) one_pos).ne'
  have hω : unitBallVolume n ≠ ∞ := measure_ball_ne_top
  -- for `0 < ρ < r` the ratio is `θ ωₙρⁿ / ωₙρⁿ = θ`, and `(0, r) ∈ 𝓝[>] 0`
  refine ⟨hθ, tendsto_const_nhds.congr' ?_⟩
  filter_upwards [Ioo_mem_nhdsGT hr] with ρ hρ
  rw [hmass ρ hρ.1 hρ.2, ENNReal.mul_div_cancel_right
    (mul_ne_zero hω₀ (ENNReal.ofReal_pos.2 (pow_pos hρ.1 n)).ne')
    (ENNReal.mul_ne_top hω ENNReal.ofReal_ne_top)]

/-- **An integer multiplicity 2-cycle carried by finitely many 2-planes through `0` has integer
density at `0`** (the density of a 2-dimensional minimizing cone at its vertex, in the proof of
Simon 7.3.3(1), pp. 191–192, where `Θ` is constant on each `Pᵢ ∖ {0}` by the Constancy Theorem,
Ch. 6, 2.34).  Let `C = τ(M, θ, ξ) ∈ 𝒟₂(ℝᴾ)` with `∂C = 0`, let `P₁, …, P_q` be 2-planes with
`Pᵢ ∩ Pⱼ = {0}` for `i ≠ j`, and let `spt C ∖ {0} ⊆ ⋃ᵢ Pᵢ`.  An open `Vᵢ ⊇ Pᵢ ∖ {0}` missing
the other planes, with `Vᵢ ∩ Pᵢ` connected, has `spt C ∩ Vᵢ ⊆ Pᵢ`, so `μ_C = cᵢ H²⌞Pᵢ` on Borel
subsets of `Pᵢ ∖ {0}` for some `cᵢ ∈ ℕ`.  `μ_C` splits over the punctured planes and
`H²({0}) = 0`, so `M_{B_ρ(0)}(C) = Σᵢ cᵢ H²(Pᵢ ∩ B_ρ(0)) = (Σᵢ cᵢ) ω₂ρ²` for every `ρ > 0`, and
`Θ²(μ_C, 0) = Σᵢ cᵢ`. -/
theorem Submission.idtp_tdc_planes_union_vertex_density : ∀ (P q : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2) (Ps : Fin q → Submodule ℝ (Euclid P)), IsIntegerMultiplicity C → BoundaryVanishes C → (∀ i, Module.finrank ℝ (Ps i) = 2) → (∀ i j, i ≠ j → Ps i ⊓ Ps j = ⊥) → (∀ x ∈ C.support, x ≠ 0 → ∃ i, x ∈ Ps i) → ∃ m : ℕ, HasMassDensity C 0 m := by
  intro P q C Ps hIM hbd h2 hdisj hspt
  obtain ⟨R, hR⟩ := hIM
  -- `H²({0}) = 0`: otherwise `H⁰({0}) = ∞`, while `H⁰({0}) = 1`
  have hH0 : μHE[2] ({0} : Set (Euclid P)) = 0 := by
    refine (Measure.euclideanHausdorffMeasure_zero_or_top (d₁ := 0) two_pos _).resolve_right ?_
    rw [Measure.euclideanHausdorffMeasure_zero, Measure.hausdorffMeasure_zero_singleton]
    exact ENNReal.one_ne_top
  -- on each punctured plane `Pᵢ ∖ {0}`, `μ_C = cᵢ H²⌞Pᵢ` for some `cᵢ ∈ ℕ`
  have hpiece : ∀ i, ∃ c : ℕ, ∀ E : Set (Euclid P), MeasurableSet E →
      E ⊆ (Ps i : Set (Euclid P)) \ {0} →
        R.measure E = (c : ℝ≥0∞) * μHE[2] (E ∩ (Ps i : Set (Euclid P))) := by
    intro i
    -- an open `Vᵢ ⊇ Pᵢ ∖ {0}` missing the other planes, with `Vᵢ ∩ Pᵢ` connected
    obtain ⟨V, hV, hconn, hPV, hVdisj⟩ :=
      Submission.idtp_tdc_puvd_plane_domain P q Ps i (h2 i) fun j hj => hdisj i j (Ne.symm hj)
    -- `spt C ∩ Vᵢ ⊆ Pᵢ`: a nonzero point of `spt C` lies in some `Pⱼ`, and `Vᵢ` misses `Pⱼ`
    -- for `j ≠ i`
    have hsupp : C.support ∩ V ⊆ (Ps i : Set (Euclid P)) := by
      rintro x ⟨hxC, hxV⟩
      by_cases hx0 : x = 0
      · rw [hx0]
        exact (Ps i).zero_mem
      obtain ⟨j, hj⟩ := hspt x hxC hx0
      by_cases hji : j = i
      · rw [← hji]
        exact hj
      · exact absurd hj (Set.disjoint_left.1 (hVdisj j hji) hxV)
    obtain ⟨c, hc⟩ := Submission.idtp_tdc_puvd_planar_piece_measure P 2 C R V (Ps i) one_le_two
      hV hbd hR (h2 i) hconn hsupp
    exact ⟨c, fun E hE hEP => hc E hE (hEP.trans hPV)⟩
  choose c hc using hpiece
  -- `M_{B_ρ(0)}(C) = μ_C(B_ρ(0)) = Σᵢ μ_C(B_ρ(0) ∩ (Pᵢ ∖ {0})) = Σᵢ cᵢ H²(Pᵢ ∩ B_ρ(0))
  -- = (Σᵢ cᵢ) ω₂ρ²` for every `ρ > 0`
  refine ⟨∑ i, c i, Submission.idtp_tdc_puvd_density_of_ball_mass P 2 univ C 0 _ 1
    (Nat.cast_nonneg _) one_pos fun ρ hρ _ => ?_⟩
  rw [(Submission.dimred_im_mass_measure P 2 univ C R isOpen_univ hR).1 _ isOpen_ball
      (subset_univ _),
    Submission.idtp_tdc_puvd_measure_eq_sum_planes P 2 q C R Ps one_le_two hR hdisj hspt _
      measurableSet_ball,
    ENNReal.ofReal_natCast, Nat.cast_sum, Finset.sum_mul]
  refine Finset.sum_congr rfl fun i _ => ?_
  have hm : MeasurableSet (ball (0 : Euclid P) ρ ∩ ((Ps i : Set (Euclid P)) \ {0})) :=
    measurableSet_ball.inter
      ((Ps i).closed_of_finiteDimensional.measurableSet.diff (measurableSet_singleton 0))
  -- `(B_ρ(0) ∩ (Pᵢ ∖ {0})) ∩ Pᵢ = (Pᵢ ∩ B_ρ(0)) ∖ {0}`, and `H²({0}) = 0`
  have hset : ball (0 : Euclid P) ρ ∩ ((Ps i : Set (Euclid P)) \ {0}) ∩ (Ps i : Set (Euclid P)) =
      ((Ps i : Set (Euclid P)) ∩ ball 0 ρ) \ {0} := by
    ext x
    simp only [mem_inter_iff, Set.mem_sdiff]
    tauto
  rw [hc i _ hm inter_subset_right, hset, measure_sdiff_null hH0,
    Submission.idtp_tdc_subspace_ball_measure P 2 (Ps i) 0 ρ (h2 i) (Ps i).zero_mem hρ]

/-- **Simon, proof of 7.3.3(1), the 2-dimensional cones** (chapter-07.txt lines 497–510): a
2-dimensional minimizing cone `C` with `∂C = 0` has integer density at the vertex.  Off `0` the
density of `C` is locally constant (`idtp_tdc_density_locally_constant`), so `spt C` is locally a
2-plane there (`idtp_cone_constant_density_planar`).  Being closed and dilation invariant
(`idtp_tdc_cone_dilation`), `spt C ∖ {0}` lies in finitely many 2-planes `Pᵢ` with
`Pᵢ ∩ Pⱼ = {0}` (`idtp_tdc_cone_set_finite_planes`, the classification the book cites from
[Whi82]), and constancy on each plane gives `Θ²(μ_C, 0) ∈ ℕ`
(`idtp_tdc_planes_union_vertex_density`). -/
theorem Submission.idtp_two_dim_cone_integer_density : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2), IsMinimizingIn C univ → BoundaryVanishes C → IsConeCurrent C → ∃ m : ℕ, HasMassDensity C 0 m := by
  intro P C hmin hbd hcone
  have hIM : IsIntegerMultiplicity C := hmin.1
  -- `spt C = ℝᴾ ∖ (zero region)` is closed
  have hclosed : IsClosed C.support := isClosed_univ.sdiff C.isOpen_zeroRegion
  -- `spt C` is invariant under the dilations `x ↦ s • x`, `s > 0`
  have hdil : ∀ x ∈ C.support, ∀ s : ℝ, 0 < s → s • x ∈ C.support := fun x hx s hs =>
    ((Submission.idtp_tdc_cone_dilation P 2 C hIM hcone s hs).2.1 x).2 hx
  -- off `0`, the density is locally constant, so `spt C` is locally a 2-plane
  have hplanar : ∀ p ∈ C.support, p ≠ 0 → ∃ (δ : ℝ) (Q : Submodule ℝ (Euclid P)), 0 < δ ∧
      Module.finrank ℝ Q = 2 ∧ C.support ∩ ball p δ = (Q : Set (Euclid P)) ∩ ball p δ := by
    intro p hp hp0
    obtain ⟨δ, k, hδ, hk⟩ :=
      Submission.idtp_tdc_density_locally_constant P C hmin hbd hcone p hp hp0
    obtain ⟨δ', Q, hδ', hQ, -, hspt, -⟩ :=
      Submission.idtp_cone_constant_density_planar P C p k δ hmin hbd hcone hp hp0 hδ hk
    exact ⟨δ', Q, hδ', hQ, hspt⟩
  -- the classification: `spt C ∖ {0}` lies in finitely many 2-planes meeting only at `0`
  obtain ⟨q, Ps, hPs, hdisj, hcover⟩ :=
    Submission.idtp_tdc_cone_set_finite_planes P C.support hclosed hdil hplanar
  -- constancy on each plane: `Θ²(μ_C, 0) = Σᵢ |cᵢ|`
  exact Submission.idtp_tdc_planes_union_vertex_density P q C Ps hIM hbd hPs hdisj hcover

end GMT.Ch07
