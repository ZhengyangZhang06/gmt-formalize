      (∀ ζ : Euclid m → Euclid k, ContDiff ℝ 1 ζ → HasCompactSupport ζ → tsupport ζ ⊆ Ω →
        ∫ y, ∑ j : Fin m, inner ℝ (fderiv ℝ u y (EuclideanSpace.single j (1 : ℝ)))
            (fderiv ℝ ζ y (EuclideanSpace.single j (1 : ℝ))) =
          ∫ y, ∑ j : Fin m, inner ℝ (G (fderiv ℝ u y) (EuclideanSpace.single j (1 : ℝ)))
            (fderiv ℝ ζ y (EuclideanSpace.single j (1 : ℝ)))) →
      ∀ {e : Euclid m}, ‖e‖ = 1 → ∀ {ζ : Euclid m → Euclid k}, ContDiff ℝ 1 ζ →
      HasCompactSupport ζ → tsupport ζ ⊆ Ω →
      ∫ y, ∑ j : Fin m, inner ℝ (fderiv ℝ (fderiv ℝ u) y e (EuclideanSpace.single j (1 : ℝ)))
          (fderiv ℝ ζ y (EuclideanSpace.single j (1 : ℝ))) =
        ∫ y, ∑ j : Fin m, inner ℝ
          (fderiv ℝ G (fderiv ℝ u y) (fderiv ℝ (fderiv ℝ u) y e) (EuclideanSpace.single j (1 : ℝ)))
          (fderiv ℝ ζ y (EuclideanSpace.single j (1 : ℝ))) := by
    intro Λ ε₀ hε₀ hb Ω u hΩ hDu1 hDu hweak e he ζ hζ hζc hζΩ
    obtain ⟨δ, hδ, hδΩ⟩ := hζc.isCompact.exists_cthickening_subset_open hΩ hζΩ
    have hDuc : ContinuousOn (fderiv ℝ u) Ω := hDu1.continuousOn
    have hD2c : ContinuousOn (fderiv ℝ (fderiv ℝ u)) Ω :=
      hDu1.continuousOn_fderiv_of_isOpen hΩ le_rfl
    have hKc : IsCompact (cthickening δ (tsupport ζ)) := hζc.isCompact.cthickening
    obtain ⟨M₂, hM₂⟩ := hKc.exists_bound_of_continuousOn (f := fderiv ℝ (fderiv ℝ u))
      (hD2c.mono hδΩ)
    have hDud : ∀ y ∈ Ω, HasFDerivAt (fderiv ℝ u) (fderiv ℝ (fderiv ℝ u) y) y := fun y hy =>
      ((hDu1.differentiableOn one_ne_zero y hy).differentiableAt (hΩ.mem_nhds hy)).hasFDerivAt
    have hball : ∀ y ∈ tsupport ζ, closedBall y δ ⊆ Ω := fun y hy =>
      (closedBall_subset_cthickening hy δ).trans hδΩ
    have hnear : ∀ (y : Euclid m) (t : ℝ), |t| ≤ δ → y + t • e ∈ closedBall y δ := by
      intro y t ht
      rw [mem_closedBall, dist_eq_norm, add_sub_cancel_left, norm_smul, he, mul_one,
        Real.norm_eq_abs]
      exact ht
    have hinc : ∀ y ∈ tsupport ζ, ∀ t : ℝ, |t| ≤ δ →
        ‖fderiv ℝ u (y + t • e) - fderiv ℝ u y‖ ≤ M₂ * |t| := by
      intro y hy t ht
      have h := (convex_closedBall y δ).norm_image_sub_le_of_norm_fderiv_le (𝕜 := ℝ)
        (f := fderiv ℝ u) (C := M₂) (fun z hz => (hDud z (hball y hy hz)).differentiableAt)
        (fun z hz => hM₂ z (closedBall_subset_cthickening hy δ hz)) (mem_closedBall_self hδ.le)
        (hnear y t ht)
      rwa [add_sub_cancel_left, norm_smul, he, mul_one, Real.norm_eq_abs] at h
    have hev : ∀ᶠ t in 𝓝[≠] (0 : ℝ), t ≠ 0 ∧ |t| < δ := by
      have h1 : ∀ᶠ t in 𝓝[≠] (0 : ℝ), t ≠ 0 := eventually_mem_nhdsWithin
      have h2 : ∀ᶠ t in 𝓝[≠] (0 : ℝ), |t| < δ := by
        refine Filter.Eventually.filter_mono nhdsWithin_le_nhds ?_
        filter_upwards [Metric.ball_mem_nhds (0 : ℝ) hδ] with t ht
        simpa [Real.dist_eq] using ht
      exact h1.and h2
    have hΛ : 0 ≤ Λ := (norm_nonneg (fderiv ℝ G 0)).trans (hb 0 (by rw [norm_zero]; linarith))
    have hline : ∀ y : Euclid m, HasDerivAt (fun t : ℝ => y + t • e) e 0 := fun y => by
      simpa using ((hasDerivAt_id (0 : ℝ)).smul_const e).const_add y
    have hT := qs_tendsto_integral_pair
      (A := fun t y => t⁻¹ • (fderiv ℝ u (y + t • e) - fderiv ℝ u y))
      (A₀ := fun y => fderiv ℝ (fderiv ℝ u) y e) hζ hζc (M := M₂)
      (hev.mono fun t ht =>
        ((hDuc.comp (continuous_add_const _).continuousOn
          fun y hy => hball y hy (hnear y t ht.2.le)).sub (hDuc.mono hζΩ)).const_smul t⁻¹)
      (hev.mono fun t ht y hy => by
        have htpos : 0 < |t| := abs_pos.mpr ht.1
        show ‖t⁻¹ • (fderiv ℝ u (y + t • e) - fderiv ℝ u y)‖ ≤ M₂
        rw [norm_smul, norm_inv, Real.norm_eq_abs]
        calc |t|⁻¹ * ‖fderiv ℝ u (y + t • e) - fderiv ℝ u y‖ ≤ |t|⁻¹ * (M₂ * |t|) := by
              gcongr
              exact hinc y hy t ht.2.le
          _ = M₂ := by field_simp)
      (fun y hy => by
        have h := ((hDud y (hζΩ hy)).comp_hasDerivAt_of_eq (0 : ℝ) (hline y)
          (by simp)).tendsto_slope_zero
        simpa using h)
    have hS := qs_tendsto_integral_pair
      (A := fun t y => t⁻¹ • (G (fderiv ℝ u (y + t • e)) - G (fderiv ℝ u y)))
      (A₀ := fun y => fderiv ℝ G (fderiv ℝ u y) (fderiv ℝ (fderiv ℝ u) y e)) hζ hζc
      (M := Λ * M₂)
      (hev.mono fun t ht =>
        ((hGd.continuous.comp_continuousOn (hDuc.comp (continuous_add_const _).continuousOn
          fun y hy => hball y hy (hnear y t ht.2.le))).sub
            (hGd.continuous.comp_continuousOn (hDuc.mono hζΩ))).const_smul t⁻¹)
      (hev.mono fun t ht y hy => by
        have htpos : 0 < |t| := abs_pos.mpr ht.1
        have hyΩ := hζΩ hy
        have hy' := hball y hy (hnear y t ht.2.le)
        have h := qs_norm_sub_le hGd hb
          (p := fderiv ℝ u (y + t • e)) (q := fderiv ℝ u y) (by linarith [hDu _ hy'])
          (by linarith [hDu _ hyΩ])
        show ‖t⁻¹ • (G (fderiv ℝ u (y + t • e)) - G (fderiv ℝ u y))‖ ≤ Λ * M₂
        rw [norm_smul, norm_inv, Real.norm_eq_abs]
        calc |t|⁻¹ * ‖G (fderiv ℝ u (y + t • e)) - G (fderiv ℝ u y)‖
            ≤ |t|⁻¹ * (Λ * (M₂ * |t|)) := by
              gcongr
              exact h.trans (by gcongr; exact hinc y hy t ht.2.le)
          _ = Λ * M₂ := by field_simp)
      (fun y hy => by
        have h := (((hGd (fderiv ℝ u y)).hasFDerivAt.comp y
          (hDud y (hζΩ hy))).comp_hasDerivAt_of_eq (0 : ℝ) (hline y) (by simp)).tendsto_slope_zero
        simpa using h)
    refine tendsto_nhds_unique_of_eventuallyEq hT hS (hev.mono fun t ht => ?_)
    exact qs_weak_shift hweak hDuc (hGd.continuous.comp_continuousOn hDuc)
      (t • e) t⁻¹ hζ hζc fun y hy => ⟨hζΩ hy, hball y hy (hnear y t ht.2.le)⟩
  -- `Du(y) = ∑ₛ λₛ(Du(y) eₛ)`, `λₛ(b)(a) = ⟨a, eₛ⟩ b`.
  have qs_clm_decomp : ∀ (L : Euclid m →L[ℝ] Euclid k),
      L = ∑ s : Fin m, ContinuousLinearMap.smulRightL ℝ (Euclid m) (Euclid k)
        (EuclideanSpace.proj s) (L (EuclideanSpace.single s (1 : ℝ))) := by
    intro L
    refine ContinuousLinearMap.ext fun a => ?_
    rw [sum_apply]
    simp only [ContinuousLinearMap.smulRightL_apply_apply]
    conv_lhs => rw [← (EuclideanSpace.basisFun (Fin m) ℝ).sum_repr a]
    rw [map_sum]
    refine Finset.sum_congr rfl fun s _ => ?_
    rw [map_smul, EuclideanSpace.basisFun_apply, EuclideanSpace.basisFun_repr]
    rfl
  -- Step 3: if `Du ∈ C^{l,α}_loc(Ω)` with `l ≥ 1`, then `Du ∈ C^{l+1,α}_loc(Ω)`: each
  -- `∂ₛu = Du(·) eₛ` solves `Δ∂ₛu = div(DG(Du)[D∂ₛu])` weakly (step 3(a)), so
  -- `codim1_hcp_sr_linear_bootstrap` applies with `B = DG ∘ Du ∈ C^{l,α}_loc`
  -- (`codim1_hcp_sr_holder_algebra`), and `Du = ∑ₛ λₛ(∂ₛu)`.
  have qs_bootstrap : ∀ {α εL Λ ε₀ : ℝ}, 0 < α → α ≤ 1 → Λ ≤ εL → 0 ≤ ε₀ →
      (∀ p : Euclid m →L[ℝ] Euclid k, ‖p‖ ≤ 3 * ε₀ → ‖fderiv ℝ G p‖ ≤ Λ) →
      (∀ (Ω : Set (Euclid m)) (l : ℕ) (w : Euclid m → Euclid k)
        (B : Euclid m → ((Euclid m →L[ℝ] Euclid k) →L[ℝ] (Euclid m →L[ℝ] Euclid k)))
        (g : Euclid m → (Euclid m →L[ℝ] Euclid k)), IsOpen Ω → ContDiffOn ℝ 1 w Ω →
        (∀ x ∈ Ω, ‖B x‖ ≤ εL) →
        (ContDiffOn ℝ l B Ω ∧ ∀ x ∈ Ω, ∃ ρ : ℝ, 0 < ρ ∧ ball x ρ ⊆ Ω ∧ ∃ C : ℝ,
          ∀ y ∈ ball x ρ, ∀ z ∈ ball x ρ,
            ‖iteratedFDeriv ℝ l B y - iteratedFDeriv ℝ l B z‖ ≤ C * ‖y - z‖ ^ α) →
        (ContDiffOn ℝ l g Ω ∧ ∀ x ∈ Ω, ∃ ρ : ℝ, 0 < ρ ∧ ball x ρ ⊆ Ω ∧ ∃ C : ℝ,
          ∀ y ∈ ball x ρ, ∀ z ∈ ball x ρ,
            ‖iteratedFDeriv ℝ l g y - iteratedFDeriv ℝ l g z‖ ≤ C * ‖y - z‖ ^ α) →
        (∀ ζ : Euclid m → Euclid k, ContDiff ℝ 1 ζ → HasCompactSupport ζ → tsupport ζ ⊆ Ω →
          ∫ x in Ω, ∑ j : Fin m, inner ℝ (fderiv ℝ w x (EuclideanSpace.single j (1 : ℝ)))
              (fderiv ℝ ζ x (EuclideanSpace.single j (1 : ℝ))) =
            ∫ x in Ω, ∑ j : Fin m, inner ℝ ((B x (fderiv ℝ w x) + g x)
              (EuclideanSpace.single j (1 : ℝ))) (fderiv ℝ ζ x (EuclideanSpace.single j (1 : ℝ)))) →
        (ContDiffOn ℝ (l + 1) w Ω ∧ ∀ x ∈ Ω, ∃ ρ : ℝ, 0 < ρ ∧ ball x ρ ⊆ Ω ∧ ∃ C : ℝ,
          ∀ y ∈ ball x ρ, ∀ z ∈ ball x ρ,
            ‖iteratedFDeriv ℝ (l + 1) w y - iteratedFDeriv ℝ (l + 1) w z‖ ≤ C * ‖y - z‖ ^ α)) →
      ∀ {Ω : Set (Euclid m)} {u : Euclid m → Euclid k}, IsOpen Ω → ContDiffOn ℝ 1 u Ω →
      (∀ x ∈ Ω, ‖fderiv ℝ u x‖ ≤ ε₀) →
      (∀ ζ : Euclid m → Euclid k, ContDiff ℝ 1 ζ → HasCompactSupport ζ → tsupport ζ ⊆ Ω →
        ∫ y, ∑ j : Fin m, inner ℝ (fderiv ℝ u y (EuclideanSpace.single j (1 : ℝ)))
            (fderiv ℝ ζ y (EuclideanSpace.single j (1 : ℝ))) =
          ∫ y, ∑ j : Fin m, inner ℝ (G (fderiv ℝ u y) (EuclideanSpace.single j (1 : ℝ)))
            (fderiv ℝ ζ y (EuclideanSpace.single j (1 : ℝ)))) →
      ∀ (l : ℕ), 1 ≤ l →
      (ContDiffOn ℝ l (fderiv ℝ u) Ω ∧ ∀ x ∈ Ω, ∃ ρ : ℝ, 0 < ρ ∧ ball x ρ ⊆ Ω ∧ ∃ C : ℝ,
        ∀ y ∈ ball x ρ, ∀ z ∈ ball x ρ,
          ‖iteratedFDeriv ℝ l (fderiv ℝ u) y - iteratedFDeriv ℝ l (fderiv ℝ u) z‖ ≤
            C * ‖y - z‖ ^ α) →
      ContDiffOn ℝ ((l + 1 : ℕ) : WithTop ℕ∞) (fderiv ℝ u) Ω ∧ ∀ x ∈ Ω, ∃ ρ : ℝ, 0 < ρ ∧
        ball x ρ ⊆ Ω ∧ ∃ C : ℝ, ∀ y ∈ ball x ρ, ∀ z ∈ ball x ρ,
          ‖iteratedFDeriv ℝ (l + 1) (fderiv ℝ u) y - iteratedFDeriv ℝ (l + 1) (fderiv ℝ u) z‖ ≤
            C * ‖y - z‖ ^ α := by
    intro α εL Λ ε₀ hα0 hα1 hΛL hε₀ hb hL Ω u hΩ hu hDu hweak l hl hQ
    have hHA := Submission.codim1_hcp_sr_holder_algebra m α Ω hΩ hα0 hα1
    have hDu1 : ContDiffOn ℝ 1 (fderiv ℝ u) Ω := hQ.1.of_le (by exact_mod_cast hl)
    have hDG : ContDiff ℝ (⊤ : ℕ∞) (fderiv ℝ G) := (contDiff_infty_iff_fderiv.mp hG).2
    -- `u` is `C²` on `Ω`, so its second derivative is symmetric
    have hu2 : ContDiffOn ℝ 2 u Ω := by
      have h := (contDiffOn_succ_iff_fderiv_of_isOpen (n := 1) hΩ).2
        ⟨hu.differentiableOn one_ne_zero, fun h => absurd h (by simp), hDu1⟩
      rwa [one_add_one_eq_two] at h
    have hsymm : ∀ y ∈ Ω, ∀ a b : Euclid m,
        fderiv ℝ (fderiv ℝ u) y a b = fderiv ℝ (fderiv ℝ u) y b a := fun y hy a b =>
      (hu2.contDiffAt (hΩ.mem_nhds hy)).isSymmSndFDerivAt
        (by simp [minSmoothness_of_isRCLikeNormedField]) a b
    -- `D(∂ₛu) = D²u eₛ` on `Ω`
    have hvderiv : ∀ (s : Fin m), ∀ y ∈ Ω,
        fderiv ℝ (fun y => fderiv ℝ u y (EuclideanSpace.single s (1 : ℝ))) y =
          fderiv ℝ (fderiv ℝ u) y (EuclideanSpace.single s (1 : ℝ)) := by
      intro s y hy
      have hd : DifferentiableAt ℝ (fderiv ℝ u) y :=
        (hDu1.differentiableOn one_ne_zero y hy).differentiableAt (hΩ.mem_nhds hy)
      rw [fderiv_clm_apply hd (differentiableAt_const _), fderiv_const_apply,
        ContinuousLinearMap.comp_zero, zero_add]
      refine ContinuousLinearMap.ext fun a => ?_
      rw [ContinuousLinearMap.flip_apply, hsymm y hy]
    -- coefficients `B = DG ∘ Du ∈ C^{l,α}_loc` and `g = 0`
    have hB := (hHA l).2.2.2.1 (Euclid m →L[ℝ] Euclid k)
      ((Euclid m →L[ℝ] Euclid k) →L[ℝ] (Euclid m →L[ℝ] Euclid k)) (fderiv ℝ G) (fderiv ℝ u) hDG hQ
    have h0 := (hHA l).1 (Euclid m →L[ℝ] Euclid k) 0
    -- each `∂ₛu` is in `C^{l+1,α}_loc`
    have hv : ∀ s : Fin m,
        ContDiffOn ℝ ((l + 1 : ℕ) : WithTop ℕ∞)
            (fun y => fderiv ℝ u y (EuclideanSpace.single s (1 : ℝ))) Ω ∧
          ∀ x ∈ Ω, ∃ ρ : ℝ, 0 < ρ ∧ ball x ρ ⊆ Ω ∧ ∃ C : ℝ, ∀ y ∈ ball x ρ, ∀ z ∈ ball x ρ,
            ‖iteratedFDeriv ℝ (l + 1)
                (fun y => fderiv ℝ u y (EuclideanSpace.single s (1 : ℝ))) y -
              iteratedFDeriv ℝ (l + 1)
                (fun y => fderiv ℝ u y (EuclideanSpace.single s (1 : ℝ))) z‖ ≤
              C * ‖y - z‖ ^ α := by
      intro s
      have hweak_s : ∀ ζ : Euclid m → Euclid k, ContDiff ℝ 1 ζ → HasCompactSupport ζ →
          tsupport ζ ⊆ Ω →
          ∫ x in Ω, ∑ j : Fin m, inner ℝ
              (fderiv ℝ (fun y => fderiv ℝ u y (EuclideanSpace.single s (1 : ℝ))) x
                (EuclideanSpace.single j (1 : ℝ)))
              (fderiv ℝ ζ x (EuclideanSpace.single j (1 : ℝ))) =
            ∫ x in Ω, ∑ j : Fin m, inner ℝ ((fderiv ℝ G (fderiv ℝ u x)
                (fderiv ℝ (fun y => fderiv ℝ u y (EuclideanSpace.single s (1 : ℝ))) x) +
                  (0 : Euclid m →L[ℝ] Euclid k)) (EuclideanSpace.single j (1 : ℝ)))
              (fderiv ℝ ζ x (EuclideanSpace.single j (1 : ℝ))) := by
        intro ζ hζ hζc hζΩ
        rw [qs_setIntegral_pair
            (fun x => fderiv ℝ (fun y => fderiv ℝ u y (EuclideanSpace.single s (1 : ℝ))) x) ζ hζΩ,
          qs_setIntegral_pair
            (fun x => fderiv ℝ G (fderiv ℝ u x)
              (fderiv ℝ (fun y => fderiv ℝ u y (EuclideanSpace.single s (1 : ℝ))) x) + 0) ζ hζΩ,
          qs_integral_pair_congr
            (A := fun x => fderiv ℝ (fun y => fderiv ℝ u y (EuclideanSpace.single s (1 : ℝ))) x)
            (A' := fun y => fderiv ℝ (fderiv ℝ u) y (EuclideanSpace.single s (1 : ℝ)))
            fun y hy => hvderiv s y (hζΩ hy),
          qs_integral_pair_congr
            (A := fun x => fderiv ℝ G (fderiv ℝ u x)
              (fderiv ℝ (fun y => fderiv ℝ u y (EuclideanSpace.single s (1 : ℝ))) x) + 0)
            (A' := fun y => fderiv ℝ G (fderiv ℝ u y)
              (fderiv ℝ (fderiv ℝ u) y (EuclideanSpace.single s (1 : ℝ))))
            fun y hy => by rw [hvderiv s y (hζΩ hy), add_zero]]
        exact qs_diff_eq hε₀ hb hΩ hDu1 hDu hweak (by simp) hζ hζc hζΩ
      have h := hL Ω l (fun y => fderiv ℝ u y (EuclideanSpace.single s (1 : ℝ)))
        (fun y => fderiv ℝ G (fderiv ℝ u y)) (fun _ => 0) hΩ (hDu1.clm_apply contDiffOn_const)
        (fun y hy => (hb _ (by linarith [hDu y hy])).trans hΛL) hB h0 hweak_s
      rwa [← Nat.cast_add_one] at h
    -- `Du = ∑ₛ λₛ(∂ₛu)` is in `C^{l+1,α}_loc`
    have hterm : ∀ s : Fin m,
        ContDiffOn ℝ ((l + 1 : ℕ) : WithTop ℕ∞) (fun y => ContinuousLinearMap.smulRightL ℝ
          (Euclid m) (Euclid k) (EuclideanSpace.proj s)
            (fderiv ℝ u y (EuclideanSpace.single s (1 : ℝ)))) Ω ∧
          ∀ x ∈ Ω, ∃ ρ : ℝ, 0 < ρ ∧ ball x ρ ⊆ Ω ∧ ∃ C : ℝ, ∀ y ∈ ball x ρ, ∀ z ∈ ball x ρ,
            ‖iteratedFDeriv ℝ (l + 1) (fun y => ContinuousLinearMap.smulRightL ℝ
                (Euclid m) (Euclid k) (EuclideanSpace.proj s)
                  (fderiv ℝ u y (EuclideanSpace.single s (1 : ℝ)))) y -
              iteratedFDeriv ℝ (l + 1) (fun y => ContinuousLinearMap.smulRightL ℝ
                (Euclid m) (Euclid k) (EuclideanSpace.proj s)
                  (fderiv ℝ u y (EuclideanSpace.single s (1 : ℝ)))) z‖ ≤ C * ‖y - z‖ ^ α :=
      fun s => (hHA (l + 1)).2.2.2.1 (Euclid k) (Euclid m →L[ℝ] Euclid k)
        (ContinuousLinearMap.smulRightL ℝ (Euclid m) (Euclid k) (EuclideanSpace.proj s))
        (fun y => fderiv ℝ u y (EuclideanSpace.single s (1 : ℝ)))
        (ContinuousLinearMap.contDiff _) (hv s)
    have hsum : ∀ S : Finset (Fin m),
        ContDiffOn ℝ ((l + 1 : ℕ) : WithTop ℕ∞) (fun y => ∑ s ∈ S,
          ContinuousLinearMap.smulRightL ℝ (Euclid m) (Euclid k) (EuclideanSpace.proj s)
            (fderiv ℝ u y (EuclideanSpace.single s (1 : ℝ)))) Ω ∧
          ∀ x ∈ Ω, ∃ ρ : ℝ, 0 < ρ ∧ ball x ρ ⊆ Ω ∧ ∃ C : ℝ, ∀ y ∈ ball x ρ, ∀ z ∈ ball x ρ,
            ‖iteratedFDeriv ℝ (l + 1) (fun y => ∑ s ∈ S,
                ContinuousLinearMap.smulRightL ℝ (Euclid m) (Euclid k) (EuclideanSpace.proj s)
                  (fderiv ℝ u y (EuclideanSpace.single s (1 : ℝ)))) y -
              iteratedFDeriv ℝ (l + 1) (fun y => ∑ s ∈ S,
                ContinuousLinearMap.smulRightL ℝ (Euclid m) (Euclid k) (EuclideanSpace.proj s)
                  (fderiv ℝ u y (EuclideanSpace.single s (1 : ℝ)))) z‖ ≤ C * ‖y - z‖ ^ α := by
      intro S
      induction S using Finset.induction_on with
      | empty =>
        have heq : (fun y : Euclid m => ∑ s ∈ (∅ : Finset (Fin m)),
            ContinuousLinearMap.smulRightL ℝ (Euclid m) (Euclid k) (EuclideanSpace.proj s)
              (fderiv ℝ u y (EuclideanSpace.single s (1 : ℝ)))) =
            fun _ => (0 : Euclid m →L[ℝ] Euclid k) := funext fun y => Finset.sum_empty
        rw [heq]
        exact (hHA (l + 1)).1 _ 0
      | insert s S hs ih =>
        have heq : (fun y : Euclid m => ∑ t ∈ insert s S,
            ContinuousLinearMap.smulRightL ℝ (Euclid m) (Euclid k) (EuclideanSpace.proj t)
              (fderiv ℝ u y (EuclideanSpace.single t (1 : ℝ)))) =
            fun y => ContinuousLinearMap.smulRightL ℝ (Euclid m) (Euclid k)
                (EuclideanSpace.proj s) (fderiv ℝ u y (EuclideanSpace.single s (1 : ℝ))) +
              ∑ t ∈ S, ContinuousLinearMap.smulRightL ℝ (Euclid m) (Euclid k)
                (EuclideanSpace.proj t) (fderiv ℝ u y (EuclideanSpace.single t (1 : ℝ))) :=
          funext fun y => Finset.sum_insert hs
        rw [heq]
        exact (hHA (l + 1)).2.1 _ _ _ (hterm s) ih
    have hdecomp : fderiv ℝ u = fun y => ∑ s : Fin m,
        ContinuousLinearMap.smulRightL ℝ (Euclid m) (Euclid k) (EuclideanSpace.proj s)
          (fderiv ℝ u y (EuclideanSpace.single s (1 : ℝ))) :=
      funext fun y => qs_clm_decomp (fderiv ℝ u y)
    rw [hdecomp]
    exact hsum Finset.univ
  -- Step 0: constants.  `α = 1/2`; `εD` is the constant of the `C^{1,α}` estimate, `εL` that of
  -- `codim1_hcp_sr_linear_bootstrap`, and `Λ = min εL (min 1 (εD / 2))`.
  have hα0 : (0 : ℝ) < 1 / 2 := by norm_num
  have hα1 : (1 / 2 : ℝ) < 1 := by norm_num
  obtain ⟨εD, hεD, hD⟩ := hC1all m k (1 / 2) hm hα0 hα1
  clear hC1all
  obtain ⟨εL, hεL, hL⟩ := Submission.codim1_hcp_sr_linear_bootstrap m k (1 / 2) hm hα0 hα1
  have hΛ0 : 0 < min εL (min 1 (εD / 2)) := lt_min hεL (lt_min one_pos (half_pos hεD))
  have hΛL : min εL (min 1 (εD / 2)) ≤ εL := min_le_left _ _
  have hΛ1 : min εL (min 1 (εD / 2)) ≤ 1 := (min_le_right _ _).trans (min_le_left _ _)
  have hΛD2 : min εL (min 1 (εD / 2)) ≤ εD / 2 := (min_le_right _ _).trans (min_le_right _ _)
  have hΛD : min εL (min 1 (εD / 2)) ≤ εD := by linarith
  have hΛsq : 2 * min εL (min 1 (εD / 2)) ^ 2 ≤ εD := by nlinarith
  have hΛsq' : min εL (min 1 (εD / 2)) ^ 2 ≤ εD := by nlinarith
  obtain ⟨ε₀, hε₀, Λ₂, hΛ₂, hb, hlip⟩ := qs_constants hG hDG0 hΛ0
  refine ⟨ε₀, hε₀, fun Ω u hΩ hu hDu hweakΩ => ?_⟩
  -- the weak equation, written over `ℝᵐ`
  have hweak : ∀ ζ : Euclid m → Euclid k, ContDiff ℝ 1 ζ → HasCompactSupport ζ → tsupport ζ ⊆ Ω →
      ∫ y, ∑ j : Fin m, inner ℝ (fderiv ℝ u y (EuclideanSpace.single j (1 : ℝ)))
          (fderiv ℝ ζ y (EuclideanSpace.single j (1 : ℝ))) =
        ∫ y, ∑ j : Fin m, inner ℝ (G (fderiv ℝ u y) (EuclideanSpace.single j (1 : ℝ)))
          (fderiv ℝ ζ y (EuclideanSpace.single j (1 : ℝ))) := fun ζ hζ hζc hζΩ => by
    have h := hweakΩ ζ hζ hζc hζΩ
    rwa [qs_setIntegral_pair (fderiv ℝ u) ζ hζΩ,
      qs_setIntegral_pair (fun y => G (fderiv ℝ u y)) ζ hζΩ] at h
  -- Steps 1 and 2: `Du` is locally `C^{1,1/2}`
  have hloc : ∀ x ∈ Ω, ∃ ρ : ℝ, 0 < ρ ∧ ball x ρ ⊆ Ω ∧
      ContDiffOn ℝ 1 (fderiv ℝ u) (ball x ρ) ∧ ∃ C : ℝ, ∀ y ∈ ball x ρ, ∀ z ∈ ball x ρ,
        ‖fderiv ℝ (fderiv ℝ u) y - fderiv ℝ (fderiv ℝ u) z‖ ≤ C * ‖y - z‖ ^ (1 / 2 : ℝ) := by
    intro x hx
    obtain ⟨R, hR, hRΩ⟩ := Metric.isOpen_iff.mp hΩ x hx
    obtain ⟨C₁, hC₁0, hC₁⟩ := qs_step1 hΛD hΛsq' hε₀ hb hD hΩ hu hDu hweak hR hRΩ
    obtain ⟨h1, C₂, h2⟩ := qs_step2 hα0 hΛD hΛsq hΛ₂ hε₀ hb hlip hD hΩ hu hDu hweak hR hRΩ
      hC₁0 hC₁
    exact ⟨R / 64, by positivity, (ball_subset_ball (by linarith)).trans hRΩ, h1, C₂, h2⟩
  have hDu1 : ContDiffOn ℝ 1 (fderiv ℝ u) Ω := contDiffOn_of_locally_contDiffOn fun x hx => by
    obtain ⟨ρ, hρ, -, h1, -⟩ := hloc x hx
    exact ⟨ball x ρ, isOpen_ball, mem_ball_self hρ, h1.mono inter_subset_right⟩
  have hHA := Submission.codim1_hcp_sr_holder_algebra m (1 / 2) Ω hΩ hα0 (by norm_num)
  -- `Du ∈ C^{1,1/2}_loc(Ω)`
  have hH0c : ContDiffOn ℝ ((0 : ℕ) : WithTop ℕ∞) (fun x => fderiv ℝ (fderiv ℝ u) x) Ω := by
    rw [Nat.cast_zero, contDiffOn_zero]
    exact hDu1.continuousOn_fderiv_of_isOpen hΩ le_rfl
  have hH0h : ∀ x ∈ Ω, ∃ ρ : ℝ, 0 < ρ ∧ ball x ρ ⊆ Ω ∧ ∃ C : ℝ, ∀ y ∈ ball x ρ,
      ∀ z ∈ ball x ρ, ‖iteratedFDeriv ℝ 0 (fun x => fderiv ℝ (fderiv ℝ u) x) y -
        iteratedFDeriv ℝ 0 (fun x => fderiv ℝ (fderiv ℝ u) x) z‖ ≤
          C * ‖y - z‖ ^ (1 / 2 : ℝ) := by
    intro x hx
    obtain ⟨ρ, hρ, hρΩ, -, C, hC⟩ := hloc x hx
    refine ⟨ρ, hρ, hρΩ, C, fun y hy z hz => ?_⟩
    rw [qs_norm_iteratedFDeriv_zero_sub]
    exact hC y hy z hz
  have hQ1 := ((hHA 0).2.2.2.2.2 (Euclid m →L[ℝ] Euclid k) (fderiv ℝ u) hDu1).mpr ⟨hH0c, hH0h⟩
  have e01 : ((0 : ℕ) : WithTop ℕ∞) + 1 = ((1 : ℕ) : WithTop ℕ∞) := by norm_num
  rw [e01] at hQ1
  -- Step 3: bootstrap
  have hQ : ∀ l : ℕ, 1 ≤ l → ContDiffOn ℝ (l : WithTop ℕ∞) (fderiv ℝ u) Ω ∧ ∀ x ∈ Ω,
      ∃ ρ : ℝ, 0 < ρ ∧ ball x ρ ⊆ Ω ∧ ∃ C : ℝ, ∀ y ∈ ball x ρ, ∀ z ∈ ball x ρ,
        ‖iteratedFDeriv ℝ l (fderiv ℝ u) y - iteratedFDeriv ℝ l (fderiv ℝ u) z‖ ≤
          C * ‖y - z‖ ^ (1 / 2 : ℝ) := by
    intro l hl
    induction l, hl using Nat.le_induction with
    | base => exact hQ1
    | succ l hl ih =>
      exact qs_bootstrap hα0 (by norm_num) hΛL hε₀.le hb hL hΩ hu hDu hweak l hl ih
  -- Step 4: conclusion
  intro r
  have h := (hQ (r + 1) (by omega)).1
  have h2 : ContDiffOn ℝ (((r + 1 : ℕ) : WithTop ℕ∞) + 1) u Ω :=
    (contDiffOn_succ_iff_fderiv_of_isOpen hΩ).2
      ⟨hu.differentiableOn one_ne_zero, fun h => absurd h (WithTop.natCast_ne_top _), h⟩
  refine h2.of_le ?_
  norm_cast
  omega
/-- **Simon 7.3.1** (proof of (2), local retraction onto `N`, chart step): if `W` is open, `ψ` is
continuous and injective on `V`, `ψ(V) = W ∩ N` and `ψ` is proper over `W` (`V ∩ ψ⁻¹(K)` is
compact for compact `K ⊆ W`), then `N ∩ B_ρ(ψ(v₀)) ⊆ ψ(V₀)` for some `ρ > 0`, whenever `V₀ ⊆ V`
is open and `v₀ ∈ V₀`.  Otherwise there are `yᵢ = ψ(fᵢ) ∈ N` with `fᵢ ∈ V \ V₀` and
`yᵢ → ψ(v₀)`; the `fᵢ` lie in the compact set `V ∩ ψ⁻¹({ψ(v₀)} ∪ {yᵢ})`, so a subsequence
converges to some `a ∈ V \ V₀` with `ψ(a) = ψ(v₀)`, contradicting injectivity. -/
theorem Submission.dtc_bc_lr_chart_image_nhds : ∀ (P d : ℕ) (N W : Set (Euclid P)) (V V₀ : Set (Euclid d)) (ψ : Euclid d → Euclid P) (v₀ : Euclid d), IsOpen W → ContinuousOn ψ V → InjOn ψ V → ψ '' V = W ∩ N → (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → IsOpen V₀ → V₀ ⊆ V → v₀ ∈ V₀ → ∃ ρ : ℝ, 0 < ρ ∧ N ∩ ball (ψ v₀) ρ ⊆ ψ '' V₀ := by
  intro P d N W V V₀ ψ v₀ hW hψc hψi hψV hprop hV₀ hV₀V hv₀
  -- Step 1: `x := ψ v₀ ∈ W` and `B_{r_W}(x) ⊆ W`
  have hv₀V : v₀ ∈ V := hV₀V hv₀
  have hxW : ψ v₀ ∈ W := (hψV ▸ mem_image_of_mem ψ hv₀V : ψ v₀ ∈ W ∩ N).1
  obtain ⟨rW, hrW, hballW⟩ := Metric.isOpen_iff.1 hW _ hxW
  -- Step 2: otherwise pick `yᵢ ∈ N ∩ B_{min(r_W, 1/(i+1))}(x) \ ψ(V₀)`, so `yᵢ ∈ W` and `yᵢ → x`
  by_contra hcon
  have hseq : ∀ i : ℕ, ∃ y, y ∈ N ∧ dist y (ψ v₀) < min rW (1 / ((i : ℝ) + 1)) ∧ y ∉ ψ '' V₀ := by
    intro i
    obtain ⟨y, ⟨hyN, hyb⟩, hy⟩ := not_subset.1 fun h =>
      hcon ⟨min rW (1 / ((i : ℝ) + 1)), lt_min hrW (by positivity), h⟩
    exact ⟨y, hyN, hyb, hy⟩
  choose y hyN hyd hyV₀ using hseq
  have hyW : ∀ i, y i ∈ W := fun i => hballW ((hyd i).trans_le (min_le_left _ _))
  have hylim : Tendsto y atTop (𝓝 (ψ v₀)) :=
    tendsto_iff_dist_tendsto_zero.2 (squeeze_zero (fun i => dist_nonneg)
      (fun i => ((hyd i).trans_le (min_le_right _ _)).le) tendsto_one_div_add_atTop_nhds_zero_nat)
  -- Step 3: `yᵢ = ψ(fᵢ)` with `fᵢ ∈ V \ V₀`
  have hf : ∀ i, ∃ f, f ∈ V ∧ ψ f = y i := fun i => (hψV.symm ▸ ⟨hyW i, hyN i⟩ : y i ∈ ψ '' V)
  choose f hfV hfy using hf
  have hfV₀ : ∀ i, f i ∉ V₀ := fun i hi => hyV₀ i ⟨f i, hi, hfy i⟩
  -- Step 4: `K := {x} ∪ {yᵢ}` is a compact subset of `W`, so `V ∩ ψ⁻¹(K) ∋ fᵢ` is compact
  have hKW : insert (ψ v₀) (range y) ⊆ W := by
    rintro z (rfl | ⟨i, rfl⟩)
    exacts [hxW, hyW i]
  have hfK : ∀ i, f i ∈ V ∩ ψ ⁻¹' insert (ψ v₀) (range y) := fun i =>
    ⟨hfV i, Or.inr ⟨i, (hfy i).symm⟩⟩
  -- Step 5: a subsequence `f_{φ(i)} → a ∈ V`
  obtain ⟨a, ⟨haV, -⟩, φ, hφ, hfa⟩ :=
    (hprop _ hKW hylim.isCompact_insert_range).tendsto_subseq hfK
  -- Step 6: `a ∉ V₀`, as `V₀ᶜ` is closed
  have haV₀ : a ∉ V₀ :=
    hV₀.isClosed_compl.mem_of_tendsto hfa (Eventually.of_forall fun i => hfV₀ (φ i))
  -- Step 7: `ψ(a) = x` by continuity of `ψ` on `V` and uniqueness of limits
  have h₁ : Tendsto (ψ ∘ (f ∘ φ)) atTop (𝓝 (ψ a)) :=
    (hψc a haV).tendsto.comp
      (tendsto_nhdsWithin_iff.2 ⟨hfa, Eventually.of_forall fun i => hfV (φ i)⟩)
  have h₂ : Tendsto (ψ ∘ (f ∘ φ)) atTop (𝓝 (ψ v₀)) := by
    have hcomp : ψ ∘ (f ∘ φ) = y ∘ φ := funext fun i => hfy (φ i)
    rw [hcomp]
    exact hylim.comp hφ.tendsto_atTop
  -- Step 8: injectivity gives `a = v₀ ∈ V₀`, a contradiction
  exact haV₀ (hψi haV hv₀V (tendsto_nhds_unique h₁ h₂) ▸ hv₀)
/-- **Simon Ch. 2, (4.18)–(4.20)** (tangential divergence in an orthonormal frame): if `τ₁, …, τₙ`
is an orthonormal basis of `Q`, then `trace(p_Q ∘ B) = Σₐ τₐ · Bτₐ`.  The orthogonality
characterization of the projection gives `p_Q z = Σₐ (τₐ · z) τₐ`, so `p_Q ∘ B` is the sum of the
rank-one maps `z ↦ (τₐ · Bz) τₐ`, and the trace of `z ↦ ℓ(z) v` is `ℓ(v)`. -/
theorem Submission.fvmb_trace_starProjection_comp_eq_sum_inner : ∀ (P n : ℕ) (Q : Submodule ℝ (Euclid P)) (τ : Fin n → Euclid P) (B : Euclid P →L[ℝ] Euclid P), Orthonormal ℝ τ → Submodule.span ℝ (Set.range τ) = Q → LinearMap.trace ℝ (Euclid P) (Q.starProjection.toLinearMap ∘ₗ B.toLinearMap) = ∑ a, inner ℝ (τ a) (B (τ a)) := by
  intro P n Q τ B hτ hQ
  -- `p_Q z = Σₐ ⟪τₐ, z⟫ τₐ`: the right side lies in `Q` and `z` minus it is orthogonal to `Q`
  have hproj : ∀ z : Euclid P, Q.starProjection z = ∑ a, inner ℝ (τ a) z • τ a := by
    intro z
    apply Submodule.eq_starProjection_of_mem_of_inner_eq_zero
    · rw [← hQ]
      exact Submodule.sum_mem _ fun a _ =>
        Submodule.smul_mem _ _ (Submodule.subset_span ⟨a, rfl⟩)
    · intro q hq
      rw [← hQ] at hq
      induction hq using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨b, rfl⟩ := hx
        rw [inner_sub_left, hτ.inner_left_fintype, real_inner_comm]
        simp
      | zero => simp
      | add x y _ _ hx hy => rw [inner_add_right, hx, hy, add_zero]
      | smul c x _ hx => rw [inner_smul_right, hx, mul_zero]
  -- `p_Q ∘ B = Σₐ (z ↦ ⟪τₐ, Bz⟫ τₐ)`
  have hdecomp : Q.starProjection.toLinearMap ∘ₗ B.toLinearMap =
      ∑ a, ((innerₛₗ ℝ (τ a)) ∘ₗ B.toLinearMap).smulRight (τ a) := by
    ext z
    simp [hproj]
  -- `trace (z ↦ ℓ(z) v) = ℓ(v)` (`LinearMap.trace_smulRight`), summed over `a`
  rw [hdecomp, map_sum]
  simp
/-- **Simon Ch. 2, §4, (4.3)**: if `ψ : V → W` is a local representation of `N` as in (4.1)
(`Cʳ`, `r ≥ 1`, 1:1 and proper, `ψ(V) = W ∩ N`, `Dψ` injective), then
`T_{ψ(v)}N = Dψ(v)(ℝᵈ)` for every `v ∈ V`.  `Dψ(v)(ℝᵈ) ⊆ T_{ψ(v)}N` because `ψ(V) ⊆ N`.
Conversely, properness and injectivity make `ψ⁻¹` continuous at `ψ(v)` on `ψ(V)`; with `Dψ(v)`
injective this gives, for each `ε > 0`, some `a` with `|y − ψ(v) − Dψ(v)a| ≤ ε|y − ψ(v)|` for all
`y ∈ N` near `ψ(v)`, so the difference quotients of a `C¹` curve in `N` through `ψ(v)` converge
into the closed subspace `Dψ(v)(ℝᵈ)`. -/
theorem Submission.chart_tangentSpace_eq_range_fderiv : ∀ (P d r : ℕ) (N W : Set (Euclid P)) (V : Set (Euclid d)) (ψ : Euclid d → Euclid P) (v : Euclid d), 1 ≤ r → IsOpen V → IsOpen W → ContDiffOn ℝ r ψ V → InjOn ψ V → ψ '' V = W ∩ N → (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → (∀ z ∈ V, Injective (fderiv ℝ ψ z)) → v ∈ V → tangentSpace N (ψ v) = Set.range (fderiv ℝ ψ v) := by
  intro P d r N W V ψ v hr hV hW hψ hinj hψV hproper hDψ hv
  -- `ψ` is `C¹` on the open set `V`, hence differentiable at `v` with derivative `Dψ(v)`
  have hψ1 : ContDiffOn ℝ 1 ψ V := hψ.of_le (by exact_mod_cast hr)
  have hψv : HasFDerivAt ψ (fderiv ℝ ψ v) v :=
    ((hψ1.differentiableOn one_ne_zero).differentiableAt (hV.mem_nhds hv)).hasFDerivAt
  -- `ψ(V) = W ∩ N` lies in `W` and in `N`
  have hVW : ψ '' V ⊆ W := hψV ▸ inter_subset_left
  have hVN : ψ '' V ⊆ N := hψV ▸ inter_subset_right
  -- `ψ⁻¹` is continuous at `ψ(v)` on `ψ(V)`
  have hinv := Submission.dsmc_chart_inverse_continuity P d V W ψ hψ.continuousOn hinj hVW
    hproper v hv
  refine Subset.antisymm ?_
    (Submission.dsmc_chart_range_subset_tangentSpace P r d N V ψ hr hV hψ hVN v hv)
  -- `T_{ψ(v)}N ⊆ Dψ(v)(ℝᵈ)`, from the secant estimate at `ψ(v)`
  exact Submission.dsmc_tangentSpace_subset_range_of_secant P d N (ψ v) (fderiv ℝ ψ v)
    (Submission.dsmc_chart_secant_estimate P d N V W ψ (fderiv ℝ ψ v) v hW hψV hv hψv
      (hDψ v hv) hinv)
/-- **Simon Ch. 2, §4, (4.1)**: being an embedded `d`-dimensional `Cʳ` submanifold is a local
property, and an open piece `M ∩ O` has the tangent spaces of `M`.  A chart `ψ : V → W` of
`M ∩ O` at `y` (`O ∋ y` open) is a chart `ψ : V → W ∩ O` of `M` at `y`.  A chart `ψ : V → W` of
`M` at `w ∈ O` restricts to the chart `ψ : V ∩ ψ⁻¹(O) → W ∩ O` of `M ∩ O` at `w`: `V ∩ ψ⁻¹(O)`
is open as `ψ` is continuous on `V`, and `V ∩ ψ⁻¹(O) ∩ ψ⁻¹(K) = V ∩ ψ⁻¹(K)` for `K ⊆ W ∩ O`.
Both charts contain `v = ψ⁻¹(w)`, so for `r ≥ 1`, (4.3) gives `T_w(M ∩ O) = Dψ(v)(ℝᵈ) = T_wM`. -/
theorem Submission.codim1_ovr_embedded_submanifold_local : ∀ (P r d : ℕ) (M : Set (Euclid P)), 1 ≤ r → (∀ y ∈ M, ∃ O : Set (Euclid P), IsOpen O ∧ y ∈ O ∧ IsEmbeddedSubmanifold r d (M ∩ O)) → IsEmbeddedSubmanifold r d M ∧ ∀ O : Set (Euclid P), IsOpen O → IsEmbeddedSubmanifold r d (M ∩ O) ∧ ∀ w ∈ M ∩ O, tangentSpace (M ∩ O) w = tangentSpace M w := by
  intro P r d M hr hloc
  -- Step 1: a chart `ψ : V → W` of `M ∩ O` at `y` is a chart `ψ : V → W ∩ O` of `M` at `y`
  have hM : IsEmbeddedSubmanifold r d M := by
    intro y hy
    obtain ⟨O, hO, hyO, hMO⟩ := hloc y hy
    obtain ⟨V, W, ψ, hV, hW, hyW, hψ, hinj, himg, hprop, hder⟩ := hMO y ⟨hy, hyO⟩
    refine ⟨V, W ∩ O, ψ, hV, hW.inter hO, ⟨hyW, hyO⟩, hψ, hinj, ?_, ?_, hder⟩
    · -- `ψ(V) = W ∩ (M ∩ O) = (W ∩ O) ∩ M`
      rw [himg]; ext z; simp only [mem_inter_iff]; tauto
    · -- a compact `K ⊆ W ∩ O` lies in `W`
      intro K hK hKc; exact hprop K (hK.trans inter_subset_left) hKc
  -- Step 2: a chart `ψ : V → W` of `M` at `w ∈ O` restricts to the chart `ψ : V ∩ ψ⁻¹(O) → W ∩ O`
  -- of `M ∩ O` at `w`, through `v = ψ⁻¹(w)`; (4.3) for `M` gives `T_wM = Dψ(v)(ℝᵈ)`
  have hres : ∀ O : Set (Euclid P), IsOpen O → ∀ w ∈ M ∩ O, ∃ (V : Set (Euclid d))
      (W : Set (Euclid P)) (ψ : Euclid d → Euclid P) (v : Euclid d),
      IsOpen V ∧ IsOpen W ∧ w ∈ W ∧ ContDiffOn ℝ r ψ V ∧ InjOn ψ V ∧ ψ '' V = W ∩ (M ∩ O) ∧
      (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) ∧ (∀ z ∈ V, Injective (fderiv ℝ ψ z)) ∧
      v ∈ V ∧ ψ v = w ∧ tangentSpace M w = Set.range (fderiv ℝ ψ v) := by
    intro O hO w hw
    obtain ⟨V, W, ψ, hV, hW, hwW, hψ, hinj, himg, hprop, hder⟩ := hM w hw.1
    obtain ⟨v, hvV, hvw⟩ : w ∈ ψ '' V := by rw [himg]; exact ⟨hwW, hw.1⟩
    have hTM := Submission.chart_tangentSpace_eq_range_fderiv P d r M W V ψ v hr hV hW hψ hinj
      himg hprop hder hvV
    rw [hvw] at hTM
    refine ⟨V ∩ ψ ⁻¹' O, W ∩ O, ψ, v, hψ.continuousOn.isOpen_inter_preimage hV hO, hW.inter hO,
      ⟨hwW, hw.2⟩, hψ.mono inter_subset_left, hinj.mono inter_subset_left, ?_, ?_,
      fun z hz => hder z hz.1, ⟨hvV, by rw [mem_preimage, hvw]; exact hw.2⟩, hvw, hTM⟩
    · -- `ψ(V ∩ ψ⁻¹(O)) = ψ(V) ∩ O = (W ∩ M) ∩ O = (W ∩ O) ∩ (M ∩ O)`
      rw [image_inter_preimage, himg]; ext z; simp only [mem_inter_iff]; tauto
    · -- for compact `K ⊆ W ∩ O`, `V ∩ ψ⁻¹(O) ∩ ψ⁻¹(K) = V ∩ ψ⁻¹(K)`, compact as `K ⊆ W`
      intro K hK hKc
      have heq : (V ∩ ψ ⁻¹' O) ∩ ψ ⁻¹' K = V ∩ ψ ⁻¹' K := by
        ext z; simp only [mem_inter_iff, mem_preimage]
        constructor
        · rintro ⟨⟨h1, -⟩, h3⟩; exact ⟨h1, h3⟩
        · rintro ⟨h1, h3⟩; exact ⟨⟨h1, (hK h3).2⟩, h3⟩
      rw [heq]; exact hprop K (hK.trans inter_subset_left) hKc
  refine ⟨hM, fun O hO => ⟨fun w hw => ?_, fun w hw => ?_⟩⟩
  · -- Step 2: the restricted charts show that `M ∩ O` is an embedded submanifold
    obtain ⟨V, W, ψ, v, hV, hW, hwW, hψ, hinj, himg, hprop, hder, -⟩ := hres O hO w hw
    exact ⟨V, W, ψ, hV, hW, hwW, hψ, hinj, himg, hprop, hder⟩
  · -- Step 3: (4.3) for `M ∩ O` and the restricted chart, `T_w(M ∩ O) = Dψ(v)(ℝᵈ) = T_wM`
    obtain ⟨V, W, ψ, v, hV, hW, hwW, hψ, hinj, himg, hprop, hder, hvV, hvw, hTM⟩ := hres O hO w hw
    have hTMO := Submission.chart_tangentSpace_eq_range_fderiv P d r (M ∩ O) W V ψ v hr hV hW hψ
      hinj himg hprop hder hvV
    rw [hvw] at hTMO
    rw [hTMO, hTM]
/-- **Tangent space of a hypersurface in an `(m + 1)`-plane** (Simon Ch. 2, §4, (4.3), and
Appendix B, p. 231: `T_xM` and the unit normal `ν(x)` together span the ambient space).  Let
`M ⊆ A₀` be an embedded `C¹` `m`-submanifold, `dim A₀ = m + 1`, and let `ν(x) ∈ A₀` be a unit
vector orthogonal to `T_xM`.  Then `T_xM = A₀ ∩ ν(x)ᗮ`, and the orthogonal projection onto
`T_xM` is `w ↦ Π_{A₀}w − (ν(x)·w)ν(x)`.  A chart `ψ` with `ψ(v₀) = x` gives
`T_xM = Dψ(v₀)(ℝᵐ)`, of dimension `m`.  Difference quotients of curves in `M ⊆ A₀` lie in the
closed subspace `A₀`, so `T_xM ⊆ A₀ ∩ ν(x)ᗮ`, which has dimension `(m + 1) − 1 = m`; hence
equality.  Finally `u = Π_{A₀}w − (ν(x)·w)ν(x)` lies in `A₀ ∩ ν(x)ᗮ` and `w − u` is orthogonal
to it. -/
theorem Submission.codim1_hcp_sc_tangent_normal_complement : ∀ (P m : ℕ) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)) (ν : Euclid P → Euclid P), Module.finrank ℝ A₀ = m + 1 → M ⊆ (A₀ : Set (Euclid P)) → IsEmbeddedSubmanifold 1 m M → (∀ x ∈ M, ν x ∈ A₀ ∧ ‖ν x‖ = 1 ∧ ∀ v ∈ tangentSpace M x, inner ℝ (ν x) v = 0) → ∀ x ∈ M, tangentSpace M x = {v : Euclid P | v ∈ A₀ ∧ inner ℝ (ν x) v = 0} ∧ ∀ w : Euclid P, (Submodule.span ℝ (tangentSpace M x)).starProjection w = A₀.starProjection w - inner ℝ (ν x) w • ν x := by
  intro P m A₀ M ν hdim hMA hM hν x hx
  obtain ⟨hνA, hν1, hνT⟩ := hν x hx
  -- Step 1: a chart `ψ` at `x = ψ(v₀)` gives `T_xM = Dψ(v₀)(ℝᵐ)`, a subspace of dimension `m`
  obtain ⟨V, W, ψ, hV, hW, hxW, hψ, hinj, hψV, hprop, hDψ⟩ := hM x hx
  obtain ⟨v₀, hv₀, hψv₀⟩ : x ∈ ψ '' V := hψV ▸ ⟨hxW, hx⟩
  set L : Submodule ℝ (Euclid P) :=
    LinearMap.range ((fderiv ℝ ψ v₀ : Euclid m →L[ℝ] Euclid P) : Euclid m →ₗ[ℝ] Euclid P) with hL
  have hT : tangentSpace M x = (L : Set (Euclid P)) := by
    rw [← hψv₀]
    exact Submission.chart_tangentSpace_eq_range_fderiv P m 1 M W V ψ v₀ le_rfl hV hW hψ hinj
      hψV hprop hDψ hv₀
  have hLdim : Module.finrank ℝ L = m := by
    rw [hL, LinearMap.finrank_range_of_inj (hDψ v₀ hv₀), finrank_euclideanSpace_fin]
  -- Step 2: `T_xM ⊆ A₀`, as difference quotients of curves in `M ⊆ A₀` lie in the closed `A₀`
  have hTA : ∀ v ∈ tangentSpace M x, v ∈ A₀ := by
    rintro v ⟨γ, -, hγM, hγ0, hγv⟩
    refine A₀.closed_of_finiteDimensional.mem_of_tendsto hγv.tendsto_slope ?_
    filter_upwards [nhdsWithin_le_nhds (Ioo_mem_nhds (by norm_num : (-1 : ℝ) < 0)
      (by norm_num : (0 : ℝ) < 1))] with t ht
    rw [slope_def_module]
    exact A₀.smul_mem _ (A₀.sub_mem (hMA (hγM ht)) (hγ0 ▸ hMA hx))
  -- Step 3: `T_xM ⊆ H = A₀ ∩ ν(x)ᗮ`
  set H : Submodule ℝ (Euclid P) := (ℝ ∙ ν x)ᗮ ⊓ A₀ with hH
  have hmemH : ∀ v, v ∈ H ↔ v ∈ A₀ ∧ inner ℝ (ν x) v = 0 := fun v => by
    rw [hH, Submodule.mem_inf, Submodule.mem_orthogonal_singleton_iff_inner_right, and_comm]
  have hLH : L ≤ H := fun v hv => by
    have hvT : v ∈ tangentSpace M x := hT ▸ hv
    exact (hmemH v).2 ⟨hTA v hvT, hνT v hvT⟩
  -- Step 4: `dim H = (m + 1) - 1 = m`, since `ν(x) ∈ A₀` is a unit vector
  have hν0 : ν x ≠ 0 := by
    rintro h
    rw [h, norm_zero] at hν1
    exact zero_ne_one hν1
  have hHdim : Module.finrank ℝ H = m := by
    have h : Module.finrank ℝ (ℝ ∙ ν x) + Module.finrank ℝ H = Module.finrank ℝ A₀ :=
      Submodule.finrank_add_inf_finrank_orthogonal
        ((Submodule.span_singleton_le_iff_mem (ν x) A₀).2 hνA)
    rw [finrank_span_singleton hν0, hdim] at h
    omega
  -- Step 5: `T_xM = H`
  have hLeq : L = H := Submodule.eq_of_le_of_finrank_eq hLH (hLdim.trans hHdim.symm)
  have hspan : Submodule.span ℝ (tangentSpace M x) = H := by
    rw [hT, Submodule.span_eq, hLeq]
  refine ⟨?_, fun w => ?_⟩
  · rw [hT, hLeq]
    ext v
    exact hmemH v
  -- Step 6: `u = Πw - ⟪ν(x), w⟫ν(x)` lies in `H` and `w - u ⊥ H`
  · have hPν : inner ℝ (ν x) (A₀.starProjection w) = inner ℝ (ν x) w := by
      rw [← Submodule.inner_starProjection_left_eq_right A₀,
        Submodule.starProjection_eq_self_iff.2 hνA]
    have hνν : inner ℝ (ν x) (ν x) = (1 : ℝ) := by
      rw [real_inner_self_eq_norm_sq, hν1, one_pow]
    apply Submodule.eq_starProjection_of_mem_of_inner_eq_zero
    · rw [hspan, hmemH]
      refine ⟨A₀.sub_mem (A₀.starProjection_apply_mem w) (A₀.smul_mem _ hνA), ?_⟩
      rw [inner_sub_right, real_inner_smul_right, hPν, hνν, mul_one, sub_self]
    · intro h hh
      rw [hspan, hmemH] at hh
      have h1 : inner ℝ (w - A₀.starProjection w) h = 0 :=
        Submodule.starProjection_inner_eq_zero w h hh.1
      rw [sub_sub_eq_add_sub, add_sub_right_comm, inner_add_left, h1, real_inner_smul_left, hh.2,
        mul_zero, zero_add]
/-- **`Cʳ` inverse function theorem with a `Cʳ` inverse on a neighbourhood** (Simon Ch. 2, 4.4;
smooth charts of the hypercone plane: `φ` maps an open `V₀ ∋ z₀` `Cʳ`-diffeomorphically onto an
open `O`).  If `φ : ℝᵈ → ℝᵈ` is `Cʳ` (`r ≥ 1`) on an open `V ∋ z₀` and `Dφ(z₀)` is injective,
there are open sets `V₀`, `O` with `z₀ ∈ V₀ ⊆ V` such that `φ : V₀ → O` is a bijection whose
inverse `χ` is `Cʳ` on `O`.  `Dφ` is continuous on `V`, so `V' = {z ∈ V : Dφ(z) injective}` is
open; the strict-derivative inverse function theorem gives an open partial homeomorphism `Φ = φ`
with `z₀ ∈ Φ.source`; take `V₀ = Φ.source ∩ V'`, `O = Φ.target ∩ Φ.symm ⁻¹' V₀` and
`χ = Φ.symm`, which is `Cʳ` at every `a ∈ O` because `Dφ(χ a)` is invertible. -/
theorem Submission.codim1_hcp_sc_local_inverse_cr : ∀ (d r : ℕ) (φ : Euclid d → Euclid d) (V : Set (Euclid d)) (z₀ : Euclid d), 1 ≤ r → IsOpen V → z₀ ∈ V → ContDiffOn ℝ r φ V → Injective (fderiv ℝ φ z₀) → ∃ (V₀ O : Set (Euclid d)) (χ : Euclid d → Euclid d), IsOpen V₀ ∧ IsOpen O ∧ z₀ ∈ V₀ ∧ V₀ ⊆ V ∧ ContDiffOn ℝ r χ O ∧ MapsTo χ O V₀ ∧ (∀ a ∈ O, φ (χ a) = a) ∧ ∀ z ∈ V₀, φ z ∈ O ∧ χ (φ z) = z := by
  intro d r φ V z₀ hr hV hz₀ hφ hinj
  -- `r ≥ 1` as an exponent in `WithTop ℕ∞`: `1 ≤ r` and `r ≠ 0`
  have hr1 : (1 : WithTop ℕ∞) ≤ r := by exact_mod_cast hr
  have hr0 : (r : WithTop ℕ∞) ≠ 0 := by exact_mod_cast Nat.one_le_iff_ne_zero.mp hr
  -- step 1: `φ` is `Cʳ` and differentiable at every point of `V`, and `Dφ` is continuous on `V`
  have hcont : ContinuousOn (fderiv ℝ φ) V := hφ.continuousOn_fderiv_of_isOpen hV hr1
  have hdiff : ∀ z ∈ V, HasFDerivAt φ (fderiv ℝ φ z) z := fun z hz =>
    ((hφ.contDiffAt (hV.mem_nhds hz)).differentiableAt hr0).hasFDerivAt
  -- step 2: an injective endomorphism of `ℝᵈ` is a continuous linear equivalence
  have equivOf : ∀ L : Euclid d →L[ℝ] Euclid d, Injective L →
      ∃ E : Euclid d ≃L[ℝ] Euclid d, (E : Euclid d →L[ℝ] Euclid d) = L := by
    intro L hL
    have hsurj : Surjective L := LinearMap.injective_iff_surjective.mp hL
    exact ⟨(LinearEquiv.ofBijective (L : Euclid d →ₗ[ℝ] Euclid d)
      ⟨hL, hsurj⟩).toContinuousLinearEquiv, by ext; rfl⟩
  -- step 3: `V' = {z ∈ V : Dφ(z) injective}` is open and contains `z₀`
  set V' := V ∩ (fderiv ℝ φ) ⁻¹' {L | Injective L}
  have hV' : IsOpen V' := hcont.isOpen_inter_preimage hV ContinuousLinearMap.isOpen_injective
  have hz₀' : z₀ ∈ V' := ⟨hz₀, hinj⟩
  -- step 4: the inverse function theorem at `z₀` gives `Φ = φ` with `z₀ ∈ Φ.source`
  obtain ⟨E₀, hE₀⟩ := equivOf _ hinj
  have hstrict : HasStrictFDerivAt φ (E₀ : Euclid d →L[ℝ] Euclid d) z₀ := by
    rw [hE₀]; exact (hφ.contDiffAt (hV.mem_nhds hz₀)).hasStrictFDerivAt hr0
  set Φ := hstrict.toOpenPartialHomeomorph φ
  have hΦcoe : ∀ z, Φ z = φ z := fun z => rfl
  -- step 5: `V₀ = Φ.source ∩ V'`, `O = Φ.target ∩ Φ.symm ⁻¹' V₀`, `χ = Φ.symm`; for `a ∈ O`,
  -- `χ a ∈ V₀` and `φ (χ a) = a`
  have hV₀ : IsOpen (Φ.source ∩ V') := Φ.open_source.inter hV'
  refine ⟨Φ.source ∩ V', Φ.target ∩ Φ.symm ⁻¹' (Φ.source ∩ V'), Φ.symm, hV₀,
    Φ.continuousOn_symm.isOpen_inter_preimage Φ.open_target hV₀,
    ⟨hstrict.mem_toOpenPartialHomeomorph_source, hz₀'⟩, fun z hz => hz.2.1, ?_,
    fun a ha => ha.2, fun a ha => by rw [← hΦcoe]; exact Φ.right_inv ha.1, fun z hz => ?_⟩
  -- step 7: `χ` is `Cʳ` at every `a ∈ O`, since `Dφ(χ a)` is invertible and `φ` is `Cʳ` at `χ a`
  · intro a ha
    have hz : Φ.symm a ∈ V' := ha.2.2
    obtain ⟨E, hE⟩ := equivOf _ hz.2
    apply ContDiffAt.contDiffWithinAt
    apply Φ.contDiffAt_symm ha.1
    · rw [hE]; exact hdiff _ hz.1
    · exact hφ.contDiffAt (hV.mem_nhds hz.1)
  -- step 6: for `z ∈ V₀`, `φ z ∈ O` and `χ (φ z) = z`
  · have h1 : Φ.symm (Φ z) = z := Φ.left_inv hz.1
    rw [← hΦcoe]
    exact ⟨⟨Φ.map_source hz.1, by rw [Set.mem_preimage, h1]; exact hz⟩, h1⟩
/-- **A linear left inverse makes a map an injective immersion** (Simon Ch. 2, §4, (4.4), where
the graph map `G(x) = (x, u(x))` has the linear left inverse `(x, y) ↦ x`; step 4 of the `C^∞`
chart construction for the hypercone plane).  Let `D ⊆ ℝᵈ` be open, `g` differentiable on `D`,
and `π : ℝᴾ → ℝᵈ` continuous linear with `π(g(a) − c) = a` for `a ∈ D`.  Then `g` is injective
on `D`, since `a = π(g(a) − c) = π(g(b) − c) = b`.  For `a ∈ D` the map `b ↦ π(g(b) − c)` has
derivative `π ∘ Dg(a)` at `a` by the chain rule, and it agrees with the identity on the
neighbourhood `D` of `a`; uniqueness of the derivative gives `π ∘ Dg(a) = id`, so `π` is a left
inverse of `Dg(a)` and `Dg(a)` is injective. -/
theorem Submission.codim1_hcp_sc_left_inverse_immersion : ∀ (P d : ℕ) (D : Set (Euclid d)) (g : Euclid d → Euclid P) (π : Euclid P →L[ℝ] Euclid d) (c : Euclid P), IsOpen D → DifferentiableOn ℝ g D → (∀ a ∈ D, π (g a - c) = a) → InjOn g D ∧ ∀ a ∈ D, π ∘L fderiv ℝ g a = ContinuousLinearMap.id ℝ (Euclid d) ∧ Injective (fderiv ℝ g a) := by
  intro P d D g π c hD hg hπ
  -- Steps 2–3: `π ∘ Dg(a) = id` for every `a ∈ D`
  have hid : ∀ a ∈ D, π ∘L fderiv ℝ g a = ContinuousLinearMap.id ℝ (Euclid d) := by
    intro a ha
    -- chain rule: `b ↦ π(g(b) − c)` has derivative `π ∘ Dg(a)` at `a`
    have h₁ : HasFDerivAt (fun b => π (g b - c)) (π ∘L fderiv ℝ g a) a :=
      π.hasFDerivAt.comp a ((hg.hasFDerivAt (hD.mem_nhds ha)).sub_const c)
    -- it equals the identity on the neighbourhood `D` of `a`, so it also has derivative `id`
    have h₂ : HasFDerivAt (fun b => π (g b - c)) (ContinuousLinearMap.id ℝ (Euclid d)) a :=
      (hasFDerivAt_id a).congr_of_eventuallyEq (eventually_of_mem (hD.mem_nhds ha) hπ)
    -- uniqueness of the Fréchet derivative
    exact h₁.unique h₂
  refine ⟨fun a ha b hb hab => ?_, fun a ha => ⟨hid a ha, ?_⟩⟩
  · -- Step 1: `a = π(g(a) − c) = π(g(b) − c) = b`
    rw [← hπ a ha, hab, hπ b hb]
  · -- Step 4: `π(Dg(a) u) = u`, so `π` is a left inverse of `Dg(a)`
    exact LeftInverse.injective fun u => DFunLike.congr_fun (hid a ha) u

/-- **Simon Ch. 2, §4, Remark 4.4** (local graphical representation, using (4.2)): let `ψ` be
`Cʳ` (`r ≥ 1`), 1:1 and proper on the open set `V` with `ψ(V) = W ∩ N`, and let `π` be
continuous linear with `π ∘ Dψ(v₀)` injective.  Then `φ = π(ψ − c)` has `Dφ(v₀) = π ∘ Dψ(v₀)`,
so the inverse function theorem gives a `Cʳ` inverse `χ : D → S` of `φ` with `v₀ ∈ S ⊆ V`, and
`g = ψ ∘ χ` is `Cʳ` on `D` with `π(g(a) − c) = a` and `g(D) = ψ(S)`.  As `ψ` is open onto its
image (4.2), `ψ(S) = O ∩ N` for the open set `O = W ∩ ⋃_{v ∈ S} B_{ρ_v}(ψ(v))`.  The left
inverse `π(· − c)` makes `g` and every `Dg(a)` injective, and for compact `K ⊆ O`,
`D ∩ g⁻¹(K) = π((N ∩ K) − c)`, where `N ∩ K = ψ(V ∩ ψ⁻¹(K))` is compact. -/
theorem Submission.codim1_hcp_sc_graph_reparam : ∀ (P d r : ℕ) (N W : Set (Euclid P)) (V : Set (Euclid d)) (ψ : Euclid d → Euclid P) (π : Euclid P →L[ℝ] Euclid d) (c : Euclid P) (v₀ : Euclid d), 1 ≤ r → IsOpen V → IsOpen W → ContDiffOn ℝ r ψ V → InjOn ψ V → ψ '' V = W ∩ N → (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → v₀ ∈ V → Injective (π ∘L fderiv ℝ ψ v₀) → ∃ (D : Set (Euclid d)) (O : Set (Euclid P)) (g : Euclid d → Euclid P), IsOpen D ∧ IsOpen O ∧ ψ v₀ ∈ O ∧ O ⊆ W ∧ ContDiffOn ℝ r g D ∧ InjOn g D ∧ g '' D = O ∩ N ∧ (∀ K ⊆ O, IsCompact K → IsCompact (D ∩ g ⁻¹' K)) ∧ (∀ a ∈ D, Injective (fderiv ℝ g a)) ∧ ∀ a ∈ D, π (g a - c) = a := by
  intro P d r N W V ψ π c v₀ hr hV hW hψ hinj hψV hprop hv₀ hπψ
  have hψc : ContinuousOn ψ V := hψ.continuousOn
  have hψVWN : ∀ v ∈ V, ψ v ∈ W ∩ N := fun v hv => hψV ▸ mem_image_of_mem ψ hv
  -- Step 1: `φ = π(ψ − c)` is `Cʳ` on `V`, and `Dφ(v₀) = π ∘ Dψ(v₀)` is injective
  have hψ1 : ContDiffOn ℝ 1 ψ V := hψ.of_le (by exact_mod_cast hr)
  have hψv₀ : HasFDerivAt ψ (fderiv ℝ ψ v₀) v₀ :=
    ((hψ1.differentiableOn one_ne_zero).differentiableAt (hV.mem_nhds hv₀)).hasFDerivAt
  have hφ : ContDiffOn ℝ r (fun v => π (ψ v - c)) V :=
    π.contDiff.comp_contDiffOn (hψ.sub contDiffOn_const)
  have hDφ : fderiv ℝ (fun v => π (ψ v - c)) v₀ = π ∘L fderiv ℝ ψ v₀ :=
    (π.hasFDerivAt.comp v₀ (hψv₀.sub_const c)).fderiv
  -- Step 2: a `Cʳ` local inverse `χ : D → S` of `φ` with `v₀ ∈ S ⊆ V`; then `χ(D) = S`
  obtain ⟨S, D, χ, hS, hD, hv₀S, hSV, hχ, hχD, hφχ, hχφ⟩ :=
    Submission.codim1_hcp_sc_local_inverse_cr d r (fun v => π (ψ v - c)) V v₀ hr hV hv₀ hφ
      (hDφ ▸ hπψ)
  have hχS : χ '' D = S :=
    Subset.antisymm hχD.image_subset fun z hz => ⟨_, (hχφ z hz).1, (hχφ z hz).2⟩
  -- Step 3: `g = ψ ∘ χ` is `Cʳ` on `D`, `π(g(a) − c) = a` on `D`, and `g(D) = ψ(S)`
  have hg : ContDiffOn ℝ r (ψ ∘ χ) D := hψ.comp hχ (hχD.mono_right hSV)
  have hgπ : ∀ a ∈ D, π ((ψ ∘ χ) a - c) = a := hφχ
  have hgD : (ψ ∘ χ) '' D = ψ '' S := by rw [image_comp, hχS]
  -- Step 4: `ψ(S) = O ∩ N` for the open set `O = W ∩ ⋃_{v ∈ S} B(ψ(v), ρ_v)` (Simon 4.2)
  choose ρ hρ hρS using fun v (hv : v ∈ S) =>
    Submission.dtc_bc_lr_chart_image_nhds P d N W V S ψ v hW hψc hinj hψV hprop hS hSV hv
  set O : Set (Euclid P) := W ∩ ⋃ (v) (hv : v ∈ S), ball (ψ v) (ρ v hv)
  have hO : IsOpen O := hW.inter (isOpen_iUnion fun v => isOpen_iUnion fun hv => isOpen_ball)
  have hψO : ∀ v (hv : v ∈ S), ψ v ∈ O := fun v hv =>
    ⟨(hψVWN v (hSV hv)).1, mem_iUnion₂.2 ⟨v, hv, mem_ball_self (hρ v hv)⟩⟩
  have hSO : ψ '' S = O ∩ N := by
    refine Subset.antisymm ?_ ?_
    · rintro _ ⟨v, hv, rfl⟩
      exact ⟨hψO v hv, (hψVWN v (hSV hv)).2⟩
    · rintro x ⟨⟨-, hx⟩, hxN⟩
      obtain ⟨v, hv, hxv⟩ := mem_iUnion₂.1 hx
      exact hρS v hv ⟨hxN, hxv⟩
  -- Step 5: `g` and every `Dg(a)` are injective, as `π(· − c)` is a left inverse of `g`
  have hg1 : ContDiffOn ℝ 1 (ψ ∘ χ) D := hg.of_le (by exact_mod_cast hr)
  obtain ⟨hginj, hDg⟩ := Submission.codim1_hcp_sc_left_inverse_immersion P d D (ψ ∘ χ) π c hD
    (hg1.differentiableOn one_ne_zero) hgπ
  refine ⟨D, O, ψ ∘ χ, hD, hO, hψO v₀ hv₀S, inter_subset_left, hg, hginj, hgD.trans hSO,
    fun K hKO hK => ?_, fun a ha => (hDg a ha).2, hgπ⟩
  -- Step 6: `N ∩ K = ψ(V ∩ ψ⁻¹(K))` is compact
  have hKW : K ⊆ W := hKO.trans inter_subset_left
  have hNK : N ∩ K = ψ '' (V ∩ ψ ⁻¹' K) := by
    refine Subset.antisymm ?_ ?_
    · rintro x ⟨hxN, hxK⟩
      obtain ⟨v, hv, rfl⟩ : x ∈ ψ '' V := hψV ▸ ⟨hKW hxK, hxN⟩
      exact ⟨v, ⟨hv, hxK⟩, rfl⟩
    · rintro _ ⟨v, ⟨hv, hvK⟩, rfl⟩
      exact ⟨(hψVWN v hv).2, hvK⟩
  have hNKc : IsCompact (N ∩ K) := by
    rw [hNK]
    exact (hprop K hKW hK).image_of_continuousOn (hψc.mono inter_subset_left)
  -- Step 7: `D ∩ g⁻¹(K) = p(N ∩ K)` with `p(x) = π(x − c)` continuous, so it is compact
  have hDK : D ∩ (ψ ∘ χ) ⁻¹' K = (fun x => π (x - c)) '' (N ∩ K) := by
    refine Subset.antisymm ?_ ?_
    · rintro a ⟨ha, haK⟩
      have haN : (ψ ∘ χ) a ∈ O ∩ N := hgD.trans hSO ▸ mem_image_of_mem (ψ ∘ χ) ha
      exact ⟨(ψ ∘ χ) a, ⟨haN.2, haK⟩, hgπ a ha⟩
    · rintro _ ⟨x, ⟨hxN, hxK⟩, rfl⟩
      obtain ⟨b, hb, rfl⟩ : x ∈ (ψ ∘ χ) '' D := hgD.trans hSO ▸ ⟨hKO hxK, hxN⟩
      show π ((ψ ∘ χ) b - c) ∈ D ∩ (ψ ∘ χ) ⁻¹' K
      rw [hgπ b hb]
      exact ⟨hb, hxK⟩
  rw [hDK]
  exact hNKc.image (π.continuous.comp (continuous_sub_right c))

/-- **Simon Ch. 2, §4, (4.1)–(4.4)**: a `C¹` local representation `G : D → W₀` of an embedded
`Cʳ` submanifold `M` (`r ≥ 1`; 1:1, proper, `G(D) = W₀ ∩ M`, `DG` injective) which is a graph
over the projection `π`, `π(G(a) − c) = a`, is `Cʳ` on `D`.  At `a₀ ∈ D`, `x₀ = G(a₀)`, take a
`Cʳ` chart `ψ'` of `M` with `ψ'(v₀) = x₀`.  By (4.3), `Dψ'(v₀)(ℝᵈ) = T_{x₀}M = DG(a₀)(ℝᵈ)`, and
`π ∘ DG(a₀) = id`, so `π ∘ Dψ'(v₀)` is injective.  Re-parametrizing `ψ'` over `π` gives a `Cʳ`
graph `g` on an open `U` with `g(U) = O ∩ M`, `x₀ ∈ O` and `π(g(a) − c) = a`; then `a₀ ∈ U`,
`g(a₀) = x₀`.  For `a` in the open set `U ∩ g⁻¹(W₀) ∋ a₀`, `g(a) ∈ W₀ ∩ M = G(D)`, and the
projection identity forces `G(a) = g(a)`, so `G` is `Cʳ` at `a₀`. -/
theorem Submission.codim1_hcp_sc_graph_contDiffOn : ∀ (P d r : ℕ) (M W₀ : Set (Euclid P)) (D : Set (Euclid d)) (G : Euclid d → Euclid P) (π : Euclid P →L[ℝ] Euclid d) (c : Euclid P), 1 ≤ r → IsEmbeddedSubmanifold r d M → IsOpen D → IsOpen W₀ → ContDiffOn ℝ 1 G D → InjOn G D → G '' D = W₀ ∩ M → (∀ K ⊆ W₀, IsCompact K → IsCompact (D ∩ G ⁻¹' K)) → (∀ a ∈ D, Injective (fderiv ℝ G a)) → (∀ a ∈ D, π (G a - c) = a) → ContDiffOn ℝ r G D := by
  intro P d r M W₀ D G π c hr hM hD hW₀ hG hGinj hGD hGproper hDG hπG a₀ ha₀
  -- it suffices that `G` is `Cʳ` at `a₀ ∈ D`; `x₀ = G(a₀) ∈ W₀ ∩ M`
  refine ContDiffAt.contDiffWithinAt ?_
  have hx₀ : G a₀ ∈ W₀ ∩ M := hGD ▸ mem_image_of_mem G ha₀
  -- a `Cʳ` chart `ψ'` of `M` at `x₀`, with `ψ'(v₀) = x₀`
  obtain ⟨V', W', ψ', hV', hW', hx₀W', hψ', hψ'inj, hψ'V', hψ'proper, hDψ'⟩ := hM (G a₀) hx₀.2
  obtain ⟨v₀, hv₀, hψv₀⟩ : G a₀ ∈ ψ' '' V' := hψ'V' ▸ ⟨hx₀W', hx₀.2⟩
  -- `Dψ'(v₀)(ℝᵈ) = T_{x₀}M = DG(a₀)(ℝᵈ)`, applying (4.3) to `ψ'` (`Cʳ`) and to `G` (`C¹`)
  have hrange : Set.range (fderiv ℝ ψ' v₀) = Set.range (fderiv ℝ G a₀) := by
    rw [← Submission.chart_tangentSpace_eq_range_fderiv P d r M W' V' ψ' v₀ hr hV' hW' hψ'
        hψ'inj hψ'V' hψ'proper hDψ' hv₀, hψv₀,
      Submission.chart_tangentSpace_eq_range_fderiv P d 1 M W₀ D G a₀ le_rfl hD hW₀
        (by exact_mod_cast hG) hGinj hGD hGproper hDG ha₀]
  -- `π ∘ DG(a₀) = id`
  have hπDG : ∀ w, π (fderiv ℝ G a₀ w) = w := fun w => by
    simpa using DFunLike.congr_fun ((Submission.codim1_hcp_sc_left_inverse_immersion P d D G π c
      hD hG.differentiableOn_one hπG).2 a₀ ha₀).1 w
  -- `π ∘ Dψ'(v₀)` is injective: if `π(Dψ'(v₀)u) = 0`, write `Dψ'(v₀)u = DG(a₀)w`; then
  -- `w = π(DG(a₀)w) = 0`, so `Dψ'(v₀)u = 0` and `u = 0`
  have hπDψ' : Injective (π ∘L fderiv ℝ ψ' v₀) := by
    refine (injective_iff_map_eq_zero _).2 fun u hu => hDψ' v₀ hv₀ ?_
    obtain ⟨w, hw⟩ : fderiv ℝ ψ' v₀ u ∈ Set.range (fderiv ℝ G a₀) :=
      hrange ▸ Set.mem_range_self u
    have hw0 : w = 0 := by
      rw [← hπDG w, hw]
      simpa using hu
    rw [map_zero, ← hw, hw0, map_zero]
  -- re-parametrize `ψ'` as a `Cʳ` graph `g` over `π` on `U`, with `g(U) = O ∩ M` and `x₀ ∈ O`
  obtain ⟨U, O, g, hU, -, hx₀O, -, hg, -, hgU, -, -, hπg⟩ :=
    Submission.codim1_hcp_sc_graph_reparam P d r M W' V' ψ' π c v₀ hr hV' hW' hψ' hψ'inj hψ'V'
      hψ'proper hv₀ hπDψ'
  -- `x₀ = g(a₁)` with `a₁ ∈ U`, and `a₁ = π(g(a₁) − c) = π(G(a₀) − c) = a₀`
  rw [hψv₀] at hx₀O
  obtain ⟨a₁, ha₁, hga₁⟩ : G a₀ ∈ g '' U := hgU ▸ ⟨hx₀O, hx₀.2⟩
  have ha₁₀ : a₁ = a₀ := by rw [← hπg a₁ ha₁, hga₁, hπG a₀ ha₀]
  rw [ha₁₀] at ha₁ hga₁
  -- `G = g` on the open set `U ∩ g⁻¹(W₀) ∋ a₀`: there `g(a) ∈ W₀ ∩ M = G(D)`, say `g(a) = G(a')`,
  -- and `a' = π(G(a') − c) = π(g(a) − c) = a`
  have hGg : G =ᶠ[𝓝 a₀] g := by
    have hUg : IsOpen (U ∩ g ⁻¹' W₀) := hg.continuousOn.isOpen_inter_preimage hU hW₀
    have ha₀Ug : a₀ ∈ U ∩ g ⁻¹' W₀ := ⟨ha₁, show g a₀ ∈ W₀ from hga₁ ▸ hx₀.1⟩
    filter_upwards [hUg.mem_nhds ha₀Ug] with a ha
    obtain ⟨haU, haW₀⟩ := ha
    have hgaM : g a ∈ O ∩ M := hgU ▸ mem_image_of_mem g haU
    obtain ⟨a', ha', hGa'⟩ : g a ∈ G '' D := hGD ▸ ⟨haW₀, hgaM.2⟩
    have ha'a : a' = a := by rw [← hπG a' ha', hGa', hπg a haU]
    rw [← hGa', ha'a]
  -- `g` is `Cʳ` at `a₀` (`U` is open), and `G = g` near `a₀`
  exact (hg.contDiffAt (hU.mem_nhds ha₁)).congr_of_eventuallyEq hGg

/-- **`C^∞` charts** (Simon Ch. 2, §4, 4.1–4.4): if `M ⊆ ℝᴾ` is an embedded `Cʳ` `m`-dimensional
submanifold for every `r` (the charts may depend on `r`), then every `y ∈ M` has a `C^∞` local
representation.  Take a `C¹` chart `ψ₁` with `ψ₁(v_y) = y` and a continuous linear left inverse
`π` of the injective `Dψ₁(v_y)`.  Re-parametrizing `ψ₁` over `π` gives a `C¹` chart
`G : D → W₀ ∩ M` with `π(G(a) − y) = a`, and such a graph chart of the `C^{n+1}` submanifold `M`
is `C^{n+1}` on `D`.  So `G` is `Cⁿ` on `D` for every `n`, i.e. `C^∞`. -/
theorem Submission.codim1_hcp_smooth_charts : ∀ (P m : ℕ) (M : Set (Euclid P)), (∀ r : ℕ, IsEmbeddedSubmanifold r m M) → ∀ y ∈ M, ∃ (V : Set (Euclid m)) (W : Set (Euclid P)) (ψ : Euclid m → Euclid P), IsOpen V ∧ IsOpen W ∧ y ∈ W ∧ ContDiffOn ℝ (⊤ : ℕ∞) ψ V ∧ InjOn ψ V ∧ ψ '' V = W ∩ M ∧ (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) ∧ ∀ z ∈ V, Injective (fderiv ℝ ψ z) := by
  intro P m M hM y hy
  -- Step 1: a `C¹` chart `(V₁, W₁, ψ₁)` at `y`, and `v_y ∈ V₁` with `ψ₁(v_y) = y`
  obtain ⟨V₁, W₁, ψ₁, hV₁, hW₁, hyW₁, hψ₁, hinj₁, hψ₁V, hprop₁, hD₁⟩ := hM 1 y hy
  obtain ⟨vy, hvy, hψvy⟩ : y ∈ ψ₁ '' V₁ := hψ₁V ▸ ⟨hyW₁, hy⟩
  -- Step 2: a continuous linear left inverse `π` of the injective `Dψ₁(v_y)`
  obtain ⟨π₀, hπ₀⟩ := (fderiv ℝ ψ₁ vy : Euclid m →ₗ[ℝ] Euclid P).exists_leftInverse_of_injective
    (LinearMap.ker_eq_bot.2 (hD₁ vy hvy))
  set π : Euclid P →L[ℝ] Euclid m := LinearMap.toContinuousLinearMap π₀
  have hπA : π ∘L fderiv ℝ ψ₁ vy = ContinuousLinearMap.id ℝ (Euclid m) :=
    ContinuousLinearMap.ext fun v => LinearMap.congr_fun hπ₀ v
  have hπ : Injective (π ∘L fderiv ℝ ψ₁ vy) := by
    rw [hπA]
    exact fun a b hab => hab
  -- Step 3: the `C¹` graph chart `G : D → W₀ ∩ M` over `π`, with `π(G(a) − y) = a`
  obtain ⟨D, W₀, G, hD, hW₀, hyW₀, -, hG, hGinj, hGD, hGprop, hDG, hπG⟩ :=
    Submission.codim1_hcp_sc_graph_reparam P m 1 M W₁ V₁ ψ₁ π y vy le_rfl hV₁ hW₁ hψ₁ hinj₁ hψ₁V
      hprop₁ hvy hπ
  -- Step 4: `G` is `C^{n+1}` on `D` for every `n` (`M` is `C^{n+1}`), hence `C^∞`
  have hG1 : ContDiffOn ℝ 1 G D := by exact_mod_cast hG
  have hGsmooth : ContDiffOn ℝ (⊤ : ℕ∞) G D := contDiffOn_infty.2 fun n =>
    (Submission.codim1_hcp_sc_graph_contDiffOn P m (n + 1) M W₀ D G π y (Nat.le_add_left 1 n)
      (hM (n + 1)) hD hW₀ hG1 hGinj hGD hGprop hDG hπG).of_le (by exact_mod_cast Nat.le_succ n)
  exact ⟨D, W₀, G, hD, hW₀, hψvy ▸ hyW₀, hGsmooth, hGinj, hGD, hGprop, hDG⟩
/-- **Simon Ch. 2, 5.1–5.2**: the deformations `Φ(x) = x + tZ(x)` by a `C¹` vector field `Z` with
compact support are bi-Lipschitz bijections with injective derivative for small `|t|`.  `DZ` is
continuous and vanishes off the compact set `tsupport Z`, so `|DZ| ≤ L` and `Z` is `L`-Lipschitz.
For `|t| < t₀ = 1/(1 + L)`, `κ = |t|L < 1` and `(1 − κ)|a − b| ≤ |Φ(a) − Φ(b)| ≤ (1 + κ)|a − b|`;
thus `Φ` is `Λ`-Lipschitz and `Λ`-antilipschitz with `Λ = max(1 + κ, (1 − κ)⁻¹)`, hence
injective.  Given `y`, the Picard iterates of the contraction `x ↦ y − tZ(x)` converge to a
solution of `Φ(x) = y`.  Finally `DΦ(x) = I + tDZ(x)` with `|tDZ(x)| ≤ κ < 1` is injective. -/
theorem Submission.codim1_ac_perturbation_diffeo : ∀ (P : ℕ) (Z : Euclid P → Euclid P), ContDiff ℝ 1 Z → HasCompactSupport Z → ∃ t₀ : ℝ, 0 < t₀ ∧ ∀ t : ℝ, |t| < t₀ → Bijective (fun x => x + t • Z x) ∧ (∀ x, Injective (fderiv ℝ (fun x => x + t • Z x) x)) ∧ ∃ Λ : NNReal, LipschitzWith Λ (fun x => x + t • Z x) ∧ AntilipschitzWith Λ (fun x => x + t • Z x) := by
  intro P Z hZ hZc
  -- Step 1: `DZ` is continuous and vanishes off the compact set `tsupport Z`, so `‖DZ‖ ≤ L`
  obtain ⟨C, hC⟩ := (hZ.continuous_fderiv one_ne_zero).bounded_above_of_compact_support
    (hZc.fderiv ℝ)
  set L : NNReal := C.toNNReal with hL_def
  have hDZ : ∀ x, ‖fderiv ℝ Z x‖ ≤ L := fun x =>
    (hC x).trans (by rw [hL_def, Real.coe_toNNReal']; exact le_max_left _ _)
  -- Step 2: `Z` is `L`-Lipschitz (mean value inequality)
  have hZd : Differentiable ℝ Z := hZ.differentiable one_ne_zero
  have hZL : LipschitzWith L Z := lipschitzWith_of_nnnorm_fderiv_le hZd fun x => by
    rw [← NNReal.coe_le_coe, coe_nnnorm]
    exact hDZ x
  -- Step 3: `t₀ = 1/(1 + L)`; for `|t| < t₀`, `κ = |t| L < 1`
  refine ⟨1 / (1 + L), by positivity, fun t ht => ?_⟩
  set κ : NNReal := ‖t‖₊ * L with hκ_def
  have hκ : (κ : ℝ) = |t| * L := by
    rw [hκ_def, NNReal.coe_mul, coe_nnnorm, Real.norm_eq_abs]
  have hκ1 : (κ : ℝ) < 1 := by
    have h1 : |t| * (1 + L) < 1 := (lt_div_iff₀ (by positivity)).mp ht
    rw [hκ]
    nlinarith [abs_nonneg t]
  have hZt : ∀ a b, ‖t • (Z a - Z b)‖ ≤ κ * ‖a - b‖ := fun a b => by
    rw [norm_smul, Real.norm_eq_abs, hκ, mul_assoc, ← dist_eq_norm, ← dist_eq_norm]
    exact mul_le_mul_of_nonneg_left (hZL.dist_le_mul a b) (abs_nonneg t)
  -- Step 4: `(1 − κ)|a − b| ≤ |Φ(a) − Φ(b)| ≤ (1 + κ)|a − b|`
  have hΦ : ∀ a b, (a + t • Z a) - (b + t • Z b) = (a - b) + t • (Z a - Z b) := fun a b => by
    rw [smul_sub]
    abel
  have hup : ∀ a b, ‖(a + t • Z a) - (b + t • Z b)‖ ≤ (1 + κ) * ‖a - b‖ := fun a b => by
    rw [hΦ]
    linarith [norm_add_le (a - b) (t • (Z a - Z b)), hZt a b]
  have hlow : ∀ a b, (1 - κ) * ‖a - b‖ ≤ ‖(a + t • Z a) - (b + t • Z b)‖ := fun a b => by
    have h := norm_sub_le ((a - b) + t • (Z a - Z b)) (t • (Z a - Z b))
    rw [add_sub_cancel_right] at h
    rw [hΦ]
    linarith [hZt a b]
  -- Step 5: `Λ = max(1 + κ, (1 − κ)⁻¹)`; `Φ` is `Λ`-Lipschitz and `Λ`-antilipschitz
  have h1κ : (0 : ℝ) < 1 - κ := sub_pos.mpr hκ1
  set Λ : NNReal := (max (1 + (κ : ℝ)) (1 - (κ : ℝ))⁻¹).toNNReal with hΛ_def
  have hΛ : (Λ : ℝ) = max (1 + (κ : ℝ)) (1 - (κ : ℝ))⁻¹ :=
    Real.coe_toNNReal _ ((by positivity : (0 : ℝ) ≤ 1 + κ).trans (le_max_left _ _))
  have hlip : LipschitzWith Λ (fun x => x + t • Z x) :=
    LipschitzWith.of_dist_le_mul fun a b => by
      rw [dist_eq_norm, dist_eq_norm, hΛ]
      exact (hup a b).trans (mul_le_mul_of_nonneg_right (le_max_left _ _) (norm_nonneg _))
  have hanti : AntilipschitzWith Λ (fun x => x + t • Z x) :=
    AntilipschitzWith.of_le_mul_dist fun a b => by
      rw [dist_eq_norm, dist_eq_norm, hΛ]
      calc ‖a - b‖ ≤ (1 - (κ : ℝ))⁻¹ * ‖(a + t • Z a) - (b + t • Z b)‖ :=
            (le_inv_mul_iff₀ h1κ).mpr (hlow a b)
        _ ≤ _ := mul_le_mul_of_nonneg_right (le_max_right _ _) (norm_nonneg _)
  -- Step 6: injectivity, from the antilipschitz bound
  refine ⟨⟨hanti.injective, fun y => ?_⟩, fun x => ?_, Λ, hlip, hanti⟩
  · -- Step 7: surjectivity, via the Banach fixed point of the contraction `T(x) = y − tZ(x)`
    set T : Euclid P → Euclid P := fun x => y - t • Z x with hT_def
    have hT : LipschitzWith κ T := LipschitzWith.of_dist_le_mul fun a b => by
      rw [dist_eq_norm, dist_eq_norm, hT_def, sub_sub_sub_cancel_left, ← smul_sub,
        norm_sub_rev a b]
      exact hZt b a
    -- the Picard iterates `Tⁿ(0)`, with `|Tⁿ(0) − Tⁿ⁺¹(0)| ≤ κⁿ|0 − T(0)|`, are Cauchy
    have hu : ∀ n : ℕ, dist (T^[n] 0) (T^[n + 1] 0) ≤ dist (0 : Euclid P) (T 0) * κ ^ n := by
      intro n
      rw [Function.iterate_succ_apply, mul_comm, ← NNReal.coe_pow]
      exact (hT.iterate n).dist_le_mul 0 (T 0)
    obtain ⟨x, hx⟩ := cauchySeq_tendsto_of_complete
      (cauchySeq_of_le_geometric (f := fun n => T^[n] 0) _ _ hκ1 hu)
    -- the limit `x` is a fixed point: `T(Tⁿ(0)) = Tⁿ⁺¹(0)` tends to both `T(x)` and `x`
    have hTx : T x = x := tendsto_nhds_unique ((hT.continuous.tendsto x).comp hx)
      ((hx.comp (tendsto_add_atTop_nat 1)).congr fun n => Function.iterate_succ_apply' T n 0)
    exact ⟨x, eq_sub_iff_add_eq.mp hTx.symm⟩
  · -- Step 8: `DΦ(x) = I + tDZ(x)` is injective, since `‖tDZ(x)‖ ≤ κ < 1`
    have hDΦ : HasFDerivAt (fun x => x + t • Z x)
        (ContinuousLinearMap.id ℝ (Euclid P) + t • fderiv ℝ Z x) x :=
      (hasFDerivAt_id x).add ((hZd x).hasFDerivAt.const_smul t)
    rw [hDΦ.fderiv]
    refine (injective_iff_map_eq_zero _).2 fun v hv => ?_
    rw [add_apply, ContinuousLinearMap.id_apply, smul_apply] at hv
    have h1 : ‖v‖ ≤ κ * ‖v‖ :=
      calc ‖v‖ = ‖t • fderiv ℝ Z x v‖ :=
            (congrArg norm (eq_neg_of_add_eq_zero_left hv)).trans (norm_neg _)
        _ = |t| * ‖fderiv ℝ Z x v‖ := by rw [norm_smul, Real.norm_eq_abs]
        _ ≤ |t| * (L * ‖v‖) := mul_le_mul_of_nonneg_left
            (((fderiv ℝ Z x).le_opNorm v).trans
              (mul_le_mul_of_nonneg_right (hDZ x) (norm_nonneg v))) (abs_nonneg t)
        _ = κ * ‖v‖ := by rw [hκ, mul_assoc]
    have h2 : ‖v‖ ≤ 0 := by nlinarith [norm_nonneg v]
    exact norm_le_zero_iff.mp h2
/-- **Simon Ch. 2, §4, (4.1)–(4.3)**: if `N` is an embedded `d`-dimensional `C¹` submanifold and
`Φ : ℝᴾ → ℝᴾ` is an anti-Lipschitz `C¹` bijection with `DΦ(x)` injective, then `Φ(N)` is an
embedded `d`-dimensional `C¹` submanifold and `T_{Φ(x)}Φ(N) = DΦ(x)(TₓN)` for `x ∈ N`.  `Φ⁻¹` is
Lipschitz, so `Φ` is a homeomorphism, and a chart `(V, W, ψ)` of `N` gives the chart
`(V, Φ(W), Φ ∘ ψ)` of `Φ(N)`: `Φ(W)` is open, `Φ(ψ(V)) = Φ(W) ∩ Φ(N)`, `V ∩ (Φ ∘ ψ)⁻¹(K)` is
compact because `Φ⁻¹(K) ⊆ W` is, and `D(Φ ∘ ψ) = DΦ ∘ Dψ` is injective.  The tangent spaces then
follow from `chart_tangentSpace_eq_range_fderiv` for both charts. -/
theorem Submission.codim1_ac_diffeo_image_submanifold : ∀ (P d : ℕ) (N : Set (Euclid P)) (Φ : Euclid P → Euclid P) (Λ : NNReal), IsEmbeddedSubmanifold 1 d N → ContDiff ℝ 1 Φ → Bijective Φ → (∀ x, Injective (fderiv ℝ Φ x)) → AntilipschitzWith Λ Φ → IsEmbeddedSubmanifold 1 d (Φ '' N) ∧ ∀ x ∈ N, tangentSpace (Φ '' N) (Φ x) = (fderiv ℝ Φ x) '' tangentSpace N x := by
  intro P d N Φ Λ hN hΦ hbij hDΦ hanti
  -- Step 1: `Φ` is a homeomorphism, its inverse being `Λ`-Lipschitz
  obtain ⟨H, hH⟩ : ∃ H : Euclid P ≃ₜ Euclid P, ⇑H = Φ :=
    ⟨{ toEquiv := Equiv.ofBijective Φ hbij
       continuous_toFun := hΦ.continuous
       continuous_invFun :=
        (hanti.to_rightInverse (Equiv.ofBijective Φ hbij).rightInverse_symm).continuous }, rfl⟩
  have hopen : ∀ O : Set (Euclid P), IsOpen O → IsOpen (Φ '' O) := by
    intro O hO
    rw [← hH]
    exact H.isOpenMap O hO
  have hcpt : ∀ K : Set (Euclid P), IsCompact K → IsCompact (Φ ⁻¹' K) := by
    intro K hK
    rw [← hH]
    exact H.isCompact_preimage.2 hK
  have hΦ1 : ContDiff ℝ (1 : ℕ) Φ := by exact_mod_cast hΦ
  -- Step 2: a chart `(V, W, ψ)` of `N` gives the chart `(V, Φ(W), Φ ∘ ψ)` of `Φ(N)`
  have hchart : ∀ (V : Set (Euclid d)) (W : Set (Euclid P)) (ψ : Euclid d → Euclid P),
      IsOpen V → IsOpen W → ContDiffOn ℝ (1 : ℕ) ψ V → InjOn ψ V → ψ '' V = W ∩ N →
      (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → (∀ z ∈ V, Injective (fderiv ℝ ψ z)) →
      IsOpen (Φ '' W) ∧ ContDiffOn ℝ (1 : ℕ) (Φ ∘ ψ) V ∧ InjOn (Φ ∘ ψ) V ∧
        (Φ ∘ ψ) '' V = Φ '' W ∩ Φ '' N ∧
        (∀ K ⊆ Φ '' W, IsCompact K → IsCompact (V ∩ (Φ ∘ ψ) ⁻¹' K)) ∧
        ∀ z ∈ V, Injective (fderiv ℝ (Φ ∘ ψ) z) := by
    intro V W ψ hV hW hψ hinj hψV hproper hDψ
    refine ⟨hopen W hW, hΦ1.comp_contDiffOn hψ, hbij.injective.comp_injOn hinj, ?_, ?_, ?_⟩
    · -- `Φ(ψ(V)) = Φ(W ∩ N) = Φ(W) ∩ Φ(N)`, `Φ` being injective
      rw [image_comp, hψV, image_inter hbij.injective]
    · -- `Φ⁻¹(K)` is a compact subset of `W`
      intro K hKW hK
      have hK' : Φ ⁻¹' K ⊆ W := by
        intro z hz
        obtain ⟨w, hw, hwz⟩ := hKW hz
        rwa [← hbij.injective hwz]
      exact hproper _ hK' (hcpt K hK)
    · -- chain rule: `D(Φ ∘ ψ)(z) = DΦ(ψ(z)) ∘ Dψ(z)`, a composition of injective maps
      intro z hz
      have hψ1 : ContDiffOn ℝ 1 ψ V := by exact_mod_cast hψ
      have hψz : HasFDerivAt ψ (fderiv ℝ ψ z) z :=
        ((hψ1.differentiableOn one_ne_zero).differentiableAt (hV.mem_nhds hz)).hasFDerivAt
      have hΦz : HasFDerivAt Φ (fderiv ℝ Φ (ψ z)) (ψ z) :=
        (hΦ.differentiable one_ne_zero (ψ z)).hasFDerivAt
      rw [(hΦz.comp z hψz).fderiv, ContinuousLinearMap.coe_comp]
      exact (hDΦ (ψ z)).comp (hDψ z hz)
  refine ⟨?_, ?_⟩
  · -- `Φ(N)` is an embedded `d`-dimensional `C¹` submanifold
    rintro _ ⟨y, hy, rfl⟩
    obtain ⟨V, W, ψ, hV, hW, hyW, hψ, hinj, hψV, hproper, hDψ⟩ := hN y hy
    obtain ⟨hW', hψ', hinj', hψV', hproper', hDψ'⟩ :=
      hchart V W ψ hV hW hψ hinj hψV hproper hDψ
    exact ⟨V, Φ '' W, Φ ∘ ψ, hV, hW', mem_image_of_mem Φ hyW, hψ', hinj', hψV', hproper', hDψ'⟩
  · -- Step 3: the tangent spaces, by `chart_tangentSpace_eq_range_fderiv` for both charts
    intro x hx
    obtain ⟨V, W, ψ, hV, hW, hxW, hψ, hinj, hψV, hproper, hDψ⟩ := hN x hx
    obtain ⟨hW', hψ', hinj', hψV', hproper', hDψ'⟩ :=
      hchart V W ψ hV hW hψ hinj hψV hproper hDψ
    obtain ⟨v, hv, rfl⟩ : x ∈ ψ '' V := hψV ▸ ⟨hxW, hx⟩
    have hTN := Submission.chart_tangentSpace_eq_range_fderiv P d 1 N W V ψ v le_rfl hV hW hψ
      hinj hψV hproper hDψ hv
    have hTΦN := Submission.chart_tangentSpace_eq_range_fderiv P d 1 (Φ '' N) (Φ '' W) V
      (Φ ∘ ψ) v le_rfl hV hW' hψ' hinj' hψV' hproper' hDψ' hv
    have hψ1 : ContDiffOn ℝ 1 ψ V := by exact_mod_cast hψ
    have hψv : HasFDerivAt ψ (fderiv ℝ ψ v) v :=
      ((hψ1.differentiableOn one_ne_zero).differentiableAt (hV.mem_nhds hv)).hasFDerivAt
    have hΦv : HasFDerivAt Φ (fderiv ℝ Φ (ψ v)) (ψ v) :=
      (hΦ.differentiable one_ne_zero (ψ v)).hasFDerivAt
    calc tangentSpace (Φ '' N) (Φ (ψ v)) = range (fderiv ℝ (Φ ∘ ψ) v) := hTΦN
      _ = range (fderiv ℝ Φ (ψ v) ∘ fderiv ℝ ψ v) := by
        rw [(hΦv.comp v hψv).fderiv, ContinuousLinearMap.coe_comp]
      _ = fderiv ℝ Φ (ψ v) '' tangentSpace N (ψ v) := by rw [range_comp, hTN]
/-- **`C¹` cut-off of a chart**: if `ψ` is `C¹` on an open `V ⊆ ℝᵐ` and `v₀ ∈ V`, then `ψ`
agrees on some ball `B_ρ(v₀) ⊆ V` with a map `g` that is `C¹` on all of `ℝᵐ`.  Take
`B_ε(v₀) ⊆ V`, a smooth bump `φ` with `φ = 1` on `B̄_{ε/4}(v₀)` and `φ = 0` off `B_{ε/2}(v₀)`,
`g = φ ψ` and `ρ = ε/4`.  At points of `B_ε(v₀) ⊆ V`, `g` is a product of `C¹` maps; at points
with `|v − v₀| ≥ ε`, `g` vanishes on the neighbourhood `{w : |w − v₀| > ε/2}`. -/
theorem Submission.codim1_ac_sat_c1_local_extension : ∀ (P m : ℕ) (V : Set (Euclid m)) (ψ : Euclid m → Euclid P) (v₀ : Euclid m), IsOpen V → ContDiffOn ℝ 1 ψ V → v₀ ∈ V → ∃ (g : Euclid m → Euclid P) (ρ : ℝ), 0 < ρ ∧ ball v₀ ρ ⊆ V ∧ ContDiff ℝ 1 g ∧ EqOn g ψ (ball v₀ ρ) := by
  intro P m V ψ v₀ hV hψ hv₀
  -- Step 1: `B_ε(v₀) ⊆ V`
  obtain ⟨ε, hε, hεV⟩ := Metric.isOpen_iff.mp hV v₀ hv₀
  -- Step 2: a smooth bump `φ` with `φ = 1` on `B̄_{ε/4}(v₀)` and `φ = 0` off `B_{ε/2}(v₀)`
  let φ : ContDiffBump v₀ := ⟨ε / 4, ε / 2, by positivity, by linarith⟩
  -- Step 3: `g = φ ψ` and `ρ = ε / 4`, so `B_ρ(v₀) ⊆ B_ε(v₀) ⊆ V`
  refine ⟨fun v => φ v • ψ v, ε / 4, by positivity,
    (ball_subset_ball (by linarith)).trans hεV, ?_, fun v hv => ?_⟩
  · -- Step 5: `g` is `C¹` at every point `v`
    refine contDiff_iff_contDiffAt.mpr fun v => ?_
    by_cases hv : dist v v₀ < ε
    · -- (a) `v ∈ B_ε(v₀) ⊆ V`: `φ` and `ψ` are `C¹` at `v`
      exact (φ.contDiffAt (n := 1)).smul (hψ.contDiffAt (hV.mem_nhds (hεV (mem_ball.mpr hv))))
    · -- (b) `|v − v₀| ≥ ε`: `g = 0` on the neighbourhood `{w : |w − v₀| > ε/2}` of `v`
      have hO : ∀ᶠ w in 𝓝 v, ε / 2 < dist w v₀ :=
        continuousAt_const.eventually_lt (continuous_id.dist continuous_const).continuousAt
          (by linarith [not_lt.mp hv])
      refine (contDiffAt_const (c := (0 : Euclid P))).congr_of_eventuallyEq ?_
      filter_upwards [hO] with w hw
      rw [φ.zero_of_le_dist hw.le, zero_smul]
  · -- Step 4: `φ = 1` on `B̄_{ε/4}(v₀)`, so `g = ψ` on `B_ρ(v₀)`
    simp only [φ.one_of_mem_closedBall (ball_subset_closedBall hv), one_smul]
/-- **Simon Ch. 3, Lemma 1.2** (the inverse-function step of the "only if" part): if `G` is `C¹`
and `DG(x)` is injective, then `μ |a − b| ≤ |G(a) − G(b)|` on some ball `B_δ(x)`.  With
`|v| ≤ K |DG(x) v|` and `μ = 1/(2K)`, strict differentiability gives
`|G(a) − G(b) − DG(x)(a − b)| ≤ μ |a − b|` near `x`, so `|G(a) − G(b)| ≥ 2μ|a − b| − μ|a − b|`. -/
theorem Submission.codim1_rdo_c1cov_local_lower_lipschitz : ∀ (P n : ℕ) (G : Euclid n → Euclid P) (x : Euclid n), ContDiff ℝ 1 G → Injective (fderiv ℝ G x) → ∃ δ μ : ℝ, 0 < δ ∧ 0 < μ ∧ ∀ a ∈ ball x δ, ∀ b ∈ ball x δ, μ * ‖a - b‖ ≤ ‖G a - G b‖ := by
  intro P n G x hG hinj
  -- `L = DG(x)` is injective on the finite-dimensional `ℝⁿ`: `‖v‖ ≤ K ‖L v‖`
  obtain ⟨K, hK, hKL⟩ := (fderiv ℝ G x).injective_iff_antilipschitz.mp hinj
  have hbound : ∀ v, ‖v‖ ≤ K * ‖fderiv ℝ G x v‖ :=
    (fderiv ℝ G x).bound_of_antilipschitz hKL
  -- `μ = 1/(2K)`, so `‖L v‖ ≥ 2μ ‖v‖`
  set μ : ℝ := (2 * K)⁻¹ with hμ
  have hK' : (0 : ℝ) < K := hK
  have hμ0 : 0 < μ := by positivity
  -- `G` is `C¹`, so `L` is a strict derivative: `G` approximates `L` with constant `μ` near `x`
  obtain ⟨s, hs, hGs⟩ := (hG.contDiffAt.hasStrictFDerivAt one_ne_zero).approximates_deriv_on_nhds
    (c := ⟨μ, hμ0.le⟩) (Or.inr hμ0)
  obtain ⟨δ, hδ, hδs⟩ := Metric.mem_nhds_iff.mp hs
  refine ⟨δ, μ, hδ, hμ0, fun a ha b hb => ?_⟩
  have h1 : ‖G a - G b - fderiv ℝ G x (a - b)‖ ≤ μ * ‖a - b‖ := hGs a (hδs ha) b (hδs hb)
  have h2 : 2 * μ * ‖a - b‖ ≤ ‖fderiv ℝ G x (a - b)‖ := by
    calc 2 * μ * ‖a - b‖ ≤ 2 * μ * (K * ‖fderiv ℝ G x (a - b)‖) := by
          gcongr
          exact hbound (a - b)
      _ = ‖fderiv ℝ G x (a - b)‖ := by
          rw [hμ]
          field_simp
  -- triangle inequality: `‖L (a - b)‖ ≤ ‖G a - G b‖ + ‖G a - G b - L (a - b)‖`
  have h3 : ‖fderiv ℝ G x (a - b)‖ ≤ ‖G a - G b‖ + ‖G a - G b - fderiv ℝ G x (a - b)‖ := by
    simpa using norm_sub_le (G a - G b) (G a - G b - fderiv ℝ G x (a - b))
  linarith

/-- **Simon Ch. 3, Lemma 1.2, "only if" part, final paragraph** (chapter-03.txt lines 61–65),
for one `C¹` map `G : ℝⁿ → ℝᴾ`: up to an `Hⁿ`-null set, `G(ℝⁿ)` is covered by the images
`G(B_{r_k}(c_k))` of countably many open balls (empty when `r_k ≤ 0`) carrying lower Lipschitz
bounds `m_k|a − b| ≤ |G a − G b|`, `m_k > 0`.
The critical image `G(C)`, `C = {x : DG(x) not injective}`, is `Hⁿ`-null.  Mathlib's partition
of `C ∩ B̄_R(0)` into pieces `T` on which `G` is `η`-close to some non-injective `A = DG(y)`
reduces this to `Hⁿ(G(T)) ≤ (‖A‖ + 1)ⁿ η Lⁿ(T)`: for a unit `u ∈ ker A`, the compression
`D w = w + (η − 1)⟨u, w⟩u` has `det D = η`, and `|G a − G b| ≤ (‖A‖ + 1)|D a − D b|` on `T`.
For a dense sequence `e` and `(q, p) = Nat.unpair k`, the candidate ball `B_{1/(p+1)}(e_q)` is
kept, with a witness `m_k`, when it carries a lower Lipschitz bound, and replaced by `B_0 = ∅`
otherwise.  At a regular point `x`, `codim1_rdo_c1cov_local_lower_lipschitz` gives a bound on
some `B_δ(x)`; a candidate ball with `2/(p+1) < δ` and `|x − e_q| < 1/(p+1)` contains `x`, lies
in `B_δ(x)` and is kept. -/
theorem Submission.codim1_rdo_c1cov_regular_ball_cover : ∀ (P n : ℕ) (G : Euclid n → Euclid P), ContDiff ℝ 1 G → ∃ (c : ℕ → Euclid n) (r m : ℕ → ℝ), (∀ k, 0 < m k) ∧ (∀ k, ∀ a ∈ ball (c k) (r k), ∀ b ∈ ball (c k) (r k), m k * ‖a - b‖ ≤ ‖G a - G b‖) ∧ μHE[n] (range G \ ⋃ k, G '' ball (c k) (r k)) = 0 := by
  intro P n G hG
  -- the critical image `G({x : DG(x) not injective})` is `Hⁿ`-null
  have hcrit : μHE[n] (G '' {x | ¬ Injective (fderiv ℝ G x)}) = 0 := by
    -- near a non-injective `A`, `G` shrinks `Hⁿ` by the factor `ε`
    have hloc : ∀ ε : NNReal, 0 < ε → ε ≤ 1 → ∀ A : Euclid n →L[ℝ] Euclid P, ∃ δ : NNReal,
        0 < δ ∧ (¬ Injective A → ∀ T : Set (Euclid n), ApproximatesLinearOn G A T δ →
          μHE[n] (G '' T) ≤ ε * volume T) := by
      intro ε hε hε1 A
      by_cases hA : Injective A
      · exact ⟨1, one_pos, fun h => absurd hA h⟩
      -- a unit vector `u` in the kernel of `A`
      obtain ⟨u, hu1, hAu⟩ : ∃ u : Euclid n, ‖u‖ = 1 ∧ A u = 0 := by
        rw [injective_iff_map_eq_zero] at hA
        push Not at hA
        obtain ⟨w, hw, hw0⟩ := hA
        refine ⟨‖w‖⁻¹ • w, ?_, ?_⟩
        · rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ (norm_ne_zero_iff.2 hw0)]
        · rw [map_smul, hw, smul_zero]
      set K : NNReal := ‖A‖₊ + 1 with hK
      have hK1 : 1 ≤ K := le_add_self
      have hKn : (0 : NNReal) < K ^ n := pow_pos (zero_lt_one.trans_le hK1) n
      set η : NNReal := ε / K ^ n with hη
      have hη0 : 0 < η := div_pos hε hKn
      have hη1 : (η : ℝ) ≤ 1 := by
        have : η ≤ ε := div_le_self (by positivity) (one_le_pow₀ hK1)
        exact_mod_cast this.trans hε1
      refine ⟨η, hη0, fun _ T hT => ?_⟩
      -- the compression `D w = w + (η - 1) ⟪u, w⟫ u` along `u`
      let D : Euclid n →ₗ[ℝ] Euclid n := LinearMap.id + ((η : ℝ) - 1) • (innerₛₗ ℝ u).smulRight u
      have hD : ∀ w, D w = w + (((η : ℝ) - 1) * inner ℝ u w) • u := by
        intro w
        simp [D, mul_smul]
      -- `det D = 1 + (η - 1) ‖u‖² = η` (matrix determinant lemma in the standard basis)
      have hdet : LinearMap.det D = η := by
        set b := (EuclideanSpace.basisFun (Fin n) ℝ).toBasis with hb
        have hM : LinearMap.toMatrix b b D =
            1 + Matrix.vecMulVec (fun i => u i) (fun j => ((η : ℝ) - 1) * u j) := by
          ext i j
          rw [LinearMap.toMatrix_apply, hD]
          simp [hb, Matrix.one_apply, Matrix.vecMulVec_apply, EuclideanSpace.inner_single_right]
          ring
        have hsum : ∑ j, u j * u j = 1 := by
          have h := real_inner_self_eq_norm_sq u
          rw [hu1, PiLp.inner_apply] at h
          simpa [sq] using h
        rw [← LinearMap.det_toMatrix b, hM, Matrix.vecMulVec_eq Unit,
          Matrix.det_one_add_replicateCol_mul_replicateRow]
        simp only [dotProduct, mul_assoc]
        rw [← Finset.mul_sum, hsum]
        ring
      -- `‖G y₁ - G y₂‖ ≤ ‖A (y₁ - y₂)‖ + η ‖y₁ - y₂‖ ≤ K ‖D (y₁ - y₂)‖` on `T`
      have hkey : ∀ y₁ ∈ T, ∀ y₂ ∈ T, ‖G y₁ - G y₂‖ ≤ K * ‖D y₁ - D y₂‖ := by
        intro y₁ h₁ y₂ h₂
        have happ : ‖G y₁ - G y₂ - A (y₁ - y₂)‖ ≤ η * ‖y₁ - y₂‖ := hT y₁ h₁ y₂ h₂
        rw [← map_sub]
        set w := y₁ - y₂
        have hAw : A w = A (D w) := by rw [hD, map_add, map_smul, hAu, smul_zero, add_zero]
        -- `‖D w‖² = ‖w‖² - (1 - η²) ⟪u, w⟫² ≥ η² ‖w‖²`
        have hnorm : (η : ℝ) * ‖w‖ ≤ ‖D w‖ := by
          have h1 : ‖D w‖ ^ 2 = ‖w‖ ^ 2 + ((η : ℝ) ^ 2 - 1) * inner ℝ u w ^ 2 := by
            rw [hD, norm_add_sq_real, inner_smul_right, norm_smul, real_inner_comm,
              Real.norm_eq_abs, hu1, mul_one, sq_abs]
            ring
          have h2 : inner ℝ u w ^ 2 ≤ ‖w‖ ^ 2 := by
            have h := abs_real_inner_le_norm u w
            rw [hu1, one_mul] at h
            exact sq_le_sq' (abs_le.1 h).1 (abs_le.1 h).2
          have h3 : ((η : ℝ) * ‖w‖) ^ 2 ≤ ‖D w‖ ^ 2 := by
            rw [h1, mul_pow]
            have h4 : (η : ℝ) ^ 2 ≤ 1 := by nlinarith [η.coe_nonneg]
            nlinarith [mul_nonneg (sub_nonneg.2 h2) (sub_nonneg.2 h4)]
          exact (pow_le_pow_iff_left₀ (by positivity) (norm_nonneg _) two_ne_zero).1 h3
        have hAD : ‖A (D w)‖ ≤ ‖A‖ * ‖D w‖ := A.le_opNorm _
        calc ‖G y₁ - G y₂‖ ≤ ‖A w‖ + ‖G y₁ - G y₂ - A w‖ := norm_le_insert' _ _
          _ ≤ ‖A‖ * ‖D w‖ + ‖D w‖ := by rw [hAw] at happ ⊢; linarith
          _ = K * ‖D w‖ := by simp [K]; ring
      -- `φ = G ∘ D⁻¹` is `K`-Lipschitz on `D '' T` and `G '' T ⊆ φ '' (D '' T)`
      let φ : Euclid n → Euclid P := fun z => G (Function.invFunOn D T z)
      have hφ : ∀ y ∈ T, Function.invFunOn D T (D y) ∈ T ∧ D (Function.invFunOn D T (D y)) = D y :=
        fun y hy => Function.invFunOn_pos ⟨y, hy, rfl⟩
      have hlip : LipschitzOnWith K φ (D '' T) := by
        apply LipschitzOnWith.of_dist_le_mul
        rintro _ ⟨y₁, h₁, rfl⟩ _ ⟨y₂, h₂, rfl⟩
        obtain ⟨h₁', e₁⟩ := hφ y₁ h₁
        obtain ⟨h₂', e₂⟩ := hφ y₂ h₂
        have h := hkey _ h₁' _ h₂'
        rw [e₁, e₂] at h
        simpa only [dist_eq_norm] using h
      have hsub : G '' T ⊆ φ '' (D '' T) := by
        rintro _ ⟨y, hy, rfl⟩
        refine ⟨D y, ⟨y, hy, rfl⟩, ?_⟩
        obtain ⟨h', e⟩ := hφ y hy
        have h := hkey _ h' _ hy
        rw [e, sub_self, norm_zero, mul_zero] at h
        exact sub_eq_zero.1 (norm_le_zero_iff.1 h)
      -- `Hⁿ(G(T)) ≤ Kⁿ Hⁿ(D(T)) = Kⁿ |det D| Lⁿ(T) = ε Lⁿ(T)`
      calc μHE[n] (G '' T) ≤ μHE[n] (φ '' (D '' T)) := measure_mono hsub
        _ ≤ (K : ℝ≥0∞) ^ n * μHE[n] (D '' T) :=
            Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n hlip
        _ = (K : ℝ≥0∞) ^ n * (ENNReal.ofReal |LinearMap.det D| * volume T) := by
            rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume, Measure.addHaar_image_linearMap]
        _ = ε * volume T := by
            rw [hdet, abs_of_nonneg η.coe_nonneg, ENNReal.ofReal_coe_nnreal, ← mul_assoc,
              ← ENNReal.coe_pow, ← ENNReal.coe_mul, hη, mul_div_cancel₀ _ hKn.ne']
    -- on `C ∩ B̄_R(0)`: partition into pieces where `G` is close to some `DG(y)`, `y ∈ C`
    have hR : ∀ R : ℝ, μHE[n] (G '' ({x | ¬ Injective (fderiv ℝ G x)} ∩ closedBall 0 R)) = 0 := by
      intro R
      set s := {x | ¬ Injective (fderiv ℝ G x)} ∩ closedBall (0 : Euclid n) R with hs
      have hbound : ∀ ε : NNReal, 0 < ε → ε ≤ 1 →
          μHE[n] (G '' s) ≤ ε * volume (closedBall (0 : Euclid n) R) := by
        intro ε hε hε1
        rcases eq_empty_or_nonempty s with h | h
        · rw [h, image_empty, measure_empty]
          exact bot_le
        choose δ hδ using hloc ε hε hε1
        obtain ⟨t, A, t_disj, t_meas, t_cover, ht, Af'⟩ :=
          exists_partition_approximatesLinearOn_of_hasFDerivWithinAt G s (fderiv ℝ G)
            (fun x _ => (hG.differentiable one_ne_zero x).hasFDerivAt.hasFDerivWithinAt) δ
            (fun A => (hδ A).1.ne')
        calc μHE[n] (G '' s) ≤ μHE[n] (⋃ k, G '' (s ∩ t k)) := by
              rw [← image_iUnion, ← inter_iUnion]
              exact measure_mono (image_mono (subset_inter Subset.rfl t_cover))
          _ ≤ ∑' k, μHE[n] (G '' (s ∩ t k)) := measure_iUnion_le _
          _ ≤ ∑' k, (ε : ℝ≥0∞) * volume (closedBall (0 : Euclid n) R ∩ t k) := by
              refine ENNReal.tsum_le_tsum fun k => ?_
              obtain ⟨y, hy, hAy⟩ := Af' h k
              calc μHE[n] (G '' (s ∩ t k)) ≤ ε * volume (s ∩ t k) :=
                    (hδ (A k)).2 (by rw [hAy]; exact hy.1) _ (ht k)
                _ ≤ ε * volume (closedBall (0 : Euclid n) R ∩ t k) := by
                    gcongr
                    exact inter_subset_right
          _ = ε * volume (⋃ k, closedBall (0 : Euclid n) R ∩ t k) := by
              rw [ENNReal.tsum_mul_left, measure_iUnion]
              · exact pairwise_disjoint_mono t_disj fun k => inter_subset_right
              · exact fun k => measurableSet_closedBall.inter (t_meas k)
          _ ≤ ε * volume (closedBall (0 : Euclid n) R) := by
              gcongr
              exact iUnion_subset fun k => inter_subset_left
      -- let `ε → 0`
      have B : Tendsto (fun ε : NNReal => (ε : ℝ≥0∞) * volume (closedBall (0 : Euclid n) R))
          (𝓝[>] 0) (𝓝 0) := by
        have h : Tendsto (fun ε : NNReal => (ε : ℝ≥0∞) * volume (closedBall (0 : Euclid n) R))
            (𝓝 0) (𝓝 (((0 : NNReal) : ℝ≥0∞) * volume (closedBall (0 : Euclid n) R))) :=
          ENNReal.Tendsto.mul_const (ENNReal.tendsto_coe.2 tendsto_id)
            (Or.inr measure_closedBall_lt_top.ne)
        simp only [zero_mul, ENNReal.coe_zero] at h
        exact h.mono_left nhdsWithin_le_nhds
      rw [← nonpos_iff_eq_zero]
      apply ge_of_tendsto B
      filter_upwards [Ioc_mem_nhdsGT zero_lt_one] with ε hε
      exact hbound ε hε.1 hε.2
    have h := measure_iUnion_null (μ := μHE[n]) fun k : ℕ => hR k
    rwa [← image_iUnion, iUnion_inter_closedBall_nat] at h
  classical
  -- candidate balls `B_{1/(p+1)}(e_q)`, `(q, p) = Nat.unpair k`, for a dense sequence `e`
  obtain ⟨e, he⟩ := TopologicalSpace.exists_dense_seq (Euclid n)
  let ctr : ℕ → Euclid n := fun k => e (Nat.unpair k).1
  let rad : ℕ → ℝ := fun k => 1 / ((Nat.unpair k).2 + 1 : ℝ)
  -- a candidate ball is good if `G` has a lower Lipschitz bound on it
  let good : ℕ → Prop := fun k => ∃ μ : ℝ, 0 < μ ∧
    ∀ a ∈ ball (ctr k) (rad k), ∀ b ∈ ball (ctr k) (rad k), μ * ‖a - b‖ ≤ ‖G a - G b‖
  refine ⟨ctr, fun k => if good k then rad k else 0,
    fun k => if h : good k then Exists.choose h else 1, fun k => ?_, fun k => ?_, ?_⟩
  · -- `m_k > 0`
    show 0 < if h : good k then Exists.choose h else 1
    split_ifs with h
    exacts [(Exists.choose_spec h).1, one_pos]
  · -- (i): the witness on a good ball; otherwise `B_0(c_k) = ∅`
    intro a ha b hb
    dsimp only at ha hb ⊢
    by_cases h : good k
    · rw [ite_eq_left h] at ha hb
      rw [dite_eq_left h]
      exact (Exists.choose_spec h).2 a ha b hb
    · rw [ite_eq_right h, ball_zero] at ha
      exact absurd ha (notMem_empty a)
  · -- (ii): each regular point lies in a good ball, so the remainder is in the critical image
    refine measure_mono_null ?_ hcrit
    rintro y ⟨⟨x, rfl⟩, hy⟩
    refine ⟨x, fun hinj => hy ?_, rfl⟩
    obtain ⟨δ, μ, hδ, hμ, hlip⟩ :=
      Submission.codim1_rdo_c1cov_local_lower_lipschitz P n G x hG hinj
    obtain ⟨p, hp⟩ := exists_nat_one_div_lt (half_pos hδ)
    obtain ⟨q, hq⟩ := he.exists_dist_lt x (Nat.one_div_pos_of_nat : (0 : ℝ) < 1 / ((p : ℝ) + 1))
    have hk : Nat.unpair (Nat.pair q p) = (q, p) := Nat.unpair_pair q p
    -- `B_{1/(p+1)}(e_q) ⊆ B_δ(x)`, so this candidate ball is good
    have hsub : ball (ctr (Nat.pair q p)) (rad (Nat.pair q p)) ⊆ ball x δ := by
      intro a ha
      simp only [ctr, rad, hk, mem_ball] at ha ⊢
      calc dist a x ≤ dist a (e q) + dist (e q) x := dist_triangle _ _ _
        _ < 1 / ((p : ℝ) + 1) + 1 / ((p : ℝ) + 1) := add_lt_add ha (by rwa [dist_comm])
        _ < δ := by linarith
    have hgood : good (Nat.pair q p) :=
      ⟨μ, hμ, fun a ha b hb => hlip a (hsub ha) b (hsub hb)⟩
    refine mem_iUnion.2 ⟨Nat.pair q p, x, ?_, rfl⟩
    show x ∈ ball (ctr (Nat.pair q p)) (if good (Nat.pair q p) then rad (Nat.pair q p) else 0)
    rw [ite_eq_left hgood]
    simpa only [ctr, rad, hk, mem_ball] using hq
/-- **Simon Ch. 3, proof of Lemma 1.2** (properties (ii), (iii) of the pieces `g(B_r(c))`): the
image of an open ball under a `C¹` map `g : ℝⁿ → ℝᴾ` is Borel and has finite `Hⁿ`-measure.
`B_r(c) = ⋃ₜ closedBall(c, r − 1/(t+1))`, so `g(B_r(c))` is a countable union of compact sets;
`g` is Lipschitz on the compact convex `closedBall(c, r)`, so by Simon Ch. 2, 1.8(i)
`Hⁿ(g(B_r(c))) ≤ Λⁿ Lⁿ(B_r(c)) < ∞`. -/
theorem Submission.codim1_rdo_c1cov_image_ball_borel_finite : ∀ (P n : ℕ) (g : Euclid n → Euclid P) (c : Euclid n) (r : ℝ), ContDiff ℝ 1 g → MeasurableSet (g '' ball c r) ∧ μHE[n] (g '' ball c r) ≠ ∞ := by
  intro P n g c r hg
  refine ⟨?_, ?_⟩
  · -- `B_r(c)` is the union of the compact balls `closedBall(c, r − 1/(t+1))`
    have hball : ball c r = ⋃ t : ℕ, closedBall c (r - 1 / ((t : ℝ) + 1)) := by
      ext y
      simp only [mem_ball, mem_iUnion, mem_closedBall]
      constructor
      · intro hy
        obtain ⟨t, ht⟩ := exists_nat_one_div_lt (sub_pos.mpr hy)
        exact ⟨t, by linarith⟩
      · rintro ⟨t, ht⟩
        have : (0 : ℝ) < 1 / ((t : ℝ) + 1) := by positivity
        linarith
    rw [hball, image_iUnion]
    exact MeasurableSet.iUnion fun t =>
      ((isCompact_closedBall c _).image hg.continuous).isClosed.measurableSet
  · -- `g` is Lipschitz on the compact convex `closedBall c r`, hence on `ball c r`
    obtain ⟨K, hK⟩ := (hg.contDiffOn (s := closedBall c r)).exists_lipschitzOnWith one_ne_zero
      (convex_closedBall c r) (isCompact_closedBall c r)
    refine ne_top_of_le_ne_top ?_
      (Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
        (hK.mono ball_subset_closedBall))
    rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
    exact ENNReal.mul_ne_top (ENNReal.pow_ne_top ENNReal.coe_ne_top) measure_ball_lt_top.ne
/-- Simon Ch. 3, Lemma 1.2, display (1) (corrected: `F(ℝⁿ) ⊆ E ∪ ⋃ᵢ Gᵢ(ℝⁿ)`, `Gᵢ : ℝⁿ → ℝᴾ`),
for one Lipschitz map `F : ℝⁿ → ℝᴾ`, given the scalar `C¹` approximation theorem (Simon Ch. 2,
Theorem 1.5) on `ℝⁿ` as the hypothesis.  Each coordinate `Fˡ` is `K`-Lipschitz; approximating it
with error `((i + 1)(P + 1))⁻¹` gives `C¹` maps `Gᵢ = (g_{i,l})ₗ` with `Lⁿ{F ≠ Gᵢ} ≤ (i + 1)⁻¹`, so
`Z = ⋂ᵢ {F ≠ Gᵢ}` is `Lⁿ`-null, `Hⁿ(F(Z)) ≤ Kⁿ Lⁿ(Z) = 0` (Simon 2.1.8(i), `Hⁿ = Lⁿ` on `ℝⁿ`) and
`F(ℝⁿ) \ ⋃ᵢ Gᵢ(ℝⁿ) ⊆ F(Z)`. -/
theorem Submission.codim1_rdo_c1cov_lipschitz_range_c1_cover : ∀ (P n : ℕ), (∀ (f : Euclid n → ℝ) (K : NNReal), LipschitzWith K f → ∀ ε : ℝ≥0∞, 0 < ε → ∃ g : Euclid n → ℝ, ContDiff ℝ 1 g ∧ volume {x | f x ≠ g x ∨ fderiv ℝ f x ≠ fderiv ℝ g x} < ε) → ∀ (F : Euclid n → Euclid P) (K : NNReal), LipschitzWith K F → ∃ G : ℕ → Euclid n → Euclid P, (∀ i, ContDiff ℝ 1 (G i)) ∧ μHE[n] (range F \ ⋃ i, range (G i)) = 0 := by
  intro P n hH F K hF
  -- Step 1: the coordinates `Fˡ` of `F` are `K`-Lipschitz
  have hFl : ∀ l : Fin P, LipschitzWith K fun x => F x l := fun l =>
    LipschitzWith.of_dist_le_mul fun x y =>
      (PiLp.dist_apply_le (F x) (F y) l).trans (hF.dist_le_mul x y)
  -- Step 2: `C¹` approximation of every coordinate with error `δᵢ = ((i + 1)(P + 1))⁻¹`
  have hδ : ∀ i : ℕ, (0 : ℝ≥0∞) < (((i : ℝ≥0∞) + 1) * ((P : ℝ≥0∞) + 1))⁻¹ := fun i =>
    ENNReal.inv_pos.2 (ENNReal.mul_ne_top (by simp) (by simp))
  choose g hg hgvol using fun (i : ℕ) (l : Fin P) => hH (fun x => F x l) K (hFl l) _ (hδ i)
  -- Step 3: `Gᵢ = (g_{i,1}, …, g_{i,P})` is `C¹`
  let G : ℕ → Euclid n → Euclid P := fun i x => WithLp.toLp 2 fun l => g i l x
  have hG : ∀ i, ContDiff ℝ 1 (G i) := fun i => (contDiff_piLp 2).2 fun l => hg i l
  -- Step 4: `{F ≠ Gᵢ} ⊆ ⋃ₗ {Fˡ ≠ g_{i,l} ∨ DFˡ ≠ Dg_{i,l}}`, so `Lⁿ{F ≠ Gᵢ} ≤ (i + 1)⁻¹`
  have hsub : ∀ i, {x | F x ≠ G i x} ⊆
      ⋃ l, {x | F x l ≠ g i l x ∨ fderiv ℝ (fun x => F x l) x ≠ fderiv ℝ (g i l) x} := by
    intro i x hx
    obtain ⟨l, hl⟩ : ∃ l, F x l ≠ g i l x := by
      by_contra! h
      exact hx (PiLp.ext h)
    exact mem_iUnion.2 ⟨l, Or.inl hl⟩
  have hvol : ∀ i : ℕ, volume {x | F x ≠ G i x} ≤ ((i : ℝ≥0∞) + 1)⁻¹ := by
    intro i
    calc volume {x | F x ≠ G i x}
        ≤ ∑ l, volume {x | F x l ≠ g i l x ∨ fderiv ℝ (fun x => F x l) x ≠ fderiv ℝ (g i l) x} :=
          (measure_mono (hsub i)).trans (measure_iUnion_fintype_le _ _)
      _ ≤ ∑ _l : Fin P, (((i : ℝ≥0∞) + 1) * ((P : ℝ≥0∞) + 1))⁻¹ :=
          Finset.sum_le_sum fun l _ => (hgvol i l).le
      _ = (P : ℝ≥0∞) * (((i : ℝ≥0∞) + 1) * ((P : ℝ≥0∞) + 1))⁻¹ := by simp
      _ ≤ ((P : ℝ≥0∞) + 1) * (((i : ℝ≥0∞) + 1) * ((P : ℝ≥0∞) + 1))⁻¹ := by gcongr; exact le_self_add
      _ = ((i : ℝ≥0∞) + 1)⁻¹ := by
          rw [ENNReal.mul_inv (Or.inl (by simp)) (Or.inl (by simp)), mul_left_comm,
            ENNReal.mul_inv_cancel (by simp) (by simp), mul_one]
  -- Step 5: `Z = ⋂ᵢ {F ≠ Gᵢ}` is `Lⁿ`-null
  have hZ : volume (⋂ i, {x | F x ≠ G i x}) = 0 := by
    refine le_antisymm (le_of_forall_gt fun ε hε => ?_) bot_le
    obtain ⟨i, hi⟩ := ENNReal.exists_inv_nat_lt hε.ne'
    calc volume (⋂ i, {x | F x ≠ G i x}) ≤ volume {x | F x ≠ G i x} := measure_mono (iInter_subset _ i)
      _ ≤ ((i : ℝ≥0∞) + 1)⁻¹ := hvol i
      _ ≤ (i : ℝ≥0∞)⁻¹ := ENNReal.inv_le_inv.2 le_self_add
      _ < ε := hi
  -- Step 6: `Hⁿ(F(Z)) ≤ Kⁿ Hⁿ(Z) = Kⁿ Lⁿ(Z) = 0`
  have hFZ : μHE[n] (F '' ⋂ i, {x | F x ≠ G i x}) = 0 := by
    refine le_antisymm ?_ bot_le
    calc μHE[n] (F '' ⋂ i, {x | F x ≠ G i x})
        ≤ (K : ℝ≥0∞) ^ n * μHE[n] (⋂ i, {x | F x ≠ G i x}) :=
          Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
            hF.lipschitzOnWith
      _ = 0 := by rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume, hZ, mul_zero]
  -- Step 7: `F(ℝⁿ) \ ⋃ᵢ Gᵢ(ℝⁿ) ⊆ F(Z)`
  refine ⟨G, hG, measure_mono_null ?_ hFZ⟩
  rintro _ ⟨⟨x, rfl⟩, hy⟩
  exact ⟨x, mem_iInter.2 fun i h => hy (mem_iUnion.2 ⟨i, x, h.symm⟩), rfl⟩
/-- **Whitney's `C¹` extension theorem** (Simon Ch. 2, 1.6; proof of Evans–Gariepy §6.5).  If
`A ⊆ ℝⁿ` is closed, `h` and `D` are continuous on `A`, and the remainder
`h y - h x - D x (y - x)` is `o(|y - x|)` uniformly for `x` in compact subsets of `A`, then some
`g ∈ C¹(ℝⁿ)` has `g = h` and `Dg = D` on `A`.  With `r x = min(1, dist(x, A)) / 100`, Vitali's
lemma selects disjoint balls `B(c, r c)`, `c ∈ Z`, whose fourfold enlargements cover `ℝⁿ \ A`;
nearby radii are comparable, so the overlap is uniformly bounded.  Rescaled bumps divided by
their locally finite sum give a partition of unity `w c` on `ℝⁿ \ A` with
`∑ ‖D(w c)(x)‖ ≤ M / r x`.  Put `g = h` on `A` and `g = ∑ w c • P (pr c)` off `A`, where
`P b x = h b + D b (x - b)` and `pr c ∈ A` is a nearest point. -/
theorem Submission.codim1_rdo_c1a_whitney_extension : ∀ (n : ℕ) (A : Set (Euclid n)) (h : Euclid n → ℝ) (D : Euclid n → (Euclid n →L[ℝ] ℝ)), IsClosed A → ContinuousOn h A → ContinuousOn D A → (∀ Q : Set (Euclid n), IsCompact Q → Q ⊆ A → ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ x ∈ Q, ∀ y ∈ A, dist x y < δ → ‖h y - h x - D x (y - x)‖ ≤ ε * ‖y - x‖) → ∃ g : Euclid n → ℝ, ContDiff ℝ 1 g ∧ EqOn g h A ∧ ∀ a ∈ A, HasFDerivAt g (D a) a := by
  intro n A h D hA hh hD hrem
  classical
  rcases A.eq_empty_or_nonempty with rfl | hne
  · exact ⟨fun _ => 0, contDiff_const, by simp, by simp⟩
  -- the Whitney radius `r x = min 1 (dist x A) / 100`
  obtain ⟨r, hr⟩ : ∃ r : Euclid n → ℝ, ∀ x, r x = min 1 (infDist x A) / 100 :=
    ⟨_, fun _ => rfl⟩
  have hr0 : ∀ x, 0 ≤ r x := fun x => by
    rw [hr]; exact div_nonneg (le_min zero_le_one infDist_nonneg) (by norm_num)
  have hr1 : ∀ x, r x ≤ 1 / 100 := fun x => by
    rw [hr]; exact div_le_div_of_nonneg_right (min_le_left _ _) (by norm_num)
  have hrd : ∀ x, 100 * r x ≤ infDist x A := fun x => by
    rw [hr]; linarith [min_le_right (1 : ℝ) (infDist x A)]
  have hrpos : ∀ x, x ∉ A → 0 < r x := fun x hx => by
    rw [hr]
    exact div_pos (lt_min one_pos ((hA.notMem_iff_infDist_pos hne).mp hx)) (by norm_num)
  have hrlip : ∀ x y, r x ≤ r y + dist x y / 100 := fun x y => by
    have h₁ := ((lipschitz_infDist_pt A).const_min 1).dist_le_mul x y
    simp only [Real.dist_eq, NNReal.coe_one, one_mul] at h₁
    have h₂ := (abs_sub_le_iff.mp h₁).1
    rw [hr, hr]; linarith
  -- radii of nearby centres are comparable
  have hnear : ∀ x c, dist x c ≤ r x + 10 * r c →
      r x / 2 ≤ r c ∧ r c ≤ 2 * r x ∧ dist x c ≤ 21 * r x := by
    intro x c hxc
    have h₁ := hrlip x c
    have h₂ := hrlip c x
    rw [dist_comm c x] at h₂
    have := hr0 x
    have := hr0 c
    exact ⟨by linarith, by linarith, by linarith⟩
  -- Vitali: disjoint balls `B(c, r c)`, `c ∈ Z`, whose fourfold enlargements cover `Aᶜ`
  obtain ⟨Z, hZA, hZdisj, hZcov⟩ : ∃ Z ⊆ Aᶜ, Z.PairwiseDisjoint (fun c => ball c (r c)) ∧
      ∀ x ∉ A, ∃ c ∈ Z, dist x c < 4 * r c := by
    obtain ⟨s, hs, hd, hc⟩ := Vitali.exists_disjoint_subfamily_covering_enlargement_ball
      Aᶜ (fun x => x) r (1 / 100) (fun x _ => hr1 x) 4 (by norm_num)
    refine ⟨s, hs, hd, fun x hx => ?_⟩
    obtain ⟨c, hcs, hxc⟩ := hc x hx
    exact ⟨c, hcs, hxc (mem_ball_self (hrpos x hx))⟩
  have hsep : ∀ c ∈ Z, ∀ d ∈ Z, c ≠ d → r c ≤ dist c d := by
    intro c hc d hd hcd
    by_contra hlt
    have hdc : d ∈ ball c (r c) := by
      simpa only [mem_ball, dist_comm] using lt_of_not_ge hlt
    exact Set.disjoint_left.mp (hZdisj hc hd hcd) hdc (mem_ball_self (hrpos d (hZA hd)))
  -- a `1/2`-separated subset of `B̄(0, 21)` has at most `N` points
  obtain ⟨N, hN⟩ : ∃ N : ℕ, ∀ s : Set (Euclid n), s ⊆ closedBall (0 : Euclid n) 21 →
      s.Pairwise (fun x y => 1 / 2 ≤ dist x y) → s.Finite ∧ s.ncard ≤ N := by
    obtain ⟨t, ht, hcover⟩ := Metric.totallyBounded_iff.mp
      (isCompact_closedBall (0 : Euclid n) 21).totallyBounded (1 / 4) (by norm_num)
    refine ⟨t.ncard, fun s hs hssep => ?_⟩
    have hc : ∀ x : s, ∃ y : t, dist (x : Euclid n) y < 1 / 4 := by
      intro x
      have hx := hcover (hs x.property)
      simp only [mem_iUnion, mem_ball, exists_prop] at hx
      obtain ⟨y, hyt, hxy⟩ := hx
      exact ⟨⟨y, hyt⟩, hxy⟩
    choose c hc using hc
    have hi : Injective c := by
      intro x y hxy
      by_contra hxy'
      have hne' : (x : Euclid n) ≠ (y : Euclid n) := fun e => hxy' (Subtype.ext e)
      have hd := hssep x.property y.property hne'
      have htri := dist_triangle (x : Euclid n) (c x : Euclid n) (y : Euclid n)
      have hxc := hc x
      have hyc := hc y
      rw [← hxy, dist_comm (y : Euclid n) (c x : Euclid n)] at hyc
      linarith
    have : Finite t := ht.to_subtype
    have : Finite s := Finite.of_injective c hi
    exact ⟨Set.toFinite s, Nat.card_le_card_of_injective c hi⟩
  -- bounded overlap: at most `N` centres are near any `x ∉ A`
  have hover : ∀ x ∉ A, {c | c ∈ Z ∧ dist x c ≤ r x + 10 * r c}.Finite ∧
      {c | c ∈ Z ∧ dist x c ≤ r x + 10 * r c}.ncard ≤ N := by
    intro x hx
    have hrx : 0 < r x := hrpos x hx
    let f : Euclid n → Euclid n := fun c => (r x)⁻¹ • (c - x)
    have hf : Injective f := by
      intro c d hcd
      have e := congrArg (fun z : Euclid n => r x • z) hcd
      simpa [f, smul_smul, hrx.ne'] using e
    have hnorm : ∀ c ∈ {c | c ∈ Z ∧ dist x c ≤ r x + 10 * r c}, ‖f c‖ ≤ 21 := by
      intro c hc
      have hd := (hnear x c hc.2).2.2
      rw [dist_comm, dist_eq_norm] at hd
      simp only [f]
      rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hrx.le)]
      calc (r x)⁻¹ * ‖c - x‖ ≤ (r x)⁻¹ * (21 * r x) :=
            mul_le_mul_of_nonneg_left hd (inv_nonneg.mpr hrx.le)
        _ = 21 := by field_simp
    have hsep' : (f '' {c | c ∈ Z ∧ dist x c ≤ r x + 10 * r c}).Pairwise
        (fun y z => 1 / 2 ≤ dist y z) := by
      rintro _ ⟨c, hc, rfl⟩ _ ⟨d, hd, rfl⟩ hcd
      have hcd' : c ≠ d := fun e => hcd (congrArg f e)
      have hdist := hsep c hc.1 d hd.1 hcd'
      have hrad := (hnear x c hc.2).1
      have hlow : r x / 2 ≤ ‖c - d‖ := by
        simpa only [dist_eq_norm] using hrad.trans hdist
      have hid : (c - x) - (d - x) = c - d := by abel
      simp only [f]
      rw [dist_eq_norm, ← smul_sub, hid, norm_smul,
        Real.norm_of_nonneg (inv_nonneg.mpr hrx.le)]
      calc (1 : ℝ) / 2 = (r x)⁻¹ * (r x / 2) := by field_simp
        _ ≤ (r x)⁻¹ * ‖c - d‖ := mul_le_mul_of_nonneg_left hlow (inv_nonneg.mpr hrx.le)
    have hsub : f '' {c | c ∈ Z ∧ dist x c ≤ r x + 10 * r c} ⊆ closedBall (0 : Euclid n) 21 := by
      rintro _ ⟨c, hc, rfl⟩
      simpa only [mem_closedBall, dist_zero_right] using hnorm c hc
    obtain ⟨hfin, hcard⟩ := hN _ hsub hsep'
    exact ⟨hfin.of_finite_image hf.injOn, by rwa [Set.ncard_image_of_injective _ hf] at hcard⟩
  -- the finite set `F x` of centres near `x ∉ A`
  have hfin : ∀ x ∉ A, {c : Z | dist x c ≤ r x + 10 * r c}.Finite := by
    intro x hx
    apply ((hover x hx).1.preimage (Subtype.val_injective (p := (· ∈ Z))).injOn).subset
    intro c hc
    exact ⟨c.property, hc⟩
  have hFex : ∀ x, ∃ s : Finset Z, x ∉ A → ∀ c : Z, c ∈ s ↔ dist x c ≤ r x + 10 * r c := by
    intro x
    by_cases hx : x ∈ A
    · exact ⟨∅, fun hx' => absurd hx hx'⟩
    · exact ⟨(hfin x hx).toFinset, fun _ c => by simp⟩
  choose F hF using hFex
  have hFcard : ∀ x ∉ A, (F x).card ≤ N := by
    intro x hx
    have hsub : (F x).map (Embedding.subtype _) ⊆ (hover x hx).1.toFinset := by
      intro c hc
      simp only [Finset.mem_map, Embedding.coe_subtype] at hc
      obtain ⟨c', hc', rfl⟩ := hc
      rw [Set.Finite.mem_toFinset]
      exact ⟨c'.property, (hF x hx c').mp hc'⟩
    calc (F x).card = ((F x).map (Embedding.subtype _)).card := (Finset.card_map _).symm
      _ ≤ (hover x hx).1.toFinset.card := Finset.card_le_card hsub
      _ = {c | c ∈ Z ∧ dist x c ≤ r x + 10 * r c}.ncard :=
          (Set.ncard_eq_toFinset_card _ _).symm
      _ ≤ N := (hover x hx).2
  -- a smooth bump `ψ = 1` on `B̄(0, 4)`, `ψ = 0` off `B(0, 8)`
  obtain ⟨ψ, hψc, hψ0, hψ1, hψin, hψout, L, hL⟩ : ∃ ψ : Euclid n → ℝ, ContDiff ℝ 1 ψ ∧
      (∀ x, 0 ≤ ψ x) ∧ (∀ x, ψ x ≤ 1) ∧ (∀ x, ‖x‖ ≤ 4 → ψ x = 1) ∧
      (∀ x, 8 ≤ ‖x‖ → ψ x = 0) ∧ ∃ L : NNReal, LipschitzWith L ψ := by
    let b : ContDiffBump (0 : Euclid n) := ⟨4, 8, by norm_num, by norm_num⟩
    have hb : ContDiff ℝ 1 b := b.contDiff
    obtain ⟨L, hL⟩ := hb.lipschitzWith_of_hasCompactSupport b.hasCompactSupport one_ne_zero
    refine ⟨b, hb, fun x => b.nonneg, fun x => b.le_one, fun x hx => ?_, fun x hx => ?_, L, hL⟩
    · exact b.one_of_mem_closedBall (mem_closedBall_zero_iff.mpr hx)
    · apply notMem_support.mp
      rw [b.support_eq]
      exact fun hxb => absurd (mem_ball_zero_iff.mp hxb) (not_lt.mpr hx)
  -- the rescaled bumps `φ c x = ψ ((x - c) / r c)`
  obtain ⟨φ, hφ⟩ : ∃ φ : Euclid n → Euclid n → ℝ, ∀ c x, φ c x = ψ ((r c)⁻¹ • (x - c)) :=
    ⟨_, fun _ _ => rfl⟩
  have hφfun : ∀ c, φ c = fun x => ψ ((r c)⁻¹ • (x - c)) := fun c => funext (hφ c)
  have hφc : ∀ c, ContDiff ℝ 1 (φ c) := by
    intro c
    rw [hφfun c]
    exact hψc.comp ((contDiff_id.sub contDiff_const).const_smul _)
  have hφ0 : ∀ c x, 0 ≤ φ c x := fun c x => by rw [hφ]; exact hψ0 _
