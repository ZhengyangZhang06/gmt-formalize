      intro z
      rw [hRtC, hRtθ, hRtξ]
      by_cases hzt : L.starProjection z = t
      · rw [ite_eq_left hzt]
        by_cases hzM : z ∈ R.carrier
        · rw [indicator_of_mem (show z ∈ R.carrier ∩ {x | L.starProjection x = t} from ⟨hzM, hzt⟩),
