        ∀ α : Covector (Euclid P) n, ξt x α = c * α b := by
      rcases hτsign with h | h
      · exact ⟨D, hD1, fun α => by rw [← hxe, h α, hτb α]⟩
      · exact ⟨-D, hD1.symm.imp (fun h1 => by rw [h1, neg_neg]) (fun h1 => by rw [h1]),
