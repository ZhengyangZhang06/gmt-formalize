    intro u hu
    have h : Real.smoothTransition =ᶠ[𝓝 u] fun _ => 1 := by
      filter_upwards [lt_mem_nhds hu] with w hw
      exact Real.smoothTransition.one_of_one_le hw.le
    rw [h.deriv_eq, deriv_const]
  have hball : ∀ k : ℕ, ∀ᵐ x ∂R.measure, ‖x‖ < k →
      (approxTangentPlane n R.carrier x).starProjection x = x := by
    intro k
    obtain ⟨η, hη⟩ : ∃ η : ℝ → ℝ, ∀ s, η s = ((k : ℝ) ^ 2 + 1 - s) *
        (1 - Real.smoothTransition (s - (k : ℝ) ^ 2)) := ⟨_, fun _ => rfl⟩
    have hηf : η = fun s => ((k : ℝ) ^ 2 + 1 - s) *
        (1 - Real.smoothTransition (s - (k : ℝ) ^ 2)) := funext hη
    have hηc : ContDiff ℝ 1 η := by
      rw [hηf]
      exact (contDiff_const.sub contDiff_id).mul
        (contDiff_const.sub (hτc.comp (contDiff_id.sub contDiff_const)))
    have hη' : ∀ s, deriv η s = -(1 - Real.smoothTransition (s - (k : ℝ) ^ 2)) -
        ((k : ℝ) ^ 2 + 1 - s) * deriv Real.smoothTransition (s - (k : ℝ) ^ 2) := by
      intro s
      rw [hηf]
      have h1 : HasDerivAt (fun s : ℝ => (k : ℝ) ^ 2 + 1 - s) (-1) s := by
        simpa using (hasDerivAt_id s).const_sub ((k : ℝ) ^ 2 + 1)
      have h2 : HasDerivAt (fun s : ℝ => 1 - Real.smoothTransition (s - (k : ℝ) ^ 2))
          (-deriv Real.smoothTransition (s - (k : ℝ) ^ 2)) s := by
        simpa using ((hτd (s - (k : ℝ) ^ 2)).comp s
          ((hasDerivAt_id s).sub_const ((k : ℝ) ^ 2))).const_sub 1
      exact (h1.mul h2).deriv.trans (by ring)
    have hcut : ∀ s, ((k : ℝ) + 1) ^ 2 ≤ s → η s = 0 := by
      intro s hs
      rw [hη, Real.smoothTransition.one_of_one_le
        (by nlinarith [(Nat.cast_nonneg k : (0 : ℝ) ≤ k)]), sub_self, mul_zero]
    have hd_nonpos : ∀ s, deriv η s ≤ 0 := by
      intro s
      rw [hη']
      rcases le_or_gt s ((k : ℝ) ^ 2 + 1) with hs | hs
      · have h1 := Real.smoothTransition.le_one (s - (k : ℝ) ^ 2)
        have h2 : 0 ≤ deriv Real.smoothTransition (s - (k : ℝ) ^ 2) :=
          Real.smoothTransition.monotone.deriv_nonneg
        nlinarith
      · rw [Real.smoothTransition.one_of_one_le (by linarith), hτ1 _ (by linarith)]
        simp
    obtain ⟨hint, h0⟩ := hkey η hηc ((k : ℝ) + 1) (by positivity) hcut
    have hnn : ∀ x : Euclid P, 0 ≤ -(deriv η (‖x‖ ^ 2) *
        ‖x - (approxTangentPlane n R.carrier x).starProjection x‖ ^ 2) := by
      intro x
      have := hd_nonpos (‖x‖ ^ 2)
      nlinarith [sq_nonneg ‖x - (approxTangentPlane n R.carrier x).starProjection x‖]
    have hzero := (integral_eq_zero_iff_of_nonneg (f := fun x => -(deriv η (‖x‖ ^ 2) *
        ‖x - (approxTangentPlane n R.carrier x).starProjection x‖ ^ 2)) (fun x => hnn x)
      hint.neg).1 (by rw [integral_neg, h0, neg_zero])
    filter_upwards [hzero] with x hx hxk
    have hs : ‖x‖ ^ 2 - (k : ℝ) ^ 2 < 0 := by
      have := pow_lt_pow_left₀ hxk (norm_nonneg x) two_ne_zero
      linarith
    have hd : deriv η (‖x‖ ^ 2) = -1 := by
      rw [hη', Real.smoothTransition.zero_of_nonpos hs.le, hτ0 _ hs]
      ring
    simp only [Pi.zero_apply, hd, neg_mul, one_mul, neg_neg] at hx
    have h := (pow_eq_zero_iff two_ne_zero).1 hx
    exact (sub_eq_zero.1 (norm_eq_zero.1 h)).symm
  -- the balls `B_k(0)` exhaust `ℝᴾ`
  filter_upwards [ae_all_iff.2 hball] with x hx
  obtain ⟨k, hk⟩ := exists_nat_gt ‖x‖
  exact hx k hk
/-- **Approximate tangent planes of a cone are dilation invariant** (Simon Ch. 3, 1.4, for the cone
`C` of 7.3.1(2) in the proof of 7.3.3).  If the cone `C` is represented by `R = (M, θ, ξ)` with
weight `μ = θHⁿ⌞M` and `r > 0`, then `T_{rx}M = TₓM` for `μ`-a.e. `x`.  As `μ(λA) = λⁿ μ(A)`,
`μ`-a.e. statements survive `x ↦ λx`; since `θ ≥ 1` on `M`, this gives
`Hⁿ(M \ rM) = Hⁿ(rM \ M) = 0`.  For `μ`-a.e. `x` both `TₓM` and `T_{rx}M` exist; `TₓM` is the
approximate tangent plane of `η_{0,r⁻¹}(M) = rM` at `rx`, so both are approximate tangent planes
of `M ∩ rM` at `rx`, and approximate tangent planes are unique. -/
theorem Submission.idtp_cse_cone_approxTangent_smul : ∀ (P n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n), IsConeCurrent C → R.Represents C → ∀ r : ℝ, 0 < r → ∀ᵐ x ∂R.measure, approxTangentPlane n R.carrier (r • x) = approxTangentPlane n R.carrier x := by
  intro P n C R hC hR r hr
  -- Step 1: `μ`-a.e. statements survive `x ↦ λx`, `λ > 0`: if `p` fails only on a `μ`-null Borel
  -- set `E`, then `p(λ·)` fails only on `λ⁻¹E`, and `μ(λ⁻¹E) = λ⁻ⁿ μ(E) = 0`
  have hscale : ∀ lam : ℝ, 0 < lam → ∀ p : Euclid P → Prop, (∀ᵐ x ∂R.measure, p x) →
      ∀ᵐ x ∂R.measure, p (lam • x) := by
    intro lam hlam p hp
    obtain ⟨E, hpE, hE, hμE⟩ := exists_measurable_superset_of_null (ae_iff.1 hp)
    rw [ae_iff]
    refine measure_mono_null (t := (fun x => lam⁻¹ • x) '' E) (fun x hx =>
      ⟨lam • x, hpE (show lam • x ∈ {y | ¬p y} from hx), inv_smul_smul₀ hlam.ne' x⟩) ?_
    rw [Submission.cone_current_imrep_measure_smul_image P n C R hC hR lam⁻¹ (inv_pos.2 hlam) E
      hE, hμE, mul_zero]
  -- `μ = θHⁿ⌞M` and `Hⁿ⌞M` have the same null sets, as `θ ≥ 1` on `M`
  have hac : R.measure ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
  have hac' : μHE[n].restrict R.carrier ≪ R.measure := by
    refine withDensity_absolutelyContinuous'
      (measurable_from_nat.comp R.measurable_mult).aemeasurable ?_
    filter_upwards [ae_restrict_mem R.measurableSet_carrier] with x hx
    exact_mod_cast (R.mult_pos x hx).ne'
  -- Step 2: `μ`-a.e. `x` lies in `M` and `M` has an approximate tangent space at `x`
  have hgood : ∀ᵐ x ∂R.measure,
      x ∈ R.carrier ∧ ∃ Q, HasApproximateTangentSpaceAt n R.carrier x Q := by
    have h : ∀ᵐ x ∂(μHE[n].restrict R.carrier),
        x ∈ R.carrier ∧ ∃ Q, HasApproximateTangentSpaceAt n R.carrier x Q := by
      filter_upwards [R.orients, ae_restrict_mem R.measurableSet_carrier] with x ⟨Q, hQ, _⟩ hx
      exact ⟨hx, Q, hQ⟩
    exact hac.ae_le h
  -- Step 3: `Hⁿ(M \ λM) = 0`: `μ`-a.e., hence `Hⁿ⌞M`-a.e., `λ⁻¹x ∈ M`
  have hnull₁ : ∀ lam : ℝ, 0 < lam →
      μHE[n] (R.carrier \ (fun y => lam • y) '' R.carrier) = 0 := by
    intro lam hlam
    have h : ∀ᵐ x ∂(μHE[n].restrict R.carrier), lam⁻¹ • x ∈ R.carrier :=
      hac'.ae_le (hscale lam⁻¹ (inv_pos.2 hlam) (· ∈ R.carrier) (hgood.mono fun x hx => hx.1))
    rw [ae_restrict_iff' R.measurableSet_carrier, ae_iff] at h
    have hsub : R.carrier \ (fun y => lam • y) '' R.carrier ⊆
        {x | ¬(x ∈ R.carrier → lam⁻¹ • x ∈ R.carrier)} :=
      fun x hx himp => hx.2 ⟨lam⁻¹ • x, himp hx.1, smul_inv_smul₀ hlam.ne' x⟩
    exact measure_mono_null hsub h
  -- `Hⁿ(λM \ M) ≤ Hⁿ(λ(M \ λ⁻¹M)) = λⁿ Hⁿ(M \ λ⁻¹M) = 0`
  have hnull₂ : ∀ lam : ℝ, 0 < lam →
      μHE[n] ((fun y => lam • y) '' R.carrier \ R.carrier) = 0 := by
    intro lam hlam
    refine measure_mono_null
      (t := (fun y => lam • y) '' (R.carrier \ (fun y => lam⁻¹ • y) '' R.carrier)) ?_ ?_
    · rintro _ ⟨⟨y, hy, rfl⟩, hyM⟩
      refine ⟨y, ⟨hy, ?_⟩, rfl⟩
      rintro ⟨w, hw, rfl⟩
      apply hyM
      show lam • lam⁻¹ • w ∈ R.carrier
      rwa [smul_inv_smul₀ hlam.ne']
    · rw [Set.image_smul, Measure.euclideanHausdorffMeasure_smul₀ n hlam.ne',
        hnull₁ lam⁻¹ (inv_pos.2 hlam), smul_zero]
  -- `η_{0,r⁻¹}(y) = ry`
  have hdil : dilation (0 : Euclid P) r⁻¹ = fun y => r • y := by
    funext y
    simp [dilation, dilationCLM]
  -- `TₓM` is an approximate tangent space of `M` at `x` whenever one exists
  have hspec : ∀ z, (∃ Q, HasApproximateTangentSpaceAt n R.carrier z Q) →
      HasApproximateTangentSpaceAt n R.carrier z (approxTangentPlane n R.carrier z) := by
    intro z hz
    rw [approxTangentPlane, dite_eq_left hz]
    exact hz.choose_spec
  -- Step 4: compare `TₓM` and `T_{rx}M` at the `μ`-a.e. `x` where both exist
  filter_upwards [hgood, hscale r hr _ hgood] with x hx hrx
  -- (i) `TₓM` is the approximate tangent space of `η_{0,r⁻¹}(M) = rM` at `rx`
  have h1 := Submission.dtc_approxTangent_dilation P n R.carrier 0 x r⁻¹ _ (inv_pos.2 hr)
    (hspec x hx.2)
  rw [hdil] at h1
  -- (ii) and of `M ∩ rM`, as `Hⁿ(rM \ M) = 0`
  have h2 := Submission.dtc_approxTangent_of_null_diff P n _
    (R.carrier ∩ (fun y => r • y) '' R.carrier) univ (r • x) _ inter_subset_right isOpen_univ
    (mem_univ _) (by rw [inter_univ, sdiff_inter_self_eq_sdiff]; exact hnull₂ r hr) h1
  -- (iii) `T_{rx}M` is the approximate tangent space of `M ∩ rM` at `rx`, as `Hⁿ(M \ rM) = 0`
  have h3 := Submission.dtc_approxTangent_of_null_diff P n R.carrier
    (R.carrier ∩ (fun y => r • y) '' R.carrier) univ (r • x) _ inter_subset_left isOpen_univ
    (mem_univ _) (by rw [inter_univ, sdiff_self_inter]; exact hnull₁ r hr) (hspec (r • x) hrx.2)
  -- (iv) uniqueness of approximate tangent spaces
  exact (h2.unique h3).symm

/-- **Simon 7.3.3, proof (sector points lie in `spt C`)**: if the integer multiplicity
`C ∈ 𝒟₂(ℝᴾ)` has density `k ≥ 1` at every point `t(cos φ a + sin φ e)` with `t > 0` and
`0 < φ < δ`, then `a + l e ∈ spt C` for `0 < l < δ`.  Indeed `a + l e = t(cos φ a + sin φ e)` for `t = √(1 + l²)`
and `φ = arctan l ∈ (0, δ)`.  If a ball `B_ε(a + l e)` were `μ_C`-null, then
`M_{B_ρ(a + l e)}(C) = μ_C(B_ρ(a + l e)) = 0` for `0 < ρ < ε`, and the density of `C` at
`a + l e` would be `0 ≠ k`. -/
theorem Submission.idtp_cse_etp_edge_direction_support : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2) (a e : Euclid P) (δ : ℝ) (k : ℕ), IsIntegerMultiplicity C → 0 < δ → 1 ≤ k → (∀ t φ : ℝ, 0 < t → 0 < φ → φ < δ → HasMassDensity C (t • (Real.cos φ • a + Real.sin φ • e)) k) → ∃ l₀ : ℝ, 0 < l₀ ∧ ∀ l : ℝ, 0 < l → l < l₀ → a + l • e ∈ C.support := by
  intro P C a e δ k hC hδ hk hdens
  obtain ⟨R, hR⟩ := hC
  obtain ⟨hmass, hspt, -⟩ := Submission.dimred_im_mass_measure P 2 univ C R isOpen_univ hR
  refine ⟨δ, hδ, fun l hl hlδ => ?_⟩
  -- `a + l e = t(cos φ a + sin φ e)` for `t = √(1 + l²) > 0` and `φ = arctan l ∈ (0, δ)`
  have ht : 0 < √(1 + l ^ 2) := Real.sqrt_pos.2 (by positivity)
  have hpolar : √(1 + l ^ 2) • (Real.cos (Real.arctan l) • a + Real.sin (Real.arctan l) • e) =
      a + l • e := by
    rw [Real.cos_arctan, Real.sin_arctan, smul_add, smul_smul, smul_smul,
      mul_one_div_cancel ht.ne', mul_div_cancel₀ l ht.ne', one_smul]
  obtain ⟨-, hlim⟩ := hdens _ _ ht (Real.arctan_pos.2 hl) ((Real.arctan_lt_self hl).trans hlδ)
  rw [hpolar] at hlim
  -- a `μ_C`-null ball `B_ε(a + l e)` makes the density quotients vanish for `0 < ρ < ε`
  rw [hspt (a + l • e) (mem_univ _)]
  intro ε hε hnull
  have hzero : Tendsto (fun ρ : ℝ => C.massOn (ball (a + l • e) ρ) /
      (unitBallVolume 2 * ENNReal.ofReal (ρ ^ 2))) (𝓝[>] 0) (𝓝 0) := by
    refine tendsto_const_nhds.congr' ?_
    filter_upwards [Ioo_mem_nhdsGT hε] with ρ hρ
    rw [hmass _ isOpen_ball (subset_univ _),
      measure_mono_null (ball_subset_ball hρ.2.le) hnull, ENNReal.zero_div]
  have hk₀ : (k : ℝ) ≤ 0 := ENNReal.ofReal_eq_zero.1 (tendsto_nhds_unique hlim hzero)
  have hk₁ : (1 : ℝ) ≤ k := by exact_mod_cast hk
  linarith

/-- **Simon 7.3.3, proof (the cusp at an edge point `a`)**: let `μ` be locally finite, `a ∈ Q`,
`π` the orthogonal projection onto `Q` and `q = id − π`.  If (i) `μ(B_ρ(y)) ≥ ω₂ρ²` for `y ∈ Z`,
`ρ > 0`, and (ii) along a subsequence of every `λⱼ ↓ 0`, `λⱼ⁻²∫ g ∘ η_{a,λⱼ} dμ → m∫_Q g dH²`,
then `|q(x)| ≤ ε|x − a|` for `x ∈ Z` near `a`.  Otherwise there are `xⱼ ∈ Z` with
`sⱼ = |xⱼ − a| → 0` and `|q(xⱼ)| > εsⱼ`; a limit `w` of the unit directions `sⱼ⁻¹(xⱼ − a)` lies in
`Q` by `idtp_cse_etp_rescaled_limit_mem` (the balls `B_{sⱼr}(xⱼ)` have mass `≥ ω₂(sⱼr)²`), yet
`|q(w)| ≥ ε`. -/
theorem Submission.idtp_cse_etp_cusp : ∀ (P : ℕ) (μ : Measure (Euclid P)) (Z : Set (Euclid P)) (Q : Submodule ℝ (Euclid P)) (a : Euclid P) (m : ℝ), a ∈ Q → (∀ K : Set (Euclid P), IsCompact K → μ K ≠ ∞) → (∀ y ∈ Z, ∀ ρ : ℝ, 0 < ρ → unitBallVolume 2 * ENNReal.ofReal (ρ ^ 2) ≤ μ (ball y ρ)) → (∀ lams : ℕ → ℝ, (∀ j, 0 < lams j) → Tendsto lams atTop (𝓝 0) → ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ g : Euclid P → ℝ, Continuous g → HasCompactSupport g → Tendsto (fun j => (lams (φ j))⁻¹ ^ 2 * ∫ x, g (dilation a (lams (φ j)) x) ∂μ) atTop (𝓝 (m * ∫ x in (Q : Set (Euclid P)), g x ∂μHE[2]))) → ∀ ε : ℝ, 0 < ε → ∃ s : ℝ, 0 < s ∧ ∀ x ∈ Z, dist x a < s → ‖x - Q.starProjection x‖ ≤ ε * dist x a := by
  intro P μ Z Q a m haQ hfin hlow hblow ε hε
  -- `q(x − a) = q(x)` because `πa = a`
  have hπa : Q.starProjection a = a := Submodule.starProjection_eq_self_iff.2 haQ
  -- if no `s` works, pick `xⱼ ∈ Z` with `|xⱼ − a| < 1/(j+1)` and `|q(xⱼ)| > ε|xⱼ − a|`
  by_contra hcon
  have hbad : ∀ j : ℕ, ∃ x ∈ Z, dist x a < 1 / ((j : ℝ) + 1) ∧
      ε * dist x a < ‖x - Q.starProjection x‖ := by
    intro j
    by_contra h
    exact hcon ⟨1 / ((j : ℝ) + 1), by positivity, fun x hx hxa =>
      not_lt.1 fun hlt => h ⟨x, hx, hxa, hlt⟩⟩
  choose xs hxZ hxa hxq using hbad
  -- `sⱼ := |xⱼ − a| > 0` (else `xⱼ = a` and `q(xⱼ) = 0`), and `sⱼ → 0`
  have hpos : ∀ j, 0 < dist (xs j) a := by
    intro j
    refine dist_pos.2 fun h => ?_
    have := hxq j
    rw [h, hπa, sub_self, norm_zero, dist_self, mul_zero] at this
    exact lt_irrefl _ this
  have hlim : Tendsto (fun j => dist (xs j) a) atTop (𝓝 0) :=
    squeeze_zero (fun _ => dist_nonneg) (fun j => (hxa j).le)
      tendsto_one_div_add_atTop_nhds_zero_nat
  -- the blow-up subsequence `φ` for `λⱼ := sⱼ`
  obtain ⟨φ, -, hV⟩ := hblow (fun j => dist (xs j) a) hpos hlim
  -- the unit directions `wⱼ := sⱼ⁻¹(xⱼ − a)` along `φ` have a subsequence `ψ` with `wψⱼ → w`
  have hsph : ∀ j, (dist (xs (φ j)) a)⁻¹ • (xs (φ j) - a) ∈ sphere (0 : Euclid P) 1 := by
    intro j
    rw [mem_sphere_zero_iff_norm, norm_smul, norm_inv, Real.norm_eq_abs,
      abs_of_pos (hpos _), ← dist_eq_norm]
    exact inv_mul_cancel₀ (hpos _).ne'
  obtain ⟨w, -, ψ, hψ, hw⟩ := (isCompact_sphere (0 : Euclid P) 1).tendsto_subseq hsph
  -- `a + sⱼwⱼ = xⱼ ∈ Z`, so (i) bounds the mass of every ball `B_{sⱼr}(a + sⱼwⱼ)`
  have hcenter : ∀ j, a + dist (xs (φ (ψ j))) a •
      ((dist (xs (φ (ψ j))) a)⁻¹ • (xs (φ (ψ j)) - a)) = xs (φ (ψ j)) := by
    intro j
    rw [smul_smul, mul_inv_cancel₀ (hpos _).ne', one_smul, add_sub_cancel]
  -- hence `w ∈ Q` (`Q` is closed, and (ii) along `φ` persists along `φ ∘ ψ`)
  have hwQ : w ∈ (Q : Set (Euclid P)) :=
    Submission.idtp_cse_etp_rescaled_limit_mem P μ Q a w m (fun j => dist (xs (φ (ψ j))) a)
      (fun j => (dist (xs (φ (ψ j))) a)⁻¹ • (xs (φ (ψ j)) - a))
      (Submodule.closed_of_finiteDimensional Q) hfin (fun _ => hpos _) hw
      (fun g hg hgc => (hV g hg hgc).comp hψ.tendsto_atTop)
      (fun r hr => Eventually.of_forall fun j => by
        rw [hcenter j]
        exact hlow _ (hxZ _) _ (mul_pos (hpos _) hr))
  -- but `|q(wⱼ)| = sⱼ⁻¹|q(xⱼ)| > ε` for every `j`, so `0 = |q(w)| ≥ ε`
  have hq : ∀ j, ε < ‖(dist (xs (φ (ψ j))) a)⁻¹ • (xs (φ (ψ j)) - a) -
      Q.starProjection ((dist (xs (φ (ψ j))) a)⁻¹ • (xs (φ (ψ j)) - a))‖ := by
    intro j
    rw [map_smul, map_sub, hπa, ← smul_sub, sub_sub_sub_cancel_right, norm_smul, norm_inv,
      Real.norm_eq_abs, abs_of_pos (hpos _), lt_inv_mul_iff₀ (hpos _), mul_comm]
    exact hxq _
  have hqlim : Tendsto (fun j => ‖(dist (xs (φ (ψ j))) a)⁻¹ • (xs (φ (ψ j)) - a) -
      Q.starProjection ((dist (xs (φ (ψ j))) a)⁻¹ • (xs (φ (ψ j)) - a))‖) atTop
      (𝓝 ‖w - Q.starProjection w‖) :=
    ((continuous_id.sub Q.starProjection.continuous).norm.tendsto w).comp hw
  have hge := ge_of_tendsto' hqlim fun j => (hq j).le
  rw [Submodule.starProjection_eq_self_iff.2 hwQ, sub_self, norm_zero] at hge
  exact absurd hε (not_lt.2 hge)
/-- **Orthogonal projection onto a 2-plane in an orthonormal frame.**  If `Q ⊆ ℝᴾ` has dimension
`2` and `a, e ∈ Q` are orthonormal, then `π_Q x = ⟨x, a⟩a + ⟨x, e⟩e` for every `x`.  The family
`(a, e)` is orthonormal, hence linearly independent, so `span {a, e} ≤ Q` has dimension `2` and
equals `Q`.  The candidate `y = ⟨x, a⟩a + ⟨x, e⟩e` lies in `Q`, and `⟨x − y, a⟩ = ⟨x − y, e⟩ = 0`,
so `x − y` is orthogonal to every `w = c₀a + c₁e ∈ Q`; the orthogonal projection is the unique
point of `Q` with this property. -/
theorem Submission.idtp_cse_etp_loc_frame_projection : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P), Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → ∀ x : Euclid P, Q.starProjection x = inner ℝ x a • a + inner ℝ x e • e := by
  intro P Q a e hQ ha he hna hne hae x
  have hea : inner ℝ e a = 0 := by rw [real_inner_comm]; exact hae
  have haa : inner ℝ a a = 1 := by rw [real_inner_self_eq_norm_sq, hna]; norm_num
  have hee : inner ℝ e e = 1 := by rw [real_inner_self_eq_norm_sq, hne]; norm_num
  -- Step 1: `![a, e]` is orthonormal, hence linearly independent
  have hon : Orthonormal ℝ ![a, e] := by
    rw [orthonormal_iff_ite]
    intro i j
    fin_cases i <;> fin_cases j <;> simp [hna, hne, hae, hea]
  -- Step 2: `span {a, e} ≤ Q` and both have dimension `2`, so `span {a, e} = Q`
  have hle : Submodule.span ℝ (range ![a, e]) ≤ Q := by
    rw [Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    fin_cases i
    · exact ha
    · exact he
  have hspan : Submodule.span ℝ (range ![a, e]) = Q :=
    Submodule.eq_of_le_of_finrank_eq hle
      (by rw [finrank_span_eq_card hon.linearIndependent, hQ]; simp)
  -- Step 5: `π_Q x` is the unique point `y ∈ Q` with `⟨x − y, w⟩ = 0` for all `w ∈ Q`
  apply Submodule.eq_starProjection_of_mem_of_inner_eq_zero
  -- Step 3: the candidate `y = ⟨x, a⟩a + ⟨x, e⟩e` lies in `Q`
  · exact Q.add_mem (Q.smul_mem _ ha) (Q.smul_mem _ he)
  -- Step 4: `w = c₀a + c₁e` and `⟨x − y, w⟩ = c₀⟨x − y, a⟩ + c₁⟨x − y, e⟩ = 0`
  · intro w hw
    rw [← hspan, Submodule.mem_span_range_iff_exists_fun] at hw
    obtain ⟨c, rfl⟩ := hw
    simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, inner_add_right,
      real_inner_smul_right, inner_sub_left, inner_add_left, real_inner_smul_left, haa, hee, hae,
      hea]
    ring

/-- **Distance to `a` in polar form near the frame `(a, e)`.**  Let `Q ⊆ ℝᴾ` have dimension `2`,
`a, e ∈ Q` be orthonormal and `π = π_Q`.  If `⟨x, a⟩ > 0`, then
`|x − a| ≤ ||x| − 1| + |arctan(⟨x, e⟩/⟨x, a⟩)| + η + η²` with `η = |x − πx|/|x|`.  With `r = |x|`,
`ρ = |πx|`, `x − a = (1 − r⁻¹)x + r⁻¹(x − πx) + (r⁻¹ − ρ⁻¹)πx + (ρ⁻¹πx − a)`.  The first two terms
have norms `|r − 1|` and `η`; Pythagoras gives `(ρ/r)² = 1 − η²`, so the third has norm
`1 − ρ/r ≤ η²`.  As `πx = ⟨x, a⟩a + ⟨x, e⟩e`, `cos f = ⟨x, a⟩/ρ` for `f = arctan(⟨x, e⟩/⟨x, a⟩)`
and `|ρ⁻¹πx − a|² = 2 − 2 cos f ≤ f²`. -/
theorem Submission.idtp_cse_etp_loc_dist_bound : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P), Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → ∀ x : Euclid P, 0 < inner ℝ x a → dist x a ≤ |‖x‖ - 1| + |Real.arctan (inner ℝ x e / inner ℝ x a)| + ‖x - Q.starProjection x‖ / ‖x‖ + (‖x - Q.starProjection x‖ / ‖x‖) ^ 2 := by
  intro P Q a e hQ ha he hna hne hae x hxa
  -- Step 1: `⟨x, a⟩ > 0 = ⟨0, a⟩`, so `x ≠ 0` and `r = |x| > 0`
  have hr0 : 0 < ‖x‖ := norm_pos_iff.2 fun hx0 => by
    rw [hx0, inner_zero_left] at hxa
    exact lt_irrefl _ hxa
  have hea : inner ℝ e a = (0 : ℝ) := by rw [real_inner_comm]; exact hae
  have haa : inner ℝ a a = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, hna]; norm_num
  have hee : inner ℝ e e = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, hne]; norm_num
  -- Step 2: the frame formula `πx = αa + βe`
  have hπ : Q.starProjection x = inner ℝ x a • a + inner ℝ x e • e :=
    Submission.idtp_cse_etp_loc_frame_projection P Q a e hQ ha he hna hne hae x
  -- Step 3: `πx ∈ Q` and `x − πx ⊥ Q`, so `⟨πx, x − πx⟩ = 0`
  have horth : inner ℝ (Q.starProjection x) (x - Q.starProjection x) = (0 : ℝ) := by
    rw [real_inner_comm]
    exact Submodule.starProjection_inner_eq_zero x _ (Q.starProjection_apply_mem x)
  generalize Q.starProjection x = p at hπ horth ⊢
  generalize inner ℝ x a = α at hxa hπ ⊢
  generalize inner ℝ x e = β at hπ ⊢
  -- `⟨πx, a⟩ = α` and `ρ² = α² + β² > 0`
  have hpa : inner ℝ p a = α := by
    rw [hπ, inner_add_left, real_inner_smul_left, real_inner_smul_left, haa, hea]
    ring
  have hap : inner ℝ a p = α := by rw [real_inner_comm, hpa]
  have hρsq : ‖p‖ ^ 2 = α ^ 2 + β ^ 2 := by
    rw [← real_inner_self_eq_norm_sq, hπ]
    simp only [inner_add_left, inner_add_right, real_inner_smul_left, real_inner_smul_right, haa,
      hee, hae, hea]
    ring
  have hρ0 : 0 < ‖p‖ := norm_pos_iff.2 fun hp0 => by
    rw [hp0, norm_zero] at hρsq
    nlinarith [sq_nonneg β]
  -- Step 3: Pythagoras `r² = ρ² + |x − πx|²`, so `ρ ≤ r`, `(ρ/r)² = 1 − η²` and `1 − ρ/r ≤ η²`
  have hpyth : ‖x‖ ^ 2 = ‖p‖ ^ 2 + ‖x - p‖ ^ 2 := by
    have h := norm_add_sq_eq_norm_sq_add_norm_sq_real horth
    rw [add_sub_cancel] at h
    rw [sq, sq, sq, h]
  have hρr : ‖p‖ ≤ ‖x‖ :=
    (pow_le_pow_iff_left₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).1
      (by rw [hpyth]; exact le_add_of_nonneg_right (sq_nonneg _))
  have hη2 : 1 - ‖p‖ / ‖x‖ ≤ (‖x - p‖ / ‖x‖) ^ 2 := by
    have ht0 : 0 ≤ ‖p‖ / ‖x‖ := div_nonneg (norm_nonneg _) (norm_nonneg _)
    have ht1 : ‖p‖ / ‖x‖ ≤ 1 := (div_le_one hr0).2 hρr
    have htsq : (‖p‖ / ‖x‖) ^ 2 = 1 - (‖x - p‖ / ‖x‖) ^ 2 := by
      rw [div_pow, div_pow, eq_sub_iff_add_eq, ← add_div, ← hpyth,
        div_self (pow_ne_zero 2 hr0.ne')]
    nlinarith [mul_le_mul_of_nonneg_left ht1 ht0]
  -- Step 4: `√(1 + (β/α)²) = ρ/α`, so `cos f = α/ρ`
  have hcos : Real.cos (Real.arctan (β / α)) = α / ‖p‖ := by
    have h : 1 + (β / α) ^ 2 = (‖p‖ / α) ^ 2 := by
      rw [div_pow, div_pow, hρsq, add_div, div_self (pow_ne_zero 2 hxa.ne')]
    rw [Real.cos_arctan, h, Real.sqrt_sq (div_nonneg (norm_nonneg _) hxa.le), one_div_div]
  -- Step 5: `x − a = (1 − r⁻¹)x + r⁻¹(x − πx) + (r⁻¹ − ρ⁻¹)πx + (ρ⁻¹πx − a)`
  have hdecomp : x - a = (1 - ‖x‖⁻¹) • x + ‖x‖⁻¹ • (x - p) + (‖x‖⁻¹ - ‖p‖⁻¹) • p +
      (‖p‖⁻¹ • p - a) := by
    module
  -- Step 6(a): `|(1 − r⁻¹)x| = |r − 1|`
  have h1 : ‖(1 - ‖x‖⁻¹) • x‖ = |‖x‖ - 1| := by
    have h : (1 - ‖x‖⁻¹) * ‖x‖ = ‖x‖ - 1 := by rw [sub_mul, one_mul, inv_mul_cancel₀ hr0.ne']
    rw [norm_smul, Real.norm_eq_abs, ← h, abs_mul, abs_norm]
  -- Step 6(b): `|r⁻¹(x − πx)| = η`
  have h2 : ‖‖x‖⁻¹ • (x - p)‖ = ‖x - p‖ / ‖x‖ := by
    rw [norm_smul, norm_inv, norm_norm, inv_mul_eq_div]
  -- Step 6(c): `|(r⁻¹ − ρ⁻¹)πx| = 1 − ρ/r ≤ η²`
  have h3 : ‖(‖x‖⁻¹ - ‖p‖⁻¹) • p‖ ≤ (‖x - p‖ / ‖x‖) ^ 2 := by
    have h : |‖x‖⁻¹ - ‖p‖⁻¹| * ‖p‖ = 1 - ‖p‖ / ‖x‖ := by
      rw [abs_of_nonpos (sub_nonpos.2 (inv_anti₀ hρ0 hρr)), neg_sub, sub_mul,
        inv_mul_cancel₀ hρ0.ne', inv_mul_eq_div]
    rw [norm_smul, Real.norm_eq_abs, h]
    exact hη2
  -- Step 6(d): `|ρ⁻¹πx − a|² = 2 − 2 cos f ≤ f²`
  have h4 : ‖‖p‖⁻¹ • p - a‖ ≤ |Real.arctan (β / α)| := by
    have hsq : ‖‖p‖⁻¹ • p - a‖ ^ 2 = 2 - 2 * (α / ‖p‖) := by
      rw [← real_inner_self_eq_norm_sq]
      simp only [inner_sub_left, inner_sub_right, real_inner_smul_left, real_inner_smul_right, hpa,
        hap, haa]
      rw [real_inner_self_eq_norm_sq]
      field_simp
      ring
    refine (pow_le_pow_iff_left₀ (norm_nonneg _) (abs_nonneg _) two_ne_zero).1 ?_
    rw [hsq, sq_abs, ← hcos]
    linarith [Real.one_sub_sq_div_two_le_cos (x := Real.arctan (β / α))]
  -- Step 7: the triangle inequality
  calc dist x a = ‖x - a‖ := dist_eq_norm x a
    _ = ‖(1 - ‖x‖⁻¹) • x + ‖x‖⁻¹ • (x - p) + (‖x‖⁻¹ - ‖p‖⁻¹) • p + (‖p‖⁻¹ • p - a)‖ := by
      rw [← hdecomp]
    _ ≤ ‖(1 - ‖x‖⁻¹) • x‖ + ‖‖x‖⁻¹ • (x - p)‖ + ‖(‖x‖⁻¹ - ‖p‖⁻¹) • p‖ + ‖‖p‖⁻¹ • p - a‖ :=
      norm_add₄_le
    _ ≤ |‖x‖ - 1| + |Real.arctan (β / α)| + ‖x - p‖ / ‖x‖ + (‖x - p‖ / ‖x‖) ^ 2 := by
      rw [h1, h2]
      linarith

/-- **Localization near the frame `(a, e)` from the cusp bound.**  Let `Q ⊆ ℝᴾ` have dimension `2`,
`a, e ∈ Q` be orthonormal, `π = π_Q`, and suppose `|x − πx| ≤ |x − a|/20` for `x ∈ Z` with
`|x − a| < s₁`.  Take `s₀ = min(1/4, s₁/6)`.  If `0 < s' ≤ s₀`, `x ∈ Z`, `⟨x, a⟩ > 0`,
`||x| − 1| < s'`, `|arctan(⟨x, e⟩/⟨x, a⟩)| < s'` and `|x − πx| ≤ 2s₀|x|`, then `|x| > 3/4` and
`η = |x − πx|/|x| ≤ 2s₀ ≤ 1/2`, so `η² ≤ η/2` and the polar distance bound gives
`|x − a| < 2s' + (3/2)η ≤ 5s₀ < s₁`.  The cusp bound then yields
`(3/4)η ≤ |x − πx| < s'/10 + (3/40)η`, i.e. `η < (4/27)s'`; hence `|x − πx| < (s'/4)|x|` and
`|x − a| < 2s' + (2/9)s' < 3s'`. -/
theorem Submission.idtp_cse_etp_localization : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (Z : Set (Euclid P)) (s₁ : ℝ), Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → 0 < s₁ → (∀ x ∈ Z, dist x a < s₁ → ‖x - Q.starProjection x‖ ≤ 1 / 20 * dist x a) → ∃ s₀ : ℝ, 0 < s₀ ∧ s₀ ≤ 1 / 4 ∧ (∀ s' : ℝ, 0 < s' → s' ≤ s₀ → ∀ x ∈ Z, 0 < inner ℝ x a → |‖x‖ - 1| < s' → |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' → ‖x - Q.starProjection x‖ ≤ 2 * s₀ * ‖x‖ → ‖x - Q.starProjection x‖ < s' / 4 * ‖x‖ ∧ dist x a < 3 * s') := by
  intro P Q a e Z s₁ hQ ha he hna hne hae hs₁ hcusp
  -- Step 1: `s₀ = min(1/4, s₁/6)`, so `0 < s₀ ≤ 1/4` and `6s₀ ≤ s₁`
  refine ⟨min (1 / 4) (s₁ / 6), lt_min (by norm_num) (by linarith), min_le_left _ _, ?_⟩
  intro s' hs' hs's₀ x hxZ hxa hr hf hq
  have hs₀4 : min (1 / 4 : ℝ) (s₁ / 6) ≤ 1 / 4 := min_le_left _ _
  have hs₀6 : min (1 / 4 : ℝ) (s₁ / 6) ≤ s₁ / 6 := min_le_right _ _
  generalize min (1 / 4 : ℝ) (s₁ / 6) = s₀ at hs₀4 hs₀6 hs's₀ hq
  -- Step 2: `|x| > 1 − s' ≥ 3/4`
  have hr34 : 3 / 4 < ‖x‖ := by linarith [(abs_lt.1 hr).1]
  have hr0 : 0 < ‖x‖ := by linarith
  -- Step 3: `η = |x − πx|/|x|` has `|x − πx| = η|x|` and `0 ≤ η ≤ 2s₀ ≤ 1/2`, so `η² ≤ η/2`
  have hqη : ‖x - Q.starProjection x‖ = ‖x - Q.starProjection x‖ / ‖x‖ * ‖x‖ :=
    (div_mul_cancel₀ _ hr0.ne').symm
  have hη0 : 0 ≤ ‖x - Q.starProjection x‖ / ‖x‖ := div_nonneg (norm_nonneg _) hr0.le
  have hη2s₀ : ‖x - Q.starProjection x‖ / ‖x‖ ≤ 2 * s₀ := (div_le_iff₀ hr0).2 hq
  -- Step 4: the polar distance bound `|x − a| ≤ ||x| − 1| + |f| + η + η²`
  have hd := Submission.idtp_cse_etp_loc_dist_bound P Q a e hQ ha he hna hne hae x hxa
  generalize ‖x - Q.starProjection x‖ / ‖x‖ = η at hqη hη0 hη2s₀ hd
  have hηsq : η ^ 2 ≤ η / 2 := by
    have hη12 : η ≤ 1 / 2 := by linarith
    nlinarith [mul_le_mul_of_nonneg_left hη12 hη0]
  -- Step 5: `|x − a| < 2s' + (3/2)η ≤ 5s₀ < s₁`
  have hdist : dist x a < 2 * s' + 3 / 2 * η := by linarith
  -- Step 6: the cusp bound `(3/4)η ≤ η|x| = |x − πx| ≤ |x − a|/20 < s'/10 + (3/40)η`, so
  -- `η < (4/27)s'`
  have hc := hcusp x hxZ (by linarith)
  rw [hqη] at hc ⊢
  have hη : η < 4 / 27 * s' := by nlinarith [mul_le_mul_of_nonneg_left hr34.le hη0]
  -- Step 7: `η|x| < (4/27)s'|x| ≤ (s'/4)|x|` and `|x − a| < 2s' + (2/9)s' < 3s'`
  exact ⟨by nlinarith [mul_lt_mul_of_pos_right hη hr0, mul_pos hs' hr0], by linarith⟩

/-- `t ↦ p + t v` is an isometry `ℝ → ℝᴾ` for a unit vector `v`. -/
theorem Submission.odc_line_isometry {P : ℕ} (p v : Euclid P) (hv : ‖v‖ = 1) :
    Isometry (fun t : ℝ => p + t • v) := by
  refine Isometry.of_dist_eq fun s t => ?_
  rw [dist_add_left, dist_eq_norm, ← sub_smul, norm_smul, hv, mul_one, Real.dist_eq,
    Real.norm_eq_abs]

theorem Submission.odc_line_measurableEmbedding {P : ℕ} (p v : Euclid P) (hv : ‖v‖ = 1) :
    MeasurableEmbedding (fun t : ℝ => p + t • v) :=
  (Submission.odc_line_isometry p v hv).isClosedEmbedding.measurableEmbedding

/-- `μHE[1] = volume` on `ℝ`. -/
theorem Submission.odc_muHE_one_real : (μHE[1] : Measure ℝ) = volume := by
  have h := InnerProductSpace.euclideanHausdorffMeasure_eq_volume (V := ℝ)
  rwa [Module.finrank_self] at h

theorem Submission.odc_line_map {P : ℕ} (p v : Euclid P) (hv : ‖v‖ = 1) :
    Measure.map (fun t : ℝ => p + t • v) volume =
      (μHE[1] : Measure (Euclid P)).restrict (range fun t : ℝ => p + t • v) := by
  rw [← Submission.odc_muHE_one_real]
  exact (Submission.odc_line_isometry p v hv).map_euclideanHausdorffMeasure

/-- `H¹⌞γ(I) = γ_#(ℒ¹⌞I)` for `γ(t) = p + t v`. -/
theorem Submission.odc_line_restrict {P : ℕ} (p v : Euclid P) (hv : ‖v‖ = 1) (I : Set ℝ) :
    (μHE[1] : Measure (Euclid P)).restrict ((fun t : ℝ => p + t • v) '' I) =
      Measure.map (fun t : ℝ => p + t • v) (volume.restrict I) := by
  have hγ := Submission.odc_line_measurableEmbedding p v hv
  have hinj := (Submission.odc_line_isometry p v hv).injective
  rw [← Measure.restrict_restrict_of_subset (image_subset_range _ _),
    ← Submission.odc_line_map p v hv, hγ.restrict_map, preimage_image_eq _ hinj]

theorem Submission.odc_line_measure_image {P : ℕ} (p v : Euclid P) (hv : ‖v‖ = 1) (I : Set ℝ) :
    (μHE[1] : Measure (Euclid P)) ((fun t : ℝ => p + t • v) '' I) = volume I := by
  rw [(Submission.odc_line_isometry p v hv).euclideanHausdorffMeasure_image,
    Submission.odc_muHE_one_real]

theorem Submission.odc_line_integral {P : ℕ} (p v : Euclid P) (hv : ‖v‖ = 1) (I : Set ℝ)
    {G : Type*} [NormedAddCommGroup G] [NormedSpace ℝ G] (F : Euclid P → G) :
    ∫ x in (fun t : ℝ => p + t • v) '' I, F x ∂μHE[1] = ∫ t in I, F (p + t • v) := by
  rw [Submission.odc_line_restrict p v hv I,
    (Submission.odc_line_measurableEmbedding p v hv).integral_map]

theorem Submission.odc_line_lintegral {P : ℕ} (p v : Euclid P) (hv : ‖v‖ = 1) (I : Set ℝ)
    (F : Euclid P → ℝ≥0∞) :
    ∫⁻ x in (fun t : ℝ => p + t • v) '' I, F x ∂μHE[1] = ∫⁻ t in I, F (p + t • v) := by
  rw [Submission.odc_line_restrict p v hv I,
    (Submission.odc_line_measurableEmbedding p v hv).lintegral_map]

theorem Submission.odc_line_measurableSet_image {P : ℕ} (p v : Euclid P) (hv : ‖v‖ = 1)
    {I : Set ℝ} (hI : MeasurableSet I) :
    MeasurableSet ((fun t : ℝ => p + t • v) '' I) :=
  (Submission.odc_line_measurableEmbedding p v hv).measurableSet_image.2 hI

/-- A function locally integrable on `Ioi 0` times a continuous compactly supported function with
support in `Ioi 0` is integrable. -/
theorem Submission.odc_dubois_integrable {g ψ : ℝ → ℝ} (hg : LocallyIntegrableOn g (Ioi 0))
    (hψ : Continuous ψ) (hψc : HasCompactSupport ψ) (hψs : tsupport ψ ⊆ Ioi 0) :
    Integrable (fun t => g t * ψ t) := by
  rw [← integrableOn_iff_integrable_of_support_subset (s := tsupport ψ)]
  · exact (hg.integrableOn_compact_subset hψs hψc).mul_continuousOn hψ.continuousOn hψc
  · exact (support_mul_subset_right _ _).trans (subset_tsupport ψ)

/-- A smooth compactly supported function with support in `Ioi 0` and zero integral is the
derivative of a smooth compactly supported function with support in `Ioi 0`. -/
theorem Submission.odc_dubois_primitive {f : ℝ → ℝ} (hf : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) f)
    (hfc : HasCompactSupport f) (hfs : tsupport f ⊆ Ioi 0) (hf0 : ∫ t, f t = 0) :
    ∃ Ψ : ℝ → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) Ψ ∧ HasCompactSupport Ψ ∧
      tsupport Ψ ⊆ Ioi 0 ∧ deriv Ψ = f := by
  obtain ⟨α, hα, hαf⟩ := hfc.isCompact.exists_forall_le' continuousOn_id fun x hx => hfs hx
  obtain ⟨β, hβ⟩ := hfc.isCompact.bddAbove
  have hderiv : ∀ t, HasDerivAt (fun u => ∫ x in (0 : ℝ)..u, f x) (f t) t :=
    fun t => (hf.continuous.integral_hasStrictDerivAt 0 t).hasDerivAt
  have hd : deriv (fun u => ∫ x in (0 : ℝ)..u, f x) = f := funext fun t => (hderiv t).deriv
  -- the primitive vanishes outside `[α, β]`
  have hvan : ∀ t ∉ Icc α β, ∫ x in (0 : ℝ)..t, f x = 0 := by
    intro t ht
    by_cases htα : t < α
    · rw [intervalIntegral.integral_congr (g := fun _ => (0 : ℝ)), intervalIntegral.integral_zero]
      intro x hx
      refine image_eq_zero_of_notMem_tsupport fun hxs => ?_
      rw [uIcc, mem_Icc] at hx
      exact (hαf x hxs).not_gt (hx.2.trans_lt (max_lt hα htα))
    · have hβt : β < t := not_le.1 fun h' => ht ⟨not_lt.1 htα, h'⟩
      rw [intervalIntegral.integral_of_le (hα.le.trans (not_lt.1 htα)),
        setIntegral_eq_integral_of_forall_compl_eq_zero, hf0]
      intro x hx
      exact image_eq_zero_of_notMem_tsupport fun hxs => hx ⟨hfs hxs, (hβ hxs).trans hβt.le⟩
  refine ⟨fun u => ∫ x in (0 : ℝ)..u, f x, ?_, HasCompactSupport.intro isCompact_Icc hvan,
    ?_, hd⟩
  · exact contDiff_infty_iff_deriv.2 ⟨fun t => (hderiv t).differentiableAt, by rwa [hd]⟩
  · exact (closure_minimal (support_subset_iff'.2 hvan) isClosed_Icc).trans
      fun x hx => hα.trans_le hx.1

/-- One-dimensional constancy (du Bois-Reymond). -/
theorem Submission.odc_du_bois_reymond (g : ℝ → ℝ) (hg : LocallyIntegrableOn g (Ioi 0))
    (h : ∀ φ : ℝ → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) φ → HasCompactSupport φ →
      tsupport φ ⊆ Ioi 0 → ∫ t in Ioi (0 : ℝ), g t * deriv φ t = 0) :
    ∃ c : ℝ, ∀ᵐ t ∂(volume.restrict (Ioi (0 : ℝ))), g t = c := by
  -- a fixed bump function `b` supported in `[1/2, 3/2]`
  obtain ⟨b, hb⟩ : ∃ b : ContDiffBump (1 : ℝ), b.rOut = 1 / 2 :=
    ⟨⟨1 / 4, 1 / 2, by norm_num, by norm_num⟩, rfl⟩
  have hbs : tsupport b ⊆ Ioi 0 := by
    rw [b.tsupport_eq, hb, Real.closedBall_eq_Icc]
    exact fun x hx => show (0 : ℝ) < x by linarith [hx.1]
  have hI : 0 < ∫ t, b t :=
    b.continuous.integral_pos_of_hasCompactSupport_nonneg_nonzero (μ := volume)
      b.hasCompactSupport (fun x => b.nonneg' x) (x := 1)
      (by rw [b.one_of_mem_closedBall (mem_closedBall_self b.rIn_pos.le)]; exact one_ne_zero)
  have hbi := b.continuous.integrable_of_hasCompactSupport (μ := volume) b.hasCompactSupport
  have hgb := Submission.odc_dubois_integrable hg b.continuous b.hasCompactSupport hbs
  -- `g` annihilates test functions of zero integral
  have key : ∀ φ : ℝ → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) φ → HasCompactSupport φ →
      tsupport φ ⊆ Ioi 0 → ∫ t, φ t = 0 → ∫ t, g t * φ t = 0 := by
    intro φ hφ hφc hφs hφ0
    obtain ⟨Ψ, hΨ, hΨc, hΨs, rfl⟩ := Submission.odc_dubois_primitive hφ hφc hφs hφ0
    rw [← setIntegral_eq_integral_of_forall_compl_eq_zero (s := Ioi 0)]
    · exact h Ψ hΨ hΨc hΨs
    · intro x hx
      rw [image_eq_zero_of_notMem_tsupport (fun h' => hx (hφs h')), mul_zero]
  refine ⟨(∫ t, g t * b t) / ∫ t, b t, ?_⟩
  have hU := isOpen_Ioi.ae_eq_zero_of_integral_contDiff_smul_eq_zero (μ := volume)
    (f := fun t => g t - (∫ t, g t * b t) / ∫ t, b t) (hg.sub (locallyIntegrableOn_const _)) ?_
  · exact (ae_restrict_iff' measurableSet_Ioi).2 (hU.mono fun t ht ht' => sub_eq_zero.1 (ht ht'))
  intro ψ hψ hψc hψs
  have hψi := hψ.continuous.integrable_of_hasCompactSupport (μ := volume) hψc
  have hgψ := Submission.odc_dubois_integrable hg hψ.continuous hψc hψs
  set a := (∫ t, ψ t) / ∫ t, b t with ha
  have hs : tsupport (fun t => ψ t - a * b t) ⊆ Ioi 0 := by
    refine (closure_minimal (support_subset_iff'.2 fun x hx => ?_)
      ((isClosed_tsupport ψ).union (isClosed_tsupport b))).trans (union_subset hψs hbs)
    simp only [mem_union, not_or] at hx
    simp [image_eq_zero_of_notMem_tsupport hx.1, image_eq_zero_of_notMem_tsupport hx.2]
  have H : ∫ t, g t * (ψ t - a * b t) = 0 :=
    key _ (hψ.sub (contDiff_const.mul b.contDiff)) (hψc.sub b.hasCompactSupport.mul_left) hs
      (by rw [integral_sub hψi (hbi.const_mul a), integral_const_mul, ha,
        div_mul_cancel₀ _ hI.ne', sub_self])
  have e1 : (fun t => g t * (ψ t - a * b t)) = fun t => g t * ψ t - a * (g t * b t) := by
    funext t; ring
  have e2 : (fun t => ψ t • (g t - (∫ t, g t * b t) / ∫ t, b t)) =
      fun t => g t * ψ t - (∫ t, g t * b t) / (∫ t, b t) * ψ t := by
    funext t; rw [smul_eq_mul]; ring
  rw [e1, integral_sub hgψ (hgb.const_mul a), integral_const_mul] at H
  rw [e2, integral_sub hgψ (hψi.const_mul _), integral_const_mul, ← H, ha]
  ring

/-- Scaling a ball by a factor `c > 0` multiplies its measure by `c`. -/
theorem Submission.odc_finiterays_ball_smul {P : ℕ} (μ : Measure (Euclid P))
    (hscale : ∀ lam : ℝ, 0 < lam → ∀ W : Set (Euclid P), IsOpen W →
      μ ((fun x => lam • x) '' W) = ENNReal.ofReal lam * μ W)
    {c : ℝ} (hc : 0 < c) (x : Euclid P) (r : ℝ) :
    μ (ball (c • x) (c * r)) = ENNReal.ofReal c * μ (ball x r) := by
  rw [← hscale c hc _ isOpen_ball, image_smul, smul_ball hc.ne', Real.norm_of_nonneg hc.le]

/-- For an open cone `K`, `μ (K ∩ B_r(0)) = r μ (K ∩ B_1(0))`. -/
theorem Submission.odc_finiterays_cone_inter_ball {P : ℕ} (μ : Measure (Euclid P))
    (hscale : ∀ lam : ℝ, 0 < lam → ∀ W : Set (Euclid P), IsOpen W →
      μ ((fun x => lam • x) '' W) = ENNReal.ofReal lam * μ W)
    {K : Set (Euclid P)} (hK : IsOpen K) (hcone : ∀ c : ℝ, 0 < c → ∀ x ∈ K, c • x ∈ K)
    {r : ℝ} (hr : 0 < r) :
    μ (K ∩ ball 0 r) = ENNReal.ofReal r * μ (K ∩ ball 0 1) := by
  rw [← hscale r hr _ (hK.inter isOpen_ball)]
  congr 1
  ext y
  constructor
  · rintro ⟨hyK, hyr⟩
    refine ⟨r⁻¹ • y, ⟨hcone _ (inv_pos.2 hr) y hyK, ?_⟩, smul_inv_smul₀ hr.ne' y⟩
    rw [mem_ball_zero_iff] at hyr ⊢
    rw [norm_smul, Real.norm_of_nonneg (inv_pos.2 hr).le, inv_mul_lt_iff₀ hr, mul_one]
    exact hyr
  · rintro ⟨x, ⟨hxK, hx1⟩, rfl⟩
    refine ⟨hcone r hr x hxK, ?_⟩
    rw [mem_ball_zero_iff] at hx1 ⊢
    rw [norm_smul, Real.norm_of_nonneg hr.le]
    exact mul_lt_of_lt_one_right hr hx1

/-- Cones of aperture `ρ ≤ 1` around the rays through `2ρ`-separated unit vectors are
disjoint. -/
theorem Submission.odc_finiterays_cone_disjoint {P : ℕ} {σ σ' x : Euclid P} {ρ t s : ℝ}
    (hσ : ‖σ‖ = 1) (hσ' : ‖σ'‖ = 1) (hρ0 : 0 < ρ) (hρ1 : ρ ≤ 1) (hsep : 2 * ρ ≤ ‖σ - σ'‖)
    (ht : 0 < t) (hs : 0 < s) (hx : ‖x - t • σ‖ < t * ρ) (hx' : ‖x - s • σ'‖ < s * ρ) :
    False := by
  have h1 : ‖t • σ - s • σ'‖ < (t + s) * ρ :=
    calc ‖t • σ - s • σ'‖ = ‖(x - s • σ') - (x - t • σ)‖ := by congr 1; abel
      _ ≤ ‖x - s • σ'‖ + ‖x - t • σ‖ := norm_sub_le _ _
      _ < s * ρ + t * ρ := add_lt_add hx' hx
      _ = (t + s) * ρ := by ring
  have h2 : ‖t • σ - s • σ'‖ ^ 2 = (t - s) ^ 2 + t * s * ‖σ - σ'‖ ^ 2 := by
    rw [norm_sub_sq_real, norm_sub_sq_real, norm_smul, norm_smul, inner_smul_left,
      inner_smul_right, hσ, hσ', Real.norm_of_nonneg ht.le, Real.norm_of_nonneg hs.le]
    simp only [conj_trivial]
    ring
  have e1 : (t - s) ^ 2 * ρ ^ 2 ≤ (t - s) ^ 2 :=
    mul_le_of_le_one_right (sq_nonneg _) (by nlinarith)
  have e2 : t * s * (4 * ρ ^ 2) ≤ t * s * ‖σ - σ'‖ ^ 2 :=
    mul_le_mul_of_nonneg_left (by nlinarith) (by positivity)
  nlinarith [norm_nonneg (t • σ - s • σ')]

/-- If `ρ ≤ μ (B_ρ(σ))` for a unit vector `σ` and `0 < ρ < 1`, then the cone of aperture `ρ`
around the ray through `σ` has measure at least `1/2` in the unit ball. -/
theorem Submission.odc_finiterays_one_le_two_mul {P : ℕ} (μ : Measure (Euclid P))
    (hscale : ∀ lam : ℝ, 0 < lam → ∀ W : Set (Euclid P), IsOpen W →
      μ ((fun x => lam • x) '' W) = ENNReal.ofReal lam * μ W)
    (hfin : μ (ball 0 1) ≠ ∞) {σ : Euclid P} (hσ : ‖σ‖ = 1) {ρ : ℝ} (hρ0 : 0 < ρ)
    (hρ1 : ρ < 1) (hdens : ENNReal.ofReal ρ ≤ μ (ball σ ρ)) :
    1 ≤ 2 * μ ((⋃ (t : ℝ) (_ : 0 < t), ball (t • σ) (t * ρ)) ∩ ball 0 1) := by
  set K := ⋃ (t : ℝ) (_ : 0 < t), ball (t • σ) (t * ρ)
  have hK : IsOpen K := isOpen_iUnion fun t => isOpen_iUnion fun _ => isOpen_ball
  have hcone : ∀ c : ℝ, 0 < c → ∀ x ∈ K, c • x ∈ K := by
    intro c hc x hx
    obtain ⟨t, ht, hx⟩ := mem_iUnion₂.1 hx
    refine mem_iUnion₂.2 ⟨c * t, mul_pos hc ht, ?_⟩
    rw [mem_ball, mul_smul, dist_smul₀, Real.norm_of_nonneg hc.le, mul_assoc]
    exact mul_lt_mul_of_pos_left hx hc
  have hscaleK := fun r (hr : 0 < r) =>
    Submission.odc_finiterays_cone_inter_ball μ hscale hK hcone hr
  -- `B_ρ(σ)` and `K ∩ B_{1-ρ}(0)` are disjoint subsets of `K ∩ B_{1+ρ}(0)`
  have hsub : ball σ ρ ∪ (K ∩ ball 0 (1 - ρ)) ⊆ K ∩ ball 0 (1 + ρ) := by
    refine union_subset (fun x hx => ⟨mem_iUnion₂.2 ⟨1, one_pos, by simpa using hx⟩, ?_⟩)
      (inter_subset_inter_right _ (ball_subset_ball (by linarith)))
    rw [mem_ball, dist_eq_norm] at hx
    rw [mem_ball_zero_iff]
    calc ‖x‖ = ‖(x - σ) + σ‖ := by rw [sub_add_cancel]
      _ ≤ ‖x - σ‖ + ‖σ‖ := norm_add_le _ _
      _ < 1 + ρ := by rw [hσ]; linarith
  have hdisj : Disjoint (ball σ ρ) (K ∩ ball 0 (1 - ρ)) := by
    refine disjoint_left.2 fun x hx hx' => ?_
    rw [mem_ball, dist_eq_norm] at hx
    have h1 := mem_ball_zero_iff.1 hx'.2
    have h2 : ‖σ‖ ≤ ‖x - σ‖ + ‖x‖ := by
      rw [norm_sub_rev]
      calc ‖σ‖ = ‖(σ - x) + x‖ := by rw [sub_add_cancel]
        _ ≤ ‖σ - x‖ + ‖x‖ := norm_add_le _ _
    rw [hσ] at h2
    linarith
  have key := measure_mono (μ := μ) hsub
  rw [measure_union hdisj (hK.inter isOpen_ball).measurableSet, hscaleK (1 - ρ) (by linarith),
    hscaleK (1 + ρ) (by linarith)] at key
  have key' := (add_le_add hdens le_rfl).trans key
  have ha : μ (K ∩ ball 0 1) ≠ ∞ := ne_top_of_le_ne_top hfin (measure_mono inter_subset_right)
  rw [← ENNReal.ofReal_toReal ha] at key' ⊢
  set a := (μ (K ∩ ball 0 1)).toReal
  have ha0 : 0 ≤ a := ENNReal.toReal_nonneg
  rw [← ENNReal.ofReal_mul (by linarith), ← ENNReal.ofReal_mul (by linarith),
    ← ENNReal.ofReal_add hρ0.le (by nlinarith), ENNReal.ofReal_le_ofReal_iff (by positivity)]
    at key'
  rw [← ENNReal.ofReal_ofNat 2, ← ENNReal.ofReal_mul (by norm_num), ← ENNReal.ofReal_one]
  exact ENNReal.ofReal_le_ofReal (by nlinarith)

/-- Any finite set of unit vectors in the support of `μ` has at most `2 μ(B_1(0))` elements. -/
theorem Submission.odc_finiterays_card_le {P : ℕ} (μ : Measure (Euclid P))
    (hfin : μ (ball 0 1) ≠ ∞)
    (hscale : ∀ lam : ℝ, 0 < lam → ∀ W : Set (Euclid P), IsOpen W →
      μ ((fun x => lam • x) '' W) = ENNReal.ofReal lam * μ W)
    (hdens : ∀ x : Euclid P, (∀ ε : ℝ, 0 < ε → μ (ball x ε) ≠ 0) →
      ∀ᶠ ρ in 𝓝[>] (0 : ℝ), ENNReal.ofReal ρ ≤ μ (ball x ρ))
    (T : Finset (Euclid P)) (hT : ∀ σ ∈ T, ‖σ‖ = 1 ∧ ∀ ε : ℝ, 0 < ε → μ (ball σ ε) ≠ 0) :
    (T.card : ℝ≥0∞) ≤ 2 * μ (ball 0 1) := by
  have h1 : ∀ᶠ ρ in 𝓝[>] (0 : ℝ), ∀ σ ∈ T, ENNReal.ofReal ρ ≤ μ (ball σ ρ) :=
    (eventually_all_finset T).2 fun σ hσ => hdens σ (hT σ hσ).2
  have h2 : ∀ᶠ ρ in 𝓝[>] (0 : ℝ), ∀ σ ∈ T, ∀ σ' ∈ T, σ ≠ σ' → 2 * ρ ≤ ‖σ - σ'‖ := by
    refine (eventually_all_finset T).2 fun σ _ => (eventually_all_finset T).2 fun σ' _ => ?_
    rcases eq_or_ne σ σ' with h | h
    · exact Eventually.of_forall fun _ h' => absurd h h'
    · filter_upwards [Ioo_mem_nhdsGT (half_pos (norm_pos_iff.2 (sub_ne_zero.2 h)))]
        with ρ hρ _
      linarith [hρ.2]
  obtain ⟨ρ, h1ρ, h2ρ, hρ⟩ := (h1.and (h2.and (Ioo_mem_nhdsGT zero_lt_one))).exists
  set K : Euclid P → Set (Euclid P) :=
    fun σ => (⋃ (t : ℝ) (_ : 0 < t), ball (t • σ) (t * ρ)) ∩ ball 0 1
  have hdisj : (T : Set (Euclid P)).PairwiseDisjoint K := by
    intro σ hσ σ' hσ' hne
    refine disjoint_left.2 fun x hx hx' => ?_
    obtain ⟨t, ht, hxt⟩ := mem_iUnion₂.1 hx.1
    obtain ⟨s, hs, hxs⟩ := mem_iUnion₂.1 hx'.1
    rw [mem_ball, dist_eq_norm] at hxt hxs
    exact Submission.odc_finiterays_cone_disjoint (hT σ hσ).1 (hT σ' hσ').1 hρ.1 hρ.2.le
      (h2ρ σ hσ σ' hσ' hne) ht hs hxt hxs
  have hmeas : ∀ σ ∈ T, MeasurableSet (K σ) := fun σ _ =>
    ((isOpen_iUnion fun t => isOpen_iUnion fun _ => isOpen_ball).inter isOpen_ball).measurableSet
  calc (T.card : ℝ≥0∞) = ∑ σ ∈ T, 1 := by simp
    _ ≤ ∑ σ ∈ T, 2 * μ (K σ) := Finset.sum_le_sum fun σ hσ =>
        Submission.odc_finiterays_one_le_two_mul μ hscale hfin (hT σ hσ).1 hρ.1 hρ.2 (h1ρ σ hσ)
    _ = 2 * μ (⋃ σ ∈ T, K σ) := by rw [measure_biUnion_finset hdisj hmeas, Finset.mul_sum]
    _ ≤ 2 * μ (ball 0 1) := by
        gcongr
        exact iUnion₂_subset fun σ _ => inter_subset_right

/-- A 1-homogeneous measure that is finite on the unit ball has no atom at the origin. -/
theorem Submission.odc_finiterays_measure_zero {P : ℕ} (μ : Measure (Euclid P))
    (hfin : μ (ball 0 1) ≠ ∞)
    (hscale : ∀ lam : ℝ, 0 < lam → ∀ W : Set (Euclid P), IsOpen W →
      μ ((fun x => lam • x) '' W) = ENNReal.ofReal lam * μ W) :
    μ {0} = 0 := by
  have h : Tendsto (fun r : ℝ => ENNReal.ofReal r * μ (ball 0 1)) (𝓝[>] 0) (𝓝 0) := by
    have h0 : Tendsto (fun r : ℝ => ENNReal.ofReal r) (𝓝[>] 0) (𝓝 0) := by
      simpa using (ENNReal.tendsto_ofReal (tendsto_id (x := 𝓝 (0 : ℝ)))).mono_left
        nhdsWithin_le_nhds
    simpa using ENNReal.Tendsto.mul_const h0 (Or.inr hfin)
  refine le_zero_iff.1 (ge_of_tendsto h ?_)
  filter_upwards [self_mem_nhdsWithin] with r hr
  have := Submission.odc_finiterays_ball_smul μ hscale hr 0 1
  rw [smul_zero, mul_one] at this
  rw [← this]
  exact measure_mono (singleton_subset_iff.2 (mem_ball_self hr))

/-- A 1-homogeneous locally finite measure with density bounded below on its support lives on
finitely many open rays. -/
theorem Submission.odc_finite_rays {P : ℕ} (μ : Measure (Euclid P))
    (hfin : ∀ K : Set (Euclid P), IsCompact K → μ K ≠ ∞)
    (hscale : ∀ lam : ℝ, 0 < lam → ∀ W : Set (Euclid P), IsOpen W →
      μ ((fun x => lam • x) '' W) = ENNReal.ofReal lam * μ W)
    (hdens : ∀ x : Euclid P, (∀ ε : ℝ, 0 < ε → μ (ball x ε) ≠ 0) →
      ∀ᶠ ρ in 𝓝[>] (0 : ℝ), ENNReal.ofReal ρ ≤ μ (ball x ρ)) :
    ∃ F : Finset (Euclid P), (∀ e ∈ F, ‖e‖ = 1) ∧
      μ ((⋃ e ∈ F, (fun t : ℝ => t • e) '' Ioi 0)ᶜ) = 0 := by
  have hB : μ (ball (0 : Euclid P) 1) ≠ ∞ :=
    ne_top_of_le_ne_top (hfin _ (isCompact_closedBall 0 1)) (measure_mono ball_subset_closedBall)
  set S := {x : Euclid P | ∀ ε : ℝ, 0 < ε → μ (ball x ε) ≠ 0}
  -- the unit vectors in the support of `μ` form a finite set
  have hU : {σ : Euclid P | ‖σ‖ = 1 ∧ σ ∈ S}.Finite := by
    by_contra h
    have h2 : (2 : ℝ≥0∞) * μ (ball 0 1) ≠ ∞ := ENNReal.mul_ne_top (by norm_num) hB
    obtain ⟨n, hn⟩ := ENNReal.exists_nat_gt h2
    obtain ⟨T, hTsub, hTcard⟩ := Set.Infinite.exists_subset_card_eq h n
    have := Submission.odc_finiterays_card_le μ hB hscale hdens T fun σ hσ => hTsub hσ
    rw [hTcard] at this
    exact lt_irrefl _ (this.trans_lt hn)
  refine ⟨hU.toFinset, fun e he => (hU.mem_toFinset.1 he).1, ?_⟩
  -- the complement of the rays lies in `{0} ∪ Sᶜ`
  have hsub : (⋃ e ∈ hU.toFinset, (fun t : ℝ => t • e) '' Ioi 0)ᶜ ⊆ {0} ∪ Sᶜ := by
    intro x hx
    by_contra hx'
    simp only [mem_union, mem_singleton_iff, mem_compl_iff, not_or, not_not] at hx'
    obtain ⟨hx0, hxS⟩ := hx'
    have hn : 0 < ‖x‖ := norm_pos_iff.2 hx0
    refine hx (mem_iUnion₂.2 ⟨‖x‖⁻¹ • x, hU.mem_toFinset.2 ⟨?_, ?_⟩, ‖x‖, hn, ?_⟩)
    · rw [norm_smul, Real.norm_of_nonneg (inv_pos.2 hn).le, inv_mul_cancel₀ hn.ne']
    · intro ε hε
      have := Submission.odc_finiterays_ball_smul μ hscale (inv_pos.2 hn) x (‖x‖ * ε)
      rw [← mul_assoc, inv_mul_cancel₀ hn.ne', one_mul] at this
      rw [this]
      exact mul_ne_zero (ENNReal.ofReal_pos.2 (inv_pos.2 hn)).ne' (hxS _ (mul_pos hn hε))
    · exact smul_inv_smul₀ hn.ne' x
  refine measure_mono_null hsub
    (measure_union_null (Submission.odc_finiterays_measure_zero μ hB hscale) ?_)
  refine measure_null_of_locally_null _ fun x hx => ?_
  simp only [S, mem_compl_iff, mem_ofPred_eq, not_forall, not_not, exists_prop] at hx
  obtain ⟨ε, hε, h0⟩ := hx
  exact ⟨ball x ε, mem_nhdsWithin_of_mem_nhds (ball_mem_nhds x hε), h0⟩

/-- For `r ≠ 0`, the blow-up `η_{x,r}(M)` is the preimage of `M` under `y ↦ x + r y`. -/
theorem Submission.odc_tangent_blowUp_image_eq {P : ℕ} (M : Set (Euclid P)) (x : Euclid P)
    {r : ℝ} (hr : r ≠ 0) :
    Poincare.SimonGMT.Chapter03.blowUpMap x r '' M = (fun y => x + r • y) ⁻¹' M := by
  ext y
  constructor
  · rintro ⟨z, hz, rfl⟩
    simpa [Poincare.SimonGMT.Chapter03.blowUpMap, smul_smul, hr] using hz
  · intro hy
    exact ⟨_, hy, by simp [Poincare.SimonGMT.Chapter03.blowUpMap, smul_smul, hr]⟩

/-- Blow-ups preserve `H¹`-null sets. -/
theorem Submission.odc_tangent_blowUp_null {P : ℕ} {N : Set (Euclid P)}
    (hN : (μHE[1] : Measure (Euclid P)) N = 0) (x : Euclid P) (r : ℝ) :
    (μHE[1] : Measure (Euclid P)) (Poincare.SimonGMT.Chapter03.blowUpMap x r '' N) = 0 := by
  have hlip : LipschitzWith ‖r⁻¹‖₊ (Poincare.SimonGMT.Chapter03.blowUpMap x r) :=
    LipschitzWith.of_dist_le_mul fun a b => by
      simp only [Poincare.SimonGMT.Chapter03.blowUpMap, dist_smul₀, dist_sub_right, coe_nnnorm,
        le_refl]
  refine nonpos_iff_eq_zero.1 ?_
  calc _ ≤ (‖r⁻¹‖₊ : ℝ≥0∞) ^ 1 * μHE[1] N :=
        Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn 1
          hlip.lipschitzOnWith
    _ = 0 := by rw [hN, mul_zero]

/-- `x + ρ y` lies on the line through `x` in direction `v` iff `y ∈ span {v}` (`ρ ≠ 0`). -/
theorem Submission.odc_tangent_mem_range_iff {P : ℕ} (x v y : Euclid P) {ρ : ℝ} (hρ : ρ ≠ 0) :
    x + ρ • y ∈ range (fun s : ℝ => x + s • v) ↔ y ∈ Submodule.span ℝ {v} := by
  simp only [mem_range, add_right_inj, Submodule.mem_span_singleton]
  constructor
  · rintro ⟨s, hs⟩
    exact ⟨ρ⁻¹ * s, by rw [mul_smul, hs, smul_smul, inv_mul_cancel₀ hρ, one_smul]⟩
  · rintro ⟨a, rfl⟩
    exact ⟨ρ * a, mul_smul _ _ _⟩

/-- A set that coincides near `x` with the line through `x` in direction `v` has that line
as approximate tangent space at `x`. -/
theorem Submission.odc_approxTangent_of_locally_line {P : ℕ} (M : Set (Euclid P))
    (hM : MeasurableSet M) (x v : Euclid P) (hv : v ≠ 0) (r : ℝ) (hr : 0 < r)
    (hloc : M ∩ ball x r = range (fun s : ℝ => x + s • v) ∩ ball x r) :
    HasApproximateTangentSpaceAt 1 M x (Submodule.span ℝ {v}) := by
  refine ⟨finrank_span_singleton hv, fun f => ?_⟩
  obtain ⟨R, hR0, hR⟩ :=
    f.hasCompactSupport.isCompact.isBounded.subset_closedBall_lt 0 (0 : Euclid P)
  refine tendsto_const_nhds.congr' ?_
  filter_upwards [Ioo_mem_nhdsGT (div_pos hr hR0)] with ρ ⟨hρ0, hρ⟩
  rw [lt_div_iff₀ hR0] at hρ
  -- for small `ρ`, the blow-up and the line agree on `closedBall 0 R ⊇ spt f`
  rw [Submission.odc_tangent_blowUp_image_eq M x hρ0.ne',
    ← integral_indicator (hM.preimage (by fun_prop)),
    ← integral_indicator (Submodule.closed_of_finiteDimensional _).measurableSet]
  congr 1
  ext y
  by_cases hy : y ∈ tsupport f
  · have hball : x + ρ • y ∈ ball x r := by
      rw [mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hρ0.le]
      exact (mul_le_mul_of_nonneg_left (mem_closedBall_zero_iff.1 (hR hy)) hρ0.le).trans_lt hρ
    have hiff : y ∈ (fun y => x + ρ • y) ⁻¹' M ↔ y ∈ Submodule.span ℝ {v} := by
      rw [mem_preimage, ← Submission.odc_tangent_mem_range_iff x v y hρ0.ne']
      simpa [hball] using Set.ext_iff.1 hloc (x + ρ • y)
    by_cases hyL : y ∈ Submodule.span ℝ {v}
    · rw [indicator_of_mem hyL, indicator_of_mem (hiff.2 hyL)]
    · rw [indicator_of_notMem hyL, indicator_of_notMem (mt hiff.1 hyL)]
  · have h0 : f y = 0 := image_eq_zero_of_notMem_tsupport hy
    rw [indicator_apply_eq_zero.2 fun _ => h0, indicator_apply_eq_zero.2 fun _ => h0]
/-- **Simon Ch. 4, 2.3** (tangential divergence of a rotation field): for the skew linear map
`A y = ⟨y, a⟩e − ⟨y, e⟩a` and `X = gA` with `g` differentiable at `x`,
`div_M X(x) = Dg(x)(p(Ax))`, `p = p_{TₓM}`.  The product rule gives `DX(x) = g(x)A + Dg(x)(·)Ax`,
so `p ∘ DX(x)` is a combination of the rank-one maps `u ↦ ⟨a, u⟩pe`, `u ↦ ⟨e, u⟩pa` and
`u ↦ Dg(x)(u)p(Ax)`, with traces `⟨a, pe⟩`, `⟨e, pa⟩` and `Dg(x)(p(Ax))`; `p` being
self-adjoint, `⟨a, pe⟩ = ⟨e, pa⟩`. -/
theorem Submission.idtp_cse_rc_rotation_divergence : ∀ (P n : ℕ) (M : Set (Euclid P)) (a e x : Euclid P) (g : Euclid P → ℝ), DifferentiableAt ℝ g x → tangentialDivergence n M (fun y : Euclid P => g y • (inner ℝ y a • e - inner ℝ y e • a)) x = fderiv ℝ g x ((approxTangentPlane n M x).starProjection (inner ℝ x a • e - inner ℝ x e • a)) := by
  intro P n M a e x g hg
  set p := (approxTangentPlane n M x).starProjection with hp
  -- `A y = ⟪y, a⟫ e − ⟪y, e⟫ a` is the continuous linear map `⟪a, ·⟫ e − ⟪e, ·⟫ a`
  set A : Euclid P →L[ℝ] Euclid P := (innerSL ℝ a).smulRight e - (innerSL ℝ e).smulRight a
    with hA
  have hAy : ∀ y, A y = inner ℝ y a • e - inner ℝ y e • a := fun y => by
    simp [A, real_inner_comm]
  have hX : (fun y : Euclid P => g y • (inner ℝ y a • e - inner ℝ y e • a)) =
      fun y => g y • A y := by
    funext y
    rw [hAy]
  -- product rule: `DX(x) = g(x) A + Dg(x)(·) Ax`
  have hD : fderiv ℝ (fun y => g y • A y) x = g x • A + (fderiv ℝ g x).smulRight (A x) := by
    rw [fderiv_fun_smul hg A.differentiableAt, A.fderiv]
  -- `p ∘ DX(x)` is a combination of rank-one maps
  have hdecomp : p.toLinearMap ∘ₗ (g x • A + (fderiv ℝ g x).smulRight (A x)).toLinearMap =
      g x • ((innerₛₗ ℝ a).smulRight (p e) - (innerₛₗ ℝ e).smulRight (p a)) +
        (fderiv ℝ g x).toLinearMap.smulRight (p (A x)) := by
    ext u
    simp [A, map_sub, map_smul]
  -- `trace (p ∘ A) = ⟪a, p e⟫ − ⟪e, p a⟫ = 0`, `p` being self-adjoint
  have hskew : inner ℝ a (p e) - inner ℝ e (p a) = 0 := by
    rw [hp, ← Submodule.inner_starProjection_left_eq_right, real_inner_comm, sub_self]
  -- `trace (z ↦ ℓ(z) v) = ℓ(v)` (`LinearMap.trace_smulRight`) for each rank-one term
  unfold tangentialDivergence
  rw [hX, hD, ← hp, hdecomp, map_add, map_smul, map_sub, LinearMap.trace_smulRight,
    LinearMap.trace_smulRight, LinearMap.trace_smulRight, innerₛₗ_apply_apply,
    innerₛₗ_apply_apply, hskew, smul_zero, zero_add, ContinuousLinearMap.coe_coe, hAy]
/-- **Conical `C¹` cutoff around a subspace** (step 4 of the parent proof).  With
`π = Q.starProjection` and `u(y) = ‖y − π y‖² / (s² ‖y‖²)`, take
`ζ(y) = smoothTransition((4/3)(1 − u(y)))`.  Off `0`, `u` is smooth, `‖x − π x‖ ≤ (s/2)‖x‖` gives
`u ≤ 1/4` and `ζ = 1`, `s‖x‖ ≤ ‖x − π x‖` gives `u ≥ 1` and `ζ = 0`, and `ζ` is constant near `x`
when either inequality is strict, so `Dζ(x) = 0` there. -/
theorem Submission.idtp_cse_rc_cone_cutoff : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (s : ℝ), 0 < s → ∃ ζ : Euclid P → ℝ, (∀ x : Euclid P, x ≠ 0 → ContDiffAt ℝ 1 ζ x) ∧ (∀ x : Euclid P, x ≠ 0 → ‖x - Q.starProjection x‖ ≤ s / 2 * ‖x‖ → ζ x = 1) ∧ (∀ x : Euclid P, x ≠ 0 → s * ‖x‖ ≤ ‖x - Q.starProjection x‖ → ζ x = 0) ∧ (∀ x : Euclid P, x ≠ 0 → (‖x - Q.starProjection x‖ < s / 2 * ‖x‖ ∨ s * ‖x‖ < ‖x - Q.starProjection x‖) → fderiv ℝ ζ x = 0) := by
  intro P Q s hs
  let ζ : Euclid P → ℝ := fun y =>
    Real.smoothTransition (4 / 3 * (1 - ‖y - Q.starProjection y‖ ^ 2 / (s ^ 2 * ‖y‖ ^ 2)))
  -- (b): `‖x − π x‖ ≤ (s/2)‖x‖` gives `u x ≤ 1/4`, so the argument of `smoothTransition` is `≥ 1`
  have h1 : ∀ x : Euclid P, x ≠ 0 → ‖x - Q.starProjection x‖ ≤ s / 2 * ‖x‖ → ζ x = 1 := by
    intro x hx hle
    have hd : 0 < s ^ 2 * ‖x‖ ^ 2 := mul_pos (pow_pos hs 2) (pow_pos (norm_pos_iff.2 hx) 2)
    have hu : ‖x - Q.starProjection x‖ ^ 2 / (s ^ 2 * ‖x‖ ^ 2) ≤ 1 / 4 := by
      rw [div_le_iff₀ hd]
      nlinarith [pow_le_pow_left₀ (norm_nonneg _) hle 2]
    exact Real.smoothTransition.one_of_one_le (by linarith)
  -- (c): `s‖x‖ ≤ ‖x − π x‖` gives `u x ≥ 1`, so the argument of `smoothTransition` is `≤ 0`
  have h0 : ∀ x : Euclid P, x ≠ 0 → s * ‖x‖ ≤ ‖x - Q.starProjection x‖ → ζ x = 0 := by
    intro x hx hle
    have hd : 0 < s ^ 2 * ‖x‖ ^ 2 := mul_pos (pow_pos hs 2) (pow_pos (norm_pos_iff.2 hx) 2)
    have hu : 1 ≤ ‖x - Q.starProjection x‖ ^ 2 / (s ^ 2 * ‖x‖ ^ 2) := by
      rw [le_div_iff₀ hd]
      nlinarith [pow_le_pow_left₀ (mul_nonneg hs.le (norm_nonneg x)) hle 2]
    exact Real.smoothTransition.zero_of_nonpos (by linarith)
  refine ⟨ζ, fun x hx => ?_, h1, h0, fun x hx hx' => ?_⟩
  · -- (a): `u` is smooth at `x ≠ 0` (the denominator `s² ‖x‖²` is nonzero)
    have hd : s ^ 2 * ‖x‖ ^ 2 ≠ 0 := (mul_pos (pow_pos hs 2) (pow_pos (norm_pos_iff.2 hx) 2)).ne'
    have hu : ContDiffAt ℝ 1
        (fun y : Euclid P => ‖y - Q.starProjection y‖ ^ 2 / (s ^ 2 * ‖y‖ ^ 2)) x :=
      ((contDiff_id.sub Q.starProjection.contDiff).norm_sq ℝ).contDiffAt.fun_div
        (contDiffAt_const.mul (contDiff_norm_sq ℝ).contDiffAt) hd
    exact (Real.smoothTransition.contDiffAt (n := 1)).comp x
      (contDiffAt_const.mul (contDiffAt_const.sub hu))
  · -- (d): `ζ` is constant on an open neighbourhood of `x`
    rcases hx' with hlt | hlt
    · have hV : IsOpen ({y : Euclid P | y ≠ 0} ∩ {y | ‖y - Q.starProjection y‖ < s / 2 * ‖y‖}) :=
        isOpen_ne.inter (isOpen_lt (by fun_prop) (by fun_prop))
      have hev : ζ =ᶠ[𝓝 x] fun _ => (1 : ℝ) := by
        filter_upwards [hV.mem_nhds ⟨hx, hlt⟩] with y hy
        exact h1 y hy.1 hy.2.le
      rw [hev.fderiv_eq, fderiv_const_apply]
    · -- the region `s‖y‖ < ‖y − π y‖` avoids `0`
      have hV : IsOpen {y : Euclid P | s * ‖y‖ < ‖y - Q.starProjection y‖} :=
        isOpen_lt (by fun_prop) (by fun_prop)
      have hev : ζ =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
        filter_upwards [hV.mem_nhds hlt] with y hy
        have hy0 : y ≠ 0 := by
          rintro rfl
          simp at hy
        exact h0 y hy0 hy.le
      rw [hev.fderiv_eq, fderiv_const_apply]
/-- **Orthogonal projection onto a 2-plane in an orthonormal frame** (the linear-algebra half of
the polar-angle differential `idtp_cse_rc_angle_fderiv`, used for Simon 7.3.3(1)).  If `a, e ∈ Q`
are orthonormal and `dim Q = 2`, then `π_Q y = ⟨y, a⟩ a + ⟨y, e⟩ e` and
`|π_Q y|² = ⟨y, a⟩² + ⟨y, e⟩²`.  The orthonormal pair `![a, e]` is independent, so it spans `Q`;
`y − (⟨y, a⟩ a + ⟨y, e⟩ e)` is orthogonal to `a` and `e`, hence to `Q`, and `π_Q y` is the unique
point of `Q` with this property. -/
theorem Submission.idtp_cse_rc_af_plane_projection : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P), Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → ∀ y : Euclid P, Q.starProjection y = inner ℝ y a • a + inner ℝ y e • e ∧ ‖Q.starProjection y‖ ^ 2 = inner ℝ y a ^ 2 + inner ℝ y e ^ 2 := by
  intro P Q a e hQ ha he ha1 he1 hae y
  -- `⟪a, a⟫ = ⟪e, e⟫ = 1` and `⟪a, e⟫ = ⟪e, a⟫ = 0`
  have haa : inner ℝ a a = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, ha1, one_pow]
  have hee : inner ℝ e e = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, he1, one_pow]
  have hea : inner ℝ e a = (0 : ℝ) := by rw [real_inner_comm, hae]
  -- `![a, e]` is orthonormal, hence linearly independent
  have hv : Orthonormal ℝ ![a, e] := by
    rw [orthonormal_iff_ite]
    simp only [Fin.forall_fin_two, Matrix.cons_val_zero, Matrix.cons_val_one, haa, hee, hae, hea]
    simp
  -- `span {a, e} = Q`: the span lies in `Q` and has the same dimension `2`
  have hrange : Set.range ![a, e] = {a, e} := Matrix.range_cons_cons_empty a e ![]
  have hspan : Submodule.span ℝ {a, e} = Q := by
    rw [← hrange]
    refine Submodule.eq_of_le_of_finrank_eq ?_ ?_
    · rw [Submodule.span_le, hrange, Set.insert_subset_iff, Set.singleton_subset_iff]
      exact ⟨ha, he⟩
    · rw [finrank_span_eq_card hv.linearIndependent, hQ, Fintype.card_fin]
  -- `w = ⟪y, a⟫ a + ⟪y, e⟫ e` lies in `Q`, and `y - w` is orthogonal to `a` and `e`
  have hwQ : inner ℝ y a • a + inner ℝ y e • e ∈ Q :=
    Q.add_mem (Q.smul_mem _ ha) (Q.smul_mem _ he)
  have hya : inner ℝ (y - (inner ℝ y a • a + inner ℝ y e • e)) a = (0 : ℝ) := by
    rw [inner_sub_left, inner_add_left, real_inner_smul_left, real_inner_smul_left, haa, hea]
    ring
  have hye : inner ℝ (y - (inner ℝ y a • a + inner ℝ y e • e)) e = (0 : ℝ) := by
    rw [inner_sub_left, inner_add_left, real_inner_smul_left, real_inner_smul_left, hae, hee]
    ring
  -- so `y - w` is orthogonal to `span {a, e} = Q` (the kernel of `⟪y - w, ·⟫`), and `π y = w`
  have hproj : Q.starProjection y = inner ℝ y a • a + inner ℝ y e • e := by
    refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero hwQ fun z hz => ?_
    have hK : Submodule.span ℝ {a, e} ≤
        LinearMap.ker (innerₛₗ ℝ (y - (inner ℝ y a • a + inner ℝ y e • e))) := by
      rw [Submodule.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
      exact ⟨by rw [SetLike.mem_coe, LinearMap.mem_ker, innerₛₗ_apply_apply, hya],
        by rw [SetLike.mem_coe, LinearMap.mem_ker, innerₛₗ_apply_apply, hye]⟩
    rw [← hspan] at hz
    have hz' := hK hz
    rwa [LinearMap.mem_ker, innerₛₗ_apply_apply] at hz'
  -- `‖π y‖² = ⟪w, w⟫ = ⟪y, a⟫² + ⟪y, e⟫²`
  refine ⟨hproj, ?_⟩
  rw [hproj, ← real_inner_self_eq_norm_sq, inner_add_left, inner_add_right, inner_add_right,
    real_inner_smul_left, real_inner_smul_left, real_inner_smul_left, real_inner_smul_left,
    real_inner_smul_right, real_inner_smul_right, real_inner_smul_right, real_inner_smul_right,
    haa, hee, hae, hea]
  ring
/-- **Differential of the polar angle `arctan (⟨y, e⟩ / ⟨y, a⟩)`** (the calculus step of the
rotation argument for cone sectors in Simon 7.3).  If `⟨x, a⟩ ≠ 0`, then
`f(y) = arctan (⟨y, e⟩ / ⟨y, a⟩)` is `C¹` near `x` and, for every `v`,
`Df(x) v = ⟨⟨x, a⟩ e - ⟨x, e⟩ a, v⟩ / (⟨x, a⟩² + ⟨x, e⟩²)`.
* `y ↦ ⟨y, a⟩ = innerSL ℝ a y` and `y ↦ ⟨y, e⟩` are continuous linear, hence smooth and their
  own derivatives; the quotient is `C¹` at `x` because `⟨x, a⟩ ≠ 0`, and so is its `arctan`.
* With `α = ⟨x, a⟩` and `β = ⟨x, e⟩`, the inverse, product and `arctan` chain rules give
  `Df(x) v = (1 + (β / α)²)⁻¹ (β (-(α²)⁻¹ ⟨a, v⟩) + α⁻¹ ⟨e, v⟩)`, which equals
  `(α ⟨e, v⟩ - β ⟨a, v⟩) / (α² + β²)` since `α² + β² ≥ α² > 0`. -/
theorem Submission.idtp_cse_rc_af_polar_angle_fderiv : ∀ (P : ℕ) (a e x : Euclid P), inner ℝ x a ≠ 0 → ContDiffAt ℝ 1 (fun y : Euclid P => Real.arctan (inner ℝ y e / inner ℝ y a)) x ∧ ∀ v : Euclid P, fderiv ℝ (fun y : Euclid P => Real.arctan (inner ℝ y e / inner ℝ y a)) x v = inner ℝ (inner ℝ x a • e - inner ℝ x e • a) v / (inner ℝ x a ^ 2 + inner ℝ x e ^ 2) := by
  intro P a e x hx
  -- Step 1: `y ↦ ⟨y, a⟩` and `y ↦ ⟨y, e⟩` are the continuous linear maps `innerSL ℝ a`, `innerSL ℝ e`
  have hLa : (fun y : Euclid P => inner ℝ y a) = innerSL ℝ a := by
    funext y; rw [innerSL_apply_apply, real_inner_comm]
  have hLe : (fun y : Euclid P => inner ℝ y e) = innerSL ℝ e := by
    funext y; rw [innerSL_apply_apply, real_inner_comm]
  have hda : HasFDerivAt (fun y : Euclid P => inner ℝ y a) (innerSL ℝ a) x :=
    hLa ▸ (innerSL ℝ a).hasFDerivAt
  have hde : HasFDerivAt (fun y : Euclid P => inner ℝ y e) (innerSL ℝ e) x :=
    hLe ▸ (innerSL ℝ e).hasFDerivAt
  -- Step 2: the quotient `q = ⟨·, e⟩ / ⟨·, a⟩` is `C¹` at `x`, and so is `arctan ∘ q`
  have hq : ContDiffAt ℝ 1 (fun y : Euclid P => inner ℝ y e / inner ℝ y a) x := by
    have hca : ContDiffAt ℝ 1 (fun y : Euclid P => inner ℝ y a) x :=
      hLa ▸ (innerSL ℝ a).contDiff.contDiffAt
    have hce : ContDiffAt ℝ 1 (fun y : Euclid P => inner ℝ y e) x :=
      hLe ▸ (innerSL ℝ e).contDiff.contDiffAt
    exact hce.fun_div hca hx
  refine ⟨hq.arctan, fun v => ?_⟩
  -- Step 3: `y ↦ ⟨y, a⟩⁻¹` has derivative `-(α²)⁻¹ ⟨a, ·⟩` at `x`
  have hdinv : HasFDerivAt (fun y : Euclid P => (inner ℝ y a)⁻¹)
      (-(inner ℝ x a ^ 2)⁻¹ • innerSL ℝ a) x :=
    (hasDerivAt_inv hx).comp_hasFDerivAt x hda
  -- Step 4: the product rule for `q = ⟨·, e⟩ ⬝ ⟨·, a⟩⁻¹`
  have hdq : HasFDerivAt (fun y : Euclid P => inner ℝ y e / inner ℝ y a)
      (inner ℝ x e • (-(inner ℝ x a ^ 2)⁻¹ • innerSL ℝ a) + (inner ℝ x a)⁻¹ • innerSL ℝ e) x := by
    simp only [div_eq_mul_inv]
    exact hde.fun_mul hdinv
  -- Step 5: the `arctan` chain rule and uniqueness of the derivative
  have hdf : HasFDerivAt (fun y : Euclid P => Real.arctan (inner ℝ y e / inner ℝ y a))
      ((1 / (1 + (inner ℝ x e / inner ℝ x a) ^ 2)) •
        (inner ℝ x e • (-(inner ℝ x a ^ 2)⁻¹ • innerSL ℝ a) + (inner ℝ x a)⁻¹ • innerSL ℝ e)) x :=
    hdq.arctan
  rw [hdf.fderiv]
  -- Step 6: algebra, with `α ≠ 0` and `α² + β² ≥ α² > 0`
  simp only [smul_apply, add_apply, innerSL_apply_apply, smul_eq_mul, inner_sub_left,
    real_inner_smul_left]
  have hden : inner ℝ x a ^ 2 + inner ℝ x e ^ 2 ≠ 0 := by positivity
  field_simp
  ring

/-- **Simon 7.3.3, proof of (1)** (2-dimensional minimizing cones, chapter text lines 501–504;
polar angle for the rotation field, Ch. 4, 2.2–2.6): if `a, e` is an orthonormal pair in the
`2`-dimensional subspace `Q`, then (i) `|p_Q y|² = (y · a)² + (y · e)²`, and (ii) on `{x · a > 0}`
the angle `f(y) = arctan((y · e)/(y · a))` is `C¹` with
`Df(x)v = ((x · a)e − (x · e)a) · v / |p_Q x|²`.  `(a, e)` is an orthonormal basis of `Q`, so
`p_Q y = (y · a)a + (y · e)e`, which gives (i); the quotient and `arctan` chain rules give `Df(x)v`
with denominator `(x · a)² + (x · e)²`, which is `|p_Q x|²` by (i). -/
theorem Submission.idtp_cse_rc_angle_fderiv : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P), Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → (∀ y : Euclid P, ‖Q.starProjection y‖ ^ 2 = inner ℝ y a ^ 2 + inner ℝ y e ^ 2) ∧ ∀ x : Euclid P, 0 < inner ℝ x a → ContDiffAt ℝ 1 (fun y : Euclid P => Real.arctan (inner ℝ y e / inner ℝ y a)) x ∧ ∀ v : Euclid P, fderiv ℝ (fun y : Euclid P => Real.arctan (inner ℝ y e / inner ℝ y a)) x v = inner ℝ (inner ℝ x a • e - inner ℝ x e • a) v / ‖Q.starProjection x‖ ^ 2 := by
  intro P Q a e hQ ha he ha1 he1 hae
  -- (i): `p_Q y = (y · a)a + (y · e)e`, so `|p_Q y|² = (y · a)² + (y · e)²`
  have hnorm : ∀ y : Euclid P, ‖Q.starProjection y‖ ^ 2 = inner ℝ y a ^ 2 + inner ℝ y e ^ 2 :=
    fun y => (Submission.idtp_cse_rc_af_plane_projection P Q a e hQ ha he ha1 he1 hae y).2
  refine ⟨hnorm, fun x hx => ?_⟩
  -- (ii): `x · a ≠ 0`, and the denominator `(x · a)² + (x · e)²` of `Df(x)v` is `|p_Q x|²` by (i)
  obtain ⟨hf, hDf⟩ := Submission.idtp_cse_rc_af_polar_angle_fderiv P a e x hx.ne'
  exact ⟨hf, fun v => by rw [hDf v, hnorm x]⟩

/-- **Support estimate for the angular test function** (steps 3–4 of the test-function
construction in the rotation argument for cone sectors, Simon 7.3).  Write `π = Q.starProjection`,
`α = ⟨y, a⟩ > 0` and `β = ⟨y, e⟩`, and assume `|π y|² = α² + β²`.  If `0 < s ≤ 1/4`,
`||y| − 1| < s`, `|arctan (β / α)| < s` and `|y − π y| < s |y|`, then `α > 1/2` and `|y| < 5/4`.
* `s ≤ 1/4 < π/4 = arctan 1` and `arctan` is increasing and odd, so `−1 < β / α < 1`; as `α > 0`,
  this is `−α < β < α`, hence `β² < α²`.
* `3/4 < |y| < 5/4`, and Pythagoras `|y|² = |π y|² + |y − π y|²` with `|y − π y|² < s² |y|²`,
  `s² ≤ 1/16` gives `|π y|² > (15/16) |y|² > 135/256`.
* So `2 α² > α² + β² = |π y|² > 135/256`, i.e. `α² > 135/512 > (1/2)²`, and `α > 1/2`. -/
theorem Submission.idtp_cse_rc_tf_support_bound : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (a e y : Euclid P) (s : ℝ), 0 < s → s ≤ 1 / 4 → ‖Q.starProjection y‖ ^ 2 = inner ℝ y a ^ 2 + inner ℝ y e ^ 2 → 0 < inner ℝ y a → |‖y‖ - 1| < s → |Real.arctan (inner ℝ y e / inner ℝ y a)| < s → ‖y - Q.starProjection y‖ < s * ‖y‖ → 1 / 2 < inner ℝ y a ∧ ‖y‖ < 5 / 4 := by
  intro P Q a e y s hs hs4 hproj ha hy harc hq
  -- Step 1: `s ≤ 1/4 < π/4` (as `π ≥ 2`), and `−s < arctan (β / α) < s`
  have hpi : s < Real.pi / 4 := by linarith [Real.two_le_pi]
  obtain ⟨harc₁, harc₂⟩ := abs_lt.1 harc
  -- Step 2: `−1 < β / α < 1`, since `arctan` is monotone with `arctan (±1) = ±π/4`
  have ht₁ : inner ℝ y e / inner ℝ y a < 1 := by
    by_contra h
    have h' := Real.arctan_strictMono.monotone (not_lt.1 h)
    rw [Real.arctan_one] at h'
    linarith
  have ht₂ : -1 < inner ℝ y e / inner ℝ y a := by
    by_contra h
    have h' := Real.arctan_strictMono.monotone (not_lt.1 h)
    rw [Real.arctan_neg, Real.arctan_one] at h'
    linarith
  -- Step 3: multiplying by `α > 0` gives `−α < β < α`, hence `β² < α²`
  rw [div_lt_one ha] at ht₁
  rw [lt_div_iff₀ ha] at ht₂
  have hβα : inner ℝ y e ^ 2 < inner ℝ y a ^ 2 := by nlinarith
  -- Step 4: Pythagoras `|y|² = |π y|² + |y − π y|²`, as `π_{Qᗮ} y = y − π y`
  have hpyth : ‖y‖ ^ 2 = ‖Q.starProjection y‖ ^ 2 + ‖y - Q.starProjection y‖ ^ 2 := by
    rw [← Submodule.starProjection_orthogonal_val]
    exact Q.norm_sq_eq_add_norm_sq_starProjection y
  -- Step 5: `3/4 < |y| < 5/4`, so `|y|² > 9/16`
  obtain ⟨hy₁, hy₂⟩ := abs_lt.1 hy
  have hy34 : 3 / 4 < ‖y‖ := by linarith
  have hysq : 9 / 16 < ‖y‖ ^ 2 := by nlinarith
  -- Step 6: `|y − π y|² < s² |y|²` and `s² ≤ 1/16`, so `|π y|² > (15/16) |y|² > 135/256`
  have hq2 : ‖y - Q.starProjection y‖ ^ 2 < (s * ‖y‖) ^ 2 :=
    pow_lt_pow_left₀ hq (norm_nonneg _) two_ne_zero
  have hs2 : s ^ 2 ≤ 1 / 16 := by nlinarith
  have hπ : 135 / 256 < ‖Q.starProjection y‖ ^ 2 := by
    nlinarith [mul_le_mul_of_nonneg_right hs2 (sq_nonneg ‖y‖)]
  -- Step 7: `2 α² > α² + β² = |π y|² > 135/256`, so `α² > (1/2)²` and `α > 1/2`
  refine ⟨?_, by linarith⟩
  have hα2 : (1 / 2 : ℝ) ^ 2 < inner ℝ y a ^ 2 := by nlinarith
  exact (pow_lt_pow_iff_left₀ (by norm_num) ha.le two_ne_zero).1 hα2
/-- **Extension by zero of a `C¹` function vanishing off a compact subset of `U`** (steps 5–7 of
the test-function construction for the rotation argument of Simon 7.3).  Let `U` be open,
`K ⊆ U` compact, `h` `C¹` at every point of `U`, and `h y ≠ 0`, `y ∈ U` force `y ∈ K`.  Then
`g = U.indicator h` is `C¹` with compact support, `Dg(x) = Dh(x)` on `U` and `Dg(x) = 0` off `U`.
* `g y ≠ 0` forces `y ∈ U` and `h y ≠ 0`, so `support g ⊆ K`; `K` is closed, so `tsupport g ⊆ K`,
  and `g` vanishes off the compact set `K`.
* For `x ∈ U`, `g = h` on the neighbourhood `U` of `x`; for `x ∉ U`, `x ∉ K ⊇ tsupport g`, so
  `g = 0` near `x`.  Either way `g` is `C¹` at `x` with the stated derivative. -/
theorem Submission.idtp_cse_rc_tf_indicator_extension : ∀ (P : ℕ) (U K : Set (Euclid P)) (h : Euclid P → ℝ), IsOpen U → IsCompact K → K ⊆ U → (∀ x ∈ U, ContDiffAt ℝ 1 h x) → (∀ y ∈ U, h y ≠ 0 → y ∈ K) → ContDiff ℝ 1 (U.indicator h) ∧ HasCompactSupport (U.indicator h) ∧ (∀ x ∈ U, fderiv ℝ (U.indicator h) x = fderiv ℝ h x) ∧ (∀ x ∉ U, fderiv ℝ (U.indicator h) x = 0) := by
  intro P U K h hU hK hKU hh hhK
  -- Step 1: `support g ⊆ K`: `g y ≠ 0` forces `y ∈ U` (else `g y = 0`) and then `h y = g y ≠ 0`
  have hsupp : ∀ y, U.indicator h y ≠ 0 → y ∈ K := by
    intro y hy
    by_cases hyU : y ∈ U
    · rw [Set.indicator_of_mem hyU] at hy
      exact hhK y hyU hy
    · exact absurd (Set.indicator_of_notMem hyU h) hy
  -- Step 2: `K` is compact, hence closed, so `tsupport g = closure (support g) ⊆ K`
  have htsupp : tsupport (U.indicator h) ⊆ K :=
    closure_minimal (fun y hy => hsupp y hy) hK.isClosed
  -- Step 4: for `x ∈ U`, `g = h` on the neighbourhood `U` of `x`
  have hin : ∀ x ∈ U, U.indicator h =ᶠ[𝓝 x] h := fun x hx => by
    filter_upwards [hU.mem_nhds hx] with y hy using Set.indicator_of_mem hy h
  -- Step 5: for `x ∉ U`, `x ∉ K ⊇ tsupport g`, so `g = 0` near `x`
  have hout : ∀ x ∉ U, U.indicator h =ᶠ[𝓝 x] fun _ => (0 : ℝ) := fun x hx =>
    notMem_tsupport_iff_eventuallyEq.1 fun hxs => hx (hKU (htsupp hxs))
  refine ⟨contDiff_iff_contDiffAt.2 fun x => ?_, HasCompactSupport.intro hK fun y hy => ?_,
    fun x hx => (hin x hx).fderiv_eq, fun x hx => ?_⟩
  · -- Step 6: `g` is `C¹` at every point, by Steps 4 and 5
    by_cases hx : x ∈ U
    · exact (hh x hx).congr_of_eventuallyEq (hin x hx)
    · exact contDiffAt_const.congr_of_eventuallyEq (hout x hx)
  · -- Step 3: `g` vanishes off the compact set `K`
    by_contra hy'
    exact hy (hsupp y hy')
  · -- Step 5: `Dg(x) = D0(x) = 0`
    rw [(hout x hx).fderiv_eq, fderiv_const_apply]
/-- **Derivative of `ψ(f) · l(|·|) · ζ` in a direction orthogonal to the position vector** (step 8,
formula (★), of the test function for the rotation argument in Simon 7.3).  If `x ≠ 0`,
`⟨x, v⟩ = 0`, `f` and `ζ` are differentiable at `x`, `ψ` at `f(x)` and `l` at `|x|`, then
`h(y) = ψ(f(y)) l(|y|) ζ(y)` has `Dh(x)v = ψ(f(x)) l(|x|) Dζ(x)v + ζ(x) l(|x|) ψ'(f(x)) Df(x)v`:
the radial term drops.
* `N = |·|` is differentiable at `x ≠ 0`; `D(N²)(x)` is `2|x| DN(x)` by the chain rule and
  `2⟨x, ·⟩` directly, so `2|x| DN(x)v = 2⟨x, v⟩ = 0` and `DN(x)v = 0`.
* The chain and product rules for `((ψ ∘ f) · (l ∘ N)) · ζ` give
  `Dh(x)v = ψ(f(x)) l(|x|) Dζ(x)v + ζ(x) (ψ(f(x)) l'(|x|) DN(x)v + l(|x|) ψ'(f(x)) Df(x)v)`. -/
theorem Submission.idtp_cse_rc_tf_product_fderiv : ∀ (P : ℕ) (f ζ : Euclid P → ℝ) (ψ l : ℝ → ℝ) (x v : Euclid P), x ≠ 0 → inner ℝ x v = 0 → DifferentiableAt ℝ f x → DifferentiableAt ℝ ψ (f x) → DifferentiableAt ℝ l ‖x‖ → DifferentiableAt ℝ ζ x → fderiv ℝ (fun y : Euclid P => ψ (f y) * l ‖y‖ * ζ y) x v = ψ (f x) * l ‖x‖ * fderiv ℝ ζ x v + ζ x * l ‖x‖ * (deriv ψ (f x) * fderiv ℝ f x v) := by
  intro P f ζ ψ l x v hx hxv hf hψ hl hζ
  -- Step 1: the norm `N = ‖·‖` is differentiable at `x ≠ 0`
  have hN : HasFDerivAt (fun y : Euclid P => ‖y‖) (fderiv ℝ (fun y : Euclid P => ‖y‖) x) x :=
    ((contDiffAt_norm ℝ (n := 1) hx).differentiableAt one_ne_zero).hasFDerivAt
  -- Step 2: `D(N²)(x) = 2‖x‖ DN(x)` (chain rule) and `D(‖·‖²)(x) = 2⟪x, ·⟫` agree; at `v` this
  -- reads `2‖x‖ DN(x) v = 2⟪x, v⟫ = 0`, so `DN(x) v = 0` as `‖x‖ ≠ 0`
  have hNv : fderiv ℝ (fun y : Euclid P => ‖y‖) x v = 0 := by
    have h2 := DFunLike.congr_fun ((hN.pow 2).unique (hasStrictFDerivAt_norm_sq x).hasFDerivAt) v
    simp only [smul_apply, smul_eq_mul, innerSL_apply_apply, hxv, smul_zero, nsmul_eq_mul,
      Nat.cast_ofNat, Nat.reduceSub, pow_one] at h2
    exact (mul_eq_zero.1 h2).resolve_left (mul_ne_zero two_ne_zero (norm_ne_zero_iff.2 hx))
  -- Step 3: chain rules for `F = ψ ∘ f` and `L = l ∘ N`
  have hF : HasFDerivAt (fun y : Euclid P => ψ (f y)) (deriv ψ (f x) • fderiv ℝ f x) x :=
    hψ.hasDerivAt.comp_hasFDerivAt x hf.hasFDerivAt
  have hL : HasFDerivAt (fun y : Euclid P => l ‖y‖)
      (deriv l ‖x‖ • fderiv ℝ (fun y : Euclid P => ‖y‖) x) x :=
    hl.hasDerivAt.comp_hasFDerivAt x hN
  -- Step 4: the product rule, twice, for `h = (F ⬝ L) ⬝ ζ`
  rw [((hF.fun_mul hL).fun_mul hζ.hasFDerivAt).fderiv]
  -- Step 5: evaluate at `v`, drop the radial term `DL(x) v = l'(‖x‖) DN(x) v = 0`, rearrange
  simp only [add_apply, smul_apply, smul_eq_mul, hNv]
  ring

/-- **`C¹` angular test function adapted to the gap hypothesis** (steps 4, 5 and 7 of the parent
proof).  With `f(y) = arctan(⟨y,e⟩/⟨y,a⟩)`, the cutoff `ζ` of `idtp_cse_rc_cone_cutoff` and
`h = ψ(f)·l(|·|)·ζ`, take `g = 1_U·h` for `U = {⟨y,a⟩ > 0}`.  Where `h ≠ 0` in `U`, the support
hypotheses on `ψ`, `l` and `ζ` put `y` in `Z`, hence in the compact set
`K = {⟨y,a⟩ ≥ 1/2} ∩ B̄(0, 5/4) ⊆ U`; so `g` is `C¹` with compact support, `Dg = Dh` on `U` and
`Dg = 0` off `U`.  For `⟨x,v⟩ = 0`, `Dh(x)v = ψ(f x)·l(|x|)·Dζ(x)v + ζ(x)·l(|x|)·ψ'(f x)·Df(x)v`.
On `Z` the gap forces `|x − πx| < (s/2)|x|`, so `ζ(x) = 1` and `Dζ(x) = 0`; off `Z` the first term
vanishes by the gap and the second because its factors cannot all be nonzero. -/
theorem Submission.idtp_cse_rc_test_function : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (s : ℝ) (ψ l : ℝ → ℝ), Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → 0 < s → s ≤ 1 / 4 → ContDiff ℝ 1 ψ → ContDiff ℝ 1 l → tsupport ψ ⊆ Ioo (-s) s → tsupport l ⊆ Ioo (1 - s) (1 + s) → ∃ g : Euclid P → ℝ, ContDiff ℝ 1 g ∧ HasCompactSupport g ∧ (∀ x v : Euclid P, inner ℝ x v = 0 → (0 < inner ℝ x a → |‖x‖ - 1| < s → |Real.arctan (inner ℝ x e / inner ℝ x a)| < s → ‖x - Q.starProjection x‖ < s / 2 * ‖x‖ ∨ 2 * s * ‖x‖ < ‖x - Q.starProjection x‖) → x ∈ {y : Euclid P | 0 < inner ℝ y a ∧ |‖y‖ - 1| < s ∧ |Real.arctan (inner ℝ y e / inner ℝ y a)| < s ∧ ‖y - Q.starProjection y‖ < s * ‖y‖} → fderiv ℝ g x v = deriv ψ (Real.arctan (inner ℝ x e / inner ℝ x a)) * l ‖x‖ * (inner ℝ (inner ℝ x a • e - inner ℝ x e • a) v / ‖Q.starProjection x‖ ^ 2)) ∧ (∀ x v : Euclid P, inner ℝ x v = 0 → (0 < inner ℝ x a → |‖x‖ - 1| < s → |Real.arctan (inner ℝ x e / inner ℝ x a)| < s → ‖x - Q.starProjection x‖ < s / 2 * ‖x‖ ∨ 2 * s * ‖x‖ < ‖x - Q.starProjection x‖) → x ∉ {y : Euclid P | 0 < inner ℝ y a ∧ |‖y‖ - 1| < s ∧ |Real.arctan (inner ℝ y e / inner ℝ y a)| < s ∧ ‖y - Q.starProjection y‖ < s * ‖y‖} → fderiv ℝ g x v = 0) := by
  intro P Q a e s ψ l hQ ha he hna hne hae hs hs4 hψ hl hψs hls
  -- step 1: the cutoff `ζ`, the identity `|πy|² = ⟨y,a⟩² + ⟨y,e⟩²` and `Df` on `⟨x,a⟩ > 0`
  obtain ⟨ζ, hζC, hζ1, hζ0, hζD⟩ := Submission.idtp_cse_rc_cone_cutoff P Q s hs
  obtain ⟨hπ, hf⟩ := Submission.idtp_cse_rc_angle_fderiv P Q a e hQ ha he hna hne hae
  have hne0 : ∀ x : Euclid P, 0 < inner ℝ x a → x ≠ 0 := by
    rintro x hx rfl
    simp at hx
  -- `f(y) ∈ (-s, s)` where `ψ(f y) ≠ 0` or `ψ'(f y) ≠ 0`, and `||y| - 1| < s` where `l(|y|) ≠ 0`
  have hψ_lt : ∀ t : ℝ, ψ t ≠ 0 → |t| < s := fun t ht => abs_lt.2 (hψs (subset_tsupport ψ ht))
  have hψ'_lt : ∀ t : ℝ, deriv ψ t ≠ 0 → |t| < s := fun t ht =>
    abs_lt.2 (hψs (support_deriv_subset ht))
  have hl_lt : ∀ y : Euclid P, l ‖y‖ ≠ 0 → |‖y‖ - 1| < s := fun y hy => by
    obtain ⟨h1, h2⟩ := hls (subset_tsupport l hy)
    exact abs_lt.2 ⟨by linarith, by linarith⟩
  -- `ζ(y) ≠ 0` forces `|y − πy| < s|y|` (by (c))
  have hζ_lt : ∀ y : Euclid P, y ≠ 0 → ζ y ≠ 0 → ‖y - Q.starProjection y‖ < s * ‖y‖ :=
    fun y hy hζy => lt_of_not_ge fun hc => hζy (hζ0 y hy hc)
  -- step 2: `h = ψ(f)·l(|·|)·ζ`, extended by zero off `U = {⟨y,a⟩ > 0}`
  set U : Set (Euclid P) := {y | 0 < inner ℝ y a}
  set K : Set (Euclid P) := {y | 1 / 2 ≤ inner ℝ y a} ∩ closedBall 0 (5 / 4)
  set h : Euclid P → ℝ := fun y => ψ (Real.arctan (inner ℝ y e / inner ℝ y a)) * l ‖y‖ * ζ y
  have hU : IsOpen U := isOpen_lt continuous_const (by fun_prop)
  have hK : IsCompact K :=
    (isCompact_closedBall 0 (5 / 4)).inter_left (isClosed_le continuous_const (by fun_prop))
  have hKU : K ⊆ U := fun y hy => lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2) hy.1
  -- step 7: `h` is `C¹` at each point of `U`
  have hC : ∀ x ∈ U, ContDiffAt ℝ 1 h x := fun x hx =>
    ((hψ.contDiffAt.comp x (hf x hx).1).mul
      (hl.contDiffAt.comp x (contDiffAt_norm ℝ (hne0 x hx)))).mul (hζC x (hne0 x hx))
  -- steps 3–5: where `h ≠ 0` in `U`, `y ∈ Z`, so `⟨y,a⟩ > 1/2` and `|y| < 5/4`
  have hsupp : ∀ y ∈ U, h y ≠ 0 → y ∈ K := by
    intro y hy hhy
    have h1 : ψ (Real.arctan (inner ℝ y e / inner ℝ y a)) ≠ 0 := fun h0 => hhy (by simp [h, h0])
    have h2 : l ‖y‖ ≠ 0 := fun h0 => hhy (by simp [h, h0])
    have h3 : ζ y ≠ 0 := fun h0 => hhy (by simp [h, h0])
    obtain ⟨hya, hyn⟩ := Submission.idtp_cse_rc_tf_support_bound P Q a e y s hs hs4 (hπ y) hy
      (hl_lt y h2) (hψ_lt _ h1) (hζ_lt y (hne0 y hy) h3)
    exact ⟨hya.le, mem_closedBall_zero_iff.2 hyn.le⟩
  obtain ⟨hg, hgc, hDin, hDout⟩ :=
    Submission.idtp_cse_rc_tf_indicator_extension P U K h hU hK hKU hC hsupp
  -- step 8, formula (★): for `⟨x,a⟩ > 0` and `⟨x,v⟩ = 0` the radial term drops
  have hprod : ∀ x v : Euclid P, 0 < inner ℝ x a → inner ℝ x v = 0 →
      fderiv ℝ h x v = ψ (Real.arctan (inner ℝ x e / inner ℝ x a)) * l ‖x‖ * fderiv ℝ ζ x v +
        ζ x * l ‖x‖ * (deriv ψ (Real.arctan (inner ℝ x e / inner ℝ x a)) *
          (inner ℝ (inner ℝ x a • e - inner ℝ x e • a) v / ‖Q.starProjection x‖ ^ 2)) := by
    intro x v hxa hxv
    rw [← (hf x hxa).2 v]
    exact Submission.idtp_cse_rc_tf_product_fderiv P
      (fun y => Real.arctan (inner ℝ y e / inner ℝ y a)) ζ ψ l x v (hne0 x hxa) hxv
      (hf x hxa).1.differentiableAt_one (hψ.differentiable_one _) (hl.differentiable_one _)
      (hζC x (hne0 x hxa)).differentiableAt_one
  refine ⟨U.indicator h, hg, hgc, ?_, ?_⟩
  · -- step 9: on `Z` the gap forces `|x − πx| < (s/2)|x|`, so `ζ(x) = 1` and `Dζ(x) = 0`
    intro x v hxv hgap hxZ
    obtain ⟨hxa, hx1, hfx, hq⟩ := hxZ
    have hx0 := hne0 x hxa
    have hsx : 0 < s * ‖x‖ := mul_pos hs (norm_pos_iff.2 hx0)
    have hq2 : ‖x - Q.starProjection x‖ < s / 2 * ‖x‖ := by
      rcases hgap hxa hx1 hfx with hq' | hq'
      · exact hq'
      · exact absurd hq' (by linarith)
    rw [hDin x hxa, hprod x v hxa hxv, hζ1 x hx0 hq2.le, hζD x hx0 (Or.inl hq2),
      zero_apply]
    ring
  · -- step 10: off `Z` both terms of (★) vanish
    intro x v hxv hgap hxZ
    by_cases hxa : 0 < inner ℝ x a
    · have hx0 := hne0 x hxa
      have hsx : 0 < s * ‖x‖ := mul_pos hs (norm_pos_iff.2 hx0)
      rw [hDin x hxa, hprod x v hxa hxv]
      -- first term: where `ψ(f x)·l(|x|) ≠ 0` the gap gives `Dζ(x) = 0` by (d)
      have t1 : ψ (Real.arctan (inner ℝ x e / inner ℝ x a)) * l ‖x‖ * fderiv ℝ ζ x v = 0 := by
        by_cases h1 : ψ (Real.arctan (inner ℝ x e / inner ℝ x a)) = 0
        · simp [h1]
        by_cases h2 : l ‖x‖ = 0
        · simp [h2]
        rw [hζD x hx0 ?_, zero_apply, mul_zero]
        rcases hgap hxa (hl_lt x h2) (hψ_lt _ h1) with hq | hq
        · exact Or.inl hq
        · exact Or.inr (by linarith)
      -- second term: `ζ(x)`, `l(|x|)`, `ψ'(f x)` all nonzero would put `x` in `Z`
      have t2 : ζ x * l ‖x‖ * (deriv ψ (Real.arctan (inner ℝ x e / inner ℝ x a)) *
          (inner ℝ (inner ℝ x a • e - inner ℝ x e • a) v / ‖Q.starProjection x‖ ^ 2)) = 0 := by
        by_cases h3 : ζ x = 0
        · simp [h3]
        by_cases h2 : l ‖x‖ = 0
        · simp [h2]
        by_cases h4 : deriv ψ (Real.arctan (inner ℝ x e / inner ℝ x a)) = 0
        · simp [h4]
        exact absurd ⟨hxa, hl_lt x h2, hψ'_lt _ h4, hζ_lt x hx0 h3⟩ hxZ
      rw [t1, t2, add_zero]
    · rw [hDout x hxa, zero_apply]

/-- **Rotation conservation on a cone sector** (Simon Ch. 4, 2.2–2.6: first variation of the
stationary `V = v(M, θ)` along a rotation field, as in the proof of 7.3.3(1)).  Let `(a, e)` be an
orthonormal basis of the 2-plane `Q`, `A y = ⟨y,a⟩e − ⟨y,e⟩a`, `f(y) = arctan(⟨y,e⟩/⟨y,a⟩)`,
`G(x) = |p_{TₓM}(Ax)|²/|πx|²` and `Z = {⟨x,a⟩ > 0, ||x| − 1| < s, |f(x)| < s, |x − πx| < s|x|}`.
If `V` is stationary, `p_{TₓM} x = x` and the gap condition hold `μ_V`-a.e., then
`ψ'(f)·l(|·|)·G` is `μ_V`-integrable on `Z` with integral `0`.
* With `g` from `idtp_cse_rc_test_function`, `X = gA` is `C¹` with compact support, so
  `0 = δV(X) = ∫_M θ div_M X dH²`, and `div_M X(x) = Dg(x)(p_{TₓM}(Ax))`
  (`idtp_cse_rc_rotation_divergence`).
* `μ_V`-a.e., `⟨x, p_{TₓM}(Ax)⟩ = ⟨p_{TₓM} x, Ax⟩ = ⟨x, Ax⟩ = 0` and
  `⟨Ax, p_{TₓM}(Ax)⟩ = |p_{TₓM}(Ax)|²`, so the derivative formulas of `g` give
  `Dg(x)(p_{TₓM}(Ax)) = 1_Z(x)·ψ'(f(x))·l(|x|)·G(x)`; as `μ_V = θ H²⌞M`, this yields
  `∫_Z ψ'(f)·l(|·|)·G dμ_V = δV(X) = 0`.
* `x ↦ p_{TₓM}` is `H²⌞M`-a.e. strongly measurable (`TₓM` is a.e. the plane oriented by `ξ(x)`,
  and the projection onto the plane of a unit simple 2-vector is a Borel function of it),
  `0 ≤ G ≤ 1` since `|Ax| = |πx|`, and `μ_V(Z) ≤ μ_V(B̄₂(0)) < ∞`. -/
theorem Submission.idtp_cse_rotation_conservation : ∀ (P : ℕ) (R : IMRep (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (s : ℝ), Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → 0 < s → s ≤ 1 / 4 → (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → R.firstVariation X = 0) → (∀ᵐ x ∂R.measure, (approxTangentPlane 2 R.carrier x).starProjection x = x) → (∀ᵐ x ∂R.measure, 0 < inner ℝ x a → |‖x‖ - 1| < s → |Real.arctan (inner ℝ x e / inner ℝ x a)| < s → ‖x - Q.starProjection x‖ < s / 2 * ‖x‖ ∨ 2 * s * ‖x‖ < ‖x - Q.starProjection x‖) → ∀ ψ l : ℝ → ℝ, ContDiff ℝ 1 ψ → ContDiff ℝ 1 l → tsupport ψ ⊆ Ioo (-s) s → tsupport l ⊆ Ioo (1 - s) (1 + s) → IntegrableOn (fun x : Euclid P => deriv ψ (Real.arctan (inner ℝ x e / inner ℝ x a)) * l ‖x‖ * (‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2)) {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} R.measure ∧ ∫ x in {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖}, deriv ψ (Real.arctan (inner ℝ x e / inner ℝ x a)) * l ‖x‖ * (‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2) ∂R.measure = 0 := by
  intro P R Q a e s hQ ha he hna hne hae hs hs4 hstat htan hgap ψ l hψ hl hψs hls
  classical
  -- step 6, measurability: `x ↦ p_{TₓM}` is `Hⁿ⌞M`-a.e. strongly measurable.  `TₓM` is a.e. the
  -- plane oriented by `ξ(x)`, and the projection onto the plane of a unit simple `n`-vector is a
  -- Borel function of it (the argument of `Submission.imrep_approxTangent_starProjection_aesm`)
  have haesm : ∀ (n : ℕ) (R : IMRep (univ : Set (Euclid P)) n),
      AEStronglyMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection)
        (μHE[n].restrict R.carrier) := by
    intro n R
    classical
    -- `ev τ = (α ↦ α(τ₁, …, τₙ))`, a continuous alternating map of `τ`
    let ev : Euclid P [⋀^Fin n]→L[ℝ] MultiVector P n :=
      (ContinuousLinearMap.id ℝ (Covector (Euclid P) n)).flipAlternating
    have hev : ∀ (τ : Fin n → Euclid P) (α : Covector (Euclid P) n), ev τ α = α τ :=
      fun τ α => rfl
    -- `Φ(τ, s) = s τ₁ ∧ ⋯ ∧ τₙ` on the compact set `Ω` of orthonormal frames and signs `s = ±1`
    let Φ : (Fin n → Euclid P) × ℝ → MultiVector P n := fun ω => ω.2 • ev ω.1
    have hΦc : Continuous Φ := continuous_snd.smul (ev.coe_continuous.comp continuous_fst)
    let Ω : Set ((Fin n → Euclid P) × ℝ) := {τ | Orthonormal ℝ τ} ×ˢ {1, -1}
    have hΩ : IsCompact Ω := by
      refine IsCompact.prod (isCompact_of_isClosed_isBounded ?_ ?_) (Set.toFinite _).isCompact
      · have hset : {τ : Fin n → Euclid P | Orthonormal ℝ τ} =
            ⋂ i, ⋂ j, {τ | inner ℝ (τ i) (τ j) = if i = j then (1 : ℝ) else 0} := by
          ext τ
          simp [orthonormal_iff_ite]
        rw [hset]
        exact isClosed_iInter fun i => isClosed_iInter fun j =>
          isClosed_eq ((continuous_apply i).inner (continuous_apply j)) continuous_const
      · refine (isBounded_iff_subset_closedBall 0).mpr ⟨1, fun τ hτ => ?_⟩
        rw [mem_closedBall_zero_iff]
        exact (pi_norm_le_iff_of_nonneg zero_le_one).mpr fun i => (hτ.1 i).le
    -- `ζ` orients `Q` iff `ζ = Φ(τ, s)` for a point `(τ, s)` of `Ω` with `span τ = Q`
    have horient : ∀ (ζ : MultiVector P n) (Q : Submodule ℝ (Euclid P)),
        IsUnitOrientationOf ζ Q ↔ ∃ ω ∈ Ω, Φ ω = ζ ∧ Submodule.span ℝ (range ω.1) = Q := by
      intro ζ Q
      constructor
      · rintro ⟨τ, hτ, hQ, h | h⟩
        · refine ⟨(τ, 1), ⟨hτ, Or.inl rfl⟩, ?_, hQ⟩
          ext α
          simp [Φ, hev, h]
        · refine ⟨(τ, -1), ⟨hτ, Or.inr rfl⟩, ?_, hQ⟩
          ext α
          simp [Φ, hev, h]
      · rintro ⟨⟨τ, s⟩, ⟨hτ, hs⟩, rfl, hQ⟩
        refine ⟨τ, hτ, hQ, ?_⟩
        rcases hs with rfl | rfl
        · left
          intro α
          simp [Φ, hev]
        · right
          intro α
          simp [Φ, hev]
    -- the `n`-covector `u ↦ det(⟨cₖ, uⱼ⟩)ₖⱼ`
    have hdet : ∀ c : Fin n → Euclid P, ∃ α : Covector (Euclid P) n,
        ∀ u : Fin n → Euclid P, α u = (Matrix.of fun k j => inner ℝ (c k) (u j)).det := by
      intro c
      let L : Euclid P →ₗ[ℝ] (Fin n → ℝ) := LinearMap.pi fun k => (innerSL ℝ (c k)).toLinearMap
      let A : Euclid P [⋀^Fin n]→ₗ[ℝ] ℝ := Matrix.detRowAlternating.compLinearMap L
      have hA : ∀ u : Fin n → Euclid P, A u = (Matrix.of fun k j => inner ℝ (c k) (u j)).det := by
        intro u
        rw [← Matrix.det_transpose]
        rfl
      have hAc : Continuous fun u : Fin n → Euclid P => A u := by
        simp only [hA]
        exact Continuous.matrix_det (continuous_matrix fun k j => by
          simp only [Matrix.of_apply]
          exact continuous_const.inner (continuous_apply j))
      exact ⟨{ A with cont := hAc }, hA⟩
    -- a unit simple `n`-vector determines its plane: if `ζ` orients `span τ` and `span τ'`, then
    -- each `τᵢ` is orthogonal to `(span τ')ᗮ`
    have hle : ∀ (ζ : MultiVector P n) (Q Q' : Submodule ℝ (Euclid P)),
        IsUnitOrientationOf ζ Q → IsUnitOrientationOf ζ Q' → Q ≤ Q' := by
      rintro ζ Q Q' ⟨τ, hτ, rfl, hζ⟩ ⟨τ', hτ', rfl, hζ'⟩
      rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      rw [SetLike.mem_coe, ← Submodule.orthogonal_orthogonal (Submodule.span ℝ (range τ')),
        Submodule.mem_orthogonal]
      intro y hy
      obtain ⟨α, hα⟩ := hdet (Function.update τ i y)
      -- `α(τ)` is the determinant of the identity matrix with row `i` replaced by `(⟨y, τⱼ⟩)ⱼ`
      have h1 : α τ = inner ℝ y (τ i) := by
        rw [hα]
        have hM : (Matrix.of fun k j => inner ℝ (Function.update τ i y k) (τ j)) =
            (1 : Matrix (Fin n) (Fin n) ℝ).updateRow i (fun j => inner ℝ y (τ j)) := by
          ext k j
          by_cases hk : k = i
          · subst hk
            simp
          · simp [hk, Matrix.one_apply, orthonormal_iff_ite.mp hτ k j]
        rw [hM, ← Matrix.det_transpose, ← Matrix.updateCol_transpose, Matrix.transpose_one,
          ← Matrix.cramer_apply, Matrix.cramer_one]
        rfl
      -- row `i` of the matrix of `α(τ')` is `(⟨y, τ'ⱼ⟩)ⱼ = 0`
      have h2 : α τ' = 0 := by
        rw [hα]
        refine Matrix.det_eq_zero_of_row_eq_zero i fun j => ?_
        simp only [Matrix.of_apply, Function.update_self]
        rw [real_inner_comm]
        exact hy _ (Submodule.subset_span ⟨j, rfl⟩)
      have h3 : ζ α = 0 := by
        rcases hζ' with h | h <;> simp [h, h2]
      rcases hζ with h | h
      · rw [← h1, ← h, h3]
      · have h4 := h α
        rw [h3] at h4
        rw [← h1]
        linarith
    have huniq : ∀ (ζ : MultiVector P n) (Q Q' : Submodule ℝ (Euclid P)),
        IsUnitOrientationOf ζ Q → IsUnitOrientationOf ζ Q' → Q = Q' :=
      fun ζ Q Q' h h' => le_antisymm (hle ζ Q Q' h h') (hle ζ Q' Q h' h)
    -- the projection onto the span of an orthonormal frame `τ` is `Σₖ ⟨τₖ, ·⟩ τₖ`, continuous in
    -- `τ`
    let F : (Fin n → Euclid P) × ℝ → (Euclid P →L[ℝ] Euclid P) :=
      fun ω => ∑ k, (innerSL ℝ (ω.1 k)).smulRight (ω.1 k)
    have hFapply : ∀ ω v, F ω v = ∑ k, inner ℝ (ω.1 k) v • ω.1 k := by
      intro ω v
      simp [F]
    have hFc : Continuous F := by
      refine continuous_clm_apply.mpr fun v => ?_
      simp only [hFapply]
      exact continuous_finsetSum _ fun k _ => by fun_prop
    have hFproj : ∀ ω ∈ Ω, (Submodule.span ℝ (range ω.1)).starProjection = F ω := by
      rintro ⟨τ, s⟩ ⟨hτ, -⟩
      refine ContinuousLinearMap.ext fun v => ?_
      refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero ?_ ?_
      · rw [hFapply]
        exact Submodule.sum_mem _ fun k _ =>
          Submodule.smul_mem _ _ (Submodule.subset_span ⟨k, rfl⟩)
      · intro w hw
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hw
        · rintro _ ⟨j, rfl⟩
          rw [hFapply, inner_sub_left, sum_inner]
          simp [inner_smul_left, orthonormal_iff_ite.mp hτ, real_inner_comm]
        · simp
        · intro x y _ _ hx hy
          rw [inner_add_right, hx, hy, add_zero]
        · intro a x _ hx
          rw [inner_smul_right, hx, mul_zero]
    -- `G ζ` is the projection onto the plane oriented by `ζ` (`0` if there is none)
    let G : MultiVector P n → (Euclid P →L[ℝ] Euclid P) := fun ζ =>
      if h : ∃ Q, IsUnitOrientationOf ζ Q then h.choose.starProjection else 0
    have hGQ : ∀ (ζ : MultiVector P n) (Q : Submodule ℝ (Euclid P)),
        IsUnitOrientationOf ζ Q → G ζ = Q.starProjection := by
      intro ζ Q hQ
      have hex : ∃ Q, IsUnitOrientationOf ζ Q := ⟨Q, hQ⟩
      simp only [G, dite_eq_left hex]
      rw [huniq _ _ _ hex.choose_spec hQ]
    have hGΦ : ∀ ω ∈ Ω, G (Φ ω) = F ω := fun ω hω => by
      rw [hGQ _ _ ((horient _ _).mpr ⟨ω, hω, rfl, rfl⟩), hFproj ω hω]
    -- `G` is Borel: for closed `t`, `G⁻¹(t)` is a compact set `Φ(Ω ∩ F⁻¹(t))` together with the
    -- complement of the compact set `Φ(Ω)` (if `0 ∈ t`)
    have hG : Measurable G := by
      refine measurable_of_isClosed fun t ht => ?_
      have hset : G ⁻¹' t = Φ '' (Ω ∩ F ⁻¹' t) ∪
          ((Φ '' Ω)ᶜ ∩ {_ζ | (0 : Euclid P →L[ℝ] Euclid P) ∈ t}) := by
        ext ζ
        simp only [Set.mem_preimage, Set.mem_union, Set.mem_image, Set.mem_inter_iff,
          Set.mem_compl_iff]
        by_cases h : ∃ Q, IsUnitOrientationOf ζ Q
        · obtain ⟨Q, hQ⟩ := h
          obtain ⟨ω, hω, hΦω, -⟩ := (horient ζ Q).mp hQ
          have hGζ : G ζ = F ω := by
            rw [← hΦω]
            exact hGΦ ω hω
          constructor
          · intro hζt
            exact Or.inl ⟨ω, ⟨hω, by rwa [← hGζ]⟩, hΦω⟩
          · rintro (⟨ω', ⟨hω', hω't⟩, hΦω'⟩ | ⟨hn, -⟩)
            · rw [← hΦω', hGΦ ω' hω']
              exact hω't
            · exact absurd ⟨ω, hω, hΦω⟩ hn
        · have hGζ : G ζ = 0 := dite_eq_right h
          have hn : ¬∃ ω, ω ∈ Ω ∧ Φ ω = ζ := fun ⟨ω, hω, hΦω⟩ =>
            h ⟨_, (horient ζ _).mpr ⟨ω, hω, hΦω, rfl⟩⟩
          rw [hGζ]
          constructor
          · intro h0
            exact Or.inr ⟨hn, h0⟩
          · rintro (⟨ω', ⟨hω', -⟩, hΦω'⟩ | ⟨-, h0⟩)
            · exact absurd ⟨ω', hω', hΦω'⟩ hn
            · exact h0
      rw [hset]
      exact ((hΩ.inter_right (ht.preimage hFc)).image hΦc).isClosed.measurableSet.union
        ((hΩ.image hΦc).isClosed.measurableSet.compl.inter (MeasurableSet.const _))
    -- a.e. `TₓM` is the plane oriented by `ξ(x)` (uniqueness of approximate tangent planes), so
    -- `p_{TₓM} = G(ξ(x))`
    have hae : (fun x => (approxTangentPlane n R.carrier x).starProjection)
        =ᵐ[μHE[n].restrict R.carrier] G ∘ R.orient := by
      filter_upwards [R.orients] with x ⟨Q, hQ, hor⟩
      have hex : ∃ Q, HasApproximateTangentSpaceAt n R.carrier x Q := ⟨Q, hQ⟩
      have h1 : approxTangentPlane n R.carrier x = Q := by
        rw [approxTangentPlane, dite_eq_left hex]
        exact hex.choose_spec.unique hQ
      rw [Function.comp_apply, hGQ _ _ hor, h1]
    -- `G ∘ ξ` is a.e. measurable, with values in the finite-dimensional space `End(ℝᴾ)`
    have : TopologicalSpace.PseudoMetrizableSpace (MultiVector P n) :=
      @PseudoEMetricSpace.pseudoMetrizableSpace _
        (inferInstance : PseudoEMetricSpace (MultiVector P n))
    exact ((hG.comp_aemeasurable R.aestronglyMeasurable_orient.aemeasurable).aestronglyMeasurable
      ).congr hae.symm
  -- steps 1, 3: `|πy|² = ⟨y,a⟩² + ⟨y,e⟩²`; step 5: the `C¹` test function `g` of compact support
  obtain ⟨hπ, -⟩ := Submission.idtp_cse_rc_angle_fderiv P Q a e hQ ha he hna hne hae
  obtain ⟨g, hgC, hgc, hgZ, hgZc⟩ := Submission.idtp_cse_rc_test_function P Q a e s ψ l hQ ha he
    hna hne hae hs hs4 hψ hl hψs hls
  set Z : Set (Euclid P) := {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧
    |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} with hZ
  set φ : Euclid P → ℝ := fun x => deriv ψ (Real.arctan (inner ℝ x e / inner ℝ x a)) * l ‖x‖ *
    (‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 /
      ‖Q.starProjection x‖ ^ 2) with hφ
  -- the rotation field `X = g A`, `A y = ⟨y,a⟩e − ⟨y,e⟩a`, is `C¹` with compact support
  set X : Euclid P → Euclid P := fun y => g y • (inner ℝ y a • e - inner ℝ y e • a) with hX
  have hAC : ContDiff ℝ 1 fun y : Euclid P => inner ℝ y a • e - inner ℝ y e • a :=
    ((contDiff_id.inner ℝ contDiff_const).smul contDiff_const).sub
      ((contDiff_id.inner ℝ contDiff_const).smul contDiff_const)
  have hXC : ContDiff ℝ 1 X := hgC.smul hAC
  have hXc : HasCompactSupport X := hgc.smul_right
  -- measurability of the angle `f`, of `Z` and of the multiplicity
  have hfm : Measurable fun x : Euclid P => Real.arctan (inner ℝ x e / inner ℝ x a) :=
    Real.continuous_arctan.measurable.comp
      ((continuous_id.inner continuous_const).measurable.div
        (continuous_id.inner continuous_const).measurable)
  have hZm : MeasurableSet Z := by
    simp only [hZ, Set.ofPred_and]
    exact (measurableSet_lt measurable_const
      (continuous_id.inner continuous_const).measurable).inter
      ((measurableSet_lt (continuous_norm.sub continuous_const).abs.measurable
        measurable_const).inter
        ((measurableSet_lt (continuous_abs.measurable.comp hfm) measurable_const).inter
          (measurableSet_lt (continuous_id.sub Q.starProjection.continuous).norm.measurable
            (continuous_const.mul continuous_norm).measurable)))
  have hmult : Measurable fun x => (R.mult x : ℝ≥0∞) :=
    (measurable_from_nat (f := fun k : ℕ => (k : ℝ≥0∞))).comp R.measurable_mult
  -- step 2: `div_M X(x) = Dg(x)(p_{TₓM}(Ax))`
  have hdiv : ∀ x, tangentialDivergence 2 R.carrier X x = fderiv ℝ g x
      ((approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)) :=
    fun x => Submission.idtp_cse_rc_rotation_divergence P 2 R.carrier a e x g
      (hgC.differentiable_one x)
  -- step 7: `μ`-a.e., `Dg(x)(p_{TₓM}(Ax)) = 1_Z(x) φ(x)`
  have hpt : ∀ᵐ x ∂R.measure, fderiv ℝ g x
      ((approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)) =
        Z.indicator φ x := by
    filter_upwards [htan, hgap] with x hx hgx
    -- (a) `⟨x, p(Ax)⟩ = ⟨p x, Ax⟩ = ⟨x, Ax⟩ = 0` (radial tangency, `p` self-adjoint)
    have hxv : inner ℝ x (inner ℝ x a • e - inner ℝ x e • a) = (0 : ℝ) := by
      rw [inner_sub_right, real_inner_smul_right, real_inner_smul_right]
      ring
    have hxpv : inner ℝ x ((approxTangentPlane 2 R.carrier x).starProjection
        (inner ℝ x a • e - inner ℝ x e • a)) = (0 : ℝ) := by
      rw [← Submodule.inner_starProjection_left_eq_right, hx, hxv]
    -- (c) `⟨Ax, p(Ax)⟩ = |p(Ax)|²` (`p` idempotent and self-adjoint)
    have hvpv : inner ℝ (inner ℝ x a • e - inner ℝ x e • a)
        ((approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)) =
          ‖(approxTangentPlane 2 R.carrier x).starProjection
            (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 := by
      have h1 := Submodule.starProjection_inner_eq_zero (K := approxTangentPlane 2 R.carrier x)
        (inner ℝ x a • e - inner ℝ x e • a)
        ((approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a))
        (Submodule.starProjection_apply_mem _ _)
      rw [inner_sub_left, real_inner_self_eq_norm_sq] at h1
      linarith
    -- (b) on and off `Z`, the derivative formulas of the test function
    by_cases hxZ : x ∈ Z
    · rw [Set.indicator_of_mem hxZ, hgZ x _ hxpv hgx hxZ, hvpv]
    · rw [Set.indicator_of_notMem hxZ, hgZc x _ hxpv hgx hxZ]
  -- `μ = θ H²⌞M` with `θ` measurable: the identity holds `H²⌞M`-a.e. after multiplying by `θ`
  have hae2 : ∀ᵐ x ∂(μHE[2].restrict R.carrier),
      (R.mult x : ℝ) * tangentialDivergence 2 R.carrier X x = (R.mult x : ℝ) * Z.indicator φ x := by
    filter_upwards [(ae_withDensity_iff hmult).1 hpt] with x hx
    rcases eq_or_ne (R.mult x) 0 with h0 | h0
    · simp [h0]
    · rw [hdiv x, hx (by exact_mod_cast h0)]
  -- step 8: `∫_Z φ dμ = ∫ 1_Z φ dμ = ∫_M θ div_M X dH² = δV(X) = 0`
  have hint : ∫ x in Z, φ x ∂R.measure = 0 := by
    have h1 : ∫ x, Z.indicator φ x ∂R.measure =
        ∫ x in R.carrier, (R.mult x : ℝ) * Z.indicator φ x ∂μHE[2] := by
      rw [IMRep.measure, integral_withDensity_eq_integral_toReal_smul hmult
        (ae_of_all _ fun x => ENNReal.natCast_lt_top (R.mult x))]
      simp only [ENNReal.toReal_natCast, smul_eq_mul]
    calc ∫ x in Z, φ x ∂R.measure = ∫ x, Z.indicator φ x ∂R.measure :=
          (integral_indicator hZm).symm
      _ = ∫ x in R.carrier, (R.mult x : ℝ) * Z.indicator φ x ∂μHE[2] := h1
      _ = ∫ x in R.carrier, (R.mult x : ℝ) * tangentialDivergence 2 R.carrier X x ∂μHE[2] :=
          integral_congr_ae (hae2.mono fun x hx => hx.symm)
      _ = R.firstVariation X := rfl
      _ = 0 := hstat X hXC hXc
  -- step 8, integrability: `φ` is `μ`-a.e. strongly measurable, bounded on `Z`, and `μ(Z) < ∞`
  have hπA : ∀ x : Euclid P,
      ‖inner ℝ x a • e - inner ℝ x e • a‖ ^ 2 = ‖Q.starProjection x‖ ^ 2 := by
    intro x
    have haa : inner ℝ a a = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, hna, one_pow]
    have hee : inner ℝ e e = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, hne, one_pow]
    have hea : inner ℝ e a = (0 : ℝ) := by rw [real_inner_comm, hae]
    rw [hπ x, ← real_inner_self_eq_norm_sq]
    simp only [inner_sub_left, inner_sub_right, real_inner_smul_left, real_inner_smul_right, haa,
      hee, hae, hea]
    ring
  have hφm : AEStronglyMeasurable φ R.measure := by
    have hpA : AEStronglyMeasurable (fun x => (approxTangentPlane 2 R.carrier x).starProjection
        (inner ℝ x a • e - inner ℝ x e • a)) R.measure :=
      Continuous.comp_aestronglyMeasurable₂
        (g := fun (L : Euclid P →L[ℝ] Euclid P) (v : Euclid P) => L v)
        (continuous_fst.clm_apply continuous_snd)
        ((haesm 2 R).mono_ac (withDensity_absolutelyContinuous _ _))
        hAC.continuous.aestronglyMeasurable
    exact ((((hψ.continuous_deriv le_rfl).measurable.comp hfm).aemeasurable.mul
      (hl.continuous.comp continuous_norm).measurable.aemeasurable).mul
      ((hpA.aemeasurable.norm.pow_const 2).div
        (Q.starProjection.continuous.norm.pow 2).measurable.aemeasurable)).aestronglyMeasurable
  obtain ⟨Cψ, hCψ⟩ := (isCompact_Icc : IsCompact (Icc (-s) s)).exists_bound_of_continuousOn
    (hψ.continuous_deriv le_rfl).continuousOn
  obtain ⟨Cl, hCl⟩ := (isCompact_Icc : IsCompact (Icc (1 - s) (1 + s))).exists_bound_of_continuousOn
    hl.continuous.continuousOn
  have hbound : ∀ x ∈ Z, ‖φ x‖ ≤ Cψ * Cl := by
    intro x hx
    obtain ⟨-, hx1, hfx, -⟩ := hx
    obtain ⟨hf1, hf2⟩ := abs_lt.1 hfx
    obtain ⟨hn1, hn2⟩ := abs_lt.1 hx1
    have h1 := hCψ _ ⟨hf1.le, hf2.le⟩
    have h2 := hCl ‖x‖ ⟨by linarith, by linarith⟩
    -- `0 ≤ |p(Ax)|² / |πx|² ≤ 1`, as `|p(Ax)| ≤ |Ax|` and `|Ax| = |πx|`
    have h3 : ‖‖(approxTangentPlane 2 R.carrier x).starProjection
        (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2‖ ≤ 1 := by
      rw [Real.norm_of_nonneg (by positivity), ← hπA x]
      exact div_le_one_of_le₀ (pow_le_pow_left₀ (norm_nonneg _)
        (Submodule.norm_starProjection_apply_le _ _) 2) (sq_nonneg _)
    have hCψ0 : 0 ≤ Cψ := (norm_nonneg _).trans h1
    have hCl0 : 0 ≤ Cl := (norm_nonneg _).trans h2
    calc ‖φ x‖ = ‖deriv ψ (Real.arctan (inner ℝ x e / inner ℝ x a))‖ * ‖l ‖x‖‖ *
          ‖‖(approxTangentPlane 2 R.carrier x).starProjection
            (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2‖ := by
          simp only [hφ, norm_mul]
      _ ≤ Cψ * Cl * 1 :=
          mul_le_mul (mul_le_mul h1 h2 (norm_nonneg _) hCψ0) h3 (norm_nonneg _)
            (mul_nonneg hCψ0 hCl0)
      _ = Cψ * Cl := mul_one _
  -- `Z ⊆ B̄₂(0)` and `μ(B̄₂(0)) = ∫_{M ∩ B̄₂(0)} θ dH² < ∞`
  have hfin : R.measure Z ≠ ∞ := by
    have hZb : Z ⊆ closedBall (0 : Euclid P) 2 := by
      intro x hx
      obtain ⟨-, hx1, -, -⟩ := hx
      rw [mem_closedBall_zero_iff]
      linarith [(abs_lt.1 hx1).2]
    refine ne_top_of_le_ne_top ?_ (measure_mono hZb)
    rw [IMRep.measure, withDensity_apply _ measurableSet_closedBall,
      Measure.restrict_restrict measurableSet_closedBall, Set.inter_comm]
    exact R.locallyIntegrable_mult _ (isCompact_closedBall _ _) (subset_univ _)
  exact ⟨Measure.integrableOn_of_bounded hfin hφm (ae_restrict_of_forall_mem hZm hbound), hint⟩
/-- **Normalized `C¹` bump** in a given open interval.  For `c < d` there is a `C¹` function
`χ : ℝ → ℝ` with `spt χ ⊆ (c, d)` and `∫ χ = 1`.  With `σ = Real.smoothTransition`,
`m = (c + d)/2`, `ρ = (d − c)/2`, `p = m − ρ/2` and `q = m + ρ/2` (so `c < p < q < d`), the
function `θ(α) = σ((4/ρ)(α − p)) σ((4/ρ)(q − α))` is smooth, nonnegative, vanishes off `[p, q]`
and has `θ(m) = 1`, so `∫ θ > 0`; take `χ = (∫ θ)⁻¹ θ`. -/
theorem Submission.idtp_cse_ah_normalized_bump : ∀ c d : ℝ, c < d → ∃ χ : ℝ → ℝ, ContDiff ℝ 1 χ ∧ tsupport χ ⊆ Ioo c d ∧ ∫ α, χ α = 1 := by
  intro c d hcd
  -- `c < p < m < q < d` with `m = (c + d)/2`, `ρ = (d - c)/2`, `p = m - ρ/2`, `q = m + ρ/2`
  set ρ : ℝ := (d - c) / 2 with hρ_def
  have hρ : 0 < ρ := by rw [hρ_def]; linarith
  set m : ℝ := (c + d) / 2 with hm_def
  set p : ℝ := m - ρ / 2 with hp_def
  set q : ℝ := m + ρ / 2 with hq_def
  have hcp : c < p := by rw [hp_def, hm_def, hρ_def]; linarith
  have hqd : q < d := by rw [hq_def, hm_def, hρ_def]; linarith
  -- `θ(α) = σ((4/ρ)(α - p)) σ((4/ρ)(q - α))`, `σ = Real.smoothTransition`
  set θ : ℝ → ℝ := fun α =>
    Real.smoothTransition (4 / ρ * (α - p)) * Real.smoothTransition (4 / ρ * (q - α)) with hθ_def
  have hθ_diff : ContDiff ℝ 1 θ := by
    have h₁ : ContDiff ℝ 1 fun α : ℝ => Real.smoothTransition (4 / ρ * (α - p)) :=
      Real.smoothTransition.contDiff.comp (contDiff_const.mul (contDiff_id.sub contDiff_const))
    have h₂ : ContDiff ℝ 1 fun α : ℝ => Real.smoothTransition (4 / ρ * (q - α)) :=
      Real.smoothTransition.contDiff.comp (contDiff_const.mul (contDiff_const.sub contDiff_id))
    exact h₁.mul h₂
  have hθ_nonneg : 0 ≤ θ := fun α =>
    mul_nonneg (Real.smoothTransition.nonneg _) (Real.smoothTransition.nonneg _)
  -- `θ` vanishes off `[p, q]`
  have hθ_supp : support θ ⊆ Icc p q := by
    intro α hα
    rw [mem_support] at hα
    by_contra h
    rw [mem_Icc, not_and_or, not_le, not_le] at h
    apply hα
    rcases h with h | h
    · have h' : 4 / ρ * (α - p) ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos (by positivity) (by linarith)
      simp only [hθ_def, Real.smoothTransition.zero_of_nonpos h', zero_mul]
    · have h' : 4 / ρ * (q - α) ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos (by positivity) (by linarith)
      simp only [hθ_def, Real.smoothTransition.zero_of_nonpos h', mul_zero]
  have hθ_tsupp : tsupport θ ⊆ Icc p q := closure_minimal hθ_supp isClosed_Icc
  have hθ_cpt : HasCompactSupport θ :=
    isCompact_Icc.of_isClosed_subset (isClosed_tsupport θ) hθ_tsupp
  -- `θ(m) = 1`
  have hθm : θ m = 1 := by
    have h₁ : 4 / ρ * (m - p) = 2 := by rw [hp_def]; field_simp; ring
    have h₂ : 4 / ρ * (q - m) = 2 := by rw [hq_def]; field_simp; ring
    simp only [hθ_def, h₁, h₂, Real.smoothTransition.one_of_one_le (by norm_num : (1 : ℝ) ≤ 2),
      mul_one]
  -- `∫ θ > 0`; normalize
  have hI : 0 < ∫ α, θ α :=
    hθ_diff.continuous.integral_pos_of_hasCompactSupport_nonneg_nonzero hθ_cpt hθ_nonneg
      (x := m) (by rw [hθm]; exact one_ne_zero)
  refine ⟨fun α => (∫ α, θ α)⁻¹ * θ α, contDiff_const.mul hθ_diff, ?_, ?_⟩
  · exact tsupport_mul_subset_right.trans (hθ_tsupp.trans (Icc_subset_Ioo hcp hqd))
  · rw [integral_const_mul]
    exact inv_mul_cancel₀ hI.ne'
/-- **Smooth plateaus converge weakly to `1_{(p, q)}`.**  For real `p, q` the `C¹` functions
`χ_k(α) = σ(k(α - p)) σ(k(q - α))`, `σ = Real.smoothTransition`, satisfy `0 ≤ χ_k ≤ 1` and vanish
off `(p, q)`, so `tsupport χ_k ⊆ [p, q]`; for `p < α < q`, `χ_k(α) = 1` once
`k ≥ max (1/(α - p)) (1/(q - α))`.  Dominated convergence with bound `|g|` then gives
`∫ χ_k g → ∫_{(p, q)} g` for every integrable `g`. -/
theorem Submission.idtp_cse_ah_cst_plateau_weak_limit : ∀ p q : ℝ, ∃ χ : ℕ → ℝ → ℝ, (∀ k, ContDiff ℝ 1 (χ k)) ∧ (∀ k, tsupport (χ k) ⊆ Icc p q) ∧ ∀ g : ℝ → ℝ, Integrable g → Tendsto (fun k => ∫ α, χ k α * g α) atTop (𝓝 (∫ α in Ioo p q, g α)) := by
  intro p q
  -- `χ_k(α) = σ(k(α - p)) σ(k(q - α))`, with `σ` the smooth transition from `0` (on `(-∞, 0]`)
  -- to `1` (on `[1, ∞)`)
  have hzero : ∀ (k : ℕ) (α : ℝ), α ∉ Ioo p q →
      Real.smoothTransition (k * (α - p)) * Real.smoothTransition (k * (q - α)) = 0 := by
    intro k α hα
    rcases not_and_or.1 hα with h | h
    · rw [Real.smoothTransition.zero_of_nonpos
        (mul_nonpos_of_nonneg_of_nonpos k.cast_nonneg (sub_nonpos.2 (not_lt.1 h))), zero_mul]
    · rw [Real.smoothTransition.zero_of_nonpos
        (mul_nonpos_of_nonneg_of_nonpos k.cast_nonneg (sub_nonpos.2 (not_lt.1 h))), mul_zero]
  refine ⟨fun k α => Real.smoothTransition (k * (α - p)) * Real.smoothTransition (k * (q - α)),
    fun k => ?_, fun k => ?_, fun g hg => ?_⟩
  · exact (Real.smoothTransition.contDiff.comp
      (contDiff_const.mul (contDiff_id.sub contDiff_const))).mul
      (Real.smoothTransition.contDiff.comp (contDiff_const.mul (contDiff_const.sub contDiff_id)))
  · -- `χ_k` vanishes off `(p, q)`, so its closed support lies in `[p, q]`
    exact closure_minimal (fun α hα => Ioo_subset_Icc_self (by_contra fun h => hα (hzero k α h)))
      isClosed_Icc
  · -- dominated convergence with bound `|g|`, the limit being `1_{(p, q)} g`
    rw [← integral_indicator measurableSet_Ioo]
    refine tendsto_integral_of_dominated_convergence (fun α => ‖g α‖) (fun k => ?_) hg.norm
      (fun k => Eventually.of_forall fun α => ?_) (Eventually.of_forall fun α => ?_)
    · exact (((Real.smoothTransition.continuous.comp (continuous_const.mul
        (continuous_id.sub continuous_const))).mul (Real.smoothTransition.continuous.comp
        (continuous_const.mul (continuous_const.sub continuous_id)))).aestronglyMeasurable).mul
        hg.aestronglyMeasurable
    · -- `0 ≤ χ_k ≤ 1`
      rw [norm_mul]
      refine mul_le_of_le_one_left (norm_nonneg _) ?_
      rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (Real.smoothTransition.nonneg _)
        (Real.smoothTransition.nonneg _))]
      exact (mul_le_of_le_one_left (Real.smoothTransition.nonneg _)
        (Real.smoothTransition.le_one _)).trans (Real.smoothTransition.le_one _)
    · by_cases hα : α ∈ Ioo p q
      · -- `χ_k(α) = 1` once `k ≥ max (1/(α - p)) (1/(q - α))`
        rw [indicator_of_mem hα]
        obtain ⟨N, hN⟩ := exists_nat_ge (max (1 / (α - p)) (1 / (q - α)))
        have hp : 0 < α - p := sub_pos.2 hα.1
        have hq : 0 < q - α := sub_pos.2 hα.2
        refine tendsto_const_nhds.congr' ?_
        filter_upwards [eventually_ge_atTop N] with k hk
        have hk' : max (1 / (α - p)) (1 / (q - α)) ≤ k := hN.trans (Nat.cast_le.2 hk)
        have h1 : 1 ≤ (k : ℝ) * (α - p) := by
          have := (le_max_left _ _).trans hk'
          rwa [div_le_iff₀ hp] at this
        have h2 : 1 ≤ (k : ℝ) * (q - α) := by
          have := (le_max_right _ _).trans hk'
          rwa [div_le_iff₀ hq] at this
        rw [Real.smoothTransition.one_of_one_le h1, Real.smoothTransition.one_of_one_le h2, one_mul,
          one_mul]
      · -- `χ_k(α) = 0` for every `k`
        rw [indicator_of_notMem hα]
        simp only [hzero _ α hα, zero_mul]
        exact tendsto_const_nhds
/-- Vanishing integrals over rational subintervals force a.e. vanishing: if `w` is integrable on
`(c, d)` and `∫_{(p, q)} w = 0` for all rationals `c < p < q < d`, then `w = 0` a.e. on `(c, d)`.
Extend `w` by zero to `w̄ = 𝟙_{(c, d)} w`.  The primitive `W x = ∫_c^x w̄` is continuous and
constant on the dense set `(c, d) ∩ ℚ`, hence `W ≡ W c = 0` on `[c, d]`; so the averages of `w̄`
over `[x - ρ, x + ρ] ⊆ [c, d]` vanish, and Lebesgue differentiation gives `w x = w̄ x = 0` for
a.e. `x ∈ (c, d)`. -/
theorem Submission.idtp_cse_ah_cst_ae_zero_of_rat_intervals : ∀ (c d : ℝ) (w : ℝ → ℝ), IntegrableOn w (Ioo c d) → (∀ p q : ℚ, c < (p : ℝ) → (p : ℝ) < (q : ℝ) → (q : ℝ) < d → ∫ α in Ioo (p : ℝ) (q : ℝ), w α = 0) → ∀ᵐ α, α ∈ Ioo c d → w α = 0 := by
  intro c d w hw hrat
  -- Step 0: if `d ≤ c` the interval is empty and the claim is vacuous.
  rcases le_or_gt d c with hdc | hcd
  · exact Eventually.of_forall fun α hα => absurd (hα.1.trans hα.2) (not_lt.mpr hdc)
  -- Step 1: the extension `w̄ = 𝟙_{(c, d)} w` by zero is integrable on `ℝ`.
  set wb : ℝ → ℝ := (Ioo c d).indicator w with hwb
  have hwbi : Integrable wb := hw.integrable_indicator measurableSet_Ioo
  have hwb_rat : ∀ p q : ℚ, c < (p : ℝ) → (p : ℝ) < (q : ℝ) → (q : ℝ) < d →
      ∫ α in Ioo (p : ℝ) (q : ℝ), wb α = 0 := by
    intro p q hcp hpq hqd
    rw [← hrat p q hcp hpq hqd]
    exact setIntegral_congr_fun measurableSet_Ioo fun α hα =>
      indicator_of_mem (show α ∈ Ioo c d from ⟨hcp.trans hα.1, hα.2.trans hqd⟩) w
  -- Step 2: the primitive `W x = ∫_c^x w̄` is continuous and `W q = W p` for rationals.
  set W : ℝ → ℝ := fun x => ∫ t in c..x, wb t with hW
  have hWc : Continuous W :=
    intervalIntegral.continuous_primitive (fun _ _ => hwbi.intervalIntegrable) c
  have hWsub : ∀ a b : ℝ, W b - W a = ∫ t in a..b, wb t := fun a b =>
    intervalIntegral.integral_interval_sub_left hwbi.intervalIntegrable hwbi.intervalIntegrable
  have hWrat : ∀ p q : ℚ, c < (p : ℝ) → (p : ℝ) < (q : ℝ) → (q : ℝ) < d → W q = W p := by
    intro p q hcp hpq hqd
    have h := hWsub p q
    rw [intervalIntegral.integral_of_le hpq.le, integral_Ioc_eq_integral_Ioo,
      hwb_rat p q hcp hpq hqd] at h
    linarith
  -- Step 3: `W` is constant on the dense set `(c, d) ∩ ℚ`, hence `W ≡ W c = 0` on `[c, d]`.
  obtain ⟨q₀, hcq₀, hq₀d⟩ := exists_rat_btwn hcd
  have hWS : ∀ r : ℚ, c < (r : ℝ) → (r : ℝ) < d → W r = W q₀ := by
    intro r hcr hrd
    rcases lt_trichotomy (r : ℝ) (q₀ : ℝ) with h | h | h
    · exact (hWrat r q₀ hcr h hq₀d).symm
    · rw [h]
    · exact hWrat q₀ r hcq₀ h hrd
  have hSsub : Ioo c d ∩ range ((↑) : ℚ → ℝ) ⊆ Icc c d := fun x hx =>
    Ioo_subset_Icc_self hx.1
  have hclos : Icc c d ⊆ closure (Ioo c d ∩ range ((↑) : ℚ → ℝ)) := by
    have h : Ioo c d ⊆ closure (Ioo c d ∩ range ((↑) : ℚ → ℝ)) :=
      Rat.denseRange_cast.open_subset_closure_inter isOpen_Ioo
    rw [← closure_Ioo hcd.ne]
    exact closure_minimal h isClosed_closure
  have hEq : EqOn W (fun _ => W q₀) (Icc c d) := by
    refine EqOn.of_subset_closure ?_ hWc.continuousOn continuousOn_const hSsub hclos
    rintro x ⟨hxJ, r, rfl⟩
    exact hWS r hxJ.1 hxJ.2
  have hWq₀ : W q₀ = 0 := by
    have h := hEq (left_mem_Icc.mpr hcd.le)
    simp only [hW, intervalIntegral.integral_same] at h
    exact h.symm
  have hW0 : ∀ x ∈ Icc c d, W x = 0 := fun x hx => (hEq hx).trans hWq₀
  -- Step 4: Lebesgue differentiation for `w̄` along closed balls centred at `x`.
  filter_upwards [IsUnifLocDoublingMeasure.ae_tendsto_average volume hwbi.locallyIntegrable 1]
    with x hx hxJ
  have hlim : Tendsto (fun ρ => ⨍ y in closedBall x ρ, wb y) (𝓝[>] 0) (𝓝 (wb x)) := by
    refine hx (fun _ => x) id tendsto_id ?_
    filter_upwards [self_mem_nhdsWithin] with ρ hρ
    exact mem_closedBall_self (by rw [one_mul]; exact le_of_lt hρ)
  -- Step 5: the averages vanish for `0 < ρ < min (x - c) (d - x)`.
  have hm : 0 < min (x - c) (d - x) := lt_min (sub_pos.mpr hxJ.1) (sub_pos.mpr hxJ.2)
  have hzero : ∀ᶠ ρ in 𝓝[>] (0 : ℝ), ⨍ y in closedBall x ρ, wb y = 0 := by
    filter_upwards [Ioo_mem_nhdsGT hm] with ρ hρ
    have h1 : c ≤ x - ρ := by linarith [min_le_left (x - c) (d - x), hρ.2]
    have h2 : x + ρ ≤ d := by linarith [min_le_right (x - c) (d - x), hρ.2]
    have hle : x - ρ ≤ x + ρ := by linarith [hρ.1]
    rw [setAverage_eq, Real.closedBall_eq_Icc, integral_Icc_eq_integral_Ioc,
      ← intervalIntegral.integral_of_le hle, ← hWsub, hW0 _ ⟨by linarith, h2⟩,
      hW0 _ ⟨h1, by linarith⟩, sub_zero, smul_zero]
  have hwbx : wb x = 0 :=
    tendsto_nhds_unique hlim (tendsto_const_nhds.congr' (hzero.mono fun ρ hρ => hρ.symm))
  rwa [hwb, indicator_of_mem hxJ] at hwbx
/-- **Reduction of a product-tested integral to one variable** (step 7 of the `α`-homogeneity
rigidity at the edge of a planar sector of a 2-dimensional minimizing cone, Simon 7.3.3).  If
`H(p) = h(p.1)` for a.e. `p ∈ O = (a, b) × (c, d)`, `f = 0` off `(a, b)`, `ψ₀ = 0` off `(c, d)`
and `∫ ψ₀ = 1`, then `∫ f(p.1) ψ₀(p.2) H(p) dp = ∫ f h`.  The integrand vanishes off `O` and
equals `(f h)(p.1) ψ₀(p.2)` a.e. on `O`; `setIntegral_prod_mul` (no integrability needed) factors
the box integral as `(∫_{(a,b)} f h) (∫_{(c,d)} ψ₀)`, and both factors are whole-line integrals. -/
theorem Submission.idtp_cse_ah_product_integral_reduce : ∀ (a b c d : ℝ) (H : ℝ × ℝ → ℝ) (h f ψ₀ : ℝ → ℝ), (∀ᵐ p : ℝ × ℝ, p ∈ Ioo a b ×ˢ Ioo c d → H p = h p.1) → (∀ t, t ∉ Ioo a b → f t = 0) → (∀ α, α ∉ Ioo c d → ψ₀ α = 0) → ∫ α, ψ₀ α = 1 → ∫ p : ℝ × ℝ, f p.1 * ψ₀ p.2 * H p = ∫ t, f t * h t := by
  intro a b c d H h f ψ₀ hH hf hψ hψ1
  -- step 1: the integrand vanishes off the box `O = (a, b) × (c, d)`
  have hvan : ∀ p : ℝ × ℝ, p ∉ Ioo a b ×ˢ Ioo c d → f p.1 * ψ₀ p.2 * H p = 0 := by
    intro p hp
    rcases not_and_or.mp hp with hp1 | hp2
    · rw [hf _ hp1, zero_mul, zero_mul]
    · rw [hψ _ hp2, mul_zero, zero_mul]
  -- step 2: on `O`, `H p = h p.1` almost everywhere
  have hO : ∫ p in Ioo a b ×ˢ Ioo c d, f p.1 * ψ₀ p.2 * H p =
      ∫ p in Ioo a b ×ˢ Ioo c d, f p.1 * h p.1 * ψ₀ p.2 := by
    refine setIntegral_congr_ae (measurableSet_Ioo.prod measurableSet_Ioo) ?_
    filter_upwards [hH] with p hp hpO
    rw [hp hpO, mul_right_comm]
  -- step 3: `volume = volume.prod volume` on `ℝ × ℝ`, and the box integral factors
  have hprod : ∫ p in Ioo a b ×ˢ Ioo c d, f p.1 * h p.1 * ψ₀ p.2 =
      (∫ t in Ioo a b, f t * h t) * ∫ α in Ioo c d, ψ₀ α := by
    rw [Measure.volume_eq_prod]
    exact setIntegral_prod_mul (fun t => f t * h t) ψ₀ (Ioo a b) (Ioo c d)
  -- step 4: both factors are whole-line integrals, and `∫ ψ₀ = 1`
  have hfh : ∀ t, t ∉ Ioo a b → f t * h t = 0 := fun t ht => by rw [hf t ht, zero_mul]
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero hvan, hO, hprod,
    setIntegral_eq_integral_of_forall_compl_eq_zero hψ, hψ1, mul_one,
    setIntegral_eq_integral_of_forall_compl_eq_zero hfh]
/-- **Almost-everywhere scaling from a weak scaling identity.**  Let `r > 0` and let `h : ℝ → ℝ`
be integrable on `J = (a, b)` and on `(ra, rb)`.  If `∫ l(t/r) h(t) dt = r² ∫ l(t) h(t) dt` for
every `C¹` function `l` with `spt l ⊆ J`, then `h(ru) = r h(u)` for a.e. `u ∈ J`.  The change of
variables `t = ru` gives `∫ l(t/r) h(t) dt = r ∫ l(u) h(ru) du`, so `∫ l(u) F(u) du = 0` for
`F(u) = h(ru) − r h(u)`, which is integrable on `J` (`u ↦ h(ru)` agrees there with
`1_{(ra, rb)} h (r ·)`).  The fundamental lemma on the open set `J` gives `F = 0` a.e. on `J`. -/
theorem Submission.idtp_cse_ah_ae_scaling_of_weak_scaling : ∀ (a b r : ℝ) (h : ℝ → ℝ), 0 < r → IntegrableOn h (Ioo a b) → IntegrableOn h (Ioo (r * a) (r * b)) → (∀ l : ℝ → ℝ, ContDiff ℝ 1 l → tsupport l ⊆ Ioo a b → ∫ t, l (t / r) * h t = r ^ 2 * ∫ t, l t * h t) → ∀ᵐ u, u ∈ Ioo a b → h (r * u) = r * h u := by
  intro a b r h hr hJ hrJ hw
  -- `u ↦ h (r u)` is integrable on `J = (a, b)`: it agrees there with `1_{(ra, rb)} h (r ·)`
  have hhr : IntegrableOn (fun u => h (r * u)) (Ioo a b) := by
    have h2 : Integrable (fun u => (Ioo (r * a) (r * b)).indicator h (r * u)) :=
      (hrJ.integrable_indicator measurableSet_Ioo).comp_mul_left' hr.ne'
    refine h2.integrableOn.congr_fun (fun u hu => ?_) measurableSet_Ioo
    exact indicator_of_mem (show r * u ∈ Ioo (r * a) (r * b) from
      ⟨mul_lt_mul_of_pos_left hu.1 hr, mul_lt_mul_of_pos_left hu.2 hr⟩) h
  -- `F(u) = h (r u) - r h u` is integrable on `J`
  have hF : IntegrableOn (fun u => h (r * u) - r * h u) (Ioo a b) := hhr.sub (hJ.const_mul r)
  -- fundamental lemma on `J`
  have key := isOpen_Ioo.ae_eq_zero_of_integral_contDiff_smul_eq_zero hF.locallyIntegrableOn ?_
  · filter_upwards [key] with u hu hmem
    exact sub_eq_zero.mp (hu hmem)
  intro g hg hgc hgs
  have hgcont : Continuous g := hg.continuous
  obtain ⟨C, hC⟩ := hgc.exists_bound_of_continuous hgcont
  have hgz : ∀ u, u ∉ Ioo a b → g u = 0 := fun u hu =>
    image_eq_zero_of_notMem_tsupport fun hu' => hu (hgs hu')
  -- `g h(r ·)` and `g h` are integrable on `ℝ` (`g` is bounded and vanishes off `J`)
  have hI : ∀ k : ℝ → ℝ, IntegrableOn k (Ioo a b) → Integrable (fun u => g u * k u) := by
    intro k hk
    refine ((hk.integrable_indicator measurableSet_Ioo).bdd_mul hgcont.aestronglyMeasurable
      (Eventually.of_forall hC)).congr (Eventually.of_forall fun u => ?_)
    by_cases hu : u ∈ Ioo a b
    · simp only [indicator_of_mem hu]
    · simp only [hgz u hu, zero_mul]
  -- change of variables `t = r u`: `∫ g(u) h(r u) du = r⁻¹ ∫ g(t/r) h(t) dt`
  have hcv : ∫ u, g u * h (r * u) = r⁻¹ * ∫ t, g (t / r) * h t := by
    have := Measure.integral_comp_mul_left (fun t => g (t / r) * h t) r
    simp only [mul_div_cancel_left₀ _ hr.ne'] at this
    rw [this, abs_of_pos (inv_pos.mpr hr), smul_eq_mul]
  have hid := hw g (hg.of_le (by exact_mod_cast le_top)) hgs
  calc ∫ u, g u • (h (r * u) - r * h u)
      = ∫ u, (g u * h (r * u) - r * (g u * h u)) := by
        congr 1; ext u; rw [smul_eq_mul]; ring
    _ = (∫ u, g u * h (r * u)) - r * ∫ u, g u * h u := by
        rw [integral_sub (hI _ hhr) ((hI _ hJ).const_mul r), integral_const_mul]
    _ = 0 := by
        rw [hcv, hid, ← mul_assoc, pow_two, ← mul_assoc, inv_mul_cancel₀ hr.ne', one_mul, sub_self]
/-- **A.e. degree-one homogeneity forces linearity near `1`** (step 8 of the rigidity lemma
`idtp_cse_alpha_invariant_homogeneous`, towards Simon 7.3.3).  Let `0 < s ≤ 1` and let `h` be
a.e.-strongly measurable on `I = (1 - s, 1 + s)`.  If for every `r` with `|r - 1| < s/4`,
`h (r u) = r h u` for a.e. `u ∈ (1 - s/2, 1 + s/2)`, then `h v = c v` for a.e.
`v ∈ (1 - s/8, 1 + s/8)`.  Pass to a measurable `h'` with `h = h'` a.e. on `I` (`u ↦ r u` maps
`(1 - s/2, 1 + s/2)` into `I` and pulls null sets back to null sets) and put `g v = h' v / v`, so
`g (r u) = g u` for a.e. `u`.  Tonelli swaps the quantifiers, giving `u₀ ∈ (1 - s/16, 1 + s/16)`
with `g (r u₀) = g u₀` for a.e. `r ∈ (1 - s/4, 1 + s/4)`; rescaling by `u₀` gives `g = c := g u₀`
a.e. on `(1 - s/8, 1 + s/8)`. -/
theorem Submission.idtp_cse_ah_ae_linear_of_ae_scaling : ∀ (s : ℝ) (h : ℝ → ℝ), 0 < s → s ≤ 1 → AEStronglyMeasurable h (volume.restrict (Ioo (1 - s) (1 + s))) → (∀ r : ℝ, |r - 1| < s / 4 → ∀ᵐ u, u ∈ Ioo (1 - s / 2) (1 + s / 2) → h (r * u) = r * h u) → ∃ c : ℝ, ∀ᵐ v, v ∈ Ioo (1 - s / 8) (1 + s / 8) → h v = c * v := by
  intro s h hs hs1 hmeas hscal
  -- a measurable `h'` with `h = h'` a.e. on `I = (1 - s, 1 + s)`
  obtain ⟨h', hh', hhh'⟩ := hmeas
  have hI : ∀ᵐ v, v ∈ Ioo (1 - s) (1 + s) → h v = h' v :=
    (ae_restrict_iff' measurableSet_Ioo).1 hhh'
  -- for `r ∈ R = (1 - s/4, 1 + s/4)`: `h' (r u) = r h' u` for a.e. `u ∈ I₁ = (1 - s/2, 1 + s/2)`
  have hscal' : ∀ r ∈ Ioo (1 - s / 4) (1 + s / 4),
      ∀ᵐ u, u ∈ Ioo (1 - s / 2) (1 + s / 2) → h' (r * u) = r * h' u := by
    intro r hr
    have hr0 : 0 < r := by linarith [hr.1]
    -- `u ↦ r u` maps `I₁` into `I`, and the preimage of the null set `{h ≠ h'} ∩ I` is null
    have h1 : ∀ᵐ u, u ∈ Ioo (1 - s / 2) (1 + s / 2) → h (r * u) = h' (r * u) := by
      rw [ae_iff]
      refine measure_mono_null (fun u hu => ?_)
        ((Real.volume_preimage_mul_left hr0.ne' _).trans (by rw [ae_iff.1 hI, mul_zero]))
      simp only [mem_ofPred_eq, not_imp, mem_preimage, mem_Ioo] at hu ⊢
      obtain ⟨⟨hu1, hu2⟩, hu3⟩ := hu
      have hu0 : 0 < u := by linarith
      refine ⟨⟨?_, ?_⟩, hu3⟩
      · nlinarith [mul_pos (sub_pos.2 hr.1) (sub_pos.2 hu1),
          mul_pos (by linarith : (0 : ℝ) < 1 - s / 4) (sub_pos.2 hu1),
          mul_pos (by linarith : (0 : ℝ) < 1 - s / 2) (sub_pos.2 hr.1), mul_pos hs hs]
      · nlinarith [mul_pos (sub_pos.2 hr.2) (sub_pos.2 hu2), mul_pos hr0 (sub_pos.2 hu2),
          mul_pos hu0 (sub_pos.2 hr.2), mul_nonneg hs.le (sub_nonneg.2 hs1)]
    have hr' : |r - 1| < s / 4 := abs_sub_lt_iff.2 ⟨by linarith [hr.2], by linarith [hr.1]⟩
    filter_upwards [hscal r hr', h1, hI] with u hu1 hu2 hu3 hu
    rw [← hu2 hu, hu1 hu, hu3 ⟨by linarith [hu.1], by linarith [hu.2]⟩]
  -- the quotient `g v = h' v / v` satisfies `g (r u) = g u` for a.e. `u ∈ I₁`, for each `r ∈ R`
  obtain ⟨g, hg, hgdef⟩ : ∃ g : ℝ → ℝ, Measurable g ∧ ∀ v, g v = h' v / v :=
    ⟨fun v => h' v / v, hh'.measurable.div measurable_id, fun v => rfl⟩
  have hginv : ∀ r ∈ Ioo (1 - s / 4) (1 + s / 4),
      ∀ᵐ u ∂(volume.restrict (Ioo (1 - s / 2) (1 + s / 2))), g (r * u) = g u := by
    intro r hr
    rw [ae_restrict_iff' measurableSet_Ioo]
    filter_upwards [hscal' r hr] with u hu1 hu
    rw [hgdef, hgdef, hu1 hu, mul_div_mul_left _ _ (by linarith [hr.1] : r ≠ 0)]
  -- Tonelli: for a.e. `u ∈ I₁`, `g (r u) = g u` for a.e. `r ∈ R`
  have hE : MeasurableSet {p : ℝ × ℝ | g (p.2 * p.1) = g p.1} :=
    measurableSet_eq_fun (hg.comp (measurable_snd.mul measurable_fst)) (hg.comp measurable_fst)
  have hswap : ∀ᵐ u ∂(volume.restrict (Ioo (1 - s / 2) (1 + s / 2))),
      ∀ᵐ r ∂(volume.restrict (Ioo (1 - s / 4) (1 + s / 4))), g (r * u) = g u :=
    (Measure.ae_ae_comm (p := fun u r => g (r * u) = g u) hE).2
      (ae_restrict_of_forall_mem measurableSet_Ioo hginv)
  -- choose such a `u₀ ∈ I₃ = (1 - s/16, 1 + s/16)`; put `c = g u₀`
  have hI₃ : volume.restrict (Ioo (1 - s / 2) (1 + s / 2)) (Ioo (1 - s / 16) (1 + s / 16)) ≠ 0 := by
    rw [Measure.restrict_apply measurableSet_Ioo,
      inter_eq_left.2 (Ioo_subset_Ioo (by linarith) (by linarith)), Real.volume_Ioo]
    exact (ENNReal.ofReal_pos.2 (by linarith)).ne'
  obtain ⟨u₀, hu₀, hu₀ae⟩ := Measure.exists_mem_of_measure_ne_zero_of_ae hI₃ (ae_restrict_of_ae hswap)
  have hu₀0 : 0 < u₀ := by linarith [hu₀.1]
  have hA : ∀ᵐ r, r ∈ Ioo (1 - s / 4) (1 + s / 4) → g (r * u₀) = g u₀ :=
    (ae_restrict_iff' measurableSet_Ioo).1 hu₀ae
  -- rescaling `v ↦ v / u₀`: `g v = c` for a.e. `v ∈ I₂ = (1 - s/8, 1 + s/8)`
  have hgc : ∀ᵐ v, v ∈ Ioo (1 - s / 8) (1 + s / 8) → g v = g u₀ := by
    rw [ae_iff]
    refine measure_mono_null (fun v hv => ?_)
      ((Real.volume_preimage_mul_left (inv_ne_zero hu₀0.ne') _).trans (by rw [ae_iff.1 hA, mul_zero]))
    simp only [mem_ofPred_eq, not_imp, mem_preimage, mem_Ioo] at hv ⊢
    obtain ⟨⟨hv1, hv2⟩, hv3⟩ := hv
    have hvu : u₀⁻¹ * v * u₀ = v := by field_simp
    refine ⟨⟨?_, ?_⟩, by rwa [hvu]⟩
    · rw [← div_eq_inv_mul, lt_div_iff₀ hu₀0]
      nlinarith [hu₀.2, mul_pos (by linarith : (0 : ℝ) < 1 - s / 4) (sub_pos.2 hu₀.2), mul_pos hs hs]
    · rw [← div_eq_inv_mul, div_lt_iff₀ hu₀0]
      nlinarith [hu₀.1, mul_pos (by linarith : (0 : ℝ) < 1 + s / 4) (sub_pos.2 hu₀.1),
        mul_nonneg hs.le (sub_nonneg.2 hs1)]
  -- conclusion: `h v = h' v = v g v = c v` for a.e. `v ∈ I₂`
  refine ⟨g u₀, ?_⟩
  filter_upwards [hI, hgc] with v hv1 hv2 hv
  have hv0 : v ≠ 0 := by linarith [hv.1]
  rw [hv1 ⟨by linarith [hv.1], by linarith [hv.2]⟩, ← hv2 hv, hgdef, div_mul_cancel₀ _ hv0]

/-- Test functions for the `α`-independence step of the cone-sector endpoint density argument
(Simon 7.3.3): the primitive of a mean-zero continuous test function is a `C¹` test function.
Let `ψ(x) = ∫_c^x g`, so `ψ' = g` by the fundamental theorem of calculus and `ψ` is `C¹`.  If
`spt g ≠ ∅`, let `p = min spt g` and `q = max spt g`, so `c < p ≤ q < d`.  Then `ψ = 0` on
`(-∞, p)`, as `g` vanishes between `c` and `x`, and `ψ(x) = ∫ g = 0` for `x > q`.  Hence
`spt ψ ⊆ [p, q] ⊆ (c, d)`. -/
theorem Submission.idtp_cse_ah_antiderivative_test : ∀ (c d : ℝ) (g : ℝ → ℝ), Continuous g → tsupport g ⊆ Ioo c d → ∫ α, g α = 0 → ∃ ψ : ℝ → ℝ, ContDiff ℝ 1 ψ ∧ tsupport ψ ⊆ Ioo c d ∧ deriv ψ = g := by
  intro c d g hg hgcd hg0
  -- step 3: `ψ(x) = ∫_c^x g` has derivative `g x` at every `x` (FTC for the continuous `g`)
  have hψ : ∀ x, HasDerivAt (fun y => ∫ α in c..y, g α) (g x) x := fun x =>
    intervalIntegral.integral_hasDerivAt_right (hg.intervalIntegrable c x)
      (hg.stronglyMeasurableAtFilter _ _) hg.continuousAt
  have hdψ : deriv (fun y => ∫ α in c..y, g α) = g := funext fun x => (hψ x).deriv
  -- step 4: `ψ` is differentiable with continuous derivative `g`, hence `C¹`
  refine ⟨fun y => ∫ α in c..y, g α,
    contDiff_one_iff_deriv.2 ⟨fun x => (hψ x).differentiableAt, hdψ.symm ▸ hg⟩, ?_, hdψ⟩
  -- step 2: if `spt g = ∅`, then `g = 0` and `ψ = 0`
  rcases (tsupport g).eq_empty_or_nonempty with he | hne
  · obtain rfl := tsupport_eq_empty_iff.1 he
    simp
  -- step 1: `spt g` is a closed subset of `[c, d]`, hence compact; `p = min spt g` and
  -- `q = max spt g` lie in `spt g ⊆ (c, d)`, and `g = 0` off `[p, q]`
  have hK : IsCompact (tsupport g) :=
    isCompact_Icc.of_isClosed_subset (isClosed_tsupport g) (hgcd.trans Ioo_subset_Icc_self)
  have hp := hgcd (hK.sInf_mem hne)
  have hq := hgcd (hK.sSup_mem hne)
  have hpq : sInf (tsupport g) ≤ sSup (tsupport g) := csInf_le hK.bddBelow (hK.sSup_mem hne)
  have hgpq : ∀ α ∉ Icc (sInf (tsupport g)) (sSup (tsupport g)), g α = 0 := fun α hα =>
    image_eq_zero_of_notMem_tsupport fun h =>
      hα ⟨csInf_le hK.bddBelow h, le_csSup hK.bddAbove h⟩
  -- step 6: `spt ψ ⊆ [p, q] ⊆ (c, d)`, once `ψ = 0` off `[p, q]`
  refine (closure_minimal (support_subset_iff'.2 fun x hx => ?_) isClosed_Icc).trans
    (Icc_subset_Ioo hp.1 hq.2)
  show ∫ α in c..x, g α = 0
  -- step 5: `ψ = 0` off `[p, q]`
  rcases not_and_or.1 hx with hx | hx <;> rw [not_le] at hx
  · -- `x < p`: `g` vanishes on `Ι c x`, which lies left of `p`
    refine intervalIntegral.integral_zero_ae
      (Eventually.of_forall fun α hα => hgpq α fun h => ?_)
    exact lt_irrefl _ ((h.1.trans hα.2).trans_lt (max_lt hp.1 hx))
  · -- `x > q`: `ψ(x) = ∫_{(c, x]} g = ∫ g = 0`, as `g` vanishes off `[p, q] ⊆ (c, x]`
    rw [intervalIntegral.integral_of_le (hp.1.trans_le (hpq.trans hx.le)).le,
      setIntegral_eq_integral_of_forall_compl_eq_zero, hg0]
    exact fun α hα => hgpq α fun h => hα ⟨hp.1.trans_le h.1, h.2.trans hx.le⟩
/-- **Product-tested vanishing forces a.e. vanishing of slice integrals** (step 2 of the
`α`-homogeneity step in the cone-sector endpoint density argument for Simon 7.3.3).  Let
`I = (a, b)`, `J = (c, d)`, `H` integrable on `I × J` and `g` continuous with `tsupport g ⊆ J`.
If `∫ g(α) l(t) H(t, α) = 0` for every `C¹` function `l` with `tsupport l ⊆ I`, then
`Φ(t) = ∫_J g(α) H(t, α) dα` vanishes for a.e. `t ∈ I`.  As `g` is bounded, `g(α) H(t, α)` is
integrable for `vol|I ⊗ vol|J = vol|(I × J)` and `Φ` is integrable on `I` (Fubini).  The test
integrand vanishes off `I × J`, so Fubini turns the hypothesis into `∫ l Φ = 0` for every smooth
`l` with compact support in `I`, and the fundamental lemma on the open set `I` applies. -/
theorem Submission.idtp_cse_ah_slice_integral_ae_zero : ∀ (a b c d : ℝ) (H : ℝ × ℝ → ℝ) (g : ℝ → ℝ), IntegrableOn H (Ioo a b ×ˢ Ioo c d) → Continuous g → tsupport g ⊆ Ioo c d → (∀ l : ℝ → ℝ, ContDiff ℝ 1 l → tsupport l ⊆ Ioo a b → ∫ p : ℝ × ℝ, g p.2 * l p.1 * H p = 0) → ∀ᵐ t, t ∈ Ioo a b → ∫ α in Ioo c d, g α * H (t, α) = 0 := by
  intro a b c d H g hH hg hgs htest
  -- step 1: `H` is integrable for `μ.prod ν`, `μ = vol|I`, `ν = vol|J`
  have hH' : Integrable H ((volume.restrict (Ioo a b)).prod (volume.restrict (Ioo c d))) := by
    rw [Measure.prod_restrict, ← Measure.volume_eq_prod]
    exact hH
  -- step 2: `g` is bounded, so `K(t, α) = g α * H (t, α)` is integrable for `μ.prod ν`
  have hgc : HasCompactSupport g :=
    isCompact_Icc.of_isClosed_subset (isClosed_tsupport g) (hgs.trans Ioo_subset_Icc_self)
  obtain ⟨M, hM⟩ := hgc.exists_bound_of_continuous hg
  have hK : Integrable (fun p : ℝ × ℝ => g p.2 * H p)
      ((volume.restrict (Ioo a b)).prod (volume.restrict (Ioo c d))) :=
    hH'.bdd_mul (hg.comp continuous_snd).aestronglyMeasurable (Eventually.of_forall fun p => hM p.2)
  -- step 3: `Φ(t) = ∫_J g α H(t, α) dα` is integrable on `I` (Fubini)
  have hΦ : IntegrableOn (fun t => ∫ α in Ioo c d, g α * H (t, α)) (Ioo a b) := hK.integral_prod_left
  -- step 5: the fundamental lemma on the open interval `I`
  refine isOpen_Ioo.ae_eq_zero_of_integral_contDiff_smul_eq_zero hΦ.locallyIntegrableOn
    fun l hl hlc hls => ?_
  -- step 4: `∫ l Φ = ∫_{I × J} g(p.2) l(p.1) H(p) = ∫_{ℝ²} g(p.2) l(p.1) H(p) = 0`
  obtain ⟨L, hL⟩ := hlc.exists_bound_of_continuous hl.continuous
  have hl0 : ∀ t ∉ Ioo a b, l t = 0 := fun t ht => image_eq_zero_of_notMem_tsupport fun h => ht (hls h)
  have hg0 : ∀ α ∉ Ioo c d, g α = 0 := fun α hα => image_eq_zero_of_notMem_tsupport fun h => hα (hgs h)
  have hlK : Integrable (fun p : ℝ × ℝ => g p.2 * l p.1 * H p)
      ((volume.restrict (Ioo a b)).prod (volume.restrict (Ioo c d))) :=
    (hK.bdd_mul (f := fun p => l p.1) (hl.continuous.comp continuous_fst).aestronglyMeasurable
      (Eventually.of_forall fun p => hL p.1)).congr (Eventually.of_forall fun p => by ring)
  rw [← htest l (hl.of_le (by exact_mod_cast le_top)) hls,
    ← setIntegral_eq_integral_of_forall_compl_eq_zero (s := Ioo a b) fun t ht => by
      rw [hl0 t ht, zero_smul],
    ← setIntegral_eq_integral_of_forall_compl_eq_zero (s := Ioo a b ×ˢ Ioo c d) fun p hp => by
      rcases not_and_or.mp hp with hp | hp
      · rw [hl0 _ hp, mul_zero, zero_mul]
      · rw [hg0 _ hp, zero_mul, zero_mul],
    Measure.volume_eq_prod, ← Measure.prod_restrict, integral_prod _ hlK]
  refine integral_congr_ae (Eventually.of_forall fun t => ?_)
  simp only [smul_eq_mul]
  rw [← integral_const_mul]
  refine integral_congr_ae (Eventually.of_forall fun α => ?_)
  simp only
  ring
/-- **Countable separating `C¹` tests on an interval** (replaces the separability of `C([−s, s])`
in the `α`-homogeneity step of the cone-sector endpoint density argument for Simon 7.3.3).  For
reals `c, d` there are `C¹` functions `Fₙ` with `tsupport Fₙ ⊆ (c, d)` such that every `w`
integrable on `(c, d)` with `∫ Fₙ w = 0` for all `n` vanishes a.e. on `(c, d)`.  Enumerate the
triples `(p, q, k) ∈ ℚ × ℚ × ℕ` by a surjection `e : ℕ → ℚ × ℚ × ℕ`, and let `Fₙ` be the `k`-th
`C¹` plateau `χ_{p,q,k}` (`tsupport ⊆ [p, q]`) if `c < p < q < d`, and `0` otherwise.  For such
`p, q` the plateaus vanish off `(c, d)`, so with `w̄ = 1_{(c,d)} w` integrable,
`∫_{(p,q)} w = ∫_{(p,q)} w̄ = lim_k ∫ χ_{p,q,k} w̄ = lim_k ∫ χ_{p,q,k} w = 0`; vanishing on all
rational subintervals gives `w = 0` a.e. on `(c, d)`. -/
theorem Submission.idtp_cse_ah_countable_separating_tests : ∀ c d : ℝ, ∃ F : ℕ → ℝ → ℝ, (∀ n, ContDiff ℝ 1 (F n)) ∧ (∀ n, tsupport (F n) ⊆ Ioo c d) ∧ ∀ w : ℝ → ℝ, IntegrableOn w (Ioo c d) → (∀ n, ∫ α, F n α * w α = 0) → ∀ᵐ α, α ∈ Ioo c d → w α = 0 := by
  intro c d
  classical
  -- plateaus `χ p q k`: `C¹`, `tsupport ⊆ [p, q]`, and `∫ χ p q k · g → ∫_{(p,q)} g`
  choose χ hχC hχS hχT using Submission.idtp_cse_ah_cst_plateau_weak_limit
  -- an enumeration `e` of the triples `(p, q, k)`; `A t` says `c < p < q < d`
  obtain ⟨e, he⟩ := exists_surjective_nat (ℚ × ℚ × ℕ)
  let A : ℚ × ℚ × ℕ → Prop := fun t => c < (t.1 : ℝ) ∧ (t.1 : ℝ) < t.2.1 ∧ (t.2.1 : ℝ) < d
  refine ⟨fun n => if A (e n) then χ (e n).1 (e n).2.1 (e n).2.2 else 0, fun n => ?_, fun n => ?_,
    ?_⟩
  · dsimp only
    split_ifs
    · exact hχC _ _ _
    · exact contDiff_zero_fun
  -- `tsupport Fₙ ⊆ [p, q] ⊆ (c, d)`, or `Fₙ = 0`
  · dsimp only
    split_ifs with h
    · exact (hχS _ _ _).trans (Icc_subset_Ioo h.1 h.2.2)
    · simp
  -- it suffices that `∫_{(p,q)} w = 0` for rationals `c < p < q < d`
  · intro w hw hF
    refine Submission.idtp_cse_ah_cst_ae_zero_of_rat_intervals c d w hw fun p q hcp hpq hqd => ?_
    have hg : Integrable ((Ioo c d).indicator w) := hw.integrable_indicator measurableSet_Ioo
    -- `∫ χ p q k · w̄ = ∫ Fₙ w = 0` for `e n = (p, q, k)`, since `χ p q k = 0` off `(c, d)`
    have hzero : ∀ k, ∫ α, χ p q k α * (Ioo c d).indicator w α = 0 := by
      intro k
      obtain ⟨n, hn⟩ := he (p, q, k)
      have hA : A (e n) := by rw [hn]; exact ⟨hcp, hpq, hqd⟩
      have h := hF n
      dsimp only at h
      rw [ite_eq_left hA, hn] at h
      rw [← h]
      congr 1
      funext α
      by_cases hα : α ∈ Ioo c d
      · rw [indicator_of_mem hα]
      · have hα' : α ∉ tsupport (χ p q k) :=
          fun h' => hα ((hχS _ _ _).trans (Icc_subset_Ioo hcp hqd) h')
        simp [image_eq_zero_of_notMem_tsupport hα']
    -- so `∫_{(p,q)} w̄ = lim_k ∫ χ p q k · w̄ = 0`, and `w̄ = w` on `(p, q)`
    have hlim := hχT p q _ hg
    simp only [hzero] at hlim
    rw [← tendsto_nhds_unique hlim tendsto_const_nhds]
    exact (setIntegral_congr_fun measurableSet_Ioo fun α hα =>
      indicator_of_mem (Ioo_subset_Ioo hcp.le hqd.le hα) w).symm

/-- **Slices are a.e. constant** (one-variable du Bois-Reymond lemma, with a parameter).  Let
`I = (a, b)`, `J = (c, d)` with `c < d`, and let `H` be integrable on `I × J` with
`∫ ψ′(α) l(t) H(t, α) = 0` for all `C¹` functions `ψ`, `l` supported in `J`, `I`.  Fix a normalized
`C¹` bump `χ` and a countable separating family `F n` of `C¹` tests in `J`.  Then
`g n = F n − (∫ F n) χ` has mean zero, so `g n = ψ n′` with `ψ n ∈ C¹` supported in `J`, and the
hypothesis gives `∫_J g n H(t, ·) = 0` for a.e. `t ∈ I`.  By Fubini the slice `H(t, ·)` is
integrable on `J` for a.e. `t ∈ I`.  For such `t`, `w = H(t, ·) − ∫_J χ H(t, ·)` is integrable on
`J` and satisfies `∫ F n w = 0` for all `n`, so `w = 0` a.e. on `J`. -/
theorem Submission.idtp_cse_ah_slice_ae_const : ∀ (a b c d : ℝ) (H : ℝ × ℝ → ℝ), c < d → IntegrableOn H (Ioo a b ×ˢ Ioo c d) → (∀ ψ l : ℝ → ℝ, ContDiff ℝ 1 ψ → ContDiff ℝ 1 l → tsupport ψ ⊆ Ioo c d → tsupport l ⊆ Ioo a b → ∫ p : ℝ × ℝ, deriv ψ p.2 * l p.1 * H p = 0) → ∀ᵐ t, t ∈ Ioo a b → ∃ k : ℝ, ∀ᵐ α, α ∈ Ioo c d → H (t, α) = k := by
  intro a b c d H hcd hH hweak
  -- Step 1: the normalized bump `χ` and the separating family `F n`, all supported in `J`; they
  -- are continuous with compact support, hence integrable, bounded and zero off `J`
  obtain ⟨χ, hχ_diff, hχ_supp, hχ_int⟩ := Submission.idtp_cse_ah_normalized_bump c d hcd
  obtain ⟨F, hF_diff, hF_supp, hF_sep⟩ := Submission.idtp_cse_ah_countable_separating_tests c d
  have hJ_cpt : ∀ f : ℝ → ℝ, tsupport f ⊆ Ioo c d → HasCompactSupport f := fun f hf =>
    isCompact_Icc.of_isClosed_subset (isClosed_tsupport f) (hf.trans Ioo_subset_Icc_self)
  have hJ_zero : ∀ f : ℝ → ℝ, tsupport f ⊆ Ioo c d → ∀ α, α ∉ Ioo c d → f α = 0 :=
    fun f hf α hα => image_eq_zero_of_notMem_tsupport fun h => hα (hf h)
  have hχ_integrable : Integrable χ :=
    hχ_diff.continuous.integrable_of_hasCompactSupport (hJ_cpt χ hχ_supp)
  have hF_integrable : ∀ n, Integrable (F n) := fun n =>
    (hF_diff n).continuous.integrable_of_hasCompactSupport (hJ_cpt (F n) (hF_supp n))
  obtain ⟨Cχ, hCχ⟩ := hχ_diff.continuous.bounded_above_of_compact_support (hJ_cpt χ hχ_supp)
  choose CF hCF using fun n =>
    (hF_diff n).continuous.bounded_above_of_compact_support (hJ_cpt (F n) (hF_supp n))
  -- Step 2: `g n = F n - (∫ F n) χ` is continuous, supported in `J` and of mean zero, so it is
  -- the derivative of some `ψ n ∈ C¹` supported in `J`
  obtain ⟨g, hg⟩ : ∃ g : ℕ → ℝ → ℝ, ∀ n, g n = fun α => F n α - (∫ β, F n β) * χ α :=
    ⟨_, fun _ => rfl⟩
  have hg_cont : ∀ n, Continuous (g n) := fun n => by
    rw [hg n]
    exact (hF_diff n).continuous.sub (continuous_const.mul hχ_diff.continuous)
  have hg_supp : ∀ n, tsupport (g n) ⊆ Ioo c d := fun n => by
    rw [hg n]
    exact (tsupport_sub _ _).trans (union_subset (hF_supp n)
      ((tsupport_mul_subset_right (f := fun _ => ∫ β, F n β) (g := χ)).trans hχ_supp))
  have hg_mean : ∀ n, ∫ α, g n α = 0 := fun n => by
    rw [hg n, integral_sub (hF_integrable n) (hχ_integrable.const_mul _), integral_const_mul, hχ_int,
      mul_one, sub_self]
  choose ψ hψ_diff hψ_supp hψ_deriv using fun n =>
    Submission.idtp_cse_ah_antiderivative_test c d (g n) (hg_cont n) (hg_supp n) (hg_mean n)
  -- Step 3: the hypothesis with `ψ n` gives `∫_J g n H(t, ·) = 0` for a.e. `t ∈ I`
  have hslice : ∀ n, ∀ᵐ t, t ∈ Ioo a b → ∫ α in Ioo c d, g n α * H (t, α) = 0 := fun n =>
    Submission.idtp_cse_ah_slice_integral_ae_zero a b c d H (g n) hH (hg_cont n) (hg_supp n)
      fun l hl_diff hl_supp => by
        have h := hweak (ψ n) l (hψ_diff n) hl_diff (hψ_supp n) hl_supp
        rwa [hψ_deriv n] at h
  -- Step 4: Fubini; for a.e. `t ∈ I` the slice `H(t, ·)` is integrable on `J`
  have hH' : Integrable H ((volume.restrict (Ioo a b)).prod (volume.restrict (Ioo c d))) := by
    rw [Measure.prod_restrict, ← Measure.volume_eq_prod]
    exact hH
  have hslice_int : ∀ᵐ t, t ∈ Ioo a b → IntegrableOn (fun α => H (t, α)) (Ioo c d) :=
    (ae_restrict_iff' measurableSet_Ioo).mp hH'.prod_right_ae
  -- Step 5: intersect the countably many full-measure sets and fix a good `t`
  filter_upwards [ae_all_iff.mpr hslice, hslice_int] with t ht hti htI
  have hHt : Integrable (fun α => H (t, α)) (volume.restrict (Ioo c d)) := hti htI
  -- Step 6: `w = H(t, ·) - k` with `k = ∫_J χ H(t, ·)` is integrable on `J` and `∫ F n w = 0`
  set k : ℝ := ∫ α in Ioo c d, χ α * H (t, α)
  refine ⟨k, ?_⟩
  have hw_int : IntegrableOn (fun α => H (t, α) - k) (Ioo c d) :=
    hHt.sub (integrableOn_const measure_Ioo_lt_top.ne)
  have hFH_int : ∀ n, Integrable (fun α => F n α * H (t, α)) (volume.restrict (Ioo c d)) :=
    fun n => hHt.bdd_mul (hF_diff n).continuous.aestronglyMeasurable
      (Eventually.of_forall (hCF n))
  have hχH_int : Integrable (fun α => χ α * H (t, α)) (volume.restrict (Ioo c d)) :=
    hHt.bdd_mul hχ_diff.continuous.aestronglyMeasurable (Eventually.of_forall hCχ)
  have hw_zero : ∀ n, ∫ α, F n α * (H (t, α) - k) = 0 := by
    intro n
    have h₁ : ∫ α, F n α * (H (t, α) - k) = ∫ α in Ioo c d, F n α * (H (t, α) - k) :=
      (setIntegral_eq_integral_of_forall_compl_eq_zero fun α hα => by
        rw [hJ_zero (F n) (hF_supp n) α hα, zero_mul]).symm
    have h₂ : ∫ α in Ioo c d, F n α * (H (t, α) - k) =
        (∫ α in Ioo c d, F n α * H (t, α)) - (∫ α in Ioo c d, F n α) * k := by
      simp_rw [mul_sub]
      rw [integral_sub (hFH_int n) ((hF_integrable n).integrableOn.mul_const k), integral_mul_const]
    have h₃ : ∫ α in Ioo c d, g n α * H (t, α) =
        (∫ α in Ioo c d, F n α * H (t, α)) - (∫ β, F n β) * k := by
      simp_rw [hg n, sub_mul, mul_assoc]
      rw [integral_sub (hFH_int n) (hχH_int.const_mul _), integral_const_mul]
    have h₄ : ∫ α in Ioo c d, F n α = ∫ α, F n α :=
      setIntegral_eq_integral_of_forall_compl_eq_zero (hJ_zero (F n) (hF_supp n))
    rw [h₁, h₂, h₄, ← h₃]
    exact ht n htI
  -- Step 7: the separating property of `F n` gives `w = 0` a.e. on `J`
  filter_upwards [hF_sep (fun α => H (t, α) - k) hw_int hw_zero] with α hα hαJ
  exact sub_eq_zero.mp (hα hαJ)
/-- **Fibrewise a.e. constancy gives the product form** (steps 1 and 6 of the `α`-homogeneity
step in the cone-sector endpoint density argument for Simon 7.3.3).  Let `c < d`, `I = (a, b)`,
`J = (c, d)` and `H` integrable on `I × J`.  If for a.e. `t ∈ I` the slice `H(t, ·)` equals a
constant `k_t` a.e. on `J`, then `H(t, α) = (d − c)⁻¹ ∫_J H(t, ·)` for a.e. `(t, α) ∈ I × J`.
Lebesgue measure on `I × J` is `μ.prod ν` with `μ = vol|I`, `ν = vol|J`.  Take a strongly
measurable `H̃ = H` a.e.; then `h̃(t) = (d − c)⁻¹ ∫_J H̃(t, ·)` is measurable and equals the slice
average `h(t)` for a.e. `t`.  As `vol J = d − c`, `k_t = h(t)`.  So the measurable set
`{H̃ = h̃ ∘ fst}` has a.e.-full sections and is conull, and `fst` carries `h̃ = h` back to the
product. -/
theorem Submission.idtp_cse_ah_ae_eq_slice_average : ∀ (a b c d : ℝ) (H : ℝ × ℝ → ℝ), c < d → IntegrableOn H (Ioo a b ×ˢ Ioo c d) → (∀ᵐ t, t ∈ Ioo a b → ∃ k : ℝ, ∀ᵐ α, α ∈ Ioo c d → H (t, α) = k) → ∀ᵐ p : ℝ × ℝ, p ∈ Ioo a b ×ˢ Ioo c d → H p = (d - c)⁻¹ * ∫ α in Ioo c d, H (p.1, α) := by
  intro a b c d H hcd hH hk
  -- step 1: `vol|(I × J) = (vol|I).prod (vol|J)`, so `H` is integrable for the product measure
  have hprod : (volume : Measure (ℝ × ℝ)).restrict (Ioo a b ×ˢ Ioo c d) =
      (volume.restrict (Ioo a b)).prod (volume.restrict (Ioo c d)) := by
    rw [Measure.volume_eq_prod, Measure.prod_restrict]
  rw [IntegrableOn, hprod] at hH
  refine (ae_restrict_iff' (measurableSet_Ioo.prod measurableSet_Ioo)).1 ?_
  rw [hprod]
  -- a strongly measurable representative `H̃ = H` a.e.
  obtain ⟨H', hH'm, hHH'⟩ := hH.aestronglyMeasurable
  -- step 2: `h̃(t) = (d - c)⁻¹ ∫_J H̃(t, ·)` is strongly measurable
  have hh'm : StronglyMeasurable fun t => (d - c)⁻¹ * ∫ β in Ioo c d, H' (t, β) :=
    hH'm.integral_prod_right'.const_mul _
  -- step 3: `h̃ = h` for a.e. `t ∈ I`
  have hhh' : ∀ᵐ t ∂volume.restrict (Ioo a b), (d - c)⁻¹ * ∫ β in Ioo c d, H' (t, β) =
      (d - c)⁻¹ * ∫ β in Ioo c d, H (t, β) := by
    filter_upwards [Measure.ae_ae_of_ae_prod hHH'] with t ht
    rw [integral_congr_ae ht]
  -- step 4: for a.e. `t ∈ I`, `H(t, ·)` is a.e. on `J` its constant `k_t`, which is the average
  have hslice : ∀ᵐ t ∂volume.restrict (Ioo a b), ∀ᵐ α ∂volume.restrict (Ioo c d),
      H (t, α) = (d - c)⁻¹ * ∫ β in Ioo c d, H (t, β) := by
    filter_upwards [(ae_restrict_iff' measurableSet_Ioo).2 hk] with t ⟨k, hk⟩
    rw [← ae_restrict_iff' measurableSet_Ioo] at hk
    rw [integral_congr_ae hk, setIntegral_const, Real.volume_real_Ioo_of_le hcd.le, smul_eq_mul,
      inv_mul_cancel_left₀ (sub_pos.2 hcd).ne']
    exact hk
  -- steps 5, 6: `{H̃ = h̃ ∘ fst}` is measurable with a.e.-full sections, hence conull
  have hE : MeasurableSet {p : ℝ × ℝ | H' p = (d - c)⁻¹ * ∫ β in Ioo c d, H' (p.1, β)} :=
    hH'm.measurableSet_eq_fun (hh'm.comp_measurable measurable_fst)
  have h6 : ∀ᵐ p ∂(volume.restrict (Ioo a b)).prod (volume.restrict (Ioo c d)),
      H' p = (d - c)⁻¹ * ∫ β in Ioo c d, H' (p.1, β) := by
    refine (Measure.ae_prod_iff_ae_ae hE).2 ?_
    filter_upwards [Measure.ae_ae_of_ae_prod hHH', hslice, hhh'] with t h1 h2 h3
    filter_upwards [h1, h2] with α h1 h2
    exact h1.symm.trans (h2.trans h3.symm)
  -- step 7: `h̃ ∘ fst = h ∘ fst` a.e., as `fst` is quasi-measure-preserving
  have h7 : ∀ᵐ p ∂(volume.restrict (Ioo a b)).prod (volume.restrict (Ioo c d)),
      (d - c)⁻¹ * ∫ β in Ioo c d, H' (p.1, β) = (d - c)⁻¹ * ∫ β in Ioo c d, H (p.1, β) :=
    Measure.quasiMeasurePreserving_fst.ae hhh'
  -- step 8: `H = H̃ = h̃ ∘ fst = h ∘ fst` a.e.
  filter_upwards [hHH', h6, h7] with p h1 h2 h3
  exact h1.trans (h2.trans h3)
/-- **`α`-invariance and degree-one homogeneity of the edge density** (steps 8 and 9(b) of the
cone-sector endpoint density argument for Simon 7.3.3).  Let `0 < s ≤ 1`, `I = (1 - s, 1 + s)`,
`J = (-s, s)` and let `H` be integrable on `I × J`.  If `∫ ψ′(α) l(t) H(t, α) = 0` for all `C¹`
tests `ψ`, `l` supported in `J`, `I` (`α`-invariance), and the weak scaling identity
`∫ l(t/r) ψ(α) H = r² ∫ l(t) ψ(α) H` holds for `C¹` tests `l` supported in
`I₁ = (1 - s/2, 1 + s/2)`, `ψ` supported in `J` and `|r - 1| < s/4`, then `H(t, α) = c t` for
a.e. `(t, α) ∈ (1 - s/8, 1 + s/8) × J`.  By `α`-invariance the slices `H(t, ·)` are a.e.
constant, so `H(t, α) = h(t)` a.e. on `I × J`, `h` the slice average (integrable on `I` by
Fubini).  Testing the scaling identity against a normalized bump `ψ₀` in `J` reduces it to
`∫ l(t/r) h(t) dt = r² ∫ l h`, as `u ↦ r u` maps `I₁` into `I`; hence `h(r u) = r h(u)` for a.e.
`u ∈ I₁`, so `h(v) = c v` for a.e. `v ∈ (1 - s/8, 1 + s/8)`, and `H(t, α) = h(t) = c t`. -/
theorem Submission.idtp_cse_alpha_invariant_homogeneous : ∀ (s : ℝ) (H : ℝ × ℝ → ℝ), 0 < s → s ≤ 1 → IntegrableOn H (Ioo (1 - s) (1 + s) ×ˢ Ioo (-s) s) → (∀ ψ l : ℝ → ℝ, ContDiff ℝ 1 ψ → ContDiff ℝ 1 l → tsupport ψ ⊆ Ioo (-s) s → tsupport l ⊆ Ioo (1 - s) (1 + s) → ∫ p : ℝ × ℝ, deriv ψ p.2 * l p.1 * H p = 0) → (∀ (l ψ : ℝ → ℝ) (r : ℝ), ContDiff ℝ 1 l → ContDiff ℝ 1 ψ → tsupport l ⊆ Ioo (1 - s / 2) (1 + s / 2) → tsupport ψ ⊆ Ioo (-s) s → |r - 1| < s / 4 → ∫ p : ℝ × ℝ, l (p.1 / r) * ψ p.2 * H p = r ^ 2 * ∫ p : ℝ × ℝ, l p.1 * ψ p.2 * H p) → ∃ c : ℝ, ∀ᵐ p : ℝ × ℝ, p ∈ Ioo (1 - s / 8) (1 + s / 8) ×ˢ Ioo (-s) s → H p = c * p.1 := by
  intro s H hs hs1 hH hα hβ
  have hJ : -s < s := by linarith
  -- steps 1–6: the slices are a.e. constant, so `H(t, α) = h(t)` for a.e. `(t, α) ∈ I × J`,
  -- with `h` the slice average
  set h : ℝ → ℝ := fun t => (s - -s)⁻¹ * ∫ α in Ioo (-s) s, H (t, α)
  have hHh : ∀ᵐ p : ℝ × ℝ, p ∈ Ioo (1 - s) (1 + s) ×ˢ Ioo (-s) s → H p = h p.1 :=
    Submission.idtp_cse_ah_ae_eq_slice_average (1 - s) (1 + s) (-s) s H hJ hH
      (Submission.idtp_cse_ah_slice_ae_const (1 - s) (1 + s) (-s) s H hJ hH hα)
  -- `h` is integrable on `I` (Fubini)
  have hH' : Integrable H
      ((volume.restrict (Ioo (1 - s) (1 + s))).prod (volume.restrict (Ioo (-s) s))) := by
    rw [Measure.prod_restrict, ← Measure.volume_eq_prod]
    exact hH
  have hhI : IntegrableOn h (Ioo (1 - s) (1 + s)) := hH'.integral_prod_left.const_mul _
  -- for `|r - 1| < s/4`, `u ↦ r u` maps `I₁ = (1 - s/2, 1 + s/2)` into `I`
  have hmaps : ∀ r : ℝ, |r - 1| < s / 4 →
      Ioo (r * (1 - s / 2)) (r * (1 + s / 2)) ⊆ Ioo (1 - s) (1 + s) := by
    intro r hr t ht
    obtain ⟨hr1, hr2⟩ := abs_sub_lt_iff.1 hr
    constructor
    · nlinarith [ht.1, mul_pos (by linarith : (0 : ℝ) < r - 1 + s / 4)
        (by linarith : (0 : ℝ) < 1 - s / 2), mul_pos hs hs]
    · nlinarith [ht.2, mul_pos (by linarith : (0 : ℝ) < 1 + s / 4 - r)
        (by linarith : (0 : ℝ) < 1 + s / 2), mul_nonneg hs.le (sub_nonneg.2 hs1)]
  -- a normalized bump `ψ₀` in `J`
  obtain ⟨ψ₀, hψ₀C, hψ₀S, hψ₀1⟩ := Submission.idtp_cse_ah_normalized_bump (-s) s hJ
  have hψ₀0 : ∀ α, α ∉ Ioo (-s) s → ψ₀ α = 0 := fun α hα =>
    image_eq_zero_of_notMem_tsupport fun h' => hα (hψ₀S h')
  -- step 7: `h(r u) = r h(u)` for a.e. `u ∈ I₁`, for each `r` with `|r - 1| < s/4`
  have hscal : ∀ r : ℝ, |r - 1| < s / 4 →
      ∀ᵐ u, u ∈ Ioo (1 - s / 2) (1 + s / 2) → h (r * u) = r * h u := by
    intro r hr
    have hr0 : 0 < r := by linarith [(abs_sub_lt_iff.1 hr).2]
    refine Submission.idtp_cse_ah_ae_scaling_of_weak_scaling (1 - s / 2) (1 + s / 2) r h hr0
      (hhI.mono_set (Ioo_subset_Ioo (by linarith) (by linarith))) (hhI.mono_set (hmaps r hr))
      fun l hl hlS => ?_
    have hl0 : ∀ t, t ∉ Ioo (1 - s / 2) (1 + s / 2) → l t = 0 := fun t ht =>
      image_eq_zero_of_notMem_tsupport fun h' => ht (hlS h')
    -- `l(t/r) ≠ 0` forces `t ∈ r I₁ ⊆ I`
    have hdiv : ∀ t, t / r ∈ Ioo (1 - s / 2) (1 + s / 2) → t ∈ Ioo (1 - s) (1 + s) := fun t ht =>
      hmaps r hr ⟨(lt_div_iff₀' hr0).1 ht.1, (div_lt_iff₀' hr0).1 ht.2⟩
    -- both sides of the scaling identity reduce to one-variable integrals against `h`
    have h1 := Submission.idtp_cse_ah_product_integral_reduce (1 - s) (1 + s) (-s) s H h
      (fun t => l (t / r)) ψ₀ hHh (fun t ht => hl0 (t / r) fun hu => ht (hdiv t hu)) hψ₀0 hψ₀1
    have h2 := Submission.idtp_cse_ah_product_integral_reduce (1 - s) (1 + s) (-s) s H h l ψ₀ hHh
      (fun t ht => hl0 t fun hu => ht (Ioo_subset_Ioo (by linarith) (by linarith) hu)) hψ₀0 hψ₀1
    rw [← h1, ← h2]
    exact hβ l ψ₀ r hl hψ₀C hlS hψ₀S hr
  -- step 8: `h(v) = c v` for a.e. `v ∈ I₂ = (1 - s/8, 1 + s/8)`
  obtain ⟨c, hc⟩ :=
    Submission.idtp_cse_ah_ae_linear_of_ae_scaling s h hs hs1 hhI.aestronglyMeasurable hscal
  refine ⟨c, ?_⟩
  -- step 9: pull back along `fst` and combine with `H(t, α) = h(t)`
  have hc' : ∀ᵐ p : ℝ × ℝ, p.1 ∈ Ioo (1 - s / 8) (1 + s / 8) → h p.1 = c * p.1 :=
    (Measure.quasiMeasurePreserving_fst (μ := volume) (ν := volume)).ae hc
  filter_upwards [hHh, hc'] with p h1 h2 hp
  rw [h1 ⟨Ioo_subset_Ioo (by linarith) (by linarith) hp.1, hp.2⟩, h2 hp.1]

/-- If near `x` the set `M` lies in the line through `x` in direction `v` up to an
`H¹`-null set, then any approximate tangent space of `M` at `x` is that line. -/
theorem Submission.odc_approxTangent_eq_of_subset {P : ℕ} (M N : Set (Euclid P))
    (x v : Euclid P) (hv : ‖v‖ = 1) (δ : ℝ) (hδ : 0 < δ)
    (hN : (μHE[1] : Measure (Euclid P)) N = 0)
    (hloc : M ∩ ball x δ ⊆ range (fun s : ℝ => x + s • v) ∪ N)
    (Q : Submodule ℝ (Euclid P)) (hQ : HasApproximateTangentSpaceAt 1 M x Q) :
    Q = Submodule.span ℝ {v} := by
  have hv0 : v ≠ 0 := by rintro rfl; simp at hv
  refine Submodule.eq_of_le_of_finrank_eq ?_ (by rw [hQ.1, finrank_span_singleton hv0])
  by_contra hQL
  -- a unit vector `u ∈ Q \ span {v}`; then `Q = ℝ u`
  obtain ⟨u, huQ, huL, hu⟩ : ∃ u ∈ Q, u ∉ Submodule.span ℝ {v} ∧ ‖u‖ = 1 := by
    obtain ⟨u, huQ, huL⟩ := IsConcreteLE.not_le_iff_exists.1 hQL
    have hu : ‖u‖ ≠ 0 := norm_ne_zero_iff.2 fun h => huL (h ▸ Submodule.zero_mem _)
    refine ⟨‖u‖⁻¹ • u, Q.smul_mem _ huQ, fun h => huL ?_, ?_⟩
    · simpa [smul_smul, mul_inv_cancel₀ hu] using (Submodule.span ℝ {v}).smul_mem ‖u‖ h
    · rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hu]
  have hQu : (Q : Set (Euclid P)) = (fun t : ℝ => (0 : Euclid P) + t • u) '' univ := by
    have hspan : Submodule.span ℝ {u} = Q :=
      Submodule.eq_of_le_of_finrank_eq ((Submodule.span_singleton_le_iff_mem _ _).2 huQ)
        (by rw [hQ.1, finrank_span_singleton (by rintro h; simp [h] at hu)])
    ext y
    rw [← hspan, image_univ, SetLike.mem_coe, Submodule.mem_span_singleton]
    simp only [mem_range, zero_add]
  -- `d = dist(u, span {v}) > 0` and the bump `f` of height `d / 2` at `u`
  set d := infDist u (Submodule.span ℝ {v} : Set (Euclid P))
  have hd : 0 < d := ((Submodule.closed_of_finiteDimensional _).notMem_iff_infDist_pos
    ⟨0, Submodule.zero_mem _⟩).1 huL
  obtain ⟨f, hf⟩ : ∃ f : CompactlySupportedContinuousMap (Euclid P) ℝ,
      ∀ y, f y = max 0 (d / 2 - ‖y - u‖) :=
    ⟨⟨⟨fun y => max 0 (d / 2 - ‖y - u‖), by fun_prop⟩,
      HasCompactSupport.intro (isCompact_closedBall u (d / 2)) fun y hy => max_eq_left (by
        rw [mem_closedBall, dist_eq_norm, not_le] at hy; linarith)⟩, fun y => rfl⟩
  -- the limit `∫_Q f` is positive
  have hpos : 0 < ∫ y in (Q : Set (Euclid P)), f y ∂μHE[1] := by
    rw [hQu, Submission.odc_line_integral 0 u hu univ, Measure.restrict_univ]
    refine Continuous.integral_pos_of_hasCompactSupport_nonneg_nonzero (x := 1) (by fun_prop)
      (f.hasCompactSupport.comp_isClosedEmbedding
        (Submission.odc_line_isometry 0 u hu).isClosedEmbedding) (fun t => by simp [hf]) ?_
    rw [hf, zero_add, one_smul, sub_self, norm_zero, sub_zero]
    exact (lt_max_of_lt_right (half_pos hd)).ne'
  -- but the blown-up integrals eventually vanish: off a null set, `f = 0` on the blow-up
  have hzero : ∀ᶠ ρ in 𝓝[>] (0 : ℝ),
      ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' M, f y ∂μHE[1] = 0 := by
    have h1d : (0 : ℝ) < 1 + d := by linarith
    filter_upwards [Ioo_mem_nhdsGT (div_pos hδ h1d)] with ρ ⟨hρ0, hρ⟩
    rw [lt_div_iff₀ h1d] at hρ
    refine setIntegral_eq_zero_of_ae_eq_zero (ae_iff.2 (measure_mono_null (fun y hy => ?_)
      (Submission.odc_tangent_blowUp_null hN x ρ)))
    simp only [mem_ofPred_eq, not_imp] at hy
    rw [Submission.odc_tangent_blowUp_image_eq _ x hρ0.ne'] at hy ⊢
    obtain ⟨hyM, hfy⟩ := hy
    have hyu : ‖y - u‖ < d / 2 := by
      by_contra h
      exact hfy (by rw [hf]; exact max_eq_left (by linarith [not_lt.1 h]))
    have hball : x + ρ • y ∈ ball x δ := by
      rw [mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hρ0.le]
      nlinarith [norm_sub_norm_le y u, norm_nonneg y]
    rcases hloc ⟨hyM, hball⟩ with hyl | hyN
    · have := infDist_le_dist_of_mem (x := u)
        ((Submission.odc_tangent_mem_range_iff x v y hρ0.ne').1 hyl)
      rw [dist_comm, dist_eq_norm] at this
      linarith
    · exact hyN
  exact hpos.ne' (tendsto_nhds_unique (hQ.2 f)
    (tendsto_const_nhds.congr' (hzero.mono fun ρ h => h.symm)))
/-- Test forms converging to `0` in `𝒟ⁿ(U)` converge to `0` uniformly on the whole space. -/
theorem Submission.odc_polycurrent_tendstoUniformly {P n : ℕ} {U : Set (Euclid P)}
    {ωs : ℕ → TestFormOn U n} (h : TestFormOnConverges ωs 0) :
    TendstoUniformly (fun j => (ωs j : DifferentialForm (Euclid P) n)) 0 atTop := by
  obtain ⟨K, -, -, hsupp, -, hderiv⟩ := h
  refine Metric.tendstoUniformly_iff.2 fun ε hε => ?_
  filter_upwards [Metric.tendstoUniformlyOn_iff.1 (hderiv 0) ε hε] with j hj x
  by_cases hx : x ∈ K
  · simpa [iteratedFDeriv_zero_eq_comp] using hj x hx
  · simpa [image_eq_zero_of_notMem_tsupport fun hx' => hx (hsupp j hx')] using hε

/-- Integration of `1`-forms along `t ↦ p + t v`, `t ∈ I` (`‖v‖ = 1`), is a current. -/
theorem Submission.odc_polycurrent_line {P : ℕ} (p v : Euclid P) (I : Set ℝ) (hv : ‖v‖ = 1) :
    ∃ X : GeometricCurrentOn (univ : Set (Euclid P)) 1,
      ∀ ω : TestFormOn (univ : Set (Euclid P)) 1,
        X ω = ∫ t in I, (ω : DifferentialForm (Euclid P) 1) (p + t • v) (fun _ => v) := by
  have hγ := Submission.odc_line_isometry p v hv
  have hint (ω : TestFormOn (univ : Set (Euclid P)) 1) :
      Integrable fun t : ℝ => (ω : DifferentialForm (Euclid P) 1) (p + t • v) (fun _ => v) :=
    ((continuous_eval_const (F := Covector (Euclid P) 1) fun _ : Fin 1 => v).comp
      (ω.2.1.1.continuous.comp hγ.continuous)).integrable_of_hasCompactSupport
      ((ω.2.1.2.comp_isClosedEmbedding hγ.isClosedEmbedding).comp_left
        (g := fun α : Covector (Euclid P) 1 => α fun _ => v) rfl)
  refine ⟨⟨{ toFun := fun ω =>
               ∫ t in I, (ω : DifferentialForm (Euclid P) 1) (p + t • v) (fun _ => v)
             map_add' := fun ω η => ?_
             map_smul' := fun c ω => ?_ }, fun ωs h => ?_⟩, fun ω => rfl⟩
  · simp only [Submodule.coe_add, Pi.add_apply, ContinuousAlternatingMap.add_apply]
    exact integral_add (hint ω).restrict (hint η).restrict
  · simp only [Submodule.coe_smul, Pi.smul_apply, ContinuousAlternatingMap.smul_apply, smul_eq_mul,
      RingHom.id_apply]
    exact integral_const_mul c _
  · -- dominated convergence, with the indicator of the compact set `γ⁻¹ K` as dominating function
    have hu := Submission.odc_polycurrent_tendstoUniformly h
    obtain ⟨K, hK, -, hsupp, -, -⟩ := h
    have hS : IsCompact ((fun t : ℝ => p + t • v) ⁻¹' K) :=
      hγ.isClosedEmbedding.isCompact_preimage hK
    have key := tendsto_integral_filter_of_dominated_convergence (μ := volume.restrict I)
      (F := fun j t => (ωs j : DifferentialForm (Euclid P) 1) (p + t • v) (fun _ => v))
      (f := fun _ => 0) (((fun t : ℝ => p + t • v) ⁻¹' K).indicator fun _ => 1)
      (Eventually.of_forall fun j => (hint (ωs j)).aestronglyMeasurable.restrict) ?_
      ((integrableOn_const (C := (1 : ℝ)) hS.measure_lt_top.ne).integrable_indicator
        hS.isClosed.measurableSet).restrict
      (Eventually.of_forall fun t => by
        simpa [Function.comp_def] using ((continuous_eval_const (F := Covector (Euclid P) 1)
          fun _ : Fin 1 => v).tendsto 0).comp (hu.tendsto_at (p + t • v)))
    · simpa using key
    · filter_upwards [Metric.tendstoUniformly_iff.1 hu 1 one_pos] with j hj
      refine Eventually.of_forall fun t => ?_
      by_cases ht : p + t • v ∈ K
      · rw [indicator_of_mem (show t ∈ (fun t : ℝ => p + t • v) ⁻¹' K from ht)]
        calc _ ≤ ‖(ωs j : DifferentialForm (Euclid P) 1) (p + t • v)‖ * ∏ _i : Fin 1, ‖v‖ :=
              ContinuousAlternatingMap.le_opNorm _ _
          _ ≤ 1 := by simpa [hv] using (hj (p + t • v)).le
      · rw [indicator_of_notMem (show t ∉ (fun t : ℝ => p + t • v) ⁻¹' K from ht),
          image_eq_zero_of_notMem_tsupport fun h' => ht (hsupp j h')]
        simp

/-- Finitely many weighted oriented line pieces define a current. -/
theorem Submission.odc_polygonal_current {P : ℕ} {ι : Type} [Fintype ι] (p v : ι → Euclid P)
    (I : ι → Set ℝ) (c : ι → ℝ) (hv : ∀ k, ‖v k‖ = 1) :
    ∃ X : GeometricCurrentOn (univ : Set (Euclid P)) 1,
      ∀ ω : TestFormOn (univ : Set (Euclid P)) 1,
        X ω = ∑ k, c k * ∫ t in I k,
          (ω : DifferentialForm (Euclid P) 1) (p k + t • v k) (fun _ => v k) := by
  choose X hX using fun k => Submission.odc_polycurrent_line (p k) (v k) (I k) (hv k)
  refine ⟨⟨∑ k, c k • (X k).toCurrent, fun ωs h => ?_⟩, fun ω => ?_⟩
  · simpa using tendsto_finsetSum Finset.univ fun k _ => ((X k).continuous' ωs h).const_mul (c k)
  · simp [← hX]

/-- A smooth compactly supported function is a test `0`-form whose exterior derivative is its
differential. -/
theorem Submission.odc_zero_testForm {P : ℕ} (f : Euclid P → ℝ)
    (hf : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) f) (hfc : HasCompactSupport f) :
    ∃ φ : TestFormOn (univ : Set (Euclid P)) 0, ∀ x v : Euclid P,
      ((exteriorDerivativeTestOn (univ : Set (Euclid P)) 0 φ :
          TestFormOn (univ : Set (Euclid P)) 1) : DifferentialForm (Euclid P) 1) x (fun _ => v) =
        fderiv ℝ f x v := by
  refine ⟨⟨fun x => ContinuousAlternatingMap.constOfIsEmpty ℝ (Euclid P) (Fin 0) (f x),
    ⟨(ContinuousAlternatingMap.constOfIsEmptyLIE ℝ (Euclid P) ℝ (Fin 0)).contDiff.comp hf,
      hfc.comp_left (map_zero (ContinuousAlternatingMap.constOfIsEmptyLIE ℝ (Euclid P) ℝ (Fin 0)))⟩,
    subset_univ _⟩, fun x v => ?_⟩
  show extDeriv (fun x => ContinuousAlternatingMap.constOfIsEmpty ℝ (Euclid P) (Fin 0) (f x)) x
    (fun _ => v) = _
  rw [extDeriv_constOfIsEmpty]
  rfl

/-- On `ℝ⁰` every `1`-current vanishes: all `1`-covectors on the zero space are zero. -/
theorem Submission.odc_dim_zero_vanish (C : GeometricCurrentOn (univ : Set (Euclid 0)) 1) :
    ∀ ω : TestFormOn (univ : Set (Euclid 0)) 1, C ω = 0 := by
  intro ω
  have hω : ω = 0 := Subtype.ext <| funext fun x => ContinuousAlternatingMap.ext fun m => by
    rw [Subsingleton.elim m 0]
    simp
  rw [hω]
  exact map_zero C.toCurrent

/-- `λ M_W(C) ≤ M_{λW}(C)` for a `1`-dimensional cone `C`: if `ω` is admissible for `W`, the
dilated form `y ↦ ω(λ⁻¹y) = λ ω'(y)` is admissible for `λW` and `C(λω') = λ C(ω)`. -/
theorem Submission.odc_conemass_le_massOn_smul {P : ℕ}
    (C : GeometricCurrentOn (univ : Set (Euclid P)) 1) (hC : IsConeCurrent C) (lam : ℝ)
    (hlam : 0 < lam) (W : Set (Euclid P)) :
    ENNReal.ofReal lam * C.massOn W ≤ C.massOn ((fun x => lam • x) '' W) := by
  rw [GeometricCurrentOn.massOn, ENNReal.mul_sSup]
  refine iSup₂_le ?_
  rintro _ ⟨ω, ⟨hωW, hω1⟩, rfl⟩
  obtain ⟨ω', hω', hC'⟩ := Submission.cone_current_apply_dilation_pullback P 1 C hC lam hlam ω
  have hη : ((lam • ω' : TestFormOn (univ : Set (Euclid P)) 1) : DifferentialForm (Euclid P) 1) =
      (ω : DifferentialForm (Euclid P) 1) ∘ fun y => lam⁻¹ • y := funext fun y => by
    rw [Submodule.coe_smul, Pi.smul_apply, hω', pow_one, smul_smul, mul_inv_cancel₀ hlam.ne',
      one_smul, comp_apply]
  have hadm : lam • ω' ∈ massAdmissibleOn univ 1 ((fun x => lam • x) '' W) := by
    refine ⟨?_, fun y => by rw [hη]; exact hω1 _⟩
    rw [hη]
    refine (tsupport_comp_subset_preimage _ (continuous_const_smul _)).trans fun y hy => ?_
    exact ⟨lam⁻¹ • y, hωW hy, by simp [smul_smul, mul_inv_cancel₀ hlam.ne']⟩
  calc ENNReal.ofReal lam * ENNReal.ofReal (C ω) = ENNReal.ofReal (C (lam • ω')) := by
        rw [map_smul, smul_eq_mul, ENNReal.ofReal_mul hlam.le, hC']
    _ ≤ _ := C.le_massOn hadm

/-- The local mass of a `1`-dimensional cone current is `1`-homogeneous. -/
theorem Submission.odc_cone_massOn_smul {P : ℕ} (C : GeometricCurrentOn (univ : Set (Euclid P)) 1)
    (hC : IsConeCurrent C) (lam : ℝ) (hlam : 0 < lam) (W : Set (Euclid P)) :
    C.massOn ((fun x => lam • x) '' W) = ENNReal.ofReal lam * C.massOn W := by
  refine le_antisymm ?_ (Submission.odc_conemass_le_massOn_smul C hC lam hlam W)
  have h := Submission.odc_conemass_le_massOn_smul C hC lam⁻¹ (inv_pos.2 hlam)
    ((fun x => lam • x) '' W)
  simp only [image_image, smul_smul, inv_mul_cancel₀ hlam.ne', one_smul, image_id'] at h
  calc C.massOn ((fun x => lam • x) '' W)
      = ENNReal.ofReal lam * (ENNReal.ofReal lam⁻¹ * C.massOn ((fun x => lam • x) '' W)) := by
        rw [← mul_assoc, ← ENNReal.ofReal_mul hlam.le, mul_inv_cancel₀ hlam.ne',
          ENNReal.ofReal_one, one_mul]
    _ ≤ ENNReal.ofReal lam * C.massOn W := by gcongr

/-- `ω₁ = 2`. -/
theorem Submission.odc_unitBallVolume_one : unitBallVolume 1 = 2 := by
  set e : Euclid 1 := EuclideanSpace.single 0 1
  have he : ‖e‖ = 1 := by simp [e]
  have hx : ∀ x : Euclid 1, x = x 0 • e := fun x => by
    ext i
    rw [Subsingleton.elim i 0]
    simp [e]
  -- the unit ball of `ℝ¹` is the image of `(-1, 1)` under the isometry `t ↦ t e`
  have hball : ball (0 : Euclid 1) 1 = (fun t : ℝ => (0 : Euclid 1) + t • e) '' Ioo (-1) 1 := by
    ext x
    simp only [mem_ball_zero_iff, mem_image, mem_Ioo, zero_add]
    constructor
    · intro h
      refine ⟨x 0, ?_, (hx x).symm⟩
      rw [hx x, norm_smul, he, mul_one, Real.norm_eq_abs] at h
      exact abs_lt.1 h
    · rintro ⟨t, ht, rfl⟩
      rw [norm_smul, he, mul_one, Real.norm_eq_abs]
      exact abs_lt.2 ht
  rw [unitBallVolume, ← EuclideanSpace.euclideanHausdorffMeasure_eq_volume 1, hball,
    Submission.odc_line_measure_image 0 e he, Real.volume_Ioo]
  norm_num

/-- The mass measure of an integer multiplicity representation is finite on compact sets. -/
theorem Submission.odc_imrep_measure_compact_ne_top {P n : ℕ}
    (R : IMRep (univ : Set (Euclid P)) n) (K : Set (Euclid P)) (hK : IsCompact K) :
    R.measure K ≠ ∞ := by
  rw [IMRep.measure, withDensity_apply _ hK.isClosed.measurableSet,
    Measure.restrict_restrict hK.isClosed.measurableSet, inter_comm]
  exact R.locallyIntegrable_mult K hK (subset_univ K)

/-- Lower mass bound at support points of a minimizing `1`-current without boundary in `ℝᴾ`,
from the monotonicity formula (density `≥ 1`) and `ω₁ = 2`. -/
theorem Submission.odc_density_lower {P : ℕ} (hP : 1 ≤ P)
    (C : GeometricCurrentOn (univ : Set (Euclid P)) 1) (hmin : IsMinimizingIn C univ)
    (hb : BoundaryVanishes C) (R : IMRep (univ : Set (Euclid P)) 1) (hR : R.Represents C)
    (x : Euclid P) (hx : ∀ ε : ℝ, 0 < ε → R.measure (ball x ε) ≠ 0) :
    ∀ᶠ ρ in 𝓝[>] (0 : ℝ), ENNReal.ofReal ρ ≤ R.measure (ball x ρ) := by
  have hN : IsEmbeddedSubmanifold 2 P (univ : Set (Euclid P)) := fun y _ =>
    ⟨univ, univ, id, isOpen_univ, isOpen_univ, mem_univ y, contDiffOn_id, injOn_id _,
      by simp, fun K _ hK => by simpa using hK, fun z _ => by
        rw [fderiv_id, ContinuousLinearMap.coe_id']; exact injective_id⟩
  obtain ⟨-, -, ⟨Θ, hΘ, -⟩, hge⟩ := Submission.dimred_minimizing_monotonicity P 1 P univ univ C
    le_rfl hP le_rfl isOpen_univ hN (by simp) (by rwa [inter_self]) (by simp) hb
  obtain ⟨hmass, hsupp, -⟩ := Submission.dimred_im_mass_measure P 1 univ C R isOpen_univ hR
  have hΘx := hΘ x (mem_univ x)
  -- the density at `x ∈ spt C` is `≥ 1 > 1/2`, so eventually `μ(B_ρ(x)) / (2ρ) > 1/2`
  have h1 : (2⁻¹ : ℝ≥0∞) < ENNReal.ofReal (Θ x) :=
    (ENNReal.inv_lt_one.2 ENNReal.one_lt_two).trans_le
      (ENNReal.one_le_ofReal.2 (hge x ((hsupp x (mem_univ x)).2 hx) _ hΘx))
  filter_upwards [hΘx.2.eventually_const_lt h1, self_mem_nhdsWithin] with ρ hρ hρ0
  rw [Submission.odc_unitBallVolume_one, pow_one, hmass _ isOpen_ball (subset_univ _),
    ENNReal.lt_div_iff_mul_lt (Or.inl (mul_ne_zero two_ne_zero (ENNReal.ofReal_pos.2 hρ0).ne'))
      (Or.inl (ENNReal.mul_ne_top ENNReal.ofNat_ne_top ENNReal.ofReal_ne_top)), ← mul_assoc,
    ENNReal.inv_mul_cancel two_ne_zero ENNReal.ofNat_ne_top, one_mul] at hρ
  exact hρ.le

/-- A set on which the mass measure vanishes meets the carrier in an `Hⁿ`-null set
(the multiplicity is `≥ 1` on the carrier). -/
theorem Submission.odc_carrier_inter_null {P n : ℕ} (R : IMRep (univ : Set (Euclid P)) n)
    (Z : Set (Euclid P)) (hZ : MeasurableSet Z) (h : R.measure Z = 0) :
    (μHE[n] : Measure (Euclid P)) (R.carrier ∩ Z) = 0 := by
  rw [IMRep.measure, withDensity_apply _ hZ] at h
  rw [inter_comm, ← Measure.restrict_apply hZ, ← setLIntegral_one, ← nonpos_iff_eq_zero, ← h]
  refine lintegral_mono_ae (ae_restrict_of_ae ((ae_restrict_mem R.measurableSet_carrier).mono
    fun x hx => ?_))
  exact_mod_cast R.mult_pos x hx

/-- Orientation of a `1`-dimensional representation carried by finitely many rays: on
`ray(e)` the orientation is `±e` almost everywhere. -/
theorem Submission.odc_orient_on_ray {P : ℕ} (R : IMRep (univ : Set (Euclid P)) 1)
    (F : Finset (Euclid P)) (hF : ∀ e ∈ F, ‖e‖ = 1)
    (hnull : (μHE[1] : Measure (Euclid P))
      (R.carrier ∩ (⋃ e ∈ F, (fun t : ℝ => t • e) '' Ioi 0)ᶜ) = 0)
    (e : Euclid P) (he : e ∈ F) :
    ∀ᵐ x ∂((μHE[1] : Measure (Euclid P)).restrict
        (R.carrier ∩ (fun t : ℝ => t • e) '' Ioi 0)),
      R.orient x = ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (fun _ => e) ∨
      R.orient x = -ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (fun _ => e) := by
  have hray : MeasurableSet ((fun t : ℝ => t • e) '' Ioi 0) := by
    have h := Submission.odc_line_measurableSet_image 0 e (hF e he)
      (measurableSet_Ioi (a := (0 : ℝ)))
    simp only [zero_add] at h
    exact h
  filter_upwards [ae_restrict_mem (R.measurableSet_carrier.inter hray),
    ae_restrict_of_ae_restrict_of_subset inter_subset_left R.orients] with x hx hxQ
  obtain ⟨hxC, t₀, ht₀ : 0 < t₀, hxe⟩ := hx
  obtain ⟨Q, hQ, hQo⟩ := hxQ
  simp only at hxe
  subst hxe
  -- the other closed rays form a closed set `K` not containing `t₀ • e`
  set K := ⋃ e' ∈ F.erase e, (fun s : ℝ => s • e') '' Ici 0
  have hK : IsClosed K := by
    refine isClosed_biUnion_finset fun e' he' => ?_
    have h := (Submission.odc_line_isometry 0 e'
      (hF e' (Finset.mem_of_mem_erase he'))).isClosedEmbedding.isClosedMap _
      (isClosed_Ici (a := (0 : ℝ)))
    simp only [zero_add] at h
    exact h
  have hxK : t₀ • e ∉ K := by
    intro hxK
    obtain ⟨e', he', s, hs : 0 ≤ s, hse⟩ := mem_iUnion₂.1 hxK
    obtain ⟨hne, he'F⟩ := Finset.mem_erase.1 he'
    simp only at hse
    have hst : s = t₀ := by
      simpa [norm_smul, hF e he, hF e' he'F, abs_of_nonneg hs, abs_of_pos ht₀]
        using congrArg norm hse
    subst hst
    exact hne (smul_right_injective _ ht₀.ne' hse)
  obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.1 hK.isOpen_compl _ hxK
  -- near `t₀ • e` the carrier lies on the line `ℝ e` up to the null set `N`
  set N := R.carrier ∩ (⋃ e ∈ F, (fun t : ℝ => t • e) '' Ioi 0)ᶜ
  have hloc : R.carrier ∩ ball (t₀ • e) δ ⊆ range (fun s : ℝ => t₀ • e + s • e) ∪ N := by
    rintro y ⟨hyC, hyB⟩
    by_cases hy : y ∈ ⋃ e ∈ F, (fun t : ℝ => t • e) '' Ioi 0
    · left
      obtain ⟨e'', he'', t, ht : 0 < t, hte⟩ := mem_iUnion₂.1 hy
      simp only at hte
      subst hte
      obtain rfl : e'' = e := by
        by_contra hne
        exact hball hyB (mem_iUnion₂.2 ⟨e'', Finset.mem_erase.2 ⟨hne, he''⟩, t, ht.le, rfl⟩)
      exact ⟨t - t₀, by simp only [← add_smul, add_sub_cancel]⟩
    · exact Or.inr ⟨hyC, hy⟩
  obtain rfl := Submission.odc_approxTangent_eq_of_subset R.carrier N (t₀ • e) e (hF e he) δ hδ
    hnull hloc Q hQ
  -- `e` itself is a unit orientation of `span {e}`
  exact Submission.rsdic_unitOrientation_eq_or_eq_neg P 1 _ _ _
    ⟨fun _ : Fin 1 => e, ⟨fun _ => hF e he, fun i j hij => (hij (Subsingleton.elim i j)).elim⟩,
      by rw [range_const], Or.inl fun α => rfl⟩ hQo

/-- A line piece `γ(I)` is countably `1`-rectifiable. -/
theorem Submission.odc_polyimrep_rectifiable {P : ℕ} (p v : Euclid P) (hv : ‖v‖ = 1)
    (I : Set ℝ) : CountablyRectifiable 1 ((fun t : ℝ => p + t • v) '' I) := by
  refine (Poincare.SimonGMT.Chapter03.countablyRectifiable_range
    ((Submission.odc_line_isometry p v hv).lipschitzWith.comp
      (EuclideanSpace.proj (0 : Fin 1) : EuclideanSpace ℝ (Fin 1) →L[ℝ] ℝ).lipschitzWith)).mono ?_
  rintro _ ⟨t, -, rfl⟩
  exact ⟨EuclideanSpace.single 0 t, by simp⟩

/-- `H¹(γ(I) ∩ A) = ℒ¹(I ∩ γ⁻¹(A))` for the isometric line `γ(t) = p + t v`. -/
theorem Submission.odc_polyimrep_measure_inter {P : ℕ} (p v : Euclid P) (hv : ‖v‖ = 1)
    (I : Set ℝ) (A : Set (Euclid P)) :
    (μHE[1] : Measure (Euclid P)) (((fun t : ℝ => p + t • v) '' I) ∩ A) =
      volume (I ∩ (fun t : ℝ => p + t • v) ⁻¹' A) := by
  rw [← image_inter_preimage, Submission.odc_line_measure_image p v hv]

/-- A line piece has locally finite `H¹`-measure. -/
theorem Submission.odc_polyimrep_measure_inter_ne_top {P : ℕ} (p v : Euclid P) (hv : ‖v‖ = 1)
    (I : Set ℝ) {K : Set (Euclid P)} (hK : IsCompact K) :
    (μHE[1] : Measure (Euclid P)) (((fun t : ℝ => p + t • v) '' I) ∩ K) ≠ ∞ := by
  have hK' := (Submission.odc_line_isometry p v hv).isClosedEmbedding.isCompact_preimage hK
  rw [Submission.odc_polyimrep_measure_inter p v hv]
  exact ne_top_of_le_ne_top hK'.measure_lt_top.ne (measure_mono inter_subset_right)

/-- Continuous compactly supported functions are `H¹`-integrable on line pieces. -/
theorem Submission.odc_polyimrep_integrableOn {P : ℕ} (p v : Euclid P) (hv : ‖v‖ = 1)
    (I : Set ℝ) {g : Euclid P → ℝ} (hg : Continuous g) (hgc : HasCompactSupport g) :
    IntegrableOn g ((fun t : ℝ => p + t • v) '' I) μHE[1] := by
  have hγ := Submission.odc_line_isometry p v hv
  rw [IntegrableOn, Submission.odc_line_restrict p v hv I,
    (Submission.odc_line_measurableEmbedding p v hv).integrable_map_iff]
  exact ((hg.comp hγ.continuous).integrable_of_hasCompactSupport
    (hgc.comp_isClosedEmbedding hγ.isClosedEmbedding)).integrableOn

/-- `±v` (as the `1`-vector `α ↦ ±α(v)`) is a unit orientation of `span {v}`. -/
theorem Submission.odc_polyimrep_unitOrientation {P : ℕ} (v : Euclid P) (hv : ‖v‖ = 1)
    {a : ℝ} (ha : a ≠ 0) :
    IsUnitOrientationOf
      ((a / |a|) • ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (fun _ : Fin 1 => v))
      (Submodule.span ℝ {v}) := by
  refine ⟨fun _ => v, ⟨fun _ => hv, fun i j hij => (hij (Subsingleton.elim i j)).elim⟩,
    by rw [range_const], ?_⟩
  rcases ha.lt_or_gt with h | h
  · exact Or.inr fun α => by simp [abs_of_neg h, div_neg, div_self ha]
  · exact Or.inl fun α => by simp [abs_of_pos h, div_self ha]

/-- `t ∑ₖ (aₖ / t) bₖ = ∑ₖ aₖ bₖ` provided all `aₖ` vanish when `t = 0`. -/
theorem Submission.odc_polyimrep_mul_sum_div {ι : Type} [Fintype ι] (t : ℝ) (a b : ι → ℝ)
    (h : t = 0 → ∀ k, a k = 0) : t * ∑ k, a k / t * b k = ∑ k, a k * b k := by
  rcases eq_or_ne t 0 with ht | ht
  · simp [ht, h ht]
  · rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun k _ => by field_simp

/-- `∫_B ∑ₖ nₖ 𝟙_{Sₖ} dμ = ∑ₖ nₖ μ(Sₖ ∩ B)`. -/
theorem Submission.odc_polyimrep_lintegral_sum {E : Type*} [MeasurableSpace E] {ι : Type}
    [Fintype ι] (μ : Measure E) (S : ι → Set E) (hS : ∀ k, MeasurableSet (S k)) (n : ι → ℕ)
    (B : Set E) :
    ∫⁻ x in B, ((∑ k, (S k).indicator (fun _ => n k) x : ℕ) : ℝ≥0∞) ∂μ =
      ∑ k, (n k : ℝ≥0∞) * μ (S k ∩ B) := by
  have h : ∀ x, ((∑ k, (S k).indicator (fun _ => n k) x : ℕ) : ℝ≥0∞) =
      ∑ k, (S k).indicator (fun _ => (n k : ℝ≥0∞)) x := fun x => by
    push_cast
    exact Finset.sum_congr rfl fun k _ => by by_cases hx : x ∈ S k <;> simp [hx]
  simp_rw [h]
  rw [lintegral_finsetSum _ fun k _ => measurable_const.indicator (hS k)]
  exact Finset.sum_congr rfl fun k _ => by
    rw [lintegral_indicator_const (hS k), Measure.restrict_apply (hS k)]

/-- `∫_M ∑ₖ cₖ 𝟙_{Sₖ} gₖ dμ = ∑ₖ cₖ ∫_{Sₖ} gₖ dμ` when `Sₖ ⊆ M` for `cₖ ≠ 0`. -/
theorem Submission.odc_polyimrep_integral_sum {E : Type*} [MeasurableSpace E] {ι : Type}
    [Fintype ι] (μ : Measure E) (S : ι → Set E) (hS : ∀ k, MeasurableSet (S k)) (M : Set E)
    (c : ι → ℝ) (hSM : ∀ k, c k ≠ 0 → S k ⊆ M) (g : ι → E → ℝ)
    (hg : ∀ k, IntegrableOn (g k) (S k) μ) :
    ∫ x in M, ∑ k, (S k).indicator (fun _ => c k) x * g k x ∂μ =
      ∑ k, c k * ∫ x in S k, g k x ∂μ := by
  have h : ∀ k, (fun x => (S k).indicator (fun _ => c k) x * g k x) =
      (S k).indicator (fun x => c k * g k x) := fun k => funext fun x => by
    by_cases hx : x ∈ S k <;> simp [hx]
  rw [integral_finsetSum _ fun k _ => ?_]
  · refine Finset.sum_congr rfl fun k _ => ?_
    rw [h, integral_indicator (hS k), Measure.restrict_restrict (hS k), integral_const_mul]
    rcases eq_or_ne (c k) 0 with hc | hc
    · simp [hc]
    · rw [inter_eq_left.2 (hSM k hc)]
  · rw [h, integrable_indicator_iff (hS k), IntegrableOn, Measure.restrict_restrict (hS k)]
    exact IntegrableOn.mono_set ((hg k).const_mul (c k)) inter_subset_left

/-- At a point of the `k`-th piece away from the closures of the other pieces, a union of
pieces containing the `k`-th one has the line `span {vₖ}` as approximate tangent space. -/
theorem Submission.odc_polyimrep_tangent {P : ℕ} {ι : Type} [Finite ι] (p v : ι → Euclid P)
    (I : ι → Set ℝ) (hv : ∀ k, ‖v k‖ = 1) (hI : ∀ k, IsOpen (I k)) {M : Set (Euclid P)}
    (hM : MeasurableSet M) (hMS : M ⊆ ⋃ j, (fun t : ℝ => p j + t • v j) '' I j) {k : ι}
    (hkM : (fun t : ℝ => p k + t • v k) '' I k ⊆ M) {x : Euclid P}
    (hx : x ∈ (fun t : ℝ => p k + t • v k) '' I k)
    (hxj : ∀ j, j ≠ k → x ∉ closure ((fun t : ℝ => p j + t • v j) '' I j)) :
    HasApproximateTangentSpaceAt 1 M x (Submodule.span ℝ {v k}) := by
  obtain ⟨t₀, ht₀, rfl⟩ := hx
  obtain ⟨ε, hε, hεI⟩ := Metric.isOpen_iff.1 (hI k) t₀ ht₀
  have hev : ∀ᶠ y in 𝓝 (p k + t₀ • v k), ∀ j, j ≠ k →
      y ∉ (fun t : ℝ => p j + t • v j) '' I j := by
    refine Filter.eventually_all.2 fun j => ?_
    by_cases hjk : j = k
    · exact Filter.Eventually.of_forall fun _ h => absurd hjk h
    · exact (Filter.not_frequently.1 (mt mem_closure_iff_frequently.2 (hxj j hjk))).mono
        fun _ hy _ => hy
  obtain ⟨δ, hδ, hδS⟩ := Metric.eventually_nhds_iff.1 hev
  -- near `x`, `M` coincides with the `k`-th line
  refine Submission.odc_approxTangent_of_locally_line M hM _ (v k)
    (norm_ne_zero_iff.1 (by simp [hv k])) (min ε δ) (lt_min hε hδ) ?_
  ext y
  simp only [mem_inter_iff, mem_ball, mem_range]
  constructor
  · rintro ⟨hyM, hy⟩
    obtain ⟨j, hj⟩ := mem_iUnion.1 (hMS hyM)
    obtain rfl : j = k := by
      by_contra hjk
      exact hδS (hy.trans_le (min_le_right _ _)) j hjk hj
    obtain ⟨t, -, rfl⟩ := hj
    exact ⟨⟨t - t₀, by simp only; rw [sub_smul]; abel⟩, hy⟩
  · rintro ⟨⟨s, rfl⟩, hy⟩
    refine ⟨hkM ⟨t₀ + s, hεI ?_, by simp only; rw [add_smul, add_assoc]⟩, hy⟩
    have h1 : dist (p k + t₀ • v k + s • v k) (p k + t₀ • v k) = |s| := by
      rw [dist_eq_norm, add_sub_cancel_left, norm_smul, hv k, mul_one, Real.norm_eq_abs]
    rw [mem_ball, Real.dist_eq, add_sub_cancel_left, ← h1]
    exact hy.trans_le (min_le_left _ _)

/-- An open ray from the origin misses the closure of any other unit ray. -/
theorem Submission.odc_polyimrep_ray_inter_closure {P : ℕ} {e e' : Euclid P} (he : ‖e‖ = 1)
    (he' : ‖e'‖ = 1) (hne : e ≠ e') :
    ((fun t : ℝ => (0 : Euclid P) + t • e) '' Ioi 0) ∩
      closure ((fun t : ℝ => (0 : Euclid P) + t • e') '' Ioi 0) = ∅ := by
  have hcl : closure ((fun t : ℝ => (0 : Euclid P) + t • e') '' Ioi 0) ⊆
      (fun t : ℝ => (0 : Euclid P) + t • e') '' Ici 0 :=
    closure_minimal (image_mono Ioi_subset_Ici_self)
      ((Submission.odc_line_isometry 0 e' he').isClosedEmbedding.isClosedMap _ isClosed_Ici)
  refine eq_empty_iff_forall_notMem.2 fun x ⟨⟨t, ht, hx⟩, hx'⟩ => ?_
  obtain ⟨s, hs, rfl⟩ := hcl hx'
  simp only [zero_add] at hx
  have hts : t = s := by
    have h := congrArg norm hx
    rwa [norm_smul, norm_smul, he, he', mul_one, mul_one, Real.norm_of_nonneg (le_of_lt ht),
      Real.norm_of_nonneg hs] at h
  subst hts
  exact hne (smul_right_injective _ (ne_of_gt ht) hx)

/-- Finitely many weighted oriented open line pieces with `H¹`-null mutual overlaps form an
integer multiplicity representation. -/
theorem Submission.odc_polygonal_imrep {P : ℕ} {ι : Type} [Fintype ι] (p v : ι → Euclid P)
    (I : ι → Set ℝ) (c : ι → ℤ) (hv : ∀ k, ‖v k‖ = 1) (hI : ∀ k, IsOpen (I k))
    (hdisj : ∀ j k, j ≠ k → (μHE[1] : Measure (Euclid P))
      (((fun t : ℝ => p j + t • v j) '' I j) ∩
        closure ((fun t : ℝ => p k + t • v k) '' I k)) = 0) :
    ∃ R : IMRep (univ : Set (Euclid P)) 1,
      (∀ ω : TestFormOn (univ : Set (Euclid P)) 1,
        R.action (ω : DifferentialForm (Euclid P) 1) =
          ∑ k, (c k : ℝ) * ∫ t in I k,
            (ω : DifferentialForm (Euclid P) 1) (p k + t • v k) (fun _ => v k)) ∧
      ∀ A : Set (Euclid P), MeasurableSet A →
        R.measure A = ∑ k, ENNReal.ofReal |(c k : ℝ)| *
          volume (I k ∩ (fun t : ℝ => p k + t • v k) ⁻¹' A) := by
  -- the pieces `Sₖ = γₖ(Iₖ)`, the carrier `M`, the multiplicity `θ` and the orientation `ξ`
  obtain ⟨S, hSdef⟩ : ∃ S : ι → Set (Euclid P),
      ∀ k, S k = (fun t : ℝ => p k + t • v k) '' I k := ⟨_, fun _ => rfl⟩
  have hS : ∀ k, MeasurableSet (S k) := fun k => by
    rw [hSdef]
    exact Submission.odc_line_measurableSet_image _ _ (hv k) (hI k).measurableSet
  obtain ⟨M, hMdef⟩ : ∃ M : Set (Euclid P), M = ⋃ k, ⋃ (_ : c k ≠ 0), S k := ⟨_, rfl⟩
  have hmemM : ∀ x, x ∈ M ↔ ∃ k, c k ≠ 0 ∧ x ∈ S k := fun x => by simp [hMdef]
  have hM : MeasurableSet M :=
    hMdef ▸ MeasurableSet.iUnion fun k => MeasurableSet.iUnion fun _ => hS k
  have hSM : ∀ k, c k ≠ 0 → S k ⊆ M := fun k hk x hx => (hmemM x).2 ⟨k, hk, hx⟩
  obtain ⟨θ, hθdef⟩ : ∃ θ : Euclid P → ℕ,
      θ = fun x => ∑ k, (S k).indicator (fun _ => (c k).natAbs) x := ⟨_, rfl⟩
  have hθmeas : Measurable θ :=
    hθdef ▸ Finset.measurable_sum _ fun k _ => measurable_const.indicator (hS k)
  have hθlint : ∀ B, ∫⁻ x in B, (θ x : ℝ≥0∞) ∂μHE[1] =
      ∑ k, ((c k).natAbs : ℝ≥0∞) * μHE[1] (S k ∩ B) := fun B => by
    rw [hθdef]
    exact Submission.odc_polyimrep_lintegral_sum _ S hS _ B
  obtain ⟨ξ, hξdef⟩ : ∃ ξ : Euclid P → MultiVector P 1, ξ = fun x =>
      ∑ k, ((S k).indicator (fun _ => (c k : ℝ)) x / θ x) •
        ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (fun _ : Fin 1 => v k) := ⟨_, rfl⟩
  have hθξ : ∀ x (α : Covector (Euclid P) 1), (θ x : ℝ) * ξ x α =
      ∑ k, (S k).indicator (fun _ => (c k : ℝ)) x * α (fun _ => v k) := by
    intro x α
    have h0 : (θ x : ℝ) = 0 → ∀ k, (S k).indicator (fun _ => (c k : ℝ)) x = 0 := by
      intro h k
      rw [Nat.cast_eq_zero, hθdef] at h
      have hk := Finset.sum_eq_zero_iff.1 h k (Finset.mem_univ k)
      rw [indicator_apply_eq_zero] at hk ⊢
      exact fun hx => by simp [Int.natAbs_eq_zero.1 (hk hx)]
    rw [hξdef]
    simp only [sum_apply, smul_apply, smul_eq_mul, ContinuousAlternatingMap.apply_apply]
    exact Submission.odc_polyimrep_mul_sum_div _ _ _ h0
  have hξmeas : StronglyMeasurable ξ := by
    -- instance search does not find `ContinuousAdd` for this space of continuous linear maps
    have : ContinuousAdd (MultiVector P 1) :=
      (inferInstance : IsTopologicalAddGroup (MultiVector P 1)).toContinuousAdd
    rw [hξdef]
    exact Finset.stronglyMeasurable_fun_sum _ fun k _ =>
      (((measurable_const.indicator (hS k)).div
        (measurable_from_nat.comp hθmeas)).stronglyMeasurable).smul_const _
  let R : IMRep (univ : Set (Euclid P)) 1 :=
    { carrier := M
      mult := θ
      orient := ξ
      measurableSet_carrier := hM
      carrier_subset := subset_univ M
      rectifiable := by
        refine (Poincare.SimonGMT.Chapter03.countablyRectifiable_sUnion (countable_range S)
          (forall_mem_range.2 fun k => ?_)).mono ?_
        · rw [hSdef]
          exact Submission.odc_polyimrep_rectifiable _ _ (hv k) _
        · intro x hx
          obtain ⟨k, -, hxk⟩ := (hmemM x).1 hx
          exact ⟨S k, mem_range_self k, hxk⟩
      measurable_mult := hθmeas
      mult_pos := fun x hx => by
        obtain ⟨k, hk, hxk⟩ := (hmemM x).1 hx
        rw [hθdef]
        refine (Int.natAbs_pos.2 hk).trans_le ?_
        calc (c k).natAbs = (S k).indicator (fun _ => (c k).natAbs) x :=
              (indicator_of_mem hxk fun _ => (c k).natAbs).symm
          _ ≤ _ := Finset.single_le_sum (f := fun j => (S j).indicator (fun _ => (c j).natAbs) x)
              (fun j _ => Nat.zero_le _) (Finset.mem_univ k)
      locallyIntegrable_mult := fun K hK _ => by
        rw [hθlint]
        refine ENNReal.sum_ne_top.2 fun k _ => ENNReal.mul_ne_top (ENNReal.natCast_ne_top _) ?_
        refine ne_top_of_le_ne_top ?_ (measure_mono (inter_subset_inter_right _ inter_subset_right))
        rw [hSdef]
        exact Submission.odc_polyimrep_measure_inter_ne_top _ _ (hv k) _ hK
      aestronglyMeasurable_orient := hξmeas.aestronglyMeasurable
      orients := by
        -- off the null set of overlaps, `M` is locally a single oriented line
        have hB : (μHE[1] : Measure (Euclid P))
            (⋃ j, ⋃ k, ⋃ (_ : j ≠ k), S j ∩ closure (S k)) = 0 :=
          measure_iUnion_null fun j => measure_iUnion_null fun k => measure_iUnion_null fun h => by
            rw [hSdef, hSdef]
            exact hdisj j k h
        filter_upwards [ae_restrict_of_ae (measure_eq_zero_iff_ae_notMem.1 hB), ae_restrict_mem hM]
          with x hxB hxM
        obtain ⟨k, hk, hxk⟩ := (hmemM x).1 hxM
        have hxj : ∀ j, j ≠ k → x ∉ closure (S j) := fun j hjk h =>
          hxB (mem_iUnion.2 ⟨k, mem_iUnion.2 ⟨j, mem_iUnion.2 ⟨hjk.symm, hxk, h⟩⟩⟩)
        have hθx : θ x = (c k).natAbs := by
          rw [hθdef]
          dsimp only
          rw [Finset.sum_eq_single k (fun j _ hjk => indicator_of_notMem
              (fun h => hxj j hjk (subset_closure h)) _) (fun h => (h (Finset.mem_univ k)).elim),
            indicator_of_mem hxk]
        have hξx : ξ x = ((c k : ℝ) / |(c k : ℝ)|) •
            ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (fun _ : Fin 1 => v k) := by
          rw [hξdef]
          dsimp only
          rw [Finset.sum_eq_single k (fun j _ hjk => by
              rw [indicator_of_notMem (fun h => hxj j hjk (subset_closure h)), zero_div, zero_smul])
            (fun h => (h (Finset.mem_univ k)).elim), indicator_of_mem hxk, hθx, Nat.cast_natAbs,
            Int.cast_abs]
        refine ⟨Submodule.span ℝ {v k}, ?_, ?_⟩
        · have hMS : M ⊆ ⋃ j, (fun t : ℝ => p j + t • v j) '' I j := fun y hy => by
            obtain ⟨j, -, hyj⟩ := (hmemM y).1 hy
            exact mem_iUnion.2 ⟨j, by rwa [← hSdef]⟩
          refine Submission.odc_polyimrep_tangent p v I hv hI hM hMS
            (by rw [← hSdef]; exact hSM k hk) (by rw [← hSdef]; exact hxk) fun j hjk => ?_
          rw [← hSdef]
          exact hxj j hjk
        · rw [hξx]
          exact Submission.odc_polyimrep_unitOrientation (v k) (hv k) (Int.cast_ne_zero.2 hk) }
  refine ⟨R, fun ω => ?_, fun A hA => ?_⟩
  · obtain ⟨⟨hωs, hωc⟩, -⟩ := ω.2
    show ∫ x in M, (θ x : ℝ) * ξ x ((ω : DifferentialForm (Euclid P) 1) x) ∂μHE[1] = _
    simp_rw [hθξ]
    rw [Submission.odc_polyimrep_integral_sum _ S hS M _
      (fun k hk => hSM k (Int.cast_ne_zero.1 hk)) _ fun k => ?_]
    · refine Finset.sum_congr rfl fun k _ => ?_
      rw [hSdef, Submission.odc_line_integral (p k) (v k) (hv k)]
    · rw [hSdef]
      exact Submission.odc_polyimrep_integrableOn _ _ (hv k) _
        ((ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ fun _ : Fin 1 => v k).continuous.comp
          (ContDiff.continuous hωs))
        (hωc.comp_left (g := ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ fun _ : Fin 1 => v k)
          (map_zero _))
  · show ((μHE[1].restrict M).withDensity fun x => (θ x : ℝ≥0∞)) A = _
    rw [withDensity_apply _ hA, Measure.restrict_restrict hA, hθlint]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [← Int.cast_abs, ← Nat.cast_natAbs, ENNReal.ofReal_natCast]
    rcases eq_or_ne (c k) 0 with hk | hk
    · simp [hk]
    · rw [← inter_assoc, inter_eq_left.2 (inter_subset_left.trans (hSM k hk)), hSdef,
        Submission.odc_polyimrep_measure_inter _ _ (hv k)]

/-- A current given by integer multiplicities on finitely many rays is integer multiplicity,
with mass measure `∑ |m e| H¹⌞ray(e)`. -/
theorem Submission.odc_ray_current_imrep {P : ℕ}
    (C : GeometricCurrentOn (univ : Set (Euclid P)) 1)
    (F : Finset (Euclid P)) (hF : ∀ e ∈ F, ‖e‖ = 1) (m : Euclid P → ℤ)
    (hC : ∀ ω : TestFormOn (univ : Set (Euclid P)) 1,
      C ω = ∑ e ∈ F, (m e : ℝ) * ∫ t in Ioi (0 : ℝ),
        (ω : DifferentialForm (Euclid P) 1) (t • e) (fun _ => e)) :
    ∃ R : IMRep (univ : Set (Euclid P)) 1, R.Represents C ∧
      ∀ A : Set (Euclid P), MeasurableSet A →
        R.measure A = ∑ e ∈ F, ENNReal.ofReal |(m e : ℝ)| *
          volume (Ioi (0 : ℝ) ∩ (fun t : ℝ => t • e) ⁻¹' A) := by
  obtain ⟨R, hact, hmeas⟩ := Submission.odc_polygonal_imrep (ι := F) (fun _ => 0)
    (fun e => (e : Euclid P)) (fun _ => Ioi 0) (fun e => m e) (fun e => hF e e.2)
    (fun _ => isOpen_Ioi) fun j k hjk => by
      rw [Submission.odc_polyimrep_ray_inter_closure (hF j j.2) (hF k k.2)
        fun h => hjk (Subtype.ext h)]
      exact measure_empty
  refine ⟨R, fun ω => ?_, fun A hA => ?_⟩
  · rw [hC ω, hact ω, ← Finset.sum_coe_sort F]
    simp only [zero_add]
  · rw [hmeas A hA, ← Finset.sum_coe_sort F]
    simp only [zero_add]

/-- Chain rule along a line: `d/ds f (s • e) = Df(s • e) e`. -/
theorem Submission.odc_constancy_deriv_ray {P : ℕ} {f : Euclid P → ℝ} (hf : Differentiable ℝ f)
    (e : Euclid P) (t : ℝ) : deriv (fun s : ℝ => f (s • e)) t = fderiv ℝ f (t • e) e := by
  have h := (hf (t • e)).hasFDerivAt.comp_hasDerivAt t ((hasDerivAt_id' t).smul_const e)
  rw [one_smul] at h
  exact h.deriv

/-- Testing a boundaryless current given by densities along rays against the differential of a
smooth compactly supported function. -/
theorem Submission.odc_constancy_exact {P : ℕ} (C : GeometricCurrentOn (univ : Set (Euclid P)) 1)
    (hC : C.boundary = 0) (F : Finset (Euclid P)) (G : Euclid P → ℝ → ℝ)
    (hrep : ∀ ω : TestFormOn (univ : Set (Euclid P)) 1,
      C ω = ∑ e ∈ F, ∫ t in Ioi (0 : ℝ),
        G e t * (ω : DifferentialForm (Euclid P) 1) (t • e) (fun _ => e))
    {f : Euclid P → ℝ} (hf : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) f) (hfc : HasCompactSupport f) :
    ∑ e ∈ F, ∫ t in Ioi (0 : ℝ), G e t * deriv (fun s : ℝ => f (s • e)) t = 0 := by
  obtain ⟨φ, hφ⟩ := Submission.odc_zero_testForm f hf hfc
  have h0 : C.boundary φ = 0 := by rw [hC]; rfl
  rw [GeometricCurrentOn.boundary_apply, hrep] at h0
  simp only [hφ] at h0
  simp only [Submission.odc_constancy_deriv_ray (hf.differentiable (by simp))]
  exact h0

/-- `∫₀^∞ (d/dt) f (t • e) dt = -f 0` for a smooth compactly supported `f` and a unit vector
`e`. -/
theorem Submission.odc_constancy_integral_deriv {P : ℕ} {f : Euclid P → ℝ}
    (hf : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) f) (hfc : HasCompactSupport f) {e : Euclid P}
    (he : ‖e‖ = 1) :
    ∫ t in Ioi (0 : ℝ), deriv (fun s : ℝ => f (s • e)) t = -f 0 := by
  have hiso : Isometry fun s : ℝ => s • e := by
    refine Isometry.of_dist_eq fun s t => ?_
    rw [dist_eq_norm, ← sub_smul, norm_smul, he, mul_one, Real.dist_eq, Real.norm_eq_abs]
  have hh : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) fun s : ℝ => f (s • e) :=
    hf.comp (contDiff_id.smul contDiff_const)
  have hhc : HasCompactSupport fun s : ℝ => f (s • e) :=
    hfc.comp_isClosedEmbedding hiso.isClosedEmbedding
  have h1 : (1 : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by exact_mod_cast le_top
  rw [integral_Ioi_of_hasDerivAt_of_tendsto hh.continuous.continuousWithinAt
    (fun x _ => ((hh.differentiable (by simp)) x).hasDerivAt)
    ((hh.continuous_deriv h1).integrable_of_hasCompactSupport hhc.deriv).integrableOn
    (hhc.is_zero_at_infty.mono_left atTop_le_cocompact)]
  simp

/-- A smooth compactly supported function equal to `ψ` along the line `ℝ e₀` and vanishing on
the open rays `ℝ₊ e` of the other unit vectors `e ∈ F`. -/
theorem Submission.odc_constancy_cutoff {P : ℕ} (F : Finset (Euclid P)) (hF : ∀ e ∈ F, ‖e‖ = 1)
    {e₀ : Euclid P} (he₀ : ‖e₀‖ = 1) {ψ : ℝ → ℝ} (hψ : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) ψ)
    (hψc : HasCompactSupport ψ) (hψs : tsupport ψ ⊆ Ioi 0) :
    ∃ f : Euclid P → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) f ∧ HasCompactSupport f ∧
      (∀ s : ℝ, f (s • e₀) = ψ s) ∧ ∀ e ∈ F, e ≠ e₀ → ∀ t : ℝ, 0 < t → f (t • e) = 0 := by
  -- `α ≤ s ≤ β` on the support of `ψ`, with `0 < α`
  obtain ⟨α, hα, hαψ⟩ := hψc.isCompact.exists_forall_le' continuousOn_id fun b hb => hψs hb
  obtain ⟨β, hβψ⟩ := hψc.isCompact.bddAbove
  have hψαβ : ∀ s, ψ s ≠ 0 → α ≤ s ∧ s ≤ β := fun s hs =>
    ⟨hαψ s (subset_tsupport ψ hs), hβψ (subset_tsupport ψ hs)⟩
  -- the width `κ` of the cylinder around `ℝ e₀` misses the rays of the other `e ∈ F`
  obtain ⟨κ, hκ0, hκ⟩ : ∃ κ : ℝ, 0 < κ ∧ ∀ e ∈ F, inner ℝ e e₀ ^ 2 < 1 →
      κ < α ^ 2 * (1 - inner ℝ e e₀ ^ 2) := by
    have : ∀ᶠ κ in 𝓝[>] (0 : ℝ), 0 < κ ∧ ∀ e ∈ F, inner ℝ e e₀ ^ 2 < 1 →
        κ < α ^ 2 * (1 - inner ℝ e e₀ ^ 2) := by
      refine eventually_mem_nhdsWithin.and ((eventually_all_finset F).2 fun e _ => ?_)
      by_cases h : inner ℝ e e₀ ^ 2 < 1
      · have hpos : 0 < α ^ 2 * (1 - inner ℝ e e₀ ^ 2) := mul_pos (pow_pos hα 2) (sub_pos.2 h)
        exact (eventually_nhdsWithin_of_eventually_nhds (eventually_lt_nhds hpos)).mono
          fun κ hκ _ => hκ
      · exact Eventually.of_forall fun κ h' => absurd h' h
    exact this.exists
  obtain ⟨χ, hχ, hχ0, hχκ⟩ : ∃ χ : ℝ → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) χ ∧ χ 0 = 1 ∧
      ∀ s, κ ≤ s → χ s = 0 := by
    let b : ContDiffBump (0 : ℝ) := ⟨κ / 2, κ, half_pos hκ0, half_lt_self hκ0⟩
    refine ⟨b, b.contDiff, b.one_of_mem_closedBall (mem_closedBall_self (half_pos hκ0).le),
      fun s hs => b.zero_of_le_dist ?_⟩
    rw [Real.dist_eq, sub_zero]
    exact hs.trans (le_abs_self s)
  have hin : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) fun x : Euclid P => inner ℝ x e₀ :=
    contDiff_id.inner ℝ contDiff_const
  refine ⟨fun x => ψ (inner ℝ x e₀) * χ (‖x‖ ^ 2 - inner ℝ x e₀ ^ 2),
    (hψ.comp hin).mul (hχ.comp ((contDiff_norm_sq ℝ).sub (hin.pow 2))), ?_, ?_, ?_⟩
  · refine HasCompactSupport.intro (K := closedBall 0 (β ^ 2 + κ + 1)) (isCompact_closedBall _ _)
      fun x hx => ?_
    by_contra hne
    have hψx : ψ (inner ℝ x e₀) ≠ 0 := left_ne_zero_of_mul hne
    have hχx : χ (‖x‖ ^ 2 - inner ℝ x e₀ ^ 2) ≠ 0 := right_ne_zero_of_mul hne
    obtain ⟨h1, h2⟩ := hψαβ _ hψx
    have h3 : ‖x‖ ^ 2 - inner ℝ x e₀ ^ 2 < κ := not_le.1 fun h => hχx (hχκ _ h)
    have h4 : inner ℝ x e₀ ^ 2 ≤ β ^ 2 := pow_le_pow_left₀ (hα.le.trans h1) h2 2
    rw [mem_closedBall, dist_zero_right, not_le] at hx
    nlinarith [norm_nonneg x, sq_nonneg β]
  · intro s
    have h1 : inner ℝ (s • e₀) e₀ = s := by
      rw [real_inner_smul_left, real_inner_self_eq_norm_sq, he₀, one_pow, mul_one]
    have h2 : ‖s • e₀‖ ^ 2 = s ^ 2 := by
      rw [norm_smul, he₀, mul_one, Real.norm_eq_abs, sq_abs]
    simp only [h1, h2, sub_self, hχ0, mul_one]
  · intro e he hne t ht
    have he1 := hF e he
    have h1 : inner ℝ (t • e) e₀ = t * inner ℝ e e₀ := real_inner_smul_left _ _ _
    have h2 : ‖t • e‖ ^ 2 = t ^ 2 := by
      rw [norm_smul, he1, mul_one, Real.norm_eq_abs, sq_abs]
    simp only [h1, h2]
    by_cases hψt : ψ (t * inner ℝ e e₀) = 0
    · rw [hψt, zero_mul]
    · have hαt := (hψαβ _ hψt).1
      have hc0 : 0 < inner ℝ e e₀ := pos_of_mul_pos_right (hα.trans_le hαt) ht.le
      have hc1 : inner ℝ e e₀ < 1 := by
        have h := norm_sub_sq_real e e₀
        have hpos : 0 < ‖e - e₀‖ := norm_pos_iff.2 (sub_ne_zero.2 hne)
        rw [he1, he₀] at h
        nlinarith
      have hc2 : inner ℝ e e₀ ^ 2 < 1 := by nlinarith
      have hκ' := hκ e he hc2
      have htα : α ≤ t := by nlinarith
      have hα2 : α ^ 2 ≤ t ^ 2 := pow_le_pow_left₀ hα.le htα 2
      rw [hχκ _ (by nlinarith [mul_le_mul_of_nonneg_right hα2 (sub_pos.2 hc2).le]), mul_zero]

/-- Constancy along the rays: a `1`-cycle given by integer densities along finitely many rays
has constant integer multiplicities `m e` with `∑ m e = 0`. -/
theorem Submission.odc_ray_constancy {P : ℕ} (C : GeometricCurrentOn (univ : Set (Euclid P)) 1)
    (hC : C.boundary = 0) (F : Finset (Euclid P)) (hF : ∀ e ∈ F, ‖e‖ = 1)
    (g : Euclid P → ℝ → ℝ) (hg : ∀ e ∈ F, LocallyIntegrableOn (g e) (Ioi 0))
    (hgZ : ∀ e ∈ F, ∀ᵐ t ∂(volume.restrict (Ioi (0 : ℝ))), ∃ k : ℤ, g e t = k)
    (hrep : ∀ ω : TestFormOn (univ : Set (Euclid P)) 1,
      C ω = ∑ e ∈ F, ∫ t in Ioi (0 : ℝ),
        g e t * (ω : DifferentialForm (Euclid P) 1) (t • e) (fun _ => e)) :
    ∃ m : Euclid P → ℤ, ∑ e ∈ F, m e = 0 ∧
      ∀ ω : TestFormOn (univ : Set (Euclid P)) 1,
        C ω = ∑ e ∈ F, (m e : ℝ) * ∫ t in Ioi (0 : ℝ),
          (ω : DifferentialForm (Euclid P) 1) (t • e) (fun _ => e) := by
  classical
  -- (1) the density is a.e. an integer constant along each ray
  have hconst : ∀ e₀ ∈ F, ∃ k : ℤ, ∀ᵐ t ∂(volume.restrict (Ioi (0 : ℝ))), g e₀ t = k := by
    intro e₀ he₀
    obtain ⟨c, hc⟩ := Submission.odc_du_bois_reymond (g e₀) (hg e₀ he₀) fun ψ hψ hψc hψs => by
      obtain ⟨f, hf, hfc, hfe₀, hf0⟩ :=
        Submission.odc_constancy_cutoff F hF (hF e₀ he₀) hψ hψc hψs
      have h := Submission.odc_constancy_exact C hC F g hrep hf hfc
      rw [Finset.sum_eq_single_of_mem e₀ he₀ fun e he hne =>
        setIntegral_eq_zero_of_forall_eq_zero fun t (ht : 0 < t) => by
          have : (fun s : ℝ => f (s • e)) =ᶠ[𝓝 t] fun _ => 0 :=
            eventually_of_mem (Ioi_mem_nhds ht) fun s hs => hf0 e he hne s hs
          rw [this.deriv_eq, deriv_const, mul_zero]] at h
      have hψ' : (fun s : ℝ => f (s • e₀)) = ψ := funext hfe₀
      rwa [hψ'] at h
    have : (ae (volume.restrict (Ioi (0 : ℝ)))).NeBot := ae_restrict_neBot.2 (by simp)
    obtain ⟨t, ht, k, hk⟩ := (hc.and (hgZ e₀ he₀)).exists
    exact ⟨k, hc.mono fun s hs => hs.trans (ht.symm.trans hk)⟩
  have hm : ∀ e, ∃ k : ℤ, e ∈ F → ∀ᵐ t ∂(volume.restrict (Ioi (0 : ℝ))), g e t = k := by
    intro e
    by_cases he : e ∈ F
    · obtain ⟨k, hk⟩ := hconst e he
      exact ⟨k, fun _ => hk⟩
    · exact ⟨0, fun h => absurd h he⟩
  choose m hm using hm
  -- (2) the representation with the constant multiplicities
  have hrep' : ∀ ω : TestFormOn (univ : Set (Euclid P)) 1,
      C ω = ∑ e ∈ F, (m e : ℝ) * ∫ t in Ioi (0 : ℝ),
        (ω : DifferentialForm (Euclid P) 1) (t • e) (fun _ => e) := by
    intro ω
    rw [hrep ω]
    refine Finset.sum_congr rfl fun e he => ?_
    rw [← integral_const_mul]
    exact integral_congr_ae ((hm e he).mono fun t ht => by simp only [ht])
  refine ⟨m, ?_, hrep'⟩
  -- (3) Kirchhoff's law at the origin, tested against a bump function
  let b : ContDiffBump (0 : Euclid P) := ⟨1, 2, one_pos, one_lt_two⟩
  have hK : ∑ e ∈ F, ∫ t in Ioi (0 : ℝ), (m e : ℝ) * deriv (fun s : ℝ => b (s • e)) t = 0 :=
    Submission.odc_constancy_exact C hC F (fun e _ => (m e : ℝ))
      (fun ω => by rw [hrep' ω]; simp only [integral_const_mul]) b.contDiff b.hasCompactSupport
  have hsum : ∑ e ∈ F, ∫ t in Ioi (0 : ℝ), (m e : ℝ) * deriv (fun s : ℝ => b (s • e)) t =
      -∑ e ∈ F, (m e : ℝ) := by
    rw [← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun e he => ?_
    rw [integral_const_mul, Submission.odc_constancy_integral_deriv b.contDiff
      b.hasCompactSupport (hF e he), b.one_of_mem_closedBall (mem_closedBall_self zero_le_one),
      mul_neg_one]
  rw [hsum, neg_eq_zero] at hK
  exact_mod_cast hK

/-- The ray map `t ↦ t • e` of a unit vector is a measurable embedding. -/
theorem Submission.odc_rays_measurableEmbedding {P : ℕ} {e : Euclid P} (he : ‖e‖ = 1) :
    MeasurableEmbedding (fun t : ℝ => t • e) := by
  simpa only [zero_add] using Submission.odc_line_measurableEmbedding 0 e he

/-- `H¹⌞{t e : t ∈ I} = (t ↦ t e)_# (ℒ¹⌞I)` for a unit vector `e`. -/
theorem Submission.odc_rays_restrict {P : ℕ} {e : Euclid P} (he : ‖e‖ = 1) (I : Set ℝ) :
    (μHE[1] : Measure (Euclid P)).restrict ((fun t : ℝ => t • e) '' I) =
      Measure.map (fun t : ℝ => t • e) (volume.restrict I) := by
  simpa only [zero_add] using Submission.odc_line_restrict 0 e he I

/-- Open rays spanned by distinct unit vectors are disjoint. -/
theorem Submission.odc_rays_disjoint {P : ℕ} {e e' : Euclid P} (he : ‖e‖ = 1) (he' : ‖e'‖ = 1)
    (hne : e ≠ e') :
    Disjoint ((fun t : ℝ => t • e) '' Ioi 0) ((fun t : ℝ => t • e') '' Ioi 0) := by
  rw [Set.disjoint_left]
  rintro _ ⟨t, ht, rfl⟩ ⟨s, hs, hst⟩
  have ht' : (0 : ℝ) < t := ht
  have hs' : (0 : ℝ) < s := hs
  dsimp only at hst
  -- comparing norms gives `s = t`, and then `e' = e`
  have hts : s = t := by
    simpa [norm_smul, he, he', abs_of_pos ht', abs_of_pos hs'] using congrArg norm hst
  subst hts
  exact hne (smul_right_injective (Euclid P) hs'.ne' hst).symm

/-- If `ξ = ±e` for a unit vector `e`, then `ξ(e♭) = ±1` and `ξ(α) = ξ(e♭) α(e)`, where
`e♭ = ⟪e, ·⟫`. -/
theorem Submission.odc_rays_orient {P : ℕ} {e : Euclid P} (he : ‖e‖ = 1) {ξ : MultiVector P 1}
    (hξ : ξ = ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (fun _ => e) ∨
      ξ = -ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (fun _ => e)) :
    (ξ (ContinuousAlternatingMap.ofSubsingleton ℝ (Euclid P) ℝ (0 : Fin 1) (innerSL ℝ e)) = 1 ∨
      ξ (ContinuousAlternatingMap.ofSubsingleton ℝ (Euclid P) ℝ (0 : Fin 1) (innerSL ℝ e)) = -1) ∧
    ∀ α : Covector (Euclid P) 1, ξ α =
      ξ (ContinuousAlternatingMap.ofSubsingleton ℝ (Euclid P) ℝ (0 : Fin 1) (innerSL ℝ e)) *
        α (fun _ => e) := by
  have h1 : ContinuousAlternatingMap.ofSubsingleton ℝ (Euclid P) ℝ (0 : Fin 1) (innerSL ℝ e)
      (fun _ => e) = 1 := by
    simp [he]
  rcases hξ with rfl | rfl <;> simp [h1]

/-- A unit orientation has norm `≤ 1`, so `‖ξ‖ ≤ 1` almost everywhere on the carrier. -/
theorem Submission.odc_rays_norm_orient_le {P n : ℕ} {U : Set (Euclid P)} (R : IMRep U n) :
    ∀ᵐ x ∂((μHE[n] : Measure (Euclid P)).restrict R.carrier), ‖R.orient x‖ ≤ 1 := by
  filter_upwards [R.orients] with x hx
  obtain ⟨Q, -, hQ⟩ := hx
  exact (Submission.imsupp_unit_orientation_ne_zero_norm_le_one P n _ Q hQ).2

/-- `θ ξ(Φ)` is integrable on the part of the carrier in a compact set, for bounded measurable
`Φ`. -/
theorem Submission.odc_rays_integrableOn {P n : ℕ} (R : IMRep (univ : Set (Euclid P)) n)
    {K : Set (Euclid P)} (hK : IsCompact K) {Φ : Euclid P → Covector (Euclid P) n}
    (hΦ : AEStronglyMeasurable Φ ((μHE[n] : Measure (Euclid P)).restrict R.carrier)) {C : ℝ}
    (hC : ∀ x, ‖Φ x‖ ≤ C) :
    IntegrableOn (fun x => (R.mult x : ℝ) * R.orient x (Φ x)) (R.carrier ∩ K) μHE[n] := by
  have hθ : Measurable fun x => (R.mult x : ℝ) := measurable_from_nat.comp R.measurable_mult
  -- the dominating function `C θ` is integrable since `θ` is locally `H¹`-integrable
  have hint : IntegrableOn (fun x => C * (R.mult x : ℝ)) (R.carrier ∩ K) μHE[n] := by
    refine Integrable.const_mul ?_ C
    simpa using integrable_toReal_of_lintegral_ne_top
      (measurable_from_nat.comp R.measurable_mult).aemeasurable
      (R.locallyIntegrable_mult K hK (subset_univ K))
  refine hint.mono' (hθ.aestronglyMeasurable.mul ?_) ?_
  · exact (isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable₂
      R.aestronglyMeasurable_orient hΦ).mono_measure
      (Measure.restrict_mono inter_subset_left le_rfl)
  · filter_upwards [ae_restrict_of_ae_restrict_of_subset inter_subset_left
      (Submission.odc_rays_norm_orient_le R)] with x hx
    rw [norm_mul, Real.norm_natCast, mul_comm C]
    gcongr
    calc ‖R.orient x (Φ x)‖ ≤ ‖R.orient x‖ * ‖Φ x‖ := (R.orient x).le_opNorm _
      _ ≤ 1 * C := mul_le_mul hx (hC x) (norm_nonneg _) zero_le_one
      _ = C := one_mul C

/-- `θ ξ(ω)` is integrable on the carrier for a test form `ω`. -/
theorem Submission.odc_rays_integrableOn_form {P n : ℕ} (R : IMRep (univ : Set (Euclid P)) n)
    (ω : TestFormOn (univ : Set (Euclid P)) n) :
    IntegrableOn (fun x => (R.mult x : ℝ) * R.orient x ((ω : DifferentialForm (Euclid P) n) x))
      R.carrier μHE[n] := by
  obtain ⟨⟨hsm, hcs⟩, -⟩ := ω.2
  have hcont : Continuous (ω : DifferentialForm (Euclid P) n) := ContDiff.continuous hsm
  obtain ⟨C, hC⟩ := hcont.bounded_above_of_compact_support hcs
  refine (Submission.odc_rays_integrableOn R hcs.isCompact hcont.aestronglyMeasurable
    hC).of_forall_sdiff_eq_zero R.measurableSet_carrier ?_
  rintro x ⟨hxM, hx⟩
  rw [image_eq_zero_of_notMem_tsupport fun h => hx ⟨hxM, h⟩, map_zero, mul_zero]

/-- Along the ray map `t ↦ t • e`, the density `θ ξ(β)` (extended by `0` off the carrier) is
locally integrable. -/
theorem Submission.odc_rays_locallyIntegrable {P : ℕ} (R : IMRep (univ : Set (Euclid P)) 1)
    {e : Euclid P} (he : ‖e‖ = 1) (β : Covector (Euclid P) 1) :
    LocallyIntegrable (fun t : ℝ =>
      R.carrier.indicator (fun x => (R.mult x : ℝ) * R.orient x β) (t • e)) := by
  refine locallyIntegrable_iff.2 fun k hk => ?_
  have h := Submission.odc_rays_integrableOn R (hk.image (f := fun t : ℝ => t • e) (by fun_prop))
    (Φ := fun _ => β) aestronglyMeasurable_const (fun _ => le_rfl)
  have h2 : Integrable (R.carrier.indicator (fun x => (R.mult x : ℝ) * R.orient x β))
      ((μHE[1] : Measure (Euclid P)).restrict ((fun t : ℝ => t • e) '' k)) := by
    refine (integrable_indicator_iff R.measurableSet_carrier).2 ?_
    rw [IntegrableOn, Measure.restrict_restrict R.measurableSet_carrier]
    exact h
  rwa [Submission.odc_rays_restrict he k,
    (Submission.odc_rays_measurableEmbedding he).integrable_map_iff] at h2

/-- If `ξ(β) = ±1` a.e. on the carrier along the ray of `e`, the density `θ ξ(β)` is a.e.
integer valued along the ray. -/
theorem Submission.odc_rays_int {P : ℕ} (R : IMRep (univ : Set (Euclid P)) 1)
    {e : Euclid P} (he : ‖e‖ = 1) {β : Covector (Euclid P) 1}
    (hβ : ∀ᵐ x ∂((μHE[1] : Measure (Euclid P)).restrict ((fun t : ℝ => t • e) '' Ioi 0)),
      x ∈ R.carrier → R.orient x β = 1 ∨ R.orient x β = -1) :
    ∀ᵐ t ∂(volume.restrict (Ioi (0 : ℝ))), ∃ k : ℤ,
      R.carrier.indicator (fun x => (R.mult x : ℝ) * R.orient x β) (t • e) = k := by
  rw [Submission.odc_rays_restrict he, (Submission.odc_rays_measurableEmbedding he).ae_map_iff]
    at hβ
  filter_upwards [hβ] with t ht
  by_cases hM : t • e ∈ R.carrier
  · rw [indicator_of_mem hM]
    rcases ht hM with h | h
    · exact ⟨R.mult (t • e), by rw [h, mul_one]; norm_cast⟩
    · exact ⟨-(R.mult (t • e) : ℤ), by rw [h, mul_neg_one]; push_cast; ring⟩
  · exact ⟨0, by rw [indicator_of_notMem hM]; simp⟩

/-- If `ξ(α) = ξ(β) α(e)` a.e. on the carrier along the ray of `e`, the action on that part of
the carrier is an integral along the ray. -/
theorem Submission.odc_rays_integral {P : ℕ} (R : IMRep (univ : Set (Euclid P)) 1)
    {e : Euclid P} (he : ‖e‖ = 1) {β : Covector (Euclid P) 1}
    (hβ : ∀ᵐ x ∂((μHE[1] : Measure (Euclid P)).restrict ((fun t : ℝ => t • e) '' Ioi 0)),
      x ∈ R.carrier → ∀ α : Covector (Euclid P) 1, R.orient x α = R.orient x β * α (fun _ => e))
    (ω : DifferentialForm (Euclid P) 1) :
    ∫ x in R.carrier ∩ (fun t : ℝ => t • e) '' Ioi 0, (R.mult x : ℝ) * R.orient x (ω x)
        ∂μHE[1] =
      ∫ t in Ioi (0 : ℝ),
        R.carrier.indicator (fun x => (R.mult x : ℝ) * R.orient x β) (t • e) *
          ω (t • e) (fun _ => e) := by
  rw [← Measure.restrict_restrict R.measurableSet_carrier,
    ← integral_indicator R.measurableSet_carrier,
    integral_congr_ae (g := fun x => R.carrier.indicator
      (fun x => (R.mult x : ℝ) * R.orient x β) x * ω x (fun _ => e)) ?_,
    Submission.odc_rays_restrict he, (Submission.odc_rays_measurableEmbedding he).integral_map]
  filter_upwards [hβ] with x hx
  by_cases hM : x ∈ R.carrier
  · simp only [indicator_of_mem hM, hx hM (ω x), mul_assoc]
  · simp only [indicator_of_notMem hM, zero_mul]

/-- The action of a `1`-dimensional representation carried by finitely many rays, written with
integer densities `g e` along the rays. -/
theorem Submission.odc_action_rays {P : ℕ} (R : IMRep (univ : Set (Euclid P)) 1)
    (F : Finset (Euclid P)) (hF : ∀ e ∈ F, ‖e‖ = 1)
    (hnull : (μHE[1] : Measure (Euclid P))
      (R.carrier ∩ (⋃ e ∈ F, (fun t : ℝ => t • e) '' Ioi 0)ᶜ) = 0) :
    ∃ g : Euclid P → ℝ → ℝ,
      (∀ e ∈ F, LocallyIntegrableOn (g e) (Ioi 0)) ∧
      (∀ e ∈ F, ∀ᵐ t ∂(volume.restrict (Ioi (0 : ℝ))), ∃ k : ℤ, g e t = k) ∧
      ∀ ω : TestFormOn (univ : Set (Euclid P)) 1,
        R.action (ω : DifferentialForm (Euclid P) 1) =
          ∑ e ∈ F, ∫ t in Ioi (0 : ℝ),
            g e t * (ω : DifferentialForm (Euclid P) 1) (t • e) (fun _ => e) := by
  have hM := R.measurableSet_carrier
  set β : Euclid P → Covector (Euclid P) 1 := fun e =>
    ContinuousAlternatingMap.ofSubsingleton ℝ (Euclid P) ℝ (0 : Fin 1) (innerSL ℝ e)
  -- on the ray of `e ∈ F`, `ξ = ±e` a.e. on the carrier
  have hor : ∀ e ∈ F, ∀ᵐ x ∂((μHE[1] : Measure (Euclid P)).restrict
      ((fun t : ℝ => t • e) '' Ioi 0)), x ∈ R.carrier →
      (R.orient x (β e) = 1 ∨ R.orient x (β e) = -1) ∧
        ∀ α : Covector (Euclid P) 1, R.orient x α = R.orient x (β e) * α (fun _ => e) := by
    intro e he
    have h := Submission.odc_orient_on_ray R F hF hnull e he
    rw [← Measure.restrict_restrict hM, ae_restrict_iff' hM] at h
    filter_upwards [h] with x hx hxM
    exact Submission.odc_rays_orient (hF e he) (hx hxM)
  refine ⟨fun e t => R.carrier.indicator (fun x => (R.mult x : ℝ) * R.orient x (β e)) (t • e),
    fun e he => (Submission.odc_rays_locallyIntegrable R (hF e he) _).locallyIntegrableOn _,
    fun e he => Submission.odc_rays_int R (hF e he) ((hor e he).mono fun x hx hxM => (hx hxM).1),
    fun ω => ?_⟩
  rw [← Finset.sum_congr rfl fun e he => Submission.odc_rays_integral R (hF e he)
    ((hor e he).mono fun x hx hxM => (hx hxM).2) ω]
  -- split the carrier into its parts on the disjoint rays, up to the null set off the rays
  rw [← integral_biUnion_finset F (fun e he => hM.inter
      ((Submission.odc_rays_measurableEmbedding (hF e he)).measurableSet_image.2 measurableSet_Ioi))
    ?_ fun e _ => (Submission.odc_rays_integrableOn_form R ω).mono_set inter_subset_left]
  · refine setIntegral_congr_set (ae_eq_set.2 ⟨measure_mono_null ?_ hnull, ?_⟩)
    · rintro x ⟨hxM, hx⟩
      refine ⟨hxM, fun hx' => hx ?_⟩
      simp only [mem_iUnion] at hx' ⊢
      obtain ⟨e, he, hxe⟩ := hx'
      exact ⟨e, he, hxM, hxe⟩
    · rw [sdiff_eq_empty.2 (iUnion₂_subset fun e _ => inter_subset_left), measure_empty]
  · intro e he e' he' hne
    exact (Submission.odc_rays_disjoint (hF e he) (hF e' he') hne).mono inter_subset_right
      inter_subset_right

/-- Along a unit-speed line, the value of a test `1`-form on a fixed vector is integrable. -/
theorem Submission.odc_antipodal_integrableOn {P : ℕ} (ω : TestFormOn (univ : Set (Euclid P)) 1)
    (p v w : Euclid P) (hv : ‖v‖ = 1) (s : Set ℝ) :
    IntegrableOn (fun t : ℝ => (ω : DifferentialForm (Euclid P) 1) (p + t • v) (fun _ => w)) s := by
  have hω := ω.property.1
  have hγ := (Submission.odc_line_isometry p v hv).isClosedEmbedding
  have hcont : Continuous fun t : ℝ =>
      (ω : DifferentialForm (Euclid P) 1) (p + t • v) (fun _ => w) :=
    (ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (fun _ => w)).continuous.comp
      (hω.1.continuous.comp hγ.continuous)
  have hsupp : HasCompactSupport fun t : ℝ =>
      (ω : DifferentialForm (Euclid P) 1) (p + t • v) (fun _ => w) :=
    (hω.2.comp_isClosedEmbedding hγ).comp_left
      (g := ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (fun _ => w)) (map_zero _)
  exact (hcont.integrable_of_hasCompactSupport hsupp).integrableOn

/-- Splitting a ray integral at `t = 1`. -/
theorem Submission.odc_antipodal_integral_split {P : ℕ} (ω : TestFormOn (univ : Set (Euclid P)) 1)
    {e : Euclid P} (he : ‖e‖ = 1) :
    ∫ t in Ioi (0 : ℝ), (ω : DifferentialForm (Euclid P) 1) (t • e) (fun _ => e) =
      (∫ t in Ioo (0 : ℝ) 1, (ω : DifferentialForm (Euclid P) 1) (t • e) (fun _ => e)) +
        ∫ t in Ioi (1 : ℝ), (ω : DifferentialForm (Euclid P) 1) (t • e) (fun _ => e) := by
  have hint : ∀ s, IntegrableOn
      (fun t : ℝ => (ω : DifferentialForm (Euclid P) 1) (t • e) (fun _ => e)) s := by
    intro s
    simpa using Submission.odc_antipodal_integrableOn ω 0 e e he s
  rw [← Ioc_union_Ioi_eq_Ioi zero_le_one,
    setIntegral_union Ioc_disjoint_Ioi_same measurableSet_Ioi (hint _) (hint _),
    integral_Ioc_eq_integral_Ioo]

/-- Fundamental theorem of calculus for the exterior derivative of a test `0`-form along a
segment. -/
theorem Submission.odc_antipodal_ftc {P : ℕ} (φ : TestFormOn (univ : Set (Euclid P)) 0)
    (p w : Euclid P) {L : ℝ} (hL : 0 ≤ L) :
    ∫ t in Ioo (0 : ℝ) L, ((exteriorDerivativeTestOn (univ : Set (Euclid P)) 0 φ :
        TestFormOn (univ : Set (Euclid P)) 1) : DifferentialForm (Euclid P) 1)
          (p + t • w) (fun _ => w) =
      (φ : DifferentialForm (Euclid P) 0) (p + L • w) ![] -
        (φ : DifferentialForm (Euclid P) 0) p ![] := by
  set f : Euclid P → ℝ := fun y => (φ : DifferentialForm (Euclid P) 0) y ![] with hf_def
  have hφ : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (φ : DifferentialForm (Euclid P) 0) :=
    φ.property.1.1
  have hf : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) f :=
    (ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ ![]).contDiff.comp hφ
  have hd : ∀ y v : Euclid P, ((exteriorDerivativeTestOn (univ : Set (Euclid P)) 0 φ :
      TestFormOn (univ : Set (Euclid P)) 1) : DifferentialForm (Euclid P) 1) y (fun _ => v) =
        fderiv ℝ f y v := by
    intro y v
    change exteriorDerivative (φ : DifferentialForm (Euclid P) 0) y (fun _ => v) = _
    rw [exteriorDerivative_apply (hφ.differentiable (by simp)).differentiableAt,
      Fin.sum_univ_succ]
    simp only [Finset.univ_eq_empty, Finset.sum_empty, add_zero, Fin.val_zero, pow_zero, one_smul,
      hf_def]
    congr
    funext x
    exact congrArg _ (Subsingleton.elim _ _)
  have hderiv : ∀ t : ℝ, HasDerivAt (fun t => f (p + t • w)) (fderiv ℝ f (p + t • w) w) t := by
    intro t
    have hγ : HasDerivAt (fun t : ℝ => p + t • w) w t := by
      simpa using ((hasDerivAt_id t).smul_const w).const_add p
    exact (hf.differentiable (by simp) _).hasFDerivAt.comp_hasDerivAt t hγ
  have hcont : Continuous fun t : ℝ => fderiv ℝ f (p + t • w) w :=
    ((hf.continuous_fderiv (by simp)).comp
      (continuous_const.add (continuous_id.smul continuous_const))).clm_apply continuous_const
  simp_rw [hd]
  rw [← integral_Ioc_eq_integral_Ioo, ← intervalIntegral.integral_of_le hL,
    intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hderiv t)
      (hcont.intervalIntegrable _ _)]
  simp [f]

/-- Subsingletons are `H¹`-null. -/
theorem Submission.odc_antipodal_null_of_subsingleton {P : ℕ} {w : Euclid P} (hw : ‖w‖ = 1)
    {s : Set (Euclid P)} (hs : s.Subsingleton) : (μHE[1] : Measure (Euclid P)) s = 0 := by
  rcases hs.eq_empty_or_singleton with rfl | ⟨x, rfl⟩
  · exact measure_empty
  · have := Submission.odc_line_measure_image x w hw {0}
    rwa [image_singleton, zero_smul, add_zero, Real.volume_singleton] at this

/-- Two points `t e = s e'` of rays of unit vectors, with `t > 0`, coincide parametrically. -/
theorem Submission.odc_antipodal_ray_eq {P : ℕ} {e e' : Euclid P} (he : ‖e‖ = 1)
    (he' : ‖e'‖ = 1) {t s : ℝ} (ht : 0 < t) (hs : 0 ≤ s) (h : t • e = s • e') :
    t = s ∧ e = e' := by
  have hts : t = s := by
    have := congrArg norm h
    rwa [norm_smul, norm_smul, he, he', mul_one, mul_one, Real.norm_of_nonneg ht.le,
      Real.norm_of_nonneg hs] at this
  subst hts
  exact ⟨rfl, smul_right_injective _ ht.ne' h⟩

/-- Two unit vectors `a ≠ ±b` do not lie on a common line through `0`. -/
theorem Submission.odc_antipodal_not_collinear {P : ℕ} {a b e : Euclid P} (ha : ‖a‖ = 1)
    (hb : ‖b‖ = 1) (hab : a ≠ b) (hab' : b ≠ -a) (hae : a ∈ Submodule.span ℝ {e})
    (hbe : b ∈ Submodule.span ℝ {e}) : False := by
  obtain ⟨α, rfl⟩ := Submodule.mem_span_singleton.1 hae
  obtain ⟨β, rfl⟩ := Submodule.mem_span_singleton.1 hbe
  rw [norm_smul, Real.norm_eq_abs] at ha hb
  have he : ‖e‖ ≠ 0 := by
    rintro h
    rw [h, mul_zero] at ha
    exact zero_ne_one ha
  rcases abs_eq_abs.1 (mul_right_cancel₀ he (ha.trans hb.symm)) with h | h
  · exact hab (by rw [h])
  · exact hab' (by rw [h, neg_smul, neg_neg])

/-- The line through `b` and `a = b + ℓ u` meets every line through `0` at most once. -/
theorem Submission.odc_antipodal_line_meet {P : ℕ} {a b u e : Euclid P} {ℓ : ℝ}
    (ha : ‖a‖ = 1) (hb : ‖b‖ = 1) (hab : a ≠ b) (hab' : b ≠ -a) (hbu : b + ℓ • u = a)
    {s₁ s₂ t₁ t₂ : ℝ} (h₁ : b + s₁ • u = t₁ • e) (h₂ : b + s₂ • u = t₂ • e) : s₁ = s₂ := by
  by_contra hs
  have he : ∀ r : ℝ, r • e ∈ Submodule.span ℝ {e} := fun r =>
    Submodule.smul_mem _ r (Submodule.mem_span_singleton_self e)
  have hu : u ∈ Submodule.span ℝ {e} := by
    have h : (s₁ - s₂) • u = (t₁ - t₂) • e := by
      rw [sub_smul, sub_smul, ← h₁, ← h₂]; abel
    exact (Submodule.smul_mem_iff _ (sub_ne_zero.2 hs)).1 (h ▸ he _)
  have hb' : b ∈ Submodule.span ℝ {e} := by
    have h : b = t₁ • e - s₁ • u := by rw [← h₁]; abel
    rw [h]
    exact sub_mem (he _) (Submodule.smul_mem _ _ hu)
  exact Submission.odc_antipodal_not_collinear ha hb hab hab'
    (hbu ▸ add_mem hb' (Submodule.smul_mem _ _ hu)) hb'

/-- Two pieces of rays from `0` of unit vectors, parametrized by `A ⊆ (0, ∞)` and `B ⊆ [0, ∞)`,
meet at most once, and not at all if the directions agree and `A`, `B` are disjoint. -/
theorem Submission.odc_antipodal_ray_inter {P : ℕ} {e e' : Euclid P} (he : ‖e‖ = 1)
    (he' : ‖e'‖ = 1) {A B : Set ℝ} (hA : A ⊆ Ioi 0) (hB : B ⊆ Ici 0)
    (h : e = e' → Disjoint A B) :
    ((fun t : ℝ => (0 : Euclid P) + t • e) '' A ∩
      (fun t : ℝ => (0 : Euclid P) + t • e') '' B).Subsingleton := by
  rintro _ ⟨⟨t, ht, rfl⟩, ⟨s, hs, hst⟩⟩
  simp only [zero_add] at hst
  obtain ⟨rfl, rfl⟩ := Submission.odc_antipodal_ray_eq he he' (hA ht) (hB hs) hst.symm
  exact (Set.disjoint_left.1 (h rfl) ht hs).elim

/-- The chord meets a line through `0` at most once. -/
theorem Submission.odc_antipodal_chord_inter {P : ℕ} {b u e : Euclid P}
    (hline : ∀ s₁ s₂ t₁ t₂ : ℝ, b + s₁ • u = t₁ • e → b + s₂ • u = t₂ • e → s₁ = s₂)
    (A B : Set ℝ) :
    ((fun s : ℝ => b + s • u) '' A ∩ (fun t : ℝ => (0 : Euclid P) + t • e) '' B).Subsingleton := by
  rintro _ ⟨⟨s₁, -, rfl⟩, ⟨t₁, -, h₁⟩⟩ _ ⟨⟨s₂, -, rfl⟩, ⟨t₂, -, h₂⟩⟩
  simp only [zero_add] at h₁ h₂
  obtain rfl := hline s₁ s₂ t₁ t₂ h₁.symm h₂.symm
  rfl

/-- `∑ |fᵢ| ℒ¹(x, y) = (∑ |fᵢ|)(y - x)`. -/
theorem Submission.odc_antipodal_sum_volume {α : Type*} (s : Finset α) (f : α → ℝ) (x y : ℝ) :
    ∑ i ∈ s, ENNReal.ofReal |f i| * volume (Ioo x y) =
      ENNReal.ofReal ((∑ i ∈ s, |f i|) * (y - x)) := by
  rw [Real.volume_Ioo, ← Finset.sum_mul,
    ← ENNReal.ofReal_sum_of_nonneg fun i _ => abs_nonneg (f i),
    ← ENNReal.ofReal_mul (Finset.sum_nonneg fun i _ => abs_nonneg (f i))]

/-- Mass of a weighted ray current in `B₂(0)`. -/
theorem Submission.odc_antipodal_mass_rays {P : ℕ}
    (C : GeometricCurrentOn (univ : Set (Euclid P)) 1)
    (F : Finset (Euclid P)) (hF : ∀ e ∈ F, ‖e‖ = 1) (m : Euclid P → ℤ)
    (hC : ∀ ω : TestFormOn (univ : Set (Euclid P)) 1,
      C ω = ∑ e ∈ F, (m e : ℝ) * ∫ t in Ioi (0 : ℝ),
        (ω : DifferentialForm (Euclid P) 1) (t • e) (fun _ => e)) :
    ENNReal.ofReal ((∑ e ∈ F, |(m e : ℝ)|) * 2) ≤ C.massOn (ball 0 2) := by
  obtain ⟨R, hR, hRm⟩ := Submission.odc_ray_current_imrep C F hF m hC
  rw [(Submission.dimred_im_mass_measure P 1 univ C R isOpen_univ hR).1 _ isOpen_ball
      (subset_univ _), hRm _ measurableSet_ball]
  calc ENNReal.ofReal ((∑ e ∈ F, |(m e : ℝ)|) * 2)
      = ∑ e ∈ F, ENNReal.ofReal |(m e : ℝ)| * volume (Ioo (0 : ℝ) 2) := by
        rw [Submission.odc_antipodal_sum_volume, sub_zero]
    _ ≤ _ := by
        refine Finset.sum_le_sum fun e he => mul_le_mul_right (measure_mono ?_) _
        intro t ht
        refine ⟨ht.1, ?_⟩
        rw [mem_preimage, mem_ball, dist_zero_right, norm_smul, hF e he, mul_one,
          Real.norm_of_nonneg ht.1.le]
        exact ht.2

/-- The competitor: weighted outer rays `(1, ∞) e`, inner segments `(0, 1) e` (`e ∈ F`) and a chord
`b + s u`, `0 < s < ℓ`, form an integer multiplicity current whose mass in `B₂(0)` is at most
`∑ |mo e| + ∑ |mi e| + ℓ`. -/
theorem Submission.odc_antipodal_competitor {P : ℕ} (F : Finset (Euclid P))
    (hF : ∀ e ∈ F, ‖e‖ = 1) (mo mi : Euclid P → ℤ) (b u : Euclid P) {ℓ : ℝ} (hℓ : 0 ≤ ℓ)
    (hu : ‖u‖ = 1)
    (hline : ∀ e : Euclid P, ∀ s₁ s₂ t₁ t₂ : ℝ,
      b + s₁ • u = t₁ • e → b + s₂ • u = t₂ • e → s₁ = s₂) :
    ∃ X : GeometricCurrentOn (univ : Set (Euclid P)) 1, IsIntegerMultiplicity X ∧
      (∀ ω : TestFormOn (univ : Set (Euclid P)) 1,
        X ω = ∑ e ∈ F, (mo e : ℝ) * (∫ t in Ioi (1 : ℝ),
            (ω : DifferentialForm (Euclid P) 1) (t • e) (fun _ => e)) +
          ∑ e ∈ F, (mi e : ℝ) * (∫ t in Ioo (0 : ℝ) 1,
            (ω : DifferentialForm (Euclid P) 1) (t • e) (fun _ => e)) +
          ∫ s in Ioo (0 : ℝ) ℓ, (ω : DifferentialForm (Euclid P) 1) (b + s • u) (fun _ => u)) ∧
      X.massOn (ball 0 2) ≤
        ENNReal.ofReal (∑ e ∈ F, |(mo e : ℝ)| + ∑ e ∈ F, |(mi e : ℝ)| + ℓ) := by
  classical
  set p : ↥F ⊕ ↥F ⊕ Unit → Euclid P :=
    Sum.elim (fun _ => 0) (Sum.elim (fun _ => 0) fun _ => b) with hp
  set v : ↥F ⊕ ↥F ⊕ Unit → Euclid P :=
    Sum.elim (fun e => (e : Euclid P)) (Sum.elim (fun e => (e : Euclid P)) fun _ => u) with hv'
  set I : ↥F ⊕ ↥F ⊕ Unit → Set ℝ :=
    Sum.elim (fun _ => Ioi 1) (Sum.elim (fun _ => Ioo 0 1) fun _ => Ioo 0 ℓ) with hI
  set c : ↥F ⊕ ↥F ⊕ Unit → ℤ := Sum.elim (fun e => mo e) (Sum.elim (fun e => mi e) fun _ => 1)
    with hc
  have hv : ∀ k, ‖v k‖ = 1 := by
    rintro (e | e | _)
    exacts [hF e e.2, hF e e.2, hu]
  have hIo : ∀ k, IsOpen (I k) := by
    rintro (e | e | _)
    exacts [isOpen_Ioi, isOpen_Ioo, isOpen_Ioo]
  have hdisj : ∀ j k, j ≠ k → (μHE[1] : Measure (Euclid P))
      (((fun t : ℝ => p j + t • v j) '' I j) ∩
        closure ((fun t : ℝ => p k + t • v k) '' I k)) = 0 := by
    intro j k hjk
    rw [(Submission.odc_line_isometry (p k) (v k) (hv k)).isClosedEmbedding.closure_image_eq]
    apply Submission.odc_antipodal_null_of_subsingleton hu
    have hA₁ : Ioi (1 : ℝ) ⊆ Ioi 0 := Ioi_subset_Ioi zero_le_one
    have hA₂ : Ioo (0 : ℝ) 1 ⊆ Ioi 0 := Ioo_subset_Ioi_self
    have hB₁ : closure (Ioi (1 : ℝ)) ⊆ Ici 0 := by
      rw [closure_Ioi]; exact Ici_subset_Ici.2 zero_le_one
    have hB₂ : closure (Ioo (0 : ℝ) 1) ⊆ Ici 0 := by
      rw [closure_Ioo zero_ne_one]; exact Icc_subset_Ici_self
    have hd₁ : Disjoint (Ioi (1 : ℝ)) (closure (Ioo 0 1)) := by
      rw [closure_Ioo zero_ne_one]
      exact Set.disjoint_left.2 fun t ht ht' => absurd ht'.2 (not_le.2 ht)
    have hd₂ : Disjoint (Ioo (0 : ℝ) 1) (closure (Ioi 1)) := by
      rw [closure_Ioi]
      exact Set.disjoint_left.2 fun t ht ht' => absurd ht.2 (not_lt.2 ht')
    have hne : ∀ e e' : ↥F, (e : Euclid P) = e' → e = e' := fun e e' h => Subtype.ext h
    rcases j with e | e | _ <;> rcases k with e' | e' | _
    · exact Submission.odc_antipodal_ray_inter (hF e e.2) (hF e' e'.2) hA₁ hB₁
        fun h => absurd (congrArg Sum.inl (hne e e' h)) hjk
    · exact Submission.odc_antipodal_ray_inter (hF e e.2) (hF e' e'.2) hA₁ hB₂ fun _ => hd₁
    · rw [inter_comm]
      exact Submission.odc_antipodal_chord_inter (hline e) _ _
    · exact Submission.odc_antipodal_ray_inter (hF e e.2) (hF e' e'.2) hA₂ hB₁ fun _ => hd₂
    · exact Submission.odc_antipodal_ray_inter (hF e e.2) (hF e' e'.2) hA₂ hB₂
        fun h => absurd (congrArg (Sum.inr ∘ Sum.inl) (hne e e' h)) hjk
    · rw [inter_comm]
      exact Submission.odc_antipodal_chord_inter (hline e) _ _
    · exact Submission.odc_antipodal_chord_inter (hline e') _ _
    · exact Submission.odc_antipodal_chord_inter (hline e') _ _
    · exact absurd rfl hjk
  obtain ⟨X, hX⟩ := Submission.odc_polygonal_current p v I (fun k => (c k : ℝ)) hv
  obtain ⟨R, hRa, hRm⟩ := Submission.odc_polygonal_imrep p v I c hv hIo hdisj
  have hR : R.Represents X := fun ω => (hX ω).trans (hRa ω).symm
  refine ⟨X, ⟨R, hR⟩, fun ω => ?_, ?_⟩
  · rw [hX ω]
    simp only [Fintype.sum_sum_type, hp, hv', hI, hc, Sum.elim_inl, Sum.elim_inr, zero_add,
      Fintype.sum_unique, Int.cast_one, one_mul, add_assoc]
    rw [← Finset.sum_coe_sort F, ← Finset.sum_coe_sort F]
  · rw [(Submission.dimred_im_mass_measure P 1 univ X R isOpen_univ hR).1 _ isOpen_ball
        (subset_univ _), hRm _ measurableSet_ball]
    calc ∑ k, ENNReal.ofReal |(c k : ℝ)| *
          volume (I k ∩ (fun t : ℝ => p k + t • v k) ⁻¹' ball 0 2)
        ≤ ∑ k, ENNReal.ofReal |(c k : ℝ)| *
          volume ((Sum.elim (fun _ => Ioo (1 : ℝ) 2) (Sum.elim (fun _ => Ioo (0 : ℝ) 1)
            fun _ => Ioo (0 : ℝ) ℓ) : ↥F ⊕ ↥F ⊕ Unit → Set ℝ) k) := by
          refine Finset.sum_le_sum fun k _ => mul_le_mul_right (measure_mono ?_) _
          rcases k with e | e | _
          · rintro t ⟨ht₁, ht₂⟩
            simp only [hp, hv', hI, Sum.elim_inl, mem_preimage, mem_ball, dist_zero_right,
              zero_add, norm_smul, hF e e.2, mul_one, Real.norm_eq_abs, mem_Ioi] at ht₁ ht₂
            exact ⟨ht₁, (le_abs_self t).trans_lt ht₂⟩
          · exact inter_subset_left
          · exact inter_subset_left
      _ = ∑ e ∈ F, ENNReal.ofReal |(mo e : ℝ)| * volume (Ioo (1 : ℝ) 2) +
            (∑ e ∈ F, ENNReal.ofReal |(mi e : ℝ)| * volume (Ioo (0 : ℝ) 1) +
              volume (Ioo (0 : ℝ) ℓ)) := by
          simp only [Fintype.sum_sum_type, hc, Sum.elim_inl, Sum.elim_inr, Fintype.sum_unique,
            Int.cast_one, abs_one, ENNReal.ofReal_one, one_mul]
          rw [← Finset.sum_coe_sort F, ← Finset.sum_coe_sort F]
      _ = ENNReal.ofReal (∑ e ∈ F, |(mo e : ℝ)| + ∑ e ∈ F, |(mi e : ℝ)| + ℓ) := by
          have h₁ : 0 ≤ ∑ e ∈ F, |(mo e : ℝ)| := Finset.sum_nonneg fun _ _ => abs_nonneg _
          have h₂ : 0 ≤ ∑ e ∈ F, |(mi e : ℝ)| := Finset.sum_nonneg fun _ _ => abs_nonneg _
          rw [Submission.odc_antipodal_sum_volume, Submission.odc_antipodal_sum_volume,
            Real.volume_Ioo, ENNReal.ofReal_add (add_nonneg h₁ h₂) hℓ, ENNReal.ofReal_add h₁ h₂]
          norm_num [add_assoc]

/-- In a minimizing `1`-current made of weighted rays, every ray of positive multiplicity is
antipodal to every ray of negative multiplicity. -/
theorem Submission.odc_antipodal {P : ℕ} (C : GeometricCurrentOn (univ : Set (Euclid P)) 1)
    (hmin : IsMinimizingIn C univ) (F : Finset (Euclid P)) (hF : ∀ e ∈ F, ‖e‖ = 1)
    (m : Euclid P → ℤ)
    (hC : ∀ ω : TestFormOn (univ : Set (Euclid P)) 1,
      C ω = ∑ e ∈ F, (m e : ℝ) * ∫ t in Ioi (0 : ℝ),
        (ω : DifferentialForm (Euclid P) 1) (t • e) (fun _ => e))
    (a b : Euclid P) (ha : a ∈ F) (hb : b ∈ F) (hma : 0 < m a) (hmb : m b < 0) :
    b = -a := by
  classical
  by_contra hne
  have ha₁ := hF a ha
  have hb₁ := hF b hb
  have hab : a ≠ b := by
    rintro rfl
    exact lt_asymm hma hmb
  -- the chord `s ↦ b + s u`, `0 ≤ s ≤ ℓ`, from `b` to `a`
  set ℓ : ℝ := ‖a - b‖ with hℓ_def
  have hℓ : 0 < ℓ := norm_pos_iff.2 (sub_ne_zero.2 hab)
  set u : Euclid P := ℓ⁻¹ • (a - b) with hu_def
  have hu : ‖u‖ = 1 := by
    rw [hu_def, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hℓ.ne']
  have hbu : b + ℓ • u = a := by
    rw [hu_def, smul_smul, mul_inv_cancel₀ hℓ.ne', one_smul, add_sub_cancel]
  have hseg : ∀ s ∈ Icc (0 : ℝ) ℓ, ‖b + s • u‖ ≤ 1 := by
    intro s hs
    have h₀ : 0 ≤ s / ℓ := div_nonneg hs.1 hℓ.le
    have h₁ : s / ℓ ≤ 1 := (div_le_one hℓ).2 hs.2
    have h : b + s • u = (1 - s / ℓ) • b + (s / ℓ) • a := by
      rw [hu_def]
      module
    rw [h]
    calc ‖(1 - s / ℓ) • b + (s / ℓ) • a‖ ≤ ‖(1 - s / ℓ) • b‖ + ‖(s / ℓ) • a‖ := norm_add_le _ _
      _ = 1 := by
        rw [norm_smul, norm_smul, ha₁, hb₁, Real.norm_of_nonneg (by linarith),
          Real.norm_of_nonneg h₀]
        ring
  -- the competitor `X`: one unit of multiplicity of `[0, a]` and `[0, b]` moves to the chord
  set mi : Euclid P → ℤ := fun e => m e - (if e = a then 1 else 0) + (if e = b then 1 else 0)
    with hmi
  obtain ⟨X, hXIM, hXω, hXm⟩ := Submission.odc_antipodal_competitor F hF m mi b u hℓ.le hu
    fun e s₁ s₂ t₁ t₂ h₁ h₂ => Submission.odc_antipodal_line_meet ha₁ hb₁ hab hne hbu h₁ h₂
  -- `X - C = [[b, a]] - [[0, a]] + [[0, b]]`
  have hdiff : ∀ ω : TestFormOn (univ : Set (Euclid P)) 1, X ω - C ω =
      -(∫ t in Ioo (0 : ℝ) 1, (ω : DifferentialForm (Euclid P) 1) (t • a) (fun _ => a)) +
        (∫ t in Ioo (0 : ℝ) 1, (ω : DifferentialForm (Euclid P) 1) (t • b) (fun _ => b)) +
        ∫ s in Ioo (0 : ℝ) ℓ, (ω : DifferentialForm (Euclid P) 1) (b + s • u) (fun _ => u) := by
    intro ω
    have hsplit : C ω = ∑ e ∈ F, (m e : ℝ) * (∫ t in Ioo (0 : ℝ) 1,
          (ω : DifferentialForm (Euclid P) 1) (t • e) (fun _ => e)) +
        ∑ e ∈ F, (m e : ℝ) * ∫ t in Ioi (1 : ℝ),
          (ω : DifferentialForm (Euclid P) 1) (t • e) (fun _ => e) := by
      rw [hC ω, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun e he => by
        rw [Submission.odc_antipodal_integral_split ω (hF e he), mul_add]
    rw [hXω ω, hsplit]
    simp only [hmi, Int.cast_add, Int.cast_sub, Int.cast_ite, Int.cast_one, Int.cast_zero,
      add_mul, sub_mul, ite_mul, one_mul, zero_mul, Finset.sum_add_distrib,
      Finset.sum_sub_distrib, Finset.sum_ite_eq', ite_eq_left ha, ite_eq_left hb]
    ring
  -- `∂X = ∂C`
  have hbd : SameBoundary X C := by
    show X.boundary = C.boundary
    ext φ
    rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.boundary_apply, ← sub_eq_zero,
      hdiff]
    have h₁ := Submission.odc_antipodal_ftc φ 0 a zero_le_one
    have h₂ := Submission.odc_antipodal_ftc φ 0 b zero_le_one
    simp only [zero_add, one_smul] at h₁ h₂
    rw [h₁, h₂, Submission.odc_antipodal_ftc φ b u hℓ.le, hbu]
    ring
  -- `spt (X - C) ⊆ B̄₁(0)`
  have hvan : ∀ ω : TestFormOn (univ : Set (Euclid P)) 1,
      (∀ y : Euclid P, ‖y‖ ≤ 1 → (ω : DifferentialForm (Euclid P) 1) y = 0) →
        X ω - C ω = 0 := by
    intro ω hω
    have h₀ : ∀ w y : Euclid P, ‖y‖ ≤ 1 →
        (ω : DifferentialForm (Euclid P) 1) y (fun _ => w) = 0 :=
      fun w y hy => by rw [hω y hy, ContinuousAlternatingMap.coe_zero, Pi.zero_apply]
    have hray : ∀ e : Euclid P, ‖e‖ = 1 →
        ∫ t in Ioo (0 : ℝ) 1, (ω : DifferentialForm (Euclid P) 1) (t • e) (fun _ => e) = 0 :=
      fun e he => setIntegral_eq_zero_of_forall_eq_zero fun t ht => h₀ e _ (by
        rw [norm_smul, he, mul_one, Real.norm_of_nonneg ht.1.le]
        exact ht.2.le)
    rw [hdiff ω, hray a ha₁, hray b hb₁, setIntegral_eq_zero_of_forall_eq_zero fun s hs =>
      h₀ u _ (hseg s (Ioo_subset_Icc_self hs))]
    ring
  have hsupp : (X - C).support ⊆ closedBall 0 1 := by
    intro x hx
    rw [mem_closedBall, dist_zero_right]
    by_contra hx₁
    rw [not_le] at hx₁
    refine hx.2 (mem_sUnion.2 ⟨ball x ((‖x‖ - 1) / 2), ?_, mem_ball_self (by linarith)⟩)
    refine ⟨isOpen_ball, isBounded_ball.isCompact_closure, subset_univ _, fun ω hω =>
      hvan ω fun y hy => image_eq_zero_of_notMem_tsupport fun hy' => ?_⟩
    have h₁ := hω hy'
    rw [mem_ball, dist_eq_norm] at h₁
    have h₂ := norm_sub_norm_le x y
    rw [norm_sub_rev] at h₂
    linarith
  have hcpt : IsCompact (X - C).support := by
    refine (isCompact_closedBall 0 1).of_isClosed_subset ?_ hsupp
    rw [GeometricCurrentOn.support, ← compl_eq_univ_sdiff]
    exact (X - C).isOpen_zeroRegion.isClosed_compl
  -- minimality in `B₂(0)`: `2 ∑ |m e| ≤ ∑ |m e| + ∑ |mi e| + ℓ`
  have hle := hmin.2 (ball 0 2) X isOpen_ball ⟨isBounded_ball.isCompact_closure, subset_univ _⟩
    hXIM hbd hcpt
    (subset_inter (subset_univ _) (hsupp.trans (closedBall_subset_ball (by norm_num))))
  have key := (ENNReal.ofReal_le_ofReal_iff (add_nonneg (add_nonneg
    (Finset.sum_nonneg fun _ _ => abs_nonneg _) (Finset.sum_nonneg fun _ _ => abs_nonneg _))
      hℓ.le)).1 ((Submission.odc_antipodal_mass_rays C F hF m hC).trans (hle.trans hXm))
  -- `∑ |mi e| = ∑ |m e| - 2`
  have hma' : (1 : ℝ) ≤ m a := by exact_mod_cast hma
  have hmb' : (m b : ℝ) ≤ -1 := by exact_mod_cast (show m b ≤ -1 by omega)
  have habs : ∀ e, |(mi e : ℝ)| =
      |(m e : ℝ)| - (if e = a then 1 else 0) - (if e = b then 1 else 0) := by
    intro e
    by_cases hea : e = a
    · rw [hea]
      simp only [hmi, ite_true, ite_eq_right hab]
      push_cast
      rw [abs_of_nonneg (by linarith), abs_of_pos (by linarith)]
      ring
    · by_cases heb : e = b
      · rw [heb]
        simp only [hmi, ite_true, ite_eq_right hab.symm]
        push_cast
        rw [abs_of_nonpos (by linarith), abs_of_neg (by linarith)]
        ring
      · simp only [hmi, ite_eq_right hea, ite_eq_right heb, sub_zero, add_zero]
  have hsum : ∑ e ∈ F, |(mi e : ℝ)| = ∑ e ∈ F, |(m e : ℝ)| - 2 := by
    rw [Finset.sum_congr rfl fun e _ => habs e, Finset.sum_sub_distrib, Finset.sum_sub_distrib,
      Finset.sum_ite_eq', Finset.sum_ite_eq', ite_eq_left ha, ite_eq_left hb]
    ring
  rw [hsum] at key
  -- hence `‖a - b‖ ≥ 2`, and `b = -a` by the parallelogram law
  have hℓ₂ : 2 ≤ ℓ := by linarith
  have hpar := parallelogram_law_with_norm ℝ a b
  rw [ha₁, hb₁, ← hℓ_def] at hpar
  have h₀ : ‖a + b‖ ^ 2 ≤ 0 := by nlinarith
  exact hne (eq_neg_of_add_eq_zero_right
    (norm_eq_zero.1 ((pow_eq_zero_iff two_ne_zero).1 (le_antisymm h₀ (sq_nonneg _)))))

/-- A current vanishing on all test forms has zero local mass. -/
theorem Submission.odc_conclusion_massOn_eq_zero {P n : ℕ} {U : Set (Euclid P)}
    (C : GeometricCurrentOn U n) (h : ∀ ω : TestFormOn U n, C ω = 0) (W : Set (Euclid P)) :
    C.massOn W = 0 := by
  refine le_antisymm (sSup_le ?_) zero_le
  rintro _ ⟨ω, -, rfl⟩
  simp [h ω]

/-- The two half-lines of `ℝ` cut out of an interval centred at `±s` have total length `2ρ`. -/
theorem Submission.odc_conclusion_volume_halves (s ρ : ℝ) :
    volume (Ioi (0 : ℝ) ∩ ball s ρ) + volume (Ioi (0 : ℝ) ∩ ball (-s) ρ) =
      ENNReal.ofReal (2 * ρ) := by
  have h1 : Ioi (0 : ℝ) ∩ ball (-s) ρ = Neg.neg ⁻¹' (Iic 0 ∩ ball s ρ) \ {0} := by
    ext t
    simp only [mem_inter_iff, mem_Ioi, mem_ball, Real.dist_eq, Set.mem_sdiff, mem_preimage, mem_Iic,
      mem_singleton_iff]
    constructor
    · rintro ⟨ht, hts⟩
      refine ⟨⟨by linarith, ?_⟩, ht.ne'⟩
      rwa [show -t - s = -(t - -s) by ring, abs_neg]
    · rintro ⟨⟨ht, hts⟩, ht0⟩
      refine ⟨lt_of_le_of_ne (by linarith) (Ne.symm ht0), ?_⟩
      rwa [show -t - s = -(t - -s) by ring, abs_neg] at hts
  rw [h1, measure_sdiff_null (measure_singleton 0), Measure.measure_preimage_neg, inter_comm,
    inter_comm (Iic 0), ← compl_Ioi, ← Set.sdiff_eq, measure_inter_add_sdiff _ measurableSet_Ioi,
    Real.volume_ball]

/-- The zero current satisfies the conclusion with `e = 0`, `m = 0`. -/
theorem Submission.odc_zero_current_conclusion {P : ℕ}
    (C : GeometricCurrentOn (univ : Set (Euclid P)) 1)
    (h : ∀ ω : TestFormOn (univ : Set (Euclid P)) 1, C ω = 0) :
    ∃ (e : Euclid P) (m : ℕ), (0 < m → ‖e‖ = 1) ∧
      C.support ⊆ (Submodule.span ℝ {e} : Set (Euclid P)) ∧
      ∀ y ∈ Submodule.span ℝ {e}, HasMassDensity C y m := by
  refine ⟨0, 0, fun h0 => absurd h0 (lt_irrefl 0), fun x hx => absurd ?_ hx.2,
    fun y _ => ⟨Nat.cast_nonneg _, ?_⟩⟩
  · exact mem_sUnion.2 ⟨ball x 1, ⟨isOpen_ball, isBounded_ball.isCompact_closure, subset_univ _,
      fun ω _ => h ω⟩, mem_ball_self one_pos⟩
  · simp only [Submission.odc_conclusion_massOn_eq_zero C h, ENNReal.zero_div, Nat.cast_zero,
      ENNReal.ofReal_zero]
    exact tendsto_const_nhds

/-- A multiplicity-`k` oriented line `k[[ℝa]] = k[[ray a]] - k[[ray(-a)]]` is supported in `ℝa` and
has density `k` at every point of `ℝa`. -/
theorem Submission.odc_line_conclusion {P : ℕ} (C : GeometricCurrentOn (univ : Set (Euclid P)) 1)
    (F : Finset (Euclid P)) (hF : ∀ e ∈ F, ‖e‖ = 1) (m : Euclid P → ℤ)
    (hC : ∀ ω : TestFormOn (univ : Set (Euclid P)) 1,
      C ω = ∑ e ∈ F, (m e : ℝ) * ∫ t in Ioi (0 : ℝ),
        (ω : DifferentialForm (Euclid P) 1) (t • e) (fun _ => e))
    (a : Euclid P) (ha : a ∈ F) (hna : -a ∈ F)
    (hsupp : ∀ e ∈ F, m e ≠ 0 → e = a ∨ e = -a) (k : ℕ) (hk : m a = k) (hk' : m (-a) = -k) :
    C.support ⊆ (Submodule.span ℝ {a} : Set (Euclid P)) ∧
      ∀ y ∈ Submodule.span ℝ {a}, HasMassDensity C y k := by
  obtain ⟨R, hR, hRm⟩ := Submission.odc_ray_current_imrep C F hF m hC
  obtain ⟨hmass, hspt, -⟩ := Submission.dimred_im_mass_measure P 1 univ C R isOpen_univ hR
  have ha1 : ‖a‖ = 1 := hF a ha
  refine ⟨fun x hx => ?_, fun y hy => ?_⟩
  · by_contra hxa
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1
      (Submodule.closed_of_finiteDimensional (Submodule.span ℝ {a})).isOpen_compl x hxa
    refine (hspt x (mem_univ x)).1 hx ε hε ?_
    rw [hRm _ measurableSet_ball]
    refine Finset.sum_eq_zero fun e he => ?_
    by_cases hme : m e = 0
    · simp [hme]
    · have : (fun t : ℝ => t • e) ⁻¹' ball x ε = ∅ := by
        refine eq_empty_of_forall_notMem fun t ht => hball ht ?_
        rcases hsupp e he hme with rfl | rfl
        · exact Submodule.smul_mem _ t (Submodule.mem_span_singleton_self _)
        · exact Submodule.smul_mem _ t (Submodule.neg_mem _ (Submodule.mem_span_singleton_self _))
      simp [this]
  · obtain ⟨s, rfl⟩ := Submodule.mem_span_singleton.1 hy
    have hne : a ≠ -a := fun h => by
      have h2 : (2 : ℝ) • a = 0 := by rw [two_smul]; exact eq_neg_iff_add_eq_zero.1 h
      rcases smul_eq_zero.1 h2 with h2 | h2
      · norm_num at h2
      · simp [h2] at ha1
    have key : ∀ ρ : ℝ, C.massOn (ball (s • a) ρ) = k * ENNReal.ofReal (2 * ρ) := by
      intro ρ
      have h1 : (fun t : ℝ => t • a) ⁻¹' ball (s • a) ρ = ball s ρ := by
        ext t
        simp [dist_eq_norm, ← sub_smul, norm_smul, ha1]
      have h2 : (fun t : ℝ => t • -a) ⁻¹' ball (s • a) ρ = ball (-s) ρ := by
        ext t
        rw [mem_preimage, mem_ball, mem_ball, dist_eq_norm, smul_neg, ← neg_add', ← add_smul,
          norm_neg, norm_smul, ha1, mul_one, Real.dist_eq, sub_neg_eq_add, Real.norm_eq_abs]
      have hk1 : ENNReal.ofReal |((m a : ℤ) : ℝ)| = k := by simp [hk]
      have hk2 : ENNReal.ofReal |((m (-a) : ℤ) : ℝ)| = k := by simp [hk']
      rw [hmass _ isOpen_ball (subset_univ _), hRm _ measurableSet_ball,
        Finset.sum_eq_add_of_mem a (-a) ha hna hne, h1, h2, hk1, hk2, ← mul_add,
        Submission.odc_conclusion_volume_halves]
      intro c hc hca
      simp [show m c = 0 from by_contra fun hmc => (hsupp c hc hmc).elim hca.1 hca.2]
    refine ⟨Nat.cast_nonneg k, (tendsto_congr' ?_).2 tendsto_const_nhds⟩
    filter_upwards [self_mem_nhdsWithin] with ρ (hρ : 0 < ρ)
    rw [key ρ, Submission.odc_unitBallVolume_one, pow_one, ENNReal.ofReal_mul zero_le_two,
      ENNReal.ofReal_ofNat, ENNReal.mul_div_cancel_right, ENNReal.ofReal_natCast]
    · simp [hρ]
    · simp [ENNReal.mul_eq_top]

/-- **Simon 7.3.3(2), formula (10)**: a `1`-dimensional minimizing cone `C` in `ℝᴾ` with
`∂C = 0` is `m[[ℝe]]` for a unit vector `e` (or `C = 0`, `m = 0`); in particular
`spt C ⊆ ℝe` and `Θ¹(μ_C, y) = m` for every `y ∈ ℝe`.
Steps: `μ_C` is `1`-homogeneous with density `≥ 1` on `spt C` (monotonicity), so it lives on
finitely many rays; constancy along the rays gives `C = ∑ mₑ[[ray e]]` with `∑ mₑ = 0`;
rerouting one unit of multiplicity of a positive and of a negative ray through the chord between
them shows by minimality that the two rays are antipodal. -/
theorem Submission.dimred_one_dim_minimizing_cone : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 1), IsMinimizingIn C univ → BoundaryVanishes C → IsConeCurrent C → ∃ (e : Euclid P) (m : ℕ), (0 < m → ‖e‖ = 1) ∧ C.support ⊆ (Submodule.span ℝ {e} : Set (Euclid P)) ∧ ∀ y ∈ Submodule.span ℝ {e}, HasMassDensity C y m := by
  intro P C hmin hbdry hcone
  -- `P = 0`: every `1`-current on `ℝ⁰` vanishes
  rcases Nat.eq_zero_or_pos P with rfl | hP
  · exact Submission.odc_zero_current_conclusion C (Submission.odc_dim_zero_vanish C)
  -- the mass measure `μ = μ_C` of a representation `R` of `C`
  obtain ⟨R, hR⟩ := hmin.1
  have hmass := (Submission.dimred_im_mass_measure P 1 univ C R isOpen_univ hR).1
  -- `μ(λW) = λμ(W)` for open `W` (cone property)
  have hscale : ∀ lam : ℝ, 0 < lam → ∀ W : Set (Euclid P), IsOpen W →
      R.measure ((fun x => lam • x) '' W) = ENNReal.ofReal lam * R.measure W := by
    intro lam hlam W hW
    have hW' : IsOpen ((fun x => lam • x) '' W) := isOpenMap_smul₀ hlam.ne' W hW
    rw [← hmass _ hW' (subset_univ _), ← hmass W hW (subset_univ _)]
    exact Submission.odc_cone_massOn_smul C hcone lam hlam W
  -- `μ` lives on finitely many rays
  obtain ⟨F, hF, hZ⟩ := Submission.odc_finite_rays R.measure
    (Submission.odc_imrep_measure_compact_ne_top R) hscale
    (Submission.odc_density_lower hP C hmin hbdry R hR)
  have hrays : MeasurableSet (⋃ e ∈ F, (fun t : ℝ => t • e) '' Ioi 0) := by
    refine Finset.measurableSet_biUnion F fun e he => ?_
    simpa only [zero_add] using
      Submission.odc_line_measurableSet_image 0 e (hF e he) measurableSet_Ioi
  have hnull := Submission.odc_carrier_inter_null R _ hrays.compl hZ
  -- constant integer multiplicities `m e` along the rays, with `∑ m e = 0`
  obtain ⟨g, hgi, hgZ, hrep⟩ := Submission.odc_action_rays R F hF hnull
  obtain ⟨m, hsum, hCm⟩ := Submission.odc_ray_constancy C hbdry F hF g hgi hgZ
    fun ω => (hR ω).trans (hrep ω)
  by_cases hzero : ∀ e ∈ F, m e = 0
  · refine Submission.odc_zero_current_conclusion C fun ω => ?_
    rw [hCm ω]
    exact Finset.sum_eq_zero fun e he => by simp [hzero e he]
  simp only [not_forall] at hzero
  obtain ⟨e₀, he₀, hme₀⟩ := hzero
  -- there are rays of positive and of negative multiplicity
  have hpos : ∃ a ∈ F, 0 < m a := by
    by_contra! h
    have h₀ : 0 < -m e₀ := by have := h e₀ he₀; omega
    have : 0 < ∑ e ∈ F, -m e :=
      Finset.sum_pos' (fun e he => by have := h e he; omega) ⟨e₀, he₀, h₀⟩
    rw [Finset.sum_neg_distrib, hsum] at this
    exact lt_irrefl _ this
  have hneg : ∃ b ∈ F, m b < 0 := by
    by_contra! h
    have h₀ : 0 < m e₀ := by have := h e₀ he₀; omega
    have : 0 < ∑ e ∈ F, m e := Finset.sum_pos' h ⟨e₀, he₀, h₀⟩
    rw [hsum] at this
    exact lt_irrefl _ this
  obtain ⟨a, ha, hma⟩ := hpos
  obtain ⟨b, hb, hmb⟩ := hneg
  -- minimality: every positive ray is antipodal to every negative ray
  have hanti := Submission.odc_antipodal C hmin F hF m hCm
  obtain rfl : b = -a := hanti a b ha hb hma hmb
  have hsupp : ∀ e ∈ F, m e ≠ 0 → e = a ∨ e = -a := by
    intro e he hme
    rcases lt_or_gt_of_ne hme with h | h
    · exact Or.inr (hanti a e ha he hma h)
    · exact Or.inl (neg_injective (hanti e (-a) he hb h hmb)).symm
  -- `∑ m e = m a + m (-a)`, so `m (-a) = -m a`
  have ha0 : a ≠ -a := by
    intro h
    have : a = 0 := by
      have h2 : (2 : ℝ) • a = 0 := by rw [two_smul]; nth_rewrite 2 [h]; exact add_neg_cancel a
      exact (smul_eq_zero.1 h2).resolve_left two_ne_zero
    have h1 := hF a ha
    rw [this, norm_zero] at h1
    exact zero_ne_one h1
  have hsum2 : ∑ e ∈ F, m e = m a + m (-a) :=
    Finset.sum_eq_add a (-a) ha0
      (fun e he hne => by
        by_contra hme
        rcases hsupp e he hme with h | h
        · exact hne.1 h
        · exact hne.2 h)
      (fun h => absurd ha h) (fun h => absurd hb h)
  obtain ⟨k, hk⟩ : ∃ k : ℕ, m a = k := ⟨(m a).toNat, (Int.toNat_of_nonneg hma.le).symm⟩
  have hk' : m (-a) = -k := by omega
  obtain ⟨hs, hd⟩ := Submission.odc_line_conclusion C F hF m hCm a ha hb hsupp k hk hk'
  exact ⟨a, k, fun _ => hF a ha, hs, hd⟩
/-- **Invariant minimizing cycles are cones that split off their spine** (Simon Lemma 7.3.5, with
the invariance step of the proof of 7.3.3 and footnote 2 of 7.3.1).  Let `S ∈ 𝒟ₙ(ℝᴾ)` be
minimizing with `∂S = 0`, and `L ⊆ ℝᴾ` a subspace with `d = dim L < n` such that the density of
`S` is invariant under `w ↦ y + λw` (`y ∈ L`, `λ > 0`).  If `n > P` then `S = 0`.  Otherwise fix
`S = τ(M, θ, ξ)` and `μ = θHⁿ⌞M`: by monotonicity `Θ(S, ·)` exists everywhere, and by 7.1.2
(`U = N = ℝᴾ`) `v(M, θ)` is stationary.  The invariance of `Θ` makes `μ` invariant under
translations by `L` and `n`-homogeneous, so the monotonicity identity gives `x ∈ TₓM` and
`L ⊆ TₓM` for `μ`-a.e. `x`; hence `S` is a cone and is invariant under translations by `L`
(homotopy formula).  Slicing by the projection onto `L` gives `S = [[L]] × S₀`, where `S₀` is a cone
cycle in `L^⊥`, minimizing in `L^⊥` (product competitors) and hence in `ℝᴾ` (orthogonal
projection), and `μ = Hᵈ⌞L ⊗ μ_{S₀}`; supports and densities correspond through this product. -/
theorem Submission.dimred_invariant_cone_splitting : ∀ (P n : ℕ) (S : GeometricCurrentOn (univ : Set (Euclid P)) n) (L : Submodule ℝ (Euclid P)), Module.finrank ℝ L < n → IsMinimizingIn S univ → BoundaryVanishes S → (∀ y ∈ L, ∀ lam : ℝ, 0 < lam → ∀ (w : Euclid P) (θ : ℝ), HasMassDensity S w θ → HasMassDensity S (y + lam • w) θ) → IsConeCurrent S ∧ (∀ v ∈ L, ∀ ω : TestFormOn (univ : Set (Euclid P)) n, currentEval (blowUp S (-v) 1 one_ne_zero) (ω : DifferentialForm (Euclid P) n) = S ω) ∧ ∃ S₀ : GeometricCurrentOn (univ : Set (Euclid P)) (n - Module.finrank ℝ L), IsMinimizingIn S₀ univ ∧ BoundaryVanishes S₀ ∧ IsConeCurrent S₀ ∧ S₀.support ⊆ (Lᗮ : Set (Euclid P)) ∧ (∀ t ∈ L, ∀ y ∈ Lᗮ, (t + y ∈ S.support ↔ y ∈ S₀.support)) ∧ ∀ t ∈ L, ∀ y ∈ Lᗮ, ∀ θ : ℝ, (HasMassDensity S (t + y) θ ↔ HasMassDensity S₀ y θ) := by
  intro P n S L hd hmin hbd hinv
  -- `n > P`: every `n`-current in `ℝᴾ` vanishes
  rcases lt_or_ge P n with hPn | hnP
  · exact Submission.dimred_cs_high_degree_case P n S L hPn
  have hn : 0 < n := (Nat.zero_le _).trans_lt hd
  -- `ℝᵐ` is an embedded `C²` `m`-submanifold of itself (identity chart)
  have huniv : ∀ m : ℕ, IsEmbeddedSubmanifold 2 m (univ : Set (Euclid m)) := fun m y _ =>
    ⟨univ, univ, id, isOpen_univ, isOpen_univ, mem_univ y, contDiffOn_id, injOn_id _,
      by simp, fun K _ hK => by simpa using hK, fun z _ => by
        rw [fderiv_id, ContinuousLinearMap.coe_id']; exact injective_id⟩
  obtain ⟨R, hR⟩ := hmin.1
  -- `Θ(S, x)` exists at every `x` (monotonicity with `U = N = ℝᴾ`)
  obtain ⟨-, -, ⟨Θ, hΘ, -⟩, -⟩ := Submission.dimred_minimizing_monotonicity P n P univ univ S
    hn hnP le_rfl isOpen_univ (huniv P) (by simp) (by rwa [inter_self]) (by simp) hbd
  -- `v(M, θ)` is stationary in `ℝᴾ` (7.1.2 with `U = N = ℝᴾ`, where every vector is tangent)
  have hstat : ∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X →
      R.firstVariation X = 0 := by
    obtain ⟨k, rfl⟩ : ∃ k, P = n + k := ⟨P - n, by omega⟩
    intro X hX hXc
    refine (Submission.minimizing_implies_stationary n k k le_rfl univ univ S isOpen_univ
      (huniv (n + k)) (by simp) (subset_univ _) (by rwa [inter_self]) hbd R hR).1 X hX hXc
      (subset_univ _) fun y _ => ⟨fun t => y + t • X y,
        (contDiff_const.add (contDiff_id.smul contDiff_const)).contDiffOn, mapsTo_univ _ _,
        by simp, by simpa using ((hasDerivAt_id (0 : ℝ)).smul_const (X y)).const_add y⟩
  -- `μ` is invariant under translations by `L` and `n`-homogeneous
  obtain ⟨htrans, hscale⟩ := Submission.dimred_cs_measure_invariant_of_density_invariant P n S R L
    hn hR (fun x => ⟨Θ x, hΘ x (mem_univ x)⟩) hinv
  -- `x ∈ TₓM` and `L ⊆ TₓM` for `μ`-a.e. `x`
  have htan := Submission.dimred_cs_spine_tangent_of_invariant_measure P n R L hn hstat htrans
    hscale
  -- (a) `S` is a cone; (b) `S` is invariant under translations by `L`
  have hcone : IsConeCurrent S := Submission.dimred_cs_cone_of_radial_tangency P n S R hn hR hbd
    (htan.mono fun x hx => hx.1)
  have htr : ∀ v ∈ L, ∀ ω : TestFormOn (univ : Set (Euclid P)) n,
      currentEval (blowUp S (-v) 1 one_ne_zero) (ω : DifferentialForm (Euclid P) n) = S ω :=
    fun v hv => Submission.dimred_cs_translation_invariant_of_tangency P n S R v hn hR hbd
      (htan.mono fun x hx => hx.2 v hv)
  refine ⟨hcone, htr, ?_⟩
  -- `S = [[L]] × S₀`: `S₀` is a cone cycle in `L^⊥`, minimizing in `L^⊥`, `μ = Hᵈ⌞L ⊗ μ_{S₀}`
  obtain ⟨S₀, R₀, hR₀, hmin₀, hbd₀, hcone₀, hspt₀, hnull₀, hprod⟩ :=
    Submission.dimred_cs_split_off_spine P n S R L hd hnP hmin hbd hcone htr hR
      (htan.mono fun x hx => hx.2)
  -- `S₀` is minimizing in `ℝᴾ` (orthogonal projection onto `L^⊥`; `n − d ≥ 1`)
  have hmin₀' : IsMinimizingIn S₀ univ :=
    Submission.dimred_cs_minimizing_of_minimizing_in_subspace P (n - Module.finrank ℝ L) S₀ Lᗮ
      (by omega) hmin₀ hspt₀
  -- `Θ(S₀, y)` exists at every `y` (monotonicity for `S₀`)
  obtain ⟨-, -, ⟨Θ₀, hΘ₀, -⟩, -⟩ := Submission.dimred_minimizing_monotonicity P
    (n - Module.finrank ℝ L) P univ univ S₀ (by omega) (by omega) le_rfl isOpen_univ (huniv P)
    (by simp) (by rwa [inter_self]) (by simp) hbd₀
  -- supports and densities correspond through `μ = Hᵈ⌞L ⊗ μ_{S₀}`
  obtain ⟨hsupp, hdens⟩ := Submission.dimred_cs_product_support_density P n L S S₀ R R₀ hd hR hR₀
    hnull₀ hprod fun y _ => ⟨Θ₀ y, hΘ₀ y (mem_univ y)⟩
  exact ⟨S₀, hmin₀', hbd₀, hcone₀, hspt₀, hsupp, hdens⟩

/-- **Planar support of a `2`-dimensional minimizing cycle with `ℝp`-invariant density**
(Simon 7.3.5 followed by formula (10) in the proof of 7.3.3(2)).  Let `S ∈ 𝒟₂(ℝᴾ)` be minimizing
with `∂S = 0`, whose density is invariant under `w ↦ y + λw` (`y ∈ ℝp`, `λ > 0`, `p ≠ 0`), and
with `Θ²(μ_S, 0) = θ ≥ 1`.  Splitting off `L = ℝp` gives `S = [[L]] × S₀` with `S₀` a minimizing
`1`-dimensional cone cycle, `spt S₀ ⊆ Lᗮ`; by formula (10) `S₀ = m[[ℝe]]`.  Comparing densities
at `0` gives `m = θ ≥ 1`, so `|e| = 1`, and `Θ(S₀, e) = m > 0` forces `e ∈ spt S₀ ⊆ Lᗮ`.  Then
`τ = (p/|p|, e)` is orthonormal, `p ∈ span τ`, and `x = p_L x + (x − p_L x)` shows
`spt S ⊆ span τ`. -/
theorem Submission.idtp_cttp_planar_support : ∀ (P : ℕ) (S : GeometricCurrentOn (univ : Set (Euclid P)) 2) (p : Euclid P) (θ : ℝ), p ≠ 0 → IsMinimizingIn S univ → BoundaryVanishes S → (∀ y ∈ Submodule.span ℝ {p}, ∀ lam : ℝ, 0 < lam → ∀ (w : Euclid P) (θ' : ℝ), HasMassDensity S w θ' → HasMassDensity S (y + lam • w) θ') → 1 ≤ θ → HasMassDensity S 0 θ → ∃ τ : Fin 2 → Euclid P, Orthonormal ℝ τ ∧ p ∈ Submodule.span ℝ (Set.range τ) ∧ S.support ⊆ (Submodule.span ℝ (Set.range τ) : Set (Euclid P)) := by
  intro P S p θ hp hmin hbd hinv hθ hS
  -- Step 1: `dim ℝp = 1 < 2`
  have hrank : Module.finrank ℝ (Submodule.span ℝ {p}) = 1 := finrank_span_singleton hp
  -- Step 2: `S = [[ℝp]] × S₀` (Simon 7.3.5), with `S₀` of degree `2 - 1 = 1`
  obtain ⟨-, -, S₀, hmin₀, hbd₀, hcone₀, hspt₀, hsupp, hdens⟩ :=
    Submission.dimred_invariant_cone_splitting P 2 S (Submodule.span ℝ {p}) (by omega) hmin hbd
      hinv
  have key : ∀ (k : ℕ) (S₀ : GeometricCurrentOn (univ : Set (Euclid P)) k), k = 1 →
      IsMinimizingIn S₀ univ → BoundaryVanishes S₀ → IsConeCurrent S₀ →
      S₀.support ⊆ ((Submodule.span ℝ {p})ᗮ : Set (Euclid P)) →
      (∀ t ∈ Submodule.span ℝ {p}, ∀ y ∈ (Submodule.span ℝ {p})ᗮ,
        (t + y ∈ S.support ↔ y ∈ S₀.support)) →
      (∀ t ∈ Submodule.span ℝ {p}, ∀ y ∈ (Submodule.span ℝ {p})ᗮ, ∀ θ : ℝ,
        (HasMassDensity S (t + y) θ ↔ HasMassDensity S₀ y θ)) →
      ∃ τ : Fin 2 → Euclid P, Orthonormal ℝ τ ∧ p ∈ Submodule.span ℝ (Set.range τ) ∧
        S.support ⊆ (Submodule.span ℝ (Set.range τ) : Set (Euclid P)) := by
    intro k S₀ hk hmin₀ hbd₀ hcone₀ hspt₀ hsupp hdens
    subst hk
    -- Step 3: `S₀ = m[[ℝe]]` (formula (10)): `spt S₀ ⊆ ℝe` and `Θ(S₀, ·) = m` on `ℝe`
    obtain ⟨e, m, hem, hsptS₀, hdensS₀⟩ :=
      Submission.dimred_one_dim_minimizing_cone P S₀ hmin₀ hbd₀ hcone₀
    -- Step 4: `Θ(S₀, 0) = Θ(S, 0 + 0) = θ`, so `m = θ ≥ 1` and `|e| = 1`
    have h0 : HasMassDensity S₀ 0 θ :=
      (hdens 0 (Submodule.zero_mem _) 0 (Submodule.zero_mem _) θ).1 (by rwa [add_zero])
    have hmθ : θ = m := Submission.dimred_cs_mi_hasMassDensity_unique P 1 univ S₀ 0 θ m h0
      (hdensS₀ 0 (Submodule.zero_mem _))
    have hm1 : (1 : ℝ) ≤ m := by rw [← hmθ]; exact hθ
    have he : ‖e‖ = 1 := hem (by exact_mod_cast zero_lt_one.trans_le hm1)
    -- Step 5: `e ∈ spt S₀`, otherwise `μ_{S₀}(B_ρ(e)) = 0` for small `ρ` and `Θ(S₀, e) = 0 ≠ m`
    have heS₀ : e ∈ S₀.support := by
      by_contra hne
      obtain ⟨R₀, hR₀⟩ := hmin₀.1
      obtain ⟨hmass, hsptR, -⟩ :=
        Submission.dimred_im_mass_measure P 1 univ S₀ R₀ isOpen_univ hR₀
      obtain ⟨ε, hε, hε0⟩ : ∃ ε : ℝ, 0 < ε ∧ R₀.measure (ball e ε) = 0 := by
        by_contra! h
        exact hne ((hsptR e (mem_univ e)).2 h)
      have hzero : HasMassDensity S₀ e 0 := by
        refine ⟨le_rfl, ?_⟩
        rw [ENNReal.ofReal_zero]
        refine (tendsto_congr' ?_).2 tendsto_const_nhds
        filter_upwards [Ioo_mem_nhdsGT hε] with ρ hρ
        rw [hmass _ isOpen_ball (subset_univ _),
          measure_mono_null (ball_subset_ball hρ.2.le) hε0, ENNReal.zero_div]
      have hm0 : (m : ℝ) = 0 := Submission.dimred_cs_mi_hasMassDensity_unique P 1 univ S₀ e m 0
        (hdensS₀ e (Submodule.mem_span_singleton_self e)) hzero
      linarith
    -- hence `e ∈ (ℝp)ᗮ`
    have hpe : inner ℝ p e = 0 :=
      Submodule.inner_right_of_mem_orthogonal (Submodule.mem_span_singleton_self p) (hspt₀ heS₀)
    have hep : inner ℝ e p = 0 := by rw [real_inner_comm]; exact hpe
    -- Step 6: the orthonormal frame `τ = (p/|p|, e)`, with `p ∈ span τ`
    have hpn : ‖p‖ ≠ 0 := norm_ne_zero_iff.2 hp
    have hτ0 : ‖p‖⁻¹ • p ∈ Submodule.span ℝ (Set.range ![‖p‖⁻¹ • p, e]) :=
      Submodule.subset_span ⟨0, rfl⟩
    have hτ1 : e ∈ Submodule.span ℝ (Set.range ![‖p‖⁻¹ • p, e]) :=
      Submodule.subset_span ⟨1, rfl⟩
    have hpτ : p ∈ Submodule.span ℝ (Set.range ![‖p‖⁻¹ • p, e]) := by
      have h := Submodule.smul_mem _ ‖p‖ hτ0
      rwa [smul_inv_smul₀ hpn] at h
    refine ⟨![‖p‖⁻¹ • p, e], ⟨fun i => ?_, fun i j hij => ?_⟩, hpτ, ?_⟩
    · fin_cases i
      · simp [norm_smul, hpn]
      · simpa using he
    · fin_cases i <;> fin_cases j
      · exact absurd rfl hij
      · simp [real_inner_smul_left, hpe]
      · simp [real_inner_smul_right, hep]
      · exact absurd rfl hij
    -- Step 7: `x = t + z`, `t ∈ ℝp`, `z ∈ (ℝp)ᗮ`, and `z ∈ spt S₀ ⊆ ℝe`
    · intro x hx
      obtain ⟨t, ht, z, hz, rfl⟩ := (Submodule.span ℝ {p}).exists_add_mem_mem_orthogonal x
      have hze : z ∈ Submodule.span ℝ {e} := hsptS₀ ((hsupp t ht z hz).1 hx)
      exact Submodule.add_mem _ ((Submodule.span_singleton_le_iff_mem _ _).2 hpτ ht)
        ((Submodule.span_singleton_le_iff_mem _ _).2 hτ1 hze)
  exact key _ S₀ (by omega) hmin₀ hbd₀ hcone₀ hspt₀ hsupp hdens

/-- Finite-mass count in the proof of Simon 7.3.3(1) (pp. 191–192: `spt S₀` lies in finitely
many 2-planes): a measure `μ` on `ℝᴾ` that is finite on compact sets admits no infinite pairwise
disjoint family of measurable sets `Dᵢ ⊆ B_r(0)` with `μ(Dᵢ) ≥ c > 0`.  All `Dᵢ` lie in the
compact ball `closedBall 0 r`, so `∞ = ∑ᵢ c ≤ ∑ᵢ μ(Dᵢ) = μ(⋃ᵢ Dᵢ) ≤ μ(closedBall 0 r) < ∞`. -/
theorem Submission.idtp_tdc_nipp_disjoint_packing : ∀ (P : ℕ) (μ : Measure (Euclid P)) (D : ℕ → Set (Euclid P)) (r : ℝ) (c : ℝ≥0∞), (∀ K : Set (Euclid P), IsCompact K → μ K ≠ ∞) → c ≠ 0 → (∀ i, MeasurableSet (D i)) → (∀ i j, i ≠ j → Disjoint (D i) (D j)) → (∀ i, D i ⊆ ball 0 r) → (∀ i, c ≤ μ (D i)) → False := by
  intro P μ D r c hμ hc hD hdisj hball hcD
  -- `closedBall 0 r` is compact, yet `∞ = ∑ᵢ c ≤ ∑ᵢ μ(Dᵢ) = μ(⋃ᵢ Dᵢ) ≤ μ(closedBall 0 r)`
  refine hμ _ (isCompact_closedBall 0 r) (top_le_iff.mp ?_)
  calc ∞ = ∑' _ : ℕ, c := (ENNReal.tsum_const_eq_top_of_ne_zero hc).symm
    _ ≤ ∑' i, μ (D i) := ENNReal.tsum_le_tsum hcD
    _ = μ (⋃ i, D i) := (measure_iUnion (fun i j hij => hdisj i j hij) hD).symm
    _ ≤ μ (closedBall 0 r) :=
      measure_mono (iUnion_subset fun i => (hball i).trans ball_subset_closedBall)

/-- Finite-mass count in the proof of Simon 7.3.3(1) (pp. 191–192), for discs in 2-planes: an
integer multiplicity 2-current `C` in `ℝᴾ` admits no infinite pairwise disjoint family of discs
`Dᵢ = Qᵢ ∩ B_ρ(zᵢ)` (`Qᵢ` a 2-plane, `zᵢ ∈ Qᵢ`, `|zᵢ| ≤ R`) such that every `w ∈ Dᵢ` has a ball
`B_ε(w)` with `H²(W ∩ Qᵢ) ≤ M_W(C)` for its open subsets `W`.  For `C = τ(M, θ, ξ)` and
`μ = θH²⌞M`, `M_W(C) = μ(W)` on open sets and `μ` is finite on compact sets, so local-to-global
comparison of `H²⌞Qᵢ` with `μ` gives `μ(Dᵢ) ≥ H²(Dᵢ) = ω₂ρ² > 0`; all `Dᵢ` lie in `B_{R+ρ}(0)`,
which contradicts the disjoint packing bound. -/
theorem Submission.idtp_tdc_no_infinite_planar_pieces : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2) (Q : ℕ → Submodule ℝ (Euclid P)) (z : ℕ → Euclid P) (ρ R : ℝ), IsIntegerMultiplicity C → 0 < ρ → (∀ i, Module.finrank ℝ (Q i) = 2) → (∀ i, z i ∈ Q i) → (∀ i, ‖z i‖ ≤ R) → (∀ i j, i ≠ j → Disjoint ((Q i : Set (Euclid P)) ∩ ball (z i) ρ) ((Q j : Set (Euclid P)) ∩ ball (z j) ρ)) → (∀ i, ∀ w ∈ (Q i : Set (Euclid P)) ∩ ball (z i) ρ, ∃ ε : ℝ, 0 < ε ∧ ∀ W : Set (Euclid P), IsOpen W → W ⊆ ball w ε → μHE[2] (W ∩ (Q i : Set (Euclid P))) ≤ C.massOn W) → False := by
  intro P C Q z ρ R hC hρ hdim hz hR hdisj hloc
  -- (1) `C = τ(M, θ, ξ)`; `μ = θH²⌞M` has `M_W(C) = μ(W)` for open `W` and is finite on compacts
  obtain ⟨RC, hRC⟩ := hC
  have hmass : ∀ W : Set (Euclid P), IsOpen W → C.massOn W = RC.measure W := fun W hW =>
    (Submission.dimred_im_mass_measure P 2 univ C RC isOpen_univ hRC).1 W hW (subset_univ W)
  have hfin : ∀ K : Set (Euclid P), IsCompact K → RC.measure K ≠ ∞ := by
    intro K hK
    rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
      Measure.restrict_restrict hK.measurableSet, inter_comm]
    exact RC.locallyIntegrable_mult K hK (subset_univ K)
  -- the discs `Dᵢ = Qᵢ ∩ B_ρ(zᵢ)` are Borel, `Qᵢ` being closed
  have hQm : ∀ i, MeasurableSet (Q i : Set (Euclid P)) := fun i =>
    (Submodule.closed_of_finiteDimensional (Q i)).measurableSet
  have hDm : ∀ i, MeasurableSet ((Q i : Set (Euclid P)) ∩ ball (z i) ρ) := fun i =>
    (hQm i).inter measurableSet_ball
  -- (2) `H²(Dᵢ) ≤ μ(Dᵢ)`: local-to-global comparison of `H²⌞Qᵢ` with `μ`
  have hle : ∀ i, μHE[2] ((Q i : Set (Euclid P)) ∩ ball (z i) ρ) ≤
      RC.measure ((Q i : Set (Euclid P)) ∩ ball (z i) ρ) := by
    intro i
    have hloc' : ∀ w ∈ (Q i : Set (Euclid P)) ∩ ball (z i) ρ, ∃ ε : ℝ, 0 < ε ∧
        ∀ W : Set (Euclid P), IsOpen W → W ⊆ ball w ε →
          μHE[2].restrict (Q i : Set (Euclid P)) W ≤ RC.measure W := by
      intro w hw
      obtain ⟨ε, hε, hW⟩ := hloc i w hw
      refine ⟨ε, hε, fun W hWo hWB => ?_⟩
      rw [Measure.restrict_apply' (hQm i), ← hmass W hWo]
      exact hW W hWo hWB
    have h := Submission.idtp_tdc_nipp_local_comparison P RC.measure
      (μHE[2].restrict (Q i : Set (Euclid P))) _ hfin (hDm i) hloc'
    rwa [Measure.restrict_apply' (hQm i), inter_eq_left.mpr inter_subset_left] at h
  -- (3) `H²(Dᵢ) = ω₂ρ² =: c > 0`
  have hc0 : unitBallVolume 2 * ENNReal.ofReal (ρ ^ 2) ≠ 0 :=
    mul_ne_zero (measure_ball_pos volume (0 : Euclid 2) one_pos).ne'
      (ENNReal.ofReal_pos.mpr (pow_pos hρ 2)).ne'
  have hcD : ∀ i, unitBallVolume 2 * ENNReal.ofReal (ρ ^ 2) ≤
      RC.measure ((Q i : Set (Euclid P)) ∩ ball (z i) ρ) := fun i =>
    (Submission.idtp_tdc_subspace_ball_measure P 2 (Q i) (z i) ρ (hdim i) (hz i)
      hρ).symm.le.trans (hle i)
  -- (4) all `Dᵢ` lie in `B_{R+ρ}(0)`, and infinitely many disjoint ones force `μ(B_{R+ρ}(0)) = ∞`
  refine Submission.idtp_tdc_nipp_disjoint_packing P RC.measure
    (fun i => (Q i : Set (Euclid P)) ∩ ball (z i) ρ) (R + ρ) _ hfin hc0 hDm hdisj
    (fun i => inter_subset_right.trans (ball_subset_ball' ?_)) hcD
  rw [dist_zero_right]
  linarith [hR i]
/-- **Simon Ch. 6, proof of 7.2 (summing the flat decomposition)**.  Let `n = m + 1 < P`, `L` be
compact, and `X_r, Z_r, Y ∈ 𝒟ₙ(ℝᴾ)`, `R_r ∈ 𝒟ₙ₊₁(ℝᴾ)`, `S_r ∈ 𝒟ₙ(ℝᴾ)` with `Y`, `Z_r`, `R_r` integer
multiplicity, `M(X_r) ≤ Λ`, `spt R_r ⊆ L`, `X_{r+1} − X_r − S_r = ∂R_r`, `M(R_r) + M(S_r) ≤ 2^{−r}`,
and `Z_r(ω) = X_r(ω) → Y(ω)` whenever `spt ω ⊆ V`.  Then for every `q` there are integer
multiplicity `R'`, `S'` with `Y − Z_q − S' = ∂R'` and `M_V(R') + M_V(S') ≤ 2·2^{−q}`.
* The series `R^{(q)} = Σᵢ R_{q+i}` and `S^{(q)} = Σᵢ S_{q+i}` converge in mass; `R^{(q)}` is
  integer multiplicity, `spt R^{(q)} ⊆ L`, and `M(R^{(q)}) + M(S^{(q)}) ≤ Σᵢ 2^{−(q+i)} = 2·2^{−q}`.
* Telescoping: `X_{q+N}(ω) → X_q(ω) + ∂R^{(q)}(ω) + S^{(q)}(ω)` for every `ω`.
* Testing with `±ω`, `M(∂R^{(q)}) ≤ 2Λ + M(S^{(q)}) < ∞`; `spt R^{(q)}` is compact, so boundary
  rectifiability makes `∂R^{(q)}` integer multiplicity.
* For `spt ω ⊆ V`, `Y(ω) = Z_q(ω) + ∂R^{(q)}(ω) + S^{(q)}(ω)`.  So `R' = R^{(q)}` and
  `S' = Y − Z_q − ∂R^{(q)}` work: `S'` is integer multiplicity, and `S' = S^{(q)}` on `V` gives
  `M_V(S') ≤ M(S^{(q)})`. -/
theorem Submission.dtc_bc_lc_fd_series_limit : ∀ (P m : ℕ) (X Z : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (V L : Set (Euclid P)) (Λ : NNReal), m + 1 < P → IsCompact L → IsIntegerMultiplicity Y → (∀ r, IsIntegerMultiplicity (Z r)) → (∀ r, (X r).mass ≤ Λ) → (∀ r, IsIntegerMultiplicity (R r) ∧ (R r).support ⊆ L ∧ X (r + 1) - X r - S r = (R r).boundary ∧ (R r).mass + (S r).mass ≤ (2⁻¹ : ℝ≥0∞) ^ r) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ V → (∀ r, Z r ω = X r ω) ∧ Tendsto (fun r => X r ω) atTop (𝓝 (Y ω))) → ∀ q : ℕ, ∃ (R' : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S' : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity R' ∧ IsIntegerMultiplicity S' ∧ Y - Z q - S' = R'.boundary ∧ R'.massOn V + S'.massOn V ≤ 2 * (2⁻¹ : ℝ≥0∞) ^ q := by
  intro P m X Z Y R S V L Λ hP hL hY hZ hXΛ hRS hV q
  -- Step 1: `M(R_r), M(S_r) ≤ 2^{−r}`, and `Σᵢ 2^{−(q+i)} = 2·2^{−q} < ∞`
  have hgeom : ∑' i, (2⁻¹ : ℝ≥0∞) ^ (q + i) = 2 * (2⁻¹ : ℝ≥0∞) ^ q := by
    simp_rw [pow_add]
    rw [ENNReal.tsum_mul_left, ENNReal.tsum_geometric, ENNReal.one_sub_inv_two, inv_inv, mul_comm]
  have hfin : 2 * (2⁻¹ : ℝ≥0∞) ^ q < ∞ :=
    ENNReal.mul_lt_top ENNReal.ofNat_lt_top (ENNReal.pow_lt_top (ENNReal.inv_lt_top.2 two_pos))
  have hRsum : ∑' i, (R (q + i)).mass ≤ 2 * (2⁻¹ : ℝ≥0∞) ^ q :=
    (ENNReal.tsum_le_tsum fun i => le_self_add.trans (hRS (q + i)).2.2.2).trans hgeom.le
  have hSsum : ∑' i, (S (q + i)).mass ≤ 2 * (2⁻¹ : ℝ≥0∞) ^ q :=
    (ENNReal.tsum_le_tsum fun i => le_add_self.trans (hRS (q + i)).2.2.2).trans hgeom.le
  -- Step 2: the mass-convergent series `R^{(q)} = Σᵢ R_{q+i}` and `S^{(q)} = Σᵢ S_{q+i}`
  obtain ⟨RQ, hRQ, hRQm, hRQs, hRQim⟩ :=
    Submission.dtc_bc_lc_fd_series P (m + 1) (fun i => R (q + i)) (hRsum.trans_lt hfin)
  obtain ⟨SQ, hSQ, hSQm, -, -⟩ :=
    Submission.dtc_bc_lc_fd_series P m (fun i => S (q + i)) (hSsum.trans_lt hfin)
  have hRQim' : IsIntegerMultiplicity RQ := hRQim fun i => (hRS (q + i)).1
  have hRQL : RQ.support ⊆ L :=
    hRQs.trans (closure_minimal (iUnion_subset fun i => (hRS (q + i)).2.1) hL.isClosed)
  -- Step 3: telescoping, `X_{q+N}(ω) → X_q(ω) + ∂R^{(q)}(ω) + S^{(q)}(ω)` for every `ω`
  have htel : ∀ (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)) (N : ℕ),
      X (q + N) ω = X q ω + ∑ i ∈ Finset.range N, (R (q + i)).boundary ω +
        ∑ i ∈ Finset.range N, S (q + i) ω := by
    intro ω N
    induction N with
    | zero => simp
    | succ N ih =>
      have h : X (q + N + 1) ω - X (q + N) ω - S (q + N) ω = (R (q + N)).boundary ω :=
        congrArg (fun T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1) => T ω)
          (hRS (q + N)).2.2.1
      rw [Finset.sum_range_succ, Finset.sum_range_succ]
      show X (q + N + 1) ω = _
      linarith
  have hlim : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1),
      Tendsto (fun N => X (q + N) ω) atTop (𝓝 (X q ω + RQ.boundary ω + SQ ω)) := by
    intro ω
    have h1 : Tendsto (fun N => ∑ i ∈ Finset.range N, (R (q + i)).boundary ω) atTop
        (𝓝 (RQ.boundary ω)) :=
      (hRQ (exteriorDerivativeTestOn univ (m + 1) ω)).tendsto_sum_nat
    have h2 : Tendsto (fun N => ∑ i ∈ Finset.range N, S (q + i) ω) atTop (𝓝 (SQ ω)) :=
      (hSQ ω).tendsto_sum_nat
    exact ((tendsto_const_nhds (x := X q ω)).add h1 |>.add h2).congr fun N => (htel ω N).symm
  -- Step 4: `M(∂R^{(q)}) ≤ 2Λ + M(S^{(q)}) < ∞`, testing the limit in Step 3 with `±ω`
  have hneg : ∀ ω ∈ massAdmissibleOn univ (m + 1) (univ : Set (Euclid P)),
      -ω ∈ massAdmissibleOn univ (m + 1) (univ : Set (Euclid P)) := by
    intro ω hω
    refine ⟨subset_univ _, fun x => ?_⟩
    have hx : ((-ω : TestFormOn (univ : Set (Euclid P)) (m + 1)) :
        DifferentialForm (Euclid P) (m + 1)) x = -((ω : DifferentialForm (Euclid P) (m + 1)) x) :=
      rfl
    rw [hx, covectorEuclideanNorm_neg]
    exact hω.2 x
  have hle : ∀ (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (c : ℝ≥0∞)
      (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)), c ≠ ∞ → T.mass ≤ c →
      ω ∈ massAdmissibleOn univ (m + 1) univ → T ω ≤ c.toReal := fun T c ω hc hT hω =>
    (ENNReal.ofReal_le_iff_le_toReal hc).1 ((T.le_massOn hω).trans hT)
  have hSQfin : SQ.mass ≠ ∞ := (hSQm.trans_lt (hSsum.trans_lt hfin)).ne
  have hbd : RQ.boundary.mass ≤ ENNReal.ofReal (2 * Λ + SQ.mass.toReal) := by
    apply sSup_le
    rintro _ ⟨ω, hω, rfl⟩
    show ENNReal.ofReal (RQ.boundary ω) ≤ _
    apply ENNReal.ofReal_le_ofReal
    have h0 : X q ω + RQ.boundary ω + SQ ω ≤ Λ :=
      le_of_tendsto (hlim ω) (Eventually.of_forall fun N => by
        simpa using hle (X (q + N)) Λ ω ENNReal.coe_ne_top (hXΛ _) hω)
    have h1 : -X q ω ≤ Λ := by
      have h := hle (X q) Λ (-ω) ENNReal.coe_ne_top (hXΛ q) (hneg ω hω)
      rw [(X q).toCurrent.map_neg ω] at h
      simpa using h
    have h2 : -SQ ω ≤ SQ.mass.toReal := by
      have h := hle SQ SQ.mass (-ω) hSQfin le_rfl (hneg ω hω)
      rwa [SQ.toCurrent.map_neg ω] at h
    linarith
  -- Step 5: `spt R^{(q)}` is closed in the compact `L`, so boundary rectifiability applies
  have hRQcpt : IsCompact RQ.support :=
    hL.of_isClosed_subset (isClosed_univ.sdiff RQ.isOpen_zeroRegion) hRQL
  have hbdim : IsIntegerMultiplicity RQ.boundary :=
    Submission.dtc_bc_lc_fd_boundary_im P m RQ hP hRQim' hRQcpt
      (hRQm.trans_lt (hRsum.trans_lt hfin)) (hbd.trans_lt ENNReal.ofReal_lt_top)
  -- Step 6: for `spt ω ⊆ V`, `Y(ω) = Z_q(ω) + ∂R^{(q)}(ω) + S^{(q)}(ω)`
  have hid : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1),
      tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ V →
      Y ω = Z q ω + RQ.boundary ω + SQ ω := by
    intro ω hω
    obtain ⟨hZX, hXY⟩ := hV ω hω
    have hshift : Tendsto (fun N => X (q + N) ω) atTop (𝓝 (Y ω)) :=
      ((tendsto_add_atTop_iff_nat q).2 hXY).congr fun N =>
        congrArg (fun r => X r ω) (Nat.add_comm N q)
    rw [hZX q]
    exact tendsto_nhds_unique hshift (hlim ω)
  -- Step 7: `R' = R^{(q)}` and `S' = Y − Z_q − ∂R^{(q)}`, integer multiplicity as a difference
  have hsub := Submission.cmc_imRep_locality_restrict_sub.2.2.1
  refine ⟨RQ, Y - Z q - RQ.boundary, hRQim',
    hsub P (m + 1) univ _ _ isOpen_univ (hsub P (m + 1) univ _ _ isOpen_univ hY (hZ q)) hbdim,
    ?_, ?_⟩
  · ext ω
    show Y ω - Z q ω - (Y ω - Z q ω - RQ.boundary ω) = RQ.boundary ω
    ring
  -- Step 8: `M_V(R') ≤ M(R^{(q)})`, and `M_V(S') ≤ M(S^{(q)})` since `S' = S^{(q)}` on `V`
  · have hS' : (Y - Z q - RQ.boundary).massOn V ≤ SQ.mass := by
      apply sSup_le
      rintro _ ⟨ω, hω, rfl⟩
      show ENNReal.ofReal (Y ω - Z q ω - RQ.boundary ω) ≤ SQ.mass
      have heq : Y ω - Z q ω - RQ.boundary ω = SQ ω := by
        rw [hid ω hω.1]
        ring
      rw [heq]
      exact SQ.le_massOn ⟨subset_univ _, hω.2⟩
    calc RQ.massOn V + (Y - Z q - RQ.boundary).massOn V ≤ RQ.mass + SQ.mass :=
          add_le_add (RQ.massOn_mono (subset_univ V)) hS'
      _ ≤ ∑' i, (R (q + i)).mass + ∑' i, (S (q + i)).mass := add_le_add hRQm hSQm
      _ = ∑' i, ((R (q + i)).mass + (S (q + i)).mass) := ENNReal.tsum_add.symm
      _ ≤ ∑' i, (2⁻¹ : ℝ≥0∞) ^ (q + i) := ENNReal.tsum_le_tsum fun i => (hRS (q + i)).2.2.2
      _ = 2 * (2⁻¹ : ℝ≥0∞) ^ q := hgeom

/-- **Simon Ch. 6, Definition 7.1 and Theorem 7.2 ("only if")** with `U = ℝᴾ`: if the integer
multiplicity `Tⱼ ⇀ T` in `𝒟ₙ(ℝᴾ)`, `n = m + 1 < P`, and `supⱼ (M_V(Tⱼ) + M_V(∂Tⱼ)) < ∞` for every
bounded open `V`, then for bounded open `W` there are integer multiplicity `Rⱼ`, `Sⱼ` with
`T − Tⱼ − Sⱼ = ∂Rⱼ` and `M_W(Rⱼ) + M_W(Sⱼ) → 0`.

Proof sketch:
* `aⱼ := inf {M_W(R) + M_W(S) : R, S integer multiplicity, T − Tⱼ − S = ∂R}` is Simon's
  `d_W(Tⱼ, T)`; it suffices that every subsequence `T_{ns j}` has a further subsequence along
  which `a → 0` (`tendsto_of_subseq_tendsto`).
* Localise: `T'ⱼ = T_{ns (φ j)}` on forms supported in `W`, `spt T'ⱼ ⊆ K` compact,
  `M(T'ⱼ), M(∂T'ⱼ) ≤ Λ` (`dtc_bc_lc_fd_localize`).
* The deformation theorem gives finite nets (`dtc_bc_lc_fd_deformation`), hence a subsequence `ψ`
  with `T'_{ψ(r+1)} − T'_{ψ r} − S_r = ∂R_r`, `M(R_r) + M(S_r) ≤ 2^{-r}`, `spt R_r ⊆ L`
  (`dtc_bc_lc_fd_cauchy_subseq`).
* Summing against the weak limit, `a_{ns (φ (ψ q))} ≤ 2 · 2^{-q}` (`dtc_bc_lc_fd_series_limit`).
* Choose decompositions with `M_W(Rⱼ) + M_W(Sⱼ) ≤ aⱼ + 2^{-j}`; if `aⱼ = ∞`, take the trivial
  `T − Tⱼ − (T − Tⱼ) = ∂0`, where `0 = τ(∅, 1, 0)` and `T − Tⱼ` is integer multiplicity
  (`cmc_imRep_locality_restrict_sub` (c)). -/
theorem Submission.dtc_bc_lc_flat_decomposition : ∀ (P m : ℕ) (Ts : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), m + 1 < P → (∀ j, IsIntegerMultiplicity (Ts j)) → IsIntegerMultiplicity T → (∀ W : Set (Euclid P), IsOpen W → Bornology.IsBounded W → ⨆ j, ((Ts j).massOn W + (Ts j).boundary.massOn W) < ∞) → WeaklyConvergesOn Ts T → ∀ W : Set (Euclid P), IsOpen W → Bornology.IsBounded W → ∃ (R : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ j, IsIntegerMultiplicity (R j) ∧ IsIntegerMultiplicity (S j) ∧ T - Ts j - S j = (R j).boundary) ∧ Tendsto (fun j => (R j).massOn W + (S j).massOn W) atTop (𝓝 0) := by
  intro P m Ts T hmP hTs hT hbd hconv W _hW hWb
  -- `D j`: the values `M_W(R) + M_W(S)` over the integer multiplicity decompositions
  -- `T − T_j − S = ∂R`; `sInf (D j)` is Simon's `d_W(T_j, T)`
  obtain ⟨D, hD⟩ : ∃ D : ℕ → Set ℝ≥0∞, ∀ j x, x ∈ D j ↔
      ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2))
        (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity R ∧
          IsIntegerMultiplicity S ∧ T - Ts j - S = R.boundary ∧ R.massOn W + S.massOn W = x :=
    ⟨fun j => {x | ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2))
        (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity R ∧
          IsIntegerMultiplicity S ∧ T - Ts j - S = R.boundary ∧ R.massOn W + S.massOn W = x},
      fun _ _ => Iff.rfl⟩
  -- `d_W(T_j, T) → 0`: every subsequence has a further subsequence with `d_W ≤ 2 · 2^{-q}`
  have ha : Tendsto (fun j => sInf (D j)) atTop (𝓝 0) := by
    refine tendsto_of_subseq_tendsto fun ns hns => ?_
    -- localisation: `T'_j = T_{ns (φ j)}` on forms supported in `W`, `spt T'_j ⊆ K`,
    -- `M(T'_j), M(∂T'_j) ≤ Λ`
    obtain ⟨K, φ, Λ, Ts', hK, hφ, hTs'IM, hTs'K, hTs'mass, hTs'eq⟩ :=
      Submission.dtc_bc_lc_fd_localize P m (fun j => Ts (ns j)) W hWb (fun j => hTs (ns j))
        fun V hV hVb => lt_of_le_of_lt
          (iSup_le fun j => le_iSup (fun i => (Ts i).massOn V + (Ts i).boundary.massOn V) (ns j))
          (hbd V hV hVb)
    -- finite nets from the deformation theorem, with `spt R ⊆ L = cthickening 1 K`
    obtain ⟨c, hc⟩ := Submission.dtc_bc_lc_fd_deformation P m hmP
    have hL : IsCompact (cthickening 1 K) := hK.cthickening
    -- a flat-Cauchy subsequence: `T'_{ψ(r+1)} − T'_{ψ r} − S_r = ∂R_r`, `M(R_r) + M(S_r) ≤ 2^{-r}`
    obtain ⟨ψ, hψ, hstep⟩ := Submission.dtc_bc_lc_fd_cauchy_subseq P m (cthickening 1 K) Ts' hL
      fun ε hε => by
        obtain ⟨𝒬, h𝒬, hnet⟩ := hc K Λ ε hK hε
        refine ⟨𝒬, h𝒬, fun j => ?_⟩
        obtain ⟨Q, hQ, R, S, hR, -, hdec, hmass, -, hspt⟩ :=
          hnet (Ts' j) (hTs'IM j) (hTs'K j) (hTs'mass j).1 (hTs'mass j).2
        exact ⟨Q, hQ, R, S, hR, hspt, hdec, hmass⟩
    choose R S hRS using hstep
    -- on forms supported in `W`, `T'_{ψ r} = T_{ns (φ (ψ r))} ⇀ T`; summing the series gives
    -- `T − T_{ns (φ (ψ q))} − S' = ∂R'` with `M_W(R') + M_W(S') ≤ 2 · 2^{-q}`
    have hlim := Submission.dtc_bc_lc_fd_series_limit P m (fun r => Ts' (ψ r))
      (fun r => Ts (ns (φ (ψ r)))) T R S W (cthickening 1 K) Λ hmP hL hT (fun _ => hTs _)
      (fun r => (hTs'mass (ψ r)).1) hRS fun ω hω => by
        have hω' : ∀ r, Ts' (ψ r) ω = Ts (ns (φ (ψ r))) ω := fun r => hTs'eq (ψ r) ω hω
        exact ⟨fun r => (hω' r).symm, ((hconv ω).comp
          (hns.comp (hφ.tendsto_atTop.comp hψ.tendsto_atTop))).congr fun r => (hω' r).symm⟩
    refine ⟨fun q => φ (ψ q), ?_⟩
    have h2 : Tendsto (fun q : ℕ => 2 * (2⁻¹ : ℝ≥0∞) ^ q) atTop (𝓝 0) := by
      simpa using ENNReal.Tendsto.const_mul (a := 2)
        (ENNReal.tendsto_pow_atTop_nhds_zero_of_lt_one (r := 2⁻¹) (by norm_num))
        (Or.inr (by norm_num))
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds h2 (fun _ => zero_le)
      fun q => ?_
    obtain ⟨R', S', hR', hS', hdec, hmass⟩ := hlim q
    exact (sInf_le ((hD _ _).2 ⟨R', S', hR', hS', hdec, rfl⟩)).trans hmass
  -- the zero `(m + 2)`-current `τ(∅, 1, 0)` is integer multiplicity
  have hIM0 : IsIntegerMultiplicity (0 : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) := by
    refine ⟨{ carrier := ∅
              mult := fun _ => 1
              orient := fun _ => 0
              measurableSet_carrier := MeasurableSet.empty
              carrier_subset := empty_subset _
              rectifiable :=
                Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty
              measurable_mult := measurable_const
              mult_pos := fun _ hx => by simp at hx
              locallyIntegrable_mult := fun _ _ _ => by simp
              aestronglyMeasurable_orient := aestronglyMeasurable_const
              orients := by simp }, fun ω => ?_⟩
    simp [IMRep.action]
  -- near-optimal decompositions: `M_W(R) + M_W(S) ≤ d_W(T_j, T) + 2^{-j}`, and the trivial
  -- `T − T_j − (T − T_j) = ∂0` when `d_W(T_j, T) = ∞`
  have hchoice : ∀ j, ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2))
      (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)),
      (IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ T - Ts j - S = R.boundary) ∧
        R.massOn W + S.massOn W ≤ sInf (D j) + (2⁻¹ : ℝ≥0∞) ^ j := by
    intro j
    by_cases htop : sInf (D j) = ⊤
    · refine ⟨0, T - Ts j, ⟨hIM0, Submission.cmc_imRep_locality_restrict_sub.2.2.1 P (m + 1) univ
        T (Ts j) isOpen_univ hT (hTs j), ?_⟩, by simp [htop]⟩
      ext ω
      show T ω - Ts j ω - (T ω - Ts j ω) = _
      simp
    · obtain ⟨x, hx, hlt⟩ := sInf_lt_iff.1
        (ENNReal.lt_add_right htop (pow_ne_zero j (by norm_num) : (2⁻¹ : ℝ≥0∞) ^ j ≠ 0))
      obtain ⟨R, S, hR, hS, hdec, rfl⟩ := (hD j x).1 hx
      exact ⟨R, S, ⟨hR, hS, hdec⟩, hlt.le⟩
  choose R S hRS hle using hchoice
  refine ⟨R, S, hRS, tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds ?_
    (fun _ => zero_le) hle⟩
  simpa using ha.add (ENNReal.tendsto_pow_atTop_nhds_zero_of_lt_one (r := 2⁻¹) (by norm_num))

/-- **Simon 7.2.4, (1)–(11), with Remark 7.2.5(2)** (local comparison).  Let `S_j` minimize in
`A_j ⊇ spt S_j` with locally bounded masses, let `π_j` be `C¹` retractions onto `A_j` that are
eventually `(1 + η)`-Lipschitz on balls, and let the integer multiplicity `Ŝ_j ⇀ C` (with locally
bounded `M + M ∘ ∂`) agree with `S_j` on `B_{ρ_j}(0)`, `ρ_j → ∞`.  Given a compact `K`, `ε > 0` and
a subsequence `ψ`, there are an open `W` with `K ⊆ W ⊆ {dist(·, K) < ε}` and a further subsequence
`φ'` with `limsup M_W(S_{ψ(φ'(i))}) ≤ M_W(S)` whenever `S` is integer multiplicity, `∂S = ∂C` and
`spt(S − C) ⊆ K`.

Put `f = dist(·, K)`, `W₀ = {f < ε/2}` and choose `G` with `{f ≤ ε} ⊆ B_{G/2}(0)`.  Flat
convergence gives `C − Ŝ_{ψ(j)} − S'_j = ∂R_j` with `M_{W₀}(R_j) + M_{W₀}(S'_j) → 0`, at most
`2⁻ⁱ` along `φ' = φ₁`.  Slicing `R_{φ₁(i)}` by `f` at a good level `t ∈ (0, ε/2)` gives
`∂(R_i⌞W) = (∂R_i)⌞W + P_i` for `W = {f < t}`, with `Σᵢ M_{W₀}(P_i) < ∞` and `μ_{S_i}{f = t} = 0`.
Then `Y_i = (S − C) + ∂(R_i⌞W)` is an integer multiplicity cycle supported in `{f ≤ t}`, and the
retraction comparison gives `M_{B_G}(S_i) ≤ (1 + η)ⁿ M_{B_G}(S_i + Y_i)`.  Split
`B_G = W ∪ {f = t} ∪ O'`, `O' = B_G ∩ {f > t}`: on `W`, `S_i + Y_i = S − S'_i`; on `O'`,
`S_i + Y_i = S_i`; and `μ_{S_i + Y_i}{f = t} ≤ M_{W₀}(P_i)` by subadditivity of the weights.  So
`M_W(S_i) ≤ (1 + η)ⁿ (M_W(S) + e_i) + ((1 + η)ⁿ − 1) c_G` with `e_i → 0`; let `i → ∞`, `η ↓ 0`. -/
theorem Submission.dtc_bc_local_comparison : ∀ (P m : ℕ) (Us As : ℕ → Set (Euclid P)) (Ss : (j : ℕ) → GeometricCurrentOn (Us j) (m + 1)) (Ŝ : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (C : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (ρ : ℕ → ℝ), m + 1 < P → (∀ j, IsOpen (Us j)) → (∀ j, IsMinimizingIn (Ss j) (As j)) → (∀ j, (Ss j).support ⊆ As j) → (∀ R : ℝ, ∃ c : ℝ≥0∞, c ≠ ∞ ∧ ∀ᶠ j in atTop, (Ss j).massOn (ball 0 R) ≤ c) → (∀ G : ℝ, 0 < G → ∃ πs : ℕ → Euclid P → Euclid P, (∀ᶠ j in atTop, ContDiffOn ℝ 1 (πs j) (ball 0 G) ∧ MapsTo (πs j) (ball 0 G) (As j) ∧ (∀ y ∈ As j ∩ ball 0 G, πs j y = y) ∧ ∀ y ∈ ball 0 G, ‖πs j y‖ ≤ 2 * ‖y‖) ∧ ∀ η : ℝ, 0 < η → ∀ᶠ j in atTop, ∀ y ∈ ball 0 G, ∀ z ∈ ball 0 G, ‖πs j y - πs j z‖ ≤ (1 + η) * ‖y - z‖) → IsIntegerMultiplicity C → (∀ j, IsIntegerMultiplicity (Ŝ j)) → (∀ W : Set (Euclid P), IsOpen W → Bornology.IsBounded W → ⨆ j, ((Ŝ j).massOn W + (Ŝ j).boundary.massOn W) < ∞) → WeaklyConvergesOn Ŝ C → Tendsto ρ atTop atTop → (∀ j, closedBall (0 : Euclid P) (ρ j) ⊆ Us j) → (∀ (j : ℕ) (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ ball 0 (ρ j) → Ŝ j ω = currentEval (Ss j) (ω : DifferentialForm (Euclid P) (m + 1))) → ∀ (K : Set (Euclid P)) (ε : ℝ), IsCompact K → 0 < ε → ∀ ψ : ℕ → ℕ, StrictMono ψ → ∃ W : Set (Euclid P), IsOpen W ∧ K ⊆ W ∧ W ⊆ thickening ε K ∧ ∃ φ' : ℕ → ℕ, StrictMono φ' ∧ ∀ S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity S → SameBoundary S C → (S - C).support ⊆ K → limsup (fun j => (Ss (ψ (φ' j))).massOn W) atTop ≤ S.massOn W := by
  intro P m Us As Ss Ŝ C ρ hmP hUs hmin hsptA hmass hπ hCim hŜim hsup hconv hρ hρU hŜS K ε hK hε
    ψ hψ
  -- Step 0: facts about integer multiplicity currents (parent proof, step 0)
  -- (G) differences and sums of integer multiplicity currents are integer multiplicity
  have hsub_im : ∀ (U : Set (Euclid P)) (A B : GeometricCurrentOn U (m + 1)), IsOpen U →
      IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B) :=
    fun U A B hU hA hB => Submission.cmc_imRep_locality_restrict_sub.2.2.1 P (m + 1) U A B hU hA hB
  have hadd_im : ∀ (U : Set (Euclid P)) (A B T : GeometricCurrentOn U (m + 1)), IsOpen U →
      IsIntegerMultiplicity A → IsIntegerMultiplicity B →
        (∀ ω : TestFormOn U (m + 1), T ω = A ω + B ω) → IsIntegerMultiplicity T := by
    intro U A B T hU hA hB h
    -- `T = A - ((B - B) - B)`
    have hT : T = A - ((B - B) - B) := GeometricCurrentOn.ext fun ω => by
      rw [h ω]
      show A ω + B ω = A ω - ((B ω - B ω) - B ω)
      ring
    rw [hT]
    exact hsub_im U _ _ hU hA (hsub_im U _ _ hU (hsub_im U _ _ hU hB hB) hB)
  -- `currentEval T ω = T(ω)` for `ω ∈ 𝒟ⁿ(U)`
  have hce : ∀ (U : Set (Euclid P)) (T : GeometricCurrentOn U (m + 1)) (ω : TestFormOn U (m + 1)),
      currentEval T (ω : DifferentialForm (Euclid P) (m + 1)) = T ω := by
    intro U T ω
    rw [currentEval, dite_eq_left ⟨ω.property.1, ω.property.2⟩]
  -- a current vanishing on the forms supported in `O` has no mass in `O`
  have hmass_zero : ∀ (U O : Set (Euclid P)) (T : GeometricCurrentOn U (m + 1)),
      (∀ ω : TestFormOn U (m + 1), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ O →
        T ω = 0) → T.massOn O = 0 := by
    intro U O T h
    refine le_antisymm (sSup_le ?_) zero_le
    rintro _ ⟨ω, hω, rfl⟩
    dsimp only
    rw [h ω hω.1, ENNReal.ofReal_zero]
  -- (F1), (F3): the weight vanishes on an open set on whose forms the current vanishes
  have hmeas_zero : ∀ (U O : Set (Euclid P)) (T : GeometricCurrentOn U (m + 1))
      (R : IMRep U (m + 1)), IsOpen U → IsOpen O → O ⊆ U → R.Represents T →
        (∀ ω : TestFormOn U (m + 1), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ O →
          T ω = 0) → R.measure O = 0 := by
    intro U O T R hU hO hOU hR h
    rw [← Submission.dtc_mass_eq_measure P (m + 1) U O T R hU hO hOU hR]
    exact hmass_zero U O T h
  -- `M_W(Z) ≤ M_W(X) + M_W(Y)` if `Z = X - Y` on the forms supported in `W`
  have hmass_sub : ∀ (U W : Set (Euclid P)) (Z : GeometricCurrentOn U (m + 1))
      (X Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)),
      (∀ ω : TestFormOn U (m + 1), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ W →
        Z ω = X (testFormOnInclusion (subset_univ U) (m + 1) ω) -
          Y (testFormOnInclusion (subset_univ U) (m + 1) ω)) →
        Z.massOn W ≤ X.massOn W + Y.massOn W := by
    intro U W Z X Y h
    refine sSup_le ?_
    rintro _ ⟨ω, hω, rfl⟩
    dsimp only
    -- `ω` and `-ω` are admissible for `M_W` in `ℝᴾ`
    set ω' := testFormOnInclusion (subset_univ U) (m + 1) ω
    have hω' : ω' ∈ massAdmissibleOn univ (m + 1) W := hω
    have hω'' : -ω' ∈ massAdmissibleOn univ (m + 1) W := by
      refine ⟨?_, fun x => ?_⟩
      · rw [Submodule.coe_neg, tsupport_neg]
        exact hω'.1
      · rw [Submodule.coe_neg, Pi.neg_apply, covectorEuclideanNorm_neg]
        exact hω'.2 x
    rw [h ω hω.1, sub_eq_add_neg, ← map_neg Y.toCurrent ω']
    exact ENNReal.ofReal_add_le.trans (add_le_add (X.le_massOn hω') (Y.le_massOn hω''))
  -- (F5) the restriction `R' = (M ∩ E, θ, ξ)` of `R = (M, θ, ξ)` agrees with `R` on forms
  -- supported in `E` and vanishes on forms supported off `E`
  have hrestr_eq : ∀ (k : ℕ) (R R' : IMRep (univ : Set (Euclid P)) k) (E : Set (Euclid P)),
      R'.carrier = R.carrier ∩ E → R'.mult = R.mult → R'.orient = R.orient →
        ∀ ω : DifferentialForm (Euclid P) k, tsupport ω ⊆ E → R'.action ω = R.action ω := by
    intro k R R' E hc hm ho ω hω
    rw [IMRep.action, IMRep.action, hc, hm, ho]
    symm
    refine setIntegral_eq_of_subset_of_forall_sdiff_eq_zero R.measurableSet_carrier
      inter_subset_left fun x hx => ?_
    have hxω : x ∉ tsupport ω := fun h => hx.2 ⟨hx.1, hω h⟩
    rw [image_eq_zero_of_notMem_tsupport hxω, map_zero, mul_zero]
  have hrestr_zero : ∀ (k : ℕ) (R R' : IMRep (univ : Set (Euclid P)) k) (E : Set (Euclid P)),
      R'.carrier = R.carrier ∩ E → R'.mult = R.mult → R'.orient = R.orient →
        ∀ ω : DifferentialForm (Euclid P) k, Disjoint (tsupport ω) E → R'.action ω = 0 := by
    intro k R R' E hc hm ho ω hω
    rw [IMRep.action]
    refine setIntegral_eq_zero_of_forall_eq_zero fun x hx => ?_
    rw [hc] at hx
    have hxω : x ∉ tsupport ω := fun h => Set.disjoint_left.mp hω h hx.2
    rw [image_eq_zero_of_notMem_tsupport hxω, map_zero, mul_zero]
  -- the algebra of step 8(e): `u + x ≤ l(b + x)`, `x ≤ c < ∞`, `l ≥ 1` give
  -- `u ≤ lb + (l - 1)c`
  have halg : ∀ (u b x c l : ℝ≥0∞), x ≤ c → c ≠ ∞ → 1 ≤ l → u + x ≤ l * (b + x) →
      u ≤ l * b + (l - 1) * c := by
    intro u b x c l hxc hc hl h
    have hx : x ≠ ∞ := ne_top_of_le_ne_top hc hxc
    have h1 : l * (b + x) = l * b + (l - 1) * x + x := by
      rw [mul_add, add_assoc]
      congr 1
      conv_lhs => rw [← tsub_add_cancel_of_le hl]
      rw [add_mul, one_mul]
    rw [h1] at h
    calc u ≤ l * b + (l - 1) * x := ENNReal.le_of_add_le_add_right hx h
      _ ≤ l * b + (l - 1) * c := by gcongr
  -- Step 1: if `K = ∅`, take `W = ∅` (all masses in `∅` vanish) and `φ' = id`
  rcases K.eq_empty_or_nonempty with rfl | hKne
  · refine ⟨∅, isOpen_empty, subset_rfl, empty_subset _, id, strictMono_id, fun S _ _ _ => ?_⟩
    have h0 : ∀ (U : Set (Euclid P)) (T : GeometricCurrentOn U (m + 1)), T.massOn ∅ = 0 := by
      intro U T
      refine hmass_zero U ∅ T fun ω hω => ?_
      have hω0 : ω = 0 := Subtype.ext (tsupport_eq_empty_iff.mp (subset_empty_iff.mp hω))
      rw [hω0]
      exact map_zero T.toCurrent
    simp only [h0, limsup_const, le_refl]
  -- Step 2: the `1`-Lipschitz cut-off `f = dist(·, K)` (whose sublevel sets `{f < s}` are the
  -- sets `W_α` of the book) and radii `r = ε/2 < ε`, `D`, `G = 2D` with `{f ≤ ε} ⊆ B_D(0)`
  obtain ⟨RK, hRK⟩ := hK.isBounded.subset_closedBall (0 : Euclid P)
  set D : ℝ := max RK 0 + ε + 1 with hD_def
  have hRK0 : 0 ≤ max RK 0 := le_max_right _ _
  have hD : 0 < D := by linarith
  set G : ℝ := 2 * D with hG_def
  have hG : 0 < G := by linarith
  have hDG : D ≤ G := by linarith
  have hG2 : G / 2 = D := by rw [hG_def]; ring
  set r : ℝ := ε / 2 with hr_def
  have hr : 0 < r := by linarith
  have hrε : r < ε := by linarith
  set f : Euclid P → ℝ := fun x => infDist x K
  have hf_cont : Continuous f := continuous_infDist_pt K
  have hf_lip : LipschitzWith 1 f := lipschitz_infDist_pt K
  have hfK : ∀ x ∈ K, f x = 0 := fun x hx => infDist_zero_of_mem hx
  have hf_ball : ∀ x, f x ≤ ε → x ∈ ball (0 : Euclid P) D := by
    intro x hx
    have hlt : infDist x K < ε + 1 := by
      have : f x = infDist x K := rfl
      linarith
    obtain ⟨y, hyK, hxy⟩ := (infDist_lt_iff hKne).1 hlt
    have hy : ‖y‖ ≤ max RK 0 := (mem_closedBall_zero_iff.1 (hRK hyK)).trans (le_max_left _ _)
    have htri := dist_triangle x y 0
    rw [dist_zero_right, dist_zero_right] at htri
    rw [mem_ball_zero_iff]
    linarith
  -- Step 3: the retractions `π_j` on `B_{2G}(0)` and the mass bound `c_G` on `B_G(0)`; (R1)–(R3)
  -- hold for all large `j`
  obtain ⟨πs, hπ_ev, hπ_lip⟩ := hπ (2 * G) (by linarith)
  obtain ⟨cG, hcG, hcG_ev⟩ := hmass G
  have hgood_ev := hπ_ev.and ((hρ.eventually_ge_atTop G).and hcG_ev)
  -- Step 4 (book (2)): flat convergence, `C - Ŝ_{ψ(j)} - S'_j = ∂R_j` with
  -- `M_{W₀}(R_j) + M_{W₀}(S'_j) → 0`, `W₀ = {f < r}`
  set W₀ : Set (Euclid P) := {x | f x < r}
  have hW₀_open : IsOpen W₀ := isOpen_lt hf_cont continuous_const
  have hW₀_ball : W₀ ⊆ ball (0 : Euclid P) D := fun x hx =>
    hf_ball x (le_of_lt (lt_trans hx hrε))
  have hW₀_bdd : Bornology.IsBounded W₀ := isBounded_ball.subset hW₀_ball
  obtain ⟨Rf, Sf, hRSf, ha⟩ := Submission.dtc_bc_lc_flat_decomposition P m (fun j => Ŝ (ψ j)) C
    hmP (fun j => hŜim (ψ j)) hCim
    (fun W hW hWb => lt_of_le_of_lt
      (iSup_le fun j => le_iSup (fun j => (Ŝ j).massOn W + (Ŝ j).boundary.massOn W) (ψ j))
      (hsup W hW hWb))
    (fun ω => (hconv ω).comp hψ.tendsto_atTop) W₀ hW₀_open hW₀_bdd
  -- Step 5 (book (3)–(5)): `φ₁` with (R1)–(R3) at `ψ(φ₁(i))` and
  -- `M_{W₀}(R_{φ₁(i)}) + M_{W₀}(S'_{φ₁(i)}) ≤ 2⁻ⁱ`
  have h2pos : ∀ i : ℕ, (0 : ℝ≥0∞) < 2⁻¹ ^ i := fun i =>
    ENNReal.pow_pos (ENNReal.inv_pos.2 (by simp : (2 : ℝ≥0∞) ≠ ∞)) i
  have hext := fun i : ℕ => (hψ.tendsto_atTop.eventually hgood_ev).and
    (((tendsto_order.1 ha).2 _ (h2pos i)).mono fun k hk => hk.le)
  obtain ⟨φ₁, hφ₁, hφ₁P⟩ := Filter.extraction_forall_of_eventually hext
  -- `∂R_j = C - Ŝ_{ψ(j)} - S'_j` is integer multiplicity
  have hbd_im : ∀ j, IsIntegerMultiplicity (Rf j).boundary := by
    intro j
    rw [← (hRSf j).2.2]
    exact hsub_im univ _ _ isOpen_univ (hsub_im univ _ _ isOpen_univ hCim (hŜim _)) (hRSf j).2.1
  choose RT hRT using fun i => (hRSf (φ₁ i)).1
  choose RB hRB using fun i => hbd_im (φ₁ i)
  choose RS hRS using fun i => (hmin (ψ (φ₁ i))).1
  -- the slices `P_i(t)` of `R_{φ₁(i)}` by `f`
  choose Ps hPs_mass hPs_ae using fun i =>
    Submission.dtc_bc_lc_slice P m (Rf (φ₁ i)) (RT i) (RB i) f 1 hmP (hRT i) (hRB i) hf_lip
  have hUi : ∀ i, closedBall (0 : Euclid P) G ⊆ Us (ψ (φ₁ i)) := fun i =>
    (closedBall_subset_closedBall (hφ₁P i).1.2.1).trans (hρU _)
  have hBi : ∀ i, ball (0 : Euclid P) G ⊆ Us (ψ (φ₁ i)) := fun i =>
    ball_subset_closedBall.trans (hUi i)
  -- `Σᵢ ∫_0^r M_{W₀}(P_i(t)) dt ≤ Σᵢ M_{W₀}(R_{φ₁(i)}) ≤ Σᵢ 2⁻ⁱ < ∞`
  have hsum : (∑' i, ∫⁻ t in Ioo 0 r, (Ps i t).massOn W₀) ≠ ∞ := by
    refine ne_top_of_le_ne_top (b := ∑' i : ℕ, (2⁻¹ : ℝ≥0∞) ^ i) ?_
      (ENNReal.tsum_le_tsum fun i => ?_)
    · rw [ENNReal.tsum_geometric, ENNReal.one_sub_inv_two, inv_inv]
      exact ENNReal.ofNat_ne_top
    · calc ∫⁻ t in Ioo 0 r, (Ps i t).massOn W₀ ≤ ∫⁻ t, (Ps i t).massOn W₀ :=
            setLIntegral_le_lintegral _ _
        _ ≤ ((1 : NNReal) : ℝ≥0∞) * (Rf (φ₁ i)).massOn W₀ := (hPs_mass i W₀ hW₀_open).2
        _ = (Rf (φ₁ i)).massOn W₀ := by rw [ENNReal.coe_one, one_mul]
        _ ≤ (Rf (φ₁ i)).massOn W₀ + (Sf (φ₁ i)).massOn W₀ := le_self_add
        _ ≤ 2⁻¹ ^ i := (hφ₁P i).2
  -- the weights of the `S_{ψ(φ₁(i))}` are finite on `{0 < f < r} ⊆ B_G(0)`, by (R3)
  have hfin : ∀ i, (RS i).measure {x | 0 < f x ∧ f x < r} ≠ ∞ := by
    intro i
    have h1 : (RS i).measure (ball 0 G) ≠ ∞ := by
      rw [← Submission.dtc_mass_eq_measure P (m + 1) _ _ (Ss (ψ (φ₁ i))) (RS i) (hUs _)
        isOpen_ball (hBi i) (hRS i)]
