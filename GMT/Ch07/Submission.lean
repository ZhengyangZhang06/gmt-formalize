        rw [norm_smul, Real.norm_eq_abs]
        exact mul_le_mul_of_nonneg_left ((ContinuousLinearMap.opNorm_comp_le _ _).trans
          (mul_le_mul (hMA _) hQI (norm_nonneg _) hMA0)) (abs_nonneg t)
