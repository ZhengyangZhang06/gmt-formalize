  clear hslab hGEN
  /- Step 10: difference quotients.  For `F` continuous with `|F| ≤ 1` and `s = 1/(2N)`,
  `∫_Q (ub - β) (F (· + s e) - F) / s` is the integral of `F` against the difference
  `w (· - s e) - w` of `w = (ub - β) 1_Q`, which is controlled by a translation estimate and the
  two boundary slabs. -/
  have hDQ : ∀ (i : Fin (m + 1)) (F : Euclid (m + 1) → ℝ), Continuous F → (∀ y, |F y| ≤ 1) →
      ∀ N : ℕ, 1 ≤ N →
      |∫ y in Q, (ub y - β) * ((2 * N : ℝ) *
        (F (y + (2 * N : ℝ)⁻¹ • EuclideanSpace.single i (1:ℝ)) - F y))|
        ≤ 10 * V + 4 * ∫ y in Q, |ub y - β| := by
    intro i F hFc hF1 N hN
    obtain ⟨e, he_def⟩ : ∃ e : Euclid (m + 1), e = EuclideanSpace.single i (1:ℝ) := ⟨_, rfl⟩
    have hce : ∀ (j : Fin (m + 1)) (x : Euclid (m + 1)) (t : ℝ),
        (x + t • e) j = if j = i then x j + t else x j := by
      subst he_def; exact fun j x t => hcoord i j x t
    have hne : ‖e‖ = 1 := by rw [he_def, PiLp.norm_single, norm_one]
    have hNpos : (0:ℝ) < N := Nat.cast_pos.2 hN
    obtain ⟨c, hc_def⟩ : ∃ c : ℝ, c = 2 * N := ⟨_, rfl⟩
    rw [← he_def, ← hc_def]
    have hc : 0 < c := hc_def ▸ mul_pos two_pos hNpos
    obtain ⟨s, hs_def⟩ : ∃ s : ℝ, s = c⁻¹ := ⟨_, rfl⟩
    rw [← hs_def]
    have hs : 0 < s := hs_def ▸ inv_pos.2 hc
    have hcs : c * s = 1 := hs_def ▸ mul_inv_cancel₀ hc.ne'
    have hsN : s < 1 / N := by
      rw [hs_def, hc_def, one_div]
      exact inv_strictAnti₀ hNpos (by linarith only [hNpos])
    have hcm : ∀ (j : Fin (m + 1)) (x : Euclid (m + 1)),
        (x - s • e) j = if j = i then x j - s else x j := by
      intro j x
      rw [sub_eq_add_neg, ← neg_smul, hce, ← sub_eq_add_neg]
    obtain ⟨wb, hwb_def⟩ : ∃ wb : Euclid (m + 1) → ℝ, wb = Q.indicator fun y => ub y - β :=
      ⟨_, rfl⟩
    have hwb_int : Integrable wb := hwb_def ▸
      (hub_int.integrableOn.sub (integrableOn_const hQfin)).integrable_indicator hQm
    have hFb : ∀ y, ‖F y‖ ≤ 1 := hF1
    have hi1 : Integrable fun y => wb y * F (y + s • e) :=
      hwb_int.mul_bdd (hFc.comp (continuous_id.add continuous_const)).aestronglyMeasurable
        (Filter.Eventually.of_forall fun y => hFb _)
    have hi2 : Integrable fun y => wb y * F y :=
      hwb_int.mul_bdd hFc.aestronglyMeasurable (Filter.Eventually.of_forall hFb)
    have hi3 : Integrable fun x => wb (x - s • e) * F x :=
      (hwb_int.comp_sub_right (s • e)).mul_bdd hFc.aestronglyMeasurable
        (Filter.Eventually.of_forall hFb)
    have e1 : ∫ y in Q, (ub y - β) * (c * (F (y + s • e) - F y)) =
        c * ∫ x, (wb (x - s • e) - wb x) * F x := by
      rw [← integral_indicator hQm]
      have : ∀ y, Q.indicator (fun y => (ub y - β) * (c * (F (y + s • e) - F y))) y =
          c * (wb y * F (y + s • e) - wb y * F y) := fun y => by
        rw [indicator_mul_left, ← hwb_def]; ring
      simp only [this]
      rw [integral_const_mul, integral_sub hi1 hi2,
        ← integral_sub_right_eq_self (fun y => wb y * F (y + s • e)) (s • e)]
      simp only [sub_add_cancel]
      rw [← integral_sub hi3 hi2]
      simp only [sub_mul]
    -- the pointwise bound: interior differences and the two boundary slabs
    obtain ⟨A, hA_def⟩ : ∃ A : Set (Euclid (m + 1)), A = (fun x => x + s • e) ⁻¹' Q ∩ Q :=
      ⟨_, rfl⟩
    obtain ⟨S0, hS0_def⟩ : ∃ S0 : Set (Euclid (m + 1)),
        S0 = {y : Euclid (m + 1) | y ∈ Q ∧ (0:ℝ) < y i ∧ y i < 0 + 1 / N} := ⟨_, rfl⟩
    obtain ⟨S1, hS1_def⟩ : ∃ S1 : Set (Euclid (m + 1)),
        S1 = {y : Euclid (m + 1) | y ∈ Q ∧ (1 - 1 / N : ℝ) < y i ∧ y i < (1 - 1 / N) + 1 / N} :=
      ⟨_, rfl⟩
    have hAm : MeasurableSet A := hA_def ▸ (hQm.preimage (measurable_add_const _)).inter hQm
    have hS0m : MeasurableSet S0 := hS0_def ▸ (hslabo i _ _).measurableSet
    have hS1m : MeasurableSet S1 := hS1_def ▸ (hslabo i _ _).measurableSet
    have hpt : ∀ x, |wb (x - s • e) - wb x| ≤
        A.indicator (fun z => |ub (z + s • e) - ub z|) (x - s • e) +
          S0.indicator (fun y => |ub y - β|) x +
          S1.indicator (fun y => |ub y - β|) (x - s • e) := by
      intro x
      have n1 := indicator_nonneg (fun z _ => abs_nonneg (ub (z + s • e) - ub z)) (x - s • e)
        (s := A)
      have n2 := indicator_nonneg (fun y _ => abs_nonneg (ub y - β)) x (s := S0)
      have n3 := indicator_nonneg (fun y _ => abs_nonneg (ub y - β)) (x - s • e) (s := S1)
      rw [hwb_def]
      by_cases hx : x ∈ Q <;> by_cases hxs : x - s • e ∈ Q
      · have hA : x - s • e ∈ A := by rw [hA_def]; exact ⟨by rwa [mem_preimage, sub_add_cancel], hxs⟩
        rw [indicator_of_mem hx, indicator_of_mem hxs, indicator_of_mem hA, sub_add_cancel,
          show ub (x - s • e) - (β:ℝ) - (ub x - β) = -(ub x - ub (x - s • e)) by ring, abs_neg]
        linarith only [n2, n3]
      · have hS0 : x ∈ S0 := by
          rw [hS0_def]
          refine ⟨hx, (hx i).1, ?_⟩
          by_contra hge
          rw [not_lt] at hge
          apply hxs
          intro j
          rw [hcm]
          split_ifs with hj
          · subst hj; constructor <;> linarith only [(hx j).2, hge, hsN, hs]
          · exact hx j
        rw [indicator_of_mem hx, indicator_of_notMem hxs, indicator_of_mem hS0, zero_sub, abs_neg]
        linarith only [n1, n3]
      · have hS1 : x - s • e ∈ S1 := by
          rw [hS1_def]
          refine ⟨hxs, ?_, ?_⟩
          · by_contra hle
            rw [not_lt, hcm, ite_eq_left rfl] at hle
            apply hx
            intro j
            have := hxs j
            rw [hcm] at this
            split_ifs at this with hj
            · subst hj; constructor <;> linarith only [this.1, hle, hsN, hs]
            · exact this
          · have := (hxs i).2; linarith only [this]
        rw [indicator_of_notMem hx, indicator_of_mem hxs, indicator_of_mem hS1, sub_zero]
        linarith only [n1, n2]
      · rw [indicator_of_notMem hx, indicator_of_notMem hxs, sub_zero, abs_zero]
        linarith only [n1, n2, n3]
    -- integrate the three terms
    have hg1 : Integrable fun z => |ub (z + s • e) - ub z| :=
      ((hub_int.comp_add_right _).sub hub_int).abs
    have hg2 : IntegrableOn (fun y => |ub y - β|) Q :=
      (hub_int.integrableOn.sub (integrableOn_const hQfin)).abs
    have hT1i : Integrable fun x => A.indicator (fun z => |ub (z + s • e) - ub z|) (x - s • e) :=
      (hg1.indicator hAm).comp_sub_right (s • e)
    have hT2i : Integrable (S0.indicator fun y => |ub y - β|) :=
      (hg2.mono_set (fun y hy => by rw [hS0_def] at hy; exact hy.1)).integrable_indicator hS0m
    have hT3i : Integrable fun x => S1.indicator (fun y => |ub y - β|) (x - s • e) :=
      ((hg2.mono_set (fun y hy => by rw [hS1_def] at hy; exact hy.1)).integrable_indicator
        hS1m).comp_sub_right (s • e)
    have hI1 : ∫ x, A.indicator (fun z => |ub (z + s • e) - ub z|) (x - s • e) ≤ 2 * (s * V) := by
      rw [integral_sub_right_eq_self (fun x => A.indicator (fun z => |ub (z + s • e) - ub z|) x)
        (s • e), integral_indicator hAm, hA_def]
      have := hTR (s • e)
      rwa [norm_smul, hne, mul_one, Real.norm_of_nonneg hs.le] at this
    have hI3 : ∫ x, S1.indicator (fun y => |ub y - β|) (x - s • e) = ∫ y in S1, |ub y - β| := by
      rw [integral_sub_right_eq_self (fun x => S1.indicator (fun y => |ub y - β|) x) (s • e),
        integral_indicator hS1m]
    have hb2 : (N:ℝ) * ∫ y in S0, |ub y - β| ≤ (∫ y in Q, |ub y - β|) + 2 * V := hS0_def ▸
      hstrip i N hN 0 le_rfl (by rw [zero_add, div_le_one hNpos]; exact Nat.one_le_cast.2 hN)
    have hb3 : (N:ℝ) * ∫ y in S1, |ub y - β| ≤ (∫ y in Q, |ub y - β|) + 2 * V := hS1_def ▸
      hstrip i N hN (1 - 1 / N) (by rw [sub_nonneg, div_le_one hNpos]; exact Nat.one_le_cast.2 hN)
        (by rw [sub_add_cancel])
    have hmain : ∫ x, |wb (x - s • e) - wb x| ≤
        2 * (s * V) + (∫ y in S0, |ub y - β|) + ∫ y in S1, |ub y - β| := by
      refine (integral_mono ((hwb_int.comp_sub_right _).sub hwb_int).abs
        ((hT1i.add hT2i).add hT3i) hpt).trans ?_
      rw [integral_add' (hT1i.add hT2i) hT3i, integral_add' hT1i hT2i, integral_indicator hS0m, hI3]
      linarith only [hI1]
    have hbound : |∫ x, (wb (x - s • e) - wb x) * F x| ≤ ∫ x, |wb (x - s • e) - wb x| := by
      rw [← Real.norm_eq_abs]
      refine norm_integral_le_of_norm_le ((hwb_int.comp_sub_right _).sub hwb_int).abs
        (Filter.Eventually.of_forall fun x => ?_)
      rw [Real.norm_eq_abs, abs_mul]
      exact mul_le_of_le_one_right (abs_nonneg _) (hF1 x)
    rw [e1, abs_mul, abs_of_pos hc]
    have h5 := mul_le_mul_of_nonneg_left (hbound.trans hmain) hc.le
    have h6 : c * (2 * (s * V) + (∫ y in S0, |ub y - β|) + ∫ y in S1, |ub y - β|) =
        2 * (c * s) * V + 2 * ((N:ℝ) * ∫ y in S0, |ub y - β|) +
          2 * ((N:ℝ) * ∫ y in S1, |ub y - β|) := by
      rw [hc_def]; ring
    rw [h6, hcs] at h5
    linarith only [h5, hb2, hb3]
  clear hstrip hslabo hcoord hTR
  /- Step 11: the boundary estimate (3): write `div G = ∑ᵢ ∂ᵢ Gᵢ` and pass to the limit in the
  difference quotients by dominated convergence. -/
  obtain ⟨I, hI_def⟩ : ∃ I : ℝ, I = ∫ y in Q, |ub y - β| := ⟨_, rfl⟩
  rw [← hI_def] at hDQ hP1
  have hwi : IntegrableOn (fun y => ub y - β) Q :=
    hub_int.integrableOn.sub (integrableOn_const hQfin)
  have h3 : ∀ G : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) G → (∀ y, ‖G y‖ ≤ 1) →
      |∫ y in Q, (ub y - β) * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G y)| ≤
        (m + 1) * (10 * V + 4 * I) := by
    intro G hG hG1
    have hG1' : ContDiff ℝ 1 G := hG.of_le (by exact_mod_cast le_top)
    have hdG : Continuous (fderiv ℝ G) := hG1'.continuous_fderiv one_ne_zero
    have hGd : ∀ y, HasFDerivAt G (fderiv ℝ G y) y := fun y =>
      (hG1'.differentiable one_ne_zero y).hasFDerivAt
    have hterm : ∀ i : Fin (m + 1),
        |∫ y in Q, (ub y - β) * (fderiv ℝ G y (EuclideanSpace.single i 1)) i| ≤
          10 * V + 4 * I := by
      intro i
      obtain ⟨e, he_def⟩ : ∃ e : Euclid (m + 1), e = EuclideanSpace.single i (1:ℝ) := ⟨_, rfl⟩
      rw [← he_def]
      have hne : ‖e‖ = 1 := by rw [he_def, PiLp.norm_single, norm_one]
      obtain ⟨Fi, hFi_def⟩ : ∃ Fi : Euclid (m + 1) → ℝ, Fi = fun y => G y i := ⟨_, rfl⟩
      have hFid : ∀ y, HasFDerivAt Fi ((EuclideanSpace.proj (𝕜 := ℝ) i).comp (fderiv ℝ G y)) y :=
        fun y => by
          rw [hFi_def]; exact (EuclideanSpace.proj (𝕜 := ℝ) i).hasFDerivAt.comp y (hGd y)
      have hFic : Continuous Fi := by
        rw [hFi_def]; exact (EuclideanSpace.proj i).continuous.comp hG.continuous
      have hFi1 : ∀ y, |Fi y| ≤ 1 := fun y => by
        rw [hFi_def, ← Real.norm_eq_abs]; exact (PiLp.norm_apply_le (G y) i).trans (hG1 y)
      have hdFc : Continuous fun y => (EuclideanSpace.proj (𝕜 := ℝ) i).comp (fderiv ℝ G y) :=
        continuous_const.clm_comp hdG
      obtain ⟨C, hC⟩ := (isCompact_closedBall (0 : Euclid (m + 1)) (R + 1)).exists_bound_of_continuousOn
        hdFc.continuousOn
      have hC' : ∀ y ∈ closedBall (0 : Euclid (m + 1)) (R + 1), ‖fderiv ℝ Fi y‖ ≤ C :=
        fun y hy => by rw [(hFid y).fderiv]; exact hC y hy
      have hmvt : ∀ y ∈ Q, ∀ t : ℝ, 0 < t → |Fi (y + t • e) - Fi y| ≤ C * t ∨ 1 < t := by
        intro y hy t ht0
        rcases le_or_gt t 1 with ht1 | ht1
        · left
          have hny := hnormQ y hy
          have hyK : y ∈ closedBall (0 : Euclid (m + 1)) (R + 1) := by
            rw [mem_closedBall, dist_zero_right]; linarith only [hny]
          have hyK' : y + t • e ∈ closedBall (0 : Euclid (m + 1)) (R + 1) := by
            rw [mem_closedBall, dist_zero_right]
            refine (norm_add_le _ _).trans ?_
            rw [norm_smul, hne, mul_one, Real.norm_of_nonneg ht0.le]
            linarith only [hny, ht1]
          have := (convex_closedBall (0 : Euclid (m + 1)) (R + 1)).norm_image_sub_le_of_norm_fderiv_le
            (fun z _ => (hFid z).differentiableAt) hC' hyK hyK'
          rwa [add_sub_cancel_left, norm_smul, hne, mul_one, Real.norm_of_nonneg ht0.le,
            Real.norm_eq_abs] at this
        · right; exact ht1
      obtain ⟨c, hc_def⟩ : ∃ c : ℕ → ℝ, c = fun N => 2 * ((N + 1 : ℕ) : ℝ) := ⟨_, rfl⟩
      have hcpos : ∀ N, 0 < c N := fun N => by
        rw [hc_def]; exact mul_pos two_pos (Nat.cast_pos.2 N.succ_pos)
      have hc1 : ∀ N, ¬ 1 < (c N)⁻¹ := fun N => by
        rw [not_lt, inv_le_one₀ (hcpos N), hc_def]
        have : (1:ℝ) ≤ ((N + 1 : ℕ) : ℝ) := Nat.one_le_cast.2 N.succ_pos
        linarith only [this]
      have hctend : Tendsto (fun N => ‖c N‖) atTop atTop := by
        have : (fun N => ‖c N‖) = fun N : ℕ => 2 * ((N + 1 : ℕ) : ℝ) := by
          funext N; rw [Real.norm_of_nonneg (hcpos N).le, hc_def]
        rw [this]
        exact Tendsto.const_mul_atTop two_pos
          (tendsto_natCast_atTop_atTop.comp (tendsto_add_atTop_nat 1))
      have hlim : Tendsto
          (fun N => ∫ y in Q, (ub y - β) * (c N * (Fi (y + (c N)⁻¹ • e) - Fi y)))
          atTop (𝓝 (∫ y in Q, (ub y - β) * (fderiv ℝ G y e) i)) := by
        refine tendsto_integral_of_dominated_convergence (fun y => |ub y - β| * C) (fun N => ?_)
          (hwi.abs.mul_const C) (fun N => ?_) ?_
        · exact (hub_meas.sub measurable_const).aestronglyMeasurable.mul
            (continuous_const.mul ((hFic.comp (continuous_id.add continuous_const)).sub
              hFic)).aestronglyMeasurable
        · refine (ae_restrict_iff' hQm).2 (Filter.Eventually.of_forall fun y hy => ?_)
          rw [Real.norm_eq_abs, abs_mul, abs_mul, abs_of_pos (hcpos N)]
          refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
          have := (hmvt y hy (c N)⁻¹ (inv_pos.2 (hcpos N))).resolve_right (hc1 N)
          calc c N * |Fi (y + (c N)⁻¹ • e) - Fi y| ≤ c N * (C * (c N)⁻¹) :=
                mul_le_mul_of_nonneg_left this (hcpos N).le
            _ = C := by rw [mul_comm C, ← mul_assoc, mul_inv_cancel₀ (hcpos N).ne', one_mul]
        · refine Filter.Eventually.of_forall fun y => ?_
          have := (hFid y).lim e hctend
          simp only [smul_eq_mul] at this
          exact this.const_mul _
      have hbd : ∀ N, |∫ y in Q, (ub y - β) * (c N * (Fi (y + (c N)⁻¹ • e) - Fi y))| ≤
          10 * V + 4 * I := fun N => by
        have := hDQ i Fi hFic hFi1 (N + 1) (by omega)
        rwa [← he_def, show (2 * ((N + 1 : ℕ) : ℝ)) = c N by rw [hc_def]] at this
      exact le_of_tendsto' ((continuous_abs.tendsto _).comp hlim) hbd
    have htr : ∀ y, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G y) =
        ∑ i, (fderiv ℝ G y (EuclideanSpace.single i 1)) i := by
      intro y
      rw [LinearMap.trace_eq_matrix_trace ℝ (EuclideanSpace.basisFun (Fin (m + 1)) ℝ).toBasis]
      simp [Matrix.trace, LinearMap.toMatrix_apply]
    have hint_i : ∀ i : Fin (m + 1), Integrable
        (fun y => (ub y - β) * (fderiv ℝ G y (EuclideanSpace.single i 1)) i) (volume.restrict Q) := by
      intro i
      have hcont : Continuous fun y => (fderiv ℝ G y (EuclideanSpace.single i 1)) i :=
        (EuclideanSpace.proj i).continuous.comp (hdG.clm_apply continuous_const)
      obtain ⟨C, hC⟩ := (isCompact_closedBall (0 : Euclid (m + 1)) R).exists_bound_of_continuousOn
        hcont.continuousOn
      refine hwi.mul_bdd hcont.aestronglyMeasurable ((ae_restrict_iff' hQm).2
        (Filter.Eventually.of_forall fun y hy => hC y ?_))
      rw [mem_closedBall, dist_zero_right]; exact hnormQ y hy
    calc |∫ y in Q, (ub y - β) * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G y)|
        = |∑ i, ∫ y in Q, (ub y - β) * (fderiv ℝ G y (EuclideanSpace.single i 1)) i| := by
          rw [← integral_finsetSum _ fun i _ => hint_i i]
          congr 2; funext y
          rw [htr y, Finset.mul_sum]
      _ ≤ ∑ i, |∫ y in Q, (ub y - β) * (fderiv ℝ G y (EuclideanSpace.single i 1)) i| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _i : Fin (m + 1), (10 * V + 4 * I) := Finset.sum_le_sum fun i _ => hterm i
      _ = (m + 1) * (10 * V + 4 * I) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, Nat.cast_add,
            Nat.cast_one]
  /- Conclusion. -/
  have hm0 : (0:ℝ) ≤ m + 1 := add_nonneg (Nat.cast_nonneg m) zero_le_one
  have hcV : CP * V ≤ (CP + (m + 1) * (10 + 4 * CP) + 1) * V := by
    refine mul_le_mul_of_nonneg_right ?_ hV0
    have := mul_nonneg hm0 (by linarith only [hCP] : (0:ℝ) ≤ 10 + 4 * CP)
    linarith only [this]
  refine ⟨β, ?_, hβM, ?_⟩
  · have : ∫ y in Q, |u y - β| = I := by
      rw [hI_def]; exact integral_congr_ae (by filter_upwards [hub_ae] with y hy; rw [hy])
    rw [this]; exact hP1.trans hcV
  · intro G hG hG1
    have : ∫ y in Q, (u y - β) * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G y) =
        ∫ y in Q, (ub y - β) * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G y) :=
      integral_congr_ae (by filter_upwards [hub_ae] with y hy; rw [hy])
    rw [this]
    refine (h3 G hG hG1).trans ?_
    have h1 : (m + 1) * (10 * V + 4 * I) ≤ (m + 1) * (10 * V + 4 * (CP * V)) :=
      mul_le_mul_of_nonneg_left (by linarith only [hP1]) hm0
    have h2 : (m + 1) * (10 * V + 4 * (CP * V)) = (m + 1) * (10 + 4 * CP) * V := by ring
    have h4 : (m + 1) * (10 + 4 * CP) * V ≤ (CP + (m + 1) * (10 + 4 * CP) + 1) * V :=
      mul_le_mul_of_nonneg_right (by linarith only [hCP]) hV0
    linarith only [h1, h2, h4]
/-- **Gauss–Green measure** (Simon Ch. 2, 2.1–2.2 and Ch. 3, 4.1, with the Riesz representation
Ch. 1, 4.14): if `φ ↦ ∫_F div φ` is bounded on smooth fields with `|φ| ≤ 1` supported in each
compact `K ⊆ D`, it is `φ ↦ -∫ ⟨φ, ν⟩ dμ` on `C¹` fields compactly supported in `D`, for a measure
`μ` carried by `D`, finite on its compact subsets, and a Borel unit field `ν`.  For each coordinate
`i`, `g ↦ ±∫_F div (g eᵢ)` has positive part `f ↦ sup {±∫_F div (g eᵢ) : g smooth, 0 ≤ g ≤ f}` on
`C_c(D, ℝ≥0)` (additive by smooth approximation under a continuous ceiling), represented by
Riesz–Markov–Kakutani on the open subspace `D`; the `2(m + 1)` measures are densities against their
sum (Lebesgue decomposition), the density field is normalized and the measure pushed forward to
`ℝ^{m+1}`; `C¹` fields are reached by mollification. -/
theorem Submission.codim1_rdo_dg_gauss_green_measure : ∀ (m : ℕ) (D F : Set (Euclid (m + 1))), IsOpen D → MeasurableSet F → (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → ∃ C : ℝ, ∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ → tsupport φ ⊆ K → (∀ y, ‖φ y‖ ≤ 1) → ∫ y in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ y : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) ≤ C) → ∃ (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)), μ Dᶜ = 0 ∧ (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μ K ≠ ∞) ∧ Measurable ν ∧ (∀ y, ‖ν y‖ = 1) ∧ ∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ y in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ y : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -∫ y, inner ℝ (φ y) (ν y) ∂μ := by
  intro m D F hD hF hbound
  classical
  -- the trace as a continuous linear functional and the functional `T φ = ∫_F div φ`
  obtain ⟨trc, htrc⟩ : ∃ trc : (Euclid (m + 1) →L[ℝ] Euclid (m + 1)) →L[ℝ] ℝ, ∀ A,
      trc A = LinearMap.trace ℝ (Euclid (m + 1)) (A : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) :=
    ⟨LinearMap.toContinuousLinearMap
      ((LinearMap.trace ℝ (Euclid (m + 1))).comp (ContinuousLinearMap.coeLM ℝ)), fun _ => rfl⟩
  obtain ⟨T, hT⟩ : ∃ T : (Euclid (m + 1) → Euclid (m + 1)) → ℝ,
      ∀ φ, T φ = ∫ y in F, trc (fderiv ℝ φ y) := ⟨_, fun _ => rfl⟩
  have hTeq : ∀ φ : Euclid (m + 1) → Euclid (m + 1), ∫ y in F, LinearMap.trace ℝ (Euclid (m + 1))
      (fderiv ℝ φ y : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = T φ := by
    intro φ
    rw [hT]
    simp only [htrc]
  have hbound' : ∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → ∃ C : ℝ,
      ∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ →
        tsupport φ ⊆ K → (∀ y, ‖φ y‖ ≤ 1) → T φ ≤ C := by
    intro K hK hKD
    obtain ⟨C, hC⟩ := hbound K hK hKD
    refine ⟨C, fun φ h1 h2 h3 h4 => ?_⟩
    rw [← hTeq φ]
    exact hC φ h1 h2 h3 h4
  suffices H : ∃ (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)),
      μ Dᶜ = 0 ∧ (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μ K ≠ ∞) ∧ Measurable ν ∧
      (∀ y, ‖ν y‖ = 1) ∧ ∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ →
        HasCompactSupport φ → tsupport φ ⊆ D → T φ = -∫ y, inner ℝ (φ y) (ν y) ∂μ by
    obtain ⟨μ, ν, h1, h2, h3, h4, h5⟩ := H
    exact ⟨μ, ν, h1, h2, h3, h4, fun φ hφ hφc hφD => (hTeq φ).trans (h5 φ hφ hφc hφD)⟩
  -- Step 1: `T` is linear on `C¹` compactly supported fields, and locally bounded
  have hdiv_int : ∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ →
      Integrable (fun y => trc (fderiv ℝ φ y)) (volume.restrict F) := fun φ hφ hc =>
    ((trc.continuous.comp (hφ.continuous_fderiv one_ne_zero)).integrable_of_hasCompactSupport
      ((hc.fderiv ℝ).comp_left trc.map_zero)).restrict
  have hT_add : ∀ φ ψ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ →
      ContDiff ℝ 1 ψ → HasCompactSupport ψ → T (φ + ψ) = T φ + T ψ := by
    intro φ ψ hφ hφc hψ hψc
    simp only [hT]
    rw [← integral_add (hdiv_int φ hφ hφc) (hdiv_int ψ hψ hψc)]
    congr 1; ext y
    rw [fderiv_add (hφ.differentiable one_ne_zero y) (hψ.differentiable one_ne_zero y), map_add]
  have hT_smul : ∀ (c : ℝ) (φ : Euclid (m + 1) → Euclid (m + 1)), ContDiff ℝ 1 φ →
      T (c • φ) = c * T φ := by
    intro c φ hφ
    simp only [hT]
    rw [← integral_const_mul]
    congr 1; ext y
    rw [fderiv_const_smul (hφ.differentiable one_ne_zero y),
      map_smul, smul_eq_mul]
  have hT0 : T 0 = 0 := by simp [hT]
  have hbd : ∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → ∃ C : ℝ, 0 ≤ C ∧
      ∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ →
        tsupport φ ⊆ K → ∀ M : ℝ, 0 ≤ M → (∀ y, ‖φ y‖ ≤ M) → |T φ| ≤ C * M := by
    intro K hK hKD
    obtain ⟨C, hC⟩ := hbound' K hK hKD
    have hC0 : 0 ≤ C := by
      simpa [hT0] using hC 0 contDiff_const HasCompactSupport.zero (by simp) (by simp)
    refine ⟨C, hC0, fun φ hφ hφc hφK M hM hφM => ?_⟩
    rcases hM.eq_or_lt with rfl | hMpos
    · have : φ = 0 := funext fun y => norm_le_zero_iff.1 (hφM y)
      simp [this, hT0]
    · have hsm : ContDiff ℝ (⊤ : ℕ∞) (M⁻¹ • φ) := contDiff_const.smul hφ
      have hsK : tsupport (M⁻¹ • φ) ⊆ K :=
        (tsupport_smul_subset_right (fun _ => M⁻¹) φ).trans hφK
      have hsn : ∀ y, ‖(M⁻¹ • φ) y‖ ≤ 1 := fun y => by
        rw [Pi.smul_apply, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hM)]
        calc M⁻¹ * ‖φ y‖ ≤ M⁻¹ * M := by gcongr; exact hφM y
          _ = 1 := inv_mul_cancel₀ hMpos.ne'
      have h1 := hC _ hsm (hφc.smul_left) hsK hsn
      have h2 := hC (-(M⁻¹ • φ)) hsm.neg (hφc.smul_left).neg (by rwa [tsupport_neg]) (fun y => by
        rw [Pi.neg_apply, norm_neg]; exact hsn y)
      rw [hT_smul _ _ (hφ.of_le (by exact_mod_cast le_top))] at h1
      rw [show -(M⁻¹ • φ) = (-M⁻¹) • φ by rw [neg_smul],
        hT_smul _ _ (hφ.of_le (by exact_mod_cast le_top))] at h2
      rw [abs_le]
      constructor
      · have := mul_le_mul_of_nonneg_left h2 hM
        rw [← mul_assoc, mul_neg, mul_inv_cancel₀ hMpos.ne'] at this
        linarith
      · have := mul_le_mul_of_nonneg_left h1 hM
        rw [← mul_assoc, mul_inv_cancel₀ hMpos.ne'] at this
        linarith
  -- compact subsets of `D` and compact supports on the subtype `D`
  have hsubK : ∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D →
      IsCompact (Subtype.val ⁻¹' K : Set D) := fun K hK hKD =>
    Subtype.isCompact_iff.2 (by rwa [Subtype.image_preimage_coe, inter_eq_right.2 hKD])
  have hcs : ∀ (h : Euclid (m + 1) → ℝ) (K : Set (Euclid (m + 1))), IsCompact K →
      support h ⊆ K → HasCompactSupport h ∧ tsupport h ⊆ K := fun h K hK hhK =>
    ⟨hK.of_isClosed_subset (isClosed_tsupport h) (closure_minimal hhK hK.isClosed),
      closure_minimal hhK hK.isClosed⟩
  -- smooth approximation of `a` under a continuous ceiling `u` (smooth partitions of unity)
  have happrox : ∀ (u a : Euclid (m + 1) → ℝ), Continuous u → Continuous a →
      (∀ z, 0 ≤ a z ∧ a z ≤ u z) → ∀ ε : ℝ, 0 < ε →
      ∃ a' : Euclid (m + 1) → ℝ, ContDiff ℝ (⊤ : ℕ∞) a' ∧
        ∀ z, 0 ≤ a' z ∧ a' z ≤ u z ∧ |a' z - a z| < ε := by
    intro u a hu ha hau ε hε
    have hloc : ∀ y : Euclid (m + 1), ∃ c : ℝ, ∀ᶠ z in 𝓝 y, c ∈ Icc 0 (u z) ∩ ball (a z) ε := by
      intro y
      refine ⟨max 0 (a y - ε / 2), ?_⟩
      have h1 : ∀ᶠ z in 𝓝 y, |a z - a y| < ε / 2 := by
        have := (ha.tendsto y).eventually (ball_mem_nhds (a y) (half_pos hε))
        filter_upwards [this] with z hz
        simpa [Real.dist_eq] using hz
      have h2 : ∀ᶠ z in 𝓝 y, max 0 (a y - ε / 2) ≤ u z := by
        by_cases hay : a y - ε / 2 ≤ 0
        · exact Eventually.of_forall fun z => by
            rw [max_eq_left hay]; exact (hau z).1.trans (hau z).2
        · rw [not_le] at hay
          have hlt : a y - ε / 2 < u y := by linarith [(hau y).2]
          have := (hu.tendsto y).eventually (lt_mem_nhds hlt)
          filter_upwards [this] with z hz
          rw [max_eq_right hay.le]; exact hz.le
      filter_upwards [h1, h2] with z hz1 hz2
      refine ⟨⟨le_max_left _ _, hz2⟩, ?_⟩
      rw [mem_ball, Real.dist_eq]
      have : |max 0 (a y - ε / 2) - a y| ≤ ε / 2 := by
        rcases le_total (a y - ε / 2) 0 with h | h
        · rw [max_eq_left h, zero_sub, abs_neg, abs_of_nonneg (hau y).1]; linarith
        · rw [max_eq_right h]; rw [show a y - ε / 2 - a y = -(ε / 2) by ring, abs_neg,
            abs_of_pos (half_pos hε)]
      calc |max 0 (a y - ε / 2) - a z| ≤ |max 0 (a y - ε / 2) - a y| + |a y - a z| :=
            abs_sub_le _ _ _
        _ < ε / 2 + ε / 2 := by
          have : |a y - a z| < ε / 2 := by rw [abs_sub_comm]; exact hz1
          linarith
        _ = ε := by ring
    obtain ⟨g, hg⟩ := exists_contMDiffMap_forall_mem_convex_of_local_const
      (modelWithCornersSelf ℝ (Euclid (m + 1))) (n := ⊤)
      (t := fun z => Icc 0 (u z) ∩ ball (a z) ε)
      (fun z => (convex_Icc _ _).inter (convex_ball _ _)) hloc
    refine ⟨g, contMDiff_iff_contDiff.1 g.contMDiff, fun z => ?_⟩
    have := hg z
    simp only [mem_inter_iff, mem_Icc, mem_ball, Real.dist_eq] at this
    exact ⟨this.1.1, this.1.2, this.2⟩
  -- Step 2: the positive part of a locally bounded functional, via Riesz–Markov–Kakutani on `D`
  have hpos : ∀ S : (Euclid (m + 1) → ℝ) → ℝ,
      (∀ g h : Euclid (m + 1) → ℝ, ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g →
        ContDiff ℝ (⊤ : ℕ∞) h → HasCompactSupport h → S (g + h) = S g + S h) →
      (∀ (c : ℝ) (g : Euclid (m + 1) → ℝ), ContDiff ℝ (⊤ : ℕ∞) g → S (c • g) = c * S g) →
      (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → ∃ C : ℝ, ∀ g : Euclid (m + 1) → ℝ,
        ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ K → ∀ M : ℝ, 0 ≤ M →
          (∀ y, |g y| ≤ M) → S g ≤ C * M) →
      ∃ μ : Measure D, IsFiniteMeasureOnCompacts μ ∧
        ∀ g : Euclid (m + 1) → ℝ, ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g →
          tsupport g ⊆ D → (∀ y, 0 ≤ g y) →
          BddAbove (S '' {h | ContDiff ℝ (⊤ : ℕ∞) h ∧ HasCompactSupport h ∧
            tsupport h ⊆ D ∧ ∀ y, 0 ≤ h y ∧ h y ≤ g y}) ∧
          ∫ x : D, g x ∂μ = sSup (S '' {h | ContDiff ℝ (⊤ : ℕ∞) h ∧ HasCompactSupport h ∧
            tsupport h ⊆ D ∧ ∀ y, 0 ≤ h y ∧ h y ≤ g y}) := by
    intro S hSadd hSsmul hSbd
    have hS0 : S 0 = 0 := by simpa using hSsmul 0 0 contDiff_const
    -- `A u`: smooth `h`, `0 ≤ h ≤ u`, compactly supported in `D`; the functional is `sup S(A u)`
    obtain ⟨A, hA⟩ : ∃ A : (Euclid (m + 1) → ℝ) → Set (Euclid (m + 1) → ℝ), ∀ u h, h ∈ A u ↔
        (ContDiff ℝ (⊤ : ℕ∞) h ∧ HasCompactSupport h ∧ tsupport h ⊆ D ∧
          ∀ y, 0 ≤ h y ∧ h y ≤ u y) :=
      ⟨fun u => {h | ContDiff ℝ (⊤ : ℕ∞) h ∧ HasCompactSupport h ∧ tsupport h ⊆ D ∧
        ∀ y, 0 ≤ h y ∧ h y ≤ u y}, fun _ _ => Iff.rfl⟩
    have hA0 : ∀ u : Euclid (m + 1) → ℝ, (∀ y, 0 ≤ u y) → (0 : Euclid (m + 1) → ℝ) ∈ A u :=
      fun u hu => (hA u 0).2 ⟨contDiff_const, HasCompactSupport.zero, by simp,
        fun y => ⟨le_rfl, hu y⟩⟩
    have hAsupp : ∀ u h, h ∈ A u → support h ⊆ support u := by
      intro u h hh y hy huy
      obtain ⟨-, -, -, h4⟩ := (hA u h).1 hh
      have := h4 y
      rw [huy] at this
      exact hy (le_antisymm this.2 this.1)
    have hbddA : ∀ u : Euclid (m + 1) → ℝ, Continuous u → (∀ y, 0 ≤ u y) →
        ∀ K, IsCompact K → K ⊆ D → support u ⊆ K → BddAbove (S '' A u) := by
      intro u hu hu0 K hK hKD huK
      obtain ⟨C, hC⟩ := hSbd K hK hKD
      obtain ⟨M, hM⟩ := hu.bounded_above_of_compact_support (hcs u K hK huK).1
      refine ⟨C * M, ?_⟩
      rintro _ ⟨h, hh, rfl⟩
      obtain ⟨h1, h2, -, h4⟩ := (hA u h).1 hh
      refine hC h h1 h2 (hcs h K hK ((hAsupp u h hh).trans huK)).2 M
        ((norm_nonneg _).trans (hM 0)) fun y => ?_
      rw [abs_of_nonneg (h4 y).1]
      exact (h4 y).2.trans ((le_abs_self _).trans (hM y))
    have hle_sup : ∀ u : Euclid (m + 1) → ℝ, Continuous u → (∀ y, 0 ≤ u y) →
        ∀ K, IsCompact K → K ⊆ D → support u ⊆ K → ∀ h ∈ A u, S h ≤ sSup (S '' A u) :=
      fun u hu hu0 K hK hKD huK h hh => le_csSup (hbddA u hu hu0 K hK hKD huK) ⟨h, hh, rfl⟩
    have hsup_le : ∀ u : Euclid (m + 1) → ℝ, (∀ y, 0 ≤ u y) → ∀ c : ℝ,
        (∀ h ∈ A u, S h ≤ c) → sSup (S '' A u) ≤ c := fun u hu c hc =>
      csSup_le ⟨S 0, 0, hA0 u hu, rfl⟩ (by rintro _ ⟨h, hh, rfl⟩; exact hc h hh)
    -- additivity
    have hadd : ∀ u₁ u₂ : Euclid (m + 1) → ℝ, Continuous u₁ → (∀ y, 0 ≤ u₁ y) →
        Continuous u₂ → (∀ y, 0 ≤ u₂ y) → ∀ K₁ K₂, IsCompact K₁ → K₁ ⊆ D → support u₁ ⊆ K₁ →
        IsCompact K₂ → K₂ ⊆ D → support u₂ ⊆ K₂ →
        sSup (S '' A (u₁ + u₂)) = sSup (S '' A u₁) + sSup (S '' A u₂) := by
      intro u₁ u₂ hu₁ hu₁0 hu₂ hu₂0 K₁ K₂ hK₁ hK₁D hu₁K hK₂ hK₂D hu₂K
      have hu0 : ∀ y, 0 ≤ (u₁ + u₂) y := fun y => add_nonneg (hu₁0 y) (hu₂0 y)
      have huK : support (u₁ + u₂) ⊆ K₁ ∪ K₂ := fun y hy => by
        by_contra hy'
        apply hy
        have hy1 : y ∉ K₁ := fun h => hy' (Or.inl h)
        have hy2 : y ∉ K₂ := fun h => hy' (Or.inr h)
        rw [Pi.add_apply, notMem_support.1 (fun h => hy1 (hu₁K h)),
          notMem_support.1 (fun h => hy2 (hu₂K h)), add_zero]
      have hKK : IsCompact (K₁ ∪ K₂) := hK₁.union hK₂
      have hKKD : K₁ ∪ K₂ ⊆ D := union_subset hK₁D hK₂D
      apply le_antisymm
      · apply hsup_le (u₁ + u₂) hu0
        intro g hg
        obtain ⟨hg1, hg2, hg3, hg4⟩ := (hA (u₁ + u₂) g).1 hg
        obtain ⟨C, hC⟩ := hSbd (K₁ ∪ K₂) hKK hKKD
        apply le_of_forall_pos_le_add
        intro ε hε
        obtain ⟨δ, hδ0, hCδ⟩ : ∃ δ : ℝ, 0 < δ ∧ C * (2 * δ) ≤ ε := by
          refine ⟨ε / (2 * (|C| + 1)), div_pos hε (by positivity), ?_⟩
          have hpos' : (0 : ℝ) < |C| + 1 := by positivity
          have : C * (2 * (ε / (2 * (|C| + 1)))) = C * ε / (|C| + 1) := by
            field_simp
          rw [this, div_le_iff₀ hpos', mul_comm ε]
          exact mul_le_mul_of_nonneg_right ((le_abs_self C).trans (le_add_of_nonneg_right
            zero_le_one)) hε.le
        have ha : Continuous fun y => min (g y) (u₁ y) := hg1.continuous.min hu₁
        obtain ⟨a', ha'1, ha'2⟩ := happrox u₁ (fun y => min (g y) (u₁ y)) hu₁ ha
          (fun z => ⟨le_min (hg4 z).1 (hu₁0 z), min_le_right _ _⟩) δ hδ0
        have hb : ∀ z, 0 ≤ g z - min (g z) (u₁ z) ∧ g z - min (g z) (u₁ z) ≤ u₂ z := by
          intro z
          refine ⟨sub_nonneg.2 (min_le_left _ _), ?_⟩
          have h' : g z ≤ u₁ z + u₂ z := (hg4 z).2
          rcases le_total (g z) (u₁ z) with h | h
          · rw [min_eq_left h, sub_self]; exact hu₂0 z
          · rw [min_eq_right h]; linarith
        obtain ⟨b', hb'1, hb'2⟩ := happrox u₂ (fun y => g y - min (g y) (u₁ y)) hu₂
          (hg1.continuous.sub ha) hb δ hδ0
        have ha'K : support a' ⊆ K₁ := fun y hy => hu₁K fun h => hy (by
          have := ha'2 y; rw [h] at this; exact le_antisymm this.2.1 this.1)
        have hb'K : support b' ⊆ K₂ := fun y hy => hu₂K fun h => hy (by
          have := hb'2 y; rw [h] at this; exact le_antisymm this.2.1 this.1)
        have hcsa' := hcs a' K₁ hK₁ ha'K
        have hcsb' := hcs b' K₂ hK₂ hb'K
        have ha'A : a' ∈ A u₁ := (hA u₁ a').2 ⟨ha'1, hcsa'.1, hcsa'.2.trans hK₁D,
          fun z => ⟨(ha'2 z).1, (ha'2 z).2.1⟩⟩
        have hb'A : b' ∈ A u₂ := (hA u₂ b').2 ⟨hb'1, hcsb'.1, hcsb'.2.trans hK₂D,
          fun z => ⟨(hb'2 z).1, (hb'2 z).2.1⟩⟩
        have hgK : support g ⊆ K₁ ∪ K₂ := (hAsupp (u₁ + u₂) g hg).trans huK
        have hrK : support (g - a' - b') ⊆ K₁ ∪ K₂ := fun y hy => by
          by_contra hy'
          apply hy
          have hy1 : y ∉ K₁ := fun h => hy' (Or.inl h)
          have hy2 : y ∉ K₂ := fun h => hy' (Or.inr h)
          rw [Pi.sub_apply, Pi.sub_apply, notMem_support.1 (fun h => hy' (hgK h)),
            notMem_support.1 (fun h => hy1 (ha'K h)), notMem_support.1 (fun h => hy2 (hb'K h)),
            sub_zero, sub_zero]
        have hrcs := hcs (g - a' - b') (K₁ ∪ K₂) hKK hrK
        have hr1 : ContDiff ℝ (⊤ : ℕ∞) (g - a' - b') := (hg1.sub ha'1).sub hb'1
        have hrb : ∀ y, |(g - a' - b') y| ≤ 2 * δ := fun y => by
          have h1 := (ha'2 y).2.2
          have h2 := (hb'2 y).2.2
          rw [Pi.sub_apply, Pi.sub_apply]
          have e : g y - a' y - b' y =
              -((a' y - min (g y) (u₁ y)) + (b' y - (g y - min (g y) (u₁ y)))) := by ring
          rw [e, abs_neg]
          calc |(a' y - min (g y) (u₁ y)) + (b' y - (g y - min (g y) (u₁ y)))|
              ≤ |a' y - min (g y) (u₁ y)| + |b' y - (g y - min (g y) (u₁ y))| :=
                abs_add_le _ _
            _ ≤ 2 * δ := by linarith
        have hSr := hC (g - a' - b') hr1 hrcs.1 hrcs.2 (2 * δ) (by positivity) hrb
        have hdec : S ((a' + b') + (g - a' - b')) = S a' + S b' + S (g - a' - b') := by
          rw [hSadd (a' + b') (g - a' - b') (ha'1.add hb'1) (hcsa'.1.add hcsb'.1) hr1 hrcs.1,
            hSadd a' b' ha'1 hcsa'.1 hb'1 hcsb'.1]
        rw [show (a' + b') + (g - a' - b') = g by abel] at hdec
        have h1 := hle_sup u₁ hu₁ hu₁0 K₁ hK₁ hK₁D hu₁K a' ha'A
        have h2 := hle_sup u₂ hu₂ hu₂0 K₂ hK₂ hK₂D hu₂K b' hb'A
        linarith
      · have key : ∀ h₁ ∈ A u₁, ∀ h₂ ∈ A u₂, S h₁ + S h₂ ≤ sSup (S '' A (u₁ + u₂)) := by
          intro h₁ hh₁ h₂ hh₂
          obtain ⟨a1, a2, a3, a4⟩ := (hA u₁ h₁).1 hh₁
          obtain ⟨b1, b2, b3, b4⟩ := (hA u₂ h₂).1 hh₂
          rw [← hSadd h₁ h₂ a1 a2 b1 b2]
          have hmem : h₁ + h₂ ∈ A (u₁ + u₂) := (hA (u₁ + u₂) (h₁ + h₂)).2 ⟨a1.add b1,
            a2.add b2, (tsupport_add h₁ h₂).trans (union_subset a3 b3),
            fun y => ⟨add_nonneg (a4 y).1 (b4 y).1, add_le_add (a4 y).2 (b4 y).2⟩⟩
          exact hle_sup (u₁ + u₂) (hu₁.add hu₂) hu0 (K₁ ∪ K₂) hKK hKKD huK (h₁ + h₂) hmem
        have : sSup (S '' A u₁) ≤ sSup (S '' A (u₁ + u₂)) - sSup (S '' A u₂) := by
          apply hsup_le u₁ hu₁0
          intro h₁ hh₁
          have : sSup (S '' A u₂) ≤ sSup (S '' A (u₁ + u₂)) - S h₁ := by
            apply hsup_le u₂ hu₂0
            intro h₂ hh₂
            have := key h₁ hh₁ h₂ hh₂
            linarith
          linarith
        linarith
    -- homogeneity
    have hsmul : ∀ u : Euclid (m + 1) → ℝ, Continuous u → (∀ y, 0 ≤ u y) →
        ∀ K, IsCompact K → K ⊆ D → support u ⊆ K → ∀ c : ℝ, 0 ≤ c →
        sSup (S '' A (c • u)) = c * sSup (S '' A u) := by
      intro u hu hu0 K hK hKD huK c hc
      have hcu0 : ∀ y, 0 ≤ (c • u) y := fun y => mul_nonneg hc (hu0 y)
      have hcuK : support (c • u) ⊆ K := (support_const_smul_subset c u).trans huK
      have hcuc : Continuous (c • u) := hu.const_smul c
      rcases hc.eq_or_lt with hc0 | hcpos
      · subst hc0
        rw [zero_mul]
        apply le_antisymm
        · apply hsup_le ((0 : ℝ) • u) hcu0
          intro h hh
          obtain ⟨-, -, -, h4⟩ := (hA ((0 : ℝ) • u) h).1 hh
          have : h = 0 := funext fun y => le_antisymm (by
            have := (h4 y).2
            rwa [Pi.smul_apply, zero_smul] at this) (h4 y).1
          rw [this, hS0]
        · have h0 := hle_sup ((0 : ℝ) • u) hcuc hcu0 K hK hKD hcuK 0 (hA0 ((0 : ℝ) • u) hcu0)
          rwa [hS0] at h0
      · apply le_antisymm
        · apply hsup_le (c • u) hcu0
          intro h hh
          obtain ⟨h1, h2, h3, h4⟩ := (hA (c • u) h).1 hh
          have hmem : c⁻¹ • h ∈ A u := (hA u (c⁻¹ • h)).2 ⟨contDiff_const.smul h1,
            HasCompactSupport.smul_left (f := fun _ => c⁻¹) h2,
            (tsupport_smul_subset_right (fun _ => c⁻¹) h).trans h3, fun y => ⟨by
              rw [Pi.smul_apply, smul_eq_mul]
              exact mul_nonneg (inv_nonneg.2 hc) (h4 y).1, by
                rw [Pi.smul_apply, smul_eq_mul, inv_mul_le_iff₀ hcpos]
                have := (h4 y).2
                rwa [Pi.smul_apply, smul_eq_mul] at this⟩⟩
          have := hle_sup u hu hu0 K hK hKD huK (c⁻¹ • h) hmem
          have e : S h = c * S (c⁻¹ • h) := by
            rw [hSsmul c⁻¹ h h1, ← mul_assoc, mul_inv_cancel₀ hcpos.ne', one_mul]
          rw [e]
          exact mul_le_mul_of_nonneg_left this hc
        · rw [← le_div_iff₀' hcpos]
          apply hsup_le u hu0
          intro h hh
          obtain ⟨h1, h2, h3, h4⟩ := (hA u h).1 hh
          have hmem : c • h ∈ A (c • u) := (hA (c • u) (c • h)).2 ⟨contDiff_const.smul h1,
            HasCompactSupport.smul_left (f := fun _ => c) h2,
            (tsupport_smul_subset_right (fun _ => c) h).trans h3, fun y => ⟨by
              rw [Pi.smul_apply, smul_eq_mul]
              exact mul_nonneg hc (h4 y).1, by
                rw [Pi.smul_apply, Pi.smul_apply, smul_eq_mul, smul_eq_mul]
                exact mul_le_mul_of_nonneg_left (h4 y).2 hc⟩⟩
          have := hle_sup (c • u) hcuc hcu0 K hK hKD hcuK (c • h) hmem
          rw [hSsmul c h h1] at this
          rw [le_div_iff₀' hcpos]
          exact this
    -- extension by zero of `f ∈ C_c(D, ℝ≥0)`; `f ↦ sup S(A (ext f))` is `ℝ≥0`-linear
    obtain ⟨ext, hext⟩ : ∃ ext : CompactlySupportedContinuousMap D NNReal →
        Euclid (m + 1) → ℝ, ∀ f y, ext f y = if h : y ∈ D then ((f ⟨y, h⟩ : NNReal) : ℝ) else 0 :=
      ⟨fun f y => if h : y ∈ D then ((f ⟨y, h⟩ : NNReal) : ℝ) else 0, fun _ _ => rfl⟩
    have hextK : ∀ f : CompactlySupportedContinuousMap D NNReal,
        IsCompact (Subtype.val '' tsupport f) ∧ Subtype.val '' tsupport f ⊆ D := fun f =>
      ⟨f.hasCompactSupport.image continuous_subtype_val, by rintro _ ⟨x, -, rfl⟩; exact x.2⟩
    have hext_supp : ∀ f : CompactlySupportedContinuousMap D NNReal,
        support (ext f) ⊆ Subtype.val '' tsupport f := by
      intro f y hy
      rw [mem_support, hext] at hy
      by_cases h : y ∈ D
      · rw [dite_eq_left h] at hy
        refine ⟨⟨y, h⟩, subset_tsupport _ ?_, rfl⟩
        intro h0
        apply hy
        rw [h0]
        rfl
      · rw [dite_eq_right h] at hy
        exact absurd rfl hy
    have hext_nonneg : ∀ f y, 0 ≤ ext f y := by
      intro f y
      rw [hext]
      split_ifs
      · exact NNReal.coe_nonneg _
      · exact le_rfl
    have hext_cont : ∀ f : CompactlySupportedContinuousMap D NNReal, Continuous (ext f) := by
      intro f
      rw [continuous_iff_continuousAt]
      intro y
      by_cases hy : y ∈ Subtype.val '' tsupport f
      · have hyD : y ∈ D := (hextK f).2 hy
        have hcont : ContinuousOn (ext f) D := by
          rw [continuousOn_iff_continuous_domRestrict]
          have : D.domRestrict (ext f) = fun x : D => ((f x : NNReal) : ℝ) := by
            funext x
            rw [Set.domRestrict_apply, hext, dite_eq_left x.2]
          rw [this]
          exact NNReal.continuous_coe.comp f.continuous
        exact hcont.continuousAt (hD.mem_nhds hyD)
      · have : ext f =ᶠ[𝓝 y] fun _ => 0 := by
          filter_upwards [(hextK f).1.isClosed.isOpen_compl.mem_nhds hy] with z hz
          by_contra hne
          exact hz (hext_supp f hne)
        exact continuousAt_const.congr this.symm
    have hext_add : ∀ f g : CompactlySupportedContinuousMap D NNReal,
        ext (f + g) = ext f + ext g := by
      intro f g
      funext y
      simp only [hext, Pi.add_apply]
      split_ifs
      · simp
      · simp
    have hext_smul : ∀ (c : NNReal) (f : CompactlySupportedContinuousMap D NNReal),
        ext (c • f) = (c : ℝ) • ext f := by
      intro c f
      funext y
      simp only [hext, Pi.smul_apply]
      split_ifs
      · simp
      · simp
    have hΛ0 : ∀ f : CompactlySupportedContinuousMap D NNReal, 0 ≤ sSup (S '' A (ext f)) :=
      fun f => by
        have := hle_sup (ext f) (hext_cont f) (hext_nonneg f) _ (hextK f).1 (hextK f).2
          (hext_supp f) 0 (hA0 _ (hext_nonneg f))
        rwa [hS0] at this
    let Λn : CompactlySupportedContinuousMap D NNReal →ₗ[NNReal] NNReal :=
      { toFun := fun f => ⟨sSup (S '' A (ext f)), hΛ0 f⟩
        map_add' := fun f g => by
          apply NNReal.eq
          change sSup (S '' A (ext (f + g))) = sSup (S '' A (ext f)) + sSup (S '' A (ext g))
          rw [hext_add]
          exact hadd _ _ (hext_cont f) (hext_nonneg f) (hext_cont g) (hext_nonneg g) _ _
            (hextK f).1 (hextK f).2 (hext_supp f) (hextK g).1 (hextK g).2 (hext_supp g)
        map_smul' := fun c f => by
          apply NNReal.eq
          change sSup (S '' A (ext (c • f))) = (c : ℝ) * sSup (S '' A (ext f))
          rw [hext_smul]
          exact hsmul _ (hext_cont f) (hext_nonneg f) _ (hextK f).1 (hextK f).2 (hext_supp f)
            c c.2 }
    have : LocallyCompactSpace D := hD.locallyCompactSpace
    refine ⟨RealRMK.rieszMeasure (CompactlySupportedContinuousMap.toRealPositiveLinear Λn),
      inferInstance, ?_⟩
    intro g hg hgc hgD hg0
    have hAg : A g = {h | ContDiff ℝ (⊤ : ℕ∞) h ∧ HasCompactSupport h ∧ tsupport h ⊆ D ∧
        ∀ y, 0 ≤ h y ∧ h y ≤ g y} := by
      ext h
      exact hA g h
    rw [← hAg]
    refine ⟨hbddA g hg.continuous hg0 (tsupport g) hgc hgD (subset_tsupport g), ?_⟩
    have hgcs : HasCompactSupport (fun x : D => Real.toNNReal (g x)) := by
      refine (hsubK _ hgc hgD).of_isClosed_subset (isClosed_tsupport _)
        (closure_minimal ?_ ((isClosed_tsupport g).preimage continuous_subtype_val))
      intro x hx
      apply subset_tsupport g
      intro h0
      apply hx
      simp [h0]
    let fg : CompactlySupportedContinuousMap D NNReal :=
      ⟨⟨fun x => Real.toNNReal (g x),
        continuous_real_toNNReal.comp (hg.continuous.comp continuous_subtype_val)⟩, hgcs⟩
    have hfg : ext fg = g := by
      funext y
      rw [hext]
      by_cases h : y ∈ D
      · rw [dite_eq_left h]
        exact Real.coe_toNNReal _ (hg0 y)
      · rw [dite_eq_right h]
        exact (image_eq_zero_of_notMem_tsupport (fun h' => h (hgD h'))).symm
    calc ∫ x : D, g x ∂(RealRMK.rieszMeasure
          (CompactlySupportedContinuousMap.toRealPositiveLinear Λn))
        = ∫ x : D, (CompactlySupportedContinuousMap.toReal fg) x ∂(RealRMK.rieszMeasure
          (CompactlySupportedContinuousMap.toRealPositiveLinear Λn)) := by
          congr 1
          funext x
          rw [CompactlySupportedContinuousMap.toReal_apply]
          exact (Real.coe_toNNReal _ (hg0 x)).symm
      _ = CompactlySupportedContinuousMap.toRealPositiveLinear Λn
          (CompactlySupportedContinuousMap.toReal fg) := RealRMK.integral_rieszMeasure _ _
      _ = (Λn fg : ℝ) := by rw [CompactlySupportedContinuousMap.eq_toRealPositiveLinear_toReal]
      _ = sSup (S '' A (ext fg)) := rfl
      _ = sSup (S '' A g) := by rw [hfg]
  -- Step 3: Jordan decomposition of a locally bounded functional on smooth functions
  have hcsD : ∀ f : Euclid (m + 1) → ℝ, HasCompactSupport f → tsupport f ⊆ D →
      HasCompactSupport (fun x : D => f x) := by
    intro f hfc hfD
    refine (hsubK _ hfc hfD).of_isClosed_subset (isClosed_tsupport _)
      (closure_minimal ?_ ((isClosed_tsupport f).preimage continuous_subtype_val))
    intro x hx
    exact subset_tsupport f hx
  have hintD : ∀ μ : Measure D, IsFiniteMeasureOnCompacts μ → ∀ f : Euclid (m + 1) → ℝ,
      Continuous f → HasCompactSupport f → tsupport f ⊆ D → Integrable (fun x : D => f x) μ := by
    intro μ hμ f hf hfc hfD
    exact (hf.comp continuous_subtype_val).integrable_of_hasCompactSupport (hcsD f hfc hfD)
  have hjordan : ∀ S : (Euclid (m + 1) → ℝ) → ℝ,
      (∀ g h : Euclid (m + 1) → ℝ, ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g →
        ContDiff ℝ (⊤ : ℕ∞) h → HasCompactSupport h → S (g + h) = S g + S h) →
      (∀ (c : ℝ) (g : Euclid (m + 1) → ℝ), ContDiff ℝ (⊤ : ℕ∞) g → S (c • g) = c * S g) →
      (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → ∃ C : ℝ, ∀ g : Euclid (m + 1) → ℝ,
        ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ K → ∀ M : ℝ, 0 ≤ M →
          (∀ y, |g y| ≤ M) → S g ≤ C * M) →
      ∃ μ₁ μ₂ : Measure D, IsFiniteMeasureOnCompacts μ₁ ∧ IsFiniteMeasureOnCompacts μ₂ ∧
        ∀ g : Euclid (m + 1) → ℝ, ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g →
          tsupport g ⊆ D → S g = ∫ x : D, g x ∂μ₁ - ∫ x : D, g x ∂μ₂ := by
    intro S hSadd hSsmul hSbd
    obtain ⟨μ₁, hμ₁, h₁⟩ := hpos S hSadd hSsmul hSbd
    have hSneg : ∀ g : Euclid (m + 1) → ℝ, ContDiff ℝ (⊤ : ℕ∞) g → S (-g) = -S g :=
      fun g hg => by
        rw [show -g = (-1 : ℝ) • g by rw [neg_one_smul], hSsmul (-1) g hg, neg_one_mul]
    obtain ⟨μ₂, hμ₂, h₂⟩ := hpos (fun g => -S g)
      (fun g h hg hgc hh hhc => by rw [hSadd g h hg hgc hh hhc, neg_add])
      (fun c g hg => by rw [hSsmul c g hg, mul_neg])
      (fun K hK hKD => by
        obtain ⟨C, hC⟩ := hSbd K hK hKD
        refine ⟨C, fun g hg hgc hgK M hM hgM => ?_⟩
        have := hC (-g) hg.neg hgc.neg (by rwa [tsupport_neg]) M hM
          (fun y => by rw [Pi.neg_apply, abs_neg]; exact hgM y)
        rwa [hSneg g hg] at this)
    refine ⟨μ₁, μ₂, hμ₁, hμ₂, ?_⟩
    have hnn : ∀ g : Euclid (m + 1) → ℝ, ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g →
        tsupport g ⊆ D → (∀ y, 0 ≤ g y) → S g = ∫ x : D, g x ∂μ₁ - ∫ x : D, g x ∂μ₂ := by
      intro g hg hgc hgD hg0
      obtain ⟨hb₁, he₁⟩ := h₁ g hg hgc hgD hg0
      obtain ⟨hb₂, he₂⟩ := h₂ g hg hgc hgD hg0
      rw [he₁, he₂]
      set Ag := {h : Euclid (m + 1) → ℝ | ContDiff ℝ (⊤ : ℕ∞) h ∧ HasCompactSupport h ∧
        tsupport h ⊆ D ∧ ∀ y, 0 ≤ h y ∧ h y ≤ g y} with hAg
      have hgA : g ∈ Ag := ⟨hg, hgc, hgD, fun y => ⟨hg0 y, le_rfl⟩⟩
      have hsubA : ∀ h ∈ Ag, g - h ∈ Ag := fun h hh =>
        ⟨hg.sub hh.1, hgc.sub hh.2.1, (tsupport_sub g h).trans (union_subset hgD hh.2.2.1),
          fun y => ⟨sub_nonneg.2 (hh.2.2.2 y).2, sub_le_self _ (hh.2.2.2 y).1⟩⟩
      have hdec : ∀ h ∈ Ag, S g = S (g - h) + S h := fun h hh => by
        rw [← hSadd (g - h) h (hg.sub hh.1) (hgc.sub hh.2.1) hh.1 hh.2.1, sub_add_cancel]
      have hne : Ag.Nonempty := ⟨g, hgA⟩
      have i1 : sSup ((fun g => -S g) '' Ag) ≤ sSup (S '' Ag) - S g := by
        apply csSup_le (hne.image _)
        rintro _ ⟨h, hh, rfl⟩
        have := le_csSup hb₁ ⟨g - h, hsubA h hh, rfl⟩
        have e := hdec h hh
        linarith
      have i2 : sSup (S '' Ag) ≤ S g + sSup ((fun g => -S g) '' Ag) := by
        apply csSup_le (hne.image _)
        rintro _ ⟨h, hh, rfl⟩
        have := le_csSup hb₂ ⟨g - h, hsubA h hh, rfl⟩
        have e := hdec h hh
        linarith
      linarith
    -- a general `g`: add `M χ`, with `|g| ≤ M` and a smooth cutoff `χ = 1` on `tsupport g`
    intro g hg hgc hgD
    obtain ⟨δ, hδ, hδD⟩ := IsCompact.exists_cthickening_subset_open hgc hD hgD
    obtain ⟨χ, hχ, hχr, hχs, hχ1⟩ := exists_contDiff_support_eq_eq_one_iff (n := ⊤)
      (isOpen_thickening (δ := δ) (E := tsupport g)) (isClosed_tsupport g)
      (self_subset_thickening hδ _)
    have hχK : support χ ⊆ cthickening δ (tsupport g) :=
      hχs ▸ thickening_subset_cthickening δ _
    have hχcs := hcs χ (cthickening δ (tsupport g)) (IsCompact.cthickening hgc) hχK
    obtain ⟨M, hM⟩ := hg.continuous.bounded_above_of_compact_support hgc
    have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
    have hχ01 : ∀ y, 0 ≤ χ y ∧ χ y ≤ 1 := fun y => hχr ⟨y, rfl⟩
    have hψ : ContDiff ℝ (⊤ : ℕ∞) (M • χ) := contDiff_const.smul hχ
    have hψcs : HasCompactSupport (M • χ) := HasCompactSupport.smul_left (f := fun _ => M) hχcs.1
    have hψD : tsupport (M • χ) ⊆ D :=
      (tsupport_smul_subset_right (fun _ => M) χ).trans (hχcs.2.trans hδD)
    have hψ0 : ∀ y, 0 ≤ (M • χ) y := fun y => by
      rw [Pi.smul_apply, smul_eq_mul]; exact mul_nonneg hM0 (hχ01 y).1
    have hgψ0 : ∀ y, 0 ≤ (g + M • χ) y := fun y => by
      by_cases hy : y ∈ tsupport g
      · rw [Pi.add_apply, Pi.smul_apply, smul_eq_mul, (hχ1 y).1 hy, mul_one]
        have := hM y
        rw [Real.norm_eq_abs] at this
        linarith [neg_abs_le (g y)]
      · rw [Pi.add_apply, image_eq_zero_of_notMem_tsupport hy, zero_add]; exact hψ0 y
    have e1 := hnn (g + M • χ) (hg.add hψ) (hgc.add hψcs)
      ((tsupport_add g (M • χ)).trans (union_subset hgD hψD)) hgψ0
    have e2 := hnn (M • χ) hψ hψcs hψD hψ0
    rw [hSadd g (M • χ) hg hgc hψ hψcs] at e1
    have i1 : ∀ μ : Measure D, IsFiniteMeasureOnCompacts μ →
        ∫ x : D, (g + M • χ) x ∂μ = ∫ x : D, g x ∂μ + ∫ x : D, (M • χ) x ∂μ := by
      intro μ hμ
      simp only [Pi.add_apply]
      exact integral_add (hintD μ hμ g hg.continuous hgc hgD)
        (hintD μ hμ (M • χ) hψ.continuous hψcs hψD)
    rw [i1 μ₁ hμ₁, i1 μ₂ hμ₂] at e1
    linarith
  -- Step 4: representation of `T` on smooth fields
  have hsm_rep : ∃ (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)),
      μ Dᶜ = 0 ∧ (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μ K ≠ ∞) ∧ Measurable ν ∧
      (∀ y, ‖ν y‖ = 1) ∧ ∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) φ →
        HasCompactSupport φ → tsupport φ ⊆ D → T φ = -∫ y, inner ℝ (φ y) (ν y) ∂μ := by
    -- the standard basis
    obtain ⟨b, hb⟩ : ∃ b : OrthonormalBasis (Fin (m + 1)) ℝ (Euclid (m + 1)),
        b = EuclideanSpace.basisFun (Fin (m + 1)) ℝ := ⟨_, rfl⟩
    have hb1 : ∀ i, ‖b i‖ = 1 := fun i => b.norm_eq_one i
    have hbinner : ∀ (x : Euclid (m + 1)) (i : Fin (m + 1)), inner ℝ x (b i) = x i := by
      intro x i; rw [hb]; exact EuclideanSpace.inner_basisFun_real _ x i
    have hbsum : ∀ x : Euclid (m + 1), ∑ i, x i • b i = x := by
      intro x; rw [hb]; exact (EuclideanSpace.basisFun (Fin (m + 1)) ℝ).sum_repr x
    -- coordinate functionals
    have hcomp : ∀ i : Fin (m + 1), ∃ μ₁ μ₂ : Measure D, IsFiniteMeasureOnCompacts μ₁ ∧
        IsFiniteMeasureOnCompacts μ₂ ∧ ∀ g : Euclid (m + 1) → ℝ, ContDiff ℝ (⊤ : ℕ∞) g →
          HasCompactSupport g → tsupport g ⊆ D →
          T (fun y => g y • b i) = ∫ x : D, g x ∂μ₁ - ∫ x : D, g x ∂μ₂ := by
      intro i
      have hsm : ∀ g : Euclid (m + 1) → ℝ, ContDiff ℝ (⊤ : ℕ∞) g →
          ContDiff ℝ (⊤ : ℕ∞) (fun y => g y • b i) := fun g hg => hg.smul contDiff_const
      have hcs1 : ∀ g : Euclid (m + 1) → ℝ, HasCompactSupport g →
          HasCompactSupport (fun y => g y • b i) := fun g hg =>
        hg.comp_left (g := fun r : ℝ => r • b i) (zero_smul ℝ (b i))
      apply hjordan (fun g => T (fun y => g y • b i))
      · intro g h hg hgc hh hhc
        have e : (fun y => (g + h) y • b i) = (fun y => g y • b i) + (fun y => h y • b i) := by
          funext y; rw [Pi.add_apply, Pi.add_apply, add_smul]
        change T (fun y => (g + h) y • b i) = T (fun y => g y • b i) + T (fun y => h y • b i)
        rw [e, hT_add _ _ ((hsm g hg).of_le (by exact_mod_cast le_top)) (hcs1 g hgc)
          ((hsm h hh).of_le (by exact_mod_cast le_top)) (hcs1 h hhc)]
      · intro c g hg
        have e : (fun y => (c • g) y • b i) = c • (fun y => g y • b i) := by
          funext y; rw [Pi.smul_apply, Pi.smul_apply, smul_eq_mul, mul_smul]
        change T (fun y => (c • g) y • b i) = c * T (fun y => g y • b i)
        rw [e, hT_smul c _ ((hsm g hg).of_le (by exact_mod_cast le_top))]
      · intro K hK hKD
        obtain ⟨C, -, hC⟩ := hbd K hK hKD
        refine ⟨C, fun g hg hgc hgK M hM hgM => ?_⟩
        have := hC (fun y => g y • b i) (hsm g hg) (hcs1 g hgc)
          ((tsupport_smul_subset_left g (fun _ => b i)).trans hgK) M hM (fun y => by
            rw [norm_smul, hb1 i, mul_one, Real.norm_eq_abs]; exact hgM y)
        exact (le_abs_self _).trans this
    choose μ₁ μ₂ hμ₁ hμ₂ hrep using hcomp
    -- coordinates of a field
    have hcoord_sm : ∀ (φ : Euclid (m + 1) → Euclid (m + 1)) (i : Fin (m + 1)),
        ContDiff ℝ (⊤ : ℕ∞) φ → ContDiff ℝ (⊤ : ℕ∞) (fun y => φ y i) := fun φ i hφ =>
      (EuclideanSpace.proj i : Euclid (m + 1) →L[ℝ] ℝ).contDiff.comp hφ
    have hcoord_cs : ∀ (φ : Euclid (m + 1) → Euclid (m + 1)) (i : Fin (m + 1)),
        HasCompactSupport φ → HasCompactSupport (fun y => φ y i) := fun φ i hφ =>
      hφ.comp_left (g := fun v : Euclid (m + 1) => v i) rfl
    have hcoord_ts : ∀ (φ : Euclid (m + 1) → Euclid (m + 1)) (i : Fin (m + 1)),
        tsupport (fun y => φ y i) ⊆ tsupport φ := fun φ i =>
      tsupport_comp_subset (g := fun v : Euclid (m + 1) => v i) rfl φ
    have hTdecomp : ∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) φ →
        HasCompactSupport φ → T φ = ∑ i, T (fun y => φ y i • b i) := by
      intro φ hφ hφc
      have key : ∀ s : Finset (Fin (m + 1)),
          ContDiff ℝ 1 (∑ i ∈ s, fun y => φ y i • b i) ∧
          HasCompactSupport (∑ i ∈ s, fun y => φ y i • b i) ∧
          T (∑ i ∈ s, fun y => φ y i • b i) = ∑ i ∈ s, T (fun y => φ y i • b i) := by
        intro s
        induction s using Finset.induction_on with
        | empty =>
          rw [Finset.sum_empty, Finset.sum_empty]
          exact ⟨contDiff_const, HasCompactSupport.zero, hT0⟩
        | insert j s hj ih =>
          rw [Finset.sum_insert hj, Finset.sum_insert hj]
          have h1 : ContDiff ℝ 1 (fun y => φ y j • b j) :=
            ((hcoord_sm φ j hφ).smul contDiff_const).of_le (by exact_mod_cast le_top)
          have h2 : HasCompactSupport (fun y => φ y j • b j) :=
            (hcoord_cs φ j hφc).comp_left (g := fun r : ℝ => r • b j) (zero_smul ℝ _)
          exact ⟨h1.add ih.1, h2.add ih.2.1, by rw [hT_add _ _ h1 h2 ih.1 ih.2.1, ih.2.2]⟩
      have hφeq : φ = ∑ i, fun y => φ y i • b i := by
        funext y
        rw [Finset.sum_apply]
        exact (hbsum (φ y)).symm
      conv_lhs => rw [hφeq]
      exact (key Finset.univ).2.2
    -- the dominating measure on `D`
    have : LocallyCompactSpace D := hD.locallyCompactSpace
    obtain ⟨μD, hμD⟩ : ∃ μD : Measure D, μD = ∑ i, (μ₁ i + μ₂ i) := ⟨_, rfl⟩
    have hμDK : ∀ K : Set D, IsCompact K → μD K < ∞ := by
      intro K hK
      rw [hμD, Measure.finsetSum_apply]
      refine ENNReal.sum_lt_top.2 fun i _ => ?_
      rw [Measure.add_apply]
      exact ENNReal.add_lt_top.2 ⟨(hμ₁ i).lt_top_of_isCompact hK, (hμ₂ i).lt_top_of_isCompact hK⟩
    have : IsFiniteMeasureOnCompacts μD := ⟨hμDK⟩
    have hRN : ∀ ν : Measure D, IsFiniteMeasureOnCompacts ν → ν ≤ μD →
        ∃ r : D → ℝ≥0∞, Measurable r ∧ (∀ᵐ x ∂μD, r x < ∞) ∧ ν = μD.withDensity r := by
      intro ν hν hle
      have := hν
      refine ⟨ν.rnDeriv μD, Measure.measurable_rnDeriv _ _, Measure.rnDeriv_lt_top _ _, ?_⟩
      have := Measure.haveLebesgueDecomposition_add ν μD
      rwa [Measure.singularPart_eq_zero_of_ac (Measure.absolutelyContinuous_of_le hle),
        zero_add] at this
    have hle₁ : ∀ i, μ₁ i ≤ μD := fun i => Measure.le_iff'.2 fun s => by
      rw [hμD, Measure.finsetSum_apply]
      refine le_trans ?_ (Finset.single_le_sum (f := fun j => (μ₁ j + μ₂ j) s)
        (fun j _ => zero_le) (Finset.mem_univ i))
      rw [Measure.add_apply]
      exact le_self_add
    have hle₂ : ∀ i, μ₂ i ≤ μD := fun i => Measure.le_iff'.2 fun s => by
      rw [hμD, Measure.finsetSum_apply]
      refine le_trans ?_ (Finset.single_le_sum (f := fun j => (μ₁ j + μ₂ j) s)
        (fun j _ => zero_le) (Finset.mem_univ i))
      rw [Measure.add_apply]
      exact le_add_self
    choose r₁ hr₁m hr₁lt hr₁ using fun i => hRN (μ₁ i) (hμ₁ i) (hle₁ i)
    choose r₂ hr₂m hr₂lt hr₂ using fun i => hRN (μ₂ i) (hμ₂ i) (hle₂ i)
    -- the density field `H`
    obtain ⟨c, hc⟩ : ∃ c : Fin (m + 1) → D → ℝ, ∀ i x, c i x = (r₁ i x).toReal - (r₂ i x).toReal :=
      ⟨fun i x => (r₁ i x).toReal - (r₂ i x).toReal, fun _ _ => rfl⟩
    have hcm : ∀ i, Measurable (c i) := fun i => by
      have : c i = fun x => (r₁ i x).toReal - (r₂ i x).toReal := funext (hc i)
      rw [this]
      exact (hr₁m i).ennreal_toReal.sub (hr₂m i).ennreal_toReal
    obtain ⟨H, hH⟩ : ∃ H : D → Euclid (m + 1), ∀ x, H x = ∑ i, c i x • b i :=
      ⟨fun x => ∑ i, c i x • b i, fun _ => rfl⟩
    have hHm : Measurable H := by
      have : H = fun x => ∑ i, c i x • b i := funext hH
      rw [this]
      exact Finset.measurable_sum _ fun i _ => (hcm i).smul_const (b i)
    have hrepD : ∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) φ →
        HasCompactSupport φ → tsupport φ ⊆ D → T φ = ∫ x : D, inner ℝ (φ x) (H x) ∂μD := by
      intro φ hφ hφc hφD
      rw [hTdecomp φ hφ hφc]
      have hterm : ∀ i, Integrable (fun x : D => c i x * φ x i) μD ∧
          T (fun y => φ y i • b i) = ∫ x : D, c i x * φ x i ∂μD := by
        intro i
        have hgi := hcoord_sm φ i hφ
        have hgc := hcoord_cs φ i hφc
        have hgD := (hcoord_ts φ i).trans hφD
        have I₁ := hintD (μ₁ i) (hμ₁ i) (fun y => φ y i) hgi.continuous hgc hgD
        have I₂ := hintD (μ₂ i) (hμ₂ i) (fun y => φ y i) hgi.continuous hgc hgD
        rw [hrep i (fun y => φ y i) hgi hgc hgD]
        rw [hr₁ i] at I₁ ⊢
        rw [hr₂ i] at I₂ ⊢
        have J₁ := (integrable_withDensity_iff_integrable_smul' (hr₁m i) (hr₁lt i)).1 I₁
        have J₂ := (integrable_withDensity_iff_integrable_smul' (hr₂m i) (hr₂lt i)).1 I₂
        rw [integral_withDensity_eq_integral_toReal_smul (hr₁m i) (hr₁lt i),
          integral_withDensity_eq_integral_toReal_smul (hr₂m i) (hr₂lt i), ← integral_sub J₁ J₂]
        have e : (fun x : D => c i x * φ x i) =
            fun x : D => (r₁ i x).toReal • φ x i - (r₂ i x).toReal • φ x i := by
          funext x
          rw [hc, smul_eq_mul, smul_eq_mul, sub_mul]
        rw [e]
        exact ⟨J₁.sub J₂, rfl⟩
      rw [Finset.sum_congr rfl fun i _ => (hterm i).2,
        ← integral_finsetSum _ fun i _ => (hterm i).1]
      congr 1
      funext x
      rw [hH, inner_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [real_inner_smul_right, hbinner]
    -- normalization to a unit field
    obtain ⟨ν', hν'⟩ : ∃ ν' : D → Euclid (m + 1), ∀ x,
        ν' x = if H x = 0 then b 0 else ‖H x‖⁻¹ • H x :=
      ⟨fun x => if H x = 0 then b 0 else ‖H x‖⁻¹ • H x, fun _ => rfl⟩
    have hν'm : Measurable ν' := by
      have : ν' = fun x => if H x = 0 then b 0 else ‖H x‖⁻¹ • H x := funext hν'
      rw [this]
      exact Measurable.ite (measurableSet_eq_fun hHm measurable_const) measurable_const
        (hHm.norm.inv.smul hHm)
    have hν'1 : ∀ x, ‖ν' x‖ = 1 := by
      intro x
      rw [hν']
      split_ifs with h
      · exact hb1 0
      · rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ (norm_ne_zero_iff.2 h)]
    have hHν : ∀ (v : Euclid (m + 1)) (x : D),
        (‖H x‖₊ : ℝ) • inner ℝ v (ν' x) = inner ℝ v (H x) := by
      intro v x
      rw [hν', coe_nnnorm, smul_eq_mul]
      split_ifs with h
      · rw [h, norm_zero, zero_mul, inner_zero_right]
      · rw [real_inner_smul_right, ← mul_assoc, mul_inv_cancel₀ (norm_ne_zero_iff.2 h), one_mul]
    obtain ⟨μ', hμ'⟩ : ∃ μ' : Measure D,
        μ' = μD.withDensity (fun x => ((‖H x‖₊ : NNReal) : ℝ≥0∞)) := ⟨_, rfl⟩
    have hμ'K : ∀ K : Set D, IsCompact K → μ' K < ∞ := by
      intro K hK
      have hKm : MeasurableSet K := hK.measurableSet
      have hlt : ∀ (r : D → ℝ≥0∞) (ν : Measure D), Measurable r → IsFiniteMeasureOnCompacts ν →
          ν = μD.withDensity r → IntegrableOn (fun x => (r x).toReal) K μD := by
        intro r ν hr hν hνr
        apply integrable_toReal_of_lintegral_ne_top hr.aemeasurable
        rw [← withDensity_apply _ hKm, ← hνr]
        exact (hν.lt_top_of_isCompact hK).ne
      have hci : ∀ i, IntegrableOn (c i) K μD := by
        intro i
        have : c i = fun x => (r₁ i x).toReal - (r₂ i x).toReal := funext (hc i)
        rw [this]
        exact (hlt _ _ (hr₁m i) (hμ₁ i) (hr₁ i)).sub (hlt _ _ (hr₂m i) (hμ₂ i) (hr₂ i))
      have hHK : IntegrableOn H K μD := by
        have : H = fun x => ∑ i, c i x • b i := funext hH
        rw [this]
        exact integrable_finsetSum _ fun i _ => (hci i).smul_const (b i)
      rw [hμ', withDensity_apply _ hKm]
      exact hHK.hasFiniteIntegral
    -- push forward to `ℝ^{m+1}`
    refine ⟨Measure.map Subtype.val μ', fun y => if hy : y ∈ D then -ν' ⟨y, hy⟩ else b 0,
      ?_, ?_, ?_, ?_, ?_⟩
    · rw [Measure.map_apply measurable_subtype_coe hD.measurableSet.compl]
      have : (Subtype.val ⁻¹' Dᶜ : Set D) = ∅ := by
        ext x
        simp only [mem_preimage, mem_compl_iff, mem_empty_iff_false, iff_false, not_not]
        exact x.2
      rw [this, measure_empty]
    · intro K hK hKD
      rw [Measure.map_apply measurable_subtype_coe hK.measurableSet]
      exact (hμ'K _ (hsubK K hK hKD)).ne
    · exact Measurable.dite hν'm.neg measurable_const hD.measurableSet
    · intro y
      by_cases hy : y ∈ D
      · show ‖(if hy : y ∈ D then -ν' ⟨y, hy⟩ else b 0)‖ = 1
        rw [dite_eq_left hy, norm_neg, hν'1]
      · show ‖(if hy : y ∈ D then -ν' ⟨y, hy⟩ else b 0)‖ = 1
        rw [dite_eq_right hy, hb1]
    · intro φ hφ hφc hφD
      rw [(MeasurableEmbedding.subtype_coe hD.measurableSet).integral_map]
      have e : (fun x : D => inner ℝ (φ x) ((fun y => if hy : y ∈ D then -ν' ⟨y, hy⟩ else b 0) x))
          = fun x : D => -inner ℝ (φ x) (ν' x) := by
        funext x
        show inner ℝ (φ x) (if hy : (x : Euclid (m + 1)) ∈ D then -ν' ⟨x, hy⟩ else b 0) =
          -inner ℝ (φ x) (ν' x)
        rw [dite_eq_left x.2, Subtype.coe_eta, inner_neg_right]
      rw [e, integral_neg, neg_neg, hrepD φ hφ hφc hφD, hμ',
        integral_withDensity_eq_integral_smul hHm.nnnorm]
      congr 1
      funext x
      rw [NNReal.smul_def]
      exact (hHν (φ x) x).symm
  obtain ⟨μ, ν, hμD, hμK, hνm, hν1, hsmooth⟩ := hsm_rep
  refine ⟨μ, ν, hμD, hμK, hνm, hν1, ?_⟩
  -- Step 5: `C¹` fields, by mollification
  -- normalized mollifiers
  have hmoll : ∀ r : ℝ, 0 < r → ∃ ρ : Euclid (m + 1) → ℝ, ContDiff ℝ (⊤ : ℕ∞) ρ ∧
      HasCompactSupport ρ ∧ (∀ x, 0 ≤ ρ x) ∧ ∫ x, ρ x = 1 ∧ support ρ ⊆ ball 0 r := by
    intro r hr
    let B : ContDiffBump (0 : Euclid (m + 1)) := ⟨r / 2, r, half_pos hr, half_lt_self hr⟩
    have hBs : HasCompactSupport B := B.hasCompactSupport
    have hBi : Integrable B := B.continuous.integrable_of_hasCompactSupport hBs
    have hI : 0 < ∫ x, B x := by
      rw [integral_pos_iff_support_of_nonneg (fun x => B.nonneg' x) hBi, B.support_eq]
      exact measure_ball_pos volume 0 hr
    refine ⟨fun x => (∫ y, B y)⁻¹ * B x, contDiff_const.mul B.contDiff, hBs.mul_left,
      fun x => mul_nonneg (inv_nonneg.2 hI.le) (B.nonneg' x), ?_, ?_⟩
    · rw [integral_const_mul, inv_mul_cancel₀ hI.ne']
    · exact (support_mul_subset_right _ _).trans B.support_eq.subset
  have hprec : ContinuousLinearMap.precompR (Euclid (m + 1))
      (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] Euclid (m + 1) →L[ℝ] Euclid (m + 1)) =
      (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] (Euclid (m + 1) →L[ℝ] Euclid (m + 1)) →L[ℝ]
        (Euclid (m + 1) →L[ℝ] Euclid (m + 1))) := by
    ext x A v
    simp [ContinuousLinearMap.precompR]
  intro φ hφ hφc hφD
  obtain ⟨δ, hδ, hδD⟩ := IsCompact.exists_cthickening_subset_open hφc hD hφD
  set K' := cthickening δ (tsupport φ) with hK'
  have hK'c : IsCompact K' := IsCompact.cthickening hφc
  have hK'm : MeasurableSet K' := isClosed_cthickening.measurableSet
  -- radii
  obtain ⟨rr, hrr0, hrrδ, hrrlim⟩ : ∃ rr : ℕ → ℝ, (∀ n, 0 < rr n) ∧ (∀ n, rr n ≤ δ) ∧
      Tendsto rr atTop (𝓝 0) := by
    refine ⟨fun n => δ / ((n : ℝ) + 1), fun n => div_pos hδ (by positivity), fun n => ?_, ?_⟩
    · exact div_le_self hδ.le (by
        have : (0 : ℝ) ≤ n := Nat.cast_nonneg n
        linarith)
    · exact tendsto_const_nhds.div_atTop
        (tendsto_atTop_add_const_right _ 1 tendsto_natCast_atTop_atTop)
  choose ρ hρs hρc hρ0 hρ1 hρsupp using fun n => hmoll (rr n) (hrr0 n)
  -- mollified fields
  obtain ⟨φn, hφn⟩ : ∃ φn : ℕ → Euclid (m + 1) → Euclid (m + 1),
      ∀ n, φn n = convolution (ρ n) φ (ContinuousLinearMap.lsmul ℝ ℝ) volume :=
    ⟨fun n => convolution (ρ n) φ (ContinuousLinearMap.lsmul ℝ ℝ) volume, fun _ => rfl⟩
  have hφn_sm : ∀ n, ContDiff ℝ (⊤ : ℕ∞) (φn n) := fun n => by
    rw [hφn]
    exact (hρc n).contDiff_convolution_left (ContinuousLinearMap.lsmul ℝ ℝ) (hρs n)
      hφ.continuous.locallyIntegrable
  have hφn_supp : ∀ n, support (φn n) ⊆ K' := fun n => by
    rw [hφn]
    refine (support_convolution_subset (ContinuousLinearMap.lsmul ℝ ℝ)).trans ?_
    refine (Set.add_subset_add (hρsupp n) (subset_tsupport φ)).trans ?_
    rw [ball_add_zero]
    exact (thickening_subset_cthickening _ _).trans (cthickening_mono (hrrδ n) _)
  have hφn_cs : ∀ n, HasCompactSupport (φn n) ∧ tsupport (φn n) ⊆ K' := fun n =>
    ⟨hK'c.of_isClosed_subset (isClosed_tsupport _) (closure_minimal (hφn_supp n) hK'c.isClosed),
      closure_minimal (hφn_supp n) hK'c.isClosed⟩
  -- bounds
  obtain ⟨Mφ, hMφ⟩ := hφ.continuous.bounded_above_of_compact_support hφc
  have hMφ0 : 0 ≤ Mφ := (norm_nonneg _).trans (hMφ 0)
  have hdφc : Continuous (fderiv ℝ φ) := hφ.continuous_fderiv one_ne_zero
  obtain ⟨M', hM'⟩ := hdφc.bounded_above_of_compact_support (hφc.fderiv ℝ)
  have hM'0 : 0 ≤ M' := (norm_nonneg _).trans (hM' 0)
  have hφn_bd : ∀ n y, ‖φn n y‖ ≤ Mφ := fun n y => by
    rw [hφn, ← dist_zero_right]
    exact dist_convolution_le hMφ0 (hρsupp n) (hρ0 n) (hρ1 n)
      hφ.continuous.aestronglyMeasurable (fun x _ => by rw [dist_zero_right]; exact hMφ x)
  have hsmall : Tendsto (fun n => support (ρ n)) atTop (𝓝 (0 : Euclid (m + 1))).smallSets := by
    rw [tendsto_smallSets_iff]
    intro t ht
    obtain ⟨ε, hε, hεt⟩ := Metric.mem_nhds_iff.1 ht
    filter_upwards [hrrlim.eventually (gt_mem_nhds hε)] with n hn
    exact (hρsupp n).trans ((ball_subset_ball hn.le).trans hεt)
  have hφn_lim : ∀ y, Tendsto (fun n => φn n y) atTop (𝓝 (φ y)) := fun y => by
    simp only [hφn]
    exact convolution_tendsto_right (Eventually.of_forall hρ0) (Eventually.of_forall hρ1) hsmall
      (Eventually.of_forall fun _ => hφ.continuous.aestronglyMeasurable)
      ((hφ.continuous.tendsto y).comp tendsto_snd) tendsto_const_nhds
  -- derivatives
  have hdφn : ∀ n y, fderiv ℝ (φn n) y =
      convolution (ρ n) (fderiv ℝ φ) (ContinuousLinearMap.lsmul ℝ ℝ) volume y := fun n y => by
    rw [hφn, ← hprec]
    exact (hφc.hasFDerivAt_convolution_right (ContinuousLinearMap.lsmul ℝ ℝ)
      (hρs n).continuous.locallyIntegrable hφ y).fderiv
  have hdφn_bd : ∀ n y, ‖fderiv ℝ (φn n) y‖ ≤ M' := fun n y => by
    rw [hdφn, ← dist_zero_right]
    exact dist_convolution_le hM'0 (hρsupp n) (hρ0 n) (hρ1 n)
      hdφc.aestronglyMeasurable (fun x _ => by rw [dist_zero_right]; exact hM' x)
  have hdφn_lim : ∀ y, Tendsto (fun n => fderiv ℝ (φn n) y) atTop (𝓝 (fderiv ℝ φ y)) :=
    fun y => by
      simp only [hdφn]
      exact convolution_tendsto_right (Eventually.of_forall hρ0) (Eventually.of_forall hρ1)
        hsmall (Eventually.of_forall fun _ => hdφc.aestronglyMeasurable)
        ((hdφc.tendsto y).comp tendsto_snd) tendsto_const_nhds
  -- convergence of the left side
  have hL : Tendsto (fun n => T (φn n)) atTop (𝓝 (T φ)) := by
    simp only [hT]
    refine tendsto_integral_of_dominated_convergence (K'.indicator fun _ => ‖trc‖ * M')
      (fun n => (trc.continuous.comp ((hφn_sm n).continuous_fderiv (by simp))).aestronglyMeasurable)
      ?_ (fun n => Eventually.of_forall fun y => ?_) (Eventually.of_forall fun y => ?_)
    · exact ((integrable_indicator_iff hK'm).2
        (integrableOn_const hK'c.measure_lt_top.ne)).restrict
    · by_cases hy : y ∈ K'
      · rw [indicator_of_mem hy]
        exact (trc.le_opNorm _).trans (mul_le_mul_of_nonneg_left (hdφn_bd n y) (norm_nonneg _))
      · rw [indicator_of_notMem hy]
        have : fderiv ℝ (φn n) y = 0 :=
          notMem_support.1 fun h => hy ((hφn_cs n).2 (support_fderiv_subset ℝ h))
        rw [this, map_zero, norm_zero]
    · exact (trc.continuous.tendsto _).comp (hdφn_lim y)
  -- convergence of the right side
  have hR : Tendsto (fun n => -∫ y, inner ℝ (φn n y) (ν y) ∂μ) atTop
      (𝓝 (-∫ y, inner ℝ (φ y) (ν y) ∂μ)) := by
    refine Tendsto.neg (tendsto_integral_of_dominated_convergence (K'.indicator fun _ => Mφ)
      (fun n => (Continuous.measurable2 continuous_inner (hφn_sm n).continuous.measurable
        hνm).aestronglyMeasurable) ?_ (fun n => Eventually.of_forall fun y => ?_)
      (Eventually.of_forall fun y => ?_))
    · exact (integrable_indicator_iff hK'm).2
        (integrableOn_const (hμK K' hK'c hδD))
    · by_cases hy : y ∈ K'
      · rw [indicator_of_mem hy]
        refine (norm_inner_le_norm _ _).trans ?_
        rw [hν1, mul_one]
        exact hφn_bd n y
      · rw [indicator_of_notMem hy]
        have : φn n y = 0 := notMem_support.1 fun h => hy (hφn_supp n h)
        rw [this, inner_zero_left, norm_zero]
    · exact (hφn_lim y).inner tendsto_const_nhds
  have hLR : (fun n => T (φn n)) = fun n => -∫ y, inner ℝ (φn n y) (ν y) ∂μ := by
    funext n
    exact hsmooth (φn n) (hφn_sm n) (hφn_cs n).1 ((hφn_cs n).2.trans hδD)
  rw [hLR] at hL
  exact tendsto_nhds_unique hL hR
/-- **Rescaled Gauss–Green identity** (Simon Ch. 3, proof of Theorem 4.3 (De Giorgi), the change
of variable `x → λₖ x` in (8), chapter-03.txt lines 661–665).  Suppose
`∫_F div φ dLᵐ⁺¹ = -∫ ⟨φ, ν⟩ dμ` for every `C¹` compactly supported `φ` with `tsupport φ ⊆ D`.
If `r > 0` and `g` is `C¹` with compact support and `y + r • tsupport g ⊆ D`, then with
`F_{y,r} = {w : y + r w ∈ F}`, `r⁻ᵐ ∫ ⟨g((z - y)/r), ν(z)⟩ dμ(z) = -∫_{F_{y,r}} div g dLᵐ⁺¹`:
`φ = g((· - y)/r)` is admissible with `div φ = r⁻¹ (div g)((· - y)/r)`, and the substitution
`z = y + r w` has Jacobian `rᵐ⁺¹`. -/
theorem Submission.codim1_rdo_dg_tma_rescaled_gauss_green : ∀ (m : ℕ) (D F : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)) (y : Euclid (m + 1)) (r : ℝ) (g : Euclid (m + 1) → Euclid (m + 1)), MeasurableSet F → (∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ z in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -∫ z, inner ℝ (φ z) (ν z) ∂μ) → 0 < r → ContDiff ℝ 1 g → HasCompactSupport g → (∀ w ∈ tsupport g, y + r • w ∈ D) → (r ^ m)⁻¹ * ∫ z, inner ℝ (g (r⁻¹ • (z - y))) (ν z) ∂μ = -∫ w in (fun w => y + r • w) ⁻¹' F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g w : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) := by
  intro m D F μ ν y r g hF hGG hr hg hgc hD
  set T : Euclid (m + 1) → ℝ := fun w =>
    LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g w : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1))
    with hTdef
  -- the affine homeomorphism `A w = y + r • w` and its inverse
  let A : Euclid (m + 1) ≃ₜ Euclid (m + 1) :=
    (Homeomorph.smulOfNeZero r hr.ne').trans (Homeomorph.addLeft y)
  have hA : ∀ w, A w = y + r • w := fun w => rfl
  have hAsymm : ∀ z, A.symm z = r⁻¹ • (z - y) := by
    intro z
    apply A.injective
    rw [A.apply_symm_apply, hA, smul_smul, mul_inv_cancel₀ hr.ne', one_smul]
    abel
  -- `φ = g ∘ A⁻¹` is admissible in the Gauss–Green identity
  set φ : Euclid (m + 1) → Euclid (m + 1) := fun z => g (r⁻¹ • (z - y)) with hφdef
  have hφA : φ = g ∘ A.symm := by
    funext z
    simp [hφdef, hAsymm]
  have hφ : ContDiff ℝ 1 φ := hg.comp (by fun_prop)
  have hφts : tsupport φ = A '' tsupport g := by
    rw [hφA, tsupport_comp_eq_preimage _ A.symm, A.preimage_symm]
  have hφc : HasCompactSupport φ := by
    rw [HasCompactSupport, hφts]
    exact hgc.isCompact.image A.continuous
  have hφD : tsupport φ ⊆ D := by
    rw [hφts]
    rintro _ ⟨w, hw, rfl⟩
    rw [hA]
    exact hD w hw
  -- chain rule: `div φ (z) = r⁻¹ (div g) (r⁻¹ • (z - y))`
  have hfd : ∀ z, fderiv ℝ φ z = r⁻¹ • fderiv ℝ g (r⁻¹ • (z - y)) := by
    intro z
    have hin : HasFDerivAt (fun z : Euclid (m + 1) => r⁻¹ • (z - y))
        (r⁻¹ • ContinuousLinearMap.id ℝ (Euclid (m + 1))) z :=
      ((hasFDerivAt_id (𝕜 := ℝ) z).sub_const y).const_smul (r⁻¹ : ℝ)
    have hgd := ((hg.differentiable one_ne_zero) (r⁻¹ • (z - y))).hasFDerivAt
    have h2 : HasFDerivAt φ ((fderiv ℝ g (r⁻¹ • (z - y))).comp
        (r⁻¹ • ContinuousLinearMap.id ℝ (Euclid (m + 1)))) z := hgd.comp z hin
    rw [h2.fderiv]
    ext x
    simp
  have htr : ∀ z, LinearMap.trace ℝ (Euclid (m + 1))
      (fderiv ℝ φ z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = r⁻¹ * T (r⁻¹ • (z - y)) := by
    intro z
    rw [hfd]
    simp [hTdef, map_smul]
  have hGG' := hGG φ hφ hφc hφD
  simp_rw [htr] at hGG'
  rw [integral_const_mul] at hGG'
  -- change of variables `z = y + r • w`
  have hcv : ∫ z in F, T (r⁻¹ • (z - y)) =
      r ^ (m + 1) * ∫ w in (fun w => y + r • w) ⁻¹' F, T w := by
    have hpre : MeasurableSet ((fun w => y + r • w) ⁻¹' F) := hF.preimage (by fun_prop)
    rw [← integral_indicator hF, ← integral_indicator hpre]
    set Ψ : Euclid (m + 1) → ℝ := F.indicator (fun z => T (r⁻¹ • (z - y))) with hΨ
    have h1 : (fun w => ((fun w => y + r • w) ⁻¹' F).indicator T w) =
        fun w => Ψ (r • w + y) := by
      funext w
      rw [add_comm (r • w) y]
      by_cases hw : y + r • w ∈ F
      · rw [indicator_of_mem (show w ∈ (fun w => y + r • w) ⁻¹' F from hw), hΨ,
          indicator_of_mem hw]
        simp [smul_smul, inv_mul_cancel₀ hr.ne']
      · rw [indicator_of_notMem (show w ∉ (fun w => y + r • w) ⁻¹' F from hw), hΨ,
          indicator_of_notMem hw]
    rw [h1, Measure.integral_comp_smul volume (fun x => Ψ (x + y)) r,
      integral_add_right_eq_self Ψ y]
    simp only [finrank_euclideanSpace, Fintype.card_fin, smul_eq_mul]
    rw [abs_of_pos (inv_pos.2 (pow_pos hr _))]
    field_simp
  rw [hcv] at hGG'
  -- `rᵐ ∫_{F_{y,r}} div g = -∫ ⟨g ((z - y) / r), ν⟩ dμ`; divide by `rᵐ`
  have hrm : (r ^ m) ≠ 0 := pow_ne_zero _ hr.ne'
  have key : ∫ z, inner ℝ (g (r⁻¹ • (z - y))) (ν z) ∂μ =
      -(r ^ m * ∫ w in (fun w => y + r • w) ⁻¹' F, T w) := by
    have : r⁻¹ * (r ^ (m + 1) * ∫ w in (fun w => y + r • w) ⁻¹' F, T w) =
        r ^ m * ∫ w in (fun w => y + r • w) ⁻¹' F, T w := by
      rw [pow_succ]
      field_simp
    rw [this] at hGG'
    linarith
  rw [key]
  field_simp
/-- **Hausdorff measure on a hyperplane** (Simon Ch. 3, proof of Theorem 4.3 (De Giorgi),
chapter-03.txt lines 734–746).  For `v ≠ 0` in `ℝ^{m+1}` the hyperplane `P_v = (span{v})ᗮ` has
dimension `m`, so an orthonormal basis of `P_v` indexed by `Fin m` gives a linear isometry
`ι : ℝ^m → ℝ^{m+1}` onto `P_v`; in particular `⟨ι x, v⟩ = 0`.  `μHE[m]` is isometry invariant
(`ι_# μHE[m] = μHE[m]⌞range ι`) and equals Lebesgue measure on `ℝ^m`, hence
`μHE[m]⌞P_v = ι_# Lᵐ`. -/
theorem Submission.codim1_rdo_dg_tma_hyperplane_param : ∀ (m : ℕ) (v : Euclid (m + 1)), v ≠ 0 → ∃ ι : Euclid m →ₗᵢ[ℝ] Euclid (m + 1), (∀ x, inner ℝ (ι x) v = 0) ∧ (μHE[m] : Measure (Euclid (m + 1))).restrict ((Submodule.span ℝ {v})ᗮ : Set (Euclid (m + 1))) = Measure.map ι volume := by
  intro m v hv
  set K : Submodule ℝ (Euclid (m + 1)) := (Submodule.span ℝ {v})ᗮ with hKdef
  -- `dim P_v = m`
  have : Fact (Module.finrank ℝ (Euclid (m + 1)) = m + 1) := ⟨by simp⟩
  have hK : Module.finrank ℝ K = m := Submodule.finrank_orthogonal_span_singleton hv
  -- `ι = (P_v ↪ ℝ^{m+1}) ∘ e`, `e : ℝ^m ≃ P_v` the inverse coordinates of an orthonormal basis
  let b : OrthonormalBasis (Fin m) ℝ K := (stdOrthonormalBasis ℝ K).reindex (finCongr hK)
  let e : Euclid m ≃ₗᵢ[ℝ] K := b.repr.symm
  let ι : Euclid m →ₗᵢ[ℝ] Euclid (m + 1) := K.subtypeₗᵢ.comp e.toLinearIsometry
  have hιK : ∀ x, ι x ∈ K := fun x => (e x).2
  refine ⟨ι, ?_, ?_⟩
  · intro x
    have h := hιK x
    rw [hKdef, Submodule.mem_orthogonal_singleton_iff_inner_right] at h
    rw [real_inner_comm]
    exact h
  · have hrange : Set.range ι = (K : Set (Euclid (m + 1))) := by
      ext z
      constructor
      · rintro ⟨x, rfl⟩
        exact hιK x
      · intro hz
        refine ⟨e.symm ⟨z, hz⟩, ?_⟩
        simp [ι]
    -- `ι_# Lᵐ = ι_# μHE[m] = μHE[m]⌞range ι`
    rw [← hrange, ← ι.isometry.map_euclideanHausdorffMeasure,
      EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
/-- **Simon Ch. 3, 4.3 (†)** (boundary-parallel directions): if `⟨u, v⟩ = 0` and `h` is `C¹` with
compact support, then `∫_H Dh(w)(u) dw = 0` on the half-space `H = {w : ⟨w, v⟩ > 0}`.  `H` is
invariant under `w ↦ w + t u`, so `Φ(t) = ∫_H h(w + t u) dw` is constant by translation
invariance of Lebesgue measure; differentiating under the integral sign at `t = 0` gives
`Φ'(0) = ∫_H Dh(w)(u) dw = 0`. -/
theorem Submission.codim1_rdo_dg_tma_tangential_halfspace : ∀ (P : ℕ) (v u : Euclid P) (h : Euclid P → ℝ), inner ℝ u v = 0 → ContDiff ℝ 1 h → HasCompactSupport h → ∫ w in {w : Euclid P | 0 < inner ℝ w v}, fderiv ℝ h w u = 0 := by
  intro P v u h huv hh hhc
  set H : Set (Euclid P) := {w | 0 < inner ℝ w v} with hHdef
  -- Step 1: `H` is open, hence measurable, and invariant under translation along `u`
  have hHmeas : MeasurableSet H :=
    (isOpen_lt continuous_const (continuous_id.inner continuous_const)).measurableSet
  have hHinv : ∀ (t : ℝ) (w : Euclid P), w + t • u ∈ H ↔ w ∈ H := by
    intro t w
    simp [hHdef, inner_add_left, real_inner_smul_left, huv]
  -- Step 2: `Φ(t) = ∫_H h(w + t u) dw` does not depend on `t`
  have hconst : ∀ t : ℝ, ∫ w in H, h (w + t • u) = ∫ w in H, h w := by
    intro t
    rw [← integral_indicator hHmeas, ← integral_indicator hHmeas]
    have hfun : (fun w => H.indicator (fun w => h (w + t • u)) w) =
        fun w => H.indicator h (w + t • u) := by
      funext w
      by_cases hw : w ∈ H
      · rw [indicator_of_mem hw, indicator_of_mem ((hHinv t w).2 hw)]
      · rw [indicator_of_notMem hw, indicator_of_notMem (fun h' => hw ((hHinv t w).1 h'))]
    rw [hfun, integral_add_right_eq_self (fun w => H.indicator h w) (t • u)]
  -- Step 3: `|Dh(w + t u)(u)| ≤ M‖u‖ 1_{B̄_{R+‖u‖}(0)}(w)` for `|t| < 1`
  obtain ⟨R, hR⟩ := hhc.isCompact.isBounded.subset_closedBall (0 : Euclid P)
  have hdc : Continuous (fderiv ℝ h) := hh.continuous_fderiv one_ne_zero
  obtain ⟨M, hM⟩ := hdc.bounded_above_of_compact_support (hhc.fderiv ℝ)
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  set bound : Euclid P → ℝ :=
    (closedBall (0 : Euclid P) (R + ‖u‖)).indicator (fun _ => M * ‖u‖) with hbound
  have hhd : Differentiable ℝ h := hh.differentiable one_ne_zero
  -- Step 4: differentiation under the integral sign at `t = 0`
  have key := hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := volume.restrict H) (F := fun (t : ℝ) w => h (w + t • u))
    (F' := fun (t : ℝ) w => fderiv ℝ h (w + t • u) u) (x₀ := (0 : ℝ)) (bound := bound)
    (ball_mem_nhds (0 : ℝ) one_pos)
    (Eventually.of_forall fun t => (hh.continuous.comp (by fun_prop)).aestronglyMeasurable)
    (by
      simp only [zero_smul, add_zero]
      exact (hh.continuous.integrable_of_hasCompactSupport hhc).integrableOn)
    ((hdc.clm_apply continuous_const).comp (by fun_prop)).aestronglyMeasurable
    (Eventually.of_forall fun w t ht => by
      by_cases hwt : w + t • u ∈ tsupport h
      · have h1 : ‖w + t • u‖ ≤ R := by simpa using hR hwt
        have ht1 : |t| < 1 := by simpa using ht
        have h2 : ‖w‖ ≤ R + ‖u‖ := by
          calc ‖w‖ = ‖(w + t • u) - t • u‖ := by simp
            _ ≤ ‖w + t • u‖ + ‖t • u‖ := norm_sub_le _ _
            _ ≤ R + ‖u‖ := by
                rw [norm_smul, Real.norm_eq_abs]
                nlinarith [abs_nonneg t, norm_nonneg u]
        rw [hbound, indicator_of_mem (by simpa using h2)]
        exact (ContinuousLinearMap.le_opNorm _ _).trans
          (mul_le_mul_of_nonneg_right (hM _) (norm_nonneg _))
      · have : fderiv ℝ h (w + t • u) = 0 := by
          by_contra hne
          exact hwt (support_fderiv_subset ℝ hne)
        rw [this, zero_apply, norm_zero]
        exact indicator_nonneg (fun _ _ => mul_nonneg hM0 (norm_nonneg _)) _)
    ((integrable_indicator_iff measurableSet_closedBall).2
      (integrableOn_const (measure_closedBall_lt_top).ne)).integrableOn
    (Eventually.of_forall fun w t _ => by
      have h1 : HasDerivAt (fun t : ℝ => w + t • u) u t := by
        simpa using ((hasDerivAt_id t).smul_const u).const_add w
      exact ((hhd (w + t • u)).hasFDerivAt.comp_hasDerivAt t h1))
  -- Step 5: `Φ` is constant, so `Φ'(0) = ∫_H Dh(w)(u) dw` vanishes
  have h0 : HasDerivAt (fun t : ℝ => ∫ w in H, h (w + t • u)) 0 0 := by
    have hfun : (fun t : ℝ => ∫ w in H, h (w + t • u)) = fun _ => ∫ w in H, h w :=
      funext hconst
    rw [hfun]
    exact hasDerivAt_const _ _
  have := key.2.unique h0
  simpa using this
/-- **Orthogonal Fubini: `(x, s) ↦ ι x + s v` preserves Lebesgue measure** (Simon Ch. 3, 4.3 (†),
step 2 of the proof).  Let `ι : ℝᵐ → ℝᵐ⁺¹` be a linear isometry and `v` a unit vector orthogonal
to its range.  The vectors `b_j = ι(e_j)` (`j < m`) and `b_m = v` are orthonormal, so they form an
orthonormal basis `B` of `ℝᵐ⁺¹`, and `B.repr⁻¹ : c ↦ Σⱼ cⱼ bⱼ` preserves Lebesgue measure.  The
coordinate map `S(x, s) = (x₀, …, x_{m-1}, s)` sends `Lᵐ ⊗ L¹` to `Lᵐ⁺¹` (`ofLp × id`, swap, the
inverse of `piFinSuccAbove` at the last index, `toLp`).  Finally `B.repr⁻¹ (S(x, s)) =
Σ_{j<m} xⱼ ι(eⱼ) + s v = ι x + s v`, so the map is the composition `B.repr⁻¹ ∘ S`. -/
theorem Submission.codim1_rdo_dg_tma_orthogonal_fubini : ∀ (m : ℕ) (ι : Euclid m →ₗᵢ[ℝ] Euclid (m + 1)) (v : Euclid (m + 1)), ‖v‖ = 1 → (∀ x, inner ℝ (ι x) v = 0) → MeasurePreserving (fun p : Euclid m × ℝ => ι p.1 + p.2 • v) volume volume := by
  intro m ι v hv hιv
  -- Step 1: the adapted orthonormal basis `(ι e₀, …, ι e_{m-1}, v)`
  let b : Fin (m + 1) → Euclid (m + 1) :=
    Fin.lastCases v (fun i => ι (EuclideanSpace.single i (1 : ℝ)))
  have hb_last : b (Fin.last m) = v := by simp [b]
  have hb_cs : ∀ i : Fin m, b (Fin.castSucc i) = ι (EuclideanSpace.single i (1 : ℝ)) := by
    intro i
    simp [b]
  have hb : Orthonormal ℝ b := by
    rw [orthonormal_iff_ite]
    intro i j
    induction i using Fin.lastCases with
    | last =>
      induction j using Fin.lastCases with
      | last => simp [hb_last, hv]
      | cast j =>
        rw [hb_last, hb_cs, real_inner_comm, hιv]
        simp only [Fin.ext_iff, Fin.val_last, Fin.val_castSucc]
        have := j.isLt
        simp
        omega
    | cast i =>
      induction j using Fin.lastCases with
      | last =>
        rw [hb_last, hb_cs, hιv]
        simp only [Fin.ext_iff, Fin.val_last, Fin.val_castSucc]
        have := i.isLt
        simp
        omega
      | cast j =>
        rw [hb_cs, hb_cs, LinearIsometry.inner_map_map, EuclideanSpace.inner_single_left]
        by_cases hij : i = j
        · subst hij
          simp
        · simp [hij, Fin.castSucc_inj]
  have hcard : Fintype.card (Fin (m + 1)) = Module.finrank ℝ (Euclid (m + 1)) := by simp
  have hsp : ⊤ ≤ Submodule.span ℝ (Set.range b) := by
    rw [← coe_basisOfOrthonormalOfCardEqFinrank hb hcard,
      (basisOfOrthonormalOfCardEqFinrank hb hcard).span_eq]
  let B : OrthonormalBasis (Fin (m + 1)) ℝ (Euclid (m + 1)) := OrthonormalBasis.mk hb hsp
  have hB : ∀ i, B i = b i := by
    intro i
    simp [B]
  -- Step 2: the coordinate map `S(x, s) = (x₀, …, x_{m-1}, s)` preserves Lebesgue measure
  let S : Euclid m × ℝ → EuclideanSpace ℝ (Fin (m + 1)) :=
    fun p => WithLp.toLp 2 (Fin.snoc (WithLp.ofLp p.1) p.2)
  have hS : MeasurePreserving S volume volume := by
    have h1 : MeasurePreserving (fun p : Euclid m × ℝ => (WithLp.ofLp p.1, p.2))
        ((volume : Measure (Euclid m)).prod (volume : Measure ℝ))
        ((volume : Measure (Fin m → ℝ)).prod (volume : Measure ℝ)) :=
      (PiLp.volume_preserving_ofLp (Fin m)).prod (MeasurePreserving.id volume)
    have h2 : MeasurePreserving (Prod.swap : (Fin m → ℝ) × ℝ → ℝ × (Fin m → ℝ))
        ((volume : Measure (Fin m → ℝ)).prod (volume : Measure ℝ))
        ((volume : Measure ℝ).prod (volume : Measure (Fin m → ℝ))) :=
      Measure.measurePreserving_swap
    have h3 := (volume_preserving_piFinSuccAbove (fun _ : Fin (m + 1) => ℝ) (Fin.last m)).symm
    have h4 := PiLp.volume_preserving_toLp (Fin (m + 1))
    have := h4.comp (h3.comp (h2.comp h1))
    convert this using 1
    funext p
    simp [S, MeasurableEquiv.piFinSuccAbove]
    rfl
  -- Step 3: `B.repr⁻¹` preserves Lebesgue measure and `B.repr⁻¹ ∘ S = (x, s) ↦ ι x + s v`
  have hΦ : MeasurePreserving (B.repr.symm : EuclideanSpace ℝ (Fin (m + 1)) → Euclid (m + 1))
      volume volume := B.measurePreserving_repr_symm
  have := hΦ.comp hS
  convert this using 1
  funext p
  simp only [comp_apply, S]
  rw [← OrthonormalBasis.sum_repr_symm, Fin.sum_univ_castSucc]
  simp only [hB, hb_last, hb_cs, Fin.snoc_castSucc, Fin.snoc_last]
  congr 1
  conv_lhs => rw [← (EuclideanSpace.basisFun (Fin m) ℝ).sum_repr p.1]
  simp [map_sum, map_smul]
/-- **Normal derivative over a half-space** (Simon Ch. 3, proof of Theorem 4.3, p. 82: the
integration `∫_{ℝⁿ} ∫_H ∂_{n+1} φ(x′, x^{n+1}) dx^{n+1} dx′` in the normal variable).  If
`ι : ℝ^m → ℝ^{m+1}` is a linear isometry, `v` is a unit vector normal to its range and `h` is `C¹`
with compact support, then `∫_{⟨w, v⟩ > 0} Dh(w)(v) dw = -∫_{ℝ^m} h(ι x) dx`.  The coordinates
`Θ(x, s) = ι x + s v` preserve Lebesgue measure (`codim1_rdo_dg_tma_orthogonal_fubini`) and satisfy
`⟨Θ(x, s), v⟩ = s`, so Fubini turns the left side into `∫ dx ∫_{s > 0} ∂ₛ h(ι x + s v) ds`; the
fundamental theorem of calculus on `(0, ∞)` for the compactly supported `C¹` function
`s ↦ h(ι x + s v)` gives `-h(ι x)`. -/
theorem Submission.codim1_rdo_dg_tma_normal_halfspace : ∀ (m : ℕ) (ι : Euclid m →ₗᵢ[ℝ] Euclid (m + 1)) (v : Euclid (m + 1)) (h : Euclid (m + 1) → ℝ), ‖v‖ = 1 → (∀ x, inner ℝ (ι x) v = 0) → ContDiff ℝ 1 h → HasCompactSupport h → ∫ w in {w : Euclid (m + 1) | 0 < inner ℝ w v}, fderiv ℝ h w v = -∫ x, h (ι x) := by
  intro m ι v h hv hιv hh hhc
  -- `Θ(x, s) = ι x + s v` is measure preserving, and `⟨Θ(x, s), v⟩ = s`
  have hMP := Submission.codim1_rdo_dg_tma_orthogonal_fubini m ι v hv hιv
  set Θ : Euclid m × ℝ → Euclid (m + 1) := fun p => ι p.1 + p.2 • v with hΘdef
  set H : Set (Euclid (m + 1)) := {w | 0 < inner ℝ w v} with hHdef
  have hHmeas : MeasurableSet H :=
    (isOpen_lt continuous_const (continuous_id.inner continuous_const)).measurableSet
  have hΘv : ∀ p, inner ℝ (Θ p) v = p.2 := by
    intro p
    simp [hΘdef, inner_add_left, real_inner_smul_left, hιv, hv]
  -- the integrand `G = 1_H · Dh(·)(v)` is integrable
  set G : Euclid (m + 1) → ℝ := H.indicator (fun w => fderiv ℝ h w v) with hGdef
  have hdc : Continuous (fun w => fderiv ℝ h w v) :=
    (hh.continuous_fderiv one_ne_zero).clm_apply continuous_const
  have hGint : Integrable G :=
    (hdc.integrable_of_hasCompactSupport (hhc.fderiv_apply ℝ v)).indicator hHmeas
  -- change of variables `w = Θ(x, s)` and Fubini
  rw [← integral_indicator hHmeas]
  change ∫ w, G w = _
  have hGae : AEStronglyMeasurable G (Measure.map Θ volume) := by
    rw [hMP.map_eq]
    exact hGint.aestronglyMeasurable
  rw [← hMP.map_eq, integral_map hMP.measurable.aemeasurable hGae]
  have hGΘint : Integrable (fun p => G (Θ p)) ((volume : Measure (Euclid m)).prod volume) :=
    (integrable_map_measure hGae hMP.measurable.aemeasurable).1 (by rwa [hMP.map_eq])
  rw [Measure.volume_eq_prod, integral_prod _ hGΘint, ← integral_neg]
  refine integral_congr_ae (Eventually.of_forall fun x => ?_)
  show ∫ s, G (Θ (x, s)) = -h (ι x)
  -- for fixed `x`, the fundamental theorem of calculus for `k(s) = h(ι x + s v)` on `(0, ∞)`
  set k : ℝ → ℝ := fun s => h (ι x + s • v) with hkdef
  have hk : ContDiff ℝ 1 k := hh.comp (contDiff_const.add (contDiff_id.smul contDiff_const))
  have hiso : Isometry (fun s : ℝ => ι x + s • v) := by
    refine Isometry.of_dist_eq fun s t => ?_
    rw [dist_eq_norm, dist_eq_norm, add_sub_add_left_eq_sub, ← sub_smul, norm_smul, hv, mul_one]
  have hkc : HasCompactSupport k := hhc.comp_isClosedEmbedding hiso.isClosedEmbedding
  have hderiv : ∀ s, deriv k s = fderiv ℝ h (ι x + s • v) v := by
    intro s
    have h1 : HasDerivAt (fun s : ℝ => ι x + s • v) v s := by
      simpa using ((hasDerivAt_id s).smul_const v).const_add (ι x)
    exact (((hh.differentiable one_ne_zero) (ι x + s • v)).hasFDerivAt.comp_hasDerivAt s h1).deriv
  have hFTC : ∫ s in Ioi 0, deriv k s = -h (ι x) := by
    rw [hkc.integral_Ioi_deriv_eq hk 0]
    simp [hkdef]
  -- compare the integrands: `Θ(x, s) ∈ H` exactly when `s > 0`
  rw [← hFTC, ← integral_indicator measurableSet_Ioi]
  refine integral_congr_ae (Eventually.of_forall fun s => ?_)
  simp only [hGdef, hHdef, indicator_apply, mem_ofPred_eq, hΘv, mem_Ioi]
  split_ifs
  · rw [hderiv]
  · rfl

/-- **Gauss–Green for a half-space** (used in the proof of Simon Ch. 3, Theorem 4.3).  For
`|v| = 1` and `g ∈ C¹_c(ℝ^{m+1}; ℝ^{m+1})`,
`∫_{⟨w, v⟩ > 0} div g dL^{m+1} = −∫_{v^⊥} ⟨g, v⟩ dHᵐ`.  With `ι : ℝᵐ → v^⊥` from
`codim1_rdo_dg_tma_hyperplane_param`, `(ι e₀, …, ι e_{m−1}, v)` is an orthonormal basis `b`, so
`div g = Σⱼ D⟨bⱼ, g⟩(bⱼ)`.  The `m` tangential terms integrate to `0` over the half-space
(`codim1_rdo_dg_tma_tangential_halfspace`), the normal term is `−∫ ⟨v, g(ι x)⟩ dx`
(`codim1_rdo_dg_tma_normal_halfspace`), and `Hᵐ⌞v^⊥ = ι_# Lᵐ` turns it into the boundary
integral. -/
theorem Submission.codim1_rdo_dg_tma_halfspace_gauss_green : ∀ (m : ℕ) (v : Euclid (m + 1)) (g : Euclid (m + 1) → Euclid (m + 1)), ‖v‖ = 1 → ContDiff ℝ 1 g → HasCompactSupport g → ∫ w in {w : Euclid (m + 1) | 0 < inner ℝ w v}, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g w : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -∫ z in ((Submodule.span ℝ {v})ᗮ : Set (Euclid (m + 1))), inner ℝ (g z) v ∂μHE[m] := by
  intro m v g hv hg hgc
  have hv0 : v ≠ 0 := by
    rintro rfl
    simp at hv
  obtain ⟨ι, hιv, hmap⟩ := Submission.codim1_rdo_dg_tma_hyperplane_param m v hv0
  -- the adapted orthonormal basis `(ι e₀, …, ι e_{m-1}, v)`
  let b : Fin (m + 1) → Euclid (m + 1) :=
    Fin.lastCases v (fun i => ι (EuclideanSpace.single i (1 : ℝ)))
  have hb_last : b (Fin.last m) = v := by simp [b]
  have hb_cs : ∀ i : Fin m, b (Fin.castSucc i) = ι (EuclideanSpace.single i (1 : ℝ)) := by
    intro i
    simp [b]
  have hb : Orthonormal ℝ b := by
    rw [orthonormal_iff_ite]
    intro i j
    induction i using Fin.lastCases with
    | last =>
      induction j using Fin.lastCases with
      | last => simp [hb_last, hv]
      | cast j =>
        rw [hb_last, hb_cs, real_inner_comm, hιv, ite_eq_right (Fin.castSucc_lt_last j).ne']
    | cast i =>
      induction j using Fin.lastCases with
      | last => rw [hb_last, hb_cs, hιv, ite_eq_right (Fin.castSucc_lt_last i).ne]
      | cast j =>
        rw [hb_cs, hb_cs, LinearIsometry.inner_map_map, EuclideanSpace.inner_single_left]
        by_cases hij : i = j
        · subst hij
          simp
        · simp [hij, Fin.castSucc_inj]
  have hcard : Fintype.card (Fin (m + 1)) = Module.finrank ℝ (Euclid (m + 1)) := by simp
  have hsp : ⊤ ≤ Submodule.span ℝ (Set.range b) := by
    rw [← coe_basisOfOrthonormalOfCardEqFinrank hb hcard,
      (basisOfOrthonormalOfCardEqFinrank hb hcard).span_eq]
  let B : OrthonormalBasis (Fin (m + 1)) ℝ (Euclid (m + 1)) := OrthonormalBasis.mk hb hsp
  have hB : ∀ i, B i = b i := by
    intro i
    simp [B]
  -- scalar components
  set h : Fin (m + 1) → Euclid (m + 1) → ℝ := fun i w => inner ℝ (b i) (g w) with hhdef
  have hh_cd : ∀ i, ContDiff ℝ 1 (h i) := fun i => contDiff_const.inner ℝ hg
  have hh_cs : ∀ i, HasCompactSupport (h i) := by
    intro i
    exact hgc.mono' (fun w hw => by
      by_contra hgw
      exact hw (by simp [hhdef, image_eq_zero_of_notMem_tsupport hgw]))
  have hfd : ∀ i w, fderiv ℝ (h i) w (b i) =
      inner ℝ (b i) ((fderiv ℝ g w : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) (b i)) := by
    intro i w
    have hgd : DifferentiableAt ℝ g w := (hg.differentiable one_ne_zero) w
    rw [hhdef]
    simp only
    rw [fderiv_inner_apply ℝ (differentiableAt_const (b i)) hgd]
    simp
  have htr : ∀ w, LinearMap.trace ℝ (Euclid (m + 1))
      (fderiv ℝ g w : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = ∑ i, fderiv ℝ (h i) w (b i) := by
    intro w
    rw [LinearMap.trace_eq_sum_inner _ B]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hfd, hB]
  have hint : ∀ i, Integrable (fun w => fderiv ℝ (h i) w (b i))
      (volume.restrict {w : Euclid (m + 1) | 0 < inner ℝ w v}) := by
    intro i
    have hc : Continuous (fun w => fderiv ℝ (h i) w (b i)) :=
      ((hh_cd i).continuous_fderiv one_ne_zero).clm_apply continuous_const
    have hcs : HasCompactSupport (fun w => fderiv ℝ (h i) w (b i)) :=
      ((hh_cs i).fderiv ℝ).mono' (fun w hw => by
        by_contra hne
        exact hw (by simp [image_eq_zero_of_notMem_tsupport hne]))
    exact (hc.integrable_of_hasCompactSupport hcs).integrableOn
  simp_rw [htr]
  rw [integral_finsetSum _ (fun i _ => hint i), Fin.sum_univ_castSucc]
  -- the `m` tangential terms vanish
  have htan : ∀ i : Fin m, ∫ w in {w : Euclid (m + 1) | 0 < inner ℝ w v},
      fderiv ℝ (h (Fin.castSucc i)) w (b (Fin.castSucc i)) = 0 := by
    intro i
    exact Submission.codim1_rdo_dg_tma_tangential_halfspace (m + 1) v (b (Fin.castSucc i))
      (h (Fin.castSucc i)) (by rw [hb_cs]; exact hιv _) (hh_cd _) (hh_cs _)
  simp_rw [htan, Finset.sum_const_zero, zero_add]
  -- the normal term, and `Hᵐ⌞v^⊥ = ι_# Lᵐ`
  rw [hb_last]
  have hnorm := Submission.codim1_rdo_dg_tma_normal_halfspace m ι v (h (Fin.last m)) hv hιv
    (hh_cd _) (hh_cs _)
  rw [hnorm, hmap]
  congr 1
  have hcont : Continuous (fun z => inner ℝ (g z) v) := hg.continuous.inner continuous_const
  rw [integral_map ι.continuous.aemeasurable hcont.aestronglyMeasurable]
  refine integral_congr_ae (Eventually.of_forall fun x => ?_)
  simp [hhdef, hb_last, real_inner_comm]
/-- **Blow-up convergence of the vector measure `ν μ` on `C¹` vector fields** (Simon Ch. 3,
Theorem 4.3 (De Giorgi), chapter-03.txt lines 588–746: the closing step "by 4.1, (1) and (2)",
lines 739–746, with the change of variables (8), line 664).  Let `F` be Borel with
`∫_F div φ = −∫ ⟨φ, ν⟩ dμ` for every `C¹_c` field `φ` with `spt φ ⊆ D`, where `B̄_{ρ₁}(y) ⊆ D`,
and let the blow-ups `F_r = {w : y + r w ∈ F}` satisfy `L^{m+1}((F_r Δ H) ∩ B_R(0)) → 0` as
`r ↓ 0` for every `R`, where `H = {w : ⟨w, v⟩ > 0}`, `|v| = 1`.  Then for every `C¹_c` field `g`,
`r⁻ᵐ ∫ ⟨g(r⁻¹(z − y)), ν(z)⟩ dμ(z) → ∫_{v^⊥} ⟨g, v⟩ dHᵐ` as `r ↓ 0`.  With `spt g ⊆ B_R(0)`, the
rescaled Gauss–Green identity turns the left side into `−∫_{F_r} div g` for `r < ρ₁/R`;
`|∫_{F_r} div g − ∫_H div g| ≤ sup |div g| · L^{m+1}((F_r Δ H) ∩ B_R(0)) → 0`; and the half-space
Gauss–Green formula gives `∫_H div g = −∫_{v^⊥} ⟨g, v⟩ dHᵐ`. -/
theorem Submission.codim1_rdo_dg_tma_vector_convergence : ∀ (m : ℕ) (D F : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)) (y v : Euclid (m + 1)) (ρ₁ : ℝ), MeasurableSet F → (∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ z in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -∫ z, inner ℝ (φ z) (ν z) ∂μ) → 0 < ρ₁ → closedBall y ρ₁ ⊆ D → ‖v‖ = 1 → (∀ R : ℝ, Tendsto (fun r : ℝ => volume (symmDiff ((fun w => y + r • w) ⁻¹' F) {w | 0 < inner ℝ w v} ∩ ball (0 : Euclid (m + 1)) R)) (𝓝[>] 0) (𝓝 0)) → ∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 g → HasCompactSupport g → Tendsto (fun r : ℝ => (r ^ m)⁻¹ * ∫ z, inner ℝ (g (r⁻¹ • (z - y))) (ν z) ∂μ) (𝓝[>] 0) (𝓝 (∫ z in ((Submodule.span ℝ {v})ᗮ : Set (Euclid (m + 1))), inner ℝ (g z) v ∂μHE[m])) := by
  intro m D F μ ν y v ρ₁ hF hGG hρ₁ hball hv hblow g hg hgc
  -- Step 1: `spt g ⊆ B_R(0)`.  `T = div g = trace Dg` is continuous and vanishes off `B_R(0)`
  -- (`Dg = 0` off `spt g`), so it is integrable and bounded by some `M`.
  obtain ⟨R, hRpos, hR⟩ : ∃ R : ℝ, 0 < R ∧ tsupport g ⊆ ball (0 : Euclid (m + 1)) R := by
    obtain ⟨R, hR⟩ := hgc.isCompact.isBounded.subset_ball (0 : Euclid (m + 1))
    exact ⟨max R 1, by positivity, hR.trans (ball_subset_ball (le_max_left _ _))⟩
  set T : Euclid (m + 1) → ℝ := fun w =>
    LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g w : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1))
    with hTdef
  have hTcont : Continuous T := by
    have h1 : Continuous (fderiv ℝ g) := hg.continuous_fderiv one_ne_zero
    have h2 : Continuous (fun A : Euclid (m + 1) →L[ℝ] Euclid (m + 1) =>
        LinearMap.trace ℝ (Euclid (m + 1)) (A : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1))) :=
      ((LinearMap.trace ℝ (Euclid (m + 1))).comp
        (ContinuousLinearMap.coeLM ℝ)).continuous_of_finiteDimensional
    exact h2.comp h1
  have hTzero : ∀ w, w ∉ ball (0 : Euclid (m + 1)) R → T w = 0 := by
    intro w hw
    have hw' : w ∉ tsupport g := fun h => hw (hR h)
    have : fderiv ℝ g w = 0 := by
      by_contra hne
      exact hw' (support_fderiv_subset ℝ hne)
    simp [hTdef, this]
  have hTcs : HasCompactSupport T := by
    refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid (m + 1)) R) ?_
    intro w hw
    exact hTzero w (fun h => hw (ball_subset_closedBall h))
  obtain ⟨M, hM⟩ : ∃ M, ∀ w, ‖T w‖ ≤ M := hTcont.bounded_above_of_compact_support hTcs
  have hTint : Integrable T := hTcont.integrable_of_hasCompactSupport hTcs
  set H : Set (Euclid (m + 1)) := {w | 0 < inner ℝ w v}
  have hHmeas : MeasurableSet H :=
    (isOpen_lt continuous_const (continuous_id.inner continuous_const)).measurableSet
  -- Step 2: for `0 < r < ρ₁/R` and `w ∈ spt g`, `|(y + r w) − y| = r|w| < ρ₁`, so
  -- `y + r w ∈ B̄_{ρ₁}(y) ⊆ D` and the rescaled Gauss–Green identity gives
  -- `r⁻ᵐ ∫ ⟨g(r⁻¹(z − y)), ν⟩ dμ = −∫_{F_r} T`.
  have hev : ∀ᶠ r in 𝓝[>] (0 : ℝ), (r ^ m)⁻¹ * ∫ z, inner ℝ (g (r⁻¹ • (z - y))) (ν z) ∂μ =
      -∫ w in (fun w => y + r • w) ⁻¹' F, T w := by
    have hsmall : ∀ᶠ r in 𝓝[>] (0 : ℝ), r < ρ₁ / R :=
      nhdsWithin_le_nhds (gt_mem_nhds (div_pos hρ₁ hRpos))
    filter_upwards [self_mem_nhdsWithin, hsmall] with r hr hrR
    refine Submission.codim1_rdo_dg_tma_rescaled_gauss_green m D F μ ν y r g hF hGG hr hg hgc ?_
    intro w hw
    apply hball
    have hwR : ‖w‖ < R := by simpa using hR hw
    rw [mem_closedBall, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hr.le]
    have : r * ‖w‖ ≤ r * R := mul_le_mul_of_nonneg_left hwR.le hr.le
    have h2 : r * R < ρ₁ := by
      have := (lt_div_iff₀ hRpos).mp hrR
      linarith
    linarith
  -- Steps 3–4: `|∫_{F_r} T − ∫_H T| ≤ M · L^{m+1}((F_r Δ H) ∩ B_R(0))`, since the integrand
  -- `(1_{F_r} − 1_H) T` vanishes off `(F_r Δ H) ∩ B_R(0)` and is bounded by `M` there; the
  -- right side tends to `0` by the blow-up hypothesis.
  have hlim : Tendsto (fun r : ℝ => ∫ w in (fun w => y + r • w) ⁻¹' F, T w) (𝓝[>] 0)
      (𝓝 (∫ w in H, T w)) := by
    have hbound : ∀ r : ℝ, 0 < r → ‖(∫ w in (fun w => y + r • w) ⁻¹' F, T w) - ∫ w in H, T w‖ ≤
        M * (volume (symmDiff ((fun w => y + r • w) ⁻¹' F) H ∩
          ball (0 : Euclid (m + 1)) R)).toReal := by
      intro r hr
      have hFr : MeasurableSet ((fun w => y + r • w) ⁻¹' F) :=
        hF.preimage (by fun_prop)
      rw [← integral_indicator hFr, ← integral_indicator hHmeas, ← integral_sub
        (hTint.indicator hFr) (hTint.indicator hHmeas)]
      have hS : MeasurableSet (symmDiff ((fun w => y + r • w) ⁻¹' F) H ∩
          ball (0 : Euclid (m + 1)) R) :=
        ((hFr.symmDiff hHmeas)).inter measurableSet_ball
      have hfin : volume (symmDiff ((fun w => y + r • w) ⁻¹' F) H ∩
          ball (0 : Euclid (m + 1)) R) ≠ ∞ :=
        (measure_mono inter_subset_right).trans_lt measure_ball_lt_top |>.ne
      calc ‖∫ w, ((fun w => y + r • w) ⁻¹' F).indicator T w - H.indicator T w‖
          ≤ ∫ w, (symmDiff ((fun w => y + r • w) ⁻¹' F) H ∩
              ball (0 : Euclid (m + 1)) R).indicator (fun _ => M) w := by
            have hInt : Integrable ((symmDiff ((fun w => y + r • w) ⁻¹' F) H ∩
                ball (0 : Euclid (m + 1)) R).indicator (fun _ => M)) :=
              (integrable_indicator_iff hS).2 (integrableOn_const hfin)
            refine norm_integral_le_of_norm_le hInt (Eventually.of_forall fun w => ?_)
            have hMabs : ∀ w, |T w| ≤ M := fun w => by simpa [Real.norm_eq_abs] using hM w
            by_cases hwB : w ∈ ball (0 : Euclid (m + 1)) R
            · by_cases h1 : w ∈ (fun w => y + r • w) ⁻¹' F <;> by_cases h2 : w ∈ H <;>
                simp [h1, h2, hwB, Set.mem_symmDiff, hMabs, norm_neg]
            · have hT0 := hTzero w hwB
              by_cases h1 : w ∈ (fun w => y + r • w) ⁻¹' F <;> by_cases h2 : w ∈ H <;>
                simp [h1, h2, hwB, hT0, Set.mem_symmDiff]
        _ = M * (volume (symmDiff ((fun w => y + r • w) ⁻¹' F) H ∩
              ball (0 : Euclid (m + 1)) R)).toReal := by
            rw [integral_indicator_const _ hS, smul_eq_mul, mul_comm, Measure.real]
    have h0 : Tendsto (fun r : ℝ => M * (volume (symmDiff ((fun w => y + r • w) ⁻¹' F) H ∩
          ball (0 : Euclid (m + 1)) R)).toReal) (𝓝[>] 0) (𝓝 0) := by
      have := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp (hblow R)
      simpa using this.const_mul M
    rw [tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero' (Eventually.of_forall fun _ => norm_nonneg _) ?_ h0
    filter_upwards [self_mem_nhdsWithin] with r hr
    exact hbound r hr
  -- Steps 5–6: `∫_H T = −∫_{v^⊥} ⟨g, v⟩ dHᵐ` by the half-space Gauss–Green formula, so
  -- `−∫_{F_r} T → ∫_{v^⊥} ⟨g, v⟩ dHᵐ`; by Step 2 the rescaled `ν μ`-integrals eventually agree.
  have hGGH := Submission.codim1_rdo_dg_tma_halfspace_gauss_green m v g hv hg hgc
  have hneg := hlim.neg
  rw [show (∫ w in H, T w) = -∫ z in ((Submodule.span ℝ {v})ᗮ : Set (Euclid (m + 1))),
      inner ℝ (g z) v ∂μHE[m] from hGGH, neg_neg] at hneg
  exact hneg.congr' (hev.mono fun r hr => hr.symm)
/-- **Normal-defect estimate** (Simon Ch. 3, 4.3 (†), "by 4.1, (1) and (2)"): weighting by
`⟨v, ν⟩` does not change blow-up limits.  Write `B_ρ = B̄_ρ(y)` and
`A(ρ) = μ(B_ρ)⁻¹ ∫_{B_ρ} ν dμ`.  Choose `R ≥ 1` with `tsupport f ⊆ B̄_R(0)` and `|f| ≤ M`; then
`f(r⁻¹(z − y)) ≠ 0` forces `z ∈ B_{rR}`, where `μ ≤ C (rR)ⁿ < ∞`.  Splitting
`f = f ⟨v, ν⟩ + f (1 − ⟨v, ν⟩)` with `0 ≤ 1 − ⟨v, ν⟩ ≤ 2` (Cauchy–Schwarz), the defect
`Δ(r) = r⁻ⁿ ∫ f(r⁻¹(z − y)) (1 − ⟨v, ν(z)⟩) dμ(z)` satisfies
`|Δ(r)| ≤ r⁻ⁿ M ∫_{B_{rR}} (1 − ⟨v, ν⟩) dμ = r⁻ⁿ M μ(B_{rR}) (1 − ⟨v, A(rR)⟩)
  ≤ M C Rⁿ |1 − ⟨v, A(rR)⟩|`, which tends to `0` because `A(rR) → v` and `⟨v, v⟩ = 1`. -/
theorem Submission.codim1_rdo_dg_tma_normal_defect : ∀ (P n : ℕ) (μ : Measure (Euclid P)) (ν : Euclid P → Euclid P) (y v : Euclid P) (ρ₁ C L : ℝ) (f : Euclid P → ℝ), Measurable ν → (∀ z, ‖ν z‖ = 1) → ‖v‖ = 1 → 0 < ρ₁ → 0 ≤ C → (∀ ρ : ℝ, 0 < ρ → ρ < ρ₁ → μ (closedBall y ρ) ≤ ENNReal.ofReal (C * ρ ^ n)) → Tendsto (fun ρ : ℝ => (μ (closedBall y ρ)).toReal⁻¹ • ∫ z in closedBall y ρ, ν z ∂μ) (𝓝[>] 0) (𝓝 v) → Continuous f → HasCompactSupport f → Tendsto (fun r : ℝ => (r ^ n)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) * inner ℝ v (ν z) ∂μ) (𝓝[>] 0) (𝓝 L) → Tendsto (fun r : ℝ => (r ^ n)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) ∂μ) (𝓝[>] 0) (𝓝 L) := by
  intro P n μ ν y v ρ₁ C L f hνm hν1 hv hρ₁ hC hdens hA hf hfc hL
  -- Step 1: `tsupport f ⊆ B̄_R(0)` with `R ≥ 1`, and `|f| ≤ M`
  obtain ⟨R₀, hR₀⟩ := hfc.isCompact.isBounded.subset_closedBall (0 : Euclid P)
  set R := max R₀ 1 with hRdef
  have hRpos : 0 < R := lt_of_lt_of_le one_pos (le_max_right _ _)
  have hR : tsupport f ⊆ closedBall 0 R :=
    hR₀.trans (closedBall_subset_closedBall (le_max_left _ _))
  obtain ⟨M, hM⟩ := hf.bounded_above_of_compact_support hfc
  have hM' : ∀ w, |f w| ≤ M := fun w => by simpa [Real.norm_eq_abs] using hM w
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM' 0)
  set A : ℝ → Euclid P := fun ρ =>
    (μ (closedBall y ρ)).toReal⁻¹ • ∫ z in closedBall y ρ, ν z ∂μ with hAdef
  -- Step 2: Cauchy–Schwarz, `|⟨v, ν(z)⟩| ≤ 1`
  have hinner_le : ∀ z, inner ℝ v (ν z) ≤ 1 := by
    intro z
    have := real_inner_le_norm v (ν z)
    rwa [hv, hν1, one_mul] at this
  have hinner_abs : ∀ z, |inner ℝ v (ν z)| ≤ 1 := by
    intro z
    have := abs_real_inner_le_norm v (ν z)
    rwa [hv, hν1, one_mul] at this
  have hνinner_meas : Measurable (fun z => inner ℝ v (ν z)) :=
    (continuous_const.inner continuous_id).measurable.comp hνm
  -- Steps 3–6: for `0 < r` with `rR < ρ₁`, `|Δ(r)| ≤ M C Rⁿ |1 − ⟨v, A(rR)⟩|`
  have hbound : ∀ r : ℝ, 0 < r → r * R < ρ₁ →
      |(r ^ n)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) ∂μ -
        (r ^ n)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) * inner ℝ v (ν z) ∂μ| ≤
        M * (C * R ^ n) * |1 - inner ℝ v (A (r * R))| := by
    intro r hr hrR
    set B := closedBall y (r * R) with hBdef
    have hBμ : μ B ≤ ENNReal.ofReal (C * (r * R) ^ n) := hdens _ (by positivity) hrR
    have hBfin : μ B ≠ ∞ := (hBμ.trans_lt ENNReal.ofReal_lt_top).ne
    have hsupp : ∀ z, z ∉ B → f (r⁻¹ • (z - y)) = 0 := by
      intro z hz
      by_contra hne
      have h1 := hR (subset_tsupport f hne)
      apply hz
      rw [mem_closedBall, dist_zero_right, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hr.le)]
        at h1
      rw [hBdef, mem_closedBall, dist_eq_norm]
      calc ‖z - y‖ = r * (r⁻¹ * ‖z - y‖) := by field_simp
        _ ≤ r * R := mul_le_mul_of_nonneg_left h1 hr.le
    have hcont : Continuous (fun z => f (r⁻¹ • (z - y))) := by fun_prop
    -- Step 3: integrability
    have hint1 : Integrable (fun z => f (r⁻¹ • (z - y))) μ := by
      refine IntegrableOn.integrable_of_forall_notMem_eq_zero ?_ hsupp
      exact Measure.integrableOn_of_bounded hBfin hcont.aestronglyMeasurable (M := M)
        (Eventually.of_forall fun z => by simpa [Real.norm_eq_abs] using hM' _)
    have hint2 : Integrable (fun z => f (r⁻¹ • (z - y)) * inner ℝ v (ν z)) μ := by
      refine IntegrableOn.integrable_of_forall_notMem_eq_zero ?_
        (fun z hz => by rw [hsupp z hz, zero_mul])
      refine Measure.integrableOn_of_bounded hBfin
        (hcont.aestronglyMeasurable.mul hνinner_meas.aestronglyMeasurable) (M := M)
        (Eventually.of_forall fun z => ?_)
      rw [Real.norm_eq_abs, abs_mul]
      calc |f (r⁻¹ • (z - y))| * |inner ℝ v (ν z)| ≤ M * 1 :=
            mul_le_mul (hM' _) (hinner_abs z) (abs_nonneg _) hM0
        _ = M := mul_one M
    have hνint : IntegrableOn ν B μ :=
      Measure.integrableOn_of_bounded hBfin hνm.aestronglyMeasurable (M := 1)
        (Eventually.of_forall fun z => (hν1 z).le)
    -- Step 5: `∫_B (1 − ⟨v, ν⟩) dμ = μ(B) (1 − ⟨v, A(rR)⟩)`
    have hkey : ∫ z in B, (1 - inner ℝ v (ν z)) ∂μ =
        (μ B).toReal * (1 - inner ℝ v (A (r * R))) := by
      have hint3 : IntegrableOn (fun z => inner ℝ v (ν z)) B μ :=
        Measure.integrableOn_of_bounded hBfin hνinner_meas.aestronglyMeasurable (M := 1)
          (Eventually.of_forall fun z => by simpa [Real.norm_eq_abs] using hinner_abs z)
      rw [integral_sub (integrableOn_const (C := (1 : ℝ)) hBfin) hint3, setIntegral_const,
        smul_eq_mul, mul_one]
      have hcomm : ∫ z in B, inner ℝ v (ν z) ∂μ = inner ℝ v (∫ z in B, ν z ∂μ) := by
        have := ContinuousLinearMap.integral_comp_comm (innerSL ℝ v) hνint
        simpa using this
      rw [hcomm, Measure.real]
      by_cases h0 : (μ B).toReal = 0
      · have hμ0 : μ B = 0 := by
          rcases (ENNReal.toReal_eq_zero_iff _).1 h0 with h | h
          · exact h
          · exact absurd h hBfin
        have : ∫ z in B, ν z ∂μ = 0 := by
          rw [Measure.restrict_eq_zero.2 hμ0, integral_zero_measure]
        rw [this, h0]
        simp
      · simp only [hAdef]
        rw [← hBdef, real_inner_smul_right]
        field_simp
    -- Step 4: splitting and the pointwise bound `|f (1 − ⟨v, ν⟩)| ≤ M (1 − ⟨v, ν⟩) 1_B`
    have hdiff : (r ^ n)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) ∂μ -
        (r ^ n)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) * inner ℝ v (ν z) ∂μ =
        (r ^ n)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) * (1 - inner ℝ v (ν z)) ∂μ := by
      rw [← mul_sub, ← integral_sub hint1 hint2]
      congr 1
      refine integral_congr_ae (Eventually.of_forall fun z => ?_)
      simp only
      ring
    have hle : |∫ z, f (r⁻¹ • (z - y)) * (1 - inner ℝ v (ν z)) ∂μ| ≤
        M * ∫ z in B, (1 - inner ℝ v (ν z)) ∂μ := by
      have hbint : Integrable (fun z => B.indicator (fun z => M * (1 - inner ℝ v (ν z))) z) μ := by
        refine (integrable_indicator_iff measurableSet_closedBall).2 ?_
        refine Measure.integrableOn_of_bounded hBfin
          (aestronglyMeasurable_const.mul
            (aestronglyMeasurable_const.sub hνinner_meas.aestronglyMeasurable)) (M := M * 2)
          (Eventually.of_forall fun z => ?_)
        rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg hM0]
        refine mul_le_mul_of_nonneg_left ?_ hM0
        have := hinner_abs z
        rw [abs_le] at this ⊢
        constructor <;> linarith [this.1, this.2]
      rw [← Real.norm_eq_abs]
      refine (norm_integral_le_of_norm_le hbint (Eventually.of_forall fun z => ?_)).trans ?_
      · by_cases hz : z ∈ B
        · rw [indicator_of_mem hz, Real.norm_eq_abs, abs_mul,
            abs_of_nonneg (sub_nonneg.2 (hinner_le z))]
          exact mul_le_mul_of_nonneg_right (hM' _) (sub_nonneg.2 (hinner_le z))
        · rw [indicator_of_notMem hz, hsupp z hz, zero_mul, norm_zero]
      · rw [integral_indicator measurableSet_closedBall, integral_const_mul]
    -- Step 6: `μ(B_{rR}) ≤ C (rR)ⁿ`
    have hμB : (μ B).toReal ≤ C * (r * R) ^ n :=
      ENNReal.toReal_le_of_le_ofReal (by positivity) hBμ
    rw [hdiff, abs_mul, abs_of_pos (inv_pos.2 (pow_pos hr n))]
    calc (r ^ n)⁻¹ * |∫ z, f (r⁻¹ • (z - y)) * (1 - inner ℝ v (ν z)) ∂μ|
        ≤ (r ^ n)⁻¹ * (M * ((μ B).toReal * |1 - inner ℝ v (A (r * R))|)) := by
          gcongr
          refine hle.trans ?_
          rw [hkey]
          gcongr
          exact le_abs_self _
      _ ≤ (r ^ n)⁻¹ * (M * ((C * (r * R) ^ n) * |1 - inner ℝ v (A (r * R))|)) := by
          gcongr
      _ = M * (C * R ^ n) * |1 - inner ℝ v (A (r * R))| := by
          rw [mul_pow]
          field_simp
  -- Step 7: `A(rR) → v`, so the bound tends to `0`
  have hAr : Tendsto (fun r : ℝ => A (r * R)) (𝓝[>] 0) (𝓝 v) := by
    refine hA.comp ?_
    refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ ?_ ?_
    · have := (tendsto_id (x := 𝓝 (0 : ℝ))).mul_const R
      simpa using this.mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with r hr
      exact mul_pos hr hRpos
  have hin : Tendsto (fun r : ℝ => inner ℝ v (A (r * R))) (𝓝[>] 0) (𝓝 1) := by
    have hic : Continuous (fun w : Euclid P => inner ℝ v w) := continuous_const.inner continuous_id
    have := (hic.tendsto v).comp hAr
    simpa [Function.comp_def, real_inner_self_eq_norm_sq, hv] using this
  have h0 : Tendsto (fun r : ℝ => M * (C * R ^ n) * |1 - inner ℝ v (A (r * R))|) (𝓝[>] 0)
      (𝓝 0) := by
    have := ((tendsto_const_nhds (x := (1 : ℝ))).sub hin).abs.const_mul (M * (C * R ^ n))
    simpa using this
  have hsmall : ∀ᶠ r in 𝓝[>] (0 : ℝ), r < ρ₁ / R :=
    nhdsWithin_le_nhds (gt_mem_nhds (div_pos hρ₁ hRpos))
  have hΔ : Tendsto (fun r : ℝ => (r ^ n)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) ∂μ -
      (r ^ n)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) * inner ℝ v (ν z) ∂μ) (𝓝[>] 0) (𝓝 0) := by
    rw [tendsto_zero_iff_abs_tendsto_zero]
    refine squeeze_zero' (Eventually.of_forall fun _ => abs_nonneg _) ?_ h0
    filter_upwards [self_mem_nhdsWithin, hsmall] with r hr hrR
    exact hbound r hr (by have := (lt_div_iff₀ hRpos).mp hrR; linarith)
  -- Step 8: `r⁻ⁿ ∫ f(r⁻¹(z − y)) dμ = r⁻ⁿ ∫ f(r⁻¹(z − y)) ⟨v, ν(z)⟩ dμ + Δ(r) → L`
  have := hL.add hΔ
  simpa using this
/-- **Uniform `C¹` approximation with support control** (Simon Ch. 3, proof of Theorem 4.3
(De Giorgi): "mollifying, there is `f_θ ∈ C_c^∞` with `spt f_θ ⊆ B_{R+1}(0)` and
`‖f − f_θ‖_∞ ≤ θ`").  `f` has compact support, so it is uniformly continuous; pick a modulus
`δ ≤ 1` for `θ`.  Convolving `f` with a nonnegative `C¹` bump `ψ`, `∫ ψ = 1`,
`spt ψ ⊆ B_δ(0)`, gives a `C¹` function `g` with `spt g ⊆ B_δ(0) + B̄_R(0) ⊆ B̄_{R+1}(0)` and
`|g(x) − f(x)| ≤ ∫ ψ(t) |f(x − t) − f(x)| dt ≤ θ`. -/
theorem Submission.codim1_rdo_dg_tma_smooth_approx : ∀ (P : ℕ) (f : Euclid P → ℝ) (R θ : ℝ), Continuous f → tsupport f ⊆ closedBall (0 : Euclid P) R → 0 < θ → ∃ g : Euclid P → ℝ, ContDiff ℝ 1 g ∧ HasCompactSupport g ∧ tsupport g ⊆ closedBall (0 : Euclid P) (R + 1) ∧ ∀ x, |f x - g x| ≤ θ := by
  intro P f R θ hf hR hθ
  -- `f` is uniformly continuous; `δ = min δ₀ 1` is a modulus for `θ`
  have hfc : HasCompactSupport f :=
    (isCompact_closedBall (0 : Euclid P) R).of_isClosed_subset (isClosed_tsupport f) hR
  have huc : UniformContinuous f := hfc.uniformContinuous_of_continuous hf
  obtain ⟨δ₀, hδ₀, hδ⟩ := Metric.uniformContinuous_iff.1 huc θ hθ
  set δ := min δ₀ 1 with hδdef
  have hδpos : 0 < δ := lt_min hδ₀ one_pos
  -- the normalized bump `ψ = c⁻¹ ψ₀`, `c = ∫ ψ₀ > 0`
  obtain ⟨ψ₀, hψ₀ts, hψ₀c, hψ₀s, hψ₀r, hψ₀0⟩ :=
    exists_contDiff_tsupport_subset (E := Euclid P) (s := ball (0 : Euclid P) δ) (x := 0)
      (n := 1) (ball_mem_nhds 0 hδpos)
  have hψ₀nn : ∀ x, 0 ≤ ψ₀ x := fun x => (hψ₀r ⟨x, rfl⟩).1
  set c := ∫ x, ψ₀ x with hcdef
  have hc : 0 < c :=
    hψ₀s.continuous.integral_pos_of_hasCompactSupport_nonneg_nonzero hψ₀c hψ₀nn
      (by rw [hψ₀0]; norm_num)
  set ψ : Euclid P → ℝ := fun x => c⁻¹ * ψ₀ x with hψdef
  have hψs : ContDiff ℝ 1 ψ := contDiff_const.mul hψ₀s
  have hψc : HasCompactSupport ψ := hψ₀c.mul_left
  have hψnn : ∀ x, 0 ≤ ψ x := fun x => mul_nonneg (inv_nonneg.2 hc.le) (hψ₀nn x)
  have hψint : ∫ x, ψ x = 1 := by
    rw [hψdef, integral_const_mul, ← hcdef, inv_mul_cancel₀ hc.ne']
  have hψsupp : ∀ t, ψ t ≠ 0 → ‖t‖ < δ := by
    intro t ht
    have : t ∈ tsupport ψ₀ := subset_tsupport ψ₀ (fun h0 => ht (by simp [hψdef, h0]))
    simpa using hψ₀ts this
  -- `g = ψ ⋆ f` is `C¹`
  set g : Euclid P → ℝ := convolution ψ f (ContinuousLinearMap.lsmul ℝ ℝ) volume with hgdef
  have hg : ContDiff ℝ 1 g :=
    hψc.contDiff_convolution_left (ContinuousLinearMap.lsmul ℝ ℝ) hψs hf.locallyIntegrable
  have hgval : ∀ x, g x = ∫ t, ψ t * f (x - t) := by
    intro x
    rw [hgdef, convolution_def]
    simp
  -- `spt g ⊆ spt ψ + spt f ⊆ B̄_{R+1}(0)`
  have hgsupp : support g ⊆ closedBall (0 : Euclid P) (R + 1) := by
    refine (support_convolution_subset _).trans ?_
    rintro _ ⟨a, ha, b, hb, rfl⟩
    have ha' : ‖a‖ < δ := hψsupp a ha
    have hb' : ‖b‖ ≤ R := by simpa using hR (subset_tsupport f hb)
    rw [mem_closedBall, dist_zero_right]
    calc ‖a + b‖ ≤ ‖a‖ + ‖b‖ := norm_add_le _ _
      _ ≤ R + 1 := by
          have : δ ≤ 1 := min_le_right _ _
          linarith
  have hgts : tsupport g ⊆ closedBall (0 : Euclid P) (R + 1) :=
    closure_minimal hgsupp isClosed_closedBall
  refine ⟨g, hg, (isCompact_closedBall _ _).of_isClosed_subset (isClosed_tsupport g) hgts,
    hgts, fun x => ?_⟩
  -- `g x − f x = ∫ ψ(t) (f(x − t) − f(x)) dt`, and the integrand is at most `ψ(t) θ`
  have hint1 : Integrable (fun t => ψ t * f (x - t)) :=
    (hψs.continuous.mul (hf.comp (continuous_const.sub continuous_id))).integrable_of_hasCompactSupport
      hψc.mul_right
  have hint2 : Integrable (fun t => ψ t * f x) :=
    (hψs.continuous.integrable_of_hasCompactSupport hψc).mul_const _
  have hdiff : g x - f x = ∫ t, ψ t * (f (x - t) - f x) := by
    simp_rw [hgval, mul_sub]
    rw [integral_sub hint1 hint2, integral_mul_const, hψint, one_mul]
  rw [abs_sub_comm, hdiff]
  calc |∫ t, ψ t * (f (x - t) - f x)| ≤ ∫ t, ψ t * θ := by
        rw [← Real.norm_eq_abs]
        refine norm_integral_le_of_norm_le
          ((hψs.continuous.integrable_of_hasCompactSupport hψc).mul_const _)
          (Eventually.of_forall fun t => ?_)
        rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hψnn t)]
        by_cases ht : ψ t = 0
        · simp [ht]
        · refine mul_le_mul_of_nonneg_left ?_ (hψnn t)
          have h1 : dist (x - t) x < δ₀ := by
            rw [dist_eq_norm, sub_sub_cancel_left, norm_neg]
            exact (hψsupp t ht).trans_le (min_le_left _ _)
          exact (by simpa [Real.dist_eq] using (hδ h1).le)
    _ = θ := by rw [integral_mul_const, hψint, one_mul]

/-- **Blow-up convergence extends from `C¹` to continuous test functions** (Simon Ch. 3, 4.3 (†),
step 5 of the tangent-measure argument in De Giorgi's theorem; used for 7.5.8).  Let
`μ(B̄_ρ(y)) ≤ C ρⁿ` for `0 < ρ < ρ₁` and let `τ` be finite on closed balls.  If
`r⁻ⁿ ∫ g(r⁻¹(z − y)) dμ(z) → ∫ g dτ` as `r ↓ 0` for every `C¹` compactly supported `g`, the same
holds for every continuous compactly supported `f`.  With `tsupport f ⊆ B̄_R(0)`, `S = R + 1` and
`g` the `θ`-approximation of `f` given by `Submission.codim1_rdo_dg_tma_smooth_approx`,
`|r⁻ⁿ ∫ (f − g)(r⁻¹(z − y)) dμ| ≤ θ C Sⁿ` whenever `rS < ρ₁`, and `|∫ (f − g) dτ| ≤ θ τ(B̄_S(0))`;
take `θ = ε/(4K)` with `K = C Sⁿ + τ(B̄_S(0)) + 1`. -/
theorem Submission.codim1_rdo_dg_tma_continuous_extension : ∀ (P n : ℕ) (μ τ : Measure (Euclid P)) (y : Euclid P) (ρ₁ C : ℝ), 0 < ρ₁ → 0 ≤ C → (∀ ρ : ℝ, 0 < ρ → ρ < ρ₁ → μ (closedBall y ρ) ≤ ENNReal.ofReal (C * ρ ^ n)) → (∀ R : ℝ, τ (closedBall (0 : Euclid P) R) ≠ ∞) → (∀ g : Euclid P → ℝ, ContDiff ℝ 1 g → HasCompactSupport g → Tendsto (fun r : ℝ => (r ^ n)⁻¹ * ∫ z, g (r⁻¹ • (z - y)) ∂μ) (𝓝[>] 0) (𝓝 (∫ z, g z ∂τ))) → ∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → Tendsto (fun r : ℝ => (r ^ n)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) ∂μ) (𝓝[>] 0) (𝓝 (∫ z, f z ∂τ)) := by
  intro P n μ τ y ρ₁ C hρ₁ hC hdens hτ hsmooth f hf hfc
  -- Step 1: `tsupport f ⊆ B̄_R(0)` with `R ≥ 0`, and `S = R + 1`.
  obtain ⟨R₀, hR₀⟩ := hfc.isCompact.isBounded.subset_closedBall (0 : Euclid P)
  set R := max R₀ 0 with hRdef
  have hR0 : 0 ≤ R := le_max_right _ _
  have hR : tsupport f ⊆ closedBall 0 R :=
    hR₀.trans (closedBall_subset_closedBall (le_max_left _ _))
  set S := R + 1 with hSdef
  have hS : 0 < S := by positivity
  -- Step 2: if `φ` is continuous, `|φ| ≤ c`, `φ = 0` off `B̄_S(0)` and `rS < ρ₁`, then
  -- `z ↦ φ(r⁻¹(z − y))` vanishes off `B̄_{rS}(y)`, is `μ`-integrable, and
  -- `|r⁻ⁿ ∫ φ(r⁻¹(z − y)) dμ| ≤ r⁻ⁿ c μ(B̄_{rS}(y)) ≤ c C Sⁿ`.
  have key : ∀ (φ : Euclid P → ℝ) (c r : ℝ), Continuous φ → (∀ w, |φ w| ≤ c) →
      (∀ w, φ w ≠ 0 → w ∈ closedBall (0 : Euclid P) S) → 0 < r → r * S < ρ₁ →
      Integrable (fun z => φ (r⁻¹ • (z - y))) μ ∧
        |(r ^ n)⁻¹ * ∫ z, φ (r⁻¹ • (z - y)) ∂μ| ≤ c * (C * S ^ n) := by
    intro φ c r hφ hφc hφs hr hrS
    set B := closedBall y (r * S) with hBdef
    have hBfin : μ B ≠ ∞ :=
      ((hdens (r * S) (by positivity) hrS).trans_lt ENNReal.ofReal_lt_top).ne
    have hsupp : ∀ z, z ∉ B → φ (r⁻¹ • (z - y)) = 0 := by
      intro z hz
      by_contra hne
      have h1 := hφs _ hne
      apply hz
      rw [mem_closedBall, dist_zero_right, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hr.le)]
        at h1
      rw [hBdef, mem_closedBall, dist_eq_norm]
      calc ‖z - y‖ = r * (r⁻¹ * ‖z - y‖) := by field_simp
        _ ≤ r * S := mul_le_mul_of_nonneg_left h1 hr.le
    have hcont : Continuous (fun z => φ (r⁻¹ • (z - y))) := by fun_prop
    have hint : Integrable (fun z => φ (r⁻¹ • (z - y))) μ := by
      refine IntegrableOn.integrable_of_forall_notMem_eq_zero ?_ hsupp
      exact Measure.integrableOn_of_bounded hBfin hcont.aestronglyMeasurable (M := c)
        (Eventually.of_forall fun z => by simpa [Real.norm_eq_abs] using hφc _)
    refine ⟨hint, ?_⟩
    have hc0 : 0 ≤ c := (abs_nonneg _).trans (hφc 0)
    have hle : |∫ z, φ (r⁻¹ • (z - y)) ∂μ| ≤ c * (μ B).toReal := by
      have h2 : ‖∫ z, φ (r⁻¹ • (z - y)) ∂μ‖ ≤ ∫ z, B.indicator (fun _ => c) z ∂μ := by
        refine norm_integral_le_of_norm_le
          ((integrable_indicator_iff measurableSet_closedBall).2 (integrableOn_const hBfin))
          (Eventually.of_forall fun z => ?_)
        by_cases hz : z ∈ B
        · rw [indicator_of_mem hz]
          simpa [Real.norm_eq_abs] using hφc _
        · rw [indicator_of_notMem hz, hsupp z hz, norm_zero]
      rw [integral_indicator_const _ measurableSet_closedBall, smul_eq_mul, Measure.real] at h2
      simpa [Real.norm_eq_abs, mul_comm] using h2
    have hμ : (μ B).toReal ≤ C * (r * S) ^ n :=
      ENNReal.toReal_le_of_le_ofReal (by positivity) (hdens _ (by positivity) hrS)
    rw [abs_mul, abs_of_pos (inv_pos.2 (pow_pos hr n))]
    calc (r ^ n)⁻¹ * |∫ z, φ (r⁻¹ • (z - y)) ∂μ|
        ≤ (r ^ n)⁻¹ * (c * (C * (r * S) ^ n)) := by
          gcongr
          exact hle.trans (mul_le_mul_of_nonneg_left hμ hc0)
      _ = c * (C * S ^ n) := by
          rw [mul_pow]
          field_simp
  -- Step 3: for `φ` as in step 2, `φ` is `τ`-integrable and `|∫ φ dτ| ≤ c T`,
  -- `T = τ(B̄_S(0))`.
  set T := (τ (closedBall (0 : Euclid P) S)).toReal with hTdef
  have keyτ : ∀ (φ : Euclid P → ℝ) (c : ℝ), Continuous φ → (∀ w, |φ w| ≤ c) →
      (∀ w, φ w ≠ 0 → w ∈ closedBall (0 : Euclid P) S) →
      Integrable φ τ ∧ |∫ z, φ z ∂τ| ≤ c * T := by
    intro φ c hφ hφc hφs
    have hBfin := hτ S
    have hsupp : ∀ z, z ∉ closedBall (0 : Euclid P) S → φ z = 0 := by
      intro z hz
      by_contra hne
      exact hz (hφs z hne)
    have hint : Integrable φ τ := by
      refine IntegrableOn.integrable_of_forall_notMem_eq_zero ?_ hsupp
      exact Measure.integrableOn_of_bounded hBfin hφ.aestronglyMeasurable (M := c)
        (Eventually.of_forall fun z => by simpa [Real.norm_eq_abs] using hφc _)
    refine ⟨hint, ?_⟩
    have h2 : ‖∫ z, φ z ∂τ‖ ≤ ∫ z, (closedBall (0 : Euclid P) S).indicator (fun _ => c) z ∂τ := by
      refine norm_integral_le_of_norm_le
        ((integrable_indicator_iff measurableSet_closedBall).2 (integrableOn_const hBfin))
        (Eventually.of_forall fun z => ?_)
      by_cases hz : z ∈ closedBall (0 : Euclid P) S
      · rw [indicator_of_mem hz]
        simpa [Real.norm_eq_abs] using hφc _
      · rw [indicator_of_notMem hz, hsupp z hz, norm_zero]
    rw [integral_indicator_const _ measurableSet_closedBall, smul_eq_mul, Measure.real] at h2
    simpa [Real.norm_eq_abs, mul_comm, hTdef] using h2
  -- `f` is bounded and vanishes off `B̄_S(0)`; `K = C Sⁿ + T + 1 > 0`.
  have hfs : ∀ w, f w ≠ 0 → w ∈ closedBall (0 : Euclid P) S := by
    intro w hw
    have := hR (subset_tsupport f hw)
    exact closedBall_subset_closedBall (by linarith) this
  obtain ⟨Mf, hMf⟩ := hf.bounded_above_of_compact_support hfc
  have hMf' : ∀ w, |f w| ≤ Mf := fun w => by simpa [Real.norm_eq_abs] using hMf w
  set K := C * S ^ n + T + 1 with hKdef
  have hT0 : 0 ≤ T := ENNReal.toReal_nonneg
  have hK : 0 < K := by positivity
  rw [Metric.tendsto_nhds]
  intro ε hε
  -- Step 4: `g ∈ C¹_c` with `tsupport g ⊆ B̄_S(0)` and `|f − g| ≤ θ = ε/(4K)`.
  set θ := ε / (4 * K) with hθdef
  have hθ : 0 < θ := by positivity
  obtain ⟨g, hg, hgc, hgs, hfg⟩ :=
    Submission.codim1_rdo_dg_tma_smooth_approx P f R θ hf hR hθ
  have hgs' : ∀ w, g w ≠ 0 → w ∈ closedBall (0 : Euclid P) S := fun w hw =>
    hgs (subset_tsupport g hw)
  obtain ⟨Mg, hMg⟩ := hg.continuous.bounded_above_of_compact_support hgc
  have hMg' : ∀ w, |g w| ≤ Mg := fun w => by simpa [Real.norm_eq_abs] using hMg w
  -- Step 5: eventually `|r⁻ⁿ ∫ g(r⁻¹(z − y)) dμ − ∫ g dτ| < ε/2`, and `r < ρ₁/S`.
  have hlim := Metric.tendsto_nhds.1 (hsmooth g hg hgc) (ε / 2) (by positivity)
  have hsmall : ∀ᶠ r in 𝓝[>] (0 : ℝ), r < ρ₁ / S :=
    nhdsWithin_le_nhds (gt_mem_nhds (div_pos hρ₁ hS))
  filter_upwards [hlim, self_mem_nhdsWithin, hsmall] with r hr1 hr hrS
  have hrS' : r * S < ρ₁ := by
    have := (lt_div_iff₀ hS).mp hrS
    linarith
  -- Step 6: the `θ`-bounds for `f − g` from steps 2 and 3.
  have hdiff_s : ∀ w, (f - g) w ≠ 0 → w ∈ closedBall (0 : Euclid P) S := by
    intro w hw
    by_cases hfw : f w = 0
    · have : g w ≠ 0 := by
        intro hgw
        apply hw
        simp [hfw, hgw]
      exact hgs' w this
    · exact hfs w hfw
  have hd : ∀ w, |(f - g) w| ≤ θ := fun w => by simpa using hfg w
  obtain ⟨hint_f, -⟩ := key f Mf r hf hMf' hfs hr hrS'
  obtain ⟨hint_g, -⟩ := key g Mg r hg.continuous hMg' hgs' hr hrS'
  obtain ⟨-, hest⟩ := key (f - g) θ r (hf.sub hg.continuous) hd hdiff_s hr hrS'
  obtain ⟨hτf, -⟩ := keyτ f Mf hf hMf' hfs
  obtain ⟨hτg, -⟩ := keyτ g Mg hg.continuous hMg' hgs'
  obtain ⟨-, hestτ⟩ := keyτ (f - g) θ (hf.sub hg.continuous) hd hdiff_s
  have e1 : (r ^ n)⁻¹ * ∫ z, (f - g) (r⁻¹ • (z - y)) ∂μ =
      (r ^ n)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) ∂μ - (r ^ n)⁻¹ * ∫ z, g (r⁻¹ • (z - y)) ∂μ := by
    rw [← mul_sub, ← integral_sub hint_f hint_g]
    rfl
  have e2 : ∫ z, (f - g) z ∂τ = ∫ z, f z ∂τ - ∫ z, g z ∂τ := by
    rw [← integral_sub hτf hτg]
    rfl
  rw [e1] at hest
  rw [e2] at hestτ
  -- Step 7: the triangle inequality gives `< θ K + ε/2 = 3ε/4`.
  rw [Real.dist_eq] at hr1 ⊢
  have hθK : θ * (C * S ^ n) + θ * T ≤ ε / 2 := by
    have h1 : θ * (C * S ^ n) + θ * T ≤ θ * K := by
      rw [hKdef]
      nlinarith
    have h2 : θ * K = ε / 4 := by
      rw [hθdef]
      field_simp
    linarith
  calc |(r ^ n)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) ∂μ - ∫ z, f z ∂τ|
      = |((r ^ n)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) ∂μ - (r ^ n)⁻¹ * ∫ z, g (r⁻¹ • (z - y)) ∂μ)
          + ((r ^ n)⁻¹ * ∫ z, g (r⁻¹ • (z - y)) ∂μ - ∫ z, g z ∂τ)
          - (∫ z, f z ∂τ - ∫ z, g z ∂τ)| := by ring_nf
    _ ≤ |(r ^ n)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) ∂μ - (r ^ n)⁻¹ * ∫ z, g (r⁻¹ • (z - y)) ∂μ|
          + |(r ^ n)⁻¹ * ∫ z, g (r⁻¹ • (z - y)) ∂μ - ∫ z, g z ∂τ|
          + |∫ z, f z ∂τ - ∫ z, g z ∂τ| := by
        refine (abs_sub _ _).trans ?_
        gcongr
        exact abs_add_le _ _
    _ < θ * (C * S ^ n) + ε / 2 + θ * T := by
        have := hr1
        linarith
    _ ≤ ε := by linarith
/-- **Differentiation of the unit normal** (Simon Ch. 3, (4.2); Ch. 1, 3.23): if `μ` is carried
by the open set `D` and is finite on compact subsets of `D`, then for `μ`-a.e. `y` the averages of
the bounded Borel field `ν` over `B̄_ρ(y)` tend to `ν(y)` as `ρ ↓ 0`.  Exhaust `D` by the compact
sets `K a b = B̄_a(0) \ U_{1/(b+1)}(Dᶜ)`; for the finite measure `μ⌞K a b` this is Mathlib's
Lebesgue–Besicovitch differentiation theorem along closed balls (`ae_tendsto_average` for
`Besicovitch.vitaliFamily`, with `Besicovitch.tendsto_filterAt`), and near a point of `D` the
averages for `μ` and for `μ⌞K a b` coincide. -/
theorem Submission.codim1_rdo_dg_normal_average_ae : ∀ (m : ℕ) (D : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)), IsOpen D → μ Dᶜ = 0 → (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μ K ≠ ∞) → Measurable ν → (∀ y, ‖ν y‖ = 1) → ∀ᵐ y ∂μ, y ∈ D ∧ Tendsto (fun ρ : ℝ => (μ (closedBall y ρ)).toReal⁻¹ • ∫ z in closedBall y ρ, ν z ∂μ) (𝓝[>] 0) (𝓝 (ν y)) := by
  intro m D μ ν hD hDc hK hν hν1
  -- the compact sets `K a b = B̄_a(0) \ U_{1/(b+1)}(Dᶜ) ⊆ D`
  let K : ℕ → ℕ → Set (Euclid (m + 1)) := fun a b =>
    closedBall 0 a \ thickening (1 / ((b : ℝ) + 1)) Dᶜ
  have hKc : ∀ a b, IsCompact (K a b) := fun a b =>
    (isCompact_closedBall _ _).diff isOpen_thickening
  have hKD : ∀ a b, K a b ⊆ D := fun a b x hx => by
    by_contra hxD
    exact hx.2 (self_subset_thickening (by positivity) _ hxD)
  -- Besicovitch differentiation of `ν` for the finite measures `μ⌞K a b`
  have hdiff : ∀ a b, ∀ᵐ y ∂μ, y ∈ K a b → Tendsto
      (fun ρ : ℝ => ⨍ z in closedBall y ρ, ν z ∂(μ.restrict (K a b))) (𝓝[>] 0) (𝓝 (ν y)) := by
    intro a b
    have : IsFiniteMeasure (μ.restrict (K a b)) :=
      isFiniteMeasure_restrict.2 (hK _ (hKc a b) (hKD a b))
    have hint : Integrable ν (μ.restrict (K a b)) :=
      Integrable.of_bound hν.aestronglyMeasurable 1 (Eventually.of_forall fun y => (hν1 y).le)
    have h := (Besicovitch.vitaliFamily (μ.restrict (K a b))).ae_tendsto_average
      hint.locallyIntegrable
    rw [ae_restrict_iff' (hKc a b).isClosed.measurableSet] at h
    filter_upwards [h] with y hy hyK
    exact (hy hyK).comp (Besicovitch.tendsto_filterAt _ y)
  -- `μ`-a.e. point lies in `D`
  have hDae : ∀ᵐ y ∂μ, y ∈ D := by
    have h := compl_mem_ae_iff.2 hDc
    rwa [compl_compl] at h
  filter_upwards [hDae, ae_all_iff.2 fun a => ae_all_iff.2 (hdiff a)] with y hyD hy
  refine ⟨hyD, ?_⟩
  obtain ⟨ε, hε, hεD⟩ := Metric.isOpen_iff.1 hD y hyD
  obtain ⟨a, ha⟩ := exists_nat_ge (‖y‖ + 1)
  obtain ⟨b, hb⟩ := exists_nat_one_div_lt (half_pos hε)
  -- `B̄_ρ(y) ⊆ K a b` for `ρ < min 1 (ε / 2)`
  have hsub : ∀ ρ : ℝ, ρ < 1 → ρ < ε / 2 → closedBall y ρ ⊆ K a b := by
    intro ρ hρ1 hρε z hz
    refine ⟨?_, fun hzt => ?_⟩
    · rw [mem_closedBall_zero_iff]
      have := norm_le_of_mem_closedBall hz
      linarith
    · obtain ⟨w, hwD, hzw⟩ := mem_thickening_iff.1 hzt
      apply hwD
      apply hεD
      rw [mem_ball]
      have hzy := mem_closedBall.1 hz
      rw [dist_comm] at hzw
      calc dist w y ≤ dist w z + dist z y := dist_triangle _ _ _
        _ < ε := by linarith
  have hyK : y ∈ K a b := hsub 0 one_pos (half_pos hε) (mem_closedBall_self le_rfl)
  -- for small `ρ` the averages for `μ⌞K a b` and for `μ` over `B̄_ρ(y)` coincide
  refine (hy a b hyK).congr' ?_
  filter_upwards [Ioo_mem_nhdsGT (lt_min one_pos (half_pos hε))] with ρ hρ
  have hρK := hsub ρ (hρ.2.trans_le (min_le_left _ _)) (hρ.2.trans_le (min_le_right _ _))
  rw [setAverage_eq, measureReal_def, Measure.restrict_apply measurableSet_closedBall,
    inter_eq_left.2 hρK, Measure.restrict_restrict measurableSet_closedBall, inter_eq_left.2 hρK]
/-- **Rescaled Gauss–Green identity** (Simon Ch. 3, 4.3 (8), for a general field and centre).
Let `F ⊆ ℝ^{m+1}` be Borel and suppose `∫_F div φ = −∫ ⟨φ, ν⟩ dμ` for every `C¹` compactly
supported `φ` with `tsupport φ ⊆ D`.  If `r > 0` and `B̄_{rR}(y) ⊆ D`, then for every `C¹`
compactly supported `g` with `tsupport g ⊆ B_R(0)` the blow-up `F_{y,r} = {w : y + rw ∈ F}`
satisfies `∫_{F_{y,r}} div g = −(r^m)⁻¹ ∫ ⟨g(r⁻¹(z − y)), ν(z)⟩ dμ(z)`.  Apply the hypothesis to
`φ = g ∘ S`, `S z = r⁻¹(z − y)`: `div φ = r⁻¹ (div g) ∘ S` by the chain rule,
`tsupport φ ⊆ S⁻¹(tsupport g) ⊆ B̄_{rR}(y)`, and the substitution `z = y + rw` (Jacobian
`r^{m+1}`) gives `∫_F div φ = r^m ∫_{F_{y,r}} div g`. -/
theorem Submission.codim1_rdo_dg_bh_rescaled_gauss_green : ∀ (m : ℕ) (D F : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)) (y : Euclid (m + 1)) (r R : ℝ), MeasurableSet F → (∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ z in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -∫ z, inner ℝ (φ z) (ν z) ∂μ) → 0 < r → closedBall y (r * R) ⊆ D → ∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 g → HasCompactSupport g → tsupport g ⊆ ball (0 : Euclid (m + 1)) R → ∫ w in (fun w => y + r • w) ⁻¹' F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g w : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -(r ^ m)⁻¹ * ∫ z, inner ℝ (g (r⁻¹ • (z - y))) (ν z) ∂μ := by
  intro m D F μ ν y r R hF hGG hr hball g hg hgc hgs
  have hr0 : r ≠ 0 := hr.ne'
  -- Step 1: the affine map `S z = r⁻¹(z − y)`, inverse to `w ↦ y + rw`.
  set S : Euclid (m + 1) → Euclid (m + 1) := fun z => r⁻¹ • (z - y) with hS_def
  have hS_cont : Continuous S := (continuous_id.sub continuous_const).const_smul r⁻¹
  have hS_deriv : ∀ z, HasFDerivAt S (r⁻¹ • ContinuousLinearMap.id ℝ (Euclid (m + 1))) z :=
    fun z => ((hasFDerivAt_id (𝕜 := ℝ) z).sub_const y).const_smul r⁻¹
  -- Step 2: `φ = g ∘ S` is `C¹` and `div φ = r⁻¹ (div g) ∘ S`.
  have hφ : ContDiff ℝ 1 (fun z => g (S z)) :=
    hg.comp ((contDiff_id.sub contDiff_const).const_smul r⁻¹)
  have hdiv : ∀ z, LinearMap.trace ℝ (Euclid (m + 1))
      (fderiv ℝ (fun z => g (S z)) z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) =
      r⁻¹ * LinearMap.trace ℝ (Euclid (m + 1))
        (fderiv ℝ g (S z) : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) := by
    intro z
    have hgd : HasFDerivAt g (fderiv ℝ g (S z)) (S z) :=
      ((hg.differentiable one_ne_zero) (S z)).hasFDerivAt
    rw [show (fun z => g (S z)) = g ∘ S from rfl, (hgd.comp z (hS_deriv z)).fderiv]
    have : (fderiv ℝ g (S z)).comp (r⁻¹ • ContinuousLinearMap.id ℝ (Euclid (m + 1))) =
        r⁻¹ • fderiv ℝ g (S z) := by
      ext x; simp
    rw [this, ContinuousLinearMap.toLinearMap_smul, map_smul, smul_eq_mul]
  -- Step 3: `φ` has compact support and `tsupport φ ⊆ S⁻¹(tsupport g) ⊆ B̄_{rR}(y) ⊆ D`.
  let e : Euclid (m + 1) ≃ₜ Euclid (m + 1) :=
    (Homeomorph.subRight y).trans (Homeomorph.smulOfNeZero r⁻¹ (inv_ne_zero hr0))
  have he : ⇑e = S := by funext z; rfl
  have hφc : HasCompactSupport (fun z => g (S z)) := by
    have := hgc.comp_homeomorph e
    rwa [he] at this
  have hφs : tsupport (fun z => g (S z)) ⊆ D := by
    intro z hz
    have hmem := hgs (tsupport_comp_subset_preimage g hS_cont hz)
    rw [mem_ball_zero_iff, hS_def, norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hr] at hmem
    apply hball
    rw [mem_closedBall, dist_eq_norm]
    have := (inv_mul_lt_iff₀ hr).mp hmem
    linarith
  -- Step 4: the Gauss–Green hypothesis for `φ`.
  have hGGφ := hGG (fun z => g (S z)) hφ hφc hφs
  -- Step 5: the substitution `z = y + rw`: `∫_F div φ = r^m ∫_{F_{y,r}} div g`.
  set Tg : Euclid (m + 1) → ℝ := fun w => LinearMap.trace ℝ (Euclid (m + 1))
    (fderiv ℝ g w : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1))
  have hpre : MeasurableSet ((fun w => y + r • w) ⁻¹' F) :=
    (measurable_const.add (measurable_id.const_smul r)) hF
  have hcv : ∫ z in F, LinearMap.trace ℝ (Euclid (m + 1))
      (fderiv ℝ (fun z => g (S z)) z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) =
      r ^ m * ∫ w in (fun w => y + r • w) ⁻¹' F, Tg w := by
    simp_rw [hdiv]
    rw [← integral_indicator hF, ← integral_indicator hpre]
    have h1 : ∫ z, F.indicator (fun z => r⁻¹ * Tg (S z)) z =
        ∫ u, F.indicator (fun z => r⁻¹ * Tg (S z)) (y + u) :=
      (integral_add_left_eq_self _ y).symm
    have h2 := Measure.integral_comp_smul (μ := volume)
      (fun u => F.indicator (fun z => r⁻¹ * Tg (S z)) (y + u)) r
    rw [finrank_euclideanSpace_fin] at h2
    have h3 : ∫ u, F.indicator (fun z => r⁻¹ * Tg (S z)) (y + u) =
        r ^ (m + 1) * ∫ x, F.indicator (fun z => r⁻¹ * Tg (S z)) (y + r • x) := by
      rw [h2, smul_eq_mul, ← mul_assoc, abs_inv, abs_of_pos (pow_pos hr _),
        mul_inv_cancel₀ (pow_ne_zero _ hr0), one_mul]
    rw [h1, h3]
    have h4 : ∀ x, F.indicator (fun z => r⁻¹ * Tg (S z)) (y + r • x) =
        r⁻¹ * ((fun w => y + r • w) ⁻¹' F).indicator Tg x := by
      intro x
      by_cases hx : y + r • x ∈ F
      · have hx' : x ∈ (fun w => y + r • w) ⁻¹' F := hx
        rw [Set.indicator_of_mem hx, Set.indicator_of_mem hx']
        simp [hS_def, smul_smul, inv_mul_cancel₀ hr0]
      · have hx' : x ∉ (fun w => y + r • w) ⁻¹' F := hx
        rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem hx', mul_zero]
    simp_rw [h4]
    rw [integral_const_mul, ← mul_assoc, pow_succ, mul_assoc (r ^ m), mul_inv_cancel₀ hr0, mul_one]
  -- Step 6: divide by `r^m > 0`.
  rw [hcv] at hGGφ
  calc ∫ w in (fun w => y + r • w) ⁻¹' F, Tg w
      = (r ^ m)⁻¹ * (r ^ m * ∫ w in (fun w => y + r • w) ⁻¹' F, Tg w) := by field_simp
    _ = -(r ^ m)⁻¹ * ∫ z, inner ℝ (g (r⁻¹ • (z - y))) (ν z) ∂μ := by rw [hGGφ]; ring
/-- **Flat Fubini in product coordinates** (step 3(a) of the chart co-area argument).  Put
`S = Ω ∩ Θ⁻¹(Y')` and `H = 𝟙_S |det DΘ| f ∘ Θ`, where `Θ` is `C¹` and injective on the open set
`Ω` and `Y' ⊆ Θ(Ω)` is Borel.  `S` is Borel (`Θ` is continuous on `Ω`) and `Θ(S) = Y'`, so the
injective change of variables gives `∫_{Y'} f = ∫ H`.  The map `(t, w) ↦ c(t, w) = (t, w₀, …)`
is a measure-preserving equivalence `ℝ × ℝⁿ ≅ ℝⁿ⁺¹`, so by Tonelli `t ↦ ∫ H(c(t, w)) dw` is Borel
and `∫∫ H(c(t, w)) dw dt = ∫ H`. -/
theorem Submission.dtc_bc_lc_sl_cc_flat_fubini : ∀ (n : ℕ) (c : ℝ → Euclid n → Euclid (n + 1)) (Ω Y' : Set (Euclid (n + 1))) (Θ : Euclid (n + 1) → Euclid (n + 1)) (f : Euclid (n + 1) → ℝ≥0∞), (∀ s w, c s w 0 = s ∧ ∀ i : Fin n, c s w i.succ = w i) → IsOpen Ω → ContDiffOn ℝ 1 Θ Ω → InjOn Θ Ω → Measurable f → MeasurableSet Y' → Y' ⊆ Θ '' Ω → Measurable (fun t => ∫⁻ w, (Ω ∩ Θ ⁻¹' Y').indicator (fun z => ENNReal.ofReal |(fderiv ℝ Θ z).det| * f (Θ z)) (c t w)) ∧ ∫⁻ t, ∫⁻ w, (Ω ∩ Θ ⁻¹' Y').indicator (fun z => ENNReal.ofReal |(fderiv ℝ Θ z).det| * f (Θ z)) (c t w) = ∫⁻ y in Y', f y := by
  intro n c Ω Y' Θ f hc hΩ hΘ hinj hf hY hYΩ
  classical
  -- the extension of `Θ` by `0` off `Ω` is Borel and agrees with `Θ` on `Ω`
  have hΘ' : Measurable (Ω.piecewise Θ 0) :=
    hΘ.continuousOn.measurable_piecewise continuousOn_const hΩ.measurableSet
  -- `S = Ω ∩ Θ⁻¹(Y')` is Borel
  have hS : MeasurableSet (Ω ∩ Θ ⁻¹' Y') := by
    have : Ω ∩ Θ ⁻¹' Y' = Ω ∩ Ω.piecewise Θ 0 ⁻¹' Y' := by
      ext z
      simp only [mem_inter_iff, mem_preimage]
      exact and_congr_right fun hz => by rw [piecewise_eq_of_mem _ _ _ hz]
    rw [this]
    exact hΩ.measurableSet.inter (hΘ' hY)
  -- `Θ(S) = Y'`, since `Y' ⊆ Θ(Ω)`
  have himage : Θ '' (Ω ∩ Θ ⁻¹' Y') = Y' := by
    refine Subset.antisymm (by rintro _ ⟨z, ⟨-, hz⟩, rfl⟩; exact hz) fun y hy => ?_
    obtain ⟨z, hz, rfl⟩ := hYΩ hy
    exact ⟨z, ⟨hz, hy⟩, rfl⟩
  -- injective change of variables: `∫_{Y'} f = ∫_S |det DΘ| f ∘ Θ`
  have hcov := lintegral_image_eq_lintegral_abs_det_fderiv_mul volume hS
    (fun z hz => ((hΘ.differentiableOn one_ne_zero z hz.1).differentiableAt
      (hΩ.mem_nhds hz.1)).hasFDerivAt.hasFDerivWithinAt) (hinj.mono inter_subset_left) f
  rw [himage] at hcov
  -- `H` is Borel: on `S`, `Θ` agrees with its Borel extension, and `DΘ` is Borel
  have hH : Measurable ((Ω ∩ Θ ⁻¹' Y').indicator
      fun z => ENNReal.ofReal |(fderiv ℝ Θ z).det| * f (Θ z)) := by
    rw [indicator_congr (g := fun z => ENNReal.ofReal |(fderiv ℝ Θ z).det| *
      f (Ω.piecewise Θ 0 z)) fun z hz => by simp only [piecewise_eq_of_mem _ _ _ hz.1]]
    exact ((ENNReal.measurable_ofReal.comp (continuous_abs.measurable.comp
      (ContinuousLinearMap.continuous_det.measurable.comp (measurable_fderiv ℝ Θ)))).mul
        (hf.comp hΘ')).indicator hS
  -- `(t, w) ↦ c(t, w)` is measure preserving, as the composite of the coordinate equivalences
  -- `ℝ × ℝⁿ ≅ ℝ × (Fin n → ℝ) ≅ (Fin (n + 1) → ℝ) ≅ ℝⁿ⁺¹`
  have hcoord : MeasurePreserving (fun p : ℝ × Euclid n => c p.1 p.2)
      (volume.prod volume) volume := by
    convert (PiLp.volume_preserving_toLp (Fin (n + 1))).comp
      ((volume_preserving_piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) 0).symm.comp
        ((MeasurePreserving.id volume).prod
          (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin n)))) using 1
    funext ⟨t, w⟩
    ext i
    refine Fin.cases ?_ (fun i => ?_) i
    · simp [(hc t w).1]
    · simp [(hc t w).2 i]
  -- Tonelli on `ℝ × ℝⁿ`, then the change of coordinates and the change of variables
  have hG : Measurable fun p : ℝ × Euclid n => (Ω ∩ Θ ⁻¹' Y').indicator
      (fun z => ENNReal.ofReal |(fderiv ℝ Θ z).det| * f (Θ z)) (c p.1 p.2) :=
    hH.comp hcoord.measurable
  refine ⟨hG.lintegral_prod_right', ?_⟩
  rw [← lintegral_prod _ hG.aemeasurable, hcoord.lintegral_comp hH, lintegral_indicator hS,
    hcov]
/-- **Eilenberg's covering estimate at one scale** (Simon Ch. 2, proof of Theorem 1.9: (1), `gᵢ`
and (2), case `m = 1`).  Choose a `δ`-cover `(Cᵢ)` of `A` with `∑ᵢ (diam Cᵢ)^(d+1)` below
`μH[d+1] A + ε`.  Then `ψ = ∑ᵢ (diam Cᵢ)ᵈ 𝟙_{f (closure Cᵢ)}` is Borel (the images are
σ-compact), the sets `closure Cᵢ ∩ A ∩ f⁻¹{t}` form a `δ`-cover of `A ∩ f⁻¹{t}` whose sum is at
most `ψ t`, and `L¹ (f (closure Cᵢ)) ≤ diam f (closure Cᵢ) ≤ L diam Cᵢ` bounds `∫ ψ`. -/
theorem Submission.dtc_bc_lc_sl_eil_scale : ∀ (P d : ℕ) (A : Set (Euclid P)) (f : Euclid P → ℝ) (L : NNReal) (δ ε : ℝ≥0∞), LipschitzWith L f → 0 < δ → 0 < ε → μH[((d + 1 : ℕ) : ℝ)] A ≠ ∞ → ∃ ψ : ℝ → ℝ≥0∞, Measurable ψ ∧ (∀ t : ℝ, (⨅ (c : ℕ → Set (Euclid P)) (_ : A ∩ f ⁻¹' {t} ⊆ ⋃ i, c i) (_ : ∀ i, Metric.ediam (c i) ≤ δ), ∑' i, ⨆ _ : (c i).Nonempty, Metric.ediam (c i) ^ (d : ℝ)) ≤ ψ t) ∧ ∫⁻ t, ψ t ≤ (L : ℝ≥0∞) * (μH[((d + 1 : ℕ) : ℝ)] A + ε) := by
  intro P d A f L δ ε hf hδ hε hA
  -- Simon's (1): a `δ`-cover `C` of `A` whose `(d + 1)`-sum is below `μH[d + 1] A + ε`
  have hcover : (⨅ (C : ℕ → Set (Euclid P)) (_ : A ⊆ ⋃ i, C i) (_ : ∀ i, ediam (C i) ≤ δ),
      ∑' i, ⨆ _ : (C i).Nonempty, ediam (C i) ^ (((d + 1 : ℕ) : ℝ))) <
        μH[((d + 1 : ℕ) : ℝ)] A + ε := by
    refine lt_of_le_of_lt ?_ (ENNReal.lt_add_right hA hε.ne')
    rw [Measure.hausdorffMeasure_apply]
    exact le_iSup₂_of_le δ hδ le_rfl
  obtain ⟨C, hcover⟩ := iInf_lt_iff.1 hcover
  obtain ⟨hAC, hcover⟩ := iInf_lt_iff.1 hcover
  obtain ⟨hCδ, hsum⟩ := iInf_lt_iff.1 hcover
  -- the images `f (closure (C i))` are σ-compact, hence Borel
  have hK : ∀ i, MeasurableSet (f '' closure (C i)) := fun i => by
    obtain ⟨K, hKc, hKu⟩ := (isSigmaCompact_univ.of_isClosed_subset isClosed_closure
      (subset_univ (closure (C i)))).image hf.continuous
    rw [← hKu]
    exact MeasurableSet.iUnion fun j => (hKc j).measurableSet
  -- Simon's `gᵢ`: `ψ = ∑ᵢ (diam Cᵢ)ᵈ 𝟙_{f (closure Cᵢ)}`
  refine ⟨fun t => ∑' i, (f '' closure (C i)).indicator (fun _ => ediam (C i) ^ (d : ℝ)) t,
    Measurable.tsum fun i => measurable_const.indicator (hK i), fun t => ?_, ?_⟩
  · -- Simon's (2): `(closure Cᵢ ∩ A ∩ f⁻¹{t})ᵢ` is an admissible `δ`-cover of `A ∩ f⁻¹{t}`
    refine iInf_le_of_le (fun i => closure (C i) ∩ (A ∩ f ⁻¹' {t})) <|
      iInf_le_of_le (fun x hx => ?_) <| iInf_le_of_le (fun i => ?_) <|
        ENNReal.tsum_le_tsum fun i => iSup_le fun ⟨x, hxC, _, hxt⟩ => ?_
    · obtain ⟨i, hi⟩ := mem_iUnion.1 (hAC hx.1)
      exact mem_iUnion.2 ⟨i, subset_closure hi, hx⟩
    · exact (ediam_mono inter_subset_left).trans ((ediam_closure _).trans_le (hCδ i))
    · rw [indicator_of_mem (show t ∈ f '' closure (C i) from ⟨x, hxC, hxt⟩)]
      exact ENNReal.rpow_le_rpow ((ediam_mono inter_subset_left).trans (ediam_closure _).le)
        (Nat.cast_nonneg d)
  · -- integrate term by term: `L¹ (f (closure Cᵢ)) ≤ diam f (closure Cᵢ) ≤ L diam Cᵢ`
    rw [lintegral_tsum fun i => (measurable_const.indicator (hK i)).aemeasurable]
    calc ∑' i, ∫⁻ t, (f '' closure (C i)).indicator (fun _ => ediam (C i) ^ (d : ℝ)) t
        ≤ ∑' i, (L : ℝ≥0∞) * ⨆ _ : (C i).Nonempty, ediam (C i) ^ (((d + 1 : ℕ) : ℝ)) := by
          refine ENNReal.tsum_le_tsum fun i => ?_
          rw [lintegral_indicator_const (hK i)]
          rcases (C i).eq_empty_or_nonempty with hC | hC
          · simp [hC]
          rw [iSup_pos hC, ENNReal.rpow_natCast, ENNReal.rpow_natCast, pow_succ]
          calc ediam (C i) ^ d * volume (f '' closure (C i))
              ≤ ediam (C i) ^ d * (L * ediam (C i)) := by
                gcongr
                exact (Real.volume_le_diam _).trans
                  ((hf.ediam_image_le _).trans_eq (by rw [ediam_closure]))
            _ = L * (ediam (C i) ^ d * ediam (C i)) := by ring
      _ = L * ∑' i, ⨆ _ : (C i).Nonempty, ediam (C i) ^ (((d + 1 : ℕ) : ℝ)) :=
          ENNReal.tsum_mul_left
      _ ≤ L * (μH[((d + 1 : ℕ) : ℝ)] A + ε) := mul_le_mul_right hsum.le _
/-- **Passage to the limit** (Simon Ch. 2, proof of Theorem 1.9, "letting `i → ∞`").  If the
`δ_k`-scale Hausdorff contents of `S t` are majorized by Borel functions `ψ_k` with
`∫ ψ_k ≤ B + ε_k`, where `δ_k → 0` and `ε_k → 0`, then `φ = liminf_k ψ_k` is a Borel majorant
of `t ↦ μH[d] (S t)` with `∫ φ ≤ B`: at a scale `r > 0` the content is eventually below
`ψ_k t` (coarser scales have smaller content), and Fatou's lemma bounds `∫ φ`. -/
theorem Submission.dtc_bc_lc_sl_eil_limit : ∀ (P : ℕ) (d : ℝ) (S : ℝ → Set (Euclid P)) (ψ : ℕ → ℝ → ℝ≥0∞) (δ ε : ℕ → ℝ≥0∞) (B : ℝ≥0∞), (∀ k, Measurable (ψ k)) → Tendsto δ atTop (𝓝 0) → Tendsto ε atTop (𝓝 0) → (∀ k t, (⨅ (c : ℕ → Set (Euclid P)) (_ : S t ⊆ ⋃ i, c i) (_ : ∀ i, Metric.ediam (c i) ≤ δ k), ∑' i, ⨆ _ : (c i).Nonempty, Metric.ediam (c i) ^ d) ≤ ψ k t) → (∀ k, ∫⁻ t, ψ k t ≤ B + ε k) → ∃ φ : ℝ → ℝ≥0∞, Measurable φ ∧ (∀ t, μH[d] (S t) ≤ φ t) ∧ ∫⁻ t, φ t ≤ B := by
  intro P d S ψ δ ε B hψ hδ hε hcontent hint
  refine ⟨fun t => liminf (fun k => ψ k t) atTop, Measurable.liminf hψ, fun t => ?_, ?_⟩
  · -- `μH[d] (S t)` is the supremum over scales `r > 0` of the content at scale `r`
    rw [Measure.hausdorffMeasure_apply]
    refine iSup₂_le fun r hr => le_liminf_of_le (h := ?_)
    -- eventually `δ_k ≤ r`, and a cover with diameters `≤ δ_k` is admissible at scale `r`
    filter_upwards [hδ.eventually_le_const hr] with k hk
    refine le_trans ?_ (hcontent k t)
    exact le_iInf fun c => le_iInf fun hc => le_iInf fun hcδ =>
      iInf_le_of_le c <| iInf_le_of_le hc <| iInf_le_of_le (fun i => (hcδ i).trans hk) le_rfl
  · -- Fatou's lemma, then `B + ε_k → B`
    calc ∫⁻ t, liminf (fun k => ψ k t) atTop ≤ liminf (fun k => ∫⁻ t, ψ k t) atTop :=
          lintegral_liminf_le hψ
      _ ≤ liminf (fun k => B + ε k) atTop := liminf_le_liminf (Eventually.of_forall hint)
      _ = B := by rw [(tendsto_const_nhds.add hε).liminf_eq, add_zero]
/-- **`C¹` approximation of Lipschitz functions** (Simon Ch. 2, Theorem 1.5).  If `f : ℝⁿ → ℝ` is
Lipschitz and `ε > 0`, some `g ∈ C¹(ℝⁿ)` has `Lⁿ({f ≠ g} ∪ {Df ≠ Dg}) < ε`.  By Rademacher, `f`
is differentiable off the null Borel set `Bᶜ`, and `Df` is Borel.  Lusin gives a closed `C ⊆ B`
with `Lⁿ(B \ C) < ε/2` on which `Df` is continuous; the remainder suprema and Egorov give a closed
`A ⊆ C` with `Lⁿ(C \ A) < ε/2` satisfying Whitney's hypothesis 1.6(∗) for `h = f`, `D = Df`; and
Whitney's extension gives `g ∈ C¹` with `g = f`, `Dg = Df` on `A`, so the bad set lies in
`Aᶜ ⊆ Bᶜ ∪ (B \ C) ∪ (C \ A)`. -/
theorem Submission.dtc_bc_lc_sl_c1_approx : ∀ (n : ℕ) (f : Euclid n → ℝ) (K : NNReal), LipschitzWith K f → ∀ ε : ℝ≥0∞, 0 < ε → ∃ g : Euclid n → ℝ, ContDiff ℝ 1 g ∧ volume {x | f x ≠ g x ∨ fderiv ℝ f x ≠ fderiv ℝ g x} < ε := by
  intro n f K hf ε hε
  have hε2 : 0 < ε / 2 := ENNReal.half_pos hε.ne'
  -- Rademacher: `f` is differentiable on the Borel set `B` with `Lⁿ(Bᶜ) = 0`, and `Df` is Borel
  set B : Set (Euclid n) := {x | DifferentiableAt ℝ f x}
  have hBc : volume Bᶜ = 0 := ae_iff.mp (hf.ae_differentiableAt (μ := volume))
  -- Lusin: a closed `C ⊆ B` with `Lⁿ(B \ C) < ε/2` on which `Df` is continuous
  obtain ⟨C, hCB, hC, hDfC, hBC⟩ := Submission.codim1_rdo_c1a_lusin_isClosed n (fderiv ℝ f) B
    (measurable_fderiv ℝ f) (measurableSet_of_differentiableAt ℝ f) (ε / 2) hε2
  -- Whitney's hypothesis 1.6(∗) for `h = f`, `D = Df` on a closed `A ⊆ C` with `Lⁿ(C \ A) < ε/2`
  obtain ⟨A, hAC, hA, hCA, hrem⟩ :=
    Submission.codim1_rdo_c1a_whitney_remainder n f K C hf hC (fun x hx => hCB hx) hDfC (ε / 2) hε2
  -- Whitney's extension: `g ∈ C¹` with `g = f` and `Dg = Df` on `A`
  obtain ⟨g, hg, hgf, hgD⟩ := Submission.codim1_rdo_c1a_whitney_extension n A f (fderiv ℝ f) hA
    hf.continuous.continuousOn (hDfC.mono hAC) hrem
  refine ⟨g, hg, ?_⟩
  -- the bad set lies in `Aᶜ ⊆ Bᶜ ∪ (B \ C) ∪ (C \ A)`
  calc volume {x | f x ≠ g x ∨ fderiv ℝ f x ≠ fderiv ℝ g x}
      ≤ volume (Bᶜ ∪ (B \ C) ∪ (C \ A)) := by
        refine measure_mono fun x hx => ?_
        by_cases hxA : x ∈ A
        · rcases hx with hx | hx
          · exact absurd (hgf hxA).symm hx
          · exact absurd (hgD x hxA).fderiv.symm hx
        by_cases hxC : x ∈ C
        · exact Or.inr ⟨hxC, hxA⟩
        by_cases hxB : x ∈ B
        · exact Or.inl (Or.inr ⟨hxB, hxC⟩)
        · exact Or.inl (Or.inl hxB)
    _ ≤ volume Bᶜ + volume (B \ C) + volume (C \ A) :=
        (measure_union_le _ _).trans (add_le_add (measure_union_le _ _) le_rfl)
    _ = volume (B \ C) + volume (C \ A) := by rw [hBc, zero_add]
    _ < ε / 2 + ε / 2 := ENNReal.add_lt_add hBC hCA
    _ = ε := ENNReal.add_halves ε
/-- **Simon Ch. 6, 3.1 and 2.16** (with Ch. 3, 1.4): if `T = τ(M, θ, ξ)` is integer multiplicity
in `U` and `V ⊆ U` is open, then `T⌞V = τ(M ∩ V, θ, ξ)` is integer multiplicity in `V`.  The
restricted triple inherits measurability, rectifiability, positivity and local integrability from
`(M, θ, ξ)`.  At `Hⁿ`-a.e. `x ∈ M ∩ V` the approximate tangent space of `M` is also that of
`M ∩ V`, as the removed set `M ∖ (M ∩ V)` misses the open set `V ∋ x`
(`dtc_approxTangent_of_null_diff`).  A test form supported in `V` vanishes on `M ∖ V`, so its
integrals over `M` and over `M ∩ V` agree.  Openness of `U` is not used. -/
theorem Submission.dtc_restrictDomain_isIntegerMultiplicity : ∀ (P n : ℕ) (U V : Set (Euclid P)) (hVU : V ⊆ U) (T : GeometricCurrentOn U n), IsOpen V → IsIntegerMultiplicity T → IsIntegerMultiplicity (T.restrictDomain hVU) := by
  rintro P n U V hVU T hV ⟨R, hR⟩
  -- Step 1: `M ∩ V` is Borel
  have hMV : MeasurableSet (R.carrier ∩ V) := R.measurableSet_carrier.inter hV.measurableSet
  -- the restricted triple `R' = (M ∩ V, θ, ξ)` in `V`
  let R' : IMRep V n :=
    { carrier := R.carrier ∩ V
      mult := R.mult
      orient := R.orient
      measurableSet_carrier := hMV
      -- Step 2: `M ∩ V ⊆ V`
      carrier_subset := inter_subset_right
      -- Step 3: a subset of a countably `n`-rectifiable set is countably `n`-rectifiable
      rectifiable := R.rectifiable.mono inter_subset_left
      -- Step 4: `θ` is measurable, and positive on `M ∩ V ⊆ M`
      measurable_mult := R.measurable_mult
      mult_pos := fun x hx => R.mult_pos x hx.1
      -- Step 5: for compact `K ⊆ V`, `(M ∩ V) ∩ K = M ∩ K` and `K ⊆ V ⊆ U`
      locallyIntegrable_mult := fun K hK hKV => by
        rw [inter_assoc, inter_eq_right.2 hKV]
        exact R.locallyIntegrable_mult K hK (hKV.trans hVU)
      -- Step 6: `Hⁿ⌞(M ∩ V) ≤ Hⁿ⌞M`
      aestronglyMeasurable_orient :=
        R.aestronglyMeasurable_orient.mono_measure (Measure.restrict_mono inter_subset_left le_rfl)
      -- Step 7: at `Hⁿ⌞(M ∩ V)`-a.e. `x`, the plane `Q` oriented by `ξ(x)` stays the approximate
      -- tangent space, since `(M ∖ (M ∩ V)) ∩ V = ∅`
      orients := by
        filter_upwards [ae_restrict_of_ae_restrict_of_subset
          (inter_subset_left : R.carrier ∩ V ⊆ R.carrier) R.orients, ae_restrict_mem hMV]
          with x hx hxMV
        obtain ⟨Q, hQ, hξQ⟩ := hx
        have hnull : μHE[n] ((R.carrier \ (R.carrier ∩ V)) ∩ V) = 0 := by
          rw [sdiff_self_inter, sdiff_inter_self, measure_empty]
        exact ⟨Q, Submission.dtc_approxTangent_of_null_diff P n R.carrier (R.carrier ∩ V) V x Q
          inter_subset_left hV hxMV.2 hnull hQ, hξQ⟩ }
  -- Step 8: `T⌞V(ω) = T(ιω) = ∫_M θ⟨ω, ξ⟩ dHⁿ = ∫_{M ∩ V} θ⟨ω, ξ⟩ dHⁿ`, as `ω = 0` off `V`
  refine ⟨R', fun ω => ?_⟩
  rw [GeometricCurrentOn.restrictDomain_apply, hR, testFormOnInclusion_coe]
  change ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x ((ω : DifferentialForm (Euclid P) n) x)
      ∂μHE[n] =
    ∫ x in R.carrier ∩ V, (R.mult x : ℝ) * R.orient x ((ω : DifferentialForm (Euclid P) n) x)
      ∂μHE[n]
  refine setIntegral_eq_of_subset_of_forall_sdiff_eq_zero R.measurableSet_carrier
    inter_subset_left fun x hx => ?_
  have hxω : x ∉ tsupport (ω : DifferentialForm (Euclid P) n) :=
    fun h => hx.2 ⟨hx.1, ω.property.2 h⟩
  rw [image_eq_zero_of_notMem_tsupport hxω, map_zero, mul_zero]
/-- **`S⌞W` as an integer multiplicity current in `ℝᴾ`** (Simon Ch. 6, 3.1 and 2.11; the
restriction device of step 2 in the proof of 7.2.4 for minimizers in a submanifold).  Let `U` be
open, `W ⊂⊂ U` open and `S = τ(M, θ, ξ)` in `U`.  Then `Q = τ(M ∩ W, θ, ξ) ∈ 𝒟ₙ(ℝᴾ)` satisfies
`Q(ω) = S(ω)` for `ω ∈ 𝒟ⁿ(U)` with `spt ω ⊆ W`, and `spt Q ⊆ W̄ ∩ spt S` is compact.
* `(M ∩ W, θ, ξ)` is a triple in `U` (restriction to the Borel set `W`), and it is locally
  integrable in all of `ℝᴾ` because `M ∩ W` lies in the compact set `W̄ ⊆ U`.
* A form supported in `W` vanishes on `M \ W`, so its integrals over `M` and `M ∩ W` agree.
* `S` vanishes off its support, so `M_{U \ spt S}(S) = 0`; hence `θHⁿ⌞M(U \ spt S) = 0`, and as
  `θ ≥ 1` on `M ⊆ U`, `Hⁿ(M \ spt S) = 0`.
* So `Q` kills every form whose support misses the compact set `W̄ ∩ spt S`. -/
theorem Submission.dtc_bc_lc_rc_ambient_restriction : ∀ (P n : ℕ) (U W : Set (Euclid P)) (S : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → IsOpen W → CompactlyContained W U → R.Represents S → ∃ (Q : GeometricCurrentOn (univ : Set (Euclid P)) n) (RQ : IMRep (univ : Set (Euclid P)) n), RQ.Represents Q ∧ RQ.carrier = R.carrier ∩ W ∧ RQ.mult = R.mult ∧ RQ.orient = R.orient ∧ (∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ W → Q (testFormOnInclusion (subset_univ U) n ω) = S ω) ∧ Q.support ⊆ closure W ∩ S.support ∧ IsCompact Q.support := by
  have hIM := Submission.cmc_imRep_locality_restrict_sub
  have hM := Submission.dtc_mass_eq_measure
  have hV := Submission.dtc_vanish_off_support
  have hSV := Submission.rsd_cmr_support_subset_of_vanish
  intro P n U W S R hU hW hWU hR
  -- Step 1: the triple `(M ∩ W, θ, ξ)` in `U`
  obtain ⟨A₀, R', -, hR'c, hR'm, hR'o⟩ := hIM.2.1 P n U R W hU hW.measurableSet
  have hrect : CountablyRectifiable n (R.carrier ∩ W) := hR'c ▸ R'.rectifiable
  have hasm : AEStronglyMeasurable R.orient (μHE[n].restrict (R.carrier ∩ W)) := by
    rw [← hR'c, ← hR'o]; exact R'.aestronglyMeasurable_orient
  have hor : ∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ W)), ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n (R.carrier ∩ W) x Q ∧ IsUnitOrientationOf (R.orient x) Q := by
    rw [← hR'c, ← hR'o]; exact R'.orients
  -- Step 2: the same triple in `ℝᴾ`; for compact `K`, `(M ∩ W) ∩ K ⊆ M ∩ W̄` with `W̄ ⊆ U` compact
  let R₀ : IMRep (univ : Set (Euclid P)) n :=
    { carrier := R.carrier ∩ W
      mult := R.mult
      orient := R.orient
      measurableSet_carrier := R.measurableSet_carrier.inter hW.measurableSet
      carrier_subset := subset_univ _
      rectifiable := hrect
      measurable_mult := R.measurable_mult
      mult_pos := fun x hx => R.mult_pos x hx.1
      locallyIntegrable_mult := fun K _ _ => by
        apply ne_top_of_le_ne_top (R.locallyIntegrable_mult (closure W) hWU.1 hWU.2)
        apply lintegral_mono_set
        intro x hx
        exact ⟨hx.1.1, subset_closure hx.1.2⟩
      aestronglyMeasurable_orient := hasm
      orients := hor }
  -- Step 3: the current `Q = τ(M ∩ W, θ, ξ)` in `ℝᴾ`
  obtain ⟨Q, RQ, hRQ, hRQc, hRQm, hRQo⟩ := hIM.2.1 P n univ R₀ univ isOpen_univ MeasurableSet.univ
  have hRQc' : RQ.carrier = R.carrier ∩ W := by rw [hRQc]; exact inter_univ _
  -- Step 5: `Hⁿ(M \ spt S) = 0`
  have hnull : μHE[n] (R.carrier \ S.support) = 0 := by
    -- `O = U \ spt S = U ∩ Z(S)` is open
    have hopen : IsOpen (U \ S.support) := by
      have : U \ S.support = U ∩ S.zeroRegion := by
        ext x
        simp only [GeometricCurrentOn.support, Set.mem_sdiff, mem_inter_iff, not_and, not_not]
        constructor
        · intro h; exact ⟨h.1, h.2 h.1⟩
        · intro h; exact ⟨h.1, fun _ => h.2⟩
      rw [this]
      exact hU.inter S.isOpen_zeroRegion
    -- `M_O(S) = 0`: every admissible form is supported off `spt S`
    have hmass : S.massOn (U \ S.support) = 0 := by
      apply le_zero_iff.mp
      apply sSup_le
      rintro r ⟨ω, hω, rfl⟩
      show ENNReal.ofReal (S ω) ≤ 0
      rw [hV P n U S ω (by
        rw [← Set.subset_compl_iff_disjoint_right]
        exact hω.1.trans (fun x hx => hx.2)), ENNReal.ofReal_zero]
    -- `∫_{O ∩ M} θ dHⁿ = M_O(S) = 0`
    have hmeas : R.measure (U \ S.support) = 0 := by
      rw [← hM P n U (U \ S.support) S R hU hopen sdiff_subset hR, hmass]
    unfold IMRep.measure at hmeas
    rw [withDensity_apply _ hopen.measurableSet, Measure.restrict_restrict hopen.measurableSet] at hmeas
    -- `θ ≥ 1` on `M`
    have hle : μHE[n] ((U \ S.support) ∩ R.carrier) ≤
        ∫⁻ x in (U \ S.support) ∩ R.carrier, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
      calc μHE[n] ((U \ S.support) ∩ R.carrier)
          = ∫⁻ x in (U \ S.support) ∩ R.carrier, (1 : ℝ≥0∞) ∂μHE[n] := by
            rw [setLIntegral_const, one_mul]
        _ ≤ ∫⁻ x in (U \ S.support) ∩ R.carrier, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
            apply setLIntegral_mono' (hopen.measurableSet.inter R.measurableSet_carrier)
            intro x hx
            have := R.mult_pos x hx.2
            exact_mod_cast this
    have h0 : μHE[n] ((U \ S.support) ∩ R.carrier) = 0 := le_zero_iff.mp (hmeas ▸ hle)
    -- `M ⊆ U`, so `M \ spt S ⊆ O ∩ M`
    apply measure_mono_null _ h0
    intro x hx
    exact ⟨⟨R.carrier_subset hx.1, hx.2⟩, hx.1⟩
  refine ⟨Q, RQ, hRQ, hRQc', hRQm, hRQo, ?_, ?_⟩
  · -- Step 4 (Q1): `ω = 0` on `M \ W`, so the integrals over `M` and `M ∩ W` agree
    intro ω hω
    rw [hRQ, hR ω]
    unfold IMRep.action
    rw [hRQc', hRQm, hRQo, testFormOnInclusion_coe]
    symm
    apply setIntegral_eq_of_subset_of_forall_sdiff_eq_zero R.measurableSet_carrier inter_subset_left
    intro x hx
    have : (ω : DifferentialForm (Euclid P) n) x = 0 :=
      image_eq_zero_of_notMem_tsupport (fun h => hx.2 ⟨hx.1, hω h⟩)
    simp [this]
  · -- Step 6 (Q2): `K = W̄ ∩ spt S = W̄ ∩ Z(S)ᶜ` is compact
    have hKcpt : IsCompact (closure W ∩ S.support) := by
      have : closure W ∩ S.support = closure W ∩ (S.zeroRegion)ᶜ := by
        ext x
        simp only [GeometricCurrentOn.support, mem_inter_iff, Set.mem_sdiff, mem_compl_iff]
        constructor
        · intro h; exact ⟨h.1, h.2.2⟩
        · intro h; exact ⟨h.1, hWU.2 h.1, h.2⟩
      rw [this]
      exact hWU.1.inter_right S.isOpen_zeroRegion.isClosed_compl
    -- `Hⁿ`-a.e. point of `M ∩ W` lies in `K`, where a form supported off `K` vanishes
    exact hSV P n univ (closure W ∩ S.support) Q isOpen_univ hKcpt (subset_univ _) (fun ω hω => by
      rw [hRQ ω]
      unfold IMRep.action
      rw [hRQc', hRQm, hRQo]
      apply integral_eq_zero_of_ae
      have hn' : μHE[n] ((R.carrier ∩ W) \ S.support) = 0 :=
        measure_mono_null (sdiff_subset_sdiff_left inter_subset_left) hnull
      have hae : ∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ W)), x ∈ S.support := by
        rw [ae_restrict_iff' (R.measurableSet_carrier.inter hW.measurableSet)]
        rw [ae_iff]
        apply measure_mono_null _ hn'
        intro x hx
        simp only [Set.mem_ofPred_eq, not_imp] at hx
        exact ⟨hx.1, hx.2⟩
      filter_upwards [hae, ae_restrict_mem (R.measurableSet_carrier.inter hW.measurableSet)]
        with x hx hxM
      have : (ω : DifferentialForm (Euclid P) n) x = 0 :=
        image_eq_zero_of_notMem_tsupport (fun h =>
          hω.ne_of_mem h ⟨subset_closure hxM.2, hx⟩ rfl)
      simp [this])
/-- **Simon 7.2.4 (9)** (adding a cycle does not lower the mass of a minimizing current).  Let
`S ∈ 𝒟ₙ(U)` be minimizing in `A`, `W ⊂⊂ U` open, and `X ∈ 𝒟ₙ(ℝᴾ)` integer multiplicity with
`∂X = 0` and `spt X ⊆ K`, `K ⊆ A ∩ W` compact.  Then `M_W(S) ≤ M_W(Z)` for
`Z = S − (0 − X|_U) = S + X|_U`, an admissible competitor: `Z` is integer multiplicity
(`0 = X|_U − X|_U` and closure under differences), `∂Z = ∂S` since `X|_U(dω) = ∂X(ω) = 0`, and
`Z − S = X|_U` vanishes on forms supported off `K ⊇ spt X`, so `spt(Z − S)` is a compact subset
of `K ⊆ A ∩ W`. -/
theorem Submission.dtc_bc_lc_rc_cycle_competitor : ∀ (P m : ℕ) (U A W K : Set (Euclid P)) (S : GeometricCurrentOn U (m + 1)) (X : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsOpen U → IsMinimizingIn S A → IsOpen W → CompactlyContained W U → IsIntegerMultiplicity X → X.boundary = 0 → IsCompact K → X.support ⊆ K → K ⊆ A ∩ W → S.massOn W ≤ (S - (0 - X.restrictDomain (subset_univ U))).massOn W := by
  intro P m U A W K S X hU hmin hW hWU hXim hXbd hK hXK hKAW
  have hsub := Submission.cmc_imRep_locality_restrict_sub.2.2.1 P (m + 1) U
  set XU := X.restrictDomain (subset_univ U)
  -- `X|_U`, `0 = X|_U − X|_U` and `Z = S − (0 − X|_U)` are integer multiplicity
  have hXUim : IsIntegerMultiplicity XU :=
    Submission.dtc_restrictDomain_isIntegerMultiplicity P (m + 1) univ U (subset_univ U) X hU hXim
  have h0im : IsIntegerMultiplicity (0 : GeometricCurrentOn U (m + 1)) := by
    have h0 : XU - XU = 0 := by
      ext ω
      exact sub_self (XU ω)
    have h := hsub XU XU hU hXUim hXUim
    rwa [h0] at h
  have hZim : IsIntegerMultiplicity (S - (0 - XU)) := hsub S _ hU hmin.1 (hsub 0 XU hU h0im hXUim)
  -- `∂Z = ∂S`, since `X|_U(dω) = X(d(ιω)) = ∂X(ιω) = 0`
  have hbd : SameBoundary (S - (0 - XU)) S := by
    show (S - (0 - XU)).boundary = S.boundary
    ext ω
    have hdX : XU (exteriorDerivativeTestOn U m ω) = 0 :=
      congrArg (fun T : GeometricCurrentOn (univ : Set (Euclid P)) m =>
        T (testFormOnInclusion (subset_univ U) m ω)) hXbd
    show S (exteriorDerivativeTestOn U m ω) - (0 - XU (exteriorDerivativeTestOn U m ω)) =
      S (exteriorDerivativeTestOn U m ω)
    rw [hdX, sub_zero, sub_zero]
  -- `Z − S = X|_U` vanishes on forms supported off `K ⊇ spt X`, so `spt (Z − S) ⊆ K`
  have hKU : K ⊆ U := fun x hx => hWU.2 (subset_closure (hKAW hx).2)
  have hspt := Submission.rsd_cmr_support_subset_of_vanish P (m + 1) U K (S - (0 - XU) - S) hU hK
    hKU fun ω hω => by
      have hX0 : XU ω = 0 := Submission.dtc_vanish_off_support P (m + 1) univ X
        (testFormOnInclusion (subset_univ U) (m + 1) ω) (hω.mono_right hXK)
      show S ω - (0 - XU ω) - S ω = 0
      rw [hX0, sub_zero, sub_zero, sub_self]
  exact hmin.2 W _ hW hWU hZim hbd hspt.2 (hspt.1.trans hKAW)
/-- Mass agrees away from `spt (S − T)`.  If `spt (S − T) ⊆ K` and `G ∩ K = ∅`, then
`M_G(S) = M_G(T)`.  Both masses are suprema over the same admissible forms `ω ∈ 𝒟ⁿ(U)` with
`spt ω ⊆ G` and `|ω| ≤ 1`; for each of them `spt ω` misses `spt (S − T) ⊆ K`, so
`S(ω) − T(ω) = (S − T)(ω) = 0` by Simon 6.2.11. -/
theorem Submission.cmc_ml_massOn_eq_of_disjoint_sub_support : ∀ (P n : ℕ) (U : Set (Euclid P)) (S T : GeometricCurrentOn U n) (K G : Set (Euclid P)), (S - T).support ⊆ K → Disjoint G K → S.massOn G = T.massOn G := by
  intro P n U S T K G hK hGK
  -- `M_G(S)` and `M_G(T)` are suprema over the same admissible set
  refine congrArg sSup (Set.image_congr fun ω hω => ?_)
  -- `spt ω ⊆ G` misses `spt (S − T) ⊆ K`, so `S(ω) − T(ω) = (S − T)(ω) = 0`
  have h0 : S ω - T ω = 0 :=
    Submission.dtc_vanish_off_support P n U (S - T) ω (Disjoint.mono hω.1 hK hGK)
  exact congrArg ENNReal.ofReal (sub_eq_zero.mp h0)
/-- **Compactly supported C¹ perturbation of the identity** (the cut-off `ζ` of Simon Ch. 6, 2.23,
applied to `f − id`).  Let `O ⊆ ℝᴾ` be open, `K ⊆ O` compact and `f` of class C¹ on `O`.  Choose
`ρ > 0` with `cthickening ρ K ⊆ O` and, by the smooth Urysohn lemma, a smooth `χ : ℝᴾ → [0, 1]`
with `support χ = thickening ρ K` and `χ = 1` on `cthickening (ρ/2) K`.  Then
`φ = id + χ • (f − id)` is C¹ (it is C¹ at points of `O`, and equals `id` near points off
`K' = tsupport χ ⊆ cthickening ρ K ⊆ O`), `K'` is compact, `φ = id` off `K'`, and `φ = f` on the
open `V = thickening (ρ/2) K ⊇ K`, so `φ x = f x` and `Dφ(x) = Df(x)` for `x ∈ V`. -/
theorem Submission.dtc_bc_lc_pf_c1_compact_perturbation : ∀ (P : ℕ) (O K : Set (Euclid P)) (f : Euclid P → Euclid P), IsOpen O → IsCompact K → K ⊆ O → ContDiffOn ℝ 1 f O → ∃ (φ : Euclid P → Euclid P) (V K' : Set (Euclid P)), IsOpen V ∧ K ⊆ V ∧ IsCompact K' ∧ ContDiff ℝ 1 φ ∧ (∀ x ∈ V, φ x = f x ∧ fderiv ℝ φ x = fderiv ℝ f x) ∧ ∀ x, x ∉ K' → φ x = x := by
  intro P O K f hO hK hKO hf
  -- Step 1: a margin `ρ > 0` with `cthickening ρ K ⊆ O`
  obtain ⟨ρ, hρ, hρO⟩ := hK.exists_cthickening_subset_open hO hKO
  -- Step 2: a smooth cut-off `χ` with `support χ = thickening ρ K`, `χ = 1` on `cthickening (ρ/2) K`
  obtain ⟨χ, hχ, -, hχs, hχt⟩ := exists_contDiff_support_eq_eq_one_iff (n := 1)
    (isOpen_thickening : IsOpen (thickening ρ K))
    (isClosed_cthickening : IsClosed (cthickening (ρ / 2) K))
    (cthickening_subset_thickening' hρ (half_lt_self hρ) K)
  have hχ1 : ContDiff ℝ 1 χ := by exact_mod_cast hχ
  -- `K' := tsupport χ ⊆ cthickening ρ K ⊆ O` is compact
  have hK'sub : tsupport χ ⊆ cthickening ρ K := by
    rw [tsupport, hχs]
    exact closure_thickening_subset_cthickening ρ K
  have hK'O : tsupport χ ⊆ O := hK'sub.trans hρO
  have hK'cpt : IsCompact (tsupport χ) :=
    hK.cthickening.of_isClosed_subset (isClosed_tsupport χ) hK'sub
  -- Step 3: the perturbation `φ = id + χ • (f - id)`, with `V = thickening (ρ/2) K`
  refine ⟨fun x => x + χ x • (f x - x), thickening (ρ / 2) K, tsupport χ, isOpen_thickening,
    self_subset_thickening (half_pos hρ) K, hK'cpt, ?_, ?_, ?_⟩
  · -- Step 4: `φ` is C¹ at points of `O` (as `f` is) and near points off `tsupport χ` (`φ = id`)
    rw [contDiff_iff_contDiffAt]
    intro x
    by_cases hx : x ∈ O
    · have hfx : ContDiffAt ℝ 1 f x := hf.contDiffAt (hO.mem_nhds hx)
      exact contDiffAt_id.add (hχ1.contDiffAt.smul (hfx.sub contDiffAt_id))
    · have hx' : x ∉ tsupport χ := fun h => hx (hK'O h)
      have hev : (fun y => y + χ y • (f y - y)) =ᶠ[𝓝 x] id := by
        filter_upwards [notMem_tsupport_iff_eventuallyEq.1 hx'] with y hy
        simp [hy]
      exact contDiffAt_id.congr_of_eventuallyEq hev
  · -- Step 5: `χ = 1` on the open set `V`, so `φ = f` near each `x ∈ V`
    intro x hx
    have hev : (fun y => y + χ y • (f y - y)) =ᶠ[𝓝 x] f := by
      filter_upwards [isOpen_thickening.mem_nhds hx] with y hy
      have hy1 : χ y = 1 := (hχt y).1 (thickening_subset_cthickening _ _ hy)
      simp [hy1]
    exact ⟨hev.eq_of_nhds, hev.fderiv_eq⟩
  · -- Step 6: `χ = 0` off `tsupport χ`, so `φ = id` there
    intro x hx
    simp [image_eq_zero_of_notMem_tsupport hx]
/-- An open `U ⊆ ℝᴾ` is exhausted by the compact sets
`Kᵢ = B̄(0, i + 1) ∩ {x : 1 / (i + 1) ≤ dist(x, y) for all y ∉ U}`: each `Kᵢ ⊆ U` (take `y = x`),
and a compact `C ⊆ U` has a margin `δ > 0` with `thickening δ C ⊆ U` and a radius `R` with
`C ⊆ B̄(0, R)`, so `C ⊆ Kᵢ` once `1 / (i + 1) < δ` and `R ≤ i + 1`. -/
theorem Submission.dor_lmbs_tfa_compact_exhaustion : ∀ (P : ℕ) (U : Set (Euclid P)), IsOpen U → ∃ K : ℕ → Set (Euclid P), (∀ i, IsCompact (K i)) ∧ (∀ i, K i ⊆ U) ∧ ∀ C : Set (Euclid P), IsCompact C → C ⊆ U → ∃ i, C ⊆ K i := by
  intro P U hU
  refine ⟨fun i => closedBall (0 : Euclid P) ((i : ℝ) + 1) ∩ ⋂ y ∈ Uᶜ, {x | 1 / ((i : ℝ) + 1) ≤ dist x y},
    fun i => ?_, fun i => ?_, fun C hC hCU => ?_⟩
  · exact (isCompact_closedBall _ _).inter_right
      (isClosed_biInter fun y _ => isClosed_le continuous_const (continuous_id.dist continuous_const))
  · -- `x ∉ U` would give `1 / (i + 1) ≤ dist x x = 0`
    intro x hx
    by_contra hxU
    have h : 1 / ((i : ℝ) + 1) ≤ dist x x := mem_iInter₂.1 hx.2 x hxU
    rw [dist_self] at h
    have : (0 : ℝ) < 1 / ((i : ℝ) + 1) := by positivity
    linarith
  · obtain ⟨δ, hδ, hδU⟩ := hC.exists_thickening_subset_open hU hCU
    obtain ⟨R, hR⟩ := hC.isBounded.subset_closedBall (0 : Euclid P)
    obtain ⟨N, hN⟩ := exists_nat_one_div_lt hδ
    obtain ⟨M, hM⟩ := exists_nat_ge R
    have hNi : (N : ℝ) ≤ (max N M : ℕ) := by exact_mod_cast le_max_left N M
    have hMi : (M : ℝ) ≤ (max N M : ℕ) := by exact_mod_cast le_max_right N M
    refine ⟨max N M, fun x hx => ⟨?_, mem_iInter₂.2 fun y hy => ?_⟩⟩
    · have hxR := mem_closedBall.1 (hR hx)
      rw [mem_closedBall]
      linarith
    · -- `y ∉ thickening δ C` gives `δ ≤ dist x y`
      have hxy : δ ≤ dist x y := by
        by_contra h
        exact hy (hδU (mem_thickening_iff.2 ⟨x, hx, by rw [dist_comm]; linarith⟩))
      have hle : 1 / (((max N M : ℕ) : ℝ) + 1) ≤ 1 / ((N : ℝ) + 1) :=
        one_div_le_one_div_of_le (by positivity) (by linarith)
      show 1 / (((max N M : ℕ) : ℝ) + 1) ≤ dist x y
      linarith
/-- `Λⁿ(ℝᴾ)` is finite-dimensional: `α ↦ (α(e_{I(1)}, …, e_{I(n)}))_{I : Fin n → Fin P}` is a linear
map into the finite-dimensional space `(Fin n → Fin P) → ℝ`, injective because an alternating map
is determined by its values on tuples of basis vectors. -/
theorem Submission.dor_lmbs_tfa_covector_finiteDimensional : ∀ (P n : ℕ), FiniteDimensional ℝ (Covector (Euclid P) n) := by
  intro P n
  let e := (EuclideanSpace.basisFun (Fin P) ℝ).toBasis
  -- `L α = (α(e ∘ I))_I`
  let L : Covector (Euclid P) n →ₗ[ℝ] (Fin n → Fin P) → ℝ :=
    { toFun := fun α I => α fun k => e (I k)
      map_add' := fun α β => rfl
      map_smul' := fun c α => rfl }
  refine FiniteDimensional.of_injective L fun α β h => ?_
  apply ContinuousAlternatingMap.toAlternatingMap_injective
  exact e.ext_alternating fun v _ => congrFun h v

/-- Test forms supported in a fixed compact `K` have a countable subfamily `D` approximating every
such `ω` together with `dω`, uniformly on `ℝᴾ`.  The covector spaces are finite-dimensional
(`dor_lmbs_tfa_covector_finiteDimensional`), so `C(K, Λⁿ × Λⁿ⁺¹)` is second countable; pull back
a countable dense subset of the image of `X = {ω : spt ω ⊆ K}` under `Φ ω = (ω, dω)|_K`.  On `K`
the pointwise distances are at most the uniform distance; off `K` all four values vanish. -/
theorem Submission.dor_lmbs_tfa_fixed_support_dense : ∀ (P n : ℕ) (U K : Set (Euclid P)), IsCompact K → ∃ D : Set (TestFormOn U n), D.Countable ∧ (∀ η ∈ D, tsupport (η : DifferentialForm (Euclid P) n) ⊆ K) ∧ ∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ K → ∀ ε : ℝ, 0 < ε → ∃ η ∈ D, (∀ x, dist ((ω : DifferentialForm (Euclid P) n) x) ((η : DifferentialForm (Euclid P) n) x) < ε) ∧ ∀ x, dist (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) (exteriorDerivative (η : DifferentialForm (Euclid P) n) x) < ε := by
  intro P n U K hK
  -- Step 1: a form supported in `K` vanishes off `K`, and so does its exterior derivative
  have hzero : ∀ η : TestFormOn U n, tsupport (η : DifferentialForm (Euclid P) n) ⊆ K →
      ∀ x ∉ K, (η : DifferentialForm (Euclid P) n) x = 0 ∧
        exteriorDerivative (η : DifferentialForm (Euclid P) n) x = 0 := fun η hη x hx =>
    ⟨image_eq_zero_of_notMem_tsupport fun h => hx (hη h),
      image_eq_zero_of_notMem_tsupport fun h => hx (hη (tsupport_exteriorDerivative_subset _ h))⟩
  -- Step 2: `Λⁿ` and `Λⁿ⁺¹` are finite-dimensional, hence proper and second countable
  have := Submission.dor_lmbs_tfa_covector_finiteDimensional P n
  have := Submission.dor_lmbs_tfa_covector_finiteDimensional P (n + 1)
  have : ProperSpace (Covector (Euclid P) n) := FiniteDimensional.proper_real _
  have : ProperSpace (Covector (Euclid P) (n + 1)) := FiniteDimensional.proper_real _
  have : SecondCountableTopology (Covector (Euclid P) n) := secondCountable_of_proper
  have : SecondCountableTopology (Covector (Euclid P) (n + 1)) := secondCountable_of_proper
  -- Step 3: `K` is compact, so `C(K, Λⁿ × Λⁿ⁺¹)` carries the sup metric, and it is second
  -- countable: up to `ε`, `f` is determined by a modulus `j` of uniform continuity at scale `ε / 4`
  -- and by the indices, in a dense sequence `s`, of `ε / 4`-approximations of its values on a
  -- finite `1 / (j + 1)`-net `t j` of `K`
  have : CompactSpace K := isCompact_iff_compactSpace.mp hK
  have : SecondCountableTopology C(K, Covector (Euclid P) n × Covector (Euclid P) (n + 1)) := by
    refine Metric.secondCountable_of_countable_discretization
      (α := C(K, Covector (Euclid P) n × Covector (Euclid P) (n + 1))) fun ε hε => ?_
    obtain ⟨s, hs⟩ := TopologicalSpace.exists_dense_seq
      (Covector (Euclid P) n × Covector (Euclid P) (n + 1))
    choose r hr using fun y : Covector (Euclid P) n × Covector (Euclid P) (n + 1) =>
      hs.exists_dist_lt y (by positivity : (0 : ℝ) < ε / 4)
    have hnet : ∀ j : ℕ, ∃ t : Finset K, ∀ x : K, ∃ p ∈ t, dist x p < 1 / ((j : ℝ) + 1) := by
      intro j
      obtain ⟨t, -, ht⟩ := (isCompact_univ : IsCompact (univ : Set K)).elim_nhds_subcover
        (fun x => ball x (1 / ((j : ℝ) + 1))) fun x _ => ball_mem_nhds x (by positivity)
      exact ⟨t, fun x => by simpa using ht (mem_univ x)⟩
    choose t ht using hnet
    have hmod : ∀ f : C(K, Covector (Euclid P) n × Covector (Euclid P) (n + 1)), ∃ j : ℕ,
        ∀ x y : K, dist x y < 1 / ((j : ℝ) + 1) → dist (f x) (f y) < ε / 4 := by
      intro f
      obtain ⟨δ, hδ, hfδ⟩ := Metric.uniformContinuous_iff.1
        (CompactSpace.uniformContinuous_of_continuous f.continuous) (ε / 4) (by positivity)
      obtain ⟨j, hj⟩ := exists_nat_one_div_lt hδ
      exact ⟨j, fun x y hxy => hfδ (hxy.trans hj)⟩
    choose J hJ using hmod
    refine ⟨ℕ × List ℕ, inferInstance, fun f => (J f, (t (J f)).toList.map fun p => r (f p)),
      fun f g hfg => (ContinuousMap.dist_le hε.le).2 fun x => ?_⟩
    obtain ⟨hj, hl⟩ := Prod.mk.inj hfg
    rw [← hj] at hl
    -- `x` is `1 / (j + 1)`-close to a net point `p`, where `f p` and `g p` have a common index
    obtain ⟨p, hp, hxp⟩ := ht (J f) x
    have hrp : r (f p) = r (g p) := List.map_inj_left.1 hl p (Finset.mem_toList.2 hp)
    have h₁ := hJ f x p hxp
    have h₂ := hr (f p)
    have h₃ := hr (g p)
    have h₄ := hJ g x p (hj ▸ hxp)
    rw [hrp] at h₂
    rw [dist_comm] at h₃ h₄
    linarith [dist_triangle4 (f x) (f p) (s (r (g p))) (g x),
      dist_triangle (s (r (g p))) (g p) (g x)]
  -- Step 4: `Φ ω = (ω, dω)|_K`
  let Φ : TestFormOn U n → C(K, Covector (Euclid P) n × Covector (Euclid P) (n + 1)) := fun ω =>
    ⟨fun x => ((ω : DifferentialForm (Euclid P) n) x,
        exteriorDerivative (ω : DifferentialForm (Euclid P) n) x),
      (ω.property.1.1.continuous.prodMk
        (exteriorDerivative_isTestForm ω.property.1).1.continuous).comp continuous_subtype_val⟩
  let X : Set (TestFormOn U n) := {ω | tsupport (ω : DifferentialForm (Euclid P) n) ⊆ K}
  -- Step 5: a countable `T ⊆ Φ(X)` dense in `Φ(X)`, and a choice `σ` of preimages in `X`
  obtain ⟨T, hTc, hTX, hXT⟩ := TopologicalSpace.exists_countable_dense_subset (Φ '' X)
  have hT : ∀ t ∈ T, ∃ η, η ∈ X ∧ Φ η = t := fun t ht => hTX ht
  choose! σ hσX hσΦ using hT
  -- Step 6: `D = σ(T)` is countable and supported in `K`
  refine ⟨σ '' T, hTc.image σ, ?_, ?_⟩
  · rintro _ ⟨t, ht, rfl⟩
    exact hσX t ht
  -- Step 7: pick `t ∈ T` with `dist (Φ ω) t < ε` and put `η = σ t`
  intro ω hω ε hε
  obtain ⟨t, ht, hdist⟩ := (Metric.mem_closure_iff
    (α := C(K, Covector (Euclid P) n × Covector (Euclid P) (n + 1)))).1 (hXT ⟨ω, hω, rfl⟩) ε hε
  rw [← hσΦ t ht] at hdist
  have key : ∀ x, dist ((ω : DifferentialForm (Euclid P) n) x)
      ((σ t : DifferentialForm (Euclid P) n) x) < ε ∧
      dist (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x)
        (exteriorDerivative (σ t : DifferentialForm (Euclid P) n) x) < ε := by
    intro x
    by_cases hx : x ∈ K
    · -- (a) on `K`: both distances are at most `dist (Φ ω) (Φ η) < ε`
      have h := (ContinuousMap.dist_apply_le_dist (f := Φ ω) (g := Φ (σ t)) ⟨x, hx⟩).trans_lt hdist
      rw [Prod.dist_eq] at h
      exact ⟨(le_max_left _ _).trans_lt h, (le_max_right _ _).trans_lt h⟩
    · -- (b) off `K`: all four values vanish
      obtain ⟨h₁, h₂⟩ := hzero ω hω x hx
      obtain ⟨h₃, h₄⟩ := hzero (σ t) (hσX t ht) x hx
      rw [h₁, h₂, h₃, h₄, dist_self, dist_self]
      exact ⟨hε, hε⟩
  exact ⟨σ t, ⟨t, ht, rfl⟩, fun x => (key x).1, fun x => (key x).2⟩

/-- **A countable family of test forms, dense for `ω` and `dω` with common compact supports**
(Simon Ch. 6, proof of 4.5(2), p. 157: "a countable dense set of `ω ∈ 𝒟ⁿ(U)`").  Take the
compact exhaustion `Kᵢ` of `U` (`dor_lmbs_tfa_compact_exhaustion`) and, for each `i`, a
countable `Dᵢ` approximating every `ω` with `spt ω ⊆ Kᵢ` uniformly together with `dω`
(`dor_lmbs_tfa_fixed_support_dense`); then `D = ⋃ᵢ Dᵢ`.  Given `ω`, `spt ω ⊆ Kᵢ` for some `i`,
and `ωₖ ∈ Dᵢ` within `1/(k+1)` of `ω` and of `dω` gives `ωₖ → ω`, `dωₖ → dω` uniformly. -/
theorem Submission.dor_lmbs_testForm_countable_approx : ∀ (P n : ℕ) (U : Set (Euclid P)), IsOpen U → ∃ D : Set (TestFormOn U n), D.Countable ∧ ∀ ω : TestFormOn U n, ∃ (K : Set (Euclid P)) (ωs : ℕ → TestFormOn U n), IsCompact K ∧ K ⊆ U ∧ tsupport (ω : DifferentialForm (Euclid P) n) ⊆ K ∧ (∀ k, ωs k ∈ D) ∧ (∀ k, tsupport (ωs k : DifferentialForm (Euclid P) n) ⊆ K) ∧ TendstoUniformly (fun k x => (ωs k : DifferentialForm (Euclid P) n) x) (ω : DifferentialForm (Euclid P) n) atTop ∧ TendstoUniformly (fun k x => exteriorDerivative (ωs k : DifferentialForm (Euclid P) n) x) (exteriorDerivative (ω : DifferentialForm (Euclid P) n)) atTop := by
  intro P n U hU
  -- step 1: the compact exhaustion `Kᵢ` of `U`
  obtain ⟨K, hKc, hKU, hKex⟩ := Submission.dor_lmbs_tfa_compact_exhaustion P U hU
  -- steps 2–4: a countable `Dᵢ` for the test forms supported in `Kᵢ`
  choose D hDc hDK hDω using fun i =>
    Submission.dor_lmbs_tfa_fixed_support_dense P n U (K i) (hKc i)
  -- step 5: `D = ⋃ᵢ Dᵢ`
  refine ⟨⋃ i, D i, Set.countable_iUnion hDc, fun ω => ?_⟩
  -- step 6: `spt ω` is a compact subset of `U`, so it lies in some `Kᵢ`
  obtain ⟨i, hi⟩ :=
    hKex (tsupport (ω : DifferentialForm (Euclid P) n)) ω.property.1.2 ω.property.2
  -- `ωₖ ∈ Dᵢ` within `1/(k+1)` of `ω` and of `dω`
  choose ωs hωsD hωs using fun k : ℕ =>
    hDω i ω hi (1 / ((k : ℝ) + 1)) Nat.one_div_pos_of_nat
  have hsmall : ∀ ε : ℝ, 0 < ε → ∀ᶠ k : ℕ in atTop, 1 / ((k : ℝ) + 1) < ε := fun ε hε => by
    obtain ⟨N, hN⟩ := exists_nat_one_div_lt hε
    filter_upwards [Filter.eventually_ge_atTop N] with k hk
    exact (Nat.one_div_le_one_div hk).trans_lt hN
  refine ⟨K i, ωs, hKc i, hKU i, hi, fun k => Set.mem_iUnion.2 ⟨i, hωsD k⟩,
    fun k => hDK i (ωs k) (hωsD k), ?_, ?_⟩
  · rw [Metric.tendstoUniformly_iff]
    intro ε hε
    filter_upwards [hsmall ε hε] with k hk x
    exact ((hωs k).1 x).trans hk
  · rw [Metric.tendstoUniformly_iff]
    intro ε hε
    filter_upwards [hsmall ε hε] with k hk x
    exact ((hωs k).2 x).trans hk
/-- **Directional rescaled Gauss–Green identity** (Simon Ch. 3, 4.3, (8), for an arbitrary
direction `w` in place of `eᵢ`).  Let `(μ, ν)` satisfy the Gauss–Green identity
`∫_F div φ dL^{m+1} = −∫ ⟨φ, ν⟩ dμ` for `φ ∈ C¹_c` with `spt φ ⊆ D`, and let `r > 0`,
`B̄_{rR}(y) ⊆ D`.  For `ζ ∈ C¹_c` with `spt ζ ⊆ B_R(0)` and `w ∈ ℝ^{m+1}`, the field `g = ζ w` is
`C¹` with `spt g ⊆ spt ζ ⊆ B_R(0)`, `div g = Dζ(·)(w)` (the trace of the rank-one map
`h ↦ Dζ(h) w` is `Dζ(w)`) and `⟨g, ν⟩ = ζ ⟨w, ν⟩`.  The rescaled Gauss–Green identity for `g`
thus reads `∫_{F_{y,r}} Dζ(w) dL^{m+1} = −r⁻ᵐ ∫ ζ(r⁻¹(z − y)) ⟨w, ν(z)⟩ dμ(z)`, where
`F_{y,r} = {x : y + r x ∈ F}`. -/
theorem Submission.codim1_rdo_dg_bh_directional_gauss_green : ∀ (m : ℕ) (D F : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)) (y : Euclid (m + 1)) (r R : ℝ), MeasurableSet F → (∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ z in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -∫ z, inner ℝ (φ z) (ν z) ∂μ) → 0 < r → closedBall y (r * R) ⊆ D → ∀ ζ : Euclid (m + 1) → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ → tsupport ζ ⊆ ball (0 : Euclid (m + 1)) R → ∀ w : Euclid (m + 1), ∫ z in (fun z => y + r • z) ⁻¹' F, fderiv ℝ ζ z w = -(r ^ m)⁻¹ * ∫ z, ζ (r⁻¹ • (z - y)) * inner ℝ w (ν z) ∂μ := by
  intro m D F μ ν y r R hF hGG hr hball ζ hζ hζc hζs w
  -- Step 1: `g = ζ w` is `C¹` with compact support and `spt g ⊆ spt ζ ⊆ B_R(0)`
  have hg : ContDiff ℝ 1 (fun z => ζ z • w) := hζ.smul contDiff_const
  have hgc : HasCompactSupport (fun z => ζ z • w) := hζc.smul_right (f' := fun _ => w)
  have hgs : tsupport (fun z => ζ z • w) ⊆ ball (0 : Euclid (m + 1)) R :=
    (tsupport_smul_subset_left ζ (fun _ => w)).trans hζs
  -- Step 2: `div g = Dζ(·)(w)`, the trace of the rank-one map `h ↦ Dζ(h) w`
  have h1 : ∀ z, LinearMap.trace ℝ (Euclid (m + 1))
      (fderiv ℝ (fun z => ζ z • w) z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = fderiv ℝ ζ z w := by
    intro z
    rw [fderiv_smul_const ((hζ.differentiable one_ne_zero) z) w]
    have : ((fderiv ℝ ζ z).smulRight w : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) =
        (fderiv ℝ ζ z : Euclid (m + 1) →ₗ[ℝ] ℝ).smulRight w := by
      ext x; simp
    rw [this, LinearMap.trace_smulRight]
    rfl
  -- Step 3: `⟨g(r⁻¹(z − y)), ν(z)⟩ = ζ(r⁻¹(z − y)) ⟨w, ν(z)⟩`
  have h2 : ∀ z, inner ℝ (ζ (r⁻¹ • (z - y)) • w) (ν z) = ζ (r⁻¹ • (z - y)) * inner ℝ w (ν z) :=
    fun z => real_inner_smul_left _ _ _
  -- Step 4: the rescaled Gauss–Green identity for `g`, with both integrands rewritten
  have key := Submission.codim1_rdo_dg_bh_rescaled_gauss_green m D F μ ν y r R hF hGG hr hball
    (fun z => ζ z • w) hg hgc hgs
  simp_rw [h1, h2] at key
  exact key
/-- **Small normal defect** (Simon Ch. 3, proof of Theorem 4.3 (De Giorgi), printed (1)–(2),
chapter-03.txt lines 609–619).  Let `ν` be a measurable unit vector field and `v` a unit vector,
let `μ(B̄_ρ₀(y)) < ∞` for some `ρ₀ > 0`, and let the averages `A(ρ) = μ(B̄_ρ(y))⁻¹ ∫_{B̄_ρ(y)} ν dμ`
tend to `v` as `ρ ↓ 0`.  Then for every `δ > 0` and all small `ρ > 0`,
`∫_{B̄_ρ(y)} (1 - ⟨ν, v⟩) dμ ≤ δ μ(B̄_ρ(y))` and `∫_{B̄_ρ(y)} |⟨ν, w⟩| dμ ≤ δ |w| μ(B̄_ρ(y))` for
every `w ⊥ v`.  The first bound is `∫_{B̄_ρ(y)} (1 - ⟨ν, v⟩) dμ = μ(B̄_ρ(y)) (1 - ⟨A(ρ), v⟩)`; the
second integrates `|⟨ν, w⟩| ≤ |w| |ν - v| ≤ |w| (δ/2 + (1 - ⟨ν, v⟩)/δ)`, where
`|ν - v|² = 2 (1 - ⟨ν, v⟩)`. -/
theorem Submission.codim1_rdo_dg_bh_normal_defect_small : ∀ (m : ℕ) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)) (y v : Euclid (m + 1)), Measurable ν → (∀ z, ‖ν z‖ = 1) → ‖v‖ = 1 → (∃ ρ₀ : ℝ, 0 < ρ₀ ∧ μ (closedBall y ρ₀) ≠ ∞) → Tendsto (fun ρ : ℝ => (μ (closedBall y ρ)).toReal⁻¹ • ∫ z in closedBall y ρ, ν z ∂μ) (𝓝[>] 0) (𝓝 v) → ∀ δ : ℝ, 0 < δ → ∀ᶠ ρ in 𝓝[>] (0 : ℝ), ∫ z in closedBall y ρ, (1 - inner ℝ (ν z) v) ∂μ ≤ δ * (μ (closedBall y ρ)).toReal ∧ ∀ w : Euclid (m + 1), inner ℝ w v = 0 → ∫ z in closedBall y ρ, |inner ℝ (ν z) w| ∂μ ≤ δ * ‖w‖ * (μ (closedBall y ρ)).toReal := by
  intro m μ ν y v hν hν1 hv ⟨ρ₀, hρ₀, hfin⟩ hA δ hδ
  -- `⟨A(ρ), v⟩ → ⟨v, v⟩ = 1`
  have hε : Tendsto (fun ρ : ℝ => inner ℝ ((μ (closedBall y ρ)).toReal⁻¹ •
      ∫ z in closedBall y ρ, ν z ∂μ) v) (𝓝[>] 0) (𝓝 1) := by
    have hcont : Continuous (fun x : Euclid (m + 1) => inner ℝ x v) :=
      continuous_id.inner continuous_const
    have := (hcont.tendsto v).comp hA
    rwa [real_inner_self_eq_norm_sq, hv, one_pow] at this
  -- eventually `ρ < ρ₀` and `1 - ⟨A(ρ), v⟩ < η = min δ (δ² / 2)`
  set η := min δ (δ ^ 2 / 2) with hη_def
  have hη : 0 < η := lt_min hδ (by positivity)
  have hηδ : η ≤ δ := min_le_left _ _
  have hηδ2 : η ≤ δ ^ 2 / 2 := min_le_right _ _
  have hev1 : ∀ᶠ ρ in 𝓝[>] (0 : ℝ), 1 - η < inner ℝ ((μ (closedBall y ρ)).toReal⁻¹ •
      ∫ z in closedBall y ρ, ν z ∂μ) v :=
    hε.eventually (lt_mem_nhds (by linarith))
  have hev2 : ∀ᶠ ρ in 𝓝[>] (0 : ℝ), ρ ∈ Ioo 0 ρ₀ := Ioo_mem_nhdsGT hρ₀
  filter_upwards [hev1, hev2] with ρ h1 h2
  -- `μ(B̄_ρ(y)) < ∞`, so the bounded measurable integrands are integrable
  set B := closedBall y ρ with hB
  have hfinρ : μ B ≠ ∞ :=
    ne_top_of_le_ne_top hfin (measure_mono (closedBall_subset_closedBall h2.2.le))
  have : IsFiniteMeasure (μ.restrict B) := isFiniteMeasure_restrict.mpr hfinρ
  set M := (μ B).toReal with hM
  have hM0 : 0 ≤ M := ENNReal.toReal_nonneg
  have hνint : Integrable ν (μ.restrict B) :=
    Integrable.of_bound hν.aestronglyMeasurable 1 (Eventually.of_forall fun z => (hν1 z).le)
  have hνv_meas : Measurable (fun z => inner ℝ (ν z) v) :=
    (continuous_id.inner continuous_const).measurable.comp hν
  have hνv : Integrable (fun z => inner ℝ (ν z) v) (μ.restrict B) := by
    refine Integrable.of_bound hνv_meas.aestronglyMeasurable 1 (Eventually.of_forall fun z => ?_)
    calc ‖inner ℝ (ν z) v‖ = |inner ℝ (ν z) v| := Real.norm_eq_abs _
      _ ≤ ‖ν z‖ * ‖v‖ := abs_real_inner_le_norm _ _
      _ = 1 := by rw [hν1, hv, one_mul]
  have hdefint : Integrable (fun z => 1 - inner ℝ (ν z) v) (μ.restrict B) :=
    (integrable_const 1).sub hνv
  -- `∫_{B̄_ρ(y)} (1 - ⟨ν, v⟩) dμ = M (1 - ⟨A(ρ), v⟩) ≤ M η`
  have hdef : ∫ z in B, (1 - inner ℝ (ν z) v) ∂μ ≤ M * η := by
    rcases eq_or_ne M 0 with hM0' | hMne
    · have hμB : μ B = 0 := by
        rcases (ENNReal.toReal_eq_zero_iff _).mp hM0' with h | h
        · exact h
        · exact absurd h hfinρ
      rw [Measure.restrict_eq_zero.mpr hμB, integral_zero_measure, hM0', zero_mul]
    · have hinner : ∫ z in B, inner ℝ (ν z) v ∂μ = inner ℝ (∫ z in B, ν z ∂μ) v := by
        simp_rw [real_inner_comm v]
        have := (innerSL ℝ v).integral_comp_comm hνint
        simpa using this
      rw [integral_sub (integrable_const 1) hνv, hinner, integral_const, smul_eq_mul, mul_one]
      simp only [Measure.real, Measure.restrict_apply_univ]
      have hA' : inner ℝ (∫ z in B, ν z ∂μ) v = M * inner ℝ (M⁻¹ • ∫ z in B, ν z ∂μ) v := by
        rw [real_inner_smul_left, ← mul_assoc, mul_inv_cancel₀ hMne, one_mul]
      rw [hA']
      have : 1 - inner ℝ (M⁻¹ • ∫ z in B, ν z ∂μ) v ≤ η := by linarith
      nlinarith
  refine ⟨?_, ?_⟩
  · calc ∫ z in B, (1 - inner ℝ (ν z) v) ∂μ ≤ M * η := hdef
      _ ≤ M * δ := mul_le_mul_of_nonneg_left hηδ hM0
      _ = δ * M := mul_comm _ _
  · intro w hw
    -- pointwise `|⟨ν, w⟩| ≤ |w| |ν - v| ≤ |w| (δ/2 + (1 - ⟨ν, v⟩)/δ)` for `w ⊥ v`
    have hpt : ∀ z, |inner ℝ (ν z) w| ≤ ‖w‖ * (δ / 2 + (1 - inner ℝ (ν z) v) / δ) := by
      intro z
      have e1 : inner ℝ (ν z) w = inner ℝ (ν z - v) w := by
        rw [inner_sub_left, real_inner_comm w v, hw, sub_zero]
      have e2 : ‖ν z - v‖ ^ 2 = 2 - 2 * inner ℝ (ν z) v := by
        rw [norm_sub_sq_real, hν1, hv]; ring
      have e3 : ‖ν z - v‖ ≤ δ / 2 + (1 - inner ℝ (ν z) v) / δ := by
        have ht := sq_nonneg (‖ν z - v‖ - δ)
        have : (1 - inner ℝ (ν z) v) / δ = ‖ν z - v‖ ^ 2 / (2 * δ) := by
          rw [e2]; field_simp
        rw [this, div_add_div _ _ (two_ne_zero) (by positivity), le_div_iff₀ (by positivity)]
        nlinarith
      rw [e1]
      calc |inner ℝ (ν z - v) w| ≤ ‖ν z - v‖ * ‖w‖ := abs_real_inner_le_norm _ _
        _ ≤ (δ / 2 + (1 - inner ℝ (ν z) v) / δ) * ‖w‖ :=
            mul_le_mul_of_nonneg_right e3 (norm_nonneg _)
        _ = _ := mul_comm _ _
    have hint1 : Integrable (fun z => |inner ℝ (ν z) w|) (μ.restrict B) := by
      refine Integrable.of_bound
        ((continuous_abs.comp (continuous_id.inner continuous_const)).measurable.comp
          hν).aestronglyMeasurable ‖w‖
        (Eventually.of_forall fun z => ?_)
      rw [Real.norm_eq_abs, abs_abs]
      calc |inner ℝ (ν z) w| ≤ ‖ν z‖ * ‖w‖ := abs_real_inner_le_norm _ _
        _ = ‖w‖ := by rw [hν1, one_mul]
    have hint2 : Integrable (fun z => ‖w‖ * (δ / 2 + (1 - inner ℝ (ν z) v) / δ)) (μ.restrict B) :=
      ((integrable_const (δ / 2)).add (hdefint.div_const δ)).const_mul ‖w‖
    -- integrate, then use `∫_{B̄_ρ(y)} (1 - ⟨ν, v⟩) dμ ≤ M η ≤ M δ² / 2`
    calc ∫ z in B, |inner ℝ (ν z) w| ∂μ
        ≤ ∫ z in B, ‖w‖ * (δ / 2 + (1 - inner ℝ (ν z) v) / δ) ∂μ :=
          integral_mono hint1 hint2 hpt
      _ = ‖w‖ * (δ / 2 * M + (∫ z in B, (1 - inner ℝ (ν z) v) ∂μ) / δ) := by
          rw [integral_const_mul, integral_add (integrable_const _) (hdefint.div_const δ),
            integral_const, integral_div, smul_eq_mul]
          simp only [Measure.real, Measure.restrict_apply_univ]
          ring
      _ ≤ ‖w‖ * (δ / 2 * M + M * η / δ) := by
          gcongr
      _ ≤ ‖w‖ * (δ / 2 * M + M * (δ ^ 2 / 2) / δ) := by
          gcongr
      _ = δ * ‖w‖ * M := by
          field_simp
          ring
/-- **Uniform perimeter bound for the blow-ups** (Simon Ch. 3, 4.3 (6)–(8): the bound that lets
the compactness theorem Ch. 2, 2.6 select an `L¹_loc`-convergent sequence of blow-ups).  Let
`∫_F div φ = -∫ ⟨φ, ν⟩ dμ` for `φ ∈ C¹_c` with `spt φ ⊆ D`, where `|ν| = 1`, and let
`B̄_{ρ₁}(y) ⊆ D` and `μ(B̄_ρ(y)) ≤ C₁ρᵐ` for `0 < ρ < ρ₁`.  If `rR < ρ₁`, `g ∈ C¹_c(B_R(0))` and
`|g| ≤ 1`, then `∫_{F_{y,r}} div g ≤ C₁Rᵐ`, where `F_{y,r} = {w : y + rw ∈ F}`.  As
`B̄_{rR}(y) ⊆ D`, the rescaled Gauss–Green identity gives `∫_{F_{y,r}} div g = -r⁻ᵐ ∫ h dμ` with
`h(z) = ⟨g(r⁻¹(z - y)), ν(z)⟩`; `|h| ≤ 1` and `h` vanishes off `K = B̄_{rR}(y)`, so
`|∫ h dμ| ≤ μ(K) ≤ C₁(rR)ᵐ` and `-r⁻ᵐ ∫ h dμ ≤ C₁Rᵐ`. -/
theorem Submission.codim1_rdo_dg_bh_perimeter_bound : ∀ (m : ℕ) (D F : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)) (y : Euclid (m + 1)) (ρ₁ C₁ : ℝ), MeasurableSet F → Measurable ν → (∀ z, ‖ν z‖ = 1) → (∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ z in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -∫ z, inner ℝ (φ z) (ν z) ∂μ) → 0 < ρ₁ → 0 ≤ C₁ → closedBall y ρ₁ ⊆ D → (∀ ρ : ℝ, 0 < ρ → ρ < ρ₁ → μ (closedBall y ρ) ≤ ENNReal.ofReal (C₁ * ρ ^ m)) → ∀ R r : ℝ, 0 < R → 0 < r → r * R < ρ₁ → ∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 g → HasCompactSupport g → tsupport g ⊆ ball (0 : Euclid (m + 1)) R → (∀ z, ‖g z‖ ≤ 1) → ∫ w in (fun w => y + r • w) ⁻¹' F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g w : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) ≤ C₁ * R ^ m := by
  intro m D F μ ν y ρ₁ C₁ hF hν hν1 hGG hρ₁ hC₁ hball hmass R r hR hr hrR g hg hgc hgs hg1
  -- Step 1: `B̄_{rR}(y) ⊆ B̄_{ρ₁}(y) ⊆ D`, so the rescaled Gauss–Green identity applies to `g`
  have hsub : closedBall y (r * R) ⊆ D := (closedBall_subset_closedBall hrR.le).trans hball
  rw [Submission.codim1_rdo_dg_bh_rescaled_gauss_green m D F μ ν y r R hF hGG hr hsub g hg hgc hgs]
  -- Step 2: `h(z) = ⟨g(r⁻¹(z - y)), ν(z)⟩` vanishes off `B̄_{rR}(y)`, as `spt g ⊆ B_R(0)`
  have hzero : ∀ z, z ∉ closedBall y (r * R) → inner ℝ (g (r⁻¹ • (z - y))) (ν z) = 0 := by
    intro z hz
    have hgz : g (r⁻¹ • (z - y)) = 0 := by
      by_contra hne
      apply hz
      have hmem : r⁻¹ • (z - y) ∈ ball (0 : Euclid (m + 1)) R := hgs (subset_tsupport _ hne)
      rw [mem_ball_zero_iff, norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hr,
        inv_mul_lt_iff₀ hr] at hmem
      rw [mem_closedBall, dist_eq_norm]
      exact hmem.le
    rw [hgz, inner_zero_left]
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero hzero]
  -- Step 3: `μ(B̄_{rR}(y)) ≤ C₁(rR)ᵐ < ∞` and `|h| ≤ |g| |ν| ≤ 1`, so `|∫ h dμ| ≤ C₁(rR)ᵐ`
  have hK : μ (closedBall y (r * R)) ≤ ENNReal.ofReal (C₁ * (r * R) ^ m) :=
    hmass _ (mul_pos hr hR) hrR
  have hbound : ‖∫ z in closedBall y (r * R), inner ℝ (g (r⁻¹ • (z - y))) (ν z) ∂μ‖ ≤
      1 * μ.real (closedBall y (r * R)) := by
    refine norm_setIntegral_le_of_norm_le_const (hK.trans_lt ENNReal.ofReal_lt_top) fun z _ => ?_
    calc ‖inner ℝ (g (r⁻¹ • (z - y))) (ν z)‖ = |inner ℝ (g (r⁻¹ • (z - y))) (ν z)| :=
          Real.norm_eq_abs _
      _ ≤ ‖g (r⁻¹ • (z - y))‖ * ‖ν z‖ := abs_real_inner_le_norm _ _
      _ ≤ 1 := by rw [hν1, mul_one]; exact hg1 _
  have hμK : μ.real (closedBall y (r * R)) ≤ C₁ * (r * R) ^ m :=
    ENNReal.toReal_le_of_le_ofReal (by positivity) hK
  rw [Real.norm_eq_abs, one_mul] at hbound
  have hneg := (abs_le.mp hbound).1
  -- Step 4: `-r⁻ᵐ ∫ h dμ ≤ r⁻ᵐ C₁(rR)ᵐ = C₁Rᵐ`
  have hrm : 0 < r ^ m := pow_pos hr m
  calc -(r ^ m)⁻¹ * ∫ z in closedBall y (r * R), inner ℝ (g (r⁻¹ • (z - y))) (ν z) ∂μ
      = (r ^ m)⁻¹ * -∫ z in closedBall y (r * R), inner ℝ (g (r⁻¹ • (z - y))) (ν z) ∂μ := by
        ring
    _ ≤ (r ^ m)⁻¹ * (C₁ * (r * R) ^ m) :=
        mul_le_mul_of_nonneg_left (by linarith) (inv_nonneg.mpr hrm.le)
    _ = C₁ * R ^ m := by rw [mul_pow]; field_simp

/-- **Simon Ch. 3, proof of 4.3, (8)** ("so that `∫_{λ_k⁻¹E} Dᵢζ dL^{n+1} → 0` by (2) for
`i = 1, …, n`"): derivatives of `ζ ∈ C¹_c(ℝ^{m+1})` in directions `w ⊥ v` integrate to `0` over
the blow-ups `F_{y,r} = {x : y + rx ∈ F}` as `r ↓ 0`.  Take `R > 0` with `spt ζ ⊆ B_R(0)` and
`M = sup |ζ|`.  For small `r`, `ρ = rR < ρ₁`, so `B̄_ρ(y) ⊆ D` and the directional Gauss–Green
identity (`codim1_rdo_dg_bh_directional_gauss_green`) gives
`∫_{F_{y,r}} Dζ(w) = −r⁻ᵐ ∫ ζ(r⁻¹(z − y)) ⟨w, ν(z)⟩ dμ(z)`, whose integrand vanishes off `B̄_ρ(y)`
and is bounded by `M |⟨ν, w⟩|`.  The normal-defect estimate (2)
(`codim1_rdo_dg_bh_normal_defect_small`, applicable as `μ(B̄_{ρ₁/2}(y)) ≤ C₁(ρ₁/2)ᵐ < ∞`) gives
`∫_{B̄_ρ(y)} |⟨ν, w⟩| dμ ≤ δ|w| μ(B̄_ρ(y)) ≤ δ|w|C₁ρᵐ` for small `ρ`, hence
`|∫_{F_{y,r}} Dζ(w)| ≤ δM|w|C₁Rᵐ`, which is `< η` for `δ = η/(1 + M|w|C₁Rᵐ)`. -/
theorem Submission.codim1_rdo_dg_bh_tangential_vanish : ∀ (m : ℕ) (D F : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)) (y v : Euclid (m + 1)) (ρ₁ C₁ : ℝ), MeasurableSet F → Measurable ν → (∀ z, ‖ν z‖ = 1) → (∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ z in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -∫ z, inner ℝ (φ z) (ν z) ∂μ) → ‖v‖ = 1 → Tendsto (fun ρ : ℝ => (μ (closedBall y ρ)).toReal⁻¹ • ∫ z in closedBall y ρ, ν z ∂μ) (𝓝[>] 0) (𝓝 v) → 0 < ρ₁ → 0 ≤ C₁ → closedBall y ρ₁ ⊆ D → (∀ ρ : ℝ, 0 < ρ → ρ < ρ₁ → μ (closedBall y ρ) ≤ ENNReal.ofReal (C₁ * ρ ^ m)) → ∀ ζ : Euclid (m + 1) → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ → ∀ w : Euclid (m + 1), inner ℝ w v = 0 → Tendsto (fun r : ℝ => ∫ z in (fun z => y + r • z) ⁻¹' F, fderiv ℝ ζ z w) (𝓝[>] 0) (𝓝 0) := by
  intro m D F μ ν y v ρ₁ C₁ hF hν hν1 hGG hv hA hρ₁ hC₁ hball hmass ζ hζ hζc w hw
  -- Step 1: `spt ζ ⊆ B_R(0)` with `R > 0`, and `|ζ| ≤ M`
  obtain ⟨R₀, hR₀⟩ := hζc.isCompact.isBounded.subset_ball (0 : Euclid (m + 1))
  set R := max R₀ 1
  have hRpos : 0 < R := lt_of_lt_of_le one_pos (le_max_right _ _)
  have hR : tsupport ζ ⊆ ball (0 : Euclid (m + 1)) R :=
    hR₀.trans (ball_subset_ball (le_max_left _ _))
  obtain ⟨M, hM⟩ : ∃ M, ∀ z, ‖ζ z‖ ≤ M := hζ.continuous.bounded_above_of_compact_support hζc
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  have hM' : ∀ z, |ζ z| ≤ M := fun z => by simpa [Real.norm_eq_abs] using hM z
  -- Step 2: `μ(B̄_{ρ₁/2}(y)) < ∞`, and `r ↦ rR` maps `𝓝[>] 0` into `𝓝[>] 0`
  have hfin : ∃ ρ₀ : ℝ, 0 < ρ₀ ∧ μ (closedBall y ρ₀) ≠ ∞ :=
    ⟨ρ₁ / 2, half_pos hρ₁, ne_top_of_le_ne_top ENNReal.ofReal_ne_top
      (hmass _ (half_pos hρ₁) (half_lt_self hρ₁))⟩
  have htend : Tendsto (fun r : ℝ => r * R) (𝓝[>] 0) (𝓝[>] 0) := by
    apply tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within
    · have : Tendsto (fun r : ℝ => r * R) (𝓝 0) (𝓝 (0 * R)) := tendsto_id.mul_const R
      rw [zero_mul] at this
      exact this.mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with r hr
      exact mul_pos hr hRpos
  have hsmall : ∀ᶠ r in 𝓝[>] (0 : ℝ), r * R < ρ₁ :=
    (htend.mono_right nhdsWithin_le_nhds).eventually (gt_mem_nhds hρ₁)
  -- Step 3: given `η > 0`, apply (2) with `δ = η/(1 + K)`, `K = M|w|C₁Rᵐ`, at `ρ = rR`
  set K := M * ‖w‖ * C₁ * R ^ m with hK
  have hK0 : 0 ≤ K := by positivity
  rw [Metric.tendsto_nhds]
  intro η hη
  set δ := η / (1 + K) with hδ_def
  have hδ : 0 < δ := div_pos hη (by linarith)
  have hnd := htend.eventually
    (Submission.codim1_rdo_dg_bh_normal_defect_small m μ ν y v hν hν1 hv hfin hA δ hδ)
  filter_upwards [hnd, hsmall, self_mem_nhdsWithin] with r h1 h2 h3
  have hr : 0 < r := h3
  have hrR : 0 < r * R := mul_pos hr hRpos
  -- Step 4: `B̄_{rR}(y) ⊆ D` and `μ(B̄_{rR}(y)) ≤ C₁(rR)ᵐ < ∞`
  have hsub : closedBall y (r * R) ⊆ D := (closedBall_subset_closedBall h2.le).trans hball
  have hBfin : μ (closedBall y (r * R)) ≤ ENNReal.ofReal (C₁ * (r * R) ^ m) := hmass _ hrR h2
  have hBlt : μ (closedBall y (r * R)) < ∞ := hBfin.trans_lt ENNReal.ofReal_lt_top
  have : IsFiniteMeasure (μ.restrict (closedBall y (r * R))) :=
    isFiniteMeasure_restrict.mpr hBlt.ne
  have hμB : (μ (closedBall y (r * R))).toReal ≤ C₁ * (r * R) ^ m :=
    ENNReal.toReal_le_of_le_ofReal (by positivity) hBfin
  -- Step 5: the directional Gauss–Green identity; its integrand vanishes off `B̄_{rR}(y)`
  have hζz : ∀ z, z ∉ closedBall y (r * R) → ζ (r⁻¹ • (z - y)) = 0 := by
    intro z hz
    by_contra hne
    apply hz
    have hmem : r⁻¹ • (z - y) ∈ ball (0 : Euclid (m + 1)) R := hR (subset_tsupport _ hne)
    rw [mem_ball_zero_iff, norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hr] at hmem
    rw [mem_closedBall, dist_eq_norm]
    have := (inv_mul_lt_iff₀ hr).mp hmem
    linarith
  have hrm : 0 < r ^ m := pow_pos hr m
  rw [dist_zero_right, Submission.codim1_rdo_dg_bh_directional_gauss_green m D F μ ν y r R hF hGG hr
    hsub ζ hζ hζc hR w]
  have hzero : ∀ z, z ∉ closedBall y (r * R) → ζ (r⁻¹ • (z - y)) * inner ℝ w (ν z) = 0 := by
    intro z hz
    rw [hζz z hz, zero_mul]
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero hzero]
  -- Step 6: `|∫ ζ(r⁻¹(z − y)) ⟨w, ν⟩ dμ| ≤ M ∫_{B̄_{rR}(y)} |⟨ν, w⟩| dμ ≤ Mδ|w|C₁(rR)ᵐ`
  have hνw : Measurable (fun z => |inner ℝ (ν z) w|) :=
    (continuous_abs.comp (continuous_id.inner continuous_const)).measurable.comp hν
  have hint : Integrable (fun z => M * |inner ℝ (ν z) w|) (μ.restrict (closedBall y (r * R))) := by
    refine (Integrable.of_bound hνw.aestronglyMeasurable ‖w‖
      (Eventually.of_forall fun z => ?_)).const_mul M
    rw [Real.norm_eq_abs, abs_abs]
    calc |inner ℝ (ν z) w| ≤ ‖ν z‖ * ‖w‖ := abs_real_inner_le_norm _ _
      _ = ‖w‖ := by rw [hν1, one_mul]
  have hb1 : ‖∫ z in closedBall y (r * R), ζ (r⁻¹ • (z - y)) * inner ℝ w (ν z) ∂μ‖ ≤
      ∫ z in closedBall y (r * R), M * |inner ℝ (ν z) w| ∂μ := by
    apply norm_integral_le_of_norm_le hint
    refine Eventually.of_forall fun z => ?_
    rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, real_inner_comm]
    exact mul_le_mul_of_nonneg_right (hM' _) (abs_nonneg _)
  have hb2 : ∫ z in closedBall y (r * R), M * |inner ℝ (ν z) w| ∂μ ≤
      M * (δ * ‖w‖ * (C₁ * (r * R) ^ m)) := by
    rw [integral_const_mul]
    apply mul_le_mul_of_nonneg_left _ hM0
    calc ∫ z in closedBall y (r * R), |inner ℝ (ν z) w| ∂μ
        ≤ δ * ‖w‖ * (μ (closedBall y (r * R))).toReal := h1.2 w hw
      _ ≤ δ * ‖w‖ * (C₁ * (r * R) ^ m) := by gcongr
  -- Step 7: `r⁻ᵐ · Mδ|w|C₁(rR)ᵐ = δK < η`
  have hnorm : ‖-(r ^ m)⁻¹ * ∫ z in closedBall y (r * R), ζ (r⁻¹ • (z - y)) * inner ℝ w (ν z) ∂μ‖ =
      (r ^ m)⁻¹ * ‖∫ z in closedBall y (r * R), ζ (r⁻¹ • (z - y)) * inner ℝ w (ν z) ∂μ‖ := by
    rw [norm_mul, norm_neg, norm_inv, Real.norm_eq_abs (r ^ m), abs_of_pos hrm]
  rw [hnorm]
  calc (r ^ m)⁻¹ * ‖∫ z in closedBall y (r * R), ζ (r⁻¹ • (z - y)) * inner ℝ w (ν z) ∂μ‖
      ≤ (r ^ m)⁻¹ * (M * (δ * ‖w‖ * (C₁ * (r * R) ^ m))) := by
        gcongr
        exact hb1.trans hb2
    _ = δ * K := by rw [hK, mul_pow]; field_simp
    _ < η := by
        rw [hδ_def, div_mul_eq_mul_div, div_lt_iff₀ (by linarith)]
        nlinarith

/-- Simon Ch. 3, 4.3, proof of (9): the normal derivatives of the blow-ups `F_{y,r}` are
asymptotically nonpositive.  Take `tsupport ζ ⊆ B_R(0)`, `M ≥ sup ζ` and `δ' = δ / (1 + M C₁ Rᵐ)`.
For small `r`, `directional_gauss_green` (with `w = v`, `ρ = rR`) and the pointwise bound
`-ζ⟨v, ν⟩ ≤ M (1 - ⟨ν, v⟩)` on `B̄_ρ(y)` give
`∫_{F_{y,r}} Dζ(v) ≤ r⁻ᵐ M ∫_{B̄_ρ(y)} (1 - ⟨ν, v⟩) dμ ≤ r⁻ᵐ M δ' μ(B̄_ρ(y)) ≤ M δ' C₁ Rᵐ ≤ δ`,
by `normal_defect_small` and `μ(B̄_ρ(y)) ≤ C₁ρᵐ`. -/
theorem Submission.codim1_rdo_dg_bh_normal_limsup : ∀ (m : ℕ) (D F : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)) (y v : Euclid (m + 1)) (ρ₁ C₁ : ℝ), MeasurableSet F → Measurable ν → (∀ z, ‖ν z‖ = 1) → (∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ z in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -∫ z, inner ℝ (φ z) (ν z) ∂μ) → ‖v‖ = 1 → Tendsto (fun ρ : ℝ => (μ (closedBall y ρ)).toReal⁻¹ • ∫ z in closedBall y ρ, ν z ∂μ) (𝓝[>] 0) (𝓝 v) → 0 < ρ₁ → 0 ≤ C₁ → closedBall y ρ₁ ⊆ D → (∀ ρ : ℝ, 0 < ρ → ρ < ρ₁ → μ (closedBall y ρ) ≤ ENNReal.ofReal (C₁ * ρ ^ m)) → ∀ ζ : Euclid (m + 1) → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ → (∀ z, 0 ≤ ζ z) → ∀ δ : ℝ, 0 < δ → ∀ᶠ r in 𝓝[>] (0 : ℝ), ∫ z in (fun z => y + r • z) ⁻¹' F, fderiv ℝ ζ z v ≤ δ := by
  intro m D F μ ν y v ρ₁ C₁ hF hν hν1 hGG hv hA hρ₁ hC₁ hball hmass ζ hζ hζc hζ0 δ hδ
  -- Step 1: `tsupport ζ ⊆ B_R(0)` with `R ≥ 1`, `|ζ| ≤ M`, and `δ' = δ / (1 + M C₁ Rᵐ)`
  obtain ⟨R₀, hR₀⟩ := hζc.isCompact.isBounded.subset_ball (0 : Euclid (m + 1))
  set R := max R₀ 1 with hR_def
  have hRpos : 0 < R := lt_of_lt_of_le one_pos (le_max_right _ _)
  have hR : tsupport ζ ⊆ ball (0 : Euclid (m + 1)) R :=
    hR₀.trans (ball_subset_ball (le_max_left _ _))
  obtain ⟨M, hM⟩ : ∃ M, ∀ z, ‖ζ z‖ ≤ M := hζ.continuous.bounded_above_of_compact_support hζc
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  have hM' : ∀ z, |ζ z| ≤ M := fun z => by simpa [Real.norm_eq_abs] using hM z
  set K := M * C₁ * R ^ m with hK
  have hK0 : 0 ≤ K := by positivity
  set δ' := δ / (1 + K) with hδ'_def
  have hδ' : 0 < δ' := div_pos hδ (by linarith)
  -- Step 2: the normal defect on `B̄_ρ(y)` is at most `δ' μ(B̄_ρ(y))` for small `ρ = rR`
  have hfin : ∃ ρ₀ : ℝ, 0 < ρ₀ ∧ μ (closedBall y ρ₀) ≠ ∞ :=
    ⟨ρ₁ / 2, half_pos hρ₁, ne_top_of_le_ne_top ENNReal.ofReal_ne_top
      (hmass _ (half_pos hρ₁) (half_lt_self hρ₁))⟩
  have htend : Tendsto (fun r : ℝ => r * R) (𝓝[>] 0) (𝓝[>] 0) := by
    apply tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within
    · have : Tendsto (fun r : ℝ => r * R) (𝓝 0) (𝓝 (0 * R)) := tendsto_id.mul_const R
      rw [zero_mul] at this
      exact this.mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with r hr
      exact mul_pos hr hRpos
  have hsmall : ∀ᶠ r in 𝓝[>] (0 : ℝ), r * R < ρ₁ :=
    (htend.mono_right nhdsWithin_le_nhds).eventually (gt_mem_nhds hρ₁)
  have hnd := htend.eventually
    (Submission.codim1_rdo_dg_bh_normal_defect_small m μ ν y v hν hν1 hv hfin hA δ' hδ')
  filter_upwards [hnd, hsmall, self_mem_nhdsWithin] with r h1 h2 h3
  have hr : 0 < r := h3
  have hrR : 0 < r * R := mul_pos hr hRpos
  have hsub : closedBall y (r * R) ⊆ D := (closedBall_subset_closedBall h2.le).trans hball
  have hBfin : μ (closedBall y (r * R)) ≤ ENNReal.ofReal (C₁ * (r * R) ^ m) := hmass _ hrR h2
  have hBlt : μ (closedBall y (r * R)) < ∞ := hBfin.trans_lt ENNReal.ofReal_lt_top
  have : IsFiniteMeasure (μ.restrict (closedBall y (r * R))) :=
    isFiniteMeasure_restrict.mpr hBlt.ne
  have hμB : (μ (closedBall y (r * R))).toReal ≤ C₁ * (r * R) ^ m :=
    ENNReal.toReal_le_of_le_ofReal (by positivity) hBfin
  -- Step 3: the rescaled identity, with `s(z) = ζ(r⁻¹(z - y))` vanishing off `B̄_ρ(y)`
  have hζz : ∀ z, z ∉ closedBall y (r * R) → ζ (r⁻¹ • (z - y)) = 0 := by
    intro z hz
    by_contra hne
    apply hz
    have hmem : r⁻¹ • (z - y) ∈ ball (0 : Euclid (m + 1)) R := hR (subset_tsupport _ hne)
    rw [mem_ball_zero_iff, norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hr] at hmem
    rw [mem_closedBall, dist_eq_norm]
    have := (inv_mul_lt_iff₀ hr).mp hmem
    linarith
  have hζmeas : Measurable (fun z : Euclid (m + 1) => ζ (r⁻¹ • (z - y))) :=
    (hζ.continuous.comp ((continuous_id.sub continuous_const).const_smul r⁻¹)).measurable
  have hrm : 0 < r ^ m := pow_pos hr m
  rw [Submission.codim1_rdo_dg_bh_directional_gauss_green m D F μ ν y r R hF hGG hr
    hsub ζ hζ hζc hR v]
  have hzero : ∀ z, z ∉ closedBall y (r * R) → ζ (r⁻¹ • (z - y)) * inner ℝ v (ν z) = 0 := by
    intro z hz
    rw [hζz z hz, zero_mul]
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero hzero]
  -- Step 4: `-s⟨v, ν⟩ ≤ M (1 - ⟨ν, v⟩)`, both sides bounded on the finite ball
  have hνv : Measurable (fun z => inner ℝ (ν z) v) :=
    (continuous_id.inner continuous_const).measurable.comp hν
  have hνv' : Measurable (fun z => inner ℝ v (ν z)) :=
    (continuous_const.inner continuous_id).measurable.comp hν
  have hint_l : Integrable (fun z => ζ (r⁻¹ • (z - y)) * inner ℝ v (ν z))
      (μ.restrict (closedBall y (r * R))) := by
    refine Integrable.of_bound (hζmeas.mul hνv').aestronglyMeasurable M
      (Eventually.of_forall fun z => ?_)
    rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs]
    have : |inner ℝ v (ν z)| ≤ 1 :=
      (abs_real_inner_le_norm _ _).trans (by rw [hν1, hv, one_mul])
    calc |ζ (r⁻¹ • (z - y))| * |inner ℝ v (ν z)| ≤ M * 1 := by
          gcongr
          exact hM' _
      _ = M := mul_one M
  have hint_d : Integrable (fun z => 1 - inner ℝ (ν z) v) (μ.restrict (closedBall y (r * R))) := by
    refine (integrable_const 1).sub (Integrable.of_bound hνv.aestronglyMeasurable 1
      (Eventually.of_forall fun z => ?_))
    rw [Real.norm_eq_abs]
    exact (abs_real_inner_le_norm _ _).trans (by rw [hν1, hv, one_mul])
  have hpt : ∀ z, -(ζ (r⁻¹ • (z - y)) * inner ℝ v (ν z)) ≤ M * (1 - inner ℝ (ν z) v) := by
    intro z
    have hs0 := hζ0 (r⁻¹ • (z - y))
    have hsM : ζ (r⁻¹ • (z - y)) ≤ M := (le_abs_self _).trans (hM' _)
    have hin : inner ℝ (ν z) v ≤ 1 :=
      (le_abs_self _).trans ((abs_real_inner_le_norm _ _).trans (by rw [hν1, hv, one_mul]))
    rw [real_inner_comm]
    nlinarith
  -- Step 5: integrate and use `μ(B̄_ρ(y)) ≤ C₁ρᵐ`
  have hmain : -∫ z in closedBall y (r * R), ζ (r⁻¹ • (z - y)) * inner ℝ v (ν z) ∂μ ≤
      M * ∫ z in closedBall y (r * R), (1 - inner ℝ (ν z) v) ∂μ := by
    rw [← integral_neg, ← integral_const_mul]
    exact integral_mono hint_l.neg (hint_d.const_mul M) hpt
  have hdef : ∫ z in closedBall y (r * R), (1 - inner ℝ (ν z) v) ∂μ ≤ δ' * (C₁ * (r * R) ^ m) :=
    h1.1.trans (by gcongr)
  -- Step 6: `r⁻ᵐ M δ' C₁ (rR)ᵐ = δ' M C₁ Rᵐ ≤ δ`
  calc -(r ^ m)⁻¹ * ∫ z in closedBall y (r * R), ζ (r⁻¹ • (z - y)) * inner ℝ v (ν z) ∂μ
      = (r ^ m)⁻¹ * (-∫ z in closedBall y (r * R), ζ (r⁻¹ • (z - y)) * inner ℝ v (ν z) ∂μ) := by
        ring
    _ ≤ (r ^ m)⁻¹ * (M * (δ' * (C₁ * (r * R) ^ m))) := by
        gcongr
        exact hmain.trans (mul_le_mul_of_nonneg_left hdef hM0)
    _ = δ' * K := by rw [hK, mul_pow]; field_simp
    _ ≤ δ := by
        rw [hδ'_def, div_mul_eq_mul_div, div_le_iff₀ (by linarith)]
        nlinarith
/-- **Scale invariance of the two-sided volume density bounds** (Simon Ch. 3, 4.3 (10)–(11)): if
`L(F ∩ B_ρ(y)) ≥ c₂ρ^{m+1}` and `L(B_ρ(y) \ F) ≥ c₂ρ^{m+1}` for `0 < ρ < ρ₂`, then the rescaled set
`F_{y,r} = {w : y + rw ∈ F}` satisfies the same bounds on `B_s(0)` whenever `rs < ρ₂`.  The map
`w ↦ y + rw` scales Lebesgue measure by `r^{m+1}` and pulls `B_{rs}(y)` back to `B_s(0)`. -/
theorem Submission.codim1_rdo_dg_bh_rescaled_volume_lower : ∀ (m : ℕ) (F : Set (Euclid (m + 1))) (y : Euclid (m + 1)) (c₂ ρ₂ : ℝ), MeasurableSet F → (∀ ρ : ℝ, 0 < ρ → ρ < ρ₂ → ENNReal.ofReal (c₂ * ρ ^ (m + 1)) ≤ volume (F ∩ ball y ρ) ∧ ENNReal.ofReal (c₂ * ρ ^ (m + 1)) ≤ volume (ball y ρ \ F)) → ∀ s r : ℝ, 0 < s → 0 < r → r * s < ρ₂ → ENNReal.ofReal (c₂ * s ^ (m + 1)) ≤ volume ((fun w => y + r • w) ⁻¹' F ∩ ball (0 : Euclid (m + 1)) s) ∧ ENNReal.ofReal (c₂ * s ^ (m + 1)) ≤ volume (ball (0 : Euclid (m + 1)) s \ (fun w => y + r • w) ⁻¹' F) := by
  intro m F y c₂ ρ₂ _ hvol s r hs hr hrs
  -- `L((y + r ·)⁻¹' S) = r^{-(m+1)} L(S)`: Haar scaling, then translation invariance
  have hscale : ∀ S : Set (Euclid (m + 1)), volume ((fun w => y + r • w) ⁻¹' S) =
      ENNReal.ofReal (|r ^ (m + 1)|⁻¹) * volume S := by
    intro S
    have : (fun w => y + r • w) ⁻¹' S = (r • ·) ⁻¹' ((fun u => y + u) ⁻¹' S) := rfl
    rw [this, Measure.addHaar_preimage_smul volume hr.ne', finrank_euclideanSpace_fin,
      measure_preimage_add, abs_inv]
  -- `|(y + rw) − y| = r|w|`, so `(y + r ·)⁻¹' B_{rs}(y) = B_s(0)`
  have hball : (fun w => y + r • w) ⁻¹' ball y (r * s) = ball (0 : Euclid (m + 1)) s := by
    ext w
    simp only [Set.mem_preimage, mem_ball, dist_eq_norm, add_sub_cancel_left, sub_zero, norm_smul,
      Real.norm_eq_abs, abs_of_pos hr]
    exact mul_lt_mul_iff_right₀ hr
  -- the hypothesis at `ρ = rs`, and both sets as preimages of the unscaled ones
  obtain ⟨h1, h2⟩ := hvol (r * s) (mul_pos hr hs) hrs
  have e1 : (fun w => y + r • w) ⁻¹' F ∩ ball (0 : Euclid (m + 1)) s =
      (fun w => y + r • w) ⁻¹' (F ∩ ball y (r * s)) := by rw [Set.preimage_inter, hball]
  have e2 : ball (0 : Euclid (m + 1)) s \ (fun w => y + r • w) ⁻¹' F =
      (fun w => y + r • w) ⁻¹' (ball y (r * s) \ F) := by rw [Set.preimage_sdiff, hball]
  -- `r^{-(m+1)} · c₂(rs)^{m+1} = c₂s^{m+1}` in `[0, ∞]` (both sides `0` if `c₂ ≤ 0`)
  have hfac : ENNReal.ofReal (c₂ * s ^ (m + 1)) =
      ENNReal.ofReal (|r ^ (m + 1)|⁻¹) * ENNReal.ofReal (c₂ * (r * s) ^ (m + 1)) := by
    rw [← ENNReal.ofReal_mul (by positivity)]
    congr 1
    rw [abs_of_pos (pow_pos hr _), mul_pow]
    field_simp
  rw [e1, e2, hscale, hscale, hfac]
  exact ⟨by gcongr, by gcongr⟩
/-- **`L¹_loc` transfer** (the passage to the blow-up limit in Simon Ch. 3, 4.3 (7), and in the
volume bounds fixing `λ = 0` after (9)): if `L^{m+1}((F_k Δ F₀) ∩ B_R(0)) → 0` for every `R`,
then `∫_{F_k} f → ∫_{F₀} f` for continuous compactly supported `f`
(`|∫_{F_k} f − ∫_{F₀} f| ≤ sup |f| · L^{m+1}((F_k Δ F₀) ∩ B_R(0))` once `spt f ⊆ B_R(0)`), and
`L^{m+1}(F_k ∩ B_s(0))`, `L^{m+1}(B_s(0) \ F_k)` converge to the values for `F₀`, each differing
from its limit by at most `L^{m+1}((F_k Δ F₀) ∩ B_s(0))`. -/
theorem Submission.codim1_rdo_dg_bh_l1loc_transfer : ∀ (m : ℕ) (Fs : ℕ → Set (Euclid (m + 1))) (F₀ : Set (Euclid (m + 1))), (∀ k, MeasurableSet (Fs k)) → MeasurableSet F₀ → (∀ R : ℝ, Tendsto (fun k => volume (symmDiff (Fs k) F₀ ∩ ball (0 : Euclid (m + 1)) R)) atTop (𝓝 0)) → (∀ f : Euclid (m + 1) → ℝ, Continuous f → HasCompactSupport f → Tendsto (fun k => ∫ z in Fs k, f z) atTop (𝓝 (∫ z in F₀, f z))) ∧ (∀ s : ℝ, Tendsto (fun k => volume (Fs k ∩ ball (0 : Euclid (m + 1)) s)) atTop (𝓝 (volume (F₀ ∩ ball (0 : Euclid (m + 1)) s)))) ∧ ∀ s : ℝ, Tendsto (fun k => volume (ball (0 : Euclid (m + 1)) s \ Fs k)) atTop (𝓝 (volume (ball (0 : Euclid (m + 1)) s \ F₀))) := by
  intro m Fs F₀ hFs hF₀ hconv
  -- `a k → b` in `[0, ∞]` once `b < ∞` and `a k ≤ b + e k`, `b ≤ a k + e k` with `e k → 0`
  have key : ∀ (a : ℕ → ℝ≥0∞) (b : ℝ≥0∞) (e : ℕ → ℝ≥0∞), b ≠ ∞ → Tendsto e atTop (𝓝 0) →
      (∀ k, a k ≤ b + e k) → (∀ k, b ≤ a k + e k) → Tendsto a atTop (𝓝 b) := by
    intro a b e hb he h1 h2
    rw [ENNReal.tendsto_nhds hb]
    intro ε hε
    filter_upwards [he.eventually (gt_mem_nhds hε)] with k hk
    constructor
    · rw [tsub_le_iff_right]
      exact (h2 k).trans (by gcongr)
    · exact (h1 k).trans (by gcongr)
  refine ⟨?_, ?_, ?_⟩
  · intro f hf hfc
    obtain ⟨R, hR⟩ : ∃ R, tsupport f ⊆ ball (0 : Euclid (m + 1)) R :=
      hfc.isCompact.isBounded.subset_ball 0
    obtain ⟨M, hM⟩ : ∃ M, ∀ z, ‖f z‖ ≤ M := hf.bounded_above_of_compact_support hfc
    have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
    have hM' : ∀ z, |f z| ≤ M := fun z => by rw [← Real.norm_eq_abs]; exact hM z
    have hfi : Integrable f := hf.integrable_of_hasCompactSupport hfc
    set E : ℕ → Set (Euclid (m + 1)) := fun k => symmDiff (Fs k) F₀ ∩ ball (0 : Euclid (m + 1)) R
    have hEm : ∀ k, MeasurableSet (E k) := fun k =>
      ((hFs k).symmDiff hF₀).inter measurableSet_ball
    have hEfin : ∀ k, volume (E k) ≠ ∞ := fun k =>
      ne_top_of_le_ne_top measure_ball_lt_top.ne (measure_mono Set.inter_subset_right)
    -- `|1_{F_k} f − 1_{F₀} f| ≤ M · 1_{E k}`, as `f = 0` off `B_R(0)`
    have hbound : ∀ k, ‖(∫ z in Fs k, f z) - ∫ z in F₀, f z‖ ≤ M * (volume (E k)).toReal := by
      intro k
      rw [← integral_indicator (hFs k), ← integral_indicator hF₀,
        ← integral_sub (hfi.indicator (hFs k)) (hfi.indicator hF₀)]
      have hgi : Integrable ((E k).indicator (fun _ => M)) :=
        (integrableOn_const (hEfin k)).integrable_indicator (hEm k)
      calc ‖∫ z, ((Fs k).indicator f z - F₀.indicator f z)‖
          ≤ ∫ z, (E k).indicator (fun _ => M) z := by
            refine norm_integral_le_of_norm_le hgi (Eventually.of_forall fun z => ?_)
            by_cases hz : z ∈ E k
            · rw [Set.indicator_of_mem hz]
              by_cases h1 : z ∈ Fs k <;> by_cases h2 : z ∈ F₀ <;>
                simp [Set.indicator_of_mem, Set.indicator_of_notMem, h1, h2, hM0, hM' z]
            · rw [Set.indicator_of_notMem hz, norm_le_zero_iff, sub_eq_zero]
              by_cases hzR : z ∈ ball (0 : Euclid (m + 1)) R
              · -- `z ∉ F_k Δ F₀`, so `z ∈ F_k ↔ z ∈ F₀`
                have hzs : z ∉ symmDiff (Fs k) F₀ := fun h => hz ⟨h, hzR⟩
                rw [Set.mem_symmDiff, not_or, not_and_not_right, not_and_not_right] at hzs
                by_cases h1 : z ∈ Fs k
                · rw [Set.indicator_of_mem h1, Set.indicator_of_mem (hzs.1 h1)]
                · rw [Set.indicator_of_notMem h1,
                    Set.indicator_of_notMem fun h2 => h1 (hzs.2 h2)]
              · have hfz : f z = 0 := image_eq_zero_of_notMem_tsupport fun h => hzR (hR h)
                rw [Set.indicator_apply_eq_zero.2 fun _ => hfz,
                  Set.indicator_apply_eq_zero.2 fun _ => hfz]
        _ = M * (volume (E k)).toReal := by
            rw [integral_indicator_const _ (hEm k), smul_eq_mul, mul_comm, measureReal_def]
    have hlim : Tendsto (fun k => M * (volume (E k)).toReal) atTop (𝓝 0) := by
      simpa using ((ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp (hconv R)).const_mul M
    rw [← tendsto_sub_nhds_zero_iff]
    exact squeeze_zero_norm hbound hlim
  · intro s
    have hb : volume (F₀ ∩ ball (0 : Euclid (m + 1)) s) ≠ ∞ :=
      ne_top_of_le_ne_top measure_ball_lt_top.ne (measure_mono Set.inter_subset_right)
    refine key _ _ _ hb (hconv s) (fun k => ?_) (fun k => ?_)
    · calc volume (Fs k ∩ ball (0 : Euclid (m + 1)) s)
          ≤ volume ((F₀ ∩ ball (0 : Euclid (m + 1)) s) ∪
              (symmDiff (Fs k) F₀ ∩ ball (0 : Euclid (m + 1)) s)) := by
            refine measure_mono fun z hz => ?_
            by_cases h : z ∈ F₀
            · exact Or.inl ⟨h, hz.2⟩
            · exact Or.inr ⟨Set.mem_symmDiff.mpr (Or.inl ⟨hz.1, h⟩), hz.2⟩
        _ ≤ _ := measure_union_le _ _
    · calc volume (F₀ ∩ ball (0 : Euclid (m + 1)) s)
          ≤ volume ((Fs k ∩ ball (0 : Euclid (m + 1)) s) ∪
              (symmDiff (Fs k) F₀ ∩ ball (0 : Euclid (m + 1)) s)) := by
            refine measure_mono fun z hz => ?_
            by_cases h : z ∈ Fs k
            · exact Or.inl ⟨h, hz.2⟩
            · exact Or.inr ⟨Set.mem_symmDiff.mpr (Or.inr ⟨hz.1, h⟩), hz.2⟩
        _ ≤ _ := measure_union_le _ _
  · intro s
    have hb : volume (ball (0 : Euclid (m + 1)) s \ F₀) ≠ ∞ :=
      ne_top_of_le_ne_top measure_ball_lt_top.ne (measure_mono Set.sdiff_subset)
    refine key _ _ _ hb (hconv s) (fun k => ?_) (fun k => ?_)
    · calc volume (ball (0 : Euclid (m + 1)) s \ Fs k)
          ≤ volume ((ball (0 : Euclid (m + 1)) s \ F₀) ∪
              (symmDiff (Fs k) F₀ ∩ ball (0 : Euclid (m + 1)) s)) := by
            refine measure_mono fun z hz => ?_
            by_cases h : z ∈ F₀
            · exact Or.inr ⟨Set.mem_symmDiff.mpr (Or.inr ⟨h, hz.2⟩), hz.1⟩
            · exact Or.inl ⟨hz.1, h⟩
        _ ≤ _ := measure_union_le _ _
    · calc volume (ball (0 : Euclid (m + 1)) s \ F₀)
          ≤ volume ((ball (0 : Euclid (m + 1)) s \ Fs k) ∪
              (symmDiff (Fs k) F₀ ∩ ball (0 : Euclid (m + 1)) s)) := by
            refine measure_mono fun z hz => ?_
            by_cases h : z ∈ Fs k
            · exact Or.inr ⟨Set.mem_symmDiff.mpr (Or.inl ⟨h, hz.2⟩), hz.1⟩
            · exact Or.inl ⟨hz.1, h⟩
        _ ≤ _ := measure_union_le _ _
/-- **The blow-up half-space passes through the origin** (Simon Ch. 3, 4.3: "(10) and (11)
evidently tell us that `λ = 0` in (9)").  If `F₀` and its complement have positive measure in
every `B_s(0)`, and `F₀` is null, conull, or a.e. equal to `{⟨z, v⟩ > c}` with `|v| = 1`, then
`F₀ = {⟨z, v⟩ > 0}` a.e.  Since `|⟨z, v⟩| ≤ |z|`, `B_c(0)` misses `{⟨z, v⟩ > c}` if `c > 0`, and
`B_{−c}(0)` lies inside it if `c < 0`. -/
theorem Submission.codim1_rdo_dg_bh_offset_zero : ∀ (m : ℕ) (F₀ : Set (Euclid (m + 1))) (v : Euclid (m + 1)), ‖v‖ = 1 → (∀ s : ℝ, 0 < s → 0 < volume (F₀ ∩ ball (0 : Euclid (m + 1)) s) ∧ 0 < volume (ball (0 : Euclid (m + 1)) s \ F₀)) → (volume F₀ = 0 ∨ volume F₀ᶜ = 0 ∨ ∃ c : ℝ, volume (symmDiff F₀ {z | c < inner ℝ z v}) = 0) → volume (symmDiff F₀ {z | 0 < inner ℝ z v}) = 0 := by
  intro m F₀ v hv hpos htri
  rcases htri with h | h | ⟨c, hc⟩
  -- `L(F₀) = 0` would give `L(F₀ ∩ B_1(0)) = 0`
  · exact ((hpos 1 one_pos).1.ne' (measure_mono_null Set.inter_subset_left h)).elim
  -- `L(F₀ᶜ) = 0` would give `L(B_1(0) \ F₀) = 0`
  · exact ((hpos 1 one_pos).2.ne' (measure_mono_null (fun x hx => hx.2) h)).elim
  · rcases lt_trichotomy c 0 with hneg | rfl | hcpos
    -- `c < 0`: `⟨z, v⟩ ≥ −|z| > c` on `B_{−c}(0)`, so `B_{−c}(0) \ F₀ ⊆ F₀ Δ {⟨z, v⟩ > c}`
    · have hsub : ball (0 : Euclid (m + 1)) (-c) \ F₀ ⊆ symmDiff F₀ {z | c < inner ℝ z v} := by
        intro z hz
        refine Set.mem_symmDiff.mpr (Or.inr ⟨?_, hz.2⟩)
        have h1 : |inner ℝ z v| ≤ ‖z‖ * ‖v‖ := abs_real_inner_le_norm z v
        have h2 := mem_ball_zero_iff.mp hz.1
        rw [hv, mul_one] at h1
        show c < inner ℝ z v
        linarith [neg_abs_le (inner ℝ z v)]
      exact ((hpos (-c) (neg_pos.mpr hneg)).2.ne' (measure_mono_null hsub hc)).elim
    · exact hc
    -- `c > 0`: `⟨z, v⟩ ≤ |z| < c` on `B_c(0)`, so `F₀ ∩ B_c(0) ⊆ F₀ Δ {⟨z, v⟩ > c}`
    · have hsub : F₀ ∩ ball (0 : Euclid (m + 1)) c ⊆ symmDiff F₀ {z | c < inner ℝ z v} := by
        intro z hz
        refine Set.mem_symmDiff.mpr (Or.inl ⟨hz.1, ?_⟩)
        have h1 : |inner ℝ z v| ≤ ‖z‖ * ‖v‖ := abs_real_inner_le_norm z v
        have h2 := mem_ball_zero_iff.mp hz.2
        rw [hv, mul_one] at h1
        show ¬ c < inner ℝ z v
        linarith [le_abs_self (inner ℝ z v)]
      exact ((hpos c hcpos).1.ne' (measure_mono_null hsub hc)).elim
/-- **Discrete growth** (Simon Ch. 3, 4.3, (10), integrated in discrete steps).  If `V > 0` on
`(0, ρ₁)` and `V(ρ)^{m/(m+1)} ≤ (K/δ)(V(ρ+δ) − V(ρ))` whenever `ρ, δ > 0`, `ρ + δ < ρ₁`, then
`(ρ/(2K(m+1)))^{m+1} ≤ V(ρ)` for `0 < ρ < ρ₁`.  With `W = V^{1/(m+1)}` and the Bernoulli bound
`xⁿ(x + n(y − x)) ≤ x yⁿ` (`x, y ≥ 0`), one step of length `δ` gives
`δw ≤ (W(r+δ) − W(r))(K(m+1)w + mδ)` for `0 ≤ w ≤ W(r)`.  Summing `N` such steps with
`δ = ρ/(2N)` from `ρ/2`, `w = W(ρ/2)` and `N > mρ²/(4K²(m+1)²W(ρ/2)²)` gives
`W(ρ) ≥ ρ/(2K(m+1))`. -/
theorem Submission.codim1_rdo_dg_vdl_discrete_growth : ∀ (m : ℕ) (K ρ₁ : ℝ) (V : ℝ → ℝ), 0 < K → (∀ r : ℝ, 0 < r → r < ρ₁ → 0 < V r) → (∀ ρ δ : ℝ, 0 < ρ → 0 < δ → ρ + δ < ρ₁ → V ρ ^ ((m : ℝ) / (m + 1)) ≤ K / δ * (V (ρ + δ) - V ρ)) → ∀ ρ : ℝ, 0 < ρ → ρ < ρ₁ → (ρ / (2 * K * (m + 1))) ^ (m + 1) ≤ V ρ := by
  intro m K ρ₁ V hK hV hdiff ρ hρ hρ₁
  have hm0 : (0 : ℝ) ≤ m := Nat.cast_nonneg m
  have hm1 : (m : ℝ) + 1 ≠ 0 := by positivity
  have hKm : 0 < K * (m + 1) := by positivity
  -- Bernoulli's inequality `xⁿ (x + n (y − x)) ≤ x yⁿ` for `x, y ≥ 0`
  have bern : ∀ n : ℕ, ∀ x y : ℝ, 0 ≤ x → 0 ≤ y → x ^ n * (x + n * (y - x)) ≤ x * y ^ n := by
    intro n
    induction n with
    | zero => intro x y _ _; simp
    | succ n ih =>
      intro x y hx hy
      have h1 := mul_le_mul_of_nonneg_left (ih x y hx hy) hy
      have h2 : 0 ≤ x ^ n * (n * (y - x) ^ 2) :=
        mul_nonneg (pow_nonneg hx n) (mul_nonneg (Nat.cast_nonneg n) (sq_nonneg (y - x)))
      rw [pow_succ, pow_succ]
      push_cast
      linarith
  -- Step 2: `W = V^{1/(m+1)}`, so `W > 0`, `W^{m+1} = V` and `W^m = V^{m/(m+1)}`
  obtain ⟨W, hWpos, hWpow, hWpowm⟩ : ∃ W : ℝ → ℝ, (∀ r, 0 < r → r < ρ₁ → 0 < W r) ∧
      (∀ r, 0 < r → r < ρ₁ → W r ^ (m + 1) = V r) ∧
      (∀ r, 0 < r → r < ρ₁ → W r ^ m = V r ^ ((m : ℝ) / (m + 1))) := by
    refine ⟨fun r => V r ^ ((1 : ℝ) / (m + 1)), fun r h1 h2 => Real.rpow_pos_of_pos (hV r h1 h2) _,
      fun r h1 h2 => ?_, fun r h1 h2 => ?_⟩
    · show (V r ^ ((1 : ℝ) / (m + 1))) ^ (m + 1) = V r
      rw [← Real.rpow_natCast, ← Real.rpow_mul (hV r h1 h2).le, Nat.cast_add_one,
        one_div_mul_cancel hm1, Real.rpow_one]
    · show (V r ^ ((1 : ℝ) / (m + 1))) ^ m = V r ^ ((m : ℝ) / (m + 1))
      rw [← Real.rpow_natCast, ← Real.rpow_mul (hV r h1 h2).le, one_div_mul_eq_div]
  -- Step 3, algebra: `δ bᵐ ≤ K (a^{m+1} − b^{m+1})` and `0 ≤ w ≤ b` give
  -- `δ w ≤ (a − b) (K (m+1) w + m δ)`
  have alg : ∀ a b δ w : ℝ, 0 < a → 0 < b → 0 < δ → 0 ≤ w → w ≤ b →
      δ * b ^ m ≤ K * (a ^ (m + 1) - b ^ (m + 1)) →
      δ * w ≤ (a - b) * (K * (m + 1) * w + m * δ) := by
    intro a b δ w ha hb hδ hw0 hwb hd
    rw [pow_succ, pow_succ] at hd
    have hP : 0 < a ^ m := pow_pos ha m
    have hQ : 0 < b ^ m := pow_pos hb m
    have hB1 := bern (m + 1) a b ha.le hb.le
    rw [pow_succ, pow_succ] at hB1
    push_cast at hB1
    have hB0 := bern m a b ha.le hb.le
    -- `a^{m+1} − b^{m+1} ≤ (m+1) aᵐ (a − b)`
    have h1 : a ^ m * a - b ^ m * b ≤ (m + 1) * a ^ m * (a - b) := by
      have h : a * (a ^ m * a - b ^ m * b) ≤ a * ((m + 1) * a ^ m * (a - b)) := by linarith
      exact le_of_mul_le_mul_left h ha
    have h2 : δ * b ^ m ≤ K * (m + 1) * a ^ m * (a - b) := by
      have := mul_le_mul_of_nonneg_left h1 hK.le
      linarith
    have hab : 0 ≤ a - b := by
      by_contra hcon
      have : K * (m + 1) * a ^ m * (a - b) ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos (mul_nonneg hKm.le hP.le) (not_le.mp hcon).le
      have : 0 < δ * b ^ m := mul_pos hδ hQ
      linarith
    -- `δ (a − m (a − b)) ≤ K (m+1) a (a − b)`
    have h3 : δ * (a + m * (b - a)) ≤ K * (m + 1) * a * (a - b) := by
      have e1 := mul_le_mul_of_nonneg_left hB0 hδ.le
      have e2 := mul_le_mul_of_nonneg_left h2 ha.le
      have h4 : a ^ m * (δ * (a + m * (b - a))) ≤ a ^ m * (K * (m + 1) * a * (a - b)) := by
        linarith
      exact le_of_mul_le_mul_left h4 hP
    have h5 : a * (δ * w) ≤ a * ((a - b) * (K * (m + 1) * w + m * δ)) := by
      have e1 := mul_le_mul_of_nonneg_left h3 hw0
      have e2 : 0 ≤ (a - b) * m * δ * (a - w) :=
        mul_nonneg (mul_nonneg (mul_nonneg hab hm0) hδ.le) (by linarith)
      linarith
    exact le_of_mul_le_mul_left h5 ha
  -- Step 3: one step of length `δ`
  have step : ∀ r δ w : ℝ, 0 < r → 0 < δ → r + δ < ρ₁ → 0 ≤ w → w ≤ W r →
      δ * w ≤ (W (r + δ) - W r) * (K * (m + 1) * w + m * δ) := by
    intro r δ w hr hδ hrδ hw0 hwb
    have hr1 : r < ρ₁ := by linarith
    have hrδ0 : 0 < r + δ := by linarith
    have hd := hdiff r δ hr hδ hrδ
    rw [← hWpowm r hr hr1, ← hWpow r hr hr1, ← hWpow (r + δ) hrδ0 hrδ] at hd
    refine alg _ _ δ w (hWpos _ hrδ0 hrδ) (hWpos r hr hr1) hδ hw0 hwb ?_
    have hδne : δ ≠ 0 := hδ.ne'
    calc δ * W r ^ m ≤ δ * (K / δ * (W (r + δ) ^ (m + 1) - W r ^ (m + 1))) :=
          mul_le_mul_of_nonneg_left hd hδ.le
      _ = K * (W (r + δ) ^ (m + 1) - W r ^ (m + 1)) := by field_simp
  -- Step 4′: `N` steps of length `δ = ρ/(2N)` from `ρ/2`
  have hρ2 : 0 < ρ / 2 := by linarith
  obtain ⟨w₀, hw₀⟩ : ∃ w₀, w₀ = W (ρ / 2) := ⟨_, rfl⟩
  have hw₀pos : 0 < w₀ := by rw [hw₀]; exact hWpos _ hρ2 (by linarith)
  obtain ⟨N, hN⟩ := exists_nat_gt ((m : ℝ) * ρ ^ 2 / (4 * (K * (m + 1)) ^ 2 * w₀ ^ 2))
  have hNpos : (0 : ℝ) < N := lt_of_le_of_lt (by positivity) hN
  have hNne : (N : ℝ) ≠ 0 := hNpos.ne'
  obtain ⟨δ, hδ⟩ : ∃ δ : ℝ, δ = ρ / (2 * N) := ⟨_, rfl⟩
  have hδpos : 0 < δ := by rw [hδ]; positivity
  have hNδ : (N : ℝ) * δ = ρ / 2 := by
    rw [hδ]
    field_simp
  have ind : ∀ j : ℕ, j ≤ N →
      (j : ℝ) * δ * w₀ ≤ (K * (m + 1) * w₀ + m * δ) * (W (ρ / 2 + j * δ) - w₀) := by
    intro j
    induction j with
    | zero => intro _; simp [hw₀]
    | succ j ih =>
      intro hj
      have ih' := ih (Nat.le_of_succ_le hj)
      have hjN : (j : ℝ) + 1 ≤ N := by exact_mod_cast hj
      have hr : 0 < ρ / 2 + j * δ := by positivity
      have hrδ : ρ / 2 + j * δ + δ < ρ₁ := by
        have := mul_le_mul_of_nonneg_right hjN hδpos.le
        linarith
      have hcoef : 0 < K * (m + 1) * w₀ + m * δ := by positivity
      have hwb : w₀ ≤ W (ρ / 2 + j * δ) := by
        by_contra hcon
        have h1 : (K * (m + 1) * w₀ + m * δ) * (W (ρ / 2 + j * δ) - w₀) < 0 :=
          mul_neg_of_pos_of_neg hcoef (by linarith [not_le.mp hcon])
        have h2 : 0 ≤ (j : ℝ) * δ * w₀ := by positivity
        linarith
      have hs := step (ρ / 2 + j * δ) δ w₀ hr hδpos hrδ hw₀pos.le hwb
      have heq : ρ / 2 + ((j + 1 : ℕ) : ℝ) * δ = ρ / 2 + j * δ + δ := by push_cast; ring
      rw [heq]
      push_cast
      linarith
  have hfin := ind N le_rfl
  have hρN : ρ / 2 + (N : ℝ) * δ = ρ := by rw [hNδ]; ring
  rw [hρN, hNδ] at hfin
  -- `N` is large: `m δ ρ < 2 (K (m+1))² w₀²`
  have hmδ : (m : ℝ) * δ * ρ < 2 * (K * (m + 1)) ^ 2 * w₀ ^ 2 := by
    have h1 : (m : ℝ) * ρ ^ 2 < N * (4 * (K * (m + 1)) ^ 2 * w₀ ^ 2) := by
      rwa [div_lt_iff₀ (by positivity)] at hN
    have h2 : (2 * N) * ((m : ℝ) * δ * ρ) = m * ρ ^ 2 := by
      have : (2 * N) * ((m : ℝ) * δ * ρ) = 2 * m * ρ * (N * δ) := by ring
      rw [this, hNδ]; ring
    have h3 : (2 * N) * ((m : ℝ) * δ * ρ) < (2 * N) * (2 * (K * (m + 1)) ^ 2 * w₀ ^ 2) := by
      rw [h2]; linarith
    exact lt_of_mul_lt_mul_left h3 (by positivity)
  -- Steps 4′(c) and 6: `ρ/(2K(m+1)) ≤ W(ρ)`, so `(ρ/(2K(m+1)))^{m+1} ≤ W(ρ)^{m+1} = V(ρ)`
  have hA : ρ / (2 * K * (m + 1)) ≤ W ρ := by
    rw [div_le_iff₀ (by positivity)]
    by_contra hcon
    have hcoef : 0 < K * (m + 1) * w₀ + m * δ := by positivity
    have e1 := mul_lt_mul_of_pos_left (not_le.mp hcon) hcoef
    have e2 := mul_le_mul_of_nonneg_left hfin hKm.le
    have e3 : 0 ≤ K * (m + 1) * m * δ * w₀ := by positivity
    linarith
  calc (ρ / (2 * K * (m + 1))) ^ (m + 1) ≤ W ρ ^ (m + 1) :=
        pow_le_pow_left₀ (by positivity) hA (m + 1)
    _ = V ρ := hWpow ρ hρ hρ₁
/-- **Annular cut-off** (step 3 of the lower volume-density bound in De Giorgi's theorem, Simon
Ch. 3, 4.3, proof of (10)–(11)).  There is `C₀ > 0` such that for all `ρ, δ > 0` some `C¹`
function `ζ` on `ℝᴾ` has compact support in `B̄_{ρ+δ}(y)`, `0 ≤ ζ ≤ 1`, `ζ = 1` on `B̄_ρ(y)`,
`‖Dζ‖ ≤ C₀/δ`, and `Dζ = 0` off the open annulus `B_{ρ+δ}(y) \ B̄_ρ(y)`.  Take `C₀ = 3/2` and
`ζ(z) = h((‖z − y‖ − ρ)/δ)` with `h(t) = 1 − ∫₀ᵗ 6 max(0, s(1 − s)) ds` (`= 1 − 3t² + 2t³` on
`[0, 1]`): `h` is `C¹`, `1` on `(−∞, 0]`, `0` on `[1, ∞)`, `h' = 0` there and `|h'| ≤ 3/2`.  Then
`ζ` is constant near `y`, `h ∘ u` with `u` smooth away from `y`, and `(3/(2δ))`-Lipschitz by the
reverse triangle inequality. -/
theorem Submission.codim1_rdo_dg_vdl_annular_cutoff : ∃ C₀ : ℝ, 0 < C₀ ∧ ∀ (P : ℕ) (y : Euclid P) (ρ δ : ℝ), 0 < ρ → 0 < δ → ∃ ζ : Euclid P → ℝ, ContDiff ℝ 1 ζ ∧ HasCompactSupport ζ ∧ tsupport ζ ⊆ closedBall y (ρ + δ) ∧ (∀ z, 0 ≤ ζ z ∧ ζ z ≤ 1) ∧ (∀ z ∈ closedBall y ρ, ζ z = 1) ∧ (∀ z, ‖fderiv ℝ ζ z‖ ≤ C₀ / δ) ∧ ∀ z, z ∉ ball y (ρ + δ) \ closedBall y ρ → fderiv ℝ ζ z = 0 := by
  -- Step 1: the profile `h(t) = 1 − ∫₀ᵗ g`, `g(s) = 6 max(0, s(1 − s))`
  obtain ⟨h, hh_C1, hh_flat, hh_bounds, hh_one, hh_zero, hh_lip⟩ : ∃ h : ℝ → ℝ,
      ContDiff ℝ 1 h ∧ (∀ t, t ≤ 0 ∨ 1 ≤ t → HasDerivAt h 0 t) ∧ (∀ t, 0 ≤ h t ∧ h t ≤ 1) ∧
      (∀ t, t ≤ 0 → h t = 1) ∧ (∀ t, 1 ≤ t → h t = 0) ∧
      ∀ a b, ‖h b - h a‖ ≤ 3 / 2 * ‖b - a‖ := by
    set g : ℝ → ℝ := fun s => 6 * max 0 (s * (1 - s)) with hg_eq
    have hg_cont : Continuous g := by fun_prop
    have hg_int : ∀ a b : ℝ, IntervalIntegrable g volume a b := fun a b =>
      hg_cont.intervalIntegrable a b
    have hg_nonneg : ∀ s, 0 ≤ g s := fun s => mul_nonneg (by norm_num) (le_max_left _ _)
    have hg_le : ∀ s, g s ≤ 3 / 2 := fun s => by
      have h : max 0 (s * (1 - s)) ≤ 1 / 4 :=
        max_le (by norm_num) (by nlinarith [sq_nonneg (s - 1 / 2)])
      simp only [hg_eq]
      linarith
    have hg_left : ∀ s, s ≤ 0 → g s = 0 := fun s hs => by
      simp only [hg_eq]
      rw [max_eq_left (mul_nonpos_of_nonpos_of_nonneg hs (by linarith)), mul_zero]
    have hg_right : ∀ s, 1 ≤ s → g s = 0 := fun s hs => by
      simp only [hg_eq]
      rw [max_eq_left (mul_nonpos_of_nonneg_of_nonpos (by linarith) (by linarith)), mul_zero]
    -- `∫₀¹ g = 1`: on `[0, 1]`, `g(s) = 6s(1 − s)` is the derivative of `3s² − 2s³`
    have hg_one : ∫ s in (0 : ℝ)..1, g s = 1 := by
      have hderiv : ∀ s : ℝ, HasDerivAt (fun s : ℝ => 3 * s ^ 2 - 2 * s ^ 3)
          (6 * (s * (1 - s))) s := fun s => by
        convert ((hasDerivAt_pow 2 s).const_mul 3).sub ((hasDerivAt_pow 3 s).const_mul 2) using 1
        norm_num
        ring
      rw [intervalIntegral.integral_congr (g := fun s => 6 * (s * (1 - s))) ?_,
        intervalIntegral.integral_eq_sub_of_hasDerivAt (fun s _ => hderiv s)
          ((by fun_prop : Continuous fun s : ℝ => 6 * (s * (1 - s))).intervalIntegrable _ _)]
      · norm_num
      · intro s hs
        rw [uIcc_of_le zero_le_one] at hs
        simp only [hg_eq]
        rw [max_eq_right (mul_nonneg hs.1 (by linarith [hs.2]))]
    -- the primitive `F(t) = ∫₀ᵗ g`, with `F' = g`
    set F : ℝ → ℝ := fun t => ∫ s in (0 : ℝ)..t, g s with hF_eq
    have hF_deriv : ∀ t, HasDerivAt F (g t) t := fun t =>
      (hg_cont.integral_hasStrictDerivAt 0 t).hasDerivAt
    have hF_left : ∀ t, t ≤ 0 → F t = 0 := fun t ht => by
      simp only [hF_eq]
      rw [intervalIntegral.integral_congr (g := fun _ => (0 : ℝ)) ?_]
      · simp
      · intro s hs
        rw [uIcc_of_ge ht] at hs
        exact hg_left s hs.2
    have hF_right : ∀ t, 1 ≤ t → F t = 1 := fun t ht => by
      simp only [hF_eq]
      rw [← intervalIntegral.integral_add_adjacent_intervals (hg_int 0 1) (hg_int 1 t), hg_one]
      have h : ∫ s in (1 : ℝ)..t, g s = 0 := by
        rw [intervalIntegral.integral_congr (g := fun _ => (0 : ℝ)) ?_]
        · simp
        · intro s hs
          rw [uIcc_of_le ht] at hs
          exact hg_right s hs.1
      rw [h, add_zero]
    have hF_bounds : ∀ t, 0 ≤ F t ∧ F t ≤ 1 := fun t => by
      rcases le_total t 0 with ht | ht
      · rw [hF_left t ht]
        exact ⟨le_rfl, zero_le_one⟩
      rcases le_total 1 t with ht' | ht'
      · rw [hF_right t ht']
        exact ⟨zero_le_one, le_rfl⟩
      refine ⟨intervalIntegral.integral_nonneg ht fun u _ => hg_nonneg u, ?_⟩
      rw [← hg_one]
      exact intervalIntegral.integral_mono_interval le_rfl ht ht' (ae_of_all _ hg_nonneg)
        (hg_int _ _)
    -- `h = 1 − F`, with `h' = −g`
    have hh_deriv : ∀ t, HasDerivAt (fun t => 1 - F t) (-g t) t := fun t =>
      (hF_deriv t).const_sub 1
    refine ⟨fun t => 1 - F t, ?_, fun t ht => ?_, fun t => ?_, fun t ht => ?_, fun t ht => ?_,
      fun a b => ?_⟩
    · rw [contDiff_one_iff_deriv]
      refine ⟨fun t => (hh_deriv t).differentiableAt, ?_⟩
      rw [show deriv (fun t => 1 - F t) = fun t => -g t from funext fun t => (hh_deriv t).deriv]
      exact hg_cont.neg
    · have hg0 : g t = 0 := ht.elim (hg_left t) (hg_right t)
      simpa [hg0] using hh_deriv t
    · obtain ⟨h₀, h₁⟩ := hF_bounds t
      exact ⟨by linarith, by linarith⟩
    · simp only [hF_left t ht, sub_zero]
    · simp only [hF_right t ht, sub_self]
    · refine convex_univ.norm_image_sub_le_of_norm_hasDerivWithin_le
        (fun t _ => (hh_deriv t).hasDerivWithinAt) (fun t _ => ?_) (mem_univ a) (mem_univ b)
      rw [norm_neg, Real.norm_of_nonneg (hg_nonneg t)]
      exact hg_le t
  -- Step 2: `C₀ = 3/2` and `ζ(z) = h(u(z))`, `u(z) = (‖z − y‖ − ρ)/δ`
  refine ⟨3 / 2, by norm_num, fun P y ρ δ hρ hδ => ?_⟩
  -- Step 3: `ζ ≡ 1` on `B_ρ(y)`, a neighbourhood of `y`
  have hζ_near : (fun z : Euclid P => h ((‖z - y‖ - ρ) / δ)) =ᶠ[𝓝 y] fun _ => 1 := by
    filter_upwards [Metric.ball_mem_nhds y hρ] with z hz
    rw [Metric.mem_ball, dist_eq_norm] at hz
    exact hh_one _ ((div_le_iff₀ hδ).2 (by linarith))
  -- `u` is smooth away from `y`
  have hu : ∀ z : Euclid P, z ≠ y → ContDiffAt ℝ 1 (fun w : Euclid P => (‖w - y‖ - ρ) / δ) z :=
    fun z hz => (((contDiffAt_id.sub contDiffAt_const).norm ℝ (sub_ne_zero.2 hz)).sub
      contDiffAt_const).div_const δ
  -- Step 4: `ζ = 0` off `B_{ρ+δ}(y)`, so `tsupport ζ ⊆ closure B_{ρ+δ}(y) ⊆ B̄_{ρ+δ}(y)`
  have htsupp : tsupport (fun z : Euclid P => h ((‖z - y‖ - ρ) / δ)) ⊆ closedBall y (ρ + δ) := by
    refine (closure_mono ?_).trans closure_ball_subset_closedBall
    intro z hz
    by_contra hzb
    apply hz
    rw [Metric.mem_ball, dist_eq_norm, not_lt] at hzb
    exact hh_zero _ ((le_div_iff₀ hδ).2 (by linarith))
  refine ⟨fun z => h ((‖z - y‖ - ρ) / δ), ?_,
    (isCompact_closedBall y (ρ + δ)).of_isClosed_subset (isClosed_tsupport _) htsupp, htsupp,
    fun z => hh_bounds _, fun z hz => ?_, fun z => ?_, fun z hz => ?_⟩
  -- Step 5: `ζ` is `C¹` — constant near `y`, and `h ∘ u` with `u` smooth away from `y`
  · rw [contDiff_iff_contDiffAt]
    intro z
    rcases eq_or_ne z y with rfl | hz
    · exact contDiffAt_const.congr_of_eventuallyEq hζ_near
    · exact hh_C1.contDiffAt.comp z (hu z hz)
  -- Step 3: `ζ = 1` on `B̄_ρ(y)`
  · rw [Metric.mem_closedBall, dist_eq_norm] at hz
    exact hh_one _ ((div_le_iff₀ hδ).2 (by linarith))
  -- Step 6: `ζ` is `(3/(2δ))`-Lipschitz (reverse triangle inequality), so `‖Dζ(z)‖ ≤ 3/(2δ)`
  · refine norm_fderiv_le_of_lip' ℝ (by positivity) (Eventually.of_forall fun w => ?_)
    calc ‖h ((‖w - y‖ - ρ) / δ) - h ((‖z - y‖ - ρ) / δ)‖
        ≤ 3 / 2 * ‖(‖w - y‖ - ρ) / δ - (‖z - y‖ - ρ) / δ‖ := hh_lip _ _
      _ = 3 / 2 / δ * |‖w - y‖ - ‖z - y‖| := by
          rw [Real.norm_eq_abs, ← sub_div, sub_sub_sub_cancel_right, abs_div, abs_of_pos hδ]
          ring
      _ ≤ 3 / 2 / δ * ‖(w - y) - (z - y)‖ := by gcongr; exact abs_norm_sub_norm_le _ _
      _ = 3 / 2 / δ * ‖w - z‖ := by rw [sub_sub_sub_cancel_right]
  -- Step 7: `Dζ(z) = 0` off the open annulus
  · rcases eq_or_ne z y with rfl | hzy
    · rw [hζ_near.fderiv_eq, fderiv_const_apply]
    · -- `u(z) ≤ 0` or `u(z) ≥ 1`, where `h' = 0`; chain rule
      have hu_out : (‖z - y‖ - ρ) / δ ≤ 0 ∨ 1 ≤ (‖z - y‖ - ρ) / δ := by
        rcases le_or_gt ‖z - y‖ ρ with h₁ | h₁
        · exact Or.inl ((div_le_iff₀ hδ).2 (by linarith))
        · refine Or.inr ((le_div_iff₀ hδ).2 ?_)
          have h₂ : z ∉ ball y (ρ + δ) := fun hb => hz ⟨hb, by
            rw [Metric.mem_closedBall, dist_eq_norm, not_le]
            exact h₁⟩
          rw [Metric.mem_ball, dist_eq_norm, not_lt] at h₂
          linarith
      have hD := (hh_flat _ hu_out).comp_hasFDerivAt z
        ((hu z hzy).differentiableAt one_ne_zero).hasFDerivAt
      rw [zero_smul] at hD
      exact hD.fderiv

/-- **Finite-difference form of De Giorgi's volume estimate** (Simon Ch. 3, 4.3, the first
displays of (10); used for 7.5.8).  Let `G ⊆ ℝ^{m+1}` (`m ≥ 1`) be Borel and
`V(r) = L^{m+1}(G ∩ B̄_r(y))`.  Suppose `(∫_G ζ^{(m+1)/m})^{m/(m+1)} ≤ c (∫ ζ dμ + ∫_G |Dζ|)`
for every `C¹` function `ζ ≥ 0` with compact support in `D ⊇ B̄_{ρ₁}(y)` (`μ(B̄_{ρ₁}(y)) < ∞`), and
`δ μ(B̄_ρ(y)) ≤ C₁ L^{m+1}(G ∩ (B_{ρ+δ}(y) \ B̄_ρ(y)))` whenever `ρ, δ > 0`, `ρ + δ < ρ₁`.  Then
`V(ρ)^{m/(m+1)} ≤ (K/δ)(V(ρ+δ) − V(ρ))` for such `ρ, δ`, with `K = 2c(C₁ + C₀)`, `C₀` the constant
of `Submission.codim1_rdo_dg_vdl_annular_cutoff`.  Test the Sobolev inequality with that cut-off
`ζ` for the radii `ρ` and `η = δ/2`: the left side is at least `V(ρ)^{m/(m+1)}`, since `ζ = 1` on
`B̄_ρ(y)`; `∫ ζ dμ ≤ μ(B̄_{ρ+η}(y)) ≤ (C₁/η) L^{m+1}(G ∩ A₂)`, `A₂ = B_{ρ+δ}(y) \ B̄_{ρ+η}(y)`, by
the second hypothesis at radius `ρ + η`; and `∫_G |Dζ| ≤ (C₀/η) L^{m+1}(G ∩ A₁)`,
`A₁ = B_{ρ+η}(y) \ B̄_ρ(y)`.  The sets `G ∩ B̄_ρ(y)`, `G ∩ A₁` and `G ∩ A₂` are disjoint subsets of
`G ∩ B̄_{ρ+δ}(y)`. -/
theorem Submission.codim1_rdo_dg_vdl_finite_difference : ∀ (m : ℕ) (D G : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (y : Euclid (m + 1)) (ρ₁ C₁ c : ℝ), 1 ≤ m → MeasurableSet G → 0 < c → 0 ≤ C₁ → closedBall y ρ₁ ⊆ D → μ (closedBall y ρ₁) ≠ ∞ → (∀ ζ : Euclid (m + 1) → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ → tsupport ζ ⊆ D → (∀ z, 0 ≤ ζ z) → (∫ z in G, ζ z ^ ((m + 1 : ℝ) / m)) ^ ((m : ℝ) / (m + 1)) ≤ c * (∫ z, ζ z ∂μ + ∫ z in G, ‖fderiv ℝ ζ z‖)) → (∀ ρ δ : ℝ, 0 < ρ → 0 < δ → ρ + δ < ρ₁ → ENNReal.ofReal δ * μ (closedBall y ρ) ≤ ENNReal.ofReal C₁ * volume (G ∩ (ball y (ρ + δ) \ closedBall y ρ))) → ∃ K : ℝ, 0 < K ∧ ∀ ρ δ : ℝ, 0 < ρ → 0 < δ → ρ + δ < ρ₁ → (volume (G ∩ closedBall y ρ)).toReal ^ ((m : ℝ) / (m + 1)) ≤ K / δ * ((volume (G ∩ closedBall y (ρ + δ))).toReal - (volume (G ∩ closedBall y ρ)).toReal) := by
  intro m D G μ y ρ₁ C₁ c hm hG hc hC₁ hD hμ hS hA
  obtain ⟨C₀, hC₀, hcut⟩ := Submission.codim1_rdo_dg_vdl_annular_cutoff
  refine ⟨2 * c * (C₁ + C₀), mul_pos (mul_pos two_pos hc) (by linarith), ?_⟩
  intro ρ δ hρ hδ hρδ
  -- Step 0: the exponents, the half width `η = δ/2` and the two annuli `A₁`, `A₂`.
  have hm0 : (0 : ℝ) < m := Nat.cast_pos.2 (by omega)
  have hp : (0 : ℝ) < (m + 1 : ℝ) / m := div_pos (by positivity) hm0
  have hq : (0 : ℝ) ≤ (m : ℝ) / (m + 1) := by positivity
  obtain ⟨η, hη_def⟩ : ∃ η : ℝ, η = δ / 2 := ⟨_, rfl⟩
  have hη : 0 < η := by rw [hη_def]; exact half_pos hδ
  set A₁ := ball y (ρ + η) \ closedBall y ρ
  set A₂ := ball y (ρ + δ) \ closedBall y (ρ + η)
  have hA₁m : MeasurableSet A₁ := measurableSet_ball.diff measurableSet_closedBall
  have hA₂m : MeasurableSet A₂ := measurableSet_ball.diff measurableSet_closedBall
  have hA₁fin : volume A₁ ≠ ∞ :=
    ne_top_of_le_ne_top measure_ball_lt_top.ne (measure_mono sdiff_subset)
  have hA₂fin : volume A₂ ≠ ∞ :=
    ne_top_of_le_ne_top measure_ball_lt_top.ne (measure_mono sdiff_subset)
  have hGA₁fin : volume (G ∩ A₁) ≠ ∞ := ne_top_of_le_ne_top hA₁fin (measure_mono inter_subset_right)
  have hGA₂fin : volume (G ∩ A₂) ≠ ∞ := ne_top_of_le_ne_top hA₂fin (measure_mono inter_subset_right)
  have hGB : ∀ r : ℝ, volume (G ∩ closedBall y r) ≠ ∞ := fun r =>
    ne_top_of_le_ne_top measure_closedBall_lt_top.ne (measure_mono inter_subset_right)
  -- `∫_G 𝟙_s a dL^{m+1} = a L^{m+1}(G ∩ s)`
  have hind : ∀ s : Set (Euclid (m + 1)), MeasurableSet s → ∀ a : ℝ,
      ∫ z in G, s.indicator (fun _ => a) z = a * (volume (G ∩ s)).toReal := by
    intro s hs a
    rw [integral_indicator_const a hs, measureReal_restrict_apply hs, smul_eq_mul, mul_comm,
      inter_comm s G, measureReal_def]
  -- Step 1: the cut-off `ζ` for the radii `ρ` and `η`; it is admissible in the Sobolev inequality.
  obtain ⟨ζ, hζC, hζc, hζsupp, hζ01, hζ1, hζgrad, hζzero⟩ := hcut (m + 1) y ρ η hρ hη
  have hsub : closedBall y (ρ + η) ⊆ closedBall y ρ₁ := closedBall_subset_closedBall (by linarith)
  have hSob := hS ζ hζC hζc (hζsupp.trans (hsub.trans hD)) fun z => (hζ01 z).1
  -- Step 2: `V(ρ) ≤ ∫_G ζ^{(m+1)/m}`, as `ζ^{(m+1)/m} ≥ 𝟙_{B̄_ρ}`.
  have hleft : (volume (G ∩ closedBall y ρ)).toReal ≤ ∫ z in G, ζ z ^ ((m + 1 : ℝ) / m) := by
    have hcont : Continuous fun z => ζ z ^ ((m + 1 : ℝ) / m) :=
      hζC.continuous.rpow_const fun _ => Or.inr hp.le
    have hcpt : HasCompactSupport fun z => ζ z ^ ((m + 1 : ℝ) / m) :=
      hζc.comp_left (g := fun t : ℝ => t ^ ((m + 1 : ℝ) / m)) (Real.zero_rpow hp.ne')
    have hint : Integrable (fun z => ζ z ^ ((m + 1 : ℝ) / m)) (volume.restrict G) :=
      (hcont.integrable_of_hasCompactSupport hcpt).integrableOn
    calc (volume (G ∩ closedBall y ρ)).toReal
        = ∫ z in G, (closedBall y ρ).indicator (fun _ => (1 : ℝ)) z := by
          rw [hind _ measurableSet_closedBall, one_mul]
      _ ≤ ∫ z in G, ζ z ^ ((m + 1 : ℝ) / m) := by
          refine integral_mono_of_nonneg (Eventually.of_forall fun z => ?_) hint
            (Eventually.of_forall fun z => ?_)
          · exact indicator_nonneg (fun _ _ => zero_le_one) z
          · dsimp only
            by_cases hz : z ∈ closedBall y ρ
            · rw [indicator_of_mem hz, hζ1 z hz, Real.one_rpow]
            · rw [indicator_of_notMem hz]
              exact Real.rpow_nonneg (hζ01 z).1 _
  -- Step 3: `η ∫ ζ dμ ≤ η μ(B̄_{ρ+η}) ≤ C₁ L^{m+1}(G ∩ A₂)`, by the annular bound at `ρ + η`.
  have hμfin : μ (closedBall y (ρ + η)) ≠ ∞ := ne_top_of_le_ne_top hμ (measure_mono hsub)
  have hIμ : ∫ z, ζ z ∂μ ≤ (μ (closedBall y (ρ + η))).toReal := by
    have hint : Integrable ((closedBall y (ρ + η)).indicator fun _ => (1 : ℝ)) μ :=
      (integrableOn_const hμfin).integrable_indicator measurableSet_closedBall
    calc ∫ z, ζ z ∂μ ≤ ∫ z, (closedBall y (ρ + η)).indicator (fun _ => (1 : ℝ)) z ∂μ := by
          refine integral_mono_of_nonneg (Eventually.of_forall fun z => (hζ01 z).1) hint
            (Eventually.of_forall fun z => ?_)
          by_cases hz : z ∈ closedBall y (ρ + η)
          · rw [indicator_of_mem hz]
            exact (hζ01 z).2
          · rw [indicator_of_notMem hz, image_eq_zero_of_notMem_tsupport fun h => hz (hζsupp h)]
      _ = (μ (closedBall y (ρ + η))).toReal := by
          rw [integral_indicator_const _ measurableSet_closedBall, smul_eq_mul, mul_one,
            measureReal_def]
  have hAη : ENNReal.ofReal η * μ (closedBall y (ρ + η)) ≤
      ENNReal.ofReal C₁ * volume (G ∩ A₂) := by
    have h := hA (ρ + η) η (by linarith) hη (by linarith)
    rwa [show ρ + η + η = ρ + δ by linarith] at h
  have hμterm : η * ∫ z, ζ z ∂μ ≤ C₁ * (volume (G ∩ A₂)).toReal := by
    have h := ENNReal.toReal_mono (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hGA₂fin) hAη
    rw [ENNReal.toReal_mul, ENNReal.toReal_mul, ENNReal.toReal_ofReal hη.le,
      ENNReal.toReal_ofReal hC₁] at h
    exact (mul_le_mul_of_nonneg_left hIμ hη.le).trans h
  -- Step 4: `η ∫_G |Dζ| ≤ C₀ L^{m+1}(G ∩ A₁)`, as `|Dζ| ≤ (C₀/η) 𝟙_{A₁}`.
  have hgrad : ∫ z in G, ‖fderiv ℝ ζ z‖ ≤ C₀ / η * (volume (G ∩ A₁)).toReal := by
    have hint : Integrable (A₁.indicator fun _ => C₀ / η) (volume.restrict G) :=
      ((integrableOn_const hA₁fin).integrable_indicator hA₁m).integrableOn
    calc ∫ z in G, ‖fderiv ℝ ζ z‖ ≤ ∫ z in G, A₁.indicator (fun _ => C₀ / η) z := by
          refine integral_mono_of_nonneg (Eventually.of_forall fun z => norm_nonneg _) hint
            (Eventually.of_forall fun z => ?_)
          dsimp only
          by_cases hz : z ∈ A₁
          · rw [indicator_of_mem hz]
            exact hζgrad z
          · rw [indicator_of_notMem hz, hζzero z hz, norm_zero]
      _ = C₀ / η * (volume (G ∩ A₁)).toReal := hind A₁ hA₁m _
  have hgradterm : η * ∫ z in G, ‖fderiv ℝ ζ z‖ ≤ C₀ * (volume (G ∩ A₁)).toReal := by
    calc η * ∫ z in G, ‖fderiv ℝ ζ z‖ ≤ η * (C₀ / η * (volume (G ∩ A₁)).toReal) :=
          mul_le_mul_of_nonneg_left hgrad hη.le
      _ = C₀ * (volume (G ∩ A₁)).toReal := by field_simp
  -- Step 5: `G ∩ B̄_ρ`, `G ∩ A₁`, `G ∩ A₂` are disjoint subsets of `G ∩ B̄_{ρ+δ}`.
  have hpieces : (volume (G ∩ closedBall y ρ)).toReal + (volume (G ∩ A₁)).toReal +
      (volume (G ∩ A₂)).toReal ≤ (volume (G ∩ closedBall y (ρ + δ))).toReal := by
    have hd₁ : Disjoint (G ∩ closedBall y ρ) (G ∩ A₁) := by
      rw [Set.disjoint_left]
      rintro z ⟨-, hz⟩ ⟨-, -, hz'⟩
      exact hz' hz
    have hd₂ : Disjoint (G ∩ closedBall y ρ ∪ G ∩ A₁) (G ∩ A₂) := by
      rw [Set.disjoint_left]
      rintro z hz ⟨-, -, hz'⟩
      apply hz'
      rcases hz with ⟨-, hz⟩ | ⟨-, hz, -⟩
      · exact closedBall_subset_closedBall (by linarith) hz
      · exact ball_subset_closedBall hz
    have hsub' : G ∩ closedBall y ρ ∪ G ∩ A₁ ∪ G ∩ A₂ ⊆ G ∩ closedBall y (ρ + δ) := by
      rintro z ((⟨hzG, hz⟩ | ⟨hzG, hz, -⟩) | ⟨hzG, hz, -⟩)
      · exact ⟨hzG, closedBall_subset_closedBall (by linarith) hz⟩
      · exact ⟨hzG, closedBall_subset_closedBall (by linarith) (ball_subset_closedBall hz)⟩
      · exact ⟨hzG, ball_subset_closedBall hz⟩
    have hle : volume (G ∩ closedBall y ρ) + volume (G ∩ A₁) + volume (G ∩ A₂) ≤
        volume (G ∩ closedBall y (ρ + δ)) := by
      rw [← measure_union hd₁ (hG.inter hA₁m), ← measure_union hd₂ (hG.inter hA₂m)]
      exact measure_mono hsub'
    rw [← ENNReal.toReal_add (hGB ρ) hGA₁fin,
      ← ENNReal.toReal_add (ENNReal.add_ne_top.2 ⟨hGB ρ, hGA₁fin⟩) hGA₂fin]
    exact ENNReal.toReal_mono (hGB (ρ + δ)) hle
  -- Step 6: combine, with `δ = 2η` and `K = 2c(C₁ + C₀)`.
  have ha₁ : 0 ≤ (volume (G ∩ A₁)).toReal := ENNReal.toReal_nonneg
  have ha₂ : 0 ≤ (volume (G ∩ A₂)).toReal := ENNReal.toReal_nonneg
  have hlhs : (volume (G ∩ closedBall y ρ)).toReal ^ ((m : ℝ) / (m + 1)) ≤
      c * (∫ z, ζ z ∂μ + ∫ z in G, ‖fderiv ℝ ζ z‖) :=
    (Real.rpow_le_rpow ENNReal.toReal_nonneg hleft hq).trans hSob
  have hann : C₁ * (volume (G ∩ A₂)).toReal + C₀ * (volume (G ∩ A₁)).toReal ≤
      (C₁ + C₀) * ((volume (G ∩ closedBall y (ρ + δ))).toReal -
        (volume (G ∩ closedBall y ρ)).toReal) := by
    nlinarith [mul_nonneg hC₁ ha₁, mul_nonneg hC₀.le ha₂]
  have key : η * (volume (G ∩ closedBall y ρ)).toReal ^ ((m : ℝ) / (m + 1)) ≤
      c * (C₁ + C₀) * ((volume (G ∩ closedBall y (ρ + δ))).toReal -
        (volume (G ∩ closedBall y ρ)).toReal) := by
    calc η * (volume (G ∩ closedBall y ρ)).toReal ^ ((m : ℝ) / (m + 1))
        ≤ η * (c * (∫ z, ζ z ∂μ + ∫ z in G, ‖fderiv ℝ ζ z‖)) :=
          mul_le_mul_of_nonneg_left hlhs hη.le
      _ = c * (η * ∫ z, ζ z ∂μ + η * ∫ z in G, ‖fderiv ℝ ζ z‖) := by ring
      _ ≤ c * (C₁ * (volume (G ∩ A₂)).toReal + C₀ * (volume (G ∩ A₁)).toReal) :=
          mul_le_mul_of_nonneg_left (add_le_add hμterm hgradterm) hc.le
      _ ≤ c * ((C₁ + C₀) * ((volume (G ∩ closedBall y (ρ + δ))).toReal -
            (volume (G ∩ closedBall y ρ)).toReal)) :=
          mul_le_mul_of_nonneg_left hann hc.le
      _ = c * (C₁ + C₀) * ((volume (G ∩ closedBall y (ρ + δ))).toReal -
            (volume (G ∩ closedBall y ρ)).toReal) := by ring
  rw [div_mul_eq_mul_div, le_div_iff₀ hδ]
  have hδη : (volume (G ∩ closedBall y ρ)).toReal ^ ((m : ℝ) / (m + 1)) * δ =
      2 * (η * (volume (G ∩ closedBall y ρ)).toReal ^ ((m : ℝ) / (m + 1))) := by
    rw [hη_def]
    ring
  rw [hδη]
  linarith

/-- **One-sided volume density bound** (the lower bound (10) of Simon Ch. 3, 4.3, for a general
Borel `G`).  Under the Sobolev inequality (S) on `D ⊇ B̄_{ρ₁}(y)` and the annular bound (A), with
`μ(B̄_r(y)) ≠ 0` for `r > 0`, there is `c' > 0` with `c'ρ^{m+1} ≤ L(G ∩ B_ρ(y))` for
`0 < ρ < ρ₁`.  With `V(r) = L(G ∩ B̄_r(y))`, `finite_difference` gives
`V(ρ)^{m/(m+1)} ≤ (K/δ)(V(ρ + δ) − V(ρ))`; (A) at `ρ = δ = r/2` and `μ(B̄_{r/2}(y)) ≠ 0` give
`V(r) > 0` on `(0, ρ₁)`; `discrete_growth` then gives `V(r) ≥ (r/(2K(m+1)))^{m+1}`, and
`B̄_{ρ/2}(y) ⊆ B_ρ(y)` gives the bound with `c' = (1/(4K(m+1)))^{m+1}`. -/
theorem Submission.codim1_rdo_dg_vdl_one_sided_density : ∀ (m : ℕ) (D G : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (y : Euclid (m + 1)) (ρ₁ C₁ c : ℝ), 1 ≤ m → MeasurableSet G → 0 < c → 0 ≤ C₁ → closedBall y ρ₁ ⊆ D → μ (closedBall y ρ₁) ≠ ∞ → (∀ r : ℝ, 0 < r → μ (closedBall y r) ≠ 0) → (∀ ζ : Euclid (m + 1) → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ → tsupport ζ ⊆ D → (∀ z, 0 ≤ ζ z) → (∫ z in G, ζ z ^ ((m + 1 : ℝ) / m)) ^ ((m : ℝ) / (m + 1)) ≤ c * (∫ z, ζ z ∂μ + ∫ z in G, ‖fderiv ℝ ζ z‖)) → (∀ ρ δ : ℝ, 0 < ρ → 0 < δ → ρ + δ < ρ₁ → ENNReal.ofReal δ * μ (closedBall y ρ) ≤ ENNReal.ofReal C₁ * volume (G ∩ (ball y (ρ + δ) \ closedBall y ρ))) → ∃ c' : ℝ, 0 < c' ∧ ∀ ρ : ℝ, 0 < ρ → ρ < ρ₁ → ENNReal.ofReal (c' * ρ ^ (m + 1)) ≤ volume (G ∩ ball y ρ) := by
  intro m D G μ y ρ₁ C₁ c hm hG hc hC₁ hD hμ_fin hμ_pos hS hA
  -- Step 1: the finite-difference inequality for `V(r) = L(G ∩ B̄_r(y))`
  obtain ⟨K, hK, hdiff⟩ :=
    Submission.codim1_rdo_dg_vdl_finite_difference m D G μ y ρ₁ C₁ c hm hG hc hC₁ hD hμ_fin hS hA
  -- Step 2: `L(G ∩ B̄_r(y)) ≤ L(B̄_r(y)) < ∞`
  have hfin : ∀ r : ℝ, volume (G ∩ closedBall y r) ≠ ∞ := fun r =>
    ((measure_mono inter_subset_right).trans_lt measure_closedBall_lt_top).ne
  -- Step 3: `V > 0` on `(0, ρ₁)`, from (A) at `ρ = δ = r/2`
  have hV_pos : ∀ r : ℝ, 0 < r → r < ρ₁ → 0 < (volume (G ∩ closedBall y r)).toReal := by
    intro r hr hrρ₁
    have hA' := hA (r / 2) (r / 2) (half_pos hr) (half_pos hr) (by linarith)
    have hlhs : ENNReal.ofReal (r / 2) * μ (closedBall y (r / 2)) ≠ 0 :=
      mul_ne_zero (ENNReal.ofReal_ne_zero_iff.2 (half_pos hr)) (hμ_pos _ (half_pos hr))
    have hann : volume (G ∩ (ball y (r / 2 + r / 2) \ closedBall y (r / 2))) ≠ 0 := by
      intro h0
      rw [h0, mul_zero] at hA'
      exact hlhs (le_zero_iff.1 hA')
    have hsub : G ∩ (ball y (r / 2 + r / 2) \ closedBall y (r / 2)) ⊆ G ∩ closedBall y r := by
      rw [add_halves]
      exact inter_subset_inter_right _ (sdiff_subset.trans ball_subset_closedBall)
    exact ENNReal.toReal_pos (fun h0 => hann (measure_mono_null hsub h0)) (hfin r)
  -- Step 4: discrete growth, `V(r) ≥ (r/(2K(m+1)))^{m+1}` on `(0, ρ₁)`
  have hgrowth := Submission.codim1_rdo_dg_vdl_discrete_growth m K ρ₁
    (fun r => (volume (G ∩ closedBall y r)).toReal) hK hV_pos hdiff
  -- Step 5: evaluate at `ρ/2`, with `c' = (1/(4K(m+1)))^{m+1}` and `B̄_{ρ/2}(y) ⊆ B_ρ(y)`
  refine ⟨(1 / (4 * K * (m + 1))) ^ (m + 1), by positivity, fun ρ hρ hρρ₁ => ?_⟩
  have hc' : (1 / (4 * K * (m + 1))) ^ (m + 1) * ρ ^ (m + 1) =
      (ρ / 2 / (2 * K * (m + 1))) ^ (m + 1) := by
    rw [← mul_pow]
    congr 1
    field_simp
    ring
  calc ENNReal.ofReal ((1 / (4 * K * (m + 1))) ^ (m + 1) * ρ ^ (m + 1))
      ≤ ENNReal.ofReal (volume (G ∩ closedBall y (ρ / 2))).toReal := by
        rw [hc']
        exact ENNReal.ofReal_le_ofReal (hgrowth (ρ / 2) (half_pos hρ) (by linarith))
    _ = volume (G ∩ closedBall y (ρ / 2)) := ENNReal.ofReal_toReal (hfin _)
    _ ≤ volume (G ∩ ball y ρ) :=
        measure_mono (inter_subset_inter_right _ (closedBall_subset_ball (half_lt_self hρ)))
/-- **The divergence of a compactly supported `C¹` vector field integrates to zero** (used for the
complement in Simon Ch. 3, 4.3 (11)): `∫ trace Dφ(z) dLᴾ(z) = 0` for `φ ∈ C¹_c(ℝᴾ; ℝᴾ)`.
For fixed `w`, the difference quotients `g_t = t⁻¹(φ(· + tw) − φ)` have integral `0` by
translation invariance of `Lᴾ`, tend to `Dφ(·)w` pointwise as `t → 0`, and for `0 < |t| ≤ 1` are
bounded by `M‖w‖ 1_{K'}`, where `M = sup ‖Dφ‖` (mean value inequality) and
`K' = cthickening ‖w‖ (spt φ)` is compact; dominated convergence gives `∫ Dφ(z)w dz = 0`.
Finally `trace Dφ(z) = Σᵢ ⟨eᵢ, Dφ(z)eᵢ⟩`, and the integral commutes with the sum and `⟨eᵢ, ·⟩`. -/
theorem Submission.codim1_rdo_dg_vdl_integral_divergence_eq_zero : ∀ (P : ℕ) (φ : Euclid P → Euclid P), ContDiff ℝ 1 φ → HasCompactSupport φ → ∫ z, LinearMap.trace ℝ (Euclid P) (fderiv ℝ φ z : Euclid P →ₗ[ℝ] Euclid P) = 0 := by
  intro P φ hφ hsupp
  -- step 1: `Dφ` is continuous with compact support, `φ` is `M`-Lipschitz and integrable
  have hdiff : Differentiable ℝ φ := hφ.differentiable one_ne_zero
  have hφc : Continuous φ := hφ.continuous
  have hDc : Continuous (fderiv ℝ φ) := hφ.continuous_fderiv one_ne_zero
  obtain ⟨M, hM⟩ : ∃ M, ∀ z, ‖fderiv ℝ φ z‖ ≤ M :=
    hDc.bounded_above_of_compact_support (hsupp.fderiv ℝ)
  have hlip : ∀ x y : Euclid P, ‖φ y - φ x‖ ≤ M * ‖y - x‖ := fun x y =>
    convex_univ.norm_image_sub_le_of_norm_fderiv_le (fun z _ => hdiff z) (fun z _ => hM z)
      (mem_univ x) (mem_univ y)
  have hint : Integrable φ := hφc.integrable_of_hasCompactSupport hsupp
  -- step 2: `∫ Dφ(z) w dz = 0` for every `w`
  have key : ∀ w : Euclid P, ∫ z, fderiv ℝ φ z w = 0 := by
    intro w
    -- (a) the difference quotients `g_t` have integral zero, by translation invariance
    have ha : ∀ t : ℝ, ∫ z, t⁻¹ • (φ (z + t • w) - φ z) = 0 := fun t => by
      rw [integral_smul, integral_sub (hint.comp_add_right (t • w)) hint,
        integral_add_right_eq_self, sub_self, smul_zero]
    -- (b) `g_t(z) → Dφ(z) w` as `t → 0`, `t ≠ 0`
    have hb : ∀ z, Tendsto (fun t : ℝ => t⁻¹ • (φ (z + t • w) - φ z)) (𝓝[≠] 0)
        (𝓝 (fderiv ℝ φ z w)) := fun z => by
      have h : HasDerivAt (fun t : ℝ => φ (z + t • w)) (fderiv ℝ φ z w) 0 :=
        (hdiff z).hasFDerivAt.hasLineDerivAt w
      simpa only [zero_add, zero_smul, add_zero] using hasDerivAt_iff_tendsto_slope_zero.mp h
    -- (c) for `0 < |t| ≤ 1`, `‖g_t‖ ≤ M‖w‖ 1_{K'}` with `K' = cthickening ‖w‖ (tsupport φ)`
    have hK' : IsCompact (cthickening ‖w‖ (tsupport φ)) := hsupp.cthickening
    have h1 : ∀ᶠ t : ℝ in 𝓝[≠] 0, |t| ≤ 1 := by
      apply eventually_nhdsWithin_of_eventually_nhds
      filter_upwards [closedBall_mem_nhds (0 : ℝ) one_pos] with t ht
      simpa using ht
    have hbound : ∀ᶠ t : ℝ in 𝓝[≠] 0, ∀ᵐ z, ‖t⁻¹ • (φ (z + t • w) - φ z)‖ ≤
        (cthickening ‖w‖ (tsupport φ)).indicator (fun _ => M * ‖w‖) z := by
      filter_upwards [h1, self_mem_nhdsWithin] with t ht ht0
      have ht0' : t ≠ 0 := ht0
      refine ae_of_all _ fun z => ?_
      by_cases hz : z ∈ cthickening ‖w‖ (tsupport φ)
      · rw [indicator_of_mem hz, norm_smul, norm_inv, Real.norm_eq_abs]
        calc |t|⁻¹ * ‖φ (z + t • w) - φ z‖ ≤ |t|⁻¹ * (M * ‖z + t • w - z‖) :=
              mul_le_mul_of_nonneg_left (hlip z (z + t • w)) (inv_nonneg.mpr (abs_nonneg t))
          _ = M * ‖w‖ := by
              rw [add_sub_cancel_left, norm_smul, Real.norm_eq_abs, mul_left_comm,
                inv_mul_cancel_left₀ (abs_ne_zero.mpr ht0')]
      · -- outside `K'`, both `z` and `z + t • w` lie outside `tsupport φ`, so `g_t(z) = 0`
        have hz1 : z ∉ tsupport φ := fun h => hz (self_subset_cthickening _ h)
        have hz2 : z + t • w ∉ tsupport φ := fun h => hz <|
          mem_cthickening_of_dist_le z (z + t • w) ‖w‖ _ h <| by
            rw [dist_eq_norm, sub_add_cancel_left, norm_neg, norm_smul, Real.norm_eq_abs]
            exact mul_le_of_le_one_left (norm_nonneg w) ht
        rw [indicator_of_notMem hz, image_eq_zero_of_notMem_tsupport hz1,
          image_eq_zero_of_notMem_tsupport hz2, sub_self, smul_zero, norm_zero]
    have hbound_int : Integrable ((cthickening ‖w‖ (tsupport φ)).indicator fun _ => M * ‖w‖) :=
      (integrableOn_const hK'.measure_lt_top.ne).integrable_indicator hK'.measurableSet
    -- (d) dominated convergence along `t → 0`, `t ≠ 0`; all the integrals vanish by (a)
    have hd := tendsto_integral_filter_of_dominated_convergence
      (F := fun (t : ℝ) (z : Euclid P) => t⁻¹ • (φ (z + t • w) - φ z)) _
      (Eventually.of_forall fun t =>
        (show Continuous fun z => t⁻¹ • (φ (z + t • w) - φ z) by fun_prop).aestronglyMeasurable)
      hbound hbound_int (ae_of_all _ hb)
    simp only [ha] at hd
    exact tendsto_nhds_unique hd tendsto_const_nhds
  -- step 3: `trace Dφ(z) = Σᵢ ⟨eᵢ, Dφ(z) eᵢ⟩`; integrate termwise
  have htr : ∀ z, LinearMap.trace ℝ (Euclid P) (fderiv ℝ φ z : Euclid P →ₗ[ℝ] Euclid P) =
      ∑ i, inner ℝ (EuclideanSpace.basisFun (Fin P) ℝ i)
        (fderiv ℝ φ z (EuclideanSpace.basisFun (Fin P) ℝ i)) := fun z => by
    rw [LinearMap.trace_eq_sum_inner _ (EuclideanSpace.basisFun (Fin P) ℝ)]
    rfl
  have hcomp : ∀ v : Euclid P, Integrable (fun z => fderiv ℝ φ z v) := fun v =>
    (hDc.clm_apply continuous_const).integrable_of_hasCompactSupport (hsupp.fderiv_apply ℝ v)
  simp_rw [htr]
  rw [integral_finsetSum _ fun i _ => by
    simpa only [innerSL_apply_apply] using
      (innerSL ℝ (EuclideanSpace.basisFun (Fin P) ℝ i)).integrable_comp (hcomp _)]
  refine Finset.sum_eq_zero fun i _ => ?_
  have h := (innerSL ℝ (EuclideanSpace.basisFun (Fin P) ℝ i)).integral_comp_comm
    (hcomp (EuclideanSpace.basisFun (Fin P) ℝ i))
  simp only [innerSL_apply_apply] at h
  rw [h, key, inner_zero_right]

/-- **Simon Ch. 3, proof of 4.3, (11)** ("repeating the same argument with `U ∖ E` in place of
`E`", l. 729–732 of the chapter text): the Gauss–Green identity for `F` with normal `ν` gives the
one for `Fᶜ` with normal `−ν`.  The divergence `trace Dφ` of a `C¹` field with compact support is
continuous with compact support, hence integrable, and has integral `0`
(`codim1_rdo_dg_vdl_integral_divergence_eq_zero`).  So
`∫_{Fᶜ} trace Dφ = −∫_F trace Dφ = ∫ ⟨φ, ν⟩ dμ = −∫ ⟨φ, −ν⟩ dμ`. -/
theorem Submission.codim1_rdo_dg_vdl_gauss_green_compl : ∀ (P : ℕ) (D F : Set (Euclid P)) (μ : Measure (Euclid P)) (ν : Euclid P → Euclid P), MeasurableSet F → (∀ φ : Euclid P → Euclid P, ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ z in F, LinearMap.trace ℝ (Euclid P) (fderiv ℝ φ z : Euclid P →ₗ[ℝ] Euclid P) = -∫ z, inner ℝ (φ z) (ν z) ∂μ) → ∀ φ : Euclid P → Euclid P, ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ z in Fᶜ, LinearMap.trace ℝ (Euclid P) (fderiv ℝ φ z : Euclid P →ₗ[ℝ] Euclid P) = -∫ z, inner ℝ (φ z) (-ν z) ∂μ := by
  intro P D F μ ν hF hGG φ hφ hφc hφD
  -- Step 2: `z ↦ trace Dφ(z)` is continuous with compact support, hence integrable
  have hf_int : Integrable fun z =>
      LinearMap.trace ℝ (Euclid P) (fderiv ℝ φ z : Euclid P →ₗ[ℝ] Euclid P) := by
    -- `A ↦ trace A` is linear on the finite-dimensional space `ℝᴾ →L[ℝ] ℝᴾ`, hence continuous
    have htr : Continuous fun A : Euclid P →L[ℝ] Euclid P =>
        LinearMap.trace ℝ (Euclid P) (A : Euclid P →ₗ[ℝ] Euclid P) :=
      (LinearMap.trace ℝ (Euclid P) ∘ₗ
        ContinuousLinearMap.coeLM ℝ).continuous_of_finiteDimensional
    exact (htr.comp (hφ.continuous_fderiv one_ne_zero)).integrable_of_hasCompactSupport
      ((hφc.fderiv ℝ).comp_left (by simp))
  -- Step 3: `∫_F trace Dφ + ∫_{Fᶜ} trace Dφ = ∫ trace Dφ = 0`
  have hsplit := integral_add_compl hF hf_int
  have hdiv : ∫ z, LinearMap.trace ℝ (Euclid P) (fderiv ℝ φ z : Euclid P →ₗ[ℝ] Euclid P) = 0 :=
    Submission.codim1_rdo_dg_vdl_integral_divergence_eq_zero P φ hφ hφc
  have hF_GG := hGG φ hφ hφc hφD
  -- Step 4: `⟨φ, −ν⟩ = −⟨φ, ν⟩` and `∫ −g dμ = −∫ g dμ`
  simp only [inner_neg_right, integral_neg, neg_neg]
  linarith
/-- **Converging normal averages force positive mass on every ball** (step 2 of the lower volume
density bound in De Giorgi's argument for 7.5.8).  Let `A(ρ) = μ(B̄_ρ(y))⁻¹ ∫_{B̄_ρ(y)} ν dμ`
(with `0⁻¹ = 0`).  If `A(ρ) → v ≠ 0` as `ρ ↓ 0`, then `μ(B̄_r(y)) ≠ 0` for every `r > 0`: some
`ρ ∈ (0, r)` has `A(ρ) ≠ 0`, while `μ(B̄_r(y)) = 0` would give `μ(B̄_ρ(y)) = 0` and so `A(ρ) = 0`. -/
theorem Submission.codim1_rdo_dg_vdl_measure_closedBall_ne_zero : ∀ (P : ℕ) (μ : Measure (Euclid P)) (ν : Euclid P → Euclid P) (y v : Euclid P), v ≠ 0 → Tendsto (fun ρ : ℝ => (μ (closedBall y ρ)).toReal⁻¹ • ∫ z in closedBall y ρ, ν z ∂μ) (𝓝[>] 0) (𝓝 v) → ∀ r : ℝ, 0 < r → μ (closedBall y r) ≠ 0 := by
  intro P μ ν y v hv hlim r hr hμr
  -- Step 1: `A(ρ) → v ≠ 0`, so `A(ρ) ≠ 0` for all small `ρ > 0`
  have hA : ∀ᶠ ρ in 𝓝[>] (0 : ℝ),
      (μ (closedBall y ρ)).toReal⁻¹ • ∫ z in closedBall y ρ, ν z ∂μ ≠ 0 :=
    hlim.eventually_ne hv
  -- Step 2: pick `ρ ∈ (0, r)` with `A(ρ) ≠ 0`
  obtain ⟨ρ, hAρ, hρ⟩ := (hA.and (Ioo_mem_nhdsGT hr)).exists
  -- Step 3: `μ(B̄_ρ(y)) ≤ μ(B̄_r(y)) = 0` would force `A(ρ) = 0`
  have hμρ : μ (closedBall y ρ) = 0 := measure_mono_null (closedBall_subset_closedBall hρ.2.le) hμr
  rw [hμρ, ENNReal.toReal_zero, inv_zero, zero_smul] at hAρ
  exact hAρ rfl
/-- The `C¹` radial cut-off between `B̄_ρ(y)` and `B̄_{ρ+δ}(y)` (it replaces Simon's Lipschitz
cut-offs in Ch. 3, 4.3 (3)–(4)): `ζ = h ∘ a` with `a(z) = (|z - y| - ρ)/δ` and the clamped
smoothstep `h = p ∘ clamp_{[0,1]}`, `p(s) = 1 - 3s² + 2s³`.  As `p'(0) = p'(1) = 0`, `h` is `C¹`,
nonincreasing and `3/2`-Lipschitz, so `ζ` is `C¹`, `ζ = 1` on `B̄_ρ`, `tsupport ζ ⊆ B̄_{ρ+δ}`,
`‖Dζ‖ ≤ 3/(2δ)`, `Dζ = 0` off the open annulus (Fermat at the extrema `ζ = 0, 1`), and
`{t ≤ ζ} = B̄_{ρ+δ s_t}` with `s_t = max {s ∈ [0, 1] | t ≤ h s} < 1`. -/
theorem Submission.codim1_rdo_dg_ce_radial_cutoff : ∀ (P : ℕ) (y : Euclid P) (ρ δ : ℝ), 0 < ρ → 0 < δ → ∃ ζ : Euclid P → ℝ, ContDiff ℝ 1 ζ ∧ HasCompactSupport ζ ∧ (∀ z, 0 ≤ ζ z ∧ ζ z ≤ 1) ∧ (∀ z ∈ closedBall y ρ, ζ z = 1) ∧ tsupport ζ ⊆ closedBall y (ρ + δ) ∧ (∀ z, ‖fderiv ℝ ζ z‖ ≤ 3 / (2 * δ)) ∧ (∀ z, z ∉ ball y (ρ + δ) \ closedBall y ρ → fderiv ℝ ζ z = 0) ∧ ∀ t : ℝ, 0 < t → t ≤ 1 → ∃ r : ℝ, ρ ≤ r ∧ r < ρ + δ ∧ {z | t ≤ ζ z} = closedBall y r := by
  intro P y ρ δ hρ hδ
  -- Steps 1–3: the profile `h = p ∘ cl`, `p(s) = 1 - 3s² + 2s³`, `cl(s) = max 0 (min s 1)`
  have profile : ∃ h : ℝ → ℝ, ContDiff ℝ 1 h ∧ Antitone h ∧ (∀ s, 0 ≤ h s ∧ h s ≤ 1) ∧
      (∀ s, s ≤ 0 → h s = 1) ∧ (∀ s, 1 ≤ s → h s = 0) ∧ LipschitzWith (3 / 2 : NNReal) h := by
    set p : ℝ → ℝ := fun s => 1 - 3 * s ^ 2 + 2 * s ^ 3 with hp_def
    set cl : ℝ → ℝ := fun s => max 0 (min s 1) with hcl_def
    set h : ℝ → ℝ := fun s => p (cl s) with hh_def
    set q : ℝ → ℝ := fun s => -6 * cl s + 6 * cl s ^ 2 with hq_def
    have hp : ∀ s, HasDerivAt p (-6 * s + 6 * s ^ 2) s := by
      intro s
      have h1 := ((hasDerivAt_pow 2 s).const_mul 3).const_sub 1
      have h2 := (hasDerivAt_pow 3 s).const_mul 2
      convert h1.add h2 using 1
      push_cast
      ring
    have hcl0 : ∀ s, s ≤ 0 → cl s = 0 := fun s hs => by
      simp only [hcl_def]; exact max_eq_left (min_le_of_left_le hs)
    have hcl1 : ∀ s, 1 ≤ s → cl s = 1 := fun s hs => by
      simp only [hcl_def]; rw [min_eq_right hs]; exact max_eq_right zero_le_one
    have hclmid : ∀ s, 0 ≤ s → s ≤ 1 → cl s = s := fun s h0 h1 => by
      simp only [hcl_def]; rw [min_eq_left h1]; exact max_eq_right h0
    have hcl01 : ∀ s, 0 ≤ cl s ∧ cl s ≤ 1 := fun s =>
      ⟨le_max_left _ _, max_le zero_le_one (min_le_right _ _)⟩
    -- Step 2: `h' = q = p' ∘ cl` everywhere; at `0` and `1` the one-sided derivatives agree
    have hderiv : ∀ s, HasDerivAt h (q s) s := by
      intro s
      rcases lt_trichotomy s 0 with hs | hs | hs
      · have heq : h =ᶠ[𝓝 s] fun _ => (1 : ℝ) := by
          filter_upwards [Iio_mem_nhds hs] with u hu
          simp only [hh_def, hcl0 u (le_of_lt hu), hp_def]; norm_num
        have hq0 : q s = 0 := by simp only [hq_def, hcl0 s hs.le]; norm_num
        rw [hq0]; exact (hasDerivAt_const s (1 : ℝ)).congr_of_eventuallyEq heq
      · subst hs
        have hq0 : q 0 = 0 := by simp only [hq_def, hcl0 0 le_rfl]; norm_num
        rw [hq0]
        have hL : HasDerivWithinAt h 0 (Iic 0) 0 := by
          refine (hasDerivWithinAt_const (0 : ℝ) (Iic 0) (1 : ℝ)).congr (fun u hu => ?_) ?_
          · simp only [hh_def, hcl0 u hu, hp_def]; norm_num
          · simp only [hh_def, hcl0 0 le_rfl, hp_def]; norm_num
        have hR : HasDerivWithinAt h 0 (Ici 0) 0 := by
          have := (hp 0).hasDerivWithinAt (s := Ici 0)
          simp only [mul_zero, zero_pow two_ne_zero, add_zero] at this
          refine this.congr_of_eventuallyEq ?_ ?_
          · filter_upwards [inter_mem_nhdsWithin (Ici (0 : ℝ))
                (Iio_mem_nhds (show (0 : ℝ) < 1 by norm_num))] with u hu
            simp only [hh_def, hclmid u hu.1 (le_of_lt hu.2)]
          · simp only [hh_def, hclmid 0 le_rfl zero_le_one]
        have := hL.union hR
        rwa [Iic_union_Ici, hasDerivWithinAt_univ] at this
      · rcases lt_trichotomy s 1 with hs1 | hs1 | hs1
        · have heq : h =ᶠ[𝓝 s] p := by
            filter_upwards [Ioo_mem_nhds hs hs1] with u hu
            simp only [hh_def, hclmid u hu.1.le hu.2.le]
          have hqs : q s = -6 * s + 6 * s ^ 2 := by simp only [hq_def, hclmid s hs.le hs1.le]
          rw [hqs]; exact (hp s).congr_of_eventuallyEq heq
        · subst hs1
          have hq0 : q 1 = 0 := by simp only [hq_def, hcl1 1 le_rfl]; norm_num
          rw [hq0]
          have hR : HasDerivWithinAt h 0 (Ici 1) 1 := by
            refine (hasDerivWithinAt_const (1 : ℝ) (Ici 1) (0 : ℝ)).congr (fun u hu => ?_) ?_
            · simp only [hh_def, hcl1 u hu, hp_def]; norm_num
            · simp only [hh_def, hcl1 1 le_rfl, hp_def]; norm_num
          have hL : HasDerivWithinAt h 0 (Iic 1) 1 := by
            have := (hp 1).hasDerivWithinAt (s := Iic 1)
            norm_num at this
            refine this.congr_of_eventuallyEq ?_ ?_
            · filter_upwards [inter_mem_nhdsWithin (Iic (1 : ℝ))
                  (Ioi_mem_nhds (show (0 : ℝ) < 1 by norm_num))] with u hu
              simp only [hh_def, hclmid u (le_of_lt hu.2) hu.1]
            · simp only [hh_def, hclmid 1 zero_le_one le_rfl]
          have := hL.union hR
          rwa [Iic_union_Ici, hasDerivWithinAt_univ] at this
        · have heq : h =ᶠ[𝓝 s] fun _ => (0 : ℝ) := by
            filter_upwards [Ioi_mem_nhds hs1] with u hu
            simp only [hh_def, hcl1 u (le_of_lt hu), hp_def]; norm_num
          have hq0 : q s = 0 := by simp only [hq_def, hcl1 s hs1.le]; norm_num
          rw [hq0]; exact (hasDerivAt_const s (0 : ℝ)).congr_of_eventuallyEq heq
    -- Step 3: `h ∈ C¹`, `-3/2 ≤ h' ≤ 0`, so `h` is antitone and `3/2`-Lipschitz; `0 ≤ h ≤ 1`
    have hdiff : Differentiable ℝ h := fun s => (hderiv s).differentiableAt
    have hderiv_eq : deriv h = q := funext fun s => (hderiv s).deriv
    have hclcont : Continuous cl := by
      simp only [hcl_def]; fun_prop
    have hqcont : Continuous q := by
      simp only [hq_def]; fun_prop
    have hC1 : ContDiff ℝ 1 h := contDiff_one_iff_deriv.2 ⟨hdiff, hderiv_eq ▸ hqcont⟩
    have hq_nonpos : ∀ s, q s ≤ 0 := by
      intro s; obtain ⟨h0, h1⟩ := hcl01 s; simp only [hq_def]; nlinarith
    have hq_abs : ∀ s, |q s| ≤ 3 / 2 := by
      intro s; obtain ⟨h0, h1⟩ := hcl01 s
      rw [abs_of_nonpos (hq_nonpos s)]; simp only [hq_def]; nlinarith [sq_nonneg (cl s - 1 / 2)]
    have hanti : Antitone h := antitone_of_deriv_nonpos hdiff fun s => hderiv_eq ▸ hq_nonpos s
    refine ⟨h, hC1, hanti, ?_, ?_, ?_, ?_⟩
    · intro s; obtain ⟨h0, h1⟩ := hcl01 s
      simp only [hh_def, hp_def]
      have e1 : 1 - 3 * cl s ^ 2 + 2 * cl s ^ 3 = (1 - cl s) ^ 2 * (1 + 2 * cl s) := by ring
      constructor
      · rw [e1]; exact mul_nonneg (sq_nonneg _) (by linarith)
      · nlinarith [mul_nonneg (sq_nonneg (cl s)) (by linarith : (0 : ℝ) ≤ 3 - 2 * cl s)]
    · intro s hs; simp only [hh_def, hcl0 s hs, hp_def]; norm_num
    · intro s hs; simp only [hh_def, hcl1 s hs, hp_def]; norm_num
    · refine lipschitzWith_of_nnnorm_deriv_le hdiff fun s => ?_
      rw [hderiv_eq, ← NNReal.coe_le_coe, coe_nnnorm, Real.norm_eq_abs]
      simpa using hq_abs s
  obtain ⟨h, hC1, hanti, h01, h0, h1, hlip⟩ := profile
  -- Step 4: `ζ = h ∘ a`, `a(z) = (|z - y| - ρ)/δ`; `ζ = 1` on `B̄_ρ` and `ζ = 0` off `B_{ρ+δ}`
  set a : Euclid P → ℝ := fun z => (‖z - y‖ - ρ) / δ with ha_def
  set ζ : Euclid P → ℝ := fun z => h (a z) with hζ_def
  have hζ1 : ∀ z ∈ closedBall y ρ, ζ z = 1 := by
    intro z hz
    rw [mem_closedBall, dist_eq_norm] at hz
    exact h0 _ (div_nonpos_of_nonpos_of_nonneg (by linarith) hδ.le)
  have hζ0 : ∀ z, ρ + δ ≤ ‖z - y‖ → ζ z = 0 := by
    intro z hz
    refine h1 _ ?_
    rw [ha_def, le_div_iff₀ hδ]; linarith
  have hsupp : support ζ ⊆ ball y (ρ + δ) := by
    intro z hz
    rw [mem_ball, dist_eq_norm]
    by_contra hcon
    exact hz (hζ0 z (not_lt.1 hcon))
  have htsupp : tsupport ζ ⊆ closedBall y (ρ + δ) :=
    closure_minimal (hsupp.trans ball_subset_closedBall) isClosed_closedBall
  have hcomp : HasCompactSupport ζ :=
    HasCompactSupport.intro (isCompact_closedBall y (ρ + δ)) fun z hz =>
      image_eq_zero_of_notMem_tsupport (fun h' => hz (htsupp h'))
  -- Step 5: `ζ` is `C¹`: constant near points of `B_ρ`, a `C¹` composite where `z ≠ y`
  have hC1ζ : ContDiff ℝ 1 ζ := by
    refine contDiff_iff_contDiffAt.2 fun z => ?_
    by_cases hz : ‖z - y‖ < ρ
    · have heq : ζ =ᶠ[𝓝 z] fun _ => (1 : ℝ) := by
        have hmem : ball y ρ ∈ 𝓝 z :=
          isOpen_ball.mem_nhds (by rw [mem_ball, dist_eq_norm]; exact hz)
        filter_upwards [hmem] with u hu
        exact hζ1 u (ball_subset_closedBall hu)
      exact contDiffAt_const.congr_of_eventuallyEq heq
    · have hzy : z - y ≠ 0 := by
        intro h0'; rw [h0', norm_zero] at hz; exact hz hρ
      have hn : ContDiffAt ℝ 1 (fun u : Euclid P => ‖u - y‖) z :=
        (contDiffAt_id.sub contDiffAt_const).norm ℝ hzy
      have ha' : ContDiffAt ℝ 1 a z := (hn.sub contDiffAt_const).div_const δ
      exact hC1.contDiffAt.comp z ha'
  -- Step 6: `ζ` is `3/(2δ)`-Lipschitz, hence `‖Dζ‖ ≤ 3/(2δ)`
  have hlipζ : LipschitzWith (Real.toNNReal (3 / (2 * δ))) ζ := by
    refine LipschitzWith.of_dist_le_mul fun z w => ?_
    have h1' := hlip.dist_le_mul (a z) (a w)
    have h2' : dist (a z) (a w) ≤ dist z w / δ := by
      rw [Real.dist_eq, ha_def]
      simp only
      rw [← sub_div, abs_div, abs_of_pos hδ, dist_eq_norm]
      gcongr
      calc |‖z - y‖ - ρ - (‖w - y‖ - ρ)| = |‖z - y‖ - ‖w - y‖| := by ring_nf
        _ ≤ ‖(z - y) - (w - y)‖ := abs_norm_sub_norm_le _ _
        _ = ‖z - w‖ := by abel_nf
    rw [Real.coe_toNNReal _ (by positivity)]
    calc dist (ζ z) (ζ w) ≤ (3 / 2 : NNReal) * dist (a z) (a w) := h1'
      _ ≤ (3 / 2 : ℝ) * (dist z w / δ) := by
          push_cast; gcongr
      _ = 3 / (2 * δ) * dist z w := by field_simp
  have hgrad : ∀ z, ‖fderiv ℝ ζ z‖ ≤ 3 / (2 * δ) := by
    intro z
    have := norm_fderiv_le_of_lipschitz ℝ hlipζ (x₀ := z)
    rwa [Real.coe_toNNReal _ (by positivity)] at this
  -- Step 7: `Dζ = 0` off the open annulus (Fermat at the extrema `ζ = 0` and `ζ = 1`)
  have hζle : ∀ z, ζ z ≤ 1 := fun z => (h01 _).2
  have hζge : ∀ z, 0 ≤ ζ z := fun z => (h01 _).1
  have hzero : ∀ z, z ∉ ball y (ρ + δ) \ closedBall y ρ → fderiv ℝ ζ z = 0 := by
    intro z hz
    rw [Set.mem_sdiff, not_and_or, not_not] at hz
    rcases hz with hz | hz
    · rw [mem_ball, dist_eq_norm, not_lt] at hz
      have hmin : IsLocalMin ζ z := Eventually.of_forall fun u => by rw [hζ0 z hz]; exact hζge u
      exact hmin.fderiv_eq_zero
    · have hmax : IsLocalMax ζ z := Eventually.of_forall fun u => by rw [hζ1 z hz]; exact hζle u
      exact hmax.fderiv_eq_zero
  -- Step 8: `{t ≤ ζ} = B̄_{ρ+δ s_t}` with `s_t = sup M`, `M = {s ∈ [0, 1] | t ≤ h s}` compact
  have hlevel : ∀ t : ℝ, 0 < t → t ≤ 1 →
      ∃ r : ℝ, ρ ≤ r ∧ r < ρ + δ ∧ {z | t ≤ ζ z} = closedBall y r := by
    intro t ht0 ht1
    set M : Set ℝ := Icc 0 1 ∩ h ⁻¹' Ici t with hM
    have hMc : IsCompact M :=
      isCompact_Icc.inter_right (isClosed_Ici.preimage hC1.continuous)
    have hM0 : (0 : ℝ) ∈ M := ⟨⟨le_rfl, zero_le_one⟩, by simp [h0 0 le_rfl, ht1]⟩
    set st := sSup M with hst
    have hstM : st ∈ M := hMc.sSup_mem ⟨0, hM0⟩
    have hst0 : 0 ≤ st := hstM.1.1
    have hst1 : st < 1 := by
      rcases hstM.1.2.lt_or_eq with hlt | heq
      · exact hlt
      · exfalso; have := hstM.2; rw [heq, mem_preimage, mem_Ici, h1 1 le_rfl] at this; linarith
    have hiff : ∀ u : ℝ, t ≤ h u ↔ u ≤ st := by
      intro u
      constructor
      · intro hu
        by_contra hcon
        push Not at hcon
        rcases le_or_gt u 1 with hu1 | hu1
        · have huM : u ∈ M := ⟨⟨hst0.trans hcon.le, hu1⟩, hu⟩
          exact absurd (le_csSup hMc.bddAbove huM) (not_le.2 hcon)
        · rw [h1 u hu1.le] at hu; linarith
      · intro hu
        exact le_trans hstM.2 (hanti hu)
    refine ⟨ρ + δ * st, by nlinarith, by nlinarith, ?_⟩
    ext z
    simp only [Set.mem_ofPred_eq, mem_closedBall, dist_eq_norm, hζ_def]
    rw [hiff, ha_def, div_le_iff₀ hδ]
    constructor <;> intro hh <;> linarith
  exact ⟨ζ, hC1ζ, hcomp, fun z => h01 _, hζ1, htsupp, hgrad, hzero, hlevel⟩
/-- **Signed layer cake** (Simon Ch. 3, 4.3 (4)–(5), the limit procedure of the De Giorgi cut-off
estimates): let `0 ≤ ζ ≤ 1` vanish off `S`, `μ(S) < ∞`, `ζ = 1` on `B`, `|g| ≤ 1` and `c ≥ 0`.  If
`c μ({ζ ≥ t}) ≤ ∫_{ζ ≥ t} g dμ` for every `t ∈ (0, 1]`, then `c μ(B) ≤ ∫ ζ g dμ`.

Proof sketch:
* `ζ(x) g(x) = ∫_{(0,1]} H(x, t) dt` with `H(x, t) = 1{t ≤ ζ(x)} g(x)`; `H` is bounded and
  measurable on the finite product `μ⌞S ⊗ λ⌞(0, 1]`, so Fubini swaps the two integrals.
* For `t ∈ (0, 1]`, `B ⊆ {ζ ≥ t} ⊆ S`, so `∫ H(·, t) dμ⌞S = ∫_{ζ ≥ t} g dμ ≥ c μ({ζ ≥ t}) ≥ c μ(B)`;
  integrating over `(0, 1]` concludes. -/
theorem Submission.codim1_rdo_dg_ce_signed_layer_cake : ∀ (X : Type) [MeasurableSpace X] (μ : Measure X) (ζ g : X → ℝ) (S B : Set X) (c : ℝ), Measurable ζ → Measurable g → (∀ x, 0 ≤ ζ x ∧ ζ x ≤ 1) → (∀ x, |g x| ≤ 1) → MeasurableSet S → μ S ≠ ∞ → (∀ x, x ∉ S → ζ x = 0) → (∀ x ∈ B, ζ x = 1) → 0 ≤ c → (∀ t : ℝ, 0 < t → t ≤ 1 → c * (μ {x | t ≤ ζ x}).toReal ≤ ∫ x in {x | t ≤ ζ x}, g x ∂μ) → c * (μ B).toReal ≤ ∫ x, ζ x * g x ∂μ := by
  intro X _ μ ζ g S B c hζ hg hζ01 hg1 hS hSfin hζS hζB hc hlev
  -- the finite measures `μ⌞S` and `λ⌞(0, 1]`
  have : IsFiniteMeasure (μ.restrict S) := isFiniteMeasure_restrict.2 hSfin
  set ν : Measure ℝ := volume.restrict (Ioc (0 : ℝ) 1) with hν
  have : IsFiniteMeasure ν := isFiniteMeasure_restrict.2 (by simp)
  -- for `t ∈ (0, 1]`, `B ⊆ {ζ ≥ t} ⊆ S`
  have hLS : ∀ t : ℝ, 0 < t → {x | t ≤ ζ x} ⊆ S := fun t ht x hx => by
    by_contra hxS
    have hx' : t ≤ ζ x := hx
    rw [hζS x hxS] at hx'
    linarith
  have hBL : ∀ t : ℝ, t ≤ 1 → B ⊆ {x | t ≤ ζ x} := fun t ht x hx => by
    show t ≤ ζ x
    rw [hζB x hx]
    exact ht
  -- the layer-cake integrand `H(x, t) = 1{t ≤ ζ(x)} g(x)` is integrable on `μ⌞S ⊗ λ⌞(0, 1]`
  set H : X → ℝ → ℝ := fun x t => if t ≤ ζ x then g x else 0 with hH
  have hHmeas : Measurable (uncurry H) :=
    Measurable.ite (measurableSet_le measurable_snd (hζ.comp measurable_fst))
      (hg.comp measurable_fst) measurable_const
  have hHint : Integrable (uncurry H) ((μ.restrict S).prod ν) := by
    refine Integrable.of_bound hHmeas.aestronglyMeasurable 1 (Eventually.of_forall fun p => ?_)
    simp only [uncurry, hH]
    split_ifs
    · simpa [Real.norm_eq_abs] using hg1 p.1
    · simp
  -- inner integral in `t`: `∫_{(0,1]} H(x, t) dt = λ((0, ζ(x)]) g(x) = ζ(x) g(x)`
  have hinner : ∀ x, ∫ t, H x t ∂ν = ζ x * g x := by
    intro x
    have : (fun t => H x t) = (Iic (ζ x)).indicator (fun _ => g x) := by
      funext t; simp [hH, indicator_apply, mem_Iic]
    rw [this, integral_indicator_const _ measurableSet_Iic, smul_eq_mul, hν, Measure.real,
      Measure.restrict_apply measurableSet_Iic]
    have hset : Iic (ζ x) ∩ Ioc (0 : ℝ) 1 = Ioc 0 (ζ x) := by
      ext t; simp only [mem_inter_iff, mem_Iic, mem_Ioc]
      constructor
      · rintro ⟨h1, h2, _⟩; exact ⟨h2, h1⟩
      · rintro ⟨h2, h1⟩; exact ⟨h1, h2, h1.trans (hζ01 x).2⟩
    rw [hset, Real.volume_Ioc, sub_zero, ENNReal.toReal_ofReal (hζ01 x).1]
  -- `ζ g` vanishes off `S`, so `∫ ζ g dμ = ∫∫ H dt dμ⌞S`
  have hleft : ∫ x, ζ x * g x ∂μ = ∫ x, ∫ t, H x t ∂ν ∂(μ.restrict S) := by
    simp_rw [hinner]
    rw [setIntegral_eq_integral_of_forall_compl_eq_zero]
    intro x hx
    simp [hζS x hx]
  -- for `t ∈ (0, 1]`: `∫ H(·, t) dμ⌞S = ∫_{ζ ≥ t} g dμ ≥ c μ({ζ ≥ t}) ≥ c μ(B)`
  have hlow : ∀ t ∈ Ioc (0 : ℝ) 1, c * (μ B).toReal ≤ ∫ x, H x t ∂(μ.restrict S) := by
    intro t ht
    have hLmeas : MeasurableSet {x | t ≤ ζ x} := measurableSet_le measurable_const hζ
    have : (fun x => H x t) = {x | t ≤ ζ x}.indicator g := by
      funext x; simp [hH, indicator_apply]
    rw [this, integral_indicator hLmeas, Measure.restrict_restrict hLmeas,
      inter_eq_left.2 (hLS t ht.1)]
    refine le_trans ?_ (hlev t ht.1 ht.2)
    have hLfin : μ {x | t ≤ ζ x} ≠ ∞ := ne_top_of_le_ne_top hSfin (measure_mono (hLS t ht.1))
    exact mul_le_mul_of_nonneg_left (ENNReal.toReal_mono hLfin (measure_mono (hBL t ht.2))) hc
  have hint_t : Integrable (fun t => ∫ x, H x t ∂(μ.restrict S)) ν := hHint.integral_prod_right
  calc c * (μ B).toReal = ∫ t, c * (μ B).toReal ∂ν := by
        simp [hν, Measure.real]
    _ ≤ ∫ t, ∫ x, H x t ∂(μ.restrict S) ∂ν := by
        refine integral_mono_ae (integrable_const _) hint_t ?_
        rw [hν, EventuallyLE, ae_restrict_iff' measurableSet_Ioc]
        exact Eventually.of_forall hlow
    _ = ∫ x, ∫ t, H x t ∂ν ∂(μ.restrict S) := (integral_integral_swap hHint).symm
    _ = ∫ x, ζ x * g x ∂μ := hleft.symm
/-- The divergence theorem for compactly supported fields (step 6 of the cut-off estimates in the
De Giorgi argument, cf. Simon Ch. 3, 4.3): if `φ : ℝᴾ → ℝᴾ` is `C¹` with compact support, then
`div φ = trace Dφ = ∑ᵢ ∂ᵢφⁱ` is integrable and `∫ div φ dLᴾ = ∑ᵢ ∫ ∂ᵢφⁱ dLᴾ = 0`. -/
theorem Submission.codim1_rdo_dg_ce_integral_div_eq_zero : ∀ (P : ℕ) (φ : Euclid P → Euclid P), ContDiff ℝ 1 φ → HasCompactSupport φ → Integrable (fun z => LinearMap.trace ℝ (Euclid P) (fderiv ℝ φ z : Euclid P →ₗ[ℝ] Euclid P)) ∧ ∫ z, LinearMap.trace ℝ (Euclid P) (fderiv ℝ φ z : Euclid P →ₗ[ℝ] Euclid P) = 0 := by
  intro P φ hφ hφc
  set b := EuclideanSpace.basisFun (Fin P) ℝ with hb
  have hdiff : Differentiable ℝ φ := hφ.differentiable one_ne_zero
  -- the coordinate functions `φⁱ = ⟪bᵢ, φ⟫` are `C¹` with compact support
  set f : Fin P → Euclid P → ℝ := fun i w => innerSL ℝ (b i) (φ w) with hf
  have hfC : ∀ i, ContDiff ℝ 1 (f i) := fun i => (innerSL ℝ (b i)).contDiff.comp hφ
  have hfcs : ∀ i, HasCompactSupport (f i) := fun i => hφc.comp_left (map_zero _)
  have hfder : ∀ i z, fderiv ℝ (f i) z = (innerSL ℝ (b i)).comp (fderiv ℝ φ z) := by
    intro i z
    exact ((innerSL ℝ (b i)).hasFDerivAt.comp z (hdiff z).hasFDerivAt).fderiv
  -- `trace Dφ(z) = ∑ᵢ ⟪bᵢ, Dφ(z) bᵢ⟫ = ∑ᵢ ∂ᵢφⁱ(z)`
  have hcoord : ∀ z, LinearMap.trace ℝ (Euclid P) (fderiv ℝ φ z : Euclid P →ₗ[ℝ] Euclid P) =
      ∑ i, fderiv ℝ (f i) z (b i) := by
    intro z
    rw [LinearMap.trace_eq_sum_inner _ b]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hfder]
    simp [innerSL_apply_apply]
  -- each `∂ᵢφⁱ` is continuous and vanishes off `tsupport φⁱ`, hence integrable
  have hint_i : ∀ i, Integrable (fun z => fderiv ℝ (f i) z (b i)) := by
    intro i
    apply Continuous.integrable_of_hasCompactSupport
    · exact ((hfC i).continuous_fderiv one_ne_zero).clm_apply continuous_const
    · refine (hfcs i).mono' ?_
      intro z hz
      refine support_fderiv_subset ℝ ?_
      intro h0
      exact hz (by simp [h0])
  -- `∫ ∂ᵢφⁱ = 0`: integrate by parts against the constant function `1`
  have hzero_i : ∀ i, ∫ z, fderiv ℝ (f i) z (b i) = 0 := by
    intro i
    obtain ⟨C, hC⟩ := (hfC i).lipschitzWith_of_hasCompactSupport (hfcs i) one_ne_zero
    have h1 := (LipschitzWith.const (1 : ℝ) : LipschitzWith 0 (fun _ : Euclid P => (1 : ℝ))).integral_lineDeriv_mul_eq
      (μ := (volume : Measure (Euclid P))) hC (hfcs i) (b i)
    have hl : ∀ x, lineDeriv ℝ (f i) x (-b i) = -fderiv ℝ (f i) x (b i) := by
      intro x
      rw [(((hfC i).differentiable one_ne_zero) x).lineDeriv_eq_fderiv, map_neg]
    have hc : ∀ x, lineDeriv ℝ (fun _ : Euclid P => (1 : ℝ)) x (b i) = 0 := by
      intro x
      simp [lineDeriv]
    simp only [hc, zero_mul, integral_zero, mul_one, hl, integral_neg] at h1
    linarith
  have hint : Integrable (fun z => LinearMap.trace ℝ (Euclid P) (fderiv ℝ φ z : Euclid P →ₗ[ℝ] Euclid P)) := by
    simp_rw [hcoord]
    exact integrable_finsetSum _ fun i _ => hint_i i
  refine ⟨hint, ?_⟩
  simp_rw [hcoord]
  rw [integral_finsetSum _ fun i _ => hint_i i]
  exact Finset.sum_eq_zero fun i _ => hzero_i i
/-- **Normal averages close to a unit vector** (quantitative form of Simon Ch. 3, 4.3 (1)).  Let
`μ(B̄_{ρ₀}(y)) < ∞`, `ν` be measurable with `|ν| ≤ 1`, `|v| = 1`, and
`A(ρ) := μ(B̄_ρ(y))⁻¹ ∫_{B̄_ρ(y)} ν dμ → v` as `ρ ↓ 0`.  Then for some `ρ₂ ∈ (0, ρ₀]`,
`∫_{B̄_r(y)} ⟨ν, v⟩ dμ ≥ ½ μ(B̄_r(y))` whenever `0 < r < ρ₂`.  Since `⟨A(r), v⟩ → |v|² = 1`, we have
`⟨A(r), v⟩ > ½` for `r ∈ (0, ε)`; take `ρ₂ = min ε ρ₀`.  For `0 < r < ρ₂`, `ν` is integrable on
`B̄_r(y)` (bounded, finite measure), so `∫⟨ν, v⟩ = ⟨∫ν, v⟩`.  Either `μ(B̄_r(y)) = 0` and both sides
vanish, or `∫ν = μ(B̄_r(y)) A(r)` and `∫⟨ν, v⟩ = μ(B̄_r(y)) ⟨A(r), v⟩ ≥ ½ μ(B̄_r(y))`. -/
theorem Submission.codim1_rdo_dg_ce_normal_average_lower : ∀ (P : ℕ) (μ : Measure (Euclid P)) (ν : Euclid P → Euclid P) (y v : Euclid P) (ρ₀ : ℝ), 0 < ρ₀ → μ (closedBall y ρ₀) ≠ ∞ → Measurable ν → (∀ z, ‖ν z‖ ≤ 1) → ‖v‖ = 1 → Tendsto (fun ρ : ℝ => (μ (closedBall y ρ)).toReal⁻¹ • ∫ z in closedBall y ρ, ν z ∂μ) (𝓝[>] 0) (𝓝 v) → ∃ ρ₂ : ℝ, 0 < ρ₂ ∧ ρ₂ ≤ ρ₀ ∧ ∀ r : ℝ, 0 < r → r < ρ₂ → (1 / 2 : ℝ) * (μ (closedBall y r)).toReal ≤ ∫ z in closedBall y r, inner ℝ (ν z) v ∂μ := by
  intro P μ ν y v ρ₀ hρ₀ hfin hν hν1 hv hT
  -- step 1: `⟨A(ρ), v⟩ → ⟨v, v⟩ = 1`, so `⟨A(ρ), v⟩ > ½` for `ρ ∈ (0, ε)`
  have hT' : Tendsto (fun ρ : ℝ => inner ℝ ((μ (closedBall y ρ)).toReal⁻¹ •
      ∫ z in closedBall y ρ, ν z ∂μ) v) (𝓝[>] 0) (𝓝 (inner ℝ v v)) :=
    hT.inner tendsto_const_nhds
  rw [real_inner_self_eq_norm_sq, hv, one_pow] at hT'
  obtain ⟨ε, hε, hεsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1
    (hT'.eventually (lt_mem_nhds (by norm_num : (1 / 2 : ℝ) < 1)))
  -- step 2: `ρ₂ = min ε ρ₀`; for `r < ρ₂`, `μ(B̄_r(y)) ≤ μ(B̄_{ρ₀}(y)) < ∞`
  refine ⟨min ε ρ₀, lt_min hε hρ₀, min_le_right _ _, fun r hr hr₂ => ?_⟩
  have hkey : (1 / 2 : ℝ) < inner ℝ ((μ (closedBall y r)).toReal⁻¹ •
      ∫ z in closedBall y r, ν z ∂μ) v :=
    hεsub ⟨hr, hr₂.trans_le (min_le_left _ _)⟩
  have hBfin : μ (closedBall y r) ≠ ∞ := ne_top_of_le_ne_top hfin
    (measure_mono (closedBall_subset_closedBall (hr₂.trans_le (min_le_right _ _)).le))
  -- step 3: `ν` is integrable on `B̄_r(y)`, and `∫⟨ν, v⟩ = ⟨∫ν, v⟩`
  have hint : IntegrableOn ν (closedBall y r) μ :=
    Measure.integrableOn_of_bounded hBfin hν.aestronglyMeasurable (Eventually.of_forall hν1)
  have hcomm : ∫ z in closedBall y r, inner ℝ (ν z) v ∂μ =
      inner ℝ (∫ z in closedBall y r, ν z ∂μ) v := by
    simpa only [innerSL_apply_apply, real_inner_comm v] using
      (innerSL ℝ v).integral_comp_comm hint
  -- step 4: if `μ(B̄_r(y)) = 0`, both sides vanish
  by_cases hμ0 : μ (closedBall y r) = 0
  · rw [hμ0, ENNReal.toReal_zero, mul_zero, setIntegral_measure_zero _ hμ0]
  -- step 5: otherwise `∫ν = a A(r)` with `a = μ(B̄_r(y)) > 0`, so `∫⟨ν, v⟩ = a ⟨A(r), v⟩ ≥ a / 2`
  have hpos : 0 < (μ (closedBall y r)).toReal := ENNReal.toReal_pos hμ0 hBfin
  have hI : ∫ z in closedBall y r, ν z ∂μ = (μ (closedBall y r)).toReal •
      ((μ (closedBall y r)).toReal⁻¹ • ∫ z in closedBall y r, ν z ∂μ) := by
    rw [smul_smul, mul_inv_cancel₀ hpos.ne', one_smul]
  rw [hcomm, hI, real_inner_smul_left]
  nlinarith

/-- Annular bound behind De Giorgi's cut-off estimates (Simon Ch. 3, 4.3 (3)–(6), in
finite-difference form, as used for 7.5.8).  Suppose `F` satisfies the Gauss–Green identity
`∫_F div φ dLᴾ = -∫ ⟨φ, ν⟩ dμ` for `C¹` fields `φ` with compact support in `D ⊇ B̄_{ρ₂}(y)`
(`|ν| ≤ 1`, `μ(B̄_{ρ₂}(y)) < ∞`), and `½ μ(B̄_r(y)) ≤ ∫_{B̄_r(y)} ⟨ν, v⟩ dμ` for `0 < r < ρ₂`
(`|v| ≤ 1`).  Then `δ μ(B̄_ρ(y)) ≤ 3 Lᴾ(F ∩ (B_{ρ+δ}(y) \ B̄_ρ(y)))` whenever `ρ, δ > 0` and
`ρ + δ < ρ₂`.  Test the identity with `φ = ζ v`, `ζ` the radial cut-off
`Submission.codim1_rdo_dg_ce_radial_cutoff`: `div φ = Dζ v` vanishes off the annulus and is
bounded by `3/(2δ)`, while the signed layer-cake formula
`Submission.codim1_rdo_dg_ce_signed_layer_cake` over the superlevel balls `{ζ ≥ t} = B̄_r(y)`
gives `∫ ζ ⟨v, ν⟩ dμ ≥ ½ μ(B̄_ρ(y))`. -/
theorem Submission.codim1_rdo_dg_ce_annular_bound : ∀ (P : ℕ) (D F : Set (Euclid P)) (μ : Measure (Euclid P)) (ν : Euclid P → Euclid P) (y v : Euclid P) (ρ₂ : ℝ), MeasurableSet F → closedBall y ρ₂ ⊆ D → μ (closedBall y ρ₂) ≠ ∞ → Measurable ν → (∀ z, ‖ν z‖ ≤ 1) → ‖v‖ ≤ 1 → (∀ φ : Euclid P → Euclid P, ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ z in F, LinearMap.trace ℝ (Euclid P) (fderiv ℝ φ z : Euclid P →ₗ[ℝ] Euclid P) = -∫ z, inner ℝ (φ z) (ν z) ∂μ) → (∀ r : ℝ, 0 < r → r < ρ₂ → (1 / 2 : ℝ) * (μ (closedBall y r)).toReal ≤ ∫ z in closedBall y r, inner ℝ (ν z) v ∂μ) → ∀ ρ δ : ℝ, 0 < ρ → 0 < δ → ρ + δ < ρ₂ → ENNReal.ofReal δ * μ (closedBall y ρ) ≤ ENNReal.ofReal 3 * volume (F ∩ (ball y (ρ + δ) \ closedBall y ρ)) := by
  intro P D F μ ν y v ρ₂ _hF hD hfin hν hν1 hv hGG h1' ρ δ hρ hδ hρδ
  set A := ball y (ρ + δ) \ closedBall y ρ
  -- Step 1: `μ(B̄_ρ) ≤ μ(B̄_{ρ+δ}) ≤ μ(B̄_{ρ₂}) < ∞` and `Lᴾ(F ∩ A) ≤ Lᴾ(B_{ρ+δ}) < ∞`.
  have hSsub : closedBall y (ρ + δ) ⊆ closedBall y ρ₂ := closedBall_subset_closedBall hρδ.le
  have hSfin : μ (closedBall y (ρ + δ)) ≠ ∞ := ne_top_of_le_ne_top hfin (measure_mono hSsub)
  have hBfin : μ (closedBall y ρ) ≠ ∞ :=
    ne_top_of_le_ne_top hSfin (measure_mono (closedBall_subset_closedBall (by linarith)))
  have hAmeas : MeasurableSet A := measurableSet_ball.diff measurableSet_closedBall
  have hAfin : volume A ≠ ∞ :=
    ne_top_of_le_ne_top measure_ball_lt_top.ne (measure_mono sdiff_subset)
  have hFAfin : volume (F ∩ A) ≠ ∞ := ne_top_of_le_ne_top hAfin (measure_mono inter_subset_right)
  -- Step 2: the radial cut-off `ζ`, `= 1` on `B̄_ρ`, supported in `B̄_{ρ+δ}`, `|Dζ| ≤ 3/(2δ)`.
  obtain ⟨ζ, hζC, hζc, hζ01, hζ1, hζsupp, hζgrad, hζzero, hζlevel⟩ :=
    Submission.codim1_rdo_dg_ce_radial_cutoff P y ρ δ hρ hδ
  -- Step 3: Gauss–Green for `φ = ζ v`, whose divergence is the trace `Dζ v` of the rank-one
  -- map `Dφ = Dζ ⊗ v`: `∫ ζ ⟨v, ν⟩ dμ = -∫_F Dζ v dLᴾ`.
  have hφD : tsupport (fun z => ζ z • v) ⊆ D :=
    (tsupport_smul_subset_left _ _).trans (hζsupp.trans (hSsub.trans hD))
  have htrace : ∀ z, LinearMap.trace ℝ (Euclid P)
      (fderiv ℝ (fun z => ζ z • v) z : Euclid P →ₗ[ℝ] Euclid P) = fderiv ℝ ζ z v := by
    intro z
    rw [fderiv_smul_const ((hζC.differentiable one_ne_zero) z) v]
    exact LinearMap.trace_smulRight _ _
  have hGGζ : ∫ z, ζ z * inner ℝ v (ν z) ∂μ = -∫ z in F, fderiv ℝ ζ z v := by
    have h := hGG (fun z => ζ z • v) (hζC.smul contDiff_const) hζc.smul_right hφD
    simp only [htrace, real_inner_smul_left] at h
    rw [h, neg_neg]
  -- Step 4: `|Dζ v| ≤ (3/(2δ)) 𝟙_A`, so `-∫_F Dζ v dLᴾ ≤ (3/(2δ)) Lᴾ(F ∩ A)`.
  have hpt : ∀ z, ‖fderiv ℝ ζ z v‖ ≤ A.indicator (fun _ => 3 / (2 * δ)) z := by
    intro z
    by_cases hz : z ∈ A
    · rw [indicator_of_mem hz]
      calc ‖fderiv ℝ ζ z v‖ ≤ ‖fderiv ℝ ζ z‖ * ‖v‖ := (fderiv ℝ ζ z).le_opNorm v
        _ ≤ 3 / (2 * δ) * 1 := mul_le_mul (hζgrad z) hv (norm_nonneg _) (by positivity)
        _ = 3 / (2 * δ) := mul_one _
    · rw [indicator_of_notMem hz, hζzero z hz]
      simp
  have hup : -∫ z in F, fderiv ℝ ζ z v ≤ 3 / (2 * δ) * (volume (F ∩ A)).toReal := by
    have hint : Integrable (A.indicator (fun _ => 3 / (2 * δ))) (volume.restrict F) :=
      ((integrableOn_const hAfin).integrable_indicator hAmeas).restrict
    have heq : ∫ z in F, A.indicator (fun _ => 3 / (2 * δ)) z =
        3 / (2 * δ) * (volume (F ∩ A)).toReal := by
      rw [integral_indicator_const _ hAmeas, smul_eq_mul, mul_comm]
      congr 1
      simp only [Measure.real, Measure.restrict_apply hAmeas, inter_comm]
    calc -∫ z in F, fderiv ℝ ζ z v ≤ ‖∫ z in F, fderiv ℝ ζ z v‖ := by
          rw [Real.norm_eq_abs]; exact neg_le_abs _
      _ ≤ ∫ z in F, A.indicator (fun _ => 3 / (2 * δ)) z :=
          norm_integral_le_of_norm_le hint (Eventually.of_forall hpt)
      _ = 3 / (2 * δ) * (volume (F ∩ A)).toReal := heq
  -- Step 5: the signed layer-cake formula with `g = ⟨v, ν⟩`, `S = B̄_{ρ+δ}`, `B = B̄_ρ`, `c = ½`;
  -- each `{ζ ≥ t} = B̄_r` has `0 < ρ ≤ r < ρ + δ < ρ₂`, where `(1′)` applies.
  have hg : Measurable (fun z => inner ℝ v (ν z)) :=
    (continuous_const.inner continuous_id).measurable.comp hν
  have hlow : (1 / 2 : ℝ) * (μ (closedBall y ρ)).toReal ≤ ∫ z, ζ z * inner ℝ v (ν z) ∂μ := by
    refine Submission.codim1_rdo_dg_ce_signed_layer_cake (Euclid P) μ ζ (fun z => inner ℝ v (ν z))
      (closedBall y (ρ + δ)) (closedBall y ρ) (1 / 2) hζC.continuous.measurable hg hζ01 ?_
      measurableSet_closedBall hSfin ?_ hζ1 (by norm_num) ?_
    · intro z
      calc |inner ℝ v (ν z)| ≤ ‖v‖ * ‖ν z‖ := abs_real_inner_le_norm _ _
        _ ≤ 1 * 1 := mul_le_mul hv (hν1 z) (norm_nonneg _) zero_le_one
        _ = 1 := one_mul 1
    · intro z hz
      exact image_eq_zero_of_notMem_tsupport (fun h => hz (hζsupp h))
    · intro t ht0 ht1
      obtain ⟨r, hr1, hr2, hrset⟩ := hζlevel t ht0 ht1
      rw [hrset]
      simpa only [real_inner_comm] using h1' r (by linarith) (by linarith)
  -- Step 6: `½ μ(B̄_ρ) ≤ (3/(2δ)) Lᴾ(F ∩ A)`; multiply by `2δ > 0`.
  have hreal : δ * (μ (closedBall y ρ)).toReal ≤ 3 * (volume (F ∩ A)).toReal := by
    have key : (1 / 2 : ℝ) * (μ (closedBall y ρ)).toReal ≤
        3 / (2 * δ) * (volume (F ∩ A)).toReal := by
      linarith
    have h3 : 3 / (2 * δ) * (volume (F ∩ A)).toReal * (2 * δ) = 3 * (volume (F ∩ A)).toReal := by
      field_simp
    nlinarith [key, hδ]
  -- Step 7: back to `[0, ∞]`, both measures being finite by step 1.
  calc ENNReal.ofReal δ * μ (closedBall y ρ)
      = ENNReal.ofReal (δ * (μ (closedBall y ρ)).toReal) := by
        rw [ENNReal.ofReal_mul hδ.le, ENNReal.ofReal_toReal hBfin]
    _ ≤ ENNReal.ofReal (3 * (volume (F ∩ A)).toReal) := ENNReal.ofReal_le_ofReal hreal
    _ = ENNReal.ofReal 3 * volume (F ∩ A) := by
        rw [ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_toReal hFAfin]

/-- **Cut-off estimates** of Simon Ch. 3, proof of Theorem 4.3, (1) and (3)–(6), in
finite-difference form, at a point `y` where the normal averages of the Gauss–Green measure `μ`
tend to a unit vector `v`.  `codim1_rdo_dg_ce_normal_average_lower` gives `0 < ρ₂ ≤ ρ₀`, with
`B̄_{ρ₀}(y) ⊆ D`, such that `½ μ(B̄_r(y)) ≤ ∫_{B̄_r(y)} ⟨ν, v⟩ dμ` for `0 < r < ρ₂` (printed (1)).
`codim1_rdo_dg_ce_annular_bound` (the cut-off and layer-cake argument of (3)–(5)) then gives
`δ μ(B̄_ρ(y)) ≤ 3 L(F ∩ (B_{ρ+δ}(y) \ B̄_ρ(y)))` for `ρ + δ < ρ₂`.  Since `∫ div φ = 0`
(`codim1_rdo_dg_ce_integral_div_eq_zero`), `Fᶜ` satisfies the Gauss–Green identity with `−ν`, and
`(−ν, −v)` satisfies the same lower bound, so the annular bound also holds for `Fᶜ`.  Taking
`δ = ρ` and `L(B_{2ρ}(y)) = (2ρ)^{m+1} ω_{m+1}` gives `μ(B̄_ρ(y)) ≤ 3·2^{m+1} ω_{m+1} ρ^m`
(printed (6)).  Finally `ρ₁ = ρ₂/2` and `C = max(3, 3·2^{m+1} ω_{m+1})`. -/
theorem Submission.codim1_rdo_dg_cutoff_estimates : ∀ (m : ℕ) (D F : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)) (y v : Euclid (m + 1)), IsOpen D → MeasurableSet F → μ Dᶜ = 0 → (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μ K ≠ ∞) → Measurable ν → (∀ z, ‖ν z‖ = 1) → (∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ z in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -∫ z, inner ℝ (φ z) (ν z) ∂μ) → y ∈ D → ‖v‖ = 1 → Tendsto (fun ρ : ℝ => (μ (closedBall y ρ)).toReal⁻¹ • ∫ z in closedBall y ρ, ν z ∂μ) (𝓝[>] 0) (𝓝 v) → ∃ ρ₁ C : ℝ, 0 < ρ₁ ∧ 0 ≤ C ∧ closedBall y ρ₁ ⊆ D ∧ (∀ ρ δ : ℝ, 0 < ρ → 0 < δ → ρ + δ < ρ₁ → ENNReal.ofReal δ * μ (closedBall y ρ) ≤ ENNReal.ofReal C * volume (F ∩ (ball y (ρ + δ) \ closedBall y ρ)) ∧ ENNReal.ofReal δ * μ (closedBall y ρ) ≤ ENNReal.ofReal C * volume ((ball y (ρ + δ) \ closedBall y ρ) \ F)) ∧ ∀ ρ : ℝ, 0 < ρ → ρ < ρ₁ → μ (closedBall y ρ) ≤ ENNReal.ofReal (C * ρ ^ m) := by
  intro m D F μ ν y v hD hF hμD hμK hν hν1 hGG hy hv hT
  -- step 1: a radius `ρ₀` with `B̄_{ρ₀}(y) ⊆ D`, and `ρ₂ ≤ ρ₀` below which (1′) holds
  obtain ⟨ε, hε, hεD⟩ := Metric.isOpen_iff.mp hD y hy
  have hρ₀D : closedBall y (ε / 2) ⊆ D := (closedBall_subset_ball (half_lt_self hε)).trans hεD
  have hρ₀fin : μ (closedBall y (ε / 2)) ≠ ∞ := hμK _ (isCompact_closedBall y _) hρ₀D
  obtain ⟨ρ₂, hρ₂pos, hρ₂le, h1'⟩ := Submission.codim1_rdo_dg_ce_normal_average_lower (m + 1) μ ν
    y v (ε / 2) (half_pos hε) hρ₀fin hν (fun z => (hν1 z).le) hv hT
  have hρ₂D : closedBall y ρ₂ ⊆ D := (closedBall_subset_closedBall hρ₂le).trans hρ₀D
  have hρ₂fin : μ (closedBall y ρ₂) ≠ ∞ := hμK _ (isCompact_closedBall y _) hρ₂D
  -- steps 2–5: the annular bound for `F`
  have hA1 := Submission.codim1_rdo_dg_ce_annular_bound (m + 1) D F μ ν y v ρ₂ hF hρ₂D hρ₂fin hν
    (fun z => (hν1 z).le) hv.le hGG h1'
  -- step 6: `Fᶜ` satisfies (GG) with `−ν` because `∫ div φ = 0`, and (1′) holds for `(−ν, −v)`,
  -- so the annular bound also holds for `Fᶜ`
  have hGGc : ∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ →
      tsupport φ ⊆ D → ∫ z in Fᶜ, LinearMap.trace ℝ (Euclid (m + 1))
        (fderiv ℝ φ z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -∫ z, inner ℝ (φ z) (-ν z) ∂μ := by
    intro φ hφ hφc hφD
    obtain ⟨hint, hzero⟩ := Submission.codim1_rdo_dg_ce_integral_div_eq_zero (m + 1) φ hφ hφc
    have hsplit := integral_add_compl hF hint
    rw [hzero, hGG φ hφ hφc hφD] at hsplit
    simp only [inner_neg_right, integral_neg, neg_neg]
    linarith
  have h1'c : ∀ r : ℝ, 0 < r → r < ρ₂ → (1 / 2 : ℝ) * (μ (closedBall y r)).toReal ≤
      ∫ z in closedBall y r, inner ℝ (-ν z) (-v) ∂μ := by
    intro r hr hr2
    simpa only [inner_neg_neg] using h1' r hr hr2
  have hA2 := Submission.codim1_rdo_dg_ce_annular_bound (m + 1) D Fᶜ μ (fun z => -ν z) y (-v) ρ₂
    hF.compl hρ₂D hρ₂fin hν.neg (fun z => by simpa using (hν1 z).le) (by simpa using hv.le) hGGc
    h1'c
  -- step 8: `ρ₁ = ρ₂/2` and `C = max(3, 3·2^{m+1} ω_{m+1})`, where `ω_{m+1} = L(B₁(0))`
  set ω : ℝ := (volume (ball (0 : Euclid (m + 1)) 1)).toReal with hω
  have hωeq : volume (ball (0 : Euclid (m + 1)) 1) = ENNReal.ofReal ω := by
    rw [hω, ENNReal.ofReal_toReal measure_ball_lt_top.ne]
  refine ⟨ρ₂ / 2, max 3 (3 * 2 ^ (m + 1) * ω), half_pos hρ₂pos, le_max_of_le_left (by norm_num),
    (closedBall_subset_closedBall (half_le_self hρ₂pos.le)).trans hρ₂D, ?_, ?_⟩
  -- the annular bounds of steps 5–6 hold below `ρ₁ < ρ₂`, and `3 ≤ C`
  · intro ρ δ hρ hδ hρδ
    have hlt : ρ + δ < ρ₂ := by linarith
    have hC : ENNReal.ofReal 3 ≤ ENNReal.ofReal (max 3 (3 * 2 ^ (m + 1) * ω)) :=
      ENNReal.ofReal_le_ofReal (le_max_left _ _)
    have hset : Fᶜ ∩ (ball y (ρ + δ) \ closedBall y ρ) = (ball y (ρ + δ) \ closedBall y ρ) \ F := by
      ext z; simp [and_comm]
    have h2 := hA2 ρ δ hρ hδ hlt
    rw [hset] at h2
    exact ⟨(hA1 ρ δ hρ hδ hlt).trans (mul_le_mul_left hC _), h2.trans (mul_le_mul_left hC _)⟩
  -- step 7: `δ = ρ` and `L(B_{2ρ}(y)) = (2ρ)^{m+1} ω_{m+1}`
  · intro ρ hρ hρ1
    have hvol : volume (F ∩ (ball y (ρ + ρ) \ closedBall y ρ)) ≤
        ENNReal.ofReal ((ρ + ρ) ^ (m + 1) * ω) := by
      calc volume (F ∩ (ball y (ρ + ρ) \ closedBall y ρ)) ≤ volume (ball y (ρ + ρ)) :=
            measure_mono (inter_subset_right.trans sdiff_subset)
        _ = ENNReal.ofReal ((ρ + ρ) ^ (m + 1)) * volume (ball (0 : Euclid (m + 1)) 1) := by
            rw [Measure.addHaar_ball _ _ (by linarith), finrank_euclideanSpace_fin]
        _ = ENNReal.ofReal ((ρ + ρ) ^ (m + 1) * ω) := by
            rw [hωeq, ENNReal.ofReal_mul (by positivity)]
    have key : ENNReal.ofReal ρ * μ (closedBall y ρ) ≤
        ENNReal.ofReal ρ * ENNReal.ofReal (3 * 2 ^ (m + 1) * ω * ρ ^ m) := by
      calc ENNReal.ofReal ρ * μ (closedBall y ρ)
          ≤ ENNReal.ofReal 3 * volume (F ∩ (ball y (ρ + ρ) \ closedBall y ρ)) :=
            hA1 ρ ρ hρ hρ (by linarith)
        _ ≤ ENNReal.ofReal 3 * ENNReal.ofReal ((ρ + ρ) ^ (m + 1) * ω) := mul_le_mul_right hvol _
        _ = ENNReal.ofReal ρ * ENNReal.ofReal (3 * 2 ^ (m + 1) * ω * ρ ^ m) := by
            rw [← ENNReal.ofReal_mul (by norm_num), ← ENNReal.ofReal_mul hρ.le]
            congr 1
            ring
    have hρne : ENNReal.ofReal ρ ≠ 0 := by simpa using hρ
    refine ((ENNReal.mul_le_mul_iff_right hρne ENNReal.ofReal_ne_top).mp key).trans
      (ENNReal.ofReal_le_ofReal ?_)
    exact mul_le_mul_of_nonneg_right (le_max_right _ _) (by positivity)
/-- **Real-integral form of a lower-integral Gagliardo–Nirenberg–Sobolev inequality** (Simon
Ch. 3, proof of Theorem 4.3 (De Giorgi), Sobolev step, chapter-03.txt lines 689–712; the bound
`(H)` below has the shape of Mathlib's `lintegral_pow_le_pow_lintegral_fderiv`).  If every `C¹`
compactly supported `w : ℝᴾ → ℝ` satisfies `∫⁻ ‖w‖ₑ^p ≤ C (∫⁻ ‖Dw‖ₑ)^p`, then with
`c = C^{1/p} + 1 > 0` every such `w` satisfies `(∫ |w|^p)^{1/p} ≤ c ∫ |Dw|`: `Dw` is continuous
with compact support, so `∫⁻ ‖Dw‖ₑ < ∞`; both Bochner integrals are the `toReal` of the lower
integrals, `(H)` passes to `toReal`, and `t ↦ t^{1/p}` is monotone on `[0, ∞)`. -/
theorem Submission.codim1_rdo_dg_sp_gns_real_of_lintegral : ∀ (P : ℕ) (p : ℝ) (C : NNReal), 0 < p → (∀ w : Euclid P → ℝ, ContDiff ℝ 1 w → HasCompactSupport w → ∫⁻ x, ‖w x‖ₑ ^ p ≤ (C : ℝ≥0∞) * (∫⁻ x, ‖fderiv ℝ w x‖ₑ) ^ p) → ∃ c : ℝ, 0 < c ∧ ∀ w : Euclid P → ℝ, ContDiff ℝ 1 w → HasCompactSupport w → (∫ z, |w z| ^ p) ^ p⁻¹ ≤ c * ∫ z, ‖fderiv ℝ w z‖ := by
  intro P p C hp hH
  -- Step 1: `c = C^{1/p} + 1 > 0`
  refine ⟨(C : ℝ) ^ p⁻¹ + 1, by positivity, ?_⟩
  intro w hw hcs
  -- Step 2: `Dw` is continuous with compact support, so `∫⁻ ‖Dw‖ₑ < ∞` and
  -- `∫ |Dw| = (∫⁻ ‖Dw‖ₑ).toReal`
  have hDcont : Continuous (fderiv ℝ w) := hw.continuous_fderiv one_ne_zero
  have hDint : Integrable (fderiv ℝ w) := hDcont.integrable_of_hasCompactSupport (hcs.fderiv ℝ)
  have hAfin : (∫⁻ x, ‖fderiv ℝ w x‖ₑ) ≠ ∞ := hDint.hasFiniteIntegral.ne
  have hA : ∫ z, ‖fderiv ℝ w z‖ = (∫⁻ x, ‖fderiv ℝ w x‖ₑ).toReal :=
    integral_norm_eq_lintegral_enorm hDcont.aestronglyMeasurable
  -- Step 3: `|w|^p` is continuous and nonnegative, and `ofReal (|w x|^p) = ‖w x‖ₑ^p`, so
  -- `∫ |w|^p = (∫⁻ ‖w‖ₑ^p).toReal`
  have hF : ∫ z, |w z| ^ p = (∫⁻ x, ‖w x‖ₑ ^ p).toReal := by
    rw [integral_eq_lintegral_of_nonneg_ae
      (Eventually.of_forall fun z => Real.rpow_nonneg (abs_nonneg (w z)) p)
      ((hw.continuous.abs.rpow_const fun _ => Or.inr hp.le).aestronglyMeasurable)]
    congr 1
    refine lintegral_congr fun x => ?_
    rw [Real.enorm_eq_ofReal_abs, ENNReal.ofReal_rpow_of_nonneg (abs_nonneg _) hp.le]
  -- Step 4: take `toReal` in `(H)`, whose right side `C · (∫⁻ ‖Dw‖ₑ)^p` is finite
  have h4 : ∫ z, |w z| ^ p ≤ (C : ℝ) * (∫ z, ‖fderiv ℝ w z‖) ^ p := by
    have h := ENNReal.toReal_mono
      (ENNReal.mul_ne_top ENNReal.coe_ne_top (ENNReal.rpow_ne_top_of_nonneg hp.le hAfin))
      (hH w hw hcs)
    rwa [ENNReal.toReal_mul, ← ENNReal.toReal_rpow, ENNReal.coe_toReal, ← hF, ← hA] at h
  -- Step 5: take the `1/p` power: `(C I^p)^{1/p} = C^{1/p} I ≤ c I`
  have hI : 0 ≤ ∫ z, ‖fderiv ℝ w z‖ := integral_nonneg fun z => norm_nonneg _
  have hL : 0 ≤ ∫ z, |w z| ^ p := integral_nonneg fun z => Real.rpow_nonneg (abs_nonneg (w z)) p
  calc (∫ z, |w z| ^ p) ^ p⁻¹ ≤ ((C : ℝ) * (∫ z, ‖fderiv ℝ w z‖) ^ p) ^ p⁻¹ :=
        Real.rpow_le_rpow hL h4 (inv_nonneg.2 hp.le)
    _ = (C : ℝ) ^ p⁻¹ * ∫ z, ‖fderiv ℝ w z‖ := by
        rw [Real.mul_rpow C.coe_nonneg (Real.rpow_nonneg hI p), Real.rpow_rpow_inv hI hp.ne']
    _ ≤ ((C : ℝ) ^ p⁻¹ + 1) * ∫ z, ‖fderiv ℝ w z‖ :=
        mul_le_mul_of_nonneg_right (le_add_of_nonneg_right zero_le_one) hI
/-- **Variation of `1_F ζ` from the Gauss–Green identity** (Simon Ch. 3, proof of Theorem 4.3
(De Giorgi), chapter-03.txt lines 689–712: `|D(ζ 1_F)| ≤ ζ |D1_F| + 1_F |Dζ|`, in dual form).  If
`∫_F div φ = -∫ ⟨φ, ν⟩ dμ` for every `C¹` compactly supported `φ` with `tsupport φ ⊆ D`, `|ν| = 1`
and `μ` is finite on compact subsets of `D`, then for `ζ ≥ 0` `C¹` with compact support in `D` and
`g` `C¹` compactly supported with `|g| ≤ 1`, `|∫ 1_F ζ div g| ≤ ∫ ζ dμ + ∫_F |Dζ|`.  Apply (GG) to
`φ = ζ g`: `div (ζ g) = ζ div g + Dζ(g)` (the trace of `v ↦ Dζ(v) g` is `Dζ(g)`), and bound
`|⟨ζ g, ν⟩| ≤ ζ` and `|Dζ(g)| ≤ |Dζ|`. -/
theorem Submission.codim1_rdo_dg_sp_gauss_green_variation : ∀ (P : ℕ) (D F : Set (Euclid P)) (μ : Measure (Euclid P)) (ν : Euclid P → Euclid P), IsOpen D → MeasurableSet F → μ Dᶜ = 0 → (∀ K : Set (Euclid P), IsCompact K → K ⊆ D → μ K ≠ ∞) → Measurable ν → (∀ z, ‖ν z‖ = 1) → (∀ φ : Euclid P → Euclid P, ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ z in F, LinearMap.trace ℝ (Euclid P) (fderiv ℝ φ z : Euclid P →ₗ[ℝ] Euclid P) = -∫ z, inner ℝ (φ z) (ν z) ∂μ) → ∀ ζ : Euclid P → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ → tsupport ζ ⊆ D → (∀ z, 0 ≤ ζ z) → ∀ g : Euclid P → Euclid P, ContDiff ℝ 1 g → HasCompactSupport g → (∀ z, ‖g z‖ ≤ 1) → |∫ z, F.indicator ζ z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ g z : Euclid P →ₗ[ℝ] Euclid P)| ≤ ∫ z, ζ z ∂μ + ∫ z in F, ‖fderiv ℝ ζ z‖ := by
  intro P D F μ ν _ hF _ hμK _ hν1 hGG ζ hζ hζc hζD hζ0 g hg _ hg1
  -- Step 1: the test field `φ = ζ g` satisfies the hypotheses of (GG)
  have hsupp : support (fun z => ζ z • g z) ⊆ support ζ := fun z hz h0 => hz (by simp [h0])
  have hGGφ := hGG (fun z => ζ z • g z) (hζ.smul hg) (hζc.mono hsupp)
    ((closure_mono hsupp).trans hζD)
  -- Step 2: `div (ζ g) = ζ div g + Dζ(g)`
  have hdiv : ∀ z, LinearMap.trace ℝ (Euclid P)
      (fderiv ℝ (fun z => ζ z • g z) z : Euclid P →ₗ[ℝ] Euclid P) =
      ζ z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ g z : Euclid P →ₗ[ℝ] Euclid P) +
        fderiv ℝ ζ z (g z) := by
    intro z
    rw [fderiv_fun_smul ((hζ.differentiable one_ne_zero) z) ((hg.differentiable one_ne_zero) z),
      ContinuousLinearMap.toLinearMap_add, ContinuousLinearMap.toLinearMap_smul, map_add, map_smul,
      smul_eq_mul]
    congr 1
    exact LinearMap.trace_smulRight (fderiv ℝ ζ z : Euclid P →ₗ[ℝ] ℝ) (g z)
  -- Step 3: integrability with respect to Lebesgue measure
  have hdivg : Continuous fun z =>
      LinearMap.trace ℝ (Euclid P) (fderiv ℝ g z : Euclid P →ₗ[ℝ] Euclid P) :=
    ((LinearMap.trace ℝ (Euclid P)).comp
      (ContinuousLinearMap.coeLM ℝ)).continuous_of_finiteDimensional.comp
      (hg.continuous_fderiv one_ne_zero)
  have hI1 : Integrable (fun z =>
      ζ z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ g z : Euclid P →ₗ[ℝ] Euclid P)) :=
    (hζ.continuous.mul hdivg).integrable_of_hasCompactSupport hζc.mul_right
  have hI2 : Integrable (fun z => fderiv ℝ ζ z (g z)) :=
    ((hζ.continuous_fderiv one_ne_zero).clm_apply hg.continuous).integrable_of_hasCompactSupport
      ((hζc.fderiv ℝ).mono fun z hz h0 => hz (by simp [h0]))
  have hI3 : Integrable (fun z => ‖fderiv ℝ ζ z‖) :=
    (hζ.continuous_fderiv one_ne_zero).norm.integrable_of_hasCompactSupport (hζc.fderiv ℝ).norm
  -- Step 4: rewriting the left side
  have hkey : ∫ z, F.indicator ζ z *
      LinearMap.trace ℝ (Euclid P) (fderiv ℝ g z : Euclid P →ₗ[ℝ] Euclid P) =
      -∫ z, inner ℝ (ζ z • g z) (ν z) ∂μ - ∫ z in F, fderiv ℝ ζ z (g z) := by
    have h1 : ∫ z, F.indicator ζ z *
        LinearMap.trace ℝ (Euclid P) (fderiv ℝ g z : Euclid P →ₗ[ℝ] Euclid P) =
        ∫ z in F, ζ z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ g z : Euclid P →ₗ[ℝ] Euclid P) := by
      rw [← integral_indicator hF]
      congr 1
      ext z
      by_cases hz : z ∈ F <;> simp [hz]
    have h2 := hGGφ
    simp only [hdiv] at h2
    rw [integral_add hI1.integrableOn hI2.integrableOn] at h2
    rw [h1]
    linarith
  -- Step 5: `ζ` is `μ`-integrable
  have hζμ : Integrable ζ μ := by
    have : IsFiniteMeasure (μ.restrict (tsupport ζ)) := isFiniteMeasure_restrict.2 (hμK _ hζc hζD)
    exact (integrableOn_iff_integrable_of_support_subset (subset_tsupport ζ)).1
      (hζ.continuous.integrable_of_hasCompactSupport hζc)
  -- Step 6: pointwise bounds
  have hb1 : ∀ z, ‖inner ℝ (ζ z • g z) (ν z)‖ ≤ ζ z := by
    intro z
    calc ‖inner ℝ (ζ z • g z) (ν z)‖ ≤ ‖ζ z • g z‖ * ‖ν z‖ := norm_inner_le_norm _ _
      _ = ζ z * ‖g z‖ := by rw [hν1, mul_one, norm_smul, Real.norm_of_nonneg (hζ0 z)]
      _ ≤ ζ z * 1 := mul_le_mul_of_nonneg_left (hg1 z) (hζ0 z)
      _ = ζ z := mul_one _
  have hb2 : ∀ z, ‖fderiv ℝ ζ z (g z)‖ ≤ ‖fderiv ℝ ζ z‖ := fun z =>
    ((fderiv ℝ ζ z).le_opNorm (g z)).trans (mul_le_of_le_one_right (norm_nonneg _) (hg1 z))
  -- Step 7: conclusion
  have hA : |∫ z, inner ℝ (ζ z • g z) (ν z) ∂μ| ≤ ∫ z, ζ z ∂μ :=
    norm_integral_le_of_norm_le hζμ (Eventually.of_forall hb1)
  have hB : |∫ z in F, fderiv ℝ ζ z (g z)| ≤ ∫ z in F, ‖fderiv ℝ ζ z‖ :=
    norm_integral_le_of_norm_le hI3.integrableOn (Eventually.of_forall hb2)
  rw [hkey, show ∀ a b : ℝ, -a - b = -(a + b) from fun a b => by ring, abs_neg]
  exact (abs_add_le _ _).trans (add_le_add hA hB)
/-- Integer median of an integer-valued function of bounded variation on the open unit cube
(the BV facts used in Simon 6.5.1, (26)–(33)): the Poincaré inequality, the bound on the median
and the boundary estimate.  The proof works with translations: for a smooth `ψ` supported in an
open `S` whose segments `S + [0, 1] h` stay in the cube, the field `(∫₀¹ ψ(· - τh) dτ) h` is
admissible, which bounds `∫ (u(x + h) - u(x)) ψ(x) dx`; a duality argument (smooth cut-offs and
inner regularity) turns this into an `L¹` bound for translation differences.  Integrating over
`h` gives the Poincaré inequality, the least integer `β` with `|{u ≤ β}| ≥ 1/2` is a median, and
difference quotients of `G` together with slab estimates near the faces give the boundary bound. -/
theorem Submission.dtc_bc_tc_cl_dfm_cube_bv_median : ∀ m : ℕ, ∃ c : ℝ, 0 < c ∧ ∀ (u : Euclid (m + 1) → ℝ) (V : ℝ), (∀ y, ∃ z : ℤ, u y = z) → IntegrableOn u {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ y, ‖g y‖ ≤ 1) → ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, u y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) ≤ V) → ∃ β : ℤ, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u y - β| ≤ c * V ∧ |(β : ℝ)| ≤ 2 * ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u y| ∧ ∀ G : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) G → (∀ y, ‖G y‖ ≤ 1) → |∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, (u y - β) * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G y)| ≤ c * V := by
  intro m
  /- Step 1: duality.  If `|∫ f ψ| ≤ B` for all smooth `ψ` with compact support in the open set
  `S` and `|ψ| ≤ 1`, then `∫_S |f| ≤ 2 B`: smooth cut-offs give `|∫_K f| ≤ B` for compact
  `K ⊆ S`, inner regularity extends this to measurable subsets, and we split `S` by the sign of
  `f`. -/
  have hdual : ∀ (f : Euclid (m + 1) → ℝ) (S : Set (Euclid (m + 1))) (B : ℝ), Integrable f →
      Measurable f → IsOpen S → volume S ≠ ⊤ →
      (∀ ψ : Euclid (m + 1) → ℝ, ContDiff ℝ (⊤ : ℕ∞) ψ → HasCompactSupport ψ → tsupport ψ ⊆ S →
        (∀ x, |ψ x| ≤ 1) → |∫ x, f x * ψ x| ≤ B) → ∫ x in S, |f x| ≤ 2 * B := by
    intro f S B hf hfm hSo hSfin hB
    have H1 : ∀ K, IsCompact K → K ⊆ S → |∫ x in K, f x| ≤ B := by
      intro K hK hKS
      obtain ⟨δ, hδ, hδS⟩ := hK.exists_cthickening_subset_open hSo hKS
      have hr : ∀ k : ℕ, 0 < δ / (k + 2) := fun k => by positivity
      have hrδ : ∀ k : ℕ, δ / (k + 2) ≤ δ := fun k =>
        div_le_self hδ.le (by linarith only [(k.cast_nonneg : (0:ℝ) ≤ k)])
      choose ψ hψsm hψr hψs hψ1 using fun k : ℕ =>
        exists_contDiff_support_eq_eq_one_iff (n := ⊤)
          (isOpen_thickening : IsOpen (thickening (δ / (k + 2)) K))
          hK.isClosed (self_subset_thickening (hr k) K)
      have htsupp : ∀ k, tsupport (ψ k) ⊆ cthickening (δ / (k + 2)) K := fun k => by
        rw [tsupport, hψs k]; exact closure_thickening_subset_cthickening _ _
      have hψabs : ∀ k x, |ψ k x| ≤ 1 := fun k x => by
        have := hψr k (mem_range_self x)
        rw [abs_le]; exact ⟨by linarith only [this.1], this.2⟩
      have hbd : ∀ k, |∫ x, f x * ψ k x| ≤ B := fun k => hB (ψ k) (hψsm k)
          ((hK.cthickening).of_isClosed_subset (isClosed_tsupport _) (htsupp k))
          ((htsupp k).trans ((cthickening_mono (hrδ k) K).trans hδS)) (hψabs k)
      have hlim : Tendsto (fun k => ∫ x, f x * ψ k x) atTop (𝓝 (∫ x, K.indicator f x)) := by
        refine tendsto_integral_of_dominated_convergence (fun x => |f x|)
          (fun k => hf.aestronglyMeasurable.mul (hψsm k).continuous.aestronglyMeasurable) hf.abs
          (fun k => Filter.Eventually.of_forall fun x => ?_) (Filter.Eventually.of_forall fun x => ?_)
        · rw [Real.norm_eq_abs, abs_mul]
          exact mul_le_of_le_one_right (abs_nonneg _) (hψabs k x)
        · by_cases hx : x ∈ K
          · rw [indicator_of_mem hx]
            have : ∀ k, ψ k x = 1 := fun k => (hψ1 k x).1 hx
            simp only [this, mul_one, tendsto_const_nhds]
          · rw [indicator_of_notMem hx]
            obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hK.isClosed.isOpen_compl x hx
            have hev : ∀ᶠ k : ℕ in atTop, ψ k x = 0 := by
              obtain ⟨k₀, hk₀⟩ := exists_nat_gt (δ / ε)
              filter_upwards [Filter.eventually_ge_atTop k₀] with k hk
              have hxt : x ∉ thickening (δ / (k + 2)) K := by
                intro hxt
                obtain ⟨y, hyK, hxy⟩ := mem_thickening_iff.1 hxt
                have hk2 : (k₀:ℝ) ≤ k := by exact_mod_cast hk
                have hk' : δ < ε * ((k:ℝ) + 2) := by
                  rw [div_lt_iff₀ hε] at hk₀
                  have := mul_le_mul_of_nonneg_right hk2 hε.le
                  linarith only [hk₀, this, hε]
                have : δ / (k + 2) < ε := by
                  rw [div_lt_iff₀ (by positivity)]; linarith only [hk']
                exact hball (mem_ball.2 (by rw [dist_comm]; linarith only [hxy, this])) hyK
              rw [← hψs k] at hxt
              exact notMem_support.1 hxt
            exact tendsto_const_nhds.congr' (by
              filter_upwards [hev] with k hk; rw [hk, mul_zero])
      rw [integral_indicator hK.isClosed.measurableSet] at hlim
      exact le_of_tendsto' ((continuous_abs.tendsto _).comp hlim) hbd
    have H2 : ∀ T, MeasurableSet T → T ⊆ S → |∫ x in T, f x| ≤ B := by
      intro T hT hTS
      have hTfin : volume T ≠ ⊤ := ne_top_of_le_ne_top hSfin (measure_mono hTS)
      have : ∀ j : ℕ, ∃ K ⊆ T, IsCompact K ∧ volume T < volume K + ((j + 1 : ℕ) : ℝ≥0∞)⁻¹ :=
        fun j => hT.exists_isCompact_lt_add hTfin
          (ENNReal.inv_ne_zero.2 (ENNReal.natCast_ne_top _))
      choose K hKT hKc hKlt using this
      have hdiff : Tendsto (fun j => volume (T \ K j)) atTop (𝓝 0) := by
        refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds
          (ENNReal.tendsto_inv_nat_nhds_zero.comp (tendsto_add_atTop_nat 1)) (fun _ => bot_le)
          (fun j => ?_)
        rw [Function.comp_apply, measure_sdiff (hKT j)
          (hKc j).isClosed.measurableSet.nullMeasurableSet
          (ne_top_of_le_ne_top hTfin (measure_mono (hKT j)))]
        exact tsub_le_iff_left.2 (hKlt j).le
      have hconv := hf.tendsto_setIntegral_nhds_zero hdiff
      have hle : ∀ j, |∫ x in T, f x| ≤ B + |∫ x in T \ K j, f x| := fun j => by
        rw [← union_sdiff_cancel (hKT j), setIntegral_union disjoint_sdiff_right
          (hT.diff (hKc j).isClosed.measurableSet) hf.integrableOn hf.integrableOn,
          union_sdiff_cancel (hKT j)]
        have := H1 (K j) (hKc j) ((hKT j).trans hTS)
        exact (abs_add_le _ _).trans (by linarith only [this])
      have hconv' : Tendsto (fun j => B + |∫ x in T \ K j, f x|) atTop (𝓝 (B + |0|)) :=
        tendsto_const_nhds.add ((continuous_abs.tendsto 0).comp hconv)
      rw [abs_zero, add_zero] at hconv'
      exact ge_of_tendsto' hconv' hle
    have hP : MeasurableSet {x | 0 ≤ f x} := measurableSet_le measurable_const hfm
    have hSm := hSo.measurableSet
    have e : ∫ x in S, |f x| =
        (∫ x in S ∩ {x | 0 ≤ f x}, f x) - ∫ x in S \ {x | 0 ≤ f x}, f x := by
      rw [← integral_inter_add_sdiff hP hf.abs.integrableOn, sub_eq_add_neg, ← integral_neg]
      congr 1
      · exact setIntegral_congr_fun (hSm.inter hP) (fun x hx => abs_of_nonneg hx.2)
      · exact setIntegral_congr_fun (hSm.diff hP) (fun x hx => abs_of_neg (not_le.1 hx.2))
    rw [e]
    have h1 := H2 _ (hSm.inter hP) inter_subset_left
    have h2 := H2 _ (hSm.diff hP) sdiff_subset
    linarith only [h1, h2, le_abs_self (∫ x in S ∩ {x | 0 ≤ f x}, f x),
      neg_abs_le (∫ x in S \ {x | 0 ≤ f x}, f x)]
  /- Step 2: the segment average `Ψ z = ∫₀¹ ψ (z - τ h) dτ` of a smooth compactly supported `ψ`
  is smooth, and its derivative in the direction `h` is `ψ z - ψ (z - h)`. -/
  have hΨd : ∀ (h : Euclid (m + 1)) (F : Type) [NormedAddCommGroup F] [NormedSpace ℝ F]
      [CompleteSpace F] (ψ : Euclid (m + 1) → F), ContDiff ℝ (⊤ : ℕ∞) ψ → HasCompactSupport ψ →
      ∀ z, HasFDerivAt (fun z => ∫ τ in Ioc (0:ℝ) 1, ψ (z - τ • h))
        (∫ τ in Ioc (0:ℝ) 1, fderiv ℝ ψ (z - τ • h)) z := by
    intro h F _ _ _ ψ hψ hψc z
    have hψ1 : ContDiff ℝ 1 ψ := hψ.of_le (by exact_mod_cast le_top)
    have hdc : Continuous (fderiv ℝ ψ) := hψ1.continuous_fderiv one_ne_zero
    obtain ⟨C, hC⟩ := hdc.bounded_above_of_compact_support (hψc.fderiv ℝ)
    have hsc : Continuous fun τ : ℝ => τ • h := continuous_id.smul continuous_const
    have hcont : ∀ x : Euclid (m + 1), Continuous fun τ : ℝ => ψ (x - τ • h) := fun x =>
      hψ.continuous.comp (continuous_const.sub hsc)
    refine hasFDerivAt_integral_of_dominated_of_fderiv_le (𝕜 := ℝ)
      (μ := volume.restrict (Ioc (0:ℝ) 1)) (F := fun x τ => ψ (x - τ • h))
      (F' := fun x τ => fderiv ℝ ψ (x - τ • h)) (bound := fun _ => C) (s := univ)
      Filter.univ_mem ?_ ?_ ?_ ?_ ?_ ?_
    · exact Filter.Eventually.of_forall fun x => (hcont x).aestronglyMeasurable
    · exact (hcont z).integrableOn_Icc.mono_set Ioc_subset_Icc_self
    · exact ((hdc.comp (continuous_const.sub hsc)).stronglyMeasurable
        (h := secondCountableTopologyEither_of_left ℝ _)).aestronglyMeasurable
    · exact Filter.Eventually.of_forall fun τ x _ => hC _
    · exact integrableOn_const (by simp)
    · refine Filter.Eventually.of_forall fun τ x _ => ?_
      have h1 : HasFDerivAt ψ (fderiv ℝ ψ (x - τ • h)) (x - τ • h) :=
        (hψ1.differentiable one_ne_zero _).hasFDerivAt
      have h2 := h1.comp x ((hasFDerivAt_id x).sub_const (τ • h))
      rwa [ContinuousLinearMap.comp_id] at h2
  have hΨs : ∀ (h : Euclid (m + 1)) (k : ℕ) (F : Type) [NormedAddCommGroup F] [NormedSpace ℝ F]
      [CompleteSpace F] (ψ : Euclid (m + 1) → F), ContDiff ℝ (⊤ : ℕ∞) ψ → HasCompactSupport ψ →
      ContDiff ℝ k (fun z => ∫ τ in Ioc (0:ℝ) 1, ψ (z - τ • h)) := by
    intro h k
    induction k with
    | zero =>
      intro F _ _ _ ψ hψ hψc
      exact contDiff_zero.2 (continuous_iff_continuousAt.2 fun z =>
        (hΨd h F ψ hψ hψc z).continuousAt)
    | succ k ih =>
      intro F _ _ _ ψ hψ hψc
      have hfd : fderiv ℝ (fun z => ∫ τ in Ioc (0:ℝ) 1, ψ (z - τ • h)) =
          fun z => ∫ τ in Ioc (0:ℝ) 1, fderiv ℝ ψ (z - τ • h) :=
        funext fun z => (hΨd h F ψ hψ hψc z).fderiv
      refine contDiff_succ_iff_fderiv.2 ⟨fun z => (hΨd h F ψ hψ hψc z).differentiableAt,
        fun h => absurd h (WithTop.natCast_ne_top k), ?_⟩
      rw [hfd]
      exact ih (Euclid (m + 1) →L[ℝ] F) (fderiv ℝ ψ) (contDiff_infty_iff_fderiv.1 hψ).2
        (hψc.fderiv ℝ)
  have hΨh : ∀ (h : Euclid (m + 1)) (ψ : Euclid (m + 1) → ℝ), ContDiff ℝ (⊤ : ℕ∞) ψ →
      ∀ z, (∫ τ in Ioc (0:ℝ) 1, fderiv ℝ ψ (z - τ • h)) h = ψ z - ψ (z - h) := by
    intro h ψ hψ z
    have hψ1 : ContDiff ℝ 1 ψ := hψ.of_le (by exact_mod_cast le_top)
    have hdc : Continuous (fderiv ℝ ψ) := hψ1.continuous_fderiv one_ne_zero
    have hLc : Continuous fun τ : ℝ => fderiv ℝ ψ (z - τ • h) :=
      hdc.comp (continuous_const.sub (continuous_id.smul continuous_const))
    rw [ContinuousLinearMap.integral_apply (hLc.integrableOn_Icc.mono_set Ioc_subset_Icc_self),
      ← intervalIntegral.integral_of_le zero_le_one]
    have hderiv : ∀ τ ∈ uIcc (0:ℝ) 1, HasDerivAt (fun τ : ℝ => ψ (z - τ • h))
        (-(fderiv ℝ ψ (z - τ • h) h)) τ := by
      intro τ _
      have h1 : HasFDerivAt ψ (fderiv ℝ ψ (z - τ • h)) (z - τ • h) :=
        (hψ1.differentiable one_ne_zero _).hasFDerivAt
      have h2 : HasDerivAt (fun τ : ℝ => z - τ • h) (-h) τ := by
        have := ((hasDerivAt_id τ).smul_const h).const_sub z
        rwa [one_smul] at this
      have := h1.comp_hasDerivAt τ h2
      rwa [map_neg] at this
    have hint : IntervalIntegrable (fun τ : ℝ => -(fderiv ℝ ψ (z - τ • h) h)) volume 0 1 :=
      (((ContinuousLinearMap.apply ℝ ℝ h).continuous.comp hLc).neg).intervalIntegrable 0 1
    have := intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv hint
    rw [intervalIntegral.integral_neg, one_smul, zero_smul, sub_zero] at this
    linarith only [this]
  /- Step 3: the constants: `R` bounds the diameter of the cube, `CP` is the Poincaré constant. -/
  obtain ⟨R, hR_def⟩ : ∃ R : ℝ, R = m + 1 := ⟨_, rfl⟩
  have hR1 : 1 ≤ R := by rw [hR_def]; exact le_add_of_nonneg_left (Nat.cast_nonneg m)
  have hR : 0 < R := lt_of_lt_of_le one_pos hR1
  obtain ⟨CP, hCP_def⟩ : ∃ CP : ℝ,
      CP = 4 * R * (volume (closedBall (0 : Euclid (m + 1)) R)).toReal := ⟨_, rfl⟩
  have hCP : 0 ≤ CP := by rw [hCP_def]; positivity
  refine ⟨CP + (m + 1) * (10 + 4 * CP) + 1, by positivity, ?_⟩
  intro u V hint huQ hV
  set Q := {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} with hQ_def
  /- Step 4: the cube, `V ≥ 0`, and a measurable version `ub` of `u 1_Q`. -/
  have hQo : IsOpen Q := by
    have : Q = ⋂ i, {y : Euclid (m + 1) | 0 < y i ∧ y i < 1} := by
      ext y; simp only [hQ_def, mem_ofPred_eq, mem_iInter]
    rw [this]
    refine isOpen_iInter_of_finite fun i => ?_
    have hc : Continuous (fun y : Euclid (m + 1) => y i) := (EuclideanSpace.proj i).continuous
    exact (isOpen_lt continuous_const hc).inter (isOpen_lt hc continuous_const)
  have hQm : MeasurableSet Q := hQo.measurableSet
  have hQvol : volume Q = 1 := by
    have : Q = WithLp.ofLp ⁻¹' (Set.univ.pi fun _ => Ioo (0:ℝ) 1) := by
      ext y; simp only [hQ_def, mem_ofPred_eq, mem_preimage, mem_univ_pi, mem_Ioo]
    rw [this, (PiLp.volume_preserving_ofLp (Fin (m + 1))).measure_preimage
      (MeasurableSet.univ_pi fun _ => measurableSet_Ioo).nullMeasurableSet, Real.volume_pi_Ioo]
    simp
  have hQfin : volume Q ≠ ⊤ := by rw [hQvol]; exact ENNReal.one_ne_top
  have hV0 : 0 ≤ V := by
    have := hV (fun _ => 0) contDiff_const HasCompactSupport.zero (by simp) (by simp)
    simpa using this
  obtain ⟨ub, hub_meas, hub_int, hub_zero, hub_ae⟩ : ∃ ub : Euclid (m + 1) → ℝ, Measurable ub ∧
      Integrable ub ∧ (∀ y ∉ Q, ub y = 0) ∧ ∀ᵐ y ∂(volume.restrict Q), ub y = u y := by
    refine ⟨Q.indicator (huQ.aestronglyMeasurable.mk u),
      huQ.aestronglyMeasurable.stronglyMeasurable_mk.measurable.indicator hQm, ?_,
      fun y hy => indicator_of_notMem hy _, ?_⟩
    · rw [integrable_indicator_iff hQm]
      exact huQ.congr huQ.aestronglyMeasurable.ae_eq_mk
    · filter_upwards [huQ.aestronglyMeasurable.ae_eq_mk, ae_restrict_mem hQm] with y hy hyQ
      rw [indicator_of_mem hyQ, ← hy]
  /- Step 5: the weak translation estimate.  If `S` is open, `S + [0, 1] h ⊆ Q`, and every line
  parallel to `h` meets `S` in parameter length `≤ lam`, then the field
  `g = (lam ‖h‖)⁻¹ Ψ h` is admissible and `div g = (lam ‖h‖)⁻¹ (ψ - ψ (· - h))`. -/
  have hweak : ∀ (S : Set (Euclid (m + 1))) (h : Euclid (m + 1)) (lam : ℝ), IsOpen S →
      (∀ x ∈ S, ∀ τ ∈ Icc (0:ℝ) 1, x + τ • h ∈ Q) → 0 < lam → h ≠ 0 →
      (∀ z, volume ({τ : ℝ | z - τ • h ∈ S} ∩ Ioc (0:ℝ) 1) ≤ ENNReal.ofReal lam) →
      ∀ ψ : Euclid (m + 1) → ℝ, ContDiff ℝ (⊤ : ℕ∞) ψ → HasCompactSupport ψ → tsupport ψ ⊆ S →
      (∀ x, |ψ x| ≤ 1) → -∫ x, (ub (x + h) - ub x) * ψ x ≤ lam * ‖h‖ * V := by
    intro S h lam hSo hseg hlam hh0 hmult ψ hψ hψc hψS hψ1
    have hA : 0 < lam * ‖h‖ := mul_pos hlam (norm_pos_iff.2 hh0)
    obtain ⟨Ψ, hΨ_def⟩ : ∃ Ψ : Euclid (m + 1) → ℝ,
        Ψ = fun z => ∫ τ in Ioc (0:ℝ) 1, ψ (z - τ • h) := ⟨_, rfl⟩
    obtain ⟨g, hg_def⟩ : ∃ g : Euclid (m + 1) → Euclid (m + 1),
        g = fun z => ((lam * ‖h‖)⁻¹ * Ψ z) • h := ⟨_, rfl⟩
    have hΨsm : ContDiff ℝ (⊤ : ℕ∞) Ψ := by
      rw [hΨ_def]; exact contDiff_infty.2 fun k => hΨs h k ℝ ψ hψ hψc
    have hgsm : ContDiff ℝ (⊤ : ℕ∞) g := by
      rw [hg_def]; exact (contDiff_const.mul hΨsm).smul contDiff_const
    -- `g` is supported in the compact set `spt ψ + [0, 1] h ⊆ Q`
    obtain ⟨K, hK_def⟩ : ∃ K : Set (Euclid (m + 1)),
        K = (fun p : Euclid (m + 1) × ℝ => p.1 + p.2 • h) '' (tsupport ψ ×ˢ Icc (0:ℝ) 1) :=
      ⟨_, rfl⟩
    have hKc : IsCompact K := by
      rw [hK_def]
      exact (hψc.isCompact.prod isCompact_Icc).image
        (continuous_fst.add (continuous_snd.smul continuous_const))
    have hKQ : K ⊆ Q := by
      rw [hK_def]
      rintro _ ⟨⟨x, τ⟩, ⟨hx, hτ⟩, rfl⟩
      exact hseg x (hψS hx) τ hτ
    have hgK : ∀ z ∉ K, g z = 0 := by
      intro z hz
      have : Ψ z = 0 := by
        rw [hΨ_def]
        refine setIntegral_eq_zero_of_forall_eq_zero fun τ hτ => ?_
        by_contra hne
        refine hz (hK_def ▸ ⟨⟨z - τ • h, τ⟩, ⟨subset_tsupport _ hne, Ioc_subset_Icc_self hτ⟩, ?_⟩)
        exact sub_add_cancel z (τ • h)
      rw [hg_def]; simp only [this, mul_zero, zero_smul]
    have hgc : HasCompactSupport g := HasCompactSupport.intro hKc hgK
    have hgQ : tsupport g ⊆ Q := (closure_minimal (fun z hz => by
      by_contra hzK; exact hz (hgK z hzK)) hKc.isClosed).trans hKQ
    -- `|Ψ| ≤ lam`, hence `‖g‖ ≤ 1`
    have hΨb : ∀ z, |Ψ z| ≤ lam := by
      intro z
      have hmeas : MeasurableSet {τ : ℝ | z - τ • h ∈ S} :=
        (hSo.preimage (continuous_const.sub (continuous_id.smul continuous_const))).measurableSet
      rw [hΨ_def]
      calc |∫ τ in Ioc (0:ℝ) 1, ψ (z - τ • h)| = ‖∫ τ in Ioc (0:ℝ) 1, ψ (z - τ • h)‖ := rfl
        _ ≤ ∫ τ in Ioc (0:ℝ) 1, ‖ψ (z - τ • h)‖ := norm_integral_le_integral_norm _
        _ ≤ ∫ τ in Ioc (0:ℝ) 1, {τ : ℝ | z - τ • h ∈ S}.indicator 1 τ := by
          refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun τ => norm_nonneg _)
            ((integrable_indicator_iff hmeas).2 (integrable_const (1:ℝ)).integrableOn) ?_
          refine Filter.Eventually.of_forall fun τ => ?_
          show ‖ψ (z - τ • h)‖ ≤ {τ : ℝ | z - τ • h ∈ S}.indicator 1 τ
          by_cases hτ : z - τ • h ∈ S
          · rw [indicator_of_mem (show τ ∈ {τ : ℝ | z - τ • h ∈ S} from hτ), Pi.one_apply]
            exact hψ1 (z - τ • h)
          · rw [indicator_of_notMem (show τ ∉ {τ : ℝ | z - τ • h ∈ S} from hτ),
              image_eq_zero_of_notMem_tsupport (fun h' => hτ (hψS h')), norm_zero]
        _ = (volume.restrict (Ioc (0:ℝ) 1)).real {τ : ℝ | z - τ • h ∈ S} :=
          integral_indicator_one hmeas
        _ ≤ lam := by
          rw [Measure.real, Measure.restrict_apply hmeas]
          exact ENNReal.toReal_le_of_le_ofReal hlam.le (hmult z)
    have hgb : ∀ z, ‖g z‖ ≤ 1 := by
      intro z
      rw [hg_def, norm_smul, norm_mul, norm_inv, Real.norm_of_nonneg hA.le, Real.norm_eq_abs]
      calc (lam * ‖h‖)⁻¹ * |Ψ z| * ‖h‖ ≤ (lam * ‖h‖)⁻¹ * lam * ‖h‖ :=
            mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hΨb z) (inv_nonneg.2 hA.le))
              (norm_nonneg h)
        _ = 1 := by rw [mul_assoc, inv_mul_cancel₀ hA.ne']
    -- `div g = (lam ‖h‖)⁻¹ (ψ - ψ (· - h))`
    have htr : ∀ z, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g z) =
        (lam * ‖h‖)⁻¹ * (ψ z - ψ (z - h)) := by
      intro z
      have hd : HasFDerivAt g (((lam * ‖h‖)⁻¹ • ∫ τ in Ioc (0:ℝ) 1,
          fderiv ℝ ψ (z - τ • h)).smulRight h) z := by
        rw [hg_def, hΨ_def]
        exact ((hΨd h ℝ ψ hψ hψc z).const_mul (lam * ‖h‖)⁻¹).smul_const h
      rw [hd.fderiv]
      refine (LinearMap.trace_smulRight (((lam * ‖h‖)⁻¹ • ∫ τ in Ioc (0:ℝ) 1,
        fderiv ℝ ψ (z - τ • h) : Euclid (m + 1) →L[ℝ] ℝ) : Euclid (m + 1) →ₗ[ℝ] ℝ) h).trans ?_
      rw [ContinuousLinearMap.coe_coe, smul_apply, hΨh h ψ hψ z, smul_eq_mul]
    -- the hypothesis applied to `g`
    have hψb : ∀ x, ‖ψ x‖ ≤ 1 := hψ1
    have hint1 : Integrable fun x => ub x * ψ x :=
      hub_int.mul_bdd hψ.continuous.aestronglyMeasurable (Filter.Eventually.of_forall hψb)
    have hint2 : Integrable fun x => ub x * ψ (x - h) :=
      hub_int.mul_bdd (hψ.continuous.comp (continuous_id.sub continuous_const)).aestronglyMeasurable
        (Filter.Eventually.of_forall fun x => hψb _)
    have hint3 : Integrable fun x => ub (x + h) * ψ x :=
      (hub_int.comp_add_right h).mul_bdd hψ.continuous.aestronglyMeasurable
        (Filter.Eventually.of_forall hψb)
    have key := hV g hgsm hgc hgQ hgb
    have e1 : ∫ y in Q, u y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) =
        (lam * ‖h‖)⁻¹ * -∫ x, (ub (x + h) - ub x) * ψ x := by
      calc ∫ y in Q, u y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y)
          = ∫ y in Q, ub y * ((lam * ‖h‖)⁻¹ * (ψ y - ψ (y - h))) := by
            refine integral_congr_ae ?_
            filter_upwards [hub_ae] with y hy
            rw [htr y, hy]
        _ = ∫ y, ub y * ((lam * ‖h‖)⁻¹ * (ψ y - ψ (y - h))) :=
            setIntegral_eq_integral_of_forall_compl_eq_zero fun y hy => by
              rw [hub_zero y hy, zero_mul]
        _ = (lam * ‖h‖)⁻¹ * ((∫ y, ub y * ψ y) - ∫ y, ub y * ψ (y - h)) := by
            rw [← integral_sub hint1 hint2, ← integral_const_mul]
            congr 1; funext y; ring
        _ = (lam * ‖h‖)⁻¹ * ((∫ y, ub y * ψ y) - ∫ x, ub (x + h) * ψ x) := by
            congr 2
            rw [← integral_add_right_eq_self (fun y => ub y * ψ (y - h)) h]
            simp only [add_sub_cancel_right]
        _ = (lam * ‖h‖)⁻¹ * -∫ x, (ub (x + h) - ub x) * ψ x := by
            rw [← integral_sub hint1 hint3, ← integral_neg]
            congr 2; funext x; ring
    rw [e1] at key
    have := mul_le_mul_of_nonneg_left key hA.le
    rwa [← mul_assoc, mul_inv_cancel₀ hA.ne', one_mul] at this
  /- Step 6: the `L¹` translation estimate `∫_S |ub (x + h) - ub x| ≤ 2 lam ‖h‖ V`. -/
  have hGEN : ∀ (S : Set (Euclid (m + 1))) (h : Euclid (m + 1)) (lam : ℝ), IsOpen S →
      (∀ x ∈ S, ∀ τ ∈ Icc (0:ℝ) 1, x + τ • h ∈ Q) → 0 < lam →
      (∀ z, volume ({τ : ℝ | z - τ • h ∈ S} ∩ Ioc (0:ℝ) 1) ≤ ENNReal.ofReal lam) →
      ∫ x in S, |ub (x + h) - ub x| ≤ 2 * (lam * ‖h‖ * V) := by
    intro S h lam hSo hseg hlam hmult
    by_cases hh : h = 0
    · subst hh; simp
    have hSQ : S ⊆ Q := fun x hx => by
      have := hseg x hx 0 ⟨le_rfl, zero_le_one⟩; rwa [zero_smul, add_zero] at this
    have hSfin : volume S ≠ ⊤ := ne_top_of_le_ne_top hQfin (measure_mono hSQ)
    refine hdual (fun x => ub (x + h) - ub x) S (lam * ‖h‖ * V)
      ((hub_int.comp_add_right h).sub hub_int)
      ((hub_meas.comp (measurable_add_const h)).sub hub_meas) hSo hSfin ?_
    intro ψ hψ hψc hψS hψ1
    have h1 := hweak S h lam hSo hseg hlam hh hmult ψ hψ hψc hψS hψ1
    have h2 := hweak S h lam hSo hseg hlam hh hmult (-ψ) hψ.neg hψc.neg
      (by rwa [tsupport_neg]) (fun x => by rw [Pi.neg_apply, abs_neg]; exact hψ1 x)
    have e2 : ∫ x, (ub (x + h) - ub x) * (-ψ) x = -∫ x, (ub (x + h) - ub x) * ψ x := by
      rw [← integral_neg]; congr 1; funext x; rw [Pi.neg_apply]; ring
    rw [e2] at h2
    rw [abs_le]; constructor <;> linarith only [h1, h2]
  clear hweak hdual hΨh hΨs hΨd
  /- Step 7: the Poincaré inequality.  Translating `y = x + h` and swapping the integrals,
  `∫_Q ∫_Q |ub y - ub x| ≤ ∫_{‖h‖ ≤ R} 2 ‖h‖ V dh`. -/
  have hnormle : ∀ v : Euclid (m + 1), (∀ i, |v i| ≤ 1) → ‖v‖ ≤ R := by
    intro v hv
    have h1 : ‖v‖ ^ 2 ≤ R := by
      rw [EuclideanSpace.norm_sq_eq, hR_def]
      calc ∑ i, ‖v i‖ ^ 2 ≤ ∑ _i : Fin (m + 1), (1:ℝ) := Finset.sum_le_sum fun i _ => by
            rw [Real.norm_eq_abs, sq_abs]; exact (sq_le_one_iff_abs_le_one _).2 (hv i)
        _ = m + 1 := by
            rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, mul_one,
              Nat.cast_add, Nat.cast_one]
    exact (sq_le_sq₀ (norm_nonneg v) hR.le).1 (h1.trans (le_self_pow₀ hR1 two_ne_zero))
  have hnorm : ∀ x h : Euclid (m + 1), x ∈ Q → x + h ∈ Q → ‖h‖ ≤ R := fun x h hx hxh =>
    hnormle h fun i => by
      have h1 := hx i; have h2 := hxh i
      rw [PiLp.add_apply] at h2
      rw [abs_le]; constructor <;> linarith only [h1.1, h1.2, h2.1, h2.2]
  have hnormQ : ∀ y ∈ Q, ‖y‖ ≤ R := fun y hy =>
    hnormle y fun i => abs_le.2 ⟨by linarith only [(hy i).1], (hy i).2.le⟩
  have hsegA : ∀ h : Euclid (m + 1), ∀ x ∈ (fun x => x + h) ⁻¹' Q ∩ Q,
      ∀ τ ∈ Icc (0:ℝ) 1, x + τ • h ∈ Q := by
    rintro h x ⟨hxh, hx⟩ τ ⟨hτ0, hτ1⟩ i
    have h1 := hx i; have h2 := hxh i
    rw [PiLp.add_apply] at h2
    rw [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
    rcases le_total 0 (h i) with hhi | hhi
    · have p1 := mul_nonneg hτ0 hhi
      have p2 := mul_nonneg (sub_nonneg.2 hτ1) hhi
      constructor <;> linarith only [h1.1, h1.2, h2.1, h2.2, p1, p2]
    · have p1 := mul_nonneg hτ0 (neg_nonneg.2 hhi)
      have p2 := mul_nonneg (sub_nonneg.2 hτ1) (neg_nonneg.2 hhi)
      constructor <;> linarith only [h1.1, h1.2, h2.1, h2.2, p1, p2]
  have hAo : ∀ h : Euclid (m + 1), IsOpen ((fun x => x + h) ⁻¹' Q ∩ Q) := fun h =>
    (hQo.preimage (continuous_id.add continuous_const)).inter hQo
  have hTR : ∀ h : Euclid (m + 1),
      ∫ x in (fun x => x + h) ⁻¹' Q ∩ Q, |ub (x + h) - ub x| ≤ 2 * (‖h‖ * V) := by
    intro h
    have := hGEN _ h 1 (hAo h) (hsegA h) one_pos (fun z => by
      rw [ENNReal.ofReal_one]
      exact (measure_mono inter_subset_right).trans (by rw [Real.volume_Ioc, sub_zero,
        ENNReal.ofReal_one]))
    rwa [one_mul] at this
  have hJ : ∫⁻ x in Q, ∫⁻ y in Q, ENNReal.ofReal |ub y - ub x| ≤
      ENNReal.ofReal (2 * (R * V)) * volume (closedBall (0 : Euclid (m + 1)) R) := by
    have hΦ : (Function.uncurry fun x h : Euclid (m + 1) =>
          Q.indicator (fun y => ENNReal.ofReal |ub y - ub x|) (h + x)) =
        {p : Euclid (m + 1) × Euclid (m + 1) | p.2 + p.1 ∈ Q}.indicator
          (fun p => ENNReal.ofReal |ub (p.2 + p.1) - ub p.1|) := by
      funext ⟨x, h⟩
      simp only [Function.uncurry_apply_pair, Set.indicator_apply, mem_ofPred_eq]
    have hΦm : Measurable (Function.uncurry fun x h : Euclid (m + 1) =>
        Q.indicator (fun y => ENNReal.ofReal |ub y - ub x|) (h + x)) := by
      rw [hΦ]
      exact (ENNReal.measurable_ofReal.comp (continuous_abs.measurable.comp
        ((hub_meas.comp (measurable_snd.add measurable_fst)).sub
          (hub_meas.comp measurable_fst)))).indicator
        (hQm.preimage (measurable_snd.add measurable_fst))
    calc ∫⁻ x in Q, ∫⁻ y in Q, ENNReal.ofReal |ub y - ub x|
        = ∫⁻ x in Q, ∫⁻ h, Q.indicator (fun y => ENNReal.ofReal |ub y - ub x|) (h + x) := by
          refine lintegral_congr fun x => ?_
          rw [← lintegral_indicator hQm, lintegral_add_right_eq_self]
      _ = ∫⁻ h, ∫⁻ x in Q, Q.indicator (fun y => ENNReal.ofReal |ub y - ub x|) (h + x) :=
          lintegral_lintegral_swap hΦm.aemeasurable
      _ ≤ ∫⁻ h, (closedBall (0 : Euclid (m + 1)) R).indicator
            (fun _ => ENNReal.ofReal (2 * (R * V))) h := by
          refine lintegral_mono fun h => ?_
          have hAm := (hAo h).measurableSet
          have e1 : ∫⁻ x in Q, Q.indicator (fun y => ENNReal.ofReal |ub y - ub x|) (h + x) =
              ∫⁻ x in (fun x => x + h) ⁻¹' Q ∩ Q, ENNReal.ofReal |ub (x + h) - ub x| := by
            rw [← Measure.restrict_restrict (hQm.preimage (measurable_add_const h)),
              ← lintegral_indicator (hQm.preimage (measurable_add_const h))]
            refine lintegral_congr fun x => ?_
            rw [add_comm h x]
            by_cases hx : x + h ∈ Q
            · rw [indicator_of_mem hx, indicator_of_mem (show x ∈ (fun x => x + h) ⁻¹' Q from hx)]
            · rw [indicator_of_notMem hx,
                indicator_of_notMem (show x ∉ (fun x => x + h) ⁻¹' Q from hx)]
          have hint : IntegrableOn (fun x => |ub (x + h) - ub x|) ((fun x => x + h) ⁻¹' Q ∩ Q) :=
            ((hub_int.comp_add_right h).sub hub_int).abs.integrableOn
          rw [e1, ← ofReal_integral_eq_lintegral_ofReal hint
            (Filter.Eventually.of_forall fun x => abs_nonneg _)]
          by_cases hh : h ∈ closedBall (0 : Euclid (m + 1)) R
          · rw [indicator_of_mem hh]
            refine ENNReal.ofReal_le_ofReal ((hTR h).trans ?_)
            have : ‖h‖ ≤ R := by rwa [mem_closedBall, dist_zero_right] at hh
            have := mul_le_mul_of_nonneg_right this hV0
            linarith only [this]
          · rw [indicator_of_notMem hh]
            have hempty : (fun x => x + h) ⁻¹' Q ∩ Q = ∅ := by
              refine Set.eq_empty_of_forall_notMem fun x hx => hh ?_
              rw [mem_closedBall, dist_zero_right]; exact hnorm x h hx.2 hx.1
            rw [hempty, Measure.restrict_empty, integral_zero_measure, ENNReal.ofReal_zero]
      _ = ENNReal.ofReal (2 * (R * V)) * volume (closedBall (0 : Euclid (m + 1)) R) :=
          lintegral_indicator_const measurableSet_closedBall _
  clear hsegA hAo hnormle
  /- Step 8: the integer median `β`: the least integer with `|{ub ≤ β} ∩ Q| ≥ 1/2`. -/
  have hμprob : IsProbabilityMeasure (volume.restrict Q) :=
    isProbabilityMeasure_iff.2 (by rw [Measure.restrict_apply_univ, hQvol])
  obtain ⟨M, hM_def⟩ : ∃ M : ℝ, M = ∫ y in Q, |ub y| := ⟨_, rfl⟩
  have hM0 : 0 ≤ M := hM_def ▸ integral_nonneg fun y => abs_nonneg _
  have hmarkov : ∀ ε : ℝ, ε * (volume.restrict Q).real {y | ε ≤ |ub y|} ≤ M := fun ε =>
    hM_def ▸ mul_meas_ge_le_integral_of_nonneg (Filter.Eventually.of_forall fun y => abs_nonneg _)
      hub_int.integrableOn.abs ε
  have hmeasle : ∀ c : ℝ, MeasurableSet {y | ub y ≤ c} := fun c =>
    measurableSet_le hub_meas measurable_const
  have hmeasge : ∀ c : ℝ, MeasurableSet {y | c ≤ ub y} := fun c =>
    measurableSet_le measurable_const hub_meas
  have hlow : ∀ k : ℤ, 1/2 ≤ (volume.restrict Q).real {y | ub y ≤ k} → -(2 * M) ≤ k := by
    intro k hk
    by_contra hlt
    rw [not_le] at hlt
    have h1 : (volume.restrict Q).real {y | ub y ≤ k} ≤
        (volume.restrict Q).real {y | -(k:ℝ) ≤ |ub y|} :=
      measureReal_mono (fun y (hy : ub y ≤ k) => by
        show -(k:ℝ) ≤ |ub y|; linarith only [hy, neg_abs_le (ub y)])
    have h3 := mul_le_mul_of_nonneg_left (hk.trans h1)
      (by linarith only [hlt, hM0] : (0:ℝ) ≤ -(k:ℝ))
    linarith only [hmarkov (-(k:ℝ)), h3, hlt]
  have hex : ∃ k : ℤ, 1/2 ≤ (volume.restrict Q).real {y | ub y ≤ k} := by
    refine ⟨⌊2 * M⌋ + 1, ?_⟩
    have hk₀ : 2 * M < ((⌊2 * M⌋ + 1 : ℤ) : ℝ) := by
      rw [Int.cast_add, Int.cast_one]; exact Int.lt_floor_add_one _
    have h2 : (volume.restrict Q).real {y | ub y ≤ ((⌊2 * M⌋ + 1 : ℤ) : ℝ)}ᶜ ≤
        (volume.restrict Q).real {y | ((⌊2 * M⌋ + 1 : ℤ) : ℝ) ≤ |ub y|} :=
      measureReal_mono (fun y hy => by
        rw [mem_compl_iff, mem_ofPred_eq, not_le] at hy
        exact hy.le.trans (le_abs_self _))
    have h3 := measureReal_add_measureReal_compl (μ := volume.restrict Q)
      (hmeasle ((⌊2 * M⌋ + 1 : ℤ) : ℝ))
    rw [probReal_univ] at h3
    by_contra h4
    rw [not_le] at h4
    have h5 := mul_le_mul_of_nonneg_left (show 1/2 ≤ (volume.restrict Q).real
      {y | ((⌊2 * M⌋ + 1 : ℤ) : ℝ) ≤ |ub y|} by linarith only [h2, h3, h4])
      (by linarith only [hk₀, hM0] : (0:ℝ) ≤ ((⌊2 * M⌋ + 1 : ℤ) : ℝ))
    linarith only [h5, hmarkov ((⌊2 * M⌋ + 1 : ℤ) : ℝ), hk₀]
  obtain ⟨β, hβP, hβmin⟩ := Int.exists_least_of_bdd ⟨⌊-(2 * M)⌋, fun k hk =>
    Int.cast_le.1 ((Int.floor_le _).trans (hlow k hk))⟩ hex
  have hβge : 1/2 ≤ (volume.restrict Q).real {y | (β:ℝ) ≤ ub y} := by
    have hβ1 : ¬ (1/2 ≤ (volume.restrict Q).real {y | ub y ≤ ((β - 1 : ℤ) : ℝ)}) := fun h => by
      have := hβmin (β - 1) h; omega
    rw [not_le] at hβ1
    have h3 := measureReal_add_measureReal_compl (μ := volume.restrict Q)
      (hmeasle ((β - 1 : ℤ) : ℝ))
    rw [probReal_univ] at h3
    have h4 : (volume.restrict Q).real {y | ub y ≤ ((β - 1 : ℤ) : ℝ)}ᶜ ≤
        (volume.restrict Q).real {y | (β:ℝ) ≤ ub y} := by
      rw [measureReal_def, measureReal_def]
      refine ENNReal.toReal_mono (measure_ne_top _ _) (measure_mono_ae ?_)
      filter_upwards [hub_ae] with y hy
      intro hy'
      obtain ⟨z, hz⟩ := hint y
      rw [mem_compl_iff, mem_ofPred_eq, not_le, hy, hz] at hy'
      show (β:ℝ) ≤ ub y
      rw [hy, hz]
      have : β - 1 < z := by exact_mod_cast hy'
      exact_mod_cast (show β ≤ z by omega)
    linarith only [h3, h4, hβ1]
  have hβabs : |(β:ℝ)| ≤ 2 * M := by
    rcases le_or_gt 0 (β:ℝ) with h0 | h0
    · rw [abs_of_nonneg h0]
      have h2 : (volume.restrict Q).real {y | (β:ℝ) ≤ ub y} ≤
          (volume.restrict Q).real {y | (β:ℝ) ≤ |ub y|} :=
        measureReal_mono fun y (hy : (β:ℝ) ≤ ub y) => hy.trans (le_abs_self _)
      linarith only [mul_le_mul_of_nonneg_left (hβge.trans h2) h0, hmarkov β]
    · rw [abs_of_neg h0]; linarith only [hlow β hβP]
  have hhalf : ∀ s : Set (Euclid (m + 1)), MeasurableSet s → 1/2 ≤ (volume.restrict Q).real s →
      (1/2 : ℝ≥0∞) ≤ volume (s ∩ Q) := by
    intro s hs h
    rw [← Measure.restrict_apply hs, ← ofReal_measureReal (measure_ne_top _ _)]
    calc (1/2 : ℝ≥0∞) = ENNReal.ofReal (1/2) := by
          rw [ENNReal.ofReal_div_of_pos two_pos, ENNReal.ofReal_one, ENNReal.ofReal_ofNat]
      _ ≤ _ := ENNReal.ofReal_le_ofReal h
  have hhalf1 := hhalf _ (hmeasle β) hβP
  have hhalf2 := hhalf _ (hmeasge β) hβge
  -- `|ub x - β| ≤ 2 ∫_Q |ub y - ub x| dy`, since `β` is a median
  have hpt : ∀ x, ENNReal.ofReal |ub x - β| ≤ 2 * ∫⁻ y in Q, ENNReal.ofReal |ub y - ub x| := by
    intro x
    have hhalf' : ∀ a : ℝ≥0∞, a = 2 * (a * (1/2)) := fun a => by
      rw [one_div, mul_comm, mul_assoc, ENNReal.inv_mul_cancel two_ne_zero ENNReal.ofNat_ne_top,
        mul_one]
    have hgm : Measurable fun y => ENNReal.ofReal |ub y - ub x| :=
      ENNReal.measurable_ofReal.comp (continuous_abs.measurable.comp (hub_meas.sub measurable_const))
    have key : ∀ s : Set (Euclid (m + 1)), (1/2 : ℝ≥0∞) ≤ volume (s ∩ Q) →
        (∀ y ∈ s, |ub x - β| ≤ |ub y - ub x|) →
        ENNReal.ofReal |ub x - β| ≤ 2 * ∫⁻ y in Q, ENNReal.ofReal |ub y - ub x| := by
      intro s hs hle
      rw [hhalf' (ENNReal.ofReal |ub x - β|)]
      refine mul_le_mul_right ?_ 2
      calc ENNReal.ofReal |ub x - β| * (1/2) ≤ ENNReal.ofReal |ub x - β| * volume (s ∩ Q) :=
            mul_le_mul_right hs _
        _ = ∫⁻ y in s ∩ Q, ENNReal.ofReal |ub x - β| := (setLIntegral_const _ _).symm
        _ ≤ ∫⁻ y in s ∩ Q, ENNReal.ofReal |ub y - ub x| :=
            setLIntegral_mono hgm fun y hy => ENNReal.ofReal_le_ofReal (hle y hy.1)
        _ ≤ ∫⁻ y in Q, ENNReal.ofReal |ub y - ub x| := lintegral_mono_set inter_subset_right
    rcases le_total (β:ℝ) (ub x) with hx | hx
    · refine key _ hhalf1 fun y (hy : ub y ≤ β) => ?_
      rw [abs_of_nonneg (sub_nonneg.2 hx), abs_sub_comm]
      exact (by linarith only [hy] : ub x - β ≤ ub x - ub y).trans (le_abs_self _)
    · refine key _ hhalf2 fun y (hy : (β:ℝ) ≤ ub y) => ?_
      rw [abs_sub_comm, abs_of_nonneg (sub_nonneg.2 hx)]
      exact (by linarith only [hy] : β - ub x ≤ ub y - ub x).trans (le_abs_self _)
  have hP1 : ∫ y in Q, |ub y - β| ≤ CP * V := by
    have hlin : ∫⁻ x in Q, ENNReal.ofReal |ub x - β| ≤
        2 * (ENNReal.ofReal (2 * (R * V)) * volume (closedBall (0 : Euclid (m + 1)) R)) := by
      calc ∫⁻ x in Q, ENNReal.ofReal |ub x - β|
          ≤ ∫⁻ x in Q, 2 * ∫⁻ y in Q, ENNReal.ofReal |ub y - ub x| := lintegral_mono hpt
        _ = 2 * ∫⁻ x in Q, ∫⁻ y in Q, ENNReal.ofReal |ub y - ub x| :=
            lintegral_const_mul' _ _ ENNReal.ofNat_ne_top
        _ ≤ _ := mul_le_mul_right hJ 2
    rw [integral_eq_lintegral_of_nonneg_ae (f := fun y => |ub y - (β:ℝ)|)
      (Filter.Eventually.of_forall fun x => abs_nonneg _)
      (continuous_abs.measurable.comp (hub_meas.sub measurable_const)).aestronglyMeasurable]
    calc (∫⁻ x in Q, ENNReal.ofReal |ub x - β|).toReal
        ≤ (2 * (ENNReal.ofReal (2 * (R * V)) * volume (closedBall (0 : Euclid (m + 1)) R))).toReal :=
          ENNReal.toReal_mono (ENNReal.mul_ne_top ENNReal.ofNat_ne_top
            (ENNReal.mul_ne_top ENNReal.ofReal_ne_top measure_closedBall_lt_top.ne)) hlin
      _ = CP * V := by
          rw [ENNReal.toReal_mul, ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity),
            ENNReal.toReal_ofNat, hCP_def]; ring
  have hβM : |(β:ℝ)| ≤ 2 * ∫ y in Q, |u y| := by
    have : ∫ y in Q, |u y| = M := by
      rw [hM_def]; exact integral_congr_ae (by filter_upwards [hub_ae] with y hy; rw [hy])
    rw [this]; exact hβabs
  clear hpt hhalf hhalf1 hhalf2 hlow hex hβmin hβge hβP hβabs hmarkov hJ hmeasle hmeasge hμprob
    hM0 hM_def hint
  /- Step 9: slabs `{y ∈ Q | a < y i < a + s}`.  Translating along `e i` compares the integrals
  of `|ub - β|` over two slabs of width `s` up to `2 s V`; averaging over the `N` slabs of width
  `1/N` bounds a boundary slab by `(∫_Q |ub - β| + 2 V) / N`. -/
  have hcoord : ∀ (i j : Fin (m + 1)) (x : Euclid (m + 1)) (t : ℝ),
      (x + t • EuclideanSpace.single i (1:ℝ)) j = if j = i then x j + t else x j := by
    intro i j x t
    by_cases hj : j = i <;> simp [hj]
  have hslabo : ∀ (i : Fin (m + 1)) (a s : ℝ),
      IsOpen {y : Euclid (m + 1) | y ∈ Q ∧ a < y i ∧ y i < a + s} := by
    intro i a s
    have hc : Continuous (fun y : Euclid (m + 1) => y i) := (EuclideanSpace.proj i).continuous
    exact hQo.inter ((isOpen_lt continuous_const hc).inter (isOpen_lt hc continuous_const))
  have hslab : ∀ (i : Fin (m + 1)) (s a a' : ℝ), 0 < s → 0 ≤ a → a + s ≤ 1 → 0 ≤ a' →
      a' + s ≤ 1 →
      ∫ y in {y : Euclid (m + 1) | y ∈ Q ∧ a < y i ∧ y i < a + s}, |ub y - β| ≤
        (∫ y in {y : Euclid (m + 1) | y ∈ Q ∧ a' < y i ∧ y i < a' + s}, |ub y - β|) +
          2 * (s * V) := by
    intro i s a a' hs ha has ha' has'
    rcases eq_or_ne a a' with haa | haa
    · subst haa; linarith only [mul_nonneg hs.le hV0]
    obtain ⟨t, ht_def⟩ : ∃ t : ℝ, t = a' - a := ⟨_, rfl⟩
    have ht : t ≠ 0 := by rw [ht_def]; exact sub_ne_zero.2 (Ne.symm haa)
    obtain ⟨e, he_def⟩ : ∃ e : Euclid (m + 1), e = EuclideanSpace.single i (1:ℝ) := ⟨_, rfl⟩
    have hce : ∀ (j : Fin (m + 1)) (x : Euclid (m + 1)) (r : ℝ),
        (x + r • e) j = if j = i then x j + r else x j := by
      subst he_def; exact fun j x r => hcoord i j x r
    obtain ⟨S, hS_def⟩ : ∃ S : Set (Euclid (m + 1)),
        S = {y : Euclid (m + 1) | y ∈ Q ∧ a < y i ∧ y i < a + s} := ⟨_, rfl⟩
    obtain ⟨S', hS'_def⟩ : ∃ S' : Set (Euclid (m + 1)),
        S' = {y : Euclid (m + 1) | y ∈ Q ∧ a' < y i ∧ y i < a' + s} := ⟨_, rfl⟩
    rw [← hS_def, ← hS'_def]
    have hSo : IsOpen S := hS_def ▸ hslabo i a s
    have hSm : MeasurableSet S := hSo.measurableSet
    have hS'm : MeasurableSet S' := (hS'_def ▸ hslabo i a' s).measurableSet
    have hSfin : volume S ≠ ⊤ := by
      refine ne_top_of_le_ne_top hQfin (measure_mono fun y hy => ?_)
      rw [hS_def] at hy; exact hy.1
    have hnh : ‖t • e‖ = |t| := by
      rw [he_def, norm_smul, PiLp.norm_single, norm_one, mul_one, Real.norm_eq_abs]
    have hmem : ∀ x, x ∈ S ↔ x + t • e ∈ S' := by
      intro x
      rw [hS_def, hS'_def]
      show (x ∈ Q ∧ a < x i ∧ x i < a + s) ↔
        (x + t • e ∈ Q ∧ a' < (x + t • e) i ∧ (x + t • e) i < a' + s)
      rw [hce, ite_eq_left rfl]
      constructor
      · rintro ⟨hxQ, h1, h2⟩
        refine ⟨fun j => ?_, by linarith only [h1, ht_def], by linarith only [h2, ht_def]⟩
        rw [hce]; split_ifs with hj
        · subst hj; constructor <;> linarith only [h1, h2, ht_def, ha', has']
        · exact hxQ j
      · rintro ⟨hxQ, h1, h2⟩
        refine ⟨fun j => ?_, by linarith only [h1, ht_def], by linarith only [h2, ht_def]⟩
        have := hxQ j
        rw [hce] at this
        split_ifs at this with hj
        · subst hj; constructor <;> linarith only [h1, h2, ht_def, ha, has]
        · exact this
    have hgen := hGEN S (t • e) (s / |t|) hSo (by
        rintro x hx τ ⟨hτ0, hτ1⟩ j
        rw [hS_def] at hx
        obtain ⟨hxQ, h1, h2⟩ := hx
        rw [smul_smul, hce]
        split_ifs with hj
        · subst hj
          have e1 : τ * t = τ * a' - τ * a := by rw [ht_def]; ring
          have p1 := mul_nonneg (sub_nonneg.2 hτ1) ha
          have p2 := mul_nonneg hτ0 ha'
          have p3 := mul_nonneg (sub_nonneg.2 hτ1) (by linarith only [has] : (0:ℝ) ≤ 1 - a - s)
          have p4 := mul_nonneg hτ0 (by linarith only [has'] : (0:ℝ) ≤ 1 - a' - s)
          constructor <;> linarith only [h1, h2, e1, p1, p2, p3, p4]
        · exact hxQ j) (div_pos hs (abs_pos.2 ht)) (fun z => by
        have hsub : {τ : ℝ | z - τ • (t • e) ∈ S} ∩ Ioc (0:ℝ) 1 ⊆
            (fun τ => t * τ) ⁻¹' Ioo (z i - a - s) (z i - a) := by
          rintro τ ⟨hτ, -⟩
          rw [mem_ofPred_eq, hS_def] at hτ
          have h1 := hτ.2
          have hzi : (z - τ • (t • e)) i = z i - τ * t := by
            rw [smul_smul, sub_eq_add_neg, ← neg_smul, hce, ite_eq_left rfl, ← sub_eq_add_neg]
          rw [hzi] at h1
          rw [mem_preimage, mem_Ioo, mul_comm]
          exact ⟨by linarith only [h1.2], by linarith only [h1.1]⟩
        refine (measure_mono hsub).trans (le_of_eq ?_)
        rw [Real.volume_preimage_mul_left ht, Real.volume_Ioo, ← ENNReal.ofReal_mul (abs_nonneg _),
          abs_inv, show z i - a - (z i - a - s) = s by ring, div_eq_inv_mul])
    rw [hnh, div_mul_cancel₀ s (abs_ne_zero.2 ht)] at hgen
    have htrans : ∫ x in S, |ub (x + t • e) - β| = ∫ y in S', |ub y - β| := by
      rw [← integral_indicator hSm, ← integral_indicator hS'm,
        ← integral_add_right_eq_self (fun y => S'.indicator (fun y => |ub y - β|) y) (t • e)]
      refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
      dsimp only
      by_cases hx : x ∈ S
      · rw [indicator_of_mem hx, indicator_of_mem ((hmem x).1 hx)]
      · rw [indicator_of_notMem hx, indicator_of_notMem (fun h => hx ((hmem x).2 h))]
    have hi1 : IntegrableOn (fun x => |ub (x + t • e) - β|) S :=
      ((hub_int.comp_add_right (t • e)).integrableOn.sub (integrableOn_const hSfin)).abs
    have hi2 : IntegrableOn (fun x => |ub (x + t • e) - ub x|) S :=
      ((hub_int.comp_add_right (t • e)).sub hub_int).abs.integrableOn
    calc ∫ y in S, |ub y - β|
        ≤ ∫ x in S, (|ub (x + t • e) - ub x| + |ub (x + t • e) - β|) := by
          refine setIntegral_mono_on ((hub_int.integrableOn.sub (integrableOn_const hSfin)).abs)
            (hi2.add hi1) hSm fun x _ => ?_
          have := abs_sub_le (ub x) (ub (x + t • e)) β
          rwa [abs_sub_comm (ub x) (ub (x + t • e))] at this
      _ = (∫ x in S, |ub (x + t • e) - ub x|) + ∫ x in S, |ub (x + t • e) - β| :=
          integral_add hi2 hi1
      _ ≤ (∫ y in S', |ub y - β|) + 2 * (s * V) := by rw [htrans]; linarith only [hgen]
  have hstrip : ∀ (i : Fin (m + 1)) (N : ℕ), 1 ≤ N → ∀ a : ℝ, 0 ≤ a → a + 1 / N ≤ 1 →
      (N:ℝ) * ∫ y in {y : Euclid (m + 1) | y ∈ Q ∧ a < y i ∧ y i < a + 1 / N}, |ub y - β| ≤
        (∫ y in Q, |ub y - β|) + 2 * V := by
    intro i N hN a ha haN
    have hNpos : (0:ℝ) < N := Nat.cast_pos.2 hN
    have hk : ∀ k ∈ Finset.range N,
        ∫ y in {y : Euclid (m + 1) | y ∈ Q ∧ a < y i ∧ y i < a + 1 / N}, |ub y - β| ≤
          (∫ y in {y : Euclid (m + 1) | y ∈ Q ∧ (k / N : ℝ) < y i ∧ y i < k / N + 1 / N},
            |ub y - β|) + 2 * (1 / N * V) := fun k hk =>
      hslab i (1 / N) a (k / N) (one_div_pos.2 hNpos) ha haN
        (div_nonneg (Nat.cast_nonneg k) hNpos.le)
        (by rw [← add_div, div_le_one hNpos]
            exact_mod_cast Nat.succ_le_of_lt (Finset.mem_range.1 hk))
    have hsum := Finset.sum_le_sum hk
    rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul, Finset.sum_add_distrib, Finset.sum_const,
      Finset.card_range, nsmul_eq_mul] at hsum
    have hdisj : (↑(Finset.range N) : Set ℕ).Pairwise (Disjoint on fun k : ℕ =>
        {y : Euclid (m + 1) | y ∈ Q ∧ (k / N : ℝ) < y i ∧ y i < k / N + 1 / N}) := by
      intro k _ k' _ hkk'
      rw [Function.onFun, Set.disjoint_left]
      rintro y ⟨_, h1, h2⟩ ⟨_, h1', h2'⟩
      rcases lt_or_gt_of_ne hkk' with hlt | hlt
      · have : (k:ℝ) / N + 1 / N ≤ k' / N := by
          rw [← add_div]
          exact div_le_div_of_nonneg_right (by exact_mod_cast Nat.succ_le_of_lt hlt) hNpos.le
        linarith only [this, h2, h1']
      · have : (k':ℝ) / N + 1 / N ≤ k / N := by
          rw [← add_div]
          exact div_le_div_of_nonneg_right (by exact_mod_cast Nat.succ_le_of_lt hlt) hNpos.le
        linarith only [this, h2', h1]
    have hint : IntegrableOn (fun y => |ub y - β|) Q :=
      (hub_int.integrableOn.sub (integrableOn_const hQfin)).abs
    have hunion : ∑ k ∈ Finset.range N,
        ∫ y in {y : Euclid (m + 1) | y ∈ Q ∧ (k / N : ℝ) < y i ∧ y i < k / N + 1 / N}, |ub y - β|
          ≤ ∫ y in Q, |ub y - β| := by
      rw [← integral_biUnion_finset (Finset.range N) (fun k _ => (hslabo i _ _).measurableSet)
        hdisj (fun k _ => hint.mono_set (fun y hy => hy.1))]
      refine setIntegral_mono_set hint (Filter.Eventually.of_forall fun y => abs_nonneg _) ?_
      refine LE.le.eventuallySubset ?_
      intro y hy
      rw [mem_iUnion₂] at hy
      obtain ⟨k, _, hy⟩ := hy
      exact hy.1
    have : (N:ℝ) * (2 * (1 / N * V)) = 2 * V := by
      rw [mul_left_comm, ← mul_assoc (N:ℝ), mul_one_div_cancel hNpos.ne', one_mul]
    linarith only [hsum, hunion, this]
  clear hslab hGEN
  /- Step 10: difference quotients.  For `F` continuous with `|F| ≤ 1` and `s = 1/(2N)`,
  `∫_Q (ub - β) (F (· + s e) - F) / s` is the integral of `F` against the difference
  `w (· - s e) - w` of `w = (ub - β) 1_Q`, which is controlled by a translation estimate and the
  two boundary slabs. -/
  have hDQ : ∀ (i : Fin (m + 1)) (F : Euclid (m + 1) → ℝ), Continuous F → (∀ y, |F y| ≤ 1) →
      ∀ N : ℕ, 1 ≤ N →
      |∫ y in Q, (ub y - β) * ((2 * N : ℝ) *
        (F (y + (2 * N : ℝ)⁻¹ • EuclideanSpace.single i (1:ℝ)) - F y))|
        ≤ 10 * V + 4 * ∫ y in Q, |ub y - β| := by
    intro i F hFc hF1 N hN
    obtain ⟨e, he_def⟩ : ∃ e : Euclid (m + 1), e = EuclideanSpace.single i (1:ℝ) := ⟨_, rfl⟩
    have hce : ∀ (j : Fin (m + 1)) (x : Euclid (m + 1)) (t : ℝ),
        (x + t • e) j = if j = i then x j + t else x j := by
      subst he_def; exact fun j x t => hcoord i j x t
    have hne : ‖e‖ = 1 := by rw [he_def, PiLp.norm_single, norm_one]
    have hNpos : (0:ℝ) < N := Nat.cast_pos.2 hN
    obtain ⟨c, hc_def⟩ : ∃ c : ℝ, c = 2 * N := ⟨_, rfl⟩
    rw [← he_def, ← hc_def]
    have hc : 0 < c := hc_def ▸ mul_pos two_pos hNpos
    obtain ⟨s, hs_def⟩ : ∃ s : ℝ, s = c⁻¹ := ⟨_, rfl⟩
    rw [← hs_def]
    have hs : 0 < s := hs_def ▸ inv_pos.2 hc
    have hcs : c * s = 1 := hs_def ▸ mul_inv_cancel₀ hc.ne'
    have hsN : s < 1 / N := by
      rw [hs_def, hc_def, one_div]
      exact inv_strictAnti₀ hNpos (by linarith only [hNpos])
    have hcm : ∀ (j : Fin (m + 1)) (x : Euclid (m + 1)),
        (x - s • e) j = if j = i then x j - s else x j := by
      intro j x
      rw [sub_eq_add_neg, ← neg_smul, hce, ← sub_eq_add_neg]
    obtain ⟨wb, hwb_def⟩ : ∃ wb : Euclid (m + 1) → ℝ, wb = Q.indicator fun y => ub y - β :=
      ⟨_, rfl⟩
    have hwb_int : Integrable wb := hwb_def ▸
      (hub_int.integrableOn.sub (integrableOn_const hQfin)).integrable_indicator hQm
    have hFb : ∀ y, ‖F y‖ ≤ 1 := hF1
    have hi1 : Integrable fun y => wb y * F (y + s • e) :=
      hwb_int.mul_bdd (hFc.comp (continuous_id.add continuous_const)).aestronglyMeasurable
        (Filter.Eventually.of_forall fun y => hFb _)
    have hi2 : Integrable fun y => wb y * F y :=
      hwb_int.mul_bdd hFc.aestronglyMeasurable (Filter.Eventually.of_forall hFb)
    have hi3 : Integrable fun x => wb (x - s • e) * F x :=
      (hwb_int.comp_sub_right (s • e)).mul_bdd hFc.aestronglyMeasurable
        (Filter.Eventually.of_forall hFb)
    have e1 : ∫ y in Q, (ub y - β) * (c * (F (y + s • e) - F y)) =
        c * ∫ x, (wb (x - s • e) - wb x) * F x := by
      rw [← integral_indicator hQm]
      have : ∀ y, Q.indicator (fun y => (ub y - β) * (c * (F (y + s • e) - F y))) y =
          c * (wb y * F (y + s • e) - wb y * F y) := fun y => by
        rw [indicator_mul_left, ← hwb_def]; ring
      simp only [this]
      rw [integral_const_mul, integral_sub hi1 hi2,
        ← integral_sub_right_eq_self (fun y => wb y * F (y + s • e)) (s • e)]
      simp only [sub_add_cancel]
      rw [← integral_sub hi3 hi2]
      simp only [sub_mul]
    -- the pointwise bound: interior differences and the two boundary slabs
    obtain ⟨A, hA_def⟩ : ∃ A : Set (Euclid (m + 1)), A = (fun x => x + s • e) ⁻¹' Q ∩ Q :=
      ⟨_, rfl⟩
    obtain ⟨S0, hS0_def⟩ : ∃ S0 : Set (Euclid (m + 1)),
        S0 = {y : Euclid (m + 1) | y ∈ Q ∧ (0:ℝ) < y i ∧ y i < 0 + 1 / N} := ⟨_, rfl⟩
    obtain ⟨S1, hS1_def⟩ : ∃ S1 : Set (Euclid (m + 1)),
        S1 = {y : Euclid (m + 1) | y ∈ Q ∧ (1 - 1 / N : ℝ) < y i ∧ y i < (1 - 1 / N) + 1 / N} :=
      ⟨_, rfl⟩
    have hAm : MeasurableSet A := hA_def ▸ (hQm.preimage (measurable_add_const _)).inter hQm
    have hS0m : MeasurableSet S0 := hS0_def ▸ (hslabo i _ _).measurableSet
    have hS1m : MeasurableSet S1 := hS1_def ▸ (hslabo i _ _).measurableSet
    have hpt : ∀ x, |wb (x - s • e) - wb x| ≤
        A.indicator (fun z => |ub (z + s • e) - ub z|) (x - s • e) +
          S0.indicator (fun y => |ub y - β|) x +
          S1.indicator (fun y => |ub y - β|) (x - s • e) := by
      intro x
      have n1 := indicator_nonneg (fun z _ => abs_nonneg (ub (z + s • e) - ub z)) (x - s • e)
        (s := A)
      have n2 := indicator_nonneg (fun y _ => abs_nonneg (ub y - β)) x (s := S0)
      have n3 := indicator_nonneg (fun y _ => abs_nonneg (ub y - β)) (x - s • e) (s := S1)
      rw [hwb_def]
      by_cases hx : x ∈ Q <;> by_cases hxs : x - s • e ∈ Q
      · have hA : x - s • e ∈ A := by rw [hA_def]; exact ⟨by rwa [mem_preimage, sub_add_cancel], hxs⟩
        rw [indicator_of_mem hx, indicator_of_mem hxs, indicator_of_mem hA, sub_add_cancel,
          show ub (x - s • e) - (β:ℝ) - (ub x - β) = -(ub x - ub (x - s • e)) by ring, abs_neg]
        linarith only [n2, n3]
      · have hS0 : x ∈ S0 := by
          rw [hS0_def]
          refine ⟨hx, (hx i).1, ?_⟩
          by_contra hge
          rw [not_lt] at hge
          apply hxs
          intro j
          rw [hcm]
          split_ifs with hj
          · subst hj; constructor <;> linarith only [(hx j).2, hge, hsN, hs]
          · exact hx j
        rw [indicator_of_mem hx, indicator_of_notMem hxs, indicator_of_mem hS0, zero_sub, abs_neg]
        linarith only [n1, n3]
      · have hS1 : x - s • e ∈ S1 := by
          rw [hS1_def]
          refine ⟨hxs, ?_, ?_⟩
          · by_contra hle
            rw [not_lt, hcm, ite_eq_left rfl] at hle
            apply hx
            intro j
            have := hxs j
            rw [hcm] at this
            split_ifs at this with hj
            · subst hj; constructor <;> linarith only [this.1, hle, hsN, hs]
            · exact this
          · have := (hxs i).2; linarith only [this]
        rw [indicator_of_notMem hx, indicator_of_mem hxs, indicator_of_mem hS1, sub_zero]
        linarith only [n1, n2]
      · rw [indicator_of_notMem hx, indicator_of_notMem hxs, sub_zero, abs_zero]
        linarith only [n1, n2, n3]
    -- integrate the three terms
    have hg1 : Integrable fun z => |ub (z + s • e) - ub z| :=
      ((hub_int.comp_add_right _).sub hub_int).abs
    have hg2 : IntegrableOn (fun y => |ub y - β|) Q :=
      (hub_int.integrableOn.sub (integrableOn_const hQfin)).abs
    have hT1i : Integrable fun x => A.indicator (fun z => |ub (z + s • e) - ub z|) (x - s • e) :=
      (hg1.indicator hAm).comp_sub_right (s • e)
    have hT2i : Integrable (S0.indicator fun y => |ub y - β|) :=
      (hg2.mono_set (fun y hy => by rw [hS0_def] at hy; exact hy.1)).integrable_indicator hS0m
    have hT3i : Integrable fun x => S1.indicator (fun y => |ub y - β|) (x - s • e) :=
      ((hg2.mono_set (fun y hy => by rw [hS1_def] at hy; exact hy.1)).integrable_indicator
        hS1m).comp_sub_right (s • e)
    have hI1 : ∫ x, A.indicator (fun z => |ub (z + s • e) - ub z|) (x - s • e) ≤ 2 * (s * V) := by
      rw [integral_sub_right_eq_self (fun x => A.indicator (fun z => |ub (z + s • e) - ub z|) x)
        (s • e), integral_indicator hAm, hA_def]
      have := hTR (s • e)
      rwa [norm_smul, hne, mul_one, Real.norm_of_nonneg hs.le] at this
    have hI3 : ∫ x, S1.indicator (fun y => |ub y - β|) (x - s • e) = ∫ y in S1, |ub y - β| := by
      rw [integral_sub_right_eq_self (fun x => S1.indicator (fun y => |ub y - β|) x) (s • e),
        integral_indicator hS1m]
    have hb2 : (N:ℝ) * ∫ y in S0, |ub y - β| ≤ (∫ y in Q, |ub y - β|) + 2 * V := hS0_def ▸
      hstrip i N hN 0 le_rfl (by rw [zero_add, div_le_one hNpos]; exact Nat.one_le_cast.2 hN)
    have hb3 : (N:ℝ) * ∫ y in S1, |ub y - β| ≤ (∫ y in Q, |ub y - β|) + 2 * V := hS1_def ▸
      hstrip i N hN (1 - 1 / N) (by rw [sub_nonneg, div_le_one hNpos]; exact Nat.one_le_cast.2 hN)
        (by rw [sub_add_cancel])
    have hmain : ∫ x, |wb (x - s • e) - wb x| ≤
        2 * (s * V) + (∫ y in S0, |ub y - β|) + ∫ y in S1, |ub y - β| := by
      refine (integral_mono ((hwb_int.comp_sub_right _).sub hwb_int).abs
        ((hT1i.add hT2i).add hT3i) hpt).trans ?_
      rw [integral_add' (hT1i.add hT2i) hT3i, integral_add' hT1i hT2i, integral_indicator hS0m, hI3]
      linarith only [hI1]
    have hbound : |∫ x, (wb (x - s • e) - wb x) * F x| ≤ ∫ x, |wb (x - s • e) - wb x| := by
      rw [← Real.norm_eq_abs]
      refine norm_integral_le_of_norm_le ((hwb_int.comp_sub_right _).sub hwb_int).abs
        (Filter.Eventually.of_forall fun x => ?_)
      rw [Real.norm_eq_abs, abs_mul]
      exact mul_le_of_le_one_right (abs_nonneg _) (hF1 x)
    rw [e1, abs_mul, abs_of_pos hc]
    have h5 := mul_le_mul_of_nonneg_left (hbound.trans hmain) hc.le
    have h6 : c * (2 * (s * V) + (∫ y in S0, |ub y - β|) + ∫ y in S1, |ub y - β|) =
        2 * (c * s) * V + 2 * ((N:ℝ) * ∫ y in S0, |ub y - β|) +
          2 * ((N:ℝ) * ∫ y in S1, |ub y - β|) := by
      rw [hc_def]; ring
    rw [h6, hcs] at h5
    linarith only [h5, hb2, hb3]
  clear hstrip hslabo hcoord hTR
  /- Step 11: the boundary estimate (3): write `div G = ∑ᵢ ∂ᵢ Gᵢ` and pass to the limit in the
  difference quotients by dominated convergence. -/
  obtain ⟨I, hI_def⟩ : ∃ I : ℝ, I = ∫ y in Q, |ub y - β| := ⟨_, rfl⟩
  rw [← hI_def] at hDQ hP1
  have hwi : IntegrableOn (fun y => ub y - β) Q :=
    hub_int.integrableOn.sub (integrableOn_const hQfin)
  have h3 : ∀ G : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) G → (∀ y, ‖G y‖ ≤ 1) →
      |∫ y in Q, (ub y - β) * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G y)| ≤
        (m + 1) * (10 * V + 4 * I) := by
    intro G hG hG1
    have hG1' : ContDiff ℝ 1 G := hG.of_le (by exact_mod_cast le_top)
    have hdG : Continuous (fderiv ℝ G) := hG1'.continuous_fderiv one_ne_zero
    have hGd : ∀ y, HasFDerivAt G (fderiv ℝ G y) y := fun y =>
      (hG1'.differentiable one_ne_zero y).hasFDerivAt
    have hterm : ∀ i : Fin (m + 1),
        |∫ y in Q, (ub y - β) * (fderiv ℝ G y (EuclideanSpace.single i 1)) i| ≤
          10 * V + 4 * I := by
      intro i
      obtain ⟨e, he_def⟩ : ∃ e : Euclid (m + 1), e = EuclideanSpace.single i (1:ℝ) := ⟨_, rfl⟩
      rw [← he_def]
      have hne : ‖e‖ = 1 := by rw [he_def, PiLp.norm_single, norm_one]
      obtain ⟨Fi, hFi_def⟩ : ∃ Fi : Euclid (m + 1) → ℝ, Fi = fun y => G y i := ⟨_, rfl⟩
      have hFid : ∀ y, HasFDerivAt Fi ((EuclideanSpace.proj (𝕜 := ℝ) i).comp (fderiv ℝ G y)) y :=
        fun y => by
          rw [hFi_def]; exact (EuclideanSpace.proj (𝕜 := ℝ) i).hasFDerivAt.comp y (hGd y)
      have hFic : Continuous Fi := by
        rw [hFi_def]; exact (EuclideanSpace.proj i).continuous.comp hG.continuous
      have hFi1 : ∀ y, |Fi y| ≤ 1 := fun y => by
        rw [hFi_def, ← Real.norm_eq_abs]; exact (PiLp.norm_apply_le (G y) i).trans (hG1 y)
      have hdFc : Continuous fun y => (EuclideanSpace.proj (𝕜 := ℝ) i).comp (fderiv ℝ G y) :=
        continuous_const.clm_comp hdG
      obtain ⟨C, hC⟩ := (isCompact_closedBall (0 : Euclid (m + 1)) (R + 1)).exists_bound_of_continuousOn
        hdFc.continuousOn
      have hC' : ∀ y ∈ closedBall (0 : Euclid (m + 1)) (R + 1), ‖fderiv ℝ Fi y‖ ≤ C :=
        fun y hy => by rw [(hFid y).fderiv]; exact hC y hy
      have hmvt : ∀ y ∈ Q, ∀ t : ℝ, 0 < t → |Fi (y + t • e) - Fi y| ≤ C * t ∨ 1 < t := by
        intro y hy t ht0
        rcases le_or_gt t 1 with ht1 | ht1
        · left
          have hny := hnormQ y hy
          have hyK : y ∈ closedBall (0 : Euclid (m + 1)) (R + 1) := by
            rw [mem_closedBall, dist_zero_right]; linarith only [hny]
          have hyK' : y + t • e ∈ closedBall (0 : Euclid (m + 1)) (R + 1) := by
            rw [mem_closedBall, dist_zero_right]
            refine (norm_add_le _ _).trans ?_
            rw [norm_smul, hne, mul_one, Real.norm_of_nonneg ht0.le]
            linarith only [hny, ht1]
          have := (convex_closedBall (0 : Euclid (m + 1)) (R + 1)).norm_image_sub_le_of_norm_fderiv_le
            (fun z _ => (hFid z).differentiableAt) hC' hyK hyK'
          rwa [add_sub_cancel_left, norm_smul, hne, mul_one, Real.norm_of_nonneg ht0.le,
            Real.norm_eq_abs] at this
        · right; exact ht1
      obtain ⟨c, hc_def⟩ : ∃ c : ℕ → ℝ, c = fun N => 2 * ((N + 1 : ℕ) : ℝ) := ⟨_, rfl⟩
      have hcpos : ∀ N, 0 < c N := fun N => by
        rw [hc_def]; exact mul_pos two_pos (Nat.cast_pos.2 N.succ_pos)
      have hc1 : ∀ N, ¬ 1 < (c N)⁻¹ := fun N => by
        rw [not_lt, inv_le_one₀ (hcpos N), hc_def]
        have : (1:ℝ) ≤ ((N + 1 : ℕ) : ℝ) := Nat.one_le_cast.2 N.succ_pos
        linarith only [this]
      have hctend : Tendsto (fun N => ‖c N‖) atTop atTop := by
        have : (fun N => ‖c N‖) = fun N : ℕ => 2 * ((N + 1 : ℕ) : ℝ) := by
          funext N; rw [Real.norm_of_nonneg (hcpos N).le, hc_def]
        rw [this]
        exact Tendsto.const_mul_atTop two_pos
          (tendsto_natCast_atTop_atTop.comp (tendsto_add_atTop_nat 1))
      have hlim : Tendsto
          (fun N => ∫ y in Q, (ub y - β) * (c N * (Fi (y + (c N)⁻¹ • e) - Fi y)))
          atTop (𝓝 (∫ y in Q, (ub y - β) * (fderiv ℝ G y e) i)) := by
        refine tendsto_integral_of_dominated_convergence (fun y => |ub y - β| * C) (fun N => ?_)
          (hwi.abs.mul_const C) (fun N => ?_) ?_
        · exact (hub_meas.sub measurable_const).aestronglyMeasurable.mul
            (continuous_const.mul ((hFic.comp (continuous_id.add continuous_const)).sub
              hFic)).aestronglyMeasurable
        · refine (ae_restrict_iff' hQm).2 (Filter.Eventually.of_forall fun y hy => ?_)
          rw [Real.norm_eq_abs, abs_mul, abs_mul, abs_of_pos (hcpos N)]
          refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
          have := (hmvt y hy (c N)⁻¹ (inv_pos.2 (hcpos N))).resolve_right (hc1 N)
          calc c N * |Fi (y + (c N)⁻¹ • e) - Fi y| ≤ c N * (C * (c N)⁻¹) :=
                mul_le_mul_of_nonneg_left this (hcpos N).le
            _ = C := by rw [mul_comm C, ← mul_assoc, mul_inv_cancel₀ (hcpos N).ne', one_mul]
        · refine Filter.Eventually.of_forall fun y => ?_
          have := (hFid y).lim e hctend
          simp only [smul_eq_mul] at this
          exact this.const_mul _
      have hbd : ∀ N, |∫ y in Q, (ub y - β) * (c N * (Fi (y + (c N)⁻¹ • e) - Fi y))| ≤
          10 * V + 4 * I := fun N => by
        have := hDQ i Fi hFic hFi1 (N + 1) (by omega)
        rwa [← he_def, show (2 * ((N + 1 : ℕ) : ℝ)) = c N by rw [hc_def]] at this
      exact le_of_tendsto' ((continuous_abs.tendsto _).comp hlim) hbd
    have htr : ∀ y, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G y) =
        ∑ i, (fderiv ℝ G y (EuclideanSpace.single i 1)) i := by
      intro y
      rw [LinearMap.trace_eq_matrix_trace ℝ (EuclideanSpace.basisFun (Fin (m + 1)) ℝ).toBasis]
      simp [Matrix.trace, LinearMap.toMatrix_apply]
    have hint_i : ∀ i : Fin (m + 1), Integrable
        (fun y => (ub y - β) * (fderiv ℝ G y (EuclideanSpace.single i 1)) i) (volume.restrict Q) := by
      intro i
      have hcont : Continuous fun y => (fderiv ℝ G y (EuclideanSpace.single i 1)) i :=
        (EuclideanSpace.proj i).continuous.comp (hdG.clm_apply continuous_const)
      obtain ⟨C, hC⟩ := (isCompact_closedBall (0 : Euclid (m + 1)) R).exists_bound_of_continuousOn
        hcont.continuousOn
      refine hwi.mul_bdd hcont.aestronglyMeasurable ((ae_restrict_iff' hQm).2
        (Filter.Eventually.of_forall fun y hy => hC y ?_))
      rw [mem_closedBall, dist_zero_right]; exact hnormQ y hy
    calc |∫ y in Q, (ub y - β) * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G y)|
        = |∑ i, ∫ y in Q, (ub y - β) * (fderiv ℝ G y (EuclideanSpace.single i 1)) i| := by
          rw [← integral_finsetSum _ fun i _ => hint_i i]
          congr 2; funext y
          rw [htr y, Finset.mul_sum]
      _ ≤ ∑ i, |∫ y in Q, (ub y - β) * (fderiv ℝ G y (EuclideanSpace.single i 1)) i| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _i : Fin (m + 1), (10 * V + 4 * I) := Finset.sum_le_sum fun i _ => hterm i
      _ = (m + 1) * (10 * V + 4 * I) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, Nat.cast_add,
            Nat.cast_one]
  /- Conclusion. -/
  have hm0 : (0:ℝ) ≤ m + 1 := add_nonneg (Nat.cast_nonneg m) zero_le_one
  have hcV : CP * V ≤ (CP + (m + 1) * (10 + 4 * CP) + 1) * V := by
    refine mul_le_mul_of_nonneg_right ?_ hV0
    have := mul_nonneg hm0 (by linarith only [hCP] : (0:ℝ) ≤ 10 + 4 * CP)
    linarith only [this]
  refine ⟨β, ?_, hβM, ?_⟩
  · have : ∫ y in Q, |u y - β| = I := by
      rw [hI_def]; exact integral_congr_ae (by filter_upwards [hub_ae] with y hy; rw [hy])
    rw [this]; exact hP1.trans hcV
  · intro G hG hG1
    have : ∫ y in Q, (u y - β) * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G y) =
        ∫ y in Q, (ub y - β) * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G y) :=
      integral_congr_ae (by filter_upwards [hub_ae] with y hy; rw [hy])
    rw [this]
    refine (h3 G hG hG1).trans ?_
    have h1 : (m + 1) * (10 * V + 4 * I) ≤ (m + 1) * (10 * V + 4 * (CP * V)) :=
      mul_le_mul_of_nonneg_left (by linarith only [hP1]) hm0
    have h2 : (m + 1) * (10 * V + 4 * (CP * V)) = (m + 1) * (10 + 4 * CP) * V := by ring
    have h4 : (m + 1) * (10 + 4 * CP) * V ≤ (CP + (m + 1) * (10 + 4 * CP) + 1) * V :=
      mul_le_mul_of_nonneg_right (by linarith only [hCP]) hV0
    linarith only [h1, h2, h4]
/-- **Dilation pull-back of a test form** (Simon 6.2.23 for `f = δ_λ`, `δ_λ(x) = λx`, `λ ≠ 0`):
`δ_λ^#ω = affinePullbackForm (λ·id) 0 ω` is again a test form on `ℝᴾ`, and
`(δ_λ^#ω)(x) = λᵏ ω(λx)` as `k`-covectors.  `x ↦ λx` is a homeomorphism, hence proper, so the
pull-back preserves compactly supported smooth forms; multilinearity of the covector `ω(λx)`
pulls `λ` out of each of its `k` slots. -/
theorem Submission.cmcdt_dil_pullback_testForm : ∀ (P k : ℕ) (lam : ℝ), lam ≠ 0 → ∀ ω : TestFormOn (univ : Set (Euclid P)) k, ∃ η : TestFormOn (univ : Set (Euclid P)) k, (η : DifferentialForm (Euclid P) k) = affinePullbackForm (lam • ContinuousLinearMap.id ℝ (Euclid P)) 0 (ω : DifferentialForm (Euclid P) k) ∧ ∀ x : Euclid P, (η : DifferentialForm (Euclid P) k) x = lam ^ k • (ω : DifferentialForm (Euclid P) k) (lam • x) := by
  intro P k lam hlam ω
  -- Step 1: `x ↦ 0 + (λ·id)x = λx` is a homeomorphism, hence a proper map.
  have hproper : IsProperMap
      (fun x : Euclid P => (0 : Euclid P) + (lam • ContinuousLinearMap.id ℝ (Euclid P)) x) := by
    convert (Homeomorph.smulOfNeZero (α := Euclid P) lam hlam).isProperMap using 1
    funext x
    simp
  -- Step 2: the pull-back along the proper map is a test form, trivially supported in `univ`.
  refine ⟨⟨affinePullbackForm (lam • ContinuousLinearMap.id ℝ (Euclid P)) 0
      (ω : DifferentialForm (Euclid P) k),
    affinePullbackForm_isTestForm _ _ hproper ω.property.1, subset_univ _⟩, rfl, fun x => ?_⟩
  -- Steps 3–4: `η(x)(v) = ω(λx)(λv₁, …, λvₖ) = (∏ᵢ λ) ω(λx)(v) = λᵏ ω(λx)(v)` for every `v`.
  have hx : (0 : Euclid P) + (lam • ContinuousLinearMap.id ℝ (Euclid P)) x = lam • x := by
    simp
  ext v
  have hv : (lam • ContinuousLinearMap.id ℝ (Euclid P)) ∘ v = fun i => lam • v i := by
    funext i
    simp
  simp only [affinePullbackForm, ContinuousAlternatingMap.compContinuousLinearMap_apply, hx, hv,
    ContinuousAlternatingMap.map_smul_univ, Fin.prod_const, ContinuousAlternatingMap.smul_apply]

/-- **Mass under the dilation push-forward** (step 5 of the proof of
`Submission.cmcdt_dilation_pushforward`; Simon 6.5.3, chapter-06.txt lines 1458–1460: the changes
of scale `x ↦ λ⁻¹x` and `x ↦ λx` scale the masses of `k`-currents by `λ^{∓k}`).  Let `λ > 0` and
`X, Y ∈ 𝒟_k(ℝᴾ)` with `Y(ω) = X(η)` whenever `η = δ_λ^#ω`, i.e. `Y = δ_{λ#}X` for `δ_λ(x) = λx`
(6.2.23).  Then `M(Y) = λᵏ M(X)` in `[0, ∞]`, with no finiteness assumption.  By
`Submission.cmcdt_dil_pullback_testForm`, `δ_μ^#ω` is a test form with `(δ_μ^#ω)(x) = μᵏ ω(μx)`
for `μ ≠ 0`.  (1) For admissible `ω`, `η' = λ⁻ᵏ δ_λ^#ω` has `η'(x) = ω(λx)`, so it is admissible
and `Y(ω) = X(δ_λ^#ω) = λᵏ X(η') ≤ λᵏ M(X)`.  (2) For admissible `η`, `ω = λᵏ δ_{λ⁻¹}^#η` has
`ω(y) = η(λ⁻¹y)`, so it is admissible, and `δ_λ^#ω = λᵏ η`; thus `λᵏ X(η) = Y(ω) ≤ M(Y)`, and
`λᵏ M(X) ≤ M(Y)` because multiplication by `λᵏ` commutes with suprema in `[0, ∞]`. -/
theorem Submission.cmcdt_dil_mass_eq : ∀ (P k : ℕ) (lam : ℝ), 0 < lam → ∀ X Y : GeometricCurrentOn (univ : Set (Euclid P)) k, (∀ ω η : TestFormOn (univ : Set (Euclid P)) k, (η : DifferentialForm (Euclid P) k) = affinePullbackForm (lam • ContinuousLinearMap.id ℝ (Euclid P)) 0 (ω : DifferentialForm (Euclid P) k) → Y ω = X η) → Y.mass = ENNReal.ofReal (lam ^ k) * X.mass := by
  intro P k lam hlam X Y hXY
  have hlam0 : lam ≠ 0 := hlam.ne'
  have hpow : 0 < lam ^ k := pow_pos hlam k
  apply le_antisymm
  -- Step 1: `M(Y) ≤ λᵏ M(X)`.  Fix an admissible `ω`.
  · refine sSup_le ?_
    rintro _ ⟨ω, hω, rfl⟩
    show ENNReal.ofReal (Y ω) ≤ ENNReal.ofReal (lam ^ k) * X.mass
    -- (a) `η = δ_λ^#ω` is a test form with `η(x) = λᵏ ω(λx)`, and `Y(ω) = X(η)`.
    obtain ⟨η, hηω, hη⟩ := Submission.cmcdt_dil_pullback_testForm P k lam hlam0 ω
    -- (b) `η' = λ⁻ᵏ η` has `η'(x) = ω(λx)`, so it is admissible.
    have hη' : (lam ^ k)⁻¹ • η ∈ massAdmissibleOn (univ : Set (Euclid P)) k univ := by
      refine ⟨subset_univ _, fun x => ?_⟩
      change covectorEuclideanNorm ((lam ^ k)⁻¹ • (η : DifferentialForm (Euclid P) k) x) ≤ 1
      rw [hη x, smul_smul, inv_mul_cancel₀ hpow.ne', one_smul]
      exact hω.2 (lam • x)
    -- (c) `X(η) = λᵏ X(η')` by linearity.
    have hXη : X η = lam ^ k * X ((lam ^ k)⁻¹ • η) := by
      rw [map_smul, smul_eq_mul, ← mul_assoc, mul_inv_cancel₀ hpow.ne', one_mul]
    -- (d) `Y(ω) = λᵏ X(η') ≤ λᵏ M(X)`.
    rw [hXY ω η hηω, hXη, ENNReal.ofReal_mul hpow.le]
    exact mul_le_mul_right (X.le_massOn hη') _
  -- Step 2: `λᵏ M(X) ≤ M(Y)`, where `λᵏ M(X)` is the supremum of `λᵏ X(η)` over admissible `η`.
  · show ENNReal.ofReal (lam ^ k) * sSup ((fun ω => ENNReal.ofReal (X ω)) ''
      massAdmissibleOn (univ : Set (Euclid P)) k univ) ≤ Y.mass
    rw [ENNReal.mul_sSup]
    refine iSup₂_le ?_
    rintro _ ⟨η, hη, rfl⟩
    show ENNReal.ofReal (lam ^ k) * ENNReal.ofReal (X η) ≤ Y.mass
    -- (a) `ζ = δ_{λ⁻¹}^#η` and `ω = λᵏ ζ`, so `ω(y) = η(λ⁻¹y)`.
    obtain ⟨ζ, -, hζ⟩ := Submission.cmcdt_dil_pullback_testForm P k lam⁻¹ (inv_ne_zero hlam0) η
    have hω : ∀ y, ((lam ^ k • ζ : TestFormOn (univ : Set (Euclid P)) k) :
        DifferentialForm (Euclid P) k) y = (η : DifferentialForm (Euclid P) k) (lam⁻¹ • y) := by
      intro y
      change lam ^ k • (ζ : DifferentialForm (Euclid P) k) y = _
      rw [hζ y, smul_smul, ← mul_pow, mul_inv_cancel₀ hlam0, one_pow, one_smul]
    -- (b) `ω` is admissible.
    have hωadm : lam ^ k • ζ ∈ massAdmissibleOn (univ : Set (Euclid P)) k univ := by
      refine ⟨subset_univ _, fun y => ?_⟩
      rw [hω y]
      exact hη.2 (lam⁻¹ • y)
    -- (c) `η₂ = δ_λ^#ω` satisfies `η₂(x) = λᵏ ω(λx) = λᵏ η(x)`, i.e. `η₂ = λᵏ η`.
    obtain ⟨η₂, hη₂ω, hη₂⟩ := Submission.cmcdt_dil_pullback_testForm P k lam hlam0 (lam ^ k • ζ)
    have hη₂η : η₂ = lam ^ k • η := by
      refine Subtype.ext (funext fun x => ?_)
      change (η₂ : DifferentialForm (Euclid P) k) x = lam ^ k • (η : DifferentialForm (Euclid P) k) x
      rw [hη₂ x, hω, inv_smul_smul₀ hlam0]
    -- (d) `λᵏ X(η) = X(η₂) = Y(ω) ≤ M(Y)`.
    calc ENNReal.ofReal (lam ^ k) * ENNReal.ofReal (X η)
        = ENNReal.ofReal (Y (lam ^ k • ζ)) := by
          rw [hXY (lam ^ k • ζ) η₂ hη₂ω, hη₂η, map_smul, smul_eq_mul, ENNReal.ofReal_mul hpow.le]
      _ ≤ Y.mass := Y.le_massOn hωadm
/-- **Support of the dilation push-forward**: step 6 of the proof of `cmcdt_dilation_pushforward`
(`spt T` as in Simon 6.2.11, chapter-06.txt lines 296–302; change of scale as in 6.5.3, lines
1458–1460).  If `λ > 0` and `Y(ω) = X(δ_λ^#ω)` for all test forms `ω` (`Y = δ_{λ#}X`,
`δ_λ(x) = λx`), then `spt Y = λ spt X`.  As `δ_λ^#ω = λᵏ ω(λ·)`, `tsupport δ_λ^#ω ⊆
δ_λ⁻¹(tsupport ω)`, so `Y` vanishes on `λW` whenever `X` vanishes on `W`; as `δ_λ^#δ_{λ⁻¹}^#η = η`,
`X` vanishes on `λ⁻¹W` whenever `Y` vanishes on `W`.  Hence `Z_Y = λZ_X`, and `δ_λ` is a
bijection of `ℝᴾ`. -/
theorem Submission.cmcdt_dil_support_eq : ∀ (P k : ℕ) (lam : ℝ), 0 < lam → ∀ X Y : GeometricCurrentOn (univ : Set (Euclid P)) k, (∀ ω η : TestFormOn (univ : Set (Euclid P)) k, (η : DifferentialForm (Euclid P) k) = affinePullbackForm (lam • ContinuousLinearMap.id ℝ (Euclid P)) 0 (ω : DifferentialForm (Euclid P) k) → Y ω = X η) → Y.support = (fun x => lam • x) '' X.support := by
  intro P k lam hlam X Y hrel
  have hne : lam ≠ 0 := hlam.ne'
  have hne' : lam⁻¹ ≠ 0 := inv_ne_zero hne
  -- Step 0(b): if `η(x) = μᵏ ω(μx)` for all `x`, then `tsupport η ⊆ δ_μ⁻¹(tsupport ω)`.
  have htsupp : ∀ (μ : ℝ) (ω η : TestFormOn (univ : Set (Euclid P)) k),
      (∀ x, (η : DifferentialForm (Euclid P) k) x =
        μ ^ k • (ω : DifferentialForm (Euclid P) k) (μ • x)) →
      tsupport (η : DifferentialForm (Euclid P) k) ⊆
        (fun x => μ • x) ⁻¹' tsupport (ω : DifferentialForm (Euclid P) k) := by
    intro μ ω η h
    refine closure_minimal (fun x hx => ?_)
      ((isClosed_tsupport _).preimage (continuous_const_smul μ))
    refine mem_preimage.2 (subset_tsupport _ fun h0 => hx ?_)
    rw [h x, h0, smul_zero]
  -- Step 0(c): each test form `η` has `ζ = δ_{λ⁻¹}^#η` with `X(η) = Y(ζ)`, since `δ_λ^#ζ = η`,
  -- and `tsupport ζ ⊆ δ_{λ⁻¹}⁻¹(tsupport η)` by Step 0(b).
  have hinv : ∀ η : TestFormOn (univ : Set (Euclid P)) k,
      ∃ ζ : TestFormOn (univ : Set (Euclid P)) k, X η = Y ζ ∧
        tsupport (ζ : DifferentialForm (Euclid P) k) ⊆
          (fun x => lam⁻¹ • x) ⁻¹' tsupport (η : DifferentialForm (Euclid P) k) := by
    intro η
    obtain ⟨ζ, -, hζ⟩ := Submission.cmcdt_dil_pullback_testForm P k lam⁻¹ hne' η
    obtain ⟨η₂, hη₂, hη₂ζ⟩ := Submission.cmcdt_dil_pullback_testForm P k lam hne ζ
    have hη₂η : η₂ = η := by
      refine Subtype.ext (funext fun x => ?_)
      rw [hη₂ζ x, hζ, smul_smul, ← mul_pow, mul_inv_cancel₀ hne, one_pow, one_smul,
        inv_smul_smul₀ hne]
    exact ⟨ζ, by rw [hrel ζ η₂ hη₂, hη₂η], htsupp lam⁻¹ η ζ hζ⟩
  -- Steps 1 and 2 share one argument: if every `ω` has `η` with `A(ω) = B(η)` and
  -- `tsupport η ⊆ δ_μ⁻¹(tsupport ω)`, then `δ_μ(Z_B) ⊆ Z_A`.  For `x ∈ W` with `B` vanishing on
  -- `W`, `δ_μ(W)` is open with compact closure (Step 0(a)) and `A` vanishes on it, because
  -- `tsupport ω ⊆ δ_μ(W)` gives `tsupport η ⊆ δ_μ⁻¹(δ_μ(W)) = W`.
  have hzero : ∀ μ : ℝ, μ ≠ 0 → ∀ A B : GeometricCurrentOn (univ : Set (Euclid P)) k,
      (∀ ω : TestFormOn (univ : Set (Euclid P)) k, ∃ η : TestFormOn (univ : Set (Euclid P)) k,
        A ω = B η ∧ tsupport (η : DifferentialForm (Euclid P) k) ⊆
          (fun x => μ • x) ⁻¹' tsupport (ω : DifferentialForm (Euclid P) k)) →
      (fun x => μ • x) '' B.zeroRegion ⊆ A.zeroRegion := by
    rintro μ hμ A B hAB _ ⟨x, ⟨W, ⟨hWo, hWc, -, hWv⟩, hxW⟩, rfl⟩
    have hK : IsCompact ((fun x => μ • x) '' closure W) := hWc.image (continuous_const_smul μ)
    refine ⟨(fun x => μ • x) '' W, ⟨isOpenMap_smul₀ hμ W hWo,
      hK.of_isClosed_subset isClosed_closure (closure_minimal (image_mono subset_closure)
        hK.isClosed), subset_univ _, fun ω hω => ?_⟩, mem_image_of_mem _ hxW⟩
    obtain ⟨η, hAB', hηω⟩ := hAB ω
    rw [hAB']
    exact hWv η (hηω.trans ((preimage_mono hω).trans
      ((smul_right_injective (Euclid P) hμ).preimage_image W).subset))
  -- Step 1: `δ_λ(Z_X) ⊆ Z_Y`, taking `η = δ_λ^#ω` from `cmcdt_dil_pullback_testForm`.
  have h1 : (fun x => lam • x) '' X.zeroRegion ⊆ Y.zeroRegion := by
    refine hzero lam hne Y X fun ω => ?_
    obtain ⟨η, hη, hηω⟩ := Submission.cmcdt_dil_pullback_testForm P k lam hne ω
    exact ⟨η, hrel ω η hη, htsupp lam ω η hηω⟩
  -- Step 2: `δ_{λ⁻¹}(Z_Y) ⊆ Z_X` by Step 0(c), so `y = λ(λ⁻¹y) ∈ δ_λ(Z_X)` for `y ∈ Z_Y`.
  have h2 : (fun x => lam⁻¹ • x) '' Y.zeroRegion ⊆ X.zeroRegion := hzero lam⁻¹ hne' X Y hinv
  have hZ : Y.zeroRegion = (fun x => lam • x) '' X.zeroRegion :=
    Subset.antisymm
      (fun y hy => ⟨lam⁻¹ • y, h2 (mem_image_of_mem _ hy), smul_inv_smul₀ hne y⟩) h1
  -- Step 3: `δ_λ` is a bijection, so `spt Y = univ \ δ_λ(Z_X) = δ_λ(univ \ Z_X) = δ_λ(spt X)`.
  unfold GeometricCurrentOn.support
  rw [hZ, image_sdiff (smul_right_injective (Euclid P) hne),
    image_univ_of_surjective (f := fun x : Euclid P => lam • x)
      fun y => ⟨lam⁻¹ • y, smul_inv_smul₀ hne y⟩]
/-- **Integer multiplicity is preserved by the dilation push-forward** `δ_{λ#}`, `δ_λ(x) = λx`,
`λ > 0` (step 7 of the proof of `cmcdt_dilation_pushforward`; compare Simon 6.3.3).  If
`Y(ω) = X(δ_λ^#ω)` and `X = τ(M, θ, ξ)`, then `Y = τ(λM, θ(·/λ), ξ(·/λ))`, with
`λM = δ_{λ⁻¹}⁻¹(M)`.  The change of variables `(δ_λ)_#(Hᵏ⌞M) = λ⁻ᵏ Hᵏ⌞λM` transfers local
integrability, measurability and orientation (`T_{λx}(λM) = TₓM`), and `δ_λ^#ω(x) = λᵏω(λx)`
gives `Y(ω) = λᵏλ⁻ᵏ ∫_{λM} θ(·/λ) ⟨ω, ξ(·/λ)⟩ dHᵏ`.  This holds in every degree `k`. -/
theorem Submission.cmcdt_dil_isIntegerMultiplicity : ∀ (P k : ℕ) (lam : ℝ), 0 < lam → ∀ X Y : GeometricCurrentOn (univ : Set (Euclid P)) k, (∀ ω η : TestFormOn (univ : Set (Euclid P)) k, (η : DifferentialForm (Euclid P) k) = affinePullbackForm (lam • ContinuousLinearMap.id ℝ (Euclid P)) 0 (ω : DifferentialForm (Euclid P) k) → Y ω = X η) → IsIntegerMultiplicity X → IsIntegerMultiplicity Y := by
  intro P k lam hlam X Y hXY ⟨R, hR⟩
  have hlam0 : lam ≠ 0 := hlam.ne'
  -- `δ_λ` is a homeomorphism, hence a measurable embedding, and `δ_λ⁻¹(δ_{λ⁻¹}⁻¹(S)) = S`
  have hT : MeasurableEmbedding (fun x : Euclid P => lam • x) :=
    (Homeomorph.smulOfNeZero lam hlam0).measurableEmbedding
  have hpre : ∀ S : Set (Euclid P),
      (fun x : Euclid P => lam • x) ⁻¹' ((fun y : Euclid P => lam⁻¹ • y) ⁻¹' S) = S := by
    intro S
    ext x
    simp only [mem_preimage, inv_smul_smul₀ hlam0]
  have hc0 : ENNReal.ofReal (lam⁻¹ ^ k) ≠ 0 :=
    (ENNReal.ofReal_pos.2 (pow_pos (inv_pos.2 hlam) k)).ne'
  -- change of variables on `M' = δ_{λ⁻¹}⁻¹(M)`: `(δ_λ)_#(Hᵏ⌞M) = λ⁻ᵏ Hᵏ⌞M'` and
  -- `∫_M g(λz) dHᵏ(z) = λ⁻ᵏ ∫_{M'} g dHᵏ`
  obtain ⟨hcv1, -, hcv3⟩ := Submission.euclid_hausdorff_dilation_change_of_variables P k lam hlam
    ((fun y : Euclid P => lam⁻¹ • y) ⁻¹' R.carrier)
  rw [hpre] at hcv1 hcv3
  -- rectifiability: `M' ⊆ δ_{λ⁻¹}⁻¹(M₀) ∪ ⋃ⱼ range (λFⱼ)`, with `Hᵏ(δ_{λ⁻¹}⁻¹(M₀)) = λᵏHᵏ(M₀) = 0`
  have hrect : CountablyRectifiable k ((fun y : Euclid P => lam⁻¹ • y) ⁻¹' R.carrier) := by
    obtain ⟨M₀, hM₀, F, hF, hcover⟩ := R.rectifiable
    refine ⟨(fun y : Euclid P => lam⁻¹ • y) ⁻¹' M₀, ?_, fun j z => lam • F j z, fun j => ?_,
      fun y hy => ?_⟩
    · rw [preimage_smul₀ (inv_ne_zero hlam0),
        Measure.euclideanHausdorffMeasure_smul₀ k (inv_ne_zero (inv_ne_zero hlam0)), hM₀,
        smul_zero]
    · obtain ⟨K, hK⟩ := hF j
      exact ⟨‖lam‖₊ * K, (lipschitzWith_smul lam).comp hK⟩
    · have hy' : lam⁻¹ • y ∈ R.carrier := hy
      rcases hcover hy' with h0 | h1
      · exact Or.inl h0
      · obtain ⟨j, z, hz⟩ := mem_iUnion.1 h1
        exact Or.inr (mem_iUnion.2 ⟨j, z, by simp only [hz, smul_inv_smul₀ hlam0]⟩)
  -- local integrability: `∫⁻_{M ∩ δ_λ⁻¹(K)} θ dHᵏ = λ⁻ᵏ ∫⁻_{M' ∩ K} θ(·/λ) dHᵏ`
  have hint : ∀ K : Set (Euclid P), IsCompact K → K ⊆ univ →
      ∫⁻ x in (fun y : Euclid P => lam⁻¹ • y) ⁻¹' R.carrier ∩ K,
        (R.mult (lam⁻¹ • x) : ℝ≥0∞) ∂μHE[k] ≠ ∞ := by
    intro K hK _ htop
    have hKc : IsCompact ((fun x : Euclid P => lam • x) ⁻¹' K) :=
      (Homeomorph.smulOfNeZero lam hlam0).isCompact_preimage.2 hK
    have h := (Submission.euclid_hausdorff_dilation_change_of_variables P k lam hlam
      ((fun y : Euclid P => lam⁻¹ • y) ⁻¹' R.carrier ∩ K)).2.1
      (fun y => (R.mult (lam⁻¹ • y) : ℝ≥0∞))
    rw [preimage_inter, hpre] at h
    simp only [inv_smul_smul₀ hlam0] at h
    rw [htop, ENNReal.mul_top hc0] at h
    exact R.locallyIntegrable_mult _ hKc (subset_univ _) h
  -- measurability: `ξ(·/λ) ∘ δ_λ = ξ`, and `Hᵏ⌞M' ≪ λ⁻ᵏ Hᵏ⌞M' = (δ_λ)_#(Hᵏ⌞M)`
  have hmeas : AEStronglyMeasurable (fun y : Euclid P => R.orient (lam⁻¹ • y))
      (μHE[k].restrict ((fun y : Euclid P => lam⁻¹ • y) ⁻¹' R.carrier)) := by
    have h : AEStronglyMeasurable (fun y : Euclid P => R.orient (lam⁻¹ • y))
        (Measure.map (fun x : Euclid P => lam • x) (μHE[k].restrict R.carrier)) := by
      rw [hT.aestronglyMeasurable_map_iff]
      have he : ((fun y : Euclid P => R.orient (lam⁻¹ • y)) ∘ fun x : Euclid P => lam • x) =
          R.orient := by
        funext x
        simp only [Function.comp_apply, inv_smul_smul₀ hlam0]
      rw [he]
      exact R.aestronglyMeasurable_orient
    rw [hcv1] at h
    exact h.mono_ac (Measure.absolutelyContinuous_smul hc0)
  -- orientation: `T_{λx}M' = TₓM` (dilation invariance, `dilation 0 λ⁻¹ = δ_λ`) and
  -- `ξ(λx/λ) = ξ(x)`, transferred from `Hᵏ⌞M`-a.e. `x` to `Hᵏ⌞M'`-a.e. `y = λx`
  have hdil : dilation (0 : Euclid P) lam⁻¹ = fun y => lam • y := by
    funext y
    simp [dilation, dilationCLM]
  have himg : (fun y : Euclid P => lam • y) '' R.carrier =
      (fun y : Euclid P => lam⁻¹ • y) ⁻¹' R.carrier := by
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      simpa only [mem_preimage, inv_smul_smul₀ hlam0] using hx
    · intro hy
      exact ⟨lam⁻¹ • y, hy, smul_inv_smul₀ hlam0 y⟩
  have hor : ∀ᵐ y ∂(μHE[k].restrict ((fun y : Euclid P => lam⁻¹ • y) ⁻¹' R.carrier)),
      ∃ Q : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt k ((fun y : Euclid P => lam⁻¹ • y) ⁻¹' R.carrier) y Q ∧
          IsUnitOrientationOf (R.orient (lam⁻¹ • y)) Q := by
    refine (Measure.ae_ennreal_smul_measure_iff hc0).1 ?_
    rw [← hcv1, hT.ae_map_iff]
    filter_upwards [R.orients] with x hx
    obtain ⟨Q, hQ, hξ⟩ := hx
    refine ⟨Q, ?_, ?_⟩
    · have h := Submission.dtc_approxTangent_dilation P k R.carrier 0 x lam⁻¹ Q
        (inv_pos.2 hlam) hQ
      rwa [hdil, himg] at h
    · rwa [inv_smul_smul₀ hlam0]
  refine ⟨{ carrier := (fun y : Euclid P => lam⁻¹ • y) ⁻¹' R.carrier
            mult := fun y => R.mult (lam⁻¹ • y)
            orient := fun y => R.orient (lam⁻¹ • y)
            measurableSet_carrier :=
              (continuous_const_smul lam⁻¹).measurable R.measurableSet_carrier
            carrier_subset := subset_univ _
            rectifiable := hrect
            measurable_mult := R.measurable_mult.comp (continuous_const_smul lam⁻¹).measurable
            mult_pos := fun y hy => R.mult_pos _ hy
            locallyIntegrable_mult := hint
            aestronglyMeasurable_orient := hmeas
            orients := hor }, fun ω => ?_⟩
  -- representation: `Y(ω) = X(η)` with `η(x) = λᵏω(λx)` (pullback test form), then change of
  -- variables with `g(y) = θ(y/λ) ⟨ω(y), ξ(y/λ)⟩`
  obtain ⟨η, hη, hηx⟩ := Submission.cmcdt_dil_pullback_testForm P k lam hlam0 ω
  rw [hXY ω η hη, hR η]
  show ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x ((η : DifferentialForm (Euclid P) k) x)
      ∂μHE[k] = ∫ y in (fun y : Euclid P => lam⁻¹ • y) ⁻¹' R.carrier,
        (R.mult (lam⁻¹ • y) : ℝ) * R.orient (lam⁻¹ • y) ((ω : DifferentialForm (Euclid P) k) y)
          ∂μHE[k]
  have h3 := hcv3 fun y => (R.mult (lam⁻¹ • y) : ℝ) *
    R.orient (lam⁻¹ • y) ((ω : DifferentialForm (Euclid P) k) y)
  simp only [inv_smul_smul₀ hlam0] at h3
  calc ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x ((η : DifferentialForm (Euclid P) k) x)
        ∂μHE[k]
      = ∫ x in R.carrier, lam ^ k * ((R.mult x : ℝ) *
          R.orient x ((ω : DifferentialForm (Euclid P) k) (lam • x))) ∂μHE[k] := by
        refine integral_congr_ae (ae_of_all _ fun x => ?_)
        simp only [hηx x, map_smul, smul_eq_mul]
        ring
    _ = lam ^ k * ∫ x in R.carrier, (R.mult x : ℝ) *
          R.orient x ((ω : DifferentialForm (Euclid P) k) (lam • x)) ∂μHE[k] :=
        integral_const_mul _ _
    _ = lam ^ k * (lam⁻¹ ^ k * ∫ y in (fun y : Euclid P => lam⁻¹ • y) ⁻¹' R.carrier,
          (R.mult (lam⁻¹ • y) : ℝ) *
            R.orient (lam⁻¹ • y) ((ω : DifferentialForm (Euclid P) k) y) ∂μHE[k]) := by
        rw [h3]
    _ = _ := by
        rw [← mul_assoc, ← mul_pow, mul_inv_cancel₀ hlam0, one_pow, one_mul]

/-- **Push-forward by the dilations `δ_λ(x) = λx` of `ℝᴾ`** (Simon Ch. 6, 2.23–2.24, used for the
changes of scale in 5.3).  `dil_k(λ, X) = δ_{λ#}X`, `δ_{λ#}X(ω) = X(δ_λ^#ω)`, is the push-forward
along the proper affine map `x ↦ 0 + (λ·id)x`; for `λ = 0` it is `X` (never used).  For `λ > 0` it
is additive, is inverted by `dil(λ⁻¹, ·)` because `(δ_λ^#ω)(x) = λᵏω(λx)`, and commutes with `∂`
(2.24(1)).  Mass scales by `λᵏ`, supports scale by `λ` and integer multiplicity is preserved; the
three children prove these for every `Y` with `Y(ω) = X(δ_λ^#ω)`. -/
theorem Submission.cmcdt_dilation_pushforward : ∀ P : ℕ, ∃ dil : ∀ k : ℕ, ℝ → GeometricCurrentOn (univ : Set (Euclid P)) k → GeometricCurrentOn (univ : Set (Euclid P)) k, ∀ (k : ℕ) (lam : ℝ), 0 < lam → (∀ X Y : GeometricCurrentOn (univ : Set (Euclid P)) k, dil k lam (X - Y) = dil k lam X - dil k lam Y) ∧ (∀ X : GeometricCurrentOn (univ : Set (Euclid P)) k, dil k lam⁻¹ (dil k lam X) = X) ∧ (∀ X : GeometricCurrentOn (univ : Set (Euclid P)) k, (dil k lam X).mass = ENNReal.ofReal (lam ^ k) * X.mass) ∧ (∀ X : GeometricCurrentOn (univ : Set (Euclid P)) k, (dil k lam X).support = (fun x => lam • x) '' X.support) ∧ (∀ X : GeometricCurrentOn (univ : Set (Euclid P)) k, IsIntegerMultiplicity X → IsIntegerMultiplicity (dil k lam X)) ∧ ∀ X : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1), (dil (k + 1) lam X).boundary = dil k lam X.boundary := by
  intro P
  classical
  -- Step 1: for `λ ≠ 0`, `x ↦ 0 + (λ·id)x = λx` is a homeomorphism, hence proper.
  have hprop : ∀ lam : ℝ, lam ≠ 0 → IsProperMap
      (fun x : Euclid P => (0 : Euclid P) + (lam • ContinuousLinearMap.id ℝ (Euclid P)) x) := by
    intro lam h
    convert (Homeomorph.smulOfNeZero (α := Euclid P) lam h).isProperMap using 1
    funext x
    simp
  -- `dil_k(λ, X) := δ_{λ#}X`; the domain `(x ↦ 0 + λx)⁻¹' univ` of `δ_{λ#}` lies in `univ`
  let D : ∀ k : ℕ, ℝ → GeometricCurrentOn (univ : Set (Euclid P)) k →
      GeometricCurrentOn (univ : Set (Euclid P)) k := fun k lam X =>
    if h : lam ≠ 0 then
      GeometricCurrentOn.affinePushforward (V := (univ : Set (Euclid P)))
        (lam • ContinuousLinearMap.id ℝ (Euclid P)) 0 (hprop lam h)
        (X.restrictDomain (subset_univ _))
    else X
  have hD : ∀ (k : ℕ) (lam : ℝ) (h : lam ≠ 0) (X : GeometricCurrentOn (univ : Set (Euclid P)) k),
      D k lam X = GeometricCurrentOn.affinePushforward (V := (univ : Set (Euclid P)))
        (lam • ContinuousLinearMap.id ℝ (Euclid P)) 0 (hprop lam h)
        (X.restrictDomain (subset_univ _)) := by
    intro k lam h X
    exact dite_eq_left h
  -- `δ_{λ#}X(ω) = X(η)` whenever `η = δ_λ^#ω`: the hypothesis of the mass, support and integer
  -- multiplicity children
  have hrel : ∀ (k : ℕ) (lam : ℝ) (h : lam ≠ 0) (X : GeometricCurrentOn (univ : Set (Euclid P)) k)
      (ω η : TestFormOn (univ : Set (Euclid P)) k),
      (η : DifferentialForm (Euclid P) k) = affinePullbackForm
        (lam • ContinuousLinearMap.id ℝ (Euclid P)) 0 (ω : DifferentialForm (Euclid P) k) →
      D k lam X ω = X η := by
    intro k lam h X ω η hη
    rw [hD k lam h X, GeometricCurrentOn.affinePushforward_apply,
      GeometricCurrentOn.restrictDomain_apply]
    congr 1
    apply Subtype.ext
    rw [testFormOnInclusion_coe, affinePullbackTestOn_coe, hη]
  refine ⟨D, fun k lam hlam => ?_⟩
  have hne : lam ≠ 0 := hlam.ne'
  have hne' : lam⁻¹ ≠ 0 := inv_ne_zero hne
  refine ⟨fun X Y => ?_, fun X => ?_, fun X => ?_, fun X => ?_, fun X hX => ?_, fun X => ?_⟩
  -- (1), step 2: linearity, since the difference of currents acts pointwise
  · apply GeometricCurrentOn.ext
    intro ω
    rw [hD k lam hne, hD k lam hne, hD k lam hne]
    rfl
  -- (2), step 3: `(δ_λ^#δ_{λ⁻¹}^#ω)(x) = λᵏ(λ⁻¹)ᵏ ω(λ⁻¹λx) = ω(x)`
  · apply GeometricCurrentOn.ext
    intro ω
    obtain ⟨η₁, hη₁, hη₁'⟩ := Submission.cmcdt_dil_pullback_testForm P k lam⁻¹ hne' ω
    obtain ⟨η₂, hη₂, hη₂'⟩ := Submission.cmcdt_dil_pullback_testForm P k lam hne η₁
    rw [hrel k lam⁻¹ hne' (D k lam X) ω η₁ hη₁, hrel k lam hne X η₁ η₂ hη₂]
    congr 1
    apply Subtype.ext
    funext x
    rw [hη₂', hη₁', smul_smul, ← mul_pow, mul_inv_cancel₀ hne, one_pow, one_smul,
      inv_smul_smul₀ hne]
  -- (3), step 5: `M(δ_{λ#}X) = λᵏ M(X)`
  · exact Submission.cmcdt_dil_mass_eq P k lam hlam X (D k lam X) (hrel k lam hne X)
  -- (4), step 6: `spt δ_{λ#}X = λ spt X`
  · exact Submission.cmcdt_dil_support_eq P k lam hlam X (D k lam X) (hrel k lam hne X)
  -- (5), step 7: `δ_{λ#}X` is integer multiplicity, represented by `(λM, θ(·/λ), ξ(·/λ))`
  · exact Submission.cmcdt_dil_isIntegerMultiplicity P k lam hlam X (D k lam X)
      (hrel k lam hne X) hX
  -- (6), step 4: `∂δ_{λ#} = δ_{λ#}∂` (2.24(1)); restricting the domain commutes with `∂` by
  -- definition
  · rw [hD (k + 1) lam hne, hD k lam hne, GeometricCurrentOn.boundary_affinePushforward]
    congr 1
/-- Integrals over a finite set against `H⁰ = μHE[0]` are finite sums (for Simon 6.8.2, `n = 0`):
`μHE[0] = μH[0]` is the counting measure, `μH[0]{x} = 1`, so `∫_F f dH⁰ = Σ_{x ∈ F} f(x)` (each
`f` is integrable on the finite union `F` of singletons) and `∫⁻_F g dH⁰ = Σ_{x ∈ F} g(x)`. -/
theorem Submission.cbrz_finset_integral_hausdorff_zero : ∀ (P : ℕ) (F : Finset (Euclid P)) (f : Euclid P → ℝ) (g : Euclid P → ℝ≥0∞), (∫ x in (F : Set (Euclid P)), f x ∂μHE[0]) = ∑ x ∈ F, f x ∧ (∫⁻ x in (F : Set (Euclid P)), g x ∂μHE[0]) = ∑ x ∈ F, g x := by
  intro P F f g
  rw [Measure.euclideanHausdorffMeasure_zero]
  constructor
  · -- `f` is integrable on each singleton `{x}`, `μH[0]{x} = 1`, hence on the finite union `F`
    have hint : IntegrableOn f (F : Set (Euclid P)) μH[0] := by
      rw [← Set.biUnion_of_singleton (F : Set (Euclid P)),
        integrableOn_finite_biUnion F.finite_toSet]
      intro x _
      exact integrableOn_singleton (by simp) (by simp [Measure.hausdorffMeasure_zero_singleton])
    rw [setIntegral_finset F hint]
    simp [measureReal_def, Measure.hausdorffMeasure_zero_singleton]
  · rw [lintegral_finset]
    simp [Measure.hausdorffMeasure_zero_singleton]
/-- Limits of weighted point sums `∑_{l < N_j} w_{j,l} g(x_{j,l})` with points in a compact `K`,
nonzero integer weights and `∑_l |w_{j,l}| ≤ C` are again such sums (the case `n = 0` of the
closure theorem, Simon 6.8.2): `N_j ≤ C` and `|w_{j,l}| ≤ C`, so a subsequence has constant count
and weights; a further subsequence has convergent points, and the limit is read off by continuity
of each `g_k`, along one subsequence for all `k`. -/
theorem Submission.cbrz_point_sum_limit : ∀ (P : ℕ) (K : Set (Euclid P)) (C : ℕ) (N : ℕ → ℕ) (w : ℕ → ℕ → ℤ) (x : ℕ → ℕ → Euclid P) (ι : Type) (g : ι → Euclid P → ℝ) (t : ι → ℝ), IsCompact K → (∀ j l, l < N j → x j l ∈ K) → (∀ j l, l < N j → w j l ≠ 0) → (∀ j, (∑ l ∈ Finset.range (N j), (w j l).natAbs) ≤ C) → (∀ k, Continuous (g k)) → (∀ k, Tendsto (fun j => ∑ l ∈ Finset.range (N j), (w j l : ℝ) * g k (x j l)) atTop (𝓝 (t k))) → ∃ (M : ℕ) (v : ℕ → ℤ) (y : ℕ → Euclid P), (∀ l < M, y l ∈ K) ∧ ∀ k, t k = ∑ l ∈ Finset.range M, (v l : ℝ) * g k (y l) := by
  intro P K C N w x ι g t hK hxK hw0 hC hg ht
  classical
  -- `|w j l| ≥ 1` for `l < N j`, so `N j ≤ C` and `|w j l| ≤ C`
  have hNC : ∀ j, N j ≤ C := by
    intro j
    calc N j = ∑ l ∈ Finset.range (N j), 1 := by simp
      _ ≤ ∑ l ∈ Finset.range (N j), (w j l).natAbs :=
          Finset.sum_le_sum fun l hl => Int.natAbs_pos.mpr (hw0 j l (Finset.mem_range.mp hl))
      _ ≤ C := hC j
  have hwC : ∀ j l, l < N j → (w j l).natAbs ≤ C := by
    intro j l hl
    calc (w j l).natAbs ≤ ∑ l' ∈ Finset.range (N j), (w j l').natAbs :=
          Finset.single_le_sum (f := fun l' => (w j l').natAbs) (fun _ _ => Nat.zero_le _)
            (Finset.mem_range.mpr hl)
      _ ≤ C := hC j
  -- the type `(N j, padded weights)` lies in a finite set, so one type occurs infinitely often
  let δ : ℕ → ℕ × (Fin C → ℤ) := fun j => (N j, fun l => if (l : ℕ) < N j then w j l else 0)
  let S : Finset (ℕ × (Fin C → ℤ)) :=
    Finset.range (C + 1) ×ˢ Fintype.piFinset fun _ => Finset.Icc (-(C : ℤ)) C
  have hδS : ∀ j, δ j ∈ S := by
    intro j
    simp only [S, δ, Finset.mem_product, Finset.mem_range, Fintype.mem_piFinset, Finset.mem_Icc]
    refine ⟨Nat.lt_succ_of_le (hNC j), fun l => ?_⟩
    split_ifs with hl
    · have := hwC j l hl
      constructor <;> omega
    · constructor <;> omega
  let δ' : ℕ → S := fun j => ⟨δ j, hδS j⟩
  obtain ⟨d, hd⟩ := Finite.exists_infinite_fiber δ'
  have hfreq : ∃ᶠ j in atTop, δ' j = d := by
    rw [Nat.frequently_atTop_iff_infinite]
    exact Set.infinite_coe_iff.mp hd
  obtain ⟨φ₁, hφ₁mono, hφ₁⟩ := extraction_of_frequently_atTop hfreq
  obtain ⟨⟨N₀, u₀⟩, hdS⟩ := d
  have hNφ : ∀ j, N (φ₁ j) = N₀ := by
    intro j
    have := congrArg (fun z : S => (z : ℕ × (Fin C → ℤ)).1) (hφ₁ j)
    simpa [δ', δ] using this
  have hwφ : ∀ j (l : Fin C), (l : ℕ) < N₀ → w (φ₁ j) l = u₀ l := by
    intro j l hl
    have := congrArg (fun z : S => (z : ℕ × (Fin C → ℤ)).2 l) (hφ₁ j)
    simp only [δ', δ] at this
    rw [hNφ j, ite_eq_left hl] at this
    exact this
  have hN₀C : N₀ ≤ C := by rw [← hNφ 0]; exact hNC _
  -- along `φ₁` the points lie in the compact `K ^ N₀`; extract a convergent subsequence
  let X : ℕ → (Fin N₀ → Euclid P) := fun j l => x (φ₁ j) l
  have hXK : ∀ j, X j ∈ Set.pi univ fun _ => K := by
    intro j l _
    exact hxK (φ₁ j) l (by rw [hNφ j]; exact l.isLt)
  obtain ⟨a, haK, φ₂, hφ₂mono, hXa⟩ :=
    (isCompact_univ_pi fun _ : Fin N₀ => hK).tendsto_subseq hXK
  refine ⟨N₀, fun l => if h : l < C then u₀ ⟨l, h⟩ else 0,
    fun l => if h : l < N₀ then a ⟨l, h⟩ else 0, ?_, ?_⟩
  · intro l hl
    simp only [dite_eq_left hl]
    exact haK ⟨l, hl⟩ (mem_univ _)
  · -- along `φ₁ ∘ φ₂` the sums tend to `t k` and, by continuity of `g k`, to `∑ u₀ l * g k (a l)`
    intro k
    have hψ : StrictMono (φ₁ ∘ φ₂) := hφ₁mono.comp hφ₂mono
    have h1 := (ht k).comp hψ.tendsto_atTop
    have h2 : Tendsto (fun j => ∑ l : Fin N₀,
        (u₀ ⟨l, lt_of_lt_of_le l.isLt hN₀C⟩ : ℝ) * g k (X (φ₂ j) l)) atTop
        (𝓝 (∑ l : Fin N₀, (u₀ ⟨l, lt_of_lt_of_le l.isLt hN₀C⟩ : ℝ) * g k (a l))) := by
      apply tendsto_finsetSum
      intro l _
      apply Tendsto.const_mul
      exact ((hg k).tendsto (a l)).comp (((continuous_apply l).tendsto a).comp hXa)
    have h3 : (fun j => ∑ l ∈ Finset.range (N (φ₁ (φ₂ j))),
        (w (φ₁ (φ₂ j)) l : ℝ) * g k (x (φ₁ (φ₂ j)) l)) =
        (fun j => ∑ l : Fin N₀,
          (u₀ ⟨l, lt_of_lt_of_le l.isLt hN₀C⟩ : ℝ) * g k (X (φ₂ j) l)) := by
      funext j
      rw [hNφ, Finset.sum_range]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [hwφ (φ₂ j) ⟨l, lt_of_lt_of_le l.isLt hN₀C⟩ l.isLt]
    have h1' : Tendsto (fun j => ∑ l : Fin N₀,
        (u₀ ⟨l, lt_of_lt_of_le l.isLt hN₀C⟩ : ℝ) * g k (X (φ₂ j) l)) atTop (𝓝 (t k)) := by
      rw [← h3]
      exact h1
    rw [tendsto_nhds_unique h1' h2, Finset.sum_range]
    refine Finset.sum_congr rfl fun l _ => ?_
    simp only [dite_eq_left (lt_of_lt_of_le l.isLt hN₀C), dite_eq_left l.isLt]

/-- A finite set `F ⊆ ℝᴾ` has approximate tangent space `⊥ = {0}` in dimension `0` at each point
`y ∈ F` (Simon Ch. 3, 1.4 with `n = 0`): if `f ∈ C_c(ℝᴾ)` vanishes off the ball of radius `R₀` and
`δ > 0` separates `y` from `F \ {y}`, then for `0 < ρ < δ / R₀` the finite blow-up `η_{y,ρ}(F)`
meets `{f ≠ 0}` at most in `η_{y,ρ}(y) = 0`, so `∫_{η_{y,ρ}(F)} f dH⁰ = f(0) = ∫_⊥ f dH⁰`. -/
theorem Submission.dmcbrz_approxTangent_finite_zero : ∀ (P : ℕ) (F : Set (Euclid P)) (y : Euclid P), F.Finite → y ∈ F → HasApproximateTangentSpaceAt 0 F y ⊥ := by
  intro P F y hF hy
  have hCI := Submission.cbrz_finset_integral_hausdorff_zero P
  refine ⟨finrank_bot ℝ (Euclid P), fun f => ?_⟩
  -- `∫_⊥ f dH⁰ = f(0)`, the carrier of `⊥` being the finite set `{0}`
  have hlim : ∫ z in ((⊥ : Submodule ℝ (Euclid P)) : Set (Euclid P)), f z ∂μHE[0] = f 0 := by
    have h := (hCI {0} f fun _ => 0).1
    rw [Finset.coe_singleton, Finset.sum_singleton] at h
    rw [Submodule.bot_coe, h]
  rw [hlim]
  -- `f` vanishes outside the open ball of radius `R₀ > 0`
  obtain ⟨R₀, hR₀, hfz⟩ : ∃ R₀ > 0, ∀ z : Euclid P, R₀ ≤ ‖z‖ → f z = 0 := by
    obtain ⟨R, hR⟩ := f.hasCompactSupport.isBounded.subset_closedBall 0
    refine ⟨max R 0 + 1, by positivity, fun z hz => image_eq_zero_of_notMem_tsupport fun hzs => ?_⟩
    have h := hR hzs
    rw [mem_closedBall, dist_zero_right] at h
    linarith [le_max_left R 0]
  -- `δ > 0` separates `y` from the finite, hence closed, set `F \ {y}`
  obtain ⟨δ, hδ, hsep⟩ : ∃ δ > 0, ∀ z ∈ F, z ≠ y → δ ≤ ‖z - y‖ := by
    obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.1 hF.sdiff.isClosed.isOpen_compl y
      (fun h => h.2 rfl : y ∉ F \ {y})
    refine ⟨δ, hδ, fun z hz hzy => not_lt.1 fun h => hball ?_ ⟨hz, hzy⟩⟩
    rwa [mem_ball, dist_eq_norm]
  -- for `0 < ρ < δ / R₀`, every point `η_{y,ρ}(z) ≠ 0` of the blow-up has norm `≥ ρ⁻¹δ > R₀`
  apply tendsto_nhds_of_eventually_eq
  filter_upwards [Ioo_mem_nhdsGT (div_pos hδ hR₀)] with ρ hρ
  have hfin : (Poincare.SimonGMT.Chapter03.blowUpMap y ρ '' F).Finite := hF.image _
  rw [← hfin.coe_toFinset, (hCI hfin.toFinset f fun _ => 0).1, Finset.sum_eq_single 0]
  · intro w hw hw0
    obtain ⟨z, hz, rfl⟩ := hfin.mem_toFinset.1 hw
    have hzy : z ≠ y := by
      rintro rfl
      exact hw0 (by simp [Poincare.SimonGMT.Chapter03.blowUpMap])
    apply hfz
    rw [Poincare.SimonGMT.Chapter03.blowUpMap, norm_smul, norm_inv, Real.norm_of_nonneg hρ.1.le,
      inv_mul_eq_div, le_div_iff₀ hρ.1, mul_comm R₀ ρ]
    exact ((lt_div_iff₀ hR₀).1 hρ.2).le.trans (hsep z hz hzy)
  · intro h0
    exact absurd (hfin.mem_toFinset.2 ⟨y, hy, by simp [Poincare.SimonGMT.Chapter03.blowUpMap]⟩) h0

/-- Degree-0 integer multiplicity currents are finite weighted point sums on compactly contained
sets (for Simon 6.8.2, `n = 0`): if `R` represents `S` and `B ⊂⊂ U`, then `M ∩ B` is a finite set
`{x_l}`, `ξ(x_l) = ±⟨·⟩`, and with `w_l = ±θ(x_l)` one has `Σ |w_l| ≤ μ_R(B)` and
`S(ω) = Σ w_l ω(x_l)` whenever `tsupport ω ⊆ B`. -/
theorem Submission.dmcbrz_imrep_zero_local_point_sum : ∀ (P : ℕ) (U B : Set (Euclid P)) (R : IMRep U 0) (S : GeometricCurrentOn U 0), R.Represents S → CompactlyContained B U → ∃ (N : ℕ) (w : ℕ → ℤ) (x : ℕ → Euclid P), (∀ l < N, x l ∈ B) ∧ (∀ l < N, w l ≠ 0) ∧ (∑ l ∈ Finset.range N, ((w l).natAbs : ℝ≥0∞)) ≤ R.measure B ∧ ∀ ω : TestFormOn U 0, tsupport (ω : DifferentialForm (Euclid P) 0) ⊆ B → S ω = ∑ l ∈ Finset.range N, (w l : ℝ) * (ω : DifferentialForm (Euclid P) 0) (x l) (fun i => i.elim0) := by
  have hCI := Submission.cbrz_finset_integral_hausdorff_zero
  intro P U B R S hRS hB
  classical
  -- Step 1: the carrier meets `closure B` in a finite set.
  have hfinK : (R.carrier ∩ closure B).Finite := by
    by_contra hinf
    have hint := R.locallyIntegrable_mult (closure B) hB.1 hB.2
    obtain ⟨n, hn⟩ := ENNReal.exists_nat_gt hint
    obtain ⟨F', hF'sub, hF'card⟩ := Set.Infinite.exists_subset_card_eq hinf n
    have h1 : (n : ℝ≥0∞) ≤ ∫⁻ x in R.carrier ∩ closure B, (R.mult x : ℝ≥0∞) ∂μHE[0] := by
      calc (n : ℝ≥0∞) = ∑ x ∈ F', (1 : ℝ≥0∞) := by simp [hF'card]
        _ ≤ ∑ x ∈ F', (R.mult x : ℝ≥0∞) := by
          apply Finset.sum_le_sum
          intro x hx
          exact Nat.one_le_cast.mpr (R.mult_pos x (hF'sub hx).1)
        _ = ∫⁻ x in (F' : Set (Euclid P)), (R.mult x : ℝ≥0∞) ∂μHE[0] :=
          ((hCI P F' (fun _ => 0) _).2).symm
        _ ≤ ∫⁻ x in R.carrier ∩ closure B, (R.mult x : ℝ≥0∞) ∂μHE[0] := lintegral_mono_set hF'sub
    exact absurd (hn.trans_le h1) (lt_irrefl _)
  -- Step 2: orientation at every carrier point, hence a sign.
  have hor : ∀ p ∈ R.carrier, ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt 0 R.carrier p Q ∧ IsUnitOrientationOf (R.orient p) Q := by
    intro p hp
    by_contra hcon
    have h := R.orients
    rw [ae_iff] at h
    have h0 : (μHE[0].restrict R.carrier) {p} = 0 :=
      measure_mono_null (fun z hz => by rw [mem_singleton_iff.mp hz]; exact hcon) h
    rw [Measure.restrict_apply (measurableSet_singleton p),
      inter_eq_left.mpr (singleton_subset_iff.mpr hp), Measure.euclideanHausdorffMeasure_zero,
      Measure.hausdorffMeasure_zero_singleton] at h0
    exact one_ne_zero h0
  have hsign : ∀ p ∈ R.carrier, ∃ s : ℤ, (s = 1 ∨ s = -1) ∧
      ∀ α : Covector (Euclid P) 0, R.orient p α = (s : ℝ) * α (fun i => i.elim0) := by
    intro p hp
    obtain ⟨Q, -, τ, -, -, hτ⟩ := hor p hp
    have hτe : τ = fun i => i.elim0 := funext fun i => i.elim0
    subst hτe
    rcases hτ with h | h
    · exact ⟨1, Or.inl rfl, fun α => by simp [h α]⟩
    · exact ⟨-1, Or.inr rfl, fun α => by simp [h α]⟩
  choose! ε hε1 hε using hsign
  -- Step 3: the finite set `G = carrier ∩ B` and its enumeration.
  have hG : (R.carrier ∩ B).Finite := hfinK.subset (inter_subset_inter_right _ subset_closure)
  set Gf := hG.toFinset with hGf
  have hGfmem : ∀ p, p ∈ Gf ↔ p ∈ R.carrier ∩ B := fun p => hG.mem_toFinset
  have hGfcoe : (Gf : Set (Euclid P)) = R.carrier ∩ B := hG.coe_toFinset
  let e : ℕ → Euclid P := fun l => if h : l < Gf.card then (Gf.equivFin.symm ⟨l, h⟩ : Euclid P) else 0
  have he : ∀ l < Gf.card, e l ∈ Gf := by
    intro l hl
    simp only [e, dite_eq_left hl]
    exact (Gf.equivFin.symm ⟨l, hl⟩).2
  have hsum : ∀ {β : Type} [AddCommMonoid β] (h : Euclid P → β),
      ∑ l ∈ Finset.range Gf.card, h (e l) = ∑ p ∈ Gf, h p := by
    intro β _ h
    rw [Finset.sum_range]
    have h' : ∀ l : Fin Gf.card, e l = (Gf.equivFin.symm l : Euclid P) := by
      intro l
      simp only [e, dite_eq_left l.isLt, Fin.eta]
    simp_rw [h']
    rw [Equiv.sum_comp Gf.equivFin.symm (fun p : Gf => h p)]
    exact Finset.sum_coe_sort Gf h
  have hnat : ∀ p ∈ R.carrier, (ε p * (R.mult p : ℤ)).natAbs = R.mult p := by
    intro p hp
    rcases hε1 p hp with h | h <;> simp [h]
  refine ⟨Gf.card, fun l => ε (e l) * (R.mult (e l) : ℤ), e, ?_, ?_, ?_, ?_⟩
  · intro l hl
    exact ((hGfmem _).mp (he l hl)).2
  · intro l hl
    have hp := ((hGfmem _).mp (he l hl)).1
    have hm := R.mult_pos _ hp
    rcases hε1 _ hp with h | h <;> simp [h] <;> omega
  · calc (∑ l ∈ Finset.range Gf.card, (((ε (e l) * (R.mult (e l) : ℤ)).natAbs : ℕ) : ℝ≥0∞))
        = ∑ p ∈ Gf, (((ε p * (R.mult p : ℤ)).natAbs : ℕ) : ℝ≥0∞) :=
          hsum (fun p => (((ε p * (R.mult p : ℤ)).natAbs : ℕ) : ℝ≥0∞))
      _ = ∑ p ∈ Gf, (R.mult p : ℝ≥0∞) := by
          refine Finset.sum_congr rfl fun p hp => ?_
          rw [hnat p ((hGfmem p).mp hp).1]
      _ = ∫⁻ x in (Gf : Set (Euclid P)), (R.mult x : ℝ≥0∞) ∂μHE[0] :=
          ((hCI P Gf (fun _ => 0) _).2).symm
      _ = R.measure (Gf : Set (Euclid P)) := by
          have hmeas : MeasurableSet (Gf : Set (Euclid P)) := Gf.finite_toSet.measurableSet
          rw [IMRep.measure, withDensity_apply _ hmeas, Measure.restrict_restrict hmeas,
            inter_eq_left.mpr (by rw [hGfcoe]; exact inter_subset_left)]
      _ ≤ R.measure B := measure_mono (by rw [hGfcoe]; exact inter_subset_right)
  · intro ω hω
    rw [hRS ω, IMRep.action]
    have hGsub : (Gf : Set (Euclid P)) ⊆ R.carrier := by rw [hGfcoe]; exact inter_subset_left
    rw [setIntegral_eq_of_subset_of_forall_sdiff_eq_zero R.measurableSet_carrier hGsub]
    · rw [(hCI P Gf _ (fun _ => 0)).1]
      symm
      rw [hsum (fun p => ((ε p * (R.mult p : ℤ) : ℤ) : ℝ) *
        (ω : DifferentialForm (Euclid P) 0) p (fun i => i.elim0))]
      refine Finset.sum_congr rfl fun p hp => ?_
      rw [hε p ((hGfmem p).mp hp).1]
      push_cast
      ring
    · intro z hz
      have hzB : z ∉ B := by
        intro hzB
        apply hz.2
        rw [hGfcoe]
        exact ⟨hz.1, hzB⟩
      have hω0 : (ω : DifferentialForm (Euclid P) 0) z = 0 :=
        image_eq_zero_of_notMem_tsupport (fun h => hzB (hω h))
      simp [hω0]
/-- A `0`-current given by a finite integer point sum, `S(ω) = Σ_{l<M} vₗ ⟨ω(yₗ)⟩` with
`⟨α⟩ = α(e)` for the empty family `e`, is integer multiplicity (for Simon 6.8.2, `n = 0`).  Group
the points, `m(p) = Σ_{yₗ = p} vₗ`, and let `G` be the finite set of the `yₗ ∈ V` with `m(yₗ) ≠ 0`
(`ω` vanishes off `spt ω ⊆ V`).  Then `S = τ(G, |m|, sign(m) ⟨·⟩)`: the action is a finite sum
over `G` (`cbrz_finset_integral_hausdorff_zero`) and `T_pG = {0}` for `p ∈ G`
(`dmcbrz_approxTangent_finite_zero`). -/
theorem Submission.dmcbrz_isIntegerMultiplicity_point_sum : ∀ (P : ℕ) (V : Set (Euclid P)) (S : GeometricCurrentOn V 0) (M : ℕ) (v : ℕ → ℤ) (y : ℕ → Euclid P), (∀ ω : TestFormOn V 0, S ω = ∑ l ∈ Finset.range M, (v l : ℝ) * (ω : DifferentialForm (Euclid P) 0) (y l) (fun i => i.elim0)) → IsIntegerMultiplicity S := by
  have hCI := Submission.cbrz_finset_integral_hausdorff_zero
  have hFT := Submission.dmcbrz_approxTangent_finite_zero
  intro P V S M v y hS
  classical
  let m : Euclid P → ℤ := fun p => ∑ l ∈ Finset.range M, if y l = p then v l else 0
  let Y : Finset (Euclid P) := (Finset.range M).image y
  let Gf : Finset (Euclid P) := Y.filter (fun p => p ∈ V ∧ m p ≠ 0)
  -- `ev α = ⟨α⟩`; `±ev` are the unit orientations of `{0}`
  let ev : MultiVector P 0 := ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (fun i => i.elim0)
  have hev : ∀ α : Covector (Euclid P) 0, ev α = α (fun i => i.elim0) := fun α => rfl
  have hGmem : ∀ p, p ∈ Gf ↔ p ∈ Y ∧ (p ∈ V ∧ m p ≠ 0) := fun p => Finset.mem_filter
  have hGfin : (Gf : Set (Euclid P)).Finite := Gf.finite_toSet
  have hGmeas : MeasurableSet (Gf : Set (Euclid P)) := hGfin.measurableSet
  -- `Σ_{l<M} vₗ f(yₗ) = Σ_{p ∈ Y} m(p) f(p)`
  have hgroup : ∀ f : Euclid P → ℝ,
      ∑ l ∈ Finset.range M, (v l : ℝ) * f (y l) = ∑ p ∈ Y, (m p : ℝ) * f p := by
    intro f
    simp only [m, Int.cast_sum, Int.cast_ite, Int.cast_zero, Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun l hl => ?_
    rw [Finset.sum_eq_single (y l)]
    · simp
    · intro p _ hp
      simp [Ne.symm hp]
    · intro h
      exact absurd (Finset.mem_image_of_mem y hl) h
  -- only the points of `G` contribute: `ω(p) = 0` for `p ∉ V`
  have hred : ∀ ω : TestFormOn V 0, S ω =
      ∑ p ∈ Gf, (m p : ℝ) * (ω : DifferentialForm (Euclid P) 0) p (fun i => i.elim0) := by
    intro ω
    rw [hS ω, hgroup (fun p => (ω : DifferentialForm (Euclid P) 0) p (fun i => i.elim0))]
    symm
    apply Finset.sum_filter_of_ne
    intro p _ hp
    refine ⟨?_, fun h0 => hp (by simp [h0])⟩
    by_contra hpV
    apply hp
    have h0 : (ω : DifferentialForm (Euclid P) 0) p = 0 :=
      image_eq_zero_of_notMem_tsupport (fun h => hpV (ω.property.2 h))
    simp [h0]
  have hm : Measurable m := by
    apply Finset.measurable_sum
    intro l _
    refine Measurable.ite ?_ measurable_const measurable_const
    have h : {a : Euclid P | y l = a} = {y l} := by
      ext a
      simp [eq_comm]
    rw [h]
    exact measurableSet_singleton _
  let sgn : Euclid P → ℝ :=
    (Gf : Set (Euclid P)).indicator (fun q => ((Int.sign (m q) : ℤ) : ℝ))
  have hsgn : Measurable sgn :=
    ((Measurable.of_discrete (f := fun z : ℤ => ((Int.sign z : ℤ) : ℝ))).comp hm).indicator hGmeas
  let R : IMRep V 0 :=
    { carrier := Gf
      mult := (Gf : Set (Euclid P)).indicator (fun p => (m p).natAbs)
      orient := fun p => sgn p • ev
      measurableSet_carrier := hGmeas
      carrier_subset := fun p hp => ((hGmem p).mp hp).2.1
      rectifiable := by
        rcases (Gf : Set (Euclid P)).eq_empty_or_nonempty with h | h
        · rw [h]
          exact Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty
        · -- a nonempty finite set is covered by countably many constant maps `ℝ⁰ → ℝᴾ`
          obtain ⟨φ, hφ⟩ := hGfin.countable.exists_eq_range h
          refine ⟨∅, measure_empty, fun j _ => φ j, fun j => ⟨0, LipschitzWith.const (φ j)⟩, ?_⟩
          intro x hx
          rw [hφ] at hx
          obtain ⟨j, rfl⟩ := hx
          exact Or.inr (mem_iUnion.mpr ⟨j, ⟨0, rfl⟩⟩)
      measurable_mult :=
        ((Measurable.of_discrete (f := fun z : ℤ => z.natAbs)).comp hm).indicator hGmeas
      mult_pos := fun p hp => by
        rw [Set.indicator_of_mem hp]
        exact Int.natAbs_pos.mpr ((hGmem p).mp hp).2.2
      locallyIntegrable_mult := fun K _ _ => by
        refine ne_top_of_le_ne_top ?_ (lintegral_mono_set inter_subset_left)
        rw [(hCI P Gf (fun _ => 0) _).2]
        exact ENNReal.sum_ne_top.mpr fun p _ => ENNReal.natCast_ne_top _
      aestronglyMeasurable_orient :=
        (hsgn.stronglyMeasurable.smul_const ev).aestronglyMeasurable
      orients := by
        refine ae_restrict_of_forall_mem hGmeas fun p hp => ?_
        refine ⟨⊥, hFT P _ p hGfin hp, fun i => i.elim0,
          ⟨fun i => i.elim0, fun i => i.elim0⟩, by simp, ?_⟩
        have hmp := ((hGmem p).mp hp).2.2
        rcases lt_or_gt_of_ne hmp with hneg | hpos
        · right
          intro α
          simp [sgn, Set.indicator_of_mem hp, Int.sign_eq_neg_one_of_neg hneg, hev]
        · left
          intro α
          simp [sgn, Set.indicator_of_mem hp, Int.sign_eq_one_of_pos hpos, hev] }
  refine ⟨R, fun ω => ?_⟩
  rw [hred ω]
  change _ = ∫ x in (Gf : Set (Euclid P)),
    (((Gf : Set (Euclid P)).indicator (fun p => (m p).natAbs) x : ℕ) : ℝ) *
      (sgn x • ev) ((ω : DifferentialForm (Euclid P) 0) x) ∂μHE[0]
  rw [(hCI P Gf _ (fun _ => 0)).1]
  -- `|m(p)| sign(m(p)) = m(p)` on `G`
  refine Finset.sum_congr rfl fun p hp => ?_
  have hpc : p ∈ (Gf : Set (Euclid P)) := Finset.mem_coe.mpr hp
  simp only [sgn, Set.indicator_of_mem hpc, _root_.smul_apply, smul_eq_mul, hev]
  have h : ((Int.sign (m p) * ((m p).natAbs : ℤ) : ℤ) : ℝ) = (m p : ℝ) := by
    rw [Int.sign_mul_natAbs]
  simp only [Int.cast_mul, Int.cast_natCast] at h
  have h' : (((m p).natAbs : ℕ) : ℝ) * ((Int.sign (m p) : ℤ) : ℝ) = (m p : ℝ) := by
    rw [mul_comm]
    exact h
  rw [← h']
  ring
/-- **An integer multiplicity triple essentially carried by a compact set moves to any domain
containing it** (step 6.6 of the localization in the proof of Simon 7.3.1; Simon 6.3.1,
chapter-06.txt lines 733–753).  If `R = (M, θ, ξ)` is an `IMRep` in `V`, `K ⊆ V ∩ U` is compact
and `Hⁿ(M \ K) = 0`, then `(M ∩ K, θ, ξ)` is an `IMRep` in `U` with the same action: `M ∩ K` and
`M` differ by the `Hⁿ`-null set `M \ K`, so `Hⁿ⌞(M ∩ K) = Hⁿ⌞M`; `∫_{M ∩ K} θ dHⁿ < ∞` since
`K ⊆ V` is compact; and `M ∩ K` has the approximate tangent planes of `M`
(`dtc_approxTangent_of_null_diff` with the open set `ℝᴾ`). -/
theorem Submission.dtc_imrep_of_null_off_compact : ∀ (P n : ℕ) (U V K : Set (Euclid P)) (R : IMRep V n), IsCompact K → K ⊆ V → K ⊆ U → μHE[n] (R.carrier \ K) = 0 → ∃ R' : IMRep U n, R'.carrier ⊆ K ∧ ∀ ω : DifferentialForm (Euclid P) n, R'.action ω = R.action ω := by
  intro P n U V K R hK hKV hKU hnull
  have hsub : R.carrier ∩ K ⊆ R.carrier := inter_subset_left
  have hdiff : R.carrier \ (R.carrier ∩ K) = R.carrier \ K := Set.sdiff_self_inter
  -- `M ∩ K =ᵐ M`: `(M ∩ K) \ M = ∅` and `M \ (M ∩ K) = M \ K` is `Hⁿ`-null.
  have hrestr : μHE[n].restrict (R.carrier ∩ K) = μHE[n].restrict R.carrier := by
    refine Measure.restrict_congr_set (ae_eq_set.2 ⟨?_, hdiff ▸ hnull⟩)
    rw [Set.sdiff_eq_empty.2 hsub]
    exact measure_empty
  refine ⟨
    { carrier := R.carrier ∩ K
      mult := R.mult
      orient := R.orient
      measurableSet_carrier := R.measurableSet_carrier.inter hK.isClosed.measurableSet
      carrier_subset := inter_subset_right.trans hKU
      rectifiable := R.rectifiable.mono hsub
      measurable_mult := R.measurable_mult
      mult_pos := fun x hx => R.mult_pos x hx.1
      -- `∫_{(M ∩ K) ∩ C} θ ≤ ∫_{M ∩ K} θ < ∞`, using only that `K ⊆ V` is compact.
      locallyIntegrable_mult := fun _ _ _ => ne_top_of_le_ne_top
        (R.locallyIntegrable_mult K hK hKV) (lintegral_mono_set inter_subset_left)
      aestronglyMeasurable_orient :=
        R.aestronglyMeasurable_orient.mono_measure (Measure.restrict_mono hsub le_rfl)
      -- a.e. on `M ∩ K`, the plane `Q` oriented by `ξ(x)` is also `Tₓ(M ∩ K)`.
      orients := (ae_restrict_of_ae_restrict_of_subset hsub R.orients).mono
        fun x ⟨Q, hQ, hξ⟩ => ⟨Q, Submission.dtc_approxTangent_of_null_diff P n R.carrier
          (R.carrier ∩ K) univ x Q hsub isOpen_univ (mem_univ x)
          (by rw [inter_univ, hdiff]; exact hnull) hQ, hξ⟩ },
    inter_subset_right, fun ω => ?_⟩
  -- the actions are integrals of the same function against the same measure
  change ∫ x in R.carrier ∩ K, (R.mult x : ℝ) * R.orient x (ω x) ∂μHE[n] =
    ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (ω x) ∂μHE[n]
  rw [hrestr]
/-- **Extension by zero** (steps 6.2–6.6 of the localization in the proof of Simon 7.3.1).  Let
`V ⊆ U` be open, `K ⊆ V` compact and `X = τ(M, θ, ξ) ∈ 𝒟ₙ(V)` with `Hⁿ(M \ K) = 0`.  Move the
representation to `U` with carrier in `K` and let `Y ∈ 𝒟ₙ(U)` be the current it defines.  Then
`Y⌞V = X`; `Y` kills every form whose support misses `K`, so `spt Y = K \ Z_Y` is a compact subset
of `K`; and if `∂X = 0`, then for a cutoff `χ ∈ C^∞_c(V)` equal to `1` near `K` we get
`∂Y(ω) = Y(dω) = X(d(χω)) = ∂X(χω) = 0`, since `d(χω) = dω` near the carrier. -/
theorem Submission.dtc_extend_by_zero : ∀ (P n : ℕ) (U V K : Set (Euclid P)) (hVU : V ⊆ U) (X : GeometricCurrentOn V n) (R : IMRep V n), IsOpen U → IsOpen V → IsCompact K → K ⊆ V → R.Represents X → μHE[n] (R.carrier \ K) = 0 → ∃ Y : GeometricCurrentOn U n, Y.restrictDomain hVU = X ∧ Y.support ⊆ K ∧ IsCompact Y.support ∧ (BoundaryVanishes X → BoundaryVanishes Y) ∧ IsIntegerMultiplicity Y := by
  intro P n U V K hVU X R hU hV hK hKV hRX hnull
  -- Step 1: move `R` to `U`, with carrier in `K` and the same action
  obtain ⟨R', hR'K, hR'R⟩ :=
    Submission.dtc_imrep_of_null_off_compact P n U V K R hK hKV (hKV.trans hVU) hnull
  -- Step 2: `Y = τ(R')`, which is integer multiplicity
  obtain ⟨Y, hY⟩ := Submission.dtc_imrep_current P n U R'
  -- Step 4: `Y` vanishes on forms whose support misses `K`
  have hvan : ∀ ω : TestFormOn U n,
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) K → Y ω = 0 := by
    intro ω hω
    rw [hY ω, IMRep.action]
    refine setIntegral_eq_zero_of_forall_eq_zero fun x hx => ?_
    rw [image_eq_zero_of_notMem_tsupport (Set.disjoint_right.mp hω (hR'K hx)), map_zero,
      mul_zero]
  -- Step 5: `spt Y ⊆ K`; a point of `U \ K` has a ball `W ⊂⊂ U \ K` on which `Y` vanishes
  have hspt : Y.support ⊆ K := by
    rintro q ⟨hqU, hqZ⟩
    by_contra hqK
    obtain ⟨r, hr, hrUK⟩ := Metric.isOpen_iff.mp (hU.sdiff hK.isClosed) q ⟨hqU, hqK⟩
    have hcl : closure (ball q (r / 2)) ⊆ ball q r :=
      closure_ball_subset_closedBall.trans (closedBall_subset_ball (half_lt_self hr))
    refine hqZ (mem_sUnion.mpr ⟨ball q (r / 2), ⟨isOpen_ball,
      (isCompact_closedBall q (r / 2)).of_isClosed_subset isClosed_closure
        closure_ball_subset_closedBall,
      hcl.trans (hrUK.trans sdiff_subset), fun ω hω => hvan ω ?_⟩, mem_ball_self (half_pos hr)⟩)
    exact disjoint_sdiff_left.mono_left (hω.trans (subset_closure.trans (hcl.trans hrUK)))
  -- Step 6: `spt Y = K \ Z_Y` is compact
  have hcpt : IsCompact Y.support := by
    have heq : Y.support = K \ Y.zeroRegion :=
      Subset.antisymm (fun x hx => ⟨hspt hx, hx.2⟩) fun x hx => ⟨hVU (hKV hx.1), hx.2⟩
    rw [heq]
    exact hK.diff Y.isOpen_zeroRegion
  -- Step 3: `Y⌞V = X`, since `R'` and `R` have the same action
  have hres : Y.restrictDomain hVU = X := by
    ext ω
    rw [GeometricCurrentOn.restrictDomain_apply, hY (testFormOnInclusion hVU n ω),
      testFormOnInclusion_coe, hR'R, hRX ω]
  refine ⟨Y, hres, hspt, hcpt, ?_, ⟨R', hY⟩⟩
  -- Step 7: `∂X = 0 → ∂Y = 0` (trivial in degree `0`)
  rcases n with _ | m
  · exact fun _ => trivial
  intro hX
  change X.boundary = 0 at hX
  change Y.boundary = 0
  -- Step 7.1: a cutoff `χ ∈ C^∞_c(V)` equal to `1` on an open set `O ⊇ K`
  obtain ⟨δ, hδ, hδV⟩ := hK.exists_cthickening_subset_open hV hKV
  obtain ⟨χ, hχ1, hχ0, -⟩ := exists_contMDiffMap_one_nhds_of_subset_interior
    (modelWithCornersSelf ℝ (Euclid P)) (n := ⊤) hK.isClosed
    ((self_subset_thickening hδ K).trans (thickening_subset_interior_cthickening δ K))
  have hχs : ContDiff ℝ (⊤ : ℕ∞) χ := contMDiff_iff_contDiff.mp χ.contMDiff
  have hχsupp : tsupport χ ⊆ cthickening δ K :=
    closure_minimal (fun x hx => by_contra fun h => hx (hχ0 x h)) isClosed_cthickening
  have hχc : HasCompactSupport χ :=
    hK.cthickening.of_isClosed_subset (isClosed_tsupport _) hχsupp
  obtain ⟨O, hO, hKO, hOχ⟩ := mem_nhdsSet_iff_exists.mp hχ1
  -- Step 7.2: `χω ∈ 𝒟^m(V)` for `ω ∈ 𝒟^m(U)`
  have hcut : ∀ ω : TestFormOn U m,
      (fun x => χ x • (ω : DifferentialForm (Euclid P) m) x) ∈ testFormOnSubmodule V m :=
    fun ω => ⟨⟨hχs.smul ω.property.1.1, hχc.smul_right⟩,
      (tsupport_smul_subset_left _ _).trans (hχsupp.trans hδV)⟩
  -- Step 7.4: `∂Y(ω) = R'(dω) = R'(d(χω)) = R(d(χω)) = X(d(χω)) = ∂X(χω) = 0`
  ext ω
  rw [GeometricCurrentOn.zero_apply, GeometricCurrentOn.boundary_apply,
    hY (exteriorDerivativeTestOn U m ω)]
  have hd : R'.action (exteriorDerivativeTestOn U m ω : DifferentialForm (Euclid P) (m + 1)) =
      R'.action (exteriorDerivativeTestOn V m ⟨_, hcut ω⟩ :
        DifferentialForm (Euclid P) (m + 1)) := by
    unfold IMRep.action
    refine setIntegral_congr_fun R'.measurableSet_carrier fun x hx => ?_
    -- Step 7.3: `χω = ω` near `x ∈ M' ⊆ K ⊆ O`, so `d(χω)(x) = dω(x)`
    have hloc : (fun y => χ y • (ω : DifferentialForm (Euclid P) m) y) =ᶠ[𝓝 x]
        (ω : DifferentialForm (Euclid P) m) :=
      Filter.eventuallyEq_of_mem (hO.mem_nhds (hKO (hR'K hx))) fun y hy => by
        rw [show χ y = 1 from hOχ hy, one_smul]
    show (R'.mult x : ℝ) * R'.orient x (extDeriv (ω : DifferentialForm (Euclid P) m) x) =
      (R'.mult x : ℝ) * R'.orient x
        (extDeriv (fun y => χ y • (ω : DifferentialForm (Euclid P) m) y) x)
    rw [hloc.extDeriv_eq]
  rw [hd, hR'R, ← hRX, ← GeometricCurrentOn.boundary_apply, hX, GeometricCurrentOn.zero_apply]
/-- **Simon 7.2 (proof), cutoff** (an extension to `ℝᴾ` supported in a compact `K ⊂ U` has no
more mass or boundary mass than its restriction to `U`).  Let `X ∈ 𝒟ₘ₊₁(U)` and
`Y ∈ 𝒟ₘ₊₁(ℝᴾ)` with `Y(ιη) = X(η)` for `η ∈ 𝒟ᵐ⁺¹(U)` and `spt Y ⊆ K`.  By Simon 6.2.11, `Y`
kills every `ω` with `spt ω ∩ K = ∅`, and so does `∂Y`, since `spt dω ⊆ spt ω`.  The cutoff
`X̂(ω) = X(ζω)`, `ζ = 1` near `K`, `spt ζ ⊆ U`, gives `M(Y) ≤ M_U(Y)` and `M(∂Y) ≤ M_U(∂Y)`.
Finally `Y`, `X` agree on test forms in `U`, and so do `∂Y`, `∂X`, because `d(ιη) = ι(dη)`;
hence `M_U(Y) = M_U(X) = M(X)` and `M_U(∂Y) = M_U(∂X) = M(∂X)`. -/
theorem Submission.cmc_fc_eu_cutoff_mass_le : ∀ (P m : ℕ) (U K : Set (Euclid P)) (X : GeometricCurrentOn U (m + 1)) (Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsOpen U → IsCompact K → K ⊆ U → Y.restrictDomain (subset_univ U) = X → Y.support ⊆ K → Y.mass ≤ X.mass ∧ Y.boundary.mass ≤ X.boundary.mass := by
  intro P m U K X Y hU hK hKU hYX hYK
  -- `Y(ω) = 0` when `spt ω ∩ K = ∅`, as `spt Y ⊆ K` (Simon 6.2.11)
  have hvan : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1),
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) K → Y ω = 0 :=
    fun ω hω => Submission.dtc_vanish_off_support P (m + 1) univ Y ω (hω.mono_right hYK)
  -- `∂Y(ω) = Y(dω) = 0` when `spt ω ∩ K = ∅`, as `spt dω ⊆ spt ω`
  have hvan' : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) K → Y.boundary ω = 0 := by
    intro ω hω
    rw [GeometricCurrentOn.boundary_apply]
    exact hvan _ (hω.mono_left (tsupport_exteriorDerivative_subset _))
  -- `Y(ιη) = X(η)`, and `∂Y(ιη) = Y(d(ιη)) = Y(ι(dη)) = X(dη) = ∂X(η)`
  have hagree : ∀ η : TestFormOn U (m + 1),
      Y (testFormOnInclusion (subset_univ U) (m + 1) η) = X η := by
    intro η
    rw [← hYX, GeometricCurrentOn.restrictDomain_apply]
  have hagree' : ∀ η : TestFormOn U m,
      Y.boundary (testFormOnInclusion (subset_univ U) m η) = X.boundary η := by
    intro η
    rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.boundary_apply,
      ← hagree (exteriorDerivativeTestOn U m η)]
    rfl
  constructor
  · -- `M(Y) ≤ M_U(Y) = M_U(X) = M(X)`
    calc Y.mass ≤ Y.massOn U :=
          Submission.lcmp_massOn_le_of_vanish_off_compact P (m + 1) univ U K Y hK hU hKU hvan univ
      _ = X.mass :=
          Submission.dtc_massOn_eq_of_agreeOn P (m + 1) univ U U (subset_univ U) Y X
            Subset.rfl fun η _ => hagree η
  · -- `M(∂Y) ≤ M_U(∂Y) = M_U(∂X) = M(∂X)`
    calc Y.boundary.mass ≤ Y.boundary.massOn U :=
          Submission.lcmp_massOn_le_of_vanish_off_compact P m univ U K Y.boundary hK hU hKU
            hvan' univ
      _ = X.boundary.mass :=
          Submission.dtc_massOn_eq_of_agreeOn P m univ U U (subset_univ U) Y.boundary X.boundary
            Subset.rfl fun η _ => hagree' η

/-- **Extension to `ℝᴾ`** (step 3(c) of the flat-convergence argument in the proof of Simon
7.2.4: a current supported in a compact `K ⊂ U` extends to `ℝᴾ` without increasing masses).  Let
`U` be open, `K ⊆ U` compact and `X = τ(M, θ, ξ) ∈ 𝒟_{m+1}(U)` with `spt X ⊆ K`.  Then
`Hⁿ(M \ K) ≤ Hⁿ(M \ spt X) = 0`, so extension by zero gives an integer multiplicity
`Y ∈ 𝒟_{m+1}(ℝᴾ)` with `Y⌞U = X` and `spt Y ⊆ K`.  For a cutoff `ζ ∈ C^∞_c(U; [0, 1])` equal to
`1` near `K` we get `Y(ω) = X(ζω)` and `∂Y(ω) = ∂X(ζω)`, with `|ζω| ≤ 1` whenever `|ω| ≤ 1`, so
`M(Y) ≤ M(X)` and `M(∂Y) ≤ M(∂X)`.  The two hypotheses (restricted representations, and mass
equal to the measure of a representation) are not needed. -/
theorem Submission.cmc_fc_extend_to_univ : (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ∀ (P m : ℕ) (U K : Set (Euclid P)) (X : GeometricCurrentOn U (m + 1)), IsOpen U → IsCompact K → K ⊆ U → IsIntegerMultiplicity X → X.support ⊆ K → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Y ∧ Y.restrictDomain (subset_univ U) = X ∧ Y.support ⊆ K ∧ Y.mass ≤ X.mass ∧ Y.boundary.mass ≤ X.boundary.mass := by
  intro _hIR _hME P m U K X hU hK hKU hX hspt
  -- Steps 1–2: a representation `R = (M, θ, ξ)` of `X` has `Hⁿ(M \ K) ≤ Hⁿ(M \ spt X) = 0`
  obtain ⟨R, hR⟩ := hX
  have hnull : μHE[m + 1] (R.carrier \ K) = 0 :=
    measure_mono_null (sdiff_subset_sdiff_right hspt)
      (Submission.imrep_carrier_sdiff_support_null P (m + 1) U X R hU hR)
  -- Steps 3–6: extension by zero to `ℝᴾ`: `Y⌞U = X`, `spt Y ⊆ K`, `Y` integer multiplicity
  obtain ⟨Y, hres, hsupp, -, -, hYIM⟩ := Submission.dtc_extend_by_zero P (m + 1) univ U K
    (subset_univ U) X R isOpen_univ hU hK hKU hR hnull
  -- Steps 7–8: the cutoff argument gives `M(Y) ≤ M(X)` and `M(∂Y) ≤ M(∂X)`
  obtain ⟨hm, hbm⟩ := Submission.cmc_fc_eu_cutoff_mass_le P m U K X Y hU hK hKU hres hsupp
  exact ⟨Y, hYIM, hres, hsupp, hm, hbm⟩

/-- **Slicing localization** (Simon Ch. 6, 4.6–4.10, and the general case of the proof of 6.2,
which cuts an integer multiplicity current at a good level by 4.5).  Assume the mass
representation (REP), the restriction (IMC)(b) and the orientation bound (IMC)(d) of integer
multiplicity representations, and slicing (SL).  Let `R ∈ 𝒟_{d+1}(U)` be integer multiplicity
with `M_W(∂R) < ∞` for every open `W ⊂⊂ U`, and `x₀ ∈ U`.  Then for some `r > 0` with
`B̄_r(x₀) ⊆ U`, `R' = R⌞B_r(x₀)` is integer multiplicity, `spt R' ⊆ B̄_r(x₀)`, `M(R') < ∞`,
`M(∂R') < ∞` and `∂R' = ∂R` on forms supported in `B_r(x₀)`.  Slice by `f = |x − x₀|`: the
integrated slice bound on `(0, r₀)` gives `r` with `M_{B_{r₀}(x₀)}(∂(R⌞B_r) − (∂R)⌞B_r) < ∞`,
and this current vanishes off the compact sphere `{f = r} ⊆ B_{r₀}(x₀)`, so its total mass is
finite. -/
theorem Submission.dtc_bc_tc_cl_bim_slice_localization : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) → (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → ∀ (P d : ℕ) (U : Set (Euclid P)) (R : GeometricCurrentOn U (d + 1)) (x₀ : Euclid P), IsOpen U → IsIntegerMultiplicity R → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → R.boundary.massOn W < ∞) → x₀ ∈ U → ∃ r : ℝ, 0 < r ∧ closedBall x₀ r ⊆ U ∧ ∃ R' : GeometricCurrentOn U (d + 1), IsIntegerMultiplicity R' ∧ R'.support ⊆ closedBall x₀ r ∧ R'.mass < ∞ ∧ R'.boundary.mass < ∞ ∧ ∀ η : TestFormOn U d, tsupport (η : DifferentialForm (Euclid P) d) ⊆ ball x₀ r → R'.boundary η = R.boundary η := by
  intro hREP hIMCb hIMCd hSL P d U R x₀ hU hRim hbd hx₀
  -- Step 0: `M_W(X) ≤ ν(W)` if `X(ω) = ∫ ⟨ω, ζ⟩ dν` and `|⟨α, ζ⟩| ≤ |α|` `ν`-a.e.
  have hmassle : ∀ {k : ℕ} (X : GeometricCurrentOn U k) (ν : Measure (Euclid P))
      (ζ : Euclid P → MultiVector P k),
      (∀ᵐ x ∂ν, ∀ α : Covector (Euclid P) k, |ζ x α| ≤ covectorEuclideanNorm α) →
      (∀ ω : TestFormOn U k, X ω = ∫ x, ζ x ((ω : DifferentialForm (Euclid P) k) x) ∂ν) →
      ∀ W : Set (Euclid P), X.massOn W ≤ ν W := by
    intro k X ν ζ hζ hrep W
    apply sSup_le
    rintro _ ⟨ω, ⟨hsupp, hnorm⟩, rfl⟩
    change ENNReal.ofReal (X ω) ≤ ν W
    rw [hrep ω]
    calc ENNReal.ofReal (∫ x, ζ x ((ω : DifferentialForm (Euclid P) k) x) ∂ν)
        ≤ ‖∫ x, ζ x ((ω : DifferentialForm (Euclid P) k) x) ∂ν‖ₑ := by
          rw [Real.enorm_eq_ofReal_abs]; exact ENNReal.ofReal_le_ofReal (le_abs_self _)
      _ ≤ ∫⁻ x, ‖ζ x ((ω : DifferentialForm (Euclid P) k) x)‖ₑ ∂ν :=
          enorm_integral_le_lintegral_enorm _
      _ ≤ ∫⁻ x, W.indicator 1 x ∂ν := by
          apply lintegral_mono_ae
          filter_upwards [hζ] with x hx
          by_cases hxW : x ∈ W
          · rw [indicator_of_mem hxW, Pi.one_apply, Real.enorm_eq_ofReal_abs]
            exact ENNReal.ofReal_le_one.mpr ((hx _).trans (hnorm x))
          · have : (ω : DifferentialForm (Euclid P) k) x = 0 :=
              image_eq_zero_of_notMem_tsupport (fun h => hxW (hsupp h))
            simp [this]
      _ ≤ ν W := lintegral_indicator_one_le W
  -- Step 1: `R(ω) = ∫ ⟨ω, ξ⟩ dμ` for the weight `μ = θ H^{d+1}⌞M` of an IMRep `(M, θ, ξ)` of `R`
  obtain ⟨R₀, hR₀⟩ := hRim
  obtain ⟨hac, haesm, hrestr⟩ := Submission.lcmp_imRep_measure_restrict P (d + 1) U R₀
  have hfin : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → R₀.measure K < ∞ := by
    intro K hK hKU
    rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
      Measure.restrict_restrict hK.measurableSet, inter_comm]
    exact lt_top_iff_ne_top.mpr (R₀.locallyIntegrable_mult K hK hKU)
  have hξb : ∀ᵐ x ∂R₀.measure, ∀ α : Covector (Euclid P) (d + 1),
      |R₀.orient x α| ≤ covectorEuclideanNorm α :=
    hac.ae_le (hIMCd P (d + 1) U R₀)
  have hRrep : ∀ ω : TestFormOn U (d + 1),
      R ω = ∫ x, R₀.orient x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂R₀.measure := by
    intro ω
    have h := (hrestr univ R₀ MeasurableSet.univ (inter_univ _).symm rfl rfl).2
      (ω : DifferentialForm (Euclid P) (d + 1))
    rw [Measure.restrict_univ] at h
    rw [hR₀ ω, h]
  -- Step 2: `∂R(η) = ∫ ⟨η, ξ'⟩ dμ'` by (REP)
  obtain ⟨μ', ξ', -, hfin', -, haesm', hξ'b, hbrep, -⟩ := hREP P d U R.boundary hU hbd
  -- Step 3: `r₀ = ε/2` with `B̄_{r₀}(x₀) ⊆ B_ε(x₀) ⊆ U`
  obtain ⟨ε, hε, hεU⟩ := Metric.isOpen_iff.mp hU x₀ hx₀
  have hr₀pos : 0 < ε / 2 := by positivity
  have hcb₀ : closedBall x₀ (ε / 2) ⊆ U := (closedBall_subset_ball (by linarith)).trans hεU
  have hfL : LipschitzWith 1 (fun x : Euclid P => dist x x₀) := LipschitzWith.dist_left x₀
  -- Step 4: slice by the 1-Lipschitz `f = |x − x₀|`, so `{f < t} = B_t(x₀)`
  obtain ⟨A, B, hA, hB, hAB, -, hint5⟩ := hSL P d U R R₀.measure μ' R₀.orient ξ'
    (fun x => dist x x₀) 1 hU hfin hfin' haesm haesm' hξb (Eventually.of_forall hξ'b) hRrep hbrep
    hfL
  have hfinball : R₀.measure (closedBall x₀ (ε / 2)) < ∞ := hfin _ (isCompact_closedBall _ _) hcb₀
  have hfinball' : μ' (closedBall x₀ (ε / 2)) < ∞ := hfin' _ (isCompact_closedBall _ _) hcb₀
  -- Step 5: a good radius, from `∫_{(0, r₀)} M_G(∂A_t − B_t) dt ≤ μ(G) < ∞`, `G = B_{r₀}(x₀)`
  obtain ⟨r, hr, hZr⟩ : ∃ r ∈ Ioo 0 (ε / 2),
      ((A r).boundary - B r).massOn (ball x₀ (ε / 2)) < ∞ := by
    by_contra hcon
    push Not at hcon
    have hlint := hint5 (ball x₀ (ε / 2)) 0 (ε / 2) isOpen_ball
    have htop : ∫⁻ t in Ioo 0 (ε / 2), ((A t).boundary - B t).massOn (ball x₀ (ε / 2)) = ∞ := by
      rw [setLIntegral_congr_fun measurableSet_Ioo (fun t ht => top_le_iff.mp (hcon t ht))]
      rw [lintegral_const, Measure.restrict_apply_univ, Real.volume_Ioo, sub_zero]
      exact ENNReal.top_mul (by simpa using hr₀pos)
    rw [htop, ENNReal.coe_one, one_mul] at hlint
    have hle : R₀.measure (ball x₀ (ε / 2) ∩ {x | 0 < dist x x₀ ∧ dist x x₀ < ε / 2}) < ∞ :=
      lt_of_le_of_lt (measure_mono (inter_subset_left.trans ball_subset_closedBall)) hfinball
    exact absurd (lt_of_le_of_lt hlint hle) (lt_irrefl _)
  -- Step 6: `Z = ∂A_r − B_r` vanishes off the compact sphere `{f = r} ⊆ G`, so `M(Z) ≤ M_G(Z)`
  set Z := (A r).boundary - B r with hZ
  have hZvan : ∀ η : TestFormOn U d,
      Disjoint (tsupport (η : DifferentialForm (Euclid P) d)) (sphere x₀ r) → Z η = 0 := by
    intro η hη
    have := hAB r η hη
    change (A r).boundary η - B r η = 0
    rw [this, sub_self]
  have hsph : sphere x₀ r ⊆ ball x₀ (ε / 2) := fun y hy => by
    rw [mem_sphere] at hy; rw [mem_ball, hy]; exact hr.2
  have hZU : Z.massOn U < ∞ :=
    lt_of_le_of_lt (Submission.lcmp_massOn_le_of_vanish_off_compact P d U (ball x₀ (ε / 2))
      (sphere x₀ r) Z (isCompact_sphere _ _) isOpen_ball hsph hZvan U) hZr
  -- Step 7: `M(B_r) ≤ μ'(B_r(x₀)) < ∞`
  have hBU : (B r).massOn U < ∞ := by
    refine lt_of_le_of_lt (hmassle (B r) (μ'.restrict (ball x₀ r)) ξ'
      (ae_restrict_of_ae (Eventually.of_forall hξ'b)) (fun η => hB r η) U) ?_
    refine lt_of_le_of_lt ?_ hfinball'
    calc μ'.restrict (ball x₀ r) U ≤ μ'.restrict (ball x₀ r) univ := measure_mono (subset_univ _)
      _ = μ' (ball x₀ r) := Measure.restrict_apply_univ _
      _ ≤ μ' (closedBall x₀ (ε / 2)) :=
          measure_mono (ball_subset_closedBall.trans (closedBall_subset_closedBall hr.2.le))
  -- Step 8: `M(∂A_r) ≤ M(B_r) + M(Z) < ∞`
  have hAbU : (A r).boundary.massOn U < ∞ := by
    refine lt_of_le_of_lt (b := (B r).massOn U + Z.massOn U) ?_ (ENNReal.add_lt_top.mpr ⟨hBU, hZU⟩)
    apply sSup_le
    rintro _ ⟨η, hη, rfl⟩
    have hsplit : (A r).boundary η = B r η + Z η := by
      change (A r).boundary η = B r η + ((A r).boundary η - B r η); ring
    change ENNReal.ofReal ((A r).boundary η) ≤ _
    rw [hsplit]
    exact ENNReal.ofReal_add_le.trans (add_le_add ((B r).le_massOn hη) (Z.le_massOn hη))
  -- Step 9: `R' = A_r` is represented by the IMRep `(M ∩ B_r(x₀), θ, ξ)` given by (IMC)(b)
  obtain ⟨A', Rr, -, hcar, hmult, hor⟩ := hIMCb P (d + 1) U R₀ (ball x₀ r) hU measurableSet_ball
  have hRrA : Rr.Represents (A r) := by
    intro ω
    rw [hA r ω]
    exact ((hrestr (ball x₀ r) Rr measurableSet_ball hcar hmult hor).2 _).symm
  -- Step 10: `M(A_r) ≤ μ(B_r(x₀)) < ∞`
  have hAU : (A r).massOn U < ∞ := by
    refine lt_of_le_of_lt (hmassle (A r) (R₀.measure.restrict (ball x₀ r)) R₀.orient
      (ae_restrict_of_ae hξb) (fun ω => hA r ω) U) ?_
    refine lt_of_le_of_lt ?_ hfinball
    calc R₀.measure.restrict (ball x₀ r) U ≤ R₀.measure.restrict (ball x₀ r) univ :=
          measure_mono (subset_univ _)
      _ = R₀.measure (ball x₀ r) := Measure.restrict_apply_univ _
      _ ≤ R₀.measure (closedBall x₀ (ε / 2)) :=
          measure_mono (ball_subset_closedBall.trans (closedBall_subset_closedBall hr.2.le))
  -- Step 11: `A_r` vanishes on a ball around each `y ∈ U ∖ B̄_r(x₀)`, so `spt A_r ⊆ B̄_r(x₀)`
  have hspt : (A r).support ⊆ closedBall x₀ r := by
    intro y hy
    by_contra hyc
    apply hy.2
    have hopen : IsOpen (U \ closedBall x₀ r) := hU.sdiff isClosed_closedBall
    obtain ⟨δ, hδ, hδsub⟩ := Metric.isOpen_iff.mp hopen y ⟨hy.1, hyc⟩
    refine mem_sUnion.mpr ⟨ball y (δ / 2), ⟨isOpen_ball, ?_, ?_, ?_⟩, mem_ball_self (by positivity)⟩
    · exact (isCompact_closedBall y (δ / 2)).of_isClosed_subset isClosed_closure
        closure_ball_subset_closedBall
    · exact closure_ball_subset_closedBall.trans
        ((closedBall_subset_ball (by linarith)).trans (hδsub.trans sdiff_subset))
    · intro ω hω
      rw [hA r ω]
      apply setIntegral_eq_zero_of_forall_eq_zero
      intro x hx
      have hxt : x ∉ tsupport (ω : DifferentialForm (Euclid P) (d + 1)) := by
        intro hxt
        have h1 : x ∈ U \ closedBall x₀ r :=
          hδsub (ball_subset_ball (by linarith) (hω hxt))
        exact h1.2 (ball_subset_closedBall (mem_ball.mpr hx))
      rw [image_eq_zero_of_notMem_tsupport hxt, map_zero]
  -- Steps 12–13: for `spt η ⊆ B_r(x₀)`, `∂A_r(η) = B_r(η) = ∫ ⟨η, ξ'⟩ dμ' = ∂R(η)`
  refine ⟨r, hr.1, (closedBall_subset_closedBall hr.2.le).trans hcb₀, A r, ⟨Rr, hRrA⟩, hspt,
    hAU, hAbU, ?_⟩
  intro η hη
  have hdisj : Disjoint (tsupport (η : DifferentialForm (Euclid P) d)) (sphere x₀ r) := by
    refine Set.disjoint_left.mpr fun y hy hys => ?_
    have h1 := hη hy
    rw [mem_ball] at h1; rw [mem_sphere] at hys
    linarith
  rw [hAB r η hdisj, hB r η, hbrep η]
  apply setIntegral_eq_integral_of_forall_compl_eq_zero
  intro x hx
  have : (η : DifferentialForm (Euclid P) d) x = 0 :=
    image_eq_zero_of_notMem_tsupport (fun h => hx (hη h))
  rw [this, map_zero]
/-- **Riesz representation of locally bounded functionals on `C_c(X, ℝ^d)`** (Simon Ch. 1, 4.14,
in the form used for currents in Ch. 6, 2.7).  If `X` is locally compact Hausdorff and second
countable and `L : C_c(X, ℝ^d) → ℝ` is linear with `|L g| ≤ M_K` whenever `spt g ⊆ K` and
`|g| ≤ 1`, then `L g = ∫ ⟨g, ν⟩ dμ₀` for a Borel measure `μ₀` finite on compact sets and a
measurable `ν : X → ℝ^d` integrable on compact sets.  The coordinate functionals
`Λᵢ f = L(f eᵢ)` are locally bounded, each splits as a difference `Pᵢ − Nᵢ` of positive
functionals (total variation), the Riesz–Markov–Kakutani measures of all `Pᵢ, Nᵢ` have densities
`ρᵢ` against one common `μ₀`, and `ν = Σᵢ ρᵢ eᵢ`. -/
theorem Submission.cmr_vector_riesz_representation : ∀ (X : Type) [TopologicalSpace X] [T2Space X] [LocallyCompactSpace X] [SecondCountableTopology X] [MeasurableSpace X] [BorelSpace X] (d : ℕ) (L : CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d)) →ₗ[ℝ] ℝ), (∀ K : Set X, IsCompact K → ∃ M : ℝ, ∀ g : CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d)), tsupport g ⊆ K → (∀ x, ‖g x‖ ≤ 1) → |L g| ≤ M) → ∃ (μ₀ : Measure X) (ν : X → EuclideanSpace ℝ (Fin d)), IsFiniteMeasureOnCompacts μ₀ ∧ Measurable ν ∧ (∀ K : Set X, IsCompact K → IntegrableOn ν K μ₀) ∧ ∀ g : CompactlySupportedContinuousMap X (EuclideanSpace ℝ (Fin d)), L g = ∫ x, inner ℝ (g x) (ν x) ∂μ₀ := by
  intro X _ _ _ _ _ _ d L hL
  -- step 1: the coordinate functionals `Λᵢ f = L(f eᵢ)`, locally bounded
  choose Λ hΛL hΛbd using Submission.cmr_vr_coordinate_functional X d L hL
  -- steps 2–3: Jordan decomposition `Λᵢ = Pᵢ − Nᵢ` into positive functionals
  choose Pos Neg hΛ using fun i => Submission.cmr_vr_jordan_decomposition X (Λ i) (hΛbd i)
  -- steps 4–6 and 8: one measure `μ₀` with `Pᵢ f − Nᵢ f = ∫ f ρᵢ dμ₀`
  obtain ⟨μ₀, ρ, hμ₀, hρm, hρint, hρ⟩ := Submission.cmr_vr_common_density X d Pos Neg
  -- steps 7 and 9: `ν = Σᵢ ρᵢ eᵢ` and `L g = Σᵢ ∫ gᵢ ρᵢ dμ₀ = ∫ ⟨g, ν⟩ dμ₀`
  obtain ⟨ν, hνm, hνint, hν⟩ := Submission.cmr_vr_coordinate_assembly X d L μ₀ ρ hρm hρint
    fun i f g hg => by rw [hΛL i f g hg, hΛ i f, hρ i f]
  exact ⟨μ₀, ν, hμ₀, hνm, hνint, hν⟩
/-- **Cutoff defect estimate** (Simon Ch. 6, 4.11: `T(γ∘f dω) − T(d(γ∘f ω)) = −T(d(γ∘f) ∧ ω)`,
used where `∂S = 0`).  Let `S = τ(M, θ, ξ)` be an integer multiplicity `(m + 1)`-current in `U`
with `∂S(ω) = 0` for every `ω ∈ 𝒟ᵐ(U)` with `spt ω ⊆ V`, let `g` be `C^∞` with `spt g ⊆ U ∩ V`
and let `β ∈ 𝒟ᵐ(ℝᴾ)`.  Then `|∫_M g θ ⟨dβ, ξ⟩ dHⁿ| ≤ ∫ ‖Dg‖ |β| dμ`, `μ = θ Hⁿ⌞M`.  Indeed
`gβ ∈ 𝒟ᵐ(U)` with `spt (gβ) ⊆ V`, so `0 = ∂S(gβ) = ∫_M θ ⟨d(gβ), ξ⟩ dHⁿ`; by the Leibniz rule
`d(gβ) = g dβ + dg ∧ β`, hence `∫_M g θ ⟨dβ, ξ⟩ dHⁿ = −∫_M θ ⟨dg ∧ β, ξ⟩ dHⁿ`, and
`|⟨dg ∧ β, ξ⟩| ≤ |dg ∧ β| ≤ ‖Dg‖ |β|` `Hⁿ`-a.e. on `M`. -/
theorem Submission.dtc_bc_tc_rs_cutoff_defect : ∀ (P m : ℕ) (U V : Set (Euclid P)) (S : GeometricCurrentOn U (m + 1)) (Rp : IMRep U (m + 1)) (g : Euclid P → ℝ) (β : TestFormOn (univ : Set (Euclid P)) m), Rp.Represents S → (∀ ω : TestFormOn U m, tsupport (ω : DifferentialForm (Euclid P) m) ⊆ V → S.boundary ω = 0) → ContDiff ℝ (⊤ : ℕ∞) g → tsupport g ⊆ U → tsupport g ⊆ V → ENNReal.ofReal |∫ x in Rp.carrier, g x * ((Rp.mult x : ℝ) * Rp.orient x (exteriorDerivative (β : DifferentialForm (Euclid P) m) x)) ∂μHE[m + 1]| ≤ ∫⁻ x, ENNReal.ofReal (‖fderiv ℝ g x‖ * covectorEuclideanNorm ((β : DifferentialForm (Euclid P) m) x)) ∂Rp.measure := by
  intro P m U V S Rp g β hRep hbd hg hgU hgV
  set b : DifferentialForm (Euclid P) m := (β : DifferentialForm (Euclid P) m)
  have hbT : IsTestForm b := β.property.1
  have hbs : ContDiff ℝ (⊤ : ℕ∞) b := hbT.1
  /- Step 1: `gβ` is a test form in `U` with `spt (gβ) ⊆ spt g ⊆ V` (supports compared
  pointwise). -/
  have hgbs : ContDiff ℝ (⊤ : ℕ∞) (fun y => g y • b y) := hg.smul hbs
  have hgb_b : support (fun y => g y • b y) ⊆ support b := by
    intro y hy
    rw [mem_support] at hy ⊢
    intro h
    exact hy (by rw [h, smul_zero])
  have hgb_g : support (fun y => g y • b y) ⊆ support g := by
    intro y hy
    rw [mem_support] at hy ⊢
    intro h
    exact hy (by rw [h, zero_smul])
  have hgbT : IsTestForm (fun y => g y • b y) := ⟨hgbs, hbT.2.mono hgb_b⟩
  have hgb_tsupp : tsupport (fun y => g y • b y) ⊆ tsupport g := closure_mono hgb_g
  let ω : TestFormOn U m := ⟨fun y => g y • b y, hgbT, hgb_tsupp.trans hgU⟩
  /- Step 2: `0 = ∂S(gβ) = S(d(gβ)) = ∫_M θ ⟨d(gβ), ξ⟩ dHⁿ`. -/
  have h0 := hbd ω (hgb_tsupp.trans hgV)
  rw [GeometricCurrentOn.boundary_apply, hRep] at h0
  have h1 : ∫ x in Rp.carrier, (Rp.mult x : ℝ) *
      Rp.orient x (exteriorDerivative (fun y => g y • b y) x) ∂μHE[m + 1] = 0 := h0
  /- Step 3: Leibniz rule `d(gβ) = g dβ + A`, `A = dg ∧ β`, paired with `θ ξ`. -/
  have hgd : Differentiable ℝ g := hg.differentiable (by simp)
  have hbd' : Differentiable ℝ b := hbs.differentiable (by simp)
  set A : Euclid P → Covector (Euclid P) (m + 1) := fun x =>
    ContinuousAlternatingMap.alternatizeUncurryFin ((fderiv ℝ g x).smulRight (b x))
  have hsplit : ∀ x, (Rp.mult x : ℝ) * Rp.orient x (exteriorDerivative (fun y => g y • b y) x) =
      (Rp.mult x : ℝ) * Rp.orient x (g x • exteriorDerivative b x) +
        (Rp.mult x : ℝ) * Rp.orient x (A x) := by
    intro x
    rw [Submission.cmcs_cd_extDeriv_smul_leibniz P m g b x (hgd x) (hbd' x), map_add, mul_add]
  /- Step 4: integrability of the pairings with `g dβ` and `d(gβ)` (continuous, compactly
  supported in `U`), hence of their difference, the pairing with `A`. -/
  have hdbT : IsTestForm (exteriorDerivative b) := exteriorDerivative_isTestForm hbT
  have hdbs : ContDiff ℝ (⊤ : ℕ∞) (exteriorDerivative b) := hdbT.1
  have hF_db : support (fun x => g x • exteriorDerivative b x) ⊆
      support (exteriorDerivative b) := by
    intro y hy
    rw [mem_support] at hy ⊢
    intro h
    exact hy (by rw [h, smul_zero])
  have hF_g : support (fun x => g x • exteriorDerivative b x) ⊆ support g := by
    intro y hy
    rw [mem_support] at hy ⊢
    intro h
    exact hy (by rw [h, zero_smul])
  have hI₁ : Integrable (fun x => (Rp.mult x : ℝ) * Rp.orient x (g x • exteriorDerivative b x))
      (μHE[m + 1].restrict Rp.carrier) :=
    Submission.dpfir_imrep_pairing_continuous_integrable P (m + 1) U Rp _
      (hg.continuous.smul hdbs.continuous) (hdbT.2.mono hF_db) ((closure_mono hF_g).trans hgU)
  have hdgbT : IsTestForm (exteriorDerivative (fun y => g y • b y)) :=
    exteriorDerivative_isTestForm hgbT
  have hdgbs : ContDiff ℝ (⊤ : ℕ∞) (exteriorDerivative (fun y => g y • b y)) := hdgbT.1
  have hI₀ : Integrable (fun x => (Rp.mult x : ℝ) *
      Rp.orient x (exteriorDerivative (fun y => g y • b y) x)) (μHE[m + 1].restrict Rp.carrier) :=
    Submission.dpfir_imrep_pairing_continuous_integrable P (m + 1) U Rp _ hdgbs.continuous
      hdgbT.2 ((tsupport_exteriorDerivative_subset _).trans (hgb_tsupp.trans hgU))
  have hI₂ : Integrable (fun x => (Rp.mult x : ℝ) * Rp.orient x (A x))
      (μHE[m + 1].restrict Rp.carrier) := by
    refine (hI₀.sub hI₁).congr (Eventually.of_forall fun x => ?_)
    simp only [Pi.sub_apply]
    rw [hsplit x]
    ring
  /- Step 5: `∫_M g θ ⟨dβ, ξ⟩ dHⁿ = −∫_M θ ⟨A, ξ⟩ dHⁿ`. -/
  have hint : ∫ x in Rp.carrier, (Rp.mult x : ℝ) *
      Rp.orient x (exteriorDerivative (fun y => g y • b y) x) ∂μHE[m + 1] =
      (∫ x in Rp.carrier, (Rp.mult x : ℝ) * Rp.orient x (g x • exteriorDerivative b x)
        ∂μHE[m + 1]) + ∫ x in Rp.carrier, (Rp.mult x : ℝ) * Rp.orient x (A x) ∂μHE[m + 1] := by
    rw [← integral_add hI₁ hI₂]
    exact integral_congr_ae (Eventually.of_forall hsplit)
  have hlhs : ∫ x in Rp.carrier, g x * ((Rp.mult x : ℝ) * Rp.orient x (exteriorDerivative b x))
      ∂μHE[m + 1] =
      ∫ x in Rp.carrier, (Rp.mult x : ℝ) * Rp.orient x (g x • exteriorDerivative b x)
        ∂μHE[m + 1] := by
    refine integral_congr_ae (Eventually.of_forall fun x => ?_)
    simp only
    rw [map_smul, smul_eq_mul]
    ring
  have key : ∫ x in Rp.carrier, g x * ((Rp.mult x : ℝ) * Rp.orient x (exteriorDerivative b x))
      ∂μHE[m + 1] = -∫ x in Rp.carrier, (Rp.mult x : ℝ) * Rp.orient x (A x) ∂μHE[m + 1] := by
    rw [hlhs]
    linarith [h1, hint]
  /- Steps 6–8: `‖∫ f‖ₑ ≤ ∫⁻ ‖f‖ₑ`; `|θ ⟨A, ξ⟩| ≤ θ |A| ≤ θ ‖Dg‖ |β|` `Hⁿ`-a.e. on `M` (orientation
  bound and wedge-norm bound); and `∫⁻ θ φ dHⁿ⌞M = ∫⁻ φ dμ` for `μ = (Hⁿ⌞M).withDensity θ`. -/
  have hθm : Measurable fun x => (Rp.mult x : ℝ≥0∞) := measurable_from_nat.comp Rp.measurable_mult
  rw [key, abs_neg]
  calc ENNReal.ofReal |∫ x in Rp.carrier, (Rp.mult x : ℝ) * Rp.orient x (A x) ∂μHE[m + 1]|
      = ‖∫ x in Rp.carrier, (Rp.mult x : ℝ) * Rp.orient x (A x) ∂μHE[m + 1]‖ₑ :=
        (Real.enorm_eq_ofReal_abs _).symm
    _ ≤ ∫⁻ x in Rp.carrier, ‖(Rp.mult x : ℝ) * Rp.orient x (A x)‖ₑ ∂μHE[m + 1] :=
        enorm_integral_le_lintegral_enorm _
    _ ≤ ∫⁻ x in Rp.carrier, (Rp.mult x : ℝ≥0∞) *
          ENNReal.ofReal (‖fderiv ℝ g x‖ * covectorEuclideanNorm (b x)) ∂μHE[m + 1] := by
        refine lintegral_mono_ae ?_
        filter_upwards [Submission.cmc_imRep_locality_restrict_sub.2.2.2 P (m + 1) U Rp] with x hx
        rw [Real.enorm_eq_ofReal_abs, ← ENNReal.ofReal_natCast,
          ← ENNReal.ofReal_mul (Nat.cast_nonneg _)]
        refine ENNReal.ofReal_le_ofReal ?_
        rw [abs_mul, Nat.abs_cast]
        exact mul_le_mul_of_nonneg_left
          ((hx (A x)).trans (Submission.cmcs_wedge_norm_le P m (fderiv ℝ g x) (b x)))
          (Nat.cast_nonneg _)
    _ = ∫⁻ x, ENNReal.ofReal (‖fderiv ℝ g x‖ * covectorEuclideanNorm (b x)) ∂Rp.measure := by
        rw [IMRep.measure, lintegral_withDensity_eq_lintegral_mul_non_measurable _ hθm
          (Eventually.of_forall fun x => ENNReal.natCast_lt_top _)]
        rfl
/-- **Simon 7.5** (codimension one, oriented normal frame): for a unit vector `ν ∈ ℝ^{n+1}`,
`n ≥ 1`, some orthonormal basis `σ` of `ν^⊥` has `det[ν, σ] = −1`, where `[ν, σ]` is the matrix
with columns `ν, σ₀, …, σₙ₋₁`.  For an orthonormal basis `τ` of `ν^⊥`, `W = [ν, τ]` has
orthonormal columns, so `WᵀW = 1` and `d = det W` has `d² = 1`; `σ` replaces `τ₀` by `−d τ₀`,
which keeps the frame orthonormal with the same span and gives `det[ν, σ] = −d² = −1`. -/
theorem Submission.codim1_lur_no_oriented_normal_frame : ∀ (n : ℕ) (ν : Euclid (n + 1)), 1 ≤ n → ‖ν‖ = 1 → ∃ σ : Fin n → Euclid (n + 1), Orthonormal ℝ σ ∧ Submodule.span ℝ (Set.range σ) = (Submodule.span ℝ {ν})ᗮ ∧ Matrix.det (Matrix.of fun r c : Fin (n + 1) => (Fin.cons ν σ : Fin (n + 1) → Euclid (n + 1)) c r) = -1 := by
  intro n ν hn hν
  -- `Q = ν^⊥` has dimension `n`
  have hν0 : ν ≠ 0 := by
    rintro rfl
    simp at hν
  have : Fact (Module.finrank ℝ (Euclid (n + 1)) = n + 1) := ⟨finrank_euclideanSpace_fin⟩
  have hQn : Module.finrank ℝ (Submodule.span ℝ {ν})ᗮ = n :=
    Submodule.finrank_orthogonal_span_singleton hν0
  -- an orthonormal basis `τ` of `Q` indexed by `Fin n`: it spans `Q` and is orthogonal to `ν`
  let b : OrthonormalBasis (Fin n) ℝ (Submodule.span ℝ {ν})ᗮ :=
    (stdOrthonormalBasis ℝ (Submodule.span ℝ {ν})ᗮ).reindex (finCongr hQn)
  let τ : Fin n → Euclid (n + 1) := fun k => (b k : Euclid (n + 1))
  have hτo : Orthonormal ℝ τ :=
    b.orthonormal.comp_linearIsometry (Submodule.span ℝ {ν})ᗮ.subtypeₗᵢ
  have hτs : Submodule.span ℝ (Set.range τ) = (Submodule.span ℝ {ν})ᗮ := by
    have hr : Set.range τ = (Submodule.span ℝ {ν})ᗮ.subtype '' Set.range b := by
      rw [← Set.range_comp]
      rfl
    have hb : Submodule.span ℝ (Set.range b) = ⊤ := by
      rw [← b.coe_toBasis]
      exact b.toBasis.span_eq
    rw [hr, Submodule.span_image, hb, Submodule.map_top, Submodule.range_subtype]
  have hτν : ∀ k, inner ℝ ν (τ k) = 0 := fun k =>
    Submodule.mem_orthogonal_singleton_iff_inner_right.mp (b k).2
  -- `u = (ν, τ₀, …, τₙ₋₁)` is orthonormal
  let u : Fin (n + 1) → Euclid (n + 1) := Fin.cons ν τ
  have hu : Orthonormal ℝ u := by
    rw [orthonormal_iff_ite]
    intro i j
    induction i using Fin.cases with
    | zero =>
      induction j using Fin.cases with
      | zero => simp [u, hν]
      | succ j => simp [u, hτν, (Fin.succ_ne_zero j).symm]
    | succ i =>
      induction j using Fin.cases with
      | zero => simp [u, real_inner_comm, hτν, Fin.succ_ne_zero]
      | succ j => simp [u, (orthonormal_iff_ite.mp hτo) i j]
  -- `W = [ν, τ]` has `WᵀW = 1`, so `d = det W` satisfies `d * d = 1`
  let W : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ := Matrix.of fun r c => u c r
  have hWW : W.transpose * W = 1 := by
    ext c c'
    rw [Matrix.mul_apply, Matrix.one_apply, ← (orthonormal_iff_ite.mp hu) c c']
    simp [W, PiLp.inner_apply, mul_comm]
  set d := W.det with hd_def
  have hd : d * d = 1 := by
    calc d * d = (W.transpose * W).det := by rw [Matrix.det_mul, Matrix.det_transpose]
      _ = 1 := by rw [hWW, Matrix.det_one]
  -- `σ` replaces `τ i₀` by `(-d) • τ i₀` (`i₀ = 0`, as `n ≥ 1`)
  let i0 : Fin n := ⟨0, hn⟩
  let σ : Fin n → Euclid (n + 1) := Function.update τ i0 ((-d) • τ i0)
  have hσo : Orthonormal ℝ σ := by
    rw [orthonormal_iff_ite]
    intro i j
    have hτ := orthonormal_iff_ite.mp hτo
    by_cases hi : i = i0 <;> by_cases hj : j = i0
    · subst hi hj
      simp only [σ, Function.update_self, real_inner_smul_left, real_inner_smul_right, hτ,
        ↓reduceIte, mul_one]
      linear_combination hd
    · subst hi
      simp [σ, real_inner_smul_left, Function.update_of_ne hj, hτ, Ne.symm hj]
    · subst hj
      simp [σ, real_inner_smul_right, hτ, hi]
    · simp [σ, Function.update_of_ne hi, Function.update_of_ne hj, hτ]
  have hσs : Submodule.span ℝ (Set.range σ) = Submodule.span ℝ (Set.range τ) := by
    apply le_antisymm
    · rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      by_cases hi : i = i0
      · subst hi
        simp only [σ, Function.update_self]
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i0, rfl⟩)
      · simp only [σ, Function.update_of_ne hi]
        exact Submodule.subset_span ⟨i, rfl⟩
    · rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      by_cases hi : i = i0
      · subst hi
        have h : τ i0 = (-d) • σ i0 := by
          simp only [σ, Function.update_self, smul_smul, neg_mul_neg, hd, one_smul]
        rw [h]
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i0, rfl⟩)
      · have h : τ i = σ i := by simp only [σ, Function.update_of_ne hi]
        rw [h]
        exact Submodule.subset_span ⟨i, rfl⟩
  refine ⟨σ, hσo, hσs.trans hτs, ?_⟩
  -- `[ν, σ]` is `W` with column `i₀ + 1` multiplied by `-d`, so its determinant is `-d * d`
  have hM : (Matrix.of fun r c : Fin (n + 1) => (Fin.cons ν σ : Fin (n + 1) → Euclid (n + 1)) c r)
      = W.updateCol i0.succ ((-d) • fun r => W r i0.succ) := by
    ext r c
    simp only [σ, Fin.cons_update, Matrix.of_apply, Matrix.updateCol_apply, Function.update_apply,
      W, u]
    split_ifs with h
    · subst h
      simp
    · rfl
  rw [hM, Matrix.det_updateCol_smul, Matrix.updateCol_eq_self, ← hd_def, neg_mul, hd]
/-- **An `n`-covector on `ℝ^{n+1}` is a determinant with first column `φ_β`** (linear algebra
for the normal orientation of `T = ∂[[E]]`, Simon §7.5).  With `b_j = β(e ∘ j.succAbove)` and
`φ_β = ∑ⱼ (-1)ʲ b_j e_j`, `β a = det[φ_β, a]`, the matrix with columns `φ_β, a₀, …, a_{n-1}`.
Both sides are alternating in `a`, so it suffices to compare them on injective basis tuples
`e ∘ v` (`Module.Basis.ext_alternating`).  An injective `v` misses an index `m` and equals
`m.succAbove ∘ σ` for a permutation `σ`, so both sides acquire the factor `sign σ`.  At the
sorted tuple `e ∘ m.succAbove` only the column term `j = m` survives (for `j ≠ m`, `e_j` is
repeated), and `det[e_m, e ∘ m.succAbove] = sign (cycleRange m)⁻¹ = (-1)ᵐ`, so both sides equal
`(-1)ᵐ (-1)ᵐ b_m = b_m`. -/
theorem Submission.codim1_lur_no_covector_eq_det_cons : ∀ (n : ℕ) (β : Covector (Euclid (n + 1)) n) (a : Fin n → Euclid (n + 1)), β a = Matrix.det (Matrix.of fun r c : Fin (n + 1) => (Fin.cons (∑ j : Fin (n + 1), ((-1 : ℝ) ^ (j : ℕ) * β (fun k => EuclideanSpace.single (j.succAbove k) (1 : ℝ))) • EuclideanSpace.single j (1 : ℝ)) a : Fin (n + 1) → Euclid (n + 1)) c r) := by
  intro n β a
  -- the standard basis `e` of `ℝ^{n+1}`, `e j = EuclideanSpace.single j 1`
  set e : Module.Basis (Fin (n + 1)) ℝ (Euclid (n + 1)) :=
    (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis with he_def
  have he : ∀ j, e j = EuclideanSpace.single j (1 : ℝ) := fun j => by
    rw [he_def, OrthonormalBasis.coe_toBasis, EuclideanSpace.basisFun_apply]
  set φ : Euclid (n + 1) := ∑ j : Fin (n + 1), ((-1 : ℝ) ^ (j : ℕ) *
    β (fun k => EuclideanSpace.single (j.succAbove k) (1 : ℝ))) • EuclideanSpace.single j (1 : ℝ)
    with hφ
  -- Step 0: the matrix determinant is `e.det` of the column family `[φ, a]`
  have hdet : ∀ w : Fin (n + 1) → Euclid (n + 1),
      Matrix.det (Matrix.of fun r c : Fin (n + 1) => w c r) = e.det w := by
    intro w
    rw [Module.Basis.det_apply]
    congr 1
  rw [hdet]
  -- Step 1: both sides are alternating in `a`; compare `β` with `e.det.curryLeft φ`
  suffices hFG : β.toAlternatingMap = e.det.curryLeft φ from DFunLike.congr_fun hFG a
  refine Module.Basis.ext_alternating e fun v hv => ?_
  -- Step 2: an injective `v` misses some index `m`
  obtain ⟨m, hm⟩ : ∃ m : Fin (n + 1), ∀ l, v l ≠ m := by
    by_contra h
    have hs : Function.Surjective v := fun m => by
      by_contra hm
      exact h ⟨m, fun l hl => hm ⟨l, hl⟩⟩
    have := Fintype.card_le_of_surjective v hs
    simp at this
  -- `v = m.succAbove ∘ σ` for a permutation `σ` of `Fin n`
  choose ρ hρ using fun l => Fin.exists_succAbove_eq (hm l)
  have hρinj : Function.Injective ρ := fun l l' h => hv (by rw [← hρ l, ← hρ l', h])
  set σ : Equiv.Perm (Fin n) := Equiv.ofBijective ρ (Finite.injective_iff_bijective.mp hρinj)
  have hvσ : (fun i => e (v i)) = (fun k => e (m.succAbove k)) ∘ σ := by
    funext i
    simp [σ, hρ]
  -- both sides change by `sign σ`
  rw [hvσ, AlternatingMap.map_perm, AlternatingMap.map_perm]
  congr 1
  -- Step 3: the sorted tuple `e ∘ m.succAbove`; only the column term `j = m` survives
  have hcol : ∀ j : Fin (n + 1), e.det.curryLeft (e j) (fun k => e (m.succAbove k)) =
      if j = m then (-1 : ℝ) ^ (m : ℕ) else 0 := by
    intro j
    rw [AlternatingMap.curryLeft_apply_apply]
    split_ifs with hjm
    · subst hjm
      have hcyc : (Matrix.vecCons (e j) fun k => e (j.succAbove k)) = e ∘ ⇑j.cycleRange.symm := by
        funext i
        refine Fin.cases ?_ (fun k => ?_) i <;> simp
      rw [hcyc, AlternatingMap.map_perm, Module.Basis.det_self, Equiv.Perm.sign_symm,
        Fin.sign_cycleRange]
      simp [Units.smul_def]
    · obtain ⟨l, hl⟩ := Fin.exists_succAbove_eq hjm
      refine AlternatingMap.map_eq_zero_of_eq _ _ (i := 0) (j := l.succ) ?_ (Fin.succ_ne_zero l).symm
      simp [hl]
  have hφe : φ = ∑ j : Fin (n + 1), ((-1 : ℝ) ^ (j : ℕ) *
      β (fun k => EuclideanSpace.single (j.succAbove k) (1 : ℝ))) • e j := by
    simp only [hφ, he]
  -- evaluation at a tuple is additive
  have hsum : ∀ (g : Fin (n + 1) → Euclid (n + 1) [⋀^Fin n]→ₗ[ℝ] ℝ) (w : Fin n → Euclid (n + 1)),
      (∑ j, g j) w = ∑ j, g j w := fun g w =>
    map_sum (AddMonoidHom.mk' (fun f : Euclid (n + 1) [⋀^Fin n]→ₗ[ℝ] ℝ => f w) fun _ _ => rfl) g
      Finset.univ
  rw [hφe, map_sum, hsum]
  simp only [map_smul, AlternatingMap.smul_apply, hcol, smul_eq_mul, mul_ite, mul_zero,
    Finset.sum_ite_eq', Finset.mem_univ, ite_true]
  simp only [ContinuousAlternatingMap.coe_toAlternatingMap, he]
  rw [mul_comm, ← mul_assoc, ← pow_add, ← two_mul, pow_mul, neg_one_sq, one_pow, one_mul]
/-- **Normal decomposition of a column determinant** (the determinant step of the normal
orientation of a codimension-one current).  If `‖ν‖ = 1` and `σ₀, …, σₙ₋₁` span `ν^⊥`, then
`det[w, σ] = ⟨w, ν⟩ det[ν, σ]`.  The column determinant is the standard-basis determinant of
`(x, σ)`, linear in the first column `x`, and `w - ⟨w, ν⟩ν ∈ ν^⊥ = span σ`, so the columns
`(w - ⟨w, ν⟩ν, σ)` are linearly dependent and contribute `0`.  Orthonormality of `σ` is not
used. -/
theorem Submission.codim1_lur_no_det_cons_normal_decomp : ∀ (n : ℕ) (ν w : Euclid (n + 1)) (σ : Fin n → Euclid (n + 1)), ‖ν‖ = 1 → Submodule.span ℝ (Set.range σ) = (Submodule.span ℝ {ν})ᗮ → Matrix.det (Matrix.of fun r c : Fin (n + 1) => (Fin.cons w σ : Fin (n + 1) → Euclid (n + 1)) c r) = inner ℝ w ν * Matrix.det (Matrix.of fun r c : Fin (n + 1) => (Fin.cons ν σ : Fin (n + 1) → Euclid (n + 1)) c r) := by
  intro n ν w σ hν hspan
  -- `det[x, σ]` is the standard-basis determinant of the columns `(x, σ)`
  have hD : ∀ x : Euclid (n + 1), Matrix.det (Matrix.of fun r c : Fin (n + 1) =>
      (Fin.cons x σ : Fin (n + 1) → Euclid (n + 1)) c r) =
        (PiLp.basisFun 2 ℝ (Fin (n + 1))).det (Matrix.vecCons x σ) := fun _ => rfl
  -- `q = w - ⟨w, ν⟩ν` lies in `ν^⊥ = span σ`, so the columns `(q, σ)` are linearly dependent
  have hq : w - inner ℝ w ν • ν ∈ Submodule.span ℝ (Set.range σ) := by
    rw [hspan, Submodule.mem_orthogonal_singleton_iff_inner_right, inner_sub_right,
      real_inner_smul_right, real_inner_self_eq_norm_sq, hν, real_inner_comm w ν]
    ring
  have h0 : (PiLp.basisFun 2 ℝ (Fin (n + 1))).det (Matrix.vecCons (w - inner ℝ w ν • ν) σ) = 0 :=
    AlternatingMap.map_linearDependent _ _ fun h => (linearIndependent_finCons.mp h).2 hq
  -- linearity in the first column along `w = q + ⟨w, ν⟩ν`
  have hw : Matrix.vecCons w σ = Matrix.vecCons (w - inner ℝ w ν • ν + inner ℝ w ν • ν) σ := by
    rw [sub_add_cancel]
  rw [hD, hD, hw, AlternatingMap.map_vecCons_add, h0, zero_add, AlternatingMap.map_vecCons_smul,
    smul_eq_mul]

/-- **Orienting `∂[[E]]` by the unit normal** (Simon 7.5.2 (∗), the orientation computation of
the local unit representation).  For a unit vector `ν ∈ ℝ^{n+1}`, `n ≥ 1`, some orthonormal frame
`σ` of `ν^⊥` has `β(σ) = −⟨φ_β, ν⟩` for every `n`-covector `β`, where
`φ_β = Σⱼ (−1)ʲ β(e_{j.succAbove 0}, …, e_{j.succAbove (n−1)}) eⱼ`: take `σ` with
`det[ν, σ] = −1`; then `β(σ) = det[φ_β, σ] = ⟨φ_β, ν⟩ det[ν, σ]`. -/
theorem Submission.codim1_lur_normal_covector_orientation : ∀ (n : ℕ) (ν : Euclid (n + 1)), 1 ≤ n → ‖ν‖ = 1 → ∃ σ : Fin n → Euclid (n + 1), Orthonormal ℝ σ ∧ Submodule.span ℝ (Set.range σ) = (Submodule.span ℝ {ν})ᗮ ∧ ∀ β : Covector (Euclid (n + 1)) n, β σ = -∑ j : Fin (n + 1), (-1 : ℝ) ^ (j : ℕ) * β (fun k => EuclideanSpace.single (j.succAbove k) (1 : ℝ)) * inner ℝ (EuclideanSpace.single j (1 : ℝ)) ν := by
  intro n ν hn hν
  obtain ⟨σ, hσ, hspan, hdet⟩ := Submission.codim1_lur_no_oriented_normal_frame n ν hn hν
  refine ⟨σ, hσ, hspan, fun β => ?_⟩
  -- `β(σ) = det[φ_β, σ] = ⟨φ_β, ν⟩ det[ν, σ] = −⟨φ_β, ν⟩`, then expand `⟨φ_β, ν⟩` linearly
  rw [Submission.codim1_lur_no_covector_eq_det_cons n β σ,
    Submission.codim1_lur_no_det_cons_normal_decomp n ν _ σ hν hspan, hdet, sum_inner]
  simp only [real_inner_smul_left]
  ring
/-- **Mass-summable series of currents in `ℝᴾ`** (Simon Ch. 6, Lemma 3.13; proof of 7.2, steps
6(a)–(b)).  If `X_i ∈ 𝒟_{k+1}(ℝᴾ)` with `Σᵢ M(X_i) < ∞`, then `Y(ω) = Σᵢ X_i(ω)` is a current
with `M(Y) ≤ Σᵢ M(X_i)` and `spt Y ⊆ closure (⋃ᵢ spt X_i)`, since a current vanishes off its
support (VO).  If every `X_i = τ(R_i)` is integer multiplicity, then `μ_{R_i}(ℝᴾ) = M(X_i)` (MM),
so `Σᵢ μ_{R_i}(ℝᴾ) < ∞` and one triple `R'` has `Σᵢ R_i(ω) = R'(ω)`; by uniqueness of sums
`Y(ω) = Σᵢ X_i(ω) = R'(ω)`, i.e. `Y = τ(R')`. -/
theorem Submission.dtc_bc_lc_fd_series : ∀ (P k : ℕ) (X : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)), ∑' i, (X i).mass < ∞ → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1), (∀ ω : TestFormOn (univ : Set (Euclid P)) (k + 1), HasSum (fun i => X i ω) (Y ω)) ∧ Y.mass ≤ ∑' i, (X i).mass ∧ Y.support ⊆ closure (⋃ i, (X i).support) ∧ ((∀ i, IsIntegerMultiplicity (X i)) → IsIntegerMultiplicity Y) := by
  intro P k X hX
  -- Steps 1–5: the sum `Y` with its mass and support bounds, using (VO)
  obtain ⟨Y, hYsum, hYmass, hYsupp⟩ := Submission.cmcdt_ims_series_current
    Submission.dtc_vanish_off_support P (k + 1) univ X isOpen_univ hX.ne
  refine ⟨Y, hYsum, hYmass, hYsupp, fun hIM => ?_⟩
  -- Step 6: `X_i = τ(R_i)` with `μ_{R_i}(ℝᴾ) = M(X_i)` by (MM), so `Σᵢ μ_{R_i}(ℝᴾ) < ∞`
  choose R hR using hIM
  have hmeas : ∀ i, (R i).measure univ = (X i).mass := fun i =>
    (Submission.dtc_mass_eq_measure P (k + 1) univ univ (X i) (R i) isOpen_univ isOpen_univ
      subset_rfl (hR i)).symm
  -- one triple `R'` sums the `R_i`; then `Y(ω) = Σᵢ X_i(ω) = Σᵢ R_i(ω) = R'(ω)`
  obtain ⟨R', hR'⟩ := Submission.cmcdt_ims_imrep_tsum P (k + 1) univ R isOpen_univ
    (by simpa only [hmeas] using hX.ne)
  refine ⟨R', fun ω => ?_⟩
  have hfun : (fun i => X i ω) = fun i => (R i).action (ω : DifferentialForm (Euclid P) (k + 1)) :=
    funext fun i => hR i ω
  have h := hYsum ω
  rw [hfun] at h
  exact h.unique (hR' ω)

/-- A set of finite `H⁰`-measure is countably `0`-rectifiable (Simon Ch. 3, Definition 1.1, case
`n = 0`).  `H⁰ = μH[0]` gives every point mass `1`, so an infinite `M` would contain `k`-point
subsets of measure `k` for every `k ∈ ℕ`; hence `M` is finite.  Each point `x` is the range of the
constant (`0`-Lipschitz) map `ℝ⁰ → ℝᴾ`, and `M = ⋃₀ {{x} : x ∈ M}` is a countable union of such
ranges. -/
theorem Submission.cbrr_rectifiable_dim_zero : ∀ (P : ℕ) (M : Set (Euclid P)), μHE[0] M ≠ ∞ → CountablyRectifiable 0 M := by
  intro P M hM
  -- Step 1: `μHE[0] = μH[0]`, and `μH[0] {x} = 1`
  rw [Measure.euclideanHausdorffMeasure_zero] at hM
  -- Step 2: `M` is finite; otherwise it has `⌈r⌉₊`-point subsets for every `r`, so `μH[0] M = ∞`
  have hfin : M.Finite := by
    by_contra hinf
    refine hM (ENNReal.eq_top_of_forall_nnreal_le fun r => ?_)
    obtain ⟨s, hsM, hs⟩ := Set.Infinite.exists_subset_card_eq hinf ⌈r⌉₊
    calc (r : ℝ≥0∞) ≤ (⌈r⌉₊ : ℝ≥0∞) := by exact_mod_cast Nat.le_ceil r
      _ = ∑ x ∈ s, μH[0] ({x} : Set (Euclid P)) := by
        simp only [Measure.hausdorffMeasure_zero_singleton, Finset.sum_const, nsmul_eq_mul,
          mul_one, hs]
      _ = μH[0] (s : Set (Euclid P)) := sum_measure_singleton
      _ ≤ μH[0] M := measure_mono hsM
  -- Step 3: each `{x}` is the range of the constant `0`-Lipschitz map `ℝ⁰ → ℝᴾ`
  have hpt : ∀ S ∈ (fun x : Euclid P => ({x} : Set (Euclid P))) '' M,
      CountablyRectifiable 0 S := by
    rintro _ ⟨x, -, rfl⟩
    simpa only [range_const] using Poincare.SimonGMT.Chapter03.countablyRectifiable_range (n := 0)
      (LipschitzWith.const (α := Euclid 0) x)
  -- Step 4: `M = ⋃₀ {{x} : x ∈ M}` is a countable union of countably `0`-rectifiable sets
  have h := Poincare.SimonGMT.Chapter03.countablyRectifiable_sUnion (hfin.countable.image _) hpt
  rwa [Set.sUnion_image, Set.biUnion_of_singleton] at h
/-- **Cut-off estimate** (Simon 6.4.11: the identity `T(g dη) = ∂T(gη) − T(dg ∧ η)` and its two
estimates).  Let `T = τ(M, θ, ξ) ∈ 𝒟_{m+1}(U)`, let `g ∈ C^∞` with `spt g ⊆ V`, `|g| ≤ a`,
`‖Dg‖ ≤ c` and `Dg = 0` off `S`, and let `η ∈ 𝒟^m(U)` with `|η| ≤ 1`.  Then
`|T(g dη)| ≤ a M_V(∂T) + c μ_T(S)`.  The identity follows from the Leibniz rule
`d(gη) = g dη + dg ∧ η`.  For `a > 0` the forms `±a⁻¹gη` are admissible for `M_V(∂T)`, and
`|dg ∧ η| ≤ ‖Dg‖ |η| ≤ c 1_S` gives `|T(dg ∧ η)| ≤ ∫ |dg ∧ η| dμ_T ≤ c μ_T(S)`. -/
theorem Submission.dtc_bc_lc_fd_lz_cutoff_estimate : ∀ (P m : ℕ) (U V S : Set (Euclid P)) (T : GeometricCurrentOn U (m + 1)) (R : IMRep U (m + 1)) (g : Euclid P → ℝ) (η : TestFormOn U m) (a c : ℝ), R.Represents T → ContDiff ℝ (⊤ : ℕ∞) g → tsupport g ⊆ V → (∀ x, |g x| ≤ a) → (∀ x, ‖fderiv ℝ g x‖ ≤ c) → (∀ x, fderiv ℝ g x ≠ 0 → x ∈ S) → (∀ x, covectorEuclideanNorm ((η : DifferentialForm (Euclid P) m) x) ≤ 1) → ENNReal.ofReal |R.action (fun x => g x • exteriorDerivative (η : DifferentialForm (Euclid P) m) x)| ≤ ENNReal.ofReal a * T.boundary.massOn V + ENNReal.ofReal c * R.measure S := by
  intro P m U V S T R g η a c hRT hg hgV hga hgc hgS hη
  -- `|sα| = |s| |α|` for the Euclidean coefficient norm
  have hNsmul : ∀ (s : ℝ) (α : Covector (Euclid P) m),
      covectorEuclideanNorm (s • α) = |s| * covectorEuclideanNorm α := by
    intro s α
    unfold covectorEuclideanNorm
    rw [← Real.sqrt_sq_eq_abs, ← Real.sqrt_mul (sq_nonneg s), Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl fun I _ => ?_
    split_ifs <;> simp [mul_pow]
  -- `gζ ∈ 𝒟ᵏ(U)` for every `ζ ∈ 𝒟ᵏ(U)`
  have hgmem : ∀ {k : ℕ} (ζ : TestFormOn U k),
      (fun x => g x • (ζ : DifferentialForm (Euclid P) k) x) ∈ TestFormOn U k := fun ζ =>
    ⟨⟨hg.smul ζ.property.1.1, ζ.property.1.2.smul_left (f := g)⟩,
      (tsupport_smul_subset_right g _).trans ζ.property.2⟩
  -- `ω₁ = gη`, `ω₂ = g dη` and `E = d(gη) − g dη`
  let ω₁ : TestFormOn U m := ⟨_, hgmem η⟩
  let ω₂ : TestFormOn U (m + 1) := ⟨_, hgmem (exteriorDerivativeTestOn U m η)⟩
  set E : TestFormOn U (m + 1) := exteriorDerivativeTestOn U m ω₁ - ω₂ with hEdef
  -- identity 4.11: `T(g dη) = ∂T(gη) − T(E)`
  have hsplit :
      R.action (fun x => g x • exteriorDerivative (η : DifferentialForm (Euclid P) m) x) =
        T.boundary ω₁ - T E := by
    rw [hEdef, GeometricCurrentOn.boundary_apply, map_sub T.toCurrent, sub_sub_cancel]
    exact (hRT ω₂).symm
  -- boundary term: `|∂T(gη)| ≤ a M_V(∂T)`
  have hbd : ENNReal.ofReal |T.boundary ω₁| ≤ ENNReal.ofReal a * T.boundary.massOn V := by
    rcases ((abs_nonneg _).trans (hga 0)).eq_or_lt with ha | hapos
    · -- `a = 0`: then `g = 0` and `gη = 0`
      have hω₁ : ω₁ = 0 := by
        apply Subtype.ext
        funext x
        change g x • (η : DifferentialForm (Euclid P) m) x = 0
        rw [abs_nonpos_iff.mp ((hga x).trans ha.symm.le), zero_smul]
      rw [hω₁, map_zero, abs_zero, ENNReal.ofReal_zero]
      exact zero_le
    · -- `a > 0`: `±a⁻¹gη` are admissible for `M_V(∂T)`
      have hζ : a⁻¹ • ω₁ ∈ massAdmissibleOn U m V := by
        refine ⟨?_, fun x => ?_⟩
        · change tsupport (fun x => a⁻¹ • (g x • (η : DifferentialForm (Euclid P) m) x)) ⊆ V
          exact (tsupport_smul_subset_right (fun _ => a⁻¹) _).trans
            ((tsupport_smul_subset_left g _).trans hgV)
        · change covectorEuclideanNorm (a⁻¹ • (g x • (η : DifferentialForm (Euclid P) m) x)) ≤ 1
          rw [hNsmul, hNsmul, abs_inv, abs_of_pos hapos]
          calc a⁻¹ * (|g x| * covectorEuclideanNorm ((η : DifferentialForm (Euclid P) m) x))
              ≤ a⁻¹ * (a * 1) := mul_le_mul_of_nonneg_left
                (mul_le_mul (hga x) (hη x) (covectorEuclideanNorm_nonneg _) hapos.le)
                (inv_nonneg.mpr hapos.le)
            _ = 1 := by rw [mul_one, inv_mul_cancel₀ hapos.ne']
      have hζn : -(a⁻¹ • ω₁) ∈ massAdmissibleOn U m V := by
        refine ⟨?_, fun x => ?_⟩
        · change tsupport (-((a⁻¹ • ω₁ : TestFormOn U m) : DifferentialForm (Euclid P) m)) ⊆ V
          rw [tsupport_neg]
          exact hζ.1
        · change covectorEuclideanNorm
            (-((a⁻¹ • ω₁ : TestFormOn U m) : DifferentialForm (Euclid P) m) x) ≤ 1
          rw [covectorEuclideanNorm_neg]
          exact hζ.2 x
      have hT1 : ENNReal.ofReal |T.boundary (a⁻¹ • ω₁)| ≤ T.boundary.massOn V := by
        rcases abs_choice (T.boundary (a⁻¹ • ω₁)) with h | h <;> rw [h]
        · exact T.boundary.le_massOn hζ
        · have h' := T.boundary.le_massOn hζn
          rwa [map_neg T.boundary.toCurrent] at h'
      have hscale : T.boundary ω₁ = a * T.boundary (a⁻¹ • ω₁) := by
        have h := map_smul T.boundary.toCurrent a (a⁻¹ • ω₁)
        rwa [smul_inv_smul₀ hapos.ne', smul_eq_mul] at h
      rw [hscale, abs_mul, abs_of_pos hapos, ENNReal.ofReal_mul hapos.le]
      gcongr
  -- Leibniz rule: `E(x) = dg(x) ∧ η(x)`
  have hE : ∀ x, (E : DifferentialForm (Euclid P) (m + 1)) x =
      ContinuousAlternatingMap.alternatizeUncurryFin
        ((fderiv ℝ g x).smulRight ((η : DifferentialForm (Euclid P) m) x)) := by
    intro x
    change exteriorDerivative (fun y => g y • (η : DifferentialForm (Euclid P) m) y) x -
      g x • exteriorDerivative (η : DifferentialForm (Euclid P) m) x = _
    rw [Submission.cmcs_cd_extDeriv_smul_leibniz P m g η x (hg.differentiable (by simp) x)
      (η.property.1.1.differentiable (by simp) x), add_sub_cancel_left]
  -- wedge term: `|E(x)| ≤ ‖Dg(x)‖ |η(x)| ≤ c 1_S(x)`
  have hEpt : ∀ x,
      ENNReal.ofReal (covectorEuclideanNorm ((E : DifferentialForm (Euclid P) (m + 1)) x)) ≤
        S.indicator (fun _ => ENNReal.ofReal c) x := by
    intro x
    have hw := Submission.cmcs_wedge_norm_le P m (fderiv ℝ g x)
      ((η : DifferentialForm (Euclid P) m) x)
    rw [← hE x] at hw
    by_cases hx : x ∈ S
    · rw [indicator_of_mem hx]
      refine ENNReal.ofReal_le_ofReal (hw.trans ?_)
      calc ‖fderiv ℝ g x‖ * covectorEuclideanNorm ((η : DifferentialForm (Euclid P) m) x)
          ≤ c * 1 := mul_le_mul (hgc x) (hη x) (covectorEuclideanNorm_nonneg _)
            ((norm_nonneg _).trans (hgc x))
        _ = c := mul_one c
    · have h0 : fderiv ℝ g x = 0 := by
        by_contra h
        exact hx (hgS x h)
      rw [h0, norm_zero, zero_mul] at hw
      rw [indicator_of_notMem hx, ENNReal.ofReal_eq_zero.mpr hw]
  -- `|T(E)| ≤ ∫ |E| dμ_T ≤ c μ_T(S)`
  have hTE : ENNReal.ofReal |T E| ≤ ENNReal.ofReal c * R.measure S :=
    (Submission.dtc_bc_lc_fd_lz_action_bound P (m + 1) U T R E hRT).trans
      ((lintegral_mono hEpt).trans (lintegral_indicator_const_le S _))
  rw [hsplit]
  calc ENNReal.ofReal |T.boundary ω₁ - T E|
      ≤ ENNReal.ofReal (|T.boundary ω₁| + |T E|) := ENNReal.ofReal_le_ofReal (abs_sub _ _)
    _ = ENNReal.ofReal |T.boundary ω₁| + ENNReal.ofReal |T E| :=
        ENNReal.ofReal_add (abs_nonneg _) (abs_nonneg _)
    _ ≤ ENNReal.ofReal a * T.boundary.massOn V + ENNReal.ofReal c * R.measure S :=
        add_le_add hbd hTE
/-- **Boundary mass of `T⌞B_{t₀}`** (Simon Ch. 6, proof of 4.9: the computation 4.11 with a radial
cut-off, chapter-06.txt lines 1378–1402, applied to `T' = T⌞B_{t₀}`).  Let `R = (M, θ, ξ)`
represent `T`, let `R' = (M ∩ B_{t₀}, θ, ξ)` represent `T'`, and let `B̄_{t₀}(0) ⊆ V`.  Then
`M(∂T') ≤ 2 M_V(∂T) + 2 liminf_{h↓0} h⁻¹ μ_R({t₀ − h < |x| < t₀})`.

Fix `η ∈ 𝒟^m(U)` with `|η| ≤ 1` and put `F = θ⟨dη, ξ⟩`.  `F` is `Hⁿ⌞M`-integrable:
`|⟨α, ξ⟩| ≤ |α|` a.e. (`cmc_imRep_locality_restrict_sub` (d)), `|dη|` is bounded with compact
support `K ⊆ U`, and `θ` is integrable on `M ∩ K`.  For `0 < h < 1`, let `g_h` be the level
cut-off of `|·|` at `t₀` (`cmcs_level_cutoff` with `L = 1`).  Then `|g_h| ≤ 2`,
`‖Dg_h‖ ≤ 1/(h(1 − h/2)) ≤ 2/h`, `Dg_h = 0` off the strip `{t₀ − h < |x| < t₀}`, and
`spt g_h ⊆ B̄_{t₀}(0) ⊆ V`.  So the cut-off estimate gives
`|τ(M, θ, ξ)(g_h dη)| ≤ 2 M_V(∂T) + 2h⁻¹ μ_R(strip_h)`.  By dominated convergence
(`cmcs_smp_cutoff_integral_tendsto`),
`τ(M, θ, ξ)(g_h dη) = ∫ g_h F → ∫_{|x| < t₀} F = T'(dη) = ∂T'(η)`.  Take `liminf_{h↓0}`; the map
`y ↦ 2 M_V(∂T) + 2y` is monotone and continuous, so it commutes with `liminf`.  Finally take the
supremum over `η`. -/
theorem Submission.dtc_bc_lc_fd_lz_boundary_mass : ∀ (P m : ℕ) (U V : Set (Euclid P)) (T T' : GeometricCurrentOn U (m + 1)) (R R' : IMRep U (m + 1)) (t₀ : ℝ), closedBall (0 : Euclid P) t₀ ⊆ V → R.Represents T → R'.Represents T' → R'.carrier = R.carrier ∩ ball (0 : Euclid P) t₀ → R'.mult = R.mult → R'.orient = R.orient → T'.boundary.mass ≤ 2 * T.boundary.massOn V + 2 * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * R.measure {x : Euclid P | t₀ - h < ‖x‖ ∧ ‖x‖ < t₀}) (𝓝[>] 0) := by
  intro P m U V T T' R R' t₀ hV hR hR' hcar hmult horient
  set ν := μHE[m + 1].restrict R.carrier with hν
  -- `A(h) = μ_R({t₀ − h < |x| < t₀})`
  set A : ℝ → ℝ≥0∞ := fun h => R.measure {x : Euclid P | t₀ - h < ‖x‖ ∧ ‖x‖ < t₀}
  -- Step 4: the level cut-offs `g_h` of `|·|` at `t₀` (`L = 1`), for `0 < h < 1`
  have hLC : ∀ h : ℝ, 0 < h → h < 1 → ∃ g : Euclid P → ℝ, ContDiff ℝ (⊤ : ℕ∞) g ∧
      (∀ x, |g x| ≤ 2) ∧ (∀ x, ‖fderiv ℝ g x‖ ≤ ((1 : NNReal) : ℝ) / (h * (1 - h / 2))) ∧
      (∀ x, fderiv ℝ g x ≠ 0 → t₀ - h < ‖x‖ ∧ ‖x‖ < t₀) ∧ (∀ x, ‖x‖ ≤ t₀ - h → g x = 1) ∧
      (∀ x, t₀ ≤ ‖x‖ → g x = 0) := fun h h0 h1 =>
    Submission.cmcs_level_cutoff P (fun x => ‖x‖) 1 t₀ h lipschitzWith_one_norm h0 h1
  choose! g hgs hg2 hgd hgS hg1 hg0 using hLC
  -- Step 1: it suffices to bound `∂T'(η)` for `η ∈ 𝒟^m(U)` with `|η| ≤ 1`
  refine sSup_le ?_
  rintro r ⟨η, hη, rfl⟩
  -- Step 3: `dη` is continuous with compact support `K ⊆ U`; `F = θ⟨dη, ξ⟩` is `ν`-integrable
  set dη := exteriorDerivative (η : DifferentialForm (Euclid P) m)
  have hdη : IsTestForm dη := exteriorDerivative_isTestForm η.property.1
  have hdηc : Continuous dη := hdη.1.continuous
  set K := tsupport dη
  have hKc : IsCompact K := hdη.2
  have hKU : K ⊆ U := (tsupport_exteriorDerivative_subset _).trans η.property.2
  set F : Euclid P → ℝ := fun x => (R.mult x : ℝ) * R.orient x (dη x) with hF
  -- `|dη|` is continuous with compact support, hence bounded by some `b`
  have hcEN : Continuous fun α : Covector (Euclid P) (m + 1) => covectorEuclideanNorm α := by
    unfold covectorEuclideanNorm
    refine (continuous_finsetSum _ fun I _ => ?_).sqrt
    split_ifs
    · exact (continuous_eval_const _).pow 2
    · exact continuous_const
  obtain ⟨b, hb⟩ := (hcEN.comp hdηc).bounded_above_of_compact_support
    (hdη.2.comp_left (covectorEuclideanNorm_zero P (m + 1)))
  have hθmeas : AEStronglyMeasurable (fun x => (R.mult x : ℝ)) ν :=
    ((measurable_from_nat (f := fun k : ℕ => (k : ℝ))).comp R.measurable_mult).aestronglyMeasurable
  have hFmeas : AEStronglyMeasurable F ν :=
    hθmeas.mul (Continuous.comp_aestronglyMeasurable₂
      (g := fun (L : MultiVector P (m + 1)) (α : Covector (Euclid P) (m + 1)) => L α)
      (isBoundedBilinearMap_apply (𝕜 := ℝ) (E := Covector (Euclid P) (m + 1)) (F := ℝ)).continuous
      R.aestronglyMeasurable_orient hdηc.aestronglyMeasurable)
  -- `1_K θ` is `ν`-integrable: `∫_{M ∩ K} θ dHⁿ < ∞`
  have hθK : Integrable (K.indicator fun x => (R.mult x : ℝ)) ν := by
    rw [integrable_indicator_iff hKc.isClosed.measurableSet]
    refine ⟨hθmeas.restrict, ?_⟩
    show ∫⁻ x, ‖(R.mult x : ℝ)‖ₑ ∂(ν.restrict K) < ∞
    rw [hν, Measure.restrict_restrict hKc.isClosed.measurableSet, inter_comm]
    simp only [Real.enorm_natCast]
    exact lt_top_iff_ne_top.mpr (R.locallyIntegrable_mult K hKc hKU)
  -- `|F| ≤ b 1_K θ` a.e., by `|⟨α, ξ⟩| ≤ |α|` and `dη = 0` off `K`
  have hFint : Integrable F ν := by
    refine Integrable.mono' (hθK.const_mul b) hFmeas ?_
    filter_upwards [(Submission.cmc_imRep_locality_restrict_sub).2.2.2 P (m + 1) U R] with x hx
    by_cases hxK : x ∈ K
    · show ‖(R.mult x : ℝ) * R.orient x (dη x)‖ ≤ b * K.indicator (fun x => (R.mult x : ℝ)) x
      rw [indicator_of_mem hxK, norm_mul, Real.norm_natCast, Real.norm_eq_abs]
      calc (R.mult x : ℝ) * |R.orient x (dη x)|
          ≤ (R.mult x : ℝ) * covectorEuclideanNorm (dη x) := by
            gcongr
            exact hx _
        _ ≤ (R.mult x : ℝ) * b := by
            gcongr
            exact (le_abs_self _).trans (hb x)
        _ = b * (R.mult x : ℝ) := mul_comm _ _
    · have h0 : dη x = 0 := image_eq_zero_of_notMem_tsupport hxK
      simp [hF, h0, indicator_of_notMem hxK]
  -- Step 2: `∂T'(η) = T'(dη) = ∫_{M ∩ B_{t₀}} θ⟨dη, ξ⟩ dHⁿ = ∫_{|x| < t₀} F dν`
  have hball : {x : Euclid P | ‖x‖ < t₀} = ball (0 : Euclid P) t₀ := by
    ext x
    exact mem_ball_zero_iff.symm
  have hmeasB : MeasurableSet {x : Euclid P | ‖x‖ < t₀} := hball ▸ measurableSet_ball
  have hz : T'.boundary η = ∫ x in {x : Euclid P | ‖x‖ < t₀}, F x ∂ν := by
    rw [GeometricCurrentOn.boundary_apply, hR' (exteriorDerivativeTestOn U m η), IMRep.action,
      hcar, hmult, horient, hν, Measure.restrict_restrict hmeasB, hball,
      inter_comm (ball (0 : Euclid P) t₀) R.carrier]
    rfl
  -- Step 6: `Φ(h) = R(g_h dη) = ∫ g_h F dν`, as `ξ(x)` is linear
  set Φ : ℝ → ℝ := fun h => R.action (fun x => g h x • dη x)
  have hΦ : ∀ h : ℝ, Φ h = ∫ x, g h x * F x ∂ν := by
    intro h
    show R.action _ = _
    rw [IMRep.action]
    refine integral_congr_ae (Eventually.of_forall fun x => ?_)
    simp only [hF, map_smul, smul_eq_mul]
    ring
  -- Step 5: the cut-off estimate for `0 < h < 1`, with `1/(h(1 − h/2)) ≤ 2/h`
  have hest : ∀ h : ℝ, 0 < h → h < 1 →
      ENNReal.ofReal |Φ h| ≤ 2 * T.boundary.massOn V + 2 * (ENNReal.ofReal h⁻¹ * A h) := by
    intro h h0 h1
    -- `spt g_h ⊆ B̄_{t₀}(0) ⊆ V`, since `g_h = 0` on `{|x| ≥ t₀}`
    have hsupp : tsupport (g h) ⊆ V :=
      (closure_mono (s := support (g h)) (t := ball (0 : Euclid P) t₀) fun x hx =>
        mem_ball_zero_iff.2 (not_le.1 fun hx' => hx (hg0 h h0 h1 x hx'))).trans
        (closure_ball_subset_closedBall.trans hV)
    have hc : ENNReal.ofReal (((1 : NNReal) : ℝ) / (h * (1 - h / 2))) ≤ 2 * ENNReal.ofReal h⁻¹ :=
      calc ENNReal.ofReal (((1 : NNReal) : ℝ) / (h * (1 - h / 2))) ≤ ENNReal.ofReal (2 * h⁻¹) := by
            refine ENNReal.ofReal_le_ofReal ?_
            rw [NNReal.coe_one]
            calc 1 / (h * (1 - h / 2)) ≤ 1 / (h / 2) :=
                  one_div_le_one_div_of_le (half_pos h0) (by nlinarith [mul_pos h0 (sub_pos.2 h1)])
              _ = 2 * h⁻¹ := by rw [one_div_div, div_eq_mul_inv]
        _ = 2 * ENNReal.ofReal h⁻¹ := by rw [ENNReal.ofReal_mul zero_le_two, ENNReal.ofReal_ofNat]
    calc ENNReal.ofReal |Φ h|
        ≤ ENNReal.ofReal 2 * T.boundary.massOn V +
            ENNReal.ofReal (((1 : NNReal) : ℝ) / (h * (1 - h / 2))) * A h :=
          Submission.dtc_bc_lc_fd_lz_cutoff_estimate P m U V
            {x : Euclid P | t₀ - h < ‖x‖ ∧ ‖x‖ < t₀} T R (g h) η 2 _ hR (hgs h h0 h1) hsupp
            (hg2 h h0 h1) (hgd h h0 h1) (hgS h h0 h1) hη.2
      _ ≤ 2 * T.boundary.massOn V + 2 * ENNReal.ofReal h⁻¹ * A h := by
          rw [ENNReal.ofReal_ofNat]
          gcongr
      _ = 2 * T.boundary.massOn V + 2 * (ENNReal.ofReal h⁻¹ * A h) := by rw [mul_assoc]
  -- Step 7: `Φ(h) = ∫ g_h F dν → ∫_{|x| < t₀} F dν = ∂T'(η)` as `h → 0+`
  have hlim : Tendsto Φ (𝓝[>] 0) (𝓝 (T'.boundary η)) := by
    rw [hz]
    exact (Submission.cmcs_smp_cutoff_integral_tendsto P ν F (fun x => ‖x‖) t₀ 2 g hFint
      measurable_norm (fun h h0 h1 => (hgs h h0 h1).continuous.aestronglyMeasurable) hg2 hg1
      hg0).congr fun h => (hΦ h).symm
  -- Step 8: pass to `liminf_{h↓0}`; `y ↦ 2 M_V(∂T) + 2y` is monotone and continuous
  have hev : ∀ᶠ h in 𝓝[>] (0 : ℝ),
      ENNReal.ofReal |Φ h| ≤ 2 * T.boundary.massOn V + 2 * (ENNReal.ofReal h⁻¹ * A h) := by
    filter_upwards [Ioo_mem_nhdsGT one_pos] with h hh
    exact hest h hh.1 hh.2
  have hmono : Monotone fun y : ℝ≥0∞ => 2 * T.boundary.massOn V + 2 * y := fun y₁ y₂ hy => by
    dsimp only
    gcongr
  have hcont : Continuous fun y : ℝ≥0∞ => 2 * T.boundary.massOn V + 2 * y :=
    continuous_const.add (ENNReal.continuous_const_mul ENNReal.ofNat_ne_top)
  calc ENNReal.ofReal (T'.boundary η) ≤ ENNReal.ofReal |T'.boundary η| :=
        ENNReal.ofReal_le_ofReal (le_abs_self _)
    _ = liminf (fun h => ENNReal.ofReal |Φ h|) (𝓝[>] 0) :=
        (ENNReal.tendsto_ofReal hlim.abs).liminf_eq.symm
    _ ≤ liminf (fun h => 2 * T.boundary.massOn V + 2 * (ENNReal.ofReal h⁻¹ * A h)) (𝓝[>] 0) :=
        liminf_le_liminf hev
    _ = 2 * T.boundary.massOn V + 2 * liminf (fun h => ENNReal.ofReal h⁻¹ * A h) (𝓝[>] 0) :=
        (hmono.map_liminf_of_continuousAt (fun h => ENNReal.ofReal h⁻¹ * A h)
          hcont.continuousAt).symm
/-- **Localisation at a good radius** (Simon Ch. 6, proof of 7.2, chapter-06.txt lines 2090–2100:
"by 4.5(1),(2) and an argument as in 6.7(2) of Ch. 2 … we can assume `spt Tⱼ ⊆ W̄`", with the slice
estimates 4.9–4.11).  Take `W ⊆ B_r`, `V = B_{r+2}` and `Λ₀ ≥ M_V(Tⱼ) + M_V(∂Tⱼ)` for all `j`.
The weights `μⱼ = θⱼHⁿ⌞Mⱼ` of representations of the `Tⱼ` satisfy `μⱼ(G) = M_G(Tⱼ)` for open `G`,
so they are finite on balls and `μⱼ(B_{r+1}) ≤ Λ₀`.  Fatou applied to 4.10 gives a radius
`t₀ ∈ (r, r + 1)` and a subsequence `φ` with `liminf_{h↓0} h⁻¹μ_{φ(j)}{t₀ − h < |x| < t₀} ≤ C`.
Then `T'ⱼ = T_{φ(j)}⌞B_{t₀}` is integer multiplicity, agrees with `T_{φ(j)}` on forms supported in
`W ⊆ B_{t₀}`, has support in `K = B̄_{r+1}` and mass `μ_{φ(j)}(B_{t₀}) ≤ Λ₀`, and by 4.11
`M(∂T'ⱼ) ≤ 2M_V(∂T_{φ(j)}) + 2C ≤ 2Λ₀ + 2C`. -/
theorem Submission.dtc_bc_lc_fd_localize : ∀ (P m : ℕ) (Ts : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (W : Set (Euclid P)), Bornology.IsBounded W → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ V : Set (Euclid P), IsOpen V → Bornology.IsBounded V → ⨆ j, ((Ts j).massOn V + (Ts j).boundary.massOn V) < ∞) → ∃ (K : Set (Euclid P)) (φ : ℕ → ℕ) (Λ : NNReal) (Ts' : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsCompact K ∧ StrictMono φ ∧ (∀ j, IsIntegerMultiplicity (Ts' j)) ∧ (∀ j, (Ts' j).support ⊆ K) ∧ (∀ j, (Ts' j).mass ≤ Λ ∧ (Ts' j).boundary.mass ≤ Λ) ∧ ∀ (j : ℕ) (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ W → Ts' j ω = Ts (φ j) ω := by
  intro P m Ts W hW hIM hbd
  -- Step 1: `W ⊆ B_r`, `V = B_{r+2}` and `M_V(Tⱼ) + M_V(∂Tⱼ) ≤ Λ₀` for every `j`
  obtain ⟨r, hWr⟩ := hW.subset_ball (0 : Euclid P)
  have hsup : ∀ G : Set (Euclid P), IsOpen G → Bornology.IsBounded G → ∀ j,
      (Ts j).massOn G + (Ts j).boundary.massOn G ≤
        ⨆ i, ((Ts i).massOn G + (Ts i).boundary.massOn G) := fun G _ _ j =>
    le_iSup (fun i => (Ts i).massOn G + (Ts i).boundary.massOn G) j
  obtain ⟨Λ₀, hΛ₀⟩ : ∃ Λ₀ : NNReal, ∀ j, (Ts j).massOn (ball (0 : Euclid P) (r + 2)) +
      (Ts j).boundary.massOn (ball (0 : Euclid P) (r + 2)) ≤ Λ₀ :=
    ⟨_, fun j => (hsup _ isOpen_ball isBounded_ball j).trans
      (ENNReal.coe_toNNReal (hbd _ isOpen_ball isBounded_ball).ne).ge⟩
  -- Step 2: representations `Rⱼ` of the `Tⱼ`; their weights `μⱼ` satisfy `μⱼ(G) = M_G(Tⱼ)`
  choose R hR using hIM
  have hμ : ∀ j (G : Set (Euclid P)), IsOpen G → (R j).measure G = (Ts j).massOn G :=
    fun j G hG => (Submission.dtc_mass_eq_measure P (m + 1) univ G (Ts j) (R j) isOpen_univ hG
      (subset_univ G) (hR j)).symm
  have hfin : ∀ (j : ℕ) (s : ℝ), (R j).measure (ball (0 : Euclid P) s) < ∞ := by
    intro j s
    rw [hμ j _ isOpen_ball]
    exact (le_self_add.trans (hsup _ isOpen_ball isBounded_ball j)).trans_lt
      (hbd _ isOpen_ball isBounded_ball)
  have hball : ∀ j, (R j).measure (ball (0 : Euclid P) (r + 1)) ≤ Λ₀ := by
    intro j
    calc (R j).measure (ball (0 : Euclid P) (r + 1))
        ≤ (R j).measure (ball (0 : Euclid P) (r + 2)) :=
          measure_mono (ball_subset_ball (by linarith))
      _ = (Ts j).massOn (ball (0 : Euclid P) (r + 2)) := hμ j _ isOpen_ball
      _ ≤ Λ₀ := le_self_add.trans (hΛ₀ j)
  -- Steps 3–4: a good radius `t₀ ∈ (r, r + 1)`, a subsequence `φ` and the slice bound `C`
  obtain ⟨t₀, ht₀, φ, C, hφ, hC⟩ :=
    Submission.dtc_bc_lc_fd_lz_good_radius P (fun j => (R j).measure) r Λ₀ hfin hball
  -- Step 5: `T'ⱼ = T_{φ(j)}⌞B_{t₀}`, represented by `R'ⱼ = R_{φ(j)}⌞B_{t₀}`
  choose T' R' hR' hcar hmult horient hmeas hagree hvan using fun j =>
    Submission.dtc_bc_lc_fd_lz_truncate P (m + 1) univ (ball (0 : Euclid P) t₀) (Ts (φ j))
      (R (φ j)) isOpen_univ measurableSet_ball (hR (φ j))
  have hBK : ball (0 : Euclid P) t₀ ⊆ closedBall 0 (r + 1) :=
    (ball_subset_ball ht₀.2.le).trans ball_subset_closedBall
  have hΛ : (Λ₀ : ℝ≥0∞) ≤ 2 * Λ₀ + 2 * C :=
    le_add_right (le_mul_of_one_le_left zero_le one_le_two)
  refine ⟨closedBall 0 (r + 1), φ, 2 * Λ₀ + 2 * C, T', isCompact_closedBall _ _, hφ,
    fun j => ⟨R' j, hR' j⟩, fun j => ?_, fun j => ⟨?_, ?_⟩, fun j ω hω => ?_⟩
  · -- Step 7: `T'ⱼ` kills every form supported off `K = B̄_{r+1} ⊇ B_{t₀}`
    exact (Submission.rsd_cmr_support_subset_of_vanish P (m + 1) univ _ (T' j) isOpen_univ
      (isCompact_closedBall _ _) (subset_univ _) fun ω hω => hvan j ω (hω.mono_right hBK)).1
  · -- Step 8: `M(T'ⱼ) = μ_{φ(j)}(B_{t₀}) ≤ μ_{φ(j)}(B_{r+1}) ≤ Λ₀`
    calc (T' j).mass = (R' j).measure univ :=
          Submission.dtc_mass_eq_measure P (m + 1) univ univ (T' j) (R' j) isOpen_univ isOpen_univ
            subset_rfl (hR' j)
      _ = (R (φ j)).measure (ball (0 : Euclid P) t₀) := by
          rw [hmeas j, Measure.restrict_apply_univ]
      _ ≤ (R (φ j)).measure (ball (0 : Euclid P) (r + 1)) :=
          measure_mono (ball_subset_ball ht₀.2.le)
      _ ≤ Λ₀ := hball (φ j)
      _ ≤ ((2 * Λ₀ + 2 * C : NNReal) : ℝ≥0∞) := by push_cast; exact hΛ
  · -- Step 9: 4.11 gives `M(∂T'ⱼ) ≤ 2M_V(∂T_{φ(j)}) + 2C ≤ 2Λ₀ + 2C`
    calc (T' j).boundary.mass
        ≤ 2 * (Ts (φ j)).boundary.massOn (ball (0 : Euclid P) (r + 2)) +
            2 * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ *
              (R (φ j)).measure {x : Euclid P | t₀ - h < ‖x‖ ∧ ‖x‖ < t₀}) (𝓝[>] 0) :=
          Submission.dtc_bc_lc_fd_lz_boundary_mass P m univ (ball (0 : Euclid P) (r + 2))
            (Ts (φ j)) (T' j) (R (φ j)) (R' j) t₀ (closedBall_subset_ball (by linarith [ht₀.2]))
            (hR (φ j)) (hR' j) (hcar j) (hmult j) (horient j)
      _ ≤ 2 * Λ₀ + 2 * C := by
          gcongr
          · exact le_add_self.trans (hΛ₀ (φ j))
          · exact hC j
      _ = ((2 * Λ₀ + 2 * C : NNReal) : ℝ≥0∞) := by push_cast; rfl
  · -- Step 6: forms supported in `W ⊆ B_r ⊆ B_{t₀}` see no difference
    exact hagree j ω (hω.trans (hWr.trans (ball_subset_ball ht₀.1.le)))
/-- **Gluing integer multiplicity triples over disjoint pieces** (Simon Ch. 6, 3.1).  Assume
(IMC)(a), as in `cbrg_ae_orient_iUnion`.  Let `Rᵢ = (Mᵢ, θᵢ, ξᵢ)` (`i` in a countable type) be
integer multiplicity triples in open `Wᵢ ⊆ U`, and `Aᵢ` pairwise disjoint Borel sets.  Let `μ` be
carried by `⋃ᵢ Aᵢ`, with `μ⌞Aᵢ = (θᵢHᵏ⌞Mᵢ)⌞Aᵢ` and `μ(K) < ∞` for compact `K ⊆ U`, and let `ξ` be
`μ`-measurable with `ξ = ξᵢ` `Hᵏ`-a.e. on `Mᵢ ∩ Aᵢ`.  Then `M = ⋃ᵢ Mᵢ ∩ Aᵢ`, with `θ = θᵢ` on `Aᵢ`
(`0` off `⋃ᵢ Aᵢ`) and orientation `ξ`, is an integer multiplicity triple in `U` of weight `μ`:
`θHᵏ⌞M = Σᵢ (θᵢHᵏ⌞Mᵢ)⌞Aᵢ = μ`, so `θ` is locally integrable, `Hᵏ⌞M` is locally finite and
`Hᵏ⌞M ≪ μ`, and `ξ` orients `M` a.e. by `cbrg_ae_orient_iUnion`. -/
theorem Submission.cbrg_imRep_glue_disjoint : (∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) → ∀ (ι : Type) [Countable ι] (P k : ℕ) (U : Set (Euclid P)) (W A : ι → Set (Euclid P)) (R : (i : ι) → IMRep (W i) k) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P k), IsOpen U → (∀ i, IsOpen (W i)) → (∀ i, W i ⊆ U) → (∀ i, MeasurableSet (A i)) → Pairwise (fun i j => Disjoint (A i) (A j)) → μ (⋃ i, A i)ᶜ = 0 → (∀ i, μ.restrict (A i) = (R i).measure.restrict (A i)) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → AEStronglyMeasurable ξ μ → (∀ i, ∀ᵐ y ∂(μHE[k].restrict ((R i).carrier ∩ A i)), ξ y = (R i).orient y) → ∃ R' : IMRep U k, R'.carrier = ⋃ i, (R i).carrier ∩ A i ∧ R'.orient = ξ ∧ R'.measure = μ := by
  classical
  intro hIMC ι _ P k U W A R μ ξ hU hWo hWU hAm hAd hAc hμA hfin hξm hξ
  -- pieces `Nᵢ = Mᵢ ∩ Aᵢ` and multiplicities `mᵢ = θᵢ`
  let N : ι → Set (Euclid P) := fun i => (R i).carrier ∩ A i
  let m : ι → Euclid P → ℕ := fun i => (R i).mult
  -- glued multiplicity: `θ = θᵢ` on `Aᵢ`, `0` off `⋃ᵢ Aᵢ`
  let θ : Euclid P → ℕ := fun x => if h : ∃ i, x ∈ A i then m h.choose x else 0
  have hθA : ∀ i, ∀ x ∈ A i, θ x = (R i).mult x := by
    intro i x hx
    have h : ∃ j, x ∈ A j := ⟨i, hx⟩
    have hj : h.choose = i := by
      by_contra hne
      exact (Set.disjoint_left.1 (hAd hne)) h.choose_spec hx
    show (if h' : ∃ j, x ∈ A j then m h'.choose x else 0) = m i x
    rw [dite_eq_left h, hj]
  have hθ0 : ∀ x, (¬ ∃ i, x ∈ A i) → θ x = 0 := by
    intro x hx
    show (if h' : ∃ j, x ∈ A j then m h'.choose x else 0) = 0
    rw [dite_eq_right hx]
  -- the carrier `M = ⋃ᵢ Nᵢ` is Borel and lies in `U`
  have hNm : ∀ i, MeasurableSet (N i) := fun i => (R i).measurableSet_carrier.inter (hAm i)
  have hMm : MeasurableSet (⋃ i, N i) := MeasurableSet.iUnion hNm
  have hMU : (⋃ i, N i) ⊆ U :=
    iUnion_subset fun i => inter_subset_left.trans ((R i).carrier_subset.trans (hWU i))
  -- `θ` is measurable: its fibres are Borel
  have hθm : Measurable θ := by
    refine measurable_to_countable' fun n => ?_
    have hpre : θ ⁻¹' {n} = (⋃ i, A i ∩ (R i).mult ⁻¹' {n}) ∪ ((⋃ i, A i)ᶜ ∩ {_x | 0 = n}) := by
      ext x
      simp only [mem_preimage, mem_singleton_iff, mem_union, mem_iUnion, mem_inter_iff,
        mem_compl_iff, mem_ofPred_eq]
      constructor
      · intro hx
        by_cases h : ∃ i, x ∈ A i
        · obtain ⟨i, hi⟩ := h
          exact Or.inl ⟨i, hi, by rw [← hθA i x hi]; exact hx⟩
        · exact Or.inr ⟨h, by rw [← hθ0 x h]; exact hx⟩
      · rintro (⟨i, hi, hx⟩ | ⟨h, hn⟩)
        · rw [hθA i x hi]; exact hx
        · rw [hθ0 x h]; exact hn
    rw [hpre]
    refine (MeasurableSet.iUnion fun i =>
      (hAm i).inter ((R i).measurable_mult (measurableSet_singleton n))).union
      ((MeasurableSet.iUnion hAm).compl.inter ?_)
    by_cases hn : 0 = n
    · simp [hn]
    · simp [hn]
  -- `θ ≥ 1` on `M`
  have hθpos : ∀ x ∈ ⋃ i, N i, 0 < θ x := by
    intro x hx
    obtain ⟨i, hxi⟩ := mem_iUnion.1 hx
    rw [hθA i x hxi.2]
    exact (R i).mult_pos x hxi.1
  -- `M` is countably `k`-rectifiable (reindex the pieces by `ℕ`)
  have hMrect : CountablyRectifiable k (⋃ i, N i) := by
    rcases isEmpty_or_nonempty ι with hι | hι
    · rw [iUnion_of_empty]
      exact Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty
    · obtain ⟨s, hs⟩ := exists_surjective_nat ι
      rw [← hs.iUnion_comp N]
      exact Poincare.SimonGMT.Chapter03.countablyRectifiable_iUnion _
        fun n => (R (s n)).rectifiable.mono inter_subset_left
  -- `μ = Σᵢ μ⌞Aᵢ = Σᵢ (θᵢHᵏ⌞Mᵢ)⌞Aᵢ`
  have hμsum : μ = Measure.sum (fun i => ((R i).measure).restrict (A i)) := by
    have h1 : μ.restrict (⋃ i, A i) = μ := by
      refine Measure.restrict_eq_self_of_ae_mem ?_
      rw [ae_iff]
      simpa [compl_def] using hAc
    calc μ = μ.restrict (⋃ i, A i) := h1.symm
      _ = Measure.sum (fun i => μ.restrict (A i)) := Measure.restrict_iUnion hAd hAm
      _ = Measure.sum (fun i => ((R i).measure).restrict (A i)) := by
          congr 1
          funext i
          exact hμA i
  -- the measure identity `θHᵏ⌞M = μ`
  have hmeas : (μHE[k].restrict (⋃ i, N i)).withDensity (fun x => (θ x : ℝ≥0∞)) = μ := by
    have hNd : Pairwise (fun i j => Disjoint (N i) (N j)) :=
      fun i j hij => (hAd hij).mono inter_subset_right inter_subset_right
    rw [hμsum, Measure.restrict_iUnion hNd hNm, withDensity_sum]
    congr 1
    funext i
    rw [IMRep.measure, restrict_withDensity (hAm i), Measure.restrict_restrict (hAm i),
      inter_comm (A i)]
    refine withDensity_congr_ae ?_
    filter_upwards [ae_restrict_mem (hNm i)] with x hx
    rw [hθA i x hx.2]
  -- local integrability of `θ`: `∫_{M ∩ K} θ dHᵏ = μ(K) < ∞`
  have hlint : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
      ∫⁻ x in (⋃ i, N i) ∩ K, (θ x : ℝ≥0∞) ∂μHE[k] ≠ ∞ := by
    intro K hK hKU
    have h1 : ∫⁻ x in (⋃ i, N i) ∩ K, (θ x : ℝ≥0∞) ∂μHE[k] =
        ((μHE[k].restrict (⋃ i, N i)).withDensity (fun x => (θ x : ℝ≥0∞))) K := by
      rw [withDensity_apply _ hK.measurableSet, Measure.restrict_restrict hK.measurableSet,
        inter_comm]
    rw [h1, hmeas]
    exact (hfin K hK hKU).ne
  -- local finiteness of `Hᵏ⌞M`: `Hᵏ(M ∩ K) ≤ ∫_{M ∩ K} θ dHᵏ`
  have hMfin : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[k] ((⋃ i, N i) ∩ K) ≠ ∞ := by
    intro K hK hKU
    refine ne_top_of_le_ne_top (hlint K hK hKU) ?_
    calc μHE[k] ((⋃ i, N i) ∩ K) = ∫⁻ _ in (⋃ i, N i) ∩ K, (1 : ℝ≥0∞) ∂μHE[k] := by
          rw [setLIntegral_one]
      _ ≤ ∫⁻ x in (⋃ i, N i) ∩ K, (θ x : ℝ≥0∞) ∂μHE[k] := by
          refine setLIntegral_mono (measurable_from_nat.comp hθm) ?_
          intro x hx
          exact_mod_cast hθpos x hx.1
  -- `Hᵏ⌞M ≪ θHᵏ⌞M = μ`, so `ξ` is `Hᵏ⌞M`-measurable
  have hac : μHE[k].restrict (⋃ i, N i) ≪ μ := by
    rw [← hmeas]
    refine withDensity_absolutelyContinuous' (measurable_from_nat.comp hθm).aemeasurable ?_
    filter_upwards [ae_restrict_mem hMm] with x hx
    exact_mod_cast (hθpos x hx).ne'
  have hξM : AEStronglyMeasurable ξ (μHE[k].restrict (⋃ i, N i)) := hξm.mono_ac hac
  -- orientation: `ξ` orients `M` a.e., by `cbrg_ae_orient_iUnion` for the pieces `Nᵢ ⊆ Mᵢ`
  have horient := Submission.cbrg_ae_orient_iUnion hIMC ι P k U W N R ξ hU hWo hNm
    (fun i => inter_subset_left) hMU hMfin hξ
  exact ⟨{ carrier := ⋃ i, N i
           mult := θ
           orient := ξ
           measurableSet_carrier := hMm
           carrier_subset := hMU
           rectifiable := hMrect
           measurable_mult := hθm
           mult_pos := hθpos
           locallyIntegrable_mult := hlint
           aestronglyMeasurable_orient := hξM
           orients := horient }, rfl, rfl, hmeas⟩
/-- Finite `ε`-net of `n`-planes in the projection operator norm (Simon Ch. 3, proof of 1.6, the
choice of `π₁, …, π_N`): there are `n`-dimensional subspaces `T₁, …, T_N` of `ℝᴾ` such that every
`n`-dimensional `Q` has `‖p_Q − p_{T_j}‖ < ε` for some `j`.  The rank-`n` orthogonal projections
lie in the closed unit ball of the finite-dimensional space `L(ℝᴾ)`, so they are totally bounded
and finitely many of them are `ε`-dense among them; write those as `p_{T_j}`. -/
theorem Submission.cbrr_projection_net : ∀ (P n : ℕ) (ε : ℝ), 0 < ε → ∃ (N : ℕ) (T : Fin N → Submodule ℝ (Euclid P)), (∀ j, Module.finrank ℝ (T j) = n) ∧ ∀ Q : Submodule ℝ (Euclid P), Module.finrank ℝ Q = n → ∃ j, ‖Q.starProjection - (T j).starProjection‖ < ε := by
  intro P n ε hε
  -- the rank-`n` orthogonal projections lie in the closed unit ball, so they form a totally
  -- bounded set
  have hS : TotallyBounded ((fun Q : Submodule ℝ (Euclid P) => Q.starProjection) ''
      {Q | Module.finrank ℝ Q = n}) :=
    (isCompact_closedBall (0 : Euclid P →L[ℝ] Euclid P) 1).totallyBounded.subset (by
      rintro _ ⟨Q, -, rfl⟩
      simpa using Q.starProjection_norm_le)
  -- finitely many of them are `ε`-dense among them
  obtain ⟨t, htS, htfin, hcover⟩ := finite_approx_of_totallyBounded hS ε hε
  have ht : ∀ L ∈ t, ∃ T : Submodule ℝ (Euclid P), Module.finrank ℝ T = n ∧ T.starProjection = L :=
    fun L hL => htS hL
  choose! T hT using ht
  -- enumerate them
  obtain ⟨N, ⟨e⟩⟩ := @Finite.exists_equiv_fin t htfin.to_subtype
  refine ⟨N, fun j => T (e.symm j), fun j => (hT _ (e.symm j).2).1, fun Q hQ => ?_⟩
  obtain ⟨L, hL, hQL⟩ := mem_iUnion₂.1 (hcover ⟨Q, hQ, rfl⟩)
  refine ⟨e ⟨L, hL⟩, ?_⟩
  simp only [Equiv.symm_apply_apply]
  rw [(hT L hL).2, ← dist_eq_norm]
  exact hQL
/-- **Cone claim (10) in the proof of Simon Ch. 3, Theorem 1.6 "⇐"**, with the corrected constant
`b·16ⁿ < a`.  Suppose `μ(B̄_ρ(y)) ≥ aρⁿ` for `y ∈ E` and `μ(X(x) ∩ B_ρ(x)) ≤ bρⁿ` for `x ∈ E`,
`0 < ρ < δ`, where `X(x) = {z : 2|p_{Q(x)}(z − x)| < |z − x|}`.  If `x, y ∈ E`,
`‖p_{Q(x)} − p_T‖ < 1/16` and `|y − x| < δ/2`, then `|y − x| ≤ 4|p_T(y − x)|`.  Otherwise
`σ = |y − x|` has `B̄_{σ/8}(y) ⊆ X(x) ∩ B_{2σ}(x)`, so `a(σ/8)ⁿ ≤ b(2σ)ⁿ = b·16ⁿ(σ/8)ⁿ`. -/
theorem Submission.cbrr_cone_claim : ∀ (P n : ℕ) (μ : Measure (Euclid P)) (E : Set (Euclid P)) (Q : Euclid P → Submodule ℝ (Euclid P)) (T : Submodule ℝ (Euclid P)) (a b δ : ℝ), 0 < a → b * 16 ^ n < a → (∀ y ∈ E, ∀ ρ : ℝ, 0 < ρ → ρ < δ → ENNReal.ofReal (a * ρ ^ n) ≤ μ (closedBall y ρ)) → (∀ x ∈ E, ∀ ρ : ℝ, 0 < ρ → ρ < δ → μ ({z | 2 * ‖(Q x).starProjection (z - x)‖ < ‖z - x‖} ∩ ball x ρ) ≤ ENNReal.ofReal (b * ρ ^ n)) → ∀ x ∈ E, ∀ y ∈ E, ‖(Q x).starProjection - T.starProjection‖ < 1 / 16 → ‖y - x‖ < δ / 2 → ‖y - x‖ ≤ 4 * ‖T.starProjection (y - x)‖ := by
  intro P n μ E Q T a b δ ha hab hlow hup x hx y hy hQT hyx
  -- Step 1: suppose `4|p_T(y − x)| < σ := |y − x|`; then `0 < σ < δ/2`.
  refine not_lt.mp fun hcon => ?_
  set σ := ‖y - x‖
  have hσ0 : 0 < σ := lt_of_le_of_lt (by positivity) hcon
  -- `|p_{Q(x)}(y − x)| ≤ |p_T(y − x)| + ‖p_{Q(x)} − p_T‖σ < σ/4 + σ/16`.
  have hQy : ‖(Q x).starProjection (y - x)‖ < σ / 4 + σ / 16 := by
    have hsplit : (Q x).starProjection (y - x) =
        T.starProjection (y - x) + ((Q x).starProjection - T.starProjection) (y - x) := by
      simp
    have hop : ‖((Q x).starProjection - T.starProjection) (y - x)‖ < σ / 16 := by
      calc ‖((Q x).starProjection - T.starProjection) (y - x)‖
          ≤ ‖(Q x).starProjection - T.starProjection‖ * σ := ContinuousLinearMap.le_opNorm _ _
        _ < 1 / 16 * σ := by gcongr
        _ = σ / 16 := by ring
    rw [hsplit]
    calc ‖T.starProjection (y - x) + ((Q x).starProjection - T.starProjection) (y - x)‖
        ≤ ‖T.starProjection (y - x)‖ + ‖((Q x).starProjection - T.starProjection) (y - x)‖ :=
          norm_add_le _ _
      _ < σ / 4 + σ / 16 := by linarith
  -- Step 2: `B̄_{σ/8}(y) ⊆ X(x) ∩ B_{2σ}(x)`.
  have hsub : closedBall y (σ / 8) ⊆
      {z | 2 * ‖(Q x).starProjection (z - x)‖ < ‖z - x‖} ∩ ball x (2 * σ) := by
    intro z hz
    have hzy : ‖z - y‖ ≤ σ / 8 := by rwa [mem_closedBall, dist_eq_norm] at hz
    have hdecomp : z - x = (y - x) + (z - y) := by abel
    -- `|p_{Q(x)}(z − x)| ≤ |p_{Q(x)}(y − x)| + |z − y| < 7σ/16`.
    have hQz : ‖(Q x).starProjection (z - x)‖ < 7 * σ / 16 := by
      calc ‖(Q x).starProjection (z - x)‖
          = ‖(Q x).starProjection (y - x) + (Q x).starProjection (z - y)‖ := by
            rw [hdecomp, map_add]
        _ ≤ ‖(Q x).starProjection (y - x)‖ + ‖(Q x).starProjection (z - y)‖ := norm_add_le _ _
        _ ≤ ‖(Q x).starProjection (y - x)‖ + ‖z - y‖ := by
            gcongr; exact (Q x).norm_starProjection_apply_le _
        _ < 7 * σ / 16 := by linarith
    -- `7σ/8 ≤ |z − x| ≤ 9σ/8 < 2σ`.
    have hlow' : σ - ‖z - y‖ ≤ ‖z - x‖ := by
      have := norm_sub_le (z - x) (z - y)
      have h' : (z - x) - (z - y) = y - x := by abel
      rw [h'] at this
      linarith
    have hup' : ‖z - x‖ ≤ σ + ‖z - y‖ := by
      rw [hdecomp]; exact norm_add_le _ _
    refine ⟨?_, ?_⟩
    · show 2 * ‖(Q x).starProjection (z - x)‖ < ‖z - x‖
      linarith
    · rw [mem_ball, dist_eq_norm]
      linarith
  -- Step 3: the density bounds at `y` (radius `σ/8`) and at `x` (radius `2σ`).
  have key : ENNReal.ofReal (a * (σ / 8) ^ n) ≤ ENNReal.ofReal (b * (2 * σ) ^ n) :=
    (hlow y hy (σ / 8) (by positivity) (by linarith)).trans
      ((measure_mono hsub).trans (hup x hx (2 * σ) (by positivity) (by linarith)))
  -- Step 4: `a(σ/8)ⁿ > 0` forces `a(σ/8)ⁿ ≤ b(2σ)ⁿ = b·16ⁿ(σ/8)ⁿ`, so `a ≤ b·16ⁿ`.
  have hs : 0 < (σ / 8) ^ n := by positivity
  have key' : a * (σ / 8) ^ n ≤ b * (2 * σ) ^ n :=
    (ENNReal.ofReal_le_ofReal_iff'.mp key).resolve_right (not_le.mpr (by positivity))
  have h16 : b * (2 * σ) ^ n = b * 16 ^ n * (σ / 8) ^ n := by
    rw [mul_assoc, ← mul_pow]
    congr 2
    ring
  rw [h16] at key'
  have : a ≤ b * 16 ^ n := le_of_mul_le_mul_right key' hs
  linarith
/-- Lipschitz cover under the cone condition (Simon Ch. 3, proof of 1.6, with the extension
theorem Ch. 2, 1.2): if `T ⊆ ℝᴾ` is an `n`-dimensional subspace and `|y − x| ≤ C |p_T(y − x)|` for
all `x, y ∈ D`, then `D ⊆ F(ℝⁿ)` for a Lipschitz `F : ℝⁿ → ℝᴾ`.  With a linear isometry
`ι : T ≅ ℝⁿ` put `L = ι ∘ p_T`, so `|Lv − Lw| = |p_T(v − w)|`; `L` is injective on `D` and its
inverse on `L(D)` is `max C 0`-Lipschitz.  Extend this inverse (McShane, coordinatewise) to a
Lipschitz `F : ℝⁿ → ℝᴾ`; then `F(Lx) = x` for `x ∈ D`. -/
theorem Submission.cbrr_lipschitz_cover_of_cone_condition : ∀ (P n : ℕ) (T : Submodule ℝ (Euclid P)) (D : Set (Euclid P)) (C : ℝ), Module.finrank ℝ T = n → (∀ x ∈ D, ∀ y ∈ D, ‖y - x‖ ≤ C * ‖T.starProjection (y - x)‖) → ∃ F : Euclid n → Euclid P, (∃ K : NNReal, LipschitzWith K F) ∧ D ⊆ range F := by
  intro P n T D C hT hD
  -- Step 1: the cone condition with the constant `K = max C 0 ≥ 0`
  obtain ⟨K, hK⟩ : ∃ K : NNReal, ∀ x ∈ D, ∀ y ∈ D, ‖y - x‖ ≤ K * ‖T.starProjection (y - x)‖ :=
    ⟨C.toNNReal, fun x hx y hy => (hD x hx y hy).trans <| by
      rw [Real.coe_toNNReal']
      exact mul_le_mul_of_nonneg_right (le_max_left _ _) (norm_nonneg _)⟩
  -- Step 2: the chart `L = ι ∘ p_T : ℝᴾ → ℝⁿ`, `ι : T ≅ ℝⁿ` a linear isometry
  let ι : T ≃ₗᵢ[ℝ] Euclid n := ((stdOrthonormalBasis ℝ T).reindex (finCongr hT)).repr
  let L : Euclid P → Euclid n := fun v => ι (T.orthogonalProjectionOnto v)
  have hL : ∀ x ∈ D, ∀ y ∈ D, ‖y - x‖ ≤ K * ‖L y - L x‖ := by
    intro x hx y hy
    have h : ‖L y - L x‖ = ‖T.starProjection (y - x)‖ := by
      simp only [L, ← map_sub, LinearIsometryEquiv.norm_map, Submodule.starProjection_apply,
        Submodule.norm_coe]
    rw [h]
    exact hK x hx y hy
  -- Step 3: `L` is injective on `D`, with a `K`-Lipschitz inverse `g` on `L(D)`
  have hinj : InjOn L D := by
    intro x hx y hy hxy
    have h := hL x hx y hy
    rw [hxy, sub_self, norm_zero, mul_zero] at h
    exact (sub_eq_zero.mp (norm_le_zero_iff.mp h)).symm
  let g : Euclid n → Euclid P := invFunOn L D
  have hgL : ∀ x ∈ D, g (L x) = x := fun x hx => hinj.leftInvOn_invFunOn hx
  have hg : LipschitzOnWith K g (L '' D) := by
    refine LipschitzOnWith.of_dist_le_mul ?_
    rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
    rw [hgL x hx, hgL y hy, dist_eq_norm, dist_eq_norm]
    exact hL y hy x hx
  -- Step 4: extend `g` to a Lipschitz `F : ℝⁿ → ℝᴾ` (McShane in each coordinate)
  obtain ⟨F, hF, hFg⟩ := hg.extend_finite_dimension
  -- Step 5: `F (L x) = g (L x) = x` for `x ∈ D`
  refine ⟨F, ⟨_, hF⟩, fun x hx => ⟨L x, ?_⟩⟩
  rw [← hFg (mem_image_of_mem L hx), hgL x hx]

/-- Rectifiability from uniform density bounds (Simon Ch. 3, proof of Theorem 1.6, steps
(6)–(10) and the final cover).  Take a `1/16`-net `T₁, …, T_N` of `n`-planes and a dense sequence
`(u_q)` in `ℝᴾ`, and cut `E` into the countably many pieces
`D_{j,q} = {x ∈ E : ‖p_{Q(x)} − p_{T_j}‖ < 1/16} ∩ B_{δ/4}(u_q)`.  Two points of `D_{j,q}` are
closer than `δ/2`, so the cone claim gives `|y − x| ≤ 4 |p_{T_j}(y − x)|` on `D_{j,q}`, and
`D_{j,q}` lies in a single Lipschitz image `F_{j,q}(ℝⁿ)`.  The pieces cover `E`, so `E` lies in a
countable union of Lipschitz images of `ℝⁿ`.  (Simon covers a compact `E` by finitely many balls
`B_{δ/4}(x₀)`; centres from a dense sequence make compactness unnecessary.) -/
theorem Submission.cbrr_rectifiable_of_uniform_density : ∀ (P n : ℕ) (μ : Measure (Euclid P)) (E : Set (Euclid P)) (Q : Euclid P → Submodule ℝ (Euclid P)) (a b δ : ℝ), 0 < a → b * 16 ^ n < a → 0 < δ → (∀ x ∈ E, Module.finrank ℝ (Q x) = n) → (∀ y ∈ E, ∀ ρ : ℝ, 0 < ρ → ρ < δ → ENNReal.ofReal (a * ρ ^ n) ≤ μ (closedBall y ρ)) → (∀ x ∈ E, ∀ ρ : ℝ, 0 < ρ → ρ < δ → μ ({z | 2 * ‖(Q x).starProjection (z - x)‖ < ‖z - x‖} ∩ ball x ρ) ≤ ENNReal.ofReal (b * ρ ^ n)) → CountablyRectifiable n E := by
  intro P n μ E Q a b δ ha hab hδ hQ hlow hup
  -- Step 1: a `1/16`-net `T₁, …, T_N` of `n`-planes
  obtain ⟨N, T, hT, hnet⟩ := Submission.cbrr_projection_net P n (1 / 16) (by norm_num)
  -- Step 2: a dense sequence `(u_q)` of centres
  obtain ⟨u, hu⟩ := TopologicalSpace.exists_dense_seq (Euclid P)
  -- Step 3: the pieces `D_{j,q}`
  let D : Fin N × ℕ → Set (Euclid P) := fun p =>
    {x | x ∈ E ∧ ‖(Q x).starProjection - (T p.1).starProjection‖ < 1 / 16} ∩ ball (u p.2) (δ / 4)
  -- Step 4: the cone condition on each piece, whose points are less than `δ / 2` apart
  have hcone : ∀ p, ∀ x ∈ D p, ∀ y ∈ D p, ‖y - x‖ ≤ 4 * ‖(T p.1).starProjection (y - x)‖ := by
    rintro ⟨j, q⟩ x ⟨⟨hxE, hxj⟩, hxq⟩ y ⟨⟨hyE, -⟩, hyq⟩
    refine Submission.cbrr_cone_claim P n μ E Q (T j) a b δ ha hab hlow hup x hxE y hyE hxj ?_
    rw [mem_ball] at hxq hyq
    calc ‖y - x‖ = dist y x := (dist_eq_norm y x).symm
      _ ≤ dist y (u q) + dist x (u q) := dist_triangle_right y x (u q)
      _ < δ / 4 + δ / 4 := add_lt_add hyq hxq
      _ = δ / 2 := by ring
  -- Step 5: each piece lies in one Lipschitz image `F_{j,q}(ℝⁿ)`
  choose F hF hDF using fun p : Fin N × ℕ =>
    Submission.cbrr_lipschitz_cover_of_cone_condition P n (T p.1) (D p) 4 (hT p.1) (hcone p)
  -- Step 6: the pieces cover `E`
  have hcover : E ⊆ ⋃₀ range fun p => range (F p) := by
    intro x hx
    obtain ⟨j, hj⟩ := hnet (Q x) (hQ x hx)
    obtain ⟨q, hq⟩ := hu.exists_dist_lt x (by positivity : (0 : ℝ) < δ / 4)
    exact mem_sUnion.2 ⟨range (F (j, q)), mem_range_self _, hDF (j, q) ⟨⟨hx, hj⟩, mem_ball.2 hq⟩⟩
  -- Step 7: the countably many Lipschitz images are countably `n`-rectifiable, hence so is `E`
  refine (Poincare.SimonGMT.Chapter03.countablyRectifiable_sUnion
    (countable_range fun p => range (F p)) ?_).mono hcover
  rintro _ ⟨p, rfl⟩
  obtain ⟨K, hK⟩ := hF p
  exact Poincare.SimonGMT.Chapter03.countablyRectifiable_range hK

/-- Lower density bound at a point with an approximate tangent plane (Simon Ch. 3, 1.5(3), and
Ch. 4, 4.10(1)): if `Q` is the approximate tangent space of `M` at `x`, `n ≥ 1` and `c < ωₙ`, then
`c ρⁿ ≤ Hⁿ(M ∩ B̄_ρ(x))` for all small `ρ > 0`.  Choose `ε > 0` with `c (1 + ε)ⁿ < ωₙ` and test
against `ψ(y) = max 0 (min 1 ((1 + ε − |y|)/ε))`, so `1_{B̄₁(0)} ≤ ψ ≤ 1_{B̄_{1+ε}(0)}`.  A linear
isometry `ℝⁿ → ℝᴾ` onto `Q` gives `∫_Q ψ dHⁿ ≥ Hⁿ(Q ∩ B₁(0)) = ωₙ`, while
`∫_{η_{x,r}(M)} ψ dHⁿ ≤ Hⁿ(B̄_{1+ε}(0) ∩ η_{x,r}(M)) = r⁻ⁿ Hⁿ(M ∩ B̄_{(1+ε)r}(x))`; the blow-up
integrals converge to `∫_Q ψ dHⁿ`, and `ρ = (1 + ε) r`. -/
theorem Submission.doragm_approxTangent_lower_density : ∀ (P n : ℕ) (M : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)), 0 < n → HasApproximateTangentSpaceAt n M x Q → ∀ c : ℝ≥0∞, c < unitBallVolume n → ∀ᶠ ρ in 𝓝[>] (0 : ℝ), c * ENNReal.ofReal (ρ ^ n) ≤ μHE[n] (M ∩ closedBall x ρ) := by
  intro P n M x Q _hn hQ c hc
  -- Step 1: `ωₙ < ∞`, so `c < ∞`; choose `ε > 0` with `c (1 + ε)ⁿ < ωₙ`
  have hω_top : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
  have hc_top : c ≠ ∞ := ne_top_of_lt hc
  have hcont : Tendsto (fun ε : ℝ => c * ENNReal.ofReal ((1 + ε) ^ n)) (𝓝 0) (𝓝 c) := by
    have h1 : Tendsto (fun ε : ℝ => (1 + ε) ^ n) (𝓝 0) (𝓝 1) := by
      have hc1 : Continuous fun ε : ℝ => (1 + ε) ^ n := by fun_prop
      simpa using hc1.tendsto 0
    simpa using ENNReal.Tendsto.const_mul (ENNReal.tendsto_ofReal h1) (Or.inr hc_top)
  obtain ⟨ε, hεω, hε⟩ := ((hcont.eventually (gt_mem_nhds hc)).filter_mono nhdsWithin_le_nhds |>.and
    (self_mem_nhdsWithin (s := Ioi (0 : ℝ)) (a := 0))).exists
  set A : ℝ := 1 + ε
  have hA : 0 < A := by linarith
  -- Step 2: the test function `ψ(y) = max 0 (min 1 ((1 + ε − |y|)/ε))`
  have hψcs : HasCompactSupport (fun y : Euclid P => max 0 (min 1 ((A - ‖y‖) / ε))) := by
    refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid P) A) fun y hy => ?_
    rw [mem_closedBall, dist_zero_right, not_le] at hy
    have hneg : (A - ‖y‖) / ε < 0 := div_neg_of_neg_of_pos (by linarith) hε
    rw [min_eq_right (hneg.le.trans zero_le_one), max_eq_left hneg.le]
  let ψ : CompactlySupportedContinuousMap (Euclid P) ℝ :=
    ⟨⟨fun y => max 0 (min 1 ((A - ‖y‖) / ε)), continuous_const.max
      (continuous_const.min ((continuous_const.sub continuous_norm).div_const ε))⟩, hψcs⟩
  have hψ_apply : ∀ y, ψ y = max 0 (min 1 ((A - ‖y‖) / ε)) := fun y => rfl
  have hψ0 : ∀ y, 0 ≤ ψ y := fun y => le_max_left _ _
  have hψle1 : ∀ y, ψ y ≤ 1 := fun y => max_le zero_le_one (min_le_left _ _)
  have hψ1 : ∀ y : Euclid P, ‖y‖ ≤ 1 → ψ y = 1 := by
    intro y hy
    have hge : 1 ≤ (A - ‖y‖) / ε := by rw [le_div_iff₀ hε]; linarith
    rw [hψ_apply, min_eq_left hge, max_eq_right zero_le_one]
  have hψ_out : ∀ y : Euclid P, y ∉ closedBall (0 : Euclid P) A → ψ y = 0 := by
    intro y hy
    rw [mem_closedBall, dist_zero_right, not_le] at hy
    have hneg : (A - ‖y‖) / ε < 0 := div_neg_of_neg_of_pos (by linarith) hε
    rw [hψ_apply, min_eq_right (hneg.le.trans zero_le_one), max_eq_left hneg.le]
  -- Step 3: `Hⁿ(Q ∩ B₁(0)) = ωₙ`, via a linear isometry `ℝⁿ → ℝᴾ` onto `Q`
  have hplane : μHE[n] (ball (0 : Euclid P) 1 ∩ (Q : Set (Euclid P))) = unitBallVolume n := by
    let b : OrthonormalBasis (Fin n) ℝ Q := (stdOrthonormalBasis ℝ Q).reindex (finCongr hQ.1)
    have hj : Isometry (Q.subtypeₗᵢ ∘ b.repr.symm) := Q.subtypeₗᵢ.isometry.comp b.repr.symm.isometry
    have himg : (Q.subtypeₗᵢ ∘ b.repr.symm) '' ball (0 : Euclid n) 1 =
        ball (0 : Euclid P) 1 ∩ (Q : Set (Euclid P)) := by
      ext y
      constructor
      · rintro ⟨v, hv, rfl⟩
        refine ⟨?_, (b.repr.symm v).2⟩
        rw [mem_ball_zero_iff] at hv ⊢
        rwa [Function.comp_apply, LinearIsometry.norm_map, LinearIsometryEquiv.norm_map]
      · rintro ⟨hy, hyQ⟩
        refine ⟨b.repr ⟨y, hyQ⟩, ?_, ?_⟩
        · rw [mem_ball_zero_iff] at hy ⊢
          rwa [LinearIsometryEquiv.norm_map, ← Submodule.norm_coe]
        · simp
    rw [← himg, hj.euclideanHausdorffMeasure_image,
      EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
    rfl
  have hL : (unitBallVolume n).toReal ≤ ∫ y in (Q : Set (Euclid P)), ψ y ∂μHE[n] := by
    have := Poincare.SimonGMT.Chapter03.regular_euclideanHausdorffMeasure_restrict_submodule
      (E := Euclid P) hQ.1
    calc (unitBallVolume n).toReal
        = ∫ y in ball (0 : Euclid P) 1, ψ y ∂((μHE[n] : Measure (Euclid P)).restrict Q) := by
          rw [setIntegral_congr_fun measurableSet_ball
            (fun y hy => hψ1 y (mem_ball_zero_iff.mp hy).le),
            setIntegral_const, smul_eq_mul, mul_one, measureReal_def,
            Measure.restrict_apply measurableSet_ball, hplane]
      _ ≤ ∫ y in (Q : Set (Euclid P)), ψ y ∂μHE[n] :=
          setIntegral_le_integral ψ.integrable (Eventually.of_forall hψ0)
  -- the blow-up integrals `a(r) = ∫_{η_r(M)} ψ dHⁿ` converge to `∫_Q ψ dHⁿ ≥ ωₙ > c (1 + ε)ⁿ`
  have hcA_top : c * ENNReal.ofReal (A ^ n) ≠ ∞ := ne_top_of_lt hεω
  have hcA_lt : (c * ENNReal.ofReal (A ^ n)).toReal < ∫ y in (Q : Set (Euclid P)), ψ y ∂μHE[n] :=
    (ENNReal.toReal_strict_mono hω_top hεω).trans_le hL
  have hev : ∀ᶠ r in 𝓝[>] (0 : ℝ), (c * ENNReal.ofReal (A ^ n)).toReal <
      ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, ψ y ∂μHE[n] :=
    (hQ.2 ψ).eventually (lt_mem_nhds hcA_lt)
  -- Step 4: `ofReal (a(r)) ≤ Hⁿ(B̄_A(0) ∩ η_r(M)) = r⁻ⁿ Hⁿ(M ∩ B̄_{rA}(x))`
  have hscale : ∀ r : ℝ, 0 < r → ∀ T : Set (Euclid P),
      μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' T) =
        ENNReal.ofReal (r⁻¹) ^ n * μHE[n] T := by
    intro r hr T
    have himage : Poincare.SimonGMT.Chapter03.blowUpMap x r '' T =
        AffineMap.homothety (0 : Euclid P) r⁻¹ '' ((fun y : Euclid P => y - x) '' T) := by
      rw [Set.image_image]
      refine Set.image_congr fun y _ => ?_
      change r⁻¹ • (y - x) = _
      rw [AffineMap.homothety_apply, vsub_eq_sub, sub_zero, vadd_eq_add, add_zero]
    have hτ : Isometry (fun y : Euclid P => y - x) := (IsometryEquiv.subRight x).isometry
    rw [himage, euclideanHausdorffMeasure_homothety_image n (0 : Euclid P) (inv_ne_zero hr.ne'),
      hτ.euclideanHausdorffMeasure_image, ENNReal.smul_def,
      smul_eq_mul, ENNReal.coe_pow, ← ENNReal.ofReal_coe_nnreal, coe_nnnorm,
      Real.norm_of_nonneg (inv_pos.mpr hr).le]
  have hball : ∀ r : ℝ, 0 < r → closedBall (0 : Euclid P) A ∩
      Poincare.SimonGMT.Chapter03.blowUpMap x r '' M =
        Poincare.SimonGMT.Chapter03.blowUpMap x r '' (M ∩ closedBall x (r * A)) := by
    intro r hr
    have hmem : ∀ y : Euclid P, Poincare.SimonGMT.Chapter03.blowUpMap x r y ∈
        closedBall (0 : Euclid P) A ↔ y ∈ closedBall x (r * A) := by
      intro y
      change r⁻¹ • (y - x) ∈ closedBall (0 : Euclid P) A ↔ y ∈ closedBall x (r * A)
      rw [mem_closedBall_zero_iff, mem_closedBall, dist_eq_norm, norm_smul,
        Real.norm_of_nonneg (inv_pos.mpr hr).le, ← div_eq_inv_mul, div_le_iff₀ hr, mul_comm A r]
    ext y
    constructor
    · rintro ⟨hyB, z, hzM, rfl⟩
      exact ⟨z, ⟨hzM, (hmem z).mp hyB⟩, rfl⟩
    · rintro ⟨z, ⟨hzM, hzB⟩, rfl⟩
      exact ⟨(hmem z).mpr hzB, z, hzM, rfl⟩
  have hupper : ∀ r : ℝ, 0 < r →
      ENNReal.ofReal (∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, ψ y ∂μHE[n]) ≤
        ENNReal.ofReal (r⁻¹) ^ n * μHE[n] (M ∩ closedBall x (r * A)) := by
    intro r hr
    rw [integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall hψ0)
      ψ.continuous.aestronglyMeasurable]
    refine ENNReal.ofReal_toReal_le.trans ?_
    calc ∫⁻ y, ENNReal.ofReal (ψ y)
          ∂((μHE[n] : Measure (Euclid P)).restrict (Poincare.SimonGMT.Chapter03.blowUpMap x r '' M))
        ≤ ∫⁻ y, (closedBall (0 : Euclid P) A).indicator 1 y
          ∂((μHE[n] : Measure (Euclid P)).restrict
            (Poincare.SimonGMT.Chapter03.blowUpMap x r '' M)) := by
          refine lintegral_mono fun y => ?_
          by_cases hy : y ∈ closedBall (0 : Euclid P) A
          · rw [indicator_of_mem hy, Pi.one_apply]
            exact ENNReal.ofReal_le_one.mpr (hψle1 y)
          · rw [hψ_out y hy, ENNReal.ofReal_zero]
            exact zero_le
      _ = μHE[n] (closedBall (0 : Euclid P) A ∩
            Poincare.SimonGMT.Chapter03.blowUpMap x r '' M) := by
          rw [lintegral_indicator_one measurableSet_closedBall,
            Measure.restrict_apply measurableSet_closedBall]
      _ = ENNReal.ofReal (r⁻¹) ^ n * μHE[n] (M ∩ closedBall x (r * A)) := by
          rw [hball r hr, hscale r hr]
  -- Step 5: `c (rA)ⁿ ≤ Hⁿ(M ∩ B̄_{rA}(x))` for small `r > 0`; reparametrize `ρ = rA`
  have hev2 : ∀ᶠ r in 𝓝[>] (0 : ℝ),
      c * ENNReal.ofReal ((r * A) ^ n) ≤ μHE[n] (M ∩ closedBall x (r * A)) := by
    filter_upwards [hev, self_mem_nhdsWithin] with r hr hr0
    have hr0' : 0 < r := hr0
    have h1 : c * ENNReal.ofReal (A ^ n) ≤
        ENNReal.ofReal (r⁻¹) ^ n * μHE[n] (M ∩ closedBall x (r * A)) := by
      rw [← ENNReal.ofReal_toReal hcA_top]
      exact (ENNReal.ofReal_le_ofReal hr.le).trans (hupper r hr0')
    calc c * ENNReal.ofReal ((r * A) ^ n)
        = c * ENNReal.ofReal (A ^ n) * ENNReal.ofReal r ^ n := by
          rw [mul_pow, ENNReal.ofReal_mul (pow_nonneg hr0'.le n), ENNReal.ofReal_pow hr0'.le,
            mul_comm (ENNReal.ofReal r ^ n), mul_assoc]
      _ ≤ ENNReal.ofReal (r⁻¹) ^ n * μHE[n] (M ∩ closedBall x (r * A)) * ENNReal.ofReal r ^ n := by
          gcongr
      _ = μHE[n] (M ∩ closedBall x (r * A)) := by
          rw [mul_comm (ENNReal.ofReal (r⁻¹) ^ n), mul_assoc, ← mul_pow,
            ← ENNReal.ofReal_mul (inv_nonneg.mpr hr0'.le), inv_mul_cancel₀ hr0'.ne',
            ENNReal.ofReal_one, one_pow, mul_one]
  have htend : Tendsto (fun ρ : ℝ => ρ / A) (𝓝[>] (0 : ℝ)) (𝓝[>] (0 : ℝ)) := by
    refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
    · simpa using ((continuous_id.div_const A).tendsto (0 : ℝ)).mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with ρ hρ
      exact div_pos hρ hA
  filter_upwards [htend.eventually hev2] with ρ hρ
  rwa [div_mul_cancel₀ ρ hA.ne'] at hρ
/-- **`Hⁿ` of a disc in an `n`-plane**: if `Q ⊆ ℝᴾ` is an `n`-dimensional subspace and `r ≥ 0`, then
`Hⁿ(Q ∩ B̄_r(0)) = rⁿ ωₙ`.  An orthonormal basis of `Q` gives a linear isometry `j : ℝⁿ → ℝᴾ`
with `j(B̄_r(0)) = Q ∩ B̄_r(0)`; `Hⁿ` is invariant under isometries and equals Lebesgue measure on
`ℝⁿ`, and `Lⁿ(B̄_r(0)) = rⁿ Lⁿ(B₁(0))`. -/
theorem Submission.cbrr_tcd_plane_closedBall_measure : ∀ (P n : ℕ) (Q : Submodule ℝ (Euclid P)), Module.finrank ℝ Q = n → ∀ r : ℝ, 0 ≤ r → μHE[n] ((Q : Set (Euclid P)) ∩ closedBall 0 r) = ENNReal.ofReal (r ^ n) * unitBallVolume n := by
  intro P n Q hQ r hr
  -- Step 1: an orthonormal basis `b` of `Q` indexed by `Fin n`
  let b : OrthonormalBasis (Fin n) ℝ Q := (stdOrthonormalBasis ℝ Q).reindex (finCongr hQ)
  -- Step 2: the isometry `j = ι ∘ b.repr.symm : ℝⁿ → ℝᴾ`
  have hj : Isometry (Q.subtypeₗᵢ ∘ b.repr.symm) := Q.subtypeₗᵢ.isometry.comp b.repr.symm.isometry
  -- Step 3: `j(B̄_r(0)) = Q ∩ B̄_r(0)`
  have himg : (Q.subtypeₗᵢ ∘ b.repr.symm) '' closedBall (0 : Euclid n) r =
      (Q : Set (Euclid P)) ∩ closedBall 0 r := by
    ext y
    constructor
    · rintro ⟨v, hv, rfl⟩
      refine ⟨(b.repr.symm v).2, ?_⟩
      rw [mem_closedBall_zero_iff] at hv ⊢
      rwa [Function.comp_apply, LinearIsometry.norm_map, LinearIsometryEquiv.norm_map]
    · rintro ⟨hyQ, hy⟩
      refine ⟨b.repr ⟨y, hyQ⟩, ?_, ?_⟩
      · rw [mem_closedBall_zero_iff] at hy ⊢
        rwa [LinearIsometryEquiv.norm_map, ← Submodule.norm_coe]
      · simp
  -- Steps 4–7: isometry invariance, `Hⁿ = Lⁿ` on `ℝⁿ`, Haar scaling, and `ωₙ = Lⁿ(B₁(0))`
  rw [← himg, hj.euclideanHausdorffMeasure_image,
    EuclideanSpace.euclideanHausdorffMeasure_eq_volume, Measure.addHaar_closedBall _ _ hr,
    finrank_euclideanSpace_fin]
  rfl
/-- **Cutoff for the cone `X = {y : 2|p_Q y| < |y|}`**: for a subspace `Q ⊆ ℝᴾ` and `δ > 0` there
is `f ∈ C_c(ℝᴾ)` with `0 ≤ f ≤ 1`, `f = 1` on `X ∩ B₁(0)` and `f = 0` on `Q \ B̄_δ(0)`.  With
`s = δ/4` take `f = φχ`, `φ(y) = max(0, min(1, 1 + ((3/4)|y| − |p_Q y|)/s))` and
`χ(y) = max(0, min(1, 2 − |y|))`; `f` vanishes outside `B̄₂(0)`. -/
theorem Submission.cbrr_tcd_cone_cutoff_exists : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (δ : ℝ), 0 < δ → ∃ f : CompactlySupportedContinuousMap (Euclid P) ℝ, (∀ y, 0 ≤ f y) ∧ (∀ y, f y ≤ 1) ∧ (∀ y : Euclid P, 2 * ‖Q.starProjection y‖ < ‖y‖ → ‖y‖ < 1 → f y = 1) ∧ ∀ y ∈ Q, δ < ‖y‖ → f y = 0 := by
  intro P Q δ hδ
  -- Step 1: `s = δ/4`, `h(y) = (3/4)|y| − |p_Q y|`, `φ = max(0, min(1, 1 + h/s))`,
  -- `χ = max(0, min(1, 2 − |y|))`.
  set s : ℝ := δ / 4 with hs_def
  have hs : 0 < s := by positivity
  let φ : Euclid P → ℝ := fun y => max 0 (min 1 (1 + (3 / 4 * ‖y‖ - ‖Q.starProjection y‖) / s))
  let χ : Euclid P → ℝ := fun y => max 0 (min 1 (2 - ‖y‖))
  -- Step 2: `φ` and `χ` are continuous (`p_Q` is a continuous linear map).
  have hφ : Continuous φ :=
    continuous_const.max (continuous_const.min (continuous_const.add
      (((continuous_const.mul continuous_norm).sub Q.starProjection.continuous.norm).div_const s)))
  have hχ : Continuous χ :=
    continuous_const.max (continuous_const.min (continuous_const.sub continuous_norm))
  -- Step 3: `χ`, hence `φχ`, vanishes outside the compact ball `B̄₂(0)`.
  have hsupp : HasCompactSupport fun y => φ y * χ y := by
    refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid P) 2) fun y hy => ?_
    rw [mem_closedBall_zero_iff, not_le] at hy
    have hχy : χ y = 0 := by
      simp only [χ]
      rw [min_eq_right (by linarith), max_eq_left (by linarith)]
    simp [hχy]
  let f : CompactlySupportedContinuousMap (Euclid P) ℝ :=
    { toFun := fun y => φ y * χ y
      continuous_toFun := hφ.mul hχ
      hasCompactSupport' := hsupp }
  have hf : ∀ y, f y = φ y * χ y := fun _ => rfl
  -- Step 4: `max(0, min(1, a)) ∈ [0, 1]`, so `0 ≤ φ, χ ≤ 1` and `0 ≤ φχ ≤ φ ≤ 1`.
  have hclamp : ∀ a : ℝ, 0 ≤ max 0 (min 1 a) ∧ max 0 (min 1 a) ≤ 1 := fun a =>
    ⟨le_max_left _ _, max_le zero_le_one (min_le_left _ _)⟩
  refine ⟨f, fun y => ?_, fun y => ?_, fun y hX hB => ?_, fun y hyQ hyδ => ?_⟩
  · rw [hf]
    exact mul_nonneg (hclamp _).1 (hclamp _).1
  · rw [hf]
    calc φ y * χ y ≤ φ y * 1 := mul_le_mul_of_nonneg_left (hclamp _).2 (hclamp _).1
      _ = φ y := mul_one _
      _ ≤ 1 := (hclamp _).2
  -- Step 5: if `2|p_Q y| < |y| < 1` then `h(y) > |y|/4 ≥ 0`, so `φ(y) = 1`; and `χ(y) = 1`.
  · have hh : 0 ≤ (3 / 4 * ‖y‖ - ‖Q.starProjection y‖) / s :=
      div_nonneg (by linarith [norm_nonneg y]) hs.le
    have hφy : φ y = 1 := by
      simp only [φ]
      rw [min_eq_left (by linarith), max_eq_right zero_le_one]
    have hχy : χ y = 1 := by
      simp only [χ]
      rw [min_eq_left (by linarith), max_eq_right zero_le_one]
    rw [hf, hφy, hχy, one_mul]
  -- Step 6: if `y ∈ Q` and `|y| > δ` then `p_Q y = y`, so `1 + h(y)/s = 1 − |y|/δ < 0` and
  -- `φ(y) = 0`.
  · have hp : Q.starProjection y = y := Submodule.starProjection_eq_self_iff.mpr hyQ
    have hneg : 1 + (3 / 4 * ‖y‖ - ‖y‖) / s < 0 := by
      have h1 : (3 / 4 * ‖y‖ - ‖y‖) / s = -(‖y‖ / δ) := by
        rw [hs_def]
        field_simp
        ring
      have h2 : 1 < ‖y‖ / δ := (one_lt_div hδ).mpr hyδ
      linarith
    have hφy : φ y = 0 := by
      simp only [φ]
      rw [hp, min_eq_right (by linarith), max_eq_left hneg.le]
    rw [hf, hφy, zero_mul]

/-- **`Hⁿ` under the blow-up map `η_{x,r}(y) = r⁻¹(y − x)`, `r > 0`**: `Hⁿ(η_{x,r}(S)) = r⁻ⁿ Hⁿ(S)`
for every `S ⊆ ℝᴾ`, the scaling used in the proof of Simon Ch. 3, Theorem 1.6 "⇒".  `η_{x,r}` is
the translation `y ↦ y + (−x)`, an isometry, followed by the dilation `z ↦ r⁻¹z`, and
`Hⁿ(cT) = |c|ⁿ Hⁿ(T)` for `c ≠ 0`. -/
theorem Submission.rsd_cmr_ir_blowUp_image_measure : ∀ (P n : ℕ) (x : Euclid P) (r : ℝ) (S : Set (Euclid P)), 0 < r → μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' S) = ENNReal.ofReal (r⁻¹ ^ n) * μHE[n] S := by
  intro P n x r S hr
  -- `η_{x,r}(S) = r⁻¹ • (S + (−x))`: `η_{x,r}(y) = r⁻¹ • (y − x)` and `y − x = y + (−x)`.
  have hS : Poincare.SimonGMT.Chapter03.blowUpMap x r '' S =
      (fun z => r⁻¹ • z) '' ((fun y => y + -x) '' S) := by
    rw [Set.image_image]
    rfl
  -- `Hⁿ(r⁻¹ • T) = ‖r⁻¹‖₊ⁿ • Hⁿ(T)`, translation invariance, and `‖r⁻¹‖₊ⁿ = r⁻¹ ^ n` for `r > 0`.
  rw [hS, Set.image_smul, Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hr.ne'),
    (isometry_add_right (-x)).euclideanHausdorffMeasure_image, ENNReal.smul_def, smul_eq_mul,
    ← ENNReal.ofReal_coe_nnreal]
  congr 2
  simp [abs_of_pos hr]

/-- **Small-scale upper bound at an approximate tangent point**: if `Q` is the approximate tangent
space of `M` at `x` (Simon Ch. 3, 1.4), `Hⁿ(M) < ∞`, and `f ∈ C_c(ℝᴾ)` satisfies `f ≥ 0` and
`f ≥ 1` on the measurable set `U`, then `Hⁿ(M ∩ η_{x,r}⁻¹(U)) ≤ t rⁿ` for all small `r > 0`
whenever `∫_Q f dHⁿ < t`.  Indeed `Hⁿ(η_{x,r}(M) ∩ U) ≤ ∫_{η_{x,r}(M)} f dHⁿ → ∫_Q f dHⁿ`, and
`η_{x,r}(M) ∩ U = η_{x,r}(M ∩ η_{x,r}⁻¹(U))` has measure `r⁻ⁿ Hⁿ(M ∩ η_{x,r}⁻¹(U))`. -/
theorem Submission.cbrr_tcd_blowUp_preimage_le_of_testFunction : ∀ (P n : ℕ) (M : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)) (U : Set (Euclid P)) (f : CompactlySupportedContinuousMap (Euclid P) ℝ), μHE[n] M ≠ ∞ → HasApproximateTangentSpaceAt n M x Q → MeasurableSet U → (∀ y, 0 ≤ f y) → (∀ y ∈ U, 1 ≤ f y) → ∀ t : ℝ≥0∞, ENNReal.ofReal (∫ y in (Q : Set (Euclid P)), f y ∂μHE[n]) < t → ∀ᶠ r in 𝓝[>] (0 : ℝ), μHE[n] (M ∩ Poincare.SimonGMT.Chapter03.blowUpMap x r ⁻¹' U) ≤ t * ENNReal.ofReal (r ^ n) := by
  intro P n M x Q U f hM hT hU hf0 hfU t ht
  -- `t = ∞`: the right-hand side is `∞` for every `r > 0`.
  rcases eq_or_ne t ∞ with rfl | htop
  · filter_upwards [self_mem_nhdsWithin] with r hr
    rw [ENNReal.top_mul (ENNReal.ofReal_pos.2 (pow_pos hr n)).ne']
    exact le_top
  -- `∫_Q f dHⁿ < t`, and `∫_{η_{x,r}(M)} f dHⁿ → ∫_Q f dHⁿ`, so eventually `∫_{η_{x,r}(M)} f < t`.
  have hL : ∫ y in (Q : Set (Euclid P)), f y ∂μHE[n] < t.toReal :=
    (ENNReal.ofReal_lt_iff_lt_toReal (integral_nonneg hf0) htop).1 ht
  filter_upwards [self_mem_nhdsWithin, (hT.2 f).eventually (gt_mem_nhds hL)] with r hr hI
  have hr0 : (0 : ℝ) < r := hr
  set η := Poincare.SimonGMT.Chapter03.blowUpMap x r
  -- `Hⁿ(η_{x,r}(M)) = r⁻ⁿ Hⁿ(M) < ∞`, so `f` is integrable for `Hⁿ⌞η_{x,r}(M)`.
  have hfin : μHE[n] (η '' M) ≠ ∞ := by
    rw [Submission.rsd_cmr_ir_blowUp_image_measure P n x r M hr0]
    exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top hM
  have : IsFiniteMeasure (μHE[n].restrict (η '' M)) := isFiniteMeasure_restrict.2 hfin
  have hint : Integrable f (μHE[n].restrict (η '' M)) := f.integrable
  -- `Hⁿ(η_{x,r}(M) ∩ U) = ∫ 1_U d(Hⁿ⌞η_{x,r}(M)) ≤ ∫_{η_{x,r}(M)} f dHⁿ ≤ t`.
  have hle : μHE[n] (η '' M ∩ U) ≤ t := by
    calc μHE[n] (η '' M ∩ U) = μHE[n].restrict (η '' M) U := by
          rw [Measure.restrict_apply hU, Set.inter_comm]
      _ = ∫⁻ y, U.indicator 1 y ∂(μHE[n].restrict (η '' M)) := (lintegral_indicator_one hU).symm
      _ ≤ ∫⁻ y, ENNReal.ofReal (f y) ∂(μHE[n].restrict (η '' M)) := by
          refine lintegral_mono fun y => ?_
          by_cases hy : y ∈ U
          · rw [Set.indicator_of_mem hy, Pi.one_apply]
            exact ENNReal.one_le_ofReal.2 (hfU y hy)
          · rw [Set.indicator_of_notMem hy]
            exact zero_le
      _ = ENNReal.ofReal (∫ y in η '' M, f y ∂μHE[n]) :=
          (ofReal_integral_eq_lintegral_ofReal hint (Eventually.of_forall hf0)).symm
      _ ≤ ENNReal.ofReal t.toReal := ENNReal.ofReal_le_ofReal hI.le
      _ = t := ENNReal.ofReal_toReal htop
  -- `η_{x,r}(M) ∩ U = η_{x,r}(M ∩ η_{x,r}⁻¹(U))`, whose measure is `r⁻ⁿ Hⁿ(M ∩ η_{x,r}⁻¹(U))`.
  have hscale : μHE[n] (η '' M ∩ U) = ENNReal.ofReal (r⁻¹ ^ n) * μHE[n] (M ∩ η ⁻¹' U) := by
    rw [← Set.image_inter_preimage]
    exact Submission.rsd_cmr_ir_blowUp_image_measure P n x r _ hr0
  have hcancel : ENNReal.ofReal (r ^ n) * ENNReal.ofReal (r⁻¹ ^ n) = 1 := by
    rw [← ENNReal.ofReal_mul (pow_nonneg hr0.le n), ← mul_pow, mul_inv_cancel₀ hr0.ne', one_pow,
      ENNReal.ofReal_one]
  calc μHE[n] (M ∩ η ⁻¹' U)
      = ENNReal.ofReal (r ^ n) * (ENNReal.ofReal (r⁻¹ ^ n) * μHE[n] (M ∩ η ⁻¹' U)) := by
        rw [← mul_assoc, hcancel, one_mul]
    _ ≤ ENNReal.ofReal (r ^ n) * t := by
        rw [← hscale]
        gcongr
    _ = t * ENNReal.ofReal (r ^ n) := mul_comm _ _

/-- **Vanishing density in the cone about the normal space** (Simon Ch. 3, Remark 1.5(3), second
half, and formula (6) in the proof of Theorem 1.6): if `Q` is the approximate tangent space of `M`
at `x`, `n ≥ 1` and `Hⁿ(M) < ∞`, then for every `t > 0`, `Hⁿ(M ∩ X(x) ∩ B_ρ(x)) ≤ t ρⁿ` for all
small `ρ > 0`, where `X(x) = {z : 2|p_Q(z − x)| < |z − x|} = X_{1/2}((TₓM)^⊥, x)`.  Choose `δ > 0`
with `Hⁿ(Q ∩ B̄_δ(0)) = δⁿωₙ < t` and `f ∈ C_c` with `0 ≤ f ≤ 1`, `f = 1` on `X ∩ B₁(0)` and
`f = 0` on `Q \ B̄_δ(0)`.  Then `∫_Q f dHⁿ ≤ Hⁿ(Q ∩ B̄_δ(0)) < t`, so the blow-up bound gives
`Hⁿ(M ∩ η_{x,r}⁻¹(X ∩ B₁(0))) ≤ t rⁿ` for small `r > 0`, and `η_{x,r}⁻¹(X ∩ B₁(0)) = X(x) ∩ B_r(x)`. -/
theorem Submission.cbrr_tangent_cone_density_zero : ∀ (P n : ℕ) (M : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)), 0 < n → μHE[n] M ≠ ∞ → HasApproximateTangentSpaceAt n M x Q → ∀ t : ℝ≥0∞, 0 < t → ∀ᶠ ρ in 𝓝[>] (0 : ℝ), μHE[n] (M ∩ ({z | 2 * ‖Q.starProjection (z - x)‖ < ‖z - x‖} ∩ ball x ρ)) ≤ t * ENNReal.ofReal (ρ ^ n) := by
  intro P n M x Q hn hM hQ t ht
  -- Step 1: `ωₙ < ∞` and `n ≥ 1`, so `δⁿωₙ → 0` as `δ → 0`; choose `δ > 0` with `δⁿωₙ < t`, so
  -- that `Hⁿ(Q ∩ B̄_δ(0)) = δⁿωₙ < t` (`dim Q = n`)
  have hω_top : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
  have hlim : Tendsto (fun δ : ℝ => ENNReal.ofReal (δ ^ n) * unitBallVolume n) (𝓝 0) (𝓝 0) := by
    have h0 : Tendsto (fun δ : ℝ => δ ^ n) (𝓝 0) (𝓝 0) := by
      have h := (continuous_pow n).tendsto (0 : ℝ)
      rwa [zero_pow hn.ne'] at h
    have h := ENNReal.Tendsto.mul_const (ENNReal.tendsto_ofReal h0) (Or.inr hω_top)
    rwa [ENNReal.ofReal_zero, zero_mul] at h
  obtain ⟨δ, hδt, hδ⟩ := ((hlim.eventually (gt_mem_nhds ht)).filter_mono nhdsWithin_le_nhds |>.and
    (self_mem_nhdsWithin (s := Ioi (0 : ℝ)) (a := 0))).exists
  have hδ0 : 0 < δ := hδ
  have hplane : μHE[n] ((Q : Set (Euclid P)) ∩ closedBall 0 δ) < t := by
    rw [Submission.cbrr_tcd_plane_closedBall_measure P n Q hQ.1 δ hδ0.le]
    exact hδt
  -- Step 2: the cutoff `f ∈ C_c`: `0 ≤ f ≤ 1`, `f = 1` on `X ∩ B₁(0)`, `f = 0` on `Q \ B̄_δ(0)`
  obtain ⟨f, hf0, hf1, hfX, hfQ⟩ := Submission.cbrr_tcd_cone_cutoff_exists P Q δ hδ0
  -- Step 3: `ofReal (∫_Q f dHⁿ) ≤ ∫⁻_Q ofReal ∘ f dHⁿ ≤ Hⁿ(Q ∩ B̄_δ(0)) < t`, as
  -- `ofReal ∘ f ≤ 1_{B̄_δ(0)}` on `Q`
  have hQm : MeasurableSet (Q : Set (Euclid P)) := Q.closed_of_finiteDimensional.measurableSet
  have hint : ENNReal.ofReal (∫ y in (Q : Set (Euclid P)), f y ∂μHE[n]) < t := by
    refine lt_of_le_of_lt ?_ hplane
    rw [integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall hf0)
      f.continuous.aestronglyMeasurable]
    refine ENNReal.ofReal_toReal_le.trans ?_
    calc ∫⁻ y in (Q : Set (Euclid P)), ENNReal.ofReal (f y) ∂μHE[n]
        ≤ ∫⁻ y in (Q : Set (Euclid P)), (closedBall (0 : Euclid P) δ).indicator 1 y ∂μHE[n] := by
          refine setLIntegral_mono' hQm fun y hy => ?_
          by_cases hyδ : y ∈ closedBall (0 : Euclid P) δ
          · rw [indicator_of_mem hyδ, Pi.one_apply]
            exact ENNReal.ofReal_le_one.mpr (hf1 y)
          · rw [mem_closedBall_zero_iff, not_le] at hyδ
            rw [hfQ y hy hyδ, ENNReal.ofReal_zero]
            exact zero_le
      _ = μHE[n] ((Q : Set (Euclid P)) ∩ closedBall 0 δ) := by
          rw [lintegral_indicator_one measurableSet_closedBall,
            Measure.restrict_apply measurableSet_closedBall, inter_comm]
  -- Step 4: the blow-up bound for the open set `U = X ∩ B₁(0)`, on which `f = 1`
  set U : Set (Euclid P) := {y | 2 * ‖Q.starProjection y‖ < ‖y‖} ∩ ball 0 1
  have hU : IsOpen U :=
    (isOpen_lt (continuous_const.mul Q.starProjection.continuous.norm) continuous_norm).inter
      isOpen_ball
  have hfU : ∀ y ∈ U, 1 ≤ f y := fun y hy => (hfX y hy.1 (mem_ball_zero_iff.mp hy.2)).ge
  filter_upwards [Submission.cbrr_tcd_blowUp_preimage_le_of_testFunction P n M x Q U f hM hQ
    hU.measurableSet hf0 hfU t hint, self_mem_nhdsWithin] with r hr hr0
  -- Step 5: for `r > 0`, `η_{x,r}⁻¹(X ∩ B₁(0)) = X(x) ∩ B_r(x)`, since `η_{x,r}(z) = r⁻¹(z − x)`,
  -- `p_Q` is linear and `|r⁻¹v| = r⁻¹|v|`
  have hr0' : 0 < r := hr0
  have hrinv : 0 < r⁻¹ := inv_pos.mpr hr0'
  have hset : {z | 2 * ‖Q.starProjection (z - x)‖ < ‖z - x‖} ∩ ball x r =
      Poincare.SimonGMT.Chapter03.blowUpMap x r ⁻¹' U := by
    ext z
    have hnorm : ‖r⁻¹ • (z - x)‖ = r⁻¹ * ‖z - x‖ := by
      rw [norm_smul, Real.norm_of_nonneg hrinv.le]
    have hproj : ‖Q.starProjection (r⁻¹ • (z - x))‖ = r⁻¹ * ‖Q.starProjection (z - x)‖ := by
      rw [map_smul, norm_smul, Real.norm_of_nonneg hrinv.le]
    change 2 * ‖Q.starProjection (z - x)‖ < ‖z - x‖ ∧ dist z x < r ↔
      2 * ‖Q.starProjection (r⁻¹ • (z - x))‖ < ‖r⁻¹ • (z - x)‖ ∧ dist (r⁻¹ • (z - x)) 0 < 1
    rw [dist_eq_norm, dist_eq_norm, sub_zero, hproj, hnorm, mul_left_comm,
      mul_lt_mul_iff_right₀ hrinv, inv_mul_lt_iff₀ hr0', mul_one]
  rw [hset]
  exact hr

/-- **Lusin's theorem for an a.e. strongly measurable map, keeping an a.e. property** (the closed
set `F` of Simon Ch. 3, proof of Theorem 1.6 "⇐", (4)): if `A` is measurable with `μ(A) < ∞`,
`f : ℝᴾ → Y` is `μ⌞A`-a.e. strongly measurable into a pseudo-metrizable, second-countable `Y` and
`p` holds `μ⌞A`-a.e., then for every `η ≠ 0` there is a compact `K ⊆ A` with `μ(A \ K) < η` on
which `p` holds and `f` is continuous.  With the Borel σ-algebra on `Y`, the strongly measurable
representative `g` of `f` is measurable.  The bad set `Z = {f ≠ g} ∪ {¬p}` has
`μ(Z ∩ A) = μ⌞A(Z) = 0`, so a measurable `μ`-null `N ⊇ Z ∩ A` leaves `A \ N`, on which `f = g`
and `p` hold.  Lusin's theorem for `g` on `A \ N` gives `K`, and `A \ K ⊆ N ∪ ((A \ N) \ K)`. -/
theorem Submission.cbrr_ud_lusin_of_aestronglyMeasurable : ∀ (P : ℕ) {Y : Type} [TopologicalSpace Y] [TopologicalSpace.PseudoMetrizableSpace Y] [SecondCountableTopology Y] (μ : Measure (Euclid P)) (A : Set (Euclid P)) (f : Euclid P → Y) (p : Euclid P → Prop), MeasurableSet A → μ A ≠ ∞ → AEStronglyMeasurable f (μ.restrict A) → (∀ᵐ x ∂(μ.restrict A), p x) → ∀ η : ℝ≥0∞, η ≠ 0 → ∃ K : Set (Euclid P), IsCompact K ∧ K ⊆ A ∧ μ (A \ K) < η ∧ (∀ x ∈ K, p x) ∧ ContinuousOn f K := by
  intro P Y _ _ _ μ A f p hA hμA hf hp η hη
  -- Step 1: give `Y` its Borel σ-algebra; the strongly measurable representative `g = hf.mk f`
  -- of `f` is then measurable, and `f = g` `μ⌞A`-a.e.
  borelize Y
  have hg : Measurable (hf.mk f) := hf.measurable_mk
  -- Step 2: the bad set `Z = {f ≠ g} ∪ {¬p}` has `μ (Z ∩ A) = μ⌞A Z = 0`; a measurable `μ`-null
  -- `N ⊇ Z ∩ A` leaves the measurable `A \ N`, on which `f = g` and `p` hold
  have hZ : μ ({x | ¬(f x = hf.mk f x ∧ p x)} ∩ A) = 0 := by
    rw [← Measure.restrict_apply' hA]
    exact ae_iff.mp (hf.ae_eq_mk.and hp)
  obtain ⟨N, hZN, hN, hN0⟩ := exists_measurable_superset_of_null hZ
  have hgood : ∀ x ∈ A \ N, f x = hf.mk f x ∧ p x := fun x hx =>
    not_not.mp fun h => hx.2 (hZN ⟨h, hx.1⟩)
  -- Step 3: Lusin's theorem for `g` on `A \ N`: a compact `K ⊆ A \ N` with `μ ((A \ N) \ K) < η`
  -- on which `g` is continuous
  obtain ⟨K, hK, hKA, hKμ, hgK⟩ := Submission.dor_ims_lusin_measurable_continuousOn P μ (A \ N)
    (hf.mk f) η hg (hA.diff hN) (measure_ne_top_of_subset sdiff_subset hμA) hη
  -- Step 4: `f = g` and `p` hold on `K ⊆ A \ N`, and `A \ K ⊆ N ∪ (A \ N) \ K` with `μ N = 0`
  refine ⟨K, hK, hKA.trans sdiff_subset, ?_, fun x hx => (hgood x (hKA hx)).2,
    hgK.congr fun x hx => (hgood x (hKA hx)).1⟩
  calc μ (A \ K)
      ≤ μ (N ∪ (A \ N) \ K) := by
        refine measure_mono fun x hx => ?_
        by_cases hxN : x ∈ N
        · exact Or.inl hxN
        · exact Or.inr ⟨⟨hx.1, hxN⟩, hx.2⟩
    _ ≤ μ N + μ ((A \ N) \ K) := measure_union_le _ _
    _ = μ ((A \ N) \ K) := by rw [hN0, zero_add]
    _ < η := hKμ
/-- **Upper semicontinuity of closed-ball mass** (for Egoroff's theorem in Simon Ch. 3, proof of
Theorem 1.6, (7)–(8)): for a finite measure `μ` on `ℝᴾ`, `ρ ∈ ℝ` and `s ∈ [0, ∞]`, the set
`{y : s ≤ μ(B̄_ρ(y))}` is closed.  If `yᵢ → y` and `s ≤ μ(B̄_ρ(yᵢ))` for all `i`, the open
complements `U = B̄_ρ(y)ᶜ` and `Uᵢ = B̄_ρ(yᵢ)ᶜ` satisfy `1_U ≤ liminf 1_{Uᵢ}`, so Fatou's lemma
gives `μ(U) ≤ liminf μ(Uᵢ) ≤ μ(ℝᴾ) − s`; as `μ` is finite and `s ≤ μ(ℝᴾ)`,
`μ(B̄_ρ(y)) = μ(ℝᴾ) − μ(U) ≥ s`. -/
theorem Submission.cbrr_ud_isClosed_closedBall_mass_ge : ∀ (P : ℕ) (μ : Measure (Euclid P)) [IsFiniteMeasure μ] (ρ : ℝ) (s : ℝ≥0∞), IsClosed {y : Euclid P | s ≤ μ (closedBall y ρ)} := by
  intro P μ _ ρ s
  -- Step 1: `ℝᴾ` is a sequential space; let `yᵢ → y` with `s ≤ μ(B̄_ρ(yᵢ))` for all `i`
  refine IsSeqClosed.isClosed fun ys y hys hlim => ?_
  replace hys : ∀ i, s ≤ μ (closedBall (ys i) ρ) := hys
  show s ≤ μ (closedBall y ρ)
  -- Step 2: the complements `U = B̄_ρ(y)ᶜ` and `Uᵢ = B̄_ρ(yᵢ)ᶜ` are open, hence Borel
  have hU : ∀ x : Euclid P, MeasurableSet (closedBall x ρ)ᶜ :=
    fun x => measurableSet_closedBall.compl
  -- Step 3: `1_U ≤ liminf 1_{Uᵢ}`: if `|z − y| > ρ`, then `|z − yᵢ| > ρ` for all large `i`
  have hpt : ∀ z, (closedBall y ρ)ᶜ.indicator 1 z ≤
      liminf (fun i => (closedBall (ys i) ρ)ᶜ.indicator (1 : Euclid P → ℝ≥0∞) z) atTop := by
    intro z
    by_cases hz : z ∈ closedBall y ρ
    · rw [indicator_of_notMem (not_not.mpr hz)]
      exact zero_le
    · rw [mem_closedBall, not_le] at hz
      refine le_liminf_of_le (by isBoundedDefault) ?_
      filter_upwards [(tendsto_const_nhds.dist hlim).eventually (lt_mem_nhds hz)] with i hi
      rw [indicator_of_mem (not_le.mpr hz), indicator_of_mem (not_le.mpr hi)]
  -- Step 4: Fatou's lemma gives `μ(U) ≤ liminf μ(Uᵢ)`
  have hfatou : μ (closedBall y ρ)ᶜ ≤ liminf (fun i => μ (closedBall (ys i) ρ)ᶜ) atTop :=
    calc μ (closedBall y ρ)ᶜ = ∫⁻ z, (closedBall y ρ)ᶜ.indicator 1 z ∂μ :=
          (lintegral_indicator_one (hU y)).symm
      _ ≤ ∫⁻ z, liminf (fun i => (closedBall (ys i) ρ)ᶜ.indicator 1 z) atTop ∂μ :=
          lintegral_mono hpt
      _ ≤ liminf (fun i => ∫⁻ z, (closedBall (ys i) ρ)ᶜ.indicator 1 z ∂μ) atTop :=
          lintegral_liminf_le fun i => measurable_one.indicator (hU (ys i))
      _ = liminf (fun i => μ (closedBall (ys i) ρ)ᶜ) atTop := by
          simp_rw [lintegral_indicator_one (hU _)]
  -- Step 5: `μ(Uᵢ) = μ(ℝᴾ) − μ(B̄_ρ(yᵢ)) ≤ μ(ℝᴾ) − s` for every `i`, so `μ(U) ≤ μ(ℝᴾ) − s`
  have hUle : μ (closedBall y ρ)ᶜ ≤ μ univ - s := by
    refine hfatou.trans (liminf_le_of_frequently_le' (Frequently.of_forall fun i => ?_))
    rw [measure_compl measurableSet_closedBall (measure_ne_top _ _)]
    exact tsub_le_tsub_left (hys i) _
  -- Step 6: `s ≤ μ(B̄_ρ(y₀)) ≤ μ(ℝᴾ) < ∞`, so
  -- `μ(B̄_ρ(y)) = μ(ℝᴾ) − μ(U) ≥ μ(ℝᴾ) − (μ(ℝᴾ) − s) = s`
  have hs : s ≤ μ univ := (hys 0).trans (measure_mono (subset_univ _))
  calc s = μ univ - (μ univ - s) := (ENNReal.sub_sub_cancel (measure_ne_top _ _) hs).symm
    _ ≤ μ univ - μ (closedBall y ρ)ᶜ := tsub_le_tsub_left hUle _
    _ = μ (closedBall y ρ) := by
        rw [← measure_compl (hU y) (measure_ne_top _ _), compl_compl]
/-- **Closed cone-mass sublevel sets** (Simon Ch. 3, proof of Theorem 1.6 "⇐", (7)–(8); this
closedness replaces the measurability of the functions `q_k` there).  Let `F` be closed and
`w ↦ p_{Q(w)}` continuous on `F`, and put `S(w) = X(w) ∩ B_ρ(w)`, where
`X(w) = {z : 2|p_{Q(w)}(z − w)| < |z − w|}`.  Then `{x ∈ F : μ(S(x)) ≤ s}` is closed.  Let
`xᵢ → x` in this set; then `x ∈ F`.  Each `S(w)` is open.  As `p_{Q(xᵢ)} → p_{Q(x)}`, every
`z ∈ S(x)` lies in `S(xᵢ)` for all large `i`, so `1_{S(x)} ≤ liminf 1_{S(xᵢ)}`.  Fatou's lemma
gives `μ(S(x)) ≤ liminf μ(S(xᵢ)) ≤ s`. -/
theorem Submission.cbrr_ud_isClosed_cone_mass_le : ∀ (P : ℕ) (μ : Measure (Euclid P)) (F : Set (Euclid P)) (Q : Euclid P → Submodule ℝ (Euclid P)) (ρ : ℝ) (s : ℝ≥0∞), IsClosed F → ContinuousOn (fun x => (Q x).starProjection) F → IsClosed {x | x ∈ F ∧ μ ({z | 2 * ‖(Q x).starProjection (z - x)‖ < ‖z - x‖} ∩ ball x ρ) ≤ s} := by
  intro P μ F Q ρ s hF hQ
  -- Step 1: sequential closedness; the limit `x` of the `xᵢ ∈ F` lies in the closed set `F`
  refine IsSeqClosed.isClosed fun xs x hxs hx => ?_
  have hxsF : ∀ i, xs i ∈ F := fun i => (hxs i).1
  have hxF : x ∈ F := hF.mem_of_tendsto hx (Eventually.of_forall hxsF)
  refine ⟨hxF, ?_⟩
  set S : Euclid P → Set (Euclid P) := fun w =>
    {z | 2 * ‖(Q w).starProjection (z - w)‖ < ‖z - w‖} ∩ ball w ρ
  change μ (S x) ≤ s
  -- Step 2: every `S(w) = X(w) ∩ B_ρ(w)` is open, hence measurable
  have hSm : ∀ w, MeasurableSet (S w) := fun w =>
    ((isOpen_lt (continuous_const.mul ((Q w).starProjection.continuous.comp
      (continuous_id.sub continuous_const)).norm) (continuous_id.sub continuous_const).norm).inter
      isOpen_ball).measurableSet
  -- Step 3: `xᵢ → x` within `F`, where `w ↦ p_{Q(w)}` is continuous
  have hxW : Tendsto xs atTop (𝓝[F] x) :=
    tendsto_nhdsWithin_iff.mpr ⟨hx, Eventually.of_forall hxsF⟩
  -- Step 4: `2|p_{Q(xᵢ)}(z − xᵢ)| − |z − xᵢ| → 2|p_{Q(x)}(z − x)| − |z − x| < 0` and
  -- `|z − xᵢ| → |z − x| < ρ`, so every `z ∈ S(x)` lies in `S(xᵢ)` for all large `i`
  have hev : ∀ z ∈ S x, ∀ᶠ i in atTop, z ∈ S (xs i) := by
    intro z hz
    have hcont : ContinuousWithinAt
        (fun w => 2 * ‖(Q w).starProjection (z - w)‖ - ‖z - w‖) F x :=
      (continuousWithinAt_const.mul ((hQ x hxF).clm_apply
        (continuousWithinAt_const.sub continuousWithinAt_id)).norm).sub
        (continuousWithinAt_const.sub continuousWithinAt_id).norm
    have h1 := (hcont.tendsto.comp hxW).eventually (gt_mem_nhds (sub_neg.mpr hz.1))
    have h2 := (tendsto_const_nhds.dist hx).eventually (gt_mem_nhds (mem_ball.mp hz.2))
    filter_upwards [h1, h2] with i hi1 hi2
    exact ⟨sub_neg.mp hi1, hi2⟩
  -- Step 5: `1_{S(x)} ≤ liminf 1_{S(xᵢ)}` pointwise, and Fatou's lemma
  calc μ (S x) = ∫⁻ z, (S x).indicator 1 z ∂μ := (lintegral_indicator_one (hSm x)).symm
    _ ≤ ∫⁻ z, liminf (fun i => (S (xs i)).indicator 1 z) atTop ∂μ := by
        refine lintegral_mono fun z => ?_
        by_cases hz : z ∈ S x
        · rw [indicator_of_mem hz]
          refine le_liminf_of_le (by isBoundedDefault) ?_
          filter_upwards [hev z hz] with i hi
          rw [indicator_of_mem hi]
        · rw [indicator_of_notMem hz]
          exact zero_le
    _ ≤ liminf (fun i => ∫⁻ z, (S (xs i)).indicator 1 z ∂μ) atTop :=
        lintegral_liminf_le fun i => measurable_one.indicator (hSm (xs i))
    _ = liminf (fun i => μ (S (xs i))) atTop := by simp_rw [lintegral_indicator_one (hSm _)]
    _ ≤ s := liminf_le_of_frequently_le' (Frequently.of_forall fun i => (hxs i).2)
/-- Uniform version of an eventual property on a set of finite measure (Simon Ch. 3, proof of 1.6
“⇐”, (7)–(9): Egoroff's theorem carried out on sets).  If `μ(F) < ∞`, every `T ρ` with `ρ > 0`
is closed and each `x ∈ F` lies in `T ρ` for all small `ρ > 0`, then for `η ≠ 0` there are
`E ⊆ F` with `μ(F \ E) < η` and `δ > 0` such that `E ⊆ T ρ` whenever `0 < ρ < δ`.  The Borel
sets `G_k = F ∩ ⋂_{0 < ρ < 1/(k+1)} T ρ` increase to `F`, so `μ(F \ G_k) → 0` by continuity
from above; take `E = G_k` and `δ = 1/(k+1)` for a large `k`. -/
theorem Submission.cbrr_ud_uniformize_eventually : ∀ (P : ℕ) (μ : Measure (Euclid P)) (F : Set (Euclid P)) (T : ℝ → Set (Euclid P)), MeasurableSet F → μ F ≠ ∞ → (∀ ρ : ℝ, 0 < ρ → IsClosed (T ρ)) → (∀ x ∈ F, ∀ᶠ ρ in 𝓝[>] (0 : ℝ), x ∈ T ρ) → ∀ η : ℝ≥0∞, η ≠ 0 → ∃ (E : Set (Euclid P)) (δ : ℝ), E ⊆ F ∧ 0 < δ ∧ μ (F \ E) < η ∧ ∀ x ∈ E, ∀ ρ : ℝ, 0 < ρ → ρ < δ → x ∈ T ρ := by
  intro P μ F T hF hμF hT hev η hη
  -- `G_k = F ∩ ⋂_{0 < ρ < 1/(k+1)} T ρ` is Borel, each `T ρ` with `ρ > 0` being closed
  let G : ℕ → Set (Euclid P) := fun k => F ∩ ⋂ ρ ∈ Ioo (0 : ℝ) (1 / ((k : ℝ) + 1)), T ρ
  have hG : ∀ k, MeasurableSet (G k) := fun k =>
    hF.inter (isClosed_biInter fun ρ hρ => hT ρ hρ.1).measurableSet
  -- `G_k` increases with `k`, so `F \ G_k` decreases
  have hanti : Antitone fun k => F \ G k := fun i j hij =>
    sdiff_subset_sdiff_right (inter_subset_inter_right F
      (biInter_subset_biInter_left (Ioo_subset_Ioo_right (Nat.one_div_le_one_div hij))))
  -- `⋃_k G_k = F`: a point of `F` lies in `T ρ` for `0 < ρ < r`, and `1/(k+1) < r` for some `k`
  have hempty : ⋂ k, F \ G k = ∅ := by
    refine eq_empty_of_forall_notMem fun x hx => ?_
    have hxF : x ∈ F := (mem_iInter.mp hx 0).1
    obtain ⟨r, hr, hrT⟩ := (nhdsGT_basis (0 : ℝ)).eventually_iff.mp (hev x hxF)
    obtain ⟨k, hk⟩ := exists_nat_one_div_lt hr
    exact (mem_iInter.mp hx k).2 ⟨hxF, mem_iInter₂.mpr fun ρ hρ => hrT ⟨hρ.1, hρ.2.trans hk⟩⟩
  -- continuity from above: `μ (F \ G_k) → μ ∅ = 0`
  have hlim : Tendsto (fun k => μ (F \ G k)) atTop (𝓝 0) := by
    have h := tendsto_measure_iInter_atTop (μ := μ) (fun k => (hF.diff (hG k)).nullMeasurableSet)
      hanti ⟨0, measure_ne_top_of_subset sdiff_subset hμF⟩
    rwa [hempty, measure_empty] at h
  -- some `k` has `μ (F \ G_k) < η`; take `E = G_k` and `δ = 1/(k+1)`
  obtain ⟨k, hk⟩ := (hlim.eventually (gt_mem_nhds (pos_iff_ne_zero.mpr hη))).exists
  exact ⟨G k, 1 / ((k : ℝ) + 1), inter_subset_left, Nat.one_div_pos_of_nat, hk,
    fun x hx ρ hρ hρk => mem_iInter₂.mp hx.2 ρ ⟨hρ, hρk⟩⟩
/-- **Uniform lower density and cone bounds on a set of almost full measure** (Simon Ch. 3, proof
of Theorem 1.6 “⇐”, (4)–(9)).  Let `μ = Hⁿ⌞M` with `Hⁿ(M) < ∞`, let `x ↦ p_{Q(x)}` be `μ`-a.e.
strongly measurable and let `Q(x)` be the approximate tangent space of `M` at `μ`-a.e. `x`.  If
`ofReal a < ωₙ`, `b > 0` and `ε > 0`, there are `E ⊆ M` with `Hⁿ(M \ E) < ε` and `δ > 0` such that
for `x ∈ E` and `0 < ρ < δ`: `dim Q(x) = n`, `aρⁿ ≤ μ(B̄_ρ(x))` and `μ(X(x) ∩ B_ρ(x)) ≤ bρⁿ`,
where `X(x) = {z : 2|p_{Q(x)}(z − x)| < |z − x|}`.  Lusin's theorem gives a compact `K ⊆ M` of
tangent points with `Hⁿ(M \ K) < ε/2` on which `x ↦ p_{Q(x)}` is continuous.  The set `T_ρ` of
points of `K` with both bounds at radius `ρ` is closed, and each `x ∈ K` lies in `T_ρ` for all
small `ρ > 0` by the lower density and cone density bounds.  Uniformizing gives `E ⊆ K` with
`Hⁿ(K \ E) < ε/2` and `δ > 0` with `E ⊆ T_ρ` for `0 < ρ < δ`. -/
theorem Submission.cbrr_uniform_density_on_large_set : ∀ (P n : ℕ) (M : Set (Euclid P)) (Q : Euclid P → Submodule ℝ (Euclid P)), 0 < n → MeasurableSet M → μHE[n] M ≠ ∞ → AEStronglyMeasurable (fun x => (Q x).starProjection) (μHE[n].restrict M) → (∀ᵐ x ∂(μHE[n].restrict M), HasApproximateTangentSpaceAt n M x (Q x)) → ∀ (a b ε : ℝ), ENNReal.ofReal a < unitBallVolume n → 0 < b → 0 < ε → ∃ (E : Set (Euclid P)) (δ : ℝ), E ⊆ M ∧ 0 < δ ∧ μHE[n] (M \ E) < ENNReal.ofReal ε ∧ (∀ x ∈ E, Module.finrank ℝ (Q x) = n) ∧ (∀ y ∈ E, ∀ ρ : ℝ, 0 < ρ → ρ < δ → ENNReal.ofReal (a * ρ ^ n) ≤ (μHE[n].restrict M) (closedBall y ρ)) ∧ ∀ x ∈ E, ∀ ρ : ℝ, 0 < ρ → ρ < δ → (μHE[n].restrict M) ({z | 2 * ‖(Q x).starProjection (z - x)‖ < ‖z - x‖} ∩ ball x ρ) ≤ ENNReal.ofReal (b * ρ ^ n) := by
  intro P n M Q hn hM hMfin hQm hQt a b ε ha hb hε
  -- Step 1: `μ = Hⁿ⌞M` is finite, and `ofReal (ε/2) ≠ 0`
  have : IsFiniteMeasure (μHE[n].restrict M) := isFiniteMeasure_restrict.mpr hMfin
  have hε2 : ENNReal.ofReal (ε / 2) ≠ 0 := (ENNReal.ofReal_pos.mpr (half_pos hε)).ne'
  -- Step 2: Lusin's theorem: a compact `K ⊆ M` of tangent points with `Hⁿ(M \ K) < ε/2`, on which
  -- `x ↦ p_{Q(x)}` is continuous
  obtain ⟨K, hK, hKM, hMK, hKt, hKc⟩ := Submission.cbrr_ud_lusin_of_aestronglyMeasurable P
    μHE[n] M (fun x => (Q x).starProjection) (fun x => HasApproximateTangentSpaceAt n M x (Q x))
    hM hMfin hQm hQt (ENNReal.ofReal (ε / 2)) hε2
  -- Step 3: `T_ρ = {y : ofReal(aρⁿ) ≤ μ(B̄_ρ(y))} ∩ {x ∈ K : μ(X(x) ∩ B_ρ(x)) ≤ ofReal(bρⁿ)}` is
  -- closed: closed-ball mass is upper semicontinuous, and cone mass is lower semicontinuous on the
  -- closed set `K`, where `x ↦ p_{Q(x)}` is continuous
  set T : ℝ → Set (Euclid P) := fun ρ =>
    {y | ENNReal.ofReal (a * ρ ^ n) ≤ (μHE[n].restrict M) (closedBall y ρ)} ∩
      {x | x ∈ K ∧ (μHE[n].restrict M) ({z | 2 * ‖(Q x).starProjection (z - x)‖ < ‖z - x‖} ∩
        ball x ρ) ≤ ENNReal.ofReal (b * ρ ^ n)}
  have hTc : ∀ ρ : ℝ, 0 < ρ → IsClosed (T ρ) := fun ρ _ =>
    (Submission.cbrr_ud_isClosed_closedBall_mass_ge P (μHE[n].restrict M) ρ
      (ENNReal.ofReal (a * ρ ^ n))).inter
      (Submission.cbrr_ud_isClosed_cone_mass_le P (μHE[n].restrict M) K Q ρ
        (ENNReal.ofReal (b * ρ ^ n)) hK.isClosed hKc)
  -- Step 4: every `x ∈ K` lies in `T_ρ` for all small `ρ > 0`, by the lower density bound with
  -- `c = ofReal a` and the cone density bound with `t = ofReal b`; here `μ(S) = Hⁿ(M ∩ S)` and
  -- `ofReal(cρⁿ) = ofReal c · ofReal ρⁿ` (`ρⁿ ≥ 0`)
  have hTev : ∀ x ∈ K, ∀ᶠ ρ in 𝓝[>] (0 : ℝ), x ∈ T ρ := by
    intro x hx
    filter_upwards [Submission.doragm_approxTangent_lower_density P n M x (Q x) hn (hKt x hx)
      (ENNReal.ofReal a) ha, Submission.cbrr_tangent_cone_density_zero P n M x (Q x) hn hMfin
      (hKt x hx) (ENNReal.ofReal b) (ENNReal.ofReal_pos.mpr hb), self_mem_nhdsWithin]
      with ρ hρa hρb hρ
    have hρn : 0 ≤ ρ ^ n := pow_nonneg (le_of_lt (show 0 < ρ from hρ)) n
    refine ⟨?_, hx, ?_⟩
    · show ENNReal.ofReal (a * ρ ^ n) ≤ (μHE[n].restrict M) (closedBall x ρ)
      rw [ENNReal.ofReal_mul' hρn, Measure.restrict_apply' hM, inter_comm]
      exact hρa
    · show (μHE[n].restrict M) ({z | 2 * ‖(Q x).starProjection (z - x)‖ < ‖z - x‖} ∩ ball x ρ) ≤
        ENNReal.ofReal (b * ρ ^ n)
      rw [ENNReal.ofReal_mul hb.le, Measure.restrict_apply' hM, inter_comm]
      exact hρb
  -- Step 5: uniformize: `E ⊆ K` with `Hⁿ(K \ E) < ε/2` and `δ > 0` with `E ⊆ T_ρ` for `0 < ρ < δ`
  obtain ⟨E, δ, hEK, hδ, hKE, hET⟩ := Submission.cbrr_ud_uniformize_eventually P μHE[n] K T
    hK.isClosed.measurableSet (measure_ne_top_of_subset hKM hMfin) hTc hTev
    (ENNReal.ofReal (ε / 2)) hε2
  -- Step 6: `E ⊆ K ⊆ M` consists of tangent points, both bounds come from `T_ρ`, and
  -- `M \ E ⊆ (M \ K) ∪ (K \ E)`, so `Hⁿ(M \ E) < ε/2 + ε/2 = ε`
  refine ⟨E, δ, hEK.trans hKM, hδ, ?_, fun x hx => (hKt x (hEK hx)).1,
    fun y hy ρ hρ hρδ => (hET y hy ρ hρ hρδ).1, fun x hx ρ hρ hρδ => (hET x hx ρ hρ hρδ).2.2⟩
  calc μHE[n] (M \ E)
      ≤ μHE[n] ((M \ K) ∪ (K \ E)) := by
        refine measure_mono fun x hx => ?_
        by_cases hxK : x ∈ K
        · exact Or.inr ⟨hxK, hx.2⟩
        · exact Or.inl ⟨hx.1, hxK⟩
    _ ≤ μHE[n] (M \ K) + μHE[n] (K \ E) := measure_union_le _ _
    _ < ENNReal.ofReal (ε / 2) + ENNReal.ofReal (ε / 2) := ENNReal.add_lt_add hMK hKE
    _ = ENNReal.ofReal ε := by
        rw [← ENNReal.ofReal_add (half_pos hε).le (half_pos hε).le, add_halves]
/-- **Approximate tangent spaces imply rectifiability** (Simon Ch. 3, Theorem 1.6 “⇐”).  Let
`Hⁿ(M) < ∞`, let `x ↦ p_{Q(x)}` be `Hⁿ⌞M`-a.e. strongly measurable and let `Q(x)` be the
approximate tangent space of `M` at `Hⁿ`-a.e. `x ∈ M`; then `M` is countably `n`-rectifiable.  For
`n = 0`, `M` is finite.  For `n > 0` fix `0 < a` with `a < ωₙ` and `b = a/2/16ⁿ`, so
`b·16ⁿ = a/2 < a`.  For every `m` the uniform lower density and cone bounds hold on some `E_m ⊆ M`
with `Hⁿ(M \ E_m) < 1/(m+1)`, so `E_m` is countably `n`-rectifiable.  Then `M \ ⋃ E_m` is
`Hⁿ`-null, and `M` lies in this null set together with countably many Lipschitz images. -/
theorem Submission.dtc_bc_tc_cl_rectifiable_of_approx_tangent : ∀ (P n : ℕ) (M : Set (Euclid P)) (Q : Euclid P → Submodule ℝ (Euclid P)), MeasurableSet M → μHE[n] M ≠ ∞ → AEStronglyMeasurable (fun x => (Q x).starProjection) (μHE[n].restrict M) → (∀ᵐ x ∂(μHE[n].restrict M), HasApproximateTangentSpaceAt n M x (Q x)) → CountablyRectifiable n M := by
  intro P n M Q hM hMfin hQm hQt
  -- Step 1: for `n = 0` the set `M` is finite
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · exact Submission.cbrr_rectifiable_dim_zero P M hMfin
  -- Step 2: constants `0 < a` with `ofReal a < ωₙ` and `b = a/2/16ⁿ > 0`, so `b·16ⁿ = a/2 < a`
  obtain ⟨a, -, ha, haω⟩ := ENNReal.lt_iff_exists_real_btwn.mp
    (measure_ball_pos volume (0 : Euclid n) one_pos : 0 < unitBallVolume n)
  rw [ENNReal.ofReal_pos] at ha
  have hb : 0 < a / 2 / 16 ^ n := by positivity
  have hab : a / 2 / 16 ^ n * 16 ^ n < a := by
    rw [div_mul_cancel₀ _ (by positivity : (16 : ℝ) ^ n ≠ 0)]
    exact half_lt_self ha
  -- Step 3: for every `m`, the uniform density and cone bounds hold on some `E_m ⊆ M` with
  -- `Hⁿ(M \ E_m) < 1/(m+1)`, so `E_m` is countably `n`-rectifiable
  have hE : ∀ m : ℕ, ∃ E : Set (Euclid P), μHE[n] (M \ E) < ENNReal.ofReal (1 / ((m : ℝ) + 1)) ∧
      CountablyRectifiable n E := by
    intro m
    obtain ⟨E, δ, -, hδ, hME, hQE, hlow, hup⟩ := Submission.cbrr_uniform_density_on_large_set P n
      M Q hn hM hMfin hQm hQt a (a / 2 / 16 ^ n) (1 / ((m : ℝ) + 1)) haω hb Nat.one_div_pos_of_nat
    exact ⟨E, hME, Submission.cbrr_rectifiable_of_uniform_density P n (μHE[n].restrict M) E Q a
      (a / 2 / 16 ^ n) δ ha hab hδ hQE hlow hup⟩
  choose E hME hErect using hE
  -- Step 4: `M \ ⋃ E_m ⊆ M \ E_m` has `Hⁿ`-measure `< 1/(m+1)` for every `m`, so it is null
  have hlim := ENNReal.tendsto_ofReal tendsto_one_div_add_atTop_nhds_zero_nat
  rw [ENNReal.ofReal_zero] at hlim
  have hnull : μHE[n] (M \ ⋃ m, E m) = 0 := nonpos_iff_eq_zero.mp <| ge_of_tendsto' hlim fun m =>
    (measure_mono (sdiff_subset_sdiff_right (subset_iUnion E m))).trans (hME m).le
  -- Step 5: `M ⊆ (M \ ⋃ E_m) ∪ ⋃ E_m`, a null set together with countably many Lipschitz images
  obtain ⟨M₀, hM₀, F, hF, hcover⟩ := Poincare.SimonGMT.Chapter03.countablyRectifiable_iUnion E hErect
  refine ⟨M₀ ∪ (M \ ⋃ m, E m), measure_union_null hM₀ hnull, F, hF, fun x hx => ?_⟩
  by_cases hxE : x ∈ ⋃ m, E m
  · exact (hcover hxE).imp_left Or.inl
  · exact Or.inl (Or.inr ⟨hx, hxE⟩)

/-- **Representation of a current of locally finite mass by its mass measure** (Simon Ch. 6,
2.7–2.8, without the absolute-continuity clause; `|·|` is `covectorEuclideanNorm`).  `|α| = ‖A α‖`
for the coefficient map `A` (`dor_ims_sua_coeff_norm_rep`), and `|α| = 0` forces every `α(e_j)` to
vanish (`regcomp_covector_sq_sum_basisFun`), so an orthonormal basis of `range A` gives
`c : Λⁿ ≃ ℝᵈ` with `|α| = ‖c α‖`.  Admissibility of `±s⁻¹ω` gives `|T(ω)| ≤ r M_W(T)` when
`spt ω ⊆ W` and `|ω| ≤ r`, so `T(ωₖ)` converges along test forms `ωₖ → G` uniformly with supports
in one open `W ⊂⊂ U` (they exist by `dor_ims_sua_mollify_unit_field`) to a limit `Φ(G)` that is
linear in `G`, equals `T(ω)` on test forms and is bounded by `r M_W(T)`.  The vector Riesz theorem
(`cmr_vector_riesz_representation`) on the locally compact `U` gives `Φ(c⁻¹ ∘ g) = ∫ ⟨g, ν⟩ dμ₀`
on `C_c(U, ℝᵈ)`.  With `ν̂ = ν/‖ν‖`, `μ = val_*(‖ν‖ μ₀)`, `ξ(α) = ⟨ν̂, c α⟩` and `β = c⁻¹ ∘ ν̂`:
`μ(Uᶜ) = 0`, `μ` is finite on compact subsets of `U`, `|ξ(α)| ≤ |α|`, `|β| ≤ 1`, `ξ(β) = 1`
`μ`-a.e. and `T(ω) = ∫ ξ(ω) dμ`.  Hence `M_W(T) ≤ μ(W)`; conversely Lusin
(`dor_ims_lusin_continuousOn`) and a test form `ω ≈ β` near a compact `K' ⊆ W ∩ U`
(`dor_ims_smooth_unit_approx`) give `T(ω) ≥ (1 − δ) μ(K') − μ(V \ K')`, close to `μ(W)`. -/
theorem Submission.dtc_bc_lc_fd_dfm_mass_representation_core : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) := by
  intro P n U T hU hfin
  -- Step 1: coordinates `c : Λⁿ ≃ ℝᵈ` with `|α| = ‖c α‖`
  obtain ⟨d, c, hc⟩ : ∃ (d : ℕ) (c : Covector (Euclid P) n ≃L[ℝ] EuclideanSpace ℝ (Fin d)),
      ∀ α : Covector (Euclid P) n, covectorEuclideanNorm α = ‖c α‖ := by
    obtain ⟨A, hA⟩ : ∃ A : Covector (Euclid P) n →ₗ[ℝ] EuclideanSpace ℝ (Fin n → Fin P),
        ∀ α, covectorEuclideanNorm α = ‖A α‖ := by
      obtain ⟨A, hA⟩ := Submission.dor_ims_sua_coeff_norm_rep P n
      exact ⟨A, hA⟩
    -- `A` is injective: `|α| = 0` forces `α(e_j) = 0` for every `j : Fin n → Fin P`
    have hinj : Function.Injective A := by
      refine (injective_iff_map_eq_zero A).2 fun α hα => ?_
      have h0 : ∑ j : Fin n → Fin P,
          (α (fun k => EuclideanSpace.basisFun (Fin P) ℝ (j k))) ^ 2 = 0 := by
        rw [Submission.regcomp_covector_sq_sum_basisFun, hA, hα, norm_zero]
        ring
      have hj : ∀ j : Fin n → Fin P,
          α (fun k => EuclideanSpace.basisFun (Fin P) ℝ (j k)) = 0 := by
        intro j
        have h := (Finset.sum_eq_zero_iff_of_nonneg fun i _ =>
          sq_nonneg (α (fun k => EuclideanSpace.basisFun (Fin P) ℝ (i k)))).1 h0 j
            (Finset.mem_univ j)
        exact (pow_eq_zero_iff two_ne_zero).1 h
      exact ContinuousAlternatingMap.toAlternatingMap_injective
        ((EuclideanSpace.basisFun (Fin P) ℝ).toBasis.ext_alternating fun v _ => by
          simpa using hj v)
    -- an orthonormal basis of `range A` identifies it isometrically with `ℝᵈ`
    have : FiniteDimensional ℝ (Covector (Euclid P) n) :=
      Submission.dor_ims_sua_covector_finiteDimensional P n
    let b := stdOrthonormalBasis ℝ (LinearMap.range A)
    let e₀ : Covector (Euclid P) n ≃ₗ[ℝ] LinearMap.range A := LinearEquiv.ofInjective A hinj
    refine ⟨Module.finrank ℝ (LinearMap.range A),
      (e₀.trans b.repr.toLinearEquiv).toContinuousLinearEquiv, fun α => ?_⟩
    show covectorEuclideanNorm α = ‖b.repr (e₀ α)‖
    rw [hA, LinearIsometryEquiv.norm_map, ← Submodule.norm_coe, LinearEquiv.ofInjective_apply]
  -- Steps 2–3: a linear `L` on `C_c(U, ℝᵈ)` with `L(c ∘ ω) = T(ω)`, bounded on each compact set
  obtain ⟨L, hLT, hLb⟩ : ∃ L : CompactlySupportedContinuousMap U (EuclideanSpace ℝ (Fin d)) →ₗ[ℝ] ℝ,
      (∀ (ω : TestFormOn U n) (g : CompactlySupportedContinuousMap U (EuclideanSpace ℝ (Fin d))),
        (∀ x : U, g x = c ((ω : DifferentialForm (Euclid P) n) x)) → L g = T ω) ∧
      ∀ K : Set U, IsCompact K → ∃ M : ℝ, ∀ g : CompactlySupportedContinuousMap U
        (EuclideanSpace ℝ (Fin d)), tsupport g ⊆ K → (∀ x, ‖g x‖ ≤ 1) → |L g| ≤ M := by
    -- `|α + β| ≤ |α| + |β|`, `|α - β| ≤ |α| + |β|` and `|t • α| = |t| |α|`, read through `c`
    have hadd : ∀ α β : Covector (Euclid P) n,
        covectorEuclideanNorm (α + β) ≤ covectorEuclideanNorm α + covectorEuclideanNorm β := by
      intro α β
      rw [hc, hc, hc, map_add]
      exact norm_add_le _ _
    have htri : ∀ α β : Covector (Euclid P) n,
        covectorEuclideanNorm (α - β) ≤ covectorEuclideanNorm α + covectorEuclideanNorm β := by
      intro α β
      rw [hc, hc, hc, map_sub]
      exact norm_sub_le _ _
    have hsmul : ∀ (t : ℝ) (α : Covector (Euclid P) n),
        covectorEuclideanNorm (t • α) = |t| * covectorEuclideanNorm α := by
      intro t α
      rw [hc, hc, map_smul, norm_smul, Real.norm_eq_abs]
    -- Step 2: `|T(ω)| ≤ r m(W)`, `m(W) = M_W(T)`, when `W ⊂⊂ U` is open, `spt ω ⊆ W`, `|ω| ≤ r`
    obtain ⟨m, hm⟩ : ∃ m : Set (Euclid P) → ℝ, ∀ (W : Set (Euclid P)) (ω : TestFormOn U n) (r : ℝ),
        IsOpen W → CompactlyContained W U → tsupport (ω : DifferentialForm (Euclid P) n) ⊆ W →
        (∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) x) ≤ r) →
        |T ω| ≤ r * m W := by
      refine ⟨fun W => (T.massOn W).toReal, fun W ω r hW hWU hωW hr => ?_⟩
      have hM : T.massOn W ≠ ∞ := (hfin W hW hWU).ne
      have hr0 : 0 ≤ r := (covectorEuclideanNorm_nonneg _).trans (hr 0)
      -- `|T(ω)| ≤ s M_W(T)` for `0 < s`, `r ≤ s`: every `t • ω` with `|t| ≤ s⁻¹` is admissible
      have hbound : ∀ s : ℝ, 0 < s → r ≤ s → |T ω| ≤ s * (T.massOn W).toReal := by
        intro s hs hrs
        have hadm : ∀ t : ℝ, |t| ≤ s⁻¹ → t * T ω ≤ (T.massOn W).toReal := by
          intro t ht
          have hmem : t • ω ∈ massAdmissibleOn U n W := by
            refine ⟨(tsupport_smul_subset_right (fun _ => t) _).trans hωW, fun x => ?_⟩
            show covectorEuclideanNorm (t • (ω : DifferentialForm (Euclid P) n) x) ≤ 1
            rw [hsmul]
            calc |t| * covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) x) ≤ s⁻¹ * s :=
                  mul_le_mul ht ((hr x).trans hrs) (covectorEuclideanNorm_nonneg _)
                    (inv_nonneg.2 hs.le)
              _ = 1 := inv_mul_cancel₀ hs.ne'
          have h := (ENNReal.ofReal_le_iff_le_toReal hM).1 (T.le_massOn hmem)
          rwa [show T (t • ω) = t * T ω from T.toCurrent.map_smul t ω] at h
        have h1 := hadm s⁻¹ (abs_of_pos (inv_pos.2 hs)).le
        have h2 := hadm (-s⁻¹) (by rw [abs_neg, abs_of_pos (inv_pos.2 hs)])
        rw [neg_mul, ← mul_neg] at h2
        rw [abs_le]
        exact ⟨neg_le.1 ((inv_mul_le_iff₀ hs).1 h2), (inv_mul_le_iff₀ hs).1 h1⟩
      -- let `s ↓ r`
      have hlim : Tendsto (fun s : ℝ => s * (T.massOn W).toReal) (𝓝[>] r)
          (𝓝 (r * (T.massOn W).toReal)) :=
        ((continuous_mul_const _).tendsto r).mono_left nhdsWithin_le_nhds
      exact ge_of_tendsto hlim
        (eventually_nhdsWithin_of_forall fun s hs => hbound s (hr0.trans_lt hs) (le_of_lt hs))
    -- Step 3a: a continuous `G` with compact support in an open `V` is a uniform limit of test
    -- forms supported in `V`: mollify `s⁻¹ G`, `s ≥ |G|`, and rescale
    have happ : ∀ (V : Set (Euclid P)) (G : Euclid P → Covector (Euclid P) n) (ε : ℝ), IsOpen V →
        Continuous G → HasCompactSupport G → tsupport G ⊆ V → 0 < ε →
        ∃ ω : DifferentialForm (Euclid P) n, IsTestForm ω ∧ tsupport ω ⊆ V ∧
          ∀ x, covectorEuclideanNorm (ω x - G x) ≤ ε := by
      intro V G ε hV hGc hGs hGV hε
      obtain ⟨C, hC⟩ := (hGs.comp_left (map_zero c)).exists_bound_of_continuous
        (c.continuous.comp hGc)
      set s : ℝ := max C 0 + 1
      have hs : 0 < s := by positivity
      have hGb : ∀ x, covectorEuclideanNorm (G x) ≤ s := fun x => by
        rw [hc]
        exact (hC x).trans ((le_max_left C 0).trans (le_add_of_nonneg_right zero_le_one))
      set g : Euclid P → Covector (Euclid P) n := fun x => s⁻¹ • G x with hg_def
      have hgc : Continuous g := hGc.const_smul s⁻¹
      have hgG : support g ⊆ support G := fun x hx h => hx (by simp [g, h])
      have hgs : HasCompactSupport g := hGs.mono hgG
      have hgV : tsupport g ⊆ V := (closure_mono hgG).trans hGV
      have hg1 : ∀ x, covectorEuclideanNorm (g x) ≤ 1 := fun x => by
        rw [hg_def, hsmul, abs_of_pos (inv_pos.2 hs), inv_mul_le_iff₀ hs, mul_one]
        exact hGb x
      obtain ⟨ω₀, ⟨hω₀s, hω₀c⟩, hω₀V, -, hω₀g⟩ :=
        Submission.dor_ims_sua_mollify_unit_field P n V g (ε / s) hV hgc hgs hgV hg1 (div_pos hε hs)
      refine ⟨fun x => s • ω₀ x, ⟨ContDiff.const_smul (𝕜 := ℝ) s hω₀s,
        hω₀c.smul_left (f := fun _ => s)⟩, (tsupport_smul_subset_right (fun _ => s) ω₀).trans hω₀V,
        fun x => ?_⟩
      have hdiff : s • ω₀ x - G x = s • (ω₀ x - g x) := by
        rw [hg_def, smul_sub, smul_smul, mul_inv_cancel₀ hs.ne', one_smul]
      rw [hdiff, hsmul, abs_of_pos hs]
      calc s * covectorEuclideanNorm (ω₀ x - g x) ≤ s * (ε / s) :=
            mul_le_mul_of_nonneg_left (hω₀g x) hs.le
        _ = ε := mul_div_cancel₀ ε hs.ne'
    -- Step 3b: along test forms `ωₖ` supported in one open `W ⊂⊂ U` with `|ωₖ − G| ≤ εₖ → 0`,
    -- `T(ωₖ)` converges to a limit `Φ(G)` independent of the sequence
    obtain ⟨Φ, hΦ⟩ : ∃ Φ : (Euclid P → Covector (Euclid P) n) → ℝ,
        ∀ (G : Euclid P → Covector (Euclid P) n) (W : Set (Euclid P)) (ωs : ℕ → TestFormOn U n)
          (εs : ℕ → ℝ), IsOpen W → CompactlyContained W U →
          (∀ k, tsupport (ωs k : DifferentialForm (Euclid P) n) ⊆ W) →
          (∀ k x, covectorEuclideanNorm ((ωs k : DifferentialForm (Euclid P) n) x - G x) ≤ εs k) →
          Tendsto εs atTop (𝓝 0) → Tendsto (fun k => T (ωs k)) atTop (𝓝 (Φ G)) := by
      classical
      -- `(W, ωs, εs)` is approximating data for `G`
      let IsApprox : (Euclid P → Covector (Euclid P) n) → Set (Euclid P) → (ℕ → TestFormOn U n) →
          (ℕ → ℝ) → Prop := fun G W ωs εs =>
        IsOpen W ∧ CompactlyContained W U ∧
          (∀ k, tsupport (ωs k : DifferentialForm (Euclid P) n) ⊆ W) ∧
          (∀ k x, covectorEuclideanNorm ((ωs k : DifferentialForm (Euclid P) n) x - G x) ≤ εs k) ∧
          Tendsto εs atTop (𝓝 0)
      -- the key estimate `|T ωₖ - T ω'ₗ| ≤ (εₖ + ε'ₗ) m(W ∪ W')`
      have hkey : ∀ G W ωs εs W' ωs' εs', IsApprox G W ωs εs → IsApprox G W' ωs' εs' →
          ∀ k l, |T (ωs k) - T (ωs' l)| ≤ (εs k + εs' l) * m (W ∪ W') := by
        rintro G W ωs εs W' ωs' εs' ⟨hW, hWU, hs, hε, -⟩ ⟨hW', hWU', hs', hε', -⟩ k l
        rw [show T (ωs k) - T (ωs' l) = T (ωs k - ωs' l) from (map_sub T.toCurrent _ _).symm]
        refine hm _ _ _ (hW.union hW') ⟨?_, ?_⟩ ?_ fun x => ?_
        · rw [closure_union]
          exact hWU.1.union hWU'.1
        · rw [closure_union]
          exact union_subset hWU.2 hWU'.2
        · exact (tsupport_sub (ωs k : DifferentialForm (Euclid P) n) (ωs' l)).trans
            (union_subset_union (hs k) (hs' l))
        · have hx : ((ωs k - ωs' l : TestFormOn U n) : DifferentialForm (Euclid P) n) x =
              ((ωs k : DifferentialForm (Euclid P) n) x - G x) -
                ((ωs' l : DifferentialForm (Euclid P) n) x - G x) := by
            simp
          rw [hx]
          exact (htri _ _).trans (add_le_add (hε k x) (hε' l x))
      -- along approximating data, `T ωₖ` is Cauchy, hence convergent
      have hconv : ∀ G W ωs εs, IsApprox G W ωs εs →
          ∃ L, Tendsto (fun k => T (ωs k)) atTop (𝓝 L) := by
        intro G W ωs εs hD
        refine cauchySeq_tendsto_of_complete (cauchySeq_iff_tendsto_dist_atTop_0.2 ?_)
        have hb : Tendsto (fun p : ℕ × ℕ => (εs p.1 + εs p.2) * m (W ∪ W)) atTop (𝓝 0) := by
          rw [← prod_atTop_atTop_eq]
          simpa using ((hD.2.2.2.2.comp tendsto_fst).add (hD.2.2.2.2.comp tendsto_snd)).mul_const
            (m (W ∪ W))
        refine squeeze_zero (fun _ => dist_nonneg) (fun p => ?_) hb
        rw [Real.dist_eq]
        exact hkey G W ωs εs W ωs εs hD hD p.1 p.2
      -- `Φ G` is the limit along chosen approximating data (`0` if there is none)
      refine ⟨fun G => if h : ∃ L, ∃ W ωs εs, IsApprox G W ωs εs ∧
          Tendsto (fun k => T (ωs k)) atTop (𝓝 L) then Classical.choose h else 0, ?_⟩
      -- every approximating sequence tends to `Φ G`
      intro G W ωs εs hW hWU hs hε hε0
      have hD : IsApprox G W ωs εs := ⟨hW, hWU, hs, hε, hε0⟩
      obtain ⟨L₀, hL₀⟩ := hconv G W ωs εs hD
      have hex : ∃ L, ∃ W ωs εs, IsApprox G W ωs εs ∧ Tendsto (fun k => T (ωs k)) atTop (𝓝 L) :=
        ⟨L₀, W, ωs, εs, hD, hL₀⟩
      simp only [dite_eq_left hex]
      obtain ⟨W', ωs', εs', hD', hL⟩ := Classical.choose_spec hex
      have hdiff : Tendsto (fun k => T (ωs k) - T (ωs' k)) atTop (𝓝 0) := by
        refine squeeze_zero_norm (fun k => ?_) (by
          simpa using (hε0.add hD'.2.2.2.2).mul_const (m (W ∪ W')))
        rw [Real.norm_eq_abs]
        exact hkey G W ωs εs W' ωs' εs' hD hD' k k
      simpa using hdiff.add hL
    -- Step 3c: `Φ` is additive, homogeneous, extends `T` and is bounded by `r m(W)`
    have hnbhd : ∀ S : Set (Euclid P), IsCompact S → S ⊆ U →
        ∃ W, IsOpen W ∧ S ⊆ W ∧ CompactlyContained W U := by
      intro S hS hSU
      obtain ⟨W, hWo, hSW, hWU, hWc⟩ := exists_open_between_and_isCompact_closure hS hU hSU
      exact ⟨W, hWo, hSW, hWc, hWU⟩
    have hsub : ∀ W, CompactlyContained W U → W ⊆ U := fun W hW => subset_closure.trans hW.2
    -- approximants `ωₖ ∈ 𝒟ⁿ(U)` with `spt ωₖ ⊆ W` and `|ωₖ − G| ≤ 1/(k+1)`
    have happrox : ∀ (W : Set (Euclid P)) (G : Euclid P → Covector (Euclid P) n), IsOpen W →
        CompactlyContained W U → Continuous G → HasCompactSupport G → tsupport G ⊆ W →
        ∃ ωs : ℕ → TestFormOn U n, (∀ k, tsupport (ωs k : DifferentialForm (Euclid P) n) ⊆ W) ∧
          ∀ k x, covectorEuclideanNorm ((ωs k : DifferentialForm (Euclid P) n) x - G x) ≤
            1 / ((k : ℝ) + 1) := by
      intro W G hW hWU hG hGc hGW
      have hk : ∀ k : ℕ, ∃ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ W ∧
          ∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) x - G x) ≤
            1 / ((k : ℝ) + 1) := by
        intro k
        obtain ⟨ω, hωt, hωW, hωe⟩ := happ W G (1 / ((k : ℝ) + 1)) hW hG hGc hGW (by positivity)
        exact ⟨⟨ω, hωt, hωW.trans (hsub W hWU)⟩, hωW, hωe⟩
      choose ωs hωW hωe using hk
      exact ⟨ωs, hωW, hωe⟩
    have hlim : Tendsto (fun k : ℕ => 1 / ((k : ℝ) + 1)) atTop (𝓝 0) :=
      tendsto_one_div_add_atTop_nhds_zero_nat
    have hΦadd : ∀ G₁ G₂ : Euclid P → Covector (Euclid P) n, Continuous G₁ → HasCompactSupport G₁ →
        tsupport G₁ ⊆ U → Continuous G₂ → HasCompactSupport G₂ → tsupport G₂ ⊆ U →
        Φ (G₁ + G₂) = Φ G₁ + Φ G₂ := by
      intro G₁ G₂ hG₁ hG₁c hG₁U hG₂ hG₂c hG₂U
      obtain ⟨W₁, hW₁o, hG₁W₁, hW₁U⟩ := hnbhd _ hG₁c hG₁U
      obtain ⟨W₂, hW₂o, hG₂W₂, hW₂U⟩ := hnbhd _ hG₂c hG₂U
      obtain ⟨ω₁, hω₁W, hω₁e⟩ := happrox W₁ G₁ hW₁o hW₁U hG₁ hG₁c hG₁W₁
      obtain ⟨ω₂, hω₂W, hω₂e⟩ := happrox W₂ G₂ hW₂o hW₂U hG₂ hG₂c hG₂W₂
      have hWU : CompactlyContained (W₁ ∪ W₂) U := by
        refine ⟨?_, ?_⟩ <;> rw [closure_union]
        exacts [hW₁U.1.union hW₂U.1, union_subset hW₁U.2 hW₂U.2]
      have h := hΦ (G₁ + G₂) (W₁ ∪ W₂) (fun k => ω₁ k + ω₂ k)
        (fun k => 1 / ((k : ℝ) + 1) + 1 / ((k : ℝ) + 1)) (hW₁o.union hW₂o) hWU
        (fun k => by
          simp only [Submodule.coe_add]
          exact (tsupport_add _ _).trans (union_subset_union (hω₁W k) (hω₂W k)))
        (fun k x => by
          simp only [Submodule.coe_add, Pi.add_apply]
          rw [add_sub_add_comm]
          exact (hadd _ _).trans (add_le_add (hω₁e k x) (hω₂e k x)))
        (by simpa only [add_zero] using hlim.add hlim)
      have h' : Tendsto (fun k => T (ω₁ k + ω₂ k)) atTop (𝓝 (Φ G₁ + Φ G₂)) :=
        ((hΦ G₁ W₁ ω₁ _ hW₁o hW₁U hω₁W hω₁e hlim).add
          (hΦ G₂ W₂ ω₂ _ hW₂o hW₂U hω₂W hω₂e hlim)).congr fun k =>
            (T.toCurrent.map_add (ω₁ k) (ω₂ k)).symm
      exact tendsto_nhds_unique h h'
    have hΦsmul : ∀ (t : ℝ) (G : Euclid P → Covector (Euclid P) n), Continuous G →
        HasCompactSupport G → tsupport G ⊆ U → Φ (t • G) = t * Φ G := by
      intro t G hG hGc hGU
      obtain ⟨W, hWo, hGW, hWU⟩ := hnbhd _ hGc hGU
      obtain ⟨ωs, hωW, hωe⟩ := happrox W G hWo hWU hG hGc hGW
      have h := hΦ (t • G) W (fun k => t • ωs k) (fun k => |t| * (1 / ((k : ℝ) + 1))) hWo hWU
        (fun k => by
          simp only [Submodule.coe_smul]
          exact (tsupport_smul_subset_right (fun _ => t) _).trans (hωW k))
        (fun k x => by
          simp only [Submodule.coe_smul, Pi.smul_apply]
          have e : t • (ωs k : DifferentialForm (Euclid P) n) x - t • G x =
              t • ((ωs k : DifferentialForm (Euclid P) n) x - G x) := (smul_sub t _ _).symm
          rw [e, hsmul]
          exact mul_le_mul_of_nonneg_left (hωe k x) (abs_nonneg t))
        (by simpa only [mul_zero] using hlim.const_mul |t|)
      have h' : Tendsto (fun k => T (t • ωs k)) atTop (𝓝 (t * Φ G)) :=
        ((hΦ G W ωs _ hWo hWU hωW hωe hlim).const_mul t).congr fun k => by
          rw [T.toCurrent.map_smul, smul_eq_mul]
      exact tendsto_nhds_unique h h'
    have hΦT : ∀ ω : TestFormOn U n, Φ (ω : DifferentialForm (Euclid P) n) = T ω := by
      intro ω
      obtain ⟨W, hWo, hωW, hWU⟩ := hnbhd _ ω.property.1.2 ω.property.2
      exact tendsto_nhds_unique (hΦ (ω : DifferentialForm (Euclid P) n) W (fun _ => ω) (fun _ => 0)
        hWo hWU (fun _ => hωW) (fun _ x => by simp) tendsto_const_nhds) tendsto_const_nhds
    have hΦbd : ∀ (W : Set (Euclid P)) (G : Euclid P → Covector (Euclid P) n) (r : ℝ), IsOpen W →
        CompactlyContained W U → Continuous G → HasCompactSupport G → tsupport G ⊆ W →
        (∀ x, covectorEuclideanNorm (G x) ≤ r) → |Φ G| ≤ r * m W := by
      intro W G r hWo hWU hG hGc hGW hr
      obtain ⟨ωs, hωW, hωe⟩ := happrox W G hWo hWU hG hGc hGW
      have hb : ∀ k : ℕ, |T (ωs k)| ≤ (r + 1 / ((k : ℝ) + 1)) * m W := by
        intro k
        refine hm W (ωs k) _ hWo hWU (hωW k) fun x => ?_
        calc covectorEuclideanNorm ((ωs k : DifferentialForm (Euclid P) n) x)
            = covectorEuclideanNorm (((ωs k : DifferentialForm (Euclid P) n) x - G x) + G x) := by
              rw [sub_add_cancel]
          _ ≤ 1 / ((k : ℝ) + 1) + r := (hadd _ _).trans (add_le_add (hωe k x) (hr x))
          _ = r + 1 / ((k : ℝ) + 1) := add_comm _ _
      have hmW : Tendsto (fun k : ℕ => (r + 1 / ((k : ℝ) + 1)) * m W) atTop (𝓝 (r * m W)) := by
        simpa only [add_zero] using ((tendsto_const_nhds (x := r)).add hlim).mul_const (m W)
      exact le_of_tendsto_of_tendsto' (hΦ G W ωs _ hWo hWU hωW hωe hlim).abs hmW hb
    -- Step 3d: `L(g) = Φ(g̃)`, `g̃ = c⁻¹ ∘ g` on `U` and `0` off `U`
    obtain ⟨ext, hin, hout, hcont, hcpt, hspt⟩ : ∃ ext : CompactlySupportedContinuousMap U
        (EuclideanSpace ℝ (Fin d)) → Euclid P → Covector (Euclid P) n,
        (∀ g y (hy : y ∈ U), ext g y = c.symm (g ⟨y, hy⟩)) ∧ (∀ g y, y ∉ U → ext g y = 0) ∧
        (∀ g, Continuous (ext g)) ∧ (∀ g, HasCompactSupport (ext g)) ∧
        ∀ g, tsupport (ext g) ⊆ Subtype.val '' tsupport g := by
      have hcs : ∀ g : CompactlySupportedContinuousMap U (EuclideanSpace ℝ (Fin d)),
          HasCompactSupport (c.symm ∘ g) := fun g => g.hasCompactSupport.comp_left (map_zero _)
      exact ⟨fun g => Function.extend Subtype.val (c.symm ∘ g) 0,
        fun g y hy => Subtype.val_injective.extend_apply _ _ (⟨y, hy⟩ : U),
        fun g y hy => Function.extend_apply' _ _ y fun ⟨x, hx⟩ => hy (hx ▸ x.2),
        fun g => HasCompactSupport.continuous_extend_zero hU (c.symm.continuous.comp g.continuous)
