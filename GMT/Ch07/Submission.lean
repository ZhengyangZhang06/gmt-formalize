    filter_upwards [hslice_ae, hF1', hF2] with t ht hF1t hF2t
    have htL : t ∈ L := ht.1
    obtain ⟨Rt, hRtC, hRtθ, hRtξ⟩ := hsliceRep t ht
    obtain ⟨Rtt, hRttC, hRttθ, hRttξ, hRttact, hRttmeas⟩ := htransl m Rt₀ (t - t₀) hRt₀sm
