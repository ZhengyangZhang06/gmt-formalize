      -- `I = J_j` and `0` otherwise, so the squared coefficients sum to `Σ_j c_j²`
      rw [covectorEuclideanNorm]
      congr 1
      symm
      refine Fintype.sum_of_injective J hJinj _ _ (fun I hI => ?_) (fun j => ?_)
