  have hBz : closedBall ξ σ ⊆ closedBall z (4 * δ * ρ) :=
    closedBall_subset_closedBall' (by linarith only [hσδρ, hξz, hδρ])
  have hBW : closedBall ξ σ ⊆ W :=
