    have hhs : ∀ (F : Type) [NormedAddCommGroup F] [InnerProductSpace ℝ F]
        (L : Euclid P →L[ℝ] F),
        ∑ i : Fin P, ‖L (W.starProjection (EuclideanSpace.single i 1))‖ ^ 2 =
          ∑ a, ‖L (τ a : Euclid P)‖ ^ 2 := by
