/-- **Null set of points with small fillings** (Simon Ch. 6, 8.2 (4)–(6); the lower density
bound in the proof of 7.2.4).  Assume (VO).  Let `μ = μ_C` be finite on compact sets with
`M_W(C) = μ(W)` for open `W`, and `C(ω) = ∫ ⟨ω, ξ⟩ dμ` with `|ξ| ≤ 1` `μ`-a.e.  Let
`0 ≤ κ < 1 ≤ λ`.  Suppose that every `x ∈ E` has, at arbitrarily small scales `δ`, a radius
`ρ < δ` with `μ(∂B_ρ(x)) = 0` and a filling `S` with `∂S = ∂A`, where `A = C⌞B_ρ(x)`,
`M(S) ≤ κ μ(B_ρ(x))` and `spt S ⊆ B̄_{λδ}(x)`.  Then `μ(E) = 0`.
Fix `θ ∈ (κ, 1)` and a `W`-admissible `ω`.  The cone bound for the cycle `S − A` gives
`A(ω) ≤ θ μ(B_ρ(x))` at small scales.  The covering lemma then gives
`C(ω) ≤ μ(W) − (1 − θ) μ(E')` for each piece `E' = E ∩ B_k(0) ⊆ W = B_{k+1}(0)`.  Taking the
supremum over `ω` gives `μ(W) = M_W(C) ≤ μ(W) − (1 − θ) μ(E')`, so `μ(E') = 0`. -/
theorem Submission.cbrld_measure_eq_zero_of_small_fillings : (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → ∀ (P d : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (κ lam : ℝ) (E : Set (Euclid P)), 0 ≤ κ → κ < 1 → 1 ≤ lam → (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ W : Set (Euclid P), IsOpen W → C.massOn W = μ W) → AEStronglyMeasurable ξ μ → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ x ∈ E, ∀ δ : ℝ, 0 < δ → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ ∧ μ (sphere x ρ) = 0 ∧ ∃ (A S : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ y in ball x ρ, ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y) ∂μ) ∧ S.boundary = A.boundary ∧ S.mass ≤ ENNReal.ofReal κ * μ (ball x ρ) ∧ S.support ⊆ closedBall x (lam * δ)) → μ E = 0 := by
  intro hVO P d C μ ξ κ lam E hκ0 hκ1 hlam hμK hCμ hξm hξ hCξ hE
  have hball_fin : ∀ (x : Euclid P) (r : ℝ), μ (ball x r) < ∞ := fun x r =>
    (measure_mono ball_subset_closedBall).trans_lt (hμK _ (isCompact_closedBall x r))
  -- a fixed `θ ∈ (κ, 1)` plays the role of `κ + ε` in the covering lemma
  obtain ⟨θ, hκθ, hθ1⟩ := exists_between hκ1
  have hlam0 : 0 < lam := by linarith
  -- Steps 3–4: a piece `E' ⊆ E` inside an open `W` of finite measure is `μ`-null
  have hpiece : ∀ E' W : Set (Euclid P), E' ⊆ E → IsOpen W → E' ⊆ W → μ W < ∞ → μ E' = 0 := by
    intro E' W hE'E hWo hE'W hWfin
    have hE'fin : μ E' < ∞ := (measure_mono hE'W).trans_lt hWfin
    -- Step 3: every `W`-admissible `ω` satisfies `C(ω) ≤ μ(W) - (1 - θ) μ(E')`
    have hest : ∀ ω ∈ massAdmissibleOn (univ : Set (Euclid P)) (d + 1) W,
        C ω ≤ (μ W).toReal - (1 - θ) * (μ E').toReal := by
      intro ω hω
      have hωc : Continuous (ω : DifferentialForm (Euclid P) (d + 1)) :=
        ContDiff.continuous ω.property.1.1
      -- `g(y) = ξ(y)(ω(y))` is `μ`-a.e. strongly measurable with `|g| ≤ 1` `μ`-a.e.
      have hgm : AEStronglyMeasurable
          (fun y => ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y)) μ :=
        (isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable
          (hξm.prodMk hωc.aestronglyMeasurable) :)
      have hg1 : ∀ᵐ y ∂μ, |ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y)| ≤ 1 := by
        filter_upwards [hξ] with y hy
        exact (hy _).trans (hω.2 y)
      -- `g = 0` off `W`, so `C(ω) = ∫_W g dμ`
      have hCW : C ω = ∫ y in W, ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y) ∂μ := by
        rw [hCξ ω]
        refine (setIntegral_eq_integral_of_forall_compl_eq_zero fun y hy => ?_).symm
        rw [image_eq_zero_of_notMem_tsupport fun h => hy (hω.1 h), map_zero]
      -- the cone constant of `ω`
      obtain ⟨c, hc, hcone⟩ := Submission.cbrld_cycle_eval_le_radius_mul_mass hVO P d ω
      have hden : 0 < (c + 1) * lam * (1 + κ) :=
        mul_pos (mul_pos (by linarith) hlam0) (by linarith)
      obtain ⟨δ₀, hδ₀⟩ : ∃ δ₀ : ℝ, δ₀ = (θ - κ) / ((c + 1) * lam * (1 + κ)) := ⟨_, rfl⟩
      have hδ₀pos : 0 < δ₀ := by rw [hδ₀]; exact div_pos (by linarith) hden
      have hδ₀eq : δ₀ * ((c + 1) * lam * (1 + κ)) = θ - κ := by
        rw [hδ₀]; exact div_mul_cancel₀ _ hden.ne'
      -- Step 3(i): `∫_{B̄_ρ(x)} g dμ ≤ θ μ(B̄_ρ(x))` at arbitrarily small radii
      have hsmall : ∀ x ∈ E', ∀ δ' : ℝ, 0 < δ' → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ' ∧
          ∫ y in closedBall x ρ, ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y) ∂μ ≤
            θ * (μ (closedBall x ρ)).toReal := by
        intro x hx δ' hδ'
        have hδpos : 0 < min δ' δ₀ := lt_min hδ' hδ₀pos
        obtain ⟨ρ, hρ0, hρδ, hsph, A, S, hA, hbd, hSm, hSs⟩ := hE x (hE'E hx) (min δ' δ₀) hδpos
        refine ⟨ρ, hρ0, hρδ.trans_le (min_le_left _ _), ?_⟩
        have hR : 0 < lam * min δ' δ₀ := mul_pos hlam0 hδpos
        have hAs : A.support ⊆ closedBall x (lam * min δ' δ₀) :=
          (Submission.cbrld_ns_ball_current_support_subset P (d + 1) μ ξ A x ρ hA).trans
            (closedBall_subset_closedBall (hρδ.le.trans (le_mul_of_one_le_left hδpos.le hlam)))
        -- comparison with the cycle `S - A` at scale `R = λ min(δ', δ₀)`
        have hcmp := Submission.cbrld_ns_eval_le_of_small_filling P d A S ω (μ (ball x ρ)) x c κ
          (lam * min δ' δ₀) hc hκ0 hR (hball_fin x ρ) hω.2 hcone hbd
          (Submission.cbrld_ns_ball_current_mass_le P (d + 1) μ ξ A x ρ hξ hA) hSm hAs hSs
        have hcR : c * (lam * min δ' δ₀) * (1 + κ) ≤ θ - κ := by
          have h1 : 0 ≤ c * lam * (1 + κ) := mul_nonneg (mul_nonneg hc hlam0.le) (by linarith)
          have h2 : c * lam * (1 + κ) ≤ (c + 1) * lam * (1 + κ) :=
            mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (by linarith) hlam0.le)
              (by linarith)
          calc c * (lam * min δ' δ₀) * (1 + κ) = c * lam * (1 + κ) * min δ' δ₀ := by ring
            _ ≤ c * lam * (1 + κ) * δ₀ := mul_le_mul_of_nonneg_left (min_le_right _ _) h1
            _ ≤ (c + 1) * lam * (1 + κ) * δ₀ := mul_le_mul_of_nonneg_right h2 hδ₀pos.le
            _ = θ - κ := by rw [← hδ₀eq]; ring
        -- `μ(∂B_ρ(x)) = 0`, so closed and open balls agree `μ`-a.e.
        have hae : closedBall x ρ =ᵐ[μ] ball x ρ := by
          refine ae_eq_set.2 ⟨by rw [closedBall_sdiff_ball]; exact hsph, ?_⟩
          rw [sdiff_eq_empty.2 ball_subset_closedBall, measure_empty]
        rw [setIntegral_congr_set hae, measure_congr hae, ← hA ω]
        calc A ω ≤ (κ + c * (lam * min δ' δ₀) * (1 + κ)) * (μ (ball x ρ)).toReal := hcmp
          _ ≤ θ * (μ (ball x ρ)).toReal :=
            mul_le_mul_of_nonneg_right (by linarith) ENNReal.toReal_nonneg
      -- Step 3(ii): the covering lemma with `θ`
      rw [hCW]
      exact Submission.cbrld_vitali_setIntegral_le P μ
        (fun y => ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y)) θ E' W hμK hgm hg1
        hθ1.le hWo hE'W hWfin hsmall
    -- Step 4: `μ(W) = M_W(C) ≤ max(μ(W) - (1 - θ) μ(E'), 0)`
    have hmass : C.massOn W ≤ ENNReal.ofReal (max ((μ W).toReal - (1 - θ) * (μ E').toReal) 0) := by
      refine sSup_le ?_
      rintro _ ⟨ω, hω, rfl⟩
      exact ENNReal.ofReal_le_ofReal ((hest ω hω).trans (le_max_left _ _))
    rw [hCμ W hWo] at hmass
    have hreal := ENNReal.toReal_le_of_le_ofReal (le_max_right _ _) hmass
    by_contra hne
    have hpos : 0 < (μ E').toReal := ENNReal.toReal_pos hne hE'fin.ne
    have hWpos : 0 < (μ W).toReal :=
      hpos.trans_le (ENNReal.toReal_mono hWfin.ne (measure_mono hE'W))
    have hprod : 0 < (1 - θ) * (μ E').toReal := mul_pos (by linarith) hpos
    rcases le_total ((μ W).toReal - (1 - θ) * (μ E').toReal) 0 with h | h
    · rw [max_eq_right h] at hreal
      linarith
    · rw [max_eq_left h] at hreal
      linarith
  -- Step 2: `E = ⋃ₖ (E ∩ B_k(0))`, and each piece lies in the open `B_{k+1}(0)`
  have hcover : E ⊆ ⋃ k : ℕ, E ∩ ball (0 : Euclid P) k := by
    intro y hy
    obtain ⟨k, hk⟩ := exists_nat_gt (dist y 0)
    exact mem_iUnion.2 ⟨k, hy, mem_ball.2 hk⟩
  exact measure_mono_null hcover (measure_iUnion_null fun k : ℕ =>
    hpiece (E ∩ ball (0 : Euclid P) k) (ball (0 : Euclid P) (k + 1)) inter_subset_left isOpen_ball
      (fun z hz => ball_subset_ball (by linarith) hz.2) (hball_fin _ _))

/-- **Lower density bound for cycles with the integer slice property** (Simon Ch. 6, proof of
8.2, with the lower density in place of `Θ^{*n}`; `n = d + 1 < P`).  The local filling
`dtc_bc_tc_cl_ld_exists_small_filling`, fed with (SL) = `cmc_slice_mass_bounds`, (MR) and (Isor),
gives `η₀ > 0` such that every `x` with `liminf_{r↓0} μ(B_r(x))/(ωₙrⁿ) < η₀` has, at arbitrarily
small scales `δ`, a radius `ρ < δ` with `μ(∂B_ρ(x)) = 0` and a filling `S` of `∂(C⌞B_ρ(x))` with
`M(S) ≤ μ(B_ρ(x))/2` and `spt S ⊆ B̄_{(1+3√P)δ}(x)`.  The set of these points is `μ`-null by
`cbrld_measure_eq_zero_of_small_fillings` with `κ = 1/2` and `λ = 1 + 3√P`. -/
theorem Submission.dtc_bc_tc_cl_lower_density : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 1 ≤ c ∧ ∀ Z : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Z → IsCompact Z.support → Z.boundary = 0 → Z.mass < ∞ → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2), IsIntegerMultiplicity Y ∧ Y.boundary = Z ∧ Y.mass ≤ ENNReal.ofReal (c * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1)) * Z.mass.toReal) ∧ Y.support ⊆ thickening (3 * Real.sqrt P * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1))) Z.support) → ∀ (P d : ℕ), d + 1 < P → (∃ η₀ : ℝ, 0 < η₀ ∧ ∀ (C : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)), C.boundary = 0 → (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ W : Set (Euclid P), IsOpen W → C.massOn W = μ W) → AEStronglyMeasurable ξ μ → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (C).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B)) → ∀ᵐ x ∂μ, ENNReal.ofReal η₀ ≤ liminf (fun r : ℝ => μ (ball x r) / (unitBallVolume (d + 1) * ENNReal.ofReal (r ^ (d + 1)))) (𝓝[>] 0)) := by
  intro hMR hVO hIsor P d hPd
  -- steps 2–4: small fillings of sphere slices at points of lower density `< η₀`
  obtain ⟨η₀, hη₀, hfill⟩ := Submission.dtc_bc_tc_cl_ld_exists_small_filling
    Submission.cmc_slice_mass_bounds hMR hIsor P d hPd
  refine ⟨η₀, hη₀, fun C μ ξ hCb hμ hCμ hξm hξb hC hISP => ?_⟩
  -- steps 0, 5, 6: the points of lower density `< η₀` form a `μ`-null set
  rw [ae_iff]
  refine Submission.cbrld_measure_eq_zero_of_small_fillings hVO P d C μ ξ (1 / 2)
    (1 + 3 * Real.sqrt P) _ (by norm_num) (by norm_num) (le_add_of_nonneg_right (by positivity))
    hμ hCμ hξm hξb hC fun x hx δ hδ => ?_
  exact hfill C μ ξ hCb hμ hξm hξb hC hISP x (not_le.mp hx) δ hδ

/-- **Closure theorem for compactly supported currents** (Simon Ch. 6, 8.2, the step
`CL_P(d), BR_P(d) ⟹ CL*_{P,d+1}` used for 7.2.4 and 7.3.1): if `K ⊆ ℝᴾ` is compact,
`Tⱼ ∈ 𝒟_{d+1}(ℝᴾ)` are integer multiplicity with integer multiplicity boundaries, `spt Tⱼ ⊆ K`,
`supⱼ (M(Tⱼ) + M(∂Tⱼ)) < ∞` and `Tⱼ ⇀ T`, then `T` is integer multiplicity.  `spt T ⊆ K` by
(VO) and `M(T), M(∂T) < ∞` by lower semicontinuity; `∂T` is integer multiplicity by `CL_P(d)`
(`∂∂Tⱼ = 0`), so it has a compactly supported integer multiplicity filling `Y`.  The integer slice
property holds for the `Tⱼ` and `Y`, passes to the weak limit `T` and then to the compactly
supported cycle `Γ = T − Y`; the lower density bound and the cycle case make `Γ` integer
multiplicity, and so is `T = Γ − (0 − Y)` by (IMC)(c). -/
theorem Submission.dtc_bc_tc_cl_closure_compact_support : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 1 ≤ c ∧ ∀ Z : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Z → IsCompact Z.support → Z.boundary = 0 → Z.mass < ∞ → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2), IsIntegerMultiplicity Y ∧ Y.boundary = Z ∧ Y.mass ≤ ENNReal.ofReal (c * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1)) * Z.mass.toReal) ∧ Y.support ⊆ thickening (3 * Real.sqrt P * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1))) Z.support) → ∀ (P d : ℕ), d + 1 < P → (∀ (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U d) (T : GeometricCurrentOn U d), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T) → (∀ (U : Set (Euclid P)) (R : GeometricCurrentOn U (d + 1)), IsOpen U → IsIntegerMultiplicity R → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → R.boundary.massOn W < ∞) → IsIntegerMultiplicity R.boundary) → (∀ (Ts : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (T : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (K : Set (Euclid P)), IsCompact K → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ j, IsIntegerMultiplicity (Ts j).boundary) → (∀ j, (Ts j).support ⊆ K) → ⨆ j, ((Ts j).mass + (Ts j).boundary.mass) < ∞ → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T) := by
  intro hMR hRect hVO hIsor P d hdP hCL hBR Ts T K hK hTsIM hTsbIM hTsK hbound hconv
  have hIMCc := hRect.2.2.1
  -- (REP) and (MM) from the sibling foundations; `0` is integer multiplicity
  obtain ⟨hREP, ⟨-, -, hMM⟩, -⟩ := Submission.dtc_bc_tc_cl_foundations
  have hzero := Submission.cbr_cc_current_algebra.1
  -- `S := supⱼ (M(Tⱼ) + M(∂Tⱼ)) < ∞` bounds `M(Tⱼ)`, `M(∂Tⱼ)` and their `liminf`s
  obtain ⟨S, hS, hSlt⟩ : ∃ S : ℝ≥0∞, (∀ j, (Ts j).mass + (Ts j).boundary.mass ≤ S) ∧ S < ∞ :=
    ⟨_, le_iSup (fun j => (Ts j).mass + (Ts j).boundary.mass), hbound⟩
  have hTsS : ∀ j, (Ts j).mass ≤ S := fun j => le_self_add.trans (hS j)
  have hTsbS : ∀ j, (Ts j).boundary.mass ≤ S := fun j => le_add_self.trans (hS j)
  have hliminf : ∀ u : ℕ → ℝ≥0∞, (∀ j, u j ≤ S) → liminf u atTop ≤ S := fun u hu =>
    liminf_le_of_frequently_le' (Frequently.of_forall hu)
  -- Step 1: `spt T ⊆ K` by (VO), so `spt T` is compact; `M(T), M(∂T) < ∞` by lower
  -- semicontinuity of mass (Simon 6.2.14), `∂Tⱼ ⇀ ∂T`
  have hTvan : ∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1),
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) (d + 1))) K → T ω = 0 := by
    intro ω hω
    have h0 : ∀ j, Ts j ω = 0 := fun j => hVO P (d + 1) univ (Ts j) ω (hω.mono_right (hTsK j))
    exact tendsto_nhds_unique (hconv ω) (by simp only [h0]; exact tendsto_const_nhds)
  have hTsupp : IsCompact T.support :=
    (Submission.rsd_cmr_support_subset_of_vanish P (d + 1) univ K T isOpen_univ hK
      (subset_univ K) hTvan).2
  have hTmass : T.mass < ∞ :=
    ((hconv.massOn_le_liminf univ).trans (hliminf _ hTsS)).trans_lt hSlt
  have hTbmass : T.boundary.mass < ∞ :=
    ((hconv.boundary.massOn_le_liminf univ).trans (hliminf _ hTsbS)).trans_lt hSlt
  -- Step 2: `∂T` is integer multiplicity by CL_P(d) applied to `∂Tⱼ ⇀ ∂T` (`∂∂Tⱼ = 0`)
  have hbb : ∀ (m : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1))
      (W : Set (Euclid P)), boundaryMassOn X.boundary W = 0 := by
    intro m
    cases m with
    | zero => intro X W; rfl
    | succ k =>
      intro X W
      show X.boundary.boundary.massOn W = 0
      rw [GeometricCurrentOn.boundary_boundary]
      refine le_antisymm (sSup_le ?_) zero_le
      rintro _ ⟨ω, -, rfl⟩
      simp
  have hTbIM : IsIntegerMultiplicity T.boundary := by
    refine hCL univ (fun j => (Ts j).boundary) T.boundary isOpen_univ hTsbIM (fun W _ _ => ?_)
      hconv.boundary
    refine lt_of_le_of_lt (iSup_le fun j => ?_) hSlt
    show (Ts j).boundary.massOn W + boundaryMassOn (Ts j).boundary W ≤ S
    rw [hbb d (Ts j) W, add_zero]
    exact ((Ts j).boundary.massOn_mono (subset_univ W)).trans (hTsbS j)
  -- Step 3: a compactly supported integer multiplicity filling `Y` of `∂T` with `M(Y) < ∞`
  obtain ⟨Y, hYIM, hYb, hYmass, hYsupp⟩ :=
    Submission.dtc_bc_tc_cl_cc_compact_im_filling hMR hIMCc hVO hIsor P d (by omega) T hTsupp
      hTbmass hTbIM
  -- Step 4: `Γ = T − Y` is a cycle of finite mass with compact support
  have hΓb : (T - Y).boundary = 0 := by
    ext η
    have h : Y.boundary η = T.boundary η := by rw [hYb]
    change T.boundary η - Y.boundary η = 0
    rw [h, sub_self]
  have hΓmass : (T - Y).mass < ∞ := by
    refine ((Submission.cbr_cc_current_algebra).2.1 P (d + 1) univ (T - Y) T Y 1 (-1)
      (fun ω => by change T ω - Y ω = _; push_cast; ring) univ).trans_lt ?_
    simp only [Int.natAbs_one, Int.natAbs_neg, Nat.cast_one, one_mul]
    exact ENNReal.add_lt_top.2 ⟨hTmass, hYmass⟩
  have hΓsupp : IsCompact (T - Y).support := by
    refine (Submission.rsd_cmr_support_subset_of_vanish P (d + 1) univ (T.support ∪ Y.support)
      (T - Y) isOpen_univ (hTsupp.union hYsupp) (subset_univ _) fun ω hω => ?_).2
    change T ω - Y ω = 0
    rw [hVO P (d + 1) univ T ω (hω.mono_right subset_union_left),
      hVO P (d + 1) univ Y ω (hω.mono_right subset_union_right), sub_zero]
  -- Step 5: currents `X` with `X`, `∂X` integer multiplicity have the integer slice property
  have hISPIM := Submission.dtc_bc_tc_cl_cc_slice_property_of_im hRect
    Submission.cmc_slice_mass_bounds hMM Submission.cbr_setIntegral_eq_of_integral_eq P d hBR
  -- Step 6: so do the `Tⱼ` and `Y`, and SLIM_{P,d} gives it for the weak limit `T`
  have hSLIM := Submission.dtc_bc_tc_cl_slice_property_of_weak_limit hMR hRect P d hdP hCL
  have hTsW : ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ →
      ⨆ i, ((Ts i).massOn W + (Ts i).boundary.massOn W) < ∞ := fun W _ _ =>
    lt_of_le_of_lt (iSup_le fun i => (add_le_add ((Ts i).massOn_mono (subset_univ W))
      ((Ts i).boundary.massOn_mono (subset_univ W))).trans (hS i)) hSlt
  have hISPT := hSLIM Ts T (fun i => hISPIM (Ts i) (hTsIM i) (hTsbIM i)) hTsW hconv
  have hISPY := hISPIM Y hYIM (hYb ▸ hTbIM)
  -- Step 7: the integer slice property passes to `Γ = T − Y` (slices are linear in the current)
  have hTmW : ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ → T.massOn W < ∞ :=
    fun W _ _ => (T.massOn_mono (subset_univ W)).trans_lt hTmass
  have hTbmW : ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ →
      T.boundary.massOn W < ∞ :=
    fun W _ _ => (T.boundary.massOn_mono (subset_univ W)).trans_lt hTbmass
  have hYmW : ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ → Y.massOn W < ∞ :=
    fun W _ _ => (Y.massOn_mono (subset_univ W)).trans_lt hYmass
  have hYbmW : ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ →
      Y.boundary.massOn W < ∞ := by
    rw [hYb]
    exact hTbmW
  have hISPΓ := Submission.cbr_cc_slice_property_sub hREP Submission.cmc_slice_mass_bounds hIMCc
    Submission.cbr_setIntegral_eq_of_integral_eq d P T Y hTmW hTbmW hYmW hYbmW hISPT hISPY
  -- Step 8: LD_{P,d} and CYC_{P,d} make the cycle `Γ` integer multiplicity
  have hΓIM := Submission.dtc_bc_tc_cl_cycle_isIntegerMultiplicity hMR hRect hVO P d hdP hSLIM
    (Submission.dtc_bc_tc_cl_lower_density hMR hVO hIsor P d hdP) (T - Y) hΓb hΓmass hΓsupp hISPΓ
  -- `T = Γ − (0 − Y)` is integer multiplicity by (IMC)(c)
  have hT : (T - Y) - (0 - Y) = T := by
    ext ω
    change (T ω - Y ω) - ((0 : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) ω - Y ω) = T ω
    rw [GeometricCurrentOn.zero_apply]
    ring
  rw [← hT]
  exact hIMCc P (d + 1) univ _ _ isOpen_univ hΓIM
    (hIMCc P (d + 1) univ _ _ isOpen_univ (hzero P (d + 1) univ) hYIM)

/-- Chapter 7 of Simon's *Introduction to GMT*: the headline results above. -/
theorem main_theorem : MinimizingImpliesStationary ∧ ExistenceOfMinimizingFilling ∧ CompactnessOfMinimizingCurrents ∧ DensityAndTangentCones ∧ IntegerDensityAndTangentPlanes ∧ RegularSetDense ∧ DensityOneImpliesRegular ∧ SingularSetSmallWhereDensityBelowTwo ∧ HalfSpaceConeLiesInBoundary ∧ CodimensionOneRegularity ∧ RegularComponentsAreMinimizing := by sorry

end GMT.Ch07
