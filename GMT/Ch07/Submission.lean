a.e. `t`; `A_t`, `B_t` are integer multiplicity (`cbr_ccisp_restrict_isIntegerMultiplicity`);
for `W ⊂⊂ ℝᴾ`, `M_W(∂A_t) ≤ M_W(Z_t) + M_W(B_t) ≤ M_W(Z_t) + μ'(closure W) < ∞`
(`cbr_cc_current_algebra`, `cmc_fcl_massOn_le_measure_inter`), so `∂A_t` is integer
multiplicity by `BR_P(d)`, and so is `Z_t` by (IMC)(c). -/
theorem Submission.dtc_bc_tc_cl_cc_slice_property_of_im : ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → (∀ (P : ℕ) (μs : ℕ → Measure (Euclid P)) (f : Euclid P → ℝ) (G : Set (Euclid P)) (a b : ℝ) (L : NNReal) (Z : ℕ → ℝ → ℝ≥0∞), Continuous f → (∀ j, μs j (G ∩ {x | a < f x ∧ f x < b}) < ∞) → (∀ (j : ℕ) (t : ℝ), t ∈ Ioo a b → Z j t ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μs j (G ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) → ∃ g : ℝ → ℝ≥0∞, Measurable g ∧ (∀ᵐ t ∂(volume : Measure ℝ), t ∈ Ioo a b → liminf (fun j => Z j t) atTop ≤ g t) ∧ ∫⁻ t in Ioo a b, g t ≤ (L : ℝ≥0∞) * liminf (fun j => μs j (G ∩ {x | a < f x ∧ f x < b})) atTop) → (∀ (P k : ℕ) (U : Set (Euclid P)) (μ₁ μ₂ μ₃ : Measure (Euclid P)) (ξ₁ ξ₂ ξ₃ : Euclid P → MultiVector P k), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ₁ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ₂ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ₃ K < ∞) → AEStronglyMeasurable ξ₁ μ₁ → AEStronglyMeasurable ξ₂ μ₂ → AEStronglyMeasurable ξ₃ μ₃ → (∀ᵐ x ∂μ₁, ∀ α : Covector (Euclid P) k, |ξ₁ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ₂, ∀ α : Covector (Euclid P) k, |ξ₂ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ₃, ∀ α : Covector (Euclid P) k, |ξ₃ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U k, ∫ x, ξ₁ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₁ = ∫ x, ξ₂ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₂ + ∫ x, ξ₃ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₃) → ∀ (B : Set (Euclid P)) (ω : TestFormOn U k), MeasurableSet B → ∫ x in B, ξ₁ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₁ = ∫ x in B, ξ₂ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₂ + ∫ x in B, ξ₃ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₃) → ∀ (P d : ℕ), (∀ (U : Set (Euclid P)) (R : GeometricCurrentOn U (d + 1)), IsOpen U → IsIntegerMultiplicity R → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → R.boundary.massOn W < ∞) → IsIntegerMultiplicity R.boundary) → ∀ (X : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), IsIntegerMultiplicity X → IsIntegerMultiplicity X.boundary → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), X ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, X.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B)) := by
  intro hIMC hSL hMM hRU P d hBR X hX hXb μ μ' ξ ξ' hμ hμ' hξm hξ'm hξb hξ'b hXrep hXbrep f L hf
  obtain ⟨-, hIMCb, hIMCc, hIMCd⟩ := hIMC
  -- Step 2: slices `A_t`, `B_t` from (SL) in `U = ℝᴾ`
  obtain ⟨At, Bt, hAt, hBt, -, hmass, -⟩ := hSL P d univ X μ μ' ξ ξ' f L isOpen_univ
    (fun K hK _ => hμ K hK) (fun K hK _ => hμ' K hK) hξm hξ'm hξb hξ'b hXrep hXbrep hf
  -- Step 3: for a.e. `t`, `Z_t = ∂A_t − B_t` has finite mass on bounded sets
  have hfin := Submission.cbr_ccisp_ae_massOn_lt_top hMM P d univ
    (fun t => (At t).boundary - Bt t) μ f L hf.continuous hμ hmass
  filter_upwards [hfin] with t ht A B hA hB
  -- Step 4: `A = A_t` and `B = B_t`
  rw [GeometricCurrentOn.ext fun ω => (hA ω).trans (hAt t ω).symm,
    GeometricCurrentOn.ext fun η => (hB η).trans (hBt t η).symm]
  have hE : MeasurableSet {x | f x < t} :=
    measurableSet_lt hf.continuous.measurable measurable_const
  -- Steps 5–6: `A_t` and `B_t` are integer multiplicity
  have hAIM : IsIntegerMultiplicity (At t) :=
    Submission.cbr_ccisp_restrict_isIntegerMultiplicity hIMCb hIMCd hRU P (d + 1) univ X (At t)
      μ ξ {x | f x < t} isOpen_univ hX (fun K hK _ => hμ K hK) hξm hξb hXrep hE (hAt t)
  have hBIM : IsIntegerMultiplicity (Bt t) :=
    Submission.cbr_ccisp_restrict_isIntegerMultiplicity hIMCb hIMCd hRU P d univ X.boundary
      (Bt t) μ' ξ' {x | f x < t} isOpen_univ hXb (fun K hK _ => hμ' K hK) hξ'm hξ'b hXbrep hE
      (hBt t)
  -- Step 7: `M_W(∂A_t) ≤ M_W(Z_t) + M_W(B_t) < ∞` for `W ⊂⊂ ℝᴾ`, so `BR_P(d)` applies
  have hdAIM : IsIntegerMultiplicity (At t).boundary := by
    refine hBR univ (At t) isOpen_univ hAIM fun W _ hWU => ?_
    have hZ : ((At t).boundary - Bt t).massOn W < ∞ :=
      ht W (hWU.1.isBounded.subset subset_closure)
    have hBW : (Bt t).massOn W < ∞ :=
      (Submission.cmc_fcl_massOn_le_measure_inter P d univ (Bt t) μ' ξ' {x | f x < t} W hξ'b
        (hBt t)).trans_lt
        ((measure_mono (inter_subset_right.trans subset_closure)).trans_lt (hμ' _ hWU.1))
    have hsplit := Submission.cbr_cc_current_algebra.2.1 P d univ (At t).boundary
      ((At t).boundary - Bt t) (Bt t) 1 1
      (fun η => by
        rw [Int.cast_one, one_mul, one_mul]
        exact (sub_add_cancel ((At t).boundary η) (Bt t η)).symm) W
    simp only [Int.natAbs_one, Nat.cast_one, one_mul] at hsplit
    exact hsplit.trans_lt (ENNReal.add_lt_top.2 ⟨hZ, hBW⟩)
  -- Step 8: `Z_t = ∂A_t − B_t` is integer multiplicity by (IMC)(c)
  exact hIMCc P d univ (At t).boundary (Bt t) isOpen_univ hdAIM hBIM


/-- **A compactly supported integer multiplicity filling of an integer multiplicity boundary**
(Simon Ch. 6, proof of 8.2: the general case reduces to `∂T = 0`).  Let `d < P` and let
`T ∈ 𝒟_{d+1}(ℝᴾ)` have compact support, with `∂T` integer multiplicity and `M(∂T) < ∞`.  `T`
kills the forms `dη` with `spt η ∩ spt T = ∅`, so `spt ∂T ⊆ spt T` is compact.  For `d = m + 1`,
the isoperimetric filling (`m + 1 = d < P`) fills the cycle `∂T` by an integer multiplicity `Y`
supported in a bounded thickening of `spt ∂T`.  For `d = 0`, `∂T = Σ_{x ∈ F} m(x) δ_x`, and
`Σ_{x ∈ F} m(x) = 0` (test `∂T` on a bump `0`-form `≡ 1` near `spt T`), so
`Y = Σ_{x ∈ F} m(x) [[0, x]]` has `∂Y = ∂T` and support in the compact `⋃_{x ∈ F} [0, x]`. -/
theorem Submission.dtc_bc_tc_cl_cc_compact_im_filling : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 1 ≤ c ∧ ∀ Z : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Z → IsCompact Z.support → Z.boundary = 0 → Z.mass < ∞ → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2), IsIntegerMultiplicity Y ∧ Y.boundary = Z ∧ Y.mass ≤ ENNReal.ofReal (c * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1)) * Z.mass.toReal) ∧ Y.support ⊆ thickening (3 * Real.sqrt P * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1))) Z.support) → ∀ (P d : ℕ), d < P → ∀ (T : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), IsCompact T.support → T.boundary.mass < ∞ → IsIntegerMultiplicity T.boundary → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1), IsIntegerMultiplicity Y ∧ Y.boundary = T.boundary ∧ Y.mass < ∞ ∧ IsCompact Y.support := by
  intro hMR hIMC hVO hISO P d hdP T hTc hbm hbim
  -- `spt ∂T ⊆ spt T`, and `spt ∂T` is compact
  obtain ⟨hbsub, hbc⟩ := Submission.rsd_cmr_support_subset_of_vanish P d univ T.support
    T.boundary isOpen_univ hTc (subset_univ _) fun η hη => by
      rw [GeometricCurrentOn.boundary_apply]
      exact hVO P (d + 1) univ T (exteriorDerivativeTestOn univ d η) (Disjoint.mono_left
        (tsupport_exteriorDerivative_subset (η : DifferentialForm (Euclid P) d)) hη)
  rcases d with _ | m
  · -- Case `d = 0`: `∂T = Σ_{x ∈ F} m(x) δ_x`
    obtain ⟨F, m, hF, hsum⟩ :=
      Submission.dmcbr_cc_zero_current_finite_sum hMR hVO P T.boundary hbim hbc
    have hFT : ∀ x ∈ F, x ∈ T.support := fun x hx => hbsub (hF hx)
    -- `Σ_{x ∈ F} m(x) = 0`, testing `∂T` on a bump `0`-form `≡ 1` near `spt T`
    obtain ⟨ρ, hρ, hTρ⟩ := hTc.isBounded.subset_ball_lt 0 (0 : Euclid P)
    let ψ : ContDiffBump (0 : Euclid P) := ⟨ρ, 2 * ρ, hρ, by linarith⟩
    let gf : DifferentialForm (Euclid P) 0 := fun y =>
      ContinuousAlternatingMap.constOfIsEmpty ℝ (Euclid P) (Fin 0) (ψ y)
    have hg : IsTestForm gf ∧ tsupport gf ⊆ univ :=
      ⟨⟨(ContinuousAlternatingMap.constOfIsEmptyLIE ℝ (Euclid P) ℝ (Fin 0)).contDiff.comp
          ψ.contDiff,
        ψ.hasCompactSupport.comp_left
          (map_zero (ContinuousAlternatingMap.constOfIsEmptyLIE ℝ (Euclid P) ℝ (Fin 0)))⟩,
        subset_univ _⟩
    let g : TestFormOn (univ : Set (Euclid P)) 0 := ⟨gf, hg⟩
    have hdg : ∀ y ∈ ball (0 : Euclid P) ρ, exteriorDerivative gf y = 0 := by
      intro y hy
      have hψ : fderiv ℝ ψ y = 0 :=
        (ψ.eventuallyEq_one_of_mem_ball hy).fderiv_eq.trans (fderiv_const_apply 1)
      show extDeriv (fun x => ContinuousAlternatingMap.constOfIsEmpty ℝ (Euclid P) (Fin 0) (ψ x))
        y = 0
      rw [extDeriv_constOfIsEmpty, hψ]
      ext v
      simp
    have hTg : T.boundary g = 0 := by
      rw [GeometricCurrentOn.boundary_apply]
      refine hVO P (0 + 1) univ T (exteriorDerivativeTestOn univ 0 g)
        (Disjoint.mono ?_ hTρ disjoint_compl_left)
      exact closure_minimal (fun y hy hyρ => hy (hdg y hyρ)) isOpen_ball.isClosed_compl
    have htot : ∑ x ∈ F, (m x : ℝ) = 0 := by
      refine Eq.trans (Finset.sum_congr rfl fun x hx => ?_) ((hsum g).symm.trans hTg)
      show (m x : ℝ) = (m x : ℝ) * ψ x
      rw [ψ.one_of_mem_closedBall (ball_subset_closedBall (hTρ (hFT x hx))), mul_one]
    -- segments `S_x` with `∂S_x = δ_x − δ_0` and `spt S_x ⊆ [0, x]`
    choose S hSim hSb hSm hSsupp using Submission.dmcbr_cc_segment_current hMR P (0 : Euclid P)
    -- `Y = Σ_{x ∈ F} m(x) S_x` is integer multiplicity
    obtain ⟨Y, hYim, hYeval, hYmass⟩ :=
      Submission.cbr_cc_current_algebra.2.2 hIMC P 1 univ (Euclid P) F S m isOpen_univ
        fun x _ => hSim x
    refine ⟨Y, hYim, ?_, ?_, ?_⟩
    · -- `∂Y = ∂T`
      ext η
      calc Y.boundary η
          = ∑ x ∈ F, (m x : ℝ) * S x (exteriorDerivativeTestOn univ 0 η) := by
            rw [GeometricCurrentOn.boundary_apply]
            exact hYeval (exteriorDerivativeTestOn univ 0 η)
        _ = ∑ x ∈ F, ((m x : ℝ) * (η : DifferentialForm (Euclid P) 0) x (fun i => i.elim0) -
              (m x : ℝ) * (η : DifferentialForm (Euclid P) 0) 0 (fun i => i.elim0)) :=
            Finset.sum_congr rfl fun x _ => by
              rw [← mul_sub, ← hSb x η, GeometricCurrentOn.boundary_apply]
        _ = ∑ x ∈ F, (m x : ℝ) * (η : DifferentialForm (Euclid P) 0) x (fun i => i.elim0) -
              (∑ x ∈ F, (m x : ℝ)) * (η : DifferentialForm (Euclid P) 0) 0 (fun i => i.elim0) := by
            rw [Finset.sum_sub_distrib, Finset.sum_mul]
        _ = T.boundary η := by rw [htot, zero_mul, sub_zero, hsum η]
    · -- `M(Y) ≤ Σ_{x ∈ F} |m(x)| M(S_x) < ∞`
      exact (hYmass univ).trans_lt (ENNReal.sum_lt_top.2 fun x _ =>
        ENNReal.mul_lt_top (ENNReal.natCast_lt_top _) (hSm x))
    · -- `Y` vanishes off the compact `⋃_{x ∈ F} [0, x]`
      have hC : IsCompact (⋃ x ∈ F, segment ℝ (0 : Euclid P) x) :=
        F.isCompact_biUnion fun x _ => by
          rw [segment_eq_image_lineMap]
          exact isCompact_Icc.image AffineMap.lineMap_continuous
      refine (Submission.rsd_cmr_support_subset_of_vanish P 1 univ _ Y isOpen_univ hC
        (subset_univ _) fun ω hω => ?_).2
      rw [hYeval ω]
      refine Finset.sum_eq_zero fun x hx => ?_
      rw [hVO P 1 univ (S x) ω (hω.mono_right ((hSsupp x).trans
        (subset_iUnion₂ (s := fun x (_ : x ∈ F) => segment ℝ (0 : Euclid P) x) x hx))), mul_zero]
  · -- Case `d = m + 1`: fill the cycle `Z = ∂T` by the isoperimetric filling, `m + 1 < P`
    obtain ⟨c, -, hfill⟩ := hISO P m hdP
    obtain ⟨Y, hYim, hYb, hYm, hYsupp⟩ :=
      hfill T.boundary hbim hbc (GeometricCurrentOn.boundary_boundary T) hbm
    refine ⟨Y, hYim, hYb, hYm.trans_lt ENNReal.ofReal_lt_top, ?_⟩
    -- `Y` vanishes off the compact closure of a bounded thickening of `spt Z`
    exact (Submission.rsd_cmr_support_subset_of_vanish P (m + 2) univ _ Y isOpen_univ
      hbc.isBounded.thickening.isCompact_closure (subset_univ _) fun ω hω =>
        hVO P (m + 2) univ Y ω (hω.mono_right (hYsupp.trans subset_closure))).2
/-- **Integer multiplicity is local** (Simon Ch. 6, 3.1 and 6.3.1; localization remark 8.3(1)).
Assume (IMC)(a).  Let `X(ω) = ∫ ⟨ω, ξ⟩ dμ` for `ω ∈ 𝒟ᵏ(U)`, where `μ(ℝᴾ \ U) = 0`, `μ` is finite
on compact subsets of `U` and `ξ` is `μ`-measurable.  If each `x ∈ U` has an open neighbourhood
`W ⊆ U` with an integer multiplicity triple `R = (M, θ, ξ_R)` in `W` such that `μ⌞W = θHᵏ⌞M` and
`ξ = ξ_R` `μ`-a.e. on `W`, then `X` is integer multiplicity.  By Lindelöf, countably many such
`Wᵢ` cover `U`, and there are disjoint Borel pieces `Aᵢ ⊆ Wᵢ` covering `U`; then
`μ⌞Aᵢ = (θᵢHᵏ⌞Mᵢ)⌞Aᵢ`, and `ξ = ξᵢ` `Hᵏ`-a.e. on `Mᵢ ∩ Aᵢ` because `Hᵏ⌞Mᵢ ≪ θᵢHᵏ⌞Mᵢ`.  Gluing
the `Rᵢ` along the `Aᵢ` gives a triple in `U` with orientation `ξ` and weight `μ`, and it
represents `X`. -/
theorem Submission.cbr_isIntegerMultiplicity_of_local_reps : (∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) → ∀ (P k : ℕ) (U : Set (Euclid P)) (X : GeometricCurrentOn U k) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P k), IsOpen U → μ Uᶜ = 0 → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → AEStronglyMeasurable ξ μ → (∀ ω : TestFormOn U k, X ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ) → (∀ x ∈ U, ∃ (W : Set (Euclid P)) (R : IMRep W k), IsOpen W ∧ x ∈ W ∧ W ⊆ U ∧ μ.restrict W = R.measure ∧ ∀ᵐ y ∂μ, y ∈ W → ξ y = R.orient y) → IsIntegerMultiplicity X := by
  intro hIMC P k U X μ ξ hU hμU hμK hξ hX hloc
  -- Step 1: countably many neighbourhoods `Wᵢ` carrying local triples `Rᵢ`, and disjoint Borel
  -- pieces `Aᵢ ⊆ Wᵢ` covering `U` (Lindelöf)
  obtain ⟨ι, _, W, A, hWo, hWU, hpW, hAm, hAW, hAd, hAU⟩ :=
    Submission.cbrg_exists_countable_disjoint_refinement P U
      (fun W => ∃ R : IMRep W k, μ.restrict W = R.measure ∧ ∀ᵐ y ∂μ, y ∈ W → ξ y = R.orient y)
      fun x hx => by
        obtain ⟨W, R, hWo, hxW, hWU, hRμ, hRξ⟩ := hloc x hx
        exact ⟨W, hWo, hxW, hWU, R, hRμ, hRξ⟩
  choose R hRμ hRξ using hpW
  -- Step 2: `ξ = ξᵢ` holds `μ⌞Wᵢ`-a.e., i.e. `θᵢHᵏ⌞Mᵢ`-a.e., hence `Hᵏ⌞Mᵢ`-a.e. and so
  -- `Hᵏ`-a.e. on `Mᵢ ∩ Aᵢ`
  have hξR : ∀ i, ∀ᵐ y ∂(μHE[k].restrict ((R i).carrier ∩ A i)), ξ y = (R i).orient y := by
    intro i
    have h : ∀ᵐ y ∂(R i).measure, ξ y = (R i).orient y := by
      rw [← hRμ i, ae_restrict_iff' (hWo i).measurableSet]
      exact hRξ i
    exact ae_restrict_of_ae_restrict_of_subset inter_subset_left
      ((Submission.cbr_imRep_measure_basic P k (W i) (R i)).2.1.ae_le h)
  -- Step 3: glue the `Rᵢ` along the `Aᵢ`; `μ⌞Aᵢ = (μ⌞Wᵢ)⌞Aᵢ = (θᵢHᵏ⌞Mᵢ)⌞Aᵢ` as `Aᵢ ⊆ Wᵢ`
  obtain ⟨R', -, hR'o, hR'μ⟩ := Submission.cbrg_imRep_glue_disjoint hIMC ι P k U W A R μ ξ hU
    hWo hWU hAm hAd (by rw [hAU]; exact hμU)
    (fun i => by rw [← Measure.restrict_restrict_of_subset (μ := μ) (hAW i), hRμ i]) hμK hξ hξR
  -- Step 4: the glued triple represents `X`: `R'.action ω = ∫ ⟨ω, ξ⟩ dμ = X(ω)`
  refine ⟨R', fun ω => ?_⟩
  rw [hX ω, (Submission.cbr_imRep_measure_basic P k U R').2.2.2.2.2.2, hR'o, hR'μ]
/-- **Simon Ch. 6, 1.2 (p. 132)**: `Λⁿ(ℝᴾ)` is finite-dimensional.  An `n`-covector `α` is
determined by its values `α(e_{I(1)}, …, e_{I(n)})` on tuples of standard basis vectors
(alternating maps agreeing on distinct basis vectors are equal), so
`Φ α = (α(e ∘ I))_{I : Fin n → Fin P}` is an injective linear map into the finite-dimensional
space `ℝ^(Fin n → Fin P)`. -/
theorem Submission.lcn_covector_finiteDimensional : ∀ (P n : ℕ), FiniteDimensional ℝ (Covector (Euclid P) n) := by
  intro P n
  -- the standard basis `e` of `ℝᴾ`
  let e := (EuclideanSpace.basisFun (Fin P) ℝ).toBasis
  -- `Φ α = (α(e ∘ I))_I`, linear since addition and scaling of covectors are pointwise
  let Φ : Covector (Euclid P) n →ₗ[ℝ] ((Fin n → Fin P) → ℝ) :=
    { toFun := fun α I => α fun i => e (I i)
      map_add' := fun α β => rfl
      map_smul' := fun c α => rfl }
  -- `Φ α = Φ β` makes `α` and `β` agree on distinct basis vectors, hence everywhere
  refine FiniteDimensional.of_injective Φ fun α β h => ?_
  exact ContinuousAlternatingMap.toAlternatingMap_injective
    (e.ext_alternating fun v _ => congr_fun h v)

/-- **Equal set integrals against all test forms of an open `B` determine the orientation a.e.
on `B`** (orientation step of the locality of integer multiplicity).  On `E ⊆ B`,
`μ₂⌞E = (μ₂⌞B)⌞E = (μ₁⌞B)⌞E = μ₁⌞E`.  Fix a covector `α` and a compact `K ⊆ B`.  A smooth
Urysohn function `φ` with `φ = 1` on `K` and `tsupport φ` compact in `B` gives the test form
`ω = φ α ∈ 𝒟ᵏ(B)`, equal to `α` on `K`; so for Borel `s`, `∫_s ξ₁(α) d(μ₁⌞K) = ∫_{s∩K} ξ₁(ω) dμ₁
= ∫_{s∩K} ξ₂(ω) dμ₂ = ∫_s ξ₂(α) d(μ₁⌞K)`.  Both evaluations are bounded by `|α|` and `μ₁(K) < ∞`,
so they are `μ₁⌞K`-integrable and uniqueness of densities gives `ξ₁(α) = ξ₂(α)` `μ₁`-a.e. on `K`.
Testing on a finite basis of covectors (`Λᵏ` is finite-dimensional,
`Submission.lcn_covector_finiteDimensional`) gives `ξ₁ = ξ₂` `μ₁`-a.e. on `K`; each point of
`B` has a closed-ball neighbourhood `K ⊆ B`, and `μ₁`-null sets are local
(`measure_null_of_locally_null`, `ℝᴾ` second countable). -/
theorem Submission.cbr_orient_ae_eq_of_setIntegral_eq : ∀ (P k : ℕ) (B : Set (Euclid P)) (μ₁ μ₂ : Measure (Euclid P)) (ξ₁ ξ₂ : Euclid P → MultiVector P k), IsOpen B → (∀ K : Set (Euclid P), IsCompact K → K ⊆ B → μ₁ K < ∞) → μ₁.restrict B = μ₂.restrict B → AEStronglyMeasurable ξ₁ μ₁ → AEStronglyMeasurable ξ₂ μ₂ → (∀ᵐ x ∂μ₁, ∀ α : Covector (Euclid P) k, |ξ₁ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ₂, ∀ α : Covector (Euclid P) k, |ξ₂ x α| ≤ covectorEuclideanNorm α) → (∀ (E : Set (Euclid P)) (ω : TestFormOn B k), MeasurableSet E → ∫ x in E, ξ₁ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₁ = ∫ x in E, ξ₂ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₂) → ∀ᵐ x ∂μ₁, x ∈ B → ξ₁ x = ξ₂ x := by
  intro P k B μ₁ μ₂ ξ₁ ξ₂ hB hfin hres hm₁ hm₂ hb₁ hb₂ hint
  -- Step 1: on `E ⊆ B`, `μ₂⌞E = (μ₂⌞B)⌞E = (μ₁⌞B)⌞E = μ₁⌞E`
  have hrestr : ∀ E : Set (Euclid P), E ⊆ B → μ₂.restrict E = μ₁.restrict E := fun E hEB => by
    rw [← Measure.restrict_restrict_of_subset hEB, ← hres, Measure.restrict_restrict_of_subset hEB]
  -- Step 2: for a covector `α` and a compact `K ⊆ B`, `ξ₁(α) = ξ₂(α)` holds `μ₁⌞K`-a.e.
  have hcov : ∀ K : Set (Euclid P), IsCompact K → K ⊆ B → ∀ α : Covector (Euclid P) k,
      ∀ᵐ y ∂μ₁.restrict K, ξ₁ y α = ξ₂ y α := by
    intro K hKc hKB α
    have hKm : MeasurableSet K := hKc.isClosed.measurableSet
    -- a smooth cut-off `φ`, `φ = 1` on `K`, with `tsupport φ = closure V` compact in `B`
    obtain ⟨V, hVo, hKV, hVB, hVc⟩ := exists_open_between_and_isCompact_closure hKc hB hKB
    obtain ⟨φ, hφ, -, hφs, hφ1⟩ :=
      exists_contDiff_support_eq_eq_one_iff (n := ⊤) hVo hKc.isClosed hKV
    have hts : tsupport φ = closure V := by rw [tsupport, hφs]
    -- the test form `ω = φ α ∈ 𝒟ᵏ(B)`: smooth, `tsupport ω ⊆ tsupport φ = closure V`
    have hωφ : tsupport (fun y => φ y • α : DifferentialForm (Euclid P) k) ⊆ closure V :=
      (tsupport_smul_subset_left φ fun _ => α).trans hts.subset
    have hω : (fun y => φ y • α : DifferentialForm (Euclid P) k) ∈ testFormOnSubmodule B k :=
      ⟨⟨hφ.smul (contDiff_const (c := α)), hVc.of_isClosed_subset (isClosed_tsupport _) hωφ⟩,
        hωφ.trans hVB⟩
    -- `ξ₁(α)`, `ξ₂(α)` are a.e. strongly measurable and bounded by `|α|`, `μ₁ K = μ₂ K < ∞`
    have hK₁ : μ₁ K ≠ ∞ := (hfin K hKc hKB).ne
    have hK₂ : μ₂ K ≠ ∞ :=
      calc μ₂ K = μ₂.restrict K univ := (Measure.restrict_apply_univ K).symm
        _ = μ₁.restrict K univ := by rw [hrestr K hKB]
        _ = μ₁ K := Measure.restrict_apply_univ K
        _ ≠ ∞ := hK₁
    have hf : Integrable (fun y => ξ₁ y α) (μ₁.restrict K) :=
      Measure.integrableOn_of_bounded hK₁ (hm₁.apply_continuousLinearMap α)
        ((ae_restrict_of_ae hb₁).mono fun y hy => (Real.norm_eq_abs _).trans_le (hy α))
    have hg : Integrable (fun y => ξ₂ y α) (μ₁.restrict K) := by
      rw [← hrestr K hKB]
      exact Measure.integrableOn_of_bounded hK₂ (hm₂.apply_continuousLinearMap α)
        ((ae_restrict_of_ae hb₂).mono fun y hy => (Real.norm_eq_abs _).trans_le (hy α))
    -- equal set integrals for `μ₁⌞K`: on `s ∩ K`, `ω = α`
    refine Integrable.ae_eq_of_forall_setIntegral_eq _ _ hf hg fun s hs _ => ?_
    have hsK : MeasurableSet (s ∩ K) := hs.inter hKm
    have heq : ∀ ξ : Euclid P → MultiVector P k,
        EqOn (fun y => ξ y α) (fun y => ξ y (φ y • α)) (s ∩ K) := fun ξ y hy => by
      show ξ y α = ξ y (φ y • α)
      rw [(hφ1 y).1 hy.2, one_smul]
    rw [Measure.restrict_restrict hs]
    calc ∫ y in s ∩ K, ξ₁ y α ∂μ₁ = ∫ y in s ∩ K, ξ₁ y (φ y • α) ∂μ₁ :=
          setIntegral_congr_fun hsK (heq ξ₁)
      _ = ∫ y in s ∩ K, ξ₂ y (φ y • α) ∂μ₂ := hint (s ∩ K) ⟨_, hω⟩ hsK
      _ = ∫ y in s ∩ K, ξ₂ y (φ y • α) ∂μ₁ := by
          rw [hrestr (s ∩ K) (inter_subset_right.trans hKB)]
      _ = ∫ y in s ∩ K, ξ₂ y α ∂μ₁ := (setIntegral_congr_fun hsK (heq ξ₂)).symm
  -- Step 3: on a compact `K ⊆ B`, test on a basis of the finite-dimensional `Λᵏ`
  have := Submission.lcn_covector_finiteDimensional P k
  let b := Module.finBasis ℝ (Covector (Euclid P) k)
  have hK : ∀ K : Set (Euclid P), IsCompact K → K ⊆ B → ∀ᵐ y ∂μ₁, y ∈ K → ξ₁ y = ξ₂ y := by
    intro K hKc hKB
    refine (ae_restrict_iff' hKc.isClosed.measurableSet).1 ?_
    filter_upwards [ae_all_iff.2 fun i => hcov K hKc hKB (b i)] with y hy
    exact ContinuousLinearMap.coe_injective (b.ext hy)
  -- Step 4: each `x ∈ B` has a closed-ball neighbourhood `K ⊆ B`; null sets are local
  refine ae_iff.2 (measure_null_of_locally_null _ fun x hx => ?_)
  have hx' : ¬(x ∈ B → ξ₁ x = ξ₂ x) := hx
  obtain ⟨ε, hε, hεB⟩ := Metric.isOpen_iff.1 hB x (not_imp.1 hx').1
  refine ⟨_, inter_mem_nhdsWithin _ (closedBall_mem_nhds x (half_pos hε)),
    measure_mono_null ?_ (ae_iff.1 (hK _ (isCompact_closedBall x (ε / 2))
      ((closedBall_subset_ball (half_lt_self hε)).trans hεB)))⟩
  exact fun y hy h => hy.1 fun _ => h hy.2
/-- **Simon Ch. 3, 1.4**: approximate tangent planes are local and do not see `Hⁿ`-null
modifications.  If `M' ⊆ M`, `V` is open, `x ∈ V` and `Hⁿ((M \ M') ∩ V) = 0`, then an
approximate tangent plane of `M` at `x` is one of `M'`.  Given `f ∈ C_c(ℝᴾ)`, take
`B_s(x) ⊆ V` and `spt f ⊆ B_L(0)`.  For `0 < r < s / L` the parts of `η_{x,r}(M)` and
`η_{x,r}(M')` in `B_L(0)` differ inside `η_{x,r}((M \ M') ∩ V)`, which is `Hⁿ`-null because
`η_{x,r}` is Lipschitz.  So the blow-up integrals agree for small `r` and have the same limit. -/
theorem Submission.dtc_approxTangent_of_null_diff : ∀ (P n : ℕ) (M M' V : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)), M' ⊆ M → IsOpen V → x ∈ V → μHE[n] ((M \ M') ∩ V) = 0 → HasApproximateTangentSpaceAt n M x Q → HasApproximateTangentSpaceAt n M' x Q := by
  intro P n M M' V x Q hMM' hV hxV hnull hT
  refine ⟨hT.1, fun f => ?_⟩
  -- `B_s(x) ⊆ V` and `spt f ⊆ B_L(0)`
  obtain ⟨s, hs, hsV⟩ := Metric.isOpen_iff.mp hV x hxV
  obtain ⟨L, hL, hfL⟩ := f.hasCompactSupport.isCompact.isBounded.subset_ball_lt 0 0
  -- the blow-up integrals of `M` and `M'` agree for `0 < r < s / L`, so they have the same limit
  refine (hT.2 f).congr' ?_
  filter_upwards [Ioo_mem_nhdsGT (div_pos hs hL)] with r hr
  have hr0 : 0 < r := hr.1
  have hη : Poincare.SimonGMT.Chapter03.blowUpMap x r = fun y => r⁻¹ • (y - x) := rfl
  rw [hη]
  -- `f` vanishes off `B_L(0)`, so every set integral may be cut to `B_L(0)`
  have hfB : ∀ y, y ∉ ball (0 : Euclid P) L → f y = 0 := fun y hy =>
    image_eq_zero_of_notMem_tsupport fun h => hy (hfL h)
  have hcut : ∀ S : Set (Euclid P),
      ∫ y in S, f y ∂μHE[n] = ∫ y in ball (0 : Euclid P) L ∩ S, f y ∂μHE[n] := by
    intro S
    rw [← Measure.restrict_restrict measurableSet_ball]
    exact (setIntegral_eq_integral_of_forall_compl_eq_zero hfB).symm
  -- `η_{x,r}` is `r⁻¹`-Lipschitz, so it maps the `Hⁿ`-null set `(M \ M') ∩ V` to a null set
  have hnullimg : μHE[n] ((fun y : Euclid P => r⁻¹ • (y - x)) '' ((M \ M') ∩ V)) = 0 := by
    have hlip : LipschitzWith ‖r⁻¹‖₊ (fun y : Euclid P => r⁻¹ • (y - x)) :=
      LipschitzWith.of_dist_le_mul fun a b =>
        le_of_eq (by rw [dist_smul₀, dist_sub_right, coe_nnnorm])
    rw [Measure.euclideanHausdorffMeasure_def, Measure.smul_apply, ENNReal.smul_def,
      smul_eq_mul] at hnull ⊢
    have hH : μH[(n : ℝ)] ((M \ M') ∩ V) = 0 := by
      simpa [Measure.addHaarScalarFactor_volume_hausdorffMeasure_ne_zero n] using hnull
    have hle := hlip.hausdorffMeasure_image_le (Nat.cast_nonneg n) ((M \ M') ∩ V)
    rw [hH, mul_zero, nonpos_iff_eq_zero] at hle
    rw [hle, mul_zero]
  -- in `B_L(0)`, `η_{x,r}(M)` and `η_{x,r}(M')` differ inside `η_{x,r}((M \ M') ∩ V)`
  have hsub : (ball (0 : Euclid P) L ∩ (fun y : Euclid P => r⁻¹ • (y - x)) '' M) \
      (ball (0 : Euclid P) L ∩ (fun y : Euclid P => r⁻¹ • (y - x)) '' M') ⊆
      (fun y : Euclid P => r⁻¹ • (y - x)) '' ((M \ M') ∩ V) := by
    rintro y ⟨⟨hyB, ⟨z, hz, rfl⟩⟩, hy'⟩
    refine ⟨z, ⟨⟨hz, fun hz' => hy' ⟨hyB, z, hz', rfl⟩⟩, hsV ?_⟩, rfl⟩
    rw [mem_ball_zero_iff, norm_smul, norm_inv, Real.norm_of_nonneg hr0.le,
      inv_mul_lt_iff₀ hr0] at hyB
    have hrL := (lt_div_iff₀ hL).mp hr.2
    rw [mem_ball, dist_eq_norm]
    linarith
  -- hence the two parts are `Hⁿ`-a.e. equal (`M' ⊆ M` gives the other inclusion)
  have hae : (ball (0 : Euclid P) L ∩ (fun y : Euclid P => r⁻¹ • (y - x)) '' M' : Set (Euclid P))
      =ᵐ[μHE[n]] (ball (0 : Euclid P) L ∩ (fun y : Euclid P => r⁻¹ • (y - x)) '' M) := by
    rw [ae_eq_set]
    constructor
    · rw [sdiff_eq_empty.mpr (inter_subset_inter_right _ (image_mono hMM'))]
      exact measure_empty
    · exact measure_mono_null hsub hnullimg
  rw [hcut, hcut ((fun y : Euclid P => r⁻¹ • (y - x)) '' M'), Measure.restrict_congr_set hae]

/-- **Simon Ch. 6, 3.1 and 2.16** (with Ch. 3, 1.4): if `T = τ(M, θ, ξ)` is integer multiplicity
in `U` and `V ⊆ U` is open, then `T⌞V = τ(M ∩ V, θ, ξ)` is integer multiplicity in `V`.  The
restricted triple inherits measurability, rectifiability, positivity and local integrability from
`(M, θ, ξ)`.  At `Hⁿ`-a.e. `x ∈ M ∩ V` the approximate tangent space of `M` is also that of
`M ∩ V`, as the removed set `M ∖ (M ∩ V)` misses the open set `V ∋ x`
(`dtc_approxTangent_of_null_diff`).  A test form supported in `V` vanishes on `M ∖ V`, so its
integrals over `M` and over `M ∩ V` agree.  Openness of `U` is not used. -/
theorem Submission.dtc_restrictDomain_isIntegerMultiplicity : ∀ (P n : ℕ) (U V : Set (Euclid P)) (hVU : V ⊆ U) (T : GeometricCurrentOn U n), IsOpen V → IsIntegerMultiplicity T → IsIntegerMultiplicity (T.restrictDomain hVU) := by
  rintro P n U V hVU T hV ⟨R, hR⟩
  -- Step 1: `M ∩ V` is Borel
  have hMV : MeasurableSet (R.carrier ∩ V) := R.measurableSet_carrier.inter hV.measurableSet
  -- the restricted triple `R' = (M ∩ V, θ, ξ)` in `V`
  let R' : IMRep V n :=
    { carrier := R.carrier ∩ V
      mult := R.mult
      orient := R.orient
      measurableSet_carrier := hMV
      -- Step 2: `M ∩ V ⊆ V`
      carrier_subset := inter_subset_right
      -- Step 3: a subset of a countably `n`-rectifiable set is countably `n`-rectifiable
      rectifiable := R.rectifiable.mono inter_subset_left
      -- Step 4: `θ` is measurable, and positive on `M ∩ V ⊆ M`
      measurable_mult := R.measurable_mult
      mult_pos := fun x hx => R.mult_pos x hx.1
      -- Step 5: for compact `K ⊆ V`, `(M ∩ V) ∩ K = M ∩ K` and `K ⊆ V ⊆ U`
      locallyIntegrable_mult := fun K hK hKV => by
        rw [inter_assoc, inter_eq_right.2 hKV]
        exact R.locallyIntegrable_mult K hK (hKV.trans hVU)
      -- Step 6: `Hⁿ⌞(M ∩ V) ≤ Hⁿ⌞M`
      aestronglyMeasurable_orient :=
        R.aestronglyMeasurable_orient.mono_measure (Measure.restrict_mono inter_subset_left le_rfl)
      -- Step 7: at `Hⁿ⌞(M ∩ V)`-a.e. `x`, the plane `Q` oriented by `ξ(x)` stays the approximate
      -- tangent space, since `(M ∖ (M ∩ V)) ∩ V = ∅`
      orients := by
        filter_upwards [ae_restrict_of_ae_restrict_of_subset
          (inter_subset_left : R.carrier ∩ V ⊆ R.carrier) R.orients, ae_restrict_mem hMV]
          with x hx hxMV
        obtain ⟨Q, hQ, hξQ⟩ := hx
        have hnull : μHE[n] ((R.carrier \ (R.carrier ∩ V)) ∩ V) = 0 := by
          rw [sdiff_self_inter, sdiff_inter_self, measure_empty]
        exact ⟨Q, Submission.dtc_approxTangent_of_null_diff P n R.carrier (R.carrier ∩ V) V x Q
          inter_subset_left hV hxMV.2 hnull hQ, hξQ⟩ }
  -- Step 8: `T⌞V(ω) = T(ιω) = ∫_M θ⟨ω, ξ⟩ dHⁿ = ∫_{M ∩ V} θ⟨ω, ξ⟩ dHⁿ`, as `ω = 0` off `V`
  refine ⟨R', fun ω => ?_⟩
  rw [GeometricCurrentOn.restrictDomain_apply, hR, testFormOnInclusion_coe]
  change ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x ((ω : DifferentialForm (Euclid P) n) x)
      ∂μHE[n] =
    ∫ x in R.carrier ∩ V, (R.mult x : ℝ) * R.orient x ((ω : DifferentialForm (Euclid P) n) x)
      ∂μHE[n]
  refine setIntegral_eq_of_subset_of_forall_sdiff_eq_zero R.measurableSet_carrier
    inter_subset_left fun x hx => ?_
  have hxω : x ∉ tsupport (ω : DifferentialForm (Euclid P) n) :=
    fun h => hx.2 ⟨hx.1, ω.property.2 h⟩
  rw [image_eq_zero_of_notMem_tsupport hxω, map_zero, mul_zero]
/-- Measures `μ, ν` on `ℝᴾ` that agree on the open subsets of an open set `O`, with `μ` finite on
compact subsets of `O`, agree on the Borel subsets of `O`.  `O` is exhausted by the open sets
`Oᵢ = {x : |x| < i, dist(x, ℝᴾ ∖ O) > 1/(i+1)}`, whose closures are compact subsets of `O`; the
finite measures `μ⌞Oᵢ, ν⌞Oᵢ` agree on the π-system of open sets, hence everywhere, and continuity
from below along `A ∩ Oᵢ ↑ A` gives `μ(A) = ν(A)`. -/
theorem Submission.cmc_ml_measure_eq_of_eq_on_open_subsets : ∀ (P : ℕ) (O : Set (Euclid P)) (μ ν : Measure (Euclid P)), IsOpen O → (∀ C : Set (Euclid P), IsCompact C → C ⊆ O → μ C ≠ ∞) → (∀ G : Set (Euclid P), IsOpen G → G ⊆ O → μ G = ν G) → ∀ A : Set (Euclid P), MeasurableSet A → A ⊆ O → μ A = ν A := by
  intro P O μ ν hO hfin hopen A hA hAO
  -- `d(x) = dist(x, ℝᴾ ∖ O) ∈ [0, ∞]` (`d ≡ ∞` if `O = ℝᴾ`), and the thresholds `1/(i+1)`
  set d : Euclid P → ℝ≥0∞ := fun x => infEDist x Oᶜ
  have hdc : Continuous d := continuous_infEDist
  set c : ℕ → ℝ≥0∞ := fun i => ((i + 1 : ℕ) : ℝ≥0∞)⁻¹
  have hc0 : ∀ i, c i ≠ 0 := fun i => ENNReal.inv_ne_zero.mpr (ENNReal.natCast_ne_top _)
  -- 1. the exhaustion `Oᵢ = {x : |x| < i, d(x) > 1/(i+1)}`
  set Oi : ℕ → Set (Euclid P) := fun i => ball 0 i ∩ d ⁻¹' Ioi (c i)
  -- (a) `Oᵢ` is open
  have hOi_open : ∀ i, IsOpen (Oi i) := fun i => isOpen_ball.inter (isOpen_Ioi.preimage hdc)
  -- (b) `closure Oᵢ ⊆ Fᵢ = {x : |x| ≤ i, d(x) ≥ 1/(i+1)} ⊆ O`
  have hOi_cl : ∀ i, closure (Oi i) ⊆ closedBall 0 i ∩ d ⁻¹' Ici (c i) := fun i =>
    closure_minimal (inter_subset_inter ball_subset_closedBall (preimage_mono Ioi_subset_Ici_self))
      (isClosed_closedBall.inter (isClosed_Ici.preimage hdc))
  have hOi_O : ∀ i, closure (Oi i) ⊆ O := by
    intro i x hx
    by_contra hxO
    have h0 : d x = 0 := infEDist_zero_of_mem hxO
    have h1 : c i ≤ d x := (hOi_cl i hx).2
    rw [h0, nonpos_iff_eq_zero] at h1
    exact hc0 i h1
  -- (c) `closure Oᵢ` is compact
  have hOi_cpt : ∀ i, IsCompact (closure (Oi i)) := fun i =>
    (isCompact_closedBall 0 i).of_isClosed_subset isClosed_closure fun x hx => (hOi_cl i hx).1
  -- (d) `Oᵢ ⊆ Oⱼ` for `i ≤ j`
  have hOi_mono : Monotone Oi := by
    intro i j hij x hx
    have h1 : x ∈ ball (0 : Euclid P) j := ball_subset_ball (by exact_mod_cast hij) hx.1
    have h2 : c i < d x := hx.2
    have h3 : c j ≤ c i := ENNReal.inv_le_inv.mpr (by exact_mod_cast Nat.succ_le_succ hij)
    have h4 : c j < d x := h3.trans_lt h2
    exact ⟨h1, h4⟩
  -- (e) `⋃ᵢ Oᵢ = O`
  have hOi_union : ⋃ i, Oi i = O := by
    refine Subset.antisymm (iUnion_subset fun i => subset_closure.trans (hOi_O i)) fun x hx => ?_
    have hdx : 0 < d x := infEDist_pos_iff_notMem_closure.mpr (by
      rw [hO.isClosed_compl.closure_eq]; exact fun h => h hx)
    obtain ⟨m, hm⟩ := ENNReal.exists_inv_nat_lt hdx.ne'
    obtain ⟨k, hk⟩ := exists_nat_gt ‖x‖
    have h1 : x ∈ ball (0 : Euclid P) (max m k : ℕ) := by
      rw [mem_ball, dist_zero_right]
      exact hk.trans_le (by exact_mod_cast le_max_right m k)
    have h2 : c (max m k) ≤ (m : ℝ≥0∞)⁻¹ :=
      ENNReal.inv_le_inv.mpr (by exact_mod_cast (le_max_left m k).trans (Nat.le_succ _))
    have h3 : c (max m k) < d x := h2.trans_lt hm
    exact mem_iUnion.mpr ⟨max m k, h1, h3⟩
  -- 2. `μ(Oᵢ) ≤ μ(closure Oᵢ) < ∞`
  have hμOi : ∀ i, μ (Oi i) ≠ ∞ := fun i =>
    ne_top_of_le_ne_top (hfin _ (hOi_cpt i) (hOi_O i)) (measure_mono subset_closure)
  -- 3. `μ⌞Oᵢ = ν⌞Oᵢ`: finite measures agreeing on the π-system of open sets (and on `ℝᴾ`)
  have hrestr : ∀ i, μ.restrict (Oi i) = ν.restrict (Oi i) := by
    intro i
    have : IsFiniteMeasure (μ.restrict (Oi i)) := isFiniteMeasure_restrict.mpr (hμOi i)
    have hG : ∀ G : Set (Euclid P), IsOpen G → μ.restrict (Oi i) G = ν.restrict (Oi i) G := by
      intro G hG
      rw [Measure.restrict_apply hG.measurableSet, Measure.restrict_apply hG.measurableSet]
      exact hopen _ (hG.inter (hOi_open i))
        (inter_subset_right.trans (subset_closure.trans (hOi_O i)))
    exact ext_of_generate_finite _ BorelSpace.measurable_eq isPiSystem_isOpen
      (fun G hG' => hG G hG') (hG univ isOpen_univ)
  -- 4. continuity from below along `A ∩ Oᵢ ↑ A`
  have hAunion : A = ⋃ i, A ∩ Oi i := by
    rw [← inter_iUnion, hOi_union, inter_eq_left.mpr hAO]
  have hmono : Monotone fun i => A ∩ Oi i := fun i j hij =>
    inter_subset_inter_right _ (hOi_mono hij)
  rw [hAunion, hmono.measure_iUnion, hmono.measure_iUnion]
  refine iSup_congr fun i => ?_
  rw [← Measure.restrict_apply hA, ← Measure.restrict_apply hA, hrestr i]

/-- **Foundations of the closure step** (Simon Ch. 6, 2.7–2.8, 2.35–2.37, 3.1, 8.3; Ch. 1, 4.4).
(REP): a current `T` with locally finite mass is `T(ω) = ∫ ⟨ω, ξ⟩ dμ` with `μ(W) = M_W(T)` and
`|ξ| ≤ 1` (`dimred_mbl_fnd_exists_massRepresentation_core`); if `∂T` also has locally finite
mass, then `μ ≪ Hⁿ` for this same `(μ, ξ)` (`dimred_mbl_fnd_null_of_representation`).
(T1): measures with locally bounded masses have a vaguely convergent subsequence
(`cbr_vague_convergent_subseq`); its limit is a Radon measure on `U`
(`cbr_vague_limit_measure`) satisfying the portmanteau inequalities (`cbr_vague_portmanteau`).
(T2) and (MM) are `cbr_sublevel_restriction_tendsto` and `cbr_slice_mass_majorant`.
(IML): restriction to an open `V ⊆ U` preserves integer multiplicity
(`dtc_restrictDomain_isIntegerMultiplicity`).  Conversely, assume (REP), (MR) and (IMC), and
write `X = ξ·μ` by (REP).  Let `R` represent `X⌞B` on a ball `B ⊆ U`.  For `G ⊆ B`, `X` and
`X⌞B` have the same admissible forms for `M_G`.  So `μ(G) = M_G(X) = M_G(X⌞B) = μ_R(G)` for
open `G ⊆ B` by (MR), and `μ⌞B = μ_R` (`cmc_ml_measure_eq_of_eq_on_open_subsets`; `μ_R` lives
on `M_R ⊆ B`).  Both `ξ·μ` and `ξ_R·μ_R` represent `X⌞B`.  Hence their set integrals agree
(`cbr_setIntegral_eq_of_integral_eq`), so `ξ = ξ_R` `μ`-a.e. on `B`
(`cbr_orient_ae_eq_of_setIntegral_eq`).  The local triples then glue
(`cbr_isIntegerMultiplicity_of_local_reps`). -/
theorem Submission.dtc_bc_tc_cl_foundations : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) ∧ ((∀ (P : ℕ) (U : Set (Euclid P)) (μs : ℕ → Measure (Euclid P)), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ⨆ j, μs j K < ∞) → ∃ (φ : ℕ → ℕ) (μ : Measure (Euclid P)), StrictMono φ ∧ μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → tsupport f ⊆ U → Tendsto (fun j => ∫ x, f x ∂(μs (φ j))) atTop (𝓝 (∫ x, f x ∂μ))) ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → limsup (fun j => μs (φ j) K) atTop ≤ μ K) ∧ (∀ G : Set (Euclid P), IsOpen G → G ⊆ U → μ G ≤ liminf (fun j => μs (φ j) G) atTop)) ∧ (∀ (P k : ℕ) (U : Set (Euclid P)) (Xs : ℕ → GeometricCurrentOn U k) (X : GeometricCurrentOn U k) (μs : ℕ → Measure (Euclid P)) (ξs : ℕ → Euclid P → MultiVector P k) (μX μ : Measure (Euclid P)) (ξX : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (t : ℝ), IsOpen U → Continuous f → WeaklyConvergesOn Xs X → (∀ j, ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μs j K < ∞) → (∀ j, AEStronglyMeasurable (ξs j) (μs j)) → (∀ j, ∀ᵐ x ∂(μs j), ∀ α : Covector (Euclid P) k, |ξs j x α| ≤ covectorEuclideanNorm α) → (∀ j, ∀ ω : TestFormOn U k, Xs j ω = ∫ x, ξs j x ((ω : DifferentialForm (Euclid P) k) x) ∂(μs j)) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μX K < ∞) → AEStronglyMeasurable ξX μX → (∀ᵐ x ∂μX, ∀ α : Covector (Euclid P) k, |ξX x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U k, X ω = ∫ x, ξX x ((ω : DifferentialForm (Euclid P) k) x) ∂μX) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → limsup (fun j => μs j K) atTop ≤ μ K) → μ {x | f x = t} = 0 → ∀ ω : TestFormOn U k, Tendsto (fun j => ∫ x in {x | f x < t}, ξs j x ((ω : DifferentialForm (Euclid P) k) x) ∂(μs j)) atTop (𝓝 (∫ x in {x | f x < t}, ξX x ((ω : DifferentialForm (Euclid P) k) x) ∂μX))) ∧ (∀ (P : ℕ) (μs : ℕ → Measure (Euclid P)) (f : Euclid P → ℝ) (G : Set (Euclid P)) (a b : ℝ) (L : NNReal) (Z : ℕ → ℝ → ℝ≥0∞), Continuous f → (∀ j, μs j (G ∩ {x | a < f x ∧ f x < b}) < ∞) → (∀ (j : ℕ) (t : ℝ), t ∈ Ioo a b → Z j t ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μs j (G ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) → ∃ g : ℝ → ℝ≥0∞, Measurable g ∧ (∀ᵐ t ∂(volume : Measure ℝ), t ∈ Ioo a b → liminf (fun j => Z j t) atTop ≤ g t) ∧ ∫⁻ t in Ioo a b, g t ≤ (L : ℝ≥0∞) * liminf (fun j => μs j (G ∩ {x | a < f x ∧ f x < b})) atTop)) ∧ ((∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (P k : ℕ) (U : Set (Euclid P)) (X : GeometricCurrentOn U k), IsOpen U → ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → X.massOn W < ∞) → (∀ x ∈ U, ∃ r : ℝ, 0 < r ∧ ∃ h : ball x r ⊆ U, IsIntegerMultiplicity (X.restrictDomain h)) → IsIntegerMultiplicity X) ∧ (∀ (V : Set (Euclid P)) (h : V ⊆ U), IsOpen V → IsIntegerMultiplicity X → IsIntegerMultiplicity (X.restrictDomain h))) := by
  refine ⟨?_, ⟨?_, Submission.cbr_sublevel_restriction_tendsto,
    Submission.cbr_slice_mass_majorant⟩, ?_⟩
  · -- (REP): the representation core, then absolute continuity for the same `(μ, ξ)`
    intro P n U T hU hmass
    obtain ⟨μ, ξ, hμU, hμK, hμW, hξ, hξα, hTξ⟩ :=
      Submission.dimred_mbl_fnd_exists_massRepresentation_core P n U T hU hmass
    exact ⟨μ, ξ, hμU, hμK, hμW, hξ, hξα, hTξ, fun hbd =>
      Submission.dimred_mbl_fnd_null_of_representation P n U T μ ξ hU hbd hμU hμK hμW hξ hξα
        hTξ⟩
  · -- (T1): a vaguely convergent subsequence, its limit measure and the portmanteau inequalities
    intro P U μs hU hbound
    obtain ⟨φ, hφ, hconv⟩ := Submission.cbr_vague_convergent_subseq P U μs hU hbound
    -- `μ_{φ(j)}(K) ≤ ⨆ᵢ μᵢ(K) < ∞` for compact `K ⊆ U`
    have hfin : ∀ (j : ℕ) (K : Set (Euclid P)), IsCompact K → K ⊆ U → μs (φ j) K < ∞ :=
      fun j K hK hKU => (le_iSup (fun i => μs i K) (φ j)).trans_lt (hbound K hK hKU)
    obtain ⟨μ, hμU, hμK, hμconv⟩ :=
      Submission.cbr_vague_limit_measure P U (fun j => μs (φ j)) hU hfin hconv
    obtain ⟨hlimsup, hliminf⟩ :=
      Submission.cbr_vague_portmanteau P U (fun j => μs (φ j)) μ hU hfin hμK hμconv
    exact ⟨φ, μ, hφ, hμU, hμK, hμconv, hlimsup, hliminf⟩
  · -- (IML)
    intro hREP hMR hIMC P k U X hU
    -- (2): restriction to an open `V ⊆ U` preserves integer multiplicity
    refine ⟨fun hmass hloc => ?_, fun V hVU hV hX =>
      Submission.dtc_restrictDomain_isIntegerMultiplicity P k U V hVU X hV hX⟩
    -- (1), Step 1: `X = ξ·μ` with `μ(W) = M_W(X)` by (REP); it suffices to give local triples
    obtain ⟨μ, ξ, hμU, hμK, hμmass, hξmeas, hξbound, hXrep, -⟩ := hREP P k U X hU hmass
    refine Submission.cbr_isIntegerMultiplicity_of_local_reps hIMC.1 P k U X μ ξ hU hμU hμK
      hξmeas hXrep fun x hx => ?_
    -- Step 2: a ball `B = B_r(x) ⊆ U` and a triple `R` representing `X⌞B`
    obtain ⟨r, hr, hB, R, hR⟩ := hloc x hx
    obtain ⟨hRac, -, -, hRcompl, hRK, hRmeas, hRaction⟩ :=
      Submission.cbr_imRep_measure_basic P k (ball x r) R
    have hμKB : ∀ K : Set (Euclid P), IsCompact K → K ⊆ ball x r → μ K < ∞ :=
      fun K hK hKB => hμK K hK (hKB.trans hB)
    -- `|ξ_R| ≤ 1` holds `Hᵏ⌞M_R`-a.e. by (IMC)(d), hence `μ_R`-a.e.
    have hRbound : ∀ᵐ y ∂R.measure, ∀ α : Covector (Euclid P) k,
        |R.orient y α| ≤ covectorEuclideanNorm α :=
      hRac.ae_le (hIMC.2.2.2 P k (ball x r) R)
    -- Step 3: `M_G(X) = M_G(X⌞B)` for `G ⊆ B`: the admissible forms are the same forms
    have hmassB : ∀ G : Set (Euclid P), G ⊆ ball x r →
        X.massOn G = (X.restrictDomain hB).massOn G := by
      intro G hGB
      unfold GeometricCurrentOn.massOn
      congr 1
      ext s
      constructor
      · rintro ⟨ω, hω, rfl⟩
        exact ⟨⟨ω, ω.property.1, hω.1.trans hGB⟩, hω, rfl⟩
      · rintro ⟨ω', hω', rfl⟩
        exact ⟨testFormOnInclusion hB k ω', hω', rfl⟩
    -- Step 4: `μ(G) = M_G(X) = M_G(X⌞B) = μ_R(G)` for open `G ⊆ B` by (MR), so `μ⌞B = μ_R⌞B`
    have hopen : ∀ G : Set (Euclid P), IsOpen G → G ⊆ ball x r → μ G = R.measure G := by
      intro G hG hGB
      rw [← hμmass G hG, hmassB G hGB]
      exact hMR P k (ball x r) (X.restrictDomain hB) R isOpen_ball hR G hG
    have hborel := Submission.cmc_ml_measure_eq_of_eq_on_open_subsets P (ball x r) μ R.measure
      isOpen_ball (fun C hC hCB => (hμKB C hC hCB).ne) hopen
    have hrestr : μ.restrict (ball x r) = R.measure.restrict (ball x r) :=
      (Measure.restrict_congr_meas measurableSet_ball).2 fun A hAB hA => hborel A hA hAB
    -- `μ_R` lives on `M_R ⊆ B`, so `μ_R⌞B = μ_R`
    have hRB : R.measure.restrict (ball x r) = R.measure :=
      Measure.restrict_eq_self_of_ae_mem
        (Filter.mem_of_superset (mem_ae_iff.2 hRcompl) R.carrier_subset)
    -- Step 5: `∫ ⟨ω, ξ⟩ dμ = X(ιω) = X⌞B(ω) = ∫ ⟨ω, ξ_R⟩ dμ_R` for `ω ∈ 𝒟ᵏ(B)`, so the
    -- integrals over every Borel set agree
    have hset := Submission.cbr_setIntegral_eq_of_integral_eq P k (ball x r) μ R.measure 0 ξ
      R.orient 0 isOpen_ball hμKB hRK (fun K _ _ => by simp) hξmeas hRmeas
      (aestronglyMeasurable_zero_measure _) (ae_of_all μ hξbound) hRbound
      (ae_of_all _ fun y α => by simpa using covectorEuclideanNorm_nonneg α) fun ω => by
        rw [integral_zero_measure, add_zero, ← hRaction (ω : DifferentialForm (Euclid P) k),
          ← hR ω, GeometricCurrentOn.restrictDomain_apply, hXrep, testFormOnInclusion_coe]
    -- Step 6: hence `ξ = ξ_R` `μ`-a.e. on `B`, and `(B, R)` is the required local triple
    have hae := Submission.cbr_orient_ae_eq_of_setIntegral_eq P k (ball x r) μ R.measure ξ
      R.orient isOpen_ball hμKB hrestr hξmeas hRmeas (ae_of_all μ hξbound) hRbound
      fun E ω hE => by rw [hset E ω hE, Measure.restrict_zero, integral_zero_measure, add_zero]
    exact ⟨ball x r, R, isOpen_ball, mem_ball_self hr, hB, hrestr.trans hRB, hae⟩

/-- **Integer slices pass to weak limits** (Simon Ch. 6, Remark 8.3(1) and step (1) of the proof of
Theorem 8.2, p. 176, for the slices 4.6–4.10).  Let `X_i ⇀ X` in `𝒟_{d+1}(ℝᴾ)` with
`sup_i (M_W(X_i) + M_W(∂X_i)) < ∞` for open `W ⊂⊂ ℝᴾ`, and suppose every `X_i` has the integer
slice property: for all admissible representations of `X_i`, `∂X_i` and Lipschitz `f`, a.e. slice
`∂(X_i ⌞ {f < t}) − (∂X_i) ⌞ {f < t}` is integer multiplicity.  Then `X` has it too.  Given
representations of `X`, `∂X` and an `L`-Lipschitz `f`, take mass representations `(μ_i, ξ_i)`,
`(μ'_i, ξ'_i)` of `X_i`, `∂X_i` (REP) and limit measures `ν`, `ν'` of `μ_i`, `μ'_i` along a common
subsequence `φ` (T1).  Slicing (SL) gives `A_{i,t}`, `B_{i,t}` whose slice
`Z_{i,t} = ∂A_{i,t} − B_{i,t}` has `M_W(Z_{i,t}) + M_W(∂Z_{i,t})` bounded by the lower left
density of `μ_i + μ'_i`.  For a.e. `t`: every `Z_{i,t}` is integer multiplicity (ISP of `X_i`),
`liminf_j (M + ∂M)_{B_{k+1}(0)}(Z_{φ(j),t}) < ∞` for all `k` (MM), and `ν{f = t} = ν'{f = t} = 0`.
At such `t`, `Z_{φ(j),t} ⇀ ∂A − B` (T2), and `CL_P(d)` on balls glued by (IML) shows that `∂A − B`
is integer multiplicity. -/
theorem Submission.dtc_bc_tc_cl_slice_property_of_weak_limit : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (P d : ℕ), d + 1 < P → (∀ (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U d) (T : GeometricCurrentOn U d), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T) → (∀ (Xs : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (X : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), (∀ i, (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), Xs i ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (Xs i).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B))) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ → ⨆ i, ((Xs i).massOn W + (Xs i).boundary.massOn W) < ∞) → WeaklyConvergesOn Xs X → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), X ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (X).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B))) := by
  intro MR IMC P d _hdP CL Xs X hISP hmass hconv μ μ' ξ ξ' hμ hμ' hξm hξm' hξ hξ' hX hbX f L hf
  obtain ⟨REP, ⟨T1, T2, MM⟩, IMLc⟩ := Submission.dtc_bc_tc_cl_foundations
  have IML := IMLc REP MR IMC
  -- `M_W(X_i) + M_W(∂X_i)` is bounded uniformly in `i` for open `W ⊂⊂ ℝᴾ`
  have hbd : ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ → ∀ i,
      (Xs i).massOn W + (Xs i).boundary.massOn W < ∞ := fun W hW hWc i =>
    lt_of_le_of_lt (le_iSup (fun i => (Xs i).massOn W + (Xs i).boundary.massOn W) i)
      (hmass W hW hWc)
  -- (REP): mass representations `(μ_i, ξ_i)` of `X_i` and `(μ'_i, ξ'_i)` of `∂X_i`
  choose μs ξs _hμs0 hμsK hμsM hξsm hξsb hXs _hμsnull using fun i =>
    REP P (d + 1) univ (Xs i) isOpen_univ fun W hW hWc =>
      lt_of_le_of_lt le_self_add (hbd W hW hWc i)
  choose μs' ξs' _hμs'0 hμs'K hμs'M hξsm' hξsb' hbXs _hμs'null using fun i =>
    REP P d univ (Xs i).boundary isOpen_univ fun W hW hWc =>
      lt_of_le_of_lt le_add_self (hbd W hW hWc i)
  -- `sup_i (μ_i + μ'_i)(B_r(0)) < ∞`, hence `sup_i (μ_i + μ'_i)(K) < ∞` for compact `K`
  have hball : ∀ r : ℝ, ⨆ i, (μs i + μs' i) (ball (0 : Euclid P) r) < ∞ := by
    intro r
    have hcc : CompactlyContained (ball (0 : Euclid P) r) univ :=
      ⟨(isCompact_closedBall (0 : Euclid P) r).of_isClosed_subset isClosed_closure
        closure_ball_subset_closedBall, subset_univ _⟩
    have heq : ⨆ i, (μs i + μs' i) (ball (0 : Euclid P) r) =
        ⨆ i, ((Xs i).massOn (ball (0 : Euclid P) r) +
          (Xs i).boundary.massOn (ball (0 : Euclid P) r)) :=
      iSup_congr fun i => by
        rw [Measure.add_apply, hμsM i _ isOpen_ball, hμs'M i _ isOpen_ball]
    rw [heq]
    exact hmass _ isOpen_ball hcc
  have hcpt : ∀ K : Set (Euclid P), IsCompact K → ⨆ i, (μs i + μs' i) K < ∞ := by
    intro K hK
    obtain ⟨r, hr⟩ := hK.isBounded.subset_ball (0 : Euclid P)
    exact lt_of_le_of_lt (iSup_mono fun i => measure_mono hr) (hball r)
  -- (T1): limit measures `ν`, `ν'` of `μ_i`, `μ'_i` along a common subsequence `φ`
  obtain ⟨φ₁, ν, hφ₁, -, hνK, -, hνlim, -⟩ := T1 P univ μs isOpen_univ fun K hK _ =>
    lt_of_le_of_lt (iSup_mono fun i => by rw [Measure.add_apply]; exact le_self_add) (hcpt K hK)
  obtain ⟨φ₂, ν', hφ₂, -, hν'K, -, hν'lim, -⟩ := T1 P univ (fun j => μs' (φ₁ j)) isOpen_univ
    fun K hK _ => lt_of_le_of_lt (iSup_le fun j =>
      le_trans (by rw [Measure.add_apply]; exact le_add_self)
        (le_iSup (fun i => (μs i + μs' i) K) (φ₁ j))) (hcpt K hK)
  obtain ⟨φ, hφ, hνφ, hν'φ⟩ : ∃ φ : ℕ → ℕ, StrictMono φ ∧
      (∀ K : Set (Euclid P), IsCompact K → K ⊆ univ →
        limsup (fun j => μs (φ j) K) atTop ≤ ν K) ∧
      (∀ K : Set (Euclid P), IsCompact K → K ⊆ univ →
        limsup (fun j => μs' (φ j) K) atTop ≤ ν' K) :=
    ⟨fun j => φ₁ (φ₂ j), hφ₁.comp hφ₂, fun K hK hKU =>
      (hφ₂.tendsto_atTop.limsup_comp_le_limsup (u := fun j => μs (φ₁ j) K)).trans
        (hνlim K hK hKU), hν'lim⟩
  -- (SL): slices `A_{i,t}`, `B_{i,t}` of `X_i` with the combined mass majorant
  choose As Bs hAs hBs hZ using fun i =>
    Submission.dtc_bc_tc_cl_sl_slice_sum_mass_bound Submission.cmc_slice_mass_bounds P d univ
      (Xs i) (μs i) (μs' i) (ξs i) (ξs' i) f L isOpen_univ (hμsK i) (hμs'K i) (hξsm i)
      (hξsm' i) (ae_of_all _ (hξsb i)) (ae_of_all _ (hξsb' i)) (hXs i) (hbXs i) hf
  -- ISP of `X_i`: for a.e. `t`, every `∂A_{i,t} − B_{i,t}` is integer multiplicity
  have hIM : ∀ᵐ t ∂(volume : Measure ℝ), ∀ i,
      IsIntegerMultiplicity ((As i t).boundary - Bs i t) := by
    refine ae_all_iff.2 fun i => ?_
    filter_upwards [hISP i (μs i) (μs' i) (ξs i) (ξs' i)
      (fun K hK => hμsK i K hK (subset_univ K)) (fun K hK => hμs'K i K hK (subset_univ K))
      (hξsm i) (hξsm' i) (ae_of_all _ (hξsb i)) (ae_of_all _ (hξsb' i)) (hXs i) (hbXs i)
      f L hf] with t ht
    exact ht (As i t) (Bs i t) (hAs i t) (hBs i t)
  -- (MM): for a.e. `t`, `liminf_j (M + ∂M)_{B_{k+1}(0)}(Z_{φ(j),t}) < ∞` for every `k`
  have hfin := Submission.dtc_bc_tc_cl_sl_ae_liminf_lt_top MM P
    (fun j => μs (φ j) + μs' (φ j)) f L
    (fun j k t => ((As (φ j) t).boundary - Bs (φ j) t).massOn (ball (0 : Euclid P) ((k : ℝ) + 1)) +
      boundaryMassOn ((As (φ j) t).boundary - Bs (φ j) t) (ball (0 : Euclid P) ((k : ℝ) + 1)))
    hf.continuous
    (fun k => lt_of_le_of_lt (iSup_le fun j =>
      le_iSup (fun i => (μs i + μs' i) (ball (0 : Euclid P) ((k : ℝ) + 1))) (φ j)) (hball _))
    (fun j k t => hZ (φ j) (ball (0 : Euclid P) ((k : ℝ) + 1)) t isOpen_ball)
  -- the level sets `{f = t}` are `ν`- and `ν'`-null for a.e. `t`
  have hν0 := Submission.dtc_bc_tc_cl_sl_ae_level_set_null P ν f hf.continuous.measurable
    fun K hK => hνK K hK (subset_univ K)
  have hν'0 := Submission.dtc_bc_tc_cl_sl_ae_level_set_null P ν' f hf.continuous.measurable
    fun K hK => hν'K K hK (subset_univ K)
  filter_upwards [hIM, hfin, hν0, hν'0] with t hIMt hfint hνt hν't
  intro A B hA hB
  -- (T2): `Z_{φ(j),t} ⇀ ∂A − B`
  have hconvZ := Submission.dtc_bc_tc_cl_sl_slices_weakly_converge T2 P d univ
    (fun j => Xs (φ j)) X (fun j => μs (φ j)) (fun j => ξs (φ j)) (fun j => μs' (φ j))
    (fun j => ξs' (φ j)) μ ξ μ' ξ' ν ν' f t (fun j => As (φ j) t) (fun j => Bs (φ j) t) A B
    isOpen_univ hf.continuous (fun ω => (hconv ω).comp hφ.tendsto_atTop)
    (fun j => hμsK (φ j)) (fun j => hξsm (φ j)) (fun j => ae_of_all _ (hξsb (φ j)))
    (fun j => hXs (φ j)) (fun j => hμs'K (φ j)) (fun j => hξsm' (φ j))
    (fun j => ae_of_all _ (hξsb' (φ j))) (fun j => hbXs (φ j)) (fun K hK _ => hμ K hK) hξm hξ hX
    (fun K hK _ => hμ' K hK) hξm' hξ' hbX hνK hνφ hν'K hν'φ hνt hν't
    (fun j => hAs (φ j) t) (fun j => hBs (φ j) t) hA hB
  -- `CL_P(d)` on balls, glued by (IML): `∂A − B` is integer multiplicity
  exact Submission.dtc_bc_tc_cl_sl_isIntegerMultiplicity_of_liminf_bounds P d CL (IML P d)
    (fun j => (As (φ j) t).boundary - Bs (φ j) t) (A.boundary - B) (fun j => hIMt (φ j))
    hconvZ hfint
/-- A set of finite `H⁰`-measure is countably `0`-rectifiable (Simon Ch. 3, Definition 1.1, case
`n = 0`).  `H⁰ = μH[0]` gives every point mass `1`, so an infinite `M` would contain `k`-point
subsets of measure `k` for every `k ∈ ℕ`; hence `M` is finite.  Each point `x` is the range of the
constant (`0`-Lipschitz) map `ℝ⁰ → ℝᴾ`, and `M = ⋃₀ {{x} : x ∈ M}` is a countable union of such
ranges. -/
theorem Submission.cbrr_rectifiable_dim_zero : ∀ (P : ℕ) (M : Set (Euclid P)), μHE[0] M ≠ ∞ → CountablyRectifiable 0 M := by
  intro P M hM
  -- Step 1: `μHE[0] = μH[0]`, and `μH[0] {x} = 1`
  rw [Measure.euclideanHausdorffMeasure_zero] at hM
  -- Step 2: `M` is finite; otherwise it has `⌈r⌉₊`-point subsets for every `r`, so `μH[0] M = ∞`
  have hfin : M.Finite := by
    by_contra hinf
    refine hM (ENNReal.eq_top_of_forall_nnreal_le fun r => ?_)
    obtain ⟨s, hsM, hs⟩ := Set.Infinite.exists_subset_card_eq hinf ⌈r⌉₊
    calc (r : ℝ≥0∞) ≤ (⌈r⌉₊ : ℝ≥0∞) := by exact_mod_cast Nat.le_ceil r
      _ = ∑ x ∈ s, μH[0] ({x} : Set (Euclid P)) := by
        simp only [Measure.hausdorffMeasure_zero_singleton, Finset.sum_const, nsmul_eq_mul,
          mul_one, hs]
      _ = μH[0] (s : Set (Euclid P)) := sum_measure_singleton
      _ ≤ μH[0] M := measure_mono hsM
  -- Step 3: each `{x}` is the range of the constant `0`-Lipschitz map `ℝ⁰ → ℝᴾ`
  have hpt : ∀ S ∈ (fun x : Euclid P => ({x} : Set (Euclid P))) '' M,
      CountablyRectifiable 0 S := by
    rintro _ ⟨x, -, rfl⟩
    simpa only [range_const] using Poincare.SimonGMT.Chapter03.countablyRectifiable_range (n := 0)
      (LipschitzWith.const (α := Euclid 0) x)
  -- Step 4: `M = ⋃₀ {{x} : x ∈ M}` is a countable union of countably `0`-rectifiable sets
  have h := Poincare.SimonGMT.Chapter03.countablyRectifiable_sUnion (hfin.countable.image _) hpt
  rwa [Set.sUnion_image, Set.biUnion_of_singleton] at h
/-- Lower density bound at a point with an approximate tangent plane (Simon Ch. 3, 1.5(3), and
Ch. 4, 4.10(1)): if `Q` is the approximate tangent space of `M` at `x`, `n ≥ 1` and `c < ωₙ`, then
`c ρⁿ ≤ Hⁿ(M ∩ B̄_ρ(x))` for all small `ρ > 0`.  Choose `ε > 0` with `c (1 + ε)ⁿ < ωₙ` and test
against `ψ(y) = max 0 (min 1 ((1 + ε − |y|)/ε))`, so `1_{B̄₁(0)} ≤ ψ ≤ 1_{B̄_{1+ε}(0)}`.  A linear
isometry `ℝⁿ → ℝᴾ` onto `Q` gives `∫_Q ψ dHⁿ ≥ Hⁿ(Q ∩ B₁(0)) = ωₙ`, while
`∫_{η_{x,r}(M)} ψ dHⁿ ≤ Hⁿ(B̄_{1+ε}(0) ∩ η_{x,r}(M)) = r⁻ⁿ Hⁿ(M ∩ B̄_{(1+ε)r}(x))`; the blow-up
integrals converge to `∫_Q ψ dHⁿ`, and `ρ = (1 + ε) r`. -/
theorem Submission.doragm_approxTangent_lower_density : ∀ (P n : ℕ) (M : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)), 0 < n → HasApproximateTangentSpaceAt n M x Q → ∀ c : ℝ≥0∞, c < unitBallVolume n → ∀ᶠ ρ in 𝓝[>] (0 : ℝ), c * ENNReal.ofReal (ρ ^ n) ≤ μHE[n] (M ∩ closedBall x ρ) := by
  intro P n M x Q _hn hQ c hc
  -- Step 1: `ωₙ < ∞`, so `c < ∞`; choose `ε > 0` with `c (1 + ε)ⁿ < ωₙ`
  have hω_top : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
  have hc_top : c ≠ ∞ := ne_top_of_lt hc
  have hcont : Tendsto (fun ε : ℝ => c * ENNReal.ofReal ((1 + ε) ^ n)) (𝓝 0) (𝓝 c) := by
    have h1 : Tendsto (fun ε : ℝ => (1 + ε) ^ n) (𝓝 0) (𝓝 1) := by
      have hc1 : Continuous fun ε : ℝ => (1 + ε) ^ n := by fun_prop
      simpa using hc1.tendsto 0
    simpa using ENNReal.Tendsto.const_mul (ENNReal.tendsto_ofReal h1) (Or.inr hc_top)
  obtain ⟨ε, hεω, hε⟩ := ((hcont.eventually (gt_mem_nhds hc)).filter_mono nhdsWithin_le_nhds |>.and
    (self_mem_nhdsWithin (s := Ioi (0 : ℝ)) (a := 0))).exists
  set A : ℝ := 1 + ε
  have hA : 0 < A := by linarith
  -- Step 2: the test function `ψ(y) = max 0 (min 1 ((1 + ε − |y|)/ε))`
  have hψcs : HasCompactSupport (fun y : Euclid P => max 0 (min 1 ((A - ‖y‖) / ε))) := by
    refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid P) A) fun y hy => ?_
    rw [mem_closedBall, dist_zero_right, not_le] at hy
    have hneg : (A - ‖y‖) / ε < 0 := div_neg_of_neg_of_pos (by linarith) hε
    rw [min_eq_right (hneg.le.trans zero_le_one), max_eq_left hneg.le]
  let ψ : CompactlySupportedContinuousMap (Euclid P) ℝ :=
    ⟨⟨fun y => max 0 (min 1 ((A - ‖y‖) / ε)), continuous_const.max
      (continuous_const.min ((continuous_const.sub continuous_norm).div_const ε))⟩, hψcs⟩
  have hψ_apply : ∀ y, ψ y = max 0 (min 1 ((A - ‖y‖) / ε)) := fun y => rfl
  have hψ0 : ∀ y, 0 ≤ ψ y := fun y => le_max_left _ _
  have hψle1 : ∀ y, ψ y ≤ 1 := fun y => max_le zero_le_one (min_le_left _ _)
  have hψ1 : ∀ y : Euclid P, ‖y‖ ≤ 1 → ψ y = 1 := by
    intro y hy
    have hge : 1 ≤ (A - ‖y‖) / ε := by rw [le_div_iff₀ hε]; linarith
    rw [hψ_apply, min_eq_left hge, max_eq_right zero_le_one]
  have hψ_out : ∀ y : Euclid P, y ∉ closedBall (0 : Euclid P) A → ψ y = 0 := by
    intro y hy
    rw [mem_closedBall, dist_zero_right, not_le] at hy
    have hneg : (A - ‖y‖) / ε < 0 := div_neg_of_neg_of_pos (by linarith) hε
    rw [hψ_apply, min_eq_right (hneg.le.trans zero_le_one), max_eq_left hneg.le]
  -- Step 3: `Hⁿ(Q ∩ B₁(0)) = ωₙ`, via a linear isometry `ℝⁿ → ℝᴾ` onto `Q`
  have hplane : μHE[n] (ball (0 : Euclid P) 1 ∩ (Q : Set (Euclid P))) = unitBallVolume n := by
    let b : OrthonormalBasis (Fin n) ℝ Q := (stdOrthonormalBasis ℝ Q).reindex (finCongr hQ.1)
    have hj : Isometry (Q.subtypeₗᵢ ∘ b.repr.symm) := Q.subtypeₗᵢ.isometry.comp b.repr.symm.isometry
    have himg : (Q.subtypeₗᵢ ∘ b.repr.symm) '' ball (0 : Euclid n) 1 =
        ball (0 : Euclid P) 1 ∩ (Q : Set (Euclid P)) := by
      ext y
      constructor
      · rintro ⟨v, hv, rfl⟩
        refine ⟨?_, (b.repr.symm v).2⟩
        rw [mem_ball_zero_iff] at hv ⊢
        rwa [Function.comp_apply, LinearIsometry.norm_map, LinearIsometryEquiv.norm_map]
      · rintro ⟨hy, hyQ⟩
        refine ⟨b.repr ⟨y, hyQ⟩, ?_, ?_⟩
        · rw [mem_ball_zero_iff] at hy ⊢
          rwa [LinearIsometryEquiv.norm_map, ← Submodule.norm_coe]
        · simp
    rw [← himg, hj.euclideanHausdorffMeasure_image,
      EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
    rfl
  have hL : (unitBallVolume n).toReal ≤ ∫ y in (Q : Set (Euclid P)), ψ y ∂μHE[n] := by
    have := Poincare.SimonGMT.Chapter03.regular_euclideanHausdorffMeasure_restrict_submodule
      (E := Euclid P) hQ.1
    calc (unitBallVolume n).toReal
        = ∫ y in ball (0 : Euclid P) 1, ψ y ∂((μHE[n] : Measure (Euclid P)).restrict Q) := by
          rw [setIntegral_congr_fun measurableSet_ball
            (fun y hy => hψ1 y (mem_ball_zero_iff.mp hy).le),
            setIntegral_const, smul_eq_mul, mul_one, measureReal_def,
            Measure.restrict_apply measurableSet_ball, hplane]
      _ ≤ ∫ y in (Q : Set (Euclid P)), ψ y ∂μHE[n] :=
          setIntegral_le_integral ψ.integrable (Eventually.of_forall hψ0)
  -- the blow-up integrals `a(r) = ∫_{η_r(M)} ψ dHⁿ` converge to `∫_Q ψ dHⁿ ≥ ωₙ > c (1 + ε)ⁿ`
  have hcA_top : c * ENNReal.ofReal (A ^ n) ≠ ∞ := ne_top_of_lt hεω
  have hcA_lt : (c * ENNReal.ofReal (A ^ n)).toReal < ∫ y in (Q : Set (Euclid P)), ψ y ∂μHE[n] :=
    (ENNReal.toReal_strict_mono hω_top hεω).trans_le hL
  have hev : ∀ᶠ r in 𝓝[>] (0 : ℝ), (c * ENNReal.ofReal (A ^ n)).toReal <
      ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, ψ y ∂μHE[n] :=
    (hQ.2 ψ).eventually (lt_mem_nhds hcA_lt)
  -- Step 4: `ofReal (a(r)) ≤ Hⁿ(B̄_A(0) ∩ η_r(M)) = r⁻ⁿ Hⁿ(M ∩ B̄_{rA}(x))`
  have hscale : ∀ r : ℝ, 0 < r → ∀ T : Set (Euclid P),
      μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' T) =
        ENNReal.ofReal (r⁻¹) ^ n * μHE[n] T := by
    intro r hr T
    have himage : Poincare.SimonGMT.Chapter03.blowUpMap x r '' T =
        AffineMap.homothety (0 : Euclid P) r⁻¹ '' ((fun y : Euclid P => y - x) '' T) := by
      rw [Set.image_image]
      refine Set.image_congr fun y _ => ?_
      change r⁻¹ • (y - x) = _
      rw [AffineMap.homothety_apply, vsub_eq_sub, sub_zero, vadd_eq_add, add_zero]
    have hτ : Isometry (fun y : Euclid P => y - x) := (IsometryEquiv.subRight x).isometry
    rw [himage, euclideanHausdorffMeasure_homothety_image n (0 : Euclid P) (inv_ne_zero hr.ne'),
      hτ.euclideanHausdorffMeasure_image, ENNReal.smul_def,
      smul_eq_mul, ENNReal.coe_pow, ← ENNReal.ofReal_coe_nnreal, coe_nnnorm,
      Real.norm_of_nonneg (inv_pos.mpr hr).le]
  have hball : ∀ r : ℝ, 0 < r → closedBall (0 : Euclid P) A ∩
      Poincare.SimonGMT.Chapter03.blowUpMap x r '' M =
        Poincare.SimonGMT.Chapter03.blowUpMap x r '' (M ∩ closedBall x (r * A)) := by
    intro r hr
    have hmem : ∀ y : Euclid P, Poincare.SimonGMT.Chapter03.blowUpMap x r y ∈
        closedBall (0 : Euclid P) A ↔ y ∈ closedBall x (r * A) := by
      intro y
      change r⁻¹ • (y - x) ∈ closedBall (0 : Euclid P) A ↔ y ∈ closedBall x (r * A)
      rw [mem_closedBall_zero_iff, mem_closedBall, dist_eq_norm, norm_smul,
        Real.norm_of_nonneg (inv_pos.mpr hr).le, ← div_eq_inv_mul, div_le_iff₀ hr, mul_comm A r]
    ext y
    constructor
    · rintro ⟨hyB, z, hzM, rfl⟩
      exact ⟨z, ⟨hzM, (hmem z).mp hyB⟩, rfl⟩
    · rintro ⟨z, ⟨hzM, hzB⟩, rfl⟩
      exact ⟨(hmem z).mpr hzB, z, hzM, rfl⟩
  have hupper : ∀ r : ℝ, 0 < r →
      ENNReal.ofReal (∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, ψ y ∂μHE[n]) ≤
        ENNReal.ofReal (r⁻¹) ^ n * μHE[n] (M ∩ closedBall x (r * A)) := by
    intro r hr
    rw [integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall hψ0)
      ψ.continuous.aestronglyMeasurable]
    refine ENNReal.ofReal_toReal_le.trans ?_
    calc ∫⁻ y, ENNReal.ofReal (ψ y)
          ∂((μHE[n] : Measure (Euclid P)).restrict (Poincare.SimonGMT.Chapter03.blowUpMap x r '' M))
        ≤ ∫⁻ y, (closedBall (0 : Euclid P) A).indicator 1 y
          ∂((μHE[n] : Measure (Euclid P)).restrict
            (Poincare.SimonGMT.Chapter03.blowUpMap x r '' M)) := by
          refine lintegral_mono fun y => ?_
          by_cases hy : y ∈ closedBall (0 : Euclid P) A
          · rw [indicator_of_mem hy, Pi.one_apply]
            exact ENNReal.ofReal_le_one.mpr (hψle1 y)
          · rw [hψ_out y hy, ENNReal.ofReal_zero]
            exact zero_le
      _ = μHE[n] (closedBall (0 : Euclid P) A ∩
            Poincare.SimonGMT.Chapter03.blowUpMap x r '' M) := by
          rw [lintegral_indicator_one measurableSet_closedBall,
            Measure.restrict_apply measurableSet_closedBall]
      _ = ENNReal.ofReal (r⁻¹) ^ n * μHE[n] (M ∩ closedBall x (r * A)) := by
          rw [hball r hr, hscale r hr]
  -- Step 5: `c (rA)ⁿ ≤ Hⁿ(M ∩ B̄_{rA}(x))` for small `r > 0`; reparametrize `ρ = rA`
  have hev2 : ∀ᶠ r in 𝓝[>] (0 : ℝ),
      c * ENNReal.ofReal ((r * A) ^ n) ≤ μHE[n] (M ∩ closedBall x (r * A)) := by
    filter_upwards [hev, self_mem_nhdsWithin] with r hr hr0
    have hr0' : 0 < r := hr0
    have h1 : c * ENNReal.ofReal (A ^ n) ≤
        ENNReal.ofReal (r⁻¹) ^ n * μHE[n] (M ∩ closedBall x (r * A)) := by
      rw [← ENNReal.ofReal_toReal hcA_top]
      exact (ENNReal.ofReal_le_ofReal hr.le).trans (hupper r hr0')
    calc c * ENNReal.ofReal ((r * A) ^ n)
        = c * ENNReal.ofReal (A ^ n) * ENNReal.ofReal r ^ n := by
          rw [mul_pow, ENNReal.ofReal_mul (pow_nonneg hr0'.le n), ENNReal.ofReal_pow hr0'.le,
            mul_comm (ENNReal.ofReal r ^ n), mul_assoc]
      _ ≤ ENNReal.ofReal (r⁻¹) ^ n * μHE[n] (M ∩ closedBall x (r * A)) * ENNReal.ofReal r ^ n := by
          gcongr
      _ = μHE[n] (M ∩ closedBall x (r * A)) := by
          rw [mul_comm (ENNReal.ofReal (r⁻¹) ^ n), mul_assoc, ← mul_pow,
            ← ENNReal.ofReal_mul (inv_nonneg.mpr hr0'.le), inv_mul_cancel₀ hr0'.ne',
            ENNReal.ofReal_one, one_pow, mul_one]
  have htend : Tendsto (fun ρ : ℝ => ρ / A) (𝓝[>] (0 : ℝ)) (𝓝[>] (0 : ℝ)) := by
    refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
    · simpa using ((continuous_id.div_const A).tendsto (0 : ℝ)).mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with ρ hρ
      exact div_pos hρ hA
  filter_upwards [htend.eventually hev2] with ρ hρ
  rwa [div_mul_cancel₀ ρ hA.ne'] at hρ
/-- **`Hⁿ` of a disc in an `n`-plane**: if `Q ⊆ ℝᴾ` is an `n`-dimensional subspace and `r ≥ 0`, then
`Hⁿ(Q ∩ B̄_r(0)) = rⁿ ωₙ`.  An orthonormal basis of `Q` gives a linear isometry `j : ℝⁿ → ℝᴾ`
with `j(B̄_r(0)) = Q ∩ B̄_r(0)`; `Hⁿ` is invariant under isometries and equals Lebesgue measure on
`ℝⁿ`, and `Lⁿ(B̄_r(0)) = rⁿ Lⁿ(B₁(0))`. -/
theorem Submission.cbrr_tcd_plane_closedBall_measure : ∀ (P n : ℕ) (Q : Submodule ℝ (Euclid P)), Module.finrank ℝ Q = n → ∀ r : ℝ, 0 ≤ r → μHE[n] ((Q : Set (Euclid P)) ∩ closedBall 0 r) = ENNReal.ofReal (r ^ n) * unitBallVolume n := by
  intro P n Q hQ r hr
  -- Step 1: an orthonormal basis `b` of `Q` indexed by `Fin n`
  let b : OrthonormalBasis (Fin n) ℝ Q := (stdOrthonormalBasis ℝ Q).reindex (finCongr hQ)
  -- Step 2: the isometry `j = ι ∘ b.repr.symm : ℝⁿ → ℝᴾ`
  have hj : Isometry (Q.subtypeₗᵢ ∘ b.repr.symm) := Q.subtypeₗᵢ.isometry.comp b.repr.symm.isometry
  -- Step 3: `j(B̄_r(0)) = Q ∩ B̄_r(0)`
  have himg : (Q.subtypeₗᵢ ∘ b.repr.symm) '' closedBall (0 : Euclid n) r =
      (Q : Set (Euclid P)) ∩ closedBall 0 r := by
    ext y
    constructor
    · rintro ⟨v, hv, rfl⟩
      refine ⟨(b.repr.symm v).2, ?_⟩
      rw [mem_closedBall_zero_iff] at hv ⊢
      rwa [Function.comp_apply, LinearIsometry.norm_map, LinearIsometryEquiv.norm_map]
    · rintro ⟨hyQ, hy⟩
      refine ⟨b.repr ⟨y, hyQ⟩, ?_, ?_⟩
      · rw [mem_closedBall_zero_iff] at hy ⊢
        rwa [LinearIsometryEquiv.norm_map, ← Submodule.norm_coe]
      · simp
  -- Steps 4–7: isometry invariance, `Hⁿ = Lⁿ` on `ℝⁿ`, Haar scaling, and `ωₙ = Lⁿ(B₁(0))`
  rw [← himg, hj.euclideanHausdorffMeasure_image,
    EuclideanSpace.euclideanHausdorffMeasure_eq_volume, Measure.addHaar_closedBall _ _ hr,
    finrank_euclideanSpace_fin]
  rfl
/-- **Cutoff for the cone `X = {y : 2|p_Q y| < |y|}`**: for a subspace `Q ⊆ ℝᴾ` and `δ > 0` there
is `f ∈ C_c(ℝᴾ)` with `0 ≤ f ≤ 1`, `f = 1` on `X ∩ B₁(0)` and `f = 0` on `Q \ B̄_δ(0)`.  With
`s = δ/4` take `f = φχ`, `φ(y) = max(0, min(1, 1 + ((3/4)|y| − |p_Q y|)/s))` and
`χ(y) = max(0, min(1, 2 − |y|))`; `f` vanishes outside `B̄₂(0)`. -/
theorem Submission.cbrr_tcd_cone_cutoff_exists : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (δ : ℝ), 0 < δ → ∃ f : CompactlySupportedContinuousMap (Euclid P) ℝ, (∀ y, 0 ≤ f y) ∧ (∀ y, f y ≤ 1) ∧ (∀ y : Euclid P, 2 * ‖Q.starProjection y‖ < ‖y‖ → ‖y‖ < 1 → f y = 1) ∧ ∀ y ∈ Q, δ < ‖y‖ → f y = 0 := by
  intro P Q δ hδ
  -- Step 1: `s = δ/4`, `h(y) = (3/4)|y| − |p_Q y|`, `φ = max(0, min(1, 1 + h/s))`,
  -- `χ = max(0, min(1, 2 − |y|))`.
  set s : ℝ := δ / 4 with hs_def
  have hs : 0 < s := by positivity
  let φ : Euclid P → ℝ := fun y => max 0 (min 1 (1 + (3 / 4 * ‖y‖ - ‖Q.starProjection y‖) / s))
  let χ : Euclid P → ℝ := fun y => max 0 (min 1 (2 - ‖y‖))
  -- Step 2: `φ` and `χ` are continuous (`p_Q` is a continuous linear map).
  have hφ : Continuous φ :=
    continuous_const.max (continuous_const.min (continuous_const.add
      (((continuous_const.mul continuous_norm).sub Q.starProjection.continuous.norm).div_const s)))
  have hχ : Continuous χ :=
    continuous_const.max (continuous_const.min (continuous_const.sub continuous_norm))
  -- Step 3: `χ`, hence `φχ`, vanishes outside the compact ball `B̄₂(0)`.
  have hsupp : HasCompactSupport fun y => φ y * χ y := by
    refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid P) 2) fun y hy => ?_
    rw [mem_closedBall_zero_iff, not_le] at hy
    have hχy : χ y = 0 := by
      simp only [χ]
      rw [min_eq_right (by linarith), max_eq_left (by linarith)]
    simp [hχy]
  let f : CompactlySupportedContinuousMap (Euclid P) ℝ :=
    { toFun := fun y => φ y * χ y
      continuous_toFun := hφ.mul hχ
      hasCompactSupport' := hsupp }
  have hf : ∀ y, f y = φ y * χ y := fun _ => rfl
  -- Step 4: `max(0, min(1, a)) ∈ [0, 1]`, so `0 ≤ φ, χ ≤ 1` and `0 ≤ φχ ≤ φ ≤ 1`.
  have hclamp : ∀ a : ℝ, 0 ≤ max 0 (min 1 a) ∧ max 0 (min 1 a) ≤ 1 := fun a =>
    ⟨le_max_left _ _, max_le zero_le_one (min_le_left _ _)⟩
  refine ⟨f, fun y => ?_, fun y => ?_, fun y hX hB => ?_, fun y hyQ hyδ => ?_⟩
  · rw [hf]
    exact mul_nonneg (hclamp _).1 (hclamp _).1
  · rw [hf]
    calc φ y * χ y ≤ φ y * 1 := mul_le_mul_of_nonneg_left (hclamp _).2 (hclamp _).1
      _ = φ y := mul_one _
      _ ≤ 1 := (hclamp _).2
  -- Step 5: if `2|p_Q y| < |y| < 1` then `h(y) > |y|/4 ≥ 0`, so `φ(y) = 1`; and `χ(y) = 1`.
  · have hh : 0 ≤ (3 / 4 * ‖y‖ - ‖Q.starProjection y‖) / s :=
      div_nonneg (by linarith [norm_nonneg y]) hs.le
    have hφy : φ y = 1 := by
      simp only [φ]
      rw [min_eq_left (by linarith), max_eq_right zero_le_one]
    have hχy : χ y = 1 := by
      simp only [χ]
      rw [min_eq_left (by linarith), max_eq_right zero_le_one]
    rw [hf, hφy, hχy, one_mul]
  -- Step 6: if `y ∈ Q` and `|y| > δ` then `p_Q y = y`, so `1 + h(y)/s = 1 − |y|/δ < 0` and
  -- `φ(y) = 0`.
  · have hp : Q.starProjection y = y := Submodule.starProjection_eq_self_iff.mpr hyQ
    have hneg : 1 + (3 / 4 * ‖y‖ - ‖y‖) / s < 0 := by
      have h1 : (3 / 4 * ‖y‖ - ‖y‖) / s = -(‖y‖ / δ) := by
        rw [hs_def]
        field_simp
        ring
      have h2 : 1 < ‖y‖ / δ := (one_lt_div hδ).mpr hyδ
      linarith
    have hφy : φ y = 0 := by
      simp only [φ]
      rw [hp, min_eq_right (by linarith), max_eq_left hneg.le]
    rw [hf, hφy, zero_mul]
/-- **`Hⁿ` under the blow-up map `η_{x,r}(y) = r⁻¹(y − x)`, `r > 0`**: `Hⁿ(η_{x,r}(S)) = r⁻ⁿ Hⁿ(S)`
for every `S ⊆ ℝᴾ`, the scaling used in the proof of Simon Ch. 3, Theorem 1.6 "⇒".  `η_{x,r}` is
the translation `y ↦ y + (−x)`, an isometry, followed by the dilation `z ↦ r⁻¹z`, and
`Hⁿ(cT) = |c|ⁿ Hⁿ(T)` for `c ≠ 0`. -/
theorem Submission.rsd_cmr_ir_blowUp_image_measure : ∀ (P n : ℕ) (x : Euclid P) (r : ℝ) (S : Set (Euclid P)), 0 < r → μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' S) = ENNReal.ofReal (r⁻¹ ^ n) * μHE[n] S := by
  intro P n x r S hr
  -- `η_{x,r}(S) = r⁻¹ • (S + (−x))`: `η_{x,r}(y) = r⁻¹ • (y − x)` and `y − x = y + (−x)`.
  have hS : Poincare.SimonGMT.Chapter03.blowUpMap x r '' S =
      (fun z => r⁻¹ • z) '' ((fun y => y + -x) '' S) := by
    rw [Set.image_image]
    rfl
  -- `Hⁿ(r⁻¹ • T) = ‖r⁻¹‖₊ⁿ • Hⁿ(T)`, translation invariance, and `‖r⁻¹‖₊ⁿ = r⁻¹ ^ n` for `r > 0`.
  rw [hS, Set.image_smul, Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hr.ne'),
    (isometry_add_right (-x)).euclideanHausdorffMeasure_image, ENNReal.smul_def, smul_eq_mul,
    ← ENNReal.ofReal_coe_nnreal]
  congr 2
  simp [abs_of_pos hr]

/-- **Small-scale upper bound at an approximate tangent point**: if `Q` is the approximate tangent
space of `M` at `x` (Simon Ch. 3, 1.4), `Hⁿ(M) < ∞`, and `f ∈ C_c(ℝᴾ)` satisfies `f ≥ 0` and
`f ≥ 1` on the measurable set `U`, then `Hⁿ(M ∩ η_{x,r}⁻¹(U)) ≤ t rⁿ` for all small `r > 0`
whenever `∫_Q f dHⁿ < t`.  Indeed `Hⁿ(η_{x,r}(M) ∩ U) ≤ ∫_{η_{x,r}(M)} f dHⁿ → ∫_Q f dHⁿ`, and
`η_{x,r}(M) ∩ U = η_{x,r}(M ∩ η_{x,r}⁻¹(U))` has measure `r⁻ⁿ Hⁿ(M ∩ η_{x,r}⁻¹(U))`. -/
theorem Submission.cbrr_tcd_blowUp_preimage_le_of_testFunction : ∀ (P n : ℕ) (M : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)) (U : Set (Euclid P)) (f : CompactlySupportedContinuousMap (Euclid P) ℝ), μHE[n] M ≠ ∞ → HasApproximateTangentSpaceAt n M x Q → MeasurableSet U → (∀ y, 0 ≤ f y) → (∀ y ∈ U, 1 ≤ f y) → ∀ t : ℝ≥0∞, ENNReal.ofReal (∫ y in (Q : Set (Euclid P)), f y ∂μHE[n]) < t → ∀ᶠ r in 𝓝[>] (0 : ℝ), μHE[n] (M ∩ Poincare.SimonGMT.Chapter03.blowUpMap x r ⁻¹' U) ≤ t * ENNReal.ofReal (r ^ n) := by
  intro P n M x Q U f hM hT hU hf0 hfU t ht
  -- `t = ∞`: the right-hand side is `∞` for every `r > 0`.
  rcases eq_or_ne t ∞ with rfl | htop
  · filter_upwards [self_mem_nhdsWithin] with r hr
    rw [ENNReal.top_mul (ENNReal.ofReal_pos.2 (pow_pos hr n)).ne']
    exact le_top
  -- `∫_Q f dHⁿ < t`, and `∫_{η_{x,r}(M)} f dHⁿ → ∫_Q f dHⁿ`, so eventually `∫_{η_{x,r}(M)} f < t`.
  have hL : ∫ y in (Q : Set (Euclid P)), f y ∂μHE[n] < t.toReal :=
    (ENNReal.ofReal_lt_iff_lt_toReal (integral_nonneg hf0) htop).1 ht
  filter_upwards [self_mem_nhdsWithin, (hT.2 f).eventually (gt_mem_nhds hL)] with r hr hI
  have hr0 : (0 : ℝ) < r := hr
  set η := Poincare.SimonGMT.Chapter03.blowUpMap x r
  -- `Hⁿ(η_{x,r}(M)) = r⁻ⁿ Hⁿ(M) < ∞`, so `f` is integrable for `Hⁿ⌞η_{x,r}(M)`.
  have hfin : μHE[n] (η '' M) ≠ ∞ := by
    rw [Submission.rsd_cmr_ir_blowUp_image_measure P n x r M hr0]
    exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top hM
  have : IsFiniteMeasure (μHE[n].restrict (η '' M)) := isFiniteMeasure_restrict.2 hfin
  have hint : Integrable f (μHE[n].restrict (η '' M)) := f.integrable
  -- `Hⁿ(η_{x,r}(M) ∩ U) = ∫ 1_U d(Hⁿ⌞η_{x,r}(M)) ≤ ∫_{η_{x,r}(M)} f dHⁿ ≤ t`.
  have hle : μHE[n] (η '' M ∩ U) ≤ t := by
    calc μHE[n] (η '' M ∩ U) = μHE[n].restrict (η '' M) U := by
          rw [Measure.restrict_apply hU, Set.inter_comm]
      _ = ∫⁻ y, U.indicator 1 y ∂(μHE[n].restrict (η '' M)) := (lintegral_indicator_one hU).symm
      _ ≤ ∫⁻ y, ENNReal.ofReal (f y) ∂(μHE[n].restrict (η '' M)) := by
          refine lintegral_mono fun y => ?_
          by_cases hy : y ∈ U
          · rw [Set.indicator_of_mem hy, Pi.one_apply]
            exact ENNReal.one_le_ofReal.2 (hfU y hy)
          · rw [Set.indicator_of_notMem hy]
            exact zero_le
      _ = ENNReal.ofReal (∫ y in η '' M, f y ∂μHE[n]) :=
          (ofReal_integral_eq_lintegral_ofReal hint (Eventually.of_forall hf0)).symm
      _ ≤ ENNReal.ofReal t.toReal := ENNReal.ofReal_le_ofReal hI.le
      _ = t := ENNReal.ofReal_toReal htop
  -- `η_{x,r}(M) ∩ U = η_{x,r}(M ∩ η_{x,r}⁻¹(U))`, whose measure is `r⁻ⁿ Hⁿ(M ∩ η_{x,r}⁻¹(U))`.
  have hscale : μHE[n] (η '' M ∩ U) = ENNReal.ofReal (r⁻¹ ^ n) * μHE[n] (M ∩ η ⁻¹' U) := by
    rw [← Set.image_inter_preimage]
    exact Submission.rsd_cmr_ir_blowUp_image_measure P n x r _ hr0
  have hcancel : ENNReal.ofReal (r ^ n) * ENNReal.ofReal (r⁻¹ ^ n) = 1 := by
    rw [← ENNReal.ofReal_mul (pow_nonneg hr0.le n), ← mul_pow, mul_inv_cancel₀ hr0.ne', one_pow,
      ENNReal.ofReal_one]
  calc μHE[n] (M ∩ η ⁻¹' U)
      = ENNReal.ofReal (r ^ n) * (ENNReal.ofReal (r⁻¹ ^ n) * μHE[n] (M ∩ η ⁻¹' U)) := by
        rw [← mul_assoc, hcancel, one_mul]
    _ ≤ ENNReal.ofReal (r ^ n) * t := by
        rw [← hscale]
        gcongr
    _ = t * ENNReal.ofReal (r ^ n) := mul_comm _ _

/-- **Vanishing density in the cone about the normal space** (Simon Ch. 3, Remark 1.5(3), second
half, and formula (6) in the proof of Theorem 1.6): if `Q` is the approximate tangent space of `M`
at `x`, `n ≥ 1` and `Hⁿ(M) < ∞`, then for every `t > 0`, `Hⁿ(M ∩ X(x) ∩ B_ρ(x)) ≤ t ρⁿ` for all
small `ρ > 0`, where `X(x) = {z : 2|p_Q(z − x)| < |z − x|} = X_{1/2}((TₓM)^⊥, x)`.  Choose `δ > 0`
with `Hⁿ(Q ∩ B̄_δ(0)) = δⁿωₙ < t` and `f ∈ C_c` with `0 ≤ f ≤ 1`, `f = 1` on `X ∩ B₁(0)` and
`f = 0` on `Q \ B̄_δ(0)`.  Then `∫_Q f dHⁿ ≤ Hⁿ(Q ∩ B̄_δ(0)) < t`, so the blow-up bound gives
`Hⁿ(M ∩ η_{x,r}⁻¹(X ∩ B₁(0))) ≤ t rⁿ` for small `r > 0`, and `η_{x,r}⁻¹(X ∩ B₁(0)) = X(x) ∩ B_r(x)`. -/
theorem Submission.cbrr_tangent_cone_density_zero : ∀ (P n : ℕ) (M : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)), 0 < n → μHE[n] M ≠ ∞ → HasApproximateTangentSpaceAt n M x Q → ∀ t : ℝ≥0∞, 0 < t → ∀ᶠ ρ in 𝓝[>] (0 : ℝ), μHE[n] (M ∩ ({z | 2 * ‖Q.starProjection (z - x)‖ < ‖z - x‖} ∩ ball x ρ)) ≤ t * ENNReal.ofReal (ρ ^ n) := by
  intro P n M x Q hn hM hQ t ht
  -- Step 1: `ωₙ < ∞` and `n ≥ 1`, so `δⁿωₙ → 0` as `δ → 0`; choose `δ > 0` with `δⁿωₙ < t`, so
  -- that `Hⁿ(Q ∩ B̄_δ(0)) = δⁿωₙ < t` (`dim Q = n`)
  have hω_top : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
  have hlim : Tendsto (fun δ : ℝ => ENNReal.ofReal (δ ^ n) * unitBallVolume n) (𝓝 0) (𝓝 0) := by
    have h0 : Tendsto (fun δ : ℝ => δ ^ n) (𝓝 0) (𝓝 0) := by
      have h := (continuous_pow n).tendsto (0 : ℝ)
      rwa [zero_pow hn.ne'] at h
    have h := ENNReal.Tendsto.mul_const (ENNReal.tendsto_ofReal h0) (Or.inr hω_top)
    rwa [ENNReal.ofReal_zero, zero_mul] at h
  obtain ⟨δ, hδt, hδ⟩ := ((hlim.eventually (gt_mem_nhds ht)).filter_mono nhdsWithin_le_nhds |>.and
    (self_mem_nhdsWithin (s := Ioi (0 : ℝ)) (a := 0))).exists
  have hδ0 : 0 < δ := hδ
  have hplane : μHE[n] ((Q : Set (Euclid P)) ∩ closedBall 0 δ) < t := by
    rw [Submission.cbrr_tcd_plane_closedBall_measure P n Q hQ.1 δ hδ0.le]
    exact hδt
  -- Step 2: the cutoff `f ∈ C_c`: `0 ≤ f ≤ 1`, `f = 1` on `X ∩ B₁(0)`, `f = 0` on `Q \ B̄_δ(0)`
  obtain ⟨f, hf0, hf1, hfX, hfQ⟩ := Submission.cbrr_tcd_cone_cutoff_exists P Q δ hδ0
  -- Step 3: `ofReal (∫_Q f dHⁿ) ≤ ∫⁻_Q ofReal ∘ f dHⁿ ≤ Hⁿ(Q ∩ B̄_δ(0)) < t`, as
  -- `ofReal ∘ f ≤ 1_{B̄_δ(0)}` on `Q`
  have hQm : MeasurableSet (Q : Set (Euclid P)) := Q.closed_of_finiteDimensional.measurableSet
  have hint : ENNReal.ofReal (∫ y in (Q : Set (Euclid P)), f y ∂μHE[n]) < t := by
    refine lt_of_le_of_lt ?_ hplane
    rw [integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall hf0)
      f.continuous.aestronglyMeasurable]
    refine ENNReal.ofReal_toReal_le.trans ?_
    calc ∫⁻ y in (Q : Set (Euclid P)), ENNReal.ofReal (f y) ∂μHE[n]
        ≤ ∫⁻ y in (Q : Set (Euclid P)), (closedBall (0 : Euclid P) δ).indicator 1 y ∂μHE[n] := by
          refine setLIntegral_mono' hQm fun y hy => ?_
          by_cases hyδ : y ∈ closedBall (0 : Euclid P) δ
          · rw [indicator_of_mem hyδ, Pi.one_apply]
            exact ENNReal.ofReal_le_one.mpr (hf1 y)
          · rw [mem_closedBall_zero_iff, not_le] at hyδ
            rw [hfQ y hy hyδ, ENNReal.ofReal_zero]
            exact zero_le
      _ = μHE[n] ((Q : Set (Euclid P)) ∩ closedBall 0 δ) := by
          rw [lintegral_indicator_one measurableSet_closedBall,
            Measure.restrict_apply measurableSet_closedBall, inter_comm]
  -- Step 4: the blow-up bound for the open set `U = X ∩ B₁(0)`, on which `f = 1`
  set U : Set (Euclid P) := {y | 2 * ‖Q.starProjection y‖ < ‖y‖} ∩ ball 0 1
  have hU : IsOpen U :=
    (isOpen_lt (continuous_const.mul Q.starProjection.continuous.norm) continuous_norm).inter
      isOpen_ball
  have hfU : ∀ y ∈ U, 1 ≤ f y := fun y hy => (hfX y hy.1 (mem_ball_zero_iff.mp hy.2)).ge
  filter_upwards [Submission.cbrr_tcd_blowUp_preimage_le_of_testFunction P n M x Q U f hM hQ
    hU.measurableSet hf0 hfU t hint, self_mem_nhdsWithin] with r hr hr0
  -- Step 5: for `r > 0`, `η_{x,r}⁻¹(X ∩ B₁(0)) = X(x) ∩ B_r(x)`, since `η_{x,r}(z) = r⁻¹(z − x)`,
  -- `p_Q` is linear and `|r⁻¹v| = r⁻¹|v|`
  have hr0' : 0 < r := hr0
  have hrinv : 0 < r⁻¹ := inv_pos.mpr hr0'
  have hset : {z | 2 * ‖Q.starProjection (z - x)‖ < ‖z - x‖} ∩ ball x r =
      Poincare.SimonGMT.Chapter03.blowUpMap x r ⁻¹' U := by
    ext z
    have hnorm : ‖r⁻¹ • (z - x)‖ = r⁻¹ * ‖z - x‖ := by
      rw [norm_smul, Real.norm_of_nonneg hrinv.le]
    have hproj : ‖Q.starProjection (r⁻¹ • (z - x))‖ = r⁻¹ * ‖Q.starProjection (z - x)‖ := by
      rw [map_smul, norm_smul, Real.norm_of_nonneg hrinv.le]
    change 2 * ‖Q.starProjection (z - x)‖ < ‖z - x‖ ∧ dist z x < r ↔
      2 * ‖Q.starProjection (r⁻¹ • (z - x))‖ < ‖r⁻¹ • (z - x)‖ ∧ dist (r⁻¹ • (z - x)) 0 < 1
    rw [dist_eq_norm, dist_eq_norm, sub_zero, hproj, hnorm, mul_left_comm,
      mul_lt_mul_iff_right₀ hrinv, inv_mul_lt_iff₀ hr0', mul_one]
  rw [hset]
  exact hr

/-- **Lusin's theorem for an a.e. strongly measurable map, keeping an a.e. property** (the closed
set `F` of Simon Ch. 3, proof of Theorem 1.6 "⇐", (4)): if `A` is measurable with `μ(A) < ∞`,
`f : ℝᴾ → Y` is `μ⌞A`-a.e. strongly measurable into a pseudo-metrizable, second-countable `Y` and
`p` holds `μ⌞A`-a.e., then for every `η ≠ 0` there is a compact `K ⊆ A` with `μ(A \ K) < η` on
which `p` holds and `f` is continuous.  With the Borel σ-algebra on `Y`, the strongly measurable
representative `g` of `f` is measurable.  The bad set `Z = {f ≠ g} ∪ {¬p}` has
`μ(Z ∩ A) = μ⌞A(Z) = 0`, so a measurable `μ`-null `N ⊇ Z ∩ A` leaves `A \ N`, on which `f = g`
and `p` hold.  Lusin's theorem for `g` on `A \ N` gives `K`, and `A \ K ⊆ N ∪ ((A \ N) \ K)`. -/
theorem Submission.cbrr_ud_lusin_of_aestronglyMeasurable : ∀ (P : ℕ) {Y : Type} [TopologicalSpace Y] [TopologicalSpace.PseudoMetrizableSpace Y] [SecondCountableTopology Y] (μ : Measure (Euclid P)) (A : Set (Euclid P)) (f : Euclid P → Y) (p : Euclid P → Prop), MeasurableSet A → μ A ≠ ∞ → AEStronglyMeasurable f (μ.restrict A) → (∀ᵐ x ∂(μ.restrict A), p x) → ∀ η : ℝ≥0∞, η ≠ 0 → ∃ K : Set (Euclid P), IsCompact K ∧ K ⊆ A ∧ μ (A \ K) < η ∧ (∀ x ∈ K, p x) ∧ ContinuousOn f K := by
  intro P Y _ _ _ μ A f p hA hμA hf hp η hη
  -- Step 1: give `Y` its Borel σ-algebra; the strongly measurable representative `g = hf.mk f`
  -- of `f` is then measurable, and `f = g` `μ⌞A`-a.e.
  borelize Y
  have hg : Measurable (hf.mk f) := hf.measurable_mk
  -- Step 2: the bad set `Z = {f ≠ g} ∪ {¬p}` has `μ (Z ∩ A) = μ⌞A Z = 0`; a measurable `μ`-null
  -- `N ⊇ Z ∩ A` leaves the measurable `A \ N`, on which `f = g` and `p` hold
  have hZ : μ ({x | ¬(f x = hf.mk f x ∧ p x)} ∩ A) = 0 := by
    rw [← Measure.restrict_apply' hA]
    exact ae_iff.mp (hf.ae_eq_mk.and hp)
  obtain ⟨N, hZN, hN, hN0⟩ := exists_measurable_superset_of_null hZ
  have hgood : ∀ x ∈ A \ N, f x = hf.mk f x ∧ p x := fun x hx =>
    not_not.mp fun h => hx.2 (hZN ⟨h, hx.1⟩)
  -- Step 3: Lusin's theorem for `g` on `A \ N`: a compact `K ⊆ A \ N` with `μ ((A \ N) \ K) < η`
  -- on which `g` is continuous
  obtain ⟨K, hK, hKA, hKμ, hgK⟩ := Submission.dor_ims_lusin_measurable_continuousOn P μ (A \ N)
    (hf.mk f) η hg (hA.diff hN) (measure_ne_top_of_subset sdiff_subset hμA) hη
  -- Step 4: `f = g` and `p` hold on `K ⊆ A \ N`, and `A \ K ⊆ N ∪ (A \ N) \ K` with `μ N = 0`
  refine ⟨K, hK, hKA.trans sdiff_subset, ?_, fun x hx => (hgood x (hKA hx)).2,
    hgK.congr fun x hx => (hgood x (hKA hx)).1⟩
  calc μ (A \ K)
      ≤ μ (N ∪ (A \ N) \ K) := by
        refine measure_mono fun x hx => ?_
        by_cases hxN : x ∈ N
        · exact Or.inl hxN
        · exact Or.inr ⟨⟨hx.1, hxN⟩, hx.2⟩
    _ ≤ μ N + μ ((A \ N) \ K) := measure_union_le _ _
    _ = μ ((A \ N) \ K) := by rw [hN0, zero_add]
    _ < η := hKμ
/-- **Upper semicontinuity of closed-ball mass** (for Egoroff's theorem in Simon Ch. 3, proof of
Theorem 1.6, (7)–(8)): for a finite measure `μ` on `ℝᴾ`, `ρ ∈ ℝ` and `s ∈ [0, ∞]`, the set
`{y : s ≤ μ(B̄_ρ(y))}` is closed.  If `yᵢ → y` and `s ≤ μ(B̄_ρ(yᵢ))` for all `i`, the open
complements `U = B̄_ρ(y)ᶜ` and `Uᵢ = B̄_ρ(yᵢ)ᶜ` satisfy `1_U ≤ liminf 1_{Uᵢ}`, so Fatou's lemma
gives `μ(U) ≤ liminf μ(Uᵢ) ≤ μ(ℝᴾ) − s`; as `μ` is finite and `s ≤ μ(ℝᴾ)`,
`μ(B̄_ρ(y)) = μ(ℝᴾ) − μ(U) ≥ s`. -/
theorem Submission.cbrr_ud_isClosed_closedBall_mass_ge : ∀ (P : ℕ) (μ : Measure (Euclid P)) [IsFiniteMeasure μ] (ρ : ℝ) (s : ℝ≥0∞), IsClosed {y : Euclid P | s ≤ μ (closedBall y ρ)} := by
  intro P μ _ ρ s
  -- Step 1: `ℝᴾ` is a sequential space; let `yᵢ → y` with `s ≤ μ(B̄_ρ(yᵢ))` for all `i`
  refine IsSeqClosed.isClosed fun ys y hys hlim => ?_
  replace hys : ∀ i, s ≤ μ (closedBall (ys i) ρ) := hys
  show s ≤ μ (closedBall y ρ)
  -- Step 2: the complements `U = B̄_ρ(y)ᶜ` and `Uᵢ = B̄_ρ(yᵢ)ᶜ` are open, hence Borel
  have hU : ∀ x : Euclid P, MeasurableSet (closedBall x ρ)ᶜ :=
    fun x => measurableSet_closedBall.compl
  -- Step 3: `1_U ≤ liminf 1_{Uᵢ}`: if `|z − y| > ρ`, then `|z − yᵢ| > ρ` for all large `i`
  have hpt : ∀ z, (closedBall y ρ)ᶜ.indicator 1 z ≤
      liminf (fun i => (closedBall (ys i) ρ)ᶜ.indicator (1 : Euclid P → ℝ≥0∞) z) atTop := by
    intro z
    by_cases hz : z ∈ closedBall y ρ
    · rw [indicator_of_notMem (not_not.mpr hz)]
      exact zero_le
    · rw [mem_closedBall, not_le] at hz
      refine le_liminf_of_le (by isBoundedDefault) ?_
      filter_upwards [(tendsto_const_nhds.dist hlim).eventually (lt_mem_nhds hz)] with i hi
      rw [indicator_of_mem (not_le.mpr hz), indicator_of_mem (not_le.mpr hi)]
  -- Step 4: Fatou's lemma gives `μ(U) ≤ liminf μ(Uᵢ)`
  have hfatou : μ (closedBall y ρ)ᶜ ≤ liminf (fun i => μ (closedBall (ys i) ρ)ᶜ) atTop :=
    calc μ (closedBall y ρ)ᶜ = ∫⁻ z, (closedBall y ρ)ᶜ.indicator 1 z ∂μ :=
          (lintegral_indicator_one (hU y)).symm
      _ ≤ ∫⁻ z, liminf (fun i => (closedBall (ys i) ρ)ᶜ.indicator 1 z) atTop ∂μ :=
          lintegral_mono hpt
      _ ≤ liminf (fun i => ∫⁻ z, (closedBall (ys i) ρ)ᶜ.indicator 1 z ∂μ) atTop :=
          lintegral_liminf_le fun i => measurable_one.indicator (hU (ys i))
      _ = liminf (fun i => μ (closedBall (ys i) ρ)ᶜ) atTop := by
          simp_rw [lintegral_indicator_one (hU _)]
  -- Step 5: `μ(Uᵢ) = μ(ℝᴾ) − μ(B̄_ρ(yᵢ)) ≤ μ(ℝᴾ) − s` for every `i`, so `μ(U) ≤ μ(ℝᴾ) − s`
  have hUle : μ (closedBall y ρ)ᶜ ≤ μ univ - s := by
    refine hfatou.trans (liminf_le_of_frequently_le' (Frequently.of_forall fun i => ?_))
    rw [measure_compl measurableSet_closedBall (measure_ne_top _ _)]
    exact tsub_le_tsub_left (hys i) _
  -- Step 6: `s ≤ μ(B̄_ρ(y₀)) ≤ μ(ℝᴾ) < ∞`, so
  -- `μ(B̄_ρ(y)) = μ(ℝᴾ) − μ(U) ≥ μ(ℝᴾ) − (μ(ℝᴾ) − s) = s`
  have hs : s ≤ μ univ := (hys 0).trans (measure_mono (subset_univ _))
  calc s = μ univ - (μ univ - s) := (ENNReal.sub_sub_cancel (measure_ne_top _ _) hs).symm
    _ ≤ μ univ - μ (closedBall y ρ)ᶜ := tsub_le_tsub_left hUle _
    _ = μ (closedBall y ρ) := by
        rw [← measure_compl (hU y) (measure_ne_top _ _), compl_compl]
/-- **Closed cone-mass sublevel sets** (Simon Ch. 3, proof of Theorem 1.6 "⇐", (7)–(8); this
closedness replaces the measurability of the functions `q_k` there).  Let `F` be closed and
`w ↦ p_{Q(w)}` continuous on `F`, and put `S(w) = X(w) ∩ B_ρ(w)`, where
`X(w) = {z : 2|p_{Q(w)}(z − w)| < |z − w|}`.  Then `{x ∈ F : μ(S(x)) ≤ s}` is closed.  Let
`xᵢ → x` in this set; then `x ∈ F`.  Each `S(w)` is open.  As `p_{Q(xᵢ)} → p_{Q(x)}`, every
`z ∈ S(x)` lies in `S(xᵢ)` for all large `i`, so `1_{S(x)} ≤ liminf 1_{S(xᵢ)}`.  Fatou's lemma
gives `μ(S(x)) ≤ liminf μ(S(xᵢ)) ≤ s`. -/
theorem Submission.cbrr_ud_isClosed_cone_mass_le : ∀ (P : ℕ) (μ : Measure (Euclid P)) (F : Set (Euclid P)) (Q : Euclid P → Submodule ℝ (Euclid P)) (ρ : ℝ) (s : ℝ≥0∞), IsClosed F → ContinuousOn (fun x => (Q x).starProjection) F → IsClosed {x | x ∈ F ∧ μ ({z | 2 * ‖(Q x).starProjection (z - x)‖ < ‖z - x‖} ∩ ball x ρ) ≤ s} := by
  intro P μ F Q ρ s hF hQ
  -- Step 1: sequential closedness; the limit `x` of the `xᵢ ∈ F` lies in the closed set `F`
  refine IsSeqClosed.isClosed fun xs x hxs hx => ?_
  have hxsF : ∀ i, xs i ∈ F := fun i => (hxs i).1
  have hxF : x ∈ F := hF.mem_of_tendsto hx (Eventually.of_forall hxsF)
  refine ⟨hxF, ?_⟩
  set S : Euclid P → Set (Euclid P) := fun w =>
    {z | 2 * ‖(Q w).starProjection (z - w)‖ < ‖z - w‖} ∩ ball w ρ
  change μ (S x) ≤ s
  -- Step 2: every `S(w) = X(w) ∩ B_ρ(w)` is open, hence measurable
  have hSm : ∀ w, MeasurableSet (S w) := fun w =>
    ((isOpen_lt (continuous_const.mul ((Q w).starProjection.continuous.comp
      (continuous_id.sub continuous_const)).norm) (continuous_id.sub continuous_const).norm).inter
      isOpen_ball).measurableSet
  -- Step 3: `xᵢ → x` within `F`, where `w ↦ p_{Q(w)}` is continuous
  have hxW : Tendsto xs atTop (𝓝[F] x) :=
    tendsto_nhdsWithin_iff.mpr ⟨hx, Eventually.of_forall hxsF⟩
  -- Step 4: `2|p_{Q(xᵢ)}(z − xᵢ)| − |z − xᵢ| → 2|p_{Q(x)}(z − x)| − |z − x| < 0` and
  -- `|z − xᵢ| → |z − x| < ρ`, so every `z ∈ S(x)` lies in `S(xᵢ)` for all large `i`
  have hev : ∀ z ∈ S x, ∀ᶠ i in atTop, z ∈ S (xs i) := by
    intro z hz
    have hcont : ContinuousWithinAt
        (fun w => 2 * ‖(Q w).starProjection (z - w)‖ - ‖z - w‖) F x :=
      (continuousWithinAt_const.mul ((hQ x hxF).clm_apply
        (continuousWithinAt_const.sub continuousWithinAt_id)).norm).sub
        (continuousWithinAt_const.sub continuousWithinAt_id).norm
    have h1 := (hcont.tendsto.comp hxW).eventually (gt_mem_nhds (sub_neg.mpr hz.1))
    have h2 := (tendsto_const_nhds.dist hx).eventually (gt_mem_nhds (mem_ball.mp hz.2))
    filter_upwards [h1, h2] with i hi1 hi2
    exact ⟨sub_neg.mp hi1, hi2⟩
  -- Step 5: `1_{S(x)} ≤ liminf 1_{S(xᵢ)}` pointwise, and Fatou's lemma
  calc μ (S x) = ∫⁻ z, (S x).indicator 1 z ∂μ := (lintegral_indicator_one (hSm x)).symm
    _ ≤ ∫⁻ z, liminf (fun i => (S (xs i)).indicator 1 z) atTop ∂μ := by
        refine lintegral_mono fun z => ?_
        by_cases hz : z ∈ S x
        · rw [indicator_of_mem hz]
          refine le_liminf_of_le (by isBoundedDefault) ?_
          filter_upwards [hev z hz] with i hi
          rw [indicator_of_mem hi]
        · rw [indicator_of_notMem hz]
          exact zero_le
    _ ≤ liminf (fun i => ∫⁻ z, (S (xs i)).indicator 1 z ∂μ) atTop :=
        lintegral_liminf_le fun i => measurable_one.indicator (hSm (xs i))
    _ = liminf (fun i => μ (S (xs i))) atTop := by simp_rw [lintegral_indicator_one (hSm _)]
    _ ≤ s := liminf_le_of_frequently_le' (Frequently.of_forall fun i => (hxs i).2)
/-- Uniform version of an eventual property on a set of finite measure (Simon Ch. 3, proof of 1.6
“⇐”, (7)–(9): Egoroff's theorem carried out on sets).  If `μ(F) < ∞`, every `T ρ` with `ρ > 0`
is closed and each `x ∈ F` lies in `T ρ` for all small `ρ > 0`, then for `η ≠ 0` there are
`E ⊆ F` with `μ(F \ E) < η` and `δ > 0` such that `E ⊆ T ρ` whenever `0 < ρ < δ`.  The Borel
sets `G_k = F ∩ ⋂_{0 < ρ < 1/(k+1)} T ρ` increase to `F`, so `μ(F \ G_k) → 0` by continuity
from above; take `E = G_k` and `δ = 1/(k+1)` for a large `k`. -/
theorem Submission.cbrr_ud_uniformize_eventually : ∀ (P : ℕ) (μ : Measure (Euclid P)) (F : Set (Euclid P)) (T : ℝ → Set (Euclid P)), MeasurableSet F → μ F ≠ ∞ → (∀ ρ : ℝ, 0 < ρ → IsClosed (T ρ)) → (∀ x ∈ F, ∀ᶠ ρ in 𝓝[>] (0 : ℝ), x ∈ T ρ) → ∀ η : ℝ≥0∞, η ≠ 0 → ∃ (E : Set (Euclid P)) (δ : ℝ), E ⊆ F ∧ 0 < δ ∧ μ (F \ E) < η ∧ ∀ x ∈ E, ∀ ρ : ℝ, 0 < ρ → ρ < δ → x ∈ T ρ := by
  intro P μ F T hF hμF hT hev η hη
  -- `G_k = F ∩ ⋂_{0 < ρ < 1/(k+1)} T ρ` is Borel, each `T ρ` with `ρ > 0` being closed
  let G : ℕ → Set (Euclid P) := fun k => F ∩ ⋂ ρ ∈ Ioo (0 : ℝ) (1 / ((k : ℝ) + 1)), T ρ
  have hG : ∀ k, MeasurableSet (G k) := fun k =>
    hF.inter (isClosed_biInter fun ρ hρ => hT ρ hρ.1).measurableSet
  -- `G_k` increases with `k`, so `F \ G_k` decreases
  have hanti : Antitone fun k => F \ G k := fun i j hij =>
    sdiff_subset_sdiff_right (inter_subset_inter_right F
      (biInter_subset_biInter_left (Ioo_subset_Ioo_right (Nat.one_div_le_one_div hij))))
  -- `⋃_k G_k = F`: a point of `F` lies in `T ρ` for `0 < ρ < r`, and `1/(k+1) < r` for some `k`
  have hempty : ⋂ k, F \ G k = ∅ := by
    refine eq_empty_of_forall_notMem fun x hx => ?_
    have hxF : x ∈ F := (mem_iInter.mp hx 0).1
    obtain ⟨r, hr, hrT⟩ := (nhdsGT_basis (0 : ℝ)).eventually_iff.mp (hev x hxF)
    obtain ⟨k, hk⟩ := exists_nat_one_div_lt hr
    exact (mem_iInter.mp hx k).2 ⟨hxF, mem_iInter₂.mpr fun ρ hρ => hrT ⟨hρ.1, hρ.2.trans hk⟩⟩
  -- continuity from above: `μ (F \ G_k) → μ ∅ = 0`
  have hlim : Tendsto (fun k => μ (F \ G k)) atTop (𝓝 0) := by
    have h := tendsto_measure_iInter_atTop (μ := μ) (fun k => (hF.diff (hG k)).nullMeasurableSet)
      hanti ⟨0, measure_ne_top_of_subset sdiff_subset hμF⟩
    rwa [hempty, measure_empty] at h
  -- some `k` has `μ (F \ G_k) < η`; take `E = G_k` and `δ = 1/(k+1)`
  obtain ⟨k, hk⟩ := (hlim.eventually (gt_mem_nhds (pos_iff_ne_zero.mpr hη))).exists
  exact ⟨G k, 1 / ((k : ℝ) + 1), inter_subset_left, Nat.one_div_pos_of_nat, hk,
    fun x hx ρ hρ hρk => mem_iInter₂.mp hx.2 ρ ⟨hρ, hρk⟩⟩
/-- **Uniform lower density and cone bounds on a set of almost full measure** (Simon Ch. 3, proof
of Theorem 1.6 “⇐”, (4)–(9)).  Let `μ = Hⁿ⌞M` with `Hⁿ(M) < ∞`, let `x ↦ p_{Q(x)}` be `μ`-a.e.
strongly measurable and let `Q(x)` be the approximate tangent space of `M` at `μ`-a.e. `x`.  If
`ofReal a < ωₙ`, `b > 0` and `ε > 0`, there are `E ⊆ M` with `Hⁿ(M \ E) < ε` and `δ > 0` such that
for `x ∈ E` and `0 < ρ < δ`: `dim Q(x) = n`, `aρⁿ ≤ μ(B̄_ρ(x))` and `μ(X(x) ∩ B_ρ(x)) ≤ bρⁿ`,
where `X(x) = {z : 2|p_{Q(x)}(z − x)| < |z − x|}`.  Lusin's theorem gives a compact `K ⊆ M` of
tangent points with `Hⁿ(M \ K) < ε/2` on which `x ↦ p_{Q(x)}` is continuous.  The set `T_ρ` of
points of `K` with both bounds at radius `ρ` is closed, and each `x ∈ K` lies in `T_ρ` for all
small `ρ > 0` by the lower density and cone density bounds.  Uniformizing gives `E ⊆ K` with
`Hⁿ(K \ E) < ε/2` and `δ > 0` with `E ⊆ T_ρ` for `0 < ρ < δ`. -/
theorem Submission.cbrr_uniform_density_on_large_set : ∀ (P n : ℕ) (M : Set (Euclid P)) (Q : Euclid P → Submodule ℝ (Euclid P)), 0 < n → MeasurableSet M → μHE[n] M ≠ ∞ → AEStronglyMeasurable (fun x => (Q x).starProjection) (μHE[n].restrict M) → (∀ᵐ x ∂(μHE[n].restrict M), HasApproximateTangentSpaceAt n M x (Q x)) → ∀ (a b ε : ℝ), ENNReal.ofReal a < unitBallVolume n → 0 < b → 0 < ε → ∃ (E : Set (Euclid P)) (δ : ℝ), E ⊆ M ∧ 0 < δ ∧ μHE[n] (M \ E) < ENNReal.ofReal ε ∧ (∀ x ∈ E, Module.finrank ℝ (Q x) = n) ∧ (∀ y ∈ E, ∀ ρ : ℝ, 0 < ρ → ρ < δ → ENNReal.ofReal (a * ρ ^ n) ≤ (μHE[n].restrict M) (closedBall y ρ)) ∧ ∀ x ∈ E, ∀ ρ : ℝ, 0 < ρ → ρ < δ → (μHE[n].restrict M) ({z | 2 * ‖(Q x).starProjection (z - x)‖ < ‖z - x‖} ∩ ball x ρ) ≤ ENNReal.ofReal (b * ρ ^ n) := by
  intro P n M Q hn hM hMfin hQm hQt a b ε ha hb hε
  -- Step 1: `μ = Hⁿ⌞M` is finite, and `ofReal (ε/2) ≠ 0`
  have : IsFiniteMeasure (μHE[n].restrict M) := isFiniteMeasure_restrict.mpr hMfin
  have hε2 : ENNReal.ofReal (ε / 2) ≠ 0 := (ENNReal.ofReal_pos.mpr (half_pos hε)).ne'
  -- Step 2: Lusin's theorem: a compact `K ⊆ M` of tangent points with `Hⁿ(M \ K) < ε/2`, on which
  -- `x ↦ p_{Q(x)}` is continuous
  obtain ⟨K, hK, hKM, hMK, hKt, hKc⟩ := Submission.cbrr_ud_lusin_of_aestronglyMeasurable P
    μHE[n] M (fun x => (Q x).starProjection) (fun x => HasApproximateTangentSpaceAt n M x (Q x))
    hM hMfin hQm hQt (ENNReal.ofReal (ε / 2)) hε2
  -- Step 3: `T_ρ = {y : ofReal(aρⁿ) ≤ μ(B̄_ρ(y))} ∩ {x ∈ K : μ(X(x) ∩ B_ρ(x)) ≤ ofReal(bρⁿ)}` is
  -- closed: closed-ball mass is upper semicontinuous, and cone mass is lower semicontinuous on the
  -- closed set `K`, where `x ↦ p_{Q(x)}` is continuous
  set T : ℝ → Set (Euclid P) := fun ρ =>
    {y | ENNReal.ofReal (a * ρ ^ n) ≤ (μHE[n].restrict M) (closedBall y ρ)} ∩
      {x | x ∈ K ∧ (μHE[n].restrict M) ({z | 2 * ‖(Q x).starProjection (z - x)‖ < ‖z - x‖} ∩
        ball x ρ) ≤ ENNReal.ofReal (b * ρ ^ n)}
  have hTc : ∀ ρ : ℝ, 0 < ρ → IsClosed (T ρ) := fun ρ _ =>
    (Submission.cbrr_ud_isClosed_closedBall_mass_ge P (μHE[n].restrict M) ρ
      (ENNReal.ofReal (a * ρ ^ n))).inter
      (Submission.cbrr_ud_isClosed_cone_mass_le P (μHE[n].restrict M) K Q ρ
        (ENNReal.ofReal (b * ρ ^ n)) hK.isClosed hKc)
  -- Step 4: every `x ∈ K` lies in `T_ρ` for all small `ρ > 0`, by the lower density bound with
  -- `c = ofReal a` and the cone density bound with `t = ofReal b`; here `μ(S) = Hⁿ(M ∩ S)` and
  -- `ofReal(cρⁿ) = ofReal c · ofReal ρⁿ` (`ρⁿ ≥ 0`)
  have hTev : ∀ x ∈ K, ∀ᶠ ρ in 𝓝[>] (0 : ℝ), x ∈ T ρ := by
    intro x hx
    filter_upwards [Submission.doragm_approxTangent_lower_density P n M x (Q x) hn (hKt x hx)
      (ENNReal.ofReal a) ha, Submission.cbrr_tangent_cone_density_zero P n M x (Q x) hn hMfin
      (hKt x hx) (ENNReal.ofReal b) (ENNReal.ofReal_pos.mpr hb), self_mem_nhdsWithin]
      with ρ hρa hρb hρ
    have hρn : 0 ≤ ρ ^ n := pow_nonneg (le_of_lt (show 0 < ρ from hρ)) n
    refine ⟨?_, hx, ?_⟩
    · show ENNReal.ofReal (a * ρ ^ n) ≤ (μHE[n].restrict M) (closedBall x ρ)
      rw [ENNReal.ofReal_mul' hρn, Measure.restrict_apply' hM, inter_comm]
      exact hρa
    · show (μHE[n].restrict M) ({z | 2 * ‖(Q x).starProjection (z - x)‖ < ‖z - x‖} ∩ ball x ρ) ≤
        ENNReal.ofReal (b * ρ ^ n)
      rw [ENNReal.ofReal_mul hb.le, Measure.restrict_apply' hM, inter_comm]
      exact hρb
  -- Step 5: uniformize: `E ⊆ K` with `Hⁿ(K \ E) < ε/2` and `δ > 0` with `E ⊆ T_ρ` for `0 < ρ < δ`
  obtain ⟨E, δ, hEK, hδ, hKE, hET⟩ := Submission.cbrr_ud_uniformize_eventually P μHE[n] K T
    hK.isClosed.measurableSet (measure_ne_top_of_subset hKM hMfin) hTc hTev
    (ENNReal.ofReal (ε / 2)) hε2
  -- Step 6: `E ⊆ K ⊆ M` consists of tangent points, both bounds come from `T_ρ`, and
  -- `M \ E ⊆ (M \ K) ∪ (K \ E)`, so `Hⁿ(M \ E) < ε/2 + ε/2 = ε`
  refine ⟨E, δ, hEK.trans hKM, hδ, ?_, fun x hx => (hKt x (hEK hx)).1,
    fun y hy ρ hρ hρδ => (hET y hy ρ hρ hρδ).1, fun x hx ρ hρ hρδ => (hET x hx ρ hρ hρδ).2.2⟩
  calc μHE[n] (M \ E)
      ≤ μHE[n] ((M \ K) ∪ (K \ E)) := by
        refine measure_mono fun x hx => ?_
        by_cases hxK : x ∈ K
        · exact Or.inr ⟨hxK, hx.2⟩
        · exact Or.inl ⟨hx.1, hxK⟩
    _ ≤ μHE[n] (M \ K) + μHE[n] (K \ E) := measure_union_le _ _
    _ < ENNReal.ofReal (ε / 2) + ENNReal.ofReal (ε / 2) := ENNReal.add_lt_add hMK hKE
    _ = ENNReal.ofReal ε := by
        rw [← ENNReal.ofReal_add (half_pos hε).le (half_pos hε).le, add_halves]
/-- Finite `ε`-net of `n`-planes in the projection operator norm (Simon Ch. 3, proof of 1.6, the
choice of `π₁, …, π_N`): there are `n`-dimensional subspaces `T₁, …, T_N` of `ℝᴾ` such that every
`n`-dimensional `Q` has `‖p_Q − p_{T_j}‖ < ε` for some `j`.  The rank-`n` orthogonal projections
lie in the closed unit ball of the finite-dimensional space `L(ℝᴾ)`, so they are totally bounded
and finitely many of them are `ε`-dense among them; write those as `p_{T_j}`. -/
theorem Submission.cbrr_projection_net : ∀ (P n : ℕ) (ε : ℝ), 0 < ε → ∃ (N : ℕ) (T : Fin N → Submodule ℝ (Euclid P)), (∀ j, Module.finrank ℝ (T j) = n) ∧ ∀ Q : Submodule ℝ (Euclid P), Module.finrank ℝ Q = n → ∃ j, ‖Q.starProjection - (T j).starProjection‖ < ε := by
  intro P n ε hε
  -- the rank-`n` orthogonal projections lie in the closed unit ball, so they form a totally
  -- bounded set
  have hS : TotallyBounded ((fun Q : Submodule ℝ (Euclid P) => Q.starProjection) ''
      {Q | Module.finrank ℝ Q = n}) :=
    (isCompact_closedBall (0 : Euclid P →L[ℝ] Euclid P) 1).totallyBounded.subset (by
      rintro _ ⟨Q, -, rfl⟩
      simpa using Q.starProjection_norm_le)
  -- finitely many of them are `ε`-dense among them
  obtain ⟨t, htS, htfin, hcover⟩ := finite_approx_of_totallyBounded hS ε hε
  have ht : ∀ L ∈ t, ∃ T : Submodule ℝ (Euclid P), Module.finrank ℝ T = n ∧ T.starProjection = L :=
    fun L hL => htS hL
  choose! T hT using ht
  -- enumerate them
  obtain ⟨N, ⟨e⟩⟩ := @Finite.exists_equiv_fin t htfin.to_subtype
  refine ⟨N, fun j => T (e.symm j), fun j => (hT _ (e.symm j).2).1, fun Q hQ => ?_⟩
  obtain ⟨L, hL, hQL⟩ := mem_iUnion₂.1 (hcover ⟨Q, hQ, rfl⟩)
  refine ⟨e ⟨L, hL⟩, ?_⟩
  simp only [Equiv.symm_apply_apply]
  rw [(hT L hL).2, ← dist_eq_norm]
  exact hQL
/-- **Cone claim (10) in the proof of Simon Ch. 3, Theorem 1.6 "⇐"**, with the corrected constant
`b·16ⁿ < a`.  Suppose `μ(B̄_ρ(y)) ≥ aρⁿ` for `y ∈ E` and `μ(X(x) ∩ B_ρ(x)) ≤ bρⁿ` for `x ∈ E`,
`0 < ρ < δ`, where `X(x) = {z : 2|p_{Q(x)}(z − x)| < |z − x|}`.  If `x, y ∈ E`,
`‖p_{Q(x)} − p_T‖ < 1/16` and `|y − x| < δ/2`, then `|y − x| ≤ 4|p_T(y − x)|`.  Otherwise
`σ = |y − x|` has `B̄_{σ/8}(y) ⊆ X(x) ∩ B_{2σ}(x)`, so `a(σ/8)ⁿ ≤ b(2σ)ⁿ = b·16ⁿ(σ/8)ⁿ`. -/
theorem Submission.cbrr_cone_claim : ∀ (P n : ℕ) (μ : Measure (Euclid P)) (E : Set (Euclid P)) (Q : Euclid P → Submodule ℝ (Euclid P)) (T : Submodule ℝ (Euclid P)) (a b δ : ℝ), 0 < a → b * 16 ^ n < a → (∀ y ∈ E, ∀ ρ : ℝ, 0 < ρ → ρ < δ → ENNReal.ofReal (a * ρ ^ n) ≤ μ (closedBall y ρ)) → (∀ x ∈ E, ∀ ρ : ℝ, 0 < ρ → ρ < δ → μ ({z | 2 * ‖(Q x).starProjection (z - x)‖ < ‖z - x‖} ∩ ball x ρ) ≤ ENNReal.ofReal (b * ρ ^ n)) → ∀ x ∈ E, ∀ y ∈ E, ‖(Q x).starProjection - T.starProjection‖ < 1 / 16 → ‖y - x‖ < δ / 2 → ‖y - x‖ ≤ 4 * ‖T.starProjection (y - x)‖ := by
  intro P n μ E Q T a b δ ha hab hlow hup x hx y hy hQT hyx
  -- Step 1: suppose `4|p_T(y − x)| < σ := |y − x|`; then `0 < σ < δ/2`.
  refine not_lt.mp fun hcon => ?_
  set σ := ‖y - x‖
  have hσ0 : 0 < σ := lt_of_le_of_lt (by positivity) hcon
  -- `|p_{Q(x)}(y − x)| ≤ |p_T(y − x)| + ‖p_{Q(x)} − p_T‖σ < σ/4 + σ/16`.
  have hQy : ‖(Q x).starProjection (y - x)‖ < σ / 4 + σ / 16 := by
    have hsplit : (Q x).starProjection (y - x) =
        T.starProjection (y - x) + ((Q x).starProjection - T.starProjection) (y - x) := by
      simp
    have hop : ‖((Q x).starProjection - T.starProjection) (y - x)‖ < σ / 16 := by
      calc ‖((Q x).starProjection - T.starProjection) (y - x)‖
          ≤ ‖(Q x).starProjection - T.starProjection‖ * σ := ContinuousLinearMap.le_opNorm _ _
        _ < 1 / 16 * σ := by gcongr
        _ = σ / 16 := by ring
    rw [hsplit]
    calc ‖T.starProjection (y - x) + ((Q x).starProjection - T.starProjection) (y - x)‖
        ≤ ‖T.starProjection (y - x)‖ + ‖((Q x).starProjection - T.starProjection) (y - x)‖ :=
          norm_add_le _ _
      _ < σ / 4 + σ / 16 := by linarith
  -- Step 2: `B̄_{σ/8}(y) ⊆ X(x) ∩ B_{2σ}(x)`.
  have hsub : closedBall y (σ / 8) ⊆
      {z | 2 * ‖(Q x).starProjection (z - x)‖ < ‖z - x‖} ∩ ball x (2 * σ) := by
    intro z hz
    have hzy : ‖z - y‖ ≤ σ / 8 := by rwa [mem_closedBall, dist_eq_norm] at hz
    have hdecomp : z - x = (y - x) + (z - y) := by abel
    -- `|p_{Q(x)}(z − x)| ≤ |p_{Q(x)}(y − x)| + |z − y| < 7σ/16`.
    have hQz : ‖(Q x).starProjection (z - x)‖ < 7 * σ / 16 := by
      calc ‖(Q x).starProjection (z - x)‖
          = ‖(Q x).starProjection (y - x) + (Q x).starProjection (z - y)‖ := by
            rw [hdecomp, map_add]
        _ ≤ ‖(Q x).starProjection (y - x)‖ + ‖(Q x).starProjection (z - y)‖ := norm_add_le _ _
        _ ≤ ‖(Q x).starProjection (y - x)‖ + ‖z - y‖ := by
            gcongr; exact (Q x).norm_starProjection_apply_le _
        _ < 7 * σ / 16 := by linarith
    -- `7σ/8 ≤ |z − x| ≤ 9σ/8 < 2σ`.
    have hlow' : σ - ‖z - y‖ ≤ ‖z - x‖ := by
      have := norm_sub_le (z - x) (z - y)
      have h' : (z - x) - (z - y) = y - x := by abel
      rw [h'] at this
      linarith
    have hup' : ‖z - x‖ ≤ σ + ‖z - y‖ := by
      rw [hdecomp]; exact norm_add_le _ _
    refine ⟨?_, ?_⟩
    · show 2 * ‖(Q x).starProjection (z - x)‖ < ‖z - x‖
      linarith
    · rw [mem_ball, dist_eq_norm]
      linarith
  -- Step 3: the density bounds at `y` (radius `σ/8`) and at `x` (radius `2σ`).
  have key : ENNReal.ofReal (a * (σ / 8) ^ n) ≤ ENNReal.ofReal (b * (2 * σ) ^ n) :=
    (hlow y hy (σ / 8) (by positivity) (by linarith)).trans
      ((measure_mono hsub).trans (hup x hx (2 * σ) (by positivity) (by linarith)))
  -- Step 4: `a(σ/8)ⁿ > 0` forces `a(σ/8)ⁿ ≤ b(2σ)ⁿ = b·16ⁿ(σ/8)ⁿ`, so `a ≤ b·16ⁿ`.
  have hs : 0 < (σ / 8) ^ n := by positivity
  have key' : a * (σ / 8) ^ n ≤ b * (2 * σ) ^ n :=
    (ENNReal.ofReal_le_ofReal_iff'.mp key).resolve_right (not_le.mpr (by positivity))
  have h16 : b * (2 * σ) ^ n = b * 16 ^ n * (σ / 8) ^ n := by
    rw [mul_assoc, ← mul_pow]
    congr 2
    ring
  rw [h16] at key'
  have : a ≤ b * 16 ^ n := le_of_mul_le_mul_right key' hs
  linarith
/-- Lipschitz cover under the cone condition (Simon Ch. 3, proof of 1.6, with the extension
theorem Ch. 2, 1.2): if `T ⊆ ℝᴾ` is an `n`-dimensional subspace and `|y − x| ≤ C |p_T(y − x)|` for
all `x, y ∈ D`, then `D ⊆ F(ℝⁿ)` for a Lipschitz `F : ℝⁿ → ℝᴾ`.  With a linear isometry
`ι : T ≅ ℝⁿ` put `L = ι ∘ p_T`, so `|Lv − Lw| = |p_T(v − w)|`; `L` is injective on `D` and its
inverse on `L(D)` is `max C 0`-Lipschitz.  Extend this inverse (McShane, coordinatewise) to a
Lipschitz `F : ℝⁿ → ℝᴾ`; then `F(Lx) = x` for `x ∈ D`. -/
theorem Submission.cbrr_lipschitz_cover_of_cone_condition : ∀ (P n : ℕ) (T : Submodule ℝ (Euclid P)) (D : Set (Euclid P)) (C : ℝ), Module.finrank ℝ T = n → (∀ x ∈ D, ∀ y ∈ D, ‖y - x‖ ≤ C * ‖T.starProjection (y - x)‖) → ∃ F : Euclid n → Euclid P, (∃ K : NNReal, LipschitzWith K F) ∧ D ⊆ range F := by
  intro P n T D C hT hD
  -- Step 1: the cone condition with the constant `K = max C 0 ≥ 0`
  obtain ⟨K, hK⟩ : ∃ K : NNReal, ∀ x ∈ D, ∀ y ∈ D, ‖y - x‖ ≤ K * ‖T.starProjection (y - x)‖ :=
    ⟨C.toNNReal, fun x hx y hy => (hD x hx y hy).trans <| by
      rw [Real.coe_toNNReal']
      exact mul_le_mul_of_nonneg_right (le_max_left _ _) (norm_nonneg _)⟩
  -- Step 2: the chart `L = ι ∘ p_T : ℝᴾ → ℝⁿ`, `ι : T ≅ ℝⁿ` a linear isometry
  let ι : T ≃ₗᵢ[ℝ] Euclid n := ((stdOrthonormalBasis ℝ T).reindex (finCongr hT)).repr
  let L : Euclid P → Euclid n := fun v => ι (T.orthogonalProjectionOnto v)
  have hL : ∀ x ∈ D, ∀ y ∈ D, ‖y - x‖ ≤ K * ‖L y - L x‖ := by
    intro x hx y hy
    have h : ‖L y - L x‖ = ‖T.starProjection (y - x)‖ := by
      simp only [L, ← map_sub, LinearIsometryEquiv.norm_map, Submodule.starProjection_apply,
        Submodule.norm_coe]
    rw [h]
    exact hK x hx y hy
  -- Step 3: `L` is injective on `D`, with a `K`-Lipschitz inverse `g` on `L(D)`
  have hinj : InjOn L D := by
    intro x hx y hy hxy
    have h := hL x hx y hy
    rw [hxy, sub_self, norm_zero, mul_zero] at h
    exact (sub_eq_zero.mp (norm_le_zero_iff.mp h)).symm
  let g : Euclid n → Euclid P := invFunOn L D
  have hgL : ∀ x ∈ D, g (L x) = x := fun x hx => hinj.leftInvOn_invFunOn hx
  have hg : LipschitzOnWith K g (L '' D) := by
    refine LipschitzOnWith.of_dist_le_mul ?_
    rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
    rw [hgL x hx, hgL y hy, dist_eq_norm, dist_eq_norm]
    exact hL y hy x hx
  -- Step 4: extend `g` to a Lipschitz `F : ℝⁿ → ℝᴾ` (McShane in each coordinate)
  obtain ⟨F, hF, hFg⟩ := hg.extend_finite_dimension
  -- Step 5: `F (L x) = g (L x) = x` for `x ∈ D`
  refine ⟨F, ⟨_, hF⟩, fun x hx => ⟨L x, ?_⟩⟩
  rw [← hFg (mem_image_of_mem L hx), hgL x hx]

/-- Rectifiability from uniform density bounds (Simon Ch. 3, proof of Theorem 1.6, steps
(6)–(10) and the final cover).  Take a `1/16`-net `T₁, …, T_N` of `n`-planes and a dense sequence
`(u_q)` in `ℝᴾ`, and cut `E` into the countably many pieces
`D_{j,q} = {x ∈ E : ‖p_{Q(x)} − p_{T_j}‖ < 1/16} ∩ B_{δ/4}(u_q)`.  Two points of `D_{j,q}` are
closer than `δ/2`, so the cone claim gives `|y − x| ≤ 4 |p_{T_j}(y − x)|` on `D_{j,q}`, and
`D_{j,q}` lies in a single Lipschitz image `F_{j,q}(ℝⁿ)`.  The pieces cover `E`, so `E` lies in a
countable union of Lipschitz images of `ℝⁿ`.  (Simon covers a compact `E` by finitely many balls
`B_{δ/4}(x₀)`; centres from a dense sequence make compactness unnecessary.) -/
theorem Submission.cbrr_rectifiable_of_uniform_density : ∀ (P n : ℕ) (μ : Measure (Euclid P)) (E : Set (Euclid P)) (Q : Euclid P → Submodule ℝ (Euclid P)) (a b δ : ℝ), 0 < a → b * 16 ^ n < a → 0 < δ → (∀ x ∈ E, Module.finrank ℝ (Q x) = n) → (∀ y ∈ E, ∀ ρ : ℝ, 0 < ρ → ρ < δ → ENNReal.ofReal (a * ρ ^ n) ≤ μ (closedBall y ρ)) → (∀ x ∈ E, ∀ ρ : ℝ, 0 < ρ → ρ < δ → μ ({z | 2 * ‖(Q x).starProjection (z - x)‖ < ‖z - x‖} ∩ ball x ρ) ≤ ENNReal.ofReal (b * ρ ^ n)) → CountablyRectifiable n E := by
  intro P n μ E Q a b δ ha hab hδ hQ hlow hup
  -- Step 1: a `1/16`-net `T₁, …, T_N` of `n`-planes
  obtain ⟨N, T, hT, hnet⟩ := Submission.cbrr_projection_net P n (1 / 16) (by norm_num)
  -- Step 2: a dense sequence `(u_q)` of centres
  obtain ⟨u, hu⟩ := TopologicalSpace.exists_dense_seq (Euclid P)
  -- Step 3: the pieces `D_{j,q}`
  let D : Fin N × ℕ → Set (Euclid P) := fun p =>
    {x | x ∈ E ∧ ‖(Q x).starProjection - (T p.1).starProjection‖ < 1 / 16} ∩ ball (u p.2) (δ / 4)
  -- Step 4: the cone condition on each piece, whose points are less than `δ / 2` apart
  have hcone : ∀ p, ∀ x ∈ D p, ∀ y ∈ D p, ‖y - x‖ ≤ 4 * ‖(T p.1).starProjection (y - x)‖ := by
    rintro ⟨j, q⟩ x ⟨⟨hxE, hxj⟩, hxq⟩ y ⟨⟨hyE, -⟩, hyq⟩
    refine Submission.cbrr_cone_claim P n μ E Q (T j) a b δ ha hab hlow hup x hxE y hyE hxj ?_
    rw [mem_ball] at hxq hyq
    calc ‖y - x‖ = dist y x := (dist_eq_norm y x).symm
      _ ≤ dist y (u q) + dist x (u q) := dist_triangle_right y x (u q)
      _ < δ / 4 + δ / 4 := add_lt_add hyq hxq
      _ = δ / 2 := by ring
  -- Step 5: each piece lies in one Lipschitz image `F_{j,q}(ℝⁿ)`
  choose F hF hDF using fun p : Fin N × ℕ =>
    Submission.cbrr_lipschitz_cover_of_cone_condition P n (T p.1) (D p) 4 (hT p.1) (hcone p)
  -- Step 6: the pieces cover `E`
  have hcover : E ⊆ ⋃₀ range fun p => range (F p) := by
    intro x hx
    obtain ⟨j, hj⟩ := hnet (Q x) (hQ x hx)
    obtain ⟨q, hq⟩ := hu.exists_dist_lt x (by positivity : (0 : ℝ) < δ / 4)
    exact mem_sUnion.2 ⟨range (F (j, q)), mem_range_self _, hDF (j, q) ⟨⟨hx, hj⟩, mem_ball.2 hq⟩⟩
  -- Step 7: the countably many Lipschitz images are countably `n`-rectifiable, hence so is `E`
  refine (Poincare.SimonGMT.Chapter03.countablyRectifiable_sUnion
    (countable_range fun p => range (F p)) ?_).mono hcover
  rintro _ ⟨p, rfl⟩
  obtain ⟨K, hK⟩ := hF p
  exact Poincare.SimonGMT.Chapter03.countablyRectifiable_range hK

/-- **Approximate tangent spaces imply rectifiability** (Simon Ch. 3, Theorem 1.6 “⇐”).  Let
`Hⁿ(M) < ∞`, let `x ↦ p_{Q(x)}` be `Hⁿ⌞M`-a.e. strongly measurable and let `Q(x)` be the
approximate tangent space of `M` at `Hⁿ`-a.e. `x ∈ M`; then `M` is countably `n`-rectifiable.  For
`n = 0`, `M` is finite.  For `n > 0` fix `0 < a` with `a < ωₙ` and `b = a/2/16ⁿ`, so
`b·16ⁿ = a/2 < a`.  For every `m` the uniform lower density and cone bounds hold on some `E_m ⊆ M`
with `Hⁿ(M \ E_m) < 1/(m+1)`, so `E_m` is countably `n`-rectifiable.  Then `M \ ⋃ E_m` is
`Hⁿ`-null, and `M` lies in this null set together with countably many Lipschitz images. -/
theorem Submission.dtc_bc_tc_cl_rectifiable_of_approx_tangent : ∀ (P n : ℕ) (M : Set (Euclid P)) (Q : Euclid P → Submodule ℝ (Euclid P)), MeasurableSet M → μHE[n] M ≠ ∞ → AEStronglyMeasurable (fun x => (Q x).starProjection) (μHE[n].restrict M) → (∀ᵐ x ∂(μHE[n].restrict M), HasApproximateTangentSpaceAt n M x (Q x)) → CountablyRectifiable n M := by
  intro P n M Q hM hMfin hQm hQt
  -- Step 1: for `n = 0` the set `M` is finite
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · exact Submission.cbrr_rectifiable_dim_zero P M hMfin
  -- Step 2: constants `0 < a` with `ofReal a < ωₙ` and `b = a/2/16ⁿ > 0`, so `b·16ⁿ = a/2 < a`
  obtain ⟨a, -, ha, haω⟩ := ENNReal.lt_iff_exists_real_btwn.mp
    (measure_ball_pos volume (0 : Euclid n) one_pos : 0 < unitBallVolume n)
  rw [ENNReal.ofReal_pos] at ha
  have hb : 0 < a / 2 / 16 ^ n := by positivity
  have hab : a / 2 / 16 ^ n * 16 ^ n < a := by
    rw [div_mul_cancel₀ _ (by positivity : (16 : ℝ) ^ n ≠ 0)]
    exact half_lt_self ha
  -- Step 3: for every `m`, the uniform density and cone bounds hold on some `E_m ⊆ M` with
  -- `Hⁿ(M \ E_m) < 1/(m+1)`, so `E_m` is countably `n`-rectifiable
  have hE : ∀ m : ℕ, ∃ E : Set (Euclid P), μHE[n] (M \ E) < ENNReal.ofReal (1 / ((m : ℝ) + 1)) ∧
      CountablyRectifiable n E := by
    intro m
    obtain ⟨E, δ, -, hδ, hME, hQE, hlow, hup⟩ := Submission.cbrr_uniform_density_on_large_set P n
      M Q hn hM hMfin hQm hQt a (a / 2 / 16 ^ n) (1 / ((m : ℝ) + 1)) haω hb Nat.one_div_pos_of_nat
    exact ⟨E, hME, Submission.cbrr_rectifiable_of_uniform_density P n (μHE[n].restrict M) E Q a
      (a / 2 / 16 ^ n) δ ha hab hδ hQE hlow hup⟩
  choose E hME hErect using hE
  -- Step 4: `M \ ⋃ E_m ⊆ M \ E_m` has `Hⁿ`-measure `< 1/(m+1)` for every `m`, so it is null
  have hlim := ENNReal.tendsto_ofReal tendsto_one_div_add_atTop_nhds_zero_nat
  rw [ENNReal.ofReal_zero] at hlim
  have hnull : μHE[n] (M \ ⋃ m, E m) = 0 := nonpos_iff_eq_zero.mp <| ge_of_tendsto' hlim fun m =>
    (measure_mono (sdiff_subset_sdiff_right (subset_iUnion E m))).trans (hME m).le
  -- Step 5: `M ⊆ (M \ ⋃ E_m) ∪ ⋃ E_m`, a null set together with countably many Lipschitz images
  obtain ⟨M₀, hM₀, F, hF, hcover⟩ := Poincare.SimonGMT.Chapter03.countablyRectifiable_iUnion E hErect
  refine ⟨M₀ ∪ (M \ ⋃ m, E m), measure_union_null hM₀ hnull, F, hF, fun x hx => ?_⟩
  by_cases hxE : x ∈ ⋃ m, E m
  · exact (hcover hxE).imp_left Or.inl
  · exact Or.inl (Or.inr ⟨hx, hxE⟩)

/-- **Finite-mass cycles with the integer slice property are integer multiplicity** (B. White's
tangent-plane argument, Comment. Math. Helv. 64 (1989), in place of Simon Ch. 6, 8.1).  Let
`n = d + 1`, assume `SLIM_{P,d}` (weak limits of currents with the integer slice property `ISP` and
locally bounded `M_W(Xᵢ) + M_W(∂Xᵢ)` have `ISP`) and `LD_{P,d}` (for `ISP` cycles the lower density
of the mass measure is `≥ η₀` a.e.).  If `∂Γ = 0`, `M(Γ) < ∞` and `Γ` has `ISP`, then `Γ` is
integer multiplicity.  `(REP)` represents `Γ` by `(μ, ξ)`, with `μ ≪ Hⁿ` since `∂Γ = 0`, and
`LD_{P,d}` gives the lower density bound, so `μ = θHⁿ⌞M` and `Γ = ∫_M θ⟨·, ζ⟩ dHⁿ` with `|ζ|* = 1`
on `M`.  For `Hⁿ`-a.e. `a ∈ M` the upper density of `Hⁿ⌞M` at `a` is `≤ 1` and `a` is a Lebesgue
point of `θζ`; there the blow-ups of `Γ` give an approximate tangent plane of `M` oriented by
`ζ(a)` and `θ(a) ∈ ℕ`.  The integer multiplicity criterion with `(RECT)` concludes. -/
theorem Submission.dtc_bc_tc_cl_cycle_isIntegerMultiplicity : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → ∀ (P d : ℕ), d + 1 < P → (∀ (Xs : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (X : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), (∀ i, (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), Xs i ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (Xs i).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B))) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ → ⨆ i, ((Xs i).massOn W + (Xs i).boundary.massOn W) < ∞) → WeaklyConvergesOn Xs X → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), X ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (X).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B))) → (∃ η₀ : ℝ, 0 < η₀ ∧ ∀ (C : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)), C.boundary = 0 → (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ W : Set (Euclid P), IsOpen W → C.massOn W = μ W) → AEStronglyMeasurable ξ μ → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (C).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B)) → ∀ᵐ x ∂μ, ENNReal.ofReal η₀ ≤ liminf (fun r : ℝ => μ (ball x r) / (unitBallVolume (d + 1) * ENNReal.ofReal (r ^ (d + 1)))) (𝓝[>] 0)) → (∀ (Γ : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), Γ.boundary = 0 → Γ.mass < ∞ → IsCompact Γ.support → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), Γ ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (Γ).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B)) → IsIntegerMultiplicity Γ) := by
  intro hMR _hIMC _hVO P d _hdP hSLIM hLD Γ hΓb hΓm _hΓs hΓisp
  obtain ⟨hREP, hCT, -⟩ := Submission.dtc_bc_tc_cl_foundations
  -- Step 1: `(REP)` in `U = ℝᴾ`, using `M_W(Γ) ≤ M(Γ) < ∞`
  obtain ⟨μ, ξ, -, hμK, hμW, hξ, hξb, hΓξ, hac⟩ := hREP P (d + 1) univ Γ isOpen_univ
    fun W _ _ => (Γ.massOn_mono (subset_univ W)).trans_lt hΓm
  have hμ : μ univ < ∞ := by
    rw [← hμW univ isOpen_univ]
    exact hΓm
  -- `M_W(∂Γ) = M_W(0) = 0`, so `μ ≪ Hⁿ`
  have hμac : ∀ E : Set (Euclid P), μHE[d + 1] E = 0 → μ E = 0 := hac fun W _ _ => by
    show Γ.boundary.massOn W < ∞
    rw [hΓb]
    refine (sSup_le ?_).trans_lt ENNReal.zero_lt_top
    rintro _ ⟨ω, -, rfl⟩
    simp
  -- Step 2: `LD_{P,d}` for the cycle `Γ` with the representation `(μ, ξ)`
  obtain ⟨η₀, hη₀, hLD₀⟩ := hLD
  have hdens := hLD₀ Γ μ ξ hΓb (fun K hK => hμK K hK (subset_univ K)) hμW hξ (ae_of_all μ hξb)
    hΓξ hΓisp
  -- Step 3: `μ = θHⁿ⌞M` and `Γ = ∫_M θ⟨·, ζ⟩ dHⁿ`, with `∫_M θ dHⁿ = μ(ℝᴾ) < ∞`
  obtain ⟨M, θ, ζ, hM, hMfin, hθ, hζ, hμM, hθpos, hζb, hζ1, hΓM, hMdens⟩ :=
