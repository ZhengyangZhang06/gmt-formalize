              (W.starProjection (EuclideanSpace.single i 1)))
              (W.starProjection (EuclideanSpace.single j 1)) ^ 2) := by
    intro W τ D Φ g ρ hDW hDsym hDlast hΦsym₁ hΦsym₂ hΦlast hg
