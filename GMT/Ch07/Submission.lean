        _ < R := by linarith
    have hU : IsOpen ((fun w => x + w) ⁻¹' ball x₀ R) :=
      isOpen_ball.preimage (continuous_const.add continuous_id)
    have hclU : closedBall (0 : Euclid m) (R / 2) ⊆ (fun w => x + w) ⁻¹' ball x₀ R :=
      fun v hv => hxB v hv
