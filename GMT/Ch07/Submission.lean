            linarith
  · -- large radii `R/16 < r ≤ R`: compare with `B_R(x₀)` directly
    have h16r : 1 ≤ 16 * (r / R) := by
      rw [mul_div_assoc', le_div_iff₀ hR]
      linarith
    have hpow : ∀ p : ℕ, 1 ≤ (16 : ℝ) ^ p * (r / R) ^ p := fun p => by
      rw [← mul_pow]
      exact one_le_pow₀ h16r
    constructor
    · have hP : 0 ≤ ∫ x in ball x₀ R, ∑ j : Fin m,
