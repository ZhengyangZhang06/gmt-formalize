    · -- Step 6 with `e_l = EuclideanSpace.single l 1`
      have hv : (fun k => EuclideanSpace.single (ι (j.succAbove k)) (1 : ℝ)) =
          fun k => EuclideanSpace.basisFun (Fin P) ℝ (J j k) := by
        funext k
        rw [EuclideanSpace.basisFun_apply, hJ]
      rw [hv]
      exact hface c j
