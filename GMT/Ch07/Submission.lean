          ext y
          constructor
          · rintro ⟨x, hx, t, ht, rfl⟩
            exact ⟨(t, x), ⟨ht, hx⟩, rfl⟩
          · rintro ⟨⟨t, x⟩, ⟨ht, hx⟩, rfl⟩
