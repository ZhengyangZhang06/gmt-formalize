  obtain ⟨hFcone, hFH⟩ := Submission.dorag_lip_graph_cone_hausdorff_bound n k T₀ ι ι' ξ f _ hιι'
    hproj hΛ0 (hΛL.trans hL1) hfLip
  -- (f) the off-support estimate (10') at the points of `(F ∖ spt μ) ∩ B_{σ₀/4}(ξ)`
  have hκσ₀ : κ * σ₀ ≤ 1 := by
