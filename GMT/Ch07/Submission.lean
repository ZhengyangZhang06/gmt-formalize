  have hdistW : ∀ j, ∀ x ∈ (O j - O (j + 1)).support,
      dist (φ j x) ((fun x : Euclid P => x) x) ≤ Real.sqrt P := by
    intro j x hx
    have hx' := (hsuppW j hx).2
    rw [hφψ j x hx']
    exact hψd x (lt_of_lt_of_le (hr0 j) hx')
  have hdistD : ∀ j, ∀ x ∈ (D j).support,
