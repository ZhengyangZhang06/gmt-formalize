      choose KF hKF using hFL
      -- a.e. on `Bp i`, the tangent plane `range DFp i` contains `L`
      have hgood : ∀ i, ∃ G : Set V, MeasurableSet G ∧ G ⊆ Bp i ∧ volume (Bp i \ G) = 0 ∧
