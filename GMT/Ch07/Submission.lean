      (fun ω p => (ω : DifferentialForm (Euclid P) 0) p (fun i => i.elim0))
      (fun ω => T.restrictDomain hBU ω) (isCompact_closedBall x₀ (ε / 2))
      (fun j l hl => ball_subset_closedBall (hxB j l hl)) hw0 hwC hcont hlim
