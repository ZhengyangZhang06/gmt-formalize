    rw [← sk_tsum_geometric _ _ hc0]
    exact ENNReal.tsum_le_tsum hEb
  -- the remainders tend to `0`: `M(Oₙ) → 0`, `M(H(φₙ, id)Zₙ) → 0`, `M(φₙ#Zₙ) → 0`
  have hOlim : Tendsto (fun N => (O N).mass) atTop (𝓝 0) := by
