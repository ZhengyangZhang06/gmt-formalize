      (ENNReal.ofReal_add_le.trans (add_le_add (A.le_massOn hω) h2))
  -- `c_B` from the cube BV median lemma and `c := max(2, 1 + c_B)`
  obtain ⟨cB, hcB, hmedian⟩ := Submission.dtc_bc_lc_fd_dfm_cube_bv_median m
  refine ⟨Real.toNNReal (max 2 (1 + cB)),
    Real.one_le_toNNReal.2 (le_max_of_le_left one_le_two), fun K Λ hK => ?_⟩
  -- `𝒬₀`: the integer chains `Σ β_F [[F]]` on faces meeting `K` with `Σ|β_F| ≤ 2Λ`
  refine ⟨_, cmcdtfr_finite_family P (m + 1) K (2 * (Λ : ℝ)) hK, ?_⟩
  intro Q₀ hQ₀ hQ₀K hQ₀L hQ₀Λ hQ₀b
  -- `Q₀ = Σ_F ũ_F [[F̆]]` over the open faces `F̆` meeting `spt Q₀`
  obtain ⟨s, u, hs, huZ, huI, hSu, huspt, hQ₀rep⟩ :=
    cmcdtfr_skeleton_decomposition P m K Q₀ hK hQ₀ hQ₀K hQ₀L
  -- the variations `V_F` of the `ũ_F`, with `Σ_F V_F ≤ M(∂Q₀)`
  obtain ⟨V, hV0, hSV, hVbd, hVspt⟩ :=
    cmcdtfr_boundary_variation P m s u Q₀ hs huI hQ₀rep hQ₀b
  -- integer medians `β_F` of the `ũ_F` (`cube_bv_median`)
  choose! β hβ using fun p (hp : p ∈ s) => hmedian (u p) (V p) (huZ p hp) (huI p hp) (hVbd p hp)
  -- the face currents with densities `β_F` (this is `Pc`), `ũ_F` and `ũ_F − β_F`
  have hcube := cmcdtfrfg_cube_volume (m + 1)
  have hβI : ∀ p ∈ s, IntegrableOn (fun _ : Euclid (m + 1) => (β p : ℝ))
      {y | ∀ i, 0 < y i ∧ y i < 1} (volume : Measure (Euclid (m + 1))) := fun p _ =>
    integrableOn_const (hcube.trans_ne ENNReal.one_ne_top) enorm_ne_top
  -- `Pc = Σ_F β_F [[F]]`: the current of the integer multiplicity triple of `Σ_F β_F [[F]]`
  obtain ⟨RP, hRPact, hRPind⟩ := dfmf_chain_imrep P (m + 1) s β hs
  obtain ⟨Pc, hPc⟩ := Submission.dtc_imrep_current P (m + 1) univ RP
  have hPcrep := fun ω => (hPc ω).trans (hRPact ω)
  -- the face currents with densities `β_F`, `ũ_F` and `ũ_F − β_F`
  have hβD := cmcdtfr_face_integral_current P m s (fun p _ => (β p : ℝ)) hs hβI
  have huω := (cmcdtfr_face_integral_current P m s u hs huI).1
  have hdD := (cmcdtfr_face_integral_current P m s
    (fun p y => u p y - (β p : ℝ)) hs fun p hp => (huI p hp).sub (hβI p hp)).2
  -- `Pc = 0`, or some `β_F ≠ 0` and `M(Pc) = μ_RP(ℝᴾ) ≥ 1` by (MR) (`dfmf_chain_mass_ge`)
  have hPc01 : Pc = 0 ∨ 1 ≤ Pc.mass := by
    by_cases h : ∃ q ∈ s, β q ≠ 0
    · obtain ⟨q, hq, hβq⟩ := h
      exact Or.inr ((dfmf_chain_mass_ge P (m + 1) s β RP hs hRPind q hq hβq).trans_eq
        (hMR P (m + 1) univ Pc RP isOpen_univ hPc univ isOpen_univ).symm)
    · refine Or.inl (GeometricCurrentOn.ext fun ω => ?_)
      rw [hPcrep ω, GeometricCurrentOn.zero_apply]
      refine Finset.sum_eq_zero fun p hp => ?_
      rw [show β p = 0 from not_not.1 fun hβ => h ⟨p, hp, hβ⟩, Int.cast_zero, zero_mul]
  -- integrality of `∂Pc` (cubical Stokes)
  obtain ⟨s', β', hs', hPcbrep⟩ := cmcdtfr_chain_boundary P m s β Pc hs hPcrep
  obtain ⟨RB, hRBact, -⟩ := dfmf_chain_imrep P m s' β' hs'
  have hPcbIM : IsIntegerMultiplicity Pc.boundary :=
    ⟨RB, fun γ => (hPcbrep γ).trans (hRBact γ).symm⟩
  -- mass and support bounds for `Pc` and `Q₀ − Pc` from their face densities
  have hPcD := hβD.2 Pc fun ω =>
    (hPcrep ω).trans (Finset.sum_congr rfl fun p _ => (integral_const_mul _ _).symm)
  -- `M(Pc) ≤ Σ_F ∫_{Q₁} |β_F| = Σ_F |β_F|`
  have hPcmass : Pc.mass ≤ ENNReal.ofReal (∑ p ∈ s, |(β p : ℝ)|) := by
    refine hPcD.1.trans_eq (congrArg ENNReal.ofReal (Finset.sum_congr rfl fun p _ => ?_))
    rw [setIntegral_const, measureReal_def, hcube, ENNReal.toReal_one, one_smul]
  -- `Q₀ − Pc = Σ_F (ũ_F − β_F) [[F̆]]`
  have hdD' := hdD (Q₀ - Pc) fun ω => by
    show Q₀ ω - Pc ω = _
    rw [hQ₀rep ω, hPcrep ω, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun p hp => ?_
    rw [← integral_const_mul, ← integral_sub (huω ω p hp) (hβD.1 ω p hp)]
    exact integral_congr_ae (ae_of_all _ fun y => (sub_mul _ _ _).symm)
  have hdb := hdD'.2.1 (fun p => cB * V p) fun p hp G hG hG1 => (hβ p hp).2.2 G hG hG1
  -- `Σ|β_F| ≤ 2 Σ_F ∫|ũ_F| ≤ 2Λ`, `Σ_F ∫|ũ_F − β_F| ≤ c_B Σ_F V_F`
  have hβsum : ∑ p ∈ s, |(β p : ℝ)| ≤
      2 * ∑ p ∈ s, ∫ y : Euclid (m + 1) in {y | ∀ i, 0 < y i ∧ y i < 1}, |u p y| := by
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum fun p hp => (hβ p hp).2.1
  have hSuΛ : ∑ p ∈ s, ∫ y : Euclid (m + 1) in {y | ∀ i, 0 < y i ∧ y i < 1}, |u p y| ≤
      (Λ : ℝ) := by
    have h := hSu.trans hQ₀Λ
    rw [← ENNReal.ofReal_coe_nnreal] at h
    exact (ENNReal.ofReal_le_ofReal_iff Λ.coe_nonneg).1 h
  have hdsum : ∑ p ∈ s, ∫ y : Euclid (m + 1) in {y | ∀ i, 0 < y i ∧ y i < 1},
      |u p y - (β p : ℝ)| ≤ cB * ∑ p ∈ s, V p := by
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum fun p hp => (hβ p hp).1
  have hdb' : (Q₀ - Pc).boundary.mass ≤ ENNReal.ofReal cB * Q₀.boundary.mass := by
    calc (Q₀ - Pc).boundary.mass ≤ ENNReal.ofReal (∑ p ∈ s, cB * V p) := hdb
      _ = ENNReal.ofReal cB * ENNReal.ofReal (∑ p ∈ s, V p) := by
          rw [← Finset.mul_sum, ENNReal.ofReal_mul hcB.le]
      _ ≤ ENNReal.ofReal cB * Q₀.boundary.mass := mul_le_mul' le_rfl hSV
  -- `∂Pc = ∂Q₀ − ∂(Q₀ − Pc)`
  have hPcb_eq : Pc.boundary = Q₀.boundary - (Q₀ - Pc).boundary :=
    GeometricCurrentOn.ext fun γ => (sub_sub_cancel _ _).symm
  -- supports: a face carrying `Pc` meets `spt Q₀`, a face carrying `Q₀ − Pc` meets `spt ∂Q₀`
  -- (there `V_F ≠ 0`), and a face has diameter `≤ √P`
  have hdiam := fun p (hp : p ∈ s) =>
    ((cmcdtfr_face_geometry P (m + 1)).2 p p (hs p hp) (hs p hp)).2.1
  have hPcsupp : Pc.support ⊆ cthickening (Real.sqrt P) Q₀.support := by
    intro x hx
    obtain ⟨p, hp, -, y, hy, rfl⟩ := hPcD.2.2 x hx
    obtain ⟨y', hy', hy'Q⟩ := huspt p hp
    exact mem_cthickening_of_dist_le _ _ _ _ hy'Q (hdiam p hp y y' hy hy')
  have hdsupp : (Q₀ - Pc).support ⊆ cthickening (Real.sqrt P) Q₀.boundary.support := by
    intro x hx
    obtain ⟨p, hp, hne, y, hy, rfl⟩ := hdD'.2.2 x hx
    have hVp : V p ≠ 0 := fun h0 => hne (le_antisymm ((hβ p hp).1.trans_eq
      (by rw [h0, mul_zero])) (integral_nonneg fun y => abs_nonneg _))
    obtain ⟨y', hy', hy'Q⟩ := hVspt p hp hVp
    exact mem_cthickening_of_dist_le _ _ _ _ hy'Q (hdiam p hp y y' hy hy')
  have hPcbsupp : Pc.boundary.support ⊆ cthickening (Real.sqrt P) Q₀.boundary.support := by
    intro x hx
    rw [hPcb_eq] at hx
    rcases hspt_sub _ _ hx with h | h
    · exact self_subset_cthickening _ h
    · exact hdsupp (dfmf_support_boundary_subset P m _ h)
  refine ⟨Pc, ?_, ⟨RP, hPc⟩, hPcbIM, hPc01, ?_, ?_, ?_, hPcsupp, union_subset hdsupp hPcbsupp⟩
  · -- `Pc ∈ 𝒬₀`
    rw [Set.mem_ofPred_eq]
    refine ⟨s, β, hs, fun p hp => ?_, hβsum.trans (mul_le_mul_of_nonneg_left hSuΛ zero_le_two),
      hPcrep⟩
    obtain ⟨y, hy, hyQ⟩ := huspt p hp
    exact ⟨y, hy, hQ₀K hyQ⟩
  · -- `M(Pc) ≤ Σ|β_F| ≤ 2M(Q₀)`
    show Pc.mass ≤ ENNReal.ofReal (max 2 (1 + cB)) * Q₀.mass
    calc Pc.mass ≤ ENNReal.ofReal (∑ p ∈ s, |(β p : ℝ)|) := hPcmass
      _ ≤ ENNReal.ofReal (2 * _) := ENNReal.ofReal_le_ofReal hβsum
      _ = ENNReal.ofReal 2 * ENNReal.ofReal _ := ENNReal.ofReal_mul zero_le_two
      _ ≤ ENNReal.ofReal (max 2 (1 + cB)) * Q₀.mass :=
          mul_le_mul' (ENNReal.ofReal_le_ofReal (le_max_left _ _)) hSu
  · -- `M(∂Pc) ≤ M(∂Q₀) + M(∂(Q₀ − Pc)) ≤ (1 + c_B)M(∂Q₀)`
    show Pc.boundary.mass ≤ ENNReal.ofReal (max 2 (1 + cB)) * Q₀.boundary.mass
    rw [hPcb_eq]
    calc _ ≤ Q₀.boundary.mass + ENNReal.ofReal cB * Q₀.boundary.mass :=
          (hmass_sub _ _).trans (add_le_add le_rfl hdb')
      _ = ENNReal.ofReal (1 + cB) * Q₀.boundary.mass := by
          rw [ENNReal.ofReal_add zero_le_one hcB.le, ENNReal.ofReal_one, add_mul, one_mul]
      _ ≤ _ := mul_le_mul' (ENNReal.ofReal_le_ofReal (le_max_right _ _)) le_rfl
  · -- `M(Q₀ − Pc) ≤ Σ_F ∫|ũ_F − β_F| ≤ c_B M(∂Q₀)`
    show (Q₀ - Pc).mass ≤ ENNReal.ofReal (max 2 (1 + cB)) * Q₀.boundary.mass
    calc (Q₀ - Pc).mass ≤ ENNReal.ofReal _ := hdD'.1
      _ ≤ ENNReal.ofReal (cB * ∑ p ∈ s, V p) := ENNReal.ofReal_le_ofReal hdsum
      _ = ENNReal.ofReal cB * ENNReal.ofReal (∑ p ∈ s, V p) := ENNReal.ofReal_mul hcB.le
      _ ≤ ENNReal.ofReal (max 2 (1 + cB)) * Q₀.boundary.mass :=
          mul_le_mul' (ENNReal.ofReal_le_ofReal
            ((le_add_of_nonneg_left zero_le_one).trans (le_max_right _ _))) hSV
/-- **Integer multiplicity is local** (Simon Ch. 6, 3.1 and 6.3.1; localization remark 8.3(1)).
Assume (IMC)(a).  Let `X(ω) = ∫ ⟨ω, ξ⟩ dμ` for `ω ∈ 𝒟ᵏ(U)`, where `μ(ℝᴾ \ U) = 0`, `μ` is finite
on compact subsets of `U` and `ξ` is `μ`-measurable.  If each `x ∈ U` has an open neighbourhood
`W ⊆ U` with an integer multiplicity triple `R = (M, θ, ξ_R)` in `W` such that `μ⌞W = θHᵏ⌞M` and
`ξ = ξ_R` `μ`-a.e. on `W`, then `X` is integer multiplicity.  By Lindelöf, countably many such
`Wᵢ` cover `U`, and there are disjoint Borel pieces `Aᵢ ⊆ Wᵢ` covering `U`; then
`μ⌞Aᵢ = (θᵢHᵏ⌞Mᵢ)⌞Aᵢ`, and `ξ = ξᵢ` `Hᵏ`-a.e. on `Mᵢ ∩ Aᵢ` because `Hᵏ⌞Mᵢ ≪ θᵢHᵏ⌞Mᵢ`.  Gluing
the `Rᵢ` along the `Aᵢ` gives a triple in `U` with orientation `ξ` and weight `μ`, and it
represents `X`. -/
theorem Submission.cbr_isIntegerMultiplicity_of_local_reps : (∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) → ∀ (P k : ℕ) (U : Set (Euclid P)) (X : GeometricCurrentOn U k) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P k), IsOpen U → μ Uᶜ = 0 → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → AEStronglyMeasurable ξ μ → (∀ ω : TestFormOn U k, X ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ) → (∀ x ∈ U, ∃ (W : Set (Euclid P)) (R : IMRep W k), IsOpen W ∧ x ∈ W ∧ W ⊆ U ∧ μ.restrict W = R.measure ∧ ∀ᵐ y ∂μ, y ∈ W → ξ y = R.orient y) → IsIntegerMultiplicity X := by
  intro hIMC P k U X μ ξ hU hμU hμK hξ hX hloc
  -- Step 1: countably many neighbourhoods `Wᵢ` carrying local triples `Rᵢ`, and disjoint Borel
  -- pieces `Aᵢ ⊆ Wᵢ` covering `U` (Lindelöf)
  obtain ⟨ι, _, W, A, hWo, hWU, hpW, hAm, hAW, hAd, hAU⟩ :=
    Submission.cbrg_exists_countable_disjoint_refinement P U
      (fun W => ∃ R : IMRep W k, μ.restrict W = R.measure ∧ ∀ᵐ y ∂μ, y ∈ W → ξ y = R.orient y)
      fun x hx => by
        obtain ⟨W, R, hWo, hxW, hWU, hRμ, hRξ⟩ := hloc x hx
        exact ⟨W, hWo, hxW, hWU, R, hRμ, hRξ⟩
  choose R hRμ hRξ using hpW
  -- Step 2: `ξ = ξᵢ` holds `μ⌞Wᵢ`-a.e., i.e. `θᵢHᵏ⌞Mᵢ`-a.e., hence `Hᵏ⌞Mᵢ`-a.e. and so
  -- `Hᵏ`-a.e. on `Mᵢ ∩ Aᵢ`
  have hξR : ∀ i, ∀ᵐ y ∂(μHE[k].restrict ((R i).carrier ∩ A i)), ξ y = (R i).orient y := by
    intro i
    have h : ∀ᵐ y ∂(R i).measure, ξ y = (R i).orient y := by
      rw [← hRμ i, ae_restrict_iff' (hWo i).measurableSet]
      exact hRξ i
    exact ae_restrict_of_ae_restrict_of_subset inter_subset_left
      ((Submission.cbr_imRep_measure_basic P k (W i) (R i)).2.1.ae_le h)
  -- Step 3: glue the `Rᵢ` along the `Aᵢ`; `μ⌞Aᵢ = (μ⌞Wᵢ)⌞Aᵢ = (θᵢHᵏ⌞Mᵢ)⌞Aᵢ` as `Aᵢ ⊆ Wᵢ`
  obtain ⟨R', -, hR'o, hR'μ⟩ := Submission.cbrg_imRep_glue_disjoint hIMC ι P k U W A R μ ξ hU
    hWo hWU hAm hAd (by rw [hAU]; exact hμU)
    (fun i => by rw [← Measure.restrict_restrict_of_subset (μ := μ) (hAW i), hRμ i]) hμK hξ hξR
  -- Step 4: the glued triple represents `X`: `R'.action ω = ∫ ⟨ω, ξ⟩ dμ = X(ω)`
  refine ⟨R', fun ω => ?_⟩
  rw [hX ω, (Submission.cbr_imRep_measure_basic P k U R').2.2.2.2.2.2, hR'o, hR'μ]
/-- **Pairing of `u − u ∗ φ` with a test function, for `u` of bounded variation** (Claim A of the
`BV` mollifier estimate; mollification of `BV` functions as in Simon, Ch. 2, §2).  Let `φ ≥ 0` be
smooth with `tsupport φ ⊆ B_s(0)` and `∫ φ = 1`, let `u` be integrable on `B_{2R}(0)` with
`|∫_{B_{2R}(0)} u(y) Df(y)(z) dy| ≤ V‖z‖M` for all smooth `f` with compact support in `B_{2R}(0)`
and `|f| ≤ M`, and let `2s < R`.  If `g` is smooth with compact support in `B_{R+s}(0)` and
`|g| ≤ 1`, then `|∫ (u − w) g| ≤ sV`, where `w(x) = ∫_{B_{2R}(0)} u(y) φ(x − y) dy`.  By Fubini,
`∫ (u − w) g = ∫ φ(z) I(z) dz` with `I(z) = ∫_{B_{2R}(0)} u(y) (g(y) − g(y + z)) dy`; if
`φ(z) ≠ 0` then `‖z‖ < s < R − s`, so `g` and its translate by `z` are supported in `B_{2R}(0)` and
the translation estimate gives `|I(z)| ≤ V‖z‖ ≤ sV`; integrate against `φ`. -/
theorem Submission.cbr_ci_pw_bv_smooth_test_bound : ∀ (n : ℕ) (R s V : ℝ) (φ u g : Euclid n → ℝ), 0 < R → 0 < s → 2 * s < R → 0 ≤ V → ContDiff ℝ (⊤ : ℕ∞) φ → (∀ y, 0 ≤ φ y) → tsupport φ ⊆ ball 0 s → ∫ y, φ y = 1 → IntegrableOn u (ball 0 (2 * R)) → (∀ (f : Euclid n → ℝ) (z : Euclid n) (M : ℝ), ContDiff ℝ (⊤ : ℕ∞) f → HasCompactSupport f → tsupport f ⊆ ball 0 (2 * R) → (∀ y, |f y| ≤ M) → |∫ y in ball 0 (2 * R), u y * fderiv ℝ f y z| ≤ V * ‖z‖ * M) → ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ ball 0 (R + s) → (∀ x, |g x| ≤ 1) → |∫ x, (u x - ∫ y in ball 0 (2 * R), u y * φ (x - y)) * g x| ≤ s * V := by
  intro n R s V φ u g _hR hs h2s hV hφ hφ0 hφs hφ1 hu hvar hg hgc hgs hgb
  -- `φ` has compact support, and `g` vanishes off `B_{2R}(0)` since `R + s ≤ 2R`
  have hφc : HasCompactSupport φ :=
    (isCompact_closedBall (0 : Euclid n) s).of_isClosed_subset (isClosed_tsupport φ)
      (hφs.trans ball_subset_closedBall)
  have hgS : ∀ x, x ∉ ball (0 : Euclid n) (2 * R) → g x = 0 := fun x hx =>
    image_eq_zero_of_notMem_tsupport fun hx' => hx (ball_subset_ball (by linarith) (hgs hx'))
  -- Fubini: `∫ (u - w) g = ∫ φ(z) ∫_{B_{2R}(0)} u(y) (g(y) - g(y + z)) dy dz`
  rw [Submission.cbr_ci_pw_bv_pairing_identity n (ball 0 (2 * R)) φ u g measurableSet_ball
    hφ.continuous hφc hφ1 hu hg.continuous hgc hgS]
  -- `|φ(z) I(z)| ≤ φ(z) sV`: trivial if `φ(z) = 0`, else `‖z‖ < s` and translate by `z`
  have hbound : ∀ z, ‖φ z * ∫ y in ball (0 : Euclid n) (2 * R), u y * (g y - g (y + z))‖ ≤
      φ z * (s * V) := by
    intro z
    by_cases hz : φ z = 0
    · simp [hz]
    have hzs : ‖z‖ < s := mem_ball_zero_iff.1 (hφs (subset_tsupport φ hz))
    have hT := Submission.cbr_ci_pw_bv_translate_test n (2 * R) V 1 u g z hu hvar hg hgc
      (hgs.trans (ball_subset_ball (by linarith))) hgb
    have hneg : ∫ y in ball (0 : Euclid n) (2 * R), u y * (g y - g (y + z)) =
        -∫ y in ball (0 : Euclid n) (2 * R), u y * (g (y + z) - g y) := by
      rw [← integral_neg]; congr 1; funext y; ring
    rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (hφ0 z), hneg, abs_neg]
    refine mul_le_mul_of_nonneg_left (hT.trans ?_) (hφ0 z)
    linarith [mul_le_mul_of_nonneg_left hzs.le hV]
  -- integrate against `φ`, using `∫ φ = 1`
  have hφi : Integrable φ := hφ.continuous.integrable_of_hasCompactSupport hφc
  calc |∫ z, φ z * ∫ y in ball (0 : Euclid n) (2 * R), u y * (g y - g (y + z))|
      = ‖∫ z, φ z * ∫ y in ball (0 : Euclid n) (2 * R), u y * (g y - g (y + z))‖ :=
        (Real.norm_eq_abs _).symm
    _ ≤ ∫ z, φ z * (s * V) :=
        norm_integral_le_of_norm_le (hφi.mul_const _) (Eventually.of_forall hbound)
    _ = s * V := by rw [integral_mul_const, hφ1, one_mul]
/-- **Smooth a.e. approximation of a bounded function supported in a ball** (mollification; cf.
Evans, *PDE*, App. C, Thm. 7).  If `g₀ : ℝⁿ → ℝ` is measurable, `|g₀| ≤ 1` and `g₀ = 0` off
`B_R(0)`, let `ρ = b / ∫ b` for the `ContDiffBump` `b` with radii `1/4, 1/2`,
`ψ_ε(x) = ε⁻ⁿ ρ(ε⁻¹ x)` and `θ_j = δ / (j + 2)`.  Then `G_j = g₀ ⋆ ψ_{θ_j}` is `C^∞`, vanishes
off `B̄_{R + θ_j/2}(0) ⊆ B_{R+δ}(0)`, satisfies `|G_j| ≤ ∫ ψ_{θ_j} = 1`, and `G_j(x) → g₀(x)` at
every Lebesgue point `x` of `g₀` (approximate identity with `|ψ_{θ_j}| ≤ C / Lⁿ(B_{θ_j}(x))`),
hence for `Lⁿ`-a.e. `x`. -/
theorem Submission.cbr_ci_pw_bv_smooth_ae_approx : ∀ (n : ℕ) (R δ : ℝ) (g₀ : Euclid n → ℝ), 0 < δ → Measurable g₀ → (∀ x, |g₀ x| ≤ 1) → (∀ x, R ≤ ‖x‖ → g₀ x = 0) → ∃ G : ℕ → Euclid n → ℝ, (∀ j, ContDiff ℝ (⊤ : ℕ∞) (G j)) ∧ (∀ j, HasCompactSupport (G j)) ∧ (∀ j, tsupport (G j) ⊆ ball 0 (R + δ)) ∧ (∀ j x, |G j x| ≤ 1) ∧ ∀ᵐ x ∂(volume : Measure (Euclid n)), Tendsto (fun j => G j x) atTop (𝓝 (g₀ x)) := by
  intro n R δ g₀ hδ hg₀m hg₀b hg₀z
  -- Step 0: g₀ is integrable
  have hg₀out : ∀ x, x ∉ ball (0 : Euclid n) R → g₀ x = 0 := fun x hx =>
    hg₀z x (by simpa [mem_ball_zero_iff] using hx)
  have hg₀i : Integrable g₀ := by
    have hon : IntegrableOn g₀ (ball (0 : Euclid n) R) :=
      Measure.integrableOn_of_bounded (M := 1) measure_ball_lt_top.ne hg₀m.aestronglyMeasurable
        (Eventually.of_forall fun x => by rw [Real.norm_eq_abs]; exact hg₀b x)
    exact (integrableOn_iff_integrable_of_support_subset
      (fun x hx => by by_contra h; exact hx (hg₀out x h))).1 hon
  -- Step 1: a normalized bump
  let b : ContDiffBump (0 : Euclid n) := ⟨1 / 4, 1 / 2, by norm_num, by norm_num⟩
  have hbi : Integrable (b : Euclid n → ℝ) := b.continuous.integrable_of_hasCompactSupport b.hasCompactSupport
  set I : ℝ := ∫ x, b x with hIdef
  have hI : 0 < I := by
    rw [hIdef, integral_pos_iff_support_of_nonneg (fun x => b.nonneg) hbi, b.support_eq]
    exact measure_ball_pos _ _ (by norm_num)
  set ρ : Euclid n → ℝ := fun x => b x / I with hρdef
  have hρc : ContDiff ℝ (⊤ : ℕ∞) ρ := b.contDiff.div_const I
  have hρ0 : ∀ x, 0 ≤ ρ x := fun x => div_nonneg b.nonneg hI.le
  have hρb : ∀ x, ρ x ≤ 1 / I := fun x => div_le_div_of_nonneg_right b.le_one hI.le
  have hρz : ∀ x, (1 / 2 : ℝ) ≤ ‖x‖ → ρ x = 0 := by
    intro x hx
    have : x ∉ support (b : Euclid n → ℝ) := by
      rw [b.support_eq, mem_ball_zero_iff]; exact not_lt.2 hx
    simp [hρdef, notMem_support.1 this]
  have hρ1 : ∫ x, ρ x = 1 := by
    simp only [hρdef]; rw [integral_div, ← hIdef, div_self hI.ne']
  -- Step 2: rescaled mollifiers
  set ψ : ℝ → Euclid n → ℝ := fun ε x => (ε ^ n)⁻¹ * ρ (ε⁻¹ • x) with hψdef
  have hψc : ∀ ε, ContDiff ℝ (⊤ : ℕ∞) (ψ ε) := fun ε =>
    contDiff_const.mul (hρc.comp (contDiff_const_smul ε⁻¹))
  have hψ0 : ∀ ε, 0 < ε → ∀ x, 0 ≤ ψ ε x := fun ε hε x =>
    mul_nonneg (inv_nonneg.2 (pow_nonneg hε.le n)) (hρ0 _)
  have hψz : ∀ ε, 0 < ε → ∀ x, ε / 2 ≤ ‖x‖ → ψ ε x = 0 := by
    intro ε hε x hx
    have : (1 / 2 : ℝ) ≤ ‖ε⁻¹ • x‖ := by
      rw [norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hε]
      rw [le_inv_mul_iff₀ hε]; linarith
    simp [hψdef, hρz _ this]
  have hψb : ∀ ε, 0 < ε → ∀ x, |ψ ε x| ≤ (1 / I) / ε ^ n := by
    intro ε hε x
    rw [abs_of_nonneg (hψ0 ε hε x), hψdef]
    simp only
    rw [div_eq_inv_mul]
    exact mul_le_mul_of_nonneg_left (hρb _) (inv_nonneg.2 (pow_nonneg hε.le n))
  have hψ1 : ∀ ε, 0 < ε → ∫ x, ψ ε x = 1 := by
    intro ε hε
    simp only [hψdef]
    rw [integral_const_mul, Measure.integral_comp_inv_smul_of_nonneg _ _ hε.le,
      finrank_euclideanSpace_fin, hρ1, smul_eq_mul, mul_one, inv_mul_cancel₀ (pow_ne_zero n hε.ne')]
  have hψcs : ∀ ε, 0 < ε → HasCompactSupport (ψ ε) := by
    intro ε hε
    refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid n) ε) fun x hx => ?_
    rw [mem_closedBall_zero_iff, not_le] at hx
    exact hψz ε hε x (by linarith)
  -- Step 3: the sequence
  set θ : ℕ → ℝ := fun j => δ / ((j : ℝ) + 2) with hθdef
  have hθpos : ∀ j, 0 < θ j := fun j => div_pos hδ (by positivity)
  have hθlt : ∀ j, θ j < δ := fun j => by
    rw [hθdef]; simp only
    rw [div_lt_iff₀ (by positivity)]; nlinarith [(Nat.cast_nonneg j : (0 : ℝ) ≤ j)]
  have hG : ∀ j x, convolution g₀ (ψ (θ j)) (ContinuousLinearMap.lsmul ℝ ℝ) volume x
      = ∫ y, g₀ y * ψ (θ j) (x - y) := by
    intro j x
    rw [convolution_def]
    simp only [ContinuousLinearMap.lsmul_apply, smul_eq_mul]
  have hvan : ∀ j x, R + θ j / 2 ≤ ‖x‖ →
      convolution g₀ (ψ (θ j)) (ContinuousLinearMap.lsmul ℝ ℝ) volume x = 0 := by
    intro j x hx
    rw [hG]
    have : (fun y => g₀ y * ψ (θ j) (x - y)) = fun _ => 0 := by
      funext y
      by_cases hy : R ≤ ‖y‖
      · rw [hg₀z y hy, zero_mul]
      · push Not at hy
        have h1 : θ j / 2 ≤ ‖x - y‖ := by
          have := norm_sub_norm_le x y
          linarith
        rw [hψz (θ j) (hθpos j) _ h1, mul_zero]
    rw [this, integral_zero]
  have hsupp : ∀ j, support (convolution g₀ (ψ (θ j)) (ContinuousLinearMap.lsmul ℝ ℝ) volume)
      ⊆ closedBall 0 (R + θ j / 2) := by
    intro j x hx
    rw [mem_closedBall_zero_iff]
    by_contra h
    exact hx (hvan j x (not_le.1 h).le)
  refine ⟨fun j => convolution g₀ (ψ (θ j)) (ContinuousLinearMap.lsmul ℝ ℝ) volume, ?_, ?_, ?_, ?_, ?_⟩
  · intro j
    exact (hψcs (θ j) (hθpos j)).contDiff_convolution_right (ContinuousLinearMap.lsmul ℝ ℝ)
      hg₀i.locallyIntegrable (hψc (θ j))
  · intro j
    exact HasCompactSupport.of_support_subset_isCompact (isCompact_closedBall _ _) (hsupp j)
  · intro j
    refine (closure_minimal (hsupp j) isClosed_closedBall).trans (closedBall_subset_ball ?_)
    linarith [hθlt j, hθpos j]
  · intro j x
    simp only
    rw [hG]
    have hψi : Integrable (ψ (θ j)) :=
      (hψc (θ j)).continuous.integrable_of_hasCompactSupport (hψcs (θ j) (hθpos j))
    calc |∫ y, g₀ y * ψ (θ j) (x - y)| ≤ ∫ y, |g₀ y * ψ (θ j) (x - y)| := abs_integral_le_integral_abs
      _ ≤ ∫ y, ψ (θ j) (x - y) := by
          refine integral_mono_of_nonneg (Eventually.of_forall fun y => abs_nonneg _)
            (hψi.comp_sub_left x) (Eventually.of_forall fun y => ?_)
          show |g₀ y * ψ (θ j) (x - y)| ≤ ψ (θ j) (x - y)
          rw [abs_mul, abs_of_nonneg (hψ0 _ (hθpos j) _)]
          exact mul_le_of_le_one_left (hψ0 _ (hθpos j) _) (hg₀b y)
      _ = 1 := by rw [integral_sub_left_eq_self, hψ1 _ (hθpos j)]
  · have hleb := IsUnifLocDoublingMeasure.ae_tendsto_average_norm_sub
      (μ := (volume : Measure (Euclid n))) hg₀i.locallyIntegrable 1
    filter_upwards [hleb] with x hx
    have hθ0 : Tendsto θ atTop (𝓝 0) := by
      have : Tendsto (fun j : ℕ => ((j : ℝ) + 2)) atTop atTop :=
        tendsto_atTop_add_const_right _ _ tendsto_natCast_atTop_atTop
      simpa [hθdef] using this.const_div_atTop δ
    have hθ : Tendsto θ atTop (𝓝[>] 0) :=
      tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ hθ0
        (Eventually.of_forall fun j => hθpos j)
    have havg := hx (fun _ => x) θ hθ
      (Eventually.of_forall fun j => mem_closedBall_self (by simpa using (hθpos j).le))
    have hB1 : 0 < (volume : Measure (Euclid n)).real (closedBall 0 1) := by
      rw [measureReal_def]
      exact ENNReal.toReal_pos (measure_closedBall_pos _ _ one_pos).ne' measure_closedBall_lt_top.ne
    have key := tendsto_integral_smul_of_tendsto_average_norm_sub
      (μ := (volume : Measure (Euclid n))) (f := g₀) (c := g₀ x)
      (a := fun j => closedBall x (θ j)) (g := fun j y => ψ (θ j) (x - y))
      ((1 / I) * (volume : Measure (Euclid n)).real (closedBall 0 1)) havg
      (Eventually.of_forall fun j => hg₀i.integrableOn)
      (by
        refine tendsto_const_nhds.congr' (Eventually.of_forall fun j => ?_)
        simp only
        rw [integral_sub_left_eq_self, hψ1 _ (hθpos j)])
      (Eventually.of_forall fun j y hy => by
        rw [mem_closedBall, dist_comm, dist_eq_norm]
        by_contra h
        exact hy (hψz _ (hθpos j) _ (by linarith [hθpos j])))
      (Eventually.of_forall fun j y => by
        rw [Measure.addHaar_real_closedBall' _ _ (hθpos j).le, finrank_euclideanSpace_fin]
        have hpow : 0 < θ j ^ n := pow_pos (hθpos j) n
        calc |ψ (θ j) (x - y)| ≤ (1 / I) / θ j ^ n := hψb _ (hθpos j) _
          _ = (1 / I) * (volume : Measure (Euclid n)).real (closedBall 0 1) /
              (θ j ^ n * (volume : Measure (Euclid n)).real (closedBall 0 1)) := by
            field_simp)
    refine key.congr' (Eventually.of_forall fun j => ?_)
    simp only
    rw [hG]
    congr 1; funext y
    rw [smul_eq_mul, mul_comm]

/-- **The `L¹` norm on a ball by duality with smooth test functions** (steps 2 and 4 of the BV
estimate `∫_{B_R} |u − u ∗ φ_s| ≤ s V` in the cycle part of the proof of Simon 7.2.4): if `h` is
integrable on `B_{R+δ}(0)`, `δ > 0`, and `∫ h g ≤ C` for every smooth `g` with compact support in
`B_{R+δ}(0)` and `|g| ≤ 1`, then `∫_{B_R(0)} |h| ≤ C`.  With a Borel representative `h̃` of `h`
on `B_{R+δ}(0)` and `g₀ = 1_{B_R(0)} sgn h̃`, the admissible smooth tests `G_j → g₀` a.e. of
`smooth_ae_approx` give `∫ h G_j ≤ C`, and dominated convergence (dominant `|h|`) gives
`∫ h G_j → ∫_{B_{R+δ}(0)} h g₀ = ∫_{B_R(0)} |h|`. -/
theorem Submission.cbr_ci_pw_bv_l1_duality : ∀ (n : ℕ) (R δ C : ℝ) (h : Euclid n → ℝ), 0 < δ → IntegrableOn h (ball 0 (R + δ)) → (∀ g : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ ball 0 (R + δ) → (∀ x, |g x| ≤ 1) → ∫ x, h x * g x ≤ C) → ∫ x in ball 0 R, |h x| ≤ C := by
  intro n R δ C h hδ hh htest
  set B : Set (Euclid n) := ball 0 (R + δ) with hB
  -- Step 1: a Borel representative `h̃ = hm` of `h` on `B`
  set hm : Euclid n → ℝ := hh.aestronglyMeasurable.mk h with hhm
  have hhm_meas : Measurable hm := hh.aestronglyMeasurable.stronglyMeasurable_mk.measurable
  have hae : h =ᵐ[volume.restrict B] hm := hh.aestronglyMeasurable.ae_eq_mk
  -- Step 2: the sign function `g₀ = 1_{B_R(0)} sgn h̃`: Borel, `|g₀| ≤ 1`, `g₀ = 0` off `B_R(0)`
  set g₀ : Euclid n → ℝ :=
    (ball (0 : Euclid n) R).indicator (fun x => if 0 ≤ hm x then 1 else -1) with hg₀
  have hg₀m : Measurable g₀ :=
    (Measurable.ite (measurableSet_le measurable_const hhm_meas) measurable_const
      measurable_const).indicator measurableSet_ball
  have hg₀b : ∀ x, |g₀ x| ≤ 1 := by
    intro x
    simp only [hg₀, Set.indicator]
    split_ifs <;> norm_num
  have hg₀z : ∀ x, R ≤ ‖x‖ → g₀ x = 0 := by
    intro x hx
    simp only [hg₀]
    exact Set.indicator_of_notMem (by simpa [mem_ball_zero_iff] using hx) _
  -- Step 3: smooth admissible tests `G_j → g₀` a.e.
  obtain ⟨G, hGs, hGc, hGt, hGb, hGl⟩ :=
    Submission.cbr_ci_pw_bv_smooth_ae_approx n R δ g₀ hδ hg₀m hg₀b hg₀z
  -- Step 4: `∫_B h G_j = ∫ h G_j ≤ C`, as `G_j` vanishes off `B`
  have hle : ∀ j, ∫ x in B, h x * G j x ≤ C := by
    intro j
    rw [setIntegral_eq_integral_of_forall_compl_eq_zero (fun x hx => by
      rw [image_eq_zero_of_notMem_tsupport (fun hx' => hx (hGt j hx')), mul_zero])]
    exact htest (G j) (hGs j) (hGc j) (hGt j) (hGb j)
  -- Step 5: dominated convergence on `B`, with dominant `|h|`
  have hlim : Tendsto (fun j => ∫ x in B, h x * G j x) atTop (𝓝 (∫ x in B, h x * g₀ x)) := by
    refine tendsto_integral_of_dominated_convergence (fun x => ‖h x‖) (fun j => ?_) hh.norm
      (fun j => ?_) ?_
    · exact hh.aestronglyMeasurable.mul (hGs j).continuous.aestronglyMeasurable
    · refine Eventually.of_forall fun x => ?_
      rw [norm_mul]
      exact mul_le_of_le_one_right (norm_nonneg _) (by rw [Real.norm_eq_abs]; exact hGb j x)
    · exact (ae_restrict_of_ae hGl).mono fun x hx => tendsto_const_nhds.mul hx
  -- Step 6: `h g₀ = 1_{B_R(0)} |h|` a.e. on `B`, so `∫_B h g₀ = ∫_{B_R(0)} |h|`
  have heq : ∫ x in B, h x * g₀ x = ∫ x in ball 0 R, |h x| := by
    have hfg : (fun x => h x * g₀ x) =ᵐ[volume.restrict B]
        (ball (0 : Euclid n) R).indicator (fun x => |h x|) := by
      filter_upwards [hae] with x hx
      simp only [hg₀, Set.indicator]
      split_ifs with hxR hpos
      · rw [hx, mul_one, abs_of_nonneg hpos]
      · rw [hx, mul_neg_one, abs_of_neg (not_le.1 hpos)]
      · rw [mul_zero]
    rw [integral_congr_ae hfg, setIntegral_indicator measurableSet_ball,
      Set.inter_eq_right.2 (ball_subset_ball (by linarith : R ≤ R + δ))]
  -- Step 7: a limit of numbers `≤ C` is `≤ C`
  rw [← heq]
  exact le_of_tendsto' hlim hle
/-- **Continuity of the mollification** (the "`w` is continuous" step of the BV estimate): if `u`
is integrable on `S ⊆ ℝⁿ` and `φ` is continuous with compact support, then
`x ↦ ∫_S u(y) φ(x - y) dy` is continuous.  `φ` is bounded, `|φ| ≤ K`, so for every `x` the
integrand is dominated by the `x`-independent integrable function `|u| K`, and it is continuous in
`x` for every `y`; conclude by `continuous_of_dominated`. -/
theorem Submission.cbr_ci_pw_bv_mollify_continuous : ∀ (n : ℕ) (S : Set (Euclid n)) (φ u : Euclid n → ℝ), IntegrableOn u S → Continuous φ → HasCompactSupport φ → Continuous (fun x => ∫ y in S, u y * φ (x - y)) := by
  intro n S φ u hu hφ hφc
  -- `|φ| ≤ K`: `φ` is continuous with compact support
  obtain ⟨K, hK⟩ := hφ.bounded_above_of_compact_support hφc
  -- dominated continuity of parametric integrals, with the dominant `|u| K` integrable on `S`
  refine continuous_of_dominated (bound := fun y => ‖u y‖ * K) (fun x => ?_) (fun x => ?_)
    (hu.norm.mul_const K) (Eventually.of_forall fun y => ?_)
  · -- measurability in `y`: `u` is a.e.-strongly measurable on `S`, `y ↦ φ (x - y)` is continuous
    exact hu.aestronglyMeasurable.mul
      (hφ.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
  · -- domination: `|u y φ (x - y)| ≤ |u y| K`
    exact Eventually.of_forall fun y => by
      rw [norm_mul]; exact mul_le_mul_of_nonneg_left (hK _) (norm_nonneg _)
  · -- continuity in `x` for each fixed `y`
    exact continuous_const.mul (hφ.comp (continuous_id.sub continuous_const))

/-- **BV estimate for mollification** (for the integer multiplicity of limits in Simon 7.2.4,
Remark 7.2.5(1); the boundary mass `M_{B_{2R}}(∂Y)` is replaced by a variation bound `V`): if `u`
is integrable on `B_{2R}(0)` and `|∫_{B_{2R}(0)} u(y) Df(y)(z) dy| ≤ V‖z‖M` for every smooth `f`
supported in `B_{2R}(0)` with `|f| ≤ M`, then `∫_{B_R(0)} |u − w| ≤ sV` for
`w(x) = ∫_{B_{2R}(0)} u(y)φ(x − y) dy`, where `φ ≥ 0` is smooth, `tsupport φ ⊆ B_s(0)`,
`∫φ = 1` and `2s < R`.  The mollification `w` is continuous (`cbr_ci_pw_bv_mollify_continuous`),
so `u − w` is integrable on `B_{R+s}(0)`; its pairings with smooth `g`, `|g| ≤ 1`,
`tsupport g ⊆ B_{R+s}(0)` are at most `sV` (`cbr_ci_pw_bv_smooth_test_bound`); `L¹` duality
(`cbr_ci_pw_bv_l1_duality` with `δ = s`) concludes. -/
theorem Submission.cbr_ci_pw_bv_mollifier_estimate : ∀ (n : ℕ) (R s V : ℝ) (φ u : Euclid n → ℝ), 0 < R → 0 < s → 2 * s < R → 0 ≤ V → ContDiff ℝ (⊤ : ℕ∞) φ → (∀ y, 0 ≤ φ y) → tsupport φ ⊆ ball 0 s → ∫ y, φ y = 1 → IntegrableOn u (ball 0 (2 * R)) → (∀ (f : Euclid n → ℝ) (z : Euclid n) (M : ℝ), ContDiff ℝ (⊤ : ℕ∞) f → HasCompactSupport f → tsupport f ⊆ ball 0 (2 * R) → (∀ y, |f y| ≤ M) → |∫ y in ball 0 (2 * R), u y * fderiv ℝ f y z| ≤ V * ‖z‖ * M) → ∫ x in ball 0 R, |u x - ∫ y in ball 0 (2 * R), u y * φ (x - y)| ≤ s * V := by
  intro n R s V φ u hR hs hsR hV hφ hφ0 hφs hφ1 hu hvar
  have hφc : HasCompactSupport φ :=
    (isCompact_closedBall 0 s).of_isClosed_subset (isClosed_tsupport φ)
      (hφs.trans ball_subset_closedBall)
  have hw : Continuous fun x => ∫ y in ball 0 (2 * R), u y * φ (x - y) :=
    Submission.cbr_ci_pw_bv_mollify_continuous n (ball 0 (2 * R)) φ u hu hφ.continuous hφc
  have hh : IntegrableOn (fun x => u x - ∫ y in ball 0 (2 * R), u y * φ (x - y))
      (ball 0 (R + s)) :=
    (hu.mono_set (ball_subset_ball (by linarith))).fun_sub
      ((hw.continuousOn.integrableOn_compact (isCompact_closedBall 0 (R + s))).mono_set
        ball_subset_closedBall)
  exact Submission.cbr_ci_pw_bv_l1_duality n R s (s * V)
    (fun x => u x - ∫ y in ball 0 (2 * R), u y * φ (x - y)) hs hh
    fun g hg hgc hgs hg1 => (le_abs_self _).trans
      (Submission.cbr_ci_pw_bv_smooth_test_bound n R s V φ u g hR hs hsR hV hφ hφ0 hφs hφ1 hu
        hvar hg hgc hgs hg1)
/-- **Equal set integrals against all test forms of an open `B` determine the orientation a.e.
on `B`** (orientation step of the locality of integer multiplicity).  On `E ⊆ B`,
`μ₂⌞E = (μ₂⌞B)⌞E = (μ₁⌞B)⌞E = μ₁⌞E`.  Fix a covector `α` and a compact `K ⊆ B`.  A smooth
Urysohn function `φ` with `φ = 1` on `K` and `tsupport φ` compact in `B` gives the test form
`ω = φ α ∈ 𝒟ᵏ(B)`, equal to `α` on `K`; so for Borel `s`, `∫_s ξ₁(α) d(μ₁⌞K) = ∫_{s∩K} ξ₁(ω) dμ₁
= ∫_{s∩K} ξ₂(ω) dμ₂ = ∫_s ξ₂(α) d(μ₁⌞K)`.  Both evaluations are bounded by `|α|` and `μ₁(K) < ∞`,
so they are `μ₁⌞K`-integrable and uniqueness of densities gives `ξ₁(α) = ξ₂(α)` `μ₁`-a.e. on `K`.
Testing on a finite basis of covectors (`Λᵏ` is finite-dimensional,
`Submission.lcn_covector_finiteDimensional`) gives `ξ₁ = ξ₂` `μ₁`-a.e. on `K`; each point of
`B` has a closed-ball neighbourhood `K ⊆ B`, and `μ₁`-null sets are local
(`measure_null_of_locally_null`, `ℝᴾ` second countable). -/
theorem Submission.cbr_orient_ae_eq_of_setIntegral_eq : ∀ (P k : ℕ) (B : Set (Euclid P)) (μ₁ μ₂ : Measure (Euclid P)) (ξ₁ ξ₂ : Euclid P → MultiVector P k), IsOpen B → (∀ K : Set (Euclid P), IsCompact K → K ⊆ B → μ₁ K < ∞) → μ₁.restrict B = μ₂.restrict B → AEStronglyMeasurable ξ₁ μ₁ → AEStronglyMeasurable ξ₂ μ₂ → (∀ᵐ x ∂μ₁, ∀ α : Covector (Euclid P) k, |ξ₁ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ₂, ∀ α : Covector (Euclid P) k, |ξ₂ x α| ≤ covectorEuclideanNorm α) → (∀ (E : Set (Euclid P)) (ω : TestFormOn B k), MeasurableSet E → ∫ x in E, ξ₁ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₁ = ∫ x in E, ξ₂ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₂) → ∀ᵐ x ∂μ₁, x ∈ B → ξ₁ x = ξ₂ x := by
  intro P k B μ₁ μ₂ ξ₁ ξ₂ hB hfin hres hm₁ hm₂ hb₁ hb₂ hint
  -- Step 1: on `E ⊆ B`, `μ₂⌞E = (μ₂⌞B)⌞E = (μ₁⌞B)⌞E = μ₁⌞E`
  have hrestr : ∀ E : Set (Euclid P), E ⊆ B → μ₂.restrict E = μ₁.restrict E := fun E hEB => by
    rw [← Measure.restrict_restrict_of_subset hEB, ← hres, Measure.restrict_restrict_of_subset hEB]
  -- Step 2: for a covector `α` and a compact `K ⊆ B`, `ξ₁(α) = ξ₂(α)` holds `μ₁⌞K`-a.e.
  have hcov : ∀ K : Set (Euclid P), IsCompact K → K ⊆ B → ∀ α : Covector (Euclid P) k,
      ∀ᵐ y ∂μ₁.restrict K, ξ₁ y α = ξ₂ y α := by
    intro K hKc hKB α
    have hKm : MeasurableSet K := hKc.isClosed.measurableSet
    -- a smooth cut-off `φ`, `φ = 1` on `K`, with `tsupport φ = closure V` compact in `B`
    obtain ⟨V, hVo, hKV, hVB, hVc⟩ := exists_open_between_and_isCompact_closure hKc hB hKB
    obtain ⟨φ, hφ, -, hφs, hφ1⟩ :=
      exists_contDiff_support_eq_eq_one_iff (n := ⊤) hVo hKc.isClosed hKV
    have hts : tsupport φ = closure V := by rw [tsupport, hφs]
    -- the test form `ω = φ α ∈ 𝒟ᵏ(B)`: smooth, `tsupport ω ⊆ tsupport φ = closure V`
    have hωφ : tsupport (fun y => φ y • α : DifferentialForm (Euclid P) k) ⊆ closure V :=
      (tsupport_smul_subset_left φ fun _ => α).trans hts.subset
    have hω : (fun y => φ y • α : DifferentialForm (Euclid P) k) ∈ testFormOnSubmodule B k :=
      ⟨⟨hφ.smul (contDiff_const (c := α)), hVc.of_isClosed_subset (isClosed_tsupport _) hωφ⟩,
        hωφ.trans hVB⟩
    -- `ξ₁(α)`, `ξ₂(α)` are a.e. strongly measurable and bounded by `|α|`, `μ₁ K = μ₂ K < ∞`
    have hK₁ : μ₁ K ≠ ∞ := (hfin K hKc hKB).ne
    have hK₂ : μ₂ K ≠ ∞ :=
      calc μ₂ K = μ₂.restrict K univ := (Measure.restrict_apply_univ K).symm
        _ = μ₁.restrict K univ := by rw [hrestr K hKB]
        _ = μ₁ K := Measure.restrict_apply_univ K
        _ ≠ ∞ := hK₁
    have hf : Integrable (fun y => ξ₁ y α) (μ₁.restrict K) :=
      Measure.integrableOn_of_bounded hK₁ (hm₁.apply_continuousLinearMap α)
        ((ae_restrict_of_ae hb₁).mono fun y hy => (Real.norm_eq_abs _).trans_le (hy α))
    have hg : Integrable (fun y => ξ₂ y α) (μ₁.restrict K) := by
      rw [← hrestr K hKB]
      exact Measure.integrableOn_of_bounded hK₂ (hm₂.apply_continuousLinearMap α)
        ((ae_restrict_of_ae hb₂).mono fun y hy => (Real.norm_eq_abs _).trans_le (hy α))
    -- equal set integrals for `μ₁⌞K`: on `s ∩ K`, `ω = α`
    refine Integrable.ae_eq_of_forall_setIntegral_eq _ _ hf hg fun s hs _ => ?_
    have hsK : MeasurableSet (s ∩ K) := hs.inter hKm
    have heq : ∀ ξ : Euclid P → MultiVector P k,
        EqOn (fun y => ξ y α) (fun y => ξ y (φ y • α)) (s ∩ K) := fun ξ y hy => by
      show ξ y α = ξ y (φ y • α)
      rw [(hφ1 y).1 hy.2, one_smul]
    rw [Measure.restrict_restrict hs]
    calc ∫ y in s ∩ K, ξ₁ y α ∂μ₁ = ∫ y in s ∩ K, ξ₁ y (φ y • α) ∂μ₁ :=
          setIntegral_congr_fun hsK (heq ξ₁)
      _ = ∫ y in s ∩ K, ξ₂ y (φ y • α) ∂μ₂ := hint (s ∩ K) ⟨_, hω⟩ hsK
      _ = ∫ y in s ∩ K, ξ₂ y (φ y • α) ∂μ₁ := by
          rw [hrestr (s ∩ K) (inter_subset_right.trans hKB)]
      _ = ∫ y in s ∩ K, ξ₂ y α ∂μ₁ := (setIntegral_congr_fun hsK (heq ξ₂)).symm
  -- Step 3: on a compact `K ⊆ B`, test on a basis of the finite-dimensional `Λᵏ`
  have := Submission.lcn_covector_finiteDimensional P k
  let b := Module.finBasis ℝ (Covector (Euclid P) k)
  have hK : ∀ K : Set (Euclid P), IsCompact K → K ⊆ B → ∀ᵐ y ∂μ₁, y ∈ K → ξ₁ y = ξ₂ y := by
    intro K hKc hKB
    refine (ae_restrict_iff' hKc.isClosed.measurableSet).1 ?_
    filter_upwards [ae_all_iff.2 fun i => hcov K hKc hKB (b i)] with y hy
    exact ContinuousLinearMap.coe_injective (b.ext hy)
  -- Step 4: each `x ∈ B` has a closed-ball neighbourhood `K ⊆ B`; null sets are local
  refine ae_iff.2 (measure_null_of_locally_null _ fun x hx => ?_)
  have hx' : ¬(x ∈ B → ξ₁ x = ξ₂ x) := hx
  obtain ⟨ε, hε, hεB⟩ := Metric.isOpen_iff.1 hB x (not_imp.1 hx').1
  refine ⟨_, inter_mem_nhdsWithin _ (closedBall_mem_nhds x (half_pos hε)),
    measure_mono_null ?_ (ae_iff.1 (hK _ (isCompact_closedBall x (ε / 2))
      ((closedBall_subset_ball (half_lt_self hε)).trans hεB)))⟩
  exact fun y hy h => hy.1 fun _ => h hy.2
/-- Measures `μ, ν` on `ℝᴾ` that agree on the open subsets of an open set `O`, with `μ` finite on
compact subsets of `O`, agree on the Borel subsets of `O`.  `O` is exhausted by the open sets
`Oᵢ = {x : |x| < i, dist(x, ℝᴾ ∖ O) > 1/(i+1)}`, whose closures are compact subsets of `O`; the
finite measures `μ⌞Oᵢ, ν⌞Oᵢ` agree on the π-system of open sets, hence everywhere, and continuity
from below along `A ∩ Oᵢ ↑ A` gives `μ(A) = ν(A)`. -/
theorem Submission.cmc_ml_measure_eq_of_eq_on_open_subsets : ∀ (P : ℕ) (O : Set (Euclid P)) (μ ν : Measure (Euclid P)), IsOpen O → (∀ C : Set (Euclid P), IsCompact C → C ⊆ O → μ C ≠ ∞) → (∀ G : Set (Euclid P), IsOpen G → G ⊆ O → μ G = ν G) → ∀ A : Set (Euclid P), MeasurableSet A → A ⊆ O → μ A = ν A := by
  intro P O μ ν hO hfin hopen A hA hAO
  -- `d(x) = dist(x, ℝᴾ ∖ O) ∈ [0, ∞]` (`d ≡ ∞` if `O = ℝᴾ`), and the thresholds `1/(i+1)`
  set d : Euclid P → ℝ≥0∞ := fun x => infEDist x Oᶜ
  have hdc : Continuous d := continuous_infEDist
  set c : ℕ → ℝ≥0∞ := fun i => ((i + 1 : ℕ) : ℝ≥0∞)⁻¹
  have hc0 : ∀ i, c i ≠ 0 := fun i => ENNReal.inv_ne_zero.mpr (ENNReal.natCast_ne_top _)
  -- 1. the exhaustion `Oᵢ = {x : |x| < i, d(x) > 1/(i+1)}`
  set Oi : ℕ → Set (Euclid P) := fun i => ball 0 i ∩ d ⁻¹' Ioi (c i)
  -- (a) `Oᵢ` is open
  have hOi_open : ∀ i, IsOpen (Oi i) := fun i => isOpen_ball.inter (isOpen_Ioi.preimage hdc)
  -- (b) `closure Oᵢ ⊆ Fᵢ = {x : |x| ≤ i, d(x) ≥ 1/(i+1)} ⊆ O`
  have hOi_cl : ∀ i, closure (Oi i) ⊆ closedBall 0 i ∩ d ⁻¹' Ici (c i) := fun i =>
    closure_minimal (inter_subset_inter ball_subset_closedBall (preimage_mono Ioi_subset_Ici_self))
      (isClosed_closedBall.inter (isClosed_Ici.preimage hdc))
  have hOi_O : ∀ i, closure (Oi i) ⊆ O := by
    intro i x hx
    by_contra hxO
    have h0 : d x = 0 := infEDist_zero_of_mem hxO
    have h1 : c i ≤ d x := (hOi_cl i hx).2
    rw [h0, nonpos_iff_eq_zero] at h1
    exact hc0 i h1
  -- (c) `closure Oᵢ` is compact
  have hOi_cpt : ∀ i, IsCompact (closure (Oi i)) := fun i =>
    (isCompact_closedBall 0 i).of_isClosed_subset isClosed_closure fun x hx => (hOi_cl i hx).1
  -- (d) `Oᵢ ⊆ Oⱼ` for `i ≤ j`
  have hOi_mono : Monotone Oi := by
    intro i j hij x hx
    have h1 : x ∈ ball (0 : Euclid P) j := ball_subset_ball (by exact_mod_cast hij) hx.1
    have h2 : c i < d x := hx.2
    have h3 : c j ≤ c i := ENNReal.inv_le_inv.mpr (by exact_mod_cast Nat.succ_le_succ hij)
    have h4 : c j < d x := h3.trans_lt h2
    exact ⟨h1, h4⟩
  -- (e) `⋃ᵢ Oᵢ = O`
  have hOi_union : ⋃ i, Oi i = O := by
    refine Subset.antisymm (iUnion_subset fun i => subset_closure.trans (hOi_O i)) fun x hx => ?_
    have hdx : 0 < d x := infEDist_pos_iff_notMem_closure.mpr (by
      rw [hO.isClosed_compl.closure_eq]; exact fun h => h hx)
    obtain ⟨m, hm⟩ := ENNReal.exists_inv_nat_lt hdx.ne'
    obtain ⟨k, hk⟩ := exists_nat_gt ‖x‖
    have h1 : x ∈ ball (0 : Euclid P) (max m k : ℕ) := by
      rw [mem_ball, dist_zero_right]
      exact hk.trans_le (by exact_mod_cast le_max_right m k)
    have h2 : c (max m k) ≤ (m : ℝ≥0∞)⁻¹ :=
      ENNReal.inv_le_inv.mpr (by exact_mod_cast (le_max_left m k).trans (Nat.le_succ _))
    have h3 : c (max m k) < d x := h2.trans_lt hm
    exact mem_iUnion.mpr ⟨max m k, h1, h3⟩
  -- 2. `μ(Oᵢ) ≤ μ(closure Oᵢ) < ∞`
  have hμOi : ∀ i, μ (Oi i) ≠ ∞ := fun i =>
    ne_top_of_le_ne_top (hfin _ (hOi_cpt i) (hOi_O i)) (measure_mono subset_closure)
  -- 3. `μ⌞Oᵢ = ν⌞Oᵢ`: finite measures agreeing on the π-system of open sets (and on `ℝᴾ`)
  have hrestr : ∀ i, μ.restrict (Oi i) = ν.restrict (Oi i) := by
    intro i
    have : IsFiniteMeasure (μ.restrict (Oi i)) := isFiniteMeasure_restrict.mpr (hμOi i)
    have hG : ∀ G : Set (Euclid P), IsOpen G → μ.restrict (Oi i) G = ν.restrict (Oi i) G := by
      intro G hG
      rw [Measure.restrict_apply hG.measurableSet, Measure.restrict_apply hG.measurableSet]
      exact hopen _ (hG.inter (hOi_open i))
        (inter_subset_right.trans (subset_closure.trans (hOi_O i)))
    exact ext_of_generate_finite _ BorelSpace.measurable_eq isPiSystem_isOpen
      (fun G hG' => hG G hG') (hG univ isOpen_univ)
  -- 4. continuity from below along `A ∩ Oᵢ ↑ A`
  have hAunion : A = ⋃ i, A ∩ Oi i := by
    rw [← inter_iUnion, hOi_union, inter_eq_left.mpr hAO]
  have hmono : Monotone fun i => A ∩ Oi i := fun i j hij =>
    inter_subset_inter_right _ (hOi_mono hij)
  rw [hAunion, hmono.measure_iUnion, hmono.measure_iUnion]
  refine iSup_congr fun i => ?_
  rw [← Measure.restrict_apply hA, ← Measure.restrict_apply hA, hrestr i]

/-- **Foundations of the closure step** (Simon Ch. 6, 2.7–2.8, 2.35–2.37, 3.1, 8.3; Ch. 1, 4.4).
(REP): a current `T` with locally finite mass is `T(ω) = ∫ ⟨ω, ξ⟩ dμ` with `μ(W) = M_W(T)` and
`|ξ| ≤ 1` (`dimred_mbl_fnd_exists_massRepresentation_core`); if `∂T` also has locally finite
mass, then `μ ≪ Hⁿ` for this same `(μ, ξ)` (`dimred_mbl_fnd_null_of_representation`).
(T1): measures with locally bounded masses have a vaguely convergent subsequence
(`cbr_vague_convergent_subseq`); its limit is a Radon measure on `U`
(`cbr_vague_limit_measure`) satisfying the portmanteau inequalities (`cbr_vague_portmanteau`).
(T2) and (MM) are `cbr_sublevel_restriction_tendsto` and `cbr_slice_mass_majorant`.
(IML): restriction to an open `V ⊆ U` preserves integer multiplicity
(`dtc_restrictDomain_isIntegerMultiplicity`).  Conversely, assume (REP), (MR) and (IMC), and
write `X = ξ·μ` by (REP).  Let `R` represent `X⌞B` on a ball `B ⊆ U`.  For `G ⊆ B`, `X` and
`X⌞B` have the same admissible forms for `M_G`.  So `μ(G) = M_G(X) = M_G(X⌞B) = μ_R(G)` for
open `G ⊆ B` by (MR), and `μ⌞B = μ_R` (`cmc_ml_measure_eq_of_eq_on_open_subsets`; `μ_R` lives
on `M_R ⊆ B`).  Both `ξ·μ` and `ξ_R·μ_R` represent `X⌞B`.  Hence their set integrals agree
(`cbr_setIntegral_eq_of_integral_eq`), so `ξ = ξ_R` `μ`-a.e. on `B`
(`cbr_orient_ae_eq_of_setIntegral_eq`).  The local triples then glue
(`cbr_isIntegerMultiplicity_of_local_reps`). -/
theorem Submission.dtc_bc_tc_cl_foundations : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) ∧ ((∀ (P : ℕ) (U : Set (Euclid P)) (μs : ℕ → Measure (Euclid P)), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ⨆ j, μs j K < ∞) → ∃ (φ : ℕ → ℕ) (μ : Measure (Euclid P)), StrictMono φ ∧ μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → tsupport f ⊆ U → Tendsto (fun j => ∫ x, f x ∂(μs (φ j))) atTop (𝓝 (∫ x, f x ∂μ))) ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → limsup (fun j => μs (φ j) K) atTop ≤ μ K) ∧ (∀ G : Set (Euclid P), IsOpen G → G ⊆ U → μ G ≤ liminf (fun j => μs (φ j) G) atTop)) ∧ (∀ (P k : ℕ) (U : Set (Euclid P)) (Xs : ℕ → GeometricCurrentOn U k) (X : GeometricCurrentOn U k) (μs : ℕ → Measure (Euclid P)) (ξs : ℕ → Euclid P → MultiVector P k) (μX μ : Measure (Euclid P)) (ξX : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (t : ℝ), IsOpen U → Continuous f → WeaklyConvergesOn Xs X → (∀ j, ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μs j K < ∞) → (∀ j, AEStronglyMeasurable (ξs j) (μs j)) → (∀ j, ∀ᵐ x ∂(μs j), ∀ α : Covector (Euclid P) k, |ξs j x α| ≤ covectorEuclideanNorm α) → (∀ j, ∀ ω : TestFormOn U k, Xs j ω = ∫ x, ξs j x ((ω : DifferentialForm (Euclid P) k) x) ∂(μs j)) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μX K < ∞) → AEStronglyMeasurable ξX μX → (∀ᵐ x ∂μX, ∀ α : Covector (Euclid P) k, |ξX x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U k, X ω = ∫ x, ξX x ((ω : DifferentialForm (Euclid P) k) x) ∂μX) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → limsup (fun j => μs j K) atTop ≤ μ K) → μ {x | f x = t} = 0 → ∀ ω : TestFormOn U k, Tendsto (fun j => ∫ x in {x | f x < t}, ξs j x ((ω : DifferentialForm (Euclid P) k) x) ∂(μs j)) atTop (𝓝 (∫ x in {x | f x < t}, ξX x ((ω : DifferentialForm (Euclid P) k) x) ∂μX))) ∧ (∀ (P : ℕ) (μs : ℕ → Measure (Euclid P)) (f : Euclid P → ℝ) (G : Set (Euclid P)) (a b : ℝ) (L : NNReal) (Z : ℕ → ℝ → ℝ≥0∞), Continuous f → (∀ j, μs j (G ∩ {x | a < f x ∧ f x < b}) < ∞) → (∀ (j : ℕ) (t : ℝ), t ∈ Ioo a b → Z j t ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μs j (G ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) → ∃ g : ℝ → ℝ≥0∞, Measurable g ∧ (∀ᵐ t ∂(volume : Measure ℝ), t ∈ Ioo a b → liminf (fun j => Z j t) atTop ≤ g t) ∧ ∫⁻ t in Ioo a b, g t ≤ (L : ℝ≥0∞) * liminf (fun j => μs j (G ∩ {x | a < f x ∧ f x < b})) atTop)) ∧ ((∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (P k : ℕ) (U : Set (Euclid P)) (X : GeometricCurrentOn U k), IsOpen U → ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → X.massOn W < ∞) → (∀ x ∈ U, ∃ r : ℝ, 0 < r ∧ ∃ h : ball x r ⊆ U, IsIntegerMultiplicity (X.restrictDomain h)) → IsIntegerMultiplicity X) ∧ (∀ (V : Set (Euclid P)) (h : V ⊆ U), IsOpen V → IsIntegerMultiplicity X → IsIntegerMultiplicity (X.restrictDomain h))) := by
  refine ⟨?_, ⟨?_, Submission.cbr_sublevel_restriction_tendsto,
    Submission.cbr_slice_mass_majorant⟩, ?_⟩
  · -- (REP): the representation core, then absolute continuity for the same `(μ, ξ)`
    intro P n U T hU hmass
    obtain ⟨μ, ξ, hμU, hμK, hμW, hξ, hξα, hTξ⟩ :=
      Submission.dimred_mbl_fnd_exists_massRepresentation_core P n U T hU hmass
    exact ⟨μ, ξ, hμU, hμK, hμW, hξ, hξα, hTξ, fun hbd =>
      Submission.dimred_mbl_fnd_null_of_representation P n U T μ ξ hU hbd hμU hμK hμW hξ hξα
        hTξ⟩
  · -- (T1): a vaguely convergent subsequence, its limit measure and the portmanteau inequalities
    intro P U μs hU hbound
    obtain ⟨φ, hφ, hconv⟩ := Submission.cbr_vague_convergent_subseq P U μs hU hbound
    -- `μ_{φ(j)}(K) ≤ ⨆ᵢ μᵢ(K) < ∞` for compact `K ⊆ U`
    have hfin : ∀ (j : ℕ) (K : Set (Euclid P)), IsCompact K → K ⊆ U → μs (φ j) K < ∞ :=
      fun j K hK hKU => (le_iSup (fun i => μs i K) (φ j)).trans_lt (hbound K hK hKU)
    obtain ⟨μ, hμU, hμK, hμconv⟩ :=
      Submission.cbr_vague_limit_measure P U (fun j => μs (φ j)) hU hfin hconv
    obtain ⟨hlimsup, hliminf⟩ :=
      Submission.cbr_vague_portmanteau P U (fun j => μs (φ j)) μ hU hfin hμK hμconv
    exact ⟨φ, μ, hφ, hμU, hμK, hμconv, hlimsup, hliminf⟩
  · -- (IML)
    intro hREP hMR hIMC P k U X hU
    -- (2): restriction to an open `V ⊆ U` preserves integer multiplicity
    refine ⟨fun hmass hloc => ?_, fun V hVU hV hX =>
      Submission.dtc_restrictDomain_isIntegerMultiplicity P k U V hVU X hV hX⟩
    -- (1), Step 1: `X = ξ·μ` with `μ(W) = M_W(X)` by (REP); it suffices to give local triples
    obtain ⟨μ, ξ, hμU, hμK, hμmass, hξmeas, hξbound, hXrep, -⟩ := hREP P k U X hU hmass
    refine Submission.cbr_isIntegerMultiplicity_of_local_reps hIMC.1 P k U X μ ξ hU hμU hμK
      hξmeas hXrep fun x hx => ?_
    -- Step 2: a ball `B = B_r(x) ⊆ U` and a triple `R` representing `X⌞B`
    obtain ⟨r, hr, hB, R, hR⟩ := hloc x hx
    obtain ⟨hRac, -, -, hRcompl, hRK, hRmeas, hRaction⟩ :=
      Submission.cbr_imRep_measure_basic P k (ball x r) R
    have hμKB : ∀ K : Set (Euclid P), IsCompact K → K ⊆ ball x r → μ K < ∞ :=
      fun K hK hKB => hμK K hK (hKB.trans hB)
    -- `|ξ_R| ≤ 1` holds `Hᵏ⌞M_R`-a.e. by (IMC)(d), hence `μ_R`-a.e.
    have hRbound : ∀ᵐ y ∂R.measure, ∀ α : Covector (Euclid P) k,
        |R.orient y α| ≤ covectorEuclideanNorm α :=
      hRac.ae_le (hIMC.2.2.2 P k (ball x r) R)
    -- Step 3: `M_G(X) = M_G(X⌞B)` for `G ⊆ B`: the admissible forms are the same forms
    have hmassB : ∀ G : Set (Euclid P), G ⊆ ball x r →
        X.massOn G = (X.restrictDomain hB).massOn G := by
      intro G hGB
      unfold GeometricCurrentOn.massOn
      congr 1
      ext s
      constructor
      · rintro ⟨ω, hω, rfl⟩
        exact ⟨⟨ω, ω.property.1, hω.1.trans hGB⟩, hω, rfl⟩
      · rintro ⟨ω', hω', rfl⟩
        exact ⟨testFormOnInclusion hB k ω', hω', rfl⟩
    -- Step 4: `μ(G) = M_G(X) = M_G(X⌞B) = μ_R(G)` for open `G ⊆ B` by (MR), so `μ⌞B = μ_R⌞B`
    have hopen : ∀ G : Set (Euclid P), IsOpen G → G ⊆ ball x r → μ G = R.measure G := by
      intro G hG hGB
      rw [← hμmass G hG, hmassB G hGB]
      exact hMR P k (ball x r) (X.restrictDomain hB) R isOpen_ball hR G hG
    have hborel := Submission.cmc_ml_measure_eq_of_eq_on_open_subsets P (ball x r) μ R.measure
      isOpen_ball (fun C hC hCB => (hμKB C hC hCB).ne) hopen
    have hrestr : μ.restrict (ball x r) = R.measure.restrict (ball x r) :=
      (Measure.restrict_congr_meas measurableSet_ball).2 fun A hAB hA => hborel A hA hAB
    -- `μ_R` lives on `M_R ⊆ B`, so `μ_R⌞B = μ_R`
    have hRB : R.measure.restrict (ball x r) = R.measure :=
      Measure.restrict_eq_self_of_ae_mem
        (Filter.mem_of_superset (mem_ae_iff.2 hRcompl) R.carrier_subset)
    -- Step 5: `∫ ⟨ω, ξ⟩ dμ = X(ιω) = X⌞B(ω) = ∫ ⟨ω, ξ_R⟩ dμ_R` for `ω ∈ 𝒟ᵏ(B)`, so the
    -- integrals over every Borel set agree
    have hset := Submission.cbr_setIntegral_eq_of_integral_eq P k (ball x r) μ R.measure 0 ξ
      R.orient 0 isOpen_ball hμKB hRK (fun K _ _ => by simp) hξmeas hRmeas
      (aestronglyMeasurable_zero_measure _) (ae_of_all μ hξbound) hRbound
      (ae_of_all _ fun y α => by simpa using covectorEuclideanNorm_nonneg α) fun ω => by
        rw [integral_zero_measure, add_zero, ← hRaction (ω : DifferentialForm (Euclid P) k),
          ← hR ω, GeometricCurrentOn.restrictDomain_apply, hXrep, testFormOnInclusion_coe]
    -- Step 6: hence `ξ = ξ_R` `μ`-a.e. on `B`, and `(B, R)` is the required local triple
    have hae := Submission.cbr_orient_ae_eq_of_setIntegral_eq P k (ball x r) μ R.measure ξ
      R.orient isOpen_ball hμKB hrestr hξmeas hRmeas (ae_of_all μ hξbound) hRbound
      fun E ω hE => by rw [hset E ω hE, Measure.restrict_zero, integral_zero_measure, add_zero]
    exact ⟨ball x r, R, isOpen_ball, mem_ball_self hr, hB, hrestr.trans hRB, hae⟩

/-- **The densities converge to the constant in `L¹(B_R(0))`** (step 11 of the weight bound).
Let `U = B_{2R}(0) ⊆ ℝⁿ`, `n = d + 1`, `Y_k(ω) = ∫_U u_k ω(e)` with `∫_U |u_k| ≤ Λ` eventually,
`M_U(∂Y_k) → 0` and `Y_k(ω) → c ∫ ω(e)`.  Testing with `b dy` gives `∫_U u_k b → c ∫ b` for
smooth `b` compactly supported in `U`.  Fix a normalized mollifier `φ ≥ 0` supported in
`B_{R/8}(0)`, so `tsupport φ ⊆ B_s(0)` with `s = R/4`; then `w_k = ∫_U u_k(y) φ(· − y) dy → c`
uniformly on `B̄_R(0)`.  Eventually `M_U(∂Y_k) < ∞`, and then, with `V_k = M_U(∂Y_k)` and the
interior-product form `ε_z` (`d(f ε_z)(e) = ∂_z f`, `|ε_z| ≤ ‖z‖`),
`|∫_U u_k ∂_z f| = |∂Y_k(f ε_z)| ≤ V_k ‖z‖ sup |f|`.  The BV estimate gives
`∫_{B_R} |u_k − w_k| ≤ s V_k → 0`, and the `L¹` squeeze yields `∫_{B_R} |u_k − c| → 0`. -/
theorem Submission.cbr_ci_pw_density_l1_tendsto_const : ∀ (d : ℕ) (R c Λ : ℝ) (Y : ℕ → GeometricCurrentOn (ball (0 : Euclid (d + 1)) (2 * R)) (d + 1)) (u : ℕ → Euclid (d + 1) → ℝ), 0 < R → (∀ k, IntegrableOn (u k) (ball 0 (2 * R))) → (∀ᶠ k in atTop, ∫ y in ball 0 (2 * R), |u k y| ≤ Λ) → (∀ (k : ℕ) (ω : TestFormOn (ball (0 : Euclid (d + 1)) (2 * R)) (d + 1)), Y k ω = ∫ y in ball 0 (2 * R), u k y * (ω : DifferentialForm (Euclid (d + 1)) (d + 1)) y (fun i => EuclideanSpace.single i (1 : ℝ))) → Tendsto (fun k => (Y k).boundary.massOn (ball 0 (2 * R))) atTop (𝓝 0) → (∀ ω : TestFormOn (ball (0 : Euclid (d + 1)) (2 * R)) (d + 1), Tendsto (fun k => Y k ω) atTop (𝓝 (c * ∫ y, (ω : DifferentialForm (Euclid (d + 1)) (d + 1)) y (fun i => EuclideanSpace.single i (1 : ℝ))))) → Tendsto (fun k => ∫ y in ball 0 R, |u k y - c|) atTop (𝓝 0) := by
  intro d R c Λ Y u hR hint hΛ hrep hbd hconv
  -- Step 1: scalar tests `∫_U u_k b → c ∫ b`
  have htest :=
    Submission.cbr_ci_pw_l1_scalar_test_tendsto (d + 1) (ball 0 (2 * R)) c Y u hrep hconv
  -- Step 2: a normalized mollifier `φ` with `tsupport φ ⊆ B̄_{R/8}(0) ⊆ B_s(0)`, `s = R/4`
  obtain ⟨φ, hφ, hφc, hφ0, hφ1, hφs⟩ :=
    Submission.dgcr_stc_exists_normalized_mollifier (d + 1) (R / 8) (by positivity)
  have hφt : tsupport φ ⊆ ball 0 (R / 4) :=
    (closure_minimal (hφs.trans ball_subset_closedBall) isClosed_closedBall).trans
      (closedBall_subset_ball (by linarith))
  -- Step 3: `w_k → c ∫ φ = c` uniformly on `B̄_R(0)`
  have hunif := Submission.cbr_ci_pw_mollified_tendstoUniformlyOn (d + 1) R (R / 4) c Λ φ u hR
    (by positivity) (by linarith) hφ hφt hint hΛ htest
  rw [hφ1, mul_one] at hunif
  -- Step 4: `V_k = M_U(∂Y_k).toReal → 0`, and eventually `M_U(∂Y_k) ≠ ∞`
  have hV : Tendsto (fun k => ((Y k).boundary.massOn (ball 0 (2 * R))).toReal) atTop (𝓝 0) := by
    simpa only [Function.comp_def, ENNReal.toReal_zero] using
      (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp hbd
  have hfin := hbd.eventually_ne ENNReal.zero_ne_top
  -- Step 5: `∫_{B_R} |u_k − w_k| ≤ s V_k`, by the BV estimate; its hypothesis
  -- `|∫_U u_k ∂_z f| ≤ V_k ‖z‖ M` comes from `ε_z` and the boundary-mass bound
  have hbv : ∀ᶠ k in atTop,
      ∫ x in ball 0 R, |u k x - ∫ y in ball 0 (2 * R), u k y * φ (x - y)| ≤
        R / 4 * ((Y k).boundary.massOn (ball 0 (2 * R))).toReal := by
    filter_upwards [hfin] with k hk
    refine Submission.cbr_ci_pw_bv_mollifier_estimate (d + 1) R (R / 4)
      ((Y k).boundary.massOn (ball 0 (2 * R))).toReal φ (u k) hR (by positivity) (by linarith)
      ENNReal.toReal_nonneg hφ hφ0 hφt hφ1 (hint k) fun f z M hf hfc hft hM => ?_
    obtain ⟨ε, hε, hεf⟩ := Submission.cbr_ci_pw_interior_product_form d z
    exact Submission.cbr_ci_pw_l1_boundary_variation_bound d (ball 0 (2 * R)) (Y k) (u k) ε f z M
      (hrep k) hk hε (fun y => hεf f y (hf.differentiable (by simp) y)) hf hfc hft hM
  -- Step 6: the `L¹` squeeze with `a_k = s V_k → 0`
  exact Submission.cbr_ci_pw_l1_squeeze_of_mollified (d + 1) R c φ u
    (fun k => R / 4 * ((Y k).boundary.massOn (ball 0 (2 * R))).toReal) hR hφ.continuous hφc hint
    hunif (by simpa only [mul_zero] using hV.const_mul (R / 4)) hbv

/-- **Each plane of a planar weak limit of cycles has weight `≥ 1`** (step (V11) of the proof that
the cycles of the closure theorem are integer multiplicity; White's projection argument).  Let
`Γₖ ⇀ C` be cycles with representations `(μₖ, ξₖ)`, `limsup μₖ(K) ≤ θ₀ν(K)`, carried by sets `Nₖ`
with `limsup Hⁿ(Nₖ ∩ K) ≤ ν(K)`, where `C(ω) = θ₀ ∫ ω(v) dν` and `ν = Σᵢ αᵢ Hⁿ⌞(V₀ + wᵢ)`.  Fix
`i₀`.  A `1`-Lipschitz `g` vanishing on `V₀ + w_{i₀}` isolates that plane
(`cbr_ci_pw_isolate_plane`); slicing by `g` at a good level `t` (`cbr_ci_pw_good_level_slices`)
and projecting by `pL x = (⟨vⱼ, x⟩)ⱼ` (`cbr_ci_pw_projected_current`) gives top-dimensional
currents `Yₖ` on `B₂ ⊆ ℝⁿ` with `M(∂Yₖ) → 0` and `Yₖ ⇀ θ₀α_{i₀}[[ℝⁿ]]`
(`cbr_ci_pw_plane_map_volume`).  Their densities `uₖ` (`cbr_ci_pw_top_current_density`) tend to
`θ₀α_{i₀}` in `L¹(B₁)` (`cbr_ci_pw_density_l1_tendsto_const`) and vanish off `pL(Nₖ)`
(`cbr_ci_pw_density_null_off_image`).  As `pL` is `1`-Lipschitz,
`Lⁿ(B₁) ≤ limsup Hⁿ(Nₖ ∩ A₁) ≤ ν(A₁) = α_{i₀}Lⁿ(B₁)` for the compact `A₁ = {g ≤ t} ∩ pL⁻¹(B̄₁)`. -/
theorem Submission.cbr_ci_plane_weight_ge_one : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → ((∀ (P : ℕ) (U : Set (Euclid P)) (μs : ℕ → Measure (Euclid P)), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ⨆ j, μs j K < ∞) → ∃ (φ : ℕ → ℕ) (μ : Measure (Euclid P)), StrictMono φ ∧ μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → tsupport f ⊆ U → Tendsto (fun j => ∫ x, f x ∂(μs (φ j))) atTop (𝓝 (∫ x, f x ∂μ))) ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → limsup (fun j => μs (φ j) K) atTop ≤ μ K) ∧ (∀ G : Set (Euclid P), IsOpen G → G ⊆ U → μ G ≤ liminf (fun j => μs (φ j) G) atTop)) ∧ (∀ (P k : ℕ) (U : Set (Euclid P)) (Xs : ℕ → GeometricCurrentOn U k) (X : GeometricCurrentOn U k) (μs : ℕ → Measure (Euclid P)) (ξs : ℕ → Euclid P → MultiVector P k) (μX μ : Measure (Euclid P)) (ξX : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (t : ℝ), IsOpen U → Continuous f → WeaklyConvergesOn Xs X → (∀ j, ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μs j K < ∞) → (∀ j, AEStronglyMeasurable (ξs j) (μs j)) → (∀ j, ∀ᵐ x ∂(μs j), ∀ α : Covector (Euclid P) k, |ξs j x α| ≤ covectorEuclideanNorm α) → (∀ j, ∀ ω : TestFormOn U k, Xs j ω = ∫ x, ξs j x ((ω : DifferentialForm (Euclid P) k) x) ∂(μs j)) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μX K < ∞) → AEStronglyMeasurable ξX μX → (∀ᵐ x ∂μX, ∀ α : Covector (Euclid P) k, |ξX x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U k, X ω = ∫ x, ξX x ((ω : DifferentialForm (Euclid P) k) x) ∂μX) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → limsup (fun j => μs j K) atTop ≤ μ K) → μ {x | f x = t} = 0 → ∀ ω : TestFormOn U k, Tendsto (fun j => ∫ x in {x | f x < t}, ξs j x ((ω : DifferentialForm (Euclid P) k) x) ∂(μs j)) atTop (𝓝 (∫ x in {x | f x < t}, ξX x ((ω : DifferentialForm (Euclid P) k) x) ∂μX))) ∧ (∀ (P : ℕ) (μs : ℕ → Measure (Euclid P)) (f : Euclid P → ℝ) (G : Set (Euclid P)) (a b : ℝ) (L : NNReal) (Z : ℕ → ℝ → ℝ≥0∞), Continuous f → (∀ j, μs j (G ∩ {x | a < f x ∧ f x < b}) < ∞) → (∀ (j : ℕ) (t : ℝ), t ∈ Ioo a b → Z j t ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μs j (G ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) → ∃ g : ℝ → ℝ≥0∞, Measurable g ∧ (∀ᵐ t ∂(volume : Measure ℝ), t ∈ Ioo a b → liminf (fun j => Z j t) atTop ≤ g t) ∧ ∫⁻ t in Ioo a b, g t ≤ (L : ℝ≥0∞) * liminf (fun j => μs j (G ∩ {x | a < f x ∧ f x < b})) atTop)) → ∀ (P d : ℕ) (v : Fin (d + 1) → Euclid P) (θ₀ : ℝ) (N : ℕ) (w : Fin N → Euclid P) (α : Fin N → ℝ) (ν : Measure (Euclid P)) (C : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (Γs : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (μs : ℕ → Measure (Euclid P)) (ξs : ℕ → Euclid P → MultiVector P (d + 1)) (Ns : ℕ → Set (Euclid P)), Orthonormal ℝ v → 0 < θ₀ → Injective w → (∀ (i : Fin N) (j : Fin (d + 1)), inner ℝ (w i) (v j) = 0) → (∀ i, 0 < α i) → ν = ∑ i, ENNReal.ofReal (α i) • (μHE[(d + 1)]).restrict {y : Euclid P | y - w i ∈ Submodule.span ℝ (Set.range v)} → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = θ₀ * ∫ y, (ω : DifferentialForm (Euclid P) (d + 1)) y v ∂ν) → WeaklyConvergesOn Γs C → (∀ k, (Γs k).boundary = 0) → (∀ (k : ℕ) (K : Set (Euclid P)), IsCompact K → μs k K < ∞) → (∀ k, AEStronglyMeasurable (ξs k) (μs k)) → (∀ k, ∀ᵐ x ∂(μs k), ∀ β : Covector (Euclid P) (d + 1), |ξs k x β| ≤ covectorEuclideanNorm β) → (∀ (k : ℕ) (ω : TestFormOn (univ : Set (Euclid P)) (d + 1)), Γs k ω = ∫ x, ξs k x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂(μs k)) → (∀ K : Set (Euclid P), IsCompact K → limsup (fun k => μs k K) atTop ≤ ENNReal.ofReal θ₀ * ν K) → (∀ k, μs k (Ns k)ᶜ = 0) → (∀ K : Set (Euclid P), IsCompact K → limsup (fun k => μHE[(d + 1)] (Ns k ∩ K)) atTop ≤ ν K) → ∀ i, 1 ≤ α i := by
  intro hREP hSL hCT P d v θ₀ N w α ν C Γs μs ξs Ns hv hθ₀ hw hwv hα hν hC hΓC hΓb hμfin
    hξmeas hξbd hΓrep hlimsup hNs hNlim i₀
  -- Step 0: the coordinate projection `pL x = (⟨v₀, x⟩, …, ⟨v_d, x⟩)` onto `ℝⁿ`, `n = d + 1`
  let pL : Euclid P →L[ℝ] Euclid (d + 1) :=
    (EuclideanSpace.equiv (Fin (d + 1)) ℝ).symm.toContinuousLinearMap ∘L
      ContinuousLinearMap.pi (fun i => innerSL ℝ (v i))
  have hpL : ∀ (x : Euclid P) (i : Fin (d + 1)), pL x i = inner ℝ (v i) x := by
    intro x i
    simp [pL]
  have hpLv : ∀ j, pL (v j) = EuclideanSpace.single j (1 : ℝ) := by
    intro j
    ext i
    rw [hpL, orthonormal_iff_ite.mp hv i j]
    simp [eq_comm]
  obtain ⟨hcb1, -⟩ := Submission.cbr_ci_pw_orthonormal_covector_bounds P (d + 1) v pL hv hpL
  -- the plane `Pl₀ = V₀ + w i₀`
  set Pl₀ : Set (Euclid P) := {y : Euclid P | y - w i₀ ∈ Submodule.span ℝ (Set.range v)}
  have hPlmeas : MeasurableSet Pl₀ :=
    ((Submodule.span ℝ (Set.range v)).closed_of_finiteDimensional.preimage
      (continuous_id.sub continuous_const)).measurableSet
  have hmapPl : ∀ i, Measure.map pL ((μHE[(d + 1)]).restrict
      {y : Euclid P | y - w i ∈ Submodule.span ℝ (Set.range v)}) = volume :=
    fun i => Submission.cbr_ci_pw_plane_map_volume P (d + 1) v (w i) pL hv hpL
  have hmap0 : Measure.map pL ((μHE[(d + 1)]).restrict Pl₀) = volume := hmapPl i₀
  -- `ν` is finite on compact sets: `Hⁿ(K ∩ (V₀ + w i)) ≤ Lⁿ(pL K)`
  have hνK : ∀ K : Set (Euclid P), IsCompact K → ν K < ∞ := by
    intro K hK
    rw [hν, Measure.coe_finsetSum, Finset.sum_apply]
    refine ENNReal.sum_lt_top.2 fun i _ => ?_
    rw [Measure.smul_apply, smul_eq_mul]
    refine ENNReal.mul_lt_top ENNReal.ofReal_lt_top ?_
    calc (μHE[(d + 1)]).restrict {y : Euclid P | y - w i ∈ Submodule.span ℝ (Set.range v)} K
        ≤ (μHE[(d + 1)]).restrict {y : Euclid P | y - w i ∈ Submodule.span ℝ (Set.range v)}
            (pL ⁻¹' (pL '' K)) := measure_mono (subset_preimage_image _ _)
      _ ≤ Measure.map pL ((μHE[(d + 1)]).restrict
