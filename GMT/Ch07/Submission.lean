    rw [ENNReal.le_div_iff_mul_le (Or.inl (ENNReal.ofReal_pos.2 hcpos).ne')
      (Or.inl ENNReal.ofReal_ne_top)]
    have hint : IntegrableOn (fun y => |u k y - c|) (ball (0 : Euclid (d + 1)) 1) :=
      (((hu_int k).mono_set hB1U).sub (integrableOn_const measure_ball_lt_top.ne)).abs
    rw [ofReal_integral_eq_lintegral_ofReal hint (ae_of_all _ fun y => abs_nonneg _), mul_comm]
    calc ENNReal.ofReal c * volume (ball (0 : Euclid (d + 1)) 1 ∩ {y | u k y = 0})
        ≤ ENNReal.ofReal c * (volume.restrict (ball (0 : Euclid (d + 1)) 1))
            {y | ENNReal.ofReal c ≤ ENNReal.ofReal |u k y - c|} := by
          refine mul_le_mul_of_nonneg_left
            ((measure_mono ?_).trans (Measure.le_restrict_apply _ _)) zero_le
          rintro y ⟨hy, hy0⟩
          refine ⟨?_, hy⟩
          have hy0' : u k y = 0 := hy0
          show ENNReal.ofReal c ≤ ENNReal.ofReal |u k y - c|
          rw [hy0', zero_sub, abs_neg, abs_of_pos hcpos]
      _ ≤ ∫⁻ y in ball (0 : Euclid (d + 1)) 1, ENNReal.ofReal |u k y - c| :=
          mul_meas_ge_le_lintegral₀ hint.aemeasurable.ennreal_ofReal _
  have ha : Tendsto (fun k => ENNReal.ofReal (∫ y in ball (0 : Euclid (d + 1)) 1, |u k y - c|) /
      ENNReal.ofReal c) atTop (𝓝 0) := by
    have := ENNReal.Tendsto.div_const (ENNReal.tendsto_ofReal hl1)
      (Or.inr (ENNReal.ofReal_pos.2 hcpos).ne')
    simpa using this
  -- `Lⁿ(B₁) ≤ ν(A₁)`
  have hvol : volume (ball (0 : Euclid (d + 1)) 1) ≤ ν A₁ := by
    refine ENNReal.le_of_forall_pos_le_add fun ε hε _ => ?_
    have hev : ∀ᶠ k in atTop,
        volume (ball (0 : Euclid (d + 1)) 1) - ε ≤ μHE[(d + 1)] (Ns (φ k) ∩ A₁) := by
      filter_upwards [ENNReal.tendsto_nhds_zero.1 ha ε (by exact_mod_cast hε)] with k hk
      rw [tsub_le_iff_left]
      have hsplit : ball (0 : Euclid (d + 1)) 1 \ {y | u k y ≠ 0} =
          ball (0 : Euclid (d + 1)) 1 ∩ {y | u k y = 0} := by
        ext y
        simp
      calc volume (ball (0 : Euclid (d + 1)) 1)
          ≤ volume (ball (0 : Euclid (d + 1)) 1 ∩ {y | u k y ≠ 0}) +
              volume (ball (0 : Euclid (d + 1)) 1 \ {y | u k y ≠ 0}) :=
            measure_le_inter_add_sdiff _ _ _
        _ ≤ μHE[(d + 1)] (Ns (φ k) ∩ A₁) + ε := by
            rw [hsplit]
            exact add_le_add (hnz k) ((hzero k).trans hk)
        _ = ε + μHE[(d + 1)] (Ns (φ k) ∩ A₁) := add_comm _ _
    have h1 : volume (ball (0 : Euclid (d + 1)) 1) - ε ≤ ν A₁ :=
      calc volume (ball (0 : Euclid (d + 1)) 1) - ε
          ≤ liminf (fun k => μHE[(d + 1)] (Ns (φ k) ∩ A₁)) atTop :=
            le_liminf_of_le (by isBoundedDefault) hev
        _ ≤ limsup (fun k => μHE[(d + 1)] (Ns (φ k) ∩ A₁)) atTop := liminf_le_limsup
        _ ≤ limsup (fun k => μHE[(d + 1)] (Ns k ∩ A₁)) atTop :=
            hφ.tendsto_atTop.limsup_comp_le_limsup (u := fun k => μHE[(d + 1)] (Ns k ∩ A₁))
        _ ≤ ν A₁ := hNlim A₁ hA₁c
    exact tsub_le_iff_right.1 h1
  -- `ν(A₁) = α_{i₀} Lⁿ(B̄₁)`
  have hνA₁ : ν A₁ = ENNReal.ofReal (α i₀) * volume (closedBall (0 : Euclid (d + 1)) 1) := by
    have hA₁sub : A₁ ⊆ {x | g x < 3 * δ} := fun x hx => lt_of_le_of_lt hx.1 ht3
    rw [hνsub A₁ hA₁sub, ← hmap0, Measure.map_apply pL.continuous.measurable
      measurableSet_closedBall, Measure.restrict_apply' hPlmeas, Measure.restrict_apply' hPlmeas]
    congr 2
    ext x
    constructor
    · rintro ⟨⟨_, hx⟩, hxP⟩
      exact ⟨hx, hxP⟩
    · rintro ⟨hx, hxP⟩
      exact ⟨⟨hFS (hPlF hxP), hx⟩, hxP⟩
  -- conclusion: `Lⁿ(B₁) ≤ α_{i₀} Lⁿ(B₁)` with `0 < Lⁿ(B₁) < ∞`
  rw [hνA₁, Measure.addHaar_closedBall_eq_addHaar_ball] at hvol
  have hball : volume (ball (0 : Euclid (d + 1)) 1) ≠ 0 := (measure_ball_pos _ _ one_pos).ne'
  have hball' : volume (ball (0 : Euclid (d + 1)) 1) ≠ ∞ := measure_ball_lt_top.ne
  have h1 : 1 * volume (ball (0 : Euclid (d + 1)) 1) ≤
      ENNReal.ofReal (α i₀) * volume (ball (0 : Euclid (d + 1)) 1) := by
    rwa [one_mul]
  exact ENNReal.one_le_ofReal.1 ((ENNReal.mul_le_mul_iff_left hball hball').1 h1)

/-- **A positive multiple of an oriented `n`-plane with the integer slice property has integer
multiplicity** (Simon Ch. 6, 8.2, the integrality step; step 10 of the integer multiplicity
criterion for cycles).  Here `n = d + 1`, `v = (v₁, …, vₙ)` is orthonormal, `V₀ = span v`, `θ₀ > 0`,
`C(ω) = θ₀ ∫_{V₀} ⟨ω, v₁ ∧ ⋯ ∧ vₙ⟩ dHⁿ`, and `C` has the integer slice property.
`Submission.cbr_cipi_slice_integer_multiplicity` (slicing `C` by `⟨·, v₁⟩` with (SL), plus the
half-space Stokes formula) gives, for `L¹`-a.e. `t`, an integer multiplicity current `Z` with
`Z(φ) = θ₀ ∫_{L_t} ⟨φ, v₂ ∧ ⋯ ∧ vₙ⟩ dH^d`, where `L_t = t v₁ + span(v₂, …, vₙ)`.  The a.e.
filter of `L¹` is non-trivial, so fix such `t` and `Z`, and an IMRep `R` of `Z`.  `(v₂, …, vₙ)` is
orthonormal, so `Submission.cbr_cipi_affine_plane_measure` shows that `L_t` is closed and that
`ν = H^d⌞L_t` is finite on compact sets and positive on `B₁(t v₁)`.  Let
`ζ₀ = θ₀ (v₂ ∧ ⋯ ∧ vₙ)`, i.e. `⟨α, ζ₀⟩ = θ₀ α(v₂, …, vₙ)`.  Then `|⟨α, ζ₀⟩| ≤ θ₀ |α|`
(`Submission.regcomp_covector_eval_orthonormal_le`), `⟨β, ζ₀⟩ = θ₀` for some `β` with `|β| = 1`
(`Submission.regcomp_exists_covector_eval_orthonormal_eq_one`), and `Z(φ) = ∫ ⟨φ, ζ₀⟩ dν`.  So
`Submission.cbr_ci_const_vector_massOn` gives `M_G(Z) = θ₀ ν(G)` for every open `G`, and (MR) gives
`M_G(Z) = R.measure(G)`.  Hence `R.measure(G) = θ₀ ν(G)` for every open `G`, and
`Submission.cbr_cipi_imrep_weight_const_nat` gives `θ₀ ∈ ℕ`. -/
theorem Submission.cbr_ci_plane_multiplicity_nat : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → ∀ (P d : ℕ) (v : Fin (d + 1) → Euclid P) (θ₀ : ℝ) (C : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), Orthonormal ℝ v → 0 < θ₀ → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = θ₀ * ∫ y in (Submodule.span ℝ (Set.range v) : Set (Euclid P)), (ω : DifferentialForm (Euclid P) (d + 1)) y v ∂μHE[(d + 1)]) → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (C).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B)) → ∃ m : ℕ, θ₀ = m := by
  intro hMR hSL P d v θ₀ C hv hθ₀ hC hISP
  -- Step 1: for a.e. `t` the slice boundary `Z` is integer multiplicity, with
  -- `Z(φ) = θ₀ ∫_{L_t} ⟨φ, v₂ ∧ ⋯ ∧ vₙ⟩ dH^d`; the a.e. filter on `ℝ` is non-trivial
  obtain ⟨t, Z, ⟨R, hR⟩, hZ⟩ :=
    (Submission.cbr_cipi_slice_integer_multiplicity hSL P d v θ₀ C hv hθ₀ hC hISP).exists
  -- Step 2: `L_t` is closed, and `ν = H^d⌞L_t` is finite on compact sets and positive on
  -- `B₁(t v₁)`
  have hw : Orthonormal ℝ (Fin.tail v) := hv.comp Fin.succ (Fin.succ_injective d)
  obtain ⟨-, hclosed, hfin, hpos⟩ :=
    Submission.cbr_cipi_affine_plane_measure P d (Fin.tail v) (t • v 0) hw
  -- Step 3: the constant `d`-vector `ζ₀ = θ₀ (v₂ ∧ ⋯ ∧ vₙ)`
  obtain ⟨ζ₀, hζ₀⟩ : ∃ ζ₀ : MultiVector P d, ∀ α : Covector (Euclid P) d,
      ζ₀ α = θ₀ * α (Fin.tail v) :=
    ⟨θ₀ • ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (Fin.tail v), fun α => rfl⟩
  -- Step 4: `M_G(Z) = θ₀ ν(G)` for open `G`: `|⟨α, ζ₀⟩| ≤ θ₀ |α|`, `ζ₀` is normed by a unit
  -- covector, and `Z(φ) = ∫ ⟨φ, ζ₀⟩ dν`
  have hmass := Submission.cbr_ci_const_vector_massOn P d _ ζ₀ θ₀ Z hfin
    (fun α => by
      rw [hζ₀, abs_mul, abs_of_pos hθ₀]
      exact mul_le_mul_of_nonneg_left
        (Submission.regcomp_covector_eval_orthonormal_le P d α _ hw) hθ₀.le)
    (by
      obtain ⟨β, hβ1, hβv⟩ :=
        Submission.regcomp_exists_covector_eval_orthonormal_eq_one P d _ hw
      exact ⟨β, hβ1.le, by rw [hζ₀, hβv, mul_one]⟩)
    (fun φ => by
      rw [hZ φ, ← integral_const_mul]
      simp only [hζ₀])
  -- Step 5: by (MR), `R.measure(G) = M_G(Z) = θ₀ ν(G)` for open `G`; the IM weight is then `θ₀`
  -- on a set of positive measure, so `θ₀ ∈ ℕ`
  exact Submission.cbr_cipi_imrep_weight_const_nat P d univ R _ θ₀ hθ₀ hclosed.measurableSet
    hfin ⟨t • v 0, 1, hpos 1 one_pos⟩ fun G hG => by
      rw [← hMR P d univ Z R isOpen_univ hR G hG, hmass G hG]

/-- **Pointwise tangent plane and integer multiplicity at a good point** (step 9 of White's proof
that the cycles of the closure theorem are integer multiplicity, with the blow-up steps 5–8 and
the integrality step 10; Simon Ch. 6, 3.11 and 8.2–8.3; B. White, Comment. Math. Helv. 64 (1989)
207–220).  Let `θ₀ := θ(a) > 0` and let `η₀` be the lower density constant of `LD`.  *Claim*:
every blow-up sequence `λᵢ ↓ 0` has a subsequence along which `Hⁿ⌞η_{a,λᵢ}(M) → Hⁿ⌞span v` for
an orthonormal `v` with `ζ(a) = v₁ ∧ ⋯ ∧ vₙ`, and `θ₀ ∈ ℕ`.  Indeed
`Submission.dtc_bc_tc_cl_ci_blowup_limit` gives a subsequence and a limit cycle `C = θ₀ ζ(a) ν`
with the integer slice property.  `LD` applied to `C` with the measure `θ₀ ν` and the constant
field `ζ(a)` gives `ν` lower density `η₀/θ₀`, and `∂C = 0` gives `∫ ⟨dψ, ζ(a)⟩ dν = 0`, so
`Submission.cbr_ci_constant_cycle_planes` gives `ζ(a) = v₁ ∧ ⋯ ∧ vₙ` and
`ν = Σᵢ αᵢ Hⁿ⌞(wᵢ + span v)` with `Σᵢ αᵢ ≤ 1` and some `wᵢ = 0`.
`Submission.cbr_ci_plane_weight_ge_one` gives `αᵢ ≥ 1`, so there is a single plane and
`ν = Hⁿ⌞span v`, and `Submission.cbr_ci_plane_multiplicity_nat` gives `θ₀ ∈ ℕ`.  The claim for
`λᵢ = 1/(i+1)` gives the plane `Q := span v₀`, of dimension `n`, oriented by `ζ(a)`.  For any
other sequence the plane `span v` is `Q`: `β(v) = ζ(a)(β) = β(v₀)` for every `n`-covector `β`,
and a unit orientation determines its plane (evaluate on the determinant covectors
`u ↦ det (⟨w_b, u_a⟩)` of `Submission.cbr_ci_cp_pr_inner_det_covector` and use Cramer's rule).
As `𝓝[>] 0` is countably generated, the subsequence principle makes `Q` the approximate tangent
space of `M` at `a`. -/
theorem Submission.dtc_bc_tc_cl_ci_pointwise_tangent_integer : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → (∀ (P k : ℕ) (U : Set (Euclid P)) (μ₁ μ₂ μ₃ : Measure (Euclid P)) (ξ₁ ξ₂ ξ₃ : Euclid P → MultiVector P k), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ₁ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ₂ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ₃ K < ∞) → AEStronglyMeasurable ξ₁ μ₁ → AEStronglyMeasurable ξ₂ μ₂ → AEStronglyMeasurable ξ₃ μ₃ → (∀ᵐ x ∂μ₁, ∀ α : Covector (Euclid P) k, |ξ₁ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ₂, ∀ α : Covector (Euclid P) k, |ξ₂ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ₃, ∀ α : Covector (Euclid P) k, |ξ₃ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U k, ∫ x, ξ₁ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₁ = ∫ x, ξ₂ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₂ + ∫ x, ξ₃ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₃) → ∀ (B : Set (Euclid P)) (ω : TestFormOn U k), MeasurableSet B → ∫ x in B, ξ₁ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₁ = ∫ x in B, ξ₂ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₂ + ∫ x in B, ξ₃ x ((ω : DifferentialForm (Euclid P) k) x) ∂μ₃) → ((∀ (P : ℕ) (U : Set (Euclid P)) (μs : ℕ → Measure (Euclid P)), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ⨆ j, μs j K < ∞) → ∃ (φ : ℕ → ℕ) (μ : Measure (Euclid P)), StrictMono φ ∧ μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → tsupport f ⊆ U → Tendsto (fun j => ∫ x, f x ∂(μs (φ j))) atTop (𝓝 (∫ x, f x ∂μ))) ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → limsup (fun j => μs (φ j) K) atTop ≤ μ K) ∧ (∀ G : Set (Euclid P), IsOpen G →