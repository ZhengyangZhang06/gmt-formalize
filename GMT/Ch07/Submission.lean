      obtain ⟨hxe, Q, hQ, hQo, hLQ⟩ := hxg
      refine ⟨Q ⊓ Lᗮ, hx Q hQ, ?_⟩
      rw [hζ_def, hxe]
      exact hζunit _ Q hQo hLQ
