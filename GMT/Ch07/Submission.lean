    hneq _ _ (hΓsm.comp_measurable measurable_add) (hΓsm.comp_measurable measurable_fst)
  have hMtm : ∀ s : Euclid P, MeasurableSet (R.carrier ∩ {x | L.starProjection x = s}) :=
    fun s => R.measurableSet_carrier.inter
