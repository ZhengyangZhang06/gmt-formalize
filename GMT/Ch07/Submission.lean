          _ = ‖a‖ + |c * Real.sin (τ / c)| * ‖w‖ := by rw [norm_smul, Real.norm_eq_abs]
          _ ≤ ‖a‖ + c * ‖w‖ := by gcongr
          _ < ‖a‖ + c * (‖w‖ + 1) := by nlinarith
          _ = s := by rw [hcw]; ring
