      simp
    refine ⟨(hYa _ L₀ hL₀).1, ?_, ?_, hH4, ?_⟩
    -- step 6 (H2): `Ĥ_{F,G} = Ĥ_{F',G'}` on `ι([0,1] × E)`, which carries `R'` a.e.
    · intro F' G' hF' hG' hFF' hGG'
      obtain ⟨L₁, hL₁⟩ :=
