      exact (ENNReal.mul_div_cancel_right
        (mul_ne_zero hU1 (ENNReal.ofReal_pos.2 (pow_pos hs.1 _)).ne')
        (ENNReal.mul_ne_top hU2 ENNReal.ofReal_ne_top)).symm
    have h := tendsto_nhds_unique hdens.2 (tendsto_const_nhds.congr' hev)
    rw [ENNReal.ofReal_natCast] at h
    exact h.symm
  -- Step 14: `M_W(T) = k |Φ⁻¹ W| = k Hⁿ(W ∩ Q)`
  rw [hmassW W hW hWB, hck, ← EuclideanSpace.euclideanHausdorffMeasure_eq_volume,
    ← hΦiso.euclideanHausdorffMeasure_image, image_preimage_eq_inter_range, hΦrange]
/-- A `2`-dimensional minimizing cone `C` in `ℝᴾ` with `∂C = 0` and constant density `k` on
`spt C ∩ B_δ(p)`, `p ≠ 0`, is `k` times a plane `Q ∋ p` near `p` (the local half of the planar
structure of such cones used in Simon 7.3.3(1), cited there from [Whi82]).  Constant density makes
`p` a regular point.  Then `k ≥ 1`: if `k = 0`, write `C = m[[M']]` near `p` with `m ≠ 0`.  A chart
`ψ` of `M'` with `ψ(v₀) = p` is bi-Lipschitz near `v₀`, so `H²(M' ∩ B_r(p)) ≥ c r²`.  Testing `C`
on `g α₀`, with `g` a bump at `p` and `ξ(p)(α₀) = ±1`, gives `M_{B_s(p)}(C) ≥ c' s²`, contradicting
density `0` at `p`.  Near `p`, `spt C` is an embedded `C¹` surface `M`.  Since `C` is stationary,
`0 = δV(X) = k ∫_{M ∩ B_ρ(p)} div_M X dH²`, so `M` is stationary in `B_ρ(p)`.  It is radially
invariant because `spt C` is a cone.  So `M` agrees with a plane `Q ∋ p` near `p`, and the
constancy theorem gives `M_W(C) = k H²(W ∩ Q)`. -/
theorem Submission.idtp_cone_constant_density_planar : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2) (p : Euclid P) (k : ℕ) (δ : ℝ), IsMinimizingIn C univ → BoundaryVanishes C → IsConeCurrent C → p ∈ C.support → p ≠ 0 → 0 < δ → (∀ y ∈ C.support, y ∈ ball p δ → HasMassDensity C y k) → ∃ (δ' : ℝ) (Q : Submodule ℝ (Euclid P)), 0 < δ' ∧ Module.finrank ℝ Q = 2 ∧ p ∈ Q ∧ C.support ∩ ball p δ' = (Q : Set (Euclid P)) ∩ ball p δ' ∧ ∀ W : Set (Euclid P), IsOpen W → W ⊆ ball p δ' → C.massOn W = (k : ℝ≥0∞) * μHE[2] (W ∩ (Q : Set (Euclid P))) := by
  intro P C p k δ hmin hbd hcone hp hp0 hδ hdens
  -- Step 1: `C = τ(M, θ, ξ)` for some integer multiplicity representation `R`
  obtain ⟨R, hR⟩ := hmin.1
  -- Step 2: constant density `k` on `spt C ∩ B_δ(p)` makes `p` a regular point
  have hreg : p ∈ regularSet C :=
    Submission.idtp_ccd_regular_of_const_density P 2 univ C p k δ (by norm_num) isOpen_univ hmin
      hbd hp hδ hdens
  -- Step 3: `k ≥ 1`.  Otherwise `C` has density `0` at the regular point `p`; we show
  -- `M_{B_s(p)}(C) ≥ c₀ s²` for small `s > 0` with `c₀ > 0`
  have hk : 1 ≤ k := by
    by_contra hk0
    have h0 : HasMassDensity C p 0 := by
      have h := hdens p hp (mem_ball_self hδ)
      rwa [show k = 0 by omega, Nat.cast_zero] at h
    obtain ⟨-, ρ₀, hρ₀, -, m, M', ξ, hm, hpM', hM', hξ, hfin, hrep⟩ := hreg
    -- (a) a chart `ψ` of `M'` with `ψ v₀ = p`; `L = Dψ(v₀)` is injective
    obtain ⟨V, W, ψ, hV, hW, hpW, hψ, -, himg, hprop, hder⟩ := hM' p hpM'
    obtain ⟨v₀, hv₀V, hv₀⟩ : p ∈ ψ '' V := by rw [himg]; exact ⟨hpW, hpM'⟩
    have hstrict : HasStrictFDerivAt ψ (fderiv ℝ ψ v₀) v₀ :=
      (hψ.contDiffAt (hV.mem_nhds hv₀V)).hasStrictFDerivAt (by norm_num)
    obtain ⟨K, hK, hKL⟩ := LinearMap.exists_antilipschitzWith
      ((fderiv ℝ ψ v₀ : Euclid 2 →L[ℝ] Euclid P) : Euclid 2 →ₗ[ℝ] Euclid P)
      (LinearMap.ker_eq_bot.2 (hder v₀ hv₀V))
    obtain ⟨s, hs, happrox⟩ := hstrict.approximates_deriv_on_nhds (c := (2 * K)⁻¹)
      (Or.inr (inv_pos.2 (mul_pos two_pos hK)))
    obtain ⟨r₀, hr₀, hr₀s⟩ := Metric.mem_nhds_iff.1 (Filter.inter_mem hs (hV.mem_nhds hv₀V))
    have hKr : (0 : ℝ) < K := hK
    -- (b) `‖a - b‖ ≤ 2K‖ψ a - ψ b‖` and `‖ψ a - p‖ ≤ (Λ - 1)‖a - v₀‖` on `B_{r₀}(v₀)`
    have happ : ∀ a ∈ ball v₀ r₀, ∀ b ∈ ball v₀ r₀,
        ‖ψ a - ψ b - fderiv ℝ ψ v₀ (a - b)‖ ≤ (2 * (K : ℝ))⁻¹ * ‖a - b‖ := by
      intro a ha b hb
      have h := happrox a (hr₀s ha).1 b (hr₀s hb).1
      simpa using h
    have hlow : ∀ a ∈ ball v₀ r₀, ∀ b ∈ ball v₀ r₀,
        dist a b ≤ 2 * (K : ℝ) * dist (ψ a) (ψ b) := by
      intro a ha b hb
      have h1 : ‖a - b‖ ≤ K * ‖fderiv ℝ ψ v₀ (a - b)‖ := by
        have h := hKL.le_mul_dist a b
        simpa [dist_eq_norm, map_sub] using h
      have h3 : ‖fderiv ℝ ψ v₀ (a - b)‖ ≤
          ‖ψ a - ψ b‖ + ‖ψ a - ψ b - fderiv ℝ ψ v₀ (a - b)‖ :=
        calc ‖fderiv ℝ ψ v₀ (a - b)‖ = ‖(ψ a - ψ b) - (ψ a - ψ b - fderiv ℝ ψ v₀ (a - b))‖ := by
              congr 1; abel
          _ ≤ _ := norm_sub_le _ _
      have hKz : (K : ℝ) * ‖ψ a - ψ b - fderiv ℝ ψ v₀ (a - b)‖ ≤ ‖a - b‖ / 2 :=
        calc (K : ℝ) * ‖ψ a - ψ b - fderiv ℝ ψ v₀ (a - b)‖
            ≤ K * ((2 * (K : ℝ))⁻¹ * ‖a - b‖) := mul_le_mul_of_nonneg_left (happ a ha b hb) hKr.le
          _ = ‖a - b‖ / 2 := by field_simp
      rw [dist_eq_norm, dist_eq_norm]
      nlinarith [mul_le_mul_of_nonneg_left h3 hKr.le]
    set Λ : ℝ := ‖fderiv ℝ ψ v₀‖ + (2 * (K : ℝ))⁻¹ + 1 with hΛ
    have hΛpos : 0 < Λ := by positivity
    have hup : ∀ a ∈ ball v₀ r₀, dist (ψ a) p ≤ (Λ - 1) * dist a v₀ := by
      intro a ha
      have h4 : ‖fderiv ℝ ψ v₀ (a - v₀)‖ ≤ ‖fderiv ℝ ψ v₀‖ * ‖a - v₀‖ := (fderiv ℝ ψ v₀).le_opNorm _
      have h5 : ‖ψ a - ψ v₀‖ ≤
          ‖fderiv ℝ ψ v₀ (a - v₀)‖ + ‖ψ a - ψ v₀ - fderiv ℝ ψ v₀ (a - v₀)‖ :=
        calc ‖ψ a - ψ v₀‖ = ‖fderiv ℝ ψ v₀ (a - v₀) + (ψ a - ψ v₀ - fderiv ℝ ψ v₀ (a - v₀))‖ := by
              congr 1; abel
          _ ≤ _ := norm_add_le _ _
      have h6 := happ a ha v₀ (mem_ball_self hr₀)
      rw [dist_eq_norm, dist_eq_norm, ← hv₀]
      have hΛ1 : Λ - 1 = ‖fderiv ℝ ψ v₀‖ + (2 * (K : ℝ))⁻¹ := by rw [hΛ]; ring
      rw [hΛ1]
      nlinarith
    -- (c) area lower bound `ω₂ t² ≤ (2K)² H²(ψ(B_t(v₀)))` for `0 < t ≤ r₀`
    have harea : ∀ t, 0 < t → t ≤ r₀ →
        ENNReal.ofReal (t ^ 2) * unitBallVolume 2 ≤
          ((2 * K : NNReal) : ℝ≥0∞) ^ (2 : ℝ) * μHE[2] (ψ '' ball v₀ t) := by
      intro t ht htr
      have hanti : AntilipschitzWith (2 * K) (fun a : ball v₀ t => ψ a) := by
        refine AntilipschitzWith.of_le_mul_dist fun a b => ?_
        have h := hlow a (ball_subset_ball htr a.2) b (ball_subset_ball htr b.2)
        simpa [Subtype.dist_eq] using h
      have h1 := hanti.le_hausdorffMeasure_image (d := 2) (by norm_num) univ
      rw [← (isometry_subtype_coe (s := ball v₀ t)).hausdorffMeasure_image (Or.inl (by norm_num))
        univ, image_univ, Subtype.range_coe, image_univ] at h1
      have hrange : range (fun a : ball v₀ t => ψ a) = ψ '' ball v₀ t := by
        ext y
        constructor
        · rintro ⟨a, rfl⟩
          exact ⟨a, a.2, rfl⟩
        · rintro ⟨a, ha, rfl⟩
          exact ⟨⟨a, ha⟩, rfl⟩
      rw [hrange] at h1
      have hvol : (μHE[2] : Measure (Euclid 2)) (ball v₀ t) =
          ENNReal.ofReal (t ^ 2) * unitBallVolume 2 := by
        rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume, Measure.addHaar_ball _ _ ht.le,
          finrank_euclideanSpace_fin]
        rfl
      rw [← hvol, Measure.euclideanHausdorffMeasure_def, Measure.euclideanHausdorffMeasure_def,
        Measure.smul_apply, Measure.smul_apply, ENNReal.smul_def, ENNReal.smul_def, smul_eq_mul,
        smul_eq_mul]
      simp only [Nat.cast_ofNat]
      calc _ ≤ _ * (((2 * K : NNReal) : ℝ≥0∞) ^ (2 : ℝ) * μH[2] (ψ '' ball v₀ t)) :=
            mul_le_mul_of_nonneg_left h1 (by simp)
        _ = _ := by ring
    have himgsub : ∀ t, 0 < t → t ≤ r₀ → ψ '' ball v₀ t ⊆ M' ∩ ball p (Λ * t) := by
      rintro t ht htr _ ⟨a, ha, rfl⟩
      have haV : a ∈ V := (hr₀s (ball_subset_ball htr ha)).2
      have hψa : ψ a ∈ W ∩ M' := by rw [← himg]; exact mem_image_of_mem ψ haV
      refine ⟨hψa.2, mem_ball.2 ?_⟩
      have hΛ1 : 0 ≤ Λ - 1 := by
        have h1 := norm_nonneg (fderiv ℝ ψ v₀)
        have h2 : 0 < (2 * (K : ℝ))⁻¹ := by positivity
        rw [hΛ]
        linarith
      calc dist (ψ a) p ≤ (Λ - 1) * dist a v₀ := hup a (ball_subset_ball htr ha)
        _ ≤ (Λ - 1) * t := mul_le_mul_of_nonneg_left (mem_ball.1 ha).le hΛ1
        _ < Λ * t := by nlinarith
    -- (d) a covector `α₀` with `σ₀ ξ(p)(α₀) = 1`, and `|ξ(x)(α₀)| ≤ ‖α₀‖` on `M'`
    obtain ⟨Q₀, -, τ, hτ, -, hτξ⟩ := hξ.2 p hpM'
    let α₀ : Covector (Euclid P) 2 := ContinuousMultilinearMap.alternatization
      ((ContinuousMultilinearMap.mkPiAlgebra ℝ (Fin 2) ℝ).compContinuousLinearMap
        (fun i => innerSL ℝ (τ i)))
    have hα₀ : α₀ τ = 1 := by
      simp only [α₀, ContinuousMultilinearMap.alternatization_apply_apply,
        ContinuousMultilinearMap.compContinuousLinearMap_apply,
        ContinuousMultilinearMap.mkPiAlgebra_apply, innerSL_apply_apply, Function.comp_apply]
      rw [Finset.sum_eq_single (1 : Equiv.Perm (Fin 2))]
      · simp [hτ.1]
      · intro σ _ hσ
        obtain ⟨i, hi⟩ := not_forall.1 fun h : ∀ i, σ i = i => hσ (Equiv.ext h)
        rw [Finset.prod_eq_zero (Finset.mem_univ i), smul_zero]
        rw [orthonormal_iff_ite.1 hτ i (σ i)]
        exact ite_eq_right_iff.2 fun h => absurd h.symm hi
      · intro h
        exact absurd (Finset.mem_univ _) h
    obtain ⟨σ₀, hσ₀, hσ₀p⟩ : ∃ σ₀ : ℝ, |σ₀| = 1 ∧ σ₀ * ξ p α₀ = 1 := by
      rcases hτξ with h | h
      · exact ⟨1, abs_one, by rw [h, hα₀, one_mul]⟩
      · exact ⟨-1, by norm_num, by rw [h, hα₀]; norm_num⟩
    have hbound : ∀ x ∈ M', |ξ x α₀| ≤ ‖α₀‖ := by
      intro x hx
      obtain ⟨Q, -, τx, hτx, -, hτxξ⟩ := hξ.2 x hx
      have hn : ‖α₀ τx‖ ≤ ‖α₀‖ := by
        have h := α₀.le_opNorm τx
        simpa [hτx.1] using h
      rw [Real.norm_eq_abs] at hn
      rcases hτxξ with h | h
      · rw [h α₀]; exact hn
      · rw [h α₀, abs_neg]; exact hn
    have hcont : ContinuousOn (fun x => σ₀ * ξ x α₀) M' :=
      continuousOn_const.mul (hξ.1.clm_apply continuousOn_const)
    obtain ⟨s₀, hs₀, hs₀M⟩ := Metric.continuousWithinAt_iff.1 (hcont p hpM') (1 / 2) (by norm_num)
    have hpos : ∀ x ∈ M', dist x p < s₀ → 1 / 2 < σ₀ * ξ x α₀ := by
      intro x hx hxp
      have h := hs₀M hx hxp
      simp only [Real.dist_eq, hσ₀p] at h
      linarith [(abs_lt.1 h).1]
    -- (e) `M' ∩ closedBall(p, r)` is compact for small `r`
    obtain ⟨εW, hεW, hεWW⟩ := Metric.isOpen_iff.1 hW p hpW
    have hcpt : ∀ r, 0 < r → r < εW → IsCompact (closedBall p r ∩ M') := by
      intro r hr hrε
      have hKW : closedBall p r ⊆ W := (closedBall_subset_ball hrε).trans hεWW
      have heq : closedBall p r ∩ M' = ψ '' (V ∩ ψ ⁻¹' closedBall p r) := by
        ext x
        constructor
        · rintro ⟨hxK, hxM⟩
          have hx : x ∈ ψ '' V := by rw [himg]; exact ⟨hKW hxK, hxM⟩
          obtain ⟨a, haV, rfl⟩ := hx
          exact ⟨a, ⟨haV, hxK⟩, rfl⟩
        · rintro ⟨a, ⟨haV, haK⟩, rfl⟩
          have h : ψ a ∈ W ∩ M' := by rw [← himg]; exact mem_image_of_mem ψ haV
          exact ⟨haK, h.2⟩
      rw [heq]
      exact (hprop _ hKW (isCompact_closedBall p r)).image_of_continuousOn
        (hψ.continuousOn.mono inter_subset_left)
    -- (f) one admissible test form: `M_{B_s(p)}(C) ≥ |m| (N + 1)⁻¹ (1/2) H²(M' ∩ B_{s/4}(p))`
    have hscale : ∀ (c : ℝ) (α : Covector (Euclid P) 2),
        covectorEuclideanNorm (c • α) = |c| * covectorEuclideanNorm α := by
      intro c α
      unfold covectorEuclideanNorm
      rw [← Real.sqrt_sq_eq_abs, ← Real.sqrt_mul (sq_nonneg c), Finset.mul_sum]
      congr 1
      refine Finset.sum_congr rfl fun I _ => ?_
      split_ifs
      · rw [ContinuousAlternatingMap.smul_apply, smul_eq_mul]
        ring
      · simp
    set N := covectorEuclideanNorm α₀ with hN
    have hN0 : 0 ≤ N := covectorEuclideanNorm_nonneg α₀
    have hs₁pos : 0 < min (min s₀ ρ₀) εW := lt_min (lt_min hs₀ hρ₀) hεW
    have hmass : ∀ s, 0 < s → s < min (min s₀ ρ₀) εW →
        ENNReal.ofReal (|(m : ℝ)| * (N + 1)⁻¹ * (1 / 2 * (μHE[2] (M' ∩ ball p (s / 4))).toReal))
          ≤ C.massOn (ball p s) := by
      intro s hs hss₁
      have hss₀ : s < s₀ := hss₁.trans_le ((min_le_left _ _).trans (min_le_left _ _))
      have hsρ₀ : s < ρ₀ := hss₁.trans_le ((min_le_left _ _).trans (min_le_right _ _))
      have hsεW : s < εW := hss₁.trans_le (min_le_right _ _)
      let bump : ContDiffBump p := ⟨s / 4, s / 2, by positivity, by linarith⟩
      have hbsupp : support bump = ball p (s / 2) := bump.support_eq
      let ω₀ : DifferentialForm (Euclid P) 2 := fun x => (σ₀ / (N + 1) * bump x) • α₀
      have hsupp : support ω₀ ⊆ support bump := by
        intro x hx hbx
        exact hx (by simp [ω₀, hbx])
      have hω₀tsupp : tsupport ω₀ ⊆ closedBall p (s / 2) :=
        closure_minimal ((hsupp.trans hbsupp.subset).trans ball_subset_closedBall)
          isClosed_closedBall
      have hω₀test : IsTestForm ω₀ :=
        ⟨(contDiff_const.mul bump.contDiff).smul contDiff_const, bump.hasCompactSupport.mono hsupp⟩
      let ω : TestFormOn (univ : Set (Euclid P)) 2 := ⟨ω₀, hω₀test, subset_univ _⟩
      have hωnorm : ∀ x, covectorEuclideanNorm (ω₀ x) ≤ 1 := by
        intro x
        simp only [ω₀]
        rw [hscale, abs_mul, abs_div, hσ₀, abs_of_pos (by positivity : (0 : ℝ) < N + 1),
          abs_of_nonneg bump.nonneg]
        rw [show 1 / (N + 1) * bump x * N = bump x * N / (N + 1) by ring,
          div_le_one (by positivity)]
        nlinarith [bump.nonneg (x := x), bump.le_one (x := x)]
      have hadm : ω ∈ massAdmissibleOn univ 2 (ball p s) :=
        ⟨hω₀tsupp.trans (closedBall_subset_ball (by linarith)), hωnorm⟩
      have hadm' : -ω ∈ massAdmissibleOn univ 2 (ball p s) := by
        refine ⟨?_, fun x => ?_⟩
        · change tsupport (-ω₀) ⊆ ball p s
          rw [tsupport_neg]
          exact hadm.1
        · change covectorEuclideanNorm ((-ω₀) x) ≤ 1
          rw [Pi.neg_apply, covectorEuclideanNorm_neg]
          exact hωnorm x
      have hξω : ∀ x, ξ x (ω₀ x) = (N + 1)⁻¹ * (bump x * (σ₀ * ξ x α₀)) := by
        intro x
        change ξ x ((σ₀ / (N + 1) * bump x) • α₀) = _
        rw [map_smul, smul_eq_mul]
        ring
      have hval : C ω = m * ((N + 1)⁻¹ * ∫ x in M', bump x * (σ₀ * ξ x α₀) ∂μHE[2]) := by
        rw [hrep ω (hω₀tsupp.trans (closedBall_subset_ball (by linarith)))]
        congr 1
        rw [← integral_const_mul]
        exact integral_congr_ae (Eventually.of_forall fun x => hξω x)
      -- the integral over `M'` is at least `(1/2) H²(M' ∩ B_{s/4}(p))`
      have hKcpt := hcpt (s / 2) (by positivity) (by linarith)
      have hKmeas : MeasurableSet (closedBall p (s / 2) ∩ M') := hKcpt.isClosed.measurableSet
      have hKfin : μHE[2] (closedBall p (s / 2) ∩ M') ≠ ∞ := by
        rw [inter_comm]
        exact hfin _ (isCompact_closedBall _ _) (closedBall_subset_ball (by linarith))
      have hGzero : ∀ x ∉ closedBall p (s / 2), bump x * (σ₀ * ξ x α₀) = 0 := by
        intro x hx
        have hb : bump x = 0 := by
          rw [← notMem_support, hbsupp]
          exact fun h => hx (ball_subset_closedBall h)
        rw [hb, zero_mul]
      have hGeq : ∫ x in M', bump x * (σ₀ * ξ x α₀) ∂μHE[2] =
          ∫ x in closedBall p (s / 2) ∩ M', bump x * (σ₀ * ξ x α₀) ∂μHE[2] := by
        rw [← Measure.restrict_restrict measurableSet_closedBall,
          ← integral_indicator measurableSet_closedBall]
        refine integral_congr_ae (Eventually.of_forall fun x => ?_)
        by_cases hx : x ∈ closedBall p (s / 2)
        · rw [indicator_of_mem hx]
        · rw [indicator_of_notMem hx]
          exact hGzero x hx
      have : IsFiniteMeasure (μHE[2].restrict (closedBall p (s / 2) ∩ M')) :=
        isFiniteMeasure_restrict.2 hKfin
      have hGint : Integrable (fun x => bump x * (σ₀ * ξ x α₀))
          (μHE[2].restrict (closedBall p (s / 2) ∩ M')) := by
        refine Integrable.of_bound ?_ ‖α₀‖ (ae_restrict_of_forall_mem hKmeas fun x hx => ?_)
        · exact ((bump.continuous.continuousOn.mul hcont).mono
            inter_subset_right).aestronglyMeasurable hKmeas
        · rw [Real.norm_eq_abs, abs_mul, abs_mul, hσ₀, one_mul, abs_of_nonneg bump.nonneg]
          calc bump x * |ξ x α₀| ≤ 1 * ‖α₀‖ :=
                mul_le_mul bump.le_one (hbound x hx.2) (abs_nonneg _) zero_le_one
            _ = ‖α₀‖ := one_mul _
      have hpt : ∀ x ∈ closedBall p (s / 2) ∩ M',
          (ball p (s / 4)).indicator (fun _ => (1 / 2 : ℝ)) x ≤ bump x * (σ₀ * ξ x α₀) := by
        intro x hx
        have hxp : dist x p < s₀ := lt_of_le_of_lt (mem_closedBall.1 hx.1) (by linarith)
        have hgx := hpos x hx.2 hxp
        by_cases hxb : x ∈ ball p (s / 4)
        · rw [indicator_of_mem hxb]
          have hb1 : bump x = 1 := bump.one_of_mem_closedBall (ball_subset_closedBall hxb)
          rw [hb1, one_mul]
          linarith
        · rw [indicator_of_notMem hxb]
          exact mul_nonneg bump.nonneg (by linarith)
      have hle := integral_mono_of_nonneg
        (Eventually.of_forall fun x => indicator_nonneg (fun _ _ => by norm_num) x) hGint
        (ae_restrict_of_forall_mem hKmeas hpt)
      rw [integral_indicator_const _ measurableSet_ball,
        measureReal_restrict_apply measurableSet_ball, smul_eq_mul] at hle
      have hset : ball p (s / 4) ∩ (closedBall p (s / 2) ∩ M') = M' ∩ ball p (s / 4) := by
        ext x
        simp only [mem_inter_iff]
        constructor
        · rintro ⟨h1, -, h3⟩
          exact ⟨h3, h1⟩
        · rintro ⟨h3, h1⟩
          exact ⟨h1, ball_subset_closedBall (ball_subset_ball (by linarith) h1), h3⟩
      rw [hset, Measure.real] at hle
      have hint : 1 / 2 * (μHE[2] (M' ∩ ball p (s / 4))).toReal ≤
          ∫ x in M', bump x * (σ₀ * ξ x α₀) ∂μHE[2] := by
        rw [hGeq]
        linarith
      have hI0 : 0 ≤ ∫ x in M', bump x * (σ₀ * ξ x α₀) ∂μHE[2] :=
        le_trans (by positivity) hint
      have hCω : |C ω| = |(m : ℝ)| * (N + 1)⁻¹ * ∫ x in M', bump x * (σ₀ * ξ x α₀) ∂μHE[2] := by
        rw [hval, abs_mul, abs_mul, abs_inv, abs_of_pos (by positivity : (0 : ℝ) < N + 1),
          abs_of_nonneg hI0, mul_assoc]
      calc ENNReal.ofReal (|(m : ℝ)| * (N + 1)⁻¹ * (1 / 2 * (μHE[2] (M' ∩ ball p (s / 4))).toReal))
          ≤ ENNReal.ofReal |C ω| := by
            apply ENNReal.ofReal_le_ofReal
            rw [hCω]
            exact mul_le_mul_of_nonneg_left hint (by positivity)
        _ ≤ C.massOn (ball p s) := by
            rcases abs_cases (C ω) with ⟨h, -⟩ | ⟨h, -⟩
            · rw [h]
              exact C.le_massOn hadm
            · rw [h, ← map_neg]
              exact C.le_massOn hadm'
    -- (g) `M_{B_s(p)}(C)/(ω₂ s²) ≥ c₀/ω₂ > 0` for small `s`, contradicting density `0`
    have hω₂pos : unitBallVolume 2 ≠ 0 := (measure_ball_pos volume (0 : Euclid 2) one_pos).ne'
    have hω₂fin : unitBallVolume 2 ≠ ∞ := measure_ball_lt_top.ne
    have hω₂r : 0 < (unitBallVolume 2).toReal := ENNReal.toReal_pos hω₂pos hω₂fin
    have hm' : 0 < |(m : ℝ)| := abs_pos.2 (Int.cast_ne_zero.2 hm)
    set c₀ : ℝ := |(m : ℝ)| * (N + 1)⁻¹ * (1 / 2) *
      ((unitBallVolume 2).toReal / ((2 * (K : ℝ)) ^ 2 * (4 * Λ) ^ 2)) with hc₀
    have hc₀pos : 0 < c₀ := by positivity
    have hs₂pos : 0 < min (min (min s₀ ρ₀) εW) (4 * Λ * r₀) := lt_min hs₁pos (by positivity)
    have hratio : ∀ s ∈ Ioo 0 (min (min (min s₀ ρ₀) εW) (4 * Λ * r₀)),
        ENNReal.ofReal c₀ / unitBallVolume 2 ≤
          C.massOn (ball p s) / (unitBallVolume 2 * ENNReal.ofReal (s ^ 2)) := by
      rintro s ⟨hs, hss₂⟩
      have hss₁ : s < min (min s₀ ρ₀) εW := hss₂.trans_le (min_le_left _ _)
      have hsr : s ≤ 4 * Λ * r₀ := hss₂.le.trans (min_le_right _ _)
      have hsρ₀ : s < ρ₀ := hss₁.trans_le ((min_le_left _ _).trans (min_le_right _ _))
      have ht : 0 < s / (4 * Λ) := by positivity
      have htr : s / (4 * Λ) ≤ r₀ := by
        rw [div_le_iff₀ (by positivity)]
        linarith
      have hΛt : Λ * (s / (4 * Λ)) = s / 4 := by field_simp
      have hsub := himgsub _ ht htr
      rw [hΛt] at hsub
      have hAfin : μHE[2] (M' ∩ ball p (s / 4)) ≠ ∞ :=
        ne_top_of_le_ne_top (hfin (closedBall p (s / 2)) (isCompact_closedBall _ _)
          (closedBall_subset_ball (by linarith)))
          (measure_mono (inter_subset_inter_right _
            (ball_subset_closedBall.trans (closedBall_subset_closedBall (by linarith)))))
      have hA : ENNReal.ofReal ((s / (4 * Λ)) ^ 2) * unitBallVolume 2 ≤
          ((2 * K : NNReal) : ℝ≥0∞) ^ (2 : ℝ) * μHE[2] (M' ∩ ball p (s / 4)) :=
        (harea _ ht htr).trans (mul_le_mul_of_nonneg_left (measure_mono hsub) (by simp))
      rw [ENNReal.rpow_two] at hA
      have hA' : (s / (4 * Λ)) ^ 2 * (unitBallVolume 2).toReal ≤
          (2 * (K : ℝ)) ^ 2 * (μHE[2] (M' ∩ ball p (s / 4))).toReal := by
        have h := ENNReal.toReal_mono
          (ENNReal.mul_ne_top (ENNReal.pow_ne_top ENNReal.coe_ne_top) hAfin) hA
        rwa [ENNReal.toReal_mul, ENNReal.toReal_mul, ENNReal.toReal_ofReal (sq_nonneg _),
          ENNReal.toReal_pow, ENNReal.coe_toReal, NNReal.coe_mul, NNReal.coe_ofNat] at h
      have hH : (s / (4 * Λ)) ^ 2 * (unitBallVolume 2).toReal / (2 * (K : ℝ)) ^ 2 ≤
          (μHE[2] (M' ∩ ball p (s / 4))).toReal := by
        rw [div_le_iff₀ (by positivity)]
        linarith
      have hcs : ENNReal.ofReal (c₀ * s ^ 2) ≤ C.massOn (ball p s) := by
        refine le_trans (ENNReal.ofReal_le_ofReal ?_) (hmass s hs hss₁)
        have hc₀s : c₀ * s ^ 2 = |(m : ℝ)| * (N + 1)⁻¹ *
            (1 / 2 * ((s / (4 * Λ)) ^ 2 * (unitBallVolume 2).toReal / (2 * (K : ℝ)) ^ 2)) := by
          rw [hc₀]
          field_simp
        rw [hc₀s]
        gcongr
      calc ENNReal.ofReal c₀ / unitBallVolume 2
          = ENNReal.ofReal (c₀ * s ^ 2) / (unitBallVolume 2 * ENNReal.ofReal (s ^ 2)) := by
            rw [ENNReal.ofReal_mul hc₀pos.le, ENNReal.mul_div_mul_right _ _
              (ENNReal.ofReal_pos.2 (by positivity)).ne' ENNReal.ofReal_ne_top]
        _ ≤ _ := ENNReal.div_le_div_right hcs _
    have hge := ge_of_tendsto h0.2
      (Filter.mem_of_superset (Ioo_mem_nhdsGT hs₂pos) fun s hs => hratio s hs)
    rw [ENNReal.ofReal_zero, nonpos_iff_eq_zero] at hge
    exact (ENNReal.div_pos_iff.2 ⟨(ENNReal.ofReal_pos.2 hc₀pos).ne', hω₂fin⟩).ne' hge
  -- Step 4: near `p`, `spt C` is an embedded `C¹` surface `M`; shrink to `ρ = min ρ₁ δ`
  obtain ⟨ρ₁, M, hρ₁, -, hpM, hM, -, hsuppM⟩ :=
    Submission.idtp_ccd_regular_point_support P 2 univ C p isOpen_univ hreg
  have hρ : 0 < min ρ₁ δ := lt_min hρ₁ hδ
  have hρρ₁ : ball p (min ρ₁ δ) ⊆ ball p ρ₁ := ball_subset_ball (min_le_left _ _)
  have hρδ : ball p (min ρ₁ δ) ⊆ ball p δ := ball_subset_ball (min_le_right _ _)
  have hsupp : C.support ∩ ball p (min ρ₁ δ) = M ∩ ball p (min ρ₁ δ) := by
    rw [← inter_eq_right.2 hρρ₁, ← inter_assoc, hsuppM, inter_assoc]
  -- Step 5: `M` is stationary in `B_ρ(p)`: `0 = δV(X) = k ∫_{M ∩ B_ρ(p)} div_M X dH²`
  have hstat : ∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X →
      tsupport X ⊆ ball p (min ρ₁ δ) →
      ∫ x in M ∩ ball p (min ρ₁ δ), LinearMap.trace ℝ (Euclid P)
        ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
          (fderiv ℝ X x).toLinearMap) ∂μHE[2] = 0 := by
    intro X hX hXc hXs
    have hfv := Submission.idtp_ccd_sheet_first_variation P 2 univ C R M p (min ρ₁ δ) k
      isOpen_univ hR (subset_univ _) hk hM hsupp (fun y hy hyb => hdens y hy (hρδ hyb)) X hX
      hXc hXs
    rw [Submission.idtp_ccd_minimizing_stationary P 2 C R hmin hbd hR X hX hXc] at hfv
    have hk0 : (k : ℝ) ≠ 0 := by exact_mod_cast (show k ≠ 0 by omega)
    exact (mul_eq_zero.1 hfv.symm).resolve_left hk0
  -- Step 6: `M ∩ B_ρ(p)` is radially invariant, since `spt C` is a cone
  have hrad : ∀ x ∈ M ∩ ball p (min ρ₁ δ), ∀ t : ℝ, 0 < t → t • x ∈ ball p (min ρ₁ δ) →
      t • x ∈ M := by
    intro x hx t ht htx
    rw [← hsupp] at hx
    have htxC := Submission.idtp_ccd_cone_support_smul P 2 C hmin.1 hcone t ht x hx.1
    have htxM : t • x ∈ M ∩ ball p (min ρ₁ δ) := hsupp ▸ ⟨htxC, htx⟩
    exact htxM.1
  -- Step 7: a stationary radially invariant `C¹` surface is a plane `Q ∋ p` near `p`
  obtain ⟨δ'', Q, hδ'', hQ, hpQ, hMQ⟩ :=
    Submission.idtp_ccd_stationary_cone_sheet_planar P M p (min ρ₁ δ) hM hpM hp0 hρ hrad hstat
  have hδ' : 0 < min (min ρ₁ δ) δ'' := lt_min hρ hδ''
  have hδ'ρ : ball p (min (min ρ₁ δ) δ'') ⊆ ball p (min ρ₁ δ) :=
    ball_subset_ball (min_le_left _ _)
  have hδ'δ'' : ball p (min (min ρ₁ δ) δ'') ⊆ ball p δ'' := ball_subset_ball (min_le_right _ _)
  have hsuppQ : C.support ∩ ball p (min (min ρ₁ δ) δ'') =
      (Q : Set (Euclid P)) ∩ ball p (min (min ρ₁ δ) δ'') := by
    rw [← inter_eq_right.2 hδ'ρ, ← inter_assoc, hsupp, inter_assoc, inter_eq_right.2 hδ'ρ,
      ← inter_eq_right.2 hδ'δ'', ← inter_assoc, hMQ, inter_assoc, inter_eq_right.2 hδ'δ'']
  -- Step 8: planar support and density `k` at `p` give `M_W(C) = k H²(W ∩ Q)`
  refine ⟨min (min ρ₁ δ) δ'', Q, hδ', hQ, hpQ, hsuppQ, ?_⟩
  exact Submission.idtp_ccd_planar_support_mass P 2 univ C Q p (min (min ρ₁ δ) δ'') k
    (by norm_num) isOpen_univ hmin.1 hbd hQ hpQ hδ' (subset_univ _)
    (hsuppQ ▸ inter_subset_left) (hdens p hp (mem_ball_self hδ))

/-- The plane at the endpoint of a support arc of a 2-dimensional minimizing cone (used in the
proof of Simon 7.3.3(1), pp. 191–192, for 2-dimensional minimizing cones).  Let
`γ(φ) = cos φ z + sin φ e` run along the unit circle of the 2-plane `Q`, with `γ(φ) ∈ spt C` for
`0 < φ < φ₀`, `a := γ(φ₀) ∈ spt C` and density `k` on `spt C ∩ B_δ(a)`.  As `|a| = 1`, the planar
lemma `idtp_cone_constant_density_planar` gives `δ' > 0` and a 2-plane `Q' ∋ a` with
`spt C ∩ B_{δ'}(a) = Q' ∩ B_{δ'}(a)`.  For `0 < η < min(φ₀, δ', π)` and `e_a = sin φ₀ z − cos φ₀ e`,
the arc point `w = γ(φ₀ − η) = cos η a + sin η e_a` (`idtp_tdc_acont_great_circle`) lies in
`spt C ∩ B_{δ'}(a) ⊆ Q'`, so `e_a = (sin η)⁻¹ (w − cos η a) ∈ Q'`.  The orthonormal pair
`(a, e_a)` spans a 2-plane contained in both `Q` and `Q'`, so `Q' = Q`, and `ε = min(δ, δ')`
works. -/
theorem Submission.idtp_tdc_acont_endpoint_plane : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (z e : Euclid P) (k : ℕ) (φ₀ δ : ℝ), IsMinimizingIn C univ → BoundaryVanishes C → IsConeCurrent C → Module.finrank ℝ Q = 2 → z ∈ Q → e ∈ Q → ‖z‖ = 1 → ‖e‖ = 1 → inner ℝ z e = 0 → 0 < φ₀ → (∀ φ : ℝ, 0 < φ → φ < φ₀ → Real.cos φ • z + Real.sin φ • e ∈ C.support) → Real.cos φ₀ • z + Real.sin φ₀ • e ∈ C.support → 0 < δ → (∀ y ∈ C.support, y ∈ ball (Real.cos φ₀ • z + Real.sin φ₀ • e) δ → HasMassDensity C y k) → ∃ ε : ℝ, 0 < ε ∧ C.support ∩ ball (Real.cos φ₀ • z + Real.sin φ₀ • e) ε = (Q : Set (Euclid P)) ∩ ball (Real.cos φ₀ • z + Real.sin φ₀ • e) ε ∧ ∀ y ∈ C.support, y ∈ ball (Real.cos φ₀ • z + Real.sin φ₀ • e) ε → HasMassDensity C y k := by
  intro P C Q z e k φ₀ δ hmin hbd hcone hQ hzQ heQ hz he hze hφ₀ harc ha hδ hdens
  -- (0) `γ` is a `1`-Lipschitz unit circle; `e_a` is a unit vector orthogonal to `a = γ(φ₀)`, and
  -- `cos η a + sin η e_a = γ(φ₀ − η)`; `a, e_a ∈ Q` as `z, e ∈ Q`
  obtain ⟨hnorm, hlip, hframe⟩ := Submission.idtp_tdc_acont_great_circle P z e hz he hze
  obtain ⟨hea, hae, hrot⟩ := hframe φ₀
  set a : Euclid P := Real.cos φ₀ • z + Real.sin φ₀ • e
  set ea : Euclid P := Real.sin φ₀ • z - Real.cos φ₀ • e
  have ha1 : ‖a‖ = 1 := hnorm φ₀
  have haQ : a ∈ Q := Q.add_mem (Q.smul_mem _ hzQ) (Q.smul_mem _ heQ)
  have heaQ : ea ∈ Q := Q.sub_mem (Q.smul_mem _ hzQ) (Q.smul_mem _ heQ)
  -- (1) a local plane at `a ≠ 0`: `spt C ∩ B_{δ'}(a) = Q' ∩ B_{δ'}(a)` with `a ∈ Q'`
  have ha0 : a ≠ 0 := by
    rw [← norm_ne_zero_iff, ha1]
    exact one_ne_zero
  obtain ⟨δ', Q', hδ', hQ', haQ', hplane, -⟩ :=
    Submission.idtp_cone_constant_density_planar P C a k δ hmin hbd hcone ha ha0 hδ hdens
  -- (2) for `η = min(φ₀, δ', 1) / 2`, the arc point `w = γ(φ₀ − η)` lies in
  -- `spt C ∩ B_{δ'}(a) ⊆ Q'`, as `|w − a| ≤ η`
  obtain ⟨η, hη, hηφ₀, hηδ', hηπ⟩ : ∃ η : ℝ, 0 < η ∧ η < φ₀ ∧ η < δ' ∧ η < Real.pi := by
    have hm : 0 < min (min φ₀ δ') 1 := lt_min (lt_min hφ₀ hδ') one_pos
    refine ⟨min (min φ₀ δ') 1 / 2, half_pos hm, ?_, ?_, ?_⟩ <;>
      linarith [min_le_left (min φ₀ δ') 1, min_le_right (min φ₀ δ') 1, min_le_left φ₀ δ',
        min_le_right φ₀ δ', Real.two_le_pi]
  have hwQ' : Real.cos (φ₀ - η) • z + Real.sin (φ₀ - η) • e ∈ Q' := by
    have hw : Real.cos (φ₀ - η) • z + Real.sin (φ₀ - η) • e ∈ C.support ∩ ball a δ' := by
      refine ⟨harc (φ₀ - η) (sub_pos.2 hηφ₀) (sub_lt_self φ₀ hη), ?_⟩
      rw [mem_ball, dist_eq_norm]
      calc _ ≤ |φ₀ - η - φ₀| := hlip (φ₀ - η) φ₀
        _ = η := by rw [sub_sub_cancel_left, abs_neg, abs_of_pos hη]
        _ < δ' := hηδ'
    rw [hplane] at hw
    exact hw.1
  -- (3) `w = cos η a + sin η e_a` with `sin η > 0`, so `e_a = (sin η)⁻¹ (w − cos η a) ∈ Q'`
  have heaQ' : ea ∈ Q' := by
    have hsin : Real.sin η ≠ 0 := (Real.sin_pos_of_pos_of_lt_pi hη hηπ).ne'
    have hcomb : ea = (Real.sin η)⁻¹ •
        ((Real.cos (φ₀ - η) • z + Real.sin (φ₀ - η) • e) - Real.cos η • a) := by
      rw [← hrot η, add_sub_cancel_left, inv_smul_smul₀ hsin]
    rw [hcomb]
    exact Q'.smul_mem _ (Q'.sub_mem hwQ' (Q'.smul_mem _ haQ'))
  -- (4) the orthonormal pair `(a, e_a)` spans a 2-plane, which equals every 2-plane containing
  -- `a` and `e_a`; hence `Q' = Q`
  have hea' : inner ℝ ea a = 0 := by
    rw [real_inner_comm]
    exact hae
  have hon : Orthonormal ℝ ![a, ea] := by
    rw [orthonormal_iff_ite]
    intro i j
    fin_cases i <;> fin_cases j <;> simp [ha1, hea, hae, hea']
  have hspan : ∀ Q'' : Submodule ℝ (Euclid P), Module.finrank ℝ Q'' = 2 → a ∈ Q'' → ea ∈ Q'' →
      Submodule.span ℝ (range ![a, ea]) = Q'' := by
    intro Q'' hQ'' haQ'' heaQ''
    refine Submodule.eq_of_le_of_finrank_eq (Submodule.span_le.2 (range_subset_iff.2 fun i => ?_))
      ?_
    · fin_cases i
      · exact haQ''
      · exact heaQ''
    · rw [finrank_span_eq_card hon.linearIndependent, Fintype.card_fin, hQ'']
  have hQQ' : Q' = Q := (hspan Q' hQ' haQ' heaQ').symm.trans (hspan Q hQ haQ heaQ)
  -- (5) `ε = min(δ, δ')`: `B_ε(a) ⊆ B_{δ'}(a)` and `B_ε(a) ⊆ B_δ(a)`
  have hsub : ball a (min δ δ') ⊆ ball a δ' := ball_subset_ball (min_le_right δ δ')
  refine ⟨min δ δ', lt_min hδ hδ', ?_,
    fun y hy hyε => hdens y hy (ball_subset_ball (min_le_left δ δ') hyε)⟩
  calc C.support ∩ ball a (min δ δ') = C.support ∩ ball a δ' ∩ ball a (min δ δ') := by
        rw [inter_assoc, inter_eq_right.2 hsub]
    _ = (Q : Set (Euclid P)) ∩ ball a δ' ∩ ball a (min δ δ') := by rw [hplane, hQQ']
    _ = (Q : Set (Euclid P)) ∩ ball a (min δ δ') := by rw [inter_assoc, inter_eq_right.2 hsub]

/-- **Reduction of the constancy of an integer density on a plane to `ℝⁿ`** (steps 3 and 6–8 of
the planar constancy step in the integer density of tangent planes, Simon 7.3).  Let
`ι(s) = ∑ᵢ sᵢτᵢ` for an orthonormal family `τ`, `Q = span τ`, `Ω = ι⁻¹(V)` and `h = g ∘ ι`.
Since `Hⁿ⌞Q = ι_#Lⁿ` and the isometry `ι` is a measurable embedding, restricted measures,
integrals, a.e. statements and a.e.-measurability transfer between `V ∩ Q` and `Ω`.  So `Ω` is open,
`Ω = ι*(V ∩ Q)` is connected (`ι*(y) = (⟨τₖ, y⟩)ₖ` is a left inverse of `ι`, and `ι ∘ ι* = id` on
`Q`), and `h` is locally integrable on `Ω`.  A smooth test `ψ` in `Ω` extends to a smooth test `f`
in `V` with `D_{τⱼ}f ∘ ι = ∂ⱼψ`, so `∫_Ω h ∂ⱼψ = ∫_{V∩Q} g D_{τⱼ}f dHⁿ = 0`, and `C¹` tests follow.
Finally, if `h = c₀` a.e. on `Ω`, then `c₀ ∈ ℤ` (`h` is integer valued a.e. and `Lⁿ(Ω) > 0`), and
`g = c₀` `Hⁿ`-a.e. on `V ∩ Q`. -/
theorem Submission.idtp_pc_constancy_reduction : ∀ (P n : ℕ) (V : Set (Euclid P)) (τ : Fin n → Euclid P) (g : Euclid P → ℝ), IsOpen V → Orthonormal ℝ τ → IsConnected (V ∩ (Submodule.span ℝ (Set.range τ) : Set (Euclid P))) → AEStronglyMeasurable g (μHE[n].restrict (Submodule.span ℝ (Set.range τ) : Set (Euclid P))) → (∀ᵐ x ∂(μHE[n].restrict (Submodule.span ℝ (Set.range τ) : Set (Euclid P))), ∃ m : ℤ, g x = m) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ V → ∫⁻ x in K ∩ (Submodule.span ℝ (Set.range τ) : Set (Euclid P)), ‖g x‖ₑ ∂μHE[n] ≠ ∞) → (∀ f : Euclid P → ℝ, ContDiff ℝ (⊤ : ℕ∞) f → HasCompactSupport f → tsupport f ⊆ V → ∀ j : Fin n, ∫ x in V ∩ (Submodule.span ℝ (Set.range τ) : Set (Euclid P)), g x * fderiv ℝ f x (τ j) ∂μHE[n] = 0) → IsOpen {s : Euclid n | ∑ i, s i • τ i ∈ V} ∧ IsPreconnected {s : Euclid n | ∑ i, s i • τ i ∈ V} ∧ LocallyIntegrableOn (fun s : Euclid n => g (∑ i, s i • τ i)) {s : Euclid n | ∑ i, s i • τ i ∈ V} volume ∧ (∀ φ : Euclid n → ℝ, ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ {s : Euclid n | ∑ i, s i • τ i ∈ V} → ∀ i : Fin n, ∫ s, g (∑ k, s k • τ k) * fderiv ℝ φ s ((EuclideanSpace.basisFun (Fin n) ℝ) i) = 0) ∧ ∀ c₀ : ℝ, (∀ᵐ s ∂(volume.restrict {s : Euclid n | ∑ i, s i • τ i ∈ V}), g (∑ i, s i • τ i) = c₀) → ∃ c : ℤ, ∀ᵐ x ∂(μHE[n].restrict (V ∩ (Submodule.span ℝ (Set.range τ) : Set (Euclid P)))), g x = c := by
  intro P n V τ g hV hτ hconn hgm hgint hgloc hweak
  -- the parametrization `ι = L`: a linear isometry, hence a measurable embedding
  let L : Euclid n →ₗ[ℝ] Euclid P :=
    { toFun := fun s => ∑ i, s i • τ i
      map_add' := fun s t => by simp [add_smul, Finset.sum_add_distrib]
      map_smul' := fun c s => by simp [Finset.smul_sum, smul_smul] }
  have hLapp : ∀ s, L s = ∑ i, s i • τ i := fun s => rfl
  have hnorm : ∀ s, ‖L s‖ = ‖s‖ := by
    intro s
    have h1 : ‖L s‖ ^ 2 = ‖s‖ ^ 2 := by
      rw [hLapp, ← real_inner_self_eq_norm_sq, hτ.inner_sum, EuclideanSpace.norm_eq,
        Real.sq_sqrt (Finset.sum_nonneg fun i _ => sq_nonneg _)]
      simp [sq]
    exact (pow_left_inj₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).mp h1
  have hiso : Isometry L := AddMonoidHomClass.isometry_of_norm L hnorm
  have hcont : Continuous L := hiso.continuous
  have hemb : MeasurableEmbedding L := hiso.isClosedEmbedding.measurableEmbedding
  have hinj : Injective L := hiso.injective
  set Q : Set (Euclid P) := (Submodule.span ℝ (Set.range τ) : Set (Euclid P)) with hQ
  -- step 1: `Hⁿ⌞Q = ι_#Lⁿ`, so `Hⁿ⌞(A ∩ Q) = ι_#(Lⁿ⌞ι⁻¹(A))` for measurable `A`
  have hmap : (μHE[n] : Measure (Euclid P)).restrict Q = Measure.map L volume :=
    Submission.idtp_pc_plane_hausdorff_eq_map P n τ hτ
  have htr : ∀ A : Set (Euclid P), MeasurableSet A →
      (μHE[n] : Measure (Euclid P)).restrict (A ∩ Q) =
        Measure.map L (volume.restrict (L ⁻¹' A)) := by
    intro A hA
    rw [← Measure.restrict_restrict hA, hmap, hemb.restrict_map]
  -- step 2: `Ω = ι⁻¹(V)` is open
  set Ω : Set (Euclid n) := {s : Euclid n | ∑ i, s i • τ i ∈ V} with hΩ
  have hΩo : IsOpen Ω := hV.preimage hcont
  -- step 3: the left inverse `ι*(y) = (⟨τₖ, y⟩)ₖ` maps `V ∩ Q` onto `Ω`, so `Ω` is connected
  let Ls : Euclid P → Euclid n :=
    fun y => (WithLp.equiv 2 (Fin n → ℝ)).symm (fun k => inner ℝ (τ k) y)
  have hLscont : Continuous Ls := by
    refine (PiLp.continuous_toLp 2 _).comp ?_
    exact continuous_pi fun k => continuous_const.inner continuous_id
  have hLsL : ∀ s, Ls (L s) = s := by
    intro s
    ext k
    simp [Ls, hLapp, hτ.inner_right_fintype]
  have hrangeL : ∀ y ∈ Q, L (Ls y) = y := by
    intro y hy
    obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp hy
    have : Ls (∑ i, c i • τ i) = (WithLp.equiv 2 (Fin n → ℝ)).symm c := by
      ext k
      simp [Ls, hτ.inner_right_fintype]
    rw [this]
    simp [hLapp]
  have hLmemQ : ∀ s, L s ∈ Q := by
    intro s
    rw [hLapp]
    exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  have himage : Ls '' (V ∩ Q) = Ω := by
    ext s
    constructor
    · rintro ⟨y, ⟨hyV, hyQ⟩, rfl⟩
      show L (Ls y) ∈ V
      rw [hrangeL y hyQ]; exact hyV
    · intro hs
      exact ⟨L s, ⟨hs, hLmemQ s⟩, hLsL s⟩
  have hΩc : IsPreconnected Ω := by
    rw [← himage]
    exact hconn.isPreconnected.image Ls hLscont.continuousOn
  -- step 4: `h = g ∘ ι` is a.e.-strongly measurable, and `∫_{K'} |h| = ∫_{ι(K') ∩ Q} |g| dHⁿ < ∞`
  -- for compact `K' ⊆ Ω`
  have hgm' : AEStronglyMeasurable (fun s => g (L s)) volume := by
    have : AEStronglyMeasurable g (Measure.map L volume) := hmap ▸ hgm
    exact (hemb.aestronglyMeasurable_map_iff).mp this
  have hloc : LocallyIntegrableOn (fun s : Euclid n => g (∑ i, s i • τ i)) Ω volume := by
    refine (locallyIntegrableOn_iff hΩo.isLocallyClosed).mpr fun k hkΩ hk => ?_
    refine ⟨hgm'.restrict, ?_⟩
    have hKc : IsCompact (L '' k) := hk.image hcont
    have hKV : L '' k ⊆ V := by
      rintro _ ⟨s, hs, rfl⟩; exact hkΩ hs
    have hfin := hgloc (L '' k) hKc hKV
    have h1 : ∫⁻ x in L '' k ∩ Q, ‖g x‖ₑ ∂μHE[n] = ∫⁻ s in k, ‖g (L s)‖ₑ := by
      rw [htr _ hKc.isClosed.measurableSet, hemb.lintegral_map, hinj.preimage_image]
    show ∫⁻ s in k, ‖g (L s)‖ₑ < ∞
    rw [← h1]
    exact lt_top_iff_ne_top.mpr hfin
  -- step 5: for a smooth test `ψ` in `Ω`, `∫_Ω h ∂ⱼψ = ∫_{V∩Q} g D_{τⱼ}f dHⁿ = 0`, where `f` is
  -- the extension of `ψ` to a smooth test in `V`
  have hsmooth : ∀ a : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) a → HasCompactSupport a →
      tsupport a ⊆ Ω → ∀ j : Fin n,
        ∫ v in Ω, g (∑ i, v i • τ i) * fderiv ℝ a v (EuclideanSpace.single j (1 : ℝ)) = 0 := by
    intro a ha hac has j
    obtain ⟨f, hf, hfc, hfV, hfa⟩ :=
      Submission.idtp_pc_plane_test_extension P n V τ a hV hτ ha hac has
    have h0 := hweak f hf hfc hfV j
    have h2 : ∫ x in V ∩ Q, g x * fderiv ℝ f x (τ j) ∂μHE[n] =
        ∫ s in Ω, g (L s) * fderiv ℝ f (L s) (τ j) := by
      rw [htr V hV.measurableSet, hemb.integral_map]
      rfl
    rw [h2] at h0
    rw [← h0]
    refine setIntegral_congr_fun hΩo.measurableSet fun s _ => ?_
    simp only [hLapp] at *
    rw [(hfa s).2 j]
  -- step 6: `C¹` tests, by mollification
  refine ⟨hΩo, hΩc, hloc, Submission.dgcr_smooth_tests_to_C1_tests n Ω _ hΩo hloc hsmooth, ?_⟩
  -- step 7: `h = c₀` a.e. on `Ω` forces `c₀ ∈ ℤ`; transfer `g = c₀` back to `V ∩ Q`
  intro c₀ hc₀
  have hne : Ω.Nonempty := by
    rw [← himage]; exact hconn.nonempty.image Ls
  have hint' : ∀ᵐ s ∂(volume : Measure (Euclid n)), ∃ m : ℤ, g (L s) = m := by
    have : ∀ᵐ x ∂(Measure.map L (volume : Measure (Euclid n))), ∃ m : ℤ, g x = m := hmap ▸ hgint
    exact (hemb.ae_map_iff).mp this
  have hpos : (volume : Measure (Euclid n)) Ω ≠ 0 := (hΩo.measure_pos volume hne).ne'
  obtain ⟨s, -, hs1, m, hm⟩ := Measure.exists_mem_of_measure_ne_zero_of_ae hpos
    (hc₀.and (ae_restrict_of_ae hint'))
  have hc : c₀ = m := hs1.symm.trans hm
  refine ⟨m, ?_⟩
  rw [htr V hV.measurableSet, hemb.ae_map_iff]
  filter_upwards [hc₀] with s hs
  rw [← hc]; exact hs
/-- **Constancy theorem for an integer multiplicity cycle carried by an `n`-plane** (Simon Ch. 6,
Theorem 2.34, as applied to currents in a plane in the deformation theorem, Ch. 6, (26)–(27)).
Let `τ` be orthonormal, `Q = span{τ₁, …, τₙ}`, `n ≥ 1`, and let `S ∈ 𝒟ₙ(V)` be integer
multiplicity with `∂S = 0` in `V`, `spt S ⊆ Q` and `V ∩ Q` connected.  Then `S = c[[Q]]` in `V`
for some `c ∈ ℤ`: `S(ω) = c ∫_{V∩Q} ω(x)(τ₁, …, τₙ) dHⁿ(x)`, and `M_W(S) = |c| Hⁿ(W ∩ Q)` for open
`W ⊆ V`.  `S(ω) = ∫_{V∩Q} g ω(τ) dHⁿ` and `M_W(S) = ∫_{W∩Q} |g| dHⁿ` for an integer-valued,
locally `Hⁿ`-integrable signed density `g`; `∂S = 0` kills the weak derivatives of `h = g ∘ ι`,
`ι(s) = Σᵢ sᵢτᵢ`, on the connected open set `Ω = ι⁻¹(V)`.  By distributional constancy
`h = c₀` a.e. on `Ω`, so `g = c ∈ ℤ` `Hⁿ`-a.e. on `V ∩ Q`. -/
theorem Submission.idtp_planar_cycle_eq_const_mul : ∀ (P n : ℕ) (V : Set (Euclid P)) (S : GeometricCurrentOn V n) (τ : Fin n → Euclid P), 1 ≤ n → IsOpen V → Orthonormal ℝ τ → IsIntegerMultiplicity S → BoundaryVanishes S → S.support ⊆ (Submodule.span ℝ (Set.range τ) : Set (Euclid P)) → IsConnected (V ∩ (Submodule.span ℝ (Set.range τ) : Set (Euclid P))) → ∃ c : ℤ, (∀ ω : TestFormOn V n, S ω = (c : ℝ) * ∫ x in V ∩ (Submodule.span ℝ (Set.range τ) : Set (Euclid P)), (ω : DifferentialForm (Euclid P) n) x τ ∂μHE[n]) ∧ ∀ W : Set (Euclid P), IsOpen W → W ⊆ V → S.massOn W = (c.natAbs : ℝ≥0∞) * μHE[n] (W ∩ (Submodule.span ℝ (Set.range τ) : Set (Euclid P))) := by
  intro P n V S τ hn hV hτ hIM hbd hspt hconn
  -- steps 1–5: the integer-valued signed density `g` on `Q`, with `S(ω) = ∫_{V∩Q} g ω(τ) dHⁿ`
  -- and `M_W(S) = ∫_{W∩Q} |g| dHⁿ`
  obtain ⟨g, hgm, hgZ, hgK, hSg, hmass⟩ :=
    Submission.idtp_pc_signed_density P n V S τ hV hτ hIM hspt
  -- step 6: `∂S = 0` gives `∫_{V∩Q} g D_{τⱼ}f dHⁿ = 0` for every `f ∈ C^∞_c(V)`
  have hweak := Submission.idtp_pc_boundary_weak_derivative P n V S τ g hn hτ hbd hSg
  -- `h = g ∘ ι` on `Ω = ι⁻¹(V)`: `Ω` is open and connected, `h ∈ L¹_loc(Ω)` and `∫_Ω h ∂ᵢφ = 0`
  -- for every `φ ∈ C¹_c(Ω)`
  obtain ⟨hΩ, hΩc, hloc, hC1, hconst⟩ :=
    Submission.idtp_pc_constancy_reduction P n V τ g hV hτ hconn hgm hgZ hgK hweak
  -- step 7: distributional constancy, `h = c₀` a.e. on `Ω`; so `g = c ∈ ℤ` `Hⁿ`-a.e. on `V ∩ Q`
  obtain ⟨c₀, hc₀⟩ :=
    Poincare.SimonGMT.Chapter08.ae_eq_const_of_weak_coordinate_derivatives_zero hloc hΩ hΩc hC1
  obtain ⟨c, hc⟩ := hconst c₀ hc₀
  -- step 8: `S(ω) = c ∫_{V∩Q} ω(τ) dHⁿ` and `M_W(S) = ∫_{W∩Q} |c| dHⁿ = |c| Hⁿ(W ∩ Q)`
  refine ⟨c, fun ω => ?_, fun W hW hWV => ?_⟩
  · rw [hSg ω, ← integral_const_mul]
    refine integral_congr_ae ?_
    filter_upwards [hc] with x hx
    rw [hx]
  · rw [hmass W hW hWV, ← setLIntegral_const]
    refine lintegral_congr_ae ?_
    filter_upwards [ae_restrict_of_ae_restrict_of_subset (inter_subset_inter_left _ hWV) hc]
      with x hx
    rw [hx, Real.enorm_eq_ofReal_abs, ← Int.cast_abs, ← Nat.cast_natAbs, ENNReal.ofReal_natCast]
/-- **Tangent cones of a 2-dimensional minimizing cone at `p ≠ 0` are planes through `p`**
(proof of 7.3.3(1), case `n − d = 2`, chapter-07.txt lines 497–510, where the structure of
2-dimensional minimizing cones is cited to [Whi82]).  If `C ∈ 𝒟₂(ℝᴾ)` is a minimizing cone with
`∂C = 0`, `p ∈ spt C \ {0}` and `λⱼ ↓ 0`, then along a subsequence `η_{p,λⱼ#}C ⇀ C' = c[[Q]]`,
`μ_{η_{p,λⱼ#}C} → μ_{C'}`, for a plane `Q = span{τ₁, τ₂} ∋ p` and `c ∈ ℤ` with
`|c| = Θ²(μ_C, p) ≥ 1`.  The tangent cone `C'` is a minimizing cone cycle with
`Θ²(μ_{C'}, 0) = Θ²(μ_C, p) ≥ 1` (7.3.1(2)); since `C` is a cone, `μ_{C'}` and the density of
`C'` are invariant along `ℝp` (proof of A.4, chapter-A.txt lines 125–131); the splitting
Lemma 3.5 (chapter-07.txt lines 410–418) and formula (10) (lines 556–568) put `spt C'` in a plane
`Q ∋ p`; and the Constancy Theorem (Ch. 6, 2.34) gives `C' = c[[Q]]`, so
`Θ²(μ_{C'}, 0) = |c|`. -/
theorem Submission.idtp_cone_tangent_cone_planar : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2), IsMinimizingIn C univ → BoundaryVanishes C → IsConeCurrent C → ∀ p ∈ C.support, p ≠ 0 → ∀ (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), Tendsto lams atTop (𝓝 0) → ∃ (φ : ℕ → ℕ) (C' : GeometricCurrentOn (univ : Set (Euclid P)) 2) (τ : Fin 2 → Euclid P) (c : ℤ), StrictMono φ ∧ ConvergesWeakly (fun j => blowUp C p (lams (φ j)) (hlams (φ j)).ne') C' ∧ MassMeasuresConverge (fun j => blowUp C p (lams (φ j)) (hlams (φ j)).ne') C' ∧ Orthonormal ℝ τ ∧ p ∈ Submodule.span ℝ (Set.range τ) ∧ 1 ≤ c.natAbs ∧ HasMassDensity C p (c.natAbs : ℝ) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) 2, C' ω = (c : ℝ) * ∫ x in (Submodule.span ℝ (Set.range τ) : Set (Euclid P)), (ω : DifferentialForm (Euclid P) 2) x τ ∂μHE[2] := by
  intro P C hC hCb hCcone p hp hp0 lams hlams hlams0
  -- Steps 1–3: a tangent cone `C'` of `C` at `p` along a subsequence `λ_{φ(j)}`; it is a
  -- minimizing cone with `∂C' = 0` and `Θ²(μ_{C'}, 0) = Θ²(μ_C, p) = θ ≥ 1`.
  obtain ⟨φ, C', θ, hφ, hconv, hmass, hC', hC'cone, hC'b, hθ, hCθ, hC'θ⟩ :=
    Submission.idtp_cttp_cycle_tangent_cone P 2 C (by norm_num) hC hCb p hp lams hlams hlams0
  obtain ⟨R', hR'⟩ := hC'.1
  -- Steps 4–5: `μ_{C'}` is invariant under the translations by `v ∈ ℝp`.
  have hinv := Submission.idtp_cttp_blowup_limit_translation_invariant P 2 C C' p
    (fun j => lams (φ j)) (fun j => hlams (φ j)) hC.1 hCcone (hlams0.comp hφ.tendsto_atTop)
    hmass R' hR'
  -- Step 6: hence `Θ²(μ_{C'}, y + λw) = Θ²(μ_{C'}, w)` for `y ∈ ℝp` and `λ > 0`.
  have hdens := Submission.idtp_cttp_cone_density_translation_invariant P 2 C' R'
    (Submodule.span ℝ {p}) hR' hC'cone hinv
  -- Steps 7–9: `spt C' ⊆ Q := span{τ₁, τ₂}` for an orthonormal pair `τ` with `p ∈ Q`.
  obtain ⟨τ, hτ, hpτ, hsupp⟩ :=
    Submission.idtp_cttp_planar_support P C' p θ hp0 hC' hC'b hdens hθ hC'θ
  -- Step 10: the Constancy Theorem gives `C' = c[[Q]]` and `M_W(C') = |c| H²(W ∩ Q)`.
  obtain ⟨c, hc, hcmass⟩ := Submission.idtp_planar_cycle_eq_const_mul P 2 univ C' τ
    (by norm_num) isOpen_univ hτ hC'.1 hC'b hsupp (by
      rw [univ_inter]
      exact (Submodule.span ℝ (Set.range τ)).convex.isConnected
        ⟨0, (Submodule.span ℝ (Set.range τ)).zero_mem⟩)
  -- `M_{B_ρ(0)}(C') = |c| H²(B_ρ(0) ∩ Q) = |c| ω₂ρ²` for `ρ > 0`, so `Θ²(μ_{C'}, 0) = |c|`.
  have hC'c : HasMassDensity C' 0 (c.natAbs : ℝ) := by
    refine ⟨Nat.cast_nonneg _, ?_⟩
    rw [ENNReal.ofReal_natCast]
    refine tendsto_const_nhds.congr' (EventuallyEq.symm ?_)
    filter_upwards [self_mem_nhdsWithin] with ρ hρ
    have hρ' : 0 < ρ := hρ
    have hω₂ : unitBallVolume 2 ≠ 0 := (measure_ball_pos volume (0 : Euclid 2) one_pos).ne'
    have hω₂' : unitBallVolume 2 ≠ ∞ := measure_ball_lt_top.ne
    rw [hcmass (ball 0 ρ) isOpen_ball (subset_univ _),
      Submission.idtp_cttp_span_ball_measure P 2 τ hτ 0 (Submodule.zero_mem _) ρ hρ',
      ENNReal.mul_div_cancel_right
        (mul_ne_zero hω₂ (ENNReal.ofReal_pos.2 (by positivity)).ne')
        (ENNReal.mul_ne_top hω₂' ENNReal.ofReal_ne_top)]
  -- Densities are unique, so `|c| = θ ≥ 1` and `Θ²(μ_C, p) = |c|`.
  have hθc : θ = c.natAbs :=
    (ENNReal.ofReal_eq_ofReal_iff hC'θ.1 hC'c.1).1 (tendsto_nhds_unique hC'θ.2 hC'c.2)
  refine ⟨φ, C', τ, c, hφ, hconv, hmass, hτ, hpτ, ?_, hθc ▸ hCθ, fun ω => ?_⟩
  · exact_mod_cast (hθc ▸ hθ : (1 : ℝ) ≤ c.natAbs)
  · rw [hc ω, univ_inter]

/-- **Density function of a 2-dimensional minimizing cone** (proof of Simon 7.3.3(1), p. 191, for
2-dimensional minimizing cones).  Let `C ∈ 𝒟₂(ℝᴾ)` be a minimizing cone with `∂C = 0` and some
`p ∈ spt C \ {0}`.  The tangent cone of `C` at `p` is a plane spanned by an orthonormal pair, so
`P ≥ 2`, and monotonicity (`U = N = ℝᴾ`, identity chart) gives `Θ(y) = Θ²(μ_C, y)` at every `y`,
upper semicontinuous.  At `q ∈ spt C \ {0}` the planar tangent cone gives `Θ²(μ_C, q) = |c| ≥ 1`,
and the dilation invariance of the cone gives `Θ(sx) = Θ(x)` for `s > 0`; densities are unique. -/
theorem Submission.idtp_tdc_dlc_cone_density_function : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2), IsMinimizingIn C univ → BoundaryVanishes C → IsConeCurrent C → (∃ p ∈ C.support, p ≠ 0) → ∃ Θ : Euclid P → ℝ, (∀ y : Euclid P, HasMassDensity C y (Θ y)) ∧ UpperSemicontinuous Θ ∧ (∀ q ∈ C.support, q ≠ 0 → ∃ m : ℕ, 1 ≤ m ∧ Θ q = (m : ℝ)) ∧ ∀ (s : ℝ) (x : Euclid P), 0 < s → Θ (s • x) = Θ x := by
  intro P C hmin hbd hcone ⟨p, hp, hp0⟩
  -- `λⱼ = 1/(j + 1)`: `λⱼ > 0` and `λⱼ → 0`
  have hlams : ∀ j : ℕ, 0 < 1 / ((j : ℝ) + 1) := fun j => by positivity
  have hlams0 : Tendsto (fun j : ℕ => 1 / ((j : ℝ) + 1)) atTop (𝓝 0) :=
    tendsto_one_div_add_atTop_nhds_zero_nat
  -- Step 1: the tangent cone at `p` is planar, with an orthonormal pair `τ`; so `2 ≤ P`
  obtain ⟨_, _, τ, _, _, _, _, hτ, -⟩ :=
    Submission.idtp_cone_tangent_cone_planar P C hmin hbd hcone p hp hp0 _ hlams hlams0
  have hP : 2 ≤ P := by
    simpa [finrank_euclideanSpace_fin] using hτ.linearIndependent.fintype_card_le_finrank
  -- Step 2: monotonicity with `U = N = ℝᴾ` (identity chart): `Θ²(μ_C, y)` exists at every `y`
  -- and is upper semicontinuous
  have hN : IsEmbeddedSubmanifold 2 P (univ : Set (Euclid P)) := fun y _ =>
    ⟨univ, univ, id, isOpen_univ, isOpen_univ, mem_univ y, contDiffOn_id, injOn_id _,
      by simp, fun K _ hK => by simpa using hK, fun z _ => by
        rw [fderiv_id, ContinuousLinearMap.coe_id']; exact injective_id⟩
  obtain ⟨-, -, ⟨Θ, hΘ, hΘusc⟩, -⟩ := Submission.dimred_minimizing_monotonicity P 2 P univ univ C
    (by norm_num) hP le_rfl isOpen_univ hN (by simp) (by rwa [inter_self]) (by simp) hbd
  have hΘ' : ∀ y, HasMassDensity C y (Θ y) := fun y => hΘ y (mem_univ y)
  refine ⟨Θ, hΘ', upperSemicontinuousOn_univ_iff.1 hΘusc, fun q hq hq0 => ?_, fun s x hs => ?_⟩
  · -- Step 3: at `q ∈ spt C \ {0}` the density is `|c| ≥ 1`; densities are unique
    obtain ⟨_, _, _, c, _, _, _, _, _, hc, hCq, -⟩ :=
      Submission.idtp_cone_tangent_cone_planar P C hmin hbd hcone q hq hq0 _ hlams hlams0
    exact ⟨c.natAbs, hc,
      Submission.dimred_cs_mi_hasMassDensity_unique P 2 univ C q _ _ (hΘ' q) hCq⟩
  · -- Step 4: `Θ²(μ_C, x)` is also the density at `s x` (dilation invariance of the cone)
    exact Submission.dimred_cs_mi_hasMassDensity_unique P 2 univ C (s • x) _ _ (hΘ' (s • x))
      (((Submission.idtp_tdc_cone_dilation P 2 C hmin.1 hcone s hs).2.2 x (Θ x)).2 (hΘ' x))
/-- **Tangent plane at an edge point of a planar sector of a 2-dimensional minimizing cone**
(proof of Simon 7.3.3(1), case `n − d = 2`, chapter-07.txt lines 497–510).  Let `C ∈ 𝒟₂(ℝᴾ)` be
a minimizing cone with `∂C = 0`, `a ∈ spt C` a unit vector, `(a, e)` an orthonormal basis of the
plane `Q`, and suppose `C` has density `k ≥ 1` at every point `t(cos φ a + sin φ e)` of the open
sector `t > 0`, `0 < φ < δ`.  Then `m = Θ²(μ_C, a)` is an integer `≥ 1`, along a subsequence of
every `λⱼ ↓ 0` the blow-ups `η_{a,λⱼ#}C` converge to `±m[[Q]]` (oriented by `(a, e)`) with
`λⱼ⁻² ∫ g ∘ η_{a,λⱼ} dμ_C → m ∫_Q g dH²`, and near `a` the support of `C` is localized in a thin
cusp around `Q`.  The tangent cones `c[[Q']]` at `a` (`idtp_cone_tangent_cone_planar`) have
`|c| = m` by uniqueness of densities; the sector points `a + λⱼe ∈ spt C` have mass
`≥ ω₂(λⱼr)²` in `B_{λⱼr}(a + λⱼe)`, so `e ∈ Q'` (`idtp_cse_etp_rescaled_limit_mem`), whence
`Q' = Q` and `c[[Q']] = ±c[[Q]]` (`idtp_cse_etp_plane_frame_sign`); the cusp
(`idtp_cse_etp_cusp`) and the localization (`idtp_cse_etp_localization`) give the last part. -/
theorem Submission.idtp_cse_edge_tangent_plane : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (δ : ℝ) (k : ℕ), IsMinimizingIn C univ → BoundaryVanishes C → IsConeCurrent C → Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → 0 < δ → 1 ≤ k → a ∈ C.support → (∀ t φ : ℝ, 0 < t → 0 < φ → φ < δ → HasMassDensity C (t • (Real.cos φ • a + Real.sin φ • e)) k ∧ ∃ r : ℝ, 0 < r ∧ C.support ∩ ball (t • (Real.cos φ • a + Real.sin φ • e)) r ⊆ (Q : Set (Euclid P))) → ∃ m : ℕ, 1 ≤ m ∧ HasMassDensity C a m ∧ (∀ (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), Tendsto lams atTop (𝓝 0) → ∃ (φ : ℕ → ℕ) (C' : GeometricCurrentOn (univ : Set (Euclid P)) 2) (c : ℤ), StrictMono φ ∧ c.natAbs = m ∧ ConvergesWeakly (fun j => blowUp C a (lams (φ j)) (hlams (φ j)).ne') C' ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) 2, C' ω = (c : ℝ) * ∫ x in (Q : Set (Euclid P)), (ω : DifferentialForm (Euclid P) 2) x ![a, e] ∂μHE[2]) ∧ ∀ R : IMRep (univ : Set (Euclid P)) 2, R.Represents C → ∀ g : Euclid P → ℝ, Continuous g → HasCompactSupport g → Tendsto (fun j => (lams (φ j))⁻¹ ^ 2 * ∫ x, g (dilation a (lams (φ j)) x) ∂R.measure) atTop (𝓝 ((m : ℝ) * ∫ x in (Q : Set (Euclid P)), g x ∂μHE[2]))) ∧ ∃ s₀ : ℝ, 0 < s₀ ∧ s₀ ≤ 1 / 4 ∧ (∀ s' : ℝ, 0 < s' → s' ≤ s₀ → ∀ x ∈ C.support, 0 < inner ℝ x a → |‖x‖ - 1| < s' → |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' → ‖x - Q.starProjection x‖ ≤ 2 * s₀ * ‖x‖ → ‖x - Q.starProjection x‖ < s' / 4 * ‖x‖ ∧ dist x a < 3 * s') := by
  intro P C Q a e δ k hmin hbd hcone hQ haQ heQ ha he hae hδ hk haC hsector
  -- step 0: `C = τ(M, θ, ξ)` with `μ = μ_C`, and `M_W(C) = μ(W)` for open `W`
  obtain ⟨R₀, hR₀⟩ := hmin.1
  obtain ⟨hmass, -, -⟩ := Submission.dimred_im_mass_measure P 2 univ C R₀ isOpen_univ hR₀
  have ha0 : a ≠ 0 := fun h => by
    rw [h, norm_zero] at ha
    exact zero_ne_one ha
  -- `μ` is finite on compact sets
  have hfin : ∀ K : Set (Euclid P), IsCompact K → R₀.measure K ≠ ∞ := by
    intro K hK
    rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
      Measure.restrict_restrict hK.measurableSet, inter_comm]
    exact R₀.locallyIntegrable_mult K hK (subset_univ _)
  -- step 1: `μ(B_ρ(y)) ≥ ω₂ρ²` for `y ∈ spt C` and `ρ > 0`
  have hlow : ∀ y ∈ C.support, ∀ ρ : ℝ, 0 < ρ →
      unitBallVolume 2 * ENNReal.ofReal (ρ ^ 2) ≤ R₀.measure (ball y ρ) := fun y hy ρ hρ =>
    (Submission.idtp_cse_massOn_ball_lower_bound P C hmin hbd y hy ρ hρ).trans_eq
      (hmass _ isOpen_ball (subset_univ _))
  -- the sector points `a + l e`, `0 < l < l₀`, lie in `spt C`
  obtain ⟨l₀, hl₀, hedge⟩ := Submission.idtp_cse_etp_edge_direction_support P C a e δ k hmin.1
    hδ hk fun t φ ht hφ hφδ => (hsector t φ ht hφ hφδ).1
  -- `m := Θ²(μ_C, a) = |c₀|` is an integer `≥ 1`
  obtain ⟨_, _, _, c₀, _, _, _, _, _, hc₀, hc₀dens, _⟩ :=
    Submission.idtp_cone_tangent_cone_planar P C hmin hbd hcone a haC ha0
      (fun j => 1 / ((j : ℝ) + 1)) (fun j => by positivity)
      tendsto_one_div_add_atTop_nhds_zero_nat
  -- step 2: along a subsequence of every `λⱼ → 0`, `η_{a,λⱼ#}C ⇀ ±m[[Q]]`
  have hblow : ∀ (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), Tendsto lams atTop (𝓝 0) →
      ∃ (φ : ℕ → ℕ) (C' : GeometricCurrentOn (univ : Set (Euclid P)) 2) (c : ℤ), StrictMono φ ∧
        c.natAbs = c₀.natAbs ∧
        ConvergesWeakly (fun j => blowUp C a (lams (φ j)) (hlams (φ j)).ne') C' ∧
        (∀ ω : TestFormOn (univ : Set (Euclid P)) 2, C' ω = (c : ℝ) *
          ∫ x in (Q : Set (Euclid P)), (ω : DifferentialForm (Euclid P) 2) x ![a, e] ∂μHE[2]) ∧
        ∀ R : IMRep (univ : Set (Euclid P)) 2, R.Represents C → ∀ g : Euclid P → ℝ,
          Continuous g → HasCompactSupport g →
          Tendsto (fun j => (lams (φ j))⁻¹ ^ 2 * ∫ x, g (dilation a (lams (φ j)) x) ∂R.measure)
            atTop (𝓝 ((c₀.natAbs : ℝ) * ∫ x in (Q : Set (Euclid P)), g x ∂μHE[2])) := by
    intro lams hlams hlams0
    obtain ⟨φ, C', τ, c, hφ, hconv, hmconv, hτ, haτ, hc1, hcdens, hC'⟩ :=
      Submission.idtp_cone_tangent_cone_planar P C hmin hbd hcone a haC ha0 lams hlams hlams0
    -- densities are unique, so `|c| = |c₀|`
    have hcc₀ : c.natAbs = c₀.natAbs := by
      have h := (ENNReal.ofReal_eq_ofReal_iff hcdens.1 hc₀dens.1).1
