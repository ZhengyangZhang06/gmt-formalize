  have hrs : ∀ j, (1 / 2 : ℝ) ^ j / 32 ≤ r j := fun j =>
    (div_le_div_of_nonneg_left (he0 j).le h16 h16le32).trans (hr j).1.le
  have hrs' : ∀ j, (1 / 2 : ℝ) ^ (j + 1) / 32 ≤ r j := fun j =>
    (div_le_div_of_nonneg_right (pow_le_pow_of_le_one one_half_pos.le
