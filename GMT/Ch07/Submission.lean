        (∀ β : Covector (Euclid P) (d + 1), ζ a β = β v) ∧
        (∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f →
          Tendsto (fun k => ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap a (lams (φ k)) '' M,
              f y ∂μHE[(d + 1)]) atTop
            (𝓝 (∫ y in (Submodule.span ℝ (Set.range v) : Set (Euclid P)), f y ∂μHE[(d + 1)]))) ∧
        ∃ m : ℕ, θ a = m := by
    intro lams hlams hlams0
    -- (a) the blow-up limit `C = θ(a) ζ(a) ν`, with the integer slice property
    obtain ⟨φ, ν, C, Γs, μs, ξs, hφ, hνK, hνball, hνpos, hCrep, hCb, hCmass, hCisp, hconv, hΓsb,
        hμsK, -, hξsm, hξsbd, hΓsrep, hlimsup, hμsN, hHlimsup, hfconv⟩ :=
      Submission.cbr_ci_blowup_limit hSL hRU hCT P d hSLIM Γ μ M θ ζ a η₁ lams hΓb hΓisp hμfin
        hμmass hM hHM hθ hζ hμeq hθpos hζbd hζunit hΓrep haM hη₁ hdens hupper hLeb hlams hlams0
    -- (b) `ν` has lower density `≥ η₀/θ(a)` at `ν`-a.e. point
    have hνdens := Submission.cbr_ci_pw_blowup_lower_density P d η₀ (θ a) ν (ζ a) C hLD hθ₀ hCb
      hνK hCmass (hζbd a) hCrep hCisp
    -- (c) `0 = ∂C(ψ) = C(dψ) = θ(a) ∫ ⟨dψ, ζ(a)⟩ dν`
    have hbdry : ∀ ψ : TestFormOn (univ : Set (Euclid P)) d,
        ∫ y, ζ a (exteriorDerivative (ψ : DifferentialForm (Euclid P) d) y) ∂ν = 0 := by
      intro ψ
      have h : C.boundary ψ = 0 := by rw [hCb]; rfl
      rw [GeometricCurrentOn.boundary_apply, hCrep, integral_const_mul] at h
      exact (mul_eq_zero.mp h).resolve_left hθ₀.ne'
    -- (d) `ζ(a) = v₁ ∧ ⋯ ∧ vₙ` and `ν = Σᵢ αᵢ Hⁿ⌞(wᵢ + span v)`
    obtain ⟨v, N, w, α, hv, hζv, hw, hwv, hαc, hαsum, hw0, hνeq⟩ :=
      Submission.cbr_ci_constant_cycle_planes P d ν (ζ a) (η₀ / θ a) hc hνK (hζbd a)
        (hζunit a haM) hbdry hνball hνpos hνdens
    have hCv : ∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1),
        C ω = θ a * ∫ y, (ω : DifferentialForm (Euclid P) (d + 1)) y v ∂ν := by
      intro ω
      rw [hCrep ω, integral_const_mul]
      simp only [hζv]
    -- (e) every weight is `≥ 1`
    have hα1 : ∀ i, 1 ≤ α i :=
      Submission.cbr_ci_plane_weight_ge_one hREP hSL hCT P d v (θ a) N w α ν C Γs μs ξs
        (fun k => Poincare.SimonGMT.Chapter03.blowUpMap a (lams (φ k)) '' M) hv hθ₀ hw hwv
        (fun i => hc.trans_le (hαc i)) hνeq hCv hconv hΓsb hμsK hξsm hξsbd hΓsrep hlimsup hμsN
        hHlimsup
    -- (f) `N ≤ Σᵢ αᵢ ≤ 1`: a single plane through `0` of weight one, `ν = Hⁿ⌞span v`
    have hνV : ν = (μHE[(d + 1)]).restrict (Submodule.span ℝ (Set.range v) : Set (Euclid P)) :=
      Submission.cbr_ci_pw_single_plane_of_unit_weights P N (μHE[(d + 1)]) ν
        (Submodule.span ℝ (Set.range v)) w α hα1 hαsum hw0 hνeq
    -- (h) `C = θ(a) [[span v]]` has the integer slice property, so `θ(a) ∈ ℕ`
    obtain ⟨m, hm⟩ := Submission.cbr_ci_plane_multiplicity_nat hMR hSL P d v (θ a) C hv hθ₀
      (fun ω => by rw [hCv ω, hνV]) hCisp
    -- (g) `∫_{η_{a,λ}(M)} f dHⁿ → ∫ f dν = ∫_{span v} f dHⁿ` along the subsequence
    refine ⟨φ, v, hφ, hv, hζv, fun f hf hfc => ?_, m, hm⟩
    have h := hfconv f hf hfc
    rwa [hνV] at h
  -- Step 2: the plane `Q := span v₀`, from the blow-up sequence `1/(i+1)`
  obtain ⟨-, v₀, -, hv₀, hζv₀, -, m, hm⟩ := claim (fun i => 1 / ((i : ℝ) + 1))
    (fun _ => Nat.one_div_pos_of_nat) tendsto_one_div_add_atTop_nhds_zero_nat
  have hQ : Module.finrank ℝ (Submodule.span ℝ (Set.range v₀)) = d + 1 := by
    rw [finrank_span_eq_card hv₀.linearIndependent, Fintype.card_fin]
  refine ⟨Submodule.span ℝ (Set.range v₀), ?_, ⟨v₀, hv₀, rfl, Or.inl hζv₀⟩, m, hm⟩
  -- Step 3: the plane of every blow-up sequence is `Q`, so `Q` is the approximate tangent space
  refine Submission.cbr_ci_pw_approxTangent_of_subseq P (d + 1) M a _ hQ
    fun lams hlams hlams0 => ?_
  obtain ⟨φ, v, hφ, hv, hζv, hconv, -⟩ := claim lams hlams hlams0
  have hspan : Submodule.span ℝ (Set.range v) = Submodule.span ℝ (Set.range v₀) :=
    Submission.cbr_ci_pw_span_eq_of_covector_eval_eq P (d + 1) v v₀ hv hv₀
      fun β => (hζv β).symm.trans (hζv₀ β)
  refine ⟨φ, hφ, fun f hf hfc => ?_⟩
  have h := hconv f hf hfc
  rwa [hspan] at h
/-- **Cut-off quadratic moments over `n`-planes** (the constant `cₙ` of the measurability proof
for the approximate tangent planes of Simon Ch. 3, 1.4).  For `n ≥ 1` one constant `c > 0`,
depending only on `n`, gives `∫_Q max(1 − |y|², 0)⟨u, y⟩² dHⁿ(y) = c|p_Q u|²` for every `P`,
every `n`-dimensional subspace `Q ⊆ ℝᴾ` and every `u ∈ ℝᴾ`.  On `ℝⁿ` put
`q(w) = ∫ max(1 − |z|², 0)⟨w, z⟩² dHⁿ(z)` and `c = q(e)`, `|e| = 1`: linear isometries preserve
`Hⁿ`, so `q` is invariant under them, `q(tw) = t²q(w)`, and a reflection maps `|w|e` to `w`,
whence `q(w) = c|w|²`; `c > 0` since the integrand is continuous, `≥ 0`, compactly supported and
`3/16` at `e/2`.  An isometry `ι = L⁻¹ : ℝⁿ → Q ⊆ ℝᴾ` carries `Hⁿ` to `Hⁿ⌞Q`, and
`⟨u, ι z⟩ = ⟨L(p_Q u), z⟩`, so the integral is `q(L(p_Q u)) = c|p_Q u|²`. -/
theorem Submission.exists_plane_cutoff_quadratic_moment_eq : ∀ n : ℕ, 0 < n → ∃ c : ℝ, 0 < c ∧ ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)), Module.finrank ℝ Q = n → ∀ u : Euclid P, ∫ y in (Q : Set (Euclid P)), max (1 - ‖y‖ ^ 2) 0 * inner ℝ u y ^ 2 ∂μHE[n] = c * ‖Q.starProjection u‖ ^ 2 := by
  intro n hn
  -- The moment `q(w)` on the model plane `ℝⁿ`; the constant is `c = q(e)` for a unit vector `e`.
  obtain ⟨q, hq_def⟩ : ∃ q : Euclid n → ℝ,
      ∀ w, q w = ∫ z, max (1 - ‖z‖ ^ 2) 0 * inner ℝ w z ^ 2 ∂μHE[n] :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨e, he⟩ : ∃ e : Euclid n, ‖e‖ = 1 := ⟨EuclideanSpace.single ⟨0, hn⟩ 1, by simp⟩
  -- `q(Rw) = q(w)` for a linear isometry `R`: substitute `z = Rz'`, `R` preserves `Hⁿ`.
  have hq_iso : ∀ (R : Euclid n ≃ₗᵢ[ℝ] Euclid n) (w : Euclid n), q (R w) = q w := by
    intro R w
    have key : ∫ z, max (1 - ‖R z‖ ^ 2) 0 * inner ℝ (R w) (R z) ^ 2 ∂μHE[n] =
        ∫ z, max (1 - ‖z‖ ^ 2) 0 * inner ℝ (R w) z ^ 2 ∂μHE[n] :=
      (R.toIsometryEquiv.measurePreserving_euclideanHausdorffMeasure n).integral_comp
        R.toHomeomorph.measurableEmbedding (fun y => max (1 - ‖y‖ ^ 2) 0 * inner ℝ (R w) y ^ 2)
    simp only [LinearIsometryEquiv.norm_map, LinearIsometryEquiv.inner_map_map] at key
    rw [hq_def, hq_def, ← key]
  have hq_smul : ∀ (t : ℝ) (w : Euclid n), q (t • w) = t ^ 2 * q w := by
    intro t w
    rw [hq_def, hq_def, ← integral_const_mul]
    congr 1
    funext z
    rw [real_inner_smul_left]
    ring
  -- `q(w) = c|w|²`: the reflection in `(|w|e − w)ᗮ` maps `|w|e` to `w`.
  have hq : ∀ w : Euclid n, q w = q e * ‖w‖ ^ 2 := by
    intro w
    have h1 : ‖‖w‖ • e‖ = ‖w‖ := by rw [norm_smul, he, mul_one, norm_norm]
    obtain ⟨R, hR⟩ : ∃ R : Euclid n ≃ₗᵢ[ℝ] Euclid n, R (‖w‖ • e) = w :=
      ⟨_, Submodule.reflection_sub h1⟩
    calc q w = q (R (‖w‖ • e)) := by rw [hR]
      _ = q (‖w‖ • e) := hq_iso R _
      _ = q e * ‖w‖ ^ 2 := by rw [hq_smul, mul_comm]
  -- `c > 0`: on `ℝⁿ`, `Hⁿ` is Lebesgue measure, and the integrand is `3/16` at `e/2`.
  have hc : 0 < q e := by
    have hcont : Continuous fun z : Euclid n => max (1 - ‖z‖ ^ 2) 0 * inner ℝ e z ^ 2 := by
      fun_prop
    have hsupp : HasCompactSupport fun z : Euclid n => max (1 - ‖z‖ ^ 2) 0 * inner ℝ e z ^ 2 := by
      refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid n) 1) fun z hz => ?_
      have h1 : 1 < ‖z‖ := by simpa using hz
      have h2 : 1 - ‖z‖ ^ 2 ≤ 0 := by nlinarith
      simp [max_eq_right h2]
    have hnonneg : 0 ≤ fun z : Euclid n => max (1 - ‖z‖ ^ 2) 0 * inner ℝ e z ^ 2 :=
      fun z => mul_nonneg (le_max_right _ _) (sq_nonneg _)
    have hx : (fun z : Euclid n => max (1 - ‖z‖ ^ 2) 0 * inner ℝ e z ^ 2) ((1 / 2 : ℝ) • e) ≠ 0 := by
      simp only [norm_smul, he, real_inner_smul_right, real_inner_self_eq_norm_sq]
      norm_num
    rw [hq_def, EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
    exact hcont.integral_pos_of_hasCompactSupport_nonneg_nonzero hsupp hnonneg hx
  refine ⟨q e, hc, fun P Q hQ u => ?_⟩
  -- An orthonormal basis of `Q` indexed by `Fin n` gives `L : Q ≃ ℝⁿ`; `ι = L⁻¹` is an isometry
  -- of `ℝⁿ` onto `Q ⊆ ℝᴾ`, so `ι_# Hⁿ = Hⁿ⌞Q`.
  obtain ⟨L, -⟩ : ∃ L : Q ≃ₗᵢ[ℝ] Euclid n, True :=
    ⟨((stdOrthonormalBasis ℝ Q).reindex (finCongr hQ)).repr, trivial⟩
  have hι : Isometry fun z : Euclid n => ((L.symm z : Q) : Euclid P) :=
    isometry_subtype_coe.comp L.symm.isometry
  have hrange : Set.range (fun z : Euclid n => ((L.symm z : Q) : Euclid P)) =
      (Q : Set (Euclid P)) := by
    ext y
    refine ⟨?_, fun hy => ⟨L ⟨y, hy⟩, by simp⟩⟩
    rintro ⟨z, rfl⟩
    exact (L.symm z).2
  have hemb : MeasurableEmbedding fun z : Euclid n => ((L.symm z : Q) : Euclid P) :=
    hι.isClosedEmbedding.measurableEmbedding
  have hnorm : ∀ z : Euclid n, ‖((L.symm z : Q) : Euclid P)‖ = ‖z‖ := fun z => L.symm.norm_map z
  -- `⟨u, ι z⟩ = ⟨p_Q u, ι z⟩ = ⟨L(p_Q u), z⟩`.
  have hinner : ∀ z : Euclid n, inner ℝ u ((L.symm z : Q) : Euclid P) =
      inner ℝ (L (Q.orthogonalProjectionOnto u)) z := by
    intro z
    rw [LinearIsometryEquiv.inner_map_eq_flip,
      Submodule.inner_orthogonalProjectionOnto_eq_of_mem_right]
  rw [← hrange, ← hι.map_euclideanHausdorffMeasure, hemb.integral_map]
  simp only [hnorm, hinner]
  rw [← hq_def, hq, LinearIsometryEquiv.norm_map, Submodule.starProjection_apply]
  rfl
/-- **Simon Ch. 3, 1.4** (change of variables under the blow-up `η_{x,r}`): for `r > 0`, every
set `M` and every `f`, `∫_{η_{x,r}(M)} f dHⁿ = r⁻ⁿ ∫_M f(η_{x,r}(y)) dHⁿ(y)`.
`η_{x,r} = (r⁻¹ • ·) ∘ (· − x)` is a homeomorphism with `Hⁿ(η_{x,r}(S)) = r⁻ⁿ Hⁿ(S)` for every
`S` (translation is an isometry), so `Hⁿ⌞η_{x,r}(M) = r⁻ⁿ η_{x,r#}(Hⁿ⌞M)`. -/
theorem Submission.setIntegral_blowUpMap_image_eq_inv_pow_mul : ∀ (P n : ℕ) (M : Set (Euclid P)) (x : Euclid P) (r : ℝ), 0 < r → ∀ f : Euclid P → ℝ, ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, f y ∂μHE[n] = r⁻¹ ^ n * ∫ y in M, f (Poincare.SimonGMT.Chapter03.blowUpMap x r y) ∂μHE[n] := by
  intro P n M x r hr f
  -- `η_{x,r} = (r⁻¹ • ·) ∘ (· - x)` is a homeomorphism
  obtain ⟨e, he⟩ : ∃ e : Euclid P ≃ₜ Euclid P,
      ⇑e = Poincare.SimonGMT.Chapter03.blowUpMap x r :=
    ⟨(Homeomorph.subRight x).trans (Homeomorph.smulOfNeZero r⁻¹ (inv_ne_zero hr.ne')), rfl⟩
  -- `Hⁿ(η_{x,r}(S)) = ‖r⁻¹‖₊ⁿ Hⁿ(S)` for every set `S`
  have hscale : ∀ S : Set (Euclid P), μHE[n] (e '' S) = ‖r⁻¹‖₊ ^ n • μHE[n] S := by
    intro S
    have hS : e '' S = (fun y => r⁻¹ • y) '' ((IsometryEquiv.subRight x) '' S) := by
      rw [image_image, he]
      rfl
    rw [hS, image_smul, Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hr.ne'),
      (IsometryEquiv.subRight x).isometry.euclideanHausdorffMeasure_image]
  -- `Hⁿ⌞η_{x,r}(M) = ‖r⁻¹‖₊ⁿ η_{x,r#}(Hⁿ⌞M)`, checked on Borel sets
  have hmeas : μHE[n].restrict (e '' M) = (‖r⁻¹‖₊ ^ n) • (μHE[n].restrict M).map e := by
    ext A hA
    rw [Measure.restrict_apply hA, Measure.smul_apply, Measure.map_apply e.measurable hA,
      Measure.restrict_apply (hA.preimage e.measurable), ← hscale, image_inter e.injective,
      e.image_preimage]
  -- change of variables, with `‖r⁻¹‖₊ⁿ = r⁻¹ ^ n`
  rw [← he, hmeas, integral_smul_nnreal_measure, e.measurableEmbedding.integral_map,
    NNReal.smul_def, smul_eq_mul, NNReal.coe_pow, coe_nnnorm, Real.norm_eq_abs,
    abs_of_pos (inv_pos.2 hr)]
/-- Continuity in the centre of the blow-up integrals of Simon Ch. 3, 1.4: for `f` continuous with
compact support, `r > 0` and `μ` finite on compact sets, `x ↦ ∫ f(η_{x,r}(y)) dμ(y)` is continuous,
`η_{x,r}(y) = r⁻¹(y − x)`.  With `‖f‖ ≤ C` and `tsupport f ⊆ B̄_R(0)`, the integrand vanishes for
`x ∈ B_1(x₀)` and `y ∉ B = B̄_{1+rR}(x₀)`; so near `x₀` it is dominated by `C·1_B`, integrable as
`μ(B) < ∞`, and dominated convergence gives continuity at `x₀`. -/
theorem Submission.continuous_integral_comp_blowUpMap : ∀ (P : ℕ) (μ : Measure (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → μ K ≠ ∞) → ∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → ∀ r : ℝ, 0 < r → Continuous (fun x : Euclid P => ∫ y, f (Poincare.SimonGMT.Chapter03.blowUpMap x r y) ∂μ) := by
  intro P μ hμ f hf hfs r hr
  -- `‖f‖ ≤ C` and `tsupport f ⊆ closedBall 0 R`
  obtain ⟨C, hC⟩ := hf.bounded_above_of_compact_support hfs
  obtain ⟨R, hR⟩ := hfs.isCompact.isBounded.subset_closedBall 0
  -- `(x, y) ↦ f (r⁻¹ • (y - x))` is jointly continuous
  have hF : Continuous fun p : Euclid P × Euclid P =>
      f (Poincare.SimonGMT.Chapter03.blowUpMap p.1 r p.2) :=
    hf.comp ((continuous_snd.sub continuous_fst).const_smul r⁻¹)
  refine continuous_iff_continuousAt.2 fun x₀ => ?_
  -- dominated convergence with the bound `C · 1_B`, `B = closedBall x₀ (1 + r R)`
  refine continuousAt_of_dominated (bound := (closedBall x₀ (1 + r * R)).indicator fun _ => C)
    (Eventually.of_forall fun x => (hF.comp (Continuous.prodMk_right x)).aestronglyMeasurable)
    ?_ ?_ (Eventually.of_forall fun y => (hF.comp (Continuous.prodMk_left y)).continuousAt)
  · -- for `x ∈ ball x₀ 1`, `f (r⁻¹ • (y - x)) ≠ 0` forces `‖y - x‖ ≤ r R`, so `y ∈ B`
    filter_upwards [ball_mem_nhds x₀ one_pos] with x hx
    refine Eventually.of_forall fun y => ?_
    by_cases hy : y ∈ closedBall x₀ (1 + r * R)
    · rw [indicator_of_mem hy]
      exact hC _
    · rw [indicator_of_notMem hy]
      refine le_of_eq (norm_eq_zero.2 (by_contra fun h => hy ?_))
      have h1 := hR (subset_tsupport f h)
      rw [mem_closedBall, dist_zero_right, Poincare.SimonGMT.Chapter03.blowUpMap, norm_smul,
        Real.norm_eq_abs, abs_inv, abs_of_pos hr, inv_mul_le_iff₀ hr, ← dist_eq_norm] at h1
      rw [mem_ball] at hx
      rw [mem_closedBall]
      linarith [dist_triangle y x x₀]
  · -- `C · 1_B` is integrable: `B` is compact, so `μ B < ∞`
    rw [integrable_indicator_iff measurableSet_closedBall]
    exact integrableOn_const (hμ _ (isCompact_closedBall _ _))

/-- **Simon Ch. 3, 1.4**: if `Hⁿ(M ∩ K) < ∞` for every compact `K`, `f` is continuous with
compact support and `r > 0`, then the blow-up integral `x ↦ ∫_{η_{x,r}(M)} f dHⁿ` is continuous.
It equals `r⁻ⁿ ∫_M f(η_{x,r}(y)) dHⁿ(y)`, continuous in `x` because `Hⁿ⌞M` is finite on compact
sets. -/
theorem Submission.continuous_blowUp_image_setIntegral : ∀ (P n : ℕ) (M : Set (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → μHE[n] (M ∩ K) ≠ ∞) → ∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → ∀ r : ℝ, 0 < r → Continuous (fun x : Euclid P => ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, f y ∂μHE[n]) := by
  intro P n M hM f hf hfs r hr
  -- `Hⁿ⌞M` is finite on compact sets: `(Hⁿ⌞M)(K) = Hⁿ(M ∩ K)`, `K` being closed
  have hμ : ∀ K : Set (Euclid P), IsCompact K → (μHE[n].restrict M) K ≠ ∞ := fun K hK => by
    rw [Measure.restrict_apply hK.isClosed.measurableSet, inter_comm]
    exact hM K hK
  -- change of variables, then continuity of `x ↦ r⁻ⁿ ∫_M f(η_{x,r}(y)) dHⁿ(y)`
  exact (continuous_const.mul
    (Submission.continuous_integral_comp_blowUpMap P _ hμ f hf hfs r hr)).congr fun x =>
      (Submission.setIntegral_blowUpMap_image_eq_inv_pow_mul P n M x r hr f).symm
/-- A field of orthogonal projections `p_x = (K x).starProjection` is a.e.-measurable (Borel
σ-algebra of the operator-norm topology) when each quadratic form `x ↦ |p_x u|²` is.  As `p_x` is
self-adjoint and idempotent, `⟪p_x u, w⟫ = (|p_x(u + w)|² − |p_x(u − w)|²)/4`, so the matrix
coefficients `⟪p_x e_a, e_b⟫` are a.e.-measurable, and `p_x = Σ_{a,b} ⟪p_x e_a, e_b⟫ ⟪e_a, ·⟫ e_b`
is a continuous linear function of them. -/
theorem Submission.aemeasurable_starProjection_of_aemeasurable_norm_sq : ∀ (P : ℕ) (μ : Measure (Euclid P)) (K : Euclid P → Submodule ℝ (Euclid P)), (∀ u : Euclid P, AEMeasurable (fun x => ‖(K x).starProjection u‖ ^ 2) μ) → AEMeasurable (fun x => (K x).starProjection) μ := by
  intro P μ K h
  -- by polarization every coefficient `x ↦ ⟪p_x u, w⟫` is a.e.-measurable
  have hcoef : ∀ u w : Euclid P,
      AEMeasurable (fun x => inner ℝ ((K x).starProjection u) w) μ := by
    intro u w
    have key : ∀ x, inner ℝ ((K x).starProjection u) w =
        (‖(K x).starProjection (u + w)‖ ^ 2 - ‖(K x).starProjection (u - w)‖ ^ 2) / 4 := by
      intro x
      have hsym : inner ℝ ((K x).starProjection u) w =
          inner ℝ ((K x).starProjection u) ((K x).starProjection w) := by
        rw [Submodule.inner_starProjection_left_eq_right,
          Submodule.inner_starProjection_left_eq_right,
          Submodule.starProjection_eq_self_iff.2 ((K x).starProjection_apply_mem w)]
      rw [hsym, map_add, map_sub, norm_add_sq_real, norm_sub_sq_real]
      ring
    simp_rw [key]
    exact ((h (u + w)).sub (h (u - w))).div_const 4
  -- `p_x = Λ (g x)`, `Λ m = ∑ m_{ab} ⟪e_a, ·⟫ e_b`, `g x = (⟪p_x e_a, e_b⟫)_{ab}`
  let e := EuclideanSpace.basisFun (Fin P) ℝ
  let Λ : (Fin P × Fin P → ℝ) → (Euclid P →L[ℝ] Euclid P) := fun m =>
    ∑ ab, m ab • (innerSL ℝ (e ab.1)).smulRight (e ab.2)
  have heq : (fun x => (K x).starProjection) =
      fun x => Λ fun ab => inner ℝ ((K x).starProjection (e ab.1)) (e ab.2) := by
    funext x
    refine ContinuousLinearMap.ext fun v => ?_
    simp only [Λ, FunLike.coe_sum, Finset.sum_apply, FunLike.coe_smul,
      Pi.smul_apply, ContinuousLinearMap.smulRight_apply, innerSL_apply_apply,
      Fintype.sum_prod_type]
    calc (K x).starProjection v = (K x).starProjection (∑ a, inner ℝ (e a) v • e a) := by
          rw [e.sum_repr']
      _ = ∑ a, inner ℝ (e a) v • (K x).starProjection (e a) := by
          simp only [map_sum, map_smul]
      _ = ∑ a, inner ℝ (e a) v • ∑ b, inner ℝ (e b) ((K x).starProjection (e a)) • e b := by
          simp only [e.sum_repr']
      _ = _ := by
          refine Finset.sum_congr rfl fun a _ => ?_
          rw [Finset.smul_sum]
          refine Finset.sum_congr rfl fun b _ => ?_
          rw [real_inner_comm (e b), smul_smul, smul_smul, mul_comm]
  -- `Λ` is continuous and `g` is a.e.-measurable coordinatewise
  have hΛ : Continuous Λ :=
    continuous_finsetSum _ fun ab _ => (continuous_apply ab).smul continuous_const
  rw [heq]
  exact hΛ.measurable.comp_aemeasurable (AEMeasurable.of_eval fun ab => hcoef _ _)
/-- **Simon Ch. 3, 1.4** (used in Ch. 6, 3.2(3)): approximate tangent spaces only see a set up to
`Hⁿ`-null sets.  For `r ≠ 0` the blow-up `η_{x,r}(y) = r⁻¹(y - x)` is a translation followed by a
dilation, so it maps `Hⁿ`-null sets to `Hⁿ`-null sets.  As `η(A) \ η(B) ⊆ η(A \ B)` and
`η(B) \ η(A) ⊆ η(B \ A)`, the blow-ups of `A` and `B` agree up to `Hⁿ`-null sets, so their
integrals coincide for every `r > 0` and have the same limits as `r ↓ 0`. -/
theorem Submission.hasApproximateTangentSpaceAt_iff_of_null_sdiff : ∀ (P n : ℕ) (A B : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)), μHE[n] (A \ B) = 0 → μHE[n] (B \ A) = 0 → (HasApproximateTangentSpaceAt n A x Q ↔ HasApproximateTangentSpaceAt n B x Q) := by
  intro P n A B x Q hAB hBA
  -- `η_{x,r} = (r⁻¹ • ·) ∘ (· - x)` maps `Hⁿ`-null sets to `Hⁿ`-null sets when `r ≠ 0`
  have himg_null : ∀ r : ℝ, r ≠ 0 → ∀ S : Set (Euclid P), μHE[n] S = 0 →
      μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' S) = 0 := by
    intro r hr S hS
    have himg : Poincare.SimonGMT.Chapter03.blowUpMap x r '' S =
        (fun z => r⁻¹ • z) '' ((fun y => y - x) '' S) := by
      rw [Set.image_image]
      rfl
    have hiso : Isometry (fun y : Euclid P => y - x) := (IsometryEquiv.subRight x).isometry
    rw [himg, Set.image_smul, Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hr),
      hiso.euclideanHausdorffMeasure_image, hS, smul_zero]
  -- for `r ≠ 0` the blow-ups of `A` and `B` agree up to `Hⁿ`-null sets, hence so do the integrals
  have hint : ∀ r : ℝ, r ≠ 0 → ∀ f : CompactlySupportedContinuousMap (Euclid P) ℝ,
      ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' A, f y ∂μHE[n] =
        ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' B, f y ∂μHE[n] := by
    intro r hr f
    apply setIntegral_congr_set
    refine ae_eq_set.2 ⟨?_, ?_⟩
    · exact measure_mono_null (Set.subset_image_sdiff _ _ _) (himg_null r hr _ hAB)
    · exact measure_mono_null (Set.subset_image_sdiff _ _ _) (himg_null r hr _ hBA)
  -- the integrals agree on `(0, ∞) ∈ 𝓝[>] 0`, so they have the same limits as `r ↓ 0`
  constructor
  · rintro ⟨hdim, hlim⟩
    refine ⟨hdim, fun f => (hlim f).congr' ?_⟩
    filter_upwards [self_mem_nhdsWithin] with r hr
    exact hint r (ne_of_gt hr) f
  · rintro ⟨hdim, hlim⟩
    refine ⟨hdim, fun f => (hlim f).congr' ?_⟩
    filter_upwards [self_mem_nhdsWithin] with r hr
    exact (hint r (ne_of_gt hr) f).symm

/-- **Simon Ch. 3, 1.4** (measurability of the approximate tangent planes): if `Hⁿ(M ∩ K) < ∞`
for every compact `K` and `Q(x)` is an approximate tangent space of `M` at `Hⁿ⌞M`-a.e. `x`, then
`x ↦ p_{Q(x)} = (Q x).starProjection` is `Hⁿ⌞M`-a.e. strongly measurable.  For `n = 0`,
`Q(x) = 0` a.e.  For `n ≥ 1` and `f_u(y) = max(1 − |y|², 0)⟨u, y⟩²`, the blow-up integrals
`x ↦ ∫_{η_{x,1/(k+1)}(M)} f_u dHⁿ` are continuous and tend a.e. to
`∫_{Q(x)} f_u dHⁿ = c|p_{Q(x)} u|²`, so every `x ↦ |p_{Q(x)} u|²` is a.e.-measurable, and hence
so is `x ↦ p_{Q(x)}`. -/
theorem Submission.cbr_ci_imc_tangent_field_aestronglyMeasurable : ∀ (P n : ℕ) (M : Set (Euclid P)) (Q : Euclid P → Submodule ℝ (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → μHE[n] (M ∩ K) ≠ ∞) → (∀ᵐ x ∂(μHE[n].restrict M), HasApproximateTangentSpaceAt n M x (Q x)) → AEStronglyMeasurable (fun x => (Q x).starProjection) (μHE[n].restrict M) := by
  intro P n M Q hloc htan
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · -- `n = 0`: `dim Q(x) = 0`, so `Q(x) = 0` and `p_{Q(x)} = 0` a.e.
    refine (aestronglyMeasurable_const (b := (0 : Euclid P →L[ℝ] Euclid P))).congr ?_
    filter_upwards [htan] with x hx
    have h0 : Q x = ⊥ := Submodule.finrank_eq_zero.1 hx.1
    rw [h0]
    ext v
    simp
  · -- `n ≥ 1`: `∫_{Q'} f_u dHⁿ = c|p_{Q'} u|²` for every `n`-plane `Q'`
    obtain ⟨c, hc, hmom⟩ := Submission.exists_plane_cutoff_quadratic_moment_eq n hn
    apply AEMeasurable.aestronglyMeasurable
    apply Submission.aemeasurable_starProjection_of_aemeasurable_norm_sq
    intro u
    -- the test function `f_u ∈ C_c(ℝᴾ)`, vanishing outside the closed unit ball
    set f : Euclid P → ℝ := fun y => max (1 - ‖y‖ ^ 2) 0 * inner ℝ u y ^ 2 with hf_def
    have hfc : Continuous f := by
      simp only [hf_def]
      fun_prop
    have hfs : HasCompactSupport f := by
      apply HasCompactSupport.intro (isCompact_closedBall (0 : Euclid P) 1)
      intro y hy
      simp only [mem_closedBall, dist_zero_right, not_le] at hy
      have h1 : 1 - ‖y‖ ^ 2 ≤ 0 := by nlinarith [norm_nonneg y]
      simp [hf_def, max_eq_right h1]
    let F : CompactlySupportedContinuousMap (Euclid P) ℝ := ⟨⟨f, hfc⟩, hfs⟩
    -- the radii `r_k = 1/(k + 1) → 0⁺`
    let r : ℕ → ℝ := fun k => 1 / ((k : ℝ) + 1)
    have hrpos : ∀ k, 0 < r k := fun k => by positivity
    have hr : Tendsto r atTop (𝓝[>] 0) :=
      tendsto_nhdsWithin_iff.2 ⟨tendsto_one_div_add_atTop_nhds_zero_nat,
        Eventually.of_forall hrpos⟩
    -- the blow-up integrals are continuous in `x`, hence measurable
    have hmeas : ∀ k, AEMeasurable (fun x => ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x (r k) '' M, f y ∂μHE[n]) (μHE[n].restrict M) := fun k =>
      (Submission.continuous_blowUp_image_setIntegral P n M hloc f hfc hfs (r k) (hrpos k)).measurable.aemeasurable
    -- and tend a.e. to `∫_{Q(x)} f_u dHⁿ = c|p_{Q(x)} u|²`
    have hlim : ∀ᵐ x ∂(μHE[n].restrict M), Tendsto (fun k => ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x (r k) '' M, f y ∂μHE[n]) atTop (𝓝 (c * ‖(Q x).starProjection u‖ ^ 2)) := by
      filter_upwards [htan] with x hx
      rw [← hmom P (Q x) hx.1 u]
      exact (hx.2 F).comp hr
    have h1 : AEMeasurable (fun x => c * ‖(Q x).starProjection u‖ ^ 2) (μHE[n].restrict M) :=
      aemeasurable_of_tendsto_metrizable_ae' hmeas hlim
    refine (h1.const_mul c⁻¹).congr (Eventually.of_forall fun x => ?_)
    simp only
    rw [← mul_assoc, inv_mul_cancel₀ hc.ne', one_mul]
/-- **Simon Ch. 6, 3.1** (integer multiplicity currents): if `Γ(ω) = ∫_M θ ⟨ω, ζ⟩ dHⁿ` with `M`
Borel and countably `n`-rectifiable, `θ > 0` on `M`, `∫_M θ dHⁿ < ∞`, and `Hⁿ`-a.e. on `M` the
density `θ` is an integer and `ζ` orients an approximate tangent space of `M`, then `Γ` is integer
multiplicity.  The bad set is `Hⁿ`-null; removing a measurable null hull `N₀` of it leaves a Borel
carrier `M'' = M \ N₀` on which everything holds pointwise, which has the approximate tangent
spaces of `M` (Ch. 3, 1.4) and `Hⁿ⌞M'' = Hⁿ⌞M`; the multiplicity is `⌊θ⌋₊` on `M''`. -/
theorem Submission.cbr_ci_imc_isIntegerMultiplicity_of_rectifiable : ∀ (P n : ℕ) (Γ : GeometricCurrentOn (univ : Set (Euclid P)) n) (M : Set (Euclid P)) (θ : Euclid P → ℝ) (ζ : Euclid P → MultiVector P n), MeasurableSet M → CountablyRectifiable n M → Measurable θ → StronglyMeasurable ζ → (∀ x ∈ M, 0 < θ x) → ∫⁻ x in M, ENNReal.ofReal (θ x) ∂μHE[n] < ∞ → (∀ ω : TestFormOn (univ : Set (Euclid P)) n, Γ ω = ∫ x in M, θ x * ζ x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → (∀ᵐ x ∂(μHE[n].restrict M), ∃ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ∧ IsUnitOrientationOf (ζ x) Q ∧ ∃ m : ℕ, θ x = m) → IsIntegerMultiplicity Γ := by
  intro P n Γ M θ ζ hM hrect hθ hζ hpos hint hrep hae
  classical
  set p : Euclid P → Prop := fun x => ∃ Q : Submodule ℝ (Euclid P),
    HasApproximateTangentSpaceAt n M x Q ∧ IsUnitOrientationOf (ζ x) Q ∧ ∃ m : ℕ, θ x = m
  -- the bad set `{x ∈ M | ¬ p x}` is `Hⁿ`-null, and so is its measurable hull `N₀`
  have hbad : μHE[n] {x | x ∈ M ∧ ¬ p x} = 0 := by
    rw [ae_restrict_iff' hM, ae_iff] at hae
    simpa only [not_imp] using hae
  set N₀ := toMeasurable (μHE[n]) {x | x ∈ M ∧ ¬ p x} with hN₀_def
  have hN₀m : MeasurableSet N₀ := measurableSet_toMeasurable _ _
  have hN₀ : μHE[n] N₀ = 0 := by rw [hN₀_def, measure_toMeasurable]; exact hbad
  -- the carrier `M'' = M \ N₀` is Borel, `p` holds on all of it, and `M'' =ᵐ M`
  set M'' := M \ N₀
  have hM''m : MeasurableSet M'' := hM.diff hN₀m
  have hM''sub : M'' ⊆ M := Set.sdiff_subset
  have hgood : ∀ x ∈ M'', p x := by
    intro x hx
    by_contra h
    exact hx.2 (subset_toMeasurable _ _ ⟨hx.1, h⟩)
  have hdiff : μHE[n] (M \ M'') = 0 := by
    refine measure_mono_null (fun x hx => ?_) hN₀
    by_contra h
    exact hx.2 ⟨hx.1, h⟩
  have hdiff' : μHE[n] (M'' \ M) = 0 := by
    rw [Set.sdiff_eq_empty.2 hM''sub, measure_empty]
  -- the multiplicity `⌊θ⌋₊` on `M''`, which is `θ` there
  let mult : Euclid P → ℕ := fun x => if x ∈ M'' then ⌊θ x⌋₊ else 0
  have hmult_eq : ∀ x ∈ M'', (mult x : ℝ) = θ x := by
    intro x hx
    obtain ⟨Q, -, -, m, hm⟩ := hgood x hx
    simp [mult, hx, hm]
  have hmult_meas : Measurable mult :=
    Measurable.ite hM''m (Nat.floor_mono.measurable.comp hθ) measurable_const
  have hmult_pos : ∀ x ∈ M'', 0 < mult x := by
    intro x hx
    have h2 := hpos x (hM''sub hx)
    rw [← hmult_eq x hx] at h2
    exact_mod_cast h2
  have hmult_int : ∀ K : Set (Euclid P), IsCompact K → K ⊆ univ →
      ∫⁻ x in M'' ∩ K, (mult x : ℝ≥0∞) ∂μHE[n] ≠ ∞ := by
    intro K _ _
    apply ne_of_lt
    calc ∫⁻ x in M'' ∩ K, (mult x : ℝ≥0∞) ∂μHE[n]
        ≤ ∫⁻ x in M'', (mult x : ℝ≥0∞) ∂μHE[n] := lintegral_mono_set inter_subset_left
      _ = ∫⁻ x in M'', ENNReal.ofReal (θ x) ∂μHE[n] := by
        apply setLIntegral_congr_fun hM''m
        intro x hx
        simp only
        rw [← hmult_eq x hx, ENNReal.ofReal_natCast]
      _ ≤ ∫⁻ x in M, ENNReal.ofReal (θ x) ∂μHE[n] := lintegral_mono_set hM''sub
      _ < ∞ := hint
  -- `M` and `M''` have the same approximate tangent spaces (Ch. 3, 1.4)
  have horients : ∀ᵐ x ∂(μHE[n].restrict M''), ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n M'' x Q ∧ IsUnitOrientationOf (ζ x) Q := by
    rw [ae_restrict_iff' hM''m]
    refine Eventually.of_forall fun x hx => ?_
    obtain ⟨Q, hQ, hor, -⟩ := hgood x hx
    exact ⟨Q, (Submission.hasApproximateTangentSpaceAt_iff_of_null_sdiff P n M M'' x Q
      hdiff hdiff').1 hQ, hor⟩
  let R : IMRep (univ : Set (Euclid P)) n :=
    { carrier := M''
      mult := mult
      orient := ζ
      measurableSet_carrier := hM''m
      carrier_subset := subset_univ _
      rectifiable := hrect.mono hM''sub
      measurable_mult := hmult_meas
      mult_pos := hmult_pos
      locallyIntegrable_mult := hmult_int
      aestronglyMeasurable_orient := hζ.aestronglyMeasurable
      orients := horients }
  -- `R` represents `Γ`: `Hⁿ⌞M = Hⁿ⌞M''` and `mult = θ` on `M''`
  refine ⟨R, fun ω => ?_⟩
  rw [hrep ω]
  have hres : μHE[n].restrict M = μHE[n].restrict M'' :=
    Measure.restrict_congr_set (ae_eq_set.2 ⟨hdiff, hdiff'⟩)
  show _ = ∫ x in M'', (mult x : ℝ) * ζ x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]
  rw [hres]
  refine setIntegral_congr_fun hM''m (fun x hx => ?_)
  simp only [hmult_eq x hx]

/-- **Integer multiplicity criterion** (Simon Ch. 6, 3.1, with Ch. 3, 1.4 and the rectifiability
criterion `(RECT)`, assumed as the first hypothesis).  Let `Γ(ω) = ∫_M θ⟨ω, ζ⟩ dHⁿ` with `M` Borel,
`Hⁿ(M) < ∞`, `θ > 0` on `M` and `∫_M θ dHⁿ < ∞`.  If at `Hⁿ`-a.e. `x ∈ M` the multiplicity `θ(x)` is
a natural number and `ζ(x)` orients an approximate tangent space of `M`, then `Γ` is integer
multiplicity.  At such `x` the plane `Tₓ = approxTangentPlane n M x` is an approximate tangent
space; `Hⁿ(M ∩ K) ≤ Hⁿ(M) < ∞`, so `x ↦ p_{Tₓ}` is `Hⁿ⌞M`-a.e. strongly measurable and `(RECT)`
makes `M` countably `n`-rectifiable.  The representation is then assembled on a Borel part of `M`
of full measure. -/
theorem Submission.cbr_ci_isIntegerMultiplicity_of_ae_tangent : (∀ (P n : ℕ) (M : Set (Euclid P)) (Q : Euclid P → Submodule ℝ (Euclid P)), MeasurableSet M → μHE[n] M ≠ ∞ → AEStronglyMeasurable (fun x => (Q x).starProjection) (μHE[n].restrict M) → (∀ᵐ x ∂(μHE[n].restrict M), HasApproximateTangentSpaceAt n M x (Q x)) → CountablyRectifiable n M) → ∀ (P n : ℕ) (Γ : GeometricCurrentOn (univ : Set (Euclid P)) n) (M : Set (Euclid P)) (θ : Euclid P → ℝ) (ζ : Euclid P → MultiVector P n), MeasurableSet M → μHE[n] M < ∞ → Measurable θ → StronglyMeasurable ζ → (∀ x ∈ M, 0 < θ x) → ∫⁻ x in M, ENNReal.ofReal (θ x) ∂μHE[n] < ∞ → (∀ ω : TestFormOn (univ : Set (Euclid P)) n, Γ ω = ∫ x in M, θ x * ζ x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → (∀ᵐ x ∂(μHE[n].restrict M), ∃ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ∧ IsUnitOrientationOf (ζ x) Q ∧ ∃ m : ℕ, θ x = m) → IsIntegerMultiplicity Γ := by
  intro hRECT P n Γ M θ ζ hM hfin hθ hζ hpos hint hrep hae
  -- `Tₓ = approxTangentPlane n M x` is an approximate tangent space of `M` at a.e. `x ∈ M`
  have htan : ∀ᵐ x ∂(μHE[n].restrict M),
      HasApproximateTangentSpaceAt n M x (approxTangentPlane n M x) := by
    filter_upwards [hae] with x hx
    obtain ⟨Q, hQ, -⟩ := hx
    have h : ∃ Q, HasApproximateTangentSpaceAt n M x Q := ⟨Q, hQ⟩
    rw [approxTangentPlane, dite_eq_left h]
    exact h.choose_spec
  -- `Hⁿ(M ∩ K) ≤ Hⁿ(M) < ∞`, so `x ↦ p_{Tₓ}` is a.e. strongly measurable and `(RECT)` applies
  have hloc : ∀ K : Set (Euclid P), IsCompact K → μHE[n] (M ∩ K) ≠ ∞ := fun K _ =>
    ne_top_of_le_ne_top hfin.ne (measure_mono inter_subset_left)
  have hrect : CountablyRectifiable n M :=
    hRECT P n M (approxTangentPlane n M) hM hfin.ne
      (Submission.cbr_ci_imc_tangent_field_aestronglyMeasurable P n M _ hloc htan) htan
  -- assemble the integer multiplicity representation of `Γ` on the rectifiable `M`
  exact Submission.cbr_ci_imc_isIntegerMultiplicity_of_rectifiable P n Γ M θ ζ hM hrect hθ hζ
    hpos hint hrep hae
/-- **The integer slice property passes to weak limits** (Simon Ch. 6, 8.2–8.3, the slicing step
of the closure theorem used in 7.2.4).  Assume (REP), (MR), (IMC), (SL) and CL(d).  If `Xᵢ ⇀ X`
in `ℝᴾ`, every `Xᵢ ∈ 𝒟_{d+1}(ℝᴾ)` has the integer slice property and
`supᵢ (M_W(Xᵢ) + M_W(∂Xᵢ)) < ∞` for every open `W ⊂⊂ ℝᴾ`, then `X` has the integer slice
property.  Represent `Xᵢ` and `∂Xᵢ` by (REP) and pass by (T1) to a subsequence with limit measures
`ν`, `ν'`.  For a.e. `t` the slices `Z_{j,t} = ∂A_{j,t} − B_{j,t}` of the subsequence are integer
multiplicity (ISP), have `liminfⱼ (M_{W_k}(Z_{j,t}) + M_{W_k}(∂Z_{j,t})) < ∞` on every ball
`W_k = B_{k+1}(0)` (`cbrsl_slice_boundary_mass_bound`, `cbrsl_ae_liminf_lt_top`), and
`ν{f = t} = ν'{f = t} = 0`.  Then (T2) gives `Z_{j,t} ⇀ ∂A − B`, which is integer multiplicity by
`cbrsl_isIntegerMultiplicity_of_local_liminf_bounds`. -/
theorem Submission.cbr_slice_property_of_weak_limit : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → ∀ d : ℕ, (∀ (P : ℕ) (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U d) (T : GeometricCurrentOn U d), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T) → ∀ (P : ℕ) (Xs : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (X : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), (∀ i, (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), Xs i ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (Xs i).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B))) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ → ⨆ i, ((Xs i).massOn W + (Xs i).boundary.massOn W) < ∞) → WeaklyConvergesOn Xs X → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), X ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (X).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B)) := by
  intro hREP hMR hIMC hSL d hCL P Xs X hISP hbound hconv μ μ' ξ ξ' hμ hμ' hξm hξm' hξ hξ' hX hXb
    f L hf
  -- integer multiplicity is local in `ℝᴾ` and passes to open subdomains
  have hLOC := Submission.cbr_isIntegerMultiplicity_of_local hREP hMR hIMC
  -- every ball `B_r(0)` is compactly contained in `ℝᴾ`
  have hball : ∀ r : ℝ, CompactlyContained (ball (0 : Euclid P) r) univ := fun r =>
    ⟨(isCompact_closedBall 0 r).of_isClosed_subset isClosed_closure closure_ball_subset_closedBall,
      subset_univ _⟩
  -- Step 1: `M_W(Xᵢ)` and `M_W(∂Xᵢ)` are bounded by `Λ_W = supᵢ (M_W(Xᵢ) + M_W(∂Xᵢ)) < ∞`
  have hfin : ∀ i, ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ →
      (Xs i).massOn W < ∞ ∧ (Xs i).boundary.massOn W < ∞ := fun i W hW hWc =>
    ⟨(le_self_add.trans (le_iSup (fun j => (Xs j).massOn W + (Xs j).boundary.massOn W) i)).trans_lt
        (hbound W hW hWc),
      (le_add_self.trans (le_iSup (fun j => (Xs j).massOn W + (Xs j).boundary.massOn W) i)).trans_lt
        (hbound W hW hWc)⟩
  -- Step 3: mass representations `(μᵢ, ξᵢ)` of `Xᵢ` and `(μ'ᵢ, ξ'ᵢ)` of `∂Xᵢ` (REP)
  choose μs ξs _ hμsK hμsW hξsm hξs hXs _ using fun i =>
    hREP P (d + 1) univ (Xs i) isOpen_univ fun W hW hWc => (hfin i W hW hWc).1
  choose μs' ξs' _ hμs'K hμs'W hξs'm hξs' hXs' _ using fun i =>
    hREP P d univ (Xs i).boundary isOpen_univ fun W hW hWc => (hfin i W hW hWc).2
  -- `μᵢ(W) + μ'ᵢ(W) = M_W(Xᵢ) + M_W(∂Xᵢ) ≤ Λ_W` for open `W`
  have hsum : ∀ i, ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ →
      μs i W + μs' i W ≤ ⨆ j, ((Xs j).massOn W + (Xs j).boundary.massOn W) := fun i W hW _ => by
    rw [← hμsW i W hW, ← hμs'W i W hW]
    exact le_iSup (fun j => (Xs j).massOn W + (Xs j).boundary.massOn W) i
  -- for compact `K ⊆ B_r(0)`: `supᵢ μᵢ(K) ≤ Λ_{B_r(0)}` and `supᵢ μ'ᵢ(K) ≤ Λ_{B_r(0)}`
  have hsupK : ∀ K : Set (Euclid P), IsCompact K → K ⊆ univ →
      ⨆ i, μs i K < ∞ ∧ ⨆ i, μs' i K < ∞ := by
    intro K hK _
    obtain ⟨r, hr⟩ := hK.isBounded.subset_ball (0 : Euclid P)
    have hW := hbound _ isOpen_ball (hball r)
    exact ⟨(iSup_le fun i => (measure_mono hr).trans
        (le_self_add.trans (hsum i _ isOpen_ball (hball r)))).trans_lt hW,
      (iSup_le fun i => (measure_mono hr).trans
        (le_add_self.trans (hsum i _ isOpen_ball (hball r)))).trans_lt hW⟩
  -- Step 4: limit measures `ν`, `ν'` along a subsequence `φ = φ₁ ∘ φ₂` (T1, applied twice)
  obtain ⟨φ₁, ν, hφ₁, -, hνK, -, hνlim, -⟩ :=
    (Submission.cbr_measure_convergence_tools).1 P univ μs isOpen_univ fun K hK hKU =>
      (hsupK K hK hKU).1
  obtain ⟨φ₂, ν', hφ₂, -, hν'K, -, hν'lim, -⟩ :=
    (Submission.cbr_measure_convergence_tools).1 P univ (fun j => μs' (φ₁ j)) isOpen_univ
      fun K hK hKU => (iSup_le fun j => le_iSup (fun i => μs' i K) (φ₁ j)).trans_lt
        (hsupK K hK hKU).2
  -- a further subsequence keeps the `limsup` bound
  have hνlim' : ∀ K : Set (Euclid P), IsCompact K → K ⊆ univ →
      limsup (fun j => μs (φ₁ (φ₂ j)) K) atTop ≤ ν K := fun K hK hKU =>
    (hφ₂.tendsto_atTop.limsup_comp_le_limsup (u := fun j => μs (φ₁ j) K)).trans (hνlim K hK hKU)
  -- the subsequence still converges weakly to `X`
  have hconvφ : WeaklyConvergesOn (fun j => Xs (φ₁ (φ₂ j))) X := fun ω =>
    (hconv ω).comp (hφ₁.tendsto_atTop.comp hφ₂.tendsto_atTop)
  -- Step 5: slices `A_{j,t}` of `X_{φ j}` and `B_{j,t}` of `∂X_{φ j}`, with
  -- `M_W(Z_{j,t}) + M_W(∂Z_{j,t}) ≤ L liminf_{h↓0} h⁻¹ (μ_{φ j} + μ'_{φ j})(W ∩ {t − h < f < t})`
  -- for `Z_{j,t} = ∂A_{j,t} − B_{j,t}`
  choose A B hA hB hAB using fun j =>
    Submission.cbrsl_slice_boundary_mass_bound hSL P d univ (Xs (φ₁ (φ₂ j))) (μs (φ₁ (φ₂ j)))
      (μs' (φ₁ (φ₂ j))) (ξs (φ₁ (φ₂ j))) (ξs' (φ₁ (φ₂ j))) f L isOpen_univ (hμsK _) (hμs'K _)
      (hξsm _) (hξs'm _) (ae_of_all _ (hξs _)) (ae_of_all _ (hξs' _)) (hXs _) (hXs' _) hf
  -- Step 6: (ISP) of the `X_{φ j}`: for a.e. `t`, every `Z_{j,t}` is integer multiplicity
  have hIM : ∀ᵐ t ∂(volume : Measure ℝ), ∀ j,
      IsIntegerMultiplicity ((A j t).boundary - B j t) := by
    rw [ae_all_iff]
    intro j
    filter_upwards [hISP (φ₁ (φ₂ j)) (μs (φ₁ (φ₂ j))) (μs' (φ₁ (φ₂ j))) (ξs (φ₁ (φ₂ j)))
      (ξs' (φ₁ (φ₂ j))) (fun K hK => hμsK _ K hK (subset_univ K))
      (fun K hK => hμs'K _ K hK (subset_univ K)) (hξsm _) (hξs'm _) (ae_of_all _ (hξs _))
      (ae_of_all _ (hξs' _)) (hXs _) (hXs' _) f L hf] with t ht
    exact ht (A j t) (B j t) (hA j t) (hB j t)
  -- Step 7: good parameters (MM): for a.e. `t`,
  -- `liminfⱼ (M_{W_k}(Z_{j,t}) + M_{W_k}(∂Z_{j,t})) < ∞` for every `W_k = B_{k+1}(0)`, as
  -- `(μ_{φ j} + μ'_{φ j})(W_k) ≤ Λ_{W_k}`
  have hΛ : ∀ k : ℕ, ⨆ j, (μs (φ₁ (φ₂ j)) + μs' (φ₁ (φ₂ j)))
      (ball (0 : Euclid P) ((k : ℝ) + 1)) < ∞ := fun k =>
    (iSup_le fun j => (Measure.add_apply _ _ _).trans_le (hsum (φ₁ (φ₂ j)) _ isOpen_ball
      (hball ((k : ℝ) + 1)))).trans_lt (hbound _ isOpen_ball (hball ((k : ℝ) + 1)))
  have hgood := Submission.cbrsl_ae_liminf_lt_top (Submission.cbr_measure_convergence_tools).2.2 P
    (fun j => μs (φ₁ (φ₂ j)) + μs' (φ₁ (φ₂ j))) f L
    (fun j k t => ((A j t).boundary - B j t).massOn (ball (0 : Euclid P) ((k : ℝ) + 1)) +
      boundaryMassOn ((A j t).boundary - B j t) (ball (0 : Euclid P) ((k : ℝ) + 1)))
    hf.continuous hΛ fun j k t => hAB j _ t isOpen_ball
  -- the level sets `{f = t}` are `ν`- and `ν'`-null for all but countably many `t`
  have hlevel : ∀ ν₀ : Measure (Euclid P), (∀ K : Set (Euclid P), IsCompact K → K ⊆ univ →
      ν₀ K < ∞) → ∀ᵐ t ∂(volume : Measure ℝ), ν₀ {x | f x = t} = 0 := by
    intro ν₀ hν₀
    have : IsFiniteMeasureOnCompacts ν₀ := ⟨fun K hK => hν₀ K hK (subset_univ K)⟩
    filter_upwards [(Measure.countable_meas_level_set_pos (μ := ν₀)
      hf.continuous.measurable).ae_notMem volume] with t ht
    simpa using ht
  -- Steps 8–11: for such `t`, `Z_{j,t} ⇀ ∂A − B` (T2 for `X_{φ j}` and `∂X_{φ j}`), and
  -- `cbrsl_isIntegerMultiplicity_of_local_liminf_bounds` makes `∂A − B` integer multiplicity
  filter_upwards [hIM, hgood, hlevel ν hνK, hlevel ν' hν'K] with t hIMt hgoodt hνt hν't
  intro A' B' hA' hB'
  refine Submission.cbrsl_isIntegerMultiplicity_of_local_liminf_bounds d hCL hLOC P
    (fun j => (A j t).boundary - B j t) (A'.boundary - B') hIMt (fun η => ?_) hgoodt
  have h1 := (Submission.cbr_measure_convergence_tools).2.1 P (d + 1) univ
    (fun j => Xs (φ₁ (φ₂ j))) X (fun j => μs (φ₁ (φ₂ j))) (fun j => ξs (φ₁ (φ₂ j))) μ ν ξ f t
    isOpen_univ hf.continuous hconvφ (fun j => hμsK _) (fun j => hξsm _)
    (fun j => ae_of_all _ (hξs _)) (fun j => hXs _) (fun K hK _ => hμ K hK) hξm hξ hX hνK hνlim'
    hνt (exteriorDerivativeTestOn univ d η)
  have h2 := (Submission.cbr_measure_convergence_tools).2.1 P d univ
    (fun j => (Xs (φ₁ (φ₂ j))).boundary) X.boundary (fun j => μs' (φ₁ (φ₂ j)))
    (fun j => ξs' (φ₁ (φ₂ j))) μ' ν' ξ' f t isOpen_univ hf.continuous hconvφ.boundary
    (fun j => hμs'K _) (fun j => hξs'm _) (fun j => ae_of_all _ (hξs' _)) (fun j => hXs' _)
    (fun K hK _ => hμ' K hK) hξm' hξ' hXb hν'K hν'lim hν't η
  -- `(∂S − R)(η) = S(dη) − R(η)`
  have hval : ∀ (S : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1))
      (R : GeometricCurrentOn (univ : Set (Euclid P)) d),
      (S.boundary - R) η = S (exteriorDerivativeTestOn univ d η) - R η := fun _ _ => rfl
  show Tendsto (fun j => ((A j t).boundary - B j t) η) atTop (𝓝 ((A'.boundary - B') η))
  simp only [hval, hA, hB, hA', hB']
  exact h1.sub h2
/-- **Deformation onto the `n`-skeleton** (Simon Ch. 6, proof of the Deformation Theorem 5.1,
displays (1)–(25), chapter-06.txt lines 1405–1928), `n = m + 1`: an integer multiplicity
`T ∈ 𝒟ₙ(ℝᴾ)` with compact support and `M(T), M(∂T) < ∞` has `T − Q₀ − S₁ = ∂R₁` with `Q₀`, `R₁`
integer multiplicity, `spt Q₀` in the `n`-skeleton `L_n` of the unit cubical grid, masses at most
`c M(T)` resp. `c M(∂T)`, and supports within `√P` of `spt T` resp. `spt ∂T`.  If `n ≥ P` then
`L_n = ℝᴾ`, and `Q₀ = T`, `R₁ = S₁ = 0`.  Otherwise the good centre `a` (`cmcdt_good_center` for
the finite mass measures of `T` and `∂T`) gives `M_{d<r}(T) ≤ C r^{n+1} M(T)` and
`M_{d<r}(∂T) ≤ C r^{n+1} M(∂T)` for `d = dist(·, L*(a))`; `cmcsd_shell_decomposition` cuts `T`
into integer multiplicity shells `W_j` at radii `r_j ∈ (2^{-j-3}, 2^{-j-2})`; the retraction `ψ` of
`cmcdt_skeleton_retraction` is `(c_R/r_j)`-Lipschitz on `{d ≥ r_j}`, and its McShane extension
`φ_j` is `Λ_j`-Lipschitz, `Λ_j = max(1, √P c_R/r_j) ≤ c₄ 2^j` for `c₄ = 1 + 8√P c_R`;
`cmcsd_dyadic_series_bounds` sums the mass series, and `cmcsd_telescoping_deformation` (with the
push-forwards and homotopies of `cmcdt_lipschitz_pushforward_homotopy`, the series of
`cmcdt_im_series` and `δ = √P`) deforms and sums the shells, with
`c = (1 + √P)(2c₄)^{m+1}(1 + C)`. -/
theorem Submission.cmcdt_skeleton_deformation : (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → ∀ (P m : ℕ), ∃ c : NNReal, 1 ≤ c ∧ ∀ T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity T → IsCompact T.support → T.mass < ∞ → T.boundary.mass < ∞ → ∃ (Q₀ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R₁ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S₁ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q₀ ∧ IsIntegerMultiplicity R₁ ∧ T - Q₀ - S₁ = R₁.boundary ∧ Q₀.support ⊆ {x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} ∧ Q₀.mass ≤ c * T.mass ∧ Q₀.boundary.mass ≤ c * T.boundary.mass ∧ R₁.mass ≤ c * T.mass ∧ S₁.mass ≤ c * T.boundary.mass ∧ Q₀.support ∪ R₁.support ⊆ cthickening (Real.sqrt P) T.support ∧ Q₀.boundary.support ∪ S₁.support ⊆ cthickening (Real.sqrt P) T.boundary.support := by
  intro hVO hMR hREP hIMC hSL P m
  -- `M(0) = 0` in every degree
  have hzero : ∀ k : ℕ, (0 : GeometricCurrentOn (univ : Set (Euclid P)) k).mass = 0 := by
    intro k
    refine le_antisymm (sSup_le ?_) zero_le
    rintro _ ⟨ω, -, rfl⟩
    simp
  by_cases hPm : m + 1 < P
  swap
  · -- Step 1: for `n = m + 1 ≥ P`, `L_n = ℝᴾ` (take `s = ∅`); `Q₀ = T`, `R₁ = S₁ = 0`, `c = 1`
    have hPm' : P ≤ m + 1 := not_lt.1 hPm
    have hsc := Submission.cmcsd_support_calculus P
    refine ⟨1, le_rfl, fun T hT _ _ _ => ⟨T, 0, 0, hT,
      Submission.cmcsd_zero_isIntegerMultiplicity P (m + 2) univ, ?_,
      fun x _ => ⟨∅, by simpa using hPm', by simp⟩, by rw [ENNReal.coe_one, one_mul],
      by rw [ENNReal.coe_one, one_mul], by rw [hzero]; exact zero_le, by rw [hzero]; exact zero_le,
      ?_, ?_⟩⟩
    · ext ω
      change T ω - T ω - 0 = 0
      ring
    · rw [(hsc (m + 2)).2.2.2.1, union_empty]
      exact self_subset_cthickening _
    · rw [(hsc (m + 1)).2.2.2.1, union_empty]
      exact self_subset_cthickening _
  -- Step 2: the constants `c_R` (RET), `C` (GC); the operators `push`, `homot` (PF); (IMS)
  obtain ⟨cR, hcR, hRET⟩ := Submission.cmcdt_skeleton_retraction P m hPm
  obtain ⟨C, hGC⟩ := Submission.cmcdt_good_center P m hPm
  obtain ⟨push, homot, hPF⟩ :=
    Submission.cmcdt_lipschitz_pushforward_homotopy hVO hMR hREP hIMC P
  have hIMS := Submission.cmcdt_im_series hVO hMR hIMC P
  -- `c₄ = 1 + 8√P c_R`, `X = (2c₄)^{m+1}(1 + C)` and `c = (1 + √P) X`
  obtain ⟨c₄, hc₄⟩ : ∃ c₄ : NNReal, c₄ = 1 + 8 * NNReal.sqrt P * Real.toNNReal cR := ⟨_, rfl⟩
  obtain ⟨X, hX⟩ : ∃ X : NNReal, X = (2 * c₄) ^ (m + 1) * (1 + C) := ⟨_, rfl⟩
  have h2c₄ : 1 ≤ 2 * c₄ := by
    rw [hc₄]
    calc (1 : NNReal) ≤ 2 * 1 := by norm_num
      _ ≤ 2 * (1 + 8 * NNReal.sqrt P * Real.toNNReal cR) := mul_le_mul_right le_self_add 2
  have hX1 : 1 ≤ X := by
    rw [hX]
    exact one_le_mul_of_one_le_of_one_le (one_le_pow₀ h2c₄) le_self_add
  have hXc : X ≤ (1 + NNReal.sqrt P) * X := le_mul_of_one_le_left zero_le le_self_add
  have hYX : (2 * c₄) ^ m * (1 + C) ≤ X := by
    rw [hX]
    exact mul_le_mul_left (pow_le_pow_right₀ h2c₄ (Nat.le_succ m)) _
  have hYc : (2 * c₄) ^ m * (1 + C) ≤ (1 + NNReal.sqrt P) * X := hYX.trans hXc
  have hXcast : (2 * (c₄ : ℝ≥0∞)) ^ (m + 1) * (1 + C) = (X : ℝ≥0∞) := by
    rw [hX]
    norm_cast
  have hYcast : (2 * (c₄ : ℝ≥0∞)) ^ m * (1 + C) = (((2 * c₄) ^ m * (1 + C) : NNReal) : ℝ≥0∞) := by
    norm_cast
  have hsqrt : ENNReal.ofReal (Real.sqrt P) = (NNReal.sqrt P : ℝ≥0∞) := by
    rw [← ENNReal.ofReal_coe_nnreal, Real.coe_sqrt, NNReal.coe_natCast]
  refine ⟨(1 + NNReal.sqrt P) * X, one_le_mul_of_one_le_of_one_le le_self_add hX1,
    fun T hT hTc hTm hbTm => ?_⟩
  -- Step 3: the finite mass measures `μ_T` (IMRep, MR) and `μ_∂T` (REP)
  obtain ⟨μ, -, hμfin, -, -, -, hμW, -, -⟩ :=
    Submission.cmcsd_sh_im_mass_measure hVO hMR hIMC P (m + 1) T hT hTm
  obtain ⟨μ', -, hμ'fin, -, -, -, hμ'W, -⟩ :=
    Submission.cmcsd_sh_finite_mass_measure hVO hREP P m T.boundary hbTm
  -- the good centre `a` (GC) and the retraction `ψ` (RET) for `L*(a)`
  obtain ⟨a, ha, hdens⟩ := hGC μ μ' hμfin hμ'fin
  obtain ⟨ψ, hψL, hψLip⟩ := hRET a ha
  set Ls : Set (Euclid P) :=
    {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z}
  -- `M_{d<r}(T) = μ_T{d < r}` (`{d < r}` is open) and `M(T) = μ_T(ℝᴾ)`, likewise for `∂T`
  have hdens' : ∀ r : ℝ, 0 < r → r ≤ 1 / 4 →
      T.massOn {x | infDist x Ls < r} ≤ C * ENNReal.ofReal (r ^ (m + 2)) * T.mass ∧
        T.boundary.massOn {x | infDist x Ls < r} ≤
          C * ENNReal.ofReal (r ^ (m + 2)) * T.boundary.mass := by
    intro r hr hr4
    have hopen : IsOpen {x : Euclid P | infDist x Ls < r} :=
      isOpen_lt (continuous_infDist_pt Ls) continuous_const
    have hTμ : T.mass = μ univ := hμW univ isOpen_univ
    have hbTμ : T.boundary.mass = μ' univ := hμ'W univ isOpen_univ
    rw [hμW _ hopen, hμ'W _ hopen, hTμ, hbTμ]
    exact hdens r hr hr4
  -- Step 4: the shells `W_j`, `D_j` and slices `Z_j` at radii `r_j ∈ (2^{-j-3}, 2^{-j-2})`
  obtain ⟨r, W, D, Z, hr, hWsum, hW0, hWs, hWim, hWfin, hDfin, hZfin, hWspt, hDspt, hZspt,
      hW0m, hWm, hD0m, hDm, hZm⟩ :=
    Submission.cmcsd_shell_decomposition hVO hMR hREP hIMC hSL P m T (fun x => infDist x Ls) C
      hT hTc hTm hbTm (lipschitz_infDist_pt Ls) hdens'
  have hrpos : ∀ j, 0 < r j := fun j => (pow_pos (by norm_num) _).trans (hr j).1
  have hr4 : ∀ j, r j ≤ 1 / 4 := fun j =>
    (hr j).2.le.trans
      (calc (1 / 2 : ℝ) ^ (j + 2) ≤ (1 / 2 : ℝ) ^ 2 :=
            pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega)
        _ = 1 / 4 := by norm_num)
  have hrdec : ∀ j, r (j + 1) < r j := fun j =>
    calc r (j + 1) < (1 / 2 : ℝ) ^ (j + 1 + 2) := (hr (j + 1)).2
      _ = (1 / 2 : ℝ) ^ (j + 3) := by ring
      _ < r j := (hr j).1
  -- Step 5: `ψ` is `(c_R/r_j)`-Lipschitz on `{d ≥ r_j}`; `φ_j` is its McShane extension
  have hψon : ∀ j, LipschitzOnWith (Real.toNNReal (cR / r j)) ψ {x | r j ≤ infDist x Ls} := by
    intro j
    refine LipschitzOnWith.of_dist_le_mul fun x hx y hy => ?_
    rw [Real.coe_toNNReal _ (div_pos hcR (hrpos j)).le]
    exact hψLip (r j) (hrpos j) (hr4 j) x y hx hy
  choose φ hφ hφψ using fun j =>
    Submission.cmcsd_lipschitz_extension P {x | r j ≤ infDist x Ls} ψ _ (hψon j)
  obtain ⟨Λ, hΛ⟩ : ∃ Λ : ℕ → NNReal,
      Λ = fun j => max 1 (NNReal.sqrt P * Real.toNNReal (cR / r j)) := ⟨_, rfl⟩
  have hΛ1 : ∀ j, 1 ≤ Λ j := fun j => by
    rw [hΛ]
    exact le_max_left _ _
  have hΛmono : ∀ j, Λ j ≤ Λ (j + 1) := fun j => by
    rw [hΛ]
    exact max_le_max le_rfl (mul_le_mul_right (Real.toNNReal_le_toNNReal
      (div_le_div_of_nonneg_left hcR.le (hrpos (j + 1)) (hrdec j).le)) _)
  have hΛφ : ∀ j, LipschitzWith (Λ j) (φ j) := fun j => by
    rw [hΛ]
    exact (hφ j).weaken (le_max_right _ _)
  -- `Λ_j ≤ c₄ 2^j`, as `1/r_j < 2^{j+3}`
  have hΛc₄ : ∀ j, (Λ j : ℝ) ≤ c₄ * 2 ^ j := by
    intro j
    have h2j : (1 : ℝ) ≤ 2 ^ j := one_le_pow₀ (by norm_num)
    have hsq : (0 : ℝ) ≤ Real.sqrt P := Real.sqrt_nonneg _
    have hr8 : 1 ≤ 8 * 2 ^ j * r j := by
      have h1 : (1 / 2 : ℝ) ^ (j + 3) * (8 * 2 ^ j) = 1 := by
        rw [show (8 : ℝ) * 2 ^ j = 2 ^ (j + 3) by ring, ← mul_pow]
        norm_num
      have h2 : (1 / 2 : ℝ) ^ (j + 3) * (8 * 2 ^ j) < r j * (8 * 2 ^ j) :=
        mul_lt_mul_of_pos_right (hr j).1 (by positivity)
      linarith
    have hcRr : cR / r j ≤ 8 * cR * 2 ^ j := by
      rw [div_le_iff₀ (hrpos j)]
      nlinarith [mul_le_mul_of_nonneg_left hr8 hcR.le]
    have hΛj : (Λ j : ℝ) = max 1 (Real.sqrt P * (cR / r j)) := by
      rw [hΛ]
      simp only [NNReal.coe_max, NNReal.coe_one, NNReal.coe_mul, Real.coe_sqrt,
        NNReal.coe_natCast, Real.coe_toNNReal _ (div_pos hcR (hrpos j)).le]
    have hc₄r : (c₄ : ℝ) = 1 + 8 * Real.sqrt P * cR := by
      rw [hc₄]
      simp only [NNReal.coe_add, NNReal.coe_one, NNReal.coe_mul, NNReal.coe_ofNat,
        Real.coe_sqrt, NNReal.coe_natCast, Real.coe_toNNReal _ hcR.le]
    rw [hΛj, hc₄r]
    have h8 : (0 : ℝ) ≤ 8 * Real.sqrt P * cR * 2 ^ j := by positivity
    refine max_le (by nlinarith) ?_
    calc Real.sqrt P * (cR / r j) ≤ Real.sqrt P * (8 * cR * 2 ^ j) :=
          mul_le_mul_of_nonneg_left hcRr hsq
      _ ≤ (1 + 8 * Real.sqrt P * cR) * 2 ^ j := by nlinarith
  -- Step 6: `φ_j = ψ` on `{d ≥ r_j}`, which contains `spt W_j ∪ spt D_j ∪ spt Z_j`
  have hφeq : ∀ j x, r j ≤ infDist x Ls → φ j x = ψ x := fun j x hx => hφψ j hx
  have hZeq : ∀ j, EqOn (φ (j + 1)) (φ j) (Z j).support := by
    intro j x hx
    have hxd : infDist x Ls = r j := (hZspt j hx).2
    rw [hφeq (j + 1) x ((hrdec j).le.trans hxd.ge), hφeq j x hxd.ge]
  have hsptd : ∀ j, ∀ x ∈ (W j).support ∪ (D j).support ∪ (Z j).support,
      r j ≤ infDist x Ls := by
    intro j x hx
    rcases hx with (hx | hx) | hx
    · exact (hWspt j hx).2
    · exact (hDspt j hx).2
    · exact ((hZspt j hx).2 : infDist x Ls = r j).ge
  have hdist : ∀ j, ∀ x ∈ (W j).support ∪ (D j).support ∪ (Z j).support,
      dist (φ j x) x ≤ Real.sqrt P := by
    intro j x hx
    rw [hφeq j x (hsptd j x hx)]
    exact (hψL x ((hrpos j).trans_le (hsptd j x hx))).2
  have hLmap : ∀ j, ∀ x ∈ (W j).support, φ j x ∈
      {x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} := by
    intro j x hx
    have hxd : r j ≤ infDist x Ls := (hWspt j hx).2
    rw [hφeq j x hxd]
    exact (hψL x ((hrpos j).trans_le hxd)).1
  -- `L_n` is closed: a finite union of finite intersections of preimages of `ℤ ⊆ ℝ`
  have hcoord : ∀ i : Fin P, Continuous fun x : Euclid P => x i := fun i =>
    (EuclideanSpace.proj (𝕜 := ℝ) i).continuous
  have hZcl : IsClosed (range (Int.cast : ℤ → ℝ)) := Int.isClosedEmbedding_coe_real.isClosed_range
  have hLcl : IsClosed
      {x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} := by
    have hU :
        {x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} =
          ⋃ s : Finset (Fin P),
            {x : Euclid P | P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} := by
      ext x
      simp only [mem_ofPred_eq, mem_iUnion]
    rw [hU]
    refine isClosed_iUnion_of_finite fun s => ?_
    by_cases hs : P ≤ m + 1 + s.card
    · have hS : {x : Euclid P | P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} =
          ⋂ i ∈ s, (fun x : Euclid P => x i) ⁻¹' range (Int.cast : ℤ → ℝ) := by
        ext x
        simp only [mem_ofPred_eq, mem_iInter, mem_preimage, mem_range, hs, true_and]
        exact forall₂_congr fun i _ => exists_congr fun z => eq_comm
      rw [hS]
      exact isClosed_biInter fun i _ => hZcl.preimage (hcoord i)
    · have hS : {x : Euclid P | P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} = ∅ := by
        ext x
        simp only [mem_ofPred_eq, hs, false_and, mem_empty_iff_false]
      rw [hS]
      exact isClosed_empty
  -- Step 7: the dyadic mass series
  obtain ⟨hdy1, hdy2⟩ := Submission.cmcsd_dyadic_series_bounds c₄ Λ hΛc₄
  have hWser : ∑' j, (2 * (Λ j : ℝ≥0∞)) ^ (m + 1) * (W j).mass ≤
      (2 * (c₄ : ℝ≥0∞)) ^ (m + 1) * (1 + C) * T.mass :=
    hdy1 C T.mass (m + 1) (m + 1) (fun j => (W j).mass) le_rfl hW0m hWm
  have hDser : ∑' j, (2 * (Λ j : ℝ≥0∞)) ^ m * (D j).mass ≤
      (2 * (c₄ : ℝ≥0∞)) ^ m * (1 + C) * T.boundary.mass :=
    hdy1 C T.boundary.mass m (m + 1) (fun j => (D j).mass) (Nat.le_succ m) hD0m hDm
  have hZlim : Tendsto (fun j => (2 * (Λ j : ℝ≥0∞)) ^ m * (Z j).mass) atTop (𝓝 0) :=
    hdy2 (4 * C) T.mass m (fun j => (Z j).mass)
      (ENNReal.mul_ne_top (by norm_num) ENNReal.coe_ne_top) hTm.ne hZm
  have hWfin' : ∑' j, (2 * (Λ j : ℝ≥0∞)) ^ (m + 1) * (W j).mass < ∞ := by
    refine hWser.trans_lt ?_
    rw [hXcast]
    exact ENNReal.mul_lt_top ENNReal.coe_lt_top hTm
  have hDfin' : ∑' j, (2 * (Λ j : ℝ≥0∞)) ^ m * (D j).mass < ∞ := by
    refine hDser.trans_lt ?_
    rw [hYcast]
    exact ENNReal.mul_lt_top ENNReal.coe_lt_top hbTm
  -- Step 8: deform the shells by `φ_j` and sum (PF, IMS), with `δ = √P`
  obtain ⟨Q₀, R₁, S₁, hQim, hRim, hid, hQspt, hRspt, hbQspt, hSspt, hQm, hbQm, hRm, hSm⟩ :=
    Submission.cmcsd_telescoping_deformation hVO P m push homot hPF hIMS T W D Z φ Λ (Real.sqrt P)
      {x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z}
      T.support T.boundary.support hWsum hW0 hWs hWim hWfin hDfin hZfin hΛφ hΛ1 hΛmono hZeq hdist
      hLcl hLmap (fun j => (hWspt j).trans inter_subset_left)
      (fun j => (hDspt j).trans inter_subset_left) hWfin' hDfin' hZlim
  refine ⟨Q₀, R₁, S₁, hQim, hRim, hid, fun x hx => (hQspt hx).1, ?_, ?_, ?_, ?_,
    union_subset (fun x hx => (hQspt hx).2) hRspt, union_subset hbQspt hSspt⟩
  · -- `M(Q₀) ≤ Σ_j (2Λ_j)^{m+1} M(W_j) ≤ X M(T) ≤ c M(T)`
    calc Q₀.mass ≤ (X : ℝ≥0∞) * T.mass := hQm.trans (hWser.trans_eq (by rw [hXcast]))
      _ ≤ _ := mul_le_mul_left (ENNReal.coe_le_coe.2 hXc) _
  · -- `M(∂Q₀) ≤ Σ_j (2Λ_j)^m M(D_j) ≤ (2c₄)^m (1 + C) M(∂T) ≤ c M(∂T)`
    calc Q₀.boundary.mass ≤ (((2 * c₄) ^ m * (1 + C) : NNReal) : ℝ≥0∞) * T.boundary.mass :=
          hbQm.trans (hDser.trans_eq (by rw [hYcast]))
      _ ≤ _ := mul_le_mul_left (ENNReal.coe_le_coe.2 hYc) _
  · -- `M(R₁) ≤ √P Σ_j (2Λ_j)^{m+1} M(W_j) ≤ √P X M(T) ≤ c M(T)`
    calc R₁.mass ≤ ENNReal.ofReal (Real.sqrt P) * ((X : ℝ≥0∞) * T.mass) :=
          hRm.trans (mul_le_mul_right (hWser.trans_eq (by rw [hXcast])) _)
      _ = ((NNReal.sqrt P * X : NNReal) : ℝ≥0∞) * T.mass := by
          rw [hsqrt]
          push_cast
          ring
      _ ≤ _ := mul_le_mul_left (ENNReal.coe_le_coe.2 (mul_le_mul_left le_add_self X)) _
  · -- `M(S₁) ≤ √P Σ_j (2Λ_j)^m M(D_j) ≤ √P (2c₄)^m (1 + C) M(∂T) ≤ c M(∂T)`
    calc S₁.mass ≤ ENNReal.ofReal (Real.sqrt P) *
          ((((2 * c₄) ^ m * (1 + C) : NNReal) : ℝ≥0∞) * T.boundary.mass) :=
          hSm.trans (mul_le_mul_right (hDser.trans_eq (by rw [hYcast])) _)
      _ = ((NNReal.sqrt P * ((2 * c₄) ^ m * (1 + C)) : NNReal) : ℝ≥0∞) * T.boundary.mass := by
          rw [hsqrt]
          push_cast
          ring
      _ ≤ _ := mul_le_mul_left (ENNReal.coe_le_coe.2 (mul_le_mul' le_add_self hYX)) _

/-- Chapter 7 of Simon's *Introduction to GMT*: the headline results above. -/
theorem main_theorem : MinimizingImpliesStationary ∧ ExistenceOfMinimizingFilling ∧ CompactnessOfMinimizingCurrents ∧ DensityAndTangentCones ∧ IntegerDensityAndTangentPlanes ∧ RegularSetDense ∧ DensityOneImpliesRegular ∧ SingularSetSmallWhereDensityBelowTwo ∧ HalfSpaceConeLiesInBoundary ∧ CodimensionOneRegularity ∧ RegularComponentsAreMinimizing := by sorry

/-- **Null set of points with small fillings** (Simon Ch. 6, 8.2 (4)–(6); the lower density
bound in the proof of 7.2.4).  Assume (VO).  Let `μ = μ_C` be finite on compact sets with
`M_W(C) = μ(W)` for open `W`, and `C(ω) = ∫ ⟨ω, ξ⟩ dμ` with `|ξ| ≤ 1` `μ`-a.e.  Let
`0 ≤ κ < 1 ≤ λ`.  Suppose that every `x ∈ E` has, at arbitrarily small scales `δ`, a radius
`ρ < δ` with `μ(∂B_ρ(x)) = 0` and a filling `S` with `∂S = ∂A`, where `A = C⌞B_ρ(x)`,
`M(S) ≤ κ μ(B_ρ(x))` and `spt S ⊆ B̄_{λδ}(x)`.  Then `μ(E) = 0`.
Fix `θ ∈ (κ, 1)` and a `W`-admissible `ω`.  The cone bound for the cycle `S − A` gives
`A(ω) ≤ θ μ(B_ρ(x))` at small scales.  The covering lemma then gives
`C(ω) ≤ μ(W) − (1 − θ) μ(E')` for each piece `E' = E ∩ B_k(0) ⊆ W = B_{k+1}(0)`.  Taking the
supremum over `ω` gives `μ(W) = M_W(C) ≤ μ(W) − (1 − θ) μ(E')`, so `μ(E') = 0`. -/
theorem Submission.cbrld_measure_eq_zero_of_small_fillings : (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → ∀ (P d : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (κ lam : ℝ) (E : Set (Euclid P)), 0 ≤ κ → κ < 1 → 1 ≤ lam → (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ W : Set (Euclid P), IsOpen W → C.massOn W = μ W) → AEStronglyMeasurable ξ μ → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ x ∈ E, ∀ δ : ℝ, 0 < δ → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ ∧ μ (sphere x ρ) = 0 ∧ ∃ (A S : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ y in ball x ρ, ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y) ∂μ) ∧ S.boundary = A.boundary ∧ S.mass ≤ ENNReal.ofReal κ * μ (ball x ρ) ∧ S.support ⊆ closedBall x (lam * δ)) → μ E = 0 := by
  intro hVO P d C μ ξ κ lam E hκ0 hκ1 hlam hμK hCμ hξm hξ hCξ hE
  have hball_fin : ∀ (x : Euclid P) (r : ℝ), μ (ball x r) < ∞ := fun x r =>
    (measure_mono ball_subset_closedBall).trans_lt (hμK _ (isCompact_closedBall x r))
  -- a fixed `θ ∈ (κ, 1)` plays the role of `κ + ε` in the covering lemma
  obtain ⟨θ, hκθ, hθ1⟩ := exists_between hκ1
  have hlam0 : 0 < lam := by linarith
  -- Steps 3–4: a piece `E' ⊆ E` inside an open `W` of finite measure is `μ`-null
  have hpiece : ∀ E' W : Set (Euclid P), E' ⊆ E → IsOpen W → E' ⊆ W → μ W < ∞ → μ E' = 0 := by
    intro E' W hE'E hWo hE'W hWfin
    have hE'fin : μ E' < ∞ := (measure_mono hE'W).trans_lt hWfin
    -- Step 3: every `W`-admissible `ω` satisfies `C(ω) ≤ μ(W) - (1 - θ) μ(E')`
    have hest : ∀ ω ∈ massAdmissibleOn (univ : Set (Euclid P)) (d + 1) W,
        C ω ≤ (μ W).toReal - (1 - θ) * (μ E').toReal := by
      intro ω hω
      have hωc : Continuous (ω : DifferentialForm (Euclid P) (d + 1)) :=
        ContDiff.continuous ω.property.1.1
      -- `g(y) = ξ(y)(ω(y))` is `μ`-a.e. strongly measurable with `|g| ≤ 1` `μ`-a.e.
      have hgm : AEStronglyMeasurable
          (fun y => ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y)) μ :=
        (isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable
          (hξm.prodMk hωc.aestronglyMeasurable) :)
      have hg1 : ∀ᵐ y ∂μ, |ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y)| ≤ 1 := by
        filter_upwards [hξ] with y hy
        exact (hy _).trans (hω.2 y)
      -- `g = 0` off `W`, so `C(ω) = ∫_W g dμ`
      have hCW : C ω = ∫ y in W, ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y) ∂μ := by
        rw [hCξ ω]
        refine (setIntegral_eq_integral_of_forall_compl_eq_zero fun y hy => ?_).symm
        rw [image_eq_zero_of_notMem_tsupport fun h => hy (hω.1 h), map_zero]
      -- the cone constant of `ω`
      obtain ⟨c, hc, hcone⟩ := Submission.cbrld_cycle_eval_le_radius_mul_mass hVO P d ω
      have hden : 0 < (c + 1) * lam * (1 + κ) :=
        mul_pos (mul_pos (by linarith) hlam0) (by linarith)
      obtain ⟨δ₀, hδ₀⟩ : ∃ δ₀ : ℝ, δ₀ = (θ - κ) / ((c + 1) * lam * (1 + κ)) := ⟨_, rfl⟩
      have hδ₀pos : 0 < δ₀ := by rw [hδ₀]; exact div_pos (by linarith) hden
      have hδ₀eq : δ₀ * ((c + 1) * lam * (1 + κ)) = θ - κ := by
        rw [hδ₀]; exact div_mul_cancel₀ _ hden.ne'
      -- Step 3(i): `∫_{B̄_ρ(x)} g dμ ≤ θ μ(B̄_ρ(x))` at arbitrarily small radii
      have hsmall : ∀ x ∈ E', ∀ δ' : ℝ, 0 < δ' → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ' ∧
          ∫ y in closedBall x ρ, ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y) ∂μ ≤
            θ * (μ (closedBall x ρ)).toReal := by
        intro x hx δ' hδ'
        have hδpos : 0 < min δ' δ₀ := lt_min hδ' hδ₀pos
        obtain ⟨ρ, hρ0, hρδ, hsph, A, S, hA, hbd, hSm, hSs⟩ := hE x (hE'E hx) (min δ' δ₀) hδpos
        refine ⟨ρ, hρ0, hρδ.trans_le (min_le_left _ _), ?_⟩
        have hR : 0 < lam * min δ' δ₀ := mul_pos hlam0 hδpos
        have hAs : A.support ⊆ closedBall x (lam * min δ' δ₀) :=
          (Submission.cbrld_ns_ball_current_support_subset P (d + 1) μ ξ A x ρ hA).trans
            (closedBall_subset_closedBall (hρδ.le.trans (le_mul_of_one_le_left hδpos.le hlam)))
        -- comparison with the cycle `S - A` at scale `R = λ min(δ', δ₀)`
        have hcmp := Submission.cbrld_ns_eval_le_of_small_filling P d A S ω (μ (ball x ρ)) x c κ
          (lam * min δ' δ₀) hc hκ0 hR (hball_fin x ρ) hω.2 hcone hbd
          (Submission.cbrld_ns_ball_current_mass_le P (d + 1) μ ξ A x ρ hξ hA) hSm hAs hSs
        have hcR : c * (lam * min δ' δ₀) * (1 + κ) ≤ θ - κ := by
          have h1 : 0 ≤ c * lam * (1 + κ) := mul_nonneg (mul_nonneg hc hlam0.le) (by linarith)
          have h2 : c * lam * (1 + κ) ≤ (c + 1) * lam * (1 + κ) :=
            mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (by linarith) hlam0.le)
              (by linarith)
          calc c * (lam * min δ' δ₀) * (1 + κ) = c * lam * (1 + κ) * min δ' δ₀ := by ring
            _ ≤ c * lam * (1 + κ) * δ₀ := mul_le_mul_of_nonneg_left (min_le_right _ _) h1
            _ ≤ (c + 1) * lam * (1 + κ) * δ₀ := mul_le_mul_of_nonneg_right h2 hδ₀pos.le
            _ = θ - κ := by rw [← hδ₀eq]; ring
        -- `μ(∂B_ρ(x)) = 0`, so closed and open balls agree `μ`-a.e.
        have hae : closedBall x ρ =ᵐ[μ] ball x ρ := by
          refine ae_eq_set.2 ⟨by rw [closedBall_sdiff_ball]; exact hsph, ?_⟩
          rw [sdiff_eq_empty.2 ball_subset_closedBall, measure_empty]
        rw [setIntegral_congr_set hae, measure_congr hae, ← hA ω]
        calc A ω ≤ (κ + c * (lam * min δ' δ₀) * (1 + κ)) * (μ (ball x ρ)).toReal := hcmp
          _ ≤ θ * (μ (ball x ρ)).toReal :=
            mul_le_mul_of_nonneg_right (by linarith) ENNReal.toReal_nonneg
      -- Step 3(ii): the covering lemma with `θ`
      rw [hCW]
      exact Submission.cbrld_vitali_setIntegral_le P μ
        (fun y => ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y)) θ E' W hμK hgm hg1
        hθ1.le hWo hE'W hWfin hsmall
    -- Step 4: `μ(W) = M_W(C) ≤ max(μ(W) - (1 - θ) μ(E'), 0)`
    have hmass : C.massOn W ≤ ENNReal.ofReal (max ((μ W).toReal - (1 - θ) * (μ E').toReal) 0) := by
      refine sSup_le ?_
      rintro _ ⟨ω, hω, rfl⟩
      exact ENNReal.ofReal_le_ofReal ((hest ω hω).trans (le_max_left _ _))
    rw [hCμ W hWo] at hmass
    have hreal := ENNReal.toReal_le_of_le_ofReal (le_max_right _ _) hmass
    by_contra hne
    have hpos : 0 < (μ E').toReal := ENNReal.toReal_pos hne hE'fin.ne
    have hWpos : 0 < (μ W).toReal :=
      hpos.trans_le (ENNReal.toReal_mono hWfin.ne (measure_mono hE'W))
    have hprod : 0 < (1 - θ) * (μ E').toReal := mul_pos (by linarith) hpos
    rcases le_total ((μ W).toReal - (1 - θ) * (μ E').toReal) 0 with h | h
    · rw [max_eq_right h] at hreal
      linarith
    · rw [max_eq_left h] at hreal
      linarith
  -- Step 2: `E = ⋃ₖ (E ∩ B_k(0))`, and each piece lies in the open `B_{k+1}(0)`
  have hcover : E ⊆ ⋃ k : ℕ, E ∩ ball (0 : Euclid P) k := by
    intro y hy
    obtain ⟨k, hk⟩ := exists_nat_gt (dist y 0)
    exact mem_iUnion.2 ⟨k, hy, mem_ball.2 hk⟩
  exact measure_mono_null hcover (measure_iUnion_null fun k : ℕ =>
    hpiece (E ∩ ball (0 : Euclid P) k) (ball (0 : Euclid P) (k + 1)) inter_subset_left isOpen_ball
      (fun z hz => ball_subset_ball (by linarith) hz.2) (hball_fin _ _))
/-- **Lower density bound for cycles with the integer slice property** (Simon Ch. 6, 8.2 (2)–(6),
with the lower density in place of `Θ^{*n}` and the filling's support controlled by (DT)).
Let `η₀` be the constant of `cbrld_exists_small_filling_of_low_density` for `(P, d)`, its
isoperimetric hypothesis supplied by `cbr_isoperimetric_filling` applied to (DT).  At every point
`x` of `E := {x : liminf_{r↓0} μ(B_r(x))/(ω_{d+1}r^{d+1}) < η₀}` and at every scale `δ > 0` there
are a radius `ρ ∈ (0, δ)` with `μ(∂B_ρ(x)) = 0` and a current `S` with `∂S = ∂(C⌞B_ρ(x))`,
`M(S) ≤ ½μ(B_ρ(x))` and `spt S ⊆ B̄_{(1+3√P)δ}(x)`.  These are exactly the hypotheses of
`cbrld_measure_eq_zero_of_small_fillings` with (VO), `κ = 1/2` and `λ = 1 + 3√P ≥ 1`, so
`μ(E) = 0`, which is the a.e. bound (`ae_iff`). -/
theorem Submission.cbr_lower_density_of_slice_property : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → (∀ (P m : ℕ), ∃ c : NNReal, 1 ≤ c ∧ ∀ (ρ : ℝ) (K : Set (Euclid P)) (Λ : NNReal), 0 < ρ → IsCompact K → ∃ 𝒬 : Set (GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 𝒬.Finite ∧ ∀ T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity T → T.support ⊆ K → T.mass ≤ Λ → T.boundary.mass < ∞ → ∃ Q ∈ 𝒬, ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q ∧ IsIntegerMultiplicity Q.boundary ∧ IsIntegerMultiplicity R ∧ T - Q - S = R.boundary ∧ (Q = 0 ∨ ENNReal.ofReal (ρ ^ (m + 1)) ≤ Q.mass) ∧ Q.mass ≤ c * T.mass ∧ Q.boundary.mass ≤ c * T.boundary.mass ∧ R.mass ≤ c * ENNReal.ofReal ρ * T.mass ∧ S.mass ≤ c * ENNReal.ofReal ρ * T.boundary.mass ∧ Q.support ∪ R.support ⊆ thickening (3 * Real.sqrt P * ρ) T.support ∧ Q.boundary.support ∪ S.support ⊆ thickening (3 * Real.sqrt P * ρ) T.boundary.support) → (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → ∀ (P d : ℕ), ∃ η₀ : ℝ, 0 < η₀ ∧ ∀ (C : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)), C.boundary = 0 → (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ W : Set (Euclid P), IsOpen W → C.massOn W = μ W) → AEStronglyMeasurable ξ μ → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (C).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B)) → ∀ᵐ x ∂μ, ENNReal.ofReal η₀ ≤ liminf (fun r : ℝ => μ (ball x r) / (unitBallVolume (d + 1) * ENNReal.ofReal (r ^ (d + 1)))) (𝓝[>] 0) := by
  intro _ hMR hSL hDT hVO P d
  -- `η₀` from the small fillings of sphere slices, with (ISO) from the isoperimetric filling
  obtain ⟨η₀, hη₀, hfill⟩ := Submission.cbrld_exists_small_filling_of_low_density hSL hMR
    (Submission.cbr_isoperimetric_filling hDT) P d
  refine ⟨η₀, hη₀, fun C μ ξ hCb hμK hμW hξ hξb hC hISP => ?_⟩
  -- the low-density set has small fillings at every scale, hence is `μ`-null
  rw [ae_iff]
  refine Submission.cbrld_measure_eq_zero_of_small_fillings hVO P d C μ ξ (1 / 2)
    (1 + 3 * Real.sqrt P) _ (by norm_num) (by norm_num) ?_ hμK hμW hξ hξb hC ?_
  · linarith [Real.sqrt_nonneg (P : ℝ)]
  · intro x hx δ hδ
    exact hfill C μ ξ hCb hμK hξ hξb hC hISP x (not_le.1 hx) δ hδ

/-- Cycles of finite mass with the integer slice property are integer multiplicity (B. White's
tangent-plane argument, used in place of Simon's rectifiability theorem 6.8.1 for the closure
theorem behind 7.2.4).  Since `∂Γ = 0`, the mass representation `(μ, ξ)` of `Γ` is absolutely
continuous with respect to `Hⁿ`, and the slice property bounds its lower density below
(`cbr_lower_density_of_slice_property`); hence `μ = θ Hⁿ⌞M` and `Γ = ∫_M θ ⟨·, ζ⟩ dHⁿ` with
`|ζ| = 1` on `M`.  At `Hⁿ`-a.e. `a ∈ M` (upper density at most `1`, Lebesgue point of `θζ`) the
blow-ups of `Γ` converge to `θ(a)` times an oriented `n`-plane; this plane is the approximate
tangent plane of `M` at `a`, `ζ(a)` orients it and `θ(a)` is an integer.  Since `M` is then
countably `n`-rectifiable, `(M, θ, ζ)` is an integer multiplicity representation of `Γ`. -/
theorem Submission.cbr_cycle_isIntegerMultiplicity : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → (∀ (P m : ℕ), ∃ c : NNReal, 1 ≤ c ∧ ∀ (ρ : ℝ) (K : Set (Euclid P)) (Λ : NNReal), 0 < ρ → IsCompact K → ∃ 𝒬 : Set (GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 𝒬.Finite ∧ ∀ T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity T → T.support ⊆ K → T.mass ≤ Λ → T.boundary.mass < ∞ → ∃ Q ∈ 𝒬, ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q ∧ IsIntegerMultiplicity Q.boundary ∧ IsIntegerMultiplicity R ∧ T - Q - S = R.boundary ∧ (Q = 0 ∨ ENNReal.ofReal (ρ ^ (m + 1)) ≤ Q.mass) ∧ Q.mass ≤ c * T.mass ∧ Q.boundary.mass ≤ c * T.boundary.mass ∧ R.mass ≤ c * ENNReal.ofReal ρ * T.mass ∧ S.mass ≤ c * ENNReal.ofReal ρ * T.boundary.mass ∧ Q.support ∪ R.support ⊆ thickening (3 * Real.sqrt P * ρ) T.support ∧ Q.boundary.support ∪ S.support ⊆ thickening (3 * Real.sqrt P * ρ) T.boundary.support) → (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → ∀ d : ℕ, (∀ (P : ℕ) (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U d) (T : GeometricCurrentOn U d), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T) → ∀ (P : ℕ) (Γ : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), Γ.boundary = 0 → Γ.mass < ∞ → IsCompact Γ.support → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), Γ ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (Γ).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B)) → IsIntegerMultiplicity Γ := by
  intro hREP hMR hIMC hSL hDT hVO d hCL P Γ hΓb hΓm _hΓs hISP
  -- The mass representation `(μ, ξ)` of `Γ`: `μ` is finite and, as `∂Γ = 0`, `μ ≪ Hⁿ`.
  obtain ⟨μ, ξ, -, hμK, hμW, hξ, hξb, hΓξ, hμac⟩ := hREP P (d + 1) univ Γ isOpen_univ
    fun W _ _ => (Γ.massOn_mono (subset_univ W)).trans_lt hΓm
  have hμ : μ univ < ∞ := by
    rw [← hμW univ isOpen_univ]
    exact hΓm
  have hμac' : ∀ E : Set (Euclid P), μHE[d + 1] E = 0 → μ E = 0 := by
    refine hμac fun W _ _ => ?_
    change Γ.boundary.massOn W < ∞
    rw [hΓb]
    refine (sSup_le ?_).trans_lt ENNReal.zero_lt_top
    rintro r ⟨ω, -, rfl⟩
    simp
  -- The lower density of `μ` is at least `η₀` almost everywhere.
  obtain ⟨η₀, hη₀, hLD⟩ :=
    Submission.cbr_lower_density_of_slice_property hREP hMR hSL hDT hVO P d
  have hdens := hLD Γ μ ξ hΓb (fun K hK => hμK K hK (subset_univ K)) hμW hξ
    (ae_of_all _ fun x => hξb x) hΓξ hISP
  -- `μ = θ Hⁿ⌞M` and `Γ = ∫_M θ ⟨·, ζ⟩ dHⁿ`.
  obtain ⟨M, θ, ζ, hM, hMfin, hθ, hζ, hμM, hθpos, hζb, hζM, hΓM, hMdens⟩ :=
    Submission.cbr_ci_density_representation P (d + 1) Γ μ ξ η₀ hη₀ hμ hμW hξ hξb hΓξ hμac'
      hdens
  have hθint : ∫⁻ x in M, ENNReal.ofReal (θ x) ∂μHE[d + 1] < ∞ := by
    have h := hμ
    rwa [hμM, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ] at h
  -- At `Hⁿ`-a.e. `a ∈ M`, `M` has an approximate tangent plane oriented by `ζ(a)` and `θ(a)` is
  -- an integer; this makes `(M, θ, ζ)` an integer multiplicity representation of `Γ`.
  refine Submission.cbr_ci_isIntegerMultiplicity_of_ae_tangent
    Submission.cbr_rectifiable_of_approx_tangent P (d + 1) Γ M θ ζ hM hMfin hθ hζ hθpos hθint hΓM ?_
  filter_upwards [Submission.cbr_ci_ae_good_points P (d + 1) M θ ζ hM hMfin hθ hζ hθpos hθint hζb,
    ae_restrict_mem hM] with a ha haM
  exact Submission.cbr_ci_pointwise_tangent_integer hREP hMR hSL
