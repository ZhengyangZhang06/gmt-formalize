      _ = ∫⁻ x in RT.carrier, ENNReal.ofReal ‖G x‖ *
            W.indicator (fun x => (RT.mult x : ℝ≥0∞)) x ∂μHE[m + 1 + 1] := (hCF _ hg).2
      _ ≤ ∫⁻ x in RT.carrier, (L : ℝ≥0∞) *
            W.indicator (fun x => (RT.mult x : ℝ≥0∞)) x ∂μHE[m + 1 + 1] :=
