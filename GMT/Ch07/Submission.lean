    obtain ⟨ε₁, hε₁⟩ : ∃ ε₁ : ℝ,
        ε₁ = min (min 1 (εa / 2)) (min (min εb εc) (1 / (40 * m * (cN + 1)))) := ⟨_, rfl⟩
    have hden : 0 < 40 * (m : ℝ) * (cN + 1) :=
      mul_pos (mul_pos Nat.ofNat_pos (zero_lt_one.trans_le hmR)) hcN1
    have hε₁0 : 0 < ε₁ := (lt_min (lt_min one_pos (half_pos hεa))
