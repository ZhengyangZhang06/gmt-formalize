  rw [one_pow, div_one, ← hIeq, ← ENNReal.ofReal_mul hC₇.le] at h5A
  /- Steps 3–9: the core estimate. -/
  obtain ⟨S, hSn, hS⟩ := Submission.dorag_tesDecay_core n k hn U W R H κ ξ σ T' ι ι' f C₃ C₇ C₁₁ C₁₃
    C₁₄ C₁₅ C₁₆ C₁₇ CT CH ω θ' ε' δh D δ E₀ I hW hWU hH hHκ hMC
    (fun ξ' r S' => hTH U W R H κ ξ' r S' hW hWU hH hHκ hMC) hHA' hσ hBW
    (fun y hy t ht htσ => (hDBa y (hBz hy) t ht (htσ.trans hσρ)).trans_eq (h2ω _ (by positivity)))
    (by filter_upwards [hDBd] with x hx hxB using hx (hBz hxB)) hT'n hT'h
    (by rw [hIeq]; exact lintegral_mono_set (closedBall_subset_closedBall (by linarith only [hσ])))
    hιι' hιT hfL hfb h5A hωeq hC₃ hC₇ hC₁₁0 hCT hCH hω hC₁₃def hC₁₄def hC₁₅def hC₁₇def hC₁₆def hθ'
    hθ'4 hθ'C hε' hε'1 hε'C hD hD1 hD7 hD11 hD14 hD15 hD16a hD16b hδ hδD hI0 hE₀p hIE hκE hE₀le hκσE
  exact ⟨S, hSn, le_trans (max_le hS hsecond) hRHS⟩

/-- **Tilt-excess decay at all scales** (Simon Ch. 5, Remark 4.6 and the proof of Theorem 5.2,
(1)–(8), at a general scale `σ ∈ (0, δρ]` and for a general initial `n`-plane `T`).  Iterating the
one-step decay `E_*(θ₀r, S') ≤ θ₀E_*(r, S)` at the scales `θ₀ʲσ` from `S₀ = T` gives `n`-planes `Sⱼ`
with `E_*(θ₀ʲσ, Sⱼ) ≤ θ₀ʲE_*`.  With the density bounds `½ωₙtⁿ ≤ μ(B_t(ξ)) ≤ 2ωₙtⁿ` this gives
`|p_{Sⱼ₊₁} − p_{Sⱼ}|² ≤ aθ₀ʲ`, `a = 8E_*/(ωₙθ₀ⁿ)`, so the `Sⱼ` converge to an `n`-plane `S` with
`|p_S − p_{Sⱼ}|² ≤ 4aθ₀ʲ` (`j = 0` is the tilt bound), and comparing with `Sⱼ` for
`θ₀ʲ⁺¹σ < s ≤ θ₀ʲσ` gives `∫_{B_s(ξ)} |p_x − p_S|² dμ ≤ C(s/σ)sⁿE_*`. -/
theorem Submission.dorag_tilt_excess_decay : ∀ (n k : ℕ), 0 < n → ∃ δ₂ C : ℝ, 0 < δ₂ ∧ δ₂ ≤ 1 / 8 ∧ 0 < C ∧ ∀ δ : ℝ, 0 < δ → δ ≤ δ₂ → ∀ (U W : Set (Euclid (n + k))) (R : IMRep U n) (H : Euclid (n + k) → Euclid (n + k)) (κ ρ : ℝ) (z : Euclid (n + k)), IsOpen W → W ⊆ U → 0 < ρ → closedBall z ρ ⊆ W → AEStronglyMeasurable H R.measure → (∀ x, ‖H x‖ ≤ κ) → (∀ X : Euclid (n + k) → Euclid (n + k), ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ W → R.firstVariation X = -∫ x, inner ℝ (X x) (H x) ∂R.measure) → z ∈ R.measure.support → R.measure (closedBall z ρ) ≤ ENNReal.ofReal (1 + δ) * unitBallVolume n * ENNReal.ofReal (ρ ^ n) → κ * ρ ≤ δ → ∀ ξ ∈ R.measure.support ∩ closedBall z (δ * ρ), ∀ (σ : ℝ) (T : Submodule ℝ (Euclid (n + k))), 0 < σ → σ ≤ δ * ρ → Module.finrank ℝ T = n → ∃ S : Submodule ℝ (Euclid (n + k)), Module.finrank ℝ S = n ∧ (∀ s : ℝ, 0 < s → s ≤ σ → ∫⁻ x in closedBall ξ s, ENNReal.ofReal (∑ i : Fin (n + k), ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) - S.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure ≤ ENNReal.ofReal (C * (s / σ) * s ^ n) * max (ENNReal.ofReal (1 / σ ^ n) * ∫⁻ x in closedBall ξ σ, ENNReal.ofReal (∑ i : Fin (n + k), ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) - T.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure) (ENNReal.ofReal (κ ^ 2 * σ ^ 2 / δ))) ∧ ENNReal.ofReal (∑ i : Fin (n + k), ‖S.starProjection (EuclideanSpace.single i (1 : ℝ)) - T.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ≤ ENNReal.ofReal C * max (ENNReal.ofReal (1 / σ ^ n) * ∫⁻ x in closedBall ξ σ, ENNReal.ofReal (∑ i : Fin (n + k), ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) - T.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure) (ENNReal.ofReal (κ ^ 2 * σ ^ 2 / δ)) := by
  intro n k hn
  -- Step 0: `θ₀ ∈ (0, 1/4]` and `δₛ` from the one-step decay, `δ₁` from the density bounds,
  -- `ω = ωₙ ∈ (0, ∞)`, `δ₂ = min δₛ δ₁`, and `C = 4C₁₀θ₀⁻ⁿ + (2 + 16ωC₁₀)θ₀⁻ⁿ⁻¹` with
  -- `C₁₀ = 8/ω`, i.e. `C = 32/(ωθ₀ⁿ) + 130/θ₀ⁿ⁺¹`.
  obtain ⟨θ₀, δs, hθ₀, hθ₀le, hδs, hδsle, hstep⟩ :=
    Submission.dorag_tilt_excess_one_step_decay n k hn
  obtain ⟨δ₁, C₂, hδ₁, hδ₁le, -, hdens⟩ := Submission.dorag_standing_density_bounds n k hn
  obtain ⟨ω, hω_pos, hω⟩ : ∃ ω : ℝ, 0 < ω ∧ unitBallVolume n = ENNReal.ofReal ω := by
    have h0 : unitBallVolume n ≠ 0 := (measure_ball_pos volume (0 : Euclid n) one_pos).ne'
    have htop : unitBallVolume n ≠ ⊤ :=
      (measure_ball_lt_top (μ := (volume : Measure (Euclid n))) (x := 0) (r := 1)).ne
    exact ⟨(unitBallVolume n).toReal, ENNReal.toReal_pos h0 htop,
      (ENNReal.ofReal_toReal htop).symm⟩
  have hθ₀1 : θ₀ < 1 := by linarith
  obtain ⟨C, hC⟩ : ∃ C : ℝ, C = 32 / (ω * θ₀ ^ n) + 130 / θ₀ ^ (n + 1) := ⟨_, rfl⟩
  have hC1 : 32 / (ω * θ₀ ^ n) ≤ C := by rw [hC]; exact le_add_of_nonneg_right (by positivity)
  have hC2 : 130 / θ₀ ^ (n + 1) ≤ C := by rw [hC]; exact le_add_of_nonneg_left (by positivity)
  have hCpos : 0 < C := by rw [hC]; positivity
  refine ⟨min δs δ₁, C, lt_min hδs hδ₁, (min_le_left _ _).trans hδsle, hCpos, ?_⟩
  intro δ hδ hδ₂ U W R H κ ρ z hW hWU hρ hball hHm hHκ hfv hz hmass hκρ ξ hξ σ T hσ hσle hT
  have hδs' : δ ≤ δs := hδ₂.trans (min_le_left _ _)
  have hδ₁' : δ ≤ δ₁ := hδ₂.trans (min_le_right _ _)
  -- Abbreviations: `I r S = ∫_{B_r(ξ)} |p_x − p_S|² dμ`, `E r S = E_*(ξ, r, S)` and
  -- `d S S' = |p_S − p_{S'}|²`.
  obtain ⟨I, hI⟩ : ∃ I : ℝ → Submodule ℝ (Euclid (n + k)) → ℝ≥0∞, ∀ r S, I r S =
      ∫⁻ x in closedBall ξ r, ENNReal.ofReal (∑ i : Fin (n + k),
        ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) -
          S.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure :=
    ⟨_, fun _ _ => rfl⟩
  obtain ⟨E, hE⟩ : ∃ E : ℝ → Submodule ℝ (Euclid (n + k)) → ℝ≥0∞, ∀ r S,
      E r S = max (ENNReal.ofReal (1 / r ^ n) * I r S) (ENNReal.ofReal (κ ^ 2 * r ^ 2 / δ)) :=
    ⟨_, fun _ _ => rfl⟩
  obtain ⟨d, hd⟩ : ∃ d : Submodule ℝ (Euclid (n + k)) → Submodule ℝ (Euclid (n + k)) → ℝ,
      ∀ S S', d S S' = ∑ i : Fin (n + k), ‖S.starProjection (EuclideanSpace.single i (1 : ℝ)) -
        S'.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2 :=
    ⟨_, fun _ _ => rfl⟩
  suffices key : ∃ S : Submodule ℝ (Euclid (n + k)), Module.finrank ℝ S = n ∧
      (∀ s : ℝ, 0 < s → s ≤ σ → I s S ≤ ENNReal.ofReal (C * (s / σ) * s ^ n) * E σ T) ∧
      ENNReal.ofReal (d S T) ≤ ENNReal.ofReal C * E σ T by
    simpa only [hE, hI, hd] using key
  -- Step 1: the density bounds `½ωtⁿ ≤ μ(B_t(ξ)) ≤ 2ωtⁿ` for `0 < t ≤ δρ`.
  obtain ⟨hDa, hDb, -, -⟩ :=
    hdens δ hδ hδ₁' U W R H κ ρ z hW hWU hρ hball hHm hHκ hfv hz hmass hκρ
  have hδρ : 0 < δ * ρ := mul_pos hδ hρ
  have hξ4 : ξ ∈ closedBall z (4 * δ * ρ) := closedBall_subset_closedBall (by linarith) hξ.2
  have ht4 : ∀ t : ℝ, t ≤ δ * ρ → t ≤ (1 - 4 * δ) * ρ := fun t ht =>
    ht.trans (by nlinarith [mul_le_mul_of_nonneg_right (hδ₁'.trans hδ₁le) hρ.le])
  have hDup : ∀ t : ℝ, 0 < t → t ≤ δ * ρ →
      R.measure (closedBall ξ t) ≤ 2 * ENNReal.ofReal ω * ENNReal.ofReal (t ^ n) := by
    intro t ht htle
    rw [← hω]
    exact hDa ξ hξ4 t ht (ht4 t htle)
  have hDlo : ∀ t : ℝ, 0 < t → t ≤ δ * ρ →
      ENNReal.ofReal ω * ENNReal.ofReal (t ^ n) ≤ 2 * R.measure (closedBall ξ t) := by
    intro t ht htle
    rw [← hω]
    exact hDb ξ ⟨hξ.1, hξ4⟩ t ht (ht4 t htle)
  -- (P4): the integrated Hilbert–Schmidt triangle inequalities on the balls `B_r(ξ)`.
  have hcmp : ∀ (A B : Submodule ℝ (Euclid (n + k))) (r : ℝ),
      ENNReal.ofReal (d A B) * R.measure (closedBall ξ r) ≤ 2 * I r A + 2 * I r B ∧
        I r A ≤ 2 * I r B + 2 * ENNReal.ofReal (d A B) * R.measure (closedBall ξ r) := by
    intro A B r
    simp only [hI, hd]
    exact Submission.dorag_ted_hs_integral_compare (n + k) R.measure
      (fun x => (approxTangentPlane n R.carrier x).starProjection) A.starProjection
      B.starProjection (closedBall ξ r)
      (Submission.dorag_approxTangent_starProjection_aesm (n + k) n U R)
  have hImono : ∀ (S : Submodule ℝ (Euclid (n + k))) (r r' : ℝ), r ≤ r' → I r S ≤ I r' S := by
    intro S r r' hrr'
    rw [hI, hI]
    exact lintegral_mono_set (closedBall_subset_closedBall hrr')
  have hIE : ∀ (S : Submodule ℝ (Euclid (n + k))) (r : ℝ), 0 < r →
      I r S ≤ ENNReal.ofReal (r ^ n) * E r S := by
    intro S r hr
    have hrn : 0 < r ^ n := pow_pos hr n
    calc I r S = ENNReal.ofReal (r ^ n) * (ENNReal.ofReal (1 / r ^ n) * I r S) := by
          rw [← mul_assoc, ← ENNReal.ofReal_mul hrn.le, mul_one_div_cancel hrn.ne',
            ENNReal.ofReal_one, one_mul]
      _ ≤ ENNReal.ofReal (r ^ n) * E r S := by
          rw [hE]
          exact mul_le_mul_of_nonneg_left (le_max_left _ _) zero_le
  -- Step 3: iterate the one-step decay at the scales `θ₀ʲσ`, starting from `S₀ = T`.
  have hstep' : ∀ (r : ℝ) (S : Submodule ℝ (Euclid (n + k))), 0 < r → r ≤ δ * ρ →
      Module.finrank ℝ S = n → ∃ S' : Submodule ℝ (Euclid (n + k)),
        Module.finrank ℝ S' = n ∧ E (θ₀ * r) S' ≤ ENNReal.ofReal θ₀ * E r S := by
    intro r S hr hrle hS
    obtain ⟨S', hS', hdec⟩ := hstep δ hδ hδs' U W R H κ ρ z hW hWU hρ hball hHm hHκ hfv hz
      hmass hκρ ξ hξ r S hr hrle hS
    refine ⟨S', hS', ?_⟩
    simp only [hE, hI]
    exact hdec
  choose! next hnext_rank hnext_dec using hstep'
  obtain ⟨Sq, hSq0, hSqs⟩ : ∃ Sq : ℕ → Submodule ℝ (Euclid (n + k)),
      Sq 0 = T ∧ ∀ j, Sq (j + 1) = next (θ₀ ^ j * σ) (Sq j) :=
    ⟨fun j => Nat.rec (motive := fun _ => Submodule ℝ (Euclid (n + k))) T
      (fun j Sj => next (θ₀ ^ j * σ) Sj) j, rfl, fun _ => rfl⟩
  have hscale : ∀ j : ℕ, 0 < θ₀ ^ j * σ ∧ θ₀ ^ j * σ ≤ δ * ρ := fun j =>
    ⟨by positivity, (mul_le_of_le_one_left hσ.le (pow_le_one₀ hθ₀.le hθ₀1.le)).trans hσle⟩
  have hiter : ∀ j : ℕ, Module.finrank ℝ (Sq j) = n ∧
      E (θ₀ ^ j * σ) (Sq j) ≤ ENNReal.ofReal (θ₀ ^ j) * E σ T := by
    intro j
    induction j with
    | zero =>
      rw [hSq0]
      refine ⟨hT, le_of_eq ?_⟩
      rw [pow_zero, one_mul, ENNReal.ofReal_one, one_mul]
    | succ j ih =>
      rw [hSqs]
      refine ⟨hnext_rank _ _ (hscale j).1 (hscale j).2 ih.1, ?_⟩
      have h := hnext_dec _ _ (hscale j).1 (hscale j).2 ih.1
      rw [show θ₀ * (θ₀ ^ j * σ) = θ₀ ^ (j + 1) * σ by ring] at h
      calc E (θ₀ ^ (j + 1) * σ) (next (θ₀ ^ j * σ) (Sq j))
          ≤ ENNReal.ofReal θ₀ * E (θ₀ ^ j * σ) (Sq j) := h
        _ ≤ ENNReal.ofReal θ₀ * (ENNReal.ofReal (θ₀ ^ j) * E σ T) :=
          mul_le_mul_of_nonneg_left ih.2 zero_le
        _ = ENNReal.ofReal (θ₀ ^ (j + 1)) * E σ T := by
          rw [← mul_assoc, ← ENNReal.ofReal_mul hθ₀.le, pow_succ, mul_comm θ₀]
  -- If `E_* = ∞` there is nothing to prove: take `S = T`.
  by_cases hfin : E σ T = ⊤
  · refine ⟨T, hT, fun s hs _ => ?_, ?_⟩
    · rw [hfin, ENNReal.mul_top (ENNReal.ofReal_pos.2 (by positivity)).ne']
      exact le_top
    · rw [hfin, ENNReal.mul_top (ENNReal.ofReal_pos.2 hCpos).ne']
      exact le_top
  obtain ⟨E₀, hE₀, hE₀eq⟩ : ∃ E₀ : ℝ, 0 ≤ E₀ ∧ E σ T = ENNReal.ofReal E₀ :=
    ⟨(E σ T).toReal, ENNReal.toReal_nonneg, (ENNReal.ofReal_toReal hfin).symm⟩
  -- `∫_{B_r(ξ)} |p_x − p_{Sⱼ}|² ≤ (θ₀ʲσ)ⁿθ₀ʲE_*` for `r ≤ θ₀ʲσ` (Step 3).
  have hIq : ∀ (j : ℕ) (r : ℝ), r ≤ θ₀ ^ j * σ →
      I r (Sq j) ≤ ENNReal.ofReal ((θ₀ ^ j * σ) ^ n * (θ₀ ^ j * E₀)) := by
    intro j r hr
    calc I r (Sq j) ≤ I (θ₀ ^ j * σ) (Sq j) := hImono _ _ _ hr
      _ ≤ ENNReal.ofReal ((θ₀ ^ j * σ) ^ n) * E (θ₀ ^ j * σ) (Sq j) := hIE _ _ (hscale j).1
      _ ≤ ENNReal.ofReal ((θ₀ ^ j * σ) ^ n) * (ENNReal.ofReal (θ₀ ^ j) * E σ T) :=
          mul_le_mul_of_nonneg_left (hiter j).2 zero_le
      _ = ENNReal.ofReal ((θ₀ ^ j * σ) ^ n * (θ₀ ^ j * E₀)) := by
          rw [hE₀eq, ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity)]
  have hcmb : ∀ a b : ℝ, 0 ≤ a → 0 ≤ b →
      2 * (2 * ENNReal.ofReal a + 2 * ENNReal.ofReal b) =
        ENNReal.ofReal (2 * (2 * a + 2 * b)) := by
    intro a b ha hb
    rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_add (by positivity) (by positivity),
      ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity),
      ENNReal.ofReal_ofNat]
  have hcmb' : ∀ a b w v : ℝ, 0 ≤ a → 0 ≤ b → 0 ≤ w → 0 ≤ v →
      2 * ENNReal.ofReal a + 2 * ENNReal.ofReal b * (2 * ENNReal.ofReal w * ENNReal.ofReal v) =
        ENNReal.ofReal (2 * a + 2 * b * (2 * w * v)) := by
    intro a b w v ha hb hw hv
    rw [ENNReal.ofReal_add (by positivity) (by positivity), ENNReal.ofReal_mul (by positivity),
      ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity),
      ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity),
      ENNReal.ofReal_ofNat]
  -- Step 2 (one-step tilt bound): `|p_{Sⱼ₊₁} − p_{Sⱼ}|² ≤ aθ₀ʲ` with `a = C₁₀θ₀⁻ⁿE_*`.
  have hB : ∀ j : ℕ, d (Sq (j + 1)) (Sq j) ≤ 8 * E₀ / (ω * θ₀ ^ n) * θ₀ ^ j := by
    intro j
    obtain ⟨hrpos, hrle⟩ := hscale (j + 1)
    have hrr' : θ₀ ^ (j + 1) * σ ≤ θ₀ ^ j * σ := by
      rw [pow_succ]
      exact mul_le_mul_of_nonneg_right
        (mul_le_of_le_one_right (pow_nonneg hθ₀.le j) hθ₀1.le) hσ.le
    have hdnn : 0 ≤ d (Sq (j + 1)) (Sq j) := by rw [hd]; positivity
    have key : ENNReal.ofReal (d (Sq (j + 1)) (Sq j) * (ω * (θ₀ ^ (j + 1) * σ) ^ n)) ≤
        ENNReal.ofReal (2 * (2 * ((θ₀ ^ (j + 1) * σ) ^ n * (θ₀ ^ (j + 1) * E₀)) +
          2 * ((θ₀ ^ j * σ) ^ n * (θ₀ ^ j * E₀)))) :=
      calc ENNReal.ofReal (d (Sq (j + 1)) (Sq j) * (ω * (θ₀ ^ (j + 1) * σ) ^ n))
          = ENNReal.ofReal (d (Sq (j + 1)) (Sq j)) *
              (ENNReal.ofReal ω * ENNReal.ofReal ((θ₀ ^ (j + 1) * σ) ^ n)) := by
            rw [ENNReal.ofReal_mul hdnn, ENNReal.ofReal_mul hω_pos.le]
        _ ≤ ENNReal.ofReal (d (Sq (j + 1)) (Sq j)) *
              (2 * R.measure (closedBall ξ (θ₀ ^ (j + 1) * σ))) :=
            mul_le_mul_of_nonneg_left (hDlo _ hrpos hrle) zero_le
        _ = 2 * (ENNReal.ofReal (d (Sq (j + 1)) (Sq j)) *
              R.measure (closedBall ξ (θ₀ ^ (j + 1) * σ))) := by ring
        _ ≤ 2 * (2 * I (θ₀ ^ (j + 1) * σ) (Sq (j + 1)) + 2 * I (θ₀ ^ (j + 1) * σ) (Sq j)) :=
            mul_le_mul_of_nonneg_left (hcmp _ _ _).1 zero_le
        _ ≤ 2 * (2 * ENNReal.ofReal ((θ₀ ^ (j + 1) * σ) ^ n * (θ₀ ^ (j + 1) * E₀)) +
              2 * ENNReal.ofReal ((θ₀ ^ j * σ) ^ n * (θ₀ ^ j * E₀))) := by
            have h1 := hIq (j + 1) _ le_rfl
            have h2 := hIq j _ hrr'
            gcongr
        _ = ENNReal.ofReal (2 * (2 * ((θ₀ ^ (j + 1) * σ) ^ n * (θ₀ ^ (j + 1) * E₀)) +
              2 * ((θ₀ ^ j * σ) ^ n * (θ₀ ^ j * E₀)))) :=
            hcmb _ _ (by positivity) (by positivity)
    rw [ENNReal.ofReal_le_ofReal_iff (by positivity)] at key
    -- Divide by `ω(θ₀ʲ⁺¹σ)ⁿ = ωθ₀ⁿ(θ₀ʲσ)ⁿ`, using `θ₀ⁿ⁺¹ ≤ 1`.
    have hu : 0 < (θ₀ ^ j * σ) ^ n := pow_pos (hscale j).1 n
    have e1 : (θ₀ ^ (j + 1) * σ) ^ n = θ₀ ^ n * (θ₀ ^ j * σ) ^ n := by
      rw [pow_succ, mul_comm (θ₀ ^ j) θ₀, mul_assoc, mul_pow]
    have hY : θ₀ ^ n * θ₀ ≤ 1 :=
      (mul_le_of_le_one_left hθ₀.le (pow_le_one₀ hθ₀.le hθ₀1.le)).trans hθ₀1.le
    have h3 : d (Sq (j + 1)) (Sq j) * (ω * θ₀ ^ n) * (θ₀ ^ j * σ) ^ n ≤
        8 * E₀ * θ₀ ^ j * (θ₀ ^ j * σ) ^ n :=
      calc d (Sq (j + 1)) (Sq j) * (ω * θ₀ ^ n) * (θ₀ ^ j * σ) ^ n
          = d (Sq (j + 1)) (Sq j) * (ω * (θ₀ ^ (j + 1) * σ) ^ n) := by rw [e1]; ring
        _ ≤ 2 * (2 * ((θ₀ ^ (j + 1) * σ) ^ n * (θ₀ ^ (j + 1) * E₀)) +
              2 * ((θ₀ ^ j * σ) ^ n * (θ₀ ^ j * E₀))) := key
        _ = 4 * (θ₀ ^ n * θ₀) * ((θ₀ ^ j * σ) ^ n * θ₀ ^ j * E₀) +
              4 * ((θ₀ ^ j * σ) ^ n * θ₀ ^ j * E₀) := by rw [e1, pow_succ]; ring
        _ ≤ 4 * 1 * ((θ₀ ^ j * σ) ^ n * θ₀ ^ j * E₀) + 4 * ((θ₀ ^ j * σ) ^ n * θ₀ ^ j * E₀) :=
            add_le_add (mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_left hY (by norm_num : (0 : ℝ) ≤ 4)) (by positivity)) le_rfl
        _ = 8 * E₀ * θ₀ ^ j * (θ₀ ^ j * σ) ^ n := by ring
    rw [div_mul_eq_mul_div, le_div_iff₀ (by positivity)]
    exact le_of_mul_le_mul_right h3 hu
  -- Step 4: the limit plane `S`, with `|p_S − p_{Sⱼ}|² ≤ 4aθ₀ʲ`.
  obtain ⟨S', hS'rank, hS'd⟩ := Submission.dorag_ted_planes_limit (n + k) n Sq
    (8 * E₀ / (ω * θ₀ ^ n)) θ₀ (fun j => (hiter j).1) hθ₀.le hθ₀le
    (fun j => by have h := hB j; rwa [hd] at h)
  have hS'd' : ∀ j, d S' (Sq j) ≤ 4 * (8 * E₀ / (ω * θ₀ ^ n)) * θ₀ ^ j := fun j => by
    rw [hd]; exact hS'd j
  refine ⟨S', hS'rank, fun s hs hsσ => ?_, ?_⟩
  · -- Step 5: interpolation between the scales `θ₀ʲ⁺¹σ < s ≤ θ₀ʲσ`.
    obtain ⟨j, hj1, hj2⟩ :=
      exists_nat_pow_near_of_lt_one (div_pos hs hσ) ((div_le_one hσ).2 hsσ) hθ₀ hθ₀1
    have hsj : s ≤ θ₀ ^ j * σ := by rwa [div_le_iff₀ hσ] at hj2
    have hjσ : θ₀ ^ j * σ ≤ s / θ₀ := by
      rw [le_div_iff₀ hθ₀]
      calc θ₀ ^ j * σ * θ₀ = θ₀ ^ (j + 1) * σ := by ring
        _ ≤ s := ((lt_div_iff₀ hσ).1 hj1).le
    have hpow : (θ₀ ^ j * σ) ^ n ≤ s ^ n / θ₀ ^ n := by
      rw [← div_pow]
      exact pow_le_pow_left₀ (hscale j).1.le hjσ n
    have ht : θ₀ ^ j ≤ s / σ / θ₀ := by
      rw [le_div_iff₀ hθ₀, ← pow_succ]
      exact hj1.le
    have hω0 : ω ≠ 0 := hω_pos.ne'
    have hθn : θ₀ ^ n ≠ 0 := (pow_pos hθ₀ n).ne'
    calc I s S' ≤ 2 * I s (Sq j) + 2 * ENNReal.ofReal (d S' (Sq j)) *
          R.measure (closedBall ξ s) := (hcmp _ _ _).2
      _ ≤ 2 * ENNReal.ofReal ((θ₀ ^ j * σ) ^ n * (θ₀ ^ j * E₀)) +
          2 * ENNReal.ofReal (4 * (8 * E₀ / (ω * θ₀ ^ n)) * θ₀ ^ j) *
            (2 * ENNReal.ofReal ω * ENNReal.ofReal (s ^ n)) := by
          have h1 := hIq j s hsj
          have h2 : ENNReal.ofReal (d S' (Sq j)) ≤
              ENNReal.ofReal (4 * (8 * E₀ / (ω * θ₀ ^ n)) * θ₀ ^ j) :=
            ENNReal.ofReal_le_ofReal (hS'd' j)
          have h3 := hDup s hs (hsσ.trans hσle)
          gcongr
      _ = ENNReal.ofReal (2 * ((θ₀ ^ j * σ) ^ n * (θ₀ ^ j * E₀)) +
          2 * (4 * (8 * E₀ / (ω * θ₀ ^ n)) * θ₀ ^ j) * (2 * ω * s ^ n)) :=
          hcmb' _ _ _ _ (by positivity) (by positivity) hω_pos.le (by positivity)
      _ ≤ ENNReal.ofReal (C * (s / σ) * s ^ n * E₀) := by
          refine ENNReal.ofReal_le_ofReal ?_
          calc 2 * ((θ₀ ^ j * σ) ^ n * (θ₀ ^ j * E₀)) +
                2 * (4 * (8 * E₀ / (ω * θ₀ ^ n)) * θ₀ ^ j) * (2 * ω * s ^ n)
              = 2 * ((θ₀ ^ j * σ) ^ n * (θ₀ ^ j * E₀)) +
                128 * (s ^ n / θ₀ ^ n) * (θ₀ ^ j * E₀) := by
                field_simp
                ring
            _ ≤ 2 * (s ^ n / θ₀ ^ n * (θ₀ ^ j * E₀)) + 128 * (s ^ n / θ₀ ^ n) * (θ₀ ^ j * E₀) := by
                gcongr
            _ = 130 * (s ^ n / θ₀ ^ n) * E₀ * θ₀ ^ j := by ring
            _ ≤ 130 * (s ^ n / θ₀ ^ n) * E₀ * (s / σ / θ₀) := by gcongr
            _ = 130 / θ₀ ^ (n + 1) * (s / σ) * s ^ n * E₀ := by ring
            _ ≤ C * (s / σ) * s ^ n * E₀ := by gcongr
      _ = ENNReal.ofReal (C * (s / σ) * s ^ n) * E σ T := by
          rw [hE₀eq, ENNReal.ofReal_mul (by positivity)]
  · -- Step 4 with `j = 0` (`S₀ = T`): `|p_S − p_T|² ≤ 4a = 4C₁₀θ₀⁻ⁿE_* ≤ CE_*`.
    have h0 := hS'd' 0
    rw [hSq0, pow_zero, mul_one] at h0
    rw [hE₀eq, ← ENNReal.ofReal_mul hCpos.le]
    refine ENNReal.ofReal_le_ofReal (h0.trans ?_)
    calc 4 * (8 * E₀ / (ω * θ₀ ^ n)) = 32 / (ω * θ₀ ^ n) * E₀ := by ring
      _ ≤ C * E₀ := mul_le_mul_of_nonneg_right hC1 hE₀

/-- **A Lipschitz graph with `s^{n+1}` tilt-excess decay is `C¹`** (Simon Ch. 5, proof of
Theorem 5.2, (9)–(11) and the final paragraph).  Let `Φ(v) = z + ιv + ι'f(v)`; for `s > 0`,
`ENNReal.ofReal (K s^{n+1}) = K⁺s^{n+1}` with `K⁺ = max{K, 0}`.  Monotonicity gives the lower
density bound `ωₙ ≤ e^{κt}t^{−n}μ(B_t(y))` (drop the nonnegative integral), and
`Hⁿ((spt μ ∩ W) \ M) = 0`.  By Rademacher's theorem and the tangent planes of Lipschitz graphs,
for a.e. `v` we have `T_{Φ(v)}M = graph Df(v)`, and at Lebesgue points of `x ↦ p_x` the plane `S`
of the decay hypothesis at `Φ(v)` must be `graph Df(v)`.  As `|A₁ − A₂|² ≤ 4|p_{A₁} − p_{A₂}|²` for
slopes `≤ 1/4`, the area formula turns the decay hypothesis into the Campanato bound
`∫_{B̆ⁿ_s(v)} |Df − Df(v)|² ≤ C s^{n+1}` for a.e. `v ∈ B̆ⁿ_{a/2}(0)` and `s ≤ s₁`.  By Campanato's
criterion `Df` agrees a.e. with a continuous `g`, and a Lipschitz map whose a.e. derivative is
continuous is `C¹` (mollification). -/
theorem Submission.dorag_graph_c1_of_tilt_decay : ∀ (n k : ℕ), 0 < n → ∀ (U W : Set (Euclid (n + k))) (R : IMRep U n) (H : Euclid (n + k) → Euclid (n + k)) (κ : ℝ) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (f : Euclid n → Euclid k) (z : Euclid (n + k)) (a s₀ K : ℝ), IsOpen W → W ⊆ U → AEStronglyMeasurable H R.measure → (∀ x, ‖H x‖ ≤ κ) → (∀ X : Euclid (n + k) → Euclid (n + k), ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ W → R.firstVariation X = -∫ x, inner ℝ (X x) (H x) ∂R.measure) → (∀ v w, inner ℝ (ι v) (ι' w) = 0) → (∀ v w, ‖f v - f w‖ ≤ 1 / 4 * ‖v - w‖) → f 0 = 0 → 0 < a → 0 < s₀ → closedBall z a ⊆ W → R.measure.support ∩ closedBall z a = range (fun v => z + ι v + ι' (f v)) ∩ closedBall z a → (∀ ξ ∈ R.measure.support ∩ closedBall z a, ∃ S : Submodule ℝ (Euclid (n + k)), Module.finrank ℝ S = n ∧ ∀ s : ℝ, 0 < s → s ≤ s₀ → ∫⁻ x in closedBall ξ s, ENNReal.ofReal (∑ i : Fin (n + k), ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) - S.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure ≤ ENNReal.ofReal (K * s ^ (n + 1))) → ContDiffOn ℝ 1 f (ball (0 : Euclid n) (a / 2)) := by
  intro n k hn U W R H κ ι ι' f z a s₀ K hW hWU hH hκ hMC horth hfL hf0 ha hs₀ hball hspt hdecay
  have hLip : LipschitzWith (1 / 4 : NNReal) f := by
    refine LipschitzWith.of_dist_le_mul fun v w => ?_
    simpa [dist_eq_norm] using hfL v w
  -- the prerequisites: `x ↦ p_x` is measurable, the lower density bound (monotonicity),
  -- `Hⁿ((spt μ ∩ W) \ M) = 0`, and the tangent planes along the graph of `f`
  have hP := Submission.dorag_approxTangent_starProjection_aesm (n + k) n U R
  have hdens : ∀ y ∈ R.measure.support, ∀ t : ℝ, 0 < t → closedBall y t ⊆ W →
      unitBallVolume n ≤ ENNReal.ofReal (Real.exp (κ * t) / t ^ n) * R.measure (closedBall y t) :=
    fun y hy t ht hyt => le_add_self.trans
      ((Submission.dorag_monotonicity_density n k hn U W R H κ hW hWU hH hκ hMC).2 y hy t ht hyt)
  have hnull := Submission.dorag_support_sdiff_carrier_null n k hn U W R H κ hW hWU hH hκ hMC
  have htan := Submission.dorag_lipschitz_graph_approxTangent n k hn U W R ι ι' z f (1 / 4) hW hWU
    horth hLip
  -- the Campanato bound for `Df` on `B̆ⁿ_{a/2}(0)` (Simon (11))
  obtain ⟨C, s₁, hC, hs₁, hcamp⟩ := Submission.dorag_gc_graph_slope_campanato n k U W R κ ι ι' f z
    a s₀ K hW hWU hP hdens hnull htan horth hfL hf0 ha hs₀ hball hspt hdecay
  -- Campanato's criterion: `Df = g` a.e. for a continuous `g`
  obtain ⟨g, hg, hfg⟩ := Submission.dorag_gc_campanato_continuous_deriv n k f (ball 0 (a / 2)) C s₁
    hn isOpen_ball hC hs₁ hcamp
  exact Submission.dorag_gc_contDiffOn_of_ae_hasFDerivAt n k f (1 / 4) (ball 0 (a / 2)) g hn hLip
    isOpen_ball hg hfg

/-- **Simon Ch. 5, Theorem 5.2 with Remark 5.3 (Allard regularity), bounded mean curvature
(`p = 2n` in 5.1).**  If `z ∈ spt μ`, `μ(B̄_ρ(z)) ≤ (1 + δ₀)ωₙρⁿ` and `κρ ≤ δ₀`, then
`spt μ ∩ B_{γρ}(z)` is the graph over `B_{γρ}(0)` of a `C¹` map `u` with `u(0) = 0` and
`‖Du‖ ≤ ε`.  Parts 8.1–8.9 of the proof: the base plane (`dorag_affine_approximation`),
tilt-excess decay at every point of `spt μ ∩ B_{δ₀ρ/2}(z)` (`dorag_tilt_excess_decay`), the
graph criterion (`dorag_lipschitz_approximation`) and `C¹` regularity
(`dorag_graph_c1_of_tilt_decay`), with `δ₀ = min{δ₁, δ₂, δ₃, δ₅, t^{2n+2}}` and `γ = δ₀/16`. -/
theorem Submission.dor_allard_bounded_curvature_graph : ∀ (n k : ℕ), 0 < n → ∀ ε : ℝ, 0 < ε → ∃ δ₀ γ : ℝ, 0 < δ₀ ∧ 0 < γ ∧ γ ≤ 1 ∧ ∀ (U W : Set (Euclid (n + k))) (R : IMRep U n) (H : Euclid (n + k) → Euclid (n + k)) (κ ρ : ℝ) (z : Euclid (n + k)), IsOpen W → W ⊆ U → 0 < ρ → closedBall z ρ ⊆ W → AEStronglyMeasurable H R.measure → (∀ x, ‖H x‖ ≤ κ) → (∀ X : Euclid (n + k) → Euclid (n + k), ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ W → R.firstVariation X = -∫ x, inner ℝ (X x) (H x) ∂R.measure) → z ∈ R.measure.support → R.measure (closedBall z ρ) ≤ ENNReal.ofReal (1 + δ₀) * unitBallVolume n * ENNReal.ofReal (ρ ^ n) → κ * ρ ≤ δ₀ → ∃ (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (u : Euclid n → Euclid k), (∀ v w, inner ℝ (ι v) (ι' w) = 0) ∧ u 0 = 0 ∧ ContDiffOn ℝ 1 u (ball 0 (γ * ρ)) ∧ (∀ v ∈ ball (0 : Euclid n) (γ * ρ), ‖fderiv ℝ u v‖ ≤ ε) ∧ R.measure.support ∩ ball z (γ * ρ) = ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) (γ * ρ)) ∩ ball z (γ * ρ) := by
  have h_db := Submission.dorag_standing_density_bounds
  have h_aa := Submission.dorag_affine_approximation
  have h_la := Submission.dorag_lipschitz_approximation
  have h_td := Submission.dorag_tilt_excess_decay
  have h_gc := Submission.dorag_graph_c1_of_tilt_decay
  intro n k hn ε hε
  -- Part 0: the constants of the children (Simon 5.2 with `p = 2n`)
  obtain ⟨δ₁, C₂, hδ₁, hδ₁8, -, hDB⟩ := h_db n k hn
  obtain ⟨δ₃, C₃, hδ₃, -, hC₃, hAA⟩ := h_aa n k hn
  obtain ⟨δ₅, β, β', C₇, hδ₅, -, hβ', hβ'β, -, -, hLA⟩ :=
    h_la n k hn (2 * C₃) (by linarith)
  obtain ⟨δ₂, C, hδ₂, -, hC, hTD⟩ := h_td n k hn
  have hC₃0 : 0 < C₃ := by linarith
  have hω_fin : unitBallVolume n ≠ ⊤ := measure_ball_lt_top.ne
  obtain ⟨ω, hω⟩ : ∃ ω : ℝ, ω = (unitBallVolume n).toReal := ⟨_, rfl⟩
  have hω0 : 0 ≤ ω := by rw [hω]; exact ENNReal.toReal_nonneg
  have hω_eq : ENNReal.ofReal ω = unitBallVolume n := by
    rw [hω, ENNReal.ofReal_toReal hω_fin]
  obtain ⟨L₀, hL₀⟩ : ∃ L₀ : ℝ, L₀ = min ε (1 / 4) := ⟨_, rfl⟩
  have hL₀0 : 0 < L₀ := by rw [hL₀]; exact lt_min hε (by norm_num)
  have hL₀ε : L₀ ≤ ε := by rw [hL₀]; exact min_le_left _ _
  have hL₀4 : L₀ ≤ 1 / 4 := by rw [hL₀]; exact min_le_right _ _
  obtain ⟨A, hA⟩ : ∃ A : ℝ, A = (2 * C + 4 * ω * C) * 2 ^ n * C₃ := ⟨_, rfl⟩
  have hA0 : 0 ≤ A := by rw [hA]; positivity
  obtain ⟨t, ht⟩ : ∃ t : ℝ, t = β' * L₀ / (A + 1) := ⟨_, rfl⟩
  have hA1 : A + 1 ≠ 0 := by positivity
  have ht0 : 0 < t := by rw [ht]; positivity
  have htA : (A + 1) * t = β' * L₀ := by rw [ht]; field_simp
  have htβ' : t ≤ β' * L₀ := by have := mul_nonneg hA0 ht0.le; linarith
  have htβ : t ≤ β * L₀ := htβ'.trans (by gcongr)
  have hAt : A * t ^ 2 ≤ β' ^ 2 * L₀ ^ 2 := by
    calc A * t ^ 2 ≤ (A + 1) * t ^ 2 := by have := sq_nonneg t; linarith
      _ = β' * L₀ * t := by rw [← htA]; ring
      _ ≤ β' * L₀ * (β' * L₀) := by gcongr
      _ = β' ^ 2 * L₀ ^ 2 := by ring
  obtain ⟨δ₀, hδ₀⟩ : ∃ δ₀ : ℝ,
      δ₀ = min δ₁ (min δ₂ (min δ₃ (min δ₅ (t ^ (2 * n + 2))))) := ⟨_, rfl⟩
  have hδ₀0 : 0 < δ₀ := by
    rw [hδ₀]; exact lt_min hδ₁ (lt_min hδ₂ (lt_min hδ₃ (lt_min hδ₅ (by positivity))))
  have hδ₀δ₁ : δ₀ ≤ δ₁ := by rw [hδ₀]; exact min_le_left _ _
  have hδ₀δ₂ : δ₀ ≤ δ₂ := by rw [hδ₀]; exact (min_le_right _ _).trans (min_le_left _ _)
  have hδ₀δ₃ : δ₀ ≤ δ₃ := by
    rw [hδ₀]; exact (min_le_right _ _).trans ((min_le_right _ _).trans (min_le_left _ _))
  have hδ₀δ₅ : δ₀ ≤ δ₅ := by
    rw [hδ₀]
    exact (min_le_right _ _).trans
      ((min_le_right _ _).trans ((min_le_right _ _).trans (min_le_left _ _)))
  have hδ₀t : δ₀ ≤ t ^ (2 * n + 2) := by
    rw [hδ₀]
    exact (min_le_right _ _).trans
      ((min_le_right _ _).trans ((min_le_right _ _).trans (min_le_right _ _)))
  have hδ₀8 : δ₀ ≤ 1 / 8 := hδ₀δ₁.trans hδ₁8
  have hδ₀1 : δ₀ ≤ 1 := by linarith
  -- `α = 1/(2n+2)` and `δ₀ ≤ δ₀ ^ α ≤ t`
  have hα0 : (0 : ℝ) < (1 : ℝ) / (2 * (n : ℝ) + 2) := by positivity
  have hα1 : (1 : ℝ) / (2 * (n : ℝ) + 2) ≤ 1 := by
    rw [div_le_one (by positivity)]; have : (0 : ℝ) ≤ n := Nat.cast_nonneg n; linarith
  have hd0 : 0 < δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2)) := Real.rpow_pos_of_pos hδ₀0 _
  have hδ₀d : δ₀ ≤ δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2)) :=
    Real.self_le_rpow_of_le_one hδ₀0.le hδ₀1 hα1
  have hdt : δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2)) ≤ t := by
    calc δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2))
        ≤ (t ^ (2 * n + 2)) ^ ((1 : ℝ) / (2 * (n : ℝ) + 2)) :=
          Real.rpow_le_rpow hδ₀0.le hδ₀t hα0.le
      _ = t := by
          rw [show (1 : ℝ) / (2 * (n : ℝ) + 2) = ((2 * n + 2 : ℕ) : ℝ)⁻¹ by push_cast; ring]
          exact Real.pow_rpow_inv_natCast ht0.le (by omega)
  -- `E₀ = 2ⁿC₃δ₀^{2α}` bounds every normalized tilt-excess `E_*` below (Simon 5.2, (1))
  obtain ⟨E₀, hE₀⟩ : ∃ E₀ : ℝ,
      E₀ = 2 ^ n * C₃ * (δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2))) ^ 2 := ⟨_, rfl⟩
  have hE₀0 : 0 ≤ E₀ := by rw [hE₀]; positivity
  have hdE₀ : (δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2))) ^ 2 ≤ E₀ := by
    rw [hE₀]
    have h2n : (1 : ℝ) ≤ 2 ^ n := one_le_pow₀ (by norm_num)
    exact le_mul_of_one_le_left (sq_nonneg _) (one_le_mul_of_one_le_of_one_le h2n hC₃)
  have hAE₀ : A * (δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2))) ^ 2 ≤ β' ^ 2 * L₀ ^ 2 :=
    (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hd0.le hdt 2) hA0).trans hAt
  refine ⟨δ₀, δ₀ / 16, hδ₀0, by positivity, by linarith, ?_⟩
  intro U W R H κ ρ z hW hWU hρ hzρ hH hHκ hMC hz hmass hκρ
  have hκ0 : 0 ≤ κ := (norm_nonneg _).trans (hHκ 0)
  obtain ⟨hDBa, -, -, -⟩ :=
    hDB δ₀ hδ₀0 hδ₀δ₁ U W R H κ ρ z hW hWU hρ hzρ hH hHκ hMC hz hmass hκρ
  have hδρ : 0 < δ₀ * ρ := mul_pos hδ₀0 hρ
  have hδρ8 : δ₀ * ρ ≤ ρ / 8 := by
    have := mul_le_mul_of_nonneg_right hδ₀8 hρ.le; linarith
  have hzmem : ∀ r : ℝ, 0 ≤ r → z ∈ R.measure.support ∩ closedBall z r := fun r hr =>
    ⟨hz, mem_closedBall_self hr⟩
  -- (8.1) the base plane `T₀`: affine approximation at `(z, 2δ₀ρ)`
  obtain ⟨T₀, hT₀n, hT₀a, hT₀b⟩ := hAA δ₀ hδ₀0 hδ₀δ₃ U W R H κ ρ z hW hWU hρ hzρ hH hHκ hMC
    hz hmass hκρ z (hzmem _ (by positivity)) (2 * δ₀ * ρ) (by positivity) le_rfl
  rw [show 2 * δ₀ * ρ / 2 = δ₀ * ρ by ring] at hT₀b
  -- (8.2–8.3) tilt-excess decay at every point of `spt μ ∩ B_{δ₀ρ/2}(z)`, with `E_* ≤ E₀`
  have hdecay : ∀ y ∈ R.measure.support ∩ closedBall z (δ₀ * ρ / 2),
      ∃ S : Submodule ℝ (Euclid (n + k)), Module.finrank ℝ S = n ∧
        (∀ s : ℝ, 0 < s → s ≤ δ₀ * ρ / 2 →
          ∫⁻ x in closedBall y s, ENNReal.ofReal (∑ i : Fin (n + k),
            ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) -
              S.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure ≤
            ENNReal.ofReal (C * (s / (δ₀ * ρ / 2)) * s ^ n * E₀)) ∧
        ENNReal.ofReal (∑ i : Fin (n + k),
          ‖S.starProjection (EuclideanSpace.single i (1 : ℝ)) -
            T₀.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ≤
          ENNReal.ofReal (C * E₀) := by
    intro y hy
    have hyz : dist y z ≤ δ₀ * ρ / 2 := mem_closedBall.1 hy.2
    obtain ⟨S, hSn, hS1, hS2⟩ := hTD δ₀ hδ₀0 hδ₀δ₂ U W R H κ ρ z hW hWU hρ hzρ hH hHκ hMC hz
      hmass hκρ y ⟨hy.1, closedBall_subset_closedBall (by linarith) hy.2⟩ (δ₀ * ρ / 2) T₀
      (by positivity) (by linarith) hT₀n
    have hE : max (ENNReal.ofReal (1 / (δ₀ * ρ / 2) ^ n) *
        ∫⁻ x in closedBall y (δ₀ * ρ / 2), ENNReal.ofReal (∑ i : Fin (n + k),
          ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) -
            T₀.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure)
        (ENNReal.ofReal (κ ^ 2 * (δ₀ * ρ / 2) ^ 2 / δ₀)) ≤ ENNReal.ofReal E₀ := by
      apply max_le
      · calc _ ≤ ENNReal.ofReal (1 / (δ₀ * ρ / 2) ^ n) * ENNReal.ofReal
              (C₃ * (δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2))) ^ 2 * (δ₀ * ρ) ^ n) := by
              gcongr
              exact (lintegral_mono_set (closedBall_subset_closedBall' (by linarith))).trans
                hT₀b
          _ = ENNReal.ofReal E₀ := by
              rw [← ENNReal.ofReal_mul (by positivity), hE₀]
              congr 1
              rw [div_pow, one_div_div, div_mul_eq_mul_div, div_eq_iff (by positivity)]
              ring
      · apply ENNReal.ofReal_le_ofReal
        rw [div_le_iff₀ hδ₀0]
        have hκσ : κ * (δ₀ * ρ / 2) ≤ δ₀ ^ 2 / 2 := by
          linarith [mul_le_mul_of_nonneg_right hκρ hδ₀0.le]
        calc κ ^ 2 * (δ₀ * ρ / 2) ^ 2 = (κ * (δ₀ * ρ / 2)) ^ 2 := by ring
          _ ≤ (δ₀ ^ 2 / 2) ^ 2 := pow_le_pow_left₀ (by positivity) hκσ 2
          _ ≤ δ₀ ^ 2 * δ₀ := by
              linarith [pow_pos hδ₀0 3, mul_le_mul_of_nonneg_left hδ₀1 (pow_pos hδ₀0 3).le]
          _ ≤ E₀ * δ₀ := by
              gcongr
              exact (pow_le_pow_left₀ hδ₀0.le hδ₀d 2).trans hdE₀
    refine ⟨S, hSn, fun s hs hsσ => ?_, ?_⟩
    · calc _ ≤ _ := hS1 s hs hsσ
        _ ≤ ENNReal.ofReal (C * (s / (δ₀ * ρ / 2)) * s ^ n) * ENNReal.ofReal E₀ := by gcongr
        _ = _ := (ENNReal.ofReal_mul (by positivity)).symm
    · calc _ ≤ _ := hS2
        _ ≤ ENNReal.ofReal C * ENNReal.ofReal E₀ := by gcongr
        _ = _ := (ENNReal.ofReal_mul hC.le).symm
  -- pointwise `|p_x − p_T|² ≤ 2|p_x − p_S|² + 2|p_S − p_T|²`
  have hsplit : ∀ P Q S : Submodule ℝ (Euclid (n + k)),
      ENNReal.ofReal (∑ i : Fin (n + k), ‖P.starProjection (EuclideanSpace.single i (1 : ℝ)) -
        Q.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ≤
      2 * ENNReal.ofReal (∑ i : Fin (n + k),
        ‖P.starProjection (EuclideanSpace.single i (1 : ℝ)) -
          S.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) +
      2 * ENNReal.ofReal (∑ i : Fin (n + k),
        ‖S.starProjection (EuclideanSpace.single i (1 : ℝ)) -
          Q.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) := by
    intro P Q S
    have key : ∀ a b c : Euclid (n + k),
        ‖a - c‖ ^ 2 ≤ 2 * ‖a - b‖ ^ 2 + 2 * ‖b - c‖ ^ 2 := by
      intro a b c
      have h1 := norm_sub_le_norm_sub_add_norm_sub a b c
      have h2 := pow_le_pow_left₀ (norm_nonneg _) h1 2
      linarith [sq_nonneg (‖a - b‖ - ‖b - c‖)]
    have hsum : ∑ i : Fin (n + k), ‖P.starProjection (EuclideanSpace.single i (1 : ℝ)) -
          Q.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2 ≤
        2 * ∑ i : Fin (n + k), ‖P.starProjection (EuclideanSpace.single i (1 : ℝ)) -
          S.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2 +
        2 * ∑ i : Fin (n + k), ‖S.starProjection (EuclideanSpace.single i (1 : ℝ)) -
          Q.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2 := by
      rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
      exact Finset.sum_le_sum fun i _ => key _ _ _
    have h := ENNReal.ofReal_le_ofReal hsum
    rw [ENNReal.ofReal_add (by positivity) (by positivity), ENNReal.ofReal_mul (by positivity),
      ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_ofNat] at h
    exact h
  -- (8.4) hypothesis of the graph criterion (Simon 5.2.7) for `T₀` on `B_{δ₀ρ/2}(z)`
  have h5Bhyp : ∀ y ∈ R.measure.support ∩ closedBall z (δ₀ * ρ / 2), ∀ t' : ℝ, 0 < t' →
      t' ≤ δ₀ * ρ / 2 →
      ∫⁻ x in closedBall y t', ENNReal.ofReal (∑ i : Fin (n + k),
        ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) -
          T₀.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure ≤
        ENNReal.ofReal (β' ^ 2 * L₀ ^ 2 * t' ^ n) := by
    intro y hy t' ht'0 ht'σ
    obtain ⟨S, -, hS1, hS2⟩ := hdecay y hy
    have hball : R.measure (closedBall y t') ≤ ENNReal.ofReal (2 * ω * t' ^ n) := by
      refine (hDBa y ?_ t' ht'0 (by linarith)).trans (le_of_eq ?_)
      · exact closedBall_subset_closedBall (by linarith) hy.2
      · rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by norm_num), hω_eq,
          ENNReal.ofReal_ofNat]
    refine (lintegral_mono fun x => hsplit (approxTangentPlane n R.carrier x) T₀ S).trans ?_
    rw [lintegral_add_right _ measurable_const, setLIntegral_const,
      lintegral_const_mul' _ _ (by simp)]
    refine (add_le_add (mul_le_mul_right (hS1 t' ht'0 ht'σ) 2)
      (mul_le_mul' (mul_le_mul_right hS2 2) hball)).trans ?_
    have hreal : 2 * (C * (t' / (δ₀ * ρ / 2)) * t' ^ n * E₀) +
        2 * (C * E₀) * (2 * ω * t' ^ n) ≤ β' ^ 2 * L₀ ^ 2 * t' ^ n := by
      have hq : t' / (δ₀ * ρ / 2) ≤ 1 := div_le_one_of_le₀ ht'σ (by positivity)
      have hX : 0 ≤ 2 * C * E₀ * t' ^ n := by positivity
      have hkey : A * (δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2))) ^ 2 * t' ^ n -
          (2 * (C * (t' / (δ₀ * ρ / 2)) * t' ^ n * E₀) + 2 * (C * E₀) * (2 * ω * t' ^ n)) =
          2 * C * E₀ * t' ^ n * (1 - t' / (δ₀ * ρ / 2)) := by
        rw [hA, hE₀]; ring
      have := mul_nonneg hX (sub_nonneg.2 hq)
      have := mul_le_mul_of_nonneg_right hAE₀ (pow_nonneg ht'0.le n)
      linarith
    have h := ENNReal.ofReal_le_ofReal hreal
    rw [ENNReal.ofReal_add (by positivity) (by positivity),
      ENNReal.ofReal_mul (p := 2) (q := C * (t' / (δ₀ * ρ / 2)) * t' ^ n * E₀) (by norm_num),
      ENNReal.ofReal_mul (p := 2 * (C * E₀)) (q := 2 * ω * t' ^ n) (by positivity),
      ENNReal.ofReal_mul (p := 2) (q := C * E₀) (by norm_num), ENNReal.ofReal_ofNat] at h
    exact h
  -- (8.4) Lipschitz approximation and graph criterion at `(z, δ₀ρ, T₀, L₀)`
  obtain ⟨ι, ι', f, hιι', -, hfL, -, -, h5B⟩ := hLA δ₀ hδ₀0 hδ₀δ₅ U W R H κ ρ z hW hWU hρ hzρ
    hH hHκ hMC hz hmass hκρ z (hzmem _ (by positivity)) (δ₀ * ρ) L₀ T₀ hδρ le_rfl hT₀n hL₀0
    (by linarith) (hdt.trans htβ)
    (hT₀b.trans (ENNReal.ofReal_le_ofReal (by gcongr; linarith)))
    (fun x hx => (hT₀a x ⟨hx.1, closedBall_subset_closedBall (by linarith) hx.2⟩).trans
      (le_of_eq (by ring)))
  have hgraph := h5B h5Bhyp
  -- `|v| ≤ |ιv + ι'w|`
  have hnorm : ∀ v w, ‖v‖ ≤ ‖ι v + ι' w‖ := by
    intro v w
    have h : ‖ι v + ι' w‖ ^ 2 = ‖v‖ ^ 2 + ‖w‖ ^ 2 := by
      rw [norm_add_sq_real, hιι', LinearIsometry.norm_map, LinearIsometry.norm_map]; ring
    refine (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).1 ?_
    rw [h]; linarith [sq_nonneg ‖w‖]
  -- `f(0) = 0`, since `z ∈ spt μ`
  have hf0 : f 0 = 0 := by
    have hzg : z ∈ range (fun v => z + ι v + ι' (f v)) ∩ closedBall z (δ₀ * ρ / 8) := by
      rw [← hgraph]; exact hzmem _ (by positivity)
    obtain ⟨v₀, hv₀⟩ := hzg.1
    have hsum : ι v₀ + ι' (f v₀) = 0 := by
      have h : z + (ι v₀ + ι' (f v₀)) = z + 0 := by rw [← add_assoc, add_zero]; exact hv₀
      exact add_left_cancel h
    have hv : v₀ = 0 := by
      have := hnorm v₀ (f v₀)
      rw [hsum, norm_zero] at this
      exact norm_le_zero_iff.1 this
    subst hv
    have h1 : ι' (f 0) = 0 := by simpa using hsum
    rw [← norm_eq_zero, ← LinearIsometry.norm_map ι' (f 0), h1, norm_zero]
  -- (8.5–8.8) `f` is `C¹` on `B_{δ₀ρ/16}(0)`
  have hC1 : ContDiffOn ℝ 1 f (ball (0 : Euclid n) (δ₀ * ρ / 8 / 2)) :=
    h_gc n k hn U W R H κ ι ι' f z (δ₀ * ρ / 8) (δ₀ * ρ / 2) (C * E₀ / (δ₀ * ρ / 2)) hW hWU
      hH hHκ hMC hιι' (fun v w => (hfL v w).trans (by gcongr)) hf0 (by positivity)
      (by positivity) ((closedBall_subset_closedBall (by linarith)).trans hzρ) hgraph
      (fun ξ hξ => by
        obtain ⟨S, hSn, hS1, -⟩ :=
          hdecay ξ ⟨hξ.1, closedBall_subset_closedBall (by linarith) hξ.2⟩
        exact ⟨S, hSn, fun s hs hsσ => (hS1 s hs hsσ).trans (le_of_eq (by congr 1; ring))⟩)
  -- (8.9, 9) conclusion with `u := f`
  have hlip : LipschitzWith (Real.toNNReal L₀) f := LipschitzWith.of_dist_le_mul fun v w => by
    rw [dist_eq_norm, dist_eq_norm, Real.coe_toNNReal _ hL₀0.le]; exact hfL v w
  have hball8 : ball z (δ₀ / 16 * ρ) ⊆ closedBall z (δ₀ * ρ / 8) :=
    ball_subset_closedBall.trans (closedBall_subset_closedBall (by linarith))
  refine ⟨ι, ι', f, hιι', hf0, ?_, fun v _ => ?_, ?_⟩
  · rw [show δ₀ / 16 * ρ = δ₀ * ρ / 8 / 2 by ring]; exact hC1
  · exact (norm_fderiv_le_of_lipschitz ℝ hlip).trans
      (by rw [Real.coe_toNNReal _ hL₀0.le]; exact hL₀ε)
  · ext x
    constructor
    · rintro ⟨hx, hxb⟩
      have hx' : x ∈ range (fun v => z + ι v + ι' (f v)) ∩ closedBall z (δ₀ * ρ / 8) := by
        rw [← hgraph]; exact ⟨hx, hball8 hxb⟩
      obtain ⟨⟨v, rfl⟩, -⟩ := hx'
      refine ⟨⟨v, ?_, rfl⟩, hxb⟩
      rw [mem_ball, dist_eq_norm] at hxb
      rw [mem_ball_zero_iff]
      calc ‖v‖ ≤ ‖ι v + ι' (f v)‖ := hnorm v (f v)
        _ = ‖z + ι v + ι' (f v) - z‖ := by congr 1; abel
        _ < _ := hxb
    · rintro ⟨⟨v, -, rfl⟩, hxb⟩
      have hx' : z + ι v + ι' (f v) ∈ R.measure.support ∩ closedBall z (δ₀ * ρ / 8) := by
        rw [hgraph]; exact ⟨⟨v, rfl⟩, hball8 hxb⟩
      exact ⟨hx'.1, hxb⟩

/-- The carrier of an integer multiplicity triple lies `Hⁿ`-a.e. in the support of its weight
measure (step 3 of the integer-density computation for graph cycles in the ε-regularity proof of
Simon 7.4.3): `Hⁿ(M ∖ spt μ) = 0` for `μ = θ Hⁿ⌞M`.  For Borel `S`, `θ ≥ 1` on `M` gives
`Hⁿ(S ∩ M) ≤ ∫_{S ∩ M} θ dHⁿ = μ(S)`; take `S = (spt μ)ᶜ`, which is open and `μ`-null since
`ℝᴾ` is second countable. -/
theorem Submission.dgid_carrier_sdiff_measure_support_null : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), μHE[n] (R.carrier \ R.measure.support) = 0 := by
  intro P n U R
  -- `θ ≥ 1` on `M`, so `Hⁿ(S ∩ M) ≤ ∫⁻_{S ∩ M} θ dHⁿ = μ(S)` for Borel `S`
  have key : ∀ S : Set (Euclid P), MeasurableSet S → μHE[n] (S ∩ R.carrier) ≤ R.measure S := by
    intro S hS
    rw [IMRep.measure, withDensity_apply _ hS, Measure.restrict_restrict hS, ← setLIntegral_one]
    refine setLIntegral_mono' (hS.inter R.measurableSet_carrier) fun x hx => ?_
    exact_mod_cast R.mult_pos x hx.2
  -- `(spt μ)ᶜ` is open, hence Borel, and `μ`-null (`ℝᴾ` is hereditarily Lindelöf)
  have hS : MeasurableSet R.measure.supportᶜ :=
    R.measure.isClosed_support.isOpen_compl.measurableSet
  have h0 : R.measure R.measure.supportᶜ = 0 := Measure.measure_compl_support
  have hset : R.carrier \ R.measure.support = R.measure.supportᶜ ∩ R.carrier := by
    ext x; simp [and_comm]
  rw [hset]
  exact nonpos_iff_eq_zero.mp ((key _ hS).trans h0.le)
/-- An integer multiplicity triple `R = (M, θ, ξ_R)` oriented by `±ξ` on `S` is represented on `W`
by an integer density times `ξ` on `S` (a step of the graph argument for Simon 7.4.3): if `S` is
Borel, `Hⁿ((M ∩ W) \ S) = 0`, `ξ(x)(β(x)) = 1` on `S` and `ξ_R = ±ξ` `Hⁿ`-a.e. on `M ∩ S`, then
`g = 1_M θ ξ_R(β)` is integer-valued with `|g| ≤ 1_M θ` `Hⁿ⌞S`-a.e., and
`τ(M, θ, ξ_R)(ω) = ∫_S g ⟨ω, ξ⟩ dHⁿ` whenever `spt ω ⊆ W`. -/
theorem Submission.dgid_imrep_signed_density_representation : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (W S : Set (Euclid P)) (ξ : Euclid P → MultiVector P n) (β : Euclid P → Covector (Euclid P) n), MeasurableSet S → μHE[n] ((R.carrier ∩ W) \ S) = 0 → AEStronglyMeasurable β (μHE[n].restrict S) → (∀ x ∈ S, ξ x (β x) = 1) → (∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ S)), R.orient x = ξ x ∨ R.orient x = -ξ x) → ∃ g : Euclid P → ℝ, AEStronglyMeasurable g (μHE[n].restrict S) ∧ (∀ᵐ x ∂(μHE[n].restrict S), (∃ m : ℤ, g x = m) ∧ ‖g x‖ₑ ≤ R.carrier.indicator (fun y => (R.mult y : ℝ≥0∞)) x) ∧ ∀ ω : DifferentialForm (Euclid P) n, tsupport ω ⊆ W → R.action ω = ∫ x in S, g x * ξ x (ω x) ∂μHE[n] := by
  intro P n U R W S ξ β hS hnull hβ hξβ hor
  have hM : MeasurableSet R.carrier := R.measurableSet_carrier
  -- Step 1: the sign hypothesis as a pointwise a.e. statement
  have hor' : ∀ᵐ x ∂μHE[n], x ∈ R.carrier ∩ S → (R.orient x = ξ x ∨ R.orient x = -ξ x) :=
    (ae_restrict_iff' (hM.inter hS)).mp hor
  -- Step 2: pointwise identities on the sign set
  have hpt : ∀ x ∈ R.carrier ∩ S, (R.orient x = ξ x ∨ R.orient x = -ξ x) →
      (∃ m : ℤ, (R.mult x : ℝ) * R.orient x (β x) = m) ∧
      ‖(R.mult x : ℝ) * R.orient x (β x)‖ₑ = (R.mult x : ℝ≥0∞) ∧
      ∀ α : Covector (Euclid P) n,
        (R.mult x : ℝ) * R.orient x α = (R.mult x : ℝ) * R.orient x (β x) * ξ x α := by
    intro x hx hsign
    rcases hsign with hs | hs
    · rw [hs, hξβ x hx.2, mul_one]
      exact ⟨⟨R.mult x, by push_cast; rfl⟩, by simp, fun α => rfl⟩
    · rw [hs, neg_apply, hξβ x hx.2]
      refine ⟨⟨-(R.mult x : ℤ), by push_cast; ring⟩, by simp, fun α => ?_⟩
      rw [neg_apply]; ring
  refine ⟨R.carrier.indicator (fun x => (R.mult x : ℝ) * R.orient x (β x)), ?_, ?_, ?_⟩
  · -- Step 4: measurability
    rw [aestronglyMeasurable_indicator_iff hM, Measure.restrict_restrict hM]
    have h1 : AEStronglyMeasurable (fun x => (R.mult x : ℝ)) (μHE[n].restrict (R.carrier ∩ S)) :=
      (measurable_from_nat.comp R.measurable_mult).aestronglyMeasurable
    have h2 : AEStronglyMeasurable R.orient (μHE[n].restrict (R.carrier ∩ S)) :=
      R.aestronglyMeasurable_orient.mono_measure (Measure.restrict_mono inter_subset_left le_rfl)
    have h3 : AEStronglyMeasurable β (μHE[n].restrict (R.carrier ∩ S)) :=
      hβ.mono_measure (Measure.restrict_mono inter_subset_right le_rfl)
    have h4 : AEStronglyMeasurable (fun x => R.orient x (β x)) (μHE[n].restrict (R.carrier ∩ S)) :=
      (continuous_fst.clm_apply continuous_snd).comp_aestronglyMeasurable₂ h2 h3
    exact h1.mul h4
  · -- Step 3: integrality and the bound by the multiplicity
    filter_upwards [ae_restrict_of_ae hor', ae_restrict_mem hS] with x hx hxS
    by_cases hxM : x ∈ R.carrier
    · obtain ⟨hint, hnorm, -⟩ := hpt x ⟨hxM, hxS⟩ (hx ⟨hxM, hxS⟩)
      rw [indicator_of_mem hxM, indicator_of_mem hxM]
      exact ⟨hint, hnorm.le⟩
    · rw [indicator_of_notMem hxM, indicator_of_notMem hxM]
      exact ⟨⟨0, by simp⟩, by simp⟩
  · -- Step 5: the representation
    intro ω hω
    have hω0 : ∀ x, x ∉ W → ω x = 0 := fun x hx =>
      image_eq_zero_of_notMem_tsupport (fun h => hx (hω h))
    have e1 : ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (ω x) ∂μHE[n] =
        ∫ x in R.carrier ∩ S, (R.mult x : ℝ) * R.orient x (ω x) ∂μHE[n] := by
      apply setIntegral_eq_of_subset_of_ae_sdiff_eq_zero hM.nullMeasurableSet inter_subset_left
      filter_upwards [measure_eq_zero_iff_ae_notMem.mp hnull] with x hx hxd
      have hxW : x ∉ W := fun hxW => hx ⟨⟨hxd.1, hxW⟩, fun hxS => hxd.2 ⟨hxd.1, hxS⟩⟩
      rw [hω0 x hxW, map_zero, mul_zero]
    have e2 : ∫ x in R.carrier ∩ S, (R.mult x : ℝ) * R.orient x (ω x) ∂μHE[n] =
        ∫ x in R.carrier ∩ S, R.carrier.indicator (fun x => (R.mult x : ℝ) * R.orient x (β x)) x *
          ξ x (ω x) ∂μHE[n] := by
      apply setIntegral_congr_ae (hM.inter hS)
      filter_upwards [hor'] with x hx hxMS
      rw [indicator_of_mem hxMS.1]
      exact (hpt x hxMS (hx hxMS)).2.2 (ω x)
    have e3 : ∫ x in S, R.carrier.indicator (fun x => (R.mult x : ℝ) * R.orient x (β x)) x *
          ξ x (ω x) ∂μHE[n] =
        ∫ x in R.carrier ∩ S, R.carrier.indicator (fun x => (R.mult x : ℝ) * R.orient x (β x)) x *
          ξ x (ω x) ∂μHE[n] := by
      apply setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hS inter_subset_right
      intro x hx
      have hxM : x ∉ R.carrier := fun hxM => hx.2 ⟨hxM, hx.1⟩
      rw [indicator_of_notMem hxM, zero_mul]
    rw [IMRep.action, e1, e2, e3]
/-- **Pull-back along a parametrization dominated by `Hⁿ`** (step 6 of the graph integer-density
argument): if `Φ` is continuous on the open set `D ⊆ ℝⁿ` and `∫⁻_A f ∘ Φ dLⁿ ≤ ∫⁻_{Φ(A)} f dHⁿ`
for Borel `A ⊆ D` and Borel `f ≥ 0`, then `Φ_#(Lⁿ⌞D) ≤ Hⁿ⌞Φ(D)`.  So an `Hⁿ⌞Φ(D)`-a.e.
integer-valued `g` with `‖g‖ₑ ≤ F` pulls back to `g ∘ Φ`, which is `Lⁿ⌞D`-a.e. integer valued and,
as `∫⁻_K ‖g ∘ Φ‖ₑ ≤ ∫⁻_{Φ(K)} F dHⁿ < ∞` for compact `K ⊆ D`, locally integrable on `D`. -/
theorem Submission.dgid_dominated_pullback_integer_locallyIntegrable : ∀ (n P : ℕ) (Φ : Euclid n → Euclid P) (D : Set (Euclid n)) (g : Euclid P → ℝ) (F : Euclid P → ℝ≥0∞), IsOpen D → ContinuousOn Φ D → (∀ (A : Set (Euclid n)) (f : Euclid P → ℝ≥0∞), MeasurableSet A → A ⊆ D → Measurable f → ∫⁻ v in A, f (Φ v) ≤ ∫⁻ x in Φ '' A, f x ∂μHE[n]) → Measurable F → (∀ K : Set (Euclid n), IsCompact K → K ⊆ D → ∫⁻ x in Φ '' K, F x ∂μHE[n] ≠ ∞) → AEStronglyMeasurable g (μHE[n].restrict (Φ '' D)) → (∀ᵐ x ∂(μHE[n].restrict (Φ '' D)), (∃ m : ℤ, g x = m) ∧ ‖g x‖ₑ ≤ F x) → LocallyIntegrableOn (fun v => g (Φ v)) D volume ∧ ∀ᵐ v ∂(volume.restrict D), ∃ m : ℤ, g (Φ v) = m := by
  intro n P Φ D g F hD hΦ hMB hF hfin hg hae
  have hDm : MeasurableSet D := hD.measurableSet
  have hΦae : AEMeasurable Φ (volume.restrict D) := hΦ.aemeasurable hDm
  -- `Φ_#(Lⁿ⌞D)(B) = ∫⁻_D 1_B ∘ Φ dLⁿ ≤ ∫⁻_{Φ(D)} 1_B dHⁿ = (Hⁿ⌞Φ(D))(B)` for Borel `B`
  have hle : Measure.map Φ (volume.restrict D) ≤ μHE[n].restrict (Φ '' D) := by
    rw [Measure.le_iff]
    intro B hB
    have hind : Measurable (B.indicator (1 : Euclid P → ℝ≥0∞)) := measurable_one.indicator hB
    rw [← lintegral_indicator_one hB, ← lintegral_indicator_one hB,
      lintegral_map' hind.aemeasurable hΦae]
    exact hMB D _ hDm subset_rfl hind
  -- transfer the a.e. properties of `g` and its measurability from `Hⁿ⌞Φ(D)` to `g ∘ Φ`
  have hae' : ∀ᵐ v ∂(volume.restrict D), (∃ m : ℤ, g (Φ v) = m) ∧ ‖g (Φ v)‖ₑ ≤ F (Φ v) :=
    ae_of_ae_map hΦae (ae_mono hle hae)
  have hGm : AEStronglyMeasurable (fun v => g (Φ v)) (volume.restrict D) :=
    (hg.mono_measure hle).comp_aemeasurable hΦae
  refine ⟨?_, hae'.mono fun v hv => hv.1⟩
  -- on compact `K ⊆ D`: `∫⁻_K ‖g ∘ Φ‖ₑ ≤ ∫⁻_K F ∘ Φ ≤ ∫⁻_{Φ(K)} F dHⁿ < ∞`
  rw [locallyIntegrableOn_iff hD.isLocallyClosed]
  intro K hKD hK
  refine ⟨hGm.mono_set hKD, ?_⟩
  rw [hasFiniteIntegral_iff_enorm]
  calc ∫⁻ v in K, ‖g (Φ v)‖ₑ ≤ ∫⁻ v in K, F (Φ v) :=
        lintegral_mono_ae (ae_restrict_of_ae_restrict_of_subset hKD (hae'.mono fun v hv => hv.2))
    _ ≤ ∫⁻ x in Φ '' K, F x ∂μHE[n] := hMB K F hK.isClosed.measurableSet hKD hF
    _ < ∞ := lt_top_iff_ne_top.mpr (hfin K hK hKD)
/-- **The coordinate covector `eⱼ ⌟ δ` on `ℝ^{m+1}`** (step 2 of the boundary weak-derivative
computation in the graph-cycle regularity step of Simon 7.4.3).  For `j ∈ Fin (m + 1)` there is a
continuous alternating `m`-form `β` on `ℝ^{m+1}` with `β(e₀, …, êᵢ, …, e_m) = (−1)ʲ` if `i = j`
and `0` otherwise: `β(w₁, …, w_m) = δ(eⱼ, w₁, …, w_m)` for the standard determinant form `δ`. -/
theorem Submission.dgcr_bwd_coordinate_covector : ∀ (m : ℕ) (j : Fin (m + 1)), ∃ β : Covector (Euclid (m + 1)) m, ∀ i : Fin (m + 1), β (i.removeNth (fun l : Fin (m + 1) => EuclideanSpace.single l (1 : ℝ))) = if i = j then (-1 : ℝ) ^ (j : ℕ) else 0 := by
  intro m j
  classical
  -- The standard basis `b l = e_l` and its determinant `δ₀ c = det (c l r)_{r,l}`.
  let b : Module.Basis (Fin (m + 1)) ℝ (Euclid (m + 1)) :=
    (EuclideanSpace.basisFun (Fin (m + 1)) ℝ).toBasis
  have hb : (b : Fin (m + 1) → Euclid (m + 1)) = fun l => EuclideanSpace.single l (1 : ℝ) := by
    funext l; simp [b]
  have hdet : ∀ c : Fin (m + 1) → Euclid (m + 1), b.det c = (Matrix.of fun r l => c l r).det := by
    intro c
    rw [Module.Basis.det_apply]
    congr 1
  -- `δ₀` is continuous (entrywise continuous matrix, then `det`), so it is a covector `δ`.
  have hcont : Continuous (fun c : Fin (m + 1) → Euclid (m + 1) => b.det c) := by
    simp only [hdet]
    apply Continuous.matrix_det
    refine continuous_matrix fun r l => ?_
    exact (EuclideanSpace.proj r).continuous.comp (continuous_apply l)
  let δ : Covector (Euclid (m + 1)) (m + 1) := { b.det with cont := hcont }
  have hδ : ∀ c, δ c = b.det c := fun c => rfl
  -- `β = δ.curryLeft (b j)`, i.e. `β w = δ (b j, w₁, …, w_m)`.
  refine ⟨δ.curryLeft (b j), fun i => ?_⟩
  rw [ContinuousAlternatingMap.curryLeft_apply_apply, hδ, ← hb]
  split_ifs with hij
  · -- `i = j`: `(b i, removeNth i b) = b ∘ (cycleRange i)⁻¹`, of sign `(−1)ⁱ`.
    subst hij
    have hc : (Matrix.vecCons (b i) (i.removeNth ⇑b) : Fin (m + 1) → Euclid (m + 1)) =
        ⇑b ∘ ⇑(Equiv.symm i.cycleRange) :=
      Fin.cons_removeNth_eq_comp_cycleRange_symm (⇑b) i
    rw [hc, AlternatingMap.map_perm, Module.Basis.det_self, Equiv.Perm.sign_symm, Fin.sign_cycleRange]
    simp [Units.smul_def]
  · -- `i ≠ j`: `e_j` occurs at positions `0` and `l.succ`, where `i.succAbove l = j`.
    obtain ⟨l, hl⟩ := Fin.exists_succAbove_eq (x := j) (y := i) (Ne.symm hij)
    apply AlternatingMap.map_eq_zero_of_eq _ _ (i := 0) (j := l.succ)
    · simp [Fin.removeNth_apply, hl]
    · exact (Fin.succ_ne_zero l).symm
/-- **Exterior derivative of a function times a constant covector** (used for the boundary weak
derivatives in the graph-cycle regularity step of Simon 7.4.3).  If `a : ℝᴾ → ℝ` is
differentiable at `x` and `β` is a fixed `m`-covector, then
`d(a β)(x)(w₀, …, w_m) = Σᵢ (−1)ⁱ Da(x)wᵢ · β(w₀, …, ŵᵢ, …, w_m)`, i.e. `d(a β) = da ∧ β`:
each term of the alternating sum differentiates `y ↦ a(y) β(w₀, …, ŵᵢ, …, w_m)`. -/
theorem Submission.dgcr_bwd_extDeriv_smul_const : ∀ (P m : ℕ) (a : Euclid P → ℝ) (β : Covector (Euclid P) m) (x : Euclid P) (w : Fin (m + 1) → Euclid P), DifferentiableAt ℝ a x → exteriorDerivative (fun y => a y • β) x w = ∑ i : Fin (m + 1), (-1 : ℝ) ^ (i : ℕ) * (fderiv ℝ a x (w i) * β (i.removeNth w)) := by
  intro P m a β x w ha
  rw [exteriorDerivative_apply (ha.smul_const β) w]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  have h1 : (fun y => (a y • β) (i.removeNth w)) = fun y => a y * β (i.removeNth w) := by
    funext y
    simp [ContinuousAlternatingMap.smul_apply, smul_eq_mul]
  rw [h1, fderiv_mul_const ha]
  simp [zsmul_eq_mul, mul_comm]
/-- Smooth normal cutoff (step 1 of the boundary computation for graph cycles in the
ε-regularity proof of Simon 7.4.3): for compact `K ⊆ B_h(0) ⊆ ℝᵏ` there is a `C^∞` function `η`
with compact support in `B_h(0)` and `η = 1` near every point of `K`.  Take `r' < h` with
`K ⊆ B_{r'}(0)`, put `r = max r' (h/2) ∈ (0, h)`, and let `η` be the `ContDiffBump` at `0` with
radii `r < (r + h)/2`: `η = 1` on `closedBall 0 r` and `tsupport η = closedBall 0 ((r + h)/2)`. -/
theorem Submission.dgcr_bwd_normal_cutoff : ∀ (k : ℕ) (K : Set (Euclid k)) (h : ℝ), 0 < h → IsCompact K → K ⊆ ball (0 : Euclid k) h → ∃ η : Euclid k → ℝ, ContDiff ℝ (⊤ : ℕ∞) η ∧ HasCompactSupport η ∧ tsupport η ⊆ ball (0 : Euclid k) h ∧ ∀ w ∈ K, ∀ᶠ y in 𝓝 w, η y = 1 := by
  intro k K h hh hK hKh
  -- `K ⊆ B_{r'}(0)` for some `r' < h`; enlarge to `r = max r' (h/2) ∈ (0, h)`
  obtain ⟨r', hr'h, hKr'⟩ := exists_lt_subset_ball hK.isClosed hKh
  set r : ℝ := max r' (h / 2)
  have hr0 : 0 < r := lt_max_of_lt_right (by linarith)
  have hrh : r < h := max_lt hr'h (by linarith)
  have hKr : K ⊆ ball (0 : Euclid k) r := hKr'.trans (ball_subset_ball (le_max_left _ _))
  -- the bump at `0` with radii `r < (r + h)/2`
  let f : ContDiffBump (0 : Euclid k) := ⟨r, (r + h) / 2, hr0, by linarith⟩
  refine ⟨f, f.contDiff, f.hasCompactSupport, ?_, ?_⟩
  · rw [f.tsupport_eq]
    exact closedBall_subset_ball (show (r + h) / 2 < h by linarith)
  · intro w hw
    filter_upwards [isOpen_ball.mem_nhds (hKr hw)] with y hy
    exact f.one_of_mem_closedBall (ball_subset_closedBall hy)
/-- Step 1 of the proof that an integer multiplicity cycle carried by a `C¹` graph is regular
(Simon 7.4.3, via Allard's theorem): orthogonal coordinates on `ℝ^{n+k}`.  If the linear
isometries `ι : ℝⁿ → ℝ^{n+k}` and `ι' : ℝᵏ → ℝ^{n+k}` have orthogonal ranges `L`, `L'`, then every
`x ∈ ℝ^{n+k}` is `ι v + ι' w`, and `‖ι v + ι' w‖² = ‖v‖² + ‖w‖²`.  `L` and `L'` have dimensions `n`
and `k` and meet only in `0`, so by the dimension formula `L ⊔ L' = ℝ^{n+k}`; the norm identity
is Pythagoras. -/
theorem Submission.dgcr_orthogonal_coordinates : ∀ (n k : ℕ) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → (∀ x : Euclid (n + k), ∃ v : Euclid n, ∃ w : Euclid k, x = ι v + ι' w) ∧ ∀ (v : Euclid n) (w : Euclid k), ‖ι v + ι' w‖ ^ 2 = ‖v‖ ^ 2 + ‖w‖ ^ 2 := by
  intro n k ι ι' horth
  refine ⟨fun x => ?_, fun v w => ?_⟩
  · -- `L := range ι` and `L' := range ι'` have dimensions `n` and `k` (isometries are injective)
    have hL : Module.finrank ℝ (LinearMap.range ι.toLinearMap) = n := by
      rw [LinearMap.finrank_range_of_inj ι.injective, finrank_euclideanSpace_fin]
    have hL' : Module.finrank ℝ (LinearMap.range ι'.toLinearMap) = k := by
      rw [LinearMap.finrank_range_of_inj ι'.injective, finrank_euclideanSpace_fin]
    -- `L ⊓ L' = ⊥`: if `ι v = ι' w`, then `⟪ι v, ι v⟫ = ⟪ι v, ι' w⟫ = 0`, so `ι v = 0`
    have hinf : LinearMap.range ι.toLinearMap ⊓ LinearMap.range ι'.toLinearMap = ⊥ := by
      rw [Submodule.eq_bot_iff]
      rintro _ ⟨⟨v, rfl⟩, w, hw⟩
      have h0 : inner ℝ (ι v) (ι v) = 0 := by
        have h := horth v w
        rwa [show ι' w = ι v from hw] at h
      exact inner_self_eq_zero.1 h0
    -- dimension formula: `dim (L ⊔ L') = n + k = dim ℝ^{n+k}`, so `L ⊔ L' = ⊤`
    have hsup : LinearMap.range ι.toLinearMap ⊔ LinearMap.range ι'.toLinearMap = ⊤ := by
      apply Submodule.eq_top_of_finrank_eq
      have h := Submodule.finrank_sup_add_finrank_inf_eq
        (LinearMap.range ι.toLinearMap) (LinearMap.range ι'.toLinearMap)
      rw [hinf, finrank_bot, hL, hL'] at h
      rw [finrank_euclideanSpace_fin]
      omega
    -- `x ∈ L ⊔ L'`, so `x = ι v + ι' w`
    have hx : x ∈ LinearMap.range ι.toLinearMap ⊔ LinearMap.range ι'.toLinearMap := by
      rw [hsup]
      exact Submodule.mem_top
    obtain ⟨_, ⟨v, rfl⟩, _, ⟨w, rfl⟩, hvw⟩ := Submodule.mem_sup.1 hx
    exact ⟨v, w, hvw.symm⟩
  · -- Pythagoras: the cross term `2 ⟪ι v, ι' w⟫` vanishes and `ι`, `ι'` preserve norms
    rw [norm_add_sq_real, horth, LinearIsometry.norm_map, LinearIsometry.norm_map]
    ring
/-- Simon Ch. 2, §4 (graph charts): for linear isometries `ι : ℝⁿ → ℝ^{n+k}`, `ι' : ℝᵏ → ℝ^{n+k}`
with `⟨ιv, ι'w⟩ = 0` and `u` of class `C¹` on `D = B_s(0)`, the graph map
`Φ(v) = z + ιv + ι'u(v)` is `C¹` on `D`, and the adjoint `ι*` satisfies `ι*(Φ(v) − z) = v` for
every `v`: `⟨ι*(ιv + ι'u(v)), e⟩ = ⟨ιv, ιe⟩ + ⟨ι'u(v), ιe⟩ = ⟨v, e⟩ + 0`. -/
theorem Submission.dgce_graph_contDiffOn_left_inverse : ∀ (n k : ℕ) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (u : Euclid n → Euclid k) (z : Euclid (n + k)) (s : ℝ), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → ContDiffOn ℝ 1 u (ball 0 s) → ContDiffOn ℝ 1 (fun v => z + ι v + ι' (u v)) (ball (0 : Euclid n) s) ∧ ∃ L : Euclid (n + k) →L[ℝ] Euclid n, ∀ v, L (z + ι v + ι' (u v) - z) = v := by
  intro n k ι ι' u z s horth hu
  -- `Φ = (z + ι·) + ι' ∘ u`: constants and linear isometries are smooth, `ι' ∘ u` is `C¹` on `D`
  refine ⟨(contDiffOn_const.add ι.contDiff.contDiffOn).add (ι'.contDiff.comp_contDiffOn hu),
    ContinuousLinearMap.adjoint ι.toContinuousLinearMap, fun v => ext_inner_right ℝ fun e => ?_⟩
  -- `⟨ι*(Φ(v) − z), e⟩ = ⟨ιv + ι'u(v), ιe⟩ = ⟨v, e⟩ + ⟨ιe, ι'u(v)⟩ = ⟨v, e⟩`
  rw [ContinuousLinearMap.adjoint_inner_left, LinearIsometry.coe_toContinuousLinearMap, add_assoc,
    add_sub_cancel_left, inner_add_left, LinearIsometry.inner_map_map,
    real_inner_comm (ι e) (ι' (u v)), horth, add_zero]
/-- **A `C¹` map on a ball with a continuous affine left inverse parametrizes an embedded `C¹`
submanifold** (Simon Ch. 2, §4, (4.1), chapter-02.txt lines 849–860).  Let `D = B_s(0) ⊆ ℝᵈ`, let
`Φ : ℝᵈ → ℝᴾ` be `C¹` on `D`, and let `Pr(x) = L(x − z)` (`L` continuous linear) satisfy
`Pr(Φ(v)) = v` on `D`.  Then (a) `Φ` is injective on `D`; (b) `Φ` is differentiable on `D` and
`L ∘ DΦ(v) = id`, so `DΦ(v)` is injective; (c) `Σ = Φ(D)` is an embedded `d`-dimensional `C¹`
submanifold: at every `y ∈ Σ` take `V = D`, `W = Pr⁻¹(D) ⊇ Σ` and `ψ = Φ`; `ψ` is proper since,
for compact `K ⊆ W` with `t = max_K ‖Pr‖ < s`, `D ∩ Φ⁻¹(K) = B̄_t(0) ∩ Φ⁻¹(K)` is closed in the
compact ball `B̄_t(0)`. -/
theorem Submission.dgce_left_inverse_chart_embedded : ∀ (d P : ℕ) (Φ : Euclid d → Euclid P) (L : Euclid P →L[ℝ] Euclid d) (z : Euclid P) (s : ℝ), ContDiffOn ℝ 1 Φ (ball 0 s) → (∀ v ∈ ball (0 : Euclid d) s, L (Φ v - z) = v) → InjOn Φ (ball (0 : Euclid d) s) ∧ (∀ v ∈ ball (0 : Euclid d) s, DifferentiableAt ℝ Φ v ∧ Injective (fderiv ℝ Φ v)) ∧ IsEmbeddedSubmanifold 1 d (Φ '' ball (0 : Euclid d) s) := by
  intro d P Φ L z s hΦ hL
  -- `D = B_s(0)` is open and `Pr(x) = L(x − z)` is continuous.
  have hD : IsOpen (ball (0 : Euclid d) s) := isOpen_ball
  have hPr : Continuous fun x : Euclid P => L (x - z) := L.continuous.comp (continuous_sub_right z)
  -- Step 1, (a): `Φ v = Φ v'` gives `v = Pr(Φ v) = Pr(Φ v') = v'`.
  have hinj : InjOn Φ (ball (0 : Euclid d) s) := fun v hv v' hv' h => by
    rw [← hL v hv, ← hL v' hv', h]
  -- Step 2: `Φ` is `C¹` on the open set `D`, hence differentiable at every point of `D`.
  have hdiff : ∀ v ∈ ball (0 : Euclid d) s, DifferentiableAt ℝ Φ v := fun v hv =>
    hΦ.differentiableOn_one.differentiableAt (hD.mem_nhds hv)
  -- Step 3: `L ∘ DΦ(v) = id`.  By the chain rule `x ↦ L(Φ x − z)` has derivative `L ∘ DΦ(v)` at
  -- `v`; it equals `id` on the neighbourhood `D` of `v`, so its derivative is also `id`.
  have hLD : ∀ v ∈ ball (0 : Euclid d) s, ∀ a, L (fderiv ℝ Φ v a) = a := by
    intro v hv a
    have h₁ : HasFDerivAt (fun x => L (Φ x - z)) (L.comp (fderiv ℝ Φ v)) v :=
      L.hasFDerivAt.comp v ((hdiff v hv).hasFDerivAt.sub_const z)
    have h₂ : HasFDerivAt (fun x => L (Φ x - z)) (ContinuousLinearMap.id ℝ (Euclid d)) v := by
      refine (hasFDerivAt_id v).congr_of_eventuallyEq ?_
      filter_upwards [hD.mem_nhds hv] with x hx using hL x hx
    exact congrArg (fun f : Euclid d →L[ℝ] Euclid d => f a) (h₁.unique h₂)
  -- Step 4, (b): `DΦ(v) a = DΦ(v) b` gives `a = L(DΦ(v) a) = L(DΦ(v) b) = b`.
  have hfinj : ∀ v ∈ ball (0 : Euclid d) s, Injective (fderiv ℝ Φ v) := fun v hv =>
    Function.LeftInverse.injective (hLD v hv)
  refine ⟨hinj, fun v hv => ⟨hdiff v hv, hfinj v hv⟩, ?_⟩
  -- Step 5, (c): at `y ∈ Σ` take `V = D`, `W = Pr⁻¹(D)` and `ψ = Φ`.  `Σ ⊆ W`, since
  -- `Pr(Φ v) = v ∈ D`; hence `y ∈ W` and `ψ(V) = Σ = W ∩ Σ`.
  have hSW : Φ '' ball (0 : Euclid d) s ⊆ (fun x => L (x - z)) ⁻¹' ball (0 : Euclid d) s := by
    rintro _ ⟨v, hv, rfl⟩
    show L (Φ v - z) ∈ ball (0 : Euclid d) s
    rw [hL v hv]
    exact hv
  intro y hy
  refine ⟨ball (0 : Euclid d) s, (fun x => L (x - z)) ⁻¹' ball (0 : Euclid d) s, Φ, hD,
    hD.preimage hPr, hSW hy, by exact_mod_cast hΦ, hinj, (inter_eq_right.mpr hSW).symm, ?_,
    hfinj⟩
  -- (iv) Properness: `D ∩ Φ⁻¹(K)` is compact for every compact `K ⊆ W`; trivial if `K = ∅`.
  intro K hKW hK
  rcases K.eq_empty_or_nonempty with rfl | hKne
  · simp
  -- `‖Pr‖` attains its maximum `t` on `K` at `x₀`; `t < s` as `x₀ ∈ W`, so `B̄_t(0) ⊆ D`.
  obtain ⟨x₀, hx₀, hmax⟩ := hK.exists_isMaxOn hKne hPr.norm.continuousOn
  have hx₀W : L (x₀ - z) ∈ ball (0 : Euclid d) s := hKW hx₀
  have hsub : closedBall (0 : Euclid d) ‖L (x₀ - z)‖ ⊆ ball (0 : Euclid d) s :=
    closedBall_subset_ball (mem_ball_zero_iff.mp hx₀W)
  -- `D ∩ Φ⁻¹(K) = B̄_t(0) ∩ Φ⁻¹(K)`: if `v ∈ D` and `Φ v ∈ K`, then `‖v‖ = ‖Pr(Φ v)‖ ≤ t`.
  have heq : ball (0 : Euclid d) s ∩ Φ ⁻¹' K =
      closedBall (0 : Euclid d) ‖L (x₀ - z)‖ ∩ Φ ⁻¹' K := by
    ext v
    refine ⟨fun ⟨hv, hvK⟩ => ⟨?_, hvK⟩, fun ⟨hv, hvK⟩ => ⟨hsub hv, hvK⟩⟩
    rw [mem_closedBall_zero_iff, ← hL v hv]
    exact isMaxOn_iff.mp hmax (Φ v) hvK
  -- `Φ` is continuous on the closed ball `B̄_t(0) ⊆ D` and `K` is closed, so `B̄_t(0) ∩ Φ⁻¹(K)` is
  -- a closed subset of the compact ball `B̄_t(0)`.
  rw [heq]
  exact (isCompact_closedBall 0 _).of_isClosed_subset
    ((hΦ.continuousOn.mono hsub).preimage_isClosed_of_isClosed isClosed_closedBall hK.isClosed)
    inter_subset_left
/-- **Simon Ch. 2, §4, (4.3)**: if `Φ` is `C¹` on `D = B_s(0) ⊆ ℝᵈ` and `x ↦ L(x − z)` is a left
inverse of `Φ` on `D`, then `T_{Φ(v)}Φ(D) ⊆ DΦ(v)(ℝᵈ)` for every `v ∈ D`.  If `γ` witnesses
`w ∈ T_{Φ(v)}Φ(D)`, the curve `c(t) = L(γ(t) − z)` has `c(0) = v`, `c'(0) = L w` and
`γ = Φ ∘ c` on `(−1, 1)`, so the chain rule and uniqueness of derivatives give
`w = DΦ(v)(L w)`. -/
theorem Submission.dgce_left_inverse_tangentSpace_subset_range : ∀ (d P : ℕ) (Φ : Euclid d → Euclid P) (L : Euclid P →L[ℝ] Euclid d) (z : Euclid P) (s : ℝ), ContDiffOn ℝ 1 Φ (ball 0 s) → (∀ v ∈ ball (0 : Euclid d) s, L (Φ v - z) = v) → ∀ v ∈ ball (0 : Euclid d) s, tangentSpace (Φ '' ball (0 : Euclid d) s) (Φ v) ⊆ (LinearMap.range (fderiv ℝ Φ v : Euclid d →ₗ[ℝ] Euclid P) : Set (Euclid P)) := by
  rintro d P Φ L z s hΦ hL v₀ hv₀ w ⟨γ, -, hγ, hγ0, hγw⟩
  -- `Φ` is `C¹` on the open ball, hence differentiable at `v₀`
  have hΦv₀ : HasFDerivAt Φ (fderiv ℝ Φ v₀) v₀ :=
    (hΦ.differentiableOn_one.differentiableAt (isOpen_ball.mem_nhds hv₀)).hasFDerivAt
  -- `c(t) = L(γ(t) − z)` has `c'(0) = L w` and `c(0) = L(Φ(v₀) − z) = v₀`
  have hc : HasDerivAt (fun t => L (γ t - z)) (L w) 0 :=
    L.hasFDerivAt.comp_hasDerivAt 0 (hγw.sub_const z)
  have hc0 : v₀ = L (γ 0 - z) := by rw [hγ0, hL v₀ hv₀]
  -- `γ = Φ ∘ c` on the neighbourhood `(−1, 1)` of `0`: `γ(t) = Φ(u)` with `u ∈ D`, so `c(t) = u`
  have hγc : γ =ᶠ[𝓝 0] Φ ∘ fun t => L (γ t - z) := by
    filter_upwards [Ioo_mem_nhds (by norm_num : (-1 : ℝ) < 0) one_pos] with t ht
    obtain ⟨u, hu, hut⟩ := hγ ht
    rw [Function.comp_apply, ← hut, hL u hu]
  -- chain rule, then uniqueness of derivatives: `w = DΦ(v₀)(L w)`
  have hw : w = fderiv ℝ Φ v₀ (L w) :=
    hγw.unique ((hΦv₀.comp_hasDerivAt_of_eq 0 hc hc0).congr_of_eventuallyEq hγc)
  exact ⟨L w, hw.symm⟩
/-- **`∫_Q g dHⁿ > 0` for a nonnegative `C_c` function `g` with `g(w) > 0` at a point `w` of an
`n`-plane `Q`** (step 4 of the proof that approximate tangent planes of a submanifold lie in its
tangent spaces; Simon Ch. 3, 1.4).  `Hⁿ⌞Q` is regular with support `Q` (SimonGMT Ch. 3), so `g` is
`Hⁿ⌞Q`-integrable and the open set `{g ≠ 0} ∋ w` has positive `Hⁿ⌞Q`-measure. -/
theorem Submission.dsmc_att_setIntegral_submodule_pos : ∀ (P n : ℕ) (Q : Submodule ℝ (Euclid P)) (g : Euclid P → ℝ) (w : Euclid P), Module.finrank ℝ Q = n → Continuous g → HasCompactSupport g → (∀ y, 0 ≤ g y) → w ∈ Q → 0 < g w → 0 < ∫ y in (Q : Set (Euclid P)), g y ∂μHE[n] := by
  intro P n Q g w hQ hg hgc hg0 hw hgw
  -- `Hⁿ⌞Q` is regular, hence finite on compact sets, so the `C_c` function `g` is integrable.
  have := Poincare.SimonGMT.Chapter03.regular_euclideanHausdorffMeasure_restrict_submodule hQ
  rw [integral_pos_iff_support_of_nonneg hg0 (hg.integrable_of_hasCompactSupport hgc)]
  -- `w ∈ Q = spt(Hⁿ⌞Q)` and `{g ≠ 0}` is an open neighbourhood of `w`.
  have hwμ : w ∈ ((μHE[n] : Measure (Euclid P)).restrict (Q : Set (Euclid P))).support := by
    rwa [Poincare.SimonGMT.Chapter03.support_euclideanHausdorffMeasure_restrict_submodule hQ]
  exact (Measure.mem_support_iff_forall _).1 hwμ _ (hg.isOpen_support.mem_nhds hgw.ne')
/-- Blow-up maps preserve `Hⁿ`-null sets: if `λ ≠ 0` and `Hⁿ(E) = 0`, then `Hⁿ(η_{x,λ}(E)) = 0`.
Since `η_{x,λ}(E) = λ⁻¹ · (E − x)`, the translation `y ↦ y − x` is an isometry (so
`Hⁿ(E − x) = Hⁿ(E) = 0`) and the dilation by `λ⁻¹ ≠ 0` multiplies `Hⁿ` by `|λ⁻¹|ⁿ`. -/
theorem Submission.dsmc_att_blowUpMap_image_null : ∀ (P n : ℕ) (E : Set (Euclid P)) (x : Euclid P) (lam : ℝ), lam ≠ 0 → μHE[n] E = 0 → μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x lam '' E) = 0 := by
  intro P n E x lam hlam hE
  -- Step 1: `η_{x,λ}(E) = λ⁻¹ · τ(E)`, where `τ y = y − x`
  have himage : Poincare.SimonGMT.Chapter03.blowUpMap x lam '' E =
      (fun z : Euclid P => lam⁻¹ • z) '' ((fun y : Euclid P => y - x) '' E) := by
    rw [Set.image_image]
    rfl
  -- Step 2: `τ` is an isometry, so `Hⁿ(τ(E)) = Hⁿ(E) = 0`
  have hτ : Isometry (fun y : Euclid P => y - x) := (IsometryEquiv.subRight x).isometry
  have htrans : μHE[n] ((fun y : Euclid P => y - x) '' E) = 0 := by
    rw [hτ.euclideanHausdorffMeasure_image, hE]
  -- Steps 3–4: `Hⁿ(λ⁻¹ · τ(E)) = ‖λ⁻¹‖₊ⁿ • Hⁿ(τ(E)) = 0`
  rw [himage, Set.image_smul, Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hlam), htrans,
    smul_zero]

/-- **Blow-ups of `M ∩ N` approach every vector of an approximate tangent space** (Simon Ch. 3,
Definition 1.4, chapter-03.txt lines 77–83, tested as in Remark 1.5(3), lines 90–92).  If
`Hⁿ(M \ N) = 0`, `Q` is an approximate tangent space of `M` at `x`, `w ∈ Q` and `s > 0`, then for
all small `λ > 0` some `y ∈ M ∩ N` has `|λ⁻¹(y − x) − w| < s`.  The tent `f = max(0, s − |· − w|)`
lies in `C_c`, vanishes off `B_s(w)` and has `∫_Q f dHⁿ > 0`, so `∫_{η_{x,λ}(M)} f dHⁿ > 0` for
small `λ`; hence `Hⁿ(η_{x,λ}(M) ∩ B_s(w)) ≠ 0`, and since `η_{x,λ}(M \ N)` is `Hⁿ`-null,
`η_{x,λ}(M ∩ N)` meets `B_s(w)`. -/
theorem Submission.dsmc_att_blowUp_points_of_approxTangent : ∀ (P n : ℕ) (M N : Set (Euclid P)) (x w : Euclid P) (Q : Submodule ℝ (Euclid P)), μHE[n] (M \ N) = 0 → HasApproximateTangentSpaceAt n M x Q → w ∈ Q → ∀ s : ℝ, 0 < s → ∃ lam₀ : ℝ, 0 < lam₀ ∧ ∀ lam : ℝ, 0 < lam → lam < lam₀ → ∃ y ∈ M ∩ N, ‖lam⁻¹ • (y - x) - w‖ < s := by
  intro P n M N x w Q hMN hQ hw s hs
  -- the tent `g = max(0, s − |· − w|)`: continuous, `g ≥ 0`, `g(w) = s` and `{g ≠ 0} ⊆ B_s(w)`
  set g : Euclid P → ℝ := fun y => max 0 (s - ‖y - w‖)
  have hg_cont : Continuous g :=
    continuous_const.max (continuous_const.sub (continuous_id.sub continuous_const).norm)
  have hg_nonneg : ∀ y, 0 ≤ g y := fun y => le_max_left _ _
  have hg_ball : ∀ y, g y ≠ 0 → y ∈ ball w s := by
    intro y hy
    rw [mem_ball, dist_eq_norm]
    by_contra h
    exact hy (max_eq_left (by linarith [not_lt.mp h]))
  have hg_supp : HasCompactSupport g :=
    HasCompactSupport.intro (isCompact_closedBall w s) fun y hy =>
      not_not.mp fun h => hy (ball_subset_closedBall (hg_ball y h))
  let f : CompactlySupportedContinuousMap (Euclid P) ℝ := ⟨⟨g, hg_cont⟩, hg_supp⟩
  -- `∫_Q f dHⁿ > 0`, hence `∫_{η_{x,λ}(M)} f dHⁿ > 0` for every `λ ∈ (0, λ₀)`
  have hI : 0 < ∫ y in (Q : Set (Euclid P)), g y ∂μHE[n] :=
    Submission.dsmc_att_setIntegral_submodule_pos P n Q g w hQ.1 hg_cont hg_supp hg_nonneg hw
      (by simp [g, hs])
  obtain ⟨lam₀, hlam₀, hpos⟩ :=
    mem_nhdsGT_iff_exists_Ioo_subset.mp ((hQ.2 f).eventually (lt_mem_nhds hI))
  refine ⟨lam₀, hlam₀, fun lam hlam hlam₀' => ?_⟩
  set η := Poincare.SimonGMT.Chapter03.blowUpMap x lam with hη
  -- a positive integral of `f` over `η(M)` forces `Hⁿ(η(M) ∩ B_s(w)) ≠ 0`
  have hball : μHE[n] (η '' M ∩ ball w s) ≠ 0 := by
    intro h0
    have hF : 0 < ∫ y in η '' M, f y ∂μHE[n] := hpos ⟨hlam, hlam₀'⟩
    have hF0 : ∫ y in η '' M, f y ∂μHE[n] = 0 := by
      apply integral_eq_zero_of_ae
      rw [EventuallyEq, ae_iff]
      refine measure_mono_null (fun y hy => hg_ball y hy) ?_
      rw [Measure.restrict_apply measurableSet_ball, inter_comm]
      exact h0
    exact hF.ne' hF0
  -- `η(M \ N)` is `Hⁿ`-null and `η(M) ∩ B_s(w) ⊆ (η(M ∩ N) ∩ B_s(w)) ∪ η(M \ N)`
  have hnull : μHE[n] (η '' (M \ N)) = 0 :=
    Submission.dsmc_att_blowUpMap_image_null P n (M \ N) x lam hlam.ne' hMN
  have hcov : η '' M ∩ ball w s ⊆ (η '' (M ∩ N) ∩ ball w s) ∪ η '' (M \ N) := by
    rintro z ⟨⟨y, hyM, rfl⟩, hz⟩
    by_cases hyN : y ∈ N
    · exact Or.inl ⟨⟨y, ⟨hyM, hyN⟩, rfl⟩, hz⟩
    · exact Or.inr ⟨y, ⟨hyM, hyN⟩, rfl⟩
  have hne : μHE[n] (η '' (M ∩ N) ∩ ball w s) ≠ 0 := fun h0 =>
    hball (measure_mono_null hcov (measure_union_null h0 hnull))
  -- so `η(M ∩ N)` meets `B_s(w)`
  obtain ⟨z, ⟨y, hy, rfl⟩, hz⟩ := nonempty_of_measure_ne_zero hne
  refine ⟨y, hy, ?_⟩
  rw [mem_ball, dist_eq_norm] at hz
  simpa [hη, Poincare.SimonGMT.Chapter03.blowUpMap] using hz
/-- **Simon Ch. 3, 1.4–1.5** (last step of `TₓM ⊆ TₓN`): rescaled-secant limits lie in the
range of the secant-approximating map.  If every `y ∈ N` near `x` has `|y − x − Aa| ≤ ε|y − x|`
for some `a` (any `ε > 0`), and for every `s > 0` and all small `λ > 0` some `y ∈ N` has
`|λ⁻¹(y − x) − w| < s`, then `w ∈ L = A(ℝᵈ)`.  `L` is a finite-dimensional, hence closed,
subspace; for `η = 2s`, `K ≥ |w| + s` and `εK < s`, a blow-up point `y` at a scale `λ < δ/K`
has `|y − x| < λK < δ`, and its secant approximant `Aa` gives `A(λ⁻¹a) ∈ L` within
`s + εK < η` of `w`. -/
theorem Submission.dsmc_att_mem_range_of_secant_blowUp : ∀ (P d : ℕ) (N : Set (Euclid P)) (x w : Euclid P) (A : Euclid d →L[ℝ] Euclid P), (∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ y ∈ N, dist y x < δ → ∃ a : Euclid d, ‖y - x - A a‖ ≤ ε * ‖y - x‖) → (∀ s : ℝ, 0 < s → ∃ lam₀ : ℝ, 0 < lam₀ ∧ ∀ lam : ℝ, 0 < lam → lam < lam₀ → ∃ y ∈ N, ‖lam⁻¹ • (y - x) - w‖ < s) → w ∈ Set.range A := by
  intro P d N x w A hsec hblow
  -- `L = A(ℝᵈ)` is a finite-dimensional, hence closed, subspace: approximate `w` within `η`
  have hL : IsClosed (Set.range A) := by
    rw [← ContinuousLinearMap.coe_coe, ← LinearMap.coe_range]
    exact Submodule.closed_of_finiteDimensional _
  rw [← hL.closure_eq, Metric.mem_closure_iff]
  intro η hη
  -- `η = s + s`, `K ≥ |w| + s` and `εK < s`
  obtain ⟨s, hs, rfl⟩ : ∃ s : ℝ, 0 < s ∧ s + s = η := ⟨η / 2, half_pos hη, add_halves η⟩
  obtain ⟨K, hK, hwK⟩ : ∃ K : ℝ, 0 < K ∧ ‖w‖ + s ≤ K := ⟨‖w‖ + s, by positivity, le_rfl⟩
  obtain ⟨ε, hε, hεK⟩ : ∃ ε : ℝ, 0 < ε ∧ ε * K < s := ⟨s / (K + 1), by positivity, by
    rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
    nlinarith⟩
  obtain ⟨δ, hδ, hδsec⟩ := hsec ε hε
  obtain ⟨lam₀, hlam₀, hlam⟩ := hblow s hs
  -- the scale `λ = min(λ₀, δ/K)/2` lies in `(0, λ₀)` and has `λK < δ`
  have hm : 0 < min lam₀ (δ / K) := lt_min hlam₀ (div_pos hδ hK)
  obtain ⟨lam, hlam_pos, hlam_lt, hlamK⟩ : ∃ lam : ℝ, 0 < lam ∧ lam < lam₀ ∧ lam * K < δ :=
    ⟨min lam₀ (δ / K) / 2, half_pos hm, (half_lt_self hm).trans_le (min_le_left _ _),
      (lt_div_iff₀ hK).mp ((half_lt_self hm).trans_le (min_le_right _ _))⟩
  -- a blow-up point `y ∈ N` has `λ⁻¹|y − x| < |w| + s ≤ K`, so `|y − x| < λK < δ`
  obtain ⟨y, hyN, hy⟩ := hlam lam hlam_pos hlam_lt
  have hlam_inv : 0 ≤ lam⁻¹ := inv_nonneg.mpr hlam_pos.le
  have hyK : lam⁻¹ * ‖y - x‖ < K := by
    rw [← norm_smul_of_nonneg hlam_inv]
    linarith [norm_sub_norm_le (lam⁻¹ • (y - x)) w]
  have hyδ : dist y x < δ := by
    rw [dist_eq_norm]
    linarith [(inv_mul_lt_iff₀ hlam_pos).mp hyK]
  -- its secant approximant `Aa` gives `ℓ = A(λ⁻¹a) ∈ L` with `|λ⁻¹(y − x) − ℓ| < εK < s`
  obtain ⟨a, ha⟩ := hδsec y hyN hyδ
  have hℓ : dist (lam⁻¹ • (y - x)) (A (lam⁻¹ • a)) < s := by
    rw [dist_eq_norm, map_smul, ← smul_sub, norm_smul_of_nonneg hlam_inv]
    calc lam⁻¹ * ‖y - x - A a‖ ≤ lam⁻¹ * (ε * ‖y - x‖) := by gcongr
      _ = ε * (lam⁻¹ * ‖y - x‖) := by ring
      _ < ε * K := by gcongr
      _ < s := hεK
  -- the triangle inequality gives `|w − ℓ| < s + s = η`
  have hw : dist w (lam⁻¹ • (y - x)) < s := by rwa [dist_comm, dist_eq_norm]
  exact ⟨A (lam⁻¹ • a), ⟨lam⁻¹ • a, rfl⟩,
    (dist_triangle w (lam⁻¹ • (y - x)) _).trans_lt (add_lt_add hw hℓ)⟩
/-- **Simon Ch. 2, §5** (frame trace bound for a first-order perturbation of the identity): if
`‖B‖ ≤ A`, `‖L − I − tB‖ ≤ η|t|` with `η ≤ 1`, and `τ₁, …, τₙ` is orthonormal in `ℝᴾ`, then
(i) `|Σₐ τₐ · Bτₐ| ≤ nA` and (ii) `Σₐ |Lτₐ|² − n ≤ 2t Σₐ τₐ · Bτₐ + 2nη|t| + n(A + 1)²t²`.
With `E = L − I − tB` and `wₐ = tBτₐ + Eτₐ` we have `Lτₐ = τₐ + wₐ`, `|wₐ| ≤ (A + 1)|t|` and
`τₐ · Eτₐ ≤ η|t|`; expand `|τₐ + wₐ|² = 1 + 2t τₐ · Bτₐ + 2 τₐ · Eτₐ + |wₐ|²` and sum over `a`. -/
theorem Submission.fvmb_perturbed_frame_sum_norm_sq_sub_le : ∀ (P n : ℕ) (A η t : ℝ) (B L : Euclid P →L[ℝ] Euclid P) (τ : Fin n → Euclid P), η ≤ 1 → ‖B‖ ≤ A → ‖L - ContinuousLinearMap.id ℝ (Euclid P) - t • B‖ ≤ η * |t| → Orthonormal ℝ τ → |∑ a, inner ℝ (τ a) (B (τ a))| ≤ (n : ℝ) * A ∧ ∑ a, ‖L (τ a)‖ ^ 2 - (n : ℝ) ≤ 2 * t * (∑ a, inner ℝ (τ a) (B (τ a))) + 2 * (n : ℝ) * η * |t| + (n : ℝ) * (A + 1) ^ 2 * t ^ 2 := by
  intro P n A η t B L τ hη hB hE hτ
  -- `E = L − I − tB`, so `‖E‖ ≤ η|t|`
  set E : Euclid P →L[ℝ] Euclid P := L - ContinuousLinearMap.id ℝ (Euclid P) - t • B with hEdef
  have hτ1 : ∀ a, ‖τ a‖ = 1 := hτ.1
  -- unit vectors: `|Bτₐ| ≤ A`, `|Eτₐ| ≤ η|t|` and `|τₐ · Bτₐ| ≤ A`
  have hBa : ∀ a, ‖B (τ a)‖ ≤ A := fun a =>
    calc ‖B (τ a)‖ ≤ ‖B‖ * ‖τ a‖ := B.le_opNorm _
      _ = ‖B‖ := by rw [hτ1 a, mul_one]
      _ ≤ A := hB
  have hEa : ∀ a, ‖E (τ a)‖ ≤ η * |t| := fun a =>
    calc ‖E (τ a)‖ ≤ ‖E‖ * ‖τ a‖ := E.le_opNorm _
      _ = ‖E‖ := by rw [hτ1 a, mul_one]
      _ ≤ η * |t| := hE
  have hDa : ∀ a, |inner ℝ (τ a) (B (τ a))| ≤ A := fun a =>
    calc |inner ℝ (τ a) (B (τ a))| ≤ ‖τ a‖ * ‖B (τ a)‖ := abs_real_inner_le_norm _ _
      _ = ‖B (τ a)‖ := by rw [hτ1 a, one_mul]
      _ ≤ A := hBa a
  refine ⟨?_, ?_⟩
  · calc |∑ a, inner ℝ (τ a) (B (τ a))| ≤ ∑ a, |inner ℝ (τ a) (B (τ a))| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _a : Fin n, A := Finset.sum_le_sum fun a _ => hDa a
      _ = (n : ℝ) * A := by rw [Finset.sum_const, Finset.card_fin, nsmul_eq_mul]
  · -- one column: `|Lτₐ|² = |τₐ + wₐ|²` with `wₐ = tBτₐ + Eτₐ`
    have hcol : ∀ a, ‖L (τ a)‖ ^ 2 ≤
        1 + 2 * t * inner ℝ (τ a) (B (τ a)) + 2 * η * |t| + (A + 1) ^ 2 * t ^ 2 := by
      intro a
      have hL : L (τ a) = τ a + (t • B (τ a) + E (τ a)) := by
        simp only [hEdef, sub_apply, smul_apply, ContinuousLinearMap.id_apply]
        abel
      have hw : ‖t • B (τ a) + E (τ a)‖ ≤ (A + 1) * |t| :=
        calc ‖t • B (τ a) + E (τ a)‖ ≤ ‖t • B (τ a)‖ + ‖E (τ a)‖ := norm_add_le _ _
          _ = |t| * ‖B (τ a)‖ + ‖E (τ a)‖ := by rw [norm_smul, Real.norm_eq_abs]
          _ ≤ |t| * A + η * |t| :=
              add_le_add (mul_le_mul_of_nonneg_left (hBa a) (abs_nonneg t)) (hEa a)
          _ ≤ |t| * A + 1 * |t| := by gcongr
          _ = (A + 1) * |t| := by ring
      have hwsq : ‖t • B (τ a) + E (τ a)‖ ^ 2 ≤ (A + 1) ^ 2 * t ^ 2 :=
        calc ‖t • B (τ a) + E (τ a)‖ ^ 2 ≤ ((A + 1) * |t|) ^ 2 :=
              pow_le_pow_left₀ (norm_nonneg _) hw 2
          _ = (A + 1) ^ 2 * t ^ 2 := by rw [mul_pow, sq_abs]
      have hcross : inner ℝ (τ a) (E (τ a)) ≤ η * |t| :=
        calc inner ℝ (τ a) (E (τ a)) ≤ ‖τ a‖ * ‖E (τ a)‖ := real_inner_le_norm _ _
          _ = ‖E (τ a)‖ := by rw [hτ1 a, one_mul]
          _ ≤ η * |t| := hEa a
      rw [hL, norm_add_sq_real, hτ1 a, inner_add_right, real_inner_smul_right]
      linarith
    calc ∑ a, ‖L (τ a)‖ ^ 2 - (n : ℝ)
        ≤ ∑ a, (1 + 2 * t * inner ℝ (τ a) (B (τ a)) + 2 * η * |t| + (A + 1) ^ 2 * t ^ 2) -
            (n : ℝ) := by
          gcongr with a
          exact hcol a
      _ = 2 * t * (∑ a, inner ℝ (τ a) (B (τ a))) + 2 * (n : ℝ) * η * |t| +
            (n : ℝ) * (A + 1) ^ 2 * t ^ 2 := by
          rw [Finset.sum_add_distrib, Finset.sum_add_distrib, Finset.sum_add_distrib,
            Finset.sum_const, Finset.sum_const, Finset.sum_const, ← Finset.mul_sum,
            Finset.card_fin, nsmul_eq_mul, nsmul_eq_mul, nsmul_eq_mul]
          ring
/-- **Simon Ch. 2, §5** (the expansion `J_t = 1 + t div_M X + O(t²)` behind the first variation
formula 5.3), scalar one-sided step: given `n`, `A ≥ 0`, `ε > 0` there are `0 < η ≤ 1` and
`δ > 0` such that `|t| < δ`, `|D| ≤ nA` and `g ≤ exp(2tD + 2nη|t| + n(A + 1)²t²)` imply
`√g ≤ 1 + tD + ε|t|`.  With `σ = tD + nη|t| + n(A + 1)²t²/2` the hypothesis gives
`√g ≤ √(e^σ e^σ) = e^σ`; `|σ| ≤ c₀|t| ≤ 1` for `c₀ = (n + 1)(A + 2 + (A + 1)²)`, so
`e^σ ≤ 1 + σ + σ² ≤ 1 + tD + nη|t| + Kt²` with `K = n(A + 1)²/2 + c₀²`.  Take
`η = min(1, ε/(2n + 1))` (so `nη ≤ ε/2`) and `δ = min(1, 1/c₀, ε/(2K))` (so `Kt² ≤ (ε/2)|t|`). -/
theorem Submission.fvmb_sqrt_le_first_order_of_le_exp : ∀ (n : ℕ) (A ε : ℝ), 0 ≤ A → 0 < ε → ∃ η : ℝ, 0 < η ∧ η ≤ 1 ∧ ∃ δ : ℝ, 0 < δ ∧ ∀ t D g : ℝ, |t| < δ → |D| ≤ (n : ℝ) * A → g ≤ Real.exp (2 * t * D + 2 * (n : ℝ) * η * |t| + (n : ℝ) * (A + 1) ^ 2 * t ^ 2) → Real.sqrt g ≤ 1 + t * D + ε * |t| := by
  intro n A ε hA hε
  have hn : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  -- Step 1: the constants `c₀`, `K`, `η`, `δ`
  obtain ⟨c₀, hc₀⟩ : ∃ c₀ : ℝ, c₀ = ((n : ℝ) + 1) * (A + 2 + (A + 1) ^ 2) := ⟨_, rfl⟩
  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = (n : ℝ) * (A + 1) ^ 2 / 2 + c₀ ^ 2 := ⟨_, rfl⟩
  have hc₀pos : 0 < c₀ := by rw [hc₀]; positivity
  have hKpos : 0 < K := by
    rw [hK]; exact add_pos_of_nonneg_of_pos (by positivity) (pow_pos hc₀pos 2)
  obtain ⟨η, hη⟩ : ∃ η : ℝ, η = min 1 (ε / (2 * (n : ℝ) + 1)) := ⟨_, rfl⟩
  have h2n : (0 : ℝ) < 2 * (n : ℝ) + 1 := by positivity
  have hηpos : 0 < η := by rw [hη]; exact lt_min one_pos (div_pos hε h2n)
  have hη1 : η ≤ 1 := by rw [hη]; exact min_le_left _ _
  -- Step 2: `nη ≤ ε/2`
  have hnη : (n : ℝ) * η ≤ ε / 2 := by
    have h1 : η * (2 * (n : ℝ) + 1) ≤ ε := by
      rw [← le_div_iff₀ h2n, hη]; exact min_le_right _ _
    linarith
  refine ⟨η, hηpos, hη1, min 1 (min (1 / c₀) (ε / (2 * K))),
    lt_min one_pos (lt_min (one_div_pos.mpr hc₀pos) (div_pos hε (mul_pos two_pos hKpos))), ?_⟩
  intro t D g ht hD hg
  -- Step 3: `|t| ≤ 1`, `|t| ≤ 1/c₀`, `|t| ≤ ε/(2K)`, `t² ≤ |t|`
  have ht1 : |t| ≤ 1 := (ht.trans_le (min_le_left _ _)).le
  have htc : |t| ≤ 1 / c₀ := (ht.trans_le ((min_le_right _ _).trans (min_le_left _ _))).le
  have htK : |t| ≤ ε / (2 * K) := (ht.trans_le ((min_le_right _ _).trans (min_le_right _ _))).le
  have hta : 0 ≤ |t| := abs_nonneg t
  have ht2 : t ^ 2 ≤ |t| := by
    rw [← sq_abs]; nlinarith [mul_nonneg hta (sub_nonneg.mpr ht1)]
  -- Step 4: `√g ≤ exp σ`
  obtain ⟨σ, hσ⟩ : ∃ σ : ℝ, σ = t * D + (n : ℝ) * η * |t| + (n : ℝ) * (A + 1) ^ 2 * t ^ 2 / 2 :=
    ⟨_, rfl⟩
  have hsqrt : Real.sqrt g ≤ Real.exp σ := by
    have h2σ : 2 * t * D + 2 * (n : ℝ) * η * |t| + (n : ℝ) * (A + 1) ^ 2 * t ^ 2 = σ + σ := by
      rw [hσ]; ring
    rw [h2σ, Real.exp_add] at hg
    calc Real.sqrt g ≤ Real.sqrt (Real.exp σ * Real.exp σ) := Real.sqrt_le_sqrt hg
      _ = Real.exp σ := Real.sqrt_mul_self (Real.exp_pos σ).le
  -- Step 5: `|σ| ≤ c₀|t|`
  have hσabs : |σ| ≤ c₀ * |t| := by
    have h1 : |t * D| ≤ |t| * ((n : ℝ) * A) := by
      rw [abs_mul]; exact mul_le_mul_of_nonneg_left hD hta
    have h2 : abs ((n : ℝ) * η * |t|) ≤ (n : ℝ) * |t| := by
      rw [abs_of_nonneg (mul_nonneg (mul_nonneg hn hηpos.le) hta)]
      exact mul_le_mul_of_nonneg_right (mul_le_of_le_one_right hn hη1) hta
    have h3 : |(n : ℝ) * (A + 1) ^ 2 * t ^ 2 / 2| ≤ (n : ℝ) * (A + 1) ^ 2 * |t| := by
      have hc : (0 : ℝ) ≤ (n : ℝ) * (A + 1) ^ 2 := by positivity
      have hc2 : (0 : ℝ) ≤ (n : ℝ) * (A + 1) ^ 2 * t ^ 2 := by positivity
      rw [abs_of_nonneg (by positivity)]
      calc (n : ℝ) * (A + 1) ^ 2 * t ^ 2 / 2 ≤ (n : ℝ) * (A + 1) ^ 2 * t ^ 2 := by linarith
        _ ≤ (n : ℝ) * (A + 1) ^ 2 * |t| := mul_le_mul_of_nonneg_left ht2 hc
    have htri : |σ| ≤ |t * D| + abs ((n : ℝ) * η * |t|) + |(n : ℝ) * (A + 1) ^ 2 * t ^ 2 / 2| := by
      rw [hσ]
      exact (abs_add_le _ _).trans (add_le_add (abs_add_le _ _) le_rfl)
    have hcoef : (n : ℝ) * (A + 1 + (A + 1) ^ 2) ≤ c₀ := by
      rw [hc₀]; nlinarith [sq_nonneg (A + 1)]
    calc |σ| ≤ |t| * ((n : ℝ) * A) + (n : ℝ) * |t| + (n : ℝ) * (A + 1) ^ 2 * |t| := by linarith
      _ = (n : ℝ) * (A + 1 + (A + 1) ^ 2) * |t| := by ring
      _ ≤ c₀ * |t| := mul_le_mul_of_nonneg_right hcoef hta
  -- Step 6: `|σ| ≤ 1` and `σ² ≤ c₀²t²`
  have hσ1 : |σ| ≤ 1 := by
    calc |σ| ≤ c₀ * |t| := hσabs
      _ ≤ c₀ * (1 / c₀) := mul_le_mul_of_nonneg_left htc hc₀pos.le
      _ = 1 := mul_one_div_cancel hc₀pos.ne'
  have hσsq : σ ^ 2 ≤ c₀ ^ 2 * t ^ 2 := by
    have h := pow_le_pow_left₀ (abs_nonneg σ) hσabs 2
    rwa [sq_abs, mul_pow, sq_abs] at h
  -- Step 7: `exp σ ≤ 1 + σ + σ²`
  have hexp : Real.exp σ ≤ 1 + σ + σ ^ 2 := by
    have h := (le_abs_self _).trans (Real.abs_exp_sub_one_sub_id_le hσ1)
    linarith
  -- Step 8: the error terms `nη|t| ≤ (ε/2)|t|` and `Kt² ≤ (ε/2)|t|`
  have hnηt : (n : ℝ) * η * |t| ≤ ε / 2 * |t| := mul_le_mul_of_nonneg_right hnη hta
  have hKt : K * t ^ 2 ≤ ε / 2 * |t| := by
    have hK' : K * |t| ≤ ε / 2 := by
      calc K * |t| ≤ K * (ε / (2 * K)) := mul_le_mul_of_nonneg_left htK hKpos.le
        _ = ε / 2 := by field_simp
    calc K * t ^ 2 = (K * |t|) * |t| := by rw [← sq_abs t]; ring
      _ ≤ ε / 2 * |t| := mul_le_mul_of_nonneg_right hK' hta
  have hKt2 : K * t ^ 2 = (n : ℝ) * (A + 1) ^ 2 * t ^ 2 / 2 + c₀ ^ 2 * t ^ 2 := by
    rw [hK]; ring
  -- Step 9: `√g ≤ exp σ ≤ 1 + σ + σ² ≤ 1 + tD + nη|t| + Kt² ≤ 1 + tD + ε|t|`
  linarith
/-- **Gram determinant bound** (Simon Ch. 4, 1.9 and Ch. 2, §5, where the Jacobian is the square
root of such a Gram determinant): `det(vᵢ · vⱼ) ≤ exp(Σₐ |vₐ|² − n)` for `v₁, …, vₙ ∈ ℝᴾ`.
With `V eₐ = vₐ` on `ℝⁿ`, the Gram matrix is the matrix of `S = V*V` in the standard basis, so
`det G = Πᵢ λᵢ` and `Σₐ |vₐ|² = trace S = Σᵢ λᵢ` for the eigenvalues `λᵢ = |V uᵢ|² ≥ 0` of `S`;
multiply `λᵢ ≤ e^{λᵢ − 1}` (`s + 1 ≤ eˢ`) over `i`. -/
theorem Submission.fvmb_gram_det_le_exp_sum_norm_sq_sub : ∀ (P n : ℕ) (v : Fin n → Euclid P), Matrix.det (Matrix.of fun i j => inner ℝ (v i) (v j)) ≤ Real.exp (∑ a, ‖v a‖ ^ 2 - (n : ℝ)) := by
  intro P n v
  classical
  -- `V eₐ = vₐ` and the symmetric operator `S = V*V` on `ℝⁿ`
  let b := EuclideanSpace.basisFun (Fin n) ℝ
  let V : EuclideanSpace ℝ (Fin n) →ₗ[ℝ] Euclid P := b.toBasis.constr ℝ v
  let S := LinearMap.adjoint V ∘ₗ V
  have hS : S.IsSymmetric := LinearMap.isSymmetric_adjoint_comp_self V
  have hn : Module.finrank ℝ (EuclideanSpace ℝ (Fin n)) = n := finrank_euclideanSpace_fin
  have hVe : ∀ a, V (b a) = v a := by
    intro a
    have := b.toBasis.constr_basis ℝ v a
    rw [OrthonormalBasis.coe_toBasis] at this
    exact this
  have hSinner : ∀ x y, inner ℝ x (S y) = inner ℝ (V x) (V y) := by
    intro x y
    simp [S, LinearMap.adjoint_inner_right]
  -- the matrix of `S` is the Gram matrix, and `trace S = Σₐ |vₐ|²`
  have hmat :
      LinearMap.toMatrix b.toBasis b.toBasis S = Matrix.of fun i j => inner ℝ (v i) (v j) := by
    ext i j
    rw [LinearMap.toMatrix_apply, OrthonormalBasis.coe_toBasis_repr_apply,
      OrthonormalBasis.repr_apply_apply, OrthonormalBasis.coe_toBasis, hSinner, hVe, hVe]
    rfl
  have hdet : LinearMap.det S = Matrix.det (Matrix.of fun i j => inner ℝ (v i) (v j)) := by
    rw [← LinearMap.det_toMatrix b.toBasis, hmat]
  have htr : LinearMap.trace ℝ _ S = ∑ a, ‖v a‖ ^ 2 := by
    rw [LinearMap.trace_eq_sum_inner S b]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [hSinner, hVe, real_inner_self_eq_norm_sq]
  -- spectral theorem: `det S = Πᵢ λᵢ`, `trace S = Σᵢ λᵢ`, with `λᵢ = ⟪uᵢ, S uᵢ⟫ = |V uᵢ|² ≥ 0`
  rw [← hdet, hS.det_eq_prod_eigenvalues hn, ← htr, hS.trace_eq_sum_eigenvalues hn]
  have hnonneg : ∀ i, 0 ≤ hS.eigenvalues hn i := by
    intro i
    have h1 := hS.apply_eigenvectorBasis hn i
    have hu : ‖hS.eigenvectorBasis hn i‖ = 1 := (hS.eigenvectorBasis hn).orthonormal.1 i
    have h2 : inner ℝ (hS.eigenvectorBasis hn i) (S (hS.eigenvectorBasis hn i)) =
        hS.eigenvalues hn i := by
      rw [h1, inner_smul_right, real_inner_self_eq_norm_sq, hu]
      simp
    rw [← h2, hSinner]
    exact real_inner_self_nonneg
  -- `0 ≤ λᵢ ≤ e^{λᵢ − 1}`, multiplied over `i`
  simp only [RCLike.ofReal_real_eq_id, id]
  calc ∏ i, hS.eigenvalues hn i ≤ ∏ i, Real.exp (hS.eigenvalues hn i - 1) := by
        refine Finset.prod_le_prod₀ (fun i _ => hnonneg i) (fun i _ => ?_)
        have := Real.add_one_le_exp (hS.eigenvalues hn i - 1)
        linarith
    _ = Real.exp (∑ i, hS.eigenvalues hn i - n) := by
        rw [← Real.exp_sum, Finset.sum_sub_distrib]
        simp

/-- **First-order Jacobian bound** (Simon Ch. 2, §5, where `J_t = 1 + t div_M X + O(t²)` gives the
first variation formula 5.3; here only `‖L − I − tB‖ ≤ η|t|` is assumed): for `|t| < δ`,
`‖B‖ ≤ A` and orthonormal `τ₁, …, τₙ`, `(det(Lτᵢ · Lτⱼ))^{1/2} ≤ 1 + t Σₐ τₐ · Bτₐ + ε|t|`.
With `D = Σₐ τₐ · Bτₐ`, the frame bound gives `|D| ≤ nA` and
`Σₐ |Lτₐ|² − n ≤ 2tD + 2nη|t| + n(A + 1)²t²`, so the Gram determinant bound gives
`det G ≤ exp(2tD + 2nη|t| + n(A + 1)²t²)`; the scalar bound (which supplies `0 < η ≤ 1` and
`δ`) turns this into the claim. -/
theorem Submission.fvmb_orthonormal_gram_sqrt_det_le_first_order : ∀ (P n : ℕ) (A ε : ℝ), 0 ≤ A → 0 < ε → ∃ η : ℝ, 0 < η ∧ ∃ δ : ℝ, 0 < δ ∧ ∀ t : ℝ, |t| < δ → ∀ B L : Euclid P →L[ℝ] Euclid P, ‖B‖ ≤ A → ‖L - ContinuousLinearMap.id ℝ (Euclid P) - t • B‖ ≤ η * |t| → ∀ τ : Fin n → Euclid P, Orthonormal ℝ τ → Real.sqrt (Matrix.det (Matrix.of fun i j => inner ℝ (L (τ i)) (L (τ j)))) ≤ 1 + t * ∑ a, inner ℝ (τ a) (B (τ a)) + ε * |t| := by
  intro P n A ε hA hε
  -- `0 < η ≤ 1` and `δ` depend only on `n`, `A` and `ε`
  obtain ⟨η, hη, hη1, δ, hδ, hsqrt⟩ := Submission.fvmb_sqrt_le_first_order_of_le_exp n A ε hA hε
  refine ⟨η, hη, δ, hδ, fun t ht B L hB hL τ hτ => ?_⟩
  -- `|D| ≤ nA` and `Σₐ |Lτₐ|² − n ≤ 2tD + 2nη|t| + n(A + 1)²t²`
  obtain ⟨hD, htr⟩ :=
    Submission.fvmb_perturbed_frame_sum_norm_sq_sub_le P n A η t B L τ hη1 hB hL hτ
  refine hsqrt t _ _ ht hD ?_
  -- `det G ≤ exp(Σₐ |Lτₐ|² − n) ≤ exp(2tD + 2nη|t| + n(A + 1)²t²)`
  exact (Submission.fvmb_gram_det_le_exp_sum_norm_sq_sub P n fun a => L (τ a)).trans
    (Real.exp_le_exp.mpr htr)
/-- **Simon Ch. 2, (4.18)–(4.20)** (tangential divergence in an orthonormal frame): if `τ₁, …, τₙ`
is an orthonormal basis of `Q`, then `trace(p_Q ∘ B) = Σₐ τₐ · Bτₐ`.  The orthogonality
characterization of the projection gives `p_Q z = Σₐ (τₐ · z) τₐ`, so `p_Q ∘ B` is the sum of the
rank-one maps `z ↦ (τₐ · Bz) τₐ`, and the trace of `z ↦ ℓ(z) v` is `ℓ(v)`. -/
theorem Submission.fvmb_trace_starProjection_comp_eq_sum_inner : ∀ (P n : ℕ) (Q : Submodule ℝ (Euclid P)) (τ : Fin n → Euclid P) (B : Euclid P →L[ℝ] Euclid P), Orthonormal ℝ τ → Submodule.span ℝ (Set.range τ) = Q → LinearMap.trace ℝ (Euclid P) (Q.starProjection.toLinearMap ∘ₗ B.toLinearMap) = ∑ a, inner ℝ (τ a) (B (τ a)) := by
  intro P n Q τ B hτ hQ
  -- `p_Q z = Σₐ ⟪τₐ, z⟫ τₐ`: the right side lies in `Q` and `z` minus it is orthogonal to `Q`
  have hproj : ∀ z : Euclid P, Q.starProjection z = ∑ a, inner ℝ (τ a) z • τ a := by
    intro z
    apply Submodule.eq_starProjection_of_mem_of_inner_eq_zero
    · rw [← hQ]
      exact Submodule.sum_mem _ fun a _ =>
        Submodule.smul_mem _ _ (Submodule.subset_span ⟨a, rfl⟩)
    · intro q hq
      rw [← hQ] at hq
      induction hq using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨b, rfl⟩ := hx
        rw [inner_sub_left, hτ.inner_left_fintype, real_inner_comm]
        simp
      | zero => simp
      | add x y _ _ hx hy => rw [inner_add_right, hx, hy, add_zero]
      | smul c x _ hx => rw [inner_smul_right, hx, mul_zero]
  -- `p_Q ∘ B = Σₐ (z ↦ ⟪τₐ, Bz⟫ τₐ)`
  have hdecomp : Q.starProjection.toLinearMap ∘ₗ B.toLinearMap =
      ∑ a, ((innerₛₗ ℝ (τ a)) ∘ₗ B.toLinearMap).smulRight (τ a) := by
    ext z
    simp [hproj]
  -- `trace (z ↦ ℓ(z) v) = ℓ(v)` (`LinearMap.trace_smulRight`), summed over `a`
  rw [hdecomp, map_sum]
  simp
/-- **Simon 6.3.1, Ch. 3 Remark 1.5(1)**: for `Hⁿ`-a.e. `x ∈ M`, the orientation `ξ(x)` of an
integer multiplicity triple `(M, θ, ξ)` orients the chosen approximate tangent plane `TₓM`.
`R.orients` gives, a.e. on `M`, an approximate tangent plane `Q` at `x` oriented by `ξ(x)`; the
chosen witness `approxTangentPlane n M x` is then `Q`, approximate tangent planes being unique. -/
theorem Submission.fvmb_imrep_ae_unitOrientation_approxTangentPlane : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), IsUnitOrientationOf (R.orient x) (approxTangentPlane n R.carrier x) := by
  intro P n U R
  filter_upwards [R.orients] with x hx
  obtain ⟨Q, hQ, hξ⟩ := hx
  -- the chosen witness of `∃ Q', HasApproximateTangentSpaceAt n M x Q'` is `Q`
  have h : ∃ Q', HasApproximateTangentSpaceAt n R.carrier x Q' := ⟨Q, hQ⟩
  have hT : approxTangentPlane n R.carrier x = Q := by
    rw [approxTangentPlane, dite_eq_left h]
    exact h.choose_spec.unique hQ
  rw [hT]
  exact hξ
/-- **Simon Ch. 2, 5.9; Ch. 4, 2.7**: the tangential divergence of the normal part of `X`.  If
`Q ≤ S`, `pr(x) = P_S`, `pr` and `X` are differentiable at `x` and `Y = X − pr·X` near `x`, then
`trace(p_Q ∘ DY(x)) = −X(x) · Σⱼ (Dpr(x)(p_Q eⱼ))^* (p_Q eⱼ)`: by the product rule
`DY(x) = DX(x) − P_S DX(x) − (Dpr(x)·)X(x)`, `trace(p_Q ∘ C) = Σⱼ ⟨p_Q eⱼ, C (p_Q eⱼ)⟩`, and `P_S`
fixes `p_Q eⱼ ∈ Q ⊆ S`. -/
theorem Submission.mcs_trace_normal_part_eq_neg_inner : ∀ (P : ℕ) (Q S : Submodule ℝ (Euclid P)) (pr : Euclid P → (Euclid P →L[ℝ] Euclid P)) (X Y : Euclid P → Euclid P) (x : Euclid P), Q ≤ S → pr x = S.starProjection → DifferentiableAt ℝ pr x → DifferentiableAt ℝ X x → Y =ᶠ[𝓝 x] (fun y => X y - pr y (X y)) → LinearMap.trace ℝ (Euclid P) (Q.starProjection.toLinearMap ∘ₗ (fderiv ℝ Y x).toLinearMap) = -inner ℝ (X x) (∑ j : Fin P, ContinuousLinearMap.adjoint (fderiv ℝ pr x (Q.starProjection (EuclideanSpace.single j 1))) (Q.starProjection (EuclideanSpace.single j 1))) := by
  intro P Q S pr X Y x hQS hprx hpr hX hY
  -- Step 1: `DY(x)h = DX(x)h − P_S(DX(x)h) − (Dpr(x)h)(X(x))`
  have hDY : ∀ h, fderiv ℝ Y x h =
      fderiv ℝ X x h - S.starProjection (fderiv ℝ X x h) - fderiv ℝ pr x h (X x) := by
    intro h
    rw [hY.fderiv_eq, fderiv_fun_sub hX (hpr.clm_apply hX), fderiv_clm_apply hpr hX, hprx]
    simp only [sub_add_eq_sub_sub, sub_apply, ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.flip_apply]
  -- Step 2: `trace(p ∘ C) = Σⱼ ⟨p eⱼ, C (p eⱼ)⟩`
  have htr : ∀ C : Euclid P →L[ℝ] Euclid P,
      LinearMap.trace ℝ (Euclid P) (Q.starProjection.toLinearMap ∘ₗ C.toLinearMap) =
        ∑ j : Fin P, inner ℝ (Q.starProjection (EuclideanSpace.single j 1))
          (C (Q.starProjection (EuclideanSpace.single j 1))) := by
    intro C
    have hpp : Q.starProjection.toLinearMap ∘ₗ C.toLinearMap =
        Q.starProjection.toLinearMap ∘ₗ (Q.starProjection.toLinearMap ∘ₗ C.toLinearMap) := by
      refine LinearMap.ext fun w => ?_
      simp only [LinearMap.comp_apply, ContinuousLinearMap.coe_coe]
      exact (Submodule.starProjection_eq_self_iff.mpr (Q.starProjection_apply_mem (C w))).symm
    rw [hpp, LinearMap.trace_comp_comm',
      LinearMap.trace_eq_sum_inner _ (EuclideanSpace.basisFun (Fin P) ℝ)]
    refine Finset.sum_congr rfl fun j _ => ?_
    simp only [EuclideanSpace.basisFun_apply, LinearMap.comp_apply, ContinuousLinearMap.coe_coe]
    exact (Submodule.inner_starProjection_left_eq_right Q _ _).symm
  -- Steps 3 and 4: each term is `−⟨X(x), (Dpr(x)u)^* u⟩`, `u = p eⱼ ∈ Q ⊆ S`
  rw [htr, inner_sum, ← Finset.sum_neg_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  set u := Q.starProjection (EuclideanSpace.single j 1)
  have huS : S.starProjection u = u :=
    Submodule.starProjection_eq_self_iff.mpr (hQS (Submodule.starProjection_apply_mem _ _))
  rw [hDY, inner_sub_right, inner_sub_right, ← Submodule.inner_starProjection_left_eq_right, huS,
    sub_self, zero_sub, ← ContinuousLinearMap.adjoint_inner_left (fderiv ℝ pr x u) (X x) u,
    real_inner_comm]
/-- **Simon Ch. 4, 2.7** (the tangential part `Xᵀ = χ · pr · X`): let `U, O ⊆ ℝᴾ` be open,
`N ⊆ O` with `(N̄ \ N) ∩ U = ∅`, `pr` of class `C¹` on `O` and `X ∈ C¹_c(U; ℝᴾ)`.  Then some
`Xᵀ ∈ C¹_c(U; ℝᴾ)` equals `y ↦ pr(y) X(y)` near every point of `N`.  The compact set
`K = spt X ∩ N̄` lies in `N` (as `(N̄ \ N) ∩ U = ∅`), hence in `O ∩ U`; take a `C¹` cutoff `χ` with
compact support in `O ∩ U` and `χ = 1` near `K`.  Near `x ∈ N`, `χ = 1` if `x ∈ spt X`, and
`X = 0` otherwise. -/
theorem Submission.mcs_exists_c1_field_eq_proj_near : ∀ (P : ℕ) (U N O : Set (Euclid P)) (pr : Euclid P → (Euclid P →L[ℝ] Euclid P)) (X : Euclid P → Euclid P), IsOpen U → IsOpen O → N ⊆ O → ContDiffOn ℝ 1 pr O → (closure N \ N) ∩ U = ∅ → ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ U → ∃ XT : Euclid P → Euclid P, ContDiff ℝ 1 XT ∧ HasCompactSupport XT ∧ tsupport XT ⊆ U ∧ ∀ x ∈ N, XT =ᶠ[𝓝 x] (fun y => pr y (X y)) := by
  intro P U N O pr X hU hO hNO hpr hN hX hXc hXU
  -- Step 1: `K = spt X ∩ N̄` is compact and `K ⊆ N`, hence `K ⊆ W = O ∩ U`
  have hKc : IsCompact (tsupport X ∩ closure N) := hXc.isCompact.inter_right isClosed_closure
  have hKW : tsupport X ∩ closure N ⊆ O ∩ U := by
    rintro z ⟨hzX, hzN⟩
    have hz : z ∈ N := by
      by_contra hz
      exact eq_empty_iff_forall_notMem.1 hN z ⟨⟨hzN, hz⟩, hXU hzX⟩
    exact ⟨hNO hz, hXU hzX⟩
  -- Step 2: a `C¹` cutoff `χ` with `spt χ = V̄ ⊆ W` compact and `χ = 1` on `L`, `K ⊆ int L`
  obtain ⟨L, hLc, hLcl, hKL, hLW⟩ := exists_compact_closed_between hKc (hO.inter hU) hKW
  obtain ⟨V, hVo, hLV, hVW, hVc⟩ :=
    exists_open_between_and_isCompact_closure hLc (hO.inter hU) hLW
  obtain ⟨χ, hχ, -, hχV, hχL⟩ := exists_contDiff_support_eq_eq_one_iff (n := 1) hVo hLcl hLV
  have hχ1 : ContDiff ℝ 1 χ := by exact_mod_cast hχ
  have hχt : tsupport χ = closure V := by rw [tsupport, hχV]
  -- Step 3: `Xᵀ = χ · pr · X`
  refine ⟨fun y => χ y • pr y (X y), ?_, ?_, ?_, ?_⟩
  -- Step 4: `Xᵀ` is `C¹`: product rule at points of `O`; `Xᵀ = 0` near `y ∉ O`, as `spt χ ⊆ O`
  · rw [contDiff_iff_contDiffAt]
    intro y
    by_cases hy : y ∈ O
    · exact hχ1.contDiffAt.smul ((hpr.contDiffAt (hO.mem_nhds hy)).clm_apply hX.contDiffAt)
    · have hyχ : χ =ᶠ[𝓝 y] 0 := by
        rw [← notMem_tsupport_iff_eventuallyEq, hχt]
        exact fun h => hy (hVW h).1
      refine (contDiffAt_const (c := (0 : Euclid P))).congr_of_eventuallyEq ?_
      filter_upwards [hyχ] with z hz
      simp [hz]
  -- Step 5: `Xᵀ` vanishes off the compact set `V̄`, and `spt Xᵀ ⊆ spt χ = V̄ ⊆ W ⊆ U`
  · refine HasCompactSupport.intro' hVc isClosed_closure fun y hy => ?_
    have hχy : χ y = 0 := by
      rw [← notMem_support, hχV]
      exact fun h => hy (subset_closure h)
    simp [hχy]
  · refine (tsupport_smul_subset_left χ fun y => pr y (X y)).trans ?_
    rw [hχt]
    exact fun z hz => (hVW hz).2
  -- Step 6: `Xᵀ = pr · X` near `x ∈ N`: `χ = 1` near `x` if `x ∈ spt X`, else `X = 0` near `x`
  · intro x hx
    by_cases hxX : x ∈ tsupport X
    · filter_upwards [isOpen_interior.mem_nhds (hKL ⟨hxX, subset_closure hx⟩)] with y hy
      rw [(hχL y).1 (interior_subset hy), one_smul]
    · filter_upwards [notMem_tsupport_iff_eventuallyEq.1 hxX] with y hy
      simp [hy]
/-- **Simon Ch. 4, 2.2–2.3** (additivity of the first variation of `V = v(M, θ)`): if
`x ↦ p_{TₓM}` is `Hⁿ⌞M`-measurable and `X, Y ∈ C¹_c(U; ℝᴾ)`, then `δV(X + Y) = δV(X) + δV(Y)`.
For `Z ∈ C¹_c(U; ℝᴾ)`, `θ div_M Z` is `Hⁿ⌞M`-integrable: `div_M Z(x) = tr(pₓ ∘ DZ(x))` is
measurable, `|div_M Z| ≤ ‖tr‖ sup ‖DZ‖` on `spt Z` and `div_M Z = 0` off `spt Z`, and `θ` is
integrable on the compact `spt Z ⊆ U`.  Pointwise `D(X + Y) = DX + DY` and the trace is linear, so
`div_M (X + Y) = div_M X + div_M Y`; integrate. -/
theorem Submission.mcs_firstVariation_add : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (X Y : Euclid P → Euclid P), AEStronglyMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) (μHE[n].restrict R.carrier) → ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ U → ContDiff ℝ 1 Y → HasCompactSupport Y → tsupport Y ⊆ U → R.firstVariation (X + Y) = R.firstVariation X + R.firstVariation Y := by
  intro P n U R X Y hp hX hXc hXU hY hYc hYU
  -- Step 1: the trace is a continuous linear functional on `L(ℝᴾ, ℝᴾ)`, and
  -- `div_M Z(x) = tr(pₓ ∘ DZ(x))`
  let tr : (Euclid P →L[ℝ] Euclid P) →L[ℝ] ℝ := LinearMap.toContinuousLinearMap
    ((LinearMap.trace ℝ (Euclid P)).comp (ContinuousLinearMap.coeLM ℝ))
  have hdiv : ∀ (Z : Euclid P → Euclid P) (x : Euclid P), tangentialDivergence n R.carrier Z x =
      tr ((approxTangentPlane n R.carrier x).starProjection ∘L fderiv ℝ Z x) := fun _ _ => rfl
  have hθ : Measurable fun x => (R.mult x : ℝ) := measurable_from_nat.comp R.measurable_mult
  have hθ' : Measurable fun x => (R.mult x : ℝ≥0∞) := measurable_from_nat.comp R.measurable_mult
  -- Step 2: `θ div_M Z` is `Hⁿ⌞M`-integrable for `Z ∈ C¹_c(U; ℝᴾ)`
  have hint : ∀ Z : Euclid P → Euclid P, ContDiff ℝ 1 Z → HasCompactSupport Z → tsupport Z ⊆ U →
      Integrable (fun x => (R.mult x : ℝ) * tangentialDivergence n R.carrier Z x)
        (μHE[n].restrict R.carrier) := by
    intro Z hZ hZc hZU
    have hD : Continuous (fderiv ℝ Z) := hZ.continuous_fderiv one_ne_zero
    -- Step 2(a): `div_M Z` is a.e. strongly measurable (`p` measurable, `DZ` continuous)
    have hmeas : AEStronglyMeasurable (fun x => tangentialDivergence n R.carrier Z x)
        (μHE[n].restrict R.carrier) :=
      (tr.continuous.comp isBoundedBilinearMap_comp.continuous).comp_aestronglyMeasurable₂
        (g := fun p D : Euclid P →L[ℝ] Euclid P => tr (p ∘L D)) hp hD.aestronglyMeasurable
    -- Step 2(b): `|θ div_M Z| ≤ ‖tr‖ C θ 1_K`, `K = spt Z`, `C = sup ‖DZ‖`
    obtain ⟨C, hC⟩ := hD.bounded_above_of_compact_support (hZc.fderiv ℝ)
    have hKm : MeasurableSet (tsupport Z) := (isClosed_tsupport Z).measurableSet
    have hbound : ∀ x, ‖(R.mult x : ℝ) * tangentialDivergence n R.carrier Z x‖ ≤
        (tsupport Z).indicator (fun x => ‖tr‖ * C * (R.mult x : ℝ)) x := by
      intro x
      rw [norm_mul, Real.norm_natCast, hdiv]
      by_cases hxK : x ∈ tsupport Z
      · rw [Set.indicator_of_mem hxK, mul_comm (R.mult x : ℝ)]
        refine mul_le_mul_of_nonneg_right ?_ (Nat.cast_nonneg _)
        refine (tr.le_opNorm _).trans (mul_le_mul_of_nonneg_left ?_ (norm_nonneg tr))
        refine (ContinuousLinearMap.opNorm_comp_le _ _).trans ?_
        simpa using mul_le_mul (Submodule.starProjection_norm_le _) (hC x) (norm_nonneg _)
          zero_le_one
      · rw [Set.indicator_of_notMem hxK, fderiv_of_notMem_tsupport ℝ hxK,
          ContinuousLinearMap.comp_zero, map_zero, norm_zero, mul_zero]
    -- Step 2(c): `θ` is `Hⁿ⌞M`-integrable on `K`, since `∫_{M ∩ K} θ dHⁿ < ∞`
    have hθK : IntegrableOn (fun x => (R.mult x : ℝ)) (tsupport Z) (μHE[n].restrict R.carrier) := by
      rw [IntegrableOn, Measure.restrict_restrict hKm, Set.inter_comm]
      simpa using integrable_toReal_of_lintegral_ne_top hθ'.aemeasurable
        (R.locallyIntegrable_mult _ hZc hZU)
    exact ((integrable_indicator_iff hKm).2 (Integrable.const_mul hθK (‖tr‖ * C))).mono'
      (hθ.aestronglyMeasurable.mul hmeas) (ae_of_all _ hbound)
  -- Step 3: `div_M (X + Y) = div_M X + div_M Y` pointwise
  have hadd : ∀ x, tangentialDivergence n R.carrier (X + Y) x =
      tangentialDivergence n R.carrier X x + tangentialDivergence n R.carrier Y x := by
    intro x
    rw [hdiv, hdiv, hdiv, fderiv_add (hX.differentiable one_ne_zero x)
      (hY.differentiable one_ne_zero x), ContinuousLinearMap.comp_add, map_add]
  -- Step 4: integrate, by `integral_add`
  simp only [IMRep.firstVariation, hadd, mul_add]
  exact integral_add (hint X hX hXc hXU) (hint Y hY hYc hYU)
/-- **Simon Ch. 4, 3.14–3.15**: the mean curvature field `H(x) = Σⱼ (Dpr(x)[p(x)eⱼ])^*(p(x)eⱼ)`
on `N ∩ U`, `H = 0` elsewhere, is `μ`-a.e. strongly measurable and bounded on compact `K ⊆ U`.
`N ∩ U = N̄ ∩ U` is Borel, `x ↦ (Dpr(x), p(x))` is a.e. strongly measurable and
`(B, q) ↦ Σⱼ (B(qeⱼ))^*(qeⱼ)` is continuous; for compact `K ⊆ U`, `K ∩ N̄ ⊆ N ⊆ O` is compact and
`Dpr` is continuous on the open `O`, so `‖H‖ ≤ P max(sup_{K ∩ N̄} ‖Dpr‖, 0)` on `K`. -/
theorem Submission.mcs_exists_meanCurvature_field : ∀ (P : ℕ) (μ : Measure (Euclid P)) (U N O : Set (Euclid P)) (pr p : Euclid P → (Euclid P →L[ℝ] Euclid P)), IsOpen U → IsOpen O → N ⊆ O → ContDiffOn ℝ 1 pr O → (closure N \ N) ∩ U = ∅ → AEStronglyMeasurable p μ → (∀ x, ‖p x‖ ≤ 1) → ∃ H : Euclid P → Euclid P, AEStronglyMeasurable H μ ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ∃ Λ : ℝ, ∀ x ∈ K, ‖H x‖ ≤ Λ) ∧ ∀ x ∈ N ∩ U, H x = ∑ j : Fin P, ContinuousLinearMap.adjoint (fderiv ℝ pr x (p x (EuclideanSpace.single j 1))) (p x (EuclideanSpace.single j 1)) := by
  intro P μ U N O pr p hU hO hNO hpr hNU hp hp1
  -- `F(B, q) = Σⱼ (B(qeⱼ))^*(qeⱼ)`, `eⱼ` the standard basis of `ℝᴾ`, is continuous
  let F : (Euclid P →L[ℝ] (Euclid P →L[ℝ] Euclid P)) × (Euclid P →L[ℝ] Euclid P) → Euclid P :=
    fun q => ∑ j : Fin P, ContinuousLinearMap.adjoint (q.1 (q.2 (EuclideanSpace.single j 1)))
      (q.2 (EuclideanSpace.single j 1))
  have hF : Continuous F := by
    refine continuous_finsetSum _ fun j _ => ?_
    have hq : Continuous fun q : (Euclid P →L[ℝ] (Euclid P →L[ℝ] Euclid P)) ×
        (Euclid P →L[ℝ] Euclid P) => q.2 (EuclideanSpace.single j 1) :=
      continuous_snd.clm_apply continuous_const
    exact (ContinuousLinearMap.adjoint.continuous.comp (continuous_fst.clm_apply hq)).clm_apply hq
  -- `N ∩ U = N̄ ∩ U` is Borel
  have hG : N ∩ U = closure N ∩ U := by
    refine Subset.antisymm (inter_subset_inter_left _ subset_closure) fun z hz => ⟨?_, hz.2⟩
    by_contra hzN
    have hz' : z ∈ (closure N \ N) ∩ U := ⟨⟨hz.1, hzN⟩, hz.2⟩
    rw [hNU] at hz'
    exact hz'
  have hGm : MeasurableSet (N ∩ U) := by
    rw [hG]
    exact isClosed_closure.measurableSet.inter hU.measurableSet
  -- `H = 1_{N ∩ U} F(Dpr, p)`
  refine ⟨(N ∩ U).indicator fun x => F (fderiv ℝ pr x, p x), ?_, ?_,
    fun x hx => indicator_of_mem hx _⟩
  · exact (hF.comp_aestronglyMeasurable
      ((measurable_fderiv ℝ pr).aestronglyMeasurable.prodMk hp)).indicator hGm
  -- `‖Dpr‖ ≤ C` on the compact `K ∩ N̄ ⊆ N ⊆ O`, so `‖H‖ ≤ P max(C, 0)` on `K`
  intro K hK hKU
  have hKN : K ∩ closure N ⊆ N ∩ U := fun x hx => by
    rw [hG]
    exact ⟨hx.2, hKU hx.1⟩
  obtain ⟨C, hC⟩ := (hK.inter_right isClosed_closure).exists_bound_of_continuousOn
    ((hpr.continuousOn_fderiv_of_isOpen hO le_rfl).mono fun x hx => hNO (hKN hx).1)
  refine ⟨P * max C 0, fun x hxK => ?_⟩
  by_cases hx : x ∈ N ∩ U
  · rw [indicator_of_mem hx]
    have hDx : ‖fderiv ℝ pr x‖ ≤ max C 0 :=
      (hC x ⟨hxK, subset_closure hx.1⟩).trans (le_max_left _ _)
    have hj : ∀ j : Fin P, ‖ContinuousLinearMap.adjoint
        (fderiv ℝ pr x (p x (EuclideanSpace.single j 1))) (p x (EuclideanSpace.single j 1))‖ ≤
        max C 0 := by
      intro j
      have hu : ‖p x (EuclideanSpace.single j 1)‖ ≤ 1 :=
        calc ‖p x (EuclideanSpace.single j 1)‖
            ≤ ‖p x‖ * ‖(EuclideanSpace.single j 1 : Euclid P)‖ := (p x).le_opNorm _
          _ = ‖p x‖ := by simp
          _ ≤ 1 := hp1 x
      calc ‖ContinuousLinearMap.adjoint (fderiv ℝ pr x (p x (EuclideanSpace.single j 1)))
              (p x (EuclideanSpace.single j 1))‖
          ≤ ‖ContinuousLinearMap.adjoint (fderiv ℝ pr x (p x (EuclideanSpace.single j 1)))‖ *
              ‖p x (EuclideanSpace.single j 1)‖ := ContinuousLinearMap.le_opNorm _ _
        _ = ‖fderiv ℝ pr x (p x (EuclideanSpace.single j 1))‖ *
              ‖p x (EuclideanSpace.single j 1)‖ := by rw [LinearIsometryEquiv.norm_map]
        _ ≤ ‖fderiv ℝ pr x‖ * ‖p x (EuclideanSpace.single j 1)‖ *
              ‖p x (EuclideanSpace.single j 1)‖ :=
            mul_le_mul_of_nonneg_right (ContinuousLinearMap.le_opNorm _ _) (norm_nonneg _)
        _ ≤ max C 0 * 1 * 1 := by gcongr
        _ = max C 0 := by ring
    calc ‖F (fderiv ℝ pr x, p x)‖
        ≤ ∑ j : Fin P, ‖ContinuousLinearMap.adjoint
            (fderiv ℝ pr x (p x (EuclideanSpace.single j 1))) (p x (EuclideanSpace.single j 1))‖ :=
          norm_sum_le _ _
      _ ≤ ∑ _j : Fin P, max C 0 := Finset.sum_le_sum fun j _ => hj j
      _ = P * max C 0 := by simp
  · rw [indicator_of_notMem hx, norm_zero]
    exact mul_nonneg (Nat.cast_nonneg _) (le_max_right _ _)
/-- **Flatness of a submanifold at a chart point** (step 2 of the approximate-tangent-space
argument; Simon Ch. 2, 4.1–4.3).  Let `ψ : V → W` be a 1:1 `C¹` map with `ψ(V) = W ∩ N`, proper
into `W`, and `Dψ(v)` injective.  Then near `ψ(v)` every `z ∈ N` lies within `ε|z − ψ(v)|` of
`ψ(v) + range Dψ(v)`.  Properness, continuity and injectivity of `ψ` force `z = ψ(β)` with `β`
close to `v`; the first-order expansion at `v` and the coercivity `|h| ≤ K|Dψ(v)h|` then absorb
the remainder. -/
theorem Submission.atsm_chart_image_flat : ∀ (P d : ℕ) (N W : Set (Euclid P)) (V : Set (Euclid d)) (ψ : Euclid d → Euclid P) (v : Euclid d), IsOpen V → IsOpen W → ContDiffOn ℝ 1 ψ V → InjOn ψ V → ψ '' V = W ∩ N → (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → Injective (fderiv ℝ ψ v) → v ∈ V → ∀ ε : ℝ, 0 < ε → ∃ ρ : ℝ, 0 < ρ ∧ ∀ z ∈ N, dist z (ψ v) < ρ → ∃ h : Euclid d, ‖z - ψ v - fderiv ℝ ψ v h‖ ≤ ε * ‖z - ψ v‖ := by
  intro P d N W V ψ v hV hW hψ hinj himg hprop hLinj hv ε hε
  set L := fderiv ℝ ψ v with hLdef
  have hdiff : DifferentiableAt ℝ ψ v :=
    (hψ.differentiableOn one_ne_zero).differentiableAt (hV.mem_nhds hv)
  have hL : HasFDerivAt ψ L v := hdiff.hasFDerivAt
  have hcont : ContinuousOn ψ V := hψ.continuousOn
  have hψvW : ψ v ∈ W := by
    have : ψ v ∈ ψ '' V := mem_image_of_mem ψ hv
    rw [himg] at this
    exact this.1
  -- coercivity of the injective derivative
  obtain ⟨K, hKpos, hK⟩ := LinearMap.exists_antilipschitzWith (L : Euclid d →ₗ[ℝ] Euclid P)
    (LinearMap.ker_eq_bot.mpr hLinj)
  have hcoer : ∀ h : Euclid d, ‖h‖ ≤ K * ‖L h‖ := fun h =>
    ContinuousLinearMap.bound_of_antilipschitz L hK h
  have hK0 : (0 : ℝ) < K := by exact_mod_cast hKpos
  set η : ℝ := min (1 / (2 * K)) (ε / (2 * K)) with hηdef
  have hη : 0 < η := lt_min (by positivity) (by positivity)
  have hηK : η * K ≤ 1 / 2 := by
    calc η * K ≤ 1 / (2 * K) * K := by gcongr; exact min_le_left _ _
      _ = 1 / 2 := by field_simp
  have hηε : η * (2 * K) ≤ ε := by
    calc η * (2 * K) ≤ ε / (2 * K) * (2 * K) := by gcongr; exact min_le_right _ _
      _ = ε := by field_simp
  -- first-order expansion
  obtain ⟨σ, hσ, hσball⟩ := Metric.eventually_nhds_iff.1 (hL.isLittleO.bound hη)
  -- a compact set away from v
  obtain ⟨δ₁, hδ₁, hδ₁W⟩ := Metric.isOpen_iff.1 hW (ψ v) hψvW
  set δ₀ : ℝ := δ₁ / 2 with hδ₀def
  have hδ₀ : 0 < δ₀ := by positivity
  have hcbW : closedBall (ψ v) δ₀ ⊆ W := (closedBall_subset_ball (by linarith)).trans hδ₁W
  have hA : IsCompact (V ∩ ψ ⁻¹' closedBall (ψ v) δ₀) := hprop _ hcbW (isCompact_closedBall _ _)
  set C := (V ∩ ψ ⁻¹' closedBall (ψ v) δ₀) \ ball v σ with hCdef
  have hC : IsCompact C := hA.diff isOpen_ball
  have hCV : C ⊆ V := fun β hβ => hβ.1.1
  -- positive separation on C
  obtain ⟨m, hm, hmC⟩ : ∃ m : ℝ, 0 < m ∧ ∀ β ∈ C, m ≤ ‖ψ β - ψ v‖ := by
    rcases C.eq_empty_or_nonempty with hCe | hCne
    · refine ⟨1, one_pos, fun β hβ => ?_⟩
      rw [hCe] at hβ
      exact hβ.elim
    · have hfc : ContinuousOn (fun β => ‖ψ β - ψ v‖) C :=
        ((hcont.mono hCV).sub continuousOn_const).norm
      obtain ⟨β₀, hβ₀C, hβ₀min⟩ := hC.exists_isMinOn hCne hfc
      refine ⟨‖ψ β₀ - ψ v‖, ?_, fun β hβ => (isMinOn_iff.mp hβ₀min) β hβ⟩
      rcases (norm_nonneg (ψ β₀ - ψ v)).lt_or_eq with hlt | heq
      · exact hlt
      · exfalso
        have h0 : ψ β₀ = ψ v := by
          have h' := heq.symm
          rwa [norm_eq_zero, sub_eq_zero] at h'
        have hβv := hinj (hCV hβ₀C) hv h0
        apply hβ₀C.2
        rw [hβv]
        exact mem_ball_self hσ
  refine ⟨min δ₀ m, lt_min hδ₀ hm, ?_⟩
  intro z hzN hzd
  have hzcb : z ∈ closedBall (ψ v) δ₀ := mem_closedBall.2 (hzd.trans_le (min_le_left _ _)).le
  have hzim : z ∈ ψ '' V := by
    rw [himg]
    exact ⟨hcbW hzcb, hzN⟩
  obtain ⟨β, hβV, rfl⟩ := hzim
  have hβA : β ∈ V ∩ ψ ⁻¹' closedBall (ψ v) δ₀ := ⟨hβV, hzcb⟩
  have hβσ : dist β v < σ := by
    by_contra hcon
    have hβC : β ∈ C := ⟨hβA, fun hb => hcon (mem_ball.1 hb)⟩
    have h1 := hmC β hβC
    rw [← dist_eq_norm] at h1
    have h2 : min δ₀ m ≤ dist (ψ β) (ψ v) := (min_le_right _ _).trans h1
    linarith
  refine ⟨β - v, ?_⟩
  have hest : ‖ψ β - ψ v - L (β - v)‖ ≤ η * ‖β - v‖ := hσball hβσ
  have hLh : ‖L (β - v)‖ ≤ ‖ψ β - ψ v‖ + η * ‖β - v‖ := by
    calc ‖L (β - v)‖ = ‖(ψ β - ψ v) - (ψ β - ψ v - L (β - v))‖ := by congr 1; abel
      _ ≤ ‖ψ β - ψ v‖ + ‖ψ β - ψ v - L (β - v)‖ := norm_sub_le _ _
      _ ≤ ‖ψ β - ψ v‖ + η * ‖β - v‖ := by gcongr
  have hh : ‖β - v‖ ≤ 2 * K * ‖ψ β - ψ v‖ := by
    have h2 : ‖β - v‖ ≤ K * ‖ψ β - ψ v‖ + (η * K) * ‖β - v‖ := by
      calc ‖β - v‖ ≤ K * ‖L (β - v)‖ := hcoer (β - v)
        _ ≤ K * (‖ψ β - ψ v‖ + η * ‖β - v‖) := by gcongr
        _ = K * ‖ψ β - ψ v‖ + (η * K) * ‖β - v‖ := by ring
    have h3 : (η * K) * ‖β - v‖ ≤ 1 / 2 * ‖β - v‖ := by gcongr
    linarith
  calc ‖ψ β - ψ v - L (β - v)‖ ≤ η * ‖β - v‖ := hest
    _ ≤ η * (2 * K * ‖ψ β - ψ v‖) := by gcongr
    _ = (η * (2 * K)) * ‖ψ β - ψ v‖ := by ring
    _ ≤ ε * ‖ψ β - ψ v‖ := by gcongr
/-- **Simon Ch. 3, Definition 1.4 and Remark 1.5(1)**: an approximate tangent space of `M` at `x`
lies in every subspace `T` along which a set `N` carrying `Hⁿ`-almost all of `M` is flat at `x`
(for each `ε > 0` there is `ρ > 0` such that every `z ∈ N` with `|z − x| < ρ` has some `t ∈ T`
with `|z − x − t| ≤ ε|z − x|`).  If `q ∈ Q \ T`, put `δ = dist(q, T) > 0` and
`g = max(0, δ/2 − |· − q|) ∈ C_c(ℝᴾ)`; `∫_Q g dHⁿ > 0` because `spt(Hⁿ⌞Q) = Q`.  With
`ε = δ / (2(|q| + δ))` and `0 < r < ρ / (|q| + δ)`, flatness makes `g` vanish on `η_{x,r}(M ∩ N)`,
and `Hⁿ(η_{x,r}(M \ N)) = 0`; so `∫_{η_{x,r}(M)} g dHⁿ = 0` for all small `r`, contradicting
the defining limit. -/
theorem Submission.atsm_approxTangent_le_of_flat : ∀ (P n : ℕ) (N M : Set (Euclid P)) (x : Euclid P) (Q T : Submodule ℝ (Euclid P)), μHE[n] (M \ N) = 0 → (∀ ε : ℝ, 0 < ε → ∃ ρ : ℝ, 0 < ρ ∧ ∀ z ∈ N, dist z x < ρ → ∃ t ∈ T, ‖z - x - t‖ ≤ ε * ‖z - x‖) → HasApproximateTangentSpaceAt n M x Q → Q ≤ T := by
  intro P n N M x Q T hnull hflat hQ q hq
  by_contra hqT
  -- `T` is closed, so `δ = dist(q, T) > 0`
  have hTc : IsClosed (T : Set (Euclid P)) := T.closed_of_finiteDimensional
  have hδ : 0 < infDist q (T : Set (Euclid P)) :=
    (hTc.notMem_iff_infDist_pos ⟨0, T.zero_mem⟩).1 hqT
  set δ := infDist q (T : Set (Euclid P)) with hδdef
  -- the bump `g = max(0, δ/2 − |· − q|)`, positive exactly on `B_{δ/2}(q)`
  set g : Euclid P → ℝ := fun y => max 0 (δ / 2 - ‖y - q‖) with hgdef
  have hgc : Continuous g :=
    continuous_const.max (continuous_const.sub (continuous_id.sub continuous_const).norm)
  have hg0 : 0 ≤ g := fun y => le_max_left _ _
  have hgsupp : ∀ y, g y ≠ 0 → ‖y - q‖ < δ / 2 := by
    intro y hy
    by_contra h
    have h' : δ / 2 ≤ ‖y - q‖ := not_lt.mp h
    apply hy
    exact max_eq_left (by linarith)
  have hgpos : ∀ y, ‖y - q‖ < δ / 2 → 0 < g y := fun y hy =>
    lt_max_of_lt_right (by linarith)
  have hgcs : HasCompactSupport g := by
    apply HasCompactSupport.intro (isCompact_closedBall q (δ / 2))
    intro y hy
    by_contra h
    apply hy
    rw [mem_closedBall, dist_eq_norm]
    exact (hgsupp y h).le
  let f : CompactlySupportedContinuousMap (Euclid P) ℝ := ⟨⟨g, hgc⟩, hgcs⟩
  -- `∫_Q g dHⁿ > 0`: `Hⁿ⌞Q` is regular with support `Q ∋ q`
  have hQn : Module.finrank ℝ Q = n := hQ.1
  have := Poincare.SimonGMT.Chapter03.regular_euclideanHausdorffMeasure_restrict_submodule hQn
  have hsupp := Poincare.SimonGMT.Chapter03.support_euclideanHausdorffMeasure_restrict_submodule hQn
  have hint : Integrable g ((μHE[n] : Measure (Euclid P)).restrict (Q : Set (Euclid P))) :=
    hgc.integrable_of_hasCompactSupport hgcs
  have hpos : 0 < ∫ y in (Q : Set (Euclid P)), g y ∂μHE[n] := by
    rw [integral_pos_iff_support_of_nonneg hg0 hint]
    have hq' : q ∈ ((μHE[n] : Measure (Euclid P)).restrict (Q : Set (Euclid P))).support := by
      rw [hsupp]
      exact hq
    have hball : 0 < ((μHE[n] : Measure (Euclid P)).restrict (Q : Set (Euclid P)))
        (ball q (δ / 2)) :=
      (Measure.mem_support_iff_forall q).1 hq' _ (ball_mem_nhds q (by linarith))
    refine hball.trans_le (measure_mono ?_)
    intro y hy
    rw [mem_ball, dist_eq_norm] at hy
    exact (hgpos y hy).ne'
  -- constants: `ε (|q| + δ) = δ / 2`
  have hqδ : 0 < ‖q‖ + δ := by positivity
  set ε : ℝ := δ / (2 * (‖q‖ + δ)) with hεdef
  have hε : 0 < ε := by positivity
  have hεq : ε * (‖q‖ + δ) = δ / 2 := by
    rw [hεdef]
    field_simp
  obtain ⟨ρ, hρ, hflatρ⟩ := hflat ε hε
  -- `∫_{η_{x,r}(M)} g dHⁿ = 0` for `0 < r < ρ / (|q| + δ)`
  have hvan : ∀ r : ℝ, 0 < r → r < ρ / (‖q‖ + δ) →
      ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, f y ∂μHE[n] = 0 := by
    intro r hr hrρ
    -- `η_{x,r}(M \ N) = r⁻¹ (M \ N − x)` is `Hⁿ`-null
    have hnull' : μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' (M \ N)) = 0 := by
      have himg : Poincare.SimonGMT.Chapter03.blowUpMap x r '' (M \ N) =
          (fun y => r⁻¹ • y) '' ((fun y => y - x) '' (M \ N)) := by
        rw [Set.image_image]
        rfl
      have hiso : Isometry (fun y : Euclid P => y - x) :=
        Isometry.of_dist_eq fun a b => dist_sub_right a b x
      rw [himg, Set.image_smul, Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hr.ne'),
        hiso.euclideanHausdorffMeasure_image, hnull, smul_zero]
    -- flatness: `g` vanishes on `η_{x,r}(M ∩ N)`
    have hsub : {y | g y ≠ 0} ∩ Poincare.SimonGMT.Chapter03.blowUpMap x r '' M ⊆
        Poincare.SimonGMT.Chapter03.blowUpMap x r '' (M \ N) := by
      rintro y ⟨hgy, z, hzM, rfl⟩
      refine ⟨z, ⟨hzM, fun hzN => ?_⟩, rfl⟩
      have hyq : ‖Poincare.SimonGMT.Chapter03.blowUpMap x r z - q‖ < δ / 2 := hgsupp _ hgy
      set y := Poincare.SimonGMT.Chapter03.blowUpMap x r z with hy
      have hy' : y = r⁻¹ • (z - x) := rfl
      have hzx : z - x = r • y := by
        rw [hy', smul_smul, mul_inv_cancel₀ hr.ne', one_smul]
      have hynorm : ‖y‖ < ‖q‖ + δ / 2 := by
        calc ‖y‖ = ‖(y - q) + q‖ := by rw [sub_add_cancel]
          _ ≤ ‖y - q‖ + ‖q‖ := norm_add_le _ _
          _ < δ / 2 + ‖q‖ := by linarith
          _ = ‖q‖ + δ / 2 := by ring
      have hzxn : ‖z - x‖ = r * ‖y‖ := by
        rw [hzx, norm_smul, Real.norm_of_nonneg hr.le]
      have hdist : dist z x < ρ := by
        rw [dist_eq_norm, hzxn]
        calc r * ‖y‖ ≤ r * (‖q‖ + δ) := by gcongr; linarith
          _ < ρ / (‖q‖ + δ) * (‖q‖ + δ) := by gcongr
          _ = ρ := by field_simp
      obtain ⟨t, htT, ht⟩ := hflatρ z hzN hdist
      have hrt : r⁻¹ • t ∈ T := T.smul_mem _ htT
      have hyt : y - r⁻¹ • t = r⁻¹ • (z - x - t) := by
        rw [hy']
        exact (smul_sub _ _ _).symm
      have hyt' : ‖y - r⁻¹ • t‖ ≤ ε * ‖y‖ := by
        rw [hyt, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hr.le)]
        calc r⁻¹ * ‖z - x - t‖ ≤ r⁻¹ * (ε * ‖z - x‖) := by gcongr
          _ = ε * ‖y‖ := by rw [hzxn]; field_simp
      have hle : δ ≤ ‖q - r⁻¹ • t‖ := by
        rw [← dist_eq_norm]
        exact infDist_le_dist_of_mem hrt
      have h2 : ε * ‖y‖ ≤ δ / 2 := by
        rw [← hεq]
        gcongr
        linarith
      have hlt : ‖q - r⁻¹ • t‖ < δ := by
        calc ‖q - r⁻¹ • t‖ = ‖(q - y) + (y - r⁻¹ • t)‖ := by congr 1; abel
          _ ≤ ‖q - y‖ + ‖y - r⁻¹ • t‖ := norm_add_le _ _
          _ < δ / 2 + δ / 2 := by
            have h1 : ‖q - y‖ < δ / 2 := by rw [norm_sub_rev]; exact hyq
            linarith
          _ = δ := by ring
      linarith
    -- so `g = 0` a.e. for `Hⁿ⌞η_{x,r}(M)`, evaluated on the open set `{g ≠ 0}`
    have hopen : MeasurableSet {y | g y ≠ 0} :=
      (isOpen_ne_fun hgc continuous_const).measurableSet
    apply integral_eq_zero_of_ae
    rw [EventuallyEq, ae_iff]
    change (μHE[n].restrict (Poincare.SimonGMT.Chapter03.blowUpMap x r '' M)) {y | g y ≠ 0} = 0
    rw [Measure.restrict_apply hopen]
    exact measure_mono_null hsub hnull'
  -- the blow-up integrals of `g` are eventually `0`, so their limit `∫_Q g dHⁿ` is `0`
  have hlim := hQ.2 f
  have hev : (fun r : ℝ => ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, f y ∂μHE[n])
      =ᶠ[𝓝[>] 0] fun _ => 0 := by
    have hpos' : 0 < ρ / (‖q‖ + δ) := by positivity
    filter_upwards [Ioo_mem_nhdsGT hpos'] with r hr
    exact hvan r hr.1 hr.2
  have hlim0 : Tendsto (fun r : ℝ => ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M,
      f y ∂μHE[n]) (𝓝[>] 0) (𝓝 0) :=
    tendsto_const_nhds.congr' hev.symm
  have heq := tendsto_nhds_unique hlim hlim0
  have hzero : ∫ y in (Q : Set (Euclid P)), g y ∂μHE[n] = 0 := heq
  linarith
/-- **Secant estimate at a chart point** (Simon Ch. 2, §4, (4.1)–(4.3)).  Let `ψ(V) = W ∩ N`
with `W` open, `v ∈ V`, `Dψ(v) = A` injective, and let `ψ⁻¹` be continuous at `ψ(v)` on `ψ(V)`.
Then every `y ∈ N` near `ψ(v)` has some `a` with `|y − ψ(v) − Aa| ≤ ε|y − ψ(v)|`.

`A` is anti-Lipschitz, `|a| ≤ K|Aa|`.  With `η = min(1, ε)/(2K)`, differentiability gives
`|ψ(v') − ψ(v) − A(v' − v)| ≤ η|v' − v|` for `|v' − v| < ρ`, hence `|v' − v| ≤ 2K|ψ(v') − ψ(v)|`.
If `y ∈ N` and `|y − ψ(v)| < min(δ₁, δ₂)`, where `B_{δ₂}(ψ(v)) ⊆ W` and `δ₁` is the
inverse-continuity radius for `ρ`, then `y = ψ(v')` with `v' ∈ V`, `|v' − v| < ρ`, and
`a = v' − v` works. -/
theorem Submission.dsmc_chart_secant_estimate : ∀ (P d : ℕ) (N : Set (Euclid P)) (V : Set (Euclid d)) (W : Set (Euclid P)) (ψ : Euclid d → Euclid P) (A : Euclid d →L[ℝ] Euclid P) (v : Euclid d), IsOpen W → ψ '' V = W ∩ N → v ∈ V → HasFDerivAt ψ A v → Injective A → (∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ v' ∈ V, dist (ψ v') (ψ v) < δ → dist v' v < ε) → ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ y ∈ N, dist y (ψ v) < δ → ∃ a : Euclid d, ‖y - ψ v - A a‖ ≤ ε * ‖y - ψ v‖ := by
  intro P d N V W ψ A v hW hψV hv hA hinj hinv ε hε
  -- `A` is anti-Lipschitz: `‖a‖ ≤ K ‖A a‖`
  obtain ⟨K, hK, hKA⟩ := (A : Euclid d →ₗ[ℝ] Euclid P).injective_iff_antilipschitz.1 hinj
  have hbound : ∀ a : Euclid d, ‖a‖ ≤ K * ‖A a‖ := A.bound_of_antilipschitz hKA
  have hK0 : (0 : ℝ) < K := hK
  -- differentiability at `v` with `η = min 1 ε / (2K)`
  set η : ℝ := min 1 ε / (2 * K) with hη_eq
  have hmin : 0 < min 1 ε := lt_min one_pos hε
  have hη : 0 < η := div_pos hmin (by positivity)
  have hKη : K * η = min 1 ε / 2 := by
    rw [hη_eq]
    field_simp
  obtain ⟨ρ, hρ, hdiff⟩ := Metric.eventually_nhds_iff.1 (hA.isLittleO.bound hη)
  -- inverse continuity at radius `ρ`, and `B_{δ₂}(ψ v) ⊆ W`
  obtain ⟨δ₁, hδ₁, hδ₁V⟩ := hinv ρ hρ
  have hψv : ψ v ∈ W ∩ N := hψV ▸ mem_image_of_mem ψ hv
  obtain ⟨δ₂, hδ₂, hδ₂W⟩ := Metric.isOpen_iff.1 hW (ψ v) hψv.1
  refine ⟨min δ₁ δ₂, lt_min hδ₁ hδ₂, fun y hy hyd => ?_⟩
  -- `y = ψ v'` with `v' ∈ V` and `‖v' - v‖ < ρ`
  have hyW : y ∈ W := hδ₂W (mem_ball.2 (hyd.trans_le (min_le_right _ _)))
  obtain ⟨v', hv'V, rfl⟩ : y ∈ ψ '' V := hψV ▸ ⟨hyW, hy⟩
  have hv'ρ : dist v' v < ρ := hδ₁V v' hv'V (hyd.trans_le (min_le_left _ _))
  have hest : ‖ψ v' - ψ v - A (v' - v)‖ ≤ η * ‖v' - v‖ := hdiff hv'ρ
  refine ⟨v' - v, ?_⟩
  -- `‖v' - v‖ ≤ 2K ‖ψ v' - ψ v‖`
  have hlow : ‖v' - v‖ ≤ 2 * K * ‖ψ v' - ψ v‖ := by
    have htri : ‖A (v' - v)‖ ≤ ‖ψ v' - ψ v‖ + ‖ψ v' - ψ v - A (v' - v)‖ :=
      norm_le_norm_add_norm_sub _ _
    have h2 : (K : ℝ) * ‖A (v' - v)‖ ≤ K * ‖ψ v' - ψ v‖ + K * η * ‖v' - v‖ := by
      calc (K : ℝ) * ‖A (v' - v)‖ ≤ K * (‖ψ v' - ψ v‖ + η * ‖v' - v‖) :=
            mul_le_mul_of_nonneg_left (htri.trans (add_le_add le_rfl hest)) hK0.le
        _ = K * ‖ψ v' - ψ v‖ + K * η * ‖v' - v‖ := by ring
    rw [hKη] at h2
    have h3 : min 1 ε / 2 * ‖v' - v‖ ≤ 1 / 2 * ‖v' - v‖ :=
      mul_le_mul_of_nonneg_right (by linarith [min_le_left 1 ε]) (norm_nonneg _)
    linarith [hbound (v' - v)]
  calc ‖ψ v' - ψ v - A (v' - v)‖ ≤ η * ‖v' - v‖ := hest
    _ ≤ η * (2 * K * ‖ψ v' - ψ v‖) := mul_le_mul_of_nonneg_left hlow hη.le
    _ = 2 * (K * η) * ‖ψ v' - ψ v‖ := by ring
    _ = min 1 ε * ‖ψ v' - ψ v‖ := by rw [hKη]; ring
    _ ≤ ε * ‖ψ v' - ψ v‖ := mul_le_mul_of_nonneg_right (min_le_right _ _) (norm_nonneg _)
/-- **Simon Ch. 2, §4, (4.3)**, the inclusion `T_qN ⊆ A(ℝᵈ)`.  Suppose that for each `ε > 0`
every `y ∈ N` close to `q` has some `a ∈ ℝᵈ` with `|y − q − Aa| ≤ ε|y − q|`, and let `w = γ'(0)`.
`L = A(ℝᵈ)` is a finite-dimensional, hence closed, subspace.  The difference quotients
`s(t) = t⁻¹(γ(t) − q)` satisfy `dist(s(t), L) ≤ ε|s(t)|` for small `t`, and `s(t) → w`, so
`dist(w, L) ≤ ε|w|` for every `ε > 0`.  Thus `dist(w, L) = 0` and `w ∈ L`. -/
theorem Submission.dsmc_tangentSpace_subset_range_of_secant : ∀ (P d : ℕ) (N : Set (Euclid P)) (q : Euclid P) (A : Euclid d →L[ℝ] Euclid P), (∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ y ∈ N, dist y q < δ → ∃ a : Euclid d, ‖y - q - A a‖ ≤ ε * ‖y - q‖) → tangentSpace N q ⊆ Set.range A := by
  intro P d N q A hsec w hw
  obtain ⟨γ, -, hγN, hγ0, hγw⟩ := hw
  -- Step 1: `L = A(ℝᵈ)` is a closed (finite-dimensional) and nonempty subset of `ℝᴾ`
  have hLc : IsClosed (Set.range A) :=
    (LinearMap.range (A : Euclid d →ₗ[ℝ] Euclid P)).closed_of_finiteDimensional
  have hLne : (Set.range A).Nonempty := Set.range_nonempty A
  -- Step 2: the difference quotients `s(t) = t⁻¹ (γ(t) − q)` tend to `w` as `t → 0`, `t ≠ 0`
  have hs : Tendsto (slope γ 0) (𝓝[≠] 0) (𝓝 w) := hγw.tendsto_slope
  -- Steps 3–5: `dist(w, L) ≤ ε |w|` for every `ε > 0`
  have key : ∀ ε : ℝ, 0 < ε → infDist w (Set.range A) ≤ ε * ‖w‖ := by
    intro ε hε
    obtain ⟨δ, hδ, hN⟩ := hsec ε hε
    -- `γ(t) ∈ N` and `|γ(t) − q| < δ` for `t` near `0`
    have hball : ∀ᶠ t in 𝓝 (0 : ℝ), γ t ∈ ball q δ := by
      have hγc := hγw.continuousAt.tendsto
      rw [hγ0] at hγc
      exact hγc (ball_mem_nhds q hδ)
    have hIoo : ∀ᶠ t in 𝓝 (0 : ℝ), t ∈ Ioo (-1 : ℝ) 1 := Ioo_mem_nhds (by norm_num) (by norm_num)
    -- the secant estimate at `y = γ(t)`, divided by `|t|`
    have hev : ∀ᶠ t in 𝓝[≠] (0 : ℝ),
        infDist (slope γ 0 t) (Set.range A) ≤ ε * ‖slope γ 0 t‖ := by
      filter_upwards [nhdsWithin_le_nhds (hball.and hIoo)] with t ht
      obtain ⟨a, ha⟩ := hN (γ t) (hγN ht.2) (mem_ball.mp ht.1)
      have hst : slope γ 0 t = t⁻¹ • (γ t - q) := by
        rw [slope_def_module, sub_zero, hγ0]
      calc infDist (slope γ 0 t) (Set.range A) ≤ dist (slope γ 0 t) (A (t⁻¹ • a)) :=
            infDist_le_dist_of_mem (Set.mem_range_self _)
        _ = ‖t⁻¹‖ * ‖γ t - q - A a‖ := by
            rw [dist_eq_norm, hst, map_smul, ← smul_sub, norm_smul]
        _ ≤ ‖t⁻¹‖ * (ε * ‖γ t - q‖) := by gcongr
        _ = ε * ‖slope γ 0 t‖ := by
            rw [hst, norm_smul]
            ring
    -- pass to the limit `t → 0`
    exact le_of_tendsto_of_tendsto (((continuous_infDist_pt (Set.range A)).tendsto w).comp hs)
      (hs.norm.const_mul ε) hev
  -- Step 6: letting `ε → 0`, `dist(w, L) ≤ 0`
  have h0 : infDist w (Set.range A) ≤ 0 := by
    have hlim : Tendsto (fun ε : ℝ => ε * ‖w‖) (𝓝[>] 0) (𝓝 0) := by
      have h : Tendsto (fun ε : ℝ => ε * ‖w‖) (𝓝 0) (𝓝 (0 * ‖w‖)) := tendsto_id.mul_const ‖w‖
      rw [zero_mul] at h
      exact tendsto_nhdsWithin_of_tendsto_nhds h
    exact ge_of_tendsto hlim (eventually_nhdsWithin_of_forall fun ε hε => key ε hε)
  -- Step 7: `L` is closed, so `dist(w, L) = 0` gives `w ∈ L`
  exact (hLc.mem_iff_infDist_zero hLne).mpr (le_antisymm h0 infDist_nonneg)
/-- **Simon Ch. 2, §4, (4.3)** for a map with a continuous affine left inverse: if `Φ` is `C¹` on
`D = B_s(0) ⊆ ℝᵈ` and `L(Φ(v) − z) = v` for `v ∈ D`, then `T_{Φ(v₀)}Φ(D) = DΦ(v₀)(ℝᵈ)` for every
`v₀ ∈ D`.  `⊆` is `dgce_left_inverse_tangentSpace_subset_range`.  For `⊇` and `a ∈ ℝᵈ`, take the
constant curve if `a = 0`.  Otherwise, with `c₀ = (s − |v₀|) / (2|a|)` and `θ(t) = c₀ sin(t / c₀)`
(smooth, `θ(0) = 0`, `θ'(0) = 1`, `|θ| ≤ c₀`), the curve `γ(t) = Φ(v₀ + θ(t) a)` stays in `Φ(D)`
and has velocity `DΦ(v₀) a`. -/
theorem Submission.dgce_left_inverse_tangentSpace_eq_range : ∀ (d P : ℕ) (Φ : Euclid d → Euclid P) (L : Euclid P →L[ℝ] Euclid d) (z : Euclid P) (s : ℝ), ContDiffOn ℝ 1 Φ (ball 0 s) → (∀ v ∈ ball (0 : Euclid d) s, L (Φ v - z) = v) → ∀ v ∈ ball (0 : Euclid d) s, tangentSpace (Φ '' ball (0 : Euclid d) s) (Φ v) = (LinearMap.range (fderiv ℝ Φ v : Euclid d →ₗ[ℝ] Euclid P) : Set (Euclid P)) := by
  intro d P Φ L z s hΦ hL v₀ hv₀
  refine Subset.antisymm
    (Submission.dgce_left_inverse_tangentSpace_subset_range d P Φ L z s hΦ hL v₀ hv₀) ?_
  rintro _ ⟨a, rfl⟩
  -- `Φ` is `C¹` on the open ball `D`, hence differentiable at `v₀`
  have hΦv₀ : HasFDerivAt Φ (fderiv ℝ Φ v₀) v₀ :=
    (hΦ.differentiableOn_one.differentiableAt (isOpen_ball.mem_nhds hv₀)).hasFDerivAt
  by_cases ha : a = 0
  · -- `a = 0`: the constant curve `Φ(v₀)` has velocity `0 = DΦ(v₀) 0`
    subst ha
    refine ⟨fun _ => Φ v₀, contDiffOn_const, fun _ _ => mem_image_of_mem Φ hv₀, rfl, ?_⟩
    simpa using hasDerivAt_const (0 : ℝ) (Φ v₀)
  · -- `a ≠ 0`: `κ(t) = v₀ + θ(t) a` with `θ(t) = c₀ sin(t / c₀)`, `c₀ = (s − |v₀|) / (2|a|)`
    have ha' : 0 < ‖a‖ := norm_pos_iff.mpr ha
    have hv₀s : ‖v₀‖ < s := mem_ball_zero_iff.mp hv₀
    set c₀ : ℝ := (s - ‖v₀‖) / (2 * ‖a‖) with hc₀_def
    have hc₀ : 0 < c₀ := div_pos (sub_pos.mpr hv₀s) (by positivity)
    set θ : ℝ → ℝ := fun t => c₀ * Real.sin (t / c₀) with hθ_def
    -- (a) `θ` is smooth
    have hθ_cd : ContDiff ℝ 1 θ :=
      contDiff_const.mul (Real.contDiff_sin.comp (contDiff_id.div_const c₀))
    -- (b) `θ(0) = 0` and `θ'(0) = c₀ cos 0 / c₀ = 1`
    have hθ0 : θ 0 = 0 := by simp [hθ_def]
    have hθ_deriv : HasDerivAt θ 1 0 := by
      have h := ((Real.hasDerivAt_sin (0 / c₀)).comp 0
        ((hasDerivAt_id' (x := (0 : ℝ))).div_const c₀)).const_mul c₀
      rw [zero_div, Real.cos_zero, one_mul, mul_one_div_cancel hc₀.ne'] at h
      exact h
    -- (c) `|θ(t)| ≤ c₀`
    have hθ_bd : ∀ t, |θ t| ≤ c₀ := fun t => by
      rw [hθ_def, abs_mul, abs_of_pos hc₀]
      exact mul_le_of_le_one_right hc₀.le (Real.abs_sin_le_one _)
    -- `κ` stays in `D`, `κ(0) = v₀` and `κ'(0) = a`
    set κ : ℝ → Euclid d := fun t => v₀ + θ t • a with hκ_def
    have hκD : ∀ t, κ t ∈ ball (0 : Euclid d) s := fun t => by
      rw [mem_ball_zero_iff]
      calc ‖κ t‖ ≤ ‖v₀‖ + |θ t| * ‖a‖ := by
            simpa only [hκ_def, norm_smul, Real.norm_eq_abs] using norm_add_le v₀ (θ t • a)
        _ ≤ ‖v₀‖ + c₀ * ‖a‖ := by gcongr; exact hθ_bd t
        _ = ‖v₀‖ + (s - ‖v₀‖) / 2 := by rw [hc₀_def]; field_simp
        _ < s := by linarith
    have hκ0 : κ 0 = v₀ := by simp [hκ_def, hθ0]
    have hκ_cd : ContDiff ℝ 1 κ := contDiff_const.add (hθ_cd.smul contDiff_const)
    have hκ_deriv : HasDerivAt κ a 0 := by
      have := HasDerivAt.const_add v₀ (hθ_deriv.smul_const a)
      rwa [one_smul] at this
    -- `γ = Φ ∘ κ` is `C¹` on `(-1, 1)`, lies in `Φ(D)`, and `γ'(0) = DΦ(v₀) a`
    refine ⟨Φ ∘ κ, hΦ.comp hκ_cd.contDiffOn fun t _ => hκD t,
      fun t _ => mem_image_of_mem Φ (hκD t), by simp [hκ0], ?_⟩
    exact hΦv₀.comp_hasDerivAt_of_eq 0 hκ_deriv hκ0.symm

/-- Simon Ch. 2, §4, 4.1 and 4.3 for graphs (cf. Remark 4.4): for linear isometries
`ι : ℝⁿ → ℝ^{n+k}`, `ι' : ℝᵏ → ℝ^{n+k}` with `⟨ιv, ι'w⟩ = 0` and `u` of class `C¹` on
`D = B_s(0)`, the graph map `Φ(v) = z + ιv + ι'u(v)` is injective on `D` with injective derivative,
`Σ = Φ(D)` is an embedded `n`-dimensional `C¹` submanifold, and `T_{Φ(v)}Σ = range DΦ(v)` for
`v ∈ D`. -/
theorem Submission.dgcr_graph_chart_embedded : ∀ (n k : ℕ) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (u : Euclid n → Euclid k) (z : Euclid (n + k)) (s : ℝ), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → 0 < s → ContDiffOn ℝ 1 u (ball 0 s) → InjOn (fun v => z + ι v + ι' (u v)) (ball (0 : Euclid n) s) ∧ (∀ v ∈ ball (0 : Euclid n) s, DifferentiableAt ℝ (fun v => z + ι v + ι' (u v)) v ∧ Injective (fderiv ℝ (fun v => z + ι v + ι' (u v)) v)) ∧ IsEmbeddedSubmanifold 1 n ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s) ∧ ∀ v ∈ ball (0 : Euclid n) s, tangentSpace ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s) (z + ι v + ι' (u v)) = (LinearMap.range (fderiv ℝ (fun v => z + ι v + ι' (u v)) v : Euclid n →ₗ[ℝ] Euclid (n + k)) : Set (Euclid (n + k))) := by
  intro n k ι ι' u z s horth _hs hu
  -- `Φ` is `C¹` on `D`, and `Pr(x) = L(x − z)` inverts it on the left: `Pr ∘ Φ = id`
  obtain ⟨hΦ, L, hL⟩ := Submission.dgce_graph_contDiffOn_left_inverse n k ι ι' u z s horth hu
  -- (i)–(iii) and (iv) hold for any `C¹` map on `D` with a continuous affine left inverse
  obtain ⟨hinj, hdiff, hemb⟩ := Submission.dgce_left_inverse_chart_embedded n (n + k)
    (fun v => z + ι v + ι' (u v)) L z s hΦ fun v _ => hL v
  exact ⟨hinj, hdiff, hemb, Submission.dgce_left_inverse_tangentSpace_eq_range n (n + k)
    (fun v => z + ι v + ι' (u v)) L z s hΦ fun v _ => hL v⟩
/-- Step 8 of the proof that an integer multiplicity cycle carried by a `C¹` graph is regular
(Simon 7.4.3, via Allard's theorem; consequences of the area formula, Ch. 2, 3.2–3.5): for the
graph map `Φ(v) = z + ιv + ι'u(v)` of a `C¹` function `u` on `B_s(0)` (`ι`, `ι'` orthogonal linear
isometries), `∫_A g ∘ Φ dLⁿ ≤ ∫_{Φ(A)} g dHⁿ` for Borel `A ⊆ B_s(0)` and Borel `g ≥ 0`, and
`Hⁿ(Φ(B̄_t(0))) < ∞` for `t < s`.  `Pr = ι*(· − z)` is a 1-Lipschitz left inverse of `Φ`, so
`Lⁿ(S) = Hⁿ(Pr(Φ(S))) ≤ Hⁿ(Φ(S))` and `Φ_#(Lⁿ⌞A) ≤ Hⁿ⌞Φ(A)`; on the compact convex set `B̄_t(0)`,
`Φ` is Lipschitz by the mean value inequality. -/
theorem Submission.dgcr_graph_measure_bounds : ∀ (n k : ℕ) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (u : Euclid n → Euclid k) (z : Euclid (n + k)) (s : ℝ), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → 0 < s → ContDiffOn ℝ 1 u (ball 0 s) → (∀ (A : Set (Euclid n)) (g : Euclid (n + k) → ℝ≥0∞), MeasurableSet A → A ⊆ ball 0 s → Measurable g → ∫⁻ v in A, g (z + ι v + ι' (u v)) ≤ ∫⁻ x in (fun v => z + ι v + ι' (u v)) '' A, g x ∂μHE[n]) ∧ ∀ t : ℝ, t < s → μHE[n] ((fun v => z + ι v + ι' (u v)) '' closedBall (0 : Euclid n) t) ≠ ∞ := by
  intro n k ι ι' u z s horth hs hu
  set Φ : Euclid n → Euclid (n + k) := fun v => z + ι v + ι' (u v) with hΦ
  -- step 1: `Pr = ι*(· − z)` is a 1-Lipschitz left inverse of `Φ`
  set ιs : Euclid (n + k) →L[ℝ] Euclid n := ContinuousLinearMap.adjoint ι.toContinuousLinearMap
    with hιs
  have hιsι : ∀ v, ιs (ι v) = v := fun v => ext_inner_right ℝ fun w => by
    rw [hιs, ContinuousLinearMap.adjoint_inner_left, LinearIsometry.coe_toContinuousLinearMap,
      LinearIsometry.inner_map_map]
  have hιsι' : ∀ w, ιs (ι' w) = 0 := fun w => ext_inner_right ℝ fun v => by
    rw [hιs, ContinuousLinearMap.adjoint_inner_left, LinearIsometry.coe_toContinuousLinearMap,
      inner_zero_left, real_inner_comm, horth]
  have hιs_le : ∀ y, ‖ιs y‖ ≤ ‖y‖ := fun y =>
    calc ‖ιs y‖ ≤ ‖ιs‖ * ‖y‖ := ιs.le_opNorm y
      _ = ‖ι.toContinuousLinearMap‖ * ‖y‖ := by rw [hιs, LinearIsometryEquiv.norm_map]
      _ ≤ 1 * ‖y‖ := by gcongr; exact ι.norm_toContinuousLinearMap_le
      _ = ‖y‖ := one_mul _
  let Pr : Euclid (n + k) → Euclid n := fun x => ιs (x - z)
  have hPrΦ : ∀ v, Pr (Φ v) = v := fun v => by
    simp only [Pr, hΦ, add_assoc, add_sub_cancel_left, map_add, hιsι, hιsι', add_zero]
  have hPr : LipschitzWith 1 Pr := LipschitzWith.of_dist_le_mul fun x y => by
    simp only [Pr, dist_eq_norm, ← map_sub, sub_sub_sub_cancel_right, NNReal.coe_one, one_mul]
    exact hιs_le _
  -- step 3: `Lⁿ(S) ≤ Hⁿ(Φ(S))` for every `S`
  have hvol : ∀ S : Set (Euclid n), volume S ≤ μHE[n] (Φ '' S) := fun S => by
    have h := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
      (hPr.lipschitzOnWith (s := Φ '' S))
    rwa [image_image, show (fun v => Pr (Φ v)) = id from funext hPrΦ, image_id,
      EuclideanSpace.euclideanHausdorffMeasure_eq_volume, ENNReal.coe_one, one_pow, one_mul] at h
  have hΦC1 : ContDiffOn ℝ 1 Φ (ball 0 s) :=
    (contDiffOn_const.add ι.contDiff.contDiffOn).add (ι'.contDiff.comp_contDiffOn hu)
  refine ⟨fun A g hA hAs hg => ?_, fun t ht => ?_⟩
  · -- steps 4–5: `Φ_#(Lⁿ⌞A) ≤ Hⁿ⌞Φ(A)`
    have hΦm : AEMeasurable Φ (volume.restrict A) := (hΦC1.continuousOn.mono hAs).aemeasurable hA
    have hν : Measure.map Φ (volume.restrict A) ≤ μHE[n].restrict (Φ '' A) := by
      refine Measure.le_iff.2 fun S hS => ?_
      rw [Measure.map_apply_of_aemeasurable hΦm hS, Measure.restrict_apply' hA,
        Measure.restrict_apply hS, ← image_preimage_inter]
      exact hvol _
    calc ∫⁻ v in A, g (Φ v) = ∫⁻ x, g x ∂(Measure.map Φ (volume.restrict A)) :=
          (lintegral_map' hg.aemeasurable hΦm).symm
      _ ≤ ∫⁻ x in Φ '' A, g x ∂μHE[n] := lintegral_mono' hν le_rfl
  · -- step 6: `Φ` is Lipschitz on `B̄_t(0)`
    rcases lt_or_ge t 0 with ht0 | ht0
    · rw [closedBall_eq_empty.2 ht0, image_empty, measure_empty]
      exact ENNReal.zero_ne_top
    have hKs : closedBall (0 : Euclid n) t ⊆ ball 0 s := closedBall_subset_ball ht
    obtain ⟨C, hC⟩ := (isCompact_closedBall (0 : Euclid n) t).exists_bound_of_continuousOn
      ((hΦC1.continuousOn_fderiv_of_isOpen isOpen_ball le_rfl).mono hKs)
    have hLip : LipschitzOnWith C.toNNReal Φ (closedBall 0 t) :=
      (convex_closedBall (0 : Euclid n) t).lipschitzOnWith_of_nnnorm_hasFDerivWithin_le
        (fun v hv => ((hΦC1.differentiableOn one_ne_zero).differentiableAt
          (isOpen_ball.mem_nhds (hKs hv))).hasFDerivAt.hasFDerivWithinAt)
        (fun v hv => by rw [← norm_toNNReal]; exact Real.toNNReal_le_toNNReal (hC v hv))
    refine ne_top_of_le_ne_top ?_
      (Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n hLip)
    rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
    exact ENNReal.mul_ne_top (ENNReal.pow_ne_top ENNReal.coe_ne_top)
      (isCompact_closedBall (0 : Euclid n) t).measure_lt_top.ne
/-- Step 3(i) of the Jacobian identity for the orientation of a `C¹` graph (Simon 7.4.3, via
Allard's theorem; `n`-covectors as in Ch. 6, §1): if `τ` is an orthonormal `n`-frame and every
`bⱼ` lies in `L = span τ`, then `α(b₁, …, bₙ) = det(⟨τᵢ, bⱼ⟩) α(τ₁, …, τₙ)` for every
`n`-covector `α`.  The restriction of `α` to `L` is `α(τ) det_τ`, and the coordinates of `bⱼ` in
the basis `τ` of `L` are `⟨τᵢ, bⱼ⟩`. -/
theorem Submission.dgoj_covector_eq_det_mul_of_mem_span : ∀ (P n : ℕ) (τ b : Fin n → Euclid P), Orthonormal ℝ τ → (∀ j, b j ∈ Submodule.span ℝ (Set.range τ)) → ∀ α : Covector (Euclid P) n, α b = (Matrix.of fun i j => inner ℝ (τ i) (b j)).det * α τ := by
  intro P n τ b hτ hb α
  set L := Submodule.span ℝ (Set.range τ)
  -- `τ` is a basis `e` of `L`
  let e : Module.Basis (Fin n) ℝ L := Module.Basis.span hτ.linearIndependent
  have he : ∀ i, (e i : Euclid P) = τ i := fun i => by
    rw [Module.Basis.span_apply hτ.linearIndependent i]
  -- the restriction `α_L` of `α` to `L`
  let αL : L [⋀^Fin n]→ₗ[ℝ] ℝ := α.toAlternatingMap.compLinearMap L.subtype
  let b' : Fin n → L := fun j => ⟨b j, hb j⟩
  have h1 : α b = αL b' := rfl
  have h2 : α τ = αL e := by
    show α τ = α (fun i => (e i : Euclid P))
    congr 1
    funext i
    exact (he i).symm
  -- coordinates of `b'` in `e` are the inner products with `τ`
  have hrepr : ∀ i j, e.repr (b' j) i = inner ℝ (τ i) (b j) := by
    intro i j
    have hs : (b j : Euclid P) = ∑ l, e.repr (b' j) l • τ l := by
      have := congrArg (Subtype.val) (e.sum_repr (b' j))
      simp only [Submodule.coe_sum, Submodule.coe_smul, he] at this
      exact this.symm
    rw [hs, hτ.inner_right_fintype]
  have hmat : e.toMatrix b' = Matrix.of fun i j => inner ℝ (τ i) (b j) := by
    ext i j
    rw [Module.Basis.toMatrix_apply, hrepr, Matrix.of_apply]
  -- `α_L = α_L(e) • det_e`
  have h3 : αL b' = αL e * e.det b' := by
    conv_lhs => rw [AlternatingMap.eq_smul_basis_det e αL]
    rfl
  rw [h1, h2, h3, Module.Basis.det_apply, hmat, mul_comm]
/-- Steps 3(ii)–(iii) of the Jacobian identity for the orientation of a `C¹` graph (Simon 7.4.3,
via Allard's theorem): if `τ` is an orthonormal `n`-frame whose span contains every `F eⱼ`, then
`det(F* ∘ F) = (det 𝒜)²` with `𝒜ᵢⱼ = ⟨τᵢ, F eⱼ⟩`.  Expanding `F eⱼ = Σₗ 𝒜ₗⱼ τₗ` gives the Gram
identity `⟨F eᵢ, F eⱼ⟩ = (𝒜ᵀ𝒜)ᵢⱼ`, and the Gram matrix is the matrix of `F* ∘ F` in the standard
basis of `ℝⁿ`. -/
theorem Submission.dgoj_det_adjoint_comp_eq_det_sq : ∀ (P n : ℕ) (F : Euclid n →L[ℝ] Euclid P) (τ : Fin n → Euclid P), Orthonormal ℝ τ → (∀ j, F (EuclideanSpace.single j (1 : ℝ)) ∈ Submodule.span ℝ (Set.range τ)) → (F.adjoint ∘L F).det = (Matrix.of fun i j => inner ℝ (τ i) (F (EuclideanSpace.single j (1 : ℝ)))).det ^ 2 := by
  intro P n F τ hτ hb
  set A : Matrix (Fin n) (Fin n) ℝ :=
    Matrix.of fun i j => inner ℝ (τ i) (F (EuclideanSpace.single j (1 : ℝ))) with hA
  -- `F eⱼ = Σₗ 𝒜ₗⱼ τₗ`: the coordinates of a vector of `span τ` are its inner products with `τ`
  have hexp : ∀ j, F (EuclideanSpace.single j (1 : ℝ)) = ∑ l, A l j • τ l := by
    intro j
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).1 (hb j)
    have hcA : ∀ l, A l j = c l := by
      intro l
      rw [hA, Matrix.of_apply, ← hc, hτ.inner_right_fintype]
    rw [← hc]
    simp only [hcA]
  -- the Gram identity `⟨F eᵢ, F eⱼ⟩ = (𝒜ᵀ𝒜)ᵢⱼ`
  have hgram : ∀ i j, inner ℝ (F (EuclideanSpace.single i (1 : ℝ)))
      (F (EuclideanSpace.single j (1 : ℝ))) = (A.transpose * A) i j := by
    intro i j
    rw [Matrix.mul_apply]
    conv_lhs => rw [hexp i]
    rw [sum_inner]
    refine Finset.sum_congr rfl fun l _ => ?_
    rw [inner_smul_left, Matrix.transpose_apply]
    simp [hA]
  -- the matrix of `F* ∘ F` in the standard basis has entries `⟨eᵢ, F* F eⱼ⟩ = ⟨F eᵢ, F eⱼ⟩`
  let B := (EuclideanSpace.basisFun (Fin n) ℝ).toBasis
  have hmat : LinearMap.toMatrix B B ((F.adjoint ∘L F : Euclid n →L[ℝ] Euclid n) : Euclid n →ₗ[ℝ] Euclid n)
      = A.transpose * A := by
    ext i j
    rw [LinearMap.toMatrix_apply, ← hgram i j]
    simp only [B, OrthonormalBasis.coe_toBasis, OrthonormalBasis.coe_toBasis_repr_apply,
      EuclideanSpace.basisFun_repr, EuclideanSpace.basisFun_apply, ContinuousLinearMap.coe_coe,
      ContinuousLinearMap.coe_comp, Function.comp_apply]
    rw [← ContinuousLinearMap.adjoint_inner_right, EuclideanSpace.inner_single_left]
    simp
  rw [ContinuousLinearMap.det, ← LinearMap.det_toMatrix B, hmat, Matrix.det_mul,
    Matrix.det_transpose, sq]
/-- Step 3 of the Jacobian identity for the orientation of a `C¹` graph (Simon 7.4.3, via
Allard's theorem): if `F : ℝⁿ → ℝᴾ` is injective, its range `L` has an orthonormal basis
`τ = (τ₁, …, τₙ)`, regarded as an orthonormal `n`-frame in `ℝᴾ` spanning `L`.  Since
`dim L = n`, reindex `stdOrthonormalBasis ℝ L` along `Fin (dim L) ≃ Fin n` and include it into
`ℝᴾ` by the linear isometry `L → ℝᴾ`. -/
theorem Submission.dgoj_exists_orthonormal_frame_range : ∀ (P n : ℕ) (F : Euclid n →L[ℝ] Euclid P), Injective F → ∃ τ : Fin n → Euclid P, Orthonormal ℝ τ ∧ Submodule.span ℝ (Set.range τ) = LinearMap.range (F : Euclid n →ₗ[ℝ] Euclid P) := by
  intro P n F hF
  set L := LinearMap.range (F : Euclid n →ₗ[ℝ] Euclid P) with hLdef
  -- `dim L = dim ℝⁿ = n`, since `F` is injective
  have hL : Module.finrank ℝ L = n := by
    rw [hLdef, LinearMap.finrank_range_of_inj hF, finrank_euclideanSpace_fin]
  let T : OrthonormalBasis (Fin n) ℝ L := (stdOrthonormalBasis ℝ L).reindex (finCongr hL)
  refine ⟨fun i => (T i : Euclid P), ?_, ?_⟩
  · -- the inclusion `L → ℝᴾ` is a linear isometry
    exact T.orthonormal.comp_linearIsometry L.subtypeₗᵢ
  · -- `span (ι '' range T) = ι '' span (range T) = ι '' L = L`
    have h1 : (fun i => (T i : Euclid P)) = L.subtype ∘ T := rfl
    rw [h1, Set.range_comp, Submodule.span_image, ← T.coe_toBasis, T.toBasis.span_eq,
      Submodule.map_top, Submodule.range_subtype]

/-- **The normalized evaluation at `F e` is a unit orientation of `range F`** (Simon 6.1.1,
6.1.7; `√det(F* ∘ F)` is the area Jacobian of Ch. 2, 3.1/3.3).  For injective `F : ℝⁿ → ℝᴾ`,
`det(F* ∘ F) > 0`, and if `α(F e₁, …, F eₙ) = √det(F* ∘ F) ξ(α)` for every `n`-covector `α` then
`ξ = ±τ₁ ∧ ⋯ ∧ τₙ` for an orthonormal frame `τ` of `range F`: with `d = det(⟨τᵢ, F eⱼ⟩)` one has
`det(F* ∘ F) = d² ≠ 0` and `α(F e) = d α(τ)`, so `|d| ξ(α) = d α(τ)` and the sign is that of `d`. -/
theorem Submission.dgoj_unitOrientation_of_injective : ∀ (P n : ℕ) (F : Euclid n →L[ℝ] Euclid P), Injective F → 0 < (F.adjoint ∘L F).det ∧ ∀ ξ : MultiVector P n, (∀ α : Covector (Euclid P) n, α (fun i => F (EuclideanSpace.single i (1 : ℝ))) = Real.sqrt ((F.adjoint ∘L F).det) * ξ α) → IsUnitOrientationOf ξ (LinearMap.range (F : Euclid n →ₗ[ℝ] Euclid P)) := by
  intro P n F hF
  -- an orthonormal frame `τ` of `range F`; every `F eⱼ` lies in its span
  obtain ⟨τ, hτo, hτs⟩ := Submission.dgoj_exists_orthonormal_frame_range P n F hF
  have hb : ∀ j, F (EuclideanSpace.single j (1 : ℝ)) ∈ Submodule.span ℝ (Set.range τ) := by
    intro j
    rw [hτs]
    exact LinearMap.mem_range_self _ _
  -- `det(F* ∘ F) = d²` for `d = det(⟨τᵢ, F eⱼ⟩)`
  set d := (Matrix.of fun i j => inner ℝ (τ i) (F (EuclideanSpace.single j (1 : ℝ)))).det
  have hdet : (F.adjoint ∘L F).det = d ^ 2 :=
    Submission.dgoj_det_adjoint_comp_eq_det_sq P n F τ hτo hb
  -- `ker(F* ∘ F) = ker F = 0`, so `det(F* ∘ F) ≠ 0` and hence `d ≠ 0`
  have hd : d ≠ 0 := by
    intro h
    have h0 : (F.adjoint ∘L F).det = 0 := by rw [hdet, h, zero_pow two_ne_zero]
    apply LinearMap.det_eq_zero_iff_ker_ne_bot.1 h0
    rw [F.ker_adjoint_comp_self, LinearMap.ker_eq_bot]
    exact hF
  -- (i): `det(F* ∘ F) = d² > 0`
  refine ⟨by rw [hdet]; positivity, fun ξ hξ => ⟨τ, hτo, hτs, ?_⟩⟩
  -- (ii): `|d| ξ(α) = √det(F* ∘ F) ξ(α) = α(F e) = d α(τ)` for every `α`
  have key : ∀ α : Covector (Euclid P) n, |d| * ξ α = d * α τ := by
    intro α
    rw [← Real.sqrt_sq_eq_abs, ← hdet, ← hξ α]
    exact Submission.dgoj_covector_eq_det_mul_of_mem_span P n τ _ hτo hb α
  -- the sign of `d` decides between `ξ(α) = -α(τ)` and `ξ(α) = α(τ)`
  rcases hd.lt_or_gt with hneg | hpos
  · right
    intro α
    have h := key α
    rw [abs_of_neg hneg] at h
    apply mul_left_cancel₀ hd
    linarith
  · left
    intro α
    have h := key α
    rw [abs_of_pos hpos] at h
    exact mul_left_cancel₀ hd h
/-- Evaluation of `n`-covectors at an `n`-family `c`, `ev c = (α ↦ α c)`, is a continuous map
into `n`-vectors: `‖ev c - ev c'‖ ≤ n · max(‖c‖, ‖c'‖)ⁿ⁻¹ · ‖c - c'‖`. -/
theorem Submission.dgoj_exists_continuous_covector_eval : ∀ (P n : ℕ), ∃ ev : (Fin n → Euclid P) → MultiVector P n, Continuous ev ∧ ∀ (c : Fin n → Euclid P) (α : Covector (Euclid P) n), ev c α = α c := by
  intro P n
  let ev : (Fin n → Euclid P) → MultiVector P n := fun c =>
    LinearMap.mkContinuous
      { toFun := fun α => α c
        map_add' := fun α β => rfl
        map_smul' := fun r α => rfl }
      (∏ i, ‖c i‖) fun α => by
        simp only [LinearMap.coe_mk, AddHom.coe_mk]
        calc ‖α c‖ ≤ ‖α‖ * ∏ i, ‖c i‖ := α.le_opNorm c
          _ = (∏ i, ‖c i‖) * ‖α‖ := mul_comm _ _
  have hev : ∀ (c : Fin n → Euclid P) (α : Covector (Euclid P) n), ev c α = α c := fun c α => rfl
  refine ⟨ev, ?_, hev⟩
  have key : ∀ c c' : Fin n → Euclid P,
      ‖ev c - ev c'‖ ≤ (n : ℝ) * max ‖c‖ ‖c'‖ ^ (n - 1) * ‖c - c'‖ := by
    intro c c'
    refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) fun α => ?_
    rw [sub_apply, hev, hev]
    have h := α.norm_image_sub_le c c'
    rw [Fintype.card_fin] at h
    calc ‖α c - α c'‖ ≤ ‖α‖ * n * max ‖c‖ ‖c'‖ ^ (n - 1) * ‖c - c'‖ := h
      _ = (n : ℝ) * max ‖c‖ ‖c'‖ ^ (n - 1) * ‖c - c'‖ * ‖α‖ := by ring
  rw [continuous_iff_continuousAt]
  intro c₀
  have hcont : Continuous fun c : Fin n → Euclid P => (n : ℝ) * max ‖c‖ ‖c₀‖ ^ (n - 1) * ‖c - c₀‖ := by
    fun_prop
  have h0 := hcont.tendsto c₀
  simp only [sub_self, norm_zero, mul_zero] at h0
  have h1 : Tendsto (fun c => ‖ev c - ev c₀‖) (𝓝 c₀) (𝓝 0) :=
    squeeze_zero (fun c => norm_nonneg (ev c - ev c₀)) (fun c => key c c₀) h0
  exact (tendsto_iff_norm_sub_tendsto_zero (E := MultiVector P n) (f := ev) (b := ev c₀)).2 h1
/-- **A continuous determinant `n`-covector on `ℝⁿ`**: some `δ ∈ Λⁿ(ℝⁿ)` (a continuous
alternating `n`-form) has `δ(e₁, …, eₙ) = 1` for the standard basis `eᵢ`.  Take the volume form
`ω` of the orientation of the standard orthonormal basis `B`; Hadamard's inequality
`|ω(v)| ≤ ∏ᵢ ‖vᵢ‖` makes it continuous, and `ω = det_B` gives `δ(e₁, …, eₙ) = det_B(B) = 1`. -/
theorem Submission.dgoj_exists_det_covector : ∀ n : ℕ, ∃ δ : Covector (Euclid n) n, δ (fun i => EuclideanSpace.single i (1 : ℝ)) = 1 := by
  intro n
  have : Fact (Module.finrank ℝ (Euclid n) = n) := ⟨finrank_euclideanSpace_fin⟩
  let b := EuclideanSpace.basisFun (Fin n) ℝ
  let o : Orientation ℝ (Euclid n) (Fin n) := b.toBasis.orientation
  refine ⟨o.volumeForm.mkContinuous 1 fun m => ?_, ?_⟩
  · rw [one_mul, Real.norm_eq_abs]
    exact o.abs_volumeForm_apply_le m
  · rw [AlternatingMap.coe_mkContinuous, o.volumeForm_robust b rfl]
    have h : (fun i => EuclideanSpace.single i (1 : ℝ)) = ⇑b.toBasis := by
      funext i; simp [b]
    rw [h, Module.Basis.det_self]
/-- Steps 1–2 of the Jacobian identity for the orientation of a `C¹` graph (Simon 7.4.3, via
Allard's theorem): for linear isometries `ι : ℝⁿ → ℝ^{n+k}`, `ι' : ℝᵏ → ℝ^{n+k}` with
`⟨ιv, ι'w⟩ = 0` and `u` of class `C¹` on `D = B_s(0)`, the adjoint `ι*` is a left inverse of
`ι + ι'`, the derivative of the graph map `Φ(v) = z + ιv + ι'u(v)` is continuous on `D`, and
`ι* ∘ DΦ(v) = id` on `D`, because `DΦ(v) = ι + ι' ∘ Du(v)`. -/
theorem Submission.dgoj_graph_fderiv_left_inverse : ∀ (n k : ℕ) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (u : Euclid n → Euclid k) (z : Euclid (n + k)) (s : ℝ), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → ContDiffOn ℝ 1 u (ball 0 s) → (∀ (v : Euclid n) (w : Euclid k), ι.toContinuousLinearMap.adjoint (ι v + ι' w) = v) ∧ ContinuousOn (fderiv ℝ (fun v => z + ι v + ι' (u v))) (ball (0 : Euclid n) s) ∧ ∀ v ∈ ball (0 : Euclid n) s, ∀ w : Euclid n, ι.toContinuousLinearMap.adjoint (fderiv ℝ (fun v => z + ι v + ι' (u v)) v w) = w := by
  intro n k ι ι' u z s horth hu
  -- (i) `⟨ι*(ιv + ι'w), v'⟩ = ⟨ιv, ιv'⟩ + ⟨ι'w, ιv'⟩ = ⟨v, v'⟩ + 0` for every `v'`
  have hadj : ∀ (v : Euclid n) (w : Euclid k), ι.toContinuousLinearMap.adjoint (ι v + ι' w) = v := by
    intro v w
    apply ext_inner_right ℝ
    intro v'
    rw [ContinuousLinearMap.adjoint_inner_left, inner_add_left]
    have h1 : inner ℝ (ι' w) (ι.toContinuousLinearMap v') = 0 := by
      rw [real_inner_comm]; exact horth v' w
    rw [h1, add_zero]
    exact ι.inner_map_map v v'
  refine ⟨hadj, ?_, ?_⟩
  -- (ii) `Φ = (z + ι·) + ι' ∘ u` is `C¹` on the open ball, so `DΦ` is continuous there
  · have hΦ : ContDiffOn ℝ 1 (fun v => z + ι v + ι' (u v)) (ball 0 s) :=
      (contDiffOn_const.add ι.toContinuousLinearMap.contDiff.contDiffOn).add
        (ι'.toContinuousLinearMap.contDiff.comp_contDiffOn hu)
    exact hΦ.continuousOn_fderiv_of_isOpen isOpen_ball le_rfl
  -- (iii) `DΦ(v) = ι + ι' ∘ Du(v)`, so `ι*(DΦ(v)w) = ι*(ιw + ι'(Du(v)w)) = w` by (i)
  · intro v hv w
    have hdu : DifferentiableAt ℝ u v :=
      (hu.differentiableOn one_ne_zero).differentiableAt (isOpen_ball.mem_nhds hv)
    have hder : HasFDerivAt (fun v => z + ι v + ι' (u v))
        (ι.toContinuousLinearMap + ι'.toContinuousLinearMap.comp (fderiv ℝ u v)) v := by
      have h1 : HasFDerivAt (fun v => z + ι v) ι.toContinuousLinearMap v :=
        ι.toContinuousLinearMap.hasFDerivAt.const_add z
      have h2 : HasFDerivAt (fun v => ι' (u v)) (ι'.toContinuousLinearMap.comp (fderiv ℝ u v)) v :=
        ι'.toContinuousLinearMap.hasFDerivAt.comp v hdu.hasFDerivAt
      exact h1.add h2
    rw [hder.fderiv]
    exact hadj w _

/-- **Continuous unit orientation of a `C¹` graph and the Jacobian identity** (Simon 7.4.3, via
Allard's theorem; steps 3 and 7 of the graph-cycle argument).  Let `Φ(v) = z + ιv + ι'u(v)` on
`D = B_s(0)`, `F(v) = DΦ(v)`, `b(v) = (F(v)e₁, …, F(v)eₙ)`, `J(v) = √det(F(v)* ∘ F(v))` and
`Pr(x) = ι*(x - z)`, so that `Pr ∘ Φ = id` and `ι* ∘ F(v) = id` (hence `F(v)` is injective and
`J > 0` on `D`).  With `ev` the evaluation of `n`-covectors at `n`-families and `δ` the normalized
determinant covector of `ℝⁿ`, take `ξ(x) = J(Pr x)⁻¹ ev(b(Pr x))` and `β(x) = J(Pr x) (δ ∘ ι*)`.
Both are continuous on `Σ = Φ(D)` because `Pr` maps `Σ` into `D`; `ξ(β) = δ(ι* b) = δ(e) = 1` on
`Σ`; `J(v) ξ(Φ v)(α) = α(b(v))` is the Jacobian identity, and with it the pointwise frame argument
for injective `F(v)` makes `ξ(Φ v)` a unit orientation of `range F(v)`. -/
theorem Submission.dgcr_graph_orientation_jacobian : ∀ (n k : ℕ) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (u : Euclid n → Euclid k) (z : Euclid (n + k)) (s : ℝ), 0 < n → (∀ v w, inner ℝ (ι v) (ι' w) = 0) → 0 < s → ContDiffOn ℝ 1 u (ball 0 s) → ∃ (ξ : Euclid (n + k) → MultiVector (n + k) n) (β : Euclid (n + k) → Covector (Euclid (n + k)) n), ContinuousOn ξ ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s) ∧ ContinuousOn β ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s) ∧ (∀ x ∈ (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s, ξ x (β x) = 1) ∧ (∀ v ∈ ball (0 : Euclid n) s, IsUnitOrientationOf (ξ (z + ι v + ι' (u v))) (LinearMap.range (fderiv ℝ (fun v => z + ι v + ι' (u v)) v : Euclid n →ₗ[ℝ] Euclid (n + k)))) ∧ ∀ v ∈ ball (0 : Euclid n) s, ∀ α : Covector (Euclid (n + k)) n, α (fun i => fderiv ℝ (fun v => z + ι v + ι' (u v)) v (EuclideanSpace.single i (1 : ℝ))) = Real.sqrt (((fderiv ℝ (fun v => z + ι v + ι' (u v)) v).adjoint ∘L fderiv ℝ (fun v => z + ι v + ι' (u v)) v).det) * ξ (z + ι v + ι' (u v)) α := by
  intro n k ι ι' u z s _hn horth _hs hu
  obtain ⟨hadj, hFc, hFinv⟩ := Submission.dgoj_graph_fderiv_left_inverse n k ι ι' u z s horth hu
  obtain ⟨ev, hevc, hev⟩ := Submission.dgoj_exists_continuous_covector_eval (n + k) n
  obtain ⟨δ, hδ⟩ := Submission.dgoj_exists_det_covector n
  -- `ι*`, the projection `Pr`, the derivative `F`, the frame `b`, the Jacobian `J` and `δ ∘ ι*`
  let ιs : Euclid (n + k) →L[ℝ] Euclid n := ι.toContinuousLinearMap.adjoint
  let Pr : Euclid (n + k) → Euclid n := fun x => ιs (x - z)
  let F : Euclid n → Euclid n →L[ℝ] Euclid (n + k) := fderiv ℝ (fun v => z + ι v + ι' (u v))
  let b : Euclid n → Fin n → Euclid (n + k) := fun v i => F v (EuclideanSpace.single i (1 : ℝ))
  let J : Euclid n → ℝ := fun v => Real.sqrt (((F v).adjoint ∘L F v).det)
  let β₀ : Covector (Euclid (n + k)) n := δ.compContinuousLinearMap ιs
  -- `Pr ∘ Φ = id`, so `Pr` maps `Σ = Φ(D)` into `D`
  have hPrΦ : ∀ v, Pr (z + ι v + ι' (u v)) = v := by
    intro v
    show ιs (z + ι v + ι' (u v) - z) = v
    rw [show z + ι v + ι' (u v) - z = ι v + ι' (u v) by abel]
    exact hadj v (u v)
  have hPrc : Continuous Pr := ιs.continuous.comp (continuous_id.sub continuous_const)
  have hmaps : MapsTo Pr ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s) (ball 0 s) := by
    rintro _ ⟨v, hv, rfl⟩
    rw [hPrΦ]
    exact hv
  -- `ι* ∘ F(v) = id` on `D`: `F(v)` is injective, so `J(v) > 0`
  have hinj : ∀ v ∈ ball (0 : Euclid n) s, Injective (F v) := by
    intro v hv x y hxy
    have h := congrArg ιs hxy
    rwa [hFinv v hv x, hFinv v hv y] at h
  have hpos : ∀ v ∈ ball (0 : Euclid n) s, 0 < J v := fun v hv =>
    Real.sqrt_pos.2 (Submission.dgoj_unitOrientation_of_injective (n + k) n (F v) (hinj v hv)).1
  -- continuity of `J` and of `b` on `D`
  have hJc : ContinuousOn J (ball 0 s) := by
    have h1 : ContinuousOn (fun v => (F v).adjoint ∘L F v) (ball 0 s) :=
      ((ContinuousLinearMap.adjoint (𝕜 := ℝ) (E := Euclid n)
        (F := Euclid (n + k))).continuous.comp_continuousOn hFc).clm_comp hFc
    exact Real.continuous_sqrt.comp_continuousOn
      (ContinuousLinearMap.continuous_det.comp_continuousOn h1)
  have hbc : ContinuousOn b (ball 0 s) :=
    continuousOn_pi.2 fun i => hFc.clm_apply continuousOn_const
  -- `(δ ∘ ι*)(b(v)) = δ(e₁, …, eₙ) = 1`
  have hβ₀ : ∀ v ∈ ball (0 : Euclid n) s, β₀ (b v) = 1 := by
    intro v hv
    rw [ContinuousAlternatingMap.compContinuousLinearMap_apply]
    convert hδ using 2
    funext i
    exact hFinv v hv _
  refine ⟨fun x => (J (Pr x))⁻¹ • ev (b (Pr x)), fun x => J (Pr x) • β₀, ?_, ?_, ?_, ?_, ?_⟩
  · exact ((hJc.comp hPrc.continuousOn hmaps).inv₀ fun x hx => (hpos _ (hmaps hx)).ne').smul
      (hevc.comp_continuousOn (hbc.comp hPrc.continuousOn hmaps))
  · exact (hJc.comp hPrc.continuousOn hmaps).smul continuousOn_const
  · rintro _ ⟨v, hv, rfl⟩
    simp only [hPrΦ]
    rw [smul_apply, hev, ContinuousAlternatingMap.smul_apply, hβ₀ v hv,
      smul_eq_mul, smul_eq_mul, mul_one, inv_mul_cancel₀ (hpos v hv).ne']
  · intro v hv
    refine (Submission.dgoj_unitOrientation_of_injective (n + k) n (F v) (hinj v hv)).2 _
      fun α => ?_
    simp only [hPrΦ]
    rw [smul_apply, hev, smul_eq_mul, ← mul_assoc,
      mul_inv_cancel₀ (hpos v hv).ne', one_mul]
  · intro v hv α
    simp only [hPrΦ]
    rw [smul_apply, hev, smul_eq_mul, ← mul_assoc,
      mul_inv_cancel₀ (hpos v hv).ne', one_mul]
/-- **Simon Ch. 3, 1.4** (approximate tangent planes of flat sets): if `Hⁿ((A ∩ B_r(x)) \ S) = 0`
and `S` is flat at `x` along `T` (points `y ∈ S` near `x` lie within `ε‖y - x‖` of `x + T`), then an
approximate tangent plane `Q` of `A` at `x` lies in `T`.  For `y ∈ Q \ T` put `δ = dist(y, T)` and
test with `f = max(0, δ/2 - dist(·, y))`.  For small `λ > 0`, `η_{x,λ}(A) ∩ B̄_{δ/2}(y)` lies in the
`Hⁿ`-null set `η_{x,λ}((A ∩ B_r(x)) \ S)` (points of `S` blow up to within `δ/4` of `T`), so
`∫_{η_{x,λ}(A)} f dHⁿ = 0`.  In the limit `∫_Q f dHⁿ = 0`, contradicting `y ∈ spt Hⁿ⌞Q`. -/
theorem Submission.dgcr_atg_approxTangent_le_of_flat : ∀ (P n : ℕ) (S A : Set (Euclid P)) (x : Euclid P) (r : ℝ) (Q T : Submodule ℝ (Euclid P)), 0 < r → μHE[n] ((A ∩ ball x r) \ S) = 0 → (∀ ε : ℝ, 0 < ε → ∃ ρ : ℝ, 0 < ρ ∧ ∀ y ∈ S, dist y x < ρ → ∃ t ∈ T, ‖y - x - t‖ ≤ ε * ‖y - x‖) → HasApproximateTangentSpaceAt n A x Q → Q ≤ T := by
  intro P n S A x r Q T hr hN hflat hQ y hyQ
  by_contra hyT
  -- `δ = infDist(y, T) > 0`, `T` being closed
  have hδ : 0 < infDist y (T : Set (Euclid P)) :=
    (T.closed_of_finiteDimensional.notMem_iff_infDist_pos ⟨0, T.zero_mem⟩).1 hyT
  obtain ⟨δ, hδdef⟩ : ∃ δ, infDist y (T : Set (Euclid P)) = δ := ⟨_, rfl⟩
  rw [hδdef] at hδ
  -- `R = ‖y‖ + δ` and `ε = δ/(4R)`
  obtain ⟨R, hRdef⟩ : ∃ R : ℝ, ‖y‖ + δ = R := ⟨_, rfl⟩
  have hR : 0 < R := by rw [← hRdef]; exact add_pos_of_nonneg_of_pos (norm_nonneg y) hδ
  obtain ⟨ε, hε, hεR⟩ : ∃ ε : ℝ, 0 < ε ∧ ε * R = δ / 4 :=
    ⟨δ / (4 * R), div_pos hδ (mul_pos four_pos hR), by field_simp⟩
  -- the test function `f = max(0, δ/2 - dist(·, y))`, supported in `B̄_{δ/2}(y)`
  have hf0 : ∀ w ∉ closedBall y (δ / 2), max 0 (δ / 2 - dist w y) = 0 := fun w hw =>
    max_eq_left (by rw [mem_closedBall, not_le] at hw; linarith)
  let f : CompactlySupportedContinuousMap (Euclid P) ℝ :=
    ⟨⟨fun w => max 0 (δ / 2 - dist w y), by fun_prop⟩,
      HasCompactSupport.intro (isCompact_closedBall y (δ / 2)) hf0⟩
  have hf : ∀ w, f w = max 0 (δ / 2 - dist w y) := fun w => rfl
  -- flatness at `ε` gives `ρ`
  obtain ⟨ρ, hρ, hS⟩ := hflat ε hε
  have hlam₀ : 0 < min ρ r / R := div_pos (lt_min hρ hr) hR
  -- for `0 < λ < min(ρ, r)/R` the blow-up integral vanishes
  have hzero : ∀ lam ∈ Ioo 0 (min ρ r / R),
      ∫ w in Poincare.SimonGMT.Chapter03.blowUpMap x lam '' A, f w ∂μHE[n] = 0 := by
    rintro lam ⟨hlam, hlamR⟩
    -- `η_λ(A) ∩ B̄_{δ/2}(y) ⊆ η_λ((A ∩ B_r(x)) \ S)`
    have hsub : closedBall y (δ / 2) ∩ Poincare.SimonGMT.Chapter03.blowUpMap x lam '' A ⊆
        Poincare.SimonGMT.Chapter03.blowUpMap x lam '' ((A ∩ ball x r) \ S) := by
      rintro _ ⟨hw, a, ha, rfl⟩
      have hwa : a - x = lam • Poincare.SimonGMT.Chapter03.blowUpMap x lam a :=
        (smul_inv_smul₀ hlam.ne' (a - x)).symm
      obtain ⟨w, hw_def⟩ : ∃ w, Poincare.SimonGMT.Chapter03.blowUpMap x lam a = w := ⟨_, rfl⟩
      rw [hw_def] at hw hwa
      rw [mem_closedBall] at hw
      -- `‖w‖ < R`, so `‖a - x‖ = λ‖w‖ < min(ρ, r)`
      have hwR : ‖w‖ < R := by
        have := norm_sub_norm_le w y
        rw [← dist_eq_norm] at this
        linarith
      have hax : ‖a - x‖ = lam * ‖w‖ := by rw [hwa, norm_smul_of_nonneg hlam.le]
      have haxlt : ‖a - x‖ < min ρ r := by
        rw [hax]
        exact (mul_lt_mul_of_pos_left hwR hlam).trans ((lt_div_iff₀ hR).1 hlamR)
      refine ⟨a, ⟨⟨ha, ?_⟩, fun haS => ?_⟩, rfl⟩
      · rw [mem_ball, dist_eq_norm]
        exact haxlt.trans_le (min_le_right _ _)
      · -- a point of `S` would put `w` within `δ/4` of `T`
        obtain ⟨t, ht, hat⟩ :=
          hS a haS (by rw [dist_eq_norm]; exact haxlt.trans_le (min_le_left _ _))
        have hwt : dist w (lam⁻¹ • t) = lam⁻¹ * ‖a - x - t‖ := by
          rw [hwa, dist_eq_norm, ← norm_smul_of_nonneg (inv_nonneg.2 hlam.le), smul_sub,
            inv_smul_smul₀ hlam.ne']
        have h1 : infDist w (T : Set (Euclid P)) < δ / 4 :=
          calc infDist w (T : Set (Euclid P)) ≤ dist w (lam⁻¹ • t) :=
                infDist_le_dist_of_mem (T.smul_mem lam⁻¹ ht)
            _ = lam⁻¹ * ‖a - x - t‖ := hwt
            _ ≤ lam⁻¹ * (ε * ‖a - x‖) := mul_le_mul_of_nonneg_left hat (inv_nonneg.2 hlam.le)
            _ = ε * ‖w‖ := by rw [hax]; field_simp
            _ < ε * R := mul_lt_mul_of_pos_left hwR hε
            _ = δ / 4 := hεR
        have h2 : infDist y (T : Set (Euclid P)) ≤ infDist w (T : Set (Euclid P)) + dist y w :=
          infDist_le_infDist_add_dist
        rw [hδdef, dist_comm] at h2
        linarith
    -- `η_λ` is `λ⁻¹`-Lipschitz, so `η_λ((A ∩ B_r(x)) \ S)` is `Hⁿ`-null
    have hlip : LipschitzWith ‖lam⁻¹‖₊ (Poincare.SimonGMT.Chapter03.blowUpMap x lam) :=
      LipschitzWith.of_dist_le_mul fun a b => by
        show dist (lam⁻¹ • (a - x)) (lam⁻¹ • (b - x)) ≤ _
        rw [dist_smul₀, dist_sub_right, coe_nnnorm]
    have hnull :
        μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x lam '' ((A ∩ ball x r) \ S)) = 0 := by
      have h := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn
        (A := (A ∩ ball x r) \ S) n hlip.lipschitzOnWith
      rw [hN, mul_zero] at h
      exact le_antisymm h zero_le
    -- so `f = 0` a.e. for `Hⁿ ⌞ η_λ(A)`
    have hball : ((μHE[n] : Measure (Euclid P)).restrict
        (Poincare.SimonGMT.Chapter03.blowUpMap x lam '' A)) (closedBall y (δ / 2)) = 0 := by
      rw [Measure.restrict_apply measurableSet_closedBall]
      exact measure_mono_null hsub hnull
    apply integral_eq_zero_of_ae
    filter_upwards [measure_eq_zero_iff_ae_notMem.1 hball] with w hw
    rw [hf]
    exact hf0 w hw
  -- hence `∫_Q f dHⁿ = 0`
  have hlim : Tendsto (fun lam : ℝ =>
      ∫ w in Poincare.SimonGMT.Chapter03.blowUpMap x lam '' A, f w ∂μHE[n]) (𝓝[>] 0) (𝓝 0) := by
    refine tendsto_const_nhds.congr' ?_
    filter_upwards [Ioo_mem_nhdsGT hlam₀] with lam hlam
    exact (hzero lam hlam).symm
  have hQ0 : ∫ w in (Q : Set (Euclid P)), f w ∂μHE[n] = 0 := tendsto_nhds_unique (hQ.2 f) hlim
  -- but `∫_Q f dHⁿ > 0`: `Hⁿ ⌞ Q` is locally finite with support `Q ∋ y`, and `f > 0` near `y`
  have := Poincare.SimonGMT.Chapter03.regular_euclideanHausdorffMeasure_restrict_submodule hQ.1
  have hnn : 0 ≤ ⇑f := fun w => by
    show (0 : ℝ) ≤ f w
    rw [hf]
    exact le_max_left _ _
  have hfi : Integrable (⇑f) ((μHE[n] : Measure (Euclid P)).restrict (Q : Set (Euclid P))) :=
    (map_continuous f).integrable_of_hasCompactSupport f.hasCompactSupport
  have hy : y ∈ ((μHE[n] : Measure (Euclid P)).restrict (Q : Set (Euclid P))).support := by
    rw [Poincare.SimonGMT.Chapter03.support_euclideanHausdorffMeasure_restrict_submodule hQ.1]
    exact hyQ
  have hpos : 0 < ∫ w in (Q : Set (Euclid P)), f w ∂μHE[n] := by
    rw [integral_pos_iff_support_of_nonneg hnn hfi]
    refine (Measure.mem_support_iff_forall y).1 hy _
      (mem_of_superset (ball_mem_nhds y (half_pos hδ)) fun w hw => ?_)
    rw [mem_ball] at hw
    rw [Function.mem_support, hf]
    exact (lt_max_of_lt_right (by linarith)).ne'
  exact hpos.ne' hQ0
/-- **Simon 7.4.3** (proof, via Allard's Theorem 5.2 of Ch. 5): the graph `Σ = Φ(D)`,
`Φ(v) = z + ιv + ι'u(v)` with orthogonal linear isometries `ι`, `ι'`, is flat at `Φ(v₀)` along
`range DΦ(v₀)` (the step identifying its approximate tangent plane, Ch. 3, 1.4).  Pythagoras gives
`‖v − v₀‖ ≤ ‖Φ(v) − Φ(v₀)‖`, so points of `Φ(D)` near `Φ(v₀)` come from `v` near `v₀`, where
`t = DΦ(v₀)(v − v₀)` has `‖Φ(v) − Φ(v₀) − t‖ ≤ ε‖v − v₀‖ ≤ ε‖Φ(v) − Φ(v₀)‖`. -/
theorem Submission.dgcr_atg_graph_image_flat : ∀ (n k : ℕ) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (u : Euclid n → Euclid k) (z : Euclid (n + k)) (D : Set (Euclid n)) (v₀ : Euclid n), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → DifferentiableAt ℝ u v₀ → ∀ ε : ℝ, 0 < ε → ∃ ρ : ℝ, 0 < ρ ∧ ∀ y ∈ (fun v => z + ι v + ι' (u v)) '' D, dist y (z + ι v₀ + ι' (u v₀)) < ρ → ∃ t ∈ LinearMap.range (fderiv ℝ (fun v => z + ι v + ι' (u v)) v₀ : Euclid n →ₗ[ℝ] Euclid (n + k)), ‖y - (z + ι v₀ + ι' (u v₀)) - t‖ ≤ ε * ‖y - (z + ι v₀ + ι' (u v₀))‖ := by
  intro n k ι ι' u z D v₀ horth hu ε hε
  set Φ : Euclid n → Euclid (n + k) := fun v => z + ι v + ι' (u v) with hΦ
  -- coercivity: `‖Φ v − Φ v₀‖² = ‖v − v₀‖² + ‖u v − u v₀‖²` by Pythagoras
  have hcoer : ∀ v, ‖v - v₀‖ ≤ ‖Φ v - Φ v₀‖ := by
    intro v
    have hsplit : Φ v - Φ v₀ = ι (v - v₀) + ι' (u v - u v₀) := by
      simp only [hΦ, map_sub]
      abel
    have hpyth : ‖Φ v - Φ v₀‖ * ‖Φ v - Φ v₀‖ =
        ‖v - v₀‖ * ‖v - v₀‖ + ‖u v - u v₀‖ * ‖u v - u v₀‖ := by
      rw [hsplit, ← ι.norm_map (v - v₀), ← ι'.norm_map (u v - u v₀)]
      exact norm_add_sq_eq_norm_sq_add_norm_sq_real (horth _ _)
    exact (mul_self_le_mul_self_iff (norm_nonneg _) (norm_nonneg _)).2
      (hpyth ▸ le_add_of_nonneg_right (mul_self_nonneg _))
  -- `Φ = z + ι + ι' ∘ u` is differentiable at `v₀`
  have hΦd : HasFDerivAt Φ (fderiv ℝ Φ v₀) v₀ :=
    (((differentiableAt_const z).add ι.toContinuousLinearMap.differentiableAt).add
      (ι'.toContinuousLinearMap.differentiableAt.comp v₀ hu)).hasFDerivAt
  -- little-o: `‖Φ v − Φ v₀ − DΦ(v₀)(v − v₀)‖ ≤ ε‖v − v₀‖` whenever `dist v v₀ < ρ`
  obtain ⟨ρ, hρ, hball⟩ := Metric.eventually_nhds_iff.1 (hΦd.isLittleO.bound hε)
  refine ⟨ρ, hρ, ?_⟩
  -- `y = Φ v` with `‖v − v₀‖ ≤ ‖y − Φ v₀‖ < ρ`; take `t = DΦ(v₀)(v − v₀)`
  rintro y ⟨v, -, rfl⟩ hy
  refine ⟨fderiv ℝ Φ v₀ (v - v₀), LinearMap.mem_range_self _ _, ?_⟩
  have hv : dist v v₀ < ρ := by
    rw [dist_eq_norm] at hy ⊢
    exact (hcoer v).trans_lt hy
  calc ‖Φ v - Φ v₀ - fderiv ℝ Φ v₀ (v - v₀)‖ ≤ ε * ‖v - v₀‖ := hball hv
    _ ≤ ε * ‖Φ v - Φ v₀‖ := mul_le_mul_of_nonneg_left (hcoer v) hε.le
/-- Step 1 of identifying the approximate tangent plane of a `C¹` graph (used for Simon 7.4.3):
for linear isometries `ι : ℝⁿ → ℝ^{n+k}`, `ι' : ℝᵏ → ℝ^{n+k}` with `⟨ιv, ι'w⟩ = 0` and `u`
differentiable at `v₀`, the graph map `Φ(v) = z + ιv + ι'u(v)` has `DΦ(v₀) = ι + ι' ∘ Du(v₀)`.
By Pythagoras `‖DΦ(v₀)h‖² = ‖h‖² + ‖Du(v₀)h‖²`, so `DΦ(v₀)` is injective and its range is
`n`-dimensional. -/
theorem Submission.dgcr_atg_graph_tangent_finrank : ∀ (n k : ℕ) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (u : Euclid n → Euclid k) (z : Euclid (n + k)) (v₀ : Euclid n), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → DifferentiableAt ℝ u v₀ → Module.finrank ℝ (LinearMap.range (fderiv ℝ (fun v => z + ι v + ι' (u v)) v₀ : Euclid n →ₗ[ℝ] Euclid (n + k))) = n := by
  intro n k ι ι' u z v₀ horth hu
  -- `DΦ(v₀) = ι + ι' ∘ Du(v₀)` by the sum and chain rules
  have hΦ : HasFDerivAt (fun v => z + ι v + ι' (u v))
      (ι.toContinuousLinearMap + ι'.toContinuousLinearMap ∘L fderiv ℝ u v₀) v₀ :=
    (ι.toContinuousLinearMap.hasFDerivAt.const_add z).add
      (ι'.toContinuousLinearMap.hasFDerivAt.comp v₀ hu.hasFDerivAt)
  rw [hΦ.fderiv]
  -- injectivity: `ιh + ι'(Du(v₀)h) = 0` gives `0 = ‖h‖² + ‖Du(v₀)h‖²`, so `h = 0`
  have hinj : Function.Injective ((ι.toContinuousLinearMap +
      ι'.toContinuousLinearMap ∘L fderiv ℝ u v₀ : Euclid n →L[ℝ] Euclid (n + k)) :
        Euclid n →ₗ[ℝ] Euclid (n + k)) := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro h hh
    have h0 : ι h + ι' (fderiv ℝ u v₀ h) = 0 := by simpa using hh
    have hpyth := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero (𝕜 := ℝ) (ι h)
      (ι' (fderiv ℝ u v₀ h)) (horth _ _)
    rw [h0, norm_zero, ι.norm_map, ι'.norm_map] at hpyth
    have hh0 : ‖h‖ * ‖h‖ = 0 := by
      linarith [mul_self_nonneg ‖h‖, mul_self_nonneg ‖fderiv ℝ u v₀ h‖]
    simpa using hh0
  -- `dim range DΦ(v₀) = dim ℝⁿ = n`
  rw [LinearMap.finrank_range_of_inj hinj, finrank_euclideanSpace_fin]

/-- **Simon Ch. 3, 1.4–1.5** on a `C¹` graph (used for 7.4.3, via Allard's Theorem 5.2 of Ch. 5):
let `Φ(v) = z + ιv + ι'u(v)` with `u` of class `C¹` on `D = B_s(0) ∋ v₀`.  If `Hⁿ`-almost all of
`A ∩ B_r(Φ(v₀))` lies on the graph `Φ(D)`, then an approximate tangent plane `Q` of `A` at
`Φ(v₀)` is the graph's tangent plane `range DΦ(v₀)`.  The graph is flat at `Φ(v₀)` along
`range DΦ(v₀)`, which therefore contains `Q`, and both planes are `n`-dimensional. -/
theorem Submission.dgcr_approxTangent_eq_graph_tangent : ∀ (n k : ℕ) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (u : Euclid n → Euclid k) (z : Euclid (n + k)) (s r : ℝ) (A : Set (Euclid (n + k))) (v₀ : Euclid n) (Q : Submodule ℝ (Euclid (n + k))), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → ContDiffOn ℝ 1 u (ball 0 s) → v₀ ∈ ball (0 : Euclid n) s → 0 < r → μHE[n] ((A ∩ ball (z + ι v₀ + ι' (u v₀)) r) \ ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s)) = 0 → HasApproximateTangentSpaceAt n A (z + ι v₀ + ι' (u v₀)) Q → Q = LinearMap.range (fderiv ℝ (fun v => z + ι v + ι' (u v)) v₀ : Euclid n →ₗ[ℝ] Euclid (n + k)) := by
  intro n k ι ι' u z s r A v₀ Q horth hu hv₀ hr hnull hQ
  -- `u` is `C¹` on the open ball `D ∋ v₀`, hence differentiable at `v₀`
  have hdiff : DifferentiableAt ℝ u v₀ :=
    (hu.differentiableOn one_ne_zero).differentiableAt (isOpen_ball.mem_nhds hv₀)
  -- `Φ(D)` is flat at `Φ(v₀)` along `L = range DΦ(v₀)`, so `Q ≤ L`
  have hle := Submission.dgcr_atg_approxTangent_le_of_flat (n + k) n _ A _ r Q _ hr hnull
    (Submission.dgcr_atg_graph_image_flat n k ι ι' u z (ball (0 : Euclid n) s) v₀ horth hdiff) hQ
  -- `dim Q = n = dim L`
  have hL := Submission.dgcr_atg_graph_tangent_finrank n k ι ι' u z v₀ horth hdiff
  exact Submodule.eq_of_le_of_finrank_eq hle (hQ.finrank_eq.trans hL.symm)
/-- Step 11 of the proof that an integer multiplicity cycle carried by a `C¹` graph is regular
(Simon 7.4.3, via Allard's theorem; orientations `±τ₁ ∧ ⋯ ∧ τₙ` as in Ch. 6, 2.1–2.2): two unit
orientations `ξ₁ = ±τ₁ ∧ ⋯ ∧ τₙ`, `ξ₂ = ±τ'₁ ∧ ⋯ ∧ τ'ₙ` of the same subspace `Q` differ by a
sign.  `τ` and `τ'` are orthonormal bases `b`, `b'` of `Q`; every alternating `n`-form on `Q` is a
multiple of `det_b`, so `α(τ') = det_b(b') α(τ)` for every `n`-covector `α`, and
`det_b(b') = ±1`, the change of orthonormal basis being orthogonal. -/
theorem Submission.dgcr_unitOrientation_eq_or_neg : ∀ (P n : ℕ) (Q : Submodule ℝ (Euclid P)) (ξ₁ ξ₂ : MultiVector P n), IsUnitOrientationOf ξ₁ Q → IsUnitOrientationOf ξ₂ Q → ξ₂ = ξ₁ ∨ ξ₂ = -ξ₁ := by
  rintro P n Q ξ₁ ξ₂ ⟨τ, hτ, hspan, h₁⟩ ⟨τ', hτ', hspan', h₂⟩
  -- an orthonormal frame spanning `Q` is an orthonormal basis of `Q`
  have frame : ∀ σ : Fin n → Euclid P, Orthonormal ℝ σ → Submodule.span ℝ (range σ) = Q →
      ∃ c : OrthonormalBasis (Fin n) ℝ Q, ∀ i, (c i : Euclid P) = σ i := by
    intro σ hσ hσspan
    have hmem : ∀ i, σ i ∈ Q := fun i => hσspan ▸ Submodule.subset_span (mem_range_self i)
    let u : Fin n → Q := fun i => ⟨σ i, hmem i⟩
    have hu : Orthonormal ℝ u := by
      rw [← Q.subtypeₗᵢ.orthonormal_comp_iff (v := u)]
      exact hσ
    have huspan : ⊤ ≤ Submodule.span ℝ (range u) := by
      rintro ⟨y, hy⟩ -
      rw [← hσspan, Submodule.mem_span_range_iff_exists_fun] at hy
      obtain ⟨c, hc⟩ := hy
      rw [Submodule.mem_span_range_iff_exists_fun]
      exact ⟨c, Subtype.ext (by simpa [u] using hc)⟩
    exact ⟨OrthonormalBasis.mk hu huspan, fun i => by simp [u]⟩
  obtain ⟨b, hb⟩ := frame τ hτ hspan
  obtain ⟨b', hb'⟩ := frame τ' hτ' hspan'
  -- `det_b(b') = ±1`
  have hd := b.det_to_matrix_orthonormalBasis_real b'
  -- `α(τ') = det_b(b') α(τ)`: the restriction `α_Q` of `α` to `Q` is `α_Q(b) det_b`
  have hτ'τ : ∀ α : Covector (Euclid P) n, α τ' = b.toBasis.det b' * α τ := by
    intro α
    let f : Q [⋀^Fin n]→ₗ[ℝ] ℝ := α.toAlternatingMap.compLinearMap Q.subtype
    have hf : ∀ (c : OrthonormalBasis (Fin n) ℝ Q) (σ : Fin n → Euclid P),
        (∀ i, (c i : Euclid P) = σ i) → f c = α σ := by
      intro c σ hc
      have hcσ : (fun i => Q.subtype (c i)) = σ := funext hc
      rw [AlternatingMap.compLinearMap_apply, hcσ, ContinuousAlternatingMap.coe_toAlternatingMap]
    have h := congrArg (fun g : Q [⋀^Fin n]→ₗ[ℝ] ℝ => g b') (f.eq_smul_basis_det b.toBasis)
    simp only [AlternatingMap.smul_apply, smul_eq_mul, OrthonormalBasis.coe_toBasis] at h
    rw [← hf b' τ' hb', h, hf b τ hb, mul_comm]
  -- `ξ₂ = ±ξ₁`
  rcases hd with hd | hd <;> rcases h₁ with h₁ | h₁ <;> rcases h₂ with h₂ | h₂
  · left; ext α; rw [h₂, h₁, hτ'τ, hd, one_mul]
  · right; ext α; rw [neg_apply, h₂, h₁, hτ'τ, hd, one_mul]
  · right; ext α; rw [neg_apply, h₂, h₁, hτ'τ, hd, one_mul, neg_neg]
  · left; ext α; rw [h₂, h₁, hτ'τ, hd, one_mul]
  · right; ext α; rw [neg_apply, h₂, h₁, hτ'τ, hd, neg_one_mul]
  · left; ext α; rw [h₂, h₁, hτ'τ, hd, neg_one_mul, neg_neg]
  · left; ext α; rw [h₂, h₁, hτ'τ, hd, neg_one_mul]
  · right; ext α; rw [neg_apply, h₂, h₁, hτ'τ, hd, neg_one_mul, neg_neg]

namespace Submission

/-- The orthogonal cylinder `{z + ιv + ι'w : |v| < s, |w| < h}` is open: with `A = ι*` and
`B = ι'*`, it equals `{x : |A(x − z)| < s} ∩ {x : |B(x − z)| < h}`. -/
theorem dgid_orthogonal_cylinder_isOpen : ∀ (n k : ℕ) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (z : Euclid (n + k)) (s h : ℝ), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → (∀ x : Euclid (n + k), ∃ v : Euclid n, ∃ w : Euclid k, x = ι v + ι' w) → IsOpen {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} := by
  intro n k ι ι' z s h horth hdec
  set A := ι.toContinuousLinearMap.adjoint with hAdef
  set B := ι'.toContinuousLinearMap.adjoint with hBdef
  -- `A (ιv + ι'w) = v` and `B (ιv + ι'w) = w`, tested against every vector.
  have hA : ∀ v w, A (ι v + ι' w) = v := by
    intro v w
    apply ext_inner_right ℝ
    intro v'
    rw [hAdef, ContinuousLinearMap.adjoint_inner_left, inner_add_left,
      LinearIsometry.coe_toContinuousLinearMap, LinearIsometry.inner_map_map,
      real_inner_comm (ι v') (ι' w), horth v' w, add_zero]
  have hB : ∀ v w, B (ι v + ι' w) = w := by
    intro v w
    apply ext_inner_right ℝ
    intro w'
    rw [hBdef, ContinuousLinearMap.adjoint_inner_left, inner_add_left,
      LinearIsometry.coe_toContinuousLinearMap, LinearIsometry.inner_map_map, horth v w', zero_add]
  have hset : {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} =
      {x | ‖A (x - z)‖ < s} ∩ {x | ‖B (x - z)‖ < h} := by
    ext x
    constructor
    · rintro ⟨v, hv, w, hw, rfl⟩
      have e : z + ι v + ι' w - z = ι v + ι' w := by abel
      refine ⟨?_, ?_⟩
      · show ‖A (z + ι v + ι' w - z)‖ < s
        rw [e, hA]; exact mem_ball_zero_iff.mp hv
      · show ‖B (z + ι v + ι' w - z)‖ < h
        rw [e, hB]; exact mem_ball_zero_iff.mp hw
    · rintro ⟨hx1, hx2⟩
      obtain ⟨v, w, hvw⟩ := hdec (x - z)
      have hx1' : ‖A (x - z)‖ < s := hx1
      have hx2' : ‖B (x - z)‖ < h := hx2
      rw [hvw, hA] at hx1'
      rw [hvw, hB] at hx2'
      refine ⟨v, mem_ball_zero_iff.mpr hx1', w, mem_ball_zero_iff.mpr hx2', ?_⟩
      rw [add_assoc, ← hvw]; abel
  rw [hset]
  exact (isOpen_lt (by fun_prop) continuous_const).inter (isOpen_lt (by fun_prop) continuous_const)

end Submission

/-- Steps 2 and 9–12(c) of the proof that an integer multiplicity cycle carried by a `C¹` graph is
regular (Simon 7.4.3, via Allard's theorem): if `spt μ_T ∩ C = Σ := Φ(B_s(0))` for the graph map
`Φ(v) = z + ιv + ι'u(v)` and the cylinder `C ⊆ U`, then on `C` the current `T = τ(M, θ, ξ_R)` is
`ω ↦ ∫_Σ g ⟨ω, ξ⟩ dHⁿ` for an integer density `g`, and `g ∘ Φ` is locally integrable.  As
`Hⁿ(M ∖ spt μ_T) = 0`, `M ∩ C ⊆ Σ` up to an `Hⁿ`-null set; there the approximate tangent plane of
`M` is `range DΦ`, so `ξ_R = ±ξ` and `g := 1_M θ ξ_R(β) = ±θ`; `Φ_#(Lⁿ⌞B_s(0)) ≤ Hⁿ⌞Σ` transfers
integrality and local integrability to `g ∘ Φ`. -/
theorem Submission.dgcr_graph_integer_density_on_graph : ∀ (n k : ℕ) (U : Set (Euclid (n + k))) (T : GeometricCurrentOn U n) (R : IMRep U n) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (u : Euclid n → Euclid k) (z : Euclid (n + k)) (s h : ℝ) (ξ : Euclid (n + k) → MultiVector (n + k) n) (β : Euclid (n + k) → Covector (Euclid (n + k)) n), 0 < n → R.Represents T → (∀ v w, inner ℝ (ι v) (ι' w) = 0) → 0 < s → 0 < h → ContDiffOn ℝ 1 u (ball 0 s) → {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} ⊆ U → R.measure.support ∩ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} = (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s → ContinuousOn β ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s) → (∀ x ∈ (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s, ξ x (β x) = 1) → (∀ v ∈ ball (0 : Euclid n) s, IsUnitOrientationOf (ξ (z + ι v + ι' (u v))) (LinearMap.range (fderiv ℝ (fun v => z + ι v + ι' (u v)) v : Euclid n →ₗ[ℝ] Euclid (n + k)))) → ∃ g : Euclid (n + k) → ℝ, LocallyIntegrableOn (fun v => g (z + ι v + ι' (u v))) (ball (0 : Euclid n) s) volume ∧ (∀ᵐ v ∂(volume.restrict (ball (0 : Euclid n) s)), ∃ m : ℤ, g (z + ι v + ι' (u v)) = m) ∧ ∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid (n + k)) n) ⊆ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} → T ω = ∫ x in (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s, g x * ξ x ((ω : DifferentialForm (Euclid (n + k)) n) x) ∂μHE[n] := by
  intro n k U T R ι ι' u z s h ξ β _hn hRep horth hs _hh hu hCU hsupp hβ hξβ hξ
  -- the cylinder `C` is open (orthogonal coordinates), and `Σ = spt μ_T ∩ C ⊆ C` is Borel
  have hCopen : IsOpen {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h,
      x = z + ι v + ι' w} :=
    dgid_orthogonal_cylinder_isOpen n k ι ι' z s h horth
      (dgcr_orthogonal_coordinates n k ι ι' horth).1
  have hSigC : (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s ⊆
      {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} := by
    rw [← hsupp]; exact inter_subset_right
  have hSigmeas : MeasurableSet ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s) := by
    rw [← hsupp]; exact R.measure.isClosed_support.measurableSet.inter hCopen.measurableSet
  -- `Hⁿ((M ∩ C) ∖ Σ) = 0`, since `Hⁿ(M ∖ spt μ_T) = 0`
  have hnull : μHE[n] ((R.carrier ∩ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h,
      x = z + ι v + ι' w}) \ ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s)) = 0 := by
    refine measure_mono_null ?_ (dgid_carrier_sdiff_measure_support_null (n + k) n U R)
    rintro x ⟨⟨hxM, hxC⟩, hxSig⟩
    refine ⟨hxM, fun hxs => hxSig ?_⟩
    rw [← hsupp]; exact ⟨hxs, hxC⟩
  -- at `Hⁿ`-a.e. `x = Φ(v) ∈ M ∩ Σ` the approximate tangent plane of `M` is `range DΦ(v)`, which
  -- both `ξ_R(x)` and `ξ(x)` orient, so `ξ_R(x) = ±ξ(x)`
  have horient : ∀ᵐ x ∂(μHE[n].restrict
      (R.carrier ∩ (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s)),
      R.orient x = ξ x ∨ R.orient x = -ξ x := by
    have h1 := ae_restrict_of_ae_restrict_of_subset
      (inter_subset_left : R.carrier ∩ (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s ⊆
        R.carrier) R.orients
    filter_upwards [h1, ae_restrict_mem (R.measurableSet_carrier.inter hSigmeas)] with x hx hxmem
    obtain ⟨Q, hQtan, hQor⟩ := hx
    obtain ⟨v, hv, rfl⟩ := hxmem.2
    obtain ⟨r, hr, hrC⟩ := Metric.isOpen_iff.mp hCopen _ (hSigC hxmem.2)
    have hnull' : μHE[n] ((R.carrier ∩ ball (z + ι v + ι' (u v)) r) \
        ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s)) = 0 :=
      measure_mono_null (fun y (hy : y ∈ (R.carrier ∩ ball (z + ι v + ι' (u v)) r) \
        ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s)) => (⟨⟨hy.1.1, hrC hy.1.2⟩, hy.2⟩ :
          y ∈ (R.carrier ∩ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h,
            x = z + ι v + ι' w}) \ ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s))) hnull
    have hQ := dgcr_approxTangent_eq_graph_tangent n k ι ι' u z s r R.carrier v Q horth hu hv hr
      hnull' hQtan
    subst hQ
    exact dgcr_unitOrientation_eq_or_neg (n + k) n _ _ _ (hξ v hv) hQor
  -- the signed density `g = 1_M θ ξ_R(β)` represents `T` on `C` as an integral over `Σ`
  obtain ⟨g, hgm, hgae, hgrep⟩ := dgid_imrep_signed_density_representation (n + k) n U R
    {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w}
    ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s) ξ β hSigmeas hnull
    (hβ.aestronglyMeasurable hSigmeas) hξβ horient
  -- transfer to the disc: `Φ_#(Lⁿ⌞B_s(0)) ≤ Hⁿ⌞Σ`, and `1_M θ` has finite integral over the
  -- compact images `Φ(K) ⊆ C ⊆ U`
  have hΦcont : ContinuousOn (fun v => z + ι v + ι' (u v)) (ball (0 : Euclid n) s) :=
    (continuousOn_const.add ι.continuous.continuousOn).add
      (ι'.continuous.comp_continuousOn hu.continuousOn)
  have hfin : ∀ K : Set (Euclid n), IsCompact K → K ⊆ ball (0 : Euclid n) s →
      ∫⁻ x in (fun v => z + ι v + ι' (u v)) '' K,
        R.carrier.indicator (fun y => (R.mult y : ℝ≥0∞)) x ∂μHE[n] ≠ ∞ := by
    intro K hK hKD
    rw [lintegral_indicator R.measurableSet_carrier, Measure.restrict_restrict R.measurableSet_carrier]
    exact R.locallyIntegrable_mult _ (hK.image_of_continuousOn (hΦcont.mono hKD))
      ((image_mono hKD).trans (hSigC.trans hCU))
  obtain ⟨hloc, hint⟩ := dgid_dominated_pullback_integer_locallyIntegrable n (n + k)
    (fun v => z + ι v + ι' (u v)) (ball (0 : Euclid n) s) g
    (R.carrier.indicator fun y => (R.mult y : ℝ≥0∞)) isOpen_ball hΦcont
    (dgcr_graph_measure_bounds n k ι ι' u z s horth hs hu).1
    ((measurable_from_nat.comp R.measurable_mult).indicator R.measurableSet_carrier) hfin hgm hgae
  refine ⟨g, hloc, hint, fun ω hω => ?_⟩
  rw [hRep ω]
  exact hgrep ω hω
/-- **Normalized mollifier** (step 2 of the smooth-to-`C¹` test reduction): for `r > 0` there is
a `C^∞` function `ρ ≥ 0` on `ℝⁿ` with compact support in `B_r(0)` and `∫ ρ = 1`.  Take the
`ContDiffBump` `B` centred at `0` with `rIn = r/2`, `rOut = r`, so `support B = B_r(0)`; its
integral `I` is positive since `B ≥ 0` and `volume (B_r(0)) > 0`, and `ρ = I⁻¹ B`.  (Mathlib's
`ContDiffBump.normed` is outside the import closure, so the normalization is done by hand.) -/
theorem Submission.dgcr_stc_exists_normalized_mollifier : ∀ (n : ℕ) (r : ℝ), 0 < r → ∃ ρ : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) ρ ∧ HasCompactSupport ρ ∧ (∀ x, 0 ≤ ρ x) ∧ ∫ x, ρ x = 1 ∧ support ρ ⊆ ball (0 : Euclid n) r := by
  intro n r hr
  -- the bump `B` with `rIn = r/2`, `rOut = r`
  let B : ContDiffBump (0 : Euclid n) := ⟨r / 2, r, half_pos hr, half_lt_self hr⟩
  have hBs : HasCompactSupport B := B.hasCompactSupport
  have hBi : Integrable B := B.continuous.integrable_of_hasCompactSupport hBs
  -- `I = ∫ B > 0`: `B ≥ 0` and `support B = B_r(0)` has positive measure
  have hI : 0 < ∫ x, B x := by
    rw [integral_pos_iff_support_of_nonneg (fun x => B.nonneg' x) hBi, B.support_eq]
    exact measure_ball_pos volume 0 hr
  refine ⟨fun x => (∫ y, B y)⁻¹ * B x, contDiff_const.mul B.contDiff, hBs.mul_left,
    fun x => mul_nonneg (inv_nonneg.2 hI.le) (B.nonneg' x), ?_, ?_⟩
  · rw [integral_const_mul, inv_mul_cancel₀ hI.ne']
  · exact (support_mul_subset_right _ _).trans B.support_eq.subset
/-- **An `L¹` pairing that vanishes on uniform approximants vanishes in the limit** (step 5 of the
extension from smooth to `C¹` tests in the graph-cycle regularity step of Simon 7.4.3).  Let
`K ⊆ ℝⁿ` be measurable, `G` integrable on `K` and `f` AE-strongly measurable with `|f| ≤ C` on `K`.
If for every `ε > 0` some AE-strongly measurable `g` with `|f − g| ≤ ε` on `K` has `∫_K G g = 0`,
then `∫_K G f = 0`: `|g| ≤ C + ε` on `K`, so both products are integrable on `K`, and
`|∫_K G f| = |∫_K G (f − g)| ≤ ε ∫_K |G|` for every `ε > 0`. -/
theorem Submission.dgcr_stc_setIntegral_mul_eq_zero_of_uniform_approx : ∀ (n : ℕ) (K : Set (Euclid n)) (G f : Euclid n → ℝ) (C : ℝ), MeasurableSet K → IntegrableOn G K volume → AEStronglyMeasurable f (volume.restrict K) → (∀ x ∈ K, |f x| ≤ C) → (∀ ε : ℝ, 0 < ε → ∃ g : Euclid n → ℝ, AEStronglyMeasurable g (volume.restrict K) ∧ (∀ x ∈ K, |f x - g x| ≤ ε) ∧ ∫ x in K, G x * g x = 0) → ∫ x in K, G x * f x = 0 := by
  intro n K G f C hK hG hf hfC happrox
  -- `M = ∫_K |G| ≥ 0`, and `G f` is integrable on `K` since `|f| ≤ C` on `K`.
  have hM : 0 ≤ ∫ x in K, |G x| := integral_nonneg fun x => abs_nonneg (G x)
  have hGf : Integrable (fun x => G x * f x) (volume.restrict K) :=
    Integrable.mul_bdd hG hf (ae_restrict_of_forall_mem hK fun x hx => hfC x hx)
  -- `|∫_K G f| ≤ ε M` for every `ε > 0`.
  have hbound : ∀ ε : ℝ, 0 < ε → |∫ x in K, G x * f x| ≤ ε * ∫ x in K, |G x| := by
    intro ε hε
    obtain ⟨g, hg, hfg, hGg⟩ := happrox ε hε
    -- `|g| ≤ |f| + |f − g| ≤ C + ε` on `K`, so `G g` is integrable on `K`.
    have hGg_int : Integrable (fun x => G x * g x) (volume.restrict K) :=
      Integrable.mul_bdd (c := C + ε) hG hg (ae_restrict_of_forall_mem hK fun x hx => by
        have h1 := abs_le.mp (hfC x hx)
        have h2 := abs_le.mp (hfg x hx)
        rw [Real.norm_eq_abs]
        exact abs_le.mpr ⟨by linarith [h1.1, h2.2], by linarith [h1.2, h2.1]⟩)
    -- `∫_K G f = ∫_K G f − ∫_K G g = ∫_K G (f − g)`.
    have heq : ∫ x in K, G x * f x = ∫ x in K, G x * (f x - g x) := by
      simp_rw [mul_sub]
      rw [integral_sub hGf hGg_int, hGg, sub_zero]
    -- `|G (f − g)| ≤ |G| ε` on `K`.
    rw [heq]
    calc |∫ x in K, G x * (f x - g x)| ≤ ∫ x in K, |G x| * ε :=
          norm_integral_le_of_norm_le ((Integrable.abs hG).mul_const ε)
            (ae_restrict_of_forall_mem hK fun x hx => by
              rw [Real.norm_eq_abs, abs_mul]
              exact mul_le_mul_of_nonneg_left (hfg x hx) (abs_nonneg _))
      _ = ε * ∫ x in K, |G x| := by rw [integral_mul_const, mul_comm]
  -- If `a = |∫_K G f| > 0`, then `ε = a / (2(M + 1))` gives `a ≤ a M / (2(M + 1)) < a`.
  by_contra hne
  set M := ∫ x in K, |G x|
  set a := |∫ x in K, G x * f x|
  have ha : 0 < a := abs_pos.mpr hne
  have hpos : 0 < 2 * (M + 1) := by linarith
  have h := hbound (a / (2 * (M + 1))) (div_pos ha hpos)
  rw [div_mul_eq_mul_div, le_div_iff₀ hpos] at h
  nlinarith
/-- **Chart lemma** (Simon Ch. 2, §4, (4.1)–(4.3)).  Let `ψ` be a chart of `N` as in
`IsEmbeddedSubmanifold`: `Cʳ` (`r ≥ 1`) and injective on the open `V`, `ψ(V) = W ∩ N`, proper,
with `Dψ` injective on `V`.  For `v ∈ V`, `q = ψ(v)` and `A = Dψ(v)`: (i) `T_qN = A(ℝᵈ)`;
(ii) `ψ⁻¹` is continuous at `q`; (iii) every `y ∈ N` near `q` has `|y − q − Aa| ≤ ε|y − q|` for
some `a`.  (ii) is `dsmc_chart_inverse_continuity` (properness and injectivity), (iii) is
`dsmc_chart_secant_estimate` (differentiability at `v`, injectivity of `A` and (ii)), and (i)
combines `dsmc_tangentSpace_subset_range_of_secant` (by (iii), curve velocities lie in the closed
subspace `A(ℝᵈ)`) with `dsmc_chart_range_subset_tangentSpace` (the curves `t ↦ ψ(v + h(t)a)`). -/
theorem Submission.dsmc_chart_tangentSpace_eq_range : ∀ (P r d : ℕ) (N : Set (Euclid P)) (V : Set (Euclid d)) (W : Set (Euclid P)) (ψ : Euclid d → Euclid P), 1 ≤ r → IsOpen V → IsOpen W → ContDiffOn ℝ r ψ V → InjOn ψ V → ψ '' V = W ∩ N → (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → (∀ z ∈ V, Injective (fderiv ℝ ψ z)) → ∀ v ∈ V, tangentSpace N (ψ v) = Set.range (fderiv ℝ ψ v) ∧ (∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ v' ∈ V, dist (ψ v') (ψ v) < δ → dist v' v < ε) ∧ (∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ y ∈ N, dist y (ψ v) < δ → ∃ a : Euclid d, ‖y - ψ v - fderiv ℝ ψ v a‖ ≤ ε * ‖y - ψ v‖) := by
  intro P r d N V W ψ hr hV hW hψ hinj himg hprop hDψ v hv
  -- (ii): properness and injectivity of `ψ` on `V` make `ψ⁻¹` continuous at `ψ v`
  have hii : ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧
      ∀ v' ∈ V, dist (ψ v') (ψ v) < δ → dist v' v < ε :=
    Submission.dsmc_chart_inverse_continuity P d V W ψ hψ.continuousOn hinj
      (himg.subset.trans inter_subset_left) hprop v hv
  -- `ψ` is `C¹` on the open set `V ∋ v`, so `A = fderiv ℝ ψ v` is its derivative at `v`
  have hA : HasFDerivAt ψ (fderiv ℝ ψ v) v :=
    (hψ.differentiableOn (by exact_mod_cast Nat.one_le_iff_ne_zero.mp hr)).hasFDerivAt
      (hV.mem_nhds hv)
  -- (iii): the secant estimate at `ψ v`, from `hA`, injectivity of `A` and (ii)
  have hiii := Submission.dsmc_chart_secant_estimate P d N V W ψ (fderiv ℝ ψ v) v hW himg hv hA
    (hDψ v hv) hii
  -- (i): `T_{ψ v}N ⊆ A(ℝᵈ)` by (iii); `A(ℝᵈ) ⊆ T_{ψ v}N` since `ψ '' V ⊆ N`
  exact ⟨Set.Subset.antisymm
      (Submission.dsmc_tangentSpace_subset_range_of_secant P d N (ψ v) (fderiv ℝ ψ v) hiii)
      (Submission.dsmc_chart_range_subset_tangentSpace P r d N V ψ hr hV hψ
        (himg.subset.trans inter_subset_right) v hv),
    hii, hiii⟩

/-- **A `C¹` field of tangent projections near a point of a `C²` submanifold** (Simon Ch. 4,
2.5–2.7; Ch. 2, 5.9).  Near `y₀ ∈ N ∩ U` there is a `C¹` field `Pt` of self-adjoint operators with
`‖DPt‖ ≤ β` on `B_{2r}(y₀)` such that `Pt(q)` is the orthogonal projection onto `T_qN` for every
`q ∈ N ∩ B_{3r}(y₀)`.  Instead of the nearest-point projection of a tubular neighbourhood we use a
`C¹` retraction parameter built from a `C²` chart `ψ : V → W`, `ψ(v₀) = y₀`: `Pt(y) = G(Dψ(σ(y)))`,
where `G(B) = B (B*B)⁻¹ B*` is the orthogonal projection onto `range B` and `σ = λ ∘ L` with `L` a
linear left inverse of `Dψ(v₀)` and `λ` a local inverse of `L ∘ ψ` (inverse function theorem), so
that `σ(ψ(z)) = z` near `v₀`.  `dsmc_chart_tangentSpace_eq_range` gives `T_{ψ(z)}N = range Dψ(z)`
and the continuity of `ψ⁻¹` at `y₀`; `β` bounds `‖DPt‖` on the compact `B̄_{2r}(y₀)`. -/
theorem Submission.dsmc_tangent_projection_field : ∀ (P d : ℕ) (U N : Set (Euclid P)) (y₀ : Euclid P), IsOpen U → IsEmbeddedSubmanifold 2 d N → y₀ ∈ N ∩ U → ∃ (r β : ℝ) (Pt : Euclid P → (Euclid P →L[ℝ] Euclid P)), 0 < r ∧ 0 ≤ β ∧ closedBall y₀ (3 * r) ⊆ U ∧ ContDiffOn ℝ 1 Pt (ball y₀ (3 * r)) ∧ (∀ y ∈ ball y₀ (3 * r), ∀ u w : Euclid P, inner ℝ (Pt y u) w = inner ℝ u (Pt y w)) ∧ (∀ y ∈ ball y₀ (2 * r), ‖fderiv ℝ Pt y‖ ≤ β) ∧ (∀ q ∈ N ∩ ball y₀ (3 * r), ∀ u : Euclid P, Pt q u ∈ tangentSpace N q) ∧ (∀ q ∈ N ∩ ball y₀ (3 * r), ∀ u ∈ tangentSpace N q, Pt q u = u) := by
  intro P d U N y₀ hU hN hy₀
  -- Step 1: a `C²` chart `ψ : V → W` with `y₀ = ψ(v₀)`; `T_{ψ(z)}N = range Dψ(z)` and `ψ⁻¹` is
  -- continuous at `y₀` (chart lemma); `z ↦ Dψ(z)` is `C¹` on `V`
  obtain ⟨hy₀N, hy₀U⟩ := hy₀
  obtain ⟨V, W, ψ, hV, hW, hy₀W, hψ, hinj, himg, hprop, hDψ⟩ := hN y₀ hy₀N
  obtain ⟨v₀, hv₀V, rfl⟩ : y₀ ∈ ψ '' V := by rw [himg]; exact ⟨hy₀W, hy₀N⟩
  have hchart := Submission.dsmc_chart_tangentSpace_eq_range P 2 d N V W ψ (by norm_num) hV hW hψ
    hinj himg hprop hDψ
  have hA : ContDiffOn ℝ 1 (fun z => fderiv ℝ ψ z) V := hψ.fderiv_of_isOpen hV (by norm_num)
  -- Step 2: for injective `B`, `G(B) = B (B*B)⁻¹ B*` is `C¹` near `B`, self-adjoint, maps into
  -- `range B` and fixes `range B` pointwise
  obtain ⟨G, hG⟩ : ∃ G : (Euclid d →L[ℝ] Euclid P) → (Euclid P →L[ℝ] Euclid P),
      ∀ B : Euclid d →L[ℝ] Euclid P, Injective B → ContDiffAt ℝ 1 G B ∧
        (∀ u w : Euclid P, inner ℝ (G B u) w = inner ℝ u (G B w)) ∧
        (∀ u : Euclid P, G B u ∈ Set.range B) ∧ ∀ a : Euclid d, G B (B a) = B a := by
    -- the real adjoint `B ↦ B*` as a continuous linear map
    let adjL : (Euclid d →L[ℝ] Euclid P) →L[ℝ] (Euclid P →L[ℝ] Euclid d) :=
      { toFun := fun B => ContinuousLinearMap.adjoint B
        map_add' := fun B C => by simp
        map_smul' := fun c B => by simp
        cont := ContinuousLinearMap.adjoint.continuous }
    have hadj : ∀ B, adjL B = ContinuousLinearMap.adjoint B := fun B => rfl
    refine ⟨fun B => B ∘L (Ring.inverse (adjL B ∘L B) ∘L adjL B), fun B hB => ?_⟩
    -- `C = B*B` is self-adjoint with `⟨C a, a⟩ = ‖B a‖²`, hence injective and a unit
    set C : Euclid d →L[ℝ] Euclid d := adjL B ∘L B with hC_def
    have hCsymm : ∀ x y : Euclid d, inner ℝ (C x) y = inner ℝ x (C y) := by
      intro x y
      simp only [hC_def, ContinuousLinearMap.comp_apply, hadj]
      rw [ContinuousLinearMap.adjoint_inner_left, ContinuousLinearMap.adjoint_inner_right]
    have hCinj : Injective C := by
      intro x y hxy
      have h0 : C (x - y) = 0 := by rw [map_sub, hxy, sub_self]
      have h1 : inner ℝ (C (x - y)) (x - y) = ‖B (x - y)‖ ^ 2 := by
        simp only [hC_def, ContinuousLinearMap.comp_apply, hadj]
        rw [ContinuousLinearMap.adjoint_inner_left, real_inner_self_eq_norm_sq]
      rw [h0, inner_zero_left] at h1
      have h2 : B (x - y) = 0 := by
        have : ‖B (x - y)‖ = 0 := by nlinarith [norm_nonneg (B (x - y))]
        exact norm_eq_zero.1 this
      exact sub_eq_zero.1 (hB (by rw [h2, map_zero]))
    have hCunit : IsUnit C := by
      rw [ContinuousLinearMap.isUnit_iff_bijective]
      exact ⟨hCinj, LinearMap.injective_iff_surjective.1 hCinj⟩
    -- `C⁻¹` is a two-sided inverse of `C`, and self-adjoint
    set Ci := Ring.inverse C
    have hCiC : ∀ x, Ci (C x) = x := fun x => by
      have := Ring.inverse_mul_cancel C hCunit
      simpa using congrArg (fun T : Euclid d →L[ℝ] Euclid d => T x) this
    have hCCi : ∀ x, C (Ci x) = x := fun x => by
      have := Ring.mul_inverse_cancel C hCunit
      simpa using congrArg (fun T : Euclid d →L[ℝ] Euclid d => T x) this
    have hCisymm : ∀ x y : Euclid d, inner ℝ (Ci x) y = inner ℝ x (Ci y) := by
      intro x y
      calc inner ℝ (Ci x) y = inner ℝ (Ci x) (C (Ci y)) := by rw [hCCi]
        _ = inner ℝ (C (Ci x)) (Ci y) := (hCsymm _ _).symm
        _ = inner ℝ x (Ci y) := by rw [hCCi]
    refine ⟨?_, ?_, fun u => ⟨_, rfl⟩, ?_⟩
    · -- `B' ↦ B'*B'` is smooth and `Ring.inverse` is smooth at the unit `C`
      obtain ⟨u, hu⟩ := hCunit
      have hinv : ContDiffAt ℝ 1
          (fun B' : Euclid d →L[ℝ] Euclid P => Ring.inverse (adjL B' ∘L B')) B := by
        have h1 : ContDiffAt ℝ 1 (fun B' : Euclid d →L[ℝ] Euclid P => adjL B' ∘L B') B :=
          adjL.contDiff.contDiffAt.clm_comp contDiffAt_id
        have h2 : ContDiffAt ℝ 1 Ring.inverse (adjL B ∘L B) := by
          have := contDiffAt_ringInverse ℝ (n := 1) u
          rw [hu] at this
          exact this
        exact ContDiffAt.comp (g := Ring.inverse)
          (f := fun B' : Euclid d →L[ℝ] Euclid P => adjL B' ∘L B') B h2 h1
      exact contDiffAt_id.clm_comp (hinv.clm_comp adjL.contDiff.contDiffAt)
    · intro u w
      simp only [ContinuousLinearMap.comp_apply]
      rw [← ContinuousLinearMap.adjoint_inner_right, ← hadj, hCisymm,
        hadj, ContinuousLinearMap.adjoint_inner_left]
      rfl
    · intro a
      simp only [ContinuousLinearMap.comp_apply]
      have : adjL B (B a) = C a := rfl
      rw [this, hCiC]
  -- Steps 3–4: a `C¹` map `σ` on an open `O ∋ y₀`, with values in `V`, such that `σ(ψ(z)) = z`
  -- for `z` in an open `O₁ ∋ v₀`.  A continuous linear left inverse `L` of `A = Dψ(v₀)` plays
  -- the role of the projection onto `T_{y₀}N = range A` (e.g. `L = A⁻¹ ∘ p_{range A}`), so
  -- `f = L ∘ ψ` has `Df(v₀) = id`; `λ` is the local inverse of `f` given by the inverse function
  -- theorem, restricted to an open set on which it is `C¹` and maps into `V`, and `σ = λ ∘ L`.
  obtain ⟨O, O₁, σ, hO, hO₁, hv₀O₁, hσ, hσV, hσψ⟩ : ∃ (O : Set (Euclid P)) (O₁ : Set (Euclid d))
      (σ : Euclid P → Euclid d), IsOpen O ∧ IsOpen O₁ ∧ v₀ ∈ O₁ ∧ ContDiffOn ℝ 1 σ O ∧
        MapsTo σ O V ∧ ∀ z ∈ O₁, ψ z ∈ O ∧ σ (ψ z) = z := by
    set A := fderiv ℝ ψ v₀
    obtain ⟨L₀, hL₀⟩ := LinearMap.exists_leftInverse_of_injective (A : Euclid d →ₗ[ℝ] Euclid P)
      (LinearMap.ker_eq_bot.2 (hDψ v₀ hv₀V))
    let L : Euclid P →L[ℝ] Euclid d := LinearMap.toContinuousLinearMap L₀
    have hLA : ∀ a, L (A a) = a := fun a => by
      have := LinearMap.congr_fun hL₀ a
      simpa [L] using this
    set f : Euclid d → Euclid d := fun z => L (ψ z)
    have hψat : ContDiffAt ℝ 1 ψ v₀ := (hψ.contDiffAt (hV.mem_nhds hv₀V)).of_le (by norm_num)
    have hfat : ContDiffAt ℝ 1 f v₀ := L.contDiff.contDiffAt.comp v₀ hψat
    have hderiv0 : HasFDerivAt f (L ∘L A) v₀ :=
      L.hasFDerivAt.comp v₀ (hψat.differentiableAt (by norm_num)).hasFDerivAt
    have hLA' : L ∘L A =
        ((ContinuousLinearEquiv.refl ℝ (Euclid d) : Euclid d ≃L[ℝ] Euclid d) :
          Euclid d →L[ℝ] Euclid d) := by
      ext1 a
      simp [hLA]
    have hderiv : HasFDerivAt f
        ((ContinuousLinearEquiv.refl ℝ (Euclid d) : Euclid d ≃L[ℝ] Euclid d) :
          Euclid d →L[ℝ] Euclid d) v₀ :=
      hLA' ▸ hderiv0
    have hstrict : HasStrictFDerivAt f
        ((ContinuousLinearEquiv.refl ℝ (Euclid d) : Euclid d ≃L[ℝ] Euclid d) :
          Euclid d →L[ℝ] Euclid d) v₀ :=
      hfat.hasStrictFDerivAt' hderiv one_ne_zero
    -- the inverse function theorem: a partial homeomorphism `e = f` near `v₀`
    set e := HasStrictFDerivAt.toOpenPartialHomeomorph f hstrict
    have he_coe : (e : Euclid d → Euclid d) = f := rfl
    have hv₀src : v₀ ∈ e.source := hstrict.mem_toOpenPartialHomeomorph_source
    have hfv₀tgt : f v₀ ∈ e.target := hstrict.image_mem_toOpenPartialHomeomorph_target
    have hsymm_v₀ : e.symm (f v₀) = v₀ := e.left_inv hv₀src
    have hsymm : ContDiffAt ℝ 1 e.symm (f v₀) := by
      refine e.contDiffAt_symm (f₀' := ContinuousLinearEquiv.refl ℝ (Euclid d)) hfv₀tgt ?_ ?_
      · rw [hsymm_v₀]; exact hderiv
      · rw [hsymm_v₀]; exact hfat
    -- `O₂ ∋ f(v₀)` open, inside the target, on which `e⁻¹` is `C¹` with values in `V`
    have hev : ∀ᶠ w in 𝓝 (f v₀), ContDiffAt ℝ 1 e.symm w := hsymm.eventually (by simp)
    have hpre : e.symm ⁻¹' V ∈ 𝓝 (f v₀) :=
      (e.continuousAt_symm hfv₀tgt).preimage_mem_nhds (by rw [hsymm_v₀]; exact hV.mem_nhds hv₀V)
    have hnhds : e.target ∩ (e.symm ⁻¹' V ∩ {w | ContDiffAt ℝ 1 e.symm w}) ∈ 𝓝 (f v₀) :=
      Filter.inter_mem (e.open_target.mem_nhds hfv₀tgt) (Filter.inter_mem hpre hev)
    obtain ⟨O₂, hO₂sub, hO₂open, hfv₀O₂⟩ := _root_.mem_nhds_iff.1 hnhds
    -- `O = L⁻¹(O₂)`, `O₁ = e.source ∩ f⁻¹(O₂)`, `σ = e⁻¹ ∘ L`
    refine ⟨L ⁻¹' O₂, e.source ∩ f ⁻¹' O₂, fun y => e.symm (L y), hO₂open.preimage L.continuous,
      ?_, ⟨hv₀src, hfv₀O₂⟩, ?_, fun y hy => (hO₂sub hy).2.1, ?_⟩
    · have : ContinuousOn f e.source := by rw [← he_coe]; exact e.continuousOn
      exact this.isOpen_inter_preimage e.open_source hO₂open
    · intro y hy
      have h1 : ContDiffAt ℝ 1 e.symm (L y) := (hO₂sub hy).2.2
      exact (h1.comp y L.contDiff.contDiffAt).contDiffWithinAt
    · rintro z ⟨hzsrc, hzO₂⟩
      refine ⟨hzO₂, ?_⟩
      show e.symm (f z) = z
      rw [← he_coe]
      exact e.left_inv hzsrc
  -- Step 5: `Pt(y) = G(Dψ(σ(y)))` is `C¹` on `O`
  set Pt : Euclid P → (Euclid P →L[ℝ] Euclid P) := fun y => G (fderiv ℝ ψ (σ y))
  have hPtO : ContDiffOn ℝ 1 Pt O := fun y hy =>
    (hG _ (hDψ _ (hσV hy))).1.comp_contDiffWithinAt y ((hA (σ y) (hσV hy)).comp y (hσ y hy) hσV)
  -- Step 6: `B_{ε₁}(v₀) ⊆ O₁`; `z ∈ V`, `|ψ(z) − y₀| < δ₁` give `|z − v₀| < ε₁`; choose `r > 0`
  -- with `3r ≤ δ₁` and `B̄_{3r}(y₀) ⊆ U ∩ W ∩ O`
  obtain ⟨ε₁, hε₁, hball⟩ := Metric.isOpen_iff.1 hO₁ v₀ hv₀O₁
  obtain ⟨δ₁, hδ₁, hδ₁'⟩ := (hchart v₀ hv₀V).2.1 ε₁ hε₁
  obtain ⟨ρ, hρ, hρsub⟩ := Metric.isOpen_iff.1 ((hU.inter hW).inter hO) (ψ v₀)
    ⟨⟨hy₀U, hy₀W⟩, (hσψ v₀ hv₀O₁).1⟩
  set r := min (ρ / 6) (δ₁ / 3)
  have hr : 0 < r := lt_min (by linarith) (by linarith)
  have h3r : 3 * r < ρ := by have := min_le_left (ρ / 6) (δ₁ / 3); linarith
  have h3rδ : 3 * r ≤ δ₁ := by have := min_le_right (ρ / 6) (δ₁ / 3); linarith
  have hcl : closedBall (ψ v₀) (3 * r) ⊆ U ∩ W ∩ O := (closedBall_subset_ball h3r).trans hρsub
  have hballO : ball (ψ v₀) (3 * r) ⊆ O :=
    ball_subset_closedBall.trans (hcl.trans inter_subset_right)
  have hPt3 : ContDiffOn ℝ 1 Pt (ball (ψ v₀) (3 * r)) := hPtO.mono hballO
  -- Step 7: `DPt` is continuous on `B_{3r}(y₀)`, hence bounded on the compact `B̄_{2r}(y₀)`
  have hcont2 : ContinuousOn (fderiv ℝ Pt) (closedBall (ψ v₀) (2 * r)) :=
    (hPt3.continuousOn_fderiv_of_isOpen isOpen_ball le_rfl).mono
      (closedBall_subset_ball (show 2 * r < 3 * r by linarith))
  obtain ⟨C, hC⟩ := IsCompact.exists_bound_of_continuousOn
    (E := Euclid P →L[ℝ] Euclid P →L[ℝ] Euclid P) (isCompact_closedBall (ψ v₀) (2 * r)) hcont2
  -- Step 8: `q ∈ N ∩ B_{3r}(y₀)` is `ψ(z)` with `z ∈ O₁`, so `Pt(q) = G(Dψ(z))` and
  -- `T_qN = range Dψ(z)`
  have hNq : ∀ q ∈ N ∩ ball (ψ v₀) (3 * r), ∃ z ∈ V,
      Pt q = G (fderiv ℝ ψ z) ∧ tangentSpace N q = Set.range (fderiv ℝ ψ z) := by
    rintro q ⟨hqN, hqB⟩
    obtain ⟨z, hzV, rfl⟩ : q ∈ ψ '' V := by
      rw [himg]; exact ⟨(hcl (ball_subset_closedBall hqB)).1.2, hqN⟩
    have hzO₁ : z ∈ O₁ := hball (mem_ball.2 (hδ₁' z hzV (lt_of_lt_of_le (mem_ball.1 hqB) h3rδ)))
    refine ⟨z, hzV, ?_, (hchart z hzV).1⟩
    show G (fderiv ℝ ψ (σ (ψ z))) = G (fderiv ℝ ψ z)
    rw [(hσψ z hzO₁).2]
  -- Step 9: assemble, with `β = max C 0`
  refine ⟨r, max C 0, Pt, hr, le_max_right _ _, fun y hy => (hcl hy).1.1, hPt3,
    fun y hy u w => (hG _ (hDψ _ (hσV (hballO hy)))).2.1 u w,
    fun y hy => (hC y (ball_subset_closedBall hy)).trans (le_max_left _ _), ?_, ?_⟩
  · intro q hq u
    obtain ⟨z, hzV, hPtq, hTq⟩ := hNq q hq
    rw [hPtq, hTq]
    exact (hG _ (hDψ z hzV)).2.2.1 u
  · intro q hq u hu
    obtain ⟨z, hzV, hPtq, hTq⟩ := hNq q hq
    rw [hTq] at hu
    obtain ⟨a, rfl⟩ := hu
    rw [hPtq]
    exact (hG _ (hDψ z hzV)).2.2.2 a
/-- **Approximate tangent planes of a set carried by a `Cʳ` submanifold lie in its tangent
spaces** (Simon Ch. 3, 1.4–1.5, chapter-03.txt lines 75–90; Ch. 2, 4.1 and 4.3, chapter-02.txt
lines 850–871).  Let `N` be an embedded `Cʳ` `d`-submanifold of `ℝᴾ`, `r ≥ 1`, let `x ∈ N`, let
`Hⁿ(M \ N) = 0` and let `Q` be an approximate tangent space of `M` at `x`.  Then `Q ⊆ T_xN`.
A chart `ψ` of `N` with `x = ψ(v₀)` gives `T_xN = Dψ(v₀)(ℝᵈ)` and the secant estimate
`|y − x − Dψ(v₀)a| ≤ ε|y − x|` for `y ∈ N` near `x`.  Every `w ∈ Q` is, at every small scale `λ`,
within `s` of a rescaled secant `λ⁻¹(y − x)` with `y ∈ M ∩ N`; hence `w ∈ Dψ(v₀)(ℝᵈ)`. -/
theorem Submission.dsmc_approxTangentPlane_subset_tangentSpace : ∀ (P n r d : ℕ) (M N : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)), 1 ≤ r → IsEmbeddedSubmanifold r d N → x ∈ N → μHE[n] (M \ N) = 0 → HasApproximateTangentSpaceAt n M x Q → (Q : Set (Euclid P)) ⊆ tangentSpace N x := by
  intro P n r d M N x Q hr hN hxN hMN hQ
  -- a chart `ψ : V → W` of `N` at `x`; `x ∈ W ∩ N = ψ(V)`, so `x = ψ(v₀)` with `v₀ ∈ V`
  obtain ⟨V, W, ψ, hV, hW, hxW, hψ, hinj, himg, hprop, hrank⟩ := hN x hxN
  obtain ⟨v₀, hv₀, rfl⟩ : x ∈ ψ '' V := by
    rw [himg]
    exact ⟨hxW, hxN⟩
  -- `T_xN = Dψ(v₀)(ℝᵈ)`, and `N` satisfies the secant estimate at `x` for `Dψ(v₀)`
  obtain ⟨hT, -, hsec⟩ := Submission.dsmc_chart_tangentSpace_eq_range P r d N V W ψ hr hV hW hψ
    hinj himg hprop hrank v₀ hv₀
  intro w hw
  rw [hT]
  -- the blow-up points `y ∈ M ∩ N` with `|λ⁻¹(y − x) − w| < s`, `0 < λ < λ₀`, lie in `N`
  refine Submission.dsmc_att_mem_range_of_secant_blowUp P d N (ψ v₀) w (fderiv ℝ ψ v₀) hsec
    fun s hs => ?_
  obtain ⟨lam₀, hlam₀, hpts⟩ :=
    Submission.dsmc_att_blowUp_points_of_approxTangent P n M N (ψ v₀) w Q hMN hQ hw s hs
  refine ⟨lam₀, hlam₀, fun lam hlam hlt => ?_⟩
  obtain ⟨y, hy, hyw⟩ := hpts lam hlam hlt
  exact ⟨y, hy.2, hyw⟩
/-- **Cut-off quadratic moments over `n`-planes** (the constant `cₙ` of the measurability proof
for the approximate tangent planes of Simon Ch. 3, 1.4).  For `n ≥ 1` one constant `c > 0`,
depending only on `n`, gives `∫_Q max(1 − |y|², 0)⟨u, y⟩² dHⁿ(y) = c|p_Q u|²` for every `P`,
every `n`-dimensional subspace `Q ⊆ ℝᴾ` and every `u ∈ ℝᴾ`.  On `ℝⁿ` put
`q(w) = ∫ max(1 − |z|², 0)⟨w, z⟩² dHⁿ(z)` and `c = q(e)`, `|e| = 1`: linear isometries preserve
`Hⁿ`, so `q` is invariant under them, `q(tw) = t²q(w)`, and a reflection maps `|w|e` to `w`,
whence `q(w) = c|w|²`; `c > 0` since the integrand is continuous, `≥ 0`, compactly supported and
`3/16` at `e/2`.  An isometry `ι = L⁻¹ : ℝⁿ → Q ⊆ ℝᴾ` carries `Hⁿ` to `Hⁿ⌞Q`, and
`⟨u, ι z⟩ = ⟨L(p_Q u), z⟩`, so the integral is `q(L(p_Q u)) = c|p_Q u|²`. -/
theorem Submission.exists_plane_cutoff_quadratic_moment_eq : ∀ n : ℕ, 0 < n → ∃ c : ℝ, 0 < c ∧ ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)), Module.finrank ℝ Q = n → ∀ u : Euclid P, ∫ y in (Q : Set (Euclid P)), max (1 - ‖y‖ ^ 2) 0 * inner ℝ u y ^ 2 ∂μHE[n] = c * ‖Q.starProjection u‖ ^ 2 := by
  intro n hn
  -- The moment `q(w)` on the model plane `ℝⁿ`; the constant is `c = q(e)` for a unit vector `e`.
  obtain ⟨q, hq_def⟩ : ∃ q : Euclid n → ℝ,
      ∀ w, q w = ∫ z, max (1 - ‖z‖ ^ 2) 0 * inner ℝ w z ^ 2 ∂μHE[n] :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨e, he⟩ : ∃ e : Euclid n, ‖e‖ = 1 := ⟨EuclideanSpace.single ⟨0, hn⟩ 1, by simp⟩
  -- `q(Rw) = q(w)` for a linear isometry `R`: substitute `z = Rz'`, `R` preserves `Hⁿ`.
  have hq_iso : ∀ (R : Euclid n ≃ₗᵢ[ℝ] Euclid n) (w : Euclid n), q (R w) = q w := by
    intro R w
    have key : ∫ z, max (1 - ‖R z‖ ^ 2) 0 * inner ℝ (R w) (R z) ^ 2 ∂μHE[n] =
        ∫ z, max (1 - ‖z‖ ^ 2) 0 * inner ℝ (R w) z ^ 2 ∂μHE[n] :=
      (R.toIsometryEquiv.measurePreserving_euclideanHausdorffMeasure n).integral_comp
        R.toHomeomorph.measurableEmbedding (fun y => max (1 - ‖y‖ ^ 2) 0 * inner ℝ (R w) y ^ 2)
    simp only [LinearIsometryEquiv.norm_map, LinearIsometryEquiv.inner_map_map] at key
    rw [hq_def, hq_def, ← key]
  have hq_smul : ∀ (t : ℝ) (w : Euclid n), q (t • w) = t ^ 2 * q w := by
    intro t w
    rw [hq_def, hq_def, ← integral_const_mul]
    congr 1
    funext z
    rw [real_inner_smul_left]
    ring
  -- `q(w) = c|w|²`: the reflection in `(|w|e − w)ᗮ` maps `|w|e` to `w`.
  have hq : ∀ w : Euclid n, q w = q e * ‖w‖ ^ 2 := by
    intro w
    have h1 : ‖‖w‖ • e‖ = ‖w‖ := by rw [norm_smul, he, mul_one, norm_norm]
    obtain ⟨R, hR⟩ : ∃ R : Euclid n ≃ₗᵢ[ℝ] Euclid n, R (‖w‖ • e) = w :=
      ⟨_, Submodule.reflection_sub h1⟩
    calc q w = q (R (‖w‖ • e)) := by rw [hR]
      _ = q (‖w‖ • e) := hq_iso R _
      _ = q e * ‖w‖ ^ 2 := by rw [hq_smul, mul_comm]
  -- `c > 0`: on `ℝⁿ`, `Hⁿ` is Lebesgue measure, and the integrand is `3/16` at `e/2`.
  have hc : 0 < q e := by
    have hcont : Continuous fun z : Euclid n => max (1 - ‖z‖ ^ 2) 0 * inner ℝ e z ^ 2 := by
      fun_prop
    have hsupp : HasCompactSupport fun z : Euclid n => max (1 - ‖z‖ ^ 2) 0 * inner ℝ e z ^ 2 := by
      refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid n) 1) fun z hz => ?_
      have h1 : 1 < ‖z‖ := by simpa using hz
      have h2 : 1 - ‖z‖ ^ 2 ≤ 0 := by nlinarith
      simp [max_eq_right h2]
    have hnonneg : 0 ≤ fun z : Euclid n => max (1 - ‖z‖ ^ 2) 0 * inner ℝ e z ^ 2 :=
      fun z => mul_nonneg (le_max_right _ _) (sq_nonneg _)
    have hx : (fun z : Euclid n => max (1 - ‖z‖ ^ 2) 0 * inner ℝ e z ^ 2) ((1 / 2 : ℝ) • e) ≠ 0 := by
      simp only [norm_smul, he, real_inner_smul_right, real_inner_self_eq_norm_sq]
      norm_num
    rw [hq_def, EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
    exact hcont.integral_pos_of_hasCompactSupport_nonneg_nonzero hsupp hnonneg hx
  refine ⟨q e, hc, fun P Q hQ u => ?_⟩
  -- An orthonormal basis of `Q` indexed by `Fin n` gives `L : Q ≃ ℝⁿ`; `ι = L⁻¹` is an isometry
  -- of `ℝⁿ` onto `Q ⊆ ℝᴾ`, so `ι_# Hⁿ = Hⁿ⌞Q`.
  obtain ⟨L, -⟩ : ∃ L : Q ≃ₗᵢ[ℝ] Euclid n, True :=
    ⟨((stdOrthonormalBasis ℝ Q).reindex (finCongr hQ)).repr, trivial⟩
  have hι : Isometry fun z : Euclid n => ((L.symm z : Q) : Euclid P) :=
    isometry_subtype_coe.comp L.symm.isometry
  have hrange : Set.range (fun z : Euclid n => ((L.symm z : Q) : Euclid P)) =
      (Q : Set (Euclid P)) := by
    ext y
    refine ⟨?_, fun hy => ⟨L ⟨y, hy⟩, by simp⟩⟩
    rintro ⟨z, rfl⟩
    exact (L.symm z).2
  have hemb : MeasurableEmbedding fun z : Euclid n => ((L.symm z : Q) : Euclid P) :=
    hι.isClosedEmbedding.measurableEmbedding
  have hnorm : ∀ z : Euclid n, ‖((L.symm z : Q) : Euclid P)‖ = ‖z‖ := fun z => L.symm.norm_map z
  -- `⟨u, ι z⟩ = ⟨p_Q u, ι z⟩ = ⟨L(p_Q u), z⟩`.
  have hinner : ∀ z : Euclid n, inner ℝ u ((L.symm z : Q) : Euclid P) =
      inner ℝ (L (Q.orthogonalProjectionOnto u)) z := by
    intro z
    rw [LinearIsometryEquiv.inner_map_eq_flip,
      Submodule.inner_orthogonalProjectionOnto_eq_of_mem_right]
  rw [← hrange, ← hι.map_euclideanHausdorffMeasure, hemb.integral_map]
  simp only [hnorm, hinner]
  rw [← hq_def, hq, LinearIsometryEquiv.norm_map, Submodule.starProjection_apply]
  rfl
/-- A field of orthogonal projections `p_x = (K x).starProjection` is a.e.-measurable (Borel
σ-algebra of the operator-norm topology) when each quadratic form `x ↦ |p_x u|²` is.  As `p_x` is
self-adjoint and idempotent, `⟪p_x u, w⟫ = (|p_x(u + w)|² − |p_x(u − w)|²)/4`, so the matrix
coefficients `⟪p_x e_a, e_b⟫` are a.e.-measurable, and `p_x = Σ_{a,b} ⟪p_x e_a, e_b⟫ ⟪e_a, ·⟫ e_b`
is a continuous linear function of them. -/
theorem Submission.aemeasurable_starProjection_of_aemeasurable_norm_sq : ∀ (P : ℕ) (μ : Measure (Euclid P)) (K : Euclid P → Submodule ℝ (Euclid P)), (∀ u : Euclid P, AEMeasurable (fun x => ‖(K x).starProjection u‖ ^ 2) μ) → AEMeasurable (fun x => (K x).starProjection) μ := by
  intro P μ K h
  -- by polarization every coefficient `x ↦ ⟪p_x u, w⟫` is a.e.-measurable
  have hcoef : ∀ u w : Euclid P,
      AEMeasurable (fun x => inner ℝ ((K x).starProjection u) w) μ := by
    intro u w
    have key : ∀ x, inner ℝ ((K x).starProjection u) w =
        (‖(K x).starProjection (u + w)‖ ^ 2 - ‖(K x).starProjection (u - w)‖ ^ 2) / 4 := by
      intro x
      have hsym : inner ℝ ((K x).starProjection u) w =
          inner ℝ ((K x).starProjection u) ((K x).starProjection w) := by
        rw [Submodule.inner_starProjection_left_eq_right,
          Submodule.inner_starProjection_left_eq_right,
          Submodule.starProjection_eq_self_iff.2 ((K x).starProjection_apply_mem w)]
      rw [hsym, map_add, map_sub, norm_add_sq_real, norm_sub_sq_real]
      ring
    simp_rw [key]
    exact ((h (u + w)).sub (h (u - w))).div_const 4
  -- `p_x = Λ (g x)`, `Λ m = ∑ m_{ab} ⟪e_a, ·⟫ e_b`, `g x = (⟪p_x e_a, e_b⟫)_{ab}`
  let e := EuclideanSpace.basisFun (Fin P) ℝ
  let Λ : (Fin P × Fin P → ℝ) → (Euclid P →L[ℝ] Euclid P) := fun m =>
    ∑ ab, m ab • (innerSL ℝ (e ab.1)).smulRight (e ab.2)
  have heq : (fun x => (K x).starProjection) =
      fun x => Λ fun ab => inner ℝ ((K x).starProjection (e ab.1)) (e ab.2) := by
    funext x
    refine ContinuousLinearMap.ext fun v => ?_
    simp only [Λ, FunLike.coe_sum, Finset.sum_apply, FunLike.coe_smul,
      Pi.smul_apply, ContinuousLinearMap.smulRight_apply, innerSL_apply_apply,
      Fintype.sum_prod_type]
    calc (K x).starProjection v = (K x).starProjection (∑ a, inner ℝ (e a) v • e a) := by
          rw [e.sum_repr']
      _ = ∑ a, inner ℝ (e a) v • (K x).starProjection (e a) := by
          simp only [map_sum, map_smul]
      _ = ∑ a, inner ℝ (e a) v • ∑ b, inner ℝ (e b) ((K x).starProjection (e a)) • e b := by
          simp only [e.sum_repr']
      _ = _ := by
          refine Finset.sum_congr rfl fun a _ => ?_
          rw [Finset.smul_sum]
          refine Finset.sum_congr rfl fun b _ => ?_
          rw [real_inner_comm (e b), smul_smul, smul_smul, mul_comm]
  -- `Λ` is continuous and `g` is a.e.-measurable coordinatewise
  have hΛ : Continuous Λ :=
    continuous_finsetSum _ fun ab _ => (continuous_apply ab).smul continuous_const
  rw [heq]
  exact hΛ.measurable.comp_aemeasurable (AEMeasurable.of_eval fun ab => hcoef _ _)
/-- For an integer multiplicity triple `R = (M, θ, ξ)` in an open set `U`, `Hⁿ⌞M` is σ-finite.
The open set `U ⊆ ℝᴾ` is σ-compact, `U = ⋃ⱼ Kⱼ` with `Kⱼ` compact.  As `θ ≥ 1` on `M`,
`Hⁿ(M ∩ Kⱼ) ≤ ∫_{M ∩ Kⱼ} θ dHⁿ < ∞`, and `M ⊆ ⋃ⱼ (M ∩ Kⱼ)`. -/
theorem Submission.dsmc_imrep_carrier_sigmaFinite : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), IsOpen U → SigmaFinite (μHE[n].restrict R.carrier) := by
  intro P n U R hU
  -- `U` is locally compact and second countable, hence σ-compact
  obtain ⟨K, hKc, hKU⟩ : IsSigmaCompact U := by
    have := hU.locallyCompactSpace
    exact isSigmaCompact_iff_sigmaCompactSpace.mpr inferInstance
  -- `Hⁿ(M ∩ Kⱼ) ≤ ∫_{M ∩ Kⱼ} θ dHⁿ < ∞`, since `θ ≥ 1` on `M`
  have hfin : ∀ j, μHE[n] (R.carrier ∩ K j) < ∞ := by
    intro j
    calc μHE[n] (R.carrier ∩ K j) = ∫⁻ _ in R.carrier ∩ K j, 1 ∂μHE[n] :=
          (setLIntegral_one _).symm
      _ ≤ ∫⁻ x in R.carrier ∩ K j, (R.mult x : ℝ≥0∞) ∂μHE[n] :=
          setLIntegral_mono' (R.measurableSet_carrier.inter (hKc j).isClosed.measurableSet)
            fun x hx => Nat.one_le_cast.mpr (R.mult_pos x hx.1)
      _ < ∞ := (R.locallyIntegrable_mult (K j) (hKc j)
          ((subset_iUnion K j).trans hKU.subset)).lt_top
  -- `M ⊆ U = ⋃ⱼ Kⱼ`, so the sets `M ∩ Kⱼ` cover `M`
  refine Poincare.SimonGMT.Chapter03.sigmaFinite_restrict_of_hausdorff_finite_cover
    (fun j => R.carrier ∩ K j) ?_ hfin
  rw [← inter_iUnion, hKU]
  exact fun x hx => ⟨hx, R.carrier_subset hx⟩
/-- The blow-up integrals `x ↦ ∫_{η_{x,r}(M)} f dHⁿ` of a continuous `f ≥ 0` are Borel
measurable when `Hⁿ⌞M` is s-finite; `M` need not be measurable.  As `η_{x,r}` is a translation
followed by the dilation by `r⁻¹`, `Hⁿ(η_{x,r}(s)) = r⁻ⁿ Hⁿ(s)` for every set `s`, so
`Hⁿ⌞η_{x,r}(M) = r⁻ⁿ (η_{x,r})_#(Hⁿ⌞M)` (on Borel `B`, `η(M) ∩ B = η(M ∩ η⁻¹B)`).  Hence the
integral is `(r⁻ⁿ ∫ f(r⁻¹(y − x)) d(Hⁿ⌞M)(y)).toReal`, measurable in `x` by Tonelli for the
s-finite `Hⁿ⌞M`. -/
theorem Submission.dsmc_measurable_blowUp_image_setIntegral : ∀ (P n : ℕ) (M : Set (Euclid P)), SFinite (μHE[n].restrict M) → ∀ f : Euclid P → ℝ, Continuous f → (∀ y, 0 ≤ f y) → ∀ r : ℝ, 0 < r → Measurable (fun x : Euclid P => ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, f y ∂μHE[n]) := by
  intro P n M hM f hf hf0 r hr
  set η : Euclid P → Euclid P → Euclid P := fun x => Poincare.SimonGMT.Chapter03.blowUpMap x r
    with hη
  -- `(x, y) ↦ η_x(y) = r⁻¹(y − x)` is continuous
  have hηc : Continuous fun p : Euclid P × Euclid P => η p.1 p.2 := by
    simp only [hη, Poincare.SimonGMT.Chapter03.blowUpMap]
    fun_prop
  have hηm : ∀ x, Measurable (η x) := fun x =>
    (hηc.comp (Continuous.prodMk continuous_const continuous_id)).measurable
  -- `Hⁿ(η_x(s)) = r⁻ⁿ Hⁿ(s)` for every set `s`
  have hscale : ∀ x (s : Set (Euclid P)), μHE[n] (η x '' s) = ‖r⁻¹‖₊ ^ n • μHE[n] s := by
    intro x s
    have himg : η x '' s = (fun y => r⁻¹ • y) '' (IsometryEquiv.subRight x '' s) := by
      rw [Set.image_image]
      rfl
    rw [himg, Set.image_smul, Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hr.ne'),
      (IsometryEquiv.subRight x).isometry.euclideanHausdorffMeasure_image]
  -- `Hⁿ⌞η_x(M) = r⁻ⁿ (η_x)_#(Hⁿ⌞M)`, checked on Borel sets
  have hrestr : ∀ x, μHE[n].restrict (η x '' M) =
      ‖r⁻¹‖₊ ^ n • (μHE[n].restrict M).map (η x) := by
    intro x
    ext B hB
    rw [Measure.restrict_apply hB, Measure.smul_apply, Measure.map_apply (hηm x) hB,
      Measure.restrict_apply (hηm x hB), Set.inter_comm, ← Set.image_inter_preimage, hscale,
      Set.inter_comm]
  -- `∫_{η_x(M)} f dHⁿ = (r⁻ⁿ ∫ f ∘ η_x d(Hⁿ⌞M)).toReal`, also when `f` is not integrable
  have hint : ∀ x, ∫ y in η x '' M, f y ∂μHE[n] =
      (‖r⁻¹‖₊ ^ n • ∫⁻ y, ENNReal.ofReal (f (η x y)) ∂(μHE[n].restrict M)).toReal := by
    intro x
    rw [integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall hf0) hf.aestronglyMeasurable,
      hrestr, lintegral_smul_measure, lintegral_map hf.measurable.ennreal_ofReal (hηm x)]
  -- Tonelli for the s-finite measure `Hⁿ⌞M`
  show Measurable fun x => ∫ y in η x '' M, f y ∂μHE[n]
  simp_rw [hint]
  exact ((Measurable.lintegral_prod_right'
    (f := fun p : Euclid P × Euclid P => ENNReal.ofReal (f (η p.1 p.2)))
    (ENNReal.continuous_ofReal.comp (hf.comp hηc)).measurable).const_smul _).ennreal_toReal

/-- **The approximate tangent projections of an integer multiplicity triple are measurable**
(Simon Ch. 3, 1.4; Ch. 4, 2.3).  For `R = (M, θ, ξ)` in an open `U ⊆ ℝᴾ`, `x ↦ p_{TₓM}` is
a.e.-measurable for `μ_R = θHⁿ⌞M`.  As `μ_R ≪ ν = Hⁿ⌞M`, it suffices to treat `ν`, which is
σ-finite.  If `n = 0`, every candidate plane is `{0}`.  If `n ≥ 1`, `TₓM` is an approximate tangent
plane at `ν`-a.e. `x`, so for `f_u(y) = max(1 − |y|², 0)⟨u, y⟩²` the blow-up integrals
`∫_{η_{x,1/(k+1)}(M)} f_u dHⁿ`, which are Borel in `x`, converge `ν`-a.e. to
`∫_{TₓM} f_u dHⁿ = c|p_x u|²`.  Hence each `x ↦ |p_x u|²`, and so `x ↦ p_x`, is
`ν`-a.e.-measurable. -/
theorem Submission.dsmc_approxTangentPlane_starProjection_aemeasurable : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), IsOpen U → AEMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) R.measure := by
  intro P n U R hU
  -- `μ_R = θHⁿ⌞M ≪ Hⁿ⌞M`, so it suffices to work with `ν = Hⁿ⌞M`
  refine AEMeasurable.mono_ac ?_ (withDensity_absolutelyContinuous _ _)
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · -- `n = 0`: every candidate plane is `0`-dimensional, so `p_x = 0` for every `x`
    have h0 : ∀ x, (approxTangentPlane 0 R.carrier x).starProjection = 0 := by
      intro x
      have hK : approxTangentPlane 0 R.carrier x = ⊥ := by
        rw [approxTangentPlane]
        split_ifs with h
        · exact Submodule.finrank_eq_zero.1 h.choose_spec.1
        · rfl
      refine ContinuousLinearMap.ext fun v => ?_
      exact (Submodule.mem_bot ℝ).1
        (hK.le ((approxTangentPlane 0 R.carrier x).starProjection_apply_mem v))
    simp only [h0]
    exact aemeasurable_const
  have : SigmaFinite ((μHE[n] : Measure (Euclid P)).restrict R.carrier) :=
    Submission.dsmc_imrep_carrier_sigmaFinite P n U R hU
  obtain ⟨c, hc, hcQ⟩ := Submission.exists_plane_cutoff_quadratic_moment_eq n hn
  -- `TₓM` is an approximate tangent plane of `M` at `ν`-a.e. `x`
  have hT : ∀ᵐ x ∂(μHE[n].restrict R.carrier),
      HasApproximateTangentSpaceAt n R.carrier x (approxTangentPlane n R.carrier x) := by
    filter_upwards [R.orients] with x hx
    obtain ⟨Q, hQ, -⟩ := hx
    have h : ∃ Q, HasApproximateTangentSpaceAt n R.carrier x Q := ⟨Q, hQ⟩
    rw [approxTangentPlane, dite_eq_left h]
    exact h.choose_spec
  refine Submission.aemeasurable_starProjection_of_aemeasurable_norm_sq P _ _ fun u => ?_
  -- the test function `f_u(y) = max(1 − |y|², 0)⟨u, y⟩² ∈ C_c(ℝᴾ)`
  let f : Euclid P → ℝ := fun y => max (1 - ‖y‖ ^ 2) 0 * inner ℝ u y ^ 2
  have hf : Continuous f := by fun_prop
  have hf0 : ∀ y, 0 ≤ f y := fun y => mul_nonneg (le_max_right _ _) (sq_nonneg _)
  have hfc : HasCompactSupport f := by
    refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid P) 1) fun y hy => ?_
    have h1 : 1 < ‖y‖ := by simpa using hy
    have h2 : 1 - ‖y‖ ^ 2 ≤ 0 := by nlinarith
    simp [f, max_eq_right h2]
  let F : CompactlySupportedContinuousMap (Euclid P) ℝ := ⟨⟨f, hf⟩, hfc⟩
  -- the scales `1/(k+1) ↓ 0`
  have hr : Tendsto (fun k : ℕ => 1 / ((k : ℝ) + 1)) atTop (𝓝[>] 0) :=
    tendsto_nhdsWithin_iff.2 ⟨tendsto_one_div_add_atTop_nhds_zero_nat,
      Eventually.of_forall fun k => mem_Ioi.2 (by positivity)⟩
  -- the blow-up integrals `Φₖ(x) = ∫_{η_{x,1/(k+1)}(M)} f_u dHⁿ` are Borel functions of `x`
  let Φ : ℕ → Euclid P → ℝ := fun k x =>
    ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x (1 / ((k : ℝ) + 1)) '' R.carrier, f y ∂μHE[n]
  have hΦ : ∀ k, Measurable (Φ k) := fun k =>
    Submission.dsmc_measurable_blowUp_image_setIntegral P n R.carrier inferInstance f hf hf0 _
      (by positivity)
  -- at `ν`-a.e. `x` they converge to `∫_{TₓM} f_u dHⁿ = c|p_x u|²`
  have hlim : ∀ᵐ x ∂(μHE[n].restrict R.carrier), Tendsto (fun k => Φ k x) atTop
      (𝓝 (c * ‖(approxTangentPlane n R.carrier x).starProjection u‖ ^ 2)) := by
    filter_upwards [hT] with x hx
    rw [← hcQ P _ hx.1 u]
    exact (hx.2 F).comp hr
  refine ((aemeasurable_of_tendsto_metrizable_ae' (fun k => (hΦ k).aemeasurable) hlim).const_mul
    c⁻¹).congr (Eventually.of_forall fun x => ?_)
  exact inv_mul_cancel_left₀ hc.ne' _
/-- **Integrating factor for the monotonicity identity** (Simon Ch. 4, 3.16–3.17).  If `I` is
continuous on `(0, r]`, has derivative `I'` on `(0, r)` and `n I(s) − s I'(s) ≤ κ s I(s)` there,
then `s ↦ e^{κs} s⁻ⁿ I(s)` is nondecreasing on `(0, r]`.  On `(0, r]` this function equals
`G(s) = exp(κs − n log s) I(s)`, and `G'(s) = exp(κs − n log s) s⁻¹ (κ s I(s) − (n I(s) − s I'(s)))
≥ 0` on `(0, r)`, so the mean value theorem applies. -/
theorem Submission.dsmc_em_exp_monotoneOn_of_deriv_ineq : ∀ (n : ℕ) (κ r : ℝ) (I I' : ℝ → ℝ), ContinuousOn I (Ioc 0 r) → (∀ s ∈ Ioo 0 r, HasDerivAt I (I' s) s) → (∀ s ∈ Ioo 0 r, (n : ℝ) * I s - s * I' s ≤ κ * s * I s) → MonotoneOn (fun s => Real.exp (κ * s) / s ^ n * I s) (Ioc 0 r) := by
  intro n κ r I I' hIc hId hineq
  -- on `(0, r]`, `e^{κs}/sⁿ · I(s) = G(s) := exp(κs − n log s) · I(s)`
  refine MonotoneOn.congr (f₁ := fun s => Real.exp (κ * s - n * Real.log s) * I s) ?_ ?_
  swap
  · intro s hs
    simp only [Real.exp_sub, Real.exp_nat_mul, Real.exp_log hs.1]
  -- `G` is continuous on `(0, r]`
  have hGc : ContinuousOn (fun s => Real.exp (κ * s - n * Real.log s) * I s) (Ioc 0 r) := by
    refine ContinuousOn.mul (Real.continuous_exp.comp_continuousOn ?_) hIc
    exact (continuousOn_const.mul continuousOn_id).sub
      (continuousOn_const.mul (Real.continuousOn_log.mono fun s hs => hs.1.ne'))
  -- `G' = exp(κs − n log s) · ((κ − n/s) I + I') ≥ 0` on `(0, r)`; mean value theorem
  refine monotoneOn_of_hasDerivWithinAt_nonneg (convex_Ioc 0 r) hGc
    (f' := fun s => Real.exp (κ * s - n * Real.log s) * ((κ - n * s⁻¹) * I s + I' s)) ?_ ?_
  · intro s hs
    rw [interior_Ioc] at hs
    have h1 : HasDerivAt (fun s => κ * s - n * Real.log s) (κ * 1 - n * s⁻¹) s :=
      ((hasDerivAt_id' s).const_mul κ).sub ((Real.hasDerivAt_log hs.1.ne').const_mul (n : ℝ))
    exact ((h1.exp.mul (hId s hs)).congr_deriv (by ring)).hasDerivWithinAt
  · intro s hs
    rw [interior_Ioc] at hs
    have key : (κ - n * s⁻¹) * I s + I' s = s⁻¹ * (κ * s * I s - (n * I s - s * I' s)) := by
      linear_combination (-(κ * I s + I' s)) * mul_inv_cancel₀ hs.1.ne'
    rw [key]
    exact mul_nonneg (Real.exp_pos _).le
      (mul_nonneg (inv_nonneg.mpr hs.1.le) (sub_nonneg.mpr (hineq s hs)))
/-- **Differentiation of radial cutoff integrals** (Simon Ch. 4, 3.3–3.4, where
`I(ρ) = ∫ φ(r/ρ) dμ` is differentiated in `ρ`; here the cutoff is written in the squared ratio
`|x - z|²/t²`).  If `μ(B_r(z)) < ∞` and `η` is `C¹` with `η = 0` on `[1, ∞)`, then
`I(t) = ∫ η(|x - z|²/t²) dμ` is continuous on `(0, r]` and, for `0 < s < r`,
`I'(s) = -(∫ 2 (|x - z|²/s²) η'(|x - z|²/s²) dμ)/s` (dominated convergence and differentiation
under the integral sign). -/
theorem Submission.dsmc_em_cutoff_integral_hasDerivAt : ∀ (P : ℕ) (μ : Measure (Euclid P)) (z : Euclid P) (r : ℝ) (η : ℝ → ℝ), μ (ball z r) < ∞ → ContDiff ℝ 1 η → (∀ u, 1 ≤ u → η u = 0) → ContinuousOn (fun t => ∫ x, η (‖x - z‖ ^ 2 / t ^ 2) ∂μ) (Ioc 0 r) ∧ ∀ s ∈ Ioo 0 r, HasDerivAt (fun t => ∫ x, η (‖x - z‖ ^ 2 / t ^ 2) ∂μ) (-(∫ x, 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ∂μ) / s) s := by
  intro P μ z r η hμ hη hη1
  have hηc : Continuous η := hη.continuous
  have hη'c : Continuous (deriv η) := hη.continuous_deriv le_rfl
  -- `η' = deriv η` vanishes on `(1, ∞)` (where `η` is locally zero), hence on `[1, ∞)`.
  have hη'1 : ∀ u, 1 ≤ u → deriv η u = 0 := by
    have hIoi : Ioi (1 : ℝ) ⊆ {u | deriv η u = 0} := fun u hu => by
      have hloc : η =ᶠ[𝓝 u] fun _ => (0 : ℝ) := by
        filter_upwards [Ioi_mem_nhds hu] with v hv
        exact hη1 v (le_of_lt hv)
      show deriv η u = 0
      rw [hloc.deriv_eq, deriv_const]
    have hIci : Ici (1 : ℝ) ⊆ {u | deriv η u = 0} := by
      rw [← closure_Ioi]
      exact closure_minimal hIoi (isClosed_eq hη'c continuous_const)
    exact fun u hu => hIci hu
  -- Bounds on `[0, 1]` for `η` and for `u ↦ 2 u η'(u)`.
  obtain ⟨C, hC⟩ := isCompact_Icc.exists_bound_of_continuousOn (s := Icc (0 : ℝ) 1)
    hηc.continuousOn
  obtain ⟨K, hK⟩ := isCompact_Icc.exists_bound_of_continuousOn (s := Icc (0 : ℝ) 1)
    (f := fun u : ℝ => 2 * u * deriv η u) (by fun_prop)
  have hg1 : ∀ u, 1 ≤ u → 2 * u * deriv η u = 0 := fun u hu => by
    rw [hη'1 u hu, mul_zero]
  -- For `0 < t ≤ r`, `g(|x - z|²/t²)` vanishes off `B_t(z) ⊆ B_r(z)` and is dominated there.
  have hdom : ∀ (g : ℝ → ℝ) (B : ℝ), (∀ u, 1 ≤ u → g u = 0) → (∀ u ∈ Icc (0 : ℝ) 1, ‖g u‖ ≤ B) →
      ∀ t, 0 < t → t ≤ r → ∀ x : Euclid P,
        ‖g (‖x - z‖ ^ 2 / t ^ 2)‖ ≤ (ball z r).indicator (fun _ => B) x := by
    intro g B hg0 hgB t ht htr x
    have hB : 0 ≤ B := (norm_nonneg _).trans (hgB 0 ⟨le_rfl, zero_le_one⟩)
    by_cases hx : ‖x - z‖ < t
    · have hxr : x ∈ ball z r := by
        rw [mem_ball, dist_eq_norm]
        exact hx.trans_le htr
      rw [indicator_of_mem hxr]
      apply hgB
      refine ⟨by positivity, ?_⟩
      rw [div_le_one (by positivity)]
      exact pow_le_pow_left₀ (norm_nonneg _) hx.le 2
    · rw [not_lt] at hx
      rw [hg0 _ ?_, norm_zero]
      · exact indicator_nonneg (fun _ _ => hB) x
      · rw [le_div_iff₀ (by positivity), one_mul]
        exact pow_le_pow_left₀ ht.le hx 2
  have hint : ∀ c : ℝ, Integrable ((ball z r).indicator (fun _ => c)) μ := fun c =>
    (integrable_indicator_iff measurableSet_ball).2 (integrableOn_const hμ.ne)
  have hcont : ∀ t : ℝ, Continuous fun x : Euclid P => η (‖x - z‖ ^ 2 / t ^ 2) := fun t => by
    fun_prop
  -- Pointwise derivative in `t ≠ 0`.
  have hderiv : ∀ x : Euclid P, ∀ t : ℝ, t ≠ 0 →
      HasDerivAt (fun t => η (‖x - z‖ ^ 2 / t ^ 2))
        (-(2 * (‖x - z‖ ^ 2 / t ^ 2) * deriv η (‖x - z‖ ^ 2 / t ^ 2)) / t) t := by
    intro x t ht
    have h1 := (hasDerivAt_const t (‖x - z‖ ^ 2)).div (hasDerivAt_pow 2 t) (pow_ne_zero 2 ht)
    have h2 := (hη.differentiable one_ne_zero (‖x - z‖ ^ 2 / t ^ 2)).hasDerivAt.comp t h1
    refine h2.congr_deriv ?_
    field_simp
    ring
  refine ⟨?_, fun s hs => ?_⟩
  · -- (i) continuity on `(0, r]` by dominated convergence
    refine continuousOn_of_dominated (F := fun t x => η (‖x - z‖ ^ 2 / t ^ 2))
      (bound := (ball z r).indicator (fun _ => C)) (fun t _ => (hcont t).aestronglyMeasurable)
      (fun t ht => Eventually.of_forall (hdom η C hη1 hC t ht.1 ht.2)) (hint C)
      (Eventually.of_forall fun x t ht => (hderiv x t ht.1.ne').continuousAt.continuousWithinAt)
  · -- (ii) differentiation under the integral sign on `(s/2, r)`
    have hs0 : 0 < s := hs.1
    have hb : ∀ x : Euclid P, ∀ t ∈ Ioo (s / 2) r,
        ‖-(2 * (‖x - z‖ ^ 2 / t ^ 2) * deriv η (‖x - z‖ ^ 2 / t ^ 2)) / t‖ ≤
          (ball z r).indicator (fun _ => K) x / (s / 2) := by
      intro x t ht
      have ht0 : 0 < t := by linarith [ht.1]
      have h1 : ‖2 * (‖x - z‖ ^ 2 / t ^ 2) * deriv η (‖x - z‖ ^ 2 / t ^ 2)‖ ≤
          (ball z r).indicator (fun _ => K) x :=
        hdom (fun u => 2 * u * deriv η u) K hg1 hK t ht0 ht.2.le x
      have h2 : 0 ≤ (ball z r).indicator (fun _ => K) x := (norm_nonneg _).trans h1
      rw [norm_div, norm_neg, Real.norm_of_nonneg ht0.le]
      calc ‖2 * (‖x - z‖ ^ 2 / t ^ 2) * deriv η (‖x - z‖ ^ 2 / t ^ 2)‖ / t
          ≤ (ball z r).indicator (fun _ => K) x / t := by gcongr
        _ ≤ (ball z r).indicator (fun _ => K) x / (s / 2) := by
          gcongr
          exact ht.1.le
    have key := hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := μ) (x₀ := s)
      (F := fun t x => η (‖x - z‖ ^ 2 / t ^ 2))
      (F' := fun t x => -(2 * (‖x - z‖ ^ 2 / t ^ 2) * deriv η (‖x - z‖ ^ 2 / t ^ 2)) / t)
      (bound := fun x => (ball z r).indicator (fun _ => K) x / (s / 2))
      (Ioo_mem_nhds (by linarith) hs.2)
      (Eventually.of_forall fun t => (hcont t).aestronglyMeasurable)
      ((hint C).mono' (hcont s).aestronglyMeasurable
        (Eventually.of_forall (hdom η C hη1 hC s hs0 hs.2.le)))
      (by fun_prop : Continuous fun x : Euclid P =>
        -(2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)) / s).aestronglyMeasurable
      (Eventually.of_forall hb) ((hint K).div_const (s / 2))
      (Eventually.of_forall fun x t ht => hderiv x t (by linarith [ht.1] : 0 < t).ne')
    have hval : ∫ x, -(2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)) / s ∂μ =
        -(∫ x, 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ∂μ) / s := by
      rw [integral_div, integral_neg]
    rw [← hval]
    exact key.2
/-- **Radial first-variation inequality** (Simon Ch. 4, 3.2–3.3 with the bounded generalized mean
curvature of 3.14–3.16).  Test the first variation of `v(M, θ)` with the radial field
`X(x) = η(u(x)) (x - z)`, `u(x) = ‖x - z‖² / s²`, where `η ≥ 0` is `C¹`, nonincreasing and vanishes
on `[1, ∞)`.  Then `μ`-a.e. `n η(u) + 2 u η'(u) ≤ div_M X ≤ n η(u)`, and
`|X · H| ≤ κ s η(u)`, so `n ∫ η(u) dμ + ∫ 2 u η'(u) dμ ≤ ∫ div_M X dμ = -∫ X · H dμ ≤ κ s ∫ η(u) dμ`. -/
theorem Submission.dsmc_em_cutoff_first_variation_le : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (H : Euclid P → Euclid P) (κ : ℝ) (z : Euclid P) (r : ℝ) (η : ℝ → ℝ), closedBall z r ⊆ U → AEMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) R.measure → (∀ x, ‖H x‖ ≤ κ) → (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ ball z r → R.firstVariation X = -∫ x, inner ℝ (X x) (H x) ∂R.measure) → ContDiff ℝ 1 η → (∀ u, 0 ≤ η u) → (∀ u, deriv η u ≤ 0) → (∀ u, 1 ≤ u → η u = 0) → ∀ s : ℝ, 0 < s → s < r → (n : ℝ) * ∫ x, η (‖x - z‖ ^ 2 / s ^ 2) ∂R.measure + ∫ x, 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ∂R.measure ≤ κ * s * ∫ x, η (‖x - z‖ ^ 2 / s ^ 2) ∂R.measure := by
  intro P n U R H κ z r η hzU hPm hHκ hfv hη hη0 hη'0 hη1 s hs hsr
  classical
  set μ : Measure (Euclid P) := R.measure with hμ
  /- Step 0.  `κ ≥ 0`; `μ(B̄_s(z)) < ∞`; `η' = deriv η` is continuous and vanishes on `(1, ∞)`;
  `η` and `η'` are bounded on `[0, 1]`. -/
  have hκ0 : 0 ≤ κ := (norm_nonneg _).trans (hHκ 0)
  have hBc : IsCompact (closedBall z s) := isCompact_closedBall z s
  have hBm : MeasurableSet (closedBall z s) := measurableSet_closedBall
  have hBU : closedBall z s ⊆ U := (closedBall_subset_closedBall hsr.le).trans hzU
  have hBr : closedBall z s ⊆ ball z r := closedBall_subset_ball hsr
  have hμB : μ (closedBall z s) < ∞ := by
    rw [hμ, IMRep.measure, withDensity_apply _ hBm, Measure.restrict_restrict hBm, inter_comm]
    exact lt_top_iff_ne_top.mpr (R.locallyIntegrable_mult _ hBc hBU)
  have hind : ∀ c : ℝ, Integrable ((closedBall z s).indicator fun _ => c) μ := fun c =>
    (integrable_indicator_iff hBm).mpr (integrableOn_const hμB.ne)
  have hηd : ∀ u, HasDerivAt η (deriv η u) u := fun u =>
    ((hη.differentiable (by norm_num)) u).hasDerivAt
  have hηc : Continuous η := hη.continuous
  have hη'c : Continuous (deriv η) := hη.continuous_deriv le_rfl
  have hη'1 : ∀ u, 1 < u → deriv η u = 0 := by
    intro u hu
    have : η =ᶠ[𝓝 u] fun _ => 0 := by
      filter_upwards [Ioi_mem_nhds hu] with v hv
      exact hη1 v hv.le
    rw [this.deriv_eq]
    simp
  obtain ⟨C, hC⟩ : ∃ C, ∀ u ∈ Icc (0 : ℝ) 1, ‖η u‖ ≤ C :=
    isCompact_Icc.exists_bound_of_continuousOn hηc.continuousOn
  obtain ⟨M, hM⟩ : ∃ M, ∀ u ∈ Icc (0 : ℝ) 1, ‖deriv η u‖ ≤ M :=
    isCompact_Icc.exists_bound_of_continuousOn hη'c.continuousOn
  -- the radius ratio `u(x) = ‖x - z‖² / s²`
  have hucont : Continuous fun x : Euclid P => ‖x - z‖ ^ 2 / s ^ 2 := by fun_prop
  have hu0 : ∀ x : Euclid P, 0 ≤ ‖x - z‖ ^ 2 / s ^ 2 := fun x => by positivity
  have hu_le : ∀ x ∈ closedBall z s, ‖x - z‖ ^ 2 / s ^ 2 ≤ 1 := by
    intro x hx
    rw [mem_closedBall, dist_eq_norm] at hx
    rw [div_le_one (pow_pos hs 2)]
    exact pow_le_pow_left₀ (norm_nonneg _) hx 2
  have hu_gt : ∀ x, x ∉ closedBall z s → 1 < ‖x - z‖ ^ 2 / s ^ 2 := by
    intro x hx
    rw [mem_closedBall, dist_eq_norm, not_le] at hx
    rw [one_lt_div (pow_pos hs 2)]
    exact pow_lt_pow_left₀ hx hs.le two_ne_zero
  -- the two integrands vanish off `B̄_s(z)` and are bounded on it
  have hFint : Integrable (fun x => η (‖x - z‖ ^ 2 / s ^ 2)) μ := by
    refine Integrable.mono' (hind C) (hηc.comp hucont).aestronglyMeasurable
      (ae_of_all _ fun x => ?_)
    by_cases hx : x ∈ closedBall z s
    · rw [indicator_of_mem hx]
      exact hC _ ⟨hu0 x, hu_le x hx⟩
    · rw [indicator_of_notMem hx, hη1 _ (hu_gt x hx).le, norm_zero]
  have hGint : Integrable
      (fun x => 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)) μ := by
    refine Integrable.mono' (hind (2 * M))
      ((continuous_const.mul hucont).mul (hη'c.comp hucont)).aestronglyMeasurable
      (ae_of_all _ fun x => ?_)
    by_cases hx : x ∈ closedBall z s
    · have h1 := hu_le x hx
      have h2 := hM _ ⟨hu0 x, h1⟩
      rw [Real.norm_eq_abs] at h2
      rw [indicator_of_mem hx, Real.norm_eq_abs, abs_mul, abs_mul, abs_two,
        abs_of_nonneg (hu0 x)]
      calc 2 * (‖x - z‖ ^ 2 / s ^ 2) * |deriv η (‖x - z‖ ^ 2 / s ^ 2)| ≤ 2 * 1 * M :=
            mul_le_mul (mul_le_mul_of_nonneg_left h1 zero_le_two) h2 (abs_nonneg _)
              (by norm_num)
        _ = 2 * M := by ring
    · rw [indicator_of_notMem hx, hη'1 _ (hu_gt x hx), mul_zero, norm_zero]
  /- Step 1.  The radial field `X(x) = η(u(x)) (x - z)` is `C¹`, with
  `DX(x) v = η(u) v + η'(u) (2/s²) ⟪x - z, v⟫ (x - z)` and `tsupport X ⊆ B̄_s(z) ⊆ B_r(z)`. -/
  let X : Euclid P → Euclid P := fun x => η (‖x - z‖ ^ 2 / s ^ 2) • (x - z)
  have hXd : ∀ x, HasFDerivAt X
      (η (‖x - z‖ ^ 2 / s ^ 2) • ContinuousLinearMap.id ℝ (Euclid P) +
        ((deriv η (‖x - z‖ ^ 2 / s ^ 2) * (2 / s ^ 2)) • innerSL ℝ (x - z)).smulRight
          (x - z)) x := by
    intro x
    have h1 : HasFDerivAt (fun x : Euclid P => x - z) (ContinuousLinearMap.id ℝ _) x :=
      (hasFDerivAt_id x).sub_const z
    have h3 : HasFDerivAt (fun x : Euclid P => ‖x - z‖ ^ 2 / s ^ 2)
        ((s ^ 2)⁻¹ • (2 • (innerSL ℝ (x - z)).comp (ContinuousLinearMap.id ℝ (Euclid P)))) x := by
      simpa only [div_eq_mul_inv] using HasFDerivAt.mul_const h1.norm_sq (s ^ 2)⁻¹
    have h5 := ((hηd (‖x - z‖ ^ 2 / s ^ 2)).comp_hasFDerivAt x h3).smul h1
    refine HasFDerivAt.congr_fderiv (f := X) h5 (ContinuousLinearMap.ext fun v => ?_)
    simp only [add_apply, FunLike.coe_smul, Pi.smul_apply,
      ContinuousLinearMap.id_apply, ContinuousLinearMap.smulRight_apply, innerSL_apply_apply,
      ContinuousLinearMap.comp_apply, Function.comp_apply, smul_eq_mul]
    congr 2
    rw [nsmul_eq_mul]
    push_cast
    ring
  have hXcd : ContDiff ℝ 1 X := by
    have h1 : ContDiff ℝ 1 (fun x : Euclid P => ‖x - z‖ ^ 2 / s ^ 2) :=
      ((contDiff_norm_sq ℝ).comp (contDiff_id.sub contDiff_const)).div_const _
    exact (hη.comp h1).smul (contDiff_id.sub contDiff_const)
  have hXzero : ∀ x, x ∉ closedBall z s → X x = 0 := by
    intro x hx
    show η (‖x - z‖ ^ 2 / s ^ 2) • (x - z) = 0
    rw [hη1 _ (hu_gt x hx).le, zero_smul]
  have hXts : tsupport X ⊆ closedBall z s := by
    refine closure_minimal (fun x hx => ?_) isClosed_closedBall
    by_contra h
    exact hx (hXzero x h)
  have hXcs : HasCompactSupport X := HasCompactSupport.intro hBc hXzero
  /- Step 2.  `μ`-a.e. the tangent projection is `∑ᵢ τᵢ ⟪τᵢ, ·⟫` for an orthonormal family `τ`
  of size `n` (`R.orients` and uniqueness of approximate tangent spaces). -/
  have hproj : ∀ τ : Fin n → Euclid P, Orthonormal ℝ τ →
      (Submodule.span ℝ (range τ)).starProjection =
        ∑ i, InnerProductSpace.rankOne ℝ (τ i) (τ i) := by
    intro τ hτ
    let b0 := Module.Basis.span hτ.linearIndependent
    have hb0 : ∀ i, (b0 i : Euclid P) = τ i := fun i =>
      congrArg Subtype.val (Module.Basis.span_apply hτ.linearIndependent i)
    have hb0o : Orthonormal ℝ b0 := by
      have e : (Submodule.span ℝ (range τ)).subtypeₗᵢ ∘ b0 = τ := funext hb0
      rw [← (Submodule.span ℝ (range τ)).subtypeₗᵢ.orthonormal_comp_iff, e]
      exact hτ
    rw [OrthonormalBasis.starProjection_eq_sum_rankOne (b0.toOrthonormalBasis hb0o),
      Module.Basis.coe_toOrthonormalBasis]
    simp only [hb0]
  have hμac : μ ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
  have hPae : ∀ᵐ x ∂μ, ∃ τ : Fin n → Euclid P, Orthonormal ℝ τ ∧
      (approxTangentPlane n R.carrier x).starProjection =
        ∑ i, InnerProductSpace.rankOne ℝ (τ i) (τ i) := by
    refine hμac.ae_le ?_
    filter_upwards [R.orients] with x ⟨Q, hQ, τ, hτ, hspan, _⟩
    have hex : ∃ Q', HasApproximateTangentSpaceAt n R.carrier x Q' := ⟨Q, hQ⟩
    have happrox : approxTangentPlane n R.carrier x = Q := by
      rw [approxTangentPlane, dite_eq_left hex]
      exact hex.choose_spec.unique hQ
    exact ⟨τ, hτ, by rw [happrox, ← hspan, hproj τ hτ]⟩
  /- Step 3.  `div_M X = n η(u) + η'(u) (2/s²) ∑ᵢ ⟪τᵢ, x - z⟫²`, and by Bessel's inequality and
  `η' ≤ 0`, `n η(u) + 2 u η'(u) ≤ div_M X ≤ n η(u)` `μ`-a.e. -/
  let d : Euclid P → ℝ := fun x => tangentialDivergence n R.carrier X x
  -- `trace ((∑ τᵢ ⊗ τᵢ) ∘ L) = ∑ ⟪τᵢ, L τᵢ⟫`
  have htr : ∀ (τ : Fin n → Euclid P) (L : Euclid P →L[ℝ] Euclid P),
      LinearMap.trace ℝ (Euclid P) ((∑ i, InnerProductSpace.rankOne ℝ (τ i) (τ i) :
        Euclid P →L[ℝ] Euclid P).toLinearMap ∘ₗ L.toLinearMap) =
        ∑ i, inner ℝ (τ i) (L (τ i)) := by
    intro τ L
    rw [← ContinuousLinearMap.toLinearMap_comp, ContinuousLinearMap.finsetSum_comp,
      ContinuousLinearMap.toLinearMap_sum, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [ContinuousLinearMap.toLinearMap_comp, LinearMap.trace_comp_comm',
      ← ContinuousLinearMap.toLinearMap_comp, InnerProductSpace.comp_rankOne,
      InnerProductSpace.trace_rankOne]
  -- Bessel's inequality
  have hbessel : ∀ (τ : Fin n → Euclid P), Orthonormal ℝ τ → ∀ v : Euclid P,
      ∑ i, inner ℝ (τ i) v ^ 2 ≤ ‖v‖ ^ 2 := by
    intro τ hτ v
    have := hτ.sum_inner_products_le (s := Finset.univ) (x := v)
    simpa [Real.norm_eq_abs, sq_abs] using this
  have hdae : ∀ᵐ x ∂μ,
      n * η (‖x - z‖ ^ 2 / s ^ 2) + 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ≤
        d x ∧ d x ≤ n * η (‖x - z‖ ^ 2 / s ^ 2) := by
    filter_upwards [hPae] with x ⟨τ, hτ, hPx⟩
    have h1 : ∀ i, inner ℝ (τ i) (τ i) = (1 : ℝ) := fun i => by
      rw [real_inner_self_eq_norm_sq, hτ.1 i, one_pow]
    have e : d x = n * η (‖x - z‖ ^ 2 / s ^ 2) + deriv η (‖x - z‖ ^ 2 / s ^ 2) * (2 / s ^ 2) *
        ∑ i, inner ℝ (τ i) (x - z) ^ 2 := by
      show tangentialDivergence n R.carrier X x = _
      unfold tangentialDivergence
      rw [hPx, (hXd x).fderiv, htr]
      simp only [add_apply, FunLike.coe_smul, Pi.smul_apply, ContinuousLinearMap.id_apply,
        ContinuousLinearMap.smulRight_apply, innerSL_apply_apply, smul_eq_mul, inner_add_right,
        inner_smul_right, h1, Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ,
        Fintype.card_fin, nsmul_eq_mul, mul_one, Finset.mul_sum]
      congr 1
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [real_inner_comm (x - z) (τ i)]
      ring
    have hb := hbessel τ hτ (x - z)
    have hS0 : 0 ≤ ∑ i, inner ℝ (τ i) (x - z) ^ 2 := Finset.sum_nonneg fun i _ => sq_nonneg _
    have hk : deriv η (‖x - z‖ ^ 2 / s ^ 2) * (2 / s ^ 2) ≤ 0 :=
      mul_nonpos_of_nonpos_of_nonneg (hη'0 _) (div_nonneg zero_le_two (sq_nonneg s))
    have h2 := mul_le_mul_of_nonpos_left hb hk
    have h3 := mul_nonpos_of_nonpos_of_nonneg hk hS0
    have e2 : deriv η (‖x - z‖ ^ 2 / s ^ 2) * (2 / s ^ 2) * ‖x - z‖ ^ 2 =
        2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) := by ring
    rw [e]
    exact ⟨e2 ▸ add_le_add le_rfl h2, add_le_of_nonpos_right h3⟩
  /- Step 4.  `div_M X` is `μ`-integrable: it is `AEStronglyMeasurable` (the tangent projection
  is `μ`-measurable, `DX` is continuous, `(A, B) ↦ trace (A ∘ B)` is continuous) and
  `|div_M X| ≤ n η(u) + |2 u η'(u)|` `μ`-a.e. -/
  have hTc : Continuous fun p : (Euclid P →L[ℝ] Euclid P) × (Euclid P →L[ℝ] Euclid P) =>
      LinearMap.trace ℝ (Euclid P) (p.1.toLinearMap ∘ₗ p.2.toLinearMap) := by
    have h1 : Continuous fun A : Euclid P →L[ℝ] Euclid P =>
        LinearMap.trace ℝ (Euclid P) A.toLinearMap :=
      ((LinearMap.trace ℝ (Euclid P)).comp
        (ContinuousLinearMap.coeLM ℝ)).continuous_of_finiteDimensional
    exact h1.comp (continuous_fst.clm_comp continuous_snd)
  have hPmeas : AEStronglyMeasurable
      (fun x => (approxTangentPlane n R.carrier x).starProjection) μ := hPm.aestronglyMeasurable
  have hdmeas : AEStronglyMeasurable d μ := by
    have h3 := hTc.comp_aestronglyMeasurable
      (hPmeas.prodMk (hXcd.continuous_fderiv one_ne_zero).aestronglyMeasurable)
    show AEStronglyMeasurable (fun x => tangentialDivergence n R.carrier X x) μ
    unfold tangentialDivergence
    exact h3
  have hdint : Integrable d μ := by
    refine Integrable.mono' ((hFint.const_mul n).add hGint.abs) hdmeas ?_
    filter_upwards [hdae] with x hx
    have h0 : 0 ≤ (n : ℝ) * η (‖x - z‖ ^ 2 / s ^ 2) := mul_nonneg (Nat.cast_nonneg n) (hη0 _)
    have hG1 := neg_abs_le (2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2))
    have hG2 := abs_nonneg (2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2))
    show ‖d x‖ ≤ n * η (‖x - z‖ ^ 2 / s ^ 2) +
      |2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)|
    rw [Real.norm_eq_abs, abs_le]
    exact ⟨by linarith [hx.1], by linarith [hx.2]⟩
  /- Step 5.  `∫ f dμ = ∫_M θ f dHⁿ`, so `∫ div_M X dμ = R.firstVariation X`. -/
  have hμint : ∀ f : Euclid P → ℝ,
      ∫ x, f x ∂μ = ∫ x in R.carrier, (R.mult x : ℝ) * f x ∂μHE[n] := by
    intro f
    have hθ : (fun x => (R.mult x : ℝ≥0∞)) = fun x => ((R.mult x : NNReal) : ℝ≥0∞) := by
      funext x
      simp
    have hθm : Measurable fun x => (R.mult x : NNReal) :=
      measurable_from_top.comp R.measurable_mult
    rw [hμ, IMRep.measure, hθ, integral_withDensity_eq_integral_smul hθm]
    refine integral_congr_ae (ae_of_all _ fun x => ?_)
    simp [NNReal.smul_def]
  /- Step 6.  Integrate: `n ∫ η(u) + ∫ 2 u η'(u) ≤ ∫ div_M X = -∫ X · H ≤ κ s ∫ η(u)`, using
  `|X · H| ≤ ‖X‖ κ ≤ κ s η(u)` (`X = 0` off `B̄_s(z)`). -/
  have e1 : (n : ℝ) * ∫ x, η (‖x - z‖ ^ 2 / s ^ 2) ∂μ +
      ∫ x, 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ∂μ =
      ∫ x, ((n : ℝ) * η (‖x - z‖ ^ 2 / s ^ 2) +
        2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)) ∂μ := by
    rw [integral_add (hFint.const_mul _) hGint, integral_const_mul]
  have e3 : ∫ x, ((n : ℝ) * η (‖x - z‖ ^ 2 / s ^ 2) +
        2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)) ∂μ ≤ ∫ x, d x ∂μ := by
    refine integral_mono_ae ((hFint.const_mul _).add hGint) hdint ?_
    filter_upwards [hdae] with x hx
    exact hx.1
  have e4 : ∫ x, d x ∂μ = -∫ x, inner ℝ (X x) (H x) ∂μ := by
    rw [hμint]
    exact hfv X hXcd hXcs (hXts.trans hBr)
  have e5 : -∫ x, inner ℝ (X x) (H x) ∂μ ≤ κ * s * ∫ x, η (‖x - z‖ ^ 2 / s ^ 2) ∂μ := by
    have h1 : -∫ x, inner ℝ (X x) (H x) ∂μ ≤ ∫ x, ‖inner ℝ (X x) (H x)‖ ∂μ := by
      refine (neg_le_abs _).trans ?_
      rw [← Real.norm_eq_abs]
      exact norm_integral_le_integral_norm _
    have h2 : ∫ x, ‖inner ℝ (X x) (H x)‖ ∂μ ≤ ∫ x, κ * s * η (‖x - z‖ ^ 2 / s ^ 2) ∂μ := by
      refine integral_mono_of_nonneg (ae_of_all _ fun x => norm_nonneg _) (hFint.const_mul _)
        (ae_of_all _ fun x => ?_)
      show ‖inner ℝ (X x) (H x)‖ ≤ κ * s * η (‖x - z‖ ^ 2 / s ^ 2)
      by_cases hx : x ∈ closedBall z s
      · have hXn : ‖X x‖ ≤ η (‖x - z‖ ^ 2 / s ^ 2) * s := by
          show ‖η (‖x - z‖ ^ 2 / s ^ 2) • (x - z)‖ ≤ η (‖x - z‖ ^ 2 / s ^ 2) * s
          rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (hη0 _)]
          exact mul_le_mul_of_nonneg_left (by rwa [mem_closedBall, dist_eq_norm] at hx) (hη0 _)
        calc ‖inner ℝ (X x) (H x)‖ ≤ ‖X x‖ * ‖H x‖ := norm_inner_le_norm _ _
          _ ≤ (η (‖x - z‖ ^ 2 / s ^ 2) * s) * κ :=
            mul_le_mul hXn (hHκ x) (norm_nonneg _) (mul_nonneg (hη0 _) hs.le)
          _ = κ * s * η (‖x - z‖ ^ 2 / s ^ 2) := by ring
      · rw [hXzero x hx, inner_zero_left, norm_zero]
        exact mul_nonneg (mul_nonneg hκ0 hs.le) (hη0 _)
    rw [integral_const_mul] at h2
    exact h1.trans h2
  calc (n : ℝ) * ∫ x, η (‖x - z‖ ^ 2 / s ^ 2) ∂μ +
        ∫ x, 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ∂μ = _ := e1
    _ ≤ _ := e3
    _ = _ := e4
    _ ≤ _ := e5
/-- **Radial cutoffs for the monotonicity formula** (Simon Ch. 4, 3.1–3.4).  With
`g = Real.smoothTransition` and `ηⱼ(u) = g((j + 2)(1 − u))`, every `ηⱼ` is `C¹`, nonnegative and
nonincreasing, vanishes for `u ≥ 1`, and `ηⱼ(|x − z|²/s²)` increases to the indicator of the
open ball `B_s(z)`; by dominated convergence `∫ ηⱼ(|x − z|²/s²) dμ → μ(B_s(z))` whenever
`μ(B_s(z)) < ∞`. -/
theorem Submission.dsmc_em_cutoff_tendsto_ball : ∃ η : ℕ → ℝ → ℝ, (∀ j, ContDiff ℝ 1 (η j)) ∧ (∀ j u, 0 ≤ η j u) ∧ (∀ j u, deriv (η j) u ≤ 0) ∧ (∀ j u, 1 ≤ u → η j u = 0) ∧ ∀ (P : ℕ) (μ : Measure (Euclid P)) (z : Euclid P) (s : ℝ), 0 < s → μ (ball z s) < ∞ → Tendsto (fun j => ∫ x, η j (‖x - z‖ ^ 2 / s ^ 2) ∂μ) atTop (𝓝 (μ.real (ball z s))) := by
  -- Steps 1–5: `ηⱼ(u) = g((j + 2)(1 − u))` is `C¹`, `≥ 0`, antitone, and `0` for `u ≥ 1`.
  have hanti : ∀ j : ℕ, Antitone fun u : ℝ => Real.smoothTransition (((j : ℝ) + 2) * (1 - u)) := by
    intro j a b hab
    apply Real.smoothTransition.monotone
    have hj : (0 : ℝ) ≤ (j : ℝ) + 2 := by positivity
    nlinarith
  have hzero : ∀ (j : ℕ) (u : ℝ), 1 ≤ u →
      Real.smoothTransition (((j : ℝ) + 2) * (1 - u)) = 0 := by
    intro j u hu
    apply Real.smoothTransition.zero_of_nonpos
    have hj : (0 : ℝ) ≤ (j : ℝ) + 2 := by positivity
    nlinarith
  refine ⟨fun j u => Real.smoothTransition (((j : ℝ) + 2) * (1 - u)), fun j => ?_,
    fun j u => Real.smoothTransition.nonneg _, fun j u => (hanti j).deriv_nonpos, hzero, ?_⟩
  · exact Real.smoothTransition.contDiff.comp (contDiff_const.mul (contDiff_const.sub contDiff_id))
  -- Step 6: dominated convergence with the bound `1_{B_s(z)}`.
  intro P μ z s hs hμ
  have hs2 : 0 < s ^ 2 := by positivity
  -- `|x − z|²/s² < 1` exactly on the open ball
  have hlt : ∀ x : Euclid P, x ∈ ball z s → ‖x - z‖ ^ 2 / s ^ 2 < 1 := by
    intro x hx
    rw [mem_ball, dist_eq_norm] at hx
    rw [div_lt_one hs2]
    exact pow_lt_pow_left₀ hx (norm_nonneg _) two_ne_zero
  have hge : ∀ x : Euclid P, x ∉ ball z s → 1 ≤ ‖x - z‖ ^ 2 / s ^ 2 := by
    intro x hx
    rw [mem_ball, dist_eq_norm, not_lt] at hx
    rw [one_le_div hs2]
    exact pow_le_pow_left₀ hs.le hx 2
  have hint : Integrable ((ball z s).indicator (1 : Euclid P → ℝ)) μ :=
    (integrable_indicator_iff measurableSet_ball).2 (integrableOn_const hμ.ne)
  rw [← integral_indicator_one measurableSet_ball]
  refine tendsto_integral_of_dominated_convergence ((ball z s).indicator 1)
    (F := fun (j : ℕ) (x : Euclid P) =>
      Real.smoothTransition (((j : ℝ) + 2) * (1 - ‖x - z‖ ^ 2 / s ^ 2)))
    (fun j => ?_) hint (fun j => ae_of_all _ fun x => ?_) (ae_of_all _ fun x => ?_)
  · -- (a) each integrand is continuous
    exact (Real.smoothTransition.continuous.comp (by fun_prop)).aestronglyMeasurable
  · -- (a) `|ηⱼ(u(x))| ≤ 1_{B_s(z)}(x)`
    by_cases hx : x ∈ ball z s
    · rw [indicator_of_mem hx, Pi.one_apply, Real.norm_eq_abs,
        abs_of_nonneg (Real.smoothTransition.nonneg _)]
      exact Real.smoothTransition.le_one _
    · rw [indicator_of_notMem hx, hzero j _ (hge x hx), norm_zero]
  · -- (b) pointwise convergence to `1_{B_s(z)}(x)`
    by_cases hx : x ∈ ball z s
    · rw [indicator_of_mem hx, Pi.one_apply]
      have hpos : 0 < 1 - ‖x - z‖ ^ 2 / s ^ 2 := sub_pos.2 (hlt x hx)
      obtain ⟨N, hN⟩ := exists_nat_ge (1 / (1 - ‖x - z‖ ^ 2 / s ^ 2))
      rw [div_le_iff₀ hpos] at hN
      refine tendsto_const_nhds.congr' (eventually_atTop.2 ⟨N, fun j hj => ?_⟩)
      have hj : (N : ℝ) ≤ j := by exact_mod_cast hj
      refine (Real.smoothTransition.one_of_one_le ?_).symm
      nlinarith
    · rw [indicator_of_notMem hx]
      exact tendsto_const_nhds.congr fun j => (hzero j _ (hge x hx)).symm

/-- **Monotonicity of `e^{κρ} ρ⁻ⁿ μ_R(B_ρ(z))` under bounded generalized mean curvature**
(Simon Ch. 4, 3.14–3.17).  If `δV(X) = -∫ X · H dμ_R` for `C¹` fields `X` supported in `B_r(z)`,
`B̄_r(z) ⊆ U` and `|H| ≤ κ`, then `e^{κs} s⁻ⁿ μ_R(B_s(z))` is nondecreasing on `(0, r]`.  For each
radial cutoff `ηⱼ`, `I(s) = ∫ ηⱼ(|x - z|²/s²) dμ_R` satisfies `n I - s I' ≤ κ s I` on `(0, r)`, so
`e^{κs} s⁻ⁿ I(s)` is nondecreasing; letting `j → ∞` gives `I(s) → μ_R(B_s(z))`. -/
theorem Submission.dsmc_exp_ball_mass_monotone : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (H : Euclid P → Euclid P) (κ : ℝ) (z : Euclid P) (r : ℝ), closedBall z r ⊆ U → AEMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) R.measure → AEStronglyMeasurable H R.measure → (∀ x, ‖H x‖ ≤ κ) → (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ ball z r → R.firstVariation X = -∫ x, inner ℝ (X x) (H x) ∂R.measure) → ∀ σ ρ : ℝ, 0 < σ → σ ≤ ρ → ρ ≤ r → ENNReal.ofReal (Real.exp (κ * σ) / σ ^ n) * R.measure (ball z σ) ≤ ENNReal.ofReal (Real.exp (κ * ρ) / ρ ^ n) * R.measure (ball z ρ) := by
  intro P n U R H κ z r hzU hPm _ hHκ hfv σ ρ hσ hσρ hρr
  have hρ : 0 < ρ := hσ.trans_le hσρ
  -- (a) `μ(B̄_r(z)) < ∞` (`R.locallyIntegrable_mult`), so `μ(B_t(z)) < ∞` for `t ≤ r`
  have hμB : R.measure (closedBall z r) < ∞ := by
    rw [IMRep.measure, withDensity_apply _ measurableSet_closedBall,
      Measure.restrict_restrict measurableSet_closedBall, inter_comm]
    exact lt_top_iff_ne_top.mpr (R.locallyIntegrable_mult _ (isCompact_closedBall z r) hzU)
  have hμt : ∀ t, t ≤ r → R.measure (ball z t) < ∞ := fun t ht =>
    (measure_mono (ball_subset_closedBall.trans (closedBall_subset_closedBall ht))).trans_lt hμB
  -- (b) for each cutoff `ηⱼ`, `e^{κs} s⁻ⁿ ∫ ηⱼ(|x - z|²/s²) dμ` is nondecreasing on `(0, r]`
  obtain ⟨η, hηC, hη0, hη'0, hη1, hlim⟩ := Submission.dsmc_em_cutoff_tendsto_ball
  have hj : ∀ j, Real.exp (κ * σ) / σ ^ n * ∫ x, η j (‖x - z‖ ^ 2 / σ ^ 2) ∂R.measure ≤
      Real.exp (κ * ρ) / ρ ^ n * ∫ x, η j (‖x - z‖ ^ 2 / ρ ^ 2) ∂R.measure := by
    intro j
    obtain ⟨hcont, hderiv⟩ := Submission.dsmc_em_cutoff_integral_hasDerivAt P R.measure z r (η j)
      (hμt r le_rfl) (hηC j) (hη1 j)
    refine Submission.dsmc_em_exp_monotoneOn_of_deriv_ineq n κ r _ _ hcont hderiv (fun s hs => ?_)
      ⟨hσ, hσρ.trans hρr⟩ ⟨hρ, hρr⟩ hσρ
    -- `n I(s) - s I'(s) = n I(s) + ∫ 2 u η'(u) dμ ≤ κ s I(s)`
    have h := Submission.dsmc_em_cutoff_first_variation_le P n U R H κ z r (η j) hzU hPm hHκ hfv
      (hηC j) (hη0 j) (hη'0 j) (hη1 j) s hs.1 hs.2
    rw [mul_div_cancel₀ _ hs.1.ne', sub_neg_eq_add]
    exact h
  -- (c) let `j → ∞`: the integrals tend to `μ(B_σ(z))` and `μ(B_ρ(z))`
  have hreal : Real.exp (κ * σ) / σ ^ n * R.measure.real (ball z σ) ≤
      Real.exp (κ * ρ) / ρ ^ n * R.measure.real (ball z ρ) :=
    le_of_tendsto_of_tendsto'
      ((hlim P R.measure z σ hσ (hμt σ (hσρ.trans hρr))).const_mul _)
      ((hlim P R.measure z ρ hρ (hμt ρ hρr)).const_mul _) hj
  -- (d) transfer to `[0, ∞]`
  rw [← ofReal_measureReal (hμt σ (hσρ.trans hρr)).ne, ← ofReal_measureReal (hμt ρ hρr).ne,
    ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
  exact ENNReal.ofReal_le_ofReal hreal

/-- **First variation of a varifold stationary in `U ∩ N`** (Simon Ch. 4, 2.5–2.7; Ch. 2,
5.9–5.10).  Let `Pt` be a `C¹` field of self-adjoint operators on `B_{3r}(y₀)` such that, at
`q ∈ N`, `Pt(q)` maps into `T_qN` and fixes `T_qN`, with `‖DPt‖ ≤ β` on `B_{2r}(y₀)`.  If
`V = v(M, θ)` is stationary in `U ∩ N` and `TₓM ⊆ TₓN` for `μ_V`-a.e. `x`, then
`H(x) = Σₐ (DPt(x)(pₓeₐ))eₐ = Σᵢ (DPt(x)τᵢ)τᵢ` (`τ` an orthonormal basis of `TₓM`) on `B_{2r}(y₀)`,
`H = 0` elsewhere, has `‖H‖ ≤ nβ` and `δV(X) = −∫ X · H dμ_V` for `X ∈ C¹_c(B_{2r}(y₀); ℝᴾ)`:
`Xᵀ = Pt·X` is tangent to `N`, so `δV(Xᵀ) = 0`, and `div_M (X − Xᵀ) = −X · H` a.e. by the product
rule, `Pt(x)τᵢ = τᵢ` and the self-adjointness of `Pt(x)` and of `DPt(x)u`. -/
theorem Submission.dsmc_firstVariation_eq_neg_meanCurvature : ∀ (P n : ℕ) (U N : Set (Euclid P)) (R : IMRep U n) (Pt : Euclid P → (Euclid P →L[ℝ] Euclid P)) (y₀ : Euclid P) (r β : ℝ), 0 ≤ β → ball y₀ (3 * r) ⊆ U → ContDiffOn ℝ 1 Pt (ball y₀ (3 * r)) → (∀ y ∈ ball y₀ (3 * r), ∀ u w : Euclid P, inner ℝ (Pt y u) w = inner ℝ u (Pt y w)) → (∀ y ∈ ball y₀ (2 * r), ‖fderiv ℝ Pt y‖ ≤ β) → (∀ q ∈ N ∩ ball y₀ (3 * r), ∀ u : Euclid P, Pt q u ∈ tangentSpace N q) → (∀ q ∈ N ∩ ball y₀ (3 * r), ∀ u ∈ tangentSpace N q, Pt q u = u) → (∀ᵐ x ∂R.measure, x ∈ N) → (∀ᵐ x ∂R.measure, x ∈ ball y₀ (3 * r) → (approxTangentPlane n R.carrier x : Set (Euclid P)) ⊆ tangentSpace N x) → AEMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) R.measure → R.IsStationaryAlong N → ∃ H : Euclid P → Euclid P, AEStronglyMeasurable H R.measure ∧ (∀ x, ‖H x‖ ≤ (n : ℝ) * β) ∧ ∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ ball y₀ (2 * r) → R.firstVariation X = -∫ x, inner ℝ (X x) (H x) ∂R.measure := by
  intro P n U N R Pt y₀ r β hβ hball hPt hsym hDPt hPtT hPtfix hN hTN hpm hstat
  -- notation: `e` is the standard orthonormal basis of `ℝᴾ` and `Φ(B, p) = Σₐ (B (p eₐ)) eₐ`
  let e := EuclideanSpace.basisFun (Fin P) ℝ
  let Φ : (Euclid P →L[ℝ] (Euclid P →L[ℝ] Euclid P)) → (Euclid P →L[ℝ] Euclid P) → Euclid P :=
    fun B p => ∑ a, B (p (e a)) (e a)
  -- Step 1(a): `dim TₓM ≤ n`, `TₓM` being an approximate tangent space or `{0}`
  have hrank : ∀ x, Module.finrank ℝ (approxTangentPlane n R.carrier x) ≤ n := by
    intro x
    by_cases h : ∃ Q, HasApproximateTangentSpaceAt n R.carrier x Q
    · have hT : approxTangentPlane n R.carrier x = h.choose := by
        unfold approxTangentPlane
        rw [dite_eq_left h]
      rw [hT]
      exact h.choose_spec.finrank_eq.le
    · have hT : approxTangentPlane n R.carrier x = ⊥ := by
        unfold approxTangentPlane
        rw [dite_eq_right h]
      rw [hT]
      simp
  -- Step 1(b): `trace(p_K ∘ D) = Σᵢ ⟨τᵢ, Dτᵢ⟩` for an orthonormal basis `τ` of `K`
  have htr : ∀ (K : Submodule ℝ (Euclid P)) (m : ℕ) (τ : OrthonormalBasis (Fin m) ℝ K)
      (D : Euclid P →L[ℝ] Euclid P),
      LinearMap.trace ℝ (Euclid P) (K.starProjection.toLinearMap ∘ₗ D.toLinearMap) =
        ∑ i, inner ℝ (τ i : Euclid P) (D (τ i)) := by
    intro K m τ D
    rw [Submodule.starProjection, ContinuousLinearMap.toLinearMap_comp, LinearMap.comp_assoc,
      LinearMap.trace_comp_comm', LinearMap.trace_eq_sum_inner _ τ]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp
  -- Step 1(c): `Φ(B, p_K) = Σᵢ (Bτᵢ)τᵢ` for an orthonormal basis `τ` of `K`
  have hcontr : ∀ (K : Submodule ℝ (Euclid P)) (m : ℕ) (τ : OrthonormalBasis (Fin m) ℝ K)
      (B : Euclid P →L[ℝ] (Euclid P →L[ℝ] Euclid P)),
      Φ B K.starProjection = ∑ i, B (τ i : Euclid P) (τ i : Euclid P) := by
    intro K m τ B
    have hp : ∀ v, K.starProjection v = ∑ i, inner ℝ (τ i : Euclid P) v • (τ i : Euclid P) := by
      intro v
      rw [Submodule.starProjection_apply, τ.orthogonalProjectionOnto_apply_eq_sum]
      simp
    have he : ∀ i, ∑ a, inner ℝ (τ i : Euclid P) (e a) • e a = (τ i : Euclid P) := by
      intro i
      simpa [real_inner_comm] using e.sum_repr' (τ i : Euclid P)
    simp only [Φ, hp, map_sum, map_smul, FunLike.coe_sum, Finset.sum_apply, FunLike.coe_smul,
      Pi.smul_apply]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => ?_
    calc ∑ a, inner ℝ (τ i : Euclid P) (e a) • B (τ i : Euclid P) (e a)
        = B (τ i : Euclid P) (∑ a, inner ℝ (τ i : Euclid P) (e a) • e a) := by
          rw [map_sum]
          simp [map_smul]
      _ = B (τ i : Euclid P) (τ i : Euclid P) := by rw [he i]
  -- `B_{2r}(y₀) ⊆ B_{3r}(y₀)` for every `r` (both are empty if `r ≤ 0`)
  have h23 : ball y₀ (2 * r) ⊆ ball y₀ (3 * r) := by
    rcases le_or_gt r 0 with hr | hr
    · rw [ball_eq_empty.mpr (by linarith)]
      exact empty_subset _
    · exact ball_subset_ball (by linarith)
  -- `Pt` is differentiable on the open ball `B_{3r}(y₀)`
  have hPtd : ∀ x ∈ ball y₀ (3 * r), DifferentiableAt ℝ Pt x := fun x hx =>
    (hPt.differentiableOn one_ne_zero).differentiableAt (isOpen_ball.mem_nhds hx)
  -- Step 1(d): `DPt(x)u` is self-adjoint for `x ∈ B_{3r}(y₀)`: differentiate
  -- `y ↦ ⟨b, Pt(y)a⟩ − ⟨a, Pt(y)b⟩`, which vanishes near `x`
  have hDsym : ∀ x ∈ ball y₀ (3 * r), ∀ u a b : Euclid P,
      inner ℝ (fderiv ℝ Pt x u a) b = inner ℝ a (fderiv ℝ Pt x u b) := by
    intro x hx u a b
    let ℓ : (Euclid P →L[ℝ] Euclid P) →L[ℝ] ℝ :=
      (innerSL ℝ b).comp (ContinuousLinearMap.apply ℝ (Euclid P) a) -
        (innerSL ℝ a).comp (ContinuousLinearMap.apply ℝ (Euclid P) b)
    have hℓ : ∀ L : Euclid P →L[ℝ] Euclid P, ℓ L = inner ℝ b (L a) - inner ℝ a (L b) := by
      intro L; rfl
    have hev : (fun y => ℓ (Pt y)) =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
      filter_upwards [isOpen_ball.mem_nhds hx] with y hy
      rw [hℓ, real_inner_comm, hsym y hy, sub_self]
    have h1 : HasFDerivAt (fun y => ℓ (Pt y)) (ℓ.comp (fderiv ℝ Pt x)) x :=
      ℓ.hasFDerivAt.comp x (hPtd x hx).hasFDerivAt
    have h2 : HasFDerivAt (fun y => ℓ (Pt y)) (0 : Euclid P →L[ℝ] ℝ) x :=
      (hasFDerivAt_const (0 : ℝ) x).congr_of_eventuallyEq hev
    have h3 := congrArg (fun L => L u) (h1.unique h2)
    simp only [ContinuousLinearMap.comp_apply, zero_apply, hℓ] at h3
    rw [real_inner_comm]
    linarith
  -- Step 2: `H = 1_{B_{2r}(y₀)} · Φ(DPt(x), pₓ)`
  refine ⟨(ball y₀ (2 * r)).indicator
    (fun x => Φ (fderiv ℝ Pt x) (approxTangentPlane n R.carrier x).starProjection), ?_, ?_, ?_⟩
  · -- Step 2(b): `x ↦ DPt(x)` is Borel, `x ↦ pₓ` is `μ_V`-measurable and `Φ` is continuous
    have hΦc : Continuous (fun q : (Euclid P →L[ℝ] (Euclid P →L[ℝ] Euclid P)) ×
        (Euclid P →L[ℝ] Euclid P) => Φ q.1 q.2) := by
      simp only [Φ]
      fun_prop
    have h1 : AEMeasurable
        (fun x => Φ (fderiv ℝ Pt x) (approxTangentPlane n R.carrier x).starProjection) R.measure :=
      hΦc.aemeasurable2 (measurable_fderiv ℝ Pt).aemeasurable hpm
    exact (h1.indicator measurableSet_ball).aestronglyMeasurable
  · -- Step 2(a): `‖H(x)‖ ≤ Σᵢ ‖DPt(x)‖ |τᵢ|² ≤ nβ`
    intro x
    by_cases hx : x ∈ ball y₀ (2 * r)
    · set τ := stdOrthonormalBasis ℝ (approxTangentPlane n R.carrier x)
      rw [indicator_of_mem hx, hcontr _ _ τ]
      have hτ : ∀ i, ‖(τ i : Euclid P)‖ = 1 := fun i => by
        rw [Submodule.norm_coe]
        exact τ.orthonormal.norm_eq_one i
      calc ‖∑ i, fderiv ℝ Pt x (τ i : Euclid P) (τ i : Euclid P)‖
          ≤ ∑ i, ‖fderiv ℝ Pt x (τ i : Euclid P) (τ i : Euclid P)‖ := norm_sum_le _ _
        _ ≤ ∑ _i, ‖fderiv ℝ Pt x‖ := by
            gcongr with i
            calc ‖fderiv ℝ Pt x (τ i : Euclid P) (τ i : Euclid P)‖
                ≤ ‖fderiv ℝ Pt x (τ i : Euclid P)‖ * ‖(τ i : Euclid P)‖ :=
                  ContinuousLinearMap.le_opNorm _ _
              _ ≤ ‖fderiv ℝ Pt x‖ * ‖(τ i : Euclid P)‖ * ‖(τ i : Euclid P)‖ := by
                  gcongr
                  exact ContinuousLinearMap.le_opNorm _ _
              _ = ‖fderiv ℝ Pt x‖ := by rw [hτ, mul_one, mul_one]
        _ = (Module.finrank ℝ (approxTangentPlane n R.carrier x) : ℝ) * ‖fderiv ℝ Pt x‖ := by
            simp
        _ ≤ (n : ℝ) * β := by
            gcongr
            · exact_mod_cast hrank x
            · exact hDPt x hx
    · rw [indicator_of_notMem hx, norm_zero]
      positivity
  -- Steps 3–6, for a fixed `X ∈ C¹_c(B_{2r}(y₀); ℝᴾ)`
  intro X hX hXc hXs
  have hXzero : ∀ x, x ∉ tsupport X → X =ᶠ[𝓝 x] 0 := fun x hx =>
    notMem_tsupport_iff_eventuallyEq.mp hx
  -- Step 3(a): `Xᵀ = Pt·X` is `C¹`: on `B_{3r}(y₀)` by the product rule, elsewhere it vanishes
  -- near the point
  have hXTc : ContDiff ℝ 1 (fun x => Pt x (X x)) := by
    rw [contDiff_iff_contDiffAt]
    intro x
    by_cases hx : x ∈ ball y₀ (3 * r)
    · exact (hPt.contDiffAt (isOpen_ball.mem_nhds hx)).clm_apply hX.contDiffAt
    · have hxK : x ∉ tsupport X := fun h => hx (h23 (hXs h))
      have hev : (fun x => Pt x (X x)) =ᶠ[𝓝 x] fun _ => 0 := by
        filter_upwards [hXzero x hxK] with y hy
        simp [hy]
      exact contDiffAt_const.congr_of_eventuallyEq hev
  -- Step 3(b): `spt Xᵀ ⊆ spt X`, a compact subset of `U`
  have hXTsupp : tsupport (fun x => Pt x (X x)) ⊆ tsupport X := by
    apply closure_mono
    intro x hx
    by_contra h
    apply hx
    simp [Function.notMem_support.mp h]
  have hXTc' : HasCompactSupport (fun x => Pt x (X x)) :=
    hXc.mono' ((subset_tsupport _).trans hXTsupp)
  have hXsU : tsupport X ⊆ U := hXs.trans (h23.trans hball)
  have hXTsU : tsupport (fun x => Pt x (X x)) ⊆ U := hXTsupp.trans hXsU
  -- Step 3(c): `Xᵀ(x) ∈ TₓN` on `N ∩ U` (off `B_{3r}(y₀)`, `Xᵀ(x) = 0`, the velocity of a
  -- constant curve)
  have hXTtan : ∀ x ∈ N ∩ U, (fun x => Pt x (X x)) x ∈ tangentSpace N x := by
    rintro x ⟨hxN, -⟩
    by_cases hx : x ∈ ball y₀ (3 * r)
    · exact hPtT x ⟨hxN, hx⟩ (X x)
    · have hxK : x ∉ tsupport X := fun h => hx (h23 (hXs h))
      have hX0 : X x = 0 := image_eq_zero_of_notMem_tsupport hxK
      simp only [hX0, map_zero]
      exact ⟨fun _ => x, contDiffOn_const, fun _ _ => hxN, rfl, hasDerivAt_const _ _⟩
  -- Step 3(d): stationarity in `U ∩ N` gives `δV(Xᵀ) = 0`
  have hδXT : R.firstVariation (fun x => Pt x (X x)) = 0 := hstat _ hXTc hXTc' hXTsU hXTtan
  -- Step 4: integral form of `δV(X)` and `δV(Xᵀ)` (sibling `first_variation_integral`), and
  -- `div_M X = div_M Xᵀ + div_M Y` with `Y = X − Xᵀ`
  obtain ⟨hiX, hδX⟩ := Submission.dsmc_firstVariation_eq_integral P n U R X hX hXc hXsU hpm
  obtain ⟨hiXT, hδXT'⟩ :=
    Submission.dsmc_firstVariation_eq_integral P n U R _ hXTc hXTc' hXTsU hpm
  have hdivY : ∀ x, tangentialDivergence n R.carrier (fun y => X y - Pt y (X y)) x =
      tangentialDivergence n R.carrier X x -
        tangentialDivergence n R.carrier (fun x => Pt x (X x)) x := by
    intro x
    have hD : fderiv ℝ (fun y => X y - Pt y (X y)) x =
        fderiv ℝ X x - fderiv ℝ (fun x => Pt x (X x)) x :=
      fderiv_sub (hX.differentiable one_ne_zero x) (hXTc.differentiable one_ne_zero x)
    simp only [tangentialDivergence, hD, ContinuousLinearMap.toLinearMap_sub, LinearMap.comp_sub,
      map_sub]
  -- Step 5: `div_M Y = −⟨X, H⟩` at `μ_V`-a.e. `x`
  have hae : (fun x => tangentialDivergence n R.carrier (fun y => X y - Pt y (X y)) x)
      =ᵐ[R.measure] fun x => -inner ℝ (X x) ((ball y₀ (2 * r)).indicator
        (fun x => Φ (fderiv ℝ Pt x) (approxTangentPlane n R.carrier x).starProjection) x) := by
    filter_upwards [hN, hTN] with x hxN hxT
    by_cases hxK : x ∈ tsupport X
    · -- Step 5(b)–(d): `DY(x)u = DX(x)u − Pt(x)DX(x)u − (DPt(x)u)X(x)`, and for an orthonormal
      -- basis `τ` of `TₓM ⊆ TₓN`: `⟨τᵢ, Pt(x)DX(x)τᵢ⟩ = ⟨τᵢ, DX(x)τᵢ⟩` and
      -- `⟨τᵢ, (DPt(x)τᵢ)X(x)⟩ = ⟨(DPt(x)τᵢ)τᵢ, X(x)⟩`
      have hx2 : x ∈ ball y₀ (2 * r) := hXs hxK
      have hx3 : x ∈ ball y₀ (3 * r) := h23 hx2
      set τ := stdOrthonormalBasis ℝ (approxTangentPlane n R.carrier x)
      have hfix : ∀ v ∈ approxTangentPlane n R.carrier x, Pt x v = v := fun v hv =>
        hPtfix x ⟨hxN, hx3⟩ v (hxT hx3 hv)
      have hXd : DifferentiableAt ℝ X x := hX.differentiable one_ne_zero x
      have hXTd : DifferentiableAt ℝ (fun y => Pt y (X y)) x := (hPtd x hx3).clm_apply hXd
      have hD : fderiv ℝ (fun y => X y - Pt y (X y)) x =
          fderiv ℝ X x - ((Pt x).comp (fderiv ℝ X x) + (fderiv ℝ Pt x).flip (X x)) := by
        rw [fderiv_fun_sub hXd hXTd, fderiv_clm_apply (hPtd x hx3) hXd]
      rw [indicator_of_mem hx2, hcontr _ _ τ]
      simp only [tangentialDivergence]
      rw [htr _ _ τ, hD, inner_sum, ← Finset.sum_neg_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      have hfixi : Pt x (τ i : Euclid P) = τ i := hfix _ (τ i).2
      simp only [sub_apply, add_apply, ContinuousLinearMap.comp_apply,
        ContinuousLinearMap.flip_apply, inner_sub_right, inner_add_right]
      rw [← hsym x hx3, hfixi, ← hDsym x hx3, real_inner_comm (X x)]
      ring
    · -- Step 5(a): off `spt X`, `Y` vanishes near `x`
      have hev : (fun y => X y - Pt y (X y)) =ᶠ[𝓝 x] fun _ => 0 := by
        filter_upwards [hXzero x hxK] with y hy
        simp [hy]
      have hX0 : X x = 0 := image_eq_zero_of_notMem_tsupport hxK
      simp only [tangentialDivergence, hev.fderiv_eq, hX0, inner_zero_left, neg_zero]
      simp
  -- Step 6: `δV(X) = ∫ div_M Xᵀ + ∫ div_M Y = ∫ div_M Y = −∫ ⟨X, H⟩`
  calc R.firstVariation X = ∫ x, tangentialDivergence n R.carrier X x ∂R.measure := hδX
    _ = ∫ x, tangentialDivergence n R.carrier (fun y => X y - Pt y (X y)) x ∂R.measure := by
        simp_rw [hdivY]
        rw [integral_sub hiX hiXT, ← hδXT', hδXT, sub_zero]
    _ = _ := integral_congr_ae hae
    _ = _ := integral_neg _
/-- **Simon Ch. 6, 1.2 and 1.5–1.7**: a unit orientation `ξ = ±τ₁ ∧ ⋯ ∧ τₙ` (`τ` orthonormal)
has `|ξ(α)| ≤ |α|` for the Euclidean coefficient norm, and `L(ζ) = Σ_I ζ(dx^I) dx^I` (`I` strictly
increasing) has `|L(ξ)| ≤ 1` and `ξ(L(ξ)) = 1`.  Every covector expands as `α = Σ_I α(e_I) dx^I`,
and `dx^I(e_J) = δ_IJ`.  Expanding `δ_τ(v) = det(⟨τᵢ, vⱼ⟩)` at `v = τ` gives the Cauchy–Binet
identity `Σ_I dx^I(τ)² = 1`; with Cauchy–Schwarz, `|α(τ)| ≤ |α|`. -/
theorem Submission.dor_ims_unitOrientation_dual : ∀ (P n : ℕ), ∃ L : MultiVector P n →L[ℝ] Covector (Euclid P) n, ∀ (ξ : MultiVector P n) (Q : Submodule ℝ (Euclid P)), IsUnitOrientationOf ξ Q → (∀ α : Covector (Euclid P) n, |ξ α| ≤ covectorEuclideanNorm α) ∧ covectorEuclideanNorm (L ξ) ≤ 1 ∧ ξ (L ξ) = 1 := by
  intro P n
  -- `W u v = Σ_σ sgn σ ∏ₖ ⟨uₖ, v_{σ k}⟩ = det(⟨uₖ, vⱼ⟩)`; `dx^I = W (e ∘ I)` and `δ_τ = W τ`
  let W : (Fin n → Euclid P) → Covector (Euclid P) n := fun u =>
    ContinuousMultilinearMap.alternatization
      ((ContinuousMultilinearMap.mkPiAlgebra ℝ (Fin n) ℝ).compContinuousLinearMap
        fun k => innerSL ℝ (u k))
  have hW : ∀ u v, W u v =
      ∑ σ : Equiv.Perm (Fin n), Equiv.Perm.sign σ • ∏ k, inner ℝ (u k) (v (σ k)) := by
    intro u v
    simp only [W, ContinuousMultilinearMap.alternatization_apply_apply,
      ContinuousMultilinearMap.compContinuousLinearMap_apply,
      ContinuousMultilinearMap.mkPiAlgebra_apply, innerSL_apply_apply, Function.comp_apply]
  -- `W u v = W v u` (the determinant of the transpose): substitute `σ ↦ σ⁻¹` and `k ↦ σ k`
  have hWsymm : ∀ u v, W u v = W v u := by
    intro u v
    rw [hW, hW]
    refine Fintype.sum_equiv (Equiv.inv (Equiv.Perm (Fin n))) _ _ fun σ => ?_
    rw [Equiv.inv_apply, Equiv.Perm.sign_inv,
      ← Equiv.prod_comp σ (fun k => inner ℝ (v k) (u (σ⁻¹ k)))]
    simp only [Equiv.Perm.coe_inv, Equiv.symm_apply_apply, real_inner_comm]
  -- `W u u = 1` for orthonormal `u`: only `σ = 1` contributes
  have hW1 : ∀ u, Orthonormal ℝ u → W u u = 1 := by
    intro u hu
    rw [hW, Finset.sum_eq_single (1 : Equiv.Perm (Fin n))]
    · rw [Equiv.Perm.sign_one, one_smul]
      refine Finset.prod_eq_one fun k _ => ?_
      rw [Equiv.Perm.coe_one, id, real_inner_self_eq_norm_sq, hu.norm_eq_one, one_pow]
    · intro σ _ hσ
      obtain ⟨k, hk⟩ : ∃ k, σ k ≠ k := by
        by_contra! h
        exact hσ (Equiv.ext h)
      rw [Finset.prod_eq_zero (Finset.mem_univ k) (hu.inner_eq_zero hk.symm), smul_zero]
    · exact fun h => absurd (Finset.mem_univ _) h
  -- Kronecker property `dx^I(e_J) = δ_IJ` for strictly increasing `I`, `J`: a nonzero term
  -- forces `J ∘ σ = I`, so `range I = range J` and `I = J`
  let e := EuclideanSpace.basisFun (Fin P) ℝ
  have he : ∀ i j, inner ℝ (e i) (e j) = if i = j then (1 : ℝ) else 0 :=
    orthonormal_iff_ite.mp e.orthonormal
  have hK : ∀ I J : Fin n → Fin P, StrictMono I → StrictMono J →
      W (fun k => e (I k)) (fun k => e (J k)) = if I = J then 1 else 0 := by
    intro I J hI hJ
    split_ifs with hIJ
    · subst hIJ
      have hIo : Orthonormal ℝ (fun k => e (I k)) := e.orthonormal.comp I hI.injective
      exact hW1 _ hIo
    · rw [hW]
      refine Finset.sum_eq_zero fun σ _ => ?_
      rw [Finset.prod_eq_zero_iff.mpr, smul_zero]
      by_contra! h
      apply hIJ
      have hJσ : J ∘ σ = I := funext fun k => by
        have := h k (Finset.mem_univ k)
        rw [he] at this
        split_ifs at this with hk
        · exact hk.symm
        · exact absurd rfl this
      rw [← (StrictMono.range_inj_of_wellFoundedLT hI hJ), ← hJσ, EquivLike.range_comp]
  -- expansion `α = Σ_{I ∈ S} α(e_I) dx^I`: both sides are alternating, so compare them on
  -- `e ∘ f`, `f` injective; writing `f = J ∘ σ⁻¹` with `J` strictly increasing (`J = f ∘ sort f`)
  -- reduces this to `e ∘ J`, where it is the Kronecker property
  let S : Finset (Fin n → Fin P) := Finset.univ.filter StrictMono
  have hE : ∀ α : Covector (Euclid P) n,
      α = ∑ I ∈ S, α (fun k => e (I k)) • W (fun k => e (I k)) := by
    intro α
    apply ContinuousAlternatingMap.toAlternatingMap_injective
    refine e.toBasis.ext_alternating fun f hf => ?_
    simp only [OrthonormalBasis.coe_toBasis, ContinuousAlternatingMap.coe_toAlternatingMap]
    set σ := Tuple.sort f
    have hJ : StrictMono (f ∘ σ) :=
      (Tuple.monotone_sort f).strictMono_of_injective (hf.comp σ.injective)
    have hperm : ∀ β : Covector (Euclid P) n,
        β (fun k => e (f k)) = Equiv.Perm.sign σ⁻¹ • β (fun k => e ((f ∘ σ) k)) := by
      intro β
      have : (fun k => e (f k)) = (fun k => e ((f ∘ σ) k)) ∘ ⇑(σ⁻¹) := by
        funext k
        simp
      rw [this]
      exact β.toAlternatingMap.map_perm _ _
    rw [hperm α, hperm, ContinuousAlternatingMap.sum_apply, Finset.sum_eq_single (f ∘ σ)]
    · rw [ContinuousAlternatingMap.smul_apply, hK _ _ hJ hJ, ite_eq_left rfl, smul_eq_mul,
        mul_one]
    · intro I hI hIJ
      rw [ContinuousAlternatingMap.smul_apply, hK _ _ (Finset.mem_filter.mp hI).2 hJ,
        ite_eq_right hIJ, smul_zero]
    · exact fun h => absurd (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hJ⟩) h
  -- `|β| = (Σ_{I ∈ S} β(e_I)²)^{1/2}`
  have hnorm : ∀ β : Covector (Euclid P) n,
      covectorEuclideanNorm β = Real.sqrt (∑ I ∈ S, β (fun k => e (I k)) ^ 2) := by
    intro β
    rw [covectorEuclideanNorm, Finset.sum_filter]
  -- Cauchy–Binet `Σ_{I ∈ S} dx^I(τ)² = 1` for orthonormal `τ`: evaluate the expansion of `δ_τ`
  -- at `τ`, using `δ_τ(τ) = 1` and `δ_τ(e_I) = dx^I(τ)`
  have hCB : ∀ τ : Fin n → Euclid P, Orthonormal ℝ τ →
      ∑ I ∈ S, W (fun k => e (I k)) τ ^ 2 = 1 := by
    intro τ hτ
    have h := congrArg (fun β : Covector (Euclid P) n => β τ) (hE (W τ))
    simp only [ContinuousAlternatingMap.sum_apply, ContinuousAlternatingMap.smul_apply,
      smul_eq_mul, hW1 τ hτ] at h
    rw [h]
    refine Finset.sum_congr rfl fun I _ => ?_
    rw [hWsymm τ, sq]
  -- `L ζ = Σ_{I ∈ S} ζ(dx^I) dx^I`
  refine ⟨∑ I ∈ S, (ContinuousLinearMap.apply ℝ ℝ (W fun k => e (I k))).smulRight
    (W fun k => e (I k)), ?_⟩
  rintro ξ Q ⟨τ, hτ, -, hξ⟩
  -- `ξ(α) = ±α(τ)` with a common sign
  have hξ2 : ∀ α β : Covector (Euclid P) n, ξ α * ξ β = α τ * β τ := by
    intro α β
    rcases hξ with h | h
    · rw [h, h]
    · rw [h, h, neg_mul_neg]
  have hξabs : ∀ α : Covector (Euclid P) n, |ξ α| = |α τ| := by
    intro α
    rcases hξ with h | h
    · rw [h]
    · rw [h, abs_neg]
  have hL : ∀ ζ : MultiVector P n, (∑ I ∈ S, (ContinuousLinearMap.apply ℝ ℝ
      (W fun k => e (I k))).smulRight (W fun k => e (I k))) ζ =
      ∑ I ∈ S, ζ (W fun k => e (I k)) • W fun k => e (I k) := by
    intro ζ
    simp only [sum_apply, ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.apply_apply]
  have hCBτ := hCB τ hτ
  refine ⟨fun α => ?_, ?_, ?_⟩
  · -- (a) `|ξ(α)| = |Σ_I α(e_I) dx^I(τ)| ≤ |α| (Σ_I dx^I(τ)²)^{1/2} = |α|`
    rw [hξabs, hnorm]
    apply Real.abs_le_sqrt
    have h := congrArg (fun β : Covector (Euclid P) n => β τ) (hE α)
    simp only [ContinuousAlternatingMap.sum_apply, ContinuousAlternatingMap.smul_apply,
      smul_eq_mul] at h
    rw [h]
    calc (∑ I ∈ S, α (fun k => e (I k)) * W (fun k => e (I k)) τ) ^ 2
        ≤ (∑ I ∈ S, α (fun k => e (I k)) ^ 2) * ∑ I ∈ S, W (fun k => e (I k)) τ ^ 2 :=
          Finset.sum_mul_sq_le_sq_mul_sq _ _ _
      _ = ∑ I ∈ S, α (fun k => e (I k)) ^ 2 := by rw [hCBτ, mul_one]
  · -- (b) `L(ξ)(e_J) = ξ(dx^J)`, so `|L(ξ)|² = Σ_J ξ(dx^J)² = Σ_J dx^J(τ)² = 1`
    rw [hnorm, hL]
    have : ∑ J ∈ S, (∑ I ∈ S, ξ (W fun k => e (I k)) • W fun k => e (I k))
        (fun k => e (J k)) ^ 2 = 1 := by
      rw [← hCBτ]
      refine Finset.sum_congr rfl fun J hJ => ?_
      rw [ContinuousAlternatingMap.sum_apply, Finset.sum_eq_single J]
      · rw [ContinuousAlternatingMap.smul_apply, hK _ _ (Finset.mem_filter.mp hJ).2
          (Finset.mem_filter.mp hJ).2, ite_eq_left rfl, smul_eq_mul, mul_one, sq, sq, hξ2]
      · intro I hI hIJ
        rw [ContinuousAlternatingMap.smul_apply, hK _ _ (Finset.mem_filter.mp hI).2
          (Finset.mem_filter.mp hJ).2, ite_eq_right hIJ, smul_zero]
      · exact fun h => absurd hJ h
    rw [this, Real.sqrt_one]
  · -- (c) `ξ(L(ξ)) = Σ_I ξ(dx^I)² = Σ_I dx^I(τ)² = 1`
    rw [hL, map_sum, ← hCBτ]
    refine Finset.sum_congr rfl fun I _ => ?_
    rw [map_smul, smul_eq_mul, hξ2, sq]
/-- **Simon Ch. 6, 3.1 (‡), 3.2(3)**: for `R = (M, θ, ξ)` and `ω ∈ 𝒟ⁿ(U)`, the function
`x ↦ ⟨ω(x), ξ(x)⟩` is `μ_R`-integrable and `τ(M, θ, ξ)(ω) = ∫ ⟨ω, ξ⟩ dμ_R`, `μ_R = θ Hⁿ⌞M`.
`μ_R`-a.e. `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ` with `τ` orthonormal, so `|⟨ω(x), ξ(x)⟩| ≤ ‖ω(x)‖`; this is
bounded and vanishes off the compact `spt ω ⊆ U`, which has finite `μ_R`-measure. -/
theorem Submission.dor_ims_action_eq_integral : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (ω : TestFormOn U n), Integrable (fun x => R.orient x ((ω : DifferentialForm (Euclid P) n) x)) R.measure ∧ R.action (ω : DifferentialForm (Euclid P) n) = ∫ x, R.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂R.measure := by
  intro P n U R ω
  obtain ⟨⟨hsmooth, hcpt⟩, hU⟩ := ω.2
  set f : DifferentialForm (Euclid P) n := (ω : DifferentialForm (Euclid P) n)
  have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) := measurable_from_nat.comp R.measurable_mult
  have hac : R.measure ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
  -- `x ↦ ξ(x)(ω(x))` is `μ_R`-a.e. strongly measurable
  have hmeas : AEStronglyMeasurable (fun x => R.orient x (f x)) R.measure :=
    isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable₂
      (R.aestronglyMeasurable_orient.mono_ac hac) hsmooth.continuous.aestronglyMeasurable
  -- `|ξ(x)(ω(x))| ≤ C 1_K(x)`, `K = spt ω`
  obtain ⟨C, hC⟩ := hsmooth.continuous.bounded_above_of_compact_support hcpt
  have hKm : MeasurableSet (tsupport f) := (isClosed_tsupport f).measurableSet
  have hbound : ∀ᵐ x ∂R.measure, ‖R.orient x (f x)‖ ≤ (tsupport f).indicator (fun _ => C) x := by
    filter_upwards [hac.ae_le R.orients] with x hx
    obtain ⟨Q, -, τ, hτ, -, hξ⟩ := hx
    by_cases hxK : x ∈ tsupport f
    · rw [Set.indicator_of_mem hxK]
      have hτ1 : ‖f x τ‖ ≤ ‖f x‖ := by
        simpa [hτ.norm_eq_one] using (f x).le_opNorm τ
      rcases hξ with h | h
      · rw [h]
        exact hτ1.trans (hC x)
      · rw [h, norm_neg]
        exact hτ1.trans (hC x)
    · rw [Set.indicator_of_notMem hxK, image_eq_zero_of_notMem_tsupport hxK, map_zero, norm_zero]
  -- `μ_R(K) = ∫_{M ∩ K} θ dHⁿ < ∞`
  have hKfin : R.measure (tsupport f) ≠ ∞ := by
    rw [IMRep.measure, withDensity_apply _ hKm, Measure.restrict_restrict hKm,
      Set.inter_comm (tsupport f) R.carrier]
    exact R.locallyIntegrable_mult _ hcpt hU
  have hint : Integrable (fun x => R.orient x (f x)) R.measure :=
    ((integrable_indicator_iff hKm).2 (integrableOn_const hKfin)).mono' hmeas hbound
  refine ⟨hint, ?_⟩
  -- `∫ g d(θ Hⁿ⌞M) = ∫_M θ g dHⁿ`
  rw [IMRep.measure, integral_withDensity_eq_integral_toReal_smul hθ
    (ae_of_all _ fun x => ENNReal.natCast_lt_top _), IMRep.action]
  simp only [ENNReal.toReal_natCast, smul_eq_mul]
/-- Helly selection with no concentration on left intervals (the compactness ingredient of the
choice of the slicing level in the proof of Simon 6.7.2, "an argument as in 6.7(2) of Ch. 2"): if
`μⱼ([a, b]) ≤ Λ < ∞`, then along a subsequence `φ` and off a countable set `N`, every
`s ∈ (a, b) \ N` and `ε > 0` admit `δ > 0` with `μ_{φ j}([s - δ, s]) ≤ ε` for all large `j`.
By Tychonoff, `μ_{φ j}([a, d]) → G(d)` for every rational `d ∈ (a, b)`; `N` is the discontinuity
set of the nondecreasing `G̃(t) = sup ({0} ∪ {G(d) : d < t})`, and `[s - δ, s] ⊆ [a, d₂] \ [a, d₁]`
for rationals `d₁ < s - δ`, `s < d₂` with `G(d₂) - G(d₁) < ε`. -/
theorem Submission.cmc_fc_gs_helly_no_concentration : ∀ (μ : ℕ → Measure ℝ) (a b : ℝ) (Λ : ℝ≥0∞), Λ ≠ ∞ → (∀ j, μ j (Icc a b) ≤ Λ) → ∃ (φ : ℕ → ℕ) (N : Set ℝ), StrictMono φ ∧ N.Countable ∧ ∀ s ∈ Ioo a b, s ∉ N → ∀ ε : ℝ≥0∞, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ᶠ j in atTop, μ (φ j) (Icc (s - δ) s) ≤ ε := by
  intro μ a b Λ hΛ hμ
  -- `μⱼ([a, x]) ≤ μⱼ([a, b]) ≤ Λ < ∞` for `x ≤ b`
  have hle : ∀ j x, x ≤ b → μ j (Icc a x) ≤ Λ := fun j x hx =>
    (measure_mono (Icc_subset_Icc_right hx)).trans (hμ j)
  have hfin : ∀ j x, x ≤ b → μ j (Icc a x) ≠ ∞ := fun j x hx =>
    ((hle j x hx).trans_lt hΛ.lt_top).ne
  -- Helly selection: `d ↦ μⱼ([a, d])` lies in the compact box `∏_{d ∈ ℚ ∩ (a, b)} [0, Λ]` of
  -- the first countable space `ℝ^(ℚ ∩ (a, b))`
  have hK : IsCompact (univ.pi fun _ : {q : ℚ // (q : ℝ) ∈ Ioo a b} => Icc (0 : ℝ) Λ.toReal) :=
    isCompact_univ_pi fun _ => isCompact_Icc
  obtain ⟨G, hGK, φ, hφ, hlim⟩ := hK.tendsto_subseq
    (x := fun j d => (μ j (Icc a (d.1 : ℝ))).toReal)
    fun j d _ => ⟨ENNReal.toReal_nonneg, ENNReal.toReal_mono hΛ (hle j _ d.2.2.le)⟩
  have hGd : ∀ d : {q : ℚ // (q : ℝ) ∈ Ioo a b},
      Tendsto (fun j => (μ (φ j) (Icc a (d.1 : ℝ))).toReal) atTop (𝓝 (G d)) :=
    tendsto_pi_nhds.1 hlim
  -- `G` is nondecreasing
  have hGmono : ∀ d d' : {q : ℚ // (q : ℝ) ∈ Ioo a b}, (d.1 : ℝ) ≤ d'.1 → G d ≤ G d' :=
    fun d d' h => le_of_tendsto_of_tendsto' (hGd d) (hGd d') fun j =>
      ENNReal.toReal_mono (hfin _ _ d'.2.2.le) (measure_mono (Icc_subset_Icc_right h))
  -- `G̃(t) = sup ({0} ∪ {G(d) : d < t})`
  obtain ⟨Gt, hGt⟩ : ∃ Gt : ℝ → ℝ, ∀ t, Gt t = sSup (insert 0 (G '' {d | (d.1 : ℝ) < t})) :=
    ⟨_, fun _ => rfl⟩
  have hbdd : ∀ t, BddAbove (insert 0 (G '' {d | (d.1 : ℝ) < t})) := fun t =>
    ⟨Λ.toReal, by
      rintro x (rfl | ⟨d, -, rfl⟩)
      exacts [ENNReal.toReal_nonneg, (hGK d (mem_univ d)).2]⟩
  -- (α) `G(d) ≤ G̃(t)` if `d < t`; (β) `G̃(t) ≤ G(d)` if `t < d`
  have hα : ∀ d t, (d.1 : ℝ) < t → G d ≤ Gt t := fun d t h => by
    rw [hGt]
    exact le_csSup (hbdd t) (mem_insert_of_mem _ ⟨d, h, rfl⟩)
  have hβ : ∀ d t, t < (d.1 : ℝ) → Gt t ≤ G d := fun d t h => by
    rw [hGt]
    refine csSup_le (insert_nonempty _ _) ?_
    rintro x (rfl | ⟨d', hd', rfl⟩)
    exacts [(hGK d (mem_univ d)).1, hGmono d' d (lt_trans hd' h).le]
  have hmono : Monotone Gt := fun t t' h => by
    rw [hGt, hGt]
    exact csSup_le_csSup (hbdd t') (insert_nonempty _ _)
      (insert_subset_insert (image_mono fun d hd => lt_of_lt_of_le hd h))
  -- `N` is the countable set of discontinuities of the monotone `G̃`
  refine ⟨φ, {t | ¬ContinuousAt Gt t}, hφ, hmono.countable_not_continuousAt, ?_⟩
  intro s hs hsN ε hε
  have hcont : ContinuousAt Gt s := by
    by_contra h
    exact hsN h
  rcases eq_or_ne ε ∞ with rfl | hε'
  · exact ⟨1, one_pos, Eventually.of_forall fun _ => le_top⟩
  have he : 0 < ε.toReal := ENNReal.toReal_pos hε.ne' hε'
  obtain ⟨η₀, hη₀, hcη⟩ := Metric.continuousAt_iff.1 hcont (ε.toReal / 2) (half_pos he)
  -- `δ = η = min (η₀ / 3, (s - a) / 3, (b - s) / 2)`
  obtain ⟨hsa, hsb⟩ := hs
  set η := min (η₀ / 3) (min ((s - a) / 3) ((b - s) / 2))
  have h1 : η ≤ η₀ / 3 := min_le_left _ _
  have h2 : η ≤ (s - a) / 3 := (min_le_right _ _).trans (min_le_left _ _)
  have h3 : η ≤ (b - s) / 2 := (min_le_right _ _).trans (min_le_right _ _)
  have hη : 0 < η := lt_min (by linarith) (lt_min (by linarith) (by linarith))
  -- rationals `d₁ ∈ (s - 2η, s - η)` and `d₂ ∈ (s, s + η)`, both in `(a, b)`
  obtain ⟨q₁, hq₁, hq₁'⟩ := exists_rat_btwn (show s - 2 * η < s - η by linarith)
  obtain ⟨q₂, hq₂, hq₂'⟩ := exists_rat_btwn (show s < s + η by linarith)
  have hd₁ : (q₁ : ℝ) ∈ Ioo a b := ⟨by linarith, by linarith⟩
  have hd₂ : (q₂ : ℝ) ∈ Ioo a b := ⟨by linarith, by linarith⟩
  -- `G(d₂) - G(d₁) ≤ G̃(s + η) - G̃(s - 2η) < ε`
  have hup := @hcη (s + η) (by rw [Real.dist_eq, abs_lt]; constructor <;> linarith)
  have hdown := @hcη (s - 2 * η) (by rw [Real.dist_eq, abs_lt]; constructor <;> linarith)
  rw [Real.dist_eq, abs_lt] at hup hdown
  have hlt : G ⟨q₂, hd₂⟩ - G ⟨q₁, hd₁⟩ < ε.toReal := by
    have := hα ⟨q₂, hd₂⟩ (s + η) hq₂'
    have := hβ ⟨q₁, hd₁⟩ (s - 2 * η) hq₁
    linarith [hup.2, hdown.1]
  -- `μ_{φ j}([s - η, s]) ≤ μ_{φ j}([a, d₂] \ [a, d₁])`, which tends to `G(d₂) - G(d₁) < ε`
  refine ⟨η, hη, (((hGd ⟨q₂, hd₂⟩).sub (hGd ⟨q₁, hd₁⟩)).eventually_lt_const hlt).mono
    fun j hj => ?_⟩
  have hsub : Icc (s - η) s ⊆ Icc a (q₂ : ℝ) \ Icc a (q₁ : ℝ) := by
    rintro x ⟨hx1, hx2⟩
    exact ⟨⟨by linarith, by linarith⟩, fun hx => by linarith [hx.2]⟩
  calc μ (φ j) (Icc (s - η) s) ≤ μ (φ j) (Icc a (q₂ : ℝ) \ Icc a (q₁ : ℝ)) := measure_mono hsub
    _ = μ (φ j) (Icc a (q₂ : ℝ)) - μ (φ j) (Icc a (q₁ : ℝ)) :=
      measure_sdiff (Icc_subset_Icc_right (by linarith)) measurableSet_Icc.nullMeasurableSet
        (hfin _ _ hd₁.2.le)
    _ = ENNReal.ofReal ((μ (φ j) (Icc a (q₂ : ℝ))).toReal - (μ (φ j) (Icc a (q₁ : ℝ))).toReal) := by
      rw [ENNReal.ofReal_sub _ ENNReal.toReal_nonneg, ENNReal.ofReal_toReal (hfin _ _ hd₂.2.le),
        ENNReal.ofReal_toReal (hfin _ _ hd₁.2.le)]
    _ ≤ ENNReal.ofReal ε.toReal := ENNReal.ofReal_le_ofReal hj.le
    _ = ε := ENNReal.ofReal_toReal hε'

/-- Choice of a good cutting level (the Helly extraction, Fatou's lemma for the slice masses and the
choice of the level in the localization step of the proof of Simon 6.7.2, stated abstractly): if
`νⱼ([a, b]) ≤ Λ`, `∫ Fⱼ ≤ Λ < ∞` and `Goodⱼ` holds a.e. for every `j`, then there are
`s ∈ (a, b)`, a subsequence `φ` and `C < ∞` with `Goodⱼ(s)` for all `j`, `F_{φ j}(s) ≤ C`, and for
every `ε > 0` some `δ > 0` with `ν_{φ j}([s - δ, s]) ≤ ε` for all large `j`.
Helly selection gives `φ₁` and a countable `N`; by Fatou `h = liminf F_{φ₁ i}` has `∫ h ≤ Λ`, so
a.e. `t` has every `Goodⱼ(t)`, `h(t) < ∞` and `t ∉ N`.  Such an `s` lies in `(a, b)`, and `φ₂`
extracts `F_{φ₁ (φ₂ j)}(s) < h(s) + 1 = C`; `φ = φ₁ ∘ φ₂`. -/
theorem Submission.dor_lmb_fcl_good_level : ∀ (ν : ℕ → Measure ℝ) (F : ℕ → ℝ → ℝ≥0∞) (Good : ℕ → ℝ → Prop) (a b : ℝ) (Λ : ℝ≥0∞), a < b → Λ ≠ ∞ → (∀ j, ν j (Icc a b) ≤ Λ) → (∀ j, AEMeasurable (F j)) → (∀ j, ∫⁻ t, F j t ≤ Λ) → (∀ j, ∀ᵐ t, Good j t) → ∃ s ∈ Ioo a b, ∃ (φ : ℕ → ℕ) (C : ℝ≥0∞), StrictMono φ ∧ C ≠ ∞ ∧ (∀ j, Good j s) ∧ (∀ j, F (φ j) s ≤ C) ∧ ∀ ε : ℝ≥0∞, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ᶠ j in atTop, ν (φ j) (Icc (s - δ) s) ≤ ε := by
  intro ν F Good a b Λ hab hΛ hν hF hFΛ hGood
  -- Step 1 (Helly): `φ₁` and a countable `N` off which `ν_{φ₁ i}` does not concentrate
  obtain ⟨φ₁, N, hφ₁, hN, hH⟩ := Submission.cmc_fc_gs_helly_no_concentration ν a b Λ hΛ hν
  -- Step 2 (Fatou along `φ₁`): `∫ h ≤ liminf ∫ F_{φ₁ i} ≤ Λ` for `h = liminf F_{φ₁ i}`
  have hmeas : ∀ i, AEMeasurable (F (φ₁ i)) := fun i => hF (φ₁ i)
  have hfatou : ∫⁻ t, liminf (fun i => F (φ₁ i) t) atTop ≤ Λ :=
    (lintegral_liminf_le' hmeas).trans
      (liminf_le_of_frequently_le' (Frequently.of_forall fun i => hFΛ (φ₁ i)))
  -- Step 3: `h` is a.e.-measurable with finite integral, hence finite a.e.
  have hfin : ∀ᵐ t, liminf (fun i => F (φ₁ i) t) atTop < ∞ :=
    ae_lt_top' (AEMeasurable.liminf hmeas) (hfatou.trans_lt hΛ.lt_top).ne
  -- Step 4: a.e. `t` has `Goodⱼ(t)` for all `j`, `h(t) < ∞` and `t ∉ N` (`N` is countable)
  have hae : ∀ᵐ t, (∀ j, Good j t) ∧ liminf (fun i => F (φ₁ i) t) atTop < ∞ ∧ t ∉ N := by
    filter_upwards [ae_all_iff.2 hGood, hfin,
      measure_eq_zero_iff_ae_notMem.1 (hN.measure_zero volume)] with t h1 h2 h3
    exact ⟨h1, h2, h3⟩
  -- Step 5: `(a, b)` has positive measure, so it meets this full-measure set
  obtain ⟨s, hs, hGs, hhs, hsN⟩ : ∃ s ∈ Ioo a b,
      (∀ j, Good j s) ∧ liminf (fun i => F (φ₁ i) s) atTop < ∞ ∧ s ∉ N := by
    by_contra hcon
    refine (ENNReal.ofReal_pos.2 (sub_pos.2 hab)).ne' ?_
    rw [← Real.volume_Ioo]
    exact measure_mono_null (fun t ht hPt => hcon ⟨t, ht, hPt⟩) (ae_iff.1 hae)
  -- Step 6: `h(s) < h(s) + 1 = C`, so `F_{φ₁ i}(s) < C` frequently; extract `φ₂`
  obtain ⟨φ₂, hφ₂, hC⟩ := extraction_of_frequently_atTop
    (frequently_lt_of_liminf_lt (h := ENNReal.lt_add_right hhs.ne one_ne_zero))
  -- Step 7: `φ = φ₁ ∘ φ₂`; no concentration passes to `φ` since `φ₂ j ≥ j`
  refine ⟨s, hs, φ₁ ∘ φ₂, liminf (fun i => F (φ₁ i) s) atTop + 1, hφ₁.comp hφ₂,
    ENNReal.add_ne_top.2 ⟨hhs.ne, ENNReal.one_ne_top⟩, hGs, fun j => (hC j).le, fun ε hε => ?_⟩
  obtain ⟨δ, hδ, hev⟩ := hH s hs hsN ε hε
  obtain ⟨J, hJ⟩ := eventually_atTop.1 hev
  exact ⟨δ, hδ, eventually_atTop.2 ⟨J, fun j hj => hJ (φ₂ j) (le_trans hj (hφ₂.id_le j))⟩⟩
/-- **Compact distance sublevel sets** (Simon Ch. 6, proof of 7.2, localization): if `U ⊆ ℝᴾ` is
open and `C ⊆ U` is compact and nonempty, there is `δ₀ > 0` such that for every `r ≤ δ₀` the
sublevel set `{x : dist(x, C) ≤ r}` is compact and contained in `U`.  Take `δ₀` with
`cthickening δ₀ C ⊆ U`; each such sublevel set is closed (`dist(·, C)` is continuous) and lies in
the compact set `cthickening δ₀ C`. -/
theorem Submission.cmc_fcl_dist_sublevel_compact : ∀ (P : ℕ) (U C : Set (Euclid P)), IsOpen U → IsCompact C → C ⊆ U → C.Nonempty → ∃ δ₀ : ℝ, 0 < δ₀ ∧ ∀ r : ℝ, r ≤ δ₀ → IsCompact {x | infDist x C ≤ r} ∧ {x | infDist x C ≤ r} ⊆ U := by
  intro P U C hU hC hCU hCne
  -- some closed thickening `cthickening δ₀ C` of `C` lies in `U`
  obtain ⟨δ₀, hδ₀, hsub⟩ := hC.exists_cthickening_subset_open hU hCU
  refine ⟨δ₀, hδ₀, fun r hr => ?_⟩
  -- `{dist(·, C) ≤ r} ⊆ cthickening δ₀ C`, since `infEDist x C = ofReal (dist(x, C))` for `C ≠ ∅`
  have hsubset : {x | infDist x C ≤ r} ⊆ cthickening δ₀ C := by
    intro x hx
    have hx' : infDist x C ≤ δ₀ := le_trans hx hr
    rw [mem_cthickening_iff, ← ENNReal.ofReal_toReal (infEDist_ne_top hCne)]
    exact ENNReal.ofReal_le_ofReal hx'
  -- the sublevel set of the continuous function `dist(·, C)` is closed
  have hclosed : IsClosed {x | infDist x C ≤ r} :=
    isClosed_le (continuous_infDist_pt C) continuous_const
  -- a closed subset of the compact set `cthickening δ₀ C ⊆ U`
  exact ⟨hC.cthickening.of_isClosed_subset hclosed hsubset, hsubset.trans hsub⟩
/-- **Integral data of an integer multiplicity representation** (Simon 6.3.1, 6.3.2(3)).  If
`R = (M, θ, ξ)` represents `Z`, then `μ = R.measure = (Hⁿ⌞M).withDensity θ` is finite on compact
subsets of `U`, `ξ` is `μ`-a.e. strongly measurable, an `Hⁿ⌞M`-a.e. bound
`|⟨α, ξ(x)⟩| ≤ |α|` also holds `μ`-a.e., and `Z(ω) = ∫ ⟨ω(x), ξ(x)⟩ dμ(x)`.  The first three
follow from `μ ≪ Hⁿ⌞M` and the field `locallyIntegrable_mult`; the last from
`∫ F d((Hⁿ⌞M).withDensity θ) = ∫ θ F d(Hⁿ⌞M)`. -/
theorem Submission.cmc_fcl_imrep_integral_data : ∀ (P n : ℕ) (U : Set (Euclid P)) (Z : GeometricCurrentOn U n) (R : IMRep U n), R.Represents Z → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → R.measure K < ∞) ∧ AEStronglyMeasurable R.orient R.measure ∧ ((∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α) → ∀ᵐ x ∂R.measure, ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α) ∧ ∀ ω : TestFormOn U n, Z ω = ∫ x, R.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂R.measure := by
  intro P n U Z R hZ
  -- Step 1: `R.measure = (Hⁿ⌞M).withDensity θ ≪ Hⁿ⌞M`
  have hac : R.measure ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
  -- Steps 3–4: a.e. strong measurability of `ξ` and the a.e. bound transfer along `≪`
  refine ⟨?_, R.aestronglyMeasurable_orient.mono_ac hac, fun h => hac.ae_le h, ?_⟩
  -- Step 2: for compact (hence Borel) `K ⊆ U`, `R.measure K = ∫⁻_{M ∩ K} θ dHⁿ < ∞`
  · intro K hK hKU
    have hKm : MeasurableSet K := hK.isClosed.measurableSet
    rw [IMRep.measure, withDensity_apply _ hKm, Measure.restrict_restrict hKm, inter_comm]
    exact lt_top_iff_ne_top.2 (R.locallyIntegrable_mult K hK hKU)
  -- Step 5: `Z(ω) = ∫_M θ ⟨ω, ξ⟩ dHⁿ = ∫ ⟨ω, ξ⟩ d((Hⁿ⌞M).withDensity θ)`, with the density
  -- `θ` written as the measurable `ℝ≥0`-valued `x ↦ (θ(x) : ℝ≥0)`
  · intro ω
    rw [hZ ω, IMRep.action, IMRep.measure]
    have hf : Measurable fun x => (R.mult x : NNReal) :=
      (measurable_from_nat (f := fun k : ℕ => (k : NNReal))).comp R.measurable_mult
    have hcoe : (fun x => (R.mult x : ℝ≥0∞)) = fun x => ((R.mult x : NNReal) : ℝ≥0∞) :=
      funext fun x => (ENNReal.coe_natCast (R.mult x)).symm
    rw [hcoe, integral_withDensity_eq_integral_smul hf]
    simp only [NNReal.smul_def, NNReal.coe_natCast, smul_eq_mul]
/-- **Borel restriction of an integer multiplicity representation** (fact (R6) in the
localization step of the proof of Simon Ch. 6, 7.2, where `T⌞{f < t} = τ(M ∩ {f < t}, θ, ξ)` as
in Ch. 6, 4.5).  If `R = (M, θ, ξ)`, `R' = (M ∩ E, θ, ξ)` with `E` Borel, and `R'` represents
`A`, then `μ_{R'} = μ_R⌞E` and `A(ω) = ∫_E ⟨ω, ξ⟩ dμ_R`.  Restriction to the measurable set `E`
commutes with `withDensity`, and `(Hⁿ⌞M)⌞E = Hⁿ⌞(M ∩ E)`; the action formula is
`A(ω) = ∫ ⟨ω, ξ⟩ dμ_{R'}` (`cmc_fcl_imrep_integral_data`) rewritten with `μ_{R'} = μ_R⌞E`. -/
theorem Submission.cmc_fcl_imrep_restrict_formula : ∀ (P n : ℕ) (U : Set (Euclid P)) (R R' : IMRep U n) (A : GeometricCurrentOn U n) (E : Set (Euclid P)), MeasurableSet E → R'.Represents A → R'.carrier = R.carrier ∩ E → R'.mult = R.mult → R'.orient = R.orient → R'.measure = R.measure.restrict E ∧ ∀ ω : TestFormOn U n, A ω = ∫ x in E, R.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂R.measure := by
  intro P n U R R' A E hE hA hc hm ho
  -- Steps 1–2: `μ_{R'} = (Hⁿ⌞(M ∩ E)).withDensity θ = ((Hⁿ⌞M).withDensity θ)⌞E = μ_R⌞E`
  have hmeas : R'.measure = R.measure.restrict E := by
    rw [IMRep.measure, IMRep.measure, restrict_withDensity hE, Measure.restrict_restrict hE,
      hc, hm, inter_comm]
  refine ⟨hmeas, fun ω => ?_⟩
  -- Step 3: `A(ω) = ∫ ⟨ω, ξ'⟩ dμ_{R'}` (part (d) of `imrep_data`), then `μ_{R'} = μ_R⌞E`, `ξ' = ξ`
  rw [(Submission.cmc_fcl_imrep_integral_data P n U A R' hA).2.2.2 ω, hmeas, ho]
/-- **Mass localization for a current vanishing away from a compact set** (Simon 7.2.4, proof,
step 4(a)).  Let `C ⊆ V` with `C` compact and `V` open, and let `X ∈ 𝒟ₖ(U)` kill every
`ω ∈ 𝒟ᵏ(U)` with `spt ω ∩ C = ∅`.  Then `M_G(X) ≤ M_V(X)` for every `G`.  Choose a smooth
`χ : ℝᴾ → [0, 1]` with `χ = 1` on an open `N ⊇ C` and `spt χ ⊆ V`.  For `ω` admissible
for `M_G`, `(1 − χ)ω` vanishes on `N`, so `X(ω) = X(χω)`, and `χω` is admissible for `M_V`
because `|χω| = χ|ω| ≤ 1`. -/
theorem Submission.lcmp_massOn_le_of_vanish_off_compact : ∀ (P k : ℕ) (U V C : Set (Euclid P)) (X : GeometricCurrentOn U k), IsCompact C → IsOpen V → C ⊆ V → (∀ ω : TestFormOn U k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) C → X ω = 0) → ∀ G : Set (Euclid P), X.massOn G ≤ X.massOn V := by
  intro P k U V C X hC hV hCV hvan G
  -- Step 4: `|cα| = |c| |α|` for the Euclidean coefficient norm
  have hsmul : ∀ (c : ℝ) (α : Covector (Euclid P) k),
      covectorEuclideanNorm (c • α) = |c| * covectorEuclideanNorm α := by
    intro c α
    unfold covectorEuclideanNorm
    have hsum : (∑ I : Fin k → Fin P, if StrictMono I then
        ((c • α) (fun i ↦ EuclideanSpace.basisFun (Fin P) ℝ (I i))) ^ 2 else 0) =
        c ^ 2 * ∑ I : Fin k → Fin P, if StrictMono I then
          (α (fun i ↦ EuclideanSpace.basisFun (Fin P) ℝ (I i))) ^ 2 else 0 := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun I _ => ?_
      split_ifs
      · rw [ContinuousAlternatingMap.smul_apply, smul_eq_mul]
        ring
      · simp
    rw [hsum, Real.sqrt_mul (sq_nonneg c), Real.sqrt_sq_eq_abs]
  -- Step 1: if `C = ∅` then `X = 0`, so `M_G(X) = 0`
  rcases C.eq_empty_or_nonempty with rfl | hCne
  · refine sSup_le ?_
    rintro r ⟨ω, -, rfl⟩
    show ENNReal.ofReal (X ω) ≤ X.massOn V
    rw [hvan ω (disjoint_empty _), ENNReal.ofReal_zero]
    exact zero_le
  -- Step 2: `C ⊆ V' = {dist(·, C) < δ/2}` with `closure V' ⊆ {dist(·, C) ≤ δ/2} ⊆ V`
  obtain ⟨δ, hδ, hδV⟩ := hC.exists_cthickening_subset_open hV hCV
  have hV'o : IsOpen (thickening (δ / 2) C) := isOpen_thickening
  -- Step 3: `χ = τ(2g/a)`, where `{g ≠ 0} = V'`, `a = min_C g > 0`, `τ` the smooth transition
  obtain ⟨g, hgsupp, hgsmooth, hgrange⟩ := hV'o.exists_contDiff_support_eq (n := (⊤ : ℕ∞))
  have hgnn : ∀ x, 0 ≤ g x := fun x => (hgrange ⟨x, rfl⟩).1
  have hgpos : ∀ x ∈ C, 0 < g x := by
    intro x hx
    have hxs : x ∈ support g := by
      rw [hgsupp]
      exact self_subset_thickening (half_pos hδ) C hx
    exact lt_of_le_of_ne (hgnn x) (Ne.symm hxs)
  obtain ⟨x₀, hx₀C, hx₀min⟩ := hC.exists_isMinOn hCne hgsmooth.continuous.continuousOn
  set a := g x₀
  have ha : 0 < a := hgpos x₀ hx₀C
  set χ : Euclid P → ℝ := fun x => Real.smoothTransition (2 * g x / a)
  have hχsmooth : ContDiff ℝ (⊤ : ℕ∞) χ :=
    Real.smoothTransition.contDiff.comp ((contDiff_const.mul hgsmooth).div_const a)
  -- `χ = 1` on the open set `N = {g > a/2} ⊇ C`
  set N : Set (Euclid P) := {x | a / 2 < g x}
  have hNo : IsOpen N := isOpen_lt continuous_const hgsmooth.continuous
  have hCN : C ⊆ N := fun x hx => by
    have h1 : a ≤ g x := hx₀min hx
    show a / 2 < g x
    linarith
  have hχN : ∀ x ∈ N, χ x = 1 := fun x hx => by
    apply Real.smoothTransition.one_of_one_le
    have hx' : a / 2 < g x := hx
    rw [le_div_iff₀ ha]
    linarith
  -- `χ = 0` where `g = 0`, so `spt χ ⊆ closure V' ⊆ {dist(·, C) ≤ δ/2} ⊆ V`
  have hχsupp : support χ ⊆ thickening (δ / 2) C := by
    intro x hx
    by_contra h
    rw [← hgsupp, mem_support, not_not] at h
    apply hx
    show Real.smoothTransition (2 * g x / a) = 0
    rw [h, mul_zero, zero_div]
    exact Real.smoothTransition.zero_of_nonpos le_rfl
  have hclχ : tsupport χ ⊆ cthickening (δ / 2) C :=
    (closure_mono hχsupp).trans (closure_thickening_subset_cthickening _ _)
  have htχ : tsupport χ ⊆ V :=
    hclχ.trans ((cthickening_mono (half_le_self hδ.le) C).trans hδV)
  -- Step 5: for `ω` admissible for `M_G`, `ω₁ = χω ∈ 𝒟ᵏ(U)`
  refine sSup_le ?_
  rintro r ⟨ω, hω, rfl⟩
  show ENNReal.ofReal (X ω) ≤ X.massOn V
  have hωt : IsTestForm (ω : DifferentialForm (Euclid P) k) := ω.property.1
  obtain ⟨ω₁f, hω₁f⟩ : ∃ g : DifferentialForm (Euclid P) k,
      g = fun x => χ x • (ω : DifferentialForm (Euclid P) k) x := ⟨_, rfl⟩
  have hω₁smooth : IsSmoothForm ω₁f := by
    rw [hω₁f]
    exact hχsmooth.smul hωt.1
  have hω₁supp : tsupport ω₁f ⊆ tsupport (ω : DifferentialForm (Euclid P) k) := by
    rw [hω₁f]
    exact tsupport_smul_subset_right _ _
  have hω₁suppχ : tsupport ω₁f ⊆ tsupport χ := by
    rw [hω₁f]
    exact tsupport_smul_subset_left _ _
  have hω₁cpt : HasCompactSupport ω₁f :=
    IsCompact.of_isClosed_subset hωt.2 (isClosed_tsupport _) hω₁supp
  let ω₁ : TestFormOn U k := ⟨ω₁f, ⟨hω₁smooth, hω₁cpt⟩, hω₁supp.trans ω.property.2⟩
  -- Step 6: `ω₂ = ω − ω₁` vanishes on `N ⊇ C`, so `spt ω₂ ∩ C = ∅` and `X(ω₂) = 0`
  have hω₂van : X (ω - ω₁) = 0 := by
    apply hvan
    rw [Set.disjoint_left]
    intro x hx hxC
    have hzero : ∀ y ∈ N, ((ω - ω₁ : TestFormOn U k) : DifferentialForm (Euclid P) k) y = 0 := by
      intro y hy
      have hco : ((ω - ω₁ : TestFormOn U k) : DifferentialForm (Euclid P) k) y =
          (ω : DifferentialForm (Euclid P) k) y - ω₁f y := rfl
      rw [hco, hω₁f]
      beta_reduce
      rw [hχN y hy, one_smul, sub_self]
    have hxN : x ∈ N := hCN hxC
    have hnot : x ∉ tsupport ((ω - ω₁ : TestFormOn U k) : DifferentialForm (Euclid P) k) := by
      rw [notMem_tsupport_iff_eventuallyEq]
      filter_upwards [hNo.mem_nhds hxN] with y hy
      exact hzero y hy
    exact hnot hx
  have hsplit : X ω = X ω₁ := by
    have : X (ω - ω₁) = X ω - X ω₁ := map_sub X.toCurrent ω ω₁
    linarith
  -- Step 5 (cont.): `spt ω₁ ⊆ spt χ ⊆ V` and `|ω₁(x)| = χ(x) |ω(x)| ≤ 1`
  have hadm : ω₁ ∈ massAdmissibleOn U k V := by
    refine ⟨hω₁suppχ.trans htχ, fun x => ?_⟩
    have hco : (ω₁ : DifferentialForm (Euclid P) k) x =
        χ x • (ω : DifferentialForm (Euclid P) k) x := by
      show ω₁f x = _
      rw [hω₁f]
    rw [hco, hsmul]
    have h0 : 0 ≤ χ x := Real.smoothTransition.nonneg _
    have h1 : χ x ≤ 1 := Real.smoothTransition.le_one _
    rw [abs_of_nonneg h0]
    have h2 := covectorEuclideanNorm_nonneg ((ω : DifferentialForm (Euclid P) k) x)
    have h3 := hω.2 x
    nlinarith
  -- Step 7: `ofReal X(ω) = ofReal X(ω₁) ≤ M_V(X)`; take the supremum over `ω`
  rw [hsplit]
  exact X.le_massOn hadm
/-- **Weak convergence of sublevel restrictions without concentration at the cut level**
(Simon 7.2.4, localization step).  Let `G = {g < s}` for a continuous `g`, and let `Tⱼ, T` and
their restrictions `T'ⱼ = Tⱼ⌞G`, `T' = T⌞G` act by `ω ↦ ∫ ⟨ω, ξⱼ⟩ dμⱼ` (resp. `∫_G`), with
`μⱼ(G), μ(G) < ∞` and `|⟨α, ξⱼ⟩|, |⟨α, ξ⟩| ≤ |α|` a.e.  If `Tⱼ ⇀ T` and, for every `ε > 0`,
`μⱼ{s − δ ≤ g ≤ s} ≤ ε` for some `δ > 0` and all large `j`, then `T'ⱼ ⇀ T'`.  Fix `ω` with
`|ω| ≤ c`; a smooth cutoff `χ` (`χ = 1` on `{g ≤ s − δ'}`, `χ = 0` on `{g ≥ s − δ'/2}`) gives a
test form `χω` with `|T'ⱼ(ω) − Tⱼ(χω)| ≤ c μⱼ{s − δ' < g < s}` and
`|T'(ω) − T(χω)| ≤ c μ{s − δ' < g < s}`; the latter layer shrinks by continuity from above, the
former by hypothesis, and `Tⱼ(χω) → T(χω)`. -/
theorem Submission.cmc_fcl_weakConverges_sublevel : ∀ (P d : ℕ) (U : Set (Euclid P)) (g : Euclid P → ℝ) (s : ℝ) (μs : ℕ → Measure (Euclid P)) (μ : Measure (Euclid P)) (ξs : ℕ → Euclid P → MultiVector P d) (ξ : Euclid P → MultiVector P d) (Ts Ts' : ℕ → GeometricCurrentOn U d) (T T' : GeometricCurrentOn U d), Continuous g → (∀ j, μs j {x | g x < s} < ∞) → μ {x | g x < s} < ∞ → (∀ j, AEStronglyMeasurable (ξs j) (μs j)) → AEStronglyMeasurable ξ μ → (∀ j, ∀ᵐ x ∂(μs j), ∀ α : Covector (Euclid P) d, |ξs j x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) d, |ξ x α| ≤ covectorEuclideanNorm α) → (∀ (j : ℕ) (ω : TestFormOn U d), Ts j ω = ∫ x, ξs j x ((ω : DifferentialForm (Euclid P) d) x) ∂(μs j)) → (∀ ω : TestFormOn U d, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) d) x) ∂μ) → (∀ (j : ℕ) (ω : TestFormOn U d), Ts' j ω = ∫ x in {x | g x < s}, ξs j x ((ω : DifferentialForm (Euclid P) d) x) ∂(μs j)) → (∀ ω : TestFormOn U d, T' ω = ∫ x in {x | g x < s}, ξ x ((ω : DifferentialForm (Euclid P) d) x) ∂μ) → WeaklyConvergesOn Ts T → (∀ ε : ℝ≥0∞, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ᶠ j in atTop, μs j {x | s - δ ≤ g x ∧ g x ≤ s} ≤ ε) → WeaklyConvergesOn Ts' T' := by
  intro P d U g s μs μ ξs ξ Ts Ts' T T' hg hμsG hμG hξsm hξm hξsb hξb hTs hT hTs' hT' hconv hconc
    ω
  obtain ⟨w, hwdef⟩ : ∃ w : DifferentialForm (Euclid P) d, w = (ω : DifferentialForm (Euclid P) d) :=
    ⟨_, rfl⟩
  have hwc : Continuous w := by rw [hwdef]; exact ω.property.1.1.continuous
  -- Step 1: a bound `c` for the coefficient norm of `ω`.
  have hnc : Continuous fun α : Covector (Euclid P) d => covectorEuclideanNorm α := by
    unfold covectorEuclideanNorm
    apply Continuous.sqrt
    apply continuous_finsetSum
    intro I _
    split_ifs
    · exact (continuous_eval_const _).pow 2
    · exact continuous_const
  obtain ⟨c, hc⟩ : ∃ c : ℝ, ∀ x, covectorEuclideanNorm (w x) ≤ c := by
    have hwcs : HasCompactSupport w := by
      rw [hwdef]
      exact ω.property.1.2
    have hcs : HasCompactSupport (covectorEuclideanNorm ∘ w) :=
      hwcs.comp_left (covectorEuclideanNorm_zero P d)
    obtain ⟨C, hC⟩ := hcs.exists_bound_of_continuous (hnc.comp hwc)
    exact ⟨C, fun x => le_trans (le_abs_self _) (by simpa [Real.norm_eq_abs] using hC x)⟩
  have hc0 : 0 ≤ c := le_trans (covectorEuclideanNorm_nonneg _) (hc 0)
  have hGm : MeasurableSet {x | g x < s} := measurableSet_lt hg.measurable measurable_const
  -- Step 2: the cutoff estimate, for an arbitrary measure.
  have key : ∀ (ν : Measure (Euclid P)) (ζ : Euclid P → MultiVector P d) (χ : Euclid P → ℝ) (r : ℝ),
      ν {x | g x < s} < ∞ → AEStronglyMeasurable ζ ν →
      (∀ᵐ x ∂ν, ∀ α : Covector (Euclid P) d, |ζ x α| ≤ covectorEuclideanNorm α) →
      Continuous χ → (∀ x, χ x ∈ Icc (0 : ℝ) 1) → (∀ x, g x ≤ r → χ x = 1) →
      (∀ x, s ≤ g x → χ x = 0) →
      |∫ x in {x | g x < s}, ζ x (w x) ∂ν - ∫ x, ζ x (χ x • w x) ∂ν| ≤
        c * ν.real {x | r < g x ∧ g x < s} := by
    intro ν ζ χ r hνG hζm hζb hχc hχ01 hχ1 hχ0
    have hF : AEStronglyMeasurable (fun x => ζ x (w x)) ν :=
      (continuous_fst.clm_apply continuous_snd).comp_aestronglyMeasurable
        (hζm.prodMk hwc.aestronglyMeasurable)
    have hFb : ∀ᵐ x ∂ν, |ζ x (w x)| ≤ c := hζb.mono fun x hx => (hx _).trans (hc x)
    have hint1 : IntegrableOn (fun x => ζ x (w x)) {x | g x < s} ν :=
      Measure.integrableOn_of_bounded hνG.ne hF
        (ae_restrict_of_ae (hFb.mono fun x hx => by rwa [Real.norm_eq_abs]))
    have hχF : ∀ x, |ζ x (w x)| ≤ c → |χ x * ζ x (w x)| ≤ c := by
      intro x hx
      rw [abs_mul]
      have h01 := hχ01 x
      calc |χ x| * |ζ x (w x)| ≤ 1 * c :=
            mul_le_mul (by rw [abs_of_nonneg h01.1]; exact h01.2) hx (abs_nonneg _) zero_le_one
        _ = c := one_mul c
    have hint2 : IntegrableOn (fun x => χ x * ζ x (w x)) {x | g x < s} ν :=
      Measure.integrableOn_of_bounded hνG.ne (hχc.aestronglyMeasurable.mul hF)
        (ae_restrict_of_ae (hFb.mono fun x hx => by rw [Real.norm_eq_abs]; exact hχF x hx))
    have hsmul : ∀ x, ζ x (χ x • w x) = χ x * ζ x (w x) := fun x => by
      rw [map_smul, smul_eq_mul]
    have h2 : ∫ x, ζ x (χ x • w x) ∂ν = ∫ x in {x | g x < s}, χ x * ζ x (w x) ∂ν := by
      simp_rw [hsmul]
      exact (setIntegral_eq_integral_of_forall_compl_eq_zero fun x hx => by
        have : s ≤ g x := not_lt.1 hx
        rw [hχ0 x this, zero_mul]).symm
    rw [h2, ← integral_sub hint1 hint2]
    have h3 : ∫ x in {x | g x < s}, (ζ x (w x) - χ x * ζ x (w x)) ∂ν =
        ∫ x in {x | r < g x ∧ g x < s}, (ζ x (w x) - χ x * ζ x (w x)) ∂ν := by
      apply setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hGm (fun x hx => hx.2)
      intro x hx
      have : g x ≤ r := by
        by_contra h
        exact hx.2 ⟨lt_of_not_ge h, hx.1⟩
      rw [hχ1 x this]
      ring
    rw [h3, ← Real.norm_eq_abs]
    apply norm_setIntegral_le_of_norm_le_const_ae
      (lt_of_le_of_lt (measure_mono fun x hx => hx.2) hνG)
    apply ae_restrict_of_ae
    filter_upwards [hFb] with x hx
    rw [Real.norm_eq_abs, show ζ x (w x) - χ x * ζ x (w x) = (1 - χ x) * ζ x (w x) by ring,
      abs_mul]
    have h01 := hχ01 x
    calc |1 - χ x| * |ζ x (w x)| ≤ 1 * c :=
          mul_le_mul (by rw [abs_of_nonneg (by linarith [h01.2])]; linarith [h01.1]) hx
            (abs_nonneg _) zero_le_one
      _ = c := one_mul c
  -- Step 3: the ε-argument.
  rw [Metric.tendsto_atTop]
  intro ε hε
  obtain ⟨η, hηdef⟩ : ∃ η : ℝ, η = ε / (3 * (c + 1)) := ⟨_, rfl⟩
  have hη : 0 < η := by rw [hηdef]; positivity
  obtain ⟨δ₁, hδ₁, hμδ₁⟩ :
      ∃ δ₁ : ℝ, 0 < δ₁ ∧ μ {x | s - δ₁ < g x ∧ g x < s} ≤ ENNReal.ofReal η := by
    let S : ℕ → Set (Euclid P) := fun i => {x | s - 1 / ((i : ℝ) + 1) < g x ∧ g x < s}
    have hSm : ∀ i, NullMeasurableSet (S i) μ := fun i =>
      ((measurableSet_lt measurable_const hg.measurable).inter hGm).nullMeasurableSet
    have hSanti : Antitone S := by
      intro i k hik x hx
      refine ⟨lt_of_le_of_lt ?_ hx.1, hx.2⟩
      have : (1 : ℝ) / ((k : ℝ) + 1) ≤ 1 / ((i : ℝ) + 1) :=
        one_div_le_one_div_of_le (by positivity) (by exact_mod_cast Nat.add_le_add_right hik 1)
      linarith
    have hSfin : ∃ i, μ (S i) ≠ ∞ :=
      ⟨0, (lt_of_le_of_lt (measure_mono fun x hx => hx.2) hμG).ne⟩
    have hinter : (⋂ i, S i) = ∅ := by
      ext x
      simp only [S, mem_iInter, mem_ofPred_eq, mem_empty_iff_false, iff_false, not_forall]
      by_cases hxs : g x < s
      · obtain ⟨i, hi⟩ := exists_nat_one_div_lt (sub_pos.2 hxs)
        exact ⟨i, fun h => by linarith [h.1]⟩
      · exact ⟨0, fun h => hxs h.2⟩
    have ht := tendsto_measure_iInter_atTop hSm hSanti hSfin
    rw [hinter, measure_empty] at ht
    have hev := (ENNReal.tendsto_nhds_zero.1 ht) (ENNReal.ofReal η) (ENNReal.ofReal_pos.2 hη)
    obtain ⟨i, hi⟩ := hev.exists
    exact ⟨1 / ((i : ℝ) + 1), by positivity, hi⟩
  obtain ⟨δ₂, hδ₂, hev₂⟩ := hconc (ENNReal.ofReal η) (ENNReal.ofReal_pos.2 hη)
  have hδ' : 0 < min δ₁ δ₂ := lt_min hδ₁ hδ₂
  obtain ⟨χ, hχs, hχ01, hχ1, hχ0'⟩ : ∃ χ : Euclid P → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) χ ∧
      (∀ x, χ x ∈ Icc (0 : ℝ) 1) ∧ (∀ x, g x ≤ s - min δ₁ δ₂ → χ x = 1) ∧
      (∀ x, s - min δ₁ δ₂ / 2 ≤ g x → χ x = 0) := by
    obtain ⟨f, hf1, hf0, hf01⟩ := exists_contMDiffMap_one_nhds_of_subset_interior
      (modelWithCornersSelf ℝ (Euclid P)) (n := ⊤) (s := {x | g x ≤ s - min δ₁ δ₂})
      (t := {x | g x < s - min δ₁ δ₂ / 2}) (isClosed_le hg continuous_const)
      (by
        rw [(isOpen_lt hg continuous_const).interior_eq]
        intro x (hx : g x ≤ s - min δ₁ δ₂)
        show g x < s - min δ₁ δ₂ / 2
        linarith)
    refine ⟨f, contMDiff_iff_contDiff.1 f.contMDiff, hf01, fun x hx => hf1.self_of_nhdsSet x hx,
      fun x hx => hf0 x (by simp only [mem_ofPred_eq, not_lt]; exact hx)⟩
  have hχ0 : ∀ x, s ≤ g x → χ x = 0 := fun x hx => hχ0' x (by linarith)
  have hws : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) w := by rw [hwdef]; exact ω.property.1.1
  have hwcs : HasCompactSupport w := by rw [hwdef]; exact ω.property.1.2
  have hwU : tsupport w ⊆ U := by rw [hwdef]; exact ω.property.2
  have hsupp : support (fun x => χ x • w x) ⊆ support w := by
    intro x hx h0
    apply hx
    simp only [h0, smul_zero]
  have h1 : IsSmoothForm (fun x => χ x • w x) := hχs.smul hws
  have h2 : HasCompactSupport (fun x => χ x • w x) :=
    hwcs.mono' (hsupp.trans (subset_tsupport w))
  have h3 : tsupport (fun x => χ x • w x) ⊆ U := (closure_mono hsupp).trans hwU
  have hmem : (fun x => χ x • w x) ∈ TestFormOn U d := ⟨⟨h1, h2⟩, h3⟩
  let χω : TestFormOn U d := ⟨fun x => χ x • w x, hmem⟩
  have hconvχ := hconv χω
  rw [Metric.tendsto_atTop] at hconvχ
  obtain ⟨N₁, hN₁⟩ := hconvχ η hη
  obtain ⟨N₂, hN₂⟩ := eventually_atTop.1 hev₂
  refine ⟨max N₁ N₂, fun j hj => ?_⟩
  have hj₁ : N₁ ≤ j := le_trans (le_max_left _ _) hj
  have hj₂ : N₂ ≤ j := le_trans (le_max_right _ _) hj
  have e1 := key (μs j) (ξs j) χ (s - min δ₁ δ₂) (hμsG j) (hξsm j) (hξsb j) hχs.continuous hχ01
    hχ1 hχ0
  have e2 := key μ ξ χ (s - min δ₁ δ₂) hμG hξm hξb hχs.continuous hχ01 hχ1 hχ0
  have hm1 : (μs j).real {x | s - min δ₁ δ₂ < g x ∧ g x < s} ≤ η := by
    have : μs j {x | s - min δ₁ δ₂ < g x ∧ g x < s} ≤ ENNReal.ofReal η :=
      le_trans (measure_mono (show {x | s - min δ₁ δ₂ < g x ∧ g x < s} ⊆
          {x | s - δ₂ ≤ g x ∧ g x ≤ s} from
          fun x hx => ⟨by linarith [hx.1, min_le_right δ₁ δ₂], hx.2.le⟩)) (hN₂ j hj₂)
    exact ENNReal.toReal_le_of_le_ofReal hη.le this
  have hm2 : μ.real {x | s - min δ₁ δ₂ < g x ∧ g x < s} ≤ η := by
    have : μ {x | s - min δ₁ δ₂ < g x ∧ g x < s} ≤ ENNReal.ofReal η :=
      le_trans (measure_mono (show {x | s - min δ₁ δ₂ < g x ∧ g x < s} ⊆
          {x | s - δ₁ < g x ∧ g x < s} from
          fun x hx => ⟨by linarith [hx.1, min_le_left δ₁ δ₂], hx.2⟩)) hμδ₁
    exact ENNReal.toReal_le_of_le_ofReal hη.le this
  have h3 : dist (Ts j χω) (T χω) < η := hN₁ j hj₁
  have hTsχ : Ts j χω = ∫ x, ξs j x (χ x • w x) ∂(μs j) := hTs j χω
  have hTχ : T χω = ∫ x, ξ x (χ x • w x) ∂μ := hT χω
  rw [Real.dist_eq, hTsχ, hTχ] at h3
  rw [Real.dist_eq, hTs' j ω, hT' ω, ← hwdef]
  have hc1 := mul_le_mul_of_nonneg_left hm1 hc0
  have hc2 := mul_le_mul_of_nonneg_left hm2 hc0
  have habs := abs_sub_le (∫ x in {x | g x < s}, ξs j x (w x) ∂(μs j))
    (∫ x, ξs j x (χ x • w x) ∂(μs j)) (∫ x in {x | g x < s}, ξ x (w x) ∂μ)
  have habs2 := abs_sub_le (∫ x, ξs j x (χ x • w x) ∂(μs j)) (∫ x, ξ x (χ x • w x) ∂μ)
    (∫ x in {x | g x < s}, ξ x (w x) ∂μ)
  rw [abs_sub_comm (∫ x, ξ x (χ x • w x) ∂μ)] at habs2
  have hfin : (2 * c + 1) * η < ε := by
    rw [hηdef]
    rw [mul_div_assoc', div_lt_iff₀ (by positivity)]
    nlinarith
  linarith
/-- **Lipschitz order statistic** (proof of Simon Ch. 6, Lemma 5.4, the retraction of the
deformation theorem): for `m + 1 < P` the `ℓ`-th largest entry
`κ u = max_{|I| = ℓ} min_{i ∈ I} u i`, `ℓ = P − (m + 1)`, of `u : Fin P → ℝ` is `≤` at least `ℓ`
entries of `u`, `≥` at least `m + 2` entries, and is `1`-Lipschitz for the sup norm.  A maximizing
`I` gives the first property; if at most `m + 1` entries were `≤ κ u`, then `ℓ` entries `> κ u`
would form an `I` with `min_I u > κ u`; and each `min_I` is `1`-Lipschitz for the sup norm, hence
so is their maximum. -/
theorem Submission.dor_lmb_fcdr_order_stat : ∀ (P m : ℕ), m + 1 < P → ∃ κ : (Fin P → ℝ) → ℝ, (∀ u : Fin P → ℝ, ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, κ u ≤ u i) ∧ (∀ u : Fin P → ℝ, ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, u i ≤ κ u) ∧ ∀ u v : Fin P → ℝ, ∀ t : ℝ, (∀ i, |u i - v i| ≤ t) → |κ u - κ v| ≤ t := by
  intro P m hmP
  classical
  -- `𝓕` = the `ℓ`-element index sets, `ℓ = P − (m + 1) ≥ 1`; `𝓕` and its members are nonempty
  let F : Finset (Finset (Fin P)) := Finset.powersetCard (P - (m + 1)) Finset.univ
  have hF : F.Nonempty := Finset.powersetCard_nonempty.2 (by rw [Finset.card_fin]; omega)
  have hFI : ∀ I ∈ F, I.Nonempty ∧ I.card = P - (m + 1) := fun I hI => by
    have hc := (Finset.mem_powersetCard.1 hI).2
    exact ⟨Finset.card_pos.1 (by omega), hc⟩
  -- `g u I = min_{i ∈ I} u i` (the empty set, not in `𝓕`, gets `0`); `κ u = max_{I ∈ 𝓕} g u I`
  let g : (Fin P → ℝ) → Finset (Fin P) → ℝ := fun u I => if h : I.Nonempty then I.inf' h u else 0
  have hg : ∀ u I (hI : I ∈ F), g u I = I.inf' (hFI I hI).1 u := fun u I hI =>
    dite_eq_left (hFI I hI).1
  refine ⟨fun u => F.sup' hF (g u), fun u => ?_, fun u => ?_, fun u v t huv => ?_⟩
  · -- (1): a maximizing `I` has `ℓ` indices with `κ u ≤ u i`
    obtain ⟨I, hI, hIu⟩ := Finset.exists_mem_eq_sup' hF (g u)
    refine ⟨I, by have := (hFI I hI).2; omega, fun i hi => ?_⟩
    show F.sup' hF (g u) ≤ u i
    rw [hIu, hg u I hI]
    exact Finset.inf'_le u hi
  · -- (2): otherwise `ℓ` entries `> κ u` would form `I ∈ 𝓕` with `g u I > κ u`
    refine ⟨Finset.univ.filter (fun i => u i ≤ F.sup' hF (g u)), ?_,
      fun i hi => (Finset.mem_filter.1 hi).2⟩
    by_contra hlt
    have hsum := Finset.card_filter_add_card_filter_not (s := Finset.univ)
      (fun i => u i ≤ F.sup' hF (g u))
    rw [Finset.card_fin] at hsum
    obtain ⟨I, hIB, hIc⟩ := Finset.exists_subset_card_eq
      (s := Finset.univ.filter (fun i => ¬ u i ≤ F.sup' hF (g u))) (n := P - (m + 1)) (by omega)
    have hI : I ∈ F := Finset.mem_powersetCard.2 ⟨Finset.subset_univ I, hIc⟩
    have h1 : g u I ≤ F.sup' hF (g u) := Finset.le_sup' (g u) hI
    have h2 : F.sup' hF (g u) < g u I := by
      rw [hg u I hI, Finset.lt_inf'_iff]
      exact fun i hi => lt_of_not_ge (Finset.mem_filter.1 (hIB hi)).2
    exact absurd h1 (not_le.2 h2)
  · -- (3): each `g · I`, hence `κ`, is `1`-Lipschitz for the sup norm
    have key : ∀ u v : Fin P → ℝ, (∀ i, |u i - v i| ≤ t) →
        F.sup' hF (g u) ≤ F.sup' hF (g v) + t := by
      intro u v huv
      refine Finset.sup'_le hF (g u) fun I hI => ?_
      obtain ⟨i₀, hi₀, hv⟩ := Finset.exists_mem_eq_inf' (hFI I hI).1 v
      have h1 : g u I ≤ u i₀ := by rw [hg u I hI]; exact Finset.inf'_le u hi₀
      have h2 : g v I = v i₀ := by rw [hg v I hI]; exact hv
      have h3 : g v I ≤ F.sup' hF (g v) := Finset.le_sup' (g v) hI
      have h4 := (abs_le.1 (huv i₀)).2
      linarith
    have hvu : ∀ i, |v i - u i| ≤ t := fun i => by rw [abs_sub_comm]; exact huv i
    show |F.sup' hF (g u) - F.sup' hF (g v)| ≤ t
    rw [abs_sub_le_iff]
    constructor <;> linarith [key u v huv, key v u hvu]
/-- **Distance to `L*(a)` from an integer translate** (Simon Ch. 6, 5.4, closed-form retraction,
Claim C).  Let `|aᵢ - 1/2| < 1/4` for all `i`, and let `κ(u) ≥ uᵢ` for at least `m + 2` indices `i`
(every `u`).  If `x - y ∈ ℤᴾ` then `dist(x, L*(a)) ≤ √(m + 2) κ(r(y))`, where
`r_j(y) = max((y_j - a_j)/(1 - a_j), (a_j - y_j)/a_j)` and `L*(a)` is the set of points with at least
`m + 2` coordinates in `aᵢ + ℤ`.  As `0 < a_j, 1 - a_j ≤ 1`, `|y_j - a_j| ≤ r_j(y)`.  On a set `J`
of `m + 2` indices with `r_i(y) ≤ κ(r(y))` put `x*_i = x_i - y_i + a_i` (`i ∈ J`), `x*_i = x_i`
(`i ∉ J`); then `x* ∈ L*(a)` and `|x - x*|² = Σ_{i ∈ J} (y_i - a_i)² ≤ (m + 2) κ(r(y))²`. -/
theorem Submission.dor_lmb_fcdr_dual_dist : ∀ (P m : ℕ) (a : Euclid P), (∀ i, |a i - 1 / 2| < 1 / 4) → ∀ κ : (Fin P → ℝ) → ℝ, (∀ u : Fin P → ℝ, ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, u i ≤ κ u) → ∀ x y : Euclid P, (∀ i, ∃ k : ℤ, x i - y i = k) → infDist x {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} ≤ Real.sqrt (m + 2) * κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)) := by
  intro P m a ha κ hκ x y hxy
  set u : Fin P → ℝ := fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j) with hu_def
  -- Steps 1–2: `1/4 < a_j < 3/4`, so `|y_j - a_j| ≤ r_j(y) = u j`
  have hbound : ∀ j, |y j - a j| ≤ u j := by
    intro j
    obtain ⟨h1l, h1r⟩ := abs_lt.mp (ha j)
    have ha0 : 0 < a j := by linarith
    have ha1 : 0 < 1 - a j := by linarith
    rcases le_total (a j) (y j) with h | h
    · rw [abs_of_nonneg (sub_nonneg.mpr h)]
      have hle : y j - a j ≤ (y j - a j) / (1 - a j) := by
        rw [le_div_iff₀ ha1]
        nlinarith
      exact hle.trans (le_max_left _ _)
    · rw [abs_sub_comm, abs_of_nonneg (sub_nonneg.mpr h)]
      have hle : a j - y j ≤ (a j - y j) / a j := by
        rw [le_div_iff₀ ha0]
        nlinarith
      exact hle.trans (le_max_right _ _)
  -- Step 3: a set `J` of exactly `m + 2` indices with `|y_i - a_i| ≤ u i ≤ κ u`, so `κ u ≥ 0`
  obtain ⟨s, hs_card, hs⟩ := hκ u
  obtain ⟨J, hJs, hJcard⟩ := Finset.exists_subset_card_eq hs_card
  choose k hk using hxy
  have hJbound : ∀ i ∈ J, |y i - a i| ≤ κ u := fun i hi =>
    (hbound i).trans (hs i (hJs hi))
  have hκ_nonneg : 0 ≤ κ u := by
    have hJne : J.Nonempty := by
      rw [← Finset.card_pos, hJcard]; omega
    obtain ⟨i, hi⟩ := hJne
    exact (abs_nonneg _).trans (hJbound i hi)
  -- Step 4: the shifted point `x*` lies in `L*(a)`
  let xs : Euclid P := WithLp.toLp 2 (fun i => if i ∈ J then x i - y i + a i else x i)
  have hxs_mem : xs ∈ {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧
      ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} := by
    refine ⟨J, hJcard.ge, fun i hi => ⟨k i, ?_⟩⟩
    show (if i ∈ J then x i - y i + a i else x i) - a i = k i
    rw [ite_eq_left hi, ← hk i]
    ring
  -- Step 5: `dist(x, L*(a)) ≤ |x - x*| = (Σ_{i ∈ J} (y_i - a_i)²)^{1/2} ≤ √(m + 2) κ u`
  refine (infDist_le_dist_of_mem hxs_mem).trans ?_
  rw [EuclideanSpace.dist_eq]
  have hsum : ∑ i, dist (x i) (xs i) ^ 2 ≤ ((m : ℝ) + 2) * (κ u) ^ 2 := by
    have h1 : ∑ i, dist (x i) (xs i) ^ 2 = ∑ i ∈ J, dist (x i) (xs i) ^ 2 := by
      symm
      apply Finset.sum_subset (Finset.subset_univ J)
      intro i _ hi
      show dist (x i) (if i ∈ J then x i - y i + a i else x i) ^ 2 = 0
      rw [ite_eq_right hi, dist_self]
      ring
    rw [h1]
    have h2 : ∑ i ∈ J, dist (x i) (xs i) ^ 2 ≤ J.card • (κ u ^ 2) := by
      apply Finset.sum_le_card_nsmul
      intro i hi
      show dist (x i) (if i ∈ J then x i - y i + a i else x i) ^ 2 ≤ κ u ^ 2
      rw [ite_eq_left hi, Real.dist_eq]
      have hxy' : x i - (x i - y i + a i) = y i - a i := by ring
      rw [hxy']
      exact pow_le_pow_left₀ (abs_nonneg _) (hJbound i hi) 2
    rw [hJcard, nsmul_eq_mul] at h2
    push_cast at h2
    exact h2
  calc Real.sqrt (∑ i, dist (x i) (xs i) ^ 2)
      ≤ Real.sqrt (((m : ℝ) + 2) * (κ u) ^ 2) := Real.sqrt_le_sqrt hsum
    _ = Real.sqrt ((m : ℝ) + 2) * κ u := by
      rw [Real.sqrt_mul (by positivity), Real.sqrt_sq hκ_nonneg]
/-- **Simon Ch. 6, Lemma 5.4** (step 4(i) of the closed-form retraction): with
`r_j(y) = max((y_j − a_j)/(1 − a_j), (a_j − y_j)/a_j)` and `κ(r(y)) > 0`, the point
`Φ(y)_i = a_i + (y_i − a_i)/max(r_i(y), κ(r(y)))` lies in the cube `[0, 1]ᴾ`, and `Φ(y)_i ∈ {0, 1}`
on an index set `s` with `P ≤ m + 1 + |s|`.  As `1/4 < a_i < 3/4`, `μ_i = max(r_i(y), κ(r(y)))` is
positive and dominates `(y_i − a_i)/(1 − a_i)` and `(a_i − y_i)/a_i`, so
`−a_i ≤ (y_i − a_i)/μ_i ≤ 1 − a_i`.  On the indices with `κ(r(y)) ≤ r_i(y)` given by the hypothesis
on `κ`, `μ_i = r_i(y)` and the quotient is exactly `1 − a_i` (`y_i ≥ a_i`) or `−a_i` (`y_i < a_i`). -/
theorem Submission.dor_lmb_fcdr_cube_skeleton : ∀ (P m : ℕ) (a : Euclid P), (∀ i, |a i - 1 / 2| < 1 / 4) → ∀ κ : (Fin P → ℝ) → ℝ, (∀ u : Fin P → ℝ, ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, κ u ≤ u i) → ∀ Φ : Euclid P → Euclid P, (∀ (y : Euclid P) (i : Fin P), Φ y i = a i + (y i - a i) / max (max ((y i - a i) / (1 - a i)) ((a i - y i) / a i)) (κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)))) → ∀ y : Euclid P, 0 < κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)) → (∀ i, 0 ≤ Φ y i ∧ Φ y i ≤ 1) ∧ ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, Φ y i = 0 ∨ Φ y i = 1 := by
  intro P m a ha κ hκ Φ hΦ y hy
  -- `|a_i − 1/2| < 1/4` gives `0 < a_i < 1`
  have ha' : ∀ i, 0 < a i ∧ a i < 1 := fun i => by
    obtain ⟨h1, h2⟩ := abs_lt.mp (ha i)
    constructor <;> linarith
  -- if `μ > 0` dominates `(z − b)/(1 − b)` and `(b − z)/b`, then `0 ≤ b + (z − b)/μ ≤ 1`
  have bounds : ∀ b z μ : ℝ, 0 < b → b < 1 → 0 < μ → (z - b) / (1 - b) ≤ μ → (b - z) / b ≤ μ →
      0 ≤ b + (z - b) / μ ∧ b + (z - b) / μ ≤ 1 := by
    intro b z μ hb0 hb1 hμ h1 h2
    rw [div_le_iff₀ (by linarith)] at h1
    rw [div_le_iff₀ hb0] at h2
    constructor
    · have : -b ≤ (z - b) / μ := by
        rw [le_div_iff₀ hμ]
        linarith
      linarith
    · have : (z - b) / μ ≤ 1 - b := by
        rw [div_le_iff₀ hμ]
        linarith
      linarith
  -- if moreover `0 < k ≤ r = max((z − b)/(1 − b), (b − z)/b)`, then `max(r, k) = r` and the
  -- coordinate is `b + (1 − b) = 1` (`z ≥ b`) or `b − b = 0` (`z < b`)
  have skel : ∀ b z k : ℝ, 0 < b → b < 1 → 0 < k → k ≤ max ((z - b) / (1 - b)) ((b - z) / b) →
      b + (z - b) / max (max ((z - b) / (1 - b)) ((b - z) / b)) k = 0 ∨
        b + (z - b) / max (max ((z - b) / (1 - b)) ((b - z) / b)) k = 1 := by
    intro b z k hb0 hb1 hk hkr
    have h1b : 0 < 1 - b := by linarith
    rw [max_eq_left hkr]
    rcases le_or_gt b z with h | h
    · right
      have e1 : (b - z) / b ≤ 0 := div_nonpos_of_nonpos_of_nonneg (by linarith) hb0.le
      have e2 : 0 ≤ (z - b) / (1 - b) := div_nonneg (by linarith) h1b.le
      rw [max_eq_left (e1.trans e2)] at hkr ⊢
      have hzb : z - b ≠ 0 := by
        intro h0
        rw [h0, zero_div] at hkr
        linarith
      rw [div_div_cancel₀ hzb]
      ring
    · left
      have e1 : (z - b) / (1 - b) ≤ 0 := div_nonpos_of_nonpos_of_nonneg (by linarith) h1b.le
      have e2 : 0 ≤ (b - z) / b := div_nonneg (by linarith) hb0.le
      rw [max_eq_right (e1.trans e2), ← neg_sub b z, neg_div, div_div_cancel₀ (sub_pos.mpr h).ne']
      ring
  -- `μ_i = max(r_i(y), κ(r(y))) ≥ κ(r(y)) > 0` dominates both quotients in `r_i(y)`
  refine ⟨fun i => ?_, ?_⟩
  · rw [hΦ y i]
    exact bounds (a i) (y i) _ (ha' i).1 (ha' i).2 (hy.trans_le (le_max_right _ _))
      ((le_max_left _ _).trans (le_max_left _ _)) ((le_max_right _ _).trans (le_max_left _ _))
  · -- the indices with `κ(r(y)) ≤ r_i(y)` land on a face: `Φ(y)_i ∈ {0, 1}`
    obtain ⟨s, hs, hsκ⟩ := hκ fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)
    refine ⟨s, hs, fun i hi => ?_⟩
    rw [hΦ y i]
    exact skel (a i) (y i) _ (ha' i).1 (ha' i).2 hy (hsκ i hi)
/-- **Simon Ch. 6, Lemma 5.4** (retraction onto the `n`-skeleton), integer-translation
compatibility of the cube map `Φ(y)ᵢ = aᵢ + (yᵢ − aᵢ)/max(rᵢ(y), κ(r(y)))`, where
`rⱼ(y) = max((yⱼ − aⱼ)/(1 − aⱼ), (aⱼ − yⱼ)/aⱼ)`: if `y, y' ∈ [0, 1]ᴾ` and `y' − y ∈ ℤᴾ`, then
`Φ(y') = Φ(y) + (y' − y)`.  Each coordinate has `y'ⱼ = yⱼ` or `{yⱼ, y'ⱼ} = {0, 1}`, where
`rⱼ = 1`; so `r(y') = r(y)`, `κ(r(y)) ≤ rᵢ₀(y) ≤ 1` for some `i₀` (as `m + 1 < P`), and `Φ` is the
identity on the moved coordinates. -/
theorem Submission.dor_lmb_fcdr_cube_periodic : ∀ (P m : ℕ), m + 1 < P → ∀ a : Euclid P, (∀ i, |a i - 1 / 2| < 1 / 4) → ∀ κ : (Fin P → ℝ) → ℝ, (∀ u : Fin P → ℝ, ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, κ u ≤ u i) → ∀ Φ : Euclid P → Euclid P, (∀ (y : Euclid P) (i : Fin P), Φ y i = a i + (y i - a i) / max (max ((y i - a i) / (1 - a i)) ((a i - y i) / a i)) (κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)))) → ∀ y y' : Euclid P, (∀ i, 0 ≤ y i ∧ y i ≤ 1) → (∀ i, 0 ≤ y' i ∧ y' i ≤ 1) → (∀ i, ∃ k : ℤ, y' i - y i = k) → ∀ i, Φ y' i = Φ y i + (y' i - y i) := by
  intro P m hmP a ha κ hκ Φ hΦ y y' hy hy' hint i
  -- `0 < aⱼ < 1`
  have ha0 : ∀ j, 0 < a j := fun j => by linarith [(abs_lt.mp (ha j)).1]
  have ha1 : ∀ j, 0 < 1 - a j := fun j => by linarith [(abs_lt.mp (ha j)).2]
  -- `ρⱼ(t) = max((t − aⱼ)/(1 − aⱼ), (aⱼ − t)/aⱼ)` has `ρⱼ(0) = ρⱼ(1) = 1` and `ρⱼ ≤ 1` on `[0, 1]`
  have hρ0 : ∀ j, max ((0 - a j) / (1 - a j)) ((a j - 0) / a j) = 1 := fun j => by
    rw [sub_zero, div_self (ha0 j).ne']
    exact max_eq_right ((div_le_one (ha1 j)).mpr (by linarith))
  have hρ1 : ∀ j, max ((1 - a j) / (1 - a j)) ((a j - 1) / a j) = 1 := fun j => by
    rw [div_self (ha1 j).ne']
    exact max_eq_left ((div_le_one (ha0 j)).mpr (by linarith))
  have hρle : ∀ j, max ((y j - a j) / (1 - a j)) ((a j - y j) / a j) ≤ 1 := fun j =>
    max_le ((div_le_one (ha1 j)).mpr (by linarith [(hy j).2]))
      ((div_le_one (ha0 j)).mpr (by linarith [(hy j).1]))
  -- `y'ⱼ − yⱼ ∈ ℤ ∩ [−1, 1]`, so `y'ⱼ = yⱼ` or `{yⱼ, y'ⱼ} = {0, 1}`
  have hcase : ∀ j, y' j = y j ∨ (y j = 0 ∧ y' j = 1) ∨ (y j = 1 ∧ y' j = 0) := by
    intro j
    obtain ⟨k, hk⟩ := hint j
    obtain ⟨h₀, h₁⟩ := hy j
    obtain ⟨h₀', h₁'⟩ := hy' j
    have hk1 : k ≤ 1 := by
      have : (k : ℝ) ≤ 1 := by linarith
      exact_mod_cast this
    have hk2 : -1 ≤ k := by
      have : (-1 : ℝ) ≤ k := by linarith
      exact_mod_cast this
    rcases (show k = -1 ∨ k = 0 ∨ k = 1 by omega) with rfl | rfl | rfl <;> push_cast at hk
    · exact Or.inr (Or.inr ⟨by linarith, by linarith⟩)
    · exact Or.inl (by linarith)
    · exact Or.inr (Or.inl ⟨by linarith, by linarith⟩)
  -- hence `r(y') = r(y)` and `κ(r(y')) = κ(r(y))`
  have hr : ∀ j, max ((y' j - a j) / (1 - a j)) ((a j - y' j) / a j)
      = max ((y j - a j) / (1 - a j)) ((a j - y j) / a j) := by
    intro j
    rcases hcase j with h | ⟨h0, h1⟩ | ⟨h0, h1⟩
    · rw [h]
    · rw [h0, h1, hρ0 j, hρ1 j]
    · rw [h0, h1, hρ0 j, hρ1 j]
  have hκeq : κ (fun j => max ((y' j - a j) / (1 - a j)) ((a j - y' j) / a j))
      = κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)) :=
    congrArg κ (funext hr)
  -- `κ(r(y)) ≤ 1`: `s` is nonempty as `P ≤ m + 1 + |s|` and `m + 1 < P`
  have hκle : κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)) ≤ 1 := by
    obtain ⟨s, hs, hsκ⟩ := hκ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j))
    have hne : s.Nonempty := Finset.card_pos.mp (by omega)
    obtain ⟨i₀, hi₀⟩ := hne
    exact (hsκ i₀ hi₀).trans (hρle i₀)
  -- coordinates with `y'ᵢ = yᵢ` agree; on `{yᵢ, y'ᵢ} = {0, 1}`, `max(rᵢ, κ) = 1` and `Φ` fixes `yᵢ`
  rw [hΦ y' i, hΦ y i, hκeq, hr i]
  rcases hcase i with h | ⟨h0, h1⟩ | ⟨h0, h1⟩
  · rw [h]
    ring
  · rw [h0, h1, hρ0 i, max_eq_left hκle]
    ring
  · rw [h0, h1, hρ1 i, max_eq_left hκle]
    ring
/-- **Claim B** (Simon Ch. 6, Lemma 5.4, step 6 of the corrected closed-form proof: Lipschitz bound
for the cube retraction `Φ`).  Let `|aᵢ − 1/2| < 1/4`, let `κ` be `1`-Lipschitz for the sup norm,
`rⱼ(y) = max((yⱼ − aⱼ)/(1 − aⱼ), (aⱼ − yⱼ)/aⱼ)` and `Φ(y)ᵢ = aᵢ + (yᵢ − aᵢ)/max(rᵢ(y), κ(r(y)))`.
If `κ(r(y)) > 0` then `|Φ(y) − Φ(y')| ≤ 4√P |y − y'| / κ(r(y))`: each `rⱼ` is `4`-Lipschitz, so the
denominators `μ = max(rᵢ(y), κ(r(y)))` and `μ'` differ by at most `4|y − y'|`; `|y'ᵢ − aᵢ| ≤ (3/4)μ'`,
and `u/μ − u'/μ' = (u − u')/μ + (u'/μ')(μ' − μ)/μ` bounds each coordinate by
`4|y − y'|/κ(r(y))`. -/
theorem Submission.dor_lmb_fcdr_cube_lipschitz : ∀ (P : ℕ) (a : Euclid P), (∀ i, |a i - 1 / 2| < 1 / 4) → ∀ κ : (Fin P → ℝ) → ℝ, (∀ u v : Fin P → ℝ, ∀ t : ℝ, (∀ i, |u i - v i| ≤ t) → |κ u - κ v| ≤ t) → ∀ Φ : Euclid P → Euclid P, (∀ (y : Euclid P) (i : Fin P), Φ y i = a i + (y i - a i) / max (max ((y i - a i) / (1 - a i)) ((a i - y i) / a i)) (κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)))) → ∀ y y' : Euclid P, 0 < κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)) → dist (Φ y) (Φ y') ≤ 4 * Real.sqrt P / κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)) * dist y y' := by
  intro P a ha κ hκ Φ hΦ y y' hk
  -- Step 1: `1/4 < aᵢ < 3/4`, and `|yⱼ − y'ⱼ| ≤ dist y y'`
  have a_bounds : ∀ c : ℝ, |c - 1 / 2| < 1 / 4 → 1 / 4 < c ∧ c < 3 / 4 := fun c hc => by
    rcases abs_lt.mp hc with ⟨h1, h2⟩
    constructor <;> linarith
  have hcoord : ∀ j, |y j - y' j| ≤ dist y y' := fun j => by
    have := PiLp.dist_apply_le y y' j
    rwa [Real.dist_eq] at this
  -- Step 2: `rⱼ` is `4`-Lipschitz in `yⱼ`, so `|κ(r(y)) − κ(r(y'))| ≤ 4 dist y y'`
  have div_lip : ∀ s x x' δ : ℝ, 1 / 4 < s → |x - x'| ≤ δ → |x / s - x' / s| ≤ 4 * δ := by
    intro s x x' δ hs h
    have hs0 : (0 : ℝ) < s := by linarith
    have hδ : 0 ≤ δ := le_trans (abs_nonneg _) h
    rw [← sub_div, abs_div, abs_of_pos hs0, div_le_iff₀ hs0]
    nlinarith [mul_nonneg hδ (by linarith : (0 : ℝ) ≤ 4 * s - 1)]
  have r_lip : ∀ c b b' δ : ℝ, |c - 1 / 2| < 1 / 4 → |b - b'| ≤ δ →
      |max ((b - c) / (1 - c)) ((c - b) / c) - max ((b' - c) / (1 - c)) ((c - b') / c)|
        ≤ 4 * δ := by
    intro c b b' δ hc h
    obtain ⟨hc1, hc2⟩ := a_bounds c hc
    refine le_trans (abs_max_sub_max_le_max _ _ _ _) (max_le ?_ ?_)
    · apply div_lip _ _ _ _ (by linarith)
      rwa [sub_sub_sub_cancel_right]
    · apply div_lip _ _ _ _ hc1
      rw [sub_sub_sub_cancel_left, abs_sub_comm]
      exact h
  have hkk : |κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j))
      - κ (fun j => max ((y' j - a j) / (1 - a j)) ((a j - y' j) / a j))| ≤ 4 * dist y y' :=
    hκ _ _ _ (fun j => r_lip _ _ _ _ (ha j) (hcoord j))
  -- Step 3: `|b − c| ≤ (3/4) r(b)`; in particular `r(b) ≥ 0`, and `r(b) = 0` forces `b = c`
  have abs_le_r : ∀ c b : ℝ, |c - 1 / 2| < 1 / 4 →
      |b - c| ≤ 3 / 4 * max ((b - c) / (1 - c)) ((c - b) / c) := by
    intro c b hc
    obtain ⟨hc1, hc2⟩ := a_bounds c hc
    have h1c : (0 : ℝ) < 1 - c := by linarith
    have hc0 : (0 : ℝ) < c := by linarith
    rcases le_total c b with h | h
    · rw [abs_of_nonneg (sub_nonneg.mpr h)]
      have hq : 0 ≤ (b - c) / (1 - c) := div_nonneg (sub_nonneg.mpr h) h1c.le
      have he : (b - c) / (1 - c) * (1 - c) = b - c := div_mul_cancel₀ _ h1c.ne'
      have hm := le_max_left ((b - c) / (1 - c)) ((c - b) / c)
      nlinarith [mul_nonneg hq (by linarith : (0 : ℝ) ≤ c - 1 / 4)]
    · rw [abs_of_nonpos (sub_nonpos.mpr h)]
      have hq : 0 ≤ (c - b) / c := div_nonneg (sub_nonneg.mpr h) hc0.le
      have he : (c - b) / c * c = c - b := div_mul_cancel₀ _ hc0.ne'
      have hm := le_max_right ((b - c) / (1 - c)) ((c - b) / c)
      nlinarith [mul_nonneg hq (by linarith : (0 : ℝ) ≤ 3 / 4 - c)]
  -- Step 4: `|u/μ − u'/μ'| ≤ 4δ/μ`
  have key : ∀ u u' μ μ' δ : ℝ, 0 < μ → 0 ≤ μ' → |u'| ≤ 3 / 4 * μ' → |u - u'| ≤ δ →
      |μ - μ'| ≤ 4 * δ → |u / μ - u' / μ'| ≤ 4 * δ / μ := by
    intro u u' μ μ' δ hμ hμ'0 hu' huu hμμ
    have hX : u / μ * μ = u := div_mul_cancel₀ u hμ.ne'
    have hX' : u' / μ' * μ' = u' ∧ |u' / μ'| ≤ 3 / 4 := by
      rcases hμ'0.eq_or_lt with h | h
      · -- (b) `μ' = 0` forces `u' = 0`
        subst h
        have hu0 : u' = 0 := abs_nonpos_iff.mp (by linarith)
        subst hu0
        norm_num
      · -- (a) `μ' > 0` gives `|u'|/μ' ≤ 3/4`
        refine ⟨div_mul_cancel₀ u' h.ne', ?_⟩
        rw [abs_div, abs_of_pos h, div_le_iff₀ h]
        exact hu'
    rw [le_div_iff₀ hμ]
    have hsplit : (u / μ - u' / μ') * μ = (u - u') - u' / μ' * (μ - μ') := by
      linear_combination hX - hX'.1
    have habs : |u / μ - u' / μ'| * μ = |(u / μ - u' / μ') * μ| := by
      rw [abs_mul, abs_of_pos hμ]
    rw [habs, hsplit]
    have h1 : |u' / μ' * (μ - μ')| ≤ 3 / 4 * (4 * δ) := by
      rw [abs_mul]
      exact mul_le_mul hX'.2 hμμ (abs_nonneg _) (by norm_num)
    have h2 := abs_le.mp h1
    have h3 := abs_le.mp huu
    rw [abs_le]
    constructor <;> linarith [h2.1, h2.2, h3.1, h3.2]
  -- Steps 3–5 for one coordinate: `|Φ(y)ᵢ − Φ(y')ᵢ| ≤ 4δ/κ(r(y))`
  have coord_bound : ∀ c b b' k k' δ : ℝ, |c - 1 / 2| < 1 / 4 → 0 < k → |b - b'| ≤ δ →
      |k - k'| ≤ 4 * δ →
      |(c + (b - c) / max (max ((b - c) / (1 - c)) ((c - b) / c)) k) -
        (c + (b' - c) / max (max ((b' - c) / (1 - c)) ((c - b') / c)) k')| ≤ 4 * δ / k := by
    intro c b b' k k' δ hc hk hbb hkk
    have hδ : 0 ≤ δ := le_trans (abs_nonneg _) hbb
    have hr' : |b' - c| ≤ 3 / 4 * max ((b' - c) / (1 - c)) ((c - b') / c) := abs_le_r c b' hc
    have hr'0 : 0 ≤ max ((b' - c) / (1 - c)) ((c - b') / c) := by
      have := abs_nonneg (b' - c)
      linarith
    have hμk : k ≤ max (max ((b - c) / (1 - c)) ((c - b) / c)) k := le_max_right _ _
    have hμ : 0 < max (max ((b - c) / (1 - c)) ((c - b) / c)) k := lt_of_lt_of_le hk hμk
    have hμ' : max ((b' - c) / (1 - c)) ((c - b') / c)
        ≤ max (max ((b' - c) / (1 - c)) ((c - b') / c)) k' := le_max_left _ _
    have huu : |(b - c) - (b' - c)| ≤ δ := by
      rw [sub_sub_sub_cancel_right]
      exact hbb
    have hμμ : |max (max ((b - c) / (1 - c)) ((c - b) / c)) k
        - max (max ((b' - c) / (1 - c)) ((c - b') / c)) k'| ≤ 4 * δ :=
      le_trans (abs_max_sub_max_le_max _ _ _ _) (max_le (r_lip c b b' δ hc hbb) hkk)
    have hu' : |b' - c| ≤ 3 / 4 * max (max ((b' - c) / (1 - c)) ((c - b') / c)) k' := by
      linarith
    rw [add_sub_add_left_eq_sub]
    exact le_trans (key _ _ _ _ _ hμ (le_trans hr'0 hμ') hu' huu hμμ)
      (div_le_div_of_nonneg_left (by linarith) hk hμk)
  have hi : ∀ i, |Φ y i - Φ y' i|
      ≤ 4 * dist y y' / κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)) := by
    intro i
    rw [hΦ y i, hΦ y' i]
    exact coord_bound _ _ _ _ _ _ (ha i) hk (hcoord i) hkk
  -- Step 5: sum the squares over the `P` coordinates
  rw [EuclideanSpace.dist_eq]
  calc Real.sqrt (∑ i, dist (Φ y i) (Φ y' i) ^ 2)
      ≤ Real.sqrt (∑ _i : Fin P,
          (4 * dist y y' / κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j))) ^ 2) := by
        apply Real.sqrt_le_sqrt
        apply Finset.sum_le_sum
        intro i _
        rw [Real.dist_eq]
        exact pow_le_pow_left₀ (abs_nonneg _) (hi i) 2
    _ = 4 * Real.sqrt P / κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j))
          * dist y y' := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
          Real.sqrt_mul (Nat.cast_nonneg _),
          Real.sqrt_sq (div_nonneg (by positivity) hk.le)]
        ring
/-- **Lipschitz on every closed unit grid cube implies Lipschitz along segments** (Simon Ch. 6,
5.4, closed-form retraction, step 7(i)).  If `|f x − f y| ≤ K |x − y|` whenever `x, y ∈ S` lie in
a common closed cube `z + [0, 1]ᴾ` (`z ∈ ℤᴾ`), then `|f x − f y| ≤ K |x − y|` whenever
`[x, y] ⊆ S`.  With `γ(t) = x + t (y − x)`, the parameters `t ∈ [0, 1]` at which a non-constant
coordinate `γᵢ(t)` is an integer, together with `0` and `1`, are finitely many,
`0 = t₀ < ⋯ < t_N = 1`.  Between consecutive breakpoints no coordinate crosses an integer, so
`γ(t_k)` and `γ(t_{k+1})` lie in the cube `⌊γ(s)⌋ + [0, 1]ᴾ`, `s = (t_k + t_{k+1})/2`; the cube
estimates `K (t_{k+1} − t_k) |x − y|` telescope along the triangle inequality to `K |x − y|`. -/
theorem Submission.dor_lmb_fcdr_grid_segment : ∀ (P : ℕ) (f : Euclid P → Euclid P) (S : Set (Euclid P)) (K : ℝ), 0 ≤ K → (∀ (z : Fin P → ℤ) (x y : Euclid P), x ∈ S → y ∈ S → (∀ i, (z i : ℝ) ≤ x i ∧ x i ≤ z i + 1) → (∀ i, (z i : ℝ) ≤ y i ∧ y i ≤ z i + 1) → dist (f x) (f y) ≤ K * dist x y) → ∀ x y : Euclid P, segment ℝ x y ⊆ S → dist (f x) (f y) ≤ K * dist x y := by
  intro P f S K hK hcube x y hseg
  -- Step 1: `γ t = x + t (y − x)`, `t ∈ [0, 1]`, parametrises `[x, y] ⊆ S`, and
  -- `|γ a − γ b| = |a − b| |x − y|`
  let γ : ℝ → Euclid P := fun t => x + t • (y - x)
  have hγi : ∀ t i, γ t i = x i + t * (y i - x i) := fun t i => by simp [γ]
  have hγS : ∀ t, 0 ≤ t → t ≤ 1 → γ t ∈ S := fun t h0 h1 =>
    hseg (by rw [segment_eq_image']; exact ⟨t, ⟨h0, h1⟩, rfl⟩)
  have hγdist : ∀ a b, dist (γ a) (γ b) = |a - b| * dist x y := by
    intro a b
    have h : γ a - γ b = (a - b) • (y - x) := by
      simp only [γ]; rw [add_sub_add_left_eq_sub, sub_smul]
    rw [dist_eq_norm (γ a) (γ b), h, norm_smul, Real.norm_eq_abs, ← dist_eq_norm y x,
      dist_comm y x]
  have hγ0 : γ 0 = x := by simp [γ]
  have hγ1 : γ 1 = y := by simp [γ]
  -- Step 2: the breakpoints `T ⊆ [0, 1]`: `0`, `1` and every `t` with `γᵢ(t) = m ∈ ℤ`,
  -- `xᵢ ≠ yᵢ`, i.e. `t = (m − xᵢ)/(yᵢ − xᵢ)` with `m ∈ [⌊min(xᵢ, yᵢ)⌋, ⌈max(xᵢ, yᵢ)⌉]` (for
  -- `xᵢ = yᵢ` this quotient is `0 ∈ T`) ...
  let B : Finset ℝ := Finset.univ.biUnion fun i : Fin P =>
    (Finset.Icc ⌊min (x i) (y i)⌋ ⌈max (x i) (y i)⌉).image fun m : ℤ =>
      ((m : ℝ) - x i) / (y i - x i)
  let T : Finset ℝ := (insert 0 (insert 1 B)).filter fun t => 0 ≤ t ∧ t ≤ 1
  have hmemT : ∀ u, u ∈ T ↔ (u = 0 ∨ u = 1 ∨ u ∈ B) ∧ 0 ≤ u ∧ u ≤ 1 := fun u =>
    Finset.mem_filter.trans <|
      and_congr_left' (Finset.mem_insert.trans (or_congr_right Finset.mem_insert))
  have hmemB : ∀ (i : Fin P) (m : ℤ), min (x i) (y i) < m → (m : ℝ) < max (x i) (y i) →
      ((m : ℝ) - x i) / (y i - x i) ∈ B := fun i m h1 h2 =>
    Finset.mem_biUnion.2 ⟨i, Finset.mem_univ i, Finset.mem_image.2 ⟨m,
      Finset.mem_Icc.2 ⟨Int.floor_le_iff.2 (by linarith), Int.le_ceil_iff.2 (by linarith)⟩, rfl⟩⟩
  have hT : ∀ u ∈ T, 0 ≤ u ∧ u ≤ 1 := fun u hu => ((hmemT u).1 hu).2
  have h0T : (0 : ℝ) ∈ T := (hmemT 0).2 ⟨Or.inl rfl, le_rfl, zero_le_one⟩
  have h1T : (1 : ℝ) ∈ T := (hmemT 1).2 ⟨Or.inr (Or.inl rfl), zero_le_one, le_rfl⟩
  -- ... listed increasingly as `0 = t 0 < t 1 < ⋯ < t N = 1`, `N = card T − 1`
  have hcard : 2 ≤ T.card := by
    have h := Finset.card_le_card (show ({0, 1} : Finset ℝ) ⊆ T by
      intro u hu
      rcases Finset.mem_insert.1 hu with rfl | hu
      · exact h0T
      · rw [Finset.mem_singleton.1 hu]; exact h1T)
    rwa [Finset.card_pair zero_ne_one] at h
  let e := T.orderEmbOfFin rfl
  let t : ℕ → ℝ := fun k => if h : k < T.card then e ⟨k, h⟩ else 1
  let N := T.card - 1
  have h0 : 0 < T.card := lt_of_lt_of_le two_pos hcard
  have hNlt : N < T.card := Nat.sub_lt h0 one_pos
  have ht0 : t 0 = 0 := by
    have : t 0 = e ⟨0, h0⟩ := dite_eq_left h0
    rw [this, Finset.orderEmbOfFin_zero rfl h0]
    exact le_antisymm (Finset.min'_le T 0 h0T) (Finset.le_min' T _ 0 fun u hu => (hT u hu).1)
  have htN : t N = 1 := by
    have : t N = e ⟨T.card - 1, hNlt⟩ := dite_eq_left hNlt
    rw [this, Finset.orderEmbOfFin_last rfl h0]
    exact le_antisymm (Finset.max'_le T _ 1 fun u hu => (hT u hu).2) (Finset.le_max' T 1 h1T)
  -- `t k < t (k + 1)` are consecutive breakpoints
  have hstep : ∀ k < N, t k ∈ T ∧ t (k + 1) ∈ T ∧ t k < t (k + 1) ∧
      ∀ u ∈ T, ¬(t k < u ∧ u < t (k + 1)) := by
    intro k hk
    have hk1 : k < T.card := hk.trans hNlt
    have hk2 : k + 1 < T.card := Nat.add_lt_of_lt_sub hk
    have htk : t k = e ⟨k, hk1⟩ := dite_eq_left hk1
    have htk' : t (k + 1) = e ⟨k + 1, hk2⟩ := dite_eq_left hk2
    rw [htk, htk']
    refine ⟨T.orderEmbOfFin_mem rfl _, T.orderEmbOfFin_mem rfl _,
      e.strictMono (Fin.mk_lt_mk.2 k.lt_succ_self), ?_⟩
    rintro u hu ⟨h1, h2⟩
    have hu' : u ∈ Set.range e := by rw [Finset.range_orderEmbOfFin]; exact hu
    obtain ⟨j, rfl⟩ := hu'
    have h1' : k < j.val := Fin.lt_def.1 (e.lt_iff_lt.1 h1)
    have h2' : j.val < k + 1 := Fin.lt_def.1 (e.lt_iff_lt.1 h2)
    exact absurd h1' (not_lt.2 (Nat.lt_add_one_iff.1 h2'))
  -- Step 3: if no breakpoint lies strictly between `a < b`, no coordinate of `γ` passes strictly
  -- across an integer `m` on `[a, b]`: otherwise `(m − xᵢ)/(yᵢ − xᵢ)` would be such a breakpoint
  have hcross : ∀ a b, 0 ≤ a → b ≤ 1 → a < b → (∀ u ∈ T, ¬(a < u ∧ u < b)) →
      ∀ (i : Fin P) (m : ℤ), ¬(γ a i < m ∧ (m : ℝ) < γ b i) ∧ ¬(γ b i < m ∧ (m : ℝ) < γ a i) := by
    intro a b ha hb hab hgap i m
    have hbreak : a < ((m : ℝ) - x i) / (y i - x i) → ((m : ℝ) - x i) / (y i - x i) < b →
        min (x i) (y i) < m → (m : ℝ) < max (x i) (y i) → False := fun h1 h2 h3 h4 =>
      hgap _ ((hmemT _).2 ⟨Or.inr (Or.inr (hmemB i m h3 h4)), by linarith, by linarith⟩) ⟨h1, h2⟩
    simp only [hγi]
    constructor
    · rintro ⟨h1, h2⟩
      have hd : 0 < y i - x i := not_le.1 fun hd =>
        by linarith [mul_le_mul_of_nonpos_right hab.le hd]
      exact hbreak ((lt_div_iff₀ hd).2 (by linarith)) ((div_lt_iff₀ hd).2 (by linarith))
        (by linarith [min_le_left (x i) (y i), mul_nonneg ha hd.le])
        (by linarith [le_max_right (x i) (y i), mul_le_of_le_one_left hd.le hb])
    · rintro ⟨h1, h2⟩
      have hd : y i - x i < 0 := not_le.1 fun hd =>
        by linarith [mul_le_mul_of_nonneg_right hab.le hd]
      exact hbreak ((lt_div_iff_of_neg hd).2 (by linarith)) ((div_lt_iff_of_neg hd).2 (by linarith))
        (by linarith [min_le_right (x i) (y i), mul_nonneg (sub_nonneg.2 hb) (neg_nonneg.2 hd.le)])
        (by linarith [le_max_left (x i) (y i), mul_nonneg ha (neg_nonneg.2 hd.le)])
  -- Steps 3–4: each piece `γ(t k), γ(t (k + 1))` lies in the closed cube `z + [0, 1]ᴾ`,
  -- `z = ⌊γ(midpoint)⌋`, so the cube estimate bounds it by `K (t (k + 1) − t k) |x − y|`
  have key : ∀ k < N,
      dist (f (γ (t k))) (f (γ (t (k + 1)))) ≤ K * dist x y * (t (k + 1) - t k) := by
    intro k hk
    obtain ⟨haT, hbT, hab, hgap⟩ := hstep k hk
    set a := t k
    set b := t (k + 1)
    obtain ⟨ha0, ha1⟩ := hT a haT
    obtain ⟨hb0, hb1⟩ := hT b hbT
    let z : Fin P → ℤ := fun i => ⌊γ ((a + b) / 2) i⌋
    have hz : ∀ i, ((z i : ℝ) ≤ γ a i ∧ γ a i ≤ z i + 1) ∧
        ((z i : ℝ) ≤ γ b i ∧ γ b i ≤ z i + 1) := by
      intro i
      have hmid : γ ((a + b) / 2) i = (γ a i + γ b i) / 2 := by rw [hγi, hγi, hγi]; ring
      have hz1 : (z i : ℝ) ≤ (γ a i + γ b i) / 2 := hmid ▸ Int.floor_le _
      have hz2 : (γ a i + γ b i) / 2 < z i + 1 := hmid ▸ Int.lt_floor_add_one _
      obtain ⟨hc1, hc2⟩ := hcross a b ha0 hb1 hab hgap i (z i)
      obtain ⟨hd1, hd2⟩ := hcross a b ha0 hb1 hab hgap i (z i + 1)
      rw [Int.cast_add, Int.cast_one] at hd1 hd2
      exact ⟨⟨not_lt.1 fun h => hc1 ⟨h, by linarith⟩, not_lt.1 fun h => hd2 ⟨by linarith, h⟩⟩,
        not_lt.1 fun h => hc2 ⟨h, by linarith⟩, not_lt.1 fun h => hd1 ⟨by linarith, h⟩⟩
    calc dist (f (γ a)) (f (γ b)) ≤ K * dist (γ a) (γ b) :=
          hcube z (γ a) (γ b) (hγS a ha0 ha1) (hγS b hb0 hb1) (fun i => (hz i).1) fun i => (hz i).2
      _ = K * dist x y * (b - a) := by
          rw [hγdist, abs_sub_comm, abs_of_pos (sub_pos.2 hab)]; ring
  -- Step 5: triangle inequality along `γ(t 0), …, γ(t N)`, then telescoping
  calc dist (f x) (f y) = dist (f (γ (t 0))) (f (γ (t N))) := by rw [ht0, htN, hγ0, hγ1]
    _ ≤ ∑ k ∈ Finset.range N, dist (f (γ (t k))) (f (γ (t (k + 1)))) :=
        dist_le_range_sum_dist (fun k => f (γ (t k))) N
    _ ≤ ∑ k ∈ Finset.range N, K * dist x y * (t (k + 1) - t k) :=
        Finset.sum_le_sum fun k hk => key k (Finset.mem_range.1 hk)
    _ = K * dist x y * (t N - t 0) := by rw [← Finset.mul_sum, Finset.sum_range_sub]
    _ = K * dist x y := by rw [ht0, htN]; ring
/-- **Simon Ch. 6, Lemma 5.4** (retraction onto the `n`-skeleton, `n = m + 1 < P`; the printed
construction, with the derivative bound proved directly).  Let `|aᵢ − 1/2| < 1/4`, `L*(a)` the set
of points with at least `m + 2` coordinates in `aᵢ + ℤ`, `rⱼ(y) = max((yⱼ − aⱼ)/(1 − aⱼ),
(aⱼ − yⱼ)/aⱼ)`, `κ` the `ℓ`-th largest entry (`ℓ = P − (m + 1)`),
`Φ(y)ᵢ = aᵢ + (yᵢ − aᵢ)/max(rᵢ(y), κ(r(y)))` the closed form of the composed radial retractions of
`[0, 1]ᴾ`, and `ψ(x) = ⌊x⌋ + Φ(x − ⌊x⌋)`.  Off `L*(a)`, `κ(r(x − ⌊x⌋)) > 0` (Claim C), so `ψ(x)`
has `ℓ` integer coordinates and `|ψ(x) − x| ≤ √P`.  On a grid cube `z + [0, 1]ᴾ`,
`ψ = z + Φ(· − z)` by periodicity, and Claims B and C bound its Lipschitz constant on
`{dist(·, L*(a)) ≥ r/2}` by `4√P/κ ≤ 2c₁/r`, `c₁ = 4√P √(m + 2)`.  If `|x − y| < r`, the segment
`[x, y]` stays in `{dist(·, L*(a)) ≥ r/2}` and cutting it at the grid gives `(2c₁/r)|x − y|`; if
`|x − y| ≥ r`, then `|ψ(x) − ψ(y)| ≤ |x − y| + 2√P ≤ ((1/4 + 2√P)/r)|x − y|`.  So
`c = 2c₁ + 2√P + 1/4` works. -/
theorem Submission.dor_lmb_fcd_retraction : ∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 0 < c ∧ ∀ a : Euclid P, (∀ i, |a i - 1 / 2| < 1 / 4) → ∃ ψ : Euclid P → Euclid P, (∀ x : Euclid P, 0 < infDist x {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} → (∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, ψ x i = z) ∧ dist (ψ x) x ≤ Real.sqrt P) ∧ ∀ r : ℝ, 0 < r → r ≤ 1 / 4 → ∀ x y : Euclid P, r ≤ infDist x {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} → r ≤ infDist y {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} → dist (ψ x) (ψ y) ≤ c / r * dist x y := by
  intro P m hmP
  -- Step 2: `κ`, the `ℓ`-th largest entry, `ℓ = P − (m + 1)`
  obtain ⟨κ, hκ1, hκ2, hκ3⟩ := Submission.dor_lmb_fcdr_order_stat P m hmP
  -- `c = 2c₁ + 2√P + 1/4 ≥ max(2c₁, 1/4 + 2√P)`, `c₁ = 4√P √(m + 2)`
  refine ⟨8 * Real.sqrt P * Real.sqrt (m + 2) + 2 * Real.sqrt P + 1 / 4, by positivity,
    fun a ha => ?_⟩
  set L : Set (Euclid P) := {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧
    ∀ i ∈ s, ∃ z : ℤ, w i - a i = z}
  have hsP := Real.sqrt_nonneg (P : ℝ)
  have hsm := Real.sqrt_nonneg ((m : ℝ) + 2)
  -- Step 3: the closed-form cube map `Φ`
  let Φ : Euclid P → Euclid P := fun y => WithLp.toLp 2 fun i => a i + (y i - a i) /
    max (max ((y i - a i) / (1 - a i)) ((a i - y i) / a i))
      (κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)))
  have hΦ : ∀ (y : Euclid P) (i : Fin P), Φ y i = a i + (y i - a i) /
      max (max ((y i - a i) / (1 - a i)) ((a i - y i) / a i))
        (κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j))) := fun _ _ => rfl
  -- integer points `z ∈ ℤᴾ` of `ℝᴾ`, and Step 5: `ψ(x) = ⌊x⌋ + Φ(x − ⌊x⌋)`
  let zv : (Fin P → ℤ) → Euclid P := fun z => WithLp.toLp 2 fun i => (z i : ℝ)
  let ψ : Euclid P → Euclid P := fun x => zv (fun j => ⌊x j⌋) + Φ (x - zv (fun j => ⌊x j⌋))
  have hψ : ∀ x i, ψ x i = ⌊x i⌋ + Φ (x - zv (fun j => ⌊x j⌋)) i := fun _ _ => rfl
  have hint : ∀ (z : Fin P → ℤ) (x : Euclid P) (i : Fin P), ∃ k : ℤ, x i - (x - zv z) i = k :=
    fun z x i => ⟨z i, show x i - (x i - z i) = z i by ring⟩
  -- Claim C: `dist(x, L*(a)) ≤ √(m + 2) κ(r(y))` if `x − y ∈ ℤᴾ`; so `κ(r(y)) > 0` off `L*(a)`
  have hdual : ∀ x y : Euclid P, (∀ i, ∃ k : ℤ, x i - y i = k) →
      infDist x L ≤ Real.sqrt (m + 2) *
        κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)) :=
    Submission.dor_lmb_fcdr_dual_dist P m a ha κ hκ2
  have hκpos : ∀ x y : Euclid P, (∀ i, ∃ k : ℤ, x i - y i = k) → 0 < infDist x L →
      0 < κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)) := by
    intro x y hxy hx
    by_contra hneg
    have h := mul_nonpos_of_nonneg_of_nonpos hsm (not_lt.1 hneg)
    linarith [hdual x y hxy]
  -- Step 5: on a grid cube `z + [0, 1]ᴾ`, `ψ = z + Φ(· − z)` (periodicity of `Φ`)
  have hψcube : ∀ (z : Fin P → ℤ) (x : Euclid P), (∀ i, (z i : ℝ) ≤ x i ∧ x i ≤ z i + 1) →
      ψ x = zv z + Φ (x - zv z) := by
    intro z x hx
    have hper := Submission.dor_lmb_fcdr_cube_periodic P m hmP a ha κ hκ1 Φ hΦ
      (x - zv (fun j => ⌊x j⌋)) (x - zv z)
      (fun j => show 0 ≤ x j - ⌊x j⌋ ∧ x j - ⌊x j⌋ ≤ 1 from
        ⟨by linarith [Int.floor_le (x j)], by linarith [Int.lt_floor_add_one (x j)]⟩)
      (fun j => show 0 ≤ x j - z j ∧ x j - z j ≤ 1 from
        ⟨by linarith [(hx j).1], by linarith [(hx j).2]⟩)
      (fun j => ⟨⌊x j⌋ - z j, show (x j - z j) - (x j - ⌊x j⌋) = ((⌊x j⌋ - z j : ℤ) : ℝ) by
        push_cast; ring⟩)
    ext i
    show (⌊x i⌋ : ℝ) + Φ (x - zv (fun j => ⌊x j⌋)) i = z i + Φ (x - zv z) i
    rw [hper i]
    show (⌊x i⌋ : ℝ) + Φ (x - zv (fun j => ⌊x j⌋)) i
      = z i + (Φ (x - zv (fun j => ⌊x j⌋)) i + ((x i - z i) - (x i - ⌊x i⌋)))
    ring
  -- Step 5: the first conclusion
  have hfirst : ∀ x : Euclid P, 0 < infDist x L →
      (∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, ψ x i = z) ∧
        dist (ψ x) x ≤ Real.sqrt P := by
    intro x hx
    obtain ⟨h01, s, hs, hs01⟩ := Submission.dor_lmb_fcdr_cube_skeleton P m a ha κ hκ1 Φ hΦ
      (x - zv (fun j => ⌊x j⌋)) (hκpos x _ (hint _ x) hx)
    refine ⟨⟨s, hs, fun i hi => ?_⟩, ?_⟩
    · -- `Φ(x − ⌊x⌋)ᵢ ∈ {0, 1}` on `s`
      rcases hs01 i hi with h | h
      · exact ⟨⌊x i⌋, by rw [hψ, h, add_zero]⟩
      · exact ⟨⌊x i⌋ + 1, by rw [hψ, h]; push_cast; ring⟩
    · -- `|ψ(x)ᵢ − xᵢ| = |Φ(x − ⌊x⌋)ᵢ − (xᵢ − ⌊xᵢ⌋)| ≤ 1`
      rw [EuclideanSpace.dist_eq]
      apply Real.sqrt_le_sqrt
      calc ∑ i, dist (ψ x i) (x i) ^ 2 ≤ ∑ _i : Fin P, (1 : ℝ) := by
            refine Finset.sum_le_sum fun i _ => ?_
            have h1 := h01 i
            have h2 := Int.floor_le (x i)
            have h3 := Int.lt_floor_add_one (x i)
            have h5 : |ψ x i - x i| ≤ 1 := by
              rw [hψ, abs_le]
              constructor <;> linarith [h1.1, h1.2]
            rw [Real.dist_eq]
            calc |ψ x i - x i| ^ 2 ≤ 1 ^ 2 := pow_le_pow_left₀ (abs_nonneg _) h5 2
              _ = 1 := one_pow 2
        _ = P := by
            rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, mul_one]
  -- Claims B and C on a grid cube: `|ψ(p) − ψ(q)| ≤ (4√P/κ) |p − q| ≤ (c/r) |p − q|` when
  -- `dist(p, L*(a)) ≥ r/2`
  have hcubeLip : ∀ r : ℝ, 0 < r → ∀ (z : Fin P → ℤ) (p q : Euclid P), r / 2 ≤ infDist p L →
      (∀ i, (z i : ℝ) ≤ p i ∧ p i ≤ z i + 1) → (∀ i, (z i : ℝ) ≤ q i ∧ q i ≤ z i + 1) →
      dist (ψ p) (ψ q) ≤
        (8 * Real.sqrt P * Real.sqrt (m + 2) + 2 * Real.sqrt P + 1 / 4) / r * dist p q := by
    intro r hr z p q hp hpz hqz
    have hk := hκpos p (p - zv z) (hint z p) (by linarith)
    have hd := hdual p (p - zv z) (hint z p)
    have hB := Submission.dor_lmb_fcdr_cube_lipschitz P a ha κ hκ3 Φ hΦ (p - zv z) (q - zv z) hk
    rw [dist_sub_right p q (zv z)] at hB
    rw [hψcube z p hpz, hψcube z q hqz, dist_add_left]
    refine hB.trans (mul_le_mul_of_nonneg_right ?_ dist_nonneg)
    -- `4√P/κ ≤ 8√P√(m + 2)/r ≤ c/r`, as `r ≤ 2√(m + 2) κ`
    have key : ∀ k : ℝ, 0 < k → r / 2 ≤ Real.sqrt (m + 2) * k →
        4 * Real.sqrt P / k ≤
          (8 * Real.sqrt P * Real.sqrt (m + 2) + 2 * Real.sqrt P + 1 / 4) / r := by
      intro k hk hrk
      rw [div_le_div_iff₀ hk hr]
      nlinarith [mul_nonneg hsP (by linarith : (0 : ℝ) ≤ 2 * (Real.sqrt (m + 2) * k) - r),
        mul_nonneg (by positivity : (0 : ℝ) ≤ 2 * Real.sqrt P + 1 / 4) hk.le]
    exact key _ hk (hp.trans hd)
  -- `[x, y] ⊆ ℝᴾ`: `|x − p| + |y − p| ≤ |x − y|` for `p ∈ [x, y]`
  have hseg : ∀ x y p : Euclid P, p ∈ segment ℝ x y → dist x p + dist y p ≤ dist x y := by
    intro x y p hp
    rw [segment_eq_image'] at hp
    obtain ⟨θ, ⟨hθ0, hθ1⟩, hθ⟩ := hp
    have hθ' : x + θ • (y - x) = p := hθ
    have e1 : x - p = (-θ) • (y - x) := by rw [← hθ', neg_smul]; abel
    have e2 : y - p = (1 - θ) • (y - x) := by rw [← hθ', sub_smul, one_smul]; abel
    rw [dist_eq_norm x p, dist_eq_norm y p, e1, e2, norm_smul, norm_smul, Real.norm_eq_abs,
      Real.norm_eq_abs, abs_neg, abs_of_nonneg hθ0, abs_of_nonneg (sub_nonneg.2 hθ1),
      dist_comm, dist_eq_norm]
    linarith
  refine ⟨ψ, hfirst, fun r hr hr4 x y hx hy => ?_⟩
  have hc0 : 0 ≤ (8 * Real.sqrt P * Real.sqrt (m + 2) + 2 * Real.sqrt P + 1 / 4) / r := by
    positivity
  rcases lt_or_ge (dist x y) r with hxy | hxy
  · -- Step 7(i): `|x − y| < r`, so `dist(·, L*(a)) ≥ r/2` on `[x, y]`; cut `[x, y]` at the grid
    refine Submission.dor_lmb_fcdr_grid_segment P ψ {p | r / 2 ≤ infDist p L} _ hc0
      (fun z p q hp _ hpz hqz => hcubeLip r hr z p q hp hpz hqz) x y fun p hp => ?_
    show r / 2 ≤ infDist p L
    have h1 : infDist x L ≤ infDist p L + dist x p := infDist_le_infDist_add_dist
    have h2 : infDist y L ≤ infDist p L + dist y p := infDist_le_infDist_add_dist
    linarith [hseg x y p hp]
  · -- Step 7(ii): `|x − y| ≥ r`, so `|ψ(x) − ψ(y)| ≤ |x − y| + 2√P ≤ (c/r)|x − y|`
    have h1 := (hfirst x (by linarith)).2
    have h2 := (hfirst y (by linarith)).2
    have h3 := dist_triangle4 (ψ x) x y (ψ y)
    rw [dist_comm y (ψ y)] at h3
    have hd : 0 ≤ dist x y := dist_nonneg
    calc dist (ψ x) (ψ y) ≤ dist x y + 2 * Real.sqrt P := by linarith
      _ ≤ (8 * Real.sqrt P * Real.sqrt (m + 2) + 2 * Real.sqrt P + 1 / 4) / r * dist x y := by
        rw [div_mul_eq_mul_div, le_div_iff₀ hr]
        nlinarith [mul_nonneg hsP (sub_nonneg.2 hxy),
          mul_nonneg hd (by linarith : (0 : ℝ) ≤ 1 / 4 - r), mul_nonneg (mul_nonneg hsP hsm) hd]
/-- **Tube about the shifted dual skeleton** (Simon Ch. 6, proof of 5.1, the identity before
display (6), inclusion `⊆`).  Let `L*(a)` be the set of `w` with `w_i − a_i ∈ ℤ` for at least
`m + 2` indices `i`.  It contains `a`, so `infDist x L*(a) < r` gives `w ∈ L*(a)` with
`|x − w| < r`.  Enumerate `m + 2` of the indices of `w` by `e`, and put
`z_k = w_{e(k)} − a_{e(k)} ∈ ℤ`.  Then
`Σ_k (x_{e(k)} − a_{e(k)} − z_k)² = Σ_k (x_{e(k)} − w_{e(k)})² ≤ |x − w|² < r²`. -/
theorem Submission.dor_lmb_fcd_gc_tube_cover : ∀ (P m : ℕ), m + 1 < P → ∀ (a x : Euclid P) (r : ℝ), infDist x {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} < r → ∃ e : Fin (m + 2) → Fin P, Function.Injective e ∧ ∃ z : Fin (m + 2) → ℤ, ∑ k, (x (e k) - a (e k) - z k) ^ 2 < r ^ 2 := by
  classical
  intro P m hPm a x r hx
  set L := {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z}
  -- Steps 1–2: `a ∈ L*(a)` (all `P ≥ m + 2` indices), so some `w ∈ L*(a)` has `|x − w| < r`
  have hne : L.Nonempty := ⟨a, Finset.univ, by simp; omega, fun i _ => ⟨0, by simp⟩⟩
  obtain ⟨w, ⟨s, hs, hsz⟩, hxw⟩ := (infDist_lt_iff hne).1 hx
  -- Step 3: `m + 2` of the indices in `s`, enumerated injectively by `e`
  obtain ⟨J, hJs, hJ⟩ := Finset.exists_subset_card_eq hs
  let e : Fin (m + 2) → Fin P := fun k => J.orderEmbOfFin hJ k
  have he : Function.Injective e := (J.orderEmbOfFin hJ).injective
  have hes : ∀ k, e k ∈ s := fun k => hJs (J.orderEmbOfFin_mem hJ k)
  -- Step 4: `z_k = w_{e(k)} − a_{e(k)} ∈ ℤ`
  choose z hz using fun k => hsz (e k) (hes k)
  refine ⟨e, he, z, ?_⟩
  have hterm : ∀ k, x (e k) - a (e k) - z k = x (e k) - w (e k) := fun k => by
    rw [← hz k]; ring
  -- Step 5: the `m + 2` selected squares are among the `P` nonnegative squares
  have hsub : ∑ k, (x (e k) - w (e k)) ^ 2 ≤ ∑ i, (x i - w i) ^ 2 := by
    have := Finset.sum_map Finset.univ ⟨e, he⟩ (fun i => (x i - w i) ^ 2)
    simp only [Function.Embedding.coeFn_mk] at this
    rw [← this]
    exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
      fun i _ _ => sq_nonneg _
  -- Step 6: `Σ_i (x_i − w_i)² = |x − w|²`
  have hdist : ∑ i, (x i - w i) ^ 2 = dist x w ^ 2 := by
    rw [EuclideanSpace.dist_eq, Real.sq_sqrt (Finset.sum_nonneg fun i _ => sq_nonneg _)]
    simp [Real.dist_eq, sq_abs]
  have h0 : 0 ≤ dist x w := dist_nonneg
  -- Step 7
  calc ∑ k, (x (e k) - a (e k) - z k) ^ 2 = ∑ k, (x (e k) - w (e k)) ^ 2 := by
        simp_rw [hterm]
    _ ≤ ∑ i, (x i - w i) ^ 2 := hsub
    _ = dist x w ^ 2 := hdist
    _ < r ^ 2 := by nlinarith
/-- **Simon, Ch. 6, proof of 5.1** ((1)–(4) and the summation after them: the bad set of centres
is small).  Let `ρ` be a finite measure on `ℝᵈ` and `β > 0`.  Call a centre `g` of the open cube
`(1/4, 3/4)ᵈ` bad if `β rᵈ ρ(ℝᵈ) < ρ(O_r(g))` for some `r ∈ (0, 1/4]`, where
`O_r(g) = {y : |y − g − z| < r for some z ∈ ℤᵈ}` is the open `r`-neighbourhood of `g + ℤᵈ`.  Then
the bad set has Lebesgue measure at most `10ᵈ/β`.  Vitali's covering lemma gives bad centres `b`
with pairwise disjoint sup-metric balls `B(b, r_b)` such that the balls `B(b, 3r_b)` cover the bad
set.  The sets `O_{r_b}(b)` are then pairwise disjoint as well, so `Σ_b β r_bᵈ ≤ 1`, and the
bad set has measure at most `Σ_b (6r_b)ᵈ ≤ 6ᵈ/β`. -/
theorem Submission.dor_lmb_fcd_gc_bad_set_volume : ∀ (d : ℕ) (ρ : Measure (Fin d → ℝ)), IsFiniteMeasure ρ → ∀ β : ℝ, 0 < β → volume {g : Fin d → ℝ | (∀ k, |g k - 1 / 2| < 1 / 4) ∧ ∃ r : ℝ, 0 < r ∧ r ≤ 1 / 4 ∧ ENNReal.ofReal (β * r ^ d) * ρ univ < ρ {y | ∃ z : Fin d → ℤ, ∑ k, (y k - g k - z k) ^ 2 < r ^ 2}} ≤ ENNReal.ofReal (10 ^ d / β) := by
  classical
  intro d ρ hρ β hβ
  set O : (Fin d → ℝ) → ℝ → Set (Fin d → ℝ) := fun g r =>
    {y | ∃ z : Fin d → ℤ, ∑ k, (y k - g k - z k) ^ 2 < r ^ 2} with hO
  set Bad := {g : Fin d → ℝ | (∀ k, |g k - 1 / 2| < 1 / 4) ∧ ∃ r : ℝ, 0 < r ∧ r ≤ 1 / 4 ∧
    ENNReal.ofReal (β * r ^ d) * ρ univ < ρ (O g r)}
  -- step 1: the periodic sets `O_r(g)` are open
  have hOopen : ∀ g r, IsOpen (O g r) := by
    intro g r
    have : O g r = ⋃ z : Fin d → ℤ, {y | ∑ k, (y k - g k - z k) ^ 2 < r ^ 2} := by
      ext y; simp [hO]
    rw [this]
    exact isOpen_iUnion fun z => isOpen_lt (by fun_prop) continuous_const
  -- step 2: if `ρ(ℝᵈ) = 0` the bad set is empty
  by_cases h0 : ρ univ = 0
  · have : Bad = ∅ := by
      ext g
      simp only [mem_empty_iff_false, iff_false]
      rintro ⟨-, r, -, -, hr⟩
      rw [h0, mul_zero, measure_mono_null (subset_univ _) h0] at hr
      exact lt_irrefl _ hr
    rw [this, measure_empty]
    exact bot_le
  have hfin : ρ univ ≠ ∞ := measure_ne_top ρ univ
  -- step 3: a radius `r_g` for every bad centre `g`
  have hrad : ∀ g ∈ Bad, ∃ r : ℝ, 0 < r ∧ r ≤ 1 / 4 ∧
      ENNReal.ofReal (β * r ^ d) * ρ univ < ρ (O g r) := fun g hg => hg.2
  choose! rad hrad0 hrad1 hradlt using hrad
  -- step 4: Vitali's covering lemma for the balls `B(g, r_g)`, with `τ = 2`
  obtain ⟨u, huBad, hudisj, hucov⟩ := Vitali.exists_disjoint_subfamily_covering_enlargement
    (fun g => ball g (rad g)) Bad rad 2 one_lt_two (fun g hg => (hrad0 g hg).le) (1 / 4) hrad1
    (fun g hg => ⟨g, mem_ball_self (hrad0 g hg)⟩)
  -- step 5: `u` is countable
  have hucount : u.Countable := hudisj.countable_of_isOpen (fun _ _ => isOpen_ball)
    (fun g hg => ⟨g, mem_ball_self (hrad0 g (huBad hg))⟩)
  -- step 6: the balls `B(b, 3 r_b)`, `b ∈ u`, cover the bad set
  have hBadsub : Bad ⊆ ⋃ b ∈ u, ball b (3 * rad b) := by
    intro g hg
    obtain ⟨b, hbu, ⟨y, hy1, hy2⟩, hle⟩ := hucov g hg
    refine mem_iUnion₂.2 ⟨b, hbu, ?_⟩
    rw [mem_ball] at hy1 hy2 ⊢
    calc dist g b ≤ dist g y + dist y b := dist_triangle _ _ _
      _ < rad g + rad b := by rw [dist_comm g y]; exact add_lt_add hy1 hy2
      _ ≤ 3 * rad b := by linarith
  -- step 7: the periodic sets `O_{r_b}(b)`, `b ∈ u`, are pairwise disjoint
  have hcoord : ∀ (y g : Fin d → ℝ) (r : ℝ) (z : Fin d → ℤ),
      ∑ k, (y k - g k - z k) ^ 2 < r ^ 2 → 0 < r → ∀ k, |y k - g k - z k| < r := by
    intro y g r z h hr k
    have hk : (y k - g k - z k) ^ 2 < r ^ 2 :=
      lt_of_le_of_lt (Finset.single_le_sum (f := fun i => (y i - g i - z i) ^ 2)
        (fun i _ => sq_nonneg _) (Finset.mem_univ k)) h
    exact abs_lt_of_sq_lt_sq hk hr.le
  have hOdisj : u.PairwiseDisjoint fun b => O b (rad b) := by
    intro b hb b' hb' hne
    rw [Function.onFun, Set.disjoint_left]
    rintro y ⟨z, hz⟩ ⟨z', hz'⟩
    have hb0 := hrad0 b (huBad hb)
    have hb'0 := hrad0 b' (huBad hb')
    have h1 := hcoord y b (rad b) z hz hb0
    have h2 := hcoord y b' (rad b') z' hz' hb'0
    have hr1 := hrad1 b (huBad hb)
    have hr2 := hrad1 b' (huBad hb')
    -- the centres lie in `(1/4, 3/4)ᵈ` and the radii are `≤ 1/4`, so the integer shifts agree
    have hzz : z = z' := by
      funext k
      have a1 := abs_lt.1 (h1 k)
      have a2 := abs_lt.1 (h2 k)
      have a3 := abs_lt.1 ((huBad hb).1 k)
      have a4 := abs_lt.1 ((huBad hb').1 k)
      have c1 : (z k : ℝ) < z' k + 1 := by linarith
      have c2 : (z' k : ℝ) < z k + 1 := by linarith
      have c1' : z k < z' k + 1 := by exact_mod_cast c1
      have c2' : z' k < z k + 1 := by exact_mod_cast c2
      omega
    subst hzz
    -- then `y − z` lies in both balls `B(b, r_b)` and `B(b', r_{b'})`
    have hv : (fun k => y k - z k) ∈ ball b (rad b) ∩ ball b' (rad b') := by
      constructor
      · rw [mem_ball, dist_pi_lt_iff hb0]
        intro k
        rw [Real.dist_eq]
        have := h1 k
        rwa [show y k - z k - b k = y k - b k - z k by ring]
      · rw [mem_ball, dist_pi_lt_iff hb'0]
        intro k
        rw [Real.dist_eq]
        have := h2 k
        rwa [show y k - z k - b' k = y k - b' k - z k by ring]
    exact (Set.disjoint_left.1 (hudisj hb hb' hne)) hv.1 hv.2
  -- step 8: `S = Σ_{b ∈ u} β r_bᵈ ≤ 1`
  set S : ℝ≥0∞ := ∑' b : u, ENNReal.ofReal (β * rad b ^ d)
  have hSle : S ≤ 1 := by
    have hsum : S * ρ univ ≤ 1 * ρ univ := by
      calc S * ρ univ = ∑' b : u, ENNReal.ofReal (β * rad b ^ d) * ρ univ :=
            (ENNReal.tsum_mul_right).symm
        _ ≤ ∑' b : u, ρ (O b (rad b)) :=
            ENNReal.tsum_le_tsum fun b => (hradlt b (huBad b.2)).le
        _ = ρ (⋃ b ∈ u, O b (rad b)) :=
            (measure_biUnion hucount hOdisj fun b _ => (hOopen _ _).measurableSet).symm
        _ ≤ ρ univ := measure_mono (subset_univ _)
        _ = 1 * ρ univ := (one_mul _).symm
    exact (ENNReal.mul_le_mul_iff_left h0 hfin).1 hsum
  -- step 9: the volume estimate
  calc volume Bad ≤ volume (⋃ b ∈ u, ball b (3 * rad b)) := measure_mono hBadsub
    _ ≤ ∑' b : u, volume (ball (b : Fin d → ℝ) (3 * rad b)) := measure_biUnion_le _ hucount _
    _ = ∑' b : u, ENNReal.ofReal (6 ^ d / β) * ENNReal.ofReal (β * rad b ^ d) := by
        refine tsum_congr fun b => ?_
        have hb0 := hrad0 b (huBad b.2)
        rw [Real.volume_pi_ball _ (by positivity), Fintype.card_fin,
          ← ENNReal.ofReal_mul (by positivity)]
        congr 1
        field_simp
        ring
    _ = ENNReal.ofReal (6 ^ d / β) * S := ENNReal.tsum_mul_left
    _ ≤ ENNReal.ofReal (6 ^ d / β) * 1 := by gcongr
    _ ≤ ENNReal.ofReal (10 ^ d / β) := by
        rw [mul_one]
        apply ENNReal.ofReal_le_ofReal
        gcongr
        norm_num
/-- **Simon, Ch. 6, proof of 5.1** ((5) and the choice of `a`, cube version).  If sets
`E_e ⊆ ℝ^d`, one for each map `e : Fin d → Fin P`, have total Lebesgue outer measure
`< (1/2)^P`, then some `a` in the open cube `(1/4, 3/4)^P` has `(a_{e(k)})_k ∉ E_e` for every
injective `e`.  By Fubini over the coordinates in `range e` and the rest, the centres in the cube
whose `e`-projection lies in `E_e` have volume `≤ L^d(E_e)`; the cube has volume `(1/2)^P`, so the
union bound leaves a good centre. -/
theorem Submission.dor_lmb_fcd_gc_cube_selection : ∀ (P d : ℕ) (E : (Fin d → Fin P) → Set (Fin d → ℝ)), ∑ e, volume (E e) < ENNReal.ofReal ((1 / 2) ^ P) → ∃ a : Euclid P, (∀ i, |a i - 1 / 2| < 1 / 4) ∧ ∀ e : Fin d → Fin P, Function.Injective e → (fun k => a (e k)) ∉ E e := by
  classical
  intro P d E hsum
  -- Step 2 (Fubini): for injective `e`, the points of the cube whose `e`-projection lies in `F`
  -- have volume at most `volume F`
  have fubini : ∀ e : Fin d → Fin P, Function.Injective e → ∀ F : Set (Fin d → ℝ),
      volume {x : Fin P → ℝ | (∀ i, x i ∈ Ioo (1 / 4 : ℝ) (3 / 4)) ∧ (fun k => x (e k)) ∈ F} ≤
        volume F := by
    intro e he F
    let p : Fin P → Prop := fun i => i ∈ range e
    let Φ := MeasurableEquiv.piEquivPiSubtypeProd (fun _ : Fin P => ℝ) p
    have hΦ : MeasurePreserving Φ := by
      convert volume_preserving_piEquivPiSubtypeProd (fun _ : Fin P => ℝ) p
    let σ : Fin d ≃ {i // p i} := Equiv.ofInjective e he
    let ψ := (MeasurableEquiv.piCongrLeft (fun _ : {i // p i} => ℝ) σ).symm
    have hψ : MeasurePreserving ψ :=
      (volume_measurePreserving_piCongrLeft (fun _ : {i // p i} => ℝ) σ).symm _
    have hψapp : ∀ u k, ψ u k = u (σ k) := by
      intro u k
      simp [ψ, MeasurableEquiv.piCongrLeft, Equiv.piCongrLeft_symm_apply]
    let G : Set ({i // p i} → ℝ) := ψ ⁻¹' F
    let H : Set ({i // ¬ p i} → ℝ) := Set.pi univ fun _ => Ioo (1 / 4 : ℝ) (3 / 4)
    have hsub : {x : Fin P → ℝ | (∀ i, x i ∈ Ioo (1 / 4 : ℝ) (3 / 4)) ∧ (fun k => x (e k)) ∈ F} ⊆
        Φ ⁻¹' (G ×ˢ H) := by
      rintro x ⟨hx1, hx2⟩
      refine ⟨?_, fun i _ => hx1 i⟩
      show ψ (fun i => x i) ∈ F
      have : ψ (fun i : {i // p i} => x i) = fun k => x (e k) := by
        funext k; rw [hψapp]; rfl
      rw [this]; exact hx2
    have hG : volume G = volume F := hψ.measure_preimage_equiv F
    have hH : volume H ≤ 1 := by
      rw [Real.volume_pi_Ioo]
      refine Finset.prod_le_one fun i _ => ?_
      rw [ENNReal.ofReal_le_one]; norm_num
    calc volume {x : Fin P → ℝ | (∀ i, x i ∈ Ioo (1 / 4 : ℝ) (3 / 4)) ∧ (fun k => x (e k)) ∈ F}
        ≤ volume (Φ ⁻¹' (G ×ˢ H)) := measure_mono hsub
      _ = volume (G ×ˢ H) := hΦ.measure_preimage_equiv _
      _ = volume G * volume H := by
          rw [Measure.volume_eq_prod]; exact Measure.prod_prod G H
      _ ≤ volume G * 1 := by gcongr
      _ = volume F := by rw [mul_one, hG]
  have hI : ∀ t : ℝ, |t - 1 / 2| < 1 / 4 ↔ t ∈ Ioo (1 / 4 : ℝ) (3 / 4) := by
    intro t
    rw [abs_sub_lt_iff, mem_Ioo]
    constructor <;> rintro ⟨h1, h2⟩ <;> constructor <;> linarith
  -- Step 1: the open cube `Q` in `Euclid P` has volume `(1/2)^P`
  let Q : Set (Euclid P) := {a | ∀ i, a i ∈ Ioo (1 / 4 : ℝ) (3 / 4)}
  have hofLp : MeasurePreserving (MeasurableEquiv.toLp 2 (Fin P → ℝ)).symm :=
    EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin P)
  have hQ : volume Q = ENNReal.ofReal ((1 / 2) ^ P) := by
    have : Q = (MeasurableEquiv.toLp 2 (Fin P → ℝ)).symm ⁻¹'
        (Set.pi univ fun _ => Ioo (1 / 4 : ℝ) (3 / 4)) := by
      ext a; simp [Q, Set.mem_pi]
    rw [this, hofLp.measure_preimage_equiv, Real.volume_pi_Ioo, Finset.prod_const,
      Finset.card_univ, Fintype.card_fin, ← ENNReal.ofReal_pow (by norm_num)]
    norm_num
  -- Step 3: the sets of centres with a bad projection
  let A : (Fin d → Fin P) → Set (Euclid P) := fun e =>
    {a | Function.Injective e ∧ a ∈ Q ∧ (fun k => a (e k)) ∈ E e}
  have hA : ∀ e, volume (A e) ≤ volume (E e) := by
    intro e
    by_cases he : Function.Injective e
    · have hsub : A e ⊆ (MeasurableEquiv.toLp 2 (Fin P → ℝ)).symm ⁻¹'
          {x : Fin P → ℝ | (∀ i, x i ∈ Ioo (1 / 4 : ℝ) (3 / 4)) ∧ (fun k => x (e k)) ∈ E e} := by
        rintro a ⟨-, haQ, haE⟩
        exact ⟨haQ, haE⟩
      calc volume (A e) ≤ _ := measure_mono hsub
        _ = _ := hofLp.measure_preimage_equiv _
        _ ≤ volume (E e) := fubini e he (E e)
    · have : A e = ∅ := by
        ext a; simp only [mem_empty_iff_false, iff_false]; exact fun h => he h.1
      rw [this, measure_empty]; exact bot_le
  -- Steps 4–5: union bound and choice of `a`
  by_contra hcon
  push Not at hcon
  have hcov : Q ⊆ ⋃ e, A e := by
    intro a haQ
    obtain ⟨e, he, haE⟩ := hcon a fun i => (hI _).2 (haQ i)
    exact mem_iUnion.2 ⟨e, he, haQ, haE⟩
  have : volume Q < volume Q :=
    calc volume Q ≤ volume (⋃ e, A e) := measure_mono hcov
      _ ≤ ∑ e, volume (A e) := measure_iUnion_fintype_le _ _
      _ ≤ ∑ e, volume (E e) := Finset.sum_le_sum fun e _ => hA e
      _ < ENNReal.ofReal ((1 / 2) ^ P) := hsum
      _ = volume Q := hQ.symm
  exact lt_irrefl _ this
/-- **Simon, Ch. 6, proof of 5.1** (choice of the centre `a`, (5)–(7)).  Put `d = m + 2`,
`K = #(Fin d → Fin P)`, `β = 2K·10ᵈ·2ᴾ + 1` and `C = Kβ`.  For each `e : Fin d → Fin P` let
`E_e` be the union of the bad sets of centres of the image measures of `μ` and `μ'` under
`x ↦ (x_{e(k)})_k`.  Each bad set has volume `≤ 10ᵈ/β`, so `Σ_e |E_e| < (1/2)ᴾ` and the cube
selection gives `a` with `(a_{e(k)})_k ∉ E_e` for every injective `e`.  The `r`-tube about
`L*(a)` lies in the union over injective `e` of the preimages of the periodic
`r`-neighbourhoods of `(a_{e(k)})_k`, each of `ν`-measure `≤ β rᵈ ν(ℝᴾ)` for `ν = μ, μ'`; hence
`ν(tube) ≤ Kβ rᵈ ν(ℝᴾ)`. -/
theorem Submission.dor_lmb_fcd_good_center : ∀ (P m : ℕ), m + 1 < P → ∃ C : NNReal, ∀ μ μ' : Measure (Euclid P), IsFiniteMeasure μ → IsFiniteMeasure μ' → ∃ a : Euclid P, (∀ i, |a i - 1 / 2| < 1 / 4) ∧ ∀ r : ℝ, 0 < r → r ≤ 1 / 4 → μ {x | infDist x {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} < r} ≤ C * ENNReal.ofReal (r ^ (m + 2)) * μ univ ∧ μ' {x | infDist x {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} < r} ≤ C * ENNReal.ofReal (r ^ (m + 2)) * μ' univ := by
  have c1 := Submission.dor_lmb_fcd_gc_tube_cover
  have c2 := Submission.dor_lmb_fcd_gc_bad_set_volume
  have c3 := Submission.dor_lmb_fcd_gc_cube_selection
  classical
  intro P m hPm
  -- Step 4: the constants `β` and `C = Kβ`, depending only on `P` and `m`
  set K : ℕ := Fintype.card (Fin (m + 2) → Fin P) with hK
  set β : ℝ := 2 * K * 10 ^ (m + 2) * 2 ^ P + 1 with hβ
  have hβpos : 0 < β := by positivity
  refine ⟨Real.toNNReal (K * β), ?_⟩
  intro μ μ' hμ hμ'
  -- the coordinate projections `x ↦ (x_{e(k)})_k`
  let prj : (Fin (m + 2) → Fin P) → Euclid P → (Fin (m + 2) → ℝ) := fun e x k => x (e k)
  have hprj : ∀ e, Measurable (prj e) := fun e =>
    (continuous_pi fun k => PiLp.continuous_apply 2 (fun _ : Fin P => ℝ) (e k)).measurable
  -- the bad sets of centres of the projected measures (steps 2–3)
  let Bad : Measure (Fin (m + 2) → ℝ) → Set (Fin (m + 2) → ℝ) := fun ρ =>
    {g | (∀ k, |g k - 1 / 2| < 1 / 4) ∧ ∃ r : ℝ, 0 < r ∧ r ≤ 1 / 4 ∧
      ENNReal.ofReal (β * r ^ (m + 2)) * ρ univ <
        ρ {y | ∃ z : Fin (m + 2) → ℤ, ∑ k, (y k - g k - z k) ^ 2 < r ^ 2}}
  let E : (Fin (m + 2) → Fin P) → Set (Fin (m + 2) → ℝ) := fun e =>
    Bad (μ.map (prj e)) ∪ Bad (μ'.map (prj e))
  have hE : ∀ e, volume (E e) ≤ 2 * ENNReal.ofReal (10 ^ (m + 2) / β) := by
    intro e
    calc volume (E e) ≤ volume (Bad (μ.map (prj e))) + volume (Bad (μ'.map (prj e))) :=
          measure_union_le _ _
      _ ≤ ENNReal.ofReal (10 ^ (m + 2) / β) + ENNReal.ofReal (10 ^ (m + 2) / β) :=
          add_le_add (c2 (m + 2) _ inferInstance β hβpos) (c2 (m + 2) _ inferInstance β hβpos)
      _ = 2 * ENNReal.ofReal (10 ^ (m + 2) / β) := (two_mul _).symm
  -- the exceptional sets do not exhaust the cube
  have hsum : ∑ e, volume (E e) < ENNReal.ofReal ((1 / 2) ^ P) := by
    calc ∑ e, volume (E e) ≤ ∑ _e : Fin (m + 2) → Fin P, 2 * ENNReal.ofReal (10 ^ (m + 2) / β) :=
          Finset.sum_le_sum fun e _ => hE e
      _ = ENNReal.ofReal (2 * K * 10 ^ (m + 2) / β) := by
          rw [Finset.sum_const, Finset.card_univ, ← hK, nsmul_eq_mul,
            show (2 : ℝ≥0∞) = ENNReal.ofReal 2 by simp, ← ENNReal.ofReal_natCast,
            ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
          congr 1
          ring
      _ < ENNReal.ofReal ((1 / 2) ^ P) := by
          rw [ENNReal.ofReal_lt_ofReal_iff (by positivity), div_lt_iff₀ hβpos, hβ]
          have h2 : ((1 : ℝ) / 2) ^ P * 2 ^ P = 1 := by
            rw [← mul_pow]; norm_num
          have h3 : (0 : ℝ) < (1 / 2) ^ P := by positivity
          have h4 : ((1 : ℝ) / 2) ^ P * (2 * K * 10 ^ (m + 2) * 2 ^ P + 1) =
              2 * K * 10 ^ (m + 2) * ((1 / 2) ^ P * 2 ^ P) + (1 / 2) ^ P := by ring
          rw [h4, h2]
          linarith
  -- choice of a good centre `a` for both measures
  obtain ⟨a, ha, hgood⟩ := c3 P (m + 2) E hsum
  refine ⟨a, ha, ?_⟩
  intro r hr0 hr1
  -- Step 5: the estimate for any finite `ν` for which `a` is good
  have key : ∀ ν : Measure (Euclid P), IsFiniteMeasure ν →
      (∀ e : Fin (m + 2) → Fin P, Function.Injective e → prj e a ∉ Bad (ν.map (prj e))) →
      ν {x | infDist x {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧
        ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} < r} ≤
        (Real.toNNReal (K * β) : ℝ≥0∞) * ENNReal.ofReal (r ^ (m + 2)) * ν univ := by
    intro ν hν hνgood
    let O : (Fin (m + 2) → Fin P) → Set (Fin (m + 2) → ℝ) := fun e =>
      {y | ∃ z : Fin (m + 2) → ℤ, ∑ k, (y k - prj e a k - z k) ^ 2 < r ^ 2}
    let T : (Fin (m + 2) → Fin P) → Set (Euclid P) := fun e =>
      {x | Function.Injective e ∧ prj e x ∈ O e}
    -- step 1: the `r`-tube about `L*(a)` lies in the periodic coordinate cylinders
    have hcover : {x | infDist x {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧
        ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} < r} ⊆ ⋃ e, T e := by
      intro x hx
      obtain ⟨e, he, z, hz⟩ := c1 P m hPm a x r hx
      exact mem_iUnion.2 ⟨e, he, z, hz⟩
    -- each cylinder family has `ν`-measure `≤ β rᵈ ν(ℝᴾ)`, since `a` is good
    have hT : ∀ e, ν (T e) ≤ ENNReal.ofReal (β * r ^ (m + 2)) * ν univ := by
      intro e
      by_cases he : Function.Injective e
      · have hsub : T e ⊆ prj e ⁻¹' O e := fun x hx => hx.2
        have hcube : ∀ k, |prj e a k - 1 / 2| < 1 / 4 := fun k => ha (e k)
        have hnot := hνgood e he
        have hle : (ν.map (prj e)) (O e) ≤
            ENNReal.ofReal (β * r ^ (m + 2)) * (ν.map (prj e)) univ := by
          by_contra hlt
          exact hnot ⟨hcube, r, hr0, hr1, not_le.1 hlt⟩
        calc ν (T e) ≤ ν (prj e ⁻¹' O e) := measure_mono hsub
          _ ≤ (ν.map (prj e)) (O e) := Measure.le_map_apply (hprj e).aemeasurable _
          _ ≤ ENNReal.ofReal (β * r ^ (m + 2)) * (ν.map (prj e)) univ := hle
          _ = ENNReal.ofReal (β * r ^ (m + 2)) * ν univ := by
              rw [Measure.map_apply (hprj e) MeasurableSet.univ, preimage_univ]
      · have : T e = ∅ := by
          ext x
          simp only [mem_empty_iff_false, iff_false]
          exact fun hx => he hx.1
        rw [this, measure_empty]
        exact bot_le
    -- subadditivity over the `K` maps `e`
    calc ν {x | infDist x {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧
          ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} < r} ≤ ν (⋃ e, T e) := measure_mono hcover
      _ ≤ ∑ e, ν (T e) := measure_iUnion_fintype_le ν T
      _ ≤ ∑ _e : Fin (m + 2) → Fin P, ENNReal.ofReal (β * r ^ (m + 2)) * ν univ :=
          Finset.sum_le_sum fun e _ => hT e
      _ = (Real.toNNReal (K * β) : ℝ≥0∞) * ENNReal.ofReal (r ^ (m + 2)) * ν univ := by
          rw [Finset.sum_const, Finset.card_univ, ← hK, nsmul_eq_mul, ← mul_assoc]
          congr 1
          rw [← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (by positivity),
            show ((Real.toNNReal (K * β) : ℝ≥0∞)) = ENNReal.ofReal (K * β) from rfl,
            ← ENNReal.ofReal_mul (by positivity)]
          congr 1
          ring
  exact ⟨key μ hμ fun e he h => hgood e he (Or.inl h),
    key μ' hμ' fun e he h => hgood e he (Or.inr h)⟩
/-- **Simon Ch. 2, §4, (4.3)**: if `ψ : V → W` is a local representation of `N` as in (4.1)
(`Cʳ`, `r ≥ 1`, 1:1 and proper, `ψ(V) = W ∩ N`, `Dψ` injective), then
`T_{ψ(v)}N = Dψ(v)(ℝᵈ)` for every `v ∈ V`.  `Dψ(v)(ℝᵈ) ⊆ T_{ψ(v)}N` because `ψ(V) ⊆ N`.
Conversely, properness and injectivity make `ψ⁻¹` continuous at `ψ(v)` on `ψ(V)`; with `Dψ(v)`
injective this gives, for each `ε > 0`, some `a` with `|y − ψ(v) − Dψ(v)a| ≤ ε|y − ψ(v)|` for all
`y ∈ N` near `ψ(v)`, so the difference quotients of a `C¹` curve in `N` through `ψ(v)` converge
into the closed subspace `Dψ(v)(ℝᵈ)`. -/
theorem Submission.chart_tangentSpace_eq_range_fderiv : ∀ (P d r : ℕ) (N W : Set (Euclid P)) (V : Set (Euclid d)) (ψ : Euclid d → Euclid P) (v : Euclid d), 1 ≤ r → IsOpen V → IsOpen W → ContDiffOn ℝ r ψ V → InjOn ψ V → ψ '' V = W ∩ N → (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → (∀ z ∈ V, Injective (fderiv ℝ ψ z)) → v ∈ V → tangentSpace N (ψ v) = Set.range (fderiv ℝ ψ v) := by
  intro P d r N W V ψ v hr hV hW hψ hinj hψV hproper hDψ hv
  -- `ψ` is `C¹` on the open set `V`, hence differentiable at `v` with derivative `Dψ(v)`
  have hψ1 : ContDiffOn ℝ 1 ψ V := hψ.of_le (by exact_mod_cast hr)
  have hψv : HasFDerivAt ψ (fderiv ℝ ψ v) v :=
    ((hψ1.differentiableOn one_ne_zero).differentiableAt (hV.mem_nhds hv)).hasFDerivAt
  -- `ψ(V) = W ∩ N` lies in `W` and in `N`
  have hVW : ψ '' V ⊆ W := hψV ▸ inter_subset_left
  have hVN : ψ '' V ⊆ N := hψV ▸ inter_subset_right
  -- `ψ⁻¹` is continuous at `ψ(v)` on `ψ(V)`
  have hinv := Submission.dsmc_chart_inverse_continuity P d V W ψ hψ.continuousOn hinj hVW
    hproper v hv
  refine Subset.antisymm ?_
    (Submission.dsmc_chart_range_subset_tangentSpace P r d N V ψ hr hV hψ hVN v hv)
  -- `T_{ψ(v)}N ⊆ Dψ(v)(ℝᵈ)`, from the secant estimate at `ψ(v)`
  exact Submission.dsmc_tangentSpace_subset_range_of_secant P d N (ψ v) (fderiv ℝ ψ v)
    (Submission.dsmc_chart_secant_estimate P d N V W ψ (fderiv ℝ ψ v) v hW hψV hv hψv
      (hDψ v hv) hinv)
/-- Simon 6.2.23 (setting of the push-forward `φ_#T`; step 1 of the parent proof): a `C¹`
bijection `φ` of `ℝᴾ` with injective differential everywhere and `φ = id` off the compact set
`K ⊆ U` is bi-Lipschitz, and `φ⁻¹(U) = U`.  `‖Dφ‖` is bounded (continuous on `K`, `Dφ = I` off
`K`), so `φ` is Lipschitz by the mean value inequality; `φ` is proper (`φ⁻¹(C) ⊆ C ∪ K`), hence
a homeomorphism; `φ⁻¹` is `C¹` by the inverse function theorem and equals `id` off `K`, so it is
Lipschitz as well, i.e. `φ` is antilipschitz. -/
theorem Submission.dpf_c1_compact_perturbation_bilipschitz : ∀ (P : ℕ) (U K : Set (Euclid P)) (φ : Euclid P → Euclid P), IsCompact K → K ⊆ U → ContDiff ℝ 1 φ → Bijective φ → (∀ x, Injective (fderiv ℝ φ x)) → (∀ x, x ∉ K → φ x = x) → ∃ Λ : NNReal, LipschitzWith Λ φ ∧ AntilipschitzWith Λ φ ∧ φ ⁻¹' U = U := by
  intro P U K φ hK hKU hφ hbij hinj hfix
  -- Steps 1, 3 and 6: a `C¹` map `f` equal to the identity off `K` has bounded differential
  -- (`Df = I` on the open set `ℝᴾ \ K`, `‖Df‖` bounded on the compact `K`), hence is Lipschitz
  have hlip : ∀ f : Euclid P → Euclid P, ContDiff ℝ 1 f → (∀ x, x ∉ K → f x = x) →
      ∃ C : NNReal, LipschitzWith C f := by
    intro f hf hfixf
    obtain ⟨c, hc⟩ :=
      hK.exists_bound_of_continuousOn (hf.continuous_fderiv one_ne_zero).continuousOn
    refine ⟨max 1 c.toNNReal,
      lipschitzWith_of_nnnorm_fderiv_le (hf.differentiable one_ne_zero) fun x => ?_⟩
    by_cases hx : x ∈ K
    · refine le_trans ?_ (le_max_right _ _)
      rw [← NNReal.coe_le_coe, coe_nnnorm]
      exact (hc x hx).trans c.le_coe_toNNReal
    · have hev : f =ᶠ[𝓝 x] id := by
        filter_upwards [hK.isClosed.isOpen_compl.mem_nhds hx] with y hy using hfixf y hy
      rw [hev.fderiv_eq, fderiv_id]
      refine le_trans ?_ (le_max_left _ _)
      rw [← NNReal.coe_le_coe, coe_nnnorm]
      exact ContinuousLinearMap.norm_id_le
  -- Step 2: `φ⁻¹(U) = U`
  have hpre : φ ⁻¹' U = U := by
    ext x
    rw [mem_preimage]
    constructor
    · intro hx
      by_contra hxU
      have hxK : x ∉ K := fun h => hxU (hKU h)
      rw [hfix x hxK] at hx
      exact hxU hx
    · intro hx
      by_cases hxK : x ∈ K
      · apply hKU
        by_contra hφK
        have hφx : φ x = x := hbij.1 (hfix (φ x) hφK)
        exact hφK (by rwa [hφx])
      · rw [hfix x hxK]
        exact hx
  -- Step 4: `φ` is proper (`φ⁻¹(C) ⊆ C ∪ K`), hence closed, hence a homeomorphism
  have hcont : Continuous φ := hφ.continuous
  have hclosed : IsClosedMap φ := by
    refine (isProperMap_iff_isCompact_preimage.2 ⟨hcont, fun C hC => ?_⟩).isClosedMap
    refine (hC.union hK).of_isClosed_subset (hC.isClosed.preimage hcont) fun x hx => ?_
    by_cases hxK : x ∈ K
    · exact Or.inr hxK
    · left
      simpa [hfix x hxK] using hx
  obtain ⟨e, rfl⟩ : ∃ e : Euclid P ≃ₜ Euclid P, ⇑e = φ :=
    ⟨(Equiv.ofBijective φ hbij).toHomeomorphOfContinuousClosed hcont hclosed, rfl⟩
  -- Step 5: `ψ = φ⁻¹` is `C¹`, each `Dφ(a)` being a linear isomorphism
  have hψ : ContDiff ℝ 1 e.symm := by
    refine e.contDiff_symm (f₀' := fun a => (LinearEquiv.ofInjectiveEndo
      (fderiv ℝ e a : Euclid P →ₗ[ℝ] Euclid P) (hinj a)).toContinuousLinearEquiv)
      (fun a => ?_) hφ
    have h1 : ((LinearEquiv.ofInjectiveEndo (fderiv ℝ e a : Euclid P →ₗ[ℝ] Euclid P)
        (hinj a)).toContinuousLinearEquiv : Euclid P →L[ℝ] Euclid P) = fderiv ℝ e a := by
      ext v
      rfl
    rw [h1]
    exact (hφ.differentiable one_ne_zero a).hasFDerivAt
  -- Step 6: `ψ = id` off `K`
  have hψfix : ∀ y, y ∉ K → e.symm y = y := fun y hy => e.symm_apply_eq.2 (hfix y hy).symm
  obtain ⟨C₁, hC₁⟩ := hlip e hφ hfix
  obtain ⟨C₂, hC₂⟩ := hlip e.symm hψ hψfix
  -- Steps 7 and 8: `φ` is `C₂`-antilipschitz; take `Λ = max C₁ C₂`
  refine ⟨max C₁ C₂, hC₁.weaken (le_max_left _ _), fun x y => ?_, hpre⟩
  calc edist x y = edist (e.symm (e x)) (e.symm (e y)) := by simp
    _ ≤ C₂ * edist (e x) (e y) := hC₂ _ _
    _ ≤ max C₁ C₂ * edist (e x) (e y) := by gcongr; exact le_max_right _ _
/-- The derivative bound behind Simon 6.2.24(2)–(3) (push-forward by a `C¹` map): if `φ` is `C¹`
on `ℝᴾ` and `φ(x) = x` off a compact set `K`, then `‖Dφ(x)‖ ≤ Λ` for some `Λ ≥ 0` and all `x`.
`Dφ` is continuous, hence bounded by some `c` on `K`; off the closed set `K`, `φ = id` near `x`,
so `Dφ(x) = id` has norm `≤ 1`.  Take `Λ = max(1, c)`. -/
theorem Submission.dpf_pfc_fderiv_norm_le_of_eq_id_off_compact : ∀ (P : ℕ) (K : Set (Euclid P)) (φ : Euclid P → Euclid P), IsCompact K → ContDiff ℝ 1 φ → (∀ x, x ∉ K → φ x = x) → ∃ Λ : ℝ, 0 ≤ Λ ∧ ∀ x, ‖fderiv ℝ φ x‖ ≤ Λ := by
  intro P K φ hK hφ hid
  -- `Dφ` is continuous, so it is bounded by some `c` on the compact set `K`
  obtain ⟨c, hc⟩ := hK.exists_bound_of_continuousOn (hφ.continuous_fderiv one_ne_zero).continuousOn
  refine ⟨max 1 c, zero_le_one.trans (le_max_left _ _), fun x => ?_⟩
  by_cases hx : x ∈ K
  · exact (hc x hx).trans (le_max_right _ _)
  · -- off the closed set `K`, `φ = id` near `x`, so `Dφ(x) = id` has norm `≤ 1`
    have h : φ =ᶠ[𝓝 x] id := eventually_of_mem (hK.isClosed.isOpen_compl.mem_nhds hx) hid
    rw [h.fderiv_eq, fderiv_id]
    exact ContinuousLinearMap.norm_id_le.trans (le_max_left _ _)
/-- Simon 6.3.1: `Hⁿ`-a.e. on `M` the orientation `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ` of an integer
multiplicity triple is a unit simple `n`-vector (`τ` orthonormal), so every `n`-covector `β`
satisfies `|⟨β, ξ(x)⟩| = |β(τ₁, …, τₙ)| ≤ ‖β‖ ∏ᵢ ‖τᵢ‖ = ‖β‖` (operator norm). -/
theorem Submission.dpf_pfc_imrep_orient_abs_apply_le : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ β : Covector (Euclid P) n, |R.orient x β| ≤ ‖β‖ := by
  intro P n U R
  filter_upwards [R.orients] with x hx β
  -- `ξ(x)` is `±` evaluation at an orthonormal frame `τ`
  obtain ⟨Q, -, τ, hτ, -, hξ⟩ := hx
  have hβ : |β τ| ≤ ‖β‖ :=
    calc |β τ| = ‖β τ‖ := (Real.norm_eq_abs _).symm
      _ ≤ ‖β‖ * ∏ i, ‖τ i‖ := β.le_opNorm τ
      _ = ‖β‖ := by rw [Finset.prod_eq_one fun i _ => hτ.1 i, mul_one]
  rcases hξ with h | h
  · rw [h β]
    exact hβ
  · rw [h β, abs_neg]
    exact hβ

/-- **Pairing bound for `τ(M, θ, ξ)`** (the estimate behind Simon 6.2.24(2)).  If `F` is
`Hⁿ⌞M`-a.e. strongly measurable, vanishes off the compact `C ⊆ U` and `‖F‖ ≤ B`, then
`θ ⟨F, ξ⟩` is `Hⁿ⌞M`-integrable and `|∫_M θ ⟨F, ξ⟩ dHⁿ| ≤ B ∫_{M ∩ C} θ dHⁿ`.  By
`dpf_pfc_imrep_orient_abs_apply_le`, `|θ ⟨F, ξ⟩| ≤ B θ 1_C` a.e., and `θ 1_C` is integrable by
the local integrability of `θ`. -/
theorem Submission.dpf_pfc_imrep_pairing_integrable_abs_le : ∀ (P n : ℕ) (U C : Set (Euclid P)) (R : IMRep U n) (F : Euclid P → Covector (Euclid P) n) (B : ℝ), IsCompact C → C ⊆ U → AEStronglyMeasurable F (μHE[n].restrict R.carrier) → (∀ x, x ∉ C → F x = 0) → (∀ x, ‖F x‖ ≤ B) → Integrable (fun x => (R.mult x : ℝ) * R.orient x (F x)) (μHE[n].restrict R.carrier) ∧ |∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (F x) ∂μHE[n]| ≤ B * (∫⁻ x in R.carrier ∩ C, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal := by
  intro P n U C R F B hC hCU hF hF0 hFB
  -- Step 1: `C` is measurable; step 2: `θ` is measurable
  have hCm : MeasurableSet C := hC.isClosed.measurableSet
  have hθm : Measurable fun x => (R.mult x : ℝ) :=
    (measurable_from_nat (f := fun k : ℕ => (k : ℝ))).comp R.measurable_mult
  -- Step 3: `μ.restrict C = Hⁿ⌞(M ∩ C)`
  have hres : (μHE[n].restrict R.carrier).restrict C = μHE[n].restrict (R.carrier ∩ C) := by
    rw [Measure.restrict_restrict hCm, inter_comm]
  -- Step 4: `θ` is integrable on `C`, so `g = B · 1_C θ` is integrable
  have hθC : IntegrableOn (fun x => (R.mult x : ℝ)) C (μHE[n].restrict R.carrier) := by
    refine ⟨hθm.aestronglyMeasurable, ?_⟩
    rw [HasFiniteIntegral, hres]
    simpa using (R.locallyIntegrable_mult C hC hCU).lt_top
  have hg : Integrable (fun x => B * C.indicator (fun y => (R.mult y : ℝ)) x)
      (μHE[n].restrict R.carrier) :=
    ((integrable_indicator_iff hCm).2 hθC).const_mul B
  -- Step 5: `h = θ · ξ(F)` is a.e. strongly measurable
  have hh : AEStronglyMeasurable (fun x => (R.mult x : ℝ) * R.orient x (F x))
      (μHE[n].restrict R.carrier) :=
    hθm.aestronglyMeasurable.mul ((continuous_fst.clm_apply continuous_snd).comp_aestronglyMeasurable₂
      R.aestronglyMeasurable_orient hF)
  -- Step 6: `|h| ≤ g` a.e., by `orient_bound`
  have hdom : ∀ᵐ x ∂(μHE[n].restrict R.carrier),
      ‖(R.mult x : ℝ) * R.orient x (F x)‖ ≤ B * C.indicator (fun y => (R.mult y : ℝ)) x := by
    filter_upwards [Submission.dpf_pfc_imrep_orient_abs_apply_le P n U R] with x hx
    by_cases hxC : x ∈ C
    · rw [indicator_of_mem hxC, Real.norm_eq_abs, abs_mul, Nat.abs_cast, mul_comm B]
      exact mul_le_mul_of_nonneg_left ((hx (F x)).trans (hFB x)) (Nat.cast_nonneg _)
    · simp [indicator_of_notMem hxC, hF0 x hxC]
  -- Step 7: integrability
  refine ⟨hg.mono' hh hdom, ?_⟩
  -- Step 8: `∫ g dμ = B · (∫⁻_{M ∩ C} θ dHⁿ).toReal`
  have hgval : ∫ x, B * C.indicator (fun y => (R.mult y : ℝ)) x ∂(μHE[n].restrict R.carrier) =
      B * (∫⁻ x in R.carrier ∩ C, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal := by
    rw [integral_const_mul, integral_indicator hCm, hres,
      integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall fun x => Nat.cast_nonneg _)
        hθm.aestronglyMeasurable]
    simp
  -- Step 9: `|∫ h dμ| ≤ ∫ g dμ`
  rw [← Real.norm_eq_abs, ← hgval]
  exact norm_integral_le_of_norm_le hg hdom
/-- **Simon §6.1** (the test-form topology, the case `β = 0`): if `ωⱼ → 0` in `𝒟ⁿ(U)`, the
`ωⱼ` vanish outside one compact `C ⊆ U`, and `supₓ ‖ωⱼ(x)‖ → 0`.  The compact set is the one in
`TestFormOnConverges`; uniform convergence of the `0`-th iterated derivatives on `C` gives the
bound on `C`, and `ωⱼ = 0` off `C`. -/
theorem Submission.dpf_pfc_testFormOnConverges_zero_uniform : ∀ (P n : ℕ) (U : Set (Euclid P)) (ωs : ℕ → TestFormOn U n), TestFormOnConverges ωs 0 → ∃ C : Set (Euclid P), IsCompact C ∧ C ⊆ U ∧ (∀ j x, x ∉ C → (ωs j : DifferentialForm (Euclid P) n) x = 0) ∧ ∀ ε : ℝ, 0 < ε → ∀ᶠ j in atTop, ∀ x, ‖(ωs j : DifferentialForm (Euclid P) n) x‖ ≤ ε := by
  intro P n U ωs h
  obtain ⟨C, hC, hCU, hsupp, -, hderiv⟩ := h
  have hzero : ∀ j x, x ∉ C → (ωs j : DifferentialForm (Euclid P) n) x = 0 := fun j x hx =>
    image_eq_zero_of_notMem_tsupport fun hx' => hx (hsupp j hx')
  refine ⟨C, hC, hCU, hzero, fun ε hε => ?_⟩
  filter_upwards [Metric.tendstoUniformlyOn_iff.mp (hderiv 0) ε hε] with j hj x
  by_cases hx : x ∈ C
  · have hjx := hj x hx
    simp only [ZeroMemClass.coe_zero, iteratedFDeriv_zero, Pi.zero_apply, dist_zero_left,
      norm_iteratedFDeriv_zero] at hjx
    exact hjx.le
  · rw [hzero j x hx, norm_zero]
    exact hε.le
/-- **Push-forward of `τ(M, θ, ξ)` by a `C¹` map** (Simon 6.2.23–6.2.24(2), with a compact `K`
carrying `Hⁿ⌞M` in place of `B̄_t(y)`).  If `Hⁿ(M \ K) = 0`, `f` is `C¹` on an open `O ⊇ K` and
`f(K) ⊆ U`, then `Q(ω) = ∫_M θ ⟨ω(f x) ∘ Df(x), ξ⟩ dHⁿ` is a current in `U` with compact support
`spt Q ⊆ f(K)`.  With `‖Df‖ ≤ Λ` on `K`, `|θ ⟨ω(f x) ∘ Df(x), ξ⟩| ≤ ‖ω‖_∞ Λⁿ θ 1_K` a.e., so `Q` is
well defined, linear and `|Q(ω)| ≤ ‖ω‖_∞ Λⁿ ∫_{M ∩ K} θ dHⁿ`, which gives continuity; forms
vanishing on `f(K)` are killed by `Q`. -/
theorem Submission.dor_lmb_pc_pushforward_current_exists : ∀ (P n : ℕ) (U K O : Set (Euclid P)) (R : IMRep U n) (f : Euclid P → Euclid P), IsOpen U → IsCompact K → K ⊆ U → μHE[n] (R.carrier \ K) = 0 → IsOpen O → K ⊆ O → ContDiffOn ℝ 1 f O → f '' K ⊆ U → ∃ Q : GeometricCurrentOn U n, (∀ ω : TestFormOn U n, Q ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[n]) ∧ IsCompact Q.support ∧ Q.support ⊆ f '' K := by
  intro P n U K O R f hU hK hKU hnull hO hKO hf hfKU
  -- Step 1: `f` and `Df` are continuous on `O`, `f(K)` is compact and `‖Df‖ ≤ Λ` on `K`
  have hfc : ContinuousOn f O := hf.continuousOn
  have hdfc : ContinuousOn (fderiv ℝ f) O := hf.continuousOn_fderiv_of_isOpen hO le_rfl
  have hfK : IsCompact (f '' K) := hK.image_of_continuousOn (hfc.mono hKO)
  obtain ⟨Λ, hΛ0, hΛ⟩ : ∃ Λ : ℝ, 0 ≤ Λ ∧ ∀ x ∈ K, ‖fderiv ℝ f x‖ ≤ Λ := by
    obtain ⟨Λ, hΛ⟩ := hK.exists_bound_of_continuousOn (hdfc.mono hKO)
    exact ⟨max Λ 0, le_max_right _ _, fun x hx => (hΛ x hx).trans (le_max_left _ _)⟩
  -- Step 2: `Hⁿ⌞M` is carried by `K`
  have hKm : MeasurableSet K := hK.isClosed.measurableSet
  have hae : ∀ᵐ x ∂(μHE[n].restrict R.carrier), x ∈ K := by
    rw [ae_restrict_iff' R.measurableSet_carrier]
    filter_upwards [measure_eq_zero_iff_ae_notMem.1 hnull] with x hx hxM
    by_contra hxK
    exact hx ⟨hxM, hxK⟩
  -- Step 3: the pulled-back covector field `β_ω(x) = ω(f x) ∘ Df(x)` is continuous on `O`
  obtain ⟨β, hβ⟩ : ∃ β : TestFormOn U n → Euclid P → Covector (Euclid P) n, ∀ ω x,
      β ω x = ((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x) :=
    ⟨fun ω x => ((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap
      (fderiv ℝ f x), fun _ _ => rfl⟩
  have hcomp : Continuous fun p : Covector (Euclid P) n × (Euclid P →L[ℝ] Euclid P) =>
      p.1.compContinuousLinearMap p.2 :=
    continuous_iff_continuousAt.2 fun p =>
      (ContinuousAlternatingMap.hasStrictFDerivAt_compContinuousLinearMap p).hasFDerivAt.continuousAt
  have hβc : ∀ ω : TestFormOn U n, ContinuousOn (β ω) O := by
    intro ω
    have hω : Continuous (ω : DifferentialForm (Euclid P) n) := ContDiff.continuous ω.property.1.1
    have h : ContinuousOn (fun x => ((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap
        (fderiv ℝ f x)) O := hcomp.comp_continuousOn ((hω.comp_continuousOn hfc).prodMk hdfc)
    exact h.congr fun x _ => hβ ω x
  -- Step 4: `β_ω` is linear in `ω`
  have hβadd : ∀ (ω η : TestFormOn U n) x, β (ω + η) x = β ω x + β η x := by
    intro ω η x
    simp only [hβ]
    ext v
    simp
  have hβsmul : ∀ (c : ℝ) (ω : TestFormOn U n) x, β (c • ω) x = c • β ω x := by
    intro c ω x
    simp only [hβ]
    ext v
    simp
  -- Step 5: the truncation `1_K β_ω` is measurable, vanishes off `K` and `‖1_K β_ω‖ ≤ M Λⁿ`
  have hFm : ∀ ω : TestFormOn U n,
      AEStronglyMeasurable (K.indicator (β ω)) (μHE[n].restrict R.carrier) := fun ω =>
    (aestronglyMeasurable_indicator_iff hKm).2 (((hβc ω).mono hKO).aestronglyMeasurable hKm)
  have hFB : ∀ (ω : TestFormOn U n) (M : ℝ), (∀ z, ‖(ω : DifferentialForm (Euclid P) n) z‖ ≤ M) →
      ∀ x, ‖K.indicator (β ω) x‖ ≤ M * Λ ^ n := by
    intro ω M hM x
    have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
    by_cases hx : x ∈ K
    · rw [indicator_of_mem hx, hβ]
      calc ‖((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x)‖
          ≤ ‖(ω : DifferentialForm (Euclid P) n) (f x)‖ * ‖fderiv ℝ f x‖ ^ Fintype.card (Fin n) :=
            ContinuousAlternatingMap.norm_compContinuousLinearMap_le _ _
        _ ≤ M * Λ ^ n := by
            rw [Fintype.card_fin]
            exact mul_le_mul (hM _) (pow_le_pow_left₀ (norm_nonneg _) (hΛ x hx) n)
              (pow_nonneg (norm_nonneg _) n) hM0
    · rw [indicator_of_notMem hx, norm_zero]
      exact mul_nonneg hM0 (pow_nonneg hΛ0 n)
  -- Step 6: integrability and `|∫_M θ ⟨β_ω, ξ⟩| ≤ M Λⁿ ∫_{M ∩ K} θ`
  have hpair : ∀ (ω : TestFormOn U n) (M : ℝ),
      (∀ z, ‖(ω : DifferentialForm (Euclid P) n) z‖ ≤ M) →
      Integrable (fun x => (R.mult x : ℝ) * R.orient x (β ω x)) (μHE[n].restrict R.carrier) ∧
      |∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (β ω x) ∂μHE[n]| ≤
        M * Λ ^ n * (∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal := by
    intro ω M hM
    obtain ⟨hint, hle⟩ := Submission.dpf_pfc_imrep_pairing_integrable_abs_le P n U K R
      (K.indicator (β ω)) (M * Λ ^ n) hK hKU (hFm ω) (fun x hx => indicator_of_notMem hx _)
      (hFB ω M hM)
    have heq : (fun x => (R.mult x : ℝ) * R.orient x (K.indicator (β ω) x))
        =ᵐ[μHE[n].restrict R.carrier] fun x => (R.mult x : ℝ) * R.orient x (β ω x) := by
      filter_upwards [hae] with x hx
      rw [indicator_of_mem hx]
    exact ⟨hint.congr heq, by rwa [← integral_congr_ae heq]⟩
  have hint : ∀ ω : TestFormOn U n,
      Integrable (fun x => (R.mult x : ℝ) * R.orient x (β ω x)) (μHE[n].restrict R.carrier) := by
    intro ω
    obtain ⟨M, hM⟩ := (ContDiff.continuous ω.property.1.1).bounded_above_of_compact_support
      ω.property.1.2
    exact (hpair ω M hM).1
  -- Step 7: the linear functional `Q(ω) = ∫_M θ ⟨β_ω, ξ⟩ dHⁿ`
  let I : TestFormOn U n →ₗ[ℝ] ℝ :=
    { toFun := fun ω => ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (β ω x) ∂μHE[n]
      map_add' := fun ω η => by
        simp only [hβadd, map_add, mul_add]
        exact integral_add (hint ω) (hint η)
      map_smul' := fun c ω => by
        have h : ∀ x, (R.mult x : ℝ) * R.orient x (β (c • ω) x) =
            c * ((R.mult x : ℝ) * R.orient x (β ω x)) := by
          intro x
          rw [hβsmul, map_smul, smul_eq_mul]
          ring
        simp only [h, RingHom.id_apply, smul_eq_mul]
        exact integral_const_mul c _ }
  have hIapply : ∀ ω : TestFormOn U n,
      I ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (β ω x) ∂μHE[n] := fun _ => rfl
  -- Step 8: continuity, from `supₓ ‖ωⱼ(x)‖ → 0`
  have hcont : ∀ ωs : ℕ → TestFormOn U n, TestFormOnConverges ωs 0 →
      Tendsto (fun j => I (ωs j)) atTop (𝓝 0) := by
    intro ωs hωs
    obtain ⟨-, -, -, -, hunif⟩ := Submission.dpf_pfc_testFormOnConverges_zero_uniform P n U ωs hωs
    have hc : 0 ≤ (∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal :=
      ENNReal.toReal_nonneg
    have hA : 0 ≤ Λ ^ n * (∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal :=
      mul_nonneg (pow_nonneg hΛ0 n) hc
    rw [Metric.tendsto_nhds]
    intro δ hδ
    have hε : 0 < δ / (Λ ^ n * (∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal + 1) :=
      div_pos hδ (by linarith)
    filter_upwards [hunif _ hε] with j hj
    rw [Real.dist_eq, sub_zero, hIapply]
    calc |∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (β (ωs j) x) ∂μHE[n]|
        ≤ δ / (Λ ^ n * (∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal + 1) *
            Λ ^ n * (∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal :=
          (hpair (ωs j) _ hj).2
      _ = δ * (Λ ^ n * (∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal) /
            (Λ ^ n * (∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal + 1) := by
          ring
      _ < δ := by
          rw [div_lt_iff₀ (by linarith)]
          nlinarith
  let Q : GeometricCurrentOn U n := ⟨I, hcont⟩
  -- Step 9: `Q` kills every form vanishing near `f(K)`, so `spt Q ⊆ f(K)` is compact
  have hvan : ∀ ω : TestFormOn U n,
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (f '' K) → Q ω = 0 := by
    intro ω hω
    change I ω = 0
    rw [hIapply]
    apply integral_eq_zero_of_ae
    filter_upwards [hae] with x hx
    have hfx : (ω : DifferentialForm (Euclid P) n) (f x) = 0 :=
      image_eq_zero_of_notMem_tsupport (disjoint_right.1 hω (mem_image_of_mem f hx))
    have h0 : ((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap
        (fderiv ℝ f x) = 0 := by
      rw [hfx]
      ext v
      simp
    rw [Pi.zero_apply, hβ, h0, map_zero, mul_zero]
  obtain ⟨hsub, hcpt⟩ :=
    Submission.rsd_cmr_support_subset_of_vanish P n U (f '' K) Q hU hfK hfKU hvan
  refine ⟨Q, fun ω => ?_, hcpt, hsub⟩
  change I ω = _
  simp only [hIapply, hβ]
/-- **Simon 6.2.23–2.24 (2)–(3)** (chapter-06.txt lines 403–440): for a triple `R = (M, θ, ξ)` in
`U` and a `C¹` map `φ` equal to the identity off a compact `K ⊆ U`, the push-forward formula
`ω ↦ ∫_M θ(x) ⟨ω(φ(x)) ∘ Dφ(x), ξ(x)⟩ dHⁿ(x)` defines a current in `U`.  With `‖Dφ‖ ≤ Λ`, the
covector field `F_ω(x) = ω(φ(x)) ∘ Dφ(x)` is continuous, vanishes off the compact set
`tsupport ω ∪ K ⊆ U` and has `‖F_ω‖ ≤ sup ‖ω‖ · Λⁿ`; this gives integrability, hence linearity.
If `ωⱼ → 0`, then `F_{ωⱼ}` vanishes off a fixed compact `C ∪ K` and is eventually bounded by
`η Λⁿ`, which gives sequential continuity. -/
theorem Submission.dpf_pushforward_formula_current_exists : ∀ (P n : ℕ) (U K : Set (Euclid P)) (R : IMRep U n) (φ : Euclid P → Euclid P), IsCompact K → K ⊆ U → ContDiff ℝ 1 φ → (∀ x, x ∉ K → φ x = x) → ∃ S : GeometricCurrentOn U n, ∀ ω : TestFormOn U n, S ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (φ x)).compContinuousLinearMap (fderiv ℝ φ x)) ∂μHE[n] := by
  intro P n U K R φ hK hKU hφ hid
  -- step 1: `‖Dφ(x)‖ ≤ Λ` for every `x`
  obtain ⟨Λ, hΛ0, hΛ⟩ := Submission.dpf_pfc_fderiv_norm_le_of_eq_id_off_compact P K φ hK hφ hid
  -- the pulled-back covector field `F ω x = ω(φ(x)) ∘ Dφ(x)`
  set F : DifferentialForm (Euclid P) n → Euclid P → Covector (Euclid P) n :=
    fun ω x => (ω (φ x)).compContinuousLinearMap (fderiv ℝ φ x) with hFdef
  have hFcont : ∀ ω : DifferentialForm (Euclid P) n, Continuous ω → Continuous (F ω) := by
    intro ω hω
    have h := (ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM (𝕜 := ℝ)
      (ι := Fin n) (G := ℝ) |>.comp (hφ.continuous_fderiv one_ne_zero)).clm_apply
      (hω.comp hφ.continuous)
    simpa only [Function.comp_apply, ContinuousAlternatingMap.compContinuousLinearMapCLM_apply]
      using h
  -- step 2: `‖F ω‖ ≤ B Λⁿ` when `‖ω‖ ≤ B`
  have hFnorm : ∀ (ω : DifferentialForm (Euclid P) n) (B : ℝ), (∀ y, ‖ω y‖ ≤ B) →
      ∀ x, ‖F ω x‖ ≤ B * Λ ^ n := by
    intro ω B hB x
    calc ‖F ω x‖ ≤ ‖ω (φ x)‖ * ‖fderiv ℝ φ x‖ ^ n := by
          simpa only [Fintype.card_fin] using
            ContinuousAlternatingMap.norm_compContinuousLinearMap_le (ω (φ x)) (fderiv ℝ φ x)
      _ ≤ B * Λ ^ n := mul_le_mul (hB _) (pow_le_pow_left₀ (norm_nonneg _) (hΛ x) n)
          (pow_nonneg (norm_nonneg _) n) ((norm_nonneg _).trans (hB (φ x)))
  -- step 3: `F ω` vanishes off `C ∪ K` when `ω` vanishes off `C`
  have hFzero : ∀ (ω : DifferentialForm (Euclid P) n) (C : Set (Euclid P)),
      (∀ y, y ∉ C → ω y = 0) → ∀ x, x ∉ C ∪ K → F ω x = 0 := by
    intro ω C hC x hx
    rw [mem_union, not_or] at hx
    ext v
    simp [hFdef, hid x hx.2, hC x hx.1]
  -- `F ω x` is linear in `ω`
  have hFadd : ∀ (ω₁ ω₂ : DifferentialForm (Euclid P) n) x, F (ω₁ + ω₂) x = F ω₁ x + F ω₂ x := by
    intro ω₁ ω₂ x
    ext v
    simp [hFdef]
  have hFsmul : ∀ (c : ℝ) (ω : DifferentialForm (Euclid P) n) x, F (c • ω) x = c • F ω x := by
    intro c ω x
    ext v
    simp [hFdef]
  -- step 4: the integrand of a test form is integrable
  have hint : ∀ ω : TestFormOn U n, Integrable
      (fun x => (R.mult x : ℝ) * R.orient x (F (ω : DifferentialForm (Euclid P) n) x))
      (μHE[n].restrict R.carrier) := by
    intro ω
    have hωc : Continuous (ω : DifferentialForm (Euclid P) n) := ContDiff.continuous ω.property.1.1
    obtain ⟨B, hB⟩ := hωc.bounded_above_of_compact_support ω.property.1.2
    exact (Submission.dpf_pfc_imrep_pairing_integrable_abs_le P n U
      (tsupport (ω : DifferentialForm (Euclid P) n) ∪ K) R (F ω) (B * Λ ^ n)
      (ω.property.1.2.isCompact.union hK) (union_subset ω.property.2 hKU)
      (hFcont _ hωc).aestronglyMeasurable
      (hFzero _ _ fun y hy => image_eq_zero_of_notMem_tsupport hy) (hFnorm _ _ hB)).1
  -- step 5: the action is linear
  let S₀ : TestFormOn U n →ₗ[ℝ] ℝ :=
    { toFun := fun ω =>
        ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (F (ω : DifferentialForm (Euclid P) n) x)
          ∂μHE[n]
      map_add' := fun ω₁ ω₂ => by
        rw [← integral_add (hint ω₁) (hint ω₂)]
        congr 1
        ext x
        rw [Submodule.coe_add, hFadd, map_add, mul_add]
      map_smul' := fun c ω => by
        rw [RingHom.id_apply, smul_eq_mul, ← integral_const_mul]
        congr 1
        ext x
        rw [Submodule.coe_smul, hFsmul, map_smul, smul_eq_mul, mul_left_comm] }
  -- steps 6–7: sequential continuity, and the action is the push-forward formula by definition
  refine ⟨⟨S₀, fun ωs hωs => ?_⟩, fun ω => rfl⟩
  obtain ⟨C, hC, hCU, hCzero, hsmall⟩ :=
    Submission.dpf_pfc_testFormOnConverges_zero_uniform P n U ωs hωs
  set I : ℝ := (∫⁻ x in R.carrier ∩ (C ∪ K), (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal
  have hI : 0 ≤ Λ ^ n * I := mul_nonneg (pow_nonneg hΛ0 n) ENNReal.toReal_nonneg
  rw [Metric.tendsto_nhds]
  intro ε hε
  have hη : 0 < ε / (Λ ^ n * I + 1) := div_pos hε (by linarith)
  filter_upwards [hsmall _ hη] with j hj
  have hb := (Submission.dpf_pfc_imrep_pairing_integrable_abs_le P n U (C ∪ K) R
    (F (ωs j : DifferentialForm (Euclid P) n)) (ε / (Λ ^ n * I + 1) * Λ ^ n) (hC.union hK)
    (union_subset hCU hKU)
    (hFcont _ (ContDiff.continuous (ωs j).property.1.1)).aestronglyMeasurable
    (hFzero _ _ (hCzero j)) (hFnorm _ _ hj)).2
  rw [Real.dist_eq, sub_zero]
  calc |S₀ (ωs j)| ≤ ε / (Λ ^ n * I + 1) * Λ ^ n * I := hb
    _ = ε * (Λ ^ n * I / (Λ ^ n * I + 1)) := by ring
    _ < ε := mul_lt_of_lt_one_right hε ((div_lt_one (by linarith)).2 (lt_add_one _))
/-- **Pull-back of a test form by a compactly supported perturbation of the identity**
(Simon 6.2.23–6.2.24).  Let `K'` be compact and `ψ` a `C^∞` map with `ψ = id` off `K'`.  For a
test form `α ∈ 𝒟ᵈ`, the pull-back `ψ^#α(x) = α(ψ(x)) ∘ Dψ(x)` is a test form with
`spt ψ^#α ⊆ spt α ∪ K'`.  It is `C^∞` as `ψ^#α(x) = Φ(Dψ(x))(α(ψ(x)))`, where the precomposition
`Φ(L) = (γ ↦ γ ∘ L)` is analytic in `L`.  Off the closed compact set `spt α ∪ K'` we have
`ψ(z) = z` and `α(z) = 0`, so `ψ^#α(z) = 0`. -/
theorem Submission.dpf_pb_smooth_pullback_isTestForm : ∀ (P d : ℕ) (K' : Set (Euclid P)) (ψ : Euclid P → Euclid P) (α : DifferentialForm (Euclid P) d), IsCompact K' → ContDiff ℝ (⊤ : ℕ∞) ψ → (∀ x, x ∉ K' → ψ x = x) → IsTestForm α → IsTestForm (fun x => (α (ψ x)).compContinuousLinearMap (fderiv ℝ ψ x)) ∧ tsupport (fun x => (α (ψ x)).compContinuousLinearMap (fderiv ℝ ψ x)) ⊆ tsupport α ∪ K' := by
  intro P d K' ψ α hK hψ hfix hα
  -- `α` is `C^∞` with compact support
  obtain ⟨hαs, hαc⟩ := hα
  -- the precomposition `Φ(L) = (γ ↦ γ ∘ L)` on `d`-covectors is analytic, hence `C^∞`
  have hΦ : ContDiff ℝ (⊤ : ℕ∞) (ContinuousAlternatingMap.compContinuousLinearMapCLM :
      (Euclid P →L[ℝ] Euclid P) →
        (Euclid P [⋀^Fin d]→L[ℝ] ℝ) →L[ℝ] (Euclid P [⋀^Fin d]→L[ℝ] ℝ)) :=
    (ContinuousAlternatingMap.analyticOnNhd_compContinuousLinearMapCLM univ).contDiff
  -- `Dψ` and `α ∘ ψ` are `C^∞`, so `ψ^#α = Φ(Dψ)(α ∘ ψ)` is `C^∞`
  have hDψ : ContDiff ℝ (⊤ : ℕ∞) (fderiv ℝ ψ) := (contDiff_infty_iff_fderiv.mp hψ).2
  have hαψ : ContDiff ℝ (⊤ : ℕ∞) (fun x => α (ψ x)) := hαs.comp hψ
  have hsmooth : IsSmoothForm (fun x => (α (ψ x)).compContinuousLinearMap (fderiv ℝ ψ x)) :=
    (hΦ.comp hDψ).clm_apply hαψ
  -- off the closed set `spt α ∪ K'`, `ψ(z) = z` and `α(z) = 0`, so `ψ^#α(z) = 0`
  have hsupp : tsupport (fun x => (α (ψ x)).compContinuousLinearMap (fderiv ℝ ψ x)) ⊆
      tsupport α ∪ K' := by
    refine closure_minimal ?_ ((isClosed_tsupport α).union hK.isClosed)
    intro z hz
    by_contra hzF
    rw [mem_union, not_or] at hzF
    refine Function.mem_support.mp hz ?_
    show (α (ψ z)).compContinuousLinearMap (fderiv ℝ ψ z) = 0
    rw [hfix z hzF.2, image_eq_zero_of_notMem_tsupport hzF.1]
    ext v
    simp
  -- `spt ψ^#α` is a closed subset of the compact set `spt α ∪ K'`
  exact ⟨⟨hsmooth, (IsCompact.union hαc hK).of_isClosed_subset (isClosed_tsupport _) hsupp⟩,
    hsupp⟩
/-- **Dominated convergence for pulled-back integrals** (Simon 6.2.23–6.2.24, the limit step in the
push-forward by a `C¹` map).  Let `R = (M, θ, ξ)` be an integer multiplicity triple in `U`, `α` a
continuous `n`-form with compact support in `U`, and `ψₖ` `C¹` maps equal to the identity off the
compact `K' ⊆ U`, with `‖Dψₖ‖ ≤ C`, `ψₖ → φ` and `Dψₖ → Dφ` pointwise.  Then
`∫_M θ ⟨α(ψₖ)∘Dψₖ, ξ⟩ dHⁿ → ∫_M θ ⟨α(φ)∘Dφ, ξ⟩ dHⁿ`: the integrands are dominated by
`A Cⁿ θ 1_{spt α ∪ K'}` (`‖α‖ ≤ A`, `|ξ(γ)| ≤ ‖γ‖` a.e.), which is integrable since `θ` is locally
`Hⁿ⌞M`-integrable in `U`. -/
theorem Submission.dpf_pb_imrep_pullback_integral_tendsto : ∀ (P n : ℕ) (U K' : Set (Euclid P)) (R : IMRep U n) (α : DifferentialForm (Euclid P) n) (ψ : ℕ → Euclid P → Euclid P) (φ : Euclid P → Euclid P) (C : ℝ), IsCompact K' → K' ⊆ U → Continuous α → HasCompactSupport α → tsupport α ⊆ U → (∀ k, ContDiff ℝ 1 (ψ k)) → (∀ k x, x ∉ K' → ψ k x = x) → (∀ k x, ‖fderiv ℝ (ψ k) x‖ ≤ C) → (∀ x, Tendsto (fun k => ψ k x) atTop (𝓝 (φ x))) → (∀ x, Tendsto (fun k => fderiv ℝ (ψ k) x) atTop (𝓝 (fderiv ℝ φ x))) → Tendsto (fun k => ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x ((α (ψ k x)).compContinuousLinearMap (fderiv ℝ (ψ k) x)) ∂μHE[n]) atTop (𝓝 (∫ x in R.carrier, (R.mult x : ℝ) * R.orient x ((α (φ x)).compContinuousLinearMap (fderiv ℝ φ x)) ∂μHE[n])) := by
  intro P n U K' R α ψ φ C hK' hK'U hα hαc hαU hψ hψid hψC hψφ hDψ
  -- `C₀ = spt α ∪ K'` is compact, closed (hence measurable) and contained in `U`
  have hC₀ : IsCompact (tsupport α ∪ K') := hαc.isCompact.union hK'
  have hC₀m : MeasurableSet (tsupport α ∪ K') := hC₀.isClosed.measurableSet
  -- `‖α‖ ≤ A` everywhere, so `0 ≤ A`
  obtain ⟨A, hA⟩ := hα.bounded_above_of_compact_support hαc
  have hA0 : 0 ≤ A := (norm_nonneg _).trans (hA 0)
  -- `θ` is measurable
  have hθm : Measurable fun x => (R.mult x : ℝ) := measurable_from_nat.comp R.measurable_mult
  -- orientation bound: `|ξ(x)(γ)| = |γ(τ)| ≤ ‖γ‖ ∏ ‖τᵢ‖ = ‖γ‖` for `Hⁿ⌞M`-a.e. `x`
  have hξ : ∀ᵐ x ∂μHE[n].restrict R.carrier, ∀ γ : Covector (Euclid P) n,
      |R.orient x γ| ≤ ‖γ‖ := by
    filter_upwards [R.orients] with x ⟨Q, _, τ, hτ, _, hor⟩ γ
    have hγ : |γ τ| ≤ ‖γ‖ := by
      have h := γ.le_opNorm τ
      simp only [hτ.1, Finset.prod_const_one, mul_one] at h
      rwa [Real.norm_eq_abs] at h
    rcases hor with h | h
    · rw [h γ]; exact hγ
    · rw [h γ, abs_neg]; exact hγ
  -- `x ↦ α(ψₖ(x))∘Dψₖ(x)` is continuous
  have hβ : ∀ k, Continuous fun x =>
      (α (ψ k x)).compContinuousLinearMap (fderiv ℝ (ψ k) x) := by
    intro k
    have h1 : Continuous fun x => (ContinuousAlternatingMap.compContinuousLinearMapCLM
        (fderiv ℝ (ψ k) x) : Covector (Euclid P) n →L[ℝ] Covector (Euclid P) n) :=
      ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM.comp
        ((hψ k).continuous_fderiv one_ne_zero)
    exact h1.clm_apply (hα.comp (hψ k).continuous)
  refine tendsto_integral_of_dominated_convergence
    ((tsupport α ∪ K').indicator fun x => A * C ^ n * (R.mult x : ℝ)) ?_ ?_ ?_ ?_
  · -- each integrand is a.e. strongly measurable
    intro k
    refine hθm.aestronglyMeasurable.mul ?_
    have hev : Continuous fun p : MultiVector P n × Covector (Euclid P) n => p.1 p.2 :=
      isBoundedBilinearMap_apply.continuous
    exact Continuous.comp_aestronglyMeasurable₂
      (g := fun (L : MultiVector P n) (v : Covector (Euclid P) n) => L v) hev
      R.aestronglyMeasurable_orient (hβ k).aestronglyMeasurable
  · -- the bound `A Cⁿ θ 1_{C₀}` is integrable, as `θ` is integrable on `M ∩ C₀`
    refine IntegrableOn.integrable_indicator ?_ hC₀m
    refine Integrable.const_mul ?_ _
    show Integrable _ ((μHE[n].restrict R.carrier).restrict (tsupport α ∪ K'))
    rw [Measure.restrict_restrict hC₀m, inter_comm]
    refine ⟨hθm.aestronglyMeasurable, ?_⟩
    show ∫⁻ x in R.carrier ∩ (tsupport α ∪ K'), ‖(R.mult x : ℝ)‖ₑ ∂μHE[n] < ∞
    simp only [Real.enorm_natCast]
    exact lt_top_iff_ne_top.2 (R.locallyIntegrable_mult _ hC₀ (union_subset hαU hK'U))
  · -- domination `|hₖ| ≤ A Cⁿ θ 1_{C₀}` a.e.
    intro k
    filter_upwards [hξ] with x hx
    by_cases hxC : x ∈ tsupport α ∪ K'
    · rw [indicator_of_mem hxC]
      have hβle : ‖(α (ψ k x)).compContinuousLinearMap (fderiv ℝ (ψ k) x)‖ ≤ A * C ^ n := by
        refine (ContinuousAlternatingMap.norm_compContinuousLinearMap_le _ _).trans ?_
        rw [Fintype.card_fin]
        exact mul_le_mul (hA _) (pow_le_pow_left₀ (norm_nonneg _) (hψC k x) n)
          (pow_nonneg (norm_nonneg _) n) hA0
      rw [norm_mul, Real.norm_natCast, Real.norm_eq_abs]
      calc (R.mult x : ℝ) * |R.orient x ((α (ψ k x)).compContinuousLinearMap (fderiv ℝ (ψ k) x))|
          ≤ (R.mult x : ℝ) * (A * C ^ n) :=
            mul_le_mul_of_nonneg_left ((hx _).trans hβle) (Nat.cast_nonneg _)
        _ = A * C ^ n * (R.mult x : ℝ) := mul_comm _ _
    · -- off `C₀`: `ψₖ(x) = x` and `α(x) = 0`, so the integrand vanishes
      rw [indicator_of_notMem hxC]
      have hxK : x ∉ K' := fun h => hxC (Or.inr h)
      have hxα : x ∉ tsupport α := fun h => hxC (Or.inl h)
      have h0 : (0 : Covector (Euclid P) n).compContinuousLinearMap (fderiv ℝ (ψ k) x) = 0 :=
        map_zero (ContinuousAlternatingMap.compContinuousLinearMapCLM (fderiv ℝ (ψ k) x))
      rw [hψid k x hxK, image_eq_zero_of_notMem_tsupport hxα, h0, map_zero, mul_zero, norm_zero]
  · -- pointwise convergence, by continuity of `α`, of `L ↦ (· ∘ L)` and of evaluation
    refine Eventually.of_forall fun x => ?_
    refine tendsto_const_nhds.mul (((R.orient x).continuous.tendsto _).comp ?_)
    have h1 : Tendsto (fun k => (ContinuousAlternatingMap.compContinuousLinearMapCLM
        (fderiv ℝ (ψ k) x) : Covector (Euclid P) n →L[ℝ] Covector (Euclid P) n)) atTop
        (𝓝 (ContinuousAlternatingMap.compContinuousLinearMapCLM (fderiv ℝ φ x))) :=
      (ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM.tendsto _).comp (hDψ x)
    have h2 : Tendsto (fun k => α (ψ k x)) atTop (𝓝 (α (φ x))) := (hα.tendsto _).comp (hψφ x)
    exact (isBoundedBilinearMap_apply.continuous.tendsto _).comp (h1.prodMk_nhds h2)
/-- Simon 6.2.24(1), reduction from `C¹` to smooth maps (step 3 of the push-forward proof): a `C¹`
map `φ` of `ℝᴾ` with `φ = id` off the compact set `K ⊆ U` is the pointwise `C¹` limit of `C^∞`
maps `ψₖ` that equal `id` off one compact `K' ⊆ U` and have uniformly bounded differentials.
`K' = cthickening δ K ⊆ U` and `ψₖ = id + ρₖ ⋆ (φ − id)`, `ρₖ` a normalized smooth bump supported
in `B_{δ/(k+2)}(0)`; then `Dψₖ = I + ρₖ ⋆ D(φ − id)`, so `‖Dψₖ‖ ≤ 1 + sup ‖D(φ − id)‖`, and the
mollifications of the continuous `φ − id` and `D(φ − id)` converge pointwise. -/
theorem Submission.dpf_smooth_approx_compact_perturbation : ∀ (P : ℕ) (U K : Set (Euclid P)) (φ : Euclid P → Euclid P), IsOpen U → IsCompact K → K ⊆ U → ContDiff ℝ 1 φ → (∀ x, x ∉ K → φ x = x) → ∃ (ψ : ℕ → Euclid P → Euclid P) (K' : Set (Euclid P)) (C : ℝ), IsCompact K' ∧ K' ⊆ U ∧ (∀ k, ContDiff ℝ (⊤ : ℕ∞) (ψ k)) ∧ (∀ k x, x ∉ K' → ψ k x = x) ∧ (∀ k x, ‖fderiv ℝ (ψ k) x‖ ≤ C) ∧ (∀ x, Tendsto (fun k => ψ k x) atTop (𝓝 (φ x))) ∧ ∀ x, Tendsto (fun k => fderiv ℝ (ψ k) x) atTop (𝓝 (fderiv ℝ φ x)) := by
  intro P U K φ hU hK hKU hφ hfix
  -- Step 1: a margin `δ > 0` with `K' = cthickening δ K ⊆ U`
  obtain ⟨δ, hδ, hδU⟩ := hK.exists_cthickening_subset_open hU hKU
  -- Step 2: the perturbation `g = φ - id` is `C¹` and vanishes off `K`; `‖Dg‖ ≤ A`
  obtain ⟨g, hg⟩ : ∃ g : Euclid P → Euclid P, ∀ x, g x = φ x - x := ⟨fun x => φ x - x, fun _ => rfl⟩
  have hgφ : g = fun x => φ x - x := funext hg
  have hg1 : ContDiff ℝ 1 g := by
    rw [hgφ]
    exact hφ.sub contDiff_id
  have hgK : ∀ x, x ∉ K → g x = 0 := fun x hx => by rw [hg, hfix x hx, sub_self]
  have hgcs : HasCompactSupport g := HasCompactSupport.intro hK hgK
  have hgc : Continuous g := hg1.continuous
  have hDgc : Continuous (fderiv ℝ g) := hg1.continuous_fderiv one_ne_zero
  have hDg : ∀ x, fderiv ℝ g x = fderiv ℝ φ x - ContinuousLinearMap.id ℝ (Euclid P) := by
    intro x
    rw [hgφ]
    exact (((hφ.differentiable one_ne_zero) x).hasFDerivAt.sub (hasFDerivAt_id x)).fderiv
  obtain ⟨A, hA⟩ := hDgc.bounded_above_of_compact_support (hgcs.fderiv ℝ)
  have hA0 : 0 ≤ A := (norm_nonneg _).trans (hA 0)
  -- Step 3: nonnegative smooth `ρ k` with `∫ ρ k = 1`, supported in `ball 0 (r k)`, where
  -- `r k = δ / (k + 2)`: the bump `β k` with `rOut = r k`, divided by its integral
  obtain ⟨r, hr0, hrδ, hrlim⟩ : ∃ r : ℕ → ℝ, (∀ k, 0 < r k) ∧ (∀ k, r k ≤ δ) ∧
      Tendsto r atTop (𝓝 0) := by
    refine ⟨fun k => δ / ((k : ℝ) + 2), fun k => by positivity, fun k => ?_, ?_⟩
    · exact div_le_self hδ.le (by linarith [(Nat.cast_nonneg k : (0 : ℝ) ≤ k)])
    · exact tendsto_const_nhds.div_atTop
        (tendsto_atTop_add_const_right _ 2 tendsto_natCast_atTop_atTop)
  obtain ⟨ρ, hρs, hρn, hρi, hρsupp⟩ : ∃ ρ : ℕ → Euclid P → ℝ,
      (∀ k, ContDiff ℝ (⊤ : ℕ∞) (ρ k)) ∧ (∀ k x, 0 ≤ ρ k x) ∧ (∀ k, ∫ x, ρ k x = 1) ∧
      (∀ k, support (ρ k) ⊆ ball 0 (r k)) := by
    let β : ∀ k, ContDiffBump (0 : Euclid P) := fun k =>
      ⟨r k / 2, r k, half_pos (hr0 k), half_lt_self (hr0 k)⟩
    have hβi : ∀ k, 0 < ∫ x, β k x := fun k => by
      rw [integral_pos_iff_support_of_nonneg (fun x => (β k).nonneg)
        ((β k).continuous.integrable_of_hasCompactSupport (β k).hasCompactSupport),
        (β k).support_eq]
      exact measure_ball_pos _ _ (hr0 k)
    refine ⟨fun k x => (∫ y, β k y)⁻¹ * β k x, fun k => contDiff_const.mul (β k).contDiff,
      fun k x => mul_nonneg (inv_nonneg.2 (hβi k).le) (β k).nonneg, fun k => ?_,
      fun k x hx => ?_⟩
    · rw [integral_const_mul, inv_mul_cancel₀ (hβi k).ne']
    · have hx' : x ∈ support (β k) := right_ne_zero_of_mul hx
      rwa [(β k).support_eq] at hx'
  have hρc : ∀ k, HasCompactSupport (ρ k) := fun k =>
    HasCompactSupport.intro (isCompact_closedBall 0 (r k)) fun x hx =>
      notMem_support.1 fun h => hx (ball_subset_closedBall (hρsupp k h))
  have hρloc : ∀ k, LocallyIntegrable (ρ k) volume := fun k => (hρs k).continuous.locallyIntegrable
  have hsmall : Tendsto (fun k => support (ρ k)) atTop (𝓝 (0 : Euclid P)).smallSets := by
    rw [tendsto_smallSets_iff]
    intro t ht
    obtain ⟨ε, hε, hεt⟩ := Metric.mem_nhds_iff.1 ht
    filter_upwards [(tendsto_order.1 hrlim).2 ε hε] with k hk
    exact (hρsupp k).trans ((ball_subset_ball hk.le).trans hεt)
  -- Steps 4 and 6: `ψ k = id + ρ k ⋆ g` has derivative `I + ρ k ⋆ Dg` (the `precompR`
  -- convolution of `hasFDerivAt_convolution_right` is the scalar one)
  have hL : (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] Euclid P →L[ℝ] Euclid P).precompR (Euclid P) =
      (ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] (Euclid P →L[ℝ] Euclid P) →L[ℝ] (Euclid P →L[ℝ] Euclid P)) := by
    ext a f v
    simp [ContinuousLinearMap.precompR]
  have hderiv : ∀ k x, HasFDerivAt
      (fun y => y + convolution (ρ k) g (ContinuousLinearMap.lsmul ℝ ℝ) volume y)
      (ContinuousLinearMap.id ℝ (Euclid P) +
        convolution (ρ k) (fderiv ℝ g) (ContinuousLinearMap.lsmul ℝ ℝ) volume x) x := by
    intro k x
    have h := hgcs.hasFDerivAt_convolution_right (ContinuousLinearMap.lsmul ℝ ℝ) (hρloc k) hg1 x
    rw [hL] at h
    exact (hasFDerivAt_id x).add h
  -- Step 5: off `K'`, `g = 0` on `ball x (r k)`, so `(ρ k ⋆ g) x = 0`
  have hsupp : ∀ k x, x ∉ cthickening δ K →
      convolution (ρ k) g (ContinuousLinearMap.lsmul ℝ ℝ) volume x = 0 := by
    intro k x hx
    have hgy : ∀ y ∈ ball x (r k), g y = 0 := fun y hy => hgK y fun hyK =>
      hx (mem_cthickening_of_dist_le x y δ K hyK ((mem_ball'.1 hy).le.trans (hrδ k)))
    rw [convolution_eq_right' _ (hρsupp k) fun y hy =>
      (hgy y hy).trans (hgy x (mem_ball_self (hr0 k))).symm, hgy x (mem_ball_self (hr0 k))]
    simp
  refine ⟨fun k x => x + convolution (ρ k) g (ContinuousLinearMap.lsmul ℝ ℝ) volume x,
    cthickening δ K, 1 + A, hK.cthickening, hδU, fun k => ?_, fun k x hx => ?_, fun k x => ?_,
    fun x => ?_, fun x => ?_⟩
  · exact contDiff_id.add
      ((hρc k).contDiff_convolution_left (ContinuousLinearMap.lsmul ℝ ℝ) (hρs k)
        hgc.locallyIntegrable)
  · simp only [hsupp k x hx, add_zero]
  · -- Step 6: `‖Dψ k‖ ≤ ‖I‖ + sup ‖Dg‖ ≤ 1 + A`
    rw [(hderiv k x).fderiv]
    refine (norm_add_le _ _).trans (add_le_add ContinuousLinearMap.norm_id_le ?_)
    have h := dist_convolution_le (x₀ := x) (z₀ := 0) (μ := volume) hA0 (hρsupp k) (hρn k) (hρi k)
      hDgc.aestronglyMeasurable fun y _ => by rw [dist_zero_right]; exact hA y
    rwa [dist_zero_right] at h
  · -- Step 7: `ψ k x → x + g x = φ x`
    have h := convolution_tendsto_right (μ := volume) (φ := ρ) (g := fun _ => g)
      (k := fun _ => x) (Eventually.of_forall hρn) (Eventually.of_forall hρi) hsmall
      (Eventually.of_forall fun _ => hgc.aestronglyMeasurable) ((hgc.tendsto x).comp tendsto_snd)
      tendsto_const_nhds
    have h2 := (tendsto_const_nhds : Tendsto (fun _ : ℕ => x) atTop (𝓝 x)).add h
    rwa [hg x, add_sub_cancel] at h2
  · -- Step 7: `Dψ k x → I + Dg x = Dφ x`
    have h := convolution_tendsto_right (μ := volume) (φ := ρ) (g := fun _ => fderiv ℝ g)
      (k := fun _ => x) (Eventually.of_forall hρn) (Eventually.of_forall hρi) hsmall
      (Eventually.of_forall fun _ => hDgc.aestronglyMeasurable)
      ((hDgc.tendsto x).comp tendsto_snd) tendsto_const_nhds
    have h2 := (tendsto_const_nhds : Tendsto (fun _ : ℕ => ContinuousLinearMap.id ℝ (Euclid P))
      atTop (𝓝 (ContinuousLinearMap.id ℝ (Euclid P)))).add h
    rw [hDg x, add_sub_cancel] at h2
    exact h2.congr fun k => ((hderiv k x).fderiv).symm

/-- Simon 6.2.24(1), `∂f_#T = f_#∂T`, for the `C¹` push-forward formula of 6.2.24(2) (step 3
of the push-forward proof): if `T = τ(M, θ, ξ)` has `∂T = 0` in `U` and
`S(ω) = ∫_M θ ⟨ω(φ(x)) ∘ Dφ(x), ξ⟩ dHⁿ`, where the `C¹` map `φ` is the identity off a compact
`K ⊆ U`, then `∂S = 0` in `U`.  Take `C^∞` maps `ψₖ`, equal to the identity off one compact
`K' ⊆ U`, with `‖Dψₖ‖ ≤ C`, `ψₖ → φ` and `Dψₖ → Dφ` pointwise.  For `η ∈ 𝒟ⁿ⁻¹(U)`,
`ψₖ^#η ∈ 𝒟ⁿ⁻¹(U)` and `d(ψₖ^#η) = ψₖ^#(dη)`, so `0 = ∂T(ψₖ^#η) = ∫_M θ ⟨ψₖ^#(dη), ξ⟩ dHⁿ`;
by dominated convergence these integrals tend to `S(dη) = ∂S(η)`. -/
theorem Submission.dpf_pushforward_formula_boundaryVanishes : ∀ (P n : ℕ) (U K : Set (Euclid P)) (T S : GeometricCurrentOn U n) (R : IMRep U n) (φ : Euclid P → Euclid P), IsOpen U → R.Represents T → IsCompact K → K ⊆ U → ContDiff ℝ 1 φ → (∀ x, x ∉ K → φ x = x) → (∀ ω : TestFormOn U n, S ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (φ x)).compContinuousLinearMap (fderiv ℝ φ x)) ∂μHE[n]) → BoundaryVanishes T → BoundaryVanishes S := by
  intro P n U K T S R φ hU hRT hK hKU hφ hφK hS hT
  -- Step 1: `∂ = 0` in degree `0`; for `n = m + 1` show `∂S(η) = S(dη) = 0` for every `η`
  rcases n with _ | m
  · trivial
  change T.boundary = 0 at hT
  change S.boundary = 0
  -- Step 2: `C^∞` maps `ψₖ = id` off a compact `K' ⊆ U`, `‖Dψₖ‖ ≤ C`, `ψₖ → φ`, `Dψₖ → Dφ`
  obtain ⟨ψ, K', C, hK', hK'U, hψ, hψK', hψC, hψφ, hDψφ⟩ :=
    Submission.dpf_smooth_approx_compact_perturbation P U K φ hU hK hKU hφ hφK
  ext η
  rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.zero_apply, hS]
  -- the test form `α = dη ∈ 𝒟ⁿ(U)`
  set α : DifferentialForm (Euclid P) (m + 1) :=
    (exteriorDerivativeTestOn U m η : DifferentialForm (Euclid P) (m + 1))
  have hα : IsTestForm α ∧ tsupport α ⊆ U := (exteriorDerivativeTestOn U m η).property
  -- Steps 3–5: `∫_M θ ⟨ψₖ^#α, ξ⟩ dHⁿ = ∂T(ψₖ^#η) = 0` for every `k`
  have hI : ∀ k, ∫ x in R.carrier, (R.mult x : ℝ) *
      R.orient x ((α (ψ k x)).compContinuousLinearMap (fderiv ℝ (ψ k) x)) ∂μHE[m + 1] = 0 := by
    intro k
    -- Step 3: `ψₖ^#η` is a test form supported in `tsupport η ∪ K' ⊆ U`
    obtain ⟨hηk, hηkK⟩ := Submission.dpf_pb_smooth_pullback_isTestForm P m K' (ψ k)
      (η : DifferentialForm (Euclid P) m) hK' (hψ k) (hψK' k) η.property.1
    let ηk : TestFormOn U m :=
      ⟨fun x => ((η : DifferentialForm (Euclid P) m) (ψ k x)).compContinuousLinearMap
        (fderiv ℝ (ψ k) x), hηk, hηkK.trans (union_subset η.property.2 hK'U)⟩
    -- Step 4: `d(ψₖ^#η) = ψₖ^#(dη)` (Simon 6.1.14; Mathlib `extDeriv_pullback`)
    have hnat : (exteriorDerivativeTestOn U m ηk : DifferentialForm (Euclid P) (m + 1)) =
        fun x => (α (ψ k x)).compContinuousLinearMap (fderiv ℝ (ψ k) x) := by
      funext x
      exact extDeriv_pullback (η.property.1.1.differentiable (by simp)).differentiableAt
        (hψ k).contDiffAt (by simp)
    -- Step 5: `0 = ∂T(ψₖ^#η) = T(d(ψₖ^#η)) = ∫_M θ ⟨ψₖ^#α, ξ⟩ dHⁿ`
    have h0 : T (exteriorDerivativeTestOn U m ηk) = 0 := by
      rw [← GeometricCurrentOn.boundary_apply, hT, GeometricCurrentOn.zero_apply]
    rw [hRT, IMRep.action, hnat] at h0
    exact h0
  -- Step 6: dominated convergence, `∫_M θ ⟨ψₖ^#α, ξ⟩ dHⁿ → ∫_M θ ⟨φ^#α, ξ⟩ dHⁿ = S(dη)`
  have hlim := Submission.dpf_pb_imrep_pullback_integral_tendsto P (m + 1) U K' R α ψ φ C hK'
    hK'U hα.1.1.continuous hα.1.2 hα.2 (fun k => (hψ k).of_le (by exact_mod_cast le_top)) hψK'
    hψC hψφ hDψφ
  -- Step 7: the limit of the vanishing integrals is `0`
  exact tendsto_nhds_unique hlim (tendsto_const_nhds.congr fun k => (hI k).symm)
/-- **Image measure comparison** (image representation of the diffeomorphism push-forward, used
for Simon 7.1.2).  If `φ` is `Λ`-Lipschitz and `ψ` is a measurable left inverse of `φ`, then
`ψ_#(Hⁿ⌞φ(S)) ≤ Λⁿ Hⁿ⌞S` for every set `S`, not assumed measurable.  For Borel `A`,
`ψ⁻¹(A) ∩ φ(S) = φ(A ∩ S)`, and `Hⁿ(φ(A ∩ S)) ≤ Λⁿ Hⁿ(A ∩ S)` (Simon Ch. 2, 1.8(i)). -/
theorem Submission.dpfir_ii_map_restrict_image_le_smul : ∀ (P n : ℕ) (φ ψ : Euclid P → Euclid P) (Λ : NNReal) (S : Set (Euclid P)), LipschitzWith Λ φ → Measurable ψ → LeftInverse ψ φ → (μHE[n].restrict (φ '' S)).map ψ ≤ ((Λ : ℝ≥0∞) ^ n) • μHE[n].restrict S := by
  intro P n φ ψ Λ S hφ hψ hψφ
  refine Measure.le_iff.2 fun A hA => ?_
  -- `ψ⁻¹(A) ∩ φ(S) = φ(A ∩ S)`, as `ψ ∘ φ = id`
  have hset : ψ ⁻¹' A ∩ φ '' S = φ '' (A ∩ S) := by
    ext y
    constructor
    · rintro ⟨hy, x, hx, rfl⟩
      exact ⟨x, ⟨by rwa [mem_preimage, hψφ x] at hy, hx⟩, rfl⟩
    · rintro ⟨x, ⟨hxA, hxS⟩, rfl⟩
      exact ⟨by rwa [mem_preimage, hψφ x], x, hxS, rfl⟩
  -- both sides are values of `μHE[n]`; no measurability of `S` or `φ '' S` is needed
  rw [Measure.map_apply hψ hA, Measure.restrict_apply (hψ hA), hset, Measure.smul_apply,
    Measure.restrict_apply hA, smul_eq_mul]
  exact Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
    hφ.lipschitzOnWith
/-- Lipschitz images of countably `n`-rectifiable sets are countably `n`-rectifiable (used in
Simon Ch. 6, 3.6–3.7; Ch. 3, Definition 1.1).  If `M ⊆ M₀ ∪ ⋃ⱼ Fⱼ(ℝⁿ)` with `Hⁿ(M₀) = 0` and each
`Fⱼ` Lipschitz, then `φ(M) ⊆ φ(M₀) ∪ ⋃ⱼ (φ ∘ Fⱼ)(ℝⁿ)`, where `Hⁿ(φ(M₀)) ≤ Λⁿ Hⁿ(M₀) = 0`
(Simon Ch. 2, Theorem 1.8(i)) and `φ ∘ Fⱼ` is `Λ Kⱼ`-Lipschitz. -/
theorem Submission.dpfir_ii_countablyRectifiable_image_of_lipschitz : ∀ (P n : ℕ) (M : Set (Euclid P)) (φ : Euclid P → Euclid P) (Λ : NNReal), LipschitzWith Λ φ → CountablyRectifiable n M → CountablyRectifiable n (φ '' M) := by
  intro P n M φ Λ hφ hM
  -- `M ⊆ M₀ ∪ ⋃ⱼ Fⱼ(ℝⁿ)` with `Hⁿ(M₀) = 0` and each `Fⱼ` Lipschitz
  obtain ⟨M₀, hM₀, F, hF, hMsub⟩ := hM
  refine ⟨φ '' M₀, ?_, fun j => φ ∘ F j, fun j => ?_, ?_⟩
  · -- `Hⁿ(φ(M₀)) ≤ Λⁿ Hⁿ(M₀) = 0`
    have h := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
      (hφ.lipschitzOnWith (s := M₀))
    rw [hM₀, mul_zero] at h
    exact nonpos_iff_eq_zero.1 h
  · -- `φ ∘ Fⱼ` is `Λ Kⱼ`-Lipschitz
    obtain ⟨K, hK⟩ := hF j
    exact ⟨Λ * K, hφ.comp hK⟩
  · -- `φ(M) ⊆ φ(M₀) ∪ ⋃ⱼ (φ ∘ Fⱼ)(ℝⁿ)`
    rintro _ ⟨x, hx, rfl⟩
    rcases hMsub hx with hx₀ | hxF
    · exact Or.inl (mem_image_of_mem φ hx₀)
    · obtain ⟨j, v, rfl⟩ := mem_iUnion.1 hxF
      exact Or.inr (mem_iUnion.2 ⟨j, v, rfl⟩)

/-- **Bi-Lipschitz image of an integer multiplicity triple** (image representation of the
diffeomorphism push-forward, used for Simon 7.1.2; cf. Simon 6.3.6–3.9 for injective `f`).  Let
`R = (M, θ, ξ)` be a triple in `U` and `φ : ℝᴾ → ℝᴾ` a bijection that is `Λ`-Lipschitz and
`Λ`-antilipschitz with `φ⁻¹(U) = U`.  If `η` is `Hⁿ⌞M`-a.e. strongly measurable and, for
`Hⁿ`-a.e. `x ∈ M`, `η(x)` orients the approximate tangent space of `φ(M)` at `φ(x)`, then
`(φ(M), θ ∘ φ⁻¹, η ∘ φ⁻¹)` is a triple in `U`.  The inverse `ψ = φ⁻¹` is `Λ`-Lipschitz, and
`ψ_#(Hⁿ⌞φ(S)) ≤ Λⁿ Hⁿ⌞S` makes `ψ` quasi-measure-preserving from `Hⁿ⌞φ(M)` to `Hⁿ⌞M` and gives
`∫_{φ(M) ∩ K} θ ∘ ψ dHⁿ ≤ Λⁿ ∫_{M ∩ φ⁻¹(K)} θ dHⁿ`. -/
theorem Submission.dpfir_bilipschitz_image_imrep_exists : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (φ : Euclid P → Euclid P) (Λ : NNReal) (η : Euclid P → MultiVector P n), Bijective φ → LipschitzWith Λ φ → AntilipschitzWith Λ φ → φ ⁻¹' U = U → AEStronglyMeasurable η (μHE[n].restrict R.carrier) → (∀ᵐ x ∂(μHE[n].restrict R.carrier), ∃ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n (φ '' R.carrier) (φ x) Q ∧ IsUnitOrientationOf (η x) Q) → ∃ R' : IMRep U n, R'.carrier = φ '' R.carrier ∧ ∀ x, R'.mult (φ x) = R.mult x ∧ R'.orient (φ x) = η x := by
  intro P n U R φ Λ η hφ hφL hφA hU hη hηQ
  -- the two-sided inverse `ψ` of `φ` is `Λ`-Lipschitz, hence continuous and measurable
  obtain ⟨ψ, hleft, hright⟩ : ∃ ψ : Euclid P → Euclid P, LeftInverse ψ φ ∧ RightInverse ψ φ :=
    ⟨invFun φ, leftInverse_invFun hφ.1, rightInverse_invFun hφ.2⟩
  have hψc : Continuous ψ := (hφA.to_rightInverse hright).continuous
  have hψm : Measurable ψ := hψc.measurable
  have hθm : Measurable fun x => (R.mult x : ℝ≥0∞) :=
    (measurable_from_nat (f := fun k : ℕ => (k : ℝ≥0∞))).comp R.measurable_mult
  -- `ψ_#(Hⁿ⌞φ(M)) ≤ Λⁿ Hⁿ⌞M`: `ψ` is quasi-measure-preserving from `Hⁿ⌞φ(M)` to `Hⁿ⌞M`
  have hqmp : Measure.QuasiMeasurePreserving ψ (μHE[n].restrict (φ '' R.carrier))
      (μHE[n].restrict R.carrier) :=
    ⟨hψm, Measure.absolutelyContinuous_of_le_smul
      (Submission.dpfir_ii_map_restrict_image_le_smul P n φ ψ Λ R.carrier hφL hψm hleft)⟩
  -- (a) `φ(M) = ψ⁻¹(M)` is Borel
  have hmeas : MeasurableSet (φ '' R.carrier) := by
    rw [image_eq_preimage_of_inverse hleft hright]
    exact hψm R.measurableSet_carrier
  -- (b) `φ(M) ⊆ φ(U) = U`, as `U = φ⁻¹(U)`
  have hsub : φ '' R.carrier ⊆ U := image_subset_iff.2 (R.carrier_subset.trans hU.symm.subset)
  -- (e) `θ(ψ(φ(x))) = θ(x) > 0` on `M`
  have hpos : ∀ y ∈ φ '' R.carrier, 0 < R.mult (ψ y) := by
    rintro _ ⟨x, hx, rfl⟩
    rw [hleft x]
    exact R.mult_pos x hx
  -- (f) `∫_{φ(M) ∩ K} θ ∘ ψ dHⁿ ≤ Λⁿ ∫_{M ∩ φ⁻¹(K)} θ dHⁿ < ∞`, with `φ⁻¹(K) = ψ(K) ⊆ U` compact
  have hint : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
      ∫⁻ y in φ '' R.carrier ∩ K, (R.mult (ψ y) : ℝ≥0∞) ∂μHE[n] ≠ ∞ := by
    intro K hK hKU
    have hK' : IsCompact (φ ⁻¹' K) := by
      rw [← image_eq_preimage_of_inverse (f := ψ) (g := φ) hright hleft]
      exact hK.image hψc
    have hK'U : φ ⁻¹' K ⊆ U := (preimage_mono hKU).trans hU.subset
    have hle : ∫⁻ y in φ '' (R.carrier ∩ φ ⁻¹' K), (R.mult (ψ y) : ℝ≥0∞) ∂μHE[n] ≤
        (Λ : ℝ≥0∞) ^ n * ∫⁻ x in R.carrier ∩ φ ⁻¹' K, (R.mult x : ℝ≥0∞) ∂μHE[n] :=
      calc ∫⁻ y in φ '' (R.carrier ∩ φ ⁻¹' K), (R.mult (ψ y) : ℝ≥0∞) ∂μHE[n]
          = ∫⁻ x, (R.mult x : ℝ≥0∞) ∂((μHE[n].restrict (φ '' (R.carrier ∩ φ ⁻¹' K))).map ψ) :=
            (lintegral_map hθm hψm).symm
        _ ≤ ∫⁻ x, (R.mult x : ℝ≥0∞)
              ∂(((Λ : ℝ≥0∞) ^ n) • μHE[n].restrict (R.carrier ∩ φ ⁻¹' K)) :=
            lintegral_mono' (Submission.dpfir_ii_map_restrict_image_le_smul P n φ ψ Λ _ hφL hψm
              hleft) le_rfl
        _ = (Λ : ℝ≥0∞) ^ n * ∫⁻ x in R.carrier ∩ φ ⁻¹' K, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
            rw [lintegral_smul_measure, smul_eq_mul]
    rw [← image_inter_preimage]
    exact ne_top_of_le_ne_top (ENNReal.mul_ne_top (ENNReal.pow_ne_top ENNReal.coe_ne_top)
      (R.locallyIntegrable_mult _ hK' hK'U)) hle
  -- (h) the orientation hypothesis at `ψ(y)`, with `φ(ψ(y)) = y`
  have horients : ∀ᵐ y ∂(μHE[n].restrict (φ '' R.carrier)), ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n (φ '' R.carrier) y Q ∧ IsUnitOrientationOf (η (ψ y)) Q := by
    filter_upwards [hqmp.ae hηQ] with y hy
    obtain ⟨Q, hQ, hηy⟩ := hy
    rw [hright y] at hQ
    exact ⟨Q, hQ, hηy⟩
  refine ⟨{ carrier := φ '' R.carrier
            mult := fun y => R.mult (ψ y)
            orient := fun y => η (ψ y)
            measurableSet_carrier := hmeas
            carrier_subset := hsub
            -- (c) Lipschitz images of countably `n`-rectifiable sets are rectifiable
            rectifiable :=
              Submission.dpfir_ii_countablyRectifiable_image_of_lipschitz P n R.carrier φ Λ hφL
                R.rectifiable
            -- (d) `θ ∘ ψ` is measurable
            measurable_mult := R.measurable_mult.comp hψm
            mult_pos := hpos
            locallyIntegrable_mult := hint
            -- (g) a.e. strong measurability transfers along `ψ`
            aestronglyMeasurable_orient := hη.comp_quasiMeasurePreserving hqmp
            orients := horients }, rfl, fun x => ⟨?_, ?_⟩⟩
  · exact congrArg R.mult (hleft x)
  · exact congrArg η (hleft x)
/-- **Pairing with a continuous covector field** (Simon Ch. 6, 3.1 (‡), 6.2.24(3)).  For an
integer multiplicity triple `R = (M, θ, ξ)` in `U` and a continuous `β : ℝᴾ → Λⁿ(ℝᴾ)` with
compact support `K = spt β ⊆ U`, `x ↦ θ(x) ⟨β(x), ξ(x)⟩` is `Hⁿ⌞M`-integrable: `ξ = ±τ₁ ∧ ⋯ ∧ τₙ`
with `τ` orthonormal `Hⁿ`-a.e. on `M`, so `|⟨α, ξ(x)⟩| ≤ ‖α‖`, and the integrand is dominated by
`C θ 1_K` (`C` a bound for `‖β‖`), which is integrable because `∫_{M ∩ K} θ dHⁿ < ∞`. -/
theorem Submission.dpfir_imrep_pairing_continuous_integrable : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (β : Euclid P → Covector (Euclid P) n), Continuous β → HasCompactSupport β → tsupport β ⊆ U → Integrable (fun x => (R.mult x : ℝ) * R.orient x (β x)) (μHE[n].restrict R.carrier) := by
  intro P n U R β hβ hcpt hU
  set K : Set (Euclid P) := tsupport β
  /- Step 1: `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ` with `τ` orthonormal gives `|⟨α, ξ(x)⟩| = |α(τ)| ≤ ‖α‖`
  for `Hⁿ`-a.e. `x ∈ M`. -/
  have hξ : ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n,
      ‖R.orient x α‖ ≤ ‖α‖ := by
    filter_upwards [R.orients] with x hx α
    obtain ⟨Q, -, τ, hτ, -, hor⟩ := hx
    have hατ : ‖α τ‖ ≤ ‖α‖ := by
      simpa [hτ.norm_eq_one] using α.le_opNorm τ
    rcases hor with h | h
    · rw [h]
      exact hατ
    · rw [h, norm_neg]
      exact hατ
  /- Step 2: `β` is bounded by some `C` and vanishes off the compact, hence Borel, set
  `K = spt β ⊆ U`. -/
  obtain ⟨C, hC⟩ := hβ.bounded_above_of_compact_support hcpt
  have hKm : MeasurableSet K := (isClosed_tsupport β).measurableSet
  /- Step 3: `|θ ⟨β, ξ⟩| ≤ C θ 1_K` a.e. on `M`. -/
  have hbound : ∀ᵐ x ∂(μHE[n].restrict R.carrier),
      ‖(R.mult x : ℝ) * R.orient x (β x)‖ ≤ C * K.indicator (fun x => (R.mult x : ℝ)) x := by
    filter_upwards [hξ] with x hx
    by_cases hxK : x ∈ K
    · rw [indicator_of_mem hxK, norm_mul, Real.norm_natCast, mul_comm C]
      exact mul_le_mul_of_nonneg_left ((hx (β x)).trans (hC x)) (Nat.cast_nonneg _)
    · rw [indicator_of_notMem hxK, image_eq_zero_of_notMem_tsupport hxK, map_zero]
      simp
  /- Step 4: `C θ 1_K` is integrable, since `∫_{M ∩ K} θ dHⁿ < ∞`. -/
  have hθm : Measurable fun x => (R.mult x : ℝ) := measurable_from_nat.comp R.measurable_mult
  have hθK : IntegrableOn (fun x => (R.mult x : ℝ)) K (μHE[n].restrict R.carrier) := by
    refine ⟨hθm.aestronglyMeasurable, ?_⟩
    rw [hasFiniteIntegral_iff_enorm, Measure.restrict_restrict hKm, inter_comm]
    simpa only [Real.enorm_natCast] using (R.locallyIntegrable_mult K hcpt hU).lt_top
  have hg : Integrable (fun x => C * K.indicator (fun x => (R.mult x : ℝ)) x)
      (μHE[n].restrict R.carrier) := (hθK.integrable_indicator hKm).const_mul C
  /- Step 5: the integrand is a.e. strongly measurable: `θ` is measurable, `ξ` is a.e. strongly
  measurable, `β` is continuous and evaluation `(ζ, α) ↦ ζ(α)` is continuous. -/
  have happly : Continuous fun p : MultiVector P n × Covector (Euclid P) n => p.1 p.2 :=
    continuous_fst.clm_apply continuous_snd
  have hF : AEStronglyMeasurable (fun x => (R.mult x : ℝ) * R.orient x (β x))
      (μHE[n].restrict R.carrier) :=
    hθm.aestronglyMeasurable.mul (happly.comp_aestronglyMeasurable
      (R.aestronglyMeasurable_orient.prodMk hβ.aestronglyMeasurable))
  /- Step 6: dominated by an integrable function. -/
  exact hg.mono' hF hbound
/-- **Area identity to Bochner integrals** (image representation of the diffeomorphism
push-forward, used for Simon 7.1.2).  Let `J ≥ 0` and `∫⁻ g dν = ∫⁻ J(x) g(φ(x)) dμ(x)` for every
`g : ℝᴾ → [0, ∞]`.  If `h` is `ν`-a.e. strongly measurable, `f` is `μ`-integrable and
`J(x) h(φ(x)) = f(x)` for `μ`-a.e. `x`, then `h` is `ν`-integrable and `∫ h dν = ∫ f dμ`.
Multiplication by `J(x) ≥ 0` commutes with `|·|`, `t⁺` and `t⁻`; apply the identity to `g = |h|`,
`h⁺`, `h⁻` and use `∫ F = ∫⁻ F⁺ − ∫⁻ F⁻`. -/
theorem Submission.dpfir_integral_eq_of_area_lintegral : ∀ (P : ℕ) (μ ν : Measure (Euclid P)) (φ : Euclid P → Euclid P) (J h f : Euclid P → ℝ), (∀ x, 0 ≤ J x) → (∀ g : Euclid P → ℝ≥0∞, ∫⁻ y, g y ∂ν = ∫⁻ x, ENNReal.ofReal (J x) * g (φ x) ∂μ) → AEStronglyMeasurable h ν → Integrable f μ → (∀ᵐ x ∂μ, J x * h (φ x) = f x) → Integrable h ν ∧ ∫ y, h y ∂ν = ∫ x, f x ∂μ := by
  intro P μ ν φ J h f hJ harea hh hf hfh
  -- the identity for `g = |h|ₑ`, `ofReal h`, `ofReal (-h)`; the integrands agree `μ`-a.e.
  have habs : ∫⁻ y, ‖h y‖ₑ ∂ν = ∫⁻ x, ‖f x‖ₑ ∂μ := by
    refine (harea fun y => ‖h y‖ₑ).trans (lintegral_congr_ae ?_)
    filter_upwards [hfh] with x hx
    rw [← hx, enorm_mul, Real.enorm_eq_ofReal (hJ x)]
  have hpos : ∫⁻ y, ENNReal.ofReal (h y) ∂ν = ∫⁻ x, ENNReal.ofReal (f x) ∂μ := by
    refine (harea fun y => ENNReal.ofReal (h y)).trans (lintegral_congr_ae ?_)
    filter_upwards [hfh] with x hx
    rw [← hx, ENNReal.ofReal_mul (hJ x)]
  have hneg : ∫⁻ y, ENNReal.ofReal (-h y) ∂ν = ∫⁻ x, ENNReal.ofReal (-f x) ∂μ := by
    refine (harea fun y => ENNReal.ofReal (-h y)).trans (lintegral_congr_ae ?_)
    filter_upwards [hfh] with x hx
    rw [← hx, ← mul_neg, ENNReal.ofReal_mul (hJ x)]
  -- `h` is `ν`-integrable, and `∫ F = (∫⁻ F⁺) - (∫⁻ F⁻)` on both sides
  have hint : Integrable h ν :=
    ⟨hh, hasFiniteIntegral_iff_enorm.2 (habs ▸ hasFiniteIntegral_iff_enorm.1 hf.hasFiniteIntegral)⟩
  refine ⟨hint, ?_⟩
  rw [integral_eq_lintegral_pos_part_sub_lintegral_neg_part hint,
    integral_eq_lintegral_pos_part_sub_lintegral_neg_part hf, hpos, hneg]
/-- **The chosen approximate tangent plane** (Simon Ch. 3, Remark 1.5(1), used for 7.1.2).  If `Q`
is an approximate tangent space of `M` at `x` (Ch. 3, 1.4), then `approxTangentPlane n M x = Q`:
`Q` witnesses the existential in its definition, so it returns the chosen plane, which is an
approximate tangent space of `M` at `x` and hence equals `Q` by uniqueness. -/
theorem Submission.dpf_itt_approxTangentPlane_eq : ∀ (P n : ℕ) (M : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)), HasApproximateTangentSpaceAt n M x Q → approxTangentPlane n M x = Q := by
  intro P n M x Q hQ
  have h : ∃ Q', HasApproximateTangentSpaceAt n M x Q' := ⟨Q, hQ⟩
  unfold approxTangentPlane
  rw [dite_eq_left h]
  exact h.choose_spec.unique hQ
/-- **Bi-Lipschitz images of Borel, locally `Hⁿ`-finite subsets of `U`** (Simon 6.3.7, the image
`φ(M)` in the push-forward of `τ(M, θ, ξ)` by a diffeomorphism, used in 7.1.2).  If `M ⊆ U` is
Borel with `Hⁿ(M ∩ C) < ∞` for every compact `C ⊆ U`, and `φ : ℝᴾ → ℝᴾ` is `Λ`-Lipschitz and
`Λ'`-antilipschitz with `φ⁻¹(U) = U`, then `φ(M)` is Borel (Lusin–Souslin: `φ` is continuous and
injective), `φ(M) ⊆ U`, and `Hⁿ(φ(M) ∩ C) ≤ Λⁿ Hⁿ(M ∩ φ⁻¹(C)) < ∞` for every compact `C ⊆ U`,
because `φ⁻¹(C)` is closed and bounded, hence a compact subset of `φ⁻¹(U) = U`. -/
theorem Submission.dpf_itt_bilipschitz_image_locfin : ∀ (P n : ℕ) (U M : Set (Euclid P)) (φ : Euclid P → Euclid P) (Λ Λ' : NNReal), MeasurableSet M → M ⊆ U → (∀ C : Set (Euclid P), IsCompact C → C ⊆ U → μHE[n] (M ∩ C) ≠ ∞) → LipschitzWith Λ φ → AntilipschitzWith Λ' φ → φ ⁻¹' U = U → MeasurableSet (φ '' M) ∧ φ '' M ⊆ U ∧ ∀ C : Set (Euclid P), IsCompact C → C ⊆ U → μHE[n] (φ '' M ∩ C) ≠ ∞ := by
  intro P n U M φ Λ Λ' hM hMU hfin hL hA hU
  -- Step 1: `φ` is continuous (Lipschitz) and injective (antilipschitz)
  have hcont : Continuous φ := hL.continuous
  have hinj : Injective φ := hA.injective
  -- Step 2: `φ(M)` is Borel by the Lusin–Souslin theorem
  refine ⟨hM.image_of_continuousOn_injOn hcont.continuousOn hinj.injOn, ?_, ?_⟩
  -- Step 3: `φ(M) ⊆ U`, since `M ⊆ U = φ⁻¹(U)`
  · rintro _ ⟨x, hx, rfl⟩
    have hx' : x ∈ φ ⁻¹' U := by
      rw [hU]
      exact hMU hx
    exact hx'
  · intro C hC hCU
    -- Step 4: `K = φ⁻¹(C)` is closed and bounded, hence compact, and `K ⊆ φ⁻¹(U) = U`
    have hK : IsCompact (φ ⁻¹' C) :=
      Metric.isCompact_of_isClosed_isBounded (hC.isClosed.preimage hcont)
        (hA.isBounded_preimage hC.isBounded)
    have hKU : φ ⁻¹' C ⊆ U := by
      rw [← hU]
      exact preimage_mono hCU
    have hMK : μHE[n] (M ∩ φ ⁻¹' C) ≠ ∞ := hfin _ hK hKU
    -- Step 5: `Hⁿ(φ(S)) ≤ Λⁿ Hⁿ(S)`, since `μHE[n] = c • μH[n]` for a constant `c`
    have hn : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    have hle (S : Set (Euclid P)) : μHE[n] (φ '' S) ≤ (Λ : ℝ≥0∞) ^ (n : ℝ) * μHE[n] S := by
      simp only [Measure.euclideanHausdorffMeasure_def, Measure.smul_apply, ENNReal.smul_def,
        smul_eq_mul]
      calc _ ≤ _ * ((Λ : ℝ≥0∞) ^ (n : ℝ) * μH[n] S) :=
            mul_le_mul_right (hL.hausdorffMeasure_image_le hn S) _
        _ = _ := by ring
    -- Step 6: `φ(M) ∩ C = φ(M ∩ K)`, so `Hⁿ(φ(M) ∩ C) ≤ Λⁿ Hⁿ(M ∩ K) < ∞`
    rw [← image_inter_preimage]
    exact ne_top_of_le_ne_top
      (ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg hn ENNReal.coe_ne_top) hMK) (hle _)
/-- Composing a bi-Lipschitz immersed piece `F` with a bi-Lipschitz immersion `φ` of `ℝᴾ`:
`φ ∘ F` is `ΛL`-Lipschitz, bounded below on `B` by `m' = m / (Λ' + 1)`, differentiable on `B` with
injective derivative `D(φ ∘ F)(a) = Dφ(F a) ∘ DF(a)` (chain rule), and so
`range D(φ ∘ F)(a) = Dφ(F a)(range DF(a))`. -/
theorem Submission.dpf_itt_comp_bilipschitz_piece : ∀ (P n : ℕ) (F : Euclid n → Euclid P) (φ : Euclid P → Euclid P) (B : Set (Euclid n)) (L Λ Λ' : NNReal) (m : ℝ), LipschitzWith L F → 0 < m → (∀ a ∈ B, ∀ a' ∈ B, m * ‖a - a'‖ ≤ ‖F a - F a'‖) → (∀ a ∈ B, DifferentiableAt ℝ F a ∧ Injective (fderiv ℝ F a)) → Differentiable ℝ φ → (∀ x, Injective (fderiv ℝ φ x)) → LipschitzWith Λ φ → AntilipschitzWith Λ' φ → LipschitzWith (Λ * L) (φ ∘ F) ∧ (∃ m' : ℝ, 0 < m' ∧ ∀ a ∈ B, ∀ a' ∈ B, m' * ‖a - a'‖ ≤ ‖(φ ∘ F) a - (φ ∘ F) a'‖) ∧ (∀ a ∈ B, DifferentiableAt ℝ (φ ∘ F) a ∧ Injective (fderiv ℝ (φ ∘ F) a)) ∧ ∀ a ∈ B, LinearMap.range (fderiv ℝ (φ ∘ F) a : Euclid n →ₗ[ℝ] Euclid P) = Submodule.map (fderiv ℝ φ (F a) : Euclid P →ₗ[ℝ] Euclid P) (LinearMap.range (fderiv ℝ F a : Euclid n →ₗ[ℝ] Euclid P)) := by
  intro P n F φ B L Λ Λ' m hF hm hlow hdiff hφ hφinj hφL hφA
  refine ⟨hφL.comp hF, ⟨m / ((Λ' : ℝ) + 1), div_pos hm (by positivity), fun a ha a' ha' => ?_⟩,
    fun a ha => ⟨(hφ (F a)).comp a (hdiff a ha).1, ?_⟩, fun a ha => ?_⟩
  · have h1 : ‖F a - F a'‖ ≤ (Λ' : ℝ) * ‖φ (F a) - φ (F a')‖ := by
      simpa only [dist_eq_norm] using hφA.le_mul_dist (F a) (F a')
    rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity), comp_apply, comp_apply]
    nlinarith [hlow a ha a' ha', norm_nonneg (φ (F a) - φ (F a'))]
  · rw [fderiv_comp a (hφ (F a)) (hdiff a ha).1, ContinuousLinearMap.coe_comp]
    exact (hφinj (F a)).comp (hdiff a ha).2
  · rw [fderiv_comp a (hφ (F a)) (hdiff a ha).1, ContinuousLinearMap.toLinearMap_comp]
    exact LinearMap.range_comp _ _
/-- **A.e. transfer through Lipschitz pieces** (step 6 of the image tangent transport).  Let
`M ⊆ ℝᴾ` be Borel with `Hⁿ(M \ ⋃ᵢ Fᵢ(Bᵢ)) = 0` for Lipschitz `Fᵢ : ℝⁿ → ℝᴾ`.  If `p (Fᵢ b)` holds
for Lebesgue-a.e. `b ∈ Bᵢ`, then `p x` holds for `Hⁿ`-a.e. `x ∈ M`: the bad parameters
`Nᵢ ⊆ Bᵢ` are Lebesgue-null, so `Hⁿ(Fᵢ(Nᵢ)) ≤ Lᵢⁿ Hⁿ(Nᵢ) = 0` (`Hⁿ = Lⁿ` on `ℝⁿ`), and every
`x ∈ M` with `¬p x` lies in `(M \ ⋃ᵢ Fᵢ(Bᵢ)) ∪ ⋃ᵢ Fᵢ(Nᵢ)`. -/
theorem Submission.dpf_itt_ae_of_ae_pieces : ∀ (P n : ℕ) (M : Set (Euclid P)) (F : ℕ → Euclid n → Euclid P) (B : ℕ → Set (Euclid n)) (p : Euclid P → Prop), MeasurableSet M → (∀ i, ∃ L : NNReal, LipschitzWith L (F i)) → μHE[n] (M \ ⋃ i, F i '' B i) = 0 → (∀ i, ∀ᵐ b ∂(volume.restrict (B i)), p (F i b)) → ∀ᵐ x ∂(μHE[n].restrict M), p x := by
  intro P n M F B p hM hF hcov hp
  -- `μHE[n] = c • μH[n]` with `c ≠ 0`
  have hc := Measure.addHaarScalarFactor_volume_hausdorffMeasure_ne_zero n
  -- the bad parameters `Nᵢ = {b ∈ Bᵢ | ¬p (Fᵢ b)}` have `μHE[n]`-null images
  have hnull : ∀ i, μHE[n] (F i '' {b | ¬(b ∈ B i → p (F i b))}) = 0 := by
    intro i
    obtain ⟨L, hL⟩ := hF i
    have hN : μHE[n] {b | ¬(b ∈ B i → p (F i b))} = 0 := by
      rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
      exact ae_iff.mp (ae_imp_of_ae_restrict (hp i))
    rw [Measure.euclideanHausdorffMeasure_def, Measure.smul_apply, smul_eq_zero] at hN ⊢
    exact Or.inr (le_zero_iff.mp ((hL.hausdorffMeasure_image_le (Nat.cast_nonneg n) _).trans_eq
      (by rw [hN.resolve_left hc, mul_zero])))
  -- every bad point of `M` lies in `(M \ ⋃ᵢ Fᵢ(Bᵢ)) ∪ ⋃ᵢ Fᵢ(Nᵢ)`
  rw [ae_restrict_iff' hM, ae_iff]
  refine measure_mono_null (fun x hx => ?_) (measure_union_null hcov (measure_iUnion_null hnull))
  obtain ⟨hxM, hpx⟩ := not_imp.mp hx
  by_cases hxU : x ∈ ⋃ i, F i '' B i
  · obtain ⟨i, b, hb, rfl⟩ := mem_iUnion.mp hxU
    exact Or.inr (mem_iUnion.mpr ⟨i, b, fun h => hpx (h hb), rfl⟩)
  · exact Or.inl ⟨hxM, hxU⟩
/-- **Splitting `∫_{φ(M)}` along a Borel decomposition of `M`.**  Let `Aᵢ ⊆ M` (`i ∈ ℕ`) be
pairwise disjoint Borel sets with `Hⁿ(M \ ⋃ᵢ Aᵢ) = 0`, and let `φ : ℝᴾ → ℝᴾ` be injective and
`Λ`-Lipschitz.  Then `∫_{φ(M)} g dHⁿ = Σᵢ ∫_{φ(Aᵢ)} g dHⁿ` for every `g : ℝᴾ → [0, ∞]`.  The
`φ(Aᵢ)` are Borel (Lusin–Souslin) and pairwise disjoint, `⋃ᵢ φ(Aᵢ) ⊆ φ(M)`, and
`φ(M) \ ⋃ᵢ φ(Aᵢ) ⊆ φ(M \ ⋃ᵢ Aᵢ)` has `Hⁿ`-measure `≤ Λⁿ · 0` (Simon Ch. 2, 1.8(i)). -/
theorem Submission.dpf_raf_lintegral_image_eq_tsum_pieces : ∀ (P n : ℕ) (M : Set (Euclid P)) (A : ℕ → Set (Euclid P)) (φ : Euclid P → Euclid P) (Λ : NNReal), (∀ i, MeasurableSet (A i)) → (∀ i, A i ⊆ M) → Pairwise (fun i j => Disjoint (A i) (A j)) → μHE[n] (M \ ⋃ i, A i) = 0 → LipschitzWith Λ φ → Injective φ → ∀ g : Euclid P → ℝ≥0∞, ∫⁻ y in φ '' M, g y ∂μHE[n] = ∑' i, ∫⁻ y in φ '' A i, g y ∂μHE[n] := by
  intro P n M A φ Λ hA hAM hdisj hnull hφ hinj g
  -- each `φ(Aᵢ)` is Borel: `φ` is continuous and injective (Lusin–Souslin)
  have hmeas : ∀ i, MeasurableSet (φ '' A i) := fun i =>
    (hA i).image_of_continuousOn_injOn hφ.continuous.continuousOn hinj.injOn
  -- the `φ(Aᵢ)` are pairwise disjoint, as `φ` is injective
  have hdisj' : Pairwise (Disjoint on fun i => φ '' A i) := fun i j hij =>
    (disjoint_image_iff hinj).mpr (hdisj hij)
  -- `⋃ᵢ φ(Aᵢ) ⊆ φ(M)`
  have hsub : (⋃ i, φ '' A i) ⊆ φ '' M := iUnion_subset fun i => image_mono (hAM i)
  -- `φ(M) \ ⋃ᵢ φ(Aᵢ) ⊆ φ(M \ ⋃ᵢ Aᵢ)`, which is `Hⁿ`-null by the Lipschitz image bound
  have hdiff : φ '' M \ ⋃ i, φ '' A i ⊆ φ '' (M \ ⋃ i, A i) := by
    rintro y ⟨⟨x, hxM, rfl⟩, hy⟩
    refine ⟨x, ⟨hxM, fun hx => hy ?_⟩, rfl⟩
    obtain ⟨i, hi⟩ := mem_iUnion.mp hx
    exact mem_iUnion.mpr ⟨i, mem_image_of_mem φ hi⟩
  have hnull' : μHE[n] (φ '' M \ ⋃ i, φ '' A i) = 0 := by
    refine measure_mono_null hdiff (le_antisymm ?_ zero_le)
    calc μHE[n] (φ '' (M \ ⋃ i, A i)) ≤ (Λ : ℝ≥0∞) ^ n * μHE[n] (M \ ⋃ i, A i) :=
          Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
            hφ.lipschitzOnWith
      _ = 0 := by rw [hnull, mul_zero]
  -- so `φ(M) = ⋃ᵢ φ(Aᵢ)` `Hⁿ`-a.e., and the integral is countably additive over the `φ(Aᵢ)`
  have hae : φ '' M =ᵐ[μHE[n]] ⋃ i, φ '' A i :=
    ae_eq_set.mpr ⟨hnull', by rw [sdiff_eq_empty.mpr hsub, measure_empty]⟩
  rw [setLIntegral_congr hae, lintegral_iUnion hmeas hdisj' g]
/-- **Area formula on one injective Lipschitz piece** (Simon Ch. 3, 2.3–2.6, used for the
diffeomorphism push-forward in 7.1.2).  Let `F : ℝⁿ → ℝᴾ` be Lipschitz and injective on the Borel
set `B`, let `φ : ℝᴾ → ℝᴾ` be differentiable, Lipschitz and injective on `F(B)`, and let
`Q(F(b)) = range DF(b)` for a.e. `b ∈ B`.  With `e` the standard orthonormal basis of `Q(x)` and
`J(x) = √det(Dφ(x)eₐ · Dφ(x)e_b)`, every `g ≥ 0` has
`∫_{φ(F(B))} g dHⁿ = ∫_{F(B)} J(x) g(φ(x)) dHⁿ(x)`.  Apply the Lipschitz area formula to `φ ∘ F`
and to `F`; a.e. on `B` the chain rule and `normDet (S ∘ T) = normDet (S|_{range T}) · normDet T`
give `J_{φ∘F}(b) = J(F(b)) J_F(b)`, and `normDet (S|_V)² = det(S eₐ · S e_b)` (Gram). -/
theorem Submission.dpf_raf_piece_area_formula_gram : ∀ (P n : ℕ) (Q : Euclid P → Submodule ℝ (Euclid P)) (φ : Euclid P → Euclid P) (Λ : NNReal) (F : Euclid n → Euclid P) (L : NNReal) (B : Set (Euclid n)), Differentiable ℝ φ → LipschitzWith Λ φ → LipschitzWith L F → MeasurableSet B → InjOn F B → InjOn φ (F '' B) → (∀ᵐ b ∂(volume.restrict B), Q (F b) = LinearMap.range (fderiv ℝ F b : Euclid n →ₗ[ℝ] Euclid P)) → ∀ g : Euclid P → ℝ≥0∞, ∫⁻ y in φ '' (F '' B), g y ∂μHE[n] = ∫⁻ x in F '' B, ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ (Q x)) => inner ℝ (fderiv ℝ φ x (stdOrthonormalBasis ℝ (Q x) i)) (fderiv ℝ φ x (stdOrthonormalBasis ℝ (Q x) j))))) * g (φ x) ∂μHE[n] := by
  intro P n Q φ Λ F L B hφd hφ hF hB hFi hφi hQ g
  -- Gram identity: `normDet (T|_W) = √det(⟨T eₐ, T e_b⟩)`, `e = stdOrthonormalBasis ℝ V`, `V = W`
  have hgram : ∀ (T : Euclid P →L[ℝ] Euclid P) (V W : Submodule ℝ (Euclid P)), V = W →
      Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ V) =>
        inner ℝ (T (stdOrthonormalBasis ℝ V i)) (T (stdOrthonormalBasis ℝ V j)))) =
        ((T : Euclid P →ₗ[ℝ] Euclid P).domRestrict W).normDet := by
    rintro T V W rfl
    have h := ((T : Euclid P →ₗ[ℝ] Euclid P).domRestrict V).normDet_sq_eq_det_gram
      (stdOrthonormalBasis ℝ V)
    rw [RCLike.ofReal_real_eq_id, id] at h
    rw [← Real.sqrt_sq (LinearMap.normDet_nonneg _), h]
    rfl
  -- area formula for `φ ∘ F` (injective on `B`, `φ(F(B)) = (φ ∘ F)(B)`) and for `F`
  have hn : Module.finrank ℝ (Euclid n) = n := finrank_euclideanSpace_fin
  have hleft := Poincare.SimonGMT.Chapter02.weighted_area_formula_lipschitz_injOn (hφ.comp hF) hB
    (hφi.comp hFi (mapsTo_image F B)) g
  have hright := Poincare.SimonGMT.Chapter02.weighted_area_formula_lipschitz_injOn hF hB hFi
    (fun x => ENNReal.ofReal (Real.sqrt (Matrix.det
      (Matrix.of fun i j : Fin (Module.finrank ℝ (Q x)) =>
        inner ℝ (fderiv ℝ φ x (stdOrthonormalBasis ℝ (Q x) i))
          (fderiv ℝ φ x (stdOrthonormalBasis ℝ (Q x) j))))) * g (φ x))
  rw [hn] at hleft hright
  rw [← image_comp, hleft, hright]
  -- the integrands agree `λ⌞B`-a.e. (Rademacher and the hypothesis on `Q`)
  refine lintegral_congr_ae ?_
  filter_upwards [ae_restrict_of_ae hF.ae_differentiableAt, hQ] with b hb hQb
  rw [Poincare.SimonGMT.Chapter02.areaJacobianAt_eq_normDet,
    Poincare.SimonGMT.Chapter02.areaJacobianAt_eq_normDet, fderiv_comp b (hφd (F b)) hb,
    ContinuousLinearMap.toLinearMap_comp, LinearMap.normDet_comp,
    ← hgram (fderiv ℝ φ (F b)) (Q (F b)) _ hQb,
    ENNReal.ofReal_mul (Real.sqrt_nonneg _), comp_apply]
  ring
/-- **Simon Ch. 3, Lemma 1.2 and Remark 1.3**, with bi-Lipschitz Borel pieces in place of `C¹`
submanifolds: a Borel countably `n`-rectifiable `M ⊆ ℝᴾ` is, up to an `Hⁿ`-null set, the disjoint
union of Borel sets `Fᵢ(Bᵢ) ⊆ M`, where `Fᵢ : ℝⁿ → ℝᴾ` is Lipschitz, `Bᵢ` is Borel,
`mᵢ|a − a'| ≤ |Fᵢ(a) − Fᵢ(a')|` on `Bᵢ` for some `mᵢ > 0`, and `DFᵢ` exists and is injective on
`Bᵢ`.  Each Lipschitz `Fⱼ` of the cover maps its non-differentiability points (Rademacher) and
its critical points (the image of `{JFⱼ = 0}`) to `Hⁿ`-null sets.  Mathlib's partition lemma cuts
the regular points into pieces on which `Fⱼ` is close to an injective linear map, hence
bi-Lipschitz; the images of the pieces are Borel (Lusin–Souslin) and are made disjoint as in
Remark 1.3. -/
theorem Submission.dpf_rectifiable_bilipschitz_pieces : ∀ (P n : ℕ) (M : Set (Euclid P)), MeasurableSet M → CountablyRectifiable n M → ∃ (F : ℕ → Euclid n → Euclid P) (B : ℕ → Set (Euclid n)) (m : ℕ → ℝ), (∀ i, ∃ L : NNReal, LipschitzWith L (F i)) ∧ (∀ i, MeasurableSet (B i)) ∧ (∀ i, 0 < m i) ∧ (∀ i, ∀ a ∈ B i, ∀ a' ∈ B i, m i * ‖a - a'‖ ≤ ‖F i a - F i a'‖) ∧ (∀ i, ∀ a ∈ B i, DifferentiableAt ℝ (F i) a ∧ Injective (fderiv ℝ (F i) a)) ∧ (∀ i, MeasurableSet (F i '' B i)) ∧ (∀ i, F i '' B i ⊆ M) ∧ Pairwise (fun i j => Disjoint (F i '' B i) (F j '' B j)) ∧ μHE[n] (M \ ⋃ i, F i '' B i) = 0 := by
  intro P n M hM hrect
  have hvol : (μHE[n] : Measure (Euclid n)) = volume :=
    EuclideanSpace.euclideanHausdorffMeasure_eq_volume n
  -- Step 1: the rectifiable cover `M ⊆ M₀ ∪ ⋃ⱼ Fⱼ(ℝⁿ)`
  obtain ⟨M₀, hM₀, F₀, hF₀, hcover⟩ := hrect
  choose K hK using hF₀
  -- Step 2: the regular sets `Gⱼ` are Borel and `Hⁿ(Fⱼ(ℝⁿ ∖ Gⱼ)) = 0`
  have hGmeas : ∀ f : Euclid n → Euclid P,
      MeasurableSet {a | DifferentiableAt ℝ f a ∧ Injective (fderiv ℝ f a)} := fun f =>
    (measurableSet_of_differentiableAt ℝ f).inter
      (measurable_fderiv ℝ f ContinuousLinearMap.isOpen_injective.measurableSet)
  -- Step 2(a): nondifferentiability points have null image (Rademacher)
  have hrad : ∀ (f : Euclid n → Euclid P) (L : NNReal), LipschitzWith L f →
      μHE[n] (f '' {a | ¬ DifferentiableAt ℝ f a}) = 0 := by
    intro f L hf
    have hz : volume {a : Euclid n | ¬ DifferentiableAt ℝ f a} = 0 :=
      ae_iff.mp (hf.ae_differentiableAt (μ := volume))
    have hle := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
      (hf.lipschitzOnWith (s := {a | ¬ DifferentiableAt ℝ f a}))
    rw [hvol, hz, mul_zero] at hle
    exact le_antisymm hle bot_le
  -- Step 2(b): critical points have null image.  On a piece where `f` is `ε`-close to a
  -- rank-deficient `A` (`Av = 0`, `‖v‖ = 1`), `|f a - f a'| ≤ (L + 1)|D a - D a'|` for
  -- `D = id - (1 - ε) v ⊗ v`, and `det D = ε`.
  have hsard : ∀ (f : Euclid n → Euclid P) (L : NNReal), LipschitzWith L f →
      μHE[n] (f '' {a | DifferentiableAt ℝ f a ∧ ¬ Injective (fderiv ℝ f a)}) = 0 := by
    intro f L hf
    set S := {a | DifferentiableAt ℝ f a ∧ ¬ Injective (fderiv ℝ f a)}
    have hSmeas : MeasurableSet S :=
      (measurableSet_of_differentiableAt ℝ f).inter
        (measurable_fderiv ℝ f ContinuousLinearMap.isOpen_injective.measurableSet).compl
    have hR : ∀ R : ℕ, μHE[n] (f '' (S ∩ ball (0 : Euclid n) R)) = 0 := by
      intro R
      set s := S ∩ ball (0 : Euclid n) R
      have hsmeas : MeasurableSet s := hSmeas.inter measurableSet_ball
      have hbound : ∀ ε : NNReal, 0 < ε → ε ≤ 1 →
          μHE[n] (f '' s) ≤ ((L : ℝ≥0∞) + 1) ^ n * volume (ball (0 : Euclid n) R) * ε := by
        intro ε hε hε1
        rcases s.eq_empty_or_nonempty with hse | hsne
        · rw [hse, image_empty, measure_empty]; exact bot_le
        obtain ⟨t, A, htdisj, htmeas, hst, hA, hAy⟩ :=
          exists_partition_approximatesLinearOn_of_hasFDerivWithinAt f s (fderiv ℝ f)
            (fun x hx => hx.1.1.hasFDerivAt.hasFDerivWithinAt) (fun _ => ε) (fun _ => hε.ne')
        have hpiece : ∀ k, μHE[n] (f '' (s ∩ t k)) ≤
            ((L : ℝ≥0∞) + 1) ^ n * volume (s ∩ t k) * ε := by
          intro k
          obtain ⟨y, hy, hAk⟩ := hAy hsne k
          have hAnorm : ‖A k‖ ≤ L := hAk ▸ norm_fderiv_le_of_lipschitz ℝ hf
          have hAni : ¬ Injective (A k) := hAk ▸ hy.1.2
          obtain ⟨v, hv1, hv0⟩ : ∃ v : Euclid n, ‖v‖ = 1 ∧ A k v = 0 := by
            simp only [Injective, not_forall] at hAni
            obtain ⟨a, b, hab, hne⟩ := hAni
            have hne' : a - b ≠ 0 := sub_ne_zero.mpr hne
            refine ⟨‖a - b‖⁻¹ • (a - b), norm_smul_inv_norm hne', ?_⟩
            rw [map_smul, map_sub, hab, sub_self, smul_zero]
          set c : ℝ := 1 - (ε : ℝ) with hc
          have hc0 : 0 ≤ c := by
            rw [hc]; linarith [show (ε : ℝ) ≤ 1 from hε1]
          set D : Euclid n →L[ℝ] Euclid n :=
            ContinuousLinearMap.id ℝ (Euclid n) - c • (innerSL ℝ v).smulRight v with hD
          have hDapp : ∀ h, D h = h - (c * inner ℝ v h) • v := by
            intro h
            simp [hD, mul_smul]
          have hAD : ∀ h, A k (D h) = A k h := by
            intro h
            rw [hDapp, map_sub, map_smul, hv0, smul_zero, sub_zero]
          have hinD : ∀ h, inner ℝ v (D h) = (ε : ℝ) * inner ℝ v h := by
            intro h
            rw [hDapp, inner_sub_right, inner_smul_right, real_inner_self_eq_norm_sq, hv1, hc]
            ring
          have hεD : ∀ h, (ε : ℝ) * ‖h‖ ≤ ‖D h‖ := by
            intro h
            have heq : (ε : ℝ) • h = (ε : ℝ) • D h + (c * inner ℝ v (D h)) • v := by
              rw [hinD, hDapp, smul_sub, ← sub_eq_zero]
              rw [hc]
              module
            calc (ε : ℝ) * ‖h‖ = ‖(ε : ℝ) • h‖ := by
                  rw [norm_smul, NNReal.norm_eq]
              _ ≤ ‖(ε : ℝ) • D h‖ + ‖(c * inner ℝ v (D h)) • v‖ := heq ▸ norm_add_le _ _
              _ ≤ (ε : ℝ) * ‖D h‖ + c * ‖D h‖ := by
                  gcongr
                  · rw [norm_smul, NNReal.norm_eq]
                  · rw [norm_smul, hv1, mul_one, Real.norm_eq_abs, abs_mul, abs_of_nonneg hc0]
                    gcongr
                    exact (abs_real_inner_le_norm v (D h)).trans (by rw [hv1, one_mul])
              _ = ‖D h‖ := by rw [hc]; ring
          have hfD : ∀ a ∈ s ∩ t k, ∀ a' ∈ s ∩ t k,
              ‖f a - f a'‖ ≤ ((L : ℝ) + 1) * ‖D a - D a'‖ := by
            intro a ha a' ha'
            have h1 := hA k a ha a' ha'
            have h2 : ‖A k (a - a')‖ ≤ L * ‖D a - D a'‖ := by
              rw [← map_sub, ← hAD (a - a')]
              exact (ContinuousLinearMap.le_opNorm _ _).trans (by gcongr)
            have h3 : (ε : ℝ) * ‖a - a'‖ ≤ ‖D a - D a'‖ := by
              rw [← map_sub]
              exact hεD (a - a')
            have h4 := norm_sub_norm_le (f a - f a') (A k (a - a'))
            linarith
          have himg : μHE[n] (f '' (s ∩ t k)) ≤
              ((L + 1 : NNReal) : ℝ≥0∞) ^ n * μHE[n] (D '' (s ∩ t k)) := by
            set X := s ∩ t k
            set g := Function.invFunOn D X
            have hg : ∀ y ∈ D '' X, g y ∈ X ∧ D (g y) = y :=
              fun y hy => ⟨Function.invFunOn_mem hy, Function.invFunOn_eq hy⟩
            have hLip : LipschitzOnWith (L + 1) (f ∘ g) (D '' X) := by
              refine LipschitzOnWith.of_dist_le_mul fun y hy y' hy' => ?_
              obtain ⟨hgy, hDy⟩ := hg y hy
              obtain ⟨hgy', hDy'⟩ := hg y' hy'
              simp only [comp_apply, dist_eq_norm, NNReal.coe_add, NNReal.coe_one]
              calc ‖f (g y) - f (g y')‖ ≤ ((L : ℝ) + 1) * ‖D (g y) - D (g y')‖ :=
                    hfD _ hgy _ hgy'
                _ = _ := by rw [hDy, hDy']
            have hsub : f '' X ⊆ (f ∘ g) '' (D '' X) := by
              rintro _ ⟨a, ha, rfl⟩
              refine ⟨D a, mem_image_of_mem D ha, ?_⟩
              obtain ⟨hga, hDa⟩ := hg (D a) (mem_image_of_mem D ha)
              have := hfD _ hga _ ha
              rw [hDa, sub_self, norm_zero, mul_zero] at this
              exact sub_eq_zero.mp (norm_le_zero_iff.mp this)
            exact (measure_mono hsub).trans
              (Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n hLip)
          have hdet : LinearMap.det (D : Euclid n →ₗ[ℝ] Euclid n) = ε := by
            rw [← LinearMap.det_toMatrix (EuclideanSpace.basisFun (Fin n) ℝ).toBasis]
            have hM : LinearMap.toMatrix (EuclideanSpace.basisFun (Fin n) ℝ).toBasis
                (EuclideanSpace.basisFun (Fin n) ℝ).toBasis (D : Euclid n →ₗ[ℝ] Euclid n) =
                1 + Matrix.replicateCol Unit (fun i => -c * v i) *
                  Matrix.replicateRow Unit (fun j => v j) := by
              ext i j
              simp [hD, LinearMap.toMatrix_apply, Matrix.one_apply,
                EuclideanSpace.inner_single_right, Matrix.mul_apply, Matrix.replicateCol_apply,
                Matrix.replicateRow_apply]
              ring
            rw [hM, Matrix.det_one_add_replicateCol_mul_replicateRow]
            have h2 : ∑ i, v i ^ 2 = 1 := by
              have := EuclideanSpace.norm_sq_eq v
              simp only [hv1, one_pow, Real.norm_eq_abs, sq_abs] at this
              exact this.symm
            simp only [dotProduct]
            calc 1 + ∑ i, v i * (-c * v i) = 1 - c * ∑ i, v i ^ 2 := by
                  rw [Finset.mul_sum, sub_eq_add_neg, ← Finset.sum_neg_distrib]
                  exact congrArg _ (Finset.sum_congr rfl fun i _ => by ring)
              _ = ε := by rw [h2, mul_one, hc]; ring
          calc μHE[n] (f '' (s ∩ t k)) ≤
                ((L + 1 : NNReal) : ℝ≥0∞) ^ n * μHE[n] (D '' (s ∩ t k)) := himg
            _ = ((L : ℝ≥0∞) + 1) ^ n * volume (s ∩ t k) * ε := by
              rw [hvol, MeasureTheory.Measure.addHaar_image_continuousLinearMap, hdet,
                NNReal.abs_eq, ENNReal.ofReal_coe_nnreal]
              push_cast
              ring
        calc μHE[n] (f '' s) ≤ μHE[n] (⋃ k, f '' (s ∩ t k)) := by
              apply measure_mono
              rintro _ ⟨a, ha, rfl⟩
              obtain ⟨k, hk⟩ := mem_iUnion.mp (hst ha)
              exact mem_iUnion.mpr ⟨k, a, ⟨ha, hk⟩, rfl⟩
          _ ≤ ∑' k, μHE[n] (f '' (s ∩ t k)) := measure_iUnion_le _
          _ ≤ ∑' k, ((L : ℝ≥0∞) + 1) ^ n * volume (s ∩ t k) * ε := ENNReal.tsum_le_tsum hpiece
          _ = ((L : ℝ≥0∞) + 1) ^ n * volume (⋃ k, s ∩ t k) * ε := by
              rw [ENNReal.tsum_mul_right, ENNReal.tsum_mul_left, measure_iUnion]
              · exact fun i j hij => (htdisj hij).mono inter_subset_right inter_subset_right
              · exact fun k => hsmeas.inter (htmeas k)
          _ ≤ ((L : ℝ≥0∞) + 1) ^ n * volume (ball (0 : Euclid n) R) * ε := by
              gcongr
              exact iUnion_subset fun k => inter_subset_left.trans inter_subset_right
      have hfin : ((L : ℝ≥0∞) + 1) ^ n * volume (ball (0 : Euclid n) R) ≠ ∞ :=
        ENNReal.mul_ne_top (ENNReal.pow_ne_top (by simp)) measure_ball_lt_top.ne
      have htend : Tendsto (fun ε : NNReal =>
          ((L : ℝ≥0∞) + 1) ^ n * volume (ball (0 : Euclid n) R) * (ε : ℝ≥0∞)) (𝓝[>] 0)
          (𝓝 0) := by
        have h0 : Tendsto (fun ε : NNReal => (ε : ℝ≥0∞)) (𝓝[>] 0) (𝓝 0) := by
          rw [← ENNReal.coe_zero]
          exact (ENNReal.tendsto_coe.mpr tendsto_id).mono_left nhdsWithin_le_nhds
        simpa using ENNReal.Tendsto.const_mul h0 (Or.inr hfin)
      refine le_antisymm (ge_of_tendsto htend ?_) bot_le
      filter_upwards [Ioc_mem_nhdsGT (zero_lt_one' NNReal)] with ε hε
      exact hbound ε hε.1 hε.2
    refine measure_mono_null ?_ (measure_iUnion_null hR)
    rintro _ ⟨a, ha, rfl⟩
    obtain ⟨R, hR'⟩ := exists_nat_gt ‖a‖
    exact mem_iUnion.mpr ⟨R, a, ⟨ha, mem_ball_zero_iff.mpr hR'⟩, rfl⟩
  set G : ℕ → Set (Euclid n) := fun j =>
    {a | DifferentiableAt ℝ (F₀ j) a ∧ Injective (fderiv ℝ (F₀ j) a)}
  have hGnull : ∀ j, μHE[n] (F₀ j '' (G j)ᶜ) = 0 := by
    intro j
    refine measure_mono_null ?_ (measure_union_null (hrad _ _ (hK j)) (hsard _ _ (hK j)))
    rintro _ ⟨a, ha, rfl⟩
    by_cases hd : DifferentiableAt ℝ (F₀ j) a
    · exact Or.inr ⟨a, ⟨hd, fun hi => ha ⟨hd, hi⟩⟩, rfl⟩
    · exact Or.inl ⟨a, hd, rfl⟩
  -- Step 3: a coercivity constant `c(A)` for every injective `A`; radius `r(A) = c(A)/2 ≠ 0`
  have hcoer : ∀ A : Euclid n →L[ℝ] Euclid P, ∃ c : NNReal, 0 < c ∧
      (Injective A → ∀ h, (c : ℝ) * ‖h‖ ≤ ‖A h‖) := by
    intro A
    by_cases hA : Injective A
    · obtain ⟨C, Cpos, hC⟩ := A.injective_iff_antilipschitz.mp hA
      refine ⟨C⁻¹, inv_pos.mpr Cpos, fun _ h => ?_⟩
      have hb := A.bound_of_antilipschitz hC h
      have hC0 : (0 : ℝ) < C := Cpos
      rw [NNReal.coe_inv]
      calc (C : ℝ)⁻¹ * ‖h‖ ≤ (C : ℝ)⁻¹ * (C * ‖A h‖) := by gcongr
        _ = ‖A h‖ := by field_simp
    · exact ⟨1, one_pos, fun h => absurd h hA⟩
  choose c hcpos hc using hcoer
  -- Step 4: Mathlib's partition of `Gⱼ` into pieces on which `Fⱼ` is close to linear
  have hpart : ∀ j, ∃ (t : ℕ → Set (Euclid n)) (A : ℕ → Euclid n →L[ℝ] Euclid P),
      Pairwise (Disjoint on t) ∧ (∀ k, MeasurableSet (t k)) ∧ G j ⊆ ⋃ k, t k ∧
      (∀ k, ApproximatesLinearOn (F₀ j) (A k) (G j ∩ t k) (c (A k) / 2)) ∧
      ((G j).Nonempty → ∀ k, ∃ y ∈ G j, A k = fderiv ℝ (F₀ j) y) := fun j =>
    exists_partition_approximatesLinearOn_of_hasFDerivWithinAt (F₀ j) (G j) (fderiv ℝ (F₀ j))
      (fun x hx => hx.1.hasFDerivAt.hasFDerivWithinAt) (fun A => c A / 2)
      (fun A => (div_pos (hcpos A) two_pos).ne')
  choose t A htdisj htmeas hGt hAapprox hAy using hpart
  -- Step 5: `Fⱼ` is bi-Lipschitz on `Gⱼ ∩ tⱼₖ` with lower constant `c(Aⱼₖ)/2`
  have hlow : ∀ j k, ∀ a ∈ G j ∩ t j k, ∀ a' ∈ G j ∩ t j k,
      ((c (A j k) / 2 : NNReal) : ℝ) * ‖a - a'‖ ≤ ‖F₀ j a - F₀ j a'‖ := by
    intro j k a ha a' ha'
    obtain ⟨y, hy, hAk⟩ := hAy j ⟨a, ha.1⟩ k
    have hinj : Injective (A j k) := hAk ▸ hy.2
    have h1 := hc (A j k) hinj (a - a')
    have h2 := hAapprox j k a ha a' ha'
    have h3 := norm_sub_norm_le (A j k (a - a')) (F₀ j a - F₀ j a')
    rw [norm_sub_rev (A j k (a - a'))] at h3
    push_cast at h2 ⊢
    linarith
  -- Step 6: enumerate the pieces by `i ↦ (unpair i)`; their images are Borel (Lusin–Souslin)
  set Fi : ℕ → Euclid n → Euclid P := fun i => F₀ (Nat.unpair i).1 with hFi
  set Di : ℕ → Set (Euclid n) := fun i =>
    G (Nat.unpair i).1 ∩ t (Nat.unpair i).1 (Nat.unpair i).2 with hDi
  set mi : ℕ → ℝ := fun i =>
    ((c (A (Nat.unpair i).1 (Nat.unpair i).2) / 2 : NNReal) : ℝ) with hmi
  have hDmeas : ∀ i, MeasurableSet (Di i) := fun i =>
    (hGmeas _).inter (htmeas _ _)
  have hmipos : ∀ i, 0 < mi i := fun i => by
    simp only [hmi, NNReal.coe_div, NNReal.coe_ofNat]
    exact div_pos (hcpos _) two_pos
  have hlowi : ∀ i, ∀ a ∈ Di i, ∀ a' ∈ Di i, mi i * ‖a - a'‖ ≤ ‖Fi i a - Fi i a'‖ :=
    fun i => hlow _ _
  have hNmeas : ∀ i, MeasurableSet (Fi i '' Di i) := by
    intro i
    refine (hDmeas i).image_of_continuousOn_injOn (hK _).continuous.continuousOn ?_
    intro a ha a' ha' h
    have := hlowi i a ha a' ha'
    rw [h, sub_self, norm_zero] at this
    have h0 : ‖a - a'‖ = 0 := by
      rcases (norm_nonneg (a - a')).eq_or_lt with h0 | h0
      · exact h0.symm
      · linarith [mul_pos (hmipos i) h0]
    exact sub_eq_zero.mp (norm_eq_zero.mp h0)
  -- Step 7: disjointify the images inside `M`
  set Ñ : ℕ → Set (Euclid P) := fun i => Fi i '' Di i ∩ M
  have hÑmeas : ∀ i, MeasurableSet (Ñ i) := fun i => (hNmeas i).inter hM
  set B : ℕ → Set (Euclid n) := fun i => Di i ∩ Fi i ⁻¹' disjointed Ñ i with hB
  have himg : ∀ i, Fi i '' B i = disjointed Ñ i := by
    intro i
    rw [hB, image_inter_preimage]
    exact inter_eq_right.mpr ((disjointed_subset Ñ i).trans inter_subset_left)
  refine ⟨Fi, B, mi, fun i => ⟨K _, hK _⟩,
    fun i => (hDmeas i).inter ((hK _).continuous.measurable (MeasurableSet.disjointed hÑmeas i)),
    hmipos, fun i a ha a' ha' => hlowi i a ha.1 a' ha'.1, fun i a ha => ha.1.1,
    fun i => himg i ▸ MeasurableSet.disjointed hÑmeas i,
    fun i => himg i ▸ ((disjointed_subset Ñ i).trans inter_subset_right), ?_, ?_⟩
  · intro i j hij
    rw [himg i, himg j]
    exact disjoint_disjointed Ñ hij
  -- Step 8: the remainder lies in `M₀ ∪ ⋃ⱼ Fⱼ(ℝⁿ ∖ Gⱼ)`
  · have hU : (⋃ i, Fi i '' B i) = ⋃ i, Ñ i := by
      simp_rw [himg]
      exact iUnion_disjointed
    rw [hU]
    refine measure_mono_null ?_ (measure_union_null hM₀ (measure_iUnion_null hGnull))
    rintro x ⟨hxM, hxN⟩
    rcases hcover hxM with hx0 | hx
    · exact Or.inl hx0
    · obtain ⟨j, a, rfl⟩ := mem_iUnion.mp hx
      by_cases ha : a ∈ G j
      · exfalso
        obtain ⟨k, hk⟩ := mem_iUnion.mp (hGt j ha)
        apply hxN
        refine mem_iUnion.mpr ⟨Nat.pair j k, ⟨a, ?_, ?_⟩, hxM⟩
        · simp only [hDi, Nat.unpair_pair]
          exact ⟨ha, hk⟩
        · simp only [hFi, Nat.unpair_pair]
      · exact Or.inr (mem_iUnion.mpr ⟨j, a, ha, rfl⟩)
/-- **Good radius** (Simon 7.2.4, choice of the slicing level; the factor-2 averaging of Ch. 2,
6.7(1)).  If `ρ < ρ'`, `μ(B̄_{ρ'}(y)) < ∞`, `∫ g dL¹ ≤ I` and `p` holds `L¹`-a.e., then some
`t ∈ (ρ, ρ')` has `p t`, `μ(∂B_t(y)) = 0` and `g t ≤ (2 / (ρ' - ρ)) I`: the levels failing `p` and
the (countably many) levels whose sphere charges the finite measure `μ⌞B̄_{ρ'}(y)` are `L¹`-null,
and by Markov's inequality the levels with `g t > (2 / (ρ' - ρ)) I` have `L¹`-measure at most
`(ρ' - ρ) / 2 < L¹((ρ, ρ'))`. -/
theorem Submission.dor_lmb_glc_good_radius : ∀ (P : ℕ) (μ : Measure (Euclid P)) (y : Euclid P) (ρ ρ' : ℝ) (g : ℝ → ℝ≥0∞) (I : ℝ≥0∞) (p : ℝ → Prop), ρ < ρ' → μ (closedBall y ρ') ≠ ∞ → AEMeasurable g → ∫⁻ t, g t ≤ I → (∀ᵐ t, p t) → ∃ t : ℝ, ρ < t ∧ t < ρ' ∧ p t ∧ μ (sphere y t) = 0 ∧ g t ≤ ENNReal.ofReal (2 / (ρ' - ρ)) * I := by
  intro P μ y ρ ρ' g I p hρ hμ hg hI hp
  have hδ : 0 < ρ' - ρ := sub_pos.mpr hρ
  set c := ENNReal.ofReal (2 / (ρ' - ρ)) with hc_def
  have hc0 : c ≠ 0 := by
    rw [hc_def, Ne, ENNReal.ofReal_eq_zero, not_le]
    positivity
  have hctop : c ≠ ∞ := ENNReal.ofReal_ne_top
  have hcinv : c⁻¹ = ENNReal.ofReal ((ρ' - ρ) / 2) := by
    rw [hc_def, ← ENNReal.ofReal_inv_of_pos (by positivity), inv_div]
  -- `N₁`: the exceptional set of `p` is Lebesgue-null
  have hN₁ : volume {t : ℝ | ¬ p t} = 0 := ae_iff.mp hp
  -- `N₂`: only countably many spheres charge the finite measure `μ⌞B̄_{ρ'}(y)`
  have hfin : IsFiniteMeasure (μ.restrict (closedBall y ρ')) := isFiniteMeasure_restrict.mpr hμ
  have hcount : {s : ℝ | 0 < μ.restrict (closedBall y ρ') (sphere y s)}.Countable :=
    Measure.countable_meas_pos_of_disjoint_iUnion (fun s => isClosed_sphere.measurableSet)
      (fun s s' hss' => Set.disjoint_left.mpr fun x hx hx' =>
        hss' ((mem_sphere.mp hx).symm.trans (mem_sphere.mp hx')))
  have hN₂ : volume {s : ℝ | 0 < μ.restrict (closedBall y ρ') (sphere y s)} = 0 :=
    hcount.measure_zero volume
  -- `N₃`: Markov's inequality gives `L¹(N₃) ≤ (ρ' - ρ) / 2`
  have hN₃ : volume {t : ℝ | c * I < g t} ≤ ENNReal.ofReal ((ρ' - ρ) / 2) := by
    rcases eq_or_ne I 0 with h0 | h0
    · have hzero : ∫⁻ t, g t = 0 := le_antisymm (hI.trans h0.le) zero_le
      have hae : g =ᵐ[volume] 0 := (lintegral_eq_zero_iff' hg).mp hzero
      have hnull : volume {t : ℝ | c * I < g t} = 0 := by
        refine measure_mono_null (fun t ht => ?_) (ae_iff.mp hae)
        simp only [Set.mem_ofPred_eq, h0, mul_zero] at ht ⊢
        exact ht.ne'
      rw [hnull]
      exact zero_le
    rcases eq_or_ne I ∞ with htop | htop
    · have hempty : {t : ℝ | c * I < g t} = ∅ := by
        ext t
        simp [htop, ENNReal.mul_top hc0]
      rw [hempty, measure_empty]
      exact zero_le
    have hε0 : c * I ≠ 0 := mul_ne_zero hc0 h0
    have hεtop : c * I ≠ ∞ := ENNReal.mul_ne_top hctop htop
    calc volume {t : ℝ | c * I < g t} ≤ volume {t : ℝ | c * I ≤ g t} :=
          measure_mono fun t (ht : c * I < g t) => show c * I ≤ g t from ht.le
      _ ≤ (∫⁻ t, g t) / (c * I) := meas_ge_le_lintegral_div hg hε0 hεtop
      _ ≤ I / (c * I) := ENNReal.div_le_div_right hI _
      _ = c⁻¹ := by
        rw [ENNReal.div_eq_inv_mul, ENNReal.mul_inv (Or.inl hc0) (Or.inl hctop), mul_assoc,
          ENNReal.inv_mul_cancel h0 htop, mul_one]
      _ = ENNReal.ofReal ((ρ' - ρ) / 2) := hcinv
  -- covering: if no good `t` existed, then `(ρ, ρ') ⊆ N₁ ∪ N₂ ∪ N₃`
  by_contra hcon
  have hcover : Ioo ρ ρ' ⊆ {t : ℝ | ¬ p t} ∪
      {s : ℝ | 0 < μ.restrict (closedBall y ρ') (sphere y s)} ∪ {t : ℝ | c * I < g t} := by
    intro t ht
    by_contra hnot
    simp only [Set.mem_union, Set.mem_ofPred_eq, not_or, not_not, not_lt, nonpos_iff_eq_zero]
      at hnot
    obtain ⟨⟨hpt, hνt⟩, hgt⟩ := hnot
    have hμt : μ (sphere y t) = 0 := by
      rwa [Measure.restrict_apply isClosed_sphere.measurableSet, Set.inter_eq_left.mpr
        (sphere_subset_closedBall.trans (closedBall_subset_closedBall ht.2.le))] at hνt
    exact hcon ⟨t, ht.1, ht.2, hpt, hμt, hgt⟩
  have hle : ENNReal.ofReal (ρ' - ρ) ≤ ENNReal.ofReal ((ρ' - ρ) / 2) :=
    calc ENNReal.ofReal (ρ' - ρ) = volume (Ioo ρ ρ') := Real.volume_Ioo.symm
      _ ≤ volume ({t : ℝ | ¬ p t} ∪ {s : ℝ | 0 < μ.restrict (closedBall y ρ') (sphere y s)} ∪
          {t : ℝ | c * I < g t}) := measure_mono hcover
      _ ≤ volume {t : ℝ | ¬ p t} + volume {s : ℝ | 0 < μ.restrict (closedBall y ρ') (sphere y s)} +
          volume {t : ℝ | c * I < g t} :=
        (measure_union_le _ _).trans (add_le_add (measure_union_le _ _) le_rfl)
      _ ≤ ENNReal.ofReal ((ρ' - ρ) / 2) := by
        rw [hN₁, hN₂, zero_add, zero_add]
        exact hN₃
  rw [ENNReal.ofReal_le_ofReal_iff (by positivity)] at hle
  linarith
/-- **Simon Ch. 6, 2.5** (step 8(b) of the level cut in the proof of 7.2.4): if `Y = T − S` on
the forms supported in `W`, then `M_W(Y) ≤ M_W(T) + M_W(S)`.  `M_W(Y)` is the supremum of `Y(ω)`
over the forms `ω ∈ 𝒟ⁿ(U)` admissible for `M_W` (`spt ω ⊆ W`, `|ω| ≤ 1`).  For such `ω` the
form `−ω` is admissible as well, since it has the same support and pointwise coefficient norm.
As `Y(ω) = T(ω) − S(ω) = T(ω) + S(−ω)` and `ofReal` is subadditive, `Y(ω)` is bounded by
`M_W(T) + M_W(S)`. -/
theorem Submission.dor_lmb_glc_massOn_sub_le : ∀ (P n : ℕ) (U W : Set (Euclid P)) (T S Y : GeometricCurrentOn U n), (∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ W → Y ω = T ω - S ω) → Y.massOn W ≤ T.massOn W + S.massOn W := by
  intro P n U W T S Y hY
  -- Step 1: `M_W(Y)` is a supremum, so fix an admissible `ω`
  apply sSup_le
  rintro r ⟨ω, hω, rfl⟩
  -- Step 2: `−ω` is admissible (same support, same coefficient norm)
  have hnω : -ω ∈ massAdmissibleOn U n W := by
    refine ⟨?_, fun x => ?_⟩
    · rw [Submodule.coe_neg, tsupport_neg]
      exact hω.1
    · rw [Submodule.coe_neg, Pi.neg_apply, covectorEuclideanNorm_neg]
      exact hω.2 x
  -- Step 3: `Y(ω) = T(ω) − S(ω) = T(ω) + S(−ω)`, as `spt ω ⊆ W`
  have hY' : Y ω = T ω + S (-ω) := by
    rw [hY ω hω.1, map_neg S.toCurrent ω, sub_eq_add_neg]
  -- Steps 4–5: subadditivity of `ofReal`, and each admissible value is bounded by the mass
  calc ENNReal.ofReal (Y ω) = ENNReal.ofReal (T ω + S (-ω)) := by rw [hY']
    _ ≤ ENNReal.ofReal (T ω) + ENNReal.ofReal (S (-ω)) := ENNReal.ofReal_add_le
    _ ≤ T.massOn W + S.massOn W := add_le_add (T.le_massOn hω) (S.le_massOn hnω)
/-- Simon 7.2.4 (3) and Ch. 6, 4.5(2): by cancellation `X = D + Q` acts as
`ω ↦ ∫_{M̂∩B_t(y)} θ̂⟨dω, ξ̂⟩ dH^{n+1}` (informally `∂(R⌞B_t(y))`), so `∂X = 0` by `d² = 0`,
`X(ω) = 0` if `spt ω` misses `B̄_t(y)`, and `X(ω) = R(dω) = ∂R(ω)` if `spt ω ⊆ B_t(y)`. -/
theorem Submission.dor_lmb_glc_cut_cycle : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : GeometricCurrentOn U (n + 1)) (RR : IMRep U (n + 1)) (RB : IMRep U n) (D Q : GeometricCurrentOn U n) (y : Euclid P) (t : ℝ), RR.Represents R → (∀ ω : TestFormOn U n, D ω = ∫ x in RB.carrier ∩ ball y t, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → (∀ ω : TestFormOn U n, Q ω = (∫ x in RR.carrier ∩ ball y t, (RR.mult x : ℝ) * RR.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier ∩ ball y t, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → ∃ X : GeometricCurrentOn U n, (∀ ω : TestFormOn U n, X ω = D ω + Q ω) ∧ BoundaryVanishes X ∧ (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (closedBall y t) → X ω = 0) ∧ ∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ ball y t → X ω = R.boundary ω := by
  intro P n U R RR RB D Q y t hR hD hQ
  -- `X := D + Q` is a current, as the sum of two continuous functionals
  let X : GeometricCurrentOn U n :=
    { toCurrent := D.toCurrent + Q.toCurrent
      continuous' := fun ωs h => by
        simpa using (D.continuous' ωs h).add (Q.continuous' ωs h) }
  have hXDQ : ∀ ω : TestFormOn U n, X ω = D ω + Q ω := fun _ => rfl
  -- (‡) `X(ω) = ∫_{M̂∩B} θ̂⟨dω, ξ̂⟩ dH^{n+1}`, by cancellation
  have hX : ∀ ω : TestFormOn U n, X ω = ∫ x in RR.carrier ∩ ball y t,
      (RR.mult x : ℝ) * RR.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x)
        ∂μHE[n + 1] := fun ω => by
    rw [hXDQ, hD, hQ]
    ring
  clear_value X
  refine ⟨X, hXDQ, ?_, fun ω hω => ?_, fun ω hω => ?_⟩
  · -- `∂X(η) = X(dη) = ∫ θ̂⟨d(dη), ξ̂⟩ = 0` as `d² = 0` (vacuous for `n = 0`)
    cases n with
    | zero => trivial
    | succ m =>
      show X.boundary = 0
      refine GeometricCurrentOn.ext fun η => ?_
      rw [GeometricCurrentOn.boundary_apply, hX, GeometricCurrentOn.zero_apply]
      refine setIntegral_eq_zero_of_forall_eq_zero fun x _ => ?_
      change (RR.mult x : ℝ) * RR.orient x
        (exteriorDerivative (exteriorDerivative (η : DifferentialForm (Euclid P) m)) x) = 0
      rw [exteriorDerivative_sq η.property.1.1, Pi.zero_apply, map_zero, mul_zero]
  · -- `dω` vanishes on `B ⊆ B̄`, which misses `spt ω ⊇ spt dω`
    have hdω : ∀ x ∈ ball y t, exteriorDerivative (ω : DifferentialForm (Euclid P) n) x = 0 :=
      fun x hx => image_eq_zero_of_notMem_tsupport fun hx' =>
        hω.notMem_of_mem_right (ball_subset_closedBall hx)
          (tsupport_exteriorDerivative_subset _ hx')
    rw [hX]
    exact setIntegral_eq_zero_of_forall_eq_zero fun x hx => by rw [hdω x hx.2, map_zero, mul_zero]
  · -- `∂R(ω) = R(dω) = ∫_{M̂} θ̂⟨dω, ξ̂⟩`, and `dω` vanishes on `M̂ \ B` as `spt dω ⊆ spt ω ⊆ B`
    have hdω : ∀ x ∉ ball y t, exteriorDerivative (ω : DifferentialForm (Euclid P) n) x = 0 :=
      fun x hx => image_eq_zero_of_notMem_tsupport fun hx' =>
        hx (hω (tsupport_exteriorDerivative_subset _ hx'))
    rw [hX, GeometricCurrentOn.boundary_apply, hR (exteriorDerivativeTestOn U n ω), IMRep.action]
    refine (setIntegral_eq_of_subset_of_forall_sdiff_eq_zero RR.measurableSet_carrier
      inter_subset_left fun x hx => ?_).symm
    show (RR.mult x : ℝ) * RR.orient x
      (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) = 0
    rw [hdω x fun hxB => hx.2 ⟨hx.1, hxB⟩, map_zero, mul_zero]
/-- Localized Besicovitch density (Simon Ch. 1, Theorem 3.16; Mathlib's
`Besicovitch.ae_tendsto_measure_inter_div`).  Let `U` be open, `A ⊆ B ⊆ U` Borel, and
`Hⁿ(B ∩ K) < ∞` for every compact `K ⊆ U`.  Then for `Hⁿ⌞A`-a.e. `x` and every `ε > 0`,
`Hⁿ((B \ A) ∩ B̄_ρ(x)) ≤ ε Hⁿ(B ∩ B̄_ρ(x))` for all small `ρ > 0`.

Proof sketch:
* Cover `U` by countably many open balls `B_r(y)` with `B̄_r(y) ⊆ U`.
* On each ball, `ν = Hⁿ⌞(B ∩ B̄_r(y))` is finite, so Besicovitch gives
  `ν(A ∩ B̄_ρ(x))/ν(B̄_ρ(x)) → 1` for `ν⌞A = (Hⁿ⌞A)⌞B̄_r(y)`-a.e. `x`.
* For `x ∈ B_r(y)` and small `ρ`, this quotient is `b/a`, where
  `b = Hⁿ(A ∩ B̄_ρ(x))` and `a = Hⁿ(B ∩ B̄_ρ(x)) < ∞`.
* If `ε ≥ 1`, the bound is monotonicity.
* If `ε < 1`, eventually `b/a > 1 − ε`, which forces `0 < a < ∞`; hence
  `Hⁿ((B \ A) ∩ B̄_ρ(x)) = a − b ≤ εa`. -/
theorem Submission.rsdic_tl_ae_excess_le : ∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ ε : ℝ≥0∞, 0 < ε → ∀ᶠ ρ in 𝓝[>] (0 : ℝ), μHE[n] ((B \ A) ∩ closedBall x ρ) ≤ ε * μHE[n] (B ∩ closedBall x ρ) := by
  intro P n U A B hU hA hB hAB hBU hfin
  -- Step 1: countably many balls `B(y, r y)`, `y ∈ D`, with `B̄(y, r y) ⊆ U` cover `U`
  have hr : ∀ x ∈ U, ∃ r : ℝ, 0 < r ∧ closedBall x r ⊆ U := by
    intro x hx
    obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.1 hU x hx
    exact ⟨δ / 2, half_pos hδ, (closedBall_subset_ball (half_lt_self hδ)).trans hball⟩
  choose! r hr0 hrU using hr
  obtain ⟨D, hDU, hDc, hcov⟩ := TopologicalSpace.countable_cover_nhdsWithin
    (f := fun y => ball y (r y)) (s := U)
    fun x hx => mem_nhdsWithin_of_mem_nhds (ball_mem_nhds x (hr0 x hx))
  -- Step 2: Besicovitch's density theorem for the finite measures `Hⁿ⌞(B ∩ B̄(y, r y))`
  have hpiece : ∀ᵐ x ∂(μHE[n].restrict A), ∀ y ∈ D, x ∈ closedBall y (r y) →
      Tendsto (fun ρ : ℝ => (μHE[n].restrict (B ∩ closedBall y (r y))) (A ∩ closedBall x ρ) /
        (μHE[n].restrict (B ∩ closedBall y (r y))) (closedBall x ρ)) (𝓝[>] 0) (𝓝 1) := by
    rw [ae_ball_iff hDc]
    intro y hy
    have : IsFiniteMeasure ((μHE[n] : Measure (Euclid P)).restrict (B ∩ closedBall y (r y))) :=
      ⟨by
        rw [Measure.restrict_apply_univ]
        exact (hfin _ (isCompact_closedBall y (r y)) (hrU y (hDU hy))).lt_top⟩
    have h := Besicovitch.ae_tendsto_measure_inter_div
      ((μHE[n] : Measure (Euclid P)).restrict (B ∩ closedBall y (r y))) A
    -- `(Hⁿ⌞(B ∩ K))⌞A = (Hⁿ⌞A)⌞K` since `A ⊆ B`
    have hres : ((μHE[n] : Measure (Euclid P)).restrict (B ∩ closedBall y (r y))).restrict A =
        ((μHE[n] : Measure (Euclid P)).restrict A).restrict (closedBall y (r y)) := by
      rw [Measure.restrict_restrict hA, Measure.restrict_restrict measurableSet_closedBall]
      congr 1
      ext z
      exact ⟨fun ⟨hzA, _, hzK⟩ => ⟨hzK, hzA⟩, fun ⟨hzK, hzA⟩ => ⟨hzA, hAB hzA, hzK⟩⟩
    rwa [hres, ae_restrict_iff' measurableSet_closedBall] at h
  filter_upwards [hpiece, ae_restrict_mem hA] with x hx hxA ε hε
  obtain ⟨y, hyD, hxy⟩ := mem_iUnion₂.1 (hcov (hBU (hAB hxA)))
  obtain ⟨δ, hδ, hδy⟩ := Metric.isOpen_iff.1 isOpen_ball x hxy
  have hsmall : ∀ ρ : ℝ, ρ < δ → closedBall x ρ ⊆ closedBall y (r y) := fun ρ hρ =>
    ((closedBall_subset_ball hρ).trans hδy).trans ball_subset_closedBall
  have hBK : MeasurableSet (B ∩ closedBall y (r y)) := hB.inter measurableSet_closedBall
  -- Step 3: for `ρ < δ` the quotient is `Hⁿ(A ∩ B̄_ρ(x)) / Hⁿ(B ∩ B̄_ρ(x))`
  have hT : Tendsto (fun ρ : ℝ => μHE[n] (A ∩ closedBall x ρ) / μHE[n] (B ∩ closedBall x ρ))
      (𝓝[>] 0) (𝓝 1) := by
    refine (hx y hyD (ball_subset_closedBall hxy)).congr' ?_
    filter_upwards [Ioo_mem_nhdsGT hδ] with ρ hρ
    rw [Measure.restrict_apply' hBK, Measure.restrict_apply' hBK]
    congr 2
    · ext z
      exact ⟨fun ⟨hz, _⟩ => hz, fun ⟨hzA, hzx⟩ => ⟨⟨hzA, hzx⟩, hAB hzA, hsmall ρ hρ.2 hzx⟩⟩
    · ext z
      exact ⟨fun ⟨hzx, hzB, _⟩ => ⟨hzB, hzx⟩, fun ⟨hzB, hzx⟩ => ⟨hzx, hzB, hsmall ρ hρ.2 hzx⟩⟩
  have hfinρ : ∀ ρ : ℝ, ρ < δ → μHE[n] (B ∩ closedBall x ρ) ≠ ∞ := fun ρ hρ =>
    ne_top_of_le_ne_top (hfin _ (isCompact_closedBall y (r y)) (hrU y (hDU hyD)))
      (measure_mono (inter_subset_inter_right B (hsmall ρ hρ)))
  -- `Hⁿ((B \ A) ∩ B̄_ρ(x)) + Hⁿ(A ∩ B̄_ρ(x)) = Hⁿ(B ∩ B̄_ρ(x))`
  have hsplit : ∀ ρ : ℝ, μHE[n] ((B \ A) ∩ closedBall x ρ) + μHE[n] (A ∩ closedBall x ρ) =
      μHE[n] (B ∩ closedBall x ρ) := by
    intro ρ
    rw [← measure_union _ (hA.inter measurableSet_closedBall)]
    · congr 1
      ext z
      constructor
      · rintro (⟨⟨hzB, -⟩, hzx⟩ | ⟨hzA, hzx⟩)
        · exact ⟨hzB, hzx⟩
        · exact ⟨hAB hzA, hzx⟩
      · rintro ⟨hzB, hzx⟩
        by_cases hzA : z ∈ A
        · exact Or.inr ⟨hzA, hzx⟩
        · exact Or.inl ⟨⟨hzB, hzA⟩, hzx⟩
    · rw [Set.disjoint_left]
      rintro z ⟨⟨-, hzA⟩, -⟩ ⟨hzA', -⟩
      exact hzA hzA'
  -- Step 4: the excess estimate
  rcases le_or_gt 1 ε with hε1 | hε1
  · -- `ε ≥ 1`: monotonicity
    refine Eventually.of_forall fun ρ => ?_
    calc μHE[n] ((B \ A) ∩ closedBall x ρ) ≤ μHE[n] (B ∩ closedBall x ρ) :=
          measure_mono (inter_subset_inter_left _ sdiff_subset)
      _ = 1 * μHE[n] (B ∩ closedBall x ρ) := (one_mul _).symm
      _ ≤ ε * μHE[n] (B ∩ closedBall x ρ) := by gcongr
  · -- `ε < 1`: eventually `b / a > 1 − ε`, with `a ≠ ∞`
    have hsub : 1 - ε < 1 := ENNReal.sub_lt_self ENNReal.one_ne_top one_ne_zero hε.ne'
    filter_upwards [hT (isOpen_Ioi.mem_nhds hsub), Ioo_mem_nhdsGT hδ] with ρ hρq hρ
    set a := μHE[n] (B ∩ closedBall x ρ)
    set b := μHE[n] (A ∩ closedBall x ρ)
    set e := μHE[n] ((B \ A) ∩ closedBall x ρ)
    have hatop : a ≠ ∞ := hfinρ ρ hρ.2
    have hsplitρ : e + b = a := hsplit ρ
    -- `a ≠ 0`, since otherwise `b / a = 0 / 0 = 0 ≤ 1 − ε`
    have ha0 : a ≠ 0 := by
      intro h0
      have hb0 : b = 0 := nonpos_iff_eq_zero.1 (h0 ▸ hsplitρ ▸ le_add_self)
      have : b / a = 0 := by rw [hb0, ENNReal.zero_div]
      rw [mem_preimage, this, mem_Ioi] at hρq
      exact not_lt_zero hρq
    have hlt : (1 - ε) * a < b :=
      (ENNReal.lt_div_iff_mul_lt (Or.inl ha0) (Or.inl hatop)).1 hρq
    -- `e + (1 − ε)a ≤ e + b = a = εa + (1 − ε)a`, and `(1 − ε)a ≠ ∞`
    have h1 : e + (1 - ε) * a ≤ ε * a + (1 - ε) * a := by
      calc e + (1 - ε) * a ≤ e + b := by gcongr
        _ = a := hsplitρ
        _ = (ε + (1 - ε)) * a := by rw [add_tsub_cancel_of_le hε1.le, one_mul]
        _ = ε * a + (1 - ε) * a := add_mul _ _ _
    exact ENNReal.le_of_add_le_add_right (ENNReal.mul_ne_top (by simp) hatop) h1
/-- **Countable gluing of the co-area identity over disjoint Borel pieces** (Simon Ch. 3, 2.8–2.9
summed over the decomposition `M = ⋃ⱼ Mⱼ` of Remark 1.3).  If `g` vanishes off the pairwise disjoint
Borel pieces `S j ⊆ M` and each piece satisfies `∫ ∫_{(S j)_t} φ dν dt = ∫_{S j} |g| φ dμ` (with an
a.e.-measurable slice integral), then so does `M`: the slice `M_t = M ∩ {g ≠ 0} ∩ f⁻¹(t)` is the
disjoint union of the `(S j)_t`, both sides are series over `j`, and monotone convergence exchanges
`∫ dt` with `∑ⱼ`. -/
theorem Submission.dor_lmbsf_tg_coarea_gluing : ∀ (P : ℕ) (μ ν : Measure (Euclid P)) (M : Set (Euclid P)) (S : ℕ → Set (Euclid P)) (g : Euclid P → Euclid P) (f : Euclid P → ℝ) (φ : Euclid P → ℝ≥0∞), MeasurableSet M → (∀ j, MeasurableSet (S j)) → Pairwise (fun i j => Disjoint (S i) (S j)) → (∀ j, S j ⊆ M) → Measurable g → (∀ x, (∀ j, x ∉ S j) → g x = 0) → Measurable f → (∀ j, AEMeasurable (fun t => ∫⁻ x in S j ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}, φ x ∂ν) ∧ ∫⁻ t, (∫⁻ x in S j ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}, φ x ∂ν) = ∫⁻ x in S j, ‖g x‖ₑ * φ x ∂μ) → AEMeasurable (fun t => ∫⁻ x in M ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}, φ x ∂ν) ∧ ∫⁻ t, (∫⁻ x in M ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}, φ x ∂ν) = ∫⁻ x in M, ‖g x‖ₑ * φ x ∂μ := by
  intro P μ ν M S g f φ _ hS hdisj hSM hg hg0 hf hpiece
  -- Step 1: `M_t = ⋃ⱼ (S j)_t`, since `g = 0` off `⋃ⱼ S j` and `S j ⊆ M`
  have hset : ∀ t : ℝ,
      M ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} = ⋃ j, S j ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} := by
    intro t
    ext x
    simp only [mem_inter_iff, mem_ofPred_eq, mem_preimage, mem_singleton_iff, mem_iUnion]
    constructor
    · rintro ⟨⟨-, hgx⟩, hfx⟩
      obtain ⟨j, hj⟩ : ∃ j, x ∈ S j := by
        by_contra h
        exact hgx (hg0 x fun j hj => h ⟨j, hj⟩)
      exact ⟨j, ⟨hj, hgx⟩, hfx⟩
    · rintro ⟨j, ⟨hj, hgx⟩, hfx⟩
      exact ⟨⟨hSM j hj, hgx⟩, hfx⟩
  -- Step 2: the slices `(S j)_t` are Borel and pairwise disjoint
  have hmeas : ∀ (t : ℝ) j, MeasurableSet (S j ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}) := fun t j =>
    ((hS j).inter (hg (measurableSet_singleton 0).compl)).inter (hf (measurableSet_singleton t))
  have hdisj' : ∀ t : ℝ, Pairwise (Disjoint on fun j => S j ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}) :=
    fun t i j hij => (hdisj hij).mono (inter_subset_left.trans inter_subset_left)
      (inter_subset_left.trans inter_subset_left)
  -- Step 3: `∫_{M_t} φ dν = ∑ⱼ ∫_{(S j)_t} φ dν` for every `t`
  have hslice : ∀ t : ℝ, ∫⁻ x in M ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}, φ x ∂ν =
      ∑' j, ∫⁻ x in S j ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}, φ x ∂ν := fun t => by
    rw [hset t, lintegral_iUnion (hmeas t) (hdisj' t)]
  -- Step 6: `|g| φ` vanishes off `⋃ⱼ S j ⊆ M`, so `∫_M |g| φ dμ = ∑ⱼ ∫_{S j} |g| φ dμ`
  have hsupp : support (fun x => ‖g x‖ₑ * φ x) ⊆ ⋃ j, S j := by
    intro x hx
    rw [mem_support] at hx
    by_contra h
    exact hx (by simp [hg0 x fun j hj => h (mem_iUnion.2 ⟨j, hj⟩)])
  have hrhs : ∫⁻ x in M, ‖g x‖ₑ * φ x ∂μ = ∑' j, ∫⁻ x in S j, ‖g x‖ₑ * φ x ∂μ := by
    rw [setLIntegral_eq_of_support_subset (hsupp.trans (iUnion_subset hSM)),
      ← setLIntegral_eq_of_support_subset hsupp, lintegral_iUnion hS hdisj]
  -- Steps 4, 5 and 7: the series is a.e.-measurable, and monotone convergence for series
  simp only [hslice]
  refine ⟨AEMeasurable.tsum fun j => (hpiece j).1, ?_⟩
  rw [lintegral_tsum fun j => (hpiece j).1, hrhs]
  exact tsum_congr fun j => (hpiece j).2
/-- **Approximate tangent spaces glue over a countable Borel cover** (Simon Ch. 3, Remark 1.5(2),
with the decomposition of Remark 1.3; used in Ch. 6, proof of Lemma 4.1(2)).  Assume tangent
locality (TL): for Borel `A ⊆ B ⊆ U`, `U` open and `B` locally `Hⁿ`-finite in `U`, the sets `B`
and `A` have the same approximate tangent spaces at `Hⁿ`-a.e. `x ∈ A`.  Let `B ⊆ U` be Borel and
locally `Hⁿ`-finite in `U`, and let Borel sets `S j ⊆ B` cover `B`.  If `S j` has approximate
tangent space `Q(x)` at `Hⁿ`-a.e. `x ∈ S j` for every `j`, then `B` has approximate tangent space
`Q(x)` at `Hⁿ`-a.e. `x ∈ B`.
* (TL) with `A = S j`, evaluated at `Q(x)`, transfers the tangent space from `S j` to `B`,
  `Hⁿ`-a.e. on `S j`.
* A countable union of null sets is null (`ae_restrict_iUnion_iff`), and `B ⊆ ⋃ j, S j`. -/
theorem Submission.dor_lmbsf_tg_tangent_gluing : (∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q) → ∀ (P n : ℕ) (U B : Set (Euclid P)) (S : ℕ → Set (Euclid P)) (Q : Euclid P → Submodule ℝ (Euclid P)), IsOpen U → MeasurableSet B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → (∀ j, MeasurableSet (S j)) → (∀ j, S j ⊆ B) → B ⊆ ⋃ j, S j → (∀ j, ∀ᵐ x ∂(μHE[n].restrict (S j)), HasApproximateTangentSpaceAt n (S j) x (Q x)) → ∀ᵐ x ∂(μHE[n].restrict B), HasApproximateTangentSpaceAt n B x (Q x) := by
  intro hTL P n U B S Q hU hB hBU hfin hS hSB hBS hpiece
  -- Steps 1–2: on `S j`, (TL) with `A = S j` turns `TₓS j = Q(x)` into `TₓB = Q(x)`
  have hj : ∀ j, ∀ᵐ x ∂(μHE[n].restrict (S j)), HasApproximateTangentSpaceAt n B x (Q x) := by
    intro j
    filter_upwards [hTL P n U (S j) B hU (hS j) hB (hSB j) hBU hfin, hpiece j] with x hx hxQ
    exact (hx (Q x)).2 hxQ
  -- Step 3: a countable union of null sets is null, so this holds `Hⁿ`-a.e. on `⋃ j, S j`
  have hcover : ∀ᵐ x ∂(μHE[n].restrict (⋃ j, S j)), HasApproximateTangentSpaceAt n B x (Q x) :=
    (ae_restrict_iUnion_iff S _).2 hj
  -- Step 4: restrict to `B ⊆ ⋃ j, S j`
  exact ae_restrict_of_ae_restrict_of_subset hBS hcover
/-- **Gluing weak limits over a countable a.e.-partition** (Simon Ch. 6, proof of 4.5(2): the
reduction to a single piece).  If the disjoint Borel pieces `S j ⊆ M` cover `M` up to a `μ`-null
set, the `u k` are dominated on `M` by the integrable `D`, and `∫_{S j} u k → ∫_{S j ∩ E} v` for
every `j`, then `∫_M u k → ∫_{M ∩ E} v`.  Countable additivity writes both sides as series over
the pieces, the terms are bounded by the summable `∫_{S j} D`, and Tannery's theorem (the `ε/3`
argument of Mathlib's `tendsto_tsum_of_dominated_convergence`, inlined) passes to the limit. -/
theorem Submission.dor_lmbsf_tg_weak_limit_gluing : ∀ (P : ℕ) (μ : Measure (Euclid P)) (M E : Set (Euclid P)) (S : ℕ → Set (Euclid P)) (u : ℕ → Euclid P → ℝ) (v D : Euclid P → ℝ), MeasurableSet M → MeasurableSet E → (∀ j, MeasurableSet (S j)) → Pairwise (fun i j => Disjoint (S i) (S j)) → (∀ j, S j ⊆ M) → μ (M \ ⋃ j, S j) = 0 → IntegrableOn D M μ → (∀ k, AEStronglyMeasurable (u k) (μ.restrict M)) → (∀ k, ∀ᵐ x ∂(μ.restrict M), ‖u k x‖ ≤ D x) → IntegrableOn v (M ∩ E) μ → (∀ j, Tendsto (fun k => ∫ x in S j, u k x ∂μ) atTop (𝓝 (∫ x in S j ∩ E, v x ∂μ))) → Tendsto (fun k => ∫ x in M, u k x ∂μ) atTop (𝓝 (∫ x in M ∩ E, v x ∂μ)) := by
  intro P μ M E S u v D _ hE hS hdisj hSM hnull hD hum hule hv hlim
  -- Step 1: `M =ᵐ ⋃ⱼ Sⱼ` and `M ∩ E =ᵐ ⋃ⱼ (Sⱼ ∩ E)`
  have hUM : (⋃ j, S j) ⊆ M := iUnion_subset hSM
  have hae : M =ᵐ[μ] ⋃ j, S j :=
    ae_eq_set.2 ⟨hnull, by rw [Set.sdiff_eq_empty.2 hUM, measure_empty]⟩
  have haeE : M ∩ E =ᵐ[μ] ⋃ j, S j ∩ E := by
    rw [← iUnion_inter]
    exact hae.inter .rfl
  -- Steps 2–4: `∫_M u k = Σⱼ ∫_{Sⱼ} u k` and `∫_{M ∩ E} v = Σⱼ ∫_{Sⱼ ∩ E} v`
  have hsum_u : ∀ k, HasSum (fun j => ∫ x in S j, u k x ∂μ) (∫ x in M, u k x ∂μ) := by
    intro k
    have hk : IntegrableOn (u k) M μ := Integrable.mono' hD (hum k) (hule k)
    rw [Measure.restrict_congr_set hae]
    exact hasSum_integral_iUnion hS hdisj (hk.congr_set_ae hae.symm)
  have hsum_v : HasSum (fun j => ∫ x in S j ∩ E, v x ∂μ) (∫ x in M ∩ E, v x ∂μ) := by
    rw [Measure.restrict_congr_set haeE]
    exact hasSum_integral_iUnion (fun j => (hS j).inter hE)
      (fun i j hij => (hdisj hij).mono inter_subset_left inter_subset_left)
      (hv.congr_set_ae haeE.symm)
  -- Step 5: `|∫_{Sⱼ} u k| ≤ ∫_{Sⱼ} D`, and `Σⱼ ∫_{Sⱼ} D` converges
  have hsum_D : Summable fun j => ∫ x in S j, D x ∂μ :=
    (hasSum_integral_iUnion hS hdisj (hD.mono_set hUM)).summable
  have hbound : ∀ k j, ‖∫ x in S j, u k x ∂μ‖ ≤ ∫ x in S j, D x ∂μ := fun k j =>
    norm_integral_le_of_norm_le (hD.mono_set (hSM j))
      (ae_restrict_of_ae_restrict_of_subset (hSM j) (hule k))
  -- Step 6: Tannery's theorem, by an `ε/3` argument
  have tannery : ∀ (f : ℕ → ℕ → ℝ) (g bound : ℕ → ℝ), Summable bound →
      (∀ j, Tendsto (fun k => f k j) atTop (𝓝 (g j))) → (∀ k j, ‖f k j‖ ≤ bound j) →
      Tendsto (fun k => ∑' j, f k j) atTop (𝓝 (∑' j, g j)) := by
    intro f g bound h_sum hab h_bound
    have h_g_le (j : ℕ) : ‖g j‖ ≤ bound j :=
      le_of_tendsto (tendsto_norm.comp (hab j)) (Eventually.of_forall fun k => h_bound k j)
    have h_sumg : Summable (‖g ·‖) :=
      h_sum.of_norm_bounded fun j => (norm_norm (g j)).symm ▸ h_g_le j
    have h_suma (k : ℕ) : Summable (‖f k ·‖) :=
      h_sum.of_norm_bounded <| by simpa only [norm_norm] using h_bound k
    rw [Metric.tendsto_nhds]
    intro ε hε
    obtain ⟨B, hB⟩ := h_sum
    obtain ⟨T, hT⟩ : ∃ T : Finset ℕ, dist (∑ j ∈ T, bound j) B < ε / 3 := by
      rw [HasSum, Metric.tendsto_nhds] at hB
      exact Eventually.exists <| hB _ (by positivity)
    -- the tail of `Σ bound` off `T` is `< ε/3`
    have h1 : ∑' (j : (Tᶜ : Set ℕ)), bound j < ε / 3 := by
      calc _ ≤ ‖∑' (j : (Tᶜ : Set ℕ)), bound j‖ := Real.le_norm_self _
           _ = ‖B - ∑ j ∈ T, bound j‖ := congrArg _ ?_
           _ < ε / 3 := by rwa [dist_eq_norm, norm_sub_rev] at hT
      simpa only [hB.summable.sum_add_tsum_compl, eq_sub_iff_add_eq'] using hB.tsum_eq
    -- the finitely many terms on `T` converge
    have h2 : Tendsto (fun k => ∑ j ∈ T, f k j) atTop (𝓝 (∑ j ∈ T, g j)) :=
      tendsto_finsetSum _ fun j _ => hab j
    rw [Metric.tendsto_nhds] at h2
    filter_upwards [h2 (ε / 3) (by positivity)] with k hk
    rw [dist_eq_norm, ← (h_suma k).of_norm.tsum_sub h_sumg.of_norm,
      ← ((h_suma k).of_norm.sub h_sumg.of_norm).sum_add_tsum_compl (s := T),
      (by ring : ε = ε / 3 + (ε / 3 + ε / 3))]
    refine (norm_add_le _ _).trans_lt (add_lt_add ?_ ?_)
    · simpa only [dist_eq_norm, Finset.sum_sub_distrib] using hk
    · rw [((h_suma k).subtype _).of_norm.tsum_sub (h_sumg.subtype _).of_norm]
      refine (norm_sub_le _ _).trans_lt (add_lt_add ?_ ?_)
      · refine ((norm_tsum_le_tsum_norm ((h_suma k).subtype _)).trans ?_).trans_lt h1
        exact ((h_suma k).subtype _).tsum_le_tsum (h_bound k ·) (hB.summable.subtype _)
      · refine ((norm_tsum_le_tsum_norm (h_sumg.subtype _)).trans ?_).trans_lt h1
        exact (h_sumg.subtype _).tsum_le_tsum (h_g_le ·) (hB.summable.subtype _)
  -- Step 7: conclusion
  have key := tannery _ _ _ hsum_D hlim hbound
  rw [hsum_v.tsum_eq] at key
  exact key.congr fun k => (hsum_u k).tsum_eq
/-- **Countably many `C¹` charts inside `U`** (Simon Ch. 2, §4 (4.1); Ch. 3, Lemma 1.2 and
Remark 1.3).  Let `U ⊆ ℝᴾ` be open and `M ⊆ U` with `M ⊆ N₀ ∪ ⋃ₗ Nₗ`, each `Nₗ` an embedded
`m`-dimensional `C¹` submanifold.  Then there are countably many charts `(Vₛ, ψₛ)`: `Vₛ ⊆ ℝᵐ`
open, `ψₛ` `C¹` and injective on `Vₛ` with injective differential at every point of `Vₛ`, and
`ψₛ(Vₛ) ⊆ U`, such that `M ⊆ N₀ ∪ ⋃ₛ ψₛ(Vₛ)`. -/
theorem Submission.dor_lmbsf_cp_submanifold_chart_cover : ∀ (P m : ℕ) (U M N₀ : Set (Euclid P)) (N : ℕ → Set (Euclid P)), IsOpen U → M ⊆ U → (∀ l, IsEmbeddedSubmanifold 1 m (N l)) → M ⊆ N₀ ∪ ⋃ l, N l → ∃ (V : ℕ → Set (Euclid m)) (ψ : ℕ → Euclid m → Euclid P), (∀ s, IsOpen (V s) ∧ ContDiffOn ℝ 1 (ψ s) (V s) ∧ InjOn (ψ s) (V s) ∧ (∀ y ∈ V s, Injective (fderiv ℝ (ψ s) y)) ∧ ψ s '' V s ⊆ U) ∧ M ⊆ N₀ ∪ ⋃ s, ψ s '' V s := by
  classical
  intro P m U M N₀ N hU hMU hN hMN
  -- a chart `(V, W, ψ)` of `Nₗ` at every `z ∈ Nₗ`, with `ψ(V) = W ∩ Nₗ`
  have hch : ∀ (l : ℕ) (z : N l), ∃ (V : Set (Euclid m)) (W : Set (Euclid P))
      (ψ : Euclid m → Euclid P), IsOpen V ∧ IsOpen W ∧ (z : Euclid P) ∈ W ∧
      ContDiffOn ℝ 1 ψ V ∧ InjOn ψ V ∧ ψ '' V = W ∩ N l ∧ ∀ y ∈ V, Injective (fderiv ℝ ψ y) := by
    intro l z
    obtain ⟨V, W, ψ, hV, hW, hzW, hψ, hinj, himg, -, hD⟩ := hN l z z.2
    exact ⟨V, W, ψ, hV, hW, hzW, by simpa using hψ, hinj, himg, hD⟩
  choose V W ψ hV hW hzW hψ hinj himg hD using hch
  -- Lindelöf: countably many `W l z`, `z ∈ T l`, cover `Nₗ`
  have hT : ∀ l, ∃ T : Set (N l), T.Countable ∧ ⋃ z ∈ T, W l z = ⋃ z, W l z :=
    fun l => TopologicalSpace.isOpen_iUnion_countable (W l) (hW l)
  choose T hTc hTU using hT
  let I := Σ l : ℕ, T l
  have : ∀ l, Countable (T l) := fun l => (hTc l).to_subtype
  have : Countable I := inferInstance
  -- shrink each domain to `V ∩ ψ⁻¹(U)`; the extra index `none` carries the empty chart
  let V' : Option I → Set (Euclid m) := fun o =>
    match o with
    | none => ∅
    | some i => V i.1 i.2 ∩ ψ i.1 i.2 ⁻¹' U
  let ψ' : Option I → Euclid m → Euclid P := fun o =>
    match o with
    | none => 0
    | some i => ψ i.1 i.2
  have hchart : ∀ o : Option I, IsOpen (V' o) ∧ ContDiffOn ℝ 1 (ψ' o) (V' o) ∧
      InjOn (ψ' o) (V' o) ∧ (∀ y ∈ V' o, Injective (fderiv ℝ (ψ' o) y)) ∧ ψ' o '' V' o ⊆ U := by
    intro o
    cases o with
    | none => simp [V', ψ']
    | some i =>
      refine ⟨(hψ i.1 i.2).continuousOn.isOpen_inter_preimage (hV i.1 i.2) hU,
        (hψ i.1 i.2).mono inter_subset_left, (hinj i.1 i.2).mono inter_subset_left,
        fun y hy => hD i.1 i.2 y hy.1, ?_⟩
      rintro _ ⟨y, hy, rfl⟩
      exact hy.2
  -- enumerate the countable index set `Option I` by `ℕ`
  obtain ⟨σ, hσ⟩ := exists_surjective_nat (Option I)
  refine ⟨fun s => V' (σ s), fun s => ψ' (σ s), fun s => hchart (σ s), ?_⟩
  -- covering: `x ∈ M ∩ Nₗ` lies in some `W l z ∩ Nₗ = ψ(V)`, and its preimage in `ψ⁻¹(U)`
  intro x hxM
  rcases hMN hxM with h0 | hx
  · exact Or.inl h0
  · right
    obtain ⟨l, hxl⟩ := mem_iUnion.1 hx
    have hxW : x ∈ ⋃ z ∈ T l, W l z := by
      rw [hTU l]
      exact mem_iUnion.2 ⟨⟨x, hxl⟩, hzW l ⟨x, hxl⟩⟩
    obtain ⟨z, hzT, hxz⟩ := mem_iUnion₂.1 hxW
    have hx' : x ∈ ψ l z '' V l z := by
      rw [himg l z]
      exact ⟨hxz, hxl⟩
    obtain ⟨v, hv, hvx⟩ := hx'
    obtain ⟨s, hs⟩ := hσ (some ⟨l, ⟨z, hzT⟩⟩)
    refine mem_iUnion.2 ⟨s, v, ?_, ?_⟩
    · show v ∈ V' (σ s)
      rw [hs]
      exact ⟨hv, by simpa [hvx] using hMU hxM⟩
    · show ψ' (σ s) v = x
      rw [hs]
      exact hvx
/-- **Simon Ch. 3, Lemma 1.2** ("only if", C¹ pieces of a chart), assuming the C¹ approximation
of Lipschitz functions (Ch. 2, Theorem 1.5).  Countably many balls `B_r(c)` with
`B̄_{2r}(c) ⊆ V` cover `V` (Lindelöf); `ψ` is Lipschitz on `B̄_{2r}(c)`, so `f ∘ ψ` has a Lipschitz
extension `ũ` from `B̄_r(c)` (McShane), and `C¹` functions `G_k` agree with `ũ` off a set of
measure `< (k+1)⁻¹`.  The pieces are `B̄_r(c) ∩ {ũ = G_k}` inside `C' = B̄_{2r}(c)`, enumerated
by `ℕ` with an empty piece as padding; the remainder lies in `⋃_b ⋂_k {ũ_b ≠ G_{b,k}}`, a null
set. -/
theorem Submission.dor_lmbsf_cp_chart_c1_pieces : (∀ (m : ℕ) (u : Euclid m → ℝ) (K : NNReal), LipschitzWith K u → ∀ ε : ℝ≥0∞, 0 < ε → ∃ G : Euclid m → ℝ, ContDiff ℝ 1 G ∧ volume {y | u y ≠ G y} < ε) → ∀ (m P : ℕ) (V : Set (Euclid m)) (ψ : Euclid m → Euclid P) (f : Euclid P → ℝ) (L : NNReal), IsOpen V → ContDiffOn ℝ 1 ψ V → LipschitzWith L f → ∃ (C C' : ℕ → Set (Euclid m)) (F : ℕ → Euclid m → ℝ), (∀ k, IsCompact (C k) ∧ IsCompact (C' k) ∧ Convex ℝ (C' k) ∧ C k ⊆ interior (C' k) ∧ C' k ⊆ V ∧ ContDiff ℝ 1 (F k) ∧ ∀ y ∈ C k, f (ψ y) = F k y) ∧ volume (V \ ⋃ k, C k) = 0 := by
  classical
  intro CA m P V ψ f L hV hψ hf
  -- balls `B_r(c)` with `r > 0` and `B̄_{2r}(c) ⊆ V`; countably many of them cover `V`
  let B := {p : Euclid m × ℝ // 0 < p.2 ∧ closedBall p.1 (2 * p.2) ⊆ V}
  obtain ⟨T, hTc, hTU⟩ := TopologicalSpace.isOpen_iUnion_countable
    (fun b : B => ball b.1.1 b.1.2) (fun _ => isOpen_ball)
  have hcovV : V ⊆ ⋃ b ∈ T, ball b.1.1 b.1.2 := by
    intro v hv
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hV v hv
    have hsub : closedBall v (2 * (ε / 3)) ⊆ V :=
      (closedBall_subset_ball (by linarith)).trans hball
    let b : B := ⟨(v, ε / 3), by positivity, hsub⟩
    rw [hTU]
    exact mem_iUnion.2 ⟨b, mem_ball_self (by positivity)⟩
  -- on each ball: a Lipschitz extension `u` of `f ∘ ψ` and `C¹` functions `G k` with
  -- `volume {u ≠ G k} < (k+1)⁻¹`
  have hdata : ∀ b : B, ∃ (G : ℕ → Euclid m → ℝ) (u : Euclid m → ℝ), (∀ k, ContDiff ℝ 1 (G k)) ∧
      Continuous u ∧ (∀ y ∈ closedBall b.1.1 b.1.2, f (ψ y) = u y) ∧
      ∀ k : ℕ, volume {y | u y ≠ G k y} < ((k : ℝ≥0∞) + 1)⁻¹ := by
    intro b
    obtain ⟨Λ, hΛ⟩ := (hψ.mono b.2.2).exists_lipschitzOnWith one_ne_zero (convex_closedBall _ _)
      (isCompact_closedBall _ _)
    have hu : LipschitzOnWith (L * Λ) (f ∘ ψ) (closedBall b.1.1 b.1.2) :=
      (hf.comp_lipschitzOnWith hΛ).mono (closedBall_subset_closedBall (by linarith [b.2.1]))
    obtain ⟨u, hu', hequ⟩ := hu.extend_real
    have hk : ∀ k : ℕ, ∃ G : Euclid m → ℝ, ContDiff ℝ 1 G ∧
        volume {y | u y ≠ G y} < ((k : ℝ≥0∞) + 1)⁻¹ := fun k =>
      CA m u (L * Λ) hu' _ (ENNReal.inv_pos.2 (by simp))
    choose G hG hGvol using hk
    exact ⟨G, u, hG, hu'.continuous, fun y hy => hequ hy, hGvol⟩
  choose G u hG hucont hequ hGvol using hdata
  have : Countable T := hTc.to_subtype
  -- the pieces indexed by `Option (T × ℕ)`, with the empty piece at `none`
  let Cp : Option (T × ℕ) → Set (Euclid m) := fun o =>
    match o with
    | none => ∅
    | some (b, k) => closedBall b.1.1.1 b.1.1.2 ∩ {y | u b.1 y = G b.1 k y}
  let C'p : Option (T × ℕ) → Set (Euclid m) := fun o =>
    match o with
    | none => ∅
    | some (b, _) => closedBall b.1.1.1 (2 * b.1.1.2)
  let Fp : Option (T × ℕ) → Euclid m → ℝ := fun o =>
    match o with
    | none => 0
    | some (b, k) => G b.1 k
  have hprop : ∀ o, IsCompact (Cp o) ∧ IsCompact (C'p o) ∧ Convex ℝ (C'p o) ∧
      Cp o ⊆ interior (C'p o) ∧ C'p o ⊆ V ∧ ContDiff ℝ 1 (Fp o) ∧
      ∀ y ∈ Cp o, f (ψ y) = Fp o y := by
    intro o
    cases o with
    | none => exact ⟨isCompact_empty, isCompact_empty, convex_empty, empty_subset _, empty_subset _,
        contDiff_zero_fun, fun y hy => hy.elim⟩
    | some bk =>
      obtain ⟨b, k⟩ := bk
      refine ⟨(isCompact_closedBall _ _).inter_right
          (isClosed_eq (hucont b.1) (hG b.1 k).continuous),
        isCompact_closedBall _ _, convex_closedBall _ _, ?_, b.1.2.2, hG b.1 k, ?_⟩
      · intro y hy
        apply ball_subset_interior_closedBall
        have := hy.1
        rw [mem_closedBall] at this
        rw [mem_ball]
        linarith [b.1.2.1]
      · intro y hy
        exact (hequ b.1 y hy.1).trans hy.2
  obtain ⟨σ, hσ⟩ := exists_surjective_nat (Option (T × ℕ))
  refine ⟨fun s => Cp (σ s), fun s => C'p (σ s), fun s => Fp (σ s), fun s => hprop (σ s), ?_⟩
  -- the remainder lies in `⋃_b ⋂_k {u_b ≠ G_{b,k}}`
  have hsub : V \ ⋃ s, Cp (σ s) ⊆ ⋃ b : T, ⋂ k : ℕ, {y | u b.1 y ≠ G b.1 k y} := by
    rintro v ⟨hv, hvnot⟩
    obtain ⟨b, hbT, hvb⟩ := mem_iUnion₂.1 (hcovV hv)
    refine mem_iUnion.2 ⟨⟨b, hbT⟩, mem_iInter.2 fun k => ?_⟩
    intro heq
    obtain ⟨s, hs⟩ := hσ (some (⟨b, hbT⟩, k))
    apply hvnot
    refine mem_iUnion.2 ⟨s, ?_⟩
    rw [hs]
    exact ⟨ball_subset_closedBall hvb, heq⟩
  refine measure_mono_null hsub (measure_iUnion_null fun b => ?_)
  -- each `⋂_k {u_b ≠ G_{b,k}}` has measure `< (n+1)⁻¹ ≤ n⁻¹` for every `n`
  by_contra hne
  obtain ⟨n, hn⟩ := ENNReal.exists_inv_nat_lt hne
  have h1 : volume (⋂ k : ℕ, {y | u b.1 y ≠ G b.1 k y}) ≤ ((n : ℝ≥0∞) + 1)⁻¹ :=
    (measure_mono (iInter_subset _ n)).trans (hGvol b.1 n).le
  have h2 : ((n : ℝ≥0∞) + 1)⁻¹ ≤ (n : ℝ≥0∞)⁻¹ :=
    ENNReal.inv_le_inv.2 le_self_add
  exact absurd (h1.trans h2) (not_le.2 hn)
/-- **Lipschitz (`C¹`) images of Lebesgue-null sets are `Hᵐ`-null** (Simon Ch. 3, §2, discussion
after 2.4; Ch. 2, Theorem 1.8(i)).  If `ψ` is `C¹` on an open `V ⊆ ℝᵐ` and `Z ⊆ V` is `Lᵐ`-null,
then `Hᵐ(ψ(Z)) = 0`: `ψ` is Lipschitz near each point of `V`, countably many such neighbourhoods
cover `V` (Lindelöf), and on each the Lipschitz image bound gives `Hᵐ(ψ(Z ∩ t)) ≤ Kᵐ Lᵐ(Z ∩ t) = 0`.
-/
theorem Submission.dor_lmbsf_cp_c1_image_null : ∀ (m P : ℕ) (V Z : Set (Euclid m)) (ψ : Euclid m → Euclid P), IsOpen V → ContDiffOn ℝ 1 ψ V → Z ⊆ V → volume Z = 0 → μHE[m] (ψ '' Z) = 0 := by
  intro m P V Z ψ hV hψ hZV hZ
  -- Step 1: every `y ∈ V` has an open neighbourhood on which `ψ` is Lipschitz
  have hloc : ∀ y : V, ∃ K : NNReal, ∃ t : Set (Euclid m), IsOpen t ∧ (y : Euclid m) ∈ t ∧
      LipschitzOnWith K ψ t := by
    intro y
    obtain ⟨K, t, ht, hK⟩ := (hψ.contDiffAt (hV.mem_nhds y.2)).exists_lipschitzOnWith
    obtain ⟨u, hut, hu, hyu⟩ := _root_.mem_nhds_iff.1 ht
    exact ⟨K, u, hu, hyu, hK.mono hut⟩
  choose K t ht hyt hK using hloc
  -- Step 2: Lindelöf gives a countable subfamily covering `V ⊇ Z`
  obtain ⟨T, hTc, hT⟩ := TopologicalSpace.isOpen_iUnion_countable t ht
  have hcov : Z ⊆ ⋃ y ∈ T, t y := by
    intro z hz
    have : z ∈ ⋃ y, t y := mem_iUnion.2 ⟨⟨z, hZV hz⟩, hyt _⟩
    rw [← hT] at this
    exact this
  -- Step 3: `ψ(Z) ⊆ ⋃_{y ∈ T} ψ(Z ∩ t y)`
  have hsub : ψ '' Z ⊆ ⋃ y ∈ T, ψ '' (Z ∩ t y) := by
    rintro _ ⟨z, hz, rfl⟩
    obtain ⟨y, hyT, hzy⟩ := mem_iUnion₂.1 (hcov hz)
    exact mem_iUnion₂.2 ⟨y, hyT, z, ⟨hz, hzy⟩, rfl⟩
  -- Steps 4 and 5: each piece is null by the Lipschitz image bound and `μHE[m] = volume`
  refine measure_mono_null hsub ((measure_biUnion_null_iff hTc).2 fun y _ => ?_)
  refine le_antisymm ?_ zero_le
  calc μHE[m] (ψ '' (Z ∩ t y)) ≤ (K y : ℝ≥0∞) ^ m * μHE[m] (Z ∩ t y) :=
        Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn m
          ((hK y).mono inter_subset_right)
    _ = 0 := by
        rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume,
          measure_mono_null inter_subset_left hZ, mul_zero]
/-- **Approximate tangent planes of `M` on a chart piece** (Simon Ch. 3, Remark 1.5(2) and the
proof of Theorem 1.6 "⇒"; Step 7 of `dor_lmbsf_lipschitz_chart_pieces`).  Assume the locality
principle (TL): for Borel `A ⊆ B ⊆ U` with `Hⁿ(B ∩ K) < ∞` for compact `K ⊆ U`, at `Hⁿ`-a.e.
`x ∈ A` the sets `B` and `A` have the same approximate tangent spaces.  Let `ψ` be `C¹` on the
convex compact `C'` with `ψ(C') ⊆ U`, let `C ⊆ int C'` be compact, and let `ψ(C')` have
approximate tangent space `Dψ(y)(ℝᵐ)` at `ψ(y)` for `y ∈ int C'`.  Then at `Hᵐ`-a.e.
`x ∈ M ∩ ψ(C)`, `M` has approximate tangent space `Dψ(y)(ℝᵐ)` for every `y ∈ C` with `ψ(y) = x`.
`S = ψ(C')` is compact, and `Hᵐ(S) ≤ Λᵐ Lᵐ(C') < ∞` since `ψ` is Lipschitz on `C'`; apply (TL)
to `M ∩ ψ(C) ⊆ S` and to `M ∩ ψ(C) ⊆ M`. -/
theorem Submission.dor_lmbsf_cp_chart_tangent_ae : (∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q) → ∀ (P m : ℕ) (U M : Set (Euclid P)) (C C' : Set (Euclid m)) (ψ : Euclid m → Euclid P), IsOpen U → MeasurableSet M → M ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[m] (M ∩ K) ≠ ∞) → ContDiffOn ℝ 1 ψ C' → ψ '' C' ⊆ U → IsCompact C → IsCompact C' → Convex ℝ C' → C ⊆ interior C' → (∀ y ∈ interior C', HasApproximateTangentSpaceAt m (ψ '' C') (ψ y) (LinearMap.range (fderiv ℝ ψ y : Euclid m →ₗ[ℝ] Euclid P))) → ∀ᵐ x ∂(μHE[m].restrict (M ∩ ψ '' C)), ∀ y ∈ C, ψ y = x → HasApproximateTangentSpaceAt m M x (LinearMap.range (fderiv ℝ ψ y : Euclid m →ₗ[ℝ] Euclid P)) := by
  intro TL P m U M C C' ψ hU hM hMU hfin hψ hψU hC hC' hconv hCC' hIT
  have hψC' : ContinuousOn ψ C' := hψ.continuousOn
  have hCsub : C ⊆ C' := hCC'.trans interior_subset
  -- `S = ψ(C')` and `ψ(C)` are compact
  have hS : IsCompact (ψ '' C') := hC'.image_of_continuousOn hψC'
  have hSC : IsCompact (ψ '' C) := hC.image_of_continuousOn (hψC'.mono hCsub)
  -- `Hᵐ(S) ≤ Λᵐ Hᵐ(C') = Λᵐ Lᵐ(C') < ∞`, `ψ` being `Λ`-Lipschitz on the convex compact `C'`
  obtain ⟨Λ, hΛ⟩ := hψ.exists_lipschitzOnWith one_ne_zero hconv hC'
  have hSfin : μHE[m] (ψ '' C') ≠ ∞ := by
    refine ne_of_lt (lt_of_le_of_lt
      (Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn m hΛ) ?_)
    rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
    exact ENNReal.mul_lt_top (ENNReal.pow_lt_top ENNReal.coe_lt_top) hC'.measure_lt_top
  -- (TL) for `A = M ∩ ψ(C) ⊆ S` and for `A ⊆ M`
  have hA : MeasurableSet (M ∩ ψ '' C) := hM.inter hSC.isClosed.measurableSet
  have h1 := TL P m U (M ∩ ψ '' C) (ψ '' C') hU hA hS.isClosed.measurableSet
    (fun x hx => image_mono hCsub hx.2) hψU
    (fun K _ _ => ne_top_of_le_ne_top hSfin (measure_mono inter_subset_left))
  have h2 := TL P m U (M ∩ ψ '' C) M hU hA hM inter_subset_left hMU hfin
  -- at `x = ψ y`, transfer the tangent plane of `S` to `A`, then to `M`
  filter_upwards [h1, h2] with x hx1 hx2 y hy hyx
  have hS' := hIT y (hCC' hy)
  rw [hyx] at hS'
  exact (hx2 _).2 ((hx1 _).1 hS')
/-- **Slicing (Simon Ch. 6, §4), chart pieces, step 8: the gradient bound at density points**
(the estimate behind `|∇ᴹf| ≤ Lip f`, cf. Simon Ch. 3, 2.1 and Ch. 2, 4.10).  Let `F = f ∘ ψ` on
a Borel set `Z ⊆ ℝᵐ`, with `F` and `ψ` differentiable at every point of `Z` and `f`
`L`-Lipschitz.  Assuming the direction property (DD) of density points, `|DF(y)e| ≤ L |Dψ(y)e|`
for `Lᵐ`-a.e. `y ∈ Z` and every `e`.  By the Lebesgue density theorem
(`Besicovitch.ae_tendsto_measure_inter_div_of_measurableSet`) a.e. `y ∈ Z` is a density point of
`Z`.  For a unit vector `v`, (DD) gives `yᵢ ∈ Z ∖ {y}` with `yᵢ → y` and
`(yᵢ − y)/|yᵢ − y| → v`.  The difference quotients satisfy `|F(yᵢ) − F(y)| ≤ L |ψ(yᵢ) − ψ(y)|`
and converge to `DF(y)v` and `Dψ(y)v` (`HasFDerivWithinAt.lim`), so `|DF(y)v| ≤ L |Dψ(y)v|`.
A general `e ≠ 0` follows by linearity from `v = e/|e|`. -/
theorem Submission.dor_lmbsf_cp_gradient_bound_ae : (∀ (d : ℕ) (Z : Set (Euclid d)) (y : Euclid d), Tendsto (fun r => volume (Z ∩ closedBall y r) / volume (closedBall y r)) (𝓝[>] 0) (𝓝 1) → ∀ v : Euclid d, ‖v‖ = 1 → ∃ ys : ℕ → Euclid d, (∀ i, ys i ∈ Z ∧ ys i ≠ y) ∧ Tendsto ys atTop (𝓝 y) ∧ Tendsto (fun i => ‖ys i - y‖⁻¹ • (ys i - y)) atTop (𝓝 v)) → ∀ (m P : ℕ) (Z : Set (Euclid m)) (F : Euclid m → ℝ) (ψ : Euclid m → Euclid P) (f : Euclid P → ℝ) (L : NNReal), MeasurableSet Z → (∀ y ∈ Z, DifferentiableAt ℝ F y ∧ DifferentiableAt ℝ ψ y) → (∀ y ∈ Z, f (ψ y) = F y) → LipschitzWith L f → ∀ᵐ y ∂volume, y ∈ Z → ∀ e : Euclid m, |fderiv ℝ F y e| ≤ (L : ℝ) * ‖fderiv ℝ ψ y e‖ := by
  intro DD m P Z F ψ f L hZ hdiff heq hf
  -- step 1: almost every point of `Z` is a Lebesgue density point of `Z`
  filter_upwards [Besicovitch.ae_tendsto_measure_inter_div_of_measurableSet volume hZ] with y hy hyZ
  have hdens : Tendsto (fun r => volume (Z ∩ closedBall y r) / volume (closedBall y r))
      (𝓝[>] 0) (𝓝 1) := by
    simpa [Set.indicator_of_mem hyZ] using hy
  -- steps 2–5: the bound in a unit direction `v`
  have hunit : ∀ v : Euclid m, ‖v‖ = 1 → |fderiv ℝ F y v| ≤ (L : ℝ) * ‖fderiv ℝ ψ y v‖ := by
    intro v hv
    -- step 2: points `yᵢ ∈ Z ∖ {y}`, `yᵢ → y`, approaching `y` from the direction `v`
    obtain ⟨ys, hys, hlim, hdir⟩ := DD m Z y hdens v hv
    -- step 3: `|F(yᵢ) − F(y)| = |f(ψ(yᵢ)) − f(ψ(y))| ≤ L |ψ(yᵢ) − ψ(y)|`, divided by `|yᵢ − y|`
    have hineq : ∀ i, |‖ys i - y‖⁻¹ • (F (ys i) - F y)| ≤
        (L : ℝ) * ‖‖ys i - y‖⁻¹ • (ψ (ys i) - ψ y)‖ := by
      intro i
      have hci : 0 ≤ ‖ys i - y‖⁻¹ := inv_nonneg.2 (norm_nonneg _)
      rw [smul_eq_mul, abs_mul, abs_of_nonneg hci, norm_smul, Real.norm_of_nonneg hci,
        ← heq _ (hys i).1, ← heq y hyZ]
      have h1 := hf.dist_le_mul (ψ (ys i)) (ψ y)
      rw [Real.dist_eq, dist_eq_norm] at h1
      calc ‖ys i - y‖⁻¹ * |f (ψ (ys i)) - f (ψ y)|
          ≤ ‖ys i - y‖⁻¹ * ((L : ℝ) * ‖ψ (ys i) - ψ y‖) := mul_le_mul_of_nonneg_left h1 hci
        _ = (L : ℝ) * (‖ys i - y‖⁻¹ * ‖ψ (ys i) - ψ y‖) := by ring
    -- step 4: the difference quotients along `yᵢ − y` converge to `DF(y)v` and `Dψ(y)v`
    have hd0 : Tendsto (fun i => ys i - y) atTop (𝓝 0) := by
      simpa using hlim.sub_const y
    have hF' := ((hdiff y hyZ).1.hasFDerivAt.hasFDerivWithinAt (s := univ)).lim hd0
      (Eventually.of_forall fun _ => mem_univ _) hdir
    have hψ' := ((hdiff y hyZ).2.hasFDerivAt.hasFDerivWithinAt (s := univ)).lim hd0
      (Eventually.of_forall fun _ => mem_univ _) hdir
    simp only [add_sub_cancel] at hF' hψ'
    -- step 5: the non-strict inequality passes to the limit
    exact le_of_tendsto_of_tendsto' hF'.abs (hψ'.norm.const_mul _) hineq
  -- step 6: a general `e ≠ 0` by linearity, from the unit vector `‖e‖⁻¹ • e`
  intro e
  by_cases he : e = 0
  · simp [he]
  · have hne : ‖e‖ ≠ 0 := norm_ne_zero_iff.2 he
    have hv : ‖‖e‖⁻¹ • e‖ = 1 := by
      rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hne]
    have h := hunit _ hv
    rw [map_smul, map_smul, smul_eq_mul, abs_mul, norm_smul, abs_inv, abs_norm, norm_inv,
      norm_norm] at h
    have hpos : 0 < ‖e‖⁻¹ := inv_pos.2 (norm_pos_iff.2 he)
    have h2 : ‖e‖⁻¹ * |fderiv ℝ F y e| ≤ ‖e‖⁻¹ * ((L : ℝ) * ‖fderiv ℝ ψ y e‖) := by
      calc ‖e‖⁻¹ * |fderiv ℝ F y e| ≤ (L : ℝ) * (‖e‖⁻¹ * ‖fderiv ℝ ψ y e‖) := h
        _ = ‖e‖⁻¹ * ((L : ℝ) * ‖fderiv ℝ ψ y e‖) := by ring
    exact le_of_mul_le_mul_left h2 hpos
/-- **Disjoint Borel refinement of chart pieces** (Simon Ch. 3, Remark 1.3).  Let `M ⊆ ℝᴾ` be
Borel, `Cⱼ ⊆ ℝᵐ` compact and `ψⱼ` continuous on `Cⱼ`, with `μ(M ∖ ⋃ⱼ ψⱼ(Cⱼ)) = 0`, and suppose
that for `μ⌞(M ∩ ψⱼ(Cⱼ))`-a.e. `x` every `y ∈ Cⱼ` with `ψⱼ(y) = x` satisfies `Goodⱼ(y)`.  Then
there are Borel sets `Yⱼ ⊆ Cⱼ` of good points whose images `ψⱼ(Yⱼ) ⊆ M` are pairwise disjoint
and cover `M` up to a `μ`-null set. -/
theorem Submission.dor_lmbsf_cp_disjoint_refinement : ∀ (m P : ℕ) (μ : Measure (Euclid P)) (M : Set (Euclid P)) (C : ℕ → Set (Euclid m)) (ψ : ℕ → Euclid m → Euclid P) (Good : ℕ → Euclid m → Prop), MeasurableSet M → (∀ j, IsCompact (C j) ∧ ContinuousOn (ψ j) (C j)) → μ (M \ ⋃ j, ψ j '' C j) = 0 → (∀ j, ∀ᵐ x ∂(μ.restrict (M ∩ ψ j '' C j)), ∀ y ∈ C j, ψ j y = x → Good j y) → ∃ Y : ℕ → Set (Euclid m), (∀ j, MeasurableSet (Y j) ∧ Y j ⊆ C j ∧ ψ j '' Y j ⊆ M ∧ ∀ y ∈ Y j, Good j y) ∧ Pairwise (fun i j => Disjoint (ψ i '' Y i) (ψ j '' Y j)) ∧ μ (M \ ⋃ j, ψ j '' Y j) = 0 := by
  classical
  intro m P μ M C ψ Good hM hC hnull hgood
  -- `Eⱼ = ψⱼ(Cⱼ)` is compact, hence Borel, and `Aⱼ = M ∩ Eⱼ` is Borel
  let E : ℕ → Set (Euclid P) := fun j => ψ j '' C j
  have hEc : ∀ j, IsCompact (E j) := fun j => (hC j).1.image_of_continuousOn (hC j).2
  have hEm : ∀ j, MeasurableSet (E j) := fun j => (hEc j).isClosed.measurableSet
  let A : ℕ → Set (Euclid P) := fun j => M ∩ E j
  have hAm : ∀ j, MeasurableSet (A j) := fun j => hM.inter (hEm j)
  -- a Borel set `Tⱼ` containing the exceptional points, with `μ(Tⱼ ∩ Aⱼ) = 0`
  have hT : ∀ j, ∃ T : Set (Euclid P), {x | ¬ ∀ y ∈ C j, ψ j y = x → Good j y} ⊆ T ∧
      MeasurableSet T ∧ μ (T ∩ A j) = 0 := by
    intro j
    obtain ⟨T, hsub, hTm, hT0⟩ := exists_measurable_superset_of_null (ae_iff.1 (hgood j))
    exact ⟨T, hsub, hTm, by rwa [Measure.restrict_apply hTm] at hT0⟩
  choose T hTsub hTm hT0 using hT
  -- Remark 1.3: `Dⱼ = Aⱼ ∖ ⋃_{i<j} Aᵢ`; then `M'ⱼ = Dⱼ ∖ Tⱼ` and `Yⱼ = Cⱼ ∩ ψⱼ⁻¹(M'ⱼ)`
  let D : ℕ → Set (Euclid P) := disjointed A
  let M' : ℕ → Set (Euclid P) := fun j => D j \ T j
  have hDm : ∀ j, MeasurableSet (D j) := MeasurableSet.disjointed hAm
  have hM'm : ∀ j, MeasurableSet (M' j) := fun j => (hDm j).diff (hTm j)
  have hDA : ∀ j, D j ⊆ A j := disjointed_subset A
  -- `ψⱼ(Yⱼ) = M'ⱼ`, since `M'ⱼ ⊆ Aⱼ ⊆ ψⱼ(Cⱼ)`
  have himg : ∀ j, ψ j '' (C j ∩ ψ j ⁻¹' M' j) = M' j := by
    intro j
    ext x
    constructor
    · rintro ⟨y, ⟨_, hy⟩, rfl⟩
      exact hy
    · intro hx
      obtain ⟨y, hy, rfl⟩ := (hDA j hx.1).2
      exact ⟨y, ⟨hy, hx⟩, rfl⟩
  refine ⟨fun j => C j ∩ ψ j ⁻¹' M' j, fun j => ⟨?_, inter_subset_left, ?_, ?_⟩, ?_, ?_⟩
  · -- `Yⱼ` is Borel: on `Cⱼ`, `ψⱼ` agrees with the Borel map equal to `ψⱼ` on `Cⱼ`, `0` off it
    have hpw : Measurable ((C j).piecewise (ψ j) (fun _ => 0)) :=
      (hC j).2.measurable_piecewise continuousOn_const (hC j).1.isClosed.measurableSet
    have : C j ∩ ψ j ⁻¹' M' j = C j ∩ (C j).piecewise (ψ j) (fun _ => 0) ⁻¹' M' j := by
      ext y
      constructor
      · rintro ⟨hy, hy'⟩
        exact ⟨hy, by simpa [Set.piecewise_eq_of_mem _ _ _ hy] using hy'⟩
      · rintro ⟨hy, hy'⟩
        exact ⟨hy, by simpa [Set.piecewise_eq_of_mem _ _ _ hy] using hy'⟩
    show MeasurableSet (C j ∩ ψ j ⁻¹' M' j)
    rw [this]
    exact (hC j).1.isClosed.measurableSet.inter (hpw (hM'm j))
  · -- `ψⱼ(Yⱼ) = M'ⱼ ⊆ Aⱼ ⊆ M`
    rw [himg j]
    exact fun x hx => (hDA j hx.1).1
  · -- points of `Yⱼ` are good, since `ψⱼ(y) ∉ Tⱼ`
    intro y hy
    have hx : ψ j y ∉ T j := hy.2.2
    have : ψ j y ∉ {x | ¬ ∀ y ∈ C j, ψ j y = x → Good j y} := fun h => hx (hTsub j h)
    simp only [mem_ofPred_eq, not_not] at this
    exact this y hy.1 rfl
  · -- the images lie in the pairwise disjoint `Dⱼ`
    intro i j hij
    simp only
    rw [himg i, himg j]
    exact (disjoint_disjointed A hij).mono sdiff_subset sdiff_subset
  · -- `M ∖ ⋃ⱼ ψⱼ(Yⱼ) ⊆ (M ∖ ⋃ⱼ Eⱼ) ∪ ⋃ⱼ (Tⱼ ∩ Aⱼ)`, a `μ`-null set
    have hsub : M \ ⋃ j, ψ j '' (C j ∩ ψ j ⁻¹' M' j) ⊆ (M \ ⋃ j, E j) ∪ ⋃ j, (T j ∩ A j) := by
      rintro x ⟨hxM, hxnot⟩
      by_cases hxE : x ∈ ⋃ j, E j
      · right
        have hxA : x ∈ ⋃ j, A j := by
          obtain ⟨j, hj⟩ := mem_iUnion.1 hxE
          exact mem_iUnion.2 ⟨j, hxM, hj⟩
        rw [← iUnion_disjointed] at hxA
        obtain ⟨j, hj⟩ := mem_iUnion.1 hxA
        have hxT : x ∈ T j := by
          by_contra hxT
          exact hxnot (mem_iUnion.2 ⟨j, by rw [himg j]; exact ⟨hj, hxT⟩⟩)
        exact mem_iUnion.2 ⟨j, hxT, hDA j hj⟩
      · exact Or.inl ⟨hxM, hxE⟩
    refine measure_mono_null hsub ?_
    rw [measure_union_null_iff]
    exact ⟨hnull, measure_iUnion_null hT0⟩
/-- **Tangential lift of a gradient on a `C¹` chart** (Simon Ch. 2, §4; Ch. 3, 2.1).  Let `ψ` be
`C¹` on the open set `V ⊆ ℝᵐ` with injective differential and `F : ℝᵐ → ℝ` be `C¹`.  With
`A(y) = Dψ(y)`, `Γ(y) = A(y)* A(y)` and `a(y)` the Riesz vector of `DF(y)`, the field
`Φ(y) = A(y) Γ(y)⁻¹ a(y)` is continuous on `V`, lies in `Dψ(y)(ℝᵐ)`, satisfies
`⟨Φ(y), Dψ(y)e⟩ = DF(y)e`, and `|Φ(y)| ≤ L` whenever `|DF(y)e| ≤ L |Dψ(y)e|` for all `e`. -/
theorem Submission.dor_lmbsf_cp_chart_tangent_lift : ∀ (m P : ℕ) (V : Set (Euclid m)) (ψ : Euclid m → Euclid P) (F : Euclid m → ℝ), IsOpen V → ContDiffOn ℝ 1 ψ V → (∀ y ∈ V, Injective (fderiv ℝ ψ y)) → ContDiff ℝ 1 F → ∃ Φ : Euclid m → Euclid P, ContinuousOn Φ V ∧ ∀ y ∈ V, Φ y ∈ LinearMap.range (fderiv ℝ ψ y : Euclid m →ₗ[ℝ] Euclid P) ∧ (∀ e : Euclid m, inner ℝ (Φ y) (fderiv ℝ ψ y e) = fderiv ℝ F y e) ∧ ∀ L : NNReal, (∀ e : Euclid m, |fderiv ℝ F y e| ≤ (L : ℝ) * ‖fderiv ℝ ψ y e‖) → ‖Φ y‖ ≤ (L : ℝ) := by
  classical
  intro m P V ψ F hV hψ hinj hF
  let A : Euclid m → (Euclid m →L[ℝ] Euclid P) := fun y => fderiv ℝ ψ y
  let Γ : Euclid m → (Euclid m →L[ℝ] Euclid m) :=
    fun y => (ContinuousLinearMap.adjoint (A y)).comp (A y)
  let a : Euclid m → Euclid m :=
    fun y => (InnerProductSpace.toDual ℝ (Euclid m)).symm (fderiv ℝ F y)
  -- `Γ(y)` is injective, hence a unit, on `V`
  have hunit : ∀ y ∈ V, IsUnit (Γ y) := by
    intro y hy
    rw [ContinuousLinearMap.isUnit_iff_isUnit_toLinearMap, LinearMap.isUnit_iff_ker_eq_bot,
      LinearMap.ker_eq_bot']
    intro e he
    have h1 : inner ℝ (Γ y e) e = ‖A y e‖ ^ 2 := by
      simp only [Γ, ContinuousLinearMap.comp_apply, ContinuousLinearMap.adjoint_inner_left]
      exact real_inner_self_eq_norm_sq (A y e)
    have h2 : Γ y e = 0 := he
    rw [h2, inner_zero_left] at h1
    have h3 : A y e = 0 := by
      have : ‖A y e‖ = 0 := by nlinarith [norm_nonneg (A y e)]
      exact norm_eq_zero.1 this
    exact hinj y hy (by simpa [A] using h3)
  refine ⟨fun y => A y (Ring.inverse (Γ y) (a y)), ?_, ?_⟩
  · -- continuity: `fderiv`, adjoint, composition, `Ring.inverse` at units, evaluation
    have hA : ContinuousOn A V := hψ.continuousOn_fderiv_of_isOpen hV le_rfl
    have hAadj : ContinuousOn (fun y => ContinuousLinearMap.adjoint (A y)) V :=
      (ContinuousLinearMap.adjoint (𝕜 := ℝ) (E := Euclid m) (F := Euclid P)).continuous
        |>.comp_continuousOn hA
    have hΓ : ContinuousOn Γ V := hAadj.clm_comp hA
    have hinv : ContinuousOn (fun y => Ring.inverse (Γ y)) V := by
      intro y hy
      obtain ⟨u, hu⟩ := hunit y hy
      have hc := NormedRing.inverse_continuousAt u
      rw [hu] at hc
      exact hc.comp_continuousWithinAt (hΓ y hy)
    have ha : Continuous a :=
      (InnerProductSpace.toDual ℝ (Euclid m)).symm.continuous.comp
        (hF.continuous_fderiv one_ne_zero)
    exact hA.clm_apply (hinv.clm_apply ha.continuousOn)
  · intro y hy
    set w := Ring.inverse (Γ y) (a y) with hw
    have hΓw : Γ y w = a y := by
      obtain ⟨u, hu⟩ := hunit y hy
      rw [hw, ← hu, Ring.inverse_unit, ← mul_apply_eq_comp, Units.mul_inv, one_apply_eq_self]
    -- the defining identity `⟨A w, A e⟩ = ⟨Γ w, e⟩ = ⟨a, e⟩ = DF(y) e`
    have hdef : ∀ e : Euclid m, inner ℝ (A y w) (fderiv ℝ ψ y e) = fderiv ℝ F y e := by
      intro e
      have : inner ℝ (A y w) (A y e) = inner ℝ (Γ y w) e := by
        simp only [Γ, ContinuousLinearMap.comp_apply, ContinuousLinearMap.adjoint_inner_left]
      change inner ℝ (A y w) (A y e) = _
      rw [this, hΓw]
      simp [a, InnerProductSpace.toDual_symm_apply]
    refine ⟨⟨w, rfl⟩, hdef, fun L hL => ?_⟩
    -- `|Φ|² = DF(y) w ≤ L |A w| = L |Φ|`
    have hsq : ‖A y w‖ ^ 2 ≤ (L : ℝ) * ‖A y w‖ := by
      rw [← real_inner_self_eq_norm_sq]
      calc inner ℝ (A y w) (A y w) = fderiv ℝ F y w := hdef w
        _ ≤ |fderiv ℝ F y w| := le_abs_self _
        _ ≤ (L : ℝ) * ‖fderiv ℝ ψ y w‖ := hL w
    change ‖A y w‖ ≤ (L : ℝ)
    by_cases h0 : ‖A y w‖ = 0
    · rw [h0]; exact L.coe_nonneg
    · have hpos : 0 < ‖A y w‖ := lt_of_le_of_ne (norm_nonneg _) (Ne.symm h0)
      nlinarith
/-- Borel gluing over pairwise disjoint injective images (Lusin–Souslin; the Borel field `g` on
the chart pieces in the slicing step of the proof of Simon 7.4.3): if `ψⱼ` is continuous and
injective and `Φⱼ` continuous on the Borel set `Yⱼ ⊆ ℝᵐ`, and the images `Mⱼ = ψⱼ(Yⱼ)` are
pairwise disjoint, then some Borel `g : ℝᴾ → ℝᴾ` has `g(ψⱼ(y)) = Φⱼ(y)` for `y ∈ Yⱼ` and `g = 0`
off `⋃ⱼ Mⱼ`.  `ψⱼ|_{Yⱼ}` is a measurable embedding, so the extension `gⱼ` of `Φⱼ|_{Yⱼ}` along it
by `0` is Borel; `g(x) = gₙ(x)` for the least `n` with `x ∈ Mₙ ∪ (⋃ⱼ Mⱼ)ᶜ`. -/
theorem Submission.dor_lmbsf_cp_measurable_glue : ∀ (m P : ℕ) (Y : ℕ → Set (Euclid m)) (ψ Φ : ℕ → Euclid m → Euclid P), (∀ j, MeasurableSet (Y j) ∧ ContinuousOn (ψ j) (Y j) ∧ InjOn (ψ j) (Y j) ∧ ContinuousOn (Φ j) (Y j)) → Pairwise (fun i j => Disjoint (ψ i '' Y i) (ψ j '' Y j)) → ∃ g : Euclid P → Euclid P, Measurable g ∧ (∀ j, ∀ y ∈ Y j, g (ψ j y) = Φ j y) ∧ ∀ x, (∀ j, x ∉ ψ j '' Y j) → g x = 0 := by
  classical
  intro m P Y ψ Φ hY hdisj
  -- Lusin–Souslin: `Mⱼ = ψⱼ(Yⱼ)` is Borel
  have hM : ∀ j, MeasurableSet (ψ j '' Y j) := fun j =>
    (hY j).1.image_of_continuousOn_injOn (hY j).2.1 (hY j).2.2.1
  -- `gⱼ`: the extension of `Φⱼ|_{Yⱼ}` by `0` along the measurable embedding `ψⱼ|_{Yⱼ}`
  obtain ⟨gj, hgj, hgj_val, hgj_zero⟩ : ∃ gj : ℕ → Euclid P → Euclid P,
      (∀ j, Measurable (gj j)) ∧ (∀ j, ∀ y ∈ Y j, gj j (ψ j y) = Φ j y) ∧
        ∀ j x, x ∉ ψ j '' Y j → gj j x = 0 := by
    have hemb : ∀ j, MeasurableEmbedding ((Y j).domRestrict (ψ j)) := fun j =>
      (hY j).2.1.measurableEmbedding (hY j).1 (hY j).2.2.1
    refine ⟨fun j => Function.extend ((Y j).domRestrict (ψ j)) ((Y j).domRestrict (Φ j)) 0,
      fun j => (hemb j).measurable_extend (hY j).2.2.2.domRestrict.measurable measurable_const,
      fun j y hy => (hemb j).injective.extend_apply _ _ ⟨y, hy⟩, fun j x hx => ?_⟩
    refine Function.extend_apply' _ _ x ?_
    rintro ⟨y, hy⟩
    exact hx ⟨y, y.2, hy⟩
  -- glue by least index: `g(x) = gₙ(x)` for the least `n` with `x ∈ Mₙ ∪ (⋃ⱼ Mⱼ)ᶜ`
  have hp : ∀ x, ∃ n, x ∈ ψ n '' Y n ∪ (⋃ j, ψ j '' Y j)ᶜ := fun x => by
    by_cases hx : x ∈ ⋃ j, ψ j '' Y j
    · obtain ⟨j, hj⟩ := Set.mem_iUnion.1 hx
      exact ⟨j, Set.mem_union_left _ hj⟩
    · exact ⟨0, Set.mem_union_right _ (Set.mem_compl hx)⟩
  refine ⟨fun x => gj (Nat.find (hp x)) x,
    Measurable.find (p := fun n x => x ∈ ψ n '' Y n ∪ (⋃ j, ψ j '' Y j)ᶜ) hgj
      (fun n => (hM n).union (MeasurableSet.iUnion hM).compl) hp, ?_, ?_⟩
  · -- at `ψⱼ(y)` the least index is `j`, by disjointness
    intro j y hy
    have hx : ψ j y ∈ ψ j '' Y j := Set.mem_image_of_mem _ hy
    have hfind : Nat.find (hp (ψ j y)) = j := by
      rcases Nat.find_spec (hp (ψ j y)) with h | h
      · by_contra hne
        exact Set.disjoint_left.1 (hdisj hne) h hx
      · exact absurd (Set.mem_iUnion.2 ⟨j, hx⟩) h
    show gj (Nat.find (hp (ψ j y))) (ψ j y) = Φ j y
    rw [hfind]
    exact hgj_val j y hy
  · -- off `⋃ⱼ Mⱼ` every `gₙ` vanishes
    intro x hx
    exact hgj_zero _ x (hx _)
/-- **A `C¹` immersion is locally injective.**  If `G : ℝᵐ → ℝᴾ` is `C¹` and `DG(x)` is injective,
then for some `r > 0` the map `G` and every `DG(z)`, `z ∈ B̄_r(x)`, are injective.  `L = DG(x)` is
anti-Lipschitz on the finite-dimensional `ℝᵐ`, `c ‖v‖ ≤ ‖L v‖` with `c > 0`, and continuity of
`DG` gives `‖DG(z) - L‖ ≤ c/2` on `B̄_r(x)`.  If `DG(z) u = 0` then
`c ‖u‖ ≤ ‖L u‖ = ‖(DG(z) - L) u‖ ≤ (c/2) ‖u‖`; if `G a = G b`, the mean value inequality
`‖G a - G b - L (a - b)‖ ≤ (c/2) ‖a - b‖` gives `c ‖a - b‖ ≤ (c/2) ‖a - b‖`.  So `u = 0`, `a = b`. -/
theorem Submission.dor_lmbsf_c1c_immersion_local_injOn : ∀ (P m : ℕ) (G : Euclid m → Euclid P) (x : Euclid m), ContDiff ℝ 1 G → Function.Injective (fderiv ℝ G x) → ∃ r : ℝ, 0 < r ∧ Set.InjOn G (Metric.closedBall x r) ∧ ∀ z ∈ Metric.closedBall x r, Function.Injective (fderiv ℝ G z) := by
  intro P m G x hG hx
  set L : Euclid m →L[ℝ] Euclid P := fderiv ℝ G x
  -- `L` is injective on the finite-dimensional `ℝᵐ`, hence anti-Lipschitz: `c ‖v‖ ≤ ‖L v‖`
  obtain ⟨K, hKpos, hK⟩ :=
    (L : Euclid m →ₗ[ℝ] Euclid P).exists_antilipschitzWith (LinearMap.ker_eq_bot.2 hx)
  have hK' : (0 : ℝ) < K := hKpos
  set c : ℝ := (K : ℝ)⁻¹
  have hcpos : 0 < c := inv_pos.2 hK'
  have hLc : ∀ v, c * ‖v‖ ≤ ‖L v‖ := fun v =>
    (inv_mul_le_iff₀ hK').2 (L.bound_of_antilipschitz hK v)
  -- continuity of `DG` gives `δ > 0` with `‖DG(z) - L‖ ≤ c/2` on `B̄_{δ/2}(x)`
  obtain ⟨δ, hδpos, hδ⟩ :=
    Metric.continuous_iff.1 (hG.continuous_fderiv one_ne_zero) x (c / 2) (half_pos hcpos)
  have hbound : ∀ z ∈ closedBall x (δ / 2), ‖fderiv ℝ G z - L‖ ≤ c / 2 := by
    intro z hz
    have h := hδ z (lt_of_le_of_lt (mem_closedBall.1 hz) (half_lt_self hδpos))
    rw [dist_eq_norm] at h
    exact h.le
  refine ⟨δ / 2, half_pos hδpos, ?_, ?_⟩
  · -- mean value inequality: `‖G a - G b - L (a - b)‖ ≤ (c/2) ‖a - b‖`
    intro a ha b hb hab
    have hmvt := (convex_closedBall x (δ / 2)).norm_image_sub_le_of_norm_fderiv_le'
      (fun z _ => (hG.differentiable one_ne_zero) z) hbound hb ha
    rw [hab, sub_self, zero_sub, norm_neg] at hmvt
    have h1 := hLc (a - b)
    have h2 : ‖a - b‖ = 0 :=
      le_antisymm (by nlinarith [norm_nonneg (a - b)]) (norm_nonneg _)
    exact sub_eq_zero.1 (norm_eq_zero.1 h2)
  · -- if `DG(z) u = 0` then `c ‖u‖ ≤ ‖L u‖ = ‖(DG(z) - L) u‖ ≤ (c/2) ‖u‖`
    intro z hz v w hvw
    have hu : fderiv ℝ G z (v - w) = 0 := by rw [map_sub, hvw, sub_self]
    have h1 := hLc (v - w)
    have h2 : ‖L (v - w)‖ ≤ c / 2 * ‖v - w‖ := by
      have h3 : L (v - w) = -((fderiv ℝ G z - L) (v - w)) := by
        rw [sub_apply, hu, zero_sub, neg_neg]
      rw [h3, norm_neg]
      calc ‖(fderiv ℝ G z - L) (v - w)‖ ≤ ‖fderiv ℝ G z - L‖ * ‖v - w‖ :=
            ContinuousLinearMap.le_opNorm _ _
        _ ≤ c / 2 * ‖v - w‖ := by gcongr; exact hbound z hz
    have h4 : ‖v - w‖ = 0 :=
      le_antisymm (by nlinarith [norm_nonneg (v - w)]) (norm_nonneg _)
    exact sub_eq_zero.1 (norm_eq_zero.1 h4)
/-- **A `C¹` chart on a ball** (Simon Ch. 3, proof of Lemma 1.2, step 5): if `G : ℝᵐ → ℝᴾ` is
`C¹`, injective on `B̄_r(x)` and has injective derivative on `B_r(x)`, then `G(B_r(x))` is an
embedded `m`-dimensional `C¹` submanifold.  Every point is charted by `ψ = G` on `V = B_r(x)`
with `W = ℝᴾ \ G(∂B_r(x))`: `W` is open because the sphere is compact; injectivity on `B̄_r(x)`
gives `G(B_r(x)) ⊆ W`, so `ψ(V) = W ∩ G(B_r(x))`; and for compact `K ⊆ W`, sphere points map
outside `K`, so `B_r(x) ∩ G⁻¹(K) = B̄_r(x) ∩ G⁻¹(K)` is compact. -/
theorem Submission.dor_lmbsf_c1c_injOn_closedBall_chart : ∀ (P m : ℕ) (G : Euclid m → Euclid P) (x : Euclid m) (r : ℝ), ContDiff ℝ 1 G → Set.InjOn G (Metric.closedBall x r) → (∀ z ∈ Metric.ball x r, Function.Injective (fderiv ℝ G z)) → IsEmbeddedSubmanifold 1 m (G '' Metric.ball x r) := by
  intro P m G x r hG hinj hD
  -- `W = ℝᴾ \ G(∂B_r(x))` is open: the sphere is compact and `G` is continuous
  have hW : IsOpen (G '' Metric.sphere x r)ᶜ :=
    ((isCompact_sphere x r).image hG.continuous).isClosed.isOpen_compl
  -- `G(B_r(x)) ⊆ W`: `G` is injective on `B̄_r(x)` and the sphere misses the open ball
  have hNW : G '' Metric.ball x r ⊆ (G '' Metric.sphere x r)ᶜ := by
    rintro _ ⟨v, hv, rfl⟩ ⟨s, hs, hsv⟩
    have hsv' : s = v :=
      hinj (Metric.sphere_subset_closedBall hs) (Metric.ball_subset_closedBall hv) hsv
    subst hsv'
    exact (Metric.mem_ball.1 hv).ne (Metric.mem_sphere.1 hs)
  -- the same chart `(V, W, ψ) = (B_r(x), W, G)` serves every point of `G(B_r(x))`
  intro y hy
  refine ⟨Metric.ball x r, (G '' Metric.sphere x r)ᶜ, G, Metric.isOpen_ball, hW, hNW hy, ?_,
    hinj.mono Metric.ball_subset_closedBall, (Set.inter_eq_right.2 hNW).symm, ?_, hD⟩
  · exact_mod_cast hG.contDiffOn
  -- properness: for compact `K ⊆ W`, `B_r(x) ∩ G⁻¹(K) = B̄_r(x) ∩ G⁻¹(K)` is compact
  · intro K hKW hK
    have hball : Metric.ball x r ∩ G ⁻¹' K = Metric.closedBall x r ∩ G ⁻¹' K := by
      refine Set.Subset.antisymm
        (Set.inter_subset_inter_left _ Metric.ball_subset_closedBall) ?_
      rintro z ⟨hz, hzK⟩
      refine ⟨?_, hzK⟩
      rcases (Metric.mem_closedBall.1 hz).lt_or_eq with h | h
      · exact Metric.mem_ball.2 h
      · exact (hKW (Set.mem_preimage.1 hzK) ⟨z, Metric.mem_sphere.2 h, rfl⟩).elim
    rw [hball]
    exact (isCompact_closedBall x r).inter_right (hK.isClosed.preimage hG.continuous)
/-- **A Lipschitz map `ℝᵐ → ℝᴾ` agrees with countably many `C¹` maps off a set with `Hᵐ`-null
image** (Simon Ch. 3, proof of Lemma 1.2), given the scalar `C¹` approximation (H) of Ch. 2,
Theorem 1.5.  Apply (H) to each `K`-Lipschitz coordinate `Fᵖ` with `ε = 1/i` and put
`Gᵢ = (g_{ip})_p`, so `Lᵐ({F ≠ Gᵢ}) ≤ Σ_p Lᵐ({Fᵖ ≠ g_{ip}}) ≤ P/i`.  Hence `Z = ⋂ᵢ {F ≠ Gᵢ}` is
`Lᵐ`-null, `E = F(Z)` has `Hᵐ(E) ≤ Kᵐ Hᵐ(Z) = Kᵐ Lᵐ(Z) = 0`, and off `Z`, `F = Gᵢ` for some `i`. -/
theorem Submission.dor_lmbsf_c1c_lipschitz_range_c1_pieces : ∀ (P m : ℕ) (F : Euclid m → Euclid P) (K : NNReal), LipschitzWith K F → (∀ (u : Euclid m → ℝ) (L : NNReal), LipschitzWith L u → ∀ ε : ℝ≥0∞, 0 < ε → ∃ g : Euclid m → ℝ, ContDiff ℝ 1 g ∧ volume {y | u y ≠ g y} < ε) → ∃ (E : Set (Euclid P)) (G : ℕ → Euclid m → Euclid P), μHE[m] E = 0 ∧ (∀ i, ContDiff ℝ 1 (G i)) ∧ Set.range F ⊆ E ∪ ⋃ i, Set.range (G i) := by
  intro P m F K hF H
  -- the coordinates `Fᵖ` are `K`-Lipschitz, since `|a_p| ≤ |a|`
  have hcoord : ∀ p : Fin P, LipschitzWith K fun y => F y p := by
    intro p
    refine LipschitzWith.of_dist_le_mul fun a b => ?_
    calc dist (F a p) (F b p) = ‖(F a - F b) p‖ := by
          rw [PiLp.sub_apply, Real.dist_eq, Real.norm_eq_abs]
      _ ≤ ‖F a - F b‖ := PiLp.norm_apply_le _ _
      _ = dist (F a) (F b) := (dist_eq_norm _ _).symm
      _ ≤ K * dist a b := hF.dist_le_mul a b
  -- (H) for each coordinate with `ε = 1/i`: `Lᵐ({Fᵖ ≠ g_{ip}}) < 1/i`
  choose g hg hgvol using fun (i : ℕ) (p : Fin P) =>
    H (fun y => F y p) K (hcoord p) (i : ℝ≥0∞)⁻¹ (ENNReal.inv_pos.2 (ENNReal.natCast_ne_top i))
  -- `Gᵢ = (g_{ip})_p` is `C¹`
  obtain ⟨G, hGp⟩ : ∃ G : ℕ → Euclid m → Euclid P, ∀ i y p, G i y p = g i p y :=
    ⟨fun i y => WithLp.toLp 2 fun p => g i p y, fun _ _ _ => rfl⟩
  have hGc : ∀ i, ContDiff ℝ 1 (G i) := fun i =>
    (contDiff_piLp 2).2 fun p => by simpa only [hGp] using hg i p
  -- `Z = ⋂ᵢ {F ≠ Gᵢ}`: `Lᵐ(Z) ≤ Lᵐ({F ≠ Gᵢ}) ≤ Σ_p Lᵐ({Fᵖ ≠ g_{ip}}) ≤ P/i`
  set Z : Set (Euclid m) := ⋂ i, {y | F y ≠ G i y} with hZ_def
  have hZi : ∀ i : ℕ, volume Z ≤ (P : ℝ≥0∞) * (i : ℝ≥0∞)⁻¹ := by
    intro i
    calc volume Z ≤ volume (⋃ p : Fin P, {y | F y p ≠ g i p y}) := by
          refine measure_mono fun y hy => ?_
          have hne : F y ≠ G i y := mem_iInter.1 hy i
          by_contra hcon
          simp only [mem_iUnion, mem_ofPred_eq, not_exists, not_not] at hcon
          exact hne (PiLp.ext fun p => by rw [hGp, hcon p])
      _ ≤ ∑ p : Fin P, volume {y | F y p ≠ g i p y} := measure_iUnion_fintype_le _ _
      _ ≤ ∑ _p : Fin P, (i : ℝ≥0∞)⁻¹ := Finset.sum_le_sum fun p _ => (hgvol i p).le
      _ = (P : ℝ≥0∞) * (i : ℝ≥0∞)⁻¹ := by simp
  -- `P/i → 0`, so `Lᵐ(Z) = 0`
  have hZ0 : volume Z = 0 := by
    have ht := ENNReal.Tendsto.const_mul ENNReal.tendsto_inv_nat_nhds_zero
      (Or.inr (ENNReal.natCast_ne_top P))
    rw [mul_zero] at ht
    exact le_antisymm (ge_of_tendsto' ht hZi) zero_le
  refine ⟨F '' Z, G, ?_, hGc, ?_⟩
  · -- `Hᵐ(F(Z)) ≤ Kᵐ Hᵐ(Z) = Kᵐ Lᵐ(Z) = 0`
    have h := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn m
      (hF.lipschitzOnWith (s := Z))
    rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume m, hZ0, mul_zero] at h
    exact le_antisymm h zero_le
  · -- `F z ∈ F(Z)` if `z ∈ Z`, otherwise `F z = Gᵢ z` for some `i`
    rintro _ ⟨z, rfl⟩
    by_cases hz : z ∈ Z
    · exact Or.inl ⟨z, hz, rfl⟩
    · rw [hZ_def] at hz
      simp only [mem_iInter, mem_ofPred_eq, not_forall, not_not] at hz
      obtain ⟨i, hi⟩ := hz
      exact Or.inr (mem_iUnion.2 ⟨i, z, hi.symm⟩)
/-- **Simon Ch. 3, proof of Lemma 1.2 ("only if"), last paragraph**, for one `C¹` map
`G : ℝᵐ → ℝᴾ`: `G(ℝᵐ) ⊆ N₀ ∪ ⋃ₗ Nₗ` with `Hᵐ(N₀) = 0` and each `Nₗ` an embedded `C¹`
`m`-submanifold.  `N₀ = G({x : DG(x) not injective})` is `Hᵐ`-null (Simon: by the area formula of
Ch. 2 §3).  Here this is checked directly: if `DG(x) e = 0`, `|e| = 1`, and `‖DG - DG(x)‖ ≤ λM`,
`‖DG‖ ≤ M` on `B̄_ρ(x)`, then with `Ψ = id + (λ⁻¹ - 1) e ⊗ e` (`det Ψ = λ⁻¹`) the map `G ∘ Ψ` is
`2M`-Lipschitz on `Ψ⁻¹(B̄_ρ(x))`, so `Hᵐ(G(B̄_ρ(x))) ≤ (2M)ᵐ λ |B̄_ρ(x)|`; a Besicovitch disjoint
cover of the critical points in `B_R(0)` gives `Hᵐ(G(·)) ≤ (2M)ᵐ λ |B̄_{R+1}(0)|` for every `λ`.
At a regular point `x`, `G` is injective with injective derivative on some `B̄_{r_x}(x)`, so
`G(B_{r_x}(x))` is a submanifold; countably many of these balls cover the regular set (Lindelöf,
left implicit by Simon), and no ball is needed if it is empty. -/
theorem Submission.dor_lmbsf_c1c_c1_range_cover : ∀ (P m : ℕ) (G : Euclid m → Euclid P), ContDiff ℝ 1 G → ∃ (N₀ : Set (Euclid P)) (N : ℕ → Set (Euclid P)), μHE[m] N₀ = 0 ∧ (∀ l, IsEmbeddedSubmanifold 1 m (N l)) ∧ Set.range G ⊆ N₀ ∪ ⋃ l, N l := by
  intro P m G hG
  -- Step 1: `G` is differentiable everywhere, with continuous derivative.
  have hGd : Differentiable ℝ G := hG.differentiable one_ne_zero
  have hDG : Continuous (fderiv ℝ G) := hG.continuous_fderiv one_ne_zero
  -- Step 2: the critical image `N₀ = G({x : DG(x) not injective})` is `Hᵐ`-null.
  have hN₀ : μHE[m] (G '' {x | ¬ Injective (fderiv ℝ G x)}) = 0 := by
    have hvol : (μHE[m] : Measure (Euclid m)) = volume :=
      EuclideanSpace.euclideanHausdorffMeasure_eq_volume m
    have hcov : {x | ¬ Injective (fderiv ℝ G x)} =
        ⋃ k : ℕ, {x | ¬ Injective (fderiv ℝ G x)} ∩ ball (0 : Euclid m) k := by
      rw [← inter_iUnion, iUnion_ball_nat, inter_univ]
    rw [hcov, image_iUnion]
    refine measure_iUnion_null fun k => ?_
    set R : ℝ := (k : ℝ)
    obtain ⟨M₀, hM₀⟩ := (isCompact_closedBall (0 : Euclid m) (R + 1)).exists_bound_of_continuousOn
      hDG.continuousOn
    set M : ℝ := max M₀ 1
    have hM : 0 < M := lt_of_lt_of_le one_pos (le_max_right _ _)
    have hMK : ∀ y ∈ closedBall (0 : Euclid m) (R + 1), ‖fderiv ℝ G y‖ ≤ M :=
      fun y hy => (hM₀ y hy).trans (le_max_left _ _)
    -- one ball `B̄_ρ(x)` around a critical point `x`
    have hloc : ∀ lam : ℝ, 0 < lam → lam ≤ 1 → ∀ x, ¬ Injective (fderiv ℝ G x) → ∀ ρ : ℝ,
        (∀ y ∈ closedBall x ρ, ‖fderiv ℝ G y - fderiv ℝ G x‖ ≤ lam * M) →
        closedBall x ρ ⊆ closedBall 0 (R + 1) →
        μHE[m] (G '' closedBall x ρ) ≤
          ((2 * M).toNNReal : ℝ≥0∞) ^ m * ENNReal.ofReal lam * volume (closedBall x ρ) := by
      intro lam hlam0 hlam1 x hx ρ hρ hρK
      obtain ⟨v, hv0, hv⟩ : ∃ v, fderiv ℝ G x v = 0 ∧ v ≠ 0 := by
        simpa only [injective_iff_map_eq_zero, not_forall, exists_prop] using hx
      set e : Euclid m := (‖v‖⁻¹ : ℝ) • v
      have he : ‖e‖ = 1 := norm_smul_inv_norm hv
      have hee : inner ℝ e e = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, he, one_pow]
      have hDe : fderiv ℝ G x e = 0 := by simp [e, hv0]
      set Ψ : Euclid m →L[ℝ] Euclid m :=
        ContinuousLinearMap.id ℝ _ + (lam⁻¹ - 1) • (innerSL ℝ e).smulRight e
      have hΨ : ∀ u, Ψ u = u + ((lam⁻¹ - 1) * inner ℝ e u) • e := by
        intro u
        simp [Ψ, smul_smul]
      -- `det Ψ = 1 + (λ⁻¹ - 1) |e|² = λ⁻¹` (matrix determinant lemma)
      have hdet : LinearMap.det (Ψ : Euclid m →ₗ[ℝ] Euclid m) = lam⁻¹ := by
        have hee' : e.ofLp ⬝ᵥ e.ofLp = 1 := by
          rw [← hee, EuclideanSpace.inner_eq_star_dotProduct]
          simp
        set b := (EuclideanSpace.basisFun (Fin m) ℝ).toBasis
        have hmat : LinearMap.toMatrix b b (Ψ : Euclid m →ₗ[ℝ] Euclid m) =
            1 + Matrix.replicateCol Unit ((lam⁻¹ - 1) • e.ofLp) * Matrix.replicateRow Unit e.ofLp := by
          ext i j
          simp [LinearMap.toMatrix_apply, b, hΨ, Matrix.one_apply, Matrix.mul_apply,
            EuclideanSpace.inner_single_right, PiLp.single_apply]
          ring
        rw [← LinearMap.det_toMatrix b, hmat, Matrix.det_one_add_replicateCol_mul_replicateRow,
          dotProduct_smul, hee', smul_eq_mul, mul_one]
        ring
      have hsurj : Surjective Ψ := by
        intro y
        refine ⟨y + ((lam - 1) * inner ℝ e y) • e, ?_⟩
        have hcoef : (lam - 1) * inner ℝ e y +
            (lam⁻¹ - 1) * (inner ℝ e y + (lam - 1) * inner ℝ e y * 1) = 0 := by
          field_simp
          ring
        rw [hΨ, inner_add_right, inner_smul_right, hee, add_assoc, ← add_smul, hcoef, zero_smul,
          add_zero]
      -- `D(G ∘ Ψ) u = DG u + (λ⁻¹ - 1) ⟨e, u⟩ DG e` with `‖DG e‖ = ‖(DG - DG(x)) e‖ ≤ λM`
      have hLip : LipschitzOnWith (2 * M).toNNReal (G ∘ Ψ) (Ψ ⁻¹' closedBall x ρ) := by
        refine Convex.lipschitzOnWith_of_nnnorm_fderiv_le (𝕜 := ℝ)
          (fun z _ => (hGd (Ψ z)).comp z Ψ.differentiableAt) (fun z hz => ?_)
          ((convex_closedBall x ρ).linear_preimage (Ψ : Euclid m →ₗ[ℝ] Euclid m))
        have hy : Ψ z ∈ closedBall x ρ := hz
        rw [fderiv_comp z (hGd (Ψ z)) Ψ.differentiableAt, ContinuousLinearMap.fderiv,
          ← NNReal.coe_le_coe, coe_nnnorm, Real.coe_toNNReal _ (by positivity)]
        refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) fun u => ?_
        have h1 : ‖fderiv ℝ G (Ψ z) u‖ ≤ M * ‖u‖ :=
          ((fderiv ℝ G (Ψ z)).le_opNorm u).trans
            (mul_le_mul_of_nonneg_right (hMK _ (hρK hy)) (norm_nonneg _))
        have h2 : ‖fderiv ℝ G (Ψ z) e‖ ≤ lam * M := by
          have h3 : fderiv ℝ G (Ψ z) e = (fderiv ℝ G (Ψ z) - fderiv ℝ G x) e := by
            rw [sub_apply, hDe, sub_zero]
          rw [h3]
          calc ‖(fderiv ℝ G (Ψ z) - fderiv ℝ G x) e‖
              ≤ ‖fderiv ℝ G (Ψ z) - fderiv ℝ G x‖ * ‖e‖ := ContinuousLinearMap.le_opNorm _ _
            _ ≤ lam * M := by rw [he, mul_one]; exact hρ _ hy
        have h4 : |lam⁻¹ - 1| ≤ lam⁻¹ := by
          have : 1 ≤ lam⁻¹ := (one_le_inv₀ hlam0).2 hlam1
          rw [abs_of_nonneg (by linarith)]
          linarith
        have h5 : |inner ℝ e u| ≤ ‖u‖ := by
          simpa [he] using abs_real_inner_le_norm e u
        rw [ContinuousLinearMap.comp_apply, hΨ u, map_add, map_smul]
        calc ‖fderiv ℝ G (Ψ z) u + ((lam⁻¹ - 1) * inner ℝ e u) • fderiv ℝ G (Ψ z) e‖
            ≤ ‖fderiv ℝ G (Ψ z) u‖ + ‖((lam⁻¹ - 1) * inner ℝ e u) • fderiv ℝ G (Ψ z) e‖ :=
              norm_add_le _ _
          _ = ‖fderiv ℝ G (Ψ z) u‖ + |lam⁻¹ - 1| * |inner ℝ e u| * ‖fderiv ℝ G (Ψ z) e‖ := by
              rw [norm_smul, Real.norm_eq_abs, abs_mul]
          _ ≤ M * ‖u‖ + lam⁻¹ * ‖u‖ * (lam * M) := by gcongr
          _ = 2 * M * ‖u‖ := by
              rw [show lam⁻¹ * ‖u‖ * (lam * M) = (lam⁻¹ * lam) * (M * ‖u‖) by ring,
                inv_mul_cancel₀ hlam0.ne', one_mul]
              ring
      have hvolΨ : volume (Ψ ⁻¹' closedBall x ρ) = ENNReal.ofReal lam * volume (closedBall x ρ) := by
        rw [Measure.addHaar_preimage_continuousLinearMap volume
          (by rw [hdet]; exact inv_ne_zero hlam0.ne'), hdet, inv_inv, abs_of_pos hlam0]
      calc μHE[m] (G '' closedBall x ρ) = μHE[m] ((G ∘ Ψ) '' (Ψ ⁻¹' closedBall x ρ)) := by
            rw [image_comp, image_preimage_eq _ hsurj]
        _ ≤ ((2 * M).toNNReal : ℝ≥0∞) ^ m * μHE[m] (Ψ ⁻¹' closedBall x ρ) :=
            Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn m hLip
        _ = ((2 * M).toNNReal : ℝ≥0∞) ^ m * ENNReal.ofReal lam * volume (closedBall x ρ) := by
            rw [hvol, hvolΨ, mul_assoc]
    -- `G` is `M`-Lipschitz on `B̄_{R+1}(0)`, so it maps volume-null sets there to `Hᵐ`-null sets
    have hLipK : LipschitzOnWith M.toNNReal G (closedBall 0 (R + 1)) := by
      refine Convex.lipschitzOnWith_of_nnnorm_fderiv_le (𝕜 := ℝ) (fun y _ => hGd y)
        (fun y hy => ?_) (convex_closedBall _ _)
      rw [← NNReal.coe_le_coe, coe_nnnorm, Real.coe_toNNReal _ hM.le]
      exact hMK y hy
    -- Besicovitch: disjoint balls `B̄_{ρ x}(x)` with `ρ x < r x` cover almost all critical points
    have hmain : ∀ lam : ℝ, 0 < lam → lam ≤ 1 →
        μHE[m] (G '' ({x | ¬ Injective (fderiv ℝ G x)} ∩ ball 0 R)) ≤
          ((2 * M).toNNReal : ℝ≥0∞) ^ m * ENNReal.ofReal lam *
            volume (closedBall (0 : Euclid m) (R + 1)) := by
      intro lam hlam0 hlam1
      have hr : ∀ x : Euclid m, ∃ r : ℝ, 0 < r ∧ r ≤ 1 ∧
          ∀ y ∈ ball x r, ‖fderiv ℝ G y - fderiv ℝ G x‖ < lam * M := by
        intro x
        obtain ⟨δ, hδ, hδ'⟩ := Metric.continuous_iff.1 hDG x (lam * M) (by positivity)
        refine ⟨min δ 1, lt_min hδ one_pos, min_le_right _ _, fun y hy => ?_⟩
        have h := hδ' y (lt_of_lt_of_le (mem_ball.1 hy) (min_le_left _ _))
        rwa [dist_eq_norm] at h
      choose r hr0 hr1 hr using hr
      obtain ⟨t, ρ, ht, hts, hρ, hnull, hdisj⟩ := Besicovitch.exists_disjoint_closedBall_covering_ae
        volume (fun _ => univ) ({x | ¬ Injective (fderiv ℝ G x)} ∩ ball 0 R)
        (fun _ _ δ hδ => ⟨δ / 2, mem_univ _, half_pos hδ, half_lt_self hδ⟩) r (fun x _ => hr0 x)
      have hballK : ∀ x ∈ t, closedBall x (ρ x) ⊆ closedBall 0 (R + 1) := by
        intro x hx y hy
        have hx' : ‖x‖ < R := mem_ball_zero_iff.1 (hts hx).2
        rw [mem_closedBall, dist_eq_norm] at hy
        rw [mem_closedBall_zero_iff]
        calc ‖y‖ = ‖(y - x) + x‖ := by rw [sub_add_cancel]
          _ ≤ ‖y - x‖ + ‖x‖ := norm_add_le _ _
          _ ≤ R + 1 := by linarith [(hρ x hx).2.2, hr1 x]
      have hsub : G '' ({x | ¬ Injective (fderiv ℝ G x)} ∩ ball 0 R) ⊆
          G '' (({x | ¬ Injective (fderiv ℝ G x)} ∩ ball 0 R) \ ⋃ x ∈ t, closedBall x (ρ x)) ∪
            ⋃ x ∈ t, G '' closedBall x (ρ x) := by
        rintro _ ⟨y, hy, rfl⟩
        by_cases hyU : y ∈ ⋃ x ∈ t, closedBall x (ρ x)
        · obtain ⟨x, hx, hyx⟩ := mem_iUnion₂.1 hyU
          exact Or.inr (mem_iUnion₂.2 ⟨x, hx, mem_image_of_mem G hyx⟩)
        · exact Or.inl (mem_image_of_mem G ⟨hy, hyU⟩)
      have h0 : μHE[m] (G '' (({x | ¬ Injective (fderiv ℝ G x)} ∩ ball 0 R) \
          ⋃ x ∈ t, closedBall x (ρ x))) = 0 := by
        refine le_antisymm ?_ bot_le
        calc μHE[m] (G '' (({x | ¬ Injective (fderiv ℝ G x)} ∩ ball 0 R) \
                ⋃ x ∈ t, closedBall x (ρ x)))
            ≤ (M.toNNReal : ℝ≥0∞) ^ m * μHE[m] (({x | ¬ Injective (fderiv ℝ G x)} ∩ ball 0 R) \
                ⋃ x ∈ t, closedBall x (ρ x)) :=
              Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn m
                (hLipK.mono fun y hy =>
                  closedBall_subset_closedBall (by linarith) (ball_subset_closedBall hy.1.2))
          _ = 0 := by rw [hvol, hnull, mul_zero]
      calc μHE[m] (G '' ({x | ¬ Injective (fderiv ℝ G x)} ∩ ball 0 R))
          ≤ μHE[m] (G '' (({x | ¬ Injective (fderiv ℝ G x)} ∩ ball 0 R) \
              ⋃ x ∈ t, closedBall x (ρ x))) + μHE[m] (⋃ x ∈ t, G '' closedBall x (ρ x)) :=
            (measure_mono hsub).trans (measure_union_le _ _)
        _ ≤ ∑' x : t, μHE[m] (G '' closedBall (x : Euclid m) (ρ x)) := by
            rw [h0, zero_add]
            exact measure_biUnion_le _ ht _
        _ ≤ ∑' x : t, ((2 * M).toNNReal : ℝ≥0∞) ^ m * ENNReal.ofReal lam *
              volume (closedBall (x : Euclid m) (ρ x)) :=
            ENNReal.tsum_le_tsum fun x => hloc lam hlam0 hlam1 x (hts x.2).1 (ρ x)
              (fun y hy => (hr x y (closedBall_subset_ball (hρ x x.2).2.2 hy)).le) (hballK x x.2)
        _ = ((2 * M).toNNReal : ℝ≥0∞) ^ m * ENNReal.ofReal lam *
              volume (⋃ x ∈ t, closedBall x (ρ x)) := by
            rw [ENNReal.tsum_mul_left, measure_biUnion ht hdisj fun _ _ => measurableSet_closedBall]
        _ ≤ ((2 * M).toNNReal : ℝ≥0∞) ^ m * ENNReal.ofReal lam *
              volume (closedBall (0 : Euclid m) (R + 1)) := by
            gcongr
            exact iUnion₂_subset hballK
    -- let `λ → 0`
    have hlim : Tendsto (fun lam : ℝ => ((2 * M).toNNReal : ℝ≥0∞) ^ m * ENNReal.ofReal lam *
        volume (closedBall (0 : Euclid m) (R + 1))) (𝓝[>] 0) (𝓝 0) := by
      have h1 : Tendsto (fun lam : ℝ => ENNReal.ofReal lam) (𝓝[>] 0) (𝓝 0) := by
        simpa using (ENNReal.tendsto_ofReal (tendsto_id (x := 𝓝 (0 : ℝ)))).mono_left
          nhdsWithin_le_nhds
      simpa using ENNReal.Tendsto.mul_const (ENNReal.Tendsto.const_mul h1
        (Or.inr (ENNReal.pow_ne_top ENNReal.coe_ne_top))) (Or.inr measure_closedBall_lt_top.ne)
    refine le_antisymm (ge_of_tendsto hlim ?_) bot_le
    filter_upwards [Ioo_mem_nhdsGT one_pos] with lam hlam
    exact hmain lam hlam.1 hlam.2.le
  have hcrit : ∀ x, ¬ Injective (fderiv ℝ G x) → G x ∈ G '' {x | ¬ Injective (fderiv ℝ G x)} :=
    fun x hx => mem_image_of_mem G hx
  -- Step 3: at a regular point `x`, `G(B_{r_x}(x))` is an embedded `C¹` `m`-submanifold.
  have hchart : ∀ x : {x : Euclid m // Injective (fderiv ℝ G x)}, ∃ r : ℝ, 0 < r ∧
      IsEmbeddedSubmanifold 1 m (G '' ball (x : Euclid m) r) := by
    rintro ⟨x, hx⟩
    obtain ⟨r, hr, hinj, hder⟩ := Submission.dor_lmbsf_c1c_immersion_local_injOn P m G x hG hx
    exact ⟨r, hr, Submission.dor_lmbsf_c1c_injOn_closedBall_chart P m G x r hG hinj
      fun z hz => hder z (ball_subset_closedBall hz)⟩
  choose r hr hN using hchart
  -- Step 4: with no regular point, `Nₗ = ∅` (vacuously a submanifold) and `G(ℝᵐ) ⊆ N₀`.
  rcases isEmpty_or_nonempty {x : Euclid m // Injective (fderiv ℝ G x)} with hR | hR
  · refine ⟨_, fun _ => ∅, hN₀, fun _ y hy => absurd hy (notMem_empty y), ?_⟩
    rintro _ ⟨x, rfl⟩
    exact Or.inl (hcrit x fun hx => hR.false ⟨x, hx⟩)
  -- Otherwise countably many balls `B_{r_{xₗ}}(xₗ)` cover the regular set (Lindelöf).
  obtain ⟨f, hf⟩ := (HereditarilyLindelofSpace.isLindelof
    {x : Euclid m | Injective (fderiv ℝ G x)}).indexed_countable_subcover
    (fun x : {x : Euclid m // Injective (fderiv ℝ G x)} => ball (x : Euclid m) (r x))
    (fun _ => isOpen_ball) fun x hx => mem_iUnion.mpr ⟨⟨x, hx⟩, mem_ball_self (hr _)⟩
  refine ⟨_, fun l => G '' ball (f l : Euclid m) (r (f l)), hN₀, fun l => hN (f l), ?_⟩
  -- Step 5: `G(x) ∈ N₀` if `x` is critical, and `G(x) ∈ Nₗ` if `x ∈ B_{r_{xₗ}}(xₗ)`.
  rintro _ ⟨x, rfl⟩
  by_cases hx : Injective (fderiv ℝ G x)
  · obtain ⟨l, hl⟩ := mem_iUnion.mp
      (hf (show x ∈ {x : Euclid m | Injective (fderiv ℝ G x)} from hx))
    exact Or.inr (mem_iUnion.mpr ⟨l, mem_image_of_mem G hl⟩)
  · exact Or.inl (hcrit x hx)
/-- **Lusin's theorem**, compact form (Simon 1.17), for a measurable `g : ℝᴾ → Y` into a
second-countable `Y`.  If `μ(A) < ∞` and `ε ≠ 0`, there is a compact `K ⊆ A` with
`μ(A \ K) < ε` on which `g` is continuous.  `μ⌞A` is finite, hence inner regular on `ℝᴾ`.  For a
countable basis `(O_k)` of `Y` and weights `η_k > 0` with `∑ η_k < ε`, choose compact
`C_k ⊆ A ∩ g⁻¹(O_k)` and `D_k ⊆ A \ g⁻¹(O_k)` with defects `< η_k / 2`, and put
`K = ⋂ₖ (C_k ∪ D_k)`.  On `K`, `g x ∈ O_k ↔ x ∉ D_k`, so every `g⁻¹(O_k) ∩ K` is relatively
open. -/
theorem Submission.dor_ims_lusin_measurable_continuousOn : ∀ (P : ℕ) {Y : Type} [TopologicalSpace Y] [SecondCountableTopology Y] [MeasurableSpace Y] [OpensMeasurableSpace Y] (μ : Measure (Euclid P)) (A : Set (Euclid P)) (g : Euclid P → Y) (ε : ℝ≥0∞), Measurable g → MeasurableSet A → μ A ≠ ∞ → ε ≠ 0 → ∃ K : Set (Euclid P), IsCompact K ∧ K ⊆ A ∧ μ (A \ K) < ε ∧ ContinuousOn g K := by
  intro P Y _ _ _ _ μ A g ε hg hA hμA hε
  -- `μ⌞A` is finite, hence regular on the σ-compact metric space `ℝᴾ`, so every measurable
  -- `B ⊆ A` contains a compact `C` with `μ (B \ C) = μ⌞A (B \ C)` arbitrarily small
  have : IsFiniteMeasure (μ.restrict A) := isFiniteMeasure_restrict.mpr hμA
  have approx : ∀ B, B ⊆ A → MeasurableSet B → ∀ η : ℝ≥0∞, η ≠ 0 →
      ∃ C ⊆ B, IsCompact C ∧ μ (B \ C) < η := by
    intro B hBA hB η hη
    obtain ⟨C, hCB, hC, hlt⟩ :=
      hB.exists_isCompact_sdiff_lt (μ := μ.restrict A) (measure_ne_top _ _) hη
    exact ⟨C, hCB, hC, by rwa [Measure.restrict_eq_self _ (sdiff_subset.trans hBA)] at hlt⟩
  -- a countable basis `(O_k)` of `Y`, and weights `η_k > 0` with `∑ η_k < ε`
  obtain ⟨O, hO⟩ := TopologicalSpace.exists_seq_basis Y
  obtain ⟨η, hη, hηε⟩ := ENNReal.exists_pos_sum_of_countable' hε ℕ
  have hS : ∀ k, MeasurableSet (g ⁻¹' O k) :=
    fun k => hg (hO.isOpen (mem_range_self k)).measurableSet
  -- compact `C_k ⊆ A ∩ g⁻¹(O_k)` and `D_k ⊆ A \ g⁻¹(O_k)`, each with defect `< η_k / 2`
  choose C hCA hC hCμ using fun k =>
    approx (A ∩ g ⁻¹' O k) inter_subset_left (hA.inter (hS k)) (η k / 2)
      (ENNReal.half_pos (hη k).ne').ne'
  choose D hDA hD hDμ using fun k =>
    approx (A \ g ⁻¹' O k) sdiff_subset (hA.diff (hS k)) (η k / 2)
      (ENNReal.half_pos (hη k).ne').ne'
  -- `E_k = C_k ∪ D_k` misses less than `η_k` of `A`
  have hE : ∀ k, μ (A \ (C k ∪ D k)) < η k := by
    intro k
    calc μ (A \ (C k ∪ D k))
        ≤ μ ((A ∩ g ⁻¹' O k) \ C k ∪ (A \ g ⁻¹' O k) \ D k) := by
          refine measure_mono fun x hx => ?_
          by_cases hxO : g x ∈ O k
          · exact Or.inl ⟨⟨hx.1, hxO⟩, fun hxC => hx.2 (Or.inl hxC)⟩
          · exact Or.inr ⟨⟨hx.1, hxO⟩, fun hxD => hx.2 (Or.inr hxD)⟩
      _ ≤ μ ((A ∩ g ⁻¹' O k) \ C k) + μ ((A \ g ⁻¹' O k) \ D k) := measure_union_le _ _
      _ < η k / 2 + η k / 2 := ENNReal.add_lt_add (hCμ k) (hDμ k)
      _ = η k := ENNReal.add_halves _
  -- `K = ⋂ₖ E_k` is closed inside the compact `E_0 ⊆ A`
  refine ⟨⋂ k, (C k ∪ D k), ?_, ?_, ?_, ?_⟩
  · exact ((hC 0).union (hD 0)).of_isClosed_subset
      (isClosed_iInter fun k => ((hC k).union (hD k)).isClosed) (iInter_subset _ 0)
  · exact (iInter_subset _ 0).trans
      (union_subset ((hCA 0).trans inter_subset_left) ((hDA 0).trans sdiff_subset))
  · calc μ (A \ ⋂ k, (C k ∪ D k)) = μ (⋃ k, A \ (C k ∪ D k)) := by rw [sdiff_iInter]
      _ ≤ ∑' k, μ (A \ (C k ∪ D k)) := measure_iUnion_le _
      _ ≤ ∑' k, η k := ENNReal.tsum_le_tsum fun k => (hE k).le
      _ < ε := hηε
  -- on `K`, `g x ∈ O_k ↔ x ∉ D_k`, so `g⁻¹(O_k) ∩ K = D_kᶜ ∩ K` is relatively open
  · rw [hO.continuousOn_iff]
    rintro _ ⟨k, rfl⟩
    refine ⟨(D k)ᶜ, (hD k).isClosed.isOpen_compl, ?_⟩
    ext x
    refine ⟨fun ⟨hxO, hxK⟩ => ⟨fun hxD => (hDA k hxD).2 hxO, hxK⟩, fun ⟨hxD, hxK⟩ => ⟨?_, hxK⟩⟩
    rcases mem_iInter.mp hxK k with hxC | hxD'
    · exact (hCA k hxC).2
    · exact absurd hxD' hxD

/-- `Λⁿ(ℝᴾ)` is finite-dimensional: `α ↦ (α(e_{I(1)}, …, e_{I(n)}))_{I : Fin n → Fin P}` is a linear
map into the finite-dimensional space `(Fin n → Fin P) → ℝ`, injective because an alternating map
is determined by its values on tuples of basis vectors. -/
theorem Submission.dor_ims_lusin_covector_finiteDimensional : ∀ (P n : ℕ), FiniteDimensional ℝ (Covector (Euclid P) n) := by
  intro P n
  let e := (EuclideanSpace.basisFun (Fin P) ℝ).toBasis
  -- `L α = (α(e ∘ I))_I`
  let L : Covector (Euclid P) n →ₗ[ℝ] (Fin n → Fin P) → ℝ :=
    { toFun := fun α I => α fun k => e (I k)
      map_add' := fun α β => rfl
      map_smul' := fun c α => rfl }
  refine FiniteDimensional.of_injective L fun α β h => ?_
  apply ContinuousAlternatingMap.toAlternatingMap_injective
  exact e.ext_alternating fun v _ => congrFun h v
/-- **Lusin's theorem** (Simon 1.17) for a `μ`-a.e. strongly measurable covector field
`f : ℝᴾ → Λⁿ(ℝᴾ)`.  `Λⁿ(ℝᴾ)` is finite-dimensional, hence second countable; give it the Borel
σ-algebra.  `f` agrees with the Borel modification `f' = hf.mk f` off a measurable `μ`-null set
`Z`, and Lusin's theorem for `f'` on `A \ Z` gives a compact `K ⊆ A \ Z` with
`μ((A \ Z) \ K) < ε` on which `f = f'` is continuous.  As `μ(Z) = 0`,
`μ(A \ K) = μ((A \ K) \ Z) = μ((A \ Z) \ K)`. -/
theorem Submission.dor_ims_lusin_continuousOn : ∀ (P n : ℕ) (μ : Measure (Euclid P)) (A : Set (Euclid P)) (f : Euclid P → Covector (Euclid P) n) (ε : ℝ), MeasurableSet A → μ A ≠ ∞ → AEStronglyMeasurable f μ → 0 < ε → ∃ K : Set (Euclid P), IsCompact K ∧ K ⊆ A ∧ μ (A \ K) < ENNReal.ofReal ε ∧ ContinuousOn f K := by
  intro P n μ A f ε hA hμA hf hε
  -- `Λⁿ(ℝᴾ)` is finite-dimensional, hence proper and second countable
  have := Submission.dor_ims_lusin_covector_finiteDimensional P n
  borelize (Covector (Euclid P) n)
  -- `f = f'` off a measurable null set `Z`
  obtain ⟨Z, hfZ, hZ, hZ0⟩ := exists_measurable_superset_of_null (ae_iff.mp hf.ae_eq_mk)
  obtain ⟨K, hK, hKA, hKμ, hfK⟩ := Submission.dor_ims_lusin_measurable_continuousOn P μ (A \ Z)
    (hf.mk f) (ENNReal.ofReal ε) hf.measurable_mk (hA.diff hZ)
    (ne_top_of_le_ne_top hμA (measure_mono sdiff_subset)) (ENNReal.ofReal_pos.mpr hε).ne'
  refine ⟨K, hK, hKA.trans sdiff_subset, ?_, hfK.congr fun x hx => ?_⟩
  · rwa [← measure_sdiff_null hZ0, sdiff_right_comm]
  · by_contra hfx
    exact (hKA hx).2 (hfZ hfx)
/-- **The Euclidean coefficient norm is a pulled-back Euclidean norm** (Simon Ch. 6, 1.2 and 1.5;
used by the smooth unit approximation behind the mass of `τ(M, θ, ξ)`).  With `e` the standard
basis of `ℝᴾ`, let `c_I α = α(e_{I(0)}, …, e_{I(n-1)})` for strictly increasing `I : Fin n → Fin P`
and `c_I = 0` otherwise.  Each `c_I` is a continuous linear functional, so
`A α = (c_I α)_I ∈ EuclideanSpace ℝ (Fin n → Fin P)` is continuous linear, and termwise
`‖A α‖ = √(∑_I c_I(α)²)` is the defining sum of `covectorEuclideanNorm α`. -/
theorem Submission.dor_ims_sua_coeff_norm_rep : ∀ (P n : ℕ), ∃ A : Covector (Euclid P) n →L[ℝ] EuclideanSpace ℝ (Fin n → Fin P), ∀ α : Covector (Euclid P) n, covectorEuclideanNorm α = ‖A α‖ := by
  intro P n
  -- Step 1: the coefficient functionals `c_I : α ↦ α(e_I)` for increasing `I`, else `0`
  let c : (Fin n → Fin P) → Covector (Euclid P) n →L[ℝ] ℝ := fun I =>
    if StrictMono I then
      ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ fun i => EuclideanSpace.basisFun (Fin P) ℝ (I i)
    else 0
  -- Step 2: `A α = (c_I α)_I`, moved into `EuclideanSpace ℝ (Fin n → Fin P)`
  refine ⟨(EuclideanSpace.equiv (Fin n → Fin P) ℝ).symm.toContinuousLinearMap.comp
    (ContinuousLinearMap.pi c), fun α => ?_⟩
  -- Step 3: `‖A α‖ = √(∑_I |c_I α|²)` and `|c_I α|² = [StrictMono I] α(e_I)²` termwise
  rw [EuclideanSpace.norm_eq, covectorEuclideanNorm]
  congr 1
  refine Finset.sum_congr rfl fun I _ => ?_
  by_cases hI : StrictMono I <;> simp [c, hI]
/-- **`Λⁿ(ℝᴾ)` is finite-dimensional** (Simon Ch. 6, 1.2; used by Tietze in the smooth unit
approximation behind the mass of `τ(M, θ, ξ)`).  With `e` the standard basis of `ℝᴾ`, the map
`Φ α = (α(e_{v(0)}, …, e_{v(n-1)}))_{v : Fin n → Fin P}` is linear into the finite-dimensional
space `ℝ^(Fin n → Fin P)`, and injective: alternating maps agreeing on distinct basis vectors are
equal, and a continuous alternating map is determined by its underlying alternating map. -/
theorem Submission.dor_ims_sua_covector_finiteDimensional : ∀ (P n : ℕ), FiniteDimensional ℝ (Covector (Euclid P) n) := by
  intro P n
  -- Step 1: the standard basis `e` of `ℝᴾ`
  let e := (EuclideanSpace.basisFun (Fin P) ℝ).toBasis
  -- Step 2: `Φ α = (α(e ∘ v))_v`, linear since covector operations are pointwise
  let Φ : Covector (Euclid P) n →ₗ[ℝ] ((Fin n → Fin P) → ℝ) :=
    { toFun := fun α v => α fun i => e (v i)
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  -- Steps 3–4: `Φ` is injective into the finite-dimensional `(Fin n → Fin P) → ℝ`
  refine FiniteDimensional.of_injective Φ fun α α' h => ?_
  exact ContinuousAlternatingMap.toAlternatingMap_injective
    (e.ext_alternating fun v _ => congr_fun h v)
/-- **Continuous unit extension** (steps 0 and 2–5 of the smooth unit approximation behind the
mass of `τ(M, θ, ξ)`).  Let `K ⊆ V ⊆ ℝᴾ`, `K` compact, `V` open, and let `β : ℝᴾ → Λⁿ(ℝᴾ)` be
continuous on `K` with `|β| ≤ 1` there, `|·|` the Euclidean coefficient norm.  Then `β|_K`
extends to a continuous `g` with compact support in `V` and `|g| ≤ 1` everywhere.  Tietze is
proved in place for the complete normed space `Λⁿ(ℝᴾ)`: partitions of unity subordinate to
finite `δ`-nets of `K` give continuous `G_k` with `‖G_k - β‖ ≤ 2⁻ᵏ` on `K`, and
`B = G₀ + ∑ₖ D_k`, with `D_k` the difference `G_{k+1} - G_k` clamped to the ball of radius
`2 · 2⁻ᵏ`, is a uniformly convergent series of continuous maps equal to `β` on `K`.  Then retract
radially by `ρ(α) = max(1, |α|)⁻¹ α` and cut off by `χ = max(0, 1 − dist(·, K)/r)` with
`cthickening r K ⊆ V`; `g = χ · (ρ ∘ B)`. -/
theorem Submission.dor_ims_sua_continuous_unit_extension : ∀ (P n : ℕ) (K V : Set (Euclid P)) (β : Euclid P → Covector (Euclid P) n), IsCompact K → IsOpen V → K ⊆ V → ContinuousOn β K → (∀ x ∈ K, covectorEuclideanNorm (β x) ≤ 1) → ∃ g : Euclid P → Covector (Euclid P) n, Continuous g ∧ HasCompactSupport g ∧ tsupport g ⊆ V ∧ (∀ x, covectorEuclideanNorm (g x) ≤ 1) ∧ ∀ x ∈ K, g x = β x := by
  intro P n K V β hK hV hKV hβ hβ1
  -- Step 0: if `K = ∅`, take `g = 0`
  rcases K.eq_empty_or_nonempty with rfl | hKne
  · exact ⟨0, continuous_zero, HasCompactSupport.zero, by simp, by simp, by simp⟩
  -- Step 1: `|α| = ‖A α‖`, so `|·|` is continuous and `|c • α| = |c| |α|`
  obtain ⟨A, hA⟩ := Submission.dor_ims_sua_coeff_norm_rep P n
  have hN1 : Continuous fun α : Covector (Euclid P) n => covectorEuclideanNorm α := by
    simpa only [hA] using A.continuous.norm
  have hN2 : ∀ (c : ℝ) (α : Covector (Euclid P) n),
      covectorEuclideanNorm (c • α) = |c| * covectorEuclideanNorm α := by
    intro c α
    rw [hA, hA, map_smul, norm_smul, Real.norm_eq_abs]
  -- Step 2: Tietze, a continuous `B` with `B = β` on `K`
  obtain ⟨B, hBc, hBK⟩ : ∃ B : Euclid P → Covector (Euclid P) n, Continuous B ∧
      ∀ x ∈ K, B x = β x := by
    -- (a) a partition of unity on a finite `δ`-net of `K` averages `β` to within `ε` on `K`
    have happrox : ∀ ε > 0, ∃ G : Euclid P → Covector (Euclid P) n, Continuous G ∧
        ∀ x ∈ K, ‖G x - β x‖ ≤ ε := by
      intro ε hε
      obtain ⟨δ, hδ, hβδ⟩ :=
        Metric.uniformContinuousOn_iff.1 (hK.uniformContinuousOn_of_continuous hβ) ε hε
      obtain ⟨t, htK, hKt⟩ :=
        hK.elim_nhds_subcover (fun a => ball a δ) fun a _ => ball_mem_nhds a hδ
      obtain ⟨φ, hφ⟩ := PartitionOfUnity.exists_isSubordinate hK.isClosed
        (fun a : t => ball (a : Euclid P) δ) (fun a => isOpen_ball) fun x hx => by
          obtain ⟨a, ha, hxa⟩ := mem_iUnion₂.1 (hKt hx)
          exact mem_iUnion.2 ⟨⟨a, ha⟩, hxa⟩
      refine ⟨fun x => ∑ a : t, φ a x • β a,
        continuous_finsetSum _ fun a _ => (φ a).continuous.smul continuous_const, fun x hx => ?_⟩
      have h1 : ∑ a : t, φ a x = 1 := by
        rw [← finsum_eq_sum_of_fintype]
        exact φ.sum_eq_one hx
      calc ‖∑ a : t, φ a x • β a - β x‖ = ‖∑ a : t, φ a x • (β a - β x)‖ := by
            simp only [smul_sub, Finset.sum_sub_distrib, ← Finset.sum_smul, h1, one_smul]
        _ ≤ ∑ a : t, ‖φ a x • (β a - β x)‖ := norm_sum_le _ _
        _ ≤ ∑ a : t, φ a x * ε := by
            refine Finset.sum_le_sum fun a _ => ?_
            rw [norm_smul, Real.norm_of_nonneg (φ.nonneg a x)]
            rcases eq_or_ne (φ a x) 0 with h | h
            · simp [h]
            · refine mul_le_mul_of_nonneg_left ?_ (φ.nonneg a x)
              rw [← dist_eq_norm]
              exact (hβδ a (htK a a.2) x hx (mem_ball'.1 (hφ a (subset_tsupport _ h)))).le
        _ = ε := by rw [← Finset.sum_mul, h1, one_mul]
    choose G hGc hGK using fun k : ℕ => happrox ((1 / 2) ^ k) (by positivity)
    -- (b) clamp `G_{k+1} - G_k` to the ball of radius `2 · 2⁻ᵏ`; on `K` nothing changes
    have hc : ∀ k : ℕ, 0 < 2 * (1 / 2 : ℝ) ^ k := fun k => by positivity
    obtain ⟨D, hD⟩ : ∃ D : ℕ → Euclid P → Covector (Euclid P) n, ∀ k x,
        D k x = (max 1 (‖G (k + 1) x - G k x‖ / (2 * (1 / 2) ^ k)))⁻¹ • (G (k + 1) x - G k x) :=
      ⟨_, fun _ _ => rfl⟩
    have hDc : ∀ k, Continuous (D k) := by
      intro k
      have hv : Continuous fun x => G (k + 1) x - G k x := (hGc (k + 1)).sub (hGc k)
      refine Continuous.congr ?_ fun x => (hD k x).symm
      exact ((continuous_const.max (hv.norm.div_const _)).inv₀ fun x =>
        (zero_lt_one.trans_le (le_max_left _ _)).ne').smul hv
    have hDb : ∀ k x, ‖D k x‖ ≤ 2 * (1 / 2) ^ k := by
      intro k x
      have hm : 0 < max 1 (‖G (k + 1) x - G k x‖ / (2 * (1 / 2) ^ k)) :=
        zero_lt_one.trans_le (le_max_left _ _)
      rw [hD, norm_smul, norm_inv, Real.norm_of_nonneg hm.le, inv_mul_le_iff₀ hm]
      calc ‖G (k + 1) x - G k x‖
          = ‖G (k + 1) x - G k x‖ / (2 * (1 / 2) ^ k) * (2 * (1 / 2) ^ k) :=
            (div_mul_cancel₀ _ (hc k).ne').symm
        _ ≤ max 1 (‖G (k + 1) x - G k x‖ / (2 * (1 / 2) ^ k)) * (2 * (1 / 2) ^ k) :=
            mul_le_mul_of_nonneg_right (le_max_right _ _) (hc k).le
    have hDK : ∀ k, ∀ x ∈ K, D k x = G (k + 1) x - G k x := by
      intro k x hx
      have h2 : ‖G (k + 1) x - G k x‖ ≤ 2 * (1 / 2) ^ k := by
        calc ‖G (k + 1) x - G k x‖ = ‖(G (k + 1) x - β x) - (G k x - β x)‖ := by
              rw [sub_sub_sub_cancel_right]
          _ ≤ ‖G (k + 1) x - β x‖ + ‖G k x - β x‖ := norm_sub_le _ _
          _ ≤ (1 / 2) ^ (k + 1) + (1 / 2) ^ k := add_le_add (hGK _ x hx) (hGK _ x hx)
          _ ≤ 2 * (1 / 2) ^ k := by
              rw [pow_succ]
              linarith [pow_pos (by norm_num : (0 : ℝ) < 1 / 2) k]
      rw [hD, max_eq_left ((div_le_one (hc k)).2 h2), inv_one, one_smul]
    -- (c) `B = G₀ + ∑ D_k` converges uniformly; on `K` the series telescopes to `β - G₀`
    refine ⟨fun x => G 0 x + ∑' k, D k x,
      (hGc 0).add (continuous_tsum hDc (summable_geometric_two.mul_left 2) hDb), fun x hx => ?_⟩
    have hs : Summable fun k => D k x :=
      Summable.of_norm_bounded (summable_geometric_two.mul_left 2) fun k => hDb k x
    have hTel : ∀ N, ∑ k ∈ Finset.range N, D k x = G N x - G 0 x := by
      intro N
      induction N with
      | zero => simp
      | succ N ih => rw [Finset.sum_range_succ, ih, hDK N x hx]; abel
    have hG : Tendsto (fun N => G N x) atTop (𝓝 (β x)) := by
      rw [tendsto_iff_norm_sub_tendsto_zero]
      exact squeeze_zero (fun N => norm_nonneg _) (fun N => hGK N x hx)
        (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num))
    have hlim := tendsto_nhds_unique hs.hasSum.tendsto_sum_nat
      ((hG.sub_const (G 0 x)).congr fun N => (hTel N).symm)
    show G 0 x + ∑' k, D k x = β x
    rw [hlim]
    abel
  -- Step 3: the radial retraction `ρ(α) = max(1, |α|)⁻¹ α` onto `{|α| ≤ 1}`
  let ρ : Covector (Euclid P) n → Covector (Euclid P) n :=
    fun α => (max 1 (covectorEuclideanNorm α))⁻¹ • α
  have hm : ∀ α : Covector (Euclid P) n, 0 < max 1 (covectorEuclideanNorm α) :=
    fun α => zero_lt_one.trans_le (le_max_left _ _)
  have hρ : Continuous ρ :=
    ((continuous_const.max hN1).inv₀ fun α => (hm α).ne').smul continuous_id
  have hρ1 : ∀ α, covectorEuclideanNorm (ρ α) ≤ 1 := by
    intro α
    rw [hN2, abs_of_pos (inv_pos.2 (hm α))]
    exact inv_mul_le_one_of_le₀ (le_max_right _ _) (hm α).le
  have hρid : ∀ α, covectorEuclideanNorm α ≤ 1 → ρ α = α := by
    intro α hα
    simp [ρ, max_eq_left hα]
  -- Step 4: the cut-off `χ = max(0, 1 − dist(·, K)/r)`, where `cthickening r K ⊆ V`
  obtain ⟨r, hr, hrV⟩ := hK.exists_cthickening_subset_open hV hKV
  let χ : Euclid P → ℝ := fun x => max 0 (1 - infDist x K / r)
  have hχ : Continuous χ :=
    continuous_const.max (continuous_const.sub ((continuous_infDist_pt K).div_const r))
  have hχ0 : ∀ x, 0 ≤ χ x := fun x => le_max_left _ _
  have hχ1 : ∀ x, χ x ≤ 1 := fun x =>
    max_le zero_le_one (sub_le_self _ (div_nonneg infDist_nonneg hr.le))
  have hχK : ∀ x ∈ K, χ x = 1 := by
    intro x hx
    simp [χ, infDist_zero_of_mem hx]
  have hχr : ∀ x, χ x ≠ 0 → x ∈ thickening r K := by
    intro x hx
    rw [mem_thickening_iff_infDist_lt hKne]
    by_contra h
    refine hx (max_eq_left ?_)
    rw [sub_nonpos, le_div_iff₀ hr, one_mul]
    exact not_lt.1 h
  -- Step 5: `g = χ · (ρ ∘ B)` has `tsupport g ⊆ cthickening r K ⊆ V`, compact
  have hsupp : support (fun x => χ x • ρ (B x)) ⊆ thickening r K := fun x hx =>
    hχr x fun h => hx (by simp [h])
  have htsupp : tsupport (fun x => χ x • ρ (B x)) ⊆ cthickening r K :=
    (closure_mono hsupp).trans (closure_thickening_subset_cthickening r K)
  refine ⟨fun x => χ x • ρ (B x), hχ.smul (hρ.comp hBc),
    hK.cthickening.of_isClosed_subset (isClosed_tsupport _) htsupp, htsupp.trans hrV,
    fun x => ?_, fun x hx => ?_⟩
  · -- `|g x| = χ x |ρ (B x)| ≤ χ x ≤ 1`
    rw [hN2, abs_of_nonneg (hχ0 x)]
    exact (mul_le_of_le_one_right (hχ0 x) (hρ1 _)).trans (hχ1 x)
  · -- on `K`: `χ = 1`, `B = β` and `|β| ≤ 1`, so `g = ρ ∘ β = β`
    simp only [hχK x hx, one_smul, hBK x hx, hρid _ (hβ1 x hx)]

/-- **Mollifying a unit covector field** (smooth unit approximation, step 6).  A continuous,
compactly supported `n`-covector field `g` with `tsupport g ⊆ V` (`V` open) and `|g| ≤ 1` for the
Euclidean coefficient norm `|·|` is uniformly `ε`-approximated in `|·|` by a test form `ω` with
`tsupport ω ⊆ V` and `|ω| ≤ 1`.

Write `|α| = ‖Aα‖` for a continuous linear coefficient map `A` (`dor_ims_sua_coeff_norm_rep`), so
`|α| ≤ ‖A‖‖α‖`.  Take `r > 0` with `cthickening r (tsupport g) ⊆ V`, and `s ≤ r` such that
`‖g y − g x‖ < ε/(‖A‖+1)` when `dist y x < s` (uniform continuity).  Let `ω = ψ ⋆ g`, where
`ψ = φ / ∫ φ` normalizes a smooth bump `φ ≥ 0` with `support φ = B_s(0)`.  Then `ω` is `C^∞` with
compact support and `tsupport ω ⊆ cthickening s (tsupport g) ⊆ V`; `Aω(x) = (ψ ⋆ (A ∘ g))(x)` is
an average of values of norm `|g| ≤ 1`; and `‖ω(x) − g(x)‖ ≤ ε/(‖A‖+1)`, whence
`|ω(x) − g(x)| ≤ ε`. -/
theorem Submission.dor_ims_sua_mollify_unit_field : ∀ (P n : ℕ) (V : Set (Euclid P)) (g : Euclid P → Covector (Euclid P) n) (ε : ℝ), IsOpen V → Continuous g → HasCompactSupport g → tsupport g ⊆ V → (∀ x, covectorEuclideanNorm (g x) ≤ 1) → 0 < ε → ∃ ω : DifferentialForm (Euclid P) n, IsTestForm ω ∧ tsupport ω ⊆ V ∧ (∀ x, covectorEuclideanNorm (ω x) ≤ 1) ∧ ∀ x, covectorEuclideanNorm (ω x - g x) ≤ ε := by
  intro P n V g ε hV hgc hgs hgV hg1 hε
  -- (1) the coefficient map `A` with `|α| = ‖A α‖ ≤ ‖A‖ ‖α‖`
  obtain ⟨A, hA⟩ := Submission.dor_ims_sua_coeff_norm_rep P n
  have hC : 0 < ‖A‖ + 1 := by positivity
  -- (2) a support margin `r`
  obtain ⟨r, hr, hrV⟩ := hgs.isCompact.exists_cthickening_subset_open hV hgV
  -- (3) uniform continuity of `g`, and the radius `s = min s₀ r`
  obtain ⟨s₀, hs₀, hgs₀⟩ := Metric.uniformContinuous_iff.mp
    (hgs.uniformContinuous_of_continuous hgc) (ε / (‖A‖ + 1)) (div_pos hε hC)
  have hs : 0 < min s₀ r := lt_min hs₀ hr
  -- (4) a smooth bump `φ` with `support φ = B_s(0)`, and `ψ = φ / ∫ φ`: `ψ ≥ 0`, `∫ ψ = 1`
  let φ : ContDiffBump (0 : Euclid P) := ⟨min s₀ r / 2, min s₀ r, half_pos hs, half_lt_self hs⟩
  have hφ : 0 < ∫ y, φ y := by
    refine (integral_pos_iff_support_of_nonneg φ.nonneg'
      (φ.continuous.integrable_of_hasCompactSupport φ.hasCompactSupport)).mpr ?_
    rw [φ.support_eq]
    exact measure_ball_pos volume 0 hs
  let ψ : Euclid P → ℝ := fun y => φ y / ∫ y, φ y
  have hψφ : support ψ ⊆ support φ := fun y hy h => hy (by simp [ψ, h])
  have hψs : support ψ ⊆ ball 0 (min s₀ r) := hψφ.trans φ.support_eq.subset
  have hψc : HasCompactSupport ψ := φ.hasCompactSupport.mono hψφ
  have hψ0 : ∀ y, 0 ≤ ψ y := fun y => div_nonneg φ.nonneg hφ.le
  have hψ1 : ∫ y, ψ y = 1 := by rw [integral_div, div_self hφ.ne']
  -- (5) `ω = ψ ⋆ g`
  let ω : DifferentialForm (Euclid P) n :=
    convolution ψ g (ContinuousLinearMap.lsmul ℝ ℝ) volume
  have hgi : LocallyIntegrable g volume := hgc.locallyIntegrable
  have hω : ConvolutionExists ψ g (ContinuousLinearMap.lsmul ℝ ℝ) volume :=
    hψc.convolutionExists_left _ (φ.continuous.div_const _) hgi
  refine ⟨ω, ⟨?_, ?_⟩, ?_, ?_, ?_⟩
  · -- (6) smoothness
    exact hψc.contDiff_convolution_left _ (φ.contDiff.div_const _) hgi
  · exact hψc.convolution _ hgs
  · -- (7) `spt ω ⊆ cthickening s (tsupport g) ⊆ V`
    have hsupp : support ω ⊆ thickening (min s₀ r) (tsupport g) := by
      refine (support_convolution_subset _).trans ?_
      rintro _ ⟨t, ht, z, hz, rfl⟩
      have ht' : ‖t‖ < min s₀ r := mem_ball_zero_iff.mp (hψs ht)
      exact mem_thickening_iff.mpr ⟨z, subset_tsupport g hz, by
        rwa [dist_eq_norm, add_sub_cancel_right]⟩
    calc tsupport ω ⊆ closure (thickening (min s₀ r) (tsupport g)) := closure_mono hsupp
      _ ⊆ cthickening (min s₀ r) (tsupport g) := closure_thickening_subset_cthickening _ _
      _ ⊆ cthickening r (tsupport g) := cthickening_mono (min_le_right _ _) _
      _ ⊆ V := hrV
  · -- (8) `|ω x| = ‖(ψ ⋆ (A ∘ g)) x‖ ≤ 1`
    intro x
    have hAω : A (ω x) = convolution ψ (fun y => A (g y))
        (ContinuousLinearMap.lsmul ℝ ℝ) volume x := by
      calc A (ω x) = ∫ t, A (ContinuousLinearMap.lsmul ℝ ℝ (ψ t) (g (x - t))) :=
            (A.integral_comp_comm (hω x).integrable).symm
        _ = _ := by simp only [convolution_def, ContinuousLinearMap.lsmul_apply, map_smul]
    rw [hA, hAω, ← dist_zero_right]
    exact dist_convolution_le zero_le_one hψs hψ0 hψ1
      (A.continuous.comp hgc).aestronglyMeasurable fun y _ => by
        rw [dist_zero_right, ← hA]
        exact hg1 y
  · -- (9) `‖ω x − g x‖ ≤ ε/(‖A‖+1)`, hence `|ω x − g x| ≤ ‖A‖ ε/(‖A‖+1) ≤ ε`
    intro x
    have hd : dist (ω x) (g x) ≤ ε / (‖A‖ + 1) :=
      dist_convolution_le (div_pos hε hC).le hψs hψ0 hψ1 hgc.aestronglyMeasurable fun y hy =>
        (hgs₀ ((mem_ball.mp hy).trans_le (min_le_left _ _))).le
    calc covectorEuclideanNorm (ω x - g x) = ‖A (ω x - g x)‖ := hA _
      _ ≤ ‖A‖ * dist (ω x) (g x) := by rw [dist_eq_norm]; exact A.le_opNorm _
      _ ≤ ‖A‖ * (ε / (‖A‖ + 1)) := by gcongr
      _ ≤ ε := by
        rw [mul_div_assoc', div_le_iff₀ hC]
        nlinarith [norm_nonneg A]

/-- **A smooth cut-off in `V` that equals `1` off a set of small measure** (smooth cut-off step
of the approximation of the mass of `τ(M, θ, ξ)` by test forms).  `ν` is finite, so it is inner
regular by compact sets: there is a compact `K ⊆ V` with `ν(V \ K) < δ`.  Choose an open `V₀`
with `K ⊆ V₀` and `closure V₀` compact and contained in `V`.  The smooth Urysohn lemma gives a
`C^∞` function `χ` with values in `[0, 1]`, `support χ = V₀` and `χ = 1` exactly on `K`.  Then
`tsupport χ = closure V₀` is compact and contained in `V`, and
`ν{χ ≠ 1} = ν(Kᶜ) ≤ ν(Vᶜ) + ν(V \ K) = ν(V \ K) < δ`. -/
theorem Submission.rsd_mw_tfa_smooth_cutoff : ∀ (P : ℕ) (ν : Measure (Euclid P)) (V : Set (Euclid P)), IsFiniteMeasure ν → IsOpen V → ν Vᶜ = 0 → ∀ δ : ℝ, 0 < δ → ∃ χ : Euclid P → ℝ, ContDiff ℝ (⊤ : ℕ∞) χ ∧ HasCompactSupport χ ∧ tsupport χ ⊆ V ∧ (∀ x, 0 ≤ χ x ∧ χ x ≤ 1) ∧ ν {x | χ x ≠ 1} < ENNReal.ofReal δ := by
  intro P ν V hν hV hVc δ hδ
  -- Step 1: a compact core `K ⊆ V` with `ν (V \ K) < δ`, by inner regularity of finite `ν`
  obtain ⟨K, hKV, hKc, hVK⟩ := hV.measurableSet.exists_isCompact_sdiff_lt (measure_ne_top ν V)
    (ENNReal.ofReal_pos.mpr hδ).ne'
  -- Step 2: an open `V₀ ⊇ K` whose closure is compact and contained in `V`
  obtain ⟨V₀, hV₀o, hKV₀, hV₀V, hV₀c⟩ := exists_open_between_and_isCompact_closure hKc hV hKV
  -- Step 3: smooth Urysohn: `χ` is `C^∞`, `[0, 1]`-valued, `support χ = V₀`, `χ = 1` exactly on `K`
  obtain ⟨χ, hχ, hχr, hχs, hχ1⟩ :=
    exists_contDiff_support_eq_eq_one_iff (n := ⊤) hV₀o hKc.isClosed hKV₀
  -- Step 4: `tsupport χ = closure V₀`
  have hts : tsupport χ = closure V₀ := by rw [tsupport, hχs]
  refine ⟨χ, hχ, ?_, hts ▸ hV₀V, fun x => hχr (mem_range_self x), ?_⟩
  · rw [HasCompactSupport, hts]
    exact hV₀c
  -- Step 5: `{χ ≠ 1} = Kᶜ ⊆ Vᶜ ∪ (V \ K)` and `ν Vᶜ = 0`
  have hset : {x | χ x ≠ 1} = Kᶜ := by
    ext x
    exact (hχ1 x).not.symm
  calc ν {x | χ x ≠ 1} = ν Kᶜ := by rw [hset]
    _ ≤ ν (Vᶜ ∪ V \ K) := measure_mono fun x hx => by
        by_cases h : x ∈ V
        · exact Or.inr ⟨h, hx⟩
        · exact Or.inl h
    _ ≤ ν Vᶜ + ν (V \ K) := measure_union_le _ _
    _ = ν (V \ K) := by rw [hVc, zero_add]
    _ < ENNReal.ofReal δ := hVK

/-- **Test forms approximating a unit-bounded integrable covector field in `L¹(ν)`** (the
approximation behind `M_W(T) = ∫_{M ∩ W} θ dHⁿ`, Simon 6.3.2(3); `|·|_E` is
`covectorEuclideanNorm`).  Let `m = ν(ℝᴾ)` and `δ = ε/(4(m + 1))`.  The smooth cut-off `χ` of
`Submission.rsd_mw_tfa_smooth_cutoff` satisfies `tsupport χ ⊆ V` and `ν{χ ≠ 1} < ε/8`.  The
continuous field `g₁` of `Submission.rsd_mw_tfa_continuous_approx` satisfies `|g₁|_E ≤ 1` and
`∫ |g₁ − β|_E dν < ε/4`.  Its smoothing `g₂` (`Submission.rsd_mw_tfa_smooth_uniform_approx`)
satisfies `|g₂|_E ≤ 1` and `|g₂ − g₁|_E ≤ δ`.  Then `ω = χ g₂` is a test form, `tsupport ω ⊆ V`
and `|ω|_E ≤ 1`.  For a.e. `x`, `|ω − β|_E ≤ δ + |g₁ − β|_E` where `χ = 1`, and
`|ω − β|_E ≤ 2` where `χ ≠ 1`.  Integrating,
`∫ |ω − β|_E dν ≤ δm + ∫ |g₁ − β|_E dν + 2ν{χ ≠ 1} < ε/4 + ε/4 + ε/4 < ε`. -/
theorem Submission.rsd_mw_exists_testForm_approx : ∀ (P n : ℕ) (ν : Measure (Euclid P)) (V : Set (Euclid P)) (β : Euclid P → Covector (Euclid P) n), IsFiniteMeasure ν → IsOpen V → ν Vᶜ = 0 → Integrable β ν → (∀ᵐ x ∂ν, covectorEuclideanNorm (β x) ≤ 1) → ∀ ε : ℝ, 0 < ε → ∃ ω : DifferentialForm (Euclid P) n, IsTestForm ω ∧ tsupport ω ⊆ V ∧ (∀ x, covectorEuclideanNorm (ω x) ≤ 1) ∧ ∫⁻ x, ENNReal.ofReal (covectorEuclideanNorm (ω x - β x)) ∂ν < ENNReal.ofReal ε := by
  intro P n ν V β hν hV hVc hβ hβ1 ε hε
  -- `N := covectorEuclideanNorm` is subadditive and absolutely homogeneous
  obtain ⟨htri, hsmul, -, -⟩ := Submission.rsd_mw_tfa_norm_props P n
  -- Step 1: a smooth cut-off `χ` with `tsupport χ ⊆ V` and `ν{χ ≠ 1} < ε/8`
  obtain ⟨χ, hχs, hχc, hχV, hχ01, hχν⟩ :=
    Submission.rsd_mw_tfa_smooth_cutoff P ν V hν hV hVc (ε / 8) (by positivity)
  -- Step 2: a continuous compactly supported `g₁` with `N(g₁) ≤ 1` and `∫ N(g₁ - β) dν < ε/4`
  obtain ⟨g₁, hg₁c, hg₁s, hg₁1, hg₁β⟩ :=
    Submission.rsd_mw_tfa_continuous_approx P n ν β hν hβ hβ1 (ε / 4) (by positivity)
  -- Step 3: a smooth `g₂` with `N(g₂) ≤ 1` and `N(g₂ - g₁) ≤ δ = ε/(4(m + 1))`, `m = ν(ℝᴾ)`
  set m : ℝ := (ν univ).toReal with hm
  have hm0 : 0 ≤ m := ENNReal.toReal_nonneg
  set δ : ℝ := ε / (4 * (m + 1)) with hδ
  have hδ0 : 0 < δ := by positivity
  obtain ⟨g₂, hg₂s, hg₂1, hg₂g₁⟩ :=
    Submission.rsd_mw_tfa_smooth_uniform_approx P n g₁ hg₁c hg₁s hg₁1 δ hδ0
  -- Step 4: `ω = χ g₂` is a test form with `tsupport ω ⊆ V` and `N(ω) ≤ 1`
  have hω1 : ∀ x, covectorEuclideanNorm (χ x • g₂ x) ≤ 1 := fun x => by
    rw [hsmul, abs_of_nonneg (hχ01 x).1]
    exact (mul_le_of_le_one_left (covectorEuclideanNorm_nonneg _) (hχ01 x).2).trans (hg₂1 x)
  refine ⟨fun x => χ x • g₂ x, ⟨hχs.smul hg₂s, hχc.smul_right⟩,
    (tsupport_smul_subset_left χ g₂).trans hχV, hω1, ?_⟩
  -- Step 5: a.e., `N(ω - β) ≤ δ + N(g₁ - β)` where `χ = 1` and `N(ω - β) ≤ 2` on `S = {χ ≠ 1}`
  set S : Set (Euclid P) := {x | χ x ≠ 1}
  have hSm : MeasurableSet S := (isOpen_ne_fun hχs.continuous continuous_const).measurableSet
  have hpt : ∀ᵐ x ∂ν, ENNReal.ofReal (covectorEuclideanNorm (χ x • g₂ x - β x)) ≤
      ENNReal.ofReal δ + ENNReal.ofReal (covectorEuclideanNorm (g₁ x - β x)) +
        S.indicator (fun _ => (2 : ℝ≥0∞)) x := by
    filter_upwards [hβ1] with x hx
    by_cases h1 : χ x = 1
    · rw [indicator_of_notMem (not_not.mpr h1), add_zero,
        ← ENNReal.ofReal_add hδ0.le (covectorEuclideanNorm_nonneg _), h1, one_smul]
      refine ENNReal.ofReal_le_ofReal ?_
      calc covectorEuclideanNorm (g₂ x - β x)
          = covectorEuclideanNorm ((g₂ x - g₁ x) + (g₁ x - β x)) := by rw [sub_add_sub_cancel]
        _ ≤ covectorEuclideanNorm (g₂ x - g₁ x) + covectorEuclideanNorm (g₁ x - β x) :=
          htri _ _
        _ ≤ δ + covectorEuclideanNorm (g₁ x - β x) := by linarith [hg₂g₁ x]
    · rw [indicator_of_mem h1]
      refine le_add_left (le_of_le_of_eq (ENNReal.ofReal_le_ofReal ?_) (ENNReal.ofReal_ofNat 2))
      calc covectorEuclideanNorm (χ x • g₂ x - β x)
          = covectorEuclideanNorm (χ x • g₂ x + -β x) := by rw [sub_eq_add_neg]
        _ ≤ covectorEuclideanNorm (χ x • g₂ x) + covectorEuclideanNorm (-β x) := htri _ _
        _ ≤ 2 := by rw [covectorEuclideanNorm_neg]; linarith [hω1 x]
  -- Step 6: integrate, `∫ N(ω - β) dν ≤ δm + ∫ N(g₁ - β) dν + 2ν(S) < 3ε/4`
  have hδm : ENNReal.ofReal δ * ν univ ≤ ENNReal.ofReal (ε / 4) := by
    rw [← ENNReal.ofReal_toReal (measure_ne_top ν univ), ← hm, ← ENNReal.ofReal_mul hδ0.le]
    refine ENNReal.ofReal_le_ofReal ?_
    calc δ * m ≤ δ * (m + 1) := by nlinarith
      _ = ε / 4 := by rw [hδ]; field_simp
  have hS2 : 2 * ν S < ENNReal.ofReal (ε / 4) := by
    calc 2 * ν S = ν S + ν S := two_mul _
      _ < ENNReal.ofReal (ε / 8) + ENNReal.ofReal (ε / 8) := ENNReal.add_lt_add hχν hχν
      _ = ENNReal.ofReal (ε / 4) := by
          rw [← ENNReal.ofReal_add (by positivity) (by positivity)]
          ring_nf
  calc ∫⁻ x, ENNReal.ofReal (covectorEuclideanNorm (χ x • g₂ x - β x)) ∂ν
      ≤ ∫⁻ x, (ENNReal.ofReal δ + ENNReal.ofReal (covectorEuclideanNorm (g₁ x - β x)) +
          S.indicator (fun _ => (2 : ℝ≥0∞)) x) ∂ν := lintegral_mono_ae hpt
    _ = ENNReal.ofReal δ * ν univ +
          ∫⁻ x, ENNReal.ofReal (covectorEuclideanNorm (g₁ x - β x)) ∂ν + 2 * ν S := by
        rw [lintegral_add_right _ (measurable_const.indicator hSm),
          lintegral_add_left measurable_const, lintegral_const, lintegral_indicator_const hSm]
    _ < ENNReal.ofReal (ε / 4) + ENNReal.ofReal (ε / 4) + ENNReal.ofReal (ε / 4) :=
        ENNReal.add_lt_add (ENNReal.add_lt_add_of_le_of_lt
          (ENNReal.mul_ne_top ENNReal.ofReal_ne_top (measure_ne_top ν univ)) hδm hg₁β) hS2
    _ ≤ ENNReal.ofReal ε := by
        rw [← ENNReal.ofReal_add (by positivity) (by positivity),
          ← ENNReal.ofReal_add (by positivity) (by positivity)]
        exact ENNReal.ofReal_le_ofReal (by linarith)

/-- **Simon Ch. 6, Remark 3.2(3), `≥` half** (with 2.5 and Remark 2.6(a)–(b)): `μ_T(W) ≤ M_W(T)`
for `T = τ(M, θ, ξ)` and open `W ⊆ U`.  Given `c < μ_T(W)`, take an open `V ⊆ W` with
`c < μ_T(V) < ∞` and put `ν = μ_T⌞V`.  With `J` as in `Submission.rsd_mw_unit_orientation_dual`,
`β = J ∘ ξ` is `ν`-integrable, and `ν`-a.e. `|β| = 1`, `⟨β, ξ⟩ = 1` and `|⟨α, ξ⟩| ≤ |α|`.  A test
form `ω` with `spt ω ⊆ V`, `|ω| ≤ 1` and `∫ |ω − β| dν < ε = (μ_T(V) − c)/2` is admissible for
`M_W(T)`, and `T(ω) = ∫ ⟨ω, ξ⟩ dν > ν(ℝᴾ) − ε = (μ_T(V) + c)/2 > c`. -/
theorem Submission.rsd_mw_measure_le_massOn : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), R.Represents T → ∀ W : Set (Euclid P), IsOpen W → W ⊆ U → R.measure W ≤ T.massOn W := by
  intro P n U T R hT W hW hWU
  obtain ⟨J, hJ⟩ := Submission.rsd_mw_unit_orientation_dual P n
  -- it suffices to show `c < M_W(T)` for every `c < μ_T(W)`
  refine le_of_forall_lt fun c hcW => ?_
  -- an open `V ⊆ W` with `c < μ_T(V) < ∞`
  obtain ⟨V, hV, hVW, hcV, hVfin⟩ :=
    Submission.rsd_mw_wlm_exists_open_measure_between P n U R W hW hWU c hcW
  -- `ν = μ_T⌞V` is finite, vanishes off `V`, and `ν ≪ μ_T ≪ Hⁿ⌞M`
  set ν := R.measure.restrict V with hν
  have hνfin : IsFiniteMeasure ν := isFiniteMeasure_restrict.2 hVfin.ne
  have hνVc : ν Vᶜ = 0 := by
    rw [hν, Measure.restrict_apply' hV.measurableSet, compl_inter_self, measure_empty]
  have hμac : R.measure ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
  have hνac : ν ≪ μHE[n].restrict R.carrier :=
    Measure.restrict_le_self.absolutelyContinuous.trans hμac
  -- `ν`-a.e. `ξ(x)` is a unit orientation
  have hG : ∀ᵐ x ∂ν, ∃ Q : Submodule ℝ (Euclid P), IsUnitOrientationOf (R.orient x) Q := by
    filter_upwards [hνac.ae_le R.orients] with x hx
    obtain ⟨Q, -, hQ⟩ := hx
    exact ⟨Q, hQ⟩
  have hξ : AEStronglyMeasurable R.orient ν := R.aestronglyMeasurable_orient.mono_ac hνac
  -- `β = J ∘ ξ` is `ν`-integrable, as `‖ξ‖ ≤ 1` `ν`-a.e., and `|β| ≤ 1` `ν`-a.e.
  have hβ : Integrable (fun x => J (R.orient x)) ν := by
    refine Submission.rsd_mw_wlm_integrable_clm_comp P n ν R.orient J hνfin hξ ?_
    filter_upwards [hG] with x hx
    obtain ⟨Q, hQ⟩ := hx
    exact Submission.rsd_mw_wlm_orient_opNorm_le_one P n Q (R.orient x) hQ
  have hβ1 : ∀ᵐ x ∂ν, covectorEuclideanNorm (J (R.orient x)) ≤ 1 := by
    filter_upwards [hG] with x hx
    obtain ⟨Q, hQ⟩ := hx
    exact (hJ _ Q hQ).2.1.le
  -- `c < ∞`, and `ε = (μ_T(V) − c)/2 > 0` in `ℝ`
  have hctop : c ≠ ∞ := ne_top_of_lt hcV
  have hcV' : c.toReal < (R.measure V).toReal := (ENNReal.toReal_lt_toReal hctop hVfin.ne).2 hcV
  set ε := ((R.measure V).toReal - c.toReal) / 2 with hε
  have hε0 : 0 < ε := by linarith
  -- a test form `ω` with `spt ω ⊆ V`, `|ω| ≤ 1` and `∫ |ω − β| dν < ε`
  obtain ⟨ω, hωt, hωV, hω1, hωβ⟩ := Submission.rsd_mw_exists_testForm_approx P n ν V
    (fun x => J (R.orient x)) hνfin hV hνVc hβ hβ1 ε hε0
  -- `ω` is admissible for `M_W(T)`
  let ω' : TestFormOn U n := ⟨ω, hωt, hωV.trans (hVW.trans hWU)⟩
  have hadm : ω' ∈ massAdmissibleOn U n W := ⟨hωV.trans hVW, hω1⟩
  -- `T(ω) = ∫ ⟨ω, ξ⟩ dν > ν(ℝᴾ) − ε`, where `ν(ℝᴾ) = μ_T(V)`
  have hTω : T ω' = ∫ x, R.orient x (ω x) ∂ν :=
    Submission.rsd_mw_wlm_eval_eq_integral_restrict P n U T R hT V ω' hωV
  have hest := Submission.rsd_mw_wlm_sub_lt_integral P n ν R.orient (fun x => J (R.orient x)) ω
    ε hνfin hξ (ContDiff.continuous hωt.1) hω1 (by
      filter_upwards [hG] with x hx
      obtain ⟨Q, hQ⟩ := hx
      exact ⟨(hJ _ Q hQ).1, (hJ _ Q hQ).2.2⟩) hωβ
  have hνuniv : ν univ = R.measure V := Measure.restrict_apply_univ V
  rw [hνuniv] at hest
  have hlt : c.toReal < T ω' := by
    rw [hTω]
    linarith
  -- `c = ofReal c.toReal < ofReal T(ω) ≤ M_W(T)`
  calc c = ENNReal.ofReal c.toReal := (ENNReal.ofReal_toReal hctop).symm
    _ < ENNReal.ofReal (T ω') :=
        (ENNReal.ofReal_lt_ofReal_iff_of_nonneg ENNReal.toReal_nonneg).2 hlt
    _ ≤ T.massOn W := T.le_massOn hadm

/-- **Simon Ch. 6, Remark 3.2(3)** (with 2.7–2.8): for `T = τ(M, θ, ξ)` integer multiplicity,
`M_W(T) = μ_T(W) = ∫_{M ∩ W} θ dHⁿ` for every open `W ⊆ U`.  The bound `M_W(T) ≤ μ_T(W)` holds for
every `W` (`Submission.rsd_mw_massOn_le_measure`); the reverse bound tests `T` against smooth
admissible forms approximating the unit covector field dual to `ξ`
(`Submission.rsd_mw_measure_le_massOn`). -/
theorem Submission.rsd_massOn_eq_measure : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → W ⊆ U → T.massOn W = R.measure W := by
  intro P n U T R _ hT W hW hWU
  exact le_antisymm (Submission.rsd_mw_massOn_le_measure P n U T R hT W)
    (Submission.rsd_mw_measure_le_massOn P n U T R hT W hW hWU)

/-- **Simon Ch. 4, p. 91** (Ch. 3, Remark 1.8(1)–(2) and Theorem 1.9): for an integer multiplicity
`T = τ(M, θ, ξ)` in open `U`, `Θⁿ(μ_T, x) = θ(x)` for `μ_T`-a.e. `x`.  Write `μ = Hⁿ⌞M`, so
`μ_T = θμ`, and let `x ∈ M` be a `μ`-generic point, with `B̄_s(x) ⊆ U`.
* `R.orients` gives an approximate tangent plane at `x`, so `μ(B̄_ρ(x))/(ωₙρⁿ) → 1`
  (`Submission.rsd_tendsto_closedBall_density_of_approxTangent`).  The required local finiteness
  of `μ` and `μ_T` is `Submission.rsd_imrep_compact_measure_ne_top`.
* Localized Besicovitch differentiation gives `μ_T(B̄_ρ(x))/μ(B̄_ρ(x)) → θ(x)`
  (`Submission.rsd_ae_tendsto_withDensity_div_closedBall`).
* For small `ρ`, `0 < μ(B̄_ρ(x)) < ∞`, so the product of the two ratios is
  `μ_T(B̄_ρ(x))/(ωₙρⁿ)`, which tends to `θ(x)`.
* Open balls give the same limit (`Submission.rsd_tendsto_ball_density_of_closedBall`), and
  `M_{B_ρ(x)}(T) = μ_T(B_ρ(x))` once `B_ρ(x) ⊆ U` (`Submission.rsd_massOn_eq_measure`).

Since `μ_T ≪ μ`, the `μ`-a.e. statement holds `μ_T`-a.e. -/
theorem Submission.rsd_ae_hasMassDensity_mult : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ᵐ x ∂R.measure, HasMassDensity T x (R.mult x) := by
  intro P n U T R hU hR
  -- `μ = Hⁿ⌞M` and `θ = R.mult`; by definition `μ_T = R.measure = θμ`
  set μ : Measure (Euclid P) := μHE[n].restrict R.carrier with hμ
  set θ : Euclid P → ℝ≥0∞ := fun x => (R.mult x : ℝ≥0∞)
  have hθm : Measurable θ := measurable_from_nat.comp R.measurable_mult
  have hμK : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K ≠ ∞ := fun K hK hKU => by
    rw [hμ, Measure.restrict_apply' R.measurableSet_carrier, inter_comm]
    exact (Submission.rsd_imrep_compact_measure_ne_top P n U R K hK hKU).1
  have hνK : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ.withDensity θ K ≠ ∞ :=
    fun K hK hKU => (Submission.rsd_imrep_compact_measure_ne_top P n U R K hK hKU).2
  -- Besicovitch differentiation of `θμ` with respect to `μ`, at `μ`-a.e. `x ∈ U`
  have hbes := Submission.rsd_ae_tendsto_withDensity_div_closedBall P U μ θ hU hθm hμK hνK
  have key : ∀ᵐ x ∂μ, HasMassDensity T x (R.mult x) := by
    filter_upwards [ae_restrict_mem R.measurableSet_carrier, R.orients, hbes]
      with x hxM hQ hx
    obtain ⟨Q, hxQ, -⟩ := hQ
    have hxU : x ∈ U := R.carrier_subset hxM
    -- a closed ball `B̄_s(x) ⊆ U`; every `B̄_ρ(x)`, `ρ ≤ s`, is a compact subset of `U`
    obtain ⟨s, hs, hsU⟩ := nhds_basis_closedBall.mem_iff.1 (hU.mem_nhds hxU)
    have hsub : ∀ ρ : ℝ, ρ ≤ s → closedBall x ρ ⊆ U := fun ρ hρ =>
      (closedBall_subset_closedBall hρ).trans hsU
    -- `μ(B̄_ρ(x))/(ωₙρⁿ) → 1` (approximate tangent plane at `x`)
    have hden := Submission.rsd_tendsto_closedBall_density_of_approxTangent P n R.carrier x Q s hs
      (Submission.rsd_imrep_compact_measure_ne_top P n U R _ (isCompact_closedBall x s) hsU).1 hxQ
    -- `μ_T(B̄_ρ(x))/(ωₙρⁿ) = [μ_T(B̄_ρ(x))/μ(B̄_ρ(x))] · [μ(B̄_ρ(x))/(ωₙρⁿ)] → θ(x) · 1`
    have hclosed : Tendsto (fun ρ : ℝ => R.measure (closedBall x ρ) /
        (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) (𝓝 (θ x)) := by
      have hprod := ENNReal.Tendsto.mul (hx hxU) (Or.inr ENNReal.one_ne_top) hden
        (Or.inl one_ne_zero)
      rw [mul_one] at hprod
      refine hprod.congr' ?_
      filter_upwards [Ioo_mem_nhdsGT hs, hden.eventually_ne one_ne_zero] with ρ hρ hne
      -- `0 < μ(B̄_ρ(x)) < ∞` for small `ρ`
      have hfin : μHE[n] (R.carrier ∩ closedBall x ρ) ≠ ∞ :=
        (Submission.rsd_imrep_compact_measure_ne_top P n U R _ (isCompact_closedBall x ρ)
          (hsub ρ hρ.2.le)).1
      have hpos : μHE[n] (R.carrier ∩ closedBall x ρ) ≠ 0 := fun h0 =>
        hne (by rw [h0, ENNReal.zero_div])
      have hμρ : μ (closedBall x ρ) = μHE[n] (R.carrier ∩ closedBall x ρ) := by
        rw [hμ, Measure.restrict_apply' R.measurableSet_carrier, inter_comm]
      rw [hμρ]
      exact ENNReal.div_mul_div_cancel hpos hfin
    -- open balls, then `M_{B_ρ(x)}(T) = μ_T(B_ρ(x))` for `ρ < s`
    have hopen := Submission.rsd_tendsto_ball_density_of_closedBall P n R.measure x (θ x) hclosed
    refine ⟨Nat.cast_nonneg _, ?_⟩
    rw [ENNReal.ofReal_natCast]
    refine hopen.congr' ?_
    filter_upwards [Ioo_mem_nhdsGT hs] with ρ hρ
    rw [Submission.rsd_massOn_eq_measure P n U T R hU hR (ball x ρ) isOpen_ball
      (ball_subset_closedBall.trans (hsub ρ hρ.2.le))]
  -- `μ_T = θμ ≪ μ`
  exact (withDensity_absolutelyContinuous μ θ).ae_le key

/-- **Smooth unit approximation** (Simon Ch. 6, 1.15 and 2.5; steps 4(c)–(d) of the mass formula
`M_W(T) = μ_T(W)` of Remark 3.2(3) for `T = τ(M, θ, ξ)`).  Extend `β|_K` to a continuous unit
field `g` with compact support in `V` and `g = β` on `K` (Tietze extension, radial retraction,
cut-off), then mollify: `ω = ψ ⋆ g` with `ψ = φ / ∫ φ` for a smooth bump `φ` supported in
`B_s(0)`, where `cthickening s (spt g) ⊆ V` and `s` is a modulus of uniform continuity of `𝒜 ∘ g`
for `δ`, `𝒜` being the coefficient map with `|α| = ‖𝒜 α‖`.  As `𝒜` commutes with the Bochner
integral, `𝒜 (ω x)` is a `ψ`-average of the values `𝒜 (g y)`, `|y - x| < s`; hence `|ω x| ≤ 1`
and `|ω x - g x| ≤ δ`, which is `|ω x - β x| ≤ δ` on `K`. -/
theorem Submission.dor_ims_smooth_unit_approx : ∀ (P n : ℕ) (K V : Set (Euclid P)) (β : Euclid P → Covector (Euclid P) n) (δ : ℝ), IsCompact K → IsOpen V → K ⊆ V → ContinuousOn β K → (∀ x ∈ K, covectorEuclideanNorm (β x) ≤ 1) → 0 < δ → ∃ ω : DifferentialForm (Euclid P) n, IsTestForm ω ∧ tsupport ω ⊆ V ∧ (∀ x, covectorEuclideanNorm (ω x) ≤ 1) ∧ ∀ x ∈ K, covectorEuclideanNorm (ω x - β x) ≤ δ := by
  intro P n K V β δ hK hV hKV hβ hβ1 hδ
  -- Steps 2–5: a continuous unit field `g`, compactly supported in `V`, with `g = β` on `K`
  obtain ⟨g, hg, hgc, hgV, hg1, hgK⟩ :=
    Submission.dor_ims_sua_continuous_unit_extension P n K V β hK hV hKV hβ hβ1
  -- Step 6: mollify `g` into a test form `ω` in `V` with `|ω| ≤ 1` and `|ω - g| ≤ δ` everywhere
  obtain ⟨ω, hω, hωV, hω1, hωg⟩ : ∃ ω : DifferentialForm (Euclid P) n, IsTestForm ω ∧
      tsupport ω ⊆ V ∧ (∀ x, covectorEuclideanNorm (ω x) ≤ 1) ∧
      ∀ x, covectorEuclideanNorm (ω x - g x) ≤ δ := by
    -- Step 1: the coefficient map `𝒜`, with `|α| = ‖𝒜 α‖`
    obtain ⟨A, hA⟩ := Submission.dor_ims_sua_coeff_norm_rep P n
    -- `cthickening r (spt g) ⊆ V`, as in step 4
    obtain ⟨r, hr, hrV⟩ := hgc.isCompact.exists_cthickening_subset_open hV hgV
    -- `𝒜 ∘ g` is continuous with compact support, so uniformly continuous; `s₀` is a modulus
    -- for `δ`
    have hAg : Continuous fun y => A (g y) := A.continuous.comp hg
    obtain ⟨s₀, hs₀, hs₀δ⟩ := Metric.uniformContinuous_iff.1
      ((hgc.comp_left (map_zero A)).uniformContinuous_of_continuous hAg) δ hδ
    -- the kernel: `ψ = φ / ∫ φ` for the bump `φ` with `support φ = B_s(0)`, `s = min r s₀`, is
    -- `C^∞` with compact support, `ψ ≥ 0`, `∫ ψ = 1` and `support ψ ⊆ B_s(0)`
    have hs : 0 < min r s₀ := lt_min hr hs₀
    obtain ⟨ψ, hψ, hψc, hψ0, hψ1, hψs⟩ : ∃ ψ : Euclid P → ℝ, ContDiff ℝ (⊤ : ℕ∞) ψ ∧
        HasCompactSupport ψ ∧ (∀ y, 0 ≤ ψ y) ∧ ∫ y, ψ y = 1 ∧
        support ψ ⊆ ball 0 (min r s₀) := by
      let φ : ContDiffBump (0 : Euclid P) := ⟨min r s₀ / 2, min r s₀, half_pos hs, half_lt_self hs⟩
      have hφ : 0 < ∫ y, φ y := by
        rw [integral_pos_iff_support_of_nonneg φ.nonneg'
          (φ.continuous.integrable_of_hasCompactSupport φ.hasCompactSupport), φ.support_eq]
        exact measure_ball_pos _ _ hs
      have hsupp : support (fun y => φ y / ∫ y, φ y) ⊆ support φ := fun y hy =>
        (div_ne_zero_iff.1 hy).1
      exact ⟨fun y => φ y / ∫ y, φ y, φ.contDiff.div_const _, φ.hasCompactSupport.mono hsupp,
        fun y => div_nonneg φ.nonneg hφ.le, by rw [integral_div, div_self hφ.ne'],
        hsupp.trans φ.support_eq.subset⟩
    -- `ω = ψ ⋆ g`, and (N4): `𝒜` commutes with the Bochner integral, so `𝒜 ∘ ω = ψ ⋆ (𝒜 ∘ g)`
    have hψg : ∀ x, ConvolutionExistsAt ψ g x (ContinuousLinearMap.lsmul ℝ ℝ) volume :=
      hψc.convolutionExists_left _ hψ.continuous hg.locallyIntegrable
    have hAω : ∀ x, A (convolution ψ g (ContinuousLinearMap.lsmul ℝ ℝ) volume x) =
        convolution ψ (fun y => A (g y)) (ContinuousLinearMap.lsmul ℝ ℝ) volume x := by
      intro x
      rw [convolution_def, convolution_def, ← A.integral_comp_comm (hψg x).integrable]
      simp only [ContinuousLinearMap.lsmul_apply, map_smul]
    refine ⟨convolution ψ g (ContinuousLinearMap.lsmul ℝ ℝ) volume, ⟨?_, ?_⟩, ?_, ?_, ?_⟩
    -- 6(i): `ω` is `C^∞` with compact support
    · exact hψc.contDiff_convolution_left _ hψ hg.locallyIntegrable
    · exact hψc.convolution _ hgc
    -- 6(ii): `support ω ⊆ B_s(0) + spt g = thickening s (spt g)`, so
    -- `spt ω ⊆ cthickening s (spt g) ⊆ cthickening r (spt g) ⊆ V`
    · have hsupp : support (convolution ψ g (ContinuousLinearMap.lsmul ℝ ℝ) volume) ⊆
          thickening (min r s₀) (tsupport g) := by
        refine (support_convolution_subset _).trans ?_
        rw [← ball_add_zero]
        exact add_subset_add hψs (subset_tsupport g)
      exact (closure_minimal (hsupp.trans (thickening_subset_cthickening _ _))
        isClosed_cthickening).trans ((cthickening_mono (min_le_left r s₀) _).trans hrV)
    -- 6(iii): `|ω x| = ‖(ψ ⋆ 𝒜 ∘ g) x‖ ≤ 1`, since `‖𝒜 (g y)‖ = |g y| ≤ 1`
    · intro x
      rw [hA, hAω, ← dist_zero_right]
      exact dist_convolution_le zero_le_one hψs hψ0 hψ1 hAg.aestronglyMeasurable fun y _ => by
        rw [dist_zero_right, ← hA]
        exact hg1 y
    -- 6(iv): `|ω x - g x| = ‖(ψ ⋆ 𝒜 ∘ g) x - 𝒜 (g x)‖ ≤ δ`, since `|y - x| < s ≤ s₀`
    · intro x
      rw [hA, map_sub, hAω, ← dist_eq_norm]
      exact dist_convolution_le hδ.le hψs hψ0 hψ1 hAg.aestronglyMeasurable fun y hy =>
        (hs₀δ ((mem_ball.1 hy).trans_le (min_le_right r s₀))).le
  -- Step 7: `g = β` on `K`
  refine ⟨ω, hω, hωV, hω1, fun x hx => ?_⟩
  rw [← hgK x hx]
  exact hωg x

/-- **Simon Ch. 6, 3.2(3)** (lower bound): if `T = τ(M, θ, ξ)` in the open set `U`, then
`μ_R(W) = ∫_{M ∩ W} θ dHⁿ ≤ M_W(T)` for every open `W`.  As `μ_R` lives on `M ⊆ U`, replace `W`
by `G = W ∩ U` and pick a compact `K ⊆ G` of nearly full measure.  With `L` from
`dor_ims_unitOrientation_dual`, `μ_R`-a.e. `|ξ(α)| ≤ |α|`, `|L ξ| ≤ 1` and `ξ(L ξ) = 1`; by
Lusin, `β = L ∘ ξ` is continuous on a compact `K' ⊆ K` with `μ_R(K \ K') < η`.  A thin open
thickening `V` of `K'` has `μ_R(V \ K') < η`, and a smooth admissible `ω` supported in `V` with
`|ω - β| ≤ δ` on `K'` has `T(ω) = ∫ ξ(ω) dμ_R ≥ (1 - δ) μ_R(K') - μ_R(V \ K')`, close to
`μ_R(G)`. -/
theorem Submission.dor_ims_measure_le_massOn : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → R.measure W ≤ T.massOn W := by
  intro P n U T R hU hR W hW
  obtain ⟨L, hL⟩ := Submission.dor_ims_unitOrientation_dual P n
  -- `μ_R ≪ Hⁿ⌞M`, so `μ_R`-a.e. `x` is good: `|ξ(x)(α)| ≤ |α|`, `|L ξ(x)| ≤ 1`, `ξ(x)(L ξ(x)) = 1`
  have hac : R.measure ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
  have hgood : ∀ᵐ x ∂R.measure,
      (∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α) ∧
        covectorEuclideanNorm (L (R.orient x)) ≤ 1 ∧ R.orient x (L (R.orient x)) = 1 := by
    refine hac.ae_le ?_
    filter_upwards [R.orients] with x hx
    obtain ⟨Q, -, hQ⟩ := hx
    exact hL _ Q hQ
  -- a measurable `μ_R`-null set `Z` containing every bad point
  obtain ⟨Z, hZ, hZm, hZ0⟩ := exists_measurable_superset_of_null (ae_iff.1 hgood)
  have hβm : AEStronglyMeasurable (fun x => L (R.orient x)) R.measure :=
    L.continuous.comp_aestronglyMeasurable (R.aestronglyMeasurable_orient.mono_ac hac)
  -- `μ_R(K) < ∞` for compact `K ⊆ U`, and `μ_R(ℝᴾ \ U) = 0`, so `μ_R(W) = μ_R(W ∩ U)`
  have hfin : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → R.measure K < ∞ := by
    intro K hK hKU
    rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
      Measure.restrict_restrict hK.measurableSet, inter_comm]
    exact (R.locallyIntegrable_mult K hK hKU).lt_top
  have hUc : R.measure Uᶜ = 0 := by
    refine hac ?_
    rw [Measure.restrict_apply hU.measurableSet.compl]
    exact measure_mono_null (fun x hx => absurd (R.carrier_subset hx.2) hx.1) measure_empty
  have hG : IsOpen (W ∩ U) := hW.inter hU
  have hWG : R.measure W = R.measure (W ∩ U) := by
    rw [← measure_inter_add_sdiff W hU.measurableSet,
      measure_mono_null (show W \ U ⊆ Uᶜ from fun x hx => hx.2) hUc, add_zero]
  -- it suffices to beat every `r < μ_R(W)`; fix `η > 0` with `r + 4η < μ_R(W ∩ U)`
  refine ENNReal.le_of_forall_nnreal_lt fun r hr => ?_
  obtain ⟨ε, hε0, hrε⟩ := ENNReal.lt_iff_exists_add_pos_lt.1 hr
  set η : ℝ := (ε : ℝ) / 4 with hη
  have hη0 : 0 < η := div_pos (NNReal.coe_pos.2 hε0) four_pos
  -- compact `K ⊆ W ∩ U` with `r + 4η < μ_R(K)`, from the exhaustion `Fⱼ ∩ B̄ⱼ(0)` of `W ∩ U`
  obtain ⟨F, hFc, hFG, hFU, hFm⟩ := hG.exists_iUnion_isClosed
  have hKm : Monotone fun j : ℕ => F j ∩ closedBall (0 : Euclid P) j := fun i j hij =>
    inter_subset_inter (hFm hij) (closedBall_subset_closedBall (Nat.cast_le.2 hij))
  have hKU : ⋃ j : ℕ, F j ∩ closedBall (0 : Euclid P) j = W ∩ U := by
    refine Subset.antisymm (iUnion_subset fun j => inter_subset_left.trans (hFG j))
      fun x hx => ?_
    rw [← hFU] at hx
    obtain ⟨i, hi⟩ := mem_iUnion.1 hx
    obtain ⟨k, hk⟩ := exists_nat_ge ‖x‖
    refine mem_iUnion.2 ⟨max i k, hFm (le_max_left i k) hi, ?_⟩
    rw [mem_closedBall, dist_zero_right]
    exact hk.trans (Nat.cast_le.2 (le_max_right i k))
  have hlt : (r : ℝ≥0∞) + ε < R.measure (⋃ j : ℕ, F j ∩ closedBall (0 : Euclid P) j) := by
    rwa [hKU, ← hWG]
  obtain ⟨j, hj⟩ :=
    ((tendsto_order.1 (tendsto_measure_iUnion_atTop (μ := R.measure) hKm)).1 _ hlt).exists
  set K := F j ∩ closedBall (0 : Euclid P) j
  have hrK : (r : ℝ≥0∞) + ε < R.measure K := hj
  have hKc : IsCompact K := (isCompact_closedBall _ _).inter_left (hFc j)
  have hKG : K ⊆ W ∩ U := inter_subset_left.trans (hFG j)
  have hKfin : R.measure K < ∞ := hfin K hKc (hKG.trans inter_subset_right)
  -- Lusin: a compact `K' ⊆ K \ Z` with `μ_R(K \ K') < η` on which `β = L ∘ ξ` is continuous
  obtain ⟨K', hK'c, hK'K, hK'small, hβc⟩ := Submission.dor_ims_lusin_continuousOn P n
    R.measure (K \ Z) (fun x => L (R.orient x)) η (hKc.measurableSet.diff hZm)
    ((measure_mono sdiff_subset).trans_lt hKfin).ne hβm hη0
  have hgoodK' : ∀ x ∈ K', (∀ α : Covector (Euclid P) n,
      |R.orient x α| ≤ covectorEuclideanNorm α) ∧
        covectorEuclideanNorm (L (R.orient x)) ≤ 1 ∧ R.orient x (L (R.orient x)) = 1 :=
    fun x hx => by
      by_contra h
      exact (hK'K hx).2 (hZ h)
  have hK'G : K' ⊆ W ∩ U := hK'K.trans (sdiff_subset.trans hKG)
  have hK'm : MeasurableSet K' := hK'c.measurableSet
  have hK'fin : R.measure K' ≠ ∞ := ((measure_mono (hK'K.trans sdiff_subset)).trans_lt hKfin).ne
  have hKK' : R.measure (K \ K') < ENNReal.ofReal η := by
    calc R.measure (K \ K') ≤ R.measure ((K \ Z) \ K' ∪ Z) := measure_mono fun x hx => by
          by_cases hxZ : x ∈ Z
          · exact Or.inr hxZ
          · exact Or.inl ⟨⟨hx.1, hxZ⟩, hx.2⟩
      _ ≤ R.measure ((K \ Z) \ K') + R.measure Z := measure_union_le _ _
      _ < ENNReal.ofReal η := by rwa [hZ0, add_zero]
  -- a thin open thickening `V` of `K'`: `K' ⊆ V ⊆ W ∩ U` and `μ_R(V \ K') < η`
  obtain ⟨ρ, hρ0, hρG⟩ := hK'c.exists_cthickening_subset_open hG hK'G
  have hthick : R.measure (thickening ρ K') ≠ ∞ :=
    ((measure_mono (thickening_subset_cthickening_of_le (le_refl ρ) K')).trans_lt
      (hfin _ hK'c.cthickening (hρG.trans inter_subset_right))).ne
  obtain ⟨t, htV, ht⟩ := (((tendsto_order.1 (tendsto_measure_thickening_of_isClosed
    ⟨ρ, hρ0, hthick⟩ hK'c.isClosed)).2 _ (ENNReal.lt_add_right hK'fin
      (ENNReal.ofReal_pos.2 hη0).ne')).and (Ioo_mem_nhdsGT hρ0)).exists
  set V := thickening t K'
  have hK'V : K' ⊆ V := self_subset_thickening ht.1 K'
  have hVG : V ⊆ W ∩ U := (thickening_subset_cthickening_of_le ht.2.le K').trans hρG
  have hVK' : R.measure (V \ K') < ENNReal.ofReal η :=
    measure_sdiff_lt_of_lt_add hK'm.nullMeasurableSet hK'V hK'fin htV
  have hVK'fin : R.measure (V \ K') ≠ ∞ := (hVK'.trans ENNReal.ofReal_lt_top).ne
  have hVK'm : MeasurableSet (V \ K') := isOpen_thickening.measurableSet.diff hK'm
  -- a smooth admissible form `ω` supported in `V` with `|ω - β| ≤ δ` on `K'`
  set m : ℝ := R.measure.real K
  have hm0 : 0 ≤ m := measureReal_nonneg
  set δ : ℝ := η / (m + 1) with hδ
  have hδ0 : 0 < δ := div_pos hη0 (by linarith)
  obtain ⟨ω₀, hω₀t, hω₀V, hω₀1, hω₀β⟩ := Submission.dor_ims_smooth_unit_approx P n K' V
    (fun x => L (R.orient x)) δ hK'c isOpen_thickening hK'V hβc
    (fun x hx => (hgoodK' x hx).2.1) hδ0
  let ω : TestFormOn U n := ⟨ω₀, hω₀t, hω₀V.trans (hVG.trans inter_subset_right)⟩
  have hadm : ω ∈ massAdmissibleOn U n W := ⟨hω₀V.trans (hVG.trans inter_subset_left), hω₀1⟩
  obtain ⟨hfi, hfe⟩ := Submission.dor_ims_action_eq_integral P n U R ω
  -- `ξ(ω) ≥ (1 - δ) 1_{K'} - 1_{V \ K'}` a.e., hence `T(ω) ≥ (1 - δ) μ_R(K') - μ_R(V \ K')`
  have hi1 : Integrable (K'.indicator fun _ => 1 - δ) R.measure :=
    (integrableOn_const (C := 1 - δ) hK'fin).integrable_indicator hK'm
  have hi2 : Integrable ((V \ K').indicator fun _ => (1 : ℝ)) R.measure :=
    (integrableOn_const (C := (1 : ℝ)) hVK'fin).integrable_indicator hVK'm
  have hle : (fun x => K'.indicator (fun _ => 1 - δ) x -
      (V \ K').indicator (fun _ => (1 : ℝ)) x) ≤ᵐ[R.measure]
        fun x => R.orient x ((ω : DifferentialForm (Euclid P) n) x) := by
    filter_upwards [hgood] with x hx
    obtain ⟨hx1, -, hx3⟩ := hx
    change _ ≤ R.orient x (ω₀ x)
    by_cases hxK' : x ∈ K'
    · rw [indicator_of_mem hxK', indicator_of_notMem (fun h => h.2 hxK'), sub_zero]
      have h1 := hx1 (ω₀ x - L (R.orient x))
      have h2 : covectorEuclideanNorm (ω₀ x - L (R.orient x)) ≤ δ := hω₀β x hxK'
      rw [map_sub, hx3] at h1
      linarith [neg_abs_le (R.orient x (ω₀ x) - 1)]
    · rw [indicator_of_notMem hxK', zero_sub]
      by_cases hxV : x ∈ V
      · rw [indicator_of_mem (show x ∈ V \ K' from ⟨hxV, hxK'⟩)]
        linarith [neg_abs_le (R.orient x (ω₀ x)), hx1 (ω₀ x), hω₀1 x]
      · rw [indicator_of_notMem (fun h => hxV h.1), neg_zero,
          image_eq_zero_of_notMem_tsupport (fun h => hxV (hω₀V h)), map_zero]
  have hint : ∫ x, (K'.indicator (fun _ => 1 - δ) x - (V \ K').indicator (fun _ => (1 : ℝ)) x)
      ∂R.measure ≤ ∫ x, R.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂R.measure :=
    integral_mono_ae (hi1.sub hi2) hfi hle
  rw [integral_sub hi1 hi2, integral_indicator_const _ hK'm, integral_indicator_const _ hVK'm,
    smul_eq_mul, smul_eq_mul, mul_one, ← hfe, ← hR ω] at hint
  -- arithmetic: `T(ω) > r`
  have hm1 : (r : ℝ) + ε < m := by
    have := ENNReal.toReal_strict_mono hKfin.ne hrK
    rwa [ENNReal.toReal_add ENNReal.coe_ne_top ENNReal.coe_ne_top, ENNReal.coe_toReal,
      ENNReal.coe_toReal] at this
  have hc : R.measure.real (K \ K') < η := ENNReal.toReal_lt_of_lt_ofReal hKK'
  have hb : R.measure.real (V \ K') < η := ENNReal.toReal_lt_of_lt_ofReal hVK'
  have hsplit : R.measure.real (K ∩ K') + R.measure.real (K \ K') = m :=
    measureReal_inter_add_sdiff hK'm hKfin.ne
  rw [inter_eq_right.2 (hK'K.trans sdiff_subset)] at hsplit
  have hc0 : 0 ≤ R.measure.real (K \ K') := measureReal_nonneg
  have hδm : R.measure.real K' * δ < η := by
    have h1 : m * δ < η := by
      rw [hδ, ← mul_div_assoc, div_lt_iff₀ (by linarith)]
      nlinarith
    have h2 : R.measure.real K' * δ ≤ m * δ :=
      mul_le_mul_of_nonneg_right (by linarith) hδ0.le
    linarith
  have hrT : (r : ℝ) < T ω := by linarith
  calc (r : ℝ≥0∞) = ENNReal.ofReal r := ENNReal.ofReal_coe_nnreal.symm
    _ ≤ ENNReal.ofReal (T ω) := ENNReal.ofReal_le_ofReal hrT.le
    _ ≤ T.massOn W := T.le_massOn hadm
/-- **Support from a mass–measure identity** (Simon 6.2.11–6.2.12).  If `U` is open and
`M_W(T) = μ(W)` for every open `W`, then `spt T = U ∩ spt μ`.  First, `M_W(T) = 0` forces `T` to
vanish on `W`: if `spt ω ⊆ W` and `|ω| ≤ C`, both `±(max C 0 + 1)⁻¹ ω` are admissible for
`M_W(T)`, so `±T(ω) ≤ 0`.  A point of `spt T` with a `μ`-null neighbourhood then has a small ball
`W ⊂⊂ U` with `M_W(T) = μ(W) = 0`, so it lies in the zero region of `T`; and an open `W ∋ x` on
which `T` vanishes has `μ(W) = M_W(T) = 0`, so `x ∉ spt μ`. -/
theorem Submission.dor_ims_support_of_massOn_eq : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (μ : Measure (Euclid P)), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) → T.support = U ∩ μ.support := by
  intro P n U T μ hU hmass
  -- Step 1: `|c α| = |c| |α|`, and `α ↦ |α|` is continuous
  have hhom : ∀ (c : ℝ) (α : Covector (Euclid P) n),
      covectorEuclideanNorm (c • α) = |c| * covectorEuclideanNorm α := by
    intro c α
    unfold covectorEuclideanNorm
    rw [← Real.sqrt_sq_eq_abs, ← Real.sqrt_mul (sq_nonneg _), Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl fun I _ => ?_
    split_ifs <;> simp [mul_pow]
  have hcont : Continuous fun α : Covector (Euclid P) n => covectorEuclideanNorm α := by
    unfold covectorEuclideanNorm
    refine Real.continuous_sqrt.comp (continuous_finsetSum _ fun I _ => ?_)
    split_ifs
    · exact (continuous_eval_const _).pow 2
    · exact continuous_const
  -- Step 2: if `M_W(T) = 0`, then `T` vanishes on `W`
  have hvan : ∀ W, T.massOn W = 0 → T.VanishesOn W := by
    intro W hW ω hω
    -- `x ↦ |ω(x)|` is continuous with compact support, hence bounded by some `C`
    obtain ⟨C, hC⟩ := (hcont.comp ω.property.1.1.continuous).bounded_above_of_compact_support
      (ω.property.1.2.comp_left (covectorEuclideanNorm_zero P n))
    set a : ℝ := (max C 0 + 1)⁻¹ with ha_def
    have ha : 0 < a := by positivity
    -- `s • ω` is admissible for `M_W(T)` whenever `|s| = a`
    have hadm : ∀ s : ℝ, |s| = a → s • ω ∈ massAdmissibleOn U n W := by
      intro s hs
      refine ⟨(tsupport_smul_subset_right (fun _ => s) _).trans hω, fun x => ?_⟩
      rw [Submodule.coe_smul, Pi.smul_apply, hhom, hs]
      have hx : covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) x) ≤ max C 0 + 1 := by
        have := hC x
        rw [Function.comp_apply, Real.norm_of_nonneg (covectorEuclideanNorm_nonneg _)] at this
        linarith [le_max_left C 0]
      calc a * covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) x)
          ≤ a * (max C 0 + 1) := by gcongr
        _ = 1 := inv_mul_cancel₀ (by positivity)
    -- `ofReal (±a T(ω)) ≤ M_W(T) = 0`, so `±a T(ω) ≤ 0`
    have h₁ := T.le_massOn (hadm a (abs_of_pos ha))
    have h₂ := T.le_massOn (hadm (-a) (by rw [abs_neg, abs_of_pos ha]))
    rw [hW, nonpos_iff_eq_zero, ENNReal.ofReal_eq_zero, map_smul, smul_eq_mul] at h₁ h₂
    have h₃ : T ω ≤ 0 := by nlinarith
    have h₄ : 0 ≤ T ω := by nlinarith
    linarith
  ext x
  simp only [GeometricCurrentOn.support, Set.mem_sdiff, Set.mem_inter_iff]
  constructor
  · -- Step 3: `spt T ⊆ U ∩ spt μ`
    rintro ⟨hxU, hxZ⟩
    refine ⟨hxU, (Measure.mem_support_iff_forall x).2 fun N hN => ?_⟩
    by_contra hpos
    have hN0 : μ N = 0 := by simpa using hpos
    -- `W = B_r(x)` with `r = min(r₁, r₂)/2`, `B_{r₁}(x) ⊆ N` and `B_{r₂}(x) ⊆ U`
    obtain ⟨r₁, hr₁, hball₁⟩ := Metric.mem_nhds_iff.mp hN
    obtain ⟨r₂, hr₂, hball₂⟩ := Metric.isOpen_iff.mp hU x hxU
    have hr : 0 < min r₁ r₂ / 2 := by positivity
    have hrr₁ : min r₁ r₂ / 2 < r₁ := by linarith [min_le_left r₁ r₂]
    have hrr₂ : min r₁ r₂ / 2 < r₂ := by linarith [min_le_right r₁ r₂]
    apply hxZ
    refine ⟨ball x (min r₁ r₂ / 2), ⟨isOpen_ball, ?_, ?_, ?_⟩, mem_ball_self hr⟩
    · -- `closure W` is compact
      exact (isCompact_closedBall x _).of_isClosed_subset isClosed_closure
        closure_ball_subset_closedBall
    · -- `closure W ⊆ B̄_r(x) ⊆ B_{r₂}(x) ⊆ U`
      exact closure_ball_subset_closedBall.trans ((closedBall_subset_ball hrr₂).trans hball₂)
    · -- `M_W(T) = μ(W) ≤ μ(N) = 0`, so `T` vanishes on `W`
      apply hvan
      rw [hmass _ isOpen_ball]
      exact measure_mono_null ((ball_subset_ball hrr₁.le).trans hball₁) hN0
  · -- Step 4: `U ∩ spt μ ⊆ spt T`
    rintro ⟨hxU, hxμ⟩
    refine ⟨hxU, ?_⟩
    rintro ⟨W, ⟨hWo, -, -, hWv⟩, hxW⟩
    -- every admissible `ω` for `M_W(T)` has `T(ω) = 0`, so `μ(W) = M_W(T) = 0`
    have h0 : μ W = 0 := by
      rw [← hmass W hWo]
      refine le_antisymm (sSup_le ?_) zero_le
      rintro _ ⟨ω, hω, rfl⟩
      show ENNReal.ofReal (T ω) ≤ 0
      rw [hWv ω hω.1, ENNReal.ofReal_zero]
    exact ((Measure.mem_support_iff_forall x).1 hxμ W (hWo.mem_nhds hxW)).ne' h0

/-- **Simon Ch. 6, 3.2(3), upper bound**: if `T = τ(M, θ, ξ)` then `M_W(T) ≤ μ_T(W)` for every
`W`.  For admissible `ω`, `⟨ω, ξ⟩ ≤ |ω| ≤ 1` `μ_T`-a.e. (`|ξ(α)| ≤ |α|` for unit orientations)
and `⟨ω, ξ⟩ = 0` off `spt ω`, so `T(ω) = ∫ ⟨ω, ξ⟩ dμ_T ≤ μ_T(spt ω) ≤ μ_T(W)`. -/
theorem Submission.dor_ims_massOn_le_measure : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), R.Represents T → ∀ W : Set (Euclid P), T.massOn W ≤ R.measure W := by
  intro P n U T R hR W
  obtain ⟨L, hL⟩ := Submission.dor_ims_unitOrientation_dual P n
  -- `|ξ(x)(α)| ≤ |α|` for `μ_T`-a.e. `x`: `ξ(x)` is a unit orientation `Hⁿ⌞M`-a.e., and
  -- `μ_T = θ Hⁿ⌞M ≪ Hⁿ⌞M`
  have hdual : ∀ᵐ x ∂R.measure, ∀ α : Covector (Euclid P) n,
      |R.orient x α| ≤ covectorEuclideanNorm α := by
    have hac : R.measure ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
    refine hac.ae_le ?_
    filter_upwards [R.orients] with x hx
    obtain ⟨Q, -, hQ⟩ := hx
    exact (hL _ Q hQ).1
  apply sSup_le
  rintro r ⟨ω, ⟨hωW, hω1⟩, rfl⟩
  -- `K = spt ω` is a compact subset of `U`, so `μ_T(K) = ∫_{M ∩ K} θ dHⁿ < ∞`
  set K := tsupport (ω : DifferentialForm (Euclid P) n)
  have hKm : MeasurableSet K := (isClosed_tsupport _).measurableSet
  have hμK : R.measure K ≠ ∞ := by
    rw [IMRep.measure, withDensity_apply _ hKm, Measure.restrict_restrict hKm, inter_comm]
    exact R.locallyIntegrable_mult K ω.2.1.2.isCompact ω.2.2
  obtain ⟨hint, haction⟩ := Submission.dor_ims_action_eq_integral P n U R ω
  -- `⟨ω, ξ⟩ ≤ 1_K` `μ_T`-a.e.: `⟨ω(x), ξ(x)⟩ ≤ |ω(x)| ≤ 1` on `K` and `ω = 0` off `K`
  have hle : (fun x => R.orient x ((ω : DifferentialForm (Euclid P) n) x)) ≤ᵐ[R.measure]
      K.indicator fun _ => (1 : ℝ) := by
    filter_upwards [hdual] with x hx
    by_cases hxK : x ∈ K
    · rw [indicator_of_mem hxK]
      exact (le_abs_self _).trans ((hx _).trans (hω1 x))
    · rw [indicator_of_notMem hxK, image_eq_zero_of_notMem_tsupport hxK, map_zero]
  calc ENNReal.ofReal (T ω)
      = ENNReal.ofReal (∫ x, R.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂R.measure) := by
        rw [hR ω, haction]
    _ ≤ ENNReal.ofReal (∫ x, K.indicator (fun _ => (1 : ℝ)) x ∂R.measure) :=
        ENNReal.ofReal_le_ofReal (integral_mono_ae hint
          ((integrableOn_const hμK).integrable_indicator hKm) hle)
    _ = R.measure K := by
        rw [integral_indicator_const _ hKm, smul_eq_mul, mul_one, measureReal_def,
          ENNReal.ofReal_toReal hμK]
    _ ≤ R.measure W := measure_mono hωW
/-- **Simon Ch. 6, 3.2(3) and 2.11–2.12**: if `T = τ(M, θ, ξ)` in the open set `U`, then
(i) `M_W(T) = μ_R(W)` for every open `W`, where `μ_R = θ Hⁿ⌞M`, and (ii) `spt T = U ∩ spt μ_R`.
`M_W(T) ≤ μ_R(W)` because admissible forms pair with `ξ` to at most `1`; `μ_R(W) ≤ M_W(T)` by
smoothing the dual covector field of `ξ` (Lusin); (ii) follows from (i) alone. -/
theorem Submission.dor_imrep_massOn_eq_measure_and_support : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support := by
  intro P n U T R hU hR
  have hmass : ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W := fun W hW =>
    le_antisymm (Submission.dor_ims_massOn_le_measure P n U T R hR W)
      (Submission.dor_ims_measure_le_massOn P n U T R hU hR W hW)
  exact ⟨hmass, Submission.dor_ims_support_of_massOn_eq P n U T R.measure hU hmass⟩

/-- **Minimizing `0`-currents do not meet the constraint set** (the case `n = 0` of Simon 7.4.3,
which the book leaves implicit since Ch. 6 §3 takes `n ≥ 1`; here for an arbitrary `A`).  If
`T ∈ 𝒟₀(U)` is minimizing in `A`, then `spt T ∩ A = ∅`.  Let
`T = τ(M, θ, ξ)` and suppose `x ∈ spt T ∩ A`.  Since `spt T = U ∩ spt μ_T` and, in degree `0`,
`U ∩ spt μ_T = M`, `x ∈ M`.  Deleting `x` gives `R' = (M \ {x}, θ, ξ)`, which represents
`S = T − D` with `D(ω) = θ(x)ξ(x)(ω(x))`, and `spt(S − T) = spt(−D) = {x} ⊆ A ∩ W` for a ball
`W ⊂⊂ U` about `x`.  As `μ_T(W) = μ_{R'}(W) + θ(x)` with `μ_T(W) < ∞` and `θ(x) ≥ 1`,
`M_W(S) = μ_{R'}(W) < M_W(T)`, contradicting minimality. -/
theorem Submission.dor_zero_dim_minimizing_support_disjoint : ∀ (P : ℕ) (U A : Set (Euclid P)) (T : GeometricCurrentOn U 0), IsOpen U → IsMinimizingIn T A → T.support ∩ A = ∅ := by
  intro P U A T hU hmin
  obtain ⟨⟨R, hR⟩, hminT⟩ := hmin
  refine eq_empty_iff_forall_notMem.mpr fun x hx => ?_
  obtain ⟨hxT, hxA⟩ := hx
  obtain ⟨-, hMfin, hMorient, hMspt⟩ := Submission.dor_zdm_imrep_zero_structure P U R
  obtain ⟨hmassT, hsptT⟩ := Submission.dor_imrep_massOn_eq_measure_and_support P 0 U T R hU hR
  -- `x` is a carrier point: `spt T = U ∩ spt μ_R = M`
  have hxM : x ∈ R.carrier := by
    rw [← hMspt hU, ← hsptT]
    exact hxT
  have hxU : x ∈ U := R.carrier_subset hxM
  -- delete `x`: `R' = (M \ {x}, θ, ξ)`, `μ_R = μ_{R'} + θ(x) δ_x`
  obtain ⟨R', -, hmeas, hact⟩ := Submission.dor_zdm_imrep_zero_erase_point P U R x hxM
  -- the point current `D(ω) = θ(x) ξ(x)(ω(x))`; the competitor `S = T − D` is represented by `R'`
  obtain ⟨⟨D, hD⟩, -⟩ :=
    Submission.dor_zdm_point_current P 0 U x ((R.mult x : ℝ) • R.orient x) hU hxU
  have hS : R'.Represents (T - D) := by
    intro ω
    change T ω - D ω = _
    rw [hR ω, hD ω, hact ω, smul_apply, smul_eq_mul]
  -- `spt(S − T) = {x}`: `(S − T)(ω) = −θ(x) ξ(x)(ω(x))` and `θ(x) ξ(x) ≠ 0`
  have hξ : (R.mult x : ℝ) • R.orient x ≠ 0 :=
    smul_ne_zero (by exact_mod_cast (R.mult_pos x hxM).ne') (hMorient x hxM).2
  have hspt : (T - D - T).support = {x} := by
    refine (Submission.dor_zdm_point_current P 0 U x (-((R.mult x : ℝ) • R.orient x)) hU
      hxU).2 (T - D - T) (fun ω => ?_) ((neg_ne_zero (α := MultiVector P 0)).mpr hξ)
    change T ω - D ω - T ω = _
    rw [hD ω, neg_apply, sub_sub_cancel_left]
  -- minimality on `W = B_{r/2}(x)`, `W ⊂⊂ U`
  obtain ⟨r, hr, hrU⟩ := Metric.isOpen_iff.mp hU x hxU
  have hr2 : 0 < r / 2 := half_pos hr
  have hcl : closure (ball x (r / 2)) = closedBall x (r / 2) := closure_ball x hr2.ne'
  have hKU : closedBall x (r / 2) ⊆ U := (closedBall_subset_ball (half_lt_self hr)).trans hrU
  have hxW : x ∈ ball x (r / 2) := mem_ball_self hr2
  have hle := hminT (ball x (r / 2)) (T - D) isOpen_ball
    ⟨by rw [hcl]; exact isCompact_closedBall x (r / 2), by rw [hcl]; exact hKU⟩ ⟨R', hS⟩
    trivial (by rw [hspt]; exact isCompact_singleton)
    (by rw [hspt]; exact singleton_subset_iff.mpr ⟨hxA, hxW⟩)
  -- `M_W(T) = μ_R(W)`, `M_W(S) = μ_{R'}(W)` and `μ_R(W) = μ_{R'}(W) + θ(x) < ∞`
  rw [hmassT _ isOpen_ball,
    (Submission.dor_imrep_massOn_eq_measure_and_support P 0 U (T - D) R' hU hS).1 _
      isOpen_ball] at hle
  have hRW : R.measure (ball x (r / 2)) = R'.measure (ball x (r / 2)) + (R.mult x : ℝ≥0∞) := by
    rw [hmeas, Measure.add_apply, Measure.smul_apply, Measure.dirac_apply_of_mem hxW,
      smul_eq_mul, mul_one]
  have hfin : R.measure (ball x (r / 2)) ≠ ∞ :=
    ne_top_of_le_ne_top (hMfin _ (isCompact_closedBall x (r / 2)) hKU).2
      (measure_mono ball_subset_closedBall)
  rw [hRW] at hfin hle
  have hθ : (R.mult x : ℝ≥0∞) ≠ 0 := by exact_mod_cast (R.mult_pos x hxM).ne'
  exact absurd hle (not_le.mpr (ENNReal.lt_add_right (ENNReal.add_ne_top.mp hfin).1 hθ))
/-- **Bounded mean curvature and monotonicity for a varifold stationary in `U ∩ N`** (Simon Ch. 4,
2.5–2.7 and 3.14–3.17; step 2 of the proof of 7.4.3).  `dsmc_tangent_projection_field` gives `r₀`,
`β` and a `C¹` field `Pt` of tangent projections of `N` near `y₀`; put `κ = nβ`.  For
`T = τ(M, θ, ξ)` with `spt T ⊆ N`, `μ_R` is carried by `U ∩ spt μ_R = spt T ⊆ N`
(`dor_imrep_massOn_eq_measure_and_support`, `M ⊆ U`); as `θ ≥ 1` on `M`, `Hⁿ(M \ N) = 0`, so
`TₓM ⊆ TₓN` at `μ_R`-a.e. `x` (`dsmc_approxTangentPlane_subset_tangentSpace`).  Then
`dsmc_firstVariation_eq_neg_meanCurvature` gives (a), and `dsmc_exp_ball_mass_monotone` on
`B̄_{r₀}(z) ⊆ U`, `B_{r₀}(z) ⊆ B_{2r₀}(y₀)` gives (b). -/
theorem Submission.dor_stationary_mean_curvature_monotonicity : ∀ (n k ℓ : ℕ), ℓ ≤ k → 0 < n → ∀ (U N : Set (Euclid (n + k))) (y₀ : Euclid (n + k)), IsOpen U → IsEmbeddedSubmanifold 2 (n + ℓ) N → (closure N \ N) ∩ U = ∅ → y₀ ∈ N ∩ U → ∃ r₀ κ : ℝ, 0 < r₀ ∧ 0 ≤ κ ∧ closedBall y₀ (3 * r₀) ⊆ U ∧ ∀ (T : GeometricCurrentOn U n) (R : IMRep U n), R.Represents T → T.support ⊆ N → R.IsStationaryAlong N → (∃ H : Euclid (n + k) → Euclid (n + k), AEStronglyMeasurable H R.measure ∧ (∀ x, ‖H x‖ ≤ κ) ∧ ∀ X : Euclid (n + k) → Euclid (n + k), ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ ball y₀ (2 * r₀) → R.firstVariation X = -∫ x, inner ℝ (X x) (H x) ∂R.measure) ∧ ∀ z ∈ ball y₀ r₀, ∀ σ ρ : ℝ, 0 < σ → σ ≤ ρ → ρ ≤ r₀ → ENNReal.ofReal (Real.exp (κ * σ) / σ ^ n) * R.measure (ball z σ) ≤ ENNReal.ofReal (Real.exp (κ * ρ) / ρ ^ n) * R.measure (ball z ρ) := by
  intro n k ℓ _ _ U N y₀ hU hN _ hy₀
  -- Step 1: a `C¹` field `Pt` of tangent projections of `N` near `y₀`; `r₀ = r` and `κ = nβ`
  obtain ⟨r, β, Pt, hr, hβ, hcl, hPt, hsym, hDPt, hPtT, hPtfix⟩ :=
    Submission.dsmc_tangent_projection_field (n + k) (n + ℓ) U N y₀ hU hN hy₀
  refine ⟨r, n * β, hr, by positivity, hcl, fun T R hRT hTN hstat => ?_⟩
  -- Step 2: `μ_R ≪ Hⁿ⌞M` with `M ⊆ U`, and `U ∩ spt μ_R = spt T ⊆ N`, so `μ_R(ℝᴾ \ N) = 0`
  have hac : R.measure ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
  have hU0 : R.measure Uᶜ = 0 := by
    refine hac ?_
    rw [Measure.restrict_apply' R.measurableSet_carrier]
    exact measure_mono_null (fun x hx => (hx.1 (R.carrier_subset hx.2)).elim) measure_empty
  have hspt := (Submission.dor_imrep_massOn_eq_measure_and_support (n + k) n U T R hU hRT).2
  have hN0 : R.measure Nᶜ = 0 := by
    refine measure_mono_null (fun x hxN => ?_)
      (measure_union_null hU0 (Measure.measure_compl_support (μ := R.measure)))
    by_contra hx
    simp only [mem_union, mem_compl_iff, not_or, not_not] at hx hxN
    exact hxN (hTN (by rw [hspt]; exact hx))
  have hNae : ∀ᵐ x ∂R.measure, x ∈ N := mem_ae_iff.2 hN0
  -- `θ ≥ 1` on `M`, so `Hⁿ⌞M ≪ μ_R` and `Hⁿ(M \ N) = 0`
  have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) := measurable_from_nat.comp R.measurable_mult
  have hac' : μHE[n].restrict R.carrier ≪ R.measure := by
    refine withDensity_absolutelyContinuous' hθ.aemeasurable ?_
    filter_upwards [ae_restrict_mem R.measurableSet_carrier] with x hx
    exact_mod_cast (R.mult_pos x hx).ne'
  have hMN : μHE[n] (R.carrier \ N) = 0 := by
    have h := hac' hN0
    rwa [Measure.restrict_apply' R.measurableSet_carrier, inter_comm, ← Set.sdiff_eq] at h
  -- Step 3: `TₓM ⊆ TₓN` at `μ_R`-a.e. `x`, `TₓM` being an approximate tangent plane there
  have hTM : ∀ᵐ x ∂R.measure, x ∈ ball y₀ (3 * r) →
      (approxTangentPlane n R.carrier x : Set (Euclid (n + k))) ⊆ tangentSpace N x := by
    filter_upwards [hac.ae_le R.orients, hNae] with x hx hxN _
    obtain ⟨Q, hQ, -⟩ := hx
    have h : ∃ Q, HasApproximateTangentSpaceAt n R.carrier x Q := ⟨Q, hQ⟩
    rw [approxTangentPlane, dite_eq_left h]
    exact Submission.dsmc_approxTangentPlane_subset_tangentSpace (n + k) n 2 (n + ℓ) R.carrier N
      x h.choose (by norm_num) hN hxN hMN h.choose_spec
  have hpm := Submission.dsmc_approxTangentPlane_starProjection_aemeasurable (n + k) n U R hU
  -- Step 4: (a), the generalized mean curvature `H` of `V` in `B_{2r₀}(y₀)`, `|H| ≤ nβ`
  obtain ⟨H, hHm, hHb, hHfv⟩ := Submission.dsmc_firstVariation_eq_neg_meanCurvature (n + k) n U N
    R Pt y₀ r β hβ (ball_subset_closedBall.trans hcl) hPt hsym hDPt hPtT hPtfix hNae hTM hpm hstat
  refine ⟨⟨H, hHm, hHb, hHfv⟩, fun z hz σ ρ hσ hσρ hρ => ?_⟩
  -- Step 5: (b) in `B_{r₀}(z)`, as `B̄_{r₀}(z) ⊆ B̄_{3r₀}(y₀)` and `B_{r₀}(z) ⊆ B_{2r₀}(y₀)`
  have hz' : dist z y₀ < r := hz
  exact Submission.dsmc_exp_ball_mass_monotone (n + k) n U R H (n * β) z r
    ((closedBall_subset_closedBall' (by linarith)).trans hcl) hpm hHm hHb
    (fun X hX hXc hXs => hHfv X hX hXc (hXs.trans (ball_subset_ball' (by linarith)))) σ ρ hσ hσρ hρ
/-- **Lusin's theorem** for `Lⁿ` with a closed set, `Lⁿ(B) = ∞` allowed (Simon Ch. 2, proof of
1.5, step 2, glued as in the infinite-measure case of Simon 1.15(2)).  On the bounded Borel shells
`S_j = {j ≤ ‖x‖ < j + 1}`, the compact form `dor_ims_lusin_measurable_continuousOn` gives compact
`K_j ⊆ B ∩ S_j` with `Lⁿ((B ∩ S_j) \ K_j) < δ_j` on which `g` is continuous, where `∑ δ_j < ε`.
As `K_j ⊆ S_j`, the family `(K_j)` is locally finite, so `C = ⋃ⱼ K_j` is closed and `g` is
continuous on `C`; and `B \ C ⊆ ⋃ⱼ (B ∩ S_j) \ K_j` has measure `< ε`. -/
theorem Submission.codim1_rdo_c1a_lusin_isClosed : ∀ (n : ℕ) {Y : Type} [TopologicalSpace Y] [SecondCountableTopology Y] [MeasurableSpace Y] [OpensMeasurableSpace Y] (g : Euclid n → Y) (B : Set (Euclid n)), Measurable g → MeasurableSet B → ∀ ε : ℝ≥0∞, 0 < ε → ∃ C : Set (Euclid n), C ⊆ B ∧ IsClosed C ∧ ContinuousOn g C ∧ volume (B \ C) < ε := by
  intro n Y _ _ _ _ g B hg hB ε hε
  -- bounded Borel shells `S_j = {j ≤ ‖x‖ < j + 1}`, each of finite measure; `x ∈ S_⌊‖x‖⌋`
  set S : ℕ → Set (Euclid n) := fun j => {x | (j : ℝ) ≤ ‖x‖ ∧ ‖x‖ < j + 1}
  have hSm : ∀ j, MeasurableSet (S j) := fun j =>
    (measurableSet_le measurable_const measurable_norm).inter
      (measurableSet_lt measurable_norm measurable_const)
  have hSμ : ∀ j, volume (S j) ≠ ∞ := fun j =>
    ((measure_mono fun x hx => mem_closedBall_zero_iff.mpr hx.2.le).trans_lt
      measure_closedBall_lt_top).ne
  have hxS : ∀ x : Euclid n, x ∈ S ⌊‖x‖⌋₊ := fun x =>
    ⟨Nat.floor_le (norm_nonneg x), Nat.lt_floor_add_one _⟩
  -- weights `δ_j > 0` with `∑ δ_j < ε`
  obtain ⟨δ, hδ, hδε⟩ := ENNReal.exists_pos_sum_of_countable' hε.ne' ℕ
  -- Lusin on each shell: compact `K_j ⊆ B ∩ S_j`, defect `< δ_j`, `g` continuous on `K_j`
  choose K hK hKB hKμ hKg using fun j =>
    Submission.dor_ims_lusin_measurable_continuousOn n volume (B ∩ S j) g (δ j) hg
      (hB.inter (hSm j)) (ne_top_of_le_ne_top (hSμ j) (measure_mono inter_subset_right))
      (hδ j).ne'
  -- `K_j ⊆ S_j`, so `ball x 1` meets `K_j` only for the finitely many `j < ‖x‖ + 1`
  have hlf : LocallyFinite K := by
    intro x
    refine ⟨ball x 1, ball_mem_nhds x one_pos, (finite_lt_nat ⌈‖x‖ + 1⌉₊).subset ?_⟩
    rintro j ⟨y, hyK, hyx⟩
    refine Nat.lt_ceil.mpr ((hKB j hyK).2.1.trans_lt ?_)
    calc ‖y‖ ≤ ‖x‖ + dist y x := norm_le_norm_add_const_of_dist_le le_rfl
      _ < ‖x‖ + 1 := by linarith [mem_ball.mp hyx]
  -- hence `C = ⋃ⱼ K_j` is closed and `g` is continuous on `C`
  refine ⟨⋃ j, K j, iUnion_subset fun j => (hKB j).trans inter_subset_left,
    hlf.isClosed_iUnion fun j => (hK j).isClosed,
    hlf.continuousOn_iUnion (fun j => (hK j).isClosed) hKg, ?_⟩
  -- `x ∈ B \ C` lies in `(B ∩ S_j) \ K_j` for `j = ⌊‖x‖⌋`
  calc volume (B \ ⋃ j, K j) ≤ volume (⋃ j, (B ∩ S j) \ K j) :=
        measure_mono fun x hx => mem_iUnion.mpr
          ⟨⌊‖x‖⌋₊, ⟨hx.1, hxS x⟩, fun hxK => hx.2 (mem_iUnion_of_mem _ hxK)⟩
    _ ≤ ∑' j, volume ((B ∩ S j) \ K j) := measure_iUnion_le _
    _ ≤ ∑' j, δ j := ENNReal.tsum_le_tsum fun j => (hKμ j).le
    _ < ε := hδε
/-- **Egoroff's theorem** on `ℝⁿ` with a closed good set (steps 5–6 of Simon's proof of Ch. 2,
1.5).  If `C` is measurable (possibly `|C| = ∞`), `η_k` and `g` are measurable and `η_k → g`
pointwise on `C`, then for every `ε > 0` there is a closed `A ⊆ C` with `|C \ A| < ε` such that
`η_k → g` uniformly on every compact `Q ⊆ A`.  For weights `δ_j > 0` with `∑ δ_j < ε`, Egoroff on
the finite-measure sets `C ∩ B_{j+1}(0)` gives `t_j` with `|t_j| ≤ δ_j / 2`; put
`A₀ = C \ ⋃ t_j`.  Outer regularity gives open `U_j ⊇ A₀ᶜ ∩ B_{j+1}(0)` with excess `< δ_j / 2`,
so `A = (⋃ U_j)ᶜ ⊆ A₀` is closed and `C \ A ⊆ ⋃ (t_j ∪ (U_j \ (A₀ᶜ ∩ B_{j+1}(0))))`.  A compact
`Q ⊆ A` is bounded, so `Q ⊆ (C ∩ B_{j+1}(0)) \ t_j` for large `j`. -/
theorem Submission.codim1_rdo_c1a_egorov_isClosed : ∀ (n : ℕ) (C : Set (Euclid n)) (η : ℕ → Euclid n → ℝ) (g : Euclid n → ℝ), MeasurableSet C → (∀ k, Measurable (η k)) → Measurable g → (∀ x ∈ C, Tendsto (fun k => η k x) atTop (𝓝 (g x))) → ∀ ε : ℝ≥0∞, 0 < ε → ∃ A : Set (Euclid n), A ⊆ C ∧ IsClosed A ∧ volume (C \ A) < ε ∧ ∀ Q : Set (Euclid n), IsCompact Q → Q ⊆ A → TendstoUniformlyOn η g atTop Q := by
  intro n C η g hC hη hg hconv ε hε
  -- weights `δ_j > 0` with `∑ δ_j < ε`; every `s ∩ B_{j+1}(0)` has finite measure
  obtain ⟨δ, hδ, hδε⟩ := ENNReal.exists_pos_sum_of_countable' hε.ne' ℕ
  have hB : ∀ (j : ℕ) (s : Set (Euclid n)), volume (s ∩ ball 0 (j + 1)) ≠ ∞ := fun j s =>
    ((measure_mono inter_subset_right).trans_lt measure_ball_lt_top).ne
  -- Egoroff on `C_j = C ∩ B_{j+1}(0)`: `η_k → g` uniformly on `C_j \ t_j`, `|t_j| ≤ δ_j / 2`
  choose t htC htm htμ htu using fun j : ℕ =>
    tendstoUniformlyOn_of_ae_tendsto (μ := volume) (fun k => (hη k).stronglyMeasurable)
      hg.stronglyMeasurable (hC.inter measurableSet_ball) (hB j C)
      (ae_of_all _ fun x hx => hconv x hx.1) (ENNReal.half_pos (hδ j).ne')
  -- `A₀ = C \ ⋃ t_j`; outer regularity gives open `U_j ⊇ A₀ᶜ ∩ B_{j+1}(0)` with small excess
  have hA₀ : MeasurableSet (C \ ⋃ j, t j) := hC.diff (MeasurableSet.iUnion htm)
  choose U hUD hUo hUf hUμ using fun j : ℕ =>
    (hA₀.compl.inter measurableSet_ball).exists_isOpen_sdiff_lt (hB j _)
      (ENNReal.half_pos (hδ j).ne').ne'
  -- the balls cover `A₀ᶜ`, so the closed set `A = (⋃ U_j)ᶜ` lies in `A₀`
  have hAA₀ : (⋃ j, U j)ᶜ ⊆ C \ ⋃ j, t j := by
    refine compl_subset_comm.1 fun x hx => ?_
    obtain ⟨j, hj⟩ := exists_nat_gt (dist x 0)
    exact mem_iUnion.2 ⟨j, hUD j ⟨hx, mem_ball.2 (by linarith)⟩⟩
  refine ⟨(⋃ j, U j)ᶜ, hAA₀.trans sdiff_subset, (isOpen_iUnion hUo).isClosed_compl, ?_, ?_⟩
  -- `C \ A ⊆ ⋃_j (t_j ∪ (U_j \ (A₀ᶜ ∩ B_{j+1}(0))))`, and each piece has measure `≤ δ_j`
  · calc volume (C \ (⋃ j, U j)ᶜ)
        ≤ volume (⋃ j, (t j ∪ (U j \ ((C \ ⋃ i, t i)ᶜ ∩ ball 0 (j + 1))))) := by
          refine measure_mono fun x ⟨hxC, hxU⟩ => ?_
          obtain ⟨j, hj⟩ := mem_iUnion.1 (not_not.1 hxU)
          by_cases hxt : x ∈ ⋃ i, t i
          · obtain ⟨i, hi⟩ := mem_iUnion.1 hxt
            exact mem_iUnion.2 ⟨i, Or.inl hi⟩
          · exact mem_iUnion.2 ⟨j, Or.inr ⟨hj, fun h => h.1 ⟨hxC, hxt⟩⟩⟩
      _ ≤ ∑' j, volume (t j ∪ (U j \ ((C \ ⋃ i, t i)ᶜ ∩ ball 0 (j + 1)))) :=
          measure_iUnion_le _
      _ ≤ ∑' j, δ j := ENNReal.tsum_le_tsum fun j => (measure_union_le _ _).trans <|
          (add_le_add (htμ j) (hUμ j).le).trans (ENNReal.add_halves _).le
      _ < ε := hδε
  -- a compact `Q ⊆ A` is bounded, so `Q ⊆ C_j \ t_j` for large `j`
  · intro Q hQ hQA
    obtain ⟨R, hR⟩ := hQ.isBounded.subset_ball 0
    obtain ⟨j, hj⟩ := exists_nat_ge R
    refine (htu j).mono fun x hx => ⟨⟨(hAA₀ (hQA hx)).1, ?_⟩, fun hxt => ?_⟩
    · exact ball_subset_ball (by linarith) (hR hx)
    · exact (hAA₀ (hQA hx)).2 (mem_iUnion.2 ⟨j, hxt⟩)
/-- **Whitney's hypothesis 1.6(∗) on a large closed set** (Simon Ch. 2, proof of Theorem 1.5).
Let `f : ℝⁿ → ℝ` be `L`-Lipschitz and differentiable at every point of the closed set `C`, with
`Df` continuous on `C`.  The remainder quotient `R(x, y) = |f(y) − f(x) − Df(x)(y − x)| / |y − x|`
is at most `2L`, and `η_k(x) = sup {R(x, y) : y ∈ C, 0 < |y − x| < 1/(k + 1)}` (`0` off `C`)
tends to `0` on `C`.  Each `{η_k > t}`, `t ≥ 0`, is relatively open in `C`, so `η_k` is Borel,
and Egorov's theorem in closed form gives a closed `A ⊆ C` with `Lⁿ(C \ A) < ε` such that
`η_k → 0` uniformly on every compact `Q ⊆ A`.  Then `R(x, y) ≤ η_k(x) < ε'` for `x ∈ Q`,
`y ∈ A`, `0 < |x − y| < 1/(k + 1)`. -/
theorem Submission.codim1_rdo_c1a_whitney_remainder : ∀ (n : ℕ) (f : Euclid n → ℝ) (L : NNReal) (C : Set (Euclid n)), LipschitzWith L f → IsClosed C → (∀ x ∈ C, DifferentiableAt ℝ f x) → ContinuousOn (fderiv ℝ f) C → ∀ ε : ℝ≥0∞, 0 < ε → ∃ A : Set (Euclid n), A ⊆ C ∧ IsClosed A ∧ volume (C \ A) < ε ∧ ∀ Q : Set (Euclid n), IsCompact Q → Q ⊆ A → ∀ ε' : ℝ, 0 < ε' → ∃ δ : ℝ, 0 < δ ∧ ∀ x ∈ Q, ∀ y ∈ A, dist x y < δ → ‖f y - f x - fderiv ℝ f x (y - x)‖ ≤ ε' * ‖y - x‖ := by
  intro n f L C hf hC hdiff hDf ε hε
  classical
  -- the remainder quotient `R(x, y)`, bounded by `2L` since `‖Df(x)‖ ≤ L`
  let R : Euclid n → Euclid n → ℝ := fun x y => ‖f y - f x - fderiv ℝ f x (y - x)‖ / ‖y - x‖
  have hR_le : ∀ x y, R x y ≤ 2 * L := by
    intro x y
    refine div_le_of_le_mul₀ (norm_nonneg _) (by positivity) ?_
    calc ‖f y - f x - fderiv ℝ f x (y - x)‖ ≤ ‖f y - f x‖ + ‖fderiv ℝ f x (y - x)‖ :=
          norm_sub_le _ _
      _ ≤ L * ‖y - x‖ + L * ‖y - x‖ := by
          refine add_le_add ?_ ?_
          · rw [← dist_eq_norm, ← dist_eq_norm]
            exact hf.dist_le_mul y x
          · exact (ContinuousLinearMap.le_opNorm _ _).trans
              (mul_le_mul_of_nonneg_right (norm_fderiv_le_of_lipschitz ℝ hf) (norm_nonneg _))
      _ = 2 * L * ‖y - x‖ := by ring
  -- `η_k(x) = sup E_k(x)`, `E_k(x) = {R(x, y) : y ∈ C, 0 < |y − x| < 1/(k + 1)}`, on `C`
  let E : ℕ → Euclid n → Set ℝ := fun k x =>
    R x '' {y | y ∈ C ∧ 0 < dist y x ∧ dist y x < 1 / ((k : ℝ) + 1)}
  let η : ℕ → Euclid n → ℝ := fun k x => if x ∈ C then sSup (E k x) else 0
  have hη_nonneg : ∀ k x, 0 ≤ η k x := by
    intro k x
    by_cases hx : x ∈ C
    · simp only [η, ite_eq_left hx]
      exact Real.sSup_nonneg (by
        rintro _ ⟨y, -, rfl⟩
        exact div_nonneg (norm_nonneg _) (norm_nonneg _))
    · simp only [η, ite_eq_right hx, le_refl]
  have hR_le_η : ∀ (k : ℕ) x y, x ∈ C → y ∈ C → 0 < dist y x → dist y x < 1 / ((k : ℝ) + 1) →
      R x y ≤ η k x := by
    intro k x y hx hy h0 h1
    simp only [η, ite_eq_left hx]
    exact le_csSup ⟨2 * L, by rintro _ ⟨z, -, rfl⟩; exact hR_le x z⟩ ⟨y, ⟨hy, h0, h1⟩, rfl⟩
  -- `η_k(x) → 0` for `x ∈ C`, by differentiability of `f` at `x`
  have hη_tendsto : ∀ x ∈ C, Tendsto (fun k => η k x) atTop (𝓝 0) := by
    intro x hx
    rw [Metric.tendsto_atTop]
    intro e he
    obtain ⟨ρ, hρ, hρx⟩ :=
      Metric.eventually_nhds_iff.mp ((hdiff x hx).hasFDerivAt.isLittleO.bound (half_pos he))
    obtain ⟨N, hN⟩ := exists_nat_one_div_lt hρ
    refine ⟨N, fun k hk => ?_⟩
    have hle : η k x ≤ e / 2 := by
      simp only [η, ite_eq_left hx]
      refine Real.sSup_le ?_ (half_pos he).le
      rintro _ ⟨y, ⟨-, -, h1⟩, rfl⟩
      exact div_le_of_le_mul₀ (norm_nonneg _) (half_pos he).le
        (hρx (h1.trans_le ((Nat.one_div_le_one_div hk).trans hN.le)))
    rw [Real.dist_eq, sub_zero, abs_of_nonneg (hη_nonneg k x)]
    exact hle.trans_lt (half_lt_self he)
  -- `{η_k > t}` is relatively open in the closed set `C` for `t ≥ 0`, so `η_k` is Borel
  have hη_meas : ∀ k, Measurable (η k) := by
    intro k
    refine measurable_of_Ioi fun t => ?_
    rcases lt_or_ge t 0 with ht | ht
    · convert MeasurableSet.univ
      exact eq_univ_of_forall fun x => ht.trans_le (hη_nonneg k x)
    have hUC : η k ⁻¹' Ioi t ⊆ C := by
      intro x hx
      by_contra hxC
      have hx' : t < η k x := hx
      simp only [η, ite_eq_right hxC] at hx'
      exact absurd hx' (not_lt.mpr ht)
    have hnhds : ∀ x ∈ η k ⁻¹' Ioi t, η k ⁻¹' Ioi t ∪ Cᶜ ∈ 𝓝 x := by
      intro x hx
      have hxC := hUC hx
      have hxt : t < sSup (E k x) := by
        have hx' : t < η k x := hx
        simpa only [η, ite_eq_left hxC] using hx'
      have hne : (E k x).Nonempty := by
        by_contra hemp
        rw [not_nonempty_iff_eq_empty] at hemp
        rw [hemp, Real.sSup_empty] at hxt
        exact absurd hxt (not_lt.mpr ht)
      obtain ⟨_, ⟨y, ⟨hy, h0, h1⟩, rfl⟩, hty⟩ := exists_lt_of_lt_csSup hne hxt
      -- `z ↦ R(z, y)` is continuous within `C` at `x`, as `f` and `Df|_C` are continuous
      have hsub : ContinuousWithinAt (fun z => y - z) C x :=
        continuousWithinAt_const.sub continuousWithinAt_id
      have hnum : ContinuousWithinAt (fun z => ‖f y - f z - fderiv ℝ f z (y - z)‖) C x :=
        ((continuousWithinAt_const.sub hf.continuous.continuousWithinAt).sub
          ((hDf x hxC).clm_apply hsub)).norm
      have hRy : ContinuousWithinAt (fun z => R z y) C x :=
        hnum.div hsub.norm (norm_sub_pos_iff.mpr (dist_pos.mp h0)).ne'
      have hdist : Tendsto (fun z => dist y z) (𝓝 x) (𝓝 (dist y x)) :=
        tendsto_const_nhds.dist tendsto_id
      -- near `x`, every `z ∈ C` has `η_k(z) ≥ R(z, y) > t`
      filter_upwards [eventually_nhdsWithin_iff.mp (Filter.Tendsto.eventually_const_lt hty hRy),
        hdist.eventually_const_lt h0, hdist.eventually_lt_const h1] with z hz hz0 hz1
      by_cases hzC : z ∈ C
      · exact Or.inl ((hz hzC).trans_le (hR_le_η k z y hzC hy hz0 hz1))
      · exact Or.inr hzC
    have heq : η k ⁻¹' Ioi t = C ∩ interior (η k ⁻¹' Ioi t ∪ Cᶜ) := by
      refine Subset.antisymm
        (fun x hx => ⟨hUC hx, mem_interior_iff_mem_nhds.mpr (hnhds x hx)⟩) ?_
      rintro x ⟨hxC, hxI⟩
      rcases interior_subset hxI with hx | hx
      · exact hx
      · exact absurd hxC hx
    rw [heq]
    exact hC.measurableSet.inter isOpen_interior.measurableSet
  -- Egorov on `C`: a closed `A ⊆ C`, `Lⁿ(C \ A) < ε`, with `η_k → 0` uniformly on compact `Q ⊆ A`
  obtain ⟨A, hAC, hA, hCA, hunif⟩ := Submission.codim1_rdo_c1a_egorov_isClosed n C η
    (fun _ => 0) hC.measurableSet hη_meas measurable_const hη_tendsto ε hε
  refine ⟨A, hAC, hA, hCA, fun Q hQ hQA ε' hε' => ?_⟩
  -- `η_k < ε'` on `Q` for some `k`; take `δ = 1/(k + 1)`
  obtain ⟨k, hk⟩ := (Metric.tendstoUniformlyOn_iff.mp (hunif Q hQ hQA) ε' hε').exists
  refine ⟨1 / ((k : ℝ) + 1), Nat.one_div_pos_of_nat, fun x hx y hy hxy => ?_⟩
  rcases eq_or_ne y x with rfl | hyx
  · simp
  have h0 : 0 < dist y x := dist_pos.mpr hyx
  have hηx : η k x < ε' := by
    have hkx := hk x hx
    rw [dist_comm, Real.dist_eq, sub_zero] at hkx
    exact (le_abs_self _).trans_lt hkx
  have hR : R x y ≤ ε' :=
    (hR_le_η k x y (hAC (hQA hx)) (hAC hy) h0 (by rwa [dist_comm])).trans hηx.le
  exact (div_le_iff₀ (norm_sub_pos_iff.mpr hyx)).mp hR
/-- **Whitney's `C¹` extension theorem** (Simon Ch. 2, 1.6; proof of Evans–Gariepy §6.5).  If
`A ⊆ ℝⁿ` is closed, `h` and `D` are continuous on `A`, and the remainder
`h y - h x - D x (y - x)` is `o(|y - x|)` uniformly for `x` in compact subsets of `A`, then some
`g ∈ C¹(ℝⁿ)` has `g = h` and `Dg = D` on `A`.  With `r x = min(1, dist(x, A)) / 100`, Vitali's
lemma selects disjoint balls `B(c, r c)`, `c ∈ Z`, whose fourfold enlargements cover `ℝⁿ \ A`;
nearby radii are comparable, so the overlap is uniformly bounded.  Rescaled bumps divided by
their locally finite sum give a partition of unity `w c` on `ℝⁿ \ A` with
`∑ ‖D(w c)(x)‖ ≤ M / r x`.  Put `g = h` on `A` and `g = ∑ w c • P (pr c)` off `A`, where
`P b x = h b + D b (x - b)` and `pr c ∈ A` is a nearest point. -/
theorem Submission.codim1_rdo_c1a_whitney_extension : ∀ (n : ℕ) (A : Set (Euclid n)) (h : Euclid n → ℝ) (D : Euclid n → (Euclid n →L[ℝ] ℝ)), IsClosed A → ContinuousOn h A → ContinuousOn D A → (∀ Q : Set (Euclid n), IsCompact Q → Q ⊆ A → ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ x ∈ Q, ∀ y ∈ A, dist x y < δ → ‖h y - h x - D x (y - x)‖ ≤ ε * ‖y - x‖) → ∃ g : Euclid n → ℝ, ContDiff ℝ 1 g ∧ EqOn g h A ∧ ∀ a ∈ A, HasFDerivAt g (D a) a := by
  intro n A h D hA hh hD hrem
  classical
  rcases A.eq_empty_or_nonempty with rfl | hne
  · exact ⟨fun _ => 0, contDiff_const, by simp, by simp⟩
  -- the Whitney radius `r x = min 1 (dist x A) / 100`
  obtain ⟨r, hr⟩ : ∃ r : Euclid n → ℝ, ∀ x, r x = min 1 (infDist x A) / 100 :=
    ⟨_, fun _ => rfl⟩
  have hr0 : ∀ x, 0 ≤ r x := fun x => by
    rw [hr]; exact div_nonneg (le_min zero_le_one infDist_nonneg) (by norm_num)
  have hr1 : ∀ x, r x ≤ 1 / 100 := fun x => by
    rw [hr]; exact div_le_div_of_nonneg_right (min_le_left _ _) (by norm_num)
  have hrd : ∀ x, 100 * r x ≤ infDist x A := fun x => by
    rw [hr]; linarith [min_le_right (1 : ℝ) (infDist x A)]
  have hrpos : ∀ x, x ∉ A → 0 < r x := fun x hx => by
    rw [hr]
    exact div_pos (lt_min one_pos ((hA.notMem_iff_infDist_pos hne).mp hx)) (by norm_num)
  have hrlip : ∀ x y, r x ≤ r y + dist x y / 100 := fun x y => by
    have h₁ := ((lipschitz_infDist_pt A).const_min 1).dist_le_mul x y
    simp only [Real.dist_eq, NNReal.coe_one, one_mul] at h₁
    have h₂ := (abs_sub_le_iff.mp h₁).1
    rw [hr, hr]; linarith
  -- radii of nearby centres are comparable
  have hnear : ∀ x c, dist x c ≤ r x + 10 * r c →
      r x / 2 ≤ r c ∧ r c ≤ 2 * r x ∧ dist x c ≤ 21 * r x := by
    intro x c hxc
    have h₁ := hrlip x c
    have h₂ := hrlip c x
    rw [dist_comm c x] at h₂
    have := hr0 x
    have := hr0 c
    exact ⟨by linarith, by linarith, by linarith⟩
  -- Vitali: disjoint balls `B(c, r c)`, `c ∈ Z`, whose fourfold enlargements cover `Aᶜ`
  obtain ⟨Z, hZA, hZdisj, hZcov⟩ : ∃ Z ⊆ Aᶜ, Z.PairwiseDisjoint (fun c => ball c (r c)) ∧
      ∀ x ∉ A, ∃ c ∈ Z, dist x c < 4 * r c := by
    obtain ⟨s, hs, hd, hc⟩ := Vitali.exists_disjoint_subfamily_covering_enlargement_ball
      Aᶜ (fun x => x) r (1 / 100) (fun x _ => hr1 x) 4 (by norm_num)
    refine ⟨s, hs, hd, fun x hx => ?_⟩
    obtain ⟨c, hcs, hxc⟩ := hc x hx
    exact ⟨c, hcs, hxc (mem_ball_self (hrpos x hx))⟩
  have hsep : ∀ c ∈ Z, ∀ d ∈ Z, c ≠ d → r c ≤ dist c d := by
    intro c hc d hd hcd
    by_contra hlt
    have hdc : d ∈ ball c (r c) := by
      simpa only [mem_ball, dist_comm] using lt_of_not_ge hlt
    exact Set.disjoint_left.mp (hZdisj hc hd hcd) hdc (mem_ball_self (hrpos d (hZA hd)))
  -- a `1/2`-separated subset of `B̄(0, 21)` has at most `N` points
  obtain ⟨N, hN⟩ : ∃ N : ℕ, ∀ s : Set (Euclid n), s ⊆ closedBall (0 : Euclid n) 21 →
      s.Pairwise (fun x y => 1 / 2 ≤ dist x y) → s.Finite ∧ s.ncard ≤ N := by
    obtain ⟨t, ht, hcover⟩ := Metric.totallyBounded_iff.mp
      (isCompact_closedBall (0 : Euclid n) 21).totallyBounded (1 / 4) (by norm_num)
    refine ⟨t.ncard, fun s hs hssep => ?_⟩
    have hc : ∀ x : s, ∃ y : t, dist (x : Euclid n) y < 1 / 4 := by
      intro x
      have hx := hcover (hs x.property)
      simp only [mem_iUnion, mem_ball, exists_prop] at hx
      obtain ⟨y, hyt, hxy⟩ := hx
      exact ⟨⟨y, hyt⟩, hxy⟩
    choose c hc using hc
    have hi : Injective c := by
      intro x y hxy
      by_contra hxy'
      have hne' : (x : Euclid n) ≠ (y : Euclid n) := fun e => hxy' (Subtype.ext e)
      have hd := hssep x.property y.property hne'
      have htri := dist_triangle (x : Euclid n) (c x : Euclid n) (y : Euclid n)
      have hxc := hc x
      have hyc := hc y
      rw [← hxy, dist_comm (y : Euclid n) (c x : Euclid n)] at hyc
      linarith
    have : Finite t := ht.to_subtype
    have : Finite s := Finite.of_injective c hi
    exact ⟨Set.toFinite s, Nat.card_le_card_of_injective c hi⟩
  -- bounded overlap: at most `N` centres are near any `x ∉ A`
  have hover : ∀ x ∉ A, {c | c ∈ Z ∧ dist x c ≤ r x + 10 * r c}.Finite ∧
      {c | c ∈ Z ∧ dist x c ≤ r x + 10 * r c}.ncard ≤ N := by
    intro x hx
    have hrx : 0 < r x := hrpos x hx
    let f : Euclid n → Euclid n := fun c => (r x)⁻¹ • (c - x)
    have hf : Injective f := by
      intro c d hcd
      have e := congrArg (fun z : Euclid n => r x • z) hcd
      simpa [f, smul_smul, hrx.ne'] using e
    have hnorm : ∀ c ∈ {c | c ∈ Z ∧ dist x c ≤ r x + 10 * r c}, ‖f c‖ ≤ 21 := by
      intro c hc
      have hd := (hnear x c hc.2).2.2
      rw [dist_comm, dist_eq_norm] at hd
      simp only [f]
      rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hrx.le)]
      calc (r x)⁻¹ * ‖c - x‖ ≤ (r x)⁻¹ * (21 * r x) :=
            mul_le_mul_of_nonneg_left hd (inv_nonneg.mpr hrx.le)
        _ = 21 := by field_simp
    have hsep' : (f '' {c | c ∈ Z ∧ dist x c ≤ r x + 10 * r c}).Pairwise
        (fun y z => 1 / 2 ≤ dist y z) := by
      rintro _ ⟨c, hc, rfl⟩ _ ⟨d, hd, rfl⟩ hcd
      have hcd' : c ≠ d := fun e => hcd (congrArg f e)
      have hdist := hsep c hc.1 d hd.1 hcd'
      have hrad := (hnear x c hc.2).1
      have hlow : r x / 2 ≤ ‖c - d‖ := by
        simpa only [dist_eq_norm] using hrad.trans hdist
      have hid : (c - x) - (d - x) = c - d := by abel
      simp only [f]
      rw [dist_eq_norm, ← smul_sub, hid, norm_smul,
        Real.norm_of_nonneg (inv_nonneg.mpr hrx.le)]
      calc (1 : ℝ) / 2 = (r x)⁻¹ * (r x / 2) := by field_simp
        _ ≤ (r x)⁻¹ * ‖c - d‖ := mul_le_mul_of_nonneg_left hlow (inv_nonneg.mpr hrx.le)
    have hsub : f '' {c | c ∈ Z ∧ dist x c ≤ r x + 10 * r c} ⊆ closedBall (0 : Euclid n) 21 := by
      rintro _ ⟨c, hc, rfl⟩
      simpa only [mem_closedBall, dist_zero_right] using hnorm c hc
    obtain ⟨hfin, hcard⟩ := hN _ hsub hsep'
    exact ⟨hfin.of_finite_image hf.injOn, by rwa [Set.ncard_image_of_injective _ hf] at hcard⟩
  -- the finite set `F x` of centres near `x ∉ A`
  have hfin : ∀ x ∉ A, {c : Z | dist x c ≤ r x + 10 * r c}.Finite := by
    intro x hx
    apply ((hover x hx).1.preimage (Subtype.val_injective (p := (· ∈ Z))).injOn).subset
    intro c hc
    exact ⟨c.property, hc⟩
  have hFex : ∀ x, ∃ s : Finset Z, x ∉ A → ∀ c : Z, c ∈ s ↔ dist x c ≤ r x + 10 * r c := by
    intro x
    by_cases hx : x ∈ A
    · exact ⟨∅, fun hx' => absurd hx hx'⟩
    · exact ⟨(hfin x hx).toFinset, fun _ c => by simp⟩
  choose F hF using hFex
  have hFcard : ∀ x ∉ A, (F x).card ≤ N := by
    intro x hx
    have hsub : (F x).map (Embedding.subtype _) ⊆ (hover x hx).1.toFinset := by
      intro c hc
      simp only [Finset.mem_map, Embedding.coe_subtype] at hc
      obtain ⟨c', hc', rfl⟩ := hc
      rw [Set.Finite.mem_toFinset]
      exact ⟨c'.property, (hF x hx c').mp hc'⟩
    calc (F x).card = ((F x).map (Embedding.subtype _)).card := (Finset.card_map _).symm
      _ ≤ (hover x hx).1.toFinset.card := Finset.card_le_card hsub
      _ = {c | c ∈ Z ∧ dist x c ≤ r x + 10 * r c}.ncard :=
          (Set.ncard_eq_toFinset_card _ _).symm
      _ ≤ N := (hover x hx).2
  -- a smooth bump `ψ = 1` on `B̄(0, 4)`, `ψ = 0` off `B(0, 8)`
  obtain ⟨ψ, hψc, hψ0, hψ1, hψin, hψout, L, hL⟩ : ∃ ψ : Euclid n → ℝ, ContDiff ℝ 1 ψ ∧
      (∀ x, 0 ≤ ψ x) ∧ (∀ x, ψ x ≤ 1) ∧ (∀ x, ‖x‖ ≤ 4 → ψ x = 1) ∧
      (∀ x, 8 ≤ ‖x‖ → ψ x = 0) ∧ ∃ L : NNReal, LipschitzWith L ψ := by
    let b : ContDiffBump (0 : Euclid n) := ⟨4, 8, by norm_num, by norm_num⟩
    have hb : ContDiff ℝ 1 b := b.contDiff
    obtain ⟨L, hL⟩ := hb.lipschitzWith_of_hasCompactSupport b.hasCompactSupport one_ne_zero
    refine ⟨b, hb, fun x => b.nonneg, fun x => b.le_one, fun x hx => ?_, fun x hx => ?_, L, hL⟩
    · exact b.one_of_mem_closedBall (mem_closedBall_zero_iff.mpr hx)
    · apply notMem_support.mp
      rw [b.support_eq]
      exact fun hxb => absurd (mem_ball_zero_iff.mp hxb) (not_lt.mpr hx)
  -- the rescaled bumps `φ c x = ψ ((x - c) / r c)`
  obtain ⟨φ, hφ⟩ : ∃ φ : Euclid n → Euclid n → ℝ, ∀ c x, φ c x = ψ ((r c)⁻¹ • (x - c)) :=
    ⟨_, fun _ _ => rfl⟩
  have hφfun : ∀ c, φ c = fun x => ψ ((r c)⁻¹ • (x - c)) := fun c => funext (hφ c)
  have hφc : ∀ c, ContDiff ℝ 1 (φ c) := by
    intro c
    rw [hφfun c]
    exact hψc.comp ((contDiff_id.sub contDiff_const).const_smul _)
  have hφ0 : ∀ c x, 0 ≤ φ c x := fun c x => by rw [hφ]; exact hψ0 _
  have hφin : ∀ c x, 0 < r c → dist x c ≤ 4 * r c → φ c x = 1 := by
    intro c x hc hx
    rw [hφ]
    apply hψin
    rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hc.le), ← dist_eq_norm]
    calc (r c)⁻¹ * dist x c ≤ (r c)⁻¹ * (4 * r c) :=
          mul_le_mul_of_nonneg_left hx (inv_nonneg.mpr hc.le)
      _ = 4 := by field_simp
  have hφout : ∀ c x, 0 < r c → 8 * r c ≤ dist x c → φ c x = 0 := by
    intro c x hc hx
    rw [hφ]
    apply hψout
    rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hc.le), ← dist_eq_norm]
    calc (8 : ℝ) = (r c)⁻¹ * (8 * r c) := by field_simp
      _ ≤ (r c)⁻¹ * dist x c := mul_le_mul_of_nonneg_left hx (inv_nonneg.mpr hc.le)
  obtain ⟨B, hB, hBb⟩ : ∃ B : ℝ, 0 < B ∧ ∀ c, 0 < r c → ∀ x, ‖fderiv ℝ (φ c) x‖ ≤ B / r c := by
    refine ⟨(L : ℝ) + 1, by positivity, fun c hc x => ?_⟩
    let ρ : NNReal := ⟨r c, hc.le⟩
    have hf : LipschitzWith ρ⁻¹ (fun y : Euclid n => (r c)⁻¹ • (y - c)) := by
      apply LipschitzWith.of_dist_le_mul
      intro y z
      have hid : (y - c) - (z - c) = y - z := by abel
      simp only [dist_eq_norm, ← smul_sub, hid, norm_smul,
        Real.norm_of_nonneg (inv_nonneg.mpr hc.le), NNReal.coe_inv]
      exact le_rfl
    have hg : LipschitzWith (L * ρ⁻¹) (φ c) := by
      rw [hφfun c]
      exact hL.comp hf
    have hb := norm_fderiv_le_of_lipschitz ℝ hg (x₀ := x)
    simp only [NNReal.coe_mul, NNReal.coe_inv] at hb
    change ‖fderiv ℝ (φ c) x‖ ≤ (L : ℝ) * (r c)⁻¹ at hb
    refine hb.trans ?_
    rw [div_eq_mul_inv]
    exact mul_le_mul_of_nonneg_right (by linarith) (inv_nonneg.mpr hc.le)
  -- near `x ∉ A`, only the bumps indexed by `F x` are active
  have hφzero : ∀ x ∉ A, ∀ y, dist y x < r x → ∀ c : Z, c ∉ F x → φ c y = 0 := by
    intro x hx y hy c hc
    apply hφout c y (hrpos c (hZA c.property))
    have hnot : ¬ dist x c ≤ r x + 10 * r c := fun e => hc ((hF x hx c).mpr e)
    have ht := dist_triangle x y (c : Euclid n)
    rw [dist_comm x y] at ht
    have := hr0 (c : Euclid n)
    linarith
  have hyA : ∀ x ∉ A, ∀ y, dist y x < r x → y ∉ A := by
    intro x hx y hy hyA'
    have hi := infDist_le_dist_of_mem (x := x) hyA'
    have hr' := hrd x
    rw [dist_comm x y] at hi
    linarith [hr0 x]
  -- the locally finite sum `S = ∑ φ c`
  obtain ⟨S, hS⟩ : ∃ S : Euclid n → ℝ, ∀ x, S x = ∑ᶠ c : Z, φ c x := ⟨_, fun _ => rfl⟩
  have hSnear : ∀ x ∉ A, ∀ y, dist y x < r x → S y = ∑ c ∈ F x, φ c y := by
    intro x hx y hy
    rw [hS]
    apply finsum_eq_sum_of_support_subset
    intro c hc
    by_contra hcF
    exact hc (hφzero x hx y hy c hcF)
  have hSev : ∀ x ∉ A, S =ᶠ[𝓝 x] fun y => ∑ c ∈ F x, φ c y := by
    intro x hx
    filter_upwards [ball_mem_nhds x (hrpos x hx)] with y hy
    exact hSnear x hx y hy
  have hSc : ∀ x ∉ A, ContDiffAt ℝ 1 S x := fun x hx =>
    (ContDiff.sum (f := fun (c : Z) y => φ c y) (s := F x) fun c _ => hφc c).contDiffAt.congr_of_eventuallyEq
      (hSev x hx)
  have hSfd : ∀ x ∉ A, fderiv ℝ S x = ∑ c ∈ F x, fderiv ℝ (φ c) x := by
    intro x hx
    rw [(hSev x hx).fderiv_eq]
    exact fderiv_fun_sum (fun c _ => (hφc c).differentiable one_ne_zero x)
  have hS1 : ∀ x ∉ A, 1 ≤ S x := by
    intro x hx
    have hrx := hrpos x hx
    rw [hSnear x hx x (by simpa using hrx)]
    obtain ⟨c, hc, hxc⟩ := hZcov x hx
    have hi : (⟨c, hc⟩ : Z) ∈ F x := by
      rw [hF x hx]
      have := hr0 c
      show dist x c ≤ r x + 10 * r c
      linarith
    calc (1 : ℝ) = φ c x := (hφin c x (hrpos c (hZA hc)) hxc.le).symm
      _ ≤ ∑ c ∈ F x, φ c x :=
          Finset.single_le_sum (f := fun c : Z => φ c x) (fun c _ => hφ0 c x) hi
  -- the partition of unity `w c = φ c / S` on `Aᶜ`
  obtain ⟨w, hw⟩ : ∃ w : Z → Euclid n → ℝ, ∀ c x, w c x = φ c x / S x := ⟨_, fun _ _ => rfl⟩
  have hwfun : ∀ c, w c = fun x => φ c x / S x := fun c => funext (hw c)
  have hwc : ∀ c : Z, ∀ x ∉ A, ContDiffAt ℝ 1 (w c) x := by
    intro c x hx
    rw [hwfun c]
    exact (hφc c).contDiffAt.div (hSc x hx) (ne_of_gt (lt_of_lt_of_le one_pos (hS1 x hx)))
  have hw0 : ∀ c : Z, ∀ x ∉ A, 0 ≤ w c x := by
    intro c x hx
    rw [hw]
    exact div_nonneg (hφ0 c x) (le_trans zero_le_one (hS1 x hx))
  have hwzero : ∀ x ∉ A, ∀ y, dist y x < r x → ∀ c : Z, c ∉ F x → w c y = 0 := by
    intro x hx y hy c hc
    rw [hw, hφzero x hx y hy c hc, zero_div]
  have hwsum : ∀ x ∉ A, ∀ y, dist y x < r x → ∑ c ∈ F x, w c y = 1 := by
    intro x hx y hy
    simp only [hw, ← Finset.sum_div, ← hSnear x hx y hy]
    exact div_self (ne_of_gt (lt_of_lt_of_le one_pos (hS1 y (hyA x hx y hy))))
  have hwdsum : ∀ x ∉ A, ∑ c ∈ F x, fderiv ℝ (w c) x = 0 := by
    intro x hx
    have heq : (fun y => ∑ c ∈ F x, w c y) =ᶠ[𝓝 x] (fun _ => (1 : ℝ)) := by
      filter_upwards [ball_mem_nhds x (hrpos x hx)] with y hy
      exact hwsum x hx y hy
    have hh' := heq.fderiv_eq (𝕜 := ℝ)
    rw [fderiv_fun_const] at hh'
    rw [fderiv_fun_sum (fun c _ => (hwc c x hx).differentiableAt one_ne_zero)] at hh'
    exact hh'
  have hwd_le : ∀ x ∉ A, ∀ c : Z,
      ‖fderiv ℝ (w c) x‖ ≤ ‖fderiv ℝ (φ c) x‖ + ‖fderiv ℝ S x‖ := by
    intro x hx c
    have hS1x := hS1 x hx
    have hSpos : 0 < S x := lt_of_lt_of_le one_pos hS1x
    have hSi : (S x)⁻¹ ≤ 1 := by
      simpa using one_div_le_one_div_of_le (by norm_num : (0 : ℝ) < 1) hS1x
    have hSi2 : (S x ^ 2)⁻¹ ≤ 1 := by
      simpa using one_div_le_one_div_of_le (by norm_num : (0 : ℝ) < 1)
        (show 1 ≤ S x ^ 2 by nlinarith)
    have hb := ((hφc c).differentiable one_ne_zero x).hasFDerivAt
    have hd := ((hSc x hx).differentiableAt one_ne_zero).hasFDerivAt
    have hi := (hasDerivAt_inv hSpos.ne').comp_hasFDerivAt x hd
    have hprod := hb.fun_mul hi
    have hder : fderiv ℝ (w c) x =
        φ c x • (-(S x ^ 2)⁻¹ • fderiv ℝ S x) + (S x)⁻¹ • fderiv ℝ (φ c) x := by
      simpa only [hwfun, div_eq_mul_inv, Function.comp_def] using hprod.fderiv
    rw [hder]
    have hb0 := hφ0 c x
    have hb1 : φ c x ≤ 1 := by rw [hφ]; exact hψ1 _
    calc ‖φ c x • (-(S x ^ 2)⁻¹ • fderiv ℝ S x) + (S x)⁻¹ • fderiv ℝ (φ c) x‖
        ≤ ‖φ c x • (-(S x ^ 2)⁻¹ • fderiv ℝ S x)‖ + ‖(S x)⁻¹ • fderiv ℝ (φ c) x‖ :=
          norm_add_le _ _
      _ = φ c x * ((S x ^ 2)⁻¹ * ‖fderiv ℝ S x‖) + (S x)⁻¹ * ‖fderiv ℝ (φ c) x‖ := by
          rw [norm_smul, norm_smul, norm_smul, Real.norm_of_nonneg hb0, norm_neg,
            Real.norm_of_nonneg (inv_nonneg.mpr (sq_nonneg (S x))),
            Real.norm_of_nonneg (inv_nonneg.mpr hSpos.le)]
      _ ≤ ‖fderiv ℝ (φ c) x‖ + ‖fderiv ℝ S x‖ := by
          have h₁ := mul_le_mul_of_nonneg_right hSi (norm_nonneg (fderiv ℝ (φ c) x))
          have h₂ := mul_le_mul_of_nonneg_right hSi2 (norm_nonneg (fderiv ℝ S x))
          have h₃ := mul_le_mul_of_nonneg_right hb1
            (mul_nonneg (inv_nonneg.mpr (sq_nonneg (S x))) (norm_nonneg (fderiv ℝ S x)))
          linarith
  -- `∑_{c ∈ F x} ‖D w_c(x)‖ ≤ M / r x`
  obtain ⟨M, hM, hMb⟩ : ∃ M : ℝ, 0 < M ∧ ∀ x ∉ A, ∑ c ∈ F x, ‖fderiv ℝ (w c) x‖ ≤ M / r x := by
    refine ⟨2 * B * ((N : ℝ) + 1) ^ 2, by positivity, fun x hx => ?_⟩
    have hrx := hrpos x hx
    obtain ⟨T, hT_def⟩ : ∃ T : ℝ, T = 2 * B / r x := ⟨_, rfl⟩
    have hT : 0 ≤ T := by rw [hT_def]; positivity
    have hb' : ∀ c ∈ F x, ‖fderiv ℝ (φ c) x‖ ≤ T := by
      intro c hc
      have hcr := hrpos c (hZA c.property)
      have hlow := (hnear x c ((hF x hx c).mp hc)).1
      refine (hBb c hcr x).trans ?_
      calc B / r c ≤ B / (r x / 2) := div_le_div_of_nonneg_left hB.le (half_pos hrx) hlow
        _ = T := by rw [hT_def]; ring
    have hcard : ((F x).card : ℝ) ≤ N := by exact_mod_cast hFcard x hx
    have hsum : ‖fderiv ℝ S x‖ ≤ (N : ℝ) * T := by
      rw [hSfd x hx]
      calc ‖∑ c ∈ F x, fderiv ℝ (φ c) x‖ ≤ ∑ c ∈ F x, ‖fderiv ℝ (φ c) x‖ := norm_sum_le _ _
        _ ≤ ∑ _c ∈ F x, T := Finset.sum_le_sum hb'
        _ = ((F x).card : ℝ) * T := by simp
        _ ≤ (N : ℝ) * T := mul_le_mul_of_nonneg_right hcard hT
    have hw' : ∀ c ∈ F x, ‖fderiv ℝ (w c) x‖ ≤ T + (N : ℝ) * T := fun c hc =>
      (hwd_le x hx c).trans (add_le_add (hb' c hc) hsum)
    have hN0 : (0 : ℝ) ≤ N := Nat.cast_nonneg N
    calc ∑ c ∈ F x, ‖fderiv ℝ (w c) x‖ ≤ ∑ _c ∈ F x, (T + (N : ℝ) * T) := Finset.sum_le_sum hw'
      _ = ((F x).card : ℝ) * (T + (N : ℝ) * T) := by rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ (N : ℝ) * (T + (N : ℝ) * T) := mul_le_mul_of_nonneg_right hcard (by positivity)
      _ ≤ ((N : ℝ) + 1) ^ 2 * T := by nlinarith [mul_nonneg (add_nonneg hN0 zero_le_one) hT]
      _ = 2 * B * ((N : ℝ) + 1) ^ 2 / r x := by rw [hT_def]; ring
  -- the affine jets `P b x = h b + D b (x - b)`
  obtain ⟨P, hP⟩ : ∃ P : Euclid n → Euclid n → ℝ, ∀ b x, P b x = h b + D b (x - b) :=
    ⟨_, fun _ _ => rfl⟩
  have hPfun : ∀ b, P b = fun x => h b + D b (x - b) := fun b => funext (hP b)
  have hPc : ∀ b, ContDiff ℝ 1 (P b) := by
    intro b
    rw [hPfun b]
    exact contDiff_const.add ((D b).contDiff.comp (contDiff_id.sub contDiff_const))
  have hPd : ∀ b x, HasFDerivAt (P b) (D b) x := by
    intro b x
    have e := (((D b).hasFDerivAt (x := x)).sub_const (D b b)).const_add (h b)
    have hfun : (fun y => h b + D b (y - b)) = fun y => h b + (D b y - D b b) := by
      funext y
      rw [map_sub]
    rw [hPfun b, hfun]
    exact e
  have hPsub : ∀ a b x,
      ‖P b x - P a x‖ ≤ ‖h b - h a - D a (b - a)‖ + ‖D b - D a‖ * ‖x - b‖ := by
    intro a b x
    have heq : P b x - P a x = (h b - h a - D a (b - a)) + (D b - D a) (x - b) := by
      have hx : x - a = (x - b) + (b - a) := by abel
      simp only [hP, hx, map_add, sub_apply]
      ring
    rw [heq]
    exact (norm_add_le _ _).trans (add_le_add le_rfl ((D b - D a).le_opNorm (x - b)))
  -- nearest points `pr x ∈ A`
  choose pr hprA hprd using fun x => hA.exists_infDist_eq_dist hne x
  have hprle : ∀ x, ∀ a ∈ A, dist x (pr x) ≤ dist x a := by
    intro x a ha
    rw [← hprd x]
    exact infDist_le_dist_of_mem ha
  have hpr2 : ∀ x, ∀ a ∈ A, dist (pr x) a ≤ 2 * dist x a := by
    intro x a ha
    have ht := dist_triangle (pr x) x a
    rw [dist_comm (pr x) x] at ht
    linarith [hprle x a ha]
  have hanc1 : ∀ x ∉ A, ∀ c : Z, c ∈ F x → dist x (pr c) ≤ 2 * infDist x A := by
    intro x hx c hc
    have hd := (hnear x c ((hF x hx c).mp hc)).2.2
    have hr' := hrd x
    have hi := infDist_le_infDist_add_dist (s := A) (x := (c : Euclid n)) (y := x)
    have ht := dist_triangle x (c : Euclid n) (pr c)
    rw [dist_comm (c : Euclid n) x] at hi
    rw [← hprd (c : Euclid n)] at ht
    linarith [infDist_nonneg (x := x) (s := A)]
  have hanc2 : ∀ x ∉ A, ∀ a ∈ A, ∀ c : Z, c ∈ F x → dist (pr c) a ≤ 3 * dist x a := by
    intro x hx a ha c hc
    have hd := hanc1 x hx c hc
    have hi := infDist_le_dist_of_mem (x := x) ha
    have ht := dist_triangle (pr c) x a
    rw [dist_comm (pr c) x] at ht
    linarith
  -- uniform estimates near a point of `A`
  have hloc : ∀ a ∈ A, ∀ η : ℝ, 0 < η → ∃ δ : ℝ, 0 < δ ∧ δ ≤ 1 ∧
      (∀ b ∈ A, dist b a < δ → ‖D b - D a‖ ≤ η) ∧
      ∀ b ∈ A, dist b a < δ → ∀ c ∈ A, dist c a < δ →
        ‖h c - h b - D b (c - b)‖ ≤ η * ‖c - b‖ := by
    intro a ha η hη
    obtain ⟨r₀, hr₀, hrem₀⟩ := hrem (A ∩ closedBall a 1)
      ((isCompact_closedBall a 1).inter_left hA) inter_subset_left η hη
    obtain ⟨η₀, hη₀, hD₀⟩ := Metric.continuousWithinAt_iff.mp (hD a ha) η hη
    have hδ1 : min 1 (min η₀ (r₀ / 3)) ≤ 1 := min_le_left _ _
    have hδη : min 1 (min η₀ (r₀ / 3)) ≤ η₀ := (min_le_right _ _).trans (min_le_left _ _)
    have hδr : min 1 (min η₀ (r₀ / 3)) ≤ r₀ / 3 := (min_le_right _ _).trans (min_le_right _ _)
    refine ⟨min 1 (min η₀ (r₀ / 3)), lt_min one_pos (lt_min hη₀ (by positivity)), hδ1, ?_, ?_⟩
    · intro b hb hba
      simpa only [dist_eq_norm] using (hD₀ hb (hba.trans_le hδη)).le
    · intro b hb hba c hc hca
      apply hrem₀ b ⟨hb, mem_closedBall.mpr (hba.le.trans hδ1)⟩ c hc
      have htri := dist_triangle b a c
      rw [dist_comm a c] at htri
      linarith
  -- convex combinations
  have hconv : ∀ {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G] (s : Finset Z)
      (a : Z → ℝ) (v : Z → G) (b : ℝ), (∀ i ∈ s, 0 ≤ a i) → ∑ i ∈ s, a i = 1 →
      (∀ i ∈ s, ‖v i‖ ≤ b) → ‖∑ i ∈ s, a i • v i‖ ≤ b := by
    intro G _ _ s a v b ha hs hv
    calc ‖∑ i ∈ s, a i • v i‖ ≤ ∑ i ∈ s, ‖a i • v i‖ := norm_sum_le _ _
      _ = ∑ i ∈ s, a i * ‖v i‖ := by
          apply Finset.sum_congr rfl
          intro i hi
          rw [norm_smul, Real.norm_of_nonneg (ha i hi)]
      _ ≤ ∑ i ∈ s, a i * b :=
          Finset.sum_le_sum fun i hi => mul_le_mul_of_nonneg_left (hv i hi) (ha i hi)
      _ = b := by rw [← Finset.sum_mul, hs, one_mul]
  -- the extension: `g = h` on `A` and `g = ∑ w c • P (pr c)` off `A`
  obtain ⟨g, hg⟩ : ∃ g : Euclid n → ℝ, ∀ x,
      g x = if x ∈ A then h x else ∑ᶠ c : Z, w c x * P (pr c) x := ⟨_, fun _ => rfl⟩
  have hgA : ∀ a ∈ A, g a = h a := fun a ha => by rw [hg, ite_eq_left ha]
  have hgnear : ∀ x ∉ A, ∀ y, dist y x < r x → g y = ∑ c ∈ F x, w c y * P (pr c) y := by
    intro x hx y hy
    rw [hg, ite_eq_right (hyA x hx y hy)]
    apply finsum_eq_sum_of_support_subset
    intro c hc
    by_contra hc'
    apply hc
    show w c y * P (pr c) y = 0
    rw [hwzero x hx y hy c hc', zero_mul]
  have hgev : ∀ x ∉ A, g =ᶠ[𝓝 x] fun y => ∑ c ∈ F x, w c y * P (pr c) y := by
    intro x hx
    filter_upwards [ball_mem_nhds x (hrpos x hx)] with y hy
    exact hgnear x hx y hy
  have hgc : ∀ x ∉ A, ContDiffAt ℝ 1 g x := by
    intro x hx
    have hs : ContDiffAt ℝ 1 (fun y => ∑ c ∈ F x, w c y * P (pr c) y) x :=
      ContDiffAt.sum (fun c _ => (hwc c x hx).mul (hPc _).contDiffAt)
    exact hs.congr_of_eventuallyEq (hgev x hx)
  have hgfd : ∀ x ∉ A, fderiv ℝ g x =
      ∑ c ∈ F x, (w c x • D (pr c) + P (pr c) x • fderiv ℝ (w c) x) := by
    intro x hx
    rw [(hgev x hx).fderiv_eq]
    apply HasFDerivAt.fderiv
    apply HasFDerivAt.fun_sum
    intro c _
    exact ((hwc c x hx).differentiableAt one_ne_zero).hasFDerivAt.fun_mul (hPd _ x)
  -- `Dg = D` on `A`
  have hgd : ∀ a ∈ A, HasFDerivAt g (D a) a := by
    intro a ha
    apply HasFDerivAt.of_isLittleO
    apply Asymptotics.IsLittleO.of_bound
    intro ε hε
    have he : 0 < ε / 5 := by positivity
    obtain ⟨δ, hδ, -, hDδ, hremδ⟩ := hloc a ha (ε / 5) he
    have haa : dist a a < δ := by simpa using hδ
    filter_upwards [ball_mem_nhds a (show 0 < δ / 4 by positivity)] with x hx
    have hxa : dist x a < δ / 4 := hx
    rw [hgA a ha]
    by_cases hxA : x ∈ A
    · rw [hgA x hxA]
      have hr' := hremδ a ha haa x hxA (by linarith)
      exact hr'.trans (mul_le_mul_of_nonneg_right (by linarith) (norm_nonneg _))
    · have hxx : dist x x < r x := by simpa using hrpos x hxA
      have hid : g x - h a - D a (x - a) = ∑ c ∈ F x, w c x • (P (pr c) x - P a x) := by
        rw [hgnear x hxA x hxx]
        simp only [smul_eq_mul, mul_sub]
        rw [Finset.sum_sub_distrib, ← Finset.sum_mul, hwsum x hxA x hxx, one_mul, hP a x]
        ring
      rw [hid]
      apply hconv (F x) (fun c => w c x) (fun c => P (pr c) x - P a x) _
        (fun c _ => hw0 c x hxA) (hwsum x hxA x hxx)
      intro c hc
      have hbA := hprA (c : Euclid n)
      have hba := hanc2 x hxA a ha c hc
      have hxb : dist x (pr c) ≤ 2 * dist x a :=
        (hanc1 x hxA c hc).trans
          (mul_le_mul_of_nonneg_left (infDist_le_dist_of_mem ha) (by norm_num))
      have hbaδ : dist (pr c) a < δ := by linarith [dist_nonneg (x := x) (y := a)]
      have hDb := hDδ (pr c) hbA hbaδ
      have hr' := hremδ a ha haa (pr c) hbA hbaδ
      have hba' : ‖pr c - a‖ ≤ 3 * ‖x - a‖ := by simpa only [dist_eq_norm] using hba
      have hxb' : ‖x - pr c‖ ≤ 2 * ‖x - a‖ := by simpa only [dist_eq_norm] using hxb
      calc ‖P (pr c) x - P a x‖
          ≤ ‖h (pr c) - h a - D a (pr c - a)‖ + ‖D (pr c) - D a‖ * ‖x - pr c‖ :=
            hPsub a (pr c) x
        _ ≤ (ε / 5) * ‖pr c - a‖ + (ε / 5) * ‖x - pr c‖ :=
            add_le_add hr' (mul_le_mul_of_nonneg_right hDb (norm_nonneg _))
        _ ≤ (ε / 5) * (3 * ‖x - a‖) + (ε / 5) * (2 * ‖x - a‖) :=
            add_le_add (mul_le_mul_of_nonneg_left hba' he.le)
              (mul_le_mul_of_nonneg_left hxb' he.le)
        _ = ε * ‖x - a‖ := by ring
  -- `Dg` is continuous at the points of `A`
  have hgcont : ∀ a ∈ A, ContinuousAt (fderiv ℝ g) a := by
    intro a ha
    apply Metric.continuousAt_iff.mpr
    intro ε hε
    obtain ⟨η, hη_def⟩ : ∃ η : ℝ, η = ε / (2 * (1 + 700 * M)) := ⟨_, rfl⟩
    have hη : 0 < η := by rw [hη_def]; positivity
    have heq : η * (1 + 700 * M) = ε / 2 := by rw [hη_def]; field_simp
    have hηε : η ≤ ε / 2 := by nlinarith [mul_pos hη hM]
    obtain ⟨δ, hδ, hδ1, hDδ, hremδ⟩ := hloc a ha η hη
    refine ⟨δ / 4, by positivity, fun {x} hxa => ?_⟩
    rw [(hgd a ha).fderiv, dist_eq_norm]
    apply lt_of_le_of_lt (b := ε / 2) ?_ (by linarith)
    by_cases hxA : x ∈ A
    · rw [(hgd x hxA).fderiv]
      exact (hDδ x hxA (by linarith)).trans hηε
    · have hrx := hrpos x hxA
      have hxx : dist x x < r x := by simpa using hrx
      have hbA := hprA x
      have hbaδ : dist (pr x) a < δ := by
        linarith [hpr2 x a ha, dist_nonneg (x := x) (y := a)]
      have hDb := hDδ (pr x) hbA hbaδ
      have hdx : infDist x A ≤ 1 := by
        have hi := infDist_le_dist_of_mem (x := x) ha
        linarith
      have hscale : infDist x A = 100 * r x := by
        rw [hr x, min_eq_right hdx]
        ring
      have hD' : ∀ c ∈ F x, ‖D (pr c) - D a‖ ≤ η := by
        intro c hc
        apply hDδ _ (hprA c)
        have hi := hanc2 x hxA a ha c hc
        linarith [dist_nonneg (x := x) (y := a)]
      have hP' : ∀ c ∈ F x, ‖P (pr c) x - P (pr x) x‖ ≤ 700 * η * r x := by
        intro c hc
        have hdA := hprA (c : Euclid n)
        have hda := hanc2 x hxA a ha c hc
        have hdaδ : dist (pr c) a < δ := by linarith [dist_nonneg (x := x) (y := a)]
        have hxd := hanc1 x hxA c hc
        have hxb : dist x (pr x) = infDist x A := (hprd x).symm
        have hdb : dist (pr c) (pr x) ≤ 3 * infDist x A := by
          have ht := dist_triangle (pr c) x (pr x)
          rw [dist_comm (pr c) x, hxb] at ht
          linarith
        have hDd : ‖D (pr c) - D (pr x)‖ ≤ 2 * η := by
          calc ‖D (pr c) - D (pr x)‖ = ‖(D (pr c) - D a) - (D (pr x) - D a)‖ := by
                congr 1; abel
            _ ≤ ‖D (pr c) - D a‖ + ‖D (pr x) - D a‖ := norm_sub_le _ _
            _ ≤ η + η := add_le_add (hD' c hc) hDb
            _ = 2 * η := by ring
        have hre := hremδ (pr x) hbA hbaδ (pr c) hdA hdaδ
        have hdb' : ‖pr c - pr x‖ ≤ 3 * infDist x A := by
          simpa only [dist_eq_norm] using hdb
        have hxd' : ‖x - pr c‖ ≤ 2 * infDist x A := by simpa only [dist_eq_norm] using hxd
        calc ‖P (pr c) x - P (pr x) x‖
            ≤ ‖h (pr c) - h (pr x) - D (pr x) (pr c - pr x)‖ +
                ‖D (pr c) - D (pr x)‖ * ‖x - pr c‖ := hPsub (pr x) (pr c) x
          _ ≤ η * ‖pr c - pr x‖ + (2 * η) * ‖x - pr c‖ :=
              add_le_add hre (mul_le_mul_of_nonneg_right hDd (norm_nonneg _))
          _ ≤ η * (3 * infDist x A) + (2 * η) * (2 * infDist x A) :=
              add_le_add (mul_le_mul_of_nonneg_left hdb' hη.le)
                (mul_le_mul_of_nonneg_left hxd' (by positivity))
          _ = 700 * η * r x := by rw [hscale]; ring
      have hsplit : fderiv ℝ g x - D a = (∑ c ∈ F x, w c x • (D (pr c) - D a)) +
          ∑ c ∈ F x, (P (pr c) x - P (pr x) x) • fderiv ℝ (w c) x := by
        rw [hgfd x hxA]
        simp_rw [smul_sub, sub_smul]
        rw [Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_sub_distrib,
          ← Finset.sum_smul, ← Finset.smul_sum, hwsum x hxA x hxx, hwdsum x hxA,
          one_smul, smul_zero, sub_zero]
        abel
      rw [hsplit]
      calc ‖(∑ c ∈ F x, w c x • (D (pr c) - D a)) +
            ∑ c ∈ F x, (P (pr c) x - P (pr x) x) • fderiv ℝ (w c) x‖
          ≤ ‖∑ c ∈ F x, w c x • (D (pr c) - D a)‖ +
              ‖∑ c ∈ F x, (P (pr c) x - P (pr x) x) • fderiv ℝ (w c) x‖ := norm_add_le _ _
        _ ≤ η + (700 * η * r x) * ∑ c ∈ F x, ‖fderiv ℝ (w c) x‖ := by
            apply add_le_add
            · exact hconv (F x) (fun c => w c x) (fun c => D (pr c) - D a) η
                (fun c _ => hw0 c x hxA) (hwsum x hxA x hxx) hD'
            · calc ‖∑ c ∈ F x, (P (pr c) x - P (pr x) x) • fderiv ℝ (w c) x‖
                  ≤ ∑ c ∈ F x, ‖(P (pr c) x - P (pr x) x) • fderiv ℝ (w c) x‖ :=
                    norm_sum_le _ _
                _ ≤ ∑ c ∈ F x, (700 * η * r x) * ‖fderiv ℝ (w c) x‖ := by
                    apply Finset.sum_le_sum
                    intro c hc
                    rw [norm_smul]
                    exact mul_le_mul_of_nonneg_right (hP' c hc) (norm_nonneg _)
                _ = (700 * η * r x) * ∑ c ∈ F x, ‖fderiv ℝ (w c) x‖ :=
                    (Finset.mul_sum ..).symm
        _ ≤ η + (700 * η * r x) * (M / r x) :=
            add_le_add le_rfl (mul_le_mul_of_nonneg_left (hMb x hxA) (by positivity))
        _ = η * (1 + 700 * M) := by field_simp
        _ = ε / 2 := heq
  refine ⟨g, ?_, fun a ha => hgA a ha, hgd⟩
  refine contDiff_one_iff_fderiv.mpr ⟨fun x => ?_, continuous_iff_continuousAt.mpr fun x => ?_⟩
  · by_cases hx : x ∈ A
    · exact (hgd x hx).differentiableAt
    · exact (hgc x hx).differentiableAt one_ne_zero
  · by_cases hx : x ∈ A
    · exact hgcont x hx
    · exact (hgc x hx).continuousAt_fderiv one_ne_zero

/-- **`C¹` approximation of Lipschitz functions** (Simon Ch. 2, Theorem 1.5, the part about
values).  If `u : ℝᵐ → ℝ` is `K`-Lipschitz and `ε > 0`, some `G ∈ C¹(ℝᵐ)` agrees with `u` off a
set of measure `< ε`.  By Rademacher's theorem, the Borel set `B` of points where `u` is
differentiable has null complement, and `Du` is Borel.  Lusin's theorem gives a closed `C ⊆ B`,
`Lᵐ(B \ C) < ε / 2`, on which `Du` is continuous.  Egorov's theorem applied to the Whitney
remainders gives a closed `A ⊆ C`, `Lᵐ(C \ A) < ε / 2`, on which `(u, Du)` satisfies Whitney's
condition 1.6(∗).  Whitney's extension theorem gives `G ∈ C¹` with `G = u` on `A`, and
`{u ≠ G} ⊆ Bᶜ ∪ (B \ C) ∪ (C \ A)`. -/
theorem Submission.dor_lmbsf_lipschitz_c1_approx : ∀ (m : ℕ) (u : Euclid m → ℝ) (K : NNReal), LipschitzWith K u → ∀ ε : ℝ≥0∞, 0 < ε → ∃ G : Euclid m → ℝ, ContDiff ℝ 1 G ∧ volume {y | u y ≠ G y} < ε := by
  intro m u K hu ε hε
  -- Rademacher: the Borel set `B` of differentiability points of `u` has null complement
  set B : Set (Euclid m) := {x | DifferentiableAt ℝ u x}
  have hB : MeasurableSet B := measurableSet_of_differentiableAt ℝ u
  have hBc : volume Bᶜ = 0 := ae_iff.mp hu.ae_differentiableAt
  -- Lusin: a closed `C ⊆ B`, `Lᵐ(B \ C) < ε / 2`, on which `Du` is continuous
  obtain ⟨C, hCB, hC, hDC, hBC⟩ := Submission.codim1_rdo_c1a_lusin_isClosed m (fderiv ℝ u) B
    (measurable_fderiv ℝ u) hB (ε / 2) (ENNReal.half_pos hε.ne')
  -- Egorov on the Whitney remainders: a closed `A ⊆ C`, `Lᵐ(C \ A) < ε / 2`, satisfying 1.6(∗)
  obtain ⟨A, hAC, hA, hCA, hrem⟩ := Submission.codim1_rdo_c1a_whitney_remainder m u K C hu hC
    (fun x hx => hCB hx) hDC (ε / 2) (ENNReal.half_pos hε.ne')
  -- Whitney's extension theorem: `G ∈ C¹` with `G = u` on `A`
  obtain ⟨G, hG, hGA, -⟩ := Submission.codim1_rdo_c1a_whitney_extension m A u (fderiv ℝ u) hA
    hu.continuous.continuousOn (hDC.mono hAC) hrem
  refine ⟨G, hG, ?_⟩
  -- `{u ≠ G} ⊆ Aᶜ ⊆ Bᶜ ∪ (B \ C) ∪ (C \ A)`
  calc volume {y | u y ≠ G y} ≤ volume (Bᶜ ∪ ((B \ C) ∪ (C \ A))) := by
        refine measure_mono fun y hy => ?_
        have hyA : y ∉ A := fun hyA => hy (hGA hyA).symm
        by_cases hyB : y ∈ B
        · by_cases hyC : y ∈ C
          · exact Or.inr (Or.inr ⟨hyC, hyA⟩)
          · exact Or.inr (Or.inl ⟨hyB, hyC⟩)
        · exact Or.inl hyB
    _ ≤ volume Bᶜ + (volume (B \ C) + volume (C \ A)) :=
        (measure_union_le _ _).trans (add_le_add le_rfl (measure_union_le _ _))
    _ < ε / 2 + ε / 2 := by
        rw [hBc, zero_add]
        exact ENNReal.add_lt_add hBC hCA
    _ = ε := ENNReal.add_halves ε

/-- **Simon Ch. 3, Lemma 1.2, "only if" part** (chapter-03.txt lines 22–65): a countably
`m`-rectifiable `M ⊆ ℝᴾ` lies in `N₀ ∪ ⋃ₗ Nₗ` with `Hᵐ(N₀) = 0` and each `Nₗ` an embedded
`m`-dimensional `C¹` submanifold.  Write `M ⊆ M₀ ∪ ⋃ⱼ Fⱼ(ℝᵐ)` with `Hᵐ(M₀) = 0` and `Fⱼ`
Lipschitz.  The `C¹` approximation theorem (Simon Ch. 2, Theorem 1.5) gives `C¹` maps `G_{ji}`
with `Fⱼ(ℝᵐ) ⊆ Eⱼ ∪ ⋃ᵢ G_{ji}(ℝᵐ)` and `Hᵐ(Eⱼ) = 0`.  Each `G_{ji}(ℝᵐ)` lies in an `Hᵐ`-null set
`N₀_{ji}` (the critical image, by the area formula) together with countably many submanifolds
`N_{jis}` (images of small balls about regular points).  Take
`N₀ = M₀ ∪ ⋃ⱼ Eⱼ ∪ ⋃_{j,i} N₀_{ji}` and `Nₗ = N_{jis}` for `l = Nat.pair j (Nat.pair i s)`. -/
theorem Submission.dor_lmbsf_rectifiable_c1_cover : ∀ (P m : ℕ) (M : Set (Euclid P)), CountablyRectifiable m M → ∃ (N₀ : Set (Euclid P)) (N : ℕ → Set (Euclid P)), μHE[m] N₀ = 0 ∧ (∀ l, IsEmbeddedSubmanifold 1 m (N l)) ∧ M ⊆ N₀ ∪ ⋃ l, N l := by
  intro P m M hM
  -- Step 1: `M ⊆ M₀ ∪ ⋃ⱼ Fⱼ(ℝᵐ)` with `Hᵐ(M₀) = 0` and `Fⱼ` `Kⱼ`-Lipschitz
  obtain ⟨M₀, hM₀, F, hF, hMF⟩ := hM
  choose K hK using hF
  -- Steps 2–3: `Fⱼ(ℝᵐ) ⊆ Eⱼ ∪ ⋃ᵢ G_{ji}(ℝᵐ)` with `Hᵐ(Eⱼ) = 0` and `G_{ji}` `C¹`
  choose E G hE hG hFG using fun j =>
    Submission.dor_lmbsf_c1c_lipschitz_range_c1_pieces P m (F j) (K j) (hK j)
      (Submission.dor_lmbsf_lipschitz_c1_approx m)
  -- Steps 4–6: `G_{ji}(ℝᵐ) ⊆ N₀_{ji} ∪ ⋃ₛ N_{jis}` with `Hᵐ(N₀_{ji}) = 0` and `N_{jis}`
  -- embedded `C¹` submanifolds
  choose N₀' N' hN₀' hN' hGN using fun j i =>
    Submission.dor_lmbsf_c1c_c1_range_cover P m (G j i) (hG j i)
  -- Step 7: collect the null sets and enumerate the submanifolds by `l = ⟨j, ⟨i, s⟩⟩`
  refine ⟨M₀ ∪ (⋃ j, E j) ∪ ⋃ j, ⋃ i, N₀' j i,
    fun l => N' l.unpair.1 l.unpair.2.unpair.1 l.unpair.2.unpair.2,
    measure_union_null (measure_union_null hM₀ (measure_iUnion_null hE))
      (measure_iUnion_null fun j => measure_iUnion_null (hN₀' j)),
    fun l => hN' _ _ _, ?_⟩
  intro y hy
  rcases hMF hy with hy | hy
  · exact Or.inl (Or.inl (Or.inl hy))
  obtain ⟨j, hj⟩ := mem_iUnion.1 hy
  rcases hFG j hj with hy | hy
  · exact Or.inl (Or.inl (Or.inr (mem_iUnion.2 ⟨j, hy⟩)))
  obtain ⟨i, hi⟩ := mem_iUnion.1 hy
  rcases hGN j i hi with hy | hy
  · exact Or.inl (Or.inr (mem_iUnion₂.2 ⟨j, i, hy⟩))
  obtain ⟨s, hs⟩ := mem_iUnion.1 hy
  refine Or.inr (mem_iUnion.2 ⟨Nat.pair j (Nat.pair i s), ?_⟩)
  simpa only [Nat.unpair_pair] using hs
/-- **Local `C¹` globalization by a bump cutoff** (the cut-off step letting the globally `C¹`
results apply to a map that is only `C¹` on an open set).  Let `W` be open, `χ` be `C¹` on `W`
and `y ∈ W`; choose `B_ρ(y) ⊆ W` and the smooth bump `φ` centred at `y` with `φ = 1` on
`B̄_{ρ/4}(y)` and `tsupport φ = B̄_{ρ/2}(y) ⊆ W`.  Then `g = φ χ` is `C¹` near points of `W`
(product of a `C^∞` and a `C¹` map) and vanishes near points outside `W`, so `g` is `C¹` on
`ℝᵏ`; and `g = χ` on `B_ε(y)`, `ε = ρ/4`. -/
theorem Submission.dor_lmbsf_cit_c1_local_extension : ∀ (P k : ℕ) (W : Set (Euclid k)) (χ : Euclid k → Euclid P) (y : Euclid k), IsOpen W → ContDiffOn ℝ 1 χ W → y ∈ W → ∃ (g : Euclid k → Euclid P) (ε : ℝ), 0 < ε ∧ ball y ε ⊆ W ∧ ContDiff ℝ 1 g ∧ EqOn g χ (ball y ε) := by
  intro P k W χ y hW hχ hy
  -- Step 1, a ball `B_ρ(y) ⊆ W`.
  obtain ⟨ρ, hρ, hball⟩ := Metric.isOpen_iff.1 hW y hy
  -- Step 2, the bump `φ`: `φ = 1` on `B̄_{ρ/4}(y)` and `tsupport φ = B̄_{ρ/2}(y) ⊆ W`.
  let φ : ContDiffBump y := ⟨ρ / 4, ρ / 2, by positivity, by linarith⟩
  have hsupp : tsupport φ ⊆ W := by
    rw [φ.tsupport_eq]
    exact (closedBall_subset_ball (by change ρ / 2 < ρ; linarith)).trans hball
  -- Step 3, `g = φ χ` and `ε = ρ/4`, so `B_ε(y) ⊆ W`.
  refine ⟨fun x => φ x • χ x, ρ / 4, by positivity,
    (ball_subset_ball (by linarith)).trans hball, ?_, fun x hx => ?_⟩
  · -- Steps 4–6, `g` is `C¹` at every point.
    refine contDiff_iff_contDiffAt.2 fun x => ?_
    by_cases hx : x ∈ W
    · -- Step 4, on `W`, `g` is the product of the `C^∞` map `φ` and the `C¹` map `χ`.
      exact φ.contDiffAt.fun_smul (hχ.contDiffAt (hW.mem_nhds hx))
    · -- Step 5, off `W`, `x ∉ tsupport φ` and `g = 0` near `x`.
      refine (contDiffAt_const (c := (0 : Euclid P))).congr_of_eventuallyEq ?_
      filter_upwards [(isClosed_tsupport φ).compl_mem_nhds fun h => hx (hsupp h)] with z hz
      rw [image_eq_zero_of_notMem_tsupport hz, zero_smul]
  · -- `φ = 1` on `B_ε(y) ⊆ B̄_{ρ/4}(y)`, so `g = χ` there.
    change φ x • χ x = χ x
    rw [φ.one_of_mem_closedBall (ball_subset_closedBall hx), one_smul]
/-- **Simon Ch. 3, Lemma 1.2** (the inverse-function step of the "only if" part): if `G` is `C¹`
and `DG(x)` is injective, then `μ |a − b| ≤ |G(a) − G(b)|` on some ball `B_δ(x)`.  With
`|v| ≤ K |DG(x) v|` and `μ = 1/(2K)`, strict differentiability gives
`|G(a) − G(b) − DG(x)(a − b)| ≤ μ |a − b|` near `x`, so `|G(a) − G(b)| ≥ 2μ|a − b| − μ|a − b|`. -/
theorem Submission.codim1_rdo_c1cov_local_lower_lipschitz : ∀ (P n : ℕ) (G : Euclid n → Euclid P) (x : Euclid n), ContDiff ℝ 1 G → Injective (fderiv ℝ G x) → ∃ δ μ : ℝ, 0 < δ ∧ 0 < μ ∧ ∀ a ∈ ball x δ, ∀ b ∈ ball x δ, μ * ‖a - b‖ ≤ ‖G a - G b‖ := by
  intro P n G x hG hinj
  -- `L = DG(x)` is injective on the finite-dimensional `ℝⁿ`: `‖v‖ ≤ K ‖L v‖`
  obtain ⟨K, hK, hKL⟩ := (fderiv ℝ G x).injective_iff_antilipschitz.mp hinj
  have hbound : ∀ v, ‖v‖ ≤ K * ‖fderiv ℝ G x v‖ :=
    (fderiv ℝ G x).bound_of_antilipschitz hKL
  -- `μ = 1/(2K)`, so `‖L v‖ ≥ 2μ ‖v‖`
  set μ : ℝ := (2 * K)⁻¹ with hμ
  have hK' : (0 : ℝ) < K := hK
  have hμ0 : 0 < μ := by positivity
  -- `G` is `C¹`, so `L` is a strict derivative: `G` approximates `L` with constant `μ` near `x`
  obtain ⟨s, hs, hGs⟩ := (hG.contDiffAt.hasStrictFDerivAt one_ne_zero).approximates_deriv_on_nhds
    (c := ⟨μ, hμ0.le⟩) (Or.inr hμ0)
  obtain ⟨δ, hδ, hδs⟩ := Metric.mem_nhds_iff.mp hs
  refine ⟨δ, μ, hδ, hμ0, fun a ha b hb => ?_⟩
  have h1 : ‖G a - G b - fderiv ℝ G x (a - b)‖ ≤ μ * ‖a - b‖ := hGs a (hδs ha) b (hδs hb)
  have h2 : 2 * μ * ‖a - b‖ ≤ ‖fderiv ℝ G x (a - b)‖ := by
    calc 2 * μ * ‖a - b‖ ≤ 2 * μ * (K * ‖fderiv ℝ G x (a - b)‖) := by
          gcongr
          exact hbound (a - b)
      _ = ‖fderiv ℝ G x (a - b)‖ := by
          rw [hμ]
          field_simp
  -- triangle inequality: `‖L (a - b)‖ ≤ ‖G a - G b‖ + ‖G a - G b - L (a - b)‖`
  have h3 : ‖fderiv ℝ G x (a - b)‖ ≤ ‖G a - G b‖ + ‖G a - G b - fderiv ℝ G x (a - b)‖ := by
    simpa using norm_sub_le (G a - G b) (G a - G b - fderiv ℝ G x (a - b))
  linarith
/-- A lower Lipschitz bound at a point passes to the derivative (step 1 of the `C¹`-piece tangent
argument, Simon Ch. 3, 1.6): if `U` is open, `a ∈ U`, `g` is differentiable at `a` and
`m|x − a| ≤ |g(x) − g(a)|` on `U`, then `m|v| ≤ |Dg(a)v|`.  For small `t > 0`, `a + tv ∈ U`
gives `m|v| ≤ |t⁻¹(g(a + tv) − g(a))|`, and the quotients tend to `Dg(a)v` as `t ↓ 0`. -/
theorem Submission.codim1_rdo_c1pt_fderiv_lower_bound : ∀ (P n : ℕ) (g : Euclid n → Euclid P) (U : Set (Euclid n)) (a : Euclid n) (m : ℝ), IsOpen U → a ∈ U → DifferentiableAt ℝ g a → (∀ x ∈ U, m * ‖x - a‖ ≤ ‖g x - g a‖) → ∀ v : Euclid n, m * ‖v‖ ≤ ‖fderiv ℝ g a v‖ := by
  intro P n g U a m hU ha hg hm v
  -- difference quotients `q(t) = t⁻¹ • (g (a + t • v) - g a)` tend to `Dg(a) v` as `t ↓ 0`
  have hq : Tendsto (fun t : ℝ => t⁻¹ • (g (a + t • v) - g a)) (𝓝[>] 0)
      (𝓝 (fderiv ℝ g a v)) := by
    simpa only [inv_inv] using hg.hasFDerivAt.lim v (c := fun t : ℝ => t⁻¹)
      (tendsto_norm_atTop_atTop.comp tendsto_inv_nhdsGT_zero)
  -- `a + t • v → a` as `t → 0`, so `a + t • v ∈ U` for small `t` (`U` is a neighbourhood of `a`)
  have hline : Tendsto (fun t : ℝ => a + t • v) (𝓝 0) (𝓝 a) :=
    (continuous_const.add (continuous_id.smul continuous_const)).tendsto' 0 a (by simp)
  -- for small `t > 0`: `t * (m‖v‖) ≤ ‖g (a + t • v) - g a‖`, i.e. `m‖v‖ ≤ ‖q(t)‖`
  have hle : ∀ᶠ t in 𝓝[>] (0 : ℝ), m * ‖v‖ ≤ ‖t⁻¹ • (g (a + t • v) - g a)‖ := by
    filter_upwards [nhdsWithin_le_nhds (hline (hU.mem_nhds ha)), self_mem_nhdsWithin]
      with t htU ht
    have ht : (0 : ℝ) < t := ht
    have h := hm _ htU
    rw [add_sub_cancel_left, norm_smul, Real.norm_of_nonneg ht.le, mul_left_comm] at h
    rwa [norm_smul, Real.norm_of_nonneg (inv_nonneg.2 ht.le), le_inv_mul_iff₀ ht]
  -- the non-strict inequality passes to the limit along the nontrivial filter `𝓝[>] 0`
  exact ge_of_tendsto hq.norm hle
/-- **Simon Ch. 2, (3.2) and (3.5)** (area formula for the blow-ups of an injective regular
image): if `g` is differentiable on the Borel set `B`, injective on `B` and `Dg(a)` is injective
for `a ∈ B`, then for `s > 0`, every `z` and every `f`,
`∫_{η_{g(z),s}(g(B))} f dHⁿ = ∫_{B_s} J_g(z + s b) f(s⁻¹(g(z + s b) − g(z))) dLⁿ(b)`, where
`B_s = {b | z + s b ∈ B}` and `J_g = √det(Dg* ∘ Dg)`.  The rescaled map
`φ(b) = s⁻¹(g(z + s b) − g(z))` is injective on `B_s` with `Dφ(b) = Dg(z + s b)` and
`φ(B_s) = η_{g(z),s}(g(B))`, so this is the area formula for `φ`.  That formula is proved in
place: the linear case (3.1), sharp `Hⁿ` estimates for maps close to an injective linear map,
a measurable partition into such pieces, and the transport of the Jacobian-weighted measure,
following the pinned SimonGMT `Chapter02.AreaApproximation`, `AreaDerivative`, `AreaFormula`
and `WeightedArea` proofs, which lie outside this file's imports. -/
theorem Submission.codim1_rdo_c1pt_rescaled_area_formula : ∀ (P n : ℕ) (g : Euclid n → Euclid P) (B : Set (Euclid n)) (z : Euclid n) (s : ℝ) (f : Euclid P → ℝ), MeasurableSet B → (∀ a ∈ B, DifferentiableAt ℝ g a) → InjOn g B → (∀ a ∈ B, Injective (fderiv ℝ g a)) → 0 < s → ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap (g z) s '' (g '' B), f y ∂μHE[n] = ∫ b in {b : Euclid n | z + s • b ∈ B}, Real.sqrt (((fderiv ℝ g (z + s • b)).adjoint ∘L fderiv ℝ g (z + s • b)).det) * f (s⁻¹ • (g (z + s • b) - g z)) := by
  intro P n g B z s f hB hdiff hinj hreg hs
  classical
  -- `J(L) = √det(L* ∘ L)` is the metric Jacobian of a linear map `L : ℝⁿ → ℝᴾ`
  obtain ⟨J, hJdef⟩ : ∃ J : (Euclid n →L[ℝ] Euclid P) → ℝ,
      J = fun L => Real.sqrt ((L.adjoint ∘L L).det) := ⟨_, rfl⟩
  have hJnonneg : ∀ L, 0 ≤ J L := fun L => by rw [hJdef]; exact Real.sqrt_nonneg _
  have hJcont : Continuous J := by
    rw [hJdef]
    exact Real.continuous_sqrt.comp (ContinuousLinearMap.continuous_det.comp
      (Continuous.clm_comp ContinuousLinearMap.adjoint.continuous continuous_id))
  /- Simon (3.1), the linear area formula: an injective `L` factors as `ι ∘ M` with `ι` a
  linear isometry onto its range and `M` an endomorphism of `ℝⁿ`, so
  `Hⁿ(L(A)) = Lⁿ(M(A)) = |det M| Lⁿ(A)`, and `J(L)² = det(M* M) = (det M)² ≠ 0`. -/
  have hlin : ∀ L : Euclid n →L[ℝ] Euclid P, Injective L →
      0 < J L ∧ ∀ A : Set (Euclid n), μHE[n] (L '' A) = ENNReal.ofReal (J L) * volume A := by
    intro L hL
    have hV : Module.finrank ℝ (LinearMap.range (L : Euclid n →ₗ[ℝ] Euclid P)) = n := by
      rw [LinearMap.finrank_range_of_inj hL, finrank_euclideanSpace_fin]
    let e : LinearMap.range (L : Euclid n →ₗ[ℝ] Euclid P) ≃ₗᵢ[ℝ] Euclid n :=
      ((stdOrthonormalBasis ℝ _).reindex (finCongr hV)).repr
    let ιI : Euclid n →ₗᵢ[ℝ] Euclid P :=
      (LinearMap.range (L : Euclid n →ₗ[ℝ] Euclid P)).subtypeₗᵢ.comp e.symm.toLinearIsometry
    let M : Euclid n →L[ℝ] Euclid n := (e : _ →L[ℝ] Euclid n) ∘L L.rangeRestrict
    have hLιM : L = ιI.toContinuousLinearMap ∘L M := by
      ext1 x
      show L x = ((e.symm (e (L.rangeRestrict x)) :
        LinearMap.range (L : Euclid n →ₗ[ℝ] Euclid P)) : Euclid P)
      rw [LinearIsometryEquiv.symm_apply_apply]
      rfl
    have hιadj : ιI.toContinuousLinearMap.adjoint ∘L ιI.toContinuousLinearMap = 1 :=
      (ContinuousLinearMap.norm_map_iff_adjoint_comp_self _).mp ιI.norm_map
    have hdetadj : (ContinuousLinearMap.adjoint M).det = M.det := by
      have h := congrArg Matrix.det (LinearMap.toMatrix_adjoint (EuclideanSpace.basisFun (Fin n) ℝ)
        (EuclideanSpace.basisFun (Fin n) ℝ) (M : Euclid n →ₗ[ℝ] Euclid n))
      rw [Matrix.det_conjTranspose, LinearMap.det_toMatrix, LinearMap.det_toMatrix] at h
      simp only [star_trivial] at h
      exact h
    have hdet : (L.adjoint ∘L L).det = M.det ^ 2 := by
      have h1 : L.adjoint ∘L L = M.adjoint ∘L M := by
        rw [hLιM, ContinuousLinearMap.adjoint_comp, ContinuousLinearMap.comp_assoc,
          ← ContinuousLinearMap.comp_assoc _ _ M, hιadj, ContinuousLinearMap.one_def,
          ContinuousLinearMap.id_comp]
      have h2 : (M.adjoint ∘L M).det = M.adjoint.det * M.det :=
        LinearMap.det_comp _ _
      rw [h1, h2, hdetadj, sq]
    have hJ : J L = |M.det| := by
      rw [hJdef]
      dsimp only
      rw [hdet, Real.sqrt_sq_eq_abs]
    have hMinj : LinearMap.ker (M : Euclid n →ₗ[ℝ] Euclid n) = ⊥ := by
      rw [LinearMap.ker_eq_bot]
      intro x y hxy
      apply hL
      have h := congrArg (fun v => ((e.symm v : LinearMap.range (L : Euclid n →ₗ[ℝ] Euclid P)) :
        Euclid P)) hxy
      simpa [M] using h
    refine ⟨?_, fun A => ?_⟩
    · rw [hJ]
      exact abs_pos.mpr (fun h => (LinearMap.det_eq_zero_iff_ker_ne_bot.mp h) hMinj)
    · rw [hJ, hLιM, ContinuousLinearMap.coe_comp, Set.image_comp,
        LinearIsometry.coe_toContinuousLinearMap, ιI.isometry.euclideanHausdorffMeasure_image,
        EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
      exact MeasureTheory.Measure.addHaar_image_linearMap volume (M : Euclid n →ₗ[ℝ] Euclid n) A
  -- comparison of pairwise distances gives comparison of the `Hⁿ` measures of the images
  have hdistcmp : ∀ (u v : Euclid n → Euclid P) (T : Set (Euclid n)) (K : NNReal), InjOn v T →
      (∀ x ∈ T, ∀ y ∈ T, dist (u x) (u y) ≤ K * dist (v x) (v y)) →
      μHE[n] (u '' T) ≤ (K : ℝ≥0∞) ^ n * μHE[n] (v '' T) := by
    intro u v T K hv hK
    have hh : LipschitzOnWith K (u ∘ invFunOn v T) (v '' T) := by
      rw [lipschitzOnWith_iff_dist_le_mul]
      rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
      simpa only [comp_apply, hv.leftInvOn_invFunOn hx, hv.leftInvOn_invFunOn hy] using hK x hx y hy
    have himage : (u ∘ invFunOn v T) '' (v '' T) = u '' T := by
      rw [image_comp, hv.invFunOn_image Subset.rfl]
    simpa only [himage] using
      Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n hh
  /- Near an injective `L`, one radius `δ` controls both the Jacobian of nearby linear maps and
  the `Hⁿ` measure of images under maps `δ`-approximating `L`, up to a factor `q > 1`. -/
  have hradius : ∀ L : Euclid n →L[ℝ] Euclid P, Injective L → ∀ q : NNReal, 1 < q →
      ∃ δ : NNReal, 0 < δ ∧
        (∀ L' : Euclid n →L[ℝ] Euclid P, ‖L' - L‖ ≤ δ →
          ENNReal.ofReal (J L') ≤ q * ENNReal.ofReal (J L) ∧
            ENNReal.ofReal (J L) ≤ q * ENNReal.ofReal (J L')) ∧
        (∀ (T : Set (Euclid n)) (u : Euclid n → Euclid P), ApproximatesLinearOn u L T δ →
          μHE[n] (u '' T) ≤ q * μHE[n] (L '' T) ∧ μHE[n] (L '' T) ≤ q * μHE[n] (u '' T)) := by
    intro L hL q hq
    obtain ⟨K, -, hK⟩ := (L : Euclid n →ₗ[ℝ] Euclid P).exists_antilipschitzWith
      (LinearMap.ker_eq_bot.mpr hL)
    have hqR : (1 : ℝ) < q := hq
    have hJpos := (hlin L hL).1
    have hmul : J L < (q : ℝ) * J L := lt_mul_of_one_lt_left hJpos hqR
    have hnear : ∀ᶠ L' in 𝓝 L, J L' < (q : ℝ) * J L ∧ J L < (q : ℝ) * J L' :=
      (hJcont.continuousAt.eventually_lt continuousAt_const hmul).and
        (continuousAt_const.eventually_lt (continuousAt_const.mul hJcont.continuousAt) hmul)
    obtain ⟨ε, hε, hnear⟩ := Metric.eventually_nhds_iff.mp hnear
    have hsmall : ∀ᶠ δ : NNReal in 𝓝 0, δ * K < 1 :=
      (continuousAt_id.mul continuousAt_const).eventually_lt continuousAt_const (by simp)
    have hupper : ∀ᶠ δ : NNReal in 𝓝 0, (1 + δ * K) ^ n < q :=
      ((continuousAt_const.add (continuousAt_id.mul continuousAt_const)).pow _).eventually_lt
        continuousAt_const (by simpa using hq)
    have hlower : ∀ᶠ δ : NNReal in 𝓝 0, ((1 - δ * K)⁻¹) ^ n < q := by
      apply ContinuousAt.eventually_lt _ continuousAt_const (by simpa using hq)
      apply ContinuousAt.pow
      apply ContinuousAt.inv₀
      · exact continuousAt_const.sub (continuousAt_id.mul continuousAt_const)
      · simp
    have hεev : ∀ᶠ δ : NNReal in 𝓝 0, (δ : ℝ) < ε :=
      (NNReal.continuous_coe.continuousAt.eventually_lt continuousAt_const (by simpa using hε))
    have hevent : ∀ᶠ δ : NNReal in 𝓝[>] 0,
        0 < δ ∧ δ * K < 1 ∧ (1 + δ * K) ^ n < q ∧ ((1 - δ * K)⁻¹) ^ n < q ∧ (δ : ℝ) < ε := by
      filter_upwards [self_mem_nhdsWithin, hsmall.filter_mono nhdsWithin_le_nhds,
        hupper.filter_mono nhdsWithin_le_nhds, hlower.filter_mono nhdsWithin_le_nhds,
        hεev.filter_mono nhdsWithin_le_nhds] with δ hδ h1 h2 h3 h4
      exact ⟨hδ, h1, h2, h3, h4⟩
    obtain ⟨δ, hδ, hδK, hδupper, hδlower, hδε⟩ := hevent.exists
    -- `‖(u x - u y) - L(x - y)‖ ≤ δ K ‖L x - L y‖` on `T`
    have herror : ∀ (T : Set (Euclid n)) (u : Euclid n → Euclid P),
        ApproximatesLinearOn u L T δ → ∀ x ∈ T, ∀ y ∈ T,
          ‖u x - u y - (L x - L y)‖ ≤ (δ : ℝ) * K * ‖L x - L y‖ := by
      intro T u hu x hx y hy
      have hb : ‖x - y‖ ≤ K * ‖L x - L y‖ := by
        simpa only [dist_eq_norm, ContinuousLinearMap.coe_coe] using hK.le_mul_dist x y
      calc ‖u x - u y - (L x - L y)‖ ≤ δ * ‖x - y‖ := by simpa only [map_sub] using hu x hx y hy
        _ ≤ δ * (K * ‖L x - L y‖) := mul_le_mul_of_nonneg_left hb δ.2
        _ = (δ : ℝ) * K * ‖L x - L y‖ := by ring
    refine ⟨δ, hδ, fun L' hL' => ?_, fun T u hu => ⟨?_, ?_⟩⟩
    · have hdist : dist L' L < ε := by
        rw [dist_eq_norm]
        exact hL'.trans_lt hδε
      obtain ⟨h1, h2⟩ := hnear hdist
      constructor
      · rw [← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_mul (NNReal.coe_nonneg q)]
        exact ENNReal.ofReal_le_ofReal h1.le
      · rw [← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_mul (NNReal.coe_nonneg q)]
        exact ENNReal.ofReal_le_ofReal h2.le
    · refine (hdistcmp u L T (1 + δ * K) hL.injOn fun x hx y hy => ?_).trans ?_
      · simp only [dist_eq_norm, NNReal.coe_add, NNReal.coe_one, NNReal.coe_mul]
        calc ‖u x - u y‖ ≤ ‖u x - u y - (L x - L y)‖ + ‖L x - L y‖ := norm_le_norm_sub_add _ _
          _ ≤ (δ : ℝ) * K * ‖L x - L y‖ + ‖L x - L y‖ :=
            add_le_add (herror T u hu x hx y hy) le_rfl
          _ = (1 + (δ : ℝ) * K) * ‖L x - L y‖ := by ring
      · gcongr
        rw [← ENNReal.coe_pow]
        exact ENNReal.coe_le_coe.mpr hδupper.le
    · have hδR : (δ : ℝ) * K < 1 := hδK
      have hdist : ∀ x ∈ T, ∀ y ∈ T,
          dist (L x) (L y) ≤ ((1 - δ * K)⁻¹ : NNReal) * dist (u x) (u y) := by
        intro x hx y hy
        have h1 := herror T u hu x hx y hy
        have htriangle := norm_le_norm_add_norm_sub (u x - u y) (L x - L y)
        rw [dist_eq_norm, dist_eq_norm, NNReal.coe_inv, NNReal.coe_sub hδK.le, NNReal.coe_one,
          NNReal.coe_mul, inv_mul_eq_div, le_div_iff₀ (sub_pos.mpr hδR)]
        linarith only [h1, htriangle]
      have huinj : InjOn u T := by
        intro x hx y hy hxy
        apply hL
        apply dist_le_zero.mp
        simpa only [hxy, dist_self, mul_zero] using hdist x hx y hy
      refine (hdistcmp L u T _ huinj hdist).trans ?_
      gcongr
      rw [← ENNReal.coe_pow]
      exact ENNReal.coe_le_coe.mpr hδlower.le
  /- On almost every point of a measurable piece where `u` is `δ`-approximated by `A`, the
  derivative is `δ`-close to `A` (the density-point argument of Mathlib's
  `ApproximatesLinearOn.norm_fderiv_sub_le`, for rectangular derivatives). -/
  have hderivbound : ∀ (u : Euclid n → Euclid P) (T : Set (Euclid n)) (A : Euclid n →L[ℝ] Euclid P)
      (δ : NNReal) (u' : Euclid n → Euclid n →L[ℝ] Euclid P), ApproximatesLinearOn u A T δ →
      MeasurableSet T → (∀ x ∈ T, HasFDerivWithinAt u (u' x) T x) →
      ∀ᵐ x ∂(volume.restrict T), ‖u' x - A‖₊ ≤ δ := by
    intro u T A δ u' hf hT hf'
    filter_upwards [Besicovitch.ae_tendsto_measure_inter_div volume T, ae_restrict_mem hT]
    intro x hx xT
    apply ContinuousLinearMap.opNorm_le_bound _ δ.2 fun w => ?_
    suffices H : ∀ ε, 0 < ε → ‖(u' x - A) w‖ ≤ (δ + ε) * (‖w‖ + ε) + ‖u' x - A‖ * ε by
      have : Tendsto (fun ε : ℝ => ((δ : ℝ) + ε) * (‖w‖ + ε) + ‖u' x - A‖ * ε) (𝓝[>] 0)
          (𝓝 ((δ + 0) * (‖w‖ + 0) + ‖u' x - A‖ * 0)) :=
        Tendsto.mono_left (Continuous.tendsto (by fun_prop) 0) nhdsWithin_le_nhds
      simp only [add_zero, mul_zero] at this
      apply le_of_tendsto_of_tendsto tendsto_const_nhds this
      filter_upwards [self_mem_nhdsWithin]
      exact H
    intro ε εpos
    have B₁ := MeasureTheory.Measure.eventually_nonempty_inter_smul_of_density_one volume T x hx
      (closedBall w ε) measurableSet_closedBall (measure_closedBall_pos volume w εpos).ne'
    obtain ⟨ρ, ρpos, hρ⟩ :
        ∃ ρ > 0, ball x ρ ∩ T ⊆ {y : Euclid n | ‖u y - u x - (u' x) (y - x)‖ ≤ ε * ‖y - x‖} :=
      mem_nhdsWithin_iff.1 (Asymptotics.isLittleO_iff.mp (hf' x xT).isLittleO εpos)
    have B₂ := (eventually_singleton_add_smul_subset (𝕜 := ℝ) (x := x)
      (isBounded_closedBall (x := w) (r := ε)) (ball_mem_nhds x ρpos)).filter_mono
        (nhdsWithin_le_nhds (s := Ioi (0 : ℝ)))
    obtain ⟨r, ⟨y, ⟨yT, hy⟩⟩, rρ, rpos⟩ := (B₁.and (B₂.and self_mem_nhdsWithin)).exists
    obtain ⟨a, aw, ya⟩ : ∃ a, a ∈ closedBall w ε ∧ y = x + r • a := by
      have hy' := hy
      simp only [mem_smul_set, image_add_left, mem_preimage, singleton_add] at hy'
      rcases hy' with ⟨a, aw, ha⟩
      exact ⟨a, aw, by simp only [ha, add_neg_cancel_left]⟩
    have norm_a : ‖a‖ ≤ ‖w‖ + ε :=
      calc ‖a‖ = ‖w + (a - w)‖ := by simp only [add_sub_cancel]
        _ ≤ ‖w‖ + ‖a - w‖ := norm_add_le _ _
        _ ≤ ‖w‖ + ε := by grw [mem_closedBall_iff_norm.1 aw]
    have I : r * ‖(u' x - A) a‖ ≤ r * (δ + ε) * (‖w‖ + ε) :=
      calc r * ‖(u' x - A) a‖ = ‖(u' x - A) (r • a)‖ := by
            simp only [map_smul, norm_smul, Real.norm_eq_abs, abs_of_nonneg rpos.le]
        _ = ‖u y - u x - A (y - x) - (u y - u x - (u' x) (y - x))‖ := by
            simp only [ya, add_sub_cancel_left, sub_sub_sub_cancel_left, FunLike.coe_sub,
              Pi.sub_apply, map_smul, smul_sub]
        _ ≤ ‖u y - u x - A (y - x)‖ + ‖u y - u x - (u' x) (y - x)‖ := norm_sub_le _ _
        _ ≤ δ * ‖y - x‖ + ε * ‖y - x‖ := add_le_add (hf _ yT _ xT) (hρ ⟨rρ hy, yT⟩)
        _ = r * (δ + ε) * ‖a‖ := by
            simp only [ya, add_sub_cancel_left, norm_smul, Real.norm_eq_abs, abs_of_nonneg rpos.le]
            ring
        _ ≤ r * (δ + ε) * (‖w‖ + ε) := by gcongr
    calc ‖(u' x - A) w‖ = ‖(u' x - A) a + (u' x - A) (w - a)‖ := by
          congr 1
          simp only [FunLike.coe_sub, map_sub, Pi.sub_apply]
          abel
      _ ≤ ‖(u' x - A) a‖ + ‖(u' x - A) (w - a)‖ := norm_add_le _ _
      _ ≤ (δ + ε) * (‖w‖ + ε) + ‖u' x - A‖ * ‖w - a‖ := by
          apply add_le_add
          · rw [mul_assoc] at I
            exact (mul_le_mul_iff_right₀ rpos).1 I
          · apply ContinuousLinearMap.le_opNorm
      _ ≤ (δ + ε) * (‖w‖ + ε) + ‖u' x - A‖ * ε := by
          rw [mem_closedBall_iff_norm'] at aw
          gcongr
  /- Simon (3.2), measure form: for `u` injective on a measurable `T`, differentiable along `T`
  with injective derivative `u'`, `Hⁿ(u(T)) = ∫_T J(u'(x)) dLⁿ(x)`.  Partition `T` into
  measurable pieces on which `u` is close to linear maps `A i = u'(yᵢ)`, compare on each piece
  up to a factor `q²`, sum, and let `q ↓ 1`. -/
  have hmeasure : ∀ (T : Set (Euclid n)) (u : Euclid n → Euclid P)
      (u' : Euclid n → Euclid n →L[ℝ] Euclid P), MeasurableSet T →
      (∀ x ∈ T, HasFDerivWithinAt u (u' x) T x) → (∀ x ∈ T, Injective (u' x)) → InjOn u T →
      μHE[n] (u '' T) = ∫⁻ x in T, ENNReal.ofReal (J (u' x)) := by
    intro T u u' hT hu' hreg' hinj'
    have hcmp : ∀ q : NNReal, 1 < q →
        μHE[n] (u '' T) ≤ (q : ℝ≥0∞) ^ 2 * ∫⁻ x in T, ENNReal.ofReal (J (u' x)) ∧
          ∫⁻ x in T, ENNReal.ofReal (J (u' x)) ≤ (q : ℝ≥0∞) ^ 2 * μHE[n] (u '' T) := by
      intro q hq
      rcases eq_empty_or_nonempty T with rfl | hTne
      · simp
      have hchoice : ∀ L : Euclid n →L[ℝ] Euclid P, ∃ δ : NNReal, 0 < δ ∧ (Injective L →
          (∀ L' : Euclid n →L[ℝ] Euclid P, ‖L' - L‖ ≤ δ →
            ENNReal.ofReal (J L') ≤ q * ENNReal.ofReal (J L) ∧
              ENNReal.ofReal (J L) ≤ q * ENNReal.ofReal (J L')) ∧
          (∀ (T' : Set (Euclid n)) (v : Euclid n → Euclid P), ApproximatesLinearOn v L T' δ →
            μHE[n] (v '' T') ≤ q * μHE[n] (L '' T') ∧
              μHE[n] (L '' T') ≤ q * μHE[n] (v '' T'))) := by
        intro L
        by_cases hL : Injective L
        · obtain ⟨δ, hδ, h1, h2⟩ := hradius L hL q hq
          exact ⟨δ, hδ, fun _ => ⟨h1, h2⟩⟩
        · exact ⟨1, one_pos, fun h => (hL h).elim⟩
      choose δ hδpos hδ using hchoice
      obtain ⟨t, A, hdisj, ht, hcover, happrox, hactual⟩ :=
        exists_partition_approximatesLinearOn_of_hasFDerivWithinAt u T u' hu' δ
          (fun L => (hδpos L).ne')
      have hAreg : ∀ i, Injective (A i) := by
        intro i
        obtain ⟨x, hx, hA⟩ := hactual hTne i
        rw [hA]
        exact hreg' x hx
      have hTeq : T = ⋃ i, T ∩ t i := by
        rw [← inter_iUnion]
        exact Subset.antisymm (subset_inter Subset.rfl hcover) inter_subset_left
      have hsumimage : μHE[n] (u '' T) = ∑' i, μHE[n] (u '' (T ∩ t i)) := by
        conv_lhs => rw [hTeq, image_iUnion]
        apply measure_iUnion
        · intro i j hij
          exact Disjoint.image (Disjoint.mono inter_subset_right inter_subset_right (hdisj hij))
            hinj' inter_subset_left inter_subset_left
        · intro i
          apply (hT.inter (ht i)).image_of_continuousOn_injOn
          · exact fun x hx => (hu' x hx.1).continuousWithinAt.mono inter_subset_left
          · exact hinj'.mono inter_subset_left
      have hsumintegral : ∫⁻ x in T, ENNReal.ofReal (J (u' x)) =
          ∑' i, ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x)) := by
        conv_lhs => rw [hTeq]
        exact lintegral_iUnion (fun i => hT.inter (ht i))
          (pairwise_disjoint_mono hdisj (fun _ => inter_subset_right)) _
      have hpiece : ∀ i, μHE[n] (u '' (T ∩ t i)) ≤
            (q : ℝ≥0∞) ^ 2 * ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x)) ∧
          ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x)) ≤
            (q : ℝ≥0∞) ^ 2 * μHE[n] (u '' (T ∩ t i)) := by
        intro i
        have hJ := (hδ (A i) (hAreg i)).1
        obtain ⟨harea_upper, harea_lower⟩ := (hδ (A i) (hAreg i)).2 (T ∩ t i) u (happrox i)
        have hlinA := (hlin (A i) (hAreg i)).2 (T ∩ t i)
        rw [hlinA] at harea_upper harea_lower
        have hderiv := hderivbound u (T ∩ t i) (A i) (δ (A i)) u' (happrox i) (hT.inter (ht i))
          (fun x hx => (hu' x hx.1).mono inter_subset_left)
        have hJupper : ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x)) ≤
            q * (ENNReal.ofReal (J (A i)) * volume (T ∩ t i)) := by
          calc ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x))
              ≤ ∫⁻ _ in T ∩ t i, (q : ℝ≥0∞) * ENNReal.ofReal (J (A i)) := by
                apply lintegral_mono_ae
                filter_upwards [hderiv] with x hx
                exact (hJ (u' x) hx).1
            _ = q * (ENNReal.ofReal (J (A i)) * volume (T ∩ t i)) := by
                rw [setLIntegral_const, mul_assoc]
        have hJlower : ENNReal.ofReal (J (A i)) * volume (T ∩ t i) ≤
            q * ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x)) := by
          calc ENNReal.ofReal (J (A i)) * volume (T ∩ t i)
              = ∫⁻ _ in T ∩ t i, ENNReal.ofReal (J (A i)) := (setLIntegral_const _ _).symm
            _ ≤ ∫⁻ x in T ∩ t i, (q : ℝ≥0∞) * ENNReal.ofReal (J (u' x)) := by
                apply lintegral_mono_ae
                filter_upwards [hderiv] with x hx
                exact (hJ (u' x) hx).2
            _ = q * ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x)) :=
                lintegral_const_mul' _ _ ENNReal.coe_ne_top
        constructor
        · calc μHE[n] (u '' (T ∩ t i)) ≤ q * (ENNReal.ofReal (J (A i)) * volume (T ∩ t i)) :=
                harea_upper
            _ ≤ q * (q * ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x))) := by gcongr
            _ = (q : ℝ≥0∞) ^ 2 * ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x)) := by
                rw [pow_two, mul_assoc]
        · calc ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x))
              ≤ q * (ENNReal.ofReal (J (A i)) * volume (T ∩ t i)) := hJupper
            _ ≤ q * (q * μHE[n] (u '' (T ∩ t i))) := by gcongr
            _ = (q : ℝ≥0∞) ^ 2 * μHE[n] (u '' (T ∩ t i)) := by rw [pow_two, mul_assoc]
      rw [hsumimage, hsumintegral]
      constructor
      · calc ∑' i, μHE[n] (u '' (T ∩ t i))
            ≤ ∑' i, (q : ℝ≥0∞) ^ 2 * ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x)) :=
              ENNReal.tsum_le_tsum (fun i => (hpiece i).1)
          _ = (q : ℝ≥0∞) ^ 2 * ∑' i, ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x)) :=
              ENNReal.tsum_mul_left
      · calc ∑' i, ∫⁻ x in T ∩ t i, ENNReal.ofReal (J (u' x))
            ≤ ∑' i, (q : ℝ≥0∞) ^ 2 * μHE[n] (u '' (T ∩ t i)) :=
              ENNReal.tsum_le_tsum (fun i => (hpiece i).2)
          _ = (q : ℝ≥0∞) ^ 2 * ∑' i, μHE[n] (u '' (T ∩ t i)) := ENNReal.tsum_mul_left
    have hlimit : ∀ a : ℝ≥0∞, Tendsto (fun q : NNReal => (q : ℝ≥0∞) ^ 2 * a) (𝓝[>] 1) (𝓝 a) := by
      intro a
      have hcoe : Tendsto (fun q : NNReal => (q : ℝ≥0∞)) (𝓝[>] 1) (𝓝 1) :=
        (ENNReal.tendsto_coe.2 tendsto_id).mono_left nhdsWithin_le_nhds
      simpa only [one_pow, one_mul] using
        ENNReal.Tendsto.mul_const (ENNReal.Tendsto.pow (n := 2) hcoe) (Or.inl (by simp))
    apply le_antisymm
    · apply ge_of_tendsto (hlimit _)
      filter_upwards [self_mem_nhdsWithin] with q hq
      exact (hcmp q hq).1
    · apply ge_of_tendsto (hlimit _)
      filter_upwards [self_mem_nhdsWithin] with q hq
      exact (hcmp q hq).2
  /- Simon (3.5), Bochner form: the Jacobian-weighted measure on `S` is transported by `u`
  to `Hⁿ ⌞ u(S)`, so `∫_{u(S)} f dHⁿ = ∫_S J(u'(x)) f(u(x)) dLⁿ(x)` for every `f`. -/
  have hbochner : ∀ (S : Set (Euclid n)) (u : Euclid n → Euclid P)
      (u' : Euclid n → Euclid n →L[ℝ] Euclid P), MeasurableSet S →
      (∀ x ∈ S, HasFDerivAt u (u' x) x) → (∀ x ∈ S, Injective (u' x)) → InjOn u S →
      Measurable u' → ∫ y in u '' S, f y ∂μHE[n] = ∫ x in S, J (u' x) * f (u x) := by
    intro S u u' hS hu' hreg' hinj' hmeas'
    have hcont : ContinuousOn u S := fun x hx => (hu' x hx).continuousAt.continuousWithinAt
    have hemb := hcont.measurableEmbedding hS hinj'
    have hsub := MeasurableEmbedding.subtype_coe hS
    have hJm : Measurable (fun x => J (u' x)) := hJcont.measurable.comp hmeas'
    have hmap : Measure.map (S.domRestrict u)
        ((volume.withDensity (fun x => ENNReal.ofReal (J (u' x)))).comap
          (Subtype.val : S → Euclid n)) = μHE[n].restrict (u '' S) := by
      ext t ht
      rw [Measure.map_apply hemb.measurable ht, hsub.comap_apply]
      have hBm : MeasurableSet (Subtype.val '' ((S.domRestrict u) ⁻¹' t)) :=
        hsub.measurableSet_image' (hemb.measurable ht)
      have hBS : Subtype.val '' ((S.domRestrict u) ⁻¹' t) ⊆ S := by
        rintro x ⟨w, _, rfl⟩
        exact w.property
      rw [withDensity_apply _ hBm, ← hmeasure _ u u' hBm
        (fun x hx => (hu' x (hBS hx)).hasFDerivWithinAt) (fun x hx => hreg' x (hBS hx))
        (hinj'.mono hBS), Measure.restrict_apply ht]
      congr 1
      ext y
      constructor
      · rintro ⟨x, ⟨w, hw, rfl⟩, rfl⟩
        exact ⟨hw, ⟨w, w.property, rfl⟩⟩
      · rintro ⟨hy, x, hx, rfl⟩
        exact ⟨x, ⟨⟨x, hx⟩, hy, rfl⟩, rfl⟩
    rw [← hmap, hemb.integral_map]
    simp only [Set.domRestrict_apply, ← Function.comp_apply (f := f), ENNReal.ofReal]
    rw [← hsub.integral_map, map_comap_subtype_coe hS,
      setIntegral_withDensity_eq_setIntegral_smul₀ (hJm.real_toNNReal.aemeasurable) _ hS]
    congr with x
    rw [NNReal.smul_def, Real.coe_toNNReal _ (hJnonneg _), smul_eq_mul, comp_apply]
  -- the rescaled map `φ(b) = s⁻¹ • (g (z + s • b) - g z)` on `B_s = {b | z + s • b ∈ B}`
  have hs0 : s ≠ 0 := hs.ne'
  have hBs : MeasurableSet {b : Euclid n | z + s • b ∈ B} :=
    hB.preimage ((measurable_const_add z).comp (measurable_const_smul s))
  have hderiv : ∀ b ∈ {b : Euclid n | z + s • b ∈ B},
      HasFDerivAt (fun b : Euclid n => s⁻¹ • (g (z + s • b) - g z)) (fderiv ℝ g (z + s • b)) b := by
    intro b hb
    have h1 : HasFDerivAt (fun b' : Euclid n => z + s • b')
        (s • ContinuousLinearMap.id ℝ (Euclid n)) b :=
      ((hasFDerivAt_id b).const_smul s).const_add z
    refine ((((hdiff _ hb).hasFDerivAt.comp b h1).sub_const (g z)).const_smul s⁻¹).congr_fderiv ?_
    ext1 v
    simp [smul_smul, inv_mul_cancel₀ hs0]
  have hinjφ : InjOn (fun b : Euclid n => s⁻¹ • (g (z + s • b) - g z))
      {b : Euclid n | z + s • b ∈ B} := by
    intro b hb b' hb' h
    have h' : g (z + s • b) = g (z + s • b') := by
      simpa [hs0] using h
    exact smul_right_injective _ hs0 (add_left_cancel (hinj hb hb' h'))
  have himage :
      (fun b : Euclid n => s⁻¹ • (g (z + s • b) - g z)) '' {b : Euclid n | z + s • b ∈ B} =
        Poincare.SimonGMT.Chapter03.blowUpMap (g z) s '' (g '' B) := by
    ext y
    constructor
    · rintro ⟨b, hb, rfl⟩
      exact ⟨g (z + s • b), ⟨z + s • b, hb, rfl⟩, rfl⟩
    · rintro ⟨_, ⟨a, ha, rfl⟩, rfl⟩
      refine ⟨s⁻¹ • (a - z), ?_, ?_⟩
      · show z + s • s⁻¹ • (a - z) ∈ B
        rwa [smul_smul, mul_inv_cancel₀ hs0, one_smul, add_sub_cancel]
      · show s⁻¹ • (g (z + s • s⁻¹ • (a - z)) - g z) = s⁻¹ • (g a - g z)
        rw [smul_smul, mul_inv_cancel₀ hs0, one_smul, add_sub_cancel]
  have hmeasf' : Measurable (fun b : Euclid n => fderiv ℝ g (z + s • b)) :=
    (measurable_fderiv ℝ g).comp ((measurable_const_add z).comp (measurable_const_smul s))
  rw [← himage, hbochner _ _ (fun b : Euclid n => fderiv ℝ g (z + s • b)) hBs hderiv
    (fun b hb => hreg _ hb) hinjφ hmeasf', hJdef]
/-- **Gram cofactor identity** (the Jacobian identity `|G ∘ Φ| · JΦ = JΦₛ` of the co-area formula
for one straightened piece, Simon Ch. 3, 2.8–2.9).  If `u ∈ span{a₀, …, aₙ}`, `⟨u, a₀⟩ = 1` and
`⟨u, a_{k+1}⟩ = 0` for all `k`, then `det[⟨a_{i+1}, a_{j+1}⟩]_{i,j<n} = ‖u‖² · det[⟨aᵢ, aⱼ⟩]_{i,j≤n}`.
Write `u = ∑ cₗ aₗ`.  The Gram matrix `A = [⟨aᵢ, aⱼ⟩]` satisfies `A c = e₀` and `‖u‖² = c₀`, so
`adj(A) e₀ = adj(A) A c = det A · c`; the `(0, 0)` entry of `adj(A)` is the cofactor
`det[⟨a_{i+1}, a_{j+1}⟩]` (Cramer's rule).  No linear independence is needed. -/
theorem Submission.dor_lmbsf_pc_gram_det_succ_eq : ∀ (P n : ℕ) (a : Fin (n + 1) → Euclid P) (u : Euclid P), u ∈ Submodule.span ℝ (Set.range a) → inner ℝ u (a 0) = 1 → (∀ k : Fin n, inner ℝ u (a k.succ) = 0) → Matrix.det (Matrix.of fun i j : Fin n => inner ℝ (a i.succ) (a j.succ)) = ‖u‖ ^ 2 * Matrix.det (Matrix.of fun i j : Fin (n + 1) => inner ℝ (a i) (a j)) := by
  intro P n a u hu h0 hk
  classical
  -- `u = ∑ cₗ aₗ`
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp hu
  set A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ := Matrix.of fun i j => inner ℝ (a i) (a j)
  -- `⟨u, aᵢ⟩ = δᵢ₀`
  have hua : ∀ i, inner ℝ u (a i) = (Pi.single 0 1 : Fin (n + 1) → ℝ) i := by
    intro i
    refine Fin.cases ?_ (fun k => ?_) i
    · simp [h0]
    · simp [hk k, Fin.succ_ne_zero]
  -- `A c = e₀`
  have hAc : A.mulVec c = Pi.single 0 1 := by
    ext i
    simp only [Matrix.mulVec, dotProduct, A, Matrix.of_apply]
    have : ∑ j, inner ℝ (a i) (a j) * c j = inner ℝ (a i) u := by
      rw [← hc, inner_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [real_inner_smul_right]; ring
    rw [this, real_inner_comm, hua]
  -- `‖u‖² = c₀`
  have hnorm : ‖u‖ ^ 2 = c 0 := by
    rw [← real_inner_self_eq_norm_sq]
    calc inner ℝ u u = inner ℝ (∑ l, c l • a l) u := by rw [hc]
      _ = ∑ l, c l * inner ℝ (a l) u := by
          rw [sum_inner]; refine Finset.sum_congr rfl (fun l _ => ?_); rw [real_inner_smul_left]
      _ = c 0 := by
          have hl : ∀ l, inner ℝ (a l) u = (Pi.single 0 1 : Fin (n + 1) → ℝ) l := fun l => by
            rw [real_inner_comm, hua]
          simp_rw [hl]
          simp [Pi.single_apply]
  -- `adj(A) e₀ = adj(A) A c = det A · c`, read off at the `0`-th entry
  have hadj : A.adjugate.mulVec (A.mulVec c) = A.det • c := by
    rw [Matrix.mulVec_mulVec, Matrix.adjugate_mul, Matrix.smul_mulVec, Matrix.one_mulVec]
  rw [hAc] at hadj
  have h00 := congrFun hadj 0
  simp only [Matrix.mulVec, dotProduct, Pi.single_apply, mul_ite, mul_one, mul_zero,
    Finset.sum_ite_eq', Finset.mem_univ, ite_true, Pi.smul_apply, smul_eq_mul] at h00
  -- the `(0, 0)` cofactor of `A` is the Gram determinant of `a₁, …, aₙ`
  rw [Matrix.adjugate_fin_succ_eq_det_submatrix] at h00
  simp only [Fin.val_zero, add_zero, pow_zero, one_mul, Fin.succAbove_zero] at h00
  rw [hnorm, mul_comm, ← h00]
  rfl
/-- **Injective area formula with the Gram-determinant Jacobian** (Simon Ch. 2, (3.3) and (3.5)).
For `f : ℝᵐ → ℝᴾ` let `Jf(x) = √det(⟨Df(x)eₖ, Df(x)eₗ⟩)`, `eₖ` the standard basis of `ℝᵐ`.  Then
(i) `Jf` is Borel; (ii) if `s` is Borel, `f` is differentiable with injective `Df(x)` at every
`x ∈ s` and `f` is injective on `s`, every `g ≥ 0` has `∫_{f(s)} g dHᵐ = ∫_s Jf(x) g(f(x)) dx`.
Write `G L = √det(⟨L eₖ, L eₗ⟩)` for linear `L : ℝᵐ → ℝᴾ`.  For injective `L`, `L = ι ∘ B` with
`ι` an isometry of `ℝᵐ` onto `range L` and `B` invertible, so `G L = |det B|` and
`Hᵐ(L(S)) = G L · |S|` (linear area formula).  `f` is cut into countably many Borel pieces on which
it is uniformly close to an injective linear map (`exists_partition_approximatesLinearOn_…`);
Lipschitz comparison bounds `Hᵐ(f(piece))` against the linear model, and at almost every point of
a piece `Df` is close to the model, so `G ∘ Df` is close to its value; letting the relative error
tend to `1` gives `Hᵐ(f(B)) = ∫_B Jf` for Borel `B ⊆ s`, and the weighted formula follows by
transporting `Jf · volume` along the measurable embedding `f|s`.  (Adapted from Mathlib's
`MeasureTheory.Function.Jacobian` and SimonGMT Chapter 2 §3.) -/
theorem Submission.codim1_lura_gram_area_formula : ∀ (m P : ℕ) (f : Euclid m → Euclid P), Measurable (fun x => Real.sqrt (Matrix.det (Matrix.of fun k l : Fin m => inner ℝ (fderiv ℝ f x (EuclideanSpace.single k 1)) (fderiv ℝ f x (EuclideanSpace.single l 1))))) ∧ ∀ s : Set (Euclid m), MeasurableSet s → (∀ x ∈ s, DifferentiableAt ℝ f x) → (∀ x ∈ s, Injective (fderiv ℝ f x)) → InjOn f s → ∀ g : Euclid P → ℝ≥0∞, ∫⁻ y in f '' s, g y ∂μHE[m] = ∫⁻ x in s, ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun k l : Fin m => inner ℝ (fderiv ℝ f x (EuclideanSpace.single k 1)) (fderiv ℝ f x (EuclideanSpace.single l 1))))) * g (f x) ∂volume := by
  intro m P f
  -- `G L = √det(⟨L eₖ, L eₗ⟩)`, the Gram-determinant Jacobian of a linear `L : ℝᵐ → ℝᴾ`
  obtain ⟨G, hG⟩ : ∃ G : (Euclid m →L[ℝ] Euclid P) → ℝ, ∀ L, G L = Real.sqrt (Matrix.det
      (Matrix.of fun k l : Fin m => inner ℝ (L (EuclideanSpace.single k 1)) (L (EuclideanSpace.single l 1)))) :=
    ⟨_, fun L => rfl⟩
  simp only [← hG]
  -- `G` is continuous (polynomial in the entries, then `√`)
  have hGc : Continuous G := by
    have hGfun : G = fun L : Euclid m →L[ℝ] Euclid P => Real.sqrt (Matrix.det
        (Matrix.of fun k l : Fin m => inner ℝ (L (EuclideanSpace.single k 1)) (L (EuclideanSpace.single l 1)))) :=
      funext hG
    rw [hGfun]
    refine Real.continuous_sqrt.comp (Continuous.matrix_det ?_)
    refine continuous_pi fun k => continuous_pi fun l => ?_
    exact (continuous_id.clm_apply continuous_const).inner (continuous_id.clm_apply continuous_const)
  -- linear area formula: for injective `L`, `G L > 0` and `Hᵐ(L(S)) = G L · |S|`.  Write
  -- `L = ι ∘ B`, `ι : ℝᵐ → range L` an isometry, `B` invertible; Gram(L) = Gram(B) = BᵀB.
  have hlin : ∀ L : Euclid m →L[ℝ] Euclid P, Injective L → 0 < G L ∧
      ∀ S : Set (Euclid m), μHE[m] (L '' S) = ENNReal.ofReal (G L) * volume S := by
    intro L hL
    rw [hG]
    have hVdim : Module.finrank ℝ (LinearMap.range (L : Euclid m →ₗ[ℝ] Euclid P)) = m := by
      rw [LinearMap.finrank_range_of_inj hL, finrank_euclideanSpace_fin]
    let φ := ((stdOrthonormalBasis ℝ (LinearMap.range (L : Euclid m →ₗ[ℝ] Euclid P))).reindex
      (finCongr hVdim)).repr
    let B : Euclid m →ₗ[ℝ] Euclid m :=
      φ.toLinearEquiv.toLinearMap ∘ₗ (L : Euclid m →ₗ[ℝ] Euclid P).rangeRestrict
    have hLB : ∀ x, L x =
        ((φ.symm (B x) : LinearMap.range (L : Euclid m →ₗ[ℝ] Euclid P)) : Euclid P) := by
      intro x
      simp only [B, LinearMap.coe_comp, LinearEquiv.coe_coe, comp_apply,
        LinearIsometryEquiv.coe_toLinearEquiv, LinearIsometryEquiv.symm_apply_apply,
        LinearMap.codRestrict_apply, LinearMap.rangeRestrict]
      rfl
    have hι : Isometry (fun y : Euclid m =>
        ((φ.symm y : LinearMap.range (L : Euclid m →ₗ[ℝ] Euclid P)) : Euclid P)) :=
      isometry_subtype_coe.comp φ.symm.isometry
    have hinner : ∀ k l : Fin m,
        inner ℝ (L (EuclideanSpace.single k 1)) (L (EuclideanSpace.single l 1)) =
          inner ℝ (B (EuclideanSpace.single k 1)) (B (EuclideanSpace.single l 1)) := by
      intro k l
      rw [hLB, hLB, ← Submodule.coe_inner, LinearIsometryEquiv.inner_map_map]
    have hdet : Matrix.det (Matrix.of fun k l : Fin m =>
        inner ℝ (B (EuclideanSpace.single k 1)) (B (EuclideanSpace.single l 1))) =
          (LinearMap.det B) ^ 2 := by
      have hM : (Matrix.of fun k l : Fin m =>
          inner ℝ (B (EuclideanSpace.single k 1)) (B (EuclideanSpace.single l 1))) =
          (LinearMap.toMatrix (EuclideanSpace.basisFun (Fin m) ℝ).toBasis
            (EuclideanSpace.basisFun (Fin m) ℝ).toBasis B).transpose *
          LinearMap.toMatrix (EuclideanSpace.basisFun (Fin m) ℝ).toBasis
            (EuclideanSpace.basisFun (Fin m) ℝ).toBasis B := by
        ext k l
        simp only [Matrix.of_apply, Matrix.mul_apply, Matrix.transpose_apply,
          LinearMap.toMatrix_apply, OrthonormalBasis.coe_toBasis_repr_apply,
          OrthonormalBasis.coe_toBasis, EuclideanSpace.basisFun_repr,
          EuclideanSpace.basisFun_apply, PiLp.inner_apply, Real.inner_apply]
      rw [hM, Matrix.det_mul, Matrix.det_transpose, LinearMap.det_toMatrix, sq]
    have hBinj : Injective B := by
      intro x y hxy
      apply hL
      rw [hLB, hLB, hxy]
    have hdetne : LinearMap.det B ≠ 0 := by
      have hu : IsUnit B :=
        (Module.End.isUnit_iff B).mpr ⟨hBinj, LinearMap.surjective_of_injective hBinj⟩
      exact ((LinearMap.isUnit_iff_isUnit_det B).mp hu).ne_zero
    have hGB : Real.sqrt (Matrix.det (Matrix.of fun k l : Fin m =>
        inner ℝ (L (EuclideanSpace.single k 1)) (L (EuclideanSpace.single l 1)))) =
          |LinearMap.det B| := by
      simp_rw [hinner]
      rw [hdet, Real.sqrt_sq_eq_abs]
    refine ⟨by rw [hGB]; exact abs_pos.mpr hdetne, fun S => ?_⟩
    have himage : L '' S = (fun y : Euclid m =>
        ((φ.symm y : LinearMap.range (L : Euclid m →ₗ[ℝ] Euclid P)) : Euclid P)) '' (B '' S) := by
      rw [Set.image_image]
      exact Set.image_congr (fun x _ => hLB x)
    rw [himage, hι.euclideanHausdorffMeasure_image,
      EuclideanSpace.euclideanHausdorffMeasure_eq_volume, Measure.addHaar_image_linearMap, hGB]
  -- distance comparison `dist (φ x) (φ y) ≤ K dist (ψ x) (ψ y)` gives `Hᵐ(φ S) ≤ Kᵐ Hᵐ(ψ S)`
  have hdist : ∀ (φ ψ : Euclid m → Euclid P) (S : Set (Euclid m)) (K : NNReal), InjOn ψ S →
      (∀ x ∈ S, ∀ y ∈ S, dist (φ x) (φ y) ≤ K * dist (ψ x) (ψ y)) →
      μHE[m] (φ '' S) ≤ (K : ℝ≥0∞) ^ m * μHE[m] (ψ '' S) := by
    intro φ ψ S K hψ hφψ
    have hh : LipschitzOnWith K (φ ∘ invFunOn ψ S) (ψ '' S) := by
      rw [lipschitzOnWith_iff_dist_le_mul]
      rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
      simpa only [comp_apply, hψ.leftInvOn_invFunOn hx, hψ.leftInvOn_invFunOn hy] using
        hφψ x hx y hy
    have himage : (φ ∘ invFunOn ψ S) '' (ψ '' S) = φ '' S := by
      rw [image_comp, hψ.invFunOn_image Subset.rfl]
    simpa only [himage] using
      Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn m hh
  -- near an injective `L`, one radius `δ` controls both `G` and images of `δ`-approximations of `L`
  have hrad : ∀ L : Euclid m →L[ℝ] Euclid P, Injective L → ∀ q : NNReal, 1 < q →
      ∃ δ : NNReal, 0 < δ ∧
        (∀ B : Euclid m →L[ℝ] Euclid P, ‖B - L‖ ≤ δ →
          ENNReal.ofReal (G B) ≤ q * ENNReal.ofReal (G L) ∧
            ENNReal.ofReal (G L) ≤ q * ENNReal.ofReal (G B)) ∧
        (∀ (t : Set (Euclid m)) (φ : Euclid m → Euclid P), ApproximatesLinearOn φ L t δ →
          μHE[m] (φ '' t) ≤ q * (ENNReal.ofReal (G L) * volume t) ∧
            ENNReal.ofReal (G L) * volume t ≤ q * μHE[m] (φ '' t)) := by
    intro L hL q hq
    obtain ⟨hGpos, hLarea⟩ := hlin L hL
    obtain ⟨K, -, hK⟩ := (L : Euclid m →ₗ[ℝ] Euclid P).exists_antilipschitzWith
      (LinearMap.ker_eq_bot.mpr hL)
    have hmul : G L < (q : ℝ) * G L := lt_mul_of_one_lt_left hGpos hq
    obtain ⟨ε, hε, hnear⟩ := Metric.eventually_nhds_iff.mp
      ((hGc.continuousAt.eventually_lt continuousAt_const hmul).and
        (continuousAt_const.eventually_lt (continuousAt_const.mul hGc.continuousAt) hmul))
    have hevent : ∀ᶠ δ : NNReal in 𝓝[>] 0, 0 < δ ∧ δ * K < 1 ∧ (1 + δ * K) ^ m < q ∧
        ((1 - δ * K)⁻¹) ^ m < q ∧ (δ : ℝ) < ε := by
      have h1 : ∀ᶠ δ : NNReal in 𝓝 0, δ * K < 1 :=
        (continuousAt_id.mul continuousAt_const).eventually_lt continuousAt_const (by simp)
      have h2 : ∀ᶠ δ : NNReal in 𝓝 0, (1 + δ * K) ^ m < q :=
        ((continuousAt_const.add (continuousAt_id.mul continuousAt_const)).pow _).eventually_lt
          continuousAt_const (by simpa using hq)
      have h3 : ∀ᶠ δ : NNReal in 𝓝 0, ((1 - δ * K)⁻¹) ^ m < q := by
        apply ContinuousAt.eventually_lt _ continuousAt_const (by simpa using hq)
        apply ContinuousAt.pow
        apply ContinuousAt.inv₀
        · exact continuousAt_const.sub (continuousAt_id.mul continuousAt_const)
        · simp
      have h4 : ∀ᶠ δ : NNReal in 𝓝 0, (δ : ℝ) < ε :=
        (NNReal.continuous_coe.continuousAt).eventually_lt continuousAt_const (by simpa using hε)
      filter_upwards [self_mem_nhdsWithin, h1.filter_mono nhdsWithin_le_nhds,
        h2.filter_mono nhdsWithin_le_nhds, h3.filter_mono nhdsWithin_le_nhds,
        h4.filter_mono nhdsWithin_le_nhds] with δ hδ h1 h2 h3 h4
      exact ⟨hδ, h1, h2, h3, h4⟩
    obtain ⟨δ, hδ, hδK, hδupper, hδlower, hδε⟩ := hevent.exists
    refine ⟨δ, hδ, fun B hB => ?_, fun t φ hφ => ?_⟩
    · obtain ⟨hupper, hlower⟩ :=
        hnear (show dist B L < ε by rw [dist_eq_norm]; exact hB.trans_lt hδε)
      rw [← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_mul (NNReal.coe_nonneg q),
        ← ENNReal.ofReal_mul (NNReal.coe_nonneg q)]
      exact ⟨ENNReal.ofReal_le_ofReal hupper.le, ENNReal.ofReal_le_ofReal hlower.le⟩
    · have hb : ∀ x y, ‖x - y‖ ≤ K * ‖L x - L y‖ := fun x y => by
        simpa only [dist_eq_norm, ContinuousLinearMap.coe_coe] using hK.le_mul_dist x y
      have herr : ∀ x ∈ t, ∀ y ∈ t, ‖φ x - φ y - (L x - L y)‖ ≤ (δ : ℝ) * K * ‖L x - L y‖ :=
        fun x hx y hy => by
          calc ‖φ x - φ y - (L x - L y)‖ ≤ δ * ‖x - y‖ := by
                simpa only [map_sub] using hφ x hx y hy
            _ ≤ δ * (K * ‖L x - L y‖) := mul_le_mul_of_nonneg_left (hb x y) δ.2
            _ = (δ : ℝ) * K * ‖L x - L y‖ := by ring
      have hδR : (δ : ℝ) * K < 1 := hδK
      have hdLφ : ∀ x ∈ t, ∀ y ∈ t,
          dist (L x) (L y) ≤ ((1 - δ * K)⁻¹ : NNReal) * dist (φ x) (φ y) := by
        intro x hx y hy
        have htri : ‖L x - L y‖ ≤ ‖φ x - φ y‖ + ‖φ x - φ y - (L x - L y)‖ := by
          simpa only [norm_sub_rev, add_comm] using norm_le_norm_sub_add (L x - L y) (φ x - φ y)
        simp only [dist_eq_norm, NNReal.coe_inv, NNReal.coe_sub hδK.le, NNReal.coe_one,
          NNReal.coe_mul, inv_mul_eq_div]
        rw [le_div_iff₀ (sub_pos.mpr hδR)]
        nlinarith [herr x hx y hy, norm_nonneg (L x - L y)]
      constructor
      · refine (hdist φ L t (1 + δ * K) hL.injOn fun x hx y hy => ?_).trans ?_
        · simp only [dist_eq_norm, NNReal.coe_add, NNReal.coe_one, NNReal.coe_mul]
          calc ‖φ x - φ y‖ ≤ ‖φ x - φ y - (L x - L y)‖ + ‖L x - L y‖ := norm_le_norm_sub_add _ _
            _ ≤ (δ : ℝ) * K * ‖L x - L y‖ + ‖L x - L y‖ := add_le_add (herr x hx y hy) le_rfl
            _ = (1 + (δ : ℝ) * K) * ‖L x - L y‖ := by ring
        · rw [hLarea]
          gcongr
          exact_mod_cast hδupper.le
      · have hφinj : InjOn φ t := fun x hx y hy hxy => hL (dist_le_zero.mp (by
          simpa only [hxy, dist_self, mul_zero] using hdLφ x hx y hy))
        rw [← hLarea]
        refine (hdist L φ t _ hφinj hdLφ).trans ?_
        gcongr
        exact_mod_cast hδlower.le
  -- on a `δ`-approximation piece, `‖Df(x) - A‖ ≤ δ` at almost every point (density points);
  -- this is Mathlib's `ApproximatesLinearOn.norm_fderiv_sub_le`, whose proof is codomain-free
  have hae : ∀ (t : Set (Euclid m)) (A : Euclid m →L[ℝ] Euclid P) (δ : NNReal),
      ApproximatesLinearOn f A t δ → MeasurableSet t →
      (∀ x ∈ t, HasFDerivWithinAt f (fderiv ℝ f x) t x) →
      ∀ᵐ x ∂(volume.restrict t), ‖fderiv ℝ f x - A‖₊ ≤ δ := by
    open scoped Pointwise in
    intro t A δ hf ht hf'
    filter_upwards [Besicovitch.ae_tendsto_measure_inter_div volume t, ae_restrict_mem ht]
    intro x hx xt
    apply ContinuousLinearMap.opNorm_le_bound _ δ.2 fun z => ?_
    suffices H : ∀ ε, 0 < ε →
        ‖(fderiv ℝ f x - A) z‖ ≤ (δ + ε) * (‖z‖ + ε) + ‖fderiv ℝ f x - A‖ * ε by
      have : Tendsto (fun ε : ℝ => ((δ : ℝ) + ε) * (‖z‖ + ε) + ‖fderiv ℝ f x - A‖ * ε) (𝓝[>] 0)
          (𝓝 ((δ + 0) * (‖z‖ + 0) + ‖fderiv ℝ f x - A‖ * 0)) :=
        Tendsto.mono_left (Continuous.tendsto (by fun_prop) 0) nhdsWithin_le_nhds
      simp only [add_zero, mul_zero] at this
      apply le_of_tendsto_of_tendsto tendsto_const_nhds this
      filter_upwards [self_mem_nhdsWithin]
      exact H
    intro ε εpos
    have B₁ : ∀ᶠ r in 𝓝[>] (0 : ℝ), (t ∩ ({x} + r • closedBall z ε)).Nonempty :=
      Measure.eventually_nonempty_inter_smul_of_density_one volume t x hx _
        measurableSet_closedBall (measure_closedBall_pos volume z εpos).ne'
    obtain ⟨ρ, ρpos, hρ⟩ : ∃ ρ > 0,
        ball x ρ ∩ t ⊆ {y : Euclid m | ‖f y - f x - (fderiv ℝ f x) (y - x)‖ ≤ ε * ‖y - x‖} :=
      mem_nhdsWithin_iff.1 (Asymptotics.isLittleO_iff.1 (hf' x xt).isLittleO εpos)
    have B₂ : ∀ᶠ r in 𝓝[>] (0 : ℝ), {x} + r • closedBall z ε ⊆ ball x ρ := by
      apply nhdsWithin_le_nhds
      exact eventually_singleton_add_smul_subset isBounded_closedBall (ball_mem_nhds x ρpos)
    obtain ⟨r, ⟨y, ⟨yt, hy⟩⟩, rρ, rpos⟩ : ∃ r : ℝ, (t ∩ ({x} + r • closedBall z ε)).Nonempty ∧
        {x} + r • closedBall z ε ⊆ ball x ρ ∧ 0 < r :=
      (B₁.and (B₂.and self_mem_nhdsWithin)).exists
    obtain ⟨a, az, ya⟩ : ∃ a, a ∈ closedBall z ε ∧ y = x + r • a := by
      simp only [mem_smul_set, image_add_left, mem_preimage, singleton_add] at hy
      rcases hy with ⟨a, az, ha⟩
      exact ⟨a, az, by simp only [ha, add_neg_cancel_left]⟩
    have norm_a : ‖a‖ ≤ ‖z‖ + ε :=
      calc ‖a‖ = ‖z + (a - z)‖ := by simp only [add_sub_cancel]
        _ ≤ ‖z‖ + ‖a - z‖ := norm_add_le _ _
        _ ≤ ‖z‖ + ε := by grw [mem_closedBall_iff_norm.1 az]
    have I : r * ‖(fderiv ℝ f x - A) a‖ ≤ r * (δ + ε) * (‖z‖ + ε) :=
      calc r * ‖(fderiv ℝ f x - A) a‖ = ‖(fderiv ℝ f x - A) (r • a)‖ := by
            simp only [map_smul, norm_smul, Real.norm_eq_abs, abs_of_nonneg rpos.le]
        _ = ‖f y - f x - A (y - x) - (f y - f x - (fderiv ℝ f x) (y - x))‖ := by
            simp only [ya, add_sub_cancel_left, sub_sub_sub_cancel_left, FunLike.coe_sub,
              Pi.sub_apply, map_smul, smul_sub]
        _ ≤ ‖f y - f x - A (y - x)‖ + ‖f y - f x - (fderiv ℝ f x) (y - x)‖ := norm_sub_le _ _
        _ ≤ δ * ‖y - x‖ + ε * ‖y - x‖ := add_le_add (hf _ yt _ xt) (hρ ⟨rρ hy, yt⟩)
        _ = r * (δ + ε) * ‖a‖ := by
            simp only [ya, add_sub_cancel_left, norm_smul, Real.norm_eq_abs, abs_of_nonneg rpos.le]
            ring
        _ ≤ r * (δ + ε) * (‖z‖ + ε) := by gcongr
    calc ‖(fderiv ℝ f x - A) z‖ = ‖(fderiv ℝ f x - A) a + (fderiv ℝ f x - A) (z - a)‖ := by
          rw [← map_add, add_sub_cancel]
      _ ≤ ‖(fderiv ℝ f x - A) a‖ + ‖(fderiv ℝ f x - A) (z - a)‖ := norm_add_le _ _
      _ ≤ (δ + ε) * (‖z‖ + ε) + ‖fderiv ℝ f x - A‖ * ‖z - a‖ := by
          apply add_le_add
          · rw [mul_assoc] at I; exact (mul_le_mul_iff_right₀ rpos).1 I
          · apply ContinuousLinearMap.le_opNorm
      _ ≤ (δ + ε) * (‖z‖ + ε) + ‖fderiv ℝ f x - A‖ * ε := by
          rw [mem_closedBall_iff_norm'] at az
          gcongr
  -- (i) `Jf = G ∘ Df` is Borel
  refine ⟨hGc.measurable.comp (measurable_fderiv ℝ f), ?_⟩
  intro s hs hf hreg hinj g
  -- unweighted area formula `Hᵐ(f(B)) = ∫_B Jf` for Borel `B ⊆ s`: compare piecewise up to `q²`
  have harea : ∀ B : Set (Euclid m), MeasurableSet B → B ⊆ s →
      μHE[m] (f '' B) = ∫⁻ x in B, ENNReal.ofReal (G (fderiv ℝ f x)) := by
    intro B hB hBs
    have hcomp : ∀ q : NNReal, 1 < q →
        μHE[m] (f '' B) ≤ (q : ℝ≥0∞) ^ 2 * ∫⁻ x in B, ENNReal.ofReal (G (fderiv ℝ f x)) ∧
          (∫⁻ x in B, ENNReal.ofReal (G (fderiv ℝ f x))) ≤ (q : ℝ≥0∞) ^ 2 * μHE[m] (f '' B) := by
      intro q hq
      rcases eq_empty_or_nonempty B with rfl | hBne
      · simp
      have hchoice : ∀ L : Euclid m →L[ℝ] Euclid P, ∃ δ : NNReal, 0 < δ ∧ (Injective L →
          (∀ L' : Euclid m →L[ℝ] Euclid P, ‖L' - L‖ ≤ δ →
            ENNReal.ofReal (G L') ≤ q * ENNReal.ofReal (G L) ∧
              ENNReal.ofReal (G L) ≤ q * ENNReal.ofReal (G L')) ∧
          (∀ (t : Set (Euclid m)) (φ : Euclid m → Euclid P), ApproximatesLinearOn φ L t δ →
            μHE[m] (φ '' t) ≤ q * (ENNReal.ofReal (G L) * volume t) ∧
              ENNReal.ofReal (G L) * volume t ≤ q * μHE[m] (φ '' t))) := by
        intro L
        by_cases hL : Injective L
        · obtain ⟨δ, hδ, hJ, hLa⟩ := hrad L hL q hq
          exact ⟨δ, hδ, fun _ => ⟨hJ, hLa⟩⟩
        · exact ⟨1, zero_lt_one, fun h => (hL h).elim⟩
      choose δ hδpos hδ using hchoice
      have hfB : ∀ x ∈ B, HasFDerivWithinAt f (fderiv ℝ f x) B x :=
        fun x hx => (hf x (hBs hx)).hasFDerivAt.hasFDerivWithinAt
      obtain ⟨t, L, hdisj, ht, hcover, happrox, hactual⟩ :=
        exists_partition_approximatesLinearOn_of_hasFDerivWithinAt f B (fderiv ℝ f) hfB
          δ (fun L => (hδpos L).ne')
      have hLreg : ∀ i, Injective (L i) := by
        intro i
        obtain ⟨x, hx, hL⟩ := hactual hBne i
        rw [hL]
        exact hreg x (hBs hx)
      have hseq : B = ⋃ i, B ∩ t i := by
        rw [← inter_iUnion]
        exact Subset.antisymm (subset_inter Subset.rfl hcover) inter_subset_left
      have hsumimage : μHE[m] (f '' B) = ∑' i, μHE[m] (f '' (B ∩ t i)) := by
        conv_lhs => rw [hseq, image_iUnion]
        apply measure_iUnion
        · intro i j hij
          exact Disjoint.image (Disjoint.mono inter_subset_right inter_subset_right (hdisj hij))
            (hinj.mono hBs) inter_subset_left inter_subset_left
        · intro i
          apply (hB.inter (ht i)).image_of_continuousOn_injOn
          · exact fun x hx => (hf x (hBs hx.1)).continuousAt.continuousWithinAt
          · exact (hinj.mono hBs).mono inter_subset_left
      have hsumintegral : (∫⁻ x in B, ENNReal.ofReal (G (fderiv ℝ f x))) =
          ∑' i, ∫⁻ x in B ∩ t i, ENNReal.ofReal (G (fderiv ℝ f x)) := by
        conv_lhs => rw [hseq]
        exact lintegral_iUnion (fun i => hB.inter (ht i))
          (pairwise_disjoint_mono hdisj (fun _ => inter_subset_right)) _
      have hpiece : ∀ i, μHE[m] (f '' (B ∩ t i)) ≤
            (q : ℝ≥0∞) ^ 2 * ∫⁻ x in B ∩ t i, ENNReal.ofReal (G (fderiv ℝ f x)) ∧
          (∫⁻ x in B ∩ t i, ENNReal.ofReal (G (fderiv ℝ f x))) ≤
            (q : ℝ≥0∞) ^ 2 * μHE[m] (f '' (B ∩ t i)) := by
        intro i
        have hJ := (hδ (L i) (hLreg i)).1
        obtain ⟨harea_upper, harea_lower⟩ := (hδ (L i) (hLreg i)).2 (B ∩ t i) f (happrox i)
        have hderiv := hae (B ∩ t i) (L i) (δ (L i)) (happrox i) (hB.inter (ht i))
          (fun x hx => (hfB x hx.1).mono inter_subset_left)
        have hJupper : (∫⁻ x in B ∩ t i, ENNReal.ofReal (G (fderiv ℝ f x))) ≤
            q * (ENNReal.ofReal (G (L i)) * volume (B ∩ t i)) := by
          calc (∫⁻ x in B ∩ t i, ENNReal.ofReal (G (fderiv ℝ f x)))
              ≤ ∫⁻ _ in B ∩ t i, (q : ℝ≥0∞) * ENNReal.ofReal (G (L i)) := by
                apply lintegral_mono_ae
                filter_upwards [hderiv] with x hx
                exact (hJ (fderiv ℝ f x) hx).1
            _ = q * (ENNReal.ofReal (G (L i)) * volume (B ∩ t i)) := by
                rw [setLIntegral_const, mul_assoc]
        have hJlower : ENNReal.ofReal (G (L i)) * volume (B ∩ t i) ≤
            q * ∫⁻ x in B ∩ t i, ENNReal.ofReal (G (fderiv ℝ f x)) := by
          calc ENNReal.ofReal (G (L i)) * volume (B ∩ t i)
              = ∫⁻ _ in B ∩ t i, ENNReal.ofReal (G (L i)) := (setLIntegral_const _ _).symm
            _ ≤ ∫⁻ x in B ∩ t i, (q : ℝ≥0∞) * ENNReal.ofReal (G (fderiv ℝ f x)) := by
                apply lintegral_mono_ae
                filter_upwards [hderiv] with x hx
                exact (hJ (fderiv ℝ f x) hx).2
            _ = q * ∫⁻ x in B ∩ t i, ENNReal.ofReal (G (fderiv ℝ f x)) :=
                lintegral_const_mul' _ _ ENNReal.coe_ne_top
        constructor
        · calc μHE[m] (f '' (B ∩ t i)) ≤ q * (ENNReal.ofReal (G (L i)) * volume (B ∩ t i)) :=
                harea_upper
            _ ≤ q * (q * ∫⁻ x in B ∩ t i, ENNReal.ofReal (G (fderiv ℝ f x))) := by gcongr
            _ = (q : ℝ≥0∞) ^ 2 * ∫⁻ x in B ∩ t i, ENNReal.ofReal (G (fderiv ℝ f x)) := by
                rw [pow_two, mul_assoc]
        · calc (∫⁻ x in B ∩ t i, ENNReal.ofReal (G (fderiv ℝ f x)))
              ≤ q * (ENNReal.ofReal (G (L i)) * volume (B ∩ t i)) := hJupper
            _ ≤ q * (q * μHE[m] (f '' (B ∩ t i))) := by gcongr
            _ = (q : ℝ≥0∞) ^ 2 * μHE[m] (f '' (B ∩ t i)) := by rw [pow_two, mul_assoc]
      rw [hsumimage, hsumintegral]
      constructor
      · calc (∑' i, μHE[m] (f '' (B ∩ t i)))
            ≤ ∑' i, (q : ℝ≥0∞) ^ 2 * ∫⁻ x in B ∩ t i, ENNReal.ofReal (G (fderiv ℝ f x)) :=
              ENNReal.tsum_le_tsum (fun i => (hpiece i).1)
          _ = _ := ENNReal.tsum_mul_left
      · calc (∑' i, ∫⁻ x in B ∩ t i, ENNReal.ofReal (G (fderiv ℝ f x)))
            ≤ ∑' i, (q : ℝ≥0∞) ^ 2 * μHE[m] (f '' (B ∩ t i)) :=
              ENNReal.tsum_le_tsum (fun i => (hpiece i).2)
          _ = _ := ENNReal.tsum_mul_left
    have hlimit : ∀ a : ℝ≥0∞, Tendsto (fun q : NNReal => (q : ℝ≥0∞) ^ 2 * a) (𝓝[>] 1) (𝓝 a) := by
      intro a
      have hcoe : Tendsto (fun q : NNReal => (q : ℝ≥0∞)) (𝓝[>] 1) (𝓝 1) :=
        (ENNReal.tendsto_coe.2 tendsto_id).mono_left nhdsWithin_le_nhds
      simpa only [one_pow, one_mul] using
        ENNReal.Tendsto.mul_const (ENNReal.Tendsto.pow (n := 2) hcoe) (Or.inl (by simp))
    apply le_antisymm
    · apply ge_of_tendsto (hlimit _)
      filter_upwards [self_mem_nhdsWithin] with q hq
      exact (hcomp q hq).1
    · apply ge_of_tendsto (hlimit _)
      filter_upwards [self_mem_nhdsWithin] with q hq
      exact (hcomp q hq).2
  -- (ii) transport `Jf · volume` on `s` along the measurable embedding `f|s` onto `Hᵐ⌞f(s)`
  have hcont : ContinuousOn f s := fun x hx => (hf x hx).continuousAt.continuousWithinAt
  have hemb := hcont.measurableEmbedding hs hinj
  have hsub := MeasurableEmbedding.subtype_coe hs
  have hmap : Measure.map (s.domRestrict f)
      ((volume.withDensity (fun x => ENNReal.ofReal (G (fderiv ℝ f x)))).comap
        (Subtype.val : s → Euclid m)) = μHE[m].restrict (f '' s) := by
    ext t ht
    rw [Measure.map_apply hemb.measurable ht, hsub.comap_apply]
    have hB : MeasurableSet (Subtype.val '' ((s.domRestrict f) ⁻¹' t)) :=
      hsub.measurableSet_image' (hemb.measurable ht)
    have hBs : Subtype.val '' ((s.domRestrict f) ⁻¹' t) ⊆ s := by
      rintro x ⟨u, _, rfl⟩
      exact u.property
    rw [withDensity_apply _ hB, ← harea _ hB hBs, Measure.restrict_apply ht]
    congr 1
    ext y
    constructor
    · rintro ⟨x, ⟨u, hu, rfl⟩, rfl⟩
      exact ⟨hu, ⟨u, u.property, rfl⟩⟩
    · rintro ⟨hy, x, hx, rfl⟩
      exact ⟨x, ⟨⟨x, hx⟩, hy, rfl⟩, rfl⟩
  rw [← hmap, hemb.lintegral_map]
  change (∫⁻ x : s, (fun x : Euclid m => g (f x)) x ∂((volume.withDensity
    (fun x => ENNReal.ofReal (G (fderiv ℝ f x)))).comap (Subtype.val : s → Euclid m))) = _
  rw [lintegral_subtype_comap hs (fun x : Euclid m => g (f x)),
    setLIntegral_withDensity_eq_setLIntegral_mul_non_measurable₀ _ _ _ hs]
  · rfl
  · simp only [eventually_true, ENNReal.ofReal_lt_top]
  · exact (hGc.measurable.comp (measurable_fderiv ℝ f)).ennreal_ofReal.aemeasurable
/-- **Simon Ch. 2, (3.1)** in integral form (area formula for an injective linear map): for an
injective linear `L : ℝⁿ → ℝᴾ` and every `f`, `∫_{L(ℝⁿ)} f dHⁿ = √det(L* ∘ L) ∫_{ℝⁿ} f(Lb) dLⁿ(b)`.
Write `L = W ∘ A` with `W` a linear isometry of `ℝⁿ` onto `L(ℝⁿ)` and `A` an automorphism of `ℝⁿ`;
then `Hⁿ⌞L(ℝⁿ) = W#Lⁿ`, `Lⁿ = |det A| A#Lⁿ` and `det(L* ∘ L) = det(A* ∘ A) = (det A)²`. -/
theorem Submission.codim1_rdo_c1pt_linear_range_integral : ∀ (P n : ℕ) (L : Euclid n →L[ℝ] Euclid P) (f : Euclid P → ℝ), Injective L → ∫ y in (LinearMap.range (L : Euclid n →ₗ[ℝ] Euclid P) : Set (Euclid P)), f y ∂μHE[n] = Real.sqrt ((L.adjoint ∘L L).det) * ∫ b, f (L b) := by
  intro P n L f hL
  -- `L = W ∘ A`: `W` is a linear isometry of `ℝⁿ` onto `R = L(ℝⁿ)` (via an orthonormal basis of
  -- `R`, which has dimension `n`) and `A` is a surjective endomorphism of `ℝⁿ`
  obtain ⟨W, A, hWA, hA⟩ : ∃ (W : Euclid n →ₗᵢ[ℝ] Euclid P) (A : Euclid n →L[ℝ] Euclid n),
      (∀ x, W (A x) = L x) ∧ Surjective A := by
    let R := LinearMap.range (L : Euclid n →ₗ[ℝ] Euclid P)
    have hrank : Module.finrank ℝ R = n :=
      (LinearMap.finrank_range_of_inj (f := (L : Euclid n →ₗ[ℝ] Euclid P)) hL).trans
        finrank_euclideanSpace_fin
    let bv : OrthonormalBasis (Fin n) ℝ R := (stdOrthonormalBasis ℝ R).reindex (finCongr hrank)
    refine ⟨R.subtypeₗᵢ.comp bv.repr.symm.toLinearIsometry,
      bv.repr.toContinuousLinearEquiv.toContinuousLinearMap ∘L
        L.codRestrict R (fun x => LinearMap.mem_range_self _ x), fun x => by simp, fun z => ?_⟩
    obtain ⟨x, hx⟩ := LinearMap.mem_range.mp (bv.repr.symm z).2
    refine ⟨x, ?_⟩
    have hx' : L.codRestrict R (fun x => LinearMap.mem_range_self _ x) x = bv.repr.symm z :=
      Subtype.ext hx
    simp [hx']
  have hAinj : Injective A := fun x y h => hL (by rw [← hWA x, ← hWA y, h])
  -- `L(ℝⁿ) = W(ℝⁿ)`
  have hrange : (LinearMap.range (L : Euclid n →ₗ[ℝ] Euclid P) : Set (Euclid P)) =
      Set.range W := by
    rw [LinearMap.coe_range, ContinuousLinearMap.coe_coe, ← hA.range_comp W]
    congr 1
    funext x
    exact (hWA x).symm
  -- `Hⁿ⌞W(ℝⁿ) = W#Hⁿ` (`W` is an isometry) and `Hⁿ = Lⁿ` on `ℝⁿ`
  have hW : ∫ y in Set.range W, f y ∂μHE[n] = ∫ x, f (W x) := by
    rw [← W.isometry.map_euclideanHausdorffMeasure,
      W.isometry.isClosedEmbedding.measurableEmbedding.integral_map,
      EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
  -- change of variables `x = A b` on `ℝⁿ`
  have hAcv : ∫ x, f (W x) = |A.det| * ∫ b, f (W (A b)) := by
    have h := integral_image_eq_integral_abs_det_fderiv_smul volume MeasurableSet.univ
      (fun x _ => A.hasFDerivAt.hasFDerivWithinAt) hAinj.injOn (fun x => f (W x))
    rw [Set.image_univ, hA.range_eq, Measure.restrict_univ] at h
    rw [h, ← integral_const_mul]
    simp only [smul_eq_mul]
  -- `L* ∘ L = A* ∘ W* ∘ W ∘ A = A* ∘ A`, so `det (L* ∘ L) = (det A)²`
  have hdet : (L.adjoint ∘L L).det = A.det ^ 2 := by
    have hL' : L = W.toContinuousLinearMap ∘L A := ContinuousLinearMap.ext fun x => (hWA x).symm
    have h1 : L.adjoint ∘L L = A.adjoint ∘L A := by
      rw [hL', ContinuousLinearMap.adjoint_comp, ← ContinuousLinearMap.comp_assoc,
        ContinuousLinearMap.comp_assoc (ContinuousLinearMap.adjoint _), W.adjoint_comp_self,
        ContinuousLinearMap.one_def, ContinuousLinearMap.comp_id]
    have hadj : LinearMap.det (LinearMap.adjoint (A : Euclid n →ₗ[ℝ] Euclid n)) =
        LinearMap.det (A : Euclid n →ₗ[ℝ] Euclid n) := by
      let b := EuclideanSpace.basisFun (Fin n) ℝ
      rw [← LinearMap.det_toMatrix b.toBasis, LinearMap.toMatrix_adjoint b b,
        Matrix.det_conjTranspose, LinearMap.det_toMatrix, star_trivial]
    rw [h1, ContinuousLinearMap.det, ContinuousLinearMap.det,
      ContinuousLinearMap.toLinearMap_comp, LinearMap.det_comp,
      ← ContinuousLinearMap.adjoint_toLinearMap, hadj, sq]
  rw [hrange, hW, hAcv, hdet, Real.sqrt_sq_eq_abs]
  simp only [hWA]
/-- Rescaled integrals over a `C¹` piece converge to the integral over its tangent map (proof of
Simon Ch. 3, Theorem 1.6, with a continuous weight `h`).  With `L = Dg(z)`,
`B_s = {b : z + s b ∈ B}` and `φ_s(b) = s⁻¹ (g(z + s b) − g(z))`:
`∫_{B_s} h(z + s b) f(φ_s(b)) db → h(z) ∫ f(L b) db` as `s ↓ 0`.  Take `f = 0` off `B_R(0)` and
`B̄_ρ(z) ⊆ B`.  For `0 < s < mρ/R`, `K = B̄_{R/m}(0) ⊆ B_s`, and the integrand vanishes on
`B_s \ K` because `|φ_s(b)| ≥ m|b| > R`.  On `K` it is bounded by `sup_{B̄_ρ(z)} |h| · sup |f|` and
tends pointwise to `h(z) f(L b)`, so dominated convergence applies.  Finally `f(L b) = 0` off `K`
because `|L b| ≥ m|b| > R`. -/
theorem Submission.codim1_rdo_c1pt_rescaled_integral_tendsto : ∀ (P n : ℕ) (g : Euclid n → Euclid P) (h : Euclid n → ℝ) (B : Set (Euclid n)) (z : Euclid n) (m : ℝ) (f : Euclid P → ℝ), Continuous g → DifferentiableAt ℝ g z → Continuous h → IsOpen B → z ∈ B → 0 < m → (∀ a ∈ B, m * ‖a - z‖ ≤ ‖g a - g z‖) → (∀ v : Euclid n, m * ‖v‖ ≤ ‖fderiv ℝ g z v‖) → Continuous f → HasCompactSupport f → Tendsto (fun s : ℝ => ∫ b in {b : Euclid n | z + s • b ∈ B}, h (z + s • b) * f (s⁻¹ • (g (z + s • b) - g z))) (𝓝[>] 0) (𝓝 (h z * ∫ b, f (fderiv ℝ g z b))) := by
  intro P n g h B z m f hg hgz hh hB hzB hm hgB hL hf hfs
  -- Step 1: `f = 0` off `closedBall 0 R`
  obtain ⟨R, hR, hRf⟩ : ∃ R : ℝ, 0 < R ∧ ∀ y, R < ‖y‖ → f y = 0 := by
    obtain ⟨R, hR, hsub⟩ := hfs.isCompact.isBounded.subset_closedBall_lt 0 0
    refine ⟨R, hR, fun y hy => ?_⟩
    by_contra hne
    have hy' := hsub (subset_tsupport f hne)
    rw [mem_closedBall, dist_zero_right] at hy'
    linarith
  -- Step 2: `closedBall z ρ ⊆ B`
  obtain ⟨ρ, hρ, hρB⟩ : ∃ ρ : ℝ, 0 < ρ ∧ closedBall z ρ ⊆ B := by
    obtain ⟨ε, hε, hεB⟩ := Metric.isOpen_iff.1 hB z hzB
    exact ⟨ε / 2, half_pos hε, (closedBall_subset_ball (half_lt_self hε)).trans hεB⟩
  -- Step 3: `K = closedBall 0 (R / m)`, `s₀ = m ρ / R`
  have hs₀ : 0 < m * ρ / R := div_pos (mul_pos hm hρ) hR
  have hKB : ∀ s : ℝ, 0 < s → s ≤ m * ρ / R → ∀ b ∈ closedBall (0 : Euclid n) (R / m),
      z + s • b ∈ closedBall z ρ := by
    intro s hs hss b hb
    rw [mem_closedBall, dist_zero_right] at hb
    rw [mem_closedBall, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hs.le]
    calc s * ‖b‖ ≤ m * ρ / R * (R / m) := mul_le_mul hss hb (norm_nonneg _) hs₀.le
      _ = ρ := by field_simp
  have hout : ∀ s : ℝ, 0 < s → ∀ b : Euclid n, z + s • b ∈ B →
      b ∉ closedBall (0 : Euclid n) (R / m) → f (s⁻¹ • (g (z + s • b) - g z)) = 0 := by
    intro s hs b hbB hbK
    apply hRf
    rw [mem_closedBall, dist_zero_right, not_le, div_lt_iff₀ hm] at hbK
    have h1 := hgB _ hbB
    rw [add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hs.le] at h1
    rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hs.le)]
    calc R < ‖b‖ * m := hbK
      _ = s⁻¹ * (m * (s * ‖b‖)) := by field_simp
      _ ≤ s⁻¹ * ‖g (z + s • b) - g z‖ := by gcongr
  -- Step 4: localisation to `K`
  have hloc : ∀ᶠ s in 𝓝[>] (0 : ℝ),
      (∫ b in closedBall (0 : Euclid n) (R / m), h (z + s • b) * f (s⁻¹ • (g (z + s • b) - g z))) =
        ∫ b in {b : Euclid n | z + s • b ∈ B}, h (z + s • b) * f (s⁻¹ • (g (z + s • b) - g z)) := by
    filter_upwards [Ioo_mem_nhdsGT hs₀] with s hs
    symm
    apply setIntegral_eq_of_subset_of_forall_sdiff_eq_zero
    · exact (hB.preimage (continuous_const.add (continuous_const_smul s))).measurableSet
    · intro b hb
      exact hρB (hKB s hs.1 hs.2.le b hb)
    · rintro b ⟨hbB, hbK⟩
      rw [hout s hs.1 b hbB hbK, mul_zero]
  -- Step 5: uniform bounds
  obtain ⟨Λ, hΛ⟩ := (isCompact_closedBall z ρ).exists_bound_of_continuousOn hh.continuousOn
  obtain ⟨C, hC⟩ := hf.bounded_above_of_compact_support hfs
  -- Steps 6–8: dominated convergence on `K`
  have hdom : Tendsto (fun s : ℝ => ∫ b in closedBall (0 : Euclid n) (R / m),
      h (z + s • b) * f (s⁻¹ • (g (z + s • b) - g z))) (𝓝[>] 0)
      (𝓝 (∫ b in closedBall (0 : Euclid n) (R / m), h z * f (fderiv ℝ g z b))) := by
    refine tendsto_integral_filter_of_dominated_convergence (fun _ => Λ * C) ?_ ?_ ?_ ?_
    · refine Eventually.of_forall fun s => Continuous.aestronglyMeasurable ?_
      have hz : Continuous fun b : Euclid n => z + s • b :=
        continuous_const.add (continuous_const_smul s)
      exact (hh.comp hz).mul (hf.comp (((hg.comp hz).sub continuous_const).const_smul s⁻¹))
    · filter_upwards [Ioo_mem_nhdsGT hs₀] with s hs
      filter_upwards [ae_restrict_mem measurableSet_closedBall] with b hb
      have hmem := hKB s hs.1 hs.2.le b hb
      rw [norm_mul]
      exact mul_le_mul (hΛ _ hmem) (hC _) (norm_nonneg _) ((norm_nonneg _).trans (hΛ _ hmem))
    · exact integrableOn_const measure_closedBall_lt_top.ne
    · refine Eventually.of_forall fun b => Tendsto.mul ?_ ?_
      · -- `h (z + s • b) → h z`
        have h1 : Tendsto (fun s : ℝ => z + s • b) (𝓝 0) (𝓝 (z + (0 : ℝ) • b)) :=
          (continuous_const.add (continuous_id.smul continuous_const)).tendsto 0
        rw [zero_smul, add_zero] at h1
        exact (hh.tendsto z).comp (h1.mono_left nhdsWithin_le_nhds)
      · -- difference quotients: `s⁻¹ • (g (z + s • b) - g z) → L b`
        have hc : Tendsto (fun s : ℝ => ‖s⁻¹‖) (𝓝[>] 0) atTop :=
          tendsto_norm_atTop_atTop.comp tendsto_inv_nhdsGT_zero
        have hlim := hgz.hasFDerivAt.lim b hc
        simp only [inv_inv] at hlim
        exact (hf.tendsto _).comp hlim
  -- Step 9: identification of the limit
  have hid : ∫ b in closedBall (0 : Euclid n) (R / m), h z * f (fderiv ℝ g z b) =
      h z * ∫ b, f (fderiv ℝ g z b) := by
    rw [setIntegral_eq_integral_of_forall_compl_eq_zero, integral_const_mul]
    intro b hb
    rw [mem_closedBall, dist_zero_right, not_le, div_lt_iff₀ hm] at hb
    rw [hRf _ (hb.trans_le ((mul_comm _ _).le.trans (hL b))), mul_zero]
  rw [← hid]
  exact hdom.congr' hloc

/-- **Approximate tangent space of a `C¹` piece** (Simon Ch. 3, 1.4; the step "since `x ∈ Nⱼ` and
`Nⱼ` is a `C¹` submanifold, `lim_{λ↓0} ∫_{η_{x,λ}(Nⱼ)} f dHⁿ = ∫_{TₓNⱼ} f dHⁿ`" of the proof of
1.6 "⇒", chapter-03.txt lines 113–125).  Let `g` be `C¹` with `m|a − b| ≤ |g(a) − g(b)|` on
`B = B_r(c)`, `m > 0`, and `z ∈ B`.  Then `|Dg(a)v| ≥ m|v|`, so `Dg(a)` is injective for `a ∈ B`,
`g` is injective on `B` and `T = Dg(z)(ℝⁿ)` has dimension `n`.  By the area formula (Ch. 2, 3.2,
3.3, 3.5), `∫_{η_{g(z),s}(g(B))} f dHⁿ = ∫_{B_s} J_g(z + sb) f(s⁻¹(g(z + sb) − g(z))) db` for
`s > 0`.  The Jacobian `J_g = √det(Dg* ∘ Dg)` is continuous, so these integrals tend to
`J_g(z) ∫ f(Dg(z)b) db`, which is `∫_T f dHⁿ` by the linear area formula (Ch. 2, 3.1). -/
theorem Submission.codim1_rdo_c1_piece_approxTangent : ∀ (P n : ℕ) (g : Euclid n → Euclid P) (c : Euclid n) (r m : ℝ), ContDiff ℝ 1 g → 0 < m → (∀ a ∈ ball c r, ∀ b ∈ ball c r, m * ‖a - b‖ ≤ ‖g a - g b‖) → ∀ z ∈ ball c r, HasApproximateTangentSpaceAt n (g '' ball c r) (g z) (LinearMap.range (fderiv ℝ g z : Euclid n →ₗ[ℝ] Euclid P)) := by
  intro P n g c r m hg hm hlip z hz
  have hdiff : Differentiable ℝ g := hg.differentiable one_ne_zero
  -- a vector `x` with `m|x| ≤ 0` vanishes, since `m > 0`
  have hzero : ∀ x : Euclid n, m * ‖x‖ ≤ 0 → x = 0 := fun x hx =>
    norm_le_zero_iff.1 (nonpos_of_mul_nonpos_right hx hm)
  -- Step 1, `m|v| ≤ |Dg(a)v|` for `a ∈ B`, so `Dg(a)` is injective; `g` is injective on `B`.
  have hlow : ∀ a ∈ ball c r, ∀ v : Euclid n, m * ‖v‖ ≤ ‖fderiv ℝ g a v‖ := fun a ha =>
    Submission.codim1_rdo_c1pt_fderiv_lower_bound P n g (ball c r) a m isOpen_ball ha (hdiff a)
      fun x hx => hlip x hx a ha
  have hinj : ∀ a ∈ ball c r, Injective (fderiv ℝ g a) := by
    intro a ha v w hvw
    have h := hlow a ha (v - w)
    rw [map_sub, hvw, sub_self, norm_zero] at h
    exact sub_eq_zero.1 (hzero _ h)
  have hinjOn : InjOn g (ball c r) := by
    intro a ha b hb hab
    have h := hlip a ha b hb
    rw [hab, sub_self, norm_zero] at h
    exact sub_eq_zero.1 (hzero _ h)
  -- Step 2, the Jacobian `J_g(a) = √det(Dg(a)* ∘ Dg(a))` is continuous.
  have hcont : Continuous (fderiv ℝ g) := hg.continuous_fderiv one_ne_zero
  have hJ : Continuous fun a => Real.sqrt (((fderiv ℝ g a).adjoint ∘L fderiv ℝ g a).det) :=
    Real.continuous_sqrt.comp (ContinuousLinearMap.continuous_det.comp
      ((ContinuousLinearMap.adjoint.continuous.comp hcont).clm_comp hcont))
  refine ⟨?_, fun f => ?_⟩
  · -- `dim T = n`
    rw [LinearMap.finrank_range_of_inj (f := (fderiv ℝ g z : Euclid n →ₗ[ℝ] Euclid P))
      (hinj z hz), finrank_euclideanSpace_fin]
  · -- Steps 3–8, `∫_T f dHⁿ = J_g(z) ∫ f(Dg(z)b) db` is the limit of the rescaled area formulas.
    rw [Submission.codim1_rdo_c1pt_linear_range_integral P n (fderiv ℝ g z) f (hinj z hz)]
    refine (Submission.codim1_rdo_c1pt_rescaled_integral_tendsto P n g
      (fun a => Real.sqrt (((fderiv ℝ g a).adjoint ∘L fderiv ℝ g a).det)) (ball c r) z m f
      hdiff.continuous (hdiff z) hJ isOpen_ball hz hm (fun a ha => hlip a ha z hz) (hlow z hz)
      f.continuous f.hasCompactSupport).congr' ?_
    filter_upwards [self_mem_nhdsWithin] with s hs
    exact (Submission.codim1_rdo_c1pt_rescaled_area_formula P n g (ball c r) z s f
      measurableSet_ball (fun a _ => hdiff a) hinjOn hinj hs).symm
/-- **Locality of approximate tangent spaces** (Simon Ch. 3, Definition 1.4): if `M' ⊆ M`, `M` is
Borel and `x ∉ closure (M \ M')`, then an approximate tangent space `Q` of `M'` at `x` is also one
of `M`.  Some `ρ > 0` has `|z − x| ≥ ρ` on `M \ M'`, and a test function `f` vanishes on
`|p| ≥ R`.  For `0 < r < ρ / R`, `η_{x,r}(M)` and `η_{x,r}(M')` differ only where
`|p| ≥ ρ / r > R`, so `∫_{η_{x,r}(M)} f dHⁿ = ∫_{η_{x,r}(M')} f dHⁿ` and the limit transfers. -/
theorem Submission.dor_lmbsf_cit_approxTangent_of_subset : ∀ (P n : ℕ) (M M' : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)), MeasurableSet M → M' ⊆ M → x ∉ closure (M \ M') → HasApproximateTangentSpaceAt n M' x Q → HasApproximateTangentSpaceAt n M x Q := by
  intro P n M M' x Q hM hM'M hx hM'
  refine ⟨hM'.1, fun f => ?_⟩
  -- `x ∉ closure (M \ M')`: some `ρ > 0` has `ρ ≤ |x − z|` for all `z ∈ M \ M'`
  obtain ⟨ρ, hρ, hρM⟩ : ∃ ρ > 0, ∀ z ∈ M \ M', ρ ≤ dist x z := by
    simpa only [Metric.mem_closure_iff, not_forall, not_exists, not_and, not_lt,
      exists_prop] using hx
  -- `f` has compact support: `f p = 0` once `R ≤ |p|`
  obtain ⟨R, hR, hfR⟩ : ∃ R : ℝ, 0 < R ∧ ∀ p : Euclid P, R ≤ ‖p‖ → f p = 0 :=
    f.hasCompactSupport.exists_pos_le_norm
  -- for `0 < r < ρ / R` the blown-up integrals over `M` and `M'` agree
  refine (hM'.2 f).congr' ?_
  filter_upwards [Ioo_mem_nhdsGT (div_pos hρ hR)] with r hr
  obtain ⟨hr0, hrR⟩ := hr
  rw [lt_div_iff₀ hR] at hrR
  -- `η_{x,r}(M)` is the preimage of `M` under `p ↦ x + r p`, hence Borel
  have hmeas : MeasurableSet (Poincare.SimonGMT.Chapter03.blowUpMap x r '' M) := by
    have himage : Poincare.SimonGMT.Chapter03.blowUpMap x r '' M =
        (fun p : Euclid P => x + r • p) ⁻¹' M := by
      ext p
      constructor
      · rintro ⟨z, hz, rfl⟩
        simpa [Poincare.SimonGMT.Chapter03.blowUpMap, smul_smul, hr0.ne'] using hz
      · intro hp
        exact ⟨x + r • p, hp, by
          simp [Poincare.SimonGMT.Chapter03.blowUpMap, smul_smul, hr0.ne']⟩
    rw [himage]
    exact hM.preimage (by fun_prop)
  symm
  refine setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hmeas (image_mono hM'M) ?_
  -- a point of `η_{x,r}(M) \ η_{x,r}(M')` comes from `z ∈ M \ M'`, so its norm is `≥ ρ / r > R`
  rintro _ ⟨⟨z, hzM, rfl⟩, hzM'⟩
  have hz : z ∈ M \ M' := ⟨hzM, fun h => hzM' ⟨z, h, rfl⟩⟩
  apply hfR
  rw [Poincare.SimonGMT.Chapter03.blowUpMap, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hr0.le),
    ← dist_eq_norm, dist_comm, inv_mul_eq_div, le_div_iff₀ hr0]
  linarith [hρM z hz]

/-- **Approximate tangent space of an injective `C¹` image** (Simon Ch. 3, 1.4; the step "since
`x ∈ Nⱼ` and `Nⱼ` is a `C¹` submanifold, `lim_{λ↓0} ∫_{η_{x,λ}(Nⱼ)} f dHⁿ = ∫_{TₓNⱼ} f dHⁿ`" of
the proof of 1.6 "⇒", chapter-03.txt lines 113–125).  Let `χ` be `C¹` on the open `V ⊇ C`, `C`
compact, `χ` injective on `C`, `y ∈ int C` and `Dχ(y)` injective.  On a ball
`B_ε(y) ⊆ V ∩ int C`, `χ` agrees with a globally `C¹` map `g`, so `Dg(y) = Dχ(y)` and `g` has a
lower Lipschitz bound on some `B_δ(y) ⊆ B_ε(y)`.  Hence `χ(B_δ(y)) = g(B_δ(y))` has approximate
tangent space `Q = Dχ(y)(ℝᵏ)` at `χ(y)`.  The rest of `χ(C)` lies in the compact set
`χ(C \ B_δ(y))`, which misses `χ(y)` by injectivity, so it does not change the blow-up limits. -/
theorem Submission.dor_lmbsf_c1_image_approxTangent : ∀ (k P : ℕ) (V C : Set (Euclid k)) (χ : Euclid k → Euclid P) (y : Euclid k), IsOpen V → ContDiffOn ℝ 1 χ V → IsCompact C → C ⊆ V → InjOn χ C → y ∈ interior C → Injective (fderiv ℝ χ y) → HasApproximateTangentSpaceAt k (χ '' C) (χ y) (LinearMap.range (fderiv ℝ χ y : Euclid k →ₗ[ℝ] Euclid P)) := by
  intro k P V C χ y hV hχ hC hCV hinj hy hDχ
  -- Step 1, `χ` agrees on `B_ε(y) ⊆ W = V ∩ int C` with a globally `C¹` map `g`
  obtain ⟨g, ε, hε, hεW, hg, hgχ⟩ := Submission.dor_lmbsf_cit_c1_local_extension P k
    (V ∩ interior C) χ y (hV.inter isOpen_interior) (hχ.mono inter_subset_left)
    ⟨hCV (interior_subset hy), hy⟩
  -- Step 2, `g(y) = χ(y)` and `Dg(y) = Dχ(y)`, since `g = χ` near `y`
  have hgy : g y = χ y := hgχ (mem_ball_self hε)
  have hDg : fderiv ℝ g y = fderiv ℝ χ y :=
    (hgχ.eventuallyEq_of_mem (ball_mem_nhds y hε)).fderiv_eq
  -- Step 3, `μ|a − b| ≤ |g(a) − g(b)|` on `B_δ₀(y)`; take `δ = min(ε, δ₀)`
  obtain ⟨δ₀, μ, hδ₀, hμ, hlip⟩ :=
    Submission.codim1_rdo_c1cov_local_lower_lipschitz P k g y hg (by rwa [hDg])
  obtain ⟨δ, hδ, hδε, hδδ₀⟩ : ∃ δ : ℝ, 0 < δ ∧ ball y δ ⊆ ball y ε ∧ ball y δ ⊆ ball y δ₀ :=
    ⟨min ε δ₀, lt_min hε hδ₀, ball_subset_ball (min_le_left _ _),
      ball_subset_ball (min_le_right _ _)⟩
  -- Step 4, `M' = g(B_δ(y)) = χ(B_δ(y))` has approximate tangent space `Q` at `χ(y)`
  have hpiece := Submission.codim1_rdo_c1_piece_approxTangent P k g y δ μ hg hμ
    (fun a ha b hb => hlip a (hδδ₀ ha) b (hδδ₀ hb)) y (mem_ball_self hδ)
  rw [(hgχ.mono hδε).image_eq, hgy, hDg] at hpiece
  -- Step 5, `M = χ(C)` is compact, `M' ⊆ M`, and `M \ M' ⊆ χ(C \ B_δ(y))`, a compact set that
  -- misses `χ(y)` because `χ` is injective on `C`
  have hδC : ball y δ ⊆ C := hδε.trans (hεW.trans (inter_subset_right.trans interior_subset))
  have hχC : ContinuousOn χ C := hχ.continuousOn.mono hCV
  have hfar : χ y ∉ closure (χ '' C \ χ '' ball y δ) := by
    intro hcl
    obtain ⟨z, ⟨hzC, hzδ⟩, hzy⟩ := closure_minimal (subset_image_sdiff χ C (ball y δ))
      ((hC.diff isOpen_ball).image_of_continuousOn (hχC.mono sdiff_subset)).isClosed hcl
    rw [hinj hzC (interior_subset hy) hzy] at hzδ
    exact hzδ (mem_ball_self hδ)
  -- Step 6, the part of `χ(C)` away from `χ(y)` does not change the blow-up limits
  exact Submission.dor_lmbsf_cit_approxTangent_of_subset P k (χ '' C) (χ '' ball y δ) (χ y) _
    (hC.image_of_continuousOn hχC).isClosed.measurableSet (image_mono hδC) hfar hpiece
/-- **Density points see every direction.**  If `y` is a Lebesgue density point of an arbitrary set
`Z ⊆ ℝᵈ`, i.e. `Lᵈ(Z ∩ B̄_r(y)) / Lᵈ(B̄_r(y)) → 1` as `r ↓ 0`, then every unit vector `v` is a limit
of secant directions `(yᵢ - y)/|yᵢ - y|` with `yᵢ ∈ Z ∖ {y}` and `yᵢ → y`.  For `0 < η ≤ 1` and
`r > 0` the ball `B_{ηr/4}(y + (r/2)v)` lies in `B̄_r(y) ∖ {y}` and in the `η`-cone around `v`, and
it has measure `(η/4)ᵈ Lᵈ(B̄_r(y))`, so density one forces `Z` to meet it for all small `r`; take
`η = 1/(i+1)` and `r < 1/(i+1)`. -/
theorem Submission.dor_lmbsf_density_directions : ∀ (d : ℕ) (Z : Set (Euclid d)) (y : Euclid d), Tendsto (fun r => volume (Z ∩ closedBall y r) / volume (closedBall y r)) (𝓝[>] 0) (𝓝 1) → ∀ v : Euclid d, ‖v‖ = 1 → ∃ ys : ℕ → Euclid d, (∀ i, ys i ∈ Z ∧ ys i ≠ y) ∧ Tendsto ys atTop (𝓝 y) ∧ Tendsto (fun i => ‖ys i - y‖⁻¹ • (ys i - y)) atTop (𝓝 v) := by
  intro d Z y hdens v hv
  -- the ball `B_{ηr/4}(y + (r/2)v)` lies in `B_r(y) ∖ {y}`, inside the `η`-cone around `v`
  have cone : ∀ η r : ℝ, 0 < η → η ≤ 1 → 0 < r → ∀ z ∈ ball (y + (r / 2) • v) (η * r / 4),
      ‖z - y‖ < r ∧ z ≠ y ∧ ‖‖z - y‖⁻¹ • (z - y) - v‖ < η := by
    intro η r hη hη1 hr z hz
    have hs : (0 : ℝ) < r / 2 := by positivity
    -- the offset `w = z - y - (r/2)v` of `z` from the centre has `‖w‖ < ηr/4 ≤ r/4`
    have hw : ‖z - y - (r / 2) • v‖ < η * r / 4 := by
      rwa [mem_ball, dist_eq_norm, sub_add_eq_sub_sub] at hz
    have hw' : ‖z - y - (r / 2) • v‖ < r / 4 := hw.trans_le (by nlinarith)
    have hsv : ‖(r / 2) • v‖ = r / 2 := by rw [norm_smul, hv, mul_one, Real.norm_of_nonneg hs.le]
    have hdiff : |‖z - y‖ - r / 2| ≤ ‖z - y - (r / 2) • v‖ := by
      simpa only [hsv] using abs_norm_sub_norm_le (z - y) ((r / 2) • v)
    obtain ⟨hlo, hhi⟩ := abs_le.1 hdiff
    have hpos : 0 < ‖z - y‖ := by linarith
    refine ⟨by linarith, fun h => by rw [h, sub_self, norm_zero] at hpos; exact lt_irrefl _ hpos,
      ?_⟩
    -- `‖z - y‖⁻¹ (z - y) - v = (‖z - y‖⁻¹ - (r/2)⁻¹) (z - y) + (r/2)⁻¹ w`
    have hdecomp : ‖z - y‖⁻¹ • (z - y) - v
        = (‖z - y‖⁻¹ - (r / 2)⁻¹) • (z - y) + (r / 2)⁻¹ • (z - y - (r / 2) • v) := by
      rw [sub_smul ‖z - y‖⁻¹ (r / 2)⁻¹ (z - y), smul_sub (r / 2)⁻¹ (z - y) ((r / 2) • v), smul_smul,
        inv_mul_cancel₀ hs.ne', one_smul]
      abel
    have h1 : ‖(‖z - y‖⁻¹ - (r / 2)⁻¹) • (z - y)‖ ≤ ‖z - y - (r / 2) • v‖ / (r / 2) := by
      have hne : ‖z - y‖ ≠ 0 := hpos.ne'
      have e : (‖z - y‖⁻¹ - (r / 2)⁻¹) * ‖z - y‖ = (r / 2 - ‖z - y‖) / (r / 2) := by
        field_simp
      calc ‖(‖z - y‖⁻¹ - (r / 2)⁻¹) • (z - y)‖ = |(‖z - y‖⁻¹ - (r / 2)⁻¹) * ‖z - y‖| := by
            rw [norm_smul, Real.norm_eq_abs, abs_mul, abs_norm]
        _ = |‖z - y‖ - r / 2| / (r / 2) := by rw [e, abs_div, abs_of_pos hs, abs_sub_comm]
        _ ≤ ‖z - y - (r / 2) • v‖ / (r / 2) := by gcongr
    have h2 : ‖(r / 2)⁻¹ • (z - y - (r / 2) • v)‖ = ‖z - y - (r / 2) • v‖ / (r / 2) := by
      rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hs.le), inv_mul_eq_div]
    calc ‖‖z - y‖⁻¹ • (z - y) - v‖
        ≤ ‖(‖z - y‖⁻¹ - (r / 2)⁻¹) • (z - y)‖ + ‖(r / 2)⁻¹ • (z - y - (r / 2) • v)‖ := by
          rw [hdecomp]; exact norm_add_le _ _
      _ ≤ ‖z - y - (r / 2) • v‖ / (r / 2) + ‖z - y - (r / 2) • v‖ / (r / 2) := by
          rw [h2]; linarith
      _ < η := by rw [← add_div, div_lt_iff₀ hs]; linarith
  -- for `0 < η ≤ 1`, `Z` meets `B_{ηr/4}(y + (r/2)v)` for all small `r > 0`: otherwise
  -- `Lᵈ(Z ∩ B̄_r(y)) ≤ Lᵈ(B̄_r(y)) - Lᵈ(B_{ηr/4}(y + (r/2)v)) = (1 - (η/4)ᵈ) Lᵈ(B̄_r(y))`
  have hit : ∀ η : ℝ, 0 < η → η ≤ 1 → ∃ r₀ : ℝ, 0 < r₀ ∧ ∀ r : ℝ, 0 < r → r < r₀ →
      ∃ z ∈ Z, z ∈ ball (y + (r / 2) • v) (η * r / 4) := by
    intro η hη hη1
    have hκ : ENNReal.ofReal ((η / 4) ^ d) ≠ 0 := by
      rw [Ne, ENNReal.ofReal_eq_zero, not_le]; positivity
    obtain ⟨r₀, hr₀, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1
      (hdens.eventually_const_lt (ENNReal.sub_lt_self ENNReal.one_ne_top one_ne_zero hκ))
    refine ⟨r₀, hr₀, fun r hr hrr₀ => ?_⟩
    by_contra! hZ
    have hB : ball (y + (r / 2) • v) (η * r / 4) ⊆ closedBall y r := fun z hz => by
      rw [mem_closedBall, dist_eq_norm]; exact (cone η r hη hη1 hr z hz).1.le
    have hvol : volume (ball (y + (r / 2) • v) (η * r / 4))
        = ENNReal.ofReal ((η / 4) ^ d) * volume (closedBall y r) := by
      rw [Measure.addHaar_ball_of_pos volume _ (by positivity : (0 : ℝ) < η * r / 4),
        Measure.addHaar_closedBall volume _ hr.le, finrank_euclideanSpace_fin, ← mul_assoc,
        ← ENNReal.ofReal_mul (by positivity), ← mul_pow, show η / 4 * r = η * r / 4 by ring]
    have hle : volume (Z ∩ closedBall y r)
        ≤ (1 - ENNReal.ofReal ((η / 4) ^ d)) * volume (closedBall y r) :=
      calc volume (Z ∩ closedBall y r)
          ≤ volume (closedBall y r \ ball (y + (r / 2) • v) (η * r / 4)) :=
            measure_mono fun z hz => ⟨hz.2, hZ z hz.1⟩
        _ = volume (closedBall y r) - volume (ball (y + (r / 2) • v) (η * r / 4)) :=
            measure_sdiff hB measurableSet_ball.nullMeasurableSet measure_ball_lt_top.ne
        _ = (1 - ENNReal.ofReal ((η / 4) ^ d)) * volume (closedBall y r) := by
            rw [hvol, ENNReal.sub_mul fun _ _ => measure_closedBall_lt_top.ne, one_mul]
    have hgt : 1 - ENNReal.ofReal ((η / 4) ^ d)
        < volume (Z ∩ closedBall y r) / volume (closedBall y r) := hsub ⟨hr, hrr₀⟩
    exact lt_irrefl _ (hgt.trans_le (ENNReal.div_le_of_le_mul hle))
  -- take `η = 1/(i+1)` and `0 < rᵢ < min(r₀, 1/(i+1))`
  have hη : ∀ i : ℕ, (0 : ℝ) < 1 / ((i : ℝ) + 1) := fun i => by positivity
  have hη1 : ∀ i : ℕ, 1 / ((i : ℝ) + 1) ≤ 1 := fun i =>
    (div_le_one (by positivity)).2 (by linarith [(Nat.cast_nonneg i : (0 : ℝ) ≤ i)])
  have hseq : ∀ i : ℕ, ∃ z ∈ Z, ∃ r : ℝ, 0 < r ∧ r < 1 / ((i : ℝ) + 1) ∧
      z ∈ ball (y + (r / 2) • v) (1 / ((i : ℝ) + 1) * r / 4) := by
    intro i
    obtain ⟨r₀, hr₀, h⟩ := hit _ (hη i) (hη1 i)
    have hm : 0 < min r₀ (1 / ((i : ℝ) + 1)) := lt_min hr₀ (hη i)
    obtain ⟨z, hzZ, hz⟩ := h (min r₀ (1 / ((i : ℝ) + 1)) / 2) (by positivity)
      (by linarith [min_le_left r₀ (1 / ((i : ℝ) + 1))])
    exact ⟨z, hzZ, _, by positivity, by linarith [min_le_right r₀ (1 / ((i : ℝ) + 1))], hz⟩
  choose ys hysZ rs hrs hrsi hysB using hseq
  have hcone := fun i => cone _ (rs i) (hη i) (hη1 i) (hrs i) (ys i) (hysB i)
  refine ⟨ys, fun i => ⟨hysZ i, (hcone i).2.1⟩, ?_, ?_⟩
  · rw [tendsto_iff_norm_sub_tendsto_zero]
    exact squeeze_zero (fun i => norm_nonneg _) (fun i => ((hcone i).1.trans (hrsi i)).le)
      tendsto_one_div_add_atTop_nhds_zero_nat
  · rw [tendsto_iff_norm_sub_tendsto_zero]
    exact squeeze_zero (fun i => norm_nonneg _) (fun i => (hcone i).2.2.le)
      tendsto_one_div_add_atTop_nhds_zero_nat

/-- **Chart pieces of a rectifiable set carrying a Lipschitz function** (Simon Ch. 3, Lemma 1.2,
Remarks 1.3 and 1.5(2), 2.1).  Given (TL), `M` is covered, up to an `H^{n+1}`-null set, by compact
pieces `ψⱼ(Cⱼ)` of injective `C¹` immersions `ψⱼ : Vⱼ → U` with `f ∘ ψⱼ = Fⱼ ∈ C¹` on `Cⱼ`
(index `j = Nat.pair s k`: piece `k` of chart `s`).  These are refined to disjoint Borel pieces
`ψⱼ(Yⱼ) ⊆ M` at whose points `TₓM = Dψⱼ(y)(ℝ^{n+1})` and `|DFⱼ(y)e| ≤ L|Dψⱼ(y)e|`; the tangential
lifts `Dψⱼ(DψⱼᵀDψⱼ)⁻¹∇Fⱼ` glue to a Borel `g` with `|g| ≤ L` (the gradient `∇^M f`). -/
theorem Submission.dor_lmbsf_lipschitz_chart_pieces : (∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q) → ∀ (P n : ℕ) (U M : Set (Euclid P)) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → MeasurableSet M → M ⊆ U → CountablyRectifiable (n + 1) M → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n + 1] (M ∩ K) ≠ ∞) → LipschitzWith L f → ∃ (V C Y : ℕ → Set (Euclid (n + 1))) (ψ : ℕ → Euclid (n + 1) → Euclid P) (F : ℕ → Euclid (n + 1) → ℝ) (g : Euclid P → Euclid P), (∀ j, IsOpen (V j) ∧ ContDiffOn ℝ 1 (ψ j) (V j) ∧ InjOn (ψ j) (V j) ∧ (∀ y ∈ V j, Injective (fderiv ℝ (ψ j) y)) ∧ ψ j '' V j ⊆ U) ∧ (∀ j, IsCompact (C j) ∧ C j ⊆ V j ∧ MeasurableSet (Y j) ∧ Y j ⊆ C j ∧ ContDiff ℝ 1 (F j)) ∧ (∀ j, ψ j '' Y j ⊆ M) ∧ Pairwise (fun i j => Disjoint (ψ i '' Y i) (ψ j '' Y j)) ∧ μHE[n + 1] (M \ ⋃ j, ψ j '' Y j) = 0 ∧ (∀ j, ∀ y ∈ Y j, f (ψ j y) = F j y ∧ HasApproximateTangentSpaceAt (n + 1) M (ψ j y) (LinearMap.range (fderiv ℝ (ψ j) y : Euclid (n + 1) →ₗ[ℝ] Euclid P))) ∧ Measurable g ∧ (∀ x, ‖g x‖ ≤ L) ∧ (∀ x, (∀ j, x ∉ ψ j '' Y j) → g x = 0) ∧ ∀ j, ∀ y ∈ Y j, g (ψ j y) ∈ LinearMap.range (fderiv ℝ (ψ j) y : Euclid (n + 1) →ₗ[ℝ] Euclid P) ∧ ∀ e : Euclid (n + 1), inner ℝ (g (ψ j y)) (fderiv ℝ (ψ j) y e) = fderiv ℝ (F j) y e := by
  intro TL P n U M f L hU hMmeas hMU hrect hfin hf
  -- `M ⊆ N₀ ∪ ⋃ₗ Nₗ` with `H^{n+1}(N₀) = 0` and embedded `C¹` submanifolds `Nₗ`
  obtain ⟨N₀, N, hN₀, hN, hMN⟩ := Submission.dor_lmbsf_rectifiable_c1_cover P (n + 1) M hrect
  -- countably many charts `ψₛ : Vₛ → U` with `M ⊆ N₀ ∪ ⋃ₛ ψₛ(Vₛ)`
  obtain ⟨V, ψ, hchart, hMV⟩ :=
    Submission.dor_lmbsf_cp_submanifold_chart_cover P (n + 1) U M N₀ N hU hMU hN hMN
  -- compact pieces `C s k ⊆ int C' s k`, `C' s k ⊆ Vₛ`, with `f ∘ ψₛ = F s k` on `C s k`,
  -- covering `Vₛ` up to a Lebesgue-null set
  choose C C' F hpiece hnull using fun s =>
    Submission.dor_lmbsf_cp_chart_c1_pieces Submission.dor_lmbsf_lipschitz_c1_approx (n + 1) P
      (V s) (ψ s) f L (hchart s).1 (hchart s).2.1 hf
  -- the pieces miss only `N₀ ∪ ⋃ₛ ψₛ(Vₛ ∖ ⋃ₖ C s k)`, which is `H^{n+1}`-null
  have hcov : μHE[n + 1] (M \ ⋃ j, ψ (Nat.unpair j).1 '' C (Nat.unpair j).1 (Nat.unpair j).2)
      = 0 := by
    refine measure_mono_null ?_ (measure_union_null hN₀ (measure_iUnion_null fun s =>
      Submission.dor_lmbsf_cp_c1_image_null (n + 1) P (V s) (V s \ ⋃ k, C s k) (ψ s)
        (hchart s).1 (hchart s).2.1 sdiff_subset (hnull s)))
    rintro x ⟨hxM, hx⟩
    rcases hMV hxM with hx₀ | hx₁
    · exact mem_union_left _ hx₀
    · obtain ⟨s, y, hyV, rfl⟩ := mem_iUnion.1 hx₁
      refine mem_union_right _ (mem_iUnion.2 ⟨s, y, ⟨hyV, fun hyC => hx ?_⟩, rfl⟩)
      obtain ⟨k, hyk⟩ := mem_iUnion.1 hyC
      exact mem_iUnion.2
        ⟨Nat.pair s k, by simpa only [Nat.unpair_pair] using mem_image_of_mem (ψ s) hyk⟩
  -- index the pieces by `j = Nat.pair s k`
  obtain ⟨Vj, ψj, Cj, C'j, Fj, hchartj, hpiecej, hcovj⟩ : ∃ (Vj : ℕ → Set (Euclid (n + 1)))
      (ψj : ℕ → Euclid (n + 1) → Euclid P) (Cj C'j : ℕ → Set (Euclid (n + 1)))
      (Fj : ℕ → Euclid (n + 1) → ℝ),
      (∀ j, IsOpen (Vj j) ∧ ContDiffOn ℝ 1 (ψj j) (Vj j) ∧ InjOn (ψj j) (Vj j) ∧
        (∀ y ∈ Vj j, Injective (fderiv ℝ (ψj j) y)) ∧ ψj j '' Vj j ⊆ U) ∧
      (∀ j, IsCompact (Cj j) ∧ IsCompact (C'j j) ∧ Convex ℝ (C'j j) ∧ Cj j ⊆ interior (C'j j) ∧
        C'j j ⊆ Vj j ∧ ContDiff ℝ 1 (Fj j) ∧ ∀ y ∈ Cj j, f (ψj j y) = Fj j y) ∧
      μHE[n + 1] (M \ ⋃ j, ψj j '' Cj j) = 0 :=
    ⟨fun j => V (Nat.unpair j).1, fun j => ψ (Nat.unpair j).1,
      fun j => C (Nat.unpair j).1 (Nat.unpair j).2, fun j => C' (Nat.unpair j).1 (Nat.unpair j).2,
      fun j => F (Nat.unpair j).1 (Nat.unpair j).2, fun j => hchart _, fun j => hpiece _ _, hcov⟩
  have hCV : ∀ j, Cj j ⊆ Vj j := fun j =>
    (hpiecej j).2.2.2.1.trans (interior_subset.trans (hpiecej j).2.2.2.2.1)
  -- (TL) and the tangent planes of `ψⱼ(C'ⱼ)`: `TₓM = Dψⱼ(y)(ℝ^{n+1})` a.e. on `M ∩ ψⱼ(Cⱼ)`
  have htan : ∀ j, ∀ᵐ x ∂(μHE[n + 1].restrict (M ∩ ψj j '' Cj j)), ∀ y ∈ Cj j, ψj j y = x →
      HasApproximateTangentSpaceAt (n + 1) M x
        (LinearMap.range (fderiv ℝ (ψj j) y : Euclid (n + 1) →ₗ[ℝ] Euclid P)) := by
    intro j
    obtain ⟨hVo, hψc, hψi, hψd, hψU⟩ := hchartj j
    obtain ⟨hCc, hC'c, hC'conv, hCC', hC'V, -, -⟩ := hpiecej j
    exact Submission.dor_lmbsf_cp_chart_tangent_ae TL P (n + 1) U M (Cj j) (C'j j) (ψj j) hU
      hMmeas hMU hfin (hψc.mono hC'V) ((image_mono hC'V).trans hψU) hCc hC'c hC'conv hCC'
      fun y hy => Submission.dor_lmbsf_c1_image_approxTangent (n + 1) P (Vj j) (C'j j) (ψj j) y
        hVo hψc hC'c hC'V (hψi.mono hC'V) hy (hψd y (hC'V (interior_subset hy)))
  -- density points: `|DFⱼ(y)e| ≤ L|Dψⱼ(y)e|` off a Lebesgue-null set, whose image is null
  have hbd : ∀ j, ∀ᵐ x ∂(μHE[n + 1].restrict (M ∩ ψj j '' Cj j)), ∀ y ∈ Cj j, ψj j y = x →
      ∀ e : Euclid (n + 1), |fderiv ℝ (Fj j) y e| ≤ (L : ℝ) * ‖fderiv ℝ (ψj j) y e‖ := by
    intro j
    obtain ⟨hVo, hψc, -, -, -⟩ := hchartj j
    obtain ⟨hCc, -, -, -, -, hFc, hfF⟩ := hpiecej j
    have hae := ae_iff.1 (Submission.dor_lmbsf_cp_gradient_bound_ae
      Submission.dor_lmbsf_density_directions (n + 1) P (Cj j) (Fj j) (ψj j) f L hCc.measurableSet
      (fun y hy => ⟨hFc.differentiable one_ne_zero y,
        (hψc.differentiableOn one_ne_zero).differentiableAt (hVo.mem_nhds (hCV j hy))⟩) hfF hf)
    refine ae_restrict_of_ae (ae_iff.2 (measure_mono_null ?_
      (Submission.dor_lmbsf_cp_c1_image_null (n + 1) P (Vj j) _ (ψj j) hVo hψc ?_ hae)))
    · intro x hx
      by_contra hx'
      refine hx fun y hy hyx => ?_
      subst hyx
      by_contra hbad
      exact hx' ⟨y, fun h => hbad (h hy), rfl⟩
    · exact fun y hy => hCV j (not_imp.1 hy).1
  -- disjoint Borel pieces `ψⱼ(Yⱼ) ⊆ M` consisting of good points
  obtain ⟨Y, hY, hdisj, hYnull⟩ := Submission.dor_lmbsf_cp_disjoint_refinement (n + 1) P
    μHE[n + 1] M Cj ψj
    (fun j y => HasApproximateTangentSpaceAt (n + 1) M (ψj j y)
        (LinearMap.range (fderiv ℝ (ψj j) y : Euclid (n + 1) →ₗ[ℝ] Euclid P)) ∧
      ∀ e : Euclid (n + 1), |fderiv ℝ (Fj j) y e| ≤ (L : ℝ) * ‖fderiv ℝ (ψj j) y e‖)
    hMmeas (fun j => ⟨(hpiecej j).1, (hchartj j).2.1.continuousOn.mono (hCV j)⟩) hcovj
    fun j => by
      filter_upwards [htan j, hbd j] with x h₁ h₂ y hy hyx
      subst hyx
      exact ⟨h₁ y hy rfl, h₂ y hy rfl⟩
  have hYV : ∀ j, Y j ⊆ Vj j := fun j => (hY j).2.1.trans (hCV j)
  -- tangential lifts `Φⱼ` of `DFⱼ` (e.g. `Dψⱼ(DψⱼᵀDψⱼ)⁻¹∇Fⱼ`), glued into a Borel `g`,
  -- zero off `⋃ⱼ ψⱼ(Yⱼ)`
  choose Φ hΦc hΦ using fun j => Submission.dor_lmbsf_cp_chart_tangent_lift (n + 1) P (Vj j)
    (ψj j) (Fj j) (hchartj j).1 (hchartj j).2.1 (hchartj j).2.2.2.1 (hpiecej j).2.2.2.2.2.1
  obtain ⟨g, hgm, hgval, hg0⟩ := Submission.dor_lmbsf_cp_measurable_glue (n + 1) P Y ψj Φ
    (fun j => ⟨(hY j).1, (hchartj j).2.1.continuousOn.mono (hYV j),
      (hchartj j).2.2.1.mono (hYV j), (hΦc j).mono (hYV j)⟩) hdisj
  refine ⟨Vj, Cj, Y, ψj, Fj, g, hchartj, fun j => ⟨(hpiecej j).1, hCV j, (hY j).1, (hY j).2.1,
    (hpiecej j).2.2.2.2.2.1⟩, fun j => (hY j).2.2.1, hdisj, hYnull,
    fun j y hy => ⟨(hpiecej j).2.2.2.2.2.2 y ((hY j).2.1 hy), ((hY j).2.2.2 y hy).1⟩, hgm,
    fun x => ?_, hg0, fun j y hy => ?_⟩
  · by_cases hx : ∃ j, x ∈ ψj j '' Y j
    · obtain ⟨j, y, hy, rfl⟩ := hx
      rw [hgval j y hy]
      exact (hΦ j y (hYV j hy)).2.2 L ((hY j).2.2.2 y hy).2
    · rw [hg0 x fun j hj => hx ⟨j, hj⟩, norm_zero]
      exact L.coe_nonneg
  · rw [hgval j y hy]
    exact ⟨(hΦ j y (hYV j hy)).1, (hΦ j y (hYV j hy)).2.1⟩

/-- **Slice area formula and Tonelli** (Simon Ch. 2, (3.5), sliced along the first coordinate).
Let `S ⊆ ℝⁿ⁺¹` be Borel and `Φ : ℝⁿ⁺¹ → ℝᴾ` differentiable with injective `DΦ(w)` at every
`w ∈ S` and injective on `S`; put `J'(w) = √det(⟨DΦ(w)eᵢ₊₁, DΦ(w)eⱼ₊₁⟩)`.  Then for Borel `φ ≥ 0`,
`t ↦ ∫_{Φ(S ∩ {w₀ = t})} φ dHⁿ` is a.e.-measurable and
`∫_ℝ ∫_{Φ(S ∩ {w₀ = t})} φ dHⁿ dt = ∫_S J'(w) φ(Φ(w)) dw`.  With `ins_t(z) = (t, z)` and
`ι(z) = (0, z)`, the slice `Φ(S ∩ {w₀ = t})` is the injective image of `S_t = ins_t⁻¹(S)` under
`Φ ∘ ins_t`, whose derivative `DΦ(ins_t z) ∘ ι` is injective with `ι eₖ = eₖ₊₁`; so the Gram area
formula (`codim1_lura_gram_area_formula`) gives `∫_{ℝⁿ} H(ins_t z) dz` for the Borel integrand
`H = 1_S · J' · (φ ∘ Φ)`.  The splitting `(t, z) ↦ ins_t(z)`, `ℝ × ℝⁿ ≅ ℝⁿ⁺¹`, is measure
preserving (`ofLp`, `piFinSuccAbove 0`, `toLp`), and Tonelli gives both claims. -/
theorem Submission.dor_lmbsf_pc_slice_area_tonelli : ∀ (P n : ℕ) (Φ : Euclid (n + 1) → Euclid P) (S : Set (Euclid (n + 1))), MeasurableSet S → (∀ w ∈ S, DifferentiableAt ℝ Φ w) → (∀ w ∈ S, Injective (fderiv ℝ Φ w)) → InjOn Φ S → ∀ φ : Euclid P → ℝ≥0∞, Measurable φ → AEMeasurable (fun t : ℝ => ∫⁻ x in Φ '' (S ∩ {w | w 0 = t}), φ x ∂μHE[n]) ∧ ∫⁻ t : ℝ, (∫⁻ x in Φ '' (S ∩ {w | w 0 = t}), φ x ∂μHE[n]) = ∫⁻ w in S, ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun i j : Fin n => inner ℝ (fderiv ℝ Φ w (EuclideanSpace.single i.succ 1)) (fderiv ℝ Φ w (EuclideanSpace.single j.succ 1))))) * φ (Φ w) ∂volume := by
  have hR := Submission.codim1_lura_gram_area_formula
  intro P n Φ S hS hd hinj hInj φ hφ
  classical
  -- the slice embeddings `z ↦ (t, z)` and their common linear part `ι`
  let ins : ℝ → Euclid n → Euclid (n + 1) := fun t z =>
    WithLp.toLp 2 (Fin.cons t (WithLp.ofLp z) : Fin (n + 1) → ℝ)
  let ιlin : Euclid n →ₗ[ℝ] Euclid (n + 1) :=
    { toFun := fun z => WithLp.toLp 2 (Fin.cons 0 (WithLp.ofLp z) : Fin (n + 1) → ℝ)
      map_add' := by
        intro y z; ext j; refine Fin.cases ?_ (fun k => ?_) j <;> simp
      map_smul' := by
        intro c y; ext j; refine Fin.cases ?_ (fun k => ?_) j <;> simp }
  let ι : Euclid n →L[ℝ] Euclid (n + 1) := LinearMap.toContinuousLinearMap ιlin
  have hins : ∀ t z, ins t z = ins t 0 + ι z := by
    intro t z; ext j; refine Fin.cases ?_ (fun k => ?_) j <;> simp [ins, ι, ιlin]
  have hinsD : ∀ t z, HasFDerivAt (ins t) ι z := by
    intro t z
    have : ins t = fun z => ins t 0 + ι z := funext (hins t)
    rw [this]
    exact ι.hasFDerivAt.const_add _
  have hιe : ∀ k : Fin n, ι (EuclideanSpace.single k 1) = EuclideanSpace.single k.succ 1 := by
    intro k; ext j; refine Fin.cases ?_ (fun l => ?_) j <;> simp [ι, ιlin, Pi.single_apply]
  -- slice Jacobian and integrand
  let J' : Euclid (n + 1) → ℝ := fun w => Real.sqrt (Matrix.det (Matrix.of fun i j : Fin n =>
    inner ℝ (fderiv ℝ Φ w (EuclideanSpace.single i.succ 1)) (fderiv ℝ Φ w (EuclideanSpace.single j.succ 1))))
  have hJ'm : Measurable J' := by
    have hc : Continuous (fun L : Euclid (n + 1) →L[ℝ] Euclid P => Real.sqrt (Matrix.det
        (Matrix.of fun i j : Fin n => inner ℝ (L (EuclideanSpace.single i.succ 1))
          (L (EuclideanSpace.single j.succ 1))))) := by
      refine Real.continuous_sqrt.comp (Continuous.matrix_det ?_)
      refine continuous_pi fun k => continuous_pi fun l => ?_
      exact (continuous_id.clm_apply continuous_const).inner (continuous_id.clm_apply continuous_const)
    exact hc.measurable.comp (measurable_fderiv ℝ Φ)
  let H : Euclid (n + 1) → ℝ≥0∞ := S.indicator (fun w => ENNReal.ofReal (J' w) * φ (Φ w))
  have hΦc : ContinuousOn Φ S := fun w hw => (hd w hw).continuousAt.continuousWithinAt
  have hHm : Measurable H := by
    have hpw : Measurable (S.piecewise Φ (fun _ => 0)) :=
      hΦc.measurable_piecewise continuousOn_const hS
    have : H = S.indicator (fun w => ENNReal.ofReal (J' w) * φ (S.piecewise Φ (fun _ => 0) w)) := by
      ext w
      by_cases hw : w ∈ S
      · simp [H, hw, Set.piecewise_eq_of_mem]
      · simp [H, hw]
    rw [this]
    exact ((hJ'm.ennreal_ofReal).mul (hφ.comp hpw)).indicator hS
  -- the inner integral, slice by slice
  have hinner : ∀ t : ℝ, ∫⁻ x in Φ '' (S ∩ {w | w 0 = t}), φ x ∂μHE[n] = ∫⁻ z, H (ins t z) := by
    intro t
    let St : Set (Euclid n) := ins t ⁻¹' S
    have hinsc : Continuous (ins t) := by
      have : ins t = fun z => ins t 0 + ι z := funext (hins t)
      rw [this]; exact continuous_const.add ι.continuous
    have hSt : MeasurableSet St := hinsc.measurable hS
    have himg : Φ '' (S ∩ {w | w 0 = t}) = (Φ ∘ ins t) '' St := by
      rw [image_comp]
      congr 1
      ext w
      constructor
      · rintro ⟨hwS, hwt⟩
        refine ⟨WithLp.toLp 2 (Fin.tail (WithLp.ofLp w)), ?_, ?_⟩
        · have : ins t (WithLp.toLp 2 (Fin.tail (WithLp.ofLp w))) = w := by
            ext j; refine Fin.cases ?_ (fun k => ?_) j
            · simpa [ins] using hwt.symm
            · simp [ins, Fin.tail]
          show ins t _ ∈ S
          rw [this]; exact hwS
        · ext j; refine Fin.cases ?_ (fun k => ?_) j
          · simpa [ins] using hwt.symm
          · simp [ins, Fin.tail]
      · rintro ⟨z, hz, rfl⟩
        exact ⟨hz, by simp [ins]⟩
    have hdt : ∀ z ∈ St, DifferentiableAt ℝ (Φ ∘ ins t) z := fun z hz =>
      (hd _ hz).comp z (hinsD t z).differentiableAt
    have hDt : ∀ z ∈ St, fderiv ℝ (Φ ∘ ins t) z = (fderiv ℝ Φ (ins t z)).comp ι := fun z hz =>
      ((hd _ hz).hasFDerivAt.comp z (hinsD t z)).fderiv
    have hιinj : Injective ι := by
      intro y z hyz
      ext k
      have := congrArg (fun v : Euclid (n + 1) => v k.succ) hyz
      simpa [ι, ιlin] using this
    have hinjt : ∀ z ∈ St, Injective (fderiv ℝ (Φ ∘ ins t) z) := by
      intro z hz
      rw [hDt z hz]
      exact (hinj _ hz).comp hιinj
    have hInjt : InjOn (Φ ∘ ins t) St := by
      intro y hy z hz hyz
      have h1 : ins t y = ins t z := hInj hy hz hyz
      have h2 : ι y = ι z := by
        rw [hins t y, hins t z] at h1; exact add_left_cancel h1
      exact hιinj h2
    rw [himg, (hR n P (Φ ∘ ins t)).2 St hSt hdt hinjt hInjt φ, ← lintegral_indicator hSt]
    congr 1
    ext z
    by_cases hz : z ∈ St
    · have hz' : ins t z ∈ S := hz
      simp only [indicator_of_mem hz, H, indicator_of_mem hz', hDt z hz, J',
        ContinuousLinearMap.comp_apply, hιe, comp_apply]
    · have hz' : ins t z ∉ S := hz
      simp only [indicator_of_notMem hz, H, indicator_of_notMem hz']
  -- the volume-preserving splitting `ℝ × ℝⁿ ≃ ℝⁿ⁺¹`
  have he : MeasurePreserving (fun p : ℝ × Euclid n => ins p.1 p.2) volume volume := by
    have h1 : MeasurePreserving (Prod.map (id : ℝ → ℝ) (WithLp.ofLp : Euclid n → (Fin n → ℝ)))
        (volume : Measure (ℝ × Euclid n)) (volume : Measure (ℝ × (Fin n → ℝ))) :=
      (MeasurePreserving.id volume).prod (PiLp.volume_preserving_ofLp (Fin n))
    have h2 := (volume_preserving_piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) 0).symm
    have h3 := PiLp.volume_preserving_toLp (Fin (n + 1))
    have h := h3.comp (h2.comp h1)
    convert h using 1
    funext p
    simp [ins, MeasurableEquiv.piFinSuccAbove_symm_apply]
    rfl
  have hHe : Measurable (fun p : ℝ × Euclid n => H (ins p.1 p.2)) := hHm.comp he.measurable
  refine ⟨?_, ?_⟩
  · simp_rw [hinner]
    exact hHe.lintegral_prod_right'.aemeasurable
  · simp_rw [hinner]
    rw [← lintegral_indicator hS]
    change ∫⁻ t, ∫⁻ z, H (ins t z) = ∫⁻ w, H w
    rw [← he.lintegral_comp hHm]
    exact (lintegral_prod _ hHe.aemeasurable).symm

/-- **Co-area formula for a patch parametrized over the slices `{w(0) = t}`** (Simon Ch. 2, §6).
Let `S ⊆ ℝⁿ⁺¹` be Borel, `Φ : ℝⁿ⁺¹ → ℝᴾ` differentiable with injective `DΦ(w)` at every `w ∈ S`
and injective on `S`, and let `G(Φ(w)) ∈ DΦ(w)(ℝⁿ⁺¹)` with `⟨G(Φ(w)), DΦ(w)e⟩ = e(0)` for
`w ∈ S`.  Then for Borel `φ ≥ 0`, `t ↦ ∫_{Φ(S ∩ {w(0) = t})} φ dHⁿ` is a.e.-measurable and
`∫_ℝ ∫_{Φ(S ∩ {w(0) = t})} φ dHⁿ dt = ∫_{Φ(S)} |G| φ dHⁿ⁺¹`.
Let `J(w)`, `J'(w)` be the Gram-determinant Jacobians of `DΦ(w)` on `e₀, …, eₙ` and on
`e₁, …, eₙ`.  Slicing gives `∫_ℝ ∫_{Φ(S ∩ {w(0) = t})} φ dHⁿ dt = ∫_S J'(w) φ(Φ(w)) dw`, the area
formula gives `∫_{Φ(S)} |G| φ dHⁿ⁺¹ = ∫_S J(w) |G(Φ(w))| φ(Φ(w)) dw`, and at `w ∈ S` the vector
`u = G(Φ(w))` lies in the span of the `aₗ = DΦ(w)eₗ` with `⟨u, aₗ⟩ = δₗ₀`, so the Gram cofactor
identity `det(⟨aᵢ₊₁, aⱼ₊₁⟩) = |u|² det(⟨aᵢ, aⱼ⟩)` gives `J'(w) = |u| J(w)`. -/
theorem Submission.dor_lmbsf_pc_param_coarea : ∀ (P n : ℕ) (Φ : Euclid (n + 1) → Euclid P) (S : Set (Euclid (n + 1))) (G : Euclid P → Euclid P), MeasurableSet S → (∀ w ∈ S, DifferentiableAt ℝ Φ w) → (∀ w ∈ S, Injective (fderiv ℝ Φ w)) → InjOn Φ S → (∀ w ∈ S, G (Φ w) ∈ LinearMap.range (fderiv ℝ Φ w : Euclid (n + 1) →ₗ[ℝ] Euclid P) ∧ ∀ e : Euclid (n + 1), inner ℝ (G (Φ w)) (fderiv ℝ Φ w e) = e 0) → ∀ φ : Euclid P → ℝ≥0∞, Measurable φ → AEMeasurable (fun t : ℝ => ∫⁻ x in Φ '' (S ∩ {w | w 0 = t}), φ x ∂μHE[n]) ∧ ∫⁻ t : ℝ, (∫⁻ x in Φ '' (S ∩ {w | w 0 = t}), φ x ∂μHE[n]) = ∫⁻ x in Φ '' S, ‖G x‖ₑ * φ x ∂μHE[n + 1] := by
  intro P n Φ S G hS hd hinj hInj hG φ hφ
  -- slicing: the slice integral is a.e.-measurable in `t` and integrates to `∫_S J' · φ ∘ Φ`
  obtain ⟨hmeas, heq⟩ :=
    Submission.dor_lmbsf_pc_slice_area_tonelli P n Φ S hS hd hinj hInj φ hφ
  refine ⟨hmeas, ?_⟩
  -- area formula with weight `|G| φ`: `∫_{Φ(S)} |G| φ dHⁿ⁺¹ = ∫_S J · (|G| φ) ∘ Φ`
  rw [heq, (Submission.codim1_lura_gram_area_formula (n + 1) P Φ).2 S hS hd hinj hInj
    (fun x => ‖G x‖ₑ * φ x)]
  -- the integrands agree on `S`: `J'(w) = |G(Φ(w))| J(w)`
  refine setLIntegral_congr_fun hS fun w hw => ?_
  obtain ⟨⟨v, hv⟩, hinner⟩ := hG w hw
  set a : Fin (n + 1) → Euclid P := fun i => fderiv ℝ Φ w (EuclideanSpace.single i 1)
  -- `u = G(Φ(w)) = DΦ(w)v = Σₗ vₗ aₗ` lies in the span of the `aₗ`
  have hspan : G (Φ w) ∈ Submodule.span ℝ (Set.range a) := by
    rw [Submodule.mem_span_range_iff_exists_fun]
    refine ⟨fun i => v i, ?_⟩
    have hv' : fderiv ℝ Φ w v = G (Φ w) := hv
    rw [← hv']
    have hvsum : v = ∑ i, v i • EuclideanSpace.single i (1 : ℝ) := by
      ext j
      simp [Finset.sum_apply, Pi.single_apply, Finset.sum_ite_eq]
    conv_rhs => rw [hvsum]
    simp [a, map_sum, map_smul]
  -- `⟨u, aₗ⟩ = eₗ(0) = δₗ₀`
  have ha0 : inner ℝ (G (Φ w)) (a 0) = 1 := by
    simp [a, hinner]
  have hak : ∀ k : Fin n, inner ℝ (G (Φ w)) (a k.succ) = 0 := by
    intro k
    simp [a, hinner, Fin.succ_ne_zero]
  -- Gram cofactor identity, then square roots
  have hgram := Submission.dor_lmbsf_pc_gram_det_succ_eq P n a (G (Φ w)) hspan ha0 hak
  simp only [a] at hgram
  rw [hgram, Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq (norm_nonneg _),
    ENNReal.ofReal_mul (norm_nonneg _), ofReal_norm]
  ring
/-- Step 6 of the oriented graph chart (zero-scale limit plane, Simon 7.5.8): the inverse function
theorem with a `C¹` local inverse on an open target (as used in Simon Ch. 2, §4).  If `φ` is `C¹`
on an open `V ∋ z₀` and `Dφ(z₀)` is injective, then `Dφ(z₀)` is invertible, so
`V₁ = V ∩ {z : Dφ(z) invertible}` is an open neighbourhood of `z₀`.  The inverse function theorem
restricted to `V₁` gives `φ : V₀ → O` bijective with inverse `χ`, and `χ` is `C¹` at every
`a ∈ O` because `Dφ(χ(a))` is invertible. -/
theorem Submission.codim1_zsl_gc_local_inverse : ∀ (d : ℕ) (φ : Euclid d → Euclid d) (V : Set (Euclid d)) (z₀ : Euclid d), IsOpen V → z₀ ∈ V → ContDiffOn ℝ 1 φ V → Injective (fderiv ℝ φ z₀) → ∃ (V₀ O : Set (Euclid d)) (χ : Euclid d → Euclid d), IsOpen V₀ ∧ IsOpen O ∧ z₀ ∈ V₀ ∧ V₀ ⊆ V ∧ ContDiffOn ℝ 1 χ O ∧ MapsTo χ O V₀ ∧ (∀ a ∈ O, φ (χ a) = a) ∧ ∀ z ∈ V₀, φ z ∈ O ∧ χ (φ z) = z := by
  intro d φ V z₀ hV hz₀ hφ hinj
  -- `Dφ(z₀)` is invertible (injective endomorphism of a finite-dimensional space)
  let L₀ : Euclid d ≃L[ℝ] Euclid d :=
    (LinearEquiv.ofInjectiveEndo
      ((fderiv ℝ φ z₀ : Euclid d →L[ℝ] Euclid d) : Euclid d →ₗ[ℝ] Euclid d)
      hinj).toContinuousLinearEquiv
  have hL₀ : (L₀ : Euclid d →L[ℝ] Euclid d) = fderiv ℝ φ z₀ := by
    ext x; rfl
  have hcd : ∀ z ∈ V, ContDiffAt ℝ 1 φ z := fun z hz => hφ.contDiffAt (hV.mem_nhds hz)
  have hcont : ContinuousOn (fderiv ℝ φ) V := hφ.continuousOn_fderiv_of_isOpen hV le_rfl
  -- the open set `V₁` where `Dφ` is invertible
  let V₁ : Set (Euclid d) :=
    V ∩ fderiv ℝ φ ⁻¹' range ((↑) : (Euclid d ≃L[ℝ] Euclid d) → Euclid d →L[ℝ] Euclid d)
  have hV₁ : IsOpen V₁ := hcont.isOpen_inter_preimage hV ContinuousLinearEquiv.isOpen
  have hz₀V₁ : z₀ ∈ V₁ := ⟨hz₀, L₀, hL₀⟩
  have hstrict : HasStrictFDerivAt φ (L₀ : Euclid d →L[ℝ] Euclid d) z₀ := by
    rw [hL₀]
    exact (hcd z₀ hz₀).hasStrictFDerivAt one_ne_zero
  -- the inverse function theorem, restricted to `V₁`
  obtain ⟨e, he, hz₀e, hsrc⟩ : ∃ e : OpenPartialHomeomorph (Euclid d) (Euclid d),
      ⇑e = φ ∧ z₀ ∈ e.source ∧ e.source ⊆ V₁ :=
    ⟨(hstrict.toOpenPartialHomeomorph φ).restrOpen V₁ hV₁, rfl,
      ⟨hstrict.mem_toOpenPartialHomeomorph_source, hz₀V₁⟩, inter_subset_right⟩
  subst he
  refine ⟨e.source, e.target, e.symm, e.open_source, e.open_target, hz₀e,
    fun z hz => (hsrc hz).1, ?_, e.mapsTo_symm, fun a ha => e.right_inv ha,
    fun z hz => ⟨e.map_source hz, e.left_inv hz⟩⟩
  -- `χ = e.symm` is `C¹` at each `a ∈ O`, since `Dφ(χ(a))` is invertible
  intro a ha
  obtain ⟨hV', L, hL⟩ := hsrc (e.map_target ha)
  have hd : HasFDerivAt e (L : Euclid d →L[ℝ] Euclid d) (e.symm a) := by
    rw [hL]
    exact ((hcd _ hV').differentiableAt one_ne_zero).hasFDerivAt
  exact (e.contDiffAt_symm ha hd (hcd _ hV')).contDiffWithinAt

/-- Straightening charts for the co-area step of the limsup mass bound (density one implies
regular, Simon 7.5 via the co-area formula of Ch. 2, §5): if `F : ℝ^{n+1} → ℝ` is `C¹`, then
`{DF ≠ 0}` is covered by countably many open sets `Ψ_q(B_q)`, where `B_q` is open and `Ψ_q` is
`C¹`, injective and with bijective derivative on `B_q`, and `F(Ψ_q(w)) = w(0)` on `B_q`.  Near `y₀`
with `DF(y₀) e_i ≠ 0` the map `Θ(y) = (F(y), y ∘ i.succAbove)` has injective derivative at `y₀`, so
its local inverse `χ` on an open `O` (`codim1_zsl_gc_local_inverse`) is such a chart with
`y₀ ∈ χ(O)`; second countability selects countably many of these charts. -/
theorem Submission.dor_lmbsf_pc_straightening_cover : ∀ (n : ℕ) (F : Euclid (n + 1) → ℝ), ContDiff ℝ 1 F → ∃ (B : ℕ → Set (Euclid (n + 1))) (Ψ : ℕ → Euclid (n + 1) → Euclid (n + 1)), (∀ q, IsOpen (B q)) ∧ (∀ q, ContDiffOn ℝ 1 (Ψ q) (B q)) ∧ (∀ q, InjOn (Ψ q) (B q)) ∧ (∀ q, ∀ w ∈ B q, Bijective (fderiv ℝ (Ψ q) w)) ∧ (∀ q, ∀ w ∈ B q, F (Ψ q w) = w 0) ∧ (∀ q, IsOpen (Ψ q '' B q)) ∧ {y | fderiv ℝ F y ≠ 0} ⊆ ⋃ q, Ψ q '' B q := by
  have hR3 := Submission.codim1_zsl_gc_local_inverse
  intro n F hF
  classical
  have hFd : Differentiable ℝ F := hF.differentiable one_ne_zero
  -- pointwise straightening
  have hloc : ∀ y₀ : Euclid (n + 1), fderiv ℝ F y₀ ≠ 0 →
      ∃ (B : Set (Euclid (n + 1))) (Ψ : Euclid (n + 1) → Euclid (n + 1)), IsOpen B ∧
        ContDiffOn ℝ 1 Ψ B ∧ InjOn Ψ B ∧ (∀ w ∈ B, Bijective (fderiv ℝ Ψ w)) ∧
        (∀ w ∈ B, F (Ψ w) = w 0) ∧ IsOpen (Ψ '' B) ∧ y₀ ∈ Ψ '' B := by
    intro y₀ hy₀
    have hexp : ∀ v : Euclid (n + 1), v = ∑ j, v j • EuclideanSpace.single j (1 : ℝ) := by
      intro v; ext j; simp [Finset.sum_apply, Pi.single_apply, Finset.sum_ite_eq]
    obtain ⟨i, hi⟩ : ∃ i : Fin (n + 1), fderiv ℝ F y₀ (EuclideanSpace.single i 1) ≠ 0 := by
      by_contra! h
      apply hy₀
      ext1 v
      rw [hexp v, map_sum]
      simp [h]
    -- the linear part `y ↦ (0, y ∘ i.succAbove)`
    let Llin : Euclid (n + 1) →ₗ[ℝ] Euclid (n + 1) :=
      { toFun := fun y => WithLp.toLp 2 (Fin.cons 0 (fun k => y (i.succAbove k)) : Fin (n + 1) → ℝ)
        map_add' := by
          intro y z; ext j; refine Fin.cases ?_ (fun k => ?_) j <;> simp
        map_smul' := by
          intro c y; ext j; refine Fin.cases ?_ (fun k => ?_) j <;> simp }
    let L : Euclid (n + 1) →L[ℝ] Euclid (n + 1) := LinearMap.toContinuousLinearMap Llin
    have hL0 : ∀ y, L y 0 = 0 := fun y => by simp [L, Llin]
    have hLs : ∀ y (k : Fin n), L y k.succ = y (i.succAbove k) := fun y k => by simp [L, Llin]
    let e0 : Euclid (n + 1) := EuclideanSpace.single 0 1
    let Θ : Euclid (n + 1) → Euclid (n + 1) := fun y => F y • e0 + L y
    have hΘ0 : ∀ y, Θ y 0 = F y := fun y => by simp [Θ, e0, hL0]
    have hΘc : ContDiff ℝ 1 Θ := (hF.smul contDiff_const).add L.contDiff
    have hΘD : ∀ y, fderiv ℝ Θ y = (fderiv ℝ F y).smulRight e0 + L := by
      intro y
      have h1 : HasFDerivAt (fun y => F y • e0) ((fderiv ℝ F y).smulRight e0) y :=
        (hFd y).hasFDerivAt.smul_const e0
      exact (h1.add L.hasFDerivAt).fderiv
    have hinj0 : Injective (fderiv ℝ Θ y₀) := by
      rw [hΘD y₀]
      have hker : ∀ h : Euclid (n + 1), ((fderiv ℝ F y₀).smulRight e0 + L) h = 0 → h = 0 := by
        intro h hh
        have hc0 := congrArg (fun v : Euclid (n + 1) => v 0) hh
        have hcs : ∀ k : Fin n, h (i.succAbove k) = 0 := by
          intro k
          have := congrArg (fun v : Euclid (n + 1) => v k.succ) hh
          simpa [e0, hLs, Fin.succ_ne_zero] using this
        have hhi : h = h i • EuclideanSpace.single i (1 : ℝ) := by
          ext j
          rcases Fin.eq_self_or_eq_succAbove i j with rfl | ⟨k, rfl⟩
          · simp
          · simp [hcs k, Fin.succAbove_ne]
        have hDF : fderiv ℝ F y₀ h = 0 := by simpa [e0, hL0] using hc0
        rw [hhi, map_smul, smul_eq_mul] at hDF
        have hi0 : h i = 0 := by
          rcases mul_eq_zero.mp hDF with h' | h'
          · exact h'
          · exact absurd h' hi
        rw [hhi, hi0, zero_smul]
      intro h1 h2 h12
      have := hker (h1 - h2) (by rw [map_sub, h12, sub_self])
      exact sub_eq_zero.mp this
    obtain ⟨V₀, O, χ, hV₀, hO, hy₀V₀, -, hχ, hχmaps, hΘχ, hχΘ⟩ :=
      hR3 (n + 1) Θ univ y₀ isOpen_univ (mem_univ _) hΘc.contDiffOn hinj0
    have hχd : ∀ a ∈ O, DifferentiableAt ℝ χ a := fun a ha =>
      (hχ.differentiableOn one_ne_zero a ha).differentiableAt (hO.mem_nhds ha)
    have himg : χ '' O = V₀ := by
      apply Subset.antisymm
      · rintro _ ⟨a, ha, rfl⟩; exact hχmaps ha
      · intro z hz; exact ⟨Θ z, (hχΘ z hz).1, (hχΘ z hz).2⟩
    refine ⟨O, χ, hO, hχ, ?_, ?_, ?_, ?_, ?_⟩
    · intro a ha b hb hab
      rw [← hΘχ a ha, ← hΘχ b hb, hab]
    · intro a ha
      have hid : fderiv ℝ (Θ ∘ χ) a = ContinuousLinearMap.id ℝ (Euclid (n + 1)) := by
        rw [Filter.EventuallyEq.fderiv_eq (f₁ := Θ ∘ χ) (f := id) ?_, fderiv_id]
        filter_upwards [hO.mem_nhds ha] with b hb using hΘχ b hb
      rw [fderiv_comp a (hΘc.differentiable one_ne_zero _) (hχd a ha)] at hid
      have hli : Function.LeftInverse (fderiv ℝ Θ (χ a)) (fderiv ℝ χ a) := fun u => by
        simpa using DFunLike.congr_fun hid u
      have hinj : Injective (fderiv ℝ χ a) := hli.injective
      exact ⟨hinj, LinearMap.surjective_of_injective
        (f := (fderiv ℝ χ a : Euclid (n + 1) →ₗ[ℝ] Euclid (n + 1))) hinj⟩
    · intro a ha
      rw [← hΘ0, hΘχ a ha]
    · rw [himg]; exact hV₀
    · rw [himg]; exact hy₀V₀
  let O' : Set (Euclid (n + 1)) := {y | fderiv ℝ F y ≠ 0}
  choose! Bf Ψf hBf hΨf hinjf hbijf hFf hopenf hmemf using hloc
  obtain ⟨T, hTc, hTU⟩ := TopologicalSpace.isOpen_iUnion_countable
    (fun y : O' => Ψf y '' Bf y) (fun y => hopenf y y.2)
  by_cases hT : T.Nonempty
  · obtain ⟨e, he⟩ := hTc.exists_eq_range hT
    refine ⟨fun q => Bf (e q), fun q => Ψf (e q), fun q => hBf _ (e q).2, fun q => hΨf _ (e q).2,
      fun q => hinjf _ (e q).2, fun q => hbijf _ (e q).2, fun q => hFf _ (e q).2,
      fun q => hopenf _ (e q).2, ?_⟩
    intro y hy
    have h1 : y ∈ ⋃ z : O', Ψf z '' Bf z := mem_iUnion.mpr ⟨⟨y, hy⟩, hmemf y hy⟩
    rw [← hTU] at h1
    obtain ⟨z, hzT, hz⟩ := mem_iUnion₂.mp h1
    rw [he] at hzT
    obtain ⟨q, rfl⟩ := hzT
    exact mem_iUnion.mpr ⟨q, hz⟩
  · refine ⟨fun _ => ∅, fun _ => id, fun _ => isOpen_empty, fun _ => contDiff_id.contDiffOn,
      fun _ => injOn_empty _, fun _ _ h => absurd h (notMem_empty _),
      fun _ _ h => absurd h (notMem_empty _), fun _ => by simp, ?_⟩
    intro y hy
    have h1 : y ∈ ⋃ z : O', Ψf z '' Bf z := mem_iUnion.mpr ⟨⟨y, hy⟩, hmemf y hy⟩
    rw [← hTU] at h1
    obtain ⟨z, hzT, -⟩ := mem_iUnion₂.mp h1
    exact absurd ⟨z, hzT⟩ hT

/-- **Co-area formula on one straightened patch of a `C¹` chart** (Simon Ch. 2, §6; Ch. 3,
(2.8)–(2.9)).  Let `ψ : ℝⁿ⁺¹ → ℝᴾ` be `C¹` and injective with injective `Dψ` on the open set `V`,
`F : ℝⁿ⁺¹ → ℝ` be `C¹`, and `Ψ : ℝⁿ⁺¹ → ℝⁿ⁺¹` be `C¹` and injective with bijective `DΨ` on the
open set `B`, straightening `F` to the first coordinate: `F(Ψ(w)) = w(0)` on `B`.  Let
`Z ⊆ V ∩ Ψ(B)` be Borel, with `G(ψ(y)) ∈ Dψ(y)(ℝⁿ⁺¹)` and `⟨G(ψ(y)), Dψ(y)e⟩ = DF(y)e` for
`y ∈ Z`.  Then for Borel `φ ≥ 0`, `t ↦ ∫_{ψ(Z ∩ F⁻¹(t))} φ dHⁿ` is a.e.-measurable and
`∫_ℝ ∫_{ψ(Z ∩ F⁻¹(t))} φ dHⁿ dt = ∫_{ψ(Z)} |G| φ dHⁿ⁺¹`.
On the Borel patch `S = B ∩ Ψ⁻¹(Z)` the map `Φ = ψ ∘ Ψ` is injective, with injective derivative
`DΦ(w) = Dψ(Ψ(w)) ∘ DΨ(w)`.  Since `F ∘ Ψ` is the first coordinate on `B`,
`DF(Ψ(w)) ∘ DΨ(w) = (e ↦ e(0))`, so `G(Φ(w)) ∈ DΦ(w)(ℝⁿ⁺¹)` and `⟨G(Φ(w)), DΦ(w)e⟩ = e(0)`.  The
patch co-area formula applies to `(Φ, S)`, and `Φ(S) = ψ(Z)`,
`Φ(S ∩ {w(0) = t}) = ψ(Z ∩ F⁻¹(t))`. -/
theorem Submission.dor_lmbsf_pc_chart_patch_coarea : ∀ (P n : ℕ) (V B Z : Set (Euclid (n + 1))) (ψ : Euclid (n + 1) → Euclid P) (F : Euclid (n + 1) → ℝ) (Ψ : Euclid (n + 1) → Euclid (n + 1)) (G : Euclid P → Euclid P), IsOpen V → ContDiffOn ℝ 1 ψ V → InjOn ψ V → (∀ y ∈ V, Injective (fderiv ℝ ψ y)) → ContDiff ℝ 1 F → IsOpen B → ContDiffOn ℝ 1 Ψ B → InjOn Ψ B → (∀ w ∈ B, Bijective (fderiv ℝ Ψ w)) → (∀ w ∈ B, F (Ψ w) = w 0) → MeasurableSet Z → Z ⊆ V → Z ⊆ Ψ '' B → (∀ y ∈ Z, G (ψ y) ∈ LinearMap.range (fderiv ℝ ψ y : Euclid (n + 1) →ₗ[ℝ] Euclid P) ∧ ∀ e : Euclid (n + 1), inner ℝ (G (ψ y)) (fderiv ℝ ψ y e) = fderiv ℝ F y e) → ∀ φ : Euclid P → ℝ≥0∞, Measurable φ → AEMeasurable (fun t : ℝ => ∫⁻ x in ψ '' (Z ∩ F ⁻¹' {t}), φ x ∂μHE[n]) ∧ ∫⁻ t : ℝ, (∫⁻ x in ψ '' (Z ∩ F ⁻¹' {t}), φ x ∂μHE[n]) = ∫⁻ x in ψ '' Z, ‖G x‖ₑ * φ x ∂μHE[n + 1] := by
  intro P n V B Z ψ F Ψ G hV hψ hψinj hψreg hF hB hΨ hΨinj hΨbij hFΨ hZ hZV hZB hG φ hφ
  have hΨd : ∀ w ∈ B, DifferentiableAt ℝ Ψ w := fun w hw =>
    (hΨ.differentiableOn one_ne_zero w hw).differentiableAt (hB.mem_nhds hw)
  have hψd : ∀ y ∈ V, DifferentiableAt ℝ ψ y := fun y hy =>
    (hψ.differentiableOn one_ne_zero y hy).differentiableAt (hV.mem_nhds hy)
  -- the patch `S = B ∩ Ψ⁻¹(Z)` is Borel: `Ψ` is continuous on the open set `B`
  set S : Set (Euclid (n + 1)) := B ∩ Ψ ⁻¹' Z with hSdef
  have hSm : MeasurableSet S := by
    classical
    have hpw : Measurable (B.piecewise Ψ (fun _ => 0)) :=
      hΨ.continuousOn.measurable_piecewise continuousOn_const hB.measurableSet
    have : S = B ∩ (B.piecewise Ψ (fun _ => 0)) ⁻¹' Z := by
      ext w
      constructor
      · rintro ⟨hw, hwZ⟩
        exact ⟨hw, by simpa [Set.piecewise_eq_of_mem _ _ _ hw] using hwZ⟩
      · rintro ⟨hw, hwZ⟩
        exact ⟨hw, by simpa [Set.piecewise_eq_of_mem _ _ _ hw] using hwZ⟩
    rw [this]
    exact hB.measurableSet.inter (hpw hZ)
  -- `Φ = ψ ∘ Ψ` is differentiable and injective on `S`, with `DΦ(w) = Dψ(Ψ(w)) ∘ DΨ(w)` injective
  set Φ : Euclid (n + 1) → Euclid P := ψ ∘ Ψ with hΦdef
  have hSZ : ∀ w ∈ S, Ψ w ∈ Z := fun w hw => hw.2
  have hΦd : ∀ w ∈ S, DifferentiableAt ℝ Φ w := fun w hw =>
    (hψd _ (hZV (hSZ w hw))).comp w (hΨd w hw.1)
  have hΦD : ∀ w ∈ S, fderiv ℝ Φ w = (fderiv ℝ ψ (Ψ w)).comp (fderiv ℝ Ψ w) := fun w hw =>
    fderiv_comp w (hψd _ (hZV (hSZ w hw))) (hΨd w hw.1)
  have hΦinjD : ∀ w ∈ S, Injective (fderiv ℝ Φ w) := by
    intro w hw
    rw [hΦD w hw]
    exact (hψreg _ (hZV (hSZ w hw))).comp (hΨbij w hw.1).1
  have hΦinj : InjOn Φ S := by
    intro a ha b hb hab
    exact hΨinj ha.1 hb.1 (hψinj (hZV (hSZ a ha)) (hZV (hSZ b hb)) hab)
  -- `F ∘ Ψ` is the first coordinate near every `w ∈ B`, so `DF(Ψ(w))(DΨ(w)e) = e(0)`
  have hDFΨ : ∀ w ∈ B, ∀ e : Euclid (n + 1), fderiv ℝ F (Ψ w) (fderiv ℝ Ψ w e) = e 0 := by
    intro w hw e
    have h1 : fderiv ℝ (F ∘ Ψ) w =
        fderiv ℝ (EuclideanSpace.proj (0 : Fin (n + 1)) : Euclid (n + 1) → ℝ) w := by
      apply Filter.EventuallyEq.fderiv_eq
      filter_upwards [hB.mem_nhds hw] with v hv
      simp [hFΨ v hv]
    have h2 : fderiv ℝ (F ∘ Ψ) w = (fderiv ℝ F (Ψ w)).comp (fderiv ℝ Ψ w) :=
      fderiv_comp w ((hF.differentiable one_ne_zero) _) (hΨd w hw)
    rw [h2, ContinuousLinearMap.fderiv] at h1
    have := congrArg (fun L : Euclid (n + 1) →L[ℝ] ℝ => L e) h1
    simpa using this
  -- the hypotheses on `G` transported to the parametrization `Φ`
  have hGΦ : ∀ w ∈ S, G (Φ w) ∈ LinearMap.range (fderiv ℝ Φ w : Euclid (n + 1) →ₗ[ℝ] Euclid P) ∧
      ∀ e : Euclid (n + 1), inner ℝ (G (Φ w)) (fderiv ℝ Φ w e) = e 0 := by
    intro w hw
    obtain ⟨⟨v, hv⟩, hinner⟩ := hG (Ψ w) (hSZ w hw)
    refine ⟨?_, ?_⟩
    · -- `G(Φ(w)) = Dψ(Ψ(w))v` and `v = DΨ(w)u` since `DΨ(w)` is surjective
      obtain ⟨u, hu⟩ := (hΨbij w hw.1).2 v
      refine ⟨u, ?_⟩
      have hv' : fderiv ℝ ψ (Ψ w) v = G (ψ (Ψ w)) := hv
      change fderiv ℝ Φ w u = G (Φ w)
      rw [hΦD w hw, ContinuousLinearMap.comp_apply, hu, hv']
      rfl
    · intro e
      rw [hΦD w hw, ContinuousLinearMap.comp_apply]
      change inner ℝ (G (ψ (Ψ w))) _ = _
      rw [hinner, hDFΨ w hw.1 e]
  -- the patch co-area formula for `(Φ, S)`
  obtain ⟨hmeas, heq⟩ :=
    Submission.dor_lmbsf_pc_param_coarea P n Φ S G hSm hΦd hΦinjD hΦinj hGΦ φ hφ
  -- back to the chart: `Φ(S) = ψ(Z)` and `Φ(S ∩ {w(0) = t}) = ψ(Z ∩ F⁻¹(t))`
  have himg : Φ '' S = ψ '' Z := by
    rw [hΦdef, image_comp]
    congr 1
    ext y
    constructor
    · rintro ⟨w, hw, rfl⟩
      exact hw.2
    · intro hy
      obtain ⟨w, hw, rfl⟩ := hZB hy
      exact ⟨w, ⟨hw, hy⟩, rfl⟩
  have himgt : ∀ t : ℝ, Φ '' (S ∩ {w | w 0 = t}) = ψ '' (Z ∩ F ⁻¹' {t}) := by
    intro t
    rw [hΦdef, image_comp]
    congr 1
    ext y
    constructor
    · rintro ⟨w, ⟨⟨hwB, hwZ⟩, hwt⟩, rfl⟩
      refine ⟨hwZ, ?_⟩
      simp only [mem_preimage, mem_singleton_iff, hFΨ w hwB]
      exact hwt
    · rintro ⟨hy, hFy⟩
      obtain ⟨w, hw, rfl⟩ := hZB hy
      refine ⟨w, ⟨⟨hw, hy⟩, ?_⟩, rfl⟩
      simp only [mem_preimage, mem_singleton_iff, hFΨ w hw] at hFy
      exact hFy
  simp only [himgt] at hmeas heq
  rw [himg] at heq
  exact ⟨hmeas, heq⟩
/-- **Gluing countably many co-area pieces** (countable additivity of `∫⁻`).  Let `ψ` be continuous
and injective on `Z = ⋃_q Z_q`, the `Z_q` pairwise disjoint Borel sets, and `F` Borel.  Images
under `ψ` of Borel subsets of `Z` are Borel (Lusin–Souslin) and images of disjoint subsets of `Z`
are disjoint, so `ψ(Z ∩ F⁻¹{t}) = ⋃_q ψ(Z_q ∩ F⁻¹{t})` and `ψ(Z) = ⋃_q ψ(Z_q)` are countable
disjoint Borel unions.  Hence `∫_{ψ(Z ∩ F⁻¹{t})} φ dHⁿ = Σ_q ∫_{ψ(Z_q ∩ F⁻¹{t})} φ dHⁿ`, a countable
sum of a.e.-measurable functions of `t`, and exchanging `∫ dt` with `Σ_q` turns the co-area
identities of the pieces into `∫_ℝ ∫_{ψ(Z ∩ F⁻¹{t})} φ dHⁿ dt = Σ_q ∫_{ψ(Z_q)} g dH^{n+1}
= ∫_{ψ(Z)} g dH^{n+1}`. -/
theorem Submission.dor_lmbsf_pc_coarea_glue : ∀ (P n : ℕ) (Z : Set (Euclid (n + 1))) (Zs : ℕ → Set (Euclid (n + 1))) (ψ : Euclid (n + 1) → Euclid P) (F : Euclid (n + 1) → ℝ) (φ g : Euclid P → ℝ≥0∞), ContinuousOn ψ Z → InjOn ψ Z → Measurable F → (∀ q, MeasurableSet (Zs q)) → Pairwise (fun p q => Disjoint (Zs p) (Zs q)) → (⋃ q, Zs q) = Z → (∀ q, AEMeasurable (fun t : ℝ => ∫⁻ x in ψ '' (Zs q ∩ F ⁻¹' {t}), φ x ∂μHE[n]) ∧ ∫⁻ t : ℝ, (∫⁻ x in ψ '' (Zs q ∩ F ⁻¹' {t}), φ x ∂μHE[n]) = ∫⁻ x in ψ '' Zs q, g x ∂μHE[n + 1]) → AEMeasurable (fun t : ℝ => ∫⁻ x in ψ '' (Z ∩ F ⁻¹' {t}), φ x ∂μHE[n]) ∧ ∫⁻ t : ℝ, (∫⁻ x in ψ '' (Z ∩ F ⁻¹' {t}), φ x ∂μHE[n]) = ∫⁻ x in ψ '' Z, g x ∂μHE[n + 1] := by
  intro P n Z Zs ψ F φ g hψc hψinj hF hZsm hZsd hZsU hq
  have hZsZ : ∀ q, Zs q ⊆ Z := fun q => hZsU ▸ subset_iUnion Zs q
  -- images of Borel subsets of `Z` are Borel (Lusin–Souslin)
  have himgm : ∀ A : Set (Euclid (n + 1)), MeasurableSet A → A ⊆ Z → MeasurableSet (ψ '' A) :=
    fun A hA hAZ => hA.image_of_continuousOn_injOn (hψc.mono hAZ) (hψinj.mono hAZ)
  -- images of disjoint subsets of `Z` are disjoint (`ψ` is injective on `Z`)
  have himgd : ∀ A A' : Set (Euclid (n + 1)), A ⊆ Z → A' ⊆ Z → Disjoint A A' →
      Disjoint (ψ '' A) (ψ '' A') := by
    intro A A' hA hA' hd
    rw [Set.disjoint_left]
    rintro x ⟨a, ha, rfl⟩ ⟨b, hb, hab⟩
    have := hψinj (hA' hb) (hA ha) hab
    exact Set.disjoint_left.mp hd ha (this ▸ hb)
  -- each slice integral is the sum of the slice integrals of the pieces
  have hslice : ∀ t : ℝ, ∫⁻ x in ψ '' (Z ∩ F ⁻¹' {t}), φ x ∂μHE[n] =
      ∑' q, ∫⁻ x in ψ '' (Zs q ∩ F ⁻¹' {t}), φ x ∂μHE[n] := by
    intro t
    have hU : ψ '' (Z ∩ F ⁻¹' {t}) = ⋃ q, ψ '' (Zs q ∩ F ⁻¹' {t}) := by
      rw [← image_iUnion, ← iUnion_inter, hZsU]
    rw [hU, lintegral_iUnion
      (fun q => himgm _ ((hZsm q).inter (hF (measurableSet_singleton t)))
        (inter_subset_left.trans (hZsZ q)))
      (fun p q hpq => himgd _ _ (inter_subset_left.trans (hZsZ p))
        (inter_subset_left.trans (hZsZ q)) ((hZsd hpq).mono inter_subset_left inter_subset_left))]
  -- likewise for the right-hand side
  have hrhs : ∫⁻ x in ψ '' Z, g x ∂μHE[n + 1] = ∑' q, ∫⁻ x in ψ '' Zs q, g x ∂μHE[n + 1] := by
    have hU : ψ '' Z = ⋃ q, ψ '' Zs q := by rw [← image_iUnion, hZsU]
    rw [hU]
    exact lintegral_iUnion (fun q => himgm _ (hZsm q) (hZsZ q))
      (fun p q hpq => himgd _ _ (hZsZ p) (hZsZ q) (hZsd hpq)) g
  simp only [hslice]
  refine ⟨AEMeasurable.tsum (fun q => (hq q).1), ?_⟩
  rw [lintegral_tsum (fun q => (hq q).1), hrhs]
  exact tsum_congr (fun q => (hq q).2)

/-- **Co-area formula on one `C¹` chart piece** (Simon Ch. 3, 2.8–2.9; Ch. 2, 3.5).  Let `ψ` be a
`C¹` injective immersion of the open `V ⊆ ℝⁿ⁺¹` into `ℝᴾ`, `Y ⊆ C ⊆ V` Borel, `F` a `C¹` function
with `f ∘ ψ = F` on `Y`, and `G` the tangential gradient of `f` along `ψ(Y)`.  On `Y`, `G(ψ(y)) = 0`
iff `DF(y) = 0` (write `G(ψ(y)) = Dψ(y)v`, so `|G(ψ(y))|² = DF(y)v`), hence for `Y' = Y ∩ {DF ≠ 0}`
every slice is `ψ(Y) ∩ {G ≠ 0} ∩ f⁻¹{t} = ψ(Y' ∩ F⁻¹{t})`, and `ψ(Y ∖ Y')` contributes nothing to
`∫_{ψ(Y)} |G| φ dHⁿ⁺¹`.  The straightening charts `Ψ_q(B_q)` cover `{DF ≠ 0}`; the Borel pieces
`Z_q = Y' ∩ disjointed (Ψ_q(B_q)) q` are pairwise disjoint with union `Y'`, each satisfies the
co-area identity on its chart, and gluing the pieces gives the identity on `Y'`. -/
theorem Submission.dor_lmbsf_piece_coarea : ∀ (P n : ℕ) (V C Y : Set (Euclid (n + 1))) (ψ : Euclid (n + 1) → Euclid P) (F : Euclid (n + 1) → ℝ) (f : Euclid P → ℝ) (G : Euclid P → Euclid P), IsOpen V → ContDiffOn ℝ 1 ψ V → InjOn ψ V → (∀ y ∈ V, Injective (fderiv ℝ ψ y)) → IsCompact C → C ⊆ V → MeasurableSet Y → Y ⊆ C → ContDiff ℝ 1 F → (∀ y ∈ Y, f (ψ y) = F y) → (∀ y ∈ Y, G (ψ y) ∈ LinearMap.range (fderiv ℝ ψ y : Euclid (n + 1) →ₗ[ℝ] Euclid P) ∧ ∀ e : Euclid (n + 1), inner ℝ (G (ψ y)) (fderiv ℝ ψ y e) = fderiv ℝ F y e) → Measurable G → ∀ φ : Euclid P → ℝ≥0∞, Measurable φ → AEMeasurable (fun t => ∫⁻ x in ψ '' Y ∩ {x | G x ≠ 0} ∩ f ⁻¹' {t}, φ x ∂μHE[n]) ∧ ∫⁻ t, (∫⁻ x in ψ '' Y ∩ {x | G x ≠ 0} ∩ f ⁻¹' {t}, φ x ∂μHE[n]) = ∫⁻ x in ψ '' Y, ‖G x‖ₑ * φ x ∂μHE[n + 1] := by
  intro P n V C Y ψ F f G hV hψ hψinj hDψ _ hCV hY hYC hF hfF hG _ φ hφ
  have hYV : Y ⊆ V := hYC.trans hCV
  -- on `Y`, the tangential gradient vanishes exactly where `DF` does
  have hG0 : ∀ y ∈ Y, G (ψ y) = 0 ↔ fderiv ℝ F y = 0 := by
    intro y hy
    obtain ⟨⟨v, hv⟩, he⟩ := hG y hy
    constructor
    · intro h0
      refine ContinuousLinearMap.ext fun e => ?_
      rw [← he e, h0, inner_zero_left, zero_apply]
    · intro h0
      have hvv : inner ℝ (G (ψ y)) (G (ψ y)) = fderiv ℝ F y v := by
        rw [← he v]
        exact congrArg (inner ℝ (G (ψ y))) hv.symm
      rw [h0, zero_apply] at hvv
      exact inner_self_eq_zero.mp hvv
  -- the regular part `Y' = Y ∩ {DF ≠ 0}` is Borel
  obtain ⟨Y', hY'⟩ : ∃ Y' : Set (Euclid (n + 1)), Y' = Y ∩ {y | fderiv ℝ F y ≠ 0} := ⟨_, rfl⟩
  have hY'Y : Y' ⊆ Y := hY' ▸ inter_subset_left
  have hY'V : Y' ⊆ V := hY'Y.trans hYV
  have hY'm : MeasurableSet Y' := hY' ▸
    hY.inter (isOpen_ne_fun (hF.continuous_fderiv one_ne_zero) continuous_const).measurableSet
  have hmemY' : ∀ y ∈ Y, (y ∈ Y' ↔ fderiv ℝ F y ≠ 0) := fun y hy => by
    rw [hY']
    exact ⟨fun h => h.2, fun h => ⟨hy, h⟩⟩
  -- every slice is the image of a slice of the regular part
  have hslice : ∀ t : ℝ, ψ '' Y ∩ {x | G x ≠ 0} ∩ f ⁻¹' {t} = ψ '' (Y' ∩ F ⁻¹' {t}) := by
    intro t
    ext x
    simp only [mem_inter_iff, mem_image, mem_ofPred_eq, mem_preimage, mem_singleton_iff]
    constructor
    · rintro ⟨⟨⟨y, hy, rfl⟩, hGx⟩, hft⟩
      exact ⟨y, ⟨(hmemY' y hy).mpr fun h => hGx ((hG0 y hy).mpr h), (hfF y hy).symm.trans hft⟩,
        rfl⟩
    · rintro ⟨y, ⟨hy, hFt⟩, rfl⟩
      exact ⟨⟨⟨y, hY'Y hy, rfl⟩, fun h => (hmemY' y (hY'Y hy)).mp hy ((hG0 y (hY'Y hy)).mp h)⟩,
        (hfF y (hY'Y hy)).trans hFt⟩
  -- the critical part `ψ(Y ∖ Y')` carries no `|G| φ`-mass
  have hrhs : ∫⁻ x in ψ '' Y, ‖G x‖ₑ * φ x ∂μHE[n + 1] =
      ∫⁻ x in ψ '' Y', ‖G x‖ₑ * φ x ∂μHE[n + 1] := by
    have hcrit : MeasurableSet (ψ '' (Y \ Y')) :=
      (hY.diff hY'm).image_of_continuousOn_injOn (hψ.continuousOn.mono (sdiff_subset.trans hYV))
        (hψinj.mono (sdiff_subset.trans hYV))
    have hdisj : Disjoint (ψ '' Y') (ψ '' (Y \ Y')) := by
      rw [Set.disjoint_left]
      rintro x ⟨a, ha, rfl⟩ ⟨b, hb, hab⟩
      have := hψinj (hYV hb.1) (hY'V ha) hab
      exact hb.2 (this ▸ ha)
    have hzero : ∫⁻ x in ψ '' (Y \ Y'), ‖G x‖ₑ * φ x ∂μHE[n + 1] = 0 := by
      refine setLIntegral_eq_zero₀ hcrit.nullMeasurableSet ?_
      rintro x ⟨y, ⟨hy, hy'⟩, rfl⟩
      have hDF : fderiv ℝ F y = 0 := not_not.mp fun h => hy' ((hmemY' y hy).mpr h)
      simp [(hG0 y hy).mpr hDF]
    rw [← union_sdiff_cancel hY'Y, image_union, lintegral_union hcrit hdisj, hzero, add_zero]
  -- countably many straightening charts cover `{DF ≠ 0}`; cut `Y'` into disjoint Borel pieces
  obtain ⟨B, Ψ, hBo, hΨc, hΨinj, hΨbij, hFΨ, hΨo, hcover⟩ :=
    Submission.dor_lmbsf_pc_straightening_cover n F hF
  obtain ⟨Zs, hZs⟩ : ∃ Zs : ℕ → Set (Euclid (n + 1)),
      ∀ q, Zs q = Y' ∩ disjointed (fun q => Ψ q '' B q) q := ⟨_, fun _ => rfl⟩
  have hZsm : ∀ q, MeasurableSet (Zs q) := fun q => by
    rw [hZs]
    exact hY'm.inter (MeasurableSet.disjointed (fun p => (hΨo p).measurableSet) q)
  have hZsd : Pairwise (fun p q => Disjoint (Zs p) (Zs q)) := by
    intro p q hpq
    rw [hZs, hZs]
    exact Disjoint.mono inter_subset_right inter_subset_right (disjoint_disjointed _ hpq)
  have hZsU : (⋃ q, Zs q) = Y' := by
    simp only [hZs]
    rw [← inter_iUnion, iUnion_disjointed, inter_eq_left]
    intro y hy
    exact hcover ((hmemY' y (hY'Y hy)).mp hy)
  have hZsY' : ∀ q, Zs q ⊆ Y' := fun q => by
    rw [hZs]
    exact inter_subset_left
  have hZsΨ : ∀ q, Zs q ⊆ Ψ q '' B q := fun q => by
    rw [hZs]
    exact inter_subset_right.trans (disjointed_subset _ q)
  -- the co-area identity on each chart piece
  have hpatch : ∀ q, AEMeasurable (fun t : ℝ => ∫⁻ x in ψ '' (Zs q ∩ F ⁻¹' {t}), φ x ∂μHE[n]) ∧
      ∫⁻ t : ℝ, (∫⁻ x in ψ '' (Zs q ∩ F ⁻¹' {t}), φ x ∂μHE[n]) =
        ∫⁻ x in ψ '' Zs q, ‖G x‖ₑ * φ x ∂μHE[n + 1] := fun q =>
    Submission.dor_lmbsf_pc_chart_patch_coarea P n V (B q) (Zs q) ψ F (Ψ q) G hV hψ hψinj hDψ hF
      (hBo q) (hΨc q) (hΨinj q) (hΨbij q) (hFΨ q) (hZsm q) ((hZsY' q).trans hY'V) (hZsΨ q)
      (fun y hy => hG y (hY'Y (hZsY' q hy))) φ hφ
  -- glue the pieces
  have hglue := Submission.dor_lmbsf_pc_coarea_glue P n Y' Zs ψ F φ (fun x => ‖G x‖ₑ * φ x)
    (hψ.continuousOn.mono hY'V) (hψinj.mono hY'V) hF.continuous.measurable hZsm hZsd hZsU hpatch
  simp only [hslice, hrhs]
  exact hglue

/-- **Slice tangent-plane algebra** (Simon Ch. 6, Lemma 4.1 (2): `∇ᴹf(x) ∈ TₓM` and `TₓMₜ` is
the orthogonal complement of `∇ᴹf(x)` in `TₓM`).  Let `L : ℝᵐ → ℝᴾ` and `ℓ : ℝᵐ → ℝ` be linear,
`g ∈ L(ℝᵐ)` and `⟨g, L e⟩ = ℓ(e)` for every `e`.  Then `g = 0 ⇔ ℓ = 0` (if `ℓ = 0` and
`g = L w`, then `|g|² = ⟨g, L w⟩ = ℓ(w) = 0`), and `L(ℝᵐ) ∩ g^⊥ = L(ker ℓ)`, because `v = L e`
is orthogonal to `g` iff `ℓ(e) = ⟨g, L e⟩ = 0`. -/
theorem Submission.dor_lmbsf_pst_slice_plane_algebra : ∀ (m P : ℕ) (L : Euclid m →L[ℝ] Euclid P) (ℓ : Euclid m →L[ℝ] ℝ) (g : Euclid P), g ∈ LinearMap.range (L : Euclid m →ₗ[ℝ] Euclid P) → (∀ e : Euclid m, inner ℝ g (L e) = ℓ e) → (g = 0 ↔ ℓ = 0) ∧ LinearMap.range (L : Euclid m →ₗ[ℝ] Euclid P) ⊓ (ℝ ∙ g)ᗮ = Submodule.map (L : Euclid m →ₗ[ℝ] Euclid P) (LinearMap.ker (ℓ : Euclid m →ₗ[ℝ] ℝ)) := by
  intro m P L ℓ g hg hgℓ
  refine ⟨⟨fun h => ?_, fun h => ?_⟩, ?_⟩
  · -- Step 1, `g = 0` gives `ℓ(e) = ⟨0, L e⟩ = 0` for every `e`
    ext e
    rw [← hgℓ e, h, inner_zero_left, zero_apply]
  · -- Step 2, `g = L w` and `ℓ = 0` give `⟨g, g⟩ = ⟨g, L w⟩ = ℓ(w) = 0`
    obtain ⟨w, hw⟩ := LinearMap.mem_range.1 hg
    have hgg := hgℓ w
    rw [ContinuousLinearMap.coe_coe] at hw
    rw [hw, h, zero_apply] at hgg
    exact inner_self_eq_zero.1 hgg
  · -- Steps 3–5, `v = L e` lies in `gᗮ` iff `ℓ(e) = ⟨g, L e⟩ = 0`
    ext v
    simp only [Submodule.mem_inf, LinearMap.mem_range, Submodule.mem_map, LinearMap.mem_ker,
      Submodule.mem_orthogonal_singleton_iff_inner_right, ContinuousLinearMap.coe_coe]
    constructor
    · rintro ⟨⟨e, rfl⟩, he⟩
      exact ⟨e, (hgℓ e).symm.trans he, rfl⟩
    · rintro ⟨e, he, rfl⟩
      exact ⟨⟨e, rfl⟩, (hgℓ e).trans he⟩
/-- **Local `C¹` chart of a regular level set** (the implicit function theorem step of Simon
Ch. 2, §6, after 6.3, chapter-02.txt lines 1476–1482: off `{DF = 0}` a level set of a `C¹` map is
a `C¹` submanifold).  `ℓ = DF(y₀) ≠ 0` has `dim ker ℓ = n`; extending an isomorphism
`ker ℓ ≅ ℝⁿ` gives a linear `π` with `π × ℓ` invertible.  Invert `Θ = (π, F)` near `y₀` (inverse
function theorem) inside `W` and the open set where `DΘ` is invertible.  Then
`Λ(z) = Θ⁻¹(z, F(y₀))` on `D = {z | (z, F(y₀)) ∈ target}` has `π ∘ Λ = id`, `F ∘ Λ = F(y₀)` and
`DΛ(z) = DΘ(Λ z)⁻¹ ∘ inl`, injective with range `ker DF(Λ z)`.  For `c = π(y₀)`, `B̄_ρ(c) ⊆ D`
and `N = source ∩ π⁻¹(B_ρ(c))`, a point `y ∈ N` with `F(y) = F(y₀)` is `Λ(π y)`. -/
theorem Submission.dor_lmbsf_pst_level_set_local_chart : ∀ (n : ℕ) (W : Set (Euclid (n + 1))) (F : Euclid (n + 1) → ℝ) (y₀ : Euclid (n + 1)), IsOpen W → ContDiff ℝ 1 F → y₀ ∈ W → fderiv ℝ F y₀ ≠ 0 → ∃ (D : Set (Euclid n)) (Λ : Euclid n → Euclid (n + 1)) (c : Euclid n) (ρ : ℝ) (N : Set (Euclid (n + 1))), IsOpen D ∧ ContDiffOn ℝ 1 Λ D ∧ InjOn Λ D ∧ (∀ z ∈ D, Λ z ∈ W ∧ F (Λ z) = F y₀ ∧ Injective (fderiv ℝ Λ z) ∧ LinearMap.range (fderiv ℝ Λ z : Euclid n →ₗ[ℝ] Euclid (n + 1)) = LinearMap.ker (fderiv ℝ F (Λ z) : Euclid (n + 1) →ₗ[ℝ] ℝ)) ∧ closedBall c ρ ⊆ D ∧ IsOpen N ∧ y₀ ∈ N ∧ N ∩ F ⁻¹' {F y₀} ⊆ Λ '' ball c ρ := by
  intro n W F y₀ hW hF hy₀ hDF
  set ℓ : Euclid (n + 1) →L[ℝ] ℝ := fderiv ℝ F y₀
  set t : ℝ := F y₀
  set K := LinearMap.ker (ℓ : Euclid (n + 1) →ₗ[ℝ] ℝ)
  -- Step 1, `ℓ ≠ 0` is onto `ℝ`, so `dim K = n` by rank–nullity
  have hdimK : Module.finrank ℝ K = Module.finrank ℝ (Euclid n) := by
    obtain ⟨v₀, hv₀⟩ : ∃ v₀, ℓ v₀ ≠ 0 := by
      by_contra! h
      exact hDF (ContinuousLinearMap.ext h)
    have hrange : LinearMap.range (ℓ : Euclid (n + 1) →ₗ[ℝ] ℝ) = ⊤ :=
      eq_top_iff.2 fun r _ => LinearMap.mem_range.2 ⟨(r / ℓ v₀) • v₀, by simp [hv₀]⟩
    have h : _ + Module.finrank ℝ K = _ :=
      LinearMap.finrank_range_add_finrank_ker (ℓ : Euclid (n + 1) →ₗ[ℝ] ℝ)
    rw [hrange, finrank_top, Module.finrank_self, finrank_euclideanSpace_fin] at h
    rw [finrank_euclideanSpace_fin]
    omega
  -- Step 2, `π` extends an isomorphism `e : K ≃ ℝⁿ`, so `ℓ v = 0 = π v` forces `v = 0`
  obtain ⟨π, hπ⟩ : ∃ π : Euclid (n + 1) →L[ℝ] Euclid n, ∀ v, ℓ v = 0 → π v = 0 → v = 0 := by
    let e : K ≃ₗ[ℝ] Euclid n := LinearEquiv.ofFinrankEq _ _ hdimK
    obtain ⟨g, hg⟩ := LinearMap.exists_extend (e : K →ₗ[ℝ] Euclid n)
    refine ⟨LinearMap.toContinuousLinearMap g, fun v hv hπv => ?_⟩
    have hvK : v ∈ K := hv
    have h : e ⟨v, hvK⟩ = 0 := by
      have hgv := congrArg (fun f => f ⟨v, hvK⟩) hg
      simp only [LinearMap.comp_apply, Submodule.subtype_apply, LinearEquiv.coe_coe] at hgv
      rw [← hgv]
      exact hπv
    exact congrArg Subtype.val (e.injective (h.trans (map_zero e).symm))
  -- Step 3, `Θ = (π, F)` is `C¹` with `DΘ(y) = π × DF(y)`
  set Θ : Euclid (n + 1) → Euclid n × ℝ := fun y => (π y, F y)
  have hΘ : ContDiff ℝ 1 Θ := π.contDiff.prodMk hF
  have hΘd : ∀ y, HasFDerivAt Θ (π.prod (fderiv ℝ F y)) y := fun y =>
    π.hasFDerivAt.prodMk (hF.differentiable one_ne_zero y).hasFDerivAt
  -- Step 4, `π × ℓ` is injective by Step 2, hence (equal dimensions) an isomorphism `E₀`
  have hker₀ : LinearMap.ker (π.prod ℓ : Euclid (n + 1) →ₗ[ℝ] Euclid n × ℝ) = ⊥ := by
    refine LinearMap.ker_eq_bot'.2 fun v hv => ?_
    have h : (π v, ℓ v) = ((0 : Euclid n), (0 : ℝ)) := hv
    exact hπ v (congrArg Prod.snd h) (congrArg Prod.fst h)
  have hrange₀ : LinearMap.range (π.prod ℓ : Euclid (n + 1) →ₗ[ℝ] Euclid n × ℝ) = ⊤ := by
    have hdim : Module.finrank ℝ (Euclid (n + 1)) = Module.finrank ℝ (Euclid n × ℝ) := by
      rw [Module.finrank_prod, Module.finrank_self, finrank_euclideanSpace_fin,
        finrank_euclideanSpace_fin]
    exact LinearMap.range_eq_top.2
      ((LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdim).1
        (LinearMap.ker_eq_bot.1 hker₀))
  obtain ⟨E₀, hE₀⟩ : ∃ E₀ : Euclid (n + 1) ≃L[ℝ] Euclid n × ℝ,
      (E₀ : Euclid (n + 1) →L[ℝ] Euclid n × ℝ) = π.prod ℓ :=
    ⟨ContinuousLinearEquiv.ofBijective _ hker₀ hrange₀,
      ContinuousLinearEquiv.coe_ofBijective _ _ _⟩
  have hΘE₀ : HasFDerivAt Θ (E₀ : Euclid (n + 1) →L[ℝ] Euclid n × ℝ) y₀ := by
    rw [hE₀]
    exact hΘd y₀
  -- the set `O` where `DΘ` is invertible is open (`DΘ` is continuous) and contains `y₀`
  set O : Set (Euclid (n + 1)) :=
    fderiv ℝ Θ ⁻¹' range ContinuousLinearEquiv.toContinuousLinearMap
  have hO : IsOpen O :=
    ContinuousLinearEquiv.isOpen.preimage (hΘ.continuous_fderiv one_ne_zero)
  have hy₀O : y₀ ∈ O := ⟨E₀, hΘE₀.fderiv.symm⟩
  -- Step 5, the inverse function theorem for `Θ` at `y₀`, restricted to `O ∩ W`
  have hΘs : HasStrictFDerivAt Θ (E₀ : Euclid (n + 1) →L[ℝ] Euclid n × ℝ) y₀ :=
    hΘ.contDiffAt.hasStrictFDerivAt' hΘE₀ one_ne_zero
  obtain ⟨Φ, hΦ, hΦsrc, hy₀Φ⟩ : ∃ Φ : OpenPartialHomeomorph (Euclid (n + 1)) (Euclid n × ℝ),
      (Φ : Euclid (n + 1) → Euclid n × ℝ) = Θ ∧ Φ.source ⊆ O ∩ W ∧ y₀ ∈ Φ.source :=
    ⟨(hΘs.toOpenPartialHomeomorph Θ).restrOpen (O ∩ W) (hO.inter hW), rfl, inter_subset_right,
      ⟨hΘs.mem_toOpenPartialHomeomorph_source, hy₀O, hy₀⟩⟩
  -- Step 6, the chart `Λ(z) = Φ⁻¹(z, t)` on the open set `D = {z | (z, t) ∈ target Φ}`
  set D : Set (Euclid n) := (fun z => (z, t)) ⁻¹' Φ.target
  set Λ : Euclid n → Euclid (n + 1) := fun z => Φ.symm (z, t)
  have hD : IsOpen D := Φ.open_target.preimage (continuous_id.prodMk continuous_const)
  -- Step 7, for `z ∈ D`, `Λ(z) ∈ source Φ ⊆ O ∩ W` and `Θ(Λ z) = (z, t)`
  have hΛsrc : ∀ z ∈ D, Λ z ∈ Φ.source := fun z hz => Φ.map_target hz
  have hΘΛ : ∀ z ∈ D, Θ (Λ z) = (z, t) := fun z hz => by
    rw [← hΦ]
    exact Φ.right_inv hz
  have hπΛ : ∀ z ∈ D, π (Λ z) = z := fun z hz => congrArg Prod.fst (hΘΛ z hz)
  have hFΛ : ∀ z ∈ D, F (Λ z) = t := fun z hz => congrArg Prod.snd (hΘΛ z hz)
  -- Step 9, `Λ` is `C¹` at `z ∈ D` with `DΛ(z) = E⁻¹ ∘ inl`, `E = DΘ(Λ z) = π × DF(Λ z)`
  have hΛd : ∀ z ∈ D, ∃ E : Euclid (n + 1) ≃L[ℝ] Euclid n × ℝ,
      (E : Euclid (n + 1) →L[ℝ] Euclid n × ℝ) = π.prod (fderiv ℝ F (Λ z)) ∧
      HasFDerivAt Λ ((E.symm : Euclid n × ℝ →L[ℝ] Euclid (n + 1)).comp
        (ContinuousLinearMap.inl ℝ (Euclid n) ℝ)) z ∧ ContDiffAt ℝ 1 Λ z := by
    intro z hz
    obtain ⟨E, hE⟩ := (hΦsrc (hΛsrc z hz)).1
    have hEΘ : (E : Euclid (n + 1) →L[ℝ] Euclid n × ℝ) = π.prod (fderiv ℝ F (Λ z)) := by
      rw [← (hΘd (Λ z)).fderiv]
      exact hE
    have hΦE : HasFDerivAt Φ (E : Euclid (n + 1) →L[ℝ] Euclid n × ℝ) (Φ.symm (z, t)) := by
      rw [hΦ, hEΘ]
      exact hΘd _
    have hΦC : ContDiffAt ℝ 1 Φ (Φ.symm (z, t)) := by
      rw [hΦ]
      exact hΘ.contDiffAt
    exact ⟨E, hEΘ, (Φ.hasFDerivAt_symm hz hΦE).comp z (hasFDerivAt_prodMk_left z t),
      (Φ.contDiffAt_symm hz hΦE hΦC).comp z (contDiffAt_id.prodMk contDiffAt_const)⟩
  -- Step 12, `c = π(y₀) ∈ D` since `(c, t) = Θ(y₀)`; `B̄_ρ(c) ⊆ B_ε(c) ⊆ D` for `ρ = ε/2`
  have hcD : π y₀ ∈ D := by
    show (π y₀, t) ∈ Φ.target
    have h := Φ.map_source hy₀Φ
    rw [hΦ] at h
    exact h
  obtain ⟨ε, hε, hεD⟩ := Metric.isOpen_iff.1 hD (π y₀) hcD
  -- Step 13, `N = source Φ ∩ π⁻¹(B_ρ(c))`
  refine ⟨D, Λ, π y₀, ε / 2, Φ.source ∩ π ⁻¹' ball (π y₀) (ε / 2), hD, fun z hz => ?_,
    ?_, ?_, ?_, ?_, ?_, ?_⟩
  · obtain ⟨E, -, -, hΛC⟩ := hΛd z hz
    exact hΛC.contDiffWithinAt
  · -- Step 8, `π ∘ Λ = id` on `D`
    intro z hz z' hz' h
    rw [← hπΛ z hz, ← hπΛ z' hz', h]
  · intro z hz
    obtain ⟨E, hEΘ, hΛE, -⟩ := hΛd z hz
    have hEv : ∀ v, E v = (π v, fderiv ℝ F (Λ z) v) := fun v => by
      rw [← ContinuousLinearEquiv.coe_coe, hEΘ]
      rfl
    refine ⟨(hΦsrc (hΛsrc z hz)).2, hFΛ z hz, ?_, ?_⟩
    · -- Step 10, `E⁻¹ ∘ inl` is injective
      rw [hΛE.fderiv]
      intro w w' h
      have h' : ((w, 0) : Euclid n × ℝ) = (w', 0) := E.symm.injective h
      exact congrArg Prod.fst h'
    · -- Step 11, `E v = (π v, DF(Λ z) v)`: `E⁻¹(w, 0) ∈ ker DF(Λ z)`, and `v = E⁻¹(π v, 0)`
      -- if `DF(Λ z) v = 0`
      rw [hΛE.fderiv]
      ext v
      rw [LinearMap.mem_range, LinearMap.mem_ker]
      constructor
      · rintro ⟨w, rfl⟩
        have h := hEv (E.symm (w, 0))
        rw [ContinuousLinearEquiv.apply_symm_apply] at h
        exact (congrArg Prod.snd h).symm
      · intro hv
        refine ⟨π v, E.injective ?_⟩
        change E (E.symm (π v, 0)) = E v
        rw [ContinuousLinearMap.coe_coe] at hv
        rw [ContinuousLinearEquiv.apply_symm_apply, hEv, hv]
  · exact (closedBall_subset_ball (half_lt_self hε)).trans hεD
  · exact Φ.open_source.inter (isOpen_ball.preimage π.continuous)
  · exact ⟨hy₀Φ, mem_ball_self (half_pos hε)⟩
  · -- `y ∈ N` with `F y = t` has `Φ(y) = (π y, t)`, so `Λ(π y) = Φ⁻¹(Φ y) = y`
    rintro y ⟨⟨hyΦ, hyB⟩, hyF⟩
    refine ⟨π y, hyB, ?_⟩
    have hyF' : F y = t := hyF
    have h := Φ.left_inv hyΦ
    rw [hΦ] at h
    show Φ.symm (π y, t) = y
    rw [← hyF']
    exact h

/-- **Countable chart cover of a regular level set** (Simon Ch. 2, before 6.4: "the implicit
function theorem implies that either `f⁻¹(y) ∖ C` is empty or else it is a `k`-dimensional `C¹`
submanifold", chapter-02.txt lines 1479–1496; used for the slice tangent planes of Ch. 6,
Lemma 4.1(2)).  Let `W ⊆ ℝ^{n+1}` be open, `F` be `C¹` and `t ∈ ℝ`.  There are countably many
`C¹` maps `Λ_k`, injective on open sets `D_k ⊇ B̄_{ρ_k}(c_k)` and with values in `W ∩ {F = t}`,
such that `DΛ_k(z)` is injective with range `ker DF(Λ_k z)` and every `y ∈ W` with `DF(y) ≠ 0`,
`F(y) = t` is `Λ_k(z)` for some `k` and `z ∈ B_{ρ_k}(c_k)`.  Take the local chart
(`dor_lmbsf_pst_level_set_local_chart`) at each such `y`, with neighbourhood `N_y`, and a
countable subfamily of the open sets `N_y` with the same union (second countability); if there
is no such `y`, take empty charts with `ρ_k = -1`. -/
theorem Submission.dor_lmbsf_pst_level_set_chart_cover : ∀ (n : ℕ) (W : Set (Euclid (n + 1))) (F : Euclid (n + 1) → ℝ) (t : ℝ), IsOpen W → ContDiff ℝ 1 F → ∃ (D : ℕ → Set (Euclid n)) (Λ : ℕ → Euclid n → Euclid (n + 1)) (c : ℕ → Euclid n) (ρ : ℕ → ℝ), (∀ k, IsOpen (D k)) ∧ (∀ k, ContDiffOn ℝ 1 (Λ k) (D k)) ∧ (∀ k, InjOn (Λ k) (D k)) ∧ (∀ k, ∀ z ∈ D k, Λ k z ∈ W ∧ F (Λ k z) = t ∧ Injective (fderiv ℝ (Λ k) z) ∧ LinearMap.range (fderiv ℝ (Λ k) z : Euclid n →ₗ[ℝ] Euclid (n + 1)) = LinearMap.ker (fderiv ℝ F (Λ k z) : Euclid (n + 1) →ₗ[ℝ] ℝ)) ∧ (∀ k, closedBall (c k) (ρ k) ⊆ D k) ∧ ∀ y ∈ W, fderiv ℝ F y ≠ 0 → F y = t → ∃ k, ∃ z ∈ ball (c k) (ρ k), Λ k z = y := by
  intro n W F t hW hF
  by_cases hne : ∃ y, y ∈ W ∧ fderiv ℝ F y ≠ 0 ∧ F y = t
  swap
  · -- Step 1, no regular point of `{F = t}` in `W`: empty charts, `B̄_{-1}(0) = ∅`
    refine ⟨fun _ => ∅, fun _ => 0, fun _ => 0, fun _ => -1, fun _ => isOpen_empty,
      fun _ => contDiffOn_empty, fun _ => injOn_empty _,
      fun _ z hz => (Set.notMem_empty z hz).elim,
      fun _ => (closedBall_eq_empty.2 (by norm_num)).subset, fun y hyW hdF hFy => ?_⟩
    exact (hne ⟨y, hyW, hdF, hFy⟩).elim
  obtain ⟨y₀, hy₀⟩ := hne
  -- Step 2, a local chart `(D y, Λ y, c y, ρ y)` with neighbourhood `N y` at each regular point `y`
  choose D Λ c ρ N hD hΛ hinj hprop hcb hNo hyN hcov using
    fun y : {y // y ∈ W ∧ fderiv ℝ F y ≠ 0 ∧ F y = t} =>
      Submission.dor_lmbsf_pst_level_set_local_chart n W F y hW hF y.2.1 y.2.2.1
  -- Step 3, the `N y` with `y` in a countable `T` have the same union; `T ≠ ∅` as `y₀` is regular
  obtain ⟨T, hTc, hTU⟩ := TopologicalSpace.isOpen_iUnion_countable N hNo
  have hT : ∀ y : {y // y ∈ W ∧ fderiv ℝ F y ≠ 0 ∧ F y = t},
      ∃ i ∈ T, (y : Euclid (n + 1)) ∈ N i := by
    intro y
    have hy : (y : Euclid (n + 1)) ∈ ⋃ i ∈ T, N i := by
      rw [hTU]
      exact mem_iUnion.2 ⟨y, hyN y⟩
    obtain ⟨i, hi, hyi⟩ := mem_iUnion₂.1 hy
    exact ⟨i, hi, hyi⟩
  obtain ⟨i₀, hi₀, -⟩ := hT ⟨y₀, hy₀⟩
  obtain ⟨e, rfl⟩ := hTc.exists_eq_range ⟨i₀, hi₀⟩
  -- Step 4, the charts at the points `e k`, where `F (e k) = t`
  refine ⟨fun k => D (e k), fun k => Λ (e k), fun k => c (e k), fun k => ρ (e k),
    fun k => hD (e k), fun k => hΛ (e k), fun k => hinj (e k), fun k z hz => ?_,
    fun k => hcb (e k), fun y hyW hdF hFy => ?_⟩
  · obtain ⟨h₁, h₂, h₃, h₄⟩ := hprop (e k) z hz
    exact ⟨h₁, h₂.trans (e k).2.2.2, h₃, h₄⟩
  · -- Step 5, `y ∈ N (e k) ∩ F⁻¹(F (e k)) ⊆ Λ (e k) '' B_{ρ (e k)}(c (e k))` for some `k`
    obtain ⟨_, ⟨k, rfl⟩, hyk⟩ := hT ⟨y, hyW, hdF, hFy⟩
    obtain ⟨z, hz, hzy⟩ := hcov (e k) ⟨hyk, hFy.trans (e k).2.2.2.symm⟩
    exact ⟨k, z, hz, hzy⟩
/-- **Approximate tangent spaces of compact `C¹` patches pass to `S`** (Simon Ch. 3, 1.4; the
locality step (TL) applied patch by patch).  Assume (TL).  Let `S` be Borel with `Hⁿ(S) < ∞`, and
for each `k` let `χ_k` be `C¹` on the open `D_k ⊇ K_k = B̄_{ρ_k}(c_k)` and injective on `K_k`.  The
patch `Σ_k = χ_k(K_k)` is compact with `Hⁿ(Σ_k) < ∞` (Lipschitz image of a compact ball), and
`A_k = S ∩ χ_k(B_{ρ_k}(c_k))` is Borel (Lusin–Souslin) with `A_k ⊆ Σ_k` and `A_k ⊆ S`.  Two
applications of (TL) with `U = ℝᴾ` give, `Hⁿ`-a.e. on `A_k`, `Σ_k`-tangent `Q` ⇒ `A_k`-tangent `Q`
⇒ `S`-tangent `Q`; intersecting over the countably many `k` gives the claim `Hⁿ`-a.e. on `S`. -/
theorem Submission.dor_lmbsf_pst_patch_tangent_transfer : (∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q) → ∀ (P n : ℕ) (S : Set (Euclid P)) (D : ℕ → Set (Euclid n)) (χ : ℕ → Euclid n → Euclid P) (c : ℕ → Euclid n) (ρ : ℕ → ℝ), MeasurableSet S → μHE[n] S ≠ ∞ → (∀ k, IsOpen (D k)) → (∀ k, ContDiffOn ℝ 1 (χ k) (D k)) → (∀ k, closedBall (c k) (ρ k) ⊆ D k) → (∀ k, InjOn (χ k) (closedBall (c k) (ρ k))) → ∀ᵐ x ∂(μHE[n].restrict S), ∀ k, ∀ z ∈ ball (c k) (ρ k), χ k z = x → ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n (χ k '' closedBall (c k) (ρ k)) x Q → HasApproximateTangentSpaceAt n S x Q := by
  intro TL P n S D χ c ρ hS hSfin hD hχ hKD hinj
  -- Steps 1–7, for each patch `k`: `Hⁿ⌞S`-a.e., if `x ∈ A_k = S ∩ χ_k(B_k)`, every approximate
  -- tangent space of `Σ_k = χ_k(K_k)` at `x` is one of `S`
  have hpatch : ∀ k, ∀ᵐ x ∂(μHE[n].restrict S), x ∈ S ∩ χ k '' ball (c k) (ρ k) →
      ∀ Q : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt n (χ k '' closedBall (c k) (ρ k)) x Q →
          HasApproximateTangentSpaceAt n S x Q := by
    intro k
    -- Step 1, `Σ_k` is compact, hence Borel
    have hχK : ContinuousOn (χ k) (closedBall (c k) (ρ k)) :=
      ((hχ k).mono (hKD k)).continuousOn
    have hsig : MeasurableSet (χ k '' closedBall (c k) (ρ k)) :=
      ((isCompact_closedBall _ _).image_of_continuousOn hχK).isClosed.measurableSet
    -- Step 2, `χ_k` is `L`-Lipschitz on the convex compact `K_k`, so `Hⁿ(Σ_k) ≤ Lⁿ Hⁿ(K_k) < ∞`
    obtain ⟨L, hL⟩ := ((hχ k).mono (hKD k)).exists_lipschitzOnWith one_ne_zero
      (convex_closedBall _ _) (isCompact_closedBall _ _)
    have hsigfin : μHE[n] (χ k '' closedBall (c k) (ρ k)) ≠ ∞ := by
      refine ne_top_of_le_ne_top (ENNReal.mul_ne_top (ENNReal.pow_ne_top ENNReal.coe_ne_top) ?_)
        (Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n hL)
      rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
      exact (isCompact_closedBall _ _).measure_lt_top.ne
    -- Step 3, `A_k` is Borel (Lusin–Souslin for the injective continuous `χ_k` on `B_k`)
    have hA : MeasurableSet (S ∩ χ k '' ball (c k) (ρ k)) :=
      hS.inter (measurableSet_ball.image_of_continuousOn_injOn
        (hχK.mono ball_subset_closedBall) ((hinj k).mono ball_subset_closedBall))
    -- Steps 4–6, `A_k ⊆ Σ_k` and `A_k ⊆ S`, and (TL) applies to both pairs with `U = ℝᴾ`
    have h1 := TL P n univ _ _ isOpen_univ hA hsig
      (inter_subset_right.trans (image_mono ball_subset_closedBall)) (subset_univ _)
      fun K _ _ => ne_top_of_le_ne_top hsigfin (measure_mono inter_subset_left)
    have h2 := TL P n univ _ _ isOpen_univ hA hS inter_subset_left (subset_univ _)
      fun K _ _ => ne_top_of_le_ne_top hSfin (measure_mono inter_subset_left)
    -- Step 7, `Hⁿ⌞A_k`-a.e., `Σ_k`-tangent `Q` ⇒ `A_k`-tangent `Q` ⇒ `S`-tangent `Q`
    have h3 : ∀ᵐ x ∂(μHE[n].restrict (S ∩ χ k '' ball (c k) (ρ k))),
        ∀ Q : Submodule ℝ (Euclid P),
          HasApproximateTangentSpaceAt n (χ k '' closedBall (c k) (ρ k)) x Q →
            HasApproximateTangentSpaceAt n S x Q := by
      filter_upwards [h1, h2] with x hx1 hx2 Q hQ
      exact (hx2 Q).2 ((hx1 Q).1 hQ)
    exact ae_restrict_of_ae ((ae_restrict_iff' hA).1 h3)
  -- Steps 8–9, intersect over the countably many `k`; `x = χ_k(z)` with `z ∈ B_k` lies in `A_k`
  filter_upwards [ae_all_iff.2 hpatch, ae_restrict_mem hS] with x hx hxS k z hz hzx Q hQ
  exact hx k ⟨hxS, z, hz, hzx⟩ Q hQ
/-- **Slices of one `C¹` chart piece** (Simon Ch. 6, Lemma 4.1(1),(2) for one piece; Ch. 2, 6.4
and Remark 4.4; Ch. 3, Lemma 1.2 "if").  For `y ∈ Y`, `G(ψ(y)) ≠ 0 ⇔ DF(y) ≠ 0`, so
`S_t = ψ(Y ∩ Γ_t)` with `Γ_t = {DF ≠ 0} ∩ F⁻¹(t)`, a Borel set by Lusin–Souslin.  Countably many
`C¹` graph charts `Λ_k` cover `Γ_t ∩ V`, and `χ_k := ψ ∘ Λ_k` is `C¹` with `Dχ_k(z)` injective of
range `Dψ(y)(ker DF(y)) = Dψ(y)(ℝ^{n+1}) ∩ G(ψ(y))^⊥`, `y = Λ_k(z)`.  (i) `S_t ⊆ ⋃_k χ_k(D_k)`.
(ii) The compact patch `χ_k(B̄_{ρ_k}(c_k))` has approximate tangent space `Dχ_k(z)(ℝⁿ)` at
`χ_k(z)`, `z ∈ B_{ρ_k}(c_k)`, and (TL) transfers it to `S_t`, `Hⁿ`-a.e. on `S_t`. -/
theorem Submission.dor_lmbsf_piece_slice_approxTangent : (∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q) → ∀ (P n : ℕ) (V C Y : Set (Euclid (n + 1))) (ψ : Euclid (n + 1) → Euclid P) (F : Euclid (n + 1) → ℝ) (f : Euclid P → ℝ) (G : Euclid P → Euclid P), IsOpen V → ContDiffOn ℝ 1 ψ V → InjOn ψ V → (∀ y ∈ V, Injective (fderiv ℝ ψ y)) → IsCompact C → C ⊆ V → MeasurableSet Y → Y ⊆ C → ContDiff ℝ 1 F → (∀ y ∈ Y, f (ψ y) = F y) → (∀ y ∈ Y, G (ψ y) ∈ LinearMap.range (fderiv ℝ ψ y : Euclid (n + 1) →ₗ[ℝ] Euclid P) ∧ ∀ e : Euclid (n + 1), inner ℝ (G (ψ y)) (fderiv ℝ ψ y e) = fderiv ℝ F y e) → ∀ t : ℝ, CountablyRectifiable n (ψ '' Y ∩ {x | G x ≠ 0} ∩ f ⁻¹' {t}) ∧ (μHE[n] (ψ '' Y ∩ {x | G x ≠ 0} ∩ f ⁻¹' {t}) ≠ ∞ → ∀ᵐ x ∂(μHE[n].restrict (ψ '' Y ∩ {x | G x ≠ 0} ∩ f ⁻¹' {t})), ∀ y ∈ Y, ψ y = x → HasApproximateTangentSpaceAt n (ψ '' Y ∩ {x | G x ≠ 0} ∩ f ⁻¹' {t}) x (LinearMap.range (fderiv ℝ ψ y : Euclid (n + 1) →ₗ[ℝ] Euclid P) ⊓ (ℝ ∙ G x)ᗮ)) := by
  intro hTL P n V C Y ψ F f G hV hψ hψinj hDψ hC hCV hY hYC hF hfF hG t
  have hYV : Y ⊆ V := hYC.trans hCV
  -- Step 1, for `y ∈ Y`: `G(ψ(y)) = 0 ⇔ DF(y) = 0`, and
  -- `Dψ(y)(ℝ^{n+1}) ∩ G(ψ(y))^⊥ = Dψ(y)(ker DF(y))`
  have halg := fun y (hy : y ∈ Y) => Submission.dor_lmbsf_pst_slice_plane_algebra (n + 1) P
    (fderiv ℝ ψ y) (fderiv ℝ F y) (G (ψ y)) (hG y hy).1 (hG y hy).2
  set S := ψ '' Y ∩ {x | G x ≠ 0} ∩ f ⁻¹' {t}
  have hlevel : ∀ y ∈ Y, ψ y ∈ S → fderiv ℝ F y ≠ 0 ∧ F y = t := by
    rintro y hy ⟨⟨-, hGy⟩, hfy⟩
    exact ⟨fun h => hGy ((halg y hy).1.2 h), (hfF y hy).symm.trans hfy⟩
  -- so `S_t = ψ(Y ∩ Γ_t)`
  have hSeq : S = ψ '' (Y ∩ {y | fderiv ℝ F y ≠ 0} ∩ F ⁻¹' {t}) := by
    refine Subset.antisymm (fun x hx => ?_) ?_
    · obtain ⟨y, hy, rfl⟩ := hx.1.1
      exact ⟨y, ⟨⟨hy, (hlevel y hy hx).1⟩, (hlevel y hy hx).2⟩, rfl⟩
    · rintro x ⟨y, ⟨⟨hy, hDF⟩, hFy⟩, rfl⟩
      exact ⟨⟨mem_image_of_mem ψ hy, fun h => hDF ((halg y hy).1.1 h)⟩, (hfF y hy).trans hFy⟩
  -- Step 2, countably many `C¹` graph charts `Λ_k : D_k → Γ_t ∩ V` with
  -- `Γ_t ∩ V = ⋃_k Λ_k(B_{ρ_k}(c_k))`; `χ_k := ψ ∘ Λ_k` is `C¹` on `D_k` and injective on
  -- `B̄_{ρ_k}(c_k)`
  obtain ⟨D, Λ, c, ρ, hDo, hΛ, hΛinj, hΛD, hball, hcover⟩ :=
    Submission.dor_lmbsf_pst_level_set_chart_cover n V F t hV hF
  have hΛV : ∀ k, MapsTo (Λ k) (D k) V := fun k z hz => (hΛD k z hz).1
  have hχ : ∀ k, ContDiffOn ℝ 1 (ψ ∘ Λ k) (D k) := fun k => hψ.comp (hΛ k) (hΛV k)
  have hχinj : ∀ k, InjOn (ψ ∘ Λ k) (closedBall (c k) (ρ k)) := fun k =>
    (hψinj.comp (hΛinj k) (hΛV k)).mono (hball k)
  have hchart : ∀ y ∈ Y, ψ y ∈ S → ∃ k, ∃ z ∈ ball (c k) (ρ k), Λ k z = y := fun y hy hyS =>
    hcover y (hYV hy) (hlevel y hy hyS).1 (hlevel y hy hyS).2
  refine ⟨?_, fun hfin => ?_⟩
  · -- Step 3, (i): `S_t ⊆ ⋃_k χ_k(D_k)`, a countable union of `C¹` images of open sets
    refine (Poincare.SimonGMT.Chapter03.countablyRectifiable_iUnion (fun k => (ψ ∘ Λ k) '' D k)
      fun k => Poincare.SimonGMT.Chapter03.countablyRectifiable_image_contDiffOn_open (hDo k)
        (hχ k)).mono fun x hx => ?_
    obtain ⟨y, hy, rfl⟩ := hx.1.1
    obtain ⟨k, z, hz, rfl⟩ := hchart y hy hx
    exact mem_iUnion.2 ⟨k, z, hball k (ball_subset_closedBall hz), rfl⟩
  -- Step 4, (ii): `S_t` is Borel, so (TL) transfers the tangent planes of the compact patches
  -- `χ_k(B̄_{ρ_k}(c_k))` to `S_t` at `Hⁿ`-a.e. `x ∈ S_t`
  have hSmeas : MeasurableSet S := by
    have hΓ : MeasurableSet (Y ∩ {y | fderiv ℝ F y ≠ 0} ∩ F ⁻¹' {t}) :=
      (hY.inter (isOpen_ne_fun (hF.continuous_fderiv one_ne_zero)
        continuous_const).measurableSet).inter
        (hF.continuous.measurable (measurableSet_singleton t))
    rw [hSeq]
    exact hΓ.image_of_continuousOn_injOn (hψ.continuousOn.mono fun y hy => hYV hy.1.1)
      (hψinj.mono fun y hy => hYV hy.1.1)
  filter_upwards [Submission.dor_lmbsf_pst_patch_tangent_transfer hTL P n S D (fun k => ψ ∘ Λ k)
    c ρ hSmeas hfin hDo hχ hball hχinj, ae_restrict_mem hSmeas] with x hx hxS
  rintro y hy rfl
  obtain ⟨k, z, hz, rfl⟩ := hchart y hy hxS
  -- Step 5, `Dχ_k(z) = Dψ(Λ_k z) ∘ DΛ_k(z)` is injective, with range
  -- `Dψ(Λ_k z)(ker DF(Λ_k z)) = Dψ(Λ_k z)(ℝ^{n+1}) ∩ G(χ_k z)^⊥`
  have hzD : z ∈ D k := hball k (ball_subset_closedBall hz)
  obtain ⟨-, -, hDΛ, hrangeΛ⟩ := hΛD k z hzD
  have hderiv : fderiv ℝ (ψ ∘ Λ k) z = (fderiv ℝ ψ (Λ k z)).comp (fderiv ℝ (Λ k) z) :=
    fderiv_comp z ((hψ.contDiffAt (hV.mem_nhds (hΛV k hzD))).differentiableAt one_ne_zero)
      (((hΛ k).contDiffAt ((hDo k).mem_nhds hzD)).differentiableAt one_ne_zero)
  have hrange : LinearMap.range (fderiv ℝ (ψ ∘ Λ k) z : Euclid n →ₗ[ℝ] Euclid P) =
      LinearMap.range (fderiv ℝ ψ (Λ k z) : Euclid (n + 1) →ₗ[ℝ] Euclid P) ⊓
        (ℝ ∙ G (ψ (Λ k z)))ᗮ := by
    rw [(halg _ hy).2, hderiv, ContinuousLinearMap.toLinearMap_comp, LinearMap.range_comp,
      hrangeΛ]
  -- `image_tangent`: the patch `χ_k(B̄_{ρ_k}(c_k))` has approximate tangent space
  -- `Dχ_k(z)(ℝⁿ)` at `χ_k(z)`, since `z ∈ B_{ρ_k}(c_k) ⊆ int B̄_{ρ_k}(c_k)`
  have himage := Submission.dor_lmbsf_c1_image_approxTangent n P (D k) (closedBall (c k) (ρ k))
    (ψ ∘ Λ k) z (hDo k) (hχ k) (isCompact_closedBall _ _) (hball k) (hχinj k)
    (ball_subset_interior_closedBall hz)
    (by rw [hderiv, ContinuousLinearMap.coe_comp]; exact (hDψ _ (hYV hy)).comp hDΛ)
  rw [hrange] at himage
  exact hx k z hz rfl _ himage
/-- **Weak convergence of derivatives against `C¹` test fields.**  If the `uₖ : ℝᵈ → ℝ` are
`K`-Lipschitz and converge uniformly to `u`, and `Ψ : ℝᵈ → ℝᵈ` is `C¹` with compact support, then
`∫ Duₖ[Ψ] → ∫ Du[Ψ]`.  The limit `u` is again `K`-Lipschitz.  Writing `Ψ = Σₗ Ψₗ eₗ`,
Rademacher's theorem and integration by parts give `∫ Dv[Ψ] = Σₗ ∫ qₗ v` for every Lipschitz `v`,
where `qₗ = DΨₗ[-eₗ]` is continuous with compact support; dominated convergence with the bound
`|qₗ| (|u| + 1)` gives `∫ qₗ uₖ → ∫ qₗ u`. -/
theorem Submission.dor_lmbsf_pwl_fderiv_weak_smooth : ∀ (d : ℕ) (K : NNReal) (us : ℕ → Euclid d → ℝ) (u : Euclid d → ℝ) (Ψ : Euclid d → Euclid d), (∀ k, LipschitzWith K (us k)) → TendstoUniformly us u atTop → ContDiff ℝ 1 Ψ → HasCompactSupport Ψ → Tendsto (fun k => ∫ y, fderiv ℝ (us k) y (Ψ y)) atTop (𝓝 (∫ y, fderiv ℝ u y (Ψ y))) := by
  intro d K us u Ψ hus hU hΨ hΨc
  -- the uniform limit `u` is again `K`-Lipschitz
  have hu : LipschitzWith K u := by
    refine LipschitzWith.of_dist_le_mul fun x y => ?_
    exact le_of_tendsto ((hU.tendsto_at x).dist (hU.tendsto_at y))
      (Eventually.of_forall fun k => (hus k).dist_le_mul x y)
  -- coordinates `Ψₗ = ⟨Ψ, eₗ⟩`: `C¹` with compact support
  set e : Fin d → Euclid d := fun l => EuclideanSpace.single l 1
  set g : Fin d → Euclid d → ℝ := fun l y => Ψ y l
  have hg_smooth : ∀ l, ContDiff ℝ 1 (g l) := fun l =>
    (EuclideanSpace.proj l : Euclid d →L[ℝ] ℝ).contDiff.comp hΨ
  have hg_supp : ∀ l, HasCompactSupport (g l) := fun l =>
    hΨc.comp_left (g := fun v : Euclid d => v l) (by simp)
  have hdecomp : ∀ (L : Euclid d →L[ℝ] ℝ) (x : Euclid d), L x = ∑ l, L (e l) * x l := by
    intro L x
    conv_lhs => rw [← (EuclideanSpace.basisFun (Fin d) ℝ).sum_repr x]
    simp [map_sum, map_smul, e, EuclideanSpace.basisFun_apply, mul_comm]
  -- `qₗ = DΨₗ[-eₗ]` is continuous with compact support
  set q : Fin d → Euclid d → ℝ := fun l y => lineDeriv ℝ (g l) y (-(e l))
  have hq_eq : ∀ l, q l = fun y => fderiv ℝ (g l) y (-(e l)) := fun l => funext fun y =>
    ((hg_smooth l).differentiable one_ne_zero y).lineDeriv_eq_fderiv
  have hq_cont : ∀ l, Continuous (q l) := by
    intro l
    rw [hq_eq l]
    exact ((hg_smooth l).continuous_fderiv one_ne_zero).clm_apply continuous_const
  have hq_supp : ∀ l, HasCompactSupport (q l) := by
    intro l
    rw [hq_eq l]
    exact ((hg_supp l).fderiv (𝕜 := ℝ)).comp_left (g := fun L : Euclid d →L[ℝ] ℝ => L (-(e l)))
      (by simp)
  -- for Lipschitz `v`, `∫ Dv[Ψ] = Σₗ ∫ Dv[eₗ] Ψₗ = Σₗ ∫ qₗ v` (Rademacher, integration by parts)
  have hsum : ∀ (v : Euclid d → ℝ) (C : NNReal), LipschitzWith C v →
      ∫ y, fderiv ℝ v y (Ψ y) = ∑ l, ∫ y, q l y * v y := by
    intro v C hv
    have h1 : (fun y => fderiv ℝ v y (Ψ y)) = fun y => ∑ l, fderiv ℝ v y (e l) * g l y := by
      funext y
      exact hdecomp _ _
    rw [h1, integral_finsetSum]
    · refine Finset.sum_congr rfl fun l _ => ?_
      obtain ⟨D, hD⟩ := (hg_smooth l).lipschitzWith_of_hasCompactSupport (hg_supp l) one_ne_zero
      rw [← hv.integral_lineDeriv_mul_eq hD (hg_supp l) (e l)]
      apply integral_congr_ae
      filter_upwards [hv.ae_differentiableAt] with y hy
      rw [hy.lineDeriv_eq_fderiv]
    · intro l _
      have hgi : Integrable (g l) :=
        (hg_smooth l).continuous.integrable_of_hasCompactSupport (hg_supp l)
      refine Integrable.bdd_mul (c := C * ‖e l‖) hgi
        (measurable_fderiv_apply_const ℝ v (e l)).aestronglyMeasurable
        (Eventually.of_forall fun y => ?_)
      exact (ContinuousLinearMap.le_opNorm _ _).trans
        (mul_le_mul_of_nonneg_right (norm_fderiv_le_of_lipschitz ℝ hv) (norm_nonneg _))
  rw [hsum u K hu]
  have hk : (fun k => ∫ y, fderiv ℝ (us k) y (Ψ y)) = fun k => ∑ l, ∫ y, q l y * us k y := by
    funext k
    exact hsum (us k) K (hus k)
  rw [hk]
  -- dominated convergence for each `∫ qₗ uₖ`, with bound `|qₗ| (|u| + 1)`
  refine tendsto_finsetSum _ fun l _ => ?_
  apply tendsto_integral_filter_of_dominated_convergence (fun y => ‖q l y‖ * (‖u y‖ + 1))
  · exact Eventually.of_forall fun k => ((hq_cont l).mul (hus k).continuous).aestronglyMeasurable
  · rw [Metric.tendstoUniformly_iff] at hU
    filter_upwards [hU 1 one_pos] with k hk
    refine Eventually.of_forall fun y => ?_
    rw [norm_mul]
    gcongr
    have h1 := hk y
    rw [dist_eq_norm] at h1
    have h2 : ‖us k y‖ ≤ ‖u y‖ + ‖u y - us k y‖ := by
      have := norm_sub_norm_le (us k y) (u y)
      rw [norm_sub_rev] at this
      linarith
    linarith
  · exact ((hq_cont l).norm.mul (hu.continuous.norm.add continuous_const))
      |>.integrable_of_hasCompactSupport (hq_supp l).norm.mul_right
  · exact Eventually.of_forall fun y => ((hU.tendsto_at y).const_mul (q l y))

/-- **Weak convergence of derivatives against `L¹` fields.**  If the `uₖ : ℝᵈ → ℝ` are
`K`-Lipschitz and converge uniformly to `u`, then `∫ Duₖ[Φ] → ∫ Du[Φ]` for every integrable
`Φ : ℝᵈ → ℝᵈ`.  The limit `u` is `K`-Lipschitz, and for `K`-Lipschitz `v` and integrable `Θ` the
field `Dv[Θ]` is integrable with `|∫ Dv[Θ]| ≤ K ∫ |Θ|`.  Given `ε > 0`, take a `C¹` compactly
supported `Ψ` with `∫ |Φ - Ψ| ≤ ε/(4K + 1)`: such fields are dense in `L¹`, as each `c 1_s` with
`|s| < ∞` is approximated by `f c`, `f` a smooth Urysohn function for a compact `L ⊆ s` inside an
open `W ⊇ s` with `|W \ L|` small.  Then `|∫ Dv[Φ] - ∫ Dv[Ψ]| ≤ ε/4` for `v = uₖ, u`, and
`∫ Duₖ[Ψ] → ∫ Du[Ψ]` by `dor_lmbsf_pwl_fderiv_weak_smooth`. -/
theorem Submission.dor_lmbsf_pwl_fderiv_weak_integrable : ∀ (d : ℕ) (K : NNReal) (us : ℕ → Euclid d → ℝ) (u : Euclid d → ℝ) (Φ : Euclid d → Euclid d), (∀ k, LipschitzWith K (us k)) → TendstoUniformly us u atTop → Integrable Φ → Tendsto (fun k => ∫ y, fderiv ℝ (us k) y (Φ y)) atTop (𝓝 (∫ y, fderiv ℝ u y (Φ y))) := by
  intro d K us u Φ hus hU hΦ
  -- the uniform limit `u` is `K`-Lipschitz
  have hu : LipschitzWith K u := LipschitzWith.of_dist_le_mul fun x z =>
    le_of_tendsto ((hU.tendsto_at x).dist (hU.tendsto_at z))
      (Eventually.of_forall fun k => (hus k).dist_le_mul x z)
  -- `‖Dv‖ ≤ K` for `K`-Lipschitz `v`, so `Dv[Θ]` is integrable and `|∫ Dv[Θ]| ≤ K ∫ |Θ|`
  have hbound : ∀ v : Euclid d → ℝ, LipschitzWith K v → ∀ Θ : Euclid d → Euclid d,
      Integrable Θ → Integrable (fun y => fderiv ℝ v y (Θ y)) ∧
        ‖∫ y, fderiv ℝ v y (Θ y)‖ ≤ K * ∫ y, ‖Θ y‖ := by
    intro v hv Θ hΘ
    have hmeas : AEStronglyMeasurable (fun y => fderiv ℝ v y (Θ y)) volume :=
      Continuous.comp_aestronglyMeasurable
        (isBoundedBilinearMap_apply (𝕜 := ℝ) (E := Euclid d) (F := ℝ)).continuous
        ((measurable_fderiv ℝ v).aestronglyMeasurable.prodMk hΘ.aestronglyMeasurable)
    have hle : ∀ y, ‖fderiv ℝ v y (Θ y)‖ ≤ K * ‖Θ y‖ := fun y =>
      (ContinuousLinearMap.le_opNorm _ _).trans
        (mul_le_mul_of_nonneg_right (norm_fderiv_le_of_lipschitz ℝ hv) (norm_nonneg _))
    refine ⟨(hΘ.norm.const_mul K).mono' hmeas (Eventually.of_forall hle), ?_⟩
    calc ‖∫ y, fderiv ℝ v y (Θ y)‖ ≤ ∫ y, (K : ℝ) * ‖Θ y‖ :=
          norm_integral_le_of_norm_le (hΘ.norm.const_mul K) (Eventually.of_forall hle)
      _ = K * ∫ y, ‖Θ y‖ := integral_const_mul _ _
  -- `C¹` compactly supported fields are dense in `L¹`.  By `MemLp.induction_dense` it suffices to
  -- approximate `c 1_s` for `s` of finite measure: take a compact `L ⊆ s` and an open `W ⊇ s` with
  -- `|W \ L| < δ/|c|`, and a smooth `f : ℝᵈ → [0, 1]` with `f = 1` on `L` and support
  -- `W ∩ B_R(0) ⊇ L`; then `|f c - c 1_s| ≤ |c| 1_{W \ L}`.
  have hdense : ∀ ε : ℝ≥0∞, ε ≠ 0 → ∃ Ψ : Euclid d → Euclid d,
      eLpNorm (Φ - Ψ) 1 volume ≤ ε ∧ ContDiff ℝ 1 Ψ ∧ HasCompactSupport Ψ := by
    intro ε hε
    refine (memLp_one_iff_integrable.2 hΦ).induction_dense ENNReal.one_ne_top
      (fun Ψ => ContDiff ℝ 1 Ψ ∧ HasCompactSupport Ψ) ?_ ?_ hε
    · intro c s hs hμs δ hδ
      rcases eq_or_ne c 0 with rfl | hc
      · exact ⟨0, by simp, contDiff_const, HasCompactSupport.zero⟩
      have hc0 : ‖c‖ₑ ≠ 0 := enorm_ne_zero.2 hc
      have hη : δ / ‖c‖ₑ / 2 ≠ 0 := by simp [ENNReal.div_eq_zero_iff, hδ]
      obtain ⟨W, hsW, hWo, -, hW⟩ := hs.exists_isOpen_sdiff_lt hμs.ne hη
      obtain ⟨L, hLs, hLc, hL⟩ := hs.exists_isCompact_sdiff_lt hμs.ne hη
      obtain ⟨R, hR⟩ := hLc.isBounded.subset_ball 0
      obtain ⟨f, hfs, hf01, hfsupp, hf1⟩ := exists_contDiff_support_eq_eq_one_iff (n := 1)
        (hWo.inter isOpen_ball) hLc.isClosed (subset_inter (hLs.trans hsW) hR)
      have hf0 : ∀ x, x ∉ W ∩ ball 0 R → f x = 0 := fun x hx =>
        notMem_support.1 (hfsupp.symm ▸ hx)
      refine ⟨fun x => f x • c, ?_, hfs.smul contDiff_const, ?_⟩
      · have hpt : ∀ x, ‖((fun x => f x • c) - s.indicator fun _ => c) x‖
            ≤ ‖(W \ L).indicator (fun _ => c) x‖ := by
          intro x
          obtain ⟨hfx0, hfx1⟩ := hf01 (mem_range_self x)
          by_cases hxs : x ∈ s
          · by_cases hxL : x ∈ L
            · simp [indicator_of_mem hxs, (hf1 x).1 hxL]
            · rw [Pi.sub_apply, indicator_of_mem hxs,
                indicator_of_mem (mem_sdiff_of_mem (hsW hxs) hxL),
                show f x • c - c = (f x - 1) • c by rw [sub_smul, one_smul], norm_smul,
                Real.norm_eq_abs, abs_of_nonpos (by linarith)]
              exact mul_le_of_le_one_left (norm_nonneg _) (by linarith)
          · by_cases hxW : x ∈ W
            · rw [Pi.sub_apply, indicator_of_notMem hxs,
                indicator_of_mem (mem_sdiff_of_mem hxW fun h => hxs (hLs h)), sub_zero, norm_smul,
                Real.norm_eq_abs, abs_of_nonneg hfx0]
              exact mul_le_of_le_one_left (norm_nonneg _) hfx1
            · simp [indicator_of_notMem hxs, hf0 x fun h => hxW h.1]
        have hWL : volume (W \ L) ≤ δ / ‖c‖ₑ := by
          calc volume (W \ L) ≤ volume ((W \ s) ∪ (s \ L)) := measure_mono fun x hx => by
                by_cases h : x ∈ s
                · exact Or.inr ⟨h, hx.2⟩
                · exact Or.inl ⟨hx.1, h⟩
            _ ≤ volume (W \ s) + volume (s \ L) := measure_union_le _ _
            _ ≤ δ / ‖c‖ₑ / 2 + δ / ‖c‖ₑ / 2 := add_le_add hW.le hL.le
            _ = δ / ‖c‖ₑ := ENNReal.add_halves _
        calc eLpNorm ((fun x => f x • c) - s.indicator fun _ => c) 1 volume
            ≤ eLpNorm ((W \ L).indicator fun _ => c) 1 volume :=
              eLpNorm_mono ((hfs.continuous.smul continuous_const).aestronglyMeasurable.sub
                (aestronglyMeasurable_const.indicator hs)) hpt
          _ ≤ ‖c‖ₑ * volume (W \ L) := by
              simpa using eLpNorm_indicator_const_le c 1
                (μ := volume) (hWo.measurableSet.diff hLc.measurableSet).nullMeasurableSet
          _ ≤ ‖c‖ₑ * (δ / ‖c‖ₑ) := by gcongr
          _ = δ := ENNReal.mul_div_cancel hc0 enorm_ne_top
      · refine HasCompactSupport.intro (isCompact_closedBall 0 R) fun x hx => ?_
        rw [hf0 x fun h => hx (ball_subset_closedBall h.2), zero_smul]
    · rintro f g ⟨hf, hf'⟩ ⟨hg, hg'⟩
      exact ⟨hf.add hg, hf'.add hg'⟩
  refine Metric.tendsto_atTop.2 fun ε hε => ?_
  -- a `C¹` compactly supported `Ψ` with `∫ |Φ - Ψ| ≤ η`, where `Kη ≤ ε/4`
  set η : ℝ := ε / (4 * K + 1) with hη
  have hηpos : 0 < η := div_pos hε (by positivity)
  have hKη : (K : ℝ) * η ≤ ε / 4 := by
    rw [hη, mul_div_assoc', div_le_div_iff₀ (by positivity) (by norm_num)]
    nlinarith [K.2]
  obtain ⟨Ψ, hΨε, hΨs, hΨc⟩ := hdense (ENNReal.ofReal η) (ENNReal.ofReal_pos.2 hηpos).ne'
  have hΨi : Integrable Ψ := hΨs.continuous.integrable_of_hasCompactSupport hΨc
  have hdiff : ∫ y, ‖(Φ - Ψ) y‖ ≤ η := by
    rw [integral_norm_eq_lintegral_enorm (hΦ.sub hΨi).aestronglyMeasurable,
      ← eLpNorm_one_eq_lintegral_enorm (hΦ.sub hΨi).aestronglyMeasurable]
    exact ENNReal.toReal_le_of_le_ofReal hηpos.le hΨε
  -- replacing `Φ` by `Ψ` moves `∫ Dv[Φ]` by at most `Kη ≤ ε/4`
  have hclose : ∀ v : Euclid d → ℝ, LipschitzWith K v →
      dist (∫ y, fderiv ℝ v y (Φ y)) (∫ y, fderiv ℝ v y (Ψ y)) ≤ ε / 4 := by
    intro v hv
    rw [dist_eq_norm, ← integral_sub (hbound v hv Φ hΦ).1 (hbound v hv Ψ hΨi).1]
    calc ‖∫ y, (fderiv ℝ v y (Φ y) - fderiv ℝ v y (Ψ y))‖
        = ‖∫ y, fderiv ℝ v y ((Φ - Ψ) y)‖ := by simp only [Pi.sub_apply, map_sub]
      _ ≤ K * ∫ y, ‖(Φ - Ψ) y‖ := (hbound v hv (Φ - Ψ) (hΦ.sub hΨi)).2
      _ ≤ K * η := mul_le_mul_of_nonneg_left hdiff K.2
      _ ≤ ε / 4 := hKη
  -- `∫ Duₖ[Ψ] → ∫ Du[Ψ]` for the `C¹` compactly supported field `Ψ`
  obtain ⟨N, hN⟩ := Metric.tendsto_atTop.1
    (Submission.dor_lmbsf_pwl_fderiv_weak_smooth d K us u Ψ hus hU hΨs hΨc) (ε / 2) (half_pos hε)
  refine ⟨N, fun k hk => ?_⟩
  have h1 := hclose (us k) (hus k)
  have h2 : dist (∫ y, fderiv ℝ (us k) y (Ψ y)) (∫ y, fderiv ℝ u y (Ψ y)) < ε / 2 := hN k hk
  have h3 := hclose u hu
  rw [dist_comm] at h3
  linarith [dist_triangle4 (∫ y, fderiv ℝ (us k) y (Φ y)) (∫ y, fderiv ℝ (us k) y (Ψ y))
    (∫ y, fderiv ℝ u y (Ψ y)) (∫ y, fderiv ℝ u y (Φ y))]
/-- **Functions agreeing on a measurable set have equal derivatives a.e. on it.**  Assume that
density points see every direction (the statement of `Submission.dor_lmbsf_density_directions`).
If `Z ⊆ ℝᵈ` is measurable and `v₁ = v₂` on `Z`, then `Dv₁(y) = Dv₂(y)` at `Lᵈ`-a.e. `y ∈ Z` where
both are differentiable.  By the Besicovitch density theorem a.e. `y ∈ Z` is a density point of `Z`;
there each unit vector `e` is a limit of `(yᵢ - y)/|yᵢ - y|` with `yᵢ ∈ Z ∖ {y}`, `yᵢ → y`, and the
difference quotients of `v₁ - v₂` along `yᵢ` vanish, so `(Dv₁(y) - Dv₂(y)) e = 0`. -/
theorem Submission.dor_lmbsf_pwl_fderiv_eq_ae_of_eqOn : (∀ (d : ℕ) (Z : Set (Euclid d)) (y : Euclid d), Tendsto (fun r => volume (Z ∩ closedBall y r) / volume (closedBall y r)) (𝓝[>] 0) (𝓝 1) → ∀ v : Euclid d, ‖v‖ = 1 → ∃ ys : ℕ → Euclid d, (∀ i, ys i ∈ Z ∧ ys i ≠ y) ∧ Tendsto ys atTop (𝓝 y) ∧ Tendsto (fun i => ‖ys i - y‖⁻¹ • (ys i - y)) atTop (𝓝 v)) → ∀ (d : ℕ) (Z : Set (Euclid d)) (v₁ v₂ : Euclid d → ℝ), MeasurableSet Z → EqOn v₁ v₂ Z → ∀ᵐ y ∂(volume : Measure (Euclid d)), y ∈ Z → DifferentiableAt ℝ v₁ y → DifferentiableAt ℝ v₂ y → fderiv ℝ v₁ y = fderiv ℝ v₂ y := by
  intro hDD d Z v₁ v₂ hZ hEq
  -- a.e. point of `Z` is a Lebesgue density point of `Z`
  have h := Besicovitch.ae_tendsto_measure_inter_div (volume : Measure (Euclid d)) Z
  rw [ae_restrict_iff' hZ] at h
  filter_upwards [h] with y hy hyZ h1 h2
  have hden := hy hyZ
  set L := fderiv ℝ v₁ y - fderiv ℝ v₂ y with hLdef
  have hv : HasFDerivAt (fun x => v₁ x - v₂ x) L y := h1.hasFDerivAt.sub h2.hasFDerivAt
  -- along `yᵢ ∈ Z` with `(yᵢ - y)/|yᵢ - y| → e` the difference quotients of `v₁ - v₂` are `0`
  have hunit : ∀ e : Euclid d, ‖e‖ = 1 → L e = 0 := by
    intro e he
    obtain ⟨ys, hysZ, hys, hdir⟩ := hDD d Z y hden e he
    have hd0 : Tendsto (fun i => ys i - y) atTop (𝓝 0) := by
      simpa using hys.sub_const y
    have hlim := (hv.hasFDerivWithinAt (s := univ)).lim (l := atTop)
      (c := fun i => ‖ys i - y‖⁻¹) (d := fun i => ys i - y) hd0
      (Eventually.of_forall fun _ => mem_univ _) hdir
    have hzero : (fun i => ‖ys i - y‖⁻¹ • ((v₁ (y + (ys i - y)) - v₂ (y + (ys i - y))) -
        (v₁ y - v₂ y))) = fun _ => (0 : ℝ) := by
      funext i
      have hi : y + (ys i - y) = ys i := by abel
      rw [hi, hEq (hysZ i).1, hEq hyZ]
      simp
    rw [hzero] at hlim
    exact tendsto_nhds_unique hlim tendsto_const_nhds
  -- a linear map vanishing on unit vectors is `0`
  have hL : L = 0 := by
    ext e
    by_cases he : e = 0
    · simp [he]
    · have hn : ‖e‖ ≠ 0 := norm_ne_zero_iff.2 he
      have h1' : ‖‖e‖⁻¹ • e‖ = 1 := by
        rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hn]
      have := hunit _ h1'
      rw [map_smul, smul_eq_mul, mul_eq_zero] at this
      rcases this with h | h
      · exact absurd (inv_eq_zero.1 h) hn
      · simpa using h
  exact sub_eq_zero.1 hL

/-- **Chain rule for the cutoff `γ ∘ F`, a.e. on a Borel set.**  Let `a < b`,
`γ(s) = min{1, max{0, (b - s)/(b - a)}}`, `F : ℝᵈ → ℝ` differentiable and `u` Lipschitz with
`u = γ ∘ F` on a Borel set `Z`.  Assuming the density-directions lemma (DD), for a.e. `y ∈ Z`,
`Du(y) = γ'(F(y)) DF(y)`, where `γ' = -(b - a)⁻¹` on `(a, b)` and `γ' = 0` elsewhere.  By
Rademacher `u` is differentiable a.e.  On the kink levels `Z ∩ {F = a}` and `Z ∩ {F = b}`, `u` agrees
with the constants `γ(a) = 1` and `γ(b) = 0`; off them `γ ∘ F` is, near `y`, identically `1`,
`(b - F)/(b - a)` or `0`, hence differentiable with derivative `γ'(F(y)) DF(y)`.  In each case the
agreement lemma `dor_lmbsf_pwl_fderiv_eq_ae_of_eqOn` transfers the derivative to `u`. -/
theorem Submission.dor_lmbsf_pwl_fderiv_cutoff_comp_ae : (∀ (d : ℕ) (Z : Set (Euclid d)) (y : Euclid d), Tendsto (fun r => volume (Z ∩ closedBall y r) / volume (closedBall y r)) (𝓝[>] 0) (𝓝 1) → ∀ v : Euclid d, ‖v‖ = 1 → ∃ ys : ℕ → Euclid d, (∀ i, ys i ∈ Z ∧ ys i ≠ y) ∧ Tendsto ys atTop (𝓝 y) ∧ Tendsto (fun i => ‖ys i - y‖⁻¹ • (ys i - y)) atTop (𝓝 v)) → ∀ (d : ℕ) (Z : Set (Euclid d)) (F u : Euclid d → ℝ) (K : NNReal) (a b : ℝ), MeasurableSet Z → Differentiable ℝ F → LipschitzWith K u → a < b → (∀ y ∈ Z, u y = min 1 (max 0 ((b - F y) / (b - a)))) → ∀ᵐ y ∂(volume : Measure (Euclid d)), y ∈ Z → fderiv ℝ u y = (if a < F y ∧ F y < b then -(b - a)⁻¹ else 0) • fderiv ℝ F y := by
  intro hDD d Z F u K a b hZ hF hu hab hEq
  have hFc : Continuous F := hF.continuous
  have hba : 0 < b - a := sub_pos.2 hab
  set g : Euclid d → ℝ := fun y => min 1 (max 0 ((b - F y) / (b - a))) with hgdef
  -- the Borel pieces `Z ∩ {F ∉ {a, b}}`, `Z ∩ {F = a}`, `Z ∩ {F = b}`
  have hZ0 : MeasurableSet (Z ∩ {y | F y ≠ a ∧ F y ≠ b}) := by
    refine hZ.inter ?_
    have h1 : MeasurableSet {y | F y ≠ a} :=
      (measurableSet_singleton a).compl.preimage hFc.measurable
    have h2 : MeasurableSet {y | F y ≠ b} :=
      (measurableSet_singleton b).compl.preimage hFc.measurable
    exact h1.inter h2
  have hZa : MeasurableSet (Z ∩ F ⁻¹' {a}) :=
    hZ.inter ((measurableSet_singleton a).preimage hFc.measurable)
  have hZb : MeasurableSet (Z ∩ F ⁻¹' {b}) :=
    hZ.inter ((measurableSet_singleton b).preimage hFc.measurable)
  -- Rademacher: `u` is differentiable a.e.
  have hdiff : ∀ᵐ y ∂(volume : Measure (Euclid d)), DifferentiableAt ℝ u y :=
    hu.ae_differentiableAt
  -- `u = γ ∘ F` off the kinks, `u = γ(a) = 1` on `{F = a}` and `u = γ(b) = 0` on `{F = b}`
  have h0 := Submission.dor_lmbsf_pwl_fderiv_eq_ae_of_eqOn hDD d (Z ∩ {y | F y ≠ a ∧ F y ≠ b}) u g
    hZ0 (fun y hy => hEq y hy.1)
  have ha := Submission.dor_lmbsf_pwl_fderiv_eq_ae_of_eqOn hDD d (Z ∩ F ⁻¹' {a}) u (fun _ => 1)
    hZa (by
      intro y hy
      have hFy : F y = a := hy.2
      simp only [hEq y hy.1, hFy, div_self hba.ne']
      simp)
  have hb := Submission.dor_lmbsf_pwl_fderiv_eq_ae_of_eqOn hDD d (Z ∩ F ⁻¹' {b}) u (fun _ => 0)
    hZb (by
      intro y hy
      have hFy : F y = b := hy.2
      simp only [hEq y hy.1, hFy, sub_self, zero_div]
      simp)
  filter_upwards [hdiff, h0, ha, hb] with y hyd hy0 hya hyb hyZ
  -- kink levels: `Du(y) = 0 = γ'(F(y)) DF(y)`
  by_cases hFa : F y = a
  · have h := hya ⟨hyZ, hFa⟩ hyd (differentiableAt_const _)
    rw [h, fderiv_const_apply]
    simp [hFa]
  by_cases hFb : F y = b
  · have h := hyb ⟨hyZ, hFb⟩ hyd (differentiableAt_const _)
    rw [h, fderiv_const_apply]
    simp [hFb]
  -- off the kinks `g = γ ∘ F` is locally `1`, `(b - F)/(b - a)` or `0`
  have hgd : HasFDerivAt g ((if a < F y ∧ F y < b then -(b - a)⁻¹ else 0) • fderiv ℝ F y) y := by
    have hFd : HasFDerivAt F (fderiv ℝ F y) y := (hF y).hasFDerivAt
    rcases lt_or_gt_of_ne hFa with h | h
    · -- `F y < a`: `g = 1` near `y`
      have hev : g =ᶠ[𝓝 y] fun _ => (1 : ℝ) := by
        filter_upwards [hFc.continuousAt.eventually (gt_mem_nhds h)] with z hz
        have : 1 < (b - F z) / (b - a) := by
          rw [one_lt_div hba]; linarith
        simp only [hgdef]
        rw [max_eq_right (by linarith), min_eq_left this.le]
      have hn : ¬ (a < F y ∧ F y < b) := fun h' => absurd h'.1 (not_lt.2 h.le)
      simp only [hn, ite_false, zero_smul]
      exact (hasFDerivAt_const (1 : ℝ) y).congr_of_eventuallyEq hev
    · rcases lt_or_gt_of_ne hFb with h' | h'
      · -- `a < F y < b`: `g = (b - F)/(b - a)` near `y`
        have hev : g =ᶠ[𝓝 y] fun z => (b - F z) / (b - a) := by
          filter_upwards [hFc.continuousAt.eventually (lt_mem_nhds h),
            hFc.continuousAt.eventually (gt_mem_nhds h')] with z hz1 hz2
          have hpos : 0 < (b - F z) / (b - a) := div_pos (by linarith) hba
          have hlt : (b - F z) / (b - a) < 1 := by
            rw [div_lt_one hba]; linarith
          simp only [hgdef]
          rw [max_eq_right hpos.le, min_eq_right hlt.le]
        have hy' : a < F y ∧ F y < b := ⟨h, h'⟩
        simp only [hy', and_self, ite_true]
        have hlin : HasFDerivAt (fun z => (b - F z) / (b - a))
            (-(b - a)⁻¹ • fderiv ℝ F y) y := by
          have := ((hasFDerivAt_const b y).sub hFd).const_mul (b - a)⁻¹
          convert this using 1
          · funext z
            simp only [Pi.sub_apply]
            rw [div_eq_inv_mul]
          · rw [zero_sub, smul_neg, neg_smul]
        exact hlin.congr_of_eventuallyEq hev
      · -- `F y > b`: `g = 0` near `y`
        have hev : g =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
          filter_upwards [hFc.continuousAt.eventually (lt_mem_nhds h')] with z hz
          have : (b - F z) / (b - a) < 0 := div_neg_of_neg_of_pos (by linarith) hba
          simp only [hgdef]
          rw [max_eq_left this.le]
          simp
        have hn : ¬ (a < F y ∧ F y < b) := fun h'' => absurd h''.2 (not_lt.2 h'.le)
        simp only [hn, ite_false, zero_smul]
        exact (hasFDerivAt_const (0 : ℝ) y).congr_of_eventuallyEq hev
  have h := hy0 ⟨hyZ, hFa, hFb⟩ hyd hgd.differentiableAt
  rw [h, hgd.fderiv]
/-- **Cut-off localization of `hₖ ∘ ψ` near a compact subset of a `C¹` chart domain.**  Choose
`δ > 0` with `S = cthickening δ C ⊆ V` and a `C¹` Urysohn function `χ : ℝᵈ → [0, 1]` equal to `1`
on `cthickening (δ/2) C` and to `0` off `thickening δ C`, so `tsupport χ ⊆ S`.  Then
`uₖ = χ · (hₖ ∘ ψ)` and `u = χ · (h ∘ ψ)` agree with `hₖ ∘ ψ`, `h ∘ ψ` on `O = thickening (δ/2) C`.
On `S` the `hₖ ∘ ψ` are bounded by some `B` uniformly in `k` (`ψ(S)` is bounded, the `hₖ` are
`c`-Lipschitz and `hₖ(ψ(y₀))` converges), so the product and chain rules give
`‖Duₖ‖ ≤ B sup ‖Dχ‖ + c sup_S ‖Dψ‖`; `uₖ → u` uniformly because `0 ≤ χ ≤ 1`, and `u` is Lipschitz
as the pointwise limit of the `uₖ`.  For `C = ∅` all the functions are `0`. -/
theorem Submission.dor_lmbsf_pwl_chart_cutoff_localize : ∀ (P d : ℕ) (V C : Set (Euclid d)) (ψ : Euclid d → Euclid P) (hs : ℕ → Euclid P → ℝ) (h : Euclid P → ℝ) (c : ℝ), IsOpen V → ContDiffOn ℝ 1 ψ V → IsCompact C → C ⊆ V → (∀ k, ContDiff ℝ 1 (hs k)) → (∀ k x, ‖fderiv ℝ (hs k) x‖ ≤ c) → TendstoUniformly hs h atTop → ∃ (O : Set (Euclid d)) (K : NNReal) (us : ℕ → Euclid d → ℝ) (u : Euclid d → ℝ), IsOpen O ∧ C ⊆ O ∧ (∀ k, LipschitzWith K (us k)) ∧ LipschitzWith K u ∧ TendstoUniformly us u atTop ∧ (∀ k, ∀ y ∈ O, us k y = hs k (ψ y)) ∧ ∀ y ∈ O, u y = h (ψ y) := by
  intro P d V C ψ hs h c hV hψ hC hCV hhs hhsb hU
  rcases C.eq_empty_or_nonempty with hCe | ⟨y₀, hy₀⟩
  · refine ⟨∅, 0, fun _ _ => 0, fun _ => 0, isOpen_empty, by simp [hCe],
      fun _ => LipschitzWith.const 0, LipschitzWith.const 0, ?_, by simp, by simp⟩
    rw [Metric.tendstoUniformly_iff]
    intro ε hε
    exact Eventually.of_forall fun _ _ => by simpa using hε
  have hc : 0 ≤ c := (norm_nonneg _).trans (hhsb 0 0)
  -- the compact `S = cthickening δ C ⊆ V` and the cut-off `χ`, `1` near `C` and `0` off `S`
  obtain ⟨δ, hδ, hδV⟩ := hC.exists_cthickening_subset_open hV hCV
  have hδ2 : 0 < δ / 2 := by positivity
  set S := cthickening δ C
  have hS : IsCompact S := hC.cthickening
  have hst : Disjoint (thickening δ C)ᶜ (cthickening (δ / 2) C) := by
    rw [disjoint_compl_left_iff_subset]
    exact cthickening_subset_thickening' hδ (by linarith) C
  obtain ⟨χ, hχs, hχr, hχ0, hχ1⟩ := exists_contDiff_zero_iff_one_iff_of_isClosed (n := 1)
    isOpen_thickening.isClosed_compl isClosed_cthickening hst
  have hχ01 : ∀ y, 0 ≤ χ y ∧ χ y ≤ 1 := fun y => hχr ⟨y, rfl⟩
  have hsupp : tsupport χ ⊆ S := by
    apply closure_minimal _ isClosed_cthickening
    intro y hy
    by_contra hcon
    exact hy ((hχ0 y).1 (fun h' => hcon (thickening_subset_cthickening δ C h')))
  have hχc : HasCompactSupport χ := hS.of_isClosed_subset (isClosed_tsupport χ) hsupp
  -- bounds `Mχ` for `‖Dχ‖`, `Mψ` for `‖Dψ‖` on `S` and `B` for `|hₖ ∘ ψ|` on `S`, uniform in `k`
  obtain ⟨Mχ, hMχ⟩ := (hχc.fderiv (𝕜 := ℝ)).exists_bound_of_continuous
    (hχs.continuous_fderiv one_ne_zero)
  obtain ⟨Mψ, hMψ⟩ := hS.exists_bound_of_continuousOn
    ((hψ.continuousOn_fderiv_of_isOpen hV le_rfl).mono hδV)
  have hy₀S : y₀ ∈ S := self_subset_cthickening C hy₀
  have hMχ0 : 0 ≤ Mχ := (norm_nonneg _).trans (hMχ y₀)
  have hMψ0 : 0 ≤ Mψ := (norm_nonneg _).trans (hMψ y₀ hy₀S)
  have hhsL : ∀ k, LipschitzWith ⟨c, hc⟩ (hs k) := fun k =>
    lipschitzWith_of_nnnorm_fderiv_le ((hhs k).differentiable one_ne_zero) (fun x =>
      NNReal.coe_le_coe.mp (by rw [coe_nnnorm]; exact hhsb k x))
  have hψS : IsCompact (ψ '' S) := hS.image_of_continuousOn (hψ.continuousOn.mono hδV)
  obtain ⟨D, hD⟩ := hψS.isBounded.subset_closedBall (ψ y₀)
  obtain ⟨B₀, hB₀⟩ := ((hU.tendsto_at (ψ y₀)).abs).bddAbove_range
  set B := B₀ + c * D
  have hB : ∀ k, ∀ y ∈ S, |hs k (ψ y)| ≤ B := by
    intro k y hy
    have h1 : |hs k (ψ y) - hs k (ψ y₀)| ≤ c * dist (ψ y) (ψ y₀) := by
      have := (hhsL k).dist_le_mul (ψ y) (ψ y₀)
      rw [Real.dist_eq] at this
      exact this
    have h2 : dist (ψ y) (ψ y₀) ≤ D := hD (mem_image_of_mem ψ hy)
    have h3 : |hs k (ψ y₀)| ≤ B₀ := hB₀ ⟨k, rfl⟩
    have h4 := abs_sub_abs_le_abs_sub (hs k (ψ y)) (hs k (ψ y₀))
    have h5 : c * dist (ψ y) (ψ y₀) ≤ c * D := mul_le_mul_of_nonneg_left h2 hc
    linarith
  have hB0 : 0 ≤ B := (abs_nonneg _).trans (hB 0 y₀ hy₀S)
  set K : ℝ := B * Mχ + c * Mψ with hKdef
  have hK0 : 0 ≤ K := by positivity
  -- `uₖ = χ · (hₖ ∘ ψ)` has `‖Duₖ‖ ≤ K`: product and chain rules on `tsupport χ ⊆ S ⊆ V`, and
  -- `uₖ` vanishes near every point off `tsupport χ`
  set us : ℕ → Euclid d → ℝ := fun k y => χ y * hs k (ψ y) with husdef
  have hderiv : ∀ k y, DifferentiableAt ℝ (us k) y ∧ ‖fderiv ℝ (us k) y‖ ≤ K := by
    intro k y
    by_cases hy : y ∈ tsupport χ
    · have hyS : y ∈ S := hsupp hy
      have hyV : y ∈ V := hδV hyS
      have hψd : HasFDerivAt ψ (fderiv ℝ ψ y) y :=
        ((hψ.differentiableOn one_ne_zero y hyV).differentiableAt (hV.mem_nhds hyV)).hasFDerivAt
      have hhd : HasFDerivAt (hs k) (fderiv ℝ (hs k) (ψ y)) (ψ y) :=
        ((hhs k).differentiable one_ne_zero (ψ y)).hasFDerivAt
      have hχd : HasFDerivAt χ (fderiv ℝ χ y) y := (hχs.differentiable one_ne_zero y).hasFDerivAt
      have hprod : HasFDerivAt (us k) (χ y • (fderiv ℝ (hs k) (ψ y)).comp (fderiv ℝ ψ y) +
          (hs k ∘ ψ) y • fderiv ℝ χ y) y := hχd.mul (hhd.comp y hψd)
      refine ⟨hprod.differentiableAt, ?_⟩
      rw [hprod.fderiv]
      calc ‖χ y • (fderiv ℝ (hs k) (ψ y)).comp (fderiv ℝ ψ y) + (hs k ∘ ψ) y • fderiv ℝ χ y‖
          ≤ ‖χ y‖ * (‖fderiv ℝ (hs k) (ψ y)‖ * ‖fderiv ℝ ψ y‖) +
              ‖(hs k ∘ ψ) y‖ * ‖fderiv ℝ χ y‖ := by
            refine (norm_add_le _ _).trans ?_
            rw [norm_smul, norm_smul]
            gcongr
            exact ContinuousLinearMap.opNorm_comp_le _ _
        _ ≤ 1 * (c * Mψ) + B * Mχ := by
            gcongr
            · rw [Real.norm_eq_abs, abs_of_nonneg (hχ01 y).1]
              exact (hχ01 y).2
            · exact hhsb k (ψ y)
            · exact hMψ y hyS
            · rw [Real.norm_eq_abs]
              exact hB k y hyS
            · exact hMχ y
        _ = K := by rw [hKdef]; ring
    · have hev : us k =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
        have : (tsupport χ)ᶜ ∈ 𝓝 y := (isClosed_tsupport χ).isOpen_compl.mem_nhds hy
        filter_upwards [this] with z hz
        simp [us, image_eq_zero_of_notMem_tsupport hz]
      have h0 : HasFDerivAt (us k) (0 : Euclid d →L[ℝ] ℝ) y :=
        (hasFDerivAt_const (0 : ℝ) y).congr_of_eventuallyEq hev
      refine ⟨h0.differentiableAt, ?_⟩
      rw [h0.fderiv, norm_zero]
      exact hK0
  have husL : ∀ k, LipschitzWith ⟨K, hK0⟩ (us k) := fun k =>
    lipschitzWith_of_nnnorm_fderiv_le (fun y => (hderiv k y).1) (fun y =>
      NNReal.coe_le_coe.mp (by rw [coe_nnnorm]; exact (hderiv k y).2))
  -- `uₖ → u = χ · (h ∘ ψ)` uniformly since `0 ≤ χ ≤ 1`; the pointwise limit `u` is `K`-Lipschitz
  set u : Euclid d → ℝ := fun y => χ y * h (ψ y) with hudef
  have hUu : TendstoUniformly us u atTop := by
    rw [Metric.tendstoUniformly_iff] at hU ⊢
    intro ε hε
    filter_upwards [hU ε hε] with k hk
    intro y
    have h1 := hk (ψ y)
    rw [Real.dist_eq] at h1 ⊢
    calc |u y - us k y| = |χ y| * |h (ψ y) - hs k (ψ y)| := by
          rw [← abs_mul]
          congr 1
          simp only [hudef, husdef]
          ring
      _ ≤ 1 * |h (ψ y) - hs k (ψ y)| := by
          gcongr
          rw [abs_of_nonneg (hχ01 y).1]
          exact (hχ01 y).2
      _ < ε := by linarith
  have huL : LipschitzWith ⟨K, hK0⟩ u := by
    refine LipschitzWith.of_dist_le_mul fun x y => ?_
    exact le_of_tendsto ((hUu.tendsto_at x).dist (hUu.tendsto_at y))
      (Eventually.of_forall fun k => (husL k).dist_le_mul x y)
  -- `χ = 1` on `O = thickening (δ / 2) C`
  have hχO : ∀ y ∈ thickening (δ / 2) C, χ y = 1 := fun y hy =>
    (hχ1 y).1 (thickening_subset_cthickening _ _ hy)
  refine ⟨thickening (δ / 2) C, ⟨K, hK0⟩, us, u, isOpen_thickening,
    self_subset_thickening hδ2 C, husL, huL, hUu, ?_, ?_⟩
  · intro k y hy
    simp [husdef, hχO y hy]
  · intro y hy
    simp [hudef, hχO y hy]
/-- **Continuous left inverse of an immersion's derivative.**  If `ψ` is `C¹` on the open set
`V ⊆ ℝᵈ` and `A(y) = Dψ(y)` is injective for every `y ∈ V`, then `R(y) = Γ(y)⁻¹ A(y)*`, with
`Γ(y) = A(y)* A(y)` the Gram operator, is a left inverse of `A(y)` depending continuously on
`y ∈ V`.  `Γ` is continuous on `V`, and `Γ(y)` is injective since `⟨Γ(y)z, z⟩ = |A(y)z|²`, hence
a unit of `L(ℝᵈ, ℝᵈ)`; `Ring.inverse` is continuous at units. -/
theorem Submission.dor_lmbsf_pwl_immersion_left_inverse : ∀ (P d : ℕ) (V : Set (Euclid d)) (ψ : Euclid d → Euclid P), IsOpen V → ContDiffOn ℝ 1 ψ V → (∀ y ∈ V, Injective (fderiv ℝ ψ y)) → ∃ R : Euclid d → (Euclid P →L[ℝ] Euclid d), ContinuousOn R V ∧ ∀ y ∈ V, (R y).comp (fderiv ℝ ψ y) = ContinuousLinearMap.id ℝ (Euclid d) := by
  intro P d V ψ hV hψ hinj
  let A : Euclid d → (Euclid d →L[ℝ] Euclid P) := fun y => fderiv ℝ ψ y
  -- the Gram operator `Γ(y) = A(y)* A(y)`
  let Γ : Euclid d → (Euclid d →L[ℝ] Euclid d) :=
    fun y => (ContinuousLinearMap.adjoint (A y)).comp (A y)
  -- `Γ(y)` is injective (`⟨Γ(y)z, z⟩ = |A(y)z|²`), hence bijective and a unit
  have hunit : ∀ y ∈ V, IsUnit (Γ y) := by
    intro y hy
    rw [ContinuousLinearMap.isUnit_iff_bijective]
    have hinjΓ : Injective (Γ y) := by
      intro z₁ z₂ hz
      have h0 : Γ y (z₁ - z₂) = 0 := by rw [map_sub, hz, sub_self]
      have h1 : inner ℝ (A y (z₁ - z₂)) (A y (z₁ - z₂)) = 0 := by
        rw [← ContinuousLinearMap.adjoint_inner_left]
        change inner ℝ (Γ y (z₁ - z₂)) (z₁ - z₂) = 0
        rw [h0, inner_zero_left]
      have h2 : A y (z₁ - z₂) = 0 := by
        simpa using h1
      have h3 : z₁ - z₂ = 0 := by
        apply hinj y hy
        rw [h2, map_zero]
      exact sub_eq_zero.1 h3
    have hsurj : Surjective (Γ y : Euclid d →ₗ[ℝ] Euclid d) :=
      LinearMap.injective_iff_surjective.1 hinjΓ
    exact ⟨hinjΓ, hsurj⟩
  refine ⟨fun y => (Ring.inverse (Γ y)).comp (ContinuousLinearMap.adjoint (A y)), ?_, ?_⟩
  · have hA : ContinuousOn A V := hψ.continuousOn_fderiv_of_isOpen hV le_rfl
    have hAd : ContinuousOn (fun y => ContinuousLinearMap.adjoint (A y)) V :=
      ContinuousLinearMap.adjoint.continuous.comp_continuousOn hA
    have hΓ : ContinuousOn Γ V := hAd.clm_comp hA
    -- `Ring.inverse` is continuous at every unit
    have hinv : ContinuousOn (fun y => Ring.inverse (Γ y)) V := by
      intro y hy
      have := NormedRing.inverse_continuousAt (hunit y hy).unit
      rw [IsUnit.unit_spec] at this
      exact this.comp_continuousWithinAt (hΓ y hy)
    exact hinv.clm_comp hAd
  · intro y hy
    rw [ContinuousLinearMap.comp_assoc]
    exact Ring.inverse_mul_cancel _ (hunit y hy)

/-- **Chart transfer of a tangential pairing.**  Let `ψ` be an injective `C¹` immersion of an open
`V ⊆ ℝᵈ` into `ℝᴾ`, `Y ⊆ C ⊆ V` with `C` compact and `Y` Borel, `w ∈ L¹(Hᵈ⌞ψ(Y))`, and `W` a Borel
field with `|W| ≤ c'` that is `Hᵈ`-a.e. tangent to `ψ(Y)`.  Then one integrable `Φ`, vanishing off
`Y`, has `∫_{ψ(Y)} w β[W] dHᵈ = ∫ α[Φ] dLᵈ` whenever `β(ψ(y)) ∘ Dψ(y) = α(y)` on `Y`.  Near each
point of `C`, `ψ` is bi-Lipschitz, so the pull-back `ν(A) = Hᵈ(ψ(A ∩ Y))` of `Hᵈ⌞ψ(Y)` is a finite
measure mutually absolutely continuous with `Lᵈ⌞Y`.  With `J = dν/dLᵈ⌞Y` (the area Jacobian of
Simon Ch. 2, (3.5)), `∫_{ψ(Y)} g dHᵈ = ∫_Y J (g ∘ ψ) dLᵈ` for every `g`, and the tangency pulls
back to `Lᵈ`-a.e. `y ∈ Y`.  For a continuous left inverse `R` of `Dψ` on `V`, `E = R (W ∘ ψ)` is
bounded on `Y` by compactness of `C` and `Dψ E = W ∘ ψ` a.e. on `Y`, so `Φ = 1_Y J (w ∘ ψ) E`
works. -/
theorem Submission.dor_lmbsf_pwl_chart_pairing_transfer : ∀ (P d : ℕ) (V C Y : Set (Euclid d)) (ψ : Euclid d → Euclid P) (w : Euclid P → ℝ) (W : Euclid P → Euclid P) (c' : ℝ), IsOpen V → ContDiffOn ℝ 1 ψ V → InjOn ψ V → (∀ y ∈ V, Injective (fderiv ℝ ψ y)) → IsCompact C → C ⊆ V → MeasurableSet Y → Y ⊆ C → IntegrableOn w (ψ '' Y) μHE[d] → Measurable W → (∀ x, ‖W x‖ ≤ c') → (∀ᵐ x ∂(μHE[d].restrict (ψ '' Y)), ∀ y ∈ Y, ψ y = x → W x ∈ LinearMap.range (fderiv ℝ ψ y : Euclid d →ₗ[ℝ] Euclid P)) → ∃ Φ : Euclid d → Euclid d, Integrable Φ ∧ (∀ y, y ∉ Y → Φ y = 0) ∧ ∀ (β : Euclid P → (Euclid P →L[ℝ] ℝ)) (α : Euclid d → (Euclid d →L[ℝ] ℝ)), (∀ y ∈ Y, (β (ψ y)).comp (fderiv ℝ ψ y) = α y) → ∫ x in ψ '' Y, w x * β x (W x) ∂μHE[d] = ∫ y, α y (Φ y) := by
  intro P d V C Y ψ w W c' hV hψ hψinj hDψ hC hCV hY hYC hw hWm hWb hWt
  have hYV : Y ⊆ V := hYC.trans hCV
  have hvol : (μHE[d] : Measure (Euclid d)) = volume :=
    EuclideanSpace.euclideanHausdorffMeasure_eq_volume d
  -- `ψ` is locally bi-Lipschitz on `V`
  have hloc : ∀ y ∈ V, ∃ U ∈ 𝓝 y, ∃ L K : NNReal, LipschitzOnWith L ψ U ∧
      ∀ a ∈ U, ∀ b ∈ U, dist a b ≤ K * dist (ψ a) (ψ b) := by
    intro y hy
    -- near `y`, `ψ` approximates `A = Dψ(y)` up to `(2K)⁻¹`, `K` an antilipschitz constant of `A`
    have hs : HasStrictFDerivAt ψ (fderiv ℝ ψ y) y :=
      (hψ.contDiffAt (hV.mem_nhds hy)).hasStrictFDerivAt one_ne_zero
    obtain ⟨K, hKpos, hK⟩ := LinearMap.exists_antilipschitzWith
      (fderiv ℝ ψ y : Euclid d →ₗ[ℝ] Euclid P) (LinearMap.ker_eq_bot.mpr (hDψ y hy))
    obtain ⟨U, hU, hUA⟩ := hs.approximates_deriv_on_nhds (c := (2 * K)⁻¹)
      (Or.inr (by positivity))
    refine ⟨U, hU, ‖fderiv ℝ ψ y‖₊ + (2 * K)⁻¹, 2 * K,
      lipschitzOnWith_iff_restrict.mpr hUA.lipschitzWith, fun a ha b hb => ?_⟩
    have h1 : dist a b ≤ K * dist (fderiv ℝ ψ y a) (fderiv ℝ ψ y b) := hK.le_mul_dist a b
    have h2 : ‖ψ a - ψ b - fderiv ℝ ψ y (a - b)‖ ≤ ((2 * K)⁻¹ : NNReal) * ‖a - b‖ :=
      hUA a ha b hb
    rw [dist_eq_norm, dist_eq_norm, ← map_sub] at h1
    have h3 : ‖fderiv ℝ ψ y (a - b)‖ ≤ ‖ψ a - ψ b‖ + ‖ψ a - ψ b - fderiv ℝ ψ y (a - b)‖ := by
      have := norm_sub_le (ψ a - ψ b) (ψ a - ψ b - fderiv ℝ ψ y (a - b))
      rwa [sub_sub_cancel] at this
    have hK0 : (0 : ℝ) < K := hKpos
    have h4 : (K : ℝ) * ‖fderiv ℝ ψ y (a - b)‖ ≤ K * ‖ψ a - ψ b‖ + ‖a - b‖ / 2 := by
      have h5 := mul_le_mul_of_nonneg_left (h3.trans (add_le_add le_rfl h2)) hK0.le
      calc (K : ℝ) * ‖fderiv ℝ ψ y (a - b)‖
          ≤ K * (‖ψ a - ψ b‖ + ((2 * K)⁻¹ : NNReal) * ‖a - b‖) := h5
        _ = K * ‖ψ a - ψ b‖ + ‖a - b‖ / 2 := by
          push_cast
          field_simp
    rw [dist_eq_norm, dist_eq_norm]
    push_cast
    linarith
  -- finitely many of these neighbourhoods, cut down to unit balls, cover `C ⊇ Y`
  choose! U hUn L K hL hK using hloc
  obtain ⟨t, htC, hCt⟩ := hC.elim_nhds_subcover (fun y => U y ∩ ball y 1)
    (fun y hy => inter_mem (hUn y (hCV hy)) (ball_mem_nhds y one_pos))
  have hcov : ∀ A ⊆ Y, A ⊆ ⋃ x ∈ t, A ∩ (U x ∩ ball x 1) := by
    intro A hA a ha
    obtain ⟨x, hx, hax⟩ := mem_iUnion₂.1 (hCt (hYC (hA ha)))
    exact mem_iUnion₂.2 ⟨x, hx, ha, hax⟩
  -- Hausdorff measure estimates on the pieces `U x ∩ B₁(x)`
  have hup : ∀ x ∈ t, ∀ B ⊆ U x ∩ ball x 1,
      μHE[d] (ψ '' B) ≤ (L x : ℝ≥0∞) ^ d * volume B := by
    intro x hx B hB
    rw [← hvol]
    exact Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn d
      ((hL x (hCV (htC x hx))).mono (hB.trans inter_subset_left))
  have hlow : ∀ x ∈ t, ∀ B ⊆ U x ∩ ball x 1,
      volume B ≤ (K x : ℝ≥0∞) ^ d * μHE[d] (ψ '' B) := by
    intro x hx B hB
    have hxV := hCV (htC x hx)
    have hinj : InjOn ψ (U x) := fun a ha b hb hab => by
      have := hK x hxV a ha b hb
      rw [hab, dist_self, mul_zero] at this
      exact dist_le_zero.1 this
    have hg : LipschitzOnWith (K x) (invFunOn ψ (U x)) (ψ '' (U x)) := by
      refine LipschitzOnWith.of_dist_le_mul fun p hp q hq => ?_
      obtain ⟨a, ha, rfl⟩ := hp
      obtain ⟨b, hb, rfl⟩ := hq
      rw [hinj.leftInvOn_invFunOn ha, hinj.leftInvOn_invFunOn hb]
      exact hK x hxV a ha b hb
    have := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn d
      (hg.mono (image_mono (hB.trans inter_subset_left)))
    rwa [hinj.invFunOn_image (hB.trans inter_subset_left), hvol] at this
  -- the pull-back `ν(A) = Hᵈ(ψ(A ∩ Y))` of `Hᵈ⌞ψ(Y)` to `Y`
  have hcont : ContinuousOn ψ Y := hψ.continuousOn.mono hYV
  have he := hcont.measurableEmbedding hY (hψinj.mono hYV)
  set νY : Measure Y := Measure.comap (Y.domRestrict ψ) μHE[d] with hνYdef
  set ν : Measure (Euclid d) := Measure.map Subtype.val νY with hνdef
  have hνapply : ∀ A, ν A = μHE[d] (ψ '' (A ∩ Y)) := by
    intro A
    rw [hνdef, (MeasurableEmbedding.subtype_coe hY).map_apply, hνYdef, he.comap_apply]
    congr 1
    ext p
    constructor
    · rintro ⟨⟨a, ha⟩, haA, rfl⟩
      exact ⟨a, ⟨haA, ha⟩, rfl⟩
    · rintro ⟨a, ⟨haA, ha⟩, rfl⟩
      exact ⟨⟨a, ha⟩, haA, rfl⟩
  -- `ν` and `Lᵈ⌞Y` are mutually absolutely continuous, and `ν` is finite
  have hνac : ν ≪ volume.restrict Y := by
    refine Measure.AbsolutelyContinuous.mk fun A hA hA0 => ?_
    rw [Measure.restrict_apply hA] at hA0
    rw [hνapply]
    refine measure_mono_null (image_mono (hcov _ inter_subset_right)) ?_
    rw [image_iUnion₂]
    refine (measure_biUnion_null_iff t.countable_toSet).2 fun x hx => ?_
    exact le_zero_iff.1 ((hup x hx _ inter_subset_right).trans
      (by rw [measure_mono_null inter_subset_left hA0, mul_zero]))
  have hYν : volume.restrict Y ≪ ν := by
    refine Measure.AbsolutelyContinuous.mk fun A hA hA0 => ?_
    rw [hνapply] at hA0
    rw [Measure.restrict_apply hA]
    refine measure_mono_null (hcov _ inter_subset_right) ?_
    refine (measure_biUnion_null_iff t.countable_toSet).2 fun x hx => ?_
    exact le_zero_iff.1 ((hlow x hx _ inter_subset_right).trans
      (by rw [measure_mono_null (image_mono inter_subset_left) hA0, mul_zero]))
  have hfin : μHE[d] (ψ '' Y) < ∞ := by
    calc μHE[d] (ψ '' Y) ≤ μHE[d] (⋃ x ∈ t, ψ '' (Y ∩ (U x ∩ ball x 1))) := by
          rw [← image_iUnion₂]
          exact measure_mono (image_mono (hcov Y subset_rfl))
      _ ≤ ∑ x ∈ t, μHE[d] (ψ '' (Y ∩ (U x ∩ ball x 1))) := measure_biUnion_finset_le _ _
      _ < ∞ := by
          refine ENNReal.sum_lt_top.2 fun x hx => ?_
          refine (hup x hx _ inter_subset_right).trans_lt
            (ENNReal.mul_lt_top (ENNReal.pow_lt_top ENNReal.coe_lt_top) ?_)
          exact (measure_mono (inter_subset_right.trans inter_subset_right)).trans_lt
            measure_ball_lt_top
  have : IsFiniteMeasure ν := ⟨by rw [hνapply, univ_inter]; exact hfin⟩
  -- the density `J = dν/dLᵈ⌞Y`
  set J : Euclid d → ℝ≥0∞ := ν.rnDeriv (volume.restrict Y)
  have hνJ : ν = (volume.restrict Y).withDensity J := by
    have h := Measure.haveLebesgueDecomposition_add ν (volume.restrict Y)
    rwa [Measure.singularPart_eq_zero_of_ac hνac, zero_add] at h
  have hJm : Measurable J := Measure.measurable_rnDeriv _ _
  have hJfin : ∀ᵐ y ∂(volume.restrict Y), J y < ∞ := Measure.rnDeriv_lt_top _ _
  -- `ψ` restricted to `Y` is a measurable embedding carrying `ν` to `Hᵈ⌞ψ(Y)`
  have hmapY : Measure.map (Y.domRestrict ψ) νY = μHE[d].restrict (ψ '' Y) := by
    rw [hνYdef, he.map_comap, range_domRestrict]
  -- the area formula `∫_{ψ(Y)} g dHᵈ = ∫_Y J (g ∘ ψ) dLᵈ`, for arbitrary `g`
  have harea : ∀ g : Euclid P → ℝ,
      ∫ x in ψ '' Y, g x ∂μHE[d] = ∫ y in Y, (J y).toReal * g (ψ y) := by
    intro g
    calc ∫ x in ψ '' Y, g x ∂μHE[d] = ∫ x, g x ∂(Measure.map (Y.domRestrict ψ) νY) := by
          rw [hmapY]
      _ = ∫ y : Y, g (ψ y) ∂νY := he.integral_map g
      _ = ∫ y, g (ψ y) ∂ν :=
          ((MeasurableEmbedding.subtype_coe hY).integral_map (fun y => g (ψ y))).symm
      _ = ∫ y, g (ψ y) ∂((volume.restrict Y).withDensity J) := by rw [← hνJ]
      _ = ∫ y in Y, (J y).toReal * g (ψ y) :=
          integral_withDensity_eq_integral_toReal_smul hJm hJfin _
  -- `J (w ∘ ψ)` is integrable on `Y`
  have hJw : IntegrableOn (fun y => (J y).toReal * w (ψ y)) Y := by
    have h1 : Integrable w (Measure.map (Y.domRestrict ψ) νY) := by rw [hmapY]; exact hw
    have h2 : Integrable (fun y => w (ψ y)) ν :=
      (MeasurableEmbedding.subtype_coe hY).integrable_map_iff.2 (he.integrable_map_iff.1 h1)
    rw [hνJ] at h2
    exact (integrable_withDensity_iff_integrable_smul' hJm hJfin).1 h2
  -- the tangency of `W` pulls back to `Lᵈ`-a.e. `y ∈ Y`
  have htan : ∀ᵐ y ∂(volume.restrict Y),
      W (ψ y) ∈ LinearMap.range (fderiv ℝ ψ y : Euclid d →ₗ[ℝ] Euclid P) := by
    have h1 : ∀ᵐ x ∂(Measure.map (Y.domRestrict ψ) νY), ∀ y ∈ Y, ψ y = x →
        W x ∈ LinearMap.range (fderiv ℝ ψ y : Euclid d →ₗ[ℝ] Euclid P) := by
      rw [hmapY]; exact hWt
    have h2 := he.ae_map_iff.1 h1
    have h3 : ∀ᵐ y ∂ν, y ∈ Y →
        W (ψ y) ∈ LinearMap.range (fderiv ℝ ψ y : Euclid d →ₗ[ℝ] Euclid P) := by
      rw [hνdef, (MeasurableEmbedding.subtype_coe hY).ae_map_iff]
      filter_upwards [h2] with y hy _
      exact hy y y.2 rfl
    filter_upwards [hYν.ae_le h3, ae_restrict_mem hY] with y hy hyY
    exact hy hyY
  -- a continuous left inverse `R` of `Dψ` on `V`, with `‖R‖ ≤ M` on the compact `C`
  obtain ⟨R, hRc, hRinv⟩ := Submission.dor_lmbsf_pwl_immersion_left_inverse P d V ψ hV hψ hDψ
  obtain ⟨M, hM⟩ := hC.exists_bound_of_continuousOn (hRc.mono hCV)
  -- the chart field `E = R (W ∘ ψ)`: a.e.-strongly measurable on `Y`, with `|E| ≤ M c'` there
  set E : Euclid d → Euclid d := fun y => R y (W (ψ y)) with hEdef
  have hEm : AEStronglyMeasurable E (volume.restrict Y) := by
    have hR : AEStronglyMeasurable R (volume.restrict Y) :=
      (hRc.mono hYV).aestronglyMeasurable hY
    have hWψ : AEStronglyMeasurable (fun y => W (ψ y)) (volume.restrict Y) :=
      (hWm.comp_aemeasurable (hcont.aemeasurable hY)).aestronglyMeasurable
    exact (isBoundedBilinearMap_apply (𝕜 := ℝ) (E := Euclid P) (F := Euclid d)).continuous
      |>.comp_aestronglyMeasurable (hR.prodMk hWψ)
  have hEb : ∀ᵐ y ∂(volume.restrict Y), ‖E y‖ ≤ M * c' := by
    filter_upwards [ae_restrict_mem hY] with y hy
    have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM y (hYC hy))
    exact (ContinuousLinearMap.le_opNorm _ _).trans
      (mul_le_mul (hM y (hYC hy)) (hWb _) (norm_nonneg _) hM0)
  -- `Φ = 1_Y J (w ∘ ψ) E`
  set Φ : Euclid d → Euclid d := Y.indicator (fun y => ((J y).toReal * w (ψ y)) • E y)
    with hΦdef
  have hΦi : Integrable Φ := by
    rw [hΦdef, integrable_indicator_iff hY]
    exact hJw.smul_bdd (M * c') hEm hEb
  refine ⟨Φ, hΦi, fun y hy => by simp [hΦdef, indicator_of_notMem hy], ?_⟩
  intro β α hβα
  rw [harea]
  have hcompl : ∀ y, y ∉ Y → α y (Φ y) = 0 := fun y hy => by
    simp [hΦdef, indicator_of_notMem hy]
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero (μ := volume)
    (f := fun y => α y (Φ y)) hcompl]
  refine setIntegral_congr_ae hY ?_
  -- for a.e. `y ∈ Y`, `W(ψ(y)) = Dψ(y) z` gives `E(y) = R(y) Dψ(y) z = z`, so
  -- `J w(ψ(y)) β(ψ(y))[W(ψ(y))] = J w(ψ(y)) β(ψ(y))[Dψ(y) E(y)] = α(y)[Φ(y)]`
  filter_upwards [ae_restrict_iff' hY |>.1 htan] with y hyt hyY
  obtain ⟨z, hz⟩ := hyt hyY
  have hz' : fderiv ℝ ψ y z = W (ψ y) := hz
  have hEz : E y = z := by
    have := congrArg (fun T : Euclid d →L[ℝ] Euclid d => T z) (hRinv y (hYV hyY))
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.id_apply] at this
    rw [hEdef]
    simp only
    rw [← hz', this]
  have hE : fderiv ℝ ψ y (E y) = W (ψ y) := by rw [hEz, hz']
  rw [hΦdef, indicator_of_mem hyY, map_smul, ← hβα y hyY, ContinuousLinearMap.comp_apply, hE,
    smul_eq_mul]
  ring

/-- **Weak limit of the cut-off gradients on one chart piece.**  Let
`γ(s) = min 1 (max 0 ((b - s) / (b - a)))`, with `γ'(s) = -(b - a)⁻¹` for `a < s < b` and
`γ'(s) = 0` otherwise.  Localize `h_k ∘ ψ` and `γ ∘ f ∘ ψ` near `C` to uniformly Lipschitz
`u_k → u` on `ℝⁿ⁺¹`, and use the area formula to write the pairings over `ψ(Y)` as `∫ α[Φ]`, for
one integrable chart field `Φ` vanishing off `Y`.  By the chain rule `Dh_k(ψ y) ∘ Dψ(y) = Du_k(y)`
on `Y`, so the left side is `∫ Du_k[Φ]`.  Since `⟨G(ψ y), Dψ(y)·⟩ = DF(y)` and `f ∘ ψ = F` on
`Y`, the right side is `∫ γ'(F) DF[Φ]`.  This is `∫ Du[Φ]`, as `Du = γ'(F) DF` a.e. on `Y` and
`Φ = 0` off `Y`.  Finally `∫ Du_k[Φ] → ∫ Du[Φ]` by weak-* convergence of the derivatives. -/
theorem Submission.dor_lmbsf_piece_weak_limit : ∀ (P n : ℕ) (V C Y : Set (Euclid (n + 1))) (ψ : Euclid (n + 1) → Euclid P) (F : Euclid (n + 1) → ℝ) (f : Euclid P → ℝ) (G : Euclid P → Euclid P) (L : NNReal) (a b c c' : ℝ) (hs : ℕ → Euclid P → ℝ) (w : Euclid P → ℝ) (W : Euclid P → Euclid P), IsOpen V → ContDiffOn ℝ 1 ψ V → InjOn ψ V → (∀ y ∈ V, Injective (fderiv ℝ ψ y)) → IsCompact C → C ⊆ V → MeasurableSet Y → Y ⊆ C → ContDiff ℝ 1 F → (∀ y ∈ Y, f (ψ y) = F y) → (∀ y ∈ Y, G (ψ y) ∈ LinearMap.range (fderiv ℝ ψ y : Euclid (n + 1) →ₗ[ℝ] Euclid P) ∧ ∀ e : Euclid (n + 1), inner ℝ (G (ψ y)) (fderiv ℝ ψ y e) = fderiv ℝ F y e) → Measurable G → LipschitzWith L f → a < b → (∀ k, ContDiff ℝ 1 (hs k)) → (∀ k x, ‖fderiv ℝ (hs k) x‖ ≤ c) → TendstoUniformly hs (fun x => min 1 (max 0 ((b - f x) / (b - a)))) atTop → IntegrableOn w (ψ '' Y) μHE[n + 1] → Measurable W → (∀ x, ‖W x‖ ≤ c') → (∀ᵐ x ∂(μHE[n + 1].restrict (ψ '' Y)), ∀ y ∈ Y, ψ y = x → W x ∈ LinearMap.range (fderiv ℝ ψ y : Euclid (n + 1) →ₗ[ℝ] Euclid P)) → Tendsto (fun k => ∫ x in ψ '' Y, w x * fderiv ℝ (hs k) x (W x) ∂μHE[n + 1]) atTop (𝓝 (∫ x in ψ '' Y ∩ {x | a < f x ∧ f x < b}, w x * (-(b - a)⁻¹ * inner ℝ (G x) (W x)) ∂μHE[n + 1])) := by
  intro P n V C Y ψ F f G L a b c c' hs w W hV hψ hψi hDψ hC hCV hY hYC hF hfF hGF _ hf hab hhs
    hhs' hU hw hW hW' hWt
  -- globally `K`-Lipschitz `u_k → u` with `u_k = h_k ∘ ψ` and `u = γ ∘ f ∘ ψ` on an open `O ⊇ C`
  obtain ⟨O, K, us, u, hO, hCO, hus, hu, hUu, husO, huO⟩ :=
    Submission.dor_lmbsf_pwl_chart_cutoff_localize P (n + 1) V C ψ hs
      (fun x => min 1 (max 0 ((b - f x) / (b - a)))) c hV hψ hC hCV hhs hhs' hU
  -- one integrable chart field `Φ`, vanishing off `Y`, with `∫_{ψ(Y)} w β[W] = ∫ α[Φ]` whenever
  -- `β(ψ y) ∘ Dψ(y) = α(y)` on `Y`
  obtain ⟨Φ, hΦ, hΦY, hΦpair⟩ :=
    Submission.dor_lmbsf_pwl_chart_pairing_transfer P (n + 1) V C Y ψ w W c' hV hψ hψi hDψ hC
      hCV hY hYC hw hW hW' hWt
  -- left side: `u_k = h_k ∘ ψ` near `y ∈ Y`, so `Dh_k(ψ y) ∘ Dψ(y) = Du_k(y)`
  have hlhs : ∀ k, ∫ x in ψ '' Y, w x * fderiv ℝ (hs k) x (W x) ∂μHE[n + 1]
      = ∫ y, fderiv ℝ (us k) y (Φ y) := by
    intro k
    refine hΦpair (fderiv ℝ (hs k)) (fderiv ℝ (us k)) fun y hy => ?_
    have hloc : us k =ᶠ[𝓝 y] hs k ∘ ψ :=
      eventually_of_mem (hO.mem_nhds (hCO (hYC hy))) fun z hz => husO k z hz
    have hψy : DifferentiableAt ℝ ψ y :=
      (hψ.contDiffAt (hV.mem_nhds (hCV (hYC hy)))).differentiableAt one_ne_zero
    rw [hloc.fderiv_eq, fderiv_comp y ((hhs k).differentiable one_ne_zero (ψ y)) hψy]
  -- right side: `γ'(f) ⟨G, ·⟩` pulls back along `ψ` to `γ'(F) DF` on `Y`
  have hS : MeasurableSet {x : Euclid P | a < f x ∧ f x < b} :=
    hf.continuous.measurable (measurableSet_Ioo (a := a) (b := b))
  have hrhs : ∫ x in ψ '' Y ∩ {x | a < f x ∧ f x < b},
        w x * (-(b - a)⁻¹ * inner ℝ (G x) (W x)) ∂μHE[n + 1]
      = ∫ y, ((if a < F y ∧ F y < b then -(b - a)⁻¹ else 0) • fderiv ℝ F y) (Φ y) := by
    rw [← setIntegral_indicator hS]
    refine (integral_congr_ae (ae_of_all _ fun x => ?_)).trans
      (hΦpair (fun x => (if a < f x ∧ f x < b then -(b - a)⁻¹ else 0) • innerSL ℝ (G x))
        (fun y => (if a < F y ∧ F y < b then -(b - a)⁻¹ else 0) • fderiv ℝ F y) fun y hy => ?_)
    · by_cases hx : a < f x ∧ f x < b
      · simp [hx, innerSL_apply_apply]
      · simp [hx]
    · have hpull : (innerSL ℝ (G (ψ y))).comp (fderiv ℝ ψ y) = fderiv ℝ F y :=
        ContinuousLinearMap.ext fun e => (hGF y hy).2 e
      simp only [ContinuousLinearMap.smul_comp, hfF y hy, hpull]
  -- `Du = γ'(F) DF` a.e. on `Y` and `Φ = 0` off `Y`
  have hcut := Submission.dor_lmbsf_pwl_fderiv_cutoff_comp_ae
    Submission.dor_lmbsf_density_directions (n + 1) Y F u K a b hY
    (hF.differentiable one_ne_zero) hu hab fun y hy => by
      simpa only [hfF y hy] using huO y (hCO (hYC hy))
  have hlim : ∫ y, ((if a < F y ∧ F y < b then -(b - a)⁻¹ else 0) • fderiv ℝ F y) (Φ y)
      = ∫ y, fderiv ℝ u y (Φ y) := by
    refine integral_congr_ae ?_
    filter_upwards [hcut] with y hy
    by_cases hyY : y ∈ Y
    · rw [hy hyY]
    · rw [hΦY y hyY, map_zero, map_zero]
  -- weak-* convergence `∫ Du_k[Φ] → ∫ Du[Φ]`
  rw [hrhs, hlim]
  exact (Submission.dor_lmbsf_pwl_fderiv_weak_integrable (n + 1) K us u Φ hus hUu hΦ).congr
    fun k => (hlhs k).symm

/-- **Tangential gradient of a Lipschitz function on an integer multiplicity triple** (Simon
Ch. 3, Remark 1.3, Remark 1.5(1), 2.1 and 2.8–2.10(2); Ch. 6, 4.1 and the reduction to one piece
in the proof of 4.5(2)).  `chart_pieces` decomposes `M = RT.carrier` up to an `H^{n+1}`-null set
into disjoint Borel chart pieces `P_j = ψ_j(Y_j)` and gives the Borel field `g` with `|g| ≤ L`,
`g = 0` off `⋃_j P_j` and `g(ψ_j y) ∈ range Dψ_j(y) = T_{ψ_j y}M` (uniqueness of approximate
tangent planes, Ch. 3, 1.5(1)), so (G1), (G2).  The piece results `piece_coarea`,
`piece_slice_tangent` and `piece_weak_limit` hold on every `P_j`, and the three gluing lemmas sum
them over `j`: (G3) by `coarea_gluing`; (G4a) since `M_t ⊆ ⋃_j (P_j)_t`, a countable union of
countably `n`-rectifiable sets; (G4b) by `tangent_gluing`, each piece slice having finite `Hⁿ`
measure as a subset of `M_t ∩ ψ_j(C_j)`, `ψ_j(C_j)` compact in `U`; (G5) by `weak_limit_gluing`
with weight `θ` and dominating function `c c' θ 1_K` (integrable since `θ` is locally
integrable). -/
theorem Submission.dor_lmbsf_tangential_gradient : (∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q) → ∀ (P n : ℕ) (U : Set (Euclid P)) (RT : IMRep U (n + 1)) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → LipschitzWith L f → ∃ g : Euclid P → Euclid P, Measurable g ∧ (∀ x, ‖g x‖ ≤ L) ∧ (∀ᵐ x ∂(μHE[n + 1].restrict RT.carrier), g x ∈ approxTangentPlane (n + 1) RT.carrier x) ∧ (∀ φ : Euclid P → ℝ≥0∞, Measurable φ → AEMeasurable (fun t => ∫⁻ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}, φ x ∂μHE[n]) ∧ ∫⁻ t, (∫⁻ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}, φ x ∂μHE[n]) = ∫⁻ x in RT.carrier, ‖g x‖ₑ * φ x ∂μHE[n + 1]) ∧ (∀ t, CountablyRectifiable n (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t})) ∧ (∀ t, (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t})), HasApproximateTangentSpaceAt n (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}) x (approxTangentPlane (n + 1) RT.carrier x ⊓ (ℝ ∙ g x)ᗮ)) ∧ (∀ (a b : ℝ), a < b → ∀ (hs : ℕ → Euclid P → ℝ) (c : ℝ), (∀ k, ContDiff ℝ 1 (hs k)) → (∀ k x, ‖fderiv ℝ (hs k) x‖ ≤ c) → TendstoUniformly hs (fun x => min 1 (max 0 ((b - f x) / (b - a)))) atTop → ∀ (W : Euclid P → Euclid P) (K : Set (Euclid P)) (c' : ℝ), Measurable W → IsCompact K → K ⊆ U → (∀ x, x ∉ K → W x = 0) → (∀ x, ‖W x‖ ≤ c') → (∀ᵐ x ∂(μHE[n + 1].restrict RT.carrier), W x ∈ approxTangentPlane (n + 1) RT.carrier x) → Tendsto (fun k => ∫ x in RT.carrier, (RT.mult x : ℝ) * fderiv ℝ (hs k) x (W x) ∂μHE[n + 1]) atTop (𝓝 (∫ x in RT.carrier ∩ {x | a < f x ∧ f x < b}, (RT.mult x : ℝ) * (-(b - a)⁻¹ * inner ℝ (g x) (W x)) ∂μHE[n + 1]))) := by
  intro hTL P n U RT f L hU hf
  have hMm : MeasurableSet RT.carrier := RT.measurableSet_carrier
  have hfm : Measurable f := hf.continuous.measurable
  have hθm : Measurable fun x => (RT.mult x : ℝ) := measurable_from_nat.comp RT.measurable_mult
  -- Step 0(b): `θ ≥ 1` on `M` is locally integrable, so `M` is locally `H^{n+1}`-finite
  have hθint : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
      IntegrableOn (fun x => (RT.mult x : ℝ)) (RT.carrier ∩ K) μHE[n + 1] := by
    intro K hK hKU
    have h := integrable_toReal_of_lintegral_ne_top
      (μ := μHE[n + 1].restrict (RT.carrier ∩ K)) (f := fun x => (RT.mult x : ℝ≥0∞))
      (measurable_from_nat.comp RT.measurable_mult).aemeasurable
      (RT.locallyIntegrable_mult K hK hKU)
    simp only [ENNReal.toReal_natCast] at h
    exact h
  have hMfin : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
      μHE[n + 1] (RT.carrier ∩ K) ≠ ∞ := by
    intro K hK hKU
    refine ne_top_of_le_ne_top (RT.locallyIntegrable_mult K hK hKU) ?_
    rw [← setLIntegral_one]
    exact setLIntegral_mono' (hMm.inter hK.measurableSet) fun x hx =>
      Nat.one_le_cast.mpr (RT.mult_pos x hx.1)
  -- Step 0(c): `T_xM` is the approximate tangent space of `M` at `x` whenever one exists
  have hTM : ∀ x (Q : Submodule ℝ (Euclid P)),
      HasApproximateTangentSpaceAt (n + 1) RT.carrier x Q →
        approxTangentPlane (n + 1) RT.carrier x = Q := by
    intro x Q hQ
    have hex : ∃ Q, HasApproximateTangentSpaceAt (n + 1) RT.carrier x Q := ⟨Q, hQ⟩
    rw [approxTangentPlane, dite_eq_left hex]
    exact hex.choose_spec.unique hQ
  -- Step 1: the chart pieces `P_j = ψ_j(Y_j)` and the field `g`
  obtain ⟨V, C, Y, ψ, F, g, hV, hCY, hYM, hdisj, hnull, hfT, hgm, hgL, hg0, hgT⟩ :=
    Submission.dor_lmbsf_lipschitz_chart_pieces hTL P n U RT.carrier f L hU hMm RT.carrier_subset
      RT.rectifiable hMfin hf
  have hTψ : ∀ j, ∀ y ∈ Y j, approxTangentPlane (n + 1) RT.carrier (ψ j y) =
      LinearMap.range (fderiv ℝ (ψ j) y : Euclid (n + 1) →ₗ[ℝ] Euclid P) := fun j y hy =>
    hTM _ _ (hfT j y hy).2
  -- `P_j` is Borel (Lusin–Souslin), and `P_j ⊆ ψ_j(C_j)`, a compact subset of `U`
  have hPm : ∀ j, MeasurableSet (ψ j '' Y j) := fun j =>
    (hCY j).2.2.1.image_of_continuousOn_injOn
      ((hV j).2.1.continuousOn.mono ((hCY j).2.2.2.1.trans (hCY j).2.1))
      ((hV j).2.2.1.mono ((hCY j).2.2.2.1.trans (hCY j).2.1))
  have hPC : ∀ j, IsCompact (ψ j '' C j) := fun j =>
    (hCY j).1.image_of_continuousOn ((hV j).2.1.continuousOn.mono (hCY j).2.1)
  have hPCU : ∀ j, ψ j '' C j ⊆ U := fun j => (image_mono (hCY j).2.1).trans (hV j).2.2.2.2
  have hPPC : ∀ j, ψ j '' Y j ⊆ ψ j '' C j := fun j => image_mono (hCY j).2.2.2.1
  -- Step 2: (G2), everywhere on `ℝ^P`
  have hG2 : ∀ x, g x ∈ approxTangentPlane (n + 1) RT.carrier x := by
    intro x
    by_cases hx : ∃ j, x ∈ ψ j '' Y j
    · obtain ⟨j, y, hy, rfl⟩ := hx
      rw [hTψ j y hy]
      exact (hgT j y hy).1
    · push Not at hx
      rw [hg0 x hx]
      exact Submodule.zero_mem _
  -- Step 3: `M_t` is the disjoint union of the Borel piece slices `(P_j)_t`
  have hgne : MeasurableSet {x | g x ≠ 0} := (hgm (measurableSet_singleton 0)).compl
  have hft : ∀ t : ℝ, MeasurableSet (f ⁻¹' {t}) := fun t => hfm (measurableSet_singleton t)
  have hcover : ∀ t, RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} ⊆
      ⋃ j, ψ j '' Y j ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} := by
    rintro t x ⟨⟨-, hgx⟩, hfx⟩
    by_contra hx
    simp only [mem_iUnion, not_exists] at hx
    exact hgx (hg0 x fun j hj => hx j ⟨⟨hj, hgx⟩, hfx⟩)
  have hsub : ∀ t j, ψ j '' Y j ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} ⊆
      RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} := fun t j =>
    inter_subset_inter_left _ (inter_subset_inter_left _ (hYM j))
  -- the piece results
  have hcoarea := fun j => Submission.dor_lmbsf_piece_coarea P n (V j) (C j) (Y j) (ψ j) (F j) f g
    (hV j).1 (hV j).2.1 (hV j).2.2.1 (hV j).2.2.2.1 (hCY j).1 (hCY j).2.1 (hCY j).2.2.1
    (hCY j).2.2.2.1 (hCY j).2.2.2.2 (fun y hy => (hfT j y hy).1) (hgT j) hgm
  have hslice := fun j => Submission.dor_lmbsf_piece_slice_approxTangent hTL P n (V j) (C j) (Y j)
    (ψ j) (F j) f g (hV j).1 (hV j).2.1 (hV j).2.2.1 (hV j).2.2.2.1 (hCY j).1 (hCY j).2.1
    (hCY j).2.2.1 (hCY j).2.2.2.1 (hCY j).2.2.2.2 (fun y hy => (hfT j y hy).1) (hgT j)
  refine ⟨g, hgm, hgL, Eventually.of_forall hG2, fun φ hφ => ?_, fun t => ?_, fun t hfin => ?_,
    ?_⟩
  · -- Step 4: (G3), summing the piece co-area formulas
    exact Submission.dor_lmbsf_tg_coarea_gluing P μHE[n + 1] μHE[n] RT.carrier
      (fun j => ψ j '' Y j) g f φ hMm hPm hdisj hYM hgm hg0 hfm fun j => hcoarea j φ hφ
  · -- Step 5: (G4a), a countable union of countably `n`-rectifiable piece slices
    exact (Poincare.SimonGMT.Chapter03.countablyRectifiable_iUnion
      (fun j => ψ j '' Y j ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}) fun j => (hslice j t).1).mono
        (hcover t)
  · -- Step 6: (G4b), gluing the approximate tangent spaces of the piece slices by (TL)
    refine Submission.dor_lmbsf_tg_tangent_gluing hTL P n U
      (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}) (fun j => ψ j '' Y j ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t})
      (fun x => approxTangentPlane (n + 1) RT.carrier x ⊓ (ℝ ∙ g x)ᗮ) hU
      ((hMm.inter hgne).inter (hft t))
      (inter_subset_left.trans (inter_subset_left.trans RT.carrier_subset)) hfin
      (fun j => ((hPm j).inter hgne).inter (hft t)) (hsub t) (hcover t) fun j => ?_
    -- the piece slice lies in `M_t ∩ ψ_j(C_j)`, so it has finite `Hⁿ` measure
    have hSfin : μHE[n] (ψ j '' Y j ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}) ≠ ∞ :=
      ne_top_of_le_ne_top (hfin _ (hPC j) (hPCU j)) (measure_mono (subset_inter (hsub t j)
        (inter_subset_left.trans (inter_subset_left.trans (hPPC j)))))
    filter_upwards [(hslice j t).2 hSfin, ae_restrict_mem (((hPm j).inter hgne).inter (hft t))]
      with x hx hxS
    obtain ⟨y, hy, rfl⟩ := hxS.1.1
    rw [hTψ j y hy]
    exact hx y hy rfl
  · -- Step 7: (G5), dominated convergence over the pieces with weight `θ`
    intro a b hab hs c hs1 hsc hsu W K c' hWm hK hKU hWK hWc hWT
    have hc : 0 ≤ c := (norm_nonneg _).trans (hsc 0 0)
    have hc' : 0 ≤ c' := (norm_nonneg _).trans (hWc 0)
    -- `κ θ 1_K` is integrable on `M` for every constant `κ`
    have hdom : ∀ κ : ℝ, IntegrableOn (K.indicator fun x => κ * (RT.mult x : ℝ)) RT.carrier
        μHE[n + 1] := by
      intro κ
      rw [IntegrableOn, integrable_indicator_iff hK.measurableSet, IntegrableOn,
        Measure.restrict_restrict hK.measurableSet, inter_comm]
      exact (hθint K hK hKU).const_mul κ
    refine Submission.dor_lmbsf_tg_weak_limit_gluing P μHE[n + 1] RT.carrier
      {x | a < f x ∧ f x < b} (fun j => ψ j '' Y j)
      (fun k x => (RT.mult x : ℝ) * fderiv ℝ (hs k) x (W x))
      (fun x => (RT.mult x : ℝ) * (-(b - a)⁻¹ * inner ℝ (g x) (W x)))
      (K.indicator fun x => c * c' * (RT.mult x : ℝ)) hMm (hfm measurableSet_Ioo) hPm hdisj hYM
      hnull (hdom (c * c')) (fun k => ?_) (fun k => Eventually.of_forall fun x => ?_) ?_ fun j => ?_
    · -- the integrands are measurable
      exact hθm.aestronglyMeasurable.mul
        (Continuous.comp_aestronglyMeasurable₂
          (g := fun (Λ : Euclid P →L[ℝ] ℝ) (v : Euclid P) => Λ v)
          isBoundedBilinearMap_apply.continuous
          ((hs1 k).continuous_fderiv one_ne_zero).aestronglyMeasurable hWm.aestronglyMeasurable)
    · -- `|θ Dh_k[W]| ≤ c c' θ 1_K`
      by_cases hxK : x ∈ K
      · rw [indicator_of_mem hxK, norm_mul, Real.norm_natCast, mul_comm (c * c')]
        exact mul_le_mul_of_nonneg_left (((fderiv ℝ (hs k) x).le_opNorm (W x)).trans
          (mul_le_mul (hsc k x) (hWc x) (norm_nonneg _) hc)) (Nat.cast_nonneg _)
      · rw [indicator_of_notMem hxK, hWK x hxK, map_zero, mul_zero, norm_zero]
    · -- `|θ (-(b - a)⁻¹ ⟨g, W⟩)| ≤ (b - a)⁻¹ L c' θ 1_K`, so the limit integrand is integrable
      refine Integrable.mono' ((hdom ((b - a)⁻¹ * (L * c'))).mono_set inter_subset_left)
        (hθm.aestronglyMeasurable.mul (aestronglyMeasurable_const.mul
          (continuous_inner.comp_aestronglyMeasurable₂ hgm.aestronglyMeasurable
            hWm.aestronglyMeasurable))) (Eventually.of_forall fun x => ?_)
      by_cases hxK : x ∈ K
      · rw [indicator_of_mem hxK, norm_mul, norm_mul, norm_neg, Real.norm_natCast, norm_inv,
          Real.norm_of_nonneg (sub_pos.2 hab).le, mul_comm _ (RT.mult x : ℝ)]
        refine mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left ?_
          (inv_nonneg.2 (sub_pos.2 hab).le)) (Nat.cast_nonneg _)
        exact (norm_inner_le_norm _ _).trans
          (mul_le_mul (hgL x) (hWc x) (norm_nonneg _) L.coe_nonneg)
      · rw [indicator_of_notMem hxK, hWK x hxK, inner_zero_right, mul_zero, mul_zero, norm_zero]
    · -- `piece_weak_limit` on `P_j`, with `θ` integrable on `P_j ⊆ M ∩ ψ_j(C_j)`
      have hθj : IntegrableOn (fun x => (RT.mult x : ℝ)) (ψ j '' Y j) μHE[n + 1] :=
        (hθint _ (hPC j) (hPCU j)).mono_set (subset_inter (hYM j) (hPPC j))
      have hWj : ∀ᵐ x ∂(μHE[n + 1].restrict (ψ j '' Y j)), ∀ y ∈ Y j, ψ j y = x →
          W x ∈ LinearMap.range (fderiv ℝ (ψ j) y : Euclid (n + 1) →ₗ[ℝ] Euclid P) := by
        filter_upwards [ae_restrict_of_ae_restrict_of_subset (hYM j) hWT] with x hx
        rintro y hy rfl
        rw [← hTψ j y hy]
        exact hx
      exact Submission.dor_lmbsf_piece_weak_limit P n (V j) (C j) (Y j) (ψ j) (F j) f g L a b c c'
        hs (fun x => (RT.mult x : ℝ)) W (hV j).1 (hV j).2.1 (hV j).2.2.1 (hV j).2.2.2.1 (hCY j).1
        (hCY j).2.1 (hCY j).2.2.1 (hCY j).2.2.2.1 (hCY j).2.2.2.2 (fun y hy => (hfT j y hy).1)
        (hgT j) hgm hf hab hs1 hsc hsu hθj hWm hWc hWj
/-- Transfer of null sets to almost every slice (Simon 7.4.3, slicing step; co-area formula of
Ch. 2, 6.6 and slices of Ch. 6, 4.3): if the slice measures `ν_t` satisfy the co-area identity
`∫_ℝ ∫ φ dν_t dt = ∫ w φ dμ` for every Borel `φ ≥ 0`, then a property holding `μ`-a.e. holds
`ν_t`-a.e. for a.e. `t`.  With `Z ⊇ {¬p}` a Borel `μ`-null hull and `φ = 1_Z`, the right side
vanishes, so `ν_t(Z) = ∫ 1_Z dν_t = 0` for a.e. `t`. -/
theorem Submission.dor_lmbsf_si_coarea_ae_transfer : ∀ (P : ℕ) (μ : Measure (Euclid P)) (ν : ℝ → Measure (Euclid P)) (w : Euclid P → ℝ≥0∞) (p : Euclid P → Prop), (∀ φ : Euclid P → ℝ≥0∞, Measurable φ → AEMeasurable (fun t => ∫⁻ x, φ x ∂(ν t)) ∧ ∫⁻ t, ∫⁻ x, φ x ∂(ν t) = ∫⁻ x, w x * φ x ∂μ) → (∀ᵐ x ∂μ, p x) → ∀ᵐ t, ∀ᵐ x ∂(ν t), p x := by
  intro P μ ν w p hco hp
  -- a Borel `μ`-null hull `Z` of `{x | ¬p x}`
  set Z := toMeasurable μ {x | ¬p x} with hZ
  have hZm : MeasurableSet Z := measurableSet_toMeasurable _ _
  have hμZ : μ Z = 0 := by rw [hZ, measure_toMeasurable]; exact ae_iff.mp hp
  -- co-area identity for `φ = 1_Z`: `∫_ℝ ν_t(Z) dt = ∫ w 1_Z dμ = 0`
  obtain ⟨hae, heq⟩ := hco (Z.indicator 1) (measurable_one.indicator hZm)
  have hzero : ∫⁻ x, w x * Z.indicator 1 x ∂μ = 0 := by
    refine (lintegral_congr_ae ?_).trans lintegral_zero
    filter_upwards [measure_eq_zero_iff_ae_notMem.mp hμZ] with x hx
    simp [indicator_of_notMem hx]
  rw [hzero, lintegral_eq_zero_iff' hae] at heq
  -- for a.e. `t`, `ν_t(Z) = 0`, so `ν_t`-a.e. `x` lies outside `Z ⊇ {¬p}`
  filter_upwards [heq] with t ht
  have hνZ : ν t Z = 0 := by
    rw [← lintegral_indicator_one hZm]; exact ht
  filter_upwards [measure_eq_zero_iff_ae_notMem.mp hνZ] with x hx
  by_contra hpx
  exact hx (subset_toMeasurable μ {x | ¬p x} hpx)

/-- Orthonormal frame of `Q` adapted to a unit vector `ν ∈ Q` (Simon Ch. 6, 4.3, used for the
orientation of the slices in 7.4): if `dim Q = n + 1`, then `Q' = Q ∩ ν^⊥` has an orthonormal
basis `σ = (σ₁, …, σₙ)`, so that `(ν, σ₁, …, σₙ)` is an orthonormal basis of `Q`.  The dimension
count is `dim (ℝν) + dim (ν^⊥ ∩ Q) = dim Q`. -/
theorem Submission.dor_lmbsf_io_adapted_frame : ∀ (P n : ℕ) (Q : Submodule ℝ (Euclid P)) (ν : Euclid P), Module.finrank ℝ Q = n + 1 → ν ∈ Q → ‖ν‖ = 1 → ∃ σ : Fin n → Euclid P, Orthonormal ℝ σ ∧ Submodule.span ℝ (Set.range σ) = Q ⊓ (ℝ ∙ ν)ᗮ ∧ Orthonormal ℝ (Fin.cons ν σ : Fin (n + 1) → Euclid P) ∧ (∀ i, σ i ∈ Q) ∧ ∀ i, inner ℝ ν (σ i) = 0 := by
  intro P n Q ν hQ hνQ hν
  set Q' : Submodule ℝ (Euclid P) := Q ⊓ (ℝ ∙ ν)ᗮ
  have hν0 : ν ≠ 0 := by
    intro h; rw [h, norm_zero] at hν; exact zero_ne_one hν
  have hle : (ℝ ∙ ν) ≤ Q := (Submodule.span_singleton_le_iff_mem ν Q).2 hνQ
  -- `dim Q' = n`
  have hdim : Module.finrank ℝ Q' = n := by
    have h1 := Submodule.finrank_add_inf_finrank_orthogonal hle
    rw [finrank_span_singleton hν0, hQ] at h1
    have : Q' = (ℝ ∙ ν)ᗮ ⊓ Q := inf_comm _ _
    rw [this]; omega
  -- `σ` is an orthonormal basis `b` of `Q'`, viewed in `ℝᴾ`
  let b : OrthonormalBasis (Fin n) ℝ Q' := (stdOrthonormalBasis ℝ Q').reindex (finCongr hdim)
  let σ : Fin n → Euclid P := fun i => (b i : Euclid P)
  have hσ : Orthonormal ℝ σ := b.orthonormal.comp_linearIsometry Q'.subtypeₗᵢ
  have hσmem : ∀ i, σ i ∈ Q' := fun i => (b i).2
  have hσspan : Submodule.span ℝ (Set.range σ) = Q' := by
    have hrange : Set.range σ = Q'.subtype '' Set.range b := by
      ext x; simp [σ]
    have htop : Submodule.span ℝ (Set.range b) = ⊤ := by simpa using b.toBasis.span_eq
    rw [hrange, Submodule.span_image, htop, Submodule.map_top, Submodule.range_subtype]
  have hσQ : ∀ i, σ i ∈ Q := fun i => (hσmem i).1
  have hνσ : ∀ i, inner ℝ ν (σ i) = 0 := fun i =>
    (Submodule.mem_orthogonal_singleton_iff_inner_right).1 (hσmem i).2
  refine ⟨σ, hσ, hσspan, ?_, hσQ, hνσ⟩
  -- `Fin.cons ν σ` is orthonormal: split both indices into `0` and successors
  rw [orthonormal_iff_ite] at hσ ⊢
  intro i j
  refine Fin.cases ?_ (fun i' => ?_) i <;> refine Fin.cases ?_ (fun j' => ?_) j
  · simp [hν]
  · simp [hνσ j', (Fin.succ_ne_zero j').symm]
  · simp [real_inner_comm, hνσ i', Fin.succ_ne_zero i']
  · simp [hσ i' j']
/-- Sign lemma for unit orientations (Simon 6.1.1; used for the slice orientation
`ξ ⌞ ∇^M f/|∇^M f|` of 6.4.3 in the slicing step of the proof of 7.4.3): if
`ζ = ±τ₁ ∧ ⋯ ∧ τₘ` is a unit orientation of `Q` and `ρ` is an orthonormal `m`-frame in `Q`, then
`ζ = ρ₁ ∧ ⋯ ∧ ρₘ` or `ζ = -ρ₁ ∧ ⋯ ∧ ρₘ`.  The change of frame `M = (⟨τᵢ, ρⱼ⟩)` satisfies
`Mᵀ M = I`, so `det M = ±1`, and `β(ρ) = det M · β(τ)` for every `m`-covector `β`. -/
theorem Submission.dor_lmbsf_io_orientation_frame_sign : ∀ (P m : ℕ) (ζ : MultiVector P m) (Q : Submodule ℝ (Euclid P)) (ρ : Fin m → Euclid P), IsUnitOrientationOf ζ Q → Orthonormal ℝ ρ → (∀ j, ρ j ∈ Q) → (∀ β : Covector (Euclid P) m, ζ β = β ρ) ∨ ∀ β : Covector (Euclid P) m, ζ β = -β ρ := by
  intro P m ζ Q ρ hζ hρ hρQ
  obtain ⟨τ, hτ, hspan, hsign⟩ := hζ
  set M : Matrix (Fin m) (Fin m) ℝ := Matrix.of fun i j => inner ℝ (τ i) (ρ j) with hM
  have hρspan : ∀ j, ρ j ∈ Submodule.span ℝ (Set.range τ) := fun j => hspan ▸ hρQ j
  -- `β(ρ) = det M · β(τ)`
  have hdet : ∀ β : Covector (Euclid P) m, β ρ = M.det * β τ :=
    Submission.dgoj_covector_eq_det_mul_of_mem_span P m τ ρ hτ hρspan
  -- Parseval in `span τ`: `⟨x, y⟩ = ∑ᵢ ⟨τᵢ, x⟩ ⟨τᵢ, y⟩`
  have hparseval : ∀ x y : Euclid P, y ∈ Submodule.span ℝ (Set.range τ) →
      inner ℝ x y = ∑ i, inner ℝ (τ i) x * inner ℝ (τ i) y := by
    intro x y hy
    obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).1 hy
    simp only [hτ.inner_right_fintype, inner_sum, inner_smul_right]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [real_inner_comm, mul_comm]
  -- `M` is orthogonal, so `det M = ±1`
  have hMM : M.transpose * M = 1 := by
    ext j k
    rw [Matrix.mul_apply, Matrix.one_apply]
    simp only [Matrix.transpose_apply, hM, Matrix.of_apply]
    rw [← hparseval (ρ j) (ρ k) (hρspan k)]
    exact orthonormal_iff_ite.1 hρ j k
  have hdet2 : M.det * M.det = 1 := by
    have := congrArg Matrix.det hMM
    rwa [Matrix.det_mul, Matrix.det_transpose, Matrix.det_one] at this
  have hpm : M.det = 1 ∨ M.det = -1 := by
    have h0 : (M.det - 1) * (M.det + 1) = 0 := by linear_combination hdet2
    rcases mul_eq_zero.1 h0 with h | h
    · left; linarith
    · right; linarith
  rcases hsign with h | h <;> rcases hpm with hd | hd
  · left; intro β; rw [h, hdet, hd, one_mul]
  · right; intro β; rw [h, hdet, hd]; ring
  · right; intro β; rw [h, hdet, hd, one_mul]
  · left; intro β; rw [h, hdet, hd]; ring
/-- Step 3 of the orientation of a slice (Simon 6.4.3, `⟨v⌞w, a⟩ = ⟨v, w ∧ a⟩`): if `ν` is a
unit vector orthogonal to `σ₀, …, σₙ₋₁`, then `(ν♭ ∧ α)(ν, σ₀, …, σₙ₋₁) = α(σ₀, …, σₙ₋₁)` for
every `n`-covector `α`, where `ν♭ ∧ α` is the alternatization of `w ↦ ⟨ν, w⟩ α`,
`(ν♭ ∧ α)(v) = ∑ᵢ (-1)ⁱ ⟨ν, vᵢ⟩ α(v₀, …, v̂ᵢ, …, vₙ)`.  The term `i = 0` is
`⟨ν, ν⟩ α(σ) = α(σ)`; every other term has a factor `⟨ν, σⱼ⟩ = 0`. -/
theorem Submission.dor_lmbsf_io_wedge_eval_cons : ∀ (P n : ℕ) (ν : Euclid P) (σ : Fin n → Euclid P) (α : Covector (Euclid P) n), ‖ν‖ = 1 → (∀ i, inner ℝ ν (σ i) = 0) → ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ ν).smulRight α) (Fin.cons ν σ : Fin (n + 1) → Euclid P) = α σ := by
  intro P n ν σ α hν hνσ
  -- expand at `v = (ν, σ₀, …, σₙ₋₁)` and split off the term `i = 0`
  rw [ContinuousAlternatingMap.alternatizeUncurryFin_apply, Fin.sum_univ_succ]
  -- `⟨ν, ν⟩ = ‖ν‖² = 1`, `v` without `v₀` is `σ`, and `⟨ν, vⱼ₊₁⟩ = ⟨ν, σⱼ⟩ = 0`
  simp [Fin.removeNth_zero, Fin.tail_cons, innerSL_apply_apply, hνσ, hν]

/-- Orientation of a slice (Simon Ch. 6, 4.3: `⟨v⌞w, a⟩ = ⟨v, w ∧ a⟩`, and `ξ⌞ν` orients
`TₓM ∩ ν^⊥`): if the `(n+1)`-vector `ζ` orients `Q`, `ν ∈ Q` is a unit vector and
`⟨α, ζ'⟩ = ⟨ν♭ ∧ α, ζ⟩` for every `n`-covector `α`, then `ζ'` orients `Q ∩ ν^⊥`.  In an
orthonormal frame `(ν, σ)` of `Q` adapted to `ν`, `ζ` is `±` evaluation at `(ν, σ)` and
`(ν♭ ∧ α)(ν, σ) = α(σ)`, so `ζ'(α) = ±α(σ)`. -/
theorem Submission.dor_lmbsf_interior_product_orientation : ∀ (P n : ℕ) (ζ : MultiVector P (n + 1)) (ζ' : MultiVector P n) (Q : Submodule ℝ (Euclid P)) (ν : Euclid P), IsUnitOrientationOf ζ Q → ν ∈ Q → ‖ν‖ = 1 → (∀ α : Covector (Euclid P) n, ζ' α = ζ (ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ ν).smulRight α))) → IsUnitOrientationOf ζ' (Q ⊓ (ℝ ∙ ν)ᗮ) := by
  intro P n ζ ζ' Q ν hζ hνQ hν hζ'
  -- `dim Q = n + 1`, read off the orthonormal frame `τ` oriented by `ζ`
  have hdim : Module.finrank ℝ Q = n + 1 := by
    obtain ⟨τ, hτ, hτQ, -⟩ := hζ
    rw [← hτQ, finrank_span_eq_card hτ.linearIndependent, Fintype.card_fin]
  -- an orthonormal frame `(ν, σ)` of `Q`, with `σ` an orthonormal basis of `Q ∩ ν^⊥`
  obtain ⟨σ, hσ, hσspan, hνσo, hσQ, hνσ⟩ :=
    Submission.dor_lmbsf_io_adapted_frame P n Q ν hdim hνQ hν
  have hνσQ : ∀ j, (Fin.cons ν σ : Fin (n + 1) → Euclid P) j ∈ Q := by
    intro j
    refine Fin.cases ?_ (fun i => ?_) j
    · simpa using hνQ
    · simpa using hσQ i
  -- `(ν♭ ∧ α)(ν, σ) = α(σ)`
  have hwedge : ∀ α : Covector (Euclid P) n,
      ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ ν).smulRight α)
        (Fin.cons ν σ : Fin (n + 1) → Euclid P) = α σ := fun α =>
    Submission.dor_lmbsf_io_wedge_eval_cons P n ν σ α hν hνσ
  -- `ζ` is `±` evaluation at `(ν, σ)`, so `ζ'` is `±` evaluation at `σ`
  refine ⟨σ, hσ, hσspan, ?_⟩
  rcases Submission.dor_lmbsf_io_orientation_frame_sign P (n + 1) ζ Q _ hζ hνσo hνσQ with h | h
  · exact Or.inl fun α => by rw [hζ' α, h, hwedge]
  · exact Or.inr fun α => by rw [hζ' α, h, hwedge]
/-- **Mollification preserves the Lipschitz constant** (step 4 of the Lipschitz smoothing): if
`ψ ≥ 0` is continuous with compact support and `∫ ψ = 1`, and `g` is `K`-Lipschitz, then
`G x = ∫ ψ(y) g(x - y) dy` is `K`-Lipschitz.  Indeed `G x - G x'` is the integral of
`ψ(y) (g(x - y) - g(x' - y))`, whose absolute value is at most `ψ(y) K ‖x - x'‖`, and
`∫ ψ = 1`. -/
theorem Submission.cmcs_ls_mollify_lipschitz : ∀ (P : ℕ) (ψ g : Euclid P → ℝ) (K : NNReal), Continuous ψ → HasCompactSupport ψ → (∀ x, 0 ≤ ψ x) → ∫ x, ψ x = 1 → LipschitzWith K g → LipschitzWith K (fun x => ∫ y, ψ y * g (x - y)) := by
  intro P ψ g K hψc hψs hψ0 hψ1 hg
  -- step 1: `y ↦ ψ y * g (x - y)` is continuous with support in `support ψ`, hence integrable
  have hint : ∀ x : Euclid P, Integrable (fun y => ψ y * g (x - y)) := fun x =>
    (hψc.mul (hg.continuous.comp (continuous_const.sub continuous_id))).integrable_of_hasCompactSupport
      hψs.mul_right
  -- step 5: it suffices to show `dist (G x) (G x') ≤ K * dist x x'`
  refine LipschitzWith.of_dist_le_mul fun x x' => ?_
  -- step 2: `G x - G x'` is a single integral
  rw [Real.dist_eq, ← integral_sub (hint x) (hint x'), ← Real.norm_eq_abs]
  calc ‖∫ y, (ψ y * g (x - y) - ψ y * g (x' - y))‖
      ≤ ∫ y, ψ y * (K * dist x x') := by
        -- step 4: integrate the pointwise bound of step 3 against the integrable majorant
        refine norm_integral_le_of_norm_le
          ((hψc.integrable_of_hasCompactSupport (μ := volume) hψs).mul_const _)
          (Eventually.of_forall fun y => ?_)
        -- step 3: `|ψ y (g (x - y) - g (x' - y))| = ψ y dist (g (x - y)) (g (x' - y))`
        -- `≤ ψ y (K dist (x - y) (x' - y)) = ψ y (K dist x x')`
        rw [← mul_sub, Real.norm_eq_abs, abs_mul, abs_of_nonneg (hψ0 y), ← Real.dist_eq,
          ← dist_sub_right x x' y]
        exact mul_le_mul_of_nonneg_left (hg.dist_le_mul _ _) (hψ0 y)
    _ = K * dist x x' := by rw [integral_mul_const, hψ1, one_mul]

/-- **Smoothing of Lipschitz functions** (Simon Ch. 6, 4.8–4.9: use `f^{(σ)}` in place of a
Lipschitz `f`): a `K`-Lipschitz `g` on `ℝᴾ` and `σ > 0` give a `C^∞` function `g'` with
`‖Dg'‖ ≤ K`, `|g' − g| ≤ Kσ`, and `g'(x) = c` whenever `g ≡ c` on `B_σ(x)`.  Take the normalized
mollifier `ψ` (`support ψ ⊆ B_σ(0)`) and `g' = ψ ⋆ g`, `g'(x) = ∫ ψ(y) g(x − y) dy`: it is `C^∞`
(`ψ` is smooth with compact support, `g` is continuous) and `K`-Lipschitz, so `‖Dg'‖ ≤ K`.  The
last two claims are `dist_convolution_le` on `B_σ(x)`, with `ε = Kσ`, `z₀ = g(x)` and with
`ε = 0`, `z₀ = c`.  (`ContDiffBump.normed` and its convolution lemmas are outside the import
closure.) -/
theorem Submission.cmcs_lipschitz_smoothing : ∀ (P : ℕ) (g : Euclid P → ℝ) (K : NNReal) (σ : ℝ), LipschitzWith K g → 0 < σ → ∃ g' : Euclid P → ℝ, ContDiff ℝ (⊤ : ℕ∞) g' ∧ (∀ x, ‖fderiv ℝ g' x‖ ≤ K) ∧ (∀ x, |g' x - g x| ≤ K * σ) ∧ ∀ (x : Euclid P) (c : ℝ), (∀ y ∈ ball x σ, g y = c) → g' x = c := by
  intro P g K σ hg hσ
  obtain ⟨ψ, hψd, hψs, hψ0, hψ1, hψb⟩ := Submission.dgcr_stc_exists_normalized_mollifier P σ hσ
  -- `g' = ψ ⋆ g`
  have hconv : (fun x => ∫ y, ψ y * g (x - y)) =
      convolution ψ g (ContinuousLinearMap.lsmul ℝ ℝ) volume := by
    funext x
    simp only [convolution_def, ContinuousLinearMap.lsmul_apply, smul_eq_mul]
  refine ⟨fun x => ∫ y, ψ y * g (x - y), ?_, fun x => ?_, fun x => ?_, fun x c hc => ?_⟩
  · rw [hconv]
    exact hψs.contDiff_convolution_left _ hψd hg.continuous.locallyIntegrable
  · exact norm_fderiv_le_of_lipschitz ℝ
      (Submission.cmcs_ls_mollify_lipschitz P ψ g K hψd.continuous hψs hψ0 hψ1 hg)
  · -- `dist (g y) (g x) ≤ K ‖y − x‖ ≤ Kσ` on `B_σ(x)`
    have h := dist_convolution_le (μ := volume) (x₀ := x) (z₀ := g x)
      (mul_nonneg K.coe_nonneg hσ.le) hψb hψ0 hψ1 hg.continuous.aestronglyMeasurable
      (fun y hy => (hg.dist_le_mul y x).trans
        (mul_le_mul_of_nonneg_left (mem_ball.1 hy).le K.coe_nonneg))
    rwa [← hconv, Real.dist_eq] at h
  · -- `g ≡ c` on `B_σ(x)`, so `dist (g' x) c ≤ 0`
    have h := dist_convolution_le (μ := volume) (x₀ := x) (z₀ := c) le_rfl hψb hψ0 hψ1
      hg.continuous.aestronglyMeasurable (fun y hy => by rw [hc y hy, dist_self])
    rw [← hconv] at h
    exact dist_le_zero.1 h

/-- **Smoothing the Lipschitz cut-off** (step 1 of the Lipschitz Leibniz rule): for an
`L`-Lipschitz `f` on `ℝᴾ` and `a < b`, the cut-off `h = γ_{a,b} ∘ f`,
`h(x) = min{1, max{0, (b − f(x))/(b − a)}}`, is a uniform limit of `C^∞` functions `h_k` with
`‖Dh_k‖ ≤ c` and `|h_k| ≤ 2`.  The clamp `γ_{a,b}` is `(b − a)⁻¹`-Lipschitz, so `h` is
`K`-Lipschitz with `K = (b − a)⁻¹L`, and `|h| ≤ 1`.  `cmcs_lipschitz_smoothing` with
`σ_k = 1/((K + 1)(k + 1))` gives `C^∞` functions `h_k` with `‖Dh_k‖ ≤ K` and
`|h_k − h| ≤ Kσ_k ≤ 1/(k + 1)`; take `c = K`. -/
theorem Submission.dor_lmbsf_ll_cutoff_smooth_approx : ∀ (P : ℕ) (f : Euclid P → ℝ) (L : NNReal) (a b : ℝ), LipschitzWith L f → a < b → ∃ (hs : ℕ → Euclid P → ℝ) (c : ℝ), (∀ k, ContDiff ℝ (⊤ : ℕ∞) (hs k)) ∧ (∀ k x, ‖fderiv ℝ (hs k) x‖ ≤ c) ∧ (∀ k x, |hs k x| ≤ 2) ∧ TendstoUniformly hs (fun x => min 1 (max 0 ((b - f x) / (b - a)))) atTop := by
  intro P f L a b hf hab
  have hba : 0 < b - a := sub_pos.mpr hab
  set h : Euclid P → ℝ := fun x => min 1 (max 0 ((b - f x) / (b - a))) with hh_def
  -- step 1: the clamp `γ_{a,b}` is `(b - a)⁻¹`-Lipschitz
  have hγ : LipschitzWith (Real.toNNReal (b - a)⁻¹)
      (fun s : ℝ => min 1 (max 0 ((b - s) / (b - a)))) := by
    apply LipschitzWith.of_dist_le_mul
    intro s t
    rw [Real.coe_toNNReal _ (inv_nonneg.mpr hba.le)]
    simp only [Real.dist_eq]
    calc |min 1 (max 0 ((b - s) / (b - a))) - min 1 (max 0 ((b - t) / (b - a)))|
        ≤ |max 0 ((b - s) / (b - a)) - max 0 ((b - t) / (b - a))| :=
          abs_min_sub_min_le_max _ _ _ _ |>.trans (by simp)
      _ ≤ |(b - s) / (b - a) - (b - t) / (b - a)| := by
          rw [max_comm 0, max_comm 0]; exact abs_max_sub_max_le_abs _ _ _
      _ = (b - a)⁻¹ * |s - t| := by
          rw [div_sub_div_same, abs_div, abs_of_pos hba, abs_sub_comm]
          ring_nf
  -- step 2: `h = γ_{a,b} ∘ f` is `K`-Lipschitz, `K = (b - a)⁻¹ L`
  set K : NNReal := Real.toNNReal (b - a)⁻¹ * L with hK_def
  have hhK : LipschitzWith K h := hγ.comp hf
  -- steps 4–5: smooth `h` at the scales `σ_k = 1/((K + 1)(k + 1))`
  have hσ : ∀ k : ℕ, 0 < 1 / (((K : ℝ) + 1) * ((k : ℝ) + 1)) := fun k => by positivity
  have hex := fun k : ℕ => Submission.cmcs_lipschitz_smoothing P h K
    (1 / (((K : ℝ) + 1) * ((k : ℝ) + 1))) hhK (hσ k)
  choose hs hs_smooth hs_deriv hs_close _ using hex
  -- `K σ_k ≤ 1/(k + 1)`
  have hKσ : ∀ k : ℕ, (K : ℝ) * (1 / (((K : ℝ) + 1) * ((k : ℝ) + 1))) ≤ 1 / ((k : ℝ) + 1) := by
    intro k
    have hK0 : (0 : ℝ) ≤ K := K.2
    rw [mul_one_div, div_le_div_iff₀ (by positivity) (by positivity)]
    nlinarith
  -- step 3: `|h| ≤ 1`
  have hh01 : ∀ x, |h x| ≤ 1 := by
    intro x
    rw [abs_le]
    constructor
    · simp only [h]; exact le_trans (by norm_num) (le_min (by norm_num) (le_max_left _ _))
    · exact min_le_left _ _
  -- step 6: take `c = K`
  refine ⟨hs, K, hs_smooth, hs_deriv, ?_, ?_⟩
  · -- `|h_k| ≤ |h_k - h| + |h| ≤ 1/(k + 1) + 1 ≤ 2`
    intro k x
    have h1 := hs_close k x
    have h2 := hKσ k
    have h3 : 1 / ((k : ℝ) + 1) ≤ 1 := by
      rw [div_le_one (by positivity)]; linarith [(Nat.cast_nonneg k : (0 : ℝ) ≤ k)]
    calc |hs k x| = |(hs k x - h x) + h x| := by ring_nf
      _ ≤ |hs k x - h x| + |h x| := abs_add_le _ _
      _ ≤ 1 + 1 := add_le_add (h1.trans (h2.trans h3)) (hh01 x)
      _ = 2 := by norm_num
  · -- `|h_k - h| ≤ 1/(k + 1) ≤ 1/(N + 1) < ε` for `k ≥ N`
    rw [Metric.tendstoUniformly_iff]
    intro ε hε
    obtain ⟨N, hN⟩ := exists_nat_one_div_lt hε
    filter_upwards [eventually_ge_atTop N] with k hk x
    rw [dist_comm, Real.dist_eq]
    calc |hs k x - h x| ≤ (K : ℝ) * (1 / (((K : ℝ) + 1) * ((k : ℝ) + 1))) := hs_close k x
      _ ≤ 1 / ((k : ℝ) + 1) := hKσ k
      _ ≤ 1 / ((N : ℝ) + 1) := by
          apply one_div_le_one_div_of_le (by positivity)
          exact_mod_cast Nat.add_le_add_right hk 1
      _ < ε := hN
/-- **Simon 6.4.11** (Leibniz rule behind the cutoff identity
`T(γ∘f dω) − T(d(γ∘f ω)) = −T(γ'(f) df ∧ ω)`): if `g` and the `k`-form `η` are differentiable
at `x`, then `d(gη)(x) = g(x) dη(x) + dg(x) ∧ η(x)`, where `dg(x) ∧ η(x)` is the alternation of
`v ↦ Dg(x)(v) η(x)`.  Unfold `d = extDeriv = alternatizeUncurryFin ∘ fderiv`, apply the product
rule `fderiv_fun_smul`, and use additivity and `ℝ`-homogeneity of `alternatizeUncurryFin`. -/
theorem Submission.cmcs_cd_extDeriv_smul_leibniz : ∀ (P k : ℕ) (g : Euclid P → ℝ) (η : DifferentialForm (Euclid P) k) (x : Euclid P), DifferentiableAt ℝ g x → DifferentiableAt ℝ η x → exteriorDerivative (fun y => g y • η y) x = g x • exteriorDerivative η x + ContinuousAlternatingMap.alternatizeUncurryFin ((fderiv ℝ g x).smulRight (η x)) := by
  intro P k g η x hg hη
  -- `d θ x = alternatizeUncurryFin (fderiv ℝ θ x)` by definition
  show ContinuousAlternatingMap.alternatizeUncurryFin (fderiv ℝ (fun y => g y • η y) x) =
    g x • ContinuousAlternatingMap.alternatizeUncurryFin (fderiv ℝ η x) +
      ContinuousAlternatingMap.alternatizeUncurryFin ((fderiv ℝ g x).smulRight (η x))
  -- product rule, then linearity of the alternation
  rw [fderiv_fun_smul hg hη, ContinuousAlternatingMap.alternatizeUncurryFin_add,
    ContinuousAlternatingMap.alternatizeUncurryFin_smul]
/-- **Simon Ch. 6, 4.11** (the multiplier step behind `T(γ∘f dω)` and `T(d(γ∘f ω))`): test forms
in `U` are closed under multiplication by `C^∞` functions.  For `ω ∈ 𝒟ⁿ(U)` and `g ∈ C^∞`, the
form `gω` is `C^∞`; it vanishes wherever `ω` does, so `spt(gω) ⊆ spt ω ⊆ U`, and `spt(gω)` is
compact as a closed subset of the compact set `spt ω`.  Neither openness of `U` nor compact
support of `g` is needed. -/
theorem Submission.cmcs_cd_smul_mem_testFormOn : ∀ (P n : ℕ) (U : Set (Euclid P)) (g : Euclid P → ℝ) (ω : TestFormOn U n), ContDiff ℝ (⊤ : ℕ∞) g → (fun x => g x • (ω : DifferentialForm (Euclid P) n) x) ∈ TestFormOn U n := by
  intro P n U g ω hg
  -- `ω ∈ 𝒟ⁿ(U)`: `ω` is `C^∞`, `spt ω` is compact and `spt ω ⊆ U`
  have hω : IsTestForm (ω : DifferentialForm (Euclid P) n) ∧
      tsupport (ω : DifferentialForm (Euclid P) n) ⊆ U := ω.property
  have hsmooth : ContDiff ℝ (⊤ : ℕ∞) (ω : DifferentialForm (Euclid P) n) := hω.1.1
  have hcompact : IsCompact (tsupport (ω : DifferentialForm (Euclid P) n)) := hω.1.2
  -- `gω` vanishes wherever `ω` does, so `spt(gω) ⊆ spt ω`
  have hsub : tsupport (fun x => g x • (ω : DifferentialForm (Euclid P) n) x) ⊆
      tsupport (ω : DifferentialForm (Euclid P) n) :=
    tsupport_smul_subset_right (fun x => g x) _
  -- `spt(gω)` is a closed subset of the compact set `spt ω`
  have hcpt : IsCompact (tsupport fun x => g x • (ω : DifferentialForm (Euclid P) n) x) :=
    hcompact.of_isClosed_subset (isClosed_tsupport _) hsub
  exact ⟨⟨hg.smul hsmooth, hcpt⟩, hsub.trans hω.2⟩

/-- **Simon 6.4.11, the cut-off defect identity**, with a smooth `g` in place of `γ ∘ f` and with
`T`, `∂T` written through integral representations `T = ξ μ`, `∂T = ξ' μ'`: for `g ∈ C^∞` and
`η ∈ 𝒟^k(U)`, `T(g dη) − ∂T(gη) = −T(dg ∧ η)`, where
`dg ∧ η = alternatizeUncurryFin (Dg.smulRight η)`.  The forms `gη` and `g dη` are test forms by
`cmcs_cd_smul_mem_testFormOn`, and `d(gη) − g dη = dg ∧ η` pointwise by the Leibniz rule
`cmcs_cd_extDeriv_smul_leibniz`.  Every equality of integrals is a representation hypothesis or
`integral_congr_ae` for a pointwise identity, so no integrability is needed. -/
theorem Submission.cmcs_cd_defect_identity : ∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (g : Euclid P → ℝ) (η : TestFormOn U k), (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ θ : TestFormOn U k, T.boundary θ = ∫ x, ξ' x ((θ : DifferentialForm (Euclid P) k) x) ∂μ') → ContDiff ℝ (⊤ : ℕ∞) g → ∫ x, g x * ξ x (exteriorDerivative (η : DifferentialForm (Euclid P) k) x) ∂μ - ∫ x, g x * ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ' = -∫ x, ξ x (ContinuousAlternatingMap.alternatizeUncurryFin ((fderiv ℝ g x).smulRight ((η : DifferentialForm (Euclid P) k) x))) ∂μ := by
  intro P k U T μ μ' ξ ξ' g η hT hbT hg
  -- Step 1: the test forms `dη`, `gη`, `g dη` and `d(gη)`
  let dη : TestFormOn U (k + 1) := exteriorDerivativeTestOn U k η
  let ηg : TestFormOn U k :=
    ⟨fun x => g x • (η : DifferentialForm (Euclid P) k) x,
      Submission.cmcs_cd_smul_mem_testFormOn P k U g η hg⟩
  let ωg : TestFormOn U (k + 1) :=
    ⟨fun x => g x • (dη : DifferentialForm (Euclid P) (k + 1)) x,
      Submission.cmcs_cd_smul_mem_testFormOn P (k + 1) U g dη hg⟩
  let dηg : TestFormOn U (k + 1) := exteriorDerivativeTestOn U k ηg
  -- Step 2: the first integral is `T(g dη)`
  have h1 : ∫ x, g x * ξ x (exteriorDerivative (η : DifferentialForm (Euclid P) k) x) ∂μ =
      T ωg := by
    rw [hT ωg]
    refine integral_congr_ae (Eventually.of_forall fun x => ?_)
    change g x * ξ x (exteriorDerivative (η : DifferentialForm (Euclid P) k) x) =
      ξ x (g x • exteriorDerivative (η : DifferentialForm (Euclid P) k) x)
    rw [map_smul, smul_eq_mul]
  -- Step 3: the second integral is `∂T(gη) = T(d(gη))`
  have h2 : ∫ x, g x * ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ' = T dηg := by
    rw [show T dηg = T.boundary ηg from (GeometricCurrentOn.boundary_apply T ηg).symm, hbT ηg]
    refine integral_congr_ae (Eventually.of_forall fun x => ?_)
    change g x * ξ' x ((η : DifferentialForm (Euclid P) k) x) =
      ξ' x (g x • (η : DifferentialForm (Euclid P) k) x)
    rw [map_smul, smul_eq_mul]
  -- Step 4: pointwise, `d(gη) − g dη = dg ∧ η` by the Leibniz rule
  have h3 : ∀ x, ((dηg - ωg : TestFormOn U (k + 1)) : DifferentialForm (Euclid P) (k + 1)) x =
      ContinuousAlternatingMap.alternatizeUncurryFin
        ((fderiv ℝ g x).smulRight ((η : DifferentialForm (Euclid P) k) x)) := by
    intro x
    have hgx : DifferentiableAt ℝ g x := hg.differentiable (by simp) x
    have hηx : DifferentiableAt ℝ (η : DifferentialForm (Euclid P) k) x :=
      η.property.1.1.differentiable (by simp) x
    change exteriorDerivative (fun y => g y • (η : DifferentialForm (Euclid P) k) y) x -
      g x • exteriorDerivative (η : DifferentialForm (Euclid P) k) x = _
    rw [Submission.cmcs_cd_extDeriv_smul_leibniz P k g _ x hgx hηx]
    abel
  -- Step 5: linearity of `T`
  have h4 : T ωg - T dηg = -T (dηg - ωg) := by
    have hsub := LinearMap.map_sub (T.toCurrent : ↥(TestFormOn U (k + 1)) →ₗ[ℝ] ℝ) dηg ωg
    change T.toCurrent ωg - T.toCurrent dηg = -T.toCurrent (dηg - ωg)
    rw [hsub]
    ring
  -- Steps 6 and 7: `T(d(gη) − g dη)` as an integral
  rw [h1, h2, h4, hT]
  congr 1
  exact integral_congr_ae (Eventually.of_forall fun x => congrArg (ξ x) (h3 x))
/-- **Simon Ch. 6, 3.1 (‡) under bounded multipliers**: if `h_k` are measurable, `|h_k| ≤ C`
and `h_k → h` pointwise, then `∫_M θ h_k ⟨ω, ξ⟩ dHⁿ → ∫_M θ h ⟨ω, ξ⟩ dHⁿ`.  The integrands are
`h_k G` with `G = θ ⟨ω, ξ⟩` `Hⁿ⌞M`-integrable, dominated by `C |G|` and converging pointwise to
`h G`, so dominated convergence applies. -/
theorem Submission.dor_lmbsf_ll_action_mul_tendsto : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (ω : TestFormOn U n) (hs : ℕ → Euclid P → ℝ) (h : Euclid P → ℝ) (C : ℝ), (∀ k, Measurable (hs k)) → (∀ k x, |hs k x| ≤ C) → (∀ x, Tendsto (fun k => hs k x) atTop (𝓝 (h x))) → Tendsto (fun k => ∫ x in R.carrier, (R.mult x : ℝ) * hs k x * R.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) atTop (𝓝 (∫ x in R.carrier, (R.mult x : ℝ) * h x * R.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n])) := by
  intro P n U R ω hs h C hmeas hbdd hlim
  -- `G = θ ⟨ω, ξ⟩` is `Hⁿ⌞M`-integrable
  have hG := Submission.rsd_cmr_ic_action_integrable P n U R ω
  set G : Euclid P → ℝ :=
    fun x => (R.mult x : ℝ) * R.orient x ((ω : DifferentialForm (Euclid P) n) x)
  -- the integrands are `h_k G` and `h G`
  have key : ∀ k,
      (fun x => (R.mult x : ℝ) * hs k x * R.orient x ((ω : DifferentialForm (Euclid P) n) x))
        = fun x => hs k x * G x := by
    intro k; funext x; simp only [G]; ring
  have keyh : (fun x => (R.mult x : ℝ) * h x * R.orient x ((ω : DifferentialForm (Euclid P) n) x))
      = fun x => h x * G x := by
    funext x; simp only [G]; ring
  rw [keyh]
  simp_rw [key]
  -- dominated convergence with bound `C |G|`
  refine tendsto_integral_of_dominated_convergence (fun x => C * ‖G x‖) ?_ ?_ ?_ ?_
  · intro k; exact (hmeas k).aestronglyMeasurable.mul hG.aestronglyMeasurable
  · exact hG.norm.const_mul C
  · intro k
    filter_upwards with x
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (by simpa [Real.norm_eq_abs] using hbdd k x) (norm_nonneg _)
  · filter_upwards with x
    exact (hlim x).mul_const (G x)

/-- Signed co-area integral (Simon Ch. 2, 6.6, used for the slices in 7.4): if the slice
measures `ν t` satisfy the co-area identity `∫ (∫ φ dν_t) dt = ∫ w φ dμ` for every Borel
`φ ≥ 0`, and `∫ w |q| dμ < ∞`, then `t ↦ ∫ q dν_t` is integrable and
`∫ (∫ q dν_t) dt = ∫ w q dμ`.  Apply the identity to `q⁺` and `q⁻` and subtract; where
`w = ∞`, finiteness of `∫ w |q| dμ` forces `q = 0` `μ`-a.e. -/
theorem Submission.dor_lmbsf_si_coarea_signed_integral : ∀ (P : ℕ) (μ : Measure (Euclid P)) (ν : ℝ → Measure (Euclid P)) (w : Euclid P → ℝ≥0∞) (q : Euclid P → ℝ), (∀ φ : Euclid P → ℝ≥0∞, Measurable φ → AEMeasurable (fun t => ∫⁻ x, φ x ∂(ν t)) ∧ ∫⁻ t, ∫⁻ x, φ x ∂(ν t) = ∫⁻ x, w x * φ x ∂μ) → Measurable w → Measurable q → ∫⁻ x, w x * ‖q x‖ₑ ∂μ ≠ ∞ → Integrable (fun t => ∫ x, q x ∂(ν t)) ∧ ∫ t, ∫ x, q x ∂(ν t) = ∫ x, (w x).toReal * q x ∂μ := by
  intro P μ ν w q hco hw hq hfin
  -- `q⁺ = ofReal q` and `q⁻ = ofReal (-q)` are Borel and bounded by `|q|`
  have hqp : Measurable fun x => ENNReal.ofReal (q x) := hq.ennreal_ofReal
  have hqn : Measurable fun x => ENNReal.ofReal (-q x) := hq.neg.ennreal_ofReal
  have hle_p : ∀ x, ENNReal.ofReal (q x) ≤ ‖q x‖ₑ := fun x => by
    rw [← ofReal_norm, Real.norm_eq_abs]; exact ENNReal.ofReal_le_ofReal (le_abs_self _)
  have hle_n : ∀ x, ENNReal.ofReal (-q x) ≤ ‖q x‖ₑ := fun x => by
    rw [← ofReal_norm, Real.norm_eq_abs]; exact ENNReal.ofReal_le_ofReal (neg_le_abs _)
  -- the co-area identity for `q⁺`, `q⁻` and `|q|`, all with finite total integral
  obtain ⟨haeP, heqP⟩ := hco _ hqp
  obtain ⟨haeN, heqN⟩ := hco _ hqn
  obtain ⟨haeA, heqA⟩ := hco _ hq.enorm
  have hfinP : ∫⁻ t, ∫⁻ x, ENNReal.ofReal (q x) ∂(ν t) ≠ ∞ := by
    rw [heqP]; exact ne_top_of_le_ne_top hfin (lintegral_mono fun x => mul_le_mul_right (hle_p x) _)
  have hfinN : ∫⁻ t, ∫⁻ x, ENNReal.ofReal (-q x) ∂(ν t) ≠ ∞ := by
    rw [heqN]; exact ne_top_of_le_ne_top hfin (lintegral_mono fun x => mul_le_mul_right (hle_n x) _)
  have hfinA : ∫⁻ t, ∫⁻ x, ‖q x‖ₑ ∂(ν t) ≠ ∞ := by rw [heqA]; exact hfin
  -- `q` is `ν t`-integrable for a.e. `t`, where `∫ q dν_t = ∫ q⁺ dν_t - ∫ q⁻ dν_t`
  have hint : ∀ᵐ t, Integrable q (ν t) := by
    filter_upwards [ae_lt_top' haeA hfinA] with t ht
    exact ⟨hq.aestronglyMeasurable, ht⟩
  have hrepr : (fun t => ∫ x, q x ∂(ν t)) =ᵐ[volume] fun t =>
      (∫⁻ x, ENNReal.ofReal (q x) ∂(ν t)).toReal - (∫⁻ x, ENNReal.ofReal (-q x) ∂(ν t)).toReal := by
    filter_upwards [hint] with t ht
    exact integral_eq_lintegral_pos_part_sub_lintegral_neg_part ht
  have hIP : Integrable (fun t => (∫⁻ x, ENNReal.ofReal (q x) ∂(ν t)).toReal) :=
    integrable_toReal_of_lintegral_ne_top haeP hfinP
  have hIN : Integrable (fun t => (∫⁻ x, ENNReal.ofReal (-q x) ∂(ν t)).toReal) :=
    integrable_toReal_of_lintegral_ne_top haeN hfinN
  refine ⟨(hIP.sub hIN).congr hrepr.symm, ?_⟩
  -- the left side is `(∫ w q⁺ dμ).toReal - (∫ w q⁻ dμ).toReal`
  rw [integral_congr_ae hrepr, integral_sub hIP hIN, integral_toReal haeP (ae_lt_top' haeP hfinP),
    integral_toReal haeN (ae_lt_top' haeN hfinN), heqP, heqN]
  -- `h = w q` is `μ`-integrable since `|h| ≤ w |q|`; split `∫ h dμ` into its two parts
  have hh : Integrable (fun x => (w x).toReal * q x) μ := by
    refine ⟨(hw.ennreal_toReal.mul hq).aestronglyMeasurable, ?_⟩
    refine lt_of_le_of_lt (lintegral_mono fun x => ?_) hfin.lt_top
    rw [enorm_mul]
    gcongr
    rw [Real.enorm_eq_ofReal ENNReal.toReal_nonneg]
    exact ENNReal.ofReal_toReal_le
  rw [integral_eq_lintegral_pos_part_sub_lintegral_neg_part hh]
  -- `w |q| < ∞` `μ`-a.e., and there `ofReal (w r) = w ofReal r` whenever `|r| ≤ |q|`
  -- (if `w = ∞` then `q = 0`, so `r = 0`)
  have hnull : ∀ᵐ x ∂μ, w x * ‖q x‖ₑ < ∞ := ae_lt_top (hw.mul hq.enorm) hfin
  have key : ∀ x, w x * ‖q x‖ₑ < ∞ → ∀ r : ℝ, |r| ≤ |q x| →
      ENNReal.ofReal ((w x).toReal * r) = w x * ENNReal.ofReal r := by
    intro x hx r hr
    by_cases hwx : w x = ∞
    · have hq0 : q x = 0 := by
        by_contra hq0
        rw [hwx, ENNReal.top_mul (by simpa using hq0)] at hx
        exact lt_irrefl _ hx
      have : r = 0 := by rw [hq0, abs_zero] at hr; exact abs_nonpos_iff.mp hr
      simp [this]
    · rw [ENNReal.ofReal_mul ENNReal.toReal_nonneg, ENNReal.ofReal_toReal hwx]
  have e1 : ∫⁻ x, ENNReal.ofReal ((w x).toReal * q x) ∂μ = ∫⁻ x, w x * ENNReal.ofReal (q x) ∂μ := by
    refine lintegral_congr_ae ?_
    filter_upwards [hnull] with x hx
    exact key x hx (q x) le_rfl
  have e2 : ∫⁻ x, ENNReal.ofReal (-((w x).toReal * q x)) ∂μ =
      ∫⁻ x, w x * ENNReal.ofReal (-q x) ∂μ := by
    refine lintegral_congr_ae ?_
    filter_upwards [hnull] with x hx
    rw [← mul_neg]
    exact key x hx (-q x) (by rw [abs_neg])
  rw [e1, e2]
/-- Countable compact exhaustion, swapping "for every compact `K ⊆ U`" and "for a.e. `t`" (used
for the local integrability of the slices of Simon Ch. 6, 4.1–4.3 in the slicing step of the
proof of 7.4.3): if every `F t` is monotone and, for each compact `K ⊆ U`, `F t K ≠ ∞` for a.e.
`t`, then for a.e. `t`, `F t K ≠ ∞` for all compact `K ⊆ U` at once.  The compact sets
`Kᵢ = B̄(0, i) ∖ {y : dist(y, Uᶜ) < 1/(i+1)}` lie in `U`, and every compact `K ⊆ U` lies in some
`Kᵢ` (it is bounded and at positive distance from `Uᶜ`); intersect the countably many full-measure
sets and use `F t K ≤ F t Kᵢ`. -/
theorem Submission.dor_lmbsf_si_ae_forall_compact : ∀ (P : ℕ) (U : Set (Euclid P)) (F : ℝ → Set (Euclid P) → ℝ≥0∞), IsOpen U → (∀ t, Monotone (F t)) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ∀ᵐ t, F t K ≠ ∞) → ∀ᵐ t, ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → F t K ≠ ∞ := by
  intro P U F hU hmono hK
  -- the compact sets `Kᵢ = B̄(0, i) ∖ thickening (1/(i+1)) Uᶜ ⊆ U`
  let Kn : ℕ → Set (Euclid P) := fun i => closedBall 0 i \ thickening (1 / ((i : ℝ) + 1)) Uᶜ
  have hKc : ∀ i, IsCompact (Kn i) := fun i =>
    (isCompact_closedBall 0 (i : ℝ)).diff isOpen_thickening
  have hKU : ∀ i, Kn i ⊆ U := by
    intro i x hx
    by_contra hxU
    exact hx.2 (self_subset_thickening (by positivity) _ hxU)
  -- every compact `K ⊆ U` lies in some `Kᵢ`: `K ⊆ B̄(0, R)` and `thickening δ K ⊆ U`
  have hcover : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ∃ i, K ⊆ Kn i := by
    intro K hKc' hKU'
    obtain ⟨δ, hδ, hδK⟩ := hKc'.exists_thickening_subset_open hU hKU'
    obtain ⟨R, hR⟩ := hKc'.isBounded.subset_closedBall 0
    obtain ⟨i₁, hi₁⟩ := exists_nat_ge R
    obtain ⟨i₂, hi₂⟩ := exists_nat_one_div_lt hδ
    refine ⟨max i₁ i₂, fun x hx => ⟨?_, ?_⟩⟩
    · exact closedBall_subset_closedBall (hi₁.trans (by exact_mod_cast le_max_left i₁ i₂)) (hR hx)
    · intro hxt
      rw [mem_thickening_iff] at hxt
      obtain ⟨y, hyU, hxy⟩ := hxt
      have hlt : (1 : ℝ) / ((max i₁ i₂ : ℕ) + 1) ≤ 1 / ((i₂ : ℝ) + 1) := by
        gcongr; exact_mod_cast le_max_right i₁ i₂
      have hy : y ∈ thickening δ K := by
        rw [mem_thickening_iff]
        exact ⟨x, hx, by rw [dist_comm]; linarith⟩
      exact hyU (hδK hy)
  -- for a.e. `t`, `F t Kᵢ ≠ ∞` for all `i` at once; then `F t K ≤ F t Kᵢ`
  have hall : ∀ᵐ t, ∀ i, F t (Kn i) ≠ ∞ := ae_all_iff.mpr fun i => hK _ (hKc i) (hKU i)
  filter_upwards [hall] with t ht K hKc' hKU'
  obtain ⟨i, hi⟩ := hcover K hKc' hKU'
  exact ne_top_of_le_ne_top (ht i) (hmono t hi)
/-- The orientation field of a slice (Simon Ch. 6, 4.3–4.4: `ξₜ = ξ⌞(∇ᴹf/|∇ᴹf|)`, with
`⟨v⌞w, a⟩ = ⟨v, w ∧ a⟩`; the slices of Ch. 6, 4.5 enter the upper mass bound in the proof of
7.4.3): for a strongly measurable `(n+1)`-vector field `ζ` and a Borel vector field `g`, the
`n`-vector field `ζ' = ζ⌞(g/|g|)`, `⟨α, ζ'⟩ = ⟨(g/|g|)♭ ∧ α, ζ⟩`, is strongly measurable,
`|g| ζ' = ζ⌞g`, and `|⟨g♭ ∧ α, ζ⟩| ≤ (n + 1) |ζ| |g| |α|`.  The wedge `(v, α) ↦ v♭ ∧ α` is
bounded bilinear with `|v♭ ∧ α| ≤ (n + 1) |v| |α|`, so `(ζ₀, v) ↦ ζ₀ ∘ (v♭ ∧ ·)` is continuous. -/
theorem Submission.dor_lmbsf_si_slice_orientation_field : ∀ (P n : ℕ) (ζ : Euclid P → MultiVector P (n + 1)) (g : Euclid P → Euclid P), StronglyMeasurable ζ → Measurable g → ∃ ζ' : Euclid P → MultiVector P n, StronglyMeasurable ζ' ∧ (∀ x (α : Covector (Euclid P) n), ζ' x α = ζ x (ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ (‖g x‖⁻¹ • g x)).smulRight α))) ∧ (∀ x (α : Covector (Euclid P) n), ‖g x‖ * ζ' x α = ζ x (ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ (g x)).smulRight α))) ∧ ∀ x (α : Covector (Euclid P) n), |ζ x (ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ (g x)).smulRight α))| ≤ ((n : ℝ) + 1) * ‖ζ x‖ * ‖g x‖ * ‖α‖ := by
  intro P n ζ g hζ hg
  -- the wedge `B(v, α) = v♭ ∧ α`, with `|v♭ ∧ α| ≤ (n + 1) |v| |α|`
  let B : Euclid P × Covector (Euclid P) n → Covector (Euclid P) (n + 1) := fun p =>
    ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ p.1).smulRight p.2)
  have hBnorm : ∀ v α, ‖B (v, α)‖ ≤ ((n : ℝ) + 1) * ‖v‖ * ‖α‖ := fun v α => by
    refine (ContinuousAlternatingMap.norm_alternatizeUncurryFin_le _).trans_eq ?_
    rw [ContinuousLinearMap.norm_smulRight_apply, innerSL_apply_norm, mul_assoc]
  -- `B` is bilinear: compare the arguments of `alternatizeUncurryFin` at each `y`
  have hB : IsBoundedBilinearMap ℝ B :=
    { add_left := fun v w α => by
        simp only [B, map_add, ← ContinuousAlternatingMap.alternatizeUncurryFin_add]
        congr 1
        ext y
        simp [add_smul]
      smul_left := fun c v α => by
        simp only [B, map_smul, ← ContinuousAlternatingMap.alternatizeUncurryFin_smul]
        congr 1
        ext y
        simp [smul_smul]
      add_right := fun v α β => by
        simp only [B, ← ContinuousAlternatingMap.alternatizeUncurryFin_add]
        congr 1
        ext y
        simp
      smul_right := fun c v α => by
        simp only [B, ← ContinuousAlternatingMap.alternatizeUncurryFin_smul]
        congr 1
        ext y
        simp [smul_smul, mul_comm]
      bound := ⟨(n : ℝ) + 1, by positivity, hBnorm⟩ }
  -- `A v = v♭ ∧ ·`, a continuous linear map in `v`
  let A : Euclid P →L[ℝ] Covector (Euclid P) n →L[ℝ] Covector (Euclid P) (n + 1) :=
    hB.toContinuousLinearMap
  -- `Ξ(ζ₀, v) = ζ₀ ∘ (v♭ ∧ ·)` is continuous, since composition is bounded bilinear
  let Ξ : MultiVector P (n + 1) × Euclid P → MultiVector P n := fun p => p.1.comp (A p.2)
  have hΞ : Continuous Ξ := isBoundedBilinearMap_comp.continuous.comp
    (continuous_fst.prodMk (A.continuous.comp continuous_snd))
  -- `ζ' = Ξ(ζ, g/|g|)`, where `g/|g|` is Borel
  have hν : Measurable fun x => ‖g x‖⁻¹ • g x := hg.norm.inv.smul hg
  refine ⟨fun x => Ξ (ζ x, ‖g x‖⁻¹ • g x),
    hΞ.comp_stronglyMeasurable (hζ.prodMk hν.stronglyMeasurable), fun x α => rfl, ?_, ?_⟩
  · -- `|g| ζ' = ζ⌞g`: linearity of `A` and of `ζ(x)`; trivial where `g(x) = 0`
    intro x α
    show ‖g x‖ * ζ x (A (‖g x‖⁻¹ • g x) α) = ζ x (A (g x) α)
    by_cases hgx : g x = 0
    · simp [hgx]
    · rw [map_smul, smul_apply, map_smul, smul_eq_mul, ← mul_assoc,
        mul_inv_cancel₀ (norm_ne_zero_iff.mpr hgx), one_mul]
  · -- `|⟨g♭ ∧ α, ζ⟩| ≤ |ζ| |g♭ ∧ α| ≤ (n + 1) |ζ| |g| |α|`
    intro x α
    show |ζ x (A (g x) α)| ≤ _
    rw [← Real.norm_eq_abs]
    calc ‖ζ x (A (g x) α)‖ ≤ ‖ζ x‖ * ‖A (g x) α‖ := (ζ x).le_opNorm _
      _ ≤ ‖ζ x‖ * (((n : ℝ) + 1) * ‖g x‖ * ‖α‖) := by gcongr; exact hBnorm (g x) α
      _ = ((n : ℝ) + 1) * ‖ζ x‖ * ‖g x‖ * ‖α‖ := by ring
/-- A unit orientation has norm at most `1` (step 1(c) of the proof of Simon Ch. 6, 3.2(3)).
If `ξ α = ±α(τ₁, …, τₙ)` for an orthonormal family `τ`, then `|ξ α| = |α(τ)| ≤ ‖α‖ ∏ᵢ ‖τᵢ‖ = ‖α‖`
for every `n`-covector `α`, so the operator norm of `ξ` is at most `1`. -/
theorem Submission.unit_orientation_norm_le_one : ∀ (P n : ℕ) (Q : Submodule ℝ (Euclid P)) (ξ : MultiVector P n), IsUnitOrientationOf ξ Q → ‖ξ‖ ≤ 1 := by
  rintro P n Q ξ ⟨τ, hτ, -, hξ⟩
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun α => ?_
  -- `|α(τ)| ≤ ‖α‖ ∏ᵢ ‖τᵢ‖ = ‖α‖`, as `‖τᵢ‖ = 1`
  have hbound : ‖α τ‖ ≤ ‖α‖ := by
    simpa [hτ.1] using α.le_opNorm τ
  rcases hξ with h | h
  · rw [h, one_mul]
    exact hbound
  · rw [h, norm_neg, one_mul]
    exact hbound
/-- The vector representing `β ↦ ζ(β ∧ α)` (steps 4(a), 4(b) of the parent proof; Simon Ch. 6,
proof of Lemma 4.5(2), display (3)).  Write `β ∧ α` for `alternatizeUncurryFin (β.smulRight α)`,
`eₗ` for the standard basis of `ℝᴾ` and `V = Σₗ ζ(⟨eₗ, ·⟩ ∧ α) eₗ`.  Then `ζ(β ∧ α) = β(V)` for
every `1`-covector `β`, as `β ↦ ζ(β ∧ α)` is linear and `β = Σₗ β(eₗ) ⟨eₗ, ·⟩`.  If `ζ` orients
`Q` and `v ∈ Qᗮ`, then `(⟨v, ·⟩ ∧ α)(τ) = Σᵢ (-1)ⁱ ⟨v, τᵢ⟩ α(…) = 0` for the basis `τ` of `Q`, so
`⟨v, V⟩ = ζ(⟨v, ·⟩ ∧ α) = 0` and `V ∈ Qᗮᗮ = Q`. -/
theorem Submission.dor_lmbsf_ll_wedge_representing_vector : ∀ (P n : ℕ) (ζ : MultiVector P (n + 1)) (α : Covector (Euclid P) n), (∀ β : Euclid P →L[ℝ] ℝ, ζ (ContinuousAlternatingMap.alternatizeUncurryFin (β.smulRight α)) = β (∑ l : Fin P, ζ (ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ (EuclideanSpace.single l (1 : ℝ))).smulRight α)) • EuclideanSpace.single l (1 : ℝ))) ∧ ∀ Q : Submodule ℝ (Euclid P), IsUnitOrientationOf ζ Q → (∑ l : Fin P, ζ (ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ (EuclideanSpace.single l (1 : ℝ))).smulRight α)) • EuclideanSpace.single l (1 : ℝ)) ∈ Q := by
  intro P n ζ α
  -- `Φ(β) = ζ(β ∧ α)` is linear in `β`
  let Φ : (Euclid P →L[ℝ] ℝ) → ℝ := fun β =>
    ζ (ContinuousAlternatingMap.alternatizeUncurryFin (β.smulRight α))
  have hΦadd : ∀ β₁ β₂ : Euclid P →L[ℝ] ℝ, Φ (β₁ + β₂) = Φ β₁ + Φ β₂ := by
    intro β₁ β₂
    have : (β₁ + β₂).smulRight α = β₁.smulRight α + β₂.smulRight α := by
      ext v; simp [add_smul]
    simp only [Φ, this, ContinuousAlternatingMap.alternatizeUncurryFin_add, map_add]
  have hΦsmul : ∀ (c : ℝ) (β : Euclid P →L[ℝ] ℝ), Φ (c • β) = c • Φ β := by
    intro c β
    have : (c • β).smulRight α = c • β.smulRight α := by
      ext v; simp [mul_smul]
    simp only [Φ, this, ContinuousAlternatingMap.alternatizeUncurryFin_smul, map_smul]
  let Φl : (Euclid P →L[ℝ] ℝ) →ₗ[ℝ] ℝ :=
    { toFun := Φ, map_add' := hΦadd, map_smul' := hΦsmul }
  -- `β = Σₗ β(eₗ) ⟨eₗ, ·⟩`
  have hβexp : ∀ β : Euclid P →L[ℝ] ℝ, β = ∑ l : Fin P,
      β (EuclideanSpace.single l (1 : ℝ)) • innerSL ℝ (EuclideanSpace.single l (1 : ℝ)) := by
    intro β
    ext v
    have hv : v = ∑ l : Fin P, v l • EuclideanSpace.single l (1 : ℝ) := by
      conv_lhs => rw [← (EuclideanSpace.basisFun (Fin P) ℝ).sum_repr v]
      simp
    simp only [FunLike.coe_sum, Finset.sum_apply, FunLike.coe_smul,
      Pi.smul_apply, innerSL_apply_apply, EuclideanSpace.inner_single_left, map_one, one_mul,
      smul_eq_mul]
    conv_lhs => rw [hv]
    simp [map_sum, map_smul, mul_comm]
  -- `ζ(β ∧ α) = Σₗ β(eₗ) ζ(⟨eₗ, ·⟩ ∧ α) = β(V)`
  have hid : ∀ β : Euclid P →L[ℝ] ℝ, Φ β = β (∑ l : Fin P,
      Φ (innerSL ℝ (EuclideanSpace.single l (1 : ℝ))) • EuclideanSpace.single l (1 : ℝ)) := by
    intro β
    have h1 : Φ β = Φl β := rfl
    rw [h1, hβexp β, map_sum]
    simp only [map_sum, map_smul, smul_eq_mul]
    apply Finset.sum_congr rfl
    intro l _
    simp only [Φl, LinearMap.coe_mk, AddHom.coe_mk]
    have := hβexp β
    rw [← this]
    ring
  refine ⟨hid, ?_⟩
  intro Q hQ
  obtain ⟨τ, -, hspan, hsign⟩ := hQ
  -- `ζ(⟨v, ·⟩ ∧ α) = ±(⟨v, ·⟩ ∧ α)(τ) = 0` for `v ∈ Qᗮ`, as every `τᵢ ∈ Q`
  have hzero : ∀ v ∈ Qᗮ, Φ (innerSL ℝ v) = 0 := by
    intro v hv
    have hτQ : ∀ i, τ i ∈ Q := fun i => hspan ▸ Submodule.subset_span (Set.mem_range_self i)
    have hval :
        ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ v).smulRight α) τ = 0 := by
      rw [ContinuousAlternatingMap.alternatizeUncurryFin_apply]
      apply Finset.sum_eq_zero
      intro i _
      simp [Submodule.inner_left_of_mem_orthogonal (hτQ i) hv]
    rcases hsign with h | h
    · simp only [Φ, h, hval]
    · simp only [Φ, h, hval, neg_zero]
  -- `⟨u, V⟩ = ζ(⟨u, ·⟩ ∧ α) = 0` for `u ∈ Qᗮ`, so `V ∈ Qᗮᗮ = Q`
  rw [← Submodule.orthogonal_orthogonal Q, Submodule.mem_orthogonal]
  intro u hu
  have := hid (innerSL ℝ u)
  rw [hzero u hu, innerSL_apply_apply] at this
  exact this.symm
/-- Scaling of `Hⁿ` under the blow-up `η_{x,r}(z) = r⁻¹(z − x)`, `r > 0`:
`Hⁿ(η_{x,r}(S) ∩ B̄_R(0)) = r⁻ⁿ Hⁿ(S ∩ B̄_{rR}(x))`.  As `‖η_{x,r}(z)‖ = r⁻¹‖z − x‖`, the left side
is `Hⁿ(η_{x,r}(S ∩ B̄_{rR}(x)))`; and `η_{x,r}` is the homothety of centre `x` and ratio `r⁻¹`,
which multiplies `Hⁿ` by `‖r⁻¹‖₊ⁿ = r⁻ⁿ`, followed by the translation by `−x`, an isometry. -/
theorem Submission.ptd_tl_blowUp_measure_scaling : ∀ (P n : ℕ) (x : Euclid P) (r R : ℝ) (S : Set (Euclid P)), 0 < r → μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' S ∩ closedBall 0 R) = (ENNReal.ofReal r)⁻¹ ^ n * μHE[n] (S ∩ closedBall x (r * R)) := by
  intro P n x r R S hr
  -- `‖η(z)‖ = r⁻¹‖z − x‖`, since `r > 0`
  have hnorm : ∀ z : Euclid P,
      ‖Poincare.SimonGMT.Chapter03.blowUpMap x r z‖ = r⁻¹ * ‖z - x‖ := by
    intro z
    rw [Poincare.SimonGMT.Chapter03.blowUpMap, norm_smul, Real.norm_eq_abs,
      abs_of_pos (inv_pos.mpr hr)]
  -- `η(S) ∩ B̄_R(0) = η(S ∩ B̄_{rR}(x))`
  have hset : Poincare.SimonGMT.Chapter03.blowUpMap x r '' S ∩ closedBall 0 R =
      Poincare.SimonGMT.Chapter03.blowUpMap x r '' (S ∩ closedBall x (r * R)) := by
    ext y
    constructor
    · rintro ⟨⟨z, hz, rfl⟩, hy⟩
      refine ⟨z, ⟨hz, ?_⟩, rfl⟩
      rw [mem_closedBall_zero_iff, hnorm] at hy
      rw [mem_closedBall, dist_eq_norm, ← mul_inv_cancel_left₀ hr.ne' ‖z - x‖]
      exact mul_le_mul_of_nonneg_left hy hr.le
    · rintro ⟨z, ⟨hz, hzx⟩, rfl⟩
      refine ⟨⟨z, hz, rfl⟩, ?_⟩
      rw [mem_closedBall, dist_eq_norm] at hzx
      rw [mem_closedBall_zero_iff, hnorm, ← inv_mul_cancel_left₀ hr.ne' R]
      exact mul_le_mul_of_nonneg_left hzx (inv_pos.mpr hr).le
  -- `η = τ ∘ h`: the homothety `h` of centre `x` and ratio `r⁻¹`, then the translation by `−x`
  have hcomp : Poincare.SimonGMT.Chapter03.blowUpMap x r =
      (fun y : Euclid P => y + -x) ∘ AffineMap.homothety x r⁻¹ := by
    funext z
    simp [Poincare.SimonGMT.Chapter03.blowUpMap, AffineMap.homothety_apply]
  -- `μ(η(T)) = μ(h(T)) = ‖r⁻¹‖₊ⁿ μ(T) = (ofReal r)⁻¹ⁿ μ(T)`
  have hscale : ∀ T : Set (Euclid P), μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' T) =
      (ENNReal.ofReal r)⁻¹ ^ n * μHE[n] T := by
    intro T
    rw [hcomp, Set.image_comp, (isometry_add_right (-x)).euclideanHausdorffMeasure_image,
      euclideanHausdorffMeasure_homothety_image n x (inv_ne_zero hr.ne') T, ENNReal.smul_def,
      smul_eq_mul, ENNReal.coe_pow, nnnorm_inv, ENNReal.coe_inv (nnnorm_ne_zero_iff.mpr hr.ne'),
      Real.nnnorm_of_nonneg hr.le, ← ENNReal.ofReal_eq_coe_nnreal hr.le]
  rw [hset, hscale]

/-- Images of open sets under a proper injective chart are relatively open: if `W` is open, `ψ` is
continuous and injective on `V` with `ψ(V) = W ∩ M`, and `V ∩ ψ⁻¹(K)` is compact for every compact
`K ⊆ W`, then every open `V₁ ⊆ V` has `ψ(V₁) = M ∩ N₀` for some open `N₀`.  For `v ∈ V₁`,
continuity of the inverse (`Submission.dsmc_chart_inverse_continuity`) gives `δᵥ > 0` such that
`v' ∈ V` and `|ψ(v') - ψ(v)| < δᵥ` force `v' ∈ V₁`; take `N₀ = ⋃_{v ∈ V₁} W ∩ B_{δᵥ}(ψ(v))`. -/
theorem Submission.idtp_ccd_scsp_li_chart_image_open : ∀ (P d : ℕ) (M W : Set (Euclid P)) (V V₁ : Set (Euclid d)) (ψ : Euclid d → Euclid P), IsOpen W → ContinuousOn ψ V → InjOn ψ V → ψ '' V = W ∩ M → (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → IsOpen V₁ → V₁ ⊆ V → ∃ N₀ : Set (Euclid P), IsOpen N₀ ∧ M ∩ N₀ = ψ '' V₁ := by
  intro P d M W V V₁ ψ hW hψ hinj hVM hproper hV₁ hV₁V
  -- `δᵥ`: `B_ε(v) ⊆ V₁`, and continuity of the inverse at `v` for this `ε`
  have hrad : ∀ v ∈ V₁, ∃ δ > 0, ∀ v' ∈ V, dist (ψ v') (ψ v) < δ → v' ∈ V₁ := by
    intro v hv
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hV₁ v hv
    obtain ⟨δ, hδ, hδε⟩ := Submission.dsmc_chart_inverse_continuity P d V W ψ hψ hinj
      (hVM ▸ inter_subset_left) hproper v (hV₁V hv) ε hε
    exact ⟨δ, hδ, fun v' hv' hd => hball (mem_ball.2 (hδε v' hv' hd))⟩
  choose δ hδ hδV₁ using hrad
  refine ⟨⋃ v, ⋃ hv : v ∈ V₁, W ∩ ball (ψ v) (δ v hv),
    isOpen_iUnion fun v => isOpen_iUnion fun hv => hW.inter isOpen_ball, ?_⟩
  ext x
  simp only [mem_inter_iff, mem_iUnion, mem_image]
  constructor
  · -- a point of `M ∩ W ∩ B_{δᵥ}(ψ(v))` is `ψ(v')` with `v' ∈ V`, hence `v' ∈ V₁`
    rintro ⟨hxM, v, hv, hxW, hxb⟩
    obtain ⟨v', hv'V, rfl⟩ : x ∈ ψ '' V := hVM ▸ ⟨hxW, hxM⟩
    exact ⟨v', hδV₁ v hv v' hv'V (mem_ball.1 hxb), rfl⟩
  · -- `ψ(v) ∈ W ∩ M` and `ψ(v) ∈ B_{δᵥ}(ψ(v))`
    rintro ⟨v, hv, rfl⟩
    have h : ψ v ∈ W ∩ M := hVM ▸ mem_image_of_mem ψ (hV₁V hv)
    exact ⟨h.2, v, hv, h.1, mem_ball_self (hδ v hv)⟩

/-- **Local inversion of a transversal `C¹` map on an embedded `C¹` surface** (Simon Ch. 2, §4,
(4.1)–(4.3), with the inverse function theorem).  Let `ψ : V₀ → W₀ ∩ M` be a chart at
`p = ψ(v₀)`.  On the open set `V₀ ∩ ψ⁻¹(U) ∋ v₀`, `Φ = F ∘ ψ` is `C¹`, and
`DΦ(v₀) = DF(p) ∘ Dψ(v₀)` is injective because `Dψ(v₀)(ℝ²) = T_pM` and `DF(p)` is injective on
`span T_pM`.  The `C¹` inverse function theorem gives `H : O → V₁` with `Φ ∘ H = id` on `O`,
`H(O) = V₁` and `DH` onto.  `G = ψ ∘ H` then satisfies `F ∘ G = id` on `O` and
`DG(w)(ℝ²) = Dψ(H w)(ℝ²) = T_{G w}M`.  Finally `ψ(V₁) = M ∩ N₀` for an open `N₀`, so
`N = N₀ ∩ U` has `G(O) = ψ(V₁) = M ∩ N`, since `ψ(V₁) ⊆ U`. -/
theorem Submission.idtp_ccd_scsp_local_inverse : ∀ (P : ℕ) (M : Set (Euclid P)) (p : Euclid P) (U : Set (Euclid P)) (F : Euclid P → Euclid 2), IsEmbeddedSubmanifold 1 2 M → p ∈ M → IsOpen U → p ∈ U → ContDiffOn ℝ 1 F U → (∀ v ∈ Submodule.span ℝ (tangentSpace M p), fderiv ℝ F p v = 0 → v = 0) → ∃ (O : Set (Euclid 2)) (N : Set (Euclid P)) (G : Euclid 2 → Euclid P), IsOpen O ∧ IsOpen N ∧ F p ∈ O ∧ p ∈ N ∧ N ⊆ U ∧ ContDiffOn ℝ 1 G O ∧ G '' O = M ∩ N ∧ (∀ w ∈ O, F (G w) = w) ∧ ∀ w ∈ O, tangentSpace M (G w) = Set.range (fderiv ℝ G w) := by
  intro P M p U F hM hp hU hpU hF htr
  -- Step 1: a chart `ψ : V₀ → W₀ ∩ M` at `p = ψ(v₀)`, with `T_{ψ(v)}M = Dψ(v)(ℝ²)` on `V₀`
  obtain ⟨V₀, W₀, ψ, hV₀, hW₀, hpW₀, hψ, hinj, hψV₀, hproper, hDψ⟩ := hM p hp
  obtain ⟨v₀, hv₀, rfl⟩ : p ∈ ψ '' V₀ := hψV₀ ▸ ⟨hpW₀, hp⟩
  have hψ1 : ContDiffOn ℝ 1 ψ V₀ := by exact_mod_cast hψ
  have hT : ∀ v ∈ V₀, tangentSpace M (ψ v) = Set.range (fderiv ℝ ψ v) := fun v hv =>
    Submission.chart_tangentSpace_eq_range_fderiv P 2 1 M W₀ V₀ ψ v le_rfl hV₀ hW₀ hψ hinj
      hψV₀ hproper hDψ hv
  -- Step 2: `ψ` is differentiable on the open set `V₀`, and `F` on the open set `U`
  have hψd : ∀ v ∈ V₀, DifferentiableAt ℝ ψ v := fun v hv =>
    (hψ1.differentiableOn one_ne_zero).differentiableAt (hV₀.mem_nhds hv)
  have hFd : DifferentiableAt ℝ F (ψ v₀) :=
    (hF.differentiableOn one_ne_zero).differentiableAt (hU.mem_nhds hpU)
  -- Step 3: `Φ = F ∘ ψ` is `C¹` on the open set `V₀ ∩ ψ⁻¹(U) ∋ v₀`, and `DΦ(v₀)` is injective:
  -- if `DF(p)(Dψ(v₀) z) = 0`, then `Dψ(v₀) z ∈ T_pM` gives `Dψ(v₀) z = 0`, so `z = 0`
  have hV₀U : IsOpen (V₀ ∩ ψ ⁻¹' U) := hψ1.continuousOn.isOpen_inter_preimage hV₀ hU
  have hΦinj : Injective (fderiv ℝ (F ∘ ψ) v₀) := by
    rw [fderiv_comp v₀ hFd (hψd v₀ hv₀)]
    refine (injective_iff_map_eq_zero _).2 fun z hz => ?_
    have hzT : fderiv ℝ ψ v₀ z ∈ tangentSpace M (ψ v₀) := by
      rw [hT v₀ hv₀]
      exact mem_range_self z
    exact (injective_iff_map_eq_zero _).1 (hDψ v₀ hv₀) z (htr _ (Submodule.subset_span hzT) hz)
  -- Steps 4–6: the `C¹` inverse function theorem for `Φ` at `v₀`
  obtain ⟨V₁, O, H, hV₁, hO, hv₀V₁, hV₁U, hΦO, hH, hHO, hΦH, hDH⟩ :=
    Submission.idtp_ccd_scsp_li_c1_inverse 2 (F ∘ ψ) (V₀ ∩ ψ ⁻¹' U) v₀ hV₀U ⟨hv₀, hpU⟩
      (hF.comp_inter hψ1) hΦinj
  have hV₁V₀ : V₁ ⊆ V₀ := hV₁U.trans inter_subset_left
  have hHV₀ : ∀ w ∈ O, H w ∈ V₀ := fun w hw => hV₁V₀ (hHO ▸ mem_image_of_mem H hw)
  -- Step 8: `ψ(V₁)` is relatively open in `M`, and `ψ(V₁) ⊆ U`
  obtain ⟨N₀, hN₀, hMN₀⟩ := Submission.idtp_ccd_scsp_li_chart_image_open P 2 M W₀ V₀ V₁ ψ hW₀
    hψ1.continuousOn hinj hψV₀ hproper hV₁ hV₁V₀
  have hψV₁U : ψ '' V₁ ⊆ U := image_subset_iff.2 fun v hv => (hV₁U hv).2
  have hpN₀ : ψ v₀ ∈ M ∩ N₀ := by
    rw [hMN₀]
    exact mem_image_of_mem ψ hv₀V₁
  -- Steps 7 and 9: `G = ψ ∘ H`, `N = N₀ ∩ U`
  refine ⟨O, N₀ ∩ U, ψ ∘ H, hO, hN₀.inter hU, hΦO, ⟨hpN₀.2, hpU⟩, inter_subset_right,
    hψ1.comp hH fun w hw => hHV₀ w hw, ?_, hΦH, fun w hw => ?_⟩
  · -- `G(O) = ψ(H(O)) = ψ(V₁) = (M ∩ N₀) ∩ U`
    rw [image_comp, hHO, ← inter_assoc, hMN₀, inter_eq_left.2 hψV₁U]
  · -- `DG(w)(ℝ²) = Dψ(H w)(DH(w)(ℝ²)) = Dψ(H w)(ℝ²) = T_{G w}M`, as `DH(w)` is onto
    have hHd : DifferentiableAt ℝ H w :=
      (hH.differentiableOn one_ne_zero).differentiableAt (hO.mem_nhds hw)
    rw [Function.comp_apply, hT (H w) (hHV₀ w hw), fderiv_comp w (hψd _ (hHV₀ w hw)) hHd,
      ContinuousLinearMap.coe_comp, (hDH w hw).range_comp]
/-- Localized Besicovitch density (Simon Ch. 3, Remark 1.5(2) and the proof of Theorem 1.6, with
Simon Ch. 1, Theorem 3.16 = Mathlib's `Besicovitch.ae_tendsto_measure_inter_div`).  Let `U` be
open, `A ⊆ B ⊆ U` Borel, and `Hⁿ(B ∩ K) < ∞` for every compact `K ⊆ U`.  Then for `Hⁿ⌞A`-a.e.
`x` and every `ε > 0`, `Hⁿ((B \ A) ∩ B̄_ρ(x)) ≤ ε Hⁿ(B ∩ B̄_ρ(x))` for all small `ρ > 0`; the
exceptional set does not depend on `ε`.

Proof sketch:
* Cover `U` by countably many open balls `B_r(y)` with `B̄_r(y) ⊆ U`.
* On each ball, `ν = Hⁿ⌞(B ∩ B̄_r(y))` is finite, so Besicovitch gives
  `ν(A ∩ B̄_ρ(x))/ν(B̄_ρ(x)) → 1` for `ν⌞A = (Hⁿ⌞A)⌞B̄_r(y)`-a.e. `x`.
* For `x ∈ B_r(y)` and small `ρ`, this quotient is `a/β`, where
  `a = Hⁿ(A ∩ B̄_ρ(x))` and `β = Hⁿ(B ∩ B̄_ρ(x)) < ∞`.
* If `ε ≥ 1`, the bound is monotonicity.
* If `ε < 1`, eventually `a/β > 1 − ε`, which forces `0 < β < ∞`; hence
  `Hⁿ((B \ A) ∩ B̄_ρ(x)) = β − a ≤ εβ`. -/
theorem Submission.ptd_tl_ae_excess_le : ∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ ε : ℝ≥0∞, 0 < ε → ∀ᶠ ρ in 𝓝[>] (0 : ℝ), μHE[n] ((B \ A) ∩ closedBall x ρ) ≤ ε * μHE[n] (B ∩ closedBall x ρ) := by
  intro P n U A B hU hA hB hAB hBU hfin
  -- Step 1: countably many open balls `B(y, r y)`, `y ∈ D`, with `B̄(y, r y) ⊆ U` cover `U`
  have hr : ∀ x ∈ U, ∃ r : ℝ, 0 < r ∧ closedBall x r ⊆ U := by
    intro x hx
    obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.1 hU x hx
    exact ⟨δ / 2, half_pos hδ, (closedBall_subset_ball (half_lt_self hδ)).trans hball⟩
  choose! r hr0 hrU using hr
  obtain ⟨D, hDU, hDc, hcov⟩ := TopologicalSpace.countable_cover_nhdsWithin
    (f := fun y => ball y (r y)) (s := U)
    fun x hx => mem_nhdsWithin_of_mem_nhds (ball_mem_nhds x (hr0 x hx))
  -- Steps 2–3: Besicovitch density for the finite measures `Hⁿ⌞(B ∩ B̄(y, r y))`, off one
  -- `Hⁿ⌞A`-null set for all `y ∈ D` at once
  have hpiece : ∀ᵐ x ∂(μHE[n].restrict A), ∀ y ∈ D, x ∈ closedBall y (r y) →
      Tendsto (fun ρ : ℝ => (μHE[n].restrict (B ∩ closedBall y (r y))) (A ∩ closedBall x ρ) /
        (μHE[n].restrict (B ∩ closedBall y (r y))) (closedBall x ρ)) (𝓝[>] 0) (𝓝 1) := by
    rw [ae_ball_iff hDc]
    intro y hy
    have : IsFiniteMeasure ((μHE[n] : Measure (Euclid P)).restrict (B ∩ closedBall y (r y))) :=
      ⟨by
        rw [Measure.restrict_apply_univ]
        exact (hfin _ (isCompact_closedBall y (r y)) (hrU y (hDU hy))).lt_top⟩
    have h := Besicovitch.ae_tendsto_measure_inter_div
      ((μHE[n] : Measure (Euclid P)).restrict (B ∩ closedBall y (r y))) A
    -- `(Hⁿ⌞(B ∩ K))⌞A = (Hⁿ⌞A)⌞K` since `A ⊆ B`
    have hres : ((μHE[n] : Measure (Euclid P)).restrict (B ∩ closedBall y (r y))).restrict A =
        ((μHE[n] : Measure (Euclid P)).restrict A).restrict (closedBall y (r y)) := by
      rw [Measure.restrict_restrict hA, Measure.restrict_restrict measurableSet_closedBall]
      congr 1
      ext z
      exact ⟨fun ⟨hzA, _, hzK⟩ => ⟨hzK, hzA⟩, fun ⟨hzK, hzA⟩ => ⟨hzA, hAB hzA, hzK⟩⟩
    rwa [hres, ae_restrict_iff' measurableSet_closedBall] at h
  filter_upwards [hpiece, ae_restrict_mem hA] with x hx hxA ε hε
  -- Step 4: `x ∈ B(y, r y)` for some `y ∈ D`, so `B̄_ρ(x) ⊆ B̄(y, r y)` for `ρ < δ`
  obtain ⟨y, hyD, hxy⟩ := mem_iUnion₂.1 (hcov (hBU (hAB hxA)))
  obtain ⟨δ, hδ, hδy⟩ := Metric.isOpen_iff.1 isOpen_ball x hxy
  have hsmall : ∀ ρ : ℝ, ρ < δ → closedBall x ρ ⊆ closedBall y (r y) := fun ρ hρ =>
    ((closedBall_subset_ball hρ).trans hδy).trans ball_subset_closedBall
  have hBK : MeasurableSet (B ∩ closedBall y (r y)) := hB.inter measurableSet_closedBall
  -- (i)–(ii): for `ρ < δ` the quotient is `Hⁿ(A ∩ B̄_ρ(x)) / Hⁿ(B ∩ B̄_ρ(x))`
  have hT : Tendsto (fun ρ : ℝ => μHE[n] (A ∩ closedBall x ρ) / μHE[n] (B ∩ closedBall x ρ))
      (𝓝[>] 0) (𝓝 1) := by
    refine (hx y hyD (ball_subset_closedBall hxy)).congr' ?_
    filter_upwards [Ioo_mem_nhdsGT hδ] with ρ hρ
    rw [Measure.restrict_apply' hBK, Measure.restrict_apply' hBK]
    congr 2
    · ext z
      exact ⟨fun ⟨hz, _⟩ => hz, fun ⟨hzA, hzx⟩ => ⟨⟨hzA, hzx⟩, hAB hzA, hsmall ρ hρ.2 hzx⟩⟩
    · ext z
      exact ⟨fun ⟨hzx, hzB, _⟩ => ⟨hzB, hzx⟩, fun ⟨hzB, hzx⟩ => ⟨hzx, hzB, hsmall ρ hρ.2 hzx⟩⟩
  -- (iii): `Hⁿ(B ∩ B̄_ρ(x)) ≤ Hⁿ(B ∩ B̄(y, r y)) < ∞` for `ρ < δ`
  have hfinρ : ∀ ρ : ℝ, ρ < δ → μHE[n] (B ∩ closedBall x ρ) ≠ ∞ := fun ρ hρ =>
    ne_top_of_le_ne_top (hfin _ (isCompact_closedBall y (r y)) (hrU y (hDU hyD)))
      (measure_mono (inter_subset_inter_right B (hsmall ρ hρ)))
  -- (iv): `Hⁿ((B \ A) ∩ B̄_ρ(x)) + Hⁿ(A ∩ B̄_ρ(x)) = Hⁿ(B ∩ B̄_ρ(x))`
  have hsplit : ∀ ρ : ℝ, μHE[n] ((B \ A) ∩ closedBall x ρ) + μHE[n] (A ∩ closedBall x ρ) =
      μHE[n] (B ∩ closedBall x ρ) := by
    intro ρ
    rw [← measure_union _ (hA.inter measurableSet_closedBall)]
    · congr 1
      ext z
      constructor
      · rintro (⟨⟨hzB, -⟩, hzx⟩ | ⟨hzA, hzx⟩)
        · exact ⟨hzB, hzx⟩
        · exact ⟨hAB hzA, hzx⟩
      · rintro ⟨hzB, hzx⟩
        by_cases hzA : z ∈ A
        · exact Or.inr ⟨hzA, hzx⟩
        · exact Or.inl ⟨⟨hzB, hzA⟩, hzx⟩
    · rw [Set.disjoint_left]
      rintro z ⟨⟨-, hzA⟩, -⟩ ⟨hzA', -⟩
      exact hzA hzA'
  -- Step 5: the excess estimate
  rcases le_or_gt 1 ε with hε1 | hε1
  · -- (a) `ε ≥ 1`: monotonicity
    refine Eventually.of_forall fun ρ => ?_
    calc μHE[n] ((B \ A) ∩ closedBall x ρ) ≤ μHE[n] (B ∩ closedBall x ρ) :=
          measure_mono (inter_subset_inter_left _ sdiff_subset)
      _ = 1 * μHE[n] (B ∩ closedBall x ρ) := (one_mul _).symm
      _ ≤ ε * μHE[n] (B ∩ closedBall x ρ) := by gcongr
  · -- (b) `ε < 1`: eventually `a / β > 1 − ε`, with `β ≠ ∞`
    have hsub : 1 - ε < 1 := ENNReal.sub_lt_self ENNReal.one_ne_top one_ne_zero hε.ne'
    filter_upwards [hT (isOpen_Ioi.mem_nhds hsub), Ioo_mem_nhdsGT hδ] with ρ hρq hρ
    set β := μHE[n] (B ∩ closedBall x ρ)
    set a := μHE[n] (A ∩ closedBall x ρ)
    set e := μHE[n] ((B \ A) ∩ closedBall x ρ)
    have hβtop : β ≠ ∞ := hfinρ ρ hρ.2
    have hsplitρ : e + a = β := hsplit ρ
    -- `β ≠ 0`, since otherwise `a / β = 0 / 0 = 0 ≤ 1 − ε`
    have hβ0 : β ≠ 0 := by
      intro h0
      have ha0 : a = 0 := nonpos_iff_eq_zero.1 (h0 ▸ hsplitρ ▸ le_add_self)
      have : a / β = 0 := by rw [ha0, ENNReal.zero_div]
      rw [mem_preimage, this, mem_Ioi] at hρq
      exact not_lt_zero hρq
    have hlt : (1 - ε) * β < a :=
      (ENNReal.lt_div_iff_mul_lt (Or.inl hβ0) (Or.inl hβtop)).1 hρq
    -- `e + (1 − ε)β ≤ e + a = β = εβ + (1 − ε)β`, and `(1 − ε)β ≠ ∞`
    have h1 : e + (1 - ε) * β ≤ ε * β + (1 - ε) * β := by
      calc e + (1 - ε) * β ≤ e + a := by gcongr
        _ = β := hsplitρ
        _ = (ε + (1 - ε)) * β := by rw [add_tsub_cancel_of_le hε1.le, one_mul]
        _ = ε * β + (1 - ε) * β := add_mul _ _ _
    exact ENNReal.le_of_add_le_add_right (ENNReal.mul_ne_top (by simp) hβtop) h1

/-- **Upper density theorem for `Hⁿ` off a Borel set of locally finite measure in `U`** (Simon
Ch. 1, Remark 3.7(2); chapter-01.txt lines 705–711).  If `U ⊆ ℝᴾ` is open and `S` is Borel with
`Hⁿ(S ∩ K) < ∞` for every compact `K ⊆ U`, then for `Hⁿ`-a.e. `x ∈ U ∖ S`,
`Hⁿ(S ∩ B̄_ρ(x)) / ρⁿ → 0` as `ρ ↓ 0`.  Countably many balls `B_{r_y}(y)` with
`B̄_{r_y}(y) ⊆ U` cover `U` (Lindelöf); the finite-measure version applies to each piece
`S ∩ B_{r_y}(y)`, and near `x ∈ B_{r_y}(y)` the piece agrees with `S`. -/
theorem Submission.regcomp_atl_local_density_zero : ∀ (P n : ℕ) (U S : Set (Euclid P)), IsOpen U → MeasurableSet S → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (S ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)), x ∈ U → x ∉ S → Tendsto (fun ρ : ℝ => μHE[n] (S ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n) (𝓝[>] 0) (𝓝 0) := by
  intro P n U S hU hS hfin
  -- Step 1, a countable cover of `U` by balls `B(y, r y)` with `B̄(y, r y) ⊆ U`.
  have hr : ∀ x ∈ U, ∃ r : ℝ, 0 < r ∧ closedBall x r ⊆ U := by
    intro x hx
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hU x hx
    exact ⟨ε / 2, half_pos hε, (closedBall_subset_ball (half_lt_self hε)).trans hball⟩
  choose! r hr0 hrU using hr
  obtain ⟨D, hDU, hDc, hcov⟩ := TopologicalSpace.countable_cover_nhdsWithin
    (f := fun y => ball y (r y)) (s := U)
    fun x hx => mem_nhdsWithin_of_mem_nhds (ball_mem_nhds x (hr0 x hx))
  -- Steps 2 and 3, the finite-measure theorem on each piece `S ∩ B(y, r y)`, simultaneously
  -- for the countably many `y ∈ D`.
  have hpiece : ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)), ∀ y ∈ D, x ∉ S ∩ ball y (r y) →
      Tendsto (fun ρ : ℝ => μHE[n] (S ∩ ball y (r y) ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n)
        (𝓝[>] 0) (𝓝 0) := by
    rw [ae_ball_iff hDc]
    intro y hy
    apply Submission.regcomp_atl_upper_density_zero P n _ (hS.inter measurableSet_ball)
    exact ne_top_of_le_ne_top (hfin _ (isCompact_closedBall y (r y)) (hrU y (hDU hy)))
      (measure_mono (inter_subset_inter_right S ball_subset_closedBall))
  -- Step 4, localization: for small `ρ`, `B̄(x, ρ) ⊆ B(y, r y)`, so the piece agrees with `S`.
  filter_upwards [hpiece] with x hx hxU hxS
  obtain ⟨y, hyD, hxy⟩ := mem_iUnion₂.1 (hcov hxU)
  obtain ⟨ε, hε, hεy⟩ := Metric.isOpen_iff.1 isOpen_ball x hxy
  refine (hx y hyD fun h => hxS h.1).congr' ?_
  filter_upwards [Ioo_mem_nhdsGT hε] with ρ hρ
  rw [inter_assoc, inter_eq_right.2 ((closedBall_subset_ball hρ.2).trans hεy)]

/-- **Simon Ch. 3, Remark 1.5(3)** (the upper bound, with `ε = 1`): if `D` has approximate
tangent space `Q` at `x` and `Hⁿ(D ∩ B̄_{r₀}(x)) < ∞`, then `Hⁿ(D ∩ B̄_ρ(x)) ≤ Cρⁿ` for all
small `ρ > 0`.

* Test Definition 1.4 with `φ = max(0, min(1, 2 − |w|)) ∈ C_c`, `1_{B̄₁(0)} ≤ φ ≤ 1_{B̄₂(0)}`:
  `∫_{η_{x,ρ}(D)} φ dHⁿ → Λ := ∫_Q φ dHⁿ`, so for `0 < ρ < r₁` it is `< C := |Λ| + 1`, and
  `2ρ < r₀`.
* By the blow-up scaling, `Hⁿ(η_{x,ρ}(D) ∩ B̄₂(0)) = ρ⁻ⁿHⁿ(D ∩ B̄_{2ρ}(x)) < ∞`, so `φ` is
  integrable on `η_{x,ρ}(D)` and `Hⁿ(η_{x,ρ}(D) ∩ B̄₁(0)) ≤ ∫_{η_{x,ρ}(D)} φ dHⁿ < C`.
* Scaling back, `Hⁿ(D ∩ B̄_ρ(x)) = ρⁿHⁿ(η_{x,ρ}(D) ∩ B̄₁(0)) ≤ Cρⁿ`. -/
theorem Submission.ptd_tl_measure_closedBall_le_of_tangent : ∀ (P n : ℕ) (D : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)) (r₀ : ℝ), MeasurableSet D → 0 < r₀ → μHE[n] (D ∩ closedBall x r₀) ≠ ∞ → HasApproximateTangentSpaceAt n D x Q → ∃ C r₁ : ℝ, 0 < r₁ ∧ ∀ ρ : ℝ, 0 < ρ → ρ < r₁ → μHE[n] (D ∩ closedBall x ρ) ≤ ENNReal.ofReal (C * ρ ^ n) := by
  intro P n D x Q r₀ _ hr₀ hfin hT
  -- Step 1: the cutoff `φ = max(0, min(1, 2 − ‖w‖)) ∈ C_c`, `1_{B̄₁(0)} ≤ φ ≤ 1_{B̄₂(0)}`
  have hout : ∀ w : Euclid P, w ∉ closedBall (0 : Euclid P) 2 → max 0 (min 1 (2 - ‖w‖)) = 0 := by
    intro w hw
    rw [mem_closedBall_zero_iff, not_le] at hw
    exact max_eq_left ((min_le_right _ _).trans (by linarith))
  let φ : CompactlySupportedContinuousMap (Euclid P) ℝ :=
    ⟨⟨fun w => max 0 (min 1 (2 - ‖w‖)), by fun_prop⟩,
      HasCompactSupport.intro (isCompact_closedBall 0 2) hout⟩
  have hφ0 : ∀ w, 0 ≤ φ w := fun w => le_max_left _ _
  have hφ1 : ∀ w, φ w ≤ 1 := fun w => max_le zero_le_one (min_le_left _ _)
  have hφB : ∀ w ∈ closedBall (0 : Euclid P) 1, φ w = 1 := by
    intro w hw
    rw [mem_closedBall_zero_iff] at hw
    show max 0 (min 1 (2 - ‖w‖)) = 1
    rw [min_eq_left (by linarith), max_eq_right zero_le_one]
  -- Step 2: `∫_{η_{x,ρ}(D)} φ dHⁿ → Λ := ∫_Q φ dHⁿ`; choose `r₁` such that
  -- `∫_{η_{x,ρ}(D)} φ dHⁿ < |Λ| + 1` and `ρ < r₀/2` for `0 < ρ < r₁`
  set Λ := ∫ w in (Q : Set (Euclid P)), φ w ∂μHE[n]
  have hC : (0 : ℝ) ≤ |Λ| + 1 := by positivity
  have hev : ∀ᶠ ρ in 𝓝[>] (0 : ℝ),
      (∫ w in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' D, φ w ∂μHE[n]) < |Λ| + 1 ∧
        ρ < r₀ / 2 :=
    ((hT.2 φ).eventually_lt_const ((le_abs_self Λ).trans_lt (lt_add_one _))).and
      (Filter.mem_of_superset (Ioo_mem_nhdsGT (half_pos hr₀)) fun ρ hρ => hρ.2)
  obtain ⟨r₁, hr₁, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1 hev
  refine ⟨|Λ| + 1, r₁, hr₁, fun ρ hρ hρr₁ => ?_⟩
  obtain ⟨hI, hρr₀⟩ := hsub ⟨hρ, hρr₁⟩
  have hρ0 : ENNReal.ofReal ρ ≠ 0 := (ENNReal.ofReal_pos.2 hρ).ne'
  -- the blow-up scaling with `R = 2` and `R = 1`
  have h2 := Submission.ptd_tl_blowUp_measure_scaling P n x ρ 2 D hρ
  have h1 := Submission.ptd_tl_blowUp_measure_scaling P n x ρ 1 D hρ
  rw [mul_one ρ] at h1
  set T := Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' D
  -- Step 3: `Hⁿ(T ∩ B̄₂(0)) = ρ⁻ⁿHⁿ(D ∩ B̄_{2ρ}(x)) < ∞`, as `2ρ < r₀`
  have hTfin : μHE[n] (T ∩ closedBall 0 2) ≠ ∞ := by
    rw [h2]
    refine ENNReal.mul_ne_top (ENNReal.pow_ne_top (ENNReal.inv_ne_top.2 hρ0)) ?_
    refine ne_top_of_le_ne_top hfin (measure_mono (Set.inter_subset_inter_right _ ?_))
    exact closedBall_subset_closedBall (by linarith)
  -- Step 4: `|φ| ≤ 1_{B̄₂(0)}`, which is integrable for `Hⁿ⌞T`; hence so is `φ`
  have hint : Integrable (fun w => φ w) (μHE[n].restrict T) := by
    refine Integrable.mono' (g := (closedBall (0 : Euclid P) 2).indicator fun _ => (1 : ℝ)) ?_
      φ.continuous.aestronglyMeasurable (ae_of_all _ fun w => ?_)
    · rw [integrable_indicator_iff measurableSet_closedBall]
      refine integrableOn_const ?_
      rw [Measure.restrict_apply measurableSet_closedBall, Set.inter_comm]
      exact hTfin
    · by_cases hw : w ∈ closedBall (0 : Euclid P) 2
      · rw [Set.indicator_of_mem hw, Real.norm_of_nonneg (hφ0 w)]
        exact hφ1 w
      · rw [Set.indicator_of_notMem hw, norm_le_zero_iff]
        exact hout w hw
  -- Step 5: `Hⁿ(T ∩ B̄₁(0)) = ∫⁻ 1_{B̄₁(0)} d(Hⁿ⌞T) ≤ ∫⁻ φ d(Hⁿ⌞T) = ∫_T φ dHⁿ < |Λ| + 1`
  have hball : μHE[n] (T ∩ closedBall 0 1) ≤ ENNReal.ofReal (|Λ| + 1) :=
    calc μHE[n] (T ∩ closedBall 0 1)
        = ∫⁻ w, (closedBall (0 : Euclid P) 1).indicator 1 w ∂(μHE[n].restrict T) := by
          rw [lintegral_indicator_one measurableSet_closedBall,
            Measure.restrict_apply measurableSet_closedBall, Set.inter_comm]
      _ ≤ ∫⁻ w, ENNReal.ofReal (φ w) ∂(μHE[n].restrict T) := by
          refine lintegral_mono fun w => ?_
          by_cases hw : w ∈ closedBall (0 : Euclid P) 1
          · rw [Set.indicator_of_mem hw, Pi.one_apply, hφB w hw, ENNReal.ofReal_one]
          · rw [Set.indicator_of_notMem hw]
            exact zero_le
      _ = ENNReal.ofReal (∫ w, φ w ∂(μHE[n].restrict T)) :=
          (ofReal_integral_eq_lintegral_ofReal hint (ae_of_all _ hφ0)).symm
      _ ≤ ENNReal.ofReal (|Λ| + 1) := ENNReal.ofReal_le_ofReal hI.le
  -- Step 6: `Hⁿ(D ∩ B̄_ρ(x)) = ρⁿHⁿ(T ∩ B̄₁(0)) ≤ (|Λ| + 1)ρⁿ`
  calc μHE[n] (D ∩ closedBall x ρ)
      = ENNReal.ofReal ρ ^ n * ((ENNReal.ofReal ρ)⁻¹ ^ n * μHE[n] (D ∩ closedBall x ρ)) := by
        rw [← mul_assoc, ← mul_pow, ENNReal.mul_inv_cancel hρ0 ENNReal.ofReal_ne_top, one_pow,
          one_mul]
    _ = ENNReal.ofReal ρ ^ n * μHE[n] (T ∩ closedBall 0 1) := by rw [h1]
    _ ≤ ENNReal.ofReal ρ ^ n * ENNReal.ofReal (|Λ| + 1) := by gcongr
    _ = ENNReal.ofReal ((|Λ| + 1) * ρ ^ n) := by
        rw [ENNReal.ofReal_mul hC, ENNReal.ofReal_pow hρ.le, mul_comm (ENNReal.ofReal ρ ^ n)]
/-- Zero `n`-density of the excess `B ∖ A` (step 6 of the tangent-locality argument for a piece):
if `Hⁿ(A ∩ B̄_ρ(x)) ≤ Cρⁿ` for `0 < ρ < r₁`, `Hⁿ(B ∩ B̄_{r₀}(x)) < ∞`, and for every `ε > 0`
eventually `Hⁿ((B ∖ A) ∩ B̄_ρ(x)) ≤ ε Hⁿ(B ∩ B̄_ρ(x))`, then `ρ⁻ⁿ Hⁿ((B ∖ A) ∩ B̄_ρ(x)) → 0` as
`ρ ↓ 0`.  With `ε = 1/2`, subadditivity and cancellation of the finite half give
`Hⁿ(B ∩ B̄_ρ(x)) ≤ 2Cρⁿ` for small `ρ`; then `ε = δ/(2C + 1)` gives
`Hⁿ((B ∖ A) ∩ B̄_ρ(x)) ≤ δρⁿ`. -/
theorem Submission.ptd_tl_excess_density_zero : ∀ (P n : ℕ) (A B : Set (Euclid P)) (x : Euclid P) (r₀ C r₁ : ℝ), 0 < r₀ → μHE[n] (B ∩ closedBall x r₀) ≠ ∞ → 0 < r₁ → (∀ ρ : ℝ, 0 < ρ → ρ < r₁ → μHE[n] (A ∩ closedBall x ρ) ≤ ENNReal.ofReal (C * ρ ^ n)) → (∀ ε : ℝ≥0∞, 0 < ε → ∀ᶠ ρ in 𝓝[>] (0 : ℝ), μHE[n] ((B \ A) ∩ closedBall x ρ) ≤ ε * μHE[n] (B ∩ closedBall x ρ)) → Tendsto (fun ρ : ℝ => μHE[n] ((B \ A) ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n) (𝓝[>] 0) (𝓝 0) := by
  intro P n A B x r₀ C r₁ hr₀ hfin hr₁ hG hE
  -- Step 1: for `ρ > 0`, `ofReal (Cρⁿ) = ofReal C · (ofReal ρ)ⁿ`
  have hA : ∀ ρ : ℝ, 0 < ρ → ρ < r₁ →
      μHE[n] (A ∩ closedBall x ρ) ≤ ENNReal.ofReal C * ENNReal.ofReal ρ ^ n := by
    intro ρ hρ hρ₁
    rw [← ENNReal.ofReal_pow hρ.le, ← ENNReal.ofReal_mul' (pow_nonneg hρ.le n)]
    exact hG ρ hρ hρ₁
  -- Step 2: eventually `Hⁿ(B ∩ B̄_ρ(x)) ≤ κ (ofReal ρ)ⁿ` with `κ = 2 ofReal C`
  set κ : ℝ≥0∞ := 2 * ENNReal.ofReal C with hκ
  have hB : ∀ᶠ ρ in 𝓝[>] (0 : ℝ), μHE[n] (B ∩ closedBall x ρ) ≤ κ * ENNReal.ofReal ρ ^ n := by
    filter_upwards [Ioo_mem_nhdsGT (lt_min hr₀ hr₁),
      hE 2⁻¹ (ENNReal.inv_pos.2 ENNReal.ofNat_ne_top)] with ρ hρ he
    have hρ₀ : ρ ≤ r₀ := hρ.2.le.trans (min_le_left _ _)
    have hρ₁ : ρ < r₁ := hρ.2.trans_le (min_le_right _ _)
    have hβ : μHE[n] (B ∩ closedBall x ρ) ≠ ∞ :=
      ne_top_of_le_ne_top hfin
        (measure_mono (inter_subset_inter_right B (closedBall_subset_closedBall hρ₀)))
    -- `B ∩ B̄_ρ(x) ⊆ (A ∩ B̄_ρ(x)) ∪ ((B ∖ A) ∩ B̄_ρ(x))`, so subadditivity applies
    have hsub : μHE[n] (B ∩ closedBall x ρ) ≤
        μHE[n] (A ∩ closedBall x ρ) + μHE[n] ((B \ A) ∩ closedBall x ρ) := by
      refine (measure_mono ?_).trans (measure_union_le _ _)
      rintro y ⟨hyB, hyρ⟩
      by_cases hyA : y ∈ A
      · exact Or.inl ⟨hyA, hyρ⟩
      · exact Or.inr ⟨⟨hyB, hyA⟩, hyρ⟩
    -- `β/2 + β/2 = β ≤ a + e ≤ a + β/2`; cancelling the finite `β/2` gives `β/2 ≤ a`
    have hhalf : μHE[n] (B ∩ closedBall x ρ) / 2 ≤ μHE[n] (A ∩ closedBall x ρ) := by
      refine (ENNReal.add_le_add_iff_right (ENNReal.div_ne_top hβ two_ne_zero)).1 ?_
      rw [ENNReal.add_halves, ENNReal.div_eq_inv_mul]
      exact hsub.trans (add_le_add le_rfl he)
    calc μHE[n] (B ∩ closedBall x ρ)
        = μHE[n] (B ∩ closedBall x ρ) / 2 + μHE[n] (B ∩ closedBall x ρ) / 2 :=
          (ENNReal.add_halves _).symm
      _ ≤ μHE[n] (A ∩ closedBall x ρ) + μHE[n] (A ∩ closedBall x ρ) := add_le_add hhalf hhalf
      _ = 2 * μHE[n] (A ∩ closedBall x ρ) := (two_mul _).symm
      _ ≤ 2 * (ENNReal.ofReal C * ENNReal.ofReal ρ ^ n) := by gcongr; exact hA ρ hρ.1 hρ₁
      _ = κ * ENNReal.ofReal ρ ^ n := by rw [hκ, mul_assoc]
  -- Step 3: for `δ > 0`, `ε = δ/(κ + 1)` gives `Hⁿ((B ∖ A) ∩ B̄_ρ(x)) ≤ δ (ofReal ρ)ⁿ` eventually
  rw [ENNReal.tendsto_nhds_zero]
  intro δ hδ
  have hκ₁ : κ + 1 ≠ ∞ :=
    ENNReal.add_ne_top.2 ⟨ENNReal.mul_ne_top ENNReal.ofNat_ne_top ENNReal.ofReal_ne_top,
      ENNReal.one_ne_top⟩
  have hκ₀ : κ + 1 ≠ 0 := by positivity
  filter_upwards [hB, hE (δ / (κ + 1)) (ENNReal.div_pos hδ.ne' hκ₁)] with ρ hρB hρe
  -- Step 4: hence `Hⁿ((B ∖ A) ∩ B̄_ρ(x)) / (ofReal ρ)ⁿ ≤ δ`
  refine ENNReal.div_le_of_le_mul ?_
  calc μHE[n] ((B \ A) ∩ closedBall x ρ)
      ≤ δ / (κ + 1) * μHE[n] (B ∩ closedBall x ρ) := hρe
    _ ≤ δ / (κ + 1) * ((κ + 1) * ENNReal.ofReal ρ ^ n) := by
        gcongr
        exact hρB.trans (by gcongr; exact le_self_add)
    _ = δ * ENNReal.ofReal ρ ^ n := by rw [← mul_assoc, ENNReal.div_mul_cancel hκ₀ hκ₁]

/-- **Simon Ch. 3, Remark 1.5(2)** (locality of approximate tangent spaces): if `A ⊆ B` are Borel,
`Hⁿ(B ∩ B̄_{r₀}(x)) < ∞` and `Hⁿ((B ∖ A) ∩ B̄_ρ(x)) / ρⁿ → 0` as `ρ ↓ 0`, then `B` and `A` have
the same approximate tangent spaces at `x`.  If `f ∈ C_c` vanishes off `B̄_R(0)` and `|f| ≤ M`,
then for `0 < ρ < r₀/R` the difference `∫_{η_{x,ρ}(B)} f − ∫_{η_{x,ρ}(A)} f = ∫_{η_{x,ρ}(B ∖ A)} f`
is at most `M Hⁿ(η_{x,ρ}(B ∖ A) ∩ B̄_R(0)) = M ρ⁻ⁿ Hⁿ((B ∖ A) ∩ B̄_{ρR}(x))` in absolute value
(by `Submission.ptd_tl_blowUp_measure_scaling`), and this tends to `0`. -/
theorem Submission.ptd_tl_tangent_iff_of_density_zero : ∀ (P n : ℕ) (A B : Set (Euclid P)) (x : Euclid P) (r₀ : ℝ), MeasurableSet A → MeasurableSet B → A ⊆ B → 0 < r₀ → μHE[n] (B ∩ closedBall x r₀) ≠ ∞ → Tendsto (fun ρ : ℝ => μHE[n] ((B \ A) ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n) (𝓝[>] 0) (𝓝 0) → ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q := by
  intro P n A B x r₀ hA hB hAB hr₀ hfin hdens Q
  -- Step 1: for `ρ ≠ 0`, `η_{x,ρ}` is injective and `η_{x,ρ}(S) = (y ↦ x + ρy)⁻¹(S)` is Borel
  have hinj : ∀ ρ : ℝ, ρ ≠ 0 → Injective (Poincare.SimonGMT.Chapter03.blowUpMap x ρ) := by
    intro ρ hρ a b hab
    exact sub_left_injective (smul_right_injective (Euclid P) (inv_ne_zero hρ) hab)
  have hmeas : ∀ ρ : ℝ, ρ ≠ 0 → ∀ S : Set (Euclid P), MeasurableSet S →
      MeasurableSet (Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' S) := by
    intro ρ hρ S hS
    have himage : Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' S =
        (fun y => x + ρ • y) ⁻¹' S := by
      ext y
      constructor
      · rintro ⟨z, hz, rfl⟩
        simpa [Poincare.SimonGMT.Chapter03.blowUpMap, smul_inv_smul₀ hρ] using hz
      · intro hy
        exact ⟨x + ρ • y, hy, by simp [Poincare.SimonGMT.Chapter03.blowUpMap, inv_smul_smul₀ hρ]⟩
    rw [himage]
    exact hS.preimage (by fun_prop)
  -- Step 2: for every `f ∈ C_c`, `Δ_f(ρ) = ∫_{η_{x,ρ}(B)} f − ∫_{η_{x,ρ}(A)} f → 0`
  have key : ∀ f : CompactlySupportedContinuousMap (Euclid P) ℝ,
      Tendsto (fun ρ : ℝ =>
        (∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' B, f y ∂μHE[n]) -
          ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' A, f y ∂μHE[n]) (𝓝[>] 0) (𝓝 0) := by
    intro f
    -- (a): `f` vanishes off `B̄_R(0)` for some `R > 0`, and `|f| ≤ M`
    obtain ⟨R, hRpos, hout⟩ : ∃ R : ℝ, 0 < R ∧
        ∀ y : Euclid P, y ∉ closedBall (0 : Euclid P) R → f y = 0 := by
      obtain ⟨R₀, hR₀⟩ := f.hasCompactSupport.isCompact.isBounded.subset_closedBall 0
      exact ⟨max R₀ 1, lt_of_lt_of_le one_pos (le_max_right _ _), fun y hy =>
        image_eq_zero_of_notMem_tsupport fun hy' =>
          hy (closedBall_subset_closedBall (le_max_left _ _) (hR₀ hy'))⟩
    obtain ⟨M, hM⟩ := f.continuous.bounded_above_of_compact_support f.hasCompactSupport
    -- (b): `f` is integrable on `S` whenever `Hⁿ(S ∩ B̄_R(0)) < ∞`
    have hint : ∀ S : Set (Euclid P), μHE[n] (S ∩ closedBall 0 R) ≠ ∞ →
        IntegrableOn (fun y => f y) S μHE[n] := by
      intro S hS
      refine Integrable.mono' (g := (closedBall (0 : Euclid P) R).indicator fun _ => M) ?_
        f.continuous.aestronglyMeasurable (ae_of_all _ fun y => ?_)
      · rw [integrable_indicator_iff measurableSet_closedBall]
        refine integrableOn_const ?_
        rw [Measure.restrict_apply measurableSet_closedBall, Set.inter_comm]
        exact hS
      · by_cases hy : y ∈ closedBall (0 : Euclid P) R
        · rw [Set.indicator_of_mem hy]
          exact hM y
        · rw [Set.indicator_of_notMem hy, hout y hy, norm_zero]
    -- (c)–(e) give `|Δ_f(ρ)| ≤ M Hⁿ(η_{x,ρ}(B ∖ A) ∩ B̄_R(0))` for `0 < ρ < r₀/R`; (f) sends the
    -- bound to `0`
    refine squeeze_zero_norm' (a := fun ρ : ℝ => M *
      (μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' (B \ A) ∩ closedBall 0 R)).toReal)
      ?_ ?_
    · filter_upwards [Ioo_mem_nhdsGT (div_pos hr₀ hRpos)] with ρ hρ
      have hρ0 : 0 < ρ := hρ.1
      have hρR : ρ * R < r₀ := (lt_div_iff₀ hRpos).1 hρ.2
      -- (c): for `S ⊆ B`, `Hⁿ(η_{x,ρ}(S) ∩ B̄_R(0)) = ρ⁻ⁿ Hⁿ(S ∩ B̄_{ρR}(x)) < ∞`
      have hfinS : ∀ S ⊆ B,
          μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' S ∩ closedBall 0 R) ≠ ∞ := by
        intro S hS
        rw [Submission.ptd_tl_blowUp_measure_scaling P n x ρ R S hρ0]
        exact ENNReal.mul_ne_top
          (ENNReal.pow_ne_top (ENNReal.inv_ne_top.2 (ENNReal.ofReal_pos.2 hρ0).ne'))
          (ne_top_of_le_ne_top hfin
            (measure_mono (inter_subset_inter hS (closedBall_subset_closedBall hρR.le))))
      -- (d): `Δ_f(ρ) = ∫_{η_{x,ρ}(B ∖ A)} f`, as `η_{x,ρ}(B ∖ A) = η_{x,ρ}(B) ∖ η_{x,ρ}(A)`
      have hsplit : (∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' B, f y ∂μHE[n]) -
          ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' A, f y ∂μHE[n] =
          ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' (B \ A), f y ∂μHE[n] := by
        rw [image_sdiff (hinj ρ hρ0.ne'), setIntegral_sdiff (hmeas ρ hρ0.ne' A hA)
          (hint _ (hfinS B subset_rfl)) (image_mono hAB)]
      -- (e): `f = 0` off `B̄_R(0)` and `|f| ≤ M`
      have hball : ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' (B \ A), f y ∂μHE[n] =
          ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' (B \ A) ∩ closedBall 0 R,
            f y ∂μHE[n] :=
        setIntegral_eq_of_subset_of_forall_sdiff_eq_zero (hmeas ρ hρ0.ne' _ (hB.diff hA))
          inter_subset_left fun y hy => hout y fun h => hy.2 ⟨hy.1, h⟩
      rw [hsplit, hball]
      exact norm_setIntegral_le_of_norm_le_const (lt_top_iff_ne_top.2 (hfinS _ sdiff_subset))
        fun y _ => hM y
    -- (f): `Hⁿ(η_{x,ρ}(B ∖ A) ∩ B̄_R(0)) = Rⁿ Hⁿ((B ∖ A) ∩ B̄_{ρR}(x)) / (ρR)ⁿ → 0`, by (†)
    -- along `ρ ↦ ρR`
    have hlin : Tendsto (fun ρ : ℝ => ρ * R) (𝓝[>] 0) (𝓝[>] 0) := by
      refine tendsto_nhdsWithin_iff.2 ⟨?_, ?_⟩
      · exact ((continuous_mul_const R).tendsto' 0 0 (zero_mul R)).mono_left nhdsWithin_le_nhds
      · filter_upwards [self_mem_nhdsWithin] with ρ (hρ : 0 < ρ)
        exact mul_pos hρ hRpos
    have hsmall : Tendsto (fun ρ : ℝ =>
        μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' (B \ A) ∩ closedBall 0 R))
        (𝓝[>] 0) (𝓝 0) := by
      have h := ENNReal.Tendsto.const_mul (hdens.comp hlin)
        (Or.inr (ENNReal.pow_ne_top ENNReal.ofReal_ne_top) :
          (0 : ℝ≥0∞) ≠ 0 ∨ ENNReal.ofReal R ^ n ≠ ∞)
      rw [mul_zero] at h
      refine h.congr' ?_
      filter_upwards [self_mem_nhdsWithin] with ρ (hρ : 0 < ρ)
      have hβ : ENNReal.ofReal R ^ n * (ENNReal.ofReal R ^ n)⁻¹ = 1 :=
        ENNReal.mul_inv_cancel (pow_ne_zero n (ENNReal.ofReal_pos.2 hRpos).ne')
          (ENNReal.pow_ne_top ENNReal.ofReal_ne_top)
      simp only [Function.comp_apply]
      rw [Submission.ptd_tl_blowUp_measure_scaling P n x ρ R (B \ A) hρ,
        ENNReal.ofReal_mul hρ.le, mul_pow, ← ENNReal.inv_pow, div_eq_mul_inv,
        ENNReal.mul_inv (Or.inl (pow_ne_zero n (ENNReal.ofReal_pos.2 hρ).ne'))
          (Or.inl (ENNReal.pow_ne_top ENNReal.ofReal_ne_top))]
      calc ENNReal.ofReal R ^ n * (μHE[n] ((B \ A) ∩ closedBall x (ρ * R)) *
            ((ENNReal.ofReal ρ ^ n)⁻¹ * (ENNReal.ofReal R ^ n)⁻¹))
          = ENNReal.ofReal R ^ n * (ENNReal.ofReal R ^ n)⁻¹ *
            ((ENNReal.ofReal ρ ^ n)⁻¹ * μHE[n] ((B \ A) ∩ closedBall x (ρ * R))) := by ring
        _ = (ENNReal.ofReal ρ ^ n)⁻¹ * μHE[n] ((B \ A) ∩ closedBall x (ρ * R)) := by
          rw [hβ, one_mul]
    have h := ((ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp hsmall).const_mul M
    rwa [ENNReal.toReal_zero, mul_zero] at h
  -- Steps 3–4: transfer the limits of Definition 1.4 in both directions; `finrank Q = n` is shared
  constructor
  · rintro ⟨hdim, hconv⟩
    refine ⟨hdim, fun f => ?_⟩
    have h := (hconv f).sub (key f)
    rw [sub_zero] at h
    exact h.congr fun ρ => sub_sub_cancel _ _
  · rintro ⟨hdim, hconv⟩
    refine ⟨hdim, fun f => ?_⟩
    have h := (hconv f).add (key f)
    rw [add_zero] at h
    exact h.congr fun ρ => add_sub_cancel _ _

/-- **Simon Ch. 3, Remarks 1.5(2)–(3) and the proof of Theorem 1.6 "⇒"**: let `U` be open,
`A ⊆ B ⊆ U` Borel, and `Hⁿ(B ∩ K) < ∞` for every compact `K ⊆ U`.  Then for `Hⁿ⌞A`-a.e. `x`,
simultaneously for every subspace `Q`, `B` has approximate tangent space `Q` at `x` iff `A` does.

* Off one `Hⁿ⌞A`-null set, independent of `Q`, `x ∈ A` and for every `ε > 0`,
  `Hⁿ((B \ A) ∩ B̄_ρ(x)) ≤ ε Hⁿ(B ∩ B̄_ρ(x))` for all small `ρ > 0` (Besicovitch).
* `B̄_{s/2}(x) ⊆ B_s(x) ⊆ U` is compact, so `Hⁿ(B ∩ B̄_{s/2}(x)) < ∞`.
* A tangent plane of `B` or of `A` at `x` gives `Hⁿ(A ∩ B̄_ρ(x)) ≤ Cρⁿ` for small `ρ` (via
  `A ⊆ B` in the first case), hence `Hⁿ((B \ A) ∩ B̄_ρ(x)) = o(ρⁿ)`, and then the blow-up integrals
  of `B` and `A` have the same limits. -/
theorem Submission.ptd_ae_approxTangent_iff_of_subset : ∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q := by
  intro P n U A B hU hA hB hAB hBU hfin
  -- Steps 2–4: off one `Hⁿ⌞A`-null set, chosen before `Q`, `x ∈ A` and the excess of `B` over
  -- `A` near `x` is eventually small relative to `Hⁿ(B ∩ B̄_ρ(x))`
  filter_upwards [Submission.ptd_tl_ae_excess_le P n U A B hU hA hB hAB hBU hfin,
    ae_restrict_mem hA] with x hexc hxA Q
  -- a compact ball `B̄_{s/2}(x) ⊆ B_s(x) ⊆ U`, so `Hⁿ(B ∩ B̄_{s/2}(x)) < ∞`
  obtain ⟨s, hs, hsU⟩ := Metric.isOpen_iff.1 hU x (hBU (hAB hxA))
  have hr₀ : 0 < s / 2 := half_pos hs
  have hBfin : μHE[n] (B ∩ closedBall x (s / 2)) ≠ ∞ :=
    hfin _ (isCompact_closedBall x (s / 2)) ((closedBall_subset_ball (half_lt_self hs)).trans hsU)
  have hAB_le : ∀ ρ : ℝ, μHE[n] (A ∩ closedBall x ρ) ≤ μHE[n] (B ∩ closedBall x ρ) :=
    fun ρ => measure_mono (inter_subset_inter_left _ hAB)
  -- Steps 6–7: a growth bound `Hⁿ(A ∩ B̄_ρ(x)) ≤ Cρⁿ` makes the excess `o(ρⁿ)`, which forces
  -- the same approximate tangent spaces
  have hiff : ∀ C r₁ : ℝ, 0 < r₁ →
      (∀ ρ : ℝ, 0 < ρ → ρ < r₁ → μHE[n] (A ∩ closedBall x ρ) ≤ ENNReal.ofReal (C * ρ ^ n)) →
      (HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q) :=
    fun C r₁ hr₁ hgrowth =>
      Submission.ptd_tl_tangent_iff_of_density_zero P n A B x (s / 2) hA hB hAB hr₀ hBfin
        (Submission.ptd_tl_excess_density_zero P n A B x (s / 2) C r₁ hr₀ hBfin hr₁ hgrowth
          hexc) Q
  -- Step 8: step 5 turns the assumed tangent plane into the growth bound
  constructor
  · -- the growth bound for `B` passes to `A ⊆ B`
    intro hTB
    obtain ⟨C, r₁, hr₁, hgrowth⟩ :=
      Submission.ptd_tl_measure_closedBall_le_of_tangent P n B x Q (s / 2) hB hr₀ hBfin hTB
    exact (hiff C r₁ hr₁ fun ρ hρ hρr₁ => (hAB_le ρ).trans (hgrowth ρ hρ hρr₁)).1 hTB
  · intro hTA
    obtain ⟨C, r₁, hr₁, hgrowth⟩ :=
      Submission.ptd_tl_measure_closedBall_le_of_tangent P n A x Q (s / 2) hA hr₀
        (ne_top_of_le_ne_top hBfin (hAB_le (s / 2))) hTA
    exact (hiff C r₁ hr₁ hgrowth).2 hTA
/-- Borel image and null-set pullback along a bi-Lipschitz piece: if `F : ℝⁿ → ℝᴾ` is Lipschitz,
`B ⊆ ℝⁿ` is Borel and `m‖a − a'‖ ≤ ‖F a − F a'‖` on `B` (`m > 0`), then `F(B)` is Borel
(Lusin–Souslin), and a property holding `Hⁿ⌞F(B)`-a.e. holds at `F b` for Lebesgue-a.e. `b ∈ B`:
`invFunOn F B` is `m⁻¹`-Lipschitz on `F(B)` (Simon Ch. 2, 1.8(i)) and maps the `Hⁿ`-null bad
image set onto a superset of the bad parameters, and `Hⁿ` is Lebesgue measure on `ℝⁿ`. -/
theorem Submission.ptd_piece_image_measurable_ae_pullback : ∀ (P n : ℕ) (F : Euclid n → Euclid P) (B : Set (Euclid n)) (L : NNReal) (m : ℝ), LipschitzWith L F → MeasurableSet B → 0 < m → (∀ a ∈ B, ∀ a' ∈ B, m * ‖a - a'‖ ≤ ‖F a - F a'‖) → MeasurableSet (F '' B) ∧ ∀ p : Euclid P → Prop, (∀ᵐ y ∂(μHE[n].restrict (F '' B)), p y) → ∀ᵐ b ∂(volume.restrict B), p (F b) := by
  intro P n F B L m hF hB hm hlow
  -- Step 1: the lower bound makes `F` injective on `B`
  have hinj : InjOn F B := fun a ha a' ha' h => by
    have hle := hlow a ha a' ha'
    rw [h, sub_self, norm_zero] at hle
    exact sub_eq_zero.1 (norm_le_zero_iff.1 (nonpos_of_mul_nonpos_right hle hm))
  -- Step 2: Lusin–Souslin
  have hFB : MeasurableSet (F '' B) := hB.image_of_continuousOn_injOn hF.continuous.continuousOn hinj
  refine ⟨hFB, fun p hp => ?_⟩
  -- Step 3: `G = invFunOn F B` is `m⁻¹`-Lipschitz on `F '' B`
  have hG : LipschitzOnWith (Real.toNNReal m⁻¹) (invFunOn F B) (F '' B) := by
    refine LipschitzOnWith.of_dist_le' ?_
    rintro _ ⟨a, ha, rfl⟩ _ ⟨a', ha', rfl⟩
    rw [hinj.leftInvOn_invFunOn ha, hinj.leftInvOn_invFunOn ha', dist_eq_norm, dist_eq_norm,
      inv_mul_eq_div, le_div_iff₀' hm]
    exact hlow a ha a' ha'
  -- Step 4: the bad parameters lie in the `G`-image of the `Hⁿ`-null bad image set
  rw [ae_restrict_iff' hFB, ae_iff] at hp
  rw [ae_restrict_iff' hB, ae_iff, ← EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
  have hnull : μHE[n] (invFunOn F B '' {y | ¬(y ∈ F '' B → p y)}) = 0 := by
    refine le_zero_iff.1 ?_
    calc μHE[n] (invFunOn F B '' {y | ¬(y ∈ F '' B → p y)})
        ≤ (Real.toNNReal m⁻¹ : ℝ≥0∞) ^ n * μHE[n] {y | ¬(y ∈ F '' B → p y)} :=
          Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
            (hG.mono fun y hy => (not_imp.1 hy).1)
      _ = 0 := by rw [hp, mul_zero]
  refine measure_mono_null (fun b hb => ?_) hnull
  obtain ⟨hbB, hpb⟩ := not_imp.1 (show ¬(b ∈ B → p (F b)) from hb)
  exact ⟨F b, show ¬(F b ∈ F '' B → p (F b)) from not_imp.2 ⟨mem_image_of_mem F hbB, hpb⟩,
    hinj.leftInvOn_invFunOn hbB⟩
/-- **Simon Ch. 3, 1.4** (change of variables under the blow-up `η_{x,r}`): for `r > 0`, every
set `M` and every `f`, `∫_{η_{x,r}(M)} f dHⁿ = r⁻ⁿ ∫_M f(η_{x,r}(y)) dHⁿ(y)`.
`η_{x,r} = (r⁻¹ • ·) ∘ (· − x)` is a homeomorphism with `Hⁿ(η_{x,r}(S)) = r⁻ⁿ Hⁿ(S)` for every
`S` (translation is an isometry), so `Hⁿ⌞η_{x,r}(M) = r⁻ⁿ η_{x,r#}(Hⁿ⌞M)`. -/
theorem Submission.pit_setIntegral_blowUpMap_image : ∀ (P n : ℕ) (M : Set (Euclid P)) (x : Euclid P) (r : ℝ), 0 < r → ∀ f : Euclid P → ℝ, ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, f y ∂μHE[n] = r⁻¹ ^ n * ∫ y in M, f (Poincare.SimonGMT.Chapter03.blowUpMap x r y) ∂μHE[n] := by
  intro P n M x r hr f
  -- `η_{x,r} = (r⁻¹ • ·) ∘ (· - x)` is a homeomorphism
  obtain ⟨e, he⟩ : ∃ e : Euclid P ≃ₜ Euclid P,
      ⇑e = Poincare.SimonGMT.Chapter03.blowUpMap x r :=
    ⟨(Homeomorph.subRight x).trans (Homeomorph.smulOfNeZero r⁻¹ (inv_ne_zero hr.ne')), rfl⟩
  -- `Hⁿ(η_{x,r}(S)) = ‖r⁻¹‖₊ⁿ Hⁿ(S)` for every set `S`
  have hscale : ∀ S : Set (Euclid P), μHE[n] (e '' S) = ‖r⁻¹‖₊ ^ n • μHE[n] S := by
    intro S
    have hS : e '' S = (fun y => r⁻¹ • y) '' ((IsometryEquiv.subRight x) '' S) := by
      rw [image_image, he]
      rfl
    rw [hS, image_smul, Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hr.ne'),
      (IsometryEquiv.subRight x).isometry.euclideanHausdorffMeasure_image]
  -- `Hⁿ⌞η_{x,r}(M) = ‖r⁻¹‖₊ⁿ η_{x,r#}(Hⁿ⌞M)`, checked on Borel sets
  have hmeas : μHE[n].restrict (e '' M) = (‖r⁻¹‖₊ ^ n) • (μHE[n].restrict M).map e := by
    ext A hA
    rw [Measure.restrict_apply hA, Measure.smul_apply, Measure.map_apply e.measurable hA,
      Measure.restrict_apply (hA.preimage e.measurable), ← hscale, image_inter e.injective,
      e.image_preimage]
  -- change of variables, with `‖r⁻¹‖₊ⁿ = r⁻¹ ^ n`
  rw [← he, hmeas, integral_smul_nnreal_measure, e.measurableEmbedding.integral_map,
    NNReal.smul_def, smul_eq_mul, NNReal.coe_pow, coe_nnnorm, Real.norm_eq_abs,
    abs_of_pos (inv_pos.2 hr)]

/-- **Rescaled area formula** (Jacobian kept abstract): if `F` is continuous, `B` and `J ≥ 0` are
Borel and `∫⁻_{F(B)} g dHⁿ = ∫⁻_B J(x) g(F(x)) dλ(x)` for every `g ≥ 0`, then for `r > 0` and
continuous `f`,
`∫_{η_{F(b),r}(F(B))} f dHⁿ = ∫ 1_B(b + rc) J(b + rc) f(r⁻¹(F(b + rc) − F(b))) dλ(c)`.
The area hypothesis says `Hⁿ⌞F(B) = F_#ν` with `ν = J λ⌞B`, which transports every integral;
the substitution `a = b + rc` produces the factor `rⁿ` that cancels the `r⁻ⁿ` of the blow-up. -/
theorem Submission.pit_blowUp_image_setIntegral_eq_rescaled : ∀ (P n : ℕ) (F : Euclid n → Euclid P) (B : Set (Euclid n)) (J : Euclid n → ℝ) (b : Euclid n) (r : ℝ) (f : Euclid P → ℝ), Continuous F → MeasurableSet B → Measurable J → (∀ a, 0 ≤ J a) → (∀ g : Euclid P → ℝ≥0∞, ∫⁻ y in F '' B, g y ∂μHE[n] = ∫⁻ x in B, ENNReal.ofReal (J x) * g (F x) ∂volume) → 0 < r → Continuous f → ∫ z in Poincare.SimonGMT.Chapter03.blowUpMap (F b) r '' (F '' B), f z ∂μHE[n] = ∫ c, B.indicator J (b + r • c) * f (r⁻¹ • (F (b + r • c) - F b)) ∂volume := by
  intro P n F B J b r f hF hB hJ hJ0 harea hr hf
  -- blow-up scaling: `∫_{η(F(B))} f dHⁿ = r⁻ⁿ ∫_{F(B)} f ∘ η dHⁿ`, `η = η_{F(b),r}`
  rw [Submission.pit_setIntegral_blowUpMap_image P n (F '' B) (F b) r hr f]
  -- `Hⁿ⌞F(B) = F_#ν`: the area hypothesis with `g = 1_T` for every Borel `T`
  have hmeas : μHE[n].restrict (F '' B) =
      Measure.map F ((volume.restrict B).withDensity fun x => ENNReal.ofReal (J x)) := by
    ext T hT
    have h := harea (T.indicator 1)
    rw [lintegral_indicator_one hT] at h
    rw [h, Measure.map_apply hF.measurable hT, withDensity_apply _ (hT.preimage hF.measurable),
      ← lintegral_indicator (hT.preimage hF.measurable)]
    congr 1
    funext x
    by_cases hx : F x ∈ T <;> simp [hx]
  -- `∫_{F(B)} f ∘ η dHⁿ = ∫ 1_B J (f ∘ η ∘ F) dλ`, with no integrability needed
  have hη : Continuous fun z => f (Poincare.SimonGMT.Chapter03.blowUpMap (F b) r z) := by
    unfold Poincare.SimonGMT.Chapter03.blowUpMap
    fun_prop
  have hpull : ∫ y in F '' B, f (Poincare.SimonGMT.Chapter03.blowUpMap (F b) r y) ∂μHE[n] =
      ∫ x, B.indicator J x * f (r⁻¹ • (F x - F b)) ∂volume := by
    rw [hmeas, integral_map hF.aemeasurable hη.aestronglyMeasurable]
    have h := integral_withDensity_eq_integral_smul (μ := volume.restrict B) hJ.real_toNNReal
      (fun x => f (Poincare.SimonGMT.Chapter03.blowUpMap (F b) r (F x)))
    simp only [ENNReal.ofReal]
    rw [h, ← integral_indicator hB]
    congr 1
    funext x
    by_cases hx : x ∈ B
    · simp [hx, NNReal.smul_def, hJ0 x, Poincare.SimonGMT.Chapter03.blowUpMap]
    · simp [hx]
  rw [hpull]
  -- substitution `a = b + rc`: `∫ G(b + rc) dλ(c) = r⁻ⁿ ∫ G dλ`
  set G : Euclid n → ℝ := fun x => B.indicator J x * f (r⁻¹ • (F x - F b))
  have hsubst : ∫ c, G (b + r • c) ∂volume = r⁻¹ ^ n * ∫ a, G a ∂volume := by
    rw [Measure.integral_comp_smul volume (fun x => G (b + x)) r,
      integral_add_left_eq_self (fun x => G x) b, finrank_euclideanSpace_fin, smul_eq_mul,
      ← inv_pow, abs_of_pos (pow_pos (inv_pos.2 hr) n)]
  exact hsubst.symm
/-- Co-Lipschitz bounds pass to the derivative at density points: if `m > 0`,
`m‖a − b‖ ≤ ‖F(a) − F(b)‖` for every `a ∈ B` (`B` arbitrary), `F` is differentiable at `b` and
`λ(B ∩ B̄_ρ(b)) / λ(B̄_ρ(b)) → 1` as `ρ ↓ 0`, then `m‖c‖ ≤ ‖DF(b)c‖` for every `c`.
For small `r > 0` the ball `B_{rδ}(b + rc)`, a fixed fraction `(δ / (‖c‖ + δ))ⁿ` of
`B̄_{r(‖c‖+δ)}(b)`, must meet `B`; the bound at such a point and differentiability give
`m‖c‖ ≤ ‖DF(b)c‖ + δ(m + ‖DF(b)‖ + ‖c‖ + δ)`, and `δ ↓ 0`. -/
theorem Submission.pit_fderiv_lower_bound_of_density : ∀ (P n : ℕ) (F : Euclid n → Euclid P) (B : Set (Euclid n)) (m : ℝ) (b : Euclid n), 0 < m → (∀ a ∈ B, m * ‖a - b‖ ≤ ‖F a - F b‖) → DifferentiableAt ℝ F b → Tendsto (fun ρ : ℝ => volume (B ∩ closedBall b ρ) / volume (closedBall b ρ)) (𝓝[>] 0) (𝓝 1) → ∀ c : Euclid n, m * ‖c‖ ≤ ‖fderiv ℝ F b c‖ := by
  intro P n F B m b hm hB hF hdens c
  set L := fderiv ℝ F b with hL
  have hFL : HasFDerivAt F L b := hF.hasFDerivAt
  -- main estimate: for every `δ > 0`, `m‖c‖ ≤ ‖Lc‖ + δ (m + ‖L‖ + ‖c‖ + δ)`
  have key : ∀ δ : ℝ, 0 < δ → m * ‖c‖ ≤ ‖L c‖ + δ * (m + ‖L‖ + ‖c‖ + δ) := by
    intro δ hδ
    have hK : 0 < ‖c‖ + δ := by positivity
    -- differentiability: `‖F a - F b - L (a - b)‖ ≤ δ ‖a - b‖` near `b`
    obtain ⟨ε, hε, hεF⟩ := Metric.eventually_nhds_iff.1 (hFL.isLittleO.bound hδ)
    -- density: the ratio exceeds `1 - q`, `q = (δ / (‖c‖ + δ)) ^ n`, on some `(0, ρ₀)`
    obtain ⟨q, hq_def⟩ : ∃ q : ℝ≥0∞, q = ENNReal.ofReal ((δ / (‖c‖ + δ)) ^ n) := ⟨_, rfl⟩
    have hq : q ≠ 0 := by
      rw [hq_def, Ne, ENNReal.ofReal_eq_zero, not_le]
      positivity
    have hlt : 1 - q < 1 := ENNReal.sub_lt_self ENNReal.one_ne_top one_ne_zero hq
    obtain ⟨ρ₀, hρ₀, hρ₀sub⟩ :=
      mem_nhdsGT_iff_exists_Ioo_subset.1 (hdens.eventually_const_lt hlt)
    have hρ₀' : 0 < ρ₀ := hρ₀
    -- the radius `ρ = r (‖c‖ + δ)`
    obtain ⟨ρ, hρ, hρε, hρρ₀⟩ : ∃ ρ : ℝ, 0 < ρ ∧ ρ < ε ∧ ρ < ρ₀ :=
      ⟨min ε ρ₀ / 2, by positivity, by linarith [min_le_left ε ρ₀, lt_min hε hρ₀'],
        by linarith [min_le_right ε ρ₀, lt_min hε hρ₀']⟩
    obtain ⟨r, hr_def⟩ : ∃ r : ℝ, r = ρ / (‖c‖ + δ) := ⟨_, rfl⟩
    have hr : 0 < r := by rw [hr_def]; positivity
    have hrK : r * (‖c‖ + δ) = ρ := by rw [hr_def]; field_simp
    -- some point of `B` lies in `B_{rδ}(b + r c)`, else the ratio at `ρ` is `≤ 1 - q`
    obtain ⟨a, haB, ha⟩ : ∃ a ∈ B, ‖a - (b + r • c)‖ < r * δ := by
      by_contra! hcon
      have hsub : ball (b + r • c) (r * δ) ⊆ closedBall b ρ := by
        intro x hx
        rw [mem_ball, dist_eq_norm] at hx
        rw [mem_closedBall, dist_eq_norm]
        calc ‖x - b‖ = ‖(x - (b + r • c)) + r • c‖ := by congr 1; abel
          _ ≤ ‖x - (b + r • c)‖ + ‖r • c‖ := norm_add_le _ _
          _ = ‖x - (b + r • c)‖ + r * ‖c‖ := by rw [norm_smul, Real.norm_of_nonneg hr.le]
          _ ≤ ρ := by rw [← hrK]; linarith
      have hBsub : B ∩ closedBall b ρ ⊆ closedBall b ρ \ ball (b + r • c) (r * δ) := by
        rintro x ⟨hxB, hx⟩
        refine ⟨hx, fun hxW => ?_⟩
        rw [mem_ball, dist_eq_norm] at hxW
        exact (hcon x hxB).not_gt hxW
      have hVfin : volume (closedBall b ρ) ≠ ∞ := measure_closedBall_lt_top.ne
      have hball : volume (ball (b + r • c) (r * δ)) = q * volume (closedBall b ρ) := by
        rw [Measure.addHaar_ball_of_pos volume _ (mul_pos hr hδ),
          Measure.addHaar_closedBall volume _ hρ.le, finrank_euclideanSpace_fin, ← mul_assoc,
          hq_def, ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ (δ / (‖c‖ + δ)) ^ n), ← mul_pow,
          ← hrK]
        congr 3
        field_simp
      have hle : volume (B ∩ closedBall b ρ) ≤ (1 - q) * volume (closedBall b ρ) := by
        calc volume (B ∩ closedBall b ρ)
            ≤ volume (closedBall b ρ \ ball (b + r • c) (r * δ)) := measure_mono hBsub
          _ = volume (closedBall b ρ) - volume (ball (b + r • c) (r * δ)) :=
            measure_sdiff hsub measurableSet_ball.nullMeasurableSet measure_ball_lt_top.ne
          _ = (1 - q) * volume (closedBall b ρ) := by
            rw [hball, ENNReal.sub_mul (fun _ _ => hVfin), one_mul]
      have hgt : 1 - q < volume (B ∩ closedBall b ρ) / volume (closedBall b ρ) :=
        hρ₀sub ⟨hρ, hρρ₀⟩
      exact lt_irrefl _ (hgt.trans_le (ENNReal.div_le_of_le_mul hle))
    -- the estimate at `a`, with `a - b = r c + e`, `‖e‖ < r δ`
    obtain ⟨e, he_def⟩ : ∃ e : Euclid n, e = a - (b + r • c) := ⟨_, rfl⟩
    rw [← he_def] at ha
    have hab : a - b = r • c + e := by rw [he_def]; abel
    have hab_le : ‖a - b‖ ≤ r * ‖c‖ + ‖e‖ := by
      rw [hab]
      refine (norm_add_le _ _).trans ?_
      rw [norm_smul, Real.norm_of_nonneg hr.le]
    have hab_lt : ‖a - b‖ < r * (‖c‖ + δ) := by rw [mul_add]; linarith
    have hdist : dist a b < ε := by rw [dist_eq_norm]; linarith
    have h1 : m * ‖a - b‖ ≤ ‖F a - F b‖ := hB a haB
    have h2 : ‖F a - F b‖ ≤ ‖L (a - b)‖ + δ * ‖a - b‖ := by
      have h := hεF hdist
      have h' := norm_sub_norm_le (F a - F b) (L (a - b))
      linarith
    have h3 : ‖L (a - b)‖ ≤ r * ‖L c‖ + ‖L‖ * ‖e‖ := by
      rw [hab, map_add, map_smul]
      refine (norm_add_le _ _).trans ?_
      rw [norm_smul, Real.norm_of_nonneg hr.le]
      linarith [L.le_opNorm e]
    have h4 : r * ‖c‖ ≤ ‖a - b‖ + ‖e‖ := by
      have : r • c = (a - b) - e := by rw [hab]; abel
      calc r * ‖c‖ = ‖r • c‖ := by rw [norm_smul, Real.norm_of_nonneg hr.le]
        _ = ‖(a - b) - e‖ := by rw [this]
        _ ≤ ‖a - b‖ + ‖e‖ := norm_sub_le _ _
    have h5 : ‖L‖ * ‖e‖ ≤ ‖L‖ * (r * δ) := mul_le_mul_of_nonneg_left ha.le (norm_nonneg _)
    have h6 : m * ‖e‖ ≤ m * (r * δ) := mul_le_mul_of_nonneg_left ha.le hm.le
    have h7 : δ * ‖a - b‖ ≤ δ * (r * (‖c‖ + δ)) := mul_le_mul_of_nonneg_left hab_lt.le hδ.le
    have h8 : m * (r * ‖c‖) ≤ m * (‖a - b‖ + ‖e‖) := mul_le_mul_of_nonneg_left h4 hm.le
    have hfin : r * (m * ‖c‖) ≤ r * (‖L c‖ + δ * (m + ‖L‖ + ‖c‖ + δ)) := by
      linarith
    exact le_of_mul_le_mul_left hfin hr
  -- let `δ → 0⁺`
  have hlim : Tendsto (fun δ : ℝ => ‖L c‖ + δ * (m + ‖L‖ + ‖c‖ + δ)) (𝓝[>] 0) (𝓝 ‖L c‖) := by
    have hcont : Continuous (fun δ : ℝ => ‖L c‖ + δ * (m + ‖L‖ + ‖c‖ + δ)) := by fun_prop
    simpa using (hcont.tendsto 0).mono_left nhdsWithin_le_nhds
  exact ge_of_tendsto hlim (eventually_nhdsWithin_of_forall fun δ hδ => key δ hδ)
/-- If `F` has derivative `L` at `b` and `f` is continuous with compact support, then
`∫_{B̄_R(0)} |f(r⁻¹(F(b + rc) − F(b))) − f(Lc)| dc → 0` as `r ↓ 0` (the error term `T₃` in the
limit of rescaled integrals over the image of a `C¹` piece; cf. the tangent-plane limit in Simon
Ch. 3, proof of 1.6 "⇒").  With `V = |B̄_R(0)|` and `S = |R| + 1`, take `η` from the uniform
continuity of `f` for `ε / (V + 1)`, then `δ₀` with `‖F(b + k) − F(b) − Lk‖ ≤ (η / 2S)‖k‖` for
`‖k‖ < δ₀`; for `0 < r < δ₀ / S` the integrand is `≤ ε / (V + 1)` on the ball. -/
theorem Submission.pit_ril_diffQuot_integral_tendsto : ∀ (P n : ℕ) (F : Euclid n → Euclid P) (L : Euclid n →L[ℝ] Euclid P) (b : Euclid n) (f : Euclid P → ℝ) (R : ℝ), HasFDerivAt F L b → Continuous f → HasCompactSupport f → Tendsto (fun r : ℝ => ∫ c in closedBall (0 : Euclid n) R, ‖f (r⁻¹ • (F (b + r • c) - F b)) - f (L c)‖ ∂volume) (𝓝[>] 0) (𝓝 0) := by
  intro P n F L b f R hF hfc hfs
  -- `D = B̄_R(0)` has finite measure `V`, and `‖c‖ < S = |R| + 1` on `D`
  have hDfin : (volume : Measure (Euclid n)) (closedBall 0 R) < ∞ := measure_closedBall_lt_top
  set V : ℝ := (volume : Measure (Euclid n)).real (closedBall 0 R)
  have hV : 0 ≤ V := measureReal_nonneg
  set S : ℝ := |R| + 1
  have hS : 0 < S := by positivity
  have hcS : ∀ c ∈ closedBall (0 : Euclid n) R, ‖c‖ < S := fun c hc =>
    ((mem_closedBall_zero_iff.1 hc).trans (le_abs_self R)).trans_lt (lt_add_one _)
  -- uniform continuity of `f` and the little-o form of `HasFDerivAt`
  have huc := Metric.uniformContinuous_iff.1 (hfs.uniformContinuous_of_continuous hfc)
  have hlo := hasFDerivAt_iff_isLittleO_nhds_zero.1 hF
  rw [Metric.tendsto_nhdsWithin_nhds]
  intro ε hε
  have hV1 : 0 < V + 1 := by linarith
  set ε₁ : ℝ := ε / (V + 1) with hε₁_def
  have hε₁ : 0 < ε₁ := div_pos hε hV1
  obtain ⟨η, hη, hηf⟩ := huc ε₁ hε₁
  set θ : ℝ := η / (2 * S) with hθ_def
  have hθ : 0 < θ := div_pos hη (by linarith)
  obtain ⟨δ₀, hδ₀, hδ₀F⟩ := Metric.eventually_nhds_iff.1 (hlo.bound hθ)
  refine ⟨δ₀ / S, div_pos hδ₀ hS, fun r hr hrδ => ?_⟩
  rw [mem_Ioi] at hr
  rw [Real.dist_eq, sub_zero, abs_of_pos hr] at hrδ
  have hrS : r * S < δ₀ := (lt_div_iff₀ hS).1 hrδ
  -- pointwise bound on the integrand
  have hpt : ∀ c ∈ closedBall (0 : Euclid n) R,
      ‖‖f (r⁻¹ • (F (b + r • c) - F b)) - f (L c)‖‖ ≤ ε₁ := by
    intro c hc
    have hc' := hcS c hc
    have hnorm : ‖r • c‖ = r * ‖c‖ := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hr]
    have hrc : dist (r • c) 0 < δ₀ := by
      rw [dist_zero_right, hnorm]
      calc r * ‖c‖ ≤ r * S := mul_le_mul_of_nonneg_left hc'.le hr.le
        _ < δ₀ := hrS
    have hbound := hδ₀F hrc
    have heq : r⁻¹ • (F (b + r • c) - F b) - L c
        = r⁻¹ • (F (b + r • c) - F b - L (r • c)) := by
      rw [map_smul, smul_sub _ (F (b + r • c) - F b), inv_smul_smul₀ hr.ne']
    have hclose : dist (r⁻¹ • (F (b + r • c) - F b)) (L c) < η := by
      rw [dist_eq_norm, heq, norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hr]
      calc r⁻¹ * ‖F (b + r • c) - F b - L (r • c)‖
          ≤ r⁻¹ * (θ * ‖r • c‖) := mul_le_mul_of_nonneg_left hbound (inv_nonneg.2 hr.le)
        _ = θ * ‖c‖ := by rw [hnorm]; field_simp
        _ ≤ θ * S := mul_le_mul_of_nonneg_left hc'.le hθ.le
        _ = η / 2 := by rw [hθ_def]; field_simp
        _ < η := half_lt_self hη
    have := hηf hclose
    rw [Real.dist_eq] at this
    rw [norm_norm, Real.norm_eq_abs]
    exact this.le
  -- integral bound
  have hint := norm_setIntegral_le_of_norm_le_const hDfin hpt
  rw [dist_zero_right]
  calc ‖∫ c in closedBall (0 : Euclid n) R, ‖f (r⁻¹ • (F (b + r • c) - F b)) - f (L c)‖‖
      ≤ ε₁ * V := hint
    _ < ε := by
      rw [hε₁_def, div_mul_eq_mul_div, div_lt_iff₀ hV1]
      nlinarith
/-- At a point `b` of Lebesgue density one of the Borel set `B` (`λ(B ∩ B̄_ρ(b))/λ(B̄_ρ(b)) → 1`
as `ρ ↓ 0`, the quotient taken in `[0, ∞]`), the averages `⨍_{B̄_s(b)} 1_{ℝⁿ∖B} dλ` tend to `0`
as `s ↓ 0`.  For `s > 0`, `0 < λ(B̄_s(b)) < ∞` and, by additivity, the average equals
`1 − (λ(B ∩ B̄_s(b))/λ(B̄_s(b))).toReal`; `toReal` is continuous at `1`. -/
theorem Submission.pit_ril_compl_average_tendsto : ∀ (n : ℕ) (B : Set (Euclid n)) (b : Euclid n), MeasurableSet B → Tendsto (fun ρ : ℝ => volume (B ∩ closedBall b ρ) / volume (closedBall b ρ)) (𝓝[>] 0) (𝓝 1) → Tendsto (fun s : ℝ => ⨍ a in closedBall b s, Bᶜ.indicator (fun _ => (1 : ℝ)) a ∂volume) (𝓝[>] 0) (𝓝 0) := by
  intro n B b hB hlim
  -- `q(ρ).toReal → 1` (`toReal` is continuous at `1 ≠ ∞`), so `1 - q(ρ).toReal → 0`
  have h1 : Tendsto (fun ρ : ℝ =>
      1 - (volume (B ∩ closedBall b ρ) / volume (closedBall b ρ)).toReal) (𝓝[>] 0) (𝓝 0) := by
    have h := (tendsto_const_nhds : Tendsto (fun _ : ℝ => (1 : ℝ)) (𝓝[>] 0) (𝓝 1)).sub
      ((ENNReal.tendsto_toReal ENNReal.one_ne_top).comp hlim)
    rwa [ENNReal.toReal_one, sub_self] at h
  refine h1.congr' ?_
  -- for `s > 0`, `0 < λ(C_s) < ∞` and the average equals `1 - q(s).toReal`
  filter_upwards [self_mem_nhdsWithin] with s (hs : 0 < s)
  have hfin : volume (closedBall b s) ≠ ∞ := measure_closedBall_lt_top.ne
  have hC : volume.real (closedBall b s) ≠ 0 :=
    (ENNReal.toReal_pos (measure_closedBall_pos volume b hs).ne' hfin).ne'
  -- `λ_ℝ(C_s ∩ B) + λ_ℝ(C_s \ B) = λ_ℝ(C_s)`
  have hsplit := measureReal_inter_add_sdiff (μ := volume) (s := closedBall b s) hB hfin
  rw [setAverage_eq, setIntegral_indicator hB.compl, setIntegral_const, smul_eq_mul, smul_eq_mul,
    mul_one, ENNReal.toReal_div, ← measureReal_def, ← measureReal_def, inter_comm B,
    ← Set.sdiff_eq, ← hsplit]
  rw [← hsplit] at hC
  field_simp
  ring
/-- Localised three-term estimate for the rescaled area integrals (one fixed `r > 0`).  With
`Φ_r(c) = r⁻¹(F(b + rc) − F(b))` and `D = B̄_{R/m}(0)`, the integrands
`X(c) = 1_B(b + rc) J(b + rc) f(Φ_r(c))` and `Y(c) = J(b) f(Lc)` vanish off `D` (by the lower
bounds for `F` on `B` and for `L`, as `f = 0` off the open `R`-ball), and pointwise
`|X − Y| ≤ KM·1_{Bᶜ}(b + rc) + M|J(b + rc) − J(b)| + J(b)|f(Φ_r(c)) − f(Lc)|`, by cases on
`b + rc ∈ B`; all are bounded Borel functions, so integrate over `D`. -/
theorem Submission.pit_ril_three_term_bound : ∀ (P n : ℕ) (F : Euclid n → Euclid P) (L : Euclid n →L[ℝ] Euclid P) (B : Set (Euclid n)) (J : Euclid n → ℝ) (K m : ℝ) (b : Euclid n) (f : Euclid P → ℝ) (R M r : ℝ), Continuous F → MeasurableSet B → Measurable J → (∀ a, 0 ≤ J a ∧ J a ≤ K) → 0 < m → (∀ a ∈ B, m * ‖a - b‖ ≤ ‖F a - F b‖) → (∀ c, m * ‖c‖ ≤ ‖L c‖) → Continuous f → (∀ w, R ≤ ‖w‖ → f w = 0) → (∀ w, ‖f w‖ ≤ M) → 0 < r → ‖(∫ c, B.indicator J (b + r • c) * f (r⁻¹ • (F (b + r • c) - F b)) ∂volume) - J b * (∫ c, f (L c) ∂volume)‖ ≤ K * M * (∫ c in closedBall (0 : Euclid n) (R / m), Bᶜ.indicator (fun _ => (1 : ℝ)) (b + r • c) ∂volume) + M * (∫ c in closedBall (0 : Euclid n) (R / m), ‖J (b + r • c) - J b‖ ∂volume) + J b * (∫ c in closedBall (0 : Euclid n) (R / m), ‖f (r⁻¹ • (F (b + r • c) - F b)) - f (L c)‖ ∂volume) := by
  intro P n F L B J K m b f R M r hF hB hJ hJK hm hFB hL hf hfR hfM hr
  -- constants: `0 ≤ M`, `0 ≤ J b ≤ K`, `0 ≤ K`, and `λ(D) < ∞` for `D = B̄_{R/m}(0)`
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hfM 0)
  have hJb0 : 0 ≤ J b := (hJK b).1
  have hJbK : J b ≤ K := (hJK b).2
  have hK0 : 0 ≤ K := hJb0.trans hJbK
  have hDfin : volume (closedBall (0 : Euclid n) (R / m)) ≠ ∞ := measure_closedBall_lt_top.ne
  -- measurability of the integrands
  have hshift : Continuous fun c : Euclid n => b + r • c :=
    continuous_const.add (continuous_id.const_smul r)
  have hΦ : Continuous fun c : Euclid n => f (r⁻¹ • (F (b + r • c) - F b)) :=
    hf.comp (((hF.comp hshift).sub continuous_const).const_smul r⁻¹)
  have hfL : Continuous fun c : Euclid n => f (L c) := hf.comp L.continuous
  have hIJ : Measurable fun c : Euclid n => B.indicator J (b + r • c) :=
    (hJ.indicator hB).comp hshift.measurable
  have hg₁ : Measurable fun c : Euclid n => Bᶜ.indicator (fun _ => (1 : ℝ)) (b + r • c) :=
    (measurable_const.indicator hB.compl).comp hshift.measurable
  have hg₂ : Measurable fun c : Euclid n => ‖J (b + r • c) - J b‖ :=
    ((hJ.comp hshift.measurable).sub measurable_const).norm
  have hg₃ : Continuous fun c : Euclid n => ‖f (r⁻¹ • (F (b + r • c) - F b)) - f (L c)‖ :=
    (hΦ.sub hfL).norm
  -- bounded measurable functions are integrable on `D`
  have hIJb : ∀ c : Euclid n, ‖B.indicator J (b + r • c)‖ ≤ K := by
    intro c
    by_cases h : b + r • c ∈ B
    · rw [Set.indicator_of_mem h, Real.norm_of_nonneg (hJK _).1]
      exact (hJK _).2
    · rw [Set.indicator_of_notMem h, norm_zero]
      exact hK0
  have hXint : IntegrableOn
      (fun c : Euclid n => B.indicator J (b + r • c) * f (r⁻¹ • (F (b + r • c) - F b)))
      (closedBall (0 : Euclid n) (R / m)) volume := by
    refine Measure.integrableOn_of_bounded (M := K * M) hDfin
      (hIJ.mul hΦ.measurable).aestronglyMeasurable (Eventually.of_forall fun c => ?_)
    rw [norm_mul]
    exact mul_le_mul (hIJb c) (hfM _) (norm_nonneg _) hK0
  have hYint : IntegrableOn (fun c : Euclid n => J b * f (L c))
      (closedBall (0 : Euclid n) (R / m)) volume := by
    refine Measure.integrableOn_of_bounded (M := K * M) hDfin
      (measurable_const.mul hfL.measurable).aestronglyMeasurable (Eventually.of_forall fun c => ?_)
    rw [norm_mul, Real.norm_of_nonneg hJb0]
    exact mul_le_mul hJbK (hfM _) (norm_nonneg _) hK0
  have hg₁int : IntegrableOn (fun c : Euclid n => Bᶜ.indicator (fun _ => (1 : ℝ)) (b + r • c))
      (closedBall (0 : Euclid n) (R / m)) volume := by
    refine Measure.integrableOn_of_bounded (M := 1) hDfin hg₁.aestronglyMeasurable
      (Eventually.of_forall fun c => ?_)
    by_cases h : b + r • c ∈ Bᶜ
    · rw [Set.indicator_of_mem h, norm_one]
    · rw [Set.indicator_of_notMem h, norm_zero]
      exact zero_le_one
  have hg₂int : IntegrableOn (fun c : Euclid n => ‖J (b + r • c) - J b‖)
      (closedBall (0 : Euclid n) (R / m)) volume := by
    refine Measure.integrableOn_of_bounded (M := K) hDfin hg₂.aestronglyMeasurable
      (Eventually.of_forall fun c => ?_)
    rw [norm_norm, Real.norm_eq_abs, abs_sub_le_iff]
    constructor <;> linarith [hJK (b + r • c), hJK b]
  have hg₃int : IntegrableOn
      (fun c : Euclid n => ‖f (r⁻¹ • (F (b + r • c) - F b)) - f (L c)‖)
      (closedBall (0 : Euclid n) (R / m)) volume := by
    refine Measure.integrableOn_of_bounded (M := M + M) hDfin hg₃.aestronglyMeasurable
      (Eventually.of_forall fun c => ?_)
    rw [norm_norm]
    exact (norm_sub_le _ _).trans (add_le_add (hfM _) (hfM _))
  -- localisation: both integrands vanish off `D`
  have hloc : ∀ c : Euclid n, c ∉ closedBall (0 : Euclid n) (R / m) → R < m * ‖c‖ := by
    intro c hc
    rw [mem_closedBall, dist_zero_right, not_le, div_lt_iff₀ hm] at hc
    rwa [mul_comm] at hc
  have hXloc : ∀ c : Euclid n, c ∉ closedBall (0 : Euclid n) (R / m) →
      B.indicator J (b + r • c) * f (r⁻¹ • (F (b + r • c) - F b)) = 0 := by
    intro c hc
    by_cases h : b + r • c ∈ B
    · have h1 := hFB _ h
      rw [add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hr.le] at h1
      have h2 : R ≤ ‖r⁻¹ • (F (b + r • c) - F b)‖ := by
        rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hr.le)]
        calc R ≤ m * ‖c‖ := (hloc c hc).le
          _ = r⁻¹ * (m * (r * ‖c‖)) := by rw [mul_left_comm m r, inv_mul_cancel_left₀ hr.ne']
          _ ≤ r⁻¹ * ‖F (b + r • c) - F b‖ := mul_le_mul_of_nonneg_left h1 (inv_nonneg.2 hr.le)
      rw [hfR _ h2, mul_zero]
    · rw [Set.indicator_of_notMem h, zero_mul]
  have hYloc : ∀ c : Euclid n, c ∉ closedBall (0 : Euclid n) (R / m) → J b * f (L c) = 0 := by
    intro c hc
    rw [hfR _ ((hloc c hc).le.trans (hL c)), mul_zero]
  -- pointwise three-term estimate, by cases on `b + r • c ∈ B`
  have hpt : ∀ c : Euclid n,
      ‖B.indicator J (b + r • c) * f (r⁻¹ • (F (b + r • c) - F b)) - J b * f (L c)‖ ≤
        K * M * Bᶜ.indicator (fun _ => (1 : ℝ)) (b + r • c) + M * ‖J (b + r • c) - J b‖ +
          J b * ‖f (r⁻¹ • (F (b + r • c) - F b)) - f (L c)‖ := by
    intro c
    have hu := hfM (r⁻¹ • (F (b + r • c) - F b))
    have hv := hfM (L c)
    have hA : 0 ≤ M * ‖J (b + r • c) - J b‖ := mul_nonneg hM0 (norm_nonneg _)
    have hB' : 0 ≤ J b * ‖f (r⁻¹ • (F (b + r • c) - F b)) - f (L c)‖ :=
      mul_nonneg hJb0 (norm_nonneg _)
    by_cases h : b + r • c ∈ B
    · rw [Set.indicator_of_mem h, Set.indicator_of_notMem (Set.notMem_compl_iff.2 h), mul_zero,
        zero_add]
      have hJu := mul_le_mul_of_nonneg_left hu (norm_nonneg (J (b + r • c) - J b))
      calc ‖J (b + r • c) * f (r⁻¹ • (F (b + r • c) - F b)) - J b * f (L c)‖
          = ‖(J (b + r • c) - J b) * f (r⁻¹ • (F (b + r • c) - F b)) +
              J b * (f (r⁻¹ • (F (b + r • c) - F b)) - f (L c))‖ := by
            congr 1
            ring
        _ ≤ ‖(J (b + r • c) - J b) * f (r⁻¹ • (F (b + r • c) - F b))‖ +
              ‖J b * (f (r⁻¹ • (F (b + r • c) - F b)) - f (L c))‖ := norm_add_le _ _
        _ = ‖J (b + r • c) - J b‖ * ‖f (r⁻¹ • (F (b + r • c) - F b))‖ +
              J b * ‖f (r⁻¹ • (F (b + r • c) - F b)) - f (L c)‖ := by
            rw [norm_mul, norm_mul, Real.norm_of_nonneg hJb0]
        _ ≤ M * ‖J (b + r • c) - J b‖ + J b * ‖f (r⁻¹ • (F (b + r • c) - F b)) - f (L c)‖ := by
            linarith [mul_comm M ‖J (b + r • c) - J b‖]
    · rw [Set.indicator_of_notMem h, Set.indicator_of_mem (Set.mem_compl h), zero_mul, zero_sub,
        norm_neg, norm_mul, Real.norm_of_nonneg hJb0, mul_one]
      have hJv : J b * ‖f (L c)‖ ≤ K * M := mul_le_mul hJbK hv (norm_nonneg _) hK0
      linarith
  -- integrate the pointwise estimate over `D`
  have h1 : (∫ c, B.indicator J (b + r • c) * f (r⁻¹ • (F (b + r • c) - F b)) ∂volume) =
      ∫ c in closedBall (0 : Euclid n) (R / m),
        B.indicator J (b + r • c) * f (r⁻¹ • (F (b + r • c) - F b)) ∂volume :=
    (setIntegral_eq_integral_of_forall_compl_eq_zero hXloc).symm
  have h2 : J b * (∫ c, f (L c) ∂volume) =
      ∫ c in closedBall (0 : Euclid n) (R / m), J b * f (L c) ∂volume := by
    rw [← integral_const_mul]
    exact (setIntegral_eq_integral_of_forall_compl_eq_zero hYloc).symm
  have hG₁₂ : IntegrableOn (fun c : Euclid n => K * M * Bᶜ.indicator (fun _ => (1 : ℝ)) (b + r • c) +
      M * ‖J (b + r • c) - J b‖) (closedBall (0 : Euclid n) (R / m)) volume :=
    (hg₁int.const_mul _).add (hg₂int.const_mul _)
  have hG : IntegrableOn (fun c : Euclid n => K * M * Bᶜ.indicator (fun _ => (1 : ℝ)) (b + r • c) +
      M * ‖J (b + r • c) - J b‖ + J b * ‖f (r⁻¹ • (F (b + r • c) - F b)) - f (L c)‖)
      (closedBall (0 : Euclid n) (R / m)) volume :=
    hG₁₂.add (hg₃int.const_mul _)
  rw [h1, h2, ← integral_sub hXint hYint]
  refine (norm_integral_le_of_norm_le hG (Eventually.of_forall hpt)).trans_eq ?_
  rw [integral_add hG₁₂ (hg₃int.const_mul _), integral_add (hg₁int.const_mul _) (hg₂int.const_mul _),
    integral_const_mul, integral_const_mul, integral_const_mul]
/-- **Rescaled integrals at a point of vanishing ball averages**: for `R > 0`, if
`⨍_{B̄_s(b)} h → 0` as `s → 0⁺`, then `∫_{B̄_R(0)} h(b + rc) dc → 0` as `r → 0⁺`.
For `r > 0`, dilation by `r` and translation by `b` give
`∫_{B̄_R(0)} h(b + rc) dc = r⁻ⁿ ∫_{B̄_{rR}(b)} h = ω Rⁿ ⨍_{B̄_{rR}(b)} h`, `ω = λ(B̄₁(0))`. -/
theorem Submission.pit_integral_closedBall_rescale_tendsto : ∀ (n : ℕ) (h : Euclid n → ℝ) (b : Euclid n) (R : ℝ), 0 < R → Tendsto (fun s : ℝ => ⨍ a in closedBall b s, h a ∂volume) (𝓝[>] 0) (𝓝 0) → Tendsto (fun r : ℝ => ∫ c in closedBall (0 : Euclid n) R, h (b + r • c) ∂volume) (𝓝[>] 0) (𝓝 0) := by
  intro n h b R hR hlim
  -- `ω = λ(B̄₁(0)) ∈ (0, ∞)` and `λ(B̄_s(z)) = sⁿ ω` for `s ≥ 0`
  set ω : ℝ := volume.real (closedBall (0 : Euclid n) 1) with hω_def
  have hω : 0 < ω := by
    rw [hω_def, measureReal_def]
    exact ENNReal.toReal_pos (measure_closedBall_pos volume 0 one_pos).ne'
      measure_closedBall_lt_top.ne
  have hvol : ∀ (z : Euclid n) {s : ℝ}, 0 ≤ s → volume.real (closedBall z s) = s ^ n * ω := by
    intro z s hs
    rw [Measure.addHaar_real_closedBall' volume z hs, finrank_euclideanSpace_fin]
  -- for `r > 0`: `∫_{B̄_R(0)} h(b + rc) dc = Rⁿ ω ⨍_{B̄_{rR}(b)} h`
  have key : ∀ r : ℝ, 0 < r → ∫ c in closedBall (0 : Euclid n) R, h (b + r • c) ∂volume =
      R ^ n * ω * ⨍ a in closedBall b (r * R), h a ∂volume := by
    intro r hr
    set H : Euclid n → ℝ := (closedBall b (r * R)).indicator h with hH
    have hmem : ∀ c : Euclid n, b + r • c ∈ closedBall b (r * R) ↔ c ∈ closedBall (0 : Euclid n) R := by
      intro c
      rw [mem_closedBall, mem_closedBall, dist_self_add_left, dist_zero_right, norm_smul,
        Real.norm_eq_abs, abs_of_pos hr, mul_le_mul_iff_of_pos_left hr]
    -- `1_{B̄_R(0)}(c) h(b + rc) = H(b + rc)`
    have h1 : ∫ c in closedBall (0 : Euclid n) R, h (b + r • c) ∂volume =
        ∫ c, H (b + r • c) ∂volume := by
      rw [← integral_indicator measurableSet_closedBall]
      congr 1
      ext c
      by_cases hc : c ∈ closedBall (0 : Euclid n) R
      · rw [indicator_of_mem hc, hH, indicator_of_mem ((hmem c).2 hc)]
      · rw [indicator_of_notMem hc, hH, indicator_of_notMem (mt (hmem c).1 hc)]
    -- dilation by `r` and translation by `b`
    have h2 : ∫ c, H (b + r • c) ∂volume = (r ^ n)⁻¹ * ∫ a in closedBall b (r * R), h a ∂volume := by
      rw [Measure.integral_comp_smul volume (fun x => H (b + x)) r, integral_add_left_eq_self H b,
        hH, integral_indicator measurableSet_closedBall, finrank_euclideanSpace_fin, smul_eq_mul,
        abs_of_pos (inv_pos.2 (pow_pos hr n))]
    have h3 : ⨍ a in closedBall b (r * R), h a ∂volume =
        ((r * R) ^ n * ω)⁻¹ * ∫ a in closedBall b (r * R), h a ∂volume := by
      rw [setAverage_eq, hvol b (mul_pos hr hR).le, smul_eq_mul]
    rw [h1, h2, h3, mul_pow]
    field_simp
  -- `r ↦ rR` maps `𝓝[>] 0` into `𝓝[>] 0`
  have hmap : Tendsto (fun r : ℝ => r * R) (𝓝[>] 0) (𝓝[>] 0) := by
    rw [tendsto_nhdsWithin_iff]
    refine ⟨?_, ?_⟩
    · have hc : Tendsto (fun r : ℝ => r * R) (𝓝 0) (𝓝 (0 * R)) :=
        (continuous_id.mul continuous_const).tendsto 0
      rw [zero_mul] at hc
      exact hc.mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with r hr
      exact mul_pos hr hR
  have hlim' := (hlim.comp hmap).const_mul (R ^ n * ω)
  rw [mul_zero] at hlim'
  refine hlim'.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with r hr
  exact (key r hr).symm

/-- **Rescaled integrals at a density point of `B` and a Lebesgue point of `J`**: let
`m|a − b| ≤ |F(a) − F(b)|` on `B`, `m|c| ≤ |Lc|` for `L = DF(b)`, `0 ≤ J ≤ K`, let `B` have
density `1` at `b` and `⨍_{B̄_ρ(b)} |J − J(b)| → 0`.  Then for `f ∈ C_c(ℝᴾ)`,
`∫ 1_B(b + rc) J(b + rc) f(r⁻¹(F(b + rc) − F(b))) dc → J(b) ∫ f(Lc) dc` as `r → 0⁺`.
With `f = 0` off `B_R(0)` and `|f| ≤ M`, the error is at most `K M T₁ + M T₂ + J(b) T₃`, where
`T₁, T₂, T₃` integrate `1_{Bᶜ}(b + rc)`, `|J(b + rc) − J(b)|` and
`|f(r⁻¹(F(b + rc) − F(b))) − f(Lc)|` over `B̄_{R/m}(0)`; each tends to `0`. -/
theorem Submission.pit_rescaled_integral_tendsto : ∀ (P n : ℕ) (F : Euclid n → Euclid P) (B : Set (Euclid n)) (J : Euclid n → ℝ) (K m : ℝ) (b : Euclid n) (f : Euclid P → ℝ), Continuous F → MeasurableSet B → Measurable J → (∀ a, 0 ≤ J a ∧ J a ≤ K) → 0 < m → (∀ a ∈ B, m * ‖a - b‖ ≤ ‖F a - F b‖) → DifferentiableAt ℝ F b → (∀ c, m * ‖c‖ ≤ ‖fderiv ℝ F b c‖) → Tendsto (fun ρ : ℝ => volume (B ∩ closedBall b ρ) / volume (closedBall b ρ)) (𝓝[>] 0) (𝓝 1) → Tendsto (fun ρ : ℝ => ⨍ a in closedBall b ρ, ‖J a - J b‖ ∂volume) (𝓝[>] 0) (𝓝 0) → Continuous f → HasCompactSupport f → Tendsto (fun r : ℝ => ∫ c, B.indicator J (b + r • c) * f (r⁻¹ • (F (b + r • c) - F b)) ∂volume) (𝓝[>] 0) (𝓝 (J b * ∫ c, f (fderiv ℝ F b c) ∂volume)) := by
  intro P n F B J K m b f hF hB hJ hJK hm hFB hdiff hL hdens hLeb hf hfc
  -- `f = 0` off `B_R(0)` and `|f| ≤ M`; the integrals live on `B̄_{R/m}(0)`
  obtain ⟨R, hR, hRf⟩ := hfc.exists_pos_le_norm
  obtain ⟨M, hM⟩ := hf.bounded_above_of_compact_support hfc
  have hRm : 0 < R / m := div_pos hR hm
  -- `T₁ → 0`: `B` has density `1` at `b`
  have hT₁ := Submission.pit_integral_closedBall_rescale_tendsto n
    (Bᶜ.indicator fun _ => (1 : ℝ)) b (R / m) hRm
    (Submission.pit_ril_compl_average_tendsto n B b hB hdens)
  -- `T₂ → 0`: `b` is a Lebesgue point of `J`
  have hT₂ := Submission.pit_integral_closedBall_rescale_tendsto n (fun a => ‖J a - J b‖) b
    (R / m) hRm hLeb
  -- `T₃ → 0`: `r⁻¹(F(b + rc) − F(b)) → Lc` uniformly on `B̄_{R/m}(0)`
  have hT₃ := Submission.pit_ril_diffQuot_integral_tendsto P n F (fderiv ℝ F b) b f (R / m)
    hdiff.hasFDerivAt hf hfc
  have hlim := ((hT₁.const_mul (K * M)).add (hT₂.const_mul M)).add (hT₃.const_mul (J b))
  simp only [mul_zero, add_zero] at hlim
  -- squeeze `|I(r) − J(b) ∫ f(Lc) dc| ≤ K M T₁(r) + M T₂(r) + J(b) T₃(r)` for `r > 0`
  rw [tendsto_iff_norm_sub_tendsto_zero]
  refine squeeze_zero' (Eventually.of_forall fun r => norm_nonneg _) ?_ hlim
  filter_upwards [self_mem_nhdsWithin] with r hr
  exact Submission.pit_ril_three_term_bound P n F (fderiv ℝ F b) B J K m b f R M r hF hB hJ hJK
    hm hFB hL hf hRf hM hr
/-- Integral over the range of a linear map with constant Jacobian: if `T : ℝⁿ → ℝᴾ` is linear
and `Hⁿ(T(S)) = j λ(S)` for every `S ⊆ ℝⁿ` (`j ≥ 0`, `λ` Lebesgue measure), then for continuous
`f`, `∫_{T(ℝⁿ)} f dHⁿ = j ∫ f(T(c)) dλ(c)`.  On Borel `A`, `A ∩ T(ℝⁿ) = T(T⁻¹(A))`, so
`Hⁿ⌞T(ℝⁿ) = j T_#λ`. -/
theorem Submission.pit_setIntegral_range_linear : ∀ (P n : ℕ) (T : Euclid n →L[ℝ] Euclid P) (j : ℝ) (f : Euclid P → ℝ), 0 ≤ j → (∀ S : Set (Euclid n), μHE[n] (T '' S) = ENNReal.ofReal j * volume S) → Continuous f → ∫ y in (LinearMap.range (T : Euclid n →ₗ[ℝ] Euclid P) : Set (Euclid P)), f y ∂μHE[n] = j * ∫ c, f (T c) ∂volume := by
  intro P n T j f hj hT hf
  -- the carrier of the submodule `range T` is the set `T(ℝⁿ)`
  have hrange : (LinearMap.range (T : Euclid n →ₗ[ℝ] Euclid P) : Set (Euclid P)) = range T := by
    rw [LinearMap.coe_range, ContinuousLinearMap.coe_coe]
  -- `Hⁿ⌞T(ℝⁿ) = ofReal(j) • T_#λ`, checked on Borel sets
  have hmeas : μHE[n].restrict (range T) = ENNReal.ofReal j • volume.map T := by
    ext A hA
    rw [Measure.restrict_apply hA, Measure.smul_apply, Measure.map_apply T.measurable hA,
      ← image_preimage_eq_inter_range, hT, smul_eq_mul]
  -- change of variables, with `(ofReal j).toReal = j` since `j ≥ 0`
  rw [hrange, hmeas, integral_smul_measure,
    integral_map T.measurable.aemeasurable hf.aestronglyMeasurable,
    ENNReal.toReal_ofReal hj, smul_eq_mul]
/-- **Simon Ch. 3, 1.4** (approximate tangent spaces of a bi-Lipschitz piece): let `F : ℝⁿ → ℝᴾ`
be `L`-Lipschitz, `B ⊆ ℝⁿ` Borel and `m > 0` with `m|a − a'| ≤ |F a − F a'|` on `B`, and let `F`
be differentiable at every point of `B` with injective derivative.  Then for a.e. `b ∈ B`,
`F(B)` has approximate tangent space `range DF(b)` at `F b`.
With `J := normDet DF` (Borel, `0 ≤ J ≤ Lⁿ`) the injective area formula holds on `B`.  A.e.
`b ∈ B` is a density point of `B` and a Lebesgue point of `J`; there
`∫_{η_{F b,r}(F(B))} f dHⁿ = ∫ 1_B J(b + rc) f(r⁻¹(F(b + rc) − F b)) dc` tends to
`J(b) ∫ f(DF(b)c) dc = ∫_{range DF(b)} f dHⁿ` as `r ↓ 0`. -/
theorem Submission.ptd_piece_image_approxTangent_ae : ∀ (P n : ℕ) (F : Euclid n → Euclid P) (B : Set (Euclid n)) (L : NNReal) (m : ℝ), LipschitzWith L F → MeasurableSet B → 0 < m → (∀ a ∈ B, ∀ a' ∈ B, m * ‖a - a'‖ ≤ ‖F a - F a'‖) → (∀ a ∈ B, DifferentiableAt ℝ F a ∧ Injective (fderiv ℝ F a)) → ∀ᵐ b ∂(volume.restrict B), HasApproximateTangentSpaceAt n (F '' B) (F b) (LinearMap.range (fderiv ℝ F b : Euclid n →ₗ[ℝ] Euclid P)) := by
  intro P n F B L m hF hB hm hcolip hreg
  have hfin : Module.finrank ℝ (Euclid n) = n := finrank_euclideanSpace_fin
  -- the area Jacobian `J = normDet DF`
  obtain ⟨J, hJ⟩ : ∃ J : Euclid n → ℝ, J = Poincare.SimonGMT.Chapter02.areaJacobianAt F :=
    ⟨_, rfl⟩
  have hJmeas : Measurable J := hJ ▸ Poincare.SimonGMT.Chapter02.measurable_areaJacobianAt F
  have hJnonneg : ∀ a, 0 ≤ J a := hJ ▸ Poincare.SimonGMT.Chapter02.areaJacobianAt_nonneg F
  -- `Hⁿ(T(S)) = normDet T · λ(S)` for every linear `T`
  have hlin : ∀ (T : Euclid n →L[ℝ] Euclid P) (S : Set (Euclid n)),
      μHE[n] (T '' S) = ENNReal.ofReal (T : Euclid n →ₗ[ℝ] Euclid P).normDet * volume S := by
    intro T S
    have h := LinearMap.euclideanHausdorffMeasure_image_eq_normDet_mul_volume
      (T : Euclid n →ₗ[ℝ] Euclid P) S
    rw [hfin] at h
    simpa using h
  have hJlin : ∀ a (S : Set (Euclid n)),
      μHE[n] (fderiv ℝ F a '' S) = ENNReal.ofReal (J a) * volume S := by
    intro a S
    rw [hlin, hJ, Poincare.SimonGMT.Chapter02.areaJacobianAt_eq_normDet]
  -- `J ≤ Lⁿ`: compare `Hⁿ(DF(a)(B̄₁(0)))` with the Lipschitz bound `‖DF(a)‖ ≤ L`
  have hJle : ∀ a, J a ≤ (L : ℝ) ^ n := by
    intro a
    have hTL : ‖fderiv ℝ F a‖₊ ≤ L := by
      have h := norm_fderiv_le_of_lipschitz ℝ (x₀ := a) hF
      exact_mod_cast h
    have hpos : volume (closedBall (0 : Euclid n) 1) ≠ 0 :=
      (measure_closedBall_pos volume (0 : Euclid n) one_pos).ne'
    have hfin' : volume (closedBall (0 : Euclid n) 1) ≠ ∞ := measure_closedBall_lt_top.ne
    have hle : ENNReal.ofReal (J a) * volume (closedBall (0 : Euclid n) 1) ≤
        (L : ℝ≥0∞) ^ n * volume (closedBall (0 : Euclid n) 1) := by
      rw [← hJlin a, ← EuclideanSpace.euclideanHausdorffMeasure_eq_volume n]
      calc μHE[n] (fderiv ℝ F a '' closedBall 0 1)
          ≤ (‖fderiv ℝ F a‖₊ : ℝ≥0∞) ^ n * μHE[n] (closedBall (0 : Euclid n) 1) :=
            Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
              (fderiv ℝ F a).lipschitzWith.lipschitzOnWith
        _ ≤ (L : ℝ≥0∞) ^ n * μHE[n] (closedBall (0 : Euclid n) 1) := by gcongr
    have h2 : ENNReal.ofReal (J a) ≤ (L : ℝ≥0∞) ^ n :=
      (ENNReal.mul_le_mul_iff_left hpos hfin').1 hle
    rw [← ENNReal.ofReal_le_ofReal_iff (by positivity), ENNReal.ofReal_pow L.coe_nonneg,
      ENNReal.ofReal_coe_nnreal]
    exact h2
  -- `F` is injective on `B`, so the area formula holds on `B` with weight `J`
  have hinjOn : InjOn F B := by
    intro a ha a' ha' hFa
    have h := hcolip a ha a' ha'
    rw [hFa, sub_self, norm_zero] at h
    have h' : ‖a - a'‖ ≤ 0 := le_of_mul_le_mul_left (by simpa using h) hm
    exact sub_eq_zero.1 (norm_le_zero_iff.1 h')
  have harea : ∀ g : Euclid P → ℝ≥0∞,
      ∫⁻ y in F '' B, g y ∂μHE[n] = ∫⁻ x in B, ENNReal.ofReal (J x) * g (F x) ∂volume := by
    intro g
    have h := Poincare.SimonGMT.Chapter02.weighted_area_formula_lipschitz_injOn hF hB hinjOn g
    rw [hfin] at h
    rw [h, hJ]
  -- `J` is bounded and Borel, hence locally integrable
  have hJloc : LocallyIntegrable J volume := by
    rw [locallyIntegrable_iff]
    intro k hk
    refine Measure.integrableOn_of_bounded hk.measure_lt_top.ne hJmeas.aestronglyMeasurable
      (M := (L : ℝ) ^ n) (Eventually.of_forall fun a => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (hJnonneg a)]
    exact hJle a
  -- a.e. `b ∈ B` is a density point of `B` and a Lebesgue point of `J`
  have hleb := IsUnifLocDoublingMeasure.ae_tendsto_average_norm_sub (volume : Measure (Euclid n))
    hJloc 1
  filter_upwards [ae_restrict_mem hB, Besicovitch.ae_tendsto_measure_inter_div volume B,
    ae_restrict_of_ae hleb] with b hbB hα hβ
  have hβ' : Tendsto (fun ρ : ℝ => ⨍ a in closedBall b ρ, ‖J a - J b‖ ∂volume) (𝓝[>] 0) (𝓝 0) :=
    hβ (fun _ => b) id tendsto_id (eventually_nhdsWithin_of_forall fun ρ (hρ : 0 < ρ) =>
      mem_closedBall_self (by simpa using hρ.le))
  obtain ⟨hdb, hinj⟩ := hreg b hbB
  have hcolb : ∀ a ∈ B, m * ‖a - b‖ ≤ ‖F a - F b‖ := fun a ha => hcolip a ha b hbB
  have hγ : ∀ c, m * ‖c‖ ≤ ‖fderiv ℝ F b c‖ :=
    Submission.pit_fderiv_lower_bound_of_density P n F B m b hm hcolb hdb hα
  refine ⟨?_, fun f => ?_⟩
  · rw [LinearMap.finrank_range_of_inj (by simpa using hinj), hfin]
  · rw [Submission.pit_setIntegral_range_linear P n (fderiv ℝ F b) (J b) f (hJnonneg b)
      (hJlin b) f.continuous]
    refine (Submission.pit_rescaled_integral_tendsto P n F B J ((L : ℝ) ^ n) m b f hF.continuous
      hB hJmeas (fun a => ⟨hJnonneg a, hJle a⟩) hm hcolb hdb hγ hα hβ' f.continuous
      f.hasCompactSupport).congr' ?_
    filter_upwards [self_mem_nhdsWithin] with r hr
    exact (Submission.pit_blowUp_image_setIntegral_eq_rescaled P n F B J b r f hF.continuous hB
      hJmeas hJnonneg harea hr f.continuous).symm

/-- **Simon Ch. 3, proof of Theorem 1.6 "⇒"**, for a bi-Lipschitz piece: let `U` be open,
`Y ⊆ U` Borel with `Hⁿ(Y ∩ C) < ∞` for compact `C ⊆ U`, `F` Lipschitz, `B` Borel with
`m|a − a'| ≤ |F(a) − F(a')|` on `B`, `DF(a)` injective for `a ∈ B`, and `F(B) ⊆ Y`.  Then for
a.e. `b ∈ B`, `Y` has approximate tangent space `range DF(b)` at `F(b)`.  The image `F(B)` itself
has this tangent space at `F(b)` for a.e. `b`; `Y` and its Borel subset `F(B)` have the same
approximate tangent spaces `Hⁿ`-a.e. on `F(B)`; and `Hⁿ⌞F(B)`-null sets pull back along `F` to
Lebesgue-null subsets of `B`. -/
theorem Submission.dpf_approxTangent_ae_bilipschitz_piece : ∀ (P n : ℕ) (U Y : Set (Euclid P)) (F : Euclid n → Euclid P) (B : Set (Euclid n)) (L : NNReal) (m : ℝ), IsOpen U → MeasurableSet Y → Y ⊆ U → (∀ C : Set (Euclid P), IsCompact C → C ⊆ U → μHE[n] (Y ∩ C) ≠ ∞) → LipschitzWith L F → MeasurableSet B → 0 < m → (∀ a ∈ B, ∀ a' ∈ B, m * ‖a - a'‖ ≤ ‖F a - F a'‖) → (∀ a ∈ B, DifferentiableAt ℝ F a ∧ Injective (fderiv ℝ F a)) → F '' B ⊆ Y → ∀ᵐ b ∂(volume.restrict B), HasApproximateTangentSpaceAt n Y (F b) (LinearMap.range (fderiv ℝ F b : Euclid n →ₗ[ℝ] Euclid P)) := by
  intro P n U Y F B L m hU hY hYU hfin hF hB hm hbi hdiff hFBY
  -- Step 0(a)–(b): `F(B)` is Borel; `Hⁿ⌞F(B)`-a.e. properties hold at `F(b)` for a.e. `b ∈ B`
  obtain ⟨hA, hpull⟩ := Submission.ptd_piece_image_measurable_ae_pullback P n F B L m hF hB hm hbi
  -- Steps 1–3 and 6: `Hⁿ`-a.e. on `F(B)`, `Y` and `F(B)` have the same approximate tangent spaces
  have hloc := Submission.ptd_ae_approxTangent_iff_of_subset P n U (F '' B) Y hU hA hY hFBY hYU hfin
  -- Steps 4, 5 and 7: `F(B)` has approximate tangent space `range DF(b)` at `F(b)` for a.e. `b ∈ B`
  filter_upwards [hpull _ hloc,
    Submission.ptd_piece_image_approxTangent_ae P n F B L m hF hB hm hbi hdiff] with b hYA hA'
  exact (hYA _).2 hA'
/-- **Markov selection of a good parameter** (Simon, Ch. 6, proof of 5.1, (10): a slicing radius
in `(σ/2, σ)`).  If `g : ℝ → [0, ∞]` is a.e.-measurable, `p` holds for a.e. `t`, `a < b` and
`∫_{(a,b)} g ≤ I`, then some `t ∈ (a, b)` has `p t` and `(b − a) g(t) ≤ 2I`.  Otherwise
`2I < (b − a) g` a.e. on `(a, b)`, which is impossible for `I = ∞` as `(a, b)` is not null; for
`I < ∞` integration gives `2I(b − a) ≤ (b − a)I`, so `I = 0`, whence `g = 0` a.e. on `(a, b)`,
contradicting `0 < (b − a) g` a.e. there. -/
theorem Submission.dor_lmb_fcd_sd_markov_point : ∀ (g : ℝ → ℝ≥0∞) (p : ℝ → Prop) (a b : ℝ) (I : ℝ≥0∞), a < b → AEMeasurable g → (∀ᵐ t, p t) → ∫⁻ t in Ioo a b, g t ≤ I → ∃ t ∈ Ioo a b, p t ∧ ENNReal.ofReal (b - a) * g t ≤ 2 * I := by
  intro g p a b I hab hg hp hI
  set c : ℝ≥0∞ := ENNReal.ofReal (b - a) with hc
  have hc0 : c ≠ 0 := by simpa [hc] using hab
  have hctop : c ≠ ∞ := ENNReal.ofReal_ne_top
  have hvol : volume (Ioo a b) = c := Real.volume_Ioo
  -- Step 1: otherwise `2I < c g(t)` for every `t ∈ (a, b)` with `p t`
  by_contra hcon
  have hbad : ∀ t ∈ Ioo a b, p t → 2 * I < c * g t := fun t ht hpt =>
    not_le.1 fun hle => hcon ⟨t, ht, hpt, hle⟩
  -- Step 2: `2I < c g` almost everywhere on `(a, b)`
  have hae : ∀ᵐ t ∂(volume.restrict (Ioo a b)), 2 * I < c * g t := by
    rw [ae_restrict_iff' measurableSet_Ioo]
    filter_upwards [hp] with t ht htI
    exact hbad t htI ht
  -- Step 3: `(a, b)` is not null
  have hnull : ¬ ∀ᵐ _t ∂(volume.restrict (Ioo a b)), False := by
    intro h
    have h0 : volume.restrict (Ioo a b) = 0 := ae_eq_bot.1 (eventually_false_iff_eq_bot.1 h)
    rw [Measure.restrict_eq_zero, hvol] at h0
    exact hc0 h0
  rcases eq_or_ne I ∞ with hItop | hItop
  · -- Step 4: `I = ∞`
    apply hnull
    filter_upwards [hae] with t ht
    rw [hItop] at ht
    simp at ht
  · -- Step 5: `I < ∞` forces `I = 0`
    have h1 : ∫⁻ _t in Ioo a b, 2 * I ≤ ∫⁻ t in Ioo a b, c * g t :=
      lintegral_mono_ae (hae.mono fun t ht => ht.le)
    rw [setLIntegral_const, lintegral_const_mul'' _ hg.restrict, hvol] at h1
    have h2 : 2 * I * c ≤ I * c :=
      calc 2 * I * c ≤ c * ∫⁻ t in Ioo a b, g t := h1
        _ ≤ c * I := by gcongr
        _ = I * c := mul_comm c I
    have h3 : 2 * I ≤ I := (ENNReal.mul_le_mul_iff_left hc0 hctop).1 h2
    have hI0 : I = 0 := by
      have h4 : I + I ≤ 0 + I := by rw [zero_add, ← two_mul]; exact h3
      exact nonpos_iff_eq_zero.1 (ENNReal.le_of_add_le_add_right hItop h4)
    -- Step 6: `g = 0` a.e. on `(a, b)` contradicts `0 < c g` a.e.
    have hg0 : ∀ᵐ t ∂(volume.restrict (Ioo a b)), g t = 0 :=
      (lintegral_eq_zero_iff' hg.restrict).1 (nonpos_iff_eq_zero.1 (hI.trans hI0.le))
    apply hnull
    filter_upwards [hae, hg0] with t ht ht0
    rw [hI0, ht0] at ht
    simp at ht
/-- **Faces of the unit cubical lattice** (Simon Ch. 6, §5: the `n`-faces `F ∈ 𝓛ₙ` used in the proof
of the deformation theorem 5.1).  Let `n = m + 1` and `p = (z, ι)` with `ι : Fin n → Fin P` strictly
increasing.  The map `Φ_p(y) = z + Σⱼ yⱼ e_{ι(j)}` has coordinates `z_{ι(k)} + y_k` at `ι(k)` and
`zᵢ` off `range ι`, so it is an isometric embedding `ℝⁿ → ℝᴾ` with `Φ_p⁻¹(F_p) = [0, 1]ⁿ` and
`F_p ⊆ range Φ_p`.  As `μHE[n] = volume` on `ℝⁿ`, `Φ_p#μHE[n] = μHE[n]⌞range Φ_p` and `∂[0, 1]ⁿ` is
Lebesgue-null, `Hⁿ⌞F_p = Φ_p#(Lⁿ⌞(0, 1)ⁿ)`; hence `Hⁿ(F_p) = 1` and
`∫_{F_p} f dHⁿ = ∫_{(0, 1)ⁿ} f ∘ Φ_p`.  `F_p` is closed with diameter `≤ √P`, and the non-integer
coordinates of a point of `Φ_p((0, 1)ⁿ)` determine `ι` and `z`, so it lies in no other face
`F_q`. -/
theorem Submission.dor_lmb_fcd_fr_face_geometry : ∀ (P m : ℕ) (p : (Fin P → ℤ) × (Fin (m + 1) → Fin P)), StrictMono p.2 → volume {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} = 1 ∧ μHE[m + 1] {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)} = 1 ∧ (μHE[m + 1] : Measure (Euclid P)).restrict {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)} = Measure.map (fun y : Euclid (m + 1) => WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (volume.restrict {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}) ∧ (∀ f : Euclid P → ℝ, ∫ x in {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)}, f x ∂μHE[m + 1] = ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, f (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ))) ∧ (∀ y : Euclid (m + 1), (∀ i, 0 ≤ y i ∧ y i ≤ 1) → WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ) ∈ {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)}) ∧ (∀ y y' : Euclid (m + 1), dist (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y' j • EuclideanSpace.single (p.2 j) (1 : ℝ)) = dist y y') ∧ (∀ x ∈ {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)}, ∀ x' ∈ {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)}, dist x x' ≤ Real.sqrt P) ∧ IsClosed {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)} ∧ ∀ q : (Fin P → ℤ) × (Fin (m + 1) → Fin P), StrictMono q.2 → q ≠ p → ∀ y : Euclid (m + 1), (∀ i, 0 < y i ∧ y i < 1) → WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ) ∉ {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range q.2 → (q.1 i : ℝ) ≤ x i ∧ x i ≤ q.1 i + 1) ∧ (i ∉ Set.range q.2 → x i = q.1 i)} := by
  intro P m p hp
  -- the face map `Φ = Φ_p`, the closed face `F = F_p`, the open cube `Q = Q₁`, the closed cube `C`
  let Φ : Euclid (m + 1) → Euclid P := fun y =>
    WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)
  let F : Set (Euclid P) := {x : Euclid P | ∀ i : Fin P,
    (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)}
  let Q : Set (Euclid (m + 1)) := {y | ∀ i, 0 < y i ∧ y i < 1}
  let C : Set (Euclid (m + 1)) := {y | ∀ i, 0 ≤ y i ∧ y i ≤ 1}
  show volume Q = 1 ∧ μHE[m + 1] F = 1 ∧
    (μHE[m + 1] : Measure (Euclid P)).restrict F = Measure.map Φ (volume.restrict Q) ∧
    (∀ f : Euclid P → ℝ, ∫ x in F, f x ∂μHE[m + 1] = ∫ y in Q, f (Φ y)) ∧
    (∀ y : Euclid (m + 1), (∀ i, 0 ≤ y i ∧ y i ≤ 1) → Φ y ∈ F) ∧
    (∀ y y' : Euclid (m + 1), dist (Φ y) (Φ y') = dist y y') ∧
    (∀ x ∈ F, ∀ x' ∈ F, dist x x' ≤ Real.sqrt P) ∧ IsClosed F ∧
    ∀ q : (Fin P → ℤ) × (Fin (m + 1) → Fin P), StrictMono q.2 → q ≠ p →
      ∀ y : Euclid (m + 1), (∀ i, 0 < y i ∧ y i < 1) → Φ y ∉ {x : Euclid P | ∀ i : Fin P,
        (i ∈ Set.range q.2 → (q.1 i : ℝ) ≤ x i ∧ x i ≤ q.1 i + 1) ∧
          (i ∉ Set.range q.2 → x i = q.1 i)}
  have hinj : Injective p.2 := hp.injective
  -- Step 1: coordinates of `Φ`
  have hcoord : ∀ y i, Φ y i = p.1 i + ∑ j, if i = p.2 j then y j else 0 := by
    intro y i
    simp [Φ, Pi.single_apply]
  have hcoord_mem : ∀ y k, Φ y (p.2 k) = p.1 (p.2 k) + y k := by
    intro y k
    rw [hcoord]
    simp [hinj.eq_iff]
  have hcoord_nmem : ∀ y i, i ∉ range p.2 → Φ y i = p.1 i := by
    intro y i hi
    rw [hcoord, add_eq_left]
    exact Finset.sum_eq_zero fun j _ => ite_eq_right fun h => hi ⟨j, h.symm⟩
  -- Step 2: `Φ` is an isometry, hence a measurable embedding
  have hdist : ∀ y y' : Euclid (m + 1), dist (Φ y) (Φ y') = dist y y' := by
    intro y y'
    rw [EuclideanSpace.dist_eq, EuclideanSpace.dist_eq]
    congr 1
    symm
    refine Fintype.sum_of_injective p.2 hinj _ _ (fun i hi => ?_) (fun k => ?_)
    · rw [hcoord_nmem y i hi, hcoord_nmem y' i hi, dist_self]
      simp
    · rw [hcoord_mem, hcoord_mem, dist_add_left]
  have hiso : Isometry Φ := Isometry.of_dist_eq hdist
  have hemb : MeasurableEmbedding Φ := hiso.isClosedEmbedding.measurableEmbedding
  -- Step 3: `Φ` maps the closed cube `C` into `F`, `F ⊆ range Φ` and `Φ⁻¹(F) = C`
  have hCF : ∀ y : Euclid (m + 1), (∀ i, 0 ≤ y i ∧ y i ≤ 1) → Φ y ∈ F := by
    intro y hy i
    constructor
    · rintro ⟨k, rfl⟩
      rw [hcoord_mem]
      constructor <;> linarith [(hy k).1, (hy k).2]
    · exact hcoord_nmem y i
  have hFrange : F ⊆ range Φ := by
    intro x hx
    refine ⟨WithLp.toLp 2 fun k => x (p.2 k) - p.1 (p.2 k), PiLp.ext fun i => ?_⟩
    by_cases hi : i ∈ range p.2
    · obtain ⟨k, rfl⟩ := hi
      rw [hcoord_mem]
      simp
    · rw [hcoord_nmem _ i hi]
      exact ((hx i).2 hi).symm
  have hpreF : Φ ⁻¹' F = C := by
    ext y
    refine ⟨fun hy k => ?_, hCF y⟩
    have h := (hy (p.2 k)).1 ⟨k, rfl⟩
    rw [hcoord_mem] at h
    constructor <;> linarith [h.1, h.2]
  -- Step 4: `volume Q = volume C = 1`
  have hvol := PiLp.volume_preserving_ofLp (Fin (m + 1))
  have hQ_eq : Q = WithLp.ofLp ⁻¹' (Set.univ.pi fun _ : Fin (m + 1) => Set.Ioo (0 : ℝ) 1) := by
    ext y
    simp [Q, Set.mem_pi]
  have hC_eq : C = WithLp.ofLp ⁻¹' (Set.Icc (0 : Fin (m + 1) → ℝ) 1) := by
    ext y
    simp [C, Pi.le_def, forall_and]
  have hQmeas : MeasurableSet Q := by
    rw [hQ_eq]
    exact hvol.measurable (MeasurableSet.univ_pi fun _ => measurableSet_Ioo)
  have hvolQ : volume Q = 1 := by
    rw [hQ_eq, hvol.measure_preimage
      (MeasurableSet.univ_pi fun _ => measurableSet_Ioo).nullMeasurableSet, Real.volume_pi_Ioo]
    simp
  have hvolC : volume C = 1 := by
    rw [hC_eq, hvol.measure_preimage measurableSet_Icc.nullMeasurableSet, Real.volume_Icc_pi]
    simp
  have hQC : volume.restrict C = volume.restrict Q := by
    refine (Measure.restrict_congr_set ?_).symm
    refine ae_eq_of_subset_of_measure_ge (fun y hy i => ⟨(hy i).1.le, (hy i).2.le⟩)
      (hvolC.trans hvolQ.symm).le hQmeas.nullMeasurableSet ?_
    rw [hvolC]
    exact ENNReal.one_ne_top
  -- Step 5: `F` is closed
  have hcont : ∀ i : Fin P, Continuous fun x : Euclid P => x i := fun i =>
    PiLp.continuous_apply 2 _ i
  have hFclosed : IsClosed F := by
    have hF : F = ⋂ i : Fin P, {x : Euclid P | (i ∈ Set.range p.2 →
        (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)} :=
      Set.ofPred_forall _
    rw [hF]
    refine isClosed_iInter fun i =>
      (isClosed_imp isOpen_const ?_).inter (isClosed_imp isOpen_const ?_)
    · exact (isClosed_le continuous_const (hcont i)).inter (isClosed_le (hcont i) continuous_const)
    · exact isClosed_eq (hcont i) continuous_const
  have hFmeas : MeasurableSet F := hFclosed.measurableSet
  -- Step 6: `Hⁿ⌞F = Φ#(volume⌞Q)`
  have hmeas :
      (μHE[m + 1] : Measure (Euclid P)).restrict F = Measure.map Φ (volume.restrict Q) := by
    have h1 : Measure.map Φ (volume : Measure (Euclid (m + 1))) =
        (μHE[m + 1] : Measure (Euclid P)).restrict (range Φ) := by
      rw [← hiso.map_euclideanHausdorffMeasure, EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
    rw [← hQC, ← hpreF, ← hemb.restrict_map, h1, Measure.restrict_restrict hFmeas,
      inter_eq_left.2 hFrange]
  -- Step 7: `Hⁿ(F) = 1`
  have hFmass : μHE[m + 1] F = 1 := by
    have h := congrArg (fun μ : Measure (Euclid P) => μ univ) hmeas
    simp only [Measure.restrict_apply_univ] at h
    rw [h, hemb.map_apply, preimage_univ, Measure.restrict_apply_univ, hvolQ]
  refine ⟨hvolQ, hFmass, hmeas, fun f => ?_, hCF, hdist, ?_, hFclosed, ?_⟩
  -- Step 8: the integral formula
  · rw [hmeas, hemb.integral_map]
  -- Step 9: `diam F ≤ √P`
  · intro x hx x' hx'
    rw [EuclideanSpace.dist_eq]
    refine Real.sqrt_le_sqrt ?_
    calc ∑ i, dist (x i) (x' i) ^ 2 ≤ ∑ _i : Fin P, (1 : ℝ) := by
          refine Finset.sum_le_sum fun i _ => pow_le_one₀ dist_nonneg ?_
          by_cases hi : i ∈ range p.2
          · have h := (hx i).1 hi
            have h' := (hx' i).1 hi
            rw [Real.dist_eq, abs_le]
            constructor <;> linarith [h.1, h.2, h'.1, h'.2]
          · rw [(hx i).2 hi, (hx' i).2 hi, dist_self]
            exact zero_le_one
      _ = P := by simp
  -- Step 10: the open face `Φ(Q)` meets no other closed face
  · intro q hq hqp y hy hx
    apply hqp
    have hsub : range p.2 ⊆ range q.2 := by
      rintro _ ⟨k, rfl⟩
      by_contra hk
      have h := (hx (p.2 k)).2 hk
      rw [hcoord_mem] at h
      have a1 : (p.1 (p.2 k) : ℝ) < q.1 (p.2 k) := by linarith [(hy k).1]
      have a2 : (q.1 (p.2 k) : ℝ) < p.1 (p.2 k) + 1 := by linarith [(hy k).2]
      have b1 : p.1 (p.2 k) < q.1 (p.2 k) := by exact_mod_cast a1
      have b2 : q.1 (p.2 k) < p.1 (p.2 k) + 1 := by exact_mod_cast a2
      omega
    have hrange : range p.2 = range q.2 := by
      apply Set.eq_of_subset_of_card_le hsub
      rw [Set.card_range_of_injective hq.injective, Set.card_range_of_injective hinj]
    have h2 : p.2 = q.2 := (hp.range_inj_of_wellFoundedLT hq).1 hrange
    have h1 : p.1 = q.1 := by
      funext i
      by_cases hi : i ∈ range p.2
      · obtain ⟨k, rfl⟩ := hi
        have h := (hx (p.2 k)).1 (hrange ▸ ⟨k, rfl⟩)
        rw [hcoord_mem] at h
        have a1 : (q.1 (p.2 k) : ℝ) < p.1 (p.2 k) + 1 := by linarith [h.1, (hy k).2]
        have a2 : (p.1 (p.2 k) : ℝ) < q.1 (p.2 k) + 1 := by linarith [h.2, (hy k).1]
        have b1 : q.1 (p.2 k) < p.1 (p.2 k) + 1 := by exact_mod_cast a1
        have b2 : p.1 (p.2 k) < q.1 (p.2 k) + 1 := by exact_mod_cast a2
        omega
      · have h : (p.1 i : ℝ) = q.1 i := by
          rw [← hcoord_nmem y i hi]
          exact (hx i).2 (hrange ▸ hi)
        exact_mod_cast h
    exact Prod.ext h1.symm h2.symm

/-- **The `(m + 1)`-cells of the unit cubical lattice meeting a compact set** (Simon Ch. 6, proof
of the deformation theorem 5.1, (26)–(33), with `n = m + 1`).  `L_n` is the set of points of `ℝᴾ`
with at least `P − n` integer coordinates, `L_{n−1}` the set of those with at least `P − m`.
(0) `Hⁿ(L_{n−1}) = 0`: `L_{n−1}` lies in the countably many coordinate planes
`A(t, z) = {x : xᵢ = zᵢ, i ∈ t}`, `P ≤ m + |t|`, each the Lipschitz image of a space of dimension
`P − |t| < m + 1`.
(1) `L_n` is a finite union of finite intersections of the closed sets `{x : xᵢ ∈ ℤ}`.
(2) The faces `F_p` meeting the bounded set `K` have bounded integer corners, so they are finitely
many, and (3) by `diam F_p ≤ √P` they lie in the closed `√P`-neighbourhood of `K`.
(4) A point `x ∈ (L_n ∩ K) \ L_{n−1}` has exactly `n` non-integer coordinates; with `ι` their
increasing enumeration and `y` their fractional parts, `x = Φ_{(⌊x⌋, ι)}(y)`, `y ∈ Q₁`, and
`(⌊x⌋, ι)` is a face meeting `K`.  (5) By (0) this covers `Hⁿ`-a.e. point of `L_n ∩ K`. -/
theorem Submission.dor_lmb_fcd_fr_skeleton_cells : ∀ (P m : ℕ) (K : Set (Euclid P)), m + 1 < P → IsCompact K → ∃ s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P)), (∀ p ∈ s, StrictMono p.2) ∧ (∀ p ∈ s, {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)} ⊆ cthickening (Real.sqrt P) K) ∧ IsClosed {x : Euclid P | ∃ t : Finset (Fin P), P ≤ m + 1 + t.card ∧ ∀ i ∈ t, ∃ z : ℤ, x i = z} ∧ ∀ᵐ x ∂(μHE[m + 1].restrict ({x : Euclid P | ∃ t : Finset (Fin P), P ≤ m + 1 + t.card ∧ ∀ i ∈ t, ∃ z : ℤ, x i = z} ∩ K)), ∃ p ∈ s, ∃ y : Euclid (m + 1), (∀ i, 0 < y i ∧ y i < 1) ∧ WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ) = x := by
  intro P m K hmP hK
  -- Step 0: `Hⁿ(L_{n−1}) = 0`, i.e. the points with at least `P − m` integer coordinates are
  -- `μHE[m + 1]`-null
  have hnull : μHE[m + 1] {x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + s.card ∧
      ∀ i ∈ s, ∃ z : ℤ, x i = z} = 0 := by
    -- each coordinate plane `A(s, z)` with `P ≤ m + |s|` is `μH[m + 1]`-null
    have hplane : ∀ s : Finset (Fin P), P ≤ m + s.card → ∀ z : Fin P → ℤ,
        μH[((m + 1 : ℕ) : ℝ)] {x : Euclid P | ∀ i ∈ s, x i = z i} = 0 := by
      intro s hs z
      -- `A(s, z)` is the image of the Lipschitz map `g : t ↦ (zᵢ on s, tᵢ off s)`
      let g : ({i // i ∉ s} → ℝ) → Euclid P := fun t =>
        WithLp.toLp 2 fun i => if h : i ∈ s then (z i : ℝ) else t ⟨i, h⟩
      have hg1 : LipschitzWith 1 fun t : {i // i ∉ s} → ℝ =>
          fun i : Fin P => if h : i ∈ s then (z i : ℝ) else t ⟨i, h⟩ := by
        refine LipschitzWith.of_dist_le_mul fun t t' => ?_
        rw [NNReal.coe_one, one_mul]
        refine (dist_pi_le_iff dist_nonneg).2 fun i => ?_
        by_cases h : i ∈ s
        · simp [h]
        · simpa [h] using dist_le_pi_dist t t' ⟨i, h⟩
      have hg : LipschitzWith _ g := (PiLp.lipschitzWith_toLp 2 fun _ : Fin P => ℝ).comp hg1
      have hsub : {x : Euclid P | ∀ i ∈ s, x i = z i} ⊆ g '' univ := by
        intro x hx
        refine ⟨fun j => x j.1, mem_univ _, ?_⟩
        ext i
        by_cases h : i ∈ s
        · simp [g, h, hx i h]
        · simp [g, h]
      -- the source of `g` has dimension `P − |s| ≤ m < m + 1`, so it is `μH[m + 1]`-null
      have hcard : Fintype.card {i // i ∉ s} ≤ m := by
        rw [Fintype.card_subtype_compl, Fintype.card_coe, Fintype.card_fin]
        omega
      have huniv : (μH[((m + 1 : ℕ) : ℝ)] : Measure ({i // i ∉ s} → ℝ)) univ = 0 := by
        rw [← Metric.iUnion_ball_nat (0 : {i // i ∉ s} → ℝ)]
        refine measure_iUnion_null fun n => ?_
        refine (Measure.hausdorffMeasure_zero_or_top
          (d₁ := (Fintype.card {i // i ∉ s} : ℝ)) ?_ _).resolve_right ?_
        · exact_mod_cast Nat.lt_succ_of_le hcard
        · rw [hausdorffMeasure_pi_real]
          exact measure_ball_lt_top.ne
      refine measure_mono_null hsub (nonpos_iff_eq_zero.1 ?_)
      calc μH[((m + 1 : ℕ) : ℝ)] (g '' univ)
          ≤ _ ^ ((m + 1 : ℕ) : ℝ) * μH[((m + 1 : ℕ) : ℝ)] (univ : Set ({i // i ∉ s} → ℝ)) :=
            hg.hausdorffMeasure_image_le (Nat.cast_nonneg _) univ
        _ = 0 := by rw [huniv, mul_zero]
    -- the set is covered by the countably many planes `A(s, z)`, `P ≤ m + |s|`, `z ∈ ℤᴾ`
    have hcover : {x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + s.card ∧
        ∀ i ∈ s, ∃ z : ℤ, x i = z} ⊆ ⋃ (s : {s : Finset (Fin P) // P ≤ m + s.card})
          (z : Fin P → ℤ), {x : Euclid P | ∀ i ∈ s.1, x i = z i} := by
      rintro x ⟨s, hs, hx⟩
      choose! z hz using hx
      exact mem_iUnion₂.2 ⟨⟨s, hs⟩, z, hz⟩
    -- countable subadditivity gives `μH[m + 1]`-nullity, and `μHE[m + 1] = c • μH[m + 1]`
    have hnullH : μH[((m + 1 : ℕ) : ℝ)] {x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + s.card ∧
        ∀ i ∈ s, ∃ z : ℤ, x i = z} = 0 :=
      measure_mono_null hcover
        (measure_iUnion_null fun s => measure_iUnion_null fun z => hplane s.1 s.2 z)
    rw [Measure.euclideanHausdorffMeasure_def, Measure.smul_apply, hnullH, smul_zero]
  -- Step 1: `L_n` is closed, a finite union of finite intersections of the closed sets
  -- `{x : xᵢ ∈ ℤ}`
  have hLclosed : IsClosed {x : Euclid P | ∃ t : Finset (Fin P), P ≤ m + 1 + t.card ∧
      ∀ i ∈ t, ∃ z : ℤ, x i = z} := by
    have hcoord : ∀ i : Fin P, IsClosed {x : Euclid P | ∃ z : ℤ, x i = z} := by
      intro i
      have h : {x : Euclid P | ∃ z : ℤ, x i = z} =
          (fun x : Euclid P => x i) ⁻¹' range ((↑) : ℤ → ℝ) := by
        ext x
        exact ⟨fun ⟨z, hz⟩ => ⟨z, hz.symm⟩, fun ⟨z, hz⟩ => ⟨z, hz.symm⟩⟩
      rw [h]
      exact Int.isClosedEmbedding_coe_real.isClosed_range.preimage (by fun_prop)
    have h : {x : Euclid P | ∃ t : Finset (Fin P), P ≤ m + 1 + t.card ∧
        ∀ i ∈ t, ∃ z : ℤ, x i = z} = ⋃ (t : Finset (Fin P)) (_ : P ≤ m + 1 + t.card),
          ⋂ i ∈ t, {x : Euclid P | ∃ z : ℤ, x i = z} := by
      ext x
      simp only [mem_ofPred_eq, mem_iUnion, mem_iInter, exists_prop]
    rw [h]
    exact isClosed_iUnion_of_finite fun t => isClosed_iUnion_of_finite fun _ =>
      isClosed_iInter fun i => isClosed_iInter fun _ => hcoord i
  classical
  -- Step 2: the faces `F_p` meeting `K ⊆ B̄_R(0)` have corners with `|zᵢ| ≤ ⌈R⌉ + 1`, so they
  -- form a finite set
  obtain ⟨R, hR⟩ := hK.isBounded.exists_norm_le
  have hKcoord : ∀ x ∈ K, ∀ i : Fin P, |x i| ≤ R := fun x hx i =>
    (Real.norm_eq_abs (x i)).symm.le.trans ((PiLp.norm_apply_le x i).trans (hR x hx))
  let faces : Set ((Fin P → ℤ) × (Fin (m + 1) → Fin P)) := {p | StrictMono p.2 ∧ ∃ k ∈ K,
    k ∈ {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧
      (i ∉ Set.range p.2 → x i = p.1 i)}}
  have hfin : faces.Finite := by
    refine ((Set.Finite.pi (t := fun _ : Fin P => Set.Icc (-(⌈R⌉ + 1)) (⌈R⌉ + 1))
      fun _ => Set.finite_Icc _ _).prod (Set.finite_univ (α := Fin (m + 1) → Fin P))).subset ?_
    rintro p ⟨-, k, hkK, hkF⟩
    have hceil := Int.le_ceil R
    refine ⟨fun i _ => ?_, mem_univ _⟩
    -- `zᵢ ≤ xᵢ ≤ R` and `zᵢ ≥ xᵢ − 1 ≥ −R − 1` for `x ∈ F_p ∩ K`
    obtain ⟨hk₁, hk₂⟩ := abs_le.1 (hKcoord k hkK i)
    have hzb : (p.1 i : ℝ) ≤ R ∧ -R - 1 ≤ (p.1 i : ℝ) := by
      by_cases hi : i ∈ Set.range p.2
      · obtain ⟨h₁, h₂⟩ := (hkF i).1 hi
        constructor <;> linarith
      · have h := (hkF i).2 hi
        constructor <;> linarith
    have h₁ : ((-(⌈R⌉ + 1) : ℤ) : ℝ) ≤ p.1 i := by
      push_cast
      linarith [hzb.2]
    have h₂ : (p.1 i : ℝ) ≤ ((⌈R⌉ + 1 : ℤ) : ℝ) := by
      push_cast
      linarith [hzb.1]
    exact ⟨by exact_mod_cast h₁, by exact_mod_cast h₂⟩
  refine ⟨hfin.toFinset, fun p hp => (hfin.mem_toFinset.1 hp).1, fun p hp => ?_, hLclosed, ?_⟩
  · -- Step 3: `diam F_p ≤ √P` and `F_p ∩ K ≠ ∅` give `F_p ⊆ cthickening √P K`
    obtain ⟨hp2, k, hkK, hkF⟩ := hfin.mem_toFinset.1 hp
    obtain ⟨-, -, -, -, -, -, hdiam, -, -⟩ := Submission.dor_lmb_fcd_fr_face_geometry P m p hp2
    exact fun x hx => mem_cthickening_of_dist_le x k _ K hkK (hdiam x hx k hkF)
  · -- Steps 4–5: off the null set `L_{n−1}` (step 0), every `x ∈ L_n ∩ K` is `Φ_p(y)` for a face
    -- `p` meeting `K` and some `y ∈ Q₁`
    rw [ae_restrict_iff' (hLclosed.inter hK.isClosed).measurableSet]
    filter_upwards [measure_eq_zero_iff_ae_notMem.1 hnull] with x hxL' hx
    obtain ⟨⟨t, ht, hxt⟩, hxK⟩ := hx
    -- `T` the integer and `S` the non-integer coordinates of `x`: `|T| = P − n`, `|S| = n`
    set T : Finset (Fin P) := Finset.univ.filter fun i => ∃ z : ℤ, x i = z with hT
    set S : Finset (Fin P) := Finset.univ.filter fun i => ¬ ∃ z : ℤ, x i = z with hS
    have hTS : T.card + S.card = P := by
      rw [hT, hS, Finset.card_filter_add_card_filter_not, Finset.card_univ, Fintype.card_fin]
    have htT : t.card ≤ T.card := Finset.card_le_card fun i hi =>
      Finset.mem_filter.2 ⟨Finset.mem_univ i, hxt i hi⟩
    have hT' : ¬ P ≤ m + T.card := fun h =>
      hxL' ⟨T, h, fun i hi => (Finset.mem_filter.1 hi).2⟩
    have hScard : S.card = m + 1 := by omega
    -- `ι` enumerates `S` increasingly, `z = ⌊x⌋`, and `y` collects the fractional parts
    let ι := S.orderEmbOfFin hScard
    have hιS : Set.range ι = S := Finset.range_orderEmbOfFin S hScard
    let y : Euclid (m + 1) := WithLp.toLp 2 fun k => Int.fract (x (ι k))
    have hy : ∀ k, 0 < y k ∧ y k < 1 := by
      intro k
      have hk : ι k ∈ S := Finset.orderEmbOfFin_mem S hScard k
      rw [hS, Finset.mem_filter] at hk
      exact ⟨Int.fract_pos.2 fun h => hk.2 ⟨_, h⟩, Int.fract_lt_one _⟩
    have hΦ : WithLp.toLp 2 (fun i => ((⌊x i⌋ : ℤ) : ℝ)) +
        ∑ j, y j • EuclideanSpace.single (ι j) (1 : ℝ) = x := by
      ext i
      rw [PiLp.add_apply, PiLp.toLp_apply, WithLp.ofLp_sum, Finset.sum_apply]
      simp only [PiLp.smul_apply, PiLp.single_apply, smul_eq_mul, mul_ite, mul_one, mul_zero]
      by_cases hi : i ∈ S
      · -- `i = ι(j₀)`: the coordinate is `⌊xᵢ⌋ + fract xᵢ = xᵢ`
        obtain ⟨j₀, rfl⟩ : i ∈ Set.range ι := by rw [hιS]; exact hi
        rw [Fintype.sum_eq_single j₀, ite_eq_left rfl]
        · exact Int.floor_add_fract _
        · intro j hj
          exact ite_eq_right (ι.injective.ne hj.symm)
      · -- `i ∉ range ι`: the coordinate is `⌊xᵢ⌋ = xᵢ ∈ ℤ`
        obtain ⟨z, hz⟩ : ∃ z : ℤ, x i = z := by
          by_contra h
          exact hi (Finset.mem_filter.2 ⟨Finset.mem_univ i, h⟩)
        have h0 : ∀ j, (if i = ι j then y j else 0) = 0 := fun j =>
          ite_eq_right fun h => hi (by rw [h]; exact Finset.orderEmbOfFin_mem S hScard j)
        simp only [h0, Finset.sum_const_zero, add_zero, hz, Int.floor_intCast]
    -- `x = Φ_p(y) ∈ F_p ∩ K` for `p = (⌊x⌋, ι)`, so `p` is one of the faces
    let p : (Fin P → ℤ) × (Fin (m + 1) → Fin P) := (fun i => ⌊x i⌋, ι)
    have hΦp : WithLp.toLp 2 (fun i => (p.1 i : ℝ)) +
        ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ) = x := hΦ
    have hp : p ∈ faces := by
      refine ⟨ι.strictMono, x, hxK, ?_⟩
      obtain ⟨-, -, -, -, hcube, -, -, -, -⟩ :=
        Submission.dor_lmb_fcd_fr_face_geometry P m p ι.strictMono
      have h := hcube y fun k => ⟨(hy k).1.le, (hy k).2.le⟩
      rwa [hΦp] at h
    exact ⟨p, hfin.mem_toFinset.2 hp, y, hy, hΦp⟩
/-- **Unit orientations of the approximate tangent plane of a set in a coordinate plane** (Simon
Ch. 6, proof of 5.1, (26)–(27)).  Let `A ⊆ x + V`, `V = span{e_{ι j}}`, have approximate tangent
space `Q` at `x`, and let `ξ` orient `Q`.  The blow-ups `λ⁻¹(A − x)` lie in `V`, so every test
function vanishing on `V` has zero limit integral `∫_Q f dHⁿ`; since `Q` is the support of `Hⁿ⌞Q`,
this forces `Q ⊆ V`.  The orthonormal frame `τ` of `Q` then satisfies `τₖ = Σⱼ Mⱼₖ e_{ι j}` with
`MᵀM = 1`, so `α(τ) = det M · α(e_ι)` with `det M = ±1` for every `n`-covector `α`. -/
theorem Submission.dor_lmb_fcd_fr_plane_orientation : ∀ (P n : ℕ) (ι : Fin n → Fin P) (A : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)) (ξ : MultiVector P n), StrictMono ι → (∀ a ∈ A, ∀ i, (∀ j, ι j ≠ i) → a i = x i) → HasApproximateTangentSpaceAt n A x Q → IsUnitOrientationOf ξ Q → (∀ α : Covector (Euclid P) n, ξ α = α (fun j => EuclideanSpace.single (ι j) (1 : ℝ))) ∨ (∀ α : Covector (Euclid P) n, ξ α = -α (fun j => EuclideanSpace.single (ι j) (1 : ℝ))) := by
  intro P n ι A x Q ξ hι hA hQ hξ
  obtain ⟨τ, hτ, hτQ, hξτ⟩ := hξ
  -- Step 1: every `q ∈ Q` has `qᵢ = 0` for `i ∉ range ι`
  have hQV : ∀ q ∈ Q, ∀ i, (∀ j, ι j ≠ i) → q i = 0 := by
    intro q hq i hi
    by_contra hqi
    have hc : 0 < |q i| := abs_pos.2 hqi
    -- the test function `g w = max 0 (|qᵢ| - |w - q|)`: positive near `q`, zero where `wᵢ = 0`
    let g : Euclid P → ℝ := fun w => max 0 (|q i| - dist w q)
    have hgc : Continuous g := by fun_prop
    have hgs : HasCompactSupport g := by
      refine HasCompactSupport.intro (isCompact_closedBall q |q i|) fun w hw => ?_
      rw [mem_closedBall, not_le] at hw
      exact max_eq_left (by linarith)
    let f : CompactlySupportedContinuousMap (Euclid P) ℝ :=
      { toFun := g
        continuous_toFun := hgc
        hasCompactSupport' := hgs }
    have hfg : ∀ w, f w = g w := fun _ => rfl
    have hg0 : ∀ w : Euclid P, w i = 0 → g w = 0 := by
      intro w hw
      have h1 : |q i| ≤ dist w q := by
        have h2 := PiLp.norm_apply_le (w - q) i
        rw [dist_eq_norm]
        simpa [hw] using h2
      exact max_eq_left (by linarith)
    -- the integrals over the blow-ups `λ⁻¹(A - x) ⊆ {wᵢ = 0}` vanish, so `∫_Q f dHⁿ = 0`
    have hlim : ∫ y in (Q : Set (Euclid P)), f y ∂μHE[n] = 0 := by
      refine tendsto_nhds_unique (hQ.2 f) (tendsto_const_nhds.congr fun r => ?_)
      refine (setIntegral_eq_zero_of_forall_eq_zero ?_).symm
      rintro _ ⟨a, ha, rfl⟩
      rw [hfg]
      apply hg0
      simp [Poincare.SimonGMT.Chapter03.blowUpMap, hA a ha i hi]
    -- but `q` lies in the support `Q` of `Hⁿ⌞Q` and `f > 0` near `q`, so `∫_Q f dHⁿ > 0`
    have hpos : 0 < ∫ y in (Q : Set (Euclid P)), f y ∂μHE[n] := by
      have := Poincare.SimonGMT.Chapter03.regular_euclideanHausdorffMeasure_restrict_submodule hQ.1
      have hf0 : (0 : Euclid P → ℝ) ≤ ⇑f := fun w => by rw [hfg]; exact le_max_left _ _
      rw [integral_pos_iff_support_of_nonneg hf0 f.integrable]
      have hq' : q ∈ (μHE[n].restrict (Q : Set (Euclid P))).support := by
        rw [Poincare.SimonGMT.Chapter03.support_euclideanHausdorffMeasure_restrict_submodule hQ.1]
        exact hq
      refine (Measure.mem_support_iff_forall q).1 hq' _ ?_
      refine Filter.mem_of_superset (ball_mem_nhds q hc) fun w hw => ?_
      rw [mem_ball] at hw
      rw [Function.mem_support, hfg]
      exact (lt_max_of_lt_right (by linarith)).ne'
    linarith
  -- Step 2: the frame `τ` lies in `V = span{e_ι}`
  have hτV : ∀ k i, (∀ j, ι j ≠ i) → τ k i = 0 := fun k i hi =>
    hQV (τ k) (by rw [← hτQ]; exact Submodule.subset_span (mem_range_self k)) i hi
  -- coordinates `m k = (τ k (ι j))ⱼ` of `τ k` in the frame `e_ι`, and `L w = Σⱼ wⱼ e_{ι j}`
  let m : Fin n → Fin n → ℝ := fun k j => τ k (ι j)
  let L : (Fin n → ℝ) →ₗ[ℝ] Euclid P :=
    Fintype.linearCombination ℝ fun j => EuclideanSpace.single (ι j) (1 : ℝ)
  have hLm : ∀ k, L (m k) = τ k := by
    intro k
    refine PiLp.ext fun i => ?_
    simp only [L, m, Fintype.linearCombination_apply, WithLp.ofLp_sum, WithLp.ofLp_smul,
      Finset.sum_apply, Pi.smul_apply, smul_eq_mul, PiLp.single_apply, mul_ite, mul_one, mul_zero]
    by_cases h : ∃ j, ι j = i
    · obtain ⟨j, rfl⟩ := h
      simp [hι.injective.eq_iff]
    · have h' : ∀ j, ι j ≠ i := fun j hj => h ⟨j, hj⟩
      rw [hτV k i h']
      exact Finset.sum_eq_zero fun j _ => ite_eq_right (h' j).symm
  have hLe : ∀ k, L (Pi.basisFun ℝ (Fin n) k) = EuclideanSpace.single (ι k) (1 : ℝ) := by
    intro k
    rw [Pi.basisFun_apply, Fintype.linearCombination_apply_single, one_smul]
  -- Step 3: `M = (τ k (ι j))` is orthogonal, so `det M = ±1`
  let M : Matrix (Fin n) (Fin n) ℝ := (Pi.basisFun ℝ (Fin n)).toMatrix m
  have hMM : M.transpose * M = 1 := by
    ext k l
    rw [Matrix.mul_apply, Matrix.one_apply, ← orthonormal_iff_ite.1 hτ k l, PiLp.inner_apply]
    simp only [Matrix.transpose_apply, M, Module.Basis.toMatrix_apply, Pi.basisFun_repr, m]
    refine Fintype.sum_of_injective ι hι.injective _ _ ?_ fun j => ?_
    · rintro i hi
      rw [hτV k i fun j hj => hi ⟨j, hj⟩]
      simp
    · simp [mul_comm]
  have hdet : M.det = 1 ∨ M.det = -1 := by
    have h := congrArg Matrix.det hMM
    rw [Matrix.det_mul, Matrix.det_transpose, Matrix.det_one] at h
    exact mul_self_eq_one_iff.1 h
  -- Step 4: `α(τ) = det M · α(e_ι)` for every `n`-covector `α`
  have hα : ∀ α : Covector (Euclid P) n,
      α τ = M.det * α (fun j => EuclideanSpace.single (ι j) (1 : ℝ)) := by
    intro α
    have key := DFunLike.congr_fun
      (AlternatingMap.eq_smul_basis_det (Pi.basisFun ℝ (Fin n)) (α.toAlternatingMap.compLinearMap L)) m
    simp only [AlternatingMap.compLinearMap_apply, AlternatingMap.smul_apply, smul_eq_mul,
      ContinuousAlternatingMap.coe_toAlternatingMap, hLm, hLe, Module.Basis.det_apply] at key
    rw [mul_comm] at key
    exact key
  rcases hξτ with h | h <;> rcases hdet with hd | hd
  · exact Or.inl fun α => by rw [h, hα, hd, one_mul]
  · exact Or.inr fun α => by rw [h, hα, hd, neg_one_mul]
  · exact Or.inr fun α => by rw [h, hα, hd, one_mul]
  · exact Or.inl fun α => by rw [h, hα, hd, neg_one_mul, neg_neg]
/-- **Coordinate covectors** (Simon Ch. 6, §1, 1.1, 1.2 and 1.5).  For `J : Fin k → Fin P`,
`dx^J = dx^{J(0)} ∧ ⋯ ∧ dx^{J(k−1)}` is the alternatization of the continuous multilinear map
`v ↦ ∏ᵣ (v_r)_{J(r)}`, so `dx^J(v) = Σ_σ sign σ ∏ᵣ (v_{σ(r)})_{J(r)}`.  At `e_I` the `σ`-term is
`[I ∘ σ = J]`; for strictly increasing `I, J`, `I ∘ σ = J` makes `σ` strictly increasing, hence
`σ = id` and `I = J`, so `dx^J(e_I) = [I = J]`.  For an injective family of strictly increasing
`J_l`, `(Σ_l c_l dx^{J_l})(e_I)` is `c_l` if `I = J_l` and `0` if `I ∉ range J`; summing the
squares over strictly increasing `I` gives `covectorEuclideanNorm (Σ_l c_l dx^{J_l}) = √(Σ_l c_l²)`.
-/
theorem Submission.dor_lmb_fcd_fr_coordinate_covectors : ∀ (P k : ℕ), ∃ dx : (Fin k → Fin P) → Covector (Euclid P) k, (∀ I J : Fin k → Fin P, StrictMono I → StrictMono J → dx J (fun r => EuclideanSpace.single (I r) (1 : ℝ)) = if I = J then 1 else 0) ∧ ∀ (N : ℕ) (J : Fin N → Fin k → Fin P) (c : Fin N → ℝ), Function.Injective J → (∀ l, StrictMono (J l)) → covectorEuclideanNorm (∑ l, c l • dx (J l)) = Real.sqrt (∑ l, c l ^ 2) := by
  intro P k
  classical
  -- Step 1: `dx^J` is the alternatization of `v ↦ ∏ᵣ (v_r)_{J(r)}`
  let dx : (Fin k → Fin P) → Covector (Euclid P) k := fun J =>
    ContinuousMultilinearMap.alternatization
      ((ContinuousMultilinearMap.mkPiAlgebra ℝ (Fin k) ℝ).compContinuousLinearMap
        (fun r => EuclideanSpace.proj (J r)))
  have hdx : ∀ (J : Fin k → Fin P) (v : Fin k → Euclid P),
      dx J v = ∑ σ : Equiv.Perm (Fin k), Equiv.Perm.sign σ • ∏ r, (v (σ r)) (J r) := by
    intro J v
    simp only [dx, ContinuousMultilinearMap.alternatization_apply_apply,
      ContinuousMultilinearMap.compContinuousLinearMap_apply,
      ContinuousMultilinearMap.mkPiAlgebra_apply, Function.comp_apply]
    rfl
  -- Step 2: if `I ∘ σ = J` with `I, J` strictly increasing, then `σ = id` and `I = J`
  have hperm : ∀ (I J : Fin k → Fin P), StrictMono I → StrictMono J →
      ∀ σ : Equiv.Perm (Fin k), (∀ r, I (σ r) = J r) → σ = 1 ∧ I = J := by
    intro I J hI hJ σ hσ
    have hσmono : StrictMono σ := by
      intro a b hab
      have : I (σ a) < I (σ b) := by rw [hσ a, hσ b]; exact hJ hab
      exact hI.lt_iff_lt.mp this
    have hrange : Set.range σ = Set.range (id : Fin k → Fin k) := by
      rw [Set.range_id]; exact σ.surjective.range_eq
    have hid : (σ : Fin k → Fin k) = id :=
      (StrictMono.range_inj_of_wellFoundedLT hσmono strictMono_id).mp hrange
    have hσ1 : σ = 1 := by
      ext r; simp [congrFun hid r]
    refine ⟨hσ1, ?_⟩
    funext r
    have := hσ r
    rw [hσ1] at this
    simpa using this
  -- duality `dx^J(e_I) = [I = J]` for strictly increasing `I, J`
  have hdual : ∀ I J : Fin k → Fin P, StrictMono I → StrictMono J →
      dx J (fun r => EuclideanSpace.single (I r) (1 : ℝ)) = if I = J then 1 else 0 := by
    intro I J hI hJ
    rw [hdx]
    have hterm : ∀ σ : Equiv.Perm (Fin k),
        ∏ r, (EuclideanSpace.single (I (σ r)) (1 : ℝ)) (J r) =
          if (∀ r, I (σ r) = J r) then 1 else 0 := by
      intro σ
      split_ifs with h
      · refine Finset.prod_eq_one fun r _ => ?_
        rw [h r]; simp
      · push Not at h
        obtain ⟨r, hr⟩ := h
        refine Finset.prod_eq_zero (Finset.mem_univ r) ?_
        simp [Ne.symm hr]
    simp_rw [hterm]
    split_ifs with hIJ
    · subst hIJ
      rw [Finset.sum_eq_single (1 : Equiv.Perm (Fin k))]
      · simp
      · intro σ _ hσ
        rw [ite_eq_right]
        · simp
        · intro h
          exact hσ (hperm I I hI hI σ h).1
      · simp
    · refine Finset.sum_eq_zero fun σ _ => ?_
      rw [ite_eq_right]
      · simp
      · intro h
        exact hIJ (hperm I J hI hJ σ h).2
  refine ⟨dx, hdual, ?_⟩
  intro N J c hJinj hJmono
  -- Step 3: values of `Σ_l c_l dx^{J_l}` on the coordinate frames `e_I`
  have hval : ∀ I : Fin k → Fin P, StrictMono I →
      (∑ l, c l • dx (J l)) (fun r => EuclideanSpace.basisFun (Fin P) ℝ (I r)) =
        ∑ l, if I = J l then c l else 0 := by
    intro I hI
    simp only [EuclideanSpace.basisFun_apply]
    rw [ContinuousAlternatingMap.sum_apply]
    refine Finset.sum_congr rfl fun l _ => ?_
    rw [ContinuousAlternatingMap.smul_apply, hdual I (J l) hI (hJmono l)]
    split_ifs <;> simp
  -- by injectivity of `J`, at most one `l` has `J_l = I`
  have hsq : ∀ I : Fin k → Fin P,
      (∑ l, if I = J l then c l else 0) ^ 2 = ∑ l, if I = J l then c l ^ 2 else 0 := by
    intro I
    by_cases hex : ∃ l, I = J l
    · obtain ⟨l₀, hl₀⟩ := hex
      have h1 : (∑ l, if I = J l then c l else 0) = c l₀ := by
        rw [Finset.sum_eq_single l₀]
        · simp [hl₀]
        · intro l _ hl
          rw [ite_eq_right]
          intro h
          exact hl (hJinj (h.symm.trans hl₀))
        · simp
      have h2 : (∑ l, if I = J l then c l ^ 2 else 0) = c l₀ ^ 2 := by
        rw [Finset.sum_eq_single l₀]
        · simp [hl₀]
        · intro l _ hl
          rw [ite_eq_right]
          intro h
          exact hl (hJinj (h.symm.trans hl₀))
        · simp
      rw [h1, h2]
    · push Not at hex
      simp [hex]
  -- Step 4: sum the squares over strictly increasing `I` and exchange the finite sums
  unfold covectorEuclideanNorm
  congr 1
  calc (∑ I : Fin k → Fin P, if StrictMono I then
          ((∑ l, c l • dx (J l)) (fun i => EuclideanSpace.basisFun (Fin P) ℝ (I i))) ^ 2 else 0)
      = ∑ I : Fin k → Fin P, ∑ l, (if I = J l then c l ^ 2 else 0) := by
        refine Finset.sum_congr rfl fun I _ => ?_
        split_ifs with hI
        · rw [hval I hI, hsq I]
        · symm
          refine Finset.sum_eq_zero fun l _ => ?_
          rw [ite_eq_right]
          rintro rfl
          exact hI (hJmono l)
    _ = ∑ l, ∑ I : Fin k → Fin P, (if I = J l then c l ^ 2 else 0) := Finset.sum_comm
    _ = ∑ l, c l ^ 2 := by
        refine Finset.sum_congr rfl fun l _ => ?_
        simp
/-- **Change of variables along an isometry** (the Jacobian-one case of the area formula behind
Simon Ch. 6, 2.24(3) and 3.3–3.9).  An isometry `f : ℝᴾ → ℝ^Q`, not necessarily linear, is a
closed and hence measurable embedding, and `f_#Hᵈ = Hᵈ⌞f(ℝᴾ)`; so `f_#(Hᵈ⌞A) = Hᵈ⌞f(A)` for every
`A ⊆ ℝᴾ`, and `∫_{f(A)} g dHᵈ = ∫_A g ∘ f dHᵈ` for every real or `[0, ∞]`-valued `g`, with no
measurability or integrability assumptions. -/
theorem Submission.dor_lmb_fc_dtop_ip_isometry_change_of_variables : ∀ (P Q d : ℕ) (f : Euclid P → Euclid Q), Isometry f → MeasurableEmbedding f ∧ (∀ A : Set (Euclid P), Measure.map f ((μHE[d] : Measure (Euclid P)).restrict A) = (μHE[d] : Measure (Euclid Q)).restrict (f '' A)) ∧ (∀ (A : Set (Euclid P)) (g : Euclid Q → ℝ), ∫ y in f '' A, g y ∂μHE[d] = ∫ x in A, g (f x) ∂μHE[d]) ∧ ∀ (A : Set (Euclid P)) (g : Euclid Q → ℝ≥0∞), ∫⁻ y in f '' A, g y ∂μHE[d] = ∫⁻ x in A, g (f x) ∂μHE[d] := by
  intro P Q d f hf
  have hfe : MeasurableEmbedding f := hf.isClosedEmbedding.measurableEmbedding
  -- `f_#(Hᵈ⌞A) = (f_#Hᵈ)⌞f(A) = (Hᵈ⌞range f)⌞f(A) = Hᵈ⌞f(A)`, using `f⁻¹(f(A)) = A`
  have hmap : ∀ A : Set (Euclid P), Measure.map f ((μHE[d] : Measure (Euclid P)).restrict A) =
      (μHE[d] : Measure (Euclid Q)).restrict (f '' A) := by
    intro A
    rw [← Measure.restrict_restrict_of_subset (image_subset_range f A),
      ← hf.map_euclideanHausdorffMeasure, hfe.restrict_map, hf.injective.preimage_image]
  refine ⟨hfe, hmap, fun A g => ?_, fun A g => ?_⟩
  · rw [← hmap A, hfe.integral_map]
  · rw [← hmap A, hfe.lintegral_map]

/-- Approximate tangent spaces are transported by a linear isometric embedding `L : ℝᴾ → ℝ^Q`
(Simon Ch. 3, 1.4; cf. `T_y(f(M))` in Ch. 6, 3.7): if `S = TₓM` then `L(S) = T_{Lx}(L(M))`.  The
injective `L` restricts to `S ≃ L(S)`, so `dim L(S) = d`.  By linearity
`η_{Lx,r}(L(M)) = L(η_{x,r}(M))` for every `r`; for `f ∈ C_c(ℝ^Q)`, `f ∘ L ∈ C_c(ℝᴾ)` as `L` is a
closed embedding, and the Jacobian-one change of variables `∫_{L(A)} f dHᵈ = ∫_A f ∘ L dHᵈ`
(`dor_lmb_fc_dtop_ip_isometry_change_of_variables`) turns the blow-up integrals and the limit
`∫_{L(S)} f dHᵈ` into those of `f ∘ L`. -/
theorem Submission.dor_lmb_fc_dtop_ip_approxTangent_isometry : ∀ (P Q d : ℕ) (L : Euclid P →L[ℝ] Euclid Q) (M : Set (Euclid P)) (x : Euclid P) (S : Submodule ℝ (Euclid P)), Isometry L → HasApproximateTangentSpaceAt d M x S → HasApproximateTangentSpaceAt d (L '' M) (L x) (Submodule.map (L : Euclid P →ₗ[ℝ] Euclid Q) S) := by
  intro P Q d L M x S hL hS
  -- `∫_{L(A)} h dHᵈ = ∫_A h ∘ L dHᵈ` for every `A ⊆ ℝᴾ`
  obtain ⟨-, -, hint, -⟩ :=
    Submission.dor_lmb_fc_dtop_ip_isometry_change_of_variables P Q d L hL
  -- `dim L(S) = dim S = d`, as the injective `L` restricts to `S ≃ L(S)`
  refine ⟨(Submodule.equivMapOfInjective (L : Euclid P →ₗ[ℝ] Euclid Q) hL.injective
    S).finrank_eq.symm.trans hS.1, fun f => ?_⟩
  -- `g = f ∘ L ∈ C_c(ℝᴾ)`, as `L` is a closed embedding
  let g : CompactlySupportedContinuousMap (Euclid P) ℝ :=
    ⟨⟨f ∘ L, (map_continuous f).comp L.continuous⟩,
      f.hasCompactSupport.comp_isClosedEmbedding hL.isClosedEmbedding⟩
  -- `∫_{L(S)} f dHᵈ = ∫_S g dHᵈ`
  have hlim : ∫ y in (Submodule.map (L : Euclid P →ₗ[ℝ] Euclid Q) S : Set (Euclid Q)),
      f y ∂μHE[d] = ∫ y in (S : Set (Euclid P)), g y ∂μHE[d] := by
    rw [Submodule.map_coe, ContinuousLinearMap.coe_coe, hint]
    rfl
  rw [hlim]
  refine (hS.2 g).congr fun r => ?_
  -- `η_{Lx,r}(L(M)) = L(η_{x,r}(M))`, so `∫_{η_{Lx,r}(L(M))} f dHᵈ = ∫_{η_{x,r}(M)} g dHᵈ`
  have hblow : Poincare.SimonGMT.Chapter03.blowUpMap (L x) r '' (L '' M) =
      L '' (Poincare.SimonGMT.Chapter03.blowUpMap x r '' M) := by
    rw [image_image, image_image]
    refine image_congr fun w _ => ?_
    simp only [Poincare.SimonGMT.Chapter03.blowUpMap, map_smul, map_sub]
  rw [hblow, hint]
  rfl
/-- **Simon Ch. 6, 3.4–3.5 and 3.7** (the Jacobian-one case): an isometric linear map
`L : ℝᴾ → ℝ^Q` transports unit orientations.  If `ξ = ±τ₁ ∧ ⋯ ∧ τ_d` orients `S` (`τ`
orthonormal), then `L ∘ τ` is orthonormal, since `L` fixes `0` and so preserves norms and inner
products; it spans `L(S)`, the span of an image being the image of the span; and `(∧L)ξ = ξ ∘ L^*`
pairs as `β ↦ ξ(L^*β) = ±(L^*β)(τ) = ±β(L ∘ τ)`, so `(∧L)ξ = ±Lτ₁ ∧ ⋯ ∧ Lτ_d` with the same
sign. -/
theorem Submission.dor_lmb_fc_dtop_ip_unitOrientation_isometry : ∀ (P Q d : ℕ) (L : Euclid P →L[ℝ] Euclid Q) (ξ : MultiVector P d) (S : Submodule ℝ (Euclid P)), Isometry L → IsUnitOrientationOf ξ S → IsUnitOrientationOf (ξ.comp (ContinuousAlternatingMap.compContinuousLinearMapCLM L)) (Submodule.map (L : Euclid P →ₗ[ℝ] Euclid Q) S) := by
  intro P Q d L ξ S hL hξ
  obtain ⟨τ, hτo, hτS, hτ⟩ := hξ
  -- `L 0 = 0`, so the isometry `L` preserves norms: it is a linear isometry `ℝᴾ →ₗᵢ ℝ^Q`
  let Li : Euclid P →ₗᵢ[ℝ] Euclid Q :=
    { toLinearMap := (L : Euclid P →ₗ[ℝ] Euclid Q)
      norm_map' := hL.norm_map_of_map_zero (map_zero L) }
  refine ⟨L ∘ τ, hτo.comp_linearIsometry Li, ?_, ?_⟩
  · -- `span (range (L ∘ τ)) = span (L '' range τ) = (span (range τ)).map L`
    rw [Set.range_comp, ← hτS]
    exact Submodule.span_image (L : Euclid P →ₗ[ℝ] Euclid Q)
  · -- `((∧L)ξ)(β) = ξ(L^*β)` and `(L^*β)(τ) = β(L ∘ τ)` hold by definition
    rcases hτ with h | h
    · exact Or.inl fun β => h (β.compContinuousLinearMap L)
    · exact Or.inr fun β => h (β.compContinuousLinearMap L)

/-- **Simon Ch. 6, 2.23–2.24 and 3.3–3.9 for a linear isometric embedding `L : ℝᴾ → ℝ^Q`**: if
`R = (M, θ, ξ)` represents `T` in `ℝᴾ`, then `R' = (L(M), θ ∘ L*, L_#ξ ∘ L*)`, where
`L_#ξ(x) = ξ(x) ∘ L^#` and `L*` is the adjoint, represents `L_#T` in `ℝ^Q`, and
`μ_{R'}(B) = μ_R(L⁻¹(B))` for Borel `B`.  The Jacobian of `L` is `1`, so the area formula is the
change of variables `Hᵈ⌞L(A) = L_#(Hᵈ⌞A)` (`dor_lmb_fc_dtop_ip_isometry_change_of_variables`).
`L` preserves inner products, so `L*` is a continuous linear left inverse of `L`; `L(M)` is
rectifiable as `L` is `1`-Lipschitz; `L_#ξ(x)` orients `T_{Lx}L(M) = L(TₓM)`
(`dor_lmb_fc_dtop_ip_approxTangent_isometry`, `dor_lmb_fc_dtop_ip_unitOrientation_isometry`); and
`L_#T(ω) = T(L^#ω)` with `⟨L^#ω(x), ξ(x)⟩ = ⟨ω(Lx), L_#ξ(x)⟩`. -/
theorem Submission.dor_lmb_fc_dtop_ip_image_imrep : ∀ (P Q d : ℕ) (L : Euclid P →L[ℝ] Euclid Q) (hL : IsProperMap (fun x => (0 : Euclid Q) + L x)) (T : GeometricCurrentOn (univ : Set (Euclid P)) d) (R : IMRep (univ : Set (Euclid P)) d), Isometry L → R.Represents T → ∃ R' : IMRep (univ : Set (Euclid Q)) d, R'.Represents (GeometricCurrentOn.affinePushforward (V := (univ : Set (Euclid Q))) L 0 hL T) ∧ ∀ s : Set (Euclid Q), MeasurableSet s → R'.measure s = R.measure (L ⁻¹' s) := by
  intro P Q d L hL T R hLi hR
  obtain ⟨hme, hmap, hint, hlint⟩ :=
    Submission.dor_lmb_fc_dtop_ip_isometry_change_of_variables P Q d L hLi
  -- `L` preserves inner products, so `⟨L*(Lx), y⟩ = ⟨Lx, Ly⟩ = ⟨x, y⟩`: `L*` is a left inverse
  have hAL : ∀ x, ContinuousLinearMap.adjoint L (L x) = x := by
    let Li : Euclid P →ₗᵢ[ℝ] Euclid Q :=
      { toLinearMap := L, norm_map' := (AddMonoidHomClass.isometry_iff_norm L).mp hLi }
    refine fun x => ext_inner_right ℝ fun y => ?_
    rw [ContinuousLinearMap.adjoint_inner_left]
    exact Li.inner_map_map x y
  -- `ζ ↦ ζ ∘ L^#` is continuous on `d`-vectors
  have hΦ : Continuous fun ζ : MultiVector P d =>
      ζ.comp (ContinuousAlternatingMap.compContinuousLinearMapCLM L) :=
    continuous_id.clm_comp continuous_const
  refine ⟨{ carrier := L '' R.carrier
            mult := fun y => R.mult (ContinuousLinearMap.adjoint L y)
            orient := fun y => (R.orient (ContinuousLinearMap.adjoint L y)).comp
              (ContinuousAlternatingMap.compContinuousLinearMapCLM L)
            measurableSet_carrier := hme.measurableSet_image.mpr R.measurableSet_carrier
            carrier_subset := subset_univ _
            rectifiable := ?_
            measurable_mult :=
              R.measurable_mult.comp (ContinuousLinearMap.adjoint L).continuous.measurable
            mult_pos := ?_
            locallyIntegrable_mult := ?_
            aestronglyMeasurable_orient := ?_
            orients := ?_ }, ?_, ?_⟩
  · -- `L(M) ⊆ L(M₀) ∪ ⋃ⱼ range (L ∘ Fⱼ)` with `Hᵈ(L(M₀)) = Hᵈ(M₀) = 0` and `L ∘ Fⱼ` Lipschitz
    obtain ⟨M₀, hM₀, F, hF, hcover⟩ := R.rectifiable
    refine ⟨L '' M₀, by rw [hLi.euclideanHausdorffMeasure_image, hM₀], fun j => L ∘ F j,
      fun j => ?_, ?_⟩
    · obtain ⟨K, hK⟩ := hF j
      exact ⟨_, hLi.lipschitzWith.comp hK⟩
    · rintro _ ⟨x, hx, rfl⟩
      rcases hcover hx with h0 | h1
      · exact Or.inl ⟨x, h0, rfl⟩
      · obtain ⟨j, v, rfl⟩ := mem_iUnion.mp h1
        exact Or.inr (mem_iUnion.mpr ⟨j, v, rfl⟩)
  · rintro _ ⟨x, hx, rfl⟩
    show 0 < R.mult (ContinuousLinearMap.adjoint L (L x))
    rw [hAL]
    exact R.mult_pos x hx
  · -- `L(M) ∩ K = L(M ∩ L⁻¹(K))`, and `L⁻¹(K)` is compact as `L` is a closed embedding
    intro K hK _
    rw [← image_inter_preimage, hlint]
    simp only [hAL]
    exact R.locallyIntegrable_mult _
      (hLi.isClosedEmbedding.isProperMap.isCompact_preimage hK) (subset_univ _)
  · -- `Hᵈ⌞L(M) = L_#(Hᵈ⌞M)` and `ξ' ∘ L = L_#ξ`
    rw [← hmap]
    refine hme.aestronglyMeasurable_map_iff.mpr ?_
    simp only [Function.comp_def, hAL]
    exact hΦ.comp_aestronglyMeasurable R.aestronglyMeasurable_orient
  · -- for `Hᵈ⌞M`-a.e. `x`, `L_#ξ(x)` orients `L(TₓM)`, the approximate tangent of `L(M)` at `Lx`
    rw [← hmap]
    refine hme.ae_map_iff.mpr (R.orients.mono fun x hx => ?_)
    obtain ⟨S, hS, hξ⟩ := hx
    refine ⟨S.map (L : Euclid P →ₗ[ℝ] Euclid Q),
      Submission.dor_lmb_fc_dtop_ip_approxTangent_isometry P Q d L R.carrier x S hLi hS, ?_⟩
    simpa only [hAL] using
      Submission.dor_lmb_fc_dtop_ip_unitOrientation_isometry P Q d L (R.orient x) S hLi hξ
  · -- `L_#T(ω) = T(L^#ω) = ∫_M θ ⟨L^#ω, ξ⟩ dHᵈ = ∫_M θ'(Lx) ⟨ω(Lx), ξ'(Lx)⟩ dHᵈ(x) = R'(ω)`
    intro ω
    have h1 : (GeometricCurrentOn.affinePushforward (V := (univ : Set (Euclid Q))) L 0 hL T) ω =
        R.action (affinePullbackForm L 0 (ω : DifferentialForm (Euclid Q) d)) :=
      hR (affinePullbackTestOn L 0 hL univ d ω)
    rw [h1]
    simp only [IMRep.action]
    rw [hint]
    refine setIntegral_congr_fun R.measurableSet_carrier fun x _ => ?_
    simp [affinePullbackForm, hAL]
  · -- `μ_{R'}(B) = ∫_{L⁻¹(B)} θ'(Lx) d(Hᵈ⌞M)(x) = μ_R(L⁻¹(B))`
    intro s hs
    simp only [IMRep.measure]
    rw [withDensity_apply _ hs, withDensity_apply _ (hme.measurable hs), ← hmap,
      hme.restrict_map, hme.lintegral_map]
    simp only [hAL]

/-- **Simon Ch. 6, 2.23 and 3.3–3.9 for a linear isometric embedding `L : ℝᴾ → ℝ^Q`**: if `T`
is an integer multiplicity current in `ℝᴾ`, then so is `L_#T` in `ℝ^Q`, and `M(L_#T) = M(T)`.
If `R = (M, θ, ξ)` represents `T`, the image triple `R'` of `dor_lmb_fc_dtop_ip_image_imrep`
represents `L_#T` and has `μ_{R'}(B) = μ_R(L⁻¹(B))` for Borel `B`.  Applying Simon 6.3.2(3),
`M_W(X) = μ(W)` for open `W` (`dor_imrep_massOn_eq_measure_and_support`), on both sides gives
`M(L_#T) = μ_{R'}(ℝ^Q) = μ_R(L⁻¹(ℝ^Q)) = μ_R(ℝᴾ) = M(T)`. -/
theorem Submission.dor_lmb_fc_dtop_isometric_pushforward_im : ∀ (P Q d : ℕ) (L : Euclid P →L[ℝ] Euclid Q) (hL : IsProperMap (fun x => (0 : Euclid Q) + L x)) (T : GeometricCurrentOn (univ : Set (Euclid P)) d), Isometry L → IsIntegerMultiplicity T → IsIntegerMultiplicity (GeometricCurrentOn.affinePushforward (V := (univ : Set (Euclid Q))) L 0 hL T) ∧ (GeometricCurrentOn.affinePushforward (V := (univ : Set (Euclid Q))) L 0 hL T).mass = T.mass := by
  intro P Q d L hL T hLi hT
  obtain ⟨R, hR⟩ := hT
  obtain ⟨R', hR', hμ⟩ := Submission.dor_lmb_fc_dtop_ip_image_imrep P Q d L hL T R hLi hR
  refine ⟨⟨R', hR'⟩, ?_⟩
  -- `M(X) = M_U(X)` with `U = univ` open on both sides, so (C1) applies with `W = univ`
  calc (GeometricCurrentOn.affinePushforward (V := (univ : Set (Euclid Q))) L 0 hL T).mass
      = R'.measure univ :=
        (Submission.dor_imrep_massOn_eq_measure_and_support Q d univ _ R' isOpen_univ hR').1
          univ isOpen_univ
    _ = R.measure (L ⁻¹' univ) := hμ univ MeasurableSet.univ
    _ = T.mass := by
        rw [preimage_univ]
        exact ((Submission.dor_imrep_massOn_eq_measure_and_support P d univ T R isOpen_univ
          hR).1 univ isOpen_univ).symm
/-- **Pull-back along the coordinate projection `ℝ^{P+1} → ℝᴾ` preserves the Euclidean coefficient
norm of covectors** (Simon Ch. 6, 1.15; used for the cut-off pull-back in the proof of 7.4.3).
If `(p y)ᵢ = y_{castSucc i}`, then `p e_{castSucc i} = eᵢ` and `p e_last = 0`.  Reindexing the
coefficient sum of `p^*α` along the injective map `I ↦ castSucc ∘ I`, the coefficients off its
range have an argument `p e_last = 0` and vanish, while `c_{castSucc ∘ I}(p^*α) = c_I(α)` on it
(`castSucc ∘ I` is strictly increasing iff `I` is). -/
theorem Submission.dor_lmb_fc_dtop_cp_proj_covector_norm : ∀ (P d : ℕ) (p : Euclid (P + 1) →L[ℝ] Euclid P), (∀ (y : Euclid (P + 1)) (i : Fin P), p y i = y (Fin.castSucc i)) → ∀ α : Covector (Euclid P) d, covectorEuclideanNorm (α.compContinuousLinearMap p) = covectorEuclideanNorm α := by
  intro P d p hp α
  classical
  -- Step 1: `p e_{castSucc i} = e_i` and `p e_last = 0`
  have hcs : ∀ i : Fin P, p (EuclideanSpace.basisFun (Fin (P + 1)) ℝ (Fin.castSucc i)) =
      EuclideanSpace.basisFun (Fin P) ℝ i := by
    intro i
    ext j
    rw [hp]
    simp [Fin.castSucc_inj]
  have hlast : p (EuclideanSpace.basisFun (Fin (P + 1)) ℝ (Fin.last P)) = 0 := by
    ext j
    rw [hp]
    simp [(Fin.castSucc_lt_last j).ne]
  -- Step 2: compare the coefficient sums under the square roots
  unfold covectorEuclideanNorm
  congr 1
  symm
  -- Step 3: reindex along the injective map `I ↦ castSucc ∘ I`
  refine Fintype.sum_of_injective (fun I : Fin d → Fin P => Fin.castSucc ∘ I)
    (fun I I' h => funext fun k => Fin.castSucc_injective P (congrFun h k)) _ _ ?_ ?_
  -- Step 4: off the range some `J k` is `last`, so the coefficient has a zero argument
  · intro J hJ
    by_cases hJs : StrictMono J
    · obtain ⟨k, hk⟩ : ∃ k, J k = Fin.last P := by
        by_contra hne
        exact hJ ⟨fun k => (J k).castPred fun h => hne ⟨k, h⟩,
          funext fun k => Fin.castSucc_castPred _ _⟩
      rw [ite_eq_left hJs, ContinuousAlternatingMap.compContinuousLinearMap_apply,
        α.map_coord_zero k (by simp only [Function.comp_apply, hk, hlast]), zero_pow two_ne_zero]
    · rw [ite_eq_right hJs]
  -- Step 5: on the range, `StrictMono (castSucc ∘ I) ↔ StrictMono I` and `p e_{castSucc I} = e_I`
  · intro I
    have hiff : StrictMono (Fin.castSucc ∘ I) ↔ StrictMono I :=
      ⟨fun h _ _ hab => Fin.castSucc_lt_castSucc_iff.1 (h hab), Fin.strictMono_castSucc.comp⟩
    by_cases hI : StrictMono I
    · rw [ite_eq_left hI, ite_eq_left (hiff.2 hI),
        ContinuousAlternatingMap.compContinuousLinearMap_apply]
      congr 2
      funext k
      exact (hcs (I k)).symm
    · rw [ite_eq_right hI, ite_eq_right (mt hiff.1 hI)]
/-- **Leibniz bound for `f • g`** (used for the cut-off pull-backs `ζ • L^#ω` in the
flat-convergence step behind Simon 7.4.3).  For `C^∞` maps `f : ℝ^Q → ℝ` and `g : ℝ^Q → F`,
`‖Dᵏ(f • g)(x)‖ ≤ ∑_{i ≤ k} C(k, i) ‖Dⁱf(x)‖ ‖D^{k-i}g(x)‖`.  This is Mathlib's
`norm_iteratedFDeriv_smul_le`, whose module `Mathlib.Analysis.Calculus.ContDiff.Bounds` is not
imported here, so its argument is reproduced: for a continuous bilinear `B` (all spaces in
`Type`), `‖Dⁿ(B(u, v))(z)‖ ≤ ‖B‖ ∑_{i ≤ n} C(n, i) ‖Dⁱu(z)‖ ‖D^{n-i}v(z)‖` by induction on `n`,
using `D(B(u, v)) = B.precompR(u, Dv) + B.precompL(Du, v)`, `‖B.precompR‖, ‖B.precompL‖ ≤ ‖B‖`
and Pascal's rule; then take `B = lsmul`, with `‖lsmul‖ ≤ 1`. -/
theorem Submission.dor_lmb_fc_dtop_cp_leibniz_smul_bound : ∀ (Q : ℕ) (F : Type) [NormedAddCommGroup F] [NormedSpace ℝ F] (f : Euclid Q → ℝ) (g : Euclid Q → F), ContDiff ℝ (⊤ : ℕ∞) f → ContDiff ℝ (⊤ : ℕ∞) g → ∀ (k : ℕ) (x : Euclid Q), ‖iteratedFDeriv ℝ k (fun y => f y • g y) x‖ ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * ‖iteratedFDeriv ℝ i f x‖ * ‖iteratedFDeriv ℝ (k - i) g x‖ := by
  intro Q F _ _ f g hf hg k x
  -- Steps 1–6: the bound for a continuous bilinear `B`, by induction on the order `n`,
  -- simultaneously for all real normed spaces `E₁, F₁, G₁` in `Type`
  have key : ∀ (n : ℕ) (E₁ F₁ G₁ : Type) [NormedAddCommGroup E₁] [NormedSpace ℝ E₁]
      [NormedAddCommGroup F₁] [NormedSpace ℝ F₁] [NormedAddCommGroup G₁] [NormedSpace ℝ G₁]
      (B : E₁ →L[ℝ] F₁ →L[ℝ] G₁) (u : Euclid Q → E₁) (v : Euclid Q → F₁),
      ContDiff ℝ ((n : ℕ) : WithTop ℕ∞) u → ContDiff ℝ ((n : ℕ) : WithTop ℕ∞) v →
      ∀ z : Euclid Q, ‖iteratedFDeriv ℝ n (fun y => B (u y) (v y)) z‖ ≤
        ‖B‖ * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * ‖iteratedFDeriv ℝ i u z‖ *
          ‖iteratedFDeriv ℝ (n - i) v z‖ := by
    intro n
    induction n with
    | zero =>
      -- Step 2: `‖B (u z) (v z)‖ ≤ ‖B‖ ‖u z‖ ‖v z‖`
      intro E₁ F₁ G₁ _ _ _ _ _ _ B u v _ _ z
      simp only [norm_iteratedFDeriv_zero, zero_add, Finset.range_one, Finset.sum_singleton,
        Nat.choose_self, Nat.cast_one, one_mul, Nat.sub_zero, ← mul_assoc]
      exact B.le_opNorm₂ (u z) (v z)
    | succ n IH =>
      intro E₁ F₁ G₁ _ _ _ _ _ _ B u v hu hv z
      -- Step 3: `u, v, Du, Dv` are `Cⁿ`
      have In : ((n : ℕ) : WithTop ℕ∞) + 1 ≤ ((n + 1 : ℕ) : WithTop ℕ∞) := by
        simp only [Nat.cast_succ, le_refl]
      have hu' : ContDiff ℝ ((n : ℕ) : WithTop ℕ∞) u := hu.of_le (Nat.cast_le.2 (Nat.le_succ n))
      have hv' : ContDiff ℝ ((n : ℕ) : WithTop ℕ∞) v := hv.of_le (Nat.cast_le.2 (Nat.le_succ n))
      have hDu : ContDiff ℝ ((n : ℕ) : WithTop ℕ∞) (fderiv ℝ u) := hu.fderiv_right In
      have hDv : ContDiff ℝ ((n : ℕ) : WithTop ℕ∞) (fderiv ℝ v) := hv.fderiv_right In
      -- the operator norms of `B.precompR`, `B.precompL` need these instances in scope
      let _ : NormedAddCommGroup ((Euclid Q →L[ℝ] F₁) →L[ℝ] Euclid Q →L[ℝ] G₁) := inferInstance
      let _ : NormedSpace ℝ ((Euclid Q →L[ℝ] F₁) →L[ℝ] Euclid Q →L[ℝ] G₁) := inferInstance
      let _ : NormedAddCommGroup (F₁ →L[ℝ] Euclid Q →L[ℝ] G₁) := inferInstance
      let _ : NormedSpace ℝ (F₁ →L[ℝ] Euclid Q →L[ℝ] G₁) := inferInstance
      -- Step 5, first term: the claim for `(B.precompR, u, Dv)`
      have I1 : ‖iteratedFDeriv ℝ n (fun y => B.precompR (Euclid Q) (u y) (fderiv ℝ v y)) z‖ ≤
          ‖B‖ * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * ‖iteratedFDeriv ℝ i u z‖ *
            ‖iteratedFDeriv ℝ (n + 1 - i) v z‖ := by
        calc ‖iteratedFDeriv ℝ n (fun y => B.precompR (Euclid Q) (u y) (fderiv ℝ v y)) z‖
            ≤ ‖B.precompR (Euclid Q)‖ * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
                ‖iteratedFDeriv ℝ i u z‖ * ‖iteratedFDeriv ℝ (n - i) (fderiv ℝ v) z‖ :=
              IH E₁ (Euclid Q →L[ℝ] F₁) (Euclid Q →L[ℝ] G₁) (B.precompR (Euclid Q)) u
                (fderiv ℝ v) hu' hDv z
          _ ≤ ‖B‖ * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
                ‖iteratedFDeriv ℝ i u z‖ * ‖iteratedFDeriv ℝ (n - i) (fderiv ℝ v) z‖ := by
              gcongr
              exact B.norm_precompR_le (Euclid Q)
          _ = ‖B‖ * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * ‖iteratedFDeriv ℝ i u z‖ *
                ‖iteratedFDeriv ℝ (n + 1 - i) v z‖ := by
              congr 1
              refine Finset.sum_congr rfl fun i hi => ?_
              rw [norm_iteratedFDeriv_fderiv,
                Nat.succ_sub (Nat.lt_succ_iff.1 (Finset.mem_range.1 hi))]
      -- Step 5, second term: the claim for `(B.precompL, Du, v)`
      have I2 : ‖iteratedFDeriv ℝ n (fun y => B.precompL (Euclid Q) (fderiv ℝ u y) (v y)) z‖ ≤
          ‖B‖ * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * ‖iteratedFDeriv ℝ (i + 1) u z‖ *
            ‖iteratedFDeriv ℝ (n - i) v z‖ := by
        calc ‖iteratedFDeriv ℝ n (fun y => B.precompL (Euclid Q) (fderiv ℝ u y) (v y)) z‖
            ≤ ‖B.precompL (Euclid Q)‖ * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
                ‖iteratedFDeriv ℝ i (fderiv ℝ u) z‖ * ‖iteratedFDeriv ℝ (n - i) v z‖ :=
              IH (Euclid Q →L[ℝ] E₁) F₁ (Euclid Q →L[ℝ] G₁) (B.precompL (Euclid Q)) (fderiv ℝ u)
                v hDu hv' z
          _ ≤ ‖B‖ * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
                ‖iteratedFDeriv ℝ i (fderiv ℝ u) z‖ * ‖iteratedFDeriv ℝ (n - i) v z‖ := by
              gcongr
              exact B.norm_precompL_le (Euclid Q)
          _ = ‖B‖ * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
                ‖iteratedFDeriv ℝ (i + 1) u z‖ * ‖iteratedFDeriv ℝ (n - i) v z‖ := by
              congr 1
              refine Finset.sum_congr rfl fun i _ => ?_
              rw [norm_iteratedFDeriv_fderiv]
      -- Step 3: `D(B(u, v)) = B.precompR(u, Dv) + B.precompL(Du, v)`
      have J : fderiv ℝ (fun y => B (u y) (v y)) = fun y =>
          B.precompR (Euclid Q) (u y) (fderiv ℝ v y) + B.precompL (Euclid Q) (fderiv ℝ u y) (v y) := by
        funext y
        exact B.fderiv_of_bilinear (hu.differentiable (by positivity) y)
          (hv.differentiable (by positivity) y)
      -- Step 4: split the top derivative and use the triangle inequality
      have A : ContDiff ℝ ((n : ℕ) : WithTop ℕ∞)
          (fun y => B.precompR (Euclid Q) (u y) (fderiv ℝ v y)) :=
        (B.precompR (Euclid Q)).isBoundedBilinearMap.contDiff.comp₂ hu' hDv
      have A' : ContDiff ℝ ((n : ℕ) : WithTop ℕ∞)
          (fun y => B.precompL (Euclid Q) (fderiv ℝ u y) (v y)) :=
        (B.precompL (Euclid Q)).isBoundedBilinearMap.contDiff.comp₂ hDu hv'
      rw [← norm_iteratedFDeriv_fderiv, J, fun_iteratedFDeriv_add_apply A.contDiffAt A'.contDiffAt]
      refine (norm_add_le _ _).trans ((add_le_add I1 I2).trans (le_of_eq ?_))
      -- Step 6: Pascal's rule
      simp_rw [← mul_add, mul_assoc]
      congr 1
      exact (Finset.sum_choose_succ_mul
        (fun i j => ‖iteratedFDeriv ℝ i u z‖ * ‖iteratedFDeriv ℝ j v z‖) n).symm
  -- Step 7: specialize to `B = lsmul`, with `‖lsmul‖ ≤ 1`
  have h := key k ℝ F F (ContinuousLinearMap.lsmul ℝ ℝ) f g (contDiff_infty.1 hf k)
    (contDiff_infty.1 hg k) x
  have hB : ‖(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] F →L[ℝ] F)‖ ≤ 1 :=
    ContinuousLinearMap.opNorm_lsmul_le
  have hsum : 0 ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * ‖iteratedFDeriv ℝ i f x‖ *
      ‖iteratedFDeriv ℝ (k - i) g x‖ := by positivity
  simp only [ContinuousLinearMap.lsmul_apply] at h
  exact h.trans (mul_le_of_le_one_left hsum hB)

/-- **Cut-off pull-backs of a null sequence of test forms tend to `0`** (Simon Ch. 6: the
topology of `𝒟ⁿ(U)` in §1, before 1.15, and the cut-off pull-back `ω ↦ ζ f^#ω` of 2.23, here for
linear `f`).  Let `L : ℝ^Q → ℝᴾ` be linear and `ζ` smooth with compact support.  If `ωⱼ → 0` in
`𝒟ᵈ(ℝᴾ)` and `ηⱼ = ζ · L^#ωⱼ`, then `ηⱼ → 0` in `𝒟ᵈ(ℝ^Q)`.  Every `ηⱼ` is supported in the
compact `spt ζ`.  Each `D^l ωⱼ → 0` uniformly on all of `ℝᴾ`, since it vanishes off the common
compact set.  The chain rule gives `‖D^l(L^#ωⱼ)(y)‖ ≤ ‖L‖ᵈ ‖L‖ˡ ‖D^l ωⱼ(Ly)‖`, and the
derivatives of `ζ` are bounded.  The Leibniz bound then gives `supᵧ ‖D^k ηⱼ(y)‖ → 0`. -/
theorem Submission.dor_lmb_fc_dtop_cp_cutoff_pullback_converges : ∀ (P Q d : ℕ) (L : Euclid Q →L[ℝ] Euclid P) (ζ : Euclid Q → ℝ), ContDiff ℝ (⊤ : ℕ∞) ζ → HasCompactSupport ζ → ∀ (ωs : ℕ → TestFormOn (univ : Set (Euclid P)) d) (ηs : ℕ → TestFormOn (univ : Set (Euclid Q)) d), (∀ (j : ℕ) (y : Euclid Q), (ηs j : DifferentialForm (Euclid Q) d) y = ζ y • ((ωs j : DifferentialForm (Euclid P) d) (L y)).compContinuousLinearMap L) → TestFormOnConverges ωs 0 → TestFormOnConverges ηs 0 := by
  intro P Q d L ζ hζ hζc ωs ηs hη hω
  -- Step 1: a compact `C ⊇ tsupport ωⱼ` on which every `D^l ωⱼ → 0` uniformly
  obtain ⟨C, -, -, hωC, -, hωD⟩ := hω
  have hωs : ∀ j, ContDiff ℝ (⊤ : ℕ∞) (ωs j : DifferentialForm (Euclid P) d) := fun j =>
    (ωs j).property.1.1
  -- Step 2: `D^l ωⱼ → 0` uniformly on all of `ℝᴾ`, since it vanishes off `C`
  have hdecay : ∀ (l : ℕ) (ε : ℝ), 0 < ε → ∀ᶠ j in atTop, ∀ x : Euclid P,
      ‖iteratedFDeriv ℝ l (ωs j : DifferentialForm (Euclid P) d) x‖ < ε := by
    intro l ε hε
    filter_upwards [Metric.tendstoUniformlyOn_iff.mp (hωD l) ε hε] with j hj x
    by_cases hx : x ∈ C
    · have hjx := hj x hx
      simp only [ZeroMemClass.coe_zero, iteratedFDeriv_zero, Pi.zero_apply, dist_zero_left] at hjx
      exact hjx
    · have hx' : x ∉ tsupport (iteratedFDeriv ℝ l (ωs j : DifferentialForm (Euclid P) d)) :=
        fun h => hx (hωC j (tsupport_iteratedFDeriv_subset l h))
      rw [image_eq_zero_of_notMem_tsupport hx', norm_zero]
      exact hε
  -- Step 3: `ηⱼ = ζ • gⱼ` with `gⱼ = Λ ∘ ωⱼ ∘ L` smooth, where `Λ α = α ∘ (L × ⋯ × L)`
  let Λ : Covector (Euclid P) d →L[ℝ] Covector (Euclid Q) d :=
    ContinuousAlternatingMap.compContinuousLinearMapCLM L
  let g : ℕ → Euclid Q → Covector (Euclid Q) d := fun j y =>
    ((ωs j : DifferentialForm (Euclid P) d) (L y)).compContinuousLinearMap L
  have hgΛ : ∀ j, g j = Λ ∘ ((ωs j : DifferentialForm (Euclid P) d) ∘ L) := fun j => rfl
  have hηg : ∀ j, (ηs j : DifferentialForm (Euclid Q) d) = fun y => ζ y • g j y := fun j =>
    funext (hη j)
  have hgs : ∀ j, ContDiff ℝ (⊤ : ℕ∞) (g j) := fun j => by
    rw [hgΛ j]
    exact Λ.contDiff.comp ((hωs j).comp L.contDiff)
  -- Step 4: `‖D^l gⱼ(y)‖ ≤ ‖L‖ᵈ ‖L‖ˡ ‖D^l ωⱼ(Ly)‖`, as `D^l gⱼ(y) = Λ ∘ D^l ωⱼ(Ly) ∘ (L, …, L)`
  have hΛ : ∀ (l : ℕ) (A : ContinuousMultilinearMap ℝ (fun _ : Fin l => Euclid Q)
      (Covector (Euclid P) d)), ‖Λ.compContinuousMultilinearMap A‖ ≤ ‖L‖ ^ d * ‖A‖ := by
    intro l A
    refine ContinuousMultilinearMap.opNorm_le_bound (by positivity) fun m => ?_
    calc ‖Λ.compContinuousMultilinearMap A m‖ = ‖(A m).compContinuousLinearMap L‖ := rfl
      _ ≤ ‖A m‖ * ‖L‖ ^ Fintype.card (Fin d) := (A m).norm_compContinuousLinearMap_le L
      _ ≤ ‖A‖ * (∏ i, ‖m i‖) * ‖L‖ ^ d := by
          rw [Fintype.card_fin]
          gcongr
          exact A.le_opNorm m
      _ = ‖L‖ ^ d * ‖A‖ * ∏ i, ‖m i‖ := by ring
  have hgD : ∀ (l j : ℕ) (y : Euclid Q), ‖iteratedFDeriv ℝ l (g j) y‖ ≤
      ‖L‖ ^ d * (‖iteratedFDeriv ℝ l (ωs j : DifferentialForm (Euclid P) d) (L y)‖ * ‖L‖ ^ l) := by
    intro l j y
    rw [hgΛ j, Λ.iteratedFDeriv_comp_left (i := l) ((hωs j).comp L.contDiff).contDiffAt (by simp),
      L.iteratedFDeriv_comp_right (i := l) (hωs j) y (by simp)]
    refine (hΛ l _).trans ?_
    gcongr
    refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans_eq ?_
    simp
  -- Step 5: every `D^i ζ` is bounded
  have hZ : ∀ i : ℕ, ∃ Z : ℝ, ∀ y, ‖iteratedFDeriv ℝ i ζ y‖ ≤ Z := fun i =>
    (hζ.continuous_iteratedFDeriv (m := i) (by simp)).bounded_above_of_compact_support
      (hζc.iteratedFDeriv i)
  choose Z hZ using hZ
  -- Steps 6 and 8: all supports lie in the compact set `tsupport ζ`
  refine ⟨tsupport ζ, hζc.isCompact, subset_univ _, fun j => ?_, ?_, fun k => ?_⟩
  · rw [hηg j]
    exact tsupport_smul_subset_left _ _
  · simp
  -- Step 7: eventually `‖D^k ηⱼ(y)‖ ≤ S δ < ε` for all `y`, with `δ = ε / (S + 1)`
  refine Metric.tendstoUniformlyOn_iff.mpr fun ε hε => ?_
  obtain ⟨S, hS⟩ : ∃ S : ℝ, S = ∑ i ∈ Finset.range (k + 1),
      (k.choose i : ℝ) * |Z i| * (‖L‖ ^ d * ‖L‖ ^ (k - i)) := ⟨_, rfl⟩
  have hS0 : 0 ≤ S := by
    rw [hS]
    exact Finset.sum_nonneg fun i _ => by positivity
  have hδ : 0 < ε / (S + 1) := div_pos hε (by linarith)
  have hev : ∀ᶠ j in atTop, ∀ i ∈ Finset.range (k + 1), ∀ x : Euclid P,
      ‖iteratedFDeriv ℝ (k - i) (ωs j : DifferentialForm (Euclid P) d) x‖ < ε / (S + 1) :=
    (Filter.eventually_all_finset _).2 fun i _ => hdecay (k - i) _ hδ
  filter_upwards [hev] with j hj y _
  simp only [ZeroMemClass.coe_zero, iteratedFDeriv_zero, Pi.zero_apply, dist_zero_left]
  rw [hηg j]
  calc ‖iteratedFDeriv ℝ k (fun y => ζ y • g j y) y‖
      ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * ‖iteratedFDeriv ℝ i ζ y‖ *
          ‖iteratedFDeriv ℝ (k - i) (g j) y‖ :=
        Submission.dor_lmb_fc_dtop_cp_leibniz_smul_bound Q (Covector (Euclid Q) d) ζ (g j) hζ
          (hgs j) k y
    _ ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |Z i| *
          (‖L‖ ^ d * ‖L‖ ^ (k - i) * (ε / (S + 1))) := by
        refine Finset.sum_le_sum fun i hi => ?_
        have h1 : ‖iteratedFDeriv ℝ i ζ y‖ ≤ |Z i| := (hZ i y).trans (le_abs_self _)
        have h2 : ‖iteratedFDeriv ℝ (k - i) (g j) y‖ ≤
            ‖L‖ ^ d * ‖L‖ ^ (k - i) * (ε / (S + 1)) := by
          refine (hgD (k - i) j y).trans ?_
          have h3 := (hj i hi (L y)).le
          calc ‖L‖ ^ d * (‖iteratedFDeriv ℝ (k - i) (ωs j : DifferentialForm (Euclid P) d) (L y)‖ *
                ‖L‖ ^ (k - i)) ≤ ‖L‖ ^ d * (ε / (S + 1) * ‖L‖ ^ (k - i)) := by gcongr
            _ = ‖L‖ ^ d * ‖L‖ ^ (k - i) * (ε / (S + 1)) := by ring
        gcongr
    _ = S * (ε / (S + 1)) := by
        rw [hS, Finset.sum_mul]
        exact Finset.sum_congr rfl fun i _ => by ring
    _ < ε := by
        rw [← mul_div_assoc, div_lt_iff₀ (by linarith)]
        nlinarith

/-- **Cut-off pull-back of test forms along the coordinate projection `ℝ^{P+1} → ℝᴾ`** (Simon
Ch. 6, 2.23 for the projection `p`; used for the top-dimensional deformation step behind 7.4.3).
Given a compact `K`, choose `K ⊆ V = B_r(0)` and a `C^∞` bump `ζ` with `0 ≤ ζ ≤ 1`, `ζ = 1` on
`B̄_r(0)` and compact support, and put `E ω = ζ · p^#ω`, `(p^#ω)(y) = ω(py)(p·, …, p·)`.  Then `E`
is linear, `E ω = p^#ω` on `V`, so `d(E ω) = p^#(dω)` on the open set `V` (locality of `d` and
`d ∘ p^# = p^# ∘ d`); `spt E ω ⊆ spt p^#ω ⊆ p⁻¹(spt ω)`; `|E ω(y)| = ζ(y) |ω(py)| ≤ |ω(py)|`, as
`p^*` preserves the Euclidean coefficient norm; and `ωⱼ → 0` implies `E ωⱼ → 0`. -/
theorem Submission.dor_lmb_fc_dtop_cutoff_pullback : ∀ (P d : ℕ) (p : Euclid (P + 1) →L[ℝ] Euclid P), (∀ (y : Euclid (P + 1)) (i : Fin P), p y i = y (Fin.castSucc i)) → ∀ K : Set (Euclid (P + 1)), IsCompact K → ∃ (V : Set (Euclid (P + 1))) (E : TestFormOn (univ : Set (Euclid P)) d →ₗ[ℝ] TestFormOn (univ : Set (Euclid (P + 1))) d), IsOpen V ∧ K ⊆ V ∧ (∀ (ω : TestFormOn (univ : Set (Euclid P)) d) (y : Euclid (P + 1)), y ∈ V → (E ω : DifferentialForm (Euclid (P + 1)) d) y = ((ω : DifferentialForm (Euclid P) d) (p y)).compContinuousLinearMap p) ∧ (∀ (ω : TestFormOn (univ : Set (Euclid P)) d) (y : Euclid (P + 1)), y ∈ V → exteriorDerivative (E ω : DifferentialForm (Euclid (P + 1)) d) y = (exteriorDerivative (ω : DifferentialForm (Euclid P) d) (p y)).compContinuousLinearMap p) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) d, tsupport (E ω : DifferentialForm (Euclid (P + 1)) d) ⊆ p ⁻¹' tsupport (ω : DifferentialForm (Euclid P) d)) ∧ (∀ (ω : TestFormOn (univ : Set (Euclid P)) d) (y : Euclid (P + 1)), covectorEuclideanNorm ((E ω : DifferentialForm (Euclid (P + 1)) d) y) ≤ covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) d) (p y))) ∧ ∀ ωs : ℕ → TestFormOn (univ : Set (Euclid P)) d, TestFormOnConverges ωs 0 → TestFormOnConverges (fun j => E (ωs j)) 0 := by
  intro P d p hp K hK
  -- Step 1: `K ⊆ V = B_r(0)`, and a `C^∞` bump `ζ` with `ζ = 1` on `B̄_r(0)` and compact support
  obtain ⟨r, hr, hKr⟩ := hK.isBounded.subset_ball_lt 0 (0 : Euclid (P + 1))
  let ζ : ContDiffBump (0 : Euclid (P + 1)) := ⟨r, r + 1, hr, lt_add_one r⟩
  have hζV : ∀ y ∈ ball (0 : Euclid (P + 1)) r, ζ y = 1 := fun y hy =>
    ζ.one_of_mem_closedBall (ball_subset_closedBall hy)
  -- Step 2: `p^#ω = Λ ∘ ω ∘ p` with `Λ α = α(p·, …, p·)`; `E ω = ζ • p^#ω` is a test form
  let Λ : Covector (Euclid P) d →L[ℝ] Covector (Euclid (P + 1)) d :=
    ContinuousAlternatingMap.compContinuousLinearMapCLM p
  have hmem : ∀ ω : TestFormOn (univ : Set (Euclid P)) d,
      (fun y => ζ y • ((ω : DifferentialForm (Euclid P) d) (p y)).compContinuousLinearMap p) ∈
        TestFormOn (univ : Set (Euclid (P + 1))) d := by
    intro ω
    have hω : ContDiff ℝ (⊤ : ℕ∞) (ω : DifferentialForm (Euclid P) d) := ω.property.1.1
    refine ⟨⟨?_, ?_⟩, subset_univ _⟩
    · exact ζ.contDiff.smul (Λ.contDiff.comp (hω.comp p.contDiff))
    · exact ζ.hasCompactSupport.smul_right
  -- Step 3: `E` is linear, since `ω ↦ ω(py)(p·, …, p·)` is
  let E : TestFormOn (univ : Set (Euclid P)) d →ₗ[ℝ] TestFormOn (univ : Set (Euclid (P + 1))) d :=
    { toFun := fun ω => ⟨_, hmem ω⟩
      map_add' := fun ω η => by
        apply Subtype.ext
        funext y
        ext v
        simp [mul_add]
      map_smul' := fun c ω => by
        apply Subtype.ext
        funext y
        ext v
        simp [mul_left_comm] }
  have hE : ∀ (ω : TestFormOn (univ : Set (Euclid P)) d) (y : Euclid (P + 1)),
      (E ω : DifferentialForm (Euclid (P + 1)) d) y =
        ζ y • ((ω : DifferentialForm (Euclid P) d) (p y)).compContinuousLinearMap p :=
    fun _ _ => rfl
  refine ⟨ball 0 r, E, isOpen_ball, hKr, ?_, ?_, ?_, ?_, ?_⟩
  -- Step 4: (i), `E ω = p^#ω` on `V`, where `ζ = 1`
  · intro ω y hy
    rw [hE, hζV y hy, one_smul]
  -- Step 5: (ii), `E ω = p^#ω` near `y ∈ V` (`V` open), and `d(p^#ω) = p^#(dω)`
  · intro ω y hy
    have hω : ContDiff ℝ (⊤ : ℕ∞) (ω : DifferentialForm (Euclid P) d) := ω.property.1.1
    have hloc : (E ω : DifferentialForm (Euclid (P + 1)) d) =ᶠ[𝓝 y]
        affinePullbackForm p 0 (ω : DifferentialForm (Euclid P) d) := by
      filter_upwards [isOpen_ball.mem_nhds hy] with z hz
      rw [hE, hζV z hz, one_smul]
      simp [affinePullbackForm]
    calc exteriorDerivative (E ω : DifferentialForm (Euclid (P + 1)) d) y
        = exteriorDerivative (affinePullbackForm p 0 (ω : DifferentialForm (Euclid P) d)) y :=
          hloc.extDeriv_eq
      _ = affinePullbackForm p 0 (exteriorDerivative (ω : DifferentialForm (Euclid P) d)) y :=
          congrFun (exteriorDerivative_affinePullbackForm p 0 hω) y
      _ = (exteriorDerivative (ω : DifferentialForm (Euclid P) d) (p y)).compContinuousLinearMap
            p := by
          simp [affinePullbackForm]
  -- Step 6: (iii), `spt (ζ • p^#ω) ⊆ spt p^#ω = spt (Λ ∘ (ω ∘ p)) ⊆ p⁻¹(spt ω)`
  · intro ω
    show tsupport (fun y => ζ y •
      ((ω : DifferentialForm (Euclid P) d) (p y)).compContinuousLinearMap p) ⊆ _
    exact (tsupport_smul_subset_right (fun y => ζ y)
      (fun y => ((ω : DifferentialForm (Euclid P) d) (p y)).compContinuousLinearMap p)).trans
      ((tsupport_comp_subset (g := Λ) (map_zero Λ) ((ω : DifferentialForm (Euclid P) d) ∘ p)).trans
        (tsupport_comp_subset_preimage (ω : DifferentialForm (Euclid P) d) p.continuous))
  -- Step 7: (iv), `|ζ(y) p^*(ω(py))| = |ζ(y)| |ω(py)| ≤ |ω(py)|`, as `0 ≤ ζ ≤ 1`
  · intro ω y
    rw [hE, (Submission.rsd_mw_tfa_norm_props (P + 1) d).2.1,
      Submission.dor_lmb_fc_dtop_cp_proj_covector_norm P d p hp, abs_of_nonneg (ζ.nonneg' y)]
    exact mul_le_of_le_one_left (covectorEuclideanNorm_nonneg _) ζ.le_one
  -- Step 8: (v), sequential continuity of the cut-off pull-back
  · intro ωs hωs
    exact Submission.dor_lmb_fc_dtop_cp_cutoff_pullback_converges P (P + 1) d p ζ ζ.contDiff
      ζ.hasCompactSupport ωs (fun j => E (ωs j)) (fun j y => hE (ωs j) y) hωs
/-- **Projected cells of the cubical grid of side `ρ` in `ℝ^{N+1}`** (parent steps 5(c) and 9;
the top-dimensional case of the Deformation Theorem, Simon Ch. 6, 5.1).  `p : ℝ^{N+1} → ℝᴺ`
forgets the last coordinate, `ι : Fin N → Fin (N + 1)` is strictly increasing, `F̃` is the cell
at `z` spanned by the directions `ι`, and `G` is the cube at `z ∘ castSucc`.  (a) If
`last ∈ range ι`, one argument of `ω(py)(pe_{ι 0}, …, pe_{ι (N−1)})` is `p e_last = 0`, so the
integrand vanishes.  (b) Otherwise `ι = castSucc` and `p e_{castSucc k} = e_k`; the isometric
embedding `j(x) = (x, ρ z_last)` has `p ∘ j = id` and `j(G) = F̃`, so
`μHE[N].map j = μHE[N]⌞range j` turns `∫_{F̃} ⋯ dHᴺ` into `∫_G ω(x)(e_0, …, e_{N−1}) dHᴺ`, and
`G = p(F̃)`. -/
theorem Submission.dor_lmb_fc_dtop_projected_cell_integral : ∀ (N : ℕ) (ρ : ℝ) (p : Euclid (N + 1) →L[ℝ] Euclid N) (z : Fin (N + 1) → ℤ) (ι : Fin N → Fin (N + 1)), (∀ (y : Euclid (N + 1)) (i : Fin N), p y i = y (Fin.castSucc i)) → StrictMono ι → (Fin.last N ∈ Set.range ι → ∀ ω : DifferentialForm (Euclid N) N, ∫ y in {y : Euclid (N + 1) | ∀ i : Fin (N + 1), (i ∈ Set.range ι → ρ * z i ≤ y i ∧ y i ≤ ρ * (z i + 1)) ∧ (i ∉ Set.range ι → y i = ρ * z i)}, ω (p y) (fun k => p (EuclideanSpace.single (ι k) (1 : ℝ))) ∂μHE[N] = 0) ∧ (Fin.last N ∉ Set.range ι → (∀ ω : DifferentialForm (Euclid N) N, ∫ y in {y : Euclid (N + 1) | ∀ i : Fin (N + 1), (i ∈ Set.range ι → ρ * z i ≤ y i ∧ y i ≤ ρ * (z i + 1)) ∧ (i ∉ Set.range ι → y i = ρ * z i)}, ω (p y) (fun k => p (EuclideanSpace.single (ι k) (1 : ℝ))) ∂μHE[N] = ∫ x in {x : Euclid N | ∀ i : Fin N, ρ * z (Fin.castSucc i) ≤ x i ∧ x i ≤ ρ * (z (Fin.castSucc i) + 1)}, ω x (fun k => EuclideanSpace.single k (1 : ℝ)) ∂μHE[N]) ∧ ∀ x : Euclid N, (∀ i : Fin N, ρ * z (Fin.castSucc i) ≤ x i ∧ x i ≤ ρ * (z (Fin.castSucc i) + 1)) → ∃ y : Euclid (N + 1), (∀ i : Fin (N + 1), (i ∈ Set.range ι → ρ * z i ≤ y i ∧ y i ≤ ρ * (z i + 1)) ∧ (i ∉ Set.range ι → y i = ρ * z i)) ∧ p y = x) := by
  intro N ρ p z ι hp hι
  -- Step 1: `p e_last = 0` and `p e_{castSucc k} = e_k`.
  have hplast : p (EuclideanSpace.single (Fin.last N) (1 : ℝ)) = 0 := by
    ext i
    rw [hp]
    simp only [PiLp.single_apply, Fin.castSucc_ne_last, ↓reduceIte, PiLp.zero_apply]
  have hpcs : ∀ k : Fin N,
      p (EuclideanSpace.single (Fin.castSucc k) (1 : ℝ)) = EuclideanSpace.single k (1 : ℝ) := by
    intro k
    ext i
    rw [hp]
    simp only [PiLp.single_apply, Fin.castSucc_inj]
  refine ⟨?_, fun hlast => ?_⟩
  · -- (a) Step 2: if `ι k₀ = last`, the `k₀`-th argument `p e_last` is `0`, so the integrand
    -- vanishes identically.
    rintro ⟨k₀, hk₀⟩ ω
    have h0 : ∀ y : Euclid (N + 1),
        ω (p y) (fun k => p (EuclideanSpace.single (ι k) (1 : ℝ))) = 0 := fun y =>
      (ω (p y)).map_coord_zero k₀ (by simp only [hk₀, hplast])
    simp only [h0, integral_zero]
  · -- (b) Step 3: `ι` avoids `last`, so `ι = castSucc ∘ ι'` with `ι' : Fin N → Fin N` strictly
    -- increasing, hence injective, hence surjective, hence `ι' = id`.
    let ι' : Fin N → Fin N := fun k => (ι k).castPred fun h => hlast ⟨k, h⟩
    have hι' : StrictMono ι' := fun a b hab => by
      simpa [ι', Fin.castPred_lt_castPred_iff] using hι hab
    have hι'id : ι' = id := by
      refine (hι'.range_inj_of_wellFoundedLT strictMono_id).1 ?_
      rw [range_id]
      exact (Finite.injective_iff_surjective.1 hι'.injective).range_eq
    have hιcs : ι = Fin.castSucc := by
      funext k
      exact (Fin.castSucc_castPred (ι k) fun h => hlast ⟨k, h⟩).symm.trans
        (congrArg Fin.castSucc (congrFun hι'id k))
    subst hιcs
    -- Step 4: the isometric embedding `j(x) = (x, ρ z_last)`, with `p ∘ j = id`.
    let j : Euclid N → Euclid (N + 1) := fun x =>
      WithLp.toLp 2 (Fin.snoc (α := fun _ => ℝ) (fun i => x i) (ρ * z (Fin.last N)))
    have hj_cs : ∀ (x : Euclid N) (i : Fin N), j x (Fin.castSucc i) = x i := by
      intro x i
      simp [j]
    have hj_last : ∀ x : Euclid N, j x (Fin.last N) = ρ * z (Fin.last N) := by
      intro x
      simp [j]
    have hpj : ∀ x : Euclid N, p (j x) = x := by
      intro x
      ext i
      rw [hp, hj_cs]
    have hjiso : Isometry j := by
      refine Isometry.of_dist_eq fun x x' => ?_
      rw [EuclideanSpace.dist_eq, EuclideanSpace.dist_eq, Fin.sum_univ_castSucc]
      simp only [hj_cs, hj_last, dist_self]
      simp
    have hjme : MeasurableEmbedding j := hjiso.isClosedEmbedding.measurableEmbedding
    set S : Set (Euclid (N + 1)) := {y : Euclid (N + 1) | ∀ i : Fin (N + 1),
      (i ∈ Set.range Fin.castSucc → ρ * z i ≤ y i ∧ y i ≤ ρ * (z i + 1)) ∧
        (i ∉ Set.range Fin.castSucc → y i = ρ * z i)}
    set G : Set (Euclid N) := {x : Euclid N | ∀ i : Fin N,
      ρ * z (Fin.castSucc i) ≤ x i ∧ x i ≤ ρ * (z (Fin.castSucc i) + 1)}
    -- `j⁻¹(F̃) = G` and `F̃ ⊆ range j`, i.e. `F̃ = j(G)`.
    have hnotlast : ∀ i : Fin (N + 1), i ∉ Set.range Fin.castSucc → i = Fin.last N := by
      intro i hi
      by_contra hne
      exact hi ⟨i.castPred hne, Fin.castSucc_castPred i hne⟩
    have hpre : j ⁻¹' S = G := by
      ext x
      simp only [S, G, Set.mem_preimage, Set.mem_ofPred_eq]
      constructor
      · intro h i
        have h' := (h (Fin.castSucc i)).1 ⟨i, rfl⟩
        rwa [hj_cs] at h'
      · intro h i
        refine ⟨?_, fun hi => ?_⟩
        · rintro ⟨i', rfl⟩
          rw [hj_cs]
          exact h i'
        · obtain rfl := hnotlast i hi
          rw [hj_last]
    have hSsub : S ⊆ Set.range j := by
      intro y hy
      refine ⟨p y, ?_⟩
      ext i
      induction i using Fin.lastCases with
      | last =>
        rw [hj_last]
        exact ((hy (Fin.last N)).2 fun ⟨k, hk⟩ => Fin.castSucc_ne_last k hk).symm
      | cast i => rw [hj_cs, hp]
    -- Step 5: `Hᴺ⌞F̃ = j_#(Hᴺ⌞G)` since `μHE[N].map j = μHE[N]⌞range j`; change variables.
    have hmeas : (μHE[N] : Measure (Euclid (N + 1))).restrict S =
        ((μHE[N] : Measure (Euclid N)).restrict G).map j := by
      rw [← hpre, ← hjme.restrict_map, hjiso.map_euclideanHausdorffMeasure,
        Measure.restrict_restrict_of_subset hSsub]
    refine ⟨fun ω => ?_, fun x hx => ⟨j x, ?_, hpj x⟩⟩
    · rw [hmeas, hjme.integral_map]
      simp only [hpj, hpcs]
    · show j x ∈ S
      rw [← Set.mem_preimage, hpre]
      exact hx
/-- **Simon 6.3.7** (the approximate tangent space of `φ(M)` at `φ(x)` is spanned by the images
`Dφ(x)(τᵢ)`), for a bi-Lipschitz `C¹` map `φ` with injective derivative and `φ⁻¹(U) = U`: for
`Hⁿ`-a.e. `x ∈ M`, `M` has the approximate tangent space `Q(x) = approxTangentPlane n M x` at `x`
and `φ(M)` has the approximate tangent space `Dφ(x)(Q(x))` at `φ(x)`.  `M` is, up to an
`Hⁿ`-null set, the union of bi-Lipschitz pieces `Fᵢ(Bᵢ)`; for a.e. `b ∈ Bᵢ`,
`T_{Fᵢ(b)}M = range DFᵢ(b)` and `T_{φ(Fᵢ(b))}φ(M) = range D(φ ∘ Fᵢ)(b) = Dφ(Fᵢ(b))(range DFᵢ(b))`,
and Lipschitz images of null parameter sets are `Hⁿ`-null. -/
theorem Submission.dpf_approxTangent_bilipschitz_image_ae : ∀ (P n : ℕ) (U M : Set (Euclid P)) (φ : Euclid P → Euclid P) (Λ : NNReal), IsOpen U → MeasurableSet M → M ⊆ U → CountablyRectifiable n M → (∀ C : Set (Euclid P), IsCompact C → C ⊆ U → μHE[n] (M ∩ C) ≠ ∞) → ContDiff ℝ 1 φ → (∀ x, Injective (fderiv ℝ φ x)) → LipschitzWith Λ φ → AntilipschitzWith Λ φ → φ ⁻¹' U = U → ∀ᵐ x ∂(μHE[n].restrict M), HasApproximateTangentSpaceAt n M x (approxTangentPlane n M x) ∧ HasApproximateTangentSpaceAt n (φ '' M) (φ x) (Submodule.map (fderiv ℝ φ x : Euclid P →ₗ[ℝ] Euclid P) (approxTangentPlane n M x)) := by
  intro P n U M φ Λ hU hM hMU hrect hloc hφ hφinj hlip hanti hpre
  -- Step 1: bi-Lipschitz pieces `Fᵢ(Bᵢ) ⊆ M` covering `M` up to an `Hⁿ`-null set
  obtain ⟨F, B, m, hFlip, hBmeas, hmpos, hFlow, hFdiff, -, hFM, -, hnull⟩ :=
    Submission.dpf_rectifiable_bilipschitz_pieces P n M hM hrect
  -- Step 3: `φ(M)` is Borel, contained in `U` and locally `Hⁿ`-finite in `U`
  obtain ⟨hφMmeas, hφMU, hφMloc⟩ :=
    Submission.dpf_itt_bilipschitz_image_locfin P n U M φ Λ Λ hM hMU hloc hlip hanti hpre
  -- Step 6: it suffices to prove the conclusion at `Fᵢ(b)` for a.e. `b ∈ Bᵢ`
  refine Submission.dpf_itt_ae_of_ae_pieces P n M F B _ hM hFlip hnull fun i => ?_
  obtain ⟨L, hL⟩ := hFlip i
  -- Step 4: `φ ∘ Fᵢ` is bi-Lipschitz on `Bᵢ`, with injective derivative of range
  -- `Dφ(Fᵢ(b))(range DFᵢ(b))`
  obtain ⟨hφFlip, ⟨m', hm'pos, hφFlow⟩, hφFdiff, hrange⟩ :=
    Submission.dpf_itt_comp_bilipschitz_piece P n (F i) φ (B i) L Λ Λ (m i) hL (hmpos i)
      (hFlow i) (hFdiff i) (hφ.differentiable one_ne_zero) hφinj hlip hanti
  -- Step 2: `T_{Fᵢ(b)}M = range DFᵢ(b)` for a.e. `b ∈ Bᵢ`
  have hM_ae := Submission.dpf_approxTangent_ae_bilipschitz_piece P n U M (F i) (B i) L (m i) hU
    hM hMU hloc hL (hBmeas i) (hmpos i) (hFlow i) (hFdiff i) (hFM i)
  -- Step 4: `T_{φ(Fᵢ(b))}φ(M) = range D(φ ∘ Fᵢ)(b)` for a.e. `b ∈ Bᵢ`
  have hφM_ae := Submission.dpf_approxTangent_ae_bilipschitz_piece P n U (φ '' M) (φ ∘ F i)
    (B i) (Λ * L) m' hU hφMmeas hφMU hφMloc hφFlip (hBmeas i) hm'pos hφFlow hφFdiff
    (by rw [image_comp]; exact image_mono (hFM i))
  -- Step 5: combine, using `Q(Fᵢ(b)) = range DFᵢ(b)` (uniqueness of approximate tangent planes)
  filter_upwards [hM_ae, hφM_ae, ae_restrict_mem (hBmeas i)] with b hb hφb hbB
  rw [Submission.dpf_itt_approxTangentPlane_eq P n M (F i b) _ hb, ← hrange b hbB]
  exact ⟨hb, hφb⟩
/-- **Simon Ch. 3, 2.3–2.6 (area formula, 2.6)** for an injective Lipschitz `C¹` map `φ` on a
countably `n`-rectifiable `M`, with the tangential Jacobian
`J(x) = (det(Dφ(x)eₐ · Dφ(x)e_b))^{1/2}`, `e` the standard orthonormal basis of `TₓM`:
`∫_{φ(M)} g dHⁿ = ∫_M J (g ∘ φ) dHⁿ` for every `g ≥ 0`.  Decompose `M` into disjoint bi-Lipschitz
pieces `Pᵢ = Fᵢ(Bᵢ)` up to an `Hⁿ`-null set.  For a.e. `b ∈ Bᵢ`, `T_{Fᵢ b}M = range DFᵢ(b)`
(density lemma and uniqueness of approximate tangent planes).  Both sides split along the pieces
(for `φ`, and for `id`), and on each piece the per-piece area identity applies. -/
theorem Submission.dpf_area_formula_bilipschitz_rectifiable : ∀ (P n : ℕ) (U M : Set (Euclid P)) (φ : Euclid P → Euclid P) (Λ : NNReal), IsOpen U → MeasurableSet M → M ⊆ U → CountablyRectifiable n M → (∀ C : Set (Euclid P), IsCompact C → C ⊆ U → μHE[n] (M ∩ C) ≠ ∞) → ContDiff ℝ 1 φ → LipschitzWith Λ φ → Injective φ → ∀ g : Euclid P → ℝ≥0∞, ∫⁻ y in φ '' M, g y ∂μHE[n] = ∫⁻ x in M, ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ (approxTangentPlane n M x)) => inner ℝ (fderiv ℝ φ x (stdOrthonormalBasis ℝ (approxTangentPlane n M x) i)) (fderiv ℝ φ x (stdOrthonormalBasis ℝ (approxTangentPlane n M x) j))))) * g (φ x) ∂μHE[n] := by
  intro P n U M φ Λ hU hM hMU hrect hloc hφ1 hφ hφinj g
  -- Step 1: disjoint bi-Lipschitz pieces `Fᵢ(Bᵢ) ⊆ M`, covering `M` up to an `Hⁿ`-null set
  obtain ⟨F, B, m, hF, hB, hm, hlow, hdiff, hFBm, hFB, hdisj, hnull⟩ :=
    Submission.dpf_rectifiable_bilipschitz_pieces P n M hM hrect
  -- `Fᵢ` is injective on `Bᵢ`: `mᵢ‖a - a'‖ ≤ ‖Fᵢ a - Fᵢ a'‖` with `mᵢ > 0`
  have hinj : ∀ i, InjOn (F i) (B i) := by
    intro i a ha a' ha' h
    have h1 := hlow i a ha a' ha'
    rw [h, sub_self, norm_zero] at h1
    exact sub_eq_zero.mp (norm_le_zero_iff.mp (nonpos_of_mul_nonpos_right h1 (hm i)))
  -- Step 2: `T_{Fᵢ b}M = range DFᵢ(b)` for a.e. `b ∈ Bᵢ`
  have htan : ∀ i, ∀ᵐ b ∂(volume.restrict (B i)), approxTangentPlane n M (F i b) =
      LinearMap.range (fderiv ℝ (F i) b : Euclid n →ₗ[ℝ] Euclid P) := by
    intro i
    obtain ⟨L, hL⟩ := hF i
    filter_upwards [Submission.dpf_approxTangent_ae_bilipschitz_piece P n U M (F i) (B i) L (m i)
      hU hM hMU hloc hL (hB i) (hm i) (hlow i) (hdiff i) (hFB i)] with b hb
    have hex : ∃ Q, HasApproximateTangentSpaceAt n M (F i b) Q := ⟨_, hb⟩
    rw [approxTangentPlane, dite_eq_left hex]
    exact hex.choose_spec.unique hb
  -- Step 3: split both sides along the pieces (`φ`, resp. `id`, is Lipschitz and injective)
  have hsplit : ∀ w : Euclid P → ℝ≥0∞,
      ∫⁻ x in M, w x ∂μHE[n] = ∑' i, ∫⁻ x in F i '' B i, w x ∂μHE[n] := fun w => by
    simpa only [image_id] using Submission.dpf_raf_lintegral_image_eq_tsum_pieces P n M
      (fun i => F i '' B i) id 1 hFBm hFB hdisj hnull LipschitzWith.id injective_id w
  rw [Submission.dpf_raf_lintegral_image_eq_tsum_pieces P n M (fun i => F i '' B i) φ Λ hFBm hFB
    hdisj hnull hφ hφinj g, hsplit]
  -- Step 4: the area identity on each piece, with `Q = approxTangentPlane n M`
  refine tsum_congr fun i => ?_
  obtain ⟨L, hL⟩ := hF i
  exact Submission.dpf_raf_piece_area_formula_gram P n (approxTangentPlane n M) φ Λ (F i) L (B i)
    (hφ1.differentiable one_ne_zero) hφ hL (hB i) (hinj i) hφinj.injOn (htan i) g
/-- **Gram determinant = determinant of the compression** (Simon Ch. 3, (2.3)).  If `e` is an
orthonormal basis of a subspace `V ⊆ ℝᴾ`, `p = p_V` and `A : ℝᴾ → ℝᴾ` is linear, then
`det(⟨A eᵢ, A eⱼ⟩) = det(p A* A p + (I − p))`.  `T := p A* A p + (I − p)` maps `V` into `V` and
induces the identity on `ℝᴾ/V` (`T x − x = p A* A p x − p x ∈ V`), so `det T = det(T|_V)`
(`LinearMap.det_eq_det_mul_det`); the matrix of `T|_V` in `e` has entries
`⟨eᵢ, p A* A eⱼ⟩ = ⟨p eᵢ, A* A eⱼ⟩ = ⟨A eᵢ, A eⱼ⟩`, i.e. it is the Gram matrix. -/
theorem Submission.dpf_jm_gram_det_eq_det_compression : ∀ (P : ℕ) (V : Submodule ℝ (Euclid P)) {ι : Type} [Fintype ι] [DecidableEq ι] (e : OrthonormalBasis ι ℝ V) (A : Euclid P →L[ℝ] Euclid P), Matrix.det (Matrix.of fun i j : ι => inner ℝ (A (e i)) (A (e j))) = (V.starProjection ∘L (A.adjoint ∘L A) ∘L V.starProjection + (ContinuousLinearMap.id ℝ (Euclid P) - V.starProjection)).det := by
  intro P V ι _ _ e A
  set p := V.starProjection with hp_def
  set T : Euclid P →L[ℝ] Euclid P :=
    p ∘L (A.adjoint ∘L A) ∘L p + (ContinuousLinearMap.id ℝ (Euclid P) - p) with hT_def
  -- `V` is `T`-invariant: `T v = p (A* A v)` for `v ∈ V`
  have hT : V ≤ V.comap (T : Euclid P →ₗ[ℝ] Euclid P) := by
    intro v hv
    have hpv : p v = v := Submodule.starProjection_eq_self_iff.mpr hv
    simp only [Submodule.mem_comap, ContinuousLinearMap.coe_coe, hT_def,
      add_apply, ContinuousLinearMap.comp_apply,
      sub_apply, ContinuousLinearMap.id_apply, hpv, sub_self, add_zero]
    exact V.starProjection_apply_mem _
  -- `T` induces the identity on `ℝᴾ/V`: `T x - x = p (A* A p x) - p x ∈ V`
  have hQ : V.mapQ V (T : Euclid P →ₗ[ℝ] Euclid P) hT = LinearMap.id := by
    apply Submodule.linearMap_qext
    ext x
    simp only [LinearMap.coe_comp, Function.comp_apply, Submodule.mkQ_apply,
      Submodule.mapQ_apply, LinearMap.id_comp]
    rw [Submodule.Quotient.eq]
    have : (T : Euclid P →ₗ[ℝ] Euclid P) x - x = p ((A.adjoint ∘L A) (p x)) - p x := by
      simp only [ContinuousLinearMap.coe_coe, hT_def, add_apply,
        ContinuousLinearMap.comp_apply, sub_apply,
        ContinuousLinearMap.id_apply]
      abel
    rw [this]
    exact V.sub_mem (V.starProjection_apply_mem _) (V.starProjection_apply_mem _)
  -- block-triangular determinant: `det T = det (T|_V) * det id`
  have hsplit := LinearMap.det_eq_det_mul_det V (T : Euclid P →ₗ[ℝ] Euclid P) hT
  rw [hQ, LinearMap.det_id, mul_one] at hsplit
  rw [ContinuousLinearMap.det, hsplit, ← LinearMap.det_toMatrix e.toBasis]
  -- the matrix of `T|_V` in `e` is the Gram matrix
  congr 1
  ext i j
  rw [LinearMap.toMatrix_apply, OrthonormalBasis.coe_toBasis,
    OrthonormalBasis.coe_toBasis_repr_apply, OrthonormalBasis.repr_apply_apply, Matrix.of_apply]
  have hpj : p (e j) = e j := Submodule.starProjection_eq_self_iff.mpr (e j).2
  have hpi : p (e i) = e i := Submodule.starProjection_eq_self_iff.mpr (e i).2
  rw [Submodule.coe_inner, LinearMap.coe_restrict_apply]
  simp only [ContinuousLinearMap.coe_coe, hT_def, add_apply,
    ContinuousLinearMap.comp_apply, sub_apply,
    ContinuousLinearMap.id_apply, hpj, sub_self, add_zero]
  rw [← Submodule.inner_starProjection_left_eq_right, hpi,
    ContinuousLinearMap.adjoint_inner_right]
/-- **A.e. strong measurability of `√det(p L* L p + I − p)`** (Simon Ch. 3, 2.3–2.4: `J^M_f` is
`Hⁿ`-measurable; used for the Jacobian in 7.1.2).  If `p, L : ℝᴾ → End(ℝᴾ)` are `μ`-a.e. strongly
measurable, then so is `x ↦ √det(p(x) ∘ L(x)* ∘ L(x) ∘ p(x) + (I − p(x)))`.  It is `Φ(p(x), L(x))`
for `Φ(q, B) = √det(q ∘ (B* ∘ B) ∘ q + (I − q))` on `End(ℝᴾ) × End(ℝᴾ)`, which is continuous
(the adjoint, composition, `det` in finite dimension and `√` are continuous), and a continuous
function of the a.e. strongly measurable pair `(p, L)` is a.e. strongly measurable. -/
theorem Submission.dpf_jm_aestronglyMeasurable_sqrt_det_compression : ∀ (P : ℕ) (μ : Measure (Euclid P)) (p L : Euclid P → (Euclid P →L[ℝ] Euclid P)), AEStronglyMeasurable p μ → AEStronglyMeasurable L μ → AEStronglyMeasurable (fun x => Real.sqrt ((p x ∘L ((L x).adjoint ∘L L x) ∘L p x + (ContinuousLinearMap.id ℝ (Euclid P) - p x)).det)) μ := by
  intro P μ p L hp hL
  -- `B ↦ B*` is a linear isometric equivalence of `End(ℝᴾ)`, hence continuous
  have hadj : Continuous fun q : (Euclid P →L[ℝ] Euclid P) × (Euclid P →L[ℝ] Euclid P) =>
      (q.2).adjoint :=
    (ContinuousLinearMap.adjoint (𝕜 := ℝ) (E := Euclid P) (F := Euclid P)).continuous.comp
      continuous_snd
  -- `Φ(q, B) = √det(q ∘ (B* ∘ B) ∘ q + (I − q))` is continuous on `End(ℝᴾ) × End(ℝᴾ)`
  have hΦ : Continuous fun q : (Euclid P →L[ℝ] Euclid P) × (Euclid P →L[ℝ] Euclid P) =>
      Real.sqrt ((q.1 ∘L ((q.2).adjoint ∘L q.2) ∘L q.1 +
        (ContinuousLinearMap.id ℝ (Euclid P) - q.1)).det) := by
    refine Real.continuous_sqrt.comp (ContinuousLinearMap.continuous_det.comp ?_)
    refine Continuous.add ?_ (continuous_const.sub continuous_fst)
    exact continuous_fst.clm_comp ((hadj.clm_comp continuous_snd).clm_comp continuous_fst)
  -- compose with the a.e. strongly measurable pair `x ↦ (p x, L x)`
  have h := hΦ.comp_aestronglyMeasurable (hp.prodMk hL)
  exact h

/-- **The tangential Jacobian is a.e. strongly measurable** (Simon Ch. 3, 2.3 and the remark
"Thus `J^M_f` is `Hⁿ`-measurable", chapter-03.txt lines 362–385; step 7 of the push-forward
proof, Simon 6.2.23–2.24).  If `x ↦ p_{Q(x)}` (orthogonal projection onto `Q(x)`) and `x ↦ L(x)`
are `μ`-a.e. strongly measurable, so is `x ↦ (det(L(x)eₐ · L(x)e_b))^{1/2}`, `e` the standard
orthonormal basis of `Q(x)`: the Gram determinant is `det(p L(x)* L(x) p + I − p)`,
`p = p_{Q(x)}`, a continuous function of the pair `(p_{Q(x)}, L(x))`. -/
theorem Submission.dpf_aestronglyMeasurable_gramJacobian : ∀ (P : ℕ) (μ : Measure (Euclid P)) (Q : Euclid P → Submodule ℝ (Euclid P)) (L : Euclid P → (Euclid P →L[ℝ] Euclid P)), AEStronglyMeasurable (fun x => (Q x).starProjection) μ → AEStronglyMeasurable L μ → AEStronglyMeasurable (fun x => Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ (Q x)) => inner ℝ (L x (stdOrthonormalBasis ℝ (Q x) i)) (L x (stdOrthonormalBasis ℝ (Q x) j))))) μ := by
  intro P μ Q L hp hL
  -- for each `x`, `det(L(x)eₐ · L(x)e_b) = det(p L(x)* L(x) p + I − p)` with `p = p_{Q(x)}`
  simp_rw [Submission.dpf_jm_gram_det_eq_det_compression P (Q _) (stdOrthonormalBasis ℝ (Q _))
    (L _)]
  -- `(q, B) ↦ √det(q B* B q + I − q)` is continuous and `x ↦ (p_{Q(x)}, L(x))` is a.e. strongly
  -- measurable
  exact Submission.dpf_jm_aestronglyMeasurable_sqrt_det_compression P μ
    (fun x => (Q x).starProjection) L hp hL
/-- Basis independence of the Gram determinant `det(Dᵢf · Dⱼf)` of the Jacobian (Simon Ch. 6,
3.4–3.7; push-forward of an orientation in 7.1.2): if the orthonormal `n`-frame `τ` spans `Q`, then
`det(⟨L eᵢ, L eⱼ⟩) = det(⟨L τₐ, L τ_b⟩)` for `e = stdOrthonormalBasis ℝ Q`.  With
`L' = L ∘ ι_Q` and `T = L'^* L'`, the matrix of `T` in any orthonormal basis `b` of `Q` is the
Gram matrix `(⟨L bᵢ, L bⱼ⟩)`, so both determinants equal `det T`. -/
theorem Submission.dpf_det_gram_stdOrthonormalBasis_eq : ∀ (P n : ℕ) (Q : Submodule ℝ (Euclid P)) (L : Euclid P →L[ℝ] Euclid P) (τ : Fin n → Euclid P), Orthonormal ℝ τ → Submodule.span ℝ (Set.range τ) = Q → Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ Q) => inner ℝ (L (stdOrthonormalBasis ℝ Q i)) (L (stdOrthonormalBasis ℝ Q j))) = Matrix.det (Matrix.of fun i j : Fin n => inner ℝ (L (τ i)) (L (τ j))) := by
  intro P n Q L τ hτ hQ
  -- `L' = L ∘ ι_Q : Q → ℝᴾ` and the endomorphism `T = L'^* L'` of `Q`
  let L' : Q →ₗ[ℝ] Euclid P := (L : Euclid P →ₗ[ℝ] Euclid P) ∘ₗ Q.subtype
  let T : Q →ₗ[ℝ] Q := LinearMap.adjoint L' ∘ₗ L'
  -- in an orthonormal basis `b` of `Q`, the matrix of `T` is the Gram matrix `(⟨L bᵢ, L bⱼ⟩)`
  have key : ∀ {ι : Type} [Fintype ι] [DecidableEq ι] (b : OrthonormalBasis ι ℝ Q),
      Matrix.det (Matrix.of fun i j : ι => inner ℝ (L (b i : Euclid P)) (L (b j : Euclid P))) =
        LinearMap.det T := by
    intro ι _ _ b
    rw [← LinearMap.det_toMatrix b.toBasis T]
    congr 1
    ext i j
    rw [LinearMap.toMatrix_apply, OrthonormalBasis.coe_toBasis,
      OrthonormalBasis.coe_toBasis_repr_apply, OrthonormalBasis.repr_apply_apply]
    simp only [T, LinearMap.comp_apply, LinearMap.adjoint_inner_right, Matrix.of_apply]
    rfl
  -- `τ`, regarded in `Q`, is an orthonormal basis of `Q`
  have hmem : ∀ a, τ a ∈ Q := fun a => hQ ▸ Submodule.subset_span (Set.mem_range_self a)
  let τ' : Fin n → Q := fun a => ⟨τ a, hmem a⟩
  have hτ' : Orthonormal ℝ τ' := by
    rw [orthonormal_iff_ite] at hτ ⊢
    exact hτ
  have hspan' : ⊤ ≤ Submodule.span ℝ (Set.range τ') := by
    have hmap : Submodule.map Q.subtype (Submodule.span ℝ (Set.range τ')) =
        Submodule.map Q.subtype ⊤ := by
      rw [Submodule.map_span, ← Set.range_comp, Submodule.map_top, Submodule.range_subtype]
      exact hQ
    rw [Submodule.map_injective_of_injective Q.injective_subtype hmap]
  have h2 := key (OrthonormalBasis.mk hτ' hspan')
  simp only [OrthonormalBasis.coe_mk] at h2
  exact (key (stdOrthonormalBasis ℝ Q)).trans h2.symm
/-- Steps 3–5 of the orientation push-forward (Simon 6.3.4–3.5, with the orthonormal basis of
`span v` chosen by Gram–Schmidt): a linearly independent family `v` in `ℝᴾ` has an orthonormal
frame `σ` with the same span such that `A = (⟨σᵢ, vⱼ⟩)` satisfies `det(⟨vᵢ, vⱼ⟩) = (det A)²`,
`det A ≠ 0` and `|det A| ≤ ∏ᵢ |vᵢ|`.  Gram–Schmidt in `W = span v` makes `A` the upper-triangular
matrix of `v` in an orthonormal basis of `W`, and Parseval gives `(⟨vᵢ, vⱼ⟩) = AᵀA`. -/
theorem Submission.dpf_exists_orthonormal_frame_det_gram : ∀ (P n : ℕ) (v : Fin n → Euclid P), LinearIndependent ℝ v → ∃ σ : Fin n → Euclid P, Orthonormal ℝ σ ∧ Submodule.span ℝ (Set.range σ) = Submodule.span ℝ (Set.range v) ∧ Matrix.det (Matrix.of fun i j => inner ℝ (v i) (v j)) = Matrix.det (Matrix.of fun i j => inner ℝ (σ i) (v j)) ^ 2 ∧ Matrix.det (Matrix.of fun i j => inner ℝ (σ i) (v j)) ≠ 0 ∧ |Matrix.det (Matrix.of fun i j => inner ℝ (σ i) (v j))| ≤ ∏ i, ‖v i‖ := by
  intro P n v hv
  set W := Submodule.span ℝ (Set.range v)
  -- `v` regarded in `W` is a linearly independent spanning family `w`
  let w : Fin n → W := fun j => ⟨v j, Submodule.subset_span ⟨j, rfl⟩⟩
  have hw : LinearIndependent ℝ w := LinearIndependent.of_comp W.subtype hv
  have hspan_w : Submodule.span ℝ (Set.range w) = ⊤ := by
    apply Submodule.map_injective_of_injective W.injective_subtype
    rw [Submodule.map_span, ← Set.range_comp, Submodule.map_top, Submodule.range_subtype]
    rfl
  -- the Gram–Schmidt orthonormal basis `b` of `W`, and `σ = b` regarded in `ℝᴾ`
  let b := InnerProductSpace.gramSchmidtOrthonormalBasis (finrank_span_eq_card hv) w
  let σ : Fin n → Euclid P := fun i => (b i : Euclid P)
  -- `A` is the (upper-triangular) matrix of `w` in the basis `b`
  have hA : (Matrix.of fun i j => inner ℝ (σ i) (v j)) = b.toBasis.toMatrix w := by
    ext i j
    rw [Module.Basis.toMatrix_apply, OrthonormalBasis.coe_toBasis_repr_apply,
      OrthonormalBasis.repr_apply_apply, Submodule.coe_inner]
    rfl
  have hdet : Matrix.det (Matrix.of fun i j => inner ℝ (σ i) (v j)) =
      ∏ i, inner ℝ (σ i) (v i) := by
    rw [hA, ← Module.Basis.det_apply, InnerProductSpace.gramSchmidtOrthonormalBasis_det]
    rfl
  refine ⟨σ, b.orthonormal.comp_linearIsometry W.subtypeₗᵢ, ?_, ?_, ?_, ?_⟩
  · -- `span σ = W`
    have hb : Submodule.span ℝ (Set.range b) = ⊤ := b.toBasis.span_eq
    have hσ : Set.range σ = W.subtype '' Set.range b := Set.range_comp _ _
    rw [hσ, Submodule.span_image, hb, Submodule.map_top, Submodule.range_subtype]
  · -- Parseval: `(⟨vᵢ, vⱼ⟩) = AᵀA`
    have hG : (Matrix.of fun i j => inner ℝ (v i) (v j)) =
        Matrix.transpose (Matrix.of fun i j => inner ℝ (σ i) (v j)) *
          Matrix.of fun i j => inner ℝ (σ i) (v j) := by
      ext i j
      have hp := b.sum_inner_mul_inner (w i) (w j)
      simp only [Submodule.coe_inner] at hp
      rw [Matrix.mul_apply, Matrix.of_apply, ← hp]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [Matrix.transpose_apply, Matrix.of_apply, Matrix.of_apply, real_inner_comm]
    rw [hG, Matrix.det_mul, Matrix.det_transpose, sq]
  · -- `det A = det_b w` is a unit
    rw [hA, ← Module.Basis.det_apply]
    exact ((Module.Basis.is_basis_iff_det b.toBasis).mp ⟨hw, hspan_w⟩).ne_zero
  · -- Cauchy–Schwarz on the diagonal entries
    rw [hdet, Finset.abs_prod]
    refine Finset.prod_le_prod₀ (fun i _ => abs_nonneg _) fun i _ => ?_
    calc |inner ℝ (σ i) (v i)| ≤ ‖σ i‖ * ‖v i‖ := abs_real_inner_le_norm _ _
      _ = ‖v i‖ := by rw [show ‖σ i‖ = 1 from b.norm_eq_one i, one_mul]
/-- Orientation of the push-forward by an injective linear map (Simon Ch. 6, 3.4–3.5 and 3.7:
`L_#ξ = J η`): if `ξ` is a unit orientation of `Q`, `ζ(β) = ξ(β ∘ L)` and
`J = (det(Leₐ · Le_b))^{1/2}` for the orthonormal basis `e` of `Q`, then `0 < J ≤ ‖L‖ⁿ` and `J⁻¹ζ`
is a unit orientation of `L(Q)`.  With `ξ = ±τ₁ ∧ ⋯ ∧ τₙ` and `σ` an orthonormal frame of
`span (Lτ) = L(Q)`, `β(Lτ) = det A · β(σ)` for `A = (⟨σᵢ, Lτⱼ⟩)`, and `J = |det A|`. -/
theorem Submission.dpf_unitOrientation_map_gramNormalized : ∀ (P n : ℕ) (Q : Submodule ℝ (Euclid P)) (ξ : MultiVector P n) (L : Euclid P →L[ℝ] Euclid P) (J : ℝ), IsUnitOrientationOf ξ Q → Injective L → J = Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ Q) => inner ℝ (L (stdOrthonormalBasis ℝ Q i)) (L (stdOrthonormalBasis ℝ Q j)))) → 0 < J ∧ J ≤ ‖L‖ ^ n ∧ IsUnitOrientationOf (J⁻¹ • ξ.comp (ContinuousAlternatingMap.compContinuousLinearMapCLM L)) (Submodule.map (L : Euclid P →ₗ[ℝ] Euclid P) Q) := by
  intro P n Q ξ L J hξ hL hJ
  -- `ξ = ±τ₁ ∧ ⋯ ∧ τₙ` for an orthonormal basis `τ` of `Q`
  obtain ⟨τ, hτ, hτQ, hξτ⟩ := hξ
  -- `Lτ` is linearly independent; let `σ` be an orthonormal frame of `span (Lτ)` (Gram–Schmidt)
  have hv : LinearIndependent ℝ fun i => L (τ i) :=
    hτ.linearIndependent.map' (L : Euclid P →ₗ[ℝ] Euclid P) (LinearMap.ker_eq_bot.mpr hL)
  obtain ⟨σ, hσ, hσv, hdet, hA0, hAle⟩ :=
    Submission.dpf_exists_orthonormal_frame_det_gram P n (fun i => L (τ i)) hv
  -- `α(Lτ) = det A · α(σ)` for every `n`-covector `α`, where `A = (⟨σᵢ, Lτⱼ⟩)`: the restriction
  -- of `α` to `span σ` is `α(σ) det_σ`, and the coordinates of `Lτⱼ` in the basis `σ` are `Aᵢⱼ`
  have hcov : ∀ α : Covector (Euclid P) n, α (fun j => L (τ j)) =
      (Matrix.of fun i j => inner ℝ (σ i) (L (τ j))).det * α σ := by
    intro α
    set S := Submodule.span ℝ (Set.range σ)
    have hvS : ∀ j, L (τ j) ∈ S := fun j => by
      rw [hσv]
      exact Submodule.subset_span (Set.mem_range_self j)
    let e : Module.Basis (Fin n) ℝ S := Module.Basis.span hσ.linearIndependent
    have he : ∀ i, (e i : Euclid P) = σ i := fun i => by
      rw [Module.Basis.span_apply hσ.linearIndependent i]
    let αS : S [⋀^Fin n]→ₗ[ℝ] ℝ := α.toAlternatingMap.compLinearMap S.subtype
    let w : Fin n → S := fun j => ⟨L (τ j), hvS j⟩
    have h1 : α (fun j => L (τ j)) = αS w := rfl
    have h2 : α σ = αS e := by
      show α σ = α (fun i => (e i : Euclid P))
      congr 1
      funext i
      exact (he i).symm
    have hrepr : ∀ i j, e.repr (w j) i = inner ℝ (σ i) (L (τ j)) := by
      intro i j
      have hs : L (τ j) = ∑ l, e.repr (w j) l • σ l := by
        have := congrArg Subtype.val (e.sum_repr (w j))
        simp only [Submodule.coe_sum, Submodule.coe_smul, he] at this
        exact this.symm
      rw [hs, hσ.inner_right_fintype]
    have hmat : e.toMatrix w = Matrix.of fun i j => inner ℝ (σ i) (L (τ j)) := by
      ext i j
      rw [Module.Basis.toMatrix_apply, hrepr, Matrix.of_apply]
    have h3 : αS w = αS e * e.det w := by
      conv_lhs => rw [AlternatingMap.eq_smul_basis_det e αS]
      rfl
    rw [h1, h2, h3, Module.Basis.det_apply, hmat, mul_comm]
  generalize (Matrix.of fun i j => inner ℝ (σ i) (L (τ j))).det = d at hdet hA0 hAle hcov
  -- `J = √(det G(Le)) = √(det G(Lτ)) = √((det A)²) = |det A|`
  have hJd : J = |d| := by
    rw [hJ, Submission.dpf_det_gram_stdOrthonormalBasis_eq P n Q L τ hτ hτQ, hdet,
      Real.sqrt_sq_eq_abs]
  refine ⟨by rw [hJd]; exact abs_pos.mpr hA0, ?_, σ, hσ, ?_, ?_⟩
  · -- `J = |det A| ≤ ∏ᵢ ‖Lτᵢ‖ ≤ ‖L‖ⁿ`
    rw [hJd]
    refine hAle.trans ?_
    calc ∏ i, ‖L (τ i)‖ ≤ ∏ _i : Fin n, ‖L‖ :=
          Finset.prod_le_prod₀ (fun i _ => norm_nonneg _) fun i _ => by
            simpa [hτ.1 i] using L.le_opNorm (τ i)
      _ = ‖L‖ ^ n := by simp
  · -- `span σ = span (Lτ) = L(span τ) = L(Q)`
    rw [hσv, ← hτQ, Submodule.map_span, ← Set.range_comp]
    rfl
  · -- `(J⁻¹ζ)(α) = J⁻¹ ξ(α ∘ L) = ±J⁻¹ α(Lτ) = ±(J⁻¹ det A) α(σ)` with `J⁻¹ det A = ±1`
    have hζ : ∀ α : Covector (Euclid P) n,
        (J⁻¹ • ξ.comp (ContinuousAlternatingMap.compContinuousLinearMapCLM L)) α =
          J⁻¹ * ξ (α.compContinuousLinearMap L) := fun α => rfl
    have hατ : ∀ α : Covector (Euclid P) n, α.compContinuousLinearMap L τ = d * α σ :=
      fun α => hcov α
    have hsign : J⁻¹ * d = 1 ∨ J⁻¹ * d = -1 := by
      rw [hJd]
      rcases hA0.lt_or_gt with h | h
      · exact Or.inr (by rw [abs_of_neg h, inv_neg, neg_mul, inv_mul_cancel₀ hA0])
      · exact Or.inl (by rw [abs_of_pos h, inv_mul_cancel₀ hA0])
    rcases hξτ with hξτ | hξτ <;> rcases hsign with hs | hs
    · exact Or.inl fun α => by rw [hζ, hξτ, hατ]; linear_combination α σ * hs
    · exact Or.inr fun α => by rw [hζ, hξτ, hατ]; linear_combination α σ * hs
    · exact Or.inr fun α => by rw [hζ, hξτ, hατ]; linear_combination -α σ * hs
    · exact Or.inl fun α => by rw [hζ, hξτ, hατ]; linear_combination -α σ * hs

/-- Simon 6.3.6–3.9 and 6.2.24(3) for a `C¹` bi-Lipschitz bijection `φ` with `φ⁻¹(U) = U`
(step 9 of the push-forward proof): `ω ↦ ∫_M θ ⟨ω(φ(x)) ∘ Dφ(x), ξ⟩ dHⁿ` is the action of the
integer multiplicity triple `R' = (φ(M), θ ∘ φ⁻¹, η ∘ φ⁻¹)`, where `η = J⁻¹ ξ(· ∘ Dφ)` and `J` is
the Gram Jacobian of `Dφ` on `TₓM`.  A.e. on `M`, `0 < J` and `η(x)` orients
`Dφ(x)TₓM = T_{φ(x)}φ(M)`; the area formula then transfers the action from `φ(M)` to `M`. -/
theorem Submission.dpf_imrep_bilipschitz_image_rep : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (φ : Euclid P → Euclid P) (Λ : NNReal), IsOpen U → ContDiff ℝ 1 φ → Bijective φ → (∀ x, Injective (fderiv ℝ φ x)) → LipschitzWith Λ φ → AntilipschitzWith Λ φ → φ ⁻¹' U = U → AEStronglyMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) (μHE[n].restrict R.carrier) → ∃ R' : IMRep U n, ∀ ω : TestFormOn U n, R'.action (ω : DifferentialForm (Euclid P) n) = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (φ x)).compContinuousLinearMap (fderiv ℝ φ x)) ∂μHE[n] := by
  intro P n U R φ Λ hU hφ hbij hinj hlip hanti hpre hproj
  -- Step 2: `θ ≥ 1` on `M`, so `M` has locally finite `Hⁿ`-measure in `U`
  have hfin : ∀ C : Set (Euclid P), IsCompact C → C ⊆ U → μHE[n] (R.carrier ∩ C) ≠ ∞ := by
    intro C hC hCU
    refine ne_top_of_le_ne_top (R.locallyIntegrable_mult C hC hCU) ?_
    calc μHE[n] (R.carrier ∩ C) = ∫⁻ _ in R.carrier ∩ C, 1 ∂μHE[n] := (setLIntegral_one _).symm
      _ ≤ ∫⁻ x in R.carrier ∩ C, (R.mult x : ℝ≥0∞) ∂μHE[n] :=
        setLIntegral_mono' (R.measurableSet_carrier.inter hC.isClosed.measurableSet)
          fun x hx => Nat.one_le_cast.2 (R.mult_pos x hx.1)
  have hφc : Continuous φ := hφ.continuous
  have hDφ : Continuous (fderiv ℝ φ) := hφ.continuous_fderiv one_ne_zero
  -- Step 3 (I): the Gram Jacobian `J` of `Dφ` on `TₓM` is a.e. strongly measurable
  obtain ⟨J, hJ⟩ : ∃ J : Euclid P → ℝ, J = fun x => Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ (approxTangentPlane n R.carrier x)) => inner ℝ (fderiv ℝ φ x (stdOrthonormalBasis ℝ (approxTangentPlane n R.carrier x) i)) (fderiv ℝ φ x (stdOrthonormalBasis ℝ (approxTangentPlane n R.carrier x) j)))) :=
    ⟨_, rfl⟩
  have hJm : AEStronglyMeasurable J (μHE[n].restrict R.carrier) := by
    rw [hJ]
    exact Submission.dpf_aestronglyMeasurable_gramJacobian P (μHE[n].restrict R.carrier)
      (approxTangentPlane n R.carrier) (fderiv ℝ φ) hproj hDφ.aestronglyMeasurable
  -- Step 4: the orientation `η = J⁻¹ ζ`, `ζ(x)(β) = ξ(x)(β ∘ Dφ(x))`, in source coordinates
  set η : Euclid P → MultiVector P n := fun x => (J x)⁻¹ •
    (R.orient x).comp (ContinuousAlternatingMap.compContinuousLinearMapCLM (fderiv ℝ φ x))
  have hηm : AEStronglyMeasurable η (μHE[n].restrict R.carrier) := by
    have hζ : AEStronglyMeasurable (fun x => (R.orient x).comp
        (ContinuousAlternatingMap.compContinuousLinearMapCLM (fderiv ℝ φ x)))
        (μHE[n].restrict R.carrier) :=
      (continuous_fst.clm_comp continuous_snd).comp_aestronglyMeasurable
        (R.aestronglyMeasurable_orient.prodMk
          (ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM.comp_aestronglyMeasurable
            hDφ.aestronglyMeasurable))
    exact hJm.aemeasurable.inv.aestronglyMeasurable.smul hζ
  -- Step 3: a.e. on `M`, `0 < J` and `η` orients `Dφ(x)TₓM`, the approximate tangent plane of
  -- `φ(M)` at `φ(x)` (`ξ(x)` orients `TₓM` by uniqueness of approximate tangent planes)
  have hgood : ∀ᵐ x ∂(μHE[n].restrict R.carrier), 0 < J x ∧ ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n (φ '' R.carrier) (φ x) Q ∧ IsUnitOrientationOf (η x) Q := by
    filter_upwards [Submission.dpf_approxTangent_bilipschitz_image_ae P n U R.carrier φ Λ hU
      R.measurableSet_carrier R.carrier_subset R.rectifiable hfin hφ hinj hlip hanti hpre,
      R.orients] with x hx hξ
    obtain ⟨Q, hQ, hξQ⟩ := hξ
    rw [hQ.unique hx.1] at hξQ
    obtain ⟨hJpos, -, hηQ⟩ := Submission.dpf_unitOrientation_map_gramNormalized P n
      (approxTangentPlane n R.carrier x) (R.orient x) (fderiv ℝ φ x) (J x) hξQ (hinj x)
      (by rw [hJ])
    exact ⟨hJpos, _, hx.2, hηQ⟩
  -- Step 5: `R' = (φ(M), θ ∘ φ⁻¹, η ∘ φ⁻¹)` is an integer multiplicity triple in `U`
  obtain ⟨R', hR'c, hR'⟩ := Submission.dpfir_bilipschitz_image_imrep_exists P n U R φ Λ η hbij
    hlip hanti hpre hηm (hgood.mono fun x hx => hx.2)
  refine ⟨R', fun ω => ?_⟩
  obtain ⟨w, ⟨hws, hwc⟩, hwU⟩ := ω
  show R'.action w = ∫ x in R.carrier,
    (R.mult x : ℝ) * R.orient x ((w (φ x)).compContinuousLinearMap (fderiv ℝ φ x)) ∂μHE[n]
  have hwcont : Continuous w := ContDiff.continuous hws
  -- Step 6(b): `β(x) = ω(φ(x)) ∘ Dφ(x)` is continuous with compact support `⊆ φ⁻¹(spt ω) ⊆ U`
  set β : Euclid P → Covector (Euclid P) n :=
    fun x => (w (φ x)).compContinuousLinearMap (fderiv ℝ φ x) with hβ
  have hβc : Continuous β :=
    (ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM.comp hDφ).clm_apply
      (hwcont.comp hφc)
  have hβsupp : tsupport β ⊆ φ ⁻¹' tsupport w := by
    refine closure_minimal (fun x hx => subset_tsupport w fun h0 => hx ?_)
      ((isClosed_tsupport w).preimage hφc)
    ext v
    simp [hβ, h0]
  have hβcs : HasCompactSupport β :=
    (Metric.isCompact_of_isClosed_isBounded ((isClosed_tsupport w).preimage hφc)
      (hanti.isBounded_preimage hwc.isCompact.isBounded)).of_isClosed_subset
      (isClosed_tsupport β) hβsupp
  have hβU : tsupport β ⊆ U := hβsupp.trans ((preimage_mono hwU).trans hpre.subset)
  -- Step 6(a): `J(x) h(φ(x)) = g_ω(x)` a.e. on `M`, where `h = θ'⟨ω, ξ'⟩` and `g_ω = θ⟨β, ξ⟩`
  have hJh : ∀ᵐ x ∂(μHE[n].restrict R.carrier),
      J x * ((R'.mult (φ x) : ℝ) * R'.orient (φ x) (w (φ x))) =
        (R.mult x : ℝ) * R.orient x (β x) := by
    filter_upwards [hgood] with x hx
    obtain ⟨hmult, horient⟩ := hR' x
    have hηx : η x (w (φ x)) = (J x)⁻¹ * R.orient x (β x) := rfl
    rw [hmult, horient, hηx, mul_left_comm, mul_inv_cancel_left₀ hx.1.ne']
  -- Step 6(c)–(d): the area formula on `φ(M)` transfers integrability and the integral
  have harea : ∀ g : Euclid P → ℝ≥0∞, ∫⁻ y, g y ∂(μHE[n].restrict R'.carrier) =
      ∫⁻ x, ENNReal.ofReal (J x) * g (φ x) ∂(μHE[n].restrict R.carrier) := by
    intro g
    rw [hR'c, hJ]
    exact Submission.dpf_area_formula_bilipschitz_rectifiable P n U R.carrier φ Λ hU
      R.measurableSet_carrier R.carrier_subset R.rectifiable hfin hφ hlip hbij.1 g
  exact (Submission.dpfir_integral_eq_of_area_lintegral P (μHE[n].restrict R.carrier)
    (μHE[n].restrict R'.carrier) φ J (fun y => (R'.mult y : ℝ) * R'.orient y (w y))
    (fun x => (R.mult x : ℝ) * R.orient x (β x)) (fun x => by rw [hJ]; exact Real.sqrt_nonneg _)
    harea (Submission.dpfir_imrep_pairing_continuous_integrable P n U R' w hwcont hwc
      hwU).aestronglyMeasurable
    (Submission.dpfir_imrep_pairing_continuous_integrable P n U R β hβc hβcs hβU) hJh).2
/-- **The approximate tangent projection of an integer multiplicity triple is measurable**
(Simon Ch. 3, 1.4 and 1.5(1); Ch. 6, 3.1).  For `R = (M, θ, ξ)`, `x ↦ p_{TₓM}` is
`Hⁿ⌞M`-a.e. strongly measurable.  By uniqueness of approximate tangent planes, `TₓM` is a.e. the
plane oriented by `ξ(x)`.  A unit simple `n`-vector `ζ = ±τ₁ ∧ ⋯ ∧ τₙ` determines its plane: if
also `ζ = ±τ'₁ ∧ ⋯ ∧ τ'ₙ` and `y ⊥ span τ'`, the `n`-covector `α(u) = det(⟨cₖ, uⱼ⟩)`, where `c` is
`τ` with `τᵢ` replaced by `y`, gives `±⟨y, τᵢ⟩ = ±α(τ) = ζ(α) = ±α(τ') = 0`, so `τᵢ ∈ span τ'`.
Hence `p_{TₓM} = G(ξ(x))` a.e., where `G(ζ)` is the projection onto the plane of `ζ` (`0` if there
is none).  `G` is Borel: `Φ(τ, s) = s τ₁ ∧ ⋯ ∧ τₙ` is continuous on the compact set `Ω` of
orthonormal frames and signs, and `G(Φ(τ, s)) = Σₖ ⟨τₖ, ·⟩ τₖ` is continuous, so for closed `t`,
`G⁻¹(t) = Φ(Ω ∩ (G ∘ Φ)⁻¹(t)) ∪ (Φ(Ω)ᶜ ∩ {0 ∈ t})` is Borel. -/
theorem Submission.imrep_approxTangent_starProjection_aesm : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), AEStronglyMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) (μHE[n].restrict R.carrier) := by
  intro P n U R
  classical
  -- `ev τ = (α ↦ α(τ₁, …, τₙ))`, a continuous alternating map of `τ`
  let ev : Euclid P [⋀^Fin n]→L[ℝ] MultiVector P n :=
    (ContinuousLinearMap.id ℝ (Covector (Euclid P) n)).flipAlternating
  have hev : ∀ (τ : Fin n → Euclid P) (α : Covector (Euclid P) n), ev τ α = α τ :=
    fun τ α => rfl
  -- `Φ(τ, s) = s τ₁ ∧ ⋯ ∧ τₙ` on the compact set `Ω` of orthonormal frames and signs `s = ±1`
  let Φ : (Fin n → Euclid P) × ℝ → MultiVector P n := fun ω => ω.2 • ev ω.1
  have hΦc : Continuous Φ := continuous_snd.smul (ev.coe_continuous.comp continuous_fst)
  let Ω : Set ((Fin n → Euclid P) × ℝ) := {τ | Orthonormal ℝ τ} ×ˢ {1, -1}
  have hΩ : IsCompact Ω := by
    refine IsCompact.prod (isCompact_of_isClosed_isBounded ?_ ?_) (Set.toFinite _).isCompact
    · have hset : {τ : Fin n → Euclid P | Orthonormal ℝ τ} =
          ⋂ i, ⋂ j, {τ | inner ℝ (τ i) (τ j) = if i = j then (1 : ℝ) else 0} := by
        ext τ
        simp [orthonormal_iff_ite]
      rw [hset]
      exact isClosed_iInter fun i => isClosed_iInter fun j =>
        isClosed_eq ((continuous_apply i).inner (continuous_apply j)) continuous_const
    · refine (isBounded_iff_subset_closedBall 0).mpr ⟨1, fun τ hτ => ?_⟩
      rw [mem_closedBall_zero_iff]
      exact (pi_norm_le_iff_of_nonneg zero_le_one).mpr fun i => (hτ.1 i).le
  -- `ζ` orients `Q` iff `ζ = Φ(τ, s)` for a point `(τ, s)` of `Ω` with `span τ = Q`
  have horient : ∀ (ζ : MultiVector P n) (Q : Submodule ℝ (Euclid P)),
      IsUnitOrientationOf ζ Q ↔ ∃ ω ∈ Ω, Φ ω = ζ ∧ Submodule.span ℝ (range ω.1) = Q := by
    intro ζ Q
    constructor
    · rintro ⟨τ, hτ, hQ, h | h⟩
      · refine ⟨(τ, 1), ⟨hτ, Or.inl rfl⟩, ?_, hQ⟩
        ext α
        simp [Φ, hev, h]
      · refine ⟨(τ, -1), ⟨hτ, Or.inr rfl⟩, ?_, hQ⟩
        ext α
        simp [Φ, hev, h]
    · rintro ⟨⟨τ, s⟩, ⟨hτ, hs⟩, rfl, hQ⟩
      refine ⟨τ, hτ, hQ, ?_⟩
      rcases hs with rfl | rfl
      · left
        intro α
        simp [Φ, hev]
      · right
        intro α
        simp [Φ, hev]
  -- the `n`-covector `u ↦ det(⟨cₖ, uⱼ⟩)ₖⱼ`
  have hdet : ∀ c : Fin n → Euclid P, ∃ α : Covector (Euclid P) n,
      ∀ u : Fin n → Euclid P, α u = (Matrix.of fun k j => inner ℝ (c k) (u j)).det := by
    intro c
    let L : Euclid P →ₗ[ℝ] (Fin n → ℝ) := LinearMap.pi fun k => (innerSL ℝ (c k)).toLinearMap
    let A : Euclid P [⋀^Fin n]→ₗ[ℝ] ℝ := Matrix.detRowAlternating.compLinearMap L
    have hA : ∀ u : Fin n → Euclid P, A u = (Matrix.of fun k j => inner ℝ (c k) (u j)).det := by
      intro u
      rw [← Matrix.det_transpose]
      rfl
    have hAc : Continuous fun u : Fin n → Euclid P => A u := by
      simp only [hA]
      exact Continuous.matrix_det (continuous_matrix fun k j => by
        simp only [Matrix.of_apply]
        exact continuous_const.inner (continuous_apply j))
    exact ⟨{ A with cont := hAc }, hA⟩
  -- a unit simple `n`-vector determines its plane: if `ζ` orients `span τ` and `span τ'`, then
  -- each `τᵢ` is orthogonal to `(span τ')ᗮ`
  have hle : ∀ (ζ : MultiVector P n) (Q Q' : Submodule ℝ (Euclid P)),
      IsUnitOrientationOf ζ Q → IsUnitOrientationOf ζ Q' → Q ≤ Q' := by
    rintro ζ Q Q' ⟨τ, hτ, rfl, hζ⟩ ⟨τ', hτ', rfl, hζ'⟩
    rw [Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    rw [SetLike.mem_coe, ← Submodule.orthogonal_orthogonal (Submodule.span ℝ (range τ')),
      Submodule.mem_orthogonal]
    intro y hy
    obtain ⟨α, hα⟩ := hdet (Function.update τ i y)
    -- `α(τ)` is the determinant of the identity matrix with row `i` replaced by `(⟨y, τⱼ⟩)ⱼ`
    have h1 : α τ = inner ℝ y (τ i) := by
      rw [hα]
      have hM : (Matrix.of fun k j => inner ℝ (Function.update τ i y k) (τ j)) =
          (1 : Matrix (Fin n) (Fin n) ℝ).updateRow i (fun j => inner ℝ y (τ j)) := by
        ext k j
        by_cases hk : k = i
        · subst hk
          simp
        · simp [hk, Matrix.one_apply, orthonormal_iff_ite.mp hτ k j]
      rw [hM, ← Matrix.det_transpose, ← Matrix.updateCol_transpose, Matrix.transpose_one,
        ← Matrix.cramer_apply, Matrix.cramer_one]
      rfl
    -- row `i` of the matrix of `α(τ')` is `(⟨y, τ'ⱼ⟩)ⱼ = 0`
    have h2 : α τ' = 0 := by
      rw [hα]
      refine Matrix.det_eq_zero_of_row_eq_zero i fun j => ?_
      simp only [Matrix.of_apply, Function.update_self]
      rw [real_inner_comm]
      exact hy _ (Submodule.subset_span ⟨j, rfl⟩)
    have h3 : ζ α = 0 := by
      rcases hζ' with h | h <;> simp [h, h2]
    rcases hζ with h | h
    · rw [← h1, ← h, h3]
    · have h4 := h α
      rw [h3] at h4
      rw [← h1]
      linarith
  have huniq : ∀ (ζ : MultiVector P n) (Q Q' : Submodule ℝ (Euclid P)),
      IsUnitOrientationOf ζ Q → IsUnitOrientationOf ζ Q' → Q = Q' :=
    fun ζ Q Q' h h' => le_antisymm (hle ζ Q Q' h h') (hle ζ Q' Q h' h)
  -- the projection onto the span of an orthonormal frame `τ` is `Σₖ ⟨τₖ, ·⟩ τₖ`, continuous in `τ`
  let F : (Fin n → Euclid P) × ℝ → (Euclid P →L[ℝ] Euclid P) :=
    fun ω => ∑ k, (innerSL ℝ (ω.1 k)).smulRight (ω.1 k)
  have hFapply : ∀ ω v, F ω v = ∑ k, inner ℝ (ω.1 k) v • ω.1 k := by
    intro ω v
    simp [F]
  have hFc : Continuous F := by
    refine continuous_clm_apply.mpr fun v => ?_
    simp only [hFapply]
    exact continuous_finsetSum _ fun k _ => by fun_prop
  have hFproj : ∀ ω ∈ Ω, (Submodule.span ℝ (range ω.1)).starProjection = F ω := by
    rintro ⟨τ, s⟩ ⟨hτ, -⟩
    refine ContinuousLinearMap.ext fun v => ?_
    refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero ?_ ?_
    · rw [hFapply]
      exact Submodule.sum_mem _ fun k _ =>
        Submodule.smul_mem _ _ (Submodule.subset_span ⟨k, rfl⟩)
    · intro w hw
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hw
      · rintro _ ⟨j, rfl⟩
        rw [hFapply, inner_sub_left, sum_inner]
        simp [inner_smul_left, orthonormal_iff_ite.mp hτ, real_inner_comm]
      · simp
      · intro x y _ _ hx hy
        rw [inner_add_right, hx, hy, add_zero]
      · intro a x _ hx
        rw [inner_smul_right, hx, mul_zero]
  -- `G ζ` is the projection onto the plane oriented by `ζ` (`0` if there is none)
  let G : MultiVector P n → (Euclid P →L[ℝ] Euclid P) := fun ζ =>
    if h : ∃ Q, IsUnitOrientationOf ζ Q then h.choose.starProjection else 0
  have hGQ : ∀ (ζ : MultiVector P n) (Q : Submodule ℝ (Euclid P)),
      IsUnitOrientationOf ζ Q → G ζ = Q.starProjection := by
    intro ζ Q hQ
    have hex : ∃ Q, IsUnitOrientationOf ζ Q := ⟨Q, hQ⟩
    simp only [G, dite_eq_left hex]
    rw [huniq _ _ _ hex.choose_spec hQ]
  have hGΦ : ∀ ω ∈ Ω, G (Φ ω) = F ω := fun ω hω => by
    rw [hGQ _ _ ((horient _ _).mpr ⟨ω, hω, rfl, rfl⟩), hFproj ω hω]
  -- `G` is Borel: for closed `t`, `G⁻¹(t)` is a compact set `Φ(Ω ∩ F⁻¹(t))` together with the
  -- complement of the compact set `Φ(Ω)` (if `0 ∈ t`)
  have hG : Measurable G := by
    refine measurable_of_isClosed fun t ht => ?_
    have hset : G ⁻¹' t = Φ '' (Ω ∩ F ⁻¹' t) ∪
        ((Φ '' Ω)ᶜ ∩ {_ζ | (0 : Euclid P →L[ℝ] Euclid P) ∈ t}) := by
      ext ζ
      simp only [Set.mem_preimage, Set.mem_union, Set.mem_image, Set.mem_inter_iff,
        Set.mem_compl_iff]
      by_cases h : ∃ Q, IsUnitOrientationOf ζ Q
      · obtain ⟨Q, hQ⟩ := h
        obtain ⟨ω, hω, hΦω, -⟩ := (horient ζ Q).mp hQ
        have hGζ : G ζ = F ω := by
          rw [← hΦω]
          exact hGΦ ω hω
        constructor
        · intro hζt
          exact Or.inl ⟨ω, ⟨hω, by rwa [← hGζ]⟩, hΦω⟩
        · rintro (⟨ω', ⟨hω', hω't⟩, hΦω'⟩ | ⟨hn, -⟩)
          · rw [← hΦω', hGΦ ω' hω']
            exact hω't
          · exact absurd ⟨ω, hω, hΦω⟩ hn
      · have hGζ : G ζ = 0 := dite_eq_right h
        have hn : ¬∃ ω, ω ∈ Ω ∧ Φ ω = ζ := fun ⟨ω, hω, hΦω⟩ =>
          h ⟨_, (horient ζ _).mpr ⟨ω, hω, hΦω, rfl⟩⟩
        rw [hGζ]
        constructor
        · intro h0
          exact Or.inr ⟨hn, h0⟩
        · rintro (⟨ω', ⟨hω', -⟩, hΦω'⟩ | ⟨-, h0⟩)
          · exact absurd ⟨ω', hω', hΦω'⟩ hn
          · exact h0
    rw [hset]
    exact ((hΩ.inter_right (ht.preimage hFc)).image hΦc).isClosed.measurableSet.union
      ((hΩ.image hΦc).isClosed.measurableSet.compl.inter (MeasurableSet.const _))
  -- a.e. `TₓM` is the plane oriented by `ξ(x)` (uniqueness of approximate tangent planes), so
  -- `p_{TₓM} = G(ξ(x))`
  have hae : (fun x => (approxTangentPlane n R.carrier x).starProjection)
      =ᵐ[μHE[n].restrict R.carrier] G ∘ R.orient := by
    filter_upwards [R.orients] with x ⟨Q, hQ, hor⟩
    have hex : ∃ Q, HasApproximateTangentSpaceAt n R.carrier x Q := ⟨Q, hQ⟩
    have h1 : approxTangentPlane n R.carrier x = Q := by
      rw [approxTangentPlane, dite_eq_left hex]
      exact hex.choose_spec.unique hQ
    rw [Function.comp_apply, hGQ _ _ hor, h1]
  -- `G ∘ ξ` is a.e. measurable, with values in the finite-dimensional space `End(ℝᴾ)`
  have : TopologicalSpace.PseudoMetrizableSpace (MultiVector P n) :=
    @PseudoEMetricSpace.pseudoMetrizableSpace _
      (inferInstance : PseudoEMetricSpace (MultiVector P n))
  exact ((hG.comp_aemeasurable R.aestronglyMeasurable_orient.aemeasurable).aestronglyMeasurable
    ).congr hae.symm
/-- **Simon 6.1.15, 6.3.4–3.5** (Euclidean coefficient norm versus Gram determinants):
(1) `|α(v₁, …, vₙ)| ≤ |α|_E · det(⟨vᵢ, vⱼ⟩)^{1/2}` for every `n`-covector `α` on `ℝᴾ`;
(2) every orthonormal `τ₁, …, τₙ` admits an `n`-covector `α` with `|α|_E ≤ 1` and `α(τ) = 1`.
Expand `α(v) = Σ_I α(e_I) det V_I` over strictly increasing `I` (multilinearity, alternation,
Leibniz).  For the determinant covector `u ↦ det(⟨uₐ, v_b⟩)` this is Cauchy–Binet,
`det(⟨vᵢ, vⱼ⟩) = Σ_I (det V_I)²`; then (1) is Cauchy–Schwarz over the `I`, and (2) holds for the
determinant covector of `τ`. -/
theorem Submission.covectorEuclideanNorm_gram_bounds : ∀ (P n : ℕ), (∀ (α : Covector (Euclid P) n) (v : Fin n → Euclid P), |α v| ≤ covectorEuclideanNorm α * Real.sqrt (Matrix.det (Matrix.of fun i j => inner ℝ (v i) (v j)))) ∧ ∀ τ : Fin n → Euclid P, Orthonormal ℝ τ → ∃ α : Covector (Euclid P) n, covectorEuclideanNorm α ≤ 1 ∧ α τ = 1 := by
  intro P n
  classical
  set e := EuclideanSpace.basisFun (Fin P) ℝ with he
  -- `α(v) = Σ_I α(e_I) det V_I` over strictly increasing `I`, with `(V_I)ₐⱼ = ⟨e_{I a}, vⱼ⟩`
  have hexp : ∀ (α : Covector (Euclid P) n) (v : Fin n → Euclid P),
      α v = ∑ I : Fin n → Fin P, if StrictMono I then
        α (fun i => e (I i)) * Matrix.det (Matrix.of fun a j => inner ℝ (e (I a)) (v j)) else 0 := by
    intro α v
    set c : Fin n → Fin P → ℝ := fun j k => inner ℝ (e k) (v j) with hc
    have hv : v = fun j => ∑ k, c j k • e k := funext fun j => (e.sum_repr' (v j)).symm
    -- multilinearity: `α(v) = Σ_f (∏ⱼ vⱼ(f j)) α(e_f)`
    have h2 : α v = ∑ f : Fin n → Fin P, (∏ j, c j (f j)) * α (fun j => e (f j)) := by
      conv_lhs => rw [hv]
      rw [α.map_sum]
      refine Finset.sum_congr rfl fun f _ => ?_
      rw [← smul_eq_mul, ← α.map_smul_univ]
    -- alternation: non-injective `f` contribute `0`
    have h3 : ∀ f : Fin n → Fin P, ¬ Injective f → α (fun j => e (f j)) = 0 := fun f hf =>
      α.map_eq_zero_of_not_injective _ (fun h => hf (Injective.of_comp (f := ⇑e) h))
    rw [h2, ← Finset.sum_filter_of_ne (p := Injective) (fun f _ hne => by
      by_contra hf
      exact hne (by rw [h3 f hf, mul_zero]))]
    rw [← Finset.sum_filter]
    simp only [Matrix.det_apply, Matrix.of_apply, Finset.mul_sum]
    rw [← Finset.sum_product']
    symm
    -- `(I, σ) ↦ I ∘ σ` is a bijection onto the injective `f`; `α(e_{I ∘ σ}) = sgn σ · α(e_I)`
    refine Finset.sum_bij (fun p _ => fun j => p.1 (p.2 j)) ?_ ?_ ?_ ?_
    · intro p hp
      simp only [Finset.mem_product, Finset.mem_filter, Finset.mem_univ, true_and] at hp ⊢
      exact hp.1.injective.comp p.2.injective
    · intro p hp q hq hpq
      simp only [Finset.mem_product, Finset.mem_filter, Finset.mem_univ, true_and, and_true] at hp hq
      have hrange : Set.range p.1 = Set.range q.1 := by
        have h1 : Set.range (fun j => p.1 (p.2 j)) = Set.range p.1 := (EquivLike.range_comp p.1 p.2)
        have h2 : Set.range (fun j => q.1 (q.2 j)) = Set.range q.1 := (EquivLike.range_comp q.1 q.2)
        rw [← h1, ← h2, hpq]
      have hI : p.1 = q.1 := (StrictMono.range_inj_of_wellFoundedLT hp hq).mp hrange
      have hσ : p.2 = q.2 := by
        ext j
        have := congr_fun hpq j
        rw [hI] at this
        exact congrArg Fin.val (hq.injective this)
      exact Prod.ext hI hσ
    · intro f hf
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hf
      refine ⟨(f ∘ Tuple.sort f, (Tuple.sort f)⁻¹), ?_, ?_⟩
      · simp only [Finset.mem_product, Finset.mem_filter, Finset.mem_univ, true_and, and_true]
        exact (Tuple.monotone_sort f).strictMono_of_injective (hf.comp (Tuple.sort f).injective)
      · funext j
        simp
    · intro p hp
      have hperm : α (fun j => e (p.1 (p.2 j))) = Equiv.Perm.sign p.2 • α (fun j => e (p.1 j)) :=
        α.toAlternatingMap.map_perm (fun j => e (p.1 j)) p.2
      rw [hperm]
      simp only [hc, Units.smul_def, zsmul_eq_mul]
      ring
  -- the determinant covector `u ↦ det(⟨uₐ, τ_b⟩)`
  have hdet : ∀ τ : Fin n → Euclid P, ∃ β : Covector (Euclid P) n,
      ∀ u : Fin n → Euclid P, β u = Matrix.det (Matrix.of fun a b => inner ℝ (u a) (τ b)) := by
    intro τ
    let L : Euclid P →ₗ[ℝ] (Fin n → ℝ) :=
      LinearMap.pi fun b => (innerSL ℝ (τ b) : Euclid P →L[ℝ] ℝ).toLinearMap
    let f : Euclid P [⋀^Fin n]→ₗ[ℝ] ℝ := Matrix.detRowAlternating.compLinearMap L
    have hf : ∀ u, f u = Matrix.det (Matrix.of fun a b => inner ℝ (u a) (τ b)) := by
      intro u
      show Matrix.det (Matrix.of fun a b => L (u a) b) = _
      congr 1
      ext a b
      simp [L, real_inner_comm]
    have hcont : Continuous fun u : Fin n → Euclid P =>
        Matrix.det (Matrix.of fun a b => inner ℝ (u a) (τ b)) := by
      apply Continuous.matrix_det
      apply continuous_matrix
      intro a b
      exact Continuous.inner (f := fun u : Fin n → Euclid P => u a) (g := fun _ => τ b)
        (continuous_apply a) continuous_const
    refine ⟨{ f with cont := ?_ }, fun u => hf u⟩
    have : (f : (Fin n → Euclid P) → ℝ) =
        fun u => Matrix.det (Matrix.of fun a b => inner ℝ (u a) (τ b)) := funext hf
    simpa [this] using hcont
  -- Cauchy–Binet: `det(⟨vᵢ, vⱼ⟩) = Σ_I (det V_I)²`, the expansion of the determinant covector of `v`
  have hcb : ∀ v : Fin n → Euclid P, Matrix.det (Matrix.of fun i j => inner ℝ (v i) (v j)) =
      ∑ I : Fin n → Fin P, if StrictMono I then
        Matrix.det (Matrix.of fun a j => inner ℝ (e (I a)) (v j)) ^ 2 else 0 := by
    intro v
    obtain ⟨β, hβ⟩ := hdet v
    rw [← hβ v, hexp β v]
    refine Finset.sum_congr rfl fun I _ => ?_
    split_ifs
    · rw [hβ, pow_two]
    · rfl
  refine ⟨fun α v => ?_, fun τ hτ => ?_⟩
  · -- (1): Cauchy–Schwarz for `Σ_I α(e_I) det V_I`
    set a : (Fin n → Fin P) → ℝ := fun I => if StrictMono I then α (fun i => e (I i)) else 0
      with ha
    set d : (Fin n → Fin P) → ℝ := fun I => if StrictMono I then
      Matrix.det (Matrix.of fun a j => inner ℝ (e (I a)) (v j)) else 0 with hd
    have hv : α v = ∑ I, a I * d I := by
      rw [hexp α v]
      refine Finset.sum_congr rfl fun I _ => ?_
      simp only [ha, hd]
      split_ifs <;> simp
    have hnorm : covectorEuclideanNorm α = Real.sqrt (∑ I, a I ^ 2) := by
      unfold covectorEuclideanNorm
      rw [← he]
      congr 1
      refine Finset.sum_congr rfl fun I _ => ?_
      simp only [ha]
      split_ifs <;> simp
    have hgram : Matrix.det (Matrix.of fun i j => inner ℝ (v i) (v j)) = ∑ I, d I ^ 2 := by
      rw [hcb v]
      refine Finset.sum_congr rfl fun I _ => ?_
      simp only [hd]
      split_ifs <;> simp
    rw [hv, hnorm, hgram, abs_le]
    constructor
    · have := Real.sum_mul_le_sqrt_mul_sqrt Finset.univ (fun I => -a I) d
      simp only [neg_sq, neg_mul, Finset.sum_neg_distrib] at this
      linarith
    · exact Real.sum_mul_le_sqrt_mul_sqrt Finset.univ a d
  · -- (2): the determinant covector `β` of `τ` has `β(τ) = det 1 = 1` and
    -- `|β|_E² = Σ_I β(e_I)² = det(⟨τᵢ, τⱼ⟩) = 1`
    obtain ⟨β, hβ⟩ := hdet τ
    have hone : (Matrix.of fun a b => inner ℝ (τ a) (τ b) : Matrix (Fin n) (Fin n) ℝ) = 1 := by
      ext a b
      rw [Matrix.of_apply, Matrix.one_apply]
      exact (orthonormal_iff_ite.mp hτ) a b
    have hβτ : β τ = 1 := by rw [hβ, hone, Matrix.det_one]
    refine ⟨β, ?_, hβτ⟩
    have hsum : (∑ I : Fin n → Fin P, if StrictMono I then (β (fun i => e (I i))) ^ 2 else 0) = 1 := by
      have := hcb τ
      rw [hone, Matrix.det_one] at this
      rw [this]
      refine Finset.sum_congr rfl fun I _ => ?_
      split_ifs
      · rw [hβ]
      · rfl
    unfold covectorEuclideanNorm
    rw [← he, hsum, Real.sqrt_one]
/-- **Simon Ch. 6, 2.27–2.29 and 3.9** (analytic toolkit, and the Lipschitz push-forward of
integer multiplicity currents vanishing off a compact set).  (i) If `X = τ(M, θ, ξ)` in `ℝᴾ`
vanishes off the compact `E`, then `μ_R(ℝᴾ ∖ E) = M_{ℝᴾ∖E}(X) = 0`, so `Hᵏ(M ∖ E) = 0` (`θ ≥ 1`
on `M`), `M(X) = μ_R(ℝᴾ) = μ_R(E) < ∞`, and `R.action γ` depends only on `γ|_E`.  (ii) Hadamard:
`|α(v)| ≤ |α| ∏ᵢ |vᵢ|`, from `|α(v)| ≤ |α| det(⟨vᵢ, vⱼ⟩)^{1/2}` and a Gram–Schmidt frame with
`det(⟨vᵢ, vⱼ⟩) = (det A)²`, `|det A| ≤ ∏ᵢ |vᵢ|`.  (iii) `ξ = ±τ₁ ∧ ⋯ ∧ τₖ` a.e. with `τ`
orthonormal, so `|θ ξ(γ)| ≤ c θ` and `|R.action γ| ≤ c μ_R(ℝᴾ)`.  (iv) `F_j = ψ_j ⋆ F` with
normalized `C^∞` bumps `ψ_j` supported in `B_{1/(j+1)}(0)` are `Λ`-Lipschitz and
`|F_j - F| ≤ Λ/(j+1)`.  (v) A smooth Urysohn function for `cthickening 1 E ⊆ thickening 2 E`.
(vi) Given (IPF), `push k F X = Y_X(F)` for `Y_X` from (IPF) for a chosen finite-mass
representation of `X`: it is integer multiplicity, depends only on `F|_E`, is the limit of
`X(η_j) = R.action(F_j^#ω)`, has `M ≤ Λᵏ M(X)` (Hadamard with `‖DF_j‖ ≤ Λ`, then (iii)), and
vanishes off `F(E)` (for large `j`, `F_j(E)` avoids `spt ω`). -/
theorem Submission.dor_lmb_fcdp_toolkit_push : ((∀ (P k : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) k) (R : IMRep (univ : Set (Euclid P)) k) (E : Set (Euclid P)), R.Represents X → IsCompact E → (∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) E → X ω = 0) → μHE[k] (R.carrier \ E) = 0 ∧ X.mass = R.measure univ ∧ R.measure univ ≠ ∞ ∧ ∀ γ γ' : DifferentialForm (Euclid P) k, EqOn γ γ' E → R.action γ = R.action γ') ∧ (∀ (N m : ℕ) (α : Covector (Euclid N) m) (v : Fin m → Euclid N), |α v| ≤ covectorEuclideanNorm α * ∏ i, ‖v i‖) ∧ (∀ (P k : ℕ) (U : Set (Euclid P)) (R : IMRep U k) (γ : DifferentialForm (Euclid P) k) (c : ℝ), R.measure univ ≠ ∞ → 0 ≤ c → (∀ᵐ x ∂(μHE[k].restrict R.carrier), ∀ τ : Fin k → Euclid P, Orthonormal ℝ τ → |γ x τ| ≤ c) → |R.action γ| ≤ c * (R.measure univ).toReal) ∧ (∀ (N N' : ℕ) (Λ : NNReal) (F : Euclid N → Euclid N'), LipschitzWith Λ F → ∃ Fs : ℕ → Euclid N → Euclid N', (∀ j, ContDiff ℝ (⊤ : ℕ∞) (Fs j)) ∧ (∀ j, LipschitzWith Λ (Fs j)) ∧ TendstoUniformly Fs F atTop) ∧ ∀ (P : ℕ) (E : Set (Euclid P)), IsCompact E → ∃ (χ : Euclid P → ℝ) (W : Set (Euclid P)), ContDiff ℝ (⊤ : ℕ∞) χ ∧ HasCompactSupport χ ∧ (∀ x, 0 ≤ χ x ∧ χ x ≤ 1) ∧ IsOpen W ∧ E ⊆ W ∧ ∀ x ∈ W, χ x = 1) ∧ ((∀ (N N' k : ℕ) (R : IMRep (univ : Set (Euclid N)) k), R.measure univ ≠ ∞ → ∃ Y : (Euclid N → Euclid N') → GeometricCurrentOn (univ : Set (Euclid N')) k, (∀ (F : Euclid N → Euclid N') (Λ : NNReal), LipschitzWith Λ F → IsIntegerMultiplicity (Y F) ∧ ∀ Fs : ℕ → Euclid N → Euclid N', (∀ j, ContDiff ℝ 1 (Fs j)) → (∀ j, LipschitzWith Λ (Fs j)) → TendstoUniformly Fs F atTop → ∀ ω : TestFormOn (univ : Set (Euclid N')) k, Tendsto (fun j => R.action (fun x => ((ω : DifferentialForm (Euclid N') k) (Fs j x)).compContinuousLinearMap (fderiv ℝ (Fs j) x))) atTop (𝓝 (Y F ω))) ∧ ∀ (F F' : Euclid N → Euclid N') (Λ : NNReal), LipschitzWith Λ F → LipschitzWith Λ F' → (∀ᵐ x ∂(μHE[k].restrict R.carrier), F x = F' x) → Y F = Y F') → ∀ P : ℕ, ∃ push : ∀ k : ℕ, (Euclid P → Euclid P) → GeometricCurrentOn (univ : Set (Euclid P)) k → GeometricCurrentOn (univ : Set (Euclid P)) k, ∀ (k : ℕ) (Λ : NNReal) (F : Euclid P → Euclid P) (E : Set (Euclid P)) (X : GeometricCurrentOn (univ : Set (Euclid P)) k), LipschitzWith Λ F → IsCompact E → IsIntegerMultiplicity X → (∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) E → X ω = 0) → IsIntegerMultiplicity (push k F X) ∧ (∀ F' : Euclid P → Euclid P, LipschitzWith Λ F' → EqOn F F' E → push k F X = push k F' X) ∧ (∀ (Fs : ℕ → Euclid P → Euclid P) (ω : TestFormOn (univ : Set (Euclid P)) k) (ηs : ℕ → TestFormOn (univ : Set (Euclid P)) k), (∀ j, ContDiff ℝ 1 (Fs j)) → (∀ j, LipschitzWith Λ (Fs j)) → TendstoUniformly Fs F atTop → (∀ j, ∀ x ∈ E, (ηs j : DifferentialForm (Euclid P) k) x = ((ω : DifferentialForm (Euclid P) k) (Fs j x)).compContinuousLinearMap (fderiv ℝ (Fs j) x)) → Tendsto (fun j => X (ηs j)) atTop (𝓝 (push k F X ω))) ∧ (push k F X).mass ≤ (Λ : ℝ≥0∞) ^ k * X.mass ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) (F '' E) → push k F X ω = 0) := by
  -- (i) compactly vanishing integer multiplicity representations
  have hi : ∀ (P k : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) k) (R : IMRep (univ : Set (Euclid P)) k) (E : Set (Euclid P)), R.Represents X → IsCompact E → (∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) E → X ω = 0) → μHE[k] (R.carrier \ E) = 0 ∧ X.mass = R.measure univ ∧ R.measure univ ≠ ∞ ∧ ∀ γ γ' : DifferentialForm (Euclid P) k, EqOn γ γ' E → R.action γ = R.action γ' := by
    intro P k X R E hR hE hXE
    have hmass :=
      (Submission.dor_imrep_massOn_eq_measure_and_support P k univ X R isOpen_univ hR).1
    have hEm : MeasurableSet E := hE.isClosed.measurableSet
    have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) := measurable_from_nat.comp R.measurable_mult
    -- `μ_R(ℝᴾ ∖ E) = M_{ℝᴾ∖E}(X) = 0`: admissible forms supported off `E` are killed by `X`
    have hμEc : R.measure Eᶜ = 0 := by
      rw [← hmass Eᶜ hE.isClosed.isOpen_compl]
      refine le_antisymm (sSup_le ?_) bot_le
      rintro _ ⟨ω, ⟨hωE, -⟩, rfl⟩
      dsimp only
      rw [hXE ω (subset_compl_iff_disjoint_right.mp hωE), ENNReal.ofReal_zero]
    -- `Hᵏ(M ∖ E) = 0`, since `θ ≥ 1` on `M`
    have hnull : μHE[k] (R.carrier \ E) = 0 := by
      rw [IMRep.measure, withDensity_apply_eq_zero' hθ.aemeasurable,
        Measure.restrict_apply' R.measurableSet_carrier] at hμEc
      refine measure_mono_null ?_ hμEc
      intro x hx
      exact ⟨⟨Nat.cast_ne_zero.mpr (R.mult_pos x hx.1).ne', hx.2⟩, hx.1⟩
    -- `Hᵏ⌞M`-a.e. point lies in `E`
    have hae : ∀ᵐ x ∂(μHE[k].restrict R.carrier), x ∈ E := by
      rw [ae_iff, Measure.restrict_apply' R.measurableSet_carrier]
      refine measure_mono_null ?_ hnull
      intro x hx
      exact ⟨hx.2, hx.1⟩
    -- `μ_R(ℝᴾ) = μ_R(E) = ∫_{M ∩ E} θ dHᵏ < ∞`
    have hfin : R.measure univ ≠ ∞ := by
      rw [← measure_add_measure_compl hEm, hμEc, add_zero, IMRep.measure, withDensity_apply _ hEm,
        Measure.restrict_restrict hEm, inter_comm]
      exact R.locallyIntegrable_mult E hE (subset_univ E)
    refine ⟨hnull, hmass univ isOpen_univ, hfin, fun γ γ' hγ => ?_⟩
    -- the integrands agree on `E`, hence `Hᵏ⌞M`-a.e.
    refine integral_congr_ae ?_
    filter_upwards [hae] with x hx
    rw [hγ hx]
  -- (ii) Hadamard's inequality for the Euclidean coefficient norm
  have hii : ∀ (N m : ℕ) (α : Covector (Euclid N) m) (v : Fin m → Euclid N), |α v| ≤ covectorEuclideanNorm α * ∏ i, ‖v i‖ := by
    intro N m α v
    by_cases hv : LinearIndependent ℝ v
    · obtain ⟨σ, -, -, hG, -, hA⟩ := Submission.dpf_exists_orthonormal_frame_det_gram N m v hv
      calc |α v| ≤ covectorEuclideanNorm α *
            Real.sqrt (Matrix.det (Matrix.of fun i j => inner ℝ (v i) (v j))) :=
            (Submission.covectorEuclideanNorm_gram_bounds N m).1 α v
        _ = covectorEuclideanNorm α * |Matrix.det (Matrix.of fun i j => inner ℝ (σ i) (v j))| := by
            rw [hG, Real.sqrt_sq_eq_abs]
        _ ≤ covectorEuclideanNorm α * ∏ i, ‖v i‖ :=
            mul_le_mul_of_nonneg_left hA (covectorEuclideanNorm_nonneg α)
    · -- a linearly dependent family is killed by every alternating map
      rw [show α v = 0 from α.toAlternatingMap.map_linearDependent v hv, abs_zero]
      exact mul_nonneg (covectorEuclideanNorm_nonneg α)
        (Finset.prod_nonneg fun i _ => norm_nonneg _)
  -- (iii) the action is bounded by `c μ_R(ℝᴾ)` when `γ` is bounded by `c` on orthonormal frames
  have hiii : ∀ (P k : ℕ) (U : Set (Euclid P)) (R : IMRep U k) (γ : DifferentialForm (Euclid P) k) (c : ℝ), R.measure univ ≠ ∞ → 0 ≤ c → (∀ᵐ x ∂(μHE[k].restrict R.carrier), ∀ τ : Fin k → Euclid P, Orthonormal ℝ τ → |γ x τ| ≤ c) → |R.action γ| ≤ c * (R.measure univ).toReal := by
    intro P k U R γ c hfin hc hγ
    have hθm : Measurable fun x => (R.mult x : ℝ) := measurable_from_nat.comp R.measurable_mult
    -- `∫⁻ θ d(Hᵏ⌞M) = μ_R(ℝᴾ)`, so `θ` is `Hᵏ⌞M`-integrable with `∫ θ d(Hᵏ⌞M) = μ_R(ℝᴾ)`
    have hlint : ∫⁻ x, ENNReal.ofReal (R.mult x : ℝ) ∂(μHE[k].restrict R.carrier) =
        R.measure univ := by
      rw [IMRep.measure, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
      exact lintegral_congr fun x => ENNReal.ofReal_natCast _
    have hθ0 : 0 ≤ᵐ[μHE[k].restrict R.carrier] fun x => (R.mult x : ℝ) :=
      ae_of_all _ fun x => Nat.cast_nonneg _
    have hθint : Integrable (fun x => (R.mult x : ℝ)) (μHE[k].restrict R.carrier) :=
      ⟨hθm.aestronglyMeasurable, (hasFiniteIntegral_iff_ofReal hθ0).mpr (hlint ▸ hfin.lt_top)⟩
    have hθI : ∫ x, (R.mult x : ℝ) ∂(μHE[k].restrict R.carrier) = (R.measure univ).toReal := by
      rw [integral_eq_lintegral_of_nonneg_ae hθ0 hθm.aestronglyMeasurable, hlint]
    rw [← Real.norm_eq_abs, IMRep.action]
    calc ‖∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (γ x) ∂μHE[k]‖
        ≤ ∫ x, c * (R.mult x : ℝ) ∂(μHE[k].restrict R.carrier) := by
          refine norm_integral_le_of_norm_le (hθint.const_mul c) ?_
          -- a.e. `ξ(x)(β) = ±β(τ)` with `τ` orthonormal, so `|ξ(x)(γ x)| = |γ(x)(τ)| ≤ c`
          filter_upwards [hγ, R.orients] with x hx hor
          obtain ⟨Q, -, τ, hτ, -, hξ⟩ := hor
          rw [norm_mul, Real.norm_natCast, mul_comm c]
          refine mul_le_mul_of_nonneg_left ?_ (Nat.cast_nonneg _)
          rcases hξ with h | h
          · rw [h, Real.norm_eq_abs]
            exact hx τ hτ
          · rw [h, norm_neg, Real.norm_eq_abs]
            exact hx τ hτ
      _ = c * (R.measure univ).toReal := by rw [integral_const_mul, hθI]
  -- (iv) `C^∞` `Λ`-Lipschitz approximations by mollification
  have hiv : ∀ (N N' : ℕ) (Λ : NNReal) (F : Euclid N → Euclid N'), LipschitzWith Λ F → ∃ Fs : ℕ → Euclid N → Euclid N', (∀ j, ContDiff ℝ (⊤ : ℕ∞) (Fs j)) ∧ (∀ j, LipschitzWith Λ (Fs j)) ∧ TendstoUniformly Fs F atTop := by
    intro N N' Λ F hF
    -- normalized `C^∞` bumps `ψ = φ / ∫ φ` supported in `B_r(0)`
    have hker : ∀ r : ℝ, 0 < r → ∃ ψ : Euclid N → ℝ, ContDiff ℝ (⊤ : ℕ∞) ψ ∧
        HasCompactSupport ψ ∧ (∀ y, 0 ≤ ψ y) ∧ ∫ y, ψ y = 1 ∧ support ψ ⊆ ball 0 r := by
      intro r hr
      let φ : ContDiffBump (0 : Euclid N) := ⟨r / 2, r, half_pos hr, half_lt_self hr⟩
      have hφ : 0 < ∫ y, φ y := by
        rw [integral_pos_iff_support_of_nonneg φ.nonneg'
          (φ.continuous.integrable_of_hasCompactSupport φ.hasCompactSupport), φ.support_eq]
        exact measure_ball_pos _ _ hr
      have hsupp : support (fun y => φ y / ∫ y, φ y) ⊆ support φ := fun y hy =>
        (div_ne_zero_iff.1 hy).1
      exact ⟨fun y => φ y / ∫ y, φ y, φ.contDiff.div_const _, φ.hasCompactSupport.mono hsupp,
        fun y => div_nonneg φ.nonneg hφ.le, by rw [integral_div, div_self hφ.ne'],
        hsupp.trans φ.support_eq.subset⟩
    choose ψ hψ hψc hψ0 hψ1 hψs using fun j : ℕ =>
      hker (1 / ((j : ℝ) + 1)) Nat.one_div_pos_of_nat
    have hFi : LocallyIntegrable F volume := hF.continuous.locallyIntegrable
    refine ⟨fun j => convolution (ψ j) F (ContinuousLinearMap.lsmul ℝ ℝ) volume,
      fun j => (hψc j).contDiff_convolution_left _ (hψ j) hFi, fun j => ?_, ?_⟩
    · -- `ψ_j ⋆ F` is `Λ`-Lipschitz: it averages the differences `F(x - t) - F(x' - t)`
      have hconv : ∀ x, Integrable (fun t => ψ j t • F (x - t)) volume := fun x =>
        ((hψc j).convolutionExists_left (ContinuousLinearMap.lsmul ℝ ℝ) (hψ j).continuous hFi
          x).integrable
      refine LipschitzWith.of_dist_le_mul fun x x' => ?_
      dsimp only
      rw [dist_eq_norm, convolution_def, convolution_def]
      simp only [ContinuousLinearMap.lsmul_apply]
      rw [← integral_sub (hconv x) (hconv x')]
      calc ‖∫ t, (ψ j t • F (x - t) - ψ j t • F (x' - t))‖ ≤ ∫ t, ψ j t * (Λ * dist x x') := by
            refine norm_integral_le_of_norm_le
              (((hψ j).continuous.integrable_of_hasCompactSupport (hψc j)).mul_const _)
              (ae_of_all _ fun t => ?_)
            rw [← smul_sub, norm_smul, Real.norm_of_nonneg (hψ0 j t)]
            refine mul_le_mul_of_nonneg_left ?_ (hψ0 j t)
            rw [← dist_eq_norm]
            calc dist (F (x - t)) (F (x' - t)) ≤ Λ * dist (x - t) (x' - t) := hF.dist_le_mul _ _
              _ = Λ * dist x x' := by rw [dist_sub_right]
        _ = Λ * dist x x' := by rw [integral_mul_const, hψ1 j, one_mul]
    · -- `dist((ψ_j ⋆ F)(x), F(x)) ≤ Λ/(j+1)`, as `F` moves by `≤ Λ/(j+1)` on `B_{1/(j+1)}(x)`
      rw [Metric.tendstoUniformly_iff]
      intro ε hε
      have hlim : Tendsto (fun j : ℕ => (Λ : ℝ) * (1 / ((j : ℝ) + 1))) atTop (𝓝 0) := by
        have := (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)).const_mul (Λ : ℝ)
        rwa [mul_zero] at this
      filter_upwards [hlim.eventually (gt_mem_nhds hε)] with j hj x
      rw [dist_comm]
      refine (dist_convolution_le (by positivity) (hψs j) (hψ0 j) (hψ1 j)
        hF.continuous.aestronglyMeasurable fun y hy => ?_).trans_lt hj
      calc dist (F y) (F x) ≤ Λ * dist y x := hF.dist_le_mul y x
        _ ≤ Λ * (1 / ((j : ℝ) + 1)) := mul_le_mul_of_nonneg_left (mem_ball.mp hy).le Λ.coe_nonneg
  -- (v) smooth cut-off functions
  have hv : ∀ (P : ℕ) (E : Set (Euclid P)), IsCompact E → ∃ (χ : Euclid P → ℝ) (W : Set (Euclid P)), ContDiff ℝ (⊤ : ℕ∞) χ ∧ HasCompactSupport χ ∧ (∀ x, 0 ≤ χ x ∧ χ x ≤ 1) ∧ IsOpen W ∧ E ⊆ W ∧ ∀ x ∈ W, χ x = 1 := by
    intro P E hE
    obtain ⟨χ, hχ, hχr, hχs, hχ1⟩ := exists_contDiff_support_eq_eq_one_iff (n := ⊤)
      (isOpen_thickening (δ := 2) (E := E)) (isClosed_cthickening (δ := 1) (E := E))
      (cthickening_subset_thickening' two_pos one_lt_two E)
    refine ⟨χ, thickening 1 E, hχ, ?_, fun x => hχr ⟨x, rfl⟩, isOpen_thickening,
      self_subset_thickening one_pos E,
      fun x hx => (hχ1 x).mp (thickening_subset_cthickening 1 E hx)⟩
    exact HasCompactSupport.of_support_subset_isCompact (hE.cthickening (r := 2))
      (hχs ▸ thickening_subset_cthickening 2 E)
  refine ⟨⟨hi, hii, hiii, hiv, hv⟩, ?_⟩
  -- (vi) the push-forward operator, assuming (IPF)
  intro hIPF P
  -- for `X` with a finite-mass IM representation `R`, choose `Y_X` from (IPF) for `R`
  obtain ⟨Ych, hYch⟩ : ∃ Ych : ∀ k : ℕ, GeometricCurrentOn (univ : Set (Euclid P)) k →
      (Euclid P → Euclid P) → GeometricCurrentOn (univ : Set (Euclid P)) k,
      ∀ (k : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) k),
        (∃ R : IMRep (univ : Set (Euclid P)) k, R.Represents X ∧ R.measure univ ≠ ∞) →
        ∃ (R : IMRep (univ : Set (Euclid P)) k) (hR : R.measure univ ≠ ∞),
          R.Represents X ∧ Ych k X = Classical.choose (hIPF P P k R hR) := by
    classical
    exact ⟨fun k X => if h : ∃ R : IMRep (univ : Set (Euclid P)) k, R.Represents X ∧
      R.measure univ ≠ ∞ then Classical.choose (hIPF P P k h.choose h.choose_spec.2)
      else fun _ => X, fun k X h => ⟨h.choose, h.choose_spec.2, h.choose_spec.1, dite_eq_left h⟩⟩
  refine ⟨fun k F X => Ych k X F, ?_⟩
  rintro k Λ F E X hF hE ⟨R', hR'⟩ hXE
  dsimp only
  -- by (i) every representation of `X` has finite mass
  obtain ⟨R, hRfin, hRX, hY⟩ := hYch k X ⟨R', hR', (hi P k X R' E hR' hE hXE).2.2.1⟩
  obtain ⟨hYa, hYb⟩ := Classical.choose_spec (hIPF P P k R hRfin)
  rw [← hY] at hYa hYb
  obtain ⟨hnull, hmass, -, hloc⟩ := hi P k X R E hRX hE hXE
  have hae : ∀ᵐ x ∂(μHE[k].restrict R.carrier), x ∈ E := by
    rw [ae_iff, Measure.restrict_apply' R.measurableSet_carrier]
    refine measure_mono_null ?_ hnull
    intro x hx
    exact ⟨hx.2, hx.1⟩
  -- `C^∞` `Λ`-Lipschitz `F_j → F` by (iv); `push k F X (ω) = lim R.action(F_j^#ω)`
  obtain ⟨Fs, hFs, hFsL, hFsU⟩ := hiv P P Λ F hF
  have hFs1 : ∀ j, ContDiff ℝ 1 (Fs j) := fun j => (hFs j).of_le (by exact_mod_cast le_top)
  have hlim := (hYa F Λ hF).2 Fs hFs1 hFsL hFsU
  refine ⟨(hYa F Λ hF).1, fun F' hF' hFF' => hYb F F' Λ hF hF' ?_,
    fun Fs' ω ηs hFs' hFsL' hFsU' hη => ?_, ?_, fun ω hω => ?_⟩
  · -- (P2): `F = F'` on `E`, hence `Hᵏ⌞M`-a.e.
    filter_upwards [hae] with x hx using hFF' hx
  · -- (P3): `X(η_j) = R.action(η_j) = R.action(F_j^#ω) → push k F X (ω)`
    refine ((hYa F Λ hF).2 Fs' hFs' hFsL' hFsU' ω).congr fun j => ?_
    rw [hRX (ηs j)]
    exact hloc _ _ fun x hx => (hη j x hx).symm
  · -- (P4): for admissible `ω`, `|R.action(F_j^#ω)| ≤ Λᵏ μ_R(ℝᴾ)` by (ii) and (iii)
    rw [hmass, GeometricCurrentOn.mass, GeometricCurrentOn.massOn]
    refine sSup_le ?_
    rintro _ ⟨ω, ⟨-, hω1⟩, rfl⟩
    dsimp only
    have hbd : ∀ j, |R.action (fun x => ((ω : DifferentialForm (Euclid P) k)
        (Fs j x)).compContinuousLinearMap (fderiv ℝ (Fs j) x))| ≤
        (Λ : ℝ) ^ k * (R.measure univ).toReal := by
      intro j
      refine hiii P k univ R _ _ hRfin (by positivity) (ae_of_all _ fun x τ hτ => ?_)
      rw [ContinuousAlternatingMap.compContinuousLinearMap_apply]
      calc |(ω : DifferentialForm (Euclid P) k) (Fs j x) (fderiv ℝ (Fs j) x ∘ τ)|
          ≤ covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) k) (Fs j x)) *
            ∏ i, ‖(fderiv ℝ (Fs j) x ∘ τ) i‖ := hii P k _ _
        _ ≤ 1 * ∏ _i : Fin k, (Λ : ℝ) := by
          refine mul_le_mul (hω1 _)
            (Finset.prod_le_prod₀ (fun i _ => norm_nonneg _) fun i _ => ?_)
            (Finset.prod_nonneg fun i _ => norm_nonneg _) zero_le_one
          -- `‖DF_j(x) τᵢ‖ ≤ ‖DF_j(x)‖ ≤ Λ`
          calc ‖(fderiv ℝ (Fs j) x ∘ τ) i‖ ≤ ‖fderiv ℝ (Fs j) x‖ * ‖τ i‖ :=
                (fderiv ℝ (Fs j) x).le_opNorm _
            _ ≤ Λ := by
                rw [hτ.1 i, mul_one]
                exact norm_fderiv_le_of_lipschitz ℝ (hFsL j)
        _ = (Λ : ℝ) ^ k := by rw [one_mul, Fin.prod_const]
    have hle : Ych k X F ω ≤ (Λ : ℝ) ^ k * (R.measure univ).toReal :=
      le_of_tendsto' (hlim ω) fun j => (le_abs_self _).trans (hbd j)
    calc ENNReal.ofReal (Ych k X F ω)
        ≤ ENNReal.ofReal ((Λ : ℝ) ^ k * (R.measure univ).toReal) := ENNReal.ofReal_le_ofReal hle
      _ = (Λ : ℝ≥0∞) ^ k * R.measure univ := by
        rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_toReal hRfin,
          ENNReal.ofReal_pow NNReal.zero_le_coe, ENNReal.ofReal_coe_nnreal]
  · -- (P5): for large `j`, `F_j(E)` avoids `spt ω`, so `F_j^#ω = 0` on `E`
    obtain ⟨δ, hδ, hδK⟩ := (hE.image hF.continuous).exists_cthickening_subset_open
      (isClosed_tsupport _).isOpen_compl (subset_compl_iff_disjoint_left.mpr hω)
    have hev : ∀ᶠ j in atTop, R.action (fun x => ((ω : DifferentialForm (Euclid P) k)
        (Fs j x)).compContinuousLinearMap (fderiv ℝ (Fs j) x)) = 0 := by
      filter_upwards [Metric.tendstoUniformly_iff.mp hFsU δ hδ] with j hj
      refine (hloc _ 0 fun x hx => ?_).trans ?_
      · have hmem : Fs j x ∉ tsupport (ω : DifferentialForm (Euclid P) k) :=
          hδK (thickening_subset_cthickening δ _
            (mem_thickening_iff.mpr ⟨F x, mem_image_of_mem F hx, by rw [dist_comm]; exact hj x⟩))
        rw [image_eq_zero_of_notMem_tsupport hmem]
        ext v
        simp
      · simp [IMRep.action]
    exact tendsto_nhds_unique (hlim ω) (tendsto_const_nhds.congr' (hev.mono fun j hj => hj.symm))
/-- Step 4(d) of the local unit representation of `∂[[E]]` (Simon 7.5; Gram–Schmidt as in the
graph chart): if `a₁, …, aₙ` are linearly independent in `ℝᴾ`, the Gram determinant
`Γ = det(⟨aᵢ, aⱼ⟩)` is positive and `ξ = Γ^{-1/2} a₁ ∧ ⋯ ∧ aₙ`, i.e.
`⟨α, ξ⟩ = Γ^{-1/2} α(a₁, …, aₙ)`, is a unit orientation of `span a`.  For an orthonormal frame
`σ` of `span a` and `R = (⟨σᵢ, aⱼ⟩)`, `Γ = (det R)²` and `α(a) = det R · α(σ)`, so
`ξ = sign(det R) σ₁ ∧ ⋯ ∧ σₙ`. -/
theorem Submission.codim1_lur_normalized_wedge_orientation : ∀ (P n : ℕ) (a : Fin n → Euclid P), LinearIndependent ℝ a → 0 < Matrix.det (Matrix.of fun i j : Fin n => inner ℝ (a i) (a j)) ∧ ∀ ξ : MultiVector P n, (∀ α : Covector (Euclid P) n, ξ α = (Real.sqrt (Matrix.det (Matrix.of fun i j : Fin n => inner ℝ (a i) (a j))))⁻¹ * α a) → IsUnitOrientationOf ξ (Submodule.span ℝ (Set.range a)) := by
  intro P n a ha
  -- an orthonormal frame `σ` of `span a` with `Γ = (det R)²`, `R = (⟨σᵢ, aⱼ⟩)` invertible
  obtain ⟨σ, hσ, hspan, hgram, hdet, -⟩ :=
    Submission.dpf_exists_orthonormal_frame_det_gram P n a ha
  set d := Matrix.det (Matrix.of fun i j => inner ℝ (σ i) (a j))
  refine ⟨hgram ▸ sq_pos_of_ne_zero hdet, fun ξ hξ => ⟨σ, hσ, hspan, ?_⟩⟩
  -- `α(a) = det R · α(σ)`, hence `⟨α, ξ⟩ = |det R|⁻¹ det R · α(σ)`
  have hξ' : ∀ α : Covector (Euclid P) n, ξ α = |d|⁻¹ * d * α σ := fun α => by
    rw [hξ, hgram, Real.sqrt_sq_eq_abs, mul_assoc,
      Submission.dgoj_covector_eq_det_mul_of_mem_span P n σ a hσ
        (fun j => hspan ▸ Submodule.subset_span ⟨j, rfl⟩) α]
  rcases hdet.lt_or_gt with hneg | hpos
  · exact Or.inr fun α => by
      rw [hξ', abs_of_neg hneg, inv_neg, neg_mul, inv_mul_cancel₀ hdet, neg_one_mul]
  · exact Or.inl fun α => by
      rw [hξ', abs_of_pos hpos, inv_mul_cancel₀ hdet, one_mul]
/-- A mass-summable series of integer multiplicity densities converges `Hⁿ`-a.e. and integrates
termwise against test forms (the `L¹` convergence of the densities `θ_q ξ_q` in the proof of
Simon Ch. 6, Lemma 3.13).  With `g_r = 1_{M_r} θ_r`, `∫ g_r dHⁿ = μ_{R_r}(M_r) ≤ μ_{R_r}(U)`, so
`Σ_r g_r < ∞` `Hⁿ`-a.e.; as `‖ξ_r‖ ≤ 1` `Hⁿ`-a.e. on `M_r`, the densities `D_r = 1_{M_r} θ_r ξ_r`
satisfy `‖D_r‖ ≤ g_r`, so `η = Σ_r D_r` converges absolutely `Hⁿ`-a.e., and dominated convergence
for series with the bounds `(sup ‖ω‖) g_r` gives `Σ_r τ(M_r, θ_r, ξ_r)(ω) = ∫ ⟨ω, η⟩ dHⁿ`. -/
theorem Submission.dor_lmb_fc_ims_density_series : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : ℕ → IMRep U n), ∑' r, (R r).measure U ≠ ∞ → ∃ η : Euclid P → MultiVector P n, (∀ᵐ x ∂μHE[n], HasSum (fun r => (R r).carrier.indicator (fun y => ((R r).mult y : ℝ) • (R r).orient y) x) (η x)) ∧ ∀ ω : TestFormOn U n, HasSum (fun r => (R r).action (ω : DifferentialForm (Euclid P) n)) (∫ x, η x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) := by
  have hnorm := Submission.unit_orientation_norm_le_one
  intro P n U R hfin
  set D : ℕ → Euclid P → MultiVector P n := fun r x =>
    (R r).carrier.indicator (fun y => ((R r).mult y : ℝ) • (R r).orient y) x
  set g : ℕ → Euclid P → ℝ := fun r x =>
    (R r).carrier.indicator (fun y => ((R r).mult y : ℝ)) x
  have hg_nonneg : ∀ r x, 0 ≤ g r x := fun r x =>
    Set.indicator_nonneg (fun y _ => Nat.cast_nonneg _) x
  have hmult_meas : ∀ r, Measurable (fun y => ((R r).mult y : ℝ)) := fun r =>
    measurable_from_nat.comp (R r).measurable_mult
  have hg_meas : ∀ r, Measurable (g r) := fun r =>
    (hmult_meas r).indicator (R r).measurableSet_carrier
  -- ∫⁻ g_r dHⁿ = μ_{R_r}(M_r) ≤ μ_{R_r}(U)
  have hg_lint : ∀ r, ∫⁻ x, ENNReal.ofReal (g r x) ∂μHE[n] ≤ (R r).measure U := by
    intro r
    have hM := (R r).measurableSet_carrier
    have h1 : (fun x => ENNReal.ofReal (g r x)) =
        (R r).carrier.indicator (fun y => ((R r).mult y : ℝ≥0∞)) := by
      funext x
      by_cases hx : x ∈ (R r).carrier <;> simp [g, hx]
    calc ∫⁻ x, ENNReal.ofReal (g r x) ∂μHE[n]
        = ∫⁻ x in (R r).carrier, ((R r).mult x : ℝ≥0∞) ∂μHE[n] := by
          rw [h1, lintegral_indicator hM]
      _ = (R r).measure (R r).carrier := by
          rw [IMRep.measure, withDensity_apply _ hM, Measure.restrict_restrict hM, inter_self]
      _ ≤ (R r).measure U := measure_mono (R r).carrier_subset
  have hsum_lint : ∫⁻ x, ∑' r, ENNReal.ofReal (g r x) ∂μHE[n] ≠ ∞ := by
    rw [lintegral_tsum (fun r => (hg_meas r).ennreal_ofReal.aemeasurable)]
    exact ne_top_of_le_ne_top hfin (ENNReal.tsum_le_tsum hg_lint)
  have hfinite : ∀ᵐ x ∂μHE[n], ∑' r, ENNReal.ofReal (g r x) < ∞ :=
    ae_lt_top (Measurable.tsum fun r => (hg_meas r).ennreal_ofReal) hsum_lint
  have hg_summ : ∀ᵐ x ∂μHE[n], Summable (fun r => g r x) := by
    filter_upwards [hfinite] with x hx
    have := ENNReal.summable_toReal hx.ne
    simpa [ENNReal.toReal_ofReal (hg_nonneg _ x)] using this
  -- ‖D_r(x)‖ ≤ g_r(x) a.e., from ‖ξ‖ ≤ 1 for unit orientations
  have hD_bound : ∀ r, ∀ᵐ x ∂μHE[n], ‖D r x‖ ≤ g r x := by
    intro r
    have h := (R r).orients
    rw [ae_restrict_iff' (R r).measurableSet_carrier] at h
    filter_upwards [h] with x hx
    by_cases hxM : x ∈ (R r).carrier
    · obtain ⟨Q, -, hQ⟩ := hx hxM
      have h1 := hnorm P n Q _ hQ
      simp only [D, g, Set.indicator_of_mem hxM]
      calc ‖((R r).mult x : ℝ) • (R r).orient x‖
          ≤ ‖((R r).mult x : ℝ)‖ * ‖(R r).orient x‖ := ContinuousLinearMap.opNorm_smul_le _ _
        _ ≤ ‖((R r).mult x : ℝ)‖ * 1 := mul_le_mul_of_nonneg_left h1 (norm_nonneg _)
        _ = ((R r).mult x : ℝ) := by rw [mul_one, Real.norm_natCast]
    · simp only [D, g, Set.indicator_of_notMem hxM]
      exact ContinuousLinearMap.opNorm_zero.le
  have hD_bound' : ∀ᵐ x ∂μHE[n], ∀ r, ‖D r x‖ ≤ g r x := ae_all_iff.2 hD_bound
  have hD_summ : ∀ᵐ x ∂μHE[n], Summable (fun r => D r x) := by
    filter_upwards [hD_bound', hg_summ] with x h1 h2
    exact Summable.of_norm_bounded (E := MultiVector P n) h2 h1
  refine ⟨fun x => ∑' r, D r x, ?_, ?_⟩
  · filter_upwards [hD_summ] with x hx
    exact hx.hasSum
  · intro ω
    set w : DifferentialForm (Euclid P) n := (ω : DifferentialForm (Euclid P) n)
    have hw_cont : Continuous w := ContDiff.continuous ω.property.1.1
    obtain ⟨B, hB⟩ : ∃ B, ∀ x, ‖w x‖ ≤ B :=
      hw_cont.bounded_above_of_compact_support ω.property.1.2
    have hDr_meas : ∀ r, AEStronglyMeasurable (D r) μHE[n] := by
      intro r
      refine (aestronglyMeasurable_indicator_iff (R r).measurableSet_carrier).2 ?_
      exact (hmult_meas r).aestronglyMeasurable.smul (R r).aestronglyMeasurable_orient
    have hF_meas : ∀ r, AEStronglyMeasurable (fun x => D r x (w x)) μHE[n] := fun r =>
      isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable
        ((hDr_meas r).prodMk hw_cont.aestronglyMeasurable)
    have h_bound : ∀ r, ∀ᵐ x ∂μHE[n], ‖D r x (w x)‖ ≤ B * g r x := by
      intro r
      filter_upwards [hD_bound r] with x hx
      calc ‖D r x (w x)‖ ≤ ‖D r x‖ * ‖w x‖ := (D r x).le_opNorm _
        _ ≤ g r x * B := mul_le_mul hx (hB x) (norm_nonneg _) (hg_nonneg r x)
        _ = B * g r x := mul_comm _ _
    have h_summ : ∀ᵐ x ∂μHE[n], Summable (fun r => B * g r x) :=
      hg_summ.mono fun x hx => hx.mul_left B
    have h_int : Integrable (fun x => ∑' r, B * g r x) μHE[n] := by
      have hG : Integrable (fun x => (∑' r, ENNReal.ofReal (g r x)).toReal) μHE[n] :=
        integrable_toReal_of_lintegral_ne_top
          (Measurable.tsum fun r => (hg_meas r).ennreal_ofReal).aemeasurable hsum_lint
      refine (hG.const_mul B).congr ?_
      filter_upwards [hg_summ] with x hx
      rw [tsum_mul_left, ← ENNReal.ofReal_tsum_of_nonneg (fun r => hg_nonneg r x) hx,
        ENNReal.toReal_ofReal (tsum_nonneg fun r => hg_nonneg r x)]
    have hlim : ∀ᵐ x ∂μHE[n], HasSum (fun r => D r x (w x)) ((∑' r, D r x) (w x)) := by
      filter_upwards [hD_summ] with x hx
      exact hx.hasSum.mapL (ContinuousLinearMap.apply ℝ ℝ (w x))
    have hHS := hasSum_integral_of_dominated_convergence (fun r x => B * g r x) hF_meas
      h_bound h_summ h_int hlim
    convert hHS using 1
    funext r
    have hM := (R r).measurableSet_carrier
    have h1 : (fun x => D r x (w x)) =
        (R r).carrier.indicator (fun x => ((R r).mult x : ℝ) * (R r).orient x (w x)) := by
      funext x
      by_cases hx : x ∈ (R r).carrier <;> simp [D, hx]
    rw [h1, integral_indicator hM]
    rfl
/-- **Mass of a difference** (Simon (6.2.5), chapter-06.txt line 231; this subadditivity makes the
flat distances `d_W` of 7.1 (lines 2018–2022) pseudometrics and is used in the proof of 7.2):
`M_G(A − B) ≤ M_G(A) + M_G(B)` for every set `G`.  If `ω` is admissible for `M_G` then so is `−ω`
(same support, same coefficient norm), and `(A − B)(ω) = A(ω) + B(−ω)`, so
`ofReal ((A − B)(ω)) ≤ ofReal (A(ω)) + ofReal (B(−ω)) ≤ M_G(A) + M_G(B)`. -/
theorem Submission.cmc_fc_cs_massOn_sub_le : ∀ (P n : ℕ) (U G : Set (Euclid P)) (A B : GeometricCurrentOn U n), (A - B).massOn G ≤ A.massOn G + B.massOn G := by
  intro P n U G A B
  -- Step 1: it suffices to bound `ofReal ((A − B)(ω))` for each admissible `ω`
  refine sSup_le ?_
  rintro _ ⟨ω, hω, rfl⟩
  -- Step 2: `−ω` is admissible: same support, same coefficient norm
  have hneg : -ω ∈ massAdmissibleOn U n G := by
    refine ⟨?_, fun x => ?_⟩
    · rw [Submodule.coe_neg, tsupport_neg]
      exact hω.1
    · rw [Submodule.coe_neg, Pi.neg_apply, covectorEuclideanNorm_neg]
      exact hω.2 x
  -- Step 3: `(A − B)(ω) = A(ω) − B(ω) = A(ω) + B(−ω)`, by linearity of `B`
  have hsplit : (A - B) ω = A ω + B (-ω) := by
    have hB : B (-ω) = -B ω := B.toCurrent.map_neg ω
    change A ω - B ω = A ω + B (-ω)
    rw [hB, sub_eq_add_neg]
  -- Steps 4–5: `ofReal` is subadditive, and each term is bounded by the corresponding mass
  calc ENNReal.ofReal ((A - B) ω) = ENNReal.ofReal (A ω + B (-ω)) := by rw [hsplit]
    _ ≤ ENNReal.ofReal (A ω) + ENNReal.ofReal (B (-ω)) := ENNReal.ofReal_add_le
    _ ≤ A.massOn G + B.massOn G := add_le_add (A.le_massOn hω) (B.le_massOn hneg)
/-- **Diagonal extraction** (Simon Ch. 6, proof of 7.2, chapter-06.txt lines 2101–2105:
"apply (1) with `ε = 1, 1/2, 1/4` etc. to extract a subsequence `{T_{j_r}}` …
`d(T_{j_{r+1}}, T_{j_r}) < 2^{-r}`", with `2^{-r}`-closeness replaced by an arbitrary relation
`C r`).  If, for each `r`, every infinite `I ⊆ ℕ` contains an infinite `J ⊆ I` all of whose pairs
are `C r`-related, then some strictly increasing `φ` has `C r (φ (r + 1)) (φ r)` for every `r`.
Refining `I₀ = ℕ` gives nested infinite sets `I_{r+1} ⊆ I_r` with `I_{r+1}` pairwise
`C r`-related; an increasing choice `φ(r) ∈ I_{r+1}` puts both `φ(r)` and `φ(r + 1)` in
`I_{r+1}`. -/
theorem Submission.cmc_fc_cs_diagonal_subseq : ∀ (C : ℕ → ℕ → ℕ → Prop), (∀ (r : ℕ) (I : Set ℕ), I.Infinite → ∃ J ⊆ I, J.Infinite ∧ ∀ j ∈ J, ∀ l ∈ J, C r j l) → ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ r, C r (φ (r + 1)) (φ r) := by
  intro C hC
  -- Step 1: refinements `F(r, I) ⊆ I`, infinite, with all pairs in relation `C r`
  choose F hFsub hFinf hFC using hC
  -- Step 2: nested infinite index sets `I₀ = ℕ`, `I_{r+1} = F(r, I_r)`
  let I : ℕ → {s : Set ℕ // s.Infinite} := fun r =>
    Nat.rec ⟨univ, infinite_univ⟩ (fun r s => ⟨F r s.1 s.2, hFinf r s.1 s.2⟩) r
  have hsub : ∀ r, (I (r + 1)).1 ⊆ (I r).1 := fun r => hFsub r (I r).1 (I r).2
  have hpair : ∀ r, ∀ j ∈ (I (r + 1)).1, ∀ l ∈ (I (r + 1)).1, C r j l :=
    fun r => hFC r (I r).1 (I r).2
  -- Step 3: `I_{r+1}` is unbounded: `g(r, a) ∈ I_{r+1}` and `a < g(r, a)`
  choose g hgI hglt using fun r : ℕ => (I (r + 1)).2.exists_gt
  -- Step 4: diagonal choice `φ(0) = g(0, 0)`, `φ(r + 1) = g(r + 1, φ(r)) ∈ I_{r+2}`
  let φ : ℕ → ℕ := fun r => Nat.rec (g 0 0) (fun r a => g (r + 1) a) r
  have hφI : ∀ r, φ r ∈ (I (r + 1)).1 := by
    intro r
    cases r with
    | zero => exact hgI 0 0
    | succ r => exact hgI (r + 1) (φ r)
  have hφ : StrictMono φ := strictMono_nat_of_lt_succ fun r => hglt (r + 1) (φ r)
  -- Step 5: `φ(r + 1) ∈ I_{r+2} ⊆ I_{r+1}` and `φ(r) ∈ I_{r+1} = F(r, I_r)`
  exact ⟨φ, hφ, fun r => hpair r _ (hsub (r + 1) (hφI (r + 1))) _ (hφI r)⟩
/-- **A bounded Borel tangent field representing `β ↦ ⟨β ∧ ω, ξ⟩`** (Simon Ch. 6, proof of
Lemma 4.5(2), display (3)).  Let `R = (M, θ, ξ)` be an integer multiplicity `(n+1)`-triple and `ω`
a continuous `n`-form with `‖ω‖ ≤ B`.  Let `ξ₀` be a strongly measurable version of `ξ`, replaced
by `0` where its norm exceeds `1`.  Then `W = Σₗ ξ₀(eₗ♭ ∧ ω) eₗ` is Borel, vanishes where `ω` does
and is bounded by `P (n+1) B`.  For `H^{n+1}`-a.e. `x ∈ M`, `ξ(x)` orients `TₓM`, so `‖ξ(x)‖ ≤ 1`
and `ξ₀(x) = ξ(x)`; there `W(x)` is the representing vector of `β ↦ ⟨β ∧ ω(x), ξ(x)⟩`, which
lies in `TₓM`. -/
theorem Submission.dor_lmbsf_ll_tangent_wedge_field : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U (n + 1)) (ω : DifferentialForm (Euclid P) n) (B : ℝ), Continuous ω → (∀ x, ‖ω x‖ ≤ B) → ∃ (W : Euclid P → Euclid P) (c' : ℝ), Measurable W ∧ (∀ x, ω x = 0 → W x = 0) ∧ (∀ x, ‖W x‖ ≤ c') ∧ ∀ᵐ x ∂(μHE[n + 1].restrict R.carrier), W x ∈ approxTangentPlane (n + 1) R.carrier x ∧ ∀ β : Euclid P →L[ℝ] ℝ, R.orient x (ContinuousAlternatingMap.alternatizeUncurryFin (β.smulRight (ω x))) = β (W x) := by
  intro P n U R ω B hω hB
  classical
  -- a strongly measurable version `ξ₁` of `ξ`, and its truncation `ξ₀` to the closed unit ball
  have hξm := R.aestronglyMeasurable_orient
  set ξ₁ : Euclid P → MultiVector P (n + 1) := hξm.mk R.orient with hξ₁_def
  have hξ₁ : StronglyMeasurable ξ₁ := hξm.stronglyMeasurable_mk
  have hξ₁ae : R.orient =ᵐ[μHE[n + 1].restrict R.carrier] ξ₁ := hξm.ae_eq_mk
  set S : Set (Euclid P) := {x | ‖ξ₁ x‖ ≤ 1} with hS_def
  have hS : MeasurableSet S :=
    measurableSet_le (hξ₁.norm (β := MultiVector P (n + 1))).measurable measurable_const
  set ξ₀ : Euclid P → MultiVector P (n + 1) := S.piecewise ξ₁ 0 with hξ₀_def
  have hξ₀ : StronglyMeasurable ξ₀ := hξ₁.piecewise hS stronglyMeasurable_const
  have hξ₀norm : ∀ x, ‖ξ₀ x‖ ≤ 1 := by
    intro x
    by_cases hx : x ∈ S
    · rw [hξ₀_def, Set.piecewise_eq_of_mem _ _ _ hx]; exact hx
    · rw [hξ₀_def, Set.piecewise_eq_of_notMem _ _ _ hx, Pi.zero_apply]
      exact (norm_zero (E := MultiVector P (n + 1))).le.trans zero_le_one
  -- the coefficient forms `Aₗ = eₗ♭ ∧ ω` are continuous
  set e : Fin P → Euclid P := fun l => EuclideanSpace.single l (1 : ℝ) with he_def
  set A : Fin P → Euclid P → Covector (Euclid P) (n + 1) := fun l x =>
    ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ (e l)).smulRight (ω x)) with hA_def
  have hA : ∀ l, Continuous (A l) := by
    intro l
    have h1 : Continuous (fun x => (innerSL ℝ (e l)).smulRight (ω x)) :=
      (isBoundedBilinearMap_smulRight (𝕜 := ℝ) (E := Euclid P)).continuous.comp
        (continuous_const.prodMk hω)
    have h2 := (ContinuousAlternatingMap.alternatizeUncurryFinCLM ℝ (Euclid P) ℝ (n := n)).continuous.comp h1
    simpa [Function.comp_def, ContinuousAlternatingMap.alternatizeUncurryFinCLM_apply] using h2
  -- the coefficients `ξ₀(Aₗ)` are strongly measurable
  have hcoef : ∀ l, StronglyMeasurable (fun x => ξ₀ x (A l x)) := by
    intro l
    have h2 : StronglyMeasurable (A l) := (hA l).stronglyMeasurable
    exact (isBoundedBilinearMap_apply (𝕜 := ℝ) (E := Covector (Euclid P) (n + 1)) (F := ℝ)).continuous.comp_stronglyMeasurable
      (hξ₀.prodMk h2)
  set W : Euclid P → Euclid P := fun x => ∑ l : Fin P, ξ₀ x (A l x) • e l with hW_def
  -- `‖Aₗ‖ ≤ (n+1) ‖eₗ♭‖ ‖ω‖ ≤ (n+1) B`
  have hAnorm : ∀ l x, ‖A l x‖ ≤ (n + 1) * B := by
    intro l x
    have h1 := ContinuousAlternatingMap.norm_alternatizeUncurryFin_le ((innerSL ℝ (e l)).smulRight (ω x))
    have h2 : ‖(innerSL ℝ (e l)).smulRight (ω x)‖ = ‖innerSL ℝ (e l)‖ * ‖ω x‖ :=
      ContinuousLinearMap.norm_smulRight_apply _ _
    have h3 : ‖innerSL ℝ (e l)‖ = 1 := by
      rw [innerSL_apply_norm]; simp [e]
    calc ‖A l x‖ ≤ (n + 1) * ‖(innerSL ℝ (e l)).smulRight (ω x)‖ := h1
      _ = (n + 1) * ‖ω x‖ := by rw [h2, h3, one_mul]
      _ ≤ (n + 1) * B := by gcongr; exact hB x
  refine ⟨W, (P : ℝ) * ((n + 1) * B), ?_, ?_, ?_, ?_⟩
  · exact Finset.measurable_sum _ (fun l _ => (hcoef l).measurable.smul_const (e l))
  · intro x hx
    have hA0 : ∀ l, A l x = 0 := by
      intro l
      have h0 : (innerSL ℝ (e l)).smulRight (0 : Covector (Euclid P) n) = 0 := by ext; simp
      ext v
      simp only [hA_def, hx, h0, ContinuousAlternatingMap.alternatizeUncurryFin_apply]
      simp
    simp only [hW_def, hA0, map_zero, zero_smul, Finset.sum_const_zero]
  · intro x
    calc ‖W x‖ ≤ ∑ l : Fin P, ‖ξ₀ x (A l x) • e l‖ := norm_sum_le _ _
      _ ≤ ∑ l : Fin P, (n + 1) * B := by
          apply Finset.sum_le_sum
          intro l _
          rw [norm_smul]
          have he1 : ‖e l‖ = 1 := by simp [e]
          rw [he1, mul_one]
          calc ‖ξ₀ x (A l x)‖ ≤ ‖ξ₀ x‖ * ‖A l x‖ := (ξ₀ x).le_opNorm _
            _ ≤ 1 * ((n + 1) * B) := by
                gcongr
                · exact hξ₀norm x
                · exact hAnorm l x
            _ = (n + 1) * B := one_mul _
      _ = (P : ℝ) * ((n + 1) * B) := by simp
  -- a.e. on `M`: `ξ` orients `TₓM`, so `‖ξ‖ ≤ 1` and `ξ₀ = ξ₁ = ξ`; then `W` is the representing
  -- vector of `β ↦ ξ(β ∧ ω)`
  · filter_upwards [hξ₁ae, Submission.fvmb_imrep_ae_unitOrientation_approxTangentPlane P (n + 1) U R] with x hx1 hx2
    have hnorm : ‖R.orient x‖ ≤ 1 := Submission.unit_orientation_norm_le_one P (n + 1) _ _ hx2
    have hxS : x ∈ S := by
      show ‖ξ₁ x‖ ≤ 1
      rw [← hx1]; exact hnorm
    have hξ₀x : ξ₀ x = R.orient x := by
      rw [hξ₀_def, Set.piecewise_eq_of_mem _ _ _ hxS, hx1]
    obtain ⟨hidt, hmem⟩ := Submission.dor_lmbsf_ll_wedge_representing_vector P n (R.orient x) (ω x)
    have hWx : W x = ∑ l : Fin P, R.orient x (ContinuousAlternatingMap.alternatizeUncurryFin
        ((innerSL ℝ (EuclideanSpace.single l (1 : ℝ))).smulRight (ω x))) • EuclideanSpace.single l (1 : ℝ) := by
      simp only [hW_def, hA_def, he_def, hξ₀x]
    refine ⟨?_, ?_⟩
    · rw [hWx]; exact hmem _ hx2
    · intro β; rw [hWx]; exact hidt β

/-- **Simon Ch. 6, proof of Lemma 4.5(2), displays (1)–(4)** (Leibniz rule for the Lipschitz
cut-off `h = γ ∘ f`, `γ(s) = min{1, max{0, (b − s)/(b − a)}}`): if `T = τ(M, θ, ξ)`,
`∂T = τ(M', θ', ξ')` and the weak-limit property (G5) holds, then for `ω ∈ 𝒟ⁿ(U)` and `a < b`,
`∫_{M'} θ' h ⟨ω, ξ'⟩ dHⁿ = ∫_M θ h ⟨dω, ξ⟩ dH^{n+1} − (b − a)⁻¹ ∫_{M ∩ {a < f < b}} θ ⟨g♭ ∧ ω, ξ⟩
dH^{n+1}`.  Take `C^∞` functions `h_k → h` uniformly with `‖Dh_k‖ ≤ c` and `|h_k| ≤ 2`, and a
bounded Borel field `W`, zero off `spt ω`, with `W ∈ TₓM` and `ξ(β ∧ ω) = β(W)` for
`H^{n+1}`-a.e. `x ∈ M`.  The defect identity gives `∂T(h_k ω) = T(h_k dω) + ∫_M θ Dh_k[W]`.  As
`k → ∞` the outer terms converge by dominated convergence and the last term by (G5), with limit
`−(b − a)⁻¹ ∫_{M ∩ {a < f < b}} θ ⟨g, W⟩`, and `⟨g, W⟩ = ξ(g♭ ∧ ω)` a.e. on `M`. -/
theorem Submission.dor_lmbsf_lipschitz_cutoff_leibniz : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (n + 1)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (f : Euclid P → ℝ) (L : NNReal) (g : Euclid P → Euclid P), IsOpen U → RT.Represents T → RB.Represents T.boundary → LipschitzWith L f → Measurable g → (∀ x, ‖g x‖ ≤ L) → (∀ (a b : ℝ), a < b → ∀ (hs : ℕ → Euclid P → ℝ) (c : ℝ), (∀ k, ContDiff ℝ 1 (hs k)) → (∀ k x, ‖fderiv ℝ (hs k) x‖ ≤ c) → TendstoUniformly hs (fun x => min 1 (max 0 ((b - f x) / (b - a)))) atTop → ∀ (W : Euclid P → Euclid P) (K : Set (Euclid P)) (c' : ℝ), Measurable W → IsCompact K → K ⊆ U → (∀ x, x ∉ K → W x = 0) → (∀ x, ‖W x‖ ≤ c') → (∀ᵐ x ∂(μHE[n + 1].restrict RT.carrier), W x ∈ approxTangentPlane (n + 1) RT.carrier x) → Tendsto (fun k => ∫ x in RT.carrier, (RT.mult x : ℝ) * fderiv ℝ (hs k) x (W x) ∂μHE[n + 1]) atTop (𝓝 (∫ x in RT.carrier ∩ {x | a < f x ∧ f x < b}, (RT.mult x : ℝ) * (-(b - a)⁻¹ * inner ℝ (g x) (W x)) ∂μHE[n + 1]))) → ∀ (ω : TestFormOn U n) (a b : ℝ), a < b → ∫ x in RB.carrier, (RB.mult x : ℝ) * min 1 (max 0 ((b - f x) / (b - a))) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n] = (∫ x in RT.carrier, (RT.mult x : ℝ) * min 1 (max 0 ((b - f x) / (b - a))) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - (b - a)⁻¹ * ∫ x in RT.carrier ∩ {x | a < f x ∧ f x < b}, (RT.mult x : ℝ) * RT.orient x (ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ (g x)).smulRight ((ω : DifferentialForm (Euclid P) n) x))) ∂μHE[n + 1] := by
  intro P n U T RT RB f L g _hU hRT hRB hf _hgm _hgL hG5 ω a b hab
  -- `ω` is continuous and bounded, and `K = spt ω` is a compact subset of `U`
  obtain ⟨⟨hωs, hωK⟩, hωU⟩ : IsTestForm (ω : DifferentialForm (Euclid P) n) ∧
      tsupport (ω : DifferentialForm (Euclid P) n) ⊆ U := ω.2
  have hωc : Continuous (ω : DifferentialForm (Euclid P) n) := hωs.continuous
  obtain ⟨B, hB⟩ := hωc.bounded_above_of_compact_support hωK
  -- Step 1: `C^∞` cut-offs `h_k → h` uniformly, with `‖Dh_k‖ ≤ c` and `|h_k| ≤ 2`
  obtain ⟨hs, c, hs_smooth, hs_deriv, hs_bdd, hs_unif⟩ :=
    Submission.dor_lmbsf_ll_cutoff_smooth_approx P f L a b hf hab
  have hs_meas : ∀ k, Measurable (hs k) := fun k => (hs_smooth k).continuous.measurable
  -- Step 4: `W` is bounded, Borel and zero off `spt ω`; `W ∈ TₓM` and `ξ(β ∧ ω) = β(W)` a.e.
  obtain ⟨W, c', hWm, hW0, hWc, hWae⟩ :=
    Submission.dor_lmbsf_ll_tangent_wedge_field P n U RT (ω : DifferentialForm (Euclid P) n) B
      hωc hB
  -- Step 4(d): (G5) for `h_k`, `W` and `K = spt ω`
  have hmid := hG5 a b hab hs c (fun k => (hs_smooth k).of_le (by exact_mod_cast le_top))
    hs_deriv hs_unif W (tsupport (ω : DifferentialForm (Euclid P) n)) c' hWm hωK hωU
    (fun x hx => hW0 x (image_eq_zero_of_notMem_tsupport hx)) hWc (hWae.mono fun x hx => hx.1)
  -- Step 3: the outer terms converge by dominated convergence
  have hlimB : Tendsto (fun k => ∫ x in RB.carrier, (RB.mult x : ℝ) * hs k x *
      RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) atTop
      (𝓝 (∫ x in RB.carrier, (RB.mult x : ℝ) * min 1 (max 0 ((b - f x) / (b - a))) *
        RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n])) :=
    Submission.dor_lmbsf_ll_action_mul_tendsto P n U RB ω hs
      (fun x => min 1 (max 0 ((b - f x) / (b - a)))) 2 hs_meas hs_bdd hs_unif.tendsto_at
  have hlimT : Tendsto (fun k => ∫ x in RT.carrier, (RT.mult x : ℝ) * hs k x *
      RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) atTop
      (𝓝 (∫ x in RT.carrier, (RT.mult x : ℝ) * min 1 (max 0 ((b - f x) / (b - a))) *
        RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1])) :=
    Submission.dor_lmbsf_ll_action_mul_tendsto P (n + 1) U RT (exteriorDerivativeTestOn U n ω) hs
      (fun x => min 1 (max 0 ((b - f x) / (b - a)))) 2 hs_meas hs_bdd hs_unif.tendsto_at
  -- Step 2: `T = (θ ξ) H^{n+1}⌞M` and `∂T = (θ' ξ') Hⁿ⌞M'`
  have hrepT : ∀ η : TestFormOn U (n + 1), T η = ∫ x, ((RT.mult x : ℝ) • RT.orient x)
      ((η : DifferentialForm (Euclid P) (n + 1)) x) ∂(μHE[n + 1].restrict RT.carrier) := by
    intro η
    rw [hRT η]
    simp only [IMRep.action, smul_apply, smul_eq_mul]
  have hrepB : ∀ η : TestFormOn U n, T.boundary η = ∫ x, ((RB.mult x : ℝ) • RB.orient x)
      ((η : DifferentialForm (Euclid P) n) x) ∂(μHE[n].restrict RB.carrier) := by
    intro η
    rw [hRB η]
    simp only [IMRep.action, smul_apply, smul_eq_mul]
  -- Steps 2 and 4(c): `∂T(h_k ω) = T(h_k dω) + T(dh_k ∧ ω)` and `ξ(dh_k ∧ ω) = Dh_k[W]` a.e.
  have hk : ∀ k, ∫ x in RB.carrier, (RB.mult x : ℝ) * hs k x *
      RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n] =
      (∫ x in RT.carrier, (RT.mult x : ℝ) * hs k x *
        RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) +
      ∫ x in RT.carrier, (RT.mult x : ℝ) * fderiv ℝ (hs k) x (W x) ∂μHE[n + 1] := by
    intro k
    have hid := Submission.cmcs_cd_defect_identity P n U T (μHE[n + 1].restrict RT.carrier)
      (μHE[n].restrict RB.carrier) (fun x => (RT.mult x : ℝ) • RT.orient x)
      (fun x => (RB.mult x : ℝ) • RB.orient x) (hs k) ω hrepT hrepB (hs_smooth k)
    have e1 : ∫ x, hs k x * ((RT.mult x : ℝ) • RT.orient x)
        (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x)
          ∂(μHE[n + 1].restrict RT.carrier) =
        ∫ x in RT.carrier, (RT.mult x : ℝ) * hs k x *
          RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1] :=
      integral_congr_ae (Eventually.of_forall fun x => by
        simp only [smul_apply, smul_eq_mul]
        ring)
    have e2 : ∫ x, hs k x * ((RB.mult x : ℝ) • RB.orient x)
        ((ω : DifferentialForm (Euclid P) n) x) ∂(μHE[n].restrict RB.carrier) =
        ∫ x in RB.carrier, (RB.mult x : ℝ) * hs k x *
          RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n] :=
      integral_congr_ae (Eventually.of_forall fun x => by
        simp only [smul_apply, smul_eq_mul]
        ring)
    have e3 : ∫ x, ((RT.mult x : ℝ) • RT.orient x)
        (ContinuousAlternatingMap.alternatizeUncurryFin ((fderiv ℝ (hs k) x).smulRight
          ((ω : DifferentialForm (Euclid P) n) x))) ∂(μHE[n + 1].restrict RT.carrier) =
        ∫ x in RT.carrier, (RT.mult x : ℝ) * fderiv ℝ (hs k) x (W x) ∂μHE[n + 1] := by
      refine integral_congr_ae ?_
      filter_upwards [hWae] with x hx
      rw [smul_apply, smul_eq_mul, hx.2]
    rw [e1, e2, e3] at hid
    linarith
  -- Step 4(e): the (G5) limit is `−(b − a)⁻¹ ∫_{M ∩ {a < f < b}} θ ξ(g♭ ∧ ω)`
  have hval : ∫ x in RT.carrier ∩ {x | a < f x ∧ f x < b},
      (RT.mult x : ℝ) * (-(b - a)⁻¹ * inner ℝ (g x) (W x)) ∂μHE[n + 1] =
      -(b - a)⁻¹ * ∫ x in RT.carrier ∩ {x | a < f x ∧ f x < b}, (RT.mult x : ℝ) *
        RT.orient x (ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ (g x)).smulRight
          ((ω : DifferentialForm (Euclid P) n) x))) ∂μHE[n + 1] := by
    rw [← integral_const_mul]
    refine integral_congr_ae ?_
    filter_upwards [ae_restrict_of_ae_restrict_of_subset inter_subset_left hWae] with x hx
    rw [hx.2, innerSL_apply_apply]
    ring
  -- Step 5: let `k → ∞`; limits are unique
  have hlim := tendsto_nhds_unique hlimB ((hlimT.add hmid).congr fun k => (hk k).symm)
  rw [hlim, hval]
  ring

/-- **The slices of an integer multiplicity triple** (Simon Ch. 6, Lemma 4.1, Remark 4.2, 4.3,
Definition 4.4 and the proof of Lemma 4.5(1)).  Let `RT = (M, θ, ξ)` be an integer multiplicity
`(n+1)`-triple in `U`, `f` `L`-Lipschitz and `g` Borel with `|g| ≤ L` and `g(x) ∈ TₓM` a.e. on `M`.
Assume the co-area identity on the slices `Mₜ = M ∩ {g ≠ 0} ∩ f⁻¹(t)`, that every `Mₜ` is
countably `n`-rectifiable and that, when `Hⁿ⌞Mₜ` is locally finite in `U`, `Mₜ` has approximate
tangent space `TₓM ∩ g(x)^⊥` a.e.  Let `ξ₀` be a strongly measurable version of `ξ` and
`ζ' = ξ₀ ⌞ (g/|g|)♭`.  For a.e. `t`, `θ Hⁿ⌞Mₜ` is locally finite and a.e. `x ∈ Mₜ` has `ξ₀(x)`
orienting `TₓM` and `g(x) ∈ TₓM`; then `Rₜ = (Mₜ, θ, ζ')` is an integer multiplicity `n`-triple
(`ζ'(x)` orients `TₓM ∩ g(x)^⊥`), and otherwise `Rₜ` is the empty triple.  The co-area identity
with `φ = θ 1_W` gives `∫ μ_{Rₜ}(W) dt ≤ L μ_{RT}(W)`.  The signed co-area identity for
`q = θ ζ'(ω)` and `q 1_{a<f<b}`, where `|g| q = θ ξ₀(g♭ ∧ ω)` and `|g| |q| ≤ (n+1) L sup|ω| θ` on
`spt ω`, gives the integrability of `t ↦ τ(Rₜ)(ω)` and, as `f ≡ t` on `Mₜ`,
`∫_a^b τ(Rₜ)(ω) dt = ∫_{M ∩ {a<f<b}} θ ⟨g♭ ∧ ω, ξ⟩ dH^{n+1}`. -/
theorem Submission.dor_lmbsf_slice_imreps : ∀ (P n : ℕ) (U : Set (Euclid P)) (RT : IMRep U (n + 1)) (f : Euclid P → ℝ) (L : NNReal) (g : Euclid P → Euclid P), IsOpen U → LipschitzWith L f → Measurable g → (∀ x, ‖g x‖ ≤ L) → (∀ᵐ x ∂(μHE[n + 1].restrict RT.carrier), g x ∈ approxTangentPlane (n + 1) RT.carrier x) → (∀ φ : Euclid P → ℝ≥0∞, Measurable φ → AEMeasurable (fun t => ∫⁻ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}, φ x ∂μHE[n]) ∧ ∫⁻ t, (∫⁻ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}, φ x ∂μHE[n]) = ∫⁻ x in RT.carrier, ‖g x‖ₑ * φ x ∂μHE[n + 1]) → (∀ t, CountablyRectifiable n (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t})) → (∀ t, (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t})), HasApproximateTangentSpaceAt n (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}) x (approxTangentPlane (n + 1) RT.carrier x ⊓ (ℝ ∙ g x)ᗮ)) → ∃ Rs : ℝ → IMRep U n, (∀ t, (Rs t).carrier ⊆ f ⁻¹' {t}) ∧ (∀ W : Set (Euclid P), MeasurableSet W → AEMeasurable (fun t => (Rs t).measure W) ∧ ∫⁻ t, (Rs t).measure W ≤ (L : ℝ≥0∞) * RT.measure W) ∧ (∀ ω : TestFormOn U n, Integrable (fun s => (Rs s).action (ω : DifferentialForm (Euclid P) n))) ∧ ∀ (ω : TestFormOn U n) (a b : ℝ), a < b → ∫ s in a..b, (Rs s).action (ω : DifferentialForm (Euclid P) n) = ∫ x in RT.carrier ∩ {x | a < f x ∧ f x < b}, (RT.mult x : ℝ) * RT.orient x (ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ (g x)).smulRight ((ω : DifferentialForm (Euclid P) n) x))) ∂μHE[n + 1] := by
  intro P n U RT f L g hU hf hg hgL hgT hco hrect htan
  classical
  have hfm : Measurable f := hf.continuous.measurable
  have hθm : Measurable fun x => (RT.mult x : ℝ≥0∞) := measurable_from_nat.comp RT.measurable_mult
  have hθm' : Measurable fun x => (RT.mult x : ℝ) := measurable_from_nat.comp RT.measurable_mult
  have hgL' : ∀ x, ‖g x‖ₑ ≤ (L : ℝ≥0∞) := fun x =>
    enorm_le_coe.mpr (by rw [← NNReal.coe_le_coe, coe_nnnorm]; exact hgL x)
  have hMt : ∀ t, MeasurableSet (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}) := fun t =>
    (RT.measurableSet_carrier.inter (hg (measurableSet_singleton 0).compl)).inter
      (hfm (measurableSet_singleton t))
  -- `∫_S 1_W θ = ∫_{S ∩ W} θ`
  have hind : ∀ W : Set (Euclid P), MeasurableSet W → ∀ (μ' : Measure (Euclid P))
      (S : Set (Euclid P)), ∫⁻ x in S, W.indicator (fun x => (RT.mult x : ℝ≥0∞)) x ∂μ' =
        ∫⁻ x in S ∩ W, (RT.mult x : ℝ≥0∞) ∂μ' := by
    intro W hW μ' S
    rw [lintegral_indicator hW, Measure.restrict_restrict hW, inter_comm W]
  -- a strongly measurable version `ξ₀` of the orientation `ξ` of `RT`, and the slice orientation
  -- field `ζ' = ξ₀ ⌞ (g/|g|)♭`
  obtain ⟨ξ₀, hξ₀, hξξ₀⟩ : ∃ ξ₀ : Euclid P → MultiVector P (n + 1), StronglyMeasurable ξ₀ ∧
      RT.orient =ᵐ[μHE[n + 1].restrict RT.carrier] ξ₀ :=
    ⟨_, RT.aestronglyMeasurable_orient.stronglyMeasurable_mk,
      RT.aestronglyMeasurable_orient.ae_eq_mk⟩
  obtain ⟨ζ', hζ'm, hζ'ν, hζ'g, hζbd⟩ :=
    Submission.dor_lmbsf_si_slice_orientation_field P n ξ₀ g hξ₀ hg
  -- good points of `M`: `ξ₀(x)` is a unit orientation of `TₓM` and `g(x) ∈ TₓM`
  have hgood : ∀ᵐ x ∂(μHE[n + 1].restrict RT.carrier),
      IsUnitOrientationOf (ξ₀ x) (approxTangentPlane (n + 1) RT.carrier x) ∧
        g x ∈ approxTangentPlane (n + 1) RT.carrier x := by
    filter_upwards [Submission.fvmb_imrep_ae_unitOrientation_approxTangentPlane P (n + 1) U RT,
      hξξ₀, hgT] with x h1 h2 h3
    exact ⟨h2 ▸ h1, h3⟩
  -- step 1: for a.e. `t`, a.e. point of `Mₜ` is a good point of `M`
  have hgood_t : ∀ᵐ t, ∀ᵐ x ∂(μHE[n].restrict (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t})),
      IsUnitOrientationOf (ξ₀ x) (approxTangentPlane (n + 1) RT.carrier x) ∧
        g x ∈ approxTangentPlane (n + 1) RT.carrier x :=
    Submission.dor_lmbsf_si_coarea_ae_transfer P (μHE[n + 1].restrict RT.carrier)
      (fun t => μHE[n].restrict (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t})) (fun x => ‖g x‖ₑ) _
      hco hgood
  -- step 2: for a.e. `t`, `θ Hⁿ⌞Mₜ` is locally finite in `U`; by the co-area identity with
  -- `φ = θ 1_K`, `∫ ∫_{Mₜ ∩ K} θ dHⁿ dt ≤ L ∫_{M ∩ K} θ dH^{n+1} < ∞` for compact `K ⊆ U`
  have hfin : ∀ᵐ t, ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
      ∫⁻ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} ∩ K, (RT.mult x : ℝ≥0∞) ∂μHE[n] ≠ ∞ := by
    refine Submission.dor_lmbsf_si_ae_forall_compact P U
      (fun t K => ∫⁻ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} ∩ K, (RT.mult x : ℝ≥0∞) ∂μHE[n])
      hU (fun t => by
        intro K₁ K₂ hK
        exact lintegral_mono_set (inter_subset_inter_right _ hK)) ?_
    intro K hK hKU
    have hKm : MeasurableSet K := hK.isClosed.measurableSet
    obtain ⟨hae, heq⟩ := hco _ (hθm.indicator hKm)
    have hlt : ∫⁻ t, ∫⁻ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t},
        K.indicator (fun x => (RT.mult x : ℝ≥0∞)) x ∂μHE[n] ≠ ∞ := by
      rw [heq]
      refine ne_top_of_le_ne_top (ENNReal.mul_ne_top (ENNReal.coe_ne_top (r := L))
        (RT.locallyIntegrable_mult K hK hKU)) ?_
      calc ∫⁻ x in RT.carrier, ‖g x‖ₑ * K.indicator (fun x => (RT.mult x : ℝ≥0∞)) x ∂μHE[n + 1]
          ≤ ∫⁻ x in RT.carrier, (L : ℝ≥0∞) * K.indicator (fun x => (RT.mult x : ℝ≥0∞)) x
              ∂μHE[n + 1] := lintegral_mono fun x => mul_le_mul' (hgL' x) le_rfl
        _ = (L : ℝ≥0∞) * ∫⁻ x in RT.carrier ∩ K, (RT.mult x : ℝ≥0∞) ∂μHE[n + 1] := by
          rw [lintegral_const_mul' _ _ ENNReal.coe_ne_top, hind K hKm]
    filter_upwards [ae_lt_top' hae hlt] with t ht
    rw [hind K hKm] at ht
    exact ht.ne
  -- the good levels
  obtain ⟨G, hGae, hGfin, hGgood⟩ : ∃ G : ℝ → Prop, (∀ᵐ t, G t) ∧
      (∀ t, G t → ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
        ∫⁻ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} ∩ K, (RT.mult x : ℝ≥0∞) ∂μHE[n] ≠ ∞) ∧
      (∀ t, G t → ∀ᵐ x ∂(μHE[n].restrict (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t})),
        IsUnitOrientationOf (ξ₀ x) (approxTangentPlane (n + 1) RT.carrier x) ∧
          g x ∈ approxTangentPlane (n + 1) RT.carrier x) :=
    ⟨_, hfin.and hgood_t, fun _ ht => ht.1, fun _ ht => ht.2⟩
  -- steps 3 and 4: `Rₜ = (Mₜ, θ, ζ')` for good `t`, the empty triple otherwise
  have hR : ∀ t, ∃ R : IMRep U n,
      R.carrier = (if G t then RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} else ∅) ∧
        R.mult = RT.mult ∧ R.orient = ζ' := by
    intro t
    by_cases ht : G t
    · -- `Hⁿ⌞Mₜ` is locally finite in `U`, as `θ ≥ 1` on `Mₜ`
      have hfinH : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
          μHE[n] (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} ∩ K) ≠ ∞ := by
        intro K hK hKU
        refine ne_top_of_le_ne_top (hGfin t ht K hK hKU) ?_
        calc μHE[n] (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} ∩ K)
            = ∫⁻ _ in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} ∩ K, 1 ∂μHE[n] :=
              (setLIntegral_one _).symm
          _ ≤ ∫⁻ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} ∩ K, (RT.mult x : ℝ≥0∞) ∂μHE[n] :=
              setLIntegral_mono' ((hMt t).inter hK.isClosed.measurableSet) fun x hx =>
                Nat.one_le_cast.mpr (RT.mult_pos x hx.1.1.1)
      -- `ζ'(x)` orients `TₓM ∩ g(x)^⊥`, the approximate tangent space of `Mₜ` at `x`
      have horients : ∀ᵐ x ∂(μHE[n].restrict (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t})),
          ∃ Q : Submodule ℝ (Euclid P),
            HasApproximateTangentSpaceAt n (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}) x Q ∧
              IsUnitOrientationOf (ζ' x) Q := by
        filter_upwards [htan t hfinH, hGgood t ht, ae_restrict_mem (hMt t)] with x hxT hxg hxM
        have hn : ‖g x‖ ≠ 0 := norm_ne_zero_iff.mpr hxM.1.2
        have h1 : ‖‖g x‖⁻¹ • g x‖ = 1 := by
          rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hn]
        have h := Submission.dor_lmbsf_interior_product_orientation P n (ξ₀ x) (ζ' x)
          (approxTangentPlane (n + 1) RT.carrier x) (‖g x‖⁻¹ • g x) hxg.1
          (Submodule.smul_mem _ _ hxg.2) h1 (hζ'ν x)
        rw [Submodule.span_singleton_smul_eq (inv_ne_zero hn).isUnit] at h
        exact ⟨_, hxT, h⟩
      exact ⟨{ carrier := RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}
               mult := RT.mult
               orient := ζ'
               measurableSet_carrier := hMt t
               carrier_subset := fun x hx => RT.carrier_subset hx.1.1
               rectifiable := hrect t
               measurable_mult := RT.measurable_mult
               mult_pos := fun x hx => RT.mult_pos x hx.1.1
               locallyIntegrable_mult := hGfin t ht
               aestronglyMeasurable_orient := hζ'm.aestronglyMeasurable
               orients := horients }, by rw [ite_eq_left ht], rfl, rfl⟩
    · exact ⟨{ carrier := ∅
               mult := RT.mult
               orient := ζ'
               measurableSet_carrier := MeasurableSet.empty
               carrier_subset := empty_subset _
               rectifiable := (hrect t).mono (empty_subset _)
               measurable_mult := RT.measurable_mult
               mult_pos := fun x hx => absurd hx (notMem_empty x)
               locallyIntegrable_mult := fun K _ _ => by simp
               aestronglyMeasurable_orient := hζ'm.aestronglyMeasurable
               orients := by simp }, by rw [ite_eq_right ht], rfl, rfl⟩
  choose Rs hRc hRm hRo using hR
  -- mass and action of `Rₜ` at good levels
  have hmeas : ∀ W : Set (Euclid P), MeasurableSet W → ∀ t, G t →
      (Rs t).measure W = ∫⁻ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t},
        W.indicator (fun x => (RT.mult x : ℝ≥0∞)) x ∂μHE[n] := by
    intro W hW t ht
    rw [IMRep.measure, withDensity_apply _ hW, hRc t, hRm t, ite_eq_left ht, lintegral_indicator hW]
  have hact : ∀ (ω : DifferentialForm (Euclid P) n) t, G t →
      (Rs t).action ω = ∫ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t},
        (RT.mult x : ℝ) * ζ' x (ω x) ∂μHE[n] := by
    intro ω t ht
    rw [IMRep.action, hRc t, hRm t, hRo t, ite_eq_left ht]
  -- the signed co-area identity
  have hsig : ∀ q : Euclid P → ℝ, Measurable q →
      ∫⁻ x in RT.carrier, ‖g x‖ₑ * ‖q x‖ₑ ∂μHE[n + 1] ≠ ∞ →
      Integrable (fun t => ∫ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}, q x ∂μHE[n]) ∧
        ∫ t, ∫ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}, q x ∂μHE[n] =
          ∫ x in RT.carrier, ‖g x‖ * q x ∂μHE[n + 1] := by
    intro q hq hq'
    have h := Submission.dor_lmbsf_si_coarea_signed_integral P (μHE[n + 1].restrict RT.carrier)
      (fun t => μHE[n].restrict (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t})) (fun x => ‖g x‖ₑ) q
      hco hg.enorm hq hq'
    simp only [toReal_enorm] at h
    exact h
  -- the integrand `q_ω = θ ζ'(ω)`: measurability and the co-area bound
  -- `|g| |q_ω| = θ |ξ₀(g♭ ∧ ω)| ≤ (n+1) L sup|ω| θ 1_{spt ω}` a.e. on `M`
  have hqm : ∀ ω : TestFormOn U n,
      Measurable fun x => (RT.mult x : ℝ) * ζ' x ((ω : DifferentialForm (Euclid P) n) x) := by
    intro ω
    have hωc : Continuous (ω : DifferentialForm (Euclid P) n) := ContDiff.continuous ω.2.1.1
    exact hθm'.mul ((continuous_fst.clm_apply continuous_snd).comp_stronglyMeasurable
      (hζ'm.prodMk hωc.stronglyMeasurable)).measurable
  have hqfin : ∀ ω : TestFormOn U n, ∫⁻ x in RT.carrier,
      ‖g x‖ₑ * ‖(RT.mult x : ℝ) * ζ' x ((ω : DifferentialForm (Euclid P) n) x)‖ₑ ∂μHE[n + 1] ≠
        ∞ := by
    intro ω
    have hK : IsCompact (tsupport (ω : DifferentialForm (Euclid P) n)) := ω.2.1.2.isCompact
    have hKm : MeasurableSet (tsupport (ω : DifferentialForm (Euclid P) n)) :=
      hK.isClosed.measurableSet
    obtain ⟨c, hc⟩ := (ContDiff.continuous ω.2.1.1).bounded_above_of_compact_support ω.2.1.2
    have hbound : ∀ᵐ x ∂(μHE[n + 1].restrict RT.carrier),
        ‖g x‖ₑ * ‖(RT.mult x : ℝ) * ζ' x ((ω : DifferentialForm (Euclid P) n) x)‖ₑ ≤
          (tsupport (ω : DifferentialForm (Euclid P) n)).indicator
            (fun x => (RT.mult x : ℝ≥0∞) * ENNReal.ofReal (((n : ℝ) + 1) * L * c)) x := by
      filter_upwards [hgood] with x hx
      by_cases hxK : x ∈ tsupport (ω : DifferentialForm (Euclid P) n)
      · rw [indicator_of_mem hxK]
        have hξ1 : ‖ξ₀ x‖ ≤ 1 := Submission.unit_orientation_norm_le_one P (n + 1) _ _ hx.1
        have hreal : ‖g x‖ * ‖(RT.mult x : ℝ) * ζ' x ((ω : DifferentialForm (Euclid P) n) x)‖ ≤
            (RT.mult x : ℝ) * (((n : ℝ) + 1) * L * c) := by
          have h1 : ‖g x‖ * ‖(RT.mult x : ℝ) * ζ' x ((ω : DifferentialForm (Euclid P) n) x)‖ =
              (RT.mult x : ℝ) * |ξ₀ x (ContinuousAlternatingMap.alternatizeUncurryFin
                ((innerSL ℝ (g x)).smulRight ((ω : DifferentialForm (Euclid P) n) x)))| := by
            rw [← hζ'g x]
            simp only [Real.norm_eq_abs, abs_mul, Nat.abs_cast, abs_norm]
            ring
          rw [h1]
          gcongr
          calc |ξ₀ x (ContinuousAlternatingMap.alternatizeUncurryFin
                ((innerSL ℝ (g x)).smulRight ((ω : DifferentialForm (Euclid P) n) x)))|
              ≤ ((n : ℝ) + 1) * ‖ξ₀ x‖ * ‖g x‖ * ‖(ω : DifferentialForm (Euclid P) n) x‖ :=
                hζbd x _
            _ ≤ ((n : ℝ) + 1) * 1 * L * c := by
                gcongr
                exacts [hgL x, hc x]
            _ = ((n : ℝ) + 1) * L * c := by ring
        calc ‖g x‖ₑ * ‖(RT.mult x : ℝ) * ζ' x ((ω : DifferentialForm (Euclid P) n) x)‖ₑ
            = ENNReal.ofReal
                (‖g x‖ * ‖(RT.mult x : ℝ) * ζ' x ((ω : DifferentialForm (Euclid P) n) x)‖) := by
              rw [ENNReal.ofReal_mul (norm_nonneg _), ofReal_norm, ofReal_norm]
          _ ≤ ENNReal.ofReal ((RT.mult x : ℝ) * (((n : ℝ) + 1) * L * c)) :=
              ENNReal.ofReal_le_ofReal hreal
          _ = (RT.mult x : ℝ≥0∞) * ENNReal.ofReal (((n : ℝ) + 1) * L * c) := by
              rw [ENNReal.ofReal_mul (Nat.cast_nonneg _), ENNReal.ofReal_natCast]
      · simp [indicator_of_notMem hxK, image_eq_zero_of_notMem_tsupport hxK]
    refine ne_top_of_le_ne_top ?_ (lintegral_mono_ae hbound)
    rw [lintegral_indicator hKm, Measure.restrict_restrict hKm, inter_comm (tsupport _),
      lintegral_mul_const' _ _ ENNReal.ofReal_ne_top]
    exact ENNReal.mul_ne_top (RT.locallyIntegrable_mult _ hK ω.2.2) ENNReal.ofReal_ne_top
  refine ⟨Rs, fun t x hx => ?_, fun W hW => ?_, fun ω => ?_, fun ω a b hab => ?_⟩
  · -- (1): `Rₜ` is carried by `f⁻¹(t)`
    rw [hRc t] at hx
    split_ifs at hx with ht
    · exact hx.2
    · exact absurd hx (notMem_empty x)
  · -- (2): co-area identity with `φ = θ 1_W` and `|g| ≤ L`
    obtain ⟨hae, heq⟩ := hco _ (hθm.indicator hW)
    have hcongr : (fun t => (Rs t).measure W) =ᵐ[volume] fun t =>
        ∫⁻ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t},
          W.indicator (fun x => (RT.mult x : ℝ≥0∞)) x ∂μHE[n] := by
      filter_upwards [hGae] with t ht using hmeas W hW t ht
    refine ⟨hae.congr hcongr.symm, ?_⟩
    rw [lintegral_congr_ae hcongr, heq]
    calc ∫⁻ x in RT.carrier, ‖g x‖ₑ * W.indicator (fun x => (RT.mult x : ℝ≥0∞)) x ∂μHE[n + 1]
        ≤ ∫⁻ x in RT.carrier, (L : ℝ≥0∞) * W.indicator (fun x => (RT.mult x : ℝ≥0∞)) x
            ∂μHE[n + 1] := lintegral_mono fun x => mul_le_mul' (hgL' x) le_rfl
      _ = (L : ℝ≥0∞) * RT.measure W := by
        rw [lintegral_const_mul' _ _ ENNReal.coe_ne_top, IMRep.measure, withDensity_apply _ hW,
          lintegral_indicator hW]
  · -- (3): `t ↦ τ(Rₜ)(ω)` agrees a.e. with the integrable `t ↦ ∫_{Mₜ} q_ω dHⁿ`
    obtain ⟨hint, -⟩ := hsig _ (hqm ω) (hqfin ω)
    refine hint.congr ?_
    filter_upwards [hGae] with t ht using (hact _ t ht).symm
  · -- (4'): signed co-area identity for `q_ω 1_{a<f<b}`, with `f ≡ t` on `Mₜ` and
    -- `|g| ζ'(ω) = ξ₀(g♭ ∧ ω)`
    have hS : MeasurableSet {x | a < f x ∧ f x < b} :=
      (measurableSet_lt measurable_const hfm).inter (measurableSet_lt hfm measurable_const)
    have hq'fin : ∫⁻ x in RT.carrier, ‖g x‖ₑ * ‖{x | a < f x ∧ f x < b}.indicator
        (fun x => (RT.mult x : ℝ) * ζ' x ((ω : DifferentialForm (Euclid P) n) x)) x‖ₑ
          ∂μHE[n + 1] ≠ ∞ := by
      refine ne_top_of_le_ne_top (hqfin ω) (lintegral_mono fun x => ?_)
      by_cases hx : x ∈ {x | a < f x ∧ f x < b}
      · rw [indicator_of_mem hx]
      · rw [indicator_of_notMem hx, enorm_zero, mul_zero]
        exact zero_le
    obtain ⟨-, heq⟩ := hsig _ ((hqm ω).indicator hS) hq'fin
    rw [intervalIntegral.integral_of_le hab.le, integral_Ioc_eq_integral_Ioo,
      ← integral_indicator measurableSet_Ioo, ← setIntegral_indicator hS]
    calc ∫ s, (Ioo a b).indicator (fun s => (Rs s).action (ω : DifferentialForm (Euclid P) n)) s
        = ∫ s, ∫ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {s}, {x | a < f x ∧ f x < b}.indicator
            (fun x => (RT.mult x : ℝ) * ζ' x ((ω : DifferentialForm (Euclid P) n) x)) x
              ∂μHE[n] := by
          refine integral_congr_ae ?_
          filter_upwards [hGae] with s hs
          by_cases hs' : s ∈ Ioo a b
          · rw [indicator_of_mem hs', hact _ s hs]
            refine setIntegral_congr_fun (hMt s) fun x hx => ?_
            have hfx : f x = s := hx.2
            have hxS : x ∈ {x | a < f x ∧ f x < b} := by
              show a < f x ∧ f x < b
              rw [hfx]
              exact hs'
            rw [indicator_of_mem hxS]
          · rw [indicator_of_notMem hs']
            refine (setIntegral_eq_zero_of_forall_eq_zero fun x hx => ?_).symm
            have hfx : f x = s := hx.2
            have hxS : x ∉ {x | a < f x ∧ f x < b} := by
              show ¬(a < f x ∧ f x < b)
              rw [hfx]
              exact hs'
            exact indicator_of_notMem hxS _
      _ = ∫ x in RT.carrier, ‖g x‖ * {x | a < f x ∧ f x < b}.indicator
            (fun x => (RT.mult x : ℝ) * ζ' x ((ω : DifferentialForm (Euclid P) n) x)) x
              ∂μHE[n + 1] := heq
      _ = ∫ x in RT.carrier, {x | a < f x ∧ f x < b}.indicator (fun x => (RT.mult x : ℝ) *
            RT.orient x (ContinuousAlternatingMap.alternatizeUncurryFin
              ((innerSL ℝ (g x)).smulRight ((ω : DifferentialForm (Euclid P) n) x)))) x
                ∂μHE[n + 1] := by
          refine integral_congr_ae ?_
          filter_upwards [hξξ₀] with x hx
          by_cases hxS : x ∈ {x | a < f x ∧ f x < b}
          · rw [indicator_of_mem hxS, indicator_of_mem hxS, hx, ← hζ'g x]
            ring
          · rw [indicator_of_notMem hxS, indicator_of_notMem hxS, mul_zero]

/-- **Simon Ch. 6, 4.4–4.5(2) for an integer multiplicity `T = τ(M, θ, ξ)` and a Lipschitz `f`**
(for a.e. `t`, `R_t = (M ∩ {g ≠ 0} ∩ f⁻¹(t), θ, ξ⌞ν)` with `ν = g/|g|`).
`dor_lmbsf_tangential_gradient` gives the tangential gradient `g` of `f` along `M`: `|g| ≤ L`,
`g ∈ TₓM`, the co-area formula, rectifiable slices with tangent planes `TₓM ∩ g(x)^⊥`, and the
weak limit of the gradients of `C¹` approximations of `γ_{a,b} ∘ f`.  `dor_lmbsf_slice_imreps`
builds the slices, with (1)–(3) and `∫_a^b τ(R_s)(ω) ds = ∫_{M ∩ {a < f < b}} θ ξ(g♭ ∧ ω) dH^{n+1}`
(co-area, Simon 4.2).  `dor_lmbsf_lipschitz_cutoff_leibniz` is the Leibniz rule
`∂T(γω) = T(dγ ∧ ω) + T(γ dω)` for the Lipschitz cut-off `γ = γ_{a,b} ∘ f`, with
`T(dγ ∧ ω) = −(b − a)⁻¹ ∫_{M ∩ {a < f < b}} θ ξ(g♭ ∧ ω) dH^{n+1}`; solving it for this middle term
gives (4). -/
theorem Submission.dor_lmbs_imrep_slice_family : (∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q) → ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (n + 1)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → RT.Represents T → RB.Represents T.boundary → LipschitzWith L f → ∃ Rs : ℝ → IMRep U n, (∀ t, (Rs t).carrier ⊆ f ⁻¹' {t}) ∧ (∀ W : Set (Euclid P), MeasurableSet W → AEMeasurable (fun t => (Rs t).measure W) ∧ ∫⁻ t, (Rs t).measure W ≤ (L : ℝ≥0∞) * RT.measure W) ∧ (∀ ω : TestFormOn U n, Integrable (fun s => (Rs s).action (ω : DifferentialForm (Euclid P) n))) ∧ ∀ (ω : TestFormOn U n) (a b : ℝ), a < b → ∫ s in a..b, (Rs s).action (ω : DifferentialForm (Euclid P) n) = (b - a) * ((∫ x in RT.carrier, (RT.mult x : ℝ) * min 1 (max 0 ((b - f x) / (b - a))) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier, (RB.mult x : ℝ) * min 1 (max 0 ((b - f x) / (b - a))) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) := by
  intro hTL P n U T RT RB f L hU hRT hRB hf
  -- the tangential gradient `g` of `f` along `M`
  obtain ⟨g, hgm, hgL, hgtan, hcoarea, hrect, hslice, hweak⟩ :=
    Submission.dor_lmbsf_tangential_gradient hTL P n U RT f L hU hf
  -- the slices `R_t`, conclusions (1)–(3), and `∫_a^b τ(R_s)(ω) ds` as a middle term
  obtain ⟨Rs, hcarrier, hmass, hint, hmiddle⟩ :=
    Submission.dor_lmbsf_slice_imreps P n U RT f L g hU hf hgm hgL hgtan hcoarea hrect hslice
  refine ⟨Rs, hcarrier, hmass, hint, fun ω a b hab => ?_⟩
  -- (4): the Leibniz identity `A = B - (b - a)⁻¹ * S` solved for `S = (b - a) * (B - A)`
  rw [hmiddle ω a b hab, Submission.dor_lmbsf_lipschitz_cutoff_leibniz P n U T RT RB f L g hU hRT
    hRB hf hgm hgL hweak ω a b hab, sub_sub_cancel, mul_inv_cancel_left₀ (sub_pos.mpr hab).ne']
/-- An open `U ⊆ ℝᴾ` is exhausted by the compact sets
`Kᵢ = B̄(0, i + 1) ∩ {x : 1 / (i + 1) ≤ dist(x, y) for all y ∉ U}`: each `Kᵢ ⊆ U` (take `y = x`),
and a compact `C ⊆ U` has a margin `δ > 0` with `thickening δ C ⊆ U` and a radius `R` with
`C ⊆ B̄(0, R)`, so `C ⊆ Kᵢ` once `1 / (i + 1) < δ` and `R ≤ i + 1`. -/
theorem Submission.dor_lmbs_tfa_compact_exhaustion : ∀ (P : ℕ) (U : Set (Euclid P)), IsOpen U → ∃ K : ℕ → Set (Euclid P), (∀ i, IsCompact (K i)) ∧ (∀ i, K i ⊆ U) ∧ ∀ C : Set (Euclid P), IsCompact C → C ⊆ U → ∃ i, C ⊆ K i := by
  intro P U hU
  refine ⟨fun i => closedBall (0 : Euclid P) ((i : ℝ) + 1) ∩ ⋂ y ∈ Uᶜ, {x | 1 / ((i : ℝ) + 1) ≤ dist x y},
    fun i => ?_, fun i => ?_, fun C hC hCU => ?_⟩
  · exact (isCompact_closedBall _ _).inter_right
      (isClosed_biInter fun y _ => isClosed_le continuous_const (continuous_id.dist continuous_const))
  · -- `x ∉ U` would give `1 / (i + 1) ≤ dist x x = 0`
    intro x hx
    by_contra hxU
    have h : 1 / ((i : ℝ) + 1) ≤ dist x x := mem_iInter₂.1 hx.2 x hxU
    rw [dist_self] at h
    have : (0 : ℝ) < 1 / ((i : ℝ) + 1) := by positivity
    linarith
  · obtain ⟨δ, hδ, hδU⟩ := hC.exists_thickening_subset_open hU hCU
    obtain ⟨R, hR⟩ := hC.isBounded.subset_closedBall (0 : Euclid P)
    obtain ⟨N, hN⟩ := exists_nat_one_div_lt hδ
    obtain ⟨M, hM⟩ := exists_nat_ge R
    have hNi : (N : ℝ) ≤ (max N M : ℕ) := by exact_mod_cast le_max_left N M
    have hMi : (M : ℝ) ≤ (max N M : ℕ) := by exact_mod_cast le_max_right N M
    refine ⟨max N M, fun x hx => ⟨?_, mem_iInter₂.2 fun y hy => ?_⟩⟩
    · have hxR := mem_closedBall.1 (hR hx)
      rw [mem_closedBall]
      linarith
    · -- `y ∉ thickening δ C` gives `δ ≤ dist x y`
      have hxy : δ ≤ dist x y := by
        by_contra h
        exact hy (hδU (mem_thickening_iff.2 ⟨x, hx, by rw [dist_comm]; linarith⟩))
      have hle : 1 / (((max N M : ℕ) : ℝ) + 1) ≤ 1 / ((N : ℝ) + 1) :=
        one_div_le_one_div_of_le (by positivity) (by linarith)
      show 1 / (((max N M : ℕ) : ℝ) + 1) ≤ dist x y
      linarith
/-- `Λⁿ(ℝᴾ)` is finite-dimensional: `α ↦ (α(e_{I(1)}, …, e_{I(n)}))_{I : Fin n → Fin P}` is a linear
map into the finite-dimensional space `(Fin n → Fin P) → ℝ`, injective because an alternating map
is determined by its values on tuples of basis vectors. -/
theorem Submission.dor_lmbs_tfa_covector_finiteDimensional : ∀ (P n : ℕ), FiniteDimensional ℝ (Covector (Euclid P) n) := by
  intro P n
  let e := (EuclideanSpace.basisFun (Fin P) ℝ).toBasis
  -- `L α = (α(e ∘ I))_I`
  let L : Covector (Euclid P) n →ₗ[ℝ] (Fin n → Fin P) → ℝ :=
    { toFun := fun α I => α fun k => e (I k)
      map_add' := fun α β => rfl
      map_smul' := fun c α => rfl }
  refine FiniteDimensional.of_injective L fun α β h => ?_
  apply ContinuousAlternatingMap.toAlternatingMap_injective
  exact e.ext_alternating fun v _ => congrFun h v

/-- Test forms supported in a fixed compact `K` have a countable subfamily `D` approximating every
such `ω` together with `dω`, uniformly on `ℝᴾ`.  The covector spaces are finite-dimensional
(`dor_lmbs_tfa_covector_finiteDimensional`), so `C(K, Λⁿ × Λⁿ⁺¹)` is second countable; pull back
a countable dense subset of the image of `X = {ω : spt ω ⊆ K}` under `Φ ω = (ω, dω)|_K`.  On `K`
the pointwise distances are at most the uniform distance; off `K` all four values vanish. -/
theorem Submission.dor_lmbs_tfa_fixed_support_dense : ∀ (P n : ℕ) (U K : Set (Euclid P)), IsCompact K → ∃ D : Set (TestFormOn U n), D.Countable ∧ (∀ η ∈ D, tsupport (η : DifferentialForm (Euclid P) n) ⊆ K) ∧ ∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ K → ∀ ε : ℝ, 0 < ε → ∃ η ∈ D, (∀ x, dist ((ω : DifferentialForm (Euclid P) n) x) ((η : DifferentialForm (Euclid P) n) x) < ε) ∧ ∀ x, dist (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) (exteriorDerivative (η : DifferentialForm (Euclid P) n) x) < ε := by
  intro P n U K hK
  -- Step 1: a form supported in `K` vanishes off `K`, and so does its exterior derivative
  have hzero : ∀ η : TestFormOn U n, tsupport (η : DifferentialForm (Euclid P) n) ⊆ K →
      ∀ x ∉ K, (η : DifferentialForm (Euclid P) n) x = 0 ∧
        exteriorDerivative (η : DifferentialForm (Euclid P) n) x = 0 := fun η hη x hx =>
    ⟨image_eq_zero_of_notMem_tsupport fun h => hx (hη h),
      image_eq_zero_of_notMem_tsupport fun h => hx (hη (tsupport_exteriorDerivative_subset _ h))⟩
  -- Step 2: `Λⁿ` and `Λⁿ⁺¹` are finite-dimensional, hence proper and second countable
  have := Submission.dor_lmbs_tfa_covector_finiteDimensional P n
  have := Submission.dor_lmbs_tfa_covector_finiteDimensional P (n + 1)
  have : ProperSpace (Covector (Euclid P) n) := FiniteDimensional.proper_real _
  have : ProperSpace (Covector (Euclid P) (n + 1)) := FiniteDimensional.proper_real _
  have : SecondCountableTopology (Covector (Euclid P) n) := secondCountable_of_proper
  have : SecondCountableTopology (Covector (Euclid P) (n + 1)) := secondCountable_of_proper
  -- Step 3: `K` is compact, so `C(K, Λⁿ × Λⁿ⁺¹)` carries the sup metric, and it is second
  -- countable: up to `ε`, `f` is determined by a modulus `j` of uniform continuity at scale `ε / 4`
  -- and by the indices, in a dense sequence `s`, of `ε / 4`-approximations of its values on a
  -- finite `1 / (j + 1)`-net `t j` of `K`
  have : CompactSpace K := isCompact_iff_compactSpace.mp hK
  have : SecondCountableTopology C(K, Covector (Euclid P) n × Covector (Euclid P) (n + 1)) := by
    refine Metric.secondCountable_of_countable_discretization
      (α := C(K, Covector (Euclid P) n × Covector (Euclid P) (n + 1))) fun ε hε => ?_
    obtain ⟨s, hs⟩ := TopologicalSpace.exists_dense_seq
      (Covector (Euclid P) n × Covector (Euclid P) (n + 1))
    choose r hr using fun y : Covector (Euclid P) n × Covector (Euclid P) (n + 1) =>
      hs.exists_dist_lt y (by positivity : (0 : ℝ) < ε / 4)
    have hnet : ∀ j : ℕ, ∃ t : Finset K, ∀ x : K, ∃ p ∈ t, dist x p < 1 / ((j : ℝ) + 1) := by
      intro j
      obtain ⟨t, -, ht⟩ := (isCompact_univ : IsCompact (univ : Set K)).elim_nhds_subcover
        (fun x => ball x (1 / ((j : ℝ) + 1))) fun x _ => ball_mem_nhds x (by positivity)
      exact ⟨t, fun x => by simpa using ht (mem_univ x)⟩
    choose t ht using hnet
    have hmod : ∀ f : C(K, Covector (Euclid P) n × Covector (Euclid P) (n + 1)), ∃ j : ℕ,
        ∀ x y : K, dist x y < 1 / ((j : ℝ) + 1) → dist (f x) (f y) < ε / 4 := by
      intro f
      obtain ⟨δ, hδ, hfδ⟩ := Metric.uniformContinuous_iff.1
        (CompactSpace.uniformContinuous_of_continuous f.continuous) (ε / 4) (by positivity)
      obtain ⟨j, hj⟩ := exists_nat_one_div_lt hδ
      exact ⟨j, fun x y hxy => hfδ (hxy.trans hj)⟩
    choose J hJ using hmod
    refine ⟨ℕ × List ℕ, inferInstance, fun f => (J f, (t (J f)).toList.map fun p => r (f p)),
      fun f g hfg => (ContinuousMap.dist_le hε.le).2 fun x => ?_⟩
    obtain ⟨hj, hl⟩ := Prod.mk.inj hfg
    rw [← hj] at hl
    -- `x` is `1 / (j + 1)`-close to a net point `p`, where `f p` and `g p` have a common index
    obtain ⟨p, hp, hxp⟩ := ht (J f) x
    have hrp : r (f p) = r (g p) := List.map_inj_left.1 hl p (Finset.mem_toList.2 hp)
    have h₁ := hJ f x p hxp
    have h₂ := hr (f p)
    have h₃ := hr (g p)
    have h₄ := hJ g x p (hj ▸ hxp)
    rw [hrp] at h₂
    rw [dist_comm] at h₃ h₄
    linarith [dist_triangle4 (f x) (f p) (s (r (g p))) (g x),
      dist_triangle (s (r (g p))) (g p) (g x)]
  -- Step 4: `Φ ω = (ω, dω)|_K`
  let Φ : TestFormOn U n → C(K, Covector (Euclid P) n × Covector (Euclid P) (n + 1)) := fun ω =>
    ⟨fun x => ((ω : DifferentialForm (Euclid P) n) x,
        exteriorDerivative (ω : DifferentialForm (Euclid P) n) x),
      (ω.property.1.1.continuous.prodMk
        (exteriorDerivative_isTestForm ω.property.1).1.continuous).comp continuous_subtype_val⟩
  let X : Set (TestFormOn U n) := {ω | tsupport (ω : DifferentialForm (Euclid P) n) ⊆ K}
  -- Step 5: a countable `T ⊆ Φ(X)` dense in `Φ(X)`, and a choice `σ` of preimages in `X`
  obtain ⟨T, hTc, hTX, hXT⟩ := TopologicalSpace.exists_countable_dense_subset (Φ '' X)
  have hT : ∀ t ∈ T, ∃ η, η ∈ X ∧ Φ η = t := fun t ht => hTX ht
  choose! σ hσX hσΦ using hT
  -- Step 6: `D = σ(T)` is countable and supported in `K`
  refine ⟨σ '' T, hTc.image σ, ?_, ?_⟩
  · rintro _ ⟨t, ht, rfl⟩
    exact hσX t ht
  -- Step 7: pick `t ∈ T` with `dist (Φ ω) t < ε` and put `η = σ t`
  intro ω hω ε hε
  obtain ⟨t, ht, hdist⟩ := (Metric.mem_closure_iff
    (α := C(K, Covector (Euclid P) n × Covector (Euclid P) (n + 1)))).1 (hXT ⟨ω, hω, rfl⟩) ε hε
  rw [← hσΦ t ht] at hdist
  have key : ∀ x, dist ((ω : DifferentialForm (Euclid P) n) x)
      ((σ t : DifferentialForm (Euclid P) n) x) < ε ∧
      dist (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x)
        (exteriorDerivative (σ t : DifferentialForm (Euclid P) n) x) < ε := by
    intro x
    by_cases hx : x ∈ K
    · -- (a) on `K`: both distances are at most `dist (Φ ω) (Φ η) < ε`
      have h := (ContinuousMap.dist_apply_le_dist (f := Φ ω) (g := Φ (σ t)) ⟨x, hx⟩).trans_lt hdist
      rw [Prod.dist_eq] at h
      exact ⟨(le_max_left _ _).trans_lt h, (le_max_right _ _).trans_lt h⟩
    · -- (b) off `K`: all four values vanish
      obtain ⟨h₁, h₂⟩ := hzero ω hω x hx
      obtain ⟨h₃, h₄⟩ := hzero (σ t) (hσX t ht) x hx
      rw [h₁, h₂, h₃, h₄, dist_self, dist_self]
      exact ⟨hε, hε⟩
  exact ⟨σ t, ⟨t, ht, rfl⟩, fun x => (key x).1, fun x => (key x).2⟩

/-- **A countable family of test forms, dense for `ω` and `dω` with common compact supports**
(Simon Ch. 6, proof of 4.5(2), p. 157: "a countable dense set of `ω ∈ 𝒟ⁿ(U)`").  Take the
compact exhaustion `Kᵢ` of `U` (`dor_lmbs_tfa_compact_exhaustion`) and, for each `i`, a
countable `Dᵢ` approximating every `ω` with `spt ω ⊆ Kᵢ` uniformly together with `dω`
(`dor_lmbs_tfa_fixed_support_dense`); then `D = ⋃ᵢ Dᵢ`.  Given `ω`, `spt ω ⊆ Kᵢ` for some `i`,
and `ωₖ ∈ Dᵢ` within `1/(k+1)` of `ω` and of `dω` gives `ωₖ → ω`, `dωₖ → dω` uniformly. -/
theorem Submission.dor_lmbs_testForm_countable_approx : ∀ (P n : ℕ) (U : Set (Euclid P)), IsOpen U → ∃ D : Set (TestFormOn U n), D.Countable ∧ ∀ ω : TestFormOn U n, ∃ (K : Set (Euclid P)) (ωs : ℕ → TestFormOn U n), IsCompact K ∧ K ⊆ U ∧ tsupport (ω : DifferentialForm (Euclid P) n) ⊆ K ∧ (∀ k, ωs k ∈ D) ∧ (∀ k, tsupport (ωs k : DifferentialForm (Euclid P) n) ⊆ K) ∧ TendstoUniformly (fun k x => (ωs k : DifferentialForm (Euclid P) n) x) (ω : DifferentialForm (Euclid P) n) atTop ∧ TendstoUniformly (fun k x => exteriorDerivative (ωs k : DifferentialForm (Euclid P) n) x) (exteriorDerivative (ω : DifferentialForm (Euclid P) n)) atTop := by
  intro P n U hU
  -- step 1: the compact exhaustion `Kᵢ` of `U`
  obtain ⟨K, hKc, hKU, hKex⟩ := Submission.dor_lmbs_tfa_compact_exhaustion P U hU
  -- steps 2–4: a countable `Dᵢ` for the test forms supported in `Kᵢ`
  choose D hDc hDK hDω using fun i =>
    Submission.dor_lmbs_tfa_fixed_support_dense P n U (K i) (hKc i)
  -- step 5: `D = ⋃ᵢ Dᵢ`
  refine ⟨⋃ i, D i, Set.countable_iUnion hDc, fun ω => ?_⟩
  -- step 6: `spt ω` is a compact subset of `U`, so it lies in some `Kᵢ`
  obtain ⟨i, hi⟩ :=
    hKex (tsupport (ω : DifferentialForm (Euclid P) n)) ω.property.1.2 ω.property.2
  -- `ωₖ ∈ Dᵢ` within `1/(k+1)` of `ω` and of `dω`
  choose ωs hωsD hωs using fun k : ℕ =>
    hDω i ω hi (1 / ((k : ℝ) + 1)) Nat.one_div_pos_of_nat
  have hsmall : ∀ ε : ℝ, 0 < ε → ∀ᶠ k : ℕ in atTop, 1 / ((k : ℝ) + 1) < ε := fun ε hε => by
    obtain ⟨N, hN⟩ := exists_nat_one_div_lt hε
    filter_upwards [Filter.eventually_ge_atTop N] with k hk
    exact (Nat.one_div_le_one_div hk).trans_lt hN
  refine ⟨K i, ωs, hKc i, hKU i, hi, fun k => Set.mem_iUnion.2 ⟨i, hωsD k⟩,
    fun k => hDK i (ωs k) (hωsD k), ?_, ?_⟩
  · rw [Metric.tendstoUniformly_iff]
    intro ε hε
    filter_upwards [hsmall ε hε] with k hk x
    exact ((hωs k).1 x).trans hk
  · rw [Metric.tendstoUniformly_iff]
    intro ε hε
    filter_upwards [hsmall ε hε] with k hk x
    exact ((hωs k).2 x).trans hk

/-- **From averaged slice identities to the pointwise slice identity** (Simon Ch. 6, end of the
proof of 4.5(2), with Remark 4.2).  If `s ↦ τ(R_s)(ω)` is locally integrable and its averages over
`[a, b]` are the cut-off integrals `∫_M θ γ_{a,b}(f) ⟨dω, ξ⟩ − ∫_{M'} θ' γ_{a,b}(f) ⟨ω, ξ'⟩`, then
for a.e. `t` and every `ω`, `τ(R_t)(ω) = ∫_{M ∩ {f < t}} θ ⟨dω, ξ⟩ − ∫_{M' ∩ {f < t}} θ' ⟨ω, ξ'⟩`.
For a fixed `ω` this follows from the Lebesgue differentiation theorem (left averages over
`[y, t]`, `y ↑ t`) and dominated convergence of the cut-offs `γ_{y,t}(f) → 1_{f < t}`; the null set
is made independent of `ω` with the countable family of `dor_lmbs_testForm_countable_approx`, and
the identity passes to all `ω` by dominated convergence along `ω_k → ω`, `dω_k → dω` uniformly with
supports in a common compact set. -/
theorem Submission.dor_lmbs_slice_identity_of_averages : ∀ (P n : ℕ) (U : Set (Euclid P)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (Rs : ℝ → IMRep U n) (f : Euclid P → ℝ), IsOpen U → Measurable f → (∀ ω : TestFormOn U n, LocallyIntegrable (fun s => (Rs s).action (ω : DifferentialForm (Euclid P) n))) → (∀ (ω : TestFormOn U n) (a b : ℝ), a < b → ∫ s in a..b, (Rs s).action (ω : DifferentialForm (Euclid P) n) = (b - a) * ((∫ x in RT.carrier, (RT.mult x : ℝ) * min 1 (max 0 ((b - f x) / (b - a))) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier, (RB.mult x : ℝ) * min 1 (max 0 ((b - f x) / (b - a))) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n])) → ∀ᵐ t, ∀ ω : TestFormOn U n, (Rs t).action (ω : DifferentialForm (Euclid P) n) = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n] := by
  intro P n U RT RB Rs f hU hf hloc havg
  -- Step 1: pairings with a triple `R = (N, φ, ζ)`.  A unit orientation has norm at most `1`, so
  -- `|φ ζ(β)| ≤ C φ 1_K` when `‖β‖ ≤ C` and `β = 0` off the compact `K ⊆ U`.
  have horient : ∀ (k : ℕ) (R : IMRep U k), ∀ᵐ x ∂(μHE[k].restrict R.carrier),
      ∀ α : Covector (Euclid P) k, ‖R.orient x α‖ ≤ ‖α‖ := by
    intro k R
    filter_upwards [R.orients] with x hx α
    obtain ⟨Q, -, τ, hτ, -, hξ⟩ := hx
    have hα : ‖α τ‖ ≤ ‖α‖ := by simpa [hτ.1] using α.le_opNorm τ
    rcases hξ with hξ | hξ <;> simpa [hξ α] using hα
  have hmult : ∀ (k : ℕ) (R : IMRep U k), Measurable fun x => (R.mult x : ℝ) :=
    fun k R => measurable_from_nat.comp R.measurable_mult
  have hmultK : ∀ (k : ℕ) (R : IMRep U k) (K : Set (Euclid P)), IsCompact K → K ⊆ U →
      Integrable (K.indicator fun x => (R.mult x : ℝ)) (μHE[k].restrict R.carrier) := by
    intro k R K hK hKU
    rw [integrable_indicator_iff hK.measurableSet, IntegrableOn,
      Measure.restrict_restrict hK.measurableSet, inter_comm]
    refine ⟨(hmult k R).aestronglyMeasurable, ?_⟩
    rw [hasFiniteIntegral_iff_ofReal (Eventually.of_forall fun x => Nat.cast_nonneg _)]
    simpa only [ENNReal.ofReal_natCast] using
      lt_top_iff_ne_top.2 (R.locallyIntegrable_mult K hK hKU)
  have hmeas : ∀ (k : ℕ) (R : IMRep U k) (β : Euclid P → Covector (Euclid P) k), Continuous β →
      AEStronglyMeasurable (fun x => (R.mult x : ℝ) * R.orient x (β x))
        (μHE[k].restrict R.carrier) :=
    fun k R β hβ => (hmult k R).aestronglyMeasurable.mul
      (Continuous.comp_aestronglyMeasurable₂
        (g := fun (L : MultiVector P k) (v : Covector (Euclid P) k) => L v)
        (continuous_fst.clm_apply continuous_snd) R.aestronglyMeasurable_orient
        hβ.aestronglyMeasurable)
  have hbound : ∀ (k : ℕ) (R : IMRep U k) (K : Set (Euclid P))
      (β : Euclid P → Covector (Euclid P) k) (C : ℝ), (∀ x, ‖β x‖ ≤ C) →
      (∀ x, x ∉ K → β x = 0) → ∀ᵐ x ∂(μHE[k].restrict R.carrier),
        ‖(R.mult x : ℝ) * R.orient x (β x)‖ ≤ C * K.indicator (fun x => (R.mult x : ℝ)) x := by
    intro k R K β C hC hK
    filter_upwards [horient k R] with x hx
    by_cases hxK : x ∈ K
    · rw [indicator_of_mem hxK, norm_mul, Real.norm_natCast, mul_comm C]
      exact mul_le_mul_of_nonneg_left ((hx _).trans (hC x)) (Nat.cast_nonneg _)
    · rw [indicator_of_notMem hxK, hK x hxK, map_zero, mul_zero, norm_zero, mul_zero]
  have hint : ∀ (k : ℕ) (R : IMRep U k) (K : Set (Euclid P))
      (β : Euclid P → Covector (Euclid P) k), IsCompact K → K ⊆ U → Continuous β →
      (∀ x, x ∉ K → β x = 0) →
      Integrable (fun x => (R.mult x : ℝ) * R.orient x (β x)) (μHE[k].restrict R.carrier) := by
    intro k R K β hK hKU hβ hβK
    obtain ⟨C, hC⟩ := hβ.bounded_above_of_compact_support (HasCompactSupport.intro hK hβK)
    exact ((hmultK k R K hK hKU).const_mul C).mono' (hmeas k R β hβ) (hbound k R K β C hC hβK)
  -- dominated convergence along `β_j → β` uniformly, with supports in a common compact `K`
  have hlim : ∀ (k : ℕ) (R : IMRep U k) (ν : Measure (Euclid P)) (K : Set (Euclid P))
      (βs : ℕ → Euclid P → Covector (Euclid P) k) (β : Euclid P → Covector (Euclid P) k),
      ν ≤ μHE[k].restrict R.carrier → IsCompact K → K ⊆ U → Continuous β →
      (∀ j, Continuous (βs j)) → (∀ x, x ∉ K → β x = 0) → (∀ j x, x ∉ K → βs j x = 0) →
      TendstoUniformly βs β atTop →
      Tendsto (fun j => ∫ x, (R.mult x : ℝ) * R.orient x (βs j x) ∂ν) atTop
        (𝓝 (∫ x, (R.mult x : ℝ) * R.orient x (β x) ∂ν)) := by
    intro k R ν K βs β hν hK hKU hβ hβs hβK hβsK hconv
    obtain ⟨C, hC⟩ := hβ.bounded_above_of_compact_support (HasCompactSupport.intro hK hβK)
    refine tendsto_integral_filter_of_dominated_convergence
      (fun x => (C + 1) * K.indicator (fun x => (R.mult x : ℝ)) x)
      (Eventually.of_forall fun j => (hmeas k R (βs j) (hβs j)).mono_measure hν) ?_
      (((hmultK k R K hK hKU).const_mul (C + 1)).mono_measure hν)
      (Eventually.of_forall fun x => tendsto_const_nhds.mul
        (((R.orient x).continuous.tendsto (β x)).comp (hconv.tendsto_at x)))
    filter_upwards [Metric.tendstoUniformly_iff.1 hconv 1 one_pos] with j hj
    refine ae_mono hν (hbound k R K (βs j) (C + 1) (fun x => ?_) (hβsK j))
    have hjx : ‖β x - βs j x‖ < 1 := by simpa [dist_eq_norm] using hj x
    calc ‖βs j x‖ = ‖β x - (β x - βs j x)‖ := by rw [sub_sub_cancel]
      _ ≤ ‖β x‖ + ‖β x - βs j x‖ := norm_sub_le _ _
      _ ≤ C + 1 := add_le_add (hC x) hjx.le
  -- Step 2: the cut-offs `γ_{y,t}(f) = min 1 (max 0 ((t - f) / (t - y)))` lie in `[0, 1]` and
  -- tend to `1_{f < t}` as `y ↑ t`.
  have hcut : ∀ (k : ℕ) (R : IMRep U k) (K : Set (Euclid P))
      (β : Euclid P → Covector (Euclid P) k) (t : ℝ), IsCompact K → K ⊆ U → Continuous β →
      (∀ x, x ∉ K → β x = 0) →
      Tendsto (fun y => ∫ x in R.carrier,
          (R.mult x : ℝ) * min 1 (max 0 ((t - f x) / (t - y))) * R.orient x (β x) ∂μHE[k])
        (𝓝[<] t)
        (𝓝 (∫ x in R.carrier ∩ {x | f x < t}, (R.mult x : ℝ) * R.orient x (β x) ∂μHE[k])) := by
    intro k R K β t hK hKU hβ hβK
    rw [← setIntegral_indicator
      (measurableSet_lt hf measurable_const : MeasurableSet {x | f x < t})]
    refine tendsto_integral_filter_of_dominated_convergence
      (fun x => ‖(R.mult x : ℝ) * R.orient x (β x)‖) (Eventually.of_forall fun y => ?_)
      (Eventually.of_forall fun y => Eventually.of_forall fun x => ?_)
      (hint k R K β hK hKU hβ hβK).norm (Eventually.of_forall fun x => ?_)
    · have hγ : Measurable fun x => min (1 : ℝ) (max 0 ((t - f x) / (t - y))) :=
        measurable_const.min (measurable_const.max ((measurable_const.sub hf).div_const _))
      have h := (hmeas k R β hβ).mul hγ.aestronglyMeasurable
      refine h.congr (Eventually.of_forall fun x => ?_)
      simp only [Pi.mul_apply]
      ring
    · have h0 : 0 ≤ min (1 : ℝ) (max 0 ((t - f x) / (t - y))) :=
        le_min zero_le_one (le_max_left _ _)
      rw [mul_right_comm, norm_mul, Real.norm_of_nonneg h0]
      exact mul_le_of_le_one_right (norm_nonneg _) (min_le_left _ _)
    · by_cases hx : f x < t
      · rw [indicator_of_mem (show x ∈ {x | f x < t} from hx)]
        refine tendsto_const_nhds.congr' ?_
        filter_upwards [Ioo_mem_nhdsLT hx] with y hy
        have h1 : 1 ≤ (t - f x) / (t - y) :=
          (one_le_div (sub_pos.2 hy.2)).2 (by linarith [hy.1])
        rw [max_eq_right (zero_le_one.trans h1), min_eq_left h1, mul_one]
      · rw [indicator_of_notMem (show x ∉ {x | f x < t} from hx)]
        refine tendsto_const_nhds.congr' ?_
        filter_upwards [self_mem_nhdsWithin] with y hy
        have h1 : (t - f x) / (t - y) ≤ 0 :=
          div_nonpos_of_nonpos_of_nonneg (by linarith [not_lt.1 hx]) (sub_pos.2 hy).le
        rw [max_eq_left h1, min_eq_right zero_le_one, mul_zero, zero_mul]
  -- Step 3: for a fixed `ω`, Lebesgue differentiation on `[y, t]`, `y ↑ t`, with (ii) for
  -- `(a, b) = (y, t)` identifies `τ(R_t)(ω)` with the limit of Step 2 off a null set.
  have hpt : ∀ ω : TestFormOn U n, ∀ᵐ t, (Rs t).action (ω : DifferentialForm (Euclid P) n) =
      (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) *
          RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) -
        ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) *
          RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n] := by
    intro ω
    have hω : IsTestForm (ω : DifferentialForm (Euclid P) n) ∧
        tsupport (ω : DifferentialForm (Euclid P) n) ⊆ U := ω.2
    have hK : IsCompact (tsupport (ω : DifferentialForm (Euclid P) n)) := hω.1.2
    filter_upwards
      [(IsUnifLocDoublingMeasure.vitaliFamily (volume : Measure ℝ) 1).ae_tendsto_average (hloc ω)]
      with t ht
    refine tendsto_nhds_unique ((ht.comp (Real.tendsto_Icc_vitaliFamily_left t)).congr' ?_)
      ((hcut (n + 1) RT _ _ t hK hω.2
        (ContDiff.continuous (exteriorDerivative_isTestForm hω.1).1)
        fun x hx => image_eq_zero_of_notMem_tsupport fun h =>
          hx (tsupport_exteriorDerivative_subset _ h)).sub
      (hcut n RB _ _ t hK hω.2 (ContDiff.continuous hω.1.1)
        fun x hx => image_eq_zero_of_notMem_tsupport hx))
    filter_upwards [self_mem_nhdsWithin] with y (hy : y < t)
    simp only [Function.comp_apply]
    rw [setAverage_eq, measureReal_def, Real.volume_Icc, ENNReal.toReal_ofReal (sub_pos.2 hy).le,
      integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hy.le, havg ω y t hy,
      smul_eq_mul, inv_mul_cancel_left₀ (sub_pos.2 hy).ne']
  -- Steps 4–6: one null set for the countable family `D`; every `ω` is a limit of forms in `D`
  -- with `ω_k → ω`, `dω_k → dω` uniformly and supports in one compact `K ⊆ U`.
  obtain ⟨D, hDc, hD⟩ := Submission.dor_lmbs_testForm_countable_approx P n U hU
  filter_upwards [(ae_ball_iff hDc).2 fun η _ => hpt η] with t ht ω
  obtain ⟨K, ωs, hK, hKU, hωK, hωsD, hωsK, hconv, hdconv⟩ := hD ω
  have hω : IsTestForm (ω : DifferentialForm (Euclid P) n) := ω.2.1
  have hωs : ∀ j, IsTestForm (ωs j : DifferentialForm (Euclid P) n) := fun j => (ωs j).2.1
  have hA := hlim n (Rs t) _ K (fun j => (ωs j : DifferentialForm (Euclid P) n)) _ le_rfl hK hKU
    (ContDiff.continuous hω.1) (fun j => ContDiff.continuous (hωs j).1)
    (fun x hx => image_eq_zero_of_notMem_tsupport fun h => hx (hωK h))
    (fun j x hx => image_eq_zero_of_notMem_tsupport fun h => hx (hωsK j h)) hconv
  have hB := (hlim (n + 1) RT (μHE[n + 1].restrict (RT.carrier ∩ {x | f x < t})) K
      (fun j => exteriorDerivative (ωs j : DifferentialForm (Euclid P) n)) _
      (Measure.restrict_mono inter_subset_left le_rfl) hK hKU
      (ContDiff.continuous (exteriorDerivative_isTestForm hω).1)
      (fun j => ContDiff.continuous (exteriorDerivative_isTestForm (hωs j)).1)
      (fun x hx => image_eq_zero_of_notMem_tsupport fun h =>
        hx (hωK (tsupport_exteriorDerivative_subset _ h)))
      (fun j x hx => image_eq_zero_of_notMem_tsupport fun h =>
        hx (hωsK j (tsupport_exteriorDerivative_subset _ h))) hdconv).sub
    (hlim n RB (μHE[n].restrict (RB.carrier ∩ {x | f x < t})) K
      (fun j => (ωs j : DifferentialForm (Euclid P) n)) _
      (Measure.restrict_mono inter_subset_left le_rfl) hK hKU (ContDiff.continuous hω.1)
      (fun j => ContDiff.continuous (hωs j).1)
      (fun x hx => image_eq_zero_of_notMem_tsupport fun h => hx (hωK h))
      (fun j x hx => image_eq_zero_of_notMem_tsupport fun h => hx (hωsK j h)) hconv)
  exact tendsto_nhds_unique hA (hB.congr fun j => (ht (ωs j) (hωsD j)).symm)
/-- Restricting an integer multiplicity triple `R = (C, θ, ξ)` to a Borel sub-carrier `C' ⊆ C`
with multiplicity `0 < θ' ≤ θ` on `C'`, keeping the orientation `ξ`, gives again a triple in `U`,
provided `Hⁿ`-a.e. point of `C'` inherits the approximate tangent spaces of `C` (Simon Ch. 6, 3.1).

Every field of `IMRep` for `(C', θ', ξ)` is inherited from `R`: `C' ⊆ C ⊆ U` is countably
rectifiable, `∫_{C' ∩ K} θ' dHⁿ ≤ ∫_{C' ∩ K} θ dHⁿ ≤ ∫_{C ∩ K} θ dHⁿ < ∞`, `Hⁿ⌞C' ≤ Hⁿ⌞C` carries
the measurability of `ξ`, and `R.orients` restricted to `C'` gives the orientation condition once
`T_x C = Q` is transferred to `T_x C' = Q`. -/
theorem Submission.regcomp_rim_sub_imrep : ∀ (P n : ℕ) (U C' : Set (Euclid P)) (R : IMRep U n) (θ' : Euclid P → ℕ), MeasurableSet C' → C' ⊆ R.carrier → Measurable θ' → (∀ x ∈ C', 0 < θ' x) → (∀ x ∈ C', θ' x ≤ R.mult x) → (∀ᵐ x ∂(μHE[n].restrict C'), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n R.carrier x Q → HasApproximateTangentSpaceAt n C' x Q) → ∃ R' : IMRep U n, R'.carrier = C' ∧ R'.mult = θ' ∧ R'.orient = R.orient := by
  intro P n U C' R θ' hC' hC'C hθ' hpos hle htan
  -- Step 6: `∫_{C' ∩ K} θ' ≤ ∫_{C' ∩ K} θ ≤ ∫_{C ∩ K} θ < ∞`
  have hint : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
      ∫⁻ x in C' ∩ K, (θ' x : ℝ≥0∞) ∂μHE[n] ≠ ∞ := by
    intro K hK hKU
    have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) :=
      (measurable_from_nat (f := fun k : ℕ => (k : ℝ≥0∞))).comp R.measurable_mult
    refine ne_top_of_le_ne_top (R.locallyIntegrable_mult K hK hKU) ?_
    calc ∫⁻ x in C' ∩ K, (θ' x : ℝ≥0∞) ∂μHE[n]
        ≤ ∫⁻ x in C' ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] :=
          setLIntegral_mono hθ fun x hx => by exact_mod_cast hle x hx.1
      _ ≤ ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] :=
          lintegral_mono_set (inter_subset_inter_left K hC'C)
  -- Step 7: `ξ` is a.e. strongly measurable for `Hⁿ⌞C' ≤ Hⁿ⌞C`
  have hmeas : AEStronglyMeasurable R.orient (μHE[n].restrict C') :=
    R.aestronglyMeasurable_orient.mono_measure (Measure.restrict_mono hC'C le_rfl)
  -- Step 8: restrict `R.orients` to `C'` and transfer the approximate tangent space
  have hor : ∀ᵐ x ∂(μHE[n].restrict C'), ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n C' x Q ∧ IsUnitOrientationOf (R.orient x) Q := by
    filter_upwards [ae_restrict_of_ae_restrict_of_subset hC'C R.orients, htan] with x hx hxt
    obtain ⟨Q, hQ, hξ⟩ := hx
    exact ⟨Q, hxt Q hQ, hξ⟩
  -- Step 9: assemble `R' = (C', θ', ξ)`
  exact ⟨IMRep.mk C' θ' R.orient hC' (hC'C.trans R.carrier_subset) (R.rectifiable.mono hC'C) hθ'
    hpos hint hmeas hor, rfl, rfl, rfl⟩
/-- **An integer multiplicity triple defines a current** (Simon 6.3.1 (‡)): for an `IMRep`
`R = (M, θ, ξ)` in `U`, `ω ↦ ∫_M θ⟨ω, ξ⟩ dHⁿ` is a current `T ∈ 𝒟ₙ(U)`, so `T = τ(M, θ, ξ)`.

Write `μ = Hⁿ⌞M`.  A unit orientation has `|ξ(x)(α)| = |α(τ₁, …, τₙ)| ≤ ‖α‖` (`τ` orthonormal),
the integrand is a.e. strongly measurable, and `1_K θ` is `μ`-integrable for compact `K ⊆ U`.
Hence for a test form `ω` the integrand is dominated by `sup|ω| · 1_{spt ω} θ`, so the functional
is defined and linear.  If `ωⱼ → 0` in `𝒟ⁿ(U)` with supports in the compact `K`, then
`|T(ωⱼ)| ≤ sup_K |ωⱼ| · ∫_K θ dμ → 0`. -/
theorem Submission.dtc_imrep_current : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∃ T : GeometricCurrentOn U n, R.Represents T := by
  intro P n U R
  set μ := μHE[n].restrict R.carrier with hμ
  -- (1) a unit orientation has norm at most one
  have hbound : ∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ ‖α‖ := by
    filter_upwards [R.orients] with x hx
    obtain ⟨Q, -, τ, hτ, -, hξ⟩ := hx
    intro α
    have hτn : ∀ i, ‖τ i‖ = 1 := fun i => hτ.1 i
    have hατ : |α τ| ≤ ‖α‖ := by
      have h := α.le_opNorm τ
      simp only [hτn, Finset.prod_const_one, mul_one, Real.norm_eq_abs] at h
      exact h
    rcases hξ with h | h
    · rw [h]; exact hατ
    · rw [h, abs_neg]; exact hατ
  have hθmeas : AEStronglyMeasurable (fun x => (R.mult x : ℝ)) μ :=
    ((measurable_from_nat (f := fun k : ℕ => (k : ℝ))).comp R.measurable_mult).aestronglyMeasurable
  -- (2) measurability of the integrand
  have hmeas : ∀ ω : DifferentialForm (Euclid P) n, Continuous ω →
      AEStronglyMeasurable (fun x => (R.mult x : ℝ) * R.orient x (ω x)) μ := by
    intro ω hω
    have h2 : AEStronglyMeasurable (fun x => R.orient x (ω x)) μ :=
      Continuous.comp_aestronglyMeasurable₂
        (g := fun (L : MultiVector P n) (α : Covector (Euclid P) n) => L α)
        (isBoundedBilinearMap_apply (𝕜 := ℝ) (E := Covector (Euclid P) n) (F := ℝ)).continuous
        R.aestronglyMeasurable_orient hω.aestronglyMeasurable
    exact hθmeas.mul h2
  -- (3) `θ` is integrable over compact subsets of `U`
  have hθK : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
      Integrable (K.indicator fun x => (R.mult x : ℝ)) μ := by
    intro K hK hKU
    rw [integrable_indicator_iff hK.isClosed.measurableSet]
    refine ⟨hθmeas.restrict, ?_⟩
    show ∫⁻ x, ‖(R.mult x : ℝ)‖ₑ ∂(μ.restrict K) < ∞
    rw [hμ, Measure.restrict_restrict hK.isClosed.measurableSet, inter_comm]
    simp only [Real.enorm_natCast]
    exact lt_top_iff_ne_top.mpr (R.locallyIntegrable_mult K hK hKU)
  -- (4) integrability of the integrand for test forms
  have hint : ∀ ω : TestFormOn U n,
      Integrable (fun x => (R.mult x : ℝ) * R.orient x ((ω : DifferentialForm (Euclid P) n) x))
        μ := by
    intro ω
    have hωc : Continuous (ω : DifferentialForm (Euclid P) n) := ω.property.1.1.continuous
    obtain ⟨C, hC⟩ := HasCompactSupport.exists_bound_of_continuous ω.property.1.2 hωc
    have hK : IsCompact (tsupport (ω : DifferentialForm (Euclid P) n)) := ω.property.1.2
    refine Integrable.mono' ((hθK _ hK ω.property.2).const_mul C) (hmeas _ hωc) ?_
    filter_upwards [hbound] with x hx
    by_cases hxK : x ∈ tsupport (ω : DifferentialForm (Euclid P) n)
    · rw [indicator_of_mem hxK, norm_mul, Real.norm_natCast, Real.norm_eq_abs]
      calc (R.mult x : ℝ) * |R.orient x ((ω : DifferentialForm (Euclid P) n) x)|
          ≤ (R.mult x : ℝ) * ‖(ω : DifferentialForm (Euclid P) n) x‖ := by
            gcongr; exact hx _
        _ ≤ (R.mult x : ℝ) * C := by gcongr; exact hC x
        _ = C * (R.mult x : ℝ) := mul_comm _ _
    · have h0 : (ω : DifferentialForm (Euclid P) n) x = 0 := image_eq_zero_of_notMem_tsupport hxK
      simp [h0, indicator_of_notMem hxK]
  -- (5) the linear functional `ω ↦ ∫_M θ ⟨ω, ξ⟩ dHⁿ`
  let L : TestFormOn U n →ₗ[ℝ] ℝ :=
    { toFun := fun ω => R.action (ω : DifferentialForm (Euclid P) n)
      map_add' := by
        intro ω η
        simp only [IMRep.action, Submodule.coe_add, Pi.add_apply, map_add, mul_add]
        exact integral_add (hint ω) (hint η)
      map_smul' := by
        intro c ω
        simp only [IMRep.action, Submodule.coe_smul, Pi.smul_apply, map_smul, smul_eq_mul,
          RingHom.id_apply]
        rw [← integral_const_mul]
        congr 1
        funext x
        ring }
  refine ⟨⟨L, ?_⟩, fun ω => rfl⟩
  -- (6) sequential continuity
  intro ωs hconv
  obtain ⟨K, hK, hKU, hsupp, -, hderiv⟩ := hconv
  have h0 := hderiv 0
  rw [Metric.tendstoUniformlyOn_iff] at h0
  set CK := ∫ x, K.indicator (fun x => (R.mult x : ℝ)) x ∂μ with hCKdef
  have hCK : 0 ≤ CK := integral_nonneg fun x => indicator_nonneg (fun _ _ => Nat.cast_nonneg _) x
  rw [Metric.tendsto_atTop]
  intro ε hε
  have hε' : 0 < ε / (CK + 1) := div_pos hε (by linarith)
  obtain ⟨N, hN⟩ := eventually_atTop.mp (h0 (ε / (CK + 1)) hε')
  refine ⟨N, fun j hj => ?_⟩
  have hptw : ∀ x ∈ K, ‖(ωs j : DifferentialForm (Euclid P) n) x‖ < ε / (CK + 1) := by
    intro x hx
    have h := hN j hj x hx
    rw [dist_comm, dist_eq_norm] at h
    simpa [norm_iteratedFDeriv_zero] using h
  rw [Real.dist_eq, sub_zero]
  have hle : |L (ωs j)| ≤ ∫ x, (ε / (CK + 1)) * K.indicator (fun x => (R.mult x : ℝ)) x ∂μ := by
    refine (Real.norm_eq_abs _).symm.le.trans (norm_integral_le_of_norm_le
      ((hθK K hK hKU).const_mul _) ?_)
    filter_upwards [hbound] with x hx
    by_cases hxK : x ∈ K
    · rw [indicator_of_mem hxK, norm_mul, Real.norm_natCast, Real.norm_eq_abs]
      calc (R.mult x : ℝ) * |R.orient x ((ωs j : DifferentialForm (Euclid P) n) x)|
          ≤ (R.mult x : ℝ) * ‖(ωs j : DifferentialForm (Euclid P) n) x‖ := by
            gcongr; exact hx _
        _ ≤ (R.mult x : ℝ) * (ε / (CK + 1)) := by gcongr; exact (hptw x hxK).le
        _ = ε / (CK + 1) * (R.mult x : ℝ) := mul_comm _ _
    · have h0 : (ωs j : DifferentialForm (Euclid P) n) x = 0 :=
        image_eq_zero_of_notMem_tsupport (fun h => hxK (hsupp j h))
      simp [h0, indicator_of_notMem hxK]
  rw [integral_const_mul, ← hCKdef] at hle
  calc |L (ωs j)| ≤ ε / (CK + 1) * CK := hle
    _ < ε := by
      rw [div_mul_eq_mul_div, div_lt_iff₀ (by linarith)]
      nlinarith
/-- **Algebra of unit orientations** (Simon 6.1.1, 6.1.7, 6.2.2): for `n`-vectors on `ℝᴾ`,
(a) two unit orientations `ξ`, `ξ'` of the same subspace `T` agree up to sign, `ξ' = ±ξ`;
(b) a unit orientation `ξ` satisfies `|ξ(β)| ≤ ‖β‖` for every `n`-covector `β`;
(c) if `A : ℝⁿ → ℝᴾ` is injective, then `J_A = det(⟨Aeₖ, Aeₗ⟩)^{1/2} > 0` and
`J_A⁻¹ A_#e : β ↦ J_A⁻¹ β(Ae₁, …, Aeₙ)` is a unit orientation of `range A`;
(d) if `A` is not injective, then `β(Ae₁, …, Aeₙ) = 0` for every `n`-covector `β`.
For an orthonormal `τ` and `bⱼ ∈ span τ`, with `M = (⟨τᵢ, bⱼ⟩)`, `α(b) = det M · α(τ)` (expand
`α` in the basis `τ` of `span τ`) and `det(⟨bₖ, bₗ⟩) = (det M)²` (Parseval).  Two orthonormal
frames of `T` therefore differ by `det M = ±1`; for injective `A`, a Gram–Schmidt frame `τ` of
`range A` gives an invertible `M` and `J_A = |det M|`; a non-injective `A` makes `(Aeₖ)` linearly
dependent. -/
theorem Submission.dtc_bc_lc_pfi_unitOrientation_algebra : ∀ (P n : ℕ), (∀ (ξ ξ' : MultiVector P n) (T : Submodule ℝ (Euclid P)), IsUnitOrientationOf ξ T → IsUnitOrientationOf ξ' T → ξ' = ξ ∨ ξ' = -ξ) ∧ (∀ (ξ : MultiVector P n) (T : Submodule ℝ (Euclid P)), IsUnitOrientationOf ξ T → ∀ β : Covector (Euclid P) n, |ξ β| ≤ ‖β‖) ∧ (∀ A : Euclid n →L[ℝ] Euclid P, Injective A → 0 < Real.sqrt (Matrix.det (Matrix.of fun k l : Fin n => inner ℝ (A (EuclideanSpace.single k 1)) (A (EuclideanSpace.single l 1)))) ∧ IsUnitOrientationOf ((Real.sqrt (Matrix.det (Matrix.of fun k l : Fin n => inner ℝ (A (EuclideanSpace.single k 1)) (A (EuclideanSpace.single l 1)))))⁻¹ • ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (fun k : Fin n => A (EuclideanSpace.single k 1))) (LinearMap.range (A : Euclid n →ₗ[ℝ] Euclid P))) ∧ ∀ A : Euclid n →L[ℝ] Euclid P, ¬ Injective A → ∀ β : Covector (Euclid P) n, β (fun k : Fin n => A (EuclideanSpace.single k 1)) = 0 := by
  intro P n
  -- Step 1 (expansion): for orthonormal `τ` and `bⱼ ∈ span τ`, `α(b) = det(⟨τᵢ, bⱼ⟩) α(τ)`
  have hE : ∀ (τ b : Fin n → Euclid P), Orthonormal ℝ τ →
      (∀ j, b j ∈ Submodule.span ℝ (Set.range τ)) → ∀ α : Covector (Euclid P) n,
        α b = (Matrix.of fun i j => inner ℝ (τ i) (b j)).det * α τ := by
    intro τ b hτ hb α
    set L := Submodule.span ℝ (Set.range τ)
    -- `τ` is a basis `e` of `L`
    let e : Module.Basis (Fin n) ℝ L := Module.Basis.span hτ.linearIndependent
    have he : ∀ i, (e i : Euclid P) = τ i := fun i => by
      rw [Module.Basis.span_apply hτ.linearIndependent i]
    -- the restriction `α_L` of `α` to `L`
    let αL : L [⋀^Fin n]→ₗ[ℝ] ℝ := α.toAlternatingMap.compLinearMap L.subtype
    let b' : Fin n → L := fun j => ⟨b j, hb j⟩
    have h1 : α b = αL b' := rfl
    have h2 : α τ = αL e := by
      show α τ = α (fun i => (e i : Euclid P))
      congr 1
      funext i
      exact (he i).symm
    -- coordinates of `b'` in `e` are the inner products with `τ`
    have hrepr : ∀ i j, e.repr (b' j) i = inner ℝ (τ i) (b j) := by
      intro i j
      have hs : (b j : Euclid P) = ∑ l, e.repr (b' j) l • τ l := by
        have := congrArg (Subtype.val) (e.sum_repr (b' j))
        simp only [Submodule.coe_sum, Submodule.coe_smul, he] at this
        exact this.symm
      rw [hs, hτ.inner_right_fintype]
    have hmat : e.toMatrix b' = Matrix.of fun i j => inner ℝ (τ i) (b j) := by
      ext i j
      rw [Module.Basis.toMatrix_apply, hrepr, Matrix.of_apply]
    -- `α_L = α_L(e) • det_e`
    have h3 : αL b' = αL e * e.det b' := by
      conv_lhs => rw [AlternatingMap.eq_smul_basis_det e αL]
      rfl
    rw [h1, h2, h3, Module.Basis.det_apply, hmat, mul_comm]
  -- Step 2 (coordinates): for orthonormal `τ` and `bⱼ ∈ span τ`, `bⱼ = Σᵢ ⟨τᵢ, bⱼ⟩ τᵢ`
  have hcoord : ∀ (τ b : Fin n → Euclid P), Orthonormal ℝ τ →
      (∀ j, b j ∈ Submodule.span ℝ (Set.range τ)) → ∀ j, b j = ∑ i, inner ℝ (τ i) (b j) • τ i := by
    intro τ b hτ hb j
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp (hb j)
    have hci : ∀ i, inner ℝ (τ i) (b j) = c i := fun i => by rw [← hc, hτ.inner_right_fintype]
    calc b j = ∑ i, c i • τ i := hc.symm
      _ = ∑ i, inner ℝ (τ i) (b j) • τ i := Finset.sum_congr rfl fun i _ => by rw [hci i]
  -- Step 3 (Parseval): `(⟨bₖ, bₗ⟩) = MᵀM` for `M = (⟨τᵢ, bⱼ⟩)`, so `det(⟨bₖ, bₗ⟩) = (det M)²`
  have hG : ∀ (τ b : Fin n → Euclid P), Orthonormal ℝ τ →
      (∀ j, b j ∈ Submodule.span ℝ (Set.range τ)) →
        (Matrix.of fun k l => inner ℝ (b k) (b l)).det =
          (Matrix.of fun i j => inner ℝ (τ i) (b j)).det ^ 2 := by
    intro τ b hτ hb
    have hmat : (Matrix.of fun k l => inner ℝ (b k) (b l)) =
        (Matrix.of fun i j => inner ℝ (τ i) (b j)).transpose *
          Matrix.of fun i j => inner ℝ (τ i) (b j) := by
      ext k l
      rw [Matrix.mul_apply, Matrix.of_apply]
      conv_lhs => rw [hcoord τ b hτ hb k]
      rw [sum_inner]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [real_inner_smul_left, Matrix.transpose_apply, Matrix.of_apply, Matrix.of_apply]
    rw [hmat, Matrix.det_mul, Matrix.det_transpose, sq]
  -- Step 4: the standard basis `eₖ = single k 1` of `ℝⁿ` is independent and spanning
  have he_fun : ⇑(EuclideanSpace.basisFun (Fin n) ℝ).toBasis =
      fun k : Fin n => (EuclideanSpace.single k 1 : Euclid n) := by
    rw [OrthonormalBasis.coe_toBasis]
    funext k
    exact EuclideanSpace.basisFun_apply (Fin n) ℝ k
  have he_li : LinearIndependent ℝ (fun k : Fin n => (EuclideanSpace.single k 1 : Euclid n)) := by
    have := (EuclideanSpace.basisFun (Fin n) ℝ).toBasis.linearIndependent
    rwa [he_fun] at this
  have he_span :
      Submodule.span ℝ (Set.range fun k : Fin n => (EuclideanSpace.single k 1 : Euclid n)) = ⊤ := by
    have := (EuclideanSpace.basisFun (Fin n) ℝ).toBasis.span_eq
    rwa [he_fun] at this
  refine ⟨?_, ?_, ?_, ?_⟩
  · -- (a) `τ'` lies in `span τ`, so `α(τ') = det O · α(τ)` with `(det O)² = det 1 = 1`
    rintro ξ ξ' T ⟨τ, hτ, hτT, hξ⟩ ⟨τ', hτ', hτ'T, hξ'⟩
    have hmem : ∀ j, τ' j ∈ Submodule.span ℝ (Set.range τ) := fun j => by
      rw [hτT, ← hτ'T]
      exact Submodule.subset_span ⟨j, rfl⟩
    obtain ⟨d, hexp, hd⟩ : ∃ d : ℝ, (∀ α : Covector (Euclid P) n, α τ' = d * α τ) ∧ d ^ 2 = 1 := by
      refine ⟨_, hE τ τ' hτ hmem, ?_⟩
      rw [← hG τ τ' hτ hmem]
      have h1 : (Matrix.of fun k l => inner ℝ (τ' k) (τ' l)) = 1 := by
        ext k l
        rw [Matrix.of_apply, Matrix.one_apply]
        exact orthonormal_iff_ite.mp hτ' k l
      rw [h1, Matrix.det_one]
    -- the signs `s, s' = ±1` of `ξ = s τ` and `ξ' = s' τ'`
    obtain ⟨s, hs, hξs⟩ : ∃ s : ℝ, s * s = 1 ∧ ∀ α, ξ α = s * α τ := by
      rcases hξ with h | h
      · exact ⟨1, one_mul 1, fun α => by rw [h, one_mul]⟩
      · exact ⟨-1, by norm_num, fun α => by rw [h, neg_one_mul]⟩
    obtain ⟨s', hs', hξs'⟩ : ∃ s : ℝ, s * s = 1 ∧ ∀ α, ξ' α = s * α τ' := by
      rcases hξ' with h | h
      · exact ⟨1, one_mul 1, fun α => by rw [h, one_mul]⟩
      · exact ⟨-1, by norm_num, fun α => by rw [h, neg_one_mul]⟩
    -- `ξ' = c ξ` with `c = s' · det O · s` and `c² = 1`
    have hc : ∀ α : Covector (Euclid P) n, ξ' α = (s' * d * s) * ξ α := by
      intro α
      rw [hξs' α, hexp α, hξs α]
      linear_combination (-(s' * d * α τ)) * hs
    have hc1 : (s' * d * s) * (s' * d * s) = 1 := by
      linear_combination (s' * s' * d ^ 2) * hs + (s' * s') * hd + hs'
    rcases mul_self_eq_one_iff.mp hc1 with h | h
    · left
      exact ContinuousLinearMap.ext fun α => by rw [hc α, h, one_mul]
    · right
      exact ContinuousLinearMap.ext fun α => by rw [hc α, h, neg_apply, neg_one_mul]
  · -- (b) `|ξ(β)| = |β(τ)| ≤ ‖β‖ ∏ᵢ ‖τᵢ‖ = ‖β‖`
    rintro ξ T ⟨τ, hτ, -, hξ⟩ β
    have h1 : |β τ| ≤ ‖β‖ := by
      have h := β.le_opNorm τ
      rw [Finset.prod_eq_one fun i _ => hτ.1 i, mul_one, Real.norm_eq_abs] at h
      exact h
    rcases hξ with h | h
    · rw [h β]
      exact h1
    · rw [h β, abs_neg]
      exact h1
  · -- (c) a Gram–Schmidt frame `τ` of `range A = span (Aeₖ)`, and `M = (⟨τᵢ, Aeⱼ⟩)`
    intro A hA
    set v : Fin n → Euclid P := fun k => A (EuclideanSpace.single k 1) with hv_def
    have hv : LinearIndependent ℝ v :=
      he_li.map' (A : Euclid n →ₗ[ℝ] Euclid P) (LinearMap.ker_eq_bot.mpr hA)
    have hspan_v :
        Submodule.span ℝ (Set.range v) = LinearMap.range (A : Euclid n →ₗ[ℝ] Euclid P) := by
      rw [LinearMap.range_eq_map, ← he_span, Submodule.map_span, ← Set.range_comp]
      rfl
    obtain ⟨τ, hτ, hτspan⟩ : ∃ τ : Fin n → Euclid P, Orthonormal ℝ τ ∧
        Submodule.span ℝ (Set.range τ) = Submodule.span ℝ (Set.range v) :=
      ⟨InnerProductSpace.gramSchmidtNormed ℝ v, InnerProductSpace.gramSchmidtNormed_orthonormal hv,
        by rw [InnerProductSpace.span_gramSchmidtNormed_range, InnerProductSpace.span_gramSchmidt]⟩
    have hvmem : ∀ j, v j ∈ Submodule.span ℝ (Set.range τ) := fun j => by
      rw [hτspan]
      exact Submodule.subset_span ⟨j, rfl⟩
    -- `M` is invertible: `M c = 0` gives `Σⱼ cⱼ vⱼ = Σᵢ (M c)ᵢ τᵢ = 0`, so `c = 0`
    have hMne : (Matrix.of fun i j => inner ℝ (τ i) (v j)).det ≠ 0 := by
      intro h0
      obtain ⟨c, hc0, hc⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr h0
      apply hc0
      funext j
      refine Fintype.linearIndependent_iff.mp hv c ?_ j
      calc ∑ j, c j • v j = ∑ j, c j • ∑ i, inner ℝ (τ i) (v j) • τ i :=
            Finset.sum_congr rfl fun j _ => by rw [← hcoord τ v hτ hvmem j]
        _ = ∑ i, (∑ j, inner ℝ (τ i) (v j) * c j) • τ i := by
            simp only [Finset.smul_sum, smul_smul, Finset.sum_smul]
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
            rw [mul_comm]
        _ = 0 := by
            refine Finset.sum_eq_zero fun i _ => ?_
            have := congrFun hc i
            simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.zero_apply] at this
            rw [this, zero_smul]
    obtain ⟨d, hd0, hexp, hgram⟩ : ∃ d : ℝ, d ≠ 0 ∧ (∀ α : Covector (Euclid P) n, α v = d * α τ) ∧
        (Matrix.of fun k l => inner ℝ (v k) (v l)).det = d ^ 2 :=
      ⟨_, hMne, hE τ v hτ hvmem, hG τ v hτ hvmem⟩
    -- `J_A = ((det M)²)^{1/2} = |det M| > 0` and `J_A⁻¹ β(Ae) = sign(det M) β(τ)`
    have hJ : Real.sqrt (Matrix.det (Matrix.of fun k l : Fin n =>
        inner ℝ (A (EuclideanSpace.single k 1)) (A (EuclideanSpace.single l 1)))) = |d| := by
      rw [← Real.sqrt_sq_eq_abs, ← hgram]
    rw [hJ]
    refine ⟨abs_pos.mpr hd0, τ, hτ, hτspan.trans hspan_v, ?_⟩
    have hval : ∀ α : Covector (Euclid P) n,
        (|d|⁻¹ • ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ v) α = (|d|⁻¹ * d) * α τ := by
      intro α
      rw [smul_apply, ContinuousAlternatingMap.apply_apply, smul_eq_mul, hexp α, mul_assoc]
    rcases lt_or_gt_of_ne hd0 with hneg | hpos
    · right
      intro α
      rw [hval, abs_of_neg hneg, inv_neg, neg_mul, inv_mul_cancel₀ hd0, neg_one_mul]
    · left
      intro α
      rw [hval, abs_of_pos hpos, inv_mul_cancel₀ hd0, one_mul]
  · -- (d) if `(Aeₖ)` were independent, `A` would be injective (`e` spans `ℝⁿ`)
    intro A hA β
    have hdep : ¬ LinearIndependent ℝ (fun k : Fin n => A (EuclideanSpace.single k 1)) := fun hli =>
      hA (LinearMap.injective_of_linearIndependent (f := (A : Euclid n →ₗ[ℝ] Euclid P)) he_span hli)
    exact β.toAlternatingMap.map_linearDependent _ hdep
/-- **Simon 6.2.11–2.12** for an integer multiplicity current (`spt T = spt μ_T`, where
`μ_T = θHⁿ⌞M` by 6.3.2(3)).  If `μ_T(B_r(x)) = 0`, then `Hⁿ(M ∩ B_r(x)) = 0` because `θ ≥ 1` on
`M`, so `T(ω) = ∫_M θ⟨ω, ξ⟩ dHⁿ = 0` whenever `spt ω ⊆ B_t(x)` (`t < r`); the relatively compact
ball `B_t(x)` then puts `x` in the zero region.  Conversely, if `x` lies in the zero region, then
`M_{B_r(x)}(T) = 0` for a small ball `B_r(x)`, and `Submission.rsd_massOn_eq_measure` (6.3.2(3))
gives `μ_T(B_r(x)) = M_{B_r(x)}(T) = 0`. -/
theorem Submission.rsd_mem_support_iff_measure_ball_pos : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ x : Euclid P, x ∈ T.support ↔ x ∈ U ∧ ∀ r : ℝ, 0 < r → 0 < R.measure (ball x r) := by
  intro P n U T R hU hR x
  constructor
  · -- (⇒) a ball of zero weight about `x` would put `x` in the zero region
    intro hx
    have hxU : x ∈ U := T.support_subset_domain hx
    refine ⟨hxU, fun r hr => pos_iff_ne_zero.mpr fun h0 => ?_⟩
    obtain ⟨s, hs, hsU⟩ := Metric.isOpen_iff.mp hU x hxU
    obtain ⟨t, ht, hts, htr⟩ : ∃ t : ℝ, 0 < t ∧ t < s ∧ t < r :=
      ⟨min s r / 2, by positivity, by linarith [min_le_left s r], by linarith [min_le_right s r]⟩
    -- `Hⁿ(M ∩ B_r(x)) ≤ ∫_{M ∩ B_r(x)} θ dHⁿ = μ_T(B_r(x)) = 0`, since `θ ≥ 1` on `M`
    have hnull : μHE[n] (R.carrier ∩ ball x r) = 0 := by
      rw [IMRep.measure, withDensity_apply _ measurableSet_ball,
        Measure.restrict_restrict measurableSet_ball] at h0
      apply nonpos_iff_eq_zero.mp
      calc μHE[n] (R.carrier ∩ ball x r)
          = ∫⁻ _ in ball x r ∩ R.carrier, (1 : ℝ≥0∞) ∂μHE[n] := by
            rw [setLIntegral_const, one_mul, inter_comm]
        _ ≤ ∫⁻ y in ball x r ∩ R.carrier, (R.mult y : ℝ≥0∞) ∂μHE[n] := by
            refine setLIntegral_mono (measurable_from_nat.comp R.measurable_mult) fun y hy => ?_
            have h1 : 1 ≤ R.mult y := R.mult_pos y hy.2
            show (1 : ℝ≥0∞) ≤ (R.mult y : ℝ≥0∞)
            exact_mod_cast h1
        _ = 0 := h0
    -- `T` vanishes on `B_t(x)`: the integrand of `T(ω)` vanishes `Hⁿ`-a.e. on `M`
    have hvan : T.VanishesOn (ball x t) := by
      intro ω hω
      rw [hR ω, IMRep.action]
      apply integral_eq_zero_of_ae
      have hae : ∀ᵐ y ∂(μHE[n].restrict R.carrier), y ∉ ball x r := by
        rw [ae_restrict_iff' R.measurableSet_carrier]
        filter_upwards [measure_eq_zero_iff_ae_notMem.mp hnull] with y hy hyM hyr
        exact hy ⟨hyM, hyr⟩
      filter_upwards [hae] with y hy
      have hω0 : (ω : DifferentialForm (Euclid P) n) y = 0 :=
        image_eq_zero_of_notMem_tsupport fun h => hy (ball_subset_ball htr.le (hω h))
      simp [hω0]
    -- `B_t(x)` is open with compact closure `⊆ B̄_t(x) ⊆ B_s(x) ⊆ U`
    have hcl : closure (ball x t) ⊆ closedBall x t := closure_ball_subset_closedBall
    exact hx.2 ⟨ball x t, ⟨isOpen_ball,
      (isCompact_closedBall x t).of_isClosed_subset isClosed_closure hcl,
      hcl.trans ((closedBall_subset_ball hts).trans hsU), hvan⟩, mem_ball_self ht⟩
  · -- (⇐) if `x` lay in the zero region, a small ball about `x` would have zero mass
    rintro ⟨hxU, hpos⟩
    refine ⟨hxU, fun hxZ => ?_⟩
    obtain ⟨W, ⟨hWo, -, hWU, hWv⟩, hxW⟩ := hxZ
    obtain ⟨r, hr, hrW⟩ := Metric.isOpen_iff.mp hWo x hxW
    -- every form admissible for `M_{B_r(x)}(T)` is supported in `W`, so `T` kills it
    have hm0 : T.massOn (ball x r) = 0 := by
      apply nonpos_iff_eq_zero.mp
      apply sSup_le
      rintro _ ⟨ω, hω, rfl⟩
      show ENNReal.ofReal (T ω) ≤ 0
      rw [hWv ω (hω.1.trans hrW)]
      simp
    -- `μ_T(B_r(x)) = M_{B_r(x)}(T) = 0` (6.3.2(3)), contradicting `μ_T(B_r(x)) > 0`
    have heq : T.massOn (ball x r) = R.measure (ball x r) :=
      Submission.rsd_massOn_eq_measure P n U T R hU hR (ball x r) isOpen_ball
        (hrW.trans (subset_closure.trans hWU))
    exact (hpos r hr).ne' (heq.symm.trans hm0)
/-- Zero `n`-density of the excess `B ∖ A` (step 5 of the tangent-locality argument): if
`Hⁿ(A ∩ B̄_ρ(x)) ≤ Cρⁿ` for `0 < ρ < r₁`, `Hⁿ(B ∩ B̄_{r₀}(x)) < ∞`, and for every `ε > 0`
eventually `Hⁿ((B ∖ A) ∩ B̄_ρ(x)) ≤ ε Hⁿ(B ∩ B̄_ρ(x))`, then `ρ⁻ⁿ Hⁿ((B ∖ A) ∩ B̄_ρ(x)) → 0`.
Subadditivity and `ε = 1/2` give `Hⁿ(B ∩ B̄_ρ(x)) ≤ 2Cρⁿ` for small `ρ` (cancelling the finite
half), and then `ε = δ/(2C + 1)` gives `Hⁿ((B ∖ A) ∩ B̄_ρ(x)) ≤ δρⁿ`. -/
theorem Submission.rsdic_tl_excess_density_zero : ∀ (P n : ℕ) (A B : Set (Euclid P)) (x : Euclid P) (r₀ C r₁ : ℝ), 0 < r₀ → μHE[n] (B ∩ closedBall x r₀) ≠ ∞ → 0 < r₁ → (∀ ρ : ℝ, 0 < ρ → ρ < r₁ → μHE[n] (A ∩ closedBall x ρ) ≤ ENNReal.ofReal (C * ρ ^ n)) → (∀ ε : ℝ≥0∞, 0 < ε → ∀ᶠ ρ in 𝓝[>] (0 : ℝ), μHE[n] ((B \ A) ∩ closedBall x ρ) ≤ ε * μHE[n] (B ∩ closedBall x ρ)) → Tendsto (fun ρ : ℝ => μHE[n] ((B \ A) ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n) (𝓝[>] 0) (𝓝 0) := by
  intro P n A B x r₀ C r₁ hr₀ hfin hr₁ hA hBA
  -- Steps 1–3: eventually `Hⁿ(B ∩ B̄_ρ(x)) ≤ K ρⁿ` with `K = 2 ofReal(C)`
  set K : ℝ≥0∞ := 2 * ENNReal.ofReal C with hK
  have hB : ∀ᶠ ρ in 𝓝[>] (0 : ℝ), μHE[n] (B ∩ closedBall x ρ) ≤ K * ENNReal.ofReal ρ ^ n := by
    -- Step 1: eventually `0 < ρ < min r₀ r₁`, so `Hⁿ(B ∩ B̄_ρ(x)) ≤ Hⁿ(B ∩ B̄_{r₀}(x)) < ∞`
    filter_upwards [Ioo_mem_nhdsGT (lt_min hr₀ hr₁),
      hBA 2⁻¹ (ENNReal.inv_pos.2 ENNReal.ofNat_ne_top)] with ρ hρ he
    have hρ₀ : ρ ≤ r₀ := (hρ.2.trans_le (min_le_left _ _)).le
    have hρ₁ : ρ < r₁ := hρ.2.trans_le (min_le_right _ _)
    have hfinρ : μHE[n] (B ∩ closedBall x ρ) ≠ ∞ :=
      ne_top_of_le_ne_top hfin (measure_mono (inter_subset_inter_right B
        (closedBall_subset_closedBall hρ₀)))
    -- Step 2: subadditivity, `Hⁿ(B ∩ B̄_ρ) ≤ Hⁿ(A ∩ B̄_ρ) + Hⁿ((B ∖ A) ∩ B̄_ρ)`
    have hsub : μHE[n] (B ∩ closedBall x ρ) ≤
        μHE[n] (A ∩ closedBall x ρ) + μHE[n] ((B \ A) ∩ closedBall x ρ) := by
      refine (measure_mono ?_).trans (measure_union_le _ _)
      rintro y ⟨hyB, hyρ⟩
      by_cases hyA : y ∈ A
      · exact Or.inl ⟨hyA, hyρ⟩
      · exact Or.inr ⟨⟨hyB, hyA⟩, hyρ⟩
    -- Step 3: with `ε = 1/2`, cancelling the finite half gives `Hⁿ(B ∩ B̄_ρ)/2 ≤ Hⁿ(A ∩ B̄_ρ)`
    have hhalf : μHE[n] (B ∩ closedBall x ρ) / 2 ≤ μHE[n] (A ∩ closedBall x ρ) := by
      refine (ENNReal.add_le_add_iff_right (ENNReal.div_ne_top hfinρ two_ne_zero)).1 ?_
      rw [ENNReal.add_halves, ENNReal.div_eq_inv_mul]
      exact hsub.trans (add_le_add_right he _)
    calc μHE[n] (B ∩ closedBall x ρ)
        = μHE[n] (B ∩ closedBall x ρ) / 2 + μHE[n] (B ∩ closedBall x ρ) / 2 :=
          (ENNReal.add_halves _).symm
      _ ≤ μHE[n] (A ∩ closedBall x ρ) + μHE[n] (A ∩ closedBall x ρ) := add_le_add hhalf hhalf
      _ = 2 * μHE[n] (A ∩ closedBall x ρ) := (two_mul _).symm
      _ ≤ 2 * ENNReal.ofReal (C * ρ ^ n) := by gcongr; exact hA ρ hρ.1 hρ₁
      _ = K * ENNReal.ofReal ρ ^ n := by
          rw [ENNReal.ofReal_mul' (pow_nonneg hρ.1.le n), ENNReal.ofReal_pow hρ.1.le, hK,
            mul_assoc]
  -- Step 4: for `δ ∈ (0, ∞)`, `ε = δ/(K + 1)` gives `Hⁿ((B ∖ A) ∩ B̄_ρ) ≤ δρⁿ` eventually
  rw [ENNReal.tendsto_nhds_zero]
  intro δ hδ
  by_cases hδt : δ = ∞
  · exact Eventually.of_forall fun ρ => hδt ▸ le_top
  have hK1 : K + 1 ≠ ∞ :=
    ENNReal.add_ne_top.2 ⟨ENNReal.mul_ne_top ENNReal.ofNat_ne_top ENNReal.ofReal_ne_top,
      ENNReal.one_ne_top⟩
  have hK0 : K + 1 ≠ 0 := by positivity
  filter_upwards [hB, hBA _ (ENNReal.div_pos hδ.ne' hK1)] with ρ hρB hρe
  refine ENNReal.div_le_of_le_mul ?_
  calc μHE[n] ((B \ A) ∩ closedBall x ρ) ≤ δ / (K + 1) * μHE[n] (B ∩ closedBall x ρ) := hρe
    _ ≤ δ / (K + 1) * ((K + 1) * ENNReal.ofReal ρ ^ n) := by
        gcongr
        exact hρB.trans (by gcongr; exact le_self_add)
    _ = δ * ENNReal.ofReal ρ ^ n := by rw [← mul_assoc, ENNReal.div_mul_cancel hK0 hK1]
/-- Scaling of `Hⁿ` under the blow-up `η_{x,r}(z) = r⁻¹(z − x)`, `r > 0`:
`Hⁿ(η_{x,r}(S) ∩ B̄_R(0)) = r⁻ⁿ Hⁿ(S ∩ B̄_{rR}(x))`.  As `‖η_{x,r}(z)‖ = r⁻¹‖z − x‖`, the left side
is `Hⁿ(η_{x,r}(S ∩ B̄_{rR}(x)))`; and `η_{x,r}` is the homothety of centre `x` and ratio `r⁻¹`,
which multiplies `Hⁿ` by `‖r⁻¹‖₊ⁿ = r⁻ⁿ`, followed by the translation by `−x`, an isometry. -/
theorem Submission.rsdic_tl_blowUp_measure_scaling : ∀ (P n : ℕ) (x : Euclid P) (r R : ℝ) (S : Set (Euclid P)), 0 < r → μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' S ∩ closedBall 0 R) = (ENNReal.ofReal r)⁻¹ ^ n * μHE[n] (S ∩ closedBall x (r * R)) := by
  intro P n x r R S hr
  -- `‖η(z)‖ = r⁻¹‖z − x‖`, since `r > 0`
  have hnorm : ∀ z : Euclid P,
      ‖Poincare.SimonGMT.Chapter03.blowUpMap x r z‖ = r⁻¹ * ‖z - x‖ := by
    intro z
    rw [Poincare.SimonGMT.Chapter03.blowUpMap, norm_smul, Real.norm_eq_abs,
      abs_of_pos (inv_pos.mpr hr)]
  -- `η(S) ∩ B̄_R(0) = η(S ∩ B̄_{rR}(x))`
  have hset : Poincare.SimonGMT.Chapter03.blowUpMap x r '' S ∩ closedBall 0 R =
      Poincare.SimonGMT.Chapter03.blowUpMap x r '' (S ∩ closedBall x (r * R)) := by
    ext y
    constructor
    · rintro ⟨⟨z, hz, rfl⟩, hy⟩
      refine ⟨z, ⟨hz, ?_⟩, rfl⟩
      rw [mem_closedBall_zero_iff, hnorm] at hy
      rw [mem_closedBall, dist_eq_norm, ← mul_inv_cancel_left₀ hr.ne' ‖z - x‖]
      exact mul_le_mul_of_nonneg_left hy hr.le
    · rintro ⟨z, ⟨hz, hzx⟩, rfl⟩
      refine ⟨⟨z, hz, rfl⟩, ?_⟩
      rw [mem_closedBall, dist_eq_norm] at hzx
      rw [mem_closedBall_zero_iff, hnorm, ← inv_mul_cancel_left₀ hr.ne' R]
      exact mul_le_mul_of_nonneg_left hzx (inv_pos.mpr hr).le
  -- `η = τ ∘ h`: the homothety `h` of centre `x` and ratio `r⁻¹`, then the translation by `−x`
  have hcomp : Poincare.SimonGMT.Chapter03.blowUpMap x r =
      (fun y : Euclid P => y + -x) ∘ AffineMap.homothety x r⁻¹ := by
    funext z
    simp [Poincare.SimonGMT.Chapter03.blowUpMap, AffineMap.homothety_apply]
  -- `μ(η(T)) = μ(h(T)) = ‖r⁻¹‖₊ⁿ μ(T) = (ofReal r)⁻¹ⁿ μ(T)`
  have hscale : ∀ T : Set (Euclid P), μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' T) =
      (ENNReal.ofReal r)⁻¹ ^ n * μHE[n] T := by
    intro T
    rw [hcomp, Set.image_comp, (isometry_add_right (-x)).euclideanHausdorffMeasure_image,
      euclideanHausdorffMeasure_homothety_image n x (inv_ne_zero hr.ne') T, ENNReal.smul_def,
      smul_eq_mul, ENNReal.coe_pow, nnnorm_inv, ENNReal.coe_inv (nnnorm_ne_zero_iff.mpr hr.ne'),
      Real.nnnorm_of_nonneg hr.le, ← ENNReal.ofReal_eq_coe_nnreal hr.le]
  rw [hset, hscale]

/-- **Simon Ch. 3, Remark 1.5(2)** (locality of approximate tangent spaces): if `A ⊆ B` are Borel,
`Hⁿ(B ∩ B̄_{r₀}(x)) < ∞` and `Hⁿ((B ∖ A) ∩ B̄_ρ(x)) / ρⁿ → 0` as `ρ ↓ 0`, then `B` and `A` have
the same approximate tangent spaces at `x`.  If `f ∈ C_c` vanishes off `B̄_R(0)` and `|f| ≤ M`,
then for `0 < ρ < r₀/R` the difference `∫_{η_{x,ρ}(B)} f − ∫_{η_{x,ρ}(A)} f = ∫_{η_{x,ρ}(B ∖ A)} f`
is at most `M Hⁿ(η_{x,ρ}(B ∖ A) ∩ B̄_R(0)) = M ρ⁻ⁿ Hⁿ((B ∖ A) ∩ B̄_{ρR}(x))` in absolute value,
and this tends to `0`. -/
theorem Submission.rsdic_tl_tangent_iff_of_density_zero : ∀ (P n : ℕ) (A B : Set (Euclid P)) (x : Euclid P) (r₀ : ℝ), MeasurableSet A → MeasurableSet B → A ⊆ B → 0 < r₀ → μHE[n] (B ∩ closedBall x r₀) ≠ ∞ → Tendsto (fun ρ : ℝ => μHE[n] ((B \ A) ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n) (𝓝[>] 0) (𝓝 0) → ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q := by
  intro P n A B x r₀ hA hB hAB hr₀ hfin hdens Q
  -- Step 1: for `ρ ≠ 0`, `η_{x,ρ}` is injective and `η_{x,ρ}(S) = (y ↦ x + ρy)⁻¹(S)`
  have hinj : ∀ ρ : ℝ, ρ ≠ 0 → Injective (Poincare.SimonGMT.Chapter03.blowUpMap x ρ) := by
    intro ρ hρ a b hab
    exact sub_left_injective (smul_right_injective (Euclid P) (inv_ne_zero hρ) hab)
  have hmeas : ∀ ρ : ℝ, ρ ≠ 0 → ∀ S : Set (Euclid P), MeasurableSet S →
      MeasurableSet (Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' S) := by
    intro ρ hρ S hS
    have himage : Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' S =
        (fun y => x + ρ • y) ⁻¹' S := by
      ext y
      constructor
      · rintro ⟨z, hz, rfl⟩
        simpa [Poincare.SimonGMT.Chapter03.blowUpMap, smul_inv_smul₀ hρ] using hz
      · intro hy
        exact ⟨x + ρ • y, hy, by simp [Poincare.SimonGMT.Chapter03.blowUpMap, inv_smul_smul₀ hρ]⟩
    rw [himage]
    exact hS.preimage (by fun_prop)
  -- Steps 2–7: for every `f ∈ C_c`, `∫_{η_{x,ρ}(B)} f − ∫_{η_{x,ρ}(A)} f → 0`
  have key : ∀ f : CompactlySupportedContinuousMap (Euclid P) ℝ,
      Tendsto (fun ρ : ℝ =>
        (∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' B, f y ∂μHE[n]) -
          ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' A, f y ∂μHE[n]) (𝓝[>] 0) (𝓝 0) := by
    intro f
    -- Step 2: `f` vanishes off `B̄_R(0)` for some `R > 0`, and `|f| ≤ M`
    obtain ⟨R, hRpos, hout⟩ : ∃ R : ℝ, 0 < R ∧
        ∀ y : Euclid P, y ∉ closedBall (0 : Euclid P) R → f y = 0 := by
      obtain ⟨R₀, hR₀⟩ := f.hasCompactSupport.isCompact.isBounded.subset_closedBall 0
      exact ⟨max R₀ 1, lt_of_lt_of_le one_pos (le_max_right _ _), fun y hy =>
        image_eq_zero_of_notMem_tsupport fun hy' =>
          hy (closedBall_subset_closedBall (le_max_left _ _) (hR₀ hy'))⟩
    obtain ⟨M, hM⟩ := f.continuous.bounded_above_of_compact_support f.hasCompactSupport
    -- Step 3: `f` is integrable on `S` whenever `Hⁿ(S ∩ B̄_R(0)) < ∞`
    have hint : ∀ S : Set (Euclid P), μHE[n] (S ∩ closedBall 0 R) ≠ ∞ →
        IntegrableOn (fun y => f y) S μHE[n] := by
      intro S hS
      refine Integrable.mono' (g := (closedBall (0 : Euclid P) R).indicator fun _ => M) ?_
        f.continuous.aestronglyMeasurable (ae_of_all _ fun y => ?_)
      · rw [integrable_indicator_iff measurableSet_closedBall]
        refine integrableOn_const ?_
        rw [Measure.restrict_apply measurableSet_closedBall, Set.inter_comm]
        exact hS
      · by_cases hy : y ∈ closedBall (0 : Euclid P) R
        · rw [Set.indicator_of_mem hy]
          exact hM y
        · rw [Set.indicator_of_notMem hy, hout y hy, norm_zero]
    -- Steps 4–6 give `|∫_{η_{x,ρ}(B)} f − ∫_{η_{x,ρ}(A)} f| ≤ M Hⁿ(η_{x,ρ}(B ∖ A) ∩ B̄_R(0))` for
    -- `0 < ρ < r₀/R`; step 7 sends the bound to `0`
    refine squeeze_zero_norm' (a := fun ρ : ℝ => M *
      (μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' (B \ A) ∩ closedBall 0 R)).toReal)
      ?_ ?_
    · filter_upwards [Ioo_mem_nhdsGT (div_pos hr₀ hRpos)] with ρ hρ
      have hρ0 : 0 < ρ := hρ.1
      have hρR : ρ * R < r₀ := (lt_div_iff₀ hRpos).1 hρ.2
      -- Step 4: for `S ⊆ B`, `Hⁿ(η_{x,ρ}(S) ∩ B̄_R(0)) = ρ⁻ⁿ Hⁿ(S ∩ B̄_{ρR}(x)) < ∞`
      have hfinS : ∀ S ⊆ B,
          μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' S ∩ closedBall 0 R) ≠ ∞ := by
        intro S hS
        rw [Submission.rsdic_tl_blowUp_measure_scaling P n x ρ R S hρ0]
        exact ENNReal.mul_ne_top
          (ENNReal.pow_ne_top (ENNReal.inv_ne_top.2 (ENNReal.ofReal_pos.2 hρ0).ne'))
          (ne_top_of_le_ne_top hfin
            (measure_mono (inter_subset_inter hS (closedBall_subset_closedBall hρR.le))))
      -- Step 5: `∫_{η_{x,ρ}(B)} f − ∫_{η_{x,ρ}(A)} f = ∫_{η_{x,ρ}(B ∖ A)} f`
      have hsplit : (∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' B, f y ∂μHE[n]) -
          ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' A, f y ∂μHE[n] =
          ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' (B \ A), f y ∂μHE[n] := by
        rw [image_sdiff (hinj ρ hρ0.ne'), setIntegral_sdiff (hmeas ρ hρ0.ne' A hA)
          (hint _ (hfinS B subset_rfl)) (image_mono hAB)]
      -- Step 6: `f = 0` off `B̄_R(0)` and `|f| ≤ M`
      have hball : ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' (B \ A), f y ∂μHE[n] =
          ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' (B \ A) ∩ closedBall 0 R,
            f y ∂μHE[n] :=
        setIntegral_eq_of_subset_of_forall_sdiff_eq_zero (hmeas ρ hρ0.ne' _ (hB.diff hA))
          inter_subset_left fun y hy => hout y fun h => hy.2 ⟨hy.1, h⟩
      rw [hsplit, hball]
      exact norm_setIntegral_le_of_norm_le_const (lt_top_iff_ne_top.2 (hfinS _ sdiff_subset))
        fun y _ => hM y
    -- Step 7: `Hⁿ(η_{x,ρ}(B ∖ A) ∩ B̄_R(0)) = Rⁿ Hⁿ((B ∖ A) ∩ B̄_{ρR}(x)) / (ρR)ⁿ → 0`, by (†)
    -- along `ρ ↦ ρR`
    have hlin : Tendsto (fun ρ : ℝ => ρ * R) (𝓝[>] 0) (𝓝[>] 0) := by
      refine tendsto_nhdsWithin_iff.2 ⟨?_, ?_⟩
      · exact ((continuous_mul_const R).tendsto' 0 0 (zero_mul R)).mono_left nhdsWithin_le_nhds
      · filter_upwards [self_mem_nhdsWithin] with ρ (hρ : 0 < ρ)
        exact mul_pos hρ hRpos
    have hsmall : Tendsto (fun ρ : ℝ =>
        μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' (B \ A) ∩ closedBall 0 R))
        (𝓝[>] 0) (𝓝 0) := by
      have h := ENNReal.Tendsto.const_mul (hdens.comp hlin)
        (Or.inr (ENNReal.pow_ne_top ENNReal.ofReal_ne_top) :
          (0 : ℝ≥0∞) ≠ 0 ∨ ENNReal.ofReal R ^ n ≠ ∞)
      rw [mul_zero] at h
      refine h.congr' ?_
      filter_upwards [self_mem_nhdsWithin] with ρ (hρ : 0 < ρ)
      have hβ : ENNReal.ofReal R ^ n * (ENNReal.ofReal R ^ n)⁻¹ = 1 :=
        ENNReal.mul_inv_cancel (pow_ne_zero n (ENNReal.ofReal_pos.2 hRpos).ne')
          (ENNReal.pow_ne_top ENNReal.ofReal_ne_top)
      simp only [Function.comp_apply]
      rw [Submission.rsdic_tl_blowUp_measure_scaling P n x ρ R (B \ A) hρ,
        ENNReal.ofReal_mul hρ.le, mul_pow, ← ENNReal.inv_pow, div_eq_mul_inv,
        ENNReal.mul_inv (Or.inl (pow_ne_zero n (ENNReal.ofReal_pos.2 hρ).ne'))
          (Or.inl (ENNReal.pow_ne_top ENNReal.ofReal_ne_top))]
      calc ENNReal.ofReal R ^ n * (μHE[n] ((B \ A) ∩ closedBall x (ρ * R)) *
            ((ENNReal.ofReal ρ ^ n)⁻¹ * (ENNReal.ofReal R ^ n)⁻¹))
          = ENNReal.ofReal R ^ n * (ENNReal.ofReal R ^ n)⁻¹ *
            ((ENNReal.ofReal ρ ^ n)⁻¹ * μHE[n] ((B \ A) ∩ closedBall x (ρ * R))) := by ring
        _ = (ENNReal.ofReal ρ ^ n)⁻¹ * μHE[n] ((B \ A) ∩ closedBall x (ρ * R)) := by
          rw [hβ, one_mul]
    have h := ((ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp hsmall).const_mul M
    rwa [ENNReal.toReal_zero, mul_zero] at h
  -- Step 8: transfer the limits of Definition 1.4 in both directions
  constructor
  · rintro ⟨hdim, hconv⟩
    refine ⟨hdim, fun f => ?_⟩
    have h := (hconv f).sub (key f)
    rw [sub_zero] at h
    exact h.congr fun ρ => sub_sub_cancel _ _
  · rintro ⟨hdim, hconv⟩
    refine ⟨hdim, fun f => ?_⟩
    have h := (hconv f).add (key f)
    rw [add_zero] at h
    exact h.congr fun ρ => add_sub_cancel _ _
/-- **Simon Ch. 3, Remark 1.5(3)**: if `D` has an approximate tangent space at `x` and
`Hⁿ(D ∩ B̄_{r₀}(x)) < ∞`, then `Hⁿ(D ∩ B̄_ρ(x)) ≤ Cρⁿ` for all small `ρ > 0`.  Test the tangent
condition with `f = max(0, min(1, 2 − |y|)) ∈ C_c`: for `ρ ≤ r₀/2`, `f` is integrable on
`η_{x,ρ}(D)` (as `Hⁿ(η_{x,ρ}(D) ∩ B̄₂(0)) ≤ ρ⁻ⁿHⁿ(D ∩ B̄_{r₀}(x)) < ∞`), and
`ρ⁻ⁿHⁿ(D ∩ B̄_ρ(x)) ≤ Hⁿ(η_{x,ρ}(D) ∩ B̄₁(0)) ≤ ∫_{η_{x,ρ}(D)} f dHⁿ → ∫_Q f dHⁿ =: L`, so
`C = L + 1` works. -/
theorem Submission.rsdic_measure_closedBall_le_of_tangent : ∀ (P n : ℕ) (D : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)) (r₀ : ℝ), MeasurableSet D → 0 < r₀ → μHE[n] (D ∩ closedBall x r₀) ≠ ∞ → HasApproximateTangentSpaceAt n D x Q → ∃ C r₁ : ℝ, 0 < r₁ ∧ ∀ ρ : ℝ, 0 < ρ → ρ < r₁ → μHE[n] (D ∩ closedBall x ρ) ≤ ENNReal.ofReal (C * ρ ^ n) := by
  intro P n D x Q r₀ _ hr₀ hfin hT
  -- Step 1 (scaling): `Hⁿ(a + c • W) = |c|ⁿ Hⁿ(W)`, by translation invariance and homogeneity
  have hscale : ∀ (a : Euclid P) (c : ℝ), c ≠ 0 → ∀ W : Set (Euclid P),
      μHE[n] ((fun t => a + c • t) '' W) = ‖c‖₊ ^ n • μHE[n] W := by
    intro a c hc W
    have himg : (fun t => a + t) '' ((fun t => c • t) '' W) = (fun t => a + c • t) '' W :=
      Set.image_image _ _ _
    have hsm := Measure.euclideanHausdorffMeasure_smul₀ (E := Euclid P) n hc W
    rw [← Set.image_smul] at hsm
    rw [← himg, (isometry_add_left a).euclideanHausdorffMeasure_image, hsm]
  -- Step 2: the test function `f = max(0, min(1, 2 − |y|)) ∈ C_c`, `1_{B̄₁(0)} ≤ f ≤ 1_{B̄₂(0)}`
  have hout : ∀ y : Euclid P, y ∉ closedBall (0 : Euclid P) 2 → max 0 (min 1 (2 - ‖y‖)) = 0 := by
    intro y hy
    rw [mem_closedBall_zero_iff, not_le] at hy
    exact max_eq_left ((min_le_right _ _).trans (by linarith))
  let f : CompactlySupportedContinuousMap (Euclid P) ℝ :=
    ⟨⟨fun y => max 0 (min 1 (2 - ‖y‖)), by fun_prop⟩,
      HasCompactSupport.intro (isCompact_closedBall 0 2) hout⟩
  have hf0 : ∀ y, 0 ≤ f y := fun y => le_max_left _ _
  have hf1 : ∀ y, f y ≤ 1 := fun y => max_le zero_le_one (min_le_left _ _)
  have hfB : ∀ y ∈ closedBall (0 : Euclid P) 1, f y = 1 := by
    intro y hy
    rw [mem_closedBall_zero_iff] at hy
    show max 0 (min 1 (2 - ‖y‖)) = 1
    rw [min_eq_left (by linarith), max_eq_right zero_le_one]
  -- Step 5: choose `r₁` with `∫_{η_{x,ρ}(D)} f dHⁿ < L + 1` and `ρ < r₀/2` for `0 < ρ < r₁`
  set L := ∫ y in (Q : Set (Euclid P)), f y ∂μHE[n]
  have hev : ∀ᶠ ρ in 𝓝[>] (0 : ℝ),
      (∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' D, f y ∂μHE[n]) < L + 1 ∧
        ρ < r₀ / 2 :=
    ((hT.2 f).eventually_lt_const (lt_add_one L)).and
      (Filter.mem_of_superset (Ioo_mem_nhdsGT (half_pos hr₀)) fun ρ hρ => hρ.2)
  obtain ⟨r₁, hr₁, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1 hev
  refine ⟨L + 1, r₁, hr₁, fun ρ hρ hρr₁ => ?_⟩
  obtain ⟨hg, hρr₀⟩ := hsub ⟨hρ, hρr₁⟩
  set T := Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' D
  have hnorm : ∀ d : Euclid P, ‖d - x‖ = ρ * ‖ρ⁻¹ • (d - x)‖ := by
    intro d
    rw [norm_smul, norm_inv, Real.norm_of_nonneg hρ.le, mul_inv_cancel_left₀ hρ.ne']
  -- Step 3: `Hⁿ(η_{x,ρ}(D) ∩ B̄₂(0)) ≤ ρ⁻ⁿ Hⁿ(D ∩ B̄_{r₀}(x)) < ∞`, so `f` is integrable on
  -- `η_{x,ρ}(D)`
  have hTfin : μHE[n] (T ∩ closedBall 0 2) ≠ ∞ := by
    have hsubset : T ∩ closedBall 0 2 ⊆
        (fun t => -(ρ⁻¹ • x) + ρ⁻¹ • t) '' (D ∩ closedBall x r₀) := by
      rintro _ ⟨⟨d, hd, rfl⟩, hd2⟩
      refine ⟨d, ⟨hd, ?_⟩, ?_⟩
      · rw [mem_closedBall_zero_iff] at hd2
        rw [mem_closedBall, dist_eq_norm, hnorm d]
        have : ρ * ‖ρ⁻¹ • (d - x)‖ ≤ ρ * 2 := mul_le_mul_of_nonneg_left hd2 hρ.le
        linarith
      · simp only [Poincare.SimonGMT.Chapter03.blowUpMap, smul_sub]
        abel
    refine ne_top_of_le_ne_top ?_ (measure_mono hsubset)
    rw [hscale _ _ (inv_ne_zero hρ.ne'), ENNReal.smul_def, smul_eq_mul]
    exact ENNReal.mul_ne_top ENNReal.coe_ne_top hfin
  have hint : Integrable (fun y => f y) (μHE[n].restrict T) := by
    refine Integrable.mono' (g := (closedBall (0 : Euclid P) 2).indicator fun _ => (1 : ℝ)) ?_
      f.continuous.aestronglyMeasurable (ae_of_all _ fun y => ?_)
    · rw [integrable_indicator_iff measurableSet_closedBall]
      refine integrableOn_const ?_
      rw [Measure.restrict_apply measurableSet_closedBall, Set.inter_comm]
      exact hTfin
    · by_cases hy : y ∈ closedBall (0 : Euclid P) 2
      · rw [Set.indicator_of_mem hy, Real.norm_of_nonneg (hf0 y)]
        exact hf1 y
      · rw [Set.indicator_of_notMem hy, norm_le_zero_iff]
        exact hout y hy
  -- Step 4: `D ∩ B̄_ρ(x) ⊆ x + ρ • (η_{x,ρ}(D) ∩ B̄₁(0))` and
  -- `Hⁿ(η_{x,ρ}(D) ∩ B̄₁(0)) ≤ ∫_{η_{x,ρ}(D)} f dHⁿ < L + 1`
  have hsub1 : D ∩ closedBall x ρ ⊆ (fun t => x + ρ • t) '' (T ∩ closedBall 0 1) := by
    rintro d ⟨hd, hdx⟩
    refine ⟨ρ⁻¹ • (d - x), ⟨⟨d, hd, rfl⟩, ?_⟩, ?_⟩
    · rw [mem_closedBall, dist_eq_norm, hnorm d] at hdx
      rw [mem_closedBall_zero_iff]
      by_contra hlt
      rw [not_le] at hlt
      have : ρ * 1 < ρ * ‖ρ⁻¹ • (d - x)‖ := mul_lt_mul_of_pos_left hlt hρ
      linarith
    · simp only [smul_smul, mul_inv_cancel₀ hρ.ne', one_smul, add_sub_cancel]
  have hball : μHE[n] (T ∩ closedBall 0 1) ≤ ENNReal.ofReal (L + 1) :=
    calc μHE[n] (T ∩ closedBall 0 1)
        = ∫⁻ y, (closedBall (0 : Euclid P) 1).indicator 1 y ∂(μHE[n].restrict T) := by
          rw [lintegral_indicator_one measurableSet_closedBall,
            Measure.restrict_apply measurableSet_closedBall, Set.inter_comm]
      _ ≤ ∫⁻ y, ENNReal.ofReal (f y) ∂(μHE[n].restrict T) := by
          refine lintegral_mono fun y => ?_
          by_cases hy : y ∈ closedBall (0 : Euclid P) 1
          · rw [Set.indicator_of_mem hy, hfB y hy, Pi.one_apply, ENNReal.ofReal_one]
          · rw [Set.indicator_of_notMem hy]
            exact zero_le
      _ = ENNReal.ofReal (∫ y, f y ∂(μHE[n].restrict T)) :=
          (ofReal_integral_eq_lintegral_ofReal hint (ae_of_all _ hf0)).symm
      _ ≤ ENNReal.ofReal (L + 1) := ENNReal.ofReal_le_ofReal hg.le
  -- Step 6: `Hⁿ(D ∩ B̄_ρ(x)) ≤ ρⁿ Hⁿ(η_{x,ρ}(D) ∩ B̄₁(0)) ≤ (L + 1)ρⁿ`
  calc μHE[n] (D ∩ closedBall x ρ)
      ≤ μHE[n] ((fun t => x + ρ • t) '' (T ∩ closedBall 0 1)) := measure_mono hsub1
    _ = ‖ρ‖₊ ^ n • μHE[n] (T ∩ closedBall 0 1) := hscale _ _ hρ.ne' _
    _ ≤ ‖ρ‖₊ ^ n • ENNReal.ofReal (L + 1) := by
        rw [ENNReal.smul_def, ENNReal.smul_def, smul_eq_mul, smul_eq_mul]
        exact mul_le_mul_of_nonneg_left hball zero_le
    _ = ENNReal.ofReal ((L + 1) * ρ ^ n) := by
        rw [ENNReal.ofReal_mul' (pow_nonneg hρ.le n), ENNReal.ofReal_pow hρ.le, ENNReal.smul_def,
          smul_eq_mul, mul_comm, ENNReal.coe_pow, ← enorm_eq_nnnorm, Real.enorm_eq_ofReal hρ.le]

/-- **Simon Ch. 3, Remarks 1.5(2) and 1.8(1)**: if `A ⊆ B ⊆ U` are Borel and `Hⁿ(B ∩ K) < ∞` for
compact `K ⊆ U`, then for `Hⁿ`-a.e. `x ∈ A`, `B` and `A` have the same approximate tangent spaces
at `x`.  Off a `Hⁿ⌞A`-null set independent of `Q`, `Hⁿ((B ∖ A) ∩ B̄_ρ(x)) ≤ ε Hⁿ(B ∩ B̄_ρ(x))` for
small `ρ` (Besicovitch).  A tangent plane of `B` or of `A` at `x` gives
`Hⁿ(A ∩ B̄_ρ(x)) ≤ Cρⁿ` (Remark 1.5(3), using `A ⊆ B` in the first case), hence
`Hⁿ((B ∖ A) ∩ B̄_ρ(x)) = o(ρⁿ)`, and then the blow-up integrals of `B` and `A` have the same
limits. -/
theorem Submission.rsdic_ae_tangent_iff_of_subset : ∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q := by
  intro P n U A B hU hA hB hAB hBU hfin
  -- Steps 1–4: for `Hⁿ⌞A`-a.e. `x`, `x ∈ A` and the excess of `B` over `A` near `x` is eventually
  -- small relative to `Hⁿ(B ∩ B̄_ρ(x))`; the exceptional set does not depend on `Q`
  filter_upwards [Submission.rsdic_tl_ae_excess_le P n U A B hU hA hB hAB hBU hfin,
    ae_restrict_mem hA] with x hexc hxA Q
  -- a compact ball `B̄_{s/2}(x) ⊆ B_s(x) ⊆ U`, so `Hⁿ(B ∩ B̄_{s/2}(x)) < ∞`
  obtain ⟨s, hs, hsU⟩ := Metric.isOpen_iff.1 hU x (hBU (hAB hxA))
  have hr₀ : 0 < s / 2 := half_pos hs
  have hBfin : μHE[n] (B ∩ closedBall x (s / 2)) ≠ ∞ :=
    hfin _ (isCompact_closedBall x (s / 2)) ((closedBall_subset_ball (half_lt_self hs)).trans hsU)
  have hAB' : ∀ ρ : ℝ, μHE[n] (A ∩ closedBall x ρ) ≤ μHE[n] (B ∩ closedBall x ρ) :=
    fun ρ => measure_mono (inter_subset_inter_left _ hAB)
  -- Steps 5–7: a growth bound `Hⁿ(A ∩ B̄_ρ(x)) ≤ Cρⁿ` gives `Hⁿ((B ∖ A) ∩ B̄_ρ(x)) = o(ρⁿ)`, which
  -- forces equal approximate tangent spaces
  have key : ∀ C r₁ : ℝ, 0 < r₁ →
      (∀ ρ : ℝ, 0 < ρ → ρ < r₁ → μHE[n] (A ∩ closedBall x ρ) ≤ ENNReal.ofReal (C * ρ ^ n)) →
      (HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q) :=
    fun C r₁ hr₁ hgrowth =>
      Submission.rsdic_tl_tangent_iff_of_density_zero P n A B x (s / 2) hA hB hAB hr₀ hBfin
        (Submission.rsdic_tl_excess_density_zero P n A B x (s / 2) C r₁ hr₀ hBfin hr₁ hgrowth hexc)
        Q
  constructor
  · -- the growth bound for `B` passes to `A ⊆ B`
    intro hTB
    obtain ⟨C, r₁, hr₁, hgrowth⟩ :=
      Submission.rsdic_measure_closedBall_le_of_tangent P n B x Q (s / 2) hB hr₀ hBfin hTB
    exact (key C r₁ hr₁ fun ρ hρ hρr₁ => (hAB' ρ).trans (hgrowth ρ hρ hρr₁)).1 hTB
  · intro hTA
    obtain ⟨C, r₁, hr₁, hgrowth⟩ :=
      Submission.rsdic_measure_closedBall_le_of_tangent P n A x Q (s / 2) hA hr₀
        (ne_top_of_le_ne_top hBfin (hAB' (s / 2))) hTA
    exact (key C r₁ hr₁ hgrowth).2 hTA
/-- **The cylinder over a rectifiable set** (the carrier of `[[(0,1)]] × T`, Simon Ch. 6, 2.17–2.21
and the proof of 2.27): let `M ⊆ ℝᴾ` be Borel and countably `k`-rectifiable with `Hᵏ(M) < ∞`, and
let `ι(t, x) = (t, x₁, …, x_P)`.  There is a Borel `C ⊆ ι((0,1) × M)` which is countably
`(k+1)`-rectifiable, satisfies `Hᵏ⁺¹⌞C = ι_#(L¹⌞(0,1) ⊗ Hᵏ⌞M)`, and for `Hᵏ⁺¹`-a.e. `y ∈ C`, if `M`
has approximate tangent space `Q` at `(y₁, …, y_P)` then `C` has approximate tangent space
`ℝe₀ ⊕ Q` at `y`.  Cut `M` into bi-Lipschitz pieces `F i (B i)` up to an `Hᵏ`-null set and take
`C = ι((0,1) × ⋃ F i (B i))`, parametrized by `G i(b) = ι(b₀, F i(b₁, …, b_k))` on
`π⁻¹((0,1) × B i)`, `π(b) = (b₀, (b₁, …, b_k))`.  The Gram matrix of `DG i(b)` is
`diag(1, Gram DF i)`, so `JG i = JF i ∘ π₂`; the area formula for `G i` and for `F i`, the measure
preserving `π` and Tonelli give the measure identity.  The tangent planes come from the piece lemma
for `F i` on `M` and for `G i` on `C`, with `range DG i(b) = ℝe₀ ⊕ range DF i(π₂ b)`. -/
theorem Submission.dor_lmb_fcdp_cylinder : ∀ (P k : ℕ) (M : Set (Euclid P)), MeasurableSet M → CountablyRectifiable k M → μHE[k] M ≠ ∞ → ∃ C : Set (Euclid (P + 1)), MeasurableSet C ∧ C ⊆ (fun p : ℝ × Euclid P => (WithLp.toLp 2 (Fin.cons p.1 (WithLp.ofLp p.2) : Fin (P + 1) → ℝ) : Euclid (P + 1))) '' (Ioo (0 : ℝ) 1 ×ˢ M) ∧ CountablyRectifiable (k + 1) C ∧ μHE[k + 1].restrict C = ((volume.restrict (Ioo (0 : ℝ) 1)).prod (μHE[k].restrict M)).map (fun p : ℝ × Euclid P => (WithLp.toLp 2 (Fin.cons p.1 (WithLp.ofLp p.2) : Fin (P + 1) → ℝ) : Euclid (P + 1))) ∧ ∀ᵐ y ∂(μHE[k + 1].restrict C), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt k M (WithLp.toLp 2 (Fin.tail (WithLp.ofLp y)) : Euclid P) Q → HasApproximateTangentSpaceAt (k + 1) C y (Submodule.span ℝ (insert (EuclideanSpace.single (0 : Fin (P + 1)) (1 : ℝ)) ((fun v : Euclid P => (WithLp.toLp 2 (Fin.cons (0 : ℝ) (WithLp.ofLp v) : Fin (P + 1) → ℝ) : Euclid (P + 1))) '' (Q : Set (Euclid P))))) := by
  intro P k M hM hrect hfin
  -- `ι_n(t, x) = (t, x₁, …, x_n)` and `π_n(y) = (y₀, (y₁, …, y_n))`, mutually inverse linear maps
  have hι : ∀ n : ℕ, ∃ L : ℝ × Euclid n →L[ℝ] Euclid (n + 1), ∀ p, L p =
      (WithLp.toLp 2 (Fin.cons p.1 (WithLp.ofLp p.2) : Fin (n + 1) → ℝ) : Euclid (n + 1)) := by
    intro n
    refine ⟨LinearMap.toContinuousLinearMap
      { toFun := fun p =>
          (WithLp.toLp 2 (Fin.cons p.1 (WithLp.ofLp p.2) : Fin (n + 1) → ℝ) : Euclid (n + 1))
        map_add' := ?_
        map_smul' := ?_ }, fun p => rfl⟩
    · intro p q
      ext i
      refine Fin.cases ?_ (fun j => ?_) i <;> simp
    · intro c p
      ext i
      refine Fin.cases ?_ (fun j => ?_) i <;> simp
  have hπ : ∀ n : ℕ, ∃ L : Euclid (n + 1) →L[ℝ] ℝ × Euclid n, ∀ y,
      L y = (WithLp.ofLp y 0, (WithLp.toLp 2 (Fin.tail (WithLp.ofLp y)) : Euclid n)) := by
    intro n
    refine ⟨LinearMap.toContinuousLinearMap
      { toFun := fun y => (WithLp.ofLp y 0, (WithLp.toLp 2 (Fin.tail (WithLp.ofLp y)) : Euclid n))
        map_add' := ?_
        map_smul' := ?_ }, fun p => rfl⟩
    · intro p q
      ext <;> simp [Fin.tail]
    · intro c p
      ext <;> simp [Fin.tail]
  choose ιL hιL using hι
  choose πL hπL using hπ
  have hπι : ∀ n p, πL n (ιL n p) = p := by
    intro n p
    rw [hιL, hπL]
    simp
  have hιπ : ∀ n y, ιL n (πL n y) = y := by
    intro n y
    rw [hπL, hιL]
    simp
  have hinner : ∀ n p q, inner ℝ (ιL n p) (ιL n q) = p.1 * q.1 + inner ℝ p.2 q.2 := by
    intro n p q
    rw [hιL, hιL, PiLp.inner_apply, PiLp.inner_apply, Fin.sum_univ_succ]
    simp [mul_comm]
  have hnorm : ∀ n p, ‖ιL n p‖ ^ 2 = p.1 ^ 2 + ‖p.2‖ ^ 2 := by
    intro n p
    rw [← real_inner_self_eq_norm_sq, ← real_inner_self_eq_norm_sq, hinner, sq]
  have hιinj : ∀ n, Injective (ιL n) := fun n => LeftInverse.injective (hπι n)
  -- A1: `π_n` maps Lebesgue measure on `ℝⁿ⁺¹` to Lebesgue measure on `ℝ × ℝⁿ`
  have hπmp : ∀ n, MeasurePreserving (πL n) volume volume := by
    intro n
    have h := ((MeasurePreserving.id (volume : Measure ℝ)).prod
      (PiLp.volume_preserving_toLp (Fin n))).comp
      ((volume_preserving_piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) 0).comp
        (PiLp.volume_preserving_ofLp (Fin (n + 1))))
    convert h using 1
    funext y
    rw [hπL]
    simp [MeasurableEquiv.piFinSuccAbove_apply]
  have hπe0 : ∀ n, πL n (EuclideanSpace.single 0 1) = (1, 0) := by
    intro n
    rw [hπL]
    ext
    · simp
    · simp [Fin.tail]
  have hπes : ∀ n (j : Fin n),
      πL n (EuclideanSpace.single j.succ 1) = (0, EuclideanSpace.single j 1) := by
    intro n j
    rw [hπL]
    ext l
    · simp
    · simp [Fin.tail, PiLp.single_apply]
  -- the statement's `ι`, `J`, `ê₀` and `pr` in terms of `ι_P` and `π_P`
  have hιfun : (fun p : ℝ × Euclid P =>
      (WithLp.toLp 2 (Fin.cons p.1 (WithLp.ofLp p.2) : Fin (P + 1) → ℝ) : Euclid (P + 1))) =
      ιL P := funext fun p => (hιL P p).symm
  have hJfun : (fun v : Euclid P =>
      (WithLp.toLp 2 (Fin.cons (0 : ℝ) (WithLp.ofLp v) : Fin (P + 1) → ℝ) : Euclid (P + 1))) =
      fun v => ιL P (0, v) := funext fun v => (hιL P (0, v)).symm
  have he0 : (EuclideanSpace.single (0 : Fin (P + 1)) (1 : ℝ)) = ιL P (1, 0) := by
    rw [← hπe0, hιπ]
  have hpr : ∀ y : Euclid (P + 1),
      (WithLp.toLp 2 (Fin.tail (WithLp.ofLp y)) : Euclid P) = (πL P y).2 := fun y => by rw [hπL]
  rw [hιfun, hJfun, he0]
  simp only [hpr]
  -- B1: the bi-Lipschitz pieces `F i (B i)` of `M` (accepted `dpf_rectifiable_bilipschitz_pieces`)
  obtain ⟨F, B, m, hFL, hB, hm, hbi, hdiff, hFBm, hFBM, hdisj, hnull⟩ :=
    Submission.dpf_rectifiable_bilipschitz_pieces P k M hM hrect
  choose L hL using hFL
  have hFinj : ∀ i, InjOn (F i) (B i) := by
    intro i a ha a' ha' h
    have h1 := hbi i a ha a' ha'
    rw [h, sub_self, norm_zero] at h1
    have h2 : ‖a - a'‖ ≤ 0 := by nlinarith [norm_nonneg (a - a'), hm i]
    exact sub_eq_zero.mp (norm_le_zero_iff.mp h2)
  -- `A i = F i (B i)`, `C i = ι((0,1) × A i)`, `G i = ι ∘ (id × F i) ∘ π` on
  -- `Bh i = π⁻¹((0,1) × B i)`
  set A : ℕ → Set (Euclid P) := fun i => F i '' B i
  set C : ℕ → Set (Euclid (P + 1)) := fun i => ιL P '' (Ioo (0 : ℝ) 1 ×ˢ A i)
  set G : ℕ → Euclid (k + 1) → Euclid (P + 1) := fun i b => ιL P ((πL k b).1, F i (πL k b).2)
  set Bh : ℕ → Set (Euclid (k + 1)) := fun i => πL k ⁻¹' (Ioo (0 : ℝ) 1 ×ˢ B i)
  have hmeas_img : ∀ T : Set (ℝ × Euclid P), MeasurableSet T → MeasurableSet (ιL P '' T) :=
    fun T hT => hT.image_of_continuousOn_injOn (ιL P).continuous.continuousOn (hιinj P).injOn
  have hCm : ∀ i, MeasurableSet (C i) := fun i => hmeas_img _ (measurableSet_Ioo.prod (hFBm i))
  have hCU : ιL P '' (Ioo (0 : ℝ) 1 ×ˢ ⋃ i, A i) = ⋃ i, C i := by
    rw [prod_iUnion, image_iUnion]
  have hCdisj : Pairwise (Disjoint on C) := fun i j hij =>
    (disjoint_image_iff (hιinj P)).mpr (disjoint_prod.mpr (Or.inr (hdisj hij)))
  have hBhm : ∀ i, MeasurableSet (Bh i) := fun i =>
    (measurableSet_Ioo.prod (hB i)).preimage (πL k).continuous.measurable
  have hGC : ∀ i, G i '' Bh i = C i := by
    intro i
    ext y
    constructor
    · rintro ⟨b, hb, rfl⟩
      exact ⟨((πL k b).1, F i (πL k b).2), ⟨hb.1, mem_image_of_mem _ hb.2⟩, rfl⟩
    · rintro ⟨⟨t, x⟩, ⟨ht, u, hu, rfl⟩, rfl⟩
      refine ⟨ιL k (t, u), ?_, ?_⟩
      · show πL k (ιL k (t, u)) ∈ Ioo (0 : ℝ) 1 ×ˢ B i
        rw [hπι]
        exact ⟨ht, hu⟩
      · show ιL P ((πL k (ιL k (t, u))).1, F i (πL k (ιL k (t, u))).2) = ιL P (t, F i u)
        rw [hπι]
  -- A2: `G i` is Lipschitz
  have hGlip : ∀ i, ∃ K, LipschitzWith K (G i) := fun i =>
    ⟨_, (ιL P).lipschitzWith.comp ((LipschitzWith.prod_fst.comp (πL k).lipschitzWith).prodMk
      ((hL i).comp (LipschitzWith.prod_snd.comp (πL k).lipschitzWith)))⟩
  -- A3: `DG i(b) c = ι(c₀, DF i(π₂ b)(π₂ c))`, which is injective
  have hGd : ∀ i, ∀ b ∈ Bh i, HasFDerivAt (G i) ((ιL P).comp
      (((ContinuousLinearMap.id ℝ ℝ).prodMap (fderiv ℝ (F i) (πL k b).2)).comp (πL k))) b := by
    intro i b hb
    have h1 : HasFDerivAt (Prod.map (id : ℝ → ℝ) (F i))
        ((ContinuousLinearMap.id ℝ ℝ).prodMap (fderiv ℝ (F i) (πL k b).2)) (πL k b) :=
      HasFDerivAt.prodMap (πL k b) (hasFDerivAt_id _) (hdiff i _ hb.2).1.hasFDerivAt
    exact (ιL P).hasFDerivAt.comp b (h1.comp b (πL k).hasFDerivAt)
  have hDap : ∀ i b c, ((ιL P).comp (((ContinuousLinearMap.id ℝ ℝ).prodMap
      (fderiv ℝ (F i) (πL k b).2)).comp (πL k))) c =
      ιL P ((πL k c).1, fderiv ℝ (F i) (πL k b).2 (πL k c).2) := fun _ _ _ => rfl
  have hGdinj : ∀ i, ∀ b ∈ Bh i, Injective (fderiv ℝ (G i) b) := by
    intro i b hb c c' h
    rw [(hGd i b hb).fderiv, hDap, hDap] at h
    obtain ⟨h3, h4⟩ := Prod.mk.inj (hιinj P h)
    rw [← hιπ k c, ← hιπ k c']
    exact congrArg (ιL k) (Prod.ext h3 ((hdiff i _ hb.2).2 h4))
  -- A4: the Gram matrix of `DG i(b)` is `diag(1, Gram DF i(π₂ b))`, so `JG i(b) = JF i(π₂ b)`
  have hGJ : ∀ i, ∀ b ∈ Bh i, Real.sqrt (Matrix.det (Matrix.of fun a c : Fin (k + 1) =>
      inner ℝ (fderiv ℝ (G i) b (EuclideanSpace.single a 1))
        (fderiv ℝ (G i) b (EuclideanSpace.single c 1)))) =
      Real.sqrt (Matrix.det (Matrix.of fun a c : Fin k =>
        inner ℝ (fderiv ℝ (F i) (πL k b).2 (EuclideanSpace.single a 1))
          (fderiv ℝ (F i) (πL k b).2 (EuclideanSpace.single c 1)))) := by
    intro i b hb
    rw [(hGd i b hb).fderiv, Matrix.det_succ_row_zero, Fin.sum_univ_succ]
    simp only [Matrix.of_apply, hDap, hπe0, hπes, hinner, map_zero, inner_zero_left,
      inner_zero_right, Fin.succAbove_zero, mul_zero, zero_mul, add_zero, mul_one, Fin.val_zero,
      pow_zero, one_mul, Finset.sum_const_zero]
    congr 2
    ext a c
    simp only [Matrix.submatrix_apply, Matrix.of_apply, hπes, zero_mul, zero_add]
  -- B5(d): `range DG i(b) = span{ê₀} ⊔ J(range DF i(π₂ b))`
  have hGrange : ∀ i, ∀ b ∈ Bh i,
      LinearMap.range (fderiv ℝ (G i) b : Euclid (k + 1) →ₗ[ℝ] Euclid (P + 1)) =
      Submodule.span ℝ (insert (ιL P (1, 0)) ((fun v => ιL P (0, v)) ''
        (LinearMap.range (fderiv ℝ (F i) (πL k b).2 : Euclid k →ₗ[ℝ] Euclid P) :
          Set (Euclid P)))) := by
    intro i b hb
    rw [(hGd i b hb).fderiv]
    apply le_antisymm
    · rintro _ ⟨c, rfl⟩
      have hsplit : ιL P ((πL k c).1, fderiv ℝ (F i) (πL k b).2 (πL k c).2) =
          (πL k c).1 • ιL P (1, 0) + ιL P (0, fderiv ℝ (F i) (πL k b).2 (πL k c).2) := by
        rw [← map_smul, ← map_add]
        congr 1
        ext <;> simp
      show ((ιL P).comp (((ContinuousLinearMap.id ℝ ℝ).prodMap
        (fderiv ℝ (F i) (πL k b).2)).comp (πL k))) c ∈ _
      rw [hDap, hsplit]
      exact Submodule.add_mem _ (Submodule.smul_mem _ _ (Submodule.subset_span (mem_insert _ _)))
        (Submodule.subset_span (mem_insert_of_mem _ ⟨_, ⟨_, rfl⟩, rfl⟩))
    · rw [Submodule.span_le]
      rintro _ (rfl | ⟨_, ⟨w, rfl⟩, rfl⟩)
      · exact ⟨EuclideanSpace.single 0 1,
          by simp only [ContinuousLinearMap.coe_coe, hDap, hπe0, map_zero]⟩
      · exact ⟨ιL k (0, w), by simp only [ContinuousLinearMap.coe_coe, hDap, hπι]⟩
  -- B5(b): `min(1, m i) |b − b'| ≤ |G i b − G i b'|` on `Bh i`
  have hGlow : ∀ i, ∀ b ∈ Bh i, ∀ b' ∈ Bh i, min 1 (m i) * ‖b - b'‖ ≤ ‖G i b - G i b'‖ := by
    intro i b hb b' hb'
    have h1 : G i b - G i b' =
        ιL P ((πL k b).1 - (πL k b').1, F i (πL k b).2 - F i (πL k b').2) := by
      rw [← map_sub]
      rfl
    have h2 : b - b' = ιL k ((πL k b).1 - (πL k b').1, (πL k b).2 - (πL k b').2) := by
      rw [show ((πL k b).1 - (πL k b').1, (πL k b).2 - (πL k b').2) = πL k (b - b') by
        rw [map_sub]; rfl, hιπ]
    have hX : ‖b - b'‖ ^ 2 =
        ((πL k b).1 - (πL k b').1) ^ 2 + ‖(πL k b).2 - (πL k b').2‖ ^ 2 := by
      rw [h2, hnorm]
    have hY : ‖G i b - G i b'‖ ^ 2 =
        ((πL k b).1 - (πL k b').1) ^ 2 + ‖F i (πL k b).2 - F i (πL k b').2‖ ^ 2 := by
      rw [h1, hnorm]
    have hμ0 : 0 < min 1 (m i) := lt_min one_pos (hm i)
    have hμT : min 1 (m i) * ‖(πL k b).2 - (πL k b').2‖ ≤ ‖F i (πL k b).2 - F i (πL k b').2‖ :=
      (mul_le_mul_of_nonneg_right (min_le_right _ _) (norm_nonneg _)).trans (hbi i _ hb.2 _ hb'.2)
    have e1 : min 1 (m i) ^ 2 * ((πL k b).1 - (πL k b').1) ^ 2 ≤ ((πL k b).1 - (πL k b').1) ^ 2 :=
      mul_le_of_le_one_left (sq_nonneg _) (pow_le_one₀ hμ0.le (min_le_left _ _))
    have e2 : (min 1 (m i) * ‖(πL k b).2 - (πL k b').2‖) ^ 2 ≤
        ‖F i (πL k b).2 - F i (πL k b').2‖ ^ 2 :=
      pow_le_pow_left₀ (mul_nonneg hμ0.le (norm_nonneg _)) hμT 2
    refine (pow_le_pow_iff_left₀ (mul_nonneg hμ0.le (norm_nonneg _)) (norm_nonneg _)
      two_ne_zero).mp ?_
    rw [mul_pow, hX, hY, mul_add, ← mul_pow (min 1 (m i)) ‖(πL k b).2 - (πL k b').2‖]
    exact add_le_add e1 e2
  have hGinj : ∀ i, InjOn (G i) (Bh i) := by
    intro i b hb b' hb' h
    have h1 := hGlow i b hb b' hb'
    rw [h, sub_self, norm_zero] at h1
    have h2 : ‖b - b'‖ ≤ 0 := by nlinarith [norm_nonneg (b - b'), lt_min one_pos (hm i)]
    exact sub_eq_zero.mp (norm_le_zero_iff.mp h2)
  have hfinA : ∀ i, IsFiniteMeasure (μHE[k].restrict (A i)) := fun i =>
    isFiniteMeasure_restrict.mpr (ne_top_of_le_ne_top hfin (measure_mono (hFBM i)))
  -- A5–A6: `Hᵏ⁺¹⌞C i = ι_#(L¹⌞(0,1) ⊗ Hᵏ⌞A i)`, by the area formula (accepted
  -- `codim1_lura_gram_area_formula`) for `G i` and for `F i`, the measure preserving `π`
  -- and Tonelli
  have hpiece : ∀ i, μHE[k + 1].restrict (C i) =
      ((volume.restrict (Ioo (0 : ℝ) 1)).prod (μHE[k].restrict (A i))).map (ιL P) := by
    intro i
    have := hfinA i
    obtain ⟨hJm, hGA⟩ := Submission.codim1_lura_gram_area_formula k P (F i)
    have hGAh := (Submission.codim1_lura_gram_area_formula (k + 1) (P + 1) (G i)).2 (Bh i)
      (hBhm i) (fun b hb => (hGd i b hb).differentiableAt) (hGdinj i) (hGinj i)
    ext S hS
    have hιS : MeasurableSet (ιL P ⁻¹' S) := (ιL P).continuous.measurable hS
    have hhm : Measurable fun p : ℝ × Euclid k => ENNReal.ofReal (Real.sqrt (Matrix.det
        (Matrix.of fun a c : Fin k => inner ℝ (fderiv ℝ (F i) p.2 (EuclideanSpace.single a 1))
          (fderiv ℝ (F i) p.2 (EuclideanSpace.single c 1))))) *
        S.indicator 1 (ιL P (p.1, F i p.2)) :=
      (ENNReal.measurable_ofReal.comp (hJm.comp measurable_snd)).mul
        ((measurable_one.indicator hS).comp ((ιL P).continuous.comp
          (continuous_fst.prodMk ((hL i).continuous.comp continuous_snd))).measurable)
    rw [← lintegral_indicator_one (μ := μHE[k + 1].restrict (C i)) hS, ← hGC i, hGAh,
      Measure.map_apply (ιL P).continuous.measurable hS, Measure.prod_apply hιS,
      setLIntegral_congr_fun (hBhm i) (fun b hb => by rw [hGJ i b hb])]
    rw [(hπmp k).setLIntegral_comp_preimage (measurableSet_Ioo.prod (hB i)) hhm,
      Measure.volume_eq_prod, ← Measure.prod_restrict, lintegral_prod _ hhm.aemeasurable]
    refine lintegral_congr fun t => ?_
    rw [← lintegral_indicator_one (measurable_prodMk_left hιS)]
    exact (hGA (B i) (hB i) (fun a ha => (hdiff i a ha).1) (fun a ha => (hdiff i a ha).2)
      (hFinj i) (fun x => S.indicator 1 (ιL P (t, x)))).symm
  -- B4: sum over the pieces, using `Hᵏ(M ∖ ⋃ A i) = 0`
  have hMA : μHE[k].restrict M = Measure.sum fun i => μHE[k].restrict (A i) := by
    rw [← Measure.restrict_iUnion hdisj hFBm]
    refine Measure.restrict_congr_set (ae_eq_set.mpr ⟨hnull, ?_⟩)
    rw [sdiff_eq_empty.mpr (iUnion_subset hFBM), measure_empty]
  have hmeasure : μHE[k + 1].restrict (ιL P '' (Ioo (0 : ℝ) 1 ×ˢ ⋃ i, A i)) =
      ((volume.restrict (Ioo (0 : ℝ) 1)).prod (μHE[k].restrict M)).map (ιL P) := by
    rw [hCU, Measure.restrict_iUnion hCdisj hCm, hMA, Measure.prod_sum_right,
      Measure.map_sum (ιL P).continuous.measurable.aemeasurable]
    exact congrArg Measure.sum (funext hpiece)
  -- B2: the cylinder `C = ι((0,1) × ⋃ A i) = ⋃ C i` is Borel with `Hᵏ⁺¹(C) = Hᵏ(M) < ∞`
  set Ctot := ιL P '' (Ioo (0 : ℝ) 1 ×ˢ ⋃ i, A i)
  have hCtotm : MeasurableSet Ctot :=
    hmeas_img _ (measurableSet_Ioo.prod (MeasurableSet.iUnion hFBm))
  have hCfin : μHE[k + 1] Ctot ≠ ∞ := by
    have : IsFiniteMeasure (μHE[k].restrict M) := isFiniteMeasure_restrict.mpr hfin
    have : IsFiniteMeasure (volume.restrict (Ioo (0 : ℝ) 1)) :=
      isFiniteMeasure_restrict.mpr measure_Ioo_lt_top.ne
    rw [← Measure.restrict_apply_univ, hmeasure]
    exact measure_ne_top _ _
  -- B5: the tangent planes, piece by piece (accepted `dpf_approxTangent_ae_bilipschitz_piece`)
  have htan : ∀ i, ∀ᵐ y ∂(μHE[k + 1].restrict (C i)), ∀ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt k M (πL P y).2 Q → HasApproximateTangentSpaceAt (k + 1) Ctot y
        (Submodule.span ℝ (insert (ιL P (1, 0))
          ((fun v => ιL P (0, v)) '' (Q : Set (Euclid P))))) := by
    intro i
    obtain ⟨K, hK⟩ := hGlip i
    -- (a) `M` has approximate tangent space `range DF i(u)` at `F i u` for a.e. `u ∈ B i`
    have hTM := Submission.dpf_approxTangent_ae_bilipschitz_piece P k univ M (F i) (B i) (L i)
      (m i) isOpen_univ hM (subset_univ _)
      (fun K' _ _ => ne_top_of_le_ne_top hfin (measure_mono inter_subset_left))
      (hL i) (hB i) (hm i) (hbi i) (hdiff i) (hFBM i)
    -- (b) `C` has approximate tangent space `range DG i(b)` at `G i b` for a.e. `b ∈ Bh i`
    have hTC := Submission.dpf_approxTangent_ae_bilipschitz_piece (P + 1) (k + 1) univ Ctot (G i)
      (Bh i) K (min 1 (m i)) isOpen_univ hCtotm (subset_univ _)
      (fun K' _ _ => ne_top_of_le_ne_top hCfin (measure_mono inter_subset_left)) hK (hBhm i)
      (lt_min one_pos (hm i)) (hGlow i)
      (fun b hb => ⟨(hGd i b hb).differentiableAt, hGdinj i b hb⟩)
      (by rw [hGC i, hCU]; exact subset_iUnion C i)
    -- (c) (a) holds at `π₂ b` for a.e. `b ∈ Bh i`, since `π` is measure preserving
    have hTM' : ∀ᵐ b ∂(volume.restrict (Bh i)), HasApproximateTangentSpaceAt k M (F i (πL k b).2)
        (LinearMap.range (fderiv ℝ (F i) (πL k b).2 : Euclid k →ₗ[ℝ] Euclid P)) := by
      refine ((hπmp k).restrict_preimage
        (measurableSet_Ioo.prod (hB i))).quasiMeasurePreserving.ae
        (p := fun p : ℝ × Euclid k => HasApproximateTangentSpaceAt k M (F i p.2)
          (LinearMap.range (fderiv ℝ (F i) p.2 : Euclid k →ₗ[ℝ] Euclid P))) ?_
      rw [Measure.volume_eq_prod, ← Measure.prod_restrict]
      exact Measure.quasiMeasurePreserving_snd.ae hTM
    -- (d) there, uniqueness of approximate tangent spaces and `range DG i(b) = ℝe₀ ⊕ J(range DF i)`
    have hcomb : ∀ᵐ b ∂(volume.restrict (Bh i)), ∀ Q : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt k M (πL P (G i b)).2 Q →
        HasApproximateTangentSpaceAt (k + 1) Ctot (G i b)
          (Submodule.span ℝ (insert (ιL P (1, 0))
            ((fun v => ιL P (0, v)) '' (Q : Set (Euclid P))))) := by
      filter_upwards [hTC, hTM', ae_restrict_mem (hBhm i)] with b hbC hbM hb Q hQ
      have hprG : (πL P (G i b)).2 = F i (πL k b).2 := by
        show (πL P (ιL P ((πL k b).1, F i (πL k b).2))).2 = _
        rw [hπι]
      rw [hprG] at hQ
      rw [hQ.unique hbM, ← hGrange i b hb]
      exact hbC
    -- (e) the exceptional set is the image of a Lebesgue-null set under the Lipschitz `G i`
    rw [← hGC i, ae_iff, Measure.restrict_apply' ((hGC i).symm ▸ hCm i)]
    rw [ae_iff, Measure.restrict_apply' (hBhm i)] at hcomb
    refine measure_mono_null (t := G i '' ({b | ¬∀ Q : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt k M (πL P (G i b)).2 Q →
        HasApproximateTangentSpaceAt (k + 1) Ctot (G i b) (Submodule.span ℝ (insert (ιL P (1, 0))
          ((fun v => ιL P (0, v)) '' (Q : Set (Euclid P)))))} ∩ Bh i)) ?_ ?_
    · rintro _ ⟨hy, b, hb, rfl⟩
      exact ⟨b, ⟨hy, hb⟩, rfl⟩
    · refine le_antisymm (le_trans
        (Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn (k + 1)
          hK.lipschitzOnWith) ?_) bot_le
      rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume, hcomb, mul_zero]
  refine ⟨Ctot, hCtotm, image_mono (prod_mono subset_rfl (iUnion_subset hFBM)), ?_, hmeasure, ?_⟩
  -- B3: `C ⊆ ⋃ range (G i)`, every `G i` being Lipschitz
  · refine ⟨∅, measure_empty, G, hGlip, ?_⟩
    rw [empty_union, hCU]
    exact iUnion_mono fun i => hGC i ▸ image_subset_range _ _
  · have hCC : μHE[k + 1].restrict Ctot = μHE[k + 1].restrict (⋃ i, C i) := by rw [hCU]
    rw [hCC, ae_restrict_iUnion_iff]
    exact htan

/-- **Smooth pull-backs and the homotopy formula on forms** (Simon 6.2.23–6.2.26, dual form).
(a) The pull-back `Φ^#α(x) = α(Φ x) ∘ DΦ(x)` of a smooth form by a `C^∞` map is smooth.
(b) Let `F, G` be `C^∞`, `h(t, x) = F x + t(G x - F x)` the affine homotopy (6.2.26) and `ω` a
smooth `(k+1)`-form.  Then `Kω(x) = ∫₀¹ (ι_{G x - F x} ω(h(t, x))) ∘ D_x h(t, x) dt` is smooth and
`G^#ω - F^#ω = d(Kω) + K(dω)`, the homotopy formula 6.2.25 tested on `ω`.  The precomposition
`L ↦ (γ ↦ γ ∘ L)` is analytic, which gives (a).  For (b) we work on a proper normed space `E`:
with `H = h` on `ℝ × E`, `Θ = H^#ω` and `e = (1, 0)`, `dΘ = H^#(dω)` and Cartan's formula
`d(ι_e Θ) + ι_e dΘ = DΘ[e]` hold; pulling back by `y ↦ (t, y)` turns `ι_e Θ` and `ι_e dΘ` into the
integrands of `Kω` and `K(dω)` and `DΘ[e]` into `∂_t (h_t^#ω)`.  Integrating over `t ∈ [0, 1]`
and differentiating under the integral sign gives the formula. -/
theorem Submission.dor_lmb_fcdp_smooth_homotopy : (∀ (N N' m : ℕ) (Φ : Euclid N → Euclid N') (α : DifferentialForm (Euclid N') m), ContDiff ℝ (⊤ : ℕ∞) Φ → IsSmoothForm α → IsSmoothForm (fun x => (α (Φ x)).compContinuousLinearMap (fderiv ℝ Φ x))) ∧ ∀ (P k : ℕ) (F G : Euclid P → Euclid P) (ω : DifferentialForm (Euclid P) (k + 1)), ContDiff ℝ (⊤ : ℕ∞) F → ContDiff ℝ (⊤ : ℕ∞) G → IsSmoothForm ω → IsSmoothForm (fun x => ∫ t in (0 : ℝ)..1, ((ω (F x + t • (G x - F x))).curryLeft (G x - F x)).compContinuousLinearMap (fderiv ℝ F x + t • (fderiv ℝ G x - fderiv ℝ F x))) ∧ ∀ x, (ω (G x)).compContinuousLinearMap (fderiv ℝ G x) - (ω (F x)).compContinuousLinearMap (fderiv ℝ F x) = exteriorDerivative (fun x' => ∫ t in (0 : ℝ)..1, ((ω (F x' + t • (G x' - F x'))).curryLeft (G x' - F x')).compContinuousLinearMap (fderiv ℝ F x' + t • (fderiv ℝ G x' - fderiv ℝ F x'))) x + ∫ t in (0 : ℝ)..1, ((exteriorDerivative ω (F x + t • (G x - F x))).curryLeft (G x - F x)).compContinuousLinearMap (fderiv ℝ F x + t • (fderiv ℝ G x - fderiv ℝ F x)) := by
  -- the pull-back `x ↦ α(x) ∘ L(x)` is `C^∞` when `α` and `L` are, as `L ↦ (γ ↦ γ ∘ L)` is analytic
  have hpb : ∀ (E₁ E₂ E₃ : Type) [NormedAddCommGroup E₁] [NormedSpace ℝ E₁]
      [NormedAddCommGroup E₂] [NormedSpace ℝ E₂] [NormedAddCommGroup E₃] [NormedSpace ℝ E₃]
      (m : ℕ) (α : E₁ → E₂ [⋀^Fin m]→L[ℝ] ℝ) (L : E₁ → E₃ →L[ℝ] E₂),
      ContDiff ℝ (⊤ : ℕ∞) α → ContDiff ℝ (⊤ : ℕ∞) L →
        ContDiff ℝ (⊤ : ℕ∞) (fun x => (α x).compContinuousLinearMap (L x)) := by
    intro E₁ E₂ E₃ _ _ _ _ _ _ m α L hα hL
    have hΨ : ContDiff ℝ (⊤ : ℕ∞) (ContinuousAlternatingMap.compContinuousLinearMapCLM :
        (E₃ →L[ℝ] E₂) → (E₂ [⋀^Fin m]→L[ℝ] ℝ) →L[ℝ] (E₃ [⋀^Fin m]→L[ℝ] ℝ)) :=
      (ContinuousAlternatingMap.analyticOnNhd_compContinuousLinearMapCLM univ).contDiff
    exact (hΨ.comp hL).clm_apply hα
  -- (a) `Φ^#α(x) = α(Φ x) ∘ DΦ(x)`
  refine ⟨fun N N' m Φ α hΦ hα => hpb (Euclid N) (Euclid N') (Euclid N) m (fun x => α (Φ x))
    (fderiv ℝ Φ) (hα.comp hΦ) (contDiff_infty_iff_fderiv.mp hΦ).2, ?_⟩
  -- (b) on an abstract proper normed space `E`, then for `E = ℝᴾ`
  suffices key : ∀ (E : Type) [NormedAddCommGroup E] [NormedSpace ℝ E] [ProperSpace E] (k : ℕ)
      (F G : E → E) (ω : DifferentialForm E (k + 1)), ContDiff ℝ (⊤ : ℕ∞) F →
      ContDiff ℝ (⊤ : ℕ∞) G → IsSmoothForm ω → IsSmoothForm (fun x => ∫ t in (0 : ℝ)..1,
        ((ω (F x + t • (G x - F x))).curryLeft (G x - F x)).compContinuousLinearMap
          (fderiv ℝ F x + t • (fderiv ℝ G x - fderiv ℝ F x))) ∧
      ∀ x, (ω (G x)).compContinuousLinearMap (fderiv ℝ G x) -
        (ω (F x)).compContinuousLinearMap (fderiv ℝ F x) =
        exteriorDerivative (fun x' => ∫ t in (0 : ℝ)..1,
          ((ω (F x' + t • (G x' - F x'))).curryLeft (G x' - F x')).compContinuousLinearMap
            (fderiv ℝ F x' + t • (fderiv ℝ G x' - fderiv ℝ F x'))) x +
        ∫ t in (0 : ℝ)..1, ((exteriorDerivative ω (F x + t • (G x - F x))).curryLeft
          (G x - F x)).compContinuousLinearMap (fderiv ℝ F x + t • (fderiv ℝ G x - fderiv ℝ F x)) by
    intro P k F G ω hF hG hω
    exact key (Euclid P) k F G ω hF hG hω
  intro E _ _ _ k F G ω hF hG hω
  have hωs : ContDiff ℝ (⊤ : ℕ∞) ω := hω
  have hne : ((⊤ : ℕ∞) : WithTop ℕ∞) ≠ 0 := by simp
  have hr : minSmoothness ℝ 2 ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by simp
  have hF1 : Differentiable ℝ F := hF.differentiable hne
  have hG1 : Differentiable ℝ G := hG.differentiable hne
  have hω1 : Differentiable ℝ ω := hωs.differentiable hne
  -- `γ ↦ γ.curryLeft` is a linear isometry, hence `C^∞`
  have hcl : ∀ (E₁ : Type) [NormedAddCommGroup E₁] [NormedSpace ℝ E₁] (m : ℕ),
      ContDiff ℝ (⊤ : ℕ∞) (fun γ : E₁ [⋀^Fin (m + 1)]→L[ℝ] ℝ => γ.curryLeft) := by
    intro E₁ _ _ m
    have h := LinearIsometry.contDiff (𝕜 := ℝ) (E := E₁ [⋀^Fin (m + 1)]→L[ℝ] ℝ)
      (F := E₁ →L[ℝ] E₁ [⋀^Fin m]→L[ℝ] ℝ) (n := ((⊤ : ℕ∞) : WithTop ℕ∞))
      ContinuousAlternatingMap.curryLeftLI
    exact h
  -- differentiation under the integral sign: `D_x ∫₀¹ f(t, x) dt = ∫₀¹ Df(t, x) ∘ J dt`, `J = inr`,
  -- with the bound `sup ‖Df ∘ J‖` over the compact set `[0, 1] × B̄(x₀, 1)`
  have hpar : ∀ (Y : Type) [NormedAddCommGroup Y] [NormedSpace ℝ Y] [CompleteSpace Y]
      (f : ℝ × E → Y), ContDiff ℝ (⊤ : ℕ∞) f → ∀ x₀ : E,
      HasFDerivAt (fun x => ∫ t in (0 : ℝ)..1, f (t, x))
        (∫ t in (0 : ℝ)..1, (fderiv ℝ f (t, x₀)).comp (ContinuousLinearMap.inr ℝ ℝ E)) x₀ := by
    intro Y _ _ _ f hf x₀
    have : SecondCountableTopologyEither ℝ (E →L[ℝ] Y) := ⟨Or.inl inferInstance⟩
    have hf1 : Differentiable ℝ f := hf.differentiable hne
    have hDf : Continuous (fun p : ℝ × E => (fderiv ℝ f p).comp (ContinuousLinearMap.inr ℝ ℝ E)) :=
      (hf.continuous_fderiv hne).clm_comp continuous_const
    have hjt : ∀ x : E, Continuous (fun t : ℝ => ((t, x) : ℝ × E)) :=
      fun x => continuous_id.prodMk continuous_const
    obtain ⟨C, hC⟩ := ((isCompact_Icc (a := (0 : ℝ)) (b := 1)).prod
      (isCompact_closedBall x₀ 1)).exists_bound_of_continuousOn hDf.continuousOn
    refine hasFDerivAt_integral_of_dominated_of_fderiv_le'' (μ := volume)
      (F := fun x t => f (t, x))
      (F' := fun x t => (fderiv ℝ f (t, x)).comp (ContinuousLinearMap.inr ℝ ℝ E))
      (bound := fun _ => C) (ball_mem_nhds x₀ one_pos)
      (Eventually.of_forall fun x => (hf.continuous.comp (hjt x)).aestronglyMeasurable)
      ((hf.continuous.comp (hjt x₀)).intervalIntegrable 0 1)
      (hDf.comp (hjt x₀)).aestronglyMeasurable ?_ intervalIntegrable_const ?_
    · rw [ae_restrict_iff' measurableSet_uIoc]
      refine Eventually.of_forall fun t ht x hx => hC (t, x) ⟨?_, ?_⟩
      · rw [uIoc_of_le zero_le_one] at ht
        exact Ioc_subset_Icc_self ht
      · exact ball_subset_closedBall hx
    · exact Eventually.of_forall fun t x _ =>
        (hf1 (t, x)).hasFDerivAt.comp x (hasFDerivAt_prodMk_right t x)
  -- `x ↦ ∫₀¹ f(t, x) dt` is `C^n` for every `n`, by induction (for all `Y` at once)
  have hsm : ∀ (n : ℕ) (Y : Type) [NormedAddCommGroup Y] [NormedSpace ℝ Y] [CompleteSpace Y]
      (f : ℝ × E → Y), ContDiff ℝ (⊤ : ℕ∞) f →
      ContDiff ℝ n (fun x => ∫ t in (0 : ℝ)..1, f (t, x)) := by
    intro n
    induction n with
    | zero =>
      intro Y _ _ _ f hf
      rw [Nat.cast_zero, contDiff_zero]
      exact intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
        (f := fun x t => f (t, x)) (hf.continuous.comp continuous_swap) 0 1
    | succ n ih =>
      intro Y _ _ _ f hf
      rw [Nat.cast_succ, contDiff_succ_iff_hasFDerivAt]
      exact ⟨fun x => ∫ t in (0 : ℝ)..1, (fderiv ℝ f (t, x)).comp (ContinuousLinearMap.inr ℝ ℝ E),
        ih (E →L[ℝ] Y) (fun p => (fderiv ℝ f p).comp (ContinuousLinearMap.inr ℝ ℝ E))
          ((contDiff_infty_iff_fderiv.mp hf).2.clm_comp contDiff_const), hpar Y f hf⟩
  have hcc : ∀ (m : ℕ) (g : Covector E m) (L : ℝ × E →L[ℝ] E) (L' : E →L[ℝ] ℝ × E),
      (g.compContinuousLinearMap L).compContinuousLinearMap L' =
        g.compContinuousLinearMap (L.comp L') := fun _ _ _ _ => rfl
  -- the homotopy `H(t, y) = F y + t • (G y - F y)` on `ℝ × E`: `DH(t, y) e = G y - F y` for
  -- `e = (1, 0)`, and `DH(t, y) ∘ J = DF y + t • (DG y - DF y)`
  obtain ⟨H, hHdef⟩ : ∃ H : ℝ × E → E, H = fun p => F p.2 + p.1 • (G p.2 - F p.2) := ⟨_, rfl⟩
  have hHapp : ∀ (t : ℝ) (y : E), H (t, y) = F y + t • (G y - F y) := fun t y => by rw [hHdef]
  have hHs : ContDiff ℝ (⊤ : ℕ∞) H := by
    rw [hHdef]
    exact (hF.comp contDiff_snd).add
      (contDiff_fst.smul ((hG.comp contDiff_snd).sub (hF.comp contDiff_snd)))
  have hH1 : Differentiable ℝ H := hHs.differentiable hne
  have hDHe : ∀ (t : ℝ) (y : E), fderiv ℝ H (t, y) (1, 0) = G y - F y := by
    intro t y
    have h1 : HasDerivAt (fun s : ℝ => H (s, y)) (fderiv ℝ H (t, y) (1, 0)) t :=
      (hH1 (t, y)).hasFDerivAt.comp_hasDerivAt t ((hasDerivAt_id t).prodMk (hasDerivAt_const t y))
    have h2 := ((hasDerivAt_id' t).smul_const (G y - F y)).const_add (F y)
    rw [one_smul] at h2
    simp only [← hHapp] at h2
    exact h1.unique h2
  have hDHJ : ∀ (t : ℝ) (y : E), (fderiv ℝ H (t, y)).comp (ContinuousLinearMap.inr ℝ ℝ E) =
      fderiv ℝ F y + t • (fderiv ℝ G y - fderiv ℝ F y) := by
    intro t y
    have h1 : HasFDerivAt (fun y' : E => H (t, y'))
        ((fderiv ℝ H (t, y)).comp (ContinuousLinearMap.inr ℝ ℝ E)) y :=
      (hH1 (t, y)).hasFDerivAt.comp y (hasFDerivAt_prodMk_right t y)
    have h2 : HasFDerivAt (fun y' : E => F y' + t • (G y' - F y'))
        (fderiv ℝ F y + t • (fderiv ℝ G y - fderiv ℝ F y)) y :=
      (hF1 y).hasFDerivAt.add (((hG1 y).hasFDerivAt.sub (hF1 y).hasFDerivAt).const_smul t)
    simp only [← hHapp] at h2
    exact h1.unique h2
  -- `Θ = H^#ω` is `C^∞` with `dΘ = H^#(dω)`, and `ι_e Θ` is `C^∞`
  obtain ⟨Θ, hΘdef⟩ : ∃ Θ : DifferentialForm (ℝ × E) (k + 1),
      Θ = fun p => (ω (H p)).compContinuousLinearMap (fderiv ℝ H p) := ⟨_, rfl⟩
  have hΘs : ContDiff ℝ (⊤ : ℕ∞) Θ := by
    rw [hΘdef]
    exact hpb (ℝ × E) E (ℝ × E) (k + 1) (fun p => ω (H p)) (fderiv ℝ H) (hωs.comp hHs)
      (contDiff_infty_iff_fderiv.mp hHs).2
  have hΘ1 : Differentiable ℝ Θ := hΘs.differentiable hne
  have hdΘ : ∀ p, extDeriv Θ p = (extDeriv ω (H p)).compContinuousLinearMap (fderiv ℝ H p) := by
    intro p
    rw [hΘdef]
    exact extDeriv_pullback (hω1 (H p)) hHs.contDiffAt hr
  obtain ⟨ιΘ, hιΘdef⟩ : ∃ ιΘ : DifferentialForm (ℝ × E) k,
      ιΘ = fun p => (Θ p).curryLeft (1, 0) := ⟨_, rfl⟩
  have hιΘs : ContDiff ℝ (⊤ : ℕ∞) ιΘ := by
    rw [hιΘdef]
    exact ((hcl (ℝ × E) k).comp hΘs).clm_apply contDiff_const
  have hιΘ1 : Differentiable ℝ ιΘ := hιΘs.differentiable hne
  -- the integrands `κ` of `Kω` and `κd` of `K(dω)` are `ι_e Θ ∘ J` and `ι_e dΘ ∘ J`
  obtain ⟨κ, hκdef⟩ : ∃ κ : ℝ × E → Covector E k, κ = fun p =>
      ((ω (F p.2 + p.1 • (G p.2 - F p.2))).curryLeft (G p.2 - F p.2)).compContinuousLinearMap
        (fderiv ℝ F p.2 + p.1 • (fderiv ℝ G p.2 - fderiv ℝ F p.2)) := ⟨_, rfl⟩
  have hκapp : ∀ (t : ℝ) (x : E), κ (t, x) =
      ((ω (F x + t • (G x - F x))).curryLeft (G x - F x)).compContinuousLinearMap
        (fderiv ℝ F x + t • (fderiv ℝ G x - fderiv ℝ F x)) := fun t x => by rw [hκdef]
  obtain ⟨κd, hκddef⟩ : ∃ κd : ℝ × E → Covector E (k + 1), κd = fun p =>
      ((extDeriv ω (F p.2 + p.1 • (G p.2 - F p.2))).curryLeft
        (G p.2 - F p.2)).compContinuousLinearMap
        (fderiv ℝ F p.2 + p.1 • (fderiv ℝ G p.2 - fderiv ℝ F p.2)) := ⟨_, rfl⟩
  have hκdapp : ∀ (t : ℝ) (x : E), κd (t, x) =
      ((exteriorDerivative ω (F x + t • (G x - F x))).curryLeft
        (G x - F x)).compContinuousLinearMap
        (fderiv ℝ F x + t • (fderiv ℝ G x - fderiv ℝ F x)) := fun t x => by rw [hκddef]
  have hκeq : ∀ (t : ℝ) (y : E),
      (ιΘ (t, y)).compContinuousLinearMap (ContinuousLinearMap.inr ℝ ℝ E) = κ (t, y) := by
    intro t y
    rw [hκapp, hιΘdef, hΘdef]
    simp only [ContinuousAlternatingMap.curryLeft_compContinuousLinearMap, hDHe, hcc, hDHJ, hHapp]
  have hκdeq : ∀ (t : ℝ) (y : E), ((extDeriv Θ (t, y)).curryLeft (1, 0)).compContinuousLinearMap
      (ContinuousLinearMap.inr ℝ ℝ E) = κd (t, y) := by
    intro t y
    rw [hκddef, hdΘ]
    simp only [ContinuousAlternatingMap.curryLeft_compContinuousLinearMap, hDHe, hcc, hDHJ, hHapp]
  have hκs : ContDiff ℝ (⊤ : ℕ∞) κ := by
    have hκfun : κ = fun p => (ιΘ p).compContinuousLinearMap (ContinuousLinearMap.inr ℝ ℝ E) :=
      funext fun p => (hκeq p.1 p.2).symm
    rw [hκfun]
    exact hpb (ℝ × E) (ℝ × E) E k ιΘ (fun _ => ContinuousLinearMap.inr ℝ ℝ E) hιΘs contDiff_const
  -- `Kω` is `C^∞`
  simp only [← hκapp, ← hκdapp]
  refine ⟨contDiff_infty.mpr fun n => hsm n _ κ hκs, fun x => ?_⟩
  -- Cartan's formula for the constant field `e`: `d(ι_e Θ) + ι_e dΘ = DΘ[e]`
  have hcartan : ∀ p, extDeriv ιΘ p + (extDeriv Θ p).curryLeft (1, 0) = fderiv ℝ Θ p (1, 0) := by
    intro p
    ext v
    have h0 : Fin.removeNth 0 (Matrix.vecCons ((1 : ℝ), (0 : E)) v) = v := by simp
    have hs : ∀ i : Fin (k + 1), Fin.removeNth i.succ (Matrix.vecCons ((1 : ℝ), (0 : E)) v) =
        Matrix.vecCons ((1 : ℝ), (0 : E)) (Fin.removeNth i v) :=
      fun i => Fin.cons_comp_succ_succAbove _ v i
    rw [ContinuousAlternatingMap.add_apply, ContinuousAlternatingMap.curryLeft_apply_apply,
      extDeriv_apply (hιΘ1 p), extDeriv_apply (hΘ1 p), Fin.sum_univ_succ (n := k + 1)]
    simp only [hιΘdef, ContinuousAlternatingMap.curryLeft_apply_apply, h0, hs, Fin.val_zero,
      pow_zero, one_smul, Matrix.cons_val_zero, Matrix.cons_val_succ, Fin.val_succ]
    rw [fderiv_continuousAlternatingMap_apply_const_apply (hΘ1 p), add_left_comm,
      ← Finset.sum_add_distrib, Finset.sum_eq_zero, add_zero]
    intro i _
    rw [pow_succ, mul_neg_one, neg_smul, add_neg_cancel]
  -- pulling back by `y ↦ (t, y)`: `d(κ(t, ·))(x) = d(ι_e Θ)(t, x) ∘ J`
  have hj : ∀ (t : ℝ) (y : E),
      fderiv ℝ (fun y' : E => ((t, y') : ℝ × E)) y = ContinuousLinearMap.inr ℝ ℝ E :=
    fun t y => (hasFDerivAt_prodMk_right t y).fderiv
  have hpull : ∀ t : ℝ, extDeriv (fun x' => κ (t, x')) x =
      (extDeriv ιΘ (t, x)).compContinuousLinearMap (ContinuousLinearMap.inr ℝ ℝ E) := by
    intro t
    have h := extDeriv_pullback (ω := ιΘ) (f := fun y' : E => ((t, y') : ℝ × E)) (x := x)
      (hιΘ1 (t, x)) (contDiff_const.prodMk contDiff_id : ContDiff ℝ (⊤ : ℕ∞)
        (fun y' : E => ((t, y') : ℝ × E))).contDiffAt hr
    simp only [hj, hκeq] at h
    exact h
  -- `Θ ∘ J` is `C^∞` with `D(Θ ∘ J)[e] = DΘ[e] ∘ J = d(κ(t, ·))(x) + κd(t, x)` at `(t, x)`
  have hΘ's : ContDiff ℝ (⊤ : ℕ∞)
      (fun p => (Θ p).compContinuousLinearMap (ContinuousLinearMap.inr ℝ ℝ E)) :=
    hpb (ℝ × E) (ℝ × E) E (k + 1) Θ (fun _ => ContinuousLinearMap.inr ℝ ℝ E) hΘs contDiff_const
  have hΘ'1 : Differentiable ℝ
      (fun p => (Θ p).compContinuousLinearMap (ContinuousLinearMap.inr ℝ ℝ E)) :=
    hΘ's.differentiable hne
  have hΘ'e : ∀ p, fderiv ℝ (fun p => (Θ p).compContinuousLinearMap
      (ContinuousLinearMap.inr ℝ ℝ E)) p (1, 0) =
      (fderiv ℝ Θ p (1, 0)).compContinuousLinearMap (ContinuousLinearMap.inr ℝ ℝ E) := by
    intro p
    ext v
    rw [ContinuousAlternatingMap.compContinuousLinearMap_apply,
      ← fderiv_continuousAlternatingMap_apply_const_apply (hΘ'1 p),
      ← fderiv_continuousAlternatingMap_apply_const_apply (hΘ1 p)]
    rfl
  have hpt : ∀ t : ℝ, fderiv ℝ (fun p => (Θ p).compContinuousLinearMap
      (ContinuousLinearMap.inr ℝ ℝ E)) (t, x) (1, 0) =
      extDeriv (fun x' => κ (t, x')) x + κd (t, x) := by
    intro t
    rw [hΘ'e, ← hcartan, hpull, ← hκdeq]
    ext v
    rfl
  -- the fundamental theorem of calculus for `t ↦ Θ(t, x) ∘ J`
  have hjt : Continuous (fun t : ℝ => ((t, x) : ℝ × E)) := continuous_id.prodMk continuous_const
  have hc1 : Continuous (fun t : ℝ => fderiv ℝ (fun p => (Θ p).compContinuousLinearMap
      (ContinuousLinearMap.inr ℝ ℝ E)) (t, x) (1, 0)) :=
    ((hΘ's.continuous_fderiv hne).comp hjt).clm_apply continuous_const
  have hβd : ∀ t : ℝ, HasDerivAt
      (fun s : ℝ => (Θ (s, x)).compContinuousLinearMap (ContinuousLinearMap.inr ℝ ℝ E))
      (fderiv ℝ (fun p => (Θ p).compContinuousLinearMap
        (ContinuousLinearMap.inr ℝ ℝ E)) (t, x) (1, 0)) t := by
    intro t
    have h := (hΘ'1 (t, x)).hasFDerivAt.comp_hasDerivAt t
      ((hasDerivAt_id t).prodMk (hasDerivAt_const t x))
    exact h
  have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hβd t)
    (hc1.intervalIntegrable 0 1)
  -- `d(Kω)(x) = ∫₀¹ d(κ(t, ·))(x) dt`, as `d = alternatizeUncurryFin ∘ D` with a CLM
  have hκ1 : Differentiable ℝ κ := hκs.differentiable hne
  have hκt : ∀ t : ℝ, fderiv ℝ (fun x' => κ (t, x')) x =
      (fderiv ℝ κ (t, x)).comp (ContinuousLinearMap.inr ℝ ℝ E) :=
    fun t => ((hκ1 (t, x)).hasFDerivAt.comp x (hasFDerivAt_prodMk_right t x)).fderiv
  have hc3 : Continuous (fun t : ℝ => (fderiv ℝ κ (t, x)).comp (ContinuousLinearMap.inr ℝ ℝ E)) :=
    ((hκs.continuous_fderiv hne).comp hjt).clm_comp continuous_const
  have hi3 := Continuous.intervalIntegrable (E := E →L[ℝ] Covector E k) (μ := volume) hc3 0 1
  have hc4 : Continuous (fun t : ℝ => extDeriv (fun x' => κ (t, x')) x) := by
    simp only [extDeriv, hκt]
    exact (ContinuousAlternatingMap.alternatizeUncurryFinCLM ℝ E ℝ).continuous.comp hc3
  have hc2 : Continuous (fun t : ℝ => κd (t, x)) := by
    refine (hc1.sub hc4).congr fun t => ?_
    simp only [Pi.sub_apply]
    rw [hpt t, add_sub_cancel_left]
  have hdK : extDeriv (fun x' => ∫ t in (0 : ℝ)..1, κ (t, x')) x =
      ∫ t in (0 : ℝ)..1, extDeriv (fun x' => κ (t, x')) x := by
    simp only [extDeriv, hκt]
    rw [(hpar _ κ hκs x).fderiv]
    have hcomm := ContinuousLinearMap.intervalIntegral_comp_comm (𝕜 := ℝ)
      (E := E →L[ℝ] Covector E k) (F := Covector E (k + 1))
      (ContinuousAlternatingMap.alternatizeUncurryFinCLM ℝ E ℝ) hi3
    exact hcomm.symm
  -- `Θ(1, x) ∘ J = G^#ω(x)` and `Θ(0, x) ∘ J = F^#ω(x)`
  have hβ : ∀ t : ℝ, (Θ (t, x)).compContinuousLinearMap (ContinuousLinearMap.inr ℝ ℝ E) =
      (ω (F x + t • (G x - F x))).compContinuousLinearMap
        (fderiv ℝ F x + t • (fderiv ℝ G x - fderiv ℝ F x)) := by
    intro t
    rw [hΘdef]
    simp only [hcc, hDHJ, hHapp]
  have hβ1 : (Θ (1, x)).compContinuousLinearMap (ContinuousLinearMap.inr ℝ ℝ E) =
      (ω (G x)).compContinuousLinearMap (fderiv ℝ G x) := by
    rw [hβ, one_smul, one_smul, add_sub_cancel, add_sub_cancel]
  have hβ0 : (Θ (0, x)).compContinuousLinearMap (ContinuousLinearMap.inr ℝ ℝ E) =
      (ω (F x)).compContinuousLinearMap (fderiv ℝ F x) := by
    rw [hβ, zero_smul ℝ (G x - F x), zero_smul ℝ (fderiv ℝ G x - fderiv ℝ F x), add_zero,
      add_zero]
  -- `G^#ω - F^#ω = ∫₀¹ (d(κ(t, ·))(x) + κd(t, x)) dt = d(Kω)(x) + K(dω)(x)`
  show (ω (G x)).compContinuousLinearMap (fderiv ℝ G x) -
      (ω (F x)).compContinuousLinearMap (fderiv ℝ F x) =
    extDeriv (fun x' => ∫ t in (0 : ℝ)..1, κ (t, x')) x + ∫ t in (0 : ℝ)..1, κd (t, x)
  rw [← hβ1, ← hβ0, ← hftc, hdK, ← intervalIntegral.integral_add (hc4.intervalIntegrable 0 1)
    (hc2.intervalIntegrable 0 1)]
  exact intervalIntegral.integral_congr fun t _ => hpt t
/-- **The product `[[(0,1)]] × τ(M, θ, ξ)` as an integer multiplicity current** (Simon 6.2.17,
6.2.21).  For an `IMRep` `R = (M, θ, ξ)` of degree `k` in `ℝᴾ` with `μ_R(ℝᴾ) < ∞`, take the
cylinder `C ⊆ ι((0,1) × M)` of `dor_lmb_fcdp_cylinder`, with `Hᵏ⁺¹⌞C = ι_*(L¹⌞(0,1) ⊗ Hᵏ⌞M)`,
and put `R' = (C, θ ∘ pr, (ξ ∘ pr) ∘ c)`, `c(β) = (β ⌟ ê₀) ∘ J`, `J v = ι(0, v)`.  The measure
identity gives `μ_{R'}(ℝᴾ⁺¹) = μ_R(ℝᴾ)` and carries `Hᵏ⌞M`-null sets to `Hᵏ⁺¹⌞C`-null sets of
the form `pr⁻¹(N)`; `ê₀` followed by `J` of an orthonormal basis of `TₓM` is an orthonormal basis
of `ℝê₀ ⊕ J(TₓM)` realizing `ξ(x) ∘ c`; Fubini gives the action formula. -/
theorem Submission.dor_lmb_fcdp_product_imrep : ∀ (P k : ℕ) (R : IMRep (univ : Set (Euclid P)) k), R.measure univ ≠ ∞ → ∃ R' : IMRep (univ : Set (Euclid (P + 1))) (k + 1), R'.measure univ ≠ ∞ ∧ (∀ S : Set (Euclid P), MeasurableSet S → μHE[k] (R.carrier \ S) = 0 → μHE[k + 1] (R'.carrier \ ((fun p : ℝ × Euclid P => (WithLp.toLp 2 (Fin.cons p.1 (WithLp.ofLp p.2) : Fin (P + 1) → ℝ) : Euclid (P + 1))) '' (Icc (0 : ℝ) 1 ×ˢ S))) = 0) ∧ ∀ β : DifferentialForm (Euclid (P + 1)) (k + 1), Continuous β → (∃ C : ℝ, ∀ y, ‖β y‖ ≤ C) → R'.action β = R.action (fun x => ∫ t in (0 : ℝ)..1, ((β (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x) : Fin (P + 1) → ℝ) : Euclid (P + 1))).curryLeft (EuclideanSpace.single (0 : Fin (P + 1)) (1 : ℝ))).compContinuousLinearMap (fderiv ℝ (fun x' : Euclid P => (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x') : Fin (P + 1) → ℝ) : Euclid (P + 1))) x)) := by
  intro P k R hR
  -- `μ_R(ℝᴾ) = ∫_M θ dHᵏ ≥ Hᵏ(M)`, as `θ ≥ 1` on `M`
  have hθm : Measurable fun x => (R.mult x : ℝ≥0∞) := measurable_from_nat.comp R.measurable_mult
  have hRmeas : R.measure univ = ∫⁻ x in R.carrier, (R.mult x : ℝ≥0∞) ∂μHE[k] := by
    rw [IMRep.measure, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
  have hMfin : μHE[k] R.carrier ≠ ∞ := by
    refine ne_top_of_le_ne_top hR ?_
    rw [hRmeas, ← setLIntegral_one]
    exact setLIntegral_mono hθm fun x hx => Nat.one_le_cast.2 (R.mult_pos x hx)
