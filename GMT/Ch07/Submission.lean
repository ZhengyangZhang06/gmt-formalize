      have hb : ∀ j, ∀ x ∈ E, (b j : DifferentialForm (Euclid P) (k + 1)) x =
          ((ω : DifferentialForm (Euclid P) (k + 1)) (Fs j x)).compContinuousLinearMap
            (fderiv ℝ (Fs j) x) := by
        intro j x hx
        show ζ x • _ = _
        rw [hζW x (hEW hx), one_smul]
      have hc : ∀ j, ∀ x ∈ E, (c j : DifferentialForm (Euclid P) k) x = ∫ t in (0 : ℝ)..1,
          (((ω : DifferentialForm (Euclid P) (k + 1)) (Fs j x + t • (Gs j x - Fs j x))).curryLeft
            (Gs j x - Fs j x)).compContinuousLinearMap
              (fderiv ℝ (Fs j) x + t • (fderiv ℝ (Gs j) x - fderiv ℝ (Fs j) x)) := by
        intro j x hx
        show ζ x • _ = _
        rw [hζW x (hEW hx), one_smul]
      have he : ∀ j, ∀ x ∈ E,
          ((a j - b j - exteriorDerivativeTestOn univ k (c j) :
            TestFormOn (univ : Set (Euclid P)) (k + 1)) :
              DifferentialForm (Euclid P) (k + 1)) x = ∫ t in (0 : ℝ)..1,
          (((exteriorDerivativeTestOn univ (k + 1) ω : DifferentialForm (Euclid P) (k + 1 + 1))
            (Fs j x + t • (Gs j x - Fs j x))).curryLeft (Gs j x - Fs j x)).compContinuousLinearMap
              (fderiv ℝ (Fs j) x + t • (fderiv ℝ (Gs j) x - fderiv ℝ (Fs j) x)) := by
        intro j x hx
        have hxW := hEW hx
        simp only [Submodule.coe_sub, Pi.sub_apply]
        show ζ x • _ - ζ x • _ - exteriorDerivative (fun y => ζ y • _) x = _
        rw [hζW x hxW, one_smul, one_smul, dcut k ζ W _ x hW hζW hxW, (hcart j).2 x]
        exact add_sub_cancel_left _ _
      have h1 := (hpush (k + 1) Λ G E X hG hE hX hXE).2.2.1 Gs ω a
        (fun j => hC1 _ (hGs j)) hGsL hGsU ha
      have h2 := (hpush (k + 1) Λ F E X hF hE hX hXE).2.2.1 Fs ω b
        (fun j => hC1 _ (hFs j)) hFsL hFsU hb
      have h3 := (hhomot k Λ F G E X.boundary hF hG hE hbX hbXE).2.2.1 Fs Gs ω c
        (fun j => hC1 _ (hFs j)) (fun j => hC1 _ (hGs j)) hFsL hGsL hFsU hGsU hc
      have h4 := (hhomot (k + 1) Λ F G E X hF hG hE hX hXE).2.2.1 Fs Gs
        (exteriorDerivativeTestOn univ (k + 1) ω)
        (fun j => a j - b j - exteriorDerivativeTestOn univ k (c j))
        (fun j => hC1 _ (hFs j)) (fun j => hC1 _ (hGs j)) hFsL hGsL hFsU hGsU he
      -- `X(a_j − b_j − d c_j) = X(a_j) − X(b_j) − ∂X(c_j)`
      have h5 : Tendsto (fun j => X (a j - b j - exteriorDerivativeTestOn univ k (c j))) atTop
          (𝓝 (push (k + 1) G X ω - push (k + 1) F X ω - homot k F G X.boundary ω)) := by
        refine ((h1.sub h2).sub h3).congr fun j => ?_
        have e1 : X (a j - b j - exteriorDerivativeTestOn univ k (c j)) =
            X (a j - b j) - X (exteriorDerivativeTestOn univ k (c j)) :=
          X.toCurrent.map_sub (a j - b j) (exteriorDerivativeTestOn univ k (c j))
        have e2 : X (a j - b j) = X (a j) - X (b j) := X.toCurrent.map_sub (a j) (b j)
        show X (a j) - X (b j) - X (exteriorDerivativeTestOn univ k (c j)) = _
        rw [e1, e2]
      exact tendsto_nhds_unique h5 h4

/-- **Simon Ch. 6, Deformation Theorem 5.1, displays (6)–(25)** (deformation onto the
`n`-skeleton, `n = m + 1 < P`), with the slicing theorem (SL) and the series theorem (IMS) as
antecedents.  Let `T` be integer multiplicity with `∂T` integer multiplicity, vanishing off the
compact `K`, with `M(T), M(∂T) < ∞`; `μ_T`, `μ_∂T` are the measures of representations of `T`,
`∂T` (`M_W = μ(W)` for open `W`).
* The good centre `a` (`dor_lmb_fcd_good_center`) gives `μ({d < r}) ≤ C r^{n+1} μ(ℝᴾ)` for
  `d = dist(·, L*(a))` and `r ≤ 1/4`; the retraction `ψ` (`dor_lmb_fcd_retraction`) sends
  `{d > 0}` into `Lₙ`, moves points by at most `√P`, and is `c_R/r`-Lipschitz on `{d ≥ r}`.
* Slicing `T` by the `1`-Lipschitz `d` (SL) and a Markov choice (`dor_lmb_fcd_sd_good_slice`)
  give radii `r_j ∈ (2^{-j-3}, 2^{-j-2})` with `M(P_{r_j}) ≤ 4C 2^{-(j+2)(m+1)} M(T)`.
* The shells of `T`, `∂T` between consecutive radii (`dor_lmb_fcd_sd_shells`) vanish off
  `E_j = K ∩ {d ≥ r_j}`, where `ψ` agrees with its `√P c_R/r_j`-Lipschitz extension `φ_j`
  (`dor_lmb_fcd_sd_lipschitz_extend`); `Λ_j = max(1, √P c_R/r_j) ≤ c₄ 2^j`, `c₄ = 8(1 + √P c_R)`.
* `dor_lmb_fcd_sd_core` deforms the shells and sums them with (IMS), with the constant
  `c = max(c₄^{n}(1 + 2C), √P(2c₄)^{n}(1 + 2C), c₄^{n-1}(1 + 2C), √P(2c₄)^{n-1}(1 + 2C))`. -/
theorem Submission.dor_lmb_fcd_skeleton_deformation : ((∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (n + 1)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → RT.Represents T → RB.Represents T.boundary → LipschitzWith L f → ∃ Ps : ℝ → GeometricCurrentOn U n, (∀ W : Set (Euclid P), IsOpen W → AEMeasurable (fun t => (Ps t).massOn W) ∧ ∫⁻ t, (Ps t).massOn W ≤ (L : ℝ≥0∞) * T.massOn W) ∧ ∀ᵐ t, IsIntegerMultiplicity (Ps t) ∧ (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (f ⁻¹' {t}) → Ps t ω = 0) ∧ ∀ ω : TestFormOn U n, Ps t ω = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → (∀ (P m : ℕ) (U : Set (Euclid P)) (X : ℕ → GeometricCurrentOn U (m + 1)), IsOpen U → (∀ r, IsIntegerMultiplicity (X r)) → ∑' r, (X r).mass ≠ ∞ → ∃ Y : GeometricCurrentOn U (m + 1), IsIntegerMultiplicity Y ∧ (∀ ω : TestFormOn U (m + 1), HasSum (fun r => X r ω) (Y ω)) ∧ Y.mass ≤ ∑' r, (X r).mass) → ∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 0 ≤ c ∧ ∀ (K : Set (Euclid P)) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsCompact K → IsIntegerMultiplicity T → IsIntegerMultiplicity T.boundary → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (K) → T ω = 0) → T.mass ≠ ∞ → T.boundary.mass ≠ ∞ → ∃ (Q : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R₁ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S₁ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q ∧ IsIntegerMultiplicity R₁ ∧ IsIntegerMultiplicity S₁ ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), T ω - Q ω = R₁.boundary ω + S₁ ω) ∧ Q.mass ≤ ENNReal.ofReal c * T.mass ∧ Q.boundary.mass ≤ ENNReal.ofReal c * T.boundary.mass ∧ R₁.mass ≤ ENNReal.ofReal c * T.mass ∧ S₁.mass ≤ ENNReal.ofReal c * T.boundary.mass ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) ({x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} ∩ cthickening (Real.sqrt P) K) → Q ω = 0) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 2), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 2))) (cthickening (Real.sqrt P) K) → R₁ ω = 0) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (cthickening (Real.sqrt P) K) → S₁ ω = 0 := by
  intro hSL hIMS P m hmP
  have hSL' := hSL Submission.dor_imrep_massOn_eq_measure_and_support
  -- constants: retraction `c_R`, good-centre `C`, `c₄ = 8(1 + √P c_R)` and `c`
  obtain ⟨cR, hcR, hRET⟩ := Submission.dor_lmb_fcd_retraction P m hmP
  obtain ⟨CG, hGC⟩ := Submission.dor_lmb_fcd_good_center P m hmP
  obtain ⟨push, homot, hPF1, hPF2, hPF3, hPF4, hPF5⟩ :=
    Submission.dor_lmb_fcd_pushforward_homotopy hIMS P
  have hsP : 0 ≤ Real.sqrt P := Real.sqrt_nonneg _
  have hC0 : (0 : ℝ) ≤ CG := NNReal.coe_nonneg CG
  obtain ⟨c₄, hc₄⟩ : ∃ c₄ : ℝ, c₄ = 8 * (1 + Real.sqrt P * cR) := ⟨_, rfl⟩
  have hc₄0 : 0 ≤ c₄ := by
    rw [hc₄]
    have := mul_nonneg hsP hcR.le
    linarith
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = max (max (c₄ ^ (m + 1) * (1 + 2 * (CG : ℝ)))
      (Real.sqrt P * (2 * c₄) ^ (m + 1) * (1 + 2 * (CG : ℝ))))
      (max (c₄ ^ m * (1 + 2 * (CG : ℝ))) (Real.sqrt P * (2 * c₄) ^ m * (1 + 2 * (CG : ℝ)))) :=
    ⟨_, rfl⟩
  have hc1 : c₄ ^ (m + 1) * (1 + 2 * (CG : ℝ)) ≤ c := by
    rw [hc]; exact le_max_of_le_left (le_max_left _ _)
  have hc2 : Real.sqrt P * (2 * c₄) ^ (m + 1) * (1 + 2 * (CG : ℝ)) ≤ c := by
    rw [hc]; exact le_max_of_le_left (le_max_right _ _)
  have hc3 : c₄ ^ m * (1 + 2 * (CG : ℝ)) ≤ c := by
    rw [hc]; exact le_max_of_le_right (le_max_left _ _)
  have hc4 : Real.sqrt P * (2 * c₄) ^ m * (1 + 2 * (CG : ℝ)) ≤ c := by
    rw [hc]; exact le_max_of_le_right (le_max_right _ _)
  refine ⟨c, le_trans (mul_nonneg (pow_nonneg hc₄0 _) (by positivity)) hc1, ?_⟩
  intro K T hK hTIM hBIM hTK hTmass hBmass
  -- the measures `μ_T`, `μ_∂T` of representations; `μ(ℝᴾ)` is the mass
  obtain ⟨RT, hRT⟩ := hTIM
  obtain ⟨RB, hRB⟩ := hBIM
  have hTuniv : RT.measure univ = T.mass :=
    ((Submission.dor_imrep_massOn_eq_measure_and_support P (m + 1) univ T RT isOpen_univ
      hRT).1 univ isOpen_univ).symm
  have hBuniv : RB.measure univ = T.boundary.mass :=
    ((Submission.dor_imrep_massOn_eq_measure_and_support P m univ T.boundary RB isOpen_univ
      hRB).1 univ isOpen_univ).symm
  have hTfin : IsFiniteMeasure RT.measure := ⟨by rw [hTuniv]; exact lt_top_iff_ne_top.2 hTmass⟩
  have hBfin : IsFiniteMeasure RB.measure := ⟨by rw [hBuniv]; exact lt_top_iff_ne_top.2 hBmass⟩
  -- good centre `a`, dual skeleton `L*(a)`, retraction `ψ`
  obtain ⟨a, ha, hGCa⟩ := hGC RT.measure RB.measure hTfin hBfin
  obtain ⟨ψ, hψ, hψLip⟩ := hRET a ha
  set Lstar : Set (Euclid P) :=
    {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z}
  have hdcont : Continuous fun x => infDist x Lstar := continuous_infDist_pt Lstar
  -- slices of `T` by `d = dist(·, L*(a))` and good radii `r_j ∈ (2^{-j-3}, 2^{-j-2})`
  obtain ⟨Ps, hPs1, hPs2⟩ := hSL' P m univ T RT RB (fun x => infDist x Lstar) 1 isOpen_univ hRT
    hRB (lipschitz_infDist_pt Lstar)
  have hab : ∀ j : ℕ, (1 / 2 : ℝ) ^ (j + 3) < (1 / 2) ^ (j + 2) := fun j =>
    pow_lt_pow_right_of_lt_one₀ (by norm_num) (by norm_num) (by omega)
  have hquarter : ∀ j : ℕ, (1 / 2 : ℝ) ^ (j + 2) ≤ 1 / 4 := fun j =>
    (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : 2 ≤ j + 2)).trans
      (by norm_num)
  choose r hr hrIM hrvan hrform hrmass using fun j : ℕ =>
    Submission.dor_lmb_fcd_sd_good_slice P m T RT RB (fun x => infDist x Lstar) 1 Ps
      ((1 / 2 : ℝ) ^ (j + 3)) ((1 / 2 : ℝ) ^ (j + 2)) hRT hdcont (hab j) hPs1 hPs2
  have hr0 : ∀ j, 0 < r j := fun j => (pow_pos (by norm_num) _).trans (hr j).1
  have hr14 : ∀ j, r j ≤ 1 / 4 := fun j => (hr j).2.le.trans (hquarter j)
  have hrsucc : ∀ j, r (j + 1) < r j := by
    intro j
    have h1 := (hr (j + 1)).2
    rw [show j + 1 + 2 = j + 3 by omega] at h1
    exact h1.trans (hr j).1
  have hranti : Antitone r := antitone_nat_of_succ_le fun j => (hrsucc j).le
  -- shells of `T` and `∂T` between consecutive good radii
  obtain ⟨W, A, D, hWIM, hDIM, hWvan, hDvan, hZvan, hW0bd, hWbd, hWsum, hW0mass, hWmass,
      hD0mass, hDmass, hAmass⟩ :=
    Submission.dor_lmb_fcd_sd_shells P m T RT RB K (fun x => infDist x Lstar) r
      (fun j => Ps (r j)) hRT hRB hK.isClosed hdcont hranti hTK hrform
  -- mass estimates (Simon (6), (7), (10))
  have hGCT : ∀ j : ℕ, RT.measure {x | infDist x Lstar < (1 / 2 : ℝ) ^ (j + 2)} ≤
      ENNReal.ofReal ((CG : ℝ) * (1 / 2) ^ ((j + 2) * (m + 2))) * T.mass := by
    intro j
    calc RT.measure {x | infDist x Lstar < (1 / 2 : ℝ) ^ (j + 2)}
        ≤ (CG : ℝ≥0∞) * ENNReal.ofReal (((1 / 2 : ℝ) ^ (j + 2)) ^ (m + 2)) * RT.measure univ :=
          (hGCa _ (by positivity) (hquarter j)).1
      _ = ENNReal.ofReal ((CG : ℝ) * (1 / 2) ^ ((j + 2) * (m + 2))) * T.mass := by
          rw [hTuniv, ← pow_mul, ENNReal.ofReal_mul hC0, ENNReal.ofReal_coe_nnreal]
  have hGCB : ∀ j : ℕ, RB.measure {x | infDist x Lstar < (1 / 2 : ℝ) ^ (j + 2)} ≤
      ENNReal.ofReal ((CG : ℝ) * (1 / 2) ^ ((j + 2) * (m + 2))) * T.boundary.mass := by
    intro j
    calc RB.measure {x | infDist x Lstar < (1 / 2 : ℝ) ^ (j + 2)}
        ≤ (CG : ℝ≥0∞) * ENNReal.ofReal (((1 / 2 : ℝ) ^ (j + 2)) ^ (m + 2)) * RB.measure univ :=
          (hGCa _ (by positivity) (hquarter j)).2
      _ = ENNReal.ofReal ((CG : ℝ) * (1 / 2) ^ ((j + 2) * (m + 2))) * T.boundary.mass := by
          rw [hBuniv, ← pow_mul, ENNReal.ofReal_mul hC0, ENNReal.ofReal_coe_nnreal]
  have hW0le : (W 0).mass ≤ T.mass := by
    rw [hW0mass, ← hTuniv]; exact measure_mono (subset_univ _)
  have hD0le : (D 0).mass ≤ T.boundary.mass := by
    rw [hD0mass, ← hBuniv]; exact measure_mono (subset_univ _)
  have hWle : ∀ j, (W (j + 1)).mass ≤
      ENNReal.ofReal ((CG : ℝ) * (1 / 2) ^ ((j + 2) * (m + 2))) * T.mass := by
    intro j
    rw [hWmass j]
    have hsub : {x | r (j + 1) ≤ infDist x Lstar ∧ infDist x Lstar < r j} ⊆
        {x | infDist x Lstar < (1 / 2 : ℝ) ^ (j + 2)} := fun x hx => hx.2.trans (hr j).2
    exact (measure_mono (μ := RT.measure) hsub).trans (hGCT j)
  have hDle : ∀ j, (D (j + 1)).mass ≤
      ENNReal.ofReal ((CG : ℝ) * (1 / 2) ^ ((j + 2) * (m + 2))) * T.boundary.mass := by
    intro j
    rw [hDmass j]
    have hsub : {x | r (j + 1) ≤ infDist x Lstar ∧ infDist x Lstar < r j} ⊆
        {x | infDist x Lstar < (1 / 2 : ℝ) ^ (j + 2)} := fun x hx => hx.2.trans (hr j).2
    exact (measure_mono (μ := RB.measure) hsub).trans (hGCB j)
  have hZle : ∀ j, (Ps (r j)).mass ≤
      ENNReal.ofReal (4 * (CG : ℝ) * (1 / 2) ^ ((j + 2) * (m + 1))) * T.mass := by
    intro j
    have hδpos : (0 : ℝ) < (1 / 2) ^ (j + 3) := by positivity
    have hsub : {x | (1 / 2 : ℝ) ^ (j + 3) < infDist x Lstar ∧
        infDist x Lstar < (1 / 2) ^ (j + 2)} ⊆ {x | infDist x Lstar < (1 / 2 : ℝ) ^ (j + 2)} :=
      fun x hx => hx.2
    have hstrip := (measure_mono (μ := RT.measure) hsub).trans (hGCT j)
    have hreal : (1 / 2 : ℝ) ^ (j + 3) * (4 * (CG : ℝ) * (1 / 2) ^ ((j + 2) * (m + 1))) =
        2 * ((CG : ℝ) * (1 / 2) ^ ((j + 2) * (m + 2))) := by
      rw [show (j + 2) * (m + 2) = (j + 2) * (m + 1) + (j + 2) by ring, pow_add]
      ring
    have hR : ENNReal.ofReal ((1 / 2 : ℝ) ^ (j + 3)) *
        (ENNReal.ofReal (4 * (CG : ℝ) * (1 / 2) ^ ((j + 2) * (m + 1))) * T.mass) =
        2 * (ENNReal.ofReal ((CG : ℝ) * (1 / 2) ^ ((j + 2) * (m + 2))) * T.mass) := by
      rw [← mul_assoc, ← ENNReal.ofReal_mul hδpos.le, hreal,
        ENNReal.ofReal_mul (show (0 : ℝ) ≤ 2 by norm_num), ENNReal.ofReal_ofNat, mul_assoc]
    have h1 := hrmass j
    rw [show (1 / 2 : ℝ) ^ (j + 2) - (1 / 2) ^ (j + 3) = (1 / 2) ^ (j + 3) by ring,
      ENNReal.coe_one, one_mul] at h1
    rw [← ENNReal.mul_le_mul_iff_right (ENNReal.ofReal_pos.2 hδpos).ne' ENNReal.ofReal_ne_top,
      hR]
    exact h1.trans (mul_le_mul' le_rfl hstrip)
  have hAtendsto : Tendsto (fun N => (A N).mass) atTop (𝓝 0) := by
    have hAle : ∀ N, (A N).mass ≤ ENNReal.ofReal ((CG : ℝ) * (1 / 2) ^ N) * T.mass := by
      intro N
      rw [hAmass N]
      have hsub : {x | infDist x Lstar < r N} ⊆ {x | infDist x Lstar < (1 / 2 : ℝ) ^ (N + 2)} :=
        fun x hx => lt_trans hx (hr N).2
      have hpow : (1 / 2 : ℝ) ^ ((N + 2) * (m + 2)) ≤ (1 / 2) ^ N :=
        pow_le_pow_of_le_one (by norm_num) (by norm_num) (by nlinarith)
      exact (measure_mono (μ := RT.measure) hsub).trans ((hGCT N).trans
        (mul_le_mul' (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hpow hC0)) le_rfl))
    have h1 : Tendsto (fun N : ℕ => (CG : ℝ) * (1 / 2) ^ N) atTop (𝓝 0) := by
      have := (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 2)
        (by norm_num)).const_mul (CG : ℝ)
      rwa [mul_zero] at this
    have h2 := ENNReal.Tendsto.mul_const (ENNReal.tendsto_ofReal h1) (Or.inr hTmass)
    rw [ENNReal.ofReal_zero, zero_mul] at h2
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds h2 (fun _ => zero_le)
      hAle
  -- globally Lipschitz pieces `φ_j = ψ` on `{d ≥ r_j}` with constants `Λ_j ≤ c₄ 2^j`
  have hψLipOn : ∀ j, LipschitzOnWith (Real.toNNReal (cR / r j)) ψ {x | r j ≤ infDist x Lstar} :=
    fun j => LipschitzOnWith.of_dist_le' fun x hx y hy => hψLip (r j) (hr0 j) (hr14 j) x y hx hy
  choose φ hφLip hφEq using fun j => Submission.dor_lmb_fcd_sd_lipschitz_extend P
    {x | r j ≤ infDist x Lstar} ψ (Real.toNNReal (cR / r j)) (hψLipOn j)
  obtain ⟨Λ, hΛ⟩ : ∃ Λ : ℕ → NNReal,
      ∀ j, Λ j = max 1 (NNReal.sqrt P * Real.toNNReal (cR / r j)) := ⟨_, fun j => rfl⟩
  have hφΛ : ∀ j, LipschitzWith (Λ j) (φ j) := fun j => by
    rw [hΛ]; exact (hφLip j).weaken (le_max_right _ _)
  have hΛ1 : ∀ j, 1 ≤ Λ j := fun j => by rw [hΛ]; exact le_max_left _ _
  have hΛmono : ∀ j, Λ j ≤ Λ (j + 1) := fun j => by
    rw [hΛ, hΛ]
    exact max_le_max le_rfl (mul_le_mul' le_rfl (Real.toNNReal_le_toNNReal
      (div_le_div_of_nonneg_left hcR.le (hr0 (j + 1)) (hranti (Nat.le_succ j)))))
  have hΛc₄ : ∀ j, (Λ j : ℝ) ≤ c₄ * 2 ^ j := fun j => by
    have h2j : (1 : ℝ) ≤ 2 ^ j := one_le_pow₀ (by norm_num)
    have hkey : cR / r j ≤ 8 * cR * 2 ^ j := by
      rw [div_le_iff₀ (hr0 j)]
      have h1 := mul_lt_mul_of_pos_left (hr j).1 (by positivity : (0 : ℝ) < 2 ^ j)
      have h2 : (2 : ℝ) ^ j * (1 / 2) ^ (j + 3) = 1 / 8 := by
        rw [pow_add, ← mul_assoc, ← mul_pow]; norm_num
      rw [h2] at h1
      nlinarith [mul_lt_mul_of_pos_left h1 hcR]
    rw [hΛ, NNReal.coe_max, NNReal.coe_one, NNReal.coe_mul, Real.coe_sqrt, NNReal.coe_natCast,
      Real.coe_toNNReal _ (div_nonneg hcR.le (hr0 j).le), hc₄]
    have h3 : 0 ≤ Real.sqrt P * cR * 2 ^ j :=
      mul_nonneg (mul_nonneg hsP hcR.le) (by positivity)
    refine max_le (by nlinarith) ?_
    nlinarith [mul_le_mul_of_nonneg_left hkey hsP]
  -- the compact sets `E_j = K ∩ {d ≥ r_j}` and the vanishing sets `F₁ = Lₙ ∩ K_√P`, `F₂ = K_√P`
  have hEcpt : ∀ j, IsCompact (K ∩ {x | r j ≤ infDist x Lstar}) := fun j =>
    hK.inter_right (isClosed_le continuous_const hdcont)
  have hEmono : ∀ j, K ∩ {x | r j ≤ infDist x Lstar} ⊆ K ∩ {x | r (j + 1) ≤ infDist x Lstar} :=
    fun j x hx => ⟨hx.1, (hranti (Nat.le_succ j)).trans hx.2⟩
  have hφψ : ∀ j, EqOn (φ j) ψ (K ∩ {x | r j ≤ infDist x Lstar}) := fun j x hx => hφEq j hx.2
  have hψdist : ∀ j, ∀ x ∈ K ∩ {x | r j ≤ infDist x Lstar}, dist (ψ x) x ≤ Real.sqrt P :=
    fun j x hx => (hψ x ((hr0 j).trans_le hx.2)).2
  have hψF₁ : ∀ j, ψ '' (K ∩ {x | r j ≤ infDist x Lstar}) ⊆
      {x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} ∩
        cthickening (Real.sqrt P) K := by
    rintro j _ ⟨x, hx, rfl⟩
    exact ⟨(hψ x ((hr0 j).trans_le hx.2)).1,
      mem_cthickening_of_dist_le _ x _ K hx.1 (hψdist j x hx)⟩
  have hψF₂ : ∀ j, ∀ x ∈ K ∩ {x | r j ≤ infDist x Lstar}, ∀ t ∈ Icc (0 : ℝ) 1,
      x + t • (ψ x - x) ∈ cthickening (Real.sqrt P) K := by
    intro j x hx t ht
    refine mem_cthickening_of_dist_le _ x _ K hx.1 ?_
    rw [dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_eq_abs, abs_of_nonneg ht.1,
      ← dist_eq_norm]
    calc t * dist (ψ x) x ≤ 1 * Real.sqrt P :=
          mul_le_mul ht.2 (hψdist j x hx) dist_nonneg zero_le_one
      _ = Real.sqrt P := one_mul _
  -- deform the shells and sum them (Simon (11)–(25))
  exact Submission.dor_lmb_fcd_sd_core hIMS P m push homot hPF1 hPF2 hPF3 hPF4 hPF5 c c₄ CG T
    ψ (fun j => K ∩ {x | r j ≤ infDist x Lstar}) φ Λ W A D (fun j => Ps (r j))
    ({x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} ∩
      cthickening (Real.sqrt P) K) (cthickening (Real.sqrt P) K)
    hc₄0 hC0 hc1 hc2 hc3 hc4 hTmass hBmass hEcpt hEmono hφΛ hΛ1 hΛmono hΛc₄ hφψ hψdist hψF₁
    hψF₂ hWIM hDIM hrIM hWvan hDvan hZvan hW0bd hWbd hWsum hW0le hWle hD0le hDle hZle hAtendsto

/-- **Face representation** (Simon Ch. 6, proof of 5.1, (26)–(28) and (33)).  Let
`Q ∈ 𝒟ₙ(ℝᴾ)`, `n = m + 1`, be integer multiplicity and vanish off the closed set `E`, `Hⁿ`-almost
all of which lies in the open unit faces `A_p = Φ_p(Q₁)`, `p ∈ s`.  Then
`Q(ω) = Σ_p ∫_{Q₁} u_p(y) ω(Φ_p(y))(e_p) dy` with integer-valued `u_p` integrable on `Q₁` and
`Σ_p ∫_{Q₁} |u_p| ≤ M(Q)`.  For an `IMRep` `(M, θ, ξ)` of `Q`, `μ_Q(ℝᴾ ∖ E) = M_{ℝᴾ∖E}(Q) = 0`, so
`M` lies `Hⁿ`-a.e. in the pairwise disjoint `A_p`.  On `M_p = M ∩ A_p ⊆ z + V_ι`, `TₓM_p = TₓM`
a.e., so `ξ = σ_p e_p^*` a.e. for a Borel sign `σ_p`, read off from `ξ(dx^ι)`.  Then
`u_p = (θ σ_p 1_{M_p}) ∘ Φ_p`, and `Hⁿ⌞F_p = Φ_p#(volume⌞Q₁)` transports the integrals. -/
theorem Submission.dor_lmb_fcd_fr_face_representation : ∀ (P m : ℕ) (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (E : Set (Euclid P)) (Q : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ p ∈ s, StrictMono p.2) → IsClosed E → (∀ᵐ x ∂(μHE[m + 1].restrict E), ∃ p ∈ s, ∃ y : Euclid (m + 1), (∀ i, 0 < y i ∧ y i < 1) ∧ WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ) = x) → IsIntegerMultiplicity Q → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) E → Q ω = 0) → ∃ u : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid (m + 1) → ℝ, (∀ p ∈ s, ∀ y, ∃ z : ℤ, u p y = z) ∧ (∀ p ∈ s, IntegrableOn (u p) {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}) ∧ ENNReal.ofReal (∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u p y|) ≤ Q.mass ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Q ω = ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, u p y * (ω : DifferentialForm (Euclid P) (m + 1)) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) := by
  intro P m s E Q hs hE hcov hQ hvan
  classical
  obtain ⟨R, hR⟩ := hQ
  -- `Φ_p(y) = z + Σ_j y_j e_{ι(j)}`, the open cube `Q₁ = (0, 1)ⁿ` and the closed face `F_p`
  set Φ : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid (m + 1) → Euclid P := fun p y =>
    WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)
  set Q₁ : Set (Euclid (m + 1)) := {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}
  set F : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Set (Euclid P) := fun p =>
    {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧
      (i ∉ Set.range p.2 → x i = p.1 i)}
  /- Step 1 (face geometry): `Hⁿ⌞F_p = Φ_p#(volume⌞Q₁)`, `∫_{F_p} h dHⁿ = ∫_{Q₁} h ∘ Φ_p`,
  `Φ_p(Q̄₁) ⊆ F_p`, `Φ_p` is an isometry, `F_p` is closed and bounded, and the open face
  `A_p = Φ_p(Q₁)` misses every other face `F_q`. -/
  have hF3 : ∀ p ∈ s, (μHE[m + 1] : Measure (Euclid P)).restrict (F p) =
      Measure.map (Φ p) (volume.restrict Q₁) := fun p hp =>
    (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.1
  have hF4 : ∀ p ∈ s, ∀ h : Euclid P → ℝ,
      ∫ x in F p, h x ∂μHE[m + 1] = ∫ y in Q₁, h (Φ p y) := fun p hp =>
    (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.1
  have hF5 : ∀ p ∈ s, ∀ y : Euclid (m + 1), (∀ i, 0 ≤ y i ∧ y i ≤ 1) → Φ p y ∈ F p :=
    fun p hp => (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.2.1
  have hF6 : ∀ p ∈ s, ∀ y y' : Euclid (m + 1), dist (Φ p y) (Φ p y') = dist y y' :=
    fun p hp => (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.2.2.1
  have hF7 : ∀ p ∈ s, ∀ x ∈ F p, ∀ x' ∈ F p, dist x x' ≤ Real.sqrt P :=
    fun p hp => (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.2.2.2.1
  have hF8 : ∀ p ∈ s, IsClosed (F p) :=
    fun p hp => (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.2.2.2.2.1
  have hF9 : ∀ p ∈ s, ∀ q : (Fin P → ℤ) × (Fin (m + 1) → Fin P), StrictMono q.2 → q ≠ p →
      ∀ y ∈ Q₁, Φ p y ∉ F q :=
    fun p hp => (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.2.2.2.2.2
  have hFc : ∀ p ∈ s, IsCompact (F p) := fun p hp =>
    isCompact_of_isClosed_isBounded (hF8 p hp) (isBounded_iff.mpr ⟨_, hF7 p hp⟩)
  have hΦemb : ∀ p ∈ s, MeasurableEmbedding (Φ p) := fun p hp =>
    (Isometry.of_dist_eq (hF6 p hp)).isClosedEmbedding.measurableEmbedding
  have hQ₁m : MeasurableSet Q₁ := by
    have hQ₁' : Q₁ = ⋂ i, {y : Euclid (m + 1) | 0 < y i} ∩ {y | y i < 1} := by
      ext y
      simp only [Q₁, Set.mem_ofPred_eq, mem_iInter, mem_inter_iff]
    rw [hQ₁']
    exact MeasurableSet.iInter fun i =>
      (measurableSet_lt measurable_const (PiLp.continuous_apply 2 _ i).measurable).inter
        (measurableSet_lt (PiLp.continuous_apply 2 _ i).measurable measurable_const)
  have hAm : ∀ p ∈ s, MeasurableSet (Φ p '' Q₁) := fun p hp =>
    (hΦemb p hp).measurableSet_image.mpr hQ₁m
  have hAF : ∀ p ∈ s, Φ p '' Q₁ ⊆ F p := by
    rintro p hp _ ⟨y, hy, rfl⟩
    exact hF5 p hp y fun i => ⟨(hy i).1.le, (hy i).2.le⟩
  have hAdisj : (s : Set ((Fin P → ℤ) × (Fin (m + 1) → Fin P))).PairwiseDisjoint
      fun p => Φ p '' Q₁ := by
    intro p hp q hq hpq
    refine Set.disjoint_left.mpr ?_
    rintro _ ⟨y, hy, rfl⟩ hyq
    exact hF9 p hp q (hs q hq) (Ne.symm hpq) y hy (hAF q hq hyq)
  /- Step 2: an integer multiplicity representation `R = (M, θ, ξ)` of `Q`, its measure
  `μ_R = θ Hⁿ⌞M`, and `M_W(Q) = μ_R(W)` for open `W` (C1). -/
  have hMm : MeasurableSet R.carrier := R.measurableSet_carrier
  have hθm : Measurable fun x => (R.mult x : ℝ) := measurable_from_nat.comp R.measurable_mult
  have hθm' : Measurable fun x => (R.mult x : ℝ≥0∞) := measurable_from_nat.comp R.measurable_mult
  have hfinθ : ∀ K : Set (Euclid P), IsCompact K →
      ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[m + 1] ≠ ∞ :=
    fun K hK => R.locallyIntegrable_mult K hK (subset_univ K)
  -- `Hⁿ(M ∩ B) ≤ ∫_{M ∩ B} θ dHⁿ`, as `θ ≥ 1` on `M`
  have hHle : ∀ B : Set (Euclid P),
      μHE[m + 1] (R.carrier ∩ B) ≤ ∫⁻ x in R.carrier ∩ B, (R.mult x : ℝ≥0∞) ∂μHE[m + 1] := by
    intro B
    calc μHE[m + 1] (R.carrier ∩ B) = ∫⁻ _ in R.carrier ∩ B, (1 : ℝ≥0∞) ∂μHE[m + 1] := by
          rw [setLIntegral_one]
      _ ≤ ∫⁻ x in R.carrier ∩ B, (R.mult x : ℝ≥0∞) ∂μHE[m + 1] := by
          refine setLIntegral_mono hθm' ?_
          intro x hx
          exact_mod_cast R.mult_pos x hx.1
  have hfinM : ∀ K : Set (Euclid P), IsCompact K → K ⊆ univ → μHE[m + 1] (R.carrier ∩ K) ≠ ∞ :=
    fun K hK _ => ne_top_of_le_ne_top (hfinθ K hK) (hHle K)
  have hμR : ∀ B : Set (Euclid P), MeasurableSet B →
      R.measure B = ∫⁻ x in R.carrier ∩ B, (R.mult x : ℝ≥0∞) ∂μHE[m + 1] := by
    intro B hB
    rw [IMRep.measure, withDensity_apply _ hB, Measure.restrict_restrict hB, inter_comm]
  have hC1 := (Submission.dor_imrep_massOn_eq_measure_and_support P (m + 1) univ Q R isOpen_univ
    hR).1
  /- Step 3: `M` is carried by the open faces.  `M_{ℝᴾ∖E}(Q) = 0` since every admissible form is
  supported off `E`, so `Hⁿ(M ∖ E) = 0`; and `Hⁿ(E ∖ ⋃_p A_p) = 0` by hypothesis. -/
  have hmassEc : Q.massOn Eᶜ = 0 := by
    refine le_antisymm (sSup_le ?_) zero_le
    rintro _ ⟨ω, ⟨hωE, -⟩, rfl⟩
    show ENNReal.ofReal (Q ω) ≤ 0
    rw [hvan ω (subset_compl_iff_disjoint_right.mp hωE), ENNReal.ofReal_zero]
  have hMEc : μHE[m + 1] (R.carrier ∩ Eᶜ) = 0 := by
    refine le_antisymm ((hHle Eᶜ).trans (le_of_eq ?_)) zero_le
    rw [← hμR Eᶜ hE.isOpen_compl.measurableSet, ← hC1 Eᶜ hE.isOpen_compl, hmassEc]
  have hEcov : μHE[m + 1] (E \ ⋃ p ∈ s, Φ p '' Q₁) = 0 := by
    have h := ae_iff.mp hcov
    rw [Measure.restrict_apply' hE.measurableSet] at h
    refine measure_mono_null ?_ h
    rintro x ⟨hxE, hxA⟩
    refine ⟨?_, hxE⟩
    rintro ⟨p, hp, y, hy, hxy⟩
    exact hxA (mem_iUnion₂.mpr ⟨p, hp, y, hy, hxy⟩)
  -- the pieces `M_p = M ∩ A_p`
  obtain ⟨Mp, hMp⟩ : ∃ Mp : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Set (Euclid P),
      ∀ p, Mp p = R.carrier ∩ Φ p '' Q₁ := ⟨_, fun _ => rfl⟩
  have hMpm : ∀ p ∈ s, MeasurableSet (Mp p) := fun p hp => by
    rw [hMp p]
    exact hMm.inter (hAm p hp)
  have hMpM : ∀ p, Mp p ⊆ R.carrier := fun p => by
    rw [hMp p]
    exact inter_subset_left
  have hMpF : ∀ p ∈ s, Mp p ⊆ F p := fun p hp => by
    rw [hMp p]
    exact inter_subset_right.trans (hAF p hp)
  have hMpdisj : (s : Set ((Fin P → ℤ) × (Fin (m + 1) → Fin P))).PairwiseDisjoint Mp :=
    hAdisj.mono fun p => by
      rw [hMp p]
      exact inter_subset_right
  have hMae : R.carrier =ᵐ[μHE[m + 1]] ⋃ p ∈ s, Mp p := by
    refine ae_eq_set.mpr ⟨measure_mono_null ?_ (measure_union_null hMEc hEcov), ?_⟩
    · rintro x ⟨hxM, hx⟩
      by_cases hxE : x ∈ E
      · refine mem_union_right _ ⟨hxE, fun hxA => hx ?_⟩
        obtain ⟨p, hp, hxp⟩ := mem_iUnion₂.mp hxA
        refine mem_iUnion₂.mpr ⟨p, hp, ?_⟩
        rw [hMp p]
        exact ⟨hxM, hxp⟩
      · exact mem_union_left _ ⟨hxM, hxE⟩
    · rw [sdiff_eq_empty.mpr (iUnion₂_subset fun p _ => hMpM p)]
      exact measure_empty
  /- Steps 4–5: on `M_p`, `ξ = σ_p e_p^*` a.e. for a Borel sign `σ_p`.  The orientation `ξ(x)`
  orients `TₓM = TₓM_p` (IMC(a)); `M_p ⊆ z + V_ι`, so `ξ(x) = ±e_p^*` (plane orientation); the
  sign is read off from `ξ'(x)(dx^ι)` with `dx^ι(e_p) = 1` and `ξ'` a Borel version of `ξ`. -/
  obtain ⟨dx, hdx, -⟩ := Submission.dor_lmb_fcd_fr_coordinate_covectors P (m + 1)
  have hdxe : ∀ p ∈ s, dx p.2 (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) = 1 :=
    fun p hp => (hdx p.2 p.2 (hs p hp) (hs p hp)).trans (ite_eq_left rfl)
  obtain ⟨ξ', hξ'm, hξξ'⟩ : ∃ ξ' : Euclid P → MultiVector P (m + 1), StronglyMeasurable ξ' ∧
      R.orient =ᵐ[μHE[m + 1].restrict R.carrier] ξ' :=
    ⟨_, R.aestronglyMeasurable_orient.stronglyMeasurable_mk,
      R.aestronglyMeasurable_orient.ae_eq_mk⟩
  obtain ⟨σ, hσ⟩ : ∃ σ : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid P → ℝ,
      ∀ p x, σ p x = if 0 ≤ ξ' x (dx p.2) then 1 else -1 := ⟨_, fun _ _ => rfl⟩
  have hσm : ∀ p, Measurable (σ p) := by
    intro p
    have hev : Measurable fun x => ξ' x (dx p.2) :=
      ((continuous_eval_const (dx p.2)).comp_stronglyMeasurable hξ'm).measurable
    rw [show σ p = fun x => if 0 ≤ ξ' x (dx p.2) then (1 : ℝ) else -1 from funext (hσ p)]
    exact Measurable.ite (measurableSet_le measurable_const hev) measurable_const measurable_const
  have hσabs : ∀ p x, |σ p x| = 1 := by
    intro p x
    rw [hσ p x]
    split_ifs <;> simp
  have hor : ∀ p ∈ s, ∀ᵐ x ∂(μHE[m + 1].restrict (Mp p)), ∀ α : Covector (Euclid P) (m + 1),
      R.orient x α = σ p x * α (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) := by
    intro p hp
    -- (b) `TₓM_p = TₓM` a.e. on `M_p` (IMC(a))
    have hIMC := Submission.cmc_imRep_locality_restrict_sub.1 P (m + 1) univ (Mp p) R.carrier
      isOpen_univ (hMpm p hp) hMm (hMpM p) (subset_univ _) hfinM
    -- (a) `ξ(x)` orients `TₓM` a.e. on `M ⊇ M_p`
    have hori : ∀ᵐ x ∂(μHE[m + 1].restrict (Mp p)), ∃ Q' : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt (m + 1) R.carrier x Q' ∧
          IsUnitOrientationOf (R.orient x) Q' :=
      ae_restrict_of_ae_restrict_of_subset (hMpM p) R.orients
    have hξ'p : ∀ᵐ x ∂(μHE[m + 1].restrict (Mp p)), R.orient x = ξ' x :=
      ae_restrict_of_ae_restrict_of_subset (hMpM p) hξξ'
    filter_upwards [hIMC, hori, hξ'p, ae_restrict_mem (hMpm p hp)] with x hxT hxo hxξ hxM
    obtain ⟨Q', hQ'M, hQ'ξ⟩ := hxo
    -- (c) `M_p ⊆ F_p` lies in the plane `x_i = z_i` (`i ∉ range ι`)
    have hcoord : ∀ a ∈ Mp p, ∀ i, (∀ j, p.2 j ≠ i) → a i = x i := by
      intro a ha i hi
      have hi' : i ∉ Set.range p.2 := by
        rintro ⟨j, hj⟩
        exact hi j hj
      have haF : ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ a i ∧ a i ≤ p.1 i + 1) ∧
          (i ∉ Set.range p.2 → a i = p.1 i) := hMpF p hp ha
      have hxF : ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧
          (i ∉ Set.range p.2 → x i = p.1 i) := hMpF p hp hxM
      rw [(haF i).2 hi', (hxF i).2 hi']
    rcases Submission.dor_lmb_fcd_fr_plane_orientation P (m + 1) p.2 (Mp p) x Q' (R.orient x)
        (hs p hp) hcoord ((hxT Q').mpr hQ'M) hQ'ξ with h | h
    · -- `ξ(x) = e_p^*`, so `ξ'(x)(dx^ι) = 1` and `σ_p(x) = 1`
      have hv : ξ' x (dx p.2) = 1 := by
        rw [← hxξ, h, hdxe p hp]
      intro α
      rw [h α, hσ p x, ite_eq_left (by rw [hv]; exact zero_le_one), one_mul]
    · -- `ξ(x) = -e_p^*`, so `ξ'(x)(dx^ι) = -1` and `σ_p(x) = -1`
      have hv : ξ' x (dx p.2) = -1 := by
        rw [← hxξ, h, hdxe p hp]
      intro α
      rw [h α, hσ p x, ite_eq_right (by rw [hv]; norm_num), neg_one_mul]
  /- Step 6: the densities `f_p = θ σ_p 1_{M_p}` on `ℝᴾ` and `u_p = f_p ∘ Φ_p` on `ℝⁿ`. -/
  obtain ⟨f, hf⟩ : ∃ f : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid P → ℝ,
      ∀ p, f p = (Mp p).indicator fun x => (R.mult x : ℝ) * σ p x := ⟨_, fun _ => rfl⟩
  have hfm : ∀ p ∈ s, Measurable (f p) := fun p hp => by
    rw [hf p]
    exact (hθm.mul (hσm p)).indicator (hMpm p hp)
  have hfabs : ∀ p x, |f p x| = (Mp p).indicator (fun x => (R.mult x : ℝ)) x := by
    intro p x
    rw [hf p]
    by_cases hx : x ∈ Mp p
    · rw [indicator_of_mem hx, indicator_of_mem hx, abs_mul, hσabs, mul_one, Nat.abs_cast]
    · rw [indicator_of_notMem hx, indicator_of_notMem hx, abs_zero]
  /- Step 7: integrability and the mass bound.  `∫_{M_p} θ dHⁿ ≤ ∫_{M ∩ F_p} θ dHⁿ < ∞`. -/
  have hlin : ∀ p ∈ s, ∫⁻ x in Mp p, (R.mult x : ℝ≥0∞) ∂μHE[m + 1] ≠ ∞ := fun p hp =>
    ne_top_of_le_ne_top (hfinθ (F p) (hFc p hp))
      (lintegral_mono_set (subset_inter (hMpM p) (hMpF p hp)))
  have hθint : ∀ p ∈ s, IntegrableOn (fun x => (R.mult x : ℝ)) (Mp p) μHE[m + 1] := by
    intro p hp
    have h := integrable_toReal_of_lintegral_ne_top hθm'.aemeasurable (hlin p hp)
    simp only [ENNReal.toReal_natCast] at h
    exact h
  have hfint : ∀ p ∈ s, IntegrableOn (f p) (F p) μHE[m + 1] := by
    intro p hp
    have hb : IntegrableOn ((Mp p).indicator fun x => (R.mult x : ℝ)) (F p) μHE[m + 1] := by
      refine (integrable_indicator_iff (hMpm p hp)).mpr ?_
      show Integrable _ ((μHE[m + 1].restrict (F p)).restrict (Mp p))
      rw [Measure.restrict_restrict (hMpm p hp), inter_eq_left.mpr (hMpF p hp)]
      exact hθint p hp
    exact hb.mono' (hfm p hp).aestronglyMeasurable
      (ae_of_all _ fun x => (Real.norm_eq_abs _).trans_le (hfabs p x).le)
  -- `∫_{Q₁} |u_p| = ∫_{F_p} |f_p| dHⁿ = ∫_{M_p} θ dHⁿ = μ_R(A_p)`
  have hint_eq : ∀ p ∈ s, ∫ y in Q₁, |f p (Φ p y)| = (R.measure (Φ p '' Q₁)).toReal := by
    intro p hp
    calc ∫ y in Q₁, |f p (Φ p y)| = ∫ x in F p, |f p x| ∂μHE[m + 1] :=
          (hF4 p hp fun x => |f p x|).symm
      _ = ∫ x in F p, (Mp p).indicator (fun x => (R.mult x : ℝ)) x ∂μHE[m + 1] :=
          integral_congr_ae (ae_of_all _ fun x => hfabs p x)
      _ = ∫ x in Mp p, (R.mult x : ℝ) ∂μHE[m + 1] := by
          rw [setIntegral_indicator (hMpm p hp), inter_eq_right.mpr (hMpF p hp)]
      _ = (∫⁻ x in Mp p, ENNReal.ofReal (R.mult x : ℝ) ∂μHE[m + 1]).toReal :=
          integral_eq_lintegral_of_nonneg_ae (ae_of_all _ fun x => Nat.cast_nonneg _)
            hθm.aestronglyMeasurable
      _ = (R.measure (Φ p '' Q₁)).toReal := by
          rw [hμR _ (hAm p hp), ← hMp p]
          simp only [ENNReal.ofReal_natCast]
  have hAfin : ∀ p ∈ s, R.measure (Φ p '' Q₁) ≠ ∞ := by
    intro p hp
    refine ne_top_of_le_ne_top ?_ (measure_mono (hAF p hp))
    rw [hμR (F p) (hF8 p hp).measurableSet]
    exact hfinθ (F p) (hFc p hp)
  refine ⟨fun p y => f p (Φ p y), ?_, ?_, ?_, ?_⟩
  · -- `u_p` is integer-valued: `θ ∈ ℕ`, `σ_p ∈ {1, -1}`
    intro p _ y
    show ∃ z : ℤ, f p (Φ p y) = z
    rw [hf p]
    by_cases hy : Φ p y ∈ Mp p
    · rw [indicator_of_mem hy, hσ p]
      split_ifs
      · exact ⟨R.mult (Φ p y), by push_cast; ring⟩
      · exact ⟨-(R.mult (Φ p y) : ℤ), by push_cast; ring⟩
    · exact ⟨0, by rw [indicator_of_notMem hy, Int.cast_zero]⟩
  · -- `u_p = f_p ∘ Φ_p` is integrable on `Q₁`, since `Hⁿ⌞F_p = Φ_p#(volume⌞Q₁)`
    intro p hp
    have h1 : Integrable (f p) (Measure.map (Φ p) (volume.restrict Q₁)) := by
      rw [← hF3 p hp]
      exact hfint p hp
    exact (hΦemb p hp).integrable_map_iff.mp h1
  · -- `Σ_p ∫_{Q₁} |u_p| = Σ_p μ_R(A_p) = μ_R(⋃_p A_p) ≤ μ_R(ℝᴾ) = M(Q)`
    calc ENNReal.ofReal (∑ p ∈ s, ∫ y in Q₁, |f p (Φ p y)|)
        = ∑ p ∈ s, ENNReal.ofReal (∫ y in Q₁, |f p (Φ p y)|) :=
          ENNReal.ofReal_sum_of_nonneg fun p _ => integral_nonneg fun y => abs_nonneg _
      _ = ∑ p ∈ s, R.measure (Φ p '' Q₁) := Finset.sum_congr rfl fun p hp => by
          rw [hint_eq p hp, ENNReal.ofReal_toReal (hAfin p hp)]
      _ = R.measure (⋃ p ∈ s, Φ p '' Q₁) := (measure_biUnion_finset hAdisj hAm).symm
      _ ≤ R.measure univ := measure_mono (subset_univ _)
      _ = Q.mass := (hC1 univ isOpen_univ).symm
  · /- Step 8: `Q(ω) = ∫_M θ ξ(ω) dHⁿ = Σ_p ∫_{M_p} θ σ_p ω(e_p) dHⁿ
    = Σ_p ∫_{F_p} f_p ω(e_p) dHⁿ = Σ_p ∫_{Q₁} u_p ω(Φ_p(·))(e_p)`. -/
    intro ω
    show Q ω = ∑ p ∈ s, ∫ y in Q₁, f p (Φ p y) * (ω : DifferentialForm (Euclid P) (m + 1)) (Φ p y)
      (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))
    obtain ⟨⟨hsmooth, hcpt⟩, -⟩ := ω.2
    -- `x ↦ ω(x)(e_p)` is continuous with compact support, hence bounded
    have hωe : ∀ p : (Fin P → ℤ) × (Fin (m + 1) → Fin P),
        Continuous (fun x => (ω : DifferentialForm (Euclid P) (m + 1)) x
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) ∧
        ∃ C, ∀ x, ‖(ω : DifferentialForm (Euclid P) (m + 1)) x
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))‖ ≤ C := by
      intro p
      have hc := hsmooth.continuous.eval_const (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))
      refine ⟨hc, hc.bounded_above_of_compact_support ?_⟩
      exact hcpt.comp_left (g := fun α : Covector (Euclid P) (m + 1) =>
        α (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) rfl
    -- the integrand `g = θ ξ(ω)` of `Q(ω)` is `θ σ_p ω(e_p)` a.e. on `M_p`
    obtain ⟨g, hg⟩ : ∃ g : Euclid P → ℝ, ∀ x,
        g x = (R.mult x : ℝ) * R.orient x ((ω : DifferentialForm (Euclid P) (m + 1)) x) :=
      ⟨_, fun _ => rfl⟩
    have hk : ∀ p ∈ s, g =ᵐ[μHE[m + 1].restrict (Mp p)] fun x => (R.mult x : ℝ) * σ p x *
        (ω : DifferentialForm (Euclid P) (m + 1)) x
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) := by
      intro p hp
      filter_upwards [hor p hp] with x hx
      rw [hg x, hx, mul_assoc]
    have hkint : ∀ p ∈ s, IntegrableOn (fun x => (R.mult x : ℝ) * σ p x *
        (ω : DifferentialForm (Euclid P) (m + 1)) x
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) (Mp p) μHE[m + 1] := by
      intro p hp
      have hθσ : IntegrableOn (fun x => (R.mult x : ℝ) * σ p x) (Mp p) μHE[m + 1] := by
        refine (hθint p hp).mono' (hθm.mul (hσm p)).aestronglyMeasurable (ae_of_all _ fun x => ?_)
        rw [Real.norm_eq_abs, abs_mul, hσabs, mul_one, Nat.abs_cast]
      obtain ⟨hc, C, hC⟩ := hωe p
      exact hθσ.mul_bdd hc.aestronglyMeasurable (ae_of_all _ hC)
    have hgint : ∀ p ∈ s, IntegrableOn g (Mp p) μHE[m + 1] := fun p hp =>
      (hkint p hp).congr (hk p hp).symm
    -- each piece transported to the cube
    have hpiece : ∀ p ∈ s, ∫ x in Mp p, g x ∂μHE[m + 1] = ∫ y in Q₁, f p (Φ p y) *
        (ω : DifferentialForm (Euclid P) (m + 1)) (Φ p y)
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) := by
      intro p hp
      have hfun : (fun x => f p x * (ω : DifferentialForm (Euclid P) (m + 1)) x
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) = fun x => (Mp p).indicator
            (fun x => (R.mult x : ℝ) * σ p x * (ω : DifferentialForm (Euclid P) (m + 1)) x
              (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) x := by
        funext x
        rw [hf p]
        exact (indicator_mul_left (Mp p) (fun x => (R.mult x : ℝ) * σ p x) fun x =>
          (ω : DifferentialForm (Euclid P) (m + 1)) x
            (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))).symm
      calc ∫ x in Mp p, g x ∂μHE[m + 1]
          = ∫ x in Mp p, (R.mult x : ℝ) * σ p x * (ω : DifferentialForm (Euclid P) (m + 1)) x
              (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) ∂μHE[m + 1] :=
            integral_congr_ae (hk p hp)
        _ = ∫ x in F p, f p x * (ω : DifferentialForm (Euclid P) (m + 1)) x
              (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) ∂μHE[m + 1] := by
            rw [hfun, setIntegral_indicator (hMpm p hp), inter_eq_right.mpr (hMpF p hp)]
        _ = _ := hF4 p hp _
    calc Q ω = ∫ x in R.carrier, g x ∂μHE[m + 1] := by
          rw [hR ω, IMRep.action]
          exact integral_congr_ae (ae_of_all _ fun x => (hg x).symm)
      _ = ∫ x in ⋃ p ∈ s, Mp p, g x ∂μHE[m + 1] := setIntegral_congr_set hMae
      _ = ∑ p ∈ s, ∫ x in Mp p, g x ∂μHE[m + 1] := integral_biUnion_finset s hMpm hMpdisj hgint
      _ = _ := Finset.sum_congr rfl hpiece

/-- **Divergence-form test forms near a face** (Simon Ch. 6, (28), by the arguments of 2.34–2.35).
For the face `Φ_p(y) = z + Σⱼ yⱼ e_{ι(j)}` and `g : ℝⁿ → ℝⁿ` smooth with compact support and
`|g| ≤ 1`, put `ω = χ Σ_l (-1)^l (g_l ∘ π) dx^{J_l}` with `J_l = ι ∘ succAbove l`, the face
coordinates `π(x)_k = x_{ι(k)} - z_{ι(k)}` and the normal cut-off `χ = η(|x - Φ_p(π x)|²)`, `η = 1`
on `[0, δ²/2]` and `η = 0` on `[δ², ∞)`.  The `dx^{J_l}` are orthonormal, so `|ω| = χ |g ∘ π| ≤ 1`;
`spt ω` lies in `{|x - Φ_p(π x)| ≤ δ} ∩ π⁻¹(spt g)`; and near the face
`ω(x)(e_{J_i}) = (-1)^i gᵢ(π x)`, so the alternating-sum formula for `d` gives
`dω(Φ_p y)(e_p) = Σᵢ ∂ᵢgᵢ(y) = trace Dg(y)`. -/
theorem Submission.dor_lmb_fcd_fr_divergence_form : ∀ (P m : ℕ) (p : (Fin P → ℤ) × (Fin (m + 1) → Fin P)) (g : Euclid (m + 1) → Euclid (m + 1)) (δ : ℝ), StrictMono p.2 → ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → (∀ y, ‖g y‖ ≤ 1) → 0 < δ → ∃ ω : TestFormOn (univ : Set (Euclid P)) m, (∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) m) x) ≤ 1) ∧ (∀ x ∈ tsupport (ω : DifferentialForm (Euclid P) m), ∃ y ∈ tsupport g, dist x (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) ≤ δ) ∧ ∀ y : Euclid (m + 1), exteriorDerivative (ω : DifferentialForm (Euclid P) m) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) = LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) := by
  intro P m p g δ hι hg hgc hg1 hδ
  -- 1. coordinate covectors `dx^J`
  obtain ⟨dx, hdx, hdxn⟩ := Submission.dor_lmb_fcd_fr_coordinate_covectors P m
  -- 2. the frames `J l = ι ∘ succAbove l`: strictly increasing and pairwise distinct
  let J : Fin (m + 1) → Fin m → Fin P := fun l r => p.2 (l.succAbove r)
  have hJ : ∀ l, StrictMono (J l) := fun l => hι.comp (Fin.strictMono_succAbove l)
  have hJinj : Injective J := by
    intro l l' h
    apply Fin.succAbove_left_injective
    funext r
    exact hι.injective (congrFun h r)
  -- the face map `Φ` and the face coordinates `π x = πL x - πL z`, with `π ∘ Φ = id`
  let z : Euclid P := WithLp.toLp 2 (fun i => (p.1 i : ℝ))
  let Φ : Euclid (m + 1) → Euclid P := fun y =>
    z + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)
  let πL : Euclid P →L[ℝ] Euclid (m + 1) :=
    (EuclideanSpace.equiv (Fin (m + 1)) ℝ).symm.toContinuousLinearMap.comp
      (ContinuousLinearMap.pi fun k => EuclideanSpace.proj (p.2 k))
  have hπL : ∀ x k, πL x k = x (p.2 k) := fun x k => rfl
  have hπLe : ∀ j, πL (EuclideanSpace.single (p.2 j) (1 : ℝ)) = EuclideanSpace.single j 1 := by
    intro j
    ext k
    simp [hπL, PiLp.single_apply, hι.injective.eq_iff]
  let π : Euclid P → Euclid (m + 1) := fun x => πL x - πL z
  have hπΦ : ∀ y, π (Φ y) = y := by
    intro y
    simp only [π, Φ, map_add, add_sub_cancel_left, map_sum, map_smul, hπLe]
    ext k
    simp [Pi.single_apply]
  -- the squared normal distance `ν x = |x - Φ(π x)|²` and the cut-off `χ = η ∘ ν`
  let ν : Euclid P → ℝ := fun x => ‖x - Φ (π x)‖ ^ 2
  let χ : Euclid P → ℝ := fun x => Real.smoothTransition (2 - 2 * ν x / δ ^ 2)
  -- 3. the form `ω = Σ_l (-1)^l χ (g_l ∘ π) dx^{J l}`
  let c : Fin (m + 1) → Euclid P → ℝ := fun l x => (-1) ^ (l : ℕ) * χ x * g (π x) l
  let ω : DifferentialForm (Euclid P) m := fun x => ∑ l, c l x • dx (J l)
  have hcoord : ∀ j : Fin (m + 1), ContDiff ℝ (⊤ : ℕ∞) fun y : Euclid (m + 1) => y j :=
    fun j => (EuclideanSpace.proj j : Euclid (m + 1) →L[ℝ] ℝ).contDiff
  have hπ : ContDiff ℝ (⊤ : ℕ∞) π := πL.contDiff.sub contDiff_const
  have hΦ : ContDiff ℝ (⊤ : ℕ∞) Φ :=
    contDiff_const.add (ContDiff.sum fun j _ => (hcoord j).smul contDiff_const)
  have hν : ContDiff ℝ (⊤ : ℕ∞) ν := (contDiff_norm_sq ℝ).comp (contDiff_id.sub (hΦ.comp hπ))
  have hχ : ContDiff ℝ (⊤ : ℕ∞) χ :=
    Real.smoothTransition.contDiff.comp (contDiff_const.sub ((contDiff_const.mul hν).div_const _))
  have hgπ : ∀ l, ContDiff ℝ (⊤ : ℕ∞) fun x => g (π x) l := fun l =>
    (hcoord l).comp (hg.comp hπ)
  have hω : ContDiff ℝ (⊤ : ℕ∞) ω :=
    ContDiff.sum fun l _ => ((contDiff_const.mul hχ).mul (hgπ l)).smul contDiff_const
  -- `χ = 0` where `ν ≥ δ²` and `χ = 1` where `2ν ≤ δ²`
  have hχ0 : ∀ x, δ ^ 2 ≤ ν x → χ x = 0 := by
    intro x hx
    apply Real.smoothTransition.zero_of_nonpos
    have : 2 ≤ 2 * ν x / δ ^ 2 := by
      rw [le_div_iff₀ (by positivity)]
      linarith
    linarith
  have hχ1 : ∀ x, 2 * ν x ≤ δ ^ 2 → χ x = 1 := by
    intro x hx
    apply Real.smoothTransition.one_of_one_le
    have : 2 * ν x / δ ^ 2 ≤ 1 := by
      rw [div_le_one₀ (by positivity)]
      exact hx
    linarith
  -- `spt ω ⊆ Z = {ν ≤ δ²} ∩ π⁻¹(spt g)`, and `|x - Φ(π x)| ≤ δ` on `Z`
  have hω0 : ∀ x, (χ x = 0 ∨ g (π x) = 0) → ω x = 0 := by
    intro x hx
    refine Finset.sum_eq_zero fun l _ => ?_
    rcases hx with h | h <;> simp [c, h]
  have hsuppZ : tsupport ω ⊆ {x | ν x ≤ δ ^ 2} ∩ π ⁻¹' tsupport g := by
    refine closure_minimal (fun x hx => ⟨?_, ?_⟩)
      ((isClosed_le hν.continuous continuous_const).inter
        ((isClosed_tsupport g).preimage hπ.continuous))
    · by_contra h
      exact hx (hω0 x (Or.inl (hχ0 x (le_of_not_ge h))))
    · by_contra h
      exact hx (hω0 x (Or.inr (image_eq_zero_of_notMem_tsupport h)))
  have hZδ : ∀ x, ν x ≤ δ ^ 2 → dist x (Φ (π x)) ≤ δ := fun x hx => by
    rw [dist_eq_norm]
    exact (pow_le_pow_iff_left₀ (norm_nonneg _) hδ.le two_ne_zero).mp hx
  -- compact support: `Z ⊆ cthickening δ (Φ(spt g))`
  have hcpt : HasCompactSupport ω :=
    ((hgc.isCompact.image hΦ.continuous).cthickening (r := δ)).of_isClosed_subset
      (isClosed_tsupport ω) (hsuppZ.trans fun x hx =>
        Metric.mem_cthickening_of_dist_le x (Φ (π x)) δ _ (mem_image_of_mem Φ hx.2)
          (hZδ x hx.1))
  refine ⟨⟨ω, ⟨hω, hcpt⟩, subset_univ _⟩, fun x => ?_, fun x hx => ?_, fun y => ?_⟩
  · -- 4. (i) `|ω(x)| = χ(x) |g(π x)| ≤ 1`
    show covectorEuclideanNorm (∑ l, c l x • dx (J l)) ≤ 1
    rw [hdxn (m + 1) J (fun l => c l x) hJinj hJ]
    refine (Real.sqrt_le_sqrt ?_).trans_eq Real.sqrt_one
    calc ∑ l, c l x ^ 2 = χ x ^ 2 * ‖g (π x)‖ ^ 2 := by
          rw [EuclideanSpace.real_norm_sq_eq, Finset.mul_sum]
          refine Finset.sum_congr rfl fun l _ => ?_
          simp only [c]
          rw [mul_pow, mul_pow, ← pow_mul, mul_comm (l : ℕ) 2, pow_mul, neg_one_sq, one_pow,
            one_mul]
      _ ≤ 1 * 1 := mul_le_mul (pow_le_one₀ (Real.smoothTransition.nonneg _)
          (Real.smoothTransition.le_one _)) (pow_le_one₀ (norm_nonneg _) (hg1 _)) (sq_nonneg _)
          zero_le_one
      _ = 1 := one_mul 1
  · -- 5. (ii) `x` is within `δ` of `Φ(π x)`, `π x ∈ spt g`
    obtain ⟨hxν, hxg⟩ := hsuppZ hx
    exact ⟨π x, hxg, hZδ x hxν⟩
  · -- 6. (iii) near `Φ y`, `χ = 1`, so `ω` agrees with `ω₀ = Σ_l (-1)^l (g_l ∘ π) dx^{J l}`
    let ω₀ : DifferentialForm (Euclid P) m := fun x =>
      ∑ l : Fin (m + 1), ((-1) ^ (l : ℕ) * g (π x) l) • dx (J l)
    have hω₀ : ContDiff ℝ (⊤ : ℕ∞) ω₀ :=
      ContDiff.sum fun l _ => (contDiff_const.mul (hgπ l)).smul contDiff_const
    have hνΦ : 2 * ν (Φ y) < δ ^ 2 := by
      simp only [ν, hπΦ, sub_self, norm_zero]
      simpa using pow_pos hδ 2
    have hloc : ω =ᶠ[𝓝 (Φ y)] ω₀ := by
      filter_upwards [(isOpen_lt (continuous_const.mul hν.continuous) continuous_const).mem_nhds
        hνΦ] with x hx
      simp only [ω, ω₀, c, hχ1 x (le_of_lt hx), mul_one]
    have hd : exteriorDerivative ω (Φ y) = exteriorDerivative ω₀ (Φ y) := hloc.extDeriv_eq
    -- `ω₀(x)(e_{J i}) = (-1)^i g_i(π x)`
    have hω₀e : ∀ i : Fin (m + 1),
        (fun x => ω₀ x (i.removeNth fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) =
          fun x => (-1) ^ (i : ℕ) * g (π x) i := by
      intro i
      funext x
      show (∑ l : Fin (m + 1), ((-1) ^ (l : ℕ) * g (π x) l) • dx (J l))
          (fun r => EuclideanSpace.single (J i r) (1 : ℝ)) = _
      rw [ContinuousAlternatingMap.sum_apply, Finset.sum_eq_single i]
      · rw [ContinuousAlternatingMap.smul_apply, hdx _ _ (hJ i) (hJ i), ite_eq_left rfl,
          smul_eq_mul, mul_one]
      · intro l _ hl
        rw [ContinuousAlternatingMap.smul_apply, hdx _ _ (hJ i) (hJ l),
          ite_eq_right fun h => hl (hJinj h).symm, smul_zero]
      · exact fun h => absurd (Finset.mem_univ i) h
    -- `D[(-1)^i g_i ∘ π](Φ y)(e_{ι i}) = (-1)^i (Dg(y) ê_i)_i`
    have hderiv : ∀ i : Fin (m + 1),
        fderiv ℝ (fun x => (-1) ^ (i : ℕ) * g (π x) i) (Φ y)
          (EuclideanSpace.single (p.2 i) (1 : ℝ)) =
          (-1) ^ (i : ℕ) * fderiv ℝ g y (EuclideanSpace.single i (1 : ℝ)) i := by
      intro i
      have hπd : HasFDerivAt π πL (Φ y) := πL.hasFDerivAt.sub_const (πL z)
      have hgd : HasFDerivAt g (fderiv ℝ g y) (π (Φ y)) := by
        rw [hπΦ]
        exact (hg.differentiable (by simp) y).hasFDerivAt
      have h2 : fderiv ℝ (fun x => (-1) ^ (i : ℕ) * g (π x) i) (Φ y) =
          ((-1 : ℝ) ^ (i : ℕ)) • ((EuclideanSpace.proj i).comp ((fderiv ℝ g y).comp πL)) :=
        (((EuclideanSpace.proj i).hasFDerivAt.comp (Φ y) (hgd.comp (Φ y) hπd)).const_mul
          ((-1 : ℝ) ^ (i : ℕ))).fderiv
      rw [h2, smul_apply, ContinuousLinearMap.comp_apply,
        ContinuousLinearMap.comp_apply, hπLe, smul_eq_mul]
      rfl
    show exteriorDerivative ω (Φ y) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) = _
    rw [hd, exteriorDerivative_apply (hω₀.differentiable (by simp)).differentiableAt,
      LinearMap.trace_eq_sum_inner _ (EuclideanSpace.basisFun (Fin (m + 1)) ℝ)]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hω₀e i, hderiv i, EuclideanSpace.basisFun_apply, EuclideanSpace.inner_single_left,
      map_one, one_mul, ContinuousLinearMap.coe_coe, zsmul_eq_mul]
    push_cast
    rw [← mul_assoc, ← mul_pow, neg_one_mul, neg_neg, one_pow, one_mul]

/-- **Boundary variation on the faces** (Simon Ch. 6, proof of 5.1, (28), second part, by the
arguments of the Constancy Theorem 2.34 and of 2.35).  Let `Q(ω) = Σ_{p∈s} ∫_{Q₁} u_p ω(Φ_p)(e_p)`
with `M(∂Q) < ∞`.  The sets `W_p = {x : dist(x, F_p) < dist(x, F_q) for q ∈ s ∖ {p}}` are
pairwise disjoint, so disjointly supported admissible forms add up to an admissible form and
`Σ_{p∈s} M_{W_p}(∂Q) ≤ M(∂Q)`; put `V_p = M_{W_p}(∂Q)`.  For an admissible `g`, the compact
`Φ_p(spt g)` has positive distance from the other faces, so the divergence form `ω` of `g` is
supported in `W_p`, and `∂Q(ω) = Q(dω) = ∫_{Q₁} u_p div g` since `dω` vanishes on the other faces;
hence `∫_{Q₁} u_p div g ≤ M_{W_p}(∂Q) = V_p`. -/
theorem Submission.dor_lmb_fcd_fr_boundary_variation : ∀ (P m : ℕ) (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (u : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid (m + 1) → ℝ) (Q : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ p ∈ s, StrictMono p.2) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Q ω = ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, u p y * (ω : DifferentialForm (Euclid P) (m + 1)) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) → Q.boundary.mass ≠ ∞ → ∃ V : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℝ, (∀ p ∈ s, 0 ≤ V p) ∧ ENNReal.ofReal (∑ p ∈ s, V p) ≤ Q.boundary.mass ∧ ∀ p ∈ s, ∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ y, ‖g y‖ ≤ 1) → ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, u p y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) ≤ V p := by
  intro P m s u Q hs hQ hmass
  classical
  -- the parametrizations `Φ_p`, the closed faces `F_p` and the sets `W_p`
  let Φ : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid (m + 1) → Euclid P := fun p y =>
    WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)
  let F : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Set (Euclid P) := fun p =>
    {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧
      (i ∉ Set.range p.2 → x i = p.1 i)}
  let W : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Set (Euclid P) := fun p =>
    {x | ∀ q ∈ s, q ≠ p → infDist x (F p) < infDist x (F q)}
  -- face geometry: `Φ_p` maps the closed cube into `F_p`, is continuous, `F_p` is closed, and
  -- `Φ_p` maps the open cube off every other face
  have hFG : ∀ p ∈ s, (∀ y : Euclid (m + 1), (∀ i, 0 ≤ y i ∧ y i ≤ 1) → Φ p y ∈ F p) ∧
      Continuous (Φ p) ∧ IsClosed (F p) ∧ ∀ q : (Fin P → ℤ) × (Fin (m + 1) → Fin P),
        StrictMono q.2 → q ≠ p → ∀ y : Euclid (m + 1), (∀ i, 0 < y i ∧ y i < 1) → Φ p y ∉ F q := by
    intro p hp
    obtain ⟨-, -, -, -, h5, h6, -, h8, h9⟩ :=
      Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)
    exact ⟨h5, (Isometry.of_dist_eq h6).continuous, h8, h9⟩
  have hFne : ∀ p ∈ s, (F p).Nonempty := fun p hp =>
    ⟨Φ p 0, (hFG p hp).1 0 fun i => by simp⟩
  -- Step 1: the `W_p`, `p ∈ s`, are pairwise disjoint
  have hWdisj : ∀ p ∈ s, ∀ q ∈ s, p ≠ q → ∀ x, x ∈ W p → x ∉ W q := by
    intro p hp q hq hpq x hxp hxq
    exact lt_asymm (hxp q hq (Ne.symm hpq)) (hxq p hp hpq)
  -- Step 2: `Σ_{p∈s} M_{W_p}(∂Q) ≤ M(∂Q)`
  set T := Q.boundary with hT
  have hadm0 : ∀ V : Set (Euclid P),
      (0 : TestFormOn (univ : Set (Euclid P)) m) ∈ massAdmissibleOn univ m V := by
    intro V
    refine ⟨?_, fun x => ?_⟩ <;> simp
  -- (a) a family of admissible forms, one in each `W_p`
  have hfam : ∀ ω : (p : (Fin P → ℤ) × (Fin (m + 1) → Fin P)) → massAdmissibleOn univ m (W p),
      ∑ p ∈ s, ENNReal.ofReal (T (ω p)) ≤ T.mass := by
    intro ω
    -- drop the forms with negative value
    let ω' : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → TestFormOn (univ : Set (Euclid P)) m :=
      fun p => if 0 ≤ T (ω p) then (ω p : TestFormOn (univ : Set (Euclid P)) m) else 0
    have hω' : ∀ p, ENNReal.ofReal (T (ω p)) = ENNReal.ofReal (T (ω' p)) ∧ 0 ≤ T (ω' p) ∧
        ω' p ∈ massAdmissibleOn univ m (W p) := by
      intro p
      by_cases h : 0 ≤ T (ω p)
      · have h0 : ω' p = ω p := ite_eq_left h
        rw [h0]
        exact ⟨rfl, h, (ω p).2⟩
      · have h0 : ω' p = 0 := ite_eq_right h
        rw [h0, map_zero, ENNReal.ofReal_zero, ENNReal.ofReal_eq_zero]
        exact ⟨(not_le.1 h).le, le_rfl, hadm0 (W p)⟩
    -- the sum is admissible in `ℝ^P`: at each point at most one summand is nonzero
    have hsum_adm : (∑ p ∈ s, ω' p) ∈ massAdmissibleOn univ m univ := by
      refine ⟨subset_univ _, fun x => ?_⟩
      have hx : ((∑ p ∈ s, ω' p : TestFormOn (univ : Set (Euclid P)) m) :
          DifferentialForm (Euclid P) m) x =
          ∑ p ∈ s, ((ω' p : TestFormOn (univ : Set (Euclid P)) m) :
            DifferentialForm (Euclid P) m) x := by
        rw [Submodule.coe_sum, Finset.sum_apply]
      rw [hx]
      by_cases hex : ∃ p ∈ s, ((ω' p : TestFormOn (univ : Set (Euclid P)) m) :
          DifferentialForm (Euclid P) m) x ≠ 0
      · obtain ⟨p, hp, hpx⟩ := hex
        have hzero : ∀ q ∈ s, q ≠ p → ((ω' q : TestFormOn (univ : Set (Euclid P)) m) :
            DifferentialForm (Euclid P) m) x = 0 := by
          intro q hq hqp
          by_contra hqx
          exact hWdisj p hp q hq (Ne.symm hqp) x ((hω' p).2.2.1 (subset_tsupport _ hpx))
            ((hω' q).2.2.1 (subset_tsupport _ hqx))
        rw [Finset.sum_eq_single p hzero fun h => absurd hp h]
        exact (hω' p).2.2.2 x
      · have hzero : ∀ p ∈ s, ((ω' p : TestFormOn (univ : Set (Euclid P)) m) :
            DifferentialForm (Euclid P) m) x = 0 := fun p hp =>
          not_not.1 fun hpx => hex ⟨p, hp, hpx⟩
        rw [Finset.sum_eq_zero hzero, covectorEuclideanNorm_zero]
        exact zero_le_one
    calc ∑ p ∈ s, ENNReal.ofReal (T (ω p)) = ∑ p ∈ s, ENNReal.ofReal (T (ω' p)) :=
          Finset.sum_congr rfl fun p _ => (hω' p).1
      _ = ENNReal.ofReal (∑ p ∈ s, T (ω' p)) :=
          (ENNReal.ofReal_sum_of_nonneg fun p _ => (hω' p).2.1).symm
      _ = ENNReal.ofReal (T (∑ p ∈ s, ω' p)) := by rw [map_sum]
      _ ≤ T.mass := T.le_massOn hsum_adm
  -- (b) `M_{W_p}(∂Q)` as a supremum over families, which are directed
  have hsupW : ∀ p, T.massOn (W p) =
      ⨆ ω : (q : (Fin P → ℤ) × (Fin (m + 1) → Fin P)) → massAdmissibleOn univ m (W q),
        ENNReal.ofReal (T (ω p)) := by
    intro p
    rw [GeometricCurrentOn.massOn, sSup_image']
    refine le_antisymm (iSup_le fun ω => ?_) (iSup_le fun ω => le_iSup_of_le (ω p) le_rfl)
    let z : (q : (Fin P → ℤ) × (Fin (m + 1) → Fin P)) → massAdmissibleOn univ m (W q) :=
      fun q => ⟨0, hadm0 (W q)⟩
    exact le_iSup_of_le (Function.update z p ω) (by simp only [Function.update_self, le_refl])
  have hdir : ∀ i j : (p : (Fin P → ℤ) × (Fin (m + 1) → Fin P)) → massAdmissibleOn univ m (W p),
      ∃ k : (p : (Fin P → ℤ) × (Fin (m + 1) → Fin P)) → massAdmissibleOn univ m (W p), ∀ p,
        ENNReal.ofReal (T (i p)) ≤ ENNReal.ofReal (T (k p)) ∧
          ENNReal.ofReal (T (j p)) ≤ ENNReal.ofReal (T (k p)) := by
    intro i j
    refine ⟨fun p => if ENNReal.ofReal (T (i p)) ≤ ENNReal.ofReal (T (j p)) then j p else i p,
      fun p => ?_⟩
    by_cases h : ENNReal.ofReal (T (i p)) ≤ ENNReal.ofReal (T (j p))
    · simp only [ite_eq_left h]
      exact ⟨h, le_rfl⟩
    · simp only [ite_eq_right h]
      exact ⟨le_rfl, (not_le.1 h).le⟩
  have hsum : ∑ p ∈ s, T.massOn (W p) ≤ T.mass := by
    rw [Finset.sum_congr rfl fun p _ => hsupW p, ENNReal.finsetSum_iSup hdir]
    exact iSup_le hfam
  -- Step 3: `V_p = M_{W_p}(∂Q)`
  have hne : ∀ p, T.massOn (W p) ≠ ∞ := fun p =>
    ne_top_of_le_ne_top hmass (T.massOn_mono (subset_univ (W p)))
  refine ⟨fun p => (T.massOn (W p)).toReal, fun p _ => ENNReal.toReal_nonneg, ?_, ?_⟩
  · rw [ENNReal.ofReal_sum_of_nonneg fun p _ => ENNReal.toReal_nonneg]
    calc ∑ p ∈ s, ENNReal.ofReal (T.massOn (W p)).toReal = ∑ p ∈ s, T.massOn (W p) :=
          Finset.sum_congr rfl fun p _ => ENNReal.ofReal_toReal (hne p)
      _ ≤ T.mass := hsum
  intro p hp g hg hgc hgC hg1
  -- Step 4: `Φ_p(spt g)` is compact and has positive distance from the other faces
  have hGc : IsCompact (Φ p '' tsupport g) := IsCompact.image hgc (hFG p hp).2.1
  have hBc : IsClosed (⋃ q ∈ s.erase p, F q) :=
    isClosed_biUnion_finset fun q hq => (hFG q (Finset.mem_of_mem_erase hq)).2.2.1
  have hGB : Disjoint (Φ p '' tsupport g) (⋃ q ∈ s.erase p, F q) := by
    refine Set.disjoint_left.2 ?_
    rintro _ ⟨y, hy, rfl⟩ hyB
    obtain ⟨q, hq, hyq⟩ := Set.mem_iUnion₂.1 hyB
    exact (hFG p hp).2.2.2 q (hs q (Finset.mem_of_mem_erase hq)) (Finset.ne_of_mem_erase hq) y
      (hgC hy) hyq
  obtain ⟨r, hr0, hr⟩ := exists_pos_forall_lt_edist hGc hBc hGB
  set δ : ℝ := (r : ℝ) / 3 with hδ
  have hδ0 : 0 < δ := div_pos (NNReal.coe_pos.2 hr0) three_pos
  -- Step 5: the divergence form of `g`
  obtain ⟨ω, hω1, hωspt, hωd⟩ :=
    Submission.dor_lmb_fcd_fr_divergence_form P m p g δ (hs p hp) hg hgc hg1 hδ0
  -- Step 6: `spt ω ⊆ W_p`, so `ω` is admissible for `M_{W_p}(∂Q)`
  have hωW : tsupport (ω : DifferentialForm (Euclid P) m) ⊆ W p := by
    intro x hx q hq hqp
    obtain ⟨y, hy, hxy⟩ := hωspt x hx
    have hyC : ∀ i, 0 < y i ∧ y i < 1 := hgC hy
    have hxy' : dist (Φ p y) x ≤ δ := by
      rw [dist_comm]
      exact hxy
    have h1 : infDist x (F p) ≤ δ :=
      (infDist_le_dist_of_mem ((hFG p hp).1 y fun i => ⟨(hyC i).1.le, (hyC i).2.le⟩)).trans
        (by rw [dist_comm]; exact hxy')
    have h2 : 2 * δ ≤ infDist x (F q) := by
      refine (le_infDist (hFne q hq)).2 fun b hb => ?_
      have hb' : (r : ℝ≥0∞) < edist (Φ p y) b :=
        hr _ ⟨y, hy, rfl⟩ b (Set.mem_iUnion₂.2 ⟨q, Finset.mem_erase.2 ⟨hqp, hq⟩, hb⟩)
      have hrb : (r : ℝ) < dist (Φ p y) b := by
        rw [dist_edist]
        exact ENNReal.toReal_strict_mono (edist_ne_top _ _) hb'
      have htri := dist_triangle (Φ p y) x b
      linarith
    linarith
  have hωadm : ω ∈ massAdmissibleOn univ m (W p) := ⟨hωW, hω1⟩
  -- Step 7: `∂Q(ω) = Q(dω) = ∫_{Q₁} u_p div g`, `dω` vanishing on the other faces
  have hval : T ω = ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1},
      u p y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) := by
    rw [hT, GeometricCurrentOn.boundary_apply, hQ, Finset.sum_eq_single p]
    · congr 1
      funext y
      exact congrArg (fun t => u p y * t) (hωd y)
    · intro q hq hqp
      refine setIntegral_eq_zero_of_forall_eq_zero fun y hy => ?_
      have hyF : Φ q y ∈ F q := (hFG q hq).1 y fun i => ⟨(hy i).1.le, (hy i).2.le⟩
      have hnot : Φ q y ∉ tsupport (exteriorDerivative (ω : DifferentialForm (Euclid P) m)) := by
        intro hmem
        have hlt := hωW (tsupport_exteriorDerivative_subset _ hmem) q hq hqp
        rw [infDist_zero_of_mem hyF] at hlt
        exact absurd hlt (not_lt.2 infDist_nonneg)
      have h0 : exteriorDerivative (ω : DifferentialForm (Euclid P) m) (Φ q y)
          (fun k => EuclideanSpace.single (q.2 k) (1 : ℝ)) = 0 := by
        rw [image_eq_zero_of_notMem_tsupport hnot]
        rfl
      exact (congrArg (fun t => u q y * t) h0).trans (mul_zero _)
    · intro h
      exact absurd hp h
  -- Step 8: `∫_{Q₁} u_p div g = ∂Q(ω) ≤ M_{W_p}(∂Q)`
  have hle : ENNReal.ofReal (T ω) ≤ T.massOn (W p) := T.le_massOn hωadm
  rw [hval] at hle
  exact (ENNReal.ofReal_le_iff_le_toReal (hne p)).1 hle
/-- **Currents given by `L¹` densities on unit faces** (Simon Ch. 6, proof of the deformation
theorem 5.1, (29), and the mass estimate (34) via 2.35).  For pairs `p = (z, ι)` with `ι` strictly
increasing, `Φ_p(y) = z + Σⱼ yⱼ e_{ι(j)}` and `e_p = (e_{ι(0)}, …, e_{ι(m)})`:
(I) `y ↦ w_p(y) ω(Φ_p(y))(e_p)` is integrable on `Q₁ = (0, 1)^{m+1}`, since `ω` is continuous with
compact support and `|ω(x)(e_p)| ≤ ‖ω(x)‖`; (II) `ω ↦ Σ_p ∫_{Q₁} w_p ω(Φ_p)(e_p)` is linear and
bounded by `(Σ_p ∫_{Q₁} |w_p|) · sup ‖ω‖`, hence a current; (III) `|ω(x)(e_p)|` is bounded by the
Euclidean coefficient norm of `ω(x)`, so every such current has `M ≤ Σ_p ∫_{Q₁} |w_p|`. -/
theorem Submission.dor_lmb_fcd_fr_chain_current : ∀ (P m : ℕ) (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (w : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid (m + 1) → ℝ), (∀ p ∈ s, StrictMono p.2) → (∀ p ∈ s, IntegrableOn (w p) {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), ∀ p ∈ s, IntegrableOn (fun y => w p y * (ω : DifferentialForm (Euclid P) (m + 1)) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}) ∧ (∃ D : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), D ω = ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, w p y * (ω : DifferentialForm (Euclid P) (m + 1)) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) ∧ ∀ D : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), D ω = ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, w p y * (ω : DifferentialForm (Euclid P) (m + 1)) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) → D.mass ≤ ENNReal.ofReal (∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |w p y|) := by
  intro P m s w hmono hw
  -- Step 1: the frame `e_ι = (e_{ι 0}, …, e_{ι m})` consists of unit vectors, so `|α(e_ι)| ≤ ‖α‖`
  have hframe : ∀ (α : Covector (Euclid P) (m + 1)) (ι : Fin (m + 1) → Fin P),
      |α (fun k => EuclideanSpace.single (ι k) (1 : ℝ))| ≤ ‖α‖ := by
    intro α ι
    simpa using α.le_opNorm (fun k => EuclideanSpace.single (ι k) (1 : ℝ))
  -- for strictly increasing `ι`, `α(e_ι)` is one of the coefficients in the Euclidean norm of `α`
  have hcoeff : ∀ (α : Covector (Euclid P) (m + 1)) (ι : Fin (m + 1) → Fin P), StrictMono ι →
      |α (fun k => EuclideanSpace.single (ι k) (1 : ℝ))| ≤ covectorEuclideanNorm α := by
    intro α ι hι
    refine Real.abs_le_sqrt ?_
    have hle := Finset.single_le_sum (s := Finset.univ)
      (f := fun I : Fin (m + 1) → Fin P => if StrictMono I then
        (α (fun i => EuclideanSpace.basisFun (Fin P) ℝ (I i))) ^ 2 else 0)
      (fun I _ => by split_ifs <;> positivity) (Finset.mem_univ ι)
    simpa [hι, EuclideanSpace.basisFun_apply] using hle
  -- Step 2: `y ↦ ω(Φ_p(y))(e_p)` is continuous, and test forms are bounded
  have hcont : ∀ (ω : TestFormOn (univ : Set (Euclid P)) (m + 1))
      (p : (Fin P → ℤ) × (Fin (m + 1) → Fin P)),
      Continuous fun y : Euclid (m + 1) => (ω : DifferentialForm (Euclid P) (m + 1))
        (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ))
        (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) := by
    intro ω p
    have hω : Continuous (ω : DifferentialForm (Euclid P) (m + 1)) := ω.property.1.1.continuous
    have hΦ : Continuous fun y : Euclid (m + 1) =>
        WithLp.toLp 2 (fun i => (p.1 i : ℝ)) +
          ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ) := by
      fun_prop
    exact (hω.comp hΦ).eval_const _
  have hbdd : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1),
      ∃ C, ∀ x, ‖(ω : DifferentialForm (Euclid P) (m + 1)) x‖ ≤ C := fun ω =>
    ω.property.1.1.continuous.bounded_above_of_compact_support ω.property.1.2
  -- (I): an integrable density times a bounded continuous function is integrable
  have hint : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), ∀ p ∈ s,
      IntegrableOn (fun y => w p y * (ω : DifferentialForm (Euclid P) (m + 1))
        (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ))
        (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)))
        {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} := by
    intro ω p hp
    obtain ⟨C, hC⟩ := hbdd ω
    exact (hw p hp).mul_bdd (hcont ω p).aestronglyMeasurable (Filter.Eventually.of_forall fun y =>
      (Real.norm_eq_abs _).trans_le ((hframe _ _).trans (hC _)))
  -- Step 3: `|Σ_p ∫ w_p ω(Φ_p)(e_p)| ≤ c · Σ_p ∫ |w_p|` whenever `|ω(Φ_p)(e_p)| ≤ c`
  have hbound : ∀ (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)) (c : ℝ),
      (∀ p ∈ s, ∀ y : Euclid (m + 1), |(ω : DifferentialForm (Euclid P) (m + 1))
        (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ))
        (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))| ≤ c) →
      |∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, w p y *
        (ω : DifferentialForm (Euclid P) (m + 1))
        (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ))
        (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))| ≤
      c * ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |w p y| := by
    intro ω c hc
    rw [Finset.mul_sum]
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun p hp => ?_)
    rw [← integral_const_mul, ← Real.norm_eq_abs]
    refine norm_integral_le_of_norm_le ((hw p hp).abs.const_mul c)
      (Filter.Eventually.of_forall fun y => ?_)
    rw [Real.norm_eq_abs, abs_mul, mul_comm c]
    exact mul_le_mul_of_nonneg_left (hc p hp y) (abs_nonneg _)
  -- (II): the formula is a linear functional on test forms ...
  let L : TestFormOn (univ : Set (Euclid P)) (m + 1) →ₗ[ℝ] ℝ :=
    { toFun := fun ω => ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1},
        w p y * (ω : DifferentialForm (Euclid P) (m + 1))
          (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ))
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))
      map_add' := fun ω η => by
        have h : ∀ x v, ((ω + η : TestFormOn (univ : Set (Euclid P)) (m + 1)) :
            DifferentialForm (Euclid P) (m + 1)) x v =
            (ω : DifferentialForm (Euclid P) (m + 1)) x v +
              (η : DifferentialForm (Euclid P) (m + 1)) x v := fun x v => rfl
        simp only [h, mul_add]
        rw [← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl fun p hp => integral_add (hint ω p hp) (hint η p hp)
      map_smul' := fun c ω => by
        have h : ∀ x v, ((c • ω : TestFormOn (univ : Set (Euclid P)) (m + 1)) :
            DifferentialForm (Euclid P) (m + 1)) x v =
            c * (ω : DifferentialForm (Euclid P) (m + 1)) x v := fun x v => rfl
        simp only [h, RingHom.id_apply, smul_eq_mul, Finset.mul_sum]
        refine Finset.sum_congr rfl fun p _ => ?_
        rw [← integral_const_mul]
        congr 1
        funext y
        ring }
  -- ... and it is sequentially continuous: `ωⱼ → 0` forces `sup ‖ωⱼ‖ → 0`
  have hLcont : ∀ ωs : ℕ → TestFormOn (univ : Set (Euclid P)) (m + 1),
      TestFormOnConverges ωs 0 → Tendsto (fun j => L (ωs j)) atTop (𝓝 0) := by
    intro ωs hωs
    obtain ⟨K, -, -, hsupp, -, hunif⟩ := hωs
    have h0 := Metric.tendstoUniformlyOn_iff.1 (hunif 0)
    obtain ⟨S, hS⟩ : ∃ S, S = ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1},
        |w p y| := ⟨_, rfl⟩
    have hS0 : 0 ≤ S := hS ▸ Finset.sum_nonneg fun p _ => integral_nonneg fun y => abs_nonneg _
    refine Metric.tendsto_nhds.2 fun ε hε => ?_
    have hδ : 0 < ε / (S + 1) := div_pos hε (by linarith)
    filter_upwards [h0 _ hδ] with j hj
    have hsup : ∀ x, ‖(ωs j : DifferentialForm (Euclid P) (m + 1)) x‖ ≤ ε / (S + 1) := by
      intro x
      by_cases hx : x ∈ K
      · have hjx := hj x hx
        have h00 : iteratedFDeriv ℝ 0 ((0 : TestFormOn (univ : Set (Euclid P)) (m + 1)) :
            DifferentialForm (Euclid P) (m + 1)) x = 0 := by
          rw [← norm_eq_zero, norm_iteratedFDeriv_zero]
          simp
        rw [h00, dist_zero_left, norm_iteratedFDeriv_zero] at hjx
        exact hjx.le
      · rw [image_eq_zero_of_notMem_tsupport fun h => hx (hsupp j h), norm_zero]
        exact hδ.le
    have hb := hbound (ωs j) (ε / (S + 1)) fun p _ y => (hframe _ _).trans (hsup _)
    rw [← hS] at hb
    rw [Real.dist_eq, sub_zero]
    calc |L (ωs j)| ≤ ε / (S + 1) * S := hb
      _ < ε / (S + 1) * (S + 1) := mul_lt_mul_of_pos_left (lt_add_one S) hδ
      _ = ε := div_mul_cancel₀ ε (by linarith : (0 : ℝ) < S + 1).ne'
  refine ⟨hint, ⟨⟨L, hLcont⟩, fun ω => rfl⟩, fun D hD => ?_⟩
  -- (III): admissible forms have `|ω(Φ_p)(e_p)| ≤ 1`, so every admissible value is `≤ Σ_p ∫ |w_p|`
  unfold GeometricCurrentOn.mass GeometricCurrentOn.massOn
  refine sSup_le ?_
  rintro _ ⟨ω, hω, rfl⟩
  dsimp only
  rw [hD ω]
  refine ENNReal.ofReal_le_ofReal ((le_abs_self _).trans ?_)
  have hb := hbound ω 1 fun p hp y => (hcoeff _ _ (hmono p hp)).trans (hω.2 _)
  rwa [one_mul] at hb
/-- **A set that coincides near `x` with the plane `x + V` has approximate tangent space `V` at
`x`** (Simon Ch. 3, Definition 1.4).  A test function `f ∈ C_c(ℝᴾ)` vanishes off a ball `B_R(0)`,
so `∫_S f dHⁿ = ∫_{B_R(0) ∩ S} f dHⁿ` for every `S`.  For `0 < λ < r/R` the blow-up
`η_{x,λ}(N) = λ⁻¹(N − x)` coincides with `V` inside `B_R(0)`, hence the blow-up integrals equal
`∫_V f dHⁿ` for all small `λ > 0` and converge to it. -/
theorem Submission.dor_lmb_fcd_fr_local_plane_tangent : ∀ (P n : ℕ) (N : Set (Euclid P)) (x : Euclid P) (V : Submodule ℝ (Euclid P)) (r : ℝ), Module.finrank ℝ V = n → 0 < r → (∀ y ∈ Metric.ball x r, y ∈ N ↔ y - x ∈ V) → HasApproximateTangentSpaceAt n N x V := by
  intro P n N x V r hV hr hN
  refine ⟨hV, fun f => ?_⟩
  -- Step 1: `f` vanishes off a ball `B_R(0)`
  obtain ⟨R, hR, hfR⟩ : ∃ R : ℝ, 0 < R ∧ ∀ w, w ∉ ball (0 : Euclid P) R → f w = 0 := by
    obtain ⟨C, hC⟩ := isBounded_iff_forall_norm_le.1 f.hasCompactSupport.isCompact.isBounded
    refine ⟨max C 0 + 1, add_pos_of_nonneg_of_pos (le_max_right C 0) one_pos,
      fun w hw => image_eq_zero_of_notMem_tsupport fun hwt => hw ?_⟩
    rw [mem_ball_zero_iff]
    exact (hC w hwt).trans_lt ((le_max_left C 0).trans_lt (lt_add_one _))
  -- Step 2: the integral of `f` over any `S` only sees `B_R(0) ∩ S`
  have hB : MeasurableSet (ball (0 : Euclid P) R) := measurableSet_ball
  have hloc : ∀ S : Set (Euclid P),
      ∫ y in S, f y ∂μHE[n] = ∫ y in ball (0 : Euclid P) R ∩ S, f y ∂μHE[n] := by
    intro S
    rw [← Measure.restrict_restrict hB, setIntegral_eq_integral_of_forall_compl_eq_zero hfR]
  -- Step 3: for `0 < λ < r/R` the blow-up of `N` coincides with `V` inside `B_R(0)`
  have hblow : ∀ lam ∈ Ioo 0 (r / R), ball (0 : Euclid P) R ∩
      Poincare.SimonGMT.Chapter03.blowUpMap x lam '' N =
        ball (0 : Euclid P) R ∩ (V : Set (Euclid P)) := by
    rintro lam ⟨hlam0, hlamR⟩
    have hsmall : ∀ w : Euclid P, ‖w‖ < R → ‖lam • w‖ < r := fun w hw => by
      rw [norm_smul, Real.norm_of_nonneg hlam0.le]
      exact (mul_lt_mul_of_pos_left hw hlam0).trans ((lt_div_iff₀ hR).1 hlamR)
    ext w
    constructor
    · rintro ⟨hw, y, hy, rfl⟩
      have hyx : y - x = lam • Poincare.SimonGMT.Chapter03.blowUpMap x lam y := by
        rw [Poincare.SimonGMT.Chapter03.blowUpMap, smul_smul, mul_inv_cancel₀ hlam0.ne',
          one_smul]
      have hy' : y ∈ ball x r := by
        rw [Metric.mem_ball, dist_eq_norm, hyx]
        exact hsmall _ (mem_ball_zero_iff.1 hw)
      exact ⟨hw, V.smul_mem lam⁻¹ ((hN y hy').1 hy)⟩
    · rintro ⟨hw, hwV⟩
      have hy : x + lam • w ∈ ball x r := by
        rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left]
        exact hsmall w (mem_ball_zero_iff.1 hw)
      refine ⟨hw, x + lam • w, (hN _ hy).2 ?_, ?_⟩
      · rw [add_sub_cancel_left]
        exact V.smul_mem lam hwV
      · rw [Poincare.SimonGMT.Chapter03.blowUpMap, add_sub_cancel_left, smul_smul,
          inv_mul_cancel₀ hlam0.ne', one_smul]
  -- Step 4: the blow-up integrals are eventually equal to `∫_V f dHⁿ`
  refine tendsto_const_nhds.congr' ?_
  filter_upwards [Ioo_mem_nhdsGT (div_pos hr hR)] with lam hlam
  rw [hloc (V : Set (Euclid P)), hloc (Poincare.SimonGMT.Chapter03.blowUpMap x lam '' N),
    hblow lam hlam]

/-- **Lattice chains are integer multiplicity** (Simon Ch. 6, proof of 5.1: "the fact that `P`,
`R` are integer multiplicity … should be evident").  Let `T(ω) = Σ_{p ∈ s} ∫_{Q₁} β_p
ω(Φ_p(y))(e_p) dy`, where `p = (z, ι)` has `ι` strictly increasing, `Φ_p(y) = z + Σⱼ yⱼ e_{ι(j)}`,
`e_p = (e_{ι(0)}, …, e_{ι(m)})` and `Q₁ = (0, 1)ⁿ`.  Then `T = τ(N, θ, ξ)`, where `N` is the union
of the open faces `A_p = Φ_p(Q₁)` with `β_p ≠ 0`, `θ = |β_p|` and `ξ = sgn(β_p) e_p^*` on `A_p`
(`e_p^*(α) = α(e_p)`).  The face facts (`Φ_p` an isometry, `A_p ⊆ F_p` closed with `Hⁿ(F_p) = 1`,
`∫_{F_p} f dHⁿ = ∫_{Q₁} f ∘ Φ_p`, `A_p ∩ F_q = ∅` for `q ≠ p`) make the `A_p` disjoint Borel sets
of measure `≤ 1`, so `(N, θ, ξ)` is Borel, countably `n`-rectifiable and locally integrable; near
`x ∈ A_p`, `N` coincides with `x + V_p`, `V_p = span e_p` (the other faces are closed and miss
`x`), so `TₓN = V_p`, oriented by `±e_p`; and face by face its action is `T(ω)`. -/
theorem Submission.dor_lmb_fcd_fr_lattice_chain_im : ∀ (P m : ℕ) (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (β : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℤ) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ p ∈ s, StrictMono p.2) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), T ω = ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) → IsIntegerMultiplicity T := by
  intro P m s β T hmono hT
  classical
  -- Step 1: the face facts, in the notation `Q₁`, `Φ_p`, `F_p`, `e_p`
  obtain ⟨Q₁, hQ₁⟩ : ∃ Q : Set (Euclid (m + 1)), Q = {y | ∀ i, 0 < y i ∧ y i < 1} := ⟨_, rfl⟩
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid (m + 1) → Euclid P,
      Φ = fun p y => WithLp.toLp 2 (fun i => (p.1 i : ℝ)) +
        ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ) := ⟨_, rfl⟩
  obtain ⟨F, hF⟩ : ∃ F : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Set (Euclid P),
      F = fun p => {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧
        x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)} := ⟨_, rfl⟩
  obtain ⟨e, he⟩ : ∃ e : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Fin (m + 1) → Euclid P,
      e = fun p k => EuclideanSpace.single (p.2 k) (1 : ℝ) := ⟨_, rfl⟩
  have hFG := fun p (hp : p ∈ s) => Submission.dor_lmb_fcd_fr_face_geometry P m p (hmono p hp)
  have hFmeas : ∀ p ∈ s, μHE[m + 1] (F p) = 1 := fun p hp => by
    rw [hF]; exact (hFG p hp).2.1
  have hFint : ∀ p ∈ s, ∀ f : Euclid P → ℝ,
      ∫ x in F p, f x ∂μHE[m + 1] = ∫ y in Q₁, f (Φ p y) := fun p hp f => by
    rw [hF, hQ₁, hΦ]; exact (hFG p hp).2.2.2.1 f
  have hΦF : ∀ p ∈ s, ∀ y ∈ Q₁, Φ p y ∈ F p := fun p hp y hy => by
    rw [hQ₁] at hy
    rw [hF, hΦ]
    exact (hFG p hp).2.2.2.2.1 y fun i => ⟨(hy i).1.le, (hy i).2.le⟩
  have hiso : ∀ p ∈ s, Isometry (Φ p) := fun p hp => Isometry.of_dist_eq fun y y' => by
    rw [hΦ]; exact (hFG p hp).2.2.2.2.2.1 y y'
  have hFclosed : ∀ p ∈ s, IsClosed (F p) := fun p hp => by
    rw [hF]; exact (hFG p hp).2.2.2.2.2.2.2.1
  have hΦnotF : ∀ p ∈ s, ∀ q ∈ s, q ≠ p → ∀ y ∈ Q₁, Φ p y ∉ F q :=
    fun p hp q hq hqp y hy => by
      rw [hQ₁] at hy
      rw [hF, hΦ]
      exact (hFG p hp).2.2.2.2.2.2.2.2 q (hmono q hq) hqp y hy
  have hQ₁open : IsOpen Q₁ := by
    rw [hQ₁, ofPred_forall]
    exact isOpen_iInter_of_finite fun i =>
      (isOpen_lt continuous_const (PiLp.continuous_apply 2 _ i)).inter
        (isOpen_lt (PiLp.continuous_apply 2 _ i) continuous_const)
  -- the open faces `A_p = Φ_p(Q₁) ⊆ F_p`: Borel, pairwise disjoint, `Hⁿ(A_p) ≤ 1`
  obtain ⟨A, hA⟩ : ∃ A : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Set (Euclid P),
      A = fun p => Φ p '' Q₁ := ⟨_, rfl⟩
  have hAmem : ∀ p x, x ∈ A p ↔ ∃ y ∈ Q₁, Φ p y = x := fun p x => by
    rw [hA]; exact Iff.rfl
  have hAmeas : ∀ p ∈ s, MeasurableSet (A p) := fun p hp => by
    rw [hA]
    exact (hiso p hp).isClosedEmbedding.measurableEmbedding.measurableSet_image.mpr
      hQ₁open.measurableSet
  have hAF : ∀ p ∈ s, A p ⊆ F p := fun p hp x hx => by
    obtain ⟨y, hy, rfl⟩ := (hAmem p x).mp hx
    exact hΦF p hp y hy
  have hAdisj : ∀ p ∈ s, ∀ q ∈ s, p ≠ q → Disjoint (A p) (A q) := fun p hp q hq hpq => by
    refine Set.disjoint_left.mpr fun x hxp hxq => ?_
    obtain ⟨y, hy, rfl⟩ := (hAmem p x).mp hxp
    exact hΦnotF p hp q hq (Ne.symm hpq) y hy (hAF q hq hxq)
  have hAfin : ∀ p ∈ s, μHE[m + 1] (A p) ≤ 1 := fun p hp =>
    (measure_mono (hAF p hp)).trans (hFmeas p hp).le
  -- Step 2: the triple `N = ⋃_{β_p ≠ 0} A_p`, `θ = Σ_p |β_p| 1_{A_p}`,
  -- `ξ = Σ_p sgn(β_p) 1_{A_p} e_p^*`
  obtain ⟨s', hs'⟩ : ∃ s' : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P)),
      s' = s.filter fun p => β p ≠ 0 := ⟨_, rfl⟩
  have hs's : ∀ p ∈ s', p ∈ s := fun p hp => by
    rw [hs'] at hp; exact (Finset.mem_filter.mp hp).1
  have hs'β : ∀ p ∈ s', β p ≠ 0 := fun p hp => by
    rw [hs'] at hp; exact (Finset.mem_filter.mp hp).2
  obtain ⟨N, hN⟩ : ∃ N : Set (Euclid P), N = ⋃ p ∈ s', A p := ⟨_, rfl⟩
  have hNmem : ∀ x, x ∈ N ↔ ∃ p ∈ s', x ∈ A p := fun x => by
    rw [hN]; simp only [mem_iUnion, exists_prop]
  have hNmeas : MeasurableSet N := by
    rw [hN]; exact Finset.measurableSet_biUnion s' fun p hp => hAmeas p (hs's p hp)
  obtain ⟨θ, hθ⟩ : ∃ θ : Euclid P → ℕ,
      θ = fun x => ∑ p ∈ s', (A p).indicator (fun _ => (β p).natAbs) x := ⟨_, rfl⟩
  obtain ⟨ξ, hξ⟩ : ∃ ξ : Euclid P → MultiVector P (m + 1),
      ξ = fun x => ∑ p ∈ s', (A p).indicator
        (fun _ => ((β p).sign : ℝ) • ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (e p)) x :=
    ⟨_, rfl⟩
  -- on `A_p` (`β_p ≠ 0`), by disjointness, `θ = |β_p|` and `ξ = sgn(β_p) e_p^*`
  have hθA : ∀ p ∈ s', ∀ x ∈ A p, θ x = (β p).natAbs := fun p hp x hx => by
    rw [hθ]
    beta_reduce
    rw [Finset.sum_eq_single_of_mem p hp, indicator_of_mem hx]
    intro q hq hqp
    exact indicator_of_notMem (fun hxq => Set.disjoint_left.mp
      (hAdisj p (hs's p hp) q (hs's q hq) (Ne.symm hqp)) hx hxq) _
  have hξA : ∀ p ∈ s', ∀ x ∈ A p,
      ξ x = ((β p).sign : ℝ) • ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (e p) :=
    fun p hp x hx => by
      rw [hξ]
      beta_reduce
      rw [Finset.sum_eq_single_of_mem p hp, indicator_of_mem hx]
      intro q hq hqp
      exact indicator_of_notMem (fun hxq => Set.disjoint_left.mp
        (hAdisj p (hs's p hp) q (hs's q hq) (Ne.symm hqp)) hx hxq) _
  -- Step 3: measurability, positivity, rectifiability, local integrability
  have hθmeas : Measurable θ := by
    rw [hθ]
    exact Finset.measurable_sum s' fun p hp => measurable_const.indicator (hAmeas p (hs's p hp))
  have hξmeas : StronglyMeasurable ξ := by
    -- `Λₙ(ℝᴾ)` is a topological additive group; its `ContinuousAdd` is not found by inference
    have : ContinuousAdd (MultiVector P (m + 1)) :=
      (inferInstance : IsTopologicalAddGroup (MultiVector P (m + 1))).toContinuousAdd
    rw [hξ]
    exact Finset.stronglyMeasurable_fun_sum s' fun p hp =>
      stronglyMeasurable_const.indicator (hAmeas p (hs's p hp))
  have hθpos : ∀ x ∈ N, 0 < θ x := fun x hx => by
    obtain ⟨p, hp, hxp⟩ := (hNmem x).mp hx
    rw [hθA p hp x hxp]
    exact Int.natAbs_pos.mpr (hs'β p hp)
  -- `N ⊆ ⋃_{j < |s'|} Φ_{p_j}(ℝⁿ)`, each `Φ_p` being `1`-Lipschitz
  have hrect : CountablyRectifiable (m + 1) N := by
    refine (Poincare.SimonGMT.Chapter03.countablyRectifiable_iUnion
      (fun j : ℕ => if h : j < s'.card then range (Φ (s'.equivFin.symm ⟨j, h⟩)) else ∅)
      fun j => ?_).mono fun x hx => ?_
    · beta_reduce
      split_ifs with h
      · exact Poincare.SimonGMT.Chapter03.countablyRectifiable_range
          (hiso _ (hs's _ (s'.equivFin.symm ⟨j, h⟩).2)).lipschitzWith
      · exact Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty
    · obtain ⟨p, hp, hxp⟩ := (hNmem x).mp hx
      obtain ⟨y, -, rfl⟩ := (hAmem p x).mp hxp
      refine mem_iUnion.mpr ⟨s'.equivFin ⟨p, hp⟩, ?_⟩
      rw [dite_eq_left (s'.equivFin ⟨p, hp⟩).2]
      simp only [Fin.eta, Equiv.symm_apply_apply]
      exact mem_range_self y
  -- `∫_{N ∩ K} θ dHⁿ ≤ Σ_p |β_p| Hⁿ(A_p) < ∞`
  have hθint : ∀ K : Set (Euclid P), IsCompact K → K ⊆ univ →
      ∫⁻ x in N ∩ K, (θ x : ℝ≥0∞) ∂μHE[m + 1] ≠ ∞ := by
    intro K _ _
    refine ne_top_of_le_ne_top ?_ (lintegral_mono_set inter_subset_left)
    rw [hN, lintegral_biUnion_finset
      (fun p hp q hq hpq => hAdisj p (hs's p hp) q (hs's q hq) hpq)
      fun p hp => hAmeas p (hs's p hp)]
    refine ENNReal.sum_ne_top.mpr fun p hp => ?_
    rw [setLIntegral_congr_fun (g := fun _ => ((β p).natAbs : ℝ≥0∞)) (hAmeas p (hs's p hp))
      fun x hx => by rw [hθA p hp x hx], setLIntegral_const]
    exact ENNReal.mul_ne_top (ENNReal.natCast_ne_top _)
      (ne_top_of_le_ne_top ENNReal.one_ne_top (hAfin p (hs's p hp)))
  -- Step 4: at `x ∈ A_p`, `TₓN = V_p = span e_p`, unit-oriented by `ξ(x) = ±e_p^*`
  have horth : ∀ p ∈ s, Orthonormal ℝ (e p) := fun p hp => by
    have h : e p = (EuclideanSpace.basisFun (Fin P) ℝ) ∘ p.2 := by
      funext k
      rw [he]
      simp only [Function.comp_apply, EuclideanSpace.basisFun_apply]
    rw [h]
    exact (EuclideanSpace.basisFun (Fin P) ℝ).orthonormal.comp p.2 (hmono p hp).injective
  have hunit : ∀ p ∈ s', IsUnitOrientationOf
      (((β p).sign : ℝ) • ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (e p))
      (Submodule.span ℝ (range (e p))) := fun p hp => by
    refine ⟨e p, horth p (hs's p hp), rfl, ?_⟩
    rcases lt_or_gt_of_ne (hs'β p hp) with h | h
    · refine Or.inr fun α => ?_
      rw [Int.sign_eq_neg_one_of_neg h]
      simp
    · refine Or.inl fun α => ?_
      rw [Int.sign_eq_one_of_pos h]
      simp
  have htan : ∀ p ∈ s', ∀ x ∈ A p,
      HasApproximateTangentSpaceAt (m + 1) N x (Submodule.span ℝ (range (e p))) := by
    intro p hp x hx
    have hps := hs's p hp
    obtain ⟨y₀, hy₀, rfl⟩ := (hAmem p x).mp hx
    -- `B_{r₁}(y₀) ⊆ Q₁`
    obtain ⟨r₁, hr₁, hball₁⟩ := Metric.isOpen_iff.mp hQ₁open y₀ hy₀
    -- `B_{r₂}(x)` misses the closed faces `F_q`, `q ∈ s' \ {p}`
    have hGclosed : IsClosed (⋃ q ∈ s'.erase p, F q) :=
      isClosed_biUnion_finset fun q hq => hFclosed q (hs's q (Finset.mem_of_mem_erase hq))
    have hxG : Φ p y₀ ∉ ⋃ q ∈ s'.erase p, F q := by
      simp only [mem_iUnion, exists_prop, not_exists, not_and]
      intro q hq
      exact hΦnotF p hps q (hs's q (Finset.mem_of_mem_erase hq)) (Finset.ne_of_mem_erase hq)
        y₀ hy₀
    obtain ⟨r₂, hr₂, hball₂⟩ := Metric.isOpen_iff.mp hGclosed.isOpen_compl _ hxG
    refine Submission.dor_lmb_fcd_fr_local_plane_tangent P (m + 1) N (Φ p y₀) _ (min r₁ r₂)
      ?_ (lt_min hr₁ hr₂) fun y hy => ?_
    · rw [finrank_span_eq_card (horth p hps).linearIndependent, Fintype.card_fin]
    have hy₁ : dist y (Φ p y₀) < r₁ := (mem_ball.mp hy).trans_le (min_le_left _ _)
    have hy₂ : y ∉ ⋃ q ∈ s'.erase p, F q :=
      hball₂ (mem_ball.mpr ((mem_ball.mp hy).trans_le (min_le_right _ _)))
    constructor
    · -- `y ∈ N` forces `y ∈ A_p`, so `y − x = Σ_k (y₁ − y₀)_k e_{ι(k)} ∈ V_p`
      intro hyN
      obtain ⟨q, hq, hyq⟩ := (hNmem y).mp hyN
      have hqp : q = p := by
        by_contra hqp
        exact hy₂ (mem_iUnion₂.mpr ⟨q, Finset.mem_erase.mpr ⟨hqp, hq⟩, hAF q (hs's q hq) hyq⟩)
      rw [hqp] at hyq
      obtain ⟨y₁, -, rfl⟩ := (hAmem p y).mp hyq
      have hdiff : Φ p y₁ - Φ p y₀ = ∑ k, (y₁ k - y₀ k) • e p k := by
        rw [hΦ, he]
        simp only [sub_smul, Finset.sum_sub_distrib, add_sub_add_left_eq_sub]
      rw [hdiff]
      exact sum_mem fun k _ => Submodule.smul_mem _ _ (Submodule.subset_span (mem_range_self k))
    · -- `y − x = Σ_k c_k e_{ι(k)}` with `|c| = |y − x| < r₁`, so `y = Φ_p(y₀ + c) ∈ A_p`
      intro hyV
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp hyV
      have hΦc : Φ p (y₀ + WithLp.toLp 2 c) = y := by
        have h : Φ p (y₀ + WithLp.toLp 2 c) = Φ p y₀ + ∑ k, c k • e p k := by
          rw [hΦ, he]
          simp only [PiLp.add_apply, add_smul, Finset.sum_add_distrib, add_assoc]
        rw [h, hc, add_sub_cancel]
      have hc₁ : y₀ + WithLp.toLp 2 c ∈ Q₁ := by
        apply hball₁
        rw [mem_ball, ← (hiso p hps).dist_eq, hΦc]
        exact hy₁
      exact (hNmem y).mpr ⟨p, hp, (hAmem p y).mpr ⟨_, hc₁, hΦc⟩⟩
  have horients : ∀ x ∈ N, ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt (m + 1) N x Q ∧ IsUnitOrientationOf (ξ x) Q := by
    intro x hx
    obtain ⟨p, hp, hxp⟩ := (hNmem x).mp hx
    exact ⟨_, htan p hp x hxp, by rw [hξA p hp x hxp]; exact hunit p hp⟩
  -- `R = (N, θ, ξ)` is an `IMRep` in `ℝ^P`
  refine ⟨⟨N, θ, ξ, hNmeas, subset_univ N, hrect, hθmeas, hθpos, hθint,
    hξmeas.aestronglyMeasurable, ae_restrict_of_forall_mem hNmeas horients⟩, fun ω => ?_⟩
  -- Step 5: `R` represents `T`, face by face
  show T ω = ∫ x in N, (θ x : ℝ) * ξ x ((ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 1]
  obtain ⟨⟨hsmooth, hcpt⟩, -⟩ := ω.2
  have hωc : Continuous (ω : DifferentialForm (Euclid P) (m + 1)) := ContDiff.continuous hsmooth
  obtain ⟨C, hC⟩ := hcpt.exists_bound_of_continuous hωc
  -- on `A_p`: `θ ⟨ω, ξ⟩ = |β_p| sgn(β_p) ω(e_p) = β_p ω(e_p)`
  have hpt : ∀ p ∈ s', ∀ x ∈ A p, (θ x : ℝ) * ξ x ((ω : DifferentialForm (Euclid P) (m + 1)) x) =
      (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) x (e p) := fun p hp x hx => by
    rw [hθA p hp x hx, hξA p hp x hx, smul_apply,
      ContinuousAlternatingMap.apply_apply, smul_eq_mul, ← mul_assoc]
    congr 1
    have h : (((β p).sign * ((β p).natAbs : ℤ) : ℤ) : ℝ) = (β p : ℝ) := by
      rw [Int.sign_mul_natAbs]
    rw [Int.cast_mul, Int.cast_natCast] at h
    rw [mul_comm]
    exact h
  -- integrability on each face: `|β_p ω(x)(e_p)| ≤ |β_p| sup ‖ω‖ ∏_k ‖e_{ι(k)}‖`, `Hⁿ(A_p) ≤ 1`
  have hintA : ∀ p ∈ s', IntegrableOn
      (fun x => (θ x : ℝ) * ξ x ((ω : DifferentialForm (Euclid P) (m + 1)) x)) (A p)
      μHE[m + 1] := by
    intro p hp
    have hps := hs's p hp
    have hcont : Continuous fun x =>
        (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) x (e p) :=
      continuous_const.mul
        ((ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (e p)).continuous.comp hωc)
    refine IntegrableOn.congr_fun ?_ (fun x hx => (hpt p hp x hx).symm) (hAmeas p hps)
    refine Measure.integrableOn_of_bounded (M := |(β p : ℝ)| * (C * ∏ k, ‖e p k‖))
      (ne_top_of_le_ne_top ENNReal.one_ne_top (hAfin p hps)) hcont.aestronglyMeasurable
      (Eventually.of_forall fun x => ?_)
    rw [norm_mul, Real.norm_eq_abs]
    gcongr
    exact ((((ω : DifferentialForm (Euclid P) (m + 1)) x).le_opNorm (e p)).trans
      (by gcongr; exact hC x))
  -- on each face, `∫_{A_p} β_p ω(e_p) dHⁿ = ∫_{F_p} 1_{A_p} β_p ω(e_p) dHⁿ`
  -- `= ∫_{Q₁} β_p ω(Φ_p y)(e_p) dy`
  have hface : ∀ p ∈ s', ∫ x in A p, (θ x : ℝ) *
      ξ x ((ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 1] =
      ∫ y in Q₁, (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) (Φ p y) (e p) := by
    intro p hp
    have hps := hs's p hp
    calc ∫ x in A p, (θ x : ℝ) * ξ x ((ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 1]
        = ∫ x in A p, (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) x (e p)
            ∂μHE[m + 1] := setIntegral_congr_fun (hAmeas p hps) fun x hx => hpt p hp x hx
      _ = ∫ x in F p, (A p).indicator
            (fun x => (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) x (e p)) x
            ∂μHE[m + 1] := by
          rw [integral_indicator (hAmeas p hps), Measure.restrict_restrict (hAmeas p hps),
            inter_eq_left.mpr (hAF p hps)]
      _ = ∫ y in Q₁, (A p).indicator
            (fun x => (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) x (e p)) (Φ p y) :=
          hFint p hps _
      _ = ∫ y in Q₁, (β p : ℝ) * (ω : DifferentialForm (Euclid P) (m + 1)) (Φ p y) (e p) :=
          setIntegral_congr_fun hQ₁open.measurableSet fun y hy =>
            indicator_of_mem ((hAmem p _).mpr ⟨y, hy, rfl⟩) _
  -- sum over the disjoint faces; the faces with `β_p = 0` contribute nothing
  rw [hT ω, hN, integral_biUnion_finset s' (fun p hp => hAmeas p (hs's p hp))
    (fun p hp q hq hpq => hAdisj p (hs's p hp) q (hs's q hq) hpq) hintA,
    Finset.sum_congr rfl hface, hs', Finset.sum_filter_of_ne]
  · subst hQ₁ hΦ he
    rfl
  · intro p _ hp0 hβ
    exact hp0 (by simp [hβ])
/-- **Total variation of a smooth function by duality with smooth test fields** (parent step 5:
`∫_W |Dw|` is bounded by the supremum of `∫ Dw · g` over `C^∞` fields `g` with compact support in
`W` and `|g| ≤ 1`).  Let `F = (Dw(·) eᵢ)ᵢ` be the gradient field of `w`, so `⟪F, h⟫ = Dw · h` and
`|F| = ‖Dw‖`; `F` is `C^∞`, and bounded by `M` on the compact set `closure W`.  Given `ε > 0`, the
smooth cut-off `rsd_mw_tfa_smooth_cutoff` (for `vol⌞W`) gives `χ ∈ C_c^∞(W)` with `0 ≤ χ ≤ 1` and
`vol (W ∩ {χ ≠ 1}) < ε`.  The field `g = χ F / √(|F|² + ε²)` is admissible, and
`Dw · g = ψ := χ |F|² / √(|F|² + ε²)`, which vanishes off `W`, so `∫_W ψ ≤ V`.  On `W`,
`|F| ≤ ψ + |M| 1_{χ ≠ 1} + ε` (if `χ = 1`, use `a ≤ a² / √(a² + ε²) + ε`; otherwise `|F| ≤ M`).
Integrating, `∫_W |F| ≤ V + (|M| + vol W) ε`, and `ε → 0` gives the claim. -/
theorem Submission.dor_lmb_fcd_cp_smooth_duality : ∀ (P : ℕ) (w : Euclid P → ℝ) (W : Set (Euclid P)) (V : ℝ), IsOpen W → Bornology.IsBounded W → ContDiff ℝ (⊤ : ℕ∞) w → (∀ g : Euclid P → Euclid P, ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ W → (∀ y, ‖g y‖ ≤ 1) → ∫ y, fderiv ℝ w y (g y) ≤ V) → ∫ y in W, ‖fderiv ℝ w y‖ ≤ V := by
  intro P w W V hWo hWb hw hV
  -- Step 1: the gradient field `F y = (Dw(y) eᵢ)ᵢ`, with `⟪F y, h⟫ = Dw(y) h` and `‖F y‖ = ‖Dw(y)‖`
  set F : Euclid P → Euclid P :=
    fun y => WithLp.toLp 2 (fun i => fderiv ℝ w y (EuclideanSpace.single i 1))
  have hinner : ∀ y h, inner ℝ (F y) h = fderiv ℝ w y h := by
    intro y h
    have hh : h = ∑ i, h i • EuclideanSpace.single i (1 : ℝ) := by
      ext j
      simp [Finset.sum_apply, Pi.single_apply]
    conv_rhs => rw [hh]
    simp [F, PiLp.inner_apply, map_sum, map_smul]
  have hFc : ContDiff ℝ (⊤ : ℕ∞) F := by
    have hD : ContDiff ℝ (⊤ : ℕ∞) (fun y => fderiv ℝ w y) :=
      hw.fderiv_right (by exact_mod_cast le_top)
    have : ContDiff ℝ (⊤ : ℕ∞) (fun y => (WithLp.linearEquiv 2 ℝ (Fin P → ℝ)).symm
        (fun i => fderiv ℝ w y (EuclideanSpace.single i 1))) := by
      apply (LinearEquiv.toContinuousLinearEquiv
        (WithLp.linearEquiv 2 ℝ (Fin P → ℝ)).symm).contDiff.comp
      exact contDiff_pi.2 fun i => hD.clm_apply contDiff_const
    simpa [F] using this
  have hFn : ∀ y, ‖F y‖ = ‖fderiv ℝ w y‖ := by
    intro y
    have hdual : InnerProductSpace.toDual ℝ (Euclid P) (F y) = fderiv ℝ w y := by
      ext h
      simp [InnerProductSpace.toDual_apply_apply, hinner]
    rw [← hdual, LinearIsometryEquiv.norm_map]
  simp_rw [← hFn]
  -- Step 2: `vol W < ∞`, `closure W` is compact, `‖F‖ ≤ M` on `closure W`, `‖F‖` integrable on `W`
  have hWm : volume W < ∞ := hWb.measure_lt_top
  have hWc : IsCompact (closure W) := hWb.isCompact_closure
  obtain ⟨M, hM⟩ := hWc.exists_bound_of_continuousOn hFc.continuous.continuousOn
  have hFi : IntegrableOn (fun y => ‖F y‖) W :=
    (hFc.continuous.norm.continuousOn.integrableOn_compact hWc).mono_set subset_closure
  -- the scalar inequality `a ≤ a² / S + ε` for `a ≤ S ≤ a + ε`
  have alg : ∀ ε a S : ℝ, 0 < S → a ≤ S → S ≤ a + ε → a ≤ S⁻¹ * a ^ 2 + ε := by
    intro ε a S hS haS hSa
    rw [inv_mul_eq_div, ← sub_le_iff_le_add, le_div_iff₀ hS]
    nlinarith [sq_nonneg (S - a), mul_nonneg hS.le (sub_nonneg.2 hSa)]
  -- Step 3: for every `ε > 0`, `∫_W ‖F‖ ≤ V + (|M| + vol W) ε`
  have key : ∀ ε : ℝ, 0 < ε → ∫ y in W, ‖F y‖ ≤ V + (|M| + volume.real W) * ε := by
    intro ε hε
    -- the smooth cut-off `χ` with compact support in `W` and `vol (W ∩ {χ ≠ 1}) < ε`
    have hfin : IsFiniteMeasure (volume.restrict W) := isFiniteMeasure_restrict.2 hWm.ne
    obtain ⟨χ, hχ, hχc, hχW, hχ01, hχm⟩ :=
      Submission.rsd_mw_tfa_smooth_cutoff P (volume.restrict W) W hfin hWo
        (by rw [Measure.restrict_apply' hWo.measurableSet, compl_inter_self, measure_empty]) ε hε
    -- the regularised length `s = √(‖F‖² + ε²)` and the test field `g = χ s⁻¹ F`
    set s : Euclid P → ℝ := fun y => √(‖F y‖ ^ 2 + ε ^ 2)
    have hspos : ∀ y, 0 < s y := by
      intro y
      show 0 < √(‖F y‖ ^ 2 + ε ^ 2)
      positivity
    have hsc : ContDiff ℝ (⊤ : ℕ∞) s :=
      ((hFc.norm_sq ℝ).add contDiff_const).sqrt fun y =>
        (by positivity : (0 : ℝ) < ‖F y‖ ^ 2 + ε ^ 2).ne'
    have hFs : ∀ y, ‖F y‖ ≤ s y := by
      intro y
      show ‖F y‖ ≤ √(‖F y‖ ^ 2 + ε ^ 2)
      exact (Real.le_sqrt (norm_nonneg _) (by positivity)).2 (le_add_of_nonneg_right (sq_nonneg ε))
    have hsF : ∀ y, s y ≤ ‖F y‖ + ε := by
      intro y
      show √(‖F y‖ ^ 2 + ε ^ 2) ≤ ‖F y‖ + ε
      rw [Real.sqrt_le_left (by positivity)]
      nlinarith [mul_nonneg (norm_nonneg (F y)) hε.le]
    have hgc : ContDiff ℝ (⊤ : ℕ∞) (fun y => χ y • ((s y)⁻¹ • F y)) :=
      hχ.smul ((hsc.inv fun y => (hspos y).ne').smul hFc)
    have hgcs : HasCompactSupport (fun y => χ y • ((s y)⁻¹ • F y)) :=
      hχc.smul_right (f' := fun y => (s y)⁻¹ • F y)
    have hgt : tsupport (fun y => χ y • ((s y)⁻¹ • F y)) ⊆ W :=
      (tsupport_smul_subset_left χ fun y => (s y)⁻¹ • F y).trans hχW
    have hg1 : ∀ y, ‖χ y • ((s y)⁻¹ • F y)‖ ≤ 1 := by
      intro y
      have hc0 : 0 ≤ (s y)⁻¹ * ‖F y‖ := mul_nonneg (inv_nonneg.2 (hspos y).le) (norm_nonneg _)
      have hc1 : (s y)⁻¹ * ‖F y‖ ≤ 1 := by
        rw [inv_mul_le_iff₀ (hspos y), mul_one]
        exact hFs y
      rw [norm_smul, norm_smul, Real.norm_of_nonneg (hχ01 y).1,
        Real.norm_of_nonneg (inv_nonneg.2 (hspos y).le)]
      exact (mul_le_of_le_one_left hc0 (hχ01 y).2).trans hc1
    -- `Dw(y) (g y) = ψ y := χ y s(y)⁻¹ ‖F y‖²`; `ψ` vanishes off `W`, so `∫_W ψ ≤ V`
    set ψ : Euclid P → ℝ := fun y => χ y * ((s y)⁻¹ * ‖F y‖ ^ 2)
    have hDg : ∀ y, fderiv ℝ w y (χ y • ((s y)⁻¹ • F y)) = ψ y := by
      intro y
      show fderiv ℝ w y (χ y • ((s y)⁻¹ • F y)) = χ y * ((s y)⁻¹ * ‖F y‖ ^ 2)
      rw [← hinner, inner_smul_right, inner_smul_right, real_inner_self_eq_norm_sq]
    have hψ0W : ∀ y ∉ W, ψ y = 0 := by
      intro y hy
      have h0 : χ y = 0 := image_eq_zero_of_notMem_tsupport fun h => hy (hχW h)
      show χ y * ((s y)⁻¹ * ‖F y‖ ^ 2) = 0
      rw [h0, zero_mul]
    have hψV : ∫ y in W, ψ y ≤ V := by
      rw [setIntegral_eq_integral_of_forall_compl_eq_zero hψ0W]
      calc ∫ y, ψ y = ∫ y, fderiv ℝ w y (χ y • ((s y)⁻¹ • F y)) := by simp_rw [hDg]
        _ ≤ V := hV (fun y => χ y • ((s y)⁻¹ • F y)) hgc hgcs hgt hg1
    -- pointwise on `W`: `‖F‖ ≤ ψ + |M| 1_{χ ≠ 1} + ε`
    have hEm : MeasurableSet {x | χ x ≠ 1} :=
      (isOpen_ne_fun hχ.continuous continuous_const).measurableSet
    have hpt : ∀ y ∈ W,
        ‖F y‖ ≤ ψ y + Set.indicator {x | χ x ≠ 1} (fun _ => |M|) y + ε := by
      intro y hy
      by_cases hy1 : χ y = 1
      · have hyE : y ∉ {x | χ x ≠ 1} := fun h => h hy1
        rw [indicator_of_notMem hyE, add_zero]
        show ‖F y‖ ≤ χ y * ((s y)⁻¹ * ‖F y‖ ^ 2) + ε
        rw [hy1, one_mul]
        exact alg ε _ _ (hspos y) (hFs y) (hsF y)
      · have hyE : y ∈ {x | χ x ≠ 1} := hy1
        rw [indicator_of_mem hyE]
        have hψ0 : 0 ≤ ψ y :=
          mul_nonneg (hχ01 y).1 (mul_nonneg (inv_nonneg.2 (hspos y).le) (sq_nonneg _))
        have h1 := hM y (subset_closure hy)
        have h2 := le_abs_self M
        show ‖F y‖ ≤ ψ y + |M| + ε
        linarith
    -- integrate over `W`
    have hψc : Continuous ψ :=
      hχ.continuous.mul ((hsc.continuous.inv₀ fun y => (hspos y).ne').mul
        (hFc.continuous.norm.pow 2))
    have hψi : IntegrableOn ψ W :=
      (hψc.continuousOn.integrableOn_compact hWc).mono_set subset_closure
    have hEi : IntegrableOn (Set.indicator {x | χ x ≠ 1} fun _ => |M|) W :=
      (integrableOn_const hWm.ne).indicator hEm
    have hψEi : IntegrableOn (fun y => ψ y + Set.indicator {x | χ x ≠ 1} (fun _ => |M|) y) W :=
      hψi.add hEi
    have hεi : IntegrableOn (fun _ => ε) W := integrableOn_const hWm.ne
    have hEε : (volume.restrict W).real {x | χ x ≠ 1} ≤ ε :=
      (ENNReal.toReal_lt_of_lt_ofReal hχm).le
    calc ∫ y in W, ‖F y‖
        ≤ ∫ y in W, (ψ y + Set.indicator {x | χ x ≠ 1} (fun _ => |M|) y + ε) :=
          setIntegral_mono_on hFi (hψEi.add hεi) hWo.measurableSet hpt
      _ = (∫ y in W, ψ y) + (∫ y in W, Set.indicator {x | χ x ≠ 1} (fun _ => |M|) y) +
            ∫ y in W, ε := by
          rw [integral_add hψEi hεi, integral_add hψi hEi]
      _ = (∫ y in W, ψ y) + (volume.restrict W).real {x | χ x ≠ 1} * |M| +
            volume.real W * ε := by
          rw [integral_indicator_const _ hEm, setIntegral_const, smul_eq_mul, smul_eq_mul]
      _ ≤ V + (|M| + volume.real W) * ε := by
          nlinarith [mul_le_mul_of_nonneg_right hEε (abs_nonneg M)]
  -- Step 4: let `ε → 0`
  refine le_of_forall_pos_le_add fun η hη => ?_
  have hL : 0 ≤ volume.real W := measureReal_nonneg
  have hpos : 0 < |M| + volume.real W + 1 := by positivity
  have h1 := key (η / (|M| + volume.real W + 1)) (div_pos hη hpos)
  have h2 : (|M| + volume.real W) * (η / (|M| + volume.real W + 1)) ≤ η := by
    rw [← mul_div_assoc, div_le_iff₀ hpos]
    nlinarith
  linarith
/-- **Dilation pull-back of a test form** (Simon 6.2.23 for `f = δ_λ`, `δ_λ(x) = λx`, `λ ≠ 0`):
`δ_λ^#ω = affinePullbackForm (λ·id) 0 ω` is again a test form on `ℝᴾ`, and
`(δ_λ^#ω)(x) = λᵏ ω(λx)` as `k`-covectors.  `x ↦ λx` is a homeomorphism, hence proper, so the
pull-back preserves compactly supported smooth forms; multilinearity of the covector `ω(λx)`
pulls `λ` out of each of its `k` slots. -/
theorem Submission.cmcdt_dil_pullback_testForm : ∀ (P k : ℕ) (lam : ℝ), lam ≠ 0 → ∀ ω : TestFormOn (univ : Set (Euclid P)) k, ∃ η : TestFormOn (univ : Set (Euclid P)) k, (η : DifferentialForm (Euclid P) k) = affinePullbackForm (lam • ContinuousLinearMap.id ℝ (Euclid P)) 0 (ω : DifferentialForm (Euclid P) k) ∧ ∀ x : Euclid P, (η : DifferentialForm (Euclid P) k) x = lam ^ k • (ω : DifferentialForm (Euclid P) k) (lam • x) := by
  intro P k lam hlam ω
  -- Step 1: `x ↦ 0 + (λ·id)x = λx` is a homeomorphism, hence a proper map.
  have hproper : IsProperMap
      (fun x : Euclid P => (0 : Euclid P) + (lam • ContinuousLinearMap.id ℝ (Euclid P)) x) := by
    convert (Homeomorph.smulOfNeZero (α := Euclid P) lam hlam).isProperMap using 1
    funext x
    simp
  -- Step 2: the pull-back along the proper map is a test form, trivially supported in `univ`.
  refine ⟨⟨affinePullbackForm (lam • ContinuousLinearMap.id ℝ (Euclid P)) 0
      (ω : DifferentialForm (Euclid P) k),
    affinePullbackForm_isTestForm _ _ hproper ω.property.1, subset_univ _⟩, rfl, fun x => ?_⟩
  -- Steps 3–4: `η(x)(v) = ω(λx)(λv₁, …, λvₖ) = (∏ᵢ λ) ω(λx)(v) = λᵏ ω(λx)(v)` for every `v`.
  have hx : (0 : Euclid P) + (lam • ContinuousLinearMap.id ℝ (Euclid P)) x = lam • x := by
    simp
  ext v
  have hv : (lam • ContinuousLinearMap.id ℝ (Euclid P)) ∘ v = fun i => lam • v i := by
    funext i
    simp
  simp only [affinePullbackForm, ContinuousAlternatingMap.compContinuousLinearMap_apply, hx, hv,
    ContinuousAlternatingMap.map_smul_univ, Fin.prod_const, ContinuousAlternatingMap.smul_apply]
/-- **Change of variables for `Hⁿ` under the dilation `T(x) = cx`, `c > 0`**: formula (1.1) for the
scaling of the mass measure of a cone (proof of Simon 7.4.5, chapter-07.txt lines 697–699, "by
virtue of the fact that `C` is a cone").  For every `M ⊆ ℝᴾ`: (i) `T_#(Hⁿ⌞T⁻¹(M)) = c⁻ⁿ Hⁿ⌞M`;
(ii) `∫⁻_{T⁻¹(M)} g(cz) dHⁿ(z) = c⁻ⁿ ∫⁻_M g dHⁿ` for every `g : ℝᴾ → [0, ∞]`; (iii) the same for
the Bochner integral of every `g : ℝᴾ → ℝ`.  `T` is a homeomorphism, hence a measurable embedding,
and `T⁻¹(B) = c⁻¹B` with `Hⁿ(c⁻¹B) = c⁻ⁿ Hⁿ(B)` gives `T_#Hⁿ = c⁻ⁿ Hⁿ`; restriction and integrals
commute with the push-forward along `T`. -/
theorem Submission.euclid_hausdorff_dilation_change_of_variables : ∀ (P n : ℕ) (c : ℝ), 0 < c → ∀ M : Set (Euclid P), Measure.map (fun x : Euclid P => c • x) (μHE[n].restrict ((fun x => c • x) ⁻¹' M)) = ENNReal.ofReal (c⁻¹ ^ n) • μHE[n].restrict M ∧ (∀ g : Euclid P → ℝ≥0∞, ∫⁻ z in (fun x => c • x) ⁻¹' M, g (c • z) ∂μHE[n] = ENNReal.ofReal (c⁻¹ ^ n) * ∫⁻ y in M, g y ∂μHE[n]) ∧ ∀ g : Euclid P → ℝ, ∫ z in (fun x => c • x) ⁻¹' M, g (c • z) ∂μHE[n] = c⁻¹ ^ n * ∫ y in M, g y ∂μHE[n] := by
  intro P n c hc M
  -- Step 1: `T(x) = cx` is a homeomorphism, hence a measurable embedding.
  have hT : MeasurableEmbedding (fun x : Euclid P => c • x) :=
    (Homeomorph.smulOfNeZero c hc.ne').measurableEmbedding
  -- Step 2: `T_#Hⁿ = c⁻ⁿ Hⁿ`, since `Hⁿ(T⁻¹(B)) = Hⁿ(c⁻¹B) = ‖c⁻¹‖ⁿ Hⁿ(B)` for Borel `B`.
  have hmap : Measure.map (fun x : Euclid P => c • x) (μHE[n] : Measure (Euclid P)) =
      ENNReal.ofReal (c⁻¹ ^ n) • (μHE[n] : Measure (Euclid P)) := by
    ext B hB
    rw [Measure.map_apply hT.measurable hB, Set.preimage_smul₀ hc.ne',
      Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hc.ne'), Measure.smul_apply,
      ENNReal.smul_def, smul_eq_mul, smul_eq_mul, ← ENNReal.ofReal_coe_nnreal]
    congr 2
    simp [abs_of_pos hc]
  -- Step 3, (i): `T_#(Hⁿ⌞T⁻¹(M)) = (T_#Hⁿ)⌞M = c⁻ⁿ Hⁿ⌞M`.
  have h1 : Measure.map (fun x : Euclid P => c • x) (μHE[n].restrict ((fun x => c • x) ⁻¹' M)) =
      ENNReal.ofReal (c⁻¹ ^ n) • μHE[n].restrict M := by
    rw [← hT.restrict_map, hmap, Measure.restrict_smul]
  refine ⟨h1, fun g => ?_, fun g => ?_⟩
  -- Step 4, (ii): `∫⁻ g ∘ T dν = ∫⁻ g d(T_#ν)` for `ν = Hⁿ⌞T⁻¹(M)`, then (i).
  · have h := hT.lintegral_map (μ := μHE[n].restrict ((fun x => c • x) ⁻¹' M)) g
    rw [h1, lintegral_smul_measure, smul_eq_mul] at h
    exact h.symm
  -- Step 5, (iii): the same for Bochner integrals, with `(ofReal c⁻ⁿ).toReal = c⁻ⁿ`.
  · have h := hT.integral_map (μ := μHE[n].restrict ((fun x => c • x) ⁻¹' M)) g
    rw [h1, integral_smul_measure, ENNReal.toReal_ofReal (by positivity), smul_eq_mul] at h
    exact h.symm
/-- Approximate tangent spaces are invariant under the dilation `η = η_{x,λ}`, `λ > 0`
(Simon Ch. 3, 1.4).  As `η(w) − η(y) = λ⁻¹(w − y)`, the rescaled set `η_{η(y),r}(η(M))` is
`η_{y,λr}(M)`, and `r ↦ λr` maps `r ↓ 0` into `s ↓ 0`; `dim Q = n` is unchanged. -/
theorem Submission.dtc_approxTangent_dilation : ∀ (P n : ℕ) (M : Set (Euclid P)) (x y : Euclid P) (lam : ℝ) (Q : Submodule ℝ (Euclid P)), 0 < lam → HasApproximateTangentSpaceAt n M y Q → HasApproximateTangentSpaceAt n (dilation x lam '' M) (dilation x lam y) Q := by
  intro P n M x y lam Q hlam hT
  refine ⟨hT.1, fun f => ?_⟩
  -- `η_{η(y),r}(η(M)) = η_{y,λr}(M)`, since `η(w) − η(y) = λ⁻¹(w − y)`
  have hset : ∀ r : ℝ, Poincare.SimonGMT.Chapter03.blowUpMap (dilation x lam y) r ''
      (dilation x lam '' M) = Poincare.SimonGMT.Chapter03.blowUpMap y (lam * r) '' M := by
    intro r
    rw [image_image]
    congr 1
    funext w
    simp only [Poincare.SimonGMT.Chapter03.blowUpMap, dilation, dilationCLM,
      smul_apply, ContinuousLinearMap.id_apply, add_sub_add_left_eq_sub]
    rw [← smul_sub, smul_smul, mul_inv, mul_comm]
  simp_rw [hset]
  -- `r ↦ λr` maps `r ↓ 0` into `s ↓ 0`
  have hlim : Tendsto (fun r : ℝ => lam * r) (𝓝[>] 0) (𝓝[>] 0) := by
    refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ ?_ ?_
    · simpa using (tendsto_id.const_mul lam).mono_left (nhdsWithin_le_nhds (a := (0 : ℝ)))
    · filter_upwards [self_mem_nhdsWithin] with r hr
      exact mul_pos hlam hr
  exact (hT.2 f).comp hlim

/-- **Mass under the dilation push-forward** (step 5 of the proof of
`Submission.cmcdt_dilation_pushforward`; Simon 6.5.3, chapter-06.txt lines 1458–1460: the changes
of scale `x ↦ λ⁻¹x` and `x ↦ λx` scale the masses of `k`-currents by `λ^{∓k}`).  Let `λ > 0` and
`X, Y ∈ 𝒟_k(ℝᴾ)` with `Y(ω) = X(η)` whenever `η = δ_λ^#ω`, i.e. `Y = δ_{λ#}X` for `δ_λ(x) = λx`
(6.2.23).  Then `M(Y) = λᵏ M(X)` in `[0, ∞]`, with no finiteness assumption.  By
`Submission.cmcdt_dil_pullback_testForm`, `δ_μ^#ω` is a test form with `(δ_μ^#ω)(x) = μᵏ ω(μx)`
for `μ ≠ 0`.  (1) For admissible `ω`, `η' = λ⁻ᵏ δ_λ^#ω` has `η'(x) = ω(λx)`, so it is admissible
and `Y(ω) = X(δ_λ^#ω) = λᵏ X(η') ≤ λᵏ M(X)`.  (2) For admissible `η`, `ω = λᵏ δ_{λ⁻¹}^#η` has
`ω(y) = η(λ⁻¹y)`, so it is admissible, and `δ_λ^#ω = λᵏ η`; thus `λᵏ X(η) = Y(ω) ≤ M(Y)`, and
`λᵏ M(X) ≤ M(Y)` because multiplication by `λᵏ` commutes with suprema in `[0, ∞]`. -/
theorem Submission.cmcdt_dil_mass_eq : ∀ (P k : ℕ) (lam : ℝ), 0 < lam → ∀ X Y : GeometricCurrentOn (univ : Set (Euclid P)) k, (∀ ω η : TestFormOn (univ : Set (Euclid P)) k, (η : DifferentialForm (Euclid P) k) = affinePullbackForm (lam • ContinuousLinearMap.id ℝ (Euclid P)) 0 (ω : DifferentialForm (Euclid P) k) → Y ω = X η) → Y.mass = ENNReal.ofReal (lam ^ k) * X.mass := by
  intro P k lam hlam X Y hXY
  have hlam0 : lam ≠ 0 := hlam.ne'
  have hpow : 0 < lam ^ k := pow_pos hlam k
  apply le_antisymm
  -- Step 1: `M(Y) ≤ λᵏ M(X)`.  Fix an admissible `ω`.
  · refine sSup_le ?_
    rintro _ ⟨ω, hω, rfl⟩
    show ENNReal.ofReal (Y ω) ≤ ENNReal.ofReal (lam ^ k) * X.mass
    -- (a) `η = δ_λ^#ω` is a test form with `η(x) = λᵏ ω(λx)`, and `Y(ω) = X(η)`.
    obtain ⟨η, hηω, hη⟩ := Submission.cmcdt_dil_pullback_testForm P k lam hlam0 ω
    -- (b) `η' = λ⁻ᵏ η` has `η'(x) = ω(λx)`, so it is admissible.
    have hη' : (lam ^ k)⁻¹ • η ∈ massAdmissibleOn (univ : Set (Euclid P)) k univ := by
      refine ⟨subset_univ _, fun x => ?_⟩
      change covectorEuclideanNorm ((lam ^ k)⁻¹ • (η : DifferentialForm (Euclid P) k) x) ≤ 1
      rw [hη x, smul_smul, inv_mul_cancel₀ hpow.ne', one_smul]
      exact hω.2 (lam • x)
    -- (c) `X(η) = λᵏ X(η')` by linearity.
    have hXη : X η = lam ^ k * X ((lam ^ k)⁻¹ • η) := by
      rw [map_smul, smul_eq_mul, ← mul_assoc, mul_inv_cancel₀ hpow.ne', one_mul]
    -- (d) `Y(ω) = λᵏ X(η') ≤ λᵏ M(X)`.
    rw [hXY ω η hηω, hXη, ENNReal.ofReal_mul hpow.le]
    exact mul_le_mul_right (X.le_massOn hη') _
  -- Step 2: `λᵏ M(X) ≤ M(Y)`, where `λᵏ M(X)` is the supremum of `λᵏ X(η)` over admissible `η`.
  · show ENNReal.ofReal (lam ^ k) * sSup ((fun ω => ENNReal.ofReal (X ω)) ''
      massAdmissibleOn (univ : Set (Euclid P)) k univ) ≤ Y.mass
    rw [ENNReal.mul_sSup]
    refine iSup₂_le ?_
    rintro _ ⟨η, hη, rfl⟩
    show ENNReal.ofReal (lam ^ k) * ENNReal.ofReal (X η) ≤ Y.mass
    -- (a) `ζ = δ_{λ⁻¹}^#η` and `ω = λᵏ ζ`, so `ω(y) = η(λ⁻¹y)`.
    obtain ⟨ζ, -, hζ⟩ := Submission.cmcdt_dil_pullback_testForm P k lam⁻¹ (inv_ne_zero hlam0) η
    have hω : ∀ y, ((lam ^ k • ζ : TestFormOn (univ : Set (Euclid P)) k) :
        DifferentialForm (Euclid P) k) y = (η : DifferentialForm (Euclid P) k) (lam⁻¹ • y) := by
      intro y
      change lam ^ k • (ζ : DifferentialForm (Euclid P) k) y = _
      rw [hζ y, smul_smul, ← mul_pow, mul_inv_cancel₀ hlam0, one_pow, one_smul]
    -- (b) `ω` is admissible.
    have hωadm : lam ^ k • ζ ∈ massAdmissibleOn (univ : Set (Euclid P)) k univ := by
      refine ⟨subset_univ _, fun y => ?_⟩
      rw [hω y]
      exact hη.2 (lam⁻¹ • y)
    -- (c) `η₂ = δ_λ^#ω` satisfies `η₂(x) = λᵏ ω(λx) = λᵏ η(x)`, i.e. `η₂ = λᵏ η`.
    obtain ⟨η₂, hη₂ω, hη₂⟩ := Submission.cmcdt_dil_pullback_testForm P k lam hlam0 (lam ^ k • ζ)
    have hη₂η : η₂ = lam ^ k • η := by
      refine Subtype.ext (funext fun x => ?_)
      change (η₂ : DifferentialForm (Euclid P) k) x = lam ^ k • (η : DifferentialForm (Euclid P) k) x
      rw [hη₂ x, hω, inv_smul_smul₀ hlam0]
    -- (d) `λᵏ X(η) = X(η₂) = Y(ω) ≤ M(Y)`.
    calc ENNReal.ofReal (lam ^ k) * ENNReal.ofReal (X η)
        = ENNReal.ofReal (Y (lam ^ k • ζ)) := by
          rw [hXY (lam ^ k • ζ) η₂ hη₂ω, hη₂η, map_smul, smul_eq_mul, ENNReal.ofReal_mul hpow.le]
      _ ≤ Y.mass := Y.le_massOn hωadm
/-- **Integer multiplicity is preserved by the dilation push-forward** `δ_{λ#}`, `δ_λ(x) = λx`,
`λ > 0` (step 7 of the proof of `cmcdt_dilation_pushforward`; compare Simon 6.3.3).  If
`Y(ω) = X(δ_λ^#ω)` and `X = τ(M, θ, ξ)`, then `Y = τ(λM, θ(·/λ), ξ(·/λ))`, with
`λM = δ_{λ⁻¹}⁻¹(M)`.  The change of variables `(δ_λ)_#(Hᵏ⌞M) = λ⁻ᵏ Hᵏ⌞λM` transfers local
integrability, measurability and orientation (`T_{λx}(λM) = TₓM`), and `δ_λ^#ω(x) = λᵏω(λx)`
gives `Y(ω) = λᵏλ⁻ᵏ ∫_{λM} θ(·/λ) ⟨ω, ξ(·/λ)⟩ dHᵏ`.  This holds in every degree `k`. -/
theorem Submission.cmcdt_dil_isIntegerMultiplicity : ∀ (P k : ℕ) (lam : ℝ), 0 < lam → ∀ X Y : GeometricCurrentOn (univ : Set (Euclid P)) k, (∀ ω η : TestFormOn (univ : Set (Euclid P)) k, (η : DifferentialForm (Euclid P) k) = affinePullbackForm (lam • ContinuousLinearMap.id ℝ (Euclid P)) 0 (ω : DifferentialForm (Euclid P) k) → Y ω = X η) → IsIntegerMultiplicity X → IsIntegerMultiplicity Y := by
  intro P k lam hlam X Y hXY ⟨R, hR⟩
  have hlam0 : lam ≠ 0 := hlam.ne'
  -- `δ_λ` is a homeomorphism, hence a measurable embedding, and `δ_λ⁻¹(δ_{λ⁻¹}⁻¹(S)) = S`
  have hT : MeasurableEmbedding (fun x : Euclid P => lam • x) :=
    (Homeomorph.smulOfNeZero lam hlam0).measurableEmbedding
  have hpre : ∀ S : Set (Euclid P),
      (fun x : Euclid P => lam • x) ⁻¹' ((fun y : Euclid P => lam⁻¹ • y) ⁻¹' S) = S := by
    intro S
    ext x
    simp only [mem_preimage, inv_smul_smul₀ hlam0]
  have hc0 : ENNReal.ofReal (lam⁻¹ ^ k) ≠ 0 :=
    (ENNReal.ofReal_pos.2 (pow_pos (inv_pos.2 hlam) k)).ne'
  -- change of variables on `M' = δ_{λ⁻¹}⁻¹(M)`: `(δ_λ)_#(Hᵏ⌞M) = λ⁻ᵏ Hᵏ⌞M'` and
  -- `∫_M g(λz) dHᵏ(z) = λ⁻ᵏ ∫_{M'} g dHᵏ`
  obtain ⟨hcv1, -, hcv3⟩ := Submission.euclid_hausdorff_dilation_change_of_variables P k lam hlam
    ((fun y : Euclid P => lam⁻¹ • y) ⁻¹' R.carrier)
  rw [hpre] at hcv1 hcv3
  -- rectifiability: `M' ⊆ δ_{λ⁻¹}⁻¹(M₀) ∪ ⋃ⱼ range (λFⱼ)`, with `Hᵏ(δ_{λ⁻¹}⁻¹(M₀)) = λᵏHᵏ(M₀) = 0`
  have hrect : CountablyRectifiable k ((fun y : Euclid P => lam⁻¹ • y) ⁻¹' R.carrier) := by
    obtain ⟨M₀, hM₀, F, hF, hcover⟩ := R.rectifiable
    refine ⟨(fun y : Euclid P => lam⁻¹ • y) ⁻¹' M₀, ?_, fun j z => lam • F j z, fun j => ?_,
      fun y hy => ?_⟩
    · rw [preimage_smul₀ (inv_ne_zero hlam0),
        Measure.euclideanHausdorffMeasure_smul₀ k (inv_ne_zero (inv_ne_zero hlam0)), hM₀,
        smul_zero]
    · obtain ⟨K, hK⟩ := hF j
      exact ⟨‖lam‖₊ * K, (lipschitzWith_smul lam).comp hK⟩
    · have hy' : lam⁻¹ • y ∈ R.carrier := hy
      rcases hcover hy' with h0 | h1
      · exact Or.inl h0
      · obtain ⟨j, z, hz⟩ := mem_iUnion.1 h1
        exact Or.inr (mem_iUnion.2 ⟨j, z, by simp only [hz, smul_inv_smul₀ hlam0]⟩)
  -- local integrability: `∫⁻_{M ∩ δ_λ⁻¹(K)} θ dHᵏ = λ⁻ᵏ ∫⁻_{M' ∩ K} θ(·/λ) dHᵏ`
  have hint : ∀ K : Set (Euclid P), IsCompact K → K ⊆ univ →
      ∫⁻ x in (fun y : Euclid P => lam⁻¹ • y) ⁻¹' R.carrier ∩ K,
        (R.mult (lam⁻¹ • x) : ℝ≥0∞) ∂μHE[k] ≠ ∞ := by
    intro K hK _ htop
    have hKc : IsCompact ((fun x : Euclid P => lam • x) ⁻¹' K) :=
      (Homeomorph.smulOfNeZero lam hlam0).isCompact_preimage.2 hK
    have h := (Submission.euclid_hausdorff_dilation_change_of_variables P k lam hlam
      ((fun y : Euclid P => lam⁻¹ • y) ⁻¹' R.carrier ∩ K)).2.1
      (fun y => (R.mult (lam⁻¹ • y) : ℝ≥0∞))
    rw [preimage_inter, hpre] at h
    simp only [inv_smul_smul₀ hlam0] at h
    rw [htop, ENNReal.mul_top hc0] at h
    exact R.locallyIntegrable_mult _ hKc (subset_univ _) h
  -- measurability: `ξ(·/λ) ∘ δ_λ = ξ`, and `Hᵏ⌞M' ≪ λ⁻ᵏ Hᵏ⌞M' = (δ_λ)_#(Hᵏ⌞M)`
  have hmeas : AEStronglyMeasurable (fun y : Euclid P => R.orient (lam⁻¹ • y))
      (μHE[k].restrict ((fun y : Euclid P => lam⁻¹ • y) ⁻¹' R.carrier)) := by
    have h : AEStronglyMeasurable (fun y : Euclid P => R.orient (lam⁻¹ • y))
        (Measure.map (fun x : Euclid P => lam • x) (μHE[k].restrict R.carrier)) := by
      rw [hT.aestronglyMeasurable_map_iff]
      have he : ((fun y : Euclid P => R.orient (lam⁻¹ • y)) ∘ fun x : Euclid P => lam • x) =
          R.orient := by
        funext x
        simp only [Function.comp_apply, inv_smul_smul₀ hlam0]
      rw [he]
      exact R.aestronglyMeasurable_orient
    rw [hcv1] at h
    exact h.mono_ac (Measure.absolutelyContinuous_smul hc0)
  -- orientation: `T_{λx}M' = TₓM` (dilation invariance, `dilation 0 λ⁻¹ = δ_λ`) and
  -- `ξ(λx/λ) = ξ(x)`, transferred from `Hᵏ⌞M`-a.e. `x` to `Hᵏ⌞M'`-a.e. `y = λx`
  have hdil : dilation (0 : Euclid P) lam⁻¹ = fun y => lam • y := by
    funext y
    simp [dilation, dilationCLM]
  have himg : (fun y : Euclid P => lam • y) '' R.carrier =
      (fun y : Euclid P => lam⁻¹ • y) ⁻¹' R.carrier := by
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      simpa only [mem_preimage, inv_smul_smul₀ hlam0] using hx
    · intro hy
      exact ⟨lam⁻¹ • y, hy, smul_inv_smul₀ hlam0 y⟩
  have hor : ∀ᵐ y ∂(μHE[k].restrict ((fun y : Euclid P => lam⁻¹ • y) ⁻¹' R.carrier)),
      ∃ Q : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt k ((fun y : Euclid P => lam⁻¹ • y) ⁻¹' R.carrier) y Q ∧
          IsUnitOrientationOf (R.orient (lam⁻¹ • y)) Q := by
    refine (Measure.ae_ennreal_smul_measure_iff hc0).1 ?_
    rw [← hcv1, hT.ae_map_iff]
    filter_upwards [R.orients] with x hx
    obtain ⟨Q, hQ, hξ⟩ := hx
    refine ⟨Q, ?_, ?_⟩
    · have h := Submission.dtc_approxTangent_dilation P k R.carrier 0 x lam⁻¹ Q
        (inv_pos.2 hlam) hQ
      rwa [hdil, himg] at h
    · rwa [inv_smul_smul₀ hlam0]
  refine ⟨{ carrier := (fun y : Euclid P => lam⁻¹ • y) ⁻¹' R.carrier
            mult := fun y => R.mult (lam⁻¹ • y)
            orient := fun y => R.orient (lam⁻¹ • y)
            measurableSet_carrier :=
              (continuous_const_smul lam⁻¹).measurable R.measurableSet_carrier
            carrier_subset := subset_univ _
            rectifiable := hrect
            measurable_mult := R.measurable_mult.comp (continuous_const_smul lam⁻¹).measurable
            mult_pos := fun y hy => R.mult_pos _ hy
            locallyIntegrable_mult := hint
            aestronglyMeasurable_orient := hmeas
            orients := hor }, fun ω => ?_⟩
  -- representation: `Y(ω) = X(η)` with `η(x) = λᵏω(λx)` (pullback test form), then change of
  -- variables with `g(y) = θ(y/λ) ⟨ω(y), ξ(y/λ)⟩`
  obtain ⟨η, hη, hηx⟩ := Submission.cmcdt_dil_pullback_testForm P k lam hlam0 ω
  rw [hXY ω η hη, hR η]
  show ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x ((η : DifferentialForm (Euclid P) k) x)
      ∂μHE[k] = ∫ y in (fun y : Euclid P => lam⁻¹ • y) ⁻¹' R.carrier,
        (R.mult (lam⁻¹ • y) : ℝ) * R.orient (lam⁻¹ • y) ((ω : DifferentialForm (Euclid P) k) y)
          ∂μHE[k]
  have h3 := hcv3 fun y => (R.mult (lam⁻¹ • y) : ℝ) *
    R.orient (lam⁻¹ • y) ((ω : DifferentialForm (Euclid P) k) y)
  simp only [inv_smul_smul₀ hlam0] at h3
  calc ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x ((η : DifferentialForm (Euclid P) k) x)
        ∂μHE[k]
      = ∫ x in R.carrier, lam ^ k * ((R.mult x : ℝ) *
          R.orient x ((ω : DifferentialForm (Euclid P) k) (lam • x))) ∂μHE[k] := by
        refine integral_congr_ae (ae_of_all _ fun x => ?_)
        simp only [hηx x, map_smul, smul_eq_mul]
        ring
    _ = lam ^ k * ∫ x in R.carrier, (R.mult x : ℝ) *
          R.orient x ((ω : DifferentialForm (Euclid P) k) (lam • x)) ∂μHE[k] :=
        integral_const_mul _ _
    _ = lam ^ k * (lam⁻¹ ^ k * ∫ y in (fun y : Euclid P => lam⁻¹ • y) ⁻¹' R.carrier,
          (R.mult (lam⁻¹ • y) : ℝ) *
            R.orient (lam⁻¹ • y) ((ω : DifferentialForm (Euclid P) k) y) ∂μHE[k]) := by
        rw [h3]
    _ = _ := by
        rw [← mul_assoc, ← mul_pow, mul_inv_cancel₀ hlam0, one_pow, one_mul]

/-- **Change of scale `x ↦ λx`** (Simon 6.5.3, chapter-06.txt lines 1458–1459: the scaled
Deformation Theorem follows from 6.5.1 "by first changing scale `x → ρ⁻¹x`, then applying 5.1,
then changing scale back by `x → ρx`").  `dil k λ X = δ_{λ#}X` is the push-forward 6.2.23 along
`δ_λ(x) = λx`, `dil k λ X (ω) = X(δ_λ^#ω)` with `(δ_λ^#ω)(x) = λᵏ ω(λx)`, built from the proper
affine push-forward `GeometricCurrentOn.affinePushforward` (`λ ≠ 0`; `dil k λ X = X` otherwise).
It is additive, `δ_{λ⁻¹#}δ_{λ#} = id`, scales mass by `λᵏ` (`Submission.cmcdt_dil_mass_eq`),
preserves integer multiplicity (`Submission.cmcdt_dil_isIntegerMultiplicity`), commutes with `∂`
(6.2.24(1)), moves vanishing sets by `δ_λ`, and `Hᵏ`-integrals over `δ_λ(A)` scale by `λᵏ`
(`Submission.euclid_hausdorff_dilation_change_of_variables` with `δ_λ⁻¹(δ_λ(A)) = A`). -/
theorem Submission.dor_lmb_fcd_dilation : ∀ P : ℕ, ∃ dil : ∀ k : ℕ, ℝ → GeometricCurrentOn (univ : Set (Euclid P)) k → GeometricCurrentOn (univ : Set (Euclid P)) k, ∀ (k : ℕ) (lam : ℝ), 0 < lam → (∀ X Y : GeometricCurrentOn (univ : Set (Euclid P)) k, dil k lam (X - Y) = dil k lam X - dil k lam Y) ∧ (∀ X : GeometricCurrentOn (univ : Set (Euclid P)) k, dil k lam⁻¹ (dil k lam X) = X) ∧ (∀ X : GeometricCurrentOn (univ : Set (Euclid P)) k, (dil k lam X).mass = ENNReal.ofReal (lam ^ k) * X.mass) ∧ (∀ X : GeometricCurrentOn (univ : Set (Euclid P)) k, IsIntegerMultiplicity X → IsIntegerMultiplicity (dil k lam X)) ∧ (∀ X : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1), (dil (k + 1) lam X).boundary = dil k lam X.boundary) ∧ (∀ (X : GeometricCurrentOn (univ : Set (Euclid P)) k) (E : Set (Euclid P)), (∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) (E) → X ω = 0) → ∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) ((fun x => lam • x) '' E) → dil k lam X ω = 0) ∧ (∀ (X : GeometricCurrentOn (univ : Set (Euclid P)) k) (ω : TestFormOn (univ : Set (Euclid P)) k), ∃ η : TestFormOn (univ : Set (Euclid P)) k, (∀ x, (η : DifferentialForm (Euclid P) k) x = lam ^ k • (ω : DifferentialForm (Euclid P) k) (lam • x)) ∧ dil k lam X ω = X η) ∧ ∀ (A : Set (Euclid P)) (g : Euclid P → ℝ), ∫ y in (fun x => lam • x) '' A, g y ∂μHE[k] = lam ^ k * ∫ x in A, g (lam • x) ∂μHE[k] := by
  intro P
  -- Step 0: `δ_λ(x) = 0 + (λ·id)x = λx` is a homeomorphism for `λ ≠ 0`, hence proper.
  have hproper : ∀ lam : ℝ, lam ≠ 0 → IsProperMap
      (fun x : Euclid P => (0 : Euclid P) + (lam • ContinuousLinearMap.id ℝ (Euclid P)) x) := by
    intro lam hlam
    convert (Homeomorph.smulOfNeZero (α := Euclid P) lam hlam).isProperMap using 1
    funext x
    simp
  -- Step 1: `dil k λ X = δ_{λ#}X` (6.2.23) for `λ ≠ 0`, `X` otherwise; `dil k λ X (ω) = X(δ_λ^#ω)`.
  obtain ⟨dil, hdil⟩ : ∃ dil : ∀ k : ℕ, ℝ → GeometricCurrentOn (univ : Set (Euclid P)) k →
      GeometricCurrentOn (univ : Set (Euclid P)) k,
      ∀ (k : ℕ) (lam : ℝ), lam ≠ 0 → ∀ (X : GeometricCurrentOn (univ : Set (Euclid P)) k)
        (ω η : TestFormOn (univ : Set (Euclid P)) k),
        (η : DifferentialForm (Euclid P) k) = affinePullbackForm
          (lam • ContinuousLinearMap.id ℝ (Euclid P)) 0 (ω : DifferentialForm (Euclid P) k) →
        dil k lam X ω = X η := by
    classical
    refine ⟨fun k lam X => if hlam : lam ≠ 0 then
      (X.restrictDomain (subset_univ _)).affinePushforward
        (lam • ContinuousLinearMap.id ℝ (Euclid P)) 0 (hproper lam hlam) else X, ?_⟩
    intro k lam hlam X ω η hη
    simp only [dite_eq_left hlam, GeometricCurrentOn.affinePushforward_apply,
      GeometricCurrentOn.restrictDomain_apply]
    congr 1
    exact Subtype.ext hη.symm
  refine ⟨dil, fun k lam hlam => ?_⟩
  have hlam0 : lam ≠ 0 := hlam.ne'
  refine ⟨fun X Y => ?_, fun X => ?_, fun X => ?_, fun X hX => ?_, fun X => ?_,
    fun X E hXE ω hω => ?_, fun X ω => ?_, fun A g => ?_⟩
  -- Step 2 (sub): `δ_{λ#}(X − Y)(ω) = (X − Y)(δ_λ^#ω) = X(δ_λ^#ω) − Y(δ_λ^#ω)`.
  · ext ω
    obtain ⟨η, hη, -⟩ := Submission.cmcdt_dil_pullback_testForm P k lam hlam0 ω
    change dil k lam (X - Y) ω = dil k lam X ω - dil k lam Y ω
    rw [hdil k lam hlam0 (X - Y) ω η hη, hdil k lam hlam0 X ω η hη, hdil k lam hlam0 Y ω η hη]
    rfl
  -- Step 3 (inverse): `δ_λ^#(δ_{λ⁻¹}^#ω)(x) = λᵏλ⁻ᵏ ω(λ⁻¹λx) = ω(x)`.
  · ext ω
    obtain ⟨ζ, hζ, hζx⟩ := Submission.cmcdt_dil_pullback_testForm P k lam⁻¹ (inv_ne_zero hlam0) ω
    obtain ⟨η, hη, hηx⟩ := Submission.cmcdt_dil_pullback_testForm P k lam hlam0 ζ
    have hηω : η = ω := by
      refine Subtype.ext (funext fun x => ?_)
      change (η : DifferentialForm (Euclid P) k) x = (ω : DifferentialForm (Euclid P) k) x
      rw [hηx x, hζx, smul_smul, ← mul_pow, mul_inv_cancel₀ hlam0, one_pow, one_smul,
        inv_smul_smul₀ hlam0]
    rw [hdil k lam⁻¹ (inv_ne_zero hlam0) (dil k lam X) ω ζ hζ, hdil k lam hlam0 X ζ η hη, hηω]
  -- Step 4 (mass): `M(δ_{λ#}X) = λᵏ M(X)`.
  · exact Submission.cmcdt_dil_mass_eq P k lam hlam X (dil k lam X) (hdil k lam hlam0 X)
  -- Step 5 (integer multiplicity): `δ_{λ#}τ(M, θ, ξ) = τ(λM, θ(·/λ), ξ(·/λ))`.
  · exact Submission.cmcdt_dil_isIntegerMultiplicity P k lam hlam X (dil k lam X)
      (hdil k lam hlam0 X) hX
  -- Step 6 (boundary): `d(δ_λ^#ω) = δ_λ^#(dω)` (naturality of `d`, 6.2.24(1)).
  · ext ω
    obtain ⟨η, hη, -⟩ := Submission.cmcdt_dil_pullback_testForm P k lam hlam0 ω
    rw [GeometricCurrentOn.boundary_apply, hdil k lam hlam0 X.boundary ω η hη,
      GeometricCurrentOn.boundary_apply]
    refine hdil (k + 1) lam hlam0 X _ _ ?_
    change exteriorDerivative (η : DifferentialForm (Euclid P) k) =
      affinePullbackForm (lam • ContinuousLinearMap.id ℝ (Euclid P)) 0
        (exteriorDerivative (ω : DifferentialForm (Euclid P) k))
    rw [hη]
    exact exteriorDerivative_affinePullbackForm _ 0 ω.property.1.1
  -- Step 7 (vanishing): `tsupport δ_λ^#ω ⊆ δ_λ⁻¹(tsupport ω)`, which is disjoint from `E`.
  · obtain ⟨η, hη, -⟩ := Submission.cmcdt_dil_pullback_testForm P k lam hlam0 ω
    rw [hdil k lam hlam0 X ω η hη]
    refine hXE η (Set.disjoint_left.2 fun x hx hxE => ?_)
    rw [hη] at hx
    have hx' : lam • x ∈ tsupport (ω : DifferentialForm (Euclid P) k) := by
      simpa using tsupport_affinePullbackForm_subset _ 0 _ hx
    exact Set.disjoint_left.1 hω hx' ⟨x, hxE, rfl⟩
  -- Step 8 (action): `η = δ_λ^#ω` has `η(x) = λᵏ ω(λx)`.
  · obtain ⟨η, hη, hηx⟩ := Submission.cmcdt_dil_pullback_testForm P k lam hlam0 ω
    exact ⟨η, hηx, hdil k lam hlam0 X ω η hη⟩
  -- Step 9 (change of variables): `M = δ_λ(A)` with `δ_λ⁻¹(δ_λ(A)) = A`, then `λᵏλ⁻ᵏ = 1`.
  · have h := (Submission.euclid_hausdorff_dilation_change_of_variables P k lam hlam
      ((fun x : Euclid P => lam • x) '' A)).2.2 g
    rw [Set.preimage_image_eq A (smul_right_injective (Euclid P) hlam0)] at h
    rw [h, ← mul_assoc, ← mul_pow, mul_inv_cancel₀ hlam0, one_pow, one_mul]

/-- **Cauchy subsequence for the flat distance** (Simon Ch. 6, proof of 7.2, chapter-06.txt
lines 2100–2114: "apply (1) with `ε = 1, 1/2, 1/4` etc. to extract a subsequence `{T_{j_r}}` …
`d(T_{j_{r+1}}, T_{j_r}) < 2^{-r}`", so `T_{j_{r+1}} − T_{j_r} = ∂R_r + S_r`).  If for every
`ε > 0` some finite `𝒬` has, for each `j`, a `Q ∈ 𝒬` and integer multiplicity `R, S` with
`X_j − Q = ∂R + S` and `M(R) + M(S) < ε`, then some subsequence has
`X_{θ(r+1)} − X_{θ(r)} = ∂R_r + S_r` with `R_r, S_r` integer multiplicity and
`M(R_r) + M(S_r) ≤ 2^{-r}`.  For `ε_r = 2^{-r-1}`, every infinite `I ⊆ ℕ` has an infinite fibre
`J` of `j ↦ Q_r(j)` (pigeonhole); for `j, l ∈ J` the differences `R_r(j) − R_r(l)`,
`S_r(j) − S_r(l)` are integer multiplicity with `M(R_r(j) − R_r(l)) + M(S_r(j) − S_r(l)) < 2ε_r`,
so the diagonal extraction applies. -/
theorem Submission.dor_lmb_fc_cauchy_subseq : ∀ (P m : ℕ) (U : Set (Euclid P)) (X : ℕ → GeometricCurrentOn U (m + 1)), IsOpen U → (∀ ε : ℝ≥0∞, 0 < ε → ∃ 𝒬 : Set (GeometricCurrentOn U (m + 1)), 𝒬.Finite ∧ ∀ j, ∃ Q ∈ 𝒬, ∃ (R : GeometricCurrentOn U (m + 2)) (S : GeometricCurrentOn U (m + 1)), IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ (∀ ω : TestFormOn U (m + 1), X j ω - Q ω = R.boundary ω + S ω) ∧ R.mass + S.mass < ε) → ∃ θ : ℕ → ℕ, StrictMono θ ∧ ∀ r, ∃ (R : GeometricCurrentOn U (m + 2)) (S : GeometricCurrentOn U (m + 1)), IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ (∀ ω : TestFormOn U (m + 1), X (θ (r + 1)) ω - X (θ r) ω = R.boundary ω + S ω) ∧ R.mass + S.mass ≤ (2⁻¹ : ℝ≥0∞) ^ r := by
  intro P m U X hU hnet
  -- Step 1: for `ε_r = 2^{-r-1}`, the finite nets `𝒬_r` and decompositions
  -- `X_j − Q_r(j) = ∂R_r(j) + S_r(j)` with `M(R_r(j)) + M(S_r(j)) < ε_r`
  have hε : ∀ r : ℕ, (0 : ℝ≥0∞) < (2⁻¹ : ℝ≥0∞) ^ (r + 1) := fun r =>
    ENNReal.pow_pos (ENNReal.inv_pos.2 ENNReal.ofNat_ne_top) _
  choose Qs hQs Q hQ R S hR hS hXQ hRS using fun r => hnet _ (hε r)
  -- Step 2: diagonal extraction for `C r j l`: `X_j − X_l = ∂R + S`, `M(R) + M(S) ≤ 2^{-r}`
  refine Submission.cmc_fc_cs_diagonal_subseq (fun r j l =>
    ∃ (R : GeometricCurrentOn U (m + 2)) (S : GeometricCurrentOn U (m + 1)),
      IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧
      (∀ ω : TestFormOn U (m + 1), X j ω - X l ω = R.boundary ω + S ω) ∧
      R.mass + S.mass ≤ (2⁻¹ : ℝ≥0∞) ^ r) fun r I hI => ?_
  -- Step 3: pigeonhole: `j ↦ Q_r(j)` takes values in the finite `𝒬_r`, so some fibre
  -- `I ∩ Q_r⁻¹(q)` is infinite
  obtain ⟨q, -, hq⟩ : ∃ q ∈ Qs r, (I ∩ {j | Q r j = q}).Infinite := by
    by_contra h
    have hfin : (⋃ q ∈ Qs r, I ∩ {j | Q r j = q}).Finite :=
      (hQs r).biUnion fun q hq => by
        by_contra hinf
        exact h ⟨q, hq, hinf⟩
    exact hI (hfin.subset fun j hj => mem_biUnion (hQ r j) ⟨hj, rfl⟩)
  refine ⟨I ∩ {j | Q r j = q}, inter_subset_left, hq, fun j hj l hl => ?_⟩
  -- Step 4: subtract the two decompositions with the same `q`; the differences are integer
  -- multiplicity and `M(R_r(j) − R_r(l)) + M(S_r(j) − S_r(l)) < 2ε_r = 2^{-r}`
  have hsub := Submission.cmc_imRep_locality_restrict_sub.2.2.1
  refine ⟨R r j - R r l, S r j - S r l, hsub P _ U _ _ hU (hR r j) (hR r l),
    hsub P _ U _ _ hU (hS r j) (hS r l), fun ω => ?_, ?_⟩
  · have hj' : Q r j = q := hj.2
    have hl' : Q r l = q := hl.2
    have h1 := hXQ r j ω
    have h2 := hXQ r l ω
    rw [hj'] at h1
    rw [hl'] at h2
    change X j ω - X l ω = ((R r j).boundary ω - (R r l).boundary ω) + (S r j ω - S r l ω)
    linarith
  · calc (R r j - R r l).mass + (S r j - S r l).mass
        ≤ ((R r j).mass + (R r l).mass) + ((S r j).mass + (S r l).mass) :=
          add_le_add (Submission.cmc_fc_cs_massOn_sub_le P (m + 2) U U (R r j) (R r l))
            (Submission.cmc_fc_cs_massOn_sub_le P (m + 1) U U (S r j) (S r l))
      _ = ((R r j).mass + (S r j).mass) + ((R r l).mass + (S r l).mass) :=
          add_add_add_comm _ _ _ _
      _ ≤ (2⁻¹ : ℝ≥0∞) ^ (r + 1) + (2⁻¹ : ℝ≥0∞) ^ (r + 1) :=
          add_le_add (hRS r j).le (hRS r l).le
      _ = (2⁻¹ : ℝ≥0∞) ^ r := by
          rw [pow_succ, ← div_eq_mul_inv, ENNReal.add_halves]
/-- **Simon Ch. 6, proof of 7.2 (p. 172), the series step** `T − T_{j_ℓ} = ∂R^{(ℓ)} + S^{(ℓ)}`.
If `X_r ⇀ X_∞` in `U` and `X_{r+1} − X_r = ∂R_r + S_r` with `R_r`, `S_r` integer multiplicity
and `M(R_r) + M(S_r) ≤ 2^{−r}`, then for each `ℓ` the `M`-absolutely convergent tails
`R' = Σ_{r ≥ ℓ} R_r`, `S' = Σ_{r ≥ ℓ} S_r` are integer multiplicity (3.13, via
`dor_lmb_fc_im_series`) with `M(R') + M(S') ≤ 2·2^{−ℓ}`; telescoping
`X_{ℓ+N} − X_ℓ = Σ_{r<N} (∂R_{ℓ+r} + S_{ℓ+r})` and letting `N → ∞` gives `X_∞ − X_ℓ = ∂R' + S'`. -/
theorem Submission.dor_lmb_fc_series_limit : ∀ (P m : ℕ) (U : Set (Euclid P)) (X : ℕ → GeometricCurrentOn U (m + 1)) (Xlim : GeometricCurrentOn U (m + 1)) (R : ℕ → GeometricCurrentOn U (m + 2)) (S : ℕ → GeometricCurrentOn U (m + 1)), IsOpen U → WeaklyConvergesOn X Xlim → (∀ r, IsIntegerMultiplicity (R r) ∧ IsIntegerMultiplicity (S r) ∧ (∀ ω : TestFormOn U (m + 1), X (r + 1) ω - X r ω = (R r).boundary ω + S r ω) ∧ (R r).mass + (S r).mass ≤ (2⁻¹ : ℝ≥0∞) ^ r) → ∀ ℓ : ℕ, ∃ (R' : GeometricCurrentOn U (m + 2)) (S' : GeometricCurrentOn U (m + 1)), IsIntegerMultiplicity R' ∧ IsIntegerMultiplicity S' ∧ (∀ ω : TestFormOn U (m + 1), Xlim ω - X ℓ ω = R'.boundary ω + S' ω) ∧ R'.mass + S'.mass ≤ 2 * (2⁻¹ : ℝ≥0∞) ^ ℓ := by
  intro P m U X Xlim R S hU hX hRS ℓ
  -- the tails have total mass at most `Σ_r 2^{−ℓ−r} = 2·2^{−ℓ} < ∞`
  have hgeom : ∑' r, (2⁻¹ : ℝ≥0∞) ^ (ℓ + r) = 2 * (2⁻¹ : ℝ≥0∞) ^ ℓ := by
    simp_rw [pow_add]
    rw [ENNReal.tsum_mul_left, ENNReal.tsum_geometric_two, mul_comm]
  have hfin : ∑' r, (2⁻¹ : ℝ≥0∞) ^ (ℓ + r) ≠ ∞ := by
    rw [hgeom]
    exact ENNReal.mul_ne_top ENNReal.ofNat_ne_top
      (ENNReal.pow_ne_top (ENNReal.inv_ne_top.2 two_ne_zero))
  have hRfin : ∑' r, (R (ℓ + r)).mass ≠ ∞ := ne_top_of_le_ne_top hfin <|
    ENNReal.tsum_le_tsum fun r => le_self_add.trans (hRS (ℓ + r)).2.2.2
  have hSfin : ∑' r, (S (ℓ + r)).mass ≠ ∞ := ne_top_of_le_ne_top hfin <|
    ENNReal.tsum_le_tsum fun r => le_add_self.trans (hRS (ℓ + r)).2.2.2
  -- 3.13: the tails sum to integer multiplicity `R' = Σ_r R_{ℓ+r}` and `S' = Σ_r S_{ℓ+r}`
  obtain ⟨R', hR', hRsum, hRmass⟩ := Submission.dor_lmb_fc_im_series P (m + 1) U
    (fun r => R (ℓ + r)) hU (fun r => (hRS (ℓ + r)).1) hRfin
  obtain ⟨S', hS', hSsum, hSmass⟩ := Submission.dor_lmb_fc_im_series P m U
    (fun r => S (ℓ + r)) hU (fun r => (hRS (ℓ + r)).2.1) hSfin
  refine ⟨R', S', hR', hS', fun ω => ?_, ?_⟩
  · -- telescoping: `X_{ℓ+N}(ω) − X_ℓ(ω) = Σ_{r<N} (∂R_{ℓ+r}(ω) + S_{ℓ+r}(ω))`
    have htel : ∀ N : ℕ, X (ℓ + N) ω - X ℓ ω =
        ∑ r ∈ Finset.range N, ((R (ℓ + r)).boundary ω + S (ℓ + r) ω) := by
      intro N
      induction N with
      | zero => simp
      | succ N ih =>
        rw [Finset.sum_range_succ, ← ih, ← (hRS (ℓ + N)).2.2.1 ω, ← add_assoc ℓ N 1]
        ring
    -- let `N → ∞`: the left side tends to `X_∞(ω) − X_ℓ(ω)`, the right side to `∂R'(ω) + S'(ω)`
    have hlim : Tendsto (fun N => X (ℓ + N) ω - X ℓ ω) atTop (𝓝 (Xlim ω - X ℓ ω)) :=
      ((hX ω).comp (tendsto_atTop_mono (fun N => Nat.le_add_left N ℓ) tendsto_id)).sub_const _
    have hsum : HasSum (fun r => (R (ℓ + r)).boundary ω + S (ℓ + r) ω)
        (R'.boundary ω + S' ω) :=
      (hRsum (exteriorDerivativeTestOn U (m + 1) ω)).add (hSsum ω)
    exact tendsto_nhds_unique (hlim.congr htel) hsum.tendsto_sum_nat
  · calc R'.mass + S'.mass
        ≤ ∑' r, (R (ℓ + r)).mass + ∑' r, (S (ℓ + r)).mass := add_le_add hRmass hSmass
      _ = ∑' r, ((R (ℓ + r)).mass + (S (ℓ + r)).mass) := ENNReal.tsum_add.symm
      _ ≤ ∑' r, (2⁻¹ : ℝ≥0∞) ^ (ℓ + r) := ENNReal.tsum_le_tsum fun r => (hRS (ℓ + r)).2.2.2
      _ = 2 * (2⁻¹ : ℝ≥0∞) ^ ℓ := hgeom
/-- Locality of approximate tangent spaces (Simon 3.1.5(2), from the proof of 3.1.6 "⇒"): if
`A ⊆ B` are Borel, `Hⁿ(B ∩ B̄_{r₀}(x)) < ∞` and `Hⁿ((B \ A) ∩ B̄_ρ(x))/ρⁿ → 0` as `ρ ↓ 0`, then
`B` and `A` have the same approximate tangent spaces at `x`.  For `f ∈ C_c(ℝᴾ)` with `|f| ≤ C`
and `f = 0` off `B̄_R(0)`, and `0 < r < r₀/R`, the integrals of `f` over `η_{x,r}(B)` and
`η_{x,r}(A)` differ by at most `C Hⁿ(η_{x,r}(B \ A) ∩ B̄_R(0)) = C r⁻ⁿ Hⁿ((B \ A) ∩ B̄_{rR}(x))`,
which tends to `0` as `r ↓ 0`. -/
theorem Submission.regcomp_atl_tangent_iff_of_density_zero : ∀ (P n : ℕ) (A B : Set (Euclid P)) (x : Euclid P) (r₀ : ℝ), MeasurableSet A → MeasurableSet B → A ⊆ B → 0 < r₀ → μHE[n] (B ∩ closedBall x r₀) ≠ ∞ → Tendsto (fun ρ : ℝ => μHE[n] ((B \ A) ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n) (𝓝[>] 0) (𝓝 0) → ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q := by
  intro P n A B x r₀ hA hB hAB hr₀ hfin hdens
  refine Submission.regcomp_atl_pc_tangent_iff_of_integral_sub_tendsto P n B A x fun f => ?_
  -- `‖f‖ ≤ C` everywhere, and `f = 0` off `B̄_R(0)` with `R > 0`
  obtain ⟨C, hC⟩ := (map_continuous f).bounded_above_of_compact_support f.hasCompactSupport
  obtain ⟨R₁, hR₁⟩ := f.hasCompactSupport.isCompact.isBounded.subset_closedBall (0 : Euclid P)
  set R := max R₁ 1
  have hR : 0 < R := lt_of_lt_of_le one_pos (le_max_right R₁ 1)
  have hf0 : ∀ y : Euclid P, y ∉ closedBall (0 : Euclid P) R → f y = 0 := by
    intro y hy
    by_contra hne
    exact hy (closedBall_subset_closedBall (le_max_left R₁ 1) (hR₁ (subset_tsupport f hne)))
  -- the bound `C r⁻ⁿ Hⁿ((B \ A) ∩ B̄_{rR}(x))` tends to `0` as `r ↓ 0`
  have hlim : Tendsto (fun r : ℝ => C * ((ENNReal.ofReal r)⁻¹ ^ n *
      μHE[n] ((B \ A) ∩ closedBall x (r * R))).toReal) (𝓝[>] 0) (𝓝 0) := by
    have h := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp
      (Submission.regcomp_atl_pc_density_rescale_tendsto n
        (fun ρ : ℝ => μHE[n] ((B \ A) ∩ closedBall x ρ)) R hR hdens)
    rw [ENNReal.toReal_zero] at h
    have h' := h.const_mul C
    rw [mul_zero] at h'
    exact h'
  refine squeeze_zero_norm' ?_ hlim
  -- for `0 < r < r₀ / R` the fixed-scale comparison applies, and the scaling identity rewrites
  -- its bound
  filter_upwards [Ioo_mem_nhdsGT (div_pos hr₀ hR)] with r hr
  have hrR : r * R ≤ r₀ := ((lt_div_iff₀ hR).1 hr.2).le
  have hBfin : μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' B ∩ closedBall 0 R) ≠ ∞ := by
    rw [Submission.regcomp_atl_blowUp_measure_scaling P n x r R B hr.1]
    exact ENNReal.mul_ne_top
      (ENNReal.pow_ne_top (ENNReal.inv_ne_top.2 (ENNReal.ofReal_pos.2 hr.1).ne'))
      (ne_top_of_le_ne_top hfin
        (measure_mono (inter_subset_inter_right B (closedBall_subset_closedBall hrR))))
  have key := Submission.regcomp_atl_pc_blowUp_setIntegral_sub_le P n A B x r R C f
    (map_continuous f) hA hB hAB hr.1 hBfin hC hf0
  rwa [Submission.regcomp_atl_blowUp_measure_scaling P n x r R (B \ A) hr.1] at key

/-- **Locality of approximate tangent spaces** (Simon Ch. 3, Remark 1.5(2); proof of 3.1.6 "⇒",
chapter-03.txt lines 113–143).  If `U ⊆ ℝᴾ` is open and `A ⊆ B ⊆ U` are Borel with
`Hⁿ(B ∩ K) < ∞` for every compact `K ⊆ U`, then for `Hⁿ`-a.e. `x ∈ A`, `B` and `A` have the same
approximate tangent spaces at `x`.  `D = B \ A` is Borel with `Hⁿ(D ∩ K) < ∞` for compact `K ⊆ U`,
so by the upper density theorem `Hⁿ(D ∩ B̄_ρ(x))/ρⁿ → 0` as `ρ ↓ 0` for `Hⁿ`-a.e. `x ∈ U ∖ D`,
hence for `Hⁿ⌞A`-a.e. `x`.  At such `x ∈ A ⊆ U`, a closed ball `B̄_{r₀}(x) ⊆ U` is compact, so
`Hⁿ(B ∩ B̄_{r₀}(x)) < ∞`, and the blow-ups of `B` and `A` at `x` have asymptotically equal
integrals. -/
theorem Submission.dor_lmb_approx_tangent_locality : ∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q := by
  intro P n U A B hU hA hB hAB hBU hfin
  -- Steps 1–3: `D = B \ A` has finite measure on compact subsets of `U`, so its `n`-density
  -- vanishes at `Hⁿ`-a.e. point of `U ∖ D`
  have hdens := Submission.regcomp_atl_local_density_zero P n U (B \ A) hU (hB.diff hA)
    fun K hK hKU => ne_top_of_le_ne_top (hfin K hK hKU)
      (measure_mono (inter_subset_inter_left K sdiff_subset))
  -- Step 7: `Hⁿ⌞A`-a.e. `x` lies in `A`, hence in `U` and outside `D`
  filter_upwards [ae_restrict_of_ae hdens, ae_restrict_mem hA] with x hx hxA
  have hxU : x ∈ U := hBU (hAB hxA)
  -- Step 4: a closed ball `B̄_{r₀}(x) ⊆ U` is compact, so `Hⁿ(B ∩ B̄_{r₀}(x)) < ∞`
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hU x hxU
  have hsub : closedBall x (ε / 2) ⊆ U := (closedBall_subset_ball (half_lt_self hε)).trans hball
  -- Steps 5–6: comparison of the blow-up integrals of `B` and `A` at `x`
  exact Submission.regcomp_atl_tangent_iff_of_density_zero P n A B x (ε / 2) hA hB hAB
    (half_pos hε) (hfin _ (isCompact_closedBall x (ε / 2)) hsub) (hx hxU fun h => h.2 hxA)

/-- **Simon Ch. 6, Remark 3.2(1)**, with a mass bound (chapter-06.txt lines 755–757): if
`T₁ = τ(M₁, θ₁, ξ₁)` and `T₂ = τ(M₂, θ₂, ξ₂)` in the open set `U` and `S = p₁T₁ + p₂T₂` with
`p₁, p₂ ∈ ℤ`, then `S = τ(M, θ, ξ)` for an integer multiplicity triple `R = (M, θ, ξ)` in `U` with
`μ_R ≤ |p₁| μ_{R₁} + |p₂| μ_{R₂}`.  Tangent locality and the sign of the orientations on
`M₁ ∩ M₂` give `R` with `1_M θ ξ = p₁ 1_{M₁} θ₁ ξ₁ + p₂ 1_{M₂} θ₂ ξ₂` `Hⁿ`-a.e.  Integrating this
identity against `ω ∈ 𝒟ⁿ(U)` gives `τ(R)(ω) = p₁T₁(ω) + p₂T₂(ω) = S(ω)`.  Evaluating it at a
covector norming `ξ` gives `θ 1_M ≤ |p₁| θ₁ 1_{M₁} + |p₂| θ₂ 1_{M₂}` a.e., hence the mass bound. -/
theorem Submission.dor_lmb_int_combination_imrep : ∀ (P n : ℕ) (U : Set (Euclid P)) (T₁ T₂ S : GeometricCurrentOn U n) (R₁ R₂ : IMRep U n) (p₁ p₂ : ℤ), IsOpen U → R₁.Represents T₁ → R₂.Represents T₂ → (∀ ω : TestFormOn U n, S ω = (p₁ : ℝ) * T₁ ω + (p₂ : ℝ) * T₂ ω) → ∃ R : IMRep U n, R.Represents S ∧ R.measure ≤ (p₁.natAbs : ℝ≥0∞) • R₁.measure + (p₂.natAbs : ℝ≥0∞) • R₂.measure := by
  intro P n U T₁ T₂ S R₁ R₂ p₁ p₂ hU h₁ h₂ hS
  -- Steps 2–6: an IMRep `R = (M, θ, ξ)` in `U` with
  -- `1_M θ ξ = p₁ 1_{M₁} θ₁ ξ₁ + p₂ 1_{M₂} θ₂ ξ₂` `Hⁿ`-a.e. (the identity (†) of step 5)
  obtain ⟨R, hR⟩ := Submission.rsdic_exists_imrep_int_combination P n U R₁ R₂ p₁ p₂ hU
  -- Steps 5 and 8: (†) bounds `θ 1_M` a.e., so `μ_R ≤ |p₁| μ_{R₁} + |p₂| μ_{R₂}`
  refine ⟨R, fun ω => ?_,
    Submission.dor_lmb_ic_measure_le_of_weighted_orient_eq P n U R₁ R₂ R p₁ p₂ hR⟩
  -- Step 7: integrating (†) against `ω` gives `τ(R)(ω) = p₁T₁(ω) + p₂T₂(ω) = S(ω)`
  rw [hS ω, h₁ ω, h₂ ω, Submission.rsdic_imrep_action_int_combination P n U R₁ R₂ R p₁ p₂ hR ω]

/-- **Restriction of an integer multiplicity current to a Borel set** (Simon Ch. 6, 4.5(2); e.g.
`Rⱼ⌞W_α` and `T⌞W_α` in the proof of 7.2.4): for a triple `R = (M, θ, ξ)` in `U` and Borel `A`,
`R' = (M ∩ A, θ, ξ)` is again a triple in `U`, it represents a current `S = τ(M, θ, ξ)⌞A` in
`𝒟ₙ(U)`, and `μ_{R'} = μ_R⌞A`.

As `θ ≥ 1` on `M`, `Hⁿ(M ∩ K) < ∞` for compact `K ⊆ U`.  So tangent locality for `M ∩ A ⊆ M`
gives `T_x(M ∩ A) = T_xM` for `Hⁿ`-a.e. `x ∈ M ∩ A`, and `ξ` still orients `M ∩ A`.  The triple
`R'` defines a current by Simon 6.3.1, and `(Hⁿ⌞(M ∩ A))θ = ((Hⁿ⌞M)θ)⌞A` because restriction to
the Borel set `A` commutes with taking densities. -/
theorem Submission.dor_lmb_imrep_restrict_current : ∀ (P n : ℕ) (U A : Set (Euclid P)) (R : IMRep U n), IsOpen U → MeasurableSet A → ∃ (S : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents S ∧ R'.carrier = R.carrier ∩ A ∧ R'.mult = R.mult ∧ R'.orient = R.orient ∧ R'.measure = R.measure.restrict A := by
  intro P n U A R hU hA
  -- Step 2(a): `Hⁿ(M ∩ K) < ∞` for compact `K ⊆ U`
  have hfin : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (R.carrier ∩ K) ≠ ∞ :=
    fun K hK hKU => (Submission.rsd_imrep_compact_measure_ne_top P n U R K hK hKU).1
  -- Step 2(b): `M ∩ A` and `M` have the same approximate tangent spaces `Hⁿ`-a.e. on `M ∩ A`
  have hloc := Submission.dor_lmb_approx_tangent_locality P n U (R.carrier ∩ A) R.carrier hU
    (R.measurableSet_carrier.inter hA) R.measurableSet_carrier inter_subset_left
    R.carrier_subset hfin
  -- Steps 1 and 2(c): `R' = (M ∩ A, θ, ξ)` is a triple in `U`
  obtain ⟨R', hc, hm, ho⟩ := Submission.regcomp_rim_sub_imrep P n U (R.carrier ∩ A) R R.mult
    (R.measurableSet_carrier.inter hA) inter_subset_left R.measurable_mult
    (fun x hx => R.mult_pos x hx.1) (fun x _ => le_rfl) (hloc.mono fun x hx Q hQ => (hx Q).1 hQ)
  -- Step 3: `R'` represents a current `S`
  obtain ⟨S, hS⟩ := Submission.dtc_imrep_current P n U R'
  refine ⟨S, R', hS, hc, hm, ho, ?_⟩
  -- Step 4: `(Hⁿ⌞(M ∩ A))θ = ((Hⁿ⌞M)θ)⌞A`
  simp only [IMRep.measure, hc, hm]
  rw [restrict_withDensity hA, Measure.restrict_restrict hA, inter_comm]

/-- **Slicing by a Lipschitz function** (Simon Ch. 6, 4.1–4.5, chapter-06.txt lines 1156–1310),
assuming (C1): `M_W(T) = μ_R(W)` for open `W` and `spt T = U ∩ spt μ_R` whenever `R` represents
`T`.  If `T = τ(M, θ, ξ) ∈ 𝒟_{n+1}(U)`, `∂T = τ(M', θ', ξ')` and `f` is `L`-Lipschitz, there are
`P_t ∈ 𝒟ₙ(U)` with `∫ M_W(P_t) dt ≤ L M_W(T)` for every open `W` such that, for `L¹`-a.e. `t`,
`P_t` is integer multiplicity, `P_t(ω) = 0` if `spt ω ∩ f⁻¹(t) = ∅`, and
`P_t(ω) = ∫_{M ∩ {f < t}} θ⟨dω, ξ⟩ dH^{n+1} − ∫_{M' ∩ {f < t}} θ'⟨ω, ξ'⟩ dHⁿ` (Simon 4.5(2)).

The slices `R_t = (M_t, θ_t, ξ_t)`, `M_t ⊆ f⁻¹(t)`, satisfy `∫ μ_{R_t}(W) dt ≤ L μ_T(W)` (co-area)
and the averaged identity for the cut-offs `γ_{a,b}(f)`.  `P_t` is the current represented by
`R_t ⌞ ℝᴾ`, which has the data of `R_t`, so `M_W(P_t) = μ_{R_t}(W)` by (C1).  `P_t(ω) = 0` when
`ω` vanishes on `M_t ⊆ f⁻¹(t)`.  Lebesgue differentiation of the averaged identity, with a null
set independent of `ω`, gives the slice identity for a.e. `t`. -/
theorem Submission.dor_lmb_slicing_lipschitz : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (n + 1)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → RT.Represents T → RB.Represents T.boundary → LipschitzWith L f → ∃ Ps : ℝ → GeometricCurrentOn U n, (∀ W : Set (Euclid P), IsOpen W → AEMeasurable (fun t => (Ps t).massOn W) ∧ ∫⁻ t, (Ps t).massOn W ≤ (L : ℝ≥0∞) * T.massOn W) ∧ ∀ᵐ t, IsIntegerMultiplicity (Ps t) ∧ (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (f ⁻¹' {t}) → Ps t ω = 0) ∧ ∀ ω : TestFormOn U n, Ps t ω = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n] := by
  intro hC1 P n U T RT RB f L hU hRT hRB hf
  -- Steps 1, 2(a)–(c), 4(b)–(c), 5(a)–(f): slices `R_t = (M_t, θ_t, ξ_t)` with `M_t ⊆ f⁻¹(t)`,
  -- the co-area mass bound and the averaged slice identity
  obtain ⟨Rs, hcarrier, hmass, hint, havg⟩ := Submission.dor_lmbs_imrep_slice_family
    Submission.dor_lmb_approx_tangent_locality P n U T RT RB f L hU hRT hRB hf
  -- Step 2(d): `P_t` is the current represented by `R_t ⌞ ℝᴾ` (borel_restriction, `A = ℝᴾ`)
  choose Ps Rs' hrep hcarrier' hmult' horient' hmeasure' using fun t =>
    Submission.dor_lmb_imrep_restrict_current P n U univ (Rs t) hU MeasurableSet.univ
  -- `R_t ⌞ ℝᴾ` has the carrier, multiplicity and orientation of `R_t`, so `P_t(ω) = τ(R_t)(ω)`
  have hPs : ∀ t (ω : TestFormOn U n),
      Ps t ω = (Rs t).action (ω : DifferentialForm (Euclid P) n) := by
    intro t ω
    rw [hrep t ω]
    simp only [IMRep.action, hcarrier' t, hmult' t, horient' t, inter_univ]
  refine ⟨Ps, fun W hW => ?_, ?_⟩
  · -- Step 4: `M_W(P_t) = μ_{R_t ⌞ ℝᴾ}(W) = μ_{R_t}(W)` and `M_W(T) = μ_T(W)` by (C1)
    have hPW : (fun t => (Ps t).massOn W) = fun t => (Rs t).measure W := by
      funext t
      rw [(hC1 P n U (Ps t) (Rs' t) hU (hrep t)).1 W hW, hmeasure' t, Measure.restrict_univ]
    rw [hPW, (hC1 P (n + 1) U T RT hU hRT).1 W hW]
    exact hmass W hW.measurableSet
  · -- Steps 5(g) and 6: the slice identity for a.e. `t`, for all `ω` at once
    filter_upwards [Submission.dor_lmbs_slice_identity_of_averages P n U RT RB Rs f hU
      hf.continuous.measurable (fun ω => (hint ω).locallyIntegrable) havg] with t ht
    -- Step 2(c): `R_t ⌞ ℝᴾ` is an integer multiplicity triple representing `P_t`
    refine ⟨⟨Rs' t, hrep t⟩, fun ω hω => ?_, fun ω => (hPs t ω).trans (ht ω)⟩
    -- Step 3: if `spt ω ∩ f⁻¹(t) = ∅`, then `ω = 0` on `M_t ⊆ f⁻¹(t)`
    rw [hPs t ω, IMRep.action]
    refine setIntegral_eq_zero_of_forall_eq_zero fun x hx => ?_
    rw [image_eq_zero_of_notMem_tsupport fun hxω => disjoint_left.1 hω hxω (hcarrier t hx),
      map_zero, mul_zero]
/-- Chart localization (steps 1 and 4(a) of the nearest point retraction used in the proof of
Simon 7.4.3): if `ψ` is continuous and injective on `V`, `ψ(V) = W ∩ N` with `W` open, and `ψ` is
proper into `W` (`V ∩ ψ⁻¹(K)` is compact for compact `K ⊆ W`), then for `v₀ ∈ V` and `ε > 0` some
closed ball `B̄_ρ(ψ(v₀)) ⊆ W` has `N ∩ B̄_ρ(ψ(v₀)) ⊆ ψ(V ∩ B_ε(v₀))` and `N ∩ B̄_ρ(ψ(v₀))` compact.
With `B̄_{ρ₀}(ψ(v₀)) ⊆ W`, the set `C := (V ∩ ψ⁻¹(B̄_{ρ₀}(ψ(v₀)))) \ B_ε(v₀)` is compact, so
`ψ(C)` is compact; it misses `ψ(v₀)` by injectivity, so any `ρ ≤ ρ₀` with
`B̄_ρ(ψ(v₀)) ∩ ψ(C) = ∅` works, and `N ∩ B̄_ρ(ψ(v₀)) = ψ(V ∩ ψ⁻¹(B̄_ρ(ψ(v₀))))` is compact by
properness. -/
theorem Submission.dor_lmb_ret_chart_localization : ∀ (P d : ℕ) (N W : Set (Euclid P)) (V : Set (Euclid d)) (ψ : Euclid d → Euclid P) (v₀ : Euclid d), IsOpen W → ContinuousOn ψ V → InjOn ψ V → ψ '' V = W ∩ N → (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → v₀ ∈ V → ∀ ε : ℝ, 0 < ε → ∃ ρ : ℝ, 0 < ρ ∧ closedBall (ψ v₀) ρ ⊆ W ∧ N ∩ closedBall (ψ v₀) ρ ⊆ ψ '' (V ∩ ball v₀ ε) ∧ IsCompact (N ∩ closedBall (ψ v₀) ρ) := by
  intro P d N W V ψ v₀ hW hψ hinj himage hproper hv₀ ε hε
  -- Step 1: `y := ψ(v₀) ∈ W`, and `B̄_{ρ₀}(y) ⊆ W` for some `ρ₀ > 0`
  have hy : ψ v₀ ∈ W ∩ N := by
    rw [← himage]
    exact mem_image_of_mem ψ hv₀
  obtain ⟨r, hr, hrW⟩ := Metric.isOpen_iff.1 hW _ hy.1
  have hρ₀W : closedBall (ψ v₀) (r / 2) ⊆ W :=
    (closedBall_subset_ball (half_lt_self hr)).trans hrW
  -- Step 2: `C := (V ∩ ψ⁻¹(B̄_{ρ₀}(y))) \ B_ε(v₀)` is compact
  have hC : IsCompact ((V ∩ ψ ⁻¹' closedBall (ψ v₀) (r / 2)) \ ball v₀ ε) :=
    (hproper _ hρ₀W (isCompact_closedBall _ _)).diff isOpen_ball
  -- Step 3: `ψ(C)` is compact
  have hψC : IsCompact (ψ '' ((V ∩ ψ ⁻¹' closedBall (ψ v₀) (r / 2)) \ ball v₀ ε)) :=
    hC.image_of_continuousOn (hψ.mono fun _ hx => hx.1.1)
  -- Step 4: `y ∉ ψ(C)`, by injectivity of `ψ` on `V`
  have hyC : ψ v₀ ∉ ψ '' ((V ∩ ψ ⁻¹' closedBall (ψ v₀) (r / 2)) \ ball v₀ ε) := by
    rintro ⟨c, ⟨⟨hcV, -⟩, hcε⟩, hc⟩
    rw [hinj hcV hv₀ hc] at hcε
    exact hcε (mem_ball_self hε)
  -- Step 5: some `B_{ρ₂}(y)` misses `ψ(C)`; take `ρ ≤ ρ₀` with `ρ < ρ₂`
  obtain ⟨ρ₂, hρ₂, hρ₂C⟩ := Metric.isOpen_iff.1 hψC.isClosed.isOpen_compl _ hyC
  obtain ⟨ρ, hρ, hρρ₀, hρρ₂⟩ : ∃ ρ : ℝ, 0 < ρ ∧ ρ ≤ r / 2 ∧ ρ < ρ₂ :=
    ⟨min (r / 2) (ρ₂ / 2), lt_min (half_pos hr) (half_pos hρ₂), min_le_left _ _,
      (min_le_right _ _).trans_lt (half_lt_self hρ₂)⟩
  have hρW : closedBall (ψ v₀) ρ ⊆ W := (closedBall_subset_closedBall hρρ₀).trans hρ₀W
  -- every `z ∈ N ∩ B̄_ρ(y)` is `ψ(v)` with `v ∈ V`, `ψ(v) ∈ B̄_ρ(y)`
  have hpre : ∀ z ∈ N ∩ closedBall (ψ v₀) ρ, ∃ v ∈ V, ψ v ∈ closedBall (ψ v₀) ρ ∧ ψ v = z := by
    rintro z ⟨hzN, hzB⟩
    have hz : z ∈ ψ '' V := by
      rw [himage]
      exact ⟨hρW hzB, hzN⟩
    obtain ⟨v, hvV, rfl⟩ := hz
    exact ⟨v, hvV, hzB, rfl⟩
  refine ⟨ρ, hρ, hρW, ?_, ?_⟩
  · -- Step 6: inclusion
    intro z hz
    obtain ⟨v, hvV, hvB, rfl⟩ := hpre z hz
    refine ⟨v, ⟨hvV, ?_⟩, rfl⟩
    by_contra hvε
    exact hρ₂C (closedBall_subset_ball hρρ₂ hvB)
      ⟨v, ⟨⟨hvV, closedBall_subset_closedBall hρρ₀ hvB⟩, hvε⟩, rfl⟩
  · -- Step 7: `N ∩ B̄_ρ(y) = ψ(V ∩ ψ⁻¹(B̄_ρ(y)))` is compact
    have heq : N ∩ closedBall (ψ v₀) ρ = ψ '' (V ∩ ψ ⁻¹' closedBall (ψ v₀) ρ) := by
      apply Subset.antisymm
      · intro z hz
        obtain ⟨v, hvV, hvB, rfl⟩ := hpre z hz
        exact ⟨v, ⟨hvV, hvB⟩, rfl⟩
      · rintro _ ⟨v, ⟨hvV, hvB⟩, rfl⟩
        have hv : ψ v ∈ W ∩ N := by
          rw [← himage]
          exact mem_image_of_mem ψ hvV
        exact ⟨hv.2, hvB⟩
    rw [heq]
    exact (hproper _ hρW (isCompact_closedBall _ _)).image_of_continuousOn
      (hψ.mono inter_subset_left)
/-- **`C¹` local inverse at a point with invertible derivative** (steps 6–7 of
`dor_lmb_ret_normal_coordinates`).  If `Φ` is `C¹` on an open `U ∋ z₀` and `DΦ(z₀) = Λ` is a
continuous linear equivalence (`X` complete), then on some ball `B_ρ(z₀) ⊆ U` the map `Φ` has a
left inverse `G`, and for every open `W ⊆ B_ρ(z₀)` the image `Φ(W)` is open and `G` is `C¹` on it.
`G` is the inverse of the inverse function theorem's open partial homeomorphism `H` (`H = Φ`), and
`ρ` is small enough that `B_ρ(z₀)` lies in the source of `H` and `DΦ` is invertible on it. -/
theorem Submission.dor_lmb_ret_nc_local_inverse : ∀ (X Y : Type) [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] [NormedAddCommGroup Y] [NormedSpace ℝ Y] (Φ : X → Y) (U : Set X) (z₀ : X) (Λ : X ≃L[ℝ] Y), IsOpen U → z₀ ∈ U → ContDiffOn ℝ 1 Φ U → HasFDerivAt Φ (Λ : X →L[ℝ] Y) z₀ → ∃ ρ : ℝ, 0 < ρ ∧ ball z₀ ρ ⊆ U ∧ ∃ G : Y → X, (∀ z ∈ ball z₀ ρ, G (Φ z) = z) ∧ ∀ W : Set X, W ⊆ ball z₀ ρ → IsOpen W → IsOpen (Φ '' W) ∧ ContDiffOn ℝ 1 G (Φ '' W) := by
  intro X Y _ _ _ _ _ Φ U z₀ Λ hU hz₀ hΦ hΦ'
  have hUz₀ : U ∈ 𝓝 z₀ := hU.mem_nhds hz₀
  -- Step 1: the inverse function theorem at `z₀` gives an open partial homeomorphism `H` with
  -- underlying function `Φ` and `z₀ ∈ H.source`.
  have hstrict : HasStrictFDerivAt Φ (Λ : X →L[ℝ] Y) z₀ :=
    (hΦ.contDiffAt hUz₀).hasStrictFDerivAt' hΦ' one_ne_zero
  obtain ⟨H, hHΦ, hz₀S⟩ : ∃ H : OpenPartialHomeomorph X Y, (H : X → Y) = Φ ∧ z₀ ∈ H.source :=
    ⟨hstrict.toOpenPartialHomeomorph Φ, hstrict.toOpenPartialHomeomorph_coe,
      hstrict.mem_toOpenPartialHomeomorph_source⟩
  -- Step 2: `DΦ` is continuous at `z₀` with `DΦ(z₀) = Λ`, and the invertible maps form an open
  -- set, so `DΦ` is invertible near `z₀`.
  have hB : fderiv ℝ Φ ⁻¹' range ((↑) : (X ≃L[ℝ] Y) → X →L[ℝ] Y) ∈ 𝓝 z₀ := by
    refine ((hΦ.continuousOn_fderiv_of_isOpen hU le_rfl).continuousAt hUz₀).preimage_mem_nhds ?_
    rw [hΦ'.fderiv]
    exact Λ.nhds
  -- Step 3: choose `ρ` with `B_ρ(z₀) ⊆ H.source ∩ U ∩ {DΦ invertible}` and put `G = H⁻¹`.
  obtain ⟨ρ, hρ, hball⟩ :=
    Metric.mem_nhds_iff.1 (inter_mem (inter_mem (H.open_source.mem_nhds hz₀S) hUz₀) hB)
  refine ⟨ρ, hρ, fun z hz => (hball hz).1.2, H.symm, fun z hz => ?_, fun W hW hWo => ?_⟩
  · -- Step 4: `G (Φ z) = z` on the ball, which lies in the source of `H`.
    rw [← hHΦ]
    exact H.left_inv (hball hz).1.1
  · -- Step 5: `W` lies in the source of `H`, so `Φ '' W = H '' W` is open.
    have hWS : W ⊆ H.source := fun z hz => (hball (hW hz)).1.1
    rw [← hHΦ]
    refine ⟨H.isOpen_image_of_subset_source hWo hWS, ?_⟩
    -- Step 6: at `y = H z`, `z ∈ W`, the map `H = Φ` is `C¹` with invertible derivative
    -- `DΦ(z) = e`, so `H⁻¹` is `C¹` at `y`.
    rintro _ ⟨z, hzW, rfl⟩
    obtain ⟨⟨hzS, hzU⟩, e, he⟩ := hball (hW hzW)
    have hΦz : ContDiffAt ℝ 1 Φ z := hΦ.contDiffAt (hU.mem_nhds hzU)
    have hd : HasFDerivAt Φ (e : X →L[ℝ] Y) z := by
      rw [show (e : X →L[ℝ] Y) = fderiv ℝ Φ z from he]
      exact (hΦz.differentiableAt one_ne_zero).hasFDerivAt
    rw [← hHΦ] at hΦz hd
    have h₁ : HasFDerivAt (H : X → Y) (e : X →L[ℝ] Y) (H.symm (H z)) := by
      rwa [H.left_inv hzS]
    have h₂ : ContDiffAt ℝ 1 (H : X → Y) (H.symm (H z)) := by
      rwa [H.left_inv hzS]
    exact (H.contDiffAt_symm (H.map_source hzS) h₁ h₂).contDiffWithinAt
/-- **Normal coordinates, linear part** (parent proof, steps 1 and 5, with `L` in place of
`Dψ(v₀)`).  For an injective linear `L : ℝ^d → ℝ^P`, the map `Λ(w, k) = L w + k` is a continuous
linear isomorphism `ℝ^d × (range L)^⊥ ≅ ℝ^P`: it is injective, since `L w + k = 0` puts `k` in
`range L ∩ (range L)^⊥ = 0` and then `w = 0`; both sides have dimension `P`; and a linear
isomorphism between finite-dimensional spaces is continuous. -/
theorem Submission.dor_lmb_ret_nc_linear_iso : ∀ (P d : ℕ) (L : Euclid d →L[ℝ] Euclid P), Injective L → ∃ Λ : (Euclid d × ↥(L.range)ᗮ) ≃L[ℝ] Euclid P, ∀ (w : Euclid d) (k : ↥(L.range)ᗮ), Λ (w, k) = L w + k := by
  intro P d L hL
  -- Step 1: `Λ₀ = L ∘ pr₁ + ι ∘ pr₂`, so `Λ₀ (w, k) = L w + k`
  let Λ₀ : (Euclid d × ↥(L.range)ᗮ) →ₗ[ℝ] Euclid P :=
    (L : Euclid d →ₗ[ℝ] Euclid P) ∘ₗ LinearMap.fst ℝ (Euclid d) ↥(L.range)ᗮ +
      (L.range)ᗮ.subtype ∘ₗ LinearMap.snd ℝ (Euclid d) ↥(L.range)ᗮ
  -- Step 2: `L w + k = 0` puts `k = L (-w)` in `range L ∩ (range L)^⊥ = 0`, then `w = 0`
  have hinj : Injective Λ₀ := by
    refine (injective_iff_map_eq_zero Λ₀).2 ?_
    rintro ⟨w, k⟩ h
    change L w + (k : Euclid P) = 0 at h
    have hk : (k : Euclid P) ∈ L.range ⊓ (L.range)ᗮ :=
      ⟨LinearMap.mem_range.2 ⟨-w, by simpa using neg_eq_of_add_eq_zero_right h⟩, k.2⟩
    rw [Submodule.inf_orthogonal_eq_bot, Submodule.mem_bot] at hk
    have hw : w = 0 := (injective_iff_map_eq_zero L).1 hL w (by simpa [hk] using h)
    exact Prod.ext hw (Subtype.ext hk)
  -- Step 3: `dim (ℝ^d × (range L)^⊥) = dim range L + dim (range L)^⊥ = P`
  have hdim : Module.finrank ℝ (Euclid d × ↥(L.range)ᗮ) = Module.finrank ℝ (Euclid P) := by
    rw [Module.finrank_prod,
      ← LinearMap.finrank_range_of_inj (f := (L : Euclid d →ₗ[ℝ] Euclid P)) hL]
    exact (L.range).finrank_add_finrank_orthogonal
  -- Step 4: injective with equal finite dimensions, hence bijective
  have hsurj : Surjective Λ₀ :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdim).1 hinj
  -- Step 5: a linear equivalence in finite dimensions is continuous
  exact ⟨(LinearEquiv.ofBijective Λ₀ ⟨hinj, hsurj⟩).toContinuousLinearEquiv, fun w k => rfl⟩
/-- **Normal-coordinate map calculus.**  Let `V ⊆ ℝᵈ` be open, `v₀ ∈ V`, `ψ : ℝᵈ → ℝᴾ` and
`Q : ℝᵈ → L(ℝᴾ, ℝᴾ)` be `C¹` on `V`, and `Q(v₀)k = 0` for `k ∈ E`.  Then
`Φ(v, k) = ψ(v) + k − Q(v)k` is `C¹` on `V × E` (chain rule along `pr₁`, `ContDiffOn.clm_apply`),
and by the chain and product rules its derivative at `(v₀, 0)` is
`(w, h) ↦ Dψ(v₀)w + h − Q(v₀)h − (DQ(v₀)w)(0) = Dψ(v₀)w + h`. -/
theorem Submission.dor_lmb_ret_nc_map_calculus : ∀ (P d : ℕ) (E : Submodule ℝ (Euclid P)) (V : Set (Euclid d)) (ψ : Euclid d → Euclid P) (Q : Euclid d → (Euclid P →L[ℝ] Euclid P)) (v₀ : Euclid d), IsOpen V → v₀ ∈ V → ContDiffOn ℝ 1 ψ V → ContDiffOn ℝ 1 Q V → (∀ k ∈ E, Q v₀ k = 0) → ContDiffOn ℝ 1 (fun z : Euclid d × E => ψ z.1 + (z.2 : Euclid P) - Q z.1 (z.2 : Euclid P)) (V ×ˢ univ) ∧ HasFDerivAt (fun z : Euclid d × E => ψ z.1 + (z.2 : Euclid P) - Q z.1 (z.2 : Euclid P)) ((fderiv ℝ ψ v₀).comp (ContinuousLinearMap.fst ℝ (Euclid d) E) + E.subtypeL.comp (ContinuousLinearMap.snd ℝ (Euclid d) E)) (v₀, 0) := by
  intro P d E V ψ Q v₀ hV hv₀ hψ hQ hQ0
  -- `pr₁` maps `V × E` into `V`; `ι ∘ pr₂` is continuous linear.
  have hpr : MapsTo (Prod.fst : Euclid d × E → Euclid d) (V ×ˢ univ) V := fun z hz => hz.1
  have hι : ContDiff ℝ 1 (fun z : Euclid d × E => (z.2 : Euclid P)) :=
    (E.subtypeL.comp (ContinuousLinearMap.snd ℝ (Euclid d) E)).contDiff
  -- `Φ = ψ ∘ pr₁ + ι ∘ pr₂ − (Q ∘ pr₁)(ι ∘ pr₂)` is `C¹` on `V × E`.
  refine ⟨((hψ.comp contDiffOn_fst hpr).add hι.contDiffOn).sub
    ((hQ.comp contDiffOn_fst hpr).clm_apply hι.contDiffOn), ?_⟩
  -- `ψ` and `Q` are differentiable at `v₀ ∈ V`, `V` open.
  have hVn : V ∈ 𝓝 v₀ := hV.mem_nhds hv₀
  have hψd : HasFDerivAt ψ (fderiv ℝ ψ v₀) v₀ :=
    (hψ.contDiffAt hVn).differentiableAt_one.hasFDerivAt
  have hQd : HasFDerivAt Q (fderiv ℝ Q v₀) v₀ :=
    (hQ.contDiffAt hVn).differentiableAt_one.hasFDerivAt
  -- Chain rule along `pr₁`, and the derivative of `ι ∘ pr₂`.
  have d1 : HasFDerivAt (fun z : Euclid d × E => ψ z.1)
      ((fderiv ℝ ψ v₀).comp (ContinuousLinearMap.fst ℝ (Euclid d) E)) (v₀, (0 : E)) :=
    hψd.comp (v₀, (0 : E)) hasFDerivAt_fst
  have d2 : HasFDerivAt (fun z : Euclid d × E => (z.2 : Euclid P))
      (E.subtypeL.comp (ContinuousLinearMap.snd ℝ (Euclid d) E)) (v₀, (0 : E)) :=
    (E.subtypeL.comp (ContinuousLinearMap.snd ℝ (Euclid d) E)).hasFDerivAt
  have dQ : HasFDerivAt (fun z : Euclid d × E => Q z.1)
      ((fderiv ℝ Q v₀).comp (ContinuousLinearMap.fst ℝ (Euclid d) E)) (v₀, (0 : E)) :=
    hQd.comp (v₀, (0 : E)) hasFDerivAt_fst
  -- Product rule for application, then `Q(v₀)h = 0` for `h ∈ E`.
  convert (d1.add d2).sub (dQ.clm_apply d2) using 1
  refine ContinuousLinearMap.ext fun z => ?_
  simp [hQ0 _ z.2.2]
/-- **Tangent projections of a `C²` immersion** (step 2(a) of the nearest point retraction onto `N`
used for Simon 7.4.3): if `ψ` is `C²` on the open set `V ⊆ ℝᵈ` and `D(v) = Dψ(v)` is injective for
`v ∈ V`, then `v ↦ P̂(v)`, the orthogonal projection of `ℝᴾ` onto `range D(v)`, is `C¹` on `V`.
The Gram operator `G = DᵀD` is `C¹` on `V` and invertible there (`⟪G w, w⟫ = |D w|²`); inversion
is smooth at units, so `R = D G⁻¹ Dᵀ` is `C¹`.  For `h ∈ ℝᴾ`, `R(v) h = D(v) y` with
`G(v) y = D(v)ᵀ h`, so `⟪h − R(v) h, D(v) x⟫ = ⟪D(v)ᵀ h − G(v) y, x⟫ = 0` and `R(v) = P̂(v)`. -/
theorem Submission.dor_lmb_ret_tangent_projection : ∀ (P d : ℕ) (V : Set (Euclid d)) (ψ : Euclid d → Euclid P), IsOpen V → ContDiffOn ℝ 2 ψ V → (∀ z ∈ V, Injective (fderiv ℝ ψ z)) → ContDiffOn ℝ 1 (fun v => (fderiv ℝ ψ v).range.starProjection) V := by
  intro P d V ψ hV hψ hinj
  -- `D(v) = Dψ(v)` is `C¹` on the open set `V`
  have hD : ContDiffOn ℝ 1 (fun v => fderiv ℝ ψ v) V := hψ.fderiv_of_isOpen hV (by norm_num)
  -- transposition `A ↦ Aᵀ` is a bounded real-linear map, so `v ↦ D(v)ᵀ` is `C¹`
  have hadj : IsBoundedLinearMap ℝ
      (fun A : Euclid d →L[ℝ] Euclid P => ContinuousLinearMap.adjoint A) :=
    ⟨⟨fun A B => map_add _ A B, fun c A => by
      rw [LinearIsometryEquiv.map_smulₛₗ]; rfl⟩,
      ⟨1, one_pos, fun A => by rw [LinearIsometryEquiv.norm_map, one_mul]⟩⟩
  have hDt : ContDiffOn ℝ 1 (fun v => ContinuousLinearMap.adjoint (fderiv ℝ ψ v)) V :=
    hadj.contDiff.comp_contDiffOn hD
  -- the Gram operator `G(v) = D(v)ᵀ D(v)` is `C¹` on `V`
  set G : Euclid d → Euclid d →L[ℝ] Euclid d :=
    fun v => ContinuousLinearMap.adjoint (fderiv ℝ ψ v) ∘L fderiv ℝ ψ v with hG_def
  have hG : ContDiffOn ℝ 1 G V := hDt.clm_comp hD
  -- `G(v)` is invertible: `⟪G(v) w, w⟫ = |D(v) w|²` and `D(v)` is injective
  have hGunit : ∀ v ∈ V, IsUnit (G v) := by
    intro v hv
    have hGinj : Injective (G v) := by
      rw [injective_iff_map_eq_zero]
      intro w hw
      apply hinj v hv
      rw [map_zero]
      have hnorm : ‖fderiv ℝ ψ v w‖ ^ 2 = 0 := by
        rw [← real_inner_self_eq_norm_sq, ← ContinuousLinearMap.adjoint_inner_left]
        change inner ℝ (G v w) w = 0
        rw [hw, inner_zero_left]
      exact norm_eq_zero.mp (pow_eq_zero_iff two_ne_zero |>.mp hnorm)
    exact ContinuousLinearMap.isUnit_iff_bijective.mpr
      ⟨hGinj, (LinearMap.injective_iff_surjective (f := (G v : Euclid d →ₗ[ℝ] Euclid d))).mp hGinj⟩
  -- inversion is smooth at units, so `v ↦ G(v)⁻¹` is `C¹` on `V`
  have hGinv : ContDiffOn ℝ 1 (fun v => Ring.inverse (G v)) V := by
    intro v hv
    obtain ⟨u, hu⟩ := hGunit v hv
    have hinv := contDiffAt_ringInverse ℝ (n := 1) u
    rw [hu] at hinv
    exact hinv.comp_contDiffWithinAt v (hG v hv)
  -- `R(v) = D(v) G(v)⁻¹ D(v)ᵀ` is `C¹` on `V`
  have hR : ContDiffOn ℝ 1 (fun v => fderiv ℝ ψ v ∘L
      (Ring.inverse (G v) ∘L ContinuousLinearMap.adjoint (fderiv ℝ ψ v))) V :=
    hD.clm_comp (hGinv.clm_comp hDt)
  refine hR.congr fun v hv => ?_
  -- `R(v) h = D(v) y ∈ range D(v)` with `G(v) y = D(v)ᵀ h`, so `h - R(v) h ⊥ range D(v)`
  ext1 h
  set y := Ring.inverse (G v) (ContinuousLinearMap.adjoint (fderiv ℝ ψ v) h)
  have hGy : G v y = ContinuousLinearMap.adjoint (fderiv ℝ ψ v) h := by
    rw [← mul_apply_eq_comp, Ring.mul_inverse_cancel _ (hGunit v hv), one_apply_eq_self]
  change _ = fderiv ℝ ψ v y
  refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero
    (LinearMap.mem_range_self (fderiv ℝ ψ v : Euclid d →ₗ[ℝ] Euclid P) y) ?_
  rintro _ ⟨x, rfl⟩
  rw [ContinuousLinearMap.coe_coe, ← ContinuousLinearMap.adjoint_inner_left, map_sub]
  change inner ℝ (_ - G v y) x = 0
  rw [hGy, sub_self, inner_zero_left]
/-- **Normal-space transfer** (step 3(c) of the nearest point retraction onto a `C²`
submanifold).  Let `Q`, `Q'` be the orthogonal projections onto `T`, `T'` with
`dim T = dim T'` and `‖Q' - Q‖ ≤ 1/2`.  For `e ∈ Tᗮ` we have `Q e = 0`, so
`‖Q' e‖ = ‖(Q' - Q) e‖ ≤ ‖e‖/2` and `‖e‖ ≤ 2 ‖e - Q' e‖`.  Hence `e ↦ e - Q' e` is an
injective linear map `Tᗮ → T'ᗮ`; as `dim Tᗮ = dim T'ᗮ` it is onto, and the preimage `e` of
`n ∈ T'ᗮ` satisfies `e - Q' e = n` and `‖e‖ ≤ 2 ‖n‖`. -/
theorem Submission.dor_lmb_ret_normal_space_transfer : ∀ (P : ℕ) (T T' : Submodule ℝ (Euclid P)), Module.finrank ℝ T = Module.finrank ℝ T' → ‖T'.starProjection - T.starProjection‖ ≤ 1 / 2 → ∀ n ∈ T'ᗮ, ∃ e ∈ Tᗮ, e - T'.starProjection e = n ∧ ‖e‖ ≤ 2 * ‖n‖ := by
  intro P T T' hdim hQ n hn
  -- Step 1: `L e := e - Q' e` maps `Tᗮ` linearly into `T'ᗮ`
  let L : Tᗮ →ₗ[ℝ] T'ᗮ :=
    ((LinearMap.id - (T'.starProjection : Euclid P →ₗ[ℝ] Euclid P)).domRestrict Tᗮ).codRestrict
      T'ᗮ fun e => T'.sub_starProjection_mem_orthogonal (e : Euclid P)
  have hL : ∀ e : Tᗮ, ((L e : T'ᗮ) : Euclid P) = e - T'.starProjection e := fun e => rfl
  -- Step 2: for `e ∈ Tᗮ`, `Q e = 0`, so `‖Q' e‖ ≤ ‖e‖ / 2` and `‖e‖ ≤ 2 ‖e - Q' e‖`
  have hlow : ∀ e ∈ Tᗮ, ‖e‖ ≤ 2 * ‖e - T'.starProjection e‖ := by
    intro e he
    have hQe : T'.starProjection e = (T'.starProjection - T.starProjection) e := by
      rw [sub_apply, T.starProjection_apply_eq_zero_iff.mpr he, sub_zero]
    have h₁ : ‖T'.starProjection e‖ ≤ 1 / 2 * ‖e‖ := by
      rw [hQe]
      exact ((T'.starProjection - T.starProjection).le_opNorm e).trans
        (mul_le_mul_of_nonneg_right hQ (norm_nonneg e))
    have h₂ : ‖e‖ ≤ ‖e - T'.starProjection e‖ + ‖T'.starProjection e‖ := by
      simpa using norm_add_le (e - T'.starProjection e) (T'.starProjection e)
    linarith
  -- Step 3: `L` is injective, since `L e = 0` forces `‖e‖ ≤ 0`
  have hinj : Function.Injective L := by
    refine (injective_iff_map_eq_zero L).mpr fun e he => ?_
    have h := hlow e e.2
    rw [← hL, he, ZeroMemClass.coe_zero, norm_zero, mul_zero] at h
    exact Subtype.ext (norm_le_zero_iff.mp h)
  -- Step 4: `dim Tᗮ = dim T'ᗮ`, so the injective map `L` is onto `T'ᗮ`
  have hdim' : Module.finrank ℝ Tᗮ = Module.finrank ℝ T'ᗮ := by
    have h₁ := T.finrank_add_finrank_orthogonal
    have h₂ := T'.finrank_add_finrank_orthogonal
    omega
  obtain ⟨e, he⟩ := (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdim').mp hinj ⟨n, hn⟩
  -- Step 5: the preimage `e` of `n` satisfies `e - Q' e = n` and `‖e‖ ≤ 2 ‖n‖`
  have hen : (e : Euclid P) - T'.starProjection e = n := by rw [← hL, he]
  exact ⟨e, e.2, hen, hen ▸ hlow e e.2⟩

/-- **Normal coordinates** (step 3 of the nearest point retraction onto a `C²` submanifold).
Let `P̂(v)` be the orthogonal projection onto `range Dψ(v)` and `E = (range Dψ(v₀))ᗮ`.  The map
`Φ(v, e) = ψ(v) + e - P̂(v) e` is `C¹` on `V × E` with `DΦ(v₀, 0)(w, k) = Dψ(v₀) w + k`, an
isomorphism `ℝᵈ × E ≃ ℝᴾ`, so `Φ` has a `C¹` local inverse `G` on `O = Φ(B_{δ₁}(v₀, 0))`; put
`g = pr₁ ∘ G` and `δ = δ₁/2`, with `‖P̂(v) - P̂(v₀)‖ ≤ 1/2` on `B_{δ₁}(v₀)`.  A normal vector
`n` at `ψ(v)` with `|n| < δ` is `e - P̂(v) e` for some `e ∈ E` with `|e| ≤ 2|n| < δ₁`, so
`ψ(v) + n = Φ(v, e) ∈ O` and `g(ψ(v) + n) = v`. -/
theorem Submission.dor_lmb_ret_normal_coordinates : ∀ (P d : ℕ) (V : Set (Euclid d)) (ψ : Euclid d → Euclid P) (v₀ : Euclid d), IsOpen V → ContDiffOn ℝ 2 ψ V → (∀ z ∈ V, Injective (fderiv ℝ ψ z)) → v₀ ∈ V → ∃ (δ : ℝ) (O : Set (Euclid P)) (g : Euclid P → Euclid d), 0 < δ ∧ closedBall v₀ δ ⊆ V ∧ IsOpen O ∧ ContDiffOn ℝ 1 g O ∧ ∀ v ∈ ball v₀ δ, ∀ n : Euclid P, (fderiv ℝ ψ v).range.starProjection n = 0 → ‖n‖ < δ → ψ v + n ∈ O ∧ g (ψ v + n) = v := by
  intro P d V ψ v₀ hV hψ hinj hv₀
  -- `P̂(v)` is the orthogonal projection onto `range Dψ(v)`, and `E = (range Dψ(v₀))ᗮ`
  set Q : Euclid d → Euclid P →L[ℝ] Euclid P := fun v => (fderiv ℝ ψ v).range.starProjection
  set E : Submodule ℝ (Euclid P) := (fderiv ℝ ψ v₀).rangeᗮ
  -- Step 2: `P̂` is `C¹` on `V`
  have hQ : ContDiffOn ℝ 1 Q V := Submission.dor_lmb_ret_tangent_projection P d V ψ hV hψ hinj
  -- Steps 3–4: `Φ(v, e) = ψ(v) + e - P̂(v) e` is `C¹` on `V × E`, and
  -- `DΦ(v₀, 0)(w, k) = Dψ(v₀) w + k` because `P̂(v₀) k = 0` for `k ∈ E`
  obtain ⟨hΦ, hΦ'⟩ := Submission.dor_lmb_ret_nc_map_calculus P d E V ψ Q v₀ hV hv₀
    (hψ.of_le (by norm_num)) hQ fun k hk => (Submodule.starProjection_apply_eq_zero_iff _).mpr hk
  set Φ : Euclid d × E → Euclid P := fun z => ψ z.1 + (z.2 : Euclid P) - Q z.1 (z.2 : Euclid P)
  -- Step 5: `Λ(w, k) = Dψ(v₀) w + k` is an isomorphism `ℝᵈ × E ≃ ℝᴾ`, and `Λ = DΦ(v₀, 0)`
  obtain ⟨Λ, hΛ⟩ : ∃ Λ : (Euclid d × E) ≃L[ℝ] Euclid P,
      ∀ (w : Euclid d) (k : E), Λ (w, k) = fderiv ℝ ψ v₀ w + k :=
    Submission.dor_lmb_ret_nc_linear_iso P d (fderiv ℝ ψ v₀) (hinj v₀ hv₀)
  have hΛΦ : HasFDerivAt Φ (Λ : Euclid d × E →L[ℝ] Euclid P) (v₀, 0) :=
    hΦ'.congr_fderiv <| ContinuousLinearMap.ext fun ⟨w, k⟩ => by simp [hΛ]
  -- Steps 6–7: inverse function theorem for `Φ` at `(v₀, 0)`
  obtain ⟨ρ, hρ, hρV, G, hG, hGW⟩ := Submission.dor_lmb_ret_nc_local_inverse (Euclid d × E)
    (Euclid P) Φ (V ×ˢ univ) (v₀, 0) Λ (hV.prod isOpen_univ) ⟨hv₀, mem_univ _⟩ hΦ hΛΦ
  -- Step 8: `‖P̂(v) - P̂(v₀)‖ < 1/2` on `B_{δ₂}(v₀)`; take `0 < δ₁ ≤ min ρ δ₂`
  obtain ⟨δ₂, hδ₂, hδ₂Q⟩ := Metric.continuousAt_iff.mp
    (hQ.continuousOn.continuousAt (hV.mem_nhds hv₀)) (1 / 2) one_half_pos
  obtain ⟨δ₁, hδ₁, hδ₁ρ, hδ₁δ₂⟩ : ∃ δ₁ : ℝ, 0 < δ₁ ∧ δ₁ ≤ ρ ∧ δ₁ ≤ δ₂ :=
    ⟨min ρ δ₂, lt_min hρ hδ₂, min_le_left _ _, min_le_right _ _⟩
  have hB : ball ((v₀, 0) : Euclid d × E) δ₁ ⊆ ball (v₀, 0) ρ := ball_subset_ball hδ₁ρ
  have hW := hGW _ hB isOpen_ball
  -- `B_{δ₁}(v₀) ⊆ V`, as `(v, 0) ∈ B_ρ(v₀, 0) ⊆ V × E`
  have hball : ball v₀ δ₁ ⊆ V := by
    intro v hv
    have hv0 : ((v, 0) : Euclid d × E) ∈ ball (v₀, 0) δ₁ := by
      rw [← ball_prod_same]
      exact mk_mem_prod hv (mem_ball_self hδ₁)
    exact (mem_prod.mp (hρV (hB hv0))).1
  -- Step 9: `δ = δ₁/2`, `O = Φ(B_{δ₁}(v₀, 0))` and `g = pr₁ ∘ G`
  refine ⟨δ₁ / 2, Φ '' ball (v₀, 0) δ₁, fun x => (G x).1, half_pos hδ₁,
    (closedBall_subset_ball (half_lt_self hδ₁)).trans hball, hW.1, hW.2.fst, ?_⟩
  -- Step 10: let `v ∈ B_δ(v₀)` and `n ⊥ range Dψ(v)` with `|n| < δ`
  intro v hv n hn hnδ
  have hv₁ : v ∈ ball v₀ δ₁ := ball_subset_ball (half_le_self hδ₁.le) hv
  have hvV : v ∈ V := hball hv₁
  -- `dim range Dψ(v₀) = d = dim range Dψ(v)` and `‖P̂(v) - P̂(v₀)‖ ≤ 1/2`
  have hdim : Module.finrank ℝ (fderiv ℝ ψ v₀).range =
      Module.finrank ℝ (fderiv ℝ ψ v).range :=
    (LinearMap.finrank_range_of_inj (f := (fderiv ℝ ψ v₀ : Euclid d →ₗ[ℝ] Euclid P))
      (hinj v₀ hv₀)).trans
      (LinearMap.finrank_range_of_inj (f := (fderiv ℝ ψ v : Euclid d →ₗ[ℝ] Euclid P))
        (hinj v hvV)).symm
  have hQv : ‖Q v - Q v₀‖ ≤ 1 / 2 := by
    rw [← dist_eq_norm]
    exact (hδ₂Q ((mem_ball.mp hv₁).trans_le hδ₁δ₂)).le
  -- normal-space transfer: `n = e - P̂(v) e` for some `e ∈ E` with `|e| ≤ 2|n| < δ₁`
  obtain ⟨e, he, hen, hle⟩ := Submission.dor_lmb_ret_normal_space_transfer P _ _ hdim hQv n
    ((Submodule.starProjection_apply_eq_zero_iff _).mp hn)
  have hz : ((v, ⟨e, he⟩) : Euclid d × E) ∈ ball (v₀, 0) δ₁ := by
    rw [← ball_prod_same]
    refine mk_mem_prod hv₁ (mem_ball_zero_iff.mpr ?_)
    change ‖e‖ < δ₁
    linarith
  -- so `ψ(v) + n = Φ(v, e) ∈ O` and `G(ψ(v) + n) = (v, e)`, i.e. `g(ψ(v) + n) = v`
  have hΦz : Φ (v, ⟨e, he⟩) = ψ v + n := by
    change ψ v + e - (fderiv ℝ ψ v).range.starProjection e = ψ v + n
    rw [add_sub_assoc, hen]
  have hGz : G (ψ v + n) = (v, ⟨e, he⟩) := by
    rw [← hΦz]
    exact hG _ (hB hz)
  exact ⟨⟨_, hz, hΦz⟩, congrArg Prod.fst hGz⟩

/-- **Nearest-point retraction near a chart point** (proof of Simon 7.4.3: the nearest-point
projection onto the embedded `C²` submanifold `N` near `y = ψ(v₀)`).  Normal coordinates give
`δ`, `O`, `g` with `g(ψ(v) + n) = v` for `v ∈ B_δ(v₀)` and `n ⊥ range Dψ(v)`, `|n| < δ`; chart
localization with `ε = δ` gives a compact `K = N ∩ B̄_ρ(y) ⊆ ψ(V ∩ B_δ(v₀))`.  For `x ∈ B_r(y)`,
`r = min(ρ/2, δ)`, the distance from `x` to `K` is attained at some `p = ψ(v)`, `v ∈ B_δ(v₀)`, and
points of `N \ K` are farther away, so `p` is nearest in `N`.  The first-order condition for
`|x − ψ(·)|²` at `v` makes `x − p` normal to `range Dψ(v)`; as `|x − p| ≤ |x − y| < δ`, normal
coordinates give `x = ψ(v) + (x − p) ∈ O` and `g(x) = v`. -/
theorem Submission.dor_lmb_ret_nearest_point : ∀ (P d : ℕ) (N W : Set (Euclid P)) (V : Set (Euclid d)) (ψ : Euclid d → Euclid P) (v₀ : Euclid d), IsOpen V → IsOpen W → ContDiffOn ℝ 2 ψ V → InjOn ψ V → ψ '' V = W ∩ N → (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → (∀ z ∈ V, Injective (fderiv ℝ ψ z)) → v₀ ∈ V → ∃ (r δ : ℝ) (g : Euclid P → Euclid d), 0 < r ∧ 0 < δ ∧ closedBall v₀ δ ⊆ V ∧ ContDiffOn ℝ 1 g (ball (ψ v₀) r) ∧ MapsTo g (ball (ψ v₀) r) (ball v₀ δ) ∧ (∀ x ∈ ball (ψ v₀) r, ∀ z ∈ N, ‖x - ψ (g x)‖ ≤ ‖x - z‖) ∧ (∀ x ∈ ball (ψ v₀) r, (fderiv ℝ ψ (g x)).range.starProjection (x - ψ (g x)) = 0) ∧ ∀ x ∈ N ∩ ball (ψ v₀) r, ψ (g x) = x := by
  intro P d N W V ψ v₀ hV hW hψ hinj himg hprop hDψ hv₀
  -- normal coordinates: `g(ψ(v) + n) = v` for `v ∈ B_δ(v₀)` and normal `n` with `|n| < δ`
  obtain ⟨δ, O, g, hδ, hδV, -, hgO, hrec⟩ :=
    Submission.dor_lmb_ret_normal_coordinates P d V ψ v₀ hV hψ hDψ hv₀
  -- chart localization with `ε = δ`: `K = N ∩ B̄_ρ(y)` is compact and lies in `ψ(V ∩ B_δ(v₀))`
  obtain ⟨ρ, hρ, -, hKψ, hK⟩ := Submission.dor_lmb_ret_chart_localization P d N W V ψ v₀ hW
    hψ.continuousOn hinj himg hprop hv₀ δ hδ
  -- `ψ(V) ⊆ N`, so `y ∈ K`
  have hψN : ∀ w ∈ V, ψ w ∈ N := fun w hw => (himg ▸ mem_image_of_mem ψ hw : ψ w ∈ W ∩ N).2
  have hyK : ψ v₀ ∈ N ∩ closedBall (ψ v₀) ρ := ⟨hψN v₀ hv₀, mem_closedBall_self hρ.le⟩
  have hr : 0 < min (ρ / 2) δ := lt_min (half_pos hρ) hδ
  -- for `x ∈ B_r(y)`: a nearest point `ψ(v)` of `N`, with `x − ψ(v)` normal and `g(x) = v`
  have key : ∀ x ∈ ball (ψ v₀) (min (ρ / 2) δ), ∃ v ∈ ball v₀ δ,
      (∀ z ∈ N, ‖x - ψ v‖ ≤ ‖x - z‖) ∧
        (fderiv ℝ ψ v).range.starProjection (x - ψ v) = 0 ∧ x ∈ O ∧ g x = v := by
    intro x hx
    rw [mem_ball, dist_eq_norm, lt_min_iff] at hx
    obtain ⟨hxρ, hxδ⟩ := hx
    -- the distance from `x` to `K` is attained at some `p ∈ K`
    obtain ⟨p, hpK, hpmin⟩ := hK.exists_isMinOn ⟨ψ v₀, hyK⟩
      ((continuous_const.sub continuous_id).norm.continuousOn :
        ContinuousOn (fun z => ‖x - z‖) _)
    rw [isMinOn_iff] at hpmin
    have hpy : ‖x - p‖ ≤ ‖x - ψ v₀‖ := hpmin _ hyK
    -- points of `N \ K` are at distance `> ρ - ρ / 2 > |x - y|` from `x`
    have hnear : ∀ z ∈ N, ‖x - p‖ ≤ ‖x - z‖ := by
      intro z hz
      by_cases hzK : z ∈ closedBall (ψ v₀) ρ
      · exact hpmin z ⟨hz, hzK⟩
      rw [mem_closedBall, dist_eq_norm, not_le] at hzK
      have htri : ‖z - ψ v₀‖ ≤ ‖x - ψ v₀‖ + ‖x - z‖ := by
        simpa using norm_sub_le (x - ψ v₀) (x - z)
      linarith
    -- `p = ψ(v)` with `v ∈ V ∩ B_δ(v₀)`
    obtain ⟨v, ⟨hvV, hvδ⟩, rfl⟩ := hKψ hpK
    -- `w ↦ |x − ψ(w)|²` has a local minimum at `v`, as `ψ(V) ⊆ N` and `V` is open
    have hmin : IsLocalMin (fun w => ‖x - ψ w‖ ^ 2) v := by
      filter_upwards [hV.mem_nhds hvV] with w hw
      exact pow_le_pow_left₀ (norm_nonneg _) (hnear _ (hψN w hw)) 2
    have hDv : HasFDerivAt ψ (fderiv ℝ ψ v) v :=
      ((hψ.differentiableOn two_ne_zero).differentiableAt (hV.mem_nhds hvV)).hasFDerivAt
    -- its derivative `w ↦ −2⟨x − ψ(v), Dψ(v)w⟩` vanishes, so `x − ψ(v) ⊥ range Dψ(v)`
    have h0 := hmin.hasFDerivAt_eq_zero (hDv.const_sub x).norm_sq
    have hnormal : (fderiv ℝ ψ v).range.starProjection (x - ψ v) = 0 := by
      rw [Submodule.starProjection_apply_eq_zero_iff, Submodule.mem_orthogonal]
      rintro _ ⟨w, rfl⟩
      have h := congrArg (fun L => L w) h0
      simp only [_root_.smul_apply, ContinuousLinearMap.comp_apply, _root_.neg_apply,
        innerSL_apply_apply, inner_neg_right, _root_.zero_apply, smul_neg, neg_eq_zero,
        smul_eq_zero] at h
      rw [real_inner_comm]
      exact h.resolve_left two_ne_zero
    -- normal coordinates recover `v` from `x = ψ(v) + (x − ψ(v))`, `|x − ψ(v)| < δ`
    obtain ⟨hxO, hgx⟩ := hrec v hvδ (x - ψ v) hnormal (hpy.trans_lt hxδ)
    rw [add_sub_cancel] at hxO hgx
    exact ⟨v, hvδ, hnear, hnormal, hxO, hgx⟩
  refine ⟨min (ρ / 2) δ, δ, g, hr, hδ, hδV,
    hgO.mono fun x hx => (key x hx).elim fun _ h => h.2.2.2.1, fun x hx => ?_, fun x hx => ?_,
    fun x hx => ?_, fun x hx => ?_⟩
  · obtain ⟨v, hvδ, -, -, -, hgx⟩ := key x hx
    rwa [hgx]
  · obtain ⟨v, -, hnear, -, -, hgx⟩ := key x hx
    rwa [hgx]
  · obtain ⟨v, -, -, hnormal, -, hgx⟩ := key x hx
    rwa [hgx]
  · -- a point of `N` is its own nearest point
    obtain ⟨v, -, hnear, -, -, hgx⟩ := key x hx.2
    have h := hnear x hx.1
    rw [sub_self, norm_zero, norm_le_zero_iff, sub_eq_zero] at h
    rw [hgx, h]
/-- **Tangent identity** (step 6(c) of the C¹-retraction proof): if `proj` is differentiable at
`x ∈ O`, `O` open, and fixes every point of `N ∩ O`, then `Dproj(x) v = v` for every
`v ∈ T_xN`.  Write `v = γ'(0)` with `γ((−1, 1)) ⊆ N`, `γ(0) = x`; by continuity `γ` stays in `O`
near `0`, so `proj ∘ γ = γ` near `0`.  The chain rule gives `(proj ∘ γ)'(0) = Dproj(x) v`, and
uniqueness of derivatives gives `Dproj(x) v = γ'(0) = v`. -/
theorem Submission.dor_lmb_ret_fderiv_tangent_eq : ∀ (P : ℕ) (N O : Set (Euclid P)) (proj : Euclid P → Euclid P) (x : Euclid P), IsOpen O → x ∈ O → DifferentiableAt ℝ proj x → (∀ z ∈ N ∩ O, proj z = z) → ∀ v ∈ tangentSpace N x, fderiv ℝ proj x v = v := by
  intro P N O proj x hO hxO hproj hfix v hv
  obtain ⟨γ, -, hγN, hγ0, hγ⟩ := hv
  -- `γ` is continuous at `0` and `γ 0 = x ∈ O`, so `γ s ∈ O` for `s` near `0`
  have hγO : ∀ᶠ s in 𝓝 (0 : ℝ), γ s ∈ O :=
    hγ.continuousAt (by rw [hγ0]; exact hO.mem_nhds hxO)
  -- on `(−1, 1)` the curve lies in `N`, hence `proj ∘ γ = γ` near `0`
  have heq : proj ∘ γ =ᶠ[𝓝 0] γ := by
    filter_upwards [hγO, Ioo_mem_nhds neg_one_lt_zero zero_lt_one] with s hsO hsI
    exact hfix (γ s) ⟨hγN hsI, hsO⟩
  -- chain rule: `proj ∘ γ` has derivative `Dproj(x) v` at `0`
  have hcomp : HasDerivAt (proj ∘ γ) (fderiv ℝ proj x v) 0 :=
    hproj.hasFDerivAt.comp_hasDerivAt_of_eq 0 hγ hγ0.symm
  -- so does `γ`, and derivatives are unique
  exact (hcomp.congr_of_eventuallyEq heq.symm).unique hγ
/-- **Differentiated normality estimate** (step 7(b)–(e) of the parent retraction proof, with an
abstract `Q` in place of `P̂`).  Put `v = g(x)`, `ν = x − ψ(v)`, `A = Dg(x)`, `B = Dψ(v)` and
`C = DQ(v)`.  Differentiating `z ↦ Q(g(z))(z − ψ(g(z)))`, which vanishes on the open `O ∋ x`,
gives `Q(v)(h − BAh) + (C(Ah))ν = 0`; as `Q(v)` fixes the range of `B`, `BAh = Q(v)h + (C(Ah))ν`.
With `|Ah| ≤ b|BAh|` this gives `|BAh| ≤ |h| + s|BAh|` for `s = ab|ν| ≤ 1/2`, hence
`|BAh| ≤ (1 + 2s)|h|` because `(1 + 2s)(1 − s) ≥ 1`. -/
theorem Submission.dor_lmb_ret_derivative_estimate : ∀ (P d : ℕ) (O : Set (Euclid P)) (g : Euclid P → Euclid d) (ψ : Euclid d → Euclid P) (Q : Euclid d → (Euclid P →L[ℝ] Euclid P)) (x : Euclid P) (a b : ℝ), IsOpen O → x ∈ O → DifferentiableAt ℝ g x → DifferentiableAt ℝ ψ (g x) → DifferentiableAt ℝ Q (g x) → (∀ z ∈ O, Q (g z) (z - ψ (g z)) = 0) → (Q (g x)).comp (fderiv ℝ ψ (g x)) = fderiv ℝ ψ (g x) → ‖Q (g x)‖ ≤ 1 → 0 ≤ a → 0 ≤ b → ‖fderiv ℝ Q (g x)‖ ≤ a → (∀ w : Euclid d, ‖w‖ ≤ b * ‖fderiv ℝ ψ (g x) w‖) → a * b * ‖x - ψ (g x)‖ ≤ 1 / 2 → ‖fderiv ℝ (ψ ∘ g) x‖ ≤ 1 + 2 * (a * b) * ‖x - ψ (g x)‖ := by
  intro P d O g ψ Q x a b hO hx hg hψ hQ hzero hQB hQ1 ha hb hDQ hinj hs
  set A := fderiv ℝ g x
  set B := fderiv ℝ ψ (g x)
  set C := fderiv ℝ Q (g x)
  set ν := x - ψ (g x)
  -- `F(z) = Q(g(z))(z − ψ(g(z)))` has derivative `h ↦ Q(v)(h − BAh) + (C(Ah))ν` at `x`
  have hF : HasFDerivAt (fun z => Q (g z) (z - ψ (g z)))
      ((Q (g x)).comp (ContinuousLinearMap.id ℝ (Euclid P) - B.comp A) + (C.comp A).flip ν) x :=
    (hQ.hasFDerivAt.comp x hg.hasFDerivAt).clm_apply
      ((hasFDerivAt_id x).sub (hψ.hasFDerivAt.comp x hg.hasFDerivAt))
  -- `F` vanishes on the open neighbourhood `O` of `x`, so `DF(x) = 0`
  have hF0 : HasFDerivAt (fun z => Q (g z) (z - ψ (g z))) (0 : Euclid P →L[ℝ] Euclid P) x :=
    (hasFDerivAt_const (0 : Euclid P) x).congr_of_eventuallyEq
      (Filter.eventually_of_mem (hO.mem_nhds hx) hzero)
  have hDF := hF.unique hF0
  have hs0 : 0 ≤ a * b * ‖ν‖ := mul_nonneg (mul_nonneg ha hb) (norm_nonneg _)
  -- `D(ψ ∘ g)(x) = B ∘ A`; bound `|BAh|` for each `h`
  rw [fderiv_comp x hψ hg]
  refine ContinuousLinearMap.opNorm_le_bound _ (by linarith) fun h => ?_
  show ‖B (A h)‖ ≤ (1 + 2 * (a * b) * ‖ν‖) * ‖h‖
  -- `BAh = Q(v)h + (C(Ah))ν`, using `Q(v)(BAh) = BAh`
  have h1 : Q (g x) (h - B (A h)) + C (A h) ν = 0 := by
    simpa using DFunLike.congr_fun hDF h
  have h2 : Q (g x) (B (A h)) = B (A h) := DFunLike.congr_fun hQB (A h)
  have hkey : B (A h) = Q (g x) h + C (A h) ν := by
    rw [map_sub, h2, sub_add_eq_add_sub, sub_eq_zero] at h1
    exact h1.symm
  -- `|Q(v)h| ≤ |h|` and `|(C(Ah))ν| ≤ a|Ah||ν| ≤ ab|ν||BAh|`
  have hQh : ‖Q (g x) h‖ ≤ ‖h‖ :=
    ((Q (g x)).le_opNorm h).trans (by simpa using mul_le_mul_of_nonneg_right hQ1 (norm_nonneg h))
  have hCh : ‖C (A h) ν‖ ≤ a * b * ‖ν‖ * ‖B (A h)‖ :=
    calc ‖C (A h) ν‖ ≤ ‖C (A h)‖ * ‖ν‖ := (C (A h)).le_opNorm ν
      _ ≤ ‖C‖ * ‖A h‖ * ‖ν‖ := by gcongr; exact C.le_opNorm (A h)
      _ ≤ a * (b * ‖B (A h)‖) * ‖ν‖ := by gcongr; exact hinj (A h)
      _ = a * b * ‖ν‖ * ‖B (A h)‖ := by ring
  have hle : ‖B (A h)‖ ≤ ‖h‖ + a * b * ‖ν‖ * ‖B (A h)‖ :=
    calc ‖B (A h)‖ = ‖Q (g x) h + C (A h) ν‖ := by rw [← hkey]
      _ ≤ ‖Q (g x) h‖ + ‖C (A h) ν‖ := norm_add_le _ _
      _ ≤ ‖h‖ + a * b * ‖ν‖ * ‖B (A h)‖ := add_le_add hQh hCh
  -- `(1 − s)|BAh| ≤ |h|` and `(1 + 2s)(1 − s) = 1 + s(1 − 2s) ≥ 1` for `0 ≤ s ≤ 1/2`
  nlinarith [mul_nonneg (sub_nonneg.mpr hle) (by linarith : (0 : ℝ) ≤ 1 + 2 * (a * b * ‖ν‖)),
    mul_nonneg (mul_nonneg hs0 (by linarith : (0 : ℝ) ≤ 1 - 2 * (a * b * ‖ν‖)))
      (norm_nonneg (B (A h)))]
/-- Uniform injectivity on a compact set (step 2(b) of the nearest point retraction used in the
proof of Simon 7.4.3): if `L : ℝᵈ → L(ℝᵈ, ℝᴾ)` is continuous on the compact set `K` and `L(v)` is
injective for every `v ∈ K`, then some `b ≥ 0` has `|w| ≤ b |L(v)w|` for all `v ∈ K`, `w ∈ ℝᵈ`.
The continuous function `(v, w) ↦ |L(v)w|` attains its minimum `m` on the compact set
`S := K × {|w| = 1}`; `m > 0` by injectivity, and `b := m⁻¹` works since
`m ≤ |L(v)(w / |w|)| = |L(v)w| / |w|` for `w ≠ 0`.  If `S = ∅` (`K = ∅` or `d = 0`), every `w` is
`0` for `v ∈ K`, and `b := 0` works. -/
theorem Submission.dor_lmb_ret_uniform_injectivity : ∀ (P d : ℕ) (K : Set (Euclid d)) (L : Euclid d → (Euclid d →L[ℝ] Euclid P)), IsCompact K → ContinuousOn L K → (∀ v ∈ K, Injective (L v)) → ∃ b : ℝ, 0 ≤ b ∧ ∀ v ∈ K, ∀ w : Euclid d, ‖w‖ ≤ b * ‖L v w‖ := by
  intro P d K L hK hL hinj
  -- `w / |w|` is a unit vector for `w ≠ 0`
  have hunit : ∀ w : Euclid d, w ≠ 0 → ‖w‖⁻¹ • w ∈ sphere (0 : Euclid d) 1 := by
    intro w hw
    rw [mem_sphere_zero_iff_norm, norm_smul, norm_inv, norm_norm,
      inv_mul_cancel₀ (norm_ne_zero_iff.2 hw)]
  rcases (K ×ˢ sphere (0 : Euclid d) 1).eq_empty_or_nonempty with hS | hS
  · -- `S = ∅`: for `v ∈ K` every `w` is `0`, so `b := 0` works
    refine ⟨0, le_rfl, fun v hv w => ?_⟩
    have hw : w = 0 := by
      by_contra hw
      have hmem : (v, ‖w‖⁻¹ • w) ∈ K ×ˢ sphere (0 : Euclid d) 1 := ⟨hv, hunit w hw⟩
      rw [hS] at hmem
      exact hmem
    rw [hw, norm_zero, zero_mul]
  · -- `(v, w) ↦ |L(v)w|` attains its minimum `m = |L(v₁)w₁|` on the compact set `S`
    obtain ⟨⟨v₁, w₁⟩, ⟨hv₁, hw₁⟩, hmin⟩ := (hK.prod (isCompact_sphere _ _)).exists_isMinOn hS
      ((hL.comp continuousOn_fst fun _ hp => hp.1).clm_apply continuousOn_snd).norm
    -- `m > 0`, since `w₁ ≠ 0` and `L(v₁)` is injective
    have hw₁0 : w₁ ≠ 0 := ne_zero_of_mem_unit_sphere ⟨w₁, hw₁⟩
    have hm : 0 < ‖L v₁ w₁‖ :=
      norm_pos_iff.2 fun h => hw₁0 (hinj v₁ hv₁ (by rw [h, map_zero]))
    refine ⟨‖L v₁ w₁‖⁻¹, inv_nonneg.2 (norm_nonneg _), fun v hv w => ?_⟩
    rcases eq_or_ne w 0 with rfl | hw
    · rw [norm_zero, map_zero, norm_zero, mul_zero]
    -- `m ≤ |L(v)(w / |w|)| = |L(v)w| / |w|`, i.e. `m |w| ≤ |L(v)w|`
    have hle : ‖L v₁ w₁‖ ≤ ‖w‖⁻¹ * ‖L v w‖ :=
      calc ‖L v₁ w₁‖ ≤ ‖L v (‖w‖⁻¹ • w)‖ := isMinOn_iff.1 hmin (v, ‖w‖⁻¹ • w) ⟨hv, hunit w hw⟩
        _ = ‖w‖⁻¹ * ‖L v w‖ := by rw [map_smul, norm_smul, norm_inv, norm_norm]
    exact (le_inv_mul_iff₀ hm).2 ((le_inv_mul_iff₀' (norm_pos_iff.2 hw)).1 hle)

/-- **Nearest point retraction near `y ∈ N`** (step 1(a) of the limsup mass bound: the tubular
neighbourhood theorem, Foote 1984, written out in a chart).  Take a `C²` chart `ψ : V → W ∩ N`
with `ψ(v₀) = y`.  `dor_lmb_ret_nearest_point` gives `g` on `B_{r'}(y)` such that `π := ψ ∘ g` is
the nearest point map onto `N`: it is `C¹`, fixes `N ∩ B_{r'}(y)`, and `x − π(x)` is normal to `N`
at `π(x)`.  On `B̄_δ(v₀)`, `a` bounds the derivative of the tangent projection `P̂(v)` (`C¹` by
`dor_lmb_ret_tangent_projection`), and `|w| ≤ b|Dψ(v)w|` (`dor_lmb_ret_uniform_injectivity`).
Take `r ≤ r'` with `B̄_r(y) ⊆ U` and `2abr ≤ 1`.  Then `Dπ(x)v = v` on `T_xN`
(`dor_lmb_ret_fderiv_tangent_eq`).  Differentiating `P̂(g x)(x − π(x)) = 0` gives
`‖Dπ(x)‖ ≤ 1 + 2ab|x − π(x)|` (`dor_lmb_ret_derivative_estimate`), and `|x − π(x)| ≤ |x − y|`
because `y ∈ N`.  The hypothesis `(N̄ \ N) ∩ U = ∅` is not used. -/
theorem Submission.dor_lmb_c1_retraction : ∀ (P d : ℕ) (U N : Set (Euclid P)) (y : Euclid P), IsOpen U → IsEmbeddedSubmanifold 2 d N → (closure N \ N) ∩ U = ∅ → y ∈ N ∩ U → ∃ (r c : ℝ) (proj : Euclid P → Euclid P), 0 < r ∧ 0 ≤ c ∧ closedBall y r ⊆ U ∧ ContDiffOn ℝ 1 proj (ball y r) ∧ MapsTo proj (ball y r) N ∧ (∀ x ∈ N ∩ ball y r, proj x = x) ∧ (∀ x ∈ N ∩ ball y r, ∀ v ∈ tangentSpace N x, fderiv ℝ proj x v = v) ∧ ∀ x ∈ ball y r, ‖fderiv ℝ proj x‖ ≤ 1 + c * dist x y := by
  intro P d U N y hU hN _ hy
  -- Step 1: a `C²` chart `ψ : V → W ∩ N` with `ψ(v₀) = y`
  obtain ⟨V, W, ψ, hV, hW, hyW, hψ, hinj, himg, hprop, hDinj⟩ := hN y hy.1
  have hψ2 : ContDiffOn ℝ 2 ψ V := by exact_mod_cast hψ
  obtain ⟨v₀, hv₀, rfl⟩ : y ∈ ψ '' V := by
    rw [himg]
    exact ⟨hyW, hy.1⟩
  -- Step 2: the nearest point map `π = ψ ∘ g` on `B_{r'}(y)`, with `g(B_{r'}(y)) ⊆ B_δ(v₀)`
  obtain ⟨r', δ, g, hr', -, hδV, hg, hgδ, hnear, hnormal, hfix⟩ :=
    Submission.dor_lmb_ret_nearest_point P d N W V ψ v₀ hV hW hψ2 hinj himg hprop hDinj hv₀
  have hgV : MapsTo g (ball (ψ v₀) r') V := fun x hx => hδV (ball_subset_closedBall (hgδ hx))
  have hπ : ContDiffOn ℝ 1 (ψ ∘ g) (ball (ψ v₀) r') := (hψ2.of_le one_le_two).comp hg hgV
  -- Step 3: the tangent projection `P̂(v)` is `C¹` on `V`; `a` bounds `‖DP̂‖` on `B̄_δ(v₀)`
  have hQ : ContDiffOn ℝ 1 (fun v => (fderiv ℝ ψ v).range.starProjection) V :=
    Submission.dor_lmb_ret_tangent_projection P d V ψ hV hψ2 hDinj
  obtain ⟨a₀, ha₀⟩ := (isCompact_closedBall v₀ δ).exists_bound_of_continuousOn
    ((hQ.continuousOn_fderiv_of_isOpen hV le_rfl).mono hδV)
  obtain ⟨a, ha, hDQ⟩ : ∃ a : ℝ, 0 ≤ a ∧ ∀ v ∈ closedBall v₀ δ,
      ‖fderiv ℝ (fun v => (fderiv ℝ ψ v).range.starProjection) v‖ ≤ a :=
    ⟨max a₀ 0, le_max_right _ _, fun v hv => (ha₀ v hv).trans (le_max_left _ _)⟩
  -- Step 4: `|w| ≤ b|Dψ(v)w|` for `v ∈ B̄_δ(v₀)`
  obtain ⟨b, hb, hDψ⟩ := Submission.dor_lmb_ret_uniform_injectivity P d (closedBall v₀ δ)
    (fderiv ℝ ψ) (isCompact_closedBall v₀ δ)
    ((hψ2.continuousOn_fderiv_of_isOpen hV one_le_two).mono hδV) fun v hv => hDinj v (hδV hv)
  have hab : 0 ≤ a * b := mul_nonneg ha hb
  -- Step 5: `r ≤ r'` with `B̄_r(y) ⊆ U` and `2abr ≤ 1`
  obtain ⟨ε, hε, hεU⟩ := Metric.isOpen_iff.mp hU (ψ v₀) hy.2
  obtain ⟨r, hr, hrr', hrε, hrab⟩ : ∃ r : ℝ, 0 < r ∧ r ≤ r' ∧ r ≤ ε / 2 ∧
      r ≤ 1 / (2 * (a * b) + 1) :=
    ⟨min (min r' (ε / 2)) (1 / (2 * (a * b) + 1)),
      lt_min (lt_min hr' (half_pos hε)) (one_div_pos.mpr (by linarith)),
      (min_le_left _ _).trans (min_le_left _ _), (min_le_left _ _).trans (min_le_right _ _),
      min_le_right _ _⟩
  have hball : ball (ψ v₀) r ⊆ ball (ψ v₀) r' := ball_subset_ball hrr'
  refine ⟨r, 2 * (a * b), ψ ∘ g, hr, mul_nonneg zero_le_two hab,
    (closedBall_subset_ball (by linarith)).trans hεU, hπ.mono hball, fun x hx => ?_,
    fun x hx => hfix x ⟨hx.1, hball hx.2⟩, fun x hx v hv => ?_, fun x hx => ?_⟩
  · -- Step 6: `π(B_r(y)) ⊆ ψ(V) ⊆ N`
    have h : ψ (g x) ∈ ψ '' V := mem_image_of_mem ψ (hgV (hball hx))
    rw [himg] at h
    exact h.2
  · -- Step 7: `π` fixes `N ∩ B_r(y)`, so `Dπ(x)v = v` for `v ∈ T_xN`
    exact Submission.dor_lmb_ret_fderiv_tangent_eq P N (ball (ψ v₀) r) (ψ ∘ g) x isOpen_ball hx.2
      ((hπ.contDiffAt (isOpen_ball.mem_nhds (hball hx.2))).differentiableAt one_ne_zero)
      (fun z hz => hfix z ⟨hz.1, hball hz.2⟩) v hv
  · -- Step 8: differentiate `P̂(g z)(z − π(z)) = 0`; here `|x − π(x)| ≤ |x − y| < r`
    have hx' := hball hx
    have hgx : g x ∈ closedBall v₀ δ := ball_subset_closedBall (hgδ hx')
    have hxπ : ‖x - ψ (g x)‖ ≤ dist x (ψ v₀) := by
      rw [dist_eq_norm]
      exact hnear x hx' (ψ v₀) hy.1
    have hsmall : a * b * ‖x - ψ (g x)‖ ≤ 1 / 2 := by
      have h2ab : 0 < 2 * (a * b) + 1 := by linarith
      calc a * b * ‖x - ψ (g x)‖ ≤ a * b * (1 / (2 * (a * b) + 1)) :=
            mul_le_mul_of_nonneg_left (hxπ.trans ((mem_ball.mp hx).le.trans hrab)) hab
        _ ≤ 1 / 2 := by
          rw [mul_one_div, div_le_iff₀ h2ab]
          linarith
    have hcomp : ((fderiv ℝ ψ (g x)).range.starProjection).comp (fderiv ℝ ψ (g x)) =
        fderiv ℝ ψ (g x) := by
      refine ContinuousLinearMap.ext fun w => ?_
      rw [ContinuousLinearMap.comp_apply]
      exact Submodule.starProjection_eq_self_iff.mpr (LinearMap.mem_range_self _ w)
    have hest := Submission.dor_lmb_ret_derivative_estimate P d (ball (ψ v₀) r') g ψ
      (fun v => (fderiv ℝ ψ v).range.starProjection) x a b isOpen_ball hx'
      ((hg.contDiffAt (isOpen_ball.mem_nhds hx')).differentiableAt one_ne_zero)
      ((hψ2.contDiffAt (hV.mem_nhds (hδV hgx))).differentiableAt two_ne_zero)
      ((hQ.contDiffAt (hV.mem_nhds (hδV hgx))).differentiableAt one_ne_zero) hnormal hcomp
      (Submodule.starProjection_norm_le _) ha hb (hDQ _ hgx) (hDψ _ hgx) hsmall
    linarith [mul_le_mul_of_nonneg_left hxπ (mul_nonneg zero_le_two hab)]

/-- **Cut-off at a good level** (Simon 7.2.4, displays (3)–(7) and (10), chapter-07.txt lines
187–246, with the Lipschitz slicing function `f = |· − y|` of Simon Ch. 6, 4.5): let
`T − T' = ∂R + S` in `U` with `T, T', S, R` integer multiplicity, and `B̄_{ρ'}(y) ⊆ U`.  Then for
some `t ∈ (ρ, ρ')` there are an integer multiplicity cycle `X` (constructed as `∂(R⌞B_t(y))`)
vanishing on forms supported off `B̄_t(y)`, and a triple `RY` representing `Y = T' + X`, with
`μ_{RY}(B̄_t(y)) ≤ M_{B_{ρ'}(y)}(T) + M_{B_{ρ'}(y)}(S) + (2/(ρ' − ρ)) M_{B_{ρ'}(y)}(R)`.

Slice `R` by `|· − y|` and choose `t` so that the slice `P_t` is good, `μ_{T'}(∂B_t(y)) = 0` and
`M_{B_{ρ'}(y)}(P_t) ≤ 2 M_{B_{ρ'}(y)}(R)/(ρ' − ρ)`; put `X := (∂R)⌞B_t(y) + P_t`.  On `B_t(y)`,
`Y = T' + ∂R = T − S`; on `∂B_t(y)`, `μ_{RY} ≤ μ_{T'} + μ_{(∂R)⌞B_t(y)} + μ_{P_t}` and only the
last term charges the sphere. -/
theorem Submission.dor_lmb_good_level_cut : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P n : ℕ) (U : Set (Euclid P)) (T T' S : GeometricCurrentOn U n) (R : GeometricCurrentOn U (n + 1)) (y : Euclid P) (ρ ρ' : ℝ), IsOpen U → 0 < n → IsIntegerMultiplicity T → IsIntegerMultiplicity T' → IsIntegerMultiplicity S → IsIntegerMultiplicity R → (∀ ω : TestFormOn U n, T ω - T' ω = R.boundary ω + S ω) → 0 < ρ → ρ < ρ' → closedBall y ρ' ⊆ U → ∃ (t : ℝ) (X Y : GeometricCurrentOn U n) (RY : IMRep U n), ρ < t ∧ t < ρ' ∧ IsIntegerMultiplicity X ∧ BoundaryVanishes X ∧ (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (closedBall y t) → X ω = 0) ∧ (∀ ω : TestFormOn U n, Y ω = T' ω + X ω) ∧ RY.Represents Y ∧ RY.measure (closedBall y t) ≤ T.massOn (ball y ρ') + S.massOn (ball y ρ') + ENNReal.ofReal (2 / (ρ' - ρ)) * R.massOn (ball y ρ') := by
  intro hC1 P n U T T' S R y ρ ρ' hU _hn hTim hT'im hSim hRim hrel _hρ hρρ' hball
  -- Step 1(a): representations of `T`, `T'`, `S` and `R`
  obtain ⟨RT, hRT⟩ := hTim
  obtain ⟨RT', hRT'⟩ := hT'im
  obtain ⟨RS, hRS⟩ := hSim
  obtain ⟨RR, hRR⟩ := hRim
  -- Step 1(b): a representation of `T − T'`, then one of `∂R = (T − T') − S`
  have hsub : ∀ ω : TestFormOn U n, (T - T') ω = T ω - T' ω := fun ω => rfl
  obtain ⟨RD, hRD, -⟩ := Submission.dor_lmb_int_combination_imrep P n U T T' (T - T') RT RT'
    1 (-1) hU hRT hRT' fun ω => by
      rw [hsub ω]
      push_cast
      ring
  obtain ⟨RB, hRB, -⟩ := Submission.dor_lmb_int_combination_imrep P n U (T - T') S R.boundary
    RD RS 1 (-1) hU hRD hRS fun ω => by
      rw [hsub ω]
      push_cast
      linarith [hrel ω]
  -- Step 2: slice `R` by the 1-Lipschitz function `|· − y|`; `{|· − y| < t} = B_t(y)`
  obtain ⟨Ps, hPmass, hPae⟩ := Submission.dor_lmb_slicing_lipschitz hC1 P n U R RR RB
    (fun x => dist x y) 1 hU hRR hRB (LipschitzWith.dist_left y)
  -- Step 3: `μ_{T'}(B̄_{ρ'}(y)) < ∞`, as `B̄_{ρ'}(y)` is a compact subset of `U`
  have hT'fin : RT'.measure (closedBall y ρ') ≠ ∞ := by
    rw [IMRep.measure, withDensity_apply _ measurableSet_closedBall,
      Measure.restrict_restrict measurableSet_closedBall, inter_comm]
    exact RT'.locallyIntegrable_mult _ (isCompact_closedBall y ρ') hball
  -- Step 4: a level `t ∈ (ρ, ρ')` where the slice is good, `μ_{T'}(∂B_t(y)) = 0`, and
  -- `M_{B_{ρ'}(y)}(P_t) ≤ (2/(ρ' − ρ)) M_{B_{ρ'}(y)}(R)`
  have hPint : ∫⁻ s, (Ps s).massOn (ball y ρ') ≤ R.massOn (ball y ρ') := by
    simpa only [ENNReal.coe_one, one_mul] using (hPmass _ isOpen_ball).2
  obtain ⟨t, hρt, htρ', ⟨⟨RP, hRP⟩, -, hPt⟩, hsph, hPtmass⟩ :=
    Submission.dor_lmb_glc_good_radius P RT'.measure y ρ ρ' (fun s => (Ps s).massOn (ball y ρ'))
      (R.massOn (ball y ρ')) _ hρρ' hT'fin (hPmass _ isOpen_ball).1 hPint hPae
  -- Step 5: `D = (∂R)⌞B_t(y)`, represented by `RBt = (M_B ∩ B_t(y), θ_B, ξ_B)`
  obtain ⟨D, RBt, hRBt, hcar, hmult, hor, hmeas⟩ :=
    Submission.dor_lmb_imrep_restrict_current P n U (ball y t) RB hU measurableSet_ball
  have hD : ∀ ω : TestFormOn U n, D ω = ∫ x in RB.carrier ∩ ball y t,
      (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n] := by
    intro ω
    rw [hRBt ω, IMRep.action, hcar, hmult, hor]
  -- Step 6: the cut cycle `X = D + P_t`
  obtain ⟨X, hXDP, hXbd, hXoff, hXin⟩ :=
    Submission.dor_lmb_glc_cut_cycle P n U R RR RB D (Ps t) y t hRR hD hPt
  -- Step 6(c): `X` is integer multiplicity, with `μ_{RX} ≤ μ_{RB}⌞B_t(y) + μ_{RP}`
  obtain ⟨RX, hRX, hRXle⟩ := Submission.dor_lmb_int_combination_imrep P n U D (Ps t) X RBt RP
    1 1 hU hRBt hRP fun ω => by
      rw [hXDP ω]
      push_cast
      ring
  -- Step 7: `Y = T' + X`, with `μ_{RY} ≤ μ_{T'} + μ_{RX}`
  let Y : GeometricCurrentOn U n :=
    { toCurrent := T'.toCurrent + X.toCurrent
      continuous' := fun ωs h => by
        simpa using (T'.continuous' ωs h).add (X.continuous' ωs h) }
  have hY : ∀ ω : TestFormOn U n, Y ω = T' ω + X ω := fun ω => rfl
  obtain ⟨RY, hRY, hRYle⟩ := Submission.dor_lmb_int_combination_imrep P n U T' X Y RT' RX
    1 1 hU hRT' hRX fun ω => by
      rw [hY ω]
      push_cast
      ring
  -- Step 8: on `B_t(y)`, `Y = T' + ∂R = T − S`, so `μ_{RY}(B_t(y)) = M_{B_t(y)}(Y)` is at most
  -- `M_{B_{ρ'}(y)}(T) + M_{B_{ρ'}(y)}(S)`
  have hYin : ∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ ball y t →
      Y ω = T ω - S ω := by
    intro ω hω
    rw [hY ω, hXin ω hω]
    linarith [hrel ω]
  have hBt : RY.measure (ball y t) ≤ T.massOn (ball y ρ') + S.massOn (ball y ρ') := by
    rw [← (hC1 P n U Y RY hU hRY).1 _ isOpen_ball]
    calc Y.massOn (ball y t) ≤ T.massOn (ball y t) + S.massOn (ball y t) :=
          Submission.dor_lmb_glc_massOn_sub_le P n U (ball y t) T S Y hYin
      _ ≤ T.massOn (ball y ρ') + S.massOn (ball y ρ') :=
          add_le_add (T.massOn_mono (ball_subset_ball htρ'.le))
            (S.massOn_mono (ball_subset_ball htρ'.le))
  -- Step 9: on `∂B_t(y)`, only `μ_{RP}` can charge the sphere, and
  -- `μ_{RP}(∂B_t(y)) ≤ μ_{RP}(B_{ρ'}(y)) = M_{B_{ρ'}(y)}(P_t)`
  have hSt : RY.measure (sphere y t) ≤
      ENNReal.ofReal (2 / (ρ' - ρ)) * R.massOn (ball y ρ') := by
    have hY3 : RY.measure (sphere y t) ≤
        RT'.measure (sphere y t) + (RBt.measure (sphere y t) + RP.measure (sphere y t)) := by
      have h1 := Measure.le_iff'.1 hRYle (sphere y t)
      have h2 := Measure.le_iff'.1 hRXle (sphere y t)
      simp only [Int.natAbs_one, Nat.cast_one, one_smul, Measure.coe_add, Pi.add_apply] at h1 h2
      exact h1.trans (add_le_add le_rfl h2)
    have hRBt0 : RBt.measure (sphere y t) = 0 := by
      rw [hmeas, Measure.restrict_apply isClosed_sphere.measurableSet,
        sphere_disjoint_ball.inter_eq, measure_empty]
    calc RY.measure (sphere y t)
        ≤ RT'.measure (sphere y t) + (RBt.measure (sphere y t) + RP.measure (sphere y t)) := hY3
      _ = RP.measure (sphere y t) := by rw [hsph, hRBt0, zero_add, zero_add]
      _ ≤ RP.measure (ball y ρ') :=
          measure_mono (sphere_subset_closedBall.trans (closedBall_subset_ball htρ'))
      _ = (Ps t).massOn (ball y ρ') := ((hC1 P n U (Ps t) RP hU hRP).1 _ isOpen_ball).symm
      _ ≤ ENNReal.ofReal (2 / (ρ' - ρ)) * R.massOn (ball y ρ') := hPtmass
  -- Step 10: `B̄_t(y) = B_t(y) ∪ ∂B_t(y)`
  refine ⟨t, X, Y, RY, hρt, htρ', ⟨RX, hRX⟩, hXbd, hXoff, hY, hRY, ?_⟩
  calc RY.measure (closedBall y t) = RY.measure (ball y t ∪ sphere y t) := by
        rw [ball_union_sphere]
    _ ≤ RY.measure (ball y t) + RY.measure (sphere y t) := measure_union_le _ _
    _ ≤ T.massOn (ball y ρ') + S.massOn (ball y ρ') +
          ENNReal.ofReal (2 / (ρ' - ρ)) * R.massOn (ball y ρ') := add_le_add hBt hSt

/-- **Comparison with the projected competitor** (Simon 7.2.4, proof of (8)–(9),
chapter-07.txt lines 222–246, with the competitor projected into `N` by `π`; README erratum 5,
`Nᵢ = N`).  Assume (C1): `M_W(T) = μ_R(W)` for open `W` and `spt T = U ∩ spt μ_R` whenever `R`
represents `T`.  Put `F = B̄_t(y)`, `G = B_{3ρ}(y)`, `Λ = 1 + 3cρ`; if `t < 0` then `F = ∅`.
1. `π(y) = y`, and the mean value inequality with `‖Dπ‖ ≤ 1 + ct` on `F` gives
   `|π(x) − y| ≤ (1 + ct)t < 3ρ` on `F` (as `4cρ ≤ 1`), so `π(F) ⊆ (U ∩ N) ∩ G`.
2. By (C1), `X = 0` off `F` gives `Hⁿ(M_X \ F) = 0`, and `spt Z ⊆ N` gives `Hⁿ(M_Z \ N) = 0`.
3. `π(x) = x` and `ξ_Z(x)(α ∘ Dπ(x)) = ξ_Z(x)(α)` for `Hⁿ`-a.e. `x ∈ M_Z ∩ G` (`fix_orient`).
4. `Q_π = π_#X` is an integer multiplicity cycle with compact support in `π(F)` (`pf_current`,
   `pf_integer`, `pf_boundary`).
5. `Z' = Z + Q_π` is integer multiplicity (`int_combination`), `∂Z' = ∂Z` and
   `spt(Z' − Z) = spt Q_π`, so minimality of `Z` in `U ∩ N` gives `M_G(Z) ≤ M_G(Z')`.
6. `M_G(Z') ≤ Λⁿ μ_Y(G)` (`competitor_mass`), hence `μ_Z(G) ≤ Λⁿ μ_Y(G)` by (C1).
7. `Y = Z` on the open set `G \ F`, so `μ_Y(G \ F) = μ_Z(G \ F) < ∞`.  Splitting
   `G = F ∪ (G \ F)` and cancelling `μ_Z(G \ F)` gives
   `μ_Z(F) ≤ Λⁿ μ_Y(F) + (Λⁿ − 1) μ_Z(G \ F) ≤ Λⁿ μ_Y(F) + (Λⁿ − 1) μ_Z(G)`. -/
theorem Submission.dor_lmb_projected_competitor_comparison : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P d n : ℕ) (U N : Set (Euclid P)) (Z X Y : GeometricCurrentOn U n) (RZ RY : IMRep U n) (proj : Euclid P → Euclid P) (y : Euclid P) (r c ρ t : ℝ), IsOpen U → 0 < n → IsEmbeddedSubmanifold 2 d N → IsMinimizingIn Z (U ∩ N) → Z.support ⊆ N → BoundaryVanishes Z → RZ.Represents Z → IsIntegerMultiplicity X → BoundaryVanishes X → (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (closedBall y t) → X ω = 0) → (∀ ω : TestFormOn U n, Y ω = Z ω + X ω) → RY.Represents Y → y ∈ N → 0 ≤ c → 0 < ρ → 3 * ρ < r → 4 * c * ρ ≤ 1 → t < 2 * ρ → closedBall y (3 * ρ) ⊆ U → ContDiffOn ℝ 1 proj (ball y r) → MapsTo proj (ball y r) N → (∀ x ∈ N ∩ ball y r, proj x = x) → (∀ x ∈ N ∩ ball y r, ∀ v ∈ tangentSpace N x, fderiv ℝ proj x v = v) → (∀ x ∈ ball y r, ‖fderiv ℝ proj x‖ ≤ 1 + c * dist x y) → RZ.measure (closedBall y t) ≤ ENNReal.ofReal ((1 + 3 * c * ρ) ^ n) * RY.measure (closedBall y t) + ENNReal.ofReal ((1 + 3 * c * ρ) ^ n - 1) * RZ.measure (ball y (3 * ρ)) := by
  intro hC1 P d n U N Z X Y RZ RY proj y r c ρ t hU hn hN hZmin hZsupp _hZbd hRZ hXim hXbd hXvan
    hY hRY hyN hc hρ hρr hcρ ht hGU hproj hmaps hfix hdfix hnorm
  -- If `t < 0` then `F = B̄_t(y) = ∅`
  rcases lt_or_ge t 0 with ht0 | ht0
  · rw [closedBall_eq_empty.2 ht0, measure_empty]
    exact zero_le
  obtain ⟨RX, hRX⟩ := hXim
  -- `F ⊆ G ⊆ B_r(y)`, `G ⊆ U`, and `G ⊂⊂ U`
  have hFG : closedBall y t ⊆ ball y (3 * ρ) := closedBall_subset_ball (by linarith)
  have hGr : ball y (3 * ρ) ⊆ ball y r := ball_subset_ball hρr.le
  have hFr : closedBall y t ⊆ ball y r := hFG.trans hGr
  have hGU' : ball y (3 * ρ) ⊆ U := ball_subset_closedBall.trans hGU
  have hFU : closedBall y t ⊆ U := hFG.trans hGU'
  have hclG : closure (ball y (3 * ρ)) = closedBall y (3 * ρ) :=
    closure_ball y (by linarith : (0 : ℝ) < 3 * ρ).ne'
  have hGcc : CompactlyContained (ball y (3 * ρ)) U := by
    refine ⟨?_, ?_⟩ <;> rw [hclG]
    · exact isCompact_closedBall y _
    · exact hGU
  -- Step 1: `π(y) = y` and `|π(x) − y| ≤ (1 + ct)t < 3ρ` on `F`, so `π(F) ⊆ (U ∩ N) ∩ G`
  have hdiff : ∀ z ∈ ball y r, DifferentiableAt ℝ proj z := fun z hz =>
    (hproj.differentiableOn one_ne_zero).differentiableAt (isOpen_ball.mem_nhds hz)
  have hprojy : proj y = y := hfix y ⟨hyN, mem_ball_self (by linarith)⟩
  have hπF : ∀ x ∈ closedBall y t, proj x ∈ ball y (3 * ρ) := by
    intro x hx
    have hbound : ∀ z ∈ closedBall y t, ‖fderiv ℝ proj z‖ ≤ 1 + c * t := fun z hz =>
      (hnorm z (hFr hz)).trans
        (by nlinarith [mul_le_mul_of_nonneg_left (mem_closedBall.1 hz) hc])
    have hmvt := (convex_closedBall y t).norm_image_sub_le_of_norm_fderiv_le
      (fun z hz => hdiff z (hFr hz)) hbound (mem_closedBall_self ht0) hx
    have hxy : ‖x - y‖ ≤ t := by
      rw [← dist_eq_norm]
      exact mem_closedBall.1 hx
    rw [mem_ball, dist_eq_norm]
    calc ‖proj x - y‖ = ‖proj x - proj y‖ := by rw [hprojy]
      _ ≤ (1 + c * t) * ‖x - y‖ := hmvt
      _ ≤ (1 + c * t) * t := mul_le_mul_of_nonneg_left hxy (by nlinarith)
      _ < 3 * ρ := by
        nlinarith [mul_nonneg (mul_nonneg hc ht0) (by linarith : (0 : ℝ) ≤ 2 * ρ - t),
          mul_nonneg ht0 (by linarith : (0 : ℝ) ≤ 1 - 4 * c * ρ)]
  have hπFG : proj '' closedBall y t ⊆ ball y (3 * ρ) := by
    rintro _ ⟨x, hx, rfl⟩
    exact hπF x hx
  have hπFU : proj '' closedBall y t ⊆ U := hπFG.trans hGU'
  have hπFN : proj '' closedBall y t ⊆ N := by
    rintro _ ⟨x, hx, rfl⟩
    exact hmaps (hFr hx)
  -- `Hⁿ(M ∩ S) ≤ μ_R(S)` for Borel `S`, since `θ ≥ 1` on `M`
  have hcarrier_le : ∀ (R : IMRep U n) (S : Set (Euclid P)), MeasurableSet S →
      μHE[n] (R.carrier ∩ S) ≤ R.measure S := by
    intro R S hS
    rw [IMRep.measure, withDensity_apply _ hS, Measure.restrict_restrict hS]
    calc μHE[n] (R.carrier ∩ S) = ∫⁻ _ in S ∩ R.carrier, (1 : ℝ≥0∞) ∂μHE[n] := by
          rw [setLIntegral_one, inter_comm]
      _ ≤ ∫⁻ x in S ∩ R.carrier, (R.mult x : ℝ≥0∞) ∂μHE[n] :=
          setLIntegral_mono' (hS.inter R.measurableSet_carrier) fun x hx =>
            Nat.one_le_cast.2 (R.mult_pos x hx.2)
  -- `μ_R(K) < ∞` for compact `K ⊆ U`
  have hfin : ∀ (R : IMRep U n) (K : Set (Euclid P)), IsCompact K → K ⊆ U → R.measure K ≠ ∞ := by
    intro R K hK hKU
    rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
      Measure.restrict_restrict hK.measurableSet, inter_comm]
    exact R.locallyIntegrable_mult K hK hKU
  -- Step 2(a): by (C1), `μ_X(U \ F) = M_{U \ F}(X) = 0`, so `Hⁿ(M_X \ F) = 0`
  have hXF : μHE[n] (RX.carrier \ closedBall y t) = 0 := by
    have hopen : IsOpen (U \ closedBall y t) := hU.sdiff isClosed_closedBall
    have hmass : X.massOn (U \ closedBall y t) = 0 := by
      refine le_antisymm (sSup_le ?_) zero_le
      rintro _ ⟨ω, hω, rfl⟩
      show ENNReal.ofReal (X ω) ≤ 0
      rw [hXvan ω (Disjoint.mono_left hω.1 Set.disjoint_sdiff_left), ENNReal.ofReal_zero]
    have hmeas : RX.measure (U \ closedBall y t) = 0 := by
      rw [← (hC1 P n U X RX hU hRX).1 _ hopen, hmass]
    have hsub : RX.carrier \ closedBall y t ⊆ RX.carrier ∩ (U \ closedBall y t) :=
      fun x hx => ⟨hx.1, RX.carrier_subset hx.1, hx.2⟩
    refine measure_mono_null hsub (le_antisymm ?_ zero_le)
    exact (hcarrier_le RX _ hopen.measurableSet).trans hmeas.le
  -- Step 2(b): by (C1), `U ∩ spt μ_Z = spt Z ⊆ N`, so `Hⁿ(M_Z \ N) = 0`
  have hZN : μHE[n] (RZ.carrier \ N) = 0 := by
    have hsupp := (hC1 P n U Z RZ hU hRZ).2
    have hsub : RZ.carrier \ N ⊆ RZ.carrier ∩ RZ.measure.supportᶜ := by
      intro x hx
      refine ⟨hx.1, fun hxs => hx.2 (hZsupp ?_)⟩
      rw [hsupp]
      exact ⟨RZ.carrier_subset hx.1, hxs⟩
    refine measure_mono_null hsub (le_antisymm ?_ zero_le)
    calc μHE[n] (RZ.carrier ∩ RZ.measure.supportᶜ) ≤ RZ.measure RZ.measure.supportᶜ :=
          hcarrier_le RZ _ Measure.isClosed_support.isOpen_compl.measurableSet
      _ = 0 := Measure.measure_compl_support
  -- Step 3 (`fix_orient`): `π` fixes `Z` on `G`
  have hN1 : IsEmbeddedSubmanifold 1 d N := by
    intro z hz
    obtain ⟨V, W, ψ, hV, hW, hzW, hψ, hinj, himg, hprop, hrank⟩ := hN z hz
    exact ⟨V, W, ψ, hV, hW, hzW, hψ.of_le (by exact_mod_cast (show (1 : ℕ) ≤ 2 by norm_num)),
      hinj, himg, hprop, hrank⟩
  have hfixZ := Submission.dor_lmb_pc_imrep_orient_fixed_by_retraction P n d U N (ball y (3 * ρ))
    RZ proj hN1 isOpen_ball.measurableSet hZN (fun x hx => hfix x ⟨hx.1, hGr hx.2⟩)
    (fun x hx v hv => hdfix x ⟨hx.1, hGr hx.2⟩ v hv)
  -- Step 4 (`pf_current`, `pf_integer`, `pf_boundary`): the projected cycle `Q_π = π_#X`
  obtain ⟨Q, hQ, hQcpt, hQsupp⟩ := Submission.dor_lmb_pc_pushforward_current_exists P n U
    (closedBall y t) (ball y r) RX proj hU (isCompact_closedBall y t) hFU hXF isOpen_ball hFr hproj
    hπFU
  have hQim : IsIntegerMultiplicity Q :=
    Submission.dor_lmb_pc_pushforward_isIntegerMultiplicity
      Submission.dor_lmb_approx_tangent_locality P n U (closedBall y t) (ball y r) RX proj Q hU hn
      (isCompact_closedBall y t) hFU hXF isOpen_ball hFr hproj hπFU hQ
  have hQbd : BoundaryVanishes Q :=
    Submission.dor_lmb_pc_pushforward_boundaryVanishes P n U (closedBall y t) (ball y r) RX proj X Q
      hU (isCompact_closedBall y t) hFU hXF isOpen_ball hFr hproj hRX hXbd hQ
  -- Step 5: the competitor `Z' = Z + Q_π`
  obtain ⟨Z', hZ'⟩ : ∃ Z' : GeometricCurrentOn U n, ∀ ω, Z' ω = Z ω + Q ω :=
    ⟨{ toCurrent := Z.toCurrent + Q.toCurrent
       continuous' := fun ωs h => by
         simpa using (Z.continuous' ωs h).add (Q.continuous' ωs h) }, fun ω => rfl⟩
  -- (a) `Z'` is integer multiplicity (`int_combination` with `p₁ = p₂ = 1`)
  obtain ⟨RQ, hRQ⟩ := hQim
  obtain ⟨RZ', hRZ', -⟩ := Submission.dor_lmb_int_combination_imrep P n U Z Q Z' RZ RQ 1 1 hU hRZ
    hRQ fun ω => by rw [hZ' ω]; push_cast; ring
  -- (b) `∂Z' = ∂Z`, as `∂Q_π = 0`
  have hSB : SameBoundary Z' Z := by
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
    have hQ0 : Q.boundary = 0 := hQbd
    show Z'.boundary = Z.boundary
    ext η
    have h0 : Q (exteriorDerivativeTestOn U m η) = 0 := by
      rw [← GeometricCurrentOn.boundary_apply, hQ0, GeometricCurrentOn.zero_apply]
    rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.boundary_apply, hZ', h0, add_zero]
  -- (c) `Z' − Z = Q_π`, with compact support in `π(F) ⊆ (U ∩ N) ∩ G`
  have hZ'Z : Z' - Z = Q := by
    ext ω
    show Z' ω - Z ω = Q ω
    rw [hZ' ω]
    ring
  -- (d) minimality of `Z` in `U ∩ N`, tested on `W = G`
  have hmin : Z.massOn (ball y (3 * ρ)) ≤ Z'.massOn (ball y (3 * ρ)) := by
    refine hZmin.2 (ball y (3 * ρ)) Z' isOpen_ball hGcc ⟨RZ', hRZ'⟩ hSB ?_ ?_
    · rw [hZ'Z]
      exact hQcpt
    · rw [hZ'Z]
      intro z hz
      have hz' := hQsupp hz
      exact ⟨⟨hπFU hz', hπFN hz'⟩, hπFG hz'⟩
  -- Step 6 (`competitor_mass`): `M_G(Z') ≤ Λⁿ μ_Y(G)`, so `μ_Z(G) ≤ Λⁿ μ_Y(G)` by (C1)
  have hmass := Submission.dor_lmb_pc_competitor_massOn_le P n U (ball y (3 * ρ)) (ball y r) RZ RX
    RY Y Z' proj (1 + 3 * c * ρ) hU isOpen_ball hGcc isOpen_ball hGr hproj
    (by nlinarith [mul_nonneg hc hρ.le])
    (fun x hx => (hnorm x (hGr hx)).trans
      (by nlinarith [mul_le_mul_of_nonneg_left (mem_ball.1 hx).le hc]))
    hRY (fun ω => by rw [hY ω, hRZ ω, hRX ω]) hfixZ
    (measure_mono_null (sdiff_subset_sdiff_right hFG) hXF) (fun ω => by rw [hZ' ω, hRZ ω, hQ ω])
  have hmain : RZ.measure (ball y (3 * ρ)) ≤
      ENNReal.ofReal ((1 + 3 * c * ρ) ^ n) * RY.measure (ball y (3 * ρ)) := by
    rw [← (hC1 P n U Z RZ hU hRZ).1 (ball y (3 * ρ)) isOpen_ball]
    exact hmin.trans hmass
  -- Step 7: `Y = Z` on forms supported in the open set `G \ F`, so `μ_Y(G \ F) = μ_Z(G \ F)`
  have hGFopen : IsOpen (ball y (3 * ρ) \ closedBall y t) := isOpen_ball.sdiff isClosed_closedBall
  have hYZ : RY.measure (ball y (3 * ρ) \ closedBall y t) =
      RZ.measure (ball y (3 * ρ) \ closedBall y t) := by
    rw [← (hC1 P n U Y RY hU hRY).1 _ hGFopen, ← (hC1 P n U Z RZ hU hRZ).1 _ hGFopen]
    unfold GeometricCurrentOn.massOn
    congr 1
    refine Set.image_congr fun ω hω => ?_
    show ENNReal.ofReal (Y ω) = ENNReal.ofReal (Z ω)
    rw [hY ω, hXvan ω (Disjoint.mono_left hω.1 Set.disjoint_sdiff_left), add_zero]
  -- split `G = F ∪ (G \ F)` and cancel the finite `μ_Z(G \ F)`
  have hFm : MeasurableSet (closedBall y t) := measurableSet_closedBall
  have hZsplit := measure_inter_add_sdiff (μ := RZ.measure) (ball y (3 * ρ)) hFm
  have hYsplit := measure_inter_add_sdiff (μ := RY.measure) (ball y (3 * ρ)) hFm
  rw [inter_eq_right.2 hFG] at hZsplit hYsplit
  have hbfin : RZ.measure (ball y (3 * ρ) \ closedBall y t) ≠ ∞ :=
    ne_top_of_le_ne_top (hfin RZ _ (isCompact_closedBall y (3 * ρ)) hGU)
      (measure_mono (sdiff_subset.trans ball_subset_closedBall))
  have hL : ENNReal.ofReal ((1 + 3 * c * ρ) ^ n) =
      ENNReal.ofReal ((1 + 3 * c * ρ) ^ n - 1) + 1 := by
    have h1 : (1 : ℝ) ≤ (1 + 3 * c * ρ) ^ n := one_le_pow₀ (by nlinarith [mul_nonneg hc hρ.le])
    rw [← ENNReal.ofReal_one, ← ENNReal.ofReal_add (sub_nonneg.2 h1) zero_le_one, sub_add_cancel]
  have hLb : ENNReal.ofReal ((1 + 3 * c * ρ) ^ n) * RZ.measure (ball y (3 * ρ) \ closedBall y t) =
      ENNReal.ofReal ((1 + 3 * c * ρ) ^ n - 1) * RZ.measure (ball y (3 * ρ) \ closedBall y t) +
        RZ.measure (ball y (3 * ρ) \ closedBall y t) := by
    rw [hL, add_mul, one_mul]
  have key : RZ.measure (closedBall y t) + RZ.measure (ball y (3 * ρ) \ closedBall y t) ≤
      (ENNReal.ofReal ((1 + 3 * c * ρ) ^ n) * RY.measure (closedBall y t) +
        ENNReal.ofReal ((1 + 3 * c * ρ) ^ n - 1) * RZ.measure (ball y (3 * ρ) \ closedBall y t)) +
      RZ.measure (ball y (3 * ρ) \ closedBall y t) := by
    calc RZ.measure (closedBall y t) + RZ.measure (ball y (3 * ρ) \ closedBall y t)
        = RZ.measure (ball y (3 * ρ)) := hZsplit
      _ ≤ ENNReal.ofReal ((1 + 3 * c * ρ) ^ n) * RY.measure (ball y (3 * ρ)) := hmain
      _ = ENNReal.ofReal ((1 + 3 * c * ρ) ^ n) * RY.measure (closedBall y t) +
          ENNReal.ofReal ((1 + 3 * c * ρ) ^ n) * RZ.measure (ball y (3 * ρ) \ closedBall y t) := by
        rw [← hYsplit, hYZ, mul_add]
      _ = _ := by rw [hLb, add_assoc]
  calc RZ.measure (closedBall y t)
      ≤ ENNReal.ofReal ((1 + 3 * c * ρ) ^ n) * RY.measure (closedBall y t) +
        ENNReal.ofReal ((1 + 3 * c * ρ) ^ n - 1) * RZ.measure (ball y (3 * ρ) \ closedBall y t) :=
        ENNReal.le_of_add_le_add_right hbfin key
    _ ≤ _ := by
        gcongr
        exact sdiff_subset
theorem Submission.dgcr_bwd_coordinate_form : ∀ (m : ℕ) (a : Euclid (m + 1) → ℝ) (j : Fin (m + 1)), ContDiff ℝ (⊤ : ℕ∞) a → ∃ ψ : DifferentialForm (Euclid (m + 1)) m, IsSmoothForm ψ ∧ tsupport ψ ⊆ tsupport a ∧ ∀ x : Euclid (m + 1), exteriorDerivative ψ x (fun i => EuclideanSpace.single i (1 : ℝ)) = fderiv ℝ a x (EuclideanSpace.single j (1 : ℝ)) := by
  intro m a j ha
  obtain ⟨β, hβ⟩ := Submission.dgcr_bwd_coordinate_covector m j
  refine ⟨fun y => a y • β, ha.smul contDiff_const, tsupport_smul_subset_left _ _, fun x => ?_⟩
  have hax : DifferentiableAt ℝ a x := (ha.differentiable (by simp)).differentiableAt
  rw [Submission.dgcr_bwd_extDeriv_smul_const (m + 1) m a β x _ hax, Finset.sum_eq_single j]
  · rw [hβ j, ite_eq_left rfl, ← mul_assoc, mul_comm ((-1 : ℝ) ^ (j : ℕ)), mul_assoc, ← pow_add,
      ← two_mul, pow_mul]
    simp
  · intro i _ hij
    rw [hβ i, ite_eq_right hij]
    simp
  · intro hj
    exact absurd (Finset.mem_univ j) hj
theorem Submission.dgcr_bwd_graph_pullback_extDeriv : ∀ (m k : ℕ) (ι : Euclid (m + 1) →ₗᵢ[ℝ] Euclid (m + 1 + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (m + 1 + k)) (u : Euclid (m + 1) → Euclid k) (z : Euclid (m + 1 + k)) (ψ : DifferentialForm (Euclid (m + 1)) m) (v : Euclid (m + 1)), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → IsSmoothForm ψ → DifferentiableAt ℝ u v → exteriorDerivative (affinePullbackForm (ContinuousLinearMap.adjoint ι.toContinuousLinearMap) (-(ContinuousLinearMap.adjoint ι.toContinuousLinearMap z)) ψ) (z + ι v + ι' (u v)) (fun i => fderiv ℝ (fun v => z + ι v + ι' (u v)) v (EuclideanSpace.single i (1 : ℝ))) = exteriorDerivative ψ v (fun i => EuclideanSpace.single i (1 : ℝ)) := by
  intro m k ι ι' u z ψ v hperp hψ hu
  -- `L := ι*` is a left inverse of `ι` and annihilates the orthogonal factor `ι'`.
  have hLι : ∀ v', ContinuousLinearMap.adjoint ι.toContinuousLinearMap (ι v') = v' := by
    intro v'
    apply ext_inner_right ℝ
    intro y
    rw [ContinuousLinearMap.adjoint_inner_left]
    exact ι.inner_map_map v' y
  have hLι' : ∀ w, ContinuousLinearMap.adjoint ι.toContinuousLinearMap (ι' w) = 0 := by
    intro w
    apply ext_inner_right ℝ
    intro y
    rw [ContinuousLinearMap.adjoint_inner_left, inner_zero_left, real_inner_comm]
    exact hperp y w
  -- Chain rule for the graph map `Φ v = z + ι v + ι' (u v)`.
  have hD : fderiv ℝ (fun v => z + ι v + ι' (u v)) v =
      ι.toContinuousLinearMap + ι'.toContinuousLinearMap.comp (fderiv ℝ u v) := by
    have hι : HasFDerivAt (fun v => ι v) ι.toContinuousLinearMap v :=
      ι.toContinuousLinearMap.hasFDerivAt
    have hι' : HasFDerivAt (fun v => ι' (u v)) (ι'.toContinuousLinearMap.comp (fderiv ℝ u v)) v :=
      ι'.toContinuousLinearMap.hasFDerivAt.comp v hu.hasFDerivAt
    have h1 := ((hasFDerivAt_const z v).add hι).add hι'
    rw [zero_add] at h1
    exact h1.fderiv
  -- `d` commutes with the affine pull-back; the base point is `v` and the frame is `eᵢ`.
  rw [exteriorDerivative_affinePullbackForm _ _ hψ]
  simp only [affinePullbackForm, ContinuousAlternatingMap.compContinuousLinearMap_apply]
  congr 1
  · simp [map_add, hLι, hLι']
  · funext i
    simp [hD, hLι, hLι']
/-- Cut-off lift of a form to the cylinder `C = {z + ιv + ι'w : v ∈ B_s(0), w ∈ B_h(0)}`: with
`L = ι*`, `Q = ι'*(· − z)` and the normal cut-off `η` of `u(spt ψ)` (`dgcr_bwd_normal_cutoff`),
`φ = (η ∘ Q) · P^#ψ` is a test form in `U` supported in `C` that agrees with
`P^#ψ = affinePullbackForm L (−Lz) ψ` near every graph point `z + ιv + ι'u(v)`, `v ∈ B_s(0)`. -/
theorem Submission.dgcr_bwd_graph_cutoff_lift : ∀ (m k : ℕ) (U : Set (Euclid (m + 1 + k))) (ι : Euclid (m + 1) →ₗᵢ[ℝ] Euclid (m + 1 + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (m + 1 + k)) (u : Euclid (m + 1) → Euclid k) (z : Euclid (m + 1 + k)) (s h : ℝ) (ψ : DifferentialForm (Euclid (m + 1)) m), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → (∀ x : Euclid (m + 1 + k), ∃ v : Euclid (m + 1), ∃ w : Euclid k, x = ι v + ι' w) → 0 < h → ContinuousOn u (ball 0 s) → (∀ v ∈ ball (0 : Euclid (m + 1)) s, u v ∈ ball (0 : Euclid k) h) → {x | ∃ v ∈ ball (0 : Euclid (m + 1)) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} ⊆ U → IsSmoothForm ψ → HasCompactSupport ψ → tsupport ψ ⊆ ball (0 : Euclid (m + 1)) s → ∃ φ : TestFormOn U m, tsupport (φ : DifferentialForm (Euclid (m + 1 + k)) m) ⊆ {x | ∃ v ∈ ball (0 : Euclid (m + 1)) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} ∧ ∀ v ∈ ball (0 : Euclid (m + 1)) s, (φ : DifferentialForm (Euclid (m + 1 + k)) m) =ᶠ[𝓝 (z + ι v + ι' (u v))] affinePullbackForm (ContinuousLinearMap.adjoint ι.toContinuousLinearMap) (-(ContinuousLinearMap.adjoint ι.toContinuousLinearMap z)) ψ := by
  intro m k U ι ι' u z s h ψ hperp hspan hh hu hmaps hCU hψs hψc hψsupp
  set L := ContinuousLinearMap.adjoint ι.toContinuousLinearMap with hL
  set L' := ContinuousLinearMap.adjoint ι'.toContinuousLinearMap with hL'
  -- Adjoint identities: `Lι = id`, `Lι' = 0`, `L'ι = 0`, `L'ι' = id`.
  have hLι : ∀ v', L (ι v') = v' := by
    intro v'
    apply ext_inner_right ℝ
    intro y
    rw [hL, ContinuousLinearMap.adjoint_inner_left]
    exact ι.inner_map_map v' y
  have hLι' : ∀ w, L (ι' w) = 0 := by
    intro w
    apply ext_inner_right ℝ
    intro y
    rw [hL, ContinuousLinearMap.adjoint_inner_left, inner_zero_left, real_inner_comm]
    exact hperp y w
  have hL'ι : ∀ v', L' (ι v') = 0 := by
    intro v'
    apply ext_inner_right ℝ
    intro y
    rw [hL', ContinuousLinearMap.adjoint_inner_left, inner_zero_left]
    exact hperp v' y
  have hL'ι' : ∀ w, L' (ι' w) = w := by
    intro w
    apply ext_inner_right ℝ
    intro y
    rw [hL', ContinuousLinearMap.adjoint_inner_left]
    exact ι'.inner_map_map w y
  -- Orthogonal decomposition `x = z + ι(L(x − z)) + ι'(L'(x − z))`.
  have hdec : ∀ x, z + ι (L (x - z)) + ι' (L' (x - z)) = x := by
    intro x
    obtain ⟨v₀, w₀, hx⟩ := hspan (x - z)
    have h1 : L (x - z) = v₀ := by rw [hx, map_add, hLι, hLι', add_zero]
    have h2 : L' (x - z) = w₀ := by rw [hx, map_add, hL'ι, hL'ι', zero_add]
    rw [h1, h2]
    calc z + ι v₀ + ι' w₀ = z + (ι v₀ + ι' w₀) := add_assoc _ _ _
      _ = z + (x - z) := by rw [hx]
      _ = x := add_sub_cancel z x
  -- Normal cut-off `η ≡ 1` near the compact set `u(spt ψ) ⊆ B_h(0)`.
  have hK : IsCompact (tsupport ψ) := hψc
  obtain ⟨η, hηs, hηc, hηsupp, hη1⟩ := Submission.dgcr_bwd_normal_cutoff k (u '' tsupport ψ) h hh
    (hK.image_of_continuousOn (hu.mono hψsupp))
    (by rintro _ ⟨v, hv, rfl⟩; exact hmaps v (hψsupp hv))
  have hPr : Continuous (fun x : Euclid (m + 1 + k) => L (x - z)) :=
    L.continuous.comp (continuous_id.sub continuous_const)
  have hQ : Continuous (fun x : Euclid (m + 1 + k) => L' (x - z)) :=
    L'.continuous.comp (continuous_id.sub continuous_const)
  have hPapply : ∀ x, affinePullbackForm L (-(L z)) ψ x = (ψ (L (x - z))).compContinuousLinearMap L := by
    intro x
    simp only [affinePullbackForm, map_sub, neg_add_eq_sub]
  -- The test form `φ = (η ∘ Q) · P^#ψ`.
  let φ : DifferentialForm (Euclid (m + 1 + k)) m :=
    fun x => η (L' (x - z)) • affinePullbackForm L (-(L z)) ψ x
  have hφs : IsSmoothForm φ := by
    have hηQ : ContDiff ℝ (⊤ : ℕ∞) (fun x : Euclid (m + 1 + k) => η (L' (x - z))) :=
      hηs.comp (L'.contDiff.comp (contDiff_id.sub contDiff_const))
    exact hηQ.smul (affinePullbackForm_isSmoothForm L (-(L z)) hψs)
  -- Support: `spt φ ⊆ F(spt ψ × spt η) ⊆ C`, where `F(v, w) = z + ιv + ι'w`.
  let F : Euclid (m + 1) × Euclid k → Euclid (m + 1 + k) := fun p => z + ι p.1 + ι' p.2
  have hF : Continuous F := by
    have h1 : Continuous (fun p : Euclid (m + 1) × Euclid k => ι p.1) := ι.continuous.comp continuous_fst
    have h2 : Continuous (fun p : Euclid (m + 1) × Euclid k => ι' p.2) := ι'.continuous.comp continuous_snd
    exact (continuous_const.add h1).add h2
  have hS : IsClosed {x : Euclid (m + 1 + k) | L (x - z) ∈ tsupport ψ ∧ L' (x - z) ∈ tsupport η} :=
    ((isClosed_tsupport ψ).preimage hPr).inter ((isClosed_tsupport η).preimage hQ)
  have hsuppS : support φ ⊆ {x | L (x - z) ∈ tsupport ψ ∧ L' (x - z) ∈ tsupport η} := by
    intro x hx
    by_contra hcon
    apply hx
    rcases not_and_or.mp hcon with h1 | h1
    · have h0 : ψ (L (x - z)) = 0 := image_eq_zero_of_notMem_tsupport h1
      have hP0 : affinePullbackForm L (-(L z)) ψ x = 0 := by
        rw [hPapply, h0]
        ext w
        simp
      show η (L' (x - z)) • affinePullbackForm L (-(L z)) ψ x = 0
      rw [hP0, smul_zero]
    · have h0 : η (L' (x - z)) = 0 := image_eq_zero_of_notMem_tsupport h1
      show η (L' (x - z)) • affinePullbackForm L (-(L z)) ψ x = 0
      rw [h0, zero_smul]
  have hsupp : tsupport φ ⊆ F '' (tsupport ψ ×ˢ tsupport η) := by
    refine (closure_minimal hsuppS hS).trans ?_
    rintro x ⟨hx1, hx2⟩
    exact ⟨(L (x - z), L' (x - z)), ⟨hx1, hx2⟩, hdec x⟩
  have hFC : F '' (tsupport ψ ×ˢ tsupport η) ⊆
      {x | ∃ v ∈ ball (0 : Euclid (m + 1)) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} := by
    rintro _ ⟨⟨v, w⟩, ⟨hv, hw⟩, rfl⟩
    exact ⟨v, hψsupp hv, w, hηsupp hw, rfl⟩
  have hcomp : IsCompact (F '' (tsupport ψ ×ˢ tsupport η)) := (hK.prod hηc).image hF
  refine ⟨⟨φ, ⟨hφs, hcomp.of_isClosed_subset (isClosed_tsupport _) hsupp⟩,
    (hsupp.trans hFC).trans hCU⟩, hsupp.trans hFC, ?_⟩
  -- Germ at a graph point: `η ∘ Q ≡ 1` there if `v ∈ spt ψ`, else `P^#ψ ≡ 0` there.
  intro v hv
  have hQv : L' (z + ι v + ι' (u v) - z) = u v := by
    rw [add_assoc z, add_sub_cancel_left, map_add, hL'ι, hL'ι', zero_add]
  have hPv : L (z + ι v + ι' (u v) - z) = v := by
    rw [add_assoc z, add_sub_cancel_left, map_add, hLι, hLι', add_zero]
  by_cases hvK : v ∈ tsupport ψ
  · have hev : ∀ᶠ y in 𝓝 (u v), η y = 1 := hη1 (u v) ⟨v, hvK, rfl⟩
    have hT := hQ.tendsto (z + ι v + ι' (u v))
    rw [hQv] at hT
    filter_upwards [hT.eventually hev] with x hx
    show η (L' (x - z)) • affinePullbackForm L (-(L z)) ψ x = affinePullbackForm L (-(L z)) ψ x
    rw [hx, one_smul]
  · have hopen : IsOpen {x : Euclid (m + 1 + k) | L (x - z) ∉ tsupport ψ} :=
      (isClosed_tsupport ψ).isOpen_compl.preimage hPr
    filter_upwards [hopen.mem_nhds (show L (z + ι v + ι' (u v) - z) ∉ tsupport ψ by rw [hPv]; exact hvK)] with x hx
    have h0 : ψ (L (x - z)) = 0 := image_eq_zero_of_notMem_tsupport hx
    have hP0 : affinePullbackForm L (-(L z)) ψ x = 0 := by
      rw [hPapply, h0]
      ext w
      simp
    show η (L' (x - z)) • affinePullbackForm L (-(L z)) ψ x = affinePullbackForm L (-(L z)) ψ x
    rw [hP0, smul_zero]

/-- Step 13 of the proof that an integer multiplicity cycle carried by a `C¹` graph is regular
(Simon 7.4.3, via Allard's theorem): if `∂T = 0` and `T` integrates forms supported in the cylinder
`C` over the graph `Φ(v) = z + ι v + ι' (u v)`, `v ∈ D = B_s(0)`, with density `G`, then `G` has
vanishing weak derivatives: `∫_D G ∂ⱼa = 0` for smooth `a` with compact support in `D`.  Write
`n = m + 1`.  The `m`-form `ψ = a • βⱼ` on `ℝⁿ` has `dψ(e₀, …, e_m) = ∂ⱼa`, and its cut-off lift
`φ ∈ 𝒟ᵐ(U)` is supported in `C` and equals `Pr^#ψ` near every graph point, so
`dφ(Φ(v))(DΦ(v)e) = dψ(v)(e) = ∂ⱼa(v)` on `D`.  Hence `0 = ∂T(φ) = T(dφ) = ∫_D G ∂ⱼa`. -/
theorem Submission.dgcr_graph_boundary_weak_derivatives : ∀ (n k : ℕ) (U : Set (Euclid (n + k))) (T : GeometricCurrentOn U n) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (u : Euclid n → Euclid k) (z : Euclid (n + k)) (s h : ℝ) (G : Euclid n → ℝ), 0 < n → BoundaryVanishes T → (∀ v w, inner ℝ (ι v) (ι' w) = 0) → 0 < s → 0 < h → ContDiffOn ℝ 1 u (ball 0 s) → (∀ v ∈ ball (0 : Euclid n) s, u v ∈ ball (0 : Euclid k) h) → {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} ⊆ U → (∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid (n + k)) n) ⊆ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} → T ω = ∫ v in ball (0 : Euclid n) s, G v * (ω : DifferentialForm (Euclid (n + k)) n) (z + ι v + ι' (u v)) (fun i => fderiv ℝ (fun v => z + ι v + ι' (u v)) v (EuclideanSpace.single i (1 : ℝ)))) → ∀ a : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) a → HasCompactSupport a → tsupport a ⊆ ball (0 : Euclid n) s → ∀ j : Fin n, ∫ v in ball (0 : Euclid n) s, G v * fderiv ℝ a v (EuclideanSpace.single j (1 : ℝ)) = 0 := by
  intro n k U T ι ι' u z s h G hn hT hperp hs hh hu hmaps hCU hrep a ha hac has j
  -- `n = m + 1`, so `∂T = 0` reads `T.boundary = 0`
  obtain ⟨m, rfl⟩ := Nat.exists_eq_add_one_of_ne_zero hn.ne'
  -- the `m`-form `ψ = a • βⱼ` on `ℝⁿ`: `spt ψ ⊆ spt a` and `dψ(x)(e₀, …, e_m) = ∂ⱼa(x)`
  obtain ⟨ψ, hψs, hψa, hψd⟩ := Submission.dgcr_bwd_coordinate_form m a j ha
  -- the test form `φ = (η ∘ Q) • Pr^#ψ ∈ 𝒟ᵐ(U)`: `spt φ ⊆ C` and `φ = Pr^#ψ` near each `Φ(v)`
  obtain ⟨φ, hφC, hφψ⟩ := Submission.dgcr_bwd_graph_cutoff_lift m k U ι ι' u z s h ψ hperp
    (Submission.dgcr_orthogonal_coordinates (m + 1) k ι ι' hperp).1 hh hu.continuousOn hmaps hCU
    hψs (hac.mono' ((subset_tsupport ψ).trans hψa)) (hψa.trans has)
  -- `T(dφ) = ∂T(φ) = 0`
  have hT0 : T (exteriorDerivativeTestOn U m φ) = 0 := by
    have hT' : T.boundary = 0 := hT
    rw [← GeometricCurrentOn.boundary_apply, hT', GeometricCurrentOn.zero_apply]
  -- `spt dφ ⊆ spt φ ⊆ C`, so `T(dφ)` is the graph integral of `dφ`
  rw [hrep _ ((tsupport_exteriorDerivative_subset
    (φ : DifferentialForm (Euclid (m + 1 + k)) m)).trans hφC)] at hT0
  refine Eq.trans ?_ hT0
  refine setIntegral_congr_fun measurableSet_ball fun v hv => ?_
  -- on `D`: `dφ(Φ(v))(DΦ(v)e) = d(Pr^#ψ)(Φ(v))(DΦ(v)e) = dψ(v)(e) = ∂ⱼa(v)`
  have hud : DifferentiableAt ℝ u v :=
    (hu.differentiableOn one_ne_zero).differentiableAt (isOpen_ball.mem_nhds hv)
  have hdφ : exteriorDerivative (φ : DifferentialForm (Euclid (m + 1 + k)) m) (z + ι v + ι' (u v)) =
      exteriorDerivative (affinePullbackForm (ContinuousLinearMap.adjoint ι.toContinuousLinearMap)
        (-(ContinuousLinearMap.adjoint ι.toContinuousLinearMap z)) ψ) (z + ι v + ι' (u v)) :=
    (hφψ v hv).extDeriv_eq
  change G v * fderiv ℝ a v (EuclideanSpace.single j (1 : ℝ)) =
    G v * exteriorDerivative (φ : DifferentialForm (Euclid (m + 1 + k)) m) (z + ι v + ι' (u v))
      (fun i => fderiv ℝ (fun v => z + ι v + ι' (u v)) v (EuclideanSpace.single i (1 : ℝ)))
  rw [hdφ, Submission.dgcr_bwd_graph_pullback_extDeriv m k ι ι' u z ψ v hperp hψs hud, hψd v]
/-- **Mollification approximates a `C¹_c` function in a directional derivative** (step 3 of the
extension from smooth to `C¹` tests in the graph-cycle regularity step of Simon 7.4.3).  For
`φ ∈ C¹_c(ℝⁿ)`, `δ > 0`, a direction `v` and `ε > 0` there is `ψ ∈ C^∞_c(ℝⁿ)` with `spt ψ` in the
closed `δ`-neighbourhood of `spt φ` and `|Dψ(x)v − Dφ(x)v| ≤ ε` for all `x`.  Take `r₀ > 0` with
`|∂ᵥφ(a) − ∂ᵥφ(b)| < ε` when `|a − b| < r₀` (`∂ᵥφ` is continuous with compact support), a
normalized mollifier `ρ` with `spt ρ ⊆ B_r(0)`, `r = min r₀ δ`, and `ψ = ρ ⋆ φ`; then
`∂ᵥψ = ρ ⋆ ∂ᵥφ`, which is within `ε` of `∂ᵥφ`. -/
theorem Submission.dgcr_stc_mollify_C1_fderiv_approx : ∀ (n : ℕ) (φ : Euclid n → ℝ), ContDiff ℝ 1 φ → HasCompactSupport φ → ∀ (δ : ℝ), 0 < δ → ∀ (v : Euclid n) (ε : ℝ), 0 < ε → ∃ ψ : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) ψ ∧ HasCompactSupport ψ ∧ tsupport ψ ⊆ cthickening δ (tsupport φ) ∧ ∀ x, |fderiv ℝ ψ x v - fderiv ℝ φ x v| ≤ ε := by
  intro n φ hφ hφc δ hδ v ε hε
  -- `∂ᵥφ = Dφ(·) v` is continuous with compact support, hence uniformly continuous: it varies by
  -- less than `ε` on balls of radius `r₀`
  have hDφ : Continuous (fderiv ℝ φ) := hφ.continuous_fderiv one_ne_zero
  have hDφc : HasCompactSupport (fderiv ℝ φ) := hφc.fderiv ℝ
  have hg : Continuous fun x => fderiv ℝ φ x v := hDφ.clm_apply continuous_const
  have hgc : HasCompactSupport fun x => fderiv ℝ φ x v :=
    hDφc.comp_left (g := fun A : Euclid n →L[ℝ] ℝ => A v) rfl
  obtain ⟨r₀, hr₀, hr₀g⟩ :=
    Metric.uniformContinuous_iff.mp (hgc.uniformContinuous_of_continuous hg) ε hε
  -- a normalized mollifier `ρ` with `spt ρ ⊆ B_r(0)`, `r = min r₀ δ`; `ψ = ρ ⋆ φ`
  obtain ⟨ρ, hρ, hρc, hρ0, hρ1, hρs⟩ :=
    Submission.dgcr_stc_exists_normalized_mollifier n (min r₀ δ) (lt_min hr₀ hδ)
  have hρi : LocallyIntegrable ρ volume := hρ.continuous.locallyIntegrable
  let L := ContinuousLinearMap.lsmul ℝ ℝ (E := ℝ)
  -- `spt ψ ⊆ spt ρ + spt φ ⊆ B_r(0) + spt φ`, inside the closed set `cthickening δ (spt φ)`
  have hsupp : tsupport (convolution ρ φ L volume) ⊆ cthickening δ (tsupport φ) := by
    refine closure_minimal (fun z hz => ?_) isClosed_cthickening
    obtain ⟨a, ha, b, hb, rfl⟩ := Set.mem_add.mp (support_convolution_subset L hz)
    refine mem_cthickening_of_dist_le _ b δ _ (subset_tsupport φ hb) ?_
    rw [dist_eq_norm, add_sub_cancel_right]
    exact (mem_ball_zero_iff.mp (hρs ha)).le.trans (min_le_right r₀ δ)
  -- `ψ` is smooth, and compactly supported as `cthickening δ (spt φ)` is compact
  refine ⟨convolution ρ φ L volume,
    hρc.contDiff_convolution_left L hρ hφ.continuous.locallyIntegrable,
    (IsCompact.cthickening hφc).of_isClosed_subset (isClosed_tsupport _) hsupp, hsupp, fun x => ?_⟩
  -- `Dψ(x) v = (ρ ⋆ ∂ᵥφ)(x)`
  rw [(hφc.hasFDerivAt_convolution_right L hρi hφ x).fderiv,
    convolution_precompR_apply L hρi hDφc hDφ x v, ← Real.dist_eq]
  -- `ρ ≥ 0`, `∫ ρ = 1`, `spt ρ ⊆ B_r(0)` and `|∂ᵥφ(y) − ∂ᵥφ(x)| < ε` on `B_r(x)`
  exact dist_convolution_le hε.le hρs hρ0 hρ1 hg.aestronglyMeasurable fun y hy =>
    (hr₀g ((mem_ball.mp hy).trans_le (min_le_left r₀ δ))).le

/-- Step 14 of the proof that an integer multiplicity cycle carried by a `C¹` graph is regular
(Simon 7.4.3, via Allard's theorem): weak derivatives tested against `C^∞` functions may be
tested against `C¹` functions.  If `∫_D G ∂ⱼa = 0` for every `a ∈ C_c^∞(D)`, then `∫ G ∂ᵢφ = 0`
for every `φ ∈ C_c¹(D)`.  On the compact set `K = cthickening δ (spt φ) ⊆ D`, `G` is integrable
and `∂ᵢφ` is bounded.  The mollified tests `ψ` satisfy `spt ψ ⊆ K` and `|∂ᵢψ − ∂ᵢφ| ≤ ε`, so
`∫_K G ∂ᵢφ = 0` in the limit; every integrand vanishes off `K`. -/
theorem Submission.dgcr_smooth_tests_to_C1_tests : ∀ (n : ℕ) (D : Set (Euclid n)) (G : Euclid n → ℝ), IsOpen D → LocallyIntegrableOn G D volume → (∀ a : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) a → HasCompactSupport a → tsupport a ⊆ D → ∀ j : Fin n, ∫ v in D, G v * fderiv ℝ a v (EuclideanSpace.single j (1 : ℝ)) = 0) → ∀ φ : Euclid n → ℝ, ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∀ i : Fin n, ∫ x, G x * fderiv ℝ φ x ((EuclideanSpace.basisFun (Fin n) ℝ) i) = 0 := by
  intro n D G hD hG htest φ hφ hφc hφD i
  rw [EuclideanSpace.basisFun_apply]
  -- step 1: `K = cthickening δ (tsupport φ) ⊆ D` is compact and `G` is integrable on `K`
  obtain ⟨δ, hδ, hKD⟩ := hφc.isCompact.exists_cthickening_subset_open hD hφD
  have hK : IsCompact (cthickening δ (tsupport φ)) := hφc.isCompact.cthickening
  have hGK : IntegrableOn G (cthickening δ (tsupport φ)) volume :=
    hG.integrableOn_compact_subset hKD hK
  -- `G ∂ᵢu` vanishes off `K` when `tsupport u ⊆ K`
  have hvan : ∀ u : Euclid n → ℝ, tsupport u ⊆ cthickening δ (tsupport φ) →
      ∀ x ∉ cthickening δ (tsupport φ), G x * fderiv ℝ u x (EuclideanSpace.single i 1) = 0 :=
    fun u hu x hx => by rw [fderiv_of_notMem_tsupport ℝ fun h => hx (hu h), zero_apply, mul_zero]
  -- step 2: `∂ᵢφ` is continuous, hence bounded on `K`
  have hf : Continuous fun x => fderiv ℝ φ x (EuclideanSpace.single i 1) :=
    (hφ.continuous_fderiv one_ne_zero).clm_apply continuous_const
  obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn hf.continuousOn
  -- step 3: the integral over `ℝⁿ` is the integral over `K`
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero (hvan φ (self_subset_cthickening _))]
  -- step 4: smooth tests `ψ` with `tsupport ψ ⊆ K` approximate `∂ᵢφ` uniformly on `K`
  refine Submission.dgcr_stc_setIntegral_mul_eq_zero_of_uniform_approx n
    (cthickening δ (tsupport φ)) G (fun x => fderiv ℝ φ x (EuclideanSpace.single i 1)) C
    isClosed_cthickening.measurableSet hGK hf.aestronglyMeasurable
    (fun x hx => (Real.norm_eq_abs _).symm.trans_le (hC x hx)) fun ε hε => ?_
  obtain ⟨ψ, hψ, hψc, hψK, hψε⟩ := Submission.dgcr_stc_mollify_C1_fderiv_approx n φ hφ hφc δ hδ
    (EuclideanSpace.single i 1) ε hε
  refine ⟨fun x => fderiv ℝ ψ x (EuclideanSpace.single i 1),
    ((hψ.continuous_fderiv (by simp)).clm_apply continuous_const).aestronglyMeasurable,
    fun x _ => (abs_sub_comm _ _).trans_le (hψε x), ?_⟩
  -- `∫_K G ∂ᵢψ = ∫ G ∂ᵢψ = ∫_D G ∂ᵢψ`, which vanishes as `ψ` is a smooth test in `D`
  have hvanD : ∀ x ∉ D, G x * fderiv ℝ ψ x (EuclideanSpace.single i 1) = 0 :=
    fun x hx => hvan ψ hψK x fun h => hx (hKD h)
  rw [setIntegral_eq_integral_of_forall_compl_eq_zero (hvan ψ hψK),
    ← setIntegral_eq_integral_of_forall_compl_eq_zero hvanD]
  exact htest ψ hψ hψc (hψK.trans hKD) i

/-- **An integer multiplicity cycle carried by a `C¹` graph is regular** (Simon 7.4.3, p. 194,
"Hence by Allard's Theorem 5.2 of Ch. 5 we have `y ∈ reg T`", with the Constancy Theorem 6.2.34).
Let `T = τ(M, θ, ξ) ∈ 𝒟ₙ(U)` with `∂T = 0`, `ι`, `ι'` linear isometries with orthogonal ranges,
`Φ(v) = z + ιv + ι'u(v)` for a `C¹` map `u` on `B_s(0)` with `u(0) = 0`, and
`C = {z + ιv + ι'w : |v| < s, |w| < h} ⊆ U`.  If `spt μ_T ∩ C = Σ := Φ(B_s(0))` and `z ∈ spt T`,
then `z ∈ reg T`.  `Σ` is an embedded `C¹` submanifold through `z = Φ(0)` with a continuous unit
orientation `ξ_Σ`, and `T(ω) = ∫_Σ g ⟨ω, ξ_Σ⟩ dHⁿ` for `spt ω ⊆ C`, with `G = g ∘ Φ` locally
integrable and integer-valued on `B_s(0)`.  By the area formula and
`α(DΦe₁, …, DΦeₙ) = JΦ ⟨α, ξ_Σ⟩`, `T(ω) = ∫_{B_s(0)} G ω(Φ)(DΦe₁, …, DΦeₙ) dv`; `∂T = 0` kills
the weak derivatives of `G`, so `G = m ∈ ℤ` a.e. on the connected ball and `T = m[[Σ]]` in `C`.
`m ≠ 0` as `z ∈ spt T`, and `ρ = min(s, h)/2` gives `B̄_ρ(z) ⊆ C`. -/
theorem Submission.dor_graph_supported_cycle_regular : ∀ (n k : ℕ) (U : Set (Euclid (n + k))) (T : GeometricCurrentOn U n) (R : IMRep U n) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (u : Euclid n → Euclid k) (z : Euclid (n + k)) (s h : ℝ), 0 < n → IsOpen U → R.Represents T → BoundaryVanishes T → (∀ v w, inner ℝ (ι v) (ι' w) = 0) → 0 < s → 0 < h → ContDiffOn ℝ 1 u (ball 0 s) → u 0 = 0 → {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} ⊆ U → R.measure.support ∩ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} = (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s → z ∈ T.support → z ∈ regularSet T := by
  intro n k U T R ι ι' u z s h hn _hU hRT hbd horth hs hh hu hu0 hCU hspt hzT
  -- step 1: orthogonal coordinates `x − z = ιv + ι'w` with `‖x − z‖² = ‖v‖² + ‖w‖²`
  obtain ⟨hdec, hpyth⟩ := Submission.dgcr_orthogonal_coordinates n k ι ι' horth
  have hle : ∀ (v : Euclid n) (w : Euclid k), ‖v‖ ≤ ‖ι v + ι' w‖ ∧ ‖w‖ ≤ ‖ι v + ι' w‖ := by
    intro v w
    have h2 := hpyth v w
    constructor <;> nlinarith [norm_nonneg v, norm_nonneg w, norm_nonneg (ι v + ι' w)]
  have huniq : ∀ (v v' : Euclid n) (w w' : Euclid k), ι v + ι' w = ι v' + ι' w' → w = w' := by
    intro v v' w w' heq
    have h0 : ι (v - v') + ι' (w - w') = 0 := by
      rw [map_sub, map_sub, sub_add_sub_comm, heq, sub_self]
    have h1 := (hle (v - v') (w - w')).2
    rw [h0, norm_zero] at h1
    exact sub_eq_zero.1 (norm_le_zero_iff.1 h1)
  -- `ρ := min(s, h)/2`, so `B̄_ρ(z) ⊆ C ⊆ U`
  obtain ⟨ρ, hρdef⟩ : ∃ ρ : ℝ, ρ = min s h / 2 := ⟨_, rfl⟩
  have hρ : 0 < ρ := by rw [hρdef]; exact half_pos (lt_min hs hh)
  have hρs : ρ < s := by rw [hρdef]; linarith [min_le_left s h, lt_min hs hh]
  have hρh : ρ < h := by rw [hρdef]; linarith [min_le_right s h, lt_min hs hh]
  have hclosed : closedBall z ρ ⊆ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} := by
    intro x hx
    obtain ⟨v, w, hvw⟩ := hdec (x - z)
    have hxz : ‖ι v + ι' w‖ ≤ ρ := by rw [← hvw, ← dist_eq_norm]; exact hx
    refine ⟨v, ?_, w, ?_, ?_⟩
    · rw [mem_ball_zero_iff]; exact ((hle v w).1.trans hxz).trans_lt hρs
    · rw [mem_ball_zero_iff]; exact ((hle v w).2.trans hxz).trans_lt hρh
    · rw [add_assoc, ← hvw, add_sub_cancel]
  have hballC : ball z ρ ⊆ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} :=
    ball_subset_closedBall.trans hclosed
  -- `‖v‖ ≤ ‖Φ(v) − z‖`, `z = Φ(0) ∈ Σ`, and `u(B_s(0)) ⊆ B_h(0)` because `Σ ⊆ C`
  have hnorm : ∀ v : Euclid n, ‖v‖ ≤ ‖z + ι v + ι' (u v) - z‖ := fun v => by
    rw [add_assoc, add_sub_cancel_left]; exact (hle v (u v)).1
  have hzS : z ∈ (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s :=
    ⟨0, mem_ball_self hs, by simp [hu0]⟩
  have huh : ∀ v ∈ ball (0 : Euclid n) s, u v ∈ ball (0 : Euclid k) h := by
    intro v hv
    have hmem : z + ι v + ι' (u v) ∈ R.measure.support ∩ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} := by
      rw [hspt]; exact ⟨v, hv, rfl⟩
    obtain ⟨v', -, w', hw', heq⟩ := hmem.2
    rw [add_assoc, add_assoc] at heq
    rwa [huniq v v' (u v) w' (add_left_cancel heq)]
  -- step 2: `Σ` is an embedded `C¹` submanifold with `T_{Φ(v)}Σ = range DΦ(v)`, oriented by `ξ`
  obtain ⟨hinj, hdiff, hemb, htan⟩ := Submission.dgcr_graph_chart_embedded n k ι ι' u z s horth hs hu
  obtain ⟨ξ, β, hξc, hβc, hξβ, hξo, hjac⟩ :=
    Submission.dgcr_graph_orientation_jacobian n k ι ι' u z s hn horth hs hu
  have hor : IsOrientation n ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s) ξ := by
    refine ⟨hξc, ?_⟩
    rintro _ ⟨v, hv, rfl⟩
    exact ⟨_, (htan v hv).symm, hξo v hv⟩
  -- step 3: an integer density `g` on `Σ` with `T(ω) = ∫_Σ g ⟨ω, ξ⟩ dHⁿ` for `spt ω ⊆ C`
  obtain ⟨g, hgloc, hgint, hgrep⟩ := Submission.dgcr_graph_integer_density_on_graph n k U T R ι ι' u z
    s h ξ β hn hRT horth hs hh hu hCU hspt hβc hξβ hξo
  -- step 4: area formula `∫_Σ F dHⁿ = ∫_{B_s(0)} JΦ · F ∘ Φ dLⁿ`, `JΦ = √det(DΦ* DΦ)`
  have harea : ∀ F : Euclid (n + k) → ℝ, ∫ x in (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s, F x ∂μHE[n] = ∫ v in ball (0 : Euclid n) s, Real.sqrt (((fderiv ℝ (fun v => z + ι v + ι' (u v)) v).adjoint ∘L fderiv ℝ (fun v => z + ι v + ι' (u v)) v).det) * F (z + ι v + ι' (u v)) := by
    intro F
    have h4 := Poincare.SimonGMT.Chapter02.integral_area_formula_of_injective_derivative
      measurableSet_ball (fun v hv => (hdiff v hv).1) (fun v hv => (hdiff v hv).2) hinj F
    rw [finrank_euclideanSpace_fin, EuclideanSpace.euclideanHausdorffMeasure_eq_volume n] at h4
    rw [h4]
    refine setIntegral_congr_fun measurableSet_ball fun v _ => ?_
    simp only [smul_eq_mul, Poincare.SimonGMT.Chapter02.areaJacobianAt_eq_sqrt_det_adjoint_comp]
  -- with `α(DΦe₁, …, DΦeₙ) = JΦ ⟨α, ξ⟩`: `T(ω) = ∫_{B_s(0)} G ω(Φ)(DΦe₁, …, DΦeₙ) dv`, `G = g ∘ Φ`
  have hrepD : ∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid (n + k)) n) ⊆ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} → T ω = ∫ v in ball (0 : Euclid n) s, g (z + ι v + ι' (u v)) * (ω : DifferentialForm (Euclid (n + k)) n) (z + ι v + ι' (u v)) (fun i => fderiv ℝ (fun v => z + ι v + ι' (u v)) v (EuclideanSpace.single i (1 : ℝ))) := by
    intro ω hω
    rw [hgrep ω hω, harea]
    refine setIntegral_congr_fun measurableSet_ball fun v hv => ?_
    simp only [hjac v hv]
    ring
  -- step 5: `∂T = 0` gives `∫ G ∂ⱼa = 0` for all tests `a`; distributional constancy on `B_s(0)`
  have hBT := Submission.dgcr_graph_boundary_weak_derivatives n k U T ι ι' u z s h
    (fun v => g (z + ι v + ι' (u v))) hn hbd horth hs hh hu huh hCU hrepD
  have hSC := Submission.dgcr_smooth_tests_to_C1_tests n (ball (0 : Euclid n) s)
    (fun v => g (z + ι v + ι' (u v))) isOpen_ball hgloc hBT
  obtain ⟨c, hc⟩ := Poincare.SimonGMT.Chapter08.ae_eq_const_of_weak_coordinate_derivatives_zero
    hgloc isOpen_ball (convex_ball (0 : Euclid n) s).isPreconnected hSC
  -- the constant is an integer `m`: `G` is integer-valued a.e. and `Lⁿ(B_s(0)) > 0`
  obtain ⟨v₀, -, hv₀c, m, hv₀m⟩ := Measure.exists_mem_of_measure_ne_zero_of_ae
    (measure_ball_pos volume (0 : Euclid n) hs).ne' (hc.and hgint)
  have hGm : ∀ᵐ v ∂(volume.restrict (ball (0 : Euclid n) s)), g (z + ι v + ι' (u v)) = m := by
    filter_upwards [hc] with v hv
    exact hv.trans (hv₀c.symm.trans hv₀m)
  -- step 6: `T = m[[Σ]]` in `C`
  have hrepm : ∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid (n + k)) n) ⊆ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} → T ω = (m : ℝ) * ∫ x in (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s, ξ x ((ω : DifferentialForm (Euclid (n + k)) n) x) ∂μHE[n] := by
    intro ω hω
    rw [hrepD ω hω, harea, ← integral_const_mul]
    refine integral_congr_ae ?_
    filter_upwards [hGm, ae_restrict_mem measurableSet_ball] with v hv hvD
    rw [hv, hjac v hvD]
  -- step 7: `m ≠ 0`, since otherwise `T` vanishes in `B_ρ(z)` and `z ∉ spt T`
  have hm0 : m ≠ 0 := by
    intro hm
    subst hm
    have hvan : T.VanishesOn (ball z ρ) := by
      intro ω hω
      rw [hrepm ω (hω.trans hballC), Int.cast_zero, zero_mul]
    exact hzT.2 (Set.mem_sUnion.2 ⟨ball z ρ, ⟨isOpen_ball,
      (isCompact_closedBall z ρ).of_isClosed_subset isClosed_closure closure_ball_subset_closedBall,
      closure_ball_subset_closedBall.trans (hclosed.trans hCU), hvan⟩, mem_ball_self hρ⟩)
  -- step 8: `Hⁿ(Σ ∩ K) ≤ Hⁿ(Φ(B̄_ρ(0))) < ∞` for `K ⊆ B_ρ(z)`
  have hfin : ∀ K : Set (Euclid (n + k)), IsCompact K → K ⊆ ball z ρ → μHE[n] (((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s) ∩ K) ≠ ∞ := by
    intro K _ hK
    refine ne_top_of_le_ne_top
      ((Submission.dgcr_graph_measure_bounds n k ι ι' u z s horth hs hu).2 ρ hρs) (measure_mono ?_)
    rintro _ ⟨⟨v, -, rfl⟩, hvK⟩
    refine ⟨v, ?_, rfl⟩
    have hv := hK hvK
    rw [mem_ball, dist_eq_norm] at hv
    rw [mem_closedBall_zero_iff]
    exact (hnorm v).trans hv.le
  exact ⟨hzT, ρ, hρ, hballC.trans hCU, m, (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s, ξ,
    hm0, hzS, hemb, hor, hfin, fun ω hω => hrepm ω (hω.trans hballC)⟩

/-- **ε-regularity for stationary cycles**, the book's appeal to Allard's theorem in Simon 7.4.3
(chapter-07.txt lines 624–631; Allard's theorem is Ch. 5, 5.2).  Near `y₀ ∈ N ∩ U`, the varifold
`v(M, θ)` of a cycle `T = τ(M, θ, ξ)` stationary in `U ∩ N` has generalized mean curvature
`|H| ≤ κ` in `B_{2r_c}(y₀)` (Ch. 4, 2.7).  If `z ∈ spt T` is near `y₀` and
`M_{B_ρ(z)}(T) ≤ (1 + δ)ωₙρⁿ`, then `μ_R(B̄_{ρ'}(z)) ≤ (1 + δ₁)ωₙρ'ⁿ` for a slightly smaller
`ρ'`, because `M_W(T) = μ_R(W)` and `z ∈ spt μ_R`.  Allard's theorem (gradient bound `1/4`) then
makes `spt μ_R ∩ B_{γρ'}(z)` the graph of a `C¹` map `u` over an `n`-plane through `z`.  In the
cylinder of radius `γρ'/4` about `z`, `spt μ_R` is exactly that graph, so `z ∈ reg T` by the
Constancy Theorem argument (Ch. 6, 2.34). -/
theorem Submission.dor_stationary_cycle_epsilon_regularity : ∀ (n k ℓ : ℕ), ℓ ≤ k → 0 < n →
    ∀ (U N : Set (Euclid (n + k))) (y₀ : Euclid (n + k)), IsOpen U →
    IsEmbeddedSubmanifold 2 (n + ℓ) N → (closure N \ N) ∩ U = ∅ → y₀ ∈ N ∩ U →
    ∃ r₀ δ : ℝ, 0 < r₀ ∧ 0 < δ ∧ ∀ (T : GeometricCurrentOn U n) (R : IMRep U n),
      R.Represents T → T.support ⊆ N → BoundaryVanishes T → R.IsStationaryAlong N →
      ∀ z ∈ T.support, dist z y₀ < r₀ → ∀ ρ : ℝ, 0 < ρ → ρ ≤ r₀ →
        T.massOn (ball z ρ) ≤ ENNReal.ofReal (1 + δ) * unitBallVolume n * ENNReal.ofReal (ρ ^ n) →
        z ∈ regularSet T := by
  intro n k ℓ hℓk hn U N y₀ hU hN hNcl hy₀
  -- The mean curvature bound `κ` and the first variation formula on `B_{2r_c}(y₀)`.
  obtain ⟨rc, κ, hrc, hκ, hrcU, hmc⟩ :=
    Submission.dor_stationary_mean_curvature_monotonicity n k ℓ hℓk hn U N y₀ hU hN hNcl hy₀
  -- Allard's constants `δ₁`, `γ` for the gradient bound `1/4`.
  obtain ⟨δ₁, γ, hδ₁, hγ, hγ1, hallard⟩ :=
    Submission.dor_allard_bounded_curvature_graph n k hn (1 / 4) (by norm_num)
  have hκ1 : 0 < κ + 1 := by linarith
  refine ⟨min (rc / 2) (δ₁ / (κ + 1)), δ₁ / 2, lt_min (half_pos hrc) (div_pos hδ₁ hκ1),
    half_pos hδ₁, ?_⟩
  intro T R hR hTN hTb hstat z hz hzy ρ hρ hρr₀ hmass
  obtain ⟨hρrc, hρδ⟩ := le_min_iff.1 hρr₀
  have hzy' : dist z y₀ < rc / 2 := (lt_min_iff.1 hzy).1
  -- `M_W(T) = μ_R(W)` for open `W`, and `spt T = U ∩ spt μ_R`; so `z ∈ spt μ_R`.
  obtain ⟨hmassEq, hsupp⟩ :=
    Submission.dor_imrep_massOn_eq_measure_and_support (n + k) n U T R hU hR
  have hzR : z ∈ R.measure.support := by
    have h := hz
    rw [hsupp] at h
    exact h.2
  obtain ⟨⟨H, hHm, hHκ, hHfv⟩, -⟩ := hmc T R hR hTN hstat
  -- A smaller radius `ρ' = tρ`, `t = 1 - d/n`, with `(1 + δ₁/2)ρⁿ ≤ (1 + δ₁)ρ'ⁿ` (Bernoulli).
  set d : ℝ := δ₁ / (2 * (1 + δ₁)) with hd
  have hd0 : 0 < d := div_pos hδ₁ (by linarith)
  have hd1 : d < 1 := by
    rw [hd, div_lt_one (by linarith)]
    linarith
  have hδd : (1 + δ₁) * (1 - d) = 1 + δ₁ / 2 := by
    rw [hd]
    field_simp
    ring
  have hnR : (1 : ℝ) ≤ n := by exact_mod_cast hn
  set t : ℝ := 1 - d / n with ht
  have hdn : d / n ≤ d := div_le_self hd0.le hnR
  have hdn0 : 0 < d / n := div_pos hd0 (by linarith)
  have ht0 : 0 < t := by linarith
  have ht1 : t < 1 := by linarith
  have hbern : 1 - d ≤ t ^ n := by
    have h := one_add_mul_le_pow (show (-2 : ℝ) ≤ -(d / n) by linarith) n
    have e1 : (n : ℝ) * -(d / n) = -d := by
      field_simp
    have e2 : (1 : ℝ) + -(d / n) = t := by
      rw [ht]
      ring
    rw [e1, e2] at h
    linarith
  set ρ' : ℝ := t * ρ with hρ'
  have hρ'0 : 0 < ρ' := mul_pos ht0 hρ
  have hρ'ρ : ρ' < ρ := mul_lt_of_lt_one_left hρ ht1
  have hreal : (1 + δ₁ / 2) * ρ ^ n ≤ (1 + δ₁) * ρ' ^ n := by
    have hρn : 0 ≤ ρ ^ n := pow_nonneg hρ.le n
    calc (1 + δ₁ / 2) * ρ ^ n = (1 + δ₁) * ((1 - d) * ρ ^ n) := by
          rw [← hδd]
          ring
      _ ≤ (1 + δ₁) * (t ^ n * ρ ^ n) := by
          gcongr
      _ = (1 + δ₁) * ρ' ^ n := by
          rw [hρ', mul_pow]
  -- Allard's mass hypothesis on the closed ball `B̄_{ρ'}(z) ⊆ B_ρ(z)`.
  have hmass' : R.measure (closedBall z ρ') ≤
      ENNReal.ofReal (1 + δ₁) * unitBallVolume n * ENNReal.ofReal (ρ' ^ n) := by
    calc R.measure (closedBall z ρ') ≤ R.measure (ball z ρ) :=
          measure_mono (closedBall_subset_ball hρ'ρ)
      _ = T.massOn (ball z ρ) := (hmassEq _ isOpen_ball).symm
      _ ≤ ENNReal.ofReal (1 + δ₁ / 2) * unitBallVolume n * ENNReal.ofReal (ρ ^ n) := hmass
      _ ≤ ENNReal.ofReal (1 + δ₁) * unitBallVolume n * ENNReal.ofReal (ρ' ^ n) := by
          rw [mul_right_comm, mul_right_comm (ENNReal.ofReal (1 + δ₁)),
            ← ENNReal.ofReal_mul (show (0 : ℝ) ≤ 1 + δ₁ / 2 by linarith),
            ← ENNReal.ofReal_mul (show (0 : ℝ) ≤ 1 + δ₁ by linarith)]
          gcongr
  -- Allard's curvature hypothesis `κρ' ≤ δ₁`.
  have hκρ' : κ * ρ' ≤ δ₁ := by
    have h1 : ρ' * (κ + 1) ≤ δ₁ := (le_div_iff₀ hκ1).1 (hρ'ρ.le.trans hρδ)
    have h2 : ρ' * (κ + 1) = κ * ρ' + ρ' := by ring
    linarith
  -- `B̄_{ρ'}(z) ⊆ W := B_{2r_c}(y₀) ⊆ U`.
  have hWU : ball y₀ (2 * rc) ⊆ U :=
    (ball_subset_closedBall.trans (closedBall_subset_closedBall (by linarith))).trans hrcU
  have hBW : closedBall z ρ' ⊆ ball y₀ (2 * rc) := by
    intro x hx
    rw [mem_closedBall] at hx
    rw [mem_ball]
    calc dist x y₀ ≤ dist x z + dist z y₀ := dist_triangle _ _ _
      _ < 2 * rc := by linarith
  -- Allard: `spt μ_R ∩ B_{γρ'}(z)` is the graph of `u` over `ι(ℝⁿ)`, with `‖Du‖ ≤ 1/4`.
  obtain ⟨ι, ι', u, horth, hu0, hu, hDu, hgraph⟩ :=
    hallard U (ball y₀ (2 * rc)) R H κ ρ' z isOpen_ball hWU hρ'0 hBW hHm hHκ hHfv hzR hmass'
      hκρ'
  -- The cylinder `{z + ι v + ι' w : |v|, |w| < s}`, `s = γρ'/4`, lies in `B_{γρ'}(z) ⊆ U`.
  set s : ℝ := γ * ρ' / 4 with hs
  have hγρ' : 0 < γ * ρ' := mul_pos hγ hρ'0
  have hs0 : 0 < s := by linarith
  have hsγ : s < γ * ρ' := by linarith
  have hγρ'ρ' : γ * ρ' ≤ ρ' := mul_le_of_le_one_left hρ'0.le hγ1
  have hnorm : ∀ (v : Euclid n) (w : Euclid k), dist (z + ι v + ι' w) z ≤ ‖v‖ + ‖w‖ := by
    intro v w
    rw [dist_eq_norm, add_assoc, add_sub_cancel_left]
    calc ‖ι v + ι' w‖ ≤ ‖ι v‖ + ‖ι' w‖ := norm_add_le _ _
      _ = ‖v‖ + ‖w‖ := by rw [ι.norm_map, ι'.norm_map]
  have hcyl : {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) s,
      x = z + ι v + ι' w} ⊆ ball z (γ * ρ') := by
    rintro x ⟨v, hv, w, hw, rfl⟩
    rw [mem_ball_zero_iff] at hv hw
    rw [mem_ball]
    calc dist (z + ι v + ι' w) z ≤ ‖v‖ + ‖w‖ := hnorm v w
      _ < γ * ρ' := by linarith
  have hcylU : {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) s,
      x = z + ι v + ι' w} ⊆ U :=
    hcyl.trans ((ball_subset_ball hγρ'ρ').trans (ball_subset_closedBall.trans (hBW.trans hWU)))
  -- `|u(v)| ≤ |v|/4` on `B_{γρ'}(0)` (mean value inequality, `u(0) = 0`).
  have hu_le : ∀ v ∈ ball (0 : Euclid n) (γ * ρ'), ‖u v‖ ≤ 1 / 4 * ‖v‖ := by
    intro v hv
    have h := (convex_ball (0 : Euclid n) (γ * ρ')).norm_image_sub_le_of_norm_fderiv_le
      (fun x hx => (hu.differentiableOn_one x hx).differentiableAt (isOpen_ball.mem_nhds hx))
      hDu (mem_ball_self hγρ') hv
    simpa [hu0] using h
  -- In the cylinder, `spt μ_R` is exactly the graph over `B_s(0)`: the ranges of `ι`, `ι'` are
  -- orthogonal, so a graph point `z + ι v' + ι' u(v')` equal to `z + ι v + ι' w` has `v' = v`.
  have hsupp_eq : R.measure.support ∩ {x | ∃ v ∈ ball (0 : Euclid n) s,
      ∃ w ∈ ball (0 : Euclid k) s, x = z + ι v + ι' w} =
      (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s := by
    ext x
    constructor
    · rintro ⟨hxR, hxC⟩
      have hxB := hcyl hxC
      obtain ⟨v, hv, w, -, rfl⟩ := hxC
      have hx : z + ι v + ι' w ∈ R.measure.support ∩ ball z (γ * ρ') := ⟨hxR, hxB⟩
      rw [hgraph] at hx
      obtain ⟨⟨v', -, hv'⟩, -⟩ := hx
      have hsum : ι v' + ι' (u v') = ι v + ι' w := by
        simpa only [add_assoc, add_right_inj] using hv'
      have hdiff : ι (v' - v) = ι' (w - u v') := by
        rw [map_sub, map_sub, sub_eq_sub_iff_add_eq_add, hsum, add_comm (ι v)]
      have hzero : ι (v' - v) = 0 := by
        rw [← inner_self_eq_zero (𝕜 := ℝ)]
        nth_rewrite 2 [hdiff]
        exact horth _ _
      have hvv : v' = v := by
        have h0 : ‖v' - v‖ = 0 := by
          rw [← ι.norm_map, hzero, norm_zero]
        exact sub_eq_zero.1 (norm_eq_zero.1 h0)
      subst hvv
      exact ⟨v', hv, hv'⟩
    · rintro ⟨v, hv, rfl⟩
      have hvs : ‖v‖ < s := mem_ball_zero_iff.1 hv
      have hvγ : v ∈ ball (0 : Euclid n) (γ * ρ') := ball_subset_ball hsγ.le hv
      have huv : ‖u v‖ < s := by
        have h := hu_le v hvγ
        linarith [norm_nonneg v]
      have hxB : z + ι v + ι' (u v) ∈ ball z (γ * ρ') := by
        rw [mem_ball]
        calc dist (z + ι v + ι' (u v)) z ≤ ‖v‖ + ‖u v‖ := hnorm v (u v)
          _ < γ * ρ' := by linarith
      have hx : z + ι v + ι' (u v) ∈
          ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) (γ * ρ')) ∩ ball z (γ * ρ') :=
        ⟨⟨v, hvγ, rfl⟩, hxB⟩
      rw [← hgraph] at hx
      exact ⟨hx.1, v, hv, u v, mem_ball_zero_iff.2 huv, rfl⟩
  -- Constancy over the base disc (`dor_graph_supported_cycle_regular`): `z ∈ reg T`.
  exact Submission.dor_graph_supported_cycle_regular n k U T R ι ι' u z s s hn hU hR hTb horth
    hs0 hs0 (hu.mono (ball_subset_ball hsγ.le)) hu0 hcylU hsupp_eq hz

/-- **Simon Ch. 2, §4** (4.1–4.3 and the definition of `Cˡ` functions on `M`): the tangent
projection `z ↦ P_{T_zN}` of an embedded `C²` submanifold `N ⊆ ℝᴾ` is `C¹` on `N`, i.e. it is the
restriction to `N` of a map that is `C¹` on an open `O ⊇ N`.  Along a chart `ψ`,
`T_{ψ(v)}N = range Dψ(v)` (`Submission.chart_tangentSpace_eq_range_fderiv`), and the projection
onto `range L` is `L (L*L)⁻¹ L*`, a smooth function of `L` near each injective `L`.  The inverse
function theorem for `Λ ∘ ψ`, `Λ` a left inverse of `Dψ(v₀)`, gives a `C¹` left inverse `φ` of
`ψ` on an open subset of `ℝᴾ`; by 4.2 (`ψ` is proper, so a homeomorphism onto `W ∩ N`),
`φ ∘ ψ = id` on all of `N` near `ψ(v₀)`, so `y ↦ P_{range Dψ(φ(y))}` extends `P_N` near `ψ(v₀)`.
A smooth partition of unity on the union `O` of these neighbourhoods glues the local
extensions. -/
theorem Submission.submanifold_tangentProjection_c1_extension : ∀ (P d : ℕ) (N : Set (Euclid P)), IsEmbeddedSubmanifold 2 d N → ∃ (O : Set (Euclid P)) (pr : Euclid P → (Euclid P →L[ℝ] Euclid P)), IsOpen O ∧ N ⊆ O ∧ ContDiffOn ℝ 1 pr O ∧ ∀ z ∈ N, pr z = (Submodule.span ℝ (tangentSpace N z)).starProjection := by
  intro P d N hN
  classical
  -- Step 1: `L ↦ P_{range L} = L (L*L)⁻¹ L*` is `C¹` near every injective `L₀`.
  have hproj : ∀ L₀ : Euclid d →L[ℝ] Euclid P, Injective L₀ →
      ContDiffAt ℝ 1 (fun L : Euclid d →L[ℝ] Euclid P =>
        (LinearMap.range (L : Euclid d →ₗ[ℝ] Euclid P)).starProjection) L₀ := by
    intro L₀ hL₀
    -- the adjoint `L ↦ L*`, as an `ℝ`-linear continuous map
    let adj : (Euclid d →L[ℝ] Euclid P) →L[ℝ] (Euclid P →L[ℝ] Euclid d) :=
      { toFun := fun L => ContinuousLinearMap.adjoint L
        map_add' := fun A B => map_add _ A B
        map_smul' := fun c A => by simp
        cont := ContinuousLinearMap.adjoint.continuous }
    have hadj : ∀ L, adj L = ContinuousLinearMap.adjoint L := fun _ => rfl
    -- the Gram operator `L*L` is invertible at `L₀`
    let G : (Euclid d →L[ℝ] Euclid P) → (Euclid d →L[ℝ] Euclid d) := fun L => adj L ∘L L
    have hG : ContDiff ℝ 1 G := adj.contDiff.clm_comp contDiff_id
    have hGunit : IsUnit (G L₀) := by
      have hinj : Injective (G L₀) := by
        intro x y hxy
        have h0 : G L₀ (x - y) = 0 := by simp [map_sub, hxy]
        have h1 : inner ℝ (L₀ (x - y)) (L₀ (x - y)) = 0 := by
          have := congrArg (fun z => inner ℝ z (x - y)) h0
          simpa only [G, ContinuousLinearMap.coe_comp, comp_apply, hadj,
            ContinuousLinearMap.adjoint_inner_left, inner_zero_left] using this
        have h2 : L₀ (x - y) = L₀ 0 := by rw [inner_self_eq_zero.1 h1, map_zero]
        exact sub_eq_zero.1 (hL₀ h2)
      rw [ContinuousLinearMap.isUnit_iff_bijective]
      refine ⟨hinj, ?_⟩
      simpa using (LinearMap.injective_iff_surjective
        (f := (G L₀ : Euclid d →ₗ[ℝ] Euclid d))).1 hinj
    let Γ : (Euclid d →L[ℝ] Euclid P) → (Euclid P →L[ℝ] Euclid P) :=
      fun L => L ∘L (Ring.inverse (G L) ∘L adj L)
    have hinv : ContDiffAt ℝ 1 (fun L => Ring.inverse (G L)) L₀ := by
      have h := contDiffAt_ringInverse ℝ (n := 1) hGunit.unit
      rw [IsUnit.unit_spec] at h
      exact h.comp L₀ hG.contDiffAt
    have hΓ : ContDiffAt ℝ 1 Γ L₀ :=
      contDiffAt_id.clm_comp (hinv.clm_comp adj.contDiff.contDiffAt)
    -- `Γ L = P_{range L}` wherever `L*L` is invertible, in particular near `L₀`
    have hev : ∀ᶠ L in 𝓝 L₀, IsUnit (G L) :=
      hG.continuous.continuousAt.preimage_mem_nhds (Units.isOpen.mem_nhds hGunit)
    refine hΓ.congr_of_eventuallyEq ?_
    filter_upwards [hev] with L hL
    ext1 x
    refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero ⟨_, rfl⟩ ?_
    rintro w ⟨a, rfl⟩
    have hcancel : G L (Ring.inverse (G L) (adj L x)) = adj L x := by
      have := congrArg (fun T : Euclid d →L[ℝ] Euclid d => T (adj L x))
        (Ring.mul_inverse_cancel (G L) hL)
      simpa [mul_apply_eq_comp] using this
    -- `L*(x - Γ L x) = 0`, i.e. `x - Γ L x ⊥ range L`
    have hperp : adj L (x - Γ L x) = 0 := by
      have : adj L (Γ L x) = G L (Ring.inverse (G L) (adj L x)) := rfl
      rw [map_sub, this, hcancel, sub_self]
    have : inner ℝ (x - Γ L x) (L a) = inner ℝ (adj L (x - Γ L x)) a := by
      rw [hadj, ContinuousLinearMap.adjoint_inner_left]
    rw [ContinuousLinearMap.coe_coe, this, hperp, inner_zero_left]
  -- Step 2: a `C¹` left inverse, defined on an open subset of `ℝᴾ`, of a `C¹` immersion `ψ`
  -- near `v₀`: the inverse function theorem for `Λ ∘ ψ`, `Λ` a left inverse of `Dψ(v₀)`.
  have hlinv : ∀ (V : Set (Euclid d)) (ψ : Euclid d → Euclid P) (v₀ : Euclid d), IsOpen V →
      ContDiffOn ℝ 1 ψ V → v₀ ∈ V → Injective (fderiv ℝ ψ v₀) →
      ∃ (O : Set (Euclid P)) (φ : Euclid P → Euclid d) (ε : ℝ), 0 < ε ∧ IsOpen O ∧
        ContDiffOn ℝ 1 φ O ∧ MapsTo φ O V ∧
        ∀ v : Euclid d, dist v v₀ < ε → v ∈ V ∧ ψ v ∈ O ∧ φ (ψ v) = v := by
    intro V ψ v₀ hV hψ hv₀ hinj
    obtain ⟨Λl, hΛl⟩ := LinearMap.exists_leftInverse_of_injective
      (fderiv ℝ ψ v₀ : Euclid d →ₗ[ℝ] Euclid P) (LinearMap.ker_eq_bot.2 hinj)
    let Λ : Euclid P →L[ℝ] Euclid d := LinearMap.toContinuousLinearMap Λl
    have hΛ : ∀ x, Λ (fderiv ℝ ψ v₀ x) = x := fun x => by
      simpa [Λ] using LinearMap.congr_fun hΛl x
    have hid : Λ ∘L fderiv ℝ ψ v₀ = ContinuousLinearMap.id ℝ (Euclid d) := by
      ext1 x
      simp [hΛ]
    let χ : Euclid d → Euclid d := fun v => Λ (ψ v)
    have hψat : ∀ v ∈ V, ContDiffAt ℝ 1 ψ v := fun v hv => hψ.contDiffAt (hV.mem_nhds hv)
    have hχat : ∀ v ∈ V, ContDiffAt ℝ 1 χ v := fun v hv =>
      Λ.contDiff.contDiffAt.comp v (hψat v hv)
    have hχderiv : ∀ v ∈ V, HasFDerivAt χ (Λ ∘L fderiv ℝ ψ v) v := fun v hv =>
      Λ.hasFDerivAt.comp v ((hψat v hv).differentiableAt one_ne_zero).hasFDerivAt
    -- the open set where `D(Λ ∘ ψ)` is invertible
    let D : Set (Euclid d) := V ∩ (fun v => Λ ∘L fderiv ℝ ψ v) ⁻¹' {A | IsUnit A}
    have hDopen : IsOpen D :=
      (continuousOn_const.clm_comp
        (hψ.continuousOn_fderiv_of_isOpen hV le_rfl)).isOpen_inter_preimage hV Units.isOpen
    have hv₀D : v₀ ∈ D :=
      ⟨hv₀, show IsUnit (Λ ∘L fderiv ℝ ψ v₀) by rw [hid]; exact isUnit_one⟩
    -- the inverse function theorem for `χ = Λ ∘ ψ` at `v₀`, where `Dχ(v₀) = id`
    have hstrict : HasStrictFDerivAt χ
        ((ContinuousLinearEquiv.refl ℝ (Euclid d) : Euclid d ≃L[ℝ] Euclid d) :
          Euclid d →L[ℝ] Euclid d) v₀ := by
      refine (hχat v₀ hv₀).hasStrictFDerivAt' ?_ one_ne_zero
      have := hχderiv v₀ hv₀
      rw [hid] at this
      exact this
    let h := hstrict.toOpenPartialHomeomorph χ
    have hcoe : (h : Euclid d → Euclid d) = χ := rfl
    let S := h.source ∩ D
    have hSopen : IsOpen S := h.open_source.inter hDopen
    have hv₀S : v₀ ∈ S := ⟨hstrict.mem_toOpenPartialHomeomorph_source, hv₀D⟩
    let T := h.target ∩ h.symm ⁻¹' S
    have hTopen : IsOpen T := h.isOpen_inter_preimage_symm hSopen
    -- `h⁻¹` is `C¹` on `T`, where the derivative of `h` is invertible
    have hsymm : ∀ t ∈ T, ContDiffAt ℝ 1 h.symm t := by
      intro t ht
      have hs : h.symm t ∈ S := ht.2
      obtain ⟨u, hu⟩ := hs.2.2
      apply h.contDiffAt_symm ht.1 (f₀' := ContinuousLinearEquiv.unitsEquiv ℝ (Euclid d) u)
      · have he : ((ContinuousLinearEquiv.unitsEquiv ℝ (Euclid d) u : Euclid d ≃L[ℝ] Euclid d) :
            Euclid d →L[ℝ] Euclid d) = Λ ∘L fderiv ℝ ψ (h.symm t) := by
          ext1 x
          simp [ContinuousLinearEquiv.unitsEquiv_apply, hu]
        rw [he, hcoe]
        exact hχderiv _ hs.2.1
      · rw [hcoe]
        exact hχat _ hs.2.1
    obtain ⟨ε, hε, hεS⟩ := Metric.isOpen_iff.1 hSopen v₀ hv₀S
    refine ⟨Λ ⁻¹' T, fun y => h.symm (Λ y), ε, hε, hTopen.preimage Λ.continuous, ?_, ?_, ?_⟩
    · intro y hy
      exact ((hsymm (Λ y) hy).comp y Λ.contDiff.contDiffAt).contDiffWithinAt
    · intro y hy
      exact (hy.2 : h.symm (Λ y) ∈ S).2.1
    · intro v hv
      have hvS : v ∈ S := hεS (mem_ball.2 hv)
      have hleft : h.symm (h v) = v := h.left_inv hvS.1
      refine ⟨hvS.2.1, ⟨h.map_source hvS.1, ?_⟩, hleft⟩
      show h.symm (h v) ∈ S
      rw [hleft]
      exact hvS
  -- Step 3: a proper injective chart has a continuous inverse: `ψ v` close to `ψ v₀` forces `v`
  -- close to `v₀`.
  have hprox : ∀ (V : Set (Euclid d)) (W : Set (Euclid P)) (ψ : Euclid d → Euclid P)
      (v₀ : Euclid d), IsOpen W → ContinuousOn ψ V → InjOn ψ V →
      (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → v₀ ∈ V → ψ v₀ ∈ W →
      ∀ ε : ℝ, 0 < ε → ∃ ρ : ℝ, 0 < ρ ∧ ∀ v ∈ V, dist (ψ v) (ψ v₀) < ρ → dist v v₀ < ε := by
    intro V W ψ v₀ hW hψ hinj hprop hv₀ hv₀W ε hε
    obtain ⟨r, hr, hrW⟩ := Metric.isOpen_iff.1 hW (ψ v₀) hv₀W
    -- `C = {v ∈ V : |ψ v - ψ v₀| ≤ r / 2, |v - v₀| ≥ ε}` is compact and `ψ v₀ ∉ ψ(C)`
    have hC : IsCompact ((V ∩ ψ ⁻¹' closedBall (ψ v₀) (r / 2)) ∩ (ball v₀ ε)ᶜ) :=
      (hprop _ ((closedBall_subset_ball (by linarith)).trans hrW)
        (isCompact_closedBall _ _)).inter_right isOpen_ball.isClosed_compl
    have himg := hC.image_of_continuousOn (hψ.mono fun x hx => hx.1.1)
    have hnot : ψ v₀ ∉ ψ '' ((V ∩ ψ ⁻¹' closedBall (ψ v₀) (r / 2)) ∩ (ball v₀ ε)ᶜ) := by
      rintro ⟨w, ⟨⟨hwV, -⟩, hwb⟩, hw⟩
      exact hwb (by rw [hinj hwV hv₀ hw]; exact mem_ball_self hε)
    obtain ⟨ρ, hρ, hρC⟩ := Metric.isOpen_iff.1 himg.isClosed.isOpen_compl (ψ v₀) hnot
    refine ⟨min ρ (r / 2), lt_min hρ (by linarith), fun v hv hdist => ?_⟩
    by_contra hcon
    exact hρC (mem_ball.2 (lt_of_lt_of_le hdist (min_le_left _ _)))
      ⟨v, ⟨⟨hv, mem_closedBall.2 (lt_of_lt_of_le hdist (min_le_right _ _)).le⟩,
        fun hvb => hcon (mem_ball.1 hvb)⟩, rfl⟩
  -- Step 4: near each `p = ψ v₀ ∈ N`, `y ↦ P_{range Dψ(φ y)}` is a `C¹` extension of `P_N`.
  have hloc : ∀ p ∈ N, ∃ (U : Set (Euclid P)) (f : Euclid P → (Euclid P →L[ℝ] Euclid P)),
      IsOpen U ∧ p ∈ U ∧ ContDiffOn ℝ 1 f U ∧
        ∀ z ∈ N ∩ U, f z = (Submodule.span ℝ (tangentSpace N z)).starProjection := by
    intro p hp
    obtain ⟨V, W, ψ, hV, hW, hpW, hψ, hinj, himg, hprop, hDψ⟩ := hN p hp
    have hpV : p ∈ ψ '' V := by rw [himg]; exact ⟨hpW, hp⟩
    obtain ⟨v₀, hv₀, rfl⟩ := hpV
    have hψ1 : ContDiffOn ℝ 1 ψ V := hψ.of_le (by exact_mod_cast (by norm_num : (1 : ℕ) ≤ 2))
    have hDψ1 : ContDiffOn ℝ 1 (fun v => fderiv ℝ ψ v) V := hψ.fderiv_of_isOpen hV (by norm_num)
    obtain ⟨O₁, φ, ε, hε, hO₁, hφ, hφV, hφψ⟩ := hlinv V ψ v₀ hV hψ1 hv₀ (hDψ v₀ hv₀)
    obtain ⟨ρ, hρ, hρε⟩ := hprox V W ψ v₀ hW hψ1.continuousOn hinj hprop hv₀ hpW ε hε
    refine ⟨O₁ ∩ ball (ψ v₀) ρ ∩ W,
      fun y => (LinearMap.range (fderiv ℝ ψ (φ y) : Euclid d →ₗ[ℝ] Euclid P)).starProjection,
      (hO₁.inter isOpen_ball).inter hW,
      ⟨⟨(hφψ v₀ (by simpa using hε)).2.1, mem_ball_self hρ⟩, hpW⟩, ?_, ?_⟩
    · intro y hy
      have hφy : φ y ∈ V := hφV hy.1.1
      exact ((hproj _ (hDψ _ hφy)).comp y ((hDψ1.contDiffAt (hV.mem_nhds hφy)).comp y
        (hφ.contDiffAt (hO₁.mem_nhds hy.1.1)))).contDiffWithinAt
    · rintro z ⟨hzN, ⟨hzO, hzρ⟩, hzW⟩
      have hzV : z ∈ ψ '' V := by rw [himg]; exact ⟨hzW, hzN⟩
      obtain ⟨v, hv, rfl⟩ := hzV
      -- `T_{ψ v}N = range Dψ(v)`
      have hspan : Submodule.span ℝ (tangentSpace N (ψ v)) =
          LinearMap.range (fderiv ℝ ψ v : Euclid d →ₗ[ℝ] Euclid P) := by
        rw [Submission.chart_tangentSpace_eq_range_fderiv P d 2 N W V ψ v (by norm_num) hV hW hψ
          hinj himg hprop hDψ hv, ← ContinuousLinearMap.coe_coe, ← LinearMap.coe_range,
          Submodule.span_eq]
      show (LinearMap.range (fderiv ℝ ψ (φ (ψ v)) : Euclid d →ₗ[ℝ] Euclid P)).starProjection = _
      rw [(hφψ v (hρε v hv (mem_ball.1 hzρ))).2.2, hspan]
  -- Step 5: glue the local extensions by a smooth partition of unity on `O = ⋃ₚ Uₚ`.
  choose! U f hU hpU hf hfN using hloc
  let O : Set (Euclid P) := ⋃ p ∈ N, U p
  have hO : IsOpen O := isOpen_biUnion fun p hp => hU p hp
  have hNO : N ⊆ O := fun p hp => mem_biUnion hp (hpU p hp)
  let O' : TopologicalSpace.Opens (Euclid P) := ⟨O, hO⟩
  have : LocallyCompactSpace O' := ChartedSpace.locallyCompactSpace (Euclid P) O'
  let t : O' → Set (Euclid P →L[ℝ] Euclid P) := fun x =>
    if (x : Euclid P) ∈ N then {(Submodule.span ℝ (tangentSpace N x)).starProjection} else univ
  have ht : ∀ x, Convex ℝ (t x) := by
    intro x
    by_cases hx : (x : Euclid P) ∈ N
    · simp only [t, ite_eq_left hx]
      exact convex_singleton _
    · simp only [t, ite_eq_right hx]
      exact convex_univ
  obtain ⟨g, hg⟩ := exists_contMDiffMap_forall_mem_convex_of_local (n := 1)
    (modelWithCornersSelf ℝ (Euclid P)) ht fun x => by
      have hx : (x : Euclid P) ∈ ⋃ p ∈ N, U p := x.2
      obtain ⟨p, hp, hxp⟩ := mem_iUnion₂.1 hx
      refine ⟨Subtype.val ⁻¹' U p,
        (continuous_subtype_val.isOpen_preimage _ (hU p hp)).mem_nhds hxp, fun y => f p y,
        fun y hy => ?_, fun y hy => ?_⟩
      · exact ContMDiffAt.contMDiffWithinAt ((contMDiffAt_subtype_iff (U := O') (f := f p)).2
          (contMDiffAt_iff_contDiffAt.2 ((hf p hp).contDiffAt ((hU p hp).mem_nhds hy))))
      · by_cases hyN : (y : Euclid P) ∈ N
        · simp only [t, ite_eq_left hyN, mem_singleton_iff]
          exact hfN p hp y ⟨hyN, hy⟩
        · simp only [t, ite_eq_right hyN, mem_univ]
  refine ⟨O, fun y => if hy : y ∈ O then g ⟨y, hy⟩ else 0, hO, hNO, fun y hy => ?_, fun z hz => ?_⟩
  · have hgy : ContMDiffAt (modelWithCornersSelf ℝ (Euclid P))
        (modelWithCornersSelf ℝ (Euclid P →L[ℝ] Euclid P)) 1
        (fun x : O' => (fun y => if hy : y ∈ O then g ⟨y, hy⟩ else 0) (x : Euclid P))
        ⟨y, hy⟩ := by
      refine (g.contMDiff ⟨y, hy⟩).congr_of_eventuallyEq (Eventually.of_forall fun x => ?_)
      have hx : (x : Euclid P) ∈ O := x.2
      simp only [dite_eq_left hx]
    exact (contMDiffAt_iff_contDiffAt.1 ((contMDiffAt_subtype_iff (U := O')
      (f := fun y => if hy : y ∈ O then g ⟨y, hy⟩ else 0)).1 hgy)).contDiffWithinAt
  · have h1 := hg ⟨z, hNO hz⟩
    simp only [t, ite_eq_left hz, mem_singleton_iff] at h1
    show (if hy : z ∈ O then g ⟨z, hy⟩ else 0) = _
    rw [dite_eq_left (hNO hz)]
    exact h1

/-- **Simon Ch. 4, 2.7 and 3.14** (with Ch. 2, 5.9): if `V = v(M, θ)` is stationary in `N ∩ U`,
where `N` is an embedded `C²` submanifold with `(N̄ \ N) ∩ U = ∅` and `Hⁿ(M \ N) = 0`, then `V`
has generalized mean curvature `H` in `U`, bounded on compact subsets of `U`.  Extend
`z ↦ P_{T_zN}` to a `C¹` field `pr` on an open `O ⊇ N` and take `H` with
`H(x) = Σⱼ (Dpr(x)[p eⱼ])*(p eⱼ)` on `N ∩ U`, `p = p_{TₓM}`.  For `X ∈ C¹_c(U)`, the tangential
part `X^T` (equal to `pr·X` near `N`) is tangent to `N` on `N ∩ U`, so `δV(X^T) = 0` and
`δV(X) = δV(X − X^T)`.  At `Hⁿ`-a.e. `x ∈ M`, `x ∈ N` and `TₓM ⊆ TₓN`, so
`div_M(X − X^T)(x) = −X(x)·H(x)`; integrating against `θ` gives `δV(X) = −∫ X·H dμ_V`. -/
theorem Submission.meanCurvature_bounded_of_stationaryAlong : ∀ (P n d : ℕ) (U N : Set (Euclid P)) (R : IMRep U n), IsOpen U → IsEmbeddedSubmanifold 2 d N → (closure N \ N) ∩ U = ∅ → μHE[n] (R.carrier \ N) = 0 → R.IsStationaryAlong N → R.HasLocallyBoundedMeanCurvature := by
  intro P n d U N R hU hN hNU hMN hstat
  -- the `C¹` extension `pr` of `z ↦ P_{T_zN}` to an open set `O ⊇ N`
  obtain ⟨O, pr, hO, hNO, hpr, hprN⟩ :=
    Submission.submanifold_tangentProjection_c1_extension P d N hN
  -- `p(x) = p_{TₓM}` is `Hⁿ⌞M`-a.e. strongly measurable, and `‖p(x)‖ ≤ 1`
  have hp : AEStronglyMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection)
      (μHE[n].restrict R.carrier) := Submission.imrep_approxTangent_starProjection_aesm P n U R
  -- `H` with `H(x) = Σⱼ (Dpr(x)[p eⱼ])*(p eⱼ)` on `N ∩ U`, measurable and bounded on compact
  -- subsets of `U`
  obtain ⟨H, hHm, hHb, hH⟩ := Submission.mcs_exists_meanCurvature_field P
    (μHE[n].restrict R.carrier) U N O pr _ hU hO hNO hpr hNU hp
    fun x => Submodule.starProjection_norm_le _
  -- `T_zN` is a linear subspace for `z ∈ N`, the range of `Dψ` in a chart
  have hTN : ∀ z ∈ N, ∃ T : Submodule ℝ (Euclid P), tangentSpace N z = T := by
    intro z hz
    obtain ⟨V, W, ψ, hV, hW, hzW, hψ, hinj, hψV, hproper, hDψ⟩ := hN z hz
    obtain ⟨v, hv, rfl⟩ : z ∈ ψ '' V := hψV ▸ ⟨hzW, hz⟩
    exact ⟨LinearMap.range (fderiv ℝ ψ v : Euclid d →ₗ[ℝ] Euclid P),
      Submission.chart_tangentSpace_eq_range_fderiv P d 2 N W V ψ v one_le_two hV hW hψ hinj hψV
        hproper hDψ hv⟩
  -- `C²` charts are `C¹` charts
  have hN1 : IsEmbeddedSubmanifold 1 d N := fun y hy => by
    obtain ⟨V, W, ψ, hV, hW, hyW, hψ, h⟩ := hN y hy
    exact ⟨V, W, ψ, hV, hW, hyW, hψ.of_le (by norm_num), h⟩
  -- `Hⁿ⌞M`-a.e. point lies in `N`, as `Hⁿ(M \ N) = 0`
  have hMN' : ∀ᵐ x ∂(μHE[n].restrict R.carrier), x ∈ N := by
    rw [ae_restrict_iff' R.measurableSet_carrier]
    filter_upwards [measure_eq_zero_iff_ae_notMem.1 hMN] with x hx hxM
    by_contra hxN
    exact hx ⟨hxM, hxN⟩
  refine ⟨H, hHm.mono_ac (withDensity_absolutelyContinuous _ _),
    fun K hK hKU => (hHb K hK hKU).imp fun Λ hΛ => ae_of_all _ hΛ, fun X hX hXc hXU => ?_⟩
  -- the tangential part `X^T ∈ C¹_c(U)`, equal to `pr·X` near every point of `N`
  obtain ⟨XT, hXT, hXTc, hXTU, hXTN⟩ :=
    Submission.mcs_exists_c1_field_eq_proj_near P U N O pr X hU hO hNO hpr hNU hX hXc hXU
  -- `X^T(z) = P_{T_zN} X(z) ∈ T_zN` on `N ∩ U`, so `δV(X^T) = 0` by stationarity
  have hXT0 : R.firstVariation XT = 0 := by
    refine hstat XT hXT hXTc hXTU fun z hz => ?_
    obtain ⟨T, hT⟩ := hTN z hz.1
    have hmem : XT z ∈ Submodule.span ℝ (tangentSpace N z) := by
      rw [(hXTN z hz.1).eq_of_nhds, hprN z hz.1]
      exact Submodule.starProjection_apply_mem _ _
    rw [hT, Submodule.span_eq] at hmem
    rwa [hT]
  -- `δV(X) = δV(X^T) + δV(X − X^T) = δV(X − X^T)`
  have hsplit : R.firstVariation X = R.firstVariation (X - XT) := by
    have h := Submission.mcs_firstVariation_add P n U R XT (X - XT) hp hXT hXTc hXTU (hX.sub hXT)
      (hXc.sub hXTc) ((tsupport_sub X XT).trans (union_subset hXU hXTU))
    rwa [add_sub_cancel, hXT0, zero_add] at h
  -- at `Hⁿ⌞M`-a.e. `x`: `x ∈ M ∩ N` and `TₓM ⊆ TₓN`, so `div_M(X − X^T)(x) = −X(x)·H(x)`
  have hdiv : ∀ᵐ x ∂(μHE[n].restrict R.carrier),
      tangentialDivergence n R.carrier (X - XT) x = -inner ℝ (X x) (H x) := by
    filter_upwards [ae_restrict_mem R.measurableSet_carrier, hMN', R.orients]
      with x hxM hxN ⟨Q, hQ, _⟩
    have hex : ∃ Q, HasApproximateTangentSpaceAt n R.carrier x Q := ⟨Q, hQ⟩
    have hTx : HasApproximateTangentSpaceAt n R.carrier x (approxTangentPlane n R.carrier x) := by
      rw [approxTangentPlane, dite_eq_left hex]
      exact hex.choose_spec
    have hQS : approxTangentPlane n R.carrier x ≤ Submodule.span ℝ (tangentSpace N x) :=
      fun u hu => Submodule.subset_span (Submission.approxTangent_le_submanifold_tangentSpace P n d
        N R.carrier x _ hN1 hxN hMN hTx hu)
    have hY : (X - XT) =ᶠ[𝓝 x] fun y => X y - pr y (X y) :=
      (hXTN x hxN).mono fun y hy => by rw [Pi.sub_apply, hy]
    have hprx : DifferentiableAt ℝ pr x :=
      (hpr.differentiableOn one_ne_zero).differentiableAt (hO.mem_nhds (hNO hxN))
    rw [tangentialDivergence, Submission.mcs_trace_normal_part_eq_neg_inner P _ _ pr X (X - XT) x
      hQS (hprN x hxN) hprx (hX.differentiable one_ne_zero x) hY, hH x ⟨hxN, R.carrier_subset hxM⟩]
  -- integrate against `θ`: `∫_M θ div_M(X − X^T) dHⁿ = −∫ X·H dμ_V`
  have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) :=
    (measurable_from_nat (f := fun k : ℕ => (k : ℝ≥0∞))).comp R.measurable_mult
  rw [hsplit, IMRep.firstVariation, IMRep.measure, integral_withDensity_eq_integral_toReal_smul hθ
    (ae_of_all _ fun x => ENNReal.natCast_lt_top _), ← integral_neg]
  refine integral_congr_ae ?_
  filter_upwards [hdiv] with x hx
  rw [hx, ENNReal.toReal_natCast, smul_eq_mul, mul_neg]

/-- **Simon 7.1.2** (chapter-07.txt lines 29–60, with README erratum 1).  For a representation
`R = (M, θ, ξ)` of `T`, `Hⁿ(M ∖ spt T) = 0`, hence `Hⁿ(M ∖ N) = 0` because `spt T ⊆ N`.
Comparing `T` with the competitors `φ_{t#}T` of 1.2 (2), (3), where `φ_t` preserves `N ∩ U` and
is the identity off `spt X` (Ch. 4, 2.1 with `U ∩ N` in place of `U`), shows that `v(M, θ)` is
stationary in `N ∩ U`; stationarity in `N ∩ U` then gives a generalized mean curvature in `U`
that is bounded on compact sets (Ch. 4, 2.7 and 3.14).  The hypothesis `ℓ ≤ k` is not used. -/
theorem Submission.minimizing_implies_stationary : MinimizingImpliesStationary := by
  intro n k ℓ _hℓk U N T hU hN hNcl hTN hmin hbdry R hR
  -- `μ_T(U ∖ spt T) = 0` and `spt T ⊆ N`.
  have hnull : μHE[n] (R.carrier \ N) = 0 :=
    measure_mono_null (Set.sdiff_subset_sdiff_right hTN)
      (Submission.imrep_carrier_sdiff_support_null (n + k) n U T R hU hR)
  have hstat : R.IsStationaryAlong N :=
    Submission.stationaryAlong_of_minimizing_in_submanifold (n + k) n (n + ℓ) U N T R hU hN hNcl
      hmin hbdry hR hnull
  exact ⟨hstat, Submission.meanCurvature_bounded_of_stationaryAlong (n + k) n (n + ℓ) U N R hU hN
    hNcl hnull hstat⟩
/-- **Angle-parametrized unit curve** (step 6 of the parent proof).  Differentiating
`⟨γ, γ⟩ = ‖γ‖² ≡ 1` gives `⟨γ, γ′⟩ = 0`.  With `A = ⟨γ, u⟩ > 0` and `B = ⟨γ, e⟩`, the quotient
and chain rules differentiate `arctan (B / A) ≡ α` to `(1 + (B / A)²)⁻¹ (B′ A − B A′) / A² = 1`,
i.e. `A B′ − B A′ = A² + B²`; the right side is positive, so `γ′ ≠ 0`. -/
theorem Submission.idtp_ccd_scsp_angle_curve : ∀ (P : ℕ) (u e : Euclid P) (s : ℝ) (γ : ℝ → Euclid P), ContDiffOn ℝ 1 γ (Ioo (-s) s) → (∀ α ∈ Ioo (-s) s, ‖γ α‖ = 1 ∧ 0 < inner ℝ (γ α) u ∧ Real.arctan (inner ℝ (γ α) e / inner ℝ (γ α) u) = α) → ∀ α ∈ Ioo (-s) s, inner ℝ (γ α) (deriv γ α) = 0 ∧ inner ℝ (γ α) u * inner ℝ (deriv γ α) e - inner ℝ (γ α) e * inner ℝ (deriv γ α) u = inner ℝ (γ α) u ^ 2 + inner ℝ (γ α) e ^ 2 ∧ deriv γ α ≠ 0 := by
  intro P u e s γ hγ hprop α hα
  -- `(-s, s)` is a neighbourhood of `α` on which `γ` is differentiable
  have hI : Ioo (-s) s ∈ 𝓝 α := Ioo_mem_nhds hα.1 hα.2
  have hd : HasDerivAt γ (deriv γ α) α :=
    ((hγ.differentiableOn one_ne_zero).differentiableAt hI).hasDerivAt
  -- orthogonality: `⟨γ, γ⟩ = ‖γ‖² ≡ 1` near `α`, so its derivative `2 ⟨γ, γ′⟩` vanishes
  have hn1 : (fun t => inner ℝ (γ t) (γ t)) =ᶠ[𝓝 α] fun _ => (1 : ℝ) := by
    filter_upwards [hI] with t ht
    rw [real_inner_self_eq_norm_sq, (hprop t ht).1, one_pow]
  have h0 := (hd.inner ℝ hd).unique ((hasDerivAt_const α (1 : ℝ)).congr_of_eventuallyEq hn1)
  rw [real_inner_comm (γ α) (deriv γ α)] at h0
  have horth : inner ℝ (γ α) (deriv γ α) = 0 := by linarith
  -- the angle: `A = ⟨γ, u⟩`, `B = ⟨γ, e⟩` and `arctan (B / A) ≡ id` near `α`
  have hA : 0 < inner ℝ (γ α) u := (hprop α hα).2.1
  have hAd : HasDerivAt (fun t => inner ℝ (γ t) u) (inner ℝ (deriv γ α) u) α := by
    simpa using hd.inner ℝ (hasDerivAt_const α u)
  have hBd : HasDerivAt (fun t => inner ℝ (γ t) e) (inner ℝ (deriv γ α) e) α := by
    simpa using hd.inner ℝ (hasDerivAt_const α e)
  have hid : (fun t => Real.arctan (((fun t => inner ℝ (γ t) e) / fun t => inner ℝ (γ t) u) t))
      =ᶠ[𝓝 α] fun t => t := by
    filter_upwards [hI] with t ht
    exact (hprop t ht).2.2
  have h1 := ((hBd.div hAd hA.ne').arctan).unique ((hasDerivAt_id' α).congr_of_eventuallyEq hid)
  simp only [Pi.div_apply] at h1
  -- clearing `(1 + (B / A)²) A² = A² + B² > 0` from `h1` gives the angle identity
  have hpos : 0 < inner ℝ (γ α) u ^ 2 + inner ℝ (γ α) e ^ 2 := by positivity
  have hkey : inner ℝ (γ α) u * inner ℝ (deriv γ α) e - inner ℝ (γ α) e * inner ℝ (deriv γ α) u =
      inner ℝ (γ α) u ^ 2 + inner ℝ (γ α) e ^ 2 := by
    field_simp at h1
    linarith
  -- non-degeneracy: `γ′ = 0` would make the left side `0`
  refine ⟨horth, hkey, fun h => ?_⟩
  rw [h, inner_zero_left, inner_zero_left, mul_zero, mul_zero, sub_zero] at hkey
  exact hpos.ne' hkey.symm

/-- **Cone chart** (steps 1–6 of the parent proof).  `Q = span T_pM` (`p = r₀u`) is a plane
containing `u`; pick a unit `e ∈ Q` with `⟨u, e⟩ = 0`, so `Q = span {u, e}`.  The polar
coordinates `F x = (‖x‖, arctan (⟨x, e⟩ / ⟨x, u⟩))` on `U = B_ρ(p) ∩ {⟨x, u⟩ > 0}` have `DF(p)`
injective on `Q`, so `F` has a local inverse `G` on `M` near `p`.  Shrinking to a square
`R_s = (r₀ − s, r₀ + s) × (−s, s)`, put `γ(α) = r₀⁻¹ G(r₀, α)`.  Radial invariance gives
`G(t, α) = tγ(α)` on `R_s`, hence `span T_{tγ(α)}M = span {γ(α), γ′(α)}`; then `γ′(0) ∈ Q`,
`⟨γ′(0), u⟩ = 0` and `⟨γ′(0), e⟩ = 1` (angle curve) give `γ′(0) = e`. -/
theorem Submission.idtp_ccd_scsp_cone_chart : ∀ (P : ℕ) (M : Set (Euclid P)) (u : Euclid P) (r₀ ρ : ℝ), IsEmbeddedSubmanifold 1 2 M → ‖u‖ = 1 → 0 < r₀ → r₀ • u ∈ M → 0 < ρ → (∀ x ∈ M ∩ ball (r₀ • u) ρ, ∀ t : ℝ, 0 < t → t • x ∈ ball (r₀ • u) ρ → t • x ∈ M) → ∃ (e : Euclid P) (s : ℝ) (N : Set (Euclid P)) (γ : ℝ → Euclid P), ‖e‖ = 1 ∧ inner ℝ u e = 0 ∧ 0 < s ∧ s < r₀ ∧ IsOpen N ∧ r₀ • u ∈ N ∧ N ⊆ ball (r₀ • u) ρ ∧ (∀ x ∈ N, 0 < inner ℝ x u) ∧ ContDiffOn ℝ 1 γ (Ioo (-s) s) ∧ γ 0 = u ∧ deriv γ 0 = e ∧ (∀ α ∈ Ioo (-s) s, ‖γ α‖ = 1 ∧ 0 < inner ℝ (γ α) u ∧ Real.arctan (inner ℝ (γ α) e / inner ℝ (γ α) u) = α) ∧ M ∩ N = (fun q : ℝ × ℝ => q.1 • γ q.2) '' (Ioo (r₀ - s) (r₀ + s) ×ˢ Ioo (-s) s) ∧ ∀ t ∈ Ioo (r₀ - s) (r₀ + s), ∀ α ∈ Ioo (-s) s, Submodule.span ℝ (tangentSpace M (t • γ α)) = Submodule.span ℝ {γ α, deriv γ α} := by
  intro P M u r₀ ρ hM hu hr₀ hp hρ hrad
  have huu : inner ℝ u u = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, hu, one_pow]
  -- Step 1: `Q = span T_pM` is a plane containing `p = r₀u`, hence `u`
  obtain ⟨hQ2, hpQ⟩ := Submission.idtp_ccd_scsp_tangent_plane_mem P M (r₀ • u) ρ hM hp hρ hrad
  have huQ : u ∈ Submodule.span ℝ (tangentSpace M (r₀ • u)) := by
    simpa [inv_smul_smul₀ hr₀.ne'] using Submodule.smul_mem _ r₀⁻¹ hpQ
  -- Step 2: a unit `e ∈ Q` with `⟨u, e⟩ = 0`, so that `v = ⟨v, u⟩u + ⟨v, e⟩e` on `Q`
  obtain ⟨e, -, he1, hue, hdec⟩ :=
    Submission.idtp_ccd_scsp_cc_plane_orthonormal P _ u hQ2 huQ hu
  -- Step 3: polar coordinates `F` on `U = B_ρ(p) ∩ {⟨x, u⟩ > 0}`, `DF(p)h = (⟨u, h⟩, ⟨e, h⟩/r₀)`
  obtain ⟨hFcd, hDF⟩ := Submission.idtp_ccd_scsp_cc_polar_map P u e r₀ hu hue hr₀
  set F : Euclid P → Euclid 2 := fun x => !₂[‖x‖, Real.arctan (inner ℝ x e / inner ℝ x u)]
    with hF
  set U : Set (Euclid P) := ball (r₀ • u) ρ ∩ {x | 0 < inner ℝ x u}
  have hUo : IsOpen U := isOpen_ball.inter (isOpen_lt continuous_const (by fun_prop))
  have hpU : r₀ • u ∈ U := by
    refine ⟨mem_ball_self hρ, show 0 < inner ℝ (r₀ • u) u from ?_⟩
    rw [real_inner_smul_left, huu, mul_one]
    exact hr₀
  have hUball : U ⊆ ball (r₀ • u) ρ := inter_subset_left
  have hFU : ContDiffOn ℝ 1 F U := hFcd.mono fun x hx => hx.2
  have hFp : F (r₀ • u) = !₂[r₀, 0] := by
    simp only [hF, norm_smul, Real.norm_eq_abs, abs_of_pos hr₀, hu, mul_one, real_inner_smul_left,
      hue, mul_zero, zero_div, Real.arctan_zero]
  -- Step 4: `DF(p)` is injective on `Q`
  have htrans : ∀ v ∈ Submodule.span ℝ (tangentSpace M (r₀ • u)),
      fderiv ℝ F (r₀ • u) v = 0 → v = 0 := by
    intro v hv hv0
    rw [hDF v] at hv0
    have h0 : inner ℝ u v = (0 : ℝ) := congrArg (fun w : Euclid 2 => w 0) hv0
    have h1 : inner ℝ e v = (0 : ℝ) := by
      have h := congrArg (fun w : Euclid 2 => w 1) hv0
      simpa [hr₀.ne'] using h
    calc v = inner ℝ v u • u + inner ℝ v e • e := hdec v hv
      _ = 0 := by rw [real_inner_comm u v, real_inner_comm e v, h0, h1, zero_smul, zero_smul,
        add_zero]
  -- Step 5: a local inverse `G` of `F` on `M` near `p`
  obtain ⟨O, N₀, G, hO, hN₀, hFpO, hpN₀, hN₀U, hGcd, hGO, hFG, hTG⟩ :=
    Submission.idtp_ccd_scsp_local_inverse P M (r₀ • u) U F hM hp hUo hpU hFU htrans
  have hGp : G (F (r₀ • u)) = r₀ • u := by
    obtain ⟨w, hw, hGw⟩ : r₀ • u ∈ G '' O := by rw [hGO]; exact ⟨hp, hpN₀⟩
    rw [← hGw, hFG w hw]
  -- Step 6: the square `R_s ⊆ O` and `N ⊆ U` with `M ∩ N = G(R_s)`
  obtain ⟨s, N, hs0, hsr₀, hNo, hpN, hNU, hRO, hMN⟩ :=
    Submission.idtp_ccd_scsp_cc_square_shrink P M U N₀ O F G (r₀ • u) r₀ hr₀ hUo
      hFU.continuousOn hO hN₀ hFp hFpO hpN₀ hN₀U hGO hFG
  set R : Set (Euclid 2) := {w : Euclid 2 | w 0 ∈ Ioo (r₀ - s) (r₀ + s) ∧ w 1 ∈ Ioo (-s) s}
  have hRo : IsOpen R :=
    (isOpen_Ioo.preimage (by fun_prop)).inter (isOpen_Ioo.preimage (by fun_prop))
  have hlineR : ∀ α ∈ Ioo (-s) s, (!₂[r₀, α] : Euclid 2) ∈ R := fun α hα =>
    ⟨show r₀ ∈ Ioo (r₀ - s) (r₀ + s) from ⟨by linarith, by linarith⟩, hα⟩
  -- Step 7: the curve `γ(α) = r₀⁻¹ G(r₀, α)`
  set γ : ℝ → Euclid P := fun α => r₀⁻¹ • G !₂[r₀, α]
  have hline : ContDiff ℝ 1 fun α : ℝ => (!₂[r₀, α] : Euclid 2) := by
    rw [contDiff_piLp]
    intro i
    fin_cases i
    · exact contDiff_const
    · exact contDiff_id
  have hγcd : ContDiffOn ℝ 1 γ (Ioo (-s) s) :=
    (hGcd.comp hline.contDiffOn fun α hα => hRO (hlineR α hα)).const_smul r₀⁻¹
  have hγ1 : ∀ α ∈ Ioo (-s) s, ‖γ α‖ = 1 ∧ 0 < inner ℝ (γ α) u ∧
      Real.arctan (inner ℝ (γ α) e / inner ℝ (γ α) u) = α := by
    intro α hα
    have hxN : G !₂[r₀, α] ∈ M ∩ N := by rw [hMN]; exact mem_image_of_mem G (hlineR α hα)
    have hFx : F (G !₂[r₀, α]) = !₂[r₀, α] := hFG _ (hRO (hlineR α hα))
    have hn : ‖G !₂[r₀, α]‖ = r₀ := congrArg (fun z : Euclid 2 => z 0) hFx
    have ha : Real.arctan (inner ℝ (G !₂[r₀, α]) e / inner ℝ (G !₂[r₀, α]) u) = α :=
      congrArg (fun z : Euclid 2 => z 1) hFx
    have hpos : 0 < inner ℝ (G !₂[r₀, α]) u := (hNU hxN.2).2
    refine ⟨?_, ?_, ?_⟩
    · show ‖r₀⁻¹ • G !₂[r₀, α]‖ = 1
      rw [norm_smul, norm_inv, Real.norm_eq_abs, abs_of_pos hr₀, hn, inv_mul_cancel₀ hr₀.ne']
    · show 0 < inner ℝ (r₀⁻¹ • G !₂[r₀, α]) u
      rw [real_inner_smul_left]
      exact mul_pos (inv_pos.mpr hr₀) hpos
    · show Real.arctan (inner ℝ (r₀⁻¹ • G !₂[r₀, α]) e / inner ℝ (r₀⁻¹ • G !₂[r₀, α]) u) = α
      rw [real_inner_smul_left, real_inner_smul_left,
        mul_div_mul_left _ _ (inv_ne_zero hr₀.ne'), ha]
  have hγ0 : γ 0 = u := by
    show r₀⁻¹ • G !₂[r₀, 0] = u
    rw [← hFp, hGp, inv_smul_smul₀ hr₀.ne']
  -- Step 8: radial structure `G(t, α) = tγ(α)` on `R_s`, so `M ∩ N = {tγ(α)}`
  have hγrad : ∀ α ∈ Ioo (-s) s, ‖γ α‖ = 1 ∧ G !₂[r₀, α] = r₀ • γ α ∧
      ∀ t : ℝ, 0 < t → F (t • γ α) = !₂[t, α] := by
    intro α hα
    obtain ⟨hn, -, ha⟩ := hγ1 α hα
    refine ⟨hn, (smul_inv_smul₀ hr₀.ne' _).symm, fun t ht => ?_⟩
    show !₂[‖t • γ α‖, Real.arctan (inner ℝ (t • γ α) e / inner ℝ (t • γ α) u)] = !₂[t, α]
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos ht, hn, mul_one, real_inner_smul_left (γ α) e t,
      real_inner_smul_left (γ α) u t, mul_div_mul_left _ _ ht.ne', ha]
  obtain ⟨hGrad, hMNimg⟩ :=
    Submission.idtp_ccd_scsp_cc_radial_extension P M N (r₀ • u) ρ r₀ s F G γ hs0 hsr₀ hNo
      (hNU.trans hUball) hrad (hGcd.continuousOn.mono hRO) hMN
      (fun w h0 h1 => hFG w (hRO ⟨h0, h1⟩)) hγrad
  -- Step 9: tangent planes `span T_{tγ(α)}M = span {γ(α), γ′(α)}`
  have hTan : ∀ t ∈ Ioo (r₀ - s) (r₀ + s), ∀ α ∈ Ioo (-s) s,
      Submodule.span ℝ (tangentSpace M (t • γ α)) = Submodule.span ℝ {γ α, deriv γ α} := by
    intro t ht α hα
    have hwR : (!₂[t, α] : Euclid 2) ∈ R := ⟨ht, hα⟩
    have hGw : G !₂[t, α] = t • γ α := hGrad _ ht hα
    have hγd : DifferentiableAt ℝ γ α :=
      (hγcd.differentiableOn one_ne_zero).differentiableAt (Ioo_mem_nhds hα.1 hα.2)
    have ht0 : t ≠ 0 := (show 0 < t by linarith [ht.1]).ne'
    rw [← hGw, hTG _ (hRO hwR),
      Submission.idtp_ccd_scsp_cc_scaled_curve_range P γ G R t α hRo hwR
        (fun w hw => hGrad w hw.1 hw.2) hγd ht0, Submodule.span_eq]
  -- Step 10: `γ′(0) ∈ Q = span {u, e}` with `⟨γ′(0), u⟩ = 0` and `⟨γ′(0), e⟩ = 1`, so `γ′(0) = e`
  have h0I : (0 : ℝ) ∈ Ioo (-s) s := ⟨by linarith, hs0⟩
  obtain ⟨horth, hkey, -⟩ := Submission.idtp_ccd_scsp_angle_curve P u e s γ hγcd hγ1 0 h0I
  rw [hγ0, huu, hue] at hkey
  rw [hγ0] at horth
  have hde : inner ℝ (deriv γ 0) e = (1 : ℝ) := by linarith
  have hdQ : deriv γ 0 ∈ Submodule.span ℝ (tangentSpace M (r₀ • u)) := by
    have h := hTan r₀ ⟨by linarith, by linarith⟩ 0 h0I
    rw [hγ0] at h
    rw [h]
    exact Submodule.subset_span (mem_insert_of_mem _ (mem_singleton _))
  have hγ'0 : deriv γ 0 = e := by
    calc deriv γ 0 = inner ℝ (deriv γ 0) u • u + inner ℝ (deriv γ 0) e • e := hdec _ hdQ
      _ = e := by rw [real_inner_comm u, horth, hde, zero_smul, one_smul, zero_add]
  -- Step 11: collect
  exact ⟨e, s, N, γ, he1, hue, hs0, hsr₀, hNo, hpN, hNU.trans hUball, fun x hx => (hNU hx).2,
    hγcd, hγ0, hγ'0, hγ1, hMNimg, hTan⟩
/-- **Area formula for an injective immersion, Gram form** (Simon Ch. 2, 3.1–3.5; step (1b)
of the chart divergence formula in the proof of Simon 7.5.2).  Let `G : ℝᵐ → ℝᴾ` be
differentiable with injective derivative at every point of the Borel set `F` and injective on `F`.
With `eᵢ` the standard basis of `ℝᵐ`, every `h : ℝᴾ → ℝ` has
`∫_{G(F)} h dHᵐ = ∫_F √det(⟨DG(v)eᵢ, DG(v)eⱼ⟩) h(G(v)) dv`.

Linear case (Simon 3.1): an injective linear `B` factors as `ι ∘ C` with `ι` an isometry of `ℝᵐ`
onto `range B`, so `Hᵐ(B S) = |det C| Lᵐ(S)`, and the Gram matrix of `B` is `CᵀC`.  The
approximation argument for 3.2: on countably many Borel pieces of `F`, `G` and (a.e.) `DG` are
`η`-close to an injective linear map, so the Lipschitz bound for `Hᵐ` puts `Hᵐ(G t)` and `∫_t J`
within a factor `(1 + 2η)^{2m}` of each other for Borel `t ⊆ F`.  Letting `η → 0` gives
`Hᵐ(G t) = ∫_t J`, and the integral identity follows as for
`integral_image_eq_integral_abs_det_fderiv_smul`. -/
theorem Submission.codim1_lur_cd_injective_area_formula_gram : ∀ (P m : ℕ) (G : Euclid m → Euclid P) (F : Set (Euclid m)), MeasurableSet F → (∀ v ∈ F, DifferentiableAt ℝ G v) → (∀ v ∈ F, Function.Injective (fderiv ℝ G v)) → InjOn G F → ∀ h : Euclid P → ℝ, ∫ w in G '' F, h w ∂μHE[m] = ∫ v in F, Real.sqrt (Matrix.det (Matrix.of fun i j : Fin m => inner ℝ (fderiv ℝ G v (EuclideanSpace.single i 1)) (fderiv ℝ G v (EuclideanSpace.single j 1)))) * h (G v) := by
  intro P m G F hF hG hreg hinj h
  -- `Jf B = √det(⟨B eᵢ, B eⱼ⟩)`, the Gram Jacobian of a linear map `B : ℝᵐ → ℝᴾ`
  set Jf : (Euclid m →L[ℝ] Euclid P) → ℝ := fun B => Real.sqrt (Matrix.det (Matrix.of
    fun i j : Fin m => inner ℝ (B (EuclideanSpace.single i 1)) (B (EuclideanSpace.single j 1))))
  -- (1) Linear area formula: `B = ι ∘ C` with `ι` an isometry onto `range B`, so
  -- `Hᵐ(B S) = Lᵐ(C S) = |det C| Lᵐ(S)`, and `⟨B eᵢ, B eⱼ⟩ = ⟨C eᵢ, C eⱼ⟩ = (CᵀC)ᵢⱼ`.
  have hlin : ∀ B : Euclid m →L[ℝ] Euclid P, Injective B → ∀ S : Set (Euclid m),
      μHE[m] (B '' S) = ENNReal.ofReal (Jf B) * volume S := by
    intro B hB S
    have hW : Module.finrank ℝ (LinearMap.range (B : Euclid m →ₗ[ℝ] Euclid P)) = m := by
      rw [LinearMap.finrank_range_of_inj hB, finrank_euclideanSpace_fin]
    set b := (stdOrthonormalBasis ℝ (LinearMap.range (B : Euclid m →ₗ[ℝ] Euclid P))).reindex
      (finCongr hW)
    set C : Euclid m →ₗ[ℝ] Euclid m :=
      b.repr.toLinearMap ∘ₗ (B : Euclid m →ₗ[ℝ] Euclid P).rangeRestrict
    have hBC : ∀ x, B x = (b.repr.symm (C x) : Euclid P) := fun x => by simp [C]
    have hι : Isometry fun y => (b.repr.symm y : Euclid P) :=
      isometry_subtype_coe.comp b.repr.symm.isometry
    have hgram : Jf B = |LinearMap.det C| := by
      set e := (EuclideanSpace.basisFun (Fin m) ℝ).toBasis
      have hM : (Matrix.of fun i j : Fin m => inner ℝ (B (EuclideanSpace.single i 1))
          (B (EuclideanSpace.single j 1))) =
          (LinearMap.toMatrix e e C).transpose * LinearMap.toMatrix e e C := by
        ext i j
        rw [Matrix.of_apply, hBC, hBC, ← Submodule.coe_inner, LinearIsometryEquiv.inner_map_map,
          Matrix.mul_apply]
        simp only [Matrix.transpose_apply, LinearMap.toMatrix_apply, e,
          OrthonormalBasis.coe_toBasis, OrthonormalBasis.coe_toBasis_repr_apply,
          EuclideanSpace.basisFun_apply, EuclideanSpace.basisFun_repr, PiLp.inner_apply,
          RCLike.inner_apply, conj_trivial]
        exact Finset.sum_congr rfl fun k _ => mul_comm _ _
      show Real.sqrt _ = _
      rw [hM, Matrix.det_mul, Matrix.det_transpose, LinearMap.det_toMatrix, ← sq,
        Real.sqrt_sq_eq_abs]
    rw [show B '' S = (fun y => (b.repr.symm y : Euclid P)) '' (C '' S) by
        rw [image_image]; exact image_congr fun x _ => hBC x,
      hι.euclideanHausdorffMeasure_image, EuclideanSpace.euclideanHausdorffMeasure_eq_volume,
      Measure.addHaar_image_linearMap, hgram]
  -- (2) Lipschitz comparison: if `‖f x - f y‖ ≤ K ‖g x - g y‖` on `S` and `g` is injective
  -- there, then `Hᵐ(f S) ≤ Kᵐ Hᵐ(g S)` (the Lipschitz bound for `f ∘ g⁻¹` on `g S`).
  have hcmp : ∀ (f g : Euclid m → Euclid P) (S : Set (Euclid m)) (K : NNReal), InjOn g S →
      (∀ x ∈ S, ∀ y ∈ S, ‖f x - f y‖ ≤ K * ‖g x - g y‖) →
      μHE[m] (f '' S) ≤ (K : ℝ≥0∞) ^ m * μHE[m] (g '' S) := by
    intro f g S K hg hfg
    have hθ : ∀ x ∈ S, f (invFunOn g S (g x)) = f x := fun x hx => by
      rw [hg.leftInvOn_invFunOn hx]
    have hlip : LipschitzOnWith K (f ∘ invFunOn g S) (g '' S) := by
      refine LipschitzOnWith.of_dist_le_mul fun a ha b hb => ?_
      obtain ⟨x, hx, rfl⟩ := ha
      obtain ⟨y, hy, rfl⟩ := hb
      rw [comp_apply, comp_apply, hθ x hx, hθ y hy, dist_eq_norm, dist_eq_norm]
      exact hfg x hx y hy
    have himg : f '' S = (f ∘ invFunOn g S) '' (g '' S) := by
      rw [image_image]; exact image_congr fun x hx => (hθ x hx).symm
    have key := hlip.hausdorffMeasure_image_le (d := (m : ℝ)) m.cast_nonneg
    rw [ENNReal.rpow_natCast] at key
    rw [himg, Measure.euclideanHausdorffMeasure_def, Measure.smul_apply, Measure.smul_apply,
      ENNReal.smul_def, ENNReal.smul_def, smul_eq_mul, smul_eq_mul, mul_left_comm]
    exact mul_le_mul_right key _
  -- (3) Jacobian comparison for injective linear maps: (1) and (2) on the unit ball.
  have hjcmp : ∀ (B₁ B₂ : Euclid m →L[ℝ] Euclid P) (K : NNReal), Injective B₁ → Injective B₂ →
      (∀ z, ‖B₁ z‖ ≤ K * ‖B₂ z‖) →
      ENNReal.ofReal (Jf B₁) ≤ (K : ℝ≥0∞) ^ m * ENNReal.ofReal (Jf B₂) := by
    intro B₁ B₂ K h₁ h₂ hB
    have key := hcmp B₁ B₂ (ball 0 1) K h₂.injOn fun x _ y _ => by
      rw [← map_sub, ← map_sub]; exact hB _
    rw [hlin B₁ h₁, hlin B₂ h₂, ← mul_assoc] at key
    exact (ENNReal.mul_le_mul_iff_left (measure_ball_pos volume 0 one_pos).ne'
      measure_ball_lt_top.ne).1 key
  -- (4) If `G` is `δ`-approximated by `A` on `S`, then `‖DG(v) - A‖ ≤ δ` at a.e. `v ∈ S`
  -- (at Lebesgue density points; the argument of `ApproximatesLinearOn.norm_fderiv_sub_le`).
  have hdcl : ∀ (A : Euclid m →L[ℝ] Euclid P) (δ : NNReal) (S : Set (Euclid m)), S ⊆ F →
      MeasurableSet S → ApproximatesLinearOn G A S δ →
      ∀ᵐ v ∂(volume.restrict S), ‖fderiv ℝ G v - A‖ ≤ δ := by
    open scoped Pointwise in
    intro A δ S hSF hS hA
    filter_upwards [Besicovitch.ae_tendsto_measure_inter_div (volume : Measure (Euclid m)) S,
      ae_restrict_mem hS] with x hx xs
    refine ContinuousLinearMap.opNorm_le_bound _ δ.2 fun z => ?_
    suffices H : ∀ ε, 0 < ε → ‖(fderiv ℝ G x - A) z‖ ≤
        (δ + ε) * (‖z‖ + ε) + ‖fderiv ℝ G x - A‖ * ε by
      have : Tendsto (fun ε : ℝ => ((δ : ℝ) + ε) * (‖z‖ + ε) + ‖fderiv ℝ G x - A‖ * ε)
          (𝓝[>] 0) (𝓝 ((δ + 0) * (‖z‖ + 0) + ‖fderiv ℝ G x - A‖ * 0)) :=
        Tendsto.mono_left (Continuous.tendsto (by fun_prop) 0) nhdsWithin_le_nhds
      simp only [add_zero, mul_zero] at this
      apply le_of_tendsto_of_tendsto tendsto_const_nhds this
      filter_upwards [self_mem_nhdsWithin]
      exact H
    intro ε εpos
    have B₁ : ∀ᶠ r in 𝓝[>] (0 : ℝ), (S ∩ ({x} + r • closedBall z ε)).Nonempty :=
      Measure.eventually_nonempty_inter_smul_of_density_one volume S x hx _
        measurableSet_closedBall (measure_closedBall_pos volume z εpos).ne'
    obtain ⟨ρ, ρpos, hρ⟩ : ∃ ρ > 0, ball x ρ ∩ S ⊆
        {y | ‖G y - G x - (fderiv ℝ G x) (y - x)‖ ≤ ε * ‖y - x‖} :=
      mem_nhdsWithin_iff.1 (Asymptotics.isLittleO_iff.1
        ((hG x (hSF xs)).hasFDerivAt.hasFDerivWithinAt (s := S)).isLittleO εpos)
    have B₂ : ∀ᶠ r in 𝓝[>] (0 : ℝ), {x} + r • closedBall z ε ⊆ ball x ρ :=
      nhdsWithin_le_nhds
        (eventually_singleton_add_smul_subset isBounded_closedBall (ball_mem_nhds x ρpos))
    obtain ⟨r, ⟨y, ⟨ys, hy⟩⟩, rρ, rpos⟩ : ∃ r : ℝ, (S ∩ ({x} + r • closedBall z ε)).Nonempty ∧
        {x} + r • closedBall z ε ⊆ ball x ρ ∧ 0 < r :=
      (B₁.and (B₂.and self_mem_nhdsWithin)).exists
    obtain ⟨a, az, ya⟩ : ∃ a, a ∈ closedBall z ε ∧ y = x + r • a := by
      simp only [mem_smul_set, image_add_left, mem_preimage, singleton_add] at hy
      rcases hy with ⟨a, az, ha⟩
      exact ⟨a, az, by simp only [ha, add_neg_cancel_left]⟩
    have norm_a : ‖a‖ ≤ ‖z‖ + ε :=
      calc ‖a‖ = ‖z + (a - z)‖ := by simp only [add_sub_cancel]
        _ ≤ ‖z‖ + ‖a - z‖ := norm_add_le _ _
        _ ≤ ‖z‖ + ε := by grw [mem_closedBall_iff_norm.1 az]
    have I : r * ‖(fderiv ℝ G x - A) a‖ ≤ r * (δ + ε) * (‖z‖ + ε) :=
      calc r * ‖(fderiv ℝ G x - A) a‖ = ‖(fderiv ℝ G x - A) (r • a)‖ := by
            simp only [map_smul, norm_smul, Real.norm_eq_abs, abs_of_nonneg rpos.le]
        _ = ‖G y - G x - A (y - x) - (G y - G x - (fderiv ℝ G x) (y - x))‖ := by
            simp only [ya, add_sub_cancel_left, sub_sub_sub_cancel_left, FunLike.coe_sub,
              Pi.sub_apply, map_smul, smul_sub]
        _ ≤ ‖G y - G x - A (y - x)‖ + ‖G y - G x - (fderiv ℝ G x) (y - x)‖ := norm_sub_le _ _
        _ ≤ δ * ‖y - x‖ + ε * ‖y - x‖ := add_le_add (hA _ ys _ xs) (hρ ⟨rρ hy, ys⟩)
        _ = r * (δ + ε) * ‖a‖ := by
            simp only [ya, add_sub_cancel_left, norm_smul, Real.norm_eq_abs,
              abs_of_nonneg rpos.le]
            ring
        _ ≤ r * (δ + ε) * (‖z‖ + ε) := by gcongr
    calc ‖(fderiv ℝ G x - A) z‖ = ‖(fderiv ℝ G x - A) a + (fderiv ℝ G x - A) (z - a)‖ := by
          congr 1
          simp only [FunLike.coe_sub, map_sub, Pi.sub_apply]
          abel
      _ ≤ ‖(fderiv ℝ G x - A) a‖ + ‖(fderiv ℝ G x - A) (z - a)‖ := norm_add_le _ _
      _ ≤ (δ + ε) * (‖z‖ + ε) + ‖fderiv ℝ G x - A‖ * ‖z - a‖ := by
          apply add_le_add
          · rw [mul_assoc] at I; exact (mul_le_mul_iff_right₀ rpos).1 I
          · apply ContinuousLinearMap.le_opNorm
      _ ≤ (δ + ε) * (‖z‖ + ε) + ‖fderiv ℝ G x - A‖ * ε := by
          rw [mem_closedBall_iff_norm'] at az
          gcongr
  -- (5) A lower bound `‖z‖ ≤ c(A) ‖A z‖` for injective `A`.
  have hmod : ∀ A : Euclid m →L[ℝ] Euclid P, ∃ c : NNReal, 0 < c ∧
      (Injective A → ∀ z, ‖z‖ ≤ c * ‖A z‖) := by
    intro A
    by_cases hA : Injective A
    · obtain ⟨c, cpos, hc⟩ := (A : Euclid m →ₗ[ℝ] Euclid P).exists_antilipschitzWith
        (LinearMap.ker_eq_bot.2 hA)
      exact ⟨c, cpos, fun _ z => by simpa using hc.le_mul_dist z 0⟩
    · exact ⟨1, one_pos, fun h' => absurd h' hA⟩
  choose c cpos hc using hmod
  have hcont : ContinuousOn G F := fun v hv => (hG v hv).continuousAt.continuousWithinAt
  -- (6) For `0 < η ≤ 1/2` and `K = 1 + 2η`, partition a Borel `t ⊆ F` into pieces on which `G`
  -- and (a.e.) `DG` are `η`-close to an injective `A`; then (1)–(3) give two-sided bounds.
  have hpiece : ∀ η : ℝ, 0 < η → η ≤ 1 / 2 → ∀ t ⊆ F, MeasurableSet t →
      μHE[m] (G '' t) ≤ (((1 + 2 * η).toNNReal : ℝ≥0∞) ^ m) ^ 2 *
        ∫⁻ v in t, ENNReal.ofReal (Jf (fderiv ℝ G v)) ∧
      ∫⁻ v in t, ENNReal.ofReal (Jf (fderiv ℝ G v)) ≤
        (((1 + 2 * η).toNNReal : ℝ≥0∞) ^ m) ^ 2 * μHE[m] (G '' t) := by
    intro η ηpos ηle t htF ht
    set K : NNReal := (1 + 2 * η).toNNReal
    have hKr : (K : ℝ) = 1 + 2 * η := Real.coe_toNNReal _ (by linarith)
    have hrel : ∀ u w : Euclid P, ‖u - w‖ ≤ η * ‖w‖ → ‖u‖ ≤ K * ‖w‖ ∧ ‖w‖ ≤ K * ‖u‖ := by
      intro u w huw
      have h1 : ‖u‖ ≤ ‖w‖ + ‖u - w‖ := norm_le_insert' u w
      have h2 : ‖w‖ ≤ ‖u‖ + ‖u - w‖ := by simpa [norm_sub_rev] using norm_le_insert' w u
      have h3 : (1 - η) * ‖w‖ ≤ ‖u‖ := by linarith
      have h4 := mul_le_mul_of_nonneg_left h3 (by linarith : (0 : ℝ) ≤ 1 + 2 * η)
      have h5 : 0 ≤ η * (1 - 2 * η) * ‖w‖ :=
        mul_nonneg (mul_nonneg ηpos.le (by linarith)) (norm_nonneg w)
      rw [hKr]
      constructor <;> nlinarith [norm_nonneg u, norm_nonneg w, mul_nonneg ηpos.le (norm_nonneg w)]
    rcases t.eq_empty_or_nonempty with rfl | tne
    · simp
    obtain ⟨T, A, Tdisj, Tmeas, tT, Tappr, TA⟩ :=
      exists_partition_approximatesLinearOn_of_hasFDerivWithinAt G t (fderiv ℝ G)
        (fun v hv => (hG v (htF hv)).hasFDerivAt.hasFDerivWithinAt)
        (fun B => η.toNNReal / c B) (fun B => (div_pos (Real.toNNReal_pos.2 ηpos) (cpos B)).ne')
    have Ainj : ∀ n, Injective (A n) := fun n => by
      obtain ⟨y, yt, hy⟩ := TA tne n
      rw [hy]; exact hreg y (htF yt)
    have hpc : ∀ n, μHE[m] (G '' (t ∩ T n)) ≤ ((K : ℝ≥0∞) ^ m) ^ 2 *
          ∫⁻ v in t ∩ T n, ENNReal.ofReal (Jf (fderiv ℝ G v)) ∧
        ∫⁻ v in t ∩ T n, ENNReal.ofReal (Jf (fderiv ℝ G v)) ≤
          ((K : ℝ≥0∞) ^ m) ^ 2 * μHE[m] (G '' (t ∩ T n)) := by
      intro n
      have hSF : t ∩ T n ⊆ F := inter_subset_left.trans htF
      have hS : MeasurableSet (t ∩ T n) := ht.inter (Tmeas n)
      have hcpos : (0 : ℝ) < c (A n) := cpos (A n)
      have hc0 : (c (A n) : ℝ) ≠ 0 := hcpos.ne'
      have happ : ∀ x ∈ t ∩ T n, ∀ y ∈ t ∩ T n,
          ‖(G x - G y) - (A n x - A n y)‖ ≤ η * ‖A n x - A n y‖ := by
        intro x hx y hy
        have h1 := Tappr n x hx y hy
        rw [NNReal.coe_div, Real.coe_toNNReal _ ηpos.le] at h1
        have h2 := hc (A n) (Ainj n) (x - y)
        rw [← map_sub]
        calc ‖G x - G y - A n (x - y)‖ ≤ η / c (A n) * ‖x - y‖ := h1
          _ ≤ η / c (A n) * (c (A n) * ‖A n (x - y)‖) := by gcongr
          _ = η * ‖A n (x - y)‖ := by field_simp
      have hder : ∀ᵐ v ∂(volume.restrict (t ∩ T n)), ∀ z,
          ‖fderiv ℝ G v z - A n z‖ ≤ η * ‖A n z‖ := by
        filter_upwards [hdcl (A n) _ (t ∩ T n) hSF hS (Tappr n)] with v hv z
        rw [NNReal.coe_div, Real.coe_toNNReal _ ηpos.le] at hv
        have h2 := hc (A n) (Ainj n) z
        calc ‖fderiv ℝ G v z - A n z‖ = ‖(fderiv ℝ G v - A n) z‖ := rfl
          _ ≤ ‖fderiv ℝ G v - A n‖ * ‖z‖ := (fderiv ℝ G v - A n).le_opNorm z
          _ ≤ η / c (A n) * ‖z‖ := by gcongr
          _ ≤ η / c (A n) * (c (A n) * ‖A n z‖) := by gcongr
          _ = η * ‖A n z‖ := by field_simp
      have hJ : ∀ᵐ v ∂(volume.restrict (t ∩ T n)),
          ENNReal.ofReal (Jf (fderiv ℝ G v)) ≤ (K : ℝ≥0∞) ^ m * ENNReal.ofReal (Jf (A n)) ∧
          ENNReal.ofReal (Jf (A n)) ≤ (K : ℝ≥0∞) ^ m * ENNReal.ofReal (Jf (fderiv ℝ G v)) := by
        filter_upwards [hder, ae_restrict_mem hS] with v hv hvS
        exact ⟨hjcmp _ _ K (hreg v (hSF hvS)) (Ainj n) fun z => (hrel _ _ (hv z)).1,
          hjcmp _ _ K (Ainj n) (hreg v (hSF hvS)) fun z => (hrel _ _ (hv z)).2⟩
      have hup := hcmp G (A n) (t ∩ T n) K (Ainj n).injOn
        fun x hx y hy => (hrel _ _ (happ x hx y hy)).1
      have hlo := hcmp (A n) G (t ∩ T n) K (hinj.mono hSF)
        fun x hx y hy => (hrel _ _ (happ x hx y hy)).2
      rw [hlin (A n) (Ainj n), ← setLIntegral_const] at hup hlo
      have hKtop : (K : ℝ≥0∞) ^ m ≠ ⊤ := ENNReal.pow_ne_top ENNReal.coe_ne_top
      constructor
      · calc μHE[m] (G '' (t ∩ T n))
            ≤ (K : ℝ≥0∞) ^ m * ∫⁻ _ in t ∩ T n, ENNReal.ofReal (Jf (A n)) := hup
          _ ≤ (K : ℝ≥0∞) ^ m * ∫⁻ v in t ∩ T n, (K : ℝ≥0∞) ^ m *
                ENNReal.ofReal (Jf (fderiv ℝ G v)) :=
            mul_le_mul_right (lintegral_mono_ae (hJ.mono fun v hv => hv.2)) _
          _ = _ := by rw [lintegral_const_mul' _ _ hKtop, ← mul_assoc, sq]
      · calc ∫⁻ v in t ∩ T n, ENNReal.ofReal (Jf (fderiv ℝ G v))
            ≤ ∫⁻ _ in t ∩ T n, (K : ℝ≥0∞) ^ m * ENNReal.ofReal (Jf (A n)) :=
            lintegral_mono_ae (hJ.mono fun v hv => hv.1)
          _ = (K : ℝ≥0∞) ^ m * ∫⁻ _ in t ∩ T n, ENNReal.ofReal (Jf (A n)) :=
            lintegral_const_mul' _ _ hKtop
          _ ≤ (K : ℝ≥0∞) ^ m * ((K : ℝ≥0∞) ^ m * μHE[m] (G '' (t ∩ T n))) :=
            mul_le_mul_right hlo _
          _ = _ := by rw [← mul_assoc, sq]
    have hdisj : Pairwise (Disjoint on fun n => t ∩ T n) := fun i j hij =>
      Disjoint.mono inter_subset_right inter_subset_right (Tdisj hij)
    have hunion : t = ⋃ n, t ∩ T n := by rw [← inter_iUnion, inter_eq_left.2 tT]
    have hX : μHE[m] (G '' t) = ∑' n, μHE[m] (G '' (t ∩ T n)) := by
      rw [show G '' t = ⋃ n, G '' (t ∩ T n) by rw [← image_iUnion, ← hunion]]
      exact measure_iUnion (fun i j hij => Disjoint.image (hdisj hij) (hinj.mono htF)
          inter_subset_left inter_subset_left)
        fun n => (ht.inter (Tmeas n)).image_of_continuousOn_injOn
          (hcont.mono (inter_subset_left.trans htF)) (hinj.mono (inter_subset_left.trans htF))
    have hY : ∫⁻ v in t, ENNReal.ofReal (Jf (fderiv ℝ G v)) =
        ∑' n, ∫⁻ v in t ∩ T n, ENNReal.ofReal (Jf (fderiv ℝ G v)) := by
      conv_lhs => rw [hunion]
      exact lintegral_iUnion (fun n => ht.inter (Tmeas n)) hdisj _
    rw [hX, hY, ← ENNReal.tsum_mul_left, ← ENNReal.tsum_mul_left]
    exact ⟨ENNReal.tsum_le_tsum fun n => (hpc n).1, ENNReal.tsum_le_tsum fun n => (hpc n).2⟩
  -- (7) Letting `η → 0`: `Hᵐ(G t) = ∫_t J` for every Borel `t ⊆ F`.
  have hmeas : ∀ t ⊆ F, MeasurableSet t →
      μHE[m] (G '' t) = ∫⁻ v in t, ENNReal.ofReal (Jf (fderiv ℝ G v)) := by
    intro t htF ht
    have hlim : Tendsto (fun η : ℝ => (((1 + 2 * η).toNNReal : ℝ≥0∞) ^ m) ^ 2) (𝓝[>] 0)
        (𝓝 1) := by
      have hc : Continuous fun η : ℝ => ((1 + 2 * η).toNNReal ^ m) ^ 2 :=
        ((continuous_real_toNNReal.comp (by fun_prop)).pow m).pow 2
      simpa using ENNReal.tendsto_coe.2 ((hc.tendsto 0).mono_left nhdsWithin_le_nhds)
    have hev : ∀ᶠ η in 𝓝[>] (0 : ℝ), 0 < η ∧ η ≤ 1 / 2 :=
      Ioc_mem_nhdsGT (by norm_num : (0 : ℝ) < 1 / 2)
    have hlim' : ∀ X : ℝ≥0∞, Tendsto (fun η : ℝ => (((1 + 2 * η).toNNReal : ℝ≥0∞) ^ m) ^ 2 * X)
        (𝓝[>] 0) (𝓝 X) := fun X => by
      simpa using ENNReal.Tendsto.mul_const hlim (Or.inl one_ne_zero)
    apply le_antisymm
    · refine ge_of_tendsto (hlim' _) ?_
      filter_upwards [hev] with η hη
      exact (hpiece η hη.1 hη.2 t htF ht).1
    · refine ge_of_tendsto (hlim' _) ?_
      filter_upwards [hev] with η hη
      exact (hpiece η hη.1 hη.2 t htF ht).2
  -- (8) From the measure identity to the integral identity, as in
  -- `integral_image_eq_integral_abs_det_fderiv_smul`: `G|_F` is a measurable embedding.
  have hJm : Measurable fun v => Jf (fderiv ℝ G v) := by
    have : Continuous Jf := by
      refine Real.continuous_sqrt.comp (Continuous.matrix_det (continuous_matrix fun i j => ?_))
      exact (continuous_id.clm_apply continuous_const).inner
        (continuous_id.clm_apply continuous_const)
    exact this.measurable.comp (measurable_fderiv ℝ G)
  have hemb : MeasurableEmbedding (F.domRestrict G) :=
    { injective := injOn_iff_injective.1 hinj
      measurable := (continuousOn_iff_continuous_domRestrict.1 hcont).measurable
      measurableSet_image' := fun s hs => by
        rw [domRestrict_eq, image_comp]
        exact (hF.subtype_image hs).image_of_continuousOn_injOn
          (hcont.mono (Subtype.coe_image_subset F s)) (hinj.mono (Subtype.coe_image_subset F s)) }
  have hmap : Measure.map (F.domRestrict G) (Measure.comap Subtype.val
      (volume.withDensity fun v => ENNReal.ofReal (Jf (fderiv ℝ G v)))) =
      μHE[m].restrict (G '' F) := by
    ext u hu
    have hpre : MeasurableSet (F.domRestrict G ⁻¹' u) := hemb.measurable hu
    have hset : Subtype.val '' (F.domRestrict G ⁻¹' u) = F ∩ G ⁻¹' u :=
      Subtype.image_preimage_coe F (G ⁻¹' u)
    have htm : MeasurableSet (F ∩ G ⁻¹' u) := hset ▸ hF.subtype_image hpre
    rw [Measure.map_apply hemb.measurable hu,
      Measure.comap_apply _ Subtype.val_injective (fun _ hs => hF.subtype_image hs) _ hpre, hset,
      withDensity_apply _ htm, Measure.restrict_apply hu, ← hmeas _ inter_subset_left htm,
      image_inter_preimage, inter_comm]
  rw [← hmap, hemb.integral_map]
  simp only [domRestrict_apply, ← comp_apply (f := h), ENNReal.ofReal]
  rw [← (MeasurableEmbedding.subtype_coe hF).integral_map, map_comap_subtype_coe hF,
    setIntegral_withDensity_eq_setIntegral_smul₀ hJm.real_toNNReal.aemeasurable _ hF]
  refine setIntegral_congr_fun hF fun v _ => ?_
  rw [NNReal.smul_def, Real.coe_toNNReal _ (Real.sqrt_nonneg _)]
  rfl
/-- **The cone parametrization `G(t, α) = tγ(α)` is an injective immersion** (the regularity
hypotheses of the area formula, Simon Ch. 2, §3, for a piece of a cone over a unit curve; this is
used to show that 2-dimensional area minimizing cones are unions of planes in the proof of
Simon 7.3.3(1), p. 191).  Let `γ` be `C¹` and injective on `I = (-s, s)` with `‖γ‖ = 1`,
`γ ⊥ γ'` and `γ' ≠ 0` there, and let `R = (r₀ - s, r₀ + s) × I`, so `t > r₀ - s > 0` on `R`.
Taking norms in `tγ(α) = t'γ(α')` gives `t = t'`, so `G` is injective on `R`.  By the product rule
`DG(t, α)(a, b) = aγ(α) + tbγ'(α)`, which is injective: pairing with `γ(α)` forces `a = 0`, and
then `tbγ'(α) = 0` forces `b = 0`. -/
theorem Submission.idtp_ccd_scsp_ca_cone_map_regular : ∀ (P : ℕ) (r₀ s : ℝ) (γ : ℝ → Euclid P), 0 < s → s < r₀ → ContDiffOn ℝ 1 γ (Ioo (-s) s) → InjOn γ (Ioo (-s) s) → (∀ α ∈ Ioo (-s) s, ‖γ α‖ = 1 ∧ inner ℝ (γ α) (deriv γ α) = 0 ∧ deriv γ α ≠ 0) → InjOn (fun q : ℝ × ℝ => q.1 • γ q.2) (Ioo (r₀ - s) (r₀ + s) ×ˢ Ioo (-s) s) ∧ ∀ z ∈ Ioo (r₀ - s) (r₀ + s) ×ˢ Ioo (-s) s, DifferentiableAt ℝ (fun q : ℝ × ℝ => q.1 • γ q.2) z ∧ Injective (fderiv ℝ (fun q : ℝ × ℝ => q.1 • γ q.2) z) ∧ fderiv ℝ (fun q : ℝ × ℝ => q.1 • γ q.2) z (1, 0) = γ z.2 ∧ fderiv ℝ (fun q : ℝ × ℝ => q.1 • γ q.2) z (0, 1) = z.1 • deriv γ z.2 := by
  intro P r₀ s γ _ hsr hγ hinj hcurve
  -- (1) `t > r₀ - s > 0` on the box
  have hpos : ∀ t ∈ Ioo (r₀ - s) (r₀ + s), 0 < t := fun t ht => by linarith [ht.1]
  refine ⟨?_, ?_⟩
  · -- (2) taking norms gives `t = t'`; cancelling `t ≠ 0` and injectivity of `γ` give `α = α'`
    rintro ⟨t, α⟩ ⟨ht, hα⟩ ⟨t', α'⟩ ⟨ht', hα'⟩ heq
    simp only at ht hα ht' hα' heq
    have hnorm := congrArg norm heq
    rw [norm_smul, norm_smul, (hcurve α hα).1, (hcurve α' hα').1, Real.norm_eq_abs,
      Real.norm_eq_abs, abs_of_pos (hpos t ht), abs_of_pos (hpos t' ht'), mul_one, mul_one]
      at hnorm
    subst hnorm
    rw [hinj hα hα' (smul_right_injective _ (hpos t ht).ne' heq)]
  · rintro ⟨t, α⟩ ⟨ht, hα⟩
    simp only at ht hα ⊢
    obtain ⟨hnorm, horth, hne⟩ := hcurve α hα
    -- (3) `γ` is differentiable at `α`, being `C¹` on the open interval `I`
    have hdγ : HasDerivAt γ (deriv γ α) α :=
      ((hγ.differentiableOn (by norm_num)).differentiableAt (Ioo_mem_nhds hα.1 hα.2)).hasDerivAt
    -- (4) product and chain rules: `DG(t, α)(a, b) = t b γ'(α) + a γ(α)`
    have h1 : HasFDerivAt (Prod.fst : ℝ × ℝ → ℝ) (ContinuousLinearMap.fst ℝ ℝ ℝ) (t, α) :=
      hasFDerivAt_fst
    have h2 : HasFDerivAt (γ ∘ Prod.snd) ((ContinuousLinearMap.smulRight (1 : ℝ →L[ℝ] ℝ)
        (deriv γ α)).comp (ContinuousLinearMap.snd ℝ ℝ ℝ)) (t, α) :=
      hdγ.hasFDerivAt.comp (t, α) hasFDerivAt_snd
    have hD : HasFDerivAt (fun q : ℝ × ℝ => q.1 • γ q.2) (t • ((ContinuousLinearMap.smulRight
        (1 : ℝ →L[ℝ] ℝ) (deriv γ α)).comp (ContinuousLinearMap.snd ℝ ℝ ℝ)) +
        (ContinuousLinearMap.fst ℝ ℝ ℝ).smulRight (γ α)) (t, α) :=
      h1.smul h2
    -- (5) `DG(1, 0) = γ(α)` and `DG(0, 1) = tγ'(α)`
    rw [hD.fderiv]
    refine ⟨hD.differentiableAt, ?_, by simp, by simp⟩
    -- (6) pairing `DG(a, b) = 0` with `γ(α)` gives `a = 0`; then `t b γ'(α) = 0` gives `b = 0`
    rw [injective_iff_map_eq_zero]
    rintro ⟨a, b⟩ hab
    simp only [add_apply, smul_apply, ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.coe_fst',
      ContinuousLinearMap.coe_snd', one_apply_eq_self] at hab
    have ha : a = 0 := by
      have := congrArg (fun v => inner ℝ (γ α) v) hab
      simpa [inner_add_right, real_inner_smul_right, real_inner_self_eq_norm_sq, hnorm, horth]
        using this
    subst ha
    simp only [zero_smul, add_zero, smul_smul, smul_eq_zero, hne, or_false, mul_eq_zero,
      (hpos t ht).ne', false_or] at hab
    exact Prod.mk_eq_zero.2 ⟨rfl, hab⟩

/-- **Area formula for an injective immersion of a subset of `ℝ × ℝ`** (Simon Ch. 2, 3.1–3.5
with `m = 2`; used for the area of the cone parametrization `(t, α) ↦ t γ(α)`).  Let
`G : ℝ × ℝ → ℝᴾ` be differentiable with injective derivative at every point of the measurable
set `R` and injective on `R`, and write `∂₁G = DG(1, 0)`, `∂₂G = DG(0, 1)`.  Every
`h : ℝᴾ → ℝ` has `∫_{G(R)} h dH² = ∫_R (‖∂₁G‖²‖∂₂G‖² − ⟨∂₁G, ∂₂G⟩²)^{1/2} h(G(q)) dq`.

Transport along the volume-preserving coordinate equivalence `e : ℝ² ≃ ℝ × ℝ`,
`e w = (w₀, w₁)`: apply the Gram form of the area formula to `G ∘ e` on `e⁻¹(R)`, expand the
`2 × 2` Gram determinant, and pull the integral back to `R`. -/
theorem Submission.idtp_ccd_scsp_ca_prod_area_formula : ∀ (P : ℕ) (G : ℝ × ℝ → Euclid P) (R : Set (ℝ × ℝ)) (h : Euclid P → ℝ), MeasurableSet R → (∀ q ∈ R, DifferentiableAt ℝ G q) → (∀ q ∈ R, Injective (fderiv ℝ G q)) → InjOn G R → ∫ x in G '' R, h x ∂μHE[2] = ∫ q in R, Real.sqrt (‖fderiv ℝ G q (1, 0)‖ ^ 2 * ‖fderiv ℝ G q (0, 1)‖ ^ 2 - inner ℝ (fderiv ℝ G q (1, 0)) (fderiv ℝ G q (0, 1)) ^ 2) * h (G q) := by
  intro P G R h hR hG hreg hinj
  -- (1) `e : ℝ² ≃ ℝ × ℝ`, `e w = (w₀, w₁)`, preserves Lebesgue measure
  let e : Euclid 2 ≃L[ℝ] ℝ × ℝ :=
    (EuclideanSpace.equiv (Fin 2) ℝ).trans (ContinuousLinearEquiv.finTwoArrow ℝ ℝ)
  have he : ∀ w, e w = (w 0, w 1) := fun w => rfl
  have hmp : MeasurePreserving e volume volume :=
    (volume_preserving_finTwoArrow ℝ).comp
      (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 2))
  have hemb : MeasurableEmbedding e := e.toHomeomorph.measurableEmbedding
  -- (2) `D(G ∘ e)(w) = DG(e w) ∘ e`, so `G ∘ e` satisfies the Gram area formula on `e⁻¹(R)`,
  -- and `(G ∘ e)(e⁻¹(R)) = G(R)` since `e` is onto
  have hfd : ∀ w, fderiv ℝ (G ∘ e) w = (fderiv ℝ G (e w)).comp (e : Euclid 2 →L[ℝ] ℝ × ℝ) :=
    fun w => e.comp_right_fderiv
  have key := Submission.codim1_lur_cd_injective_area_formula_gram P 2 (G ∘ e) (e ⁻¹' R)
    (e.continuous.measurable hR) (fun w hw => (hG (e w) hw).comp w e.differentiableAt)
    (fun w hw => by rw [hfd]; exact (hreg (e w) hw).comp e.injective)
    (fun w hw w' hw' heq => e.injective (hinj hw hw' heq)) h
  rw [Set.image_comp, Set.image_preimage_eq R e.surjective] at key
  rw [key]
  -- (3) `e e₀ = (1, 0)`, `e e₁ = (0, 1)`, so the `2 × 2` Gram determinant at `w` is
  -- `‖∂₁G‖²‖∂₂G‖² − ⟨∂₁G, ∂₂G⟩²` at `e w`
  have h0 : e (EuclideanSpace.single 0 1) = (1, 0) := by rw [he]; simp
  have h1 : e (EuclideanSpace.single 1 1) = (0, 1) := by rw [he]; simp
  let Ψ : ℝ × ℝ → ℝ := fun q => Real.sqrt (‖fderiv ℝ G q (1, 0)‖ ^ 2 *
    ‖fderiv ℝ G q (0, 1)‖ ^ 2 - inner ℝ (fderiv ℝ G q (1, 0)) (fderiv ℝ G q (0, 1)) ^ 2) * h (G q)
  have hpt : ∀ w : Euclid 2, Real.sqrt (Matrix.det (Matrix.of fun i j : Fin 2 =>
      inner ℝ (fderiv ℝ (G ∘ e) w (EuclideanSpace.single i 1))
        (fderiv ℝ (G ∘ e) w (EuclideanSpace.single j 1)))) * h ((G ∘ e) w) = Ψ (e w) := by
    intro w
    simp only [Ψ, hfd, ContinuousLinearMap.comp_apply, ContinuousLinearEquiv.coe_coe, h0, h1,
      Matrix.det_fin_two, Matrix.of_apply, Function.comp_apply, real_inner_self_eq_norm_sq,
      real_inner_comm (fderiv ℝ G (e w) (1, 0))]
    ring_nf
  -- (4) pull the integral back from `e⁻¹(R)` to `R`
  simp_rw [hpt]
  exact hmp.setIntegral_preimage_emb hemb Ψ R

/-- **Smooth cutoff near a compact set** (step 3 of the parent proof).  Take `δ > 0` with
`cthickening δ K ⊆ N`.  The smooth Urysohn lemma for the closed set `cthickening (δ / 4) K`
inside the open set `thickening (δ / 2) K` gives a `C¹` function `ζ` with
`support ζ = thickening (δ / 2) K` and `ζ = 1` exactly on `cthickening (δ / 4) K`.  Then
`tsupport ζ ⊆ cthickening (δ / 2) K ⊆ N` is a closed subset of a compact set, and
`V = thickening (δ / 4) K` is an open plateau around `K`. -/
theorem Submission.idtp_ccd_scsp_tf_cutoff : ∀ (P : ℕ) (K N : Set (Euclid P)), IsCompact K → IsOpen N → K ⊆ N → ∃ ζ : Euclid P → ℝ, ContDiff ℝ 1 ζ ∧ HasCompactSupport ζ ∧ tsupport ζ ⊆ N ∧ ∃ V : Set (Euclid P), IsOpen V ∧ K ⊆ V ∧ ∀ y ∈ V, ζ y = 1 := by
  intro P K N hK hN hKN
  -- a margin: `cthickening δ K ⊆ N` for some `δ > 0`
  obtain ⟨δ, hδ, hδN⟩ := hK.exists_cthickening_subset_open hN hKN
  -- smooth Urysohn: `ζ = 1` exactly on `cthickening (δ / 4) K`, `support ζ = thickening (δ / 2) K`
  obtain ⟨ζ, hζ, -, hsupp, hone⟩ := exists_contDiff_support_eq_eq_one_iff (n := 1)
    (isOpen_thickening (δ := δ / 2) (E := K)) (isClosed_cthickening (δ := δ / 4) (E := K))
    (cthickening_subset_thickening' (by positivity) (by linarith) K)
  have hts : tsupport ζ ⊆ cthickening (δ / 2) K := by
    rw [tsupport, hsupp]
    exact closure_thickening_subset_cthickening _ _
  -- the plateau `V = thickening (δ / 4) K ⊆ cthickening (δ / 4) K`
  refine ⟨ζ, by exact_mod_cast hζ, ?_, ?_, thickening (δ / 4) K, isOpen_thickening,
    self_subset_thickening (by positivity) K,
    fun y hy => (hone y).1 (thickening_subset_cthickening _ _ hy)⟩
  -- `tsupport ζ` is closed inside the compact set `cthickening (δ / 2) K` (`Euclid P` is proper)
  · exact hK.cthickening.of_isClosed_subset (isClosed_tsupport ζ) hts
  · exact hts.trans ((cthickening_mono (by linarith) K).trans hδN)
/-- **Tangential derivative of the angle–radius profile** (steps 1 and 6(iii) of the parent
proof).  With `a = ⟨x, u⟩ > 0` and `b = ⟨x, e⟩`, the inverse and product rules differentiate
`q = ⟨·, e⟩ / ⟨·, u⟩` to `h ↦ a⁻¹ ⟨h, e⟩ − b (a²)⁻¹ ⟨h, u⟩`, and the chain rule multiplies this
by `(1 + (b / a)²)⁻¹ = a² / (a² + b²)` for `arctan ∘ q`.  The norm `‖y‖ = √(‖y‖²)` has derivative
`h ↦ ⟨x, h⟩ / ‖x‖`, which vanishes for `⟨x, h⟩ = 0`, so the product rule leaves only the angular
term.  `C¹` regularity follows from `a ≠ 0` and `x ≠ 0`. -/
theorem Submission.idtp_ccd_scsp_tf_profile_deriv : ∀ (P : ℕ) (u e x : Euclid P) (φ lam : ℝ → ℝ), ContDiff ℝ 1 φ → ContDiff ℝ 1 lam → 0 < inner ℝ x u → ContDiffAt ℝ 1 (fun y : Euclid P => φ (Real.arctan (inner ℝ y e / inner ℝ y u)) * lam ‖y‖) x ∧ ∀ h : Euclid P, inner ℝ x h = 0 → fderiv ℝ (fun y : Euclid P => φ (Real.arctan (inner ℝ y e / inner ℝ y u)) * lam ‖y‖) x h = deriv φ (Real.arctan (inner ℝ x e / inner ℝ x u)) * lam ‖x‖ * ((inner ℝ x u * inner ℝ h e - inner ℝ x e * inner ℝ h u) / (inner ℝ x u ^ 2 + inner ℝ x e ^ 2)) := by
  intro P u e x φ lam hφ hlam hxu
  -- non-degeneracy: `a = ⟨x, u⟩ ≠ 0`, hence `x ≠ 0`
  have ha : inner ℝ x u ≠ 0 := hxu.ne'
  have hx : x ≠ 0 := by
    rintro rfl
    simp at hxu
  refine ⟨?_, fun h hh => ?_⟩
  · -- `C¹`: a quotient with nonvanishing denominator, `arctan`, and the norm away from `0`
    have hq : ContDiffAt ℝ 1 (fun y : Euclid P => inner ℝ y e / inner ℝ y u) x :=
      (contDiffAt_id.inner ℝ contDiffAt_const).div (contDiffAt_id.inner ℝ contDiffAt_const) ha
    exact (hφ.contDiffAt.comp x hq.arctan).mul (hlam.contDiffAt.comp x (contDiffAt_norm ℝ hx))
  · -- the linear coordinates `y ↦ ⟨y, z⟩` are `innerSL ℝ z`
    have hlin : ∀ z : Euclid P, HasFDerivAt (fun y : Euclid P => inner ℝ y z) (innerSL ℝ z) x := by
      intro z
      have hz : (fun y : Euclid P => inner ℝ y z) = innerSL ℝ z := by
        funext y
        rw [innerSL_apply_apply, real_inner_comm]
      rw [hz]
      exact (innerSL ℝ z).hasFDerivAt
    -- the quotient `q = ⟨·, e⟩ · ⟨·, u⟩⁻¹`
    have hinv : HasFDerivAt (fun y : Euclid P => (inner ℝ y u)⁻¹)
        ((-(inner ℝ x u ^ 2)⁻¹) • innerSL ℝ u) x :=
      (hasDerivAt_inv ha).comp_hasFDerivAt x (hlin u)
    have hq : HasFDerivAt (fun y : Euclid P => inner ℝ y e / inner ℝ y u)
        (inner ℝ x e • ((-(inner ℝ x u ^ 2)⁻¹) • innerSL ℝ u) +
          (inner ℝ x u)⁻¹ • innerSL ℝ e) x := by
      simp only [div_eq_mul_inv]
      exact (hlin e).fun_mul hinv
    -- the angle `arctan ∘ q` and the outer profile `φ`
    have hΦ := (hφ.differentiable one_ne_zero
      (Real.arctan (inner ℝ x e / inner ℝ x u))).hasDerivAt.comp_hasFDerivAt x hq.arctan
    -- the norm `‖y‖ = √(‖y‖²)` and the radial profile `lam`
    have hN : HasFDerivAt (fun y : Euclid P => ‖y‖)
        ((1 / (2 * √(‖x‖ ^ 2))) • (2 • innerSL ℝ x)) x := by
      have hs := (hasStrictFDerivAt_norm_sq x).hasFDerivAt.sqrt
        (pow_ne_zero 2 (norm_ne_zero_iff.2 hx))
      have hfun : (fun y : Euclid P => √(‖y‖ ^ 2)) = fun y => ‖y‖ := by
        funext y
        exact Real.sqrt_sq (norm_nonneg y)
      rwa [hfun] at hs
    have hL := (hlam.differentiable one_ne_zero ‖x‖).hasDerivAt.comp_hasFDerivAt x hN
    -- the product rule; the radial term `⟨x, h⟩ / ‖x‖` vanishes since `⟨x, h⟩ = 0`
    have hF : HasFDerivAt
        (fun y : Euclid P => φ (Real.arctan (inner ℝ y e / inner ℝ y u)) * lam ‖y‖) _ x :=
      hΦ.fun_mul hL
    rw [hF.fderiv]
    simp only [add_apply, smul_apply, innerSL_apply_apply, smul_eq_mul, Function.comp_apply, hh,
      smul_zero, mul_zero, zero_add]
    -- clearing `1 + (b / a)² = (a² + b²) / a²` with `a ≠ 0`
    rw [real_inner_comm h u, real_inner_comm h e]
    field_simp
    ring
/-- **Tangential divergence of the rotation field** (steps 4–5 of the parent proof).  With the
skew map `A y = ⟨y, u⟩ e − ⟨y, e⟩ u`, the field is `X = g • A`, so the product rule gives
`DX(x) h = g(x) A h + (Dg(x) h) A x` at `x = t v`.  The frame formula in the orthonormal frame
`(v, w)` of `Q` gives `tr(p_Q ∘ DX(x)) = ⟨v, DX(x) v⟩ + ⟨w, DX(x) w⟩`; skewness `⟨z, A z⟩ = 0`
and `A x = t A v` leave only `(Dg(x) w) t ⟨w, A v⟩`. -/
theorem Submission.idtp_ccd_scsp_tf_rotation_trace : ∀ (P : ℕ) (u e v w : Euclid P) (Q : Submodule ℝ (Euclid P)) (g : Euclid P → ℝ) (t : ℝ), Orthonormal ℝ ![v, w] → Submodule.span ℝ (Set.range ![v, w]) = Q → DifferentiableAt ℝ g (t • v) → LinearMap.trace ℝ (Euclid P) (Q.starProjection.toLinearMap ∘ₗ (fderiv ℝ (fun y : Euclid P => g y • (inner ℝ y u • e - inner ℝ y e • u)) (t • v)).toLinearMap) = fderiv ℝ g (t • v) w * (t * (inner ℝ v u * inner ℝ w e - inner ℝ v e * inner ℝ w u)) := by
  intro P u e v w Q g t hτ hQ hg
  -- the skew continuous linear map `A y = ⟪y, u⟫ e - ⟪y, e⟫ u`, so that `X = g • A`
  obtain ⟨A, hA⟩ : ∃ A : Euclid P →L[ℝ] Euclid P,
      ∀ y, A y = inner ℝ y u • e - inner ℝ y e • u :=
    ⟨(innerSL ℝ u).smulRight e - (innerSL ℝ e).smulRight u, fun y => by simp [real_inner_comm]⟩
  have hX : (fun y : Euclid P => g y • (inner ℝ y u • e - inner ℝ y e • u)) =
      fun y => g y • A y := by
    funext y
    rw [hA]
  -- product rule: `DX(x) = g(x) A + Dg(x) ⊗ A x`
  have hD : HasFDerivAt (fun y : Euclid P => g y • A y)
      (g (t • v) • A + (fderiv ℝ g (t • v)).smulRight (A (t • v))) (t • v) :=
    hg.hasFDerivAt.smul A.hasFDerivAt
  -- frame formula in the orthonormal frame `(v, w)` of `Q`, then expand the two diagonal entries
  rw [Submission.fvmb_trace_starProjection_comp_eq_sum_inner P 2 Q ![v, w] _ hτ hQ, hX, hD.fderiv]
  simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, add_apply, smul_apply,
    ContinuousLinearMap.smulRight_apply, hA, inner_add_right, inner_sub_right, inner_smul_right,
    real_inner_smul_left]
  ring

/-- **Test field on the cone over `γ`** (steps 7–8 of the parent proof).  Let
`A y = ⟨y, u⟩ e − ⟨y, e⟩ u`, `F y = φ(arctan(⟨y, e⟩ / ⟨y, u⟩)) λ(‖y‖)`, and let `ζ` be a `C¹`
cutoff with compact support in `N` and `ζ ≡ 1` near the compact set
`K₀ = {t γ(α) : t ∈ spt λ, α ∈ spt φ} ⊆ N`; then `X = F ζ A`.  In the orthonormal frame
`(γ, τ = γ′/‖γ′‖)` of `T(t γ)` the trace is `D(F ζ)(t γ) τ · t ⟨A γ, τ⟩`, where
`D(F ζ)(t γ) τ = DF(t γ) τ` (`ζ ≡ 1` near `K₀`, while off `K₀` both `F(t γ)` and `DF(t γ) τ`
vanish) and `⟨A γ, γ′⟩ = ⟨γ, u⟩² + ⟨γ, e⟩²`. -/
theorem Submission.idtp_ccd_scsp_test_field : ∀ (P : ℕ) (u e : Euclid P) (r₀ s : ℝ) (N : Set (Euclid P)) (γ : ℝ → Euclid P) (T : Euclid P → Submodule ℝ (Euclid P)) (lam φ : ℝ → ℝ), ‖u‖ = 1 → ‖e‖ = 1 → inner ℝ u e = 0 → 0 < s → s < r₀ → IsOpen N → (∀ x ∈ N, 0 < inner ℝ x u) → ContDiffOn ℝ 1 γ (Ioo (-s) s) → (∀ α ∈ Ioo (-s) s, ‖γ α‖ = 1 ∧ 0 < inner ℝ (γ α) u ∧ Real.arctan (inner ℝ (γ α) e / inner ℝ (γ α) u) = α) → (∀ t ∈ Ioo (r₀ - s) (r₀ + s), ∀ α ∈ Ioo (-s) s, t • γ α ∈ N ∧ T (t • γ α) = Submodule.span ℝ {γ α, deriv γ α}) → ContDiff ℝ 1 lam → HasCompactSupport lam → tsupport lam ⊆ Ioo (r₀ - s) (r₀ + s) → ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ Ioo (-s) s → ∃ X : Euclid P → Euclid P, ContDiff ℝ 1 X ∧ HasCompactSupport X ∧ tsupport X ⊆ N ∧ ∀ t ∈ Ioo (r₀ - s) (r₀ + s), ∀ α ∈ Ioo (-s) s, LinearMap.trace ℝ (Euclid P) ((T (t • γ α)).starProjection.toLinearMap ∘ₗ (fderiv ℝ X (t • γ α)).toLinearMap) = lam t * deriv φ α * ((inner ℝ (γ α) u ^ 2 + inner ℝ (γ α) e ^ 2) / ‖deriv γ α‖ ^ 2) := by
  intro P u e r₀ s N γ T lam φ _ _ _ _ hsr hN hNu hγ hγp hTN hlam hlamc hlams hφ hφc hφs
  -- `K₀ = {t γ(α) : t ∈ tsupport λ, α ∈ tsupport φ}` is a compact subset of `N`
  have hK₀ : IsCompact ((fun p : ℝ × ℝ => p.1 • γ p.2) '' (tsupport lam ×ˢ tsupport φ)) :=
    (hlamc.isCompact.prod hφc.isCompact).image_of_continuousOn
      (continuousOn_fst.smul (hγ.continuousOn.comp continuousOn_snd fun p hp => hφs hp.2))
  have hK₀N : (fun p : ℝ × ℝ => p.1 • γ p.2) '' (tsupport lam ×ˢ tsupport φ) ⊆ N := by
    rintro _ ⟨p, hp, rfl⟩
    exact (hTN p.1 (hlams hp.1) p.2 (hφs hp.2)).1
  -- a `C¹` cutoff `ζ` with compact support in `N` and `ζ ≡ 1` on an open `V ⊇ K₀`
  obtain ⟨ζ, hζ, hζc, hζN, V, hVo, hKV, hζV⟩ :=
    Submission.idtp_ccd_scsp_tf_cutoff P _ N hK₀ hN hK₀N
  -- the profile `F(y) = φ(arctan(⟨y, e⟩ / ⟨y, u⟩)) λ(‖y‖)` and the coefficient `g = F ζ`
  obtain ⟨F, hFdef⟩ : ∃ F : Euclid P → ℝ,
      F = fun y => φ (Real.arctan (inner ℝ y e / inner ℝ y u)) * lam ‖y‖ := ⟨_, rfl⟩
  have hF : ∀ x : Euclid P, 0 < inner ℝ x u → ContDiffAt ℝ 1 F x ∧ ∀ h : Euclid P,
      inner ℝ x h = 0 → fderiv ℝ F x h = deriv φ (Real.arctan (inner ℝ x e / inner ℝ x u)) *
        lam ‖x‖ * ((inner ℝ x u * inner ℝ h e - inner ℝ x e * inner ℝ h u) /
          (inner ℝ x u ^ 2 + inner ℝ x e ^ 2)) := by
    intro x hx
    rw [hFdef]
    exact Submission.idtp_ccd_scsp_tf_profile_deriv P u e x φ lam hφ hlam hx
  obtain ⟨g, hgdef⟩ : ∃ g : Euclid P → ℝ, g = fun y => F y * ζ y := ⟨_, rfl⟩
  -- `g` is `C¹`: both factors are `C¹` near points of `N ⊆ {⟨·, u⟩ > 0}`, and `g` vanishes near
  -- every point off `tsupport ζ ⊆ N`
  have hg : ContDiff ℝ 1 g := by
    rw [contDiff_iff_contDiffAt]
    intro y
    by_cases hy : y ∈ N
    · rw [hgdef]
      exact (hF y (hNu y hy)).1.mul hζ.contDiffAt
    · have h0 : g =ᶠ[𝓝 y] fun _ => 0 := by
        filter_upwards [notMem_tsupport_iff_eventuallyEq.mp fun h => hy (hζN h)] with z hz
        simp [hgdef, hz]
      exact contDiffAt_const.congr_of_eventuallyEq h0
  have hXζ : support (fun y => g y • (inner ℝ y u • e - inner ℝ y e • u)) ⊆ support ζ := by
    intro y hy
    rw [mem_support] at hy ⊢
    intro h
    apply hy
    simp [hgdef, h]
  -- the field `X(y) = g(y) (⟨y, u⟩ e - ⟨y, e⟩ u)`
  refine ⟨fun y => g y • (inner ℝ y u • e - inner ℝ y e • u), ?_, hζc.mono hXζ,
    (closure_mono hXζ).trans hζN, ?_⟩
  · exact hg.smul (((contDiff_id.inner ℝ contDiff_const).smul contDiff_const).sub
      ((contDiff_id.inner ℝ contDiff_const).smul contDiff_const))
  intro t ht α hα
  obtain ⟨-, hTx⟩ := hTN t ht α hα
  obtain ⟨hγ1, hγu, hγarc⟩ := hγp α hα
  obtain ⟨horth, hkey, hne⟩ := Submission.idtp_ccd_scsp_angle_curve P u e s γ hγ hγp α hα
  have ht0 : 0 < t := by linarith [ht.1]
  have hc : 0 < ‖deriv γ α‖ := norm_pos_iff.mpr hne
  -- the orthonormal frame `(γ(α), τ)` of `T(t γ(α))`, `τ = γ′(α) / ‖γ′(α)‖`
  obtain ⟨τ, hτ⟩ : ∃ τ : Euclid P, τ = ‖deriv γ α‖⁻¹ • deriv γ α := ⟨_, rfl⟩
  have hτ1 : ‖τ‖ = 1 := by
    rw [hτ, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hc.ne']
  have hγτ : inner ℝ (γ α) τ = 0 := by
    rw [hτ, real_inner_smul_right, horth, mul_zero]
  have hon : Orthonormal ℝ ![γ α, τ] := by
    simp [orthonormal_vecCons_iff, hγ1, hτ1, hγτ]
  have hspan : Submodule.span ℝ (Set.range ![γ α, τ]) = T (t • γ α) := by
    rw [hTx, Matrix.range_cons, Matrix.range_cons, Matrix.range_empty, Set.union_empty,
      Set.singleton_union, Submodule.span_insert, Submodule.span_insert, hτ,
      Submodule.span_singleton_smul_eq (inv_pos.mpr hc).ne'.isUnit]
  refine (Submission.idtp_ccd_scsp_tf_rotation_trace P u e (γ α) τ (T (t • γ α)) g t hon hspan
    (hg.differentiable one_ne_zero _)).trans ?_
  -- the point `x = t γ(α)`: `⟨x, u⟩ > 0`, `‖x‖ = t`, `arctan(⟨x, e⟩ / ⟨x, u⟩) = α`, `x ⊥ τ`
  have hxu : 0 < inner ℝ (t • γ α) u := by
    rw [real_inner_smul_left]
    positivity
  have hnx : ‖t • γ α‖ = t := by
    rw [norm_smul, hγ1, mul_one, Real.norm_of_nonneg ht0.le]
  have hfx : Real.arctan (inner ℝ (t • γ α) e / inner ℝ (t • γ α) u) = α := by
    rw [real_inner_smul_left, real_inner_smul_left, mul_div_mul_left _ _ ht0.ne', hγarc]
  have hxτ : inner ℝ (t • γ α) τ = 0 := by
    rw [real_inner_smul_left, hγτ, mul_zero]
  obtain ⟨hFx, hDFx⟩ := hF (t • γ α) hxu
  have hDF := hDFx τ hxτ
  rw [hfx, hnx] at hDF
  -- `Dg(x) τ = DF(x) τ`: if `x ∈ V` then `ζ ≡ 1` near `x`; otherwise `(t, α)` lies outside
  -- `tsupport λ × tsupport φ`, so `F(x) = 0` and `DF(x) τ = 0`
  have hDg : fderiv ℝ g (t • γ α) τ = fderiv ℝ F (t • γ α) τ := by
    by_cases hxV : t • γ α ∈ V
    · have hgF : g =ᶠ[𝓝 (t • γ α)] F := by
        filter_upwards [hVo.mem_nhds hxV] with y hy
        simp only [hgdef, hζV y hy, mul_one]
      rw [hgF.fderiv_eq]
    · have hnot : lam t = 0 ∨ (φ α = 0 ∧ deriv φ α = 0) := by
        by_cases hlt : t ∈ tsupport lam
        · have hαφ : α ∉ tsupport φ := fun h => hxV (hKV ⟨(t, α), ⟨hlt, h⟩, rfl⟩)
          exact Or.inr ⟨image_eq_zero_of_notMem_tsupport hαφ,
            notMem_support.mp fun h => hαφ (support_deriv_subset h)⟩
        · exact Or.inl (image_eq_zero_of_notMem_tsupport hlt)
      have hF0 : F (t • γ α) = 0 := by
        simp only [hFdef]
        rw [hfx, hnx]
        rcases hnot with h | h
        · rw [h, mul_zero]
        · rw [h.1, zero_mul]
      have hDF0 : fderiv ℝ F (t • γ α) τ = 0 := by
        rw [hDF]
        rcases hnot with h | h
        · rw [h, mul_zero, zero_mul]
        · rw [h.2, zero_mul, zero_mul]
      rw [hgdef, fderiv_fun_mul (hFx.differentiableAt one_ne_zero)
        (hζ.differentiable one_ne_zero _)]
      simp [hF0, hDF0]
  rw [hDg, hDF, hτ]
  simp only [real_inner_smul_left]
  set A := inner ℝ (γ α) u
  set B := inner ℝ (γ α) e
  set a := inner ℝ (deriv γ α) u
  set b := inner ℝ (deriv γ α) e
  set c := ‖deriv γ α‖
  have hq : 0 < A ^ 2 + B ^ 2 := by positivity
  rw [show t * A * (c⁻¹ * b) - t * B * (c⁻¹ * a) = t * c⁻¹ * (A ^ 2 + B ^ 2) by
      rw [← hkey]; ring,
    show A * (c⁻¹ * b) - B * (c⁻¹ * a) = c⁻¹ * (A ^ 2 + B ^ 2) by rw [← hkey]; ring,
    show (t * A) ^ 2 + (t * B) ^ 2 = t ^ 2 * (A ^ 2 + B ^ 2) by ring]
  field_simp

/-- **Stationarity of a cone over a unit curve gives a weak conservation law** (the
separation-of-variables step in the planarity of a stationary, radially invariant `C¹` sheet, used
for the 2-dimensional tangent cones in the proof of Simon 7.3.3).  Let
`S = {tγ(α) : t ∈ (r₀ − s, r₀ + s), α ∈ (−s, s)}`, where the unit `C¹` curve `γ` has angle `α`
in the `(u, e)`-plane, and `T(tγ(α)) = span{γ(α), γ′(α)}`.  If `∫_S tr(P_T ∘ DX) dH² = 0` for
every admissible `X`, then `∫ φ′κ = 0` for `κ = (⟨γ,u⟩² + ⟨γ,e⟩²)/‖γ′‖`: test with the field of
`idtp_ccd_scsp_test_field` built from a radial bump `λ`, pull back to the parameter rectangle by
the area formula `idtp_ccd_scsp_cone_area`, and separate variables,
`0 = (∫ tλ(t) dt) · ∫ φ′κ` with `∫ tλ(t) dt > 0`. -/
theorem Submission.idtp_ccd_scsp_cone_conservation : ∀ (P : ℕ) (u e : Euclid P) (r₀ s : ℝ) (N : Set (Euclid P)) (γ : ℝ → Euclid P) (T : Euclid P → Submodule ℝ (Euclid P)), ‖u‖ = 1 → ‖e‖ = 1 → inner ℝ u e = 0 → 0 < s → s < r₀ → IsOpen N → (∀ x ∈ N, 0 < inner ℝ x u) → ContDiffOn ℝ 1 γ (Ioo (-s) s) → (∀ α ∈ Ioo (-s) s, ‖γ α‖ = 1 ∧ 0 < inner ℝ (γ α) u ∧ Real.arctan (inner ℝ (γ α) e / inner ℝ (γ α) u) = α) → (∀ t ∈ Ioo (r₀ - s) (r₀ + s), ∀ α ∈ Ioo (-s) s, t • γ α ∈ N ∧ T (t • γ α) = Submodule.span ℝ {γ α, deriv γ α}) → (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ N → ∫ x in (fun q : ℝ × ℝ => q.1 • γ q.2) '' (Ioo (r₀ - s) (r₀ + s) ×ˢ Ioo (-s) s), LinearMap.trace ℝ (Euclid P) ((T x).starProjection.toLinearMap ∘ₗ (fderiv ℝ X x).toLinearMap) ∂μHE[2] = 0) → ∀ φ : ℝ → ℝ, ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ Ioo (-s) s → ∫ α, deriv φ α * ((inner ℝ (γ α) u ^ 2 + inner ℝ (γ α) e ^ 2) / ‖deriv γ α‖) = 0 := by
  intro P u e r₀ s N γ T hu he hue hs hsr hN hNu hγ hγα hcone hstat φ hφ hφc hφs
  -- radial weight `λ`: a bump at `r₀` with radii `s / 4 < s / 2`, supported in `(r₀ - s, r₀ + s)`
  let b : ContDiffBump r₀ := ⟨s / 4, s / 2, by positivity, by linarith⟩
  have hb_supp : tsupport b ⊆ Ioo (r₀ - s) (r₀ + s) := by
    rw [b.tsupport_eq, Real.closedBall_eq_Icc]
    exact Icc_subset_Ioo (by change r₀ - s < r₀ - s / 2; linarith)
      (by change r₀ + s / 2 < r₀ + s; linarith)
  -- test field `X` with `tr (P_T ∘ DX)(tγ(α)) = λ(t) φ′(α) (⟨γ,u⟩² + ⟨γ,e⟩²) / ‖γ′(α)‖²`
  obtain ⟨X, hX1, hXc, hXN, hXtr⟩ := Submission.idtp_ccd_scsp_test_field P u e r₀ s N γ T b φ
    hu he hue hs hsr hN hNu hγ hγα hcone b.contDiff b.hasCompactSupport hb_supp hφ hφc hφs
  -- `⟨γ, γ′⟩ = 0`, `γ′ ≠ 0`; `γ` is injective on `(-s, s)` since the angle of `γ(α)` is `α`
  have hcurve := Submission.idtp_ccd_scsp_angle_curve P u e s γ hγ hγα
  have hinj : InjOn γ (Ioo (-s) s) := fun a ha a' ha' haa' => by
    rw [← (hγα a ha).2.2, ← (hγα a' ha').2.2, haa']
  -- the area formula of `idtp_ccd_scsp_cone_area` (declared after `main_theorem`, hence proved
  -- here from its two parts): `G(t, α) = tγ(α)` is injective on `R` with injective derivative,
  -- `∂₁G = γ(α)` and `∂₂G = tγ′(α)`
  have hR : MeasurableSet (Ioo (r₀ - s) (r₀ + s) ×ˢ Ioo (-s) s) :=
    measurableSet_Ioo.prod measurableSet_Ioo
  obtain ⟨hGinj, hreg⟩ := Submission.idtp_ccd_scsp_ca_cone_map_regular P r₀ s γ hs hsr hγ hinj
    fun α hα => ⟨(hγα α hα).1, (hcurve α hα).1, (hcurve α hα).2.2⟩
  -- stationarity, pulled back to the parameter rectangle by the area formula
  have h0 := hstat X hX1 hXc hXN
  rw [Submission.idtp_ccd_scsp_ca_prod_area_formula P (fun q : ℝ × ℝ => q.1 • γ q.2) _
    (fun x => LinearMap.trace ℝ (Euclid P)
      ((T x).starProjection.toLinearMap ∘ₗ (fderiv ℝ X x).toLinearMap)) hR
    (fun z hz => (hreg z hz).1) (fun z hz => (hreg z hz).2.1) hGinj] at h0
  -- separation of variables (the Jacobian is `t‖γ′(α)‖`): `0 = (∫ tλ(t) dt) · ∫_{(-s, s)} φ′κ`
  rw [setIntegral_congr_fun hR
    (g := fun q : ℝ × ℝ => (q.1 * b q.1) *
      (deriv φ q.2 * ((inner ℝ (γ q.2) u ^ 2 + inner ℝ (γ q.2) e ^ 2) / ‖deriv γ q.2‖))) ?_,
    Measure.volume_eq_prod, setIntegral_prod_mul (fun t => t * b t)
      (fun α => deriv φ α * ((inner ℝ (γ α) u ^ 2 + inner ℝ (γ α) e ^ 2) / ‖deriv γ α‖))] at h0
  swap
  · rintro ⟨t, α⟩ ⟨ht, hα⟩
    obtain ⟨-, -, h10, h01⟩ := hreg (t, α) ⟨ht, hα⟩
    have ht0 : 0 < t := by linarith [ht.1]
    have hne : ‖deriv γ α‖ ≠ 0 := norm_ne_zero_iff.mpr (hcurve α hα).2.2
    have hJ : (1 : ℝ) ^ 2 * (t * ‖deriv γ α‖) ^ 2 - (t * 0) ^ 2 = (t * ‖deriv γ α‖) ^ 2 := by
      ring
    simp only at h10 h01 ⊢
    rw [h10, h01, (hγα α hα).1, norm_smul, Real.norm_eq_abs, abs_of_pos ht0,
      real_inner_smul_right, (hcurve α hα).1, hJ, Real.sqrt_sq (mul_nonneg ht0.le (norm_nonneg _)),
      hXtr t ht α hα]
    field_simp
  -- the radial factor is positive: `tλ(t) ≥ 0` on `(r₀ - s, r₀ + s)`, `> 0` on `(r₀ ± s / 2)`
  have hpos : 0 < ∫ t in Ioo (r₀ - s) (r₀ + s), t * b t := by
    have hint : Integrable fun t : ℝ => t * b t :=
      (continuous_id.mul b.continuous).integrable_of_hasCompactSupport
        (b.hasCompactSupport.mul_left (f := fun t : ℝ => t))
    rw [setIntegral_pos_iff_support_of_nonneg_ae
      (ae_restrict_of_forall_mem measurableSet_Ioo fun t ht =>
        mul_nonneg (by linarith [ht.1] : (0 : ℝ) ≤ t) b.nonneg) hint.integrableOn]
    calc (0 : ℝ≥0∞) < volume (Ioo (r₀ - s / 2) (r₀ + s / 2)) := by
          rw [Real.volume_Ioo]; exact ENNReal.ofReal_pos.mpr (by linarith)
      _ ≤ volume (support (fun t => t * b t) ∩ Ioo (r₀ - s) (r₀ + s)) := by
          refine measure_mono fun t ht => ⟨?_, by constructor <;> linarith [ht.1, ht.2]⟩
          have hbt : 0 < b t := b.pos_of_mem_ball (by rw [Real.ball_eq_Ioo]; exact ht)
          exact (mul_pos (by linarith [ht.1]) hbt).ne'
  -- `φ′κ` vanishes off `tsupport φ ⊆ (-s, s)`
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero (s := Ioo (-s) s) fun α hα => by
    rw [deriv_of_notMem_tsupport fun h => hα (hφs h), zero_mul]]
  exact (mul_eq_zero.mp h0).resolve_left hpos.ne'
/-- **Integrability of `χ κ`.**  If `κ` is continuous on `(a, b)` and `χ` is continuous with
compact support `tsupport χ ⊆ (a, b)`, then `x ↦ χ x * κ x` is integrable on `ℝ`: it is
continuous on the compact set `K = tsupport χ`, hence integrable on `K`, and it vanishes
off `K`. -/
theorem Submission.idtp_ccd_scsp_dbr_integrable : ∀ (a b : ℝ) (κ χ : ℝ → ℝ), ContinuousOn κ (Ioo a b) → Continuous χ → HasCompactSupport χ → tsupport χ ⊆ Ioo a b → Integrable (fun x => χ x * κ x) := by
  intro a b κ χ hκ hχ hχc hsupp
  -- `χ κ` is continuous on the compact set `K = tsupport χ ⊆ (a, b)`, so integrable on `K`
  have hK : IntegrableOn (fun x => χ x * κ x) (tsupport χ) :=
    (hχ.continuousOn.mul (hκ.mono hsupp)).integrableOn_compact hχc.isCompact
  -- off `K` we have `χ x = 0`, so `χ x * κ x = 0`
  exact hK.integrable_of_forall_notMem_eq_zero fun x hx => by
    rw [image_eq_zero_of_notMem_tsupport hx, zero_mul]
/-- **Normalized smooth bump in an open interval.**  For `a < b` there is a `C^∞` function
`η : ℝ → ℝ` with compact support, `tsupport η ⊆ (a, b)` and `∫ η = 1`: normalize the
`ContDiffBump` `β` centred at `m = (a + b)/2` with radii `(b - a)/8 < ρ = (b - a)/4`, whose
closed support `[m - ρ, m + ρ]` lies in `(a, b)` and whose integral is positive. -/
theorem Submission.idtp_ccd_scsp_dbr_normalized_bump : ∀ (a b : ℝ), a < b → ∃ η : ℝ → ℝ, ContDiff ℝ (⊤ : ℕ∞) η ∧ HasCompactSupport η ∧ tsupport η ⊆ Ioo a b ∧ ∫ x, η x = 1 := by
  intro a b hab
  -- `β`: the bump centred at `m = (a + b)/2`, equal to `1` on radius `(b - a)/8` and
  -- supported in radius `ρ = (b - a)/4`
  let β : ContDiffBump ((a + b) / 2) := ⟨(b - a) / 8, (b - a) / 4, by linarith, by linarith⟩
  -- `tsupport β = [m - ρ, m + ρ] ⊆ (a, b)`
  have hsupp : tsupport β ⊆ Ioo a b := by
    rw [β.tsupport_eq]
    intro x hx
    rw [mem_closedBall, Real.dist_eq, abs_le] at hx
    change -((b - a) / 4) ≤ x - (a + b) / 2 ∧ x - (a + b) / 2 ≤ (b - a) / 4 at hx
    constructor <;> linarith [hx.1, hx.2]
  -- `∫ β > 0`: `β ≥ 0` is integrable and its support `ball(m, ρ)` has measure `2ρ > 0`
  have hpos : 0 < ∫ x, β x := by
    rw [integral_pos_iff_support_of_nonneg (fun x => β.nonneg)
      (β.continuous.integrable_of_hasCompactSupport β.hasCompactSupport), β.support_eq,
      Real.volume_ball, ENNReal.ofReal_pos]
    change 0 < 2 * ((b - a) / 4)
    linarith
  -- `η = (∫ β)⁻¹ • β`
  refine ⟨fun x => (∫ x, β x)⁻¹ * β x, contDiff_const.mul β.contDiff, β.hasCompactSupport.mul_left,
    tsupport_mul_subset_right.trans hsupp, ?_⟩
  rw [integral_const_mul, inv_mul_cancel₀ hpos.ne']
/-- **Compactly supported `C¹` antiderivative** (du Bois-Reymond, step 4).  For `K = tsupport g`
nonempty, pick `a < a' < inf K` and `sup K < b' < b`, so `g = 0` outside `(a', b')`.  By the
fundamental theorem of calculus `Φ(x) = ∫_{a'}^{x} g` is `C¹` with `Φ' = g`.  It vanishes for
`x < a'` (`g = 0` on `(x, a']`) and for `x > b'` (`Φ(x) = ∫ g = 0`), so
`tsupport Φ ⊆ [a', b'] ⊆ (a, b)`.  If `K = ∅`, then `g = 0` and `Φ = 0` works. -/
theorem Submission.idtp_ccd_scsp_dbr_antiderivative : ∀ (a b : ℝ) (g : ℝ → ℝ), Continuous g → HasCompactSupport g → tsupport g ⊆ Ioo a b → ∫ x, g x = 0 → ∃ Φ : ℝ → ℝ, ContDiff ℝ 1 Φ ∧ HasCompactSupport Φ ∧ tsupport Φ ⊆ Ioo a b ∧ deriv Φ = g := by
  intro a b g hg hgc hsub hint
  rcases (tsupport g).eq_empty_or_nonempty with hK | hK
  · -- `tsupport g = ∅`: `g = 0`, and `Φ = 0` works
    have hg0 : g = 0 := funext fun x => image_eq_zero_of_notMem_tsupport (by simp [hK])
    refine ⟨0, contDiff_const, HasCompactSupport.zero, by simp, ?_⟩
    rw [hg0]
    exact deriv_const' 0
  -- `a < a' < inf K ≤ sup K < b' < b` for the compact set `K = tsupport g`
  have ha := (hsub (hgc.isCompact.sInf_mem hK)).1
  have hb := (hsub (hgc.isCompact.sSup_mem hK)).2
  set a' := (a + sInf (tsupport g)) / 2 with ha'
  set b' := (sSup (tsupport g) + b) / 2 with hb'
  -- `g = 0` outside `(a', b')`
  have hzero : ∀ y, y ∉ Ioo a' b' → g y = 0 := by
    intro y hy
    refine image_eq_zero_of_notMem_tsupport fun hyK => hy ⟨?_, ?_⟩
    · have := csInf_le hgc.isCompact.bddBelow hyK
      linarith
    · have := le_csSup hgc.isCompact.bddAbove hyK
      linarith
  -- `Φ(x) = ∫_{a'}^{x} g` vanishes outside `[a', b']`
  have hΦ : ∀ x, x ∉ Icc a' b' → (∫ y in a'..x, g y) = 0 := by
    intro x hx
    rcases lt_or_ge x a' with hxa | hxa
    · -- `x < a'`: `g = 0` on `Ι a' x = (x, a']`
      refine intervalIntegral.integral_zero_ae (Eventually.of_forall fun y hy => hzero y ?_)
      rw [uIoc_of_ge hxa.le] at hy
      exact fun h => (not_lt.2 hy.2) h.1
    · -- `x > b'`: `support g ⊆ (a', x]`, so `Φ(x) = ∫ g = 0`
      have hxb : b' < x := lt_of_not_ge fun h => hx ⟨hxa, h⟩
      rw [intervalIntegral.integral_eq_integral_of_support_subset, hint]
      intro y hy
      have hy' : y ∈ Ioo a' b' := support_subset_iff'.2 hzero hy
      exact ⟨hy'.1, hy'.2.le.trans hxb.le⟩
  -- fundamental theorem of calculus: `Φ' = g`
  have hderiv : deriv (fun x => ∫ y in a'..x, g y) = g :=
    funext fun x => Continuous.deriv_integral g hg a' x
  refine ⟨fun x => ∫ y in a'..x, g y, ?_, HasCompactSupport.intro isCompact_Icc hΦ,
    (closure_minimal (support_subset_iff'.2 hΦ) isClosed_Icc).trans
      (Icc_subset_Ioo (by linarith) (by linarith)), hderiv⟩
  rw [contDiff_one_iff_deriv, hderiv]
  exact ⟨fun x => (hg.integral_hasStrictDerivAt a' x).hasDerivAt.differentiableAt, hg⟩

/-- Fundamental lemma of the calculus of variations on `(a, b)` (continuous version): if `g` is
continuous on `(a, b)` and `∫ χ g = 0` for every smooth compactly supported `χ` with
`tsupport χ ⊆ (a, b)`, then `g = 0` on `(a, b)`.  If some such `h` had `h(x₀) > 0`, continuity
would give `r > 0` with `[x₀ - r, x₀ + r] ⊆ (a, b)` and `h > h(x₀) / 2` there; the bump `χ` at `x₀`
with radii `r / 2 < r` makes `χ h ≥ 0` integrable (`idtp_ccd_scsp_dbr_integrable`) and positive
on `(x₀ - r / 2, x₀ + r / 2)`, so `∫ χ h > 0`.  Applying this to `g` and `-g` gives `g(x₀) = 0`. -/
theorem Submission.idtp_ccd_scsp_dbr_fundamental_lemma : ∀ (a b : ℝ) (g : ℝ → ℝ), ContinuousOn g (Ioo a b) → (∀ χ : ℝ → ℝ, ContDiff ℝ (⊤ : ℕ∞) χ → HasCompactSupport χ → tsupport χ ⊆ Ioo a b → ∫ x, χ x * g x = 0) → ∀ x ∈ Ioo a b, g x = 0 := by
  intro a b g hg hint x₀ hx₀
  -- Claim: no `h` satisfying the hypotheses is positive at `x₀`.
  have claim : ∀ h : ℝ → ℝ, ContinuousOn h (Ioo a b) →
      (∀ χ : ℝ → ℝ, ContDiff ℝ (⊤ : ℕ∞) χ → HasCompactSupport χ → tsupport χ ⊆ Ioo a b →
        ∫ x, χ x * h x = 0) → ¬ 0 < h x₀ := by
    intro h hh hhint hpos
    -- `closedBall x₀ (ρ / 2) ⊆ (a, b)`, and `h > h x₀ / 2` there
    have hev : ∀ᶠ y in 𝓝 x₀, y ∈ Ioo a b ∧ h x₀ / 2 < h y :=
      (isOpen_Ioo.eventually_mem hx₀).and ((hh.continuousAt (isOpen_Ioo.mem_nhds hx₀)).eventually
        (lt_mem_nhds (half_lt_self hpos)))
    obtain ⟨ρ, hρ, hball⟩ := Metric.eventually_nhds_iff_ball.1 hev
    have hr : 0 < ρ / 2 := half_pos hρ
    have hclosed : ∀ y ∈ closedBall x₀ (ρ / 2), y ∈ Ioo a b ∧ h x₀ / 2 < h y := fun y hy =>
      hball y (closedBall_subset_ball (half_lt_self hρ) hy)
    -- the bump `χ` at `x₀` with radii `ρ / 4 < ρ / 2`
    let χ : ContDiffBump x₀ := ⟨ρ / 2 / 2, ρ / 2, half_pos hr, half_lt_self hr⟩
    have hχ : tsupport χ ⊆ Ioo a b := by
      rw [χ.tsupport_eq]
      exact fun y hy => (hclosed y hy).1
    have hnonneg : 0 ≤ fun y => χ y * h y := fun y => by
      by_cases hy : y ∈ closedBall x₀ (ρ / 2)
      · exact mul_nonneg χ.nonneg ((half_pos hpos).le.trans (hclosed y hy).2.le)
      · exact (mul_eq_zero_of_left (χ.zero_of_le_dist (not_le.1 (mt mem_closedBall.2 hy)).le)
          (h y)).ge
    have hint' : Integrable fun y => χ y * h y :=
      Submission.idtp_ccd_scsp_dbr_integrable a b h χ hh χ.continuous χ.hasCompactSupport hχ
    have hsupp : ball x₀ (ρ / 2 / 2) ⊆ support fun y => χ y * h y := by
      intro y hy
      rw [mem_support, χ.one_of_mem_closedBall (ball_subset_closedBall hy), one_mul]
      exact ((half_pos hpos).trans (hclosed y (closedBall_subset_closedBall (half_lt_self hr).le
        (ball_subset_closedBall hy))).2).ne'
    have hpos' : 0 < ∫ y, χ y * h y := by
      rw [integral_pos_iff_support_of_nonneg hnonneg hint']
      refine lt_of_lt_of_le ?_ (measure_mono hsupp)
      rw [Real.volume_ball, ENNReal.ofReal_pos]
      positivity
    exact hpos'.ne' (hhint χ χ.contDiff χ.hasCompactSupport hχ)
  have hneg : ¬ 0 < -g x₀ := claim (fun y => -g y) hg.neg fun χ hχ hχc hχs => by
    simp only [mul_neg, integral_neg, hint χ hχ hχc hχs, neg_zero]
  linarith [not_lt.1 (claim g hg hint), not_lt.1 hneg]

/-- **du Bois-Reymond lemma** on an open interval (step 10 of the parent proof; Encyclopedia of
Mathematics, "Du Bois-Reymond lemma").  Fix a normalized bump `η` in `(a, b)` (sibling
`dbr_normalized_bump`) and put `c := ∫ η κ`.  For a test function `χ` with `I := ∫ χ`, the
zero-mean function `χ − I η` has a compactly supported `C¹` antiderivative `Φ` in `(a, b)`
(sibling `dbr_antiderivative`).  Testing the hypothesis with `Φ` gives
`0 = ∫ (χ − I η) κ = ∫ χ κ − I c = ∫ χ (κ − c)` (integrability from sibling `dbr_integrable`),
so `κ − c` vanishes on `(a, b)` by the sibling `dbr_fundamental_lemma`. -/
theorem Submission.idtp_ccd_scsp_du_bois_reymond : ∀ (a b : ℝ) (κ : ℝ → ℝ), ContinuousOn κ (Ioo a b) → (∀ φ : ℝ → ℝ, ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ Ioo a b → ∫ x, deriv φ x * κ x = 0) → ∃ c : ℝ, ∀ x ∈ Ioo a b, κ x = c := by
  intro a b κ hκ hφ
  -- if `b ≤ a` the interval `(a, b)` is empty
  rcases le_or_gt b a with hba | hab
  · exact ⟨0, fun x hx => absurd ((hx.1.trans hx.2).trans_le hba) (lt_irrefl a)⟩
  -- a normalized bump `η` in `(a, b)` and the constant `c = ∫ η κ`
  obtain ⟨η, hη, hηc, hηs, hη1⟩ := Submission.idtp_ccd_scsp_dbr_normalized_bump a b hab
  obtain ⟨c, hc⟩ : ∃ c : ℝ, ∫ x, η x * κ x = c := ⟨_, rfl⟩
  have hηi : Integrable η := hη.continuous.integrable_of_hasCompactSupport hηc
  have hηκ : Integrable (fun x => η x * κ x) :=
    Submission.idtp_ccd_scsp_dbr_integrable a b κ η hκ hη.continuous hηc hηs
  -- `κ − c` is orthogonal to every test function in `(a, b)`
  have horth : ∀ χ : ℝ → ℝ, ContDiff ℝ (⊤ : ℕ∞) χ → HasCompactSupport χ →
      tsupport χ ⊆ Ioo a b → ∫ x, χ x * (κ x - c) = 0 := by
    intro χ hχ hχc hχs
    obtain ⟨I, hI⟩ : ∃ I : ℝ, ∫ x, χ x = I := ⟨_, rfl⟩
    have hχi : Integrable χ := hχ.continuous.integrable_of_hasCompactSupport hχc
    have hχκ : Integrable (fun x => χ x * κ x) :=
      Submission.idtp_ccd_scsp_dbr_integrable a b κ χ hκ hχ.continuous hχc hχs
    -- `χ − I η` is continuous, compactly supported in `(a, b)` and has zero mean
    have h0c : Continuous (fun x => χ x - I * η x) :=
      hχ.continuous.sub (continuous_const.mul hη.continuous)
    have h0cpt : HasCompactSupport (fun x => χ x - I * η x) :=
      hχc.sub (hηc.mul_left (f := fun _ => I))
    have h0s : tsupport (fun x => χ x - I * η x) ⊆ Ioo a b :=
      (tsupport_sub χ (fun x => I * η x)).trans
        (union_subset hχs (tsupport_mul_subset_right.trans hηs))
    have h0int : ∫ x, (χ x - I * η x) = 0 := by
      rw [integral_sub hχi (hηi.const_mul I), integral_const_mul, hη1, mul_one, hI, sub_self]
    -- its antiderivative `Φ` is an admissible test function
    obtain ⟨Φ, hΦ, hΦc, hΦs, hΦd⟩ :=
      Submission.idtp_ccd_scsp_dbr_antiderivative a b _ h0c h0cpt h0s h0int
    have h0 : ∫ x, (χ x - I * η x) * κ x = 0 := by
      have h := hφ Φ hΦ hΦc hΦs
      rw [hΦd] at h
      exact h
    -- `∫ (χ − I η) κ = ∫ χ κ − I c = ∫ χ (κ − c)`
    have h1 : ∫ x, (χ x - I * η x) * κ x = (∫ x, χ x * κ x) - I * c := by
      simp_rw [sub_mul, mul_assoc]
      rw [integral_sub hχκ (hηκ.const_mul I), integral_const_mul I (fun x => η x * κ x), hc]
    have h2 : ∫ x, χ x * (κ x - c) = (∫ x, χ x * κ x) - I * c := by
      simp_rw [mul_sub]
      rw [integral_sub hχκ (hχi.mul_const c), integral_mul_const c χ, hI]
    rw [h2, ← h1, h0]
  -- the fundamental lemma gives `κ = c` on `(a, b)`
  have hzero := Submission.idtp_ccd_scsp_dbr_fundamental_lemma a b (fun x => κ x - c)
    (hκ.sub continuousOn_const) horth
  exact ⟨c, fun x hx => sub_eq_zero.mp (hzero x hx)⟩
/-- **The sector agrees with the plane near `r₀u`** (step 12 of the parent proof).  Choose
`δ ≤ s` with `B_δ(r₀u) ⊆ N` and `|arctan(⟨y, e⟩ / ⟨y, u⟩)| < s` on `B_δ(r₀u)` (the angle is
continuous at `r₀u` and vanishes there).  Points of `M` in `B_δ(r₀u)` lie in `M ∩ N`, the polar
sector, hence in `span{u, e}`.  Conversely `y = x u + z e ∈ B_δ(r₀u)` has `x > r₀ − s > 0` and
polar coordinates `t = ‖y‖ = x √(1 + (z / x)²) ∈ (r₀ − s, r₀ + s)`, `α = arctan(z / x) ∈ (−s, s)`
with `t cos α = x`, `t sin α = z`, so `y` lies in the sector `M ∩ N`. -/
theorem Submission.idtp_ccd_scsp_sector_plane : ∀ (P : ℕ) (M N : Set (Euclid P)) (u e : Euclid P) (r₀ s : ℝ), ‖u‖ = 1 → ‖e‖ = 1 → inner ℝ u e = 0 → 0 < s → s < r₀ → IsOpen N → r₀ • u ∈ N → M ∩ N = (fun q : ℝ × ℝ => q.1 • (Real.cos q.2 • u + Real.sin q.2 • e)) '' (Ioo (r₀ - s) (r₀ + s) ×ˢ Ioo (-s) s) → ∃ δ : ℝ, 0 < δ ∧ M ∩ ball (r₀ • u) δ = (Submodule.span ℝ {u, e} : Set (Euclid P)) ∩ ball (r₀ • u) δ := by
  intro P M N u e r₀ s hu he hue hs hsr hN hpN hMN
  have hr₀ : 0 < r₀ := hs.trans hsr
  -- inner products of the orthonormal pair `u, e`
  have huu : inner ℝ u u = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, hu, one_pow]
  have hee : inner ℝ e e = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, he, one_pow]
  have heu : inner ℝ e u = (0 : ℝ) := by rw [real_inner_comm, hue]
  -- `⟨a u + b e, u⟩ = a` and `⟨a u + b e, e⟩ = b`
  have hcu : ∀ a b : ℝ, inner ℝ (a • u + b • e) u = a := by
    intro a b
    rw [inner_add_left, real_inner_smul_left, real_inner_smul_left, huu, heu]
    ring
  have hce : ∀ a b : ℝ, inner ℝ (a • u + b • e) e = b := by
    intro a b
    rw [inner_add_left, real_inner_smul_left, real_inner_smul_left, hue, hee]
    ring
  have hnorm : ∀ a b : ℝ, ‖a • u + b • e‖ ^ 2 = a ^ 2 + b ^ 2 := by
    intro a b
    rw [← real_inner_self_eq_norm_sq, inner_add_right, real_inner_smul_right,
      real_inner_smul_right, hcu, hce]
    ring
  -- the point `p = r₀ u`
  have hpu : inner ℝ (r₀ • u) u = r₀ := by rw [real_inner_smul_left, huu, mul_one]
  have hpe : inner ℝ (r₀ • u) e = (0 : ℝ) := by rw [real_inner_smul_left, hue, mul_zero]
  have hpn : ‖r₀ • u‖ = r₀ := by rw [norm_smul, hu, mul_one, Real.norm_eq_abs, abs_of_pos hr₀]
  -- the angle `f(y) = arctan(⟨y, e⟩ / ⟨y, u⟩)` is continuous at `p` with `f(p) = 0`
  have hfc : ContinuousAt (fun y : Euclid P => Real.arctan (inner ℝ y e / inner ℝ y u))
      (r₀ • u) :=
    Real.continuous_arctan.continuousAt.comp
      ((continuous_id.inner continuous_const).continuousAt.div
        (continuous_id.inner continuous_const).continuousAt (by simp [hpu, hr₀.ne']))
  have hf0 : Real.arctan (inner ℝ (r₀ • u) e / inner ℝ (r₀ • u) u) = 0 := by
    rw [hpe, zero_div, Real.arctan_zero]
  have hIoo : Ioo (-s) s ∈ 𝓝 (Real.arctan (inner ℝ (r₀ • u) e / inner ℝ (r₀ • u) u)) := by
    rw [hf0]
    exact Ioo_mem_nhds (by linarith) hs
  obtain ⟨δ₁, hδ₁, hball₁⟩ := Metric.mem_nhds_iff.1 (hfc.preimage_mem_nhds hIoo)
  obtain ⟨δ₂, hδ₂, hball₂⟩ := Metric.isOpen_iff.1 hN _ hpN
  refine ⟨min s (min δ₁ δ₂), lt_min hs (lt_min hδ₁ hδ₂), ?_⟩
  have hδs : min s (min δ₁ δ₂) ≤ s := min_le_left _ _
  have hδ₁' : min s (min δ₁ δ₂) ≤ δ₁ := (min_le_right _ _).trans (min_le_left _ _)
  have hδ₂' : min s (min δ₁ δ₂) ≤ δ₂ := (min_le_right _ _).trans (min_le_right _ _)
  ext y
  constructor
  · -- points of `M` near `p` lie in `M ∩ N`, hence are combinations of `u` and `e`
    rintro ⟨hyM, hyB⟩
    refine ⟨?_, hyB⟩
    have hyMN : y ∈ M ∩ N := ⟨hyM, hball₂ (ball_subset_ball hδ₂' hyB)⟩
    rw [hMN] at hyMN
    obtain ⟨⟨t, α⟩, -, rfl⟩ := hyMN
    rw [SetLike.mem_coe, Submodule.mem_span_pair]
    exact ⟨t * Real.cos α, t * Real.sin α, by simp only [smul_add, smul_smul]⟩
  · -- points `x u + z e` near `p` have polar coordinates in the sector
    rintro ⟨hyQ, hyB⟩
    refine ⟨?_, hyB⟩
    rw [SetLike.mem_coe, Submodule.mem_span_pair] at hyQ
    obtain ⟨x, z, rfl⟩ := hyQ
    have hd : ‖x • u + z • e - r₀ • u‖ < min s (min δ₁ δ₂) := by
      rw [← dist_eq_norm]
      exact hyB
    -- `|x - r₀| ≤ ‖y - p‖`, so `x > r₀ - s > 0`
    have hx : 0 < x := by
      have h1 := abs_real_inner_le_norm (x • u + z • e - r₀ • u) u
      rw [inner_sub_left, hcu, hpu, hu, mul_one] at h1
      have h2 := neg_abs_le (x - r₀)
      linarith
    -- the radius `t = ‖y‖ ∈ (r₀ - s, r₀ + s)`
    have ht : ‖x • u + z • e‖ ∈ Ioo (r₀ - s) (r₀ + s) := by
      have h1 := abs_norm_sub_norm_le (x • u + z • e) (r₀ • u)
      rw [hpn] at h1
      have h2 := abs_lt.1 (h1.trans_lt (hd.trans_le hδs))
      exact ⟨by linarith [h2.1], by linarith [h2.2]⟩
    -- the angle `α = arctan(z / x) ∈ (-s, s)`
    have hα : Real.arctan (z / x) ∈ Ioo (-s) s := by
      have h1 := hball₁ (ball_subset_ball hδ₁' hyB)
      rw [mem_preimage, hcu, hce] at h1
      exact h1
    -- `t = x √(1 + (z / x)²)`, so `t cos α = x` and `t sin α = z`
    have hS : 0 < √(1 + (z / x) ^ 2) := Real.sqrt_pos.2 (by positivity)
    have htS : ‖x • u + z • e‖ = x * √(1 + (z / x) ^ 2) := by
      refine (sq_eq_sq₀ (norm_nonneg _) (by positivity)).1 ?_
      rw [hnorm, mul_pow, Real.sq_sqrt (by positivity)]
      field_simp
    have hmem : x • u + z • e ∈ M ∩ N := by
      rw [hMN]
      refine ⟨(‖x • u + z • e‖, Real.arctan (z / x)), ⟨ht, hα⟩, ?_⟩
      simp only [smul_add, smul_smul]
      rw [Real.cos_arctan, Real.sin_arctan, htS]
      congr 2
      · field_simp
      · field_simp
    exact hmem.1

/-- Chapter 7 of Simon's *Introduction to GMT*: the headline results above. -/
theorem main_theorem : MinimizingImpliesStationary ∧ ExistenceOfMinimizingFilling ∧ CompactnessOfMinimizingCurrents ∧ DensityAndTangentCones ∧ IntegerDensityAndTangentPlanes ∧ RegularSetDense ∧ DensityOneImpliesRegular ∧ SingularSetSmallWhereDensityBelowTwo ∧ HalfSpaceConeLiesInBoundary ∧ CodimensionOneRegularity ∧ RegularComponentsAreMinimizing := by sorry

namespace Submission

/-- Integer median of an integer-valued function on the open unit cube `Q₁ ⊆ ℝ^{m+1}` (Simon
Ch. 6, 5.1, (31) and (35)): some `β ∈ ℤ` has `Lⁿ(Q₁ ∩ {β ≤ u}) ≥ 1/2`, `Lⁿ(Q₁ ∩ {u ≤ β}) ≥ 1/2`
and `|β| ≤ 2 ∫_{Q₁} |u|`.  `β` is the least integer with `Lⁿ(Q₁ ∩ {u ≤ β}) ≥ 1/2`; integrality
makes `{β ≤ u}` the complement of `{u ≤ β - 1}`, and Chebyshev's inequality for `|u|` gives both
the existence of `β` and the bound. -/
theorem dor_lmb_fcd_cp_integer_median : ∀ (m : ℕ) (u : Euclid (m + 1) → ℝ), (∀ y, ∃ z : ℤ, u y = z) → IntegrableOn u {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → ∃ β : ℤ, 1 / 2 ≤ volume ({y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} ∩ {y | (β : ℝ) ≤ u y}) ∧ 1 / 2 ≤ volume ({y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} ∩ {y | u y ≤ (β : ℝ)}) ∧ |(β : ℝ)| ≤ 2 * ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u y| := by
  intro m u hZ hu
  set Q : Set (Euclid (m + 1)) := {y | ∀ i, 0 < y i ∧ y i < 1} with hQ
  -- Step 0: `Q₁` is the preimage of the box `(0, 1)ⁿ` under the measure-preserving coordinate map,
  -- so it is measurable with `Lⁿ(Q₁) = 1`.
  have hbox : MeasurableSet (univ.pi fun _ : Fin (m + 1) => Ioo (0 : ℝ) 1) :=
    MeasurableSet.univ_pi fun _ => measurableSet_Ioo
  have hQeq : Q = WithLp.ofLp ⁻¹' (univ.pi fun _ : Fin (m + 1) => Ioo (0 : ℝ) 1) := by
    ext y
    simp [Q, Set.mem_pi]
  have hQm : MeasurableSet Q := by
    rw [hQeq]
    exact (PiLp.volume_preserving_ofLp (Fin (m + 1))).measurable hbox
  have hQ1 : volume Q = 1 := by
    rw [hQeq, (PiLp.volume_preserving_ofLp (Fin (m + 1))).measure_preimage hbox.nullMeasurableSet,
      Real.volume_pi_Ioo]
    simp
  -- Work with the probability measure `μ = Lⁿ⌞Q₁`; `Lⁿ(Q₁ ∩ s) = μ(s)` for every set `s`.
  set μ : Measure (Euclid (m + 1)) := volume.restrict Q with hμQ
  have hμ : ∀ s, volume (Q ∩ s) = μ s := fun s => by
    rw [hμQ, Measure.restrict_apply' hQm, inter_comm]
  have hμuniv : μ univ = 1 := by rw [← hμ, inter_univ, hQ1]
  have : IsFiniteMeasure μ := ⟨by rw [hμuniv]; exact ENNReal.one_lt_top⟩
  simp only [hμ]
  set I := ∫ y, |u y| ∂μ with hI
  have hI0 : 0 ≤ I := integral_nonneg fun y => abs_nonneg _
  -- Chebyshev: `ε μ({ε ≤ |u|}) ≤ ∫ |u| dμ`; no measurability of `u` is needed.
  have hmarkov : ∀ ε : ℝ, ε * μ.real {y | ε ≤ |u y|} ≤ I := fun ε =>
    mul_meas_ge_le_integral_of_nonneg (Eventually.of_forall fun y => abs_nonneg _)
      (Integrable.abs (μ := μ) hu) ε
  have hhalf : ((1 : ℝ≥0∞) / 2).toReal = 1 / 2 := by norm_num
  -- Tails: for `N > 2 ∫ |u|`, `μ({N ≤ |u|}) < 1/2`.
  obtain ⟨N, hN⟩ := exists_nat_gt (2 * I)
  have hNpos : (0 : ℝ) < N := lt_of_le_of_lt (by linarith) hN
  have htail : μ {y | (N : ℝ) ≤ |u y|} < 1 / 2 := by
    have h1 := hmarkov N
    have h2 : μ.real {y | (N : ℝ) ≤ |u y|} < 1 / 2 := not_le.1 fun h => by nlinarith
    rw [← hhalf, measureReal_def] at h2
    exact (ENNReal.toReal_lt_toReal (measure_ne_top μ _) (by norm_num)).1 h2
  -- `μ(A) + μ(B) ≥ 1` and `μ(B) < 1/2` force `μ(A) ≥ 1/2`.
  have hcompl : ∀ a b : ℝ≥0∞, 1 ≤ a + b → b < 1 / 2 → 1 / 2 ≤ a := by
    intro a b hab hb
    refine not_lt.1 fun h => ?_
    have h' := ENNReal.add_lt_add h hb
    rw [ENNReal.add_halves] at h'
    exact absurd hab (not_le.2 h')
  -- Steps 1–2: the least integer `β` with `μ({u ≤ β}) ≥ 1/2` (Simon (31)).  It exists since
  -- `μ({u ≤ N}) ≥ 1/2` while `μ({u ≤ z}) < 1/2` for `z < -N`.
  have hS : ∃ z : ℤ, 1 / 2 ≤ μ {y | u y ≤ z} := by
    refine ⟨N, hcompl _ (μ {y | u y ≤ ((N : ℤ) : ℝ)}ᶜ) (hμuniv ▸ measure_univ_le_add_compl _)
      (lt_of_le_of_lt (measure_mono fun y hy => ?_) htail)⟩
    simp only [mem_compl_iff, mem_ofPred_eq, not_le, Int.cast_natCast] at hy ⊢
    exact hy.le.trans (le_abs_self _)
  have hSb : ∃ b : ℤ, ∀ z : ℤ, 1 / 2 ≤ μ {y | u y ≤ z} → b ≤ z := by
    refine ⟨-N, fun z hz => not_lt.1 fun hlt => ?_⟩
    have hz' : (z : ℝ) ≤ -(N : ℝ) := by exact_mod_cast hlt.le
    refine absurd hz (not_le.2 (lt_of_le_of_lt (measure_mono fun y hy => ?_) htail))
    simp only [mem_ofPred_eq] at hy ⊢
    linarith [neg_abs_le (u y)]
  obtain ⟨β, hβ, hβmin⟩ := Int.exists_least_of_bdd hSb hS
  have hβ1 : μ {y | u y ≤ ((β - 1 : ℤ) : ℝ)} < 1 / 2 :=
    not_le.1 fun h => by have := hβmin (β - 1) h; omega
  -- Step 3: by integrality `{β ≤ u}ᶜ = {u ≤ β - 1}`, so `μ({β ≤ u}) ≥ 1 - μ({u ≤ β - 1}) ≥ 1/2`.
  have hup : 1 / 2 ≤ μ {y | (β : ℝ) ≤ u y} := by
    refine hcompl _ _ ?_ hβ1
    calc (1 : ℝ≥0∞) = μ univ := hμuniv.symm
      _ ≤ μ {y | (β : ℝ) ≤ u y} + μ {y | (β : ℝ) ≤ u y}ᶜ := measure_univ_le_add_compl _
      _ ≤ μ {y | (β : ℝ) ≤ u y} + μ {y | u y ≤ ((β - 1 : ℤ) : ℝ)} := by
        gcongr
        intro y hy
        simp only [mem_compl_iff, mem_ofPred_eq, not_le] at hy ⊢
        obtain ⟨k, hk⟩ := hZ y
        rw [hk] at hy ⊢
        have hk' : k < β := by exact_mod_cast hy
        have hk'' : k ≤ β - 1 := by omega
        exact_mod_cast hk''
  refine ⟨β, hup, hβ, ?_⟩
  -- Step 4 (Simon (35)): `{|β| ≤ |u|}` contains `{β ≤ u}` (`β ≥ 0`) or `{u ≤ β}` (`β ≤ 0`), so it
  -- has measure `≥ 1/2`, and Chebyshev gives `|β| / 2 ≤ ∫ |u|`.
  have hbig : 1 / 2 ≤ μ {y | |(β : ℝ)| ≤ |u y|} := by
    rcases le_total 0 β with h0 | h0
    · refine hup.trans (measure_mono fun y hy => ?_)
      simp only [mem_ofPred_eq] at hy ⊢
      have h0' : (0 : ℝ) ≤ β := by exact_mod_cast h0
      rw [abs_of_nonneg h0']
      exact hy.trans (le_abs_self _)
    · refine hβ.trans (measure_mono fun y hy => ?_)
      simp only [mem_ofPred_eq] at hy ⊢
      have h0' : (β : ℝ) ≤ 0 := by exact_mod_cast h0
      rw [abs_of_nonpos h0']
      exact (neg_le_neg hy).trans (neg_le_abs _)
  have hbig' : 1 / 2 ≤ μ.real {y | |(β : ℝ)| ≤ |u y|} := by
    have h := ENNReal.toReal_mono (measure_ne_top μ _) hbig
    rwa [hhalf, ← measureReal_def] at h
  have h4 := hmarkov |(β : ℝ)|
  nlinarith [abs_nonneg (β : ℝ)]
/-- Deviation from a `θ`-median `β` is controlled by the double-integral oscillation (Simon Ch. 2,
Lemma 2.7, proof): `∫_W |v − β| ≤ (1 + θ⁻¹) |W|⁻¹ ∫_W ∫_W |v(x) − v(y)|`.  With the mean
`v̄ = |W|⁻¹ ∫_W v`, `|v x − v̄| ≤ |W|⁻¹ ∫_W |v x − v y| dy`; Markov's inequality on the half
`{β ≤ v}` or `{v ≤ β}` on the far side of `β` from `v̄` gives `|W| |v̄ − β| ≤ θ⁻¹ ∫_W |v − v̄|`. -/
theorem dor_lmb_fcd_cp_median_deviation : ∀ (P : ℕ) (W : Set (Euclid P)) (v : Euclid P → ℝ) (β θ : ℝ), MeasurableSet W → volume W ≠ ∞ → IntegrableOn v W → 0 < θ → θ * (volume W).toReal ≤ (volume (W ∩ {y | β ≤ v y})).toReal → θ * (volume W).toReal ≤ (volume (W ∩ {y | v y ≤ β})).toReal → ∫ y in W, |v y - β| ≤ (1 + θ⁻¹) * ((volume W).toReal)⁻¹ * ∫ x in W, ∫ y in W, |v x - v y| := by
  intro P W v β θ hW hWfin hv hθ hge hle
  -- `volume⌞W` is a finite measure; write `m = |W|`
  have : IsFiniteMeasure (volume.restrict W) := isFiniteMeasure_restrict.mpr hWfin
  set m := (volume W).toReal
  -- Step 0: if `|W| = 0`, then `volume⌞W = 0` and both sides vanish
  rcases (ENNReal.toReal_nonneg : 0 ≤ m).eq_or_lt with hm | hm
  · have hW0 : volume W = 0 :=
      ((ENNReal.toReal_eq_zero_iff _).mp hm.symm).resolve_right hWfin
    simp [Measure.restrict_eq_zero.mpr hW0]
  -- Step 1: integrability; the partial integral is integrable by Fubini
  have hvi : Integrable v (volume.restrict W) := hv
  have hint : ∀ c : ℝ, Integrable (fun x => |v x - c|) (volume.restrict W) := fun c =>
    (hvi.sub (integrable_const c)).abs
  have hprod : Integrable (fun p : Euclid P × Euclid P => |v p.1 - v p.2|)
      ((volume.restrict W).prod (volume.restrict W)) :=
    ((hvi.comp_fst _).sub (hvi.comp_snd _)).abs
  have hG : Integrable (fun x => ∫ y in W, |v x - v y|) (volume.restrict W) :=
    hprod.integral_prod_left
  -- Step 2: with the mean `v̄ = |W|⁻¹ ∫_W v`, `|v x − v̄| ≤ |W|⁻¹ ∫_W |v x − v y| dy`
  set vbar := m⁻¹ * ∫ y in W, v y with hvbar
  have hpt : ∀ x, |v x - vbar| ≤ m⁻¹ * ∫ y in W, |v x - v y| := by
    intro x
    have h1 : ∫ y in W, (v x - v y) = m * v x - ∫ y in W, v y := by
      rw [integral_sub (integrable_const _) hvi, integral_const, measureReal_restrict_apply_univ,
        smul_eq_mul]
      rfl
    have h2 : v x - vbar = m⁻¹ * ∫ y in W, (v x - v y) := by
      rw [h1, hvbar, mul_sub, ← mul_assoc, inv_mul_cancel₀ hm.ne', one_mul]
    rw [h2, abs_mul, abs_of_pos (inv_pos.mpr hm)]
    exact mul_le_mul_of_nonneg_left abs_integral_le_integral_abs (inv_nonneg.mpr hm.le)
  have hJ : ∫ x in W, |v x - vbar| ≤ m⁻¹ * ∫ x in W, ∫ y in W, |v x - v y| := by
    rw [← integral_const_mul]
    exact integral_mono (hint vbar) (hG.const_mul _) hpt
  -- Step 3: `|v − v̄| ≥ |β − v̄|` on the half on the far side of `β`, which has measure `≥ θ|W|`
  set I := ∫ x in W, |v x - vbar| with hI
  have hmeas : θ * m ≤ (volume.restrict W).real {x | |β - vbar| ≤ |v x - vbar|} := by
    rcases le_total vbar β with hb | hb
    · refine hge.trans ?_
      rw [show (volume (W ∩ {y | β ≤ v y})).toReal = (volume.restrict W).real {y | β ≤ v y} by
        rw [Measure.real, Measure.restrict_apply' hW, Set.inter_comm]]
      refine measureReal_mono (fun x (hx : β ≤ v x) => ?_)
      show |β - vbar| ≤ |v x - vbar|
      rw [abs_of_nonneg (sub_nonneg.mpr hb), abs_of_nonneg (by linarith)]
      linarith
    · refine hle.trans ?_
      rw [show (volume (W ∩ {y | v y ≤ β})).toReal = (volume.restrict W).real {y | v y ≤ β} by
        rw [Measure.real, Measure.restrict_apply' hW, Set.inter_comm]]
      refine measureReal_mono (fun x (hx : v x ≤ β) => ?_)
      show |β - vbar| ≤ |v x - vbar|
      rw [abs_of_nonpos (sub_nonpos.mpr hb), abs_of_nonpos (by linarith)]
      linarith
  -- Markov's inequality for `|v − v̄|` at level `|β − v̄|`
  have hM : |β - vbar| * (volume.restrict W).real {x | |β - vbar| ≤ |v x - vbar|} ≤ I :=
    mul_meas_ge_le_integral_of_nonneg (ae_of_all _ fun x => abs_nonneg _) (hint vbar) _
  have hmed : m * |vbar - β| ≤ θ⁻¹ * I := by
    rw [abs_sub_comm, le_inv_mul_iff₀ hθ]
    calc θ * (m * |β - vbar|) = |β - vbar| * (θ * m) := by ring
      _ ≤ |β - vbar| * (volume.restrict W).real {x | |β - vbar| ≤ |v x - vbar|} :=
        mul_le_mul_of_nonneg_left hmeas (abs_nonneg _)
      _ ≤ I := hM
  -- Step 4: triangle inequality `|v − β| ≤ |v − v̄| + |v̄ − β|`
  have htri : ∫ y in W, |v y - β| ≤ I + m * |vbar - β| := by
    have h3 : ∫ y in W, (|v y - vbar| + |vbar - β|) = I + m * |vbar - β| := by
      rw [integral_add (hint vbar) (integrable_const _), integral_const,
        measureReal_restrict_apply_univ, smul_eq_mul]
      rfl
    rw [← h3]
    exact integral_mono (hint β) ((hint vbar).add (integrable_const _))
      fun y => abs_sub_le (v y) vbar β
  calc ∫ y in W, |v y - β| ≤ I + m * |vbar - β| := htri
    _ ≤ I + θ⁻¹ * I := by linarith
    _ = (1 + θ⁻¹) * I := by ring
    _ ≤ (1 + θ⁻¹) * (m⁻¹ * ∫ x in W, ∫ y in W, |v x - v y|) :=
        mul_le_mul_of_nonneg_left hJ (by positivity)
    _ = (1 + θ⁻¹) * m⁻¹ * ∫ x in W, ∫ y in W, |v x - v y| := by ring
/-- Fubini identity for mixed points on the cube `Q_δ = {y | ∀ i, δ < y i < 1 - δ}`: if `a_k(x, y)`
takes the coordinates `j < k` from `y` and the others from `x`, then
`∫_{Q_δ} ∫_{Q_δ} h(a_k(x, y)) dy dx = vol(Q_δ) ∫_{Q_δ} h`.  The swap `σ` exchanging `x_j` and `y_j`
for `j < k` is an involution preserving `vol ⊗ vol` (a factorwise product of swaps and identities)
and `Q_δ × Q_δ`, so Fubini on the finite measure space `Q_δ × Q_δ` turns the left side into
`∫_{Q_δ × Q_δ} h(x)`. -/
theorem dor_lmb_fcd_cp_mixed_point_integral : ∀ (m : ℕ) (δ : ℝ) (k : Fin (m + 1)) (h : Euclid (m + 1) → ℝ), IntegrableOn h {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ} → ∫ x in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, ∫ y in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, h (WithLp.toLp 2 (fun j => if j < k then y j else x j)) = (volume {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}).toReal * ∫ x in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, h x := by
  intro m δ k h hh
  set Q : Set (Euclid (m + 1)) := {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ} with hQ
  -- the coordinate swap on `(Fin (m+1) → ℝ)²`
  have hτ : MeasurePreserving (fun p : (Fin (m + 1) → ℝ) × (Fin (m + 1) → ℝ) =>
      ((fun j => if j < k then p.2 j else p.1 j), (fun j => if j < k then p.1 j else p.2 j)))
      (volume.prod volume) (volume.prod volume) := by
    set A := MeasurableEquiv.arrowProdEquivProdArrow ℝ ℝ (Fin (m + 1))
    have hA : MeasurePreserving A (Measure.pi fun _ : Fin (m + 1) => (volume : Measure ℝ).prod volume)
        ((volume : Measure (Fin (m + 1) → ℝ)).prod volume) :=
      measurePreserving_arrowProdEquivProdArrow ℝ ℝ (Fin (m + 1)) (fun _ => volume) (fun _ => volume)
    let f : Fin (m + 1) → ℝ × ℝ → ℝ × ℝ := fun j => if j < k then Prod.swap else id
    have hf : ∀ j, MeasurePreserving (f j) ((volume : Measure ℝ).prod volume)
        ((volume : Measure ℝ).prod volume) := by
      intro j
      by_cases hj : j < k
      · simp only [f, hj, ite_true]
        exact Measure.measurePreserving_swap
      · simp only [f, hj, ite_false]
        exact MeasurePreserving.id _
    have hP := measurePreserving_pi (fun _ : Fin (m + 1) => (volume : Measure ℝ).prod volume)
      (fun _ : Fin (m + 1) => (volume : Measure ℝ).prod volume) hf
    have hcomp := (hA.comp hP).comp hA.symm
    convert hcomp using 1
    funext p
    ext j
    · by_cases hj : j < k <;>
        simp [A, f, hj, MeasurableEquiv.arrowProdEquivProdArrow, Equiv.arrowProdEquivProdArrow]
    · by_cases hj : j < k <;>
        simp [A, f, hj, MeasurableEquiv.arrowProdEquivProdArrow, Equiv.arrowProdEquivProdArrow]
  -- the same swap on `Euclid (m+1) × Euclid (m+1)`
  set σ : Euclid (m + 1) × Euclid (m + 1) → Euclid (m + 1) × Euclid (m + 1) := fun p =>
    (WithLp.toLp 2 (fun j => if j < k then p.2 j else p.1 j),
      WithLp.toLp 2 (fun j => if j < k then p.1 j else p.2 j)) with hσdef
  have hσ : MeasurePreserving σ (volume.prod volume) (volume.prod volume) := by
    have h1 := (PiLp.volume_preserving_ofLp (Fin (m + 1))).prod (PiLp.volume_preserving_ofLp (Fin (m + 1)))
    have h2 := (PiLp.volume_preserving_toLp (Fin (m + 1))).prod (PiLp.volume_preserving_toLp (Fin (m + 1)))
    have := (h2.comp hτ).comp h1
    convert this using 1
    funext p
    rfl
  have hσσ : ∀ p, σ (σ p) = p := by
    intro p
    ext j
    · by_cases hj : j < k <;> simp [hσdef, hj]
    · by_cases hj : j < k <;> simp [hσdef, hj]
  let σe : (Euclid (m + 1) × Euclid (m + 1)) ≃ᵐ (Euclid (m + 1) × Euclid (m + 1)) :=
    { toFun := σ
      invFun := σ
      left_inv := hσσ
      right_inv := hσσ
      measurable_toFun := hσ.measurable
      measurable_invFun := hσ.measurable }
  have hemb : MeasurableEmbedding σ := σe.measurableEmbedding
  have hpre : σ ⁻¹' (Q ×ˢ Q) = Q ×ˢ Q := by
    ext p
    simp only [mem_preimage, mem_prod, hQ, mem_ofPred_eq, hσdef]
    constructor
    · rintro ⟨h1, h2⟩
      refine ⟨fun i => ?_, fun i => ?_⟩
      · by_cases hi : i < k
        · simpa [hi] using h2 i
        · simpa [hi] using h1 i
      · by_cases hi : i < k
        · simpa [hi] using h1 i
        · simpa [hi] using h2 i
    · rintro ⟨h1, h2⟩
      refine ⟨fun i => ?_, fun i => ?_⟩
      · by_cases hi : i < k
        · simpa [hi] using h2 i
        · simpa [hi] using h1 i
      · by_cases hi : i < k
        · simpa [hi] using h1 i
        · simpa [hi] using h2 i
  have hQm : MeasurableSet Q := by
    have : Q = ⋂ i, ({y : Euclid (m + 1) | δ < y i} ∩ {y | y i < 1 - δ}) := by
      ext y; simp [hQ]
    rw [this]
    exact MeasurableSet.iInter fun i =>
      (measurableSet_lt measurable_const (by fun_prop)).inter (measurableSet_lt (by fun_prop) measurable_const)
  have hσQ : MeasurePreserving σ ((volume.prod volume).restrict (Q ×ˢ Q))
      ((volume.prod volume).restrict (Q ×ˢ Q)) := by
    have := hσ.restrict_preimage_emb hemb (Q ×ˢ Q)
    rwa [hpre] at this
  have hrestr : (volume.restrict Q).prod (volume.restrict Q) =
      ((volume : Measure (Euclid (m + 1))).prod volume).restrict (Q ×ˢ Q) :=
    Measure.prod_restrict Q Q
  have hQfin : volume Q ≠ ∞ := by
    have hb : Bornology.IsBounded Q := by
      rw [Metric.isBounded_iff_subset_closedBall (0 : Euclid (m + 1))]
      refine ⟨Real.sqrt (((m : ℝ) + 1) * (|δ| + |1 - δ|) ^ 2), fun y hy => ?_⟩
      rw [mem_closedBall, dist_zero_right, EuclideanSpace.norm_eq]
      apply Real.sqrt_le_sqrt
      calc ∑ i, ‖y i‖ ^ 2 ≤ ∑ _i : Fin (m + 1), (|δ| + |1 - δ|) ^ 2 := by
            apply Finset.sum_le_sum
            intro i _
            have := hy i
            rw [Real.norm_eq_abs]
            have h1 : |y i| ≤ |δ| + |1 - δ| := by
              rw [abs_le]
              constructor <;> cases abs_cases δ <;> cases abs_cases (1 - δ) <;> linarith [this.1, this.2]
            exact pow_le_pow_left₀ (abs_nonneg _) h1 2
        _ = ((m : ℝ) + 1) * (|δ| + |1 - δ|) ^ 2 := by simp
    exact hb.measure_lt_top.ne
  have hfin : IsFiniteMeasure (volume.restrict Q) := isFiniteMeasure_restrict.2 hQfin
  -- integrability of `p ↦ h p.1` on `Q × Q`
  have hint1 : Integrable (fun p : Euclid (m + 1) × Euclid (m + 1) => h p.1)
      ((volume.restrict Q).prod (volume.restrict Q)) := hh.comp_fst (volume.restrict Q)
  have hint2 : Integrable (fun p => h (σ p).1) ((volume.restrict Q).prod (volume.restrict Q)) := by
    rw [hrestr] at hint1 ⊢
    exact (hσQ.integrable_comp_emb hemb).2 hint1
  -- compute
  have e1 : ∫ x in Q, ∫ y in Q, h (WithLp.toLp 2 (fun j => if j < k then y j else x j)) =
      ∫ p, h (σ p).1 ∂((volume.restrict Q).prod (volume.restrict Q)) := by
    rw [integral_prod _ hint2]
  have e2 : ∫ p, h (σ p).1 ∂((volume.restrict Q).prod (volume.restrict Q)) =
      ∫ p, h p.1 ∂((volume.restrict Q).prod (volume.restrict Q)) := by
    rw [hrestr]
    exact hσQ.integral_comp hemb (fun p => h p.1)
  have e3 : ∫ p, h p.1 ∂((volume.restrict Q).prod (volume.restrict Q)) =
      (volume Q).toReal * ∫ x in Q, h x := by
    rw [integral_prod _ hint1]
    simp only [integral_const, Measure.real, smul_eq_mul, Measure.restrict_apply MeasurableSet.univ,
      univ_inter]
    rw [integral_const_mul]
  rw [e1, e2, e3]
/-- Fubini along the `k`-th coordinate of the cube `Q_δ = (δ, 1 − δ)^{m+1}` (Simon Ch. 2,
proof of Lemma 2.7): for `h` integrable on `Q_δ`,
`∫_{Q_δ} ∫_δ^{1−δ} h(x[k ↦ t]) dt dx = (1 − 2δ) ∫_{Q_δ} h`.  The slice swap
`ρ(x, t) = (x[k ↦ t], x_k)` is a measure-preserving involution of `Euclid (m + 1) × ℝ` that maps
`Q_δ × (δ, 1 − δ)` onto itself. -/
theorem dor_lmb_fcd_cp_slice_integral : ∀ (m : ℕ) (δ : ℝ) (k : Fin (m + 1)) (h : Euclid (m + 1) → ℝ), IntegrableOn h {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ} → ∫ x in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, ∫ t in Ioo δ (1 - δ), h (WithLp.toLp 2 (Function.update (WithLp.ofLp x) k t)) = (1 - 2 * δ) * ∫ x in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, h x := by
  intro m δ k h hh
  set Q : Set (Euclid (m + 1)) := {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ} with hQ
  -- Step 0: if `δ ≥ 1/2` the cube is empty and both sides vanish.
  rcases le_or_gt (1 / 2) δ with hδ | hδ
  · have hQe : Q = ∅ := by
      ext y
      simp only [hQ, mem_ofPred_eq, mem_empty_iff_false, iff_false, not_forall]
      exact ⟨0, fun h0 => by linarith [h0.1, h0.2]⟩
    simp [hQe]
  -- Step 2: the slice swap on `(Fin (m + 1) → ℝ) × ℝ` preserves volume.  Under
  -- `piFinSuccAbove` it is `((a, b), c) ↦ ((c, b), a)`, a composition of swaps and
  -- reassociations.
  have hρ : MeasurePreserving (fun p : (Fin (m + 1) → ℝ) × ℝ => (Function.update p.1 k p.2, p.1 k))
      (volume.prod volume) (volume.prod volume) := by
    set e := MeasurableEquiv.piFinSuccAbove (fun _ : Fin (m + 1) => ℝ) k
    have he : MeasurePreserving e (volume : Measure (Fin (m + 1) → ℝ))
        ((volume : Measure ℝ).prod (volume : Measure (Fin m → ℝ))) :=
      volume_preserving_piFinSuccAbove (fun _ : Fin (m + 1) => ℝ) k
    set T : (ℝ × (Fin m → ℝ)) × ℝ → (ℝ × (Fin m → ℝ)) × ℝ := fun q => ((q.2, q.1.2), q.1.1) with hTdef
    have hT : MeasurePreserving T (((volume : Measure ℝ).prod (volume : Measure (Fin m → ℝ))).prod volume)
        (((volume : Measure ℝ).prod (volume : Measure (Fin m → ℝ))).prod volume) := by
      have s1 : MeasurePreserving (Prod.map Prod.swap id : (ℝ × (Fin m → ℝ)) × ℝ → ((Fin m → ℝ) × ℝ) × ℝ)
          (((volume : Measure ℝ).prod (volume : Measure (Fin m → ℝ))).prod volume)
          (((volume : Measure (Fin m → ℝ)).prod (volume : Measure ℝ)).prod volume) :=
        Measure.measurePreserving_swap.prod (MeasurePreserving.id _)
      have s2 := measurePreserving_prodAssoc (volume : Measure (Fin m → ℝ)) (volume : Measure ℝ)
        (volume : Measure ℝ)
      have s3 : MeasurePreserving (Prod.map id Prod.swap : (Fin m → ℝ) × (ℝ × ℝ) → (Fin m → ℝ) × (ℝ × ℝ))
          ((volume : Measure (Fin m → ℝ)).prod ((volume : Measure ℝ).prod volume))
          ((volume : Measure (Fin m → ℝ)).prod ((volume : Measure ℝ).prod volume)) :=
        (MeasurePreserving.id _).prod Measure.measurePreserving_swap
      have s4 := (measurePreserving_prodAssoc (volume : Measure (Fin m → ℝ)) (volume : Measure ℝ)
        (volume : Measure ℝ)).symm
      have s5 : MeasurePreserving (Prod.map Prod.swap id : ((Fin m → ℝ) × ℝ) × ℝ → (ℝ × (Fin m → ℝ)) × ℝ)
          (((volume : Measure (Fin m → ℝ)).prod (volume : Measure ℝ)).prod volume)
          (((volume : Measure ℝ).prod (volume : Measure (Fin m → ℝ))).prod volume) :=
        Measure.measurePreserving_swap.prod (MeasurePreserving.id _)
      have := s5.comp (s4.comp (s3.comp (s2.comp s1)))
      convert this using 1
      funext q
      rfl
    have hE2 : MeasurePreserving (e.prodCongr (MeasurableEquiv.refl ℝ))
        ((volume : Measure (Fin (m + 1) → ℝ)).prod (volume : Measure ℝ))
        (((volume : Measure ℝ).prod (volume : Measure (Fin m → ℝ))).prod volume) :=
      he.prod (MeasurePreserving.id _)
    have hfull := (hE2.symm.comp hT).comp hE2
    convert hfull using 1
    funext p
    ext j
    · simp only [Function.comp, e, T]
      simp [MeasurableEquiv.prodCongr, MeasurableEquiv.piFinSuccAbove_symm_apply,
        MeasurableEquiv.piFinSuccAbove_apply]
    · simp [e, T, MeasurableEquiv.prodCongr, MeasurableEquiv.piFinSuccAbove_symm_apply,
        MeasurableEquiv.piFinSuccAbove_apply]
  -- Steps 1–2: the same map `ρ` on `Euclid (m + 1) × ℝ` (via `ofLp`/`toLp`) is a
  -- measure-preserving involution, hence a measurable embedding.
  set ρ : Euclid (m + 1) × ℝ → Euclid (m + 1) × ℝ := fun p =>
    (WithLp.toLp 2 (Function.update (WithLp.ofLp p.1) k p.2), p.1 k) with hρdef
  have hρE : MeasurePreserving ρ (volume.prod volume) (volume.prod volume) := by
    have h1 := (PiLp.volume_preserving_ofLp (Fin (m + 1))).prod (MeasurePreserving.id (volume : Measure ℝ))
    have h2 := (PiLp.volume_preserving_toLp (Fin (m + 1))).prod (MeasurePreserving.id (volume : Measure ℝ))
    have := (h2.comp hρ).comp h1
    convert this using 1
    funext p
    rfl
  have hρρ : ∀ p, ρ (ρ p) = p := by
    intro p
    ext j
    · by_cases hj : j = k
      · subst hj; simp [hρdef]
      · simp [hρdef]
    · simp [hρdef]
  let ρe : (Euclid (m + 1) × ℝ) ≃ᵐ (Euclid (m + 1) × ℝ) :=
    { toFun := ρ
      invFun := ρ
      left_inv := hρρ
      right_inv := hρρ
      measurable_toFun := hρE.measurable
      measurable_invFun := hρE.measurable }
  have hemb : MeasurableEmbedding ρ := ρe.measurableEmbedding
  -- Step 3: `ρ⁻¹(Q × I) = Q × I`, so `ρ` preserves `(vol⌞Q) ⊗ (vol⌞I)`.
  set I : Set ℝ := Ioo δ (1 - δ) with hI
  have hpre : ρ ⁻¹' (Q ×ˢ I) = Q ×ˢ I := by
    ext p
    simp only [mem_preimage, mem_prod, hQ, mem_ofPred_eq, hρdef, hI, mem_Ioo]
    constructor
    · rintro ⟨h1, h2⟩
      refine ⟨fun i => ?_, ?_⟩
      · by_cases hi : i = k
        · subst hi; simpa using h2
        · simpa [hi] using h1 i
      · simpa using h1 k
    · rintro ⟨h1, h2⟩
      refine ⟨fun i => ?_, ?_⟩
      · by_cases hi : i = k
        · subst hi; simpa using h2
        · simpa [hi] using h1 i
      · exact h1 k
  have hρQ : MeasurePreserving ρ ((volume.prod volume).restrict (Q ×ˢ I))
      ((volume.prod volume).restrict (Q ×ˢ I)) := by
    have := hρE.restrict_preimage_emb hemb (Q ×ˢ I)
    rwa [hpre] at this
  have hrestr : (volume.restrict Q).prod (volume.restrict I) =
      ((volume : Measure (Euclid (m + 1))).prod (volume : Measure ℝ)).restrict (Q ×ˢ I) :=
    Measure.prod_restrict Q I
  -- Step 4: `(x, t) ↦ h x` and `(x, t) ↦ h (x[k ↦ t])` are integrable on `Q × I`.
  have hfinI : IsFiniteMeasure (volume.restrict I) := isFiniteMeasure_restrict.2 (by simp [hI])
  have hint1 : Integrable (fun p : Euclid (m + 1) × ℝ => h p.1)
      ((volume.restrict Q).prod (volume.restrict I)) := hh.comp_fst (volume.restrict I)
  have hint2 : Integrable (fun p => h (ρ p).1) ((volume.restrict Q).prod (volume.restrict I)) := by
    rw [hrestr] at hint1 ⊢
    exact (hρQ.integrable_comp_emb hemb).2 hint1
  -- Step 5: Fubini, the change of variables `ρ`, and `vol(I) = 1 − 2δ`.
  have e1 : ∫ x in Q, ∫ t in I, h (WithLp.toLp 2 (Function.update (WithLp.ofLp x) k t)) =
      ∫ p, h (ρ p).1 ∂((volume.restrict Q).prod (volume.restrict I)) := by
    rw [integral_prod _ hint2]
  have e2 : ∫ p, h (ρ p).1 ∂((volume.restrict Q).prod (volume.restrict I)) =
      ∫ p, h p.1 ∂((volume.restrict Q).prod (volume.restrict I)) := by
    rw [hrestr]
    exact hρQ.integral_comp hemb (fun p => h p.1)
  have e3 : ∫ p, h p.1 ∂((volume.restrict Q).prod (volume.restrict I)) =
      (1 - 2 * δ) * ∫ x in Q, h x := by
    rw [integral_prod _ hint1]
    simp only [integral_const, Measure.real, smul_eq_mul, Measure.restrict_apply MeasurableSet.univ,
      univ_inter, hI, Real.volume_Ioo]
    rw [integral_const_mul, ENNReal.toReal_ofReal (by linarith)]
    ring
  rw [e1, e2, e3]
/-- One coordinate step of the Poincaré inequality on the cube `Q_δ`: the points
`a_k(x, y)`, `b_k(x, y)` differ only in the `k`-th coordinate, so by the fundamental theorem of
calculus `|v(a_k) − v(b_k)| ≤ Φ(a_k) := ∫_{(δ, 1−δ)} |∂_k v(a_k[t])| dt`.  Integrating, the
mixed-point identity gives `∫∫ Φ(a_k) = |Q_δ| ∫_{Q_δ} Φ` and the slice identity gives
`∫_{Q_δ} Φ = (1 − 2δ) ∫_{Q_δ} |∂_k v|`. -/
theorem dor_lmb_fcd_cp_coordinate_step : ∀ (m : ℕ) (v : Euclid (m + 1) → ℝ) (δ : ℝ) (k : Fin (m + 1)), ContDiff ℝ 1 v → 0 ≤ δ → δ < 1 / 2 → ∫ x in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, ∫ y in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, |v (WithLp.toLp 2 (fun j => if j < k then y j else x j)) - v (WithLp.toLp 2 (fun j => if j ≤ k then y j else x j))| ≤ (1 - 2 * δ) * (volume {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}).toReal * ∫ x in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, |fderiv ℝ v x (EuclideanSpace.single k 1)| := by
  intro m v δ k hv _ _
  set Q : Set (Euclid (m + 1)) := {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ} with hQ
  -- `Q` is open, and contained in the compact cube `K = [δ, 1 − δ]^{m+1}`.
  have hQo : IsOpen Q := by
    have hQi : Q = ⋂ i, ({y : Euclid (m + 1) | δ < y i} ∩ {y | y i < 1 - δ}) := by
      ext y
      simp [hQ]
    rw [hQi]
    exact isOpen_iInter_of_finite fun i =>
      (isOpen_lt continuous_const (PiLp.continuous_apply 2 _ i)).inter
        (isOpen_lt (PiLp.continuous_apply 2 _ i) continuous_const)
  have hQm : MeasurableSet Q := hQo.measurableSet
  set K : Set (Euclid (m + 1)) := WithLp.toLp 2 '' Set.pi univ fun _ => Icc δ (1 - δ)
  have hKc : IsCompact K :=
    (isCompact_univ_pi fun _ => isCompact_Icc).image (PiLp.continuous_toLp 2 _)
  have hQK : Q ⊆ K := fun y hy => ⟨WithLp.ofLp y, fun i _ => ⟨(hy i).1.le, (hy i).2.le⟩, rfl⟩
  -- `∂_k v` is continuous.
  have hfd : Continuous (fderiv ℝ v) := hv.continuous_fderiv one_ne_zero
  have hgc : Continuous fun p : Euclid (m + 1) => |fderiv ℝ v p (EuclideanSpace.single k 1)| :=
    (hfd.clm_apply continuous_const).abs
  -- `p[t]`, the point `p` with `k`-th coordinate `t`, is `p + (t − p_k) e_k`.
  have hupd : ∀ (p : Euclid (m + 1)) (t : ℝ),
      WithLp.toLp 2 (Function.update (WithLp.ofLp p) k t) =
        p + (t - p k) • EuclideanSpace.single k (1 : ℝ) := by
    intro p t
    ext j
    by_cases hj : j = k
    · subst hj
      simp
    · simp [hj]
  -- `Φ(p) = ∫_{(δ, 1−δ)} |∂_k v(p[t])| dt` is continuous.
  set Φ : Euclid (m + 1) → ℝ := fun p => ∫ t in Ioo δ (1 - δ),
    |fderiv ℝ v (WithLp.toLp 2 (Function.update (WithLp.ofLp p) k t)) (EuclideanSpace.single k 1)|
    with hΦ
  have hΦc : Continuous Φ := by
    have hGc : Continuous fun z : Euclid (m + 1) × ℝ =>
        |fderiv ℝ v (WithLp.toLp 2 (Function.update (WithLp.ofLp z.1) k z.2))
          (EuclideanSpace.single k 1)| := by
      simp_rw [hupd]
      exact hgc.comp (by fun_prop)
    have hΦ' : Φ = fun p => ∫ t in Icc δ (1 - δ),
        |fderiv ℝ v (WithLp.toLp 2 (Function.update (WithLp.ofLp p) k t))
          (EuclideanSpace.single k 1)| := by
      funext p
      exact integral_Icc_eq_integral_Ioo.symm
    rw [hΦ']
    exact continuous_parametric_integral_of_continuous
      (f := fun p t => |fderiv ℝ v (WithLp.toLp 2 (Function.update (WithLp.ofLp p) k t))
        (EuclideanSpace.single k 1)|) hGc isCompact_Icc
  -- `(x, y) ↦ Φ(a_k(x, y))` is continuous.
  have hac : Continuous fun z : Euclid (m + 1) × Euclid (m + 1) =>
      (WithLp.toLp 2 (fun j => if j < k then z.2 j else z.1 j) : Euclid (m + 1)) := by
    refine (PiLp.continuous_toLp 2 _).comp (continuous_pi fun j => ?_)
    exact continuous_if_const _ (fun _ => by fun_prop) (fun _ => by fun_prop)
  have hFc : Continuous fun z : Euclid (m + 1) × Euclid (m + 1) =>
      Φ (WithLp.toLp 2 (fun j => if j < k then z.2 j else z.1 j)) := hΦc.comp hac
  -- Integrability: continuous functions are integrable on the compact `K ⊇ Q`.
  have hI1 : IntegrableOn (fun p => |fderiv ℝ v p (EuclideanSpace.single k 1)|) Q :=
    (hgc.continuousOn.integrableOn_compact hKc).mono_set hQK
  have hI2 : IntegrableOn Φ Q := (hΦc.continuousOn.integrableOn_compact hKc).mono_set hQK
  have hI3 : ∀ x : Euclid (m + 1), IntegrableOn
      (fun y : Euclid (m + 1) => Φ (WithLp.toLp 2 (fun j => if j < k then y j else x j))) Q :=
    fun x => ((hFc.comp (continuous_const.prodMk continuous_id)).continuousOn.integrableOn_compact
      hKc).mono_set hQK
  have hI4 : IntegrableOn (fun x : Euclid (m + 1) =>
      ∫ y in Q, Φ (WithLp.toLp 2 (fun j => if j < k then y j else x j))) Q := by
    have hprod : Integrable (fun z : Euclid (m + 1) × Euclid (m + 1) =>
        Φ (WithLp.toLp 2 (fun j => if j < k then z.2 j else z.1 j)))
        ((volume.restrict Q).prod (volume.restrict Q)) := by
      rw [Measure.prod_restrict]
      exact (hFc.continuousOn.integrableOn_compact (hKc.prod hKc)).mono_set (prod_mono hQK hQK)
    exact hprod.integral_prod_left
  -- Step 1: the fundamental theorem of calculus along `t ↦ a_k[t]`.
  have hpt : ∀ x ∈ Q, ∀ y ∈ Q,
      |v (WithLp.toLp 2 (fun j => if j < k then y j else x j)) -
        v (WithLp.toLp 2 (fun j => if j ≤ k then y j else x j))| ≤
        Φ (WithLp.toLp 2 (fun j => if j < k then y j else x j)) := by
    intro x hx y hy
    set a : Euclid (m + 1) := WithLp.toLp 2 (fun j => if j < k then y j else x j) with ha
    set ℓ : ℝ → Euclid (m + 1) := fun t => a + (t - a k) • EuclideanSpace.single k (1 : ℝ)
      with hℓ
    have hak : a k = x k := by simp [ha]
    have hℓx : ℓ (x k) = a := by simp [hℓ, hak]
    have hℓy : ℓ (y k) = WithLp.toLp 2 (fun j => if j ≤ k then y j else x j) := by
      ext j
      rcases lt_trichotomy j k with h | h | h
      · simp [hℓ, ha, h, le_of_lt h, ne_of_lt h]
      · subst h
        simp [hℓ, ha]
      · simp [hℓ, ha, not_lt.2 (le_of_lt h), not_le.2 h, (ne_of_lt h).symm]
    have hℓd : ∀ t, HasDerivAt ℓ (EuclideanSpace.single k (1 : ℝ)) t := by
      intro t
      have := (((hasDerivAt_id' t).sub_const (a k)).smul_const
        (EuclideanSpace.single k (1 : ℝ))).const_add a
      rw [one_smul] at this
      exact this
    have hderiv : ∀ t, HasDerivAt (fun t => v (ℓ t))
        (fderiv ℝ v (ℓ t) (EuclideanSpace.single k 1)) t := fun t =>
      ((hv.differentiable one_ne_zero (ℓ t)).hasFDerivAt).comp_hasDerivAt t (hℓd t)
    have hcont : Continuous fun t => fderiv ℝ v (ℓ t) (EuclideanSpace.single k 1) :=
      (hfd.comp (by fun_prop)).clm_apply continuous_const
    have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hderiv t)
      (hcont.intervalIntegrable (x k) (y k))
    simp only [hℓx, hℓy] at hftc
    have hsub : Set.uIoc (x k) (y k) ⊆ Ioo δ (1 - δ) := by
      intro t ht
      rcases Set.mem_uIoc.1 ht with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · exact ⟨by linarith [(hx k).1], by linarith [(hy k).2]⟩
      · exact ⟨by linarith [(hy k).1], by linarith [(hx k).2]⟩
    rw [abs_sub_comm, ← hftc]
    calc |∫ t in x k..y k, fderiv ℝ v (ℓ t) (EuclideanSpace.single k 1)|
        = ‖∫ t in x k..y k, fderiv ℝ v (ℓ t) (EuclideanSpace.single k 1)‖ :=
          (Real.norm_eq_abs _).symm
      _ ≤ ∫ (t : ℝ) in Set.uIoc (x k) (y k), ‖fderiv ℝ v (ℓ t) (EuclideanSpace.single k 1)‖ :=
          intervalIntegral.norm_integral_le_integral_norm_uIoc
      _ ≤ ∫ (t : ℝ) in Ioo δ (1 - δ), ‖fderiv ℝ v (ℓ t) (EuclideanSpace.single k 1)‖ :=
          setIntegral_mono_set
            (hcont.norm.continuousOn.integrableOn_Icc.mono_set Ioo_subset_Icc_self)
            (Eventually.of_forall fun t => norm_nonneg _) hsub.eventuallyLE
      _ = Φ a := by
          simp only [hΦ, hℓ, ← hupd, Real.norm_eq_abs]
  -- Step 3: integrate the pointwise bound.
  have hstep : ∫ x in Q, ∫ y in Q, |v (WithLp.toLp 2 (fun j => if j < k then y j else x j)) -
        v (WithLp.toLp 2 (fun j => if j ≤ k then y j else x j))| ≤
      ∫ x in Q, ∫ y in Q, Φ (WithLp.toLp 2 (fun j => if j < k then y j else x j)) := by
    refine integral_mono_of_nonneg
      (Eventually.of_forall fun x => integral_nonneg fun y => abs_nonneg _) hI4 ?_
    filter_upwards [ae_restrict_mem hQm] with x hx
    refine integral_mono_of_nonneg (Eventually.of_forall fun y => abs_nonneg _) (hI3 x) ?_
    filter_upwards [ae_restrict_mem hQm] with y hy
    exact hpt x hx y hy
  -- Steps 4–6: the mixed-point and slice identities.
  calc _ ≤ ∫ x in Q, ∫ y in Q, Φ (WithLp.toLp 2 (fun j => if j < k then y j else x j)) := hstep
    _ = (volume Q).toReal * ∫ x in Q, Φ x :=
        Submission.dor_lmb_fcd_cp_mixed_point_integral m δ k Φ hI2
    _ = (volume Q).toReal *
        ((1 - 2 * δ) * ∫ x in Q, |fderiv ℝ v x (EuclideanSpace.single k 1)|) := by
        congr 1
        exact Submission.dor_lmb_fcd_cp_slice_integral m δ k
          (fun p => |fderiv ℝ v p (EuclideanSpace.single k 1)|) hI1
    _ = _ := by ring
/-- **Poincaré inequality on the cube `Q_δ = (δ, 1 − δ)^{m+1}` for `C¹` functions** (the "usual
Poincaré inequality for smooth functions" invoked in Simon Ch. 2, proof of Lemma 2.7, here on a
cube of side `1 − 2δ`):
`∫_Q ∫_Q |v(x) − v(y)| dy dx ≤ (m + 1)(1 − 2δ) Lⁿ(Q) ∫_Q ‖Dv‖`.  Along the coordinate path from
`x` to `y`, `v x − v y` telescopes into the `m + 1` coordinate steps bounded by
`dor_lmb_fcd_cp_coordinate_step`; every integrand is continuous on the compact cube
`[δ, 1 − δ]^{m+1} ⊇ Q`, hence integrable, and `|Dv(x) eₖ| ≤ ‖Dv(x)‖`. -/
theorem dor_lmb_fcd_cp_smooth_poincare : ∀ (m : ℕ) (v : Euclid (m + 1) → ℝ) (δ : ℝ), ContDiff ℝ 1 v → 0 ≤ δ → δ < 1 / 2 → ∫ x in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, ∫ y in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, |v x - v y| ≤ ((m : ℝ) + 1) * (1 - 2 * δ) * (volume {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}).toReal * ∫ x in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, ‖fderiv ℝ v x‖ := by
  intro m v δ hv hδ0 hδ
  -- Step 1: telescoping along the coordinate path `W₀ = x, …, W_{m+1} = y`
  have htel : ∀ x y : Euclid (m + 1), v x - v y = ∑ k : Fin (m + 1),
      (v (WithLp.toLp 2 (fun j => if j < k then y j else x j)) -
        v (WithLp.toLp 2 (fun j => if j ≤ k then y j else x j))) := by
    intro x y
    set W : ℕ → Euclid (m + 1) :=
      fun n => WithLp.toLp 2 (fun j => if (j : ℕ) < n then y j else x j) with hW
    have h0 : W 0 = x := by
      simp [hW]
    have hN : W (m + 1) = y := by
      have hlt : ∀ j : Fin (m + 1), (j : ℕ) < m + 1 := fun j => j.is_lt
      simp only [hW, hlt, ite_true]
    have hk : ∀ k : Fin (m + 1),
        v (WithLp.toLp 2 (fun j => if j < k then y j else x j)) -
          v (WithLp.toLp 2 (fun j => if j ≤ k then y j else x j)) = v (W k) - v (W (k + 1)) := by
      intro k
      have e1 : (fun j : Fin (m + 1) => if j < k then y j else x j) =
          (fun j : Fin (m + 1) => if (j : ℕ) < (k : ℕ) then y j else x j) := by
        funext j
        simp only [Fin.lt_def]
      have e2 : (fun j : Fin (m + 1) => if j ≤ k then y j else x j) =
          (fun j : Fin (m + 1) => if (j : ℕ) < (k : ℕ) + 1 then y j else x j) := by
        funext j
        simp only [Fin.le_iff_val_le_val, Nat.lt_succ_iff]
      rw [e1, e2]
    rw [Finset.sum_congr rfl (fun k _ => hk k),
      Fin.sum_univ_eq_sum_range (fun n => v (W n) - v (W (n + 1))) (m + 1),
      Finset.sum_range_sub', h0, hN]
  have habs : ∀ x y : Euclid (m + 1), |v x - v y| ≤ ∑ k : Fin (m + 1),
      |v (WithLp.toLp 2 (fun j => if j < k then y j else x j)) -
        v (WithLp.toLp 2 (fun j => if j ≤ k then y j else x j))| := by
    intro x y
    rw [htel x y]
    exact Finset.abs_sum_le_sum_abs _ _
  -- Step 2: integrability; `Q_δ` lies in the compact cube `K = [δ, 1 − δ]^{m+1}`
  set Q : Set (Euclid (m + 1)) := {y | ∀ i, δ < y i ∧ y i < 1 - δ}
  set K : Set (Euclid (m + 1)) := {y | ∀ i, δ ≤ y i ∧ y i ≤ 1 - δ}
  have hQK : Q ⊆ K := fun y hy i => ⟨(hy i).1.le, (hy i).2.le⟩
  have hKc : IsCompact K := by
    have hKeq : K = WithLp.toLp 2 '' Set.pi univ (fun _ : Fin (m + 1) => Icc δ (1 - δ)) := by
      ext y
      constructor
      · intro hy
        exact ⟨WithLp.ofLp y, fun i _ => hy i, rfl⟩
      · rintro ⟨z, hz, rfl⟩ i
        exact hz i (mem_univ i)
    rw [hKeq]
    exact (isCompact_univ_pi fun _ => isCompact_Icc).image (PiLp.continuous_toLp 2 _)
  have hint : ∀ g : Euclid (m + 1) → ℝ, Continuous g → IntegrableOn g Q :=
    fun g hg => (hg.continuousOn.integrableOn_compact hKc).mono_set hQK
  have hint2 : ∀ F : Euclid (m + 1) × Euclid (m + 1) → ℝ, Continuous F →
      Integrable F ((volume.restrict Q).prod (volume.restrict Q)) := by
    intro F hF
    rw [Measure.prod_restrict]
    exact (hF.continuousOn.integrableOn_compact (hKc.prod hKc)).mono_set (prod_mono hQK hQK)
  -- the coordinate points depend continuously on `(x, y)`
  have hlt : ∀ k : Fin (m + 1), Continuous fun p : Euclid (m + 1) × Euclid (m + 1) =>
      (WithLp.toLp 2 (fun j => if j < k then p.2 j else p.1 j) : Euclid (m + 1)) := by
    intro k
    refine (PiLp.continuous_toLp 2 _).comp (continuous_pi fun j => ?_)
    exact continuous_if_const _ (fun _ => (PiLp.continuous_apply 2 _ j).comp continuous_snd)
      fun _ => (PiLp.continuous_apply 2 _ j).comp continuous_fst
  have hle : ∀ k : Fin (m + 1), Continuous fun p : Euclid (m + 1) × Euclid (m + 1) =>
      (WithLp.toLp 2 (fun j => if j ≤ k then p.2 j else p.1 j) : Euclid (m + 1)) := by
    intro k
    refine (PiLp.continuous_toLp 2 _).comp (continuous_pi fun j => ?_)
    exact continuous_if_const _ (fun _ => (PiLp.continuous_apply 2 _ j).comp continuous_snd)
      fun _ => (PiLp.continuous_apply 2 _ j).comp continuous_fst
  have hF0 : Continuous fun p : Euclid (m + 1) × Euclid (m + 1) => |v p.1 - v p.2| :=
    ((hv.continuous.comp continuous_fst).sub (hv.continuous.comp continuous_snd)).abs
  have hFk : ∀ k : Fin (m + 1), Continuous fun p : Euclid (m + 1) × Euclid (m + 1) =>
      |v (WithLp.toLp 2 (fun j => if j < k then p.2 j else p.1 j)) -
        v (WithLp.toLp 2 (fun j => if j ≤ k then p.2 j else p.1 j))| :=
    fun k => ((hv.continuous.comp (hlt k)).sub (hv.continuous.comp (hle k))).abs
  have hfac : 0 ≤ (1 - 2 * δ) * (volume Q).toReal :=
    mul_nonneg (by linarith) ENNReal.toReal_nonneg
  -- Steps 3–4: integrate the telescoping bound, apply `coordinate_step`, and `|Dv eₖ| ≤ ‖Dv‖`
  calc ∫ x in Q, ∫ y in Q, |v x - v y|
      ≤ ∫ x in Q, ∑ k : Fin (m + 1), ∫ y in Q,
          |v (WithLp.toLp 2 (fun j => if j < k then y j else x j)) -
            v (WithLp.toLp 2 (fun j => if j ≤ k then y j else x j))| := by
        refine integral_mono (hint2 _ hF0).integral_prod_left
          (integrable_finsetSum _ fun k _ => (hint2 _ (hFk k)).integral_prod_left) fun x => ?_
        have hx : ∀ k : Fin (m + 1), IntegrableOn (fun y : Euclid (m + 1) =>
            |v (WithLp.toLp 2 (fun j => if j < k then y j else x j)) -
              v (WithLp.toLp 2 (fun j => if j ≤ k then y j else x j))|) Q :=
          fun k => hint _ ((hFk k).comp (Continuous.prodMk_right x))
        exact (integral_mono (hint _ (hF0.comp (Continuous.prodMk_right x)))
          (integrable_finsetSum _ fun k _ => hx k) (habs x)).trans_eq
          (integral_finsetSum _ fun k _ => hx k)
    _ = ∑ k : Fin (m + 1), ∫ x in Q, ∫ y in Q,
          |v (WithLp.toLp 2 (fun j => if j < k then y j else x j)) -
            v (WithLp.toLp 2 (fun j => if j ≤ k then y j else x j))| :=
        integral_finsetSum _ fun k _ => (hint2 _ (hFk k)).integral_prod_left
    _ ≤ ∑ k : Fin (m + 1), (1 - 2 * δ) * (volume Q).toReal *
          ∫ x in Q, |fderiv ℝ v x (EuclideanSpace.single k 1)| :=
        Finset.sum_le_sum fun k _ => Submission.dor_lmb_fcd_cp_coordinate_step m v δ k hv hδ0 hδ
    _ ≤ ∑ _k : Fin (m + 1), (1 - 2 * δ) * (volume Q).toReal * ∫ x in Q, ‖fderiv ℝ v x‖ := by
        refine Finset.sum_le_sum fun k _ => mul_le_mul_of_nonneg_left ?_ hfac
        have hDv : Continuous (fderiv ℝ v) := hv.continuous_fderiv one_ne_zero
        refine integral_mono (hint _ (hDv.clm_apply continuous_const).abs) (hint _ hDv.norm)
          fun x => ?_
        calc |fderiv ℝ v x (EuclideanSpace.single k 1)|
            = ‖fderiv ℝ v x (EuclideanSpace.single k 1)‖ := (Real.norm_eq_abs _).symm
          _ ≤ ‖fderiv ℝ v x‖ * ‖EuclideanSpace.single k (1 : ℝ)‖ := (fderiv ℝ v x).le_opNorm _
          _ = ‖fderiv ℝ v x‖ := by simp
    _ = ((m : ℝ) + 1) * (1 - 2 * δ) * (volume Q).toReal * ∫ x in Q, ‖fderiv ℝ v x‖ := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        push_cast
        ring
/-- Mollification by an even `C¹` kernel `η` with compact support commutes with `D` and is
self-adjoint: `∫ D(η * u)(x)(s x) dx = −∫ u div(η * s)` for integrable `u`, `s` (Simon Ch. 2,
Lemma 2.5).  Both derivatives are convolutions with the odd, bounded `Dη`, and Fubini applies to
`Dη(x − z)(s x) u(z)`, which is dominated by `C ‖s x‖ |u z|`. -/
theorem codim1_rdo_dg_sp_mollifier_adjoint : ∀ (P : ℕ) (η u : Euclid P → ℝ) (s : Euclid P → Euclid P), ContDiff ℝ 1 η → HasCompactSupport η → (∀ z, η (-z) = η z) → Integrable u → Integrable s → ∫ x, fderiv ℝ (convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume) x (s x) = -∫ z, u z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ (convolution η s (ContinuousLinearMap.lsmul ℝ ℝ) volume) z : Euclid P →ₗ[ℝ] Euclid P) := by
  intro P η u s hη hηc heven hu hs
  -- Step 0: `Dη` is continuous with compact support, hence bounded by some `C`.
  have hDc : Continuous (fderiv ℝ η) := hη.continuous_fderiv one_ne_zero
  have hDcs : HasCompactSupport (fderiv ℝ η) := hηc.fderiv ℝ
  obtain ⟨C, hC⟩ := hDc.bounded_above_of_compact_support hDcs
  -- Step 1: `η` is even, so `Dη` is odd (chain rule for `η = η ∘ (−id)`).
  have hodd : ∀ y, fderiv ℝ η (-y) = -fderiv ℝ η y := by
    intro y
    have h1 : HasFDerivAt (η ∘ fun z => -z)
        ((fderiv ℝ η (-y)).comp (-ContinuousLinearMap.id ℝ (Euclid P))) y :=
      ((hη.differentiable one_ne_zero) (-y)).hasFDerivAt.comp y (hasFDerivAt_id y).neg
    rw [show (η ∘ fun z => -z) = η from funext heven] at h1
    ext v
    rw [h1.fderiv]
    simp
  -- Step 2: `D(η * u)(x) = (Dη * u)(x)`, so `D(η * u)(x)(s x) = ∫ Dη(x − z)(s x) u(z) dz`.
  have hLHS : ∀ x, fderiv ℝ (convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume) x (s x) =
      ∫ z, fderiv ℝ η (x - z) (s x) * u z := by
    intro x
    rw [(hηc.hasFDerivAt_convolution_left _ hη hu.locallyIntegrable x).fderiv, convolution_eq_swap,
      ContinuousLinearMap.integral_apply
        ((hDcs.convolutionExists_left _ hDc hu.locallyIntegrable x).integrable_swap)]
    simp
  -- Step 3: `div(η * s)(z) = trace D(η * s)(z) = ∫ Dη(z − x)(s x) dx`: the trace `T` is a
  -- continuous linear functional, and the trace of the rank-one map `v ↦ a(v) w` is `a(w)`.
  have hRHS : ∀ z, LinearMap.trace ℝ (Euclid P)
      (fderiv ℝ (convolution η s (ContinuousLinearMap.lsmul ℝ ℝ) volume) z :
        Euclid P →ₗ[ℝ] Euclid P) = ∫ x, fderiv ℝ η (z - x) (s x) := by
    let T : (Euclid P →L[ℝ] Euclid P) →L[ℝ] ℝ := LinearMap.toContinuousLinearMap
      (LinearMap.trace ℝ (Euclid P) ∘ₗ ContinuousLinearMap.coeLM ℝ)
    have hTA : ∀ A : Euclid P →L[ℝ] Euclid P,
        T A = LinearMap.trace ℝ (Euclid P) (A : Euclid P →ₗ[ℝ] Euclid P) := fun A => rfl
    have hrk : ∀ (a : Euclid P →L[ℝ] ℝ) (w : Euclid P), T (ContinuousLinearMap.precompL (Euclid P)
        (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] Euclid P →L[ℝ] Euclid P) a w) = a w := by
      intro a w
      have h : ((ContinuousLinearMap.precompL (Euclid P)
          (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] Euclid P →L[ℝ] Euclid P) a w :
            Euclid P →L[ℝ] Euclid P) : Euclid P →ₗ[ℝ] Euclid P) =
          (a : Euclid P →ₗ[ℝ] ℝ).smulRight w := by
        ext v
        simp
      rw [hTA, h, LinearMap.trace_smulRight]
      rfl
    intro z
    rw [(hηc.hasFDerivAt_convolution_left _ hη hs.locallyIntegrable z).fderiv, convolution_eq_swap]
    have hT := ContinuousLinearMap.integral_comp_comm T
      ((hDcs.convolutionExists_left (ContinuousLinearMap.precompL (Euclid P)
        (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] Euclid P →L[ℝ] Euclid P)) hDc
          hs.locallyIntegrable z).integrable_swap)
    simp_rw [hrk] at hT
    exact hT.symm
  -- Step 4: Fubini for `H(x, z) = Dη(x − z)(s x) u(z)`, dominated by `C ‖s x‖ |u z|`.
  have hint : Integrable (uncurry fun x z => fderiv ℝ η (x - z) (s x) * u z)
      ((volume : Measure (Euclid P)).prod volume) := by
    refine Integrable.mono' ((hs.norm.mul_prod hu.norm).const_mul C) ?_ (Eventually.of_forall ?_)
    · exact ((ContinuousLinearMap.apply ℝ ℝ).aestronglyMeasurable_comp₂
        hs.aestronglyMeasurable.comp_fst
        (hDc.comp (continuous_fst.sub continuous_snd)).aestronglyMeasurable).mul
        hu.aestronglyMeasurable.comp_snd
    · rintro ⟨x, z⟩
      simp only [uncurry_apply_pair, norm_mul]
      calc ‖fderiv ℝ η (x - z) (s x)‖ * ‖u z‖ ≤ (C * ‖s x‖) * ‖u z‖ := by
            gcongr
            exact ((fderiv ℝ η (x - z)).le_opNorm (s x)).trans (by gcongr; exact hC _)
        _ = C * (‖s x‖ * ‖u z‖) := by ring
  -- Step 5: combine, using `Dη(z − x) = −Dη(x − z)` to identify the swapped integral.
  calc ∫ x, fderiv ℝ (convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume) x (s x)
      = ∫ x, ∫ z, fderiv ℝ η (x - z) (s x) * u z := by simp_rw [hLHS]
    _ = ∫ z, ∫ x, fderiv ℝ η (x - z) (s x) * u z := integral_integral_swap hint
    _ = -∫ z, u z * LinearMap.trace ℝ (Euclid P)
          (fderiv ℝ (convolution η s (ContinuousLinearMap.lsmul ℝ ℝ) volume) z :
            Euclid P →ₗ[ℝ] Euclid P) := by
      rw [← integral_neg]
      congr 1
      funext z
      rw [hRHS z, ← integral_const_mul, ← integral_neg]
      congr 1
      funext x
      rw [← neg_sub x z, hodd, neg_apply]
      ring

/-- Simon Ch. 2, Lemma 2.5 on the cube `Q₁ = (0, 1)^{m+1}`: if `∫_{Q₁} u div g ≤ V` for every
smooth `g` with compact support in `Q₁` and `|g| ≤ 1`, then `u_η = η * 1_{Q₁} u` is smooth and
`∫_{Q_δ} |Du_η| ≤ V` whenever `spt η ⊆ B_δ(0)`.  For `g` with compact support in `Q_δ`, the
mollified field `G = η * g` is admissible, and `∫ Du_η · g = −∫_{Q₁} u div G = ∫_{Q₁} u div(−G)`. -/
theorem dor_lmb_fcd_cp_mollified_variation : ∀ (m : ℕ) (u : Euclid (m + 1) → ℝ) (V δ : ℝ) (η : Euclid (m + 1) → ℝ), IntegrableOn u {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ y, ‖g y‖ ≤ 1) → ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, u y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) ≤ V) → 0 < δ → ContDiff ℝ (⊤ : ℕ∞) η → HasCompactSupport η → (∀ z, 0 ≤ η z) → (∀ z, η (-z) = η z) → ∫ z, η z = 1 → support η ⊆ ball (0 : Euclid (m + 1)) δ → ContDiff ℝ (⊤ : ℕ∞) (convolution η (Set.indicator {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} u) (ContinuousLinearMap.lsmul ℝ ℝ) volume) ∧ ∫ x in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, ‖fderiv ℝ (convolution η (Set.indicator {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} u) (ContinuousLinearMap.lsmul ℝ ℝ) volume) x‖ ≤ V := by
  intro m u V δ η hu hH hδ hη hηc hη0 heven hη1 hηs
  -- Step 0: `{y : a < yᵢ < b for all i}` is open, a finite intersection of open slabs.
  have hopen : ∀ a b : ℝ, IsOpen {y : Euclid (m + 1) | ∀ i, a < y i ∧ y i < b} := by
    intro a b
    rw [ofPred_forall]
    exact isOpen_iInter_of_finite fun i =>
      (isOpen_lt continuous_const (PiLp.continuous_apply 2 _ i)).inter
        (isOpen_lt (PiLp.continuous_apply 2 _ i) continuous_const)
  have hQ₁ : MeasurableSet {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} :=
    (hopen 0 1).measurableSet
  have hũ : Integrable ({y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}.indicator u) :=
    hu.integrable_indicator hQ₁
  -- Step 1: `1_{Q₁} u` is integrable, so `u_η` is smooth.
  have hsmooth : ContDiff ℝ (⊤ : ℕ∞) (convolution η
      ({y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}.indicator u)
      (ContinuousLinearMap.lsmul ℝ ℝ) volume) :=
    hηc.contDiff_convolution_left _ hη hũ.locallyIntegrable
  -- Step 2: `Q_δ` is open and bounded: it lies in the closed ball of radius `√(m + 1)`.
  have hbdd : Bornology.IsBounded {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ} := by
    refine (isBounded_closedBall (x := (0 : Euclid (m + 1))) (r := √((m : ℝ) + 1))).subset ?_
    intro y hy
    rw [mem_closedBall_zero_iff, EuclideanSpace.norm_eq]
    refine Real.sqrt_le_sqrt ?_
    calc ∑ i, ‖y i‖ ^ 2 ≤ ∑ _i : Fin (m + 1), (1 : ℝ) := by
          refine Finset.sum_le_sum fun i _ => ?_
          have h0 : 0 < y i := by linarith [(hy i).1]
          have h1 : y i < 1 := by linarith [(hy i).2]
          rw [Real.norm_eq_abs, sq_abs]
          nlinarith
      _ = (m : ℝ) + 1 := by simp
  -- Step 3: by `smooth_duality` it suffices to bound `∫ Du_η · g` for admissible `g` in `Q_δ`.
  refine ⟨hsmooth, Submission.dor_lmb_fcd_cp_smooth_duality (m + 1) _ _ V (hopen δ (1 - δ)) hbdd
    hsmooth fun g hg hgc hgs hg1 => ?_⟩
  -- Step 4: `G = η * g` is smooth, compactly supported in `Q₁`, and `|G| ≤ 1`.
  have hGsmooth : ContDiff ℝ (⊤ : ℕ∞) (convolution η g (ContinuousLinearMap.lsmul ℝ ℝ) volume) :=
    hηc.contDiff_convolution_left _ hη hg.continuous.locallyIntegrable
  have hGc : HasCompactSupport (convolution η g (ContinuousLinearMap.lsmul ℝ ℝ) volume) :=
    hηc.convolution _ hgc
  have hGs : tsupport (convolution η g (ContinuousLinearMap.lsmul ℝ ℝ) volume) ⊆
      {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} := by
    -- `spt G ⊆ spt η + spt g ⊆ B̄_δ(0) + Q_δ ⊆ Q₁`, the middle set being compact.
    refine (closure_minimal ((support_convolution_subset (μ := volume)
      (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] Euclid (m + 1) →L[ℝ] Euclid (m + 1))).trans
      (add_subset_add (subset_tsupport η) (subset_tsupport g)))
      (hηc.isCompact.add hgc.isCompact).isClosed).trans ?_
    rintro _ ⟨z, hz, q, hq, rfl⟩ i
    have hz' : ‖z‖ ≤ δ :=
      mem_closedBall_zero_iff.mp (closure_ball_subset_closedBall (closure_mono hηs hz))
    have hzi : |z i| ≤ δ := by
      rw [← Real.norm_eq_abs]
      exact (PiLp.norm_apply_le z i).trans hz'
    have hqi := hgs hq i
    rw [PiLp.add_apply]
    constructor <;> linarith [(abs_le.mp hzi).1, (abs_le.mp hzi).2, hqi.1, hqi.2]
  have hG1 : ∀ x, ‖convolution η g (ContinuousLinearMap.lsmul ℝ ℝ) volume x‖ ≤ 1 := by
    intro x
    rw [convolution_def]
    calc ‖∫ t, ContinuousLinearMap.lsmul ℝ ℝ (η t) (g (x - t))‖ ≤ ∫ t, η t :=
          norm_integral_le_of_norm_le (hη.continuous.integrable_of_hasCompactSupport hηc)
            (Eventually.of_forall fun t => by
              rw [ContinuousLinearMap.lsmul_apply, norm_smul, Real.norm_eq_abs,
                abs_of_nonneg (hη0 t)]
              exact mul_le_of_le_one_right (hη0 t) (hg1 _))
      _ = 1 := hη1
  -- Step 5: `mollifier_adjoint` gives `∫ Du_η · g = −∫ 1_{Q₁} u div G`.
  have hadj := codim1_rdo_dg_sp_mollifier_adjoint (m + 1) η
    ({y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}.indicator u) g
    (hη.of_le (by exact_mod_cast le_top)) hηc heven hũ
    (hg.continuous.integrable_of_hasCompactSupport hgc)
  -- Step 6: (H) for `−G` reads `−∫_{Q₁} u div G ≤ V`, since `div(−G) = −div G`.
  have hneg := hH (-convolution η g (ContinuousLinearMap.lsmul ℝ ℝ) volume) hGsmooth.neg hGc.neg
    (by rwa [tsupport_neg]) fun y => by rw [Pi.neg_apply, norm_neg]; exact hG1 y
  simp only [fderiv_neg, ContinuousLinearMap.toLinearMap_neg, map_neg, mul_neg,
    integral_neg] at hneg
  rw [← integral_indicator hQ₁] at hneg
  simp_rw [indicator_mul_left] at hneg
  rw [hadj]
  exact hneg
/-- BV Poincaré inequality on the cube `Q_δ = (δ, 1 − δ)^{m+1}` in double-integral form (cf. the
proof of Simon Ch. 2, Lemma 2.7): if `∫_{Q₁} u div g ≤ V` for all smooth `g` with compact support
in `Q₁ = (0, 1)^{m+1}` and `|g| ≤ 1`, then `∫_{Q_δ} ∫_{Q_δ} |u(x) − u(y)| ≤ (m + 1)(1 − 2δ)|Q_δ| V`.
The mollifications `v_k = η_k ∗ 1_{Q₁}u` satisfy this bound by the smooth inequality, and
`v_k → u` a.e. on `Q_δ`, so Fatou's lemma on `Q_δ × Q_δ` passes it to `u`. -/
theorem dor_lmb_fcd_cp_bv_poincare : ∀ (m : ℕ) (u : Euclid (m + 1) → ℝ) (V δ : ℝ) (η : ℕ → Euclid (m + 1) → ℝ), IntegrableOn u {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ y, ‖g y‖ ≤ 1) → ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, u y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) ≤ V) → 0 < δ → δ < 1 / 2 → (∀ k, ContDiff ℝ (⊤ : ℕ∞) (η k)) → (∀ k, HasCompactSupport (η k)) → (∀ k z, 0 ≤ η k z) → (∀ k z, η k (-z) = η k z) → (∀ k, ∫ z, η k z = 1) → (∀ k, support (η k) ⊆ ball (0 : Euclid (m + 1)) δ) → (∀ᵐ x ∂volume, Tendsto (fun k => (convolution (η k) (Set.indicator {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} u) (ContinuousLinearMap.lsmul ℝ ℝ) volume) x) atTop (𝓝 ((Set.indicator {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} u) x))) → ∫ x in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, ∫ y in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, |u x - u y| ≤ ((m : ℝ) + 1) * (1 - 2 * δ) * (volume {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}).toReal * V := by
  intro m u V δ η hu hH hδ hδ2 hη hηc hη0 hηe hη1 hηs hlim
  set Q₁ : Set (Euclid (m + 1)) := {y | ∀ i, 0 < y i ∧ y i < 1}
  set Q : Set (Euclid (m + 1)) := {y | ∀ i, δ < y i ∧ y i < 1 - δ}
  set C : ℝ := ((m : ℝ) + 1) * (1 - 2 * δ) * (volume Q).toReal
  set v : ℕ → Euclid (m + 1) → ℝ := fun k =>
    convolution (η k) (Q₁.indicator u) (ContinuousLinearMap.lsmul ℝ ℝ) volume
  -- Step 1: each `v k` is smooth with `∫_Q ‖D v_k‖ ≤ V` (sibling `mollified_variation`).
  have hmv : ∀ k, ContDiff ℝ (⊤ : ℕ∞) (v k) ∧ ∫ x in Q, ‖fderiv ℝ (v k) x‖ ≤ V := fun k =>
    Submission.dor_lmb_fcd_cp_mollified_variation m u V δ (η k) hu hH hδ (hη k) (hηc k)
      (hη0 k) (hηe k) (hη1 k) (hηs k)
  have hV : 0 ≤ V := (integral_nonneg fun x => norm_nonneg _).trans (hmv 0).2
  have hC0 : 0 ≤ C := by
    have : 0 ≤ 1 - 2 * δ := by linarith
    positivity
  -- Step 2: the smooth Poincaré inequality for `v k` (sibling `smooth_poincare`).
  have hD : ∀ k, ∫ x in Q, ∫ y in Q, |v k x - v k y| ≤ C * V := fun k =>
    (Submission.dor_lmb_fcd_cp_smooth_poincare m (v k) δ
      ((hmv k).1.of_le (by exact_mod_cast le_top)) hδ.le hδ2).trans
      (mul_le_mul_of_nonneg_left (hmv k).2 hC0)
  -- `Q` is a measurable subset of `Q₁` contained in a compact ball.
  have hQQ₁ : Q ⊆ Q₁ := fun y hy i => ⟨hδ.trans (hy i).1, (hy i).2.trans (by linarith)⟩
  have hQm : MeasurableSet Q := by
    have hc : ∀ i : Fin (m + 1), Measurable fun y : Euclid (m + 1) => y i := fun i => by fun_prop
    have hQi : Q = ⋂ i, ({y : Euclid (m + 1) | δ < y i} ∩ {y | y i < 1 - δ}) := by
      ext y
      rw [mem_iInter]
      exact Iff.rfl
    rw [hQi]
    exact MeasurableSet.iInter fun i =>
      (measurableSet_lt measurable_const (hc i)).inter (measurableSet_lt (hc i) measurable_const)
  have hQK : Q ⊆ closedBall (0 : Euclid (m + 1)) (Real.sqrt (m + 1)) := by
    intro y hy
    rw [mem_closedBall_zero_iff, EuclideanSpace.norm_eq]
    refine Real.sqrt_le_sqrt ?_
    calc ∑ i, ‖y i‖ ^ 2 ≤ ∑ _i : Fin (m + 1), (1 : ℝ) := Finset.sum_le_sum fun i _ => by
          have h1 := (hy i).1
          have h2 := (hy i).2
          rw [Real.norm_eq_abs, sq_abs]
          nlinarith
      _ = m + 1 := by simp
  have hK : IsCompact (closedBall (0 : Euclid (m + 1)) (Real.sqrt (m + 1))) :=
    isCompact_closedBall _ _
  have : IsFiniteMeasure (volume.restrict Q) :=
    isFiniteMeasure_restrict.2 ((measure_mono hQK).trans_lt hK.measure_lt_top).ne
  set μ : Measure (Euclid (m + 1)) := volume.restrict Q
  -- Integrability on `Q × Q`.
  have huQ : Integrable u μ := hu.mono_set hQQ₁
  have hF : Integrable (fun p : Euclid (m + 1) × Euclid (m + 1) => |u p.1 - u p.2|) (μ.prod μ) :=
    ((huQ.comp_fst μ).sub (huQ.comp_snd μ)).abs
  have hFk : ∀ k, Integrable (fun p : Euclid (m + 1) × Euclid (m + 1) => |v k p.1 - v k p.2|)
      (μ.prod μ) := fun k => by
    have hvk : Integrable (v k) μ :=
      (((hmv k).1.continuous.continuousOn).integrableOn_compact hK).mono_set hQK
    exact ((hvk.comp_fst μ).sub (hvk.comp_snd μ)).abs
  -- Step 3: `v k → u` a.e. on `Q`, hence `|v k x - v k y| → |u x - u y|` a.e. on `Q × Q`.
  have hlimQ : ∀ᵐ x ∂μ, Tendsto (fun k => v k x) atTop (𝓝 (u x)) := by
    filter_upwards [ae_restrict_of_ae hlim, ae_restrict_mem hQm] with x hx hxQ
    rwa [indicator_of_mem (hQQ₁ hxQ)] at hx
  have hlimP : ∀ᵐ p ∂(μ.prod μ), Tendsto (fun k => ENNReal.ofReal |v k p.1 - v k p.2|) atTop
      (𝓝 (ENNReal.ofReal |u p.1 - u p.2|)) := by
    filter_upwards [Measure.quasiMeasurePreserving_fst.ae hlimQ,
      Measure.quasiMeasurePreserving_snd.ae hlimQ] with p h1 h2
    exact ENNReal.tendsto_ofReal (h1.sub h2).abs
  -- Steps 4–5: Fatou's lemma on `Q × Q` and Fubini.
  have hFatou : ∫⁻ p, ENNReal.ofReal |u p.1 - u p.2| ∂(μ.prod μ) ≤ ENNReal.ofReal (C * V) :=
    calc ∫⁻ p, ENNReal.ofReal |u p.1 - u p.2| ∂(μ.prod μ)
        = ∫⁻ p, liminf (fun k => ENNReal.ofReal |v k p.1 - v k p.2|) atTop ∂(μ.prod μ) :=
          lintegral_congr_ae (hlimP.mono fun p hp => hp.liminf_eq.symm)
      _ ≤ liminf (fun k => ∫⁻ p, ENNReal.ofReal |v k p.1 - v k p.2| ∂(μ.prod μ)) atTop :=
          lintegral_liminf_le' fun k => (hFk k).aemeasurable.ennreal_ofReal
      _ ≤ ENNReal.ofReal (C * V) := liminf_le_of_frequently_le' (Frequently.of_forall fun k => by
          rw [← ofReal_integral_eq_lintegral_ofReal (hFk k) (ae_of_all _ fun p => abs_nonneg _),
            integral_prod _ (hFk k)]
          exact ENNReal.ofReal_le_ofReal (hD k))
  have hfin : ENNReal.ofReal (∫ x in Q, ∫ y in Q, |u x - u y|) ≤ ENNReal.ofReal (C * V) := by
    rw [← integral_prod (fun p : Euclid (m + 1) × Euclid (m + 1) => |u p.1 - u p.2|) hF,
      ofReal_integral_eq_lintegral_ofReal hF (ae_of_all _ fun p => abs_nonneg _)]
    exact hFatou
  exact (ENNReal.ofReal_le_ofReal_iff (mul_nonneg hC0 hV)).1 hfin
/-- Shrinking the unit cube `Q₁ = (0, 1)ᵐ⁺¹` to `Q_δ = (δ, 1 − δ)ᵐ⁺¹` while keeping half of the
`L¹` norm of `f` (Simon Ch. 2, proof of Lemma 2.7).  The cubes `Q_{1/(j+4)}` are open and
increase to `Q₁`, so continuity of the measure from above and of the integral along increasing
unions give one `j` for both the layer bound and the integral bound. -/
theorem dor_lmb_fcd_cp_shrinking : ∀ (m : ℕ) (f : Euclid (m + 1) → ℝ), IntegrableOn f {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → ∃ δ : ℝ, 0 < δ ∧ δ ≤ 1 / 4 ∧ volume {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ} ≤ 1 ∧ volume ({y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} \ {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}) ≤ 1 / 4 ∧ ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |f y| ≤ 2 * ∫ y in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, |f y| := by
  intro m f hf
  -- Step 1: `Q_t` is open, `Q_t ⊆ Q₁` for `t ≥ 0`, and `volume Q₁ = 1`.
  have hopen : ∀ t : ℝ, IsOpen {y : Euclid (m + 1) | ∀ i, t < y i ∧ y i < 1 - t} := by
    intro t
    simp only [Set.ofPred_forall, Set.ofPred_and]
    exact isOpen_iInter_of_finite fun i =>
      (isOpen_lt continuous_const (PiLp.continuous_apply 2 _ i)).inter
        (isOpen_lt (PiLp.continuous_apply 2 _ i) continuous_const)
  have hmeas : ∀ t : ℝ, MeasurableSet {y : Euclid (m + 1) | ∀ i, t < y i ∧ y i < 1 - t} :=
    fun t => (hopen t).measurableSet
  have hmeas₁ : MeasurableSet {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} := by
    simpa using hmeas 0
  have hsub : ∀ t : ℝ, 0 ≤ t → {y : Euclid (m + 1) | ∀ i, t < y i ∧ y i < 1 - t} ⊆
      {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} := fun t ht y hy i =>
    ⟨ht.trans_lt (hy i).1, (hy i).2.trans_le (by linarith)⟩
  have hvol₁ : volume {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} = 1 := by
    have hpre : {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} =
        WithLp.ofLp ⁻¹' (univ.pi fun _ : Fin (m + 1) => Ioo (0 : ℝ) 1) := by
      ext y
      simp [Set.mem_pi]
    rw [hpre, (PiLp.volume_preserving_ofLp (Fin (m + 1))).measure_preimage
      (MeasurableSet.univ_pi fun _ => measurableSet_Ioo).nullMeasurableSet, Real.volume_pi_Ioo]
    simp
  -- Step 2: `δ_j = 1/(j+4)` decreases to `0`, and the cubes `Q_{δ_j}` increase to `Q₁`.
  obtain ⟨δ, hδdef⟩ : ∃ δ : ℕ → ℝ, δ = fun j : ℕ => 1 / ((j : ℝ) + 4) := ⟨_, rfl⟩
  have hδpos : ∀ j, 0 < δ j := fun j => by rw [hδdef]; positivity
  have hδle : ∀ j, δ j ≤ 1 / 4 := fun j => by
    simp only [hδdef]
    gcongr
    linarith [(Nat.cast_nonneg j : (0 : ℝ) ≤ j)]
  have hδanti : Antitone δ := fun j k hjk => by
    simp only [hδdef]
    gcongr
  have hδlim : Tendsto δ atTop (𝓝 0) := by
    rw [hδdef]
    exact tendsto_const_nhds.div_atTop
      (tendsto_atTop_add_const_right _ _ tendsto_natCast_atTop_atTop)
  have hmono : Monotone fun j => {y : Euclid (m + 1) | ∀ i, δ j < y i ∧ y i < 1 - δ j} :=
    fun j k hjk y hy i =>
      ⟨(hδanti hjk).trans_lt (hy i).1, (hy i).2.trans_le (by linarith [hδanti hjk])⟩
  have hunion : ⋃ j, {y : Euclid (m + 1) | ∀ i, δ j < y i ∧ y i < 1 - δ j} =
      {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} := by
    refine Subset.antisymm (iUnion_subset fun j => hsub _ (hδpos j).le) fun y hy => ?_
    have hev : ∀ᶠ j in atTop, ∀ i, δ j < y i ∧ y i < 1 - δ j := by
      rw [eventually_all]
      intro i
      filter_upwards [(tendsto_order.1 hδlim).2 _ (hy i).1,
        (tendsto_order.1 hδlim).2 _ (sub_pos.2 (hy i).2)] with j hj₁ hj₂
      exact ⟨hj₁, by linarith⟩
    obtain ⟨j, hj⟩ := hev.exists
    exact mem_iUnion.2 ⟨j, hj⟩
  -- Step 3: continuity from above, `volume (Q₁ \ Q_{δ_j}) → 0`.
  have hlayer : Tendsto (fun j => volume ({y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} \
      {y : Euclid (m + 1) | ∀ i, δ j < y i ∧ y i < 1 - δ j})) atTop (𝓝 0) := by
    have h := tendsto_measure_iInter_atTop (μ := volume)
      (s := fun j => {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} \
        {y : Euclid (m + 1) | ∀ i, δ j < y i ∧ y i < 1 - δ j})
      (fun j => (hmeas₁.diff (hmeas _)).nullMeasurableSet)
      (fun j k hjk => Set.sdiff_subset_sdiff_right (hmono hjk))
      ⟨0, ((measure_mono Set.sdiff_subset).trans_lt (by rw [hvol₁]; exact ENNReal.one_lt_top)).ne⟩
    rw [← Set.sdiff_iUnion, hunion, Set.sdiff_self, measure_empty] at h
    exact h
  have hev₁ : ∀ᶠ j in atTop, volume ({y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} \
      {y : Euclid (m + 1) | ∀ i, δ j < y i ∧ y i < 1 - δ j}) < 1 / 4 :=
    (tendsto_order.1 hlayer).2 _ (by norm_num)
  -- Step 4: continuity of the integral, `∫_{Q_{δ_j}} |f| → ∫_{Q₁} |f|`.
  have hint : Tendsto (fun j => ∫ y in {y : Euclid (m + 1) | ∀ i, δ j < y i ∧ y i < 1 - δ j}, |f y|)
      atTop (𝓝 (∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |f y|)) := by
    have h := tendsto_setIntegral_of_monotone (μ := volume) (f := fun y => |f y|)
      (fun j => hmeas (δ j)) hmono (by rw [hunion]; exact hf.abs)
    rw [hunion] at h
    exact h
  have hev₂ : ∀ᶠ j in atTop, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |f y| ≤
      2 * ∫ y in {y : Euclid (m + 1) | ∀ i, δ j < y i ∧ y i < 1 - δ j}, |f y| := by
    rcases (integral_nonneg fun y => abs_nonneg (f y) :
        0 ≤ ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |f y|).eq_or_lt with h₀ | hpos
    · exact Eventually.of_forall fun j => by
        rw [← h₀]
        exact mul_nonneg zero_le_two (integral_nonneg fun y => abs_nonneg (f y))
    · filter_upwards [(tendsto_order.1 hint).1 _ (half_lt_self hpos)] with j hj
      linarith
  -- Step 5: one `j` works for both bounds.
  obtain ⟨j, hj₁, hj₂⟩ := (hev₁.and hev₂).exists
  exact ⟨δ j, hδpos j, hδle j, (measure_mono (hsub _ (hδpos j).le)).trans hvol₁.le, hj₁.le, hj₂⟩

/-- **Poincaré inequality with an integer median on the unit cube** (Simon Ch. 2, Lemma 2.7 with
`θ = 1/4`, and the choice (31), (35) of `β_F` in the proof of the Deformation Theorem, Ch. 6, 5.1):
there is `c = c(m) > 0` such that every integer-valued `u` integrable on `Q₁ = (0, 1)^{m+1}` with
`∫_{Q₁} u div g ≤ V` for all smooth `g` with compact support in `Q₁` and `|g| ≤ 1` has an integer
`β` with `∫_{Q₁} |u − β| ≤ c V` and `|β| ≤ 2 ∫_{Q₁} |u|`.  Take the integer median `β`
(`dor_lmb_fcd_cp_integer_median`) and shrink `Q₁` to `Q_δ = (δ, 1 − δ)^{m+1}`, keeping half of
`∫ |u − β|` with `Lⁿ(Q₁ \ Q_δ) ≤ 1/4` (`dor_lmb_fcd_cp_shrinking`), so `β` is a `¼`-median of `u`
on `Q_δ`.  Normalized bumps of radius `δ/(k + 2)` give the BV Poincaré inequality on `Q_δ`
(`dor_lmb_fcd_cp_bv_poincare`), and `dor_lmb_fcd_cp_median_deviation` gives
`∫_{Q₁} |u − β| ≤ 2 ∫_{Q_δ} |u − β| ≤ 2 · 5 (m + 1)(1 − 2δ) V ≤ 10 (m + 1) V`. -/
theorem dor_lmb_fcd_cube_poincare : ∀ m : ℕ, ∃ c : ℝ, 0 < c ∧ ∀ (u : Euclid (m + 1) → ℝ) (V : ℝ), (∀ y, ∃ z : ℤ, u y = z) → IntegrableOn u {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ y, ‖g y‖ ≤ 1) → ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, u y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) ≤ V) → ∃ β : ℤ, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u y - β| ≤ c * V ∧ |(β : ℝ)| ≤ 2 * ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u y| := by
  intro m
  refine ⟨10 * ((m : ℝ) + 1), by positivity, ?_⟩
  intro u V hZ hu hH
  set Q₁ : Set (Euclid (m + 1)) := {y | ∀ i, 0 < y i ∧ y i < 1} with hQ₁
  -- Step 0: `V ≥ 0` (test `g = 0`); `{a < yᵢ < b}` is the preimage of the box `(a, b)ⁿ`, so it is
  -- measurable, and `Lⁿ(Q₁) = 1`
  have hV : 0 ≤ V := by
    have h0 := hH (fun _ => 0) contDiff_const HasCompactSupport.zero (by simp) (by simp)
    simpa using h0
  have hpre : ∀ a b : ℝ, {y : Euclid (m + 1) | ∀ i, a < y i ∧ y i < b} =
      WithLp.ofLp ⁻¹' (univ.pi fun _ : Fin (m + 1) => Ioo a b) := fun a b => by
    ext y
    simp [Set.mem_pi]
  have hmeas : ∀ a b : ℝ, MeasurableSet {y : Euclid (m + 1) | ∀ i, a < y i ∧ y i < b} :=
    fun a b => by
      rw [hpre]
      exact (PiLp.volume_preserving_ofLp (Fin (m + 1))).measurable
        (MeasurableSet.univ_pi fun _ => measurableSet_Ioo)
  have hvol₁ : volume Q₁ = 1 := by
    rw [hQ₁, hpre, (PiLp.volume_preserving_ofLp (Fin (m + 1))).measure_preimage
      (MeasurableSet.univ_pi fun _ => measurableSet_Ioo).nullMeasurableSet, Real.volume_pi_Ioo]
    simp
  -- Step 1: the integer median `β` of `u` on `Q₁` (Simon (31), (35))
  obtain ⟨β, hβge, hβle, hβbd⟩ := dor_lmb_fcd_cp_integer_median m u hZ hu
  refine ⟨β, ?_, hβbd⟩
  -- Step 2: shrink `Q₁` to `Q = Q_δ`, keeping half of `∫_{Q₁} |u − β|`
  have hf : IntegrableOn (fun y => u y - β) Q₁ :=
    hu.sub (integrableOn_const (by rw [hvol₁]; exact ENNReal.one_ne_top))
  obtain ⟨δ, hδ0, hδ4, hQ1, hlayer, hhalf⟩ := dor_lmb_fcd_cp_shrinking m (fun y => u y - β) hf
  set Q : Set (Euclid (m + 1)) := {y | ∀ i, δ < y i ∧ y i < 1 - δ}
  have hQQ₁ : Q ⊆ Q₁ := fun y hy i => ⟨hδ0.trans (hy i).1, (hy i).2.trans (by linarith)⟩
  have hQfin : volume Q ≠ ∞ := (hQ1.trans_lt ENNReal.one_lt_top).ne
  -- Step 3: median transfer, `Lⁿ(Q ∩ A) ≥ Lⁿ(Q₁ ∩ A) − Lⁿ(Q₁ \ Q) ≥ 1/4 ≥ ¼ Lⁿ(Q)` for
  -- `A = {β ≤ u}` and `A = {u ≤ β}`; in particular `Lⁿ(Q) > 0`
  have hq1 : (volume Q).toReal ≤ 1 := by
    have h := ENNReal.toReal_mono ENNReal.one_ne_top hQ1
    rwa [ENNReal.toReal_one] at h
  have htransfer : ∀ A : Set (Euclid (m + 1)), 1 / 2 ≤ volume (Q₁ ∩ A) →
      1 / 4 ≤ (volume (Q ∩ A)).toReal := by
    intro A hA
    have hsub : Q₁ ∩ A ⊆ (Q ∩ A) ∪ (Q₁ \ Q) := fun y hy => by
      by_cases hyQ : y ∈ Q
      · exact Or.inl ⟨hyQ, hy.2⟩
      · exact Or.inr ⟨hy.1, hyQ⟩
    have h1 : 1 / 2 ≤ volume (Q ∩ A) + 1 / 4 :=
      hA.trans ((measure_mono hsub).trans ((measure_union_le _ _).trans (add_le_add le_rfl hlayer)))
    have hfinA : volume (Q ∩ A) ≠ ∞ :=
      ((measure_mono inter_subset_left).trans_lt (hQ1.trans_lt ENNReal.one_lt_top)).ne
    have h2 := ENNReal.toReal_mono (ENNReal.add_ne_top.2 ⟨hfinA, by norm_num⟩) h1
    rw [ENNReal.toReal_add hfinA (by norm_num)] at h2
    have h3 : ((1 : ℝ≥0∞) / 2).toReal = 1 / 2 := by norm_num
    have h4 : ((1 : ℝ≥0∞) / 4).toReal = 1 / 4 := by norm_num
    rw [h3, h4] at h2
    linarith
  have hge : 1 / 4 * (volume Q).toReal ≤ (volume (Q ∩ {y | (β : ℝ) ≤ u y})).toReal := by
    linarith [htransfer _ hβge]
  have hle : 1 / 4 * (volume Q).toReal ≤ (volume (Q ∩ {y | u y ≤ (β : ℝ)})).toReal := by
    linarith [htransfer _ hβle]
  have hqpos : 0 < (volume Q).toReal := by
    have h : (volume (Q ∩ {y | (β : ℝ) ≤ u y})).toReal ≤ (volume Q).toReal :=
      ENNReal.toReal_mono hQfin (measure_mono inter_subset_left)
    linarith [htransfer _ hβge]
  -- Step 4: deviation from the `¼`-median `β` on `Q` (Simon 2.7)
  have hdev := dor_lmb_fcd_cp_median_deviation (m + 1) Q u β (1 / 4) (hmeas δ (1 - δ)) hQfin
    (hu.mono_set hQQ₁) (by norm_num) hge hle
  -- Step 5: normalized bumps `η_k` of radius `δ/(k + 2)`; their mollifications of `1_{Q₁} u`
  -- converge a.e. (Lebesgue differentiation), so the BV Poincaré inequality holds on `Q`
  let φ : ℕ → ContDiffBump (0 : Euclid (m + 1)) := fun k =>
    { rIn := δ / ((k : ℝ) + 2) / 2
      rOut := δ / ((k : ℝ) + 2)
      rIn_pos := by positivity
      rIn_lt_rOut := by
        have : 0 < δ / ((k : ℝ) + 2) := by positivity
        linarith }
  have hφ0 : Tendsto (fun k => (φ k).rOut) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop (tendsto_atTop_add_const_right _ _ tendsto_natCast_atTop_atTop)
  have hφK : ∀ᶠ k in atTop, (φ k).rOut ≤ 2 * (φ k).rIn :=
    Eventually.of_forall fun k => by
      change δ / ((k : ℝ) + 2) ≤ 2 * (δ / ((k : ℝ) + 2) / 2)
      linarith
  have hφs : ∀ k, support ((φ k).normed volume) ⊆ ball (0 : Euclid (m + 1)) δ := fun k => by
    rw [(φ k).support_normed_eq]
    exact ball_subset_ball (div_le_self hδ0.le (by linarith [(Nat.cast_nonneg k : (0 : ℝ) ≤ k)]))
  have hae := ContDiffBump.ae_convolution_tendsto_right_of_locallyIntegrable (μ := volume)
    hφ0 hφK (hu.integrable_indicator (hmeas 0 1)).locallyIntegrable
  have hbv := dor_lmb_fcd_cp_bv_poincare m u V δ (fun k => (φ k).normed volume) hu hH hδ0
    (by linarith) (fun k => (φ k).contDiff_normed) (fun k => (φ k).hasCompactSupport_normed)
    (fun k => (φ k).nonneg_normed) (fun k => (φ k).normed_neg) (fun k => (φ k).integral_normed)
    hφs hae
  -- Step 6: `∫_{Q₁} |u − β| ≤ 2 ∫_Q |u − β| ≤ 2 · 5 (m + 1)(1 − 2δ) V ≤ 10 (m + 1) V`
  have hQbd : ∫ y in Q, |u y - β| ≤ 5 * ((m : ℝ) + 1) * V := by
    have hmδV : 0 ≤ ((m : ℝ) + 1) * δ * V := by positivity
    calc ∫ y in Q, |u y - β|
        ≤ (1 + (1 / 4 : ℝ)⁻¹) * ((volume Q).toReal)⁻¹ * ∫ x in Q, ∫ y in Q, |u x - u y| := hdev
      _ ≤ (1 + (1 / 4 : ℝ)⁻¹) * ((volume Q).toReal)⁻¹ *
            (((m : ℝ) + 1) * (1 - 2 * δ) * (volume Q).toReal * V) :=
          mul_le_mul_of_nonneg_left hbv (by positivity)
      _ = 5 * ((m : ℝ) + 1) * (1 - 2 * δ) * V * (((volume Q).toReal)⁻¹ * (volume Q).toReal) := by
          ring
      _ = 5 * ((m : ℝ) + 1) * (1 - 2 * δ) * V := by rw [inv_mul_cancel₀ hqpos.ne', mul_one]
      _ ≤ 5 * ((m : ℝ) + 1) * V := by linarith
  calc ∫ y in Q₁, |u y - β| ≤ 2 * ∫ y in Q, |u y - β| := hhalf
    _ ≤ 2 * (5 * ((m : ℝ) + 1) * V) := by gcongr
    _ = 10 * ((m : ℝ) + 1) * V := by ring

end Submission

/-- **Face replacement** (Simon Ch. 6, proof of the Deformation Theorem 5.1, (26)–(37)): an
integer multiplicity `Q ∈ 𝒟ₙ(ℝᴾ)`, `n = m + 1 < P`, vanishing off `L_n ∩ K` (`K` compact) with
`M(∂Q) < ∞` is the lattice chain `Pc = Σ_{p ∈ s} β_p [[F_p]]` up to an integer multiplicity error
`Q − Pc` with `M(Q − Pc) ≤ c M(∂Q)`, where `Σ_p |β_p| ≤ c M(Q)` and `c = max(c_cp, 2)`.
The faces meeting `K` carry `Q` (`dor_lmb_fcd_fr_skeleton_cells`), so
`Q = Σ_p u_p [[F_p°]]` with integer densities `u_p` and `Σ_p ∫|u_p| ≤ M(Q)` ((26)–(28), (33));
testing `∂Q` near each face bounds the variation of `u_p` by `V_p`, `Σ_p V_p ≤ M(∂Q)` ((28)); the
cube Poincaré inequality gives integer medians `β_p` with `∫|u_p − β_p| ≤ c_cp V_p` and
`|β_p| ≤ 2∫|u_p|` ((31), (32), (35)).  Then `Q − Pc = Σ_p (u_p − β_p)[[F_p°]]` ((29)) has mass
`≤ Σ_p ∫|u_p − β_p| ≤ c_cp M(∂Q)` ((34)), `Σ_p |β_p| ≤ 2 M(Q)` ((36)), `Pc` is integer
multiplicity, and `Q − Pc` vanishes off `cthickening(√P, K) ⊇ F_p`. -/
theorem Submission.dor_lmb_fcd_face_replacement : ∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 0 ≤ c ∧ ∀ (K : Set (Euclid P)) (Q : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsCompact K → IsIntegerMultiplicity Q → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) ({x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} ∩ K) → Q ω = 0) → Q.boundary.mass ≠ ∞ → ∃ (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (β : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℤ) (Pc : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ p ∈ s, StrictMono p.2) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Pc ω = ∑ p ∈ s, (β p : ℝ) * ∫ x in {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)}, (ω : DifferentialForm (Euclid P) (m + 1)) x (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) ∂μHE[m + 1]) ∧ IsIntegerMultiplicity (Q - Pc) ∧ (Q - Pc).mass ≤ ENNReal.ofReal c * Q.boundary.mass ∧ (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞)) ≤ ENNReal.ofReal c * Q.mass ∧ (∀ p ∈ s, {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)} ⊆ cthickening (Real.sqrt P) K) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (cthickening (Real.sqrt P) K) → (Q - Pc) ω = 0 := by
  intro P m hmP
  -- `c_cp`: the cube Poincaré constant with integer medians (Simon Ch. 2, 2.7; Ch. 6, (31), (35))
  obtain ⟨ccp, hccp, hcp⟩ := Submission.dor_lmb_fcd_cube_poincare m
  refine ⟨max ccp 2, le_max_of_le_right zero_le_two, ?_⟩
  intro K Q hK hQ hQK hbd
  -- the finitely many faces `F_p` (`p ∈ s`) meeting `K`; their open faces carry `L_n ∩ K` a.e.
  obtain ⟨s, hs, hsK, hL, hcover⟩ := Submission.dor_lmb_fcd_fr_skeleton_cells P m K hmP hK
  -- (26)–(28), (33): `Q = Σ_p u_p [[F_p°]]` with integer densities and `Σ ∫|u_p| ≤ M(Q)`
  obtain ⟨u, huZ, huint, humass, hQu⟩ := Submission.dor_lmb_fcd_fr_face_representation P m s _ Q
    hs (hL.inter hK.isClosed) hcover hQ hQK
  -- (28): `∫ u_p div g ≤ V_p` for admissible `g`, with `Σ V_p ≤ M(∂Q)`
  obtain ⟨V, -, hVsum, hVvar⟩ :=
    Submission.dor_lmb_fcd_fr_boundary_variation P m s u Q hs hQu hbd
  -- (31), (32), (35): integer medians `β_p` with `∫|u_p − β_p| ≤ c_cp V_p`, `|β_p| ≤ 2∫|u_p|`
  have hβex : ∀ p, ∃ b : ℤ, p ∈ s →
      (∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u p y - b|) ≤ ccp * V p ∧
        |(b : ℝ)| ≤ 2 * ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u p y| := by
    intro p
    by_cases hp : p ∈ s
    · obtain ⟨b, hb⟩ := hcp (u p) (V p) (huZ p hp) (huint p hp) (hVvar p hp)
      exact ⟨b, fun _ => hb⟩
    · exact ⟨0, fun h => absurd h hp⟩
  choose β hβ using hβex
  -- constants are integrable on the unit cube `Q₁ = (0, 1)ⁿ`, of volume `1`
  have hconst : ∀ p ∈ s, ∀ b : ℝ,
      IntegrableOn (fun _ : Euclid (m + 1) => b) {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} := by
    intro p hp b
    have h1 := (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).1
    exact integrableOn_const (by rw [h1]; exact ENNReal.one_ne_top)
  -- the lattice chain `Pc = Σ_p β_p [[F_p]]`, and integrability of the face integrands
  obtain ⟨hβint, ⟨Pc, hPc⟩, -⟩ := Submission.dor_lmb_fcd_fr_chain_current P m s
    (fun p _ => (β p : ℝ)) hs fun p hp => hconst p hp _
  obtain ⟨huωint, -, -⟩ := Submission.dor_lmb_fcd_fr_chain_current P m s u hs huint
  -- the mass bound for currents with face densities `u_p − β_p`
  obtain ⟨-, -, hDmass⟩ := Submission.dor_lmb_fcd_fr_chain_current P m s
    (fun p y => u p y - β p) hs fun p hp => Integrable.sub (huint p hp) (hconst p hp _)
  beta_reduce at hβint hPc hDmass
  -- (29): `Q − Pc = Σ_p (u_p − β_p) [[F_p°]]`
  have hQP : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), (Q - Pc) ω =
      ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1},
        (u p y - β p) * (ω : DifferentialForm (Euclid P) (m + 1))
          (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ))
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) := by
    intro ω
    show Q ω - Pc ω = _
    rw [hQu ω, hPc ω, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun p hp => ?_
    rw [← integral_sub (huωint ω p hp) (hβint ω p hp)]
    congr 1
    funext y
    ring
  refine ⟨s, β, Pc, hs, ?_, ?_, ?_, ?_, hsK, ?_⟩
  · -- the face formula of `Pc`: `∫_{F_p} f dHⁿ = ∫_{Q₁} f ∘ Φ_p`
    intro ω
    rw [hPc ω]
    refine Finset.sum_congr rfl fun p hp => ?_
    rw [(Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.1]
    exact integral_const_mul _ _
  · -- `Pc` is integer multiplicity, hence so is `Q − Pc`
    exact Submission.cmc_imRep_locality_restrict_sub.2.2.1 P (m + 1) univ Q Pc isOpen_univ hQ
      (Submission.dor_lmb_fcd_fr_lattice_chain_im P m s β Pc hs hPc)
  · -- (34): `M(Q − Pc) ≤ Σ_p ∫|u_p − β_p| ≤ c_cp Σ_p V_p ≤ c M(∂Q)`
    calc (Q - Pc).mass
        ≤ ENNReal.ofReal (∑ p ∈ s,
            ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u p y - β p|) :=
          hDmass (Q - Pc) hQP
      _ ≤ ENNReal.ofReal (ccp * ∑ p ∈ s, V p) := by
          refine ENNReal.ofReal_le_ofReal ?_
          rw [Finset.mul_sum]
          exact Finset.sum_le_sum fun p hp => (hβ p hp).1
      _ = ENNReal.ofReal ccp * ENNReal.ofReal (∑ p ∈ s, V p) := ENNReal.ofReal_mul hccp.le
      _ ≤ ENNReal.ofReal (max ccp 2) * Q.boundary.mass :=
          mul_le_mul' (ENNReal.ofReal_le_ofReal (le_max_left _ _)) hVsum
  · -- (36): `Σ_p |β_p| ≤ 2 Σ_p ∫|u_p| ≤ c M(Q)`
    calc (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞))
        = ENNReal.ofReal (∑ p ∈ s, |(β p : ℝ)|) := by
          rw [ENNReal.ofReal_sum_of_nonneg fun p _ => abs_nonneg _]
          refine Finset.sum_congr rfl fun p _ => ?_
          rw [← ENNReal.ofReal_natCast, Nat.cast_natAbs, Int.cast_abs]
      _ ≤ ENNReal.ofReal (2 * ∑ p ∈ s,
            ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u p y|) := by
          refine ENNReal.ofReal_le_ofReal ?_
          rw [Finset.mul_sum]
          exact Finset.sum_le_sum fun p hp => (hβ p hp).2
      _ = ENNReal.ofReal 2 * ENNReal.ofReal (∑ p ∈ s,
            ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u p y|) :=
          ENNReal.ofReal_mul zero_le_two
      _ ≤ ENNReal.ofReal (max ccp 2) * Q.mass :=
          mul_le_mul' (ENNReal.ofReal_le_ofReal (le_max_right _ _)) humass
  · -- `Q − Pc` vanishes off `cthickening(√P, K)`, which contains every `F_p ⊇ Φ_p(Q₁)`
    intro ω hω
    rw [hQP ω]
    refine Finset.sum_eq_zero fun p hp => setIntegral_eq_zero_of_forall_eq_zero fun y hy => ?_
    have hmem := (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.2.1 y
      fun i => ⟨(hy i).1.le, (hy i).2.le⟩
    rw [image_eq_zero_of_notMem_tsupport (Set.disjoint_right.1 hω (hsK p hp hmem))]
    simp

/-- **Simon Ch. 6, Deformation Theorem 5.1 (unit scale), display (38) and the end of its proof.**
Let `n = m + 1 < P`, `K` compact and `T ∈ 𝒟ₙ(ℝᴾ)` integer multiplicity, with `∂T` integer
multiplicity and `T` vanishing off `K`.  By 3.2(3), `μ_T` and `μ_{∂T}` are carried by `K`, where
the multiplicities are integrable, so `M(T), M(∂T) < ∞`.  The skeleton deformation gives
`T − Q = ∂R₁ + S₁` with `Q` carried by the `n`-skeleton in `K_Q = cthickening(√P, K)`; face
replacement gives the unit lattice chain `Pc = Σ_{p ∈ s} β_p [[F_p]]` with `M(Q − Pc) ≤ c_f M(∂Q)`
and `Σ_p |β_p| ≤ c_f M(Q)`.  Then `R = R₁` and `S = S₁ + (Q − Pc)` give `T − Pc = ∂R + S` with
`c = c_s(1 + c_f)`, and `cthickening(√P, K_Q) ⊆ cthickening(2√P, K)`. -/
theorem Submission.dor_lmb_fcd_unit_deformation : ((∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (n + 1)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → RT.Represents T → RB.Represents T.boundary → LipschitzWith L f → ∃ Ps : ℝ → GeometricCurrentOn U n, (∀ W : Set (Euclid P), IsOpen W → AEMeasurable (fun t => (Ps t).massOn W) ∧ ∫⁻ t, (Ps t).massOn W ≤ (L : ℝ≥0∞) * T.massOn W) ∧ ∀ᵐ t, IsIntegerMultiplicity (Ps t) ∧ (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (f ⁻¹' {t}) → Ps t ω = 0) ∧ ∀ ω : TestFormOn U n, Ps t ω = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → (∀ (P m : ℕ) (U : Set (Euclid P)) (X : ℕ → GeometricCurrentOn U (m + 1)), IsOpen U → (∀ r, IsIntegerMultiplicity (X r)) → ∑' r, (X r).mass ≠ ∞ → ∃ Y : GeometricCurrentOn U (m + 1), IsIntegerMultiplicity Y ∧ (∀ ω : TestFormOn U (m + 1), HasSum (fun r => X r ω) (Y ω)) ∧ Y.mass ≤ ∑' r, (X r).mass) → ∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 0 ≤ c ∧ ∀ (K : Set (Euclid P)) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsCompact K → IsIntegerMultiplicity T → IsIntegerMultiplicity T.boundary → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (K) → T ω = 0) → ∃ (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (β : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℤ) (Pc : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ p ∈ s, StrictMono p.2) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Pc ω = ∑ p ∈ s, (β p : ℝ) * ∫ x in {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)}, (ω : DifferentialForm (Euclid P) (m + 1)) x (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) ∂μHE[m + 1]) ∧ IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), T ω - Pc ω = R.boundary ω + S ω) ∧ (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞)) ≤ ENNReal.ofReal c * T.mass ∧ R.mass ≤ ENNReal.ofReal c * T.mass ∧ S.mass ≤ ENNReal.ofReal c * T.boundary.mass ∧ (∀ p ∈ s, {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)} ⊆ cthickening (2 * Real.sqrt P) K) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 2), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 2))) (cthickening (2 * Real.sqrt P) K) → R ω = 0) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (cthickening (2 * Real.sqrt P) K) → S ω = 0 := by
  intro hSL hIMS P m hmP
  -- Step 1: the constants `c_s` (skeleton deformation) and `c_f` (face replacement)
  obtain ⟨cs, hcs, hSD⟩ := Submission.dor_lmb_fcd_skeleton_deformation hSL hIMS P m hmP
  obtain ⟨cf, hcf, hFR⟩ := Submission.dor_lmb_fcd_face_replacement P m hmP
  refine ⟨cs * (1 + cf), mul_nonneg hcs (by linarith), ?_⟩
  intro K T hK hT hbT hTK
  -- `(A − B)(ω) = A(ω) − B(ω)` and `M(A − B) ≤ M(A) + M(B)` (with `ω` admissible, so is `−ω`)
  have hsub : ∀ {d : ℕ} (A B : GeometricCurrentOn (univ : Set (Euclid P)) d)
      (ω : TestFormOn (univ : Set (Euclid P)) d), (A - B) ω = A ω - B ω := fun _ _ _ => rfl
  have hmass_sub : ∀ {d : ℕ} (A B : GeometricCurrentOn (univ : Set (Euclid P)) d),
      (A - B).mass ≤ A.mass + B.mass := by
    intro d A B
    refine sSup_le ?_
    rintro r ⟨ω, hω, rfl⟩
    have hω' : -ω ∈ massAdmissibleOn (univ : Set (Euclid P)) d univ :=
      ⟨subset_univ _, fun x => by simpa using hω.2 x⟩
    have h : (A - B) ω = A ω + B (-ω) := by
      show A.toCurrent ω - B.toCurrent ω = A.toCurrent ω + B.toCurrent (-ω)
      rw [B.toCurrent.map_neg ω, sub_eq_add_neg]
    calc ENNReal.ofReal ((A - B) ω) = ENNReal.ofReal (A ω + B (-ω)) := by rw [h]
      _ ≤ ENNReal.ofReal (A ω) + ENNReal.ofReal (B (-ω)) := ENNReal.ofReal_add_le
      _ ≤ A.mass + B.mass := add_le_add (A.le_massOn hω) (B.le_massOn hω')
  -- Step 2: an integer multiplicity current vanishing off the compact `K` has finite mass:
  -- `M(X) = μ_X(ℝᴾ) = μ_X(K) < ∞`, as `μ_X(ℝᴾ ∖ K) = M_{ℝᴾ∖K}(X) = 0` (3.2(3))
  have hfin : ∀ {d : ℕ} (X : GeometricCurrentOn (univ : Set (Euclid P)) d),
      IsIntegerMultiplicity X → (∀ ω : TestFormOn (univ : Set (Euclid P)) d,
        Disjoint (tsupport (ω : DifferentialForm (Euclid P) d)) K → X ω = 0) → X.mass ≠ ∞ := by
    intro d X ⟨RX, hRX⟩ hXK
    have hmass := (Submission.dor_imrep_massOn_eq_measure_and_support P d univ X RX isOpen_univ
      hRX).1
    have hKc : RX.measure Kᶜ = 0 := by
      rw [← hmass Kᶜ hK.isClosed.isOpen_compl]
      refine le_antisymm (sSup_le ?_) zero_le
      rintro r ⟨ω, hω, rfl⟩
      show ENNReal.ofReal (X ω) ≤ 0
      rw [hXK ω (disjoint_compl_left.mono_left hω.1), ENNReal.ofReal_zero]
    have hKfin : RX.measure K ≠ ∞ := by
      rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
        Measure.restrict_restrict hK.measurableSet, inter_comm]
      exact RX.locallyIntegrable_mult K hK (subset_univ K)
    show X.massOn univ ≠ ∞
    rw [hmass univ isOpen_univ]
    exact ne_top_of_le_ne_top (by rw [hKc, add_zero]; exact hKfin) (measure_univ_le_add_compl K)
  -- `∂T` vanishes off `K` too, since `spt dω ⊆ spt ω`
  have hbTK : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) K → T.boundary ω = 0 := fun ω hω =>
    hTK _ (hω.mono_left (tsupport_exteriorDerivative_subset (ω : DifferentialForm (Euclid P) m)))
  have hTfin : T.mass ≠ ∞ := hfin T hT hTK
  have hbTfin : T.boundary.mass ≠ ∞ := hfin T.boundary hbT hbTK
  -- Step 3: `T − Q = ∂R₁ + S₁`, `Q` carried by the `n`-skeleton in `K_Q = cthickening(√P, K)`
  obtain ⟨Q, R₁, S₁, hQ, hR₁, hS₁, hTQ, hQmass, hbQmass, hR₁mass, hS₁mass, hQK, hR₁K, hS₁K⟩ :=
    hSD K T hK hT hbT hTK hTfin hbTfin
  -- Step 4: the unit lattice chain `Pc` replacing `Q`, with `M(∂Q) ≤ c_s M(∂T) < ∞`
  have hbQfin : Q.boundary.mass ≠ ∞ :=
    ne_top_of_le_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hbTfin) hbQmass
  obtain ⟨s, β, Pc, hmono, hPc, hQPc, hQPcmass, hβ, hface, hQPcK⟩ :=
    hFR (cthickening (Real.sqrt P) K) Q hK.cthickening hQ hQK hbQfin
  -- Step 7: `cthickening(√P, K) ⊆ cthickening(2√P, K)` and
  -- `cthickening(√P, cthickening(√P, K)) ⊆ cthickening(2√P, K)`
  have hsq : 0 ≤ Real.sqrt P := Real.sqrt_nonneg _
  have hK₁ : cthickening (Real.sqrt P) K ⊆ cthickening (2 * Real.sqrt P) K :=
    cthickening_mono (by linarith) K
  have hK₂ : cthickening (Real.sqrt P) (cthickening (Real.sqrt P) K) ⊆
      cthickening (2 * Real.sqrt P) K := by
    rw [two_mul]
    exact cthickening_cthickening_subset hsq hsq K
  -- Step 5, (38): `R = R₁`, `S = S₁ + (Q − Pc) = S₁ − ((Q − Q) − (Q − Pc))`, integer multiplicity
  have hIMsub := Submission.cmc_imRep_locality_restrict_sub.2.2.1 P (m + 1) univ
  refine ⟨s, β, Pc, R₁, S₁ - ((Q - Q) - (Q - Pc)), hmono, hPc, hR₁,
    hIMsub _ _ isOpen_univ hS₁ (hIMsub _ _ isOpen_univ (hIMsub _ _ isOpen_univ hQ hQ) hQPc),
    fun ω => ?_, ?_, ?_, ?_, fun p hp => (hface p hp).trans hK₂,
    fun ω hω => hR₁K ω (hω.mono_right hK₁), fun ω hω => ?_⟩
  · -- `T − Pc = (T − Q) + (Q − Pc) = ∂R₁ + S₁ + (Q − Pc)`
    simp only [hsub]
    linarith [hTQ ω]
  · -- Step 6: `Σ|β_p| ≤ c_f M(Q) ≤ c_f c_s M(T)`
    calc (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞)) ≤ ENNReal.ofReal cf * Q.mass := hβ
      _ ≤ ENNReal.ofReal cf * (ENNReal.ofReal cs * T.mass) := by gcongr
      _ = ENNReal.ofReal (cf * cs) * T.mass := by rw [← mul_assoc, ← ENNReal.ofReal_mul hcf]
      _ ≤ ENNReal.ofReal (cs * (1 + cf)) * T.mass := by gcongr ENNReal.ofReal ?_ * _; nlinarith
  · -- `M(R) = M(R₁) ≤ c_s M(T)`
    calc R₁.mass ≤ ENNReal.ofReal cs * T.mass := hR₁mass
      _ ≤ ENNReal.ofReal (cs * (1 + cf)) * T.mass := by gcongr ENNReal.ofReal ?_ * _; nlinarith
  · -- `M(S) ≤ M(S₁) + M(Q − Q) + M(Q − Pc) ≤ c_s M(∂T) + c_f c_s M(∂T)`, as `Q − Q = 0`
    have hQQ : (Q - Q).mass = 0 := by
      refine le_antisymm (sSup_le ?_) zero_le
      rintro r ⟨ω, -, rfl⟩
      show ENNReal.ofReal (Q ω - Q ω) ≤ 0
      rw [sub_self, ENNReal.ofReal_zero]
    calc (S₁ - ((Q - Q) - (Q - Pc))).mass ≤ S₁.mass + ((Q - Q).mass + (Q - Pc).mass) :=
          (hmass_sub _ _).trans (add_le_add le_rfl (hmass_sub _ _))
      _ = S₁.mass + (Q - Pc).mass := by rw [hQQ, zero_add]
      _ ≤ ENNReal.ofReal cs * T.boundary.mass + ENNReal.ofReal cf * Q.boundary.mass :=
          add_le_add hS₁mass hQPcmass
      _ ≤ ENNReal.ofReal cs * T.boundary.mass +
            ENNReal.ofReal cf * (ENNReal.ofReal cs * T.boundary.mass) := by gcongr
      _ = ENNReal.ofReal (cs * (1 + cf)) * T.boundary.mass := by
          rw [← mul_assoc, ← add_mul, ← ENNReal.ofReal_mul hcf,
            ← ENNReal.ofReal_add hcs (mul_nonneg hcf hcs)]
          congr 2
          ring
  · -- `S` vanishes off `cthickening(2√P, K)`: so do `S₁` and `Q − Pc`
    have h₁ := hS₁K ω (hω.mono_right hK₁)
    have h₂ := hQPcK ω (hω.mono_right hK₂)
    simp only [hsub] at h₂ ⊢
    linarith

/-- **Simon Ch. 6, Deformation Theorem 5.3** (5.1 after a change of scale) for an integer
multiplicity `T ∈ 𝒟ₙ(ℝᴾ)`, `n = m + 1 < P`, with integer multiplicity `∂T`, vanishing off a compact
`K`: `T − Π = ∂R + S` with `Π = Σ_{p ∈ s} β_p [[F_p]]` an integer combination of the oriented
faces `F_p = ρ(z_p + F_{ι_p})` of the cubical grid of side `ρ`, `(Σ|β_p|)ρⁿ ≤ c M(T)`,
`M(R) ≤ cρ M(T)`, `M(S) ≤ cρ M(∂T)`, and everything within `2√P ρ` of `K`.  As printed before 5.3:
change scale by `x ↦ ρ⁻¹x`, apply the unit-scale theorem 5.1 to `T' = δ_{ρ⁻¹#}T` (integer
multiplicity, `∂T' = δ_{ρ⁻¹#}∂T` integer multiplicity, vanishing off the compact `ρ⁻¹K`) and
change scale back by `δ_ρ(x) = ρx`.  `δ_ρ` maps the unit faces onto the faces of side `ρ`, with
`∫_{ρA} g dHⁿ = ρⁿ ∫_A g(ρx) dHⁿ(x)` and `δ_{ρ#}X(ω) = X(ρⁿ ω(ρ ·))`; masses of `k`-currents scale
by `ρᵏ`; and `ρ · cthickening(2√P, ρ⁻¹K) ⊆ cthickening(2√P ρ, K)`. -/
theorem Submission.dor_lmb_fc_deformation : ((∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (n + 1)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → RT.Represents T → RB.Represents T.boundary → LipschitzWith L f → ∃ Ps : ℝ → GeometricCurrentOn U n, (∀ W : Set (Euclid P), IsOpen W → AEMeasurable (fun t => (Ps t).massOn W) ∧ ∫⁻ t, (Ps t).massOn W ≤ (L : ℝ≥0∞) * T.massOn W) ∧ ∀ᵐ t, IsIntegerMultiplicity (Ps t) ∧ (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (f ⁻¹' {t}) → Ps t ω = 0) ∧ ∀ ω : TestFormOn U n, Ps t ω = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → ∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 0 ≤ c ∧ ∀ (ρ : ℝ) (K : Set (Euclid P)) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 0 < ρ → IsCompact K → IsIntegerMultiplicity T → IsIntegerMultiplicity T.boundary → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) K → T ω = 0) → ∃ (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (β : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℤ) (Pc : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ p ∈ s, StrictMono p.2) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Pc ω = ∑ p ∈ s, (β p : ℝ) * ∫ x in {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧ (i ∉ Set.range p.2 → x i = ρ * p.1 i)}, (ω : DifferentialForm (Euclid P) (m + 1)) x (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) ∂μHE[m + 1]) ∧ IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), T ω - Pc ω = R.boundary ω + S ω) ∧ (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞)) * ENNReal.ofReal (ρ ^ (m + 1)) ≤ ENNReal.ofReal c * T.mass ∧ R.mass ≤ ENNReal.ofReal (c * ρ) * T.mass ∧ S.mass ≤ ENNReal.ofReal (c * ρ) * T.boundary.mass ∧ (∀ p ∈ s, {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧ (i ∉ Set.range p.2 → x i = ρ * p.1 i)} ⊆ cthickening (2 * Real.sqrt P * ρ) K) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 2), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 2))) (cthickening (2 * Real.sqrt P * ρ) K) → R ω = 0) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (cthickening (2 * Real.sqrt P * ρ) K) → S ω = 0 := by
  intro hSL P m hPm
  -- Theorem 5.1 at unit scale, and the dilations `δ_λ(x) = λx`
  obtain ⟨c, hc, hunit⟩ :=
    Submission.dor_lmb_fcd_unit_deformation hSL Submission.dor_lmb_fc_im_series P m hPm
  obtain ⟨dil, hdil⟩ := Submission.dor_lmb_fcd_dilation P
  refine ⟨c, hc, fun ρ K T hρ hK hT hbT hTK => ?_⟩
  have hρ' : 0 < ρ⁻¹ := inv_pos.mpr hρ
  obtain ⟨-, hinv, hmass, hIM, -, hvan, -, -⟩ := hdil (m + 1) ρ⁻¹ hρ'
  obtain ⟨-, -, hmass₀, hIM₀, hbd₀, -, -, -⟩ := hdil m ρ⁻¹ hρ'
  obtain ⟨-, -, hmassρ, hIMρ, hbdρ, hvanρ, hactρ, hcovρ⟩ := hdil (m + 1) ρ hρ
  obtain ⟨-, -, hmassρ₂, hIMρ₂, -, hvanρ₂, -, -⟩ := hdil (m + 2) ρ hρ
  -- `T' = δ_{ρ⁻¹#}T` is integer multiplicity with integer multiplicity boundary
  -- `∂T' = δ_{ρ⁻¹#}∂T`, and it vanishes off the compact `ρ⁻¹K`
  have hK' : IsCompact ((fun x : Euclid P => ρ⁻¹ • x) '' K) := hK.image (continuous_const_smul ρ⁻¹)
  have hbT' : (dil (m + 1) ρ⁻¹ T).boundary = dil m ρ⁻¹ T.boundary := hbd₀ T
  have hbT'IM : IsIntegerMultiplicity (dil (m + 1) ρ⁻¹ T).boundary := by
    rw [hbT']
    exact hIM₀ _ hbT
  obtain ⟨s, β, Pc', R', S', hmono, hPc', hR', hS', hTPc', hβ, hR'mass, hS'mass, hface',
      hR'van, hS'van⟩ := hunit _ (dil (m + 1) ρ⁻¹ T) hK' (hIM T hT) hbT'IM (hvan T K hTK)
  -- `δ_{ρ#}T' = T`
  have hTT : dil (m + 1) ρ (dil (m + 1) ρ⁻¹ T) = T := by
    simpa only [inv_inv] using hinv T
  -- `δ_{ρ#}X(ω) = X(η)` with the same test form `η = ρ^{m+1} ω(ρ ·)` for every `X`
  have hpull : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1),
      ∃ η : TestFormOn (univ : Set (Euclid P)) (m + 1),
        (∀ x, (η : DifferentialForm (Euclid P) (m + 1)) x =
          ρ ^ (m + 1) • (ω : DifferentialForm (Euclid P) (m + 1)) (ρ • x)) ∧
        ∀ X : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), dil (m + 1) ρ X ω = X η := by
    intro ω
    obtain ⟨η, hη, -⟩ := hactρ T ω
    refine ⟨η, hη, fun X => ?_⟩
    obtain ⟨η', hη', hX⟩ := hactρ X ω
    rw [hX, show η' = η from Subtype.ext (funext fun x => (hη' x).trans (hη x).symm)]
  -- the faces of side `ρ` are the images under `δ_ρ` of the unit faces
  have hface : ∀ p : (Fin P → ℤ) × (Fin (m + 1) → Fin P),
      {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧
        (i ∉ Set.range p.2 → x i = ρ * p.1 i)} =
      (fun x => ρ • x) '' {x : Euclid P | ∀ i : Fin P,
        (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧
          (i ∉ Set.range p.2 → x i = p.1 i)} := by
    intro p
    ext x
    simp only [Set.mem_ofPred_eq, Set.mem_image]
    constructor
    · intro hx
      refine ⟨ρ⁻¹ • x, fun i => ?_, smul_inv_smul₀ hρ.ne' x⟩
      rw [PiLp.smul_apply, smul_eq_mul]
      refine ⟨fun hi => ?_, fun hi => ?_⟩
      · obtain ⟨h₁, h₂⟩ := (hx i).1 hi
        exact ⟨(le_inv_mul_iff₀ hρ).mpr h₁, (inv_mul_le_iff₀ hρ).mpr h₂⟩
      · rw [(hx i).2 hi, inv_mul_cancel_left₀ hρ.ne']
    · rintro ⟨y, hy, rfl⟩ i
      rw [PiLp.smul_apply, smul_eq_mul]
      refine ⟨fun hi => ?_, fun hi => ?_⟩
      · obtain ⟨h₁, h₂⟩ := (hy i).1 hi
        exact ⟨mul_le_mul_of_nonneg_left h₁ hρ.le, mul_le_mul_of_nonneg_left h₂ hρ.le⟩
      · rw [(hy i).2 hi]
  -- `δ_ρ(cthickening(2√P, ρ⁻¹K)) ⊆ cthickening(2√P ρ, K)`
  have hthick : (fun x => ρ • x) '' cthickening (2 * Real.sqrt P)
      ((fun x : Euclid P => ρ⁻¹ • x) '' K) ⊆ cthickening (2 * Real.sqrt P * ρ) K := by
    rintro _ ⟨y, hy, rfl⟩
    rw [hK'.cthickening_eq_biUnion_closedBall (by positivity)] at hy
    obtain ⟨_, ⟨k, hk, rfl⟩, hyk⟩ := mem_iUnion₂.mp hy
    refine mem_cthickening_of_dist_le _ k _ K hk ?_
    calc dist (ρ • y) k = dist (ρ • y) (ρ • ρ⁻¹ • k) := by rw [smul_inv_smul₀ hρ.ne']
      _ = ρ * dist y (ρ⁻¹ • k) := by rw [dist_smul₀, Real.norm_of_nonneg hρ.le]
      _ ≤ ρ * (2 * Real.sqrt P) := by
        gcongr
        exact mem_closedBall.mp hyk
      _ = 2 * Real.sqrt P * ρ := by ring
  -- `Π = δ_{ρ#}Π'`, `R = δ_{ρ#}R'`, `S = δ_{ρ#}S'`
  refine ⟨s, β, dil (m + 1) ρ Pc', dil (m + 2) ρ R', dil (m + 1) ρ S', hmono, fun ω => ?_,
    hIMρ₂ R' hR', hIMρ S' hS', fun ω => ?_, ?_, ?_, ?_, fun p hp => ?_,
    fun ω hω => hvanρ₂ R' _ hR'van ω (hω.mono_right hthick),
    fun ω hω => hvanρ S' _ hS'van ω (hω.mono_right hthick)⟩
  · -- `Π(ω) = Π'(ρ^{m+1} ω(ρ ·)) = Σ_p β_p ρ^{m+1} ∫_{F¹_p} ω(ρx)(e_{ι_p}) dHⁿ(x)`, which is
    -- `Σ_p β_p [[F_p]](ω)` by the change of variables `x ↦ ρx`
    obtain ⟨η, hη, hX⟩ := hpull ω
    rw [hX, hPc']
    simp_rw [hη, ContinuousAlternatingMap.smul_apply, smul_eq_mul, integral_const_mul]
    refine Finset.sum_congr rfl fun p _ => ?_
    rw [hface p, hcovρ]
  · -- `T − Π = δ_{ρ#}(T' − Π') = δ_{ρ#}(∂R' + S') = ∂R + S`
    obtain ⟨η, -, hX⟩ := hpull ω
    have hRb : (dil (m + 2) ρ R').boundary = dil (m + 1) ρ R'.boundary := hbdρ R'
    rw [← hTT, hRb]
    simp only [hX]
    exact hTPc' η
  · -- `(Σ|β_p|)ρⁿ ≤ c M(T')ρⁿ = c M(T)`
    have h1 : ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) * ENNReal.ofReal (ρ ^ (m + 1)) = 1 := by
      rw [← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ ρ⁻¹ ^ (m + 1)), ← mul_pow,
        inv_mul_cancel₀ hρ.ne', one_pow, ENNReal.ofReal_one]
    calc (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞)) * ENNReal.ofReal (ρ ^ (m + 1))
        ≤ ENNReal.ofReal c * (dil (m + 1) ρ⁻¹ T).mass * ENNReal.ofReal (ρ ^ (m + 1)) := by
          gcongr
      _ = ENNReal.ofReal c * T.mass *
          (ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) * ENNReal.ofReal (ρ ^ (m + 1))) := by
          rw [hmass T]
          ring
      _ = ENNReal.ofReal c * T.mass := by rw [h1, mul_one]
  · -- `M(R) = ρ^{m+2} M(R') ≤ ρ^{m+2} c M(T') = cρ M(T)`
    have h2 : ENNReal.ofReal (ρ ^ (m + 2)) * (ENNReal.ofReal c * ENNReal.ofReal (ρ⁻¹ ^ (m + 1))) =
        ENNReal.ofReal (c * ρ) := by
      rw [← ENNReal.ofReal_mul hc, ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ ρ ^ (m + 2))]
      congr 1
      calc ρ ^ (m + 2) * (c * ρ⁻¹ ^ (m + 1)) = c * ρ * (ρ * ρ⁻¹) ^ (m + 1) := by ring
        _ = c * ρ := by rw [mul_inv_cancel₀ hρ.ne', one_pow, mul_one]
    calc (dil (m + 2) ρ R').mass = ENNReal.ofReal (ρ ^ (m + 2)) * R'.mass := hmassρ₂ R'
      _ ≤ ENNReal.ofReal (ρ ^ (m + 2)) * (ENNReal.ofReal c * (dil (m + 1) ρ⁻¹ T).mass) := by
          gcongr
      _ = ENNReal.ofReal (ρ ^ (m + 2)) * (ENNReal.ofReal c * ENNReal.ofReal (ρ⁻¹ ^ (m + 1))) *
          T.mass := by
          rw [hmass T]
          ring
      _ = ENNReal.ofReal (c * ρ) * T.mass := by rw [h2]
  · -- `M(S) = ρ^{m+1} M(S') ≤ ρ^{m+1} c M(∂T') = cρ M(∂T)`
    have h3 : ENNReal.ofReal (ρ ^ (m + 1)) * (ENNReal.ofReal c * ENNReal.ofReal (ρ⁻¹ ^ m)) =
        ENNReal.ofReal (c * ρ) := by
      rw [← ENNReal.ofReal_mul hc, ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ ρ ^ (m + 1))]
      congr 1
      calc ρ ^ (m + 1) * (c * ρ⁻¹ ^ m) = c * ρ * (ρ * ρ⁻¹) ^ m := by ring
        _ = c * ρ := by rw [mul_inv_cancel₀ hρ.ne', one_pow, mul_one]
    calc (dil (m + 1) ρ S').mass = ENNReal.ofReal (ρ ^ (m + 1)) * S'.mass := hmassρ S'
      _ ≤ ENNReal.ofReal (ρ ^ (m + 1)) *
          (ENNReal.ofReal c * (dil (m + 1) ρ⁻¹ T).boundary.mass) := by
          gcongr
      _ = ENNReal.ofReal (ρ ^ (m + 1)) * (ENNReal.ofReal c * ENNReal.ofReal (ρ⁻¹ ^ m)) *
          T.boundary.mass := by
          rw [hbT', hmass₀]
          ring
      _ = ENNReal.ofReal (c * ρ) * T.boundary.mass := by rw [h3]
  · -- `F_p = δ_ρ(F¹_p) ⊆ δ_ρ(cthickening(2√P, ρ⁻¹K)) ⊆ cthickening(2√P ρ, K)`
    rw [hface p]
    exact (image_mono (hface' p hp)).trans hthick

/-- **Top-dimensional Deformation Theorem** (Simon Ch. 6, Theorem 5.3 in the case `n = P`, which
the book excludes; step 2(c) of the flat-convergence argument).  Assume (SL).  For `n = m + 1 = P`
there is `c ≥ 0` such that every IM `T ∈ 𝒟ₙ(ℝᴾ)` with IM boundary, vanishing off a compact `K`,
splits for every `ρ > 0` as `T − Π = ∂R + S`: `Π` is an integer combination of the grid cubes
`ρ(z + [0, 1]ᴾ)`, `R = 0`, `S` is IM, `(Σ|β|)ρⁿ ≤ c M(T)`, `M(S) ≤ cρ M(∂T)`, and the cubes, `R`
and `S` lie in `cthickening(2√(P+1)ρ, K)`.
Proof: embed `ι₀ x = (x, 0)`; `T̃ = ι₀#T` and `∂T̃ = ι₀#∂T` are IM with the masses of `T`, `∂T`,
and `T̃` vanishes off `ι₀(K)`.  Deform `T̃` in `ℝ^{P+1}` (codimension one): `T̃ − Π̃ = ∂R̃ + S̃`.
Test this on `ω̃ = ζ · p^#ω`, `p` the projection and `ζ = 1` near the cells: `T̃(ω̃) = T(ω)`
(`p ∘ ι₀ = id`), `∂R̃(ω̃) = R̃(p^#dω) = 0` since `(n + 1)`-covectors on `ℝⁿ` vanish, vertical
cells drop out and horizontal ones project isometrically onto grid cubes.  So `Π := T − S` with
`S(ω) := S̃(ω̃)` is an integer cube chain, hence IM, and `S = T − Π` is IM; `|ω̃(y)| ≤ |ω(py)|`
gives `M(S) ≤ M(S̃)`, and `p(cthickening(r, ι₀(K))) ⊆ cthickening(r, K)` gives the supports. -/
theorem Submission.dor_lmb_fc_deformation_top : ((∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (n + 1)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → RT.Represents T → RB.Represents T.boundary → LipschitzWith L f → ∃ Ps : ℝ → GeometricCurrentOn U n, (∀ W : Set (Euclid P), IsOpen W → AEMeasurable (fun t => (Ps t).massOn W) ∧ ∫⁻ t, (Ps t).massOn W ≤ (L : ℝ≥0∞) * T.massOn W) ∧ ∀ᵐ t, IsIntegerMultiplicity (Ps t) ∧ (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (f ⁻¹' {t}) → Ps t ω = 0) ∧ ∀ ω : TestFormOn U n, Ps t ω = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → ∀ (P m : ℕ), m + 1 = P → ∃ c : ℝ, 0 ≤ c ∧ ∀ (ρ : ℝ) (K : Set (Euclid P)) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 0 < ρ → IsCompact K → IsIntegerMultiplicity T → IsIntegerMultiplicity T.boundary → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) K → T ω = 0) → ∃ (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (β : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℤ) (Pc : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ p ∈ s, StrictMono p.2) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Pc ω = ∑ p ∈ s, (β p : ℝ) * ∫ x in {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧ (i ∉ Set.range p.2 → x i = ρ * p.1 i)}, (ω : DifferentialForm (Euclid P) (m + 1)) x (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) ∂μHE[m + 1]) ∧ IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), T ω - Pc ω = R.boundary ω + S ω) ∧ (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞)) * ENNReal.ofReal (ρ ^ (m + 1)) ≤ ENNReal.ofReal c * T.mass ∧ R.mass ≤ ENNReal.ofReal (c * ρ) * T.mass ∧ S.mass ≤ ENNReal.ofReal (c * ρ) * T.boundary.mass ∧ (∀ p ∈ s, {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧ (i ∉ Set.range p.2 → x i = ρ * p.1 i)} ⊆ cthickening (2 * Real.sqrt (P + 1) * ρ) K) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 2), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 2))) (cthickening (2 * Real.sqrt (P + 1) * ρ) K) → R ω = 0) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (cthickening (2 * Real.sqrt (P + 1) * ρ) K) → S ω = 0 := by
  intro hSL P m hmP
  subst hmP
  classical
  -- Step 3 (constant): Deformation Theorem 5.3 in `ℝ^{P+1}`, valid as `m + 1 < P + 1`
  obtain ⟨c₀, hc₀, hdef⟩ := Submission.dor_lmb_fc_deformation hSL (m + 1 + 1) m (by omega)
  refine ⟨c₀, hc₀, fun ρ K T hρ hK hT hbT hTK => ?_⟩
  -- Notation: the projection `p y = (y₀, …, y_{P-1})` and the embedding `ι₀ x = (x, 0)`
  let p : Euclid (m + 1 + 1) →L[ℝ] Euclid (m + 1) :=
    (EuclideanSpace.equiv (Fin (m + 1)) ℝ).symm.toContinuousLinearMap.comp
      (ContinuousLinearMap.pi fun i => EuclideanSpace.proj (Fin.castSucc i))
  have hp : ∀ (y : Euclid (m + 1 + 1)) (i : Fin (m + 1)), p y i = y (Fin.castSucc i) :=
    fun y i => rfl
  let ι₀ : Euclid (m + 1) →L[ℝ] Euclid (m + 1 + 1) :=
    (EuclideanSpace.equiv (Fin (m + 1 + 1)) ℝ).symm.toContinuousLinearMap.comp
      (ContinuousLinearMap.pi (Fin.snoc (α := fun _ => Euclid (m + 1) →L[ℝ] ℝ)
        (fun i => EuclideanSpace.proj i) 0))
  have hιc : ∀ (x : Euclid (m + 1)) (i : Fin (m + 1)), ι₀ x (Fin.castSucc i) = x i := by
    intro x i
    simp [ι₀]
  have hιl : ∀ x : Euclid (m + 1), ι₀ x (Fin.last (m + 1)) = 0 := by
    intro x
    simp [ι₀]
  have hpι : ∀ x, p (ι₀ x) = x := fun x => by
    ext i
    rw [hp, hιc]
  -- `ι₀` is a linear isometric embedding, hence proper, and `p` is `1`-Lipschitz
  have hιiso : Isometry ι₀ := by
    refine AddMonoidHomClass.isometry_of_norm ι₀ fun x => ?_
    rw [EuclideanSpace.norm_eq (ι₀ x), EuclideanSpace.norm_eq x,
      Fin.sum_univ_castSucc (fun j => ‖(ι₀ x).ofLp j‖ ^ 2)]
    simp [hιc, hιl]
  have hιprop : IsProperMap (fun x => (0 : Euclid (m + 1 + 1)) + ι₀ x) := by
    simpa only [zero_add] using hιiso.isClosedEmbedding.isProperMap
  have hpL : LipschitzWith 1 p := by
    refine LipschitzWith.of_dist_le_mul fun y y' => ?_
    rw [dist_eq_norm, dist_eq_norm, ← map_sub, NNReal.coe_one, one_mul,
      EuclideanSpace.norm_eq (p (y - y')), EuclideanSpace.norm_eq (y - y')]
    refine Real.sqrt_le_sqrt ?_
    rw [Fin.sum_univ_castSucc (fun j => ‖(y - y').ofLp j‖ ^ 2)]
    simp only [hp]
    exact le_add_of_nonneg_right (by positivity)
  -- `(m + 2)`-covectors on the `(m + 1)`-dimensional `ℝ^P` vanish
  have hcov0 : ∀ α : Covector (Euclid (m + 1)) (m + 1 + 1), α = 0 := by
    intro α
    ext v
    refine α.toAlternatingMap.map_linearDependent v fun hli => ?_
    have := hli.fintype_card_le_finrank
    simp at this
  -- Steps 1–2: `T̃ = ι₀#T` and `∂T̃ = ι₀#∂T` are IM, `M(T̃) = M(T)` and `M(∂T̃) = M(∂T)`
  obtain ⟨hTtIM, hTtmass⟩ := Submission.dor_lmb_fc_dtop_isometric_pushforward_im (m + 1)
    (m + 1 + 1) (m + 1) ι₀ hιprop T hιiso hT
  obtain ⟨hbTtIM, hbTtmass⟩ := Submission.dor_lmb_fc_dtop_isometric_pushforward_im (m + 1)
    (m + 1 + 1) m ι₀ hιprop T.boundary hιiso hbT
  have hbTt : (GeometricCurrentOn.affinePushforward (V := (univ : Set (Euclid (m + 1 + 1))))
      ι₀ 0 hιprop T).boundary = GeometricCurrentOn.affinePushforward
        (V := (univ : Set (Euclid (m + 1 + 1)))) ι₀ 0 hιprop T.boundary :=
    GeometricCurrentOn.boundary_affinePushforward (V := (univ : Set (Euclid (m + 1 + 1))))
      ι₀ 0 hιprop T
  set Tt := GeometricCurrentOn.affinePushforward (V := (univ : Set (Euclid (m + 1 + 1))))
    ι₀ 0 hιprop T
  -- `T̃` vanishes off the compact set `ι₀(K)`: `tsupport(ι₀^#η) ⊆ ι₀⁻¹(tsupport η)`
  have hTtK : ∀ η : TestFormOn (univ : Set (Euclid (m + 1 + 1))) (m + 1),
      Disjoint (tsupport (η : DifferentialForm (Euclid (m + 1 + 1)) (m + 1))) (ι₀ '' K) →
        Tt η = 0 := by
    intro η hη
    refine hTK (affinePullbackTestOn ι₀ 0 hιprop univ (m + 1) η)
      (Set.disjoint_left.2 fun x hx hxK => ?_)
    have hx' := tsupport_affinePullbackForm_subset ι₀ 0
      (η : DifferentialForm (Euclid (m + 1 + 1)) (m + 1)) hx
    simp only [mem_preimage, zero_add] at hx'
    exact Set.disjoint_left.1 hη hx' (mem_image_of_mem ι₀ hxK)
  -- Step 3: the deformation `T̃ − Π̃ = ∂R̃ + S̃` in `ℝ^{P+1}`, with `K' = ι₀(K)`
  have hK' : IsCompact (ι₀ '' K) := hK.image ι₀.continuous
  obtain ⟨st, βt, Pct, Rt, St, hst, hPct, -, -, hdecomp, hβt, -, hStmass, hcells, hRtvan,
    hStvan⟩ := hdef ρ (ι₀ '' K) Tt hρ hK' hTtIM (by rw [hbTt]; exact hbTtIM) hTtK
  have hrad : 2 * Real.sqrt ((m + 1 + 1 : ℕ) : ℝ) * ρ =
      2 * Real.sqrt (((m + 1 : ℕ) : ℝ) + 1) * ρ := by
    rw [Nat.cast_succ (m + 1)]
  rw [hrad] at hcells hRtvan hStvan
  set r := 2 * Real.sqrt (((m + 1 : ℕ) : ℝ) + 1) * ρ
  have hKt : IsCompact (cthickening r (ι₀ '' K)) := hK'.cthickening
  -- `p(K̃) ⊆ cthickening(r, K)` for `K̃ = cthickening(r, ι₀(K))`, by `p ∘ ι₀ = id` and `Lip p ≤ 1`
  have hpK : ∀ y ∈ cthickening r (ι₀ '' K), p y ∈ cthickening r K := by
    intro y hy
    rw [mem_cthickening_iff] at hy ⊢
    refine le_trans (le_infEDist.2 fun z hz => ?_) hy
    obtain ⟨x, hx, rfl⟩ := hz
    calc infEDist (p y) K ≤ edist (p y) x := infEDist_le_edist_of_mem hx
      _ = edist (p y) (p (ι₀ x)) := by rw [hpι]
      _ ≤ edist y (ι₀ x) := by simpa using hpL.edist_le_mul y (ι₀ x)
  -- Step 4: the cut-off pull-back `ω ↦ ω̃ = ζ · p^#ω`, equal to `p^#ω` on an open `V ⊇ K̃`
  obtain ⟨V, E, hVo, hKtV, hEeq, hdEeq, hEsupp, hEnorm, hEcont⟩ :=
    Submission.dor_lmb_fc_dtop_cutoff_pullback (m + 1) (m + 1) p hp _ hKt
  have hKι : K ⊆ ι₀ ⁻¹' V := fun x hx =>
    hKtV (self_subset_cthickening _ (mem_image_of_mem ι₀ hx))
  -- 5(d): `S(ω) := S̃(ω̃)` is a current in `ℝ^P`, `ω ↦ ω̃` being sequentially continuous
  let S : GeometricCurrentOn (univ : Set (Euclid (m + 1))) (m + 1) :=
    { toCurrent := St.toCurrent.comp E
      continuous' := fun ωs h => St.continuous' (fun j => E (ωs j)) (hEcont ωs h) }
  -- 5(a): `T̃(ω̃) = T(ι₀^# ω̃) = T(ω)`, since `ι₀^# ω̃ = ω` on the open `ι₀⁻¹(V) ⊇ K`
  have h5a : ∀ ω : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1), Tt (E ω) = T ω := by
    intro ω
    let X : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1) :=
      affinePullbackTestOn ι₀ 0 hιprop univ (m + 1) (E ω)
    have hX : ∀ x, ι₀ x ∈ V → affinePullbackForm ι₀ 0
        (E ω : DifferentialForm (Euclid (m + 1 + 1)) (m + 1)) x =
          (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) x := by
      intro x hx
      simp only [affinePullbackForm, zero_add]
      rw [hEeq ω (ι₀ x) hx]
      ext v
      have hv : ⇑p ∘ ⇑ι₀ ∘ v = v := funext fun k => hpι (v k)
      simp only [ContinuousAlternatingMap.compContinuousLinearMap_apply, hpι, hv]
    -- `ω − ι₀^# ω̃` vanishes on `ι₀⁻¹(V) ⊇ K`, so `T` kills it
    have hsub : tsupport ((ω - X : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1)) :
        DifferentialForm (Euclid (m + 1)) (m + 1)) ⊆ (ι₀ ⁻¹' V)ᶜ := by
      refine closure_minimal (fun x hx hxV => hx ?_)
        (hVo.preimage ι₀.continuous).isClosed_compl
      show (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) x - affinePullbackForm ι₀ 0
        (E ω : DifferentialForm (Euclid (m + 1 + 1)) (m + 1)) x = 0
      rw [hX x hxV, sub_self]
    have hvan := hTK (ω - X) (Disjoint.mono_left hsub (disjoint_compl_left_iff_subset.2 hKι))
    have hlin : T (ω - X) = T ω - T X := T.toCurrent.map_sub ω X
    rw [hlin, sub_eq_zero] at hvan
    exact hvan.symm
  -- 5(b): `∂R̃(ω̃) = R̃(dω̃) = 0`, as `dω̃ = p^#(dω) = 0` on `V ⊇ K̃`
  have h5b : ∀ ω : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1),
      Rt.boundary (E ω) = 0 := by
    intro ω
    have hsub : tsupport (exteriorDerivative
        (E ω : DifferentialForm (Euclid (m + 1 + 1)) (m + 1))) ⊆ Vᶜ := by
      refine closure_minimal (fun y hy hyV => hy ?_) hVo.isClosed_compl
      rw [hdEeq ω y hyV,
        hcov0 (exteriorDerivative (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) (p y))]
      ext v
      simp
    exact hRtvan (exteriorDerivativeTestOn univ (m + 1) (E ω))
      (Disjoint.mono_left hsub (disjoint_compl_left_iff_subset.2 hKtV))
  -- 5(c): the cells `F̃_q` of `Π̃`, the grid cubes `G_z` of `ℝ^P`, and the horizontal cells `H`
  let F : (Fin (m + 1 + 1) → ℤ) × (Fin (m + 1) → Fin (m + 1 + 1)) → Set (Euclid (m + 1 + 1)) :=
    fun q => {y | ∀ i : Fin (m + 1 + 1), (i ∈ Set.range q.2 → ρ * q.1 i ≤ y i ∧
      y i ≤ ρ * (q.1 i + 1)) ∧ (i ∉ Set.range q.2 → y i = ρ * q.1 i)}
  have hFmeas : ∀ q, MeasurableSet (F q) := by
    intro q
    refine IsClosed.measurableSet ?_
    show IsClosed {y : Euclid (m + 1 + 1) | ∀ i : Fin (m + 1 + 1), _}
    rw [Set.ofPred_forall]
    refine isClosed_iInter fun i => ?_
    by_cases hi : i ∈ Set.range q.2
    · simp only [hi, true_implies, not_true_eq_false, false_implies, and_true, Set.ofPred_and]
      exact (isClosed_le continuous_const (PiLp.continuous_apply 2 (fun _ => ℝ) i)).inter
        (isClosed_le (PiLp.continuous_apply 2 (fun _ => ℝ) i) continuous_const)
    · simp only [hi, false_implies, not_false_eq_true, true_implies, true_and]
      exact isClosed_eq (PiLp.continuous_apply 2 (fun _ => ℝ) i) continuous_const
  let g : (Fin (m + 1 + 1) → ℤ) × (Fin (m + 1) → Fin (m + 1 + 1)) → (Fin (m + 1) → ℤ) :=
    fun q i => q.1 (Fin.castSucc i)
  let I : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1) → (Fin (m + 1) → ℤ) → ℝ :=
    fun ω z => ∫ x in {x : Euclid (m + 1) | ∀ i : Fin (m + 1), ρ * z i ≤ x i ∧
      x i ≤ ρ * (z i + 1)}, (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) x
        (fun k => EuclideanSpace.single k (1 : ℝ)) ∂μHE[m + 1]
  set H := st.filter fun q => Fin.last (m + 1) ∉ Set.range q.2 with hH
  set s' := H.image g
  set β' : (Fin (m + 1) → ℤ) → ℤ := fun z => ∑ q ∈ H with g q = z, βt q with hβ'
  -- on a cell `ω̃ = p^#ω`; a vertical cell gives `0`, a horizontal one the cube `G_{g q}`
  have hcell : ∀ (ω : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1))
      (q : (Fin (m + 1 + 1) → ℤ) × (Fin (m + 1) → Fin (m + 1 + 1))), q ∈ st →
      ∫ y in F q, (E ω : DifferentialForm (Euclid (m + 1 + 1)) (m + 1)) y
        (fun k => EuclideanSpace.single (q.2 k) (1 : ℝ)) ∂μHE[m + 1] =
        if Fin.last (m + 1) ∈ Set.range q.2 then 0 else I ω (g q) := by
    intro ω q hq
    obtain ⟨hvert, hhor⟩ := Submission.dor_lmb_fc_dtop_projected_cell_integral (m + 1) ρ p
      q.1 q.2 hp (hst q hq)
    have hEq : ∫ y in F q, (E ω : DifferentialForm (Euclid (m + 1 + 1)) (m + 1)) y
        (fun k => EuclideanSpace.single (q.2 k) (1 : ℝ)) ∂μHE[m + 1] =
        ∫ y in F q, (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) (p y)
          (fun k => p (EuclideanSpace.single (q.2 k) (1 : ℝ))) ∂μHE[m + 1] := by
      refine setIntegral_congr_fun (hFmeas q) fun y hy => ?_
      show (E ω : DifferentialForm (Euclid (m + 1 + 1)) (m + 1)) y
          (fun k => EuclideanSpace.single (q.2 k) (1 : ℝ)) =
        (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) (p y)
          (fun k => p (EuclideanSpace.single (q.2 k) (1 : ℝ)))
      rw [hEeq ω y (hKtV (hcells q hq hy)),
        ContinuousAlternatingMap.compContinuousLinearMap_apply]
      rfl
    rw [hEq]
    split_ifs with hlast
    · exact hvert hlast _
    · exact (hhor hlast).1 _
  -- `Π̃(ω̃) = Σ_{z ∈ s'} β'_z ∫_{G_z} ω(e₀, …, e_{P-1}) dHᴾ`, regrouping horizontal cells by `g`
  have hPcE : ∀ ω : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1),
      Pct (E ω) = ∑ z ∈ s', (β' z : ℝ) * I ω z := by
    intro ω
    rw [hPct (E ω)]
    calc _ = ∑ q ∈ st, (βt q : ℝ) *
          (if Fin.last (m + 1) ∈ Set.range q.2 then 0 else I ω (g q)) := by
          refine Finset.sum_congr rfl fun q hq => ?_
          congr 1
          exact hcell ω q hq
      _ = ∑ q ∈ H, (βt q : ℝ) * I ω (g q) := by
          rw [hH, Finset.sum_filter]
          refine Finset.sum_congr rfl fun q _ => ?_
          by_cases h : Fin.last (m + 1) ∈ Set.range q.2 <;> simp [h]
      _ = ∑ z ∈ s', ∑ q ∈ H with g q = z, (βt q : ℝ) * I ω (g q) :=
          (Finset.sum_fiberwise_of_maps_to (fun q hq => Finset.mem_image_of_mem g hq) _).symm
      _ = ∑ z ∈ s', (β' z : ℝ) * I ω z := by
          refine Finset.sum_congr rfl fun z _ => ?_
          calc ∑ q ∈ H with g q = z, (βt q : ℝ) * I ω (g q)
              = ∑ q ∈ H with g q = z, (βt q : ℝ) * I ω z :=
                Finset.sum_congr rfl fun q hq => by rw [(Finset.mem_filter.1 hq).2]
            _ = (β' z : ℝ) * I ω z := by
                rw [← Finset.sum_mul]
                simp only [hβ', Int.cast_sum]
  -- Step 6: `Π := T − S` is the cube chain (by 5(a)–(c) and step 3), and `R := 0`
  have hPc : ∀ ω : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1),
      (T - S) ω = ∑ z ∈ s', (β' z : ℝ) * I ω z := by
    intro ω
    have h := hdecomp (E ω)
    rw [h5a ω, h5b ω, zero_add] at h
    rw [← hPcE ω]
    show T ω - St (E ω) = Pct (E ω)
    linarith
  -- Step 7: `Π` is IM (an integer cube chain), hence so is `S = T − Π`; `R = 0` is IM
  have hPcIM : IsIntegerMultiplicity (T - S) :=
    Submission.dor_lmb_fc_dtop_cube_chain_im m ρ s' β' (T - S) hρ hPc
  have hSIM : IsIntegerMultiplicity S := by
    have hSeq : S = T - (T - S) := GeometricCurrentOn.ext fun ω => by
      show S ω = T ω - (T ω - S ω)
      ring
    rw [hSeq]
    exact (Submission.cmc_imRep_locality_restrict_sub).2.2.1 (m + 1) (m + 1) univ T (T - S)
      isOpen_univ hT hPcIM
  have hR0IM :
      IsIntegerMultiplicity (0 : GeometricCurrentOn (univ : Set (Euclid (m + 1))) (m + 2)) := by
    refine ⟨{ carrier := ∅
              mult := fun _ => 0
              orient := fun _ => 0
              measurableSet_carrier := MeasurableSet.empty
              carrier_subset := empty_subset _
              rectifiable :=
                Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty
              measurable_mult := measurable_const
              mult_pos := fun x hx => by simp at hx
              locallyIntegrable_mult := fun K _ _ => by simp
              aestronglyMeasurable_orient := aestronglyMeasurable_const
              orients := by simp }, fun ω => ?_⟩
    simp [IMRep.action]
  -- the cells `(z, id)` of `ℝ^P` for `z ∈ s'`, with coefficients `β'_z`
  set s := s'.image fun z => (z, (id : Fin (m + 1) → Fin (m + 1))) with hs
  set β : (Fin (m + 1) → ℤ) × (Fin (m + 1) → Fin (m + 1)) → ℤ := fun q => β' q.1
  have hinj : Set.InjOn (fun z : Fin (m + 1) → ℤ => (z, (id : Fin (m + 1) → Fin (m + 1))))
      ↑s' := fun z _ z' _ h => congrArg Prod.fst h
  -- Step 8: `Σ|β| ≤ Σ|β̃|`, and `M(S) ≤ M(S̃)` as `|ω̃(y)| ≤ |ω(py)|`
  have hsum : ∑ q ∈ s, ((β q).natAbs : ℝ≥0∞) ≤ ∑ q ∈ st, ((βt q).natAbs : ℝ≥0∞) := by
    rw [hs, Finset.sum_image hinj]
    calc ∑ z ∈ s', ((β (z, id)).natAbs : ℝ≥0∞)
        ≤ ∑ z ∈ s', ∑ q ∈ H with g q = z, ((βt q).natAbs : ℝ≥0∞) := by
          refine Finset.sum_le_sum fun z _ => ?_
          have h1 : (β (z, id)).natAbs ≤ ∑ q ∈ H with g q = z, (βt q).natAbs :=
            Int.natAbs_sum_le _ _
          exact_mod_cast h1
      _ = ∑ q ∈ H, ((βt q).natAbs : ℝ≥0∞) :=
          Finset.sum_fiberwise_of_maps_to (fun q hq => Finset.mem_image_of_mem g hq) _
      _ ≤ ∑ q ∈ st, ((βt q).natAbs : ℝ≥0∞) :=
          Finset.sum_le_sum_of_subset (Finset.filter_subset _ _)
  have hSmass : S.mass ≤ St.mass := by
    refine sSup_le ?_
    rintro _ ⟨ω, hω, rfl⟩
    exact St.le_massOn ⟨subset_univ _, fun y => (hEnorm ω y).trans (hω.2 (p y))⟩
  -- Step 9: `G_z = p(F̃_q) ⊆ p(K̃) ⊆ cthickening(r, K)`, and `S` vanishes off `cthickening(r, K)`
  have hcellsub : ∀ q ∈ s, {x : Euclid (m + 1) | ∀ i : Fin (m + 1), (i ∈ Set.range q.2 →
      ρ * q.1 i ≤ x i ∧ x i ≤ ρ * (q.1 i + 1)) ∧ (i ∉ Set.range q.2 → x i = ρ * q.1 i)} ⊆
        cthickening r K := by
    intro q hq x hx
    obtain ⟨z, hz, rfl⟩ := Finset.mem_image.1 hq
    obtain ⟨q', hq', rfl⟩ := Finset.mem_image.1 hz
    obtain ⟨hq'st, hq'h⟩ := Finset.mem_filter.1 hq'
    obtain ⟨-, hhor⟩ := Submission.dor_lmb_fc_dtop_projected_cell_integral (m + 1) ρ p
      q'.1 q'.2 hp (hst q' hq'st)
    obtain ⟨y, hy, rfl⟩ := (hhor hq'h).2 x fun i => (hx i).1 (by simp)
    exact hpK y (hcells q' hq'st hy)
  have hSvan : ∀ ω : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1),
      Disjoint (tsupport (ω : DifferentialForm (Euclid (m + 1)) (m + 1))) (cthickening r K) →
        S ω = 0 := fun ω hω => hStvan (E ω) (Set.disjoint_left.2 fun y hy hyK =>
          Set.disjoint_left.1 hω (hEsupp ω hy) (hpK y hyK))
  refine ⟨s, β, T - S, 0, S, ?_, fun ω => ?_, hR0IM, hSIM, fun ω => ?_, ?_, ?_, ?_, hcellsub,
    fun ω _ => rfl, hSvan⟩
  · intro q hq
    obtain ⟨z, -, rfl⟩ := Finset.mem_image.1 hq
    exact strictMono_id
  · -- the cell formula: `F_{(z, id)} = G_z`
    rw [hPc ω, hs, Finset.sum_image hinj]
    refine Finset.sum_congr rfl fun z _ => ?_
    have hset : {x : Euclid (m + 1) | ∀ i : Fin (m + 1),
        (i ∈ Set.range (id : Fin (m + 1) → Fin (m + 1)) → ρ * z i ≤ x i ∧
          x i ≤ ρ * (z i + 1)) ∧ (i ∉ Set.range (id : Fin (m + 1) → Fin (m + 1)) →
            x i = ρ * z i)} =
        {x : Euclid (m + 1) | ∀ i : Fin (m + 1), ρ * z i ≤ x i ∧ x i ≤ ρ * (z i + 1)} := by
      ext x
      simp
    show (β' z : ℝ) * I ω z = (β' z : ℝ) * ∫ x in {x : Euclid (m + 1) | ∀ i : Fin (m + 1),
        (i ∈ Set.range (id : Fin (m + 1) → Fin (m + 1)) → ρ * z i ≤ x i ∧
          x i ≤ ρ * (z i + 1)) ∧ (i ∉ Set.range (id : Fin (m + 1) → Fin (m + 1)) →
            x i = ρ * z i)},
        (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) x
          (fun k => EuclideanSpace.single k (1 : ℝ)) ∂μHE[m + 1]
    rw [hset]
  · -- `T − Π = S = ∂0 + S`
    show T ω - (T ω - S ω) =
      (0 : GeometricCurrentOn (univ : Set (Euclid (m + 1))) (m + 2)).boundary ω + S ω
    rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.zero_apply]
    ring
  · calc (∑ q ∈ s, ((β q).natAbs : ℝ≥0∞)) * ENNReal.ofReal (ρ ^ (m + 1))
        ≤ (∑ q ∈ st, ((βt q).natAbs : ℝ≥0∞)) * ENNReal.ofReal (ρ ^ (m + 1)) :=
          mul_le_mul_of_nonneg_right hsum zero_le
      _ ≤ ENNReal.ofReal c₀ * Tt.mass := hβt
      _ = ENNReal.ofReal c₀ * T.mass := by rw [hTtmass]
  · -- `M(R) = M(0) = 0`
    refine le_trans (sSup_le ?_) zero_le
    rintro _ ⟨ω, -, rfl⟩
    simp
  · calc S.mass ≤ St.mass := hSmass
      _ ≤ ENNReal.ofReal (c₀ * ρ) * Tt.boundary.mass := hStmass
      _ = ENNReal.ofReal (c₀ * ρ) * T.boundary.mass := by rw [hbTt, hbTtmass]

/-- **Simon Ch. 6, proof of Theorem 7.2, (1)–(3)** (total boundedness): given `Λ < ∞` and
`ε > 0` there is a finite set `𝒬` of `(m+1)`-currents in `U` such that every integer multiplicity
`A ∈ 𝒟_{m+1}(U)` with `∂A` integer multiplicity, vanishing off the compact `K ⊆ U`, with
`M(A), M(∂A) ≤ Λ`, satisfies `A − Q = ∂R + S` for some `Q ∈ 𝒬` and integer multiplicity `R`, `S`
with `M(R) + M(S) < ε`.  If `m + 1 > P` every current of degree `m + 1` is `0` and `𝒬 = {0}`.
Otherwise extend `A` by zero to `Y ∈ 𝒟_{m+1}(ℝᴾ)`, apply the deformation theorem (`m + 1 < P`, or
its top-dimensional case `m + 1 = P`) to `Y` with a grid size `ρ` such that `2cρΛ < ε`, and
restrict back to `U`: the polyhedral part is an integer chain on the finitely many grid cells in
`cthickening (rρ) K` with coefficients at most `cΛ/ρ^{m+1}`, and restriction to `U` keeps
integer multiplicity without increasing mass. -/
theorem Submission.dor_lmb_fc_total_bounded : ((∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (n + 1)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → RT.Represents T → RB.Represents T.boundary → LipschitzWith L f → ∃ Ps : ℝ → GeometricCurrentOn U n, (∀ W : Set (Euclid P), IsOpen W → AEMeasurable (fun t => (Ps t).massOn W) ∧ ∫⁻ t, (Ps t).massOn W ≤ (L : ℝ≥0∞) * T.massOn W) ∧ ∀ᵐ t, IsIntegerMultiplicity (Ps t) ∧ (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (f ⁻¹' {t}) → Ps t ω = 0) ∧ ∀ ω : TestFormOn U n, Ps t ω = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → ∀ (P m : ℕ) (U K : Set (Euclid P)) (Λ ε : ℝ≥0∞), IsOpen U → IsCompact K → K ⊆ U → Λ ≠ ∞ → 0 < ε → ∃ 𝒬 : Set (GeometricCurrentOn U (m + 1)), 𝒬.Finite ∧ ∀ A : GeometricCurrentOn U (m + 1), IsIntegerMultiplicity A → IsIntegerMultiplicity A.boundary → (∀ ω : TestFormOn U (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) K → A ω = 0) → A.mass ≤ Λ → A.boundary.mass ≤ Λ → ∃ Q ∈ 𝒬, ∃ (R : GeometricCurrentOn U (m + 2)) (S : GeometricCurrentOn U (m + 1)), IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ (∀ ω : TestFormOn U (m + 1), A ω - Q ω = R.boundary ω + S ω) ∧ R.mass + S.mass < ε := by
  intro hSL P m U K Λ ε hU hK hKU hΛ hε
  -- restriction from `ℝᴾ` to `U` does not increase mass: a form admissible in `U` is admissible
  -- in `ℝᴾ`, with the same value
  have hres : ∀ (d : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) d),
      (X.restrictDomain (subset_univ U)).mass ≤ X.mass := by
    intro d X
    apply sSup_le
    rintro _ ⟨ω, hω, rfl⟩
    exact X.le_massOn (W := univ) (omega := testFormOnInclusion (subset_univ U) d ω)
      ⟨subset_univ _, hω.2⟩
  -- the zero current has mass `0`
  have hzero : ∀ d : ℕ, (0 : GeometricCurrentOn U d).mass = 0 := by
    intro d
    refine le_antisymm (sSup_le ?_) zero_le
    rintro _ ⟨ω, -, rfl⟩
    simp
  -- Step 0: for `m + 1 > P` every current of degree `m + 1` is `0`, and `𝒬 = {0}` works
  by_cases hdeg : P < m + 1
  · refine ⟨{0}, finite_singleton 0, fun A _ _ _ _ _ => ⟨0, mem_singleton 0, 0, 0,
      Submission.dor_lmb_fc_tb_zero_isIntegerMultiplicity P (m + 2) U,
      Submission.dor_lmb_fc_tb_zero_isIntegerMultiplicity P (m + 1) U, fun ω => ?_, ?_⟩⟩
    · rw [Submission.dor_lmb_fc_tb_eq_zero_of_lt_degree P (m + 1) U A hdeg]
      simp
    · simpa [hzero] using hε
  -- the deformation theorem in degree `m + 1 ≤ P` (`m + 1 < P`, or `m + 1 = P`), with constant
  -- `c`, the cells lying within distance `r ρ` of `K`
  obtain ⟨c, r, hc, hdef⟩ : ∃ c r : ℝ, 0 ≤ c ∧ ∀ (ρ : ℝ) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 0 < ρ → IsIntegerMultiplicity T → IsIntegerMultiplicity T.boundary → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) K → T ω = 0) → ∃ (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (β : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℤ) (Pc : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Pc ω = ∑ p ∈ s, (β p : ℝ) * ∫ x in {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧ (i ∉ Set.range p.2 → x i = ρ * p.1 i)}, (ω : DifferentialForm (Euclid P) (m + 1)) x (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) ∂μHE[m + 1]) ∧ IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), T ω - Pc ω = R.boundary ω + S ω) ∧ (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞)) * ENNReal.ofReal (ρ ^ (m + 1)) ≤ ENNReal.ofReal c * T.mass ∧ R.mass ≤ ENNReal.ofReal (c * ρ) * T.mass ∧ S.mass ≤ ENNReal.ofReal (c * ρ) * T.boundary.mass ∧ ∀ p ∈ s, {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧ (i ∉ Set.range p.2 → x i = ρ * p.1 i)} ⊆ cthickening (r * ρ) K := by
    rcases (not_lt.mp hdeg).lt_or_eq with hlt | heq
    · obtain ⟨c, hc, hD⟩ := Submission.dor_lmb_fc_deformation hSL P m hlt
      refine ⟨c, 2 * Real.sqrt P, hc, fun ρ T hρ hT hbT hTK => ?_⟩
      obtain ⟨s, β, Pc, R, S, -, hPc, hR, hS, hid, hβ, hRm, hSm, hcell, -, -⟩ :=
        hD ρ K T hρ hK hT hbT hTK
      exact ⟨s, β, Pc, R, S, hPc, hR, hS, hid, hβ, hRm, hSm, hcell⟩
    · obtain ⟨c, hc, hD⟩ := Submission.dor_lmb_fc_deformation_top hSL P m heq
      refine ⟨c, 2 * Real.sqrt (P + 1), hc, fun ρ T hρ hT hbT hTK => ?_⟩
      obtain ⟨s, β, Pc, R, S, -, hPc, hR, hS, hid, hβ, hRm, hSm, hcell, -, -⟩ :=
        hD ρ K T hρ hK hT hbT hTK
      exact ⟨s, β, Pc, R, S, hPc, hR, hS, hid, hβ, hRm, hSm, hcell⟩
  -- Step 1: a grid size `ρ > 0` with `2 c ρ Λ < δ`, where `0 < δ < ε`
  obtain ⟨δ, -, hδ0, hδε⟩ := ENNReal.lt_iff_exists_real_btwn.mp hε
  have hδ : 0 < δ := ENNReal.ofReal_pos.mp hδ0
  have hΛr : 0 ≤ Λ.toReal := ENNReal.toReal_nonneg
  have hcΛ : 0 ≤ c * Λ.toReal := mul_nonneg hc hΛr
  obtain ⟨ρ, hρ, hρδ⟩ := exists_pos_mul_lt hδ (2 * c * Λ.toReal)
  have hsmall : 2 * (c * ρ * Λ.toReal) < δ :=
    calc 2 * (c * ρ * Λ.toReal) = 2 * c * Λ.toReal * ρ := by ring
      _ < δ := hρδ
  -- Step 2: `𝒬` is the finite set of integer chains on the grid cells in `cthickening (r ρ) K`
  -- with coefficients at most `c Λ / ρ^{m+1}`
  refine ⟨_, Submission.dor_lmb_fc_tb_cell_chains_finite P m U (cthickening (r * ρ) K) ρ
    ⌊c * Λ.toReal / ρ ^ (m + 1)⌋₊ hρ hK.cthickening, ?_⟩
  intro A hA hbA hAK hAm hbAm
  -- Step 3: extension of `A` by zero to `Y ∈ 𝒟_{m+1}(ℝᴾ)` with `∂Y` integer multiplicity
  obtain ⟨Y, hY, hbY, hYA, hYK, hYm, hbYm⟩ :=
    Submission.dor_lmb_fc_tb_extend_univ_boundary P m U K A hU hK hKU hA hbA hAK
  have hYΛ : Y.mass ≤ Λ := hYm.trans hAm
  have hbYΛ : Y.boundary.mass ≤ Λ := hbYm.trans hbAm
  -- Step 4: deformation of `Y`: `Y − Π = ∂R̂ + Ŝ`
  obtain ⟨s, β, Pc, R, S, hPc, hR, hS, hid, hβ, hRm, hSm, hcell⟩ := hdef ρ Y hρ hY hbY hYK
  -- Step 5: restriction to `U`: `Q = Π⌞U`, `R = R̂⌞U` and `S = Ŝ⌞U`
  refine ⟨Pc.restrictDomain (subset_univ U), ⟨s, β, hcell, fun p hp => ?_, fun ω => ?_⟩,
    R.restrictDomain (subset_univ U), S.restrictDomain (subset_univ U),
    Submission.dtc_restrictDomain_isIntegerMultiplicity P (m + 2) univ U (subset_univ U) R hU hR,
    Submission.dtc_restrictDomain_isIntegerMultiplicity P (m + 1) univ U (subset_univ U) S hU hS,
    fun ω => ?_, ?_⟩
  · -- `|β_p| ρ^{m+1} ≤ (Σ_q |β_q|) ρ^{m+1} ≤ c M(Y) ≤ c Λ`
    have h1 : ((β p).natAbs : ℝ≥0∞) * ENNReal.ofReal (ρ ^ (m + 1)) ≤
        ENNReal.ofReal (c * Λ.toReal) :=
      calc ((β p).natAbs : ℝ≥0∞) * ENNReal.ofReal (ρ ^ (m + 1))
          ≤ (∑ q ∈ s, ((β q).natAbs : ℝ≥0∞)) * ENNReal.ofReal (ρ ^ (m + 1)) := by
            gcongr
            exact Finset.single_le_sum (f := fun q => ((β q).natAbs : ℝ≥0∞))
              (fun _ _ => zero_le) hp
        _ ≤ ENNReal.ofReal c * Y.mass := hβ
        _ ≤ ENNReal.ofReal c * Λ := by gcongr
        _ = ENNReal.ofReal (c * Λ.toReal) := by
            rw [ENNReal.ofReal_mul hc, ENNReal.ofReal_toReal hΛ]
    have h2 : ((β p).natAbs : ℝ) * ρ ^ (m + 1) ≤ c * Λ.toReal := by
      rw [← ENNReal.ofReal_le_ofReal_iff hcΛ, ENNReal.ofReal_mul (Nat.cast_nonneg _),
        ENNReal.ofReal_natCast]
      exact h1
    exact Nat.le_floor ((le_div_iff₀ (pow_pos hρ _)).mpr h2)
  · -- `Q(ω) = Π(ιω)`, and `ιω` has the same underlying form as `ω`
    exact hPc (testFormOnInclusion (subset_univ U) (m + 1) ω)
  · -- `A(ω) − Q(ω) = Y(ιω) − Π(ιω) = ∂R̂(ιω) + Ŝ(ιω)`, where `d(ιω) = ι(dω)`
    rw [← hYA]
    exact hid (testFormOnInclusion (subset_univ U) (m + 1) ω)
  · -- `M(R) + M(S) ≤ M(R̂) + M(Ŝ) ≤ 2 c ρ Λ < ε`
    have hcρ : 0 ≤ c * ρ := mul_nonneg hc hρ.le
    calc (R.restrictDomain (subset_univ U)).mass + (S.restrictDomain (subset_univ U)).mass
        ≤ ENNReal.ofReal (c * ρ) * Λ + ENNReal.ofReal (c * ρ) * Λ := by
          gcongr
          · exact (hres _ R).trans (hRm.trans (by gcongr))
          · exact (hres _ S).trans (hSm.trans (by gcongr))
      _ = ENNReal.ofReal (2 * (c * ρ * Λ.toReal)) := by
          rw [two_mul, ENNReal.ofReal_add (mul_nonneg hcρ hΛr) (mul_nonneg hcρ hΛr),
            ENNReal.ofReal_mul hcρ, ENNReal.ofReal_toReal hΛ]
      _ ≤ ENNReal.ofReal δ := ENNReal.ofReal_le_ofReal hsmall.le
      _ < ε := hδε

/-- **Simon Ch. 6, Theorem 7.2, "only if" part, for cycles** (chapter-06.txt lines 2020–2135):
assume (C1) (`dor_imrep_massOn_eq_measure_and_support`).  Let `n ≥ 1`, `U ⊆ ℝ^P` open, and let
`T_j, T ∈ 𝒟ₙ(U)` be integer multiplicity with `∂T_j = 0`, `∂T = 0`, `T_j ⇀ T` in `U` and
`sup_j M_V(T_j) < ∞` for every open `V ⊂⊂ U`.  Then for every open `W ⊂⊂ U` there are integer
multiplicity `R_j ∈ 𝒟ₙ₊₁(U)`, `S_j ∈ 𝒟ₙ(U)` with `T − T_j = ∂R_j + S_j` in `U` and
`M_W(R_j) + M_W(S_j) → 0`, i.e. `d_W(T_j, T) → 0`.

Step 0: if `W = ∅` then `M_∅ ≡ 0`, and `R_j = 0`, `S_j = T − T_j` work.  Otherwise put
`d_W(T, T_j) = inf {M_W(R) + M_W(S) : T − T_j = ∂R + S, R, S integer multiplicity}` (Simon 7.1).
Pairs with cost `≤ d_W(T, T_j) + 2⁻ʲ` prove the theorem once `d_W(T, T_j) → 0`, and for this it
suffices that every subsequence `T_{ns(j)}` has a further subsequence along which
`d_W(T, ·) → 0`.
Step 1 (`dor_lmb_fc_localize`, with the slicing theorem `dor_lmb_slicing_lipschitz`): a
subsequence `T_{ns(φ(j))}` and integer multiplicity `T'_j ⇀ T'` (the restrictions to a good
sublevel set of `dist(·, W̄)`) that agree with `T_{ns(φ(j))}`, `T` on forms supported in `W`,
vanish off a compact `K ⊆ U`, and have `M(T'_j), M(∂T'_j) ≤ Λ < ∞`.
Steps 2–3 (`dor_lmb_fc_total_bounded`, `dor_lmb_fc_cauchy_subseq`): the `T'_j` are totally bounded
for the flat distance, so `T'_{θ(r+1)} − T'_{θ(r)} = ∂R_r + S_r` with `M(R_r) + M(S_r) ≤ 2⁻ʳ`.
Step 4 (`dor_lmb_fc_series_limit`): `T' − T'_{θ(ℓ)} = ∂R' + S'` with `M(R') + M(S') ≤ 2·2⁻ˡ`.
Step 5: `T − T_{ns(φ(θ(ℓ)))} = ∂R' + S̃` with
`S̃ = (S' − (T' − T)) − (T_{ns(φ(θ(ℓ)))} − T'_{θ(ℓ)})`, integer multiplicity (differences,
`cmc_imRep_locality_restrict_sub`), and `M_W(S̃) = M_W(S')` because both bracketed differences
vanish on forms supported in `W`.  Hence `d_W(T, T_{ns(φ(θ(ℓ)))}) ≤ 2·2⁻ˡ → 0`. -/
theorem Submission.dor_lmb_flat_convergence_cycles : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P n : ℕ) (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U n) (T : GeometricCurrentOn U n), IsOpen U → 0 < n → (∀ j, IsIntegerMultiplicity (Ts j)) → IsIntegerMultiplicity T → (∀ j, BoundaryVanishes (Ts j)) → BoundaryVanishes T → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, (Ts j).massOn W < ∞) → WeaklyConvergesOn Ts T → ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ∃ (Rs : ℕ → GeometricCurrentOn U (n + 1)) (Ss : ℕ → GeometricCurrentOn U n), (∀ j, IsIntegerMultiplicity (Rs j)) ∧ (∀ j, IsIntegerMultiplicity (Ss j)) ∧ (∀ j (ω : TestFormOn U n), T ω - Ts j ω = (Rs j).boundary ω + Ss j ω) ∧ Tendsto (fun j => (Rs j).massOn W + (Ss j).massOn W) atTop (𝓝 0) := by
  intro _ P n U Ts T hU hn hTsIM hTIM hTsB _ hbd hconv W _ hWU
  -- write `n = m + 1`, so that `∂T_j = 0` reads `(Ts j).boundary = 0`
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, (Nat.succ_pred_eq_of_pos hn).symm⟩
  have hsub_apply : ∀ {k : ℕ} (A B : GeometricCurrentOn U k) (ω : TestFormOn U k),
      (A - B) ω = A ω - B ω := fun _ _ _ => rfl
  -- differences of integer multiplicity currents (`cmc_imRep_locality_restrict_sub` (c))
  have hsub : ∀ {k : ℕ} (A B : GeometricCurrentOn U k), IsIntegerMultiplicity A →
      IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B) :=
    fun A B hA hB => Submission.cmc_imRep_locality_restrict_sub.2.2.1 P _ U A B hU hA hB
  -- `0 = τ(∅, 1, 0)` is integer multiplicity, and `T − T_j = ∂0 + (T − T_j)`
  have hIM0 : IsIntegerMultiplicity (0 : GeometricCurrentOn U (m + 1 + 1)) := by
    refine ⟨{ carrier := ∅
              mult := fun _ => 1
              orient := fun _ => 0
              measurableSet_carrier := MeasurableSet.empty
              carrier_subset := empty_subset U
              rectifiable :=
                Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty
              measurable_mult := measurable_const
              mult_pos := fun _ _ => Nat.one_pos
              locallyIntegrable_mult := fun K _ _ => by simp
              aestronglyMeasurable_orient := aestronglyMeasurable_const
              orients := by simp }, fun ω => ?_⟩
    simp [IMRep.action]
  have htriv : ∀ j (ω : TestFormOn U (m + 1)),
      T ω - Ts j ω = (0 : GeometricCurrentOn U (m + 1 + 1)).boundary ω + (T - Ts j) ω := by
    intro j ω
    rw [hsub_apply, GeometricCurrentOn.boundary_apply, GeometricCurrentOn.zero_apply, zero_add]
  -- Step 0: if `W = ∅`, then `M_∅ ≡ 0`, and `R_j = 0`, `S_j = T − T_j` work
  rcases W.eq_empty_or_nonempty with rfl | hWne
  · have hmass : ∀ {k : ℕ} (A : GeometricCurrentOn U k), A.massOn ∅ = 0 := by
      intro k A
      refine le_antisymm (sSup_le ?_) zero_le
      rintro _ ⟨ω, hω, rfl⟩
      have h0 : ω = 0 := Subtype.ext (funext fun x => by
        by_contra hx
        exact hω.1 (subset_tsupport _ hx))
      simp [h0]
    refine ⟨fun _ => 0, fun j => T - Ts j, fun _ => hIM0, fun j => hsub _ _ hTIM (hTsIM j),
      htriv, ?_⟩
    simp only [hmass, add_zero]
    exact tendsto_const_nhds
  have hWsub : W ⊆ U := subset_closure.trans hWU.2
  -- `M_W` only sees forms supported in `W`
  have hcongr : ∀ {k : ℕ} (A B : GeometricCurrentOn U k), (∀ ω : TestFormOn U k,
      tsupport (ω : DifferentialForm (Euclid P) k) ⊆ W → A ω = B ω) →
      A.massOn W = B.massOn W := by
    intro k A B h
    unfold GeometricCurrentOn.massOn
    congr 1
    exact Set.image_congr fun ω hω => congrArg ENNReal.ofReal (h ω hω.1)
  have hε : Tendsto (fun j : ℕ => (2⁻¹ : ℝ≥0∞) ^ j) atTop (𝓝 0) :=
    ENNReal.tendsto_pow_atTop_nhds_zero_of_lt_one (ENNReal.inv_lt_one.2 ENNReal.one_lt_two)
  -- the flat distance `d_W(T, T_j)` (Simon 7.1)
  obtain ⟨d, hd⟩ : ∃ d : ℕ → ℝ≥0∞, ∀ j, d j = ⨅ (R : GeometricCurrentOn U (m + 1 + 1))
      (S : GeometricCurrentOn U (m + 1)) (_ : IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧
        ∀ ω : TestFormOn U (m + 1), T ω - Ts j ω = R.boundary ω + S ω),
      R.massOn W + S.massOn W := ⟨_, fun _ => rfl⟩
  -- Step 0: once `d_W(T, T_j) → 0`, pairs with cost `≤ d_W(T, T_j) + 2⁻ʲ` prove the theorem
  suffices hd0 : Tendsto d atTop (𝓝 0) by
    have hpair : ∀ j, ∃ (R : GeometricCurrentOn U (m + 1 + 1)) (S : GeometricCurrentOn U (m + 1)),
        (IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧
          ∀ ω : TestFormOn U (m + 1), T ω - Ts j ω = R.boundary ω + S ω) ∧
        R.massOn W + S.massOn W ≤ d j + (2⁻¹ : ℝ≥0∞) ^ j := by
      intro j
      by_cases hdj : d j = ∞
      · exact ⟨0, T - Ts j, ⟨hIM0, hsub _ _ hTIM (hTsIM j), htriv j⟩, by simp [hdj]⟩
      have hlt : d j < d j + (2⁻¹ : ℝ≥0∞) ^ j :=
        ENNReal.lt_add_right hdj (pow_ne_zero j (ENNReal.inv_ne_zero.2 ENNReal.ofNat_ne_top))
      obtain ⟨R, hR⟩ := iInf_lt_iff.1 ((hd j).symm.trans_lt hlt)
      obtain ⟨S, hS⟩ := iInf_lt_iff.1 hR
      obtain ⟨hRS, hcost⟩ := iInf_lt_iff.1 hS
      exact ⟨R, S, hRS, hcost.le⟩
    choose Rs Ss hRS hcost using hpair
    refine ⟨Rs, Ss, fun j => (hRS j).1, fun j => (hRS j).2.1, fun j => (hRS j).2.2, ?_⟩
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds ?_ (fun _ => zero_le)
      hcost
    simpa only [add_zero] using hd0.add hε
  -- Step 0: it suffices that every subsequence has a further subsequence along which
  -- `d_W(T, ·) → 0`
  refine tendsto_of_subseq_tendsto fun ns hns => ?_
  -- Step 1: localization of `T_{ns(j)}` (`dor_lmb_fc_localize`)
  obtain ⟨φ, K, Λ, Ts', T', -, hK, hKU, hΛ, hTs'IM, hTs'BIM, hT'IM, hTs'K, hTs'mass, hTs'conv,
      hTs'W, hT'W⟩ := Submission.dor_lmb_fc_localize Submission.dor_lmb_slicing_lipschitz P m U W
    (fun j => Ts (ns j)) T hU (fun j => hTsIM (ns j)) hTIM (fun j => hTsB (ns j))
    (fun V hV hVU => (iSup_le fun j => le_iSup (fun i => (Ts i).massOn V) (ns j)).trans_lt
      (hbd V hV hVU)) (fun ω => (hconv ω).comp hns) hWne hWU
  -- Steps 2–3: total boundedness (`dor_lmb_fc_total_bounded`) gives a subsequence with
  -- `T'_{θ(r+1)} − T'_{θ(r)} = ∂R_r + S_r`, `M(R_r) + M(S_r) ≤ 2⁻ʳ` (`dor_lmb_fc_cauchy_subseq`)
  obtain ⟨θ, hθ, hcauchy⟩ := Submission.dor_lmb_fc_cauchy_subseq P m U Ts' hU fun ε hε0 => by
    obtain ⟨𝒬, h𝒬, hnet⟩ := Submission.dor_lmb_fc_total_bounded
      Submission.dor_lmb_slicing_lipschitz P m U K Λ ε hU hK hKU hΛ hε0
    exact ⟨𝒬, h𝒬, fun j => hnet (Ts' j) (hTs'IM j) (hTs'BIM j) (hTs'K j) (hTs'mass j).1
      (hTs'mass j).2⟩
  choose Rc Sc hRSc using hcauchy
  -- Step 4: `T' − T'_{θ(ℓ)} = ∂R' + S'` with `M(R') + M(S') ≤ 2·2⁻ˡ` (`dor_lmb_fc_series_limit`)
  have hlim := Submission.dor_lmb_fc_series_limit P m U (fun r => Ts' (θ r)) T' Rc Sc hU
    (fun ω => (hTs'conv ω).comp hθ.tendsto_atTop) hRSc
  refine ⟨fun ℓ => φ (θ ℓ), ?_⟩
  -- Step 5: `d_W(T, T_{ns(φ(θ(ℓ)))}) ≤ 2·2⁻ˡ`
  have hle : ∀ ℓ, d (ns (φ (θ ℓ))) ≤ 2 * (2⁻¹ : ℝ≥0∞) ^ ℓ := by
    intro ℓ
    obtain ⟨R', S', hR', hS', heq, hmass⟩ := hlim ℓ
    -- `S₁ = S̃ = (S' − (T' − T)) − (T_{ns(φ(θ(ℓ)))} − T'_{θ(ℓ)})`
    set S₁ : GeometricCurrentOn U (m + 1) :=
      (S' - (T' - T)) - (Ts (ns (φ (θ ℓ))) - Ts' (θ ℓ)) with hS₁
    have hS₁IM : IsIntegerMultiplicity S₁ :=
      hsub _ _ (hsub _ _ hS' (hsub _ _ hT'IM hTIM)) (hsub _ _ (hTsIM _) (hTs'IM _))
    have hS₁eq : ∀ ω : TestFormOn U (m + 1),
        T ω - Ts (ns (φ (θ ℓ))) ω = R'.boundary ω + S₁ ω := by
      intro ω
      have h := heq ω
      simp only [hS₁, hsub_apply]
      linarith
    -- the bracketed differences vanish on forms supported in `W`
    have hS₁W : S₁.massOn W = S'.massOn W := by
      refine hcongr _ _ fun ω hω => ?_
      have h₁ : T' ω = T ω := hT'W ω hω
      have h₂ : Ts' (θ ℓ) ω = Ts (ns (φ (θ ℓ))) ω := hTs'W (θ ℓ) ω hω
      simp only [hS₁, hsub_apply, h₁, h₂]
      ring
    calc d (ns (φ (θ ℓ))) ≤ R'.massOn W + S₁.massOn W :=
          (hd _).trans_le (iInf_le_of_le R' (iInf_le_of_le S₁
            (iInf_le_of_le ⟨hR', hS₁IM, hS₁eq⟩ le_rfl)))
      _ = R'.massOn W + S'.massOn W := by rw [hS₁W]
      _ ≤ R'.mass + S'.mass := add_le_add (R'.massOn_mono hWsub) (S'.massOn_mono hWsub)
      _ ≤ 2 * (2⁻¹ : ℝ≥0∞) ^ ℓ := hmass
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds ?_ (fun _ => zero_le) hle
  simpa only [mul_zero] using ENNReal.Tendsto.const_mul hε (Or.inr ENNReal.ofNat_ne_top)

/-- **Lemma M: limsup bound for the masses of the `Tⱼ` near `y ∈ N`** (Simon 7.2.4 and Remark
7.2.5(2), as used in the proof of 7.4.3; the proof of 7.2.4, chapter-07.txt lines 176–290, with
the competitor projected into `N`, README erratum 5).  `dor_lmb_c1_retraction` gives `r`, `c_π`
and a `C¹` retraction `π` onto `N` near `y` with `‖Dπ(x)‖ ≤ 1 + c_π|x − y|`; monotonicity (C3) and
C1 give `μ_{Tⱼ}(B_s(y)) ≤ c₂sⁿ` for `0 < s ≤ r₀`.  Put `r₁ = min(r₀/3, r/3, 1/(6c_π + 1))`,
`c = 3c_π` and `c₁ = n·c·2ⁿ·3ⁿ·c₂`.  For `0 < ε < ρ < r₁`, flat convergence on
`W = B_{ρ+ε}(y)` writes `T − Tⱼ = ∂Rⱼ + Sⱼ` with `M_W(Rⱼ) + M_W(Sⱼ) → 0`; the level cut at some
`t ∈ (ρ, ρ + ε)` (chosen for each `j`, so no subsequence is needed) and the comparison with the
projected competitor (`Z = Tⱼ`) give
`M_{B_ρ}(Tⱼ) ≤ (1 + cρ)ⁿ(M_W(T) + M_W(Sⱼ) + (2/ε)M_W(Rⱼ)) + ((1 + cρ)ⁿ − 1)c₂(3ρ)ⁿ`, and
`(1 + a)ⁿ − 1 ≤ n·a·2ⁿ` (`0 ≤ a ≤ 1`) bounds the last term by `c₁ρⁿ⁺¹`.  Let `j → ∞`. -/
theorem Submission.dor_minimizing_limsup_mass_bound : ∀ (n k ℓ : ℕ), ℓ ≤ k → 0 < n → ∀ (U N : Set (Euclid (n + k))) (Ts : ℕ → GeometricCurrentOn U n) (T : GeometricCurrentOn U n) (y : Euclid (n + k)), IsOpen U → IsEmbeddedSubmanifold 2 (n + ℓ) N → (closure N \ N) ∩ U = ∅ → (∀ j, IsMinimizingIn (Ts j) (U ∩ N)) → IsIntegerMultiplicity T → (∀ j, (Ts j).support ⊆ N) → (∀ j, BoundaryVanishes (Ts j)) → BoundaryVanishes T → (∀ j, ∀ R : IMRep U n, R.Represents (Ts j) → R.IsStationaryAlong N) → (∀ W : Set (Euclid (n + k)), IsOpen W → CompactlyContained W U → ⨆ j, (Ts j).massOn W < ∞) → WeaklyConvergesOn Ts T → y ∈ N ∩ U → ∃ r₁ c c₁ : ℝ, 0 < r₁ ∧ 0 ≤ c ∧ 0 ≤ c₁ ∧ ∀ ρ ε : ℝ, 0 < ε → ε < ρ → ρ < r₁ → limsup (fun j => (Ts j).massOn (ball y ρ)) atTop ≤ ENNReal.ofReal ((1 + c * ρ) ^ n) * T.massOn (ball y (ρ + ε)) + ENNReal.ofReal (c₁ * ρ ^ (n + 1)) := by
  intro n k ℓ hℓ hn U N Ts T y hU hN hNcl hmin hT hspt hbd hTbd hstat hmass hconv hy
  have C1 := Submission.dor_imrep_massOn_eq_measure_and_support
  -- Step 1(a): the `C¹` retraction `π` onto `N` near `y`, `‖Dπ(x)‖ ≤ 1 + c_π|x − y|`
  obtain ⟨r, cπ, proj, hr, hcπ, hrU, hproj, hprojN, hprojfix, hprojT, hprojD⟩ :=
    Submission.dor_lmb_c1_retraction (n + k) (n + ℓ) U N y hU hN hNcl hy
  -- Step 1(b): monotonicity at `y` for every representation of every `Tⱼ` (C3)
  obtain ⟨r₀, κ, hr₀, hκ, hr₀U, hmono⟩ :=
    Submission.dor_stationary_mean_curvature_monotonicity n k ℓ hℓ hn U N y hU hN hNcl hy
  choose Rj hRj using fun j => (hmin j).1
  have hcc : ∀ s, closedBall y s ⊆ U → CompactlyContained (ball y s) U := fun s hs =>
    ⟨(isCompact_closedBall y s).of_isClosed_subset isClosed_closure closure_ball_subset_closedBall,
      closure_ball_subset_closedBall.trans hs⟩
  -- Step 1(c): `Λ₀ = supⱼ M_{B_{r₀}(y)}(Tⱼ) < ∞`, hence `μ_{Tⱼ}(B_s(y)) ≤ c₂sⁿ` for `0 < s ≤ r₀`
  obtain ⟨Λ₀, hΛ₀0, hΛ₀⟩ : ∃ Λ₀ : ℝ, 0 ≤ Λ₀ ∧
      ∀ j, (Rj j).measure (ball y r₀) ≤ ENNReal.ofReal Λ₀ := by
    refine ⟨(⨆ j, (Ts j).massOn (ball y r₀)).toReal, ENNReal.toReal_nonneg, fun j => ?_⟩
    rw [ENNReal.ofReal_toReal (hmass _ isOpen_ball
      (hcc r₀ ((closedBall_subset_closedBall (by linarith)).trans hr₀U))).ne,
      ← (C1 (n + k) n U (Ts j) (Rj j) hU (hRj j)).1 _ isOpen_ball]
    exact le_iSup (fun j => (Ts j).massOn (ball y r₀)) j
  obtain ⟨c₂, hc₂, hball⟩ : ∃ c₂ : ℝ, 0 ≤ c₂ ∧ ∀ j s, 0 < s → s ≤ r₀ →
      (Rj j).measure (ball y s) ≤ ENNReal.ofReal (c₂ * s ^ n) := by
    refine ⟨Real.exp (κ * r₀) / r₀ ^ n * Λ₀, by positivity, fun j s hs hsr₀ => ?_⟩
    have h1 := (hmono (Ts j) (Rj j) (hRj j) (hspt j) (hstat j (Rj j) (hRj j))).2 y
      (mem_ball_self hr₀) s r₀ hs hsr₀ le_rfl
    have h3 : 1 ≤ Real.exp (κ * s) / s ^ n * s ^ n := by
      rw [div_mul_cancel₀ _ (pow_pos hs n).ne']
      exact Real.one_le_exp (mul_nonneg hκ hs.le)
    calc (Rj j).measure (ball y s)
        ≤ ENNReal.ofReal (Real.exp (κ * s) / s ^ n * s ^ n) * (Rj j).measure (ball y s) :=
          le_mul_of_one_le_left' (ENNReal.one_le_ofReal.2 h3)
      _ = ENNReal.ofReal (s ^ n) *
            (ENNReal.ofReal (Real.exp (κ * s) / s ^ n) * (Rj j).measure (ball y s)) := by
          rw [mul_comm (Real.exp (κ * s) / s ^ n), ENNReal.ofReal_mul (by positivity), mul_assoc]
      _ ≤ ENNReal.ofReal (s ^ n) *
            (ENNReal.ofReal (Real.exp (κ * r₀) / r₀ ^ n) * ENNReal.ofReal Λ₀) :=
          mul_le_mul_right (h1.trans (mul_le_mul_right (hΛ₀ j) _)) _
      _ = ENNReal.ofReal (Real.exp (κ * r₀) / r₀ ^ n * Λ₀ * s ^ n) := by
          rw [← ENNReal.ofReal_mul (show 0 ≤ Real.exp (κ * r₀) / r₀ ^ n by positivity),
            ← ENNReal.ofReal_mul (show 0 ≤ s ^ n by positivity), mul_comm (s ^ n)]
  -- `(1 + a)ᵐ − 1 ≤ m·a·2ᵐ` for `0 ≤ a ≤ 1`
  have hgeom : ∀ (m : ℕ) (a : ℝ), 0 ≤ a → a ≤ 1 → (1 + a) ^ m - 1 ≤ m * a * 2 ^ m := by
    intro m a ha0 ha1
    induction m with
    | zero => simp
    | succ m ih =>
      have h1 : 1 ≤ (1 + a) ^ m := one_le_pow₀ (by linarith)
      have h2 : (1 : ℝ) ≤ 2 ^ m := one_le_pow₀ (by norm_num)
      have h3 : 0 ≤ (m : ℝ) * 2 ^ m := by positivity
      push_cast
      rw [pow_succ, pow_succ]
      nlinarith [mul_le_mul_of_nonneg_left ih ha0,
        mul_nonneg (mul_nonneg ha0 (sub_nonneg.2 ha1)) h3]
  -- Step 1(d): `r₁ = min(r₀/3, r/3, 1/(6c_π + 1))`, `c = 3c_π`, `c₁ = n·c·2ⁿ·3ⁿ·c₂`
  refine ⟨min (r₀ / 3) (min (r / 3) (1 / (6 * cπ + 1))), 3 * cπ,
    (n : ℝ) * (3 * cπ) * 2 ^ n * 3 ^ n * c₂,
    lt_min (by linarith) (lt_min (by linarith) (div_pos one_pos (by linarith))), by linarith,
    by positivity, fun ρ ε hε hερ hρr₁ => ?_⟩
  have hρ : 0 < ρ := hε.trans hερ
  have hρ₀ : ρ < r₀ / 3 := hρr₁.trans_le (min_le_left _ _)
  have hρr : ρ < r / 3 := hρr₁.trans_le ((min_le_right _ _).trans (min_le_left _ _))
  have hρc : ρ * (6 * cπ + 1) < 1 := (lt_div_iff₀ (by linarith)).1
    (hρr₁.trans_le ((min_le_right _ _).trans (min_le_right _ _)))
  have hcπρ : 0 ≤ cπ * ρ := mul_nonneg hcπ hρ.le
  have h4 : 4 * cπ * ρ ≤ 1 := by nlinarith
  have hrρ : 3 * ρ < r := by linarith
  have hcl3 : closedBall y (3 * ρ) ⊆ U := (closedBall_subset_closedBall hrρ.le).trans hrU
  have hclε : closedBall y (ρ + ε) ⊆ U :=
    (closedBall_subset_closedBall (by linarith)).trans hcl3
  -- Step 4: flat convergence on `W = B_{ρ+ε}(y)` (Simon Ch. 6, 7.2)
  obtain ⟨Rs, Ss, hRs, hSs, hdiff, hlim⟩ :=
    Submission.dor_lmb_flat_convergence_cycles C1 (n + k) n U Ts T hU hn (fun j => (hmin j).1) hT
      hbd hTbd hmass hconv (ball y (ρ + ε)) isOpen_ball (hcc _ hclε)
  -- the error term `((1 + cρ)ⁿ − 1)·c₂(3ρ)ⁿ ≤ c₁ρⁿ⁺¹`
  have hΛ1 : 0 ≤ (1 + 3 * cπ * ρ) ^ n - 1 := sub_nonneg.2 (one_le_pow₀ (by linarith))
  have hreal : ((1 + 3 * cπ * ρ) ^ n - 1) * (c₂ * (3 * ρ) ^ n) ≤
      n * (3 * cπ) * 2 ^ n * 3 ^ n * c₂ * ρ ^ (n + 1) :=
    calc ((1 + 3 * cπ * ρ) ^ n - 1) * (c₂ * (3 * ρ) ^ n)
        ≤ n * (3 * cπ * ρ) * 2 ^ n * (c₂ * (3 * ρ) ^ n) :=
          mul_le_mul_of_nonneg_right (hgeom n _ (by positivity) (by linarith)) (by positivity)
      _ = n * (3 * cπ) * 2 ^ n * 3 ^ n * c₂ * ρ ^ (n + 1) := by ring
  -- Steps 5–9 for each `j`: cut `Tⱼ` at a good level `t ∈ (ρ, ρ + ε)` and compare with the
  -- competitor `Tⱼ + π_#X` (Simon (3)–(11))
  have hbound : ∀ j, (Ts j).massOn (ball y ρ) ≤
      ENNReal.ofReal ((1 + 3 * cπ * ρ) ^ n) * (T.massOn (ball y (ρ + ε)) +
        (Ss j).massOn (ball y (ρ + ε)) +
        ENNReal.ofReal (2 / (ρ + ε - ρ)) * (Rs j).massOn (ball y (ρ + ε))) +
      ENNReal.ofReal (n * (3 * cπ) * 2 ^ n * 3 ^ n * c₂ * ρ ^ (n + 1)) := by
    intro j
    obtain ⟨t, X, Y, RY, hρt, htε, hX, hXbd, hXvan, hY, hRY, hRYt⟩ :=
      Submission.dor_lmb_good_level_cut C1 (n + k) n U T (Ts j) (Ss j) (Rs j) y ρ (ρ + ε) hU hn
        hT (hmin j).1 (hSs j) (hRs j) (hdiff j) hρ (by linarith) hclε
    have hcmp := Submission.dor_lmb_projected_competitor_comparison C1 (n + k) (n + ℓ) n U N
      (Ts j) X Y (Rj j) RY proj y r cπ ρ t hU hn hN (hmin j) (hspt j) (hbd j) (hRj j) hX hXbd
      hXvan hY hRY hy.1 hcπ hρ hrρ h4 (by linarith) hcl3 hproj hprojN hprojfix hprojT hprojD
    rw [(C1 (n + k) n U (Ts j) (Rj j) hU (hRj j)).1 _ isOpen_ball]
    calc (Rj j).measure (ball y ρ) ≤ (Rj j).measure (closedBall y t) :=
          measure_mono (ball_subset_closedBall.trans (closedBall_subset_closedBall hρt.le))
      _ ≤ ENNReal.ofReal ((1 + 3 * cπ * ρ) ^ n) * RY.measure (closedBall y t) +
            ENNReal.ofReal ((1 + 3 * cπ * ρ) ^ n - 1) * (Rj j).measure (ball y (3 * ρ)) := hcmp
      _ ≤ ENNReal.ofReal ((1 + 3 * cπ * ρ) ^ n) * (T.massOn (ball y (ρ + ε)) +
            (Ss j).massOn (ball y (ρ + ε)) +
            ENNReal.ofReal (2 / (ρ + ε - ρ)) * (Rs j).massOn (ball y (ρ + ε))) +
            ENNReal.ofReal ((1 + 3 * cπ * ρ) ^ n - 1) * ENNReal.ofReal (c₂ * (3 * ρ) ^ n) :=
          add_le_add (mul_le_mul_right hRYt _)
            (mul_le_mul_right (hball j (3 * ρ) (by linarith) (by linarith)) _)
      _ ≤ _ := by
          rw [← ENNReal.ofReal_mul hΛ1]
          exact add_le_add le_rfl (ENNReal.ofReal_le_ofReal hreal)
  -- Step 10: `M_W(Sⱼ), M_W(Rⱼ) → 0`, so the bound tends to `(1 + cρ)ⁿM_W(T) + c₁ρⁿ⁺¹`
  have hS : Tendsto (fun j => (Ss j).massOn (ball y (ρ + ε))) atTop (𝓝 0) :=
    tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hlim (fun _ => zero_le)
      (fun _ => le_add_self)
  have hR : Tendsto (fun j => (Rs j).massOn (ball y (ρ + ε))) atTop (𝓝 0) :=
    tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hlim (fun _ => zero_le)
      (fun _ => le_self_add)
  have hlim' : Tendsto (fun j => ENNReal.ofReal ((1 + 3 * cπ * ρ) ^ n) *
      (T.massOn (ball y (ρ + ε)) + (Ss j).massOn (ball y (ρ + ε)) +
        ENNReal.ofReal (2 / (ρ + ε - ρ)) * (Rs j).massOn (ball y (ρ + ε))) +
      ENNReal.ofReal (n * (3 * cπ) * 2 ^ n * 3 ^ n * c₂ * ρ ^ (n + 1))) atTop
      (𝓝 (ENNReal.ofReal ((1 + 3 * cπ * ρ) ^ n) *
        (T.massOn (ball y (ρ + ε)) + 0 + ENNReal.ofReal (2 / (ρ + ε - ρ)) * 0) +
        ENNReal.ofReal (n * (3 * cπ) * 2 ^ n * 3 ^ n * c₂ * ρ ^ (n + 1)))) :=
    (ENNReal.Tendsto.const_mul ((tendsto_const_nhds.add hS).add
      (ENNReal.Tendsto.const_mul hR (Or.inr ENNReal.ofReal_ne_top)))
      (Or.inr ENNReal.ofReal_ne_top)).add tendsto_const_nhds
  rw [mul_zero, add_zero, add_zero] at hlim'
  exact (limsup_le_limsup (Eventually.of_forall hbound)).trans_eq hlim'.limsup_eq

/-- **Simon 7.4.3** (with `Nᵢ = N`; chapter-07.txt lines 617–631), the book's appeal to Allard's
theorem made quantitative.  By 7.1.2 every representation of `Tⱼ` and of `T` is stationary in
`U ∩ N`.  The ε-regularity criterion at `y` (radius `r₀`, excess `δ`) makes a support point `z`
with `|z − y| < r₀` regular once `M_{B_ρ(z)} ≤ (1 + δ)ωₙρⁿ` for some `ρ ≤ r₀`.  For `y` this
follows from `Θⁿ(μ_T, y) = 1`, which also gives `y ∈ spt T`.  For `yⱼ`, fix `η > 0` with
`(1 + η)(1 + 2η)ⁿ < 1 + δ` and a small `ρ`: the upper mass bound in the limit gives
`limsup M_{B_{(1+η)ρ}(y)}(Tⱼ) ≤ (1 + c(1+η)ρ)ⁿ M_{B_{(1+2η)ρ}(y)}(T) + c₁((1+η)ρ)ⁿ⁺¹`, which is
`< (1 + δ)ωₙρⁿ`, and `B_ρ(yⱼ) ⊆ B_{(1+η)ρ}(y)` once `|yⱼ − y| < ηρ`.  For `n = 0` a minimizing
current does not meet `U ∩ N`, so this case is vacuous. -/
theorem Submission.density_one_implies_regular : DensityOneImpliesRegular := by
  intro n k ℓ hℓk U N Ts T ys y hU hN hNcl hTsmin hTmin hTsN hTN hTsb hTb hmass hconv hy hdens
    hys hysspt
  -- `Θⁿ(μ_T, y) = 1` forces `y ∈ spt T`: otherwise `T` vanishes on a ball about `y`, where the
  -- density ratios are then `0`.
  have hyT : y ∈ T.support := by
    by_contra hnot
    have hyZ : y ∈ T.zeroRegion := by
      by_contra hyZ
      exact hnot (show y ∈ U \ T.zeroRegion from ⟨hy.2, hyZ⟩)
    obtain ⟨W, ⟨hWo, -, -, hWv⟩, hyW⟩ := mem_sUnion.1 hyZ
    obtain ⟨ε, hε, hεW⟩ := Metric.isOpen_iff.1 hWo y hyW
    have h0 : Tendsto (fun ρ : ℝ => T.massOn (ball y ρ) /
        (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) (𝓝 0) := by
      apply tendsto_nhds_of_eventually_eq
      filter_upwards [Ioo_mem_nhdsGT hε] with ρ hρ
      have hm : T.massOn (ball y ρ) = 0 := by
        refine le_antisymm (sSup_le ?_) zero_le
        rintro r ⟨ω, hω, rfl⟩
        exact (ENNReal.ofReal_eq_zero.2
          (hWv ω (hω.1.trans ((ball_subset_ball hρ.2.le).trans hεW))).le).le
      rw [hm, ENNReal.zero_div]
    have h1 := tendsto_nhds_unique hdens.2 h0
    rw [ENNReal.ofReal_one] at h1
    exact one_ne_zero h1
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · -- `n = 0`: a minimizing `0`-current does not meet `U ∩ N`.
    have hmem : y ∈ T.support ∩ (U ∩ N) := ⟨hyT, hy.2, hy.1⟩
    rw [Submission.dor_zero_dim_minimizing_support_disjoint _ U (U ∩ N) T hU hTmin] at hmem
    exact absurd hmem (notMem_empty y)
  -- 7.1.2: representations of minimizing cycles supported in `N` are stationary in `U ∩ N`.
  have hstat : ∀ S : GeometricCurrentOn U n, S.support ⊆ N → IsMinimizingIn S (U ∩ N) →
      BoundaryVanishes S → ∀ R : IMRep U n, R.Represents S → R.IsStationaryAlong N :=
    fun S hSN hSmin hSb R hR => (Submission.minimizing_implies_stationary n k ℓ hℓk U N S hU hN
      hNcl hSN (by rwa [inter_comm]) hSb R hR).1
  obtain ⟨r₀, δ, hr₀, hδ, hreg⟩ :=
    Submission.dor_stationary_cycle_epsilon_regularity n k ℓ hℓk hn U N y hU hN hNcl hy
  obtain ⟨r₁, c, c₁, hr₁, hc, hc₁, hlim⟩ :=
    Submission.dor_minimizing_limsup_mass_bound n k ℓ hℓk hn U N Ts T y hU hN hNcl hTsmin
      hTmin.1 hTsN hTsb hTb (fun j => hstat (Ts j) (hTsN j) (hTsmin j) (hTsb j)) hmass hconv hy
  -- `ωₙ ∈ (0, ∞)`.
  obtain ⟨ωr, hωr, hωeq⟩ : ∃ ωr : ℝ, 0 < ωr ∧ unitBallVolume n = ENNReal.ofReal ωr := by
    have h0 : unitBallVolume n ≠ 0 :=
      (measure_ball_pos (volume : Measure (Euclid n)) (0 : Euclid n) one_pos).ne'
    have htop : unitBallVolume n ≠ ∞ :=
      (measure_ball_lt_top (μ := (volume : Measure (Euclid n))) (x := 0) (r := 1)).ne
    exact ⟨_, ENNReal.toReal_pos h0 htop, (ENNReal.ofReal_toReal htop).symm⟩
  have hbd : ∀ ρ : ℝ, ENNReal.ofReal (1 + δ) * unitBallVolume n * ENNReal.ofReal (ρ ^ n) =
      ENNReal.ofReal ((1 + δ) * (ωr * ρ ^ n)) := by
    intro ρ
    rw [hωeq, ENNReal.ofReal_mul (by linarith : (0 : ℝ) ≤ 1 + δ), ENNReal.ofReal_mul hωr.le,
      mul_assoc]
  -- Density ratios at `y` below `a > 1` bound the mass of small balls about `y`.
  have hD : ∀ a : ℝ, 1 < a → ∀ᶠ s in 𝓝[>] (0 : ℝ),
      T.massOn (ball y s) < ENNReal.ofReal (a * (ωr * s ^ n)) := by
    intro a ha
    have hlt : ENNReal.ofReal 1 < ENNReal.ofReal a :=
      (ENNReal.ofReal_lt_ofReal_iff (by linarith)).2 ha
    filter_upwards [hdens.2.eventually (eventually_lt_nhds hlt), self_mem_nhdsWithin]
      with s hs (hs0 : 0 < s)
    have hpos : (0 : ℝ) < ωr * s ^ n := by positivity
    rw [hωeq, ← ENNReal.ofReal_mul hωr.le, ENNReal.div_lt_iff
      (Or.inl (ENNReal.ofReal_pos.2 hpos).ne') (Or.inl ENNReal.ofReal_ne_top)] at hs
    rwa [ENNReal.ofReal_mul (by linarith : (0 : ℝ) ≤ a)]
  refine ⟨?_, ?_⟩
  · -- `y ∈ reg T`: the density bound at a small scale `ρ ≤ r₀`.
    obtain ⟨RT, hRT⟩ := hTmin.1
    obtain ⟨ρ, hρ, hρ0, hρr₀⟩ := ((hD (1 + δ) (by linarith)).and (Ioo_mem_nhdsGT hr₀)).exists
    refine hreg T RT hRT hTN hTb (hstat T hTN hTmin hTb RT hRT) y hyT (by rwa [dist_self]) ρ hρ0
      hρr₀.le ?_
    rw [hbd]
    exact hρ.le
  · -- `yⱼ ∈ reg Tⱼ` for all large `j`.  First fix `η > 0` with `(1 + η)(1 + 2η)ⁿ < 1 + δ`.
    have hg : Tendsto (fun x : ℝ => (1 + x) * (1 + 2 * x) ^ n) (𝓝 0) (𝓝 1) := by
      have hcont : Continuous fun x : ℝ => (1 + x) * (1 + 2 * x) ^ n := by fun_prop
      simpa using hcont.tendsto 0
    have h1δ : (1 : ℝ) < 1 + δ := by linarith
    have hηev : ∀ᶠ x in 𝓝[>] (0 : ℝ), (1 + x) * (1 + 2 * x) ^ n < 1 + δ ∧ 0 < x := by
      filter_upwards [(hg.eventually (eventually_lt_nhds h1δ)).filter_mono nhdsWithin_le_nhds,
        self_mem_nhdsWithin] with x hx hx0
      exact ⟨hx, hx0⟩
    obtain ⟨η, hηg, hη0⟩ := hηev.exists
    -- Then a scale `ρ`: small enough for both children, with the limit bound below
    -- `(1 + δ)ωₙρⁿ` (as `ρ ↓ 0` the normalized bound tends to `(1 + η)(1 + 2η)ⁿ`).
    have hh : Tendsto (fun ρ : ℝ => (1 + c * ((1 + η) * ρ)) ^ n * ((1 + η) * (1 + 2 * η) ^ n * ωr) +
        c₁ * (1 + η) ^ (n + 1) * ρ) (𝓝 0) (𝓝 ((1 + η) * (1 + 2 * η) ^ n * ωr)) := by
      have hcont : Continuous fun ρ : ℝ => (1 + c * ((1 + η) * ρ)) ^ n *
          ((1 + η) * (1 + 2 * η) ^ n * ωr) + c₁ * (1 + η) ^ (n + 1) * ρ := by fun_prop
      simpa using hcont.tendsto 0
    have hlin : Tendsto (fun ρ : ℝ => (1 + η) * ρ) (𝓝 0) (𝓝 0) := by
      have hcont : Continuous fun ρ : ℝ => (1 + η) * ρ := by fun_prop
      simpa using hcont.tendsto 0
    have hmap : Tendsto (fun ρ : ℝ => (1 + η) * ρ + η * ρ) (𝓝[>] 0) (𝓝[>] 0) := by
      refine tendsto_nhdsWithin_iff.2 ⟨?_, ?_⟩
      · have hcont : Continuous fun ρ : ℝ => (1 + η) * ρ + η * ρ := by fun_prop
        simpa using (hcont.tendsto 0).mono_left nhdsWithin_le_nhds
      · filter_upwards [self_mem_nhdsWithin] with ρ (hρ : 0 < ρ)
        show 0 < (1 + η) * ρ + η * ρ
        positivity
    have hρev : ∀ᶠ ρ in 𝓝[>] (0 : ℝ), 0 < ρ ∧ ρ < r₀ ∧ (1 + η) * ρ < r₁ ∧
        (1 + c * ((1 + η) * ρ)) ^ n * ((1 + η) * (1 + 2 * η) ^ n * ωr) +
          c₁ * (1 + η) ^ (n + 1) * ρ < (1 + δ) * ωr ∧
        T.massOn (ball y ((1 + η) * ρ + η * ρ)) <
          ENNReal.ofReal ((1 + η) * (ωr * ((1 + η) * ρ + η * ρ) ^ n)) := by
      filter_upwards [self_mem_nhdsWithin,
        (eventually_lt_nhds hr₀).filter_mono nhdsWithin_le_nhds,
        (hlin.eventually (eventually_lt_nhds hr₁)).filter_mono nhdsWithin_le_nhds,
        (hh.eventually (eventually_lt_nhds (mul_lt_mul_of_pos_right hηg hωr))).filter_mono
          nhdsWithin_le_nhds,
        hmap.eventually (hD (1 + η) (by linarith))] with ρ h1 h2 h3 h4 h5
      exact ⟨h1, h2, h3, h4, h5⟩
    obtain ⟨ρ, hρ0, hρr₀, hρr₁, hρh, hρD⟩ := hρev.exists
    have hηρ : 0 < η * ρ := mul_pos hη0 hρ0
    have hlimρ := hlim ((1 + η) * ρ) (η * ρ) hηρ (by nlinarith) hρr₁
    have hreal : (1 + c * ((1 + η) * ρ)) ^ n * ((1 + η) * (ωr * ((1 + η) * ρ + η * ρ) ^ n)) +
        c₁ * ((1 + η) * ρ) ^ (n + 1) < (1 + δ) * (ωr * ρ ^ n) := by
      have hs : (1 + η) * ρ + η * ρ = (1 + 2 * η) * ρ := by ring
      calc (1 + c * ((1 + η) * ρ)) ^ n * ((1 + η) * (ωr * ((1 + η) * ρ + η * ρ) ^ n)) +
            c₁ * ((1 + η) * ρ) ^ (n + 1)
          = ((1 + c * ((1 + η) * ρ)) ^ n * ((1 + η) * (1 + 2 * η) ^ n * ωr) +
              c₁ * (1 + η) ^ (n + 1) * ρ) * ρ ^ n := by
            rw [hs, mul_pow, mul_pow, pow_succ ρ n]
            ring
        _ < (1 + δ) * ωr * ρ ^ n := mul_lt_mul_of_pos_right hρh (pow_pos hρ0 n)
        _ = (1 + δ) * (ωr * ρ ^ n) := mul_assoc _ _ _
    have hA : (0 : ℝ) ≤ (1 + c * ((1 + η) * ρ)) ^ n := by positivity
    have hX : (0 : ℝ) ≤ (1 + η) * (ωr * ((1 + η) * ρ + η * ρ) ^ n) := by positivity
    have hB : (0 : ℝ) ≤ c₁ * ((1 + η) * ρ) ^ (n + 1) := by positivity
    have hbound : limsup (fun j => (Ts j).massOn (ball y ((1 + η) * ρ))) atTop <
        ENNReal.ofReal ((1 + δ) * (ωr * ρ ^ n)) :=
      calc limsup (fun j => (Ts j).massOn (ball y ((1 + η) * ρ))) atTop
          ≤ ENNReal.ofReal ((1 + c * ((1 + η) * ρ)) ^ n) *
              T.massOn (ball y ((1 + η) * ρ + η * ρ)) +
              ENNReal.ofReal (c₁ * ((1 + η) * ρ) ^ (n + 1)) := hlimρ
        _ ≤ ENNReal.ofReal ((1 + c * ((1 + η) * ρ)) ^ n) *
              ENNReal.ofReal ((1 + η) * (ωr * ((1 + η) * ρ + η * ρ) ^ n)) +
              ENNReal.ofReal (c₁ * ((1 + η) * ρ) ^ (n + 1)) := by
            gcongr
        _ = ENNReal.ofReal ((1 + c * ((1 + η) * ρ)) ^ n *
              ((1 + η) * (ωr * ((1 + η) * ρ + η * ρ) ^ n)) +
              c₁ * ((1 + η) * ρ) ^ (n + 1)) := by
            rw [ENNReal.ofReal_add (mul_nonneg hA hX) hB, ENNReal.ofReal_mul hA]
        _ < ENNReal.ofReal ((1 + δ) * (ωr * ρ ^ n)) :=
            (ENNReal.ofReal_lt_ofReal_iff (by positivity)).2 hreal
    -- Eventually `|yⱼ − y| < min(ηρ, r₀)` and `M_{B_{(1+η)ρ}(y)}(Tⱼ) < (1 + δ)ωₙρⁿ`.
    filter_upwards [eventually_lt_of_limsup_lt hbound, hys.eventually (ball_mem_nhds y hηρ),
      hys.eventually (ball_mem_nhds y hr₀)] with j hj hjη hjr₀
    obtain ⟨Rj, hRj⟩ := (hTsmin j).1
    refine hreg (Ts j) Rj hRj (hTsN j) (hTsb j) (hstat (Ts j) (hTsN j) (hTsmin j) (hTsb j) Rj hRj)
      (ys j) (hysspt j) hjr₀ ρ hρ0 hρr₀.le ?_
    rw [hbd]
    refine ((Ts j).massOn_mono (ball_subset_ball' ?_)).trans hj.le
    have hd : dist (ys j) y < η * ρ := hjη
    linarith
/-- **Reduction to multiplicity one**, a step of **Simon 7.4.2** (chapter-07.txt lines 605–610),
as in the proof of Ch. 5, Corollary 7.3 (chapter-05.txt lines 1389–1394, `Ṽ = v(M, N⁻¹θ)⌞B_ρ(ξ)`).
Let `T = τ(M, θ, ξ)` be minimizing in `U ∩ N` with `spt T ⊆ N` and `∂T = 0`, let `z₀ ∈ spt T` and
`B = B_r(z₀) ⊆ U`, and let `θ = N₀ ≥ 1` `μ_T`-a.e. on `B` with `Θⁿ(μ_T, z₀) = N₀`.  Then
`T₀ = N₀⁻¹ T` in `B` is minimizing in `B ∩ N`, `spt T₀ ⊆ N`, `∂T₀ = 0`, `M_W(T₀) < ∞` for `W ⊂⊂ B`,
`z₀ ∈ spt T₀`, `Θⁿ(μ_{T₀}, z₀) = 1`, and `z₀ ∈ reg T₀` implies `z₀ ∈ reg T`.  Since
`T(ι ω) = N₀ T₀(ω)`: `T₀ = τ(M ∩ B, 1, ξ)`, `spt T₀ = spt T ∩ B`, `M_W(T) = N₀ M_W(T₀)` for `W ⊆ B`
(so `M_W(T₀) ≤ μ_T(W̄) < ∞` and the densities differ by the factor `N₀`), and `T₀ = m[[M']]` near
`z₀` gives `T = (N₀ m)[[M']]` there.  For minimality let `S₀` compete with `T₀` in `W`, and
`K = spt(S₀ − T₀)`.  The weight of `X = S₀ − T₀` vanishes on `B \ K`, so `X` extends by zero to
`E ∈ 𝒟ₙ(U)`, and `S = T + N₀E` competes with `T` in `W`: it is integer multiplicity, `∂S = ∂T`
because `∂E = 0`, and `spt(S − T) ⊆ K`.  Hence `N₀ M_W(T₀) = M_W(T) ≤ M_W(S) = N₀ M_W(S₀)`. -/
theorem Submission.rsd_constant_multiplicity_reduction : ∀ (P n : ℕ) (U N : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n) (z₀ : Euclid P) (r : ℝ) (N₀ : ℕ), IsOpen U → IsMinimizingIn T (U ∩ N) → T.support ⊆ N → BoundaryVanishes T → R.Represents T → 0 < r → ball z₀ r ⊆ U → 0 < N₀ → (∀ᵐ x ∂R.measure, x ∈ ball z₀ r → R.mult x = N₀) → z₀ ∈ T.support → HasMassDensity T z₀ N₀ → ∃ T₀ : GeometricCurrentOn (ball z₀ r) n, IsMinimizingIn T₀ (ball z₀ r ∩ N) ∧ T₀.support ⊆ N ∧ BoundaryVanishes T₀ ∧ (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W (ball z₀ r) → T₀.massOn W < ∞) ∧ z₀ ∈ T₀.support ∧ HasMassDensity T₀ z₀ 1 ∧ (z₀ ∈ regularSet T₀ → z₀ ∈ regularSet T) := by
  intro P n U N T R z₀ r N₀ hU hmin hTN hbdry hRT hr hBU hN₀ hconst hz₀ hdens
  have hc : (N₀ : ℝ) ≠ 0 := Nat.cast_ne_zero.2 hN₀.ne'
  have hc0 : (0 : ℝ) ≤ N₀ := Nat.cast_nonneg N₀
  have hN0 : ENNReal.ofReal N₀ ≠ 0 := (ENNReal.ofReal_pos.2 (Nat.cast_pos.2 hN₀)).ne'
  have hNtop : ENNReal.ofReal N₀ ≠ ∞ := ENNReal.ofReal_ne_top
  -- Step 1: `T₀ = N₀⁻¹ T` in `B = B_r(z₀)`, i.e. `T(ι ω) = N₀ T₀(ω)` for `ω ∈ 𝒟ⁿ(B)`.
  obtain ⟨T₀, hT₀⟩ : ∃ T₀ : GeometricCurrentOn (ball z₀ r) n, ∀ ω : TestFormOn (ball z₀ r) n,
      T (testFormOnInclusion hBU n ω) = (N₀ : ℝ) * T₀ ω :=
    ⟨⟨(N₀ : ℝ)⁻¹ • (T.restrictDomain hBU).toCurrent, fun ωs h => by
        simpa using ((T.restrictDomain hBU).continuous' ωs h).const_mul (N₀ : ℝ)⁻¹⟩,
      fun ω => (mul_inv_cancel_left₀ hc _).symm⟩
  -- Step 2: `T₀ = τ(M ∩ B, 1, ξ)` is integer multiplicity.
  have hT₀im : IsIntegerMultiplicity T₀ :=
    Submission.rsd_cmr_isIntegerMultiplicity_of_const_mult P n U (ball z₀ r) hBU T R T₀ N₀
      isOpen_ball hN₀ hRT hconst hT₀
  -- Steps 4–5: `spt T₀ = spt T ∩ B`, and `M_W(T) = N₀ M_W(T₀)` for `W ⊆ B`.
  have hspt : T₀.support = T.support ∩ ball z₀ r :=
    Submission.rsd_cmr_support_eq_inter P n U (ball z₀ r) hBU T T₀ N₀ isOpen_ball hc hT₀
  have hmass : ∀ W ⊆ ball z₀ r, T.massOn W = ENNReal.ofReal N₀ * T₀.massOn W :=
    Submission.rsd_cmr_massOn_eq_ofReal_mul P n U (ball z₀ r) hBU T T₀ N₀ hc0 hT₀
  refine ⟨T₀, ⟨hT₀im, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- Step 6: `T₀` is minimizing in `B ∩ N`.  Let `S₀` compete with `T₀` in `W`.
    intro W S₀ hW hWB hS₀ hbS₀ hK hKW
    have hKB : (S₀ - T₀).support ⊆ ball z₀ r := (S₀ - T₀).support_subset_domain
    have hWsub : W ⊆ ball z₀ r := subset_closure.trans hWB.2
    have hX : ∀ ω, (S₀ - T₀) ω = S₀ ω - T₀ ω := fun _ => rfl
    -- Step 6(a): `X = S₀ − T₀ = τ(M_X, θ_X, ξ_X)` is integer multiplicity.
    obtain ⟨RX, hRX⟩ := Submission.rsd_isIntegerMultiplicity_int_combination P n (ball z₀ r) S₀
      T₀ (S₀ - T₀) 1 (-1) isOpen_ball hS₀ hT₀im fun ω => by
        rw [hX]
        push_cast
        ring
    -- Step 6(b): `μ_X` vanishes on a ball about each point of `B \ K`.
    have hnull : ∀ y ∈ ball z₀ r, y ∉ (S₀ - T₀).support →
        ∃ ρ : ℝ, 0 < ρ ∧ RX.measure (ball y ρ) = 0 := by
      intro y hy hyK
      have h := mt (Submission.rsd_mem_support_iff_measure_ball_pos P n (ball z₀ r) (S₀ - T₀) RX
        isOpen_ball hRX y).2 hyK
      push Not at h
      obtain ⟨ρ, hρ, hμ⟩ := h hy
      exact ⟨ρ, hρ, nonpos_iff_eq_zero.1 hμ⟩
    -- Step 6(c): the extension `E ∈ 𝒟ₙ(U)` of `X` by zero.
    obtain ⟨E, hE, hEX, hEK⟩ := Submission.rsd_cmr_zero_extension P n U (ball z₀ r)
      (S₀ - T₀).support hBU (S₀ - T₀) RX isOpen_ball hK hKB hRX hnull
    -- Step 6(d): the competitor `S = T + N₀E` is integer multiplicity.
    obtain ⟨S, hS⟩ : ∃ S : GeometricCurrentOn U n, ∀ ω, S ω = T ω + (N₀ : ℝ) * E ω :=
      ⟨⟨T.toCurrent + (N₀ : ℝ) • E.toCurrent, fun ωs h => by
          simpa using (T.continuous' ωs h).add ((E.continuous' ωs h).const_mul (N₀ : ℝ))⟩,
        fun _ => rfl⟩
    have hSim : IsIntegerMultiplicity S :=
      Submission.rsd_isIntegerMultiplicity_int_combination P n U T E S 1 N₀ hU hmin.1 hE
        fun ω => by
          rw [hS]
          push_cast
          ring
    -- Step 6(f): `S − T = N₀E` vanishes on forms missing `K`, so `spt(S − T) ⊆ K` is compact.
    have hST : ∀ ω, (S - T) ω = S ω - T ω := fun _ => rfl
    obtain ⟨hSTK, hSTc⟩ := Submission.rsd_cmr_support_subset_of_vanish P n U (S₀ - T₀).support
      (S - T) hU hK (hKB.trans hBU) fun ω hω => by
        rw [hST, hS, hEK ω hω, mul_zero, add_zero, sub_self]
    -- Step 6(e): `∂S = ∂T`: `∂E` vanishes on forms missing `K` and on `ι(𝒟ⁿ⁻¹(B))`, where
    -- `∂E(ι ψ) = X(dψ) = ∂S₀(ψ) − ∂T₀(ψ) = 0`; hence `∂E = 0`.
    have hbS : SameBoundary S T := by
      cases n with
      | zero => trivial
      | succ m =>
        have hb₀ : S₀.boundary = T₀.boundary := hbS₀
        have hEb := Submission.rsd_cmr_eq_zero_of_vanish_off_compact P m U (ball z₀ r)
          (S₀ - T₀).support hBU E.boundary isOpen_ball hK hKB
          (fun ω hω => by
            rw [GeometricCurrentOn.boundary_apply]
            exact hEK _ (hω.mono_left
              (tsupport_exteriorDerivative_subset (ω : DifferentialForm (Euclid P) m))))
          fun ψ => by
            have hι : exteriorDerivativeTestOn U m (testFormOnInclusion hBU m ψ) =
                testFormOnInclusion hBU (m + 1) (exteriorDerivativeTestOn (ball z₀ r) m ψ) :=
              Subtype.ext rfl
            have hψ : S₀.boundary ψ = T₀.boundary ψ := by rw [hb₀]
            rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.boundary_apply] at hψ
            rw [GeometricCurrentOn.boundary_apply, hι, hEX, hX, hψ, sub_self]
        change S.boundary = T.boundary
        ext ω
        have h0 := hEb ω
        rw [GeometricCurrentOn.boundary_apply] at h0
        rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.boundary_apply, hS, h0, mul_zero,
          add_zero]
    -- Step 6(g): `N₀ M_W(T₀) = M_W(T) ≤ M_W(S) = N₀ M_W(S₀)`, since `S(ι ω) = N₀ S₀(ω)`.
    have hle := hmin.2 W S hW ⟨hWB.1, hWB.2.trans hBU⟩ hSim hbS hSTc fun x hx =>
      ⟨⟨hBU (hKW (hSTK hx)).1.1, (hKW (hSTK hx)).1.2⟩, (hKW (hSTK hx)).2⟩
    rwa [hmass W hWsub, Submission.rsd_cmr_massOn_eq_ofReal_mul P n U (ball z₀ r) hBU S S₀ N₀ hc0
      (fun ω => by
        rw [hS, hT₀, hEX, hX]
        ring) W hWsub, ENNReal.mul_le_mul_iff_right hN0 hNtop] at hle
  · -- Step 4(a): `spt T₀ ⊆ spt T ⊆ N`.
    rw [hspt]
    exact inter_subset_left.trans hTN
  · -- Step 3: `∂T₀ = 0`, as `N₀ ∂T₀(ω) = ∂T(ι ω) = 0`.
    cases n with
    | zero => trivial
    | succ m =>
      have hb : T.boundary = 0 := hbdry
      change T₀.boundary = 0
      ext ω
      have hι : testFormOnInclusion hBU (m + 1) (exteriorDerivativeTestOn (ball z₀ r) m ω) =
          exteriorDerivativeTestOn U m (testFormOnInclusion hBU m ω) := Subtype.ext rfl
      have h0 : T (exteriorDerivativeTestOn U m (testFormOnInclusion hBU m ω)) = 0 := by
        rw [← GeometricCurrentOn.boundary_apply, hb, GeometricCurrentOn.zero_apply]
      have h := hT₀ (exteriorDerivativeTestOn (ball z₀ r) m ω)
      rw [hι, h0] at h
      rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.zero_apply]
      exact (mul_eq_zero.1 h.symm).resolve_left hc
  · -- Step 5(a): `M_W(T₀) ≤ N₀ M_W(T₀) = M_W(T) = μ_T(W) ≤ μ_T(W̄) < ∞`.
    intro W hW hWB
    have hWsub : W ⊆ ball z₀ r := subset_closure.trans hWB.2
    have hcl : MeasurableSet (closure W) := isClosed_closure.measurableSet
    calc T₀.massOn W ≤ ENNReal.ofReal N₀ * T₀.massOn W :=
          le_mul_of_one_le_left' (ENNReal.one_le_ofReal.2 (Nat.one_le_cast.2 hN₀))
      _ = R.measure W := by
          rw [← hmass W hWsub,
            Submission.rsd_massOn_eq_measure P n U T R hU hRT W hW (hWsub.trans hBU)]
      _ ≤ R.measure (closure W) := measure_mono subset_closure
      _ = ∫⁻ x in R.carrier ∩ closure W, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
          rw [IMRep.measure, withDensity_apply _ hcl, Measure.restrict_restrict hcl, inter_comm]
      _ < ∞ := (R.locallyIntegrable_mult _ hWB.1 (hWB.2.trans hBU)).lt_top
  · -- Step 4(b): `z₀ ∈ spt T ∩ B = spt T₀`.
    rw [hspt]
    exact ⟨hz₀, mem_ball_self hr⟩
  · -- Step 5(b): `M_{B_ρ(z₀)}(T₀) = N₀⁻¹ M_{B_ρ(z₀)}(T)` for `ρ < r`; the density is `N₀⁻¹N₀ = 1`.
    refine ⟨zero_le_one, ?_⟩
    have h := ENNReal.Tendsto.const_mul hdens.2 (Or.inr (ENNReal.inv_ne_top.2 hN0))
    rw [ENNReal.inv_mul_cancel hN0 hNtop, ← ENNReal.ofReal_one] at h
    refine h.congr' ?_
    filter_upwards [Ioo_mem_nhdsGT hr] with ρ hρ
    rw [hmass _ (ball_subset_ball hρ.2.le), mul_div_assoc, ENNReal.inv_mul_cancel_left hN0 hNtop]
  · -- Step 7: `T₀ = m[[M']]` near `z₀` gives `T = (N₀ m)[[M']]` there.
    exact Submission.rsd_cmr_regularSet_transfer P n U (ball z₀ r) hBU T T₀ N₀ z₀
      (Nat.cast_ne_zero.2 hN₀.ne') (fun ω => by rw [Int.cast_natCast]; exact hT₀ ω) hz₀

/-- **Simon 7.4.2–7.4.3** (chapter-07.txt lines 608–631; Allard's theorem for `T/k`): a support
point `p` of a minimizing cycle `T` is regular if `Θⁿ(μ_T, y) = k` for every `y ∈ spt T` near
`p`.  Fix `T = τ(S, θ, ξ)`, so `μ_T = θHⁿ⌞S ≪ Hⁿ⌞S`, and a radius `r ≤ δ` with `B_r(p) ⊆ U`.  Then
`n ≤ P`: otherwise `Hⁿ` vanishes on balls of `ℝᴾ`, against `μ_T(B_1(p)) > 0`.  `μ_T`-a.e. `x` lies
in `spt T` and has density `θ(x)`, so `θ = k` `μ_T`-a.e. on `B_r(p)` by uniqueness of densities;
`k ≥ 1` since `θ > 0` `μ_T`-a.e. and `μ_T(B_r(p)) > 0`.  Dividing by `k`
(`rsd_constant_multiplicity_reduction`) gives a minimizing cycle `T₀` in `B_r(p)` with
`Θⁿ(μ_{T₀}, p) = 1` and `p ∈ reg T₀ → p ∈ reg T`; 7.4.3 for the constant sequence `T₀`, with
`N = ℝ^{n+k₀}` (`P = n + k₀`, identity chart), gives `p ∈ reg T₀`. -/
theorem Submission.idtp_ccd_regular_of_const_density : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (p : Euclid P) (k : ℕ) (δ : ℝ), 1 ≤ n → IsOpen U → IsMinimizingIn T U → BoundaryVanishes T → p ∈ T.support → 0 < δ → (∀ y ∈ T.support, y ∈ ball p δ → HasMassDensity T y k) → p ∈ regularSet T := by
  intro P n U T p k δ _ hU hmin hb hp hδ hdens
  -- `T = τ(S, θ, ξ)`; `μ_T = θHⁿ⌞S ≪ Hⁿ⌞S`, and `μ_T(B_s(p)) > 0` for `s > 0` as `p ∈ spt T`.
  obtain ⟨R, hR⟩ := hmin.1
  have hac : R.measure ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
  have hpos : ∀ s : ℝ, 0 < s → 0 < R.measure (ball p s) :=
    ((Submission.rsd_mem_support_iff_measure_ball_pos P n U T R hU hR p).1 hp).2
  -- A radius `r ≤ δ` with `B_r(p) ⊆ U`.
  obtain ⟨ε, hε, hεU⟩ := Metric.isOpen_iff.1 hU p (T.support_subset_domain hp)
  obtain ⟨r, hr, hrδ, hrU⟩ : ∃ r : ℝ, 0 < r ∧ ball p r ⊆ ball p δ ∧ ball p r ⊆ U :=
    ⟨min ε δ, lt_min hε hδ, ball_subset_ball (min_le_right ε δ),
      (ball_subset_ball (min_le_left ε δ)).trans hεU⟩
  -- `n ≤ P`: otherwise `Hⁿ(B_1(p)) = 0` in `ℝᴾ`, so `μ_T(B_1(p)) = 0`.
  have hnP : n ≤ P := by
    refine le_of_not_gt fun hlt => ?_
    have h0 : μHE[n] (ball p 1) = 0 := by
      rcases Measure.euclideanHausdorffMeasure_zero_or_top hlt (ball p 1) with h | h
      · exact h
      · rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume] at h
        exact absurd h measure_ball_lt_top.ne
    refine (hpos 1 one_pos).ne' (hac ?_)
    rw [Measure.restrict_apply' R.measurableSet_carrier]
    exact measure_mono_null inter_subset_left h0
  -- `θ = k` `μ_T`-a.e. on `B_r(p)`: `μ_T`-a.e. point lies in `spt T` and has density `θ`.
  have hae : ∀ᵐ x ∂R.measure, x ∈ ball p r → R.mult x = k := by
    have hspt : ∀ᵐ x ∂(μHE[n].restrict R.carrier), x ∈ T.support := by
      rw [ae_iff, Measure.restrict_apply' R.measurableSet_carrier]
      refine measure_mono_null ?_ (Submission.imrep_carrier_sdiff_support_null P n U T R hU hR)
      exact fun x hx => ⟨hx.2, hx.1⟩
    filter_upwards [Submission.rsd_ae_hasMassDensity_mult P n U T R hU hR, hac.ae_le hspt]
      with x hx hxs hxb
    exact_mod_cast Submission.dimred_cs_mi_hasMassDensity_unique P n U T x _ _ hx
      (hdens x hxs (hrδ hxb))
  -- `k ≥ 1`: `θ > 0` `μ_T`-a.e., so `k = 0` would give `μ_T(B_r(p)) = 0`.
  have hk : 0 < k := by
    rcases Nat.eq_zero_or_pos k with rfl | hk
    · have hθ : ∀ᵐ x ∂R.measure, (R.mult x : ℝ≥0∞) ≠ 0 :=
        (ae_withDensity_iff ((measurable_from_nat (f := fun m : ℕ => (m : ℝ≥0∞))).comp
          R.measurable_mult)).2 (Eventually.of_forall fun _ h => h)
      refine absurd (measure_eq_zero_iff_ae_notMem.2 ?_) (hpos r hr).ne'
      filter_upwards [hae, hθ] with x hx hθx hxb
      exact hθx (by simp [hx hxb])
    · exact hk
  -- Division by the multiplicity: a minimizing cycle `T₀` in `B_r(p)` with density `1` at `p`.
  obtain ⟨T₀, hT₀min, hT₀N, hT₀b, hT₀mass, hpT₀, hT₀dens, htrans⟩ :=
    Submission.rsd_constant_multiplicity_reduction P n U univ T R p r k hU (by rwa [inter_univ])
      (subset_univ _) hb hR hr hrU hk hae hp (hdens p hp (mem_ball_self hδ))
  -- Allard (7.4.3) for the constant sequence `T₀`, with `N = ℝ^{n+k₀}` (identity chart).
  obtain ⟨k₀, rfl⟩ := Nat.exists_eq_add_of_le hnP
  have hN : IsEmbeddedSubmanifold 2 (n + k₀) (univ : Set (Euclid (n + k₀))) := by
    intro y _
    refine ⟨univ, univ, id, isOpen_univ, isOpen_univ, mem_univ y, contDiffOn_id, injOn_id _,
      by simp, fun K _ hK => by simpa using hK, fun z _ => ?_⟩
    rw [fderiv_id]
    exact fun a b h => h
  exact htrans (Submission.density_one_implies_regular n k₀ k₀ le_rfl (ball p r) univ
    (fun _ => T₀) T₀ (fun _ => p) p isOpen_ball hN (by simp) (fun _ => hT₀min) hT₀min
    (fun _ => hT₀N) hT₀N (fun _ => hT₀b) hT₀b
    (fun W hW hWc => by simpa only [iSup_const] using hT₀mass W hW hWc)
    (fun _ => tendsto_const_nhds) ⟨mem_univ p, mem_ball_self hr⟩ hT₀dens tendsto_const_nhds
    (fun _ => hpT₀)).1
/-- **The tangent space of an embedded `C¹` submanifold** (Simon Ch. 2, §4, (4.3)).  If `M` is an
embedded `C¹` `d`-dimensional submanifold of `ℝᴾ` and `x ∈ M`, then `T_xM` is a linear subspace of
dimension `d`: for a local representation `ψ : V → W ∩ M` with `ψ(v) = x`, `T_xM` is the range of
the injective linear map `Dψ(v)`.  A `C¹` curve in `M` through `x` stays in `ψ(V)` near `0` and,
`ψ` being proper and injective, lifts to a curve in `V` converging to `v` at rate `O(t)` (`Dψ(v)` is
injective), so its velocity lies in the closed subspace `range Dψ(v)`; conversely `Dψ(v) u` is the
velocity of `t ↦ ψ(v + a sin(t / a) u)` for small `a > 0`. -/
theorem Submission.idtp_ccd_sfv_span_tangentSpace_finrank : ∀ (P d : ℕ) (M : Set (Euclid P)) (x : Euclid P), IsEmbeddedSubmanifold 1 d M → x ∈ M → (Submodule.span ℝ (tangentSpace M x) : Set (Euclid P)) = tangentSpace M x ∧ Module.finrank ℝ (Submodule.span ℝ (tangentSpace M x)) = d := by
  intro P d M x hM hx
  obtain ⟨V, W, ψ, hVo, hWo, hxW, hψC, hψinj, hψim, hprop, hψD⟩ := hM x hx
  obtain ⟨v, hvV, rfl⟩ : x ∈ ψ '' V := hψim ▸ ⟨hxW, hx⟩
  rw [Nat.cast_one] at hψC
  set L : Euclid d →L[ℝ] Euclid P := fderiv ℝ ψ v
  have hψd : HasFDerivAt ψ L v :=
    ((hψC.contDiffAt (hVo.mem_nhds hvV)).differentiableAt one_ne_zero).hasFDerivAt
  have hrange :
      Set.range L = ((LinearMap.range (L : Euclid d →ₗ[ℝ] Euclid P)) : Set (Euclid P)) := by
    rw [LinearMap.coe_range]; rfl
  have key : tangentSpace M (ψ v) = Set.range L := by
    ext w
    constructor
    · rintro ⟨γ, -, hγM, hγ0, hγd⟩
      -- lift `γ` near `0` to a curve `φ` in the compact set `S = V ∩ ψ⁻¹(B̄_r(ψ v))`
      have hγc : Tendsto γ (𝓝 0) (𝓝 (ψ v)) := hγ0 ▸ hγd.continuousAt.tendsto
      obtain ⟨r, hr, hrW⟩ := nhds_basis_closedBall.mem_iff.mp (hWo.mem_nhds hxW)
      set S := V ∩ ψ ⁻¹' closedBall (ψ v) r
      have hS : IsCompact S := hprop _ hrW (isCompact_closedBall _ _)
      have hev : ∀ᶠ t in 𝓝 (0 : ℝ), t ∈ Ioo (-1 : ℝ) 1 ∧ γ t ∈ closedBall (ψ v) r := by
        filter_upwards [Ioo_mem_nhds (by norm_num : (-1 : ℝ) < 0) (by norm_num : (0 : ℝ) < 1),
          hγc (closedBall_mem_nhds _ hr)] with t h1 h2
        exact ⟨h1, h2⟩
      have hpre : ∀ t, t ∈ Ioo (-1 : ℝ) 1 ∧ γ t ∈ closedBall (ψ v) r → ∃ z ∈ S, ψ z = γ t := by
        rintro t ⟨ht, htK⟩
        obtain ⟨z, hz, hzt⟩ : γ t ∈ ψ '' V := hψim ▸ ⟨hrW htK, hγM ht⟩
        exact ⟨z, ⟨hz, by rw [mem_preimage, hzt]; exact htK⟩, hzt⟩
      classical
      set φ : ℝ → Euclid d := fun t =>
        if h : t ∈ Ioo (-1 : ℝ) 1 ∧ γ t ∈ closedBall (ψ v) r then (hpre t h).choose else v
        with hφ_def
      have hφ : ∀ᶠ t in 𝓝 (0 : ℝ), φ t ∈ S ∧ ψ (φ t) = γ t := hev.mono fun t ht => by
        rw [hφ_def]; dsimp only; rw [dite_eq_left ht]; exact (hpre t ht).choose_spec
      -- `φ t → v`: every cluster point `z ∈ S` has `ψ z = ψ v`
      have hφv : Tendsto φ (𝓝 0) (𝓝 v) := by
        refine hS.tendsto_nhds_of_unique_mapClusterPt (hφ.mono fun t ht => ht.1) ?_
        intro z hz hcl
        have hψz : ContinuousAt ψ z := hψC.continuousOn.continuousAt (hVo.mem_nhds hz.1)
        have h1 : MapClusterPt (ψ z) (𝓝 0) (ψ ∘ φ) := hcl.continuousAt_comp hψz
        have h2 : Tendsto (ψ ∘ φ) (𝓝 0) (𝓝 (ψ v)) := hγc.congr' (hφ.mono fun t ht => ht.2.symm)
        exact hψinj hz.1 hvV (eq_of_nhds_neBot (ClusterPt.mono h1 h2))
      -- `‖φ t - v‖ ≤ 2K ‖γ t - ψ v‖`, `K` an antilipschitz constant of `L`
      obtain ⟨K, hKpos, hK⟩ := (L : Euclid d →ₗ[ℝ] Euclid P).exists_antilipschitzWith
        (LinearMap.ker_eq_bot.mpr (hψD v hvV))
      have hK0 : (0 : ℝ) < K := hKpos
      have hKL : ∀ h, ‖h‖ ≤ K * ‖L h‖ := fun h => hK.le_mul_norm (map_zero _) h
      have h1 : (fun t => ψ (φ t) - ψ v - L (φ t - v)) =o[𝓝 0] (fun t => φ t - v) :=
        hψd.isLittleO.comp_tendsto hφv
      have h2 : (fun t => φ t - v) =O[𝓝 0] (fun t => γ t - ψ v) := by
        refine Asymptotics.IsBigO.of_bound (2 * K) ?_
        filter_upwards [h1.bound (c := 1 / (2 * K)) (by positivity), hφ] with t ht hφt
        rw [hφt.2] at ht
        have h4 : ‖L (φ t - v)‖ ≤ ‖γ t - ψ v‖ + 1 / (2 * K) * ‖φ t - v‖ := by
          calc ‖L (φ t - v)‖ = ‖(γ t - ψ v) - (γ t - ψ v - L (φ t - v))‖ := by congr 1; abel
            _ ≤ ‖γ t - ψ v‖ + ‖γ t - ψ v - L (φ t - v)‖ := norm_sub_le _ _
            _ ≤ ‖γ t - ψ v‖ + 1 / (2 * K) * ‖φ t - v‖ := by gcongr
        have h5 : ‖φ t - v‖ ≤ K * ‖γ t - ψ v‖ + ‖φ t - v‖ / 2 := by
          calc ‖φ t - v‖ ≤ K * ‖L (φ t - v)‖ := hKL _
            _ ≤ K * (‖γ t - ψ v‖ + 1 / (2 * K) * ‖φ t - v‖) := by gcongr
            _ = K * ‖γ t - ψ v‖ + ‖φ t - v‖ / 2 := by field_simp
        linarith
      have h6 : (fun t => φ t - v) =O[𝓝 0] (fun t : ℝ => t) := by
        have h' := hγd.isBigO_sub
        rw [hγ0] at h'
        simpa only [sub_zero] using h2.trans h'
      -- hence `t • w - L (φ t - v) = o(t)`, and `w` is a limit of points of `range L`
      have h7 : (fun t => ψ (φ t) - ψ v - L (φ t - v)) =o[𝓝 0] (fun t : ℝ => t) :=
        h1.trans_isBigO h6
      have h8 : (fun t => γ t - ψ v - L (φ t - v)) =o[𝓝 0] (fun t : ℝ => t) :=
        h7.congr' (hφ.mono fun t ht => by dsimp only; rw [ht.2]) EventuallyEq.rfl
      have h9 : (fun t => γ t - ψ v - t • w) =o[𝓝 0] (fun t : ℝ => t) := by
        have := hasDerivAt_iff_isLittleO.mp hγd
        simpa [hγ0] using this
      have h10 : (fun t => t • w - L (φ t - v)) =o[𝓝 0] (fun t : ℝ => t) :=
        (h8.sub h9).congr_left fun t => by abel
      have h11 : Tendsto (fun t : ℝ => t⁻¹ • (t • w - L (φ t - v))) (𝓝[≠] 0) (𝓝 0) :=
        h10.tendsto_inv_smul_nhds_zero.mono_left nhdsWithin_le_nhds
      have h12 : Tendsto (fun t : ℝ => L (t⁻¹ • (φ t - v))) (𝓝[≠] 0) (𝓝 w) := by
        have := (tendsto_const_nhds (x := w)).sub h11
        rw [sub_zero] at this
        refine this.congr' ?_
        filter_upwards [self_mem_nhdsWithin] with t (ht : t ≠ 0)
        rw [smul_sub, smul_smul, inv_mul_cancel₀ ht, one_smul, map_smul]
        abel
      have hclosed : IsClosed (Set.range L) :=
        hrange ▸ (LinearMap.range (L : Euclid d →ₗ[ℝ] Euclid P)).closed_of_finiteDimensional
      exact hclosed.mem_of_tendsto h12 (Eventually.of_forall fun t => ⟨_, rfl⟩)
    · rintro ⟨u, rfl⟩
      obtain ⟨δ, hδ, hδV⟩ := Metric.isOpen_iff.mp hVo v hvV
      set a : ℝ := δ / (‖u‖ + 1) with ha
      have ha0 : 0 < a := by positivity
      set c : ℝ → Euclid d := fun t => v + (a * Real.sin (t / a)) • u with hc
      have hcV : ∀ t, c t ∈ V := fun t => hδV (by
        rw [mem_ball, dist_eq_norm, hc, add_sub_cancel_left, norm_smul, Real.norm_eq_abs, abs_mul,
          abs_of_pos ha0]
        calc a * |Real.sin (t / a)| * ‖u‖ ≤ a * 1 * ‖u‖ := by
              gcongr; exact Real.abs_sin_le_one _
          _ < δ := by
              rw [mul_one, ha, div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
              nlinarith [norm_nonneg u])
      have hcC : ContDiff ℝ 1 c := by
        rw [hc]; fun_prop
      have hcd : HasDerivAt c u 0 := by
        have h1 : HasDerivAt (fun t : ℝ => a * Real.sin (t / a)) 1 0 := by
          have := (((hasDerivAt_id (0 : ℝ)).div_const a).sin).const_mul a
          simpa [ha0.ne'] using this
        simpa only [one_smul] using (h1.smul_const u).const_add v
      refine ⟨ψ ∘ c, (hψC.comp_contDiff hcC hcV).contDiffOn, fun t _ => ?_, ?_, ?_⟩
      · exact ((hψim ▸ mem_image_of_mem ψ (hcV t)) : ψ (c t) ∈ W ∩ M).2
      · simp [hc]
      · exact hψd.comp_hasDerivAt_of_eq 0 hcd (by simp [hc])
  have hspan : Submodule.span ℝ (tangentSpace M (ψ v)) =
      LinearMap.range (L : Euclid d →ₗ[ℝ] Euclid P) := by
    rw [key, hrange, Submodule.span_eq]
  refine ⟨?_, ?_⟩
  · rw [hspan, ← hrange, key]
  · rw [hspan, LinearMap.finrank_range_of_inj (hψD v hvV), finrank_euclideanSpace_fin]

/-- **Approximate tangent planes of a carrier inside a `C¹` submanifold** (Simon Ch. 3,
Remark 1.5(2); used with Ch. 4, 2.6 for 7.3.3).  Let `R = (S, θ, ξ)` be an integer multiplicity
triple, `M` an embedded `C¹` `n`-dimensional submanifold, `IsOpen V` and `Hⁿ((S ∩ V) \ M) = 0`.
Then `TₓS = span TₓM` for `Hⁿ`-a.e. `x ∈ S ∩ V`.  For such `x` the field `orients` gives an
approximate tangent plane `Q` of `S` at `x` with `x ∈ M`, and the chosen plane is `Q`.  With a
chart `ψ` of `M` and `ψ(v) = x`, `M` is flat at `x` along `Dψ(v)(ℝⁿ)`; as `M ∪ Vᶜ` carries
`Hⁿ`-almost all of `S`, a bump at a point of `Q` off `Dψ(v)(ℝⁿ)` would have positive `Hⁿ⌞Q`
integral but vanishing blow-up integrals, so `Q ⊆ Dψ(v)(ℝⁿ)`.  Velocities of the curves
`ψ(v + h(t)a)` give `Dψ(v)(ℝⁿ) ⊆ TₓM`, and `dim Q = n = dim span TₓM`
(`idtp_ccd_sfv_span_tangentSpace_finrank`) forces `Q = span TₓM`. -/
theorem Submission.idtp_ccd_sfv_approxTangentPlane_eq_span_ae : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (M V : Set (Euclid P)), IsEmbeddedSubmanifold 1 n M → IsOpen V → μHE[n] ((R.carrier ∩ V) \ M) = 0 → ∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ V)), approxTangentPlane n R.carrier x = Submodule.span ℝ (tangentSpace M x) := by
  intro P n U R N O hN hO hnull
  set S := R.carrier with hSdef
  have hSO : MeasurableSet (S ∩ O) := R.measurableSet_carrier.inter hO.measurableSet
  -- `Hⁿ⌞(S ∩ O)`-a.e. `x` has an approximate tangent plane of `S` (field `orients`), lies in
  -- `S ∩ O`, and lies in `N` (as `Hⁿ((S ∩ O) \ N) = 0`)
  have h1 : ∀ᵐ x ∂(μHE[n].restrict (S ∩ O)), ∃ Q, HasApproximateTangentSpaceAt n S x Q :=
    (ae_restrict_of_ae_restrict_of_subset inter_subset_left R.orients).mono
      fun x ⟨Q, hQ, _⟩ => ⟨Q, hQ⟩
  have h2 : ∀ᵐ x ∂(μHE[n].restrict (S ∩ O)), x ∈ S ∩ O := ae_restrict_mem hSO
  have h3 : ∀ᵐ x ∂(μHE[n].restrict (S ∩ O)), x ∈ N := by
    rw [ae_iff, Measure.restrict_apply' hSO]
    refine measure_mono_null (fun y hy => ?_) hnull
    exact ⟨hy.2, hy.1⟩
  filter_upwards [h1, h2, h3] with x hx1 hx2 hxN
  obtain ⟨Q, hQ⟩ := hx1
  -- (a) the chosen plane is `Q` (Ch. 3, Remark 1.5(1))
  have hAQ : approxTangentPlane n S x = Q := by
    have h : ∃ Q', HasApproximateTangentSpaceAt n S x Q' := ⟨Q, hQ⟩
    unfold approxTangentPlane
    rw [dite_eq_left h]
    exact h.choose_spec.unique hQ
  -- (b) `Q ≤ T` whenever a set `N'` carrying `Hⁿ`-almost all of `S` is flat at `x` along `T`:
  -- for `q ∈ Q \ T` the bump `g = max(0, δ/2 − |· − q|)`, `δ = dist(q, T)`, has `∫_Q g dHⁿ > 0`,
  -- while `∫_{η_{x,r}(S)} g dHⁿ = 0` for all small `r`
  have hle : ∀ (N' : Set (Euclid P)) (T : Submodule ℝ (Euclid P)), μHE[n] (S \ N') = 0 →
      (∀ ε : ℝ, 0 < ε → ∃ ρ : ℝ, 0 < ρ ∧ ∀ z ∈ N', dist z x < ρ →
        ∃ t ∈ T, ‖z - x - t‖ ≤ ε * ‖z - x‖) → Q ≤ T := by
    intro N' T hnull' hflat q hq
    by_contra hqT
    -- `T` is closed, so `δ = dist(q, T) > 0`
    have hTc : IsClosed (T : Set (Euclid P)) := T.closed_of_finiteDimensional
    have hδ : 0 < infDist q (T : Set (Euclid P)) :=
      (hTc.notMem_iff_infDist_pos ⟨0, T.zero_mem⟩).1 hqT
    set δ := infDist q (T : Set (Euclid P)) with hδdef
    -- the bump `g = max(0, δ/2 − |· − q|)`, positive exactly on `B_{δ/2}(q)`
    set g : Euclid P → ℝ := fun y => max 0 (δ / 2 - ‖y - q‖) with hgdef
    have hgc : Continuous g :=
      continuous_const.max (continuous_const.sub (continuous_id.sub continuous_const).norm)
    have hg0 : 0 ≤ g := fun y => le_max_left _ _
    have hgsupp : ∀ y, g y ≠ 0 → ‖y - q‖ < δ / 2 := by
      intro y hy
      by_contra h
      have h' : δ / 2 ≤ ‖y - q‖ := not_lt.mp h
      apply hy
      exact max_eq_left (by linarith)
    have hgpos : ∀ y, ‖y - q‖ < δ / 2 → 0 < g y := fun y hy =>
      lt_max_of_lt_right (by linarith)
    have hgcs : HasCompactSupport g := by
      apply HasCompactSupport.intro (isCompact_closedBall q (δ / 2))
      intro y hy
      by_contra h
      apply hy
      rw [mem_closedBall, dist_eq_norm]
      exact (hgsupp y h).le
    let f : CompactlySupportedContinuousMap (Euclid P) ℝ := ⟨⟨g, hgc⟩, hgcs⟩
    -- `∫_Q g dHⁿ > 0`: `Hⁿ⌞Q` is regular with support `Q ∋ q`
    have hQn : Module.finrank ℝ Q = n := hQ.1
    have := Poincare.SimonGMT.Chapter03.regular_euclideanHausdorffMeasure_restrict_submodule hQn
    have hsupp :=
      Poincare.SimonGMT.Chapter03.support_euclideanHausdorffMeasure_restrict_submodule hQn
    have hint : Integrable g ((μHE[n] : Measure (Euclid P)).restrict (Q : Set (Euclid P))) :=
      hgc.integrable_of_hasCompactSupport hgcs
    have hpos : 0 < ∫ y in (Q : Set (Euclid P)), g y ∂μHE[n] := by
      rw [integral_pos_iff_support_of_nonneg hg0 hint]
      have hq' : q ∈ ((μHE[n] : Measure (Euclid P)).restrict (Q : Set (Euclid P))).support := by
        rw [hsupp]
        exact hq
      have hball : 0 < ((μHE[n] : Measure (Euclid P)).restrict (Q : Set (Euclid P)))
          (ball q (δ / 2)) :=
        (Measure.mem_support_iff_forall q).1 hq' _ (ball_mem_nhds q (by linarith))
      refine hball.trans_le (measure_mono ?_)
      intro y hy
      rw [mem_ball, dist_eq_norm] at hy
      exact (hgpos y hy).ne'
    -- constants: `ε (|q| + δ) = δ / 2`
    have hqδ : 0 < ‖q‖ + δ := by positivity
    set ε : ℝ := δ / (2 * (‖q‖ + δ)) with hεdef
    have hε : 0 < ε := by positivity
    have hεq : ε * (‖q‖ + δ) = δ / 2 := by
      rw [hεdef]
      field_simp
    obtain ⟨ρ, hρ, hflatρ⟩ := hflat ε hε
    -- `∫_{η_{x,r}(S)} g dHⁿ = 0` for `0 < r < ρ / (|q| + δ)`
    have hvan : ∀ r : ℝ, 0 < r → r < ρ / (‖q‖ + δ) →
        ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' S, f y ∂μHE[n] = 0 := by
      intro r hr hrρ
      -- `η_{x,r}(S \ N') = r⁻¹ (S \ N' − x)` is `Hⁿ`-null
      have hnull'' : μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' (S \ N')) = 0 := by
        have himg' : Poincare.SimonGMT.Chapter03.blowUpMap x r '' (S \ N') =
            (fun y => r⁻¹ • y) '' ((fun y => y - x) '' (S \ N')) := by
          rw [Set.image_image]
          rfl
        have hiso : Isometry (fun y : Euclid P => y - x) :=
          Isometry.of_dist_eq fun a b => dist_sub_right a b x
        rw [himg', Set.image_smul, Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hr.ne'),
          hiso.euclideanHausdorffMeasure_image, hnull', smul_zero]
      -- flatness: `g` vanishes on `η_{x,r}(S ∩ N')`
      have hsub : {y | g y ≠ 0} ∩ Poincare.SimonGMT.Chapter03.blowUpMap x r '' S ⊆
          Poincare.SimonGMT.Chapter03.blowUpMap x r '' (S \ N') := by
        rintro y ⟨hgy, z, hzS, rfl⟩
        refine ⟨z, ⟨hzS, fun hzN => ?_⟩, rfl⟩
        have hyq : ‖Poincare.SimonGMT.Chapter03.blowUpMap x r z - q‖ < δ / 2 := hgsupp _ hgy
        set y := Poincare.SimonGMT.Chapter03.blowUpMap x r z with hy
        have hy' : y = r⁻¹ • (z - x) := rfl
        have hzx : z - x = r • y := by
          rw [hy', smul_smul, mul_inv_cancel₀ hr.ne', one_smul]
        have hynorm : ‖y‖ < ‖q‖ + δ / 2 := by
          calc ‖y‖ = ‖(y - q) + q‖ := by rw [sub_add_cancel]
            _ ≤ ‖y - q‖ + ‖q‖ := norm_add_le _ _
            _ < δ / 2 + ‖q‖ := by linarith
            _ = ‖q‖ + δ / 2 := by ring
        have hzxn : ‖z - x‖ = r * ‖y‖ := by
          rw [hzx, norm_smul, Real.norm_of_nonneg hr.le]
        have hdist : dist z x < ρ := by
          rw [dist_eq_norm, hzxn]
          calc r * ‖y‖ ≤ r * (‖q‖ + δ) := by gcongr; linarith
            _ < ρ / (‖q‖ + δ) * (‖q‖ + δ) := by gcongr
            _ = ρ := by field_simp
        obtain ⟨t, htT, ht⟩ := hflatρ z hzN hdist
        have hrt : r⁻¹ • t ∈ T := T.smul_mem _ htT
        have hyt : y - r⁻¹ • t = r⁻¹ • (z - x - t) := by
          rw [hy']
          exact (smul_sub _ _ _).symm
        have hyt' : ‖y - r⁻¹ • t‖ ≤ ε * ‖y‖ := by
          rw [hyt, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hr.le)]
          calc r⁻¹ * ‖z - x - t‖ ≤ r⁻¹ * (ε * ‖z - x‖) := by gcongr
            _ = ε * ‖y‖ := by rw [hzxn]; field_simp
        have hle' : δ ≤ ‖q - r⁻¹ • t‖ := by
          rw [← dist_eq_norm]
          exact infDist_le_dist_of_mem hrt
        have h2' : ε * ‖y‖ ≤ δ / 2 := by
          rw [← hεq]
          gcongr
          linarith
        have hlt : ‖q - r⁻¹ • t‖ < δ := by
          calc ‖q - r⁻¹ • t‖ = ‖(q - y) + (y - r⁻¹ • t)‖ := by congr 1; abel
            _ ≤ ‖q - y‖ + ‖y - r⁻¹ • t‖ := norm_add_le _ _
            _ < δ / 2 + δ / 2 := by
              have h1' : ‖q - y‖ < δ / 2 := by rw [norm_sub_rev]; exact hyq
              linarith
            _ = δ := by ring
        linarith
      -- so `g = 0` a.e. for `Hⁿ⌞η_{x,r}(S)`, evaluated on the set `{g ≠ 0}`
      have hmeas : MeasurableSet {y | g y ≠ 0} :=
        (isOpen_ne_fun hgc continuous_const).measurableSet
      apply integral_eq_zero_of_ae
      rw [EventuallyEq, ae_iff]
      change (μHE[n].restrict (Poincare.SimonGMT.Chapter03.blowUpMap x r '' S)) {y | g y ≠ 0} = 0
      rw [Measure.restrict_apply hmeas]
      exact measure_mono_null hsub hnull''
    -- the blow-up integrals of `g` are eventually `0`, so their limit `∫_Q g dHⁿ` is `0`
    have hlim := hQ.2 f
    have hev : (fun r : ℝ => ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' S, f y ∂μHE[n])
        =ᶠ[𝓝[>] 0] fun _ => 0 := by
      have hpos' : 0 < ρ / (‖q‖ + δ) := by positivity
      filter_upwards [Ioo_mem_nhdsGT hpos'] with r hr
      exact hvan r hr.1 hr.2
    have hlim0 : Tendsto (fun r : ℝ => ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' S,
        f y ∂μHE[n]) (𝓝[>] 0) (𝓝 0) :=
      tendsto_const_nhds.congr' hev.symm
    have heq := tendsto_nhds_unique hlim hlim0
    have hzero : ∫ y in (Q : Set (Euclid P)), g y ∂μHE[n] = 0 := heq
    linarith
  -- a chart `ψ : Vc → W ∩ N` of `N` (Ch. 2, §4, (4.1)) and `v ∈ Vc` with `ψ v = x`
  obtain ⟨Vc, W, ψ, hVc, hW, hxW, hψ, hinj, himg, hprop, hDψ⟩ := hN x hxN
  obtain ⟨v, hv, rfl⟩ : x ∈ ψ '' Vc := by
    rw [himg]
    exact ⟨hxW, hxN⟩
  have hψ1 : ContDiffOn ℝ 1 ψ Vc := by exact_mod_cast hψ
  -- (c) `N` is flat at `ψ v` along `Dψ(v)(ℝⁿ)`: properness, continuity and injectivity of `ψ`
  -- force `z = ψ(β)` with `β` close to `v`, and the first-order expansion at `v` together with
  -- the coercivity `|h| ≤ K|Dψ(v)h|` absorbs the remainder
  have hflatN : ∀ ε : ℝ, 0 < ε → ∃ ρ : ℝ, 0 < ρ ∧ ∀ z ∈ N, dist z (ψ v) < ρ →
      ∃ h : Euclid n, ‖z - ψ v - fderiv ℝ ψ v h‖ ≤ ε * ‖z - ψ v‖ := by
    intro ε hε
    set L := fderiv ℝ ψ v with hLdef
    have hdiff : DifferentiableAt ℝ ψ v :=
      (hψ1.differentiableOn one_ne_zero).differentiableAt (hVc.mem_nhds hv)
    have hL : HasFDerivAt ψ L v := hdiff.hasFDerivAt
    have hcont : ContinuousOn ψ Vc := hψ1.continuousOn
    -- coercivity of the injective derivative
    obtain ⟨K, hKpos, hK⟩ := LinearMap.exists_antilipschitzWith (L : Euclid n →ₗ[ℝ] Euclid P)
      (LinearMap.ker_eq_bot.mpr (hDψ v hv))
    have hcoer : ∀ h : Euclid n, ‖h‖ ≤ K * ‖L h‖ := fun h =>
      ContinuousLinearMap.bound_of_antilipschitz L hK h
    have hK0 : (0 : ℝ) < K := by exact_mod_cast hKpos
    set η : ℝ := min (1 / (2 * K)) (ε / (2 * K)) with hηdef
    have hη : 0 < η := lt_min (by positivity) (by positivity)
    have hηK : η * K ≤ 1 / 2 := by
      calc η * K ≤ 1 / (2 * K) * K := by gcongr; exact min_le_left _ _
        _ = 1 / 2 := by field_simp
    have hηε : η * (2 * K) ≤ ε := by
      calc η * (2 * K) ≤ ε / (2 * K) * (2 * K) := by gcongr; exact min_le_right _ _
        _ = ε := by field_simp
    -- first-order expansion
    obtain ⟨σ, hσ, hσball⟩ := Metric.eventually_nhds_iff.1 (hL.isLittleO.bound hη)
    -- a compact set away from `v`
    obtain ⟨δ₁, hδ₁, hδ₁W⟩ := Metric.isOpen_iff.1 hW (ψ v) hxW
    set δ₀ : ℝ := δ₁ / 2 with hδ₀eq
    have hδ₀ : 0 < δ₀ := by positivity
    have hcbW : closedBall (ψ v) δ₀ ⊆ W := (closedBall_subset_ball (by linarith)).trans hδ₁W
    have hA : IsCompact (Vc ∩ ψ ⁻¹' closedBall (ψ v) δ₀) :=
      hprop _ hcbW (isCompact_closedBall _ _)
    set C := (Vc ∩ ψ ⁻¹' closedBall (ψ v) δ₀) \ ball v σ with hCdef
    have hC : IsCompact C := hA.diff isOpen_ball
    have hCV : C ⊆ Vc := fun β hβ => hβ.1.1
    -- positive separation on `C`
    obtain ⟨m, hm, hmC⟩ : ∃ m : ℝ, 0 < m ∧ ∀ β ∈ C, m ≤ ‖ψ β - ψ v‖ := by
      rcases C.eq_empty_or_nonempty with hCe | hCne
      · refine ⟨1, one_pos, fun β hβ => ?_⟩
        rw [hCe] at hβ
        exact hβ.elim
      · have hfc : ContinuousOn (fun β => ‖ψ β - ψ v‖) C :=
          ((hcont.mono hCV).sub continuousOn_const).norm
        obtain ⟨β₀, hβ₀C, hβ₀min⟩ := hC.exists_isMinOn hCne hfc
        refine ⟨‖ψ β₀ - ψ v‖, ?_, fun β hβ => (isMinOn_iff.mp hβ₀min) β hβ⟩
        rcases (norm_nonneg (ψ β₀ - ψ v)).lt_or_eq with hlt | heq
        · exact hlt
        · exfalso
          have h0 : ψ β₀ = ψ v := by
            have h' := heq.symm
            rwa [norm_eq_zero, sub_eq_zero] at h'
          have hβv := hinj (hCV hβ₀C) hv h0
          apply hβ₀C.2
          rw [hβv]
          exact mem_ball_self hσ
    refine ⟨min δ₀ m, lt_min hδ₀ hm, ?_⟩
    intro z hzN hzd
    have hzcb : z ∈ closedBall (ψ v) δ₀ := mem_closedBall.2 (hzd.trans_le (min_le_left _ _)).le
    have hzim : z ∈ ψ '' Vc := by
      rw [himg]
      exact ⟨hcbW hzcb, hzN⟩
    obtain ⟨β, hβV, rfl⟩ := hzim
    have hβA : β ∈ Vc ∩ ψ ⁻¹' closedBall (ψ v) δ₀ := ⟨hβV, hzcb⟩
    have hβσ : dist β v < σ := by
      by_contra hcon
      have hβC : β ∈ C := ⟨hβA, fun hb => hcon (mem_ball.1 hb)⟩
      have h1' := hmC β hβC
      rw [← dist_eq_norm] at h1'
      have h2' : min δ₀ m ≤ dist (ψ β) (ψ v) := (min_le_right _ _).trans h1'
      linarith
    refine ⟨β - v, ?_⟩
    have hest : ‖ψ β - ψ v - L (β - v)‖ ≤ η * ‖β - v‖ := hσball hβσ
    have hLh : ‖L (β - v)‖ ≤ ‖ψ β - ψ v‖ + η * ‖β - v‖ := by
      calc ‖L (β - v)‖ = ‖(ψ β - ψ v) - (ψ β - ψ v - L (β - v))‖ := by congr 1; abel
        _ ≤ ‖ψ β - ψ v‖ + ‖ψ β - ψ v - L (β - v)‖ := norm_sub_le _ _
        _ ≤ ‖ψ β - ψ v‖ + η * ‖β - v‖ := by gcongr
    have hh : ‖β - v‖ ≤ 2 * K * ‖ψ β - ψ v‖ := by
      have h2' : ‖β - v‖ ≤ K * ‖ψ β - ψ v‖ + (η * K) * ‖β - v‖ := by
        calc ‖β - v‖ ≤ K * ‖L (β - v)‖ := hcoer (β - v)
          _ ≤ K * (‖ψ β - ψ v‖ + η * ‖β - v‖) := by gcongr
          _ = K * ‖ψ β - ψ v‖ + (η * K) * ‖β - v‖ := by ring
      have h3' : (η * K) * ‖β - v‖ ≤ 1 / 2 * ‖β - v‖ := by gcongr
      linarith
    calc ‖ψ β - ψ v - L (β - v)‖ ≤ η * ‖β - v‖ := hest
      _ ≤ η * (2 * K * ‖ψ β - ψ v‖) := by gcongr
      _ = (η * (2 * K)) * ‖ψ β - ψ v‖ := by ring
      _ ≤ ε * ‖ψ β - ψ v‖ := by gcongr
  -- (d) `Dψ(v)(ℝⁿ) ⊆ T_{ψ v}N` (Ch. 2, §4, (4.3)): `Dψ(v) a` is the velocity at `0` of the
  -- `C¹` curve `t ↦ ψ(v + h(t) a)` in `N`, `h(t) = t / (1 + t² / c²)`, `c = ρ₀ / |a|`
  have hrange : ∀ a : Euclid n, fderiv ℝ ψ v a ∈ tangentSpace N (ψ v) := by
    intro a
    have hψv : HasFDerivAt ψ (fderiv ℝ ψ v) v :=
      ((hψ1.differentiableOn one_ne_zero).differentiableAt (hVc.mem_nhds hv)).hasFDerivAt
    have hVN : ψ '' Vc ⊆ N := himg ▸ inter_subset_right
    by_cases ha : a = 0
    · -- `a = 0`: the constant curve `ψ(v)` has velocity `0 = Dψ(v) 0`
      subst ha
      refine ⟨fun _ => ψ v, contDiffOn_const, fun _ _ => hVN (mem_image_of_mem ψ hv), rfl, ?_⟩
      simpa using hasDerivAt_const (0 : ℝ) (ψ v)
    · obtain ⟨ρ₀, hρ₀, hball⟩ := Metric.isOpen_iff.mp hVc v hv
      have ha' : 0 < ‖a‖ := norm_pos_iff.mpr ha
      set c : ℝ := ρ₀ / ‖a‖ with hc_def
      have hc : 0 < c := div_pos hρ₀ ha'
      have hden : ∀ t : ℝ, 0 < 1 + t ^ 2 / c ^ 2 := fun t => by positivity
      set h : ℝ → ℝ := fun t => t / (1 + t ^ 2 / c ^ 2) with hh_def
      -- `h` is smooth, `h'(0) = 1` and `|h| ≤ c / 2`
      have h_cd : ContDiff ℝ 1 h :=
        contDiff_id.div (contDiff_const.add ((contDiff_id.pow 2).div_const _))
          fun t => (hden t).ne'
      have h_deriv : HasDerivAt h 1 0 := by
        have := hasDerivAt_id' (x := (0 : ℝ)) |>.fun_div
          (((hasDerivAt_id' (x := (0 : ℝ))).fun_pow 2).div_const (c ^ 2) |>.const_add 1)
          (hden 0).ne'
        convert this using 1
        simp
      have h_bd : ∀ t, |h t| ≤ c / 2 := by
        intro t
        rw [hh_def, abs_div, abs_of_pos (hden t), div_le_iff₀ (hden t)]
        have h1' : c / 2 * (1 + t ^ 2 / c ^ 2) = (c ^ 2 + |t| ^ 2) / (2 * c) := by
          rw [sq_abs]; field_simp
        rw [h1', le_div_iff₀ (by positivity)]
        nlinarith [sq_nonneg (c - |t|)]
      -- `β` stays in `B_{ρ₀}(v) ⊆ Vc`, `β(0) = v` and `β'(0) = a`
      set β : ℝ → Euclid n := fun t => v + h t • a with hβ_def
      have hβV : ∀ t, β t ∈ Vc := fun t => hball <| by
        rw [Metric.mem_ball, dist_eq_norm, hβ_def]
        simp only [add_sub_cancel_left, norm_smul, Real.norm_eq_abs]
        calc |h t| * ‖a‖ ≤ c / 2 * ‖a‖ := by gcongr; exact h_bd t
          _ = ρ₀ / 2 := by rw [hc_def]; field_simp
          _ < ρ₀ := by linarith
      have hβ0 : β 0 = v := by simp [hβ_def, hh_def]
      have hβ_cd : ContDiff ℝ 1 β := contDiff_const.add (h_cd.smul contDiff_const)
      have hβ_deriv : HasDerivAt β a 0 := by
        have := HasDerivAt.const_add v (h_deriv.smul_const a)
        rwa [one_smul] at this
      -- `γ = ψ ∘ β` is `C¹` on `(-1, 1)`, lies in `ψ(Vc) ⊆ N`, and `γ'(0) = Dψ(v) a`
      refine ⟨ψ ∘ β, hψ1.comp hβ_cd.contDiffOn fun t _ => hβV t,
        fun t _ => hVN (mem_image_of_mem ψ (hβV t)), by simp [hβ0], ?_⟩
      exact hψv.comp_hasDerivAt_of_eq 0 hβ_deriv hβ0.symm
  -- (e) localize: `N ∪ Oᶜ` carries `Hⁿ`-almost all of `S` and is flat at `ψ v` along
  -- `Dψ(v)(ℝⁿ)`, since `B_s(ψ v) ⊆ O`; so `Q ≤ Dψ(v)(ℝⁿ) ≤ span T_{ψ v}N`
  obtain ⟨s, hs, hsO⟩ := Metric.isOpen_iff.mp hO (ψ v) hx2.2
  have hQT : Q ≤ LinearMap.range (fderiv ℝ ψ v : Euclid n →ₗ[ℝ] Euclid P) := by
    apply hle (N ∪ Oᶜ)
    · refine measure_mono_null (fun y hy => ?_) hnull
      simp only [Set.mem_sdiff, mem_union, mem_compl_iff, not_or, not_not] at hy
      exact ⟨⟨hy.1, hy.2.2⟩, hy.2.1⟩
    · intro ε hε
      obtain ⟨ρ, hρ, hρN⟩ := hflatN ε hε
      refine ⟨min ρ s, lt_min hρ hs, fun z hz hzd => ?_⟩
      have hzN : z ∈ N := by
        rcases hz with hz | hz
        · exact hz
        · exact absurd (hsO (mem_ball.2 (hzd.trans_le (min_le_right _ _)))) hz
      obtain ⟨h, hh⟩ := hρN z hzN (hzd.trans_le (min_le_left _ _))
      exact ⟨_, LinearMap.mem_range_self _ h, hh⟩
  have hTspan : LinearMap.range (fderiv ℝ ψ v : Euclid n →ₗ[ℝ] Euclid P) ≤
      Submodule.span ℝ (tangentSpace N (ψ v)) := by
    intro y hy
    obtain ⟨a, rfl⟩ := LinearMap.mem_range.mp hy
    exact Submodule.subset_span (hrange a)
  -- (f) `dim Q = n = dim span T_{ψ v}N` (sibling `tangent_space_dim`), so `Q = span T_{ψ v}N`
  rw [hAQ]
  exact Submodule.eq_of_le_of_finrank_eq (hQT.trans hTspan)
    (by rw [hQ.1, (Submission.idtp_ccd_sfv_span_tangentSpace_finrank P n N (ψ v) hN hxN).2])

/-- **First variation of a constant-density sheet** (Simon Ch. 4, 2.2–2.3, for the varifold
`v(M, θ)`; step 6(b) and the first equality of step 9 of the parent proof).  Let `T = τ(S, θ, ξ)`
in the open set `U`, `B = B_ρ(p) ⊆ U`, `k ≥ 1`, `M` an embedded `C¹` `n`-submanifold with
`spt T ∩ B = M ∩ B`, and `Θⁿ(μ_T, y) = k` at every `y ∈ spt T ∩ B`.  Then every `C¹` field `X`
with compact support in `B` has `δV(X) = k ∫_{M ∩ B} tr(p_{TₓM} ∘ DX(x)) dHⁿ(x)`.
* `(S ∩ B) ∖ M` is `Hⁿ`-null.  Its points lie off `spt T`, hence in the open zero region of `T`.
  A ball `B_r(x)` there misses `spt T`, so `idtp_ccd_sfv_mult_ae_eq_density` with density `0`
  gives `θ = 0` a.e. on `S ∩ B_r(x)`; as `θ ≥ 1` on `S`, `Hⁿ(S ∩ B_r(x)) = 0`.
* `(M ∩ B) ∖ S = (spt T ∩ B) ∖ S` is `Hⁿ`-null (`idtp_ccd_sfv_support_sdiff_carrier_null`).
* `θ = k` (`idtp_ccd_sfv_mult_ae_eq_density`) and `TₓS = span TₓM`
  (`idtp_ccd_sfv_approxTangentPlane_eq_span_ae`) hold `Hⁿ`-a.e. on `S ∩ B`.
* `DX = 0` off `spt X ⊆ B`, so `δV(X) = ∫_{S ∩ B} θ div_S X dHⁿ = k ∫_{S ∩ B} tr(p_{TₓM} DX) dHⁿ`,
  and `S ∩ B = M ∩ B` up to an `Hⁿ`-null set. -/
theorem Submission.idtp_ccd_sheet_first_variation : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n) (M : Set (Euclid P)) (p : Euclid P) (ρ : ℝ) (k : ℕ), IsOpen U → R.Represents T → ball p ρ ⊆ U → 1 ≤ k → IsEmbeddedSubmanifold 1 n M → T.support ∩ ball p ρ = M ∩ ball p ρ → (∀ y ∈ T.support, y ∈ ball p ρ → HasMassDensity T y k) → ∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ ball p ρ → R.firstVariation X = (k : ℝ) * ∫ x in M ∩ ball p ρ, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ X x).toLinearMap) ∂μHE[n] := by
  intro P n U T R M p ρ k hU hRT hBU hk hM hsupp hdens X _ _ hXB
  have hS : MeasurableSet R.carrier := R.measurableSet_carrier
  -- Step 2: `(S ∩ B) \ M` is `Hⁿ`-null.  Its points lie off `spt T`, so in the open zero region
  -- of `T`.  A ball `B_r(x)` there misses `spt T`, so `idtp_ccd_sfv_mult_ae_eq_density` applies
  -- vacuously with `k = 0`: `θ = 0` a.e. on `S ∩ B_r(x)`, and `θ ≥ 1` on `S` makes this null.
  have hSM : μHE[n] ((R.carrier ∩ ball p ρ) \ M) = 0 := by
    refine measure_null_of_locally_null _ fun x hx => ?_
    have hxz : x ∈ T.zeroRegion := by
      by_contra hxz
      have hxT : x ∈ T.support ∩ ball p ρ :=
        ⟨mem_sdiff_of_mem (R.carrier_subset hx.1.1) hxz, hx.1.2⟩
      rw [hsupp] at hxT
      exact hx.2 hxT.1
    obtain ⟨r, hr, hrz⟩ := Metric.isOpen_iff.1 T.isOpen_zeroRegion x hxz
    have h0 := (Submission.idtp_ccd_sfv_mult_ae_eq_density P n U T R x r 0 hU hRT
      fun y hy hyr => absurd (hrz hyr) hy.2).2
    have hfalse : ∀ᵐ y ∂(μHE[n].restrict (R.carrier ∩ ball x r)), False := by
      filter_upwards [h0, ae_restrict_mem (hS.inter isOpen_ball.measurableSet)] with y hy hyS
      exact (R.mult_pos y hyS.1).ne' hy
    have hnull : μHE[n] (R.carrier ∩ ball x r) = 0 :=
      Measure.restrict_eq_zero.1 (ae_eq_bot.1 (eventually_false_iff_eq_bot.1 hfalse))
    refine ⟨((R.carrier ∩ ball p ρ) \ M) ∩ ball x r,
      inter_mem_nhdsWithin _ (isOpen_ball.mem_nhds (mem_ball_self hr)),
      measure_mono_null (fun y hy => ?_) hnull⟩
    exact ⟨hy.1.1.1, hy.2⟩
  -- Step 4: `(M ∩ B) \ S` is `Hⁿ`-null, as `spt T ∩ B = M ∩ B`; so `S ∩ B = M ∩ B` a.e.
  have hMS : μHE[n] ((M ∩ ball p ρ) \ R.carrier) = 0 := by
    rw [← hsupp]
    exact Submission.idtp_ccd_sfv_support_sdiff_carrier_null P n U T R p ρ k hU hRT hBU hk hdens
  have hSMae : R.carrier ∩ ball p ρ =ᵐ[μHE[n]] M ∩ ball p ρ := by
    refine ae_eq_set.2 ⟨measure_mono_null (fun y hy => ?_) hSM,
      measure_mono_null (fun y hy => ?_) hMS⟩
    · exact ⟨hy.1, fun hyM => hy.2 ⟨hyM, hy.1.2⟩⟩
    · exact ⟨hy.1, fun hyS => hy.2 ⟨hyS, hy.1.2⟩⟩
  -- Steps 3 and 5: `θ = k` and `TₓS = span TₓM` for `Hⁿ`-a.e. `x ∈ S ∩ B`.
  have hθ := (Submission.idtp_ccd_sfv_mult_ae_eq_density P n U T R p ρ k hU hRT hdens).2
  have hT := Submission.idtp_ccd_sfv_approxTangentPlane_eq_span_ae P n U R M (ball p ρ) hM
    isOpen_ball hSM
  -- Step 6: the integrand vanishes off `tsupport X ⊆ B`.
  have hS0 : ∀ x ∈ R.carrier \ (R.carrier ∩ ball p ρ),
      (R.mult x : ℝ) * tangentialDivergence n R.carrier X x = 0 := by
    intro x hx
    have hxX : x ∉ tsupport X := fun h => hx.2 ⟨hx.1, hXB h⟩
    simp [tangentialDivergence, fderiv_of_notMem_tsupport ℝ hxX]
  -- Step 7: evaluation.
  calc R.firstVariation X
      = ∫ x in R.carrier ∩ ball p ρ, (R.mult x : ℝ) * tangentialDivergence n R.carrier X x
          ∂μHE[n] :=
        setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hS inter_subset_left hS0
    _ = ∫ x in R.carrier ∩ ball p ρ, (k : ℝ) * LinearMap.trace ℝ (Euclid P)
          ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
            (fderiv ℝ X x).toLinearMap) ∂μHE[n] := by
        refine integral_congr_ae ?_
        filter_upwards [hT, hθ] with x hxT hxθ
        simp only [tangentialDivergence, hxT, hxθ]
    _ = (k : ℝ) * ∫ x in R.carrier ∩ ball p ρ, LinearMap.trace ℝ (Euclid P)
          ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
            (fderiv ℝ X x).toLinearMap) ∂μHE[n] :=
        integral_const_mul _ _
    _ = _ := by rw [setIntegral_congr_set hSMae]
/-- **Dilation invariance of the support of a cone** (preliminary (K) of the proof that a cone of
constant density is planar).  If `C ∈ 𝒟ₙ(ℝᴾ)` is a cone and `t > 0`, then `t x ∈ spt C` for every
`x ∈ spt C`.  By contraposition: if `t x` lies in an open `W` with compact closure on which `C`
vanishes, then `x` lies in `W' = {y : t y ∈ W}`, which is open with closure inside the compact set
`t⁻¹ W̄`, and `C` vanishes on `W'`: for `spt ω ⊆ W'` the cone identity gives
`C(ω) = η_{0,t#}C(ω) = C(η_{0,t}^# ω)`, and `spt η_{0,t}^# ω ⊆ {z : t⁻¹ z ∈ spt ω} ⊆ W`.  The
integer multiplicity hypothesis is not needed. -/
theorem Submission.idtp_ccd_cone_support_smul : ∀ (P n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n), IsIntegerMultiplicity C → IsConeCurrent C → ∀ t : ℝ, 0 < t → ∀ x ∈ C.support, t • x ∈ C.support := by
  intro P n C _ hC t ht x hx
  -- `spt C = ℝᴾ \ zeroRegion C`, so it suffices that `t x ∈ zeroRegion C → x ∈ zeroRegion C`
  simp only [GeometricCurrentOn.support, Set.mem_sdiff, mem_univ, true_and] at hx ⊢
  intro htx
  apply hx
  obtain ⟨W, ⟨hWo, hWc, -, hWv⟩, htxW⟩ := mem_sUnion.1 htx
  -- `x` lies in `W' = {y : t y ∈ W}`
  refine mem_sUnion.2 ⟨(fun y => t • y) ⁻¹' W, ⟨?_, ?_, subset_univ _, ?_⟩, htxW⟩
  · -- `W'` is open
    exact hWo.preimage (continuous_const_smul t)
  · -- `closure W'` is closed in the compact set `{y : t y ∈ closure W} = t⁻¹ closure W`
    have hK : IsCompact ((fun y : Euclid P => t • y) ⁻¹' closure W) := by
      rw [preimage_smul₀ ht.ne']
      exact hWc.smul _
    exact hK.of_isClosed_subset isClosed_closure
      (closure_minimal (preimage_mono subset_closure)
        (isClosed_closure.preimage (continuous_const_smul t)))
  · -- `C` vanishes on `W'`: `C(ω) = η_{0,t#}C(ω) = C(η_{0,t}^# ω)`, as `η_{0,t}(ℝᴾ) = ℝᴾ`
    intro ω hω
    rw [← hC t ht ω]
    have hdom : IsTestForm (ω : DifferentialForm (Euclid P) n) ∧
        tsupport (ω : DifferentialForm (Euclid P) n) ⊆ dilation 0 t '' univ := by
      refine ⟨ω.property.1, fun z _ => ⟨t • z, mem_univ _, ?_⟩⟩
      simp [dilation, dilationCLM, ht.ne']
    rw [currentEval, dite_eq_left hdom]
    unfold blowUp
    rw [GeometricCurrentOn.affinePushforward_apply, GeometricCurrentOn.restrictDomain_apply]
    apply hWv
    rw [testFormOnInclusion_coe, affinePullbackTestOn_coe]
    -- `z ∈ spt η_{0,t}^# ω` gives `t⁻¹ z ∈ spt ω ⊆ W'`, i.e. `z = t (t⁻¹ z) ∈ W`
    refine (tsupport_affinePullbackForm_subset _ _ _).trans fun z hz => ?_
    simpa [dilationCLM, ht.ne'] using hω hz
/-- **Area formula on the cone sheet** (step 9 of the parent proof; Simon Ch. 2, §3).  On
`R = (r₀ − s, r₀ + s) × (−s, s)` the sibling `cone_map` shows that `G(t, α) = t γ(α)` is injective
on `R` with injective derivative, `∂₁G = γ(α)` and `∂₂G = t γ′(α)`.  The sibling `prod_area` then
gives `∫_{G(R)} h dH² = ∫_R √(‖∂₁G‖² ‖∂₂G‖² − ⟨∂₁G, ∂₂G⟩²) h(G)`.  Since `‖γ‖ = 1`, `⟨γ, γ′⟩ = 0`
and `t > r₀ − s > 0`, the radicand is `(t ‖γ′(α)‖)²`, so the Jacobian is `t ‖γ′(α)‖`. -/
theorem Submission.idtp_ccd_scsp_cone_area : ∀ (P : ℕ) (r₀ s : ℝ) (γ : ℝ → Euclid P) (h : Euclid P → ℝ), 0 < s → s < r₀ → ContDiffOn ℝ 1 γ (Ioo (-s) s) → InjOn γ (Ioo (-s) s) → (∀ α ∈ Ioo (-s) s, ‖γ α‖ = 1 ∧ inner ℝ (γ α) (deriv γ α) = 0 ∧ deriv γ α ≠ 0) → ∫ x in (fun q : ℝ × ℝ => q.1 • γ q.2) '' (Ioo (r₀ - s) (r₀ + s) ×ˢ Ioo (-s) s), h x ∂μHE[2] = ∫ q in Ioo (r₀ - s) (r₀ + s) ×ˢ Ioo (-s) s, q.1 * ‖deriv γ q.2‖ * h (q.1 • γ q.2) := by
  intro P r₀ s γ h hs hsr hγ hγinj hγ'
  obtain ⟨hinj, hreg⟩ :=
    Submission.idtp_ccd_scsp_ca_cone_map_regular P r₀ s γ hs hsr hγ hγinj hγ'
  have hR : MeasurableSet (Ioo (r₀ - s) (r₀ + s) ×ˢ Ioo (-s) s) :=
    measurableSet_Ioo.prod measurableSet_Ioo
  refine (Submission.idtp_ccd_scsp_ca_prod_area_formula P (fun q : ℝ × ℝ => q.1 • γ q.2) _ h hR
    (fun z hz => (hreg z hz).1) (fun z hz => (hreg z hz).2.1) hinj).trans
    (setIntegral_congr_fun hR fun z hz => ?_)
  -- `∂₁G = γ(α)` and `∂₂G = t γ′(α)`, with `‖γ(α)‖ = 1`, `⟨γ(α), γ′(α)⟩ = 0` and `t > 0`
  obtain ⟨-, -, h10, h01⟩ := hreg z hz
  obtain ⟨hnorm, horth, -⟩ := hγ' z.2 hz.2
  have hz1 : 0 < z.1 := by linarith [hz.1.1]
  have hJ : (1 : ℝ) ^ 2 * (z.1 * ‖deriv γ z.2‖) ^ 2 - (z.1 * 0) ^ 2 =
      (z.1 * ‖deriv γ z.2‖) ^ 2 := by ring
  rw [h10, h01, hnorm, norm_smul, Real.norm_eq_abs, abs_of_pos hz1, real_inner_smul_right, horth,
    hJ, Real.sqrt_sq (mul_nonneg hz1.le (norm_nonneg _))]
/-- **Great-circle arc** (step 11 of the parent proof: Cauchy–Schwarz and Bessel, then the polar
form).  Put `x = ⟨γ, u⟩ > 0`, `y = ⟨γ, e⟩`, `q = x² + y²` and `w = x e − y u`.  The sibling
`angle_curve` gives `⟨w, γ′⟩ = x ⟨γ′, e⟩ − y ⟨γ′, u⟩ = q`, and orthonormality gives `‖w‖² = q`, so
Cauchy–Schwarz with `‖γ′‖ = q` yields `‖w‖ ≥ 1`, i.e. `q ≥ 1`.  Bessel:
`‖γ − (x u + y e)‖² = 1 − q ≥ 0`, so `q = 1` and `γ = x u + y e`.  Finally `α = arctan (y / x)`
with `x > 0` and `√(1 + (y / x)²) = 1 / x` give `cos α = x` and `sin α = y`. -/
theorem Submission.idtp_ccd_scsp_arc_planarity : ∀ (P : ℕ) (u e : Euclid P) (s : ℝ) (γ : ℝ → Euclid P), ‖u‖ = 1 → ‖e‖ = 1 → inner ℝ u e = 0 → ContDiffOn ℝ 1 γ (Ioo (-s) s) → (∀ α ∈ Ioo (-s) s, ‖γ α‖ = 1 ∧ 0 < inner ℝ (γ α) u ∧ Real.arctan (inner ℝ (γ α) e / inner ℝ (γ α) u) = α) → (∀ α ∈ Ioo (-s) s, ‖deriv γ α‖ = inner ℝ (γ α) u ^ 2 + inner ℝ (γ α) e ^ 2) → ∀ α ∈ Ioo (-s) s, γ α = Real.cos α • u + Real.sin α • e := by
  intro P u e s γ hu he hue hγ hcurve hspeed α hα
  obtain ⟨hnorm, hx, harc⟩ := hcurve α hα
  obtain ⟨-, hrot, -⟩ := Submission.idtp_ccd_scsp_angle_curve P u e s γ hγ hcurve α hα
  have heu : inner ℝ e u = (0 : ℝ) := by rw [real_inner_comm]; exact hue
  -- pointwise statement for `g = γ(α)`, `d = γ′(α)`, `x = ⟨g, u⟩`, `y = ⟨g, e⟩`
  suffices key : ∀ (g d : Euclid P) (x y : ℝ), ‖g‖ = 1 → inner ℝ g u = x → inner ℝ g e = y →
      0 < x → x * inner ℝ d e - y * inner ℝ d u = x ^ 2 + y ^ 2 → ‖d‖ = x ^ 2 + y ^ 2 →
      g = Real.cos (Real.arctan (y / x)) • u + Real.sin (Real.arctan (y / x)) • e by
    have h := key (γ α) (deriv γ α) _ _ hnorm rfl rfl hx hrot (hspeed α hα)
    rwa [harc] at h
  intro g d x y hg hgx hgy hx hrot hd
  have hq : 0 < x ^ 2 + y ^ 2 := by positivity
  -- `w = x e − y u` has `⟨w, d⟩ = q` (the angle identity) and `‖w‖² = q` (orthonormality)
  have hwd : inner ℝ (x • e - y • u) d = x ^ 2 + y ^ 2 := by
    rw [inner_sub_left, real_inner_smul_left, real_inner_smul_left, real_inner_comm d e,
      real_inner_comm d u]
    exact hrot
  have hw : ‖x • e - y • u‖ ^ 2 = x ^ 2 + y ^ 2 := by
    rw [norm_sub_sq_real, real_inner_smul_left, real_inner_smul_right, heu, norm_smul, norm_smul,
      he, hu, Real.norm_eq_abs, Real.norm_eq_abs, mul_one, mul_one, sq_abs, sq_abs]
    ring
  -- Cauchy–Schwarz: `q = ⟨w, d⟩ ≤ ‖w‖ ‖d‖ = ‖w‖ q`, so `‖w‖ ≥ 1` and `q = ‖w‖² ≥ 1`
  have hw1 : 1 ≤ ‖x • e - y • u‖ := by
    refine (le_mul_iff_one_le_left hq).mp ?_
    calc x ^ 2 + y ^ 2 = inner ℝ (x • e - y • u) d := hwd.symm
      _ ≤ ‖x • e - y • u‖ * ‖d‖ := real_inner_le_norm _ _
      _ = ‖x • e - y • u‖ * (x ^ 2 + y ^ 2) := by rw [hd]
  have hq1 : 1 ≤ x ^ 2 + y ^ 2 := by nlinarith
  -- Bessel: `‖g − (x u + y e)‖² = 1 − q ≥ 0`, so `q = 1` and `g = x u + y e`
  have hb : ‖g - (x • u + y • e)‖ ^ 2 = 1 - (x ^ 2 + y ^ 2) := by
    simp only [norm_sub_sq_real, norm_add_sq_real, inner_add_right, real_inner_smul_left,
      real_inner_smul_right, hue, hgx, hgy, hg, norm_smul, hu, he, Real.norm_eq_abs, mul_one,
      sq_abs]
    ring
  have hq' : x ^ 2 + y ^ 2 = 1 :=
    le_antisymm (by linarith [sq_nonneg ‖g - (x • u + y • e)‖]) hq1
  have hgxy : g = x • u + y • e := by
    rw [← sub_eq_zero, ← norm_eq_zero, ← sq_eq_zero_iff, hb, hq', sub_self]
  -- polar form: `√(1 + (y / x)²) = 1 / x`, so `arctan (y / x)` has cosine `x` and sine `y`
  have hsqrt : √(1 + (y / x) ^ 2) = 1 / x := by
    rw [show 1 + (y / x) ^ 2 = (1 / x) ^ 2 by field_simp; linarith]
    exact Real.sqrt_sq (by positivity)
  rw [Real.cos_arctan, Real.sin_arctan, hsqrt, one_div_one_div, div_div_eq_mul_div, div_one,
    div_mul_cancel₀ y hx.ne', hgxy]

/-- **Stationary cone sheets are planar** (steps 1–12 of the parent proof).  Write `p = r₀ u` with
`r₀ = ‖p‖ > 0` and `‖u‖ = 1`.  The sibling `cone_chart` gives a unit `e ⊥ u`, an open `N ∋ p`
inside `B_ρ(p)` and a unit curve `γ` with `γ(0) = u`, `γ′(0) = e`, `M ∩ N = {t γ(α) : (t, α) ∈ R}`
for `R = (r₀ − s, r₀ + s) × (−s, s)` and `T_{tγ(α)}M = span {γ(α), γ′(α)}`.  For `tsupport X ⊆ N`
the integrand vanishes off `N`, so stationarity on `M ∩ B_ρ(p)` is stationarity on `M ∩ N`, and
`cone_conservation` gives `∫ φ′ κ = 0` for `κ = (⟨γ, u⟩² + ⟨γ, e⟩²) / ‖γ′‖`, continuous because
`γ′ ≠ 0` (`angle_curve`).  By `du_bois_reymond` `κ` is constant, so `κ ≡ κ(0) = 1`, i.e.
`‖γ′‖ = ⟨γ, u⟩² + ⟨γ, e⟩²`; `arc_planarity` gives `γ(α) = cos α u + sin α e`, and `sector_plane`
gives `δ > 0` with `M ∩ B_δ(p) = span {u, e} ∩ B_δ(p)`.  Finally `span {u, e} = T_pM`, which is
`2`-dimensional and contains `p` (`tangent_plane_mem`). -/
theorem Submission.idtp_ccd_stationary_cone_sheet_planar : ∀ (P : ℕ) (M : Set (Euclid P)) (p : Euclid P) (ρ : ℝ), IsEmbeddedSubmanifold 1 2 M → p ∈ M → p ≠ 0 → 0 < ρ → (∀ x ∈ M ∩ ball p ρ, ∀ t : ℝ, 0 < t → t • x ∈ ball p ρ → t • x ∈ M) → (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ ball p ρ → ∫ x in M ∩ ball p ρ, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ X x).toLinearMap) ∂μHE[2] = 0) → ∃ (δ : ℝ) (Q : Submodule ℝ (Euclid P)), 0 < δ ∧ Module.finrank ℝ Q = 2 ∧ p ∈ Q ∧ M ∩ ball p δ = (Q : Set (Euclid P)) ∩ ball p δ := by
  intro P M p ρ hM hp hp0 hρ hcone hstat
  -- polar form `p = r₀ u` with `r₀ = ‖p‖ > 0` and `‖u‖ = 1`
  obtain ⟨u, r₀, hu, hr₀, rfl⟩ : ∃ (u : Euclid P) (r₀ : ℝ), ‖u‖ = 1 ∧ 0 < r₀ ∧ r₀ • u = p :=
    ⟨‖p‖⁻¹ • p, ‖p‖,
      by rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ (norm_ne_zero_iff.mpr hp0)],
      norm_pos_iff.mpr hp0, by rw [smul_smul, mul_inv_cancel₀ (norm_ne_zero_iff.mpr hp0), one_smul]⟩
  -- the cone sheet `M ∩ N = {t γ(α)}` with `T_{tγ(α)}M = span {γ(α), γ′(α)}`
  obtain ⟨e, s, N, γ, he, hue, hs, hsr, hN, hpN, hNball, hNu, hγ, hγ0, hγ'0, hcurve, hMN, hTM⟩ :=
    Submission.idtp_ccd_scsp_cone_chart P M u r₀ ρ hM hu hr₀ hp hρ hcone
  have hr₀R : r₀ ∈ Ioo (r₀ - s) (r₀ + s) := ⟨by linarith, by linarith⟩
  have h0 : (0 : ℝ) ∈ Ioo (-s) s := ⟨by linarith, hs⟩
  have hRN : ∀ t ∈ Ioo (r₀ - s) (r₀ + s), ∀ α ∈ Ioo (-s) s, t • γ α ∈ N := by
    intro t ht α hα
    have h : t • γ α ∈ M ∩ N := by rw [hMN]; exact ⟨(t, α), ⟨ht, hα⟩, rfl⟩
    exact h.2
  -- stationarity on `M ∩ B_ρ(p)` restricts to `M ∩ N`: the integrand vanishes off `tsupport X ⊆ N`
  have hstatN : ∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X →
      tsupport X ⊆ N → ∫ x in (fun q : ℝ × ℝ => q.1 • γ q.2) '' (Ioo (r₀ - s) (r₀ + s) ×ˢ Ioo (-s) s),
        LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
          (fderiv ℝ X x).toLinearMap) ∂μHE[2] = 0 := by
    intro X hX hXc hXN
    have hf : ∀ x, x ∉ N → LinearMap.trace ℝ (Euclid P)
        ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
          (fderiv ℝ X x).toLinearMap) = 0 := by
      intro x hx
      rw [fderiv_of_notMem_tsupport ℝ fun h => hx (hXN h)]
      simp
    have hset : N ∩ (M ∩ ball (r₀ • u) ρ) = M ∩ N := by
      ext x
      exact ⟨fun h => ⟨h.2.1, h.1⟩, fun h => ⟨h.2, h.1, hNball h.2⟩⟩
    rw [← hMN, ← hset, ← Measure.restrict_restrict hN.measurableSet,
      setIntegral_eq_integral_of_forall_compl_eq_zero hf]
    exact hstat X hX hXc (hXN.trans hNball)
  -- conservation law `∫ φ′ κ = 0` for `κ = (⟨γ, u⟩² + ⟨γ, e⟩²) / ‖γ′‖`
  have hκ := Submission.idtp_ccd_scsp_cone_conservation P u e r₀ s N γ
    (fun x => Submodule.span ℝ (tangentSpace M x)) hu he hue hs hsr hN hNu hγ hcurve
    (fun t ht α hα => ⟨hRN t ht α hα, hTM t ht α hα⟩) hstatN
  have hγ'ne : ∀ α ∈ Ioo (-s) s, deriv γ α ≠ 0 := fun α hα =>
    (Submission.idtp_ccd_scsp_angle_curve P u e s γ hγ hcurve α hα).2.2
  have hcont : ContinuousOn
      (fun α => (inner ℝ (γ α) u ^ 2 + inner ℝ (γ α) e ^ 2) / ‖deriv γ α‖) (Ioo (-s) s) := by
    have hγc := hγ.continuousOn
    refine ContinuousOn.div₀ ?_ (hγ.continuousOn_deriv_of_isOpen isOpen_Ioo le_rfl).norm
      fun α hα => norm_ne_zero_iff.mpr (hγ'ne α hα)
    exact ((hγc.inner continuousOn_const).pow 2).add ((hγc.inner continuousOn_const).pow 2)
  -- du Bois-Reymond: `κ` is constant, and `κ(0) = 1` since `γ(0) = u`, `γ′(0) = e`
  obtain ⟨c, hc⟩ := Submission.idtp_ccd_scsp_du_bois_reymond (-s) s _ hcont hκ
  have hc1 : c = 1 := by
    have h : (inner ℝ (γ 0) u ^ 2 + inner ℝ (γ 0) e ^ 2) / ‖deriv γ 0‖ = c := hc 0 h0
    rw [hγ0, hγ'0, he, real_inner_self_eq_norm_sq, hu, hue] at h
    rw [← h]
    norm_num
  have hspeed : ∀ α ∈ Ioo (-s) s, ‖deriv γ α‖ = inner ℝ (γ α) u ^ 2 + inner ℝ (γ α) e ^ 2 := by
    intro α hα
    have h : (inner ℝ (γ α) u ^ 2 + inner ℝ (γ α) e ^ 2) / ‖deriv γ α‖ = 1 := (hc α hα).trans hc1
    exact ((div_eq_one_iff_eq (norm_ne_zero_iff.mpr (hγ'ne α hα))).mp h).symm
  -- great-circle arc, hence the sheet is a planar sector
  have harc := Submission.idtp_ccd_scsp_arc_planarity P u e s γ hu he hue hγ hcurve hspeed
  have hMN' : M ∩ N = (fun q : ℝ × ℝ => q.1 • (Real.cos q.2 • u + Real.sin q.2 • e)) ''
      (Ioo (r₀ - s) (r₀ + s) ×ˢ Ioo (-s) s) := by
    rw [hMN]
    exact Set.image_congr fun q hq => by simp only [harc q.2 hq.2]
  obtain ⟨δ, hδ, hδeq⟩ :=
    Submission.idtp_ccd_scsp_sector_plane P M N u e r₀ s hu he hue hs hsr hN hpN hMN'
  -- `span {u, e} = T_pM`, a 2-plane containing `p`
  obtain ⟨hdim, hpT⟩ := Submission.idtp_ccd_scsp_tangent_plane_mem P M (r₀ • u) ρ hM hp hρ hcone
  have hT : Submodule.span ℝ (tangentSpace M (r₀ • u)) = Submodule.span ℝ {u, e} := by
    have h := hTM r₀ hr₀R 0 h0
    rwa [hγ0, hγ'0] at h
  refine ⟨δ, Submodule.span ℝ {u, e}, hδ, ?_, ?_, hδeq⟩
  · rw [← hT]
    exact hdim
  · rw [← hT]
    exact hpT

end GMT.Ch07
