    intro ω hω
    obtain ⟨β, -, -, -, -, -, hlimY, -, hβ⟩ :=
      Submission.cmcdt_lpoh_pullback_limits lpush hPA N N' (k + 1) Λ L F G H X.support ω hF hG hH
