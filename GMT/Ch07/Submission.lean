      calc |t|⁻¹ * ‖((G (p + D) - G p) - (G (q + D) - G q)) + (G (q + D) - G (q + t • a))‖
          ≤ |t|⁻¹ * (Λ₂ * (|t| * ‖t⁻¹ • D‖) * ‖p - q‖ + Λ * (|t| * ‖t⁻¹ • D - a‖)) := by
            gcongr
        _ = Λ₂ * ‖t⁻¹ • D‖ * ‖p - q‖ + Λ * ‖t⁻¹ • D - a‖ := by
            field_simp
