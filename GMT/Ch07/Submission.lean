    intro z
    constructor
    · rintro ⟨a, ha, b, hb, rfl⟩
      have : y + ι a + ι' b - y = ι a + ι' b := by abel
      rw [this, map_add, map_add, hπι, hπι', hπ'ι, hπ'ι', add_zero, zero_add]
      exact ⟨ha, hb⟩
    · rintro ⟨ha, hb⟩
      refine ⟨_, ha, _, hb, ?_⟩
      rw [add_assoc, ← hdec]
      abel
