  have hC0 : 0 ≤ C := by
    have : 0 ≤ 1 - 2 * δ := by linarith
    positivity
  -- Step 2: the smooth Poincaré inequality for `v k` (sibling `smooth_poincare`).
  have hD : ∀ k, ∫ x in Q, ∫ y in Q, |v k x - v k y| ≤ C * V := fun k =>
    (Submission.dor_lmb_fcd_cp_smooth_poincare m (v k) δ
      ((hmv k).1.of_le (by exact_mod_cast le_top)) hδ.le hδ2).trans
      (mul_le_mul_of_nonneg_left (hmv k).2 hC0)
  -- `Q` is a measurable subset of `Q₁` contained in a compact ball.
  have hQQ₁ : Q ⊆ Q₁ := fun y hy i => ⟨hδ.trans (hy i).1, (hy i).2.trans (by linarith)⟩
  have hQm : MeasurableSet Q := by
    have hc : ∀ i : Fin (m + 1), Measurable fun y : Euclid (m + 1) => y i := fun i => by fun_prop
    have hQi : Q = ⋂ i, ({y : Euclid (m + 1) | δ < y i} ∩ {y | y i < 1 - δ}) := by
      ext y
      rw [mem_iInter]
      exact Iff.rfl
    rw [hQi]
    exact MeasurableSet.iInter fun i =>
      (measurableSet_lt measurable_const (hc i)).inter (measurableSet_lt (hc i) measurable_const)
  have hQK : Q ⊆ closedBall (0 : Euclid (m + 1)) (Real.sqrt (m + 1)) := by
    intro y hy
    rw [mem_closedBall_zero_iff, EuclideanSpace.norm_eq]
    refine Real.sqrt_le_sqrt ?_
    calc ∑ i, ‖y i‖ ^ 2 ≤ ∑ _i : Fin (m + 1), (1 : ℝ) := Finset.sum_le_sum fun i _ => by
          have h1 := (hy i).1
          have h2 := (hy i).2
          rw [Real.norm_eq_abs, sq_abs]
          nlinarith
      _ = m + 1 := by simp
  have hK : IsCompact (closedBall (0 : Euclid (m + 1)) (Real.sqrt (m + 1))) :=
    isCompact_closedBall _ _
  have : IsFiniteMeasure (volume.restrict Q) :=
    isFiniteMeasure_restrict.2 ((measure_mono hQK).trans_lt hK.measure_lt_top).ne
  set μ : Measure (Euclid (m + 1)) := volume.restrict Q
  -- Integrability on `Q × Q`.
  have huQ : Integrable u μ := hu.mono_set hQQ₁
  have hF : Integrable (fun p : Euclid (m + 1) × Euclid (m + 1) => |u p.1 - u p.2|) (μ.prod μ) :=
    ((huQ.comp_fst μ).sub (huQ.comp_snd μ)).abs
  have hFk : ∀ k, Integrable (fun p : Euclid (m + 1) × Euclid (m + 1) => |v k p.1 - v k p.2|)
      (μ.prod μ) := fun k => by
    have hvk : Integrable (v k) μ :=
      (((hmv k).1.continuous.continuousOn).integrableOn_compact hK).mono_set hQK
    exact ((hvk.comp_fst μ).sub (hvk.comp_snd μ)).abs
  -- Step 3: `v k → u` a.e. on `Q`, hence `|v k x - v k y| → |u x - u y|` a.e. on `Q × Q`.
  have hlimQ : ∀ᵐ x ∂μ, Tendsto (fun k => v k x) atTop (𝓝 (u x)) := by
    filter_upwards [ae_restrict_of_ae hlim, ae_restrict_mem hQm] with x hx hxQ
    rwa [indicator_of_mem (hQQ₁ hxQ)] at hx
  have hlimP : ∀ᵐ p ∂(μ.prod μ), Tendsto (fun k => ENNReal.ofReal |v k p.1 - v k p.2|) atTop
      (𝓝 (ENNReal.ofReal |u p.1 - u p.2|)) := by
    filter_upwards [Measure.quasiMeasurePreserving_fst.ae hlimQ,
      Measure.quasiMeasurePreserving_snd.ae hlimQ] with p h1 h2
    exact ENNReal.tendsto_ofReal (h1.sub h2).abs
  -- Steps 4–5: Fatou's lemma on `Q × Q` and Fubini.
  have hFatou : ∫⁻ p, ENNReal.ofReal |u p.1 - u p.2| ∂(μ.prod μ) ≤ ENNReal.ofReal (C * V) :=
    calc ∫⁻ p, ENNReal.ofReal |u p.1 - u p.2| ∂(μ.prod μ)
        = ∫⁻ p, liminf (fun k => ENNReal.ofReal |v k p.1 - v k p.2|) atTop ∂(μ.prod μ) :=
          lintegral_congr_ae (hlimP.mono fun p hp => hp.liminf_eq.symm)
      _ ≤ liminf (fun k => ∫⁻ p, ENNReal.ofReal |v k p.1 - v k p.2| ∂(μ.prod μ)) atTop :=
          lintegral_liminf_le' fun k => (hFk k).aemeasurable.ennreal_ofReal
      _ ≤ ENNReal.ofReal (C * V) := liminf_le_of_frequently_le' (Frequently.of_forall fun k => by
          rw [← ofReal_integral_eq_lintegral_ofReal (hFk k) (ae_of_all _ fun p => abs_nonneg _),
            integral_prod _ (hFk k)]
          exact ENNReal.ofReal_le_ofReal (hD k))
  have hfin : ENNReal.ofReal (∫ x in Q, ∫ y in Q, |u x - u y|) ≤ ENNReal.ofReal (C * V) := by
    rw [← integral_prod (fun p : Euclid (m + 1) × Euclid (m + 1) => |u p.1 - u p.2|) hF,
      ofReal_integral_eq_lintegral_ofReal hF (ae_of_all _ fun p => abs_nonneg _)]
    exact hFatou
  exact (ENNReal.ofReal_le_ofReal_iff (mul_nonneg hC0 hV)).1 hfin
/-- Shrinking the unit cube `Q₁ = (0, 1)ᵐ⁺¹` to `Q_δ = (δ, 1 − δ)ᵐ⁺¹` while keeping half of the
`L¹` norm of `f` (Simon Ch. 2, proof of Lemma 2.7).  The cubes `Q_{1/(j+4)}` are open and
increase to `Q₁`, so continuity of the measure from above and of the integral along increasing
unions give one `j` for both the layer bound and the integral bound. -/
theorem dor_lmb_fcd_cp_shrinking : ∀ (m : ℕ) (f : Euclid (m + 1) → ℝ), IntegrableOn f {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → ∃ δ : ℝ, 0 < δ ∧ δ ≤ 1 / 4 ∧ volume {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ} ≤ 1 ∧ volume ({y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} \ {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}) ≤ 1 / 4 ∧ ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |f y| ≤ 2 * ∫ y in {y : Euclid (m + 1) | ∀ i, δ < y i ∧ y i < 1 - δ}, |f y| := by
  intro m f hf
  -- Step 1: `Q_t` is open, `Q_t ⊆ Q₁` for `t ≥ 0`, and `volume Q₁ = 1`.
  have hopen : ∀ t : ℝ, IsOpen {y : Euclid (m + 1) | ∀ i, t < y i ∧ y i < 1 - t} := by
    intro t
    simp only [Set.ofPred_forall, Set.ofPred_and]
    exact isOpen_iInter_of_finite fun i =>
      (isOpen_lt continuous_const (PiLp.continuous_apply 2 _ i)).inter
        (isOpen_lt (PiLp.continuous_apply 2 _ i) continuous_const)
  have hmeas : ∀ t : ℝ, MeasurableSet {y : Euclid (m + 1) | ∀ i, t < y i ∧ y i < 1 - t} :=
    fun t => (hopen t).measurableSet
  have hmeas₁ : MeasurableSet {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} := by
    simpa using hmeas 0
  have hsub : ∀ t : ℝ, 0 ≤ t → {y : Euclid (m + 1) | ∀ i, t < y i ∧ y i < 1 - t} ⊆
      {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} := fun t ht y hy i =>
    ⟨ht.trans_lt (hy i).1, (hy i).2.trans_le (by linarith)⟩
  have hvol₁ : volume {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} = 1 := by
    have hpre : {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} =
        WithLp.ofLp ⁻¹' (univ.pi fun _ : Fin (m + 1) => Ioo (0 : ℝ) 1) := by
      ext y
      simp [Set.mem_pi]
    rw [hpre, (PiLp.volume_preserving_ofLp (Fin (m + 1))).measure_preimage
      (MeasurableSet.univ_pi fun _ => measurableSet_Ioo).nullMeasurableSet, Real.volume_pi_Ioo]
    simp
  -- Step 2: `δ_j = 1/(j+4)` decreases to `0`, and the cubes `Q_{δ_j}` increase to `Q₁`.
  obtain ⟨δ, hδdef⟩ : ∃ δ : ℕ → ℝ, δ = fun j : ℕ => 1 / ((j : ℝ) + 4) := ⟨_, rfl⟩
  have hδpos : ∀ j, 0 < δ j := fun j => by rw [hδdef]; positivity
  have hδle : ∀ j, δ j ≤ 1 / 4 := fun j => by
    simp only [hδdef]
    gcongr
    linarith [(Nat.cast_nonneg j : (0 : ℝ) ≤ j)]
  have hδanti : Antitone δ := fun j k hjk => by
    simp only [hδdef]
    gcongr
  have hδlim : Tendsto δ atTop (𝓝 0) := by
    rw [hδdef]
    exact tendsto_const_nhds.div_atTop
      (tendsto_atTop_add_const_right _ _ tendsto_natCast_atTop_atTop)
  have hmono : Monotone fun j => {y : Euclid (m + 1) | ∀ i, δ j < y i ∧ y i < 1 - δ j} :=
    fun j k hjk y hy i =>
      ⟨(hδanti hjk).trans_lt (hy i).1, (hy i).2.trans_le (by linarith [hδanti hjk])⟩
  have hunion : ⋃ j, {y : Euclid (m + 1) | ∀ i, δ j < y i ∧ y i < 1 - δ j} =
      {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} := by
    refine Subset.antisymm (iUnion_subset fun j => hsub _ (hδpos j).le) fun y hy => ?_
    have hev : ∀ᶠ j in atTop, ∀ i, δ j < y i ∧ y i < 1 - δ j := by
      rw [eventually_all]
      intro i
      filter_upwards [(tendsto_order.1 hδlim).2 _ (hy i).1,
        (tendsto_order.1 hδlim).2 _ (sub_pos.2 (hy i).2)] with j hj₁ hj₂
      exact ⟨hj₁, by linarith⟩
    obtain ⟨j, hj⟩ := hev.exists
    exact mem_iUnion.2 ⟨j, hj⟩
  -- Step 3: continuity from above, `volume (Q₁ \ Q_{δ_j}) → 0`.
  have hlayer : Tendsto (fun j => volume ({y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} \
      {y : Euclid (m + 1) | ∀ i, δ j < y i ∧ y i < 1 - δ j})) atTop (𝓝 0) := by
    have h := tendsto_measure_iInter_atTop (μ := volume)
      (s := fun j => {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} \
        {y : Euclid (m + 1) | ∀ i, δ j < y i ∧ y i < 1 - δ j})
      (fun j => (hmeas₁.diff (hmeas _)).nullMeasurableSet)
      (fun j k hjk => Set.sdiff_subset_sdiff_right (hmono hjk))
      ⟨0, ((measure_mono Set.sdiff_subset).trans_lt (by rw [hvol₁]; exact ENNReal.one_lt_top)).ne⟩
    rw [← Set.sdiff_iUnion, hunion, Set.sdiff_self, measure_empty] at h
    exact h
  have hev₁ : ∀ᶠ j in atTop, volume ({y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} \
      {y : Euclid (m + 1) | ∀ i, δ j < y i ∧ y i < 1 - δ j}) < 1 / 4 :=
    (tendsto_order.1 hlayer).2 _ (by norm_num)
  -- Step 4: continuity of the integral, `∫_{Q_{δ_j}} |f| → ∫_{Q₁} |f|`.
  have hint : Tendsto (fun j => ∫ y in {y : Euclid (m + 1) | ∀ i, δ j < y i ∧ y i < 1 - δ j}, |f y|)
      atTop (𝓝 (∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |f y|)) := by
    have h := tendsto_setIntegral_of_monotone (μ := volume) (f := fun y => |f y|)
      (fun j => hmeas (δ j)) hmono (by rw [hunion]; exact hf.abs)
    rw [hunion] at h
    exact h
  have hev₂ : ∀ᶠ j in atTop, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |f y| ≤
      2 * ∫ y in {y : Euclid (m + 1) | ∀ i, δ j < y i ∧ y i < 1 - δ j}, |f y| := by
    rcases (integral_nonneg fun y => abs_nonneg (f y) :
        0 ≤ ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |f y|).eq_or_lt with h₀ | hpos
    · exact Eventually.of_forall fun j => by
        rw [← h₀]
        exact mul_nonneg zero_le_two (integral_nonneg fun y => abs_nonneg (f y))
    · filter_upwards [(tendsto_order.1 hint).1 _ (half_lt_self hpos)] with j hj
      linarith
  -- Step 5: one `j` works for both bounds.
  obtain ⟨j, hj₁, hj₂⟩ := (hev₁.and hev₂).exists
  exact ⟨δ j, hδpos j, hδle j, (measure_mono (hsub _ (hδpos j).le)).trans hvol₁.le, hj₁.le, hj₂⟩

/-- **Poincaré inequality with an integer median on the unit cube** (Simon Ch. 2, Lemma 2.7 with
`θ = 1/4`, and the choice (31), (35) of `β_F` in the proof of the Deformation Theorem, Ch. 6, 5.1):
there is `c = c(m) > 0` such that every integer-valued `u` integrable on `Q₁ = (0, 1)^{m+1}` with
`∫_{Q₁} u div g ≤ V` for all smooth `g` with compact support in `Q₁` and `|g| ≤ 1` has an integer
`β` with `∫_{Q₁} |u − β| ≤ c V` and `|β| ≤ 2 ∫_{Q₁} |u|`.  Take the integer median `β`
(`dor_lmb_fcd_cp_integer_median`) and shrink `Q₁` to `Q_δ = (δ, 1 − δ)^{m+1}`, keeping half of
`∫ |u − β|` with `Lⁿ(Q₁ \ Q_δ) ≤ 1/4` (`dor_lmb_fcd_cp_shrinking`), so `β` is a `¼`-median of `u`
on `Q_δ`.  Normalized bumps of radius `δ/(k + 2)` give the BV Poincaré inequality on `Q_δ`
(`dor_lmb_fcd_cp_bv_poincare`), and `dor_lmb_fcd_cp_median_deviation` gives
`∫_{Q₁} |u − β| ≤ 2 ∫_{Q_δ} |u − β| ≤ 2 · 5 (m + 1)(1 − 2δ) V ≤ 10 (m + 1) V`. -/
theorem dor_lmb_fcd_cube_poincare : ∀ m : ℕ, ∃ c : ℝ, 0 < c ∧ ∀ (u : Euclid (m + 1) → ℝ) (V : ℝ), (∀ y, ∃ z : ℤ, u y = z) → IntegrableOn u {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ y, ‖g y‖ ≤ 1) → ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, u y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) ≤ V) → ∃ β : ℤ, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u y - β| ≤ c * V ∧ |(β : ℝ)| ≤ 2 * ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u y| := by
  intro m
  refine ⟨10 * ((m : ℝ) + 1), by positivity, ?_⟩
  intro u V hZ hu hH
  set Q₁ : Set (Euclid (m + 1)) := {y | ∀ i, 0 < y i ∧ y i < 1} with hQ₁
  -- Step 0: `V ≥ 0` (test `g = 0`); `{a < yᵢ < b}` is the preimage of the box `(a, b)ⁿ`, so it is
  -- measurable, and `Lⁿ(Q₁) = 1`
  have hV : 0 ≤ V := by
    have h0 := hH (fun _ => 0) contDiff_const HasCompactSupport.zero (by simp) (by simp)
    simpa using h0
  have hpre : ∀ a b : ℝ, {y : Euclid (m + 1) | ∀ i, a < y i ∧ y i < b} =
      WithLp.ofLp ⁻¹' (univ.pi fun _ : Fin (m + 1) => Ioo a b) := fun a b => by
    ext y
    simp [Set.mem_pi]
  have hmeas : ∀ a b : ℝ, MeasurableSet {y : Euclid (m + 1) | ∀ i, a < y i ∧ y i < b} :=
    fun a b => by
      rw [hpre]
      exact (PiLp.volume_preserving_ofLp (Fin (m + 1))).measurable
        (MeasurableSet.univ_pi fun _ => measurableSet_Ioo)
  have hvol₁ : volume Q₁ = 1 := by
    rw [hQ₁, hpre, (PiLp.volume_preserving_ofLp (Fin (m + 1))).measure_preimage
      (MeasurableSet.univ_pi fun _ => measurableSet_Ioo).nullMeasurableSet, Real.volume_pi_Ioo]
    simp
  -- Step 1: the integer median `β` of `u` on `Q₁` (Simon (31), (35))
  obtain ⟨β, hβge, hβle, hβbd⟩ := dor_lmb_fcd_cp_integer_median m u hZ hu
  refine ⟨β, ?_, hβbd⟩
  -- Step 2: shrink `Q₁` to `Q = Q_δ`, keeping half of `∫_{Q₁} |u − β|`
  have hf : IntegrableOn (fun y => u y - β) Q₁ :=
    hu.sub (integrableOn_const (by rw [hvol₁]; exact ENNReal.one_ne_top))
  obtain ⟨δ, hδ0, hδ4, hQ1, hlayer, hhalf⟩ := dor_lmb_fcd_cp_shrinking m (fun y => u y - β) hf
  set Q : Set (Euclid (m + 1)) := {y | ∀ i, δ < y i ∧ y i < 1 - δ}
  have hQQ₁ : Q ⊆ Q₁ := fun y hy i => ⟨hδ0.trans (hy i).1, (hy i).2.trans (by linarith)⟩
  have hQfin : volume Q ≠ ∞ := (hQ1.trans_lt ENNReal.one_lt_top).ne
  -- Step 3: median transfer, `Lⁿ(Q ∩ A) ≥ Lⁿ(Q₁ ∩ A) − Lⁿ(Q₁ \ Q) ≥ 1/4 ≥ ¼ Lⁿ(Q)` for
  -- `A = {β ≤ u}` and `A = {u ≤ β}`; in particular `Lⁿ(Q) > 0`
  have hq1 : (volume Q).toReal ≤ 1 := by
    have h := ENNReal.toReal_mono ENNReal.one_ne_top hQ1
    rwa [ENNReal.toReal_one] at h
  have htransfer : ∀ A : Set (Euclid (m + 1)), 1 / 2 ≤ volume (Q₁ ∩ A) →
      1 / 4 ≤ (volume (Q ∩ A)).toReal := by
    intro A hA
    have hsub : Q₁ ∩ A ⊆ (Q ∩ A) ∪ (Q₁ \ Q) := fun y hy => by
      by_cases hyQ : y ∈ Q
      · exact Or.inl ⟨hyQ, hy.2⟩
      · exact Or.inr ⟨hy.1, hyQ⟩
    have h1 : 1 / 2 ≤ volume (Q ∩ A) + 1 / 4 :=
      hA.trans ((measure_mono hsub).trans ((measure_union_le _ _).trans (add_le_add le_rfl hlayer)))
    have hfinA : volume (Q ∩ A) ≠ ∞ :=
      ((measure_mono inter_subset_left).trans_lt (hQ1.trans_lt ENNReal.one_lt_top)).ne
    have h2 := ENNReal.toReal_mono (ENNReal.add_ne_top.2 ⟨hfinA, by norm_num⟩) h1
    rw [ENNReal.toReal_add hfinA (by norm_num)] at h2
    have h3 : ((1 : ℝ≥0∞) / 2).toReal = 1 / 2 := by norm_num
    have h4 : ((1 : ℝ≥0∞) / 4).toReal = 1 / 4 := by norm_num
    rw [h3, h4] at h2
    linarith
  have hge : 1 / 4 * (volume Q).toReal ≤ (volume (Q ∩ {y | (β : ℝ) ≤ u y})).toReal := by
    linarith [htransfer _ hβge]
  have hle : 1 / 4 * (volume Q).toReal ≤ (volume (Q ∩ {y | u y ≤ (β : ℝ)})).toReal := by
    linarith [htransfer _ hβle]
  have hqpos : 0 < (volume Q).toReal := by
    have h : (volume (Q ∩ {y | (β : ℝ) ≤ u y})).toReal ≤ (volume Q).toReal :=
      ENNReal.toReal_mono hQfin (measure_mono inter_subset_left)
    linarith [htransfer _ hβge]
  -- Step 4: deviation from the `¼`-median `β` on `Q` (Simon 2.7)
  have hdev := dor_lmb_fcd_cp_median_deviation (m + 1) Q u β (1 / 4) (hmeas δ (1 - δ)) hQfin
    (hu.mono_set hQQ₁) (by norm_num) hge hle
  -- Step 5: normalized bumps `η_k` of radius `δ/(k + 2)`; their mollifications of `1_{Q₁} u`
  -- converge a.e. (Lebesgue differentiation), so the BV Poincaré inequality holds on `Q`
  let φ : ℕ → ContDiffBump (0 : Euclid (m + 1)) := fun k =>
    { rIn := δ / ((k : ℝ) + 2) / 2
      rOut := δ / ((k : ℝ) + 2)
      rIn_pos := by positivity
      rIn_lt_rOut := by
        have : 0 < δ / ((k : ℝ) + 2) := by positivity
        linarith }
  have hφ0 : Tendsto (fun k => (φ k).rOut) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop (tendsto_atTop_add_const_right _ _ tendsto_natCast_atTop_atTop)
  have hφK : ∀ᶠ k in atTop, (φ k).rOut ≤ 2 * (φ k).rIn :=
    Eventually.of_forall fun k => by
      change δ / ((k : ℝ) + 2) ≤ 2 * (δ / ((k : ℝ) + 2) / 2)
      linarith
  have hφs : ∀ k, support ((φ k).normed volume) ⊆ ball (0 : Euclid (m + 1)) δ := fun k => by
    rw [(φ k).support_normed_eq]
    exact ball_subset_ball (div_le_self hδ0.le (by linarith [(Nat.cast_nonneg k : (0 : ℝ) ≤ k)]))
  have hae := ContDiffBump.ae_convolution_tendsto_right_of_locallyIntegrable (μ := volume)
    hφ0 hφK (hu.integrable_indicator (hmeas 0 1)).locallyIntegrable
  have hbv := dor_lmb_fcd_cp_bv_poincare m u V δ (fun k => (φ k).normed volume) hu hH hδ0
    (by linarith) (fun k => (φ k).contDiff_normed) (fun k => (φ k).hasCompactSupport_normed)
    (fun k => (φ k).nonneg_normed) (fun k => (φ k).normed_neg) (fun k => (φ k).integral_normed)
    hφs hae
  -- Step 6: `∫_{Q₁} |u − β| ≤ 2 ∫_Q |u − β| ≤ 2 · 5 (m + 1)(1 − 2δ) V ≤ 10 (m + 1) V`
  have hQbd : ∫ y in Q, |u y - β| ≤ 5 * ((m : ℝ) + 1) * V := by
    have hmδV : 0 ≤ ((m : ℝ) + 1) * δ * V := by positivity
    calc ∫ y in Q, |u y - β|
        ≤ (1 + (1 / 4 : ℝ)⁻¹) * ((volume Q).toReal)⁻¹ * ∫ x in Q, ∫ y in Q, |u x - u y| := hdev
      _ ≤ (1 + (1 / 4 : ℝ)⁻¹) * ((volume Q).toReal)⁻¹ *
            (((m : ℝ) + 1) * (1 - 2 * δ) * (volume Q).toReal * V) :=
          mul_le_mul_of_nonneg_left hbv (by positivity)
      _ = 5 * ((m : ℝ) + 1) * (1 - 2 * δ) * V * (((volume Q).toReal)⁻¹ * (volume Q).toReal) := by
          ring
      _ = 5 * ((m : ℝ) + 1) * (1 - 2 * δ) * V := by rw [inv_mul_cancel₀ hqpos.ne', mul_one]
      _ ≤ 5 * ((m : ℝ) + 1) * V := by linarith
  calc ∫ y in Q₁, |u y - β| ≤ 2 * ∫ y in Q, |u y - β| := hhalf
    _ ≤ 2 * (5 * ((m : ℝ) + 1) * V) := by gcongr
    _ = 10 * ((m : ℝ) + 1) * V := by ring

end Submission

/-- **Face replacement** (Simon Ch. 6, proof of the Deformation Theorem 5.1, (26)–(37)): an
integer multiplicity `Q ∈ 𝒟ₙ(ℝᴾ)`, `n = m + 1 < P`, vanishing off `L_n ∩ K` (`K` compact) with
`M(∂Q) < ∞` is the lattice chain `Pc = Σ_{p ∈ s} β_p [[F_p]]` up to an integer multiplicity error
`Q − Pc` with `M(Q − Pc) ≤ c M(∂Q)`, where `Σ_p |β_p| ≤ c M(Q)` and `c = max(c_cp, 2)`.
The faces meeting `K` carry `Q` (`dor_lmb_fcd_fr_skeleton_cells`), so
`Q = Σ_p u_p [[F_p°]]` with integer densities `u_p` and `Σ_p ∫|u_p| ≤ M(Q)` ((26)–(28), (33));
testing `∂Q` near each face bounds the variation of `u_p` by `V_p`, `Σ_p V_p ≤ M(∂Q)` ((28)); the
cube Poincaré inequality gives integer medians `β_p` with `∫|u_p − β_p| ≤ c_cp V_p` and
`|β_p| ≤ 2∫|u_p|` ((31), (32), (35)).  Then `Q − Pc = Σ_p (u_p − β_p)[[F_p°]]` ((29)) has mass
`≤ Σ_p ∫|u_p − β_p| ≤ c_cp M(∂Q)` ((34)), `Σ_p |β_p| ≤ 2 M(Q)` ((36)), `Pc` is integer
multiplicity, and `Q − Pc` vanishes off `cthickening(√P, K) ⊇ F_p`. -/
theorem Submission.dor_lmb_fcd_face_replacement : ∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 0 ≤ c ∧ ∀ (K : Set (Euclid P)) (Q : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsCompact K → IsIntegerMultiplicity Q → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) ({x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} ∩ K) → Q ω = 0) → Q.boundary.mass ≠ ∞ → ∃ (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (β : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℤ) (Pc : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ p ∈ s, StrictMono p.2) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Pc ω = ∑ p ∈ s, (β p : ℝ) * ∫ x in {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)}, (ω : DifferentialForm (Euclid P) (m + 1)) x (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) ∂μHE[m + 1]) ∧ IsIntegerMultiplicity (Q - Pc) ∧ (Q - Pc).mass ≤ ENNReal.ofReal c * Q.boundary.mass ∧ (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞)) ≤ ENNReal.ofReal c * Q.mass ∧ (∀ p ∈ s, {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)} ⊆ cthickening (Real.sqrt P) K) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (cthickening (Real.sqrt P) K) → (Q - Pc) ω = 0 := by
  intro P m hmP
  -- `c_cp`: the cube Poincaré constant with integer medians (Simon Ch. 2, 2.7; Ch. 6, (31), (35))
  obtain ⟨ccp, hccp, hcp⟩ := Submission.dor_lmb_fcd_cube_poincare m
  refine ⟨max ccp 2, le_max_of_le_right zero_le_two, ?_⟩
  intro K Q hK hQ hQK hbd
  -- the finitely many faces `F_p` (`p ∈ s`) meeting `K`; their open faces carry `L_n ∩ K` a.e.
  obtain ⟨s, hs, hsK, hL, hcover⟩ := Submission.dor_lmb_fcd_fr_skeleton_cells P m K hmP hK
  -- (26)–(28), (33): `Q = Σ_p u_p [[F_p°]]` with integer densities and `Σ ∫|u_p| ≤ M(Q)`
  obtain ⟨u, huZ, huint, humass, hQu⟩ := Submission.dor_lmb_fcd_fr_face_representation P m s _ Q
    hs (hL.inter hK.isClosed) hcover hQ hQK
  -- (28): `∫ u_p div g ≤ V_p` for admissible `g`, with `Σ V_p ≤ M(∂Q)`
  obtain ⟨V, -, hVsum, hVvar⟩ :=
    Submission.dor_lmb_fcd_fr_boundary_variation P m s u Q hs hQu hbd
  -- (31), (32), (35): integer medians `β_p` with `∫|u_p − β_p| ≤ c_cp V_p`, `|β_p| ≤ 2∫|u_p|`
  have hβex : ∀ p, ∃ b : ℤ, p ∈ s →
      (∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u p y - b|) ≤ ccp * V p ∧
        |(b : ℝ)| ≤ 2 * ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u p y| := by
    intro p
    by_cases hp : p ∈ s
    · obtain ⟨b, hb⟩ := hcp (u p) (V p) (huZ p hp) (huint p hp) (hVvar p hp)
      exact ⟨b, fun _ => hb⟩
    · exact ⟨0, fun h => absurd h hp⟩
  choose β hβ using hβex
  -- constants are integrable on the unit cube `Q₁ = (0, 1)ⁿ`, of volume `1`
  have hconst : ∀ p ∈ s, ∀ b : ℝ,
      IntegrableOn (fun _ : Euclid (m + 1) => b) {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} := by
    intro p hp b
    have h1 := (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).1
    exact integrableOn_const (by rw [h1]; exact ENNReal.one_ne_top)
  -- the lattice chain `Pc = Σ_p β_p [[F_p]]`, and integrability of the face integrands
  obtain ⟨hβint, ⟨Pc, hPc⟩, -⟩ := Submission.dor_lmb_fcd_fr_chain_current P m s
    (fun p _ => (β p : ℝ)) hs fun p hp => hconst p hp _
  obtain ⟨huωint, -, -⟩ := Submission.dor_lmb_fcd_fr_chain_current P m s u hs huint
  -- the mass bound for currents with face densities `u_p − β_p`
  obtain ⟨-, -, hDmass⟩ := Submission.dor_lmb_fcd_fr_chain_current P m s
    (fun p y => u p y - β p) hs fun p hp => Integrable.sub (huint p hp) (hconst p hp _)
  beta_reduce at hβint hPc hDmass
  -- (29): `Q − Pc = Σ_p (u_p − β_p) [[F_p°]]`
  have hQP : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), (Q - Pc) ω =
      ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1},
        (u p y - β p) * (ω : DifferentialForm (Euclid P) (m + 1))
          (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ))
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) := by
    intro ω
    show Q ω - Pc ω = _
    rw [hQu ω, hPc ω, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun p hp => ?_
    rw [← integral_sub (huωint ω p hp) (hβint ω p hp)]
    congr 1
    funext y
    ring
  refine ⟨s, β, Pc, hs, ?_, ?_, ?_, ?_, hsK, ?_⟩
  · -- the face formula of `Pc`: `∫_{F_p} f dHⁿ = ∫_{Q₁} f ∘ Φ_p`
    intro ω
    rw [hPc ω]
    refine Finset.sum_congr rfl fun p hp => ?_
    rw [(Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.1]
    exact integral_const_mul _ _
  · -- `Pc` is integer multiplicity, hence so is `Q − Pc`
    exact Submission.cmc_imRep_locality_restrict_sub.2.2.1 P (m + 1) univ Q Pc isOpen_univ hQ
      (Submission.dor_lmb_fcd_fr_lattice_chain_im P m s β Pc hs hPc)
  · -- (34): `M(Q − Pc) ≤ Σ_p ∫|u_p − β_p| ≤ c_cp Σ_p V_p ≤ c M(∂Q)`
    calc (Q - Pc).mass
        ≤ ENNReal.ofReal (∑ p ∈ s,
            ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u p y - β p|) :=
          hDmass (Q - Pc) hQP
      _ ≤ ENNReal.ofReal (ccp * ∑ p ∈ s, V p) := by
          refine ENNReal.ofReal_le_ofReal ?_
          rw [Finset.mul_sum]
          exact Finset.sum_le_sum fun p hp => (hβ p hp).1
      _ = ENNReal.ofReal ccp * ENNReal.ofReal (∑ p ∈ s, V p) := ENNReal.ofReal_mul hccp.le
      _ ≤ ENNReal.ofReal (max ccp 2) * Q.boundary.mass :=
          mul_le_mul' (ENNReal.ofReal_le_ofReal (le_max_left _ _)) hVsum
  · -- (36): `Σ_p |β_p| ≤ 2 Σ_p ∫|u_p| ≤ c M(Q)`
    calc (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞))
        = ENNReal.ofReal (∑ p ∈ s, |(β p : ℝ)|) := by
          rw [ENNReal.ofReal_sum_of_nonneg fun p _ => abs_nonneg _]
          refine Finset.sum_congr rfl fun p _ => ?_
          rw [← ENNReal.ofReal_natCast, Nat.cast_natAbs, Int.cast_abs]
      _ ≤ ENNReal.ofReal (2 * ∑ p ∈ s,
            ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u p y|) := by
          refine ENNReal.ofReal_le_ofReal ?_
          rw [Finset.mul_sum]
          exact Finset.sum_le_sum fun p hp => (hβ p hp).2
      _ = ENNReal.ofReal 2 * ENNReal.ofReal (∑ p ∈ s,
            ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u p y|) :=
          ENNReal.ofReal_mul zero_le_two
      _ ≤ ENNReal.ofReal (max ccp 2) * Q.mass :=
          mul_le_mul' (ENNReal.ofReal_le_ofReal (le_max_right _ _)) humass
  · -- `Q − Pc` vanishes off `cthickening(√P, K)`, which contains every `F_p ⊇ Φ_p(Q₁)`
    intro ω hω
    rw [hQP ω]
    refine Finset.sum_eq_zero fun p hp => setIntegral_eq_zero_of_forall_eq_zero fun y hy => ?_
    have hmem := (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.2.1 y
      fun i => ⟨(hy i).1.le, (hy i).2.le⟩
    rw [image_eq_zero_of_notMem_tsupport (Set.disjoint_right.1 hω (hsK p hp hmem))]
    simp

/-- **Simon Ch. 6, Deformation Theorem 5.1 (unit scale), display (38) and the end of its proof.**
Let `n = m + 1 < P`, `K` compact and `T ∈ 𝒟ₙ(ℝᴾ)` integer multiplicity, with `∂T` integer
multiplicity and `T` vanishing off `K`.  By 3.2(3), `μ_T` and `μ_{∂T}` are carried by `K`, where
the multiplicities are integrable, so `M(T), M(∂T) < ∞`.  The skeleton deformation gives
`T − Q = ∂R₁ + S₁` with `Q` carried by the `n`-skeleton in `K_Q = cthickening(√P, K)`; face
replacement gives the unit lattice chain `Pc = Σ_{p ∈ s} β_p [[F_p]]` with `M(Q − Pc) ≤ c_f M(∂Q)`
and `Σ_p |β_p| ≤ c_f M(Q)`.  Then `R = R₁` and `S = S₁ + (Q − Pc)` give `T − Pc = ∂R + S` with
`c = c_s(1 + c_f)`, and `cthickening(√P, K_Q) ⊆ cthickening(2√P, K)`. -/
theorem Submission.dor_lmb_fcd_unit_deformation : ((∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (n + 1)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → RT.Represents T → RB.Represents T.boundary → LipschitzWith L f → ∃ Ps : ℝ → GeometricCurrentOn U n, (∀ W : Set (Euclid P), IsOpen W → AEMeasurable (fun t => (Ps t).massOn W) ∧ ∫⁻ t, (Ps t).massOn W ≤ (L : ℝ≥0∞) * T.massOn W) ∧ ∀ᵐ t, IsIntegerMultiplicity (Ps t) ∧ (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (f ⁻¹' {t}) → Ps t ω = 0) ∧ ∀ ω : TestFormOn U n, Ps t ω = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → (∀ (P m : ℕ) (U : Set (Euclid P)) (X : ℕ → GeometricCurrentOn U (m + 1)), IsOpen U → (∀ r, IsIntegerMultiplicity (X r)) → ∑' r, (X r).mass ≠ ∞ → ∃ Y : GeometricCurrentOn U (m + 1), IsIntegerMultiplicity Y ∧ (∀ ω : TestFormOn U (m + 1), HasSum (fun r => X r ω) (Y ω)) ∧ Y.mass ≤ ∑' r, (X r).mass) → ∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 0 ≤ c ∧ ∀ (K : Set (Euclid P)) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsCompact K → IsIntegerMultiplicity T → IsIntegerMultiplicity T.boundary → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (K) → T ω = 0) → ∃ (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (β : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℤ) (Pc : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ p ∈ s, StrictMono p.2) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Pc ω = ∑ p ∈ s, (β p : ℝ) * ∫ x in {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)}, (ω : DifferentialForm (Euclid P) (m + 1)) x (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) ∂μHE[m + 1]) ∧ IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), T ω - Pc ω = R.boundary ω + S ω) ∧ (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞)) ≤ ENNReal.ofReal c * T.mass ∧ R.mass ≤ ENNReal.ofReal c * T.mass ∧ S.mass ≤ ENNReal.ofReal c * T.boundary.mass ∧ (∀ p ∈ s, {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)} ⊆ cthickening (2 * Real.sqrt P) K) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 2), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 2))) (cthickening (2 * Real.sqrt P) K) → R ω = 0) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (cthickening (2 * Real.sqrt P) K) → S ω = 0 := by
  intro hSL hIMS P m hmP
  -- Step 1: the constants `c_s` (skeleton deformation) and `c_f` (face replacement)
  obtain ⟨cs, hcs, hSD⟩ := Submission.dor_lmb_fcd_skeleton_deformation hSL hIMS P m hmP
  obtain ⟨cf, hcf, hFR⟩ := Submission.dor_lmb_fcd_face_replacement P m hmP
  refine ⟨cs * (1 + cf), mul_nonneg hcs (by linarith), ?_⟩
  intro K T hK hT hbT hTK
  -- `(A − B)(ω) = A(ω) − B(ω)` and `M(A − B) ≤ M(A) + M(B)` (with `ω` admissible, so is `−ω`)
  have hsub : ∀ {d : ℕ} (A B : GeometricCurrentOn (univ : Set (Euclid P)) d)
      (ω : TestFormOn (univ : Set (Euclid P)) d), (A - B) ω = A ω - B ω := fun _ _ _ => rfl
  have hmass_sub : ∀ {d : ℕ} (A B : GeometricCurrentOn (univ : Set (Euclid P)) d),
      (A - B).mass ≤ A.mass + B.mass := by
    intro d A B
    refine sSup_le ?_
    rintro r ⟨ω, hω, rfl⟩
    have hω' : -ω ∈ massAdmissibleOn (univ : Set (Euclid P)) d univ :=
      ⟨subset_univ _, fun x => by simpa using hω.2 x⟩
    have h : (A - B) ω = A ω + B (-ω) := by
      show A.toCurrent ω - B.toCurrent ω = A.toCurrent ω + B.toCurrent (-ω)
      rw [B.toCurrent.map_neg ω, sub_eq_add_neg]
    calc ENNReal.ofReal ((A - B) ω) = ENNReal.ofReal (A ω + B (-ω)) := by rw [h]
      _ ≤ ENNReal.ofReal (A ω) + ENNReal.ofReal (B (-ω)) := ENNReal.ofReal_add_le
      _ ≤ A.mass + B.mass := add_le_add (A.le_massOn hω) (B.le_massOn hω')
  -- Step 2: an integer multiplicity current vanishing off the compact `K` has finite mass:
  -- `M(X) = μ_X(ℝᴾ) = μ_X(K) < ∞`, as `μ_X(ℝᴾ ∖ K) = M_{ℝᴾ∖K}(X) = 0` (3.2(3))
  have hfin : ∀ {d : ℕ} (X : GeometricCurrentOn (univ : Set (Euclid P)) d),
      IsIntegerMultiplicity X → (∀ ω : TestFormOn (univ : Set (Euclid P)) d,
        Disjoint (tsupport (ω : DifferentialForm (Euclid P) d)) K → X ω = 0) → X.mass ≠ ∞ := by
    intro d X ⟨RX, hRX⟩ hXK
    have hmass := (Submission.dor_imrep_massOn_eq_measure_and_support P d univ X RX isOpen_univ
      hRX).1
    have hKc : RX.measure Kᶜ = 0 := by
      rw [← hmass Kᶜ hK.isClosed.isOpen_compl]
      refine le_antisymm (sSup_le ?_) zero_le
      rintro r ⟨ω, hω, rfl⟩
      show ENNReal.ofReal (X ω) ≤ 0
      rw [hXK ω (disjoint_compl_left.mono_left hω.1), ENNReal.ofReal_zero]
    have hKfin : RX.measure K ≠ ∞ := by
      rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
        Measure.restrict_restrict hK.measurableSet, inter_comm]
      exact RX.locallyIntegrable_mult K hK (subset_univ K)
    show X.massOn univ ≠ ∞
    rw [hmass univ isOpen_univ]
    exact ne_top_of_le_ne_top (by rw [hKc, add_zero]; exact hKfin) (measure_univ_le_add_compl K)
  -- `∂T` vanishes off `K` too, since `spt dω ⊆ spt ω`
  have hbTK : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) K → T.boundary ω = 0 := fun ω hω =>
    hTK _ (hω.mono_left (tsupport_exteriorDerivative_subset (ω : DifferentialForm (Euclid P) m)))
  have hTfin : T.mass ≠ ∞ := hfin T hT hTK
  have hbTfin : T.boundary.mass ≠ ∞ := hfin T.boundary hbT hbTK
  -- Step 3: `T − Q = ∂R₁ + S₁`, `Q` carried by the `n`-skeleton in `K_Q = cthickening(√P, K)`
  obtain ⟨Q, R₁, S₁, hQ, hR₁, hS₁, hTQ, hQmass, hbQmass, hR₁mass, hS₁mass, hQK, hR₁K, hS₁K⟩ :=
    hSD K T hK hT hbT hTK hTfin hbTfin
  -- Step 4: the unit lattice chain `Pc` replacing `Q`, with `M(∂Q) ≤ c_s M(∂T) < ∞`
  have hbQfin : Q.boundary.mass ≠ ∞ :=
    ne_top_of_le_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hbTfin) hbQmass
  obtain ⟨s, β, Pc, hmono, hPc, hQPc, hQPcmass, hβ, hface, hQPcK⟩ :=
    hFR (cthickening (Real.sqrt P) K) Q hK.cthickening hQ hQK hbQfin
  -- Step 7: `cthickening(√P, K) ⊆ cthickening(2√P, K)` and
  -- `cthickening(√P, cthickening(√P, K)) ⊆ cthickening(2√P, K)`
  have hsq : 0 ≤ Real.sqrt P := Real.sqrt_nonneg _
  have hK₁ : cthickening (Real.sqrt P) K ⊆ cthickening (2 * Real.sqrt P) K :=
    cthickening_mono (by linarith) K
  have hK₂ : cthickening (Real.sqrt P) (cthickening (Real.sqrt P) K) ⊆
      cthickening (2 * Real.sqrt P) K := by
    rw [two_mul]
    exact cthickening_cthickening_subset hsq hsq K
  -- Step 5, (38): `R = R₁`, `S = S₁ + (Q − Pc) = S₁ − ((Q − Q) − (Q − Pc))`, integer multiplicity
  have hIMsub := Submission.cmc_imRep_locality_restrict_sub.2.2.1 P (m + 1) univ
  refine ⟨s, β, Pc, R₁, S₁ - ((Q - Q) - (Q - Pc)), hmono, hPc, hR₁,
    hIMsub _ _ isOpen_univ hS₁ (hIMsub _ _ isOpen_univ (hIMsub _ _ isOpen_univ hQ hQ) hQPc),
    fun ω => ?_, ?_, ?_, ?_, fun p hp => (hface p hp).trans hK₂,
    fun ω hω => hR₁K ω (hω.mono_right hK₁), fun ω hω => ?_⟩
  · -- `T − Pc = (T − Q) + (Q − Pc) = ∂R₁ + S₁ + (Q − Pc)`
    simp only [hsub]
    linarith [hTQ ω]
  · -- Step 6: `Σ|β_p| ≤ c_f M(Q) ≤ c_f c_s M(T)`
    calc (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞)) ≤ ENNReal.ofReal cf * Q.mass := hβ
      _ ≤ ENNReal.ofReal cf * (ENNReal.ofReal cs * T.mass) := by gcongr
      _ = ENNReal.ofReal (cf * cs) * T.mass := by rw [← mul_assoc, ← ENNReal.ofReal_mul hcf]
      _ ≤ ENNReal.ofReal (cs * (1 + cf)) * T.mass := by gcongr ENNReal.ofReal ?_ * _; nlinarith
  · -- `M(R) = M(R₁) ≤ c_s M(T)`
    calc R₁.mass ≤ ENNReal.ofReal cs * T.mass := hR₁mass
      _ ≤ ENNReal.ofReal (cs * (1 + cf)) * T.mass := by gcongr ENNReal.ofReal ?_ * _; nlinarith
  · -- `M(S) ≤ M(S₁) + M(Q − Q) + M(Q − Pc) ≤ c_s M(∂T) + c_f c_s M(∂T)`, as `Q − Q = 0`
    have hQQ : (Q - Q).mass = 0 := by
      refine le_antisymm (sSup_le ?_) zero_le
      rintro r ⟨ω, -, rfl⟩
      show ENNReal.ofReal (Q ω - Q ω) ≤ 0
      rw [sub_self, ENNReal.ofReal_zero]
    calc (S₁ - ((Q - Q) - (Q - Pc))).mass ≤ S₁.mass + ((Q - Q).mass + (Q - Pc).mass) :=
          (hmass_sub _ _).trans (add_le_add le_rfl (hmass_sub _ _))
      _ = S₁.mass + (Q - Pc).mass := by rw [hQQ, zero_add]
      _ ≤ ENNReal.ofReal cs * T.boundary.mass + ENNReal.ofReal cf * Q.boundary.mass :=
          add_le_add hS₁mass hQPcmass
      _ ≤ ENNReal.ofReal cs * T.boundary.mass +
            ENNReal.ofReal cf * (ENNReal.ofReal cs * T.boundary.mass) := by gcongr
      _ = ENNReal.ofReal (cs * (1 + cf)) * T.boundary.mass := by
          rw [← mul_assoc, ← add_mul, ← ENNReal.ofReal_mul hcf,
            ← ENNReal.ofReal_add hcs (mul_nonneg hcf hcs)]
          congr 2
          ring
  · -- `S` vanishes off `cthickening(2√P, K)`: so do `S₁` and `Q − Pc`
    have h₁ := hS₁K ω (hω.mono_right hK₁)
    have h₂ := hQPcK ω (hω.mono_right hK₂)
    simp only [hsub] at h₂ ⊢
    linarith

/-- **Simon Ch. 6, Deformation Theorem 5.3** (5.1 after a change of scale) for an integer
multiplicity `T ∈ 𝒟ₙ(ℝᴾ)`, `n = m + 1 < P`, with integer multiplicity `∂T`, vanishing off a compact
`K`: `T − Π = ∂R + S` with `Π = Σ_{p ∈ s} β_p [[F_p]]` an integer combination of the oriented
faces `F_p = ρ(z_p + F_{ι_p})` of the cubical grid of side `ρ`, `(Σ|β_p|)ρⁿ ≤ c M(T)`,
`M(R) ≤ cρ M(T)`, `M(S) ≤ cρ M(∂T)`, and everything within `2√P ρ` of `K`.  As printed before 5.3:
change scale by `x ↦ ρ⁻¹x`, apply the unit-scale theorem 5.1 to `T' = δ_{ρ⁻¹#}T` (integer
multiplicity, `∂T' = δ_{ρ⁻¹#}∂T` integer multiplicity, vanishing off the compact `ρ⁻¹K`) and
change scale back by `δ_ρ(x) = ρx`.  `δ_ρ` maps the unit faces onto the faces of side `ρ`, with
`∫_{ρA} g dHⁿ = ρⁿ ∫_A g(ρx) dHⁿ(x)` and `δ_{ρ#}X(ω) = X(ρⁿ ω(ρ ·))`; masses of `k`-currents scale
by `ρᵏ`; and `ρ · cthickening(2√P, ρ⁻¹K) ⊆ cthickening(2√P ρ, K)`. -/
theorem Submission.dor_lmb_fc_deformation : ((∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (n + 1)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → RT.Represents T → RB.Represents T.boundary → LipschitzWith L f → ∃ Ps : ℝ → GeometricCurrentOn U n, (∀ W : Set (Euclid P), IsOpen W → AEMeasurable (fun t => (Ps t).massOn W) ∧ ∫⁻ t, (Ps t).massOn W ≤ (L : ℝ≥0∞) * T.massOn W) ∧ ∀ᵐ t, IsIntegerMultiplicity (Ps t) ∧ (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (f ⁻¹' {t}) → Ps t ω = 0) ∧ ∀ ω : TestFormOn U n, Ps t ω = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → ∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 0 ≤ c ∧ ∀ (ρ : ℝ) (K : Set (Euclid P)) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 0 < ρ → IsCompact K → IsIntegerMultiplicity T → IsIntegerMultiplicity T.boundary → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) K → T ω = 0) → ∃ (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (β : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℤ) (Pc : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ p ∈ s, StrictMono p.2) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Pc ω = ∑ p ∈ s, (β p : ℝ) * ∫ x in {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧ (i ∉ Set.range p.2 → x i = ρ * p.1 i)}, (ω : DifferentialForm (Euclid P) (m + 1)) x (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) ∂μHE[m + 1]) ∧ IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), T ω - Pc ω = R.boundary ω + S ω) ∧ (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞)) * ENNReal.ofReal (ρ ^ (m + 1)) ≤ ENNReal.ofReal c * T.mass ∧ R.mass ≤ ENNReal.ofReal (c * ρ) * T.mass ∧ S.mass ≤ ENNReal.ofReal (c * ρ) * T.boundary.mass ∧ (∀ p ∈ s, {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧ (i ∉ Set.range p.2 → x i = ρ * p.1 i)} ⊆ cthickening (2 * Real.sqrt P * ρ) K) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 2), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 2))) (cthickening (2 * Real.sqrt P * ρ) K) → R ω = 0) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (cthickening (2 * Real.sqrt P * ρ) K) → S ω = 0 := by
  intro hSL P m hPm
  -- Theorem 5.1 at unit scale, and the dilations `δ_λ(x) = λx`
  obtain ⟨c, hc, hunit⟩ :=
    Submission.dor_lmb_fcd_unit_deformation hSL Submission.dor_lmb_fc_im_series P m hPm
  obtain ⟨dil, hdil⟩ := Submission.dor_lmb_fcd_dilation P
  refine ⟨c, hc, fun ρ K T hρ hK hT hbT hTK => ?_⟩
  have hρ' : 0 < ρ⁻¹ := inv_pos.mpr hρ
  obtain ⟨-, hinv, hmass, hIM, -, hvan, -, -⟩ := hdil (m + 1) ρ⁻¹ hρ'
  obtain ⟨-, -, hmass₀, hIM₀, hbd₀, -, -, -⟩ := hdil m ρ⁻¹ hρ'
  obtain ⟨-, -, hmassρ, hIMρ, hbdρ, hvanρ, hactρ, hcovρ⟩ := hdil (m + 1) ρ hρ
  obtain ⟨-, -, hmassρ₂, hIMρ₂, -, hvanρ₂, -, -⟩ := hdil (m + 2) ρ hρ
  -- `T' = δ_{ρ⁻¹#}T` is integer multiplicity with integer multiplicity boundary
  -- `∂T' = δ_{ρ⁻¹#}∂T`, and it vanishes off the compact `ρ⁻¹K`
  have hK' : IsCompact ((fun x : Euclid P => ρ⁻¹ • x) '' K) := hK.image (continuous_const_smul ρ⁻¹)
  have hbT' : (dil (m + 1) ρ⁻¹ T).boundary = dil m ρ⁻¹ T.boundary := hbd₀ T
  have hbT'IM : IsIntegerMultiplicity (dil (m + 1) ρ⁻¹ T).boundary := by
    rw [hbT']
    exact hIM₀ _ hbT
  obtain ⟨s, β, Pc', R', S', hmono, hPc', hR', hS', hTPc', hβ, hR'mass, hS'mass, hface',
      hR'van, hS'van⟩ := hunit _ (dil (m + 1) ρ⁻¹ T) hK' (hIM T hT) hbT'IM (hvan T K hTK)
  -- `δ_{ρ#}T' = T`
  have hTT : dil (m + 1) ρ (dil (m + 1) ρ⁻¹ T) = T := by
    simpa only [inv_inv] using hinv T
  -- `δ_{ρ#}X(ω) = X(η)` with the same test form `η = ρ^{m+1} ω(ρ ·)` for every `X`
  have hpull : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1),
      ∃ η : TestFormOn (univ : Set (Euclid P)) (m + 1),
        (∀ x, (η : DifferentialForm (Euclid P) (m + 1)) x =
          ρ ^ (m + 1) • (ω : DifferentialForm (Euclid P) (m + 1)) (ρ • x)) ∧
        ∀ X : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), dil (m + 1) ρ X ω = X η := by
    intro ω
    obtain ⟨η, hη, -⟩ := hactρ T ω
    refine ⟨η, hη, fun X => ?_⟩
    obtain ⟨η', hη', hX⟩ := hactρ X ω
    rw [hX, show η' = η from Subtype.ext (funext fun x => (hη' x).trans (hη x).symm)]
  -- the faces of side `ρ` are the images under `δ_ρ` of the unit faces
  have hface : ∀ p : (Fin P → ℤ) × (Fin (m + 1) → Fin P),
      {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧
        (i ∉ Set.range p.2 → x i = ρ * p.1 i)} =
      (fun x => ρ • x) '' {x : Euclid P | ∀ i : Fin P,
        (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧
          (i ∉ Set.range p.2 → x i = p.1 i)} := by
    intro p
    ext x
    simp only [Set.mem_ofPred_eq, Set.mem_image]
    constructor
    · intro hx
      refine ⟨ρ⁻¹ • x, fun i => ?_, smul_inv_smul₀ hρ.ne' x⟩
      rw [PiLp.smul_apply, smul_eq_mul]
      refine ⟨fun hi => ?_, fun hi => ?_⟩
      · obtain ⟨h₁, h₂⟩ := (hx i).1 hi
        exact ⟨(le_inv_mul_iff₀ hρ).mpr h₁, (inv_mul_le_iff₀ hρ).mpr h₂⟩
      · rw [(hx i).2 hi, inv_mul_cancel_left₀ hρ.ne']
    · rintro ⟨y, hy, rfl⟩ i
      rw [PiLp.smul_apply, smul_eq_mul]
      refine ⟨fun hi => ?_, fun hi => ?_⟩
      · obtain ⟨h₁, h₂⟩ := (hy i).1 hi
        exact ⟨mul_le_mul_of_nonneg_left h₁ hρ.le, mul_le_mul_of_nonneg_left h₂ hρ.le⟩
      · rw [(hy i).2 hi]
  -- `δ_ρ(cthickening(2√P, ρ⁻¹K)) ⊆ cthickening(2√P ρ, K)`
  have hthick : (fun x => ρ • x) '' cthickening (2 * Real.sqrt P)
      ((fun x : Euclid P => ρ⁻¹ • x) '' K) ⊆ cthickening (2 * Real.sqrt P * ρ) K := by
    rintro _ ⟨y, hy, rfl⟩
    rw [hK'.cthickening_eq_biUnion_closedBall (by positivity)] at hy
    obtain ⟨_, ⟨k, hk, rfl⟩, hyk⟩ := mem_iUnion₂.mp hy
    refine mem_cthickening_of_dist_le _ k _ K hk ?_
    calc dist (ρ • y) k = dist (ρ • y) (ρ • ρ⁻¹ • k) := by rw [smul_inv_smul₀ hρ.ne']
      _ = ρ * dist y (ρ⁻¹ • k) := by rw [dist_smul₀, Real.norm_of_nonneg hρ.le]
      _ ≤ ρ * (2 * Real.sqrt P) := by
        gcongr
        exact mem_closedBall.mp hyk
      _ = 2 * Real.sqrt P * ρ := by ring
  -- `Π = δ_{ρ#}Π'`, `R = δ_{ρ#}R'`, `S = δ_{ρ#}S'`
  refine ⟨s, β, dil (m + 1) ρ Pc', dil (m + 2) ρ R', dil (m + 1) ρ S', hmono, fun ω => ?_,
    hIMρ₂ R' hR', hIMρ S' hS', fun ω => ?_, ?_, ?_, ?_, fun p hp => ?_,
    fun ω hω => hvanρ₂ R' _ hR'van ω (hω.mono_right hthick),
    fun ω hω => hvanρ S' _ hS'van ω (hω.mono_right hthick)⟩
  · -- `Π(ω) = Π'(ρ^{m+1} ω(ρ ·)) = Σ_p β_p ρ^{m+1} ∫_{F¹_p} ω(ρx)(e_{ι_p}) dHⁿ(x)`, which is
    -- `Σ_p β_p [[F_p]](ω)` by the change of variables `x ↦ ρx`
    obtain ⟨η, hη, hX⟩ := hpull ω
    rw [hX, hPc']
    simp_rw [hη, ContinuousAlternatingMap.smul_apply, smul_eq_mul, integral_const_mul]
    refine Finset.sum_congr rfl fun p _ => ?_
    rw [hface p, hcovρ]
  · -- `T − Π = δ_{ρ#}(T' − Π') = δ_{ρ#}(∂R' + S') = ∂R + S`
    obtain ⟨η, -, hX⟩ := hpull ω
    have hRb : (dil (m + 2) ρ R').boundary = dil (m + 1) ρ R'.boundary := hbdρ R'
    rw [← hTT, hRb]
    simp only [hX]
    exact hTPc' η
  · -- `(Σ|β_p|)ρⁿ ≤ c M(T')ρⁿ = c M(T)`
    have h1 : ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) * ENNReal.ofReal (ρ ^ (m + 1)) = 1 := by
      rw [← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ ρ⁻¹ ^ (m + 1)), ← mul_pow,
        inv_mul_cancel₀ hρ.ne', one_pow, ENNReal.ofReal_one]
    calc (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞)) * ENNReal.ofReal (ρ ^ (m + 1))
        ≤ ENNReal.ofReal c * (dil (m + 1) ρ⁻¹ T).mass * ENNReal.ofReal (ρ ^ (m + 1)) := by
          gcongr
      _ = ENNReal.ofReal c * T.mass *
          (ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) * ENNReal.ofReal (ρ ^ (m + 1))) := by
          rw [hmass T]
          ring
      _ = ENNReal.ofReal c * T.mass := by rw [h1, mul_one]
  · -- `M(R) = ρ^{m+2} M(R') ≤ ρ^{m+2} c M(T') = cρ M(T)`
    have h2 : ENNReal.ofReal (ρ ^ (m + 2)) * (ENNReal.ofReal c * ENNReal.ofReal (ρ⁻¹ ^ (m + 1))) =
        ENNReal.ofReal (c * ρ) := by
      rw [← ENNReal.ofReal_mul hc, ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ ρ ^ (m + 2))]
      congr 1
      calc ρ ^ (m + 2) * (c * ρ⁻¹ ^ (m + 1)) = c * ρ * (ρ * ρ⁻¹) ^ (m + 1) := by ring
        _ = c * ρ := by rw [mul_inv_cancel₀ hρ.ne', one_pow, mul_one]
    calc (dil (m + 2) ρ R').mass = ENNReal.ofReal (ρ ^ (m + 2)) * R'.mass := hmassρ₂ R'
      _ ≤ ENNReal.ofReal (ρ ^ (m + 2)) * (ENNReal.ofReal c * (dil (m + 1) ρ⁻¹ T).mass) := by
          gcongr
      _ = ENNReal.ofReal (ρ ^ (m + 2)) * (ENNReal.ofReal c * ENNReal.ofReal (ρ⁻¹ ^ (m + 1))) *
          T.mass := by
          rw [hmass T]
          ring
      _ = ENNReal.ofReal (c * ρ) * T.mass := by rw [h2]
  · -- `M(S) = ρ^{m+1} M(S') ≤ ρ^{m+1} c M(∂T') = cρ M(∂T)`
    have h3 : ENNReal.ofReal (ρ ^ (m + 1)) * (ENNReal.ofReal c * ENNReal.ofReal (ρ⁻¹ ^ m)) =
        ENNReal.ofReal (c * ρ) := by
      rw [← ENNReal.ofReal_mul hc, ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ ρ ^ (m + 1))]
      congr 1
      calc ρ ^ (m + 1) * (c * ρ⁻¹ ^ m) = c * ρ * (ρ * ρ⁻¹) ^ m := by ring
        _ = c * ρ := by rw [mul_inv_cancel₀ hρ.ne', one_pow, mul_one]
    calc (dil (m + 1) ρ S').mass = ENNReal.ofReal (ρ ^ (m + 1)) * S'.mass := hmassρ S'
      _ ≤ ENNReal.ofReal (ρ ^ (m + 1)) *
          (ENNReal.ofReal c * (dil (m + 1) ρ⁻¹ T).boundary.mass) := by
          gcongr
      _ = ENNReal.ofReal (ρ ^ (m + 1)) * (ENNReal.ofReal c * ENNReal.ofReal (ρ⁻¹ ^ m)) *
          T.boundary.mass := by
          rw [hbT', hmass₀]
          ring
      _ = ENNReal.ofReal (c * ρ) * T.boundary.mass := by rw [h3]
  · -- `F_p = δ_ρ(F¹_p) ⊆ δ_ρ(cthickening(2√P, ρ⁻¹K)) ⊆ cthickening(2√P ρ, K)`
    rw [hface p]
    exact (image_mono (hface' p hp)).trans hthick

/-- **Top-dimensional Deformation Theorem** (Simon Ch. 6, Theorem 5.3 in the case `n = P`, which
the book excludes; step 2(c) of the flat-convergence argument).  Assume (SL).  For `n = m + 1 = P`
there is `c ≥ 0` such that every IM `T ∈ 𝒟ₙ(ℝᴾ)` with IM boundary, vanishing off a compact `K`,
splits for every `ρ > 0` as `T − Π = ∂R + S`: `Π` is an integer combination of the grid cubes
`ρ(z + [0, 1]ᴾ)`, `R = 0`, `S` is IM, `(Σ|β|)ρⁿ ≤ c M(T)`, `M(S) ≤ cρ M(∂T)`, and the cubes, `R`
and `S` lie in `cthickening(2√(P+1)ρ, K)`.
Proof: embed `ι₀ x = (x, 0)`; `T̃ = ι₀#T` and `∂T̃ = ι₀#∂T` are IM with the masses of `T`, `∂T`,
and `T̃` vanishes off `ι₀(K)`.  Deform `T̃` in `ℝ^{P+1}` (codimension one): `T̃ − Π̃ = ∂R̃ + S̃`.
Test this on `ω̃ = ζ · p^#ω`, `p` the projection and `ζ = 1` near the cells: `T̃(ω̃) = T(ω)`
(`p ∘ ι₀ = id`), `∂R̃(ω̃) = R̃(p^#dω) = 0` since `(n + 1)`-covectors on `ℝⁿ` vanish, vertical
cells drop out and horizontal ones project isometrically onto grid cubes.  So `Π := T − S` with
`S(ω) := S̃(ω̃)` is an integer cube chain, hence IM, and `S = T − Π` is IM; `|ω̃(y)| ≤ |ω(py)|`
gives `M(S) ≤ M(S̃)`, and `p(cthickening(r, ι₀(K))) ⊆ cthickening(r, K)` gives the supports. -/
theorem Submission.dor_lmb_fc_deformation_top : ((∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (n + 1)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → RT.Represents T → RB.Represents T.boundary → LipschitzWith L f → ∃ Ps : ℝ → GeometricCurrentOn U n, (∀ W : Set (Euclid P), IsOpen W → AEMeasurable (fun t => (Ps t).massOn W) ∧ ∫⁻ t, (Ps t).massOn W ≤ (L : ℝ≥0∞) * T.massOn W) ∧ ∀ᵐ t, IsIntegerMultiplicity (Ps t) ∧ (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (f ⁻¹' {t}) → Ps t ω = 0) ∧ ∀ ω : TestFormOn U n, Ps t ω = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → ∀ (P m : ℕ), m + 1 = P → ∃ c : ℝ, 0 ≤ c ∧ ∀ (ρ : ℝ) (K : Set (Euclid P)) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 0 < ρ → IsCompact K → IsIntegerMultiplicity T → IsIntegerMultiplicity T.boundary → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) K → T ω = 0) → ∃ (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (β : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℤ) (Pc : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ p ∈ s, StrictMono p.2) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Pc ω = ∑ p ∈ s, (β p : ℝ) * ∫ x in {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧ (i ∉ Set.range p.2 → x i = ρ * p.1 i)}, (ω : DifferentialForm (Euclid P) (m + 1)) x (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) ∂μHE[m + 1]) ∧ IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), T ω - Pc ω = R.boundary ω + S ω) ∧ (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞)) * ENNReal.ofReal (ρ ^ (m + 1)) ≤ ENNReal.ofReal c * T.mass ∧ R.mass ≤ ENNReal.ofReal (c * ρ) * T.mass ∧ S.mass ≤ ENNReal.ofReal (c * ρ) * T.boundary.mass ∧ (∀ p ∈ s, {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧ (i ∉ Set.range p.2 → x i = ρ * p.1 i)} ⊆ cthickening (2 * Real.sqrt (P + 1) * ρ) K) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 2), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 2))) (cthickening (2 * Real.sqrt (P + 1) * ρ) K) → R ω = 0) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (cthickening (2 * Real.sqrt (P + 1) * ρ) K) → S ω = 0 := by
  intro hSL P m hmP
  subst hmP
  classical
  -- Step 3 (constant): Deformation Theorem 5.3 in `ℝ^{P+1}`, valid as `m + 1 < P + 1`
  obtain ⟨c₀, hc₀, hdef⟩ := Submission.dor_lmb_fc_deformation hSL (m + 1 + 1) m (by omega)
  refine ⟨c₀, hc₀, fun ρ K T hρ hK hT hbT hTK => ?_⟩
  -- Notation: the projection `p y = (y₀, …, y_{P-1})` and the embedding `ι₀ x = (x, 0)`
  let p : Euclid (m + 1 + 1) →L[ℝ] Euclid (m + 1) :=
    (EuclideanSpace.equiv (Fin (m + 1)) ℝ).symm.toContinuousLinearMap.comp
      (ContinuousLinearMap.pi fun i => EuclideanSpace.proj (Fin.castSucc i))
  have hp : ∀ (y : Euclid (m + 1 + 1)) (i : Fin (m + 1)), p y i = y (Fin.castSucc i) :=
    fun y i => rfl
  let ι₀ : Euclid (m + 1) →L[ℝ] Euclid (m + 1 + 1) :=
    (EuclideanSpace.equiv (Fin (m + 1 + 1)) ℝ).symm.toContinuousLinearMap.comp
      (ContinuousLinearMap.pi (Fin.snoc (α := fun _ => Euclid (m + 1) →L[ℝ] ℝ)
        (fun i => EuclideanSpace.proj i) 0))
  have hιc : ∀ (x : Euclid (m + 1)) (i : Fin (m + 1)), ι₀ x (Fin.castSucc i) = x i := by
    intro x i
    simp [ι₀]
  have hιl : ∀ x : Euclid (m + 1), ι₀ x (Fin.last (m + 1)) = 0 := by
    intro x
    simp [ι₀]
  have hpι : ∀ x, p (ι₀ x) = x := fun x => by
    ext i
    rw [hp, hιc]
  -- `ι₀` is a linear isometric embedding, hence proper, and `p` is `1`-Lipschitz
  have hιiso : Isometry ι₀ := by
    refine AddMonoidHomClass.isometry_of_norm ι₀ fun x => ?_
    rw [EuclideanSpace.norm_eq (ι₀ x), EuclideanSpace.norm_eq x,
      Fin.sum_univ_castSucc (fun j => ‖(ι₀ x).ofLp j‖ ^ 2)]
    simp [hιc, hιl]
  have hιprop : IsProperMap (fun x => (0 : Euclid (m + 1 + 1)) + ι₀ x) := by
    simpa only [zero_add] using hιiso.isClosedEmbedding.isProperMap
  have hpL : LipschitzWith 1 p := by
    refine LipschitzWith.of_dist_le_mul fun y y' => ?_
    rw [dist_eq_norm, dist_eq_norm, ← map_sub, NNReal.coe_one, one_mul,
      EuclideanSpace.norm_eq (p (y - y')), EuclideanSpace.norm_eq (y - y')]
    refine Real.sqrt_le_sqrt ?_
    rw [Fin.sum_univ_castSucc (fun j => ‖(y - y').ofLp j‖ ^ 2)]
    simp only [hp]
    exact le_add_of_nonneg_right (by positivity)
  -- `(m + 2)`-covectors on the `(m + 1)`-dimensional `ℝ^P` vanish
  have hcov0 : ∀ α : Covector (Euclid (m + 1)) (m + 1 + 1), α = 0 := by
    intro α
    ext v
    refine α.toAlternatingMap.map_linearDependent v fun hli => ?_
    have := hli.fintype_card_le_finrank
    simp at this
  -- Steps 1–2: `T̃ = ι₀#T` and `∂T̃ = ι₀#∂T` are IM, `M(T̃) = M(T)` and `M(∂T̃) = M(∂T)`
  obtain ⟨hTtIM, hTtmass⟩ := Submission.dor_lmb_fc_dtop_isometric_pushforward_im (m + 1)
    (m + 1 + 1) (m + 1) ι₀ hιprop T hιiso hT
  obtain ⟨hbTtIM, hbTtmass⟩ := Submission.dor_lmb_fc_dtop_isometric_pushforward_im (m + 1)
    (m + 1 + 1) m ι₀ hιprop T.boundary hιiso hbT
  have hbTt : (GeometricCurrentOn.affinePushforward (V := (univ : Set (Euclid (m + 1 + 1))))
      ι₀ 0 hιprop T).boundary = GeometricCurrentOn.affinePushforward
        (V := (univ : Set (Euclid (m + 1 + 1)))) ι₀ 0 hιprop T.boundary :=
    GeometricCurrentOn.boundary_affinePushforward (V := (univ : Set (Euclid (m + 1 + 1))))
      ι₀ 0 hιprop T
  set Tt := GeometricCurrentOn.affinePushforward (V := (univ : Set (Euclid (m + 1 + 1))))
    ι₀ 0 hιprop T
  -- `T̃` vanishes off the compact set `ι₀(K)`: `tsupport(ι₀^#η) ⊆ ι₀⁻¹(tsupport η)`
  have hTtK : ∀ η : TestFormOn (univ : Set (Euclid (m + 1 + 1))) (m + 1),
      Disjoint (tsupport (η : DifferentialForm (Euclid (m + 1 + 1)) (m + 1))) (ι₀ '' K) →
        Tt η = 0 := by
    intro η hη
    refine hTK (affinePullbackTestOn ι₀ 0 hιprop univ (m + 1) η)
      (Set.disjoint_left.2 fun x hx hxK => ?_)
    have hx' := tsupport_affinePullbackForm_subset ι₀ 0
      (η : DifferentialForm (Euclid (m + 1 + 1)) (m + 1)) hx
    simp only [mem_preimage, zero_add] at hx'
    exact Set.disjoint_left.1 hη hx' (mem_image_of_mem ι₀ hxK)
  -- Step 3: the deformation `T̃ − Π̃ = ∂R̃ + S̃` in `ℝ^{P+1}`, with `K' = ι₀(K)`
  have hK' : IsCompact (ι₀ '' K) := hK.image ι₀.continuous
  obtain ⟨st, βt, Pct, Rt, St, hst, hPct, -, -, hdecomp, hβt, -, hStmass, hcells, hRtvan,
    hStvan⟩ := hdef ρ (ι₀ '' K) Tt hρ hK' hTtIM (by rw [hbTt]; exact hbTtIM) hTtK
  have hrad : 2 * Real.sqrt ((m + 1 + 1 : ℕ) : ℝ) * ρ =
      2 * Real.sqrt (((m + 1 : ℕ) : ℝ) + 1) * ρ := by
    rw [Nat.cast_succ (m + 1)]
  rw [hrad] at hcells hRtvan hStvan
  set r := 2 * Real.sqrt (((m + 1 : ℕ) : ℝ) + 1) * ρ
  have hKt : IsCompact (cthickening r (ι₀ '' K)) := hK'.cthickening
  -- `p(K̃) ⊆ cthickening(r, K)` for `K̃ = cthickening(r, ι₀(K))`, by `p ∘ ι₀ = id` and `Lip p ≤ 1`
  have hpK : ∀ y ∈ cthickening r (ι₀ '' K), p y ∈ cthickening r K := by
    intro y hy
    rw [mem_cthickening_iff] at hy ⊢
    refine le_trans (le_infEDist.2 fun z hz => ?_) hy
    obtain ⟨x, hx, rfl⟩ := hz
    calc infEDist (p y) K ≤ edist (p y) x := infEDist_le_edist_of_mem hx
      _ = edist (p y) (p (ι₀ x)) := by rw [hpι]
      _ ≤ edist y (ι₀ x) := by simpa using hpL.edist_le_mul y (ι₀ x)
  -- Step 4: the cut-off pull-back `ω ↦ ω̃ = ζ · p^#ω`, equal to `p^#ω` on an open `V ⊇ K̃`
  obtain ⟨V, E, hVo, hKtV, hEeq, hdEeq, hEsupp, hEnorm, hEcont⟩ :=
    Submission.dor_lmb_fc_dtop_cutoff_pullback (m + 1) (m + 1) p hp _ hKt
  have hKι : K ⊆ ι₀ ⁻¹' V := fun x hx =>
    hKtV (self_subset_cthickening _ (mem_image_of_mem ι₀ hx))
  -- 5(d): `S(ω) := S̃(ω̃)` is a current in `ℝ^P`, `ω ↦ ω̃` being sequentially continuous
  let S : GeometricCurrentOn (univ : Set (Euclid (m + 1))) (m + 1) :=
    { toCurrent := St.toCurrent.comp E
      continuous' := fun ωs h => St.continuous' (fun j => E (ωs j)) (hEcont ωs h) }
  -- 5(a): `T̃(ω̃) = T(ι₀^# ω̃) = T(ω)`, since `ι₀^# ω̃ = ω` on the open `ι₀⁻¹(V) ⊇ K`
  have h5a : ∀ ω : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1), Tt (E ω) = T ω := by
    intro ω
    let X : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1) :=
      affinePullbackTestOn ι₀ 0 hιprop univ (m + 1) (E ω)
    have hX : ∀ x, ι₀ x ∈ V → affinePullbackForm ι₀ 0
        (E ω : DifferentialForm (Euclid (m + 1 + 1)) (m + 1)) x =
          (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) x := by
      intro x hx
      simp only [affinePullbackForm, zero_add]
      rw [hEeq ω (ι₀ x) hx]
      ext v
      have hv : ⇑p ∘ ⇑ι₀ ∘ v = v := funext fun k => hpι (v k)
      simp only [ContinuousAlternatingMap.compContinuousLinearMap_apply, hpι, hv]
    -- `ω − ι₀^# ω̃` vanishes on `ι₀⁻¹(V) ⊇ K`, so `T` kills it
    have hsub : tsupport ((ω - X : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1)) :
        DifferentialForm (Euclid (m + 1)) (m + 1)) ⊆ (ι₀ ⁻¹' V)ᶜ := by
      refine closure_minimal (fun x hx hxV => hx ?_)
        (hVo.preimage ι₀.continuous).isClosed_compl
      show (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) x - affinePullbackForm ι₀ 0
        (E ω : DifferentialForm (Euclid (m + 1 + 1)) (m + 1)) x = 0
      rw [hX x hxV, sub_self]
    have hvan := hTK (ω - X) (Disjoint.mono_left hsub (disjoint_compl_left_iff_subset.2 hKι))
    have hlin : T (ω - X) = T ω - T X := T.toCurrent.map_sub ω X
    rw [hlin, sub_eq_zero] at hvan
    exact hvan.symm
  -- 5(b): `∂R̃(ω̃) = R̃(dω̃) = 0`, as `dω̃ = p^#(dω) = 0` on `V ⊇ K̃`
  have h5b : ∀ ω : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1),
      Rt.boundary (E ω) = 0 := by
    intro ω
    have hsub : tsupport (exteriorDerivative
        (E ω : DifferentialForm (Euclid (m + 1 + 1)) (m + 1))) ⊆ Vᶜ := by
      refine closure_minimal (fun y hy hyV => hy ?_) hVo.isClosed_compl
      rw [hdEeq ω y hyV,
        hcov0 (exteriorDerivative (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) (p y))]
      ext v
      simp
    exact hRtvan (exteriorDerivativeTestOn univ (m + 1) (E ω))
      (Disjoint.mono_left hsub (disjoint_compl_left_iff_subset.2 hKtV))
  -- 5(c): the cells `F̃_q` of `Π̃`, the grid cubes `G_z` of `ℝ^P`, and the horizontal cells `H`
  let F : (Fin (m + 1 + 1) → ℤ) × (Fin (m + 1) → Fin (m + 1 + 1)) → Set (Euclid (m + 1 + 1)) :=
    fun q => {y | ∀ i : Fin (m + 1 + 1), (i ∈ Set.range q.2 → ρ * q.1 i ≤ y i ∧
      y i ≤ ρ * (q.1 i + 1)) ∧ (i ∉ Set.range q.2 → y i = ρ * q.1 i)}
  have hFmeas : ∀ q, MeasurableSet (F q) := by
    intro q
    refine IsClosed.measurableSet ?_
    show IsClosed {y : Euclid (m + 1 + 1) | ∀ i : Fin (m + 1 + 1), _}
    rw [Set.ofPred_forall]
    refine isClosed_iInter fun i => ?_
    by_cases hi : i ∈ Set.range q.2
    · simp only [hi, true_implies, not_true_eq_false, false_implies, and_true, Set.ofPred_and]
      exact (isClosed_le continuous_const (PiLp.continuous_apply 2 (fun _ => ℝ) i)).inter
        (isClosed_le (PiLp.continuous_apply 2 (fun _ => ℝ) i) continuous_const)
    · simp only [hi, false_implies, not_false_eq_true, true_implies, true_and]
      exact isClosed_eq (PiLp.continuous_apply 2 (fun _ => ℝ) i) continuous_const
  let g : (Fin (m + 1 + 1) → ℤ) × (Fin (m + 1) → Fin (m + 1 + 1)) → (Fin (m + 1) → ℤ) :=
    fun q i => q.1 (Fin.castSucc i)
  let I : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1) → (Fin (m + 1) → ℤ) → ℝ :=
    fun ω z => ∫ x in {x : Euclid (m + 1) | ∀ i : Fin (m + 1), ρ * z i ≤ x i ∧
      x i ≤ ρ * (z i + 1)}, (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) x
        (fun k => EuclideanSpace.single k (1 : ℝ)) ∂μHE[m + 1]
  set H := st.filter fun q => Fin.last (m + 1) ∉ Set.range q.2 with hH
  set s' := H.image g
  set β' : (Fin (m + 1) → ℤ) → ℤ := fun z => ∑ q ∈ H with g q = z, βt q with hβ'
  -- on a cell `ω̃ = p^#ω`; a vertical cell gives `0`, a horizontal one the cube `G_{g q}`
  have hcell : ∀ (ω : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1))
      (q : (Fin (m + 1 + 1) → ℤ) × (Fin (m + 1) → Fin (m + 1 + 1))), q ∈ st →
      ∫ y in F q, (E ω : DifferentialForm (Euclid (m + 1 + 1)) (m + 1)) y
        (fun k => EuclideanSpace.single (q.2 k) (1 : ℝ)) ∂μHE[m + 1] =
        if Fin.last (m + 1) ∈ Set.range q.2 then 0 else I ω (g q) := by
    intro ω q hq
    obtain ⟨hvert, hhor⟩ := Submission.dor_lmb_fc_dtop_projected_cell_integral (m + 1) ρ p
      q.1 q.2 hp (hst q hq)
    have hEq : ∫ y in F q, (E ω : DifferentialForm (Euclid (m + 1 + 1)) (m + 1)) y
        (fun k => EuclideanSpace.single (q.2 k) (1 : ℝ)) ∂μHE[m + 1] =
        ∫ y in F q, (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) (p y)
          (fun k => p (EuclideanSpace.single (q.2 k) (1 : ℝ))) ∂μHE[m + 1] := by
      refine setIntegral_congr_fun (hFmeas q) fun y hy => ?_
      show (E ω : DifferentialForm (Euclid (m + 1 + 1)) (m + 1)) y
          (fun k => EuclideanSpace.single (q.2 k) (1 : ℝ)) =
        (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) (p y)
          (fun k => p (EuclideanSpace.single (q.2 k) (1 : ℝ)))
      rw [hEeq ω y (hKtV (hcells q hq hy)),
        ContinuousAlternatingMap.compContinuousLinearMap_apply]
      rfl
    rw [hEq]
    split_ifs with hlast
    · exact hvert hlast _
    · exact (hhor hlast).1 _
  -- `Π̃(ω̃) = Σ_{z ∈ s'} β'_z ∫_{G_z} ω(e₀, …, e_{P-1}) dHᴾ`, regrouping horizontal cells by `g`
  have hPcE : ∀ ω : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1),
      Pct (E ω) = ∑ z ∈ s', (β' z : ℝ) * I ω z := by
    intro ω
    rw [hPct (E ω)]
    calc _ = ∑ q ∈ st, (βt q : ℝ) *
          (if Fin.last (m + 1) ∈ Set.range q.2 then 0 else I ω (g q)) := by
          refine Finset.sum_congr rfl fun q hq => ?_
          congr 1
          exact hcell ω q hq
      _ = ∑ q ∈ H, (βt q : ℝ) * I ω (g q) := by
          rw [hH, Finset.sum_filter]
          refine Finset.sum_congr rfl fun q _ => ?_
          by_cases h : Fin.last (m + 1) ∈ Set.range q.2 <;> simp [h]
      _ = ∑ z ∈ s', ∑ q ∈ H with g q = z, (βt q : ℝ) * I ω (g q) :=
          (Finset.sum_fiberwise_of_maps_to (fun q hq => Finset.mem_image_of_mem g hq) _).symm
      _ = ∑ z ∈ s', (β' z : ℝ) * I ω z := by
          refine Finset.sum_congr rfl fun z _ => ?_
          calc ∑ q ∈ H with g q = z, (βt q : ℝ) * I ω (g q)
              = ∑ q ∈ H with g q = z, (βt q : ℝ) * I ω z :=
                Finset.sum_congr rfl fun q hq => by rw [(Finset.mem_filter.1 hq).2]
            _ = (β' z : ℝ) * I ω z := by
                rw [← Finset.sum_mul]
                simp only [hβ', Int.cast_sum]
  -- Step 6: `Π := T − S` is the cube chain (by 5(a)–(c) and step 3), and `R := 0`
  have hPc : ∀ ω : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1),
      (T - S) ω = ∑ z ∈ s', (β' z : ℝ) * I ω z := by
    intro ω
    have h := hdecomp (E ω)
    rw [h5a ω, h5b ω, zero_add] at h
    rw [← hPcE ω]
    show T ω - St (E ω) = Pct (E ω)
    linarith
  -- Step 7: `Π` is IM (an integer cube chain), hence so is `S = T − Π`; `R = 0` is IM
  have hPcIM : IsIntegerMultiplicity (T - S) :=
    Submission.dor_lmb_fc_dtop_cube_chain_im m ρ s' β' (T - S) hρ hPc
  have hSIM : IsIntegerMultiplicity S := by
    have hSeq : S = T - (T - S) := GeometricCurrentOn.ext fun ω => by
      show S ω = T ω - (T ω - S ω)
      ring
    rw [hSeq]
    exact (Submission.cmc_imRep_locality_restrict_sub).2.2.1 (m + 1) (m + 1) univ T (T - S)
      isOpen_univ hT hPcIM
  have hR0IM :
      IsIntegerMultiplicity (0 : GeometricCurrentOn (univ : Set (Euclid (m + 1))) (m + 2)) := by
    refine ⟨{ carrier := ∅
              mult := fun _ => 0
              orient := fun _ => 0
              measurableSet_carrier := MeasurableSet.empty
              carrier_subset := empty_subset _
              rectifiable :=
                Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty
              measurable_mult := measurable_const
              mult_pos := fun x hx => by simp at hx
              locallyIntegrable_mult := fun K _ _ => by simp
              aestronglyMeasurable_orient := aestronglyMeasurable_const
              orients := by simp }, fun ω => ?_⟩
    simp [IMRep.action]
  -- the cells `(z, id)` of `ℝ^P` for `z ∈ s'`, with coefficients `β'_z`
  set s := s'.image fun z => (z, (id : Fin (m + 1) → Fin (m + 1))) with hs
  set β : (Fin (m + 1) → ℤ) × (Fin (m + 1) → Fin (m + 1)) → ℤ := fun q => β' q.1
  have hinj : Set.InjOn (fun z : Fin (m + 1) → ℤ => (z, (id : Fin (m + 1) → Fin (m + 1))))
      ↑s' := fun z _ z' _ h => congrArg Prod.fst h
  -- Step 8: `Σ|β| ≤ Σ|β̃|`, and `M(S) ≤ M(S̃)` as `|ω̃(y)| ≤ |ω(py)|`
  have hsum : ∑ q ∈ s, ((β q).natAbs : ℝ≥0∞) ≤ ∑ q ∈ st, ((βt q).natAbs : ℝ≥0∞) := by
    rw [hs, Finset.sum_image hinj]
    calc ∑ z ∈ s', ((β (z, id)).natAbs : ℝ≥0∞)
        ≤ ∑ z ∈ s', ∑ q ∈ H with g q = z, ((βt q).natAbs : ℝ≥0∞) := by
          refine Finset.sum_le_sum fun z _ => ?_
          have h1 : (β (z, id)).natAbs ≤ ∑ q ∈ H with g q = z, (βt q).natAbs :=
            Int.natAbs_sum_le _ _
          exact_mod_cast h1
      _ = ∑ q ∈ H, ((βt q).natAbs : ℝ≥0∞) :=
          Finset.sum_fiberwise_of_maps_to (fun q hq => Finset.mem_image_of_mem g hq) _
      _ ≤ ∑ q ∈ st, ((βt q).natAbs : ℝ≥0∞) :=
          Finset.sum_le_sum_of_subset (Finset.filter_subset _ _)
  have hSmass : S.mass ≤ St.mass := by
    refine sSup_le ?_
    rintro _ ⟨ω, hω, rfl⟩
    exact St.le_massOn ⟨subset_univ _, fun y => (hEnorm ω y).trans (hω.2 (p y))⟩
  -- Step 9: `G_z = p(F̃_q) ⊆ p(K̃) ⊆ cthickening(r, K)`, and `S` vanishes off `cthickening(r, K)`
  have hcellsub : ∀ q ∈ s, {x : Euclid (m + 1) | ∀ i : Fin (m + 1), (i ∈ Set.range q.2 →
      ρ * q.1 i ≤ x i ∧ x i ≤ ρ * (q.1 i + 1)) ∧ (i ∉ Set.range q.2 → x i = ρ * q.1 i)} ⊆
        cthickening r K := by
    intro q hq x hx
    obtain ⟨z, hz, rfl⟩ := Finset.mem_image.1 hq
    obtain ⟨q', hq', rfl⟩ := Finset.mem_image.1 hz
    obtain ⟨hq'st, hq'h⟩ := Finset.mem_filter.1 hq'
    obtain ⟨-, hhor⟩ := Submission.dor_lmb_fc_dtop_projected_cell_integral (m + 1) ρ p
      q'.1 q'.2 hp (hst q' hq'st)
    obtain ⟨y, hy, rfl⟩ := (hhor hq'h).2 x fun i => (hx i).1 (by simp)
    exact hpK y (hcells q' hq'st hy)
  have hSvan : ∀ ω : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1),
      Disjoint (tsupport (ω : DifferentialForm (Euclid (m + 1)) (m + 1))) (cthickening r K) →
        S ω = 0 := fun ω hω => hStvan (E ω) (Set.disjoint_left.2 fun y hy hyK =>
          Set.disjoint_left.1 hω (hEsupp ω hy) (hpK y hyK))
  refine ⟨s, β, T - S, 0, S, ?_, fun ω => ?_, hR0IM, hSIM, fun ω => ?_, ?_, ?_, ?_, hcellsub,
    fun ω _ => rfl, hSvan⟩
  · intro q hq
    obtain ⟨z, -, rfl⟩ := Finset.mem_image.1 hq
    exact strictMono_id
  · -- the cell formula: `F_{(z, id)} = G_z`
    rw [hPc ω, hs, Finset.sum_image hinj]
    refine Finset.sum_congr rfl fun z _ => ?_
    have hset : {x : Euclid (m + 1) | ∀ i : Fin (m + 1),
        (i ∈ Set.range (id : Fin (m + 1) → Fin (m + 1)) → ρ * z i ≤ x i ∧
          x i ≤ ρ * (z i + 1)) ∧ (i ∉ Set.range (id : Fin (m + 1) → Fin (m + 1)) →
            x i = ρ * z i)} =
        {x : Euclid (m + 1) | ∀ i : Fin (m + 1), ρ * z i ≤ x i ∧ x i ≤ ρ * (z i + 1)} := by
      ext x
      simp
    show (β' z : ℝ) * I ω z = (β' z : ℝ) * ∫ x in {x : Euclid (m + 1) | ∀ i : Fin (m + 1),
        (i ∈ Set.range (id : Fin (m + 1) → Fin (m + 1)) → ρ * z i ≤ x i ∧
          x i ≤ ρ * (z i + 1)) ∧ (i ∉ Set.range (id : Fin (m + 1) → Fin (m + 1)) →
            x i = ρ * z i)},
        (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) x
          (fun k => EuclideanSpace.single k (1 : ℝ)) ∂μHE[m + 1]
    rw [hset]
  · -- `T − Π = S = ∂0 + S`
    show T ω - (T ω - S ω) =
      (0 : GeometricCurrentOn (univ : Set (Euclid (m + 1))) (m + 2)).boundary ω + S ω
    rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.zero_apply]
    ring
  · calc (∑ q ∈ s, ((β q).natAbs : ℝ≥0∞)) * ENNReal.ofReal (ρ ^ (m + 1))
        ≤ (∑ q ∈ st, ((βt q).natAbs : ℝ≥0∞)) * ENNReal.ofReal (ρ ^ (m + 1)) :=
          mul_le_mul_of_nonneg_right hsum zero_le
      _ ≤ ENNReal.ofReal c₀ * Tt.mass := hβt
      _ = ENNReal.ofReal c₀ * T.mass := by rw [hTtmass]
  · -- `M(R) = M(0) = 0`
    refine le_trans (sSup_le ?_) zero_le
    rintro _ ⟨ω, -, rfl⟩
    simp
  · calc S.mass ≤ St.mass := hSmass
      _ ≤ ENNReal.ofReal (c₀ * ρ) * Tt.boundary.mass := hStmass
      _ = ENNReal.ofReal (c₀ * ρ) * T.boundary.mass := by rw [hbTt, hbTtmass]

/-- **Simon Ch. 6, proof of Theorem 7.2, (1)–(3)** (total boundedness): given `Λ < ∞` and
`ε > 0` there is a finite set `𝒬` of `(m+1)`-currents in `U` such that every integer multiplicity
`A ∈ 𝒟_{m+1}(U)` with `∂A` integer multiplicity, vanishing off the compact `K ⊆ U`, with
`M(A), M(∂A) ≤ Λ`, satisfies `A − Q = ∂R + S` for some `Q ∈ 𝒬` and integer multiplicity `R`, `S`
with `M(R) + M(S) < ε`.  If `m + 1 > P` every current of degree `m + 1` is `0` and `𝒬 = {0}`.
Otherwise extend `A` by zero to `Y ∈ 𝒟_{m+1}(ℝᴾ)`, apply the deformation theorem (`m + 1 < P`, or
its top-dimensional case `m + 1 = P`) to `Y` with a grid size `ρ` such that `2cρΛ < ε`, and
restrict back to `U`: the polyhedral part is an integer chain on the finitely many grid cells in
`cthickening (rρ) K` with coefficients at most `cΛ/ρ^{m+1}`, and restriction to `U` keeps
integer multiplicity without increasing mass. -/
theorem Submission.dor_lmb_fc_total_bounded : ((∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (n + 1)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → RT.Represents T → RB.Represents T.boundary → LipschitzWith L f → ∃ Ps : ℝ → GeometricCurrentOn U n, (∀ W : Set (Euclid P), IsOpen W → AEMeasurable (fun t => (Ps t).massOn W) ∧ ∫⁻ t, (Ps t).massOn W ≤ (L : ℝ≥0∞) * T.massOn W) ∧ ∀ᵐ t, IsIntegerMultiplicity (Ps t) ∧ (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (f ⁻¹' {t}) → Ps t ω = 0) ∧ ∀ ω : TestFormOn U n, Ps t ω = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → ∀ (P m : ℕ) (U K : Set (Euclid P)) (Λ ε : ℝ≥0∞), IsOpen U → IsCompact K → K ⊆ U → Λ ≠ ∞ → 0 < ε → ∃ 𝒬 : Set (GeometricCurrentOn U (m + 1)), 𝒬.Finite ∧ ∀ A : GeometricCurrentOn U (m + 1), IsIntegerMultiplicity A → IsIntegerMultiplicity A.boundary → (∀ ω : TestFormOn U (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) K → A ω = 0) → A.mass ≤ Λ → A.boundary.mass ≤ Λ → ∃ Q ∈ 𝒬, ∃ (R : GeometricCurrentOn U (m + 2)) (S : GeometricCurrentOn U (m + 1)), IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ (∀ ω : TestFormOn U (m + 1), A ω - Q ω = R.boundary ω + S ω) ∧ R.mass + S.mass < ε := by
  intro hSL P m U K Λ ε hU hK hKU hΛ hε
  -- restriction from `ℝᴾ` to `U` does not increase mass: a form admissible in `U` is admissible
  -- in `ℝᴾ`, with the same value
  have hres : ∀ (d : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) d),
      (X.restrictDomain (subset_univ U)).mass ≤ X.mass := by
    intro d X
    apply sSup_le
    rintro _ ⟨ω, hω, rfl⟩
    exact X.le_massOn (W := univ) (omega := testFormOnInclusion (subset_univ U) d ω)
      ⟨subset_univ _, hω.2⟩
  -- the zero current has mass `0`
  have hzero : ∀ d : ℕ, (0 : GeometricCurrentOn U d).mass = 0 := by
    intro d
    refine le_antisymm (sSup_le ?_) zero_le
    rintro _ ⟨ω, -, rfl⟩
    simp
  -- Step 0: for `m + 1 > P` every current of degree `m + 1` is `0`, and `𝒬 = {0}` works
  by_cases hdeg : P < m + 1
  · refine ⟨{0}, finite_singleton 0, fun A _ _ _ _ _ => ⟨0, mem_singleton 0, 0, 0,
      Submission.dor_lmb_fc_tb_zero_isIntegerMultiplicity P (m + 2) U,
      Submission.dor_lmb_fc_tb_zero_isIntegerMultiplicity P (m + 1) U, fun ω => ?_, ?_⟩⟩
    · rw [Submission.dor_lmb_fc_tb_eq_zero_of_lt_degree P (m + 1) U A hdeg]
      simp
    · simpa [hzero] using hε
  -- the deformation theorem in degree `m + 1 ≤ P` (`m + 1 < P`, or `m + 1 = P`), with constant
  -- `c`, the cells lying within distance `r ρ` of `K`
  obtain ⟨c, r, hc, hdef⟩ : ∃ c r : ℝ, 0 ≤ c ∧ ∀ (ρ : ℝ) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 0 < ρ → IsIntegerMultiplicity T → IsIntegerMultiplicity T.boundary → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) K → T ω = 0) → ∃ (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (β : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℤ) (Pc : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Pc ω = ∑ p ∈ s, (β p : ℝ) * ∫ x in {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧ (i ∉ Set.range p.2 → x i = ρ * p.1 i)}, (ω : DifferentialForm (Euclid P) (m + 1)) x (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) ∂μHE[m + 1]) ∧ IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), T ω - Pc ω = R.boundary ω + S ω) ∧ (∑ p ∈ s, ((β p).natAbs : ℝ≥0∞)) * ENNReal.ofReal (ρ ^ (m + 1)) ≤ ENNReal.ofReal c * T.mass ∧ R.mass ≤ ENNReal.ofReal (c * ρ) * T.mass ∧ S.mass ≤ ENNReal.ofReal (c * ρ) * T.boundary.mass ∧ ∀ p ∈ s, {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → ρ * p.1 i ≤ x i ∧ x i ≤ ρ * (p.1 i + 1)) ∧ (i ∉ Set.range p.2 → x i = ρ * p.1 i)} ⊆ cthickening (r * ρ) K := by
    rcases (not_lt.mp hdeg).lt_or_eq with hlt | heq
    · obtain ⟨c, hc, hD⟩ := Submission.dor_lmb_fc_deformation hSL P m hlt
      refine ⟨c, 2 * Real.sqrt P, hc, fun ρ T hρ hT hbT hTK => ?_⟩
      obtain ⟨s, β, Pc, R, S, -, hPc, hR, hS, hid, hβ, hRm, hSm, hcell, -, -⟩ :=
        hD ρ K T hρ hK hT hbT hTK
      exact ⟨s, β, Pc, R, S, hPc, hR, hS, hid, hβ, hRm, hSm, hcell⟩
    · obtain ⟨c, hc, hD⟩ := Submission.dor_lmb_fc_deformation_top hSL P m heq
      refine ⟨c, 2 * Real.sqrt (P + 1), hc, fun ρ T hρ hT hbT hTK => ?_⟩
      obtain ⟨s, β, Pc, R, S, -, hPc, hR, hS, hid, hβ, hRm, hSm, hcell, -, -⟩ :=
        hD ρ K T hρ hK hT hbT hTK
      exact ⟨s, β, Pc, R, S, hPc, hR, hS, hid, hβ, hRm, hSm, hcell⟩
  -- Step 1: a grid size `ρ > 0` with `2 c ρ Λ < δ`, where `0 < δ < ε`
  obtain ⟨δ, -, hδ0, hδε⟩ := ENNReal.lt_iff_exists_real_btwn.mp hε
  have hδ : 0 < δ := ENNReal.ofReal_pos.mp hδ0
  have hΛr : 0 ≤ Λ.toReal := ENNReal.toReal_nonneg
  have hcΛ : 0 ≤ c * Λ.toReal := mul_nonneg hc hΛr
  obtain ⟨ρ, hρ, hρδ⟩ := exists_pos_mul_lt hδ (2 * c * Λ.toReal)
  have hsmall : 2 * (c * ρ * Λ.toReal) < δ :=
    calc 2 * (c * ρ * Λ.toReal) = 2 * c * Λ.toReal * ρ := by ring
      _ < δ := hρδ
  -- Step 2: `𝒬` is the finite set of integer chains on the grid cells in `cthickening (r ρ) K`
  -- with coefficients at most `c Λ / ρ^{m+1}`
  refine ⟨_, Submission.dor_lmb_fc_tb_cell_chains_finite P m U (cthickening (r * ρ) K) ρ
    ⌊c * Λ.toReal / ρ ^ (m + 1)⌋₊ hρ hK.cthickening, ?_⟩
  intro A hA hbA hAK hAm hbAm
  -- Step 3: extension of `A` by zero to `Y ∈ 𝒟_{m+1}(ℝᴾ)` with `∂Y` integer multiplicity
  obtain ⟨Y, hY, hbY, hYA, hYK, hYm, hbYm⟩ :=
    Submission.dor_lmb_fc_tb_extend_univ_boundary P m U K A hU hK hKU hA hbA hAK
  have hYΛ : Y.mass ≤ Λ := hYm.trans hAm
  have hbYΛ : Y.boundary.mass ≤ Λ := hbYm.trans hbAm
  -- Step 4: deformation of `Y`: `Y − Π = ∂R̂ + Ŝ`
  obtain ⟨s, β, Pc, R, S, hPc, hR, hS, hid, hβ, hRm, hSm, hcell⟩ := hdef ρ Y hρ hY hbY hYK
  -- Step 5: restriction to `U`: `Q = Π⌞U`, `R = R̂⌞U` and `S = Ŝ⌞U`
  refine ⟨Pc.restrictDomain (subset_univ U), ⟨s, β, hcell, fun p hp => ?_, fun ω => ?_⟩,
    R.restrictDomain (subset_univ U), S.restrictDomain (subset_univ U),
    Submission.dtc_restrictDomain_isIntegerMultiplicity P (m + 2) univ U (subset_univ U) R hU hR,
    Submission.dtc_restrictDomain_isIntegerMultiplicity P (m + 1) univ U (subset_univ U) S hU hS,
    fun ω => ?_, ?_⟩
  · -- `|β_p| ρ^{m+1} ≤ (Σ_q |β_q|) ρ^{m+1} ≤ c M(Y) ≤ c Λ`
    have h1 : ((β p).natAbs : ℝ≥0∞) * ENNReal.ofReal (ρ ^ (m + 1)) ≤
        ENNReal.ofReal (c * Λ.toReal) :=
      calc ((β p).natAbs : ℝ≥0∞) * ENNReal.ofReal (ρ ^ (m + 1))
          ≤ (∑ q ∈ s, ((β q).natAbs : ℝ≥0∞)) * ENNReal.ofReal (ρ ^ (m + 1)) := by
            gcongr
            exact Finset.single_le_sum (f := fun q => ((β q).natAbs : ℝ≥0∞))
              (fun _ _ => zero_le) hp
        _ ≤ ENNReal.ofReal c * Y.mass := hβ
        _ ≤ ENNReal.ofReal c * Λ := by gcongr
        _ = ENNReal.ofReal (c * Λ.toReal) := by
            rw [ENNReal.ofReal_mul hc, ENNReal.ofReal_toReal hΛ]
    have h2 : ((β p).natAbs : ℝ) * ρ ^ (m + 1) ≤ c * Λ.toReal := by
      rw [← ENNReal.ofReal_le_ofReal_iff hcΛ, ENNReal.ofReal_mul (Nat.cast_nonneg _),
        ENNReal.ofReal_natCast]
      exact h1
    exact Nat.le_floor ((le_div_iff₀ (pow_pos hρ _)).mpr h2)
  · -- `Q(ω) = Π(ιω)`, and `ιω` has the same underlying form as `ω`
    exact hPc (testFormOnInclusion (subset_univ U) (m + 1) ω)
  · -- `A(ω) − Q(ω) = Y(ιω) − Π(ιω) = ∂R̂(ιω) + Ŝ(ιω)`, where `d(ιω) = ι(dω)`
    rw [← hYA]
    exact hid (testFormOnInclusion (subset_univ U) (m + 1) ω)
  · -- `M(R) + M(S) ≤ M(R̂) + M(Ŝ) ≤ 2 c ρ Λ < ε`
    have hcρ : 0 ≤ c * ρ := mul_nonneg hc hρ.le
    calc (R.restrictDomain (subset_univ U)).mass + (S.restrictDomain (subset_univ U)).mass
        ≤ ENNReal.ofReal (c * ρ) * Λ + ENNReal.ofReal (c * ρ) * Λ := by
          gcongr
          · exact (hres _ R).trans (hRm.trans (by gcongr))
          · exact (hres _ S).trans (hSm.trans (by gcongr))
      _ = ENNReal.ofReal (2 * (c * ρ * Λ.toReal)) := by
          rw [two_mul, ENNReal.ofReal_add (mul_nonneg hcρ hΛr) (mul_nonneg hcρ hΛr),
            ENNReal.ofReal_mul hcρ, ENNReal.ofReal_toReal hΛ]
      _ ≤ ENNReal.ofReal δ := ENNReal.ofReal_le_ofReal hsmall.le
      _ < ε := hδε

/-- **Simon Ch. 6, Theorem 7.2, "only if" part, for cycles** (chapter-06.txt lines 2020–2135):
assume (C1) (`dor_imrep_massOn_eq_measure_and_support`).  Let `n ≥ 1`, `U ⊆ ℝ^P` open, and let
`T_j, T ∈ 𝒟ₙ(U)` be integer multiplicity with `∂T_j = 0`, `∂T = 0`, `T_j ⇀ T` in `U` and
`sup_j M_V(T_j) < ∞` for every open `V ⊂⊂ U`.  Then for every open `W ⊂⊂ U` there are integer
multiplicity `R_j ∈ 𝒟ₙ₊₁(U)`, `S_j ∈ 𝒟ₙ(U)` with `T − T_j = ∂R_j + S_j` in `U` and
`M_W(R_j) + M_W(S_j) → 0`, i.e. `d_W(T_j, T) → 0`.

Step 0: if `W = ∅` then `M_∅ ≡ 0`, and `R_j = 0`, `S_j = T − T_j` work.  Otherwise put
`d_W(T, T_j) = inf {M_W(R) + M_W(S) : T − T_j = ∂R + S, R, S integer multiplicity}` (Simon 7.1).
Pairs with cost `≤ d_W(T, T_j) + 2⁻ʲ` prove the theorem once `d_W(T, T_j) → 0`, and for this it
suffices that every subsequence `T_{ns(j)}` has a further subsequence along which
`d_W(T, ·) → 0`.
Step 1 (`dor_lmb_fc_localize`, with the slicing theorem `dor_lmb_slicing_lipschitz`): a
subsequence `T_{ns(φ(j))}` and integer multiplicity `T'_j ⇀ T'` (the restrictions to a good
sublevel set of `dist(·, W̄)`) that agree with `T_{ns(φ(j))}`, `T` on forms supported in `W`,
vanish off a compact `K ⊆ U`, and have `M(T'_j), M(∂T'_j) ≤ Λ < ∞`.
Steps 2–3 (`dor_lmb_fc_total_bounded`, `dor_lmb_fc_cauchy_subseq`): the `T'_j` are totally bounded
for the flat distance, so `T'_{θ(r+1)} − T'_{θ(r)} = ∂R_r + S_r` with `M(R_r) + M(S_r) ≤ 2⁻ʳ`.
Step 4 (`dor_lmb_fc_series_limit`): `T' − T'_{θ(ℓ)} = ∂R' + S'` with `M(R') + M(S') ≤ 2·2⁻ˡ`.
Step 5: `T − T_{ns(φ(θ(ℓ)))} = ∂R' + S̃` with
`S̃ = (S' − (T' − T)) − (T_{ns(φ(θ(ℓ)))} − T'_{θ(ℓ)})`, integer multiplicity (differences,
`cmc_imRep_locality_restrict_sub`), and `M_W(S̃) = M_W(S')` because both bracketed differences
vanish on forms supported in `W`.  Hence `d_W(T, T_{ns(φ(θ(ℓ)))}) ≤ 2·2⁻ˡ → 0`. -/
theorem Submission.dor_lmb_flat_convergence_cycles : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P n : ℕ) (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U n) (T : GeometricCurrentOn U n), IsOpen U → 0 < n → (∀ j, IsIntegerMultiplicity (Ts j)) → IsIntegerMultiplicity T → (∀ j, BoundaryVanishes (Ts j)) → BoundaryVanishes T → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, (Ts j).massOn W < ∞) → WeaklyConvergesOn Ts T → ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ∃ (Rs : ℕ → GeometricCurrentOn U (n + 1)) (Ss : ℕ → GeometricCurrentOn U n), (∀ j, IsIntegerMultiplicity (Rs j)) ∧ (∀ j, IsIntegerMultiplicity (Ss j)) ∧ (∀ j (ω : TestFormOn U n), T ω - Ts j ω = (Rs j).boundary ω + Ss j ω) ∧ Tendsto (fun j => (Rs j).massOn W + (Ss j).massOn W) atTop (𝓝 0) := by
  intro _ P n U Ts T hU hn hTsIM hTIM hTsB _ hbd hconv W _ hWU
  -- write `n = m + 1`, so that `∂T_j = 0` reads `(Ts j).boundary = 0`
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, (Nat.succ_pred_eq_of_pos hn).symm⟩
  have hsub_apply : ∀ {k : ℕ} (A B : GeometricCurrentOn U k) (ω : TestFormOn U k),
      (A - B) ω = A ω - B ω := fun _ _ _ => rfl
  -- differences of integer multiplicity currents (`cmc_imRep_locality_restrict_sub` (c))
  have hsub : ∀ {k : ℕ} (A B : GeometricCurrentOn U k), IsIntegerMultiplicity A →
      IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B) :=
    fun A B hA hB => Submission.cmc_imRep_locality_restrict_sub.2.2.1 P _ U A B hU hA hB
  -- `0 = τ(∅, 1, 0)` is integer multiplicity, and `T − T_j = ∂0 + (T − T_j)`
  have hIM0 : IsIntegerMultiplicity (0 : GeometricCurrentOn U (m + 1 + 1)) := by
    refine ⟨{ carrier := ∅
              mult := fun _ => 1
              orient := fun _ => 0
              measurableSet_carrier := MeasurableSet.empty
              carrier_subset := empty_subset U
              rectifiable :=
                Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty
              measurable_mult := measurable_const
              mult_pos := fun _ _ => Nat.one_pos
              locallyIntegrable_mult := fun K _ _ => by simp
              aestronglyMeasurable_orient := aestronglyMeasurable_const
              orients := by simp }, fun ω => ?_⟩
    simp [IMRep.action]
  have htriv : ∀ j (ω : TestFormOn U (m + 1)),
      T ω - Ts j ω = (0 : GeometricCurrentOn U (m + 1 + 1)).boundary ω + (T - Ts j) ω := by
    intro j ω
    rw [hsub_apply, GeometricCurrentOn.boundary_apply, GeometricCurrentOn.zero_apply, zero_add]
  -- Step 0: if `W = ∅`, then `M_∅ ≡ 0`, and `R_j = 0`, `S_j = T − T_j` work
  rcases W.eq_empty_or_nonempty with rfl | hWne
  · have hmass : ∀ {k : ℕ} (A : GeometricCurrentOn U k), A.massOn ∅ = 0 := by
      intro k A
      refine le_antisymm (sSup_le ?_) zero_le
      rintro _ ⟨ω, hω, rfl⟩
      have h0 : ω = 0 := Subtype.ext (funext fun x => by
        by_contra hx
        exact hω.1 (subset_tsupport _ hx))
      simp [h0]
    refine ⟨fun _ => 0, fun j => T - Ts j, fun _ => hIM0, fun j => hsub _ _ hTIM (hTsIM j),
      htriv, ?_⟩
    simp only [hmass, add_zero]
    exact tendsto_const_nhds
  have hWsub : W ⊆ U := subset_closure.trans hWU.2
  -- `M_W` only sees forms supported in `W`
  have hcongr : ∀ {k : ℕ} (A B : GeometricCurrentOn U k), (∀ ω : TestFormOn U k,
      tsupport (ω : DifferentialForm (Euclid P) k) ⊆ W → A ω = B ω) →
      A.massOn W = B.massOn W := by
    intro k A B h
    unfold GeometricCurrentOn.massOn
    congr 1
    exact Set.image_congr fun ω hω => congrArg ENNReal.ofReal (h ω hω.1)
  have hε : Tendsto (fun j : ℕ => (2⁻¹ : ℝ≥0∞) ^ j) atTop (𝓝 0) :=
    ENNReal.tendsto_pow_atTop_nhds_zero_of_lt_one (ENNReal.inv_lt_one.2 ENNReal.one_lt_two)
  -- the flat distance `d_W(T, T_j)` (Simon 7.1)
  obtain ⟨d, hd⟩ : ∃ d : ℕ → ℝ≥0∞, ∀ j, d j = ⨅ (R : GeometricCurrentOn U (m + 1 + 1))
      (S : GeometricCurrentOn U (m + 1)) (_ : IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧
        ∀ ω : TestFormOn U (m + 1), T ω - Ts j ω = R.boundary ω + S ω),
      R.massOn W + S.massOn W := ⟨_, fun _ => rfl⟩
  -- Step 0: once `d_W(T, T_j) → 0`, pairs with cost `≤ d_W(T, T_j) + 2⁻ʲ` prove the theorem
  suffices hd0 : Tendsto d atTop (𝓝 0) by
    have hpair : ∀ j, ∃ (R : GeometricCurrentOn U (m + 1 + 1)) (S : GeometricCurrentOn U (m + 1)),
        (IsIntegerMultiplicity R ∧ IsIntegerMultiplicity S ∧
          ∀ ω : TestFormOn U (m + 1), T ω - Ts j ω = R.boundary ω + S ω) ∧
        R.massOn W + S.massOn W ≤ d j + (2⁻¹ : ℝ≥0∞) ^ j := by
      intro j
      by_cases hdj : d j = ∞
      · exact ⟨0, T - Ts j, ⟨hIM0, hsub _ _ hTIM (hTsIM j), htriv j⟩, by simp [hdj]⟩
      have hlt : d j < d j + (2⁻¹ : ℝ≥0∞) ^ j :=
        ENNReal.lt_add_right hdj (pow_ne_zero j (ENNReal.inv_ne_zero.2 ENNReal.ofNat_ne_top))
      obtain ⟨R, hR⟩ := iInf_lt_iff.1 ((hd j).symm.trans_lt hlt)
      obtain ⟨S, hS⟩ := iInf_lt_iff.1 hR
      obtain ⟨hRS, hcost⟩ := iInf_lt_iff.1 hS
      exact ⟨R, S, hRS, hcost.le⟩
    choose Rs Ss hRS hcost using hpair
    refine ⟨Rs, Ss, fun j => (hRS j).1, fun j => (hRS j).2.1, fun j => (hRS j).2.2, ?_⟩
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds ?_ (fun _ => zero_le)
      hcost
    simpa only [add_zero] using hd0.add hε
  -- Step 0: it suffices that every subsequence has a further subsequence along which
  -- `d_W(T, ·) → 0`
  refine tendsto_of_subseq_tendsto fun ns hns => ?_
  -- Step 1: localization of `T_{ns(j)}` (`dor_lmb_fc_localize`)
  obtain ⟨φ, K, Λ, Ts', T', -, hK, hKU, hΛ, hTs'IM, hTs'BIM, hT'IM, hTs'K, hTs'mass, hTs'conv,
      hTs'W, hT'W⟩ := Submission.dor_lmb_fc_localize Submission.dor_lmb_slicing_lipschitz P m U W
    (fun j => Ts (ns j)) T hU (fun j => hTsIM (ns j)) hTIM (fun j => hTsB (ns j))
    (fun V hV hVU => (iSup_le fun j => le_iSup (fun i => (Ts i).massOn V) (ns j)).trans_lt
      (hbd V hV hVU)) (fun ω => (hconv ω).comp hns) hWne hWU
  -- Steps 2–3: total boundedness (`dor_lmb_fc_total_bounded`) gives a subsequence with
  -- `T'_{θ(r+1)} − T'_{θ(r)} = ∂R_r + S_r`, `M(R_r) + M(S_r) ≤ 2⁻ʳ` (`dor_lmb_fc_cauchy_subseq`)
  obtain ⟨θ, hθ, hcauchy⟩ := Submission.dor_lmb_fc_cauchy_subseq P m U Ts' hU fun ε hε0 => by
    obtain ⟨𝒬, h𝒬, hnet⟩ := Submission.dor_lmb_fc_total_bounded
      Submission.dor_lmb_slicing_lipschitz P m U K Λ ε hU hK hKU hΛ hε0
    exact ⟨𝒬, h𝒬, fun j => hnet (Ts' j) (hTs'IM j) (hTs'BIM j) (hTs'K j) (hTs'mass j).1
      (hTs'mass j).2⟩
  choose Rc Sc hRSc using hcauchy
  -- Step 4: `T' − T'_{θ(ℓ)} = ∂R' + S'` with `M(R') + M(S') ≤ 2·2⁻ˡ` (`dor_lmb_fc_series_limit`)
  have hlim := Submission.dor_lmb_fc_series_limit P m U (fun r => Ts' (θ r)) T' Rc Sc hU
    (fun ω => (hTs'conv ω).comp hθ.tendsto_atTop) hRSc
  refine ⟨fun ℓ => φ (θ ℓ), ?_⟩
  -- Step 5: `d_W(T, T_{ns(φ(θ(ℓ)))}) ≤ 2·2⁻ˡ`
  have hle : ∀ ℓ, d (ns (φ (θ ℓ))) ≤ 2 * (2⁻¹ : ℝ≥0∞) ^ ℓ := by
    intro ℓ
    obtain ⟨R', S', hR', hS', heq, hmass⟩ := hlim ℓ
    -- `S₁ = S̃ = (S' − (T' − T)) − (T_{ns(φ(θ(ℓ)))} − T'_{θ(ℓ)})`
    set S₁ : GeometricCurrentOn U (m + 1) :=
      (S' - (T' - T)) - (Ts (ns (φ (θ ℓ))) - Ts' (θ ℓ)) with hS₁
    have hS₁IM : IsIntegerMultiplicity S₁ :=
      hsub _ _ (hsub _ _ hS' (hsub _ _ hT'IM hTIM)) (hsub _ _ (hTsIM _) (hTs'IM _))
    have hS₁eq : ∀ ω : TestFormOn U (m + 1),
        T ω - Ts (ns (φ (θ ℓ))) ω = R'.boundary ω + S₁ ω := by
      intro ω
      have h := heq ω
      simp only [hS₁, hsub_apply]
      linarith
    -- the bracketed differences vanish on forms supported in `W`
    have hS₁W : S₁.massOn W = S'.massOn W := by
      refine hcongr _ _ fun ω hω => ?_
      have h₁ : T' ω = T ω := hT'W ω hω
      have h₂ : Ts' (θ ℓ) ω = Ts (ns (φ (θ ℓ))) ω := hTs'W (θ ℓ) ω hω
      simp only [hS₁, hsub_apply, h₁, h₂]
      ring
    calc d (ns (φ (θ ℓ))) ≤ R'.massOn W + S₁.massOn W :=
          (hd _).trans_le (iInf_le_of_le R' (iInf_le_of_le S₁
            (iInf_le_of_le ⟨hR', hS₁IM, hS₁eq⟩ le_rfl)))
      _ = R'.massOn W + S'.massOn W := by rw [hS₁W]
      _ ≤ R'.mass + S'.mass := add_le_add (R'.massOn_mono hWsub) (S'.massOn_mono hWsub)
      _ ≤ 2 * (2⁻¹ : ℝ≥0∞) ^ ℓ := hmass
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds ?_ (fun _ => zero_le) hle
  simpa only [mul_zero] using ENNReal.Tendsto.const_mul hε (Or.inr ENNReal.ofNat_ne_top)

/-- **Lemma M: limsup bound for the masses of the `Tⱼ` near `y ∈ N`** (Simon 7.2.4 and Remark
7.2.5(2), as used in the proof of 7.4.3; the proof of 7.2.4, chapter-07.txt lines 176–290, with
the competitor projected into `N`, README erratum 5).  `dor_lmb_c1_retraction` gives `r`, `c_π`
and a `C¹` retraction `π` onto `N` near `y` with `‖Dπ(x)‖ ≤ 1 + c_π|x − y|`; monotonicity (C3) and
C1 give `μ_{Tⱼ}(B_s(y)) ≤ c₂sⁿ` for `0 < s ≤ r₀`.  Put `r₁ = min(r₀/3, r/3, 1/(6c_π + 1))`,
`c = 3c_π` and `c₁ = n·c·2ⁿ·3ⁿ·c₂`.  For `0 < ε < ρ < r₁`, flat convergence on
`W = B_{ρ+ε}(y)` writes `T − Tⱼ = ∂Rⱼ + Sⱼ` with `M_W(Rⱼ) + M_W(Sⱼ) → 0`; the level cut at some
`t ∈ (ρ, ρ + ε)` (chosen for each `j`, so no subsequence is needed) and the comparison with the
projected competitor (`Z = Tⱼ`) give
`M_{B_ρ}(Tⱼ) ≤ (1 + cρ)ⁿ(M_W(T) + M_W(Sⱼ) + (2/ε)M_W(Rⱼ)) + ((1 + cρ)ⁿ − 1)c₂(3ρ)ⁿ`, and
`(1 + a)ⁿ − 1 ≤ n·a·2ⁿ` (`0 ≤ a ≤ 1`) bounds the last term by `c₁ρⁿ⁺¹`.  Let `j → ∞`. -/
theorem Submission.dor_minimizing_limsup_mass_bound : ∀ (n k ℓ : ℕ), ℓ ≤ k → 0 < n → ∀ (U N : Set (Euclid (n + k))) (Ts : ℕ → GeometricCurrentOn U n) (T : GeometricCurrentOn U n) (y : Euclid (n + k)), IsOpen U → IsEmbeddedSubmanifold 2 (n + ℓ) N → (closure N \ N) ∩ U = ∅ → (∀ j, IsMinimizingIn (Ts j) (U ∩ N)) → IsIntegerMultiplicity T → (∀ j, (Ts j).support ⊆ N) → (∀ j, BoundaryVanishes (Ts j)) → BoundaryVanishes T → (∀ j, ∀ R : IMRep U n, R.Represents (Ts j) → R.IsStationaryAlong N) → (∀ W : Set (Euclid (n + k)), IsOpen W → CompactlyContained W U → ⨆ j, (Ts j).massOn W < ∞) → WeaklyConvergesOn Ts T → y ∈ N ∩ U → ∃ r₁ c c₁ : ℝ, 0 < r₁ ∧ 0 ≤ c ∧ 0 ≤ c₁ ∧ ∀ ρ ε : ℝ, 0 < ε → ε < ρ → ρ < r₁ → limsup (fun j => (Ts j).massOn (ball y ρ)) atTop ≤ ENNReal.ofReal ((1 + c * ρ) ^ n) * T.massOn (ball y (ρ + ε)) + ENNReal.ofReal (c₁ * ρ ^ (n + 1)) := by
  intro n k ℓ hℓ hn U N Ts T y hU hN hNcl hmin hT hspt hbd hTbd hstat hmass hconv hy
  have C1 := Submission.dor_imrep_massOn_eq_measure_and_support
  -- Step 1(a): the `C¹` retraction `π` onto `N` near `y`, `‖Dπ(x)‖ ≤ 1 + c_π|x − y|`
  obtain ⟨r, cπ, proj, hr, hcπ, hrU, hproj, hprojN, hprojfix, hprojT, hprojD⟩ :=
    Submission.dor_lmb_c1_retraction (n + k) (n + ℓ) U N y hU hN hNcl hy
  -- Step 1(b): monotonicity at `y` for every representation of every `Tⱼ` (C3)
  obtain ⟨r₀, κ, hr₀, hκ, hr₀U, hmono⟩ :=
    Submission.dor_stationary_mean_curvature_monotonicity n k ℓ hℓ hn U N y hU hN hNcl hy
  choose Rj hRj using fun j => (hmin j).1
  have hcc : ∀ s, closedBall y s ⊆ U → CompactlyContained (ball y s) U := fun s hs =>
    ⟨(isCompact_closedBall y s).of_isClosed_subset isClosed_closure closure_ball_subset_closedBall,
      closure_ball_subset_closedBall.trans hs⟩
  -- Step 1(c): `Λ₀ = supⱼ M_{B_{r₀}(y)}(Tⱼ) < ∞`, hence `μ_{Tⱼ}(B_s(y)) ≤ c₂sⁿ` for `0 < s ≤ r₀`
  obtain ⟨Λ₀, hΛ₀0, hΛ₀⟩ : ∃ Λ₀ : ℝ, 0 ≤ Λ₀ ∧
      ∀ j, (Rj j).measure (ball y r₀) ≤ ENNReal.ofReal Λ₀ := by
    refine ⟨(⨆ j, (Ts j).massOn (ball y r₀)).toReal, ENNReal.toReal_nonneg, fun j => ?_⟩
    rw [ENNReal.ofReal_toReal (hmass _ isOpen_ball
      (hcc r₀ ((closedBall_subset_closedBall (by linarith)).trans hr₀U))).ne,
      ← (C1 (n + k) n U (Ts j) (Rj j) hU (hRj j)).1 _ isOpen_ball]
    exact le_iSup (fun j => (Ts j).massOn (ball y r₀)) j
  obtain ⟨c₂, hc₂, hball⟩ : ∃ c₂ : ℝ, 0 ≤ c₂ ∧ ∀ j s, 0 < s → s ≤ r₀ →
      (Rj j).measure (ball y s) ≤ ENNReal.ofReal (c₂ * s ^ n) := by
    refine ⟨Real.exp (κ * r₀) / r₀ ^ n * Λ₀, by positivity, fun j s hs hsr₀ => ?_⟩
    have h1 := (hmono (Ts j) (Rj j) (hRj j) (hspt j) (hstat j (Rj j) (hRj j))).2 y
      (mem_ball_self hr₀) s r₀ hs hsr₀ le_rfl
    have h3 : 1 ≤ Real.exp (κ * s) / s ^ n * s ^ n := by
      rw [div_mul_cancel₀ _ (pow_pos hs n).ne']
      exact Real.one_le_exp (mul_nonneg hκ hs.le)
    calc (Rj j).measure (ball y s)
        ≤ ENNReal.ofReal (Real.exp (κ * s) / s ^ n * s ^ n) * (Rj j).measure (ball y s) :=
          le_mul_of_one_le_left' (ENNReal.one_le_ofReal.2 h3)
      _ = ENNReal.ofReal (s ^ n) *
            (ENNReal.ofReal (Real.exp (κ * s) / s ^ n) * (Rj j).measure (ball y s)) := by
          rw [mul_comm (Real.exp (κ * s) / s ^ n), ENNReal.ofReal_mul (by positivity), mul_assoc]
      _ ≤ ENNReal.ofReal (s ^ n) *
            (ENNReal.ofReal (Real.exp (κ * r₀) / r₀ ^ n) * ENNReal.ofReal Λ₀) :=
          mul_le_mul_right (h1.trans (mul_le_mul_right (hΛ₀ j) _)) _
      _ = ENNReal.ofReal (Real.exp (κ * r₀) / r₀ ^ n * Λ₀ * s ^ n) := by
          rw [← ENNReal.ofReal_mul (show 0 ≤ Real.exp (κ * r₀) / r₀ ^ n by positivity),
            ← ENNReal.ofReal_mul (show 0 ≤ s ^ n by positivity), mul_comm (s ^ n)]
  -- `(1 + a)ᵐ − 1 ≤ m·a·2ᵐ` for `0 ≤ a ≤ 1`
  have hgeom : ∀ (m : ℕ) (a : ℝ), 0 ≤ a → a ≤ 1 → (1 + a) ^ m - 1 ≤ m * a * 2 ^ m := by
    intro m a ha0 ha1
    induction m with
    | zero => simp
    | succ m ih =>
      have h1 : 1 ≤ (1 + a) ^ m := one_le_pow₀ (by linarith)
      have h2 : (1 : ℝ) ≤ 2 ^ m := one_le_pow₀ (by norm_num)
      have h3 : 0 ≤ (m : ℝ) * 2 ^ m := by positivity
      push_cast
      rw [pow_succ, pow_succ]
      nlinarith [mul_le_mul_of_nonneg_left ih ha0,
        mul_nonneg (mul_nonneg ha0 (sub_nonneg.2 ha1)) h3]
  -- Step 1(d): `r₁ = min(r₀/3, r/3, 1/(6c_π + 1))`, `c = 3c_π`, `c₁ = n·c·2ⁿ·3ⁿ·c₂`
  refine ⟨min (r₀ / 3) (min (r / 3) (1 / (6 * cπ + 1))), 3 * cπ,
    (n : ℝ) * (3 * cπ) * 2 ^ n * 3 ^ n * c₂,
    lt_min (by linarith) (lt_min (by linarith) (div_pos one_pos (by linarith))), by linarith,
    by positivity, fun ρ ε hε hερ hρr₁ => ?_⟩
  have hρ : 0 < ρ := hε.trans hερ
  have hρ₀ : ρ < r₀ / 3 := hρr₁.trans_le (min_le_left _ _)
  have hρr : ρ < r / 3 := hρr₁.trans_le ((min_le_right _ _).trans (min_le_left _ _))
  have hρc : ρ * (6 * cπ + 1) < 1 := (lt_div_iff₀ (by linarith)).1
    (hρr₁.trans_le ((min_le_right _ _).trans (min_le_right _ _)))
  have hcπρ : 0 ≤ cπ * ρ := mul_nonneg hcπ hρ.le
  have h4 : 4 * cπ * ρ ≤ 1 := by nlinarith
  have hrρ : 3 * ρ < r := by linarith
  have hcl3 : closedBall y (3 * ρ) ⊆ U := (closedBall_subset_closedBall hrρ.le).trans hrU
  have hclε : closedBall y (ρ + ε) ⊆ U :=
    (closedBall_subset_closedBall (by linarith)).trans hcl3
  -- Step 4: flat convergence on `W = B_{ρ+ε}(y)` (Simon Ch. 6, 7.2)
  obtain ⟨Rs, Ss, hRs, hSs, hdiff, hlim⟩ :=
    Submission.dor_lmb_flat_convergence_cycles C1 (n + k) n U Ts T hU hn (fun j => (hmin j).1) hT
      hbd hTbd hmass hconv (ball y (ρ + ε)) isOpen_ball (hcc _ hclε)
  -- the error term `((1 + cρ)ⁿ − 1)·c₂(3ρ)ⁿ ≤ c₁ρⁿ⁺¹`
  have hΛ1 : 0 ≤ (1 + 3 * cπ * ρ) ^ n - 1 := sub_nonneg.2 (one_le_pow₀ (by linarith))
  have hreal : ((1 + 3 * cπ * ρ) ^ n - 1) * (c₂ * (3 * ρ) ^ n) ≤
      n * (3 * cπ) * 2 ^ n * 3 ^ n * c₂ * ρ ^ (n + 1) :=
    calc ((1 + 3 * cπ * ρ) ^ n - 1) * (c₂ * (3 * ρ) ^ n)
        ≤ n * (3 * cπ * ρ) * 2 ^ n * (c₂ * (3 * ρ) ^ n) :=
          mul_le_mul_of_nonneg_right (hgeom n _ (by positivity) (by linarith)) (by positivity)
      _ = n * (3 * cπ) * 2 ^ n * 3 ^ n * c₂ * ρ ^ (n + 1) := by ring
  -- Steps 5–9 for each `j`: cut `Tⱼ` at a good level `t ∈ (ρ, ρ + ε)` and compare with the
  -- competitor `Tⱼ + π_#X` (Simon (3)–(11))
  have hbound : ∀ j, (Ts j).massOn (ball y ρ) ≤
      ENNReal.ofReal ((1 + 3 * cπ * ρ) ^ n) * (T.massOn (ball y (ρ + ε)) +
        (Ss j).massOn (ball y (ρ + ε)) +
        ENNReal.ofReal (2 / (ρ + ε - ρ)) * (Rs j).massOn (ball y (ρ + ε))) +
      ENNReal.ofReal (n * (3 * cπ) * 2 ^ n * 3 ^ n * c₂ * ρ ^ (n + 1)) := by
    intro j
    obtain ⟨t, X, Y, RY, hρt, htε, hX, hXbd, hXvan, hY, hRY, hRYt⟩ :=
      Submission.dor_lmb_good_level_cut C1 (n + k) n U T (Ts j) (Ss j) (Rs j) y ρ (ρ + ε) hU hn
        hT (hmin j).1 (hSs j) (hRs j) (hdiff j) hρ (by linarith) hclε
    have hcmp := Submission.dor_lmb_projected_competitor_comparison C1 (n + k) (n + ℓ) n U N
      (Ts j) X Y (Rj j) RY proj y r cπ ρ t hU hn hN (hmin j) (hspt j) (hbd j) (hRj j) hX hXbd
      hXvan hY hRY hy.1 hcπ hρ hrρ h4 (by linarith) hcl3 hproj hprojN hprojfix hprojT hprojD
    rw [(C1 (n + k) n U (Ts j) (Rj j) hU (hRj j)).1 _ isOpen_ball]
    calc (Rj j).measure (ball y ρ) ≤ (Rj j).measure (closedBall y t) :=
          measure_mono (ball_subset_closedBall.trans (closedBall_subset_closedBall hρt.le))
      _ ≤ ENNReal.ofReal ((1 + 3 * cπ * ρ) ^ n) * RY.measure (closedBall y t) +
            ENNReal.ofReal ((1 + 3 * cπ * ρ) ^ n - 1) * (Rj j).measure (ball y (3 * ρ)) := hcmp
      _ ≤ ENNReal.ofReal ((1 + 3 * cπ * ρ) ^ n) * (T.massOn (ball y (ρ + ε)) +
            (Ss j).massOn (ball y (ρ + ε)) +
            ENNReal.ofReal (2 / (ρ + ε - ρ)) * (Rs j).massOn (ball y (ρ + ε))) +
            ENNReal.ofReal ((1 + 3 * cπ * ρ) ^ n - 1) * ENNReal.ofReal (c₂ * (3 * ρ) ^ n) :=
          add_le_add (mul_le_mul_right hRYt _)
            (mul_le_mul_right (hball j (3 * ρ) (by linarith) (by linarith)) _)
      _ ≤ _ := by
          rw [← ENNReal.ofReal_mul hΛ1]
          exact add_le_add le_rfl (ENNReal.ofReal_le_ofReal hreal)
  -- Step 10: `M_W(Sⱼ), M_W(Rⱼ) → 0`, so the bound tends to `(1 + cρ)ⁿM_W(T) + c₁ρⁿ⁺¹`
  have hS : Tendsto (fun j => (Ss j).massOn (ball y (ρ + ε))) atTop (𝓝 0) :=
    tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hlim (fun _ => zero_le)
      (fun _ => le_add_self)
  have hR : Tendsto (fun j => (Rs j).massOn (ball y (ρ + ε))) atTop (𝓝 0) :=
    tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hlim (fun _ => zero_le)
      (fun _ => le_self_add)
  have hlim' : Tendsto (fun j => ENNReal.ofReal ((1 + 3 * cπ * ρ) ^ n) *
      (T.massOn (ball y (ρ + ε)) + (Ss j).massOn (ball y (ρ + ε)) +
        ENNReal.ofReal (2 / (ρ + ε - ρ)) * (Rs j).massOn (ball y (ρ + ε))) +
      ENNReal.ofReal (n * (3 * cπ) * 2 ^ n * 3 ^ n * c₂ * ρ ^ (n + 1))) atTop
      (𝓝 (ENNReal.ofReal ((1 + 3 * cπ * ρ) ^ n) *
        (T.massOn (ball y (ρ + ε)) + 0 + ENNReal.ofReal (2 / (ρ + ε - ρ)) * 0) +
        ENNReal.ofReal (n * (3 * cπ) * 2 ^ n * 3 ^ n * c₂ * ρ ^ (n + 1)))) :=
    (ENNReal.Tendsto.const_mul ((tendsto_const_nhds.add hS).add
      (ENNReal.Tendsto.const_mul hR (Or.inr ENNReal.ofReal_ne_top)))
      (Or.inr ENNReal.ofReal_ne_top)).add tendsto_const_nhds
  rw [mul_zero, add_zero, add_zero] at hlim'
  exact (limsup_le_limsup (Eventually.of_forall hbound)).trans_eq hlim'.limsup_eq

/-- **Simon 7.4.3** (with `Nᵢ = N`; chapter-07.txt lines 617–631), the book's appeal to Allard's
theorem made quantitative.  By 7.1.2 every representation of `Tⱼ` and of `T` is stationary in
`U ∩ N`.  The ε-regularity criterion at `y` (radius `r₀`, excess `δ`) makes a support point `z`
with `|z − y| < r₀` regular once `M_{B_ρ(z)} ≤ (1 + δ)ωₙρⁿ` for some `ρ ≤ r₀`.  For `y` this
follows from `Θⁿ(μ_T, y) = 1`, which also gives `y ∈ spt T`.  For `yⱼ`, fix `η > 0` with
`(1 + η)(1 + 2η)ⁿ < 1 + δ` and a small `ρ`: the upper mass bound in the limit gives
`limsup M_{B_{(1+η)ρ}(y)}(Tⱼ) ≤ (1 + c(1+η)ρ)ⁿ M_{B_{(1+2η)ρ}(y)}(T) + c₁((1+η)ρ)ⁿ⁺¹`, which is
`< (1 + δ)ωₙρⁿ`, and `B_ρ(yⱼ) ⊆ B_{(1+η)ρ}(y)` once `|yⱼ − y| < ηρ`.  For `n = 0` a minimizing
current does not meet `U ∩ N`, so this case is vacuous. -/
theorem Submission.density_one_implies_regular : DensityOneImpliesRegular := by
  intro n k ℓ hℓk U N Ts T ys y hU hN hNcl hTsmin hTmin hTsN hTN hTsb hTb hmass hconv hy hdens
    hys hysspt
  -- `Θⁿ(μ_T, y) = 1` forces `y ∈ spt T`: otherwise `T` vanishes on a ball about `y`, where the
  -- density ratios are then `0`.
  have hyT : y ∈ T.support := by
    by_contra hnot
    have hyZ : y ∈ T.zeroRegion := by
      by_contra hyZ
      exact hnot (show y ∈ U \ T.zeroRegion from ⟨hy.2, hyZ⟩)
    obtain ⟨W, ⟨hWo, -, -, hWv⟩, hyW⟩ := mem_sUnion.1 hyZ
    obtain ⟨ε, hε, hεW⟩ := Metric.isOpen_iff.1 hWo y hyW
    have h0 : Tendsto (fun ρ : ℝ => T.massOn (ball y ρ) /
        (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) (𝓝 0) := by
      apply tendsto_nhds_of_eventually_eq
      filter_upwards [Ioo_mem_nhdsGT hε] with ρ hρ
      have hm : T.massOn (ball y ρ) = 0 := by
        refine le_antisymm (sSup_le ?_) zero_le
        rintro r ⟨ω, hω, rfl⟩
        exact (ENNReal.ofReal_eq_zero.2
          (hWv ω (hω.1.trans ((ball_subset_ball hρ.2.le).trans hεW))).le).le
      rw [hm, ENNReal.zero_div]
    have h1 := tendsto_nhds_unique hdens.2 h0
    rw [ENNReal.ofReal_one] at h1
    exact one_ne_zero h1
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · -- `n = 0`: a minimizing `0`-current does not meet `U ∩ N`.
    have hmem : y ∈ T.support ∩ (U ∩ N) := ⟨hyT, hy.2, hy.1⟩
    rw [Submission.dor_zero_dim_minimizing_support_disjoint _ U (U ∩ N) T hU hTmin] at hmem
    exact absurd hmem (notMem_empty y)
  -- 7.1.2: representations of minimizing cycles supported in `N` are stationary in `U ∩ N`.
  have hstat : ∀ S : GeometricCurrentOn U n, S.support ⊆ N → IsMinimizingIn S (U ∩ N) →
      BoundaryVanishes S → ∀ R : IMRep U n, R.Represents S → R.IsStationaryAlong N :=
    fun S hSN hSmin hSb R hR => (Submission.minimizing_implies_stationary n k ℓ hℓk U N S hU hN
      hNcl hSN (by rwa [inter_comm]) hSb R hR).1
  obtain ⟨r₀, δ, hr₀, hδ, hreg⟩ :=
    Submission.dor_stationary_cycle_epsilon_regularity n k ℓ hℓk hn U N y hU hN hNcl hy
  obtain ⟨r₁, c, c₁, hr₁, hc, hc₁, hlim⟩ :=
    Submission.dor_minimizing_limsup_mass_bound n k ℓ hℓk hn U N Ts T y hU hN hNcl hTsmin
      hTmin.1 hTsN hTsb hTb (fun j => hstat (Ts j) (hTsN j) (hTsmin j) (hTsb j)) hmass hconv hy
  -- `ωₙ ∈ (0, ∞)`.
  obtain ⟨ωr, hωr, hωeq⟩ : ∃ ωr : ℝ, 0 < ωr ∧ unitBallVolume n = ENNReal.ofReal ωr := by
    have h0 : unitBallVolume n ≠ 0 :=
      (measure_ball_pos (volume : Measure (Euclid n)) (0 : Euclid n) one_pos).ne'
    have htop : unitBallVolume n ≠ ∞ :=
      (measure_ball_lt_top (μ := (volume : Measure (Euclid n))) (x := 0) (r := 1)).ne
    exact ⟨_, ENNReal.toReal_pos h0 htop, (ENNReal.ofReal_toReal htop).symm⟩
  have hbd : ∀ ρ : ℝ, ENNReal.ofReal (1 + δ) * unitBallVolume n * ENNReal.ofReal (ρ ^ n) =
      ENNReal.ofReal ((1 + δ) * (ωr * ρ ^ n)) := by
    intro ρ
    rw [hωeq, ENNReal.ofReal_mul (by linarith : (0 : ℝ) ≤ 1 + δ), ENNReal.ofReal_mul hωr.le,
      mul_assoc]
  -- Density ratios at `y` below `a > 1` bound the mass of small balls about `y`.
  have hD : ∀ a : ℝ, 1 < a → ∀ᶠ s in 𝓝[>] (0 : ℝ),
      T.massOn (ball y s) < ENNReal.ofReal (a * (ωr * s ^ n)) := by
    intro a ha
    have hlt : ENNReal.ofReal 1 < ENNReal.ofReal a :=
      (ENNReal.ofReal_lt_ofReal_iff (by linarith)).2 ha
    filter_upwards [hdens.2.eventually (eventually_lt_nhds hlt), self_mem_nhdsWithin]
      with s hs (hs0 : 0 < s)
    have hpos : (0 : ℝ) < ωr * s ^ n := by positivity
    rw [hωeq, ← ENNReal.ofReal_mul hωr.le, ENNReal.div_lt_iff
      (Or.inl (ENNReal.ofReal_pos.2 hpos).ne') (Or.inl ENNReal.ofReal_ne_top)] at hs
    rwa [ENNReal.ofReal_mul (by linarith : (0 : ℝ) ≤ a)]
  refine ⟨?_, ?_⟩
  · -- `y ∈ reg T`: the density bound at a small scale `ρ ≤ r₀`.
    obtain ⟨RT, hRT⟩ := hTmin.1
    obtain ⟨ρ, hρ, hρ0, hρr₀⟩ := ((hD (1 + δ) (by linarith)).and (Ioo_mem_nhdsGT hr₀)).exists
    refine hreg T RT hRT hTN hTb (hstat T hTN hTmin hTb RT hRT) y hyT (by rwa [dist_self]) ρ hρ0
      hρr₀.le ?_
    rw [hbd]
    exact hρ.le
  · -- `yⱼ ∈ reg Tⱼ` for all large `j`.  First fix `η > 0` with `(1 + η)(1 + 2η)ⁿ < 1 + δ`.
    have hg : Tendsto (fun x : ℝ => (1 + x) * (1 + 2 * x) ^ n) (𝓝 0) (𝓝 1) := by
      have hcont : Continuous fun x : ℝ => (1 + x) * (1 + 2 * x) ^ n := by fun_prop
      simpa using hcont.tendsto 0
    have h1δ : (1 : ℝ) < 1 + δ := by linarith
    have hηev : ∀ᶠ x in 𝓝[>] (0 : ℝ), (1 + x) * (1 + 2 * x) ^ n < 1 + δ ∧ 0 < x := by
      filter_upwards [(hg.eventually (eventually_lt_nhds h1δ)).filter_mono nhdsWithin_le_nhds,
        self_mem_nhdsWithin] with x hx hx0
      exact ⟨hx, hx0⟩
    obtain ⟨η, hηg, hη0⟩ := hηev.exists
    -- Then a scale `ρ`: small enough for both children, with the limit bound below
    -- `(1 + δ)ωₙρⁿ` (as `ρ ↓ 0` the normalized bound tends to `(1 + η)(1 + 2η)ⁿ`).
    have hh : Tendsto (fun ρ : ℝ => (1 + c * ((1 + η) * ρ)) ^ n * ((1 + η) * (1 + 2 * η) ^ n * ωr) +
        c₁ * (1 + η) ^ (n + 1) * ρ) (𝓝 0) (𝓝 ((1 + η) * (1 + 2 * η) ^ n * ωr)) := by
      have hcont : Continuous fun ρ : ℝ => (1 + c * ((1 + η) * ρ)) ^ n *
          ((1 + η) * (1 + 2 * η) ^ n * ωr) + c₁ * (1 + η) ^ (n + 1) * ρ := by fun_prop
      simpa using hcont.tendsto 0
    have hlin : Tendsto (fun ρ : ℝ => (1 + η) * ρ) (𝓝 0) (𝓝 0) := by
      have hcont : Continuous fun ρ : ℝ => (1 + η) * ρ := by fun_prop
      simpa using hcont.tendsto 0
    have hmap : Tendsto (fun ρ : ℝ => (1 + η) * ρ + η * ρ) (𝓝[>] 0) (𝓝[>] 0) := by
      refine tendsto_nhdsWithin_iff.2 ⟨?_, ?_⟩
      · have hcont : Continuous fun ρ : ℝ => (1 + η) * ρ + η * ρ := by fun_prop
        simpa using (hcont.tendsto 0).mono_left nhdsWithin_le_nhds
      · filter_upwards [self_mem_nhdsWithin] with ρ (hρ : 0 < ρ)
        show 0 < (1 + η) * ρ + η * ρ
        positivity
    have hρev : ∀ᶠ ρ in 𝓝[>] (0 : ℝ), 0 < ρ ∧ ρ < r₀ ∧ (1 + η) * ρ < r₁ ∧
        (1 + c * ((1 + η) * ρ)) ^ n * ((1 + η) * (1 + 2 * η) ^ n * ωr) +
          c₁ * (1 + η) ^ (n + 1) * ρ < (1 + δ) * ωr ∧
        T.massOn (ball y ((1 + η) * ρ + η * ρ)) <
          ENNReal.ofReal ((1 + η) * (ωr * ((1 + η) * ρ + η * ρ) ^ n)) := by
      filter_upwards [self_mem_nhdsWithin,
        (eventually_lt_nhds hr₀).filter_mono nhdsWithin_le_nhds,
        (hlin.eventually (eventually_lt_nhds hr₁)).filter_mono nhdsWithin_le_nhds,
        (hh.eventually (eventually_lt_nhds (mul_lt_mul_of_pos_right hηg hωr))).filter_mono
          nhdsWithin_le_nhds,
        hmap.eventually (hD (1 + η) (by linarith))] with ρ h1 h2 h3 h4 h5
      exact ⟨h1, h2, h3, h4, h5⟩
    obtain ⟨ρ, hρ0, hρr₀, hρr₁, hρh, hρD⟩ := hρev.exists
    have hηρ : 0 < η * ρ := mul_pos hη0 hρ0
    have hlimρ := hlim ((1 + η) * ρ) (η * ρ) hηρ (by nlinarith) hρr₁
    have hreal : (1 + c * ((1 + η) * ρ)) ^ n * ((1 + η) * (ωr * ((1 + η) * ρ + η * ρ) ^ n)) +
        c₁ * ((1 + η) * ρ) ^ (n + 1) < (1 + δ) * (ωr * ρ ^ n) := by
      have hs : (1 + η) * ρ + η * ρ = (1 + 2 * η) * ρ := by ring
      calc (1 + c * ((1 + η) * ρ)) ^ n * ((1 + η) * (ωr * ((1 + η) * ρ + η * ρ) ^ n)) +
            c₁ * ((1 + η) * ρ) ^ (n + 1)
          = ((1 + c * ((1 + η) * ρ)) ^ n * ((1 + η) * (1 + 2 * η) ^ n * ωr) +
              c₁ * (1 + η) ^ (n + 1) * ρ) * ρ ^ n := by
            rw [hs, mul_pow, mul_pow, pow_succ ρ n]
            ring
        _ < (1 + δ) * ωr * ρ ^ n := mul_lt_mul_of_pos_right hρh (pow_pos hρ0 n)
        _ = (1 + δ) * (ωr * ρ ^ n) := mul_assoc _ _ _
    have hA : (0 : ℝ) ≤ (1 + c * ((1 + η) * ρ)) ^ n := by positivity
    have hX : (0 : ℝ) ≤ (1 + η) * (ωr * ((1 + η) * ρ + η * ρ) ^ n) := by positivity
    have hB : (0 : ℝ) ≤ c₁ * ((1 + η) * ρ) ^ (n + 1) := by positivity
    have hbound : limsup (fun j => (Ts j).massOn (ball y ((1 + η) * ρ))) atTop <
        ENNReal.ofReal ((1 + δ) * (ωr * ρ ^ n)) :=
      calc limsup (fun j => (Ts j).massOn (ball y ((1 + η) * ρ))) atTop
          ≤ ENNReal.ofReal ((1 + c * ((1 + η) * ρ)) ^ n) *
              T.massOn (ball y ((1 + η) * ρ + η * ρ)) +
              ENNReal.ofReal (c₁ * ((1 + η) * ρ) ^ (n + 1)) := hlimρ
        _ ≤ ENNReal.ofReal ((1 + c * ((1 + η) * ρ)) ^ n) *
              ENNReal.ofReal ((1 + η) * (ωr * ((1 + η) * ρ + η * ρ) ^ n)) +
              ENNReal.ofReal (c₁ * ((1 + η) * ρ) ^ (n + 1)) := by
            gcongr
        _ = ENNReal.ofReal ((1 + c * ((1 + η) * ρ)) ^ n *
              ((1 + η) * (ωr * ((1 + η) * ρ + η * ρ) ^ n)) +
              c₁ * ((1 + η) * ρ) ^ (n + 1)) := by
            rw [ENNReal.ofReal_add (mul_nonneg hA hX) hB, ENNReal.ofReal_mul hA]
        _ < ENNReal.ofReal ((1 + δ) * (ωr * ρ ^ n)) :=
            (ENNReal.ofReal_lt_ofReal_iff (by positivity)).2 hreal
    -- Eventually `|yⱼ − y| < min(ηρ, r₀)` and `M_{B_{(1+η)ρ}(y)}(Tⱼ) < (1 + δ)ωₙρⁿ`.
    filter_upwards [eventually_lt_of_limsup_lt hbound, hys.eventually (ball_mem_nhds y hηρ),
      hys.eventually (ball_mem_nhds y hr₀)] with j hj hjη hjr₀
    obtain ⟨Rj, hRj⟩ := (hTsmin j).1
    refine hreg (Ts j) Rj hRj (hTsN j) (hTsb j) (hstat (Ts j) (hTsN j) (hTsmin j) (hTsb j) Rj hRj)
      (ys j) (hysspt j) hjr₀ ρ hρ0 hρr₀.le ?_
    rw [hbd]
    refine ((Ts j).massOn_mono (ball_subset_ball' ?_)).trans hj.le
    have hd : dist (ys j) y < η * ρ := hjη
    linarith

/-- **A minimizing cycle with density close to `1` at a point of its support is regular there**
(Simon 7.4.3 and the proof of 7.4.4(8): "by Allard's Theorem 5.2 of Ch. 5 we have `y ∈ reg T`",
with 7.1.2 justifying the use of 5.2 of Ch. 5).  Let `1 ≤ j ≤ P = j + k`, and let `δ := δ₀` be
Allard's constant for `n = j` and `ε = 1/4`.  If `C ∈ 𝒟_j(ℝᴾ)` is minimizing in `ℝᴾ`, `∂C = 0`,
`0 ∈ spt C` and `M_{B_ρ(0)}(C) ≤ (1 + δ)ω_jρʲ` for `0 < ρ ≤ 1`, then `0 ∈ reg C`.  For
`C = τ(M, θ, ξ)` with `μ = θHʲ⌞M`: `M_W(C) = μ(W)` for open `W` and `spt C = spt μ`; `μ` is
stationary (flat 7.1.2); letting `ρ ↓ 1/2` gives `μ(B̄_{1/2}(0)) ≤ (1 + δ₀)ω_j(1/2)ʲ`.  Allard
with `H = 0`, `ρ = 1/2`, `z = 0` makes `spt μ ∩ B_r(0)`, `r = γ/2`, the graph of
`Φ(v) = ιv + ι'u(v)` with `u(0) = 0` and `‖Du‖ ≤ 1/4`; over the cylinder of radius `r/4` it is
`Φ(B_{r/4}(0))`, and the graph-regularity theorem gives `0 ∈ reg C`. -/
theorem Submission.dimred_cdg_minimizing_origin_regular : ∀ (P j : ℕ), 1 ≤ j → j ≤ P → ∃ δ : ℝ, 0 < δ ∧ ∀ C : GeometricCurrentOn (univ : Set (Euclid P)) j, IsMinimizingIn C univ → BoundaryVanishes C → (0 : Euclid P) ∈ C.support → (∀ ρ : ℝ, 0 < ρ → ρ ≤ 1 → C.massOn (ball 0 ρ) ≤ ENNReal.ofReal (1 + δ) * unitBallVolume j * ENNReal.ofReal (ρ ^ j)) → (0 : Euclid P) ∈ regularSet C := by
  intro P j hj hjP
  -- step 1: `P = j + k`; `δ := δ₀`, Allard's constant for `n = j` and `ε = 1/4`
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hjP
  obtain ⟨δ₀, γ, hδ₀, hγ, -, hallard⟩ :=
    Submission.dimred_cdg_allard_bounded_curvature_graph j k hj (1 / 4) (by norm_num)
  refine ⟨δ₀, hδ₀, fun C hmin hbd h0 hmass => ?_⟩
  -- step 2: `C = τ(M, θ, ξ)`, `M_W(C) = μ(W)` for open `W` and `spt C = spt μ`, so `0 ∈ spt μ`
  obtain ⟨R, hR⟩ := hmin.1
  obtain ⟨hmassW, hsupp⟩ :=
    Submission.dor_imrep_massOn_eq_measure_and_support (j + k) j univ C R isOpen_univ hR
  have h0μ : (0 : Euclid (j + k)) ∈ R.measure.support := by
    have h := h0
    rw [hsupp] at h
    exact h.2
  -- step 3: `δV(X) = 0` for every `X ∈ C¹_c(ℝ^{j+k}; ℝ^{j+k})` (Simon 7.1.2, `N = ℝ^{j+k}`)
  have hstat :=
    Submission.dimred_cdg_or_minimizing_firstVariation_eq_zero (j + k) j C R hmin hbd hR ⟨0, h0⟩
  -- step 4: `μ(B̄_{1/2}(0)) ≤ μ(B_ρ(0)) = M_{B_ρ(0)}(C) ≤ (1 + δ₀)ω_jρʲ` for `1/2 < ρ < 1`;
  -- let `ρ ↓ 1/2`
  have hclosed : R.measure (closedBall 0 (1 / 2)) ≤
      ENNReal.ofReal (1 + δ₀) * unitBallVolume j * ENNReal.ofReal ((1 / 2 : ℝ) ^ j) := by
    have hlim : Tendsto (fun ρ : ℝ => ENNReal.ofReal (1 + δ₀) * unitBallVolume j *
        ENNReal.ofReal (ρ ^ j)) (𝓝[>] (1 / 2))
        (𝓝 (ENNReal.ofReal (1 + δ₀) * unitBallVolume j * ENNReal.ofReal ((1 / 2 : ℝ) ^ j))) := by
      refine ENNReal.Tendsto.const_mul ?_ (Or.inl ?_)
      · exact (ENNReal.tendsto_ofReal ((continuous_pow j).tendsto (1 / 2 : ℝ))).mono_left
          nhdsWithin_le_nhds
      · rw [Ne, ENNReal.ofReal_eq_zero, not_le]
        positivity
    refine ge_of_tendsto hlim ?_
    filter_upwards [Ioo_mem_nhdsGT (show (1 / 2 : ℝ) < 1 by norm_num)] with ρ hρ
    calc R.measure (closedBall 0 (1 / 2)) ≤ R.measure (ball 0 ρ) :=
          measure_mono (closedBall_subset_ball hρ.1)
      _ = C.massOn (ball 0 ρ) := (hmassW _ isOpen_ball).symm
      _ ≤ _ := hmass ρ (by linarith [hρ.1]) hρ.2.le
  -- step 5: Allard at `z = 0` with `ρ = 1/2`, `H = 0` and `κ = 0`: `spt μ ∩ B_r(0)`, `r = γ/2`, is
  -- the graph of `Φ(v) = ιv + ι'u(v)` over `B_r(0)`, with `u(0) = 0` and `‖Du‖ ≤ 1/4`
  obtain ⟨ι, ι', u, horth, hu0, hu, hDu, hgraph⟩ :=
    hallard univ univ R (fun _ => 0) 0 (1 / 2) 0 isOpen_univ subset_rfl (by norm_num)
      (subset_univ _) aestronglyMeasurable_const (fun _ => by simp)
      (fun X hX hXc _ => by simp [hstat X hX hXc]) h0μ hclosed (by rw [zero_mul]; exact hδ₀.le)
  -- step 6: over the cylinder `{ιv + ι'w : |v|, |w| < r/4}`, `spt μ` is the graph `Φ(B_{r/4}(0))`
  have hr : 0 < γ * (1 / 2) := by positivity
  have hcyl := Submission.dimred_cdg_or_ball_graph_to_cylinder_graph j k R.measure.support ι ι' u 0
    (γ * (1 / 2)) hr horth hu0 hu hDu hgraph
  -- step 7: the graph-regularity theorem with `s = h = r/4` gives `0 ∈ reg C`
  have hs : 0 < γ * (1 / 2) / 4 := by positivity
  exact Submission.dor_graph_supported_cycle_regular j k univ C R ι ι' u 0 (γ * (1 / 2) / 4)
    (γ * (1 / 2) / 4) hj isOpen_univ hR hbd horth hs hs
    (hu.mono (ball_subset_ball (by linarith))) hu0 (subset_univ _) hcyl h0

/-- **Density gap for minimizing cones** (Simon 7.3–7.4; part (c) of the gap lemma used for the
dimension reduction results).  For `1 ≤ j` there is `δ > 0` such that every cone
`C ∈ 𝒟_j(ℝᴾ)` that is minimizing in `ℝᴾ` with `∂C = 0` and `Θʲ(μ_C, 0) = θ < 1 + δ` has
`θ ≤ 1`.  If `P < j`, then `C = 0`, so `ω_jθ = M_{B₁(0)}(C) = 0` and `θ = 0`.  If `j ≤ P`, take
`δ = min(δ₀, 1)` with `δ₀` from the origin regularity theorem, and suppose `θ > 1`.  Then
`0 ∈ spt C`, and since `C` is a cone `M_{B_ρ(0)}(C) = ω_jθρʲ ≤ (1 + δ₀)ω_jρʲ` for every
`ρ > 0`.  Hence `0 ∈ reg C` (Allard's theorem, as in Simon 7.4.3), so the density at the vertex
is an integer: `θ = m ∈ ℕ` with `1 < m < 1 + δ ≤ 2`, which is impossible. -/
theorem Submission.dimred_cone_density_gap : ∀ (P j : ℕ), 1 ≤ j → ∃ δ : ℝ, 0 < δ ∧ ∀ (C : GeometricCurrentOn (univ : Set (Euclid P)) j) (θ : ℝ), IsMinimizingIn C univ → BoundaryVanishes C → IsConeCurrent C → HasMassDensity C 0 θ → θ < 1 + δ → θ ≤ 1 := by
  intro P j hj
  rcases lt_or_ge P j with hPj | hjP
  · -- Case `P < j`: `δ := 1`.  `C = 0`, so `M_{B₁(0)}(C) = 0`, while the vertex density of the
    -- cone gives `M_{B₁(0)}(C) = ω_jθ` with `ω_j ≠ 0`; hence `θ ≤ 0`
    refine ⟨1, one_pos, fun C θ hmin _ hcone hden _ => ?_⟩
    have hB1 := (((Submission.dimred_cdg_im_cone_ball_mass P j C hcone hmin.1).2.1 θ).1 hden).2
    have hC0 : C.massOn (ball 0 1) = 0 := by
      rw [Submission.dimred_cdg_eq_zero_of_lt_degree P j univ C hPj]
      refine le_antisymm (sSup_le ?_) zero_le
      rintro _ ⟨ω, -, rfl⟩
      exact ENNReal.ofReal_zero.le
    have hω0 : unitBallVolume j ≠ 0 := (measure_ball_pos volume (0 : Euclid j) one_pos).ne'
    rw [hC0, eq_comm, mul_eq_zero, ENNReal.ofReal_eq_zero] at hB1
    exact (hB1.resolve_left hω0).trans zero_le_one
  · -- Case `j ≤ P`: `δ := min(δ₀, 1)` with `δ₀` from the origin regularity theorem; suppose
    -- `θ > 1`
    obtain ⟨δ₀, hδ₀, hreg⟩ := Submission.dimred_cdg_minimizing_origin_regular P j hj hjP
    refine ⟨min δ₀ 1, lt_min hδ₀ one_pos, fun C θ hmin hbd hcone hden hθδ => ?_⟩
    by_contra hθ1
    rw [not_le] at hθ1
    -- Step 1: `M_{B_ρ(0)}(C) = ρʲ M_{B₁(0)}(C)`, `M_{B₁(0)}(C) = ω_jθ` and `0 ∈ spt C`
    obtain ⟨hi, hii, hiii⟩ := Submission.dimred_cdg_im_cone_ball_mass P j C hcone hmin.1
    have h0 : (0 : Euclid P) ∈ C.support := hiii θ (by linarith) hden
    have hB1 := ((hii θ).1 hden).2
    -- Step 2: `M_{B_ρ(0)}(C) = ω_jθρʲ ≤ (1 + δ₀)ω_jρʲ` for `0 < ρ ≤ 1`, as `θ < 1 + δ₀`
    have hθδ₀ : θ ≤ 1 + δ₀ := by linarith [min_le_left δ₀ 1]
    have hmass : ∀ ρ : ℝ, 0 < ρ → ρ ≤ 1 → C.massOn (ball 0 ρ) ≤
        ENNReal.ofReal (1 + δ₀) * unitBallVolume j * ENNReal.ofReal (ρ ^ j) := by
      intro ρ hρ _
      calc C.massOn (ball 0 ρ)
          = ENNReal.ofReal θ * unitBallVolume j * ENNReal.ofReal (ρ ^ j) := by
            rw [hi ρ hρ, hB1]
            ring
        _ ≤ ENNReal.ofReal (1 + δ₀) * unitBallVolume j * ENNReal.ofReal (ρ ^ j) := by
            gcongr
    -- Step 3: `0 ∈ reg C`, so `Θʲ(μ_C, 0) = m` for some `m ∈ ℕ`
    obtain ⟨m, ρ, -, hρ, hdens⟩ := Submission.dimred_regular_point_density P j univ C 0
      isOpen_univ (hreg C hmin hbd h0 hmass)
    -- Step 4: uniqueness of the density gives `θ = m`, but `1 < θ < 1 + δ ≤ 2`
    have hθm : θ = m := (ENNReal.ofReal_eq_ofReal_iff (by linarith) (Nat.cast_nonneg m)).1
      (tendsto_nhds_unique hden.2 (hdens 0 ⟨h0, mem_ball_self hρ⟩).2)
    have h1 : 1 < m := by exact_mod_cast (show (1 : ℝ) < m by linarith)
    have h2 : m < 2 := by exact_mod_cast (show (m : ℝ) < 2 by linarith [min_le_right δ₀ 1])
    omega

/-- **Null set of points with small fillings** (Simon Ch. 6, 8.2 (4)–(6); the lower density
bound in the proof of 7.2.4).  Assume (VO).  Let `μ = μ_C` be finite on compact sets with
`M_W(C) = μ(W)` for open `W`, and `C(ω) = ∫ ⟨ω, ξ⟩ dμ` with `|ξ| ≤ 1` `μ`-a.e.  Let
`0 ≤ κ < 1 ≤ λ`.  Suppose that every `x ∈ E` has, at arbitrarily small scales `δ`, a radius
`ρ < δ` with `μ(∂B_ρ(x)) = 0` and a filling `S` with `∂S = ∂A`, where `A = C⌞B_ρ(x)`,
`M(S) ≤ κ μ(B_ρ(x))` and `spt S ⊆ B̄_{λδ}(x)`.  Then `μ(E) = 0`.
Fix `θ ∈ (κ, 1)` and a `W`-admissible `ω`.  The cone bound for the cycle `S − A` gives
`A(ω) ≤ θ μ(B_ρ(x))` at small scales.  The covering lemma then gives
`C(ω) ≤ μ(W) − (1 − θ) μ(E')` for each piece `E' = E ∩ B_k(0) ⊆ W = B_{k+1}(0)`.  Taking the
supremum over `ω` gives `μ(W) = M_W(C) ≤ μ(W) − (1 − θ) μ(E')`, so `μ(E') = 0`. -/
theorem Submission.cbrld_measure_eq_zero_of_small_fillings : (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → ∀ (P d : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (κ lam : ℝ) (E : Set (Euclid P)), 0 ≤ κ → κ < 1 → 1 ≤ lam → (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ W : Set (Euclid P), IsOpen W → C.massOn W = μ W) → AEStronglyMeasurable ξ μ → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ x ∈ E, ∀ δ : ℝ, 0 < δ → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ ∧ μ (sphere x ρ) = 0 ∧ ∃ (A S : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ y in ball x ρ, ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y) ∂μ) ∧ S.boundary = A.boundary ∧ S.mass ≤ ENNReal.ofReal κ * μ (ball x ρ) ∧ S.support ⊆ closedBall x (lam * δ)) → μ E = 0 := by
  intro hVO P d C μ ξ κ lam E hκ0 hκ1 hlam hμK hCμ hξm hξ hCξ hE
  have hball_fin : ∀ (x : Euclid P) (r : ℝ), μ (ball x r) < ∞ := fun x r =>
    (measure_mono ball_subset_closedBall).trans_lt (hμK _ (isCompact_closedBall x r))
  -- a fixed `θ ∈ (κ, 1)` plays the role of `κ + ε` in the covering lemma
  obtain ⟨θ, hκθ, hθ1⟩ := exists_between hκ1
  have hlam0 : 0 < lam := by linarith
  -- Steps 3–4: a piece `E' ⊆ E` inside an open `W` of finite measure is `μ`-null
  have hpiece : ∀ E' W : Set (Euclid P), E' ⊆ E → IsOpen W → E' ⊆ W → μ W < ∞ → μ E' = 0 := by
    intro E' W hE'E hWo hE'W hWfin
    have hE'fin : μ E' < ∞ := (measure_mono hE'W).trans_lt hWfin
    -- Step 3: every `W`-admissible `ω` satisfies `C(ω) ≤ μ(W) - (1 - θ) μ(E')`
    have hest : ∀ ω ∈ massAdmissibleOn (univ : Set (Euclid P)) (d + 1) W,
        C ω ≤ (μ W).toReal - (1 - θ) * (μ E').toReal := by
      intro ω hω
      have hωc : Continuous (ω : DifferentialForm (Euclid P) (d + 1)) :=
        ContDiff.continuous ω.property.1.1
      -- `g(y) = ξ(y)(ω(y))` is `μ`-a.e. strongly measurable with `|g| ≤ 1` `μ`-a.e.
      have hgm : AEStronglyMeasurable
          (fun y => ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y)) μ :=
        (isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable
          (hξm.prodMk hωc.aestronglyMeasurable) :)
      have hg1 : ∀ᵐ y ∂μ, |ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y)| ≤ 1 := by
        filter_upwards [hξ] with y hy
        exact (hy _).trans (hω.2 y)
      -- `g = 0` off `W`, so `C(ω) = ∫_W g dμ`
      have hCW : C ω = ∫ y in W, ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y) ∂μ := by
        rw [hCξ ω]
        refine (setIntegral_eq_integral_of_forall_compl_eq_zero fun y hy => ?_).symm
        rw [image_eq_zero_of_notMem_tsupport fun h => hy (hω.1 h), map_zero]
      -- the cone constant of `ω`
      obtain ⟨c, hc, hcone⟩ := Submission.cbrld_cycle_eval_le_radius_mul_mass hVO P d ω
      have hden : 0 < (c + 1) * lam * (1 + κ) :=
        mul_pos (mul_pos (by linarith) hlam0) (by linarith)
      obtain ⟨δ₀, hδ₀⟩ : ∃ δ₀ : ℝ, δ₀ = (θ - κ) / ((c + 1) * lam * (1 + κ)) := ⟨_, rfl⟩
      have hδ₀pos : 0 < δ₀ := by rw [hδ₀]; exact div_pos (by linarith) hden
      have hδ₀eq : δ₀ * ((c + 1) * lam * (1 + κ)) = θ - κ := by
        rw [hδ₀]; exact div_mul_cancel₀ _ hden.ne'
      -- Step 3(i): `∫_{B̄_ρ(x)} g dμ ≤ θ μ(B̄_ρ(x))` at arbitrarily small radii
      have hsmall : ∀ x ∈ E', ∀ δ' : ℝ, 0 < δ' → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ' ∧
          ∫ y in closedBall x ρ, ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y) ∂μ ≤
            θ * (μ (closedBall x ρ)).toReal := by
        intro x hx δ' hδ'
        have hδpos : 0 < min δ' δ₀ := lt_min hδ' hδ₀pos
        obtain ⟨ρ, hρ0, hρδ, hsph, A, S, hA, hbd, hSm, hSs⟩ := hE x (hE'E hx) (min δ' δ₀) hδpos
        refine ⟨ρ, hρ0, hρδ.trans_le (min_le_left _ _), ?_⟩
        have hR : 0 < lam * min δ' δ₀ := mul_pos hlam0 hδpos
        have hAs : A.support ⊆ closedBall x (lam * min δ' δ₀) :=
          (Submission.cbrld_ns_ball_current_support_subset P (d + 1) μ ξ A x ρ hA).trans
            (closedBall_subset_closedBall (hρδ.le.trans (le_mul_of_one_le_left hδpos.le hlam)))
        -- comparison with the cycle `S - A` at scale `R = λ min(δ', δ₀)`
        have hcmp := Submission.cbrld_ns_eval_le_of_small_filling P d A S ω (μ (ball x ρ)) x c κ
          (lam * min δ' δ₀) hc hκ0 hR (hball_fin x ρ) hω.2 hcone hbd
          (Submission.cbrld_ns_ball_current_mass_le P (d + 1) μ ξ A x ρ hξ hA) hSm hAs hSs
        have hcR : c * (lam * min δ' δ₀) * (1 + κ) ≤ θ - κ := by
          have h1 : 0 ≤ c * lam * (1 + κ) := mul_nonneg (mul_nonneg hc hlam0.le) (by linarith)
          have h2 : c * lam * (1 + κ) ≤ (c + 1) * lam * (1 + κ) :=
            mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (by linarith) hlam0.le)
              (by linarith)
          calc c * (lam * min δ' δ₀) * (1 + κ) = c * lam * (1 + κ) * min δ' δ₀ := by ring
            _ ≤ c * lam * (1 + κ) * δ₀ := mul_le_mul_of_nonneg_left (min_le_right _ _) h1
            _ ≤ (c + 1) * lam * (1 + κ) * δ₀ := mul_le_mul_of_nonneg_right h2 hδ₀pos.le
            _ = θ - κ := by rw [← hδ₀eq]; ring
        -- `μ(∂B_ρ(x)) = 0`, so closed and open balls agree `μ`-a.e.
        have hae : closedBall x ρ =ᵐ[μ] ball x ρ := by
          refine ae_eq_set.2 ⟨by rw [closedBall_sdiff_ball]; exact hsph, ?_⟩
          rw [sdiff_eq_empty.2 ball_subset_closedBall, measure_empty]
        rw [setIntegral_congr_set hae, measure_congr hae, ← hA ω]
        calc A ω ≤ (κ + c * (lam * min δ' δ₀) * (1 + κ)) * (μ (ball x ρ)).toReal := hcmp
          _ ≤ θ * (μ (ball x ρ)).toReal :=
            mul_le_mul_of_nonneg_right (by linarith) ENNReal.toReal_nonneg
      -- Step 3(ii): the covering lemma with `θ`
      rw [hCW]
      exact Submission.cbrld_vitali_setIntegral_le P μ
        (fun y => ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y)) θ E' W hμK hgm hg1
        hθ1.le hWo hE'W hWfin hsmall
    -- Step 4: `μ(W) = M_W(C) ≤ max(μ(W) - (1 - θ) μ(E'), 0)`
    have hmass : C.massOn W ≤ ENNReal.ofReal (max ((μ W).toReal - (1 - θ) * (μ E').toReal) 0) := by
      refine sSup_le ?_
      rintro _ ⟨ω, hω, rfl⟩
      exact ENNReal.ofReal_le_ofReal ((hest ω hω).trans (le_max_left _ _))
    rw [hCμ W hWo] at hmass
    have hreal := ENNReal.toReal_le_of_le_ofReal (le_max_right _ _) hmass
    by_contra hne
    have hpos : 0 < (μ E').toReal := ENNReal.toReal_pos hne hE'fin.ne
    have hWpos : 0 < (μ W).toReal :=
      hpos.trans_le (ENNReal.toReal_mono hWfin.ne (measure_mono hE'W))
    have hprod : 0 < (1 - θ) * (μ E').toReal := mul_pos (by linarith) hpos
    rcases le_total ((μ W).toReal - (1 - θ) * (μ E').toReal) 0 with h | h
    · rw [max_eq_right h] at hreal
      linarith
    · rw [max_eq_left h] at hreal
      linarith
  -- Step 2: `E = ⋃ₖ (E ∩ B_k(0))`, and each piece lies in the open `B_{k+1}(0)`
  have hcover : E ⊆ ⋃ k : ℕ, E ∩ ball (0 : Euclid P) k := by
    intro y hy
    obtain ⟨k, hk⟩ := exists_nat_gt (dist y 0)
    exact mem_iUnion.2 ⟨k, hy, mem_ball.2 hk⟩
  exact measure_mono_null hcover (measure_iUnion_null fun k : ℕ =>
    hpiece (E ∩ ball (0 : Euclid P) k) (ball (0 : Euclid P) (k + 1)) inter_subset_left isOpen_ball
      (fun z hz => ball_subset_ball (by linarith) hz.2) (hball_fin _ _))
/-- **Lower density bound for cycles with the integer slice property** (Simon Ch. 6, 8.2 (2)–(6),
with the lower density in place of `Θ^{*n}` and the filling's support controlled by (DT)).
Let `η₀` be the constant of `cbrld_exists_small_filling_of_low_density` for `(P, d)`, its
isoperimetric hypothesis supplied by `cbr_isoperimetric_filling` applied to (DT).  At every point
`x` of `E := {x : liminf_{r↓0} μ(B_r(x))/(ω_{d+1}r^{d+1}) < η₀}` and at every scale `δ > 0` there
are a radius `ρ ∈ (0, δ)` with `μ(∂B_ρ(x)) = 0` and a current `S` with `∂S = ∂(C⌞B_ρ(x))`,
`M(S) ≤ ½μ(B_ρ(x))` and `spt S ⊆ B̄_{(1+3√P)δ}(x)`.  These are exactly the hypotheses of
`cbrld_measure_eq_zero_of_small_fillings` with (VO), `κ = 1/2` and `λ = 1 + 3√P ≥ 1`, so
`μ(E) = 0`, which is the a.e. bound (`ae_iff`). -/
theorem Submission.cbr_lower_density_of_slice_property : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → (∀ (P m : ℕ), ∃ c : NNReal, 1 ≤ c ∧ ∀ (ρ : ℝ) (K : Set (Euclid P)) (Λ : NNReal), 0 < ρ → IsCompact K → ∃ 𝒬 : Set (GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 𝒬.Finite ∧ ∀ T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity T → T.support ⊆ K → T.mass ≤ Λ → T.boundary.mass < ∞ → ∃ Q ∈ 𝒬, ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q ∧ IsIntegerMultiplicity Q.boundary ∧ IsIntegerMultiplicity R ∧ T - Q - S = R.boundary ∧ (Q = 0 ∨ ENNReal.ofReal (ρ ^ (m + 1)) ≤ Q.mass) ∧ Q.mass ≤ c * T.mass ∧ Q.boundary.mass ≤ c * T.boundary.mass ∧ R.mass ≤ c * ENNReal.ofReal ρ * T.mass ∧ S.mass ≤ c * ENNReal.ofReal ρ * T.boundary.mass ∧ Q.support ∪ R.support ⊆ thickening (3 * Real.sqrt P * ρ) T.support ∧ Q.boundary.support ∪ S.support ⊆ thickening (3 * Real.sqrt P * ρ) T.boundary.support) → (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → ∀ (P d : ℕ), ∃ η₀ : ℝ, 0 < η₀ ∧ ∀ (C : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)), C.boundary = 0 → (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ W : Set (Euclid P), IsOpen W → C.massOn W = μ W) → AEStronglyMeasurable ξ μ → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (C).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B)) → ∀ᵐ x ∂μ, ENNReal.ofReal η₀ ≤ liminf (fun r : ℝ => μ (ball x r) / (unitBallVolume (d + 1) * ENNReal.ofReal (r ^ (d + 1)))) (𝓝[>] 0) := by
  intro _ hMR hSL hDT hVO P d
  -- `η₀` from the small fillings of sphere slices, with (ISO) from the isoperimetric filling
  obtain ⟨η₀, hη₀, hfill⟩ := Submission.cbrld_exists_small_filling_of_low_density hSL hMR
    (Submission.cbr_isoperimetric_filling hDT) P d
  refine ⟨η₀, hη₀, fun C μ ξ hCb hμK hμW hξ hξb hC hISP => ?_⟩
  -- the low-density set has small fillings at every scale, hence is `μ`-null
  rw [ae_iff]
  refine Submission.cbrld_measure_eq_zero_of_small_fillings hVO P d C μ ξ (1 / 2)
    (1 + 3 * Real.sqrt P) _ (by norm_num) (by norm_num) ?_ hμK hμW hξ hξb hC ?_
  · linarith [Real.sqrt_nonneg (P : ℝ)]
  · intro x hx δ hδ
    exact hfill C μ ξ hCb hμK hξ hξb hC hISP x (not_le.1 hx) δ hδ

/-- Cycles of finite mass with the integer slice property are integer multiplicity (B. White's
tangent-plane argument, used in place of Simon's rectifiability theorem 6.8.1 for the closure
theorem behind 7.2.4).  Since `∂Γ = 0`, the mass representation `(μ, ξ)` of `Γ` is absolutely
continuous with respect to `Hⁿ`, and the slice property bounds its lower density below
(`cbr_lower_density_of_slice_property`); hence `μ = θ Hⁿ⌞M` and `Γ = ∫_M θ ⟨·, ζ⟩ dHⁿ` with
`|ζ| = 1` on `M`.  At `Hⁿ`-a.e. `a ∈ M` (upper density at most `1`, Lebesgue point of `θζ`) the
blow-ups of `Γ` converge to `θ(a)` times an oriented `n`-plane; this plane is the approximate
tangent plane of `M` at `a`, `ζ(a)` orients it and `θ(a)` is an integer.  Since `M` is then
countably `n`-rectifiable, `(M, θ, ζ)` is an integer multiplicity representation of `Γ`. -/
theorem Submission.cbr_cycle_isIntegerMultiplicity : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → (∀ (P m : ℕ), ∃ c : NNReal, 1 ≤ c ∧ ∀ (ρ : ℝ) (K : Set (Euclid P)) (Λ : NNReal), 0 < ρ → IsCompact K → ∃ 𝒬 : Set (GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 𝒬.Finite ∧ ∀ T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity T → T.support ⊆ K → T.mass ≤ Λ → T.boundary.mass < ∞ → ∃ Q ∈ 𝒬, ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q ∧ IsIntegerMultiplicity Q.boundary ∧ IsIntegerMultiplicity R ∧ T - Q - S = R.boundary ∧ (Q = 0 ∨ ENNReal.ofReal (ρ ^ (m + 1)) ≤ Q.mass) ∧ Q.mass ≤ c * T.mass ∧ Q.boundary.mass ≤ c * T.boundary.mass ∧ R.mass ≤ c * ENNReal.ofReal ρ * T.mass ∧ S.mass ≤ c * ENNReal.ofReal ρ * T.boundary.mass ∧ Q.support ∪ R.support ⊆ thickening (3 * Real.sqrt P * ρ) T.support ∧ Q.boundary.support ∪ S.support ⊆ thickening (3 * Real.sqrt P * ρ) T.boundary.support) → (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → ∀ d : ℕ, (∀ (P : ℕ) (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U d) (T : GeometricCurrentOn U d), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T) → ∀ (P : ℕ) (Γ : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), Γ.boundary = 0 → Γ.mass < ∞ → IsCompact Γ.support → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), Γ ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (Γ).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B)) → IsIntegerMultiplicity Γ := by
  intro hREP hMR hIMC hSL hDT hVO d hCL P Γ hΓb hΓm _hΓs hISP
  -- The mass representation `(μ, ξ)` of `Γ`: `μ` is finite and, as `∂Γ = 0`, `μ ≪ Hⁿ`.
  obtain ⟨μ, ξ, -, hμK, hμW, hξ, hξb, hΓξ, hμac⟩ := hREP P (d + 1) univ Γ isOpen_univ
    fun W _ _ => (Γ.massOn_mono (subset_univ W)).trans_lt hΓm
  have hμ : μ univ < ∞ := by
    rw [← hμW univ isOpen_univ]
    exact hΓm
  have hμac' : ∀ E : Set (Euclid P), μHE[d + 1] E = 0 → μ E = 0 := by
    refine hμac fun W _ _ => ?_
    change Γ.boundary.massOn W < ∞
    rw [hΓb]
    refine (sSup_le ?_).trans_lt ENNReal.zero_lt_top
    rintro r ⟨ω, -, rfl⟩
    simp
  -- The lower density of `μ` is at least `η₀` almost everywhere.
  obtain ⟨η₀, hη₀, hLD⟩ :=
    Submission.cbr_lower_density_of_slice_property hREP hMR hSL hDT hVO P d
  have hdens := hLD Γ μ ξ hΓb (fun K hK => hμK K hK (subset_univ K)) hμW hξ
    (ae_of_all _ fun x => hξb x) hΓξ hISP
  -- `μ = θ Hⁿ⌞M` and `Γ = ∫_M θ ⟨·, ζ⟩ dHⁿ`.
  obtain ⟨M, θ, ζ, hM, hMfin, hθ, hζ, hμM, hθpos, hζb, hζM, hΓM, hMdens⟩ :=
    Submission.cbr_ci_density_representation P (d + 1) Γ μ ξ η₀ hη₀ hμ hμW hξ hξb hΓξ hμac'
      hdens
  have hθint : ∫⁻ x in M, ENNReal.ofReal (θ x) ∂μHE[d + 1] < ∞ := by
    have h := hμ
    rwa [hμM, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ] at h
  -- At `Hⁿ`-a.e. `a ∈ M`, `M` has an approximate tangent plane oriented by `ζ(a)` and `θ(a)` is
  -- an integer; this makes `(M, θ, ζ)` an integer multiplicity representation of `Γ`.
  refine Submission.cbr_ci_isIntegerMultiplicity_of_ae_tangent
    Submission.cbr_rectifiable_of_approx_tangent P (d + 1) Γ M θ ζ hM hMfin hθ hζ hθpos hθint hΓM ?_
  filter_upwards [Submission.cbr_ci_ae_good_points P (d + 1) M θ ζ hM hMfin hθ hζ hθpos hθint hζb,
    ae_restrict_mem hM] with a ha haM
  exact Submission.cbr_ci_pointwise_tangent_integer hREP hMR hSL
    Submission.cbr_setIntegral_eq_of_integral_eq Submission.cbr_measure_convergence_tools P d
    (Submission.cbr_slice_property_of_weak_limit hREP hMR hIMC hSL d hCL P) ⟨η₀, hη₀, hLD⟩ Γ μ M θ ζ
    a η₀ hΓb hISP hμ hμW hM hMfin hθ hζ hμM hθpos hζb hζM hΓM haM hη₀ (hMdens a haM) ha.1 ha.2

/-- **Closure theorem for compactly supported sequences** (Simon Ch. 6, 8.2–8.3: the claim (CL*),
by reduction to cycles).  Let `Tⱼ ∈ 𝒟_{d+1}(ℝᴾ)` and `∂Tⱼ` be integer multiplicity, `spt Tⱼ ⊆ K`
compact, `sup_j (M(Tⱼ) + M(∂Tⱼ)) < ∞` and `Tⱼ ⇀ T`.  By (VO) and lower semicontinuity of mass,
`spt T ⊆ K` and `M(T), M(∂T) < ∞`, and CL(d) makes `∂T` integer multiplicity (`∂∂Tⱼ = 0`).  A
compactly supported integer multiplicity `Y` of finite mass with `∂Y = ∂T` turns `Γ = T − Y` into a
compactly supported cycle of finite mass.  `Tⱼ` and `Y` are integer multiplicity with integer
multiplicity boundaries, so they have the integer slice property; it passes to the weak limit `T`
and then to `Γ`.  Hence `Γ` is integer multiplicity, and so is `T = Γ − (0 − Y)` by (IMC)(c). -/
theorem Submission.cbr_closure_compact_support : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → (∀ (P m : ℕ), ∃ c : NNReal, 1 ≤ c ∧ ∀ (ρ : ℝ) (K : Set (Euclid P)) (Λ : NNReal), 0 < ρ → IsCompact K → ∃ 𝒬 : Set (GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 𝒬.Finite ∧ ∀ T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity T → T.support ⊆ K → T.mass ≤ Λ → T.boundary.mass < ∞ → ∃ Q ∈ 𝒬, ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q ∧ IsIntegerMultiplicity Q.boundary ∧ IsIntegerMultiplicity R ∧ T - Q - S = R.boundary ∧ (Q = 0 ∨ ENNReal.ofReal (ρ ^ (m + 1)) ≤ Q.mass) ∧ Q.mass ≤ c * T.mass ∧ Q.boundary.mass ≤ c * T.boundary.mass ∧ R.mass ≤ c * ENNReal.ofReal ρ * T.mass ∧ S.mass ≤ c * ENNReal.ofReal ρ * T.boundary.mass ∧ Q.support ∪ R.support ⊆ thickening (3 * Real.sqrt P * ρ) T.support ∧ Q.boundary.support ∪ S.support ⊆ thickening (3 * Real.sqrt P * ρ) T.boundary.support) → (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → ∀ d : ℕ, (∀ (P : ℕ) (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U d) (T : GeometricCurrentOn U d), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T) → (∀ (P : ℕ) (U : Set (Euclid P)) (R : GeometricCurrentOn U (d + 1)), IsOpen U → IsIntegerMultiplicity R → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → R.boundary.massOn W < ∞) → IsIntegerMultiplicity R.boundary) → ∀ (P : ℕ) (Ts : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (T : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (K : Set (Euclid P)), IsCompact K → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ j, IsIntegerMultiplicity (Ts j).boundary) → (∀ j, (Ts j).support ⊆ K) → ⨆ j, ((Ts j).mass + (Ts j).boundary.mass) < ∞ → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T := by
  have hAlg := Submission.cbr_cc_current_algebra
  have hISP := Submission.cbr_cc_slice_property_of_im
  have hISPsub := Submission.cbr_cc_slice_property_sub
  have hFill := Submission.cbr_cc_compact_im_filling
  have hMCT := Submission.cbr_measure_convergence_tools
  have hSliceLim := Submission.cbr_slice_property_of_weak_limit
  have hCycle := Submission.cbr_cycle_isIntegerMultiplicity
  intro hREP hMR hIMC hSL hDT hVO d hCL hBR P Ts T K hK hTsIM hbTsIM hspt hmass hconv
  have hIMCc := hIMC.2.2.1
  have hRU := Submission.cbr_setIntegral_eq_of_integral_eq
  -- Step 1: `M(Tⱼ), M(∂Tⱼ) ≤ sup_j (M(Tⱼ) + M(∂Tⱼ)) < ∞`, so `M(T), M(∂T) < ∞` by lower
  -- semicontinuity of mass (`∂Tⱼ ⇀ ∂T`)
  have hmTs : ∀ j, (Ts j).mass ≤ ⨆ j, ((Ts j).mass + (Ts j).boundary.mass) := fun j =>
    le_self_add.trans (le_iSup (fun j => (Ts j).mass + (Ts j).boundary.mass) j)
  have hmbTs : ∀ j, (Ts j).boundary.mass ≤ ⨆ j, ((Ts j).mass + (Ts j).boundary.mass) := fun j =>
    le_add_self.trans (le_iSup (fun j => (Ts j).mass + (Ts j).boundary.mass) j)
  have hbconv : WeaklyConvergesOn (fun j => (Ts j).boundary) T.boundary := hconv.boundary
  have hTmass : T.mass < ∞ :=
    ((hconv.massOn_le_liminf univ).trans
      (liminf_le_of_frequently_le' (Frequently.of_forall hmTs))).trans_lt hmass
  have hbTmass : T.boundary.mass < ∞ :=
    ((hbconv.massOn_le_liminf univ).trans
      (liminf_le_of_frequently_le' (Frequently.of_forall hmbTs))).trans_lt hmass
  -- `spt T ⊆ K` is compact: if `spt ω ∩ K = ∅`, then `T(ω) = lim Tⱼ(ω) = 0` by (VO)
  have hTc : IsCompact T.support := by
    refine (Submission.rsd_cmr_support_subset_of_vanish P (d + 1) univ K T isOpen_univ hK
      (subset_univ K) fun ω hω => ?_).2
    exact tendsto_nhds_unique (hconv ω) (tendsto_const_nhds.congr fun j =>
      (hVO P (d + 1) univ (Ts j) ω (hω.mono_right (hspt j))).symm)
  -- Step 2: `∂T` is integer multiplicity by CL(d), the boundary masses `M_W(∂∂Tⱼ)` being zero
  have hbb : ∀ (m : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1))
      (W : Set (Euclid P)), boundaryMassOn X.boundary W = 0 := by
    intro m X W
    cases m with
    | zero => rfl
    | succ m =>
      show X.boundary.boundary.massOn W = 0
      rw [GeometricCurrentOn.boundary_boundary]
      refine le_antisymm (sSup_le ?_) zero_le
      rintro _ ⟨ω, -, rfl⟩
      simp
  have hbTIM : IsIntegerMultiplicity T.boundary := by
    refine hCL P univ (fun j => (Ts j).boundary) T.boundary isOpen_univ hbTsIM
      (fun W _ _ => (iSup_le fun j => ?_).trans_lt hmass) hbconv
    rw [hbb d (Ts j) W, add_zero]
    exact ((Ts j).boundary.massOn_mono (subset_univ W)).trans (hmbTs j)
  -- Step 3: a compactly supported integer multiplicity `Y` of finite mass with `∂Y = ∂T`
  obtain ⟨Y, hYIM, hYb, hYmass, hYc⟩ :=
    hFill hMR hIMCc hVO (Submission.cbr_isoperimetric_filling hDT) d P T hTc hbTmass hbTIM
  have hbYIM : IsIntegerMultiplicity Y.boundary := by rw [hYb]; exact hbTIM
  have hbYmass : Y.boundary.mass < ∞ := by rw [hYb]; exact hbTmass
  -- Step 4: the cycle `Γ = T − Y`: `∂Γ = 0`, `M(Γ) ≤ M(T) + M(Y) < ∞`, `spt Γ ⊆ spt T ∪ spt Y`
  have hΓb : (T - Y).boundary = 0 := by
    ext ω
    show T (exteriorDerivativeTestOn univ d ω) - Y (exteriorDerivativeTestOn univ d ω) = 0
    rw [sub_eq_zero]
    exact (congrArg (fun X : GeometricCurrentOn (univ : Set (Euclid P)) d => X ω) hYb).symm
  have hΓmass : (T - Y).mass < ∞ := by
    have h := hAlg.2.1 P (d + 1) univ (T - Y) T Y 1 (-1) (fun ω => by
      show T ω - Y ω = ((1 : ℤ) : ℝ) * T ω + ((-1 : ℤ) : ℝ) * Y ω
      push_cast
      ring) univ
    refine h.trans_lt ?_
    simp only [Int.natAbs_one, Int.natAbs_neg, Nat.cast_one, one_mul]
    exact ENNReal.add_lt_top.mpr ⟨hTmass, hYmass⟩
  have hΓc : IsCompact (T - Y).support := by
    refine (Submission.rsd_cmr_support_subset_of_vanish P (d + 1) univ (T.support ∪ Y.support)
      (T - Y) isOpen_univ (hTc.union hYc) (subset_univ _) fun ω hω => ?_).2
    show T ω - Y ω = 0
    rw [hVO P (d + 1) univ T ω (hω.mono_right subset_union_left),
      hVO P (d + 1) univ Y ω (hω.mono_right subset_union_right), sub_zero]
  -- Steps 5–7: the integer slice property of `Tⱼ` and `Y` (integer multiplicity with integer
  -- multiplicity boundary), of the weak limit `T`, and of the difference `Γ = T − Y`
  have hloc : ∀ {m : ℕ} (X : GeometricCurrentOn (univ : Set (Euclid P)) m), X.mass < ∞ →
      ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ → X.massOn W < ∞ :=
    fun X hX W _ _ => (X.massOn_mono (subset_univ W)).trans_lt hX
  have hISPY := hISP hIMC hSL hMCT.2.2 hRU d hBR P Y hYIM hbYIM
  have hISPT := hSliceLim hREP hMR hIMC hSL d hCL P Ts T
    (fun j => hISP hIMC hSL hMCT.2.2 hRU d hBR P (Ts j) (hTsIM j) (hbTsIM j))
    (fun W _ _ => (iSup_le fun j => (add_le_add ((Ts j).massOn_mono (subset_univ W))
      ((Ts j).boundary.massOn_mono (subset_univ W))).trans
        (le_iSup (fun j => (Ts j).mass + (Ts j).boundary.mass) j)).trans_lt hmass) hconv
  have hISPΓ := hISPsub hREP hSL hIMCc hRU d P T Y (hloc T hTmass) (hloc T.boundary hbTmass)
    (hloc Y hYmass) (hloc Y.boundary hbYmass) hISPT hISPY
  -- Step 8: `Γ` is integer multiplicity, hence so is `T = Γ − (0 − Y)` by (IMC)(c)
  have hΓIM := hCycle hREP hMR hIMC hSL hDT hVO d hCL P (T - Y) hΓb hΓmass hΓc hISPΓ
  have hT : T = (T - Y) - (0 - Y) := by
    ext ω
    show T ω = (T ω - Y ω) - (0 - Y ω)
    ring
  rw [hT]
  exact hIMCc P (d + 1) univ (T - Y) (0 - Y) isOpen_univ hΓIM
    (hIMCc P (d + 1) univ 0 Y isOpen_univ (hAlg.1 P (d + 1) univ) hYIM)

namespace Submission

/-- Smoothing a field `s` with `|s| ≤ 1` and `s = 0` off `Q_δ` by a nonnegative unit-mass `C^∞`
kernel `ρ` supported in `B_σ(0)`, `σ < δ`, gives a `C^∞` field `ρ ⋆ s` with `|ρ ⋆ s| ≤ 1` whose
topological support is compact and lies in `Q₁` (the mollification step of Simon Ch. 2, 2.5 and
2.7, as used in the proof of the deformation theorem, Ch. 6, 5.1).  The support of `ρ ⋆ s` lies
in the closed box `{δ − σ ≤ y_i ≤ 1 − δ + σ}`, which is compact and contained in `Q₁`. -/
theorem cmcdt_cbm_sa_smoothed_field : ∀ (m : ℕ) (δ σ : ℝ) (ρ : Euclid (m + 1) → ℝ) (s : Euclid (m + 1) → Euclid (m + 1)), 0 < σ → σ < δ → ContDiff ℝ (⊤ : ℕ∞) ρ → (∀ z, 0 ≤ ρ z) → ∫ z, ρ z = 1 → support ρ ⊆ ball (0 : Euclid (m + 1)) σ → AEStronglyMeasurable s volume → (∀ x, ‖s x‖ ≤ 1) → (∀ x, x ∉ {z : Euclid (m + 1) | ∀ i, δ < z i ∧ z i < 1 - δ} → s x = 0) → ContDiff ℝ (⊤ : ℕ∞) (convolution ρ s (ContinuousLinearMap.lsmul ℝ ℝ) volume) ∧ HasCompactSupport (convolution ρ s (ContinuousLinearMap.lsmul ℝ ℝ) volume) ∧ tsupport (convolution ρ s (ContinuousLinearMap.lsmul ℝ ℝ) volume) ⊆ {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} ∧ ∀ y, ‖convolution ρ s (ContinuousLinearMap.lsmul ℝ ℝ) volume y‖ ≤ 1 := by
  intro m δ σ ρ s hσ hσδ hρ hρ0 hρ1 hρs hs hs1 hs0
  -- Step 1: `ρ` vanishes off `closedBall 0 σ`, so it has compact support and is integrable.
  have hρc : HasCompactSupport ρ := by
    refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid (m + 1)) σ) fun x hx => ?_
    by_contra h
    exact hx (ball_subset_closedBall (hρs h))
  have hρi : Integrable ρ := hρ.continuous.integrable_of_hasCompactSupport hρc
  -- Step 2: `s` is measurable and bounded by `1`, hence integrable on compact sets.
  have hsl : LocallyIntegrable s volume := by
    rw [locallyIntegrable_iff]
    exact fun K hK => Measure.integrableOn_of_bounded hK.measure_lt_top.ne hs
      (Eventually.of_forall hs1)
  -- Step 3: `ρ` is `C^∞` with compact support and `s` is locally integrable, so `ρ ⋆ s` is `C^∞`.
  have hG : ContDiff ℝ (⊤ : ℕ∞) (convolution ρ s (ContinuousLinearMap.lsmul ℝ ℝ) volume) :=
    hρc.contDiff_convolution_left _ hρ hsl
  -- Step 4: `‖ρ t • s (y − t)‖ ≤ ρ t` and `∫ ρ = 1`.
  have hbd : ∀ y, ‖convolution ρ s (ContinuousLinearMap.lsmul ℝ ℝ) volume y‖ ≤ 1 := by
    intro y
    rw [convolution_def]
    refine (norm_integral_le_of_norm_le hρi (Eventually.of_forall fun t => ?_)).trans hρ1.le
    rw [ContinuousLinearMap.lsmul_apply, norm_smul, Real.norm_eq_abs, abs_of_nonneg (hρ0 t)]
    exact mul_le_of_le_one_right (hρ0 t) (hs1 _)
  -- Step 5: `support (ρ ⋆ s) ⊆ support s + support ρ ⊆ Q_δ + B_σ(0)` lies in the box `P`,
  -- since `|t_i| ≤ |t| < σ`.
  set P : Set (Euclid (m + 1)) := {y | ∀ i, δ - σ ≤ y i ∧ y i ≤ 1 - δ + σ}
  have hsupp : support (convolution ρ s (ContinuousLinearMap.lsmul ℝ ℝ) volume) ⊆ P := by
    intro y hy
    obtain ⟨a, ha, t, ht, rfl⟩ :=
      support_convolution_subset_swap (ContinuousLinearMap.lsmul ℝ ℝ) hy
    have ha' : ∀ i, δ < a i ∧ a i < 1 - δ := by
      by_contra h
      exact ha (hs0 a h)
    have ht' : ‖t‖ < σ := mem_ball_zero_iff.mp (hρs ht)
    intro i
    have hti : |t i| < σ := lt_of_le_of_lt (PiLp.norm_apply_le t i) ht'
    obtain ⟨h1, h2⟩ := abs_lt.mp hti
    obtain ⟨h3, h4⟩ := ha' i
    simp only [PiLp.add_apply]
    constructor <;> linarith
  -- Step 6: `P` is compact (the preimage of a product of intervals under `PiLp.homeomorph`)
  -- and lies in `Q₁` because `0 < δ − σ` and `1 − δ + σ < 1`.
  have hPc : IsCompact P := by
    have h := (PiLp.homeomorph 2 (fun _ : Fin (m + 1) => ℝ)).isCompact_preimage.mpr
      (isCompact_univ_pi fun _ : Fin (m + 1) => isCompact_Icc (a := δ - σ) (b := 1 - δ + σ))
    convert h using 1
    ext y
    simp only [mem_preimage, mem_univ_pi, mem_Icc]
    rfl
  have hPQ : P ⊆ {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} := by
    intro y hy i
    obtain ⟨h1, h2⟩ := hy i
    constructor <;> linarith
  -- Step 7: `tsupport (ρ ⋆ s)` is a closed subset of the compact set `P ⊆ Q₁`.
  have hts : tsupport (convolution ρ s (ContinuousLinearMap.lsmul ℝ ℝ) volume) ⊆ P :=
    closure_minimal hsupp hPc.isClosed
  exact ⟨hG, hPc.of_isClosed_subset (isClosed_tsupport _) hts, hts.trans hPQ, hbd⟩

end Submission

/-- **Mollification does not increase the variation on `Q_δ`** (the duality step of Simon
Ch. 2, 2.5 (4)–(5)).  Let `u` be integrable on the open unit cube `Q₁` with `∫_{Q₁} u div g ≤ V`
for every smooth compactly supported field `g` with `spt g ⊆ Q₁` and `|g| ≤ 1`, and let `ρ ≥ 0`
be a smooth kernel with `∫ρ = 1` and `spt ρ ⊆ B_σ(0)`, `0 < σ < δ`.  Then `f = ρ ⋆ 1_{Q₁}u`
satisfies `∫_{Q_δ} ‖Df‖ ≤ V`.  With `w` the Riesz representative of `Df` and the unit field
`s = 1_{Q_δ} w/|w|`, the field `G = ρ̌ ⋆ s` (`ρ̌(z) = ρ(−z)`) is admissible
(`cmcdt_cbm_sa_smoothed_field`), and `cmcdt_cbm_sa_mollify_adjoint` gives
`∫_{Q_δ} ‖Df‖ = ∫ Df(s) = −∫_{Q₁} u div G ≤ V`, the last step by testing with `−G`. -/
theorem Submission.cmcdt_cbm_sa_grad_bound : ∀ (m : ℕ) (u : Euclid (m + 1) → ℝ) (V δ σ : ℝ) (ρ : Euclid (m + 1) → ℝ), IntegrableOn u {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ y, ‖g y‖ ≤ 1) → ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, u y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) ≤ V) → 0 < σ → σ < δ → ContDiff ℝ (⊤ : ℕ∞) ρ → (∀ z, 0 ≤ ρ z) → ∫ z, ρ z = 1 → support ρ ⊆ ball (0 : Euclid (m + 1)) σ → ∫ x in {z : Euclid (m + 1) | ∀ i, δ < z i ∧ z i < 1 - δ}, ‖fderiv ℝ (convolution ρ ({y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}.indicator u) (ContinuousLinearMap.lsmul ℝ ℝ) volume) x‖ ≤ V := by
  intro m u V δ σ ρ hu hV hσ hσδ hρ hρ0 hρ1 hρs
  set Q1 : Set (Euclid (m + 1)) := {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}
  set Qδ : Set (Euclid (m + 1)) := {z : Euclid (m + 1) | ∀ i, δ < z i ∧ z i < 1 - δ}
  -- Step 0(b): the cubes are measurable (finite intersections of coordinate half-spaces)
  have hcoord : ∀ i : Fin (m + 1), Measurable (fun y : Euclid (m + 1) => y i) := fun i =>
    (EuclideanSpace.proj (𝕜 := ℝ) i).continuous.measurable
  have hcube : ∀ a b : ℝ, MeasurableSet {y : Euclid (m + 1) | ∀ i, a < y i ∧ y i < b} := by
    intro a b
    have : {y : Euclid (m + 1) | ∀ i, a < y i ∧ y i < b} =
        ⋂ i, ({y : Euclid (m + 1) | a < y i} ∩ {y | y i < b}) := by
      ext y; simp
    rw [this]
    exact MeasurableSet.iInter fun i =>
      (measurableSet_lt measurable_const (hcoord i)).inter
        (measurableSet_lt (hcoord i) measurable_const)
  have hQ1m : MeasurableSet Q1 := hcube 0 1
  have hQδm : MeasurableSet Qδ := hcube δ (1 - δ)
  -- Step 0(c), 0(d): `Q_δ ⊆ Q₁ ⊆ closedBall 0 √n`, so both have finite measure
  have hQδQ1 : Qδ ⊆ Q1 := fun y hy i => ⟨by linarith [(hy i).1], by linarith [(hy i).2]⟩
  have hQ1fin : volume Q1 < ∞ := by
    refine (Metric.isBounded_iff_subset_closedBall (0 : Euclid (m + 1))).2 ⟨Real.sqrt (m + 1), ?_⟩
      |>.measure_lt_top
    intro y hy
    rw [mem_closedBall_zero_iff, EuclideanSpace.norm_eq]
    apply Real.sqrt_le_sqrt
    calc ∑ i, ‖y i‖ ^ 2 ≤ ∑ _i : Fin (m + 1), (1 : ℝ) := by
          apply Finset.sum_le_sum
          intro i _
          have h1 := hy i
          rw [Real.norm_eq_abs, abs_of_pos h1.1]
          nlinarith [h1.1, h1.2]
      _ = (m + 1 : ℝ) := by simp
  have hQδfin : volume Qδ < ∞ := (measure_mono hQδQ1).trans_lt hQ1fin
  -- Step 0(e): `ū = 1_{Q₁}u` is integrable
  set ub : Euclid (m + 1) → ℝ := Q1.indicator u with hub
  have hub_int : Integrable ub := (integrable_indicator_iff hQ1m).2 hu
  -- Step 0(f): `ρ` is `C¹` with compact support (`spt ρ ⊆ closedBall 0 σ`)
  have hρc : HasCompactSupport ρ :=
    HasCompactSupport.intro (isCompact_closedBall (0 : Euclid (m + 1)) σ) fun x hx => by
      by_contra h
      exact hx (ball_subset_closedBall (hρs h))
  have hρC1 : ContDiff ℝ 1 ρ := hρ.of_le (by exact_mod_cast le_top)
  -- Step 2: the Riesz representative `w` of `Df` and the unit field `s = 1_{Q_δ} |w|⁻¹ w`
  set f : Euclid (m + 1) → ℝ := convolution ρ ub (ContinuousLinearMap.lsmul ℝ ℝ) volume
  set w : Euclid (m + 1) → Euclid (m + 1) :=
    fun x => (InnerProductSpace.toDual ℝ (Euclid (m + 1))).symm (fderiv ℝ f x)
  have hw_meas : Measurable w :=
    (InnerProductSpace.toDual ℝ (Euclid (m + 1))).symm.continuous.measurable.comp
      (measurable_fderiv ℝ f)
  have hw_norm : ∀ x, ‖w x‖ = ‖fderiv ℝ f x‖ := fun x => LinearIsometryEquiv.norm_map _ _
  have hw_apply : ∀ x, fderiv ℝ f x (w x) = ‖w x‖ ^ 2 := fun x => by
    rw [← InnerProductSpace.toDual_symm_apply, real_inner_self_eq_norm_sq]
  set s : Euclid (m + 1) → Euclid (m + 1) := Qδ.indicator (fun x => ‖w x‖⁻¹ • w x) with hs
  have hs_meas : Measurable s := ((hw_meas.norm.inv).smul hw_meas).indicator hQδm
  have hs_le : ∀ x, ‖s x‖ ≤ 1 := by
    intro x
    by_cases hx : x ∈ Qδ
    · rw [hs, Set.indicator_of_mem hx, norm_smul, norm_inv, norm_norm]
      by_cases h0 : ‖w x‖ = 0
      · simp [h0]
      · rw [inv_mul_cancel₀ h0]
    · rw [hs, Set.indicator_of_notMem hx, norm_zero]; exact zero_le_one
  have hs_zero : ∀ x, x ∉ Qδ → s x = 0 := fun x hx => Set.indicator_of_notMem hx _
  have hs_int : Integrable s := by
    rw [hs, integrable_indicator_iff hQδm]
    exact Measure.integrableOn_of_bounded (M := 1) hQδfin.ne
      ((hw_meas.norm.inv).smul hw_meas).aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => by
        rw [norm_smul, norm_inv, norm_norm]
        by_cases h0 : ‖w x‖ = 0
        · simp [h0]
        · rw [inv_mul_cancel₀ h0])
  -- Step 2(e): `Df(x)(s(x)) = 1_{Q_δ}(x) ‖Df(x)‖`
  have hs_apply : ∀ x, fderiv ℝ f x (s x) = Qδ.indicator (fun x => ‖fderiv ℝ f x‖) x := by
    intro x
    by_cases hx : x ∈ Qδ
    · rw [hs, Set.indicator_of_mem hx, Set.indicator_of_mem hx, map_smul, hw_apply,
        smul_eq_mul, ← hw_norm]
      by_cases h0 : ‖w x‖ = 0
      · simp [h0]
      · field_simp
    · rw [hs, Set.indicator_of_notMem hx, Set.indicator_of_notMem hx, map_zero]
  -- Step 3: the reflected kernel `ρ̌(z) = ρ(−z)` satisfies the kernel hypotheses
  have hρr_smooth : ContDiff ℝ (⊤ : ℕ∞) (fun z => ρ (-z)) := hρ.comp contDiff_neg
  have hρr_nonneg : ∀ z, 0 ≤ (fun z => ρ (-z)) z := fun z => hρ0 (-z)
  have hρr_int : ∫ z, (fun z => ρ (-z)) z = 1 := by
    simp only
    rw [integral_neg_eq_self]
    exact hρ1
  have hρr_supp : support (fun z => ρ (-z)) ⊆ ball (0 : Euclid (m + 1)) σ := by
    intro z hz
    have h := hρs (show -z ∈ support ρ from hz)
    simpa using h
  -- Step 4: the smoothed field `G = ρ̌ ⋆ s` is admissible
  set G : Euclid (m + 1) → Euclid (m + 1) :=
    convolution (fun z => ρ (-z)) s (ContinuousLinearMap.lsmul ℝ ℝ) volume
  obtain ⟨hG_smooth, hG_cpt, hG_tsupp, hG_le⟩ :=
    Submission.cmcdt_cbm_sa_smoothed_field m δ σ (fun z => ρ (-z)) s hσ hσδ hρr_smooth
      hρr_nonneg hρr_int hρr_supp hs_meas.aestronglyMeasurable hs_le hs_zero
  -- Step 5: testing the variation hypothesis with `−G` gives `−∫_{Q₁} u div G ≤ V`
  have h5 := hV (-G) hG_smooth.neg hG_cpt.neg (by rw [tsupport_neg]; exact hG_tsupp)
    (fun y => by rw [Pi.neg_apply, norm_neg]; exact hG_le y)
  have h5' : -∫ y in Q1, u y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G y) ≤ V := by
    rw [← integral_neg]
    convert h5 using 3 with y
    rw [fderiv_neg, ContinuousLinearMap.toLinearMap_neg, map_neg, mul_neg]
  -- Step 6: the adjoint identity `∫ Df(s) = −∫ ū div G`
  have h6 := Submission.cmcdt_cbm_sa_mollify_adjoint (m + 1) ρ ub s hρC1 hρc hub_int hs_int
  -- Step 7: `∫ ū div G = ∫_{Q₁} u div G`
  have h7 : ∫ z, ub z * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G z) =
      ∫ z in Q1, u z * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G z) := by
    rw [← integral_indicator hQ1m]
    congr 1
    funext z
    by_cases hz : z ∈ Q1
    · simp [hub, hz]
    · simp [hub, hz]
  -- Step 8: `∫_{Q_δ} ‖Df‖ = ∫ Df(s) = −∫_{Q₁} u div G ≤ V`
  calc ∫ x in Qδ, ‖fderiv ℝ f x‖
      = ∫ x, Qδ.indicator (fun x => ‖fderiv ℝ f x‖) x := (integral_indicator hQδm).symm
    _ = ∫ x, fderiv ℝ f x (s x) := by
        congr 1
        funext x
        exact (hs_apply x).symm
    _ = -∫ z, ub z * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G z) := h6
    _ = -∫ z in Q1, u z * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G z) := by rw [h7]
    _ ≤ V := h5'

/-- **Smooth approximation with the variation bound on `Q_δ`** (Simon Ch. 2, 2.5, as used in the
proof of 2.7 and of the deformation theorem, Ch. 6, 5.1).  If `u` is integrable on `Q₁` and
`∫_{Q₁} u div g ≤ V` for every smooth compactly supported field `g` with `spt g ⊆ Q₁` and
`|g| ≤ 1`, then for `δ > 0` the mollifications `v_k = ρ_k ⋆ 1_{Q₁}u` are `C^∞` and satisfy
`∫_{Q_δ} ‖Dv_k‖ ≤ V` and `∫_{Q_δ} |v_k − u| → 0`.  Here `ρ_k` is the unit-mass normalization of
the bump of radius `σ_k = δ/(k + 2) < δ`; the bound is `cmcdt_cbm_sa_grad_bound`, and since
`1_{Q₁}u = u` on `Q_δ ⊆ Q₁`, the convergence follows from `cmcdt_cbm_sa_mollify_l1` as
`σ_k → 0`. -/
theorem Submission.cmcdt_cbm_smooth_approx : ∀ (m : ℕ) (u : Euclid (m + 1) → ℝ) (V δ : ℝ), IntegrableOn u {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ y, ‖g y‖ ≤ 1) → ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, u y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) ≤ V) → 0 < δ → ∃ v : ℕ → Euclid (m + 1) → ℝ, (∀ k, ContDiff ℝ 1 (v k)) ∧ (∀ k, ∫ x in {z : Euclid (m + 1) | ∀ i, δ < z i ∧ z i < 1 - δ}, ‖fderiv ℝ (v k) x‖ ≤ V) ∧ Tendsto (fun k => ∫ x in {z : Euclid (m + 1) | ∀ i, δ < z i ∧ z i < 1 - δ}, |v k x - u x|) atTop (𝓝 0) := by
  intro m u V δ hu hV hδ
  set Q1 : Set (Euclid (m + 1)) := {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}
  set Qδ : Set (Euclid (m + 1)) := {z : Euclid (m + 1) | ∀ i, δ < z i ∧ z i < 1 - δ}
  -- Step 0: the cubes are measurable, `Q_δ ⊆ Q₁`, and `ū = 1_{Q₁}u` is integrable
  have hcoord : ∀ i : Fin (m + 1), Measurable (fun y : Euclid (m + 1) => y i) := fun i =>
    (EuclideanSpace.proj (𝕜 := ℝ) i).continuous.measurable
  have hcube : ∀ a b : ℝ, MeasurableSet {y : Euclid (m + 1) | ∀ i, a < y i ∧ y i < b} := by
    intro a b
    have : {y : Euclid (m + 1) | ∀ i, a < y i ∧ y i < b} =
        ⋂ i, ({y : Euclid (m + 1) | a < y i} ∩ {y | y i < b}) := by
      ext y; simp
    rw [this]
    exact MeasurableSet.iInter fun i =>
      (measurableSet_lt measurable_const (hcoord i)).inter
        (measurableSet_lt (hcoord i) measurable_const)
  have hQ1m : MeasurableSet Q1 := hcube 0 1
  have hQδm : MeasurableSet Qδ := hcube δ (1 - δ)
  have hQδQ1 : Qδ ⊆ Q1 := fun y hy i => ⟨by linarith [(hy i).1], by linarith [(hy i).2]⟩
  set ub : Euclid (m + 1) → ℝ := Q1.indicator u
  have hub_int : Integrable ub := (integrable_indicator_iff hQ1m).2 hu
  -- Step 1: radii `σ_k = δ/(k + 2) ∈ (0, δ)` and kernels `ρ_k = b_k / ∫ b_k`, where `b_k` is the
  -- `C^∞` bump with `b_k = 1` on `B_{σ_k/2}(0)`, `0 ≤ b_k ≤ 1` and `support b_k = B_{σ_k}(0)`
  set σ : ℕ → ℝ := fun k => δ / ((k : ℝ) + 2)
  have hσ0 : ∀ k, 0 < σ k := fun k => div_pos hδ (by positivity)
  have hσδ : ∀ k, σ k < δ := fun k =>
    div_lt_self hδ (by have := (Nat.cast_nonneg k : (0 : ℝ) ≤ k); linarith)
  let b : ℕ → ContDiffBump (0 : Euclid (m + 1)) := fun k =>
    ⟨σ k / 2, σ k, half_pos (hσ0 k), half_lt_self (hσ0 k)⟩
  have hb_int : ∀ k, 0 < ∫ y, b k y := fun k => by
    refine (integral_pos_iff_support_of_nonneg (b k).nonneg'
      ((b k).continuous.integrable_of_hasCompactSupport (b k).hasCompactSupport)).2 ?_
    rw [(b k).support_eq]
    exact measure_ball_pos volume _ (b k).rOut_pos
  set ρ : ℕ → Euclid (m + 1) → ℝ := fun k x => b k x / ∫ y, b k y
  have hρ_smooth : ∀ k, ContDiff ℝ (⊤ : ℕ∞) (ρ k) := fun k => (b k).contDiff.div_const _
  have hρ_nonneg : ∀ k z, 0 ≤ ρ k z := fun k z => div_nonneg (b k).nonneg (hb_int k).le
  have hρ_one : ∀ k, ∫ z, ρ k z = 1 := fun k => by
    show ∫ z, b k z / ∫ y, b k y = 1
    rw [integral_div, div_self (hb_int k).ne']
  have hρ_supp : ∀ k, support (ρ k) = ball (0 : Euclid (m + 1)) (σ k) := fun k => by
    show support (fun x => b k x / ∫ y, b k y) = ball 0 (b k).rOut
    rw [support_div, (b k).support_eq, support_const (hb_int k).ne', inter_univ]
  have hρ_cpt : ∀ k, HasCompactSupport (ρ k) := fun k =>
    HasCompactSupport.intro (isCompact_closedBall (0 : Euclid (m + 1)) (σ k)) fun x hx => by
      by_contra h
      exact hx (ball_subset_closedBall ((hρ_supp k).subset h))
  -- Step 2: `v_k = ρ_k ⋆ ū` is `C^∞` (differentiation under the integral sign), hence `C¹`
  refine ⟨fun k => convolution (ρ k) ub (ContinuousLinearMap.lsmul ℝ ℝ) volume, fun k => ?_,
    fun k => ?_, ?_⟩
  · exact ((hρ_cpt k).contDiff_convolution_left (ContinuousLinearMap.lsmul ℝ ℝ) (hρ_smooth k)
      hub_int.locallyIntegrable).of_le (by exact_mod_cast le_top)
  -- Step 3: the variation bound `∫_{Q_δ} ‖Dv_k‖ ≤ V`, since `0 < σ_k < δ`
  · exact Submission.cmcdt_cbm_sa_grad_bound m u V δ (σ k) (ρ k) hu hV (hσ0 k) (hσδ k) (hρ_smooth k)
      (hρ_nonneg k) (hρ_one k) (hρ_supp k).subset
  -- Step 4: given `ε > 0`, `cmcdt_cbm_sa_mollify_l1` gives `r > 0` with `‖ρ ⋆ ū − ū‖₁ ≤ ε/2` for
  -- unit-mass kernels supported in `B_r(0)`; `σ_k ≤ r` for `k ≥ N > δ/r`, and `ū = u` on `Q_δ`
  · rw [Metric.tendsto_atTop]
    intro ε hε
    obtain ⟨r, hr, hL1⟩ :=
      Submission.cmcdt_cbm_sa_mollify_l1 (m + 1) ub hub_int (ε / 2) (half_pos hε)
    obtain ⟨N, hN⟩ := exists_nat_gt (δ / r)
    refine ⟨N, fun k hk => ?_⟩
    have hσr : σ k ≤ r := by
      have hNk : (N : ℝ) ≤ k := by exact_mod_cast hk
      have h1 : δ < r * ((k : ℝ) + 2) := by
        rw [mul_comm]
        exact (div_lt_iff₀ hr).1 (by linarith)
      exact (div_le_iff₀ (by positivity)).2 h1.le
    have hL := hL1 (ρ k) (hρ_smooth k).continuous (hρ_nonneg k) (hρ_one k)
      ((hρ_supp k).subset.trans (ball_subset_ball hσr))
    rw [dist_zero_right]
    calc ‖∫ x in Qδ, |convolution (ρ k) ub (ContinuousLinearMap.lsmul ℝ ℝ) volume x - u x|‖
        ≤ (∫⁻ x in Qδ, ENNReal.ofReal
            ‖|convolution (ρ k) ub (ContinuousLinearMap.lsmul ℝ ℝ) volume x - u x|‖).toReal :=
          norm_integral_le_lintegral_norm _
      _ = (∫⁻ x in Qδ,
            ‖convolution (ρ k) ub (ContinuousLinearMap.lsmul ℝ ℝ) volume x - ub x‖ₑ).toReal := by
          congr 1
          refine setLIntegral_congr_fun hQδm fun x hx => ?_
          have hx1 : ub x = u x := indicator_of_mem (hQδQ1 hx) u
          rw [hx1, Real.norm_eq_abs, abs_abs, Real.enorm_eq_ofReal_abs]
      _ ≤ ε / 2 := ENNReal.toReal_le_of_le_ofReal (half_pos hε).le
          ((setLIntegral_le_lintegral _ _).trans hL)
      _ < ε := half_lt_self hε

/-- **BV Poincaré inequality on the unit cube** (Simon Ch. 2, 2.7, as used for the first line of
(32) in the proof of Ch. 6, 5.1).  Let `n = m + 1` and `Q_δ = (δ, 1 − δ)ⁿ`, `Q₁ = Q_0`.  If
`u ∈ L¹(Q₁)` and `∫_{Q₁} u div g ≤ V` for all `g ∈ C^∞_c(Q₁; ℝⁿ)` with `|g| ≤ 1`, then
`∫_{Q₁} |u − c| ≤ 2^{n+1} √n V` for the mean `c = ∫_{Q₁} u`.  Testing with `g = 0` gives
`V ≥ 0`.  For `0 < δ < 1/2` the `C¹` functions `v_k` of `cmcdt_cbm_smooth_approx` have
`∫_{Q_δ} |Dv_k| ≤ V` and `v_k → u` in `L¹(Q_δ)`, so `cmcdt_cbm_smooth_poincare` bounds their
oscillation `∫_{Q_δ}∫_{Q_δ} |v_k(x) − v_k(y)|` by `K = 2ⁿ√n V`, and the bound passes to `u`
(`cmcdt_cbm_bvp_osc_le_of_l1_approx`), then to `Q₁` as `δ ↓ 0`
(`cmcdt_cbm_bvp_osc_le_of_inner_cubes`).  As `|Q₁| = 1`, `∫_{Q₁} |u − c|` is at most the
oscillation of `u` over `Q₁` (`cmcdt_cbm_bvp_mean_dev_le_osc`), and `K ≤ 2^{n+1}√n V`. -/
theorem Submission.cmcdt_cbm_bv_poincare : ∀ (m : ℕ) (u : Euclid (m + 1) → ℝ) (V : ℝ), IntegrableOn u {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ y, ‖g y‖ ≤ 1) → ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, u y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) ≤ V) → ∃ c : ℝ, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u y - c| ≤ 2 ^ (m + 2) * Real.sqrt (m + 1) * V := by
  intro m u V hu hV
  -- Step 0: `V ≥ 0`, testing with `g = 0`
  have hV0 : 0 ≤ V := by
    simpa using hV 0 contDiff_zero_fun .zero (by simp only [tsupport_zero, empty_subset])
      (by simp)
  -- Step 2: for `0 < δ < 1/2` the oscillation of `u` over `Q_δ` is at most `K = 2ⁿ√n V`
  have hδ : ∀ δ : ℝ, 0 < δ → δ < 1 / 2 →
      ∫ x in {z : Euclid (m + 1) | ∀ i, δ < z i ∧ z i < 1 - δ},
        ∫ y in {z : Euclid (m + 1) | ∀ i, δ < z i ∧ z i < 1 - δ}, |u x - u y| ≤
        2 ^ (m + 1) * Real.sqrt (m + 1) * V := by
    intro δ hδ _
    obtain ⟨v, hv, hvV, hvu⟩ := Submission.cmcdt_cbm_smooth_approx m u V δ hu hV hδ
    refine Submission.cmcdt_cbm_bvp_osc_le_of_l1_approx m u v δ _ hu hδ.le
      (fun k => (hv k).continuous) (fun k => ?_) hvu
    exact (Submission.cmcdt_cbm_smooth_poincare m (v k) δ (hv k) hδ.le).trans
      (mul_le_mul_of_nonneg_left (hvV k) (by positivity))
  -- Steps 3–4: let `δ ↓ 0`, then compare with the mean `c = ∫_{Q₁} u` (`|Q₁| = 1`)
  refine ⟨∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, u y, ?_⟩
  calc _ ≤ ∫ x in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1},
          ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u x - u y| :=
        Submission.cmcdt_cbm_bvp_mean_dev_le_osc m _ u
          (Submission.cmcdt_cbm_bvp_unit_cube_volume m) hu
    _ ≤ 2 ^ (m + 1) * Real.sqrt (m + 1) * V :=
        Submission.cmcdt_cbm_bvp_osc_le_of_inner_cubes m u _ hu hδ
    _ ≤ 2 ^ (m + 2) * Real.sqrt (m + 1) * V := by
      gcongr
      · norm_num
      · omega
/-- **Trace estimate on the unit cube** (step 5 of the median argument; it replaces the appeal to
Simon Ch. 2, 2.8–2.9 in the second line of (32) in the proof of Ch. 6, 5.1).  `div G = tr DG` is
continuous, so `|div G| ≤ M` on `Q₁`.  For `δ ∈ (0, 1/4)` the `C¹` functions `v_k` of
`cmcdt_cbm_smooth_approx` have `∫_{Q_δ} ‖Dv_k‖ ≤ V` and `v_k → w` in `L¹(Q_δ)`, so the smooth
estimate `cmcdt_cbm_smooth_trace` on `Q_δ` passes to `w` (`cmcdt_cbm_bvt_l1_limit`); `Q_δ ⊆ Q₁`
bounds `∫_{Q_δ} |w|` by `∫_{Q₁} |w|`, and `δ → 0⁺` by `cmcdt_cbm_bvt_cube_exhaust`. -/
theorem Submission.cmcdt_cbm_bv_trace : ∀ (m : ℕ) (w : Euclid (m + 1) → ℝ) (V : ℝ), IntegrableOn w {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ y, ‖g y‖ ≤ 1) → ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, w y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) ≤ V) → ∀ G : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 G → (∀ y, ‖G y‖ ≤ 1) → |∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, w y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G y)| ≤ (2 * (m + 1) + 1) * V + 4 * (m + 1) * ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |w y| := by
  intro m w V hw hV G hG hG1
  -- the cubes `{a < z_i < b}` are open, and `Q_δ ⊆ Q₁` for `δ ≥ 0`
  have hopen : ∀ a b : ℝ, IsOpen {z : Euclid (m + 1) | ∀ i, a < z i ∧ z i < b} := by
    intro a b
    simp only [ofPred_forall, ofPred_and]
    exact isOpen_iInter_of_finite fun i =>
      (isOpen_lt continuous_const (PiLp.continuous_apply 2 _ i)).inter
        (isOpen_lt (PiLp.continuous_apply 2 _ i) continuous_const)
  have hsub : ∀ δ : ℝ, 0 ≤ δ → {z : Euclid (m + 1) | ∀ i, δ < z i ∧ z i < 1 - δ} ⊆
      {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} := fun δ hδ z hz i =>
    ⟨hδ.trans_lt (hz i).1, (hz i).2.trans_le (by linarith)⟩
  -- `div G = tr ∘ DG` is continuous, hence bounded by `M` on `Q₁`
  have hdc : Continuous fun y => LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G y) :=
    ((LinearMap.trace ℝ (Euclid (m + 1))).comp
      (ContinuousLinearMap.coeLM ℝ)).continuous_of_finiteDimensional.comp
      (hG.continuous_fderiv one_ne_zero)
  obtain ⟨⟨M, hM⟩, -⟩ := Submission.cmcdt_cbm_bvt_cube_cont_bound (m + 1) _ hdc
  -- for `δ ∈ (0, 1/4)`: `|∫_{Q_δ} w div G| ≤ (2n + 1) V + 4n ∫_{Q₁} |w|`
  have hδbound : ∀ δ ∈ Ioo (0 : ℝ) (1 / 4),
      |∫ y in {z : Euclid (m + 1) | ∀ i, δ < z i ∧ z i < 1 - δ},
          w y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G y)| ≤
        (2 * (m + 1) + 1) * V +
          4 * (m + 1) * ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |w y| := by
    rintro δ ⟨hδ0, hδ⟩
    have hQ := hsub δ hδ0.le
    -- `C¹` approximations `v_k → w` in `L¹(Q_δ)` with `∫_{Q_δ} ‖Dv_k‖ ≤ V`
    obtain ⟨v, hv, hvV, hvw⟩ := Submission.cmcdt_cbm_smooth_approx m w V δ hw hV hδ0
    refine (Submission.cmcdt_cbm_bvt_l1_limit volume _ v w
      (fun y => LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G y)) ((2 * (m + 1) + 1) * V)
      (4 * (m + 1)) M (hopen δ (1 - δ)).measurableSet (by positivity)
      (fun k => (Submission.cmcdt_cbm_bvt_cube_cont_bound (m + 1) (v k)
        (hv k).continuous).2.mono_set hQ)
      (hw.mono_set hQ) hdc.aestronglyMeasurable (fun y hy => hM y (hQ hy)) hvw
      fun k => ?_).trans ?_
    · -- the smooth estimate on `Q_δ`, with `∫_{Q_δ} ‖Dv_k‖ ≤ V`
      refine (Submission.cmcdt_cbm_smooth_trace m (v k) G δ (hv k) hG hG1 hδ0.le hδ.le).trans ?_
      gcongr _ * ?_ + _
      exact hvV k
    · -- `∫_{Q_δ} |w| ≤ ∫_{Q₁} |w|`
      gcongr _ + _ * ?_
      exact setIntegral_mono_set (Integrable.abs hw) (ae_of_all _ fun y => abs_nonneg (w y))
        (ae_of_all _ hQ)
  -- `δ → 0⁺`: `∫_{Q_δ} w div G → ∫_{Q₁} w div G`, with `w div G` integrable on `Q₁`
  have hwG : IntegrableOn (fun y => w y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G y))
      {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} :=
    Integrable.mul_bdd hw hdc.aestronglyMeasurable
      (ae_restrict_of_forall_mem (hopen 0 1).measurableSet fun y hy => hM y hy)
  exact le_of_tendsto (Submission.cmcdt_cbm_bvt_cube_exhaust (m + 1) _ hwG).abs
    (Filter.mem_of_superset (Ioo_mem_nhdsGT (by norm_num : (0 : ℝ) < 1 / 4)) hδbound)

/-- **Poincaré and trace inequalities on the unit cube with an integer median** (part C of the
proof of the deformation theorem, Simon Ch. 6, 5.1, displays (26)–(33), replacing the appeal to
the BV facts Ch. 6, 2.35–2.37 and Ch. 2, 2.7, 2.9).  Let `n = m + 1` and `Q₁ = (0, 1)ⁿ`.  If `u`
is integer-valued and integrable on `Q₁`, and `∫_{Q₁} u div g ≤ V` for every smooth `g` with
compact support in `Q₁` and `|g| ≤ 1`, then an integer `β` satisfies `∫_{Q₁} |u − β| ≤ cV`,
`|β| ≤ 2 ∫_{Q₁} |u|` and `|∫_{Q₁} (u − β) div G| ≤ cV` for every smooth `G` with `|G| ≤ 1`, where
`c = 2ⁿ⁺¹√n + (2n + 1) + 4n · 2ⁿ⁺¹√n`.  Testing with `g = 0` gives `V ≥ 0`.  The integer median
`β` of `cmcdt_cbm_integer_median` minimizes `c ↦ ∫_{Q₁} |u − c|`, so the Poincaré inequality
`cmcdt_cbm_bv_poincare` gives the first bound.  Since `∫_{Q₁} div g = 0`
(`cmcdt_cbm_integral_div_eq_zero`), `u − β` satisfies the hypothesis with the same `V`, and the
trace estimate `cmcdt_cbm_bv_trace` gives
`|∫_{Q₁} (u − β) div G| ≤ (2n + 1)V + 4n ∫_{Q₁} |u − β|`. -/
theorem Submission.cmcdt_cube_bv_median : ∀ m : ℕ, ∃ c : ℝ, 0 < c ∧ ∀ (u : Euclid (m + 1) → ℝ) (V : ℝ), (∀ y, ∃ z : ℤ, u y = z) → IntegrableOn u {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ y, ‖g y‖ ≤ 1) → ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, u y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) ≤ V) → ∃ β : ℤ, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u y - β| ≤ c * V ∧ |(β : ℝ)| ≤ 2 * ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u y| ∧ ∀ G : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) G → (∀ y, ‖G y‖ ≤ 1) → |∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, (u y - β) * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G y)| ≤ c * V := by
  intro m
  have hA : (0 : ℝ) ≤ 2 ^ (m + 2) * Real.sqrt (m + 1) := by positivity
  refine ⟨2 ^ (m + 2) * Real.sqrt (m + 1) + (2 * (m + 1) + 1) +
    4 * (m + 1) * (2 ^ (m + 2) * Real.sqrt (m + 1)), by positivity, ?_⟩
  intro u V hint hu hV
  -- Step 0: `V ≥ 0`, testing with `g = 0`
  have hV0 : 0 ≤ V := by
    simpa using hV (fun _ => 0) contDiff_const HasCompactSupport.zero (by simp [tsupport])
      (fun _ => by simp)
  have hAV : 0 ≤ 2 ^ (m + 2) * Real.sqrt (m + 1) * V := mul_nonneg hA hV0
  have hmV : 0 ≤ (m : ℝ) * V := mul_nonneg m.cast_nonneg hV0
  have hmAV : 0 ≤ (m : ℝ) * (2 ^ (m + 2) * Real.sqrt (m + 1) * V) := mul_nonneg m.cast_nonneg hAV
  -- `Q₁` is the preimage of the box `(0, 1)ⁿ ⊆ Fin n → ℝ`, so it has volume `1`
  have hQ : volume {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} ≠ ⊤ := by
    have hpre : {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} =
        (WithLp.ofLp : Euclid (m + 1) → Fin (m + 1) → ℝ) ⁻¹' Set.pi univ fun _ => Ioo 0 1 := by
      ext y
      simp [Set.mem_pi]
    rw [hpre, (PiLp.volume_preserving_ofLp (Fin (m + 1))).measure_preimage
      (MeasurableSet.univ_pi fun _ => measurableSet_Ioo).nullMeasurableSet, Real.volume_pi_Ioo]
    simp
  -- Steps 3–4: `∫_{Q₁} |u − β| ≤ ∫_{Q₁} |u − c₀| ≤ 2ⁿ⁺¹√n V` for the integer median `β`
  obtain ⟨c₀, hc₀⟩ := Submission.cmcdt_cbm_bv_poincare m u V hu hV
  obtain ⟨β, hβmin, hβ⟩ := Submission.cmcdt_cbm_integer_median m u hint hu
  have h1 : ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u y - β| ≤
      2 ^ (m + 2) * Real.sqrt (m + 1) * V :=
    (hβmin c₀).trans hc₀
  refine ⟨β, h1.trans (by nlinarith), hβ, fun G hG hG1 => ?_⟩
  -- Step 0: `u − β` is integrable on `Q₁` and, as `∫_{Q₁} div g = 0`, satisfies the hypothesis
  -- with the same `V`
  have hw : IntegrableOn (fun y => u y - β) {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} :=
    hu.sub (integrableOn_const hQ)
  have hwV : ∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) g →
      HasCompactSupport g → tsupport g ⊆ {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} →
      (∀ y, ‖g y‖ ≤ 1) → ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1},
        (u y - β) * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) ≤ V := by
    intro g hg hgc hgQ hg1
    -- `div g` is continuous with compact support, hence integrable
    have hd : Integrable fun y => LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) := by
      have htr : Continuous fun A : Euclid (m + 1) →L[ℝ] Euclid (m + 1) =>
          LinearMap.trace ℝ (Euclid (m + 1)) (A : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) :=
        (LinearMap.trace ℝ (Euclid (m + 1)) ∘ₗ
          ContinuousLinearMap.coeLM ℝ).continuous_of_finiteDimensional
      exact (htr.comp (hg.continuous_fderiv (by simp))).integrable_of_hasCompactSupport
        ((hgc.fderiv ℝ).comp_left (by simp))
    have hdiv := Submission.cmcdt_cbm_integral_div_eq_zero m g
      (hg.of_le (by exact_mod_cast le_top)) hgc hgQ
    by_cases hud : IntegrableOn
        (fun y => u y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y))
        {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}
    · -- `∫ (u − β) div g = ∫ u div g − β ∫ div g = ∫ u div g ≤ V`
      simp_rw [sub_mul]
      rw [integral_sub hud (hd.const_mul _).integrableOn, integral_const_mul, hdiv, mul_zero,
        sub_zero]
      exact hV g hg hgc hgQ hg1
    · -- otherwise `(u − β) div g` is not integrable either, and its integral vanishes
      have hnot : ¬IntegrableOn
          (fun y => (u y - β) * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y))
          {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} := by
        intro h
        refine hud ((h.add (hd.const_mul (β : ℝ)).integrableOn).congr_fun_ae
          (ae_of_all _ fun y => ?_))
        simp only [Pi.add_apply]
        ring
      rw [integral_undef hnot]
      exact hV0
  -- Step 5: the trace estimate for `u − β`
  calc |∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1},
        (u y - β) * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G y)|
      ≤ (2 * (m + 1) + 1) * V + 4 * (m + 1) *
          ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u y - β| :=
        Submission.cmcdt_cbm_bv_trace m (fun y => u y - β) V hw hwV G
          (hG.of_le (by exact_mod_cast le_top)) hG1
    _ ≤ (2 * (m + 1) + 1) * V + 4 * (m + 1) * (2 ^ (m + 2) * Real.sqrt (m + 1) * V) := by
        gcongr
    _ ≤ _ := by nlinarith

/-- **Face replacement** (Simon Ch. 6, proof of 5.1, displays (26)–(37); the BV facts on the
faces come from `cmcdt_cube_bv_median`).  Let `Q₀` be integer multiplicity, `n = m + 1`,
`spt Q₀ ⊆ K ∩ Lₙ`, `M(Q₀) ≤ Λ` and `M(∂Q₀) < ∞`.  Over the open unit `n`-faces `F̆`,
`Q₀ = Σ_F ũ_F [[F̆]]` with integer densities `ũ_F`, `Σ_F ∫|ũ_F| ≤ M(Q₀)`
(`cmcdtfr_skeleton_decomposition`); testing `∂Q₀` near `F̆` bounds the variation of `ũ_F` by
`V_F` with `Σ_F V_F ≤ M(∂Q₀)` (`cmcdtfr_boundary_variation`).  Integer medians `β_F` of the
`ũ_F` (`cmcdt_cube_bv_median`, constant `c_B`) give `Pc = Σ_F β_F [[F]]`, which lies in the
finite family of integer chains on faces meeting `K` with `Σ|β_F| ≤ 2Λ`
(`cmcdtfr_finite_family`).  Then `M(Q₀ − Pc)`, `M(∂(Q₀ − Pc)) ≤ c_B M(∂Q₀)`
(`cmcdtfr_face_integral_current`), so `M(∂Pc) ≤ (1 + c_B) M(∂Q₀)` as
`∂Pc = ∂Q₀ − ∂(Q₀ − Pc)`; `Pc` and `∂Pc` are integer multiplicity, `M(Pc) = Σ|β_F| ≤ 2M(Q₀)`,
and `Pc = 0` or `M(Pc) ≥ 1` (`cmcdtfr_polyhedral_im`, `cmcdtfr_chain_boundary`).  A face
carrying `Pc` meets `spt Q₀`, a face carrying `Q₀ − Pc` meets `spt ∂Q₀` (there `V_F ≠ 0`), and a
face has diameter `≤ √P` (`cmcdtfr_face_geometry`).  Take `c = max(2, 1 + c_B)`. -/
theorem Submission.cmcdt_face_replacement : (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (P m : ℕ), ∃ c : NNReal, 1 ≤ c ∧ ∀ (K : Set (Euclid P)) (Λ : NNReal), IsCompact K → ∃ 𝒬₀ : Set (GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 𝒬₀.Finite ∧ ∀ Q₀ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Q₀ → Q₀.support ⊆ K → Q₀.support ⊆ {x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} → Q₀.mass ≤ Λ → Q₀.boundary.mass < ∞ → ∃ Pc ∈ 𝒬₀, IsIntegerMultiplicity Pc ∧ IsIntegerMultiplicity Pc.boundary ∧ (Pc = 0 ∨ 1 ≤ Pc.mass) ∧ Pc.mass ≤ c * Q₀.mass ∧ Pc.boundary.mass ≤ c * Q₀.boundary.mass ∧ (Q₀ - Pc).mass ≤ c * Q₀.boundary.mass ∧ Pc.support ⊆ cthickening (Real.sqrt P) Q₀.support ∧ (Q₀ - Pc).support ∪ Pc.boundary.support ⊆ cthickening (Real.sqrt P) Q₀.boundary.support := by
  intro hVO hMR hIMC P m
  -- support and mass calculus for currents in `ℝᴾ`: `spt(A − B) ⊆ spt A ∪ spt B`,
  -- `spt ∂A ⊆ spt A` and `M(A − B) ≤ M(A) + M(B)`
  have hspt_sub : ∀ (k : ℕ) (A B : GeometricCurrentOn (univ : Set (Euclid P)) k),
      (A - B).support ⊆ A.support ∪ B.support := by
    intro k A B x hx
    simp only [GeometricCurrentOn.support, Set.mem_sdiff, mem_union, mem_univ, true_and] at hx ⊢
    by_contra h
    rw [not_or, not_not, not_not] at h
    apply hx
    obtain ⟨hA, hB⟩ := h
    simp only [GeometricCurrentOn.zeroRegion, mem_sUnion, mem_ofPred_eq] at hA hB ⊢
    obtain ⟨W₁, ⟨hW₁o, hW₁c, -, hW₁v⟩, hxW₁⟩ := hA
    obtain ⟨W₂, ⟨hW₂o, -, -, hW₂v⟩, hxW₂⟩ := hB
    refine ⟨W₁ ∩ W₂, ⟨hW₁o.inter hW₂o,
      hW₁c.of_isClosed_subset isClosed_closure (closure_mono inter_subset_left), subset_univ _,
      fun ω hω => ?_⟩, hxW₁, hxW₂⟩
    show A ω - B ω = 0
    rw [hW₁v ω (hω.trans inter_subset_left), hW₂v ω (hω.trans inter_subset_right), sub_zero]
  have hspt_bd : ∀ (k : ℕ) (A : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)),
      A.boundary.support ⊆ A.support := by
    intro k A x hx
    simp only [GeometricCurrentOn.support, Set.mem_sdiff] at hx ⊢
    refine ⟨hx.1, fun hxA => hx.2 ?_⟩
    simp only [GeometricCurrentOn.zeroRegion, mem_sUnion, mem_ofPred_eq] at hxA ⊢
    obtain ⟨W, ⟨hWo, hWc, hWU, hWv⟩, hxW⟩ := hxA
    refine ⟨W, ⟨hWo, hWc, hWU, fun γ hγ => ?_⟩, hxW⟩
    exact hWv (exteriorDerivativeTestOn univ k γ)
      ((tsupport_exteriorDerivative_subset _).trans hγ)
  have hmass_sub : ∀ (k : ℕ) (A B : GeometricCurrentOn (univ : Set (Euclid P)) k),
      (A - B).mass ≤ A.mass + B.mass := by
    intro k A B
    refine sSup_le ?_
    rintro r ⟨ω, hω, rfl⟩
    have hnω : -ω ∈ massAdmissibleOn (univ : Set (Euclid P)) k univ := by
      refine ⟨subset_univ _, fun x => ?_⟩
      have h := hω.2 x
      rwa [Submodule.coe_neg, Pi.neg_apply, covectorEuclideanNorm_neg]
    calc ENNReal.ofReal ((A - B) ω) = ENNReal.ofReal (A ω + B (-ω)) := by
          congr 1
          show A ω - B ω = A ω + B (-ω)
          rw [show B (-ω) = -B ω from map_neg B.toCurrent ω, sub_eq_add_neg]
      _ ≤ ENNReal.ofReal (A ω) + ENNReal.ofReal (B (-ω)) := ENNReal.ofReal_add_le
      _ ≤ A.mass + B.mass := add_le_add (A.le_massOn hω) (B.le_massOn hnω)
  -- `c_B` from the cube BV median lemma and `c := max(2, 1 + c_B)`
  obtain ⟨cB, hcB, hmedian⟩ := Submission.cmcdt_cube_bv_median m
  refine ⟨Real.toNNReal (max 2 (1 + cB)),
    Real.one_le_toNNReal.2 (le_max_of_le_left one_le_two), fun K Λ hK => ?_⟩
  -- `𝒬₀`: the integer chains `Σ β_F [[F]]` on faces meeting `K` with `Σ|β_F| ≤ 2Λ`
  refine ⟨_, Submission.cmcdtfr_finite_family P (m + 1) K (2 * (Λ : ℝ)) hK, ?_⟩
  intro Q₀ hQ₀ hQ₀K hQ₀L hQ₀Λ hQ₀b
  -- `Q₀ = Σ_F ũ_F [[F̆]]` over the open faces `F̆` meeting `spt Q₀`
  obtain ⟨s, u, hs, huZ, huI, hSu, huspt, hQ₀rep⟩ :=
    Submission.cmcdtfr_skeleton_decomposition hVO hMR hIMC P m K Q₀ hK hQ₀ hQ₀K hQ₀L
  -- the variations `V_F` of the `ũ_F`, with `Σ_F V_F ≤ M(∂Q₀)`
  obtain ⟨V, hV0, hSV, hVbd, hVspt⟩ :=
    Submission.cmcdtfr_boundary_variation hVO P m s u Q₀ hs huI hQ₀rep hQ₀b
  -- integer medians `β_F` (`β_F := 0` off `s`)
  have hmed : ∀ p : (Fin (m + 1) → Fin P) × (Fin P → ℤ), ∃ b : ℤ, p ∈ s →
      (∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u p y - b| ≤ cB * V p) ∧
      |(b : ℝ)| ≤ 2 * ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u p y| ∧
      ∀ G : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) G → (∀ y, ‖G y‖ ≤ 1) →
        |∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1},
          (u p y - b) * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ G y)| ≤ cB * V p := by
    intro p
    by_cases hp : p ∈ s
    · obtain ⟨b, hb⟩ := hmedian (u p) (V p) (huZ p hp) (huI p hp) (hVbd p hp)
      exact ⟨b, fun _ => hb⟩
    · exact ⟨0, fun h => absurd h hp⟩
  choose β hβ using hmed
  -- the face currents with densities `β_F` (this is `Pc`), `ũ_F` and `ũ_F − β_F`
  have hcube : volume {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} = 1 :=
    (Submission.cmcdtfr_face_geometry P (m + 1)).1
  have hβI : ∀ p ∈ s, IntegrableOn (fun _ : Euclid (m + 1) => (β p : ℝ))
      {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} := fun p _ =>
    integrableOn_const (by rw [hcube]; exact ENNReal.one_ne_top)
  obtain ⟨hβω, ⟨Pc, hPc⟩, hPcD⟩ :=
    Submission.cmcdtfr_face_integral_current P m s (fun p _ => (β p : ℝ)) hs hβI
  obtain ⟨huω, -, -⟩ := Submission.cmcdtfr_face_integral_current P m s u hs huI
  obtain ⟨-, -, hdD⟩ := Submission.cmcdtfr_face_integral_current P m s
    (fun p y => u p y - (β p : ℝ)) hs fun p hp => (huI p hp).sub (hβI p hp)
  -- `Pc = Σ_F β_F [[F]]`
  have hPcrep : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Pc ω =
      ∑ p ∈ s, (β p : ℝ) * ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1},
        (ω : DifferentialForm (Euclid P) (m + 1))
          (WithLp.toLp 2 (fun i => (p.2 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.1 j) (1 : ℝ))
          (fun j => EuclideanSpace.single (p.1 j) (1 : ℝ)) := by
    intro ω
    rw [hPc ω]
    exact Finset.sum_congr rfl fun p _ => integral_const_mul _ _
  -- `Q₀ − Pc = Σ_F (ũ_F − β_F) [[F̆]]`
  have hdrep : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), (Q₀ - Pc) ω =
      ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1},
        (u p y - (β p : ℝ)) * (ω : DifferentialForm (Euclid P) (m + 1))
          (WithLp.toLp 2 (fun i => (p.2 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.1 j) (1 : ℝ))
          (fun j => EuclideanSpace.single (p.1 j) (1 : ℝ)) := by
    intro ω
    show Q₀ ω - Pc ω = _
    rw [hQ₀rep ω, hPc ω, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun p hp => ?_
    rw [← integral_sub (huω ω p hp) (hβω ω p hp)]
    congr 1
    ext y
    ring
  -- integrality of `Pc` and `∂Pc`, `M(Pc) = Σ|β_F|`, and `Pc = 0` or `M(Pc) ≥ 1`
  obtain ⟨hPcIM, hPcmass, hPc01⟩ :=
    Submission.cmcdtfr_polyhedral_im hMR P (m + 1) s β Pc hs hPcrep
  obtain ⟨s', β', hs', hPcbrep⟩ := Submission.cmcdtfr_chain_boundary P m s β Pc hs hPcrep
  obtain ⟨hPcbIM, -, -⟩ :=
    Submission.cmcdtfr_polyhedral_im hMR P m s' β' Pc.boundary hs' hPcbrep
  -- mass and support bounds for `Pc` and `Q₀ − Pc` from their face densities
  obtain ⟨-, -, hPcspt⟩ := hPcD Pc hPc
  obtain ⟨hdmass, hdbmass, hdspt⟩ := hdD (Q₀ - Pc) hdrep
  have hdb : (Q₀ - Pc).boundary.mass ≤ ENNReal.ofReal (∑ p ∈ s, cB * V p) :=
    hdbmass (fun p => cB * V p) fun p hp G hG hG1 => (hβ p hp).2.2 G hG hG1
  -- `Σ|β_F| ≤ 2 Σ_F ∫|ũ_F| ≤ 2Λ`, `Σ_F ∫|ũ_F − β_F| ≤ c_B Σ_F V_F`
  have hβsum : ∑ p ∈ s, |(β p : ℝ)| ≤
      2 * ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u p y| := by
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum fun p hp => (hβ p hp).2.1
  have hSuΛ : ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u p y| ≤
      (Λ : ℝ) := by
    have h := hSu.trans hQ₀Λ
    rw [← ENNReal.ofReal_coe_nnreal] at h
    exact (ENNReal.ofReal_le_ofReal_iff Λ.coe_nonneg).1 h
  have hdsum : ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1},
      |u p y - (β p : ℝ)| ≤ cB * ∑ p ∈ s, V p := by
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum fun p hp => (hβ p hp).1
  have hdb' : (Q₀ - Pc).boundary.mass ≤ ENNReal.ofReal cB * Q₀.boundary.mass := by
    calc (Q₀ - Pc).boundary.mass ≤ ENNReal.ofReal (∑ p ∈ s, cB * V p) := hdb
      _ = ENNReal.ofReal cB * ENNReal.ofReal (∑ p ∈ s, V p) := by
          rw [← Finset.mul_sum, ENNReal.ofReal_mul hcB.le]
      _ ≤ ENNReal.ofReal cB * Q₀.boundary.mass := mul_le_mul' le_rfl hSV
  -- `∂Pc = ∂Q₀ − ∂(Q₀ − Pc)`
  have hPcb_eq : Pc.boundary = Q₀.boundary - (Q₀ - Pc).boundary := by
    ext γ
    show Pc (exteriorDerivativeTestOn univ m γ) = Q₀ (exteriorDerivativeTestOn univ m γ) -
      (Q₀ (exteriorDerivativeTestOn univ m γ) - Pc (exteriorDerivativeTestOn univ m γ))
    ring
  -- supports: a face carrying `Pc` meets `spt Q₀`, a face carrying `Q₀ − Pc` meets `spt ∂Q₀`
  -- (there `V_F ≠ 0`), and a face has diameter `≤ √P`
  have hdiam := fun p (hp : p ∈ s) =>
    ((Submission.cmcdtfr_face_geometry P (m + 1)).2 p p (hs p hp) (hs p hp)).2.1
  have hPcsupp : Pc.support ⊆ cthickening (Real.sqrt P) Q₀.support := by
    intro x hx
    obtain ⟨p, hp, -, y, hy, rfl⟩ := hPcspt x hx
    obtain ⟨y', hy', hy'Q⟩ := huspt p hp
    exact mem_cthickening_of_dist_le _ _ _ _ hy'Q (hdiam p hp y y' hy hy')
  have hdsupp : (Q₀ - Pc).support ⊆ cthickening (Real.sqrt P) Q₀.boundary.support := by
    intro x hx
    obtain ⟨p, hp, hne, y, hy, rfl⟩ := hdspt x hx
    have hVp : V p ≠ 0 := by
      intro h0
      apply hne
      have h1 := (hβ p hp).1
      rw [h0, mul_zero] at h1
      exact le_antisymm h1 (integral_nonneg fun y => abs_nonneg _)
    obtain ⟨y', hy', hy'Q⟩ := hVspt p hp hVp
    exact mem_cthickening_of_dist_le _ _ _ _ hy'Q (hdiam p hp y y' hy hy')
  have hPcbsupp : Pc.boundary.support ⊆ cthickening (Real.sqrt P) Q₀.boundary.support := by
    intro x hx
    rw [hPcb_eq] at hx
    rcases hspt_sub m _ _ hx with h | h
    · exact self_subset_cthickening _ h
    · exact hdsupp (hspt_bd m _ h)
  refine ⟨Pc, ?_, hPcIM, hPcbIM, hPc01, ?_, ?_, ?_, hPcsupp, union_subset hdsupp hPcbsupp⟩
  · -- `Pc ∈ 𝒬₀`
    rw [Set.mem_ofPred_eq]
    refine ⟨s, β, hs, fun p hp => ?_, by linarith, hPcrep⟩
    obtain ⟨y, hy, hyQ⟩ := huspt p hp
    exact ⟨y, hy, hQ₀K hyQ⟩
  · -- `M(Pc) = Σ|β_F| ≤ 2M(Q₀)`
    show Pc.mass ≤ ENNReal.ofReal (max 2 (1 + cB)) * Q₀.mass
    calc Pc.mass = ENNReal.ofReal (∑ p ∈ s, |(β p : ℝ)|) := hPcmass
      _ ≤ ENNReal.ofReal (2 * _) := ENNReal.ofReal_le_ofReal hβsum
      _ = ENNReal.ofReal 2 * ENNReal.ofReal _ := ENNReal.ofReal_mul zero_le_two
      _ ≤ ENNReal.ofReal (max 2 (1 + cB)) * Q₀.mass :=
          mul_le_mul' (ENNReal.ofReal_le_ofReal (le_max_left _ _)) hSu
  · -- `M(∂Pc) ≤ M(∂Q₀) + M(∂(Q₀ − Pc)) ≤ (1 + c_B)M(∂Q₀)`
    show Pc.boundary.mass ≤ ENNReal.ofReal (max 2 (1 + cB)) * Q₀.boundary.mass
    calc Pc.boundary.mass ≤ Q₀.boundary.mass + (Q₀ - Pc).boundary.mass := by
          rw [hPcb_eq]
          exact hmass_sub m _ _
      _ ≤ Q₀.boundary.mass + ENNReal.ofReal cB * Q₀.boundary.mass := add_le_add le_rfl hdb'
      _ = ENNReal.ofReal (1 + cB) * Q₀.boundary.mass := by
          rw [ENNReal.ofReal_add zero_le_one hcB.le, ENNReal.ofReal_one, add_mul, one_mul]
      _ ≤ ENNReal.ofReal (max 2 (1 + cB)) * Q₀.boundary.mass :=
          mul_le_mul' (ENNReal.ofReal_le_ofReal (le_max_right _ _)) le_rfl
  · -- `M(Q₀ − Pc) ≤ Σ_F ∫|ũ_F − β_F| ≤ c_B M(∂Q₀)`
    show (Q₀ - Pc).mass ≤ ENNReal.ofReal (max 2 (1 + cB)) * Q₀.boundary.mass
    calc (Q₀ - Pc).mass ≤ ENNReal.ofReal _ := hdmass
      _ ≤ ENNReal.ofReal (cB * ∑ p ∈ s, V p) := ENNReal.ofReal_le_ofReal hdsum
      _ = ENNReal.ofReal cB * ENNReal.ofReal (∑ p ∈ s, V p) := ENNReal.ofReal_mul hcB.le
      _ ≤ ENNReal.ofReal (max 2 (1 + cB)) * Q₀.boundary.mass :=
          mul_le_mul' (ENNReal.ofReal_le_ofReal (by linarith [le_max_right 2 (1 + cB)])) hSV

/-- **Simon 6.5.1 and 6.5.3 (Deformation Theorem, scaled form), with a finite family.**
Rescale by `δ_{1/ρ}`: `T' = δ_{1/ρ#}T` is integer multiplicity with compact support,
`M(T') = ρ⁻ⁿ M(T)` and `M(∂T') = ρ^{1-n} M(∂T)`.  The skeleton deformation gives
`T' − Q₀ − S₁ = ∂R₁` with `spt Q₀` in the `n`-skeleton.  Face replacement then gives `Pc` with
`T' − Pc − S' = ∂R₁`, where `S' = (Q₀ − Pc) + S₁`.  `Pc` lies in a finite family fixed in advance
by the compact set `cthickening √P (ρ⁻¹K)` and the mass bound `c_s ρ⁻ⁿ Λ`.  Push back by `δ_ρ`:
`Q = δ_{ρ#}Pc`, `R = δ_{ρ#}R₁` and `S = δ_{ρ#}S'`, with `c = c_s (1 + c_f)`.  Supports lie in
`cthickening (2√P ρ) ⊆ thickening (3√P ρ)`; for `P = 0` every current of positive degree vanishes. -/
theorem Submission.cmc_deformation_theorem : ∀ (P m : ℕ), ∃ c : NNReal, 1 ≤ c ∧ ∀ (ρ : ℝ) (K : Set (Euclid P)) (Λ : NNReal), 0 < ρ → IsCompact K → ∃ 𝒬 : Set (GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 𝒬.Finite ∧ ∀ T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity T → T.support ⊆ K → T.mass ≤ Λ → T.boundary.mass < ∞ → ∃ Q ∈ 𝒬, ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q ∧ IsIntegerMultiplicity Q.boundary ∧ IsIntegerMultiplicity R ∧ T - Q - S = R.boundary ∧ (Q = 0 ∨ ENNReal.ofReal (ρ ^ (m + 1)) ≤ Q.mass) ∧ Q.mass ≤ c * T.mass ∧ Q.boundary.mass ≤ c * T.boundary.mass ∧ R.mass ≤ c * ENNReal.ofReal ρ * T.mass ∧ S.mass ≤ c * ENNReal.ofReal ρ * T.boundary.mass ∧ Q.support ∪ R.support ⊆ thickening (3 * Real.sqrt P * ρ) T.support ∧ Q.boundary.support ∪ S.support ⊆ thickening (3 * Real.sqrt P * ρ) T.boundary.support := by
  have hVO := Submission.dtc_vanish_off_support
  have hMR := Submission.cmc_massOn_eq_imRep_measure
  have hREP := Submission.cmc_exists_massRepresentation
  have hIMC := Submission.cmc_imRep_locality_restrict_sub
  have hSL := Submission.cmc_slice_mass_bounds
  have hDil := Submission.cmcdt_dilation_pushforward
  have hSkel := Submission.cmcdt_skeleton_deformation hVO hMR hREP hIMC hSL
  have hFace := Submission.cmcdt_face_replacement hVO hMR hIMC
  intro P m
  obtain ⟨dil, hdil⟩ := hDil P
  obtain ⟨cs, hcs1, hskel⟩ := hSkel P m
  obtain ⟨cf, -, hface⟩ := hFace P m
  -- elementary facts on currents in `ℝᴾ`: pointwise differences, the zero current, and the
  -- support and mass of a difference
  have hsubApp : ∀ (k : ℕ) (A B : GeometricCurrentOn (univ : Set (Euclid P)) k)
      (ω : TestFormOn (univ : Set (Euclid P)) k), (A - B) ω = A ω - B ω := fun _ _ _ _ => rfl
  have hsubSelf : ∀ (k : ℕ) (A : GeometricCurrentOn (univ : Set (Euclid P)) k), A - A = 0 :=
    fun k A => GeometricCurrentOn.ext fun ω => by
      rw [hsubApp, sub_self, GeometricCurrentOn.zero_apply]
  have hsuppSub : ∀ (k : ℕ) (A B C : GeometricCurrentOn (univ : Set (Euclid P)) k),
      (∀ ω, B ω = 0 → C ω = 0 → A ω = 0) → A.support ⊆ B.support ∪ C.support := by
    intro k A B C hABC x hx
    by_contra hxBC
    rw [mem_union, not_or] at hxBC
    have hxB : x ∈ B.zeroRegion := by
      by_contra h
      exact hxBC.1 (mem_sdiff_of_mem (mem_univ x) h)
    have hxC : x ∈ C.zeroRegion := by
      by_contra h
      exact hxBC.2 (mem_sdiff_of_mem (mem_univ x) h)
    obtain ⟨W₁, ⟨hW₁o, hW₁c, -, hW₁v⟩, hxW₁⟩ := mem_sUnion.mp hxB
    obtain ⟨W₂, ⟨hW₂o, -, -, hW₂v⟩, hxW₂⟩ := mem_sUnion.mp hxC
    exact hx.2 (mem_sUnion.mpr ⟨W₁ ∩ W₂, ⟨hW₁o.inter hW₂o,
      hW₁c.of_isClosed_subset isClosed_closure (closure_mono inter_subset_left), subset_univ _,
      fun ω hω => hABC ω (hW₁v ω (hω.trans inter_subset_left))
        (hW₂v ω (hω.trans inter_subset_right))⟩, hxW₁, hxW₂⟩)
  have hsuppZero : ∀ (k : ℕ) (A : GeometricCurrentOn (univ : Set (Euclid P)) k),
      (∀ ω, A ω = 0) → A.support = ∅ := by
    intro k A hA
    exact subset_empty_iff.mp fun x hx => hx.2 (mem_sUnion.mpr ⟨ball x 1, ⟨isOpen_ball,
      (isCompact_closedBall x 1).of_isClosed_subset isClosed_closure
        closure_ball_subset_closedBall, subset_univ _, fun ω _ => hA ω⟩, mem_ball_self one_pos⟩)
  have hmassSub : ∀ (k : ℕ) (A B : GeometricCurrentOn (univ : Set (Euclid P)) k),
      (A - B).mass ≤ A.mass + B.mass := by
    intro k A B
    apply sSup_le
    rintro r ⟨ω, hω, rfl⟩
    dsimp only
    have hω' : -ω ∈ massAdmissibleOn (univ : Set (Euclid P)) k univ :=
      ⟨subset_univ _, fun x => by simpa using hω.2 x⟩
    have hneg : A ω - B ω = A ω + B (-ω) := by
      rw [show B (-ω) = -B ω from map_neg B.toCurrent ω, ← sub_eq_add_neg]
    rw [hsubApp, hneg]
    exact ENNReal.ofReal_add_le.trans (add_le_add (A.le_massOn hω) (B.le_massOn hω'))
  have hmassZero : ∀ k : ℕ, (0 : GeometricCurrentOn (univ : Set (Euclid P)) k).mass = 0 := by
    intro k
    refine le_antisymm (sSup_le ?_) zero_le
    rintro r ⟨ω, -, rfl⟩
    simp
  -- in `ℝ⁰` every current of positive degree vanishes
  have hvan : P = 0 → ∀ (X : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1))
      (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)), X ω = 0 := by
    intro hP X ω
    have hω : ω = 0 := by
      apply Subtype.ext
      funext x
      apply ContinuousAlternatingMap.ext
      intro v
      have hv : v = 0 := by
        subst hP
        exact Subsingleton.elim _ _
      rw [hv, ContinuousAlternatingMap.map_zero, ContinuousAlternatingMap.map_zero]
    rw [hω]
    exact map_zero X.toCurrent
  refine ⟨cs * (1 + cf), ?_, ?_⟩
  · calc (1 : NNReal) = 1 * 1 := (mul_one 1).symm
      _ ≤ cs * (1 + cf) := mul_le_mul' hcs1 le_self_add
  intro ρ K Λ hρ hK
  have hρi : 0 < ρ⁻¹ := inv_pos.mpr hρ
  obtain ⟨-, hinvT, hmassT, hsuppT, himT, -⟩ := hdil (m + 1) ρ⁻¹ hρi
  obtain ⟨-, -, hmassT1, hsuppT1, -, hbdT⟩ := hdil m ρ⁻¹ hρi
  obtain ⟨hlin1, -, hmass1, hsupp1, him1, hbd2⟩ := hdil (m + 1) ρ hρ
  obtain ⟨-, -, hmass0, hsupp0, him0, hbd1⟩ := hdil m ρ hρ
  obtain ⟨-, -, hmass2, hsupp2, him2, -⟩ := hdil (m + 2) ρ hρ
  have hdil0 : dil (m + 1) ρ 0 = 0 := by
    have h := hlin1 0 0
    rw [hsubSelf (m + 1) 0, hsubSelf (m + 1) (dil (m + 1) ρ 0)] at h
    exact h
  -- the scaling factors `ρᵏ ρ⁻ʲ`
  have hsc1 : ENNReal.ofReal (ρ ^ (m + 2)) * ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) =
      ENNReal.ofReal ρ := by
    rw [← ENNReal.ofReal_mul (pow_pos hρ _).le]
    congr 1
    rw [inv_pow, ← div_eq_mul_inv, div_eq_iff (pow_ne_zero _ hρ.ne')]
    ring
  have hsc2 : ENNReal.ofReal (ρ ^ (m + 1)) * ENNReal.ofReal (ρ⁻¹ ^ m) = ENNReal.ofReal ρ := by
    rw [← ENNReal.ofReal_mul (pow_pos hρ _).le]
    congr 1
    rw [inv_pow, ← div_eq_mul_inv, div_eq_iff (pow_ne_zero _ hρ.ne')]
    ring
  have hsc3 : ENNReal.ofReal (ρ ^ (m + 1)) * ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) = 1 := by
    rw [← ENNReal.ofReal_mul (pow_pos hρ _).le, ← mul_pow, mul_inv_cancel₀ hρ.ne', one_pow,
      ENNReal.ofReal_one]
  have hsc4 : ENNReal.ofReal (ρ ^ m) * ENNReal.ofReal (ρ⁻¹ ^ m) = 1 := by
    rw [← ENNReal.ofReal_mul (pow_pos hρ _).le, ← mul_pow, mul_inv_cancel₀ hρ.ne', one_pow,
      ENNReal.ofReal_one]
  have hcs : (cs : ℝ≥0∞) ≤ ((cs * (1 + cf) : NNReal) : ℝ≥0∞) :=
    ENNReal.coe_le_coe.mpr (le_mul_of_one_le_right zero_le le_self_add)
  have hcfcs : (cf : ℝ≥0∞) * cs ≤ ((cs * (1 + cf) : NNReal) : ℝ≥0∞) := by
    rw [← ENNReal.coe_mul]
    exact ENNReal.coe_le_coe.mpr (by rw [mul_comm]; exact mul_le_mul_right le_add_self cs)
  have hsqrt := Real.sqrt_nonneg (P : ℝ)
  -- `ρ · cthickening (2√P) (ρ⁻¹ A) ⊆ thickening (3√P ρ) A` (both sides empty if `P = 0`)
  have hfin : ∀ A B : Set (Euclid P), (P = 0 → A = ∅) →
      B ⊆ cthickening (Real.sqrt P + Real.sqrt P) ((fun x => ρ⁻¹ • x) '' A) →
      (fun x => ρ • x) '' B ⊆ thickening (3 * Real.sqrt P * ρ) A := by
    intro A B hA hB
    rcases Nat.eq_zero_or_pos P with hP | hP
    · rw [hA hP, image_empty, cthickening_empty, subset_empty_iff] at hB
      rw [hB, image_empty]
      exact empty_subset _
    · have hsP : 0 < Real.sqrt P := Real.sqrt_pos.mpr (Nat.cast_pos.mpr hP)
      rintro _ ⟨x, hx, rfl⟩
      obtain ⟨_, ⟨a, ha, rfl⟩, hxa⟩ := mem_thickening_iff.mp
        (cthickening_subset_thickening' (δ₂ := 3 * Real.sqrt P) (by linarith) (by linarith) _
          (hB hx))
      refine mem_thickening_iff.mpr ⟨a, ha, ?_⟩
      calc dist (ρ • x) a = dist (ρ • x) (ρ • (ρ⁻¹ • a)) := by rw [smul_inv_smul₀ hρ.ne']
        _ = ρ * dist x (ρ⁻¹ • a) := by rw [dist_smul₀, Real.norm_of_nonneg hρ.le]
        _ < ρ * (3 * Real.sqrt P) := mul_lt_mul_of_pos_left hxa hρ
        _ = 3 * Real.sqrt P * ρ := by ring
  -- the finite family: dilations by `ρ` of the face-replacement family for the compact set
  -- `cthickening √P (ρ⁻¹ K)` and the mass bound `c_s ρ^{-n} Λ`
  obtain ⟨𝒬₀, h𝒬₀fin, h𝒬₀⟩ := hface (cthickening (Real.sqrt P) ((fun x => ρ⁻¹ • x) '' K))
    (cs * ((ρ⁻¹ ^ (m + 1)).toNNReal * Λ)) (hK.image (continuous_const_smul ρ⁻¹)).cthickening
  refine ⟨dil (m + 1) ρ '' 𝒬₀, h𝒬₀fin.image _, ?_⟩
  intro T hTim hTK hTΛ hTb
  have hTsupp0 : P = 0 → T.support = ∅ := fun hP => hsuppZero _ T (hvan hP T)
  have hTbsupp0 : P = 0 → T.boundary.support = ∅ := fun hP =>
    hsuppZero _ T.boundary fun ω => by rw [GeometricCurrentOn.boundary_apply]; exact hvan hP T _
  have hTcl : IsClosed T.support := by
    have h : T.support = T.zeroRegionᶜ := by
      ext x
      simp [GeometricCurrentOn.support]
    rw [h]
    exact T.isOpen_zeroRegion.isClosed_compl
  -- `T' = δ_{1/ρ#} T`
  have hT'im : IsIntegerMultiplicity (dil (m + 1) ρ⁻¹ T) := himT T hTim
  have hT'supp : (dil (m + 1) ρ⁻¹ T).support = (fun x => ρ⁻¹ • x) '' T.support := hsuppT T
  have hT'mass : (dil (m + 1) ρ⁻¹ T).mass = ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) * T.mass := hmassT T
  have hT'b : (dil (m + 1) ρ⁻¹ T).boundary = dil m ρ⁻¹ T.boundary := hbdT T
  have hTT' : dil (m + 1) ρ (dil (m + 1) ρ⁻¹ T) = T := by
    have h := hinvT T
    rwa [inv_inv] at h
  generalize dil (m + 1) ρ⁻¹ T = T' at hT'im hT'supp hT'mass hT'b hTT'
  have hT'bmass : T'.boundary.mass = ENNReal.ofReal (ρ⁻¹ ^ m) * T.boundary.mass := by
    rw [hT'b]
    exact hmassT1 _
  have hT'bsupp : T'.boundary.support = (fun x => ρ⁻¹ • x) '' T.boundary.support := by
    rw [hT'b]
    exact hsuppT1 _
  have hT'c : IsCompact T'.support := by
    rw [hT'supp]
    exact (hK.of_isClosed_subset hTcl hTK).image (continuous_const_smul ρ⁻¹)
  have hT'fin : T'.mass < ∞ := by
    rw [hT'mass]
    exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top (hTΛ.trans_lt ENNReal.coe_lt_top)
  have hT'bfin : T'.boundary.mass < ∞ := by
    rw [hT'bmass]
    exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top hTb
  -- deformation onto the `n`-skeleton at unit scale
  obtain ⟨Q₀, R₁, S₁, hQ₀im, hR₁im, heq₁, hQ₀L, hQ₀m, hQ₀bm, hR₁m, hS₁m, hsp₁, hsp₂⟩ :=
    hskel T' hT'im hT'c hT'fin hT'bfin
  -- replacement of `Q₀` by an integer polyhedral chain from the finite family
  have hQ₀K : Q₀.support ⊆ cthickening (Real.sqrt P) ((fun x => ρ⁻¹ • x) '' K) := by
    refine (subset_union_left.trans hsp₁).trans ?_
    rw [hT'supp]
    exact cthickening_subset_of_subset _ (image_mono hTK)
  have hQ₀Λ : Q₀.mass ≤ ((cs * ((ρ⁻¹ ^ (m + 1)).toNNReal * Λ) : NNReal) : ℝ≥0∞) := by
    calc Q₀.mass ≤ cs * T'.mass := hQ₀m
      _ = cs * (ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) * T.mass) := by rw [hT'mass]
      _ ≤ cs * (ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) * Λ) := by gcongr
      _ = ((cs * ((ρ⁻¹ ^ (m + 1)).toNNReal * Λ) : NNReal) : ℝ≥0∞) := by
          rw [ENNReal.coe_mul, ENNReal.coe_mul]
          rfl
  have hQ₀bfin : Q₀.boundary.mass < ∞ :=
    hQ₀bm.trans_lt (ENNReal.mul_lt_top ENNReal.coe_lt_top hT'bfin)
  obtain ⟨Pc, hPc, hPcim, hPcbim, hPc01, hPcm, hPcbm, hQPm, hPcsp, hQPsp⟩ :=
    h𝒬₀ Q₀ hQ₀im hQ₀K hQ₀L hQ₀Λ hQ₀bfin
  have hRb : (dil (m + 2) ρ R₁).boundary = dil (m + 1) ρ R₁.boundary := hbd2 R₁
  have hQb : (dil (m + 1) ρ Pc).boundary = dil m ρ Pc.boundary := hbd1 Pc
  -- `Q = δ_{ρ#} Pc`, `R = δ_{ρ#} R₁`, `S = δ_{ρ#}((Q₀ − Pc) + S₁)`
  refine ⟨dil (m + 1) ρ Pc, mem_image_of_mem _ hPc, dil (m + 2) ρ R₁,
    dil (m + 1) ρ ((Q₀ - Pc) - (0 - S₁)), him1 Pc hPcim, ?_, him2 R₁ hR₁im, ?_, ?_, ?_, ?_, ?_,
    ?_, ?_, ?_⟩
  · rw [hQb]
    exact him0 _ hPcbim
  · -- `T − Q − S = ∂R`
    rw [hRb, ← heq₁]
    simp only [hlin1, hdil0, hTT']
    ext ω
    simp only [hsubApp, GeometricCurrentOn.zero_apply]
    ring
  · -- `Q = 0` or `M(Q) ≥ ρⁿ`
    rcases hPc01 with h0 | h1
    · left
      rw [h0, hdil0]
    · right
      rw [hmass1 Pc]
      calc ENNReal.ofReal (ρ ^ (m + 1)) = ENNReal.ofReal (ρ ^ (m + 1)) * 1 := (mul_one _).symm
        _ ≤ ENNReal.ofReal (ρ ^ (m + 1)) * Pc.mass := by gcongr
  · -- `M(Q) ≤ c M(T)`
    calc (dil (m + 1) ρ Pc).mass = ENNReal.ofReal (ρ ^ (m + 1)) * Pc.mass := hmass1 Pc
      _ ≤ ENNReal.ofReal (ρ ^ (m + 1)) *
          (cf * (cs * (ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) * T.mass))) := by
          gcongr
          calc Pc.mass ≤ cf * Q₀.mass := hPcm
            _ ≤ cf * (cs * T'.mass) := by gcongr
            _ = cf * (cs * (ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) * T.mass)) := by rw [hT'mass]
      _ = cf * cs * (ENNReal.ofReal (ρ ^ (m + 1)) * ENNReal.ofReal (ρ⁻¹ ^ (m + 1))) * T.mass := by
          ring
      _ = cf * cs * T.mass := by rw [hsc3, mul_one]
      _ ≤ ((cs * (1 + cf) : NNReal) : ℝ≥0∞) * T.mass := by gcongr
  · -- `M(∂Q) ≤ c M(∂T)`
    rw [hQb]
    calc (dil m ρ Pc.boundary).mass = ENNReal.ofReal (ρ ^ m) * Pc.boundary.mass := hmass0 _
      _ ≤ ENNReal.ofReal (ρ ^ m) *
          (cf * (cs * (ENNReal.ofReal (ρ⁻¹ ^ m) * T.boundary.mass))) := by
          gcongr
          calc Pc.boundary.mass ≤ cf * Q₀.boundary.mass := hPcbm
            _ ≤ cf * (cs * T'.boundary.mass) := by gcongr
            _ = cf * (cs * (ENNReal.ofReal (ρ⁻¹ ^ m) * T.boundary.mass)) := by rw [hT'bmass]
      _ = cf * cs * (ENNReal.ofReal (ρ ^ m) * ENNReal.ofReal (ρ⁻¹ ^ m)) * T.boundary.mass := by
          ring
      _ = cf * cs * T.boundary.mass := by rw [hsc4, mul_one]
      _ ≤ ((cs * (1 + cf) : NNReal) : ℝ≥0∞) * T.boundary.mass := by gcongr
  · -- `M(R) ≤ c ρ M(T)`
    calc (dil (m + 2) ρ R₁).mass = ENNReal.ofReal (ρ ^ (m + 2)) * R₁.mass := hmass2 R₁
      _ ≤ ENNReal.ofReal (ρ ^ (m + 2)) * (cs * (ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) * T.mass)) := by
          gcongr
          calc R₁.mass ≤ cs * T'.mass := hR₁m
            _ = cs * (ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) * T.mass) := by rw [hT'mass]
      _ = cs * (ENNReal.ofReal (ρ ^ (m + 2)) * ENNReal.ofReal (ρ⁻¹ ^ (m + 1))) * T.mass := by
          ring
      _ = cs * ENNReal.ofReal ρ * T.mass := by rw [hsc1]
      _ ≤ ((cs * (1 + cf) : NNReal) : ℝ≥0∞) * ENNReal.ofReal ρ * T.mass := by gcongr
  · -- `M(S) ≤ c ρ M(∂T)`
    have hS' : ((Q₀ - Pc) - (0 - S₁)).mass ≤
        cs * (1 + cf) * (ENNReal.ofReal (ρ⁻¹ ^ m) * T.boundary.mass) := by
      calc ((Q₀ - Pc) - (0 - S₁)).mass ≤ (Q₀ - Pc).mass + (0 - S₁).mass := hmassSub _ _ _
        _ ≤ (Q₀ - Pc).mass +
            ((0 : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)).mass + S₁.mass) := by
            gcongr
            exact hmassSub _ _ _
        _ = (Q₀ - Pc).mass + S₁.mass := by rw [hmassZero, zero_add]
        _ ≤ cf * Q₀.boundary.mass + cs * T'.boundary.mass := add_le_add hQPm hS₁m
        _ ≤ cf * (cs * T'.boundary.mass) + cs * T'.boundary.mass := by gcongr
        _ = cs * (1 + cf) * T'.boundary.mass := by ring
        _ = cs * (1 + cf) * (ENNReal.ofReal (ρ⁻¹ ^ m) * T.boundary.mass) := by rw [hT'bmass]
    calc (dil (m + 1) ρ ((Q₀ - Pc) - (0 - S₁))).mass
        = ENNReal.ofReal (ρ ^ (m + 1)) * ((Q₀ - Pc) - (0 - S₁)).mass := hmass1 _
      _ ≤ ENNReal.ofReal (ρ ^ (m + 1)) *
          (cs * (1 + cf) * (ENNReal.ofReal (ρ⁻¹ ^ m) * T.boundary.mass)) := by gcongr
      _ = cs * (1 + cf) * (ENNReal.ofReal (ρ ^ (m + 1)) * ENNReal.ofReal (ρ⁻¹ ^ m)) *
          T.boundary.mass := by ring
      _ = ((cs * (1 + cf) : NNReal) : ℝ≥0∞) * ENNReal.ofReal ρ * T.boundary.mass := by
          rw [hsc2]
          push_cast
          ring
  · -- supports of `Q` and `R`
    rw [hsupp1 Pc, hsupp2 R₁, ← image_union]
    refine hfin T.support _ hTsupp0 (union_subset ?_ ?_)
    · refine hPcsp.trans ((cthickening_subset_of_subset _ (subset_union_left.trans hsp₁)).trans ?_)
      rw [hT'supp]
      exact cthickening_cthickening_subset hsqrt hsqrt _
    · refine (subset_union_right.trans hsp₁).trans ?_
      rw [hT'supp]
      exact cthickening_mono (le_add_of_nonneg_right hsqrt) _
  · -- supports of `∂Q` and `S`
    rw [hQb, hsupp0, hsupp1, ← image_union]
    refine hfin T.boundary.support _ hTbsupp0 (union_subset ?_ ?_)
    · refine (subset_union_right.trans hQPsp).trans
        ((cthickening_subset_of_subset _ (subset_union_left.trans hsp₂)).trans ?_)
      rw [hT'bsupp]
      exact cthickening_cthickening_subset hsqrt hsqrt _
    · refine (hsuppSub _ _ (Q₀ - Pc) (0 - S₁) fun ω h₁ h₂ => ?_).trans (union_subset ?_ ?_)
      · rw [hsubApp, h₁, h₂, sub_zero]
      · refine (subset_union_left.trans hQPsp).trans
          ((cthickening_subset_of_subset _ (subset_union_left.trans hsp₂)).trans ?_)
        rw [hT'bsupp]
        exact cthickening_cthickening_subset hsqrt hsqrt _
      · refine (hsuppSub _ _ S₁ S₁ fun ω h₁ _ => ?_).trans ?_
        · rw [hsubApp, h₁, GeometricCurrentOn.zero_apply, sub_zero]
        · rw [union_self]
          refine (subset_union_right.trans hsp₂).trans ?_
          rw [hT'bsupp]
          exact cthickening_mono (le_add_of_nonneg_right hsqrt) _

/-- **Closure step `CL(d) ∧ BR(d) → CL(d + 1)`** (Simon Ch. 6, 8.3 and Remark 8.3(1), as used for
7.2.4).  Let `Tⱼ ∈ 𝒟_{d+1}(U)` be integer multiplicity with `supⱼ (M_W(Tⱼ) + M_W(∂Tⱼ)) < ∞` for
open `W ⊂⊂ U` and `Tⱼ ⇀ T`; by lower semicontinuity `T` has locally finite mass.  Fix `x₀ ∈ U`.
Localization (`cbrcs_localize_at_point`) gives `r > 0` and integer multiplicity
`Sⱼ = T_{j'}⌞B_r(x₀)`, carried by and vanishing off `K = B̄_r(x₀)`, with bounded masses and
boundary masses and `Sⱼ ⇀ A`, where `A = T` on forms supported in `B_r(x₀)`.  The cutoff
extension `E` to `ℝᴾ` (`cbrcs_cutoff_extension`) keeps integer multiplicity, support in `K`, the
mass bounds and the convergence `E Sⱼ ⇀ E A`, and `∂(E Sⱼ)` is integer multiplicity by `BR(d)`.
The compact case (`cbr_closure_compact_support`, from `CL(d)` and `BR(d)`) makes `E A` integer
multiplicity, hence also `(E A)|_{B_r(x₀)} = T|_{B_r(x₀)}`; integer multiplicity being local
(`cbr_isIntegerMultiplicity_of_local`), `T` is integer multiplicity. -/
theorem Submission.cbr_closure_succ : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → (∀ (P m : ℕ), ∃ c : NNReal, 1 ≤ c ∧ ∀ (ρ : ℝ) (K : Set (Euclid P)) (Λ : NNReal), 0 < ρ → IsCompact K → ∃ 𝒬 : Set (GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 𝒬.Finite ∧ ∀ T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity T → T.support ⊆ K → T.mass ≤ Λ → T.boundary.mass < ∞ → ∃ Q ∈ 𝒬, ∃ (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q ∧ IsIntegerMultiplicity Q.boundary ∧ IsIntegerMultiplicity R ∧ T - Q - S = R.boundary ∧ (Q = 0 ∨ ENNReal.ofReal (ρ ^ (m + 1)) ≤ Q.mass) ∧ Q.mass ≤ c * T.mass ∧ Q.boundary.mass ≤ c * T.boundary.mass ∧ R.mass ≤ c * ENNReal.ofReal ρ * T.mass ∧ S.mass ≤ c * ENNReal.ofReal ρ * T.boundary.mass ∧ Q.support ∪ R.support ⊆ thickening (3 * Real.sqrt P * ρ) T.support ∧ Q.boundary.support ∪ S.support ⊆ thickening (3 * Real.sqrt P * ρ) T.boundary.support) → (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → ∀ d : ℕ, (∀ (P : ℕ) (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U d) (T : GeometricCurrentOn U d), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T) → (∀ (P : ℕ) (U : Set (Euclid P)) (R : GeometricCurrentOn U (d + 1)), IsOpen U → IsIntegerMultiplicity R → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → R.boundary.massOn W < ∞) → IsIntegerMultiplicity R.boundary) → ∀ (P : ℕ) (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U (d + 1)) (T : GeometricCurrentOn U (d + 1)), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T := by
  intro hREP hMR hIMC hSL hDT hVO d hCL hBR P U Ts T hU hIM hbd hconv
  -- Step 1: `M_W(T) ≤ liminfⱼ M_W(Tⱼ) < ∞` for open `W ⊂⊂ U` (lower semicontinuity of mass)
  have hlocT : ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞ := by
    intro W hW hWU
    have h1 := hconv.massOn_le_liminf W
    have h2 : liminf (fun j => (Ts j).massOn W) atTop ≤
        ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) :=
      (liminf_le_limsup).trans (limsup_le_iSup.trans (iSup_mono fun j => le_self_add))
    exact lt_of_le_of_lt (h1.trans h2) (hbd W hW hWU)
  -- Step 2: integer multiplicity is local (im_local (1)), so it suffices to treat one `x₀ ∈ U`
  refine (Submission.cbr_isIntegerMultiplicity_of_local hREP hMR hIMC P (d + 1) U T hU).1 hlocT
    fun x₀ hx₀ => ?_
  -- Step 3: localization at `x₀`: `Sⱼ = T_{j'}⌞B_r(x₀) ⇀ A` with `A = T` on `B_r(x₀)`
  obtain ⟨r, Ss, Rs, A, hr, hrU, hRs, hSs0, hSsbd, hSsA, hAT⟩ :=
    Submission.cbrcs_localize_at_point hREP hMR hIMC hSL Submission.cbr_measure_convergence_tools
      d P U Ts T x₀ hU hIM hbd hconv hx₀
  -- Step 4: extension `E` to `ℝᴾ` by a cutoff equal to `1` near `K = B̄_r(x₀)`
  obtain ⟨E, hEagree, hEconv, hEmass, hEspt, hEim⟩ :=
    Submission.cbrcs_cutoff_extension P d U (closedBall x₀ r) hU (isCompact_closedBall x₀ r) hrU
  -- Step 5: `E Sⱼ` is integer multiplicity, supported in `K`, with bounded total masses
  have hEIM : ∀ j, IsIntegerMultiplicity (E (Ss j)) :=
    fun j => hEim (Ss j) (Rs j) (hRs j).1 (hRs j).2
  have hEbd : ∀ j, (E (Ss j)).support ⊆ closedBall x₀ r ∧
      (E (Ss j)).boundary.mass ≤ (Ss j).boundary.mass :=
    fun j => hEspt (Ss j) (hSs0 j)
  have hEsup : ⨆ j, ((E (Ss j)).mass + (E (Ss j)).boundary.mass) < ∞ :=
    lt_of_le_of_lt (iSup_mono fun j => add_le_add (hEmass (Ss j)) (hEbd j).2) hSsbd
  -- and `∂(E Sⱼ)` is integer multiplicity by `BR(d)` in `ℝᴾ`
  have hEbIM : ∀ j, IsIntegerMultiplicity (E (Ss j)).boundary := by
    intro j
    refine hBR P univ (E (Ss j)) isOpen_univ (hEIM j) fun W _ _ => lt_of_le_of_lt ?_ hEsup
    calc (E (Ss j)).boundary.massOn W ≤ (E (Ss j)).boundary.mass :=
          (E (Ss j)).boundary.massOn_mono (subset_univ W)
      _ ≤ (E (Ss j)).mass + (E (Ss j)).boundary.mass := le_add_self
      _ ≤ ⨆ i, ((E (Ss i)).mass + (E (Ss i)).boundary.mass) :=
          le_iSup (fun i => (E (Ss i)).mass + (E (Ss i)).boundary.mass) j
  -- Step 6: the compact case makes the limit `E A` of `E Sⱼ` integer multiplicity
  have hEA : IsIntegerMultiplicity (E A) :=
    Submission.cbr_closure_compact_support hREP hMR hIMC hSL hDT hVO d hCL hBR P (fun j => E (Ss j))
      (E A) (closedBall x₀ r) (isCompact_closedBall x₀ r) hEIM hEbIM (fun j => (hEbd j).1) hEsup
      (hEconv Ss A hSsA)
  -- Step 7: `(E A)|_{B_r(x₀)}` is integer multiplicity (im_local (2)) and equals `T|_{B_r(x₀)}`
  have hB : ball x₀ r ⊆ U := ball_subset_closedBall.trans hrU
  obtain ⟨R, hR⟩ := (Submission.cbr_isIntegerMultiplicity_of_local hREP hMR hIMC P (d + 1) univ
    (E A) isOpen_univ).2 (ball x₀ r) (subset_univ _) isOpen_ball hEA
  refine ⟨r, hr, hB, R, fun ω => ?_⟩
  have hω : tsupport ((testFormOnInclusion hB (d + 1) ω : TestFormOn U (d + 1)) :
      DifferentialForm (Euclid P) (d + 1)) ⊆ ball x₀ r := ω.property.2
  calc T.restrictDomain hB ω = T (testFormOnInclusion hB (d + 1) ω) := rfl
    _ = A (testFormOnInclusion hB (d + 1) ω) := (hAT _ hω).symm
    _ = E A (testFormOnInclusion (subset_univ U) (d + 1) (testFormOnInclusion hB (d + 1) ω)) :=
        (hEagree A _ (hω.trans ball_subset_closedBall)).symm
    _ = (E A).restrictDomain (subset_univ (ball x₀ r)) ω := rfl
    _ = R.action (ω : DifferentialForm (Euclid P) (d + 1)) := hR ω

/-- **Simon Ch. 6, 8.2 with 8.3(1),(2), and 6.3** (closure theorem and boundary rectifiability).
(CL) If integer multiplicity `T_j ∈ 𝒟_d(U)` have `sup_j (M_W(T_j) + M_W(∂T_j)) < ∞` for every
`W ⊂⊂ U` (`M_W(∂T_j)` read as `0` when `d = 0`) and `T_j ⇀ T`, then `T` is integer multiplicity.
(BR) If `R ∈ 𝒟_{d+1}(U)` is integer multiplicity and `M_W(∂R) < ∞` for every `W ⊂⊂ U`, then `∂R`
is integer multiplicity.
/-- **Simon Ch. 4, 2.7 and 3.14** (with Ch. 2, 5.9): if `V = v(M, θ)` is stationary in `N ∩ U`,
where `N` is an embedded `C²` submanifold with `(N̄ \ N) ∩ U = ∅` and `Hⁿ(M \ N) = 0`, then `V`
has generalized mean curvature `H` in `U`, bounded on compact subsets of `U`.  Extend
`z ↦ P_{T_zN}` to a `C¹` field `pr` on an open `O ⊇ N` and take `H` with
`H(x) = Σⱼ (Dpr(x)[p eⱼ])*(p eⱼ)` on `N ∩ U`, `p = p_{TₓM}`.  For `X ∈ C¹_c(U)`, the tangential
part `X^T` (equal to `pr·X` near `N`) is tangent to `N` on `N ∩ U`, so `δV(X^T) = 0` and
`δV(X) = δV(X − X^T)`.  At `Hⁿ`-a.e. `x ∈ M`, `x ∈ N` and `TₓM ⊆ TₓN`, so
`div_M(X − X^T)(x) = −X(x)·H(x)`; integrating against `θ` gives `δV(X) = −∫ X·H dμ_V`. -/
theorem Submission.meanCurvature_bounded_of_stationaryAlong : ∀ (P n d : ℕ) (U N : Set (Euclid P)) (R : IMRep U n), IsOpen U → IsEmbeddedSubmanifold 2 d N → (closure N \ N) ∩ U = ∅ → μHE[n] (R.carrier \ N) = 0 → R.IsStationaryAlong N → R.HasLocallyBoundedMeanCurvature := by
  intro P n d U N R hU hN hNU hMN hstat
  -- the `C¹` extension `pr` of `z ↦ P_{T_zN}` to an open set `O ⊇ N`
  obtain ⟨O, pr, hO, hNO, hpr, hprN⟩ :=
    Submission.submanifold_tangentProjection_c1_extension P d N hN
  -- `p(x) = p_{TₓM}` is `Hⁿ⌞M`-a.e. strongly measurable, and `‖p(x)‖ ≤ 1`
  have hp : AEStronglyMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection)
      (μHE[n].restrict R.carrier) := Submission.imrep_approxTangent_starProjection_aesm P n U R
  -- `H` with `H(x) = Σⱼ (Dpr(x)[p eⱼ])*(p eⱼ)` on `N ∩ U`, measurable and bounded on compact
  -- subsets of `U`
  obtain ⟨H, hHm, hHb, hH⟩ := Submission.mcs_exists_meanCurvature_field P
    (μHE[n].restrict R.carrier) U N O pr _ hU hO hNO hpr hNU hp
    fun x => Submodule.starProjection_norm_le _
  -- `T_zN` is a linear subspace for `z ∈ N`, the range of `Dψ` in a chart
  have hTN : ∀ z ∈ N, ∃ T : Submodule ℝ (Euclid P), tangentSpace N z = T := by
    intro z hz
    obtain ⟨V, W, ψ, hV, hW, hzW, hψ, hinj, hψV, hproper, hDψ⟩ := hN z hz
    obtain ⟨v, hv, rfl⟩ : z ∈ ψ '' V := hψV ▸ ⟨hzW, hz⟩
    exact ⟨LinearMap.range (fderiv ℝ ψ v : Euclid d →ₗ[ℝ] Euclid P),
      Submission.chart_tangentSpace_eq_range_fderiv P d 2 N W V ψ v one_le_two hV hW hψ hinj hψV
        hproper hDψ hv⟩
  -- `C²` charts are `C¹` charts
  have hN1 : IsEmbeddedSubmanifold 1 d N := fun y hy => by
    obtain ⟨V, W, ψ, hV, hW, hyW, hψ, h⟩ := hN y hy
    exact ⟨V, W, ψ, hV, hW, hyW, hψ.of_le (by norm_num), h⟩
  -- `Hⁿ⌞M`-a.e. point lies in `N`, as `Hⁿ(M \ N) = 0`
  have hMN' : ∀ᵐ x ∂(μHE[n].restrict R.carrier), x ∈ N := by
    rw [ae_restrict_iff' R.measurableSet_carrier]
    filter_upwards [measure_eq_zero_iff_ae_notMem.1 hMN] with x hx hxM
    by_contra hxN
    exact hx ⟨hxM, hxN⟩
  refine ⟨H, hHm.mono_ac (withDensity_absolutelyContinuous _ _),
    fun K hK hKU => (hHb K hK hKU).imp fun Λ hΛ => ae_of_all _ hΛ, fun X hX hXc hXU => ?_⟩
  -- the tangential part `X^T ∈ C¹_c(U)`, equal to `pr·X` near every point of `N`
  obtain ⟨XT, hXT, hXTc, hXTU, hXTN⟩ :=
    Submission.mcs_exists_c1_field_eq_proj_near P U N O pr X hU hO hNO hpr hNU hX hXc hXU
  -- `X^T(z) = P_{T_zN} X(z) ∈ T_zN` on `N ∩ U`, so `δV(X^T) = 0` by stationarity
  have hXT0 : R.firstVariation XT = 0 := by
    refine hstat XT hXT hXTc hXTU fun z hz => ?_
    obtain ⟨T, hT⟩ := hTN z hz.1
    have hmem : XT z ∈ Submodule.span ℝ (tangentSpace N z) := by
      rw [(hXTN z hz.1).eq_of_nhds, hprN z hz.1]
      exact Submodule.starProjection_apply_mem _ _
    rw [hT, Submodule.span_eq] at hmem
    rwa [hT]
  -- `δV(X) = δV(X^T) + δV(X − X^T) = δV(X − X^T)`
  have hsplit : R.firstVariation X = R.firstVariation (X - XT) := by
    have h := Submission.mcs_firstVariation_add P n U R XT (X - XT) hp hXT hXTc hXTU (hX.sub hXT)
      (hXc.sub hXTc) ((tsupport_sub X XT).trans (union_subset hXU hXTU))
    rwa [add_sub_cancel, hXT0, zero_add] at h
  -- at `Hⁿ⌞M`-a.e. `x`: `x ∈ M ∩ N` and `TₓM ⊆ TₓN`, so `div_M(X − X^T)(x) = −X(x)·H(x)`
  have hdiv : ∀ᵐ x ∂(μHE[n].restrict R.carrier),
      tangentialDivergence n R.carrier (X - XT) x = -inner ℝ (X x) (H x) := by
    filter_upwards [ae_restrict_mem R.measurableSet_carrier, hMN', R.orients]
      with x hxM hxN ⟨Q, hQ, _⟩
    have hex : ∃ Q, HasApproximateTangentSpaceAt n R.carrier x Q := ⟨Q, hQ⟩
    have hTx : HasApproximateTangentSpaceAt n R.carrier x (approxTangentPlane n R.carrier x) := by
      rw [approxTangentPlane, dite_eq_left hex]
      exact hex.choose_spec
    have hQS : approxTangentPlane n R.carrier x ≤ Submodule.span ℝ (tangentSpace N x) :=
      fun u hu => Submodule.subset_span (Submission.approxTangent_le_submanifold_tangentSpace P n d
        N R.carrier x _ hN1 hxN hMN hTx hu)
    have hY : (X - XT) =ᶠ[𝓝 x] fun y => X y - pr y (X y) :=
      (hXTN x hxN).mono fun y hy => by rw [Pi.sub_apply, hy]
    have hprx : DifferentiableAt ℝ pr x :=
      (hpr.differentiableOn one_ne_zero).differentiableAt (hO.mem_nhds (hNO hxN))
    rw [tangentialDivergence, Submission.mcs_trace_normal_part_eq_neg_inner P _ _ pr X (X - XT) x
      hQS (hprN x hxN) hprx (hX.differentiable one_ne_zero x) hY, hH x ⟨hxN, R.carrier_subset hxM⟩]
  -- integrate against `θ`: `∫_M θ div_M(X − X^T) dHⁿ = −∫ X·H dμ_V`
  have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) :=
    (measurable_from_nat (f := fun k : ℕ => (k : ℝ≥0∞))).comp R.measurable_mult
  rw [hsplit, IMRep.firstVariation, IMRep.measure, integral_withDensity_eq_integral_toReal_smul hθ
    (ae_of_all _ fun x => ENNReal.natCast_lt_top _), ← integral_neg]
  refine integral_congr_ae ?_
  filter_upwards [hdiv] with x hx
  rw [hx, ENNReal.toReal_natCast, smul_eq_mul, mul_neg]

/-- **Simon 7.1.2** (chapter-07.txt lines 29–60, with README erratum 1).  For a representation
`R = (M, θ, ξ)` of `T`, `Hⁿ(M ∖ spt T) = 0`, hence `Hⁿ(M ∖ N) = 0` because `spt T ⊆ N`.
Comparing `T` with the competitors `φ_{t#}T` of 1.2 (2), (3), where `φ_t` preserves `N ∩ U` and
is the identity off `spt X` (Ch. 4, 2.1 with `U ∩ N` in place of `U`), shows that `v(M, θ)` is
stationary in `N ∩ U`; stationarity in `N ∩ U` then gives a generalized mean curvature in `U`
that is bounded on compact sets (Ch. 4, 2.7 and 3.14).  The hypothesis `ℓ ≤ k` is not used. -/
theorem Submission.minimizing_implies_stationary : MinimizingImpliesStationary := by
  intro n k ℓ _hℓk U N T hU hN hNcl hTN hmin hbdry R hR
  -- `μ_T(U ∖ spt T) = 0` and `spt T ⊆ N`.
  have hnull : μHE[n] (R.carrier \ N) = 0 :=
    measure_mono_null (Set.sdiff_subset_sdiff_right hTN)
      (Submission.imrep_carrier_sdiff_support_null (n + k) n U T R hU hR)
  have hstat : R.IsStationaryAlong N :=
    Submission.stationaryAlong_of_minimizing_in_submanifold (n + k) n (n + ℓ) U N T R hU hN hNcl
      hmin hbdry hR hnull
  exact ⟨hstat, Submission.meanCurvature_bounded_of_stationaryAlong (n + k) n (n + ℓ) U N R hU hN
    hNcl hnull hstat⟩

/-- **Monotonicity, densities and `Θ ≥ 1` for minimizing cycles in `N`** (Simon Ch. 4,
3.1–3.17, through 7.1.2).  Take `T = τ(M, θ, ξ)` and `μ_R = θHⁿ⌞M`.  By 7.1.2 (with `P = n + k`
and `d = n + ℓ`) the varifold `v(M, θ)` is stationary in `N ∩ U` and has mean curvature bounded
on compact subsets of `U`, and `M_W(T) = μ_R(W)` for open `W ⊆ U`.  (i) On a compact `K ⊆ U`
the mean curvature may be taken bounded by `Λ` everywhere, and `e^{Λρ}ρ⁻ⁿμ_R(B_ρ(y))` is
nondecreasing for `B̄_R(y) ⊆ K` (3.17).  (ii) If `N = ℝᴾ`, every vector is tangent to `N`, so
`δV = 0` in `U`, and the same argument with `H = 0`, `Λ = 0` on `B̄_{(ρ+R)/2}(y) ⊆ B_R(y)`
applies.  (iii) The masses of small balls are finite, so monotone limits give `Θ`, upper
semicontinuous on `U` (3.8–3.11).  (iv) `Θ ≥ 1` `μ_R`-a.e. and upper semicontinuity give
`Θ ≥ 1` on `spt T` (3.13). -/
theorem Submission.dimred_minimizing_monotonicity : ∀ (P n d : ℕ) (U N : Set (Euclid P)) (T : GeometricCurrentOn U n), 1 ≤ n → n ≤ d → d ≤ P → IsOpen U → IsEmbeddedSubmanifold 2 d N → (closure N \ N) ∩ U = ∅ → IsMinimizingIn T (U ∩ N) → T.support ⊆ U ∩ N → BoundaryVanishes T → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ∃ Λ : ℝ, 0 ≤ Λ ∧ ∀ (y : Euclid P) (R : ℝ), closedBall y R ⊆ K → MonotoneOn (fun ρ : ℝ => ENNReal.ofReal (Real.exp (Λ * ρ) / ρ ^ n) * T.massOn (ball y ρ)) (Ioo 0 R)) ∧ (N = univ → ∀ (y : Euclid P) (R : ℝ), ball y R ⊆ U → MonotoneOn (fun ρ : ℝ => ENNReal.ofReal (1 / ρ ^ n) * T.massOn (ball y ρ)) (Ioo 0 R)) ∧ (∃ Θ : Euclid P → ℝ, (∀ y ∈ U, HasMassDensity T y (Θ y)) ∧ UpperSemicontinuousOn Θ U) ∧ ∀ y ∈ T.support, ∀ θ : ℝ, HasMassDensity T y θ → 1 ≤ θ := by
  intro P n d U N T _ hnd hdP hU hN hcl hmin hspt hbd
  -- Step 0.  `T = τ(M, θ, ξ)`; by 7.1.2 in `ℝ^{n+k}`, `N` of dimension `n + ℓ`, `v(M, θ)` is
  -- stationary in `N ∩ U` and has locally bounded mean curvature in `U`
  obtain ⟨R, hR⟩ := hmin.1
  have hstat : R.IsStationaryAlong N ∧ R.HasLocallyBoundedMeanCurvature := by
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le (hnd.trans hdP)
    obtain ⟨ℓ, rfl⟩ := Nat.exists_eq_add_of_le hnd
    exact Submission.minimizing_implies_stationary n k ℓ (by omega) U N T hU hN hcl
      (hspt.trans inter_subset_right) (by rw [inter_comm]; exact hmin) hbd R hR
  -- `M_W(T) = μ_R(W)` for open `W ⊆ U`; `x ∈ spt T` iff `μ_R(B_ε(x)) > 0` for all `ε > 0`
  obtain ⟨hmass, hsupp, -⟩ := Submission.dimred_im_mass_measure P n U T R hU hR
  have hp := Submission.dsmc_approxTangentPlane_starProjection_aemeasurable P n U R hU
  -- (i) on `K`, `δV(X) = -∫ X · H dμ_R` with `|H| ≤ Λ` everywhere, so 3.17 applies on `B_r(y)`
  have hi : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ∃ Λ : ℝ, 0 ≤ Λ ∧
      ∀ (y : Euclid P) (r : ℝ), closedBall y r ⊆ K → MonotoneOn (fun ρ : ℝ =>
        ENNReal.ofReal (Real.exp (Λ * ρ) / ρ ^ n) * T.massOn (ball y ρ)) (Ioo 0 r) := by
    intro K hK hKU
    obtain ⟨Λ, hΛ, H, hHm, hHΛ, hfv⟩ :=
      Submission.dimred_mono_truncated_mean_curvature P n U R hstat.2 K hK hKU
    refine ⟨Λ, hΛ, fun y r hyr => ?_⟩
    intro σ hσ ρ hρ hσρ
    have hBU : ∀ s, s ≤ r → ball y s ⊆ U := fun s hs =>
      (ball_subset_ball hs).trans (ball_subset_closedBall.trans (hyr.trans hKU))
    dsimp only
    rw [hmass _ isOpen_ball (hBU σ hσ.2.le), hmass _ isOpen_ball (hBU ρ hρ.2.le)]
    exact Submission.dsmc_exp_ball_mass_monotone P n U R H Λ y r (hyr.trans hKU) hp hHm hHΛ
      (fun X hX hXc hXs => hfv X hX hXc (hXs.trans (ball_subset_closedBall.trans hyr)))
      σ ρ hσ.1 hσρ hρ.2.le
  -- (ii) if `N = ℝᴾ`, then `TₓN = ℝᴾ` (`γ(t) = x + tv`), so `δV = 0` in `U`: take `H = 0`
  have hii : N = univ → ∀ (y : Euclid P) (r : ℝ), ball y r ⊆ U → MonotoneOn (fun ρ : ℝ =>
      ENNReal.ofReal (1 / ρ ^ n) * T.massOn (ball y ρ)) (Ioo 0 r) := by
    rintro rfl y r hyr σ hσ ρ hρ hσρ
    have hfv : ∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X →
        tsupport X ⊆ U → R.firstVariation X = 0 := fun X hX hXc hXU =>
      hstat.1 X hX hXc hXU fun x _ => ⟨fun t => x + t • X x,
        (contDiff_const.add (contDiff_id.smul contDiff_const)).contDiffOn, mapsTo_univ _ _,
        by simp, by simpa using ((hasDerivAt_id (0 : ℝ)).smul_const (X x)).const_add x⟩
    -- 3.17 with `H = 0` and `κ = 0` on `B̄_{(ρ+r)/2}(y) ⊆ B_r(y)`
    have hr : closedBall y ((ρ + r) / 2) ⊆ U :=
      (closedBall_subset_ball (by linarith [hρ.2])).trans hyr
    have h := Submission.dsmc_exp_ball_mass_monotone P n U R 0 0 y ((ρ + r) / 2) hr hp
      aestronglyMeasurable_zero (fun _ => by simp) (fun X hX hXc hXs => by
        rw [hfv X hX hXc (hXs.trans (ball_subset_closedBall.trans hr))]
        simp) σ ρ hσ.1 hσρ (by linarith [hρ.2])
    simp only [zero_mul, Real.exp_zero] at h
    dsimp only
    rw [hmass _ isOpen_ball ((ball_subset_ball hσ.2.le).trans hyr),
      hmass _ isOpen_ball ((ball_subset_ball hρ.2.le).trans hyr)]
    exact h
  -- (iii) `M_{B_{ε/2}(y)}(T) ≤ μ_R(B̄_{ε/2}(y)) = ∫_{M ∩ B̄_{ε/2}(y)} θ dHⁿ < ∞` when
  -- `B_ε(y) ⊆ U`; monotone limits then give `Θ`, upper semicontinuous on `U`
  have hfin : ∀ y ∈ U, ∃ r : ℝ, 0 < r ∧ T.massOn (ball y r) ≠ ∞ := by
    intro y hy
    obtain ⟨ε, hε, hεU⟩ := Metric.isOpen_iff.1 hU y hy
    have hcU : closedBall y (ε / 2) ⊆ U := (closedBall_subset_ball (half_lt_self hε)).trans hεU
    refine ⟨ε / 2, half_pos hε, ?_⟩
    rw [hmass _ isOpen_ball (ball_subset_closedBall.trans hcU)]
    refine ne_top_of_le_ne_top ?_ (measure_mono ball_subset_closedBall)
    rw [IMRep.measure, withDensity_apply _ measurableSet_closedBall,
      Measure.restrict_restrict measurableSet_closedBall, inter_comm]
    exact R.locallyIntegrable_mult _ (isCompact_closedBall y (ε / 2)) hcU
  obtain ⟨Θ, hΘ, hΘusc⟩ := Submission.dimred_mono_density_usc_of_monotone P n U T hU hfin hi
  -- (iv) `Θ ≥ 1` `μ_R`-a.e. and `Θ` is upper semicontinuous, so `Θ ≥ 1` on `spt T`
  refine ⟨hi, hii, ⟨Θ, hΘ, hΘusc⟩, ?_⟩
  exact Submission.dimred_mono_support_density_ge_one_of_usc P n U T R.measure Θ hU hmass
    (fun x hx => (hsupp x (hspt hx).1).1 hx)
    (Submission.dimred_mono_ae_ball_density_ge_one P n U R hU) hΘ hΘusc

/-- Chapter 7 of Simon's *Introduction to GMT*: the headline results above. -/
theorem main_theorem : MinimizingImpliesStationary ∧ ExistenceOfMinimizingFilling ∧ CompactnessOfMinimizingCurrents ∧ DensityAndTangentCones ∧ IntegerDensityAndTangentPlanes ∧ RegularSetDense ∧ DensityOneImpliesRegular ∧ SingularSetSmallWhereDensityBelowTwo ∧ HalfSpaceConeLiesInBoundary ∧ CodimensionOneRegularity ∧ RegularComponentsAreMinimizing := by sorry

theorem Submission.dgcr_bwd_coordinate_form : ∀ (m : ℕ) (a : Euclid (m + 1) → ℝ) (j : Fin (m + 1)), ContDiff ℝ (⊤ : ℕ∞) a → ∃ ψ : DifferentialForm (Euclid (m + 1)) m, IsSmoothForm ψ ∧ tsupport ψ ⊆ tsupport a ∧ ∀ x : Euclid (m + 1), exteriorDerivative ψ x (fun i => EuclideanSpace.single i (1 : ℝ)) = fderiv ℝ a x (EuclideanSpace.single j (1 : ℝ)) := by
  intro m a j ha
  obtain ⟨β, hβ⟩ := Submission.dgcr_bwd_coordinate_covector m j
  refine ⟨fun y => a y • β, ha.smul contDiff_const, tsupport_smul_subset_left _ _, fun x => ?_⟩
  have hax : DifferentiableAt ℝ a x := (ha.differentiable (by simp)).differentiableAt
  rw [Submission.dgcr_bwd_extDeriv_smul_const (m + 1) m a β x _ hax, Finset.sum_eq_single j]
  · rw [hβ j, ite_eq_left rfl, ← mul_assoc, mul_comm ((-1 : ℝ) ^ (j : ℕ)), mul_assoc, ← pow_add,
      ← two_mul, pow_mul]
    simp
  · intro i _ hij
    rw [hβ i, ite_eq_right hij]
    simp
  · intro hj
    exact absurd (Finset.mem_univ j) hj
/-- **Weak derivatives of a top-dimensional density vanish** (steps 3–5 of the Constancy Theorem,
Simon Ch. 6, 2.34).  Let `X(ω) = ∫ G ⟨ω, e₁ ∧ ⋯ ∧ e_{m+1}⟩ dL^{m+1}` on `V ⊆ ℝ^{m+1}` with `∂X = 0`
on test forms supported in `B ⊆ V`.  Then `∫_B G ∂ⱼa = 0` for every `a ∈ C_c^∞` with `spt a ⊆ B`:
`ψ = a γⱼ` is an `m`-test form with `spt ψ ⊆ spt a ⊆ B` and `dψ(e₁, …, e_{m+1}) = ∂ⱼa`, so
`0 = ∂X(ψ) = X(dψ) = ∫ G ∂ⱼa`, and `G ∂ⱼa` vanishes off `spt a ⊆ B`. -/
theorem Submission.dtc_bc_cz_tc_weak_derivs : ∀ (m : ℕ) (V B : Set (Euclid (m + 1))) (X : GeometricCurrentOn V (m + 1)) (G : Euclid (m + 1) → ℝ), B ⊆ V → (∀ β : TestFormOn V m, tsupport (β : DifferentialForm (Euclid (m + 1)) m) ⊆ B → X.boundary β = 0) → (∀ ω : TestFormOn V (m + 1), X ω = ∫ y, G y * (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) y ⇑(EuclideanSpace.basisFun (Fin (m + 1)) ℝ)) → ∀ a : Euclid (m + 1) → ℝ, ContDiff ℝ (⊤ : ℕ∞) a → HasCompactSupport a → tsupport a ⊆ B → ∀ j : Fin (m + 1), ∫ v in B, G v * fderiv ℝ a v (EuclideanSpace.single j (1 : ℝ)) = 0 := by
  intro m V B X G hBV hbdry hrep a ha hacpt haB j
  -- `ψ = a γⱼ` is smooth, `spt ψ ⊆ spt a` and `dψ(e₁, …, e_{m+1}) = ∂ⱼa`
  obtain ⟨ψ, hψs, hψsupp, hψd⟩ := Submission.dgcr_bwd_coordinate_form m a j ha
  -- `spt ψ` is a closed subset of the compact set `spt a ⊆ B ⊆ V`: `ψ` is a test form in `V`
  have hψc : HasCompactSupport ψ :=
    IsCompact.of_isClosed_subset hacpt (isClosed_tsupport ψ) hψsupp
  let β : TestFormOn V m := ⟨ψ, ⟨⟨hψs, hψc⟩, hψsupp.trans (haB.trans hBV)⟩⟩
  -- `0 = ∂X(ψ) = X(dψ) = ∫ G ⟨dψ, e₁ ∧ ⋯ ∧ e_{m+1}⟩`
  have h0 : X.boundary β = 0 := hbdry β (hψsupp.trans haB)
  rw [GeometricCurrentOn.boundary_apply, hrep] at h0
  have hbasis : ⇑(EuclideanSpace.basisFun (Fin (m + 1)) ℝ) =
      fun i => EuclideanSpace.single i (1 : ℝ) := by
    funext i
    simp
  -- hence `∫ G ∂ⱼa = 0`
  have h1 : ∫ y, G y * fderiv ℝ a y (EuclideanSpace.single j (1 : ℝ)) = 0 := by
    rw [← h0]
    congr 1
    funext y
    change G y * fderiv ℝ a y (EuclideanSpace.single j (1 : ℝ)) =
      G y * exteriorDerivative ψ y ⇑(EuclideanSpace.basisFun (Fin (m + 1)) ℝ)
    rw [hbasis, hψd y]
  -- `G ∂ⱼa` vanishes off `spt a ⊆ B`, so `∫_B G ∂ⱼa = ∫ G ∂ⱼa`
  rw [setIntegral_eq_integral_of_forall_compl_eq_zero]
  · exact h1
  · intro v hv
    have hva : v ∉ tsupport a := fun h => hv (haB h)
    simp [fderiv_of_notMem_tsupport ℝ hva]
/-- **Mollification approximates a `C¹_c` function in a directional derivative** (step 3 of the
extension from smooth to `C¹` tests in the graph-cycle regularity step of Simon 7.4.3).  For
`φ ∈ C¹_c(ℝⁿ)`, `δ > 0`, a direction `v` and `ε > 0` there is `ψ ∈ C^∞_c(ℝⁿ)` with `spt ψ` in the
closed `δ`-neighbourhood of `spt φ` and `|Dψ(x)v − Dφ(x)v| ≤ ε` for all `x`.  Take `r₀ > 0` with
`|∂ᵥφ(a) − ∂ᵥφ(b)| < ε` when `|a − b| < r₀` (`∂ᵥφ` is continuous with compact support), a
normalized mollifier `ρ` with `spt ρ ⊆ B_r(0)`, `r = min r₀ δ`, and `ψ = ρ ⋆ φ`; then
`∂ᵥψ = ρ ⋆ ∂ᵥφ`, which is within `ε` of `∂ᵥφ`. -/
theorem Submission.dgcr_stc_mollify_C1_fderiv_approx : ∀ (n : ℕ) (φ : Euclid n → ℝ), ContDiff ℝ 1 φ → HasCompactSupport φ → ∀ (δ : ℝ), 0 < δ → ∀ (v : Euclid n) (ε : ℝ), 0 < ε → ∃ ψ : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) ψ ∧ HasCompactSupport ψ ∧ tsupport ψ ⊆ cthickening δ (tsupport φ) ∧ ∀ x, |fderiv ℝ ψ x v - fderiv ℝ φ x v| ≤ ε := by
  intro n φ hφ hφc δ hδ v ε hε
  -- `∂ᵥφ = Dφ(·) v` is continuous with compact support, hence uniformly continuous: it varies by
  -- less than `ε` on balls of radius `r₀`
  have hDφ : Continuous (fderiv ℝ φ) := hφ.continuous_fderiv one_ne_zero
  have hDφc : HasCompactSupport (fderiv ℝ φ) := hφc.fderiv ℝ
  have hg : Continuous fun x => fderiv ℝ φ x v := hDφ.clm_apply continuous_const
  have hgc : HasCompactSupport fun x => fderiv ℝ φ x v :=
    hDφc.comp_left (g := fun A : Euclid n →L[ℝ] ℝ => A v) rfl
  obtain ⟨r₀, hr₀, hr₀g⟩ :=
    Metric.uniformContinuous_iff.mp (hgc.uniformContinuous_of_continuous hg) ε hε
  -- a normalized mollifier `ρ` with `spt ρ ⊆ B_r(0)`, `r = min r₀ δ`; `ψ = ρ ⋆ φ`
  obtain ⟨ρ, hρ, hρc, hρ0, hρ1, hρs⟩ :=
    Submission.dgcr_stc_exists_normalized_mollifier n (min r₀ δ) (lt_min hr₀ hδ)
  have hρi : LocallyIntegrable ρ volume := hρ.continuous.locallyIntegrable
  let L := ContinuousLinearMap.lsmul ℝ ℝ (E := ℝ)
  -- `spt ψ ⊆ spt ρ + spt φ ⊆ B_r(0) + spt φ`, inside the closed set `cthickening δ (spt φ)`
  have hsupp : tsupport (convolution ρ φ L volume) ⊆ cthickening δ (tsupport φ) := by
    refine closure_minimal (fun z hz => ?_) isClosed_cthickening
    obtain ⟨a, ha, b, hb, rfl⟩ := Set.mem_add.mp (support_convolution_subset L hz)
    refine mem_cthickening_of_dist_le _ b δ _ (subset_tsupport φ hb) ?_
    rw [dist_eq_norm, add_sub_cancel_right]
    exact (mem_ball_zero_iff.mp (hρs ha)).le.trans (min_le_right r₀ δ)
  -- `ψ` is smooth, and compactly supported as `cthickening δ (spt φ)` is compact
  refine ⟨convolution ρ φ L volume,
    hρc.contDiff_convolution_left L hρ hφ.continuous.locallyIntegrable,
    (IsCompact.cthickening hφc).of_isClosed_subset (isClosed_tsupport _) hsupp, hsupp, fun x => ?_⟩
  -- `Dψ(x) v = (ρ ⋆ ∂ᵥφ)(x)`
  rw [(hφc.hasFDerivAt_convolution_right L hρi hφ x).fderiv,
    convolution_precompR_apply L hρi hDφc hDφ x v, ← Real.dist_eq]
  -- `ρ ≥ 0`, `∫ ρ = 1`, `spt ρ ⊆ B_r(0)` and `|∂ᵥφ(y) − ∂ᵥφ(x)| < ε` on `B_r(x)`
  exact dist_convolution_le hε.le hρs hρ0 hρ1 hg.aestronglyMeasurable fun y hy =>
    (hr₀g ((mem_ball.mp hy).trans_le (min_le_left r₀ δ))).le

/-- Step 14 of the proof that an integer multiplicity cycle carried by a `C¹` graph is regular
(Simon 7.4.3, via Allard's theorem): weak derivatives tested against `C^∞` functions may be
tested against `C¹` functions.  If `∫_D G ∂ⱼa = 0` for every `a ∈ C_c^∞(D)`, then `∫ G ∂ᵢφ = 0`
for every `φ ∈ C_c¹(D)`.  On the compact set `K = cthickening δ (spt φ) ⊆ D`, `G` is integrable
and `∂ᵢφ` is bounded.  The mollified tests `ψ` satisfy `spt ψ ⊆ K` and `|∂ᵢψ − ∂ᵢφ| ≤ ε`, so
`∫_K G ∂ᵢφ = 0` in the limit; every integrand vanishes off `K`. -/
theorem Submission.dgcr_smooth_tests_to_C1_tests : ∀ (n : ℕ) (D : Set (Euclid n)) (G : Euclid n → ℝ), IsOpen D → LocallyIntegrableOn G D volume → (∀ a : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) a → HasCompactSupport a → tsupport a ⊆ D → ∀ j : Fin n, ∫ v in D, G v * fderiv ℝ a v (EuclideanSpace.single j (1 : ℝ)) = 0) → ∀ φ : Euclid n → ℝ, ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∀ i : Fin n, ∫ x, G x * fderiv ℝ φ x ((EuclideanSpace.basisFun (Fin n) ℝ) i) = 0 := by
  intro n D G hD hG htest φ hφ hφc hφD i
  rw [EuclideanSpace.basisFun_apply]
  -- step 1: `K = cthickening δ (tsupport φ) ⊆ D` is compact and `G` is integrable on `K`
  obtain ⟨δ, hδ, hKD⟩ := hφc.isCompact.exists_cthickening_subset_open hD hφD
  have hK : IsCompact (cthickening δ (tsupport φ)) := hφc.isCompact.cthickening
  have hGK : IntegrableOn G (cthickening δ (tsupport φ)) volume :=
    hG.integrableOn_compact_subset hKD hK
  -- `G ∂ᵢu` vanishes off `K` when `tsupport u ⊆ K`
  have hvan : ∀ u : Euclid n → ℝ, tsupport u ⊆ cthickening δ (tsupport φ) →
      ∀ x ∉ cthickening δ (tsupport φ), G x * fderiv ℝ u x (EuclideanSpace.single i 1) = 0 :=
    fun u hu x hx => by rw [fderiv_of_notMem_tsupport ℝ fun h => hx (hu h), zero_apply, mul_zero]
  -- step 2: `∂ᵢφ` is continuous, hence bounded on `K`
  have hf : Continuous fun x => fderiv ℝ φ x (EuclideanSpace.single i 1) :=
    (hφ.continuous_fderiv one_ne_zero).clm_apply continuous_const
  obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn hf.continuousOn
  -- step 3: the integral over `ℝⁿ` is the integral over `K`
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero (hvan φ (self_subset_cthickening _))]
  -- step 4: smooth tests `ψ` with `tsupport ψ ⊆ K` approximate `∂ᵢφ` uniformly on `K`
  refine Submission.dgcr_stc_setIntegral_mul_eq_zero_of_uniform_approx n
    (cthickening δ (tsupport φ)) G (fun x => fderiv ℝ φ x (EuclideanSpace.single i 1)) C
    isClosed_cthickening.measurableSet hGK hf.aestronglyMeasurable
    (fun x hx => (Real.norm_eq_abs _).symm.trans_le (hC x hx)) fun ε hε => ?_
  obtain ⟨ψ, hψ, hψc, hψK, hψε⟩ := Submission.dgcr_stc_mollify_C1_fderiv_approx n φ hφ hφc δ hδ
    (EuclideanSpace.single i 1) ε hε
  refine ⟨fun x => fderiv ℝ ψ x (EuclideanSpace.single i 1),
    ((hψ.continuous_fderiv (by simp)).clm_apply continuous_const).aestronglyMeasurable,
    fun x _ => (abs_sub_comm _ _).trans_le (hψε x), ?_⟩
  -- `∫_K G ∂ᵢψ = ∫ G ∂ᵢψ = ∫_D G ∂ᵢψ`, which vanishes as `ψ` is a smooth test in `D`
  have hvanD : ∀ x ∉ D, G x * fderiv ℝ ψ x (EuclideanSpace.single i 1) = 0 :=
    fun x hx => hvan ψ hψK x fun h => hx (hKD h)
  rw [setIntegral_eq_integral_of_forall_compl_eq_zero (hvan ψ hψK),
    ← setIntegral_eq_integral_of_forall_compl_eq_zero hvanD]
  exact htest ψ hψ hψc (hψK.trans hKD) i

/-- **Constancy theorem in top dimension** (Simon Ch. 6, Theorem 2.34, for `n`-currents in
`ℝⁿ`; Lemma B of the codimension-zero blow-up step).  Let `X ∈ 𝒟ₙ(V)`, `n = m + 1`, be integer
multiplicity and `B ⊆ V` open and connected with `∂X = 0` in `B`.  Then `X = c[[B]]` in `B` for
some `c ∈ ℤ`: `X(ω) = c ∫ ω(e₁, …, eₙ) dLⁿ` whenever `spt ω ⊆ B`.  `X(ω) = ∫ g ω(e) dLⁿ` for an
integer-valued `L¹_loc` density `g`; `∂X = 0` in `B` kills the weak derivatives of `g` against
`C_c^∞(B)` tests, hence (by mollification) against `C_c¹(B)` tests, and distributional constancy
gives `g = c₀` a.e. on `B`.  `B` has positive measure unless empty, so `c₀ ∈ ℤ`. -/
theorem Submission.dtc_bc_cz_top_constancy : ∀ (m : ℕ) (V B : Set (Euclid (m + 1))) (X : GeometricCurrentOn V (m + 1)), IsOpen V → IsIntegerMultiplicity X → IsOpen B → IsPreconnected B → B ⊆ V → (∀ β : TestFormOn V m, tsupport (β : DifferentialForm (Euclid (m + 1)) m) ⊆ B → X.boundary β = 0) → ∃ c : ℤ, ∀ ω : TestFormOn V (m + 1), tsupport (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) ⊆ B → X ω = (c : ℝ) * ∫ y, (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) y ⇑(EuclideanSpace.basisFun (Fin (m + 1)) ℝ) := by
  intro m V B X hV hIM hB hBc hBV hbd
  -- step 1: the integer density `g` of `X`, `X(ω) = ∫ g ω(e) dLⁿ`
  obtain ⟨g, hgloc, hrep⟩ := Submission.dtc_bc_cz_top_density (m + 1) V X m.succ_pos hV hIM
  -- steps 2–5: `∂X = 0` in `B` gives `∫_B g ∂ⱼa = 0` for every `a ∈ C_c^∞(B)`
  have hweak := Submission.dtc_bc_cz_tc_weak_derivs m V B X (fun y => (g y : ℝ)) hBV hbd hrep
  -- step 6: `C¹` tests by mollification; distributional constancy gives `g = c₀` a.e. on `B`
  have hgB : LocallyIntegrableOn (fun y => (g y : ℝ)) B volume := hgloc.mono_set hBV
  obtain ⟨c₀, hc₀⟩ : ∃ c₀ : ℝ, ∀ᵐ y ∂(volume.restrict B), (g y : ℝ) = c₀ :=
    Poincare.SimonGMT.Chapter08.ae_eq_const_of_weak_coordinate_derivatives_zero hgB hB hBc
      (Submission.dgcr_smooth_tests_to_C1_tests (m + 1) B _ hB hgB hweak)
  -- step 7: the constant is an integer, `g(y₀)` for some `y₀ ∈ B` (any `c` if `B = ∅`)
  obtain ⟨c, hc⟩ : ∃ c : ℤ, ∀ᵐ y ∂(volume.restrict B), (g y : ℝ) = c := by
    rcases B.eq_empty_or_nonempty with rfl | hne
    · exact ⟨0, by simp⟩
    obtain ⟨y₀, -, hy₀⟩ :=
      Measure.exists_mem_of_measure_ne_zero_of_ae (hB.measure_pos volume hne).ne' hc₀
    refine ⟨g y₀, ?_⟩
    filter_upwards [hc₀] with y hy
    rw [hy, hy₀]
  -- step 8: `X(ω) = ∫ g ω(e) = c ∫ ω(e)`, as `ω = 0` off `B`
  refine ⟨c, fun ω hω => ?_⟩
  rw [hrep ω, ← integral_const_mul]
  refine integral_congr_ae ?_
  filter_upwards [(ae_restrict_iff' hB.measurableSet).mp hc] with y hy
  by_cases hyB : y ∈ B
  · rw [hy hyB]
  · rw [image_eq_zero_of_notMem_tsupport fun h => hyB (hω h)]
    simp

/-- **Simon 7.1.1 in codimension zero.**  If `n ≥ 1` and `C ∈ 𝒟ₙ(ℝⁿ)` is integer multiplicity,
then `C` is minimizing in every `A ⊆ ℝⁿ`; in fact every competitor equals `C`.  For a competitor
`S`, the current `X = S − C` is integer multiplicity (Simon 6.3.2(1)) with `∂X = ∂S − ∂C = 0`, so
the Constancy Theorem (6.2.34) gives `X = c[[ℝⁿ]]` with `c ∈ ℤ`.  As `spt X` is compact, testing
`X` with a bump form supported away from `spt X` forces `c = 0`.  Hence `S = C` and
`M_W(C) = M_W(S)`. -/
theorem Submission.dtc_bc_cz_isMinimizingIn : ∀ (n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid n)) n) (A : Set (Euclid n)), 0 < n → IsIntegerMultiplicity C → IsMinimizingIn C A := by
  intro n C A hn hC
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  refine ⟨hC, fun W S _ _ hS hbd hcpt _ => ?_⟩
  -- 1. `X = S − C` is an integer multiplicity cycle in `ℝⁿ`
  have hX : IsIntegerMultiplicity (S - C) :=
    Submission.dtc_isIntegerMultiplicity_sub (m + 1) (m + 1) univ S C isOpen_univ hn hS hC
  have hcycle : ∀ β : TestFormOn (univ : Set (Euclid (m + 1))) m,
      tsupport (β : DifferentialForm (Euclid (m + 1)) m) ⊆ univ → (S - C).boundary β = 0 := by
    intro β _
    have hbd' : S.boundary = C.boundary := hbd
    show S.boundary β - C.boundary β = 0
    rw [hbd', sub_self]
  -- 2. Constancy Theorem on `ℝⁿ`: `X = c[[ℝⁿ]]` with `c ∈ ℤ`
  obtain ⟨c, hc⟩ := Submission.dtc_bc_cz_top_constancy m univ univ (S - C) isOpen_univ hX
    isOpen_univ isPreconnected_univ Subset.rfl hcycle
  -- 3. `spt X` is compact, so `c = 0`
  have hc0 : (c : ℝ) = 0 := Submission.dtc_bc_cz_isMinimizingIn_const_eq_zero (m + 1) (S - C) c
    hn hcpt fun ω => hc ω (subset_univ _)
  -- 4. hence `S = C`, and `M_W(C) = M_W(S)`
  have hSC : S = C := by
    ext ω
    have h : (S - C) ω = 0 := by rw [hc ω (subset_univ _), hc0, zero_mul]
    exact sub_eq_zero.mp h
  rw [hSC]

/-- **Blow-ups of a top-dimensional current away from `spt ∂T`** (step 1 of the proof of
Simon 7.3.1(2) in the case `k = 0`, via the Constancy Theorem, Simon 6.2.34).  Let `n ≥ 1`,
`T ∈ 𝒟ₙ(U)` integer multiplicity in the open set `U ⊆ ℝⁿ`, `x ∈ U ∖ spt ∂T` and `λⱼ ↓ 0`.  As `x`
lies in the zero region of `∂T`, `∂T = 0` in a ball `B_r(x) ⊆ U`, so `T = c[[ℝⁿ]]` in `B_r(x)`
for some `c ∈ ℤ` (constancy).  `C = c[[ℝⁿ]]` is integer multiplicity, hence minimizing in `ℝⁿ`.
In `B_{r/λⱼ}(0) = η_{x,λⱼ}(B_r(x))`, which eventually contains every ball `B_R(0)`,
`η_{x,λⱼ#}T = C` and `∂η_{x,λⱼ#}T = 0`; local agreement on these balls gives `η_{x,λⱼ#}T ⇀ C`,
`μ_{η_{x,λⱼ#}T} → μ_C` (locality of the weight measure) and `∂C = 0`. -/
theorem Submission.dtc_bc_codim_zero : ∀ (n : ℕ) (U : Set (Euclid n)) (T : GeometricCurrentOn U n) (x : Euclid n), 0 < n → IsOpen U → IsIntegerMultiplicity T → x ∈ U → x ∉ boundarySupport T → ∀ (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), Tendsto lams atTop (𝓝 0) → ∃ C : GeometricCurrentOn (univ : Set (Euclid n)) n, ConvergesWeakly (fun j => blowUp T x (lams j) (hlams j).ne') C ∧ MassMeasuresConverge (fun j => blowUp T x (lams j) (hlams j).ne') C ∧ IsMinimizingIn C univ ∧ BoundaryVanishes C := by
  intro n U T x hn hU hT hxU hx lams hlams hlim
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  -- step 3: `x ∉ spt ∂T` puts `x` in the zero region of `∂T`, so `∂T = 0` in a ball `B_r(x) ⊆ U`
  have hxZ : x ∈ T.boundary.zeroRegion := by
    by_contra h
    exact hx ((mem_sdiff x).2 ⟨hxU, h⟩)
  obtain ⟨W, ⟨hWo, -, hWU, hWv⟩, hxW⟩ := mem_sUnion.1 hxZ
  obtain ⟨r, hr, hrW⟩ := Metric.isOpen_iff.1 hWo x hxW
  have hrU : ball x r ⊆ U := hrW.trans (subset_closure.trans hWU)
  have hTb : ∀ β : TestFormOn U m, tsupport (β : DifferentialForm (Euclid (m + 1)) m) ⊆ ball x r →
      T.boundary β = 0 := fun β hβ => hWv β (hβ.trans hrW)
  -- steps 1–3: `T = c[[ℝⁿ]]` in `B_r(x)` for some `c ∈ ℤ` (constancy theorem)
  obtain ⟨c, hTc⟩ := Submission.dtc_bc_cz_top_constancy m U (ball x r) T hU hT isOpen_ball
    (convex_ball x r).isPreconnected hrU hTb
  -- step 4: the limit `C = c[[ℝⁿ]]` is integer multiplicity
  obtain ⟨C, hCim, hC⟩ := Submission.dtc_bc_cz_unit_current (m + 1) c hn
  -- `η_{x,λ}(y) = λ⁻¹(y − x)`, so the domains `η_{x,λⱼ}(U)` are open
  have hdil : ∀ (lam : ℝ) (y : Euclid (m + 1)), dilation x lam y = lam⁻¹ • (y - x) := by
    intro lam y
    simp only [dilation, dilationCLM, smul_apply, ContinuousLinearMap.id_apply]
    rw [smul_sub, neg_add_eq_sub]
  have hopen : ∀ j, IsOpen (dilation x (lams j) '' U) := by
    intro j
    rw [show dilation x (lams j) = (fun y => (lams j)⁻¹ • y) ∘ fun y => y - x from
      funext (hdil (lams j))]
    exact (isOpenMap_smul₀ (inv_ne_zero (hlams j).ne')).comp (isOpenMap_sub_right x) U hU
  -- steps 5 and 7: for large `j`, `B_R(0) ⊆ B_{r/λⱼ}(0) ⊆ η_{x,λⱼ}(U)`, and in `B_{r/λⱼ}(0)`
  -- `η_{x,λⱼ#}T = c[[ℝⁿ]] = C` and `∂η_{x,λⱼ#}T = 0`
  have hev : ∀ R : ℝ, ∀ᶠ j in atTop, ball (0 : Euclid (m + 1)) R ⊆ dilation x (lams j) '' U ∧
      (∀ ω : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1),
        tsupport (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) ⊆ ball 0 R →
          currentEval (blowUp T x (lams j) (hlams j).ne')
            (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) = C ω) ∧
      ∀ β : TestFormOn (dilation x (lams j) '' U) m,
        tsupport (β : DifferentialForm (Euclid (m + 1)) m) ⊆ ball 0 R →
          (blowUp T x (lams j) (hlams j).ne').boundary β = 0 := by
    intro R
    have hR1 : 0 < |R| + 1 := by positivity
    filter_upwards [(tendsto_order.1 hlim).2 _ (div_pos hr hR1)] with j hj
    have hlam := hlams j
    -- `R ≤ r / λⱼ` since `λⱼ (|R| + 1) < r`
    have hRr : ball (0 : Euclid (m + 1)) R ⊆ ball 0 (r / lams j) := by
      refine ball_subset_ball ?_
      rw [le_div_iff₀ hlam]
      rw [lt_div_iff₀ hR1] at hj
      nlinarith [le_abs_self R]
    -- `B_{r/λ}(0) = η_{x,λ}(B_r(x)) ⊆ η_{x,λ}(U)`
    have hball : ball (0 : Euclid (m + 1)) (r / lams j) ⊆ dilation x (lams j) '' U := by
      intro z hz
      rw [mem_ball_zero_iff, lt_div_iff₀ hlam] at hz
      refine ⟨x + lams j • z, hrU ?_, ?_⟩
      · rw [mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hlam.le]
        linarith [mul_comm (lams j) ‖z‖]
      · rw [hdil, add_sub_cancel_left, smul_smul, inv_mul_cancel₀ hlam.ne', one_smul]
    have hval := Submission.dtc_bc_cz_blowUp_eval m U T x r c (lams j) (hlams j) hrU
    exact ⟨hRr.trans hball, fun ω hω => (hval.1 hTc ω (hω.trans hRr)).trans (hC ω).symm,
      fun β hβ => hval.2 hTb β (hβ.trans hRr)⟩
  -- steps 6–8: weak convergence, convergence of the mass measures (via the locality of the
  -- weight measure) and `∂C = 0`
  obtain ⟨hconv, hmass, hbd⟩ := Submission.dtc_bc_cz_local_agreement
    Submission.dtc_bc_measure_restrict_eq_of_eqOn (m + 1) m (fun j => dilation x (lams j) '' U)
    (fun j => blowUp T x (lams j) (hlams j).ne') C hopen hev
  -- step 9: `C` is minimizing in `ℝⁿ`
  exact ⟨C, hconv, hmass, Submission.dtc_bc_cz_isMinimizingIn (m + 1) C univ hn hCim, hbd⟩
/-- **Null set of points with small fillings** (Simon Ch. 6, 8.2 (4)–(6); the lower density
bound in the proof of 7.2.4).  Assume (VO).  Let `μ = μ_C` be finite on compact sets with
`M_W(C) = μ(W)` for open `W`, and `C(ω) = ∫ ⟨ω, ξ⟩ dμ` with `|ξ| ≤ 1` `μ`-a.e.  Let
`0 ≤ κ < 1 ≤ λ`.  Suppose that every `x ∈ E` has, at arbitrarily small scales `δ`, a radius
`ρ < δ` with `μ(∂B_ρ(x)) = 0` and a filling `S` with `∂S = ∂A`, where `A = C⌞B_ρ(x)`,
`M(S) ≤ κ μ(B_ρ(x))` and `spt S ⊆ B̄_{λδ}(x)`.  Then `μ(E) = 0`.
Fix `θ ∈ (κ, 1)` and a `W`-admissible `ω`.  The cone bound for the cycle `S − A` gives
`A(ω) ≤ θ μ(B_ρ(x))` at small scales.  The covering lemma then gives
`C(ω) ≤ μ(W) − (1 − θ) μ(E')` for each piece `E' = E ∩ B_k(0) ⊆ W = B_{k+1}(0)`.  Taking the
supremum over `ω` gives `μ(W) = M_W(C) ≤ μ(W) − (1 − θ) μ(E')`, so `μ(E') = 0`. -/
theorem Submission.cbrld_measure_eq_zero_of_small_fillings : (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → ∀ (P d : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (κ lam : ℝ) (E : Set (Euclid P)), 0 ≤ κ → κ < 1 → 1 ≤ lam → (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ W : Set (Euclid P), IsOpen W → C.massOn W = μ W) → AEStronglyMeasurable ξ μ → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ x ∈ E, ∀ δ : ℝ, 0 < δ → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ ∧ μ (sphere x ρ) = 0 ∧ ∃ (A S : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ y in ball x ρ, ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y) ∂μ) ∧ S.boundary = A.boundary ∧ S.mass ≤ ENNReal.ofReal κ * μ (ball x ρ) ∧ S.support ⊆ closedBall x (lam * δ)) → μ E = 0 := by
  intro hVO P d C μ ξ κ lam E hκ0 hκ1 hlam hμK hCμ hξm hξ hCξ hE
  have hball_fin : ∀ (x : Euclid P) (r : ℝ), μ (ball x r) < ∞ := fun x r =>
    (measure_mono ball_subset_closedBall).trans_lt (hμK _ (isCompact_closedBall x r))
  -- a fixed `θ ∈ (κ, 1)` plays the role of `κ + ε` in the covering lemma
  obtain ⟨θ, hκθ, hθ1⟩ := exists_between hκ1
  have hlam0 : 0 < lam := by linarith
  -- Steps 3–4: a piece `E' ⊆ E` inside an open `W` of finite measure is `μ`-null
  have hpiece : ∀ E' W : Set (Euclid P), E' ⊆ E → IsOpen W → E' ⊆ W → μ W < ∞ → μ E' = 0 := by
    intro E' W hE'E hWo hE'W hWfin
    have hE'fin : μ E' < ∞ := (measure_mono hE'W).trans_lt hWfin
    -- Step 3: every `W`-admissible `ω` satisfies `C(ω) ≤ μ(W) - (1 - θ) μ(E')`
    have hest : ∀ ω ∈ massAdmissibleOn (univ : Set (Euclid P)) (d + 1) W,
        C ω ≤ (μ W).toReal - (1 - θ) * (μ E').toReal := by
      intro ω hω
      have hωc : Continuous (ω : DifferentialForm (Euclid P) (d + 1)) :=
        ContDiff.continuous ω.property.1.1
      -- `g(y) = ξ(y)(ω(y))` is `μ`-a.e. strongly measurable with `|g| ≤ 1` `μ`-a.e.
      have hgm : AEStronglyMeasurable
          (fun y => ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y)) μ :=
        (isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable
          (hξm.prodMk hωc.aestronglyMeasurable) :)
      have hg1 : ∀ᵐ y ∂μ, |ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y)| ≤ 1 := by
        filter_upwards [hξ] with y hy
        exact (hy _).trans (hω.2 y)
      -- `g = 0` off `W`, so `C(ω) = ∫_W g dμ`
      have hCW : C ω = ∫ y in W, ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y) ∂μ := by
        rw [hCξ ω]
        refine (setIntegral_eq_integral_of_forall_compl_eq_zero fun y hy => ?_).symm
        rw [image_eq_zero_of_notMem_tsupport fun h => hy (hω.1 h), map_zero]
      -- the cone constant of `ω`
      obtain ⟨c, hc, hcone⟩ := Submission.cbrld_cycle_eval_le_radius_mul_mass hVO P d ω
      have hden : 0 < (c + 1) * lam * (1 + κ) :=
        mul_pos (mul_pos (by linarith) hlam0) (by linarith)
      obtain ⟨δ₀, hδ₀⟩ : ∃ δ₀ : ℝ, δ₀ = (θ - κ) / ((c + 1) * lam * (1 + κ)) := ⟨_, rfl⟩
      have hδ₀pos : 0 < δ₀ := by rw [hδ₀]; exact div_pos (by linarith) hden
      have hδ₀eq : δ₀ * ((c + 1) * lam * (1 + κ)) = θ - κ := by
        rw [hδ₀]; exact div_mul_cancel₀ _ hden.ne'
      -- Step 3(i): `∫_{B̄_ρ(x)} g dμ ≤ θ μ(B̄_ρ(x))` at arbitrarily small radii
      have hsmall : ∀ x ∈ E', ∀ δ' : ℝ, 0 < δ' → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ' ∧
          ∫ y in closedBall x ρ, ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y) ∂μ ≤
            θ * (μ (closedBall x ρ)).toReal := by
        intro x hx δ' hδ'
        have hδpos : 0 < min δ' δ₀ := lt_min hδ' hδ₀pos
        obtain ⟨ρ, hρ0, hρδ, hsph, A, S, hA, hbd, hSm, hSs⟩ := hE x (hE'E hx) (min δ' δ₀) hδpos
        refine ⟨ρ, hρ0, hρδ.trans_le (min_le_left _ _), ?_⟩
        have hR : 0 < lam * min δ' δ₀ := mul_pos hlam0 hδpos
        have hAs : A.support ⊆ closedBall x (lam * min δ' δ₀) :=
          (Submission.cbrld_ns_ball_current_support_subset P (d + 1) μ ξ A x ρ hA).trans
            (closedBall_subset_closedBall (hρδ.le.trans (le_mul_of_one_le_left hδpos.le hlam)))
        -- comparison with the cycle `S - A` at scale `R = λ min(δ', δ₀)`
        have hcmp := Submission.cbrld_ns_eval_le_of_small_filling P d A S ω (μ (ball x ρ)) x c κ
          (lam * min δ' δ₀) hc hκ0 hR (hball_fin x ρ) hω.2 hcone hbd
          (Submission.cbrld_ns_ball_current_mass_le P (d + 1) μ ξ A x ρ hξ hA) hSm hAs hSs
        have hcR : c * (lam * min δ' δ₀) * (1 + κ) ≤ θ - κ := by
          have h1 : 0 ≤ c * lam * (1 + κ) := mul_nonneg (mul_nonneg hc hlam0.le) (by linarith)
          have h2 : c * lam * (1 + κ) ≤ (c + 1) * lam * (1 + κ) :=
            mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (by linarith) hlam0.le)
              (by linarith)
          calc c * (lam * min δ' δ₀) * (1 + κ) = c * lam * (1 + κ) * min δ' δ₀ := by ring
            _ ≤ c * lam * (1 + κ) * δ₀ := mul_le_mul_of_nonneg_left (min_le_right _ _) h1
            _ ≤ (c + 1) * lam * (1 + κ) * δ₀ := mul_le_mul_of_nonneg_right h2 hδ₀pos.le
            _ = θ - κ := by rw [← hδ₀eq]; ring
        -- `μ(∂B_ρ(x)) = 0`, so closed and open balls agree `μ`-a.e.
        have hae : closedBall x ρ =ᵐ[μ] ball x ρ := by
          refine ae_eq_set.2 ⟨by rw [closedBall_sdiff_ball]; exact hsph, ?_⟩
          rw [sdiff_eq_empty.2 ball_subset_closedBall, measure_empty]
        rw [setIntegral_congr_set hae, measure_congr hae, ← hA ω]
        calc A ω ≤ (κ + c * (lam * min δ' δ₀) * (1 + κ)) * (μ (ball x ρ)).toReal := hcmp
          _ ≤ θ * (μ (ball x ρ)).toReal :=
            mul_le_mul_of_nonneg_right (by linarith) ENNReal.toReal_nonneg
      -- Step 3(ii): the covering lemma with `θ`
      rw [hCW]
      exact Submission.cbrld_vitali_setIntegral_le P μ
        (fun y => ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y)) θ E' W hμK hgm hg1
        hθ1.le hWo hE'W hWfin hsmall
    -- Step 4: `μ(W) = M_W(C) ≤ max(μ(W) - (1 - θ) μ(E'), 0)`
    have hmass : C.massOn W ≤ ENNReal.ofReal (max ((μ W).toReal - (1 - θ) * (μ E').toReal) 0) := by
      refine sSup_le ?_
      rintro _ ⟨ω, hω, rfl⟩
      exact ENNReal.ofReal_le_ofReal ((hest ω hω).trans (le_max_left _ _))
    rw [hCμ W hWo] at hmass
    have hreal := ENNReal.toReal_le_of_le_ofReal (le_max_right _ _) hmass
    by_contra hne
    have hpos : 0 < (μ E').toReal := ENNReal.toReal_pos hne hE'fin.ne
    have hWpos : 0 < (μ W).toReal :=
      hpos.trans_le (ENNReal.toReal_mono hWfin.ne (measure_mono hE'W))
    have hprod : 0 < (1 - θ) * (μ E').toReal := mul_pos (by linarith) hpos
    rcases le_total ((μ W).toReal - (1 - θ) * (μ E').toReal) 0 with h | h
    · rw [max_eq_right h] at hreal
      linarith
    · rw [max_eq_left h] at hreal
      linarith
  -- Step 2: `E = ⋃ₖ (E ∩ B_k(0))`, and each piece lies in the open `B_{k+1}(0)`
  have hcover : E ⊆ ⋃ k : ℕ, E ∩ ball (0 : Euclid P) k := by
    intro y hy
    obtain ⟨k, hk⟩ := exists_nat_gt (dist y 0)
    exact mem_iUnion.2 ⟨k, hy, mem_ball.2 hk⟩
  exact measure_mono_null hcover (measure_iUnion_null fun k : ℕ =>
    hpiece (E ∩ ball (0 : Euclid P) k) (ball (0 : Euclid P) (k + 1)) inter_subset_left isOpen_ball
      (fun z hz => ball_subset_ball (by linarith) hz.2) (hball_fin _ _))

/-- **Lower density bound for cycles with the integer slice property** (Simon Ch. 6, proof of
8.2, with the lower density in place of `Θ^{*n}`; `n = d + 1 < P`).  The local filling
`dtc_bc_tc_cl_ld_exists_small_filling`, fed with (SL) = `cmc_slice_mass_bounds`, (MR) and (Isor),
gives `η₀ > 0` such that every `x` with `liminf_{r↓0} μ(B_r(x))/(ωₙrⁿ) < η₀` has, at arbitrarily
small scales `δ`, a radius `ρ < δ` with `μ(∂B_ρ(x)) = 0` and a filling `S` of `∂(C⌞B_ρ(x))` with
`M(S) ≤ μ(B_ρ(x))/2` and `spt S ⊆ B̄_{(1+3√P)δ}(x)`.  The set of these points is `μ`-null by
`cbrld_measure_eq_zero_of_small_fillings` with `κ = 1/2` and `λ = 1 + 3√P`. -/
theorem Submission.dtc_bc_tc_cl_lower_density : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 1 ≤ c ∧ ∀ Z : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Z → IsCompact Z.support → Z.boundary = 0 → Z.mass < ∞ → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2), IsIntegerMultiplicity Y ∧ Y.boundary = Z ∧ Y.mass ≤ ENNReal.ofReal (c * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1)) * Z.mass.toReal) ∧ Y.support ⊆ thickening (3 * Real.sqrt P * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1))) Z.support) → ∀ (P d : ℕ), d + 1 < P → (∃ η₀ : ℝ, 0 < η₀ ∧ ∀ (C : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)), C.boundary = 0 → (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ W : Set (Euclid P), IsOpen W → C.massOn W = μ W) → AEStronglyMeasurable ξ μ → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (C).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B)) → ∀ᵐ x ∂μ, ENNReal.ofReal η₀ ≤ liminf (fun r : ℝ => μ (ball x r) / (unitBallVolume (d + 1) * ENNReal.ofReal (r ^ (d + 1)))) (𝓝[>] 0)) := by
  intro hMR hVO hIsor P d hPd
  -- steps 2–4: small fillings of sphere slices at points of lower density `< η₀`
  obtain ⟨η₀, hη₀, hfill⟩ := Submission.dtc_bc_tc_cl_ld_exists_small_filling
    Submission.cmc_slice_mass_bounds hMR hIsor P d hPd
  refine ⟨η₀, hη₀, fun C μ ξ hCb hμ hCμ hξm hξb hC hISP => ?_⟩
  -- steps 0, 5, 6: the points of lower density `< η₀` form a `μ`-null set
  rw [ae_iff]
  refine Submission.cbrld_measure_eq_zero_of_small_fillings hVO P d C μ ξ (1 / 2)
    (1 + 3 * Real.sqrt P) _ (by norm_num) (by norm_num) (le_add_of_nonneg_right (by positivity))
    hμ hCμ hξm hξb hC fun x hx δ hδ => ?_
  exact hfill C μ ξ hCb hμ hξm hξb hC hISP x (not_le.mp hx) δ hδ

/-- **Closure theorem for compactly supported currents** (Simon Ch. 6, 8.2, the step
`CL_P(d), BR_P(d) ⟹ CL*_{P,d+1}` used for 7.2.4 and 7.3.1): if `K ⊆ ℝᴾ` is compact,
`Tⱼ ∈ 𝒟_{d+1}(ℝᴾ)` are integer multiplicity with integer multiplicity boundaries, `spt Tⱼ ⊆ K`,
`supⱼ (M(Tⱼ) + M(∂Tⱼ)) < ∞` and `Tⱼ ⇀ T`, then `T` is integer multiplicity.  `spt T ⊆ K` by
(VO) and `M(T), M(∂T) < ∞` by lower semicontinuity; `∂T` is integer multiplicity by `CL_P(d)`
(`∂∂Tⱼ = 0`), so it has a compactly supported integer multiplicity filling `Y`.  The integer slice
property holds for the `Tⱼ` and `Y`, passes to the weak limit `T` and then to the compactly
supported cycle `Γ = T − Y`; the lower density bound and the cycle case make `Γ` integer
multiplicity, and so is `T = Γ − (0 − Y)` by (IMC)(c). -/
theorem Submission.dtc_bc_tc_cl_closure_compact_support : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 1 ≤ c ∧ ∀ Z : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Z → IsCompact Z.support → Z.boundary = 0 → Z.mass < ∞ → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2), IsIntegerMultiplicity Y ∧ Y.boundary = Z ∧ Y.mass ≤ ENNReal.ofReal (c * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1)) * Z.mass.toReal) ∧ Y.support ⊆ thickening (3 * Real.sqrt P * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1))) Z.support) → ∀ (P d : ℕ), d + 1 < P → (∀ (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U d) (T : GeometricCurrentOn U d), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T) → (∀ (U : Set (Euclid P)) (R : GeometricCurrentOn U (d + 1)), IsOpen U → IsIntegerMultiplicity R → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → R.boundary.massOn W < ∞) → IsIntegerMultiplicity R.boundary) → (∀ (Ts : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (T : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (K : Set (Euclid P)), IsCompact K → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ j, IsIntegerMultiplicity (Ts j).boundary) → (∀ j, (Ts j).support ⊆ K) → ⨆ j, ((Ts j).mass + (Ts j).boundary.mass) < ∞ → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T) := by
  intro hMR hRect hVO hIsor P d hdP hCL hBR Ts T K hK hTsIM hTsbIM hTsK hbound hconv
  have hIMCc := hRect.2.2.1
  -- (REP) and (MM) from the sibling foundations; `0` is integer multiplicity
  obtain ⟨hREP, ⟨-, -, hMM⟩, -⟩ := Submission.dtc_bc_tc_cl_foundations
  have hzero := Submission.cbr_cc_current_algebra.1
  -- `S := supⱼ (M(Tⱼ) + M(∂Tⱼ)) < ∞` bounds `M(Tⱼ)`, `M(∂Tⱼ)` and their `liminf`s
  obtain ⟨S, hS, hSlt⟩ : ∃ S : ℝ≥0∞, (∀ j, (Ts j).mass + (Ts j).boundary.mass ≤ S) ∧ S < ∞ :=
    ⟨_, le_iSup (fun j => (Ts j).mass + (Ts j).boundary.mass), hbound⟩
  have hTsS : ∀ j, (Ts j).mass ≤ S := fun j => le_self_add.trans (hS j)
  have hTsbS : ∀ j, (Ts j).boundary.mass ≤ S := fun j => le_add_self.trans (hS j)
  have hliminf : ∀ u : ℕ → ℝ≥0∞, (∀ j, u j ≤ S) → liminf u atTop ≤ S := fun u hu =>
    liminf_le_of_frequently_le' (Frequently.of_forall hu)
  -- Step 1: `spt T ⊆ K` by (VO), so `spt T` is compact; `M(T), M(∂T) < ∞` by lower
  -- semicontinuity of mass (Simon 6.2.14), `∂Tⱼ ⇀ ∂T`
  have hTvan : ∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1),
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) (d + 1))) K → T ω = 0 := by
    intro ω hω
    have h0 : ∀ j, Ts j ω = 0 := fun j => hVO P (d + 1) univ (Ts j) ω (hω.mono_right (hTsK j))
    exact tendsto_nhds_unique (hconv ω) (by simp only [h0]; exact tendsto_const_nhds)
  have hTsupp : IsCompact T.support :=
    (Submission.rsd_cmr_support_subset_of_vanish P (d + 1) univ K T isOpen_univ hK
      (subset_univ K) hTvan).2
  have hTmass : T.mass < ∞ :=
    ((hconv.massOn_le_liminf univ).trans (hliminf _ hTsS)).trans_lt hSlt
  have hTbmass : T.boundary.mass < ∞ :=
    ((hconv.boundary.massOn_le_liminf univ).trans (hliminf _ hTsbS)).trans_lt hSlt
  -- Step 2: `∂T` is integer multiplicity by CL_P(d) applied to `∂Tⱼ ⇀ ∂T` (`∂∂Tⱼ = 0`)
  have hbb : ∀ (m : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1))
      (W : Set (Euclid P)), boundaryMassOn X.boundary W = 0 := by
    intro m
    cases m with
    | zero => intro X W; rfl
    | succ k =>
      intro X W
      show X.boundary.boundary.massOn W = 0
      rw [GeometricCurrentOn.boundary_boundary]
      refine le_antisymm (sSup_le ?_) zero_le
      rintro _ ⟨ω, -, rfl⟩
      simp
  have hTbIM : IsIntegerMultiplicity T.boundary := by
    refine hCL univ (fun j => (Ts j).boundary) T.boundary isOpen_univ hTsbIM (fun W _ _ => ?_)
      hconv.boundary
    refine lt_of_le_of_lt (iSup_le fun j => ?_) hSlt
    show (Ts j).boundary.massOn W + boundaryMassOn (Ts j).boundary W ≤ S
    rw [hbb d (Ts j) W, add_zero]
    exact ((Ts j).boundary.massOn_mono (subset_univ W)).trans (hTsbS j)
  -- Step 3: a compactly supported integer multiplicity filling `Y` of `∂T` with `M(Y) < ∞`
  obtain ⟨Y, hYIM, hYb, hYmass, hYsupp⟩ :=
    Submission.dtc_bc_tc_cl_cc_compact_im_filling hMR hIMCc hVO hIsor P d (by omega) T hTsupp
      hTbmass hTbIM
  -- Step 4: `Γ = T − Y` is a cycle of finite mass with compact support
  have hΓb : (T - Y).boundary = 0 := by
    ext η
    have h : Y.boundary η = T.boundary η := by rw [hYb]
    change T.boundary η - Y.boundary η = 0
    rw [h, sub_self]
  have hΓmass : (T - Y).mass < ∞ := by
    refine ((Submission.cbr_cc_current_algebra).2.1 P (d + 1) univ (T - Y) T Y 1 (-1)
      (fun ω => by change T ω - Y ω = _; push_cast; ring) univ).trans_lt ?_
    simp only [Int.natAbs_one, Int.natAbs_neg, Nat.cast_one, one_mul]
    exact ENNReal.add_lt_top.2 ⟨hTmass, hYmass⟩
  have hΓsupp : IsCompact (T - Y).support := by
    refine (Submission.rsd_cmr_support_subset_of_vanish P (d + 1) univ (T.support ∪ Y.support)
      (T - Y) isOpen_univ (hTsupp.union hYsupp) (subset_univ _) fun ω hω => ?_).2
    change T ω - Y ω = 0
    rw [hVO P (d + 1) univ T ω (hω.mono_right subset_union_left),
      hVO P (d + 1) univ Y ω (hω.mono_right subset_union_right), sub_zero]
  -- Step 5: currents `X` with `X`, `∂X` integer multiplicity have the integer slice property
  have hISPIM := Submission.dtc_bc_tc_cl_cc_slice_property_of_im hRect
    Submission.cmc_slice_mass_bounds hMM Submission.cbr_setIntegral_eq_of_integral_eq P d hBR
  -- Step 6: so do the `Tⱼ` and `Y`, and SLIM_{P,d} gives it for the weak limit `T`
  have hSLIM := Submission.dtc_bc_tc_cl_slice_property_of_weak_limit hMR hRect P d hdP hCL
  have hTsW : ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ →
      ⨆ i, ((Ts i).massOn W + (Ts i).boundary.massOn W) < ∞ := fun W _ _ =>
    lt_of_le_of_lt (iSup_le fun i => (add_le_add ((Ts i).massOn_mono (subset_univ W))
      ((Ts i).boundary.massOn_mono (subset_univ W))).trans (hS i)) hSlt
  have hISPT := hSLIM Ts T (fun i => hISPIM (Ts i) (hTsIM i) (hTsbIM i)) hTsW hconv
  have hISPY := hISPIM Y hYIM (hYb ▸ hTbIM)
  -- Step 7: the integer slice property passes to `Γ = T − Y` (slices are linear in the current)
  have hTmW : ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ → T.massOn W < ∞ :=
    fun W _ _ => (T.massOn_mono (subset_univ W)).trans_lt hTmass
  have hTbmW : ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ →
      T.boundary.massOn W < ∞ :=
    fun W _ _ => (T.boundary.massOn_mono (subset_univ W)).trans_lt hTbmass
  have hYmW : ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ → Y.massOn W < ∞ :=
    fun W _ _ => (Y.massOn_mono (subset_univ W)).trans_lt hYmass
  have hYbmW : ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ →
      Y.boundary.massOn W < ∞ := by
    rw [hYb]
    exact hTbmW
  have hISPΓ := Submission.cbr_cc_slice_property_sub hREP Submission.cmc_slice_mass_bounds hIMCc
    Submission.cbr_setIntegral_eq_of_integral_eq d P T Y hTmW hTbmW hYmW hYbmW hISPT hISPY
  -- Step 8: LD_{P,d} and CYC_{P,d} make the cycle `Γ` integer multiplicity
  have hΓIM := Submission.dtc_bc_tc_cl_cycle_isIntegerMultiplicity hMR hRect hVO P d hdP hSLIM
    (Submission.dtc_bc_tc_cl_lower_density hMR hVO hIsor P d hdP) (T - Y) hΓb hΓmass hΓsupp hISPΓ
  -- `T = Γ − (0 − Y)` is integer multiplicity by (IMC)(c)
  have hT : (T - Y) - (0 - Y) = T := by
    ext ω
    change (T ω - Y ω) - ((0 : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) ω - Y ω) = T ω
    rw [GeometricCurrentOn.zero_apply]
    ring
  rw [← hT]
  exact hIMCc P (d + 1) univ _ _ isOpen_univ hΓIM
    (hIMCc P (d + 1) univ _ _ isOpen_univ (hzero P (d + 1) univ) hYIM)

/-- **Closure theorem in `ℝᴾ`, positive codimension** (Simon Ch. 6, Theorem 3.11: weak limits of
integer multiplicity currents with locally bounded `M_W(Tⱼ) + M_W(∂Tⱼ)` are integer multiplicity,
proved in §8 (Theorem 8.2, Remarks 8.3) with 6.1–6.3).  Let `m + 1 < P` and `Tⱼ, T ∈ 𝒟_{m+1}(ℝᴾ)`
with every `Tⱼ` integer multiplicity, `supⱼ (M_W(Tⱼ) + M_W(∂Tⱼ)) < ∞` for every bounded open `W`
and `Tⱼ ⇀ T`; then `T` is integer multiplicity.  Fix `P` and prove, by induction on `d < P`, the
closure theorem `CL_P(d)` in every open `U ⊆ ℝᴾ`.  `CL_P(0)` is
`dtc_bc_tc_cl_closure_degree_zero`.  For `d + 1 < P`, `CL_P(d)` and the deformation theorem give
boundary rectifiability `BR_P(d)` (`dtc_bc_tc_cl_boundary_isIntegerMultiplicity`); `CL_P(d)`,
`BR_P(d)` and the isoperimetric filling give the closure theorem `CL*_{P,d+1}` for sequences with
supports in a fixed compact set (`dtc_bc_tc_cl_closure_compact_support`); and `BR_P(d)` with
`CL*_{P,d+1}` gives `CL_P(d+1)` by localization (`dtc_bc_tc_cl_closure_succ`).  Finally apply
`CL_P(m+1)` in `U = ℝᴾ`: an open `W ⊂⊂ ℝᴾ` has compact, hence bounded, closure, so `W` is
bounded, and `boundaryMassOn` of an `(m+1)`-current is the mass of its boundary. -/
theorem Submission.dtc_bc_tc_closure : ∀ (P m : ℕ) (Ts : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), m + 1 < P → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → Bornology.IsBounded W → ⨆ j, ((Ts j).massOn W + (Ts j).boundary.massOn W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T := by
  intro P m Ts T hmP hTs hmass hconv
  -- the accepted siblings (MR), (IMC), (VO)
  have hMR := Submission.cmc_massOn_eq_imRep_measure
  have hIMC := Submission.cmc_imRep_locality_restrict_sub
  have hVO := Submission.dtc_vanish_off_support
  -- (REP), the deformation theorem and the isoperimetric filling, in positive codimension
  have hREP := Submission.dtc_bc_tc_cl_foundations.1
  obtain ⟨hDT, hIso⟩ := Submission.dtc_bc_tc_cl_deformation_isoperimetric hMR hIMC hVO
  -- `CL_P(d)` for every `d < P`, by induction on `d`
  have hCL : ∀ d : ℕ, d < P → ∀ (U : Set (Euclid P)) (Xs : ℕ → GeometricCurrentOn U d)
      (X : GeometricCurrentOn U d), IsOpen U → (∀ j, IsIntegerMultiplicity (Xs j)) →
      (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U →
        ⨆ j, ((Xs j).massOn W + boundaryMassOn (Xs j) W) < ∞) →
      WeaklyConvergesOn Xs X → IsIntegerMultiplicity X := by
    intro d
    induction d with
    | zero => exact fun _ => Submission.dtc_bc_tc_cl_closure_degree_zero hREP hMR hIMC P
    | succ d ih =>
      intro hd
      -- `CL_P(d) ⟹ BR_P(d)`, then `CL_P(d) ∧ BR_P(d) ⟹ CL*_{P,d+1}`, then `CL_P(d+1)`
      have hCLd := ih (by omega)
      have hBR :=
        Submission.dtc_bc_tc_cl_boundary_isIntegerMultiplicity hMR hIMC hVO hDT P d hd hCLd
      exact Submission.dtc_bc_tc_cl_closure_succ hMR hIMC hVO P d hd hBR
        (Submission.dtc_bc_tc_cl_closure_compact_support hMR hIMC hVO hIso P d hd hCLd hBR)
  -- `CL_P(m+1)` in `U = ℝᴾ`: `W ⊂⊂ ℝᴾ` is bounded, and `boundaryMassOn` is `M_W(∂Tⱼ)`
  refine hCL (m + 1) hmP univ Ts T isOpen_univ hTs (fun W hW hWU => ?_) hconv
  exact hmass W hW (isBounded_closure_iff.mp hWU.1.isBounded)

/-- **Truncated compactness** (Simon Ch. 6, 4.9–4.10 and 3.11, as used for 7.3.1(2)).  Let
`n = m + 1 < P` and let `Sⱼ ∈ 𝒟ₙ(Uⱼ)` be integer multiplicity such that, for every `R`, eventually
`B̄_R(0) ⊆ Uⱼ`, `M_{B_R(0)}(Sⱼ) ≤ c_R < ∞` and `∂Sⱼ = 0` in `B_R(0)`.  Choose `ψ` strictly
increasing with `B̄_{k+1}(0) ⊆ U_{ψ(k)}` and `∂S_{ψ(k)} = 0` in `B_{k+1}(0)`.  Truncating
`S_{ψ(k)}` at a good slicing radius `ρ'_k ∈ ((k + 1)/4, (k + 1)/2)` gives integer multiplicity
`T_k ∈ 𝒟ₙ(ℝᴾ)` which agree with `S_{ψ(k)}` and have no boundary in `B_{ρ'_k}(0)`, with
`M_O(T_k) ≤ M_O(S_{ψ(k)})` and `M(T_k), M(∂T_k) < ∞`; hence `sup_k (M_W(T_k) + M_W(∂T_k)) < ∞` for
bounded open `W`.  A weakly convergent subsequence `T_{φ'(j)} ⇀ C` has an integer multiplicity
limit (Federer–Fleming), and agreement on `B_{ρ_j}(0)` with `ρ_j → ∞` gives `∂C = 0` and
`S_{φ(j)} ⇀ C`. -/
theorem Submission.dtc_bc_truncated_compactness : ∀ (P m : ℕ) (Us : ℕ → Set (Euclid P)) (Ss : (j : ℕ) → GeometricCurrentOn (Us j) (m + 1)), m + 1 < P → (∀ j, IsOpen (Us j)) → (∀ R : ℝ, ∀ᶠ j in atTop, closedBall (0 : Euclid P) R ⊆ Us j) → (∀ j, IsIntegerMultiplicity (Ss j)) → (∀ R : ℝ, ∃ c : ℝ≥0∞, c ≠ ∞ ∧ ∀ᶠ j in atTop, (Ss j).massOn (ball 0 R) ≤ c) → (∀ R : ℝ, ∀ᶠ j in atTop, ∀ ω : TestFormOn (Us j) m, tsupport (ω : DifferentialForm (Euclid P) m) ⊆ ball 0 R → (Ss j).boundary ω = 0) → ∃ (φ : ℕ → ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (Ŝ : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (ρ : ℕ → ℝ), StrictMono φ ∧ IsIntegerMultiplicity C ∧ C.boundary = 0 ∧ ConvergesWeakly (fun j => Ss (φ j)) C ∧ (∀ j, IsIntegerMultiplicity (Ŝ j)) ∧ (∀ W : Set (Euclid P), IsOpen W → Bornology.IsBounded W → ⨆ j, ((Ŝ j).massOn W + (Ŝ j).boundary.massOn W) < ∞) ∧ WeaklyConvergesOn Ŝ C ∧ Tendsto ρ atTop atTop ∧ (∀ j, closedBall (0 : Euclid P) (ρ j) ⊆ Us (φ j)) ∧ ∀ (j : ℕ) (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ ball 0 (ρ j) → Ŝ j ω = currentEval (Ss (φ j)) (ω : DifferentialForm (Euclid P) (m + 1)) := by
  intro P m Us Ss hmP hUo hUs hIM hmass hbd
  -- Step 1: `ψ` strictly increasing, `B̄_{k+1}(0) ⊆ U_{ψ(k)}` and `∂S_{ψ(k)} = 0` on `B_{k+1}(0)`.
  obtain ⟨ψ, hψ, hψk⟩ := Filter.extraction_forall_of_eventually fun k : ℕ =>
    (hUs ((k : ℝ) + 1)).and (hbd ((k : ℝ) + 1))
  -- Steps 2–3: truncate `S_{ψ(k)}` at a good radius `ρ'_k ∈ ((k + 1)/4, (k + 1)/2)`.
  choose ρ' T hρlo hρhi hTIM hTeq hTbd hTmass hTfin hTbfin using fun k : ℕ =>
    Submission.dtc_bc_tc_truncation P m (Us (ψ k)) (Ss (ψ k)) ((k : ℝ) + 1) (hUo (ψ k))
      (by positivity) (hψk k).1 (hIM (ψ k)) (hψk k).2
  have hρ' : Tendsto ρ' atTop atTop := by
    refine tendsto_atTop_atTop.2 fun b => ⟨⌈4 * b⌉₊, fun k hk => ?_⟩
    have : 4 * b ≤ k := (Nat.le_ceil _).trans (Nat.cast_le.2 hk)
    linarith [hρlo k]
  -- Step 4: `sup_k (M_W(T_k) + M_W(∂T_k)) < ∞` for every bounded open `W`.
  have hbound : ∀ W : Set (Euclid P), IsOpen W → Bornology.IsBounded W →
      ⨆ k, ((T k).massOn W + (T k).boundary.massOn W) < ∞ := by
    intro W hWo hWb
    obtain ⟨r, hWr⟩ := hWb.subset_ball (0 : Euclid P)
    obtain ⟨c, hc, hcev⟩ := hmass r
    -- for large `k`: `M_W(T_k) ≤ M_{B_r(0)}(S_{ψ(k)}) ≤ c` and `M_W(∂T_k) = 0` (`W ⊆ B_{ρ'_k}(0)`)
    have hev : ∀ᶠ k in atTop, (T k).massOn W + (T k).boundary.massOn W ≤ c := by
      filter_upwards [hψ.tendsto_atTop.eventually hcev, hρ'.eventually_ge_atTop r] with k hk hkr
      have hb : (T k).boundary.massOn W ≤ 0 := by
        refine sSup_le ?_
        rintro _ ⟨β, hβ, rfl⟩
        dsimp only
        rw [hTbd k β (hβ.1.trans (hWr.trans (ball_subset_ball hkr))), ENNReal.ofReal_zero]
      calc (T k).massOn W + (T k).boundary.massOn W ≤ c + 0 :=
            add_le_add (((hTmass k W hWo).trans ((Ss (ψ k)).massOn_mono hWr)).trans hk) hb
        _ = c := add_zero c
    obtain ⟨K, hK⟩ := eventually_atTop.1 hev
    -- the finitely many earlier terms are finite, as `M(T_k) < ∞` and `M(∂T_k) < ∞`
    have hfin : ∀ k, (T k).massOn W + (T k).boundary.massOn W < ∞ := fun k =>
      ENNReal.add_lt_top.2 ⟨((T k).massOn_mono (subset_univ W)).trans_lt (hTfin k),
        ((T k).boundary.massOn_mono (subset_univ W)).trans_lt (hTbfin k)⟩
    calc ⨆ k, ((T k).massOn W + (T k).boundary.massOn W)
        ≤ c + ∑ k ∈ Finset.range K, ((T k).massOn W + (T k).boundary.massOn W) := by
          refine iSup_le fun k => ?_
          rcases le_or_gt K k with hKk | hkK
          · exact (hK k hKk).trans le_self_add
          · exact (Finset.single_le_sum (f := fun k => (T k).massOn W + (T k).boundary.massOn W)
              (fun _ _ => zero_le) (Finset.mem_range.2 hkK)).trans le_add_self
      _ < ∞ := ENNReal.add_lt_top.2 ⟨hc.lt_top, ENNReal.sum_lt_top.2 fun k _ => hfin k⟩
  -- Step 5: a weakly convergent subsequence (Simon 6.2.15) with integer multiplicity limit
  -- (Simon 6.3.11).
  obtain ⟨φ', C, hφ', hconv⟩ := Submission.dtc_bc_tc_weak_compactness P (m + 1) T
    fun W hWo hWb => lt_of_le_of_lt (iSup_mono fun k => le_self_add) (hbound W hWo hWb)
  have hsub : ∀ W : Set (Euclid P), IsOpen W → Bornology.IsBounded W →
      ⨆ j, ((T (φ' j)).massOn W + (T (φ' j)).boundary.massOn W) < ∞ := fun W hWo hWb =>
    lt_of_le_of_lt (iSup_le fun j =>
      le_iSup (fun k => (T k).massOn W + (T k).boundary.massOn W) (φ' j)) (hbound W hWo hWb)
  have hρ : Tendsto (fun j => ρ' (φ' j)) atTop atTop := hρ'.comp hφ'.tendsto_atTop
  -- Step 6: `φ = ψ ∘ φ'`, `Ŝ_j = T_{φ'(j)}`, `ρ_j = ρ'_{φ'(j)}`.
  refine ⟨fun j => ψ (φ' j), C, fun j => T (φ' j), fun j => ρ' (φ' j), hψ.comp hφ',
    Submission.dtc_bc_tc_closure P m (fun j => T (φ' j)) C hmP (fun j => hTIM (φ' j)) hsub hconv,
    ?_, ?_, fun j => hTIM (φ' j), hsub, hconv, hρ, fun j => ?_, fun j => hTeq (φ' j)⟩
  · -- `∂C = 0`: `∂C(β) = lim_j ∂T_{φ'(j)}(β)`, and `∂T_{φ'(j)}(β) = 0` once `spt β ⊆ B_{ρ_j}(0)`
    ext β
    have hβc : HasCompactSupport (β : DifferentialForm (Euclid P) m) := β.property.1.2
    obtain ⟨r, hr⟩ := hβc.isCompact.isBounded.subset_ball (0 : Euclid P)
    refine tendsto_nhds_unique (hconv.boundary β) (tendsto_const_nhds.congr' ?_)
    filter_upwards [hρ.eventually_ge_atTop r] with j hj
    exact (hTbd (φ' j) β (hr.trans (ball_subset_ball hj))).symm
  · -- `S_{φ(j)} ⇀ C`: `currentEval(S_{φ(j)}, ω) = T_{φ'(j)}(ω)` once `spt ω ⊆ B_{ρ_j}(0)`
    intro ω
    have hωc : HasCompactSupport (ω : DifferentialForm (Euclid P) (m + 1)) := ω.property.1.2
    obtain ⟨r, hr⟩ := hωc.isCompact.isBounded.subset_ball (0 : Euclid P)
    refine (hconv ω).congr' ?_
    filter_upwards [hρ.eventually_ge_atTop r] with j hj
    exact hTeq (φ' j) ω (hr.trans (ball_subset_ball hj))
  · -- `B̄_{ρ_j}(0) ⊆ B̄_{φ'(j)+1}(0) ⊆ U_{φ(j)}`
    have h0 : (0 : ℝ) ≤ φ' j := Nat.cast_nonneg _
    exact (closedBall_subset_closedBall (by linarith [hρhi (φ' j)])).trans (hψk (φ' j)).1

/-- **Closure theorem for integer multiplicity cycles of bounded mass** (Simon Ch. 6, Theorem 8.2
in the case `∂Tⱼ = 0`, Remark 6.4, with `U = ℝᴾ`).  Let `n < P` and `Tⱼ, T ∈ 𝒟ₙ(ℝᴾ)` with every
`Tⱼ` an integer multiplicity cycle, `supⱼ M(Tⱼ) < ∞` and `Tⱼ ⇀ T`; then `T` is integer
multiplicity.  For every `W`, `M_W(Tⱼ) ≤ M_{ℝᴾ}(Tⱼ) = M(Tⱼ)` (`massOn_mono`) and `M_W(∂Tⱼ) = 0`,
so `supⱼ (M_W(Tⱼ) + M_W(∂Tⱼ)) ≤ supⱼ M(Tⱼ) < ∞`.  For `n = m + 1` (where `∂Tⱼ = 0` and the zero
current has zero mass) this is the hypothesis of the closure theorem `dtc_bc_tc_closure`; for
`n = 0` (where `boundaryMassOn` is `0`) it is the hypothesis of the degree-zero closure theorem
`dtc_bc_tc_cl_closure_degree_zero` in `U = ℝᴾ`. -/
theorem Submission.dtc_bc_lc_fd_bim_closure_cycles : ∀ (P n : ℕ) (Ts : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) n) (T : GeometricCurrentOn (univ : Set (Euclid P)) n), n < P → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ j, BoundaryVanishes (Ts j)) → ⨆ j, (Ts j).mass < ∞ → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T := by
  intro P n
  cases n with
  | zero =>
    intro Ts T _ hTs _ hmass hconv
    -- `CL_P(0)` in `U = ℝᴾ`: `boundaryMassOn` of a `0`-current is `0`, and `M_W(Tⱼ) ≤ M(Tⱼ)`
    refine Submission.dtc_bc_tc_cl_closure_degree_zero Submission.dtc_bc_tc_cl_foundations.1
      Submission.cmc_massOn_eq_imRep_measure Submission.cmc_imRep_locality_restrict_sub P univ Ts T
      isOpen_univ hTs (fun W _ _ => lt_of_le_of_lt (iSup_mono fun j => ?_) hmass) hconv
    rw [boundaryMassOn, add_zero]
    exact (Ts j).massOn_mono (subset_univ W)
  | succ m =>
    intro Ts T hmP hTs hbd hmass hconv
    -- the closure theorem in degree `m + 1`: `M_W(∂Tⱼ) = M_W(0) = 0` and `M_W(Tⱼ) ≤ M(Tⱼ)`
    refine Submission.dtc_bc_tc_closure P m Ts T hmP hTs
      (fun W _ _ => lt_of_le_of_lt (iSup_mono fun j => ?_) hmass) hconv
    have hbW : (Ts j).boundary.massOn W = 0 := by
      rw [show (Ts j).boundary = 0 from hbd j]
      refine le_antisymm (sSup_le ?_) bot_le
      rintro _ ⟨ω, _, rfl⟩
      simp
    rw [hbW, add_zero]
    exact (Ts j).massOn_mono (subset_univ W)
namespace Submission

/-- Local Lipschitz bounds along a segment give the global bound (step (6a) of the proof of the
skeleton retraction, Simon Ch. 6, Lemma 5.4): if every point `x + t(y − x)`, `t ∈ [0, 1]`, has a
neighbourhood on which `|f(w) − f(x + t(y − x))| ≤ K|w − (x + t(y − x))|`, then
`|f(y) − f(x)| ≤ K|y − x|`.  By continuous induction on `[0, 1]`, every `t ∈ [0, 1]` satisfies
`|f(x + t(y − x)) − f(x)| ≤ K t |y − x|`. -/
theorem dimred_mbl_dtsr_segment_lipschitz : ∀ (P : ℕ) (f : Euclid P → Euclid P) (x y : Euclid P) (K : ℝ), 0 ≤ K → (∀ t ∈ Icc (0 : ℝ) 1, ∀ᶠ w in 𝓝 (x + t • (y - x)), dist (f w) (f (x + t • (y - x))) ≤ K * dist w (x + t • (y - x))) → dist (f y) (f x) ≤ K * dist y x := by
  intro P f x y K _hK hloc
  -- Step 1: `g t = x + t(y − x)` is continuous and `|g s − g t| = |s − t| |y − x|`.
  let g : ℝ → Euclid P := fun t => x + t • (y - x)
  have hgcont : Continuous g := continuous_const.add (continuous_id.smul continuous_const)
  have hgdist : ∀ s t : ℝ, dist (g s) (g t) = |s - t| * dist y x := by
    intro s t
    simp only [g, dist_eq_norm]
    rw [show x + s • (y - x) - (x + t • (y - x)) = (s - t) • (y - x) by rw [sub_smul]; abel,
      norm_smul, Real.norm_eq_abs]
  -- Step 2: `f ∘ g` is continuous at each `t ∈ [0, 1]`: for `s` near `t`, `g s` lies in the
  -- neighbourhood of `g t` given by `hloc`, so `|f(g s) − f(g t)| ≤ K |s − t| |y − x| → 0`.
  have hfg : ∀ t ∈ Icc (0 : ℝ) 1, ContinuousAt (fun s => f (g s)) t := by
    intro t ht
    have hev : ∀ᶠ s in 𝓝 t, dist (f (g s)) (f (g t)) ≤ K * (|s - t| * dist y x) := by
      filter_upwards [(hgcont.tendsto t).eventually (hloc t ht)] with s hs
      rw [← hgdist]
      exact hs
    have hlim : Tendsto (fun s : ℝ => K * (|s - t| * dist y x)) (𝓝 t) (𝓝 0) :=
      (continuous_const.mul ((continuous_id.sub continuous_const).abs.mul
        continuous_const)).tendsto' t 0 (by simp)
    exact tendsto_iff_dist_tendsto_zero.2
      (squeeze_zero' (Eventually.of_forall fun s => dist_nonneg) hev hlim)
  -- Step 3: `S = {t | |f(g t) − f(x)| ≤ K t |y − x|}` meets `[0, 1]` in a closed set, the
  -- preimage of `(−∞, 0]` under a function continuous on `[0, 1]`.
  let S : Set ℝ := {t | dist (f (g t)) (f x) ≤ K * t * dist y x}
  have hS : IsClosed (S ∩ Icc 0 1) := by
    have hcont : ContinuousOn (fun t => dist (f (g t)) (f x) - K * t * dist y x) (Icc 0 1) := by
      intro t ht
      have hd : ContinuousAt (fun s => dist (f (g s)) (f x)) t :=
        (hfg t ht).dist continuousAt_const
      have hl : Continuous fun s : ℝ => K * s * dist y x :=
        (continuous_const.mul continuous_id).mul continuous_const
      exact hd.continuousWithinAt.sub hl.continuousWithinAt
    convert hcont.preimage_isClosed_of_isClosed isClosed_Icc (isClosed_Iic (a := (0 : ℝ)))
      using 1
    ext t
    simp only [S, mem_inter_iff, mem_ofPred_eq, mem_preimage, mem_Iic, sub_nonpos]
    tauto
  -- Step 4: `0 ∈ S`, since `g 0 = x`.
  have h0 : (0 : ℝ) ∈ S := by
    show dist (f (x + (0 : ℝ) • (y - x))) (f x) ≤ K * 0 * dist y x
    simp
  -- Step 5: if `t ∈ S ∩ [0, 1)`, then `s ∈ S` for `s > t` near `t`:
  -- `|f(g s) − f(x)| ≤ K (s − t) |y − x| + K t |y − x| = K s |y − x|`.
  have hstep : ∀ t ∈ S ∩ Ico (0 : ℝ) 1, S ∈ 𝓝[>] t := by
    rintro t ⟨htS, ht⟩
    have htS' : dist (f (g t)) (f x) ≤ K * t * dist y x := htS
    have hev : ∀ᶠ s in 𝓝 t, dist (f (g s)) (f (g t)) ≤ K * dist (g s) (g t) :=
      (hgcont.tendsto t).eventually (hloc t ⟨ht.1, ht.2.le⟩)
    filter_upwards [hev.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin] with s hs hts
    have hts' : t < s := hts
    show dist (f (g s)) (f x) ≤ K * s * dist y x
    calc dist (f (g s)) (f x) ≤ dist (f (g s)) (f (g t)) + dist (f (g t)) (f x) :=
          dist_triangle _ _ _
      _ ≤ K * dist (g s) (g t) + K * t * dist y x := add_le_add hs htS'
      _ = K * s * dist y x := by rw [hgdist, abs_of_pos (sub_pos.mpr hts')]; ring
  -- Step 6: continuous induction on `[0, 1]` gives `[0, 1] ⊆ S`.
  have hsub : Icc (0 : ℝ) 1 ⊆ S := hS.Icc_subset_of_forall_mem_nhdsWithin h0 hstep
  -- Step 7: `1 ∈ S` and `g 1 = y`.
  have h1 : dist (f (g 1)) (f x) ≤ K * 1 * dist y x := hsub ⟨zero_le_one, le_rfl⟩
  have hg1 : g 1 = y := by simp [g]
  rwa [hg1, mul_one] at h1

/-- **Retraction onto the `n`-skeleton away from the dual skeleton** (Lemma D; Simon Ch. 6,
Lemma 5.4, chapter-06.txt lines 1493–1645, with `n = m + 1`).  Let
`L*(a) = {w : w_i − a_i ∈ ℤ for at least m + 2 indices i}` and `d = dist(·, L*(a))`.  Take
`ψ = Ψ_P` (`dimred_mbl_dtsr_face_retraction_family`) and `c₀` from
`dimred_mbl_dtsr_face_count_induction`.  If `x` lies in a closed unit cube `z + [0, 1]ᴾ`
(the face `F(z, univ)`) and `d(x) > 0`, then `dimred_mbl_dtsr_dual_dist_count` gives the
counting condition with `ρ = d(x)/√(m + 2)`, and the face induction with `j = P` puts `ψ(x)` in the
same cube (so `|ψ(x) − x| ≤ √P`) and in the `n`-skeleton, and gives
`|ψ(y) − ψ(x)| ≤ (√(m + 2) c₀/d(x))|y − x|` for `y` in that cube near `x`.  The finitely many
cubes through `x` cover a neighbourhood of `x` (`dimred_mbl_dtsr_cube_cover`).  Let
`0 < r ≤ 1/4` and `d(x), d(y) ≥ r`.  If `|x − y| < r/2`, then `d > r/2` on `[x, y]` (`d` is
`1`-Lipschitz), and `dimred_mbl_dtsr_segment_lipschitz` gives the constant `2√(m + 2) c₀/r`.
Otherwise `|ψ(x) − ψ(y)| ≤ 2√P + |x − y| ≤ (4√P + 1)|x − y|/r`.  So
`c = 2√(m + 2) c₀ + 4√P + 1` works. -/
theorem dimred_mbl_dt_skeleton_retraction : ∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 0 < c ∧ ∀ a : Euclid P, (∀ i, |a i - 1 / 2| < 1 / 4) → ∃ ψ : Euclid P → Euclid P, (∀ x : Euclid P, 0 < infDist x {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} → (∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, ψ x i = z) ∧ dist (ψ x) x ≤ Real.sqrt P) ∧ ∀ r : ℝ, 0 < r → r ≤ 1 / 4 → ∀ x y : Euclid P, r ≤ infDist x {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} → r ≤ infDist y {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} → dist (ψ x) (ψ y) ≤ c / r * dist x y := by
  intro P m hPm
  -- Step 0: `c₀` from the face induction and `c = 2√(m + 2) c₀ + 4√P + 1`
  obtain ⟨c₀, hc₀, hind⟩ := Submission.dimred_mbl_dtsr_face_count_induction P m
  have hsq : (0 : ℝ) < Real.sqrt (m + 2) := Real.sqrt_pos.mpr (by positivity)
  refine ⟨2 * Real.sqrt (m + 2) * c₀ + 4 * Real.sqrt P + 1, by positivity, ?_⟩
  intro a ha
  -- Step 1: `ψ = Ψ_P` for the composite of the face retractions; the face induction at `j = P`
  obtain ⟨Ψ, hΨ0, hΨrec⟩ := Submission.dimred_mbl_dtsr_face_retraction_family P m a ha
  have key := hind a ha Ψ hΨ0 hΨrec P (by omega) le_rfl
  set L : Set (Euclid P) := {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧
    ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} with hL
  -- Step 2: the closed unit cube `z + [0, 1]ᴾ` is the face `F(z, univ)`, of diameter `√P`
  have hcard : (Finset.univ : Finset (Fin P)).card = P := by simp
  have hface : ∀ (z : Fin P → ℤ) (u : Euclid P), (∀ i, (z i : ℝ) ≤ u i ∧ u i ≤ z i + 1) →
      ∀ i, (i ∈ (Finset.univ : Finset (Fin P)) → (z i : ℝ) ≤ u i ∧ u i ≤ z i + 1) ∧
        (i ∉ (Finset.univ : Finset (Fin P)) → u i = z i) :=
    fun z u hu i => ⟨fun _ => hu i, fun h => absurd (Finset.mem_univ i) h⟩
  have hdiam : ∀ (z : Fin P → ℤ) (u v : Euclid P), (∀ i, (z i : ℝ) ≤ u i ∧ u i ≤ z i + 1) →
      (∀ i, (z i : ℝ) ≤ v i ∧ v i ≤ z i + 1) → dist u v ≤ Real.sqrt P := by
    intro z u v hu hv
    rw [EuclideanSpace.dist_eq]
    apply Real.sqrt_le_sqrt
    calc ∑ i, dist (u i) (v i) ^ 2 ≤ ∑ _i : Fin P, (1 : ℝ) := by
          apply Finset.sum_le_sum
          intro i _
          have h1 : dist (u i) (v i) ≤ 1 := by
            rw [Real.dist_eq, abs_le]
            constructor <;> linarith [(hu i).1, (hu i).2, (hv i).1, (hv i).2]
          have h0 : 0 ≤ dist (u i) (v i) := dist_nonneg
          nlinarith
      _ = P := by simp
  -- Step 3: on a cube through `u` with `d(u) > 0`, the face induction with
  -- `ρ = d(u)/√(m + 2)`; the counting condition is `dimred_mbl_dtsr_dual_dist_count`
  have hcube : ∀ (z : Fin P → ℤ) (u : Euclid P), (∀ i, (z i : ℝ) ≤ u i ∧ u i ≤ z i + 1) →
      0 < infDist u L →
      (∀ i, (i ∈ (Finset.univ : Finset (Fin P)) → (z i : ℝ) ≤ Ψ P u i ∧ Ψ P u i ≤ z i + 1) ∧
        (i ∉ (Finset.univ : Finset (Fin P)) → Ψ P u i = z i)) ∧
      (∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ k : ℤ, Ψ P u i = k) ∧
      ∀ᶠ y in 𝓝[{w : Euclid P | ∀ i, (i ∈ (Finset.univ : Finset (Fin P)) →
          (z i : ℝ) ≤ w i ∧ w i ≤ z i + 1) ∧ (i ∉ (Finset.univ : Finset (Fin P)) → w i = z i)}] u,
        dist (Ψ P y) (Ψ P u) ≤ c₀ / (infDist u L / Real.sqrt (m + 2)) * dist y u :=
    fun z u hu hd => key z Finset.univ hcard u (hface z u hu) _ (div_pos hd hsq)
      (Submission.dimred_mbl_dtsr_dual_dist_count P m a u z)
  -- Step 4, part (i): the cube `⌊x⌋ + [0, 1]ᴾ` contains both `x` and `ψ(x)`
  have hfloor : ∀ u : Euclid P, ∀ i, ((⌊u i⌋ : ℤ) : ℝ) ≤ u i ∧ u i ≤ (⌊u i⌋ : ℤ) + 1 :=
    fun u i => ⟨Int.floor_le _, (Int.lt_floor_add_one _).le⟩
  have hpartI : ∀ x : Euclid P, 0 < infDist x L →
      (∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, Ψ P x i = z) ∧
        dist (Ψ P x) x ≤ Real.sqrt P := by
    intro x hx
    obtain ⟨hmem, hint, -⟩ := hcube (fun i => ⌊x i⌋) x (hfloor x) hx
    exact ⟨hint, hdiam _ (Ψ P x) x (fun i => (hmem i).1 (Finset.mem_univ i)) (hfloor x)⟩
  -- Step 5: `|ψ(y) − ψ(w)| ≤ (√(m + 2) c₀/d(w))|y − w|` for `y` near `w`, from the finitely
  -- many cubes through `w` (`dimred_mbl_dtsr_cube_cover`)
  have hlocal : ∀ w : Euclid P, 0 < infDist w L → ∀ᶠ y in 𝓝 w,
      dist (Ψ P y) (Ψ P w) ≤ c₀ / (infDist w L / Real.sqrt (m + 2)) * dist y w := by
    intro w hw
    obtain ⟨Z, hZ, hcov⟩ := Submission.dimred_mbl_dtsr_cube_cover P w
    have hall : ∀ z ∈ Z, ∀ᶠ y : Euclid P in 𝓝 w, (∀ i, (z i : ℝ) ≤ y i ∧ y i ≤ z i + 1) →
        dist (Ψ P y) (Ψ P w) ≤ c₀ / (infDist w L / Real.sqrt (m + 2)) * dist y w := by
      intro z hz
      have h3 := (hcube z w (hZ z hz) hw).2.2
      rw [eventually_nhdsWithin_iff] at h3
      filter_upwards [h3] with y hy hyz
      exact hy (hface z y hyz)
    rw [← Finset.eventually_all] at hall
    filter_upwards [hall, hcov] with y hy hyz
    obtain ⟨z, hz, hyz⟩ := hyz
    exact hy z hz hyz
  refine ⟨Ψ P, hpartI, ?_⟩
  -- Step 6, part (ii)
  intro r hr hr4 x y hx hy
  have hc₀' : 0 ≤ 2 * Real.sqrt (m + 2) * c₀ := by positivity
  have hsP : 0 ≤ Real.sqrt P := Real.sqrt_nonneg _
  by_cases hxy : dist x y < r / 2
  · -- Step 6a: `|x − y| < r/2`, so `d > r/2` on `[x, y]`; the segment argument with
    -- `K = 2√(m + 2) c₀/r`
    have hK : 0 ≤ 2 * Real.sqrt (m + 2) * c₀ / r := by positivity
    have hseg := dimred_mbl_dtsr_segment_lipschitz P (Ψ P) x y
      (2 * Real.sqrt (m + 2) * c₀ / r) hK ?_
    · rw [dist_comm (Ψ P x), dist_comm x]
      calc dist (Ψ P y) (Ψ P x) ≤ 2 * Real.sqrt (m + 2) * c₀ / r * dist y x := hseg
        _ ≤ (2 * Real.sqrt (m + 2) * c₀ + 4 * Real.sqrt P + 1) / r * dist y x := by
          apply mul_le_mul_of_nonneg_right _ dist_nonneg
          apply div_le_div_of_nonneg_right _ hr.le
          linarith
    · intro t ht
      have hdist : dist (x + t • (y - x)) x ≤ dist x y := by
        rw [dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_eq_abs, abs_of_nonneg ht.1,
          ← dist_eq_norm, dist_comm y x]
        exact mul_le_of_le_one_left dist_nonneg ht.2
      -- `d` is `1`-Lipschitz
      have hdw : r / 2 < infDist (x + t • (y - x)) L := by
        have h1 := infDist_le_infDist_add_dist (x := x) (y := x + t • (y - x)) (s := L)
        rw [dist_comm] at h1
        linarith
      have hwpos : 0 < infDist (x + t • (y - x)) L := by linarith
      filter_upwards [hlocal _ hwpos] with w hw
      refine hw.trans (mul_le_mul_of_nonneg_right ?_ dist_nonneg)
      rw [div_div_eq_mul_div, div_le_div_iff₀ hwpos hr]
      have hc0 : 0 ≤ c₀ * Real.sqrt (m + 2) := by positivity
      nlinarith
  · -- Step 6b: `|x − y| ≥ r/2`, so `|ψ(x) − ψ(y)| ≤ 2√P + |x − y| ≤ (4√P + 1)|x − y|/r`
    have hxy : r / 2 ≤ dist x y := not_lt.mp hxy
    have h1 := (hpartI x (by linarith)).2
    have h2 := (hpartI y (by linarith)).2
    have hD : 0 ≤ dist x y := dist_nonneg
    calc dist (Ψ P x) (Ψ P y) ≤ dist (Ψ P x) x + dist x y + dist y (Ψ P y) :=
          dist_triangle4 _ _ _ _
      _ ≤ 2 * Real.sqrt P + dist x y := by rw [dist_comm y]; linarith
      _ ≤ (2 * Real.sqrt (m + 2) * c₀ + 4 * Real.sqrt P + 1) / r * dist x y := by
        rw [div_mul_eq_mul_div, le_div_iff₀ hr]
        nlinarith


/-- Mollification by an even `C¹` kernel `η` with compact support commutes with `D` and is
self-adjoint: `∫ D(η * u)(x)(s x) dx = −∫ u div(η * s)` for integrable `u`, `s` (Simon Ch. 2,
Lemma 2.5).  Both derivatives are convolutions with the odd, bounded `Dη`, and Fubini applies to
`Dη(x − z)(s x) u(z)`, which is dominated by `C ‖s x‖ |u z|`. -/
theorem codim1_rdo_dg_sp_mollifier_adjoint : ∀ (P : ℕ) (η u : Euclid P → ℝ) (s : Euclid P → Euclid P), ContDiff ℝ 1 η → HasCompactSupport η → (∀ z, η (-z) = η z) → Integrable u → Integrable s → ∫ x, fderiv ℝ (convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume) x (s x) = -∫ z, u z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ (convolution η s (ContinuousLinearMap.lsmul ℝ ℝ) volume) z : Euclid P →ₗ[ℝ] Euclid P) := by
  intro P η u s hη hηc heven hu hs
  -- Step 0: `Dη` is continuous with compact support, hence bounded by some `C`.
  have hDc : Continuous (fderiv ℝ η) := hη.continuous_fderiv one_ne_zero
  have hDcs : HasCompactSupport (fderiv ℝ η) := hηc.fderiv ℝ
  obtain ⟨C, hC⟩ := hDc.bounded_above_of_compact_support hDcs
  -- Step 1: `η` is even, so `Dη` is odd (chain rule for `η = η ∘ (−id)`).
  have hodd : ∀ y, fderiv ℝ η (-y) = -fderiv ℝ η y := by
    intro y
    have h1 : HasFDerivAt (η ∘ fun z => -z)
        ((fderiv ℝ η (-y)).comp (-ContinuousLinearMap.id ℝ (Euclid P))) y :=
      ((hη.differentiable one_ne_zero) (-y)).hasFDerivAt.comp y (hasFDerivAt_id y).neg
    rw [show (η ∘ fun z => -z) = η from funext heven] at h1
    ext v
    rw [h1.fderiv]
    simp
  -- Step 2: `D(η * u)(x) = (Dη * u)(x)`, so `D(η * u)(x)(s x) = ∫ Dη(x − z)(s x) u(z) dz`.
  have hLHS : ∀ x, fderiv ℝ (convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume) x (s x) =
      ∫ z, fderiv ℝ η (x - z) (s x) * u z := by
    intro x
    rw [(hηc.hasFDerivAt_convolution_left _ hη hu.locallyIntegrable x).fderiv, convolution_eq_swap,
      ContinuousLinearMap.integral_apply
        ((hDcs.convolutionExists_left _ hDc hu.locallyIntegrable x).integrable_swap)]
    simp
  -- Step 3: `div(η * s)(z) = trace D(η * s)(z) = ∫ Dη(z − x)(s x) dx`: the trace `T` is a
  -- continuous linear functional, and the trace of the rank-one map `v ↦ a(v) w` is `a(w)`.
  have hRHS : ∀ z, LinearMap.trace ℝ (Euclid P)
      (fderiv ℝ (convolution η s (ContinuousLinearMap.lsmul ℝ ℝ) volume) z :
        Euclid P →ₗ[ℝ] Euclid P) = ∫ x, fderiv ℝ η (z - x) (s x) := by
    let T : (Euclid P →L[ℝ] Euclid P) →L[ℝ] ℝ := LinearMap.toContinuousLinearMap
      (LinearMap.trace ℝ (Euclid P) ∘ₗ ContinuousLinearMap.coeLM ℝ)
    have hTA : ∀ A : Euclid P →L[ℝ] Euclid P,
        T A = LinearMap.trace ℝ (Euclid P) (A : Euclid P →ₗ[ℝ] Euclid P) := fun A => rfl
    have hrk : ∀ (a : Euclid P →L[ℝ] ℝ) (w : Euclid P), T (ContinuousLinearMap.precompL (Euclid P)
        (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] Euclid P →L[ℝ] Euclid P) a w) = a w := by
      intro a w
      have h : ((ContinuousLinearMap.precompL (Euclid P)
          (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] Euclid P →L[ℝ] Euclid P) a w :
            Euclid P →L[ℝ] Euclid P) : Euclid P →ₗ[ℝ] Euclid P) =
          (a : Euclid P →ₗ[ℝ] ℝ).smulRight w := by
        ext v
        simp
      rw [hTA, h, LinearMap.trace_smulRight]
      rfl
    intro z
    rw [(hηc.hasFDerivAt_convolution_left _ hη hs.locallyIntegrable z).fderiv, convolution_eq_swap]
    have hT := ContinuousLinearMap.integral_comp_comm T
      ((hDcs.convolutionExists_left (ContinuousLinearMap.precompL (Euclid P)
        (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] Euclid P →L[ℝ] Euclid P)) hDc
          hs.locallyIntegrable z).integrable_swap)
    simp_rw [hrk] at hT
    exact hT.symm
  -- Step 4: Fubini for `H(x, z) = Dη(x − z)(s x) u(z)`, dominated by `C ‖s x‖ |u z|`.
  have hint : Integrable (uncurry fun x z => fderiv ℝ η (x - z) (s x) * u z)
      ((volume : Measure (Euclid P)).prod volume) := by
    refine Integrable.mono' ((hs.norm.mul_prod hu.norm).const_mul C) ?_ (Eventually.of_forall ?_)
    · exact ((ContinuousLinearMap.apply ℝ ℝ).aestronglyMeasurable_comp₂
        hs.aestronglyMeasurable.comp_fst
        (hDc.comp (continuous_fst.sub continuous_snd)).aestronglyMeasurable).mul
        hu.aestronglyMeasurable.comp_snd
    · rintro ⟨x, z⟩
      simp only [uncurry_apply_pair, norm_mul]
      calc ‖fderiv ℝ η (x - z) (s x)‖ * ‖u z‖ ≤ (C * ‖s x‖) * ‖u z‖ := by
            gcongr
            exact ((fderiv ℝ η (x - z)).le_opNorm (s x)).trans (by gcongr; exact hC _)
        _ = C * (‖s x‖ * ‖u z‖) := by ring
  -- Step 5: combine, using `Dη(z − x) = −Dη(x − z)` to identify the swapped integral.
  calc ∫ x, fderiv ℝ (convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume) x (s x)
      = ∫ x, ∫ z, fderiv ℝ η (x - z) (s x) * u z := by simp_rw [hLHS]
    _ = ∫ z, ∫ x, fderiv ℝ η (x - z) (s x) * u z := integral_integral_swap hint
    _ = -∫ z, u z * LinearMap.trace ℝ (Euclid P)
          (fderiv ℝ (convolution η s (ContinuousLinearMap.lsmul ℝ ℝ) volume) z :
            Euclid P →ₗ[ℝ] Euclid P) := by
      rw [← integral_neg]
      congr 1
      funext z
      rw [hRHS z, ← integral_const_mul, ← integral_neg]
      congr 1
      funext x
      rw [← neg_sub x z, hodd, neg_apply]
      ring
/-- Smoothing a unit field `s` supported in `Q_δ` by a nonnegative normalized `C^∞` kernel `ρ` of
radius `σ < δ` gives an admissible test field for `Q₁` (Simon Ch. 2, proof of Lemma 2.5): `ρ ⋆ s`
is `C^∞` (differentiation under the integral), `|ρ ⋆ s| ≤ ∫ ρ = 1`, and
`spt (ρ ⋆ s) ⊆ Q_δ + B_σ(0)` lies in the compact box `{δ − σ ≤ yᵢ ≤ 1 − δ + σ} ⊆ Q₁`. -/
theorem dimred_mbl_dt_cbm_sa_smoothed_field : ∀ (m : ℕ) (δ σ : ℝ) (ρ : Euclid (m + 1) → ℝ) (s : Euclid (m + 1) → Euclid (m + 1)), 0 < σ → σ < δ → ContDiff ℝ (⊤ : ℕ∞) ρ → (∀ z, 0 ≤ ρ z) → ∫ z, ρ z = 1 → support ρ ⊆ ball (0 : Euclid (m + 1)) σ → AEStronglyMeasurable s volume → (∀ x, ‖s x‖ ≤ 1) → (∀ x, x ∉ {z : Euclid (m + 1) | ∀ i, δ < z i ∧ z i < 1 - δ} → s x = 0) → ContDiff ℝ (⊤ : ℕ∞) (convolution ρ s (ContinuousLinearMap.lsmul ℝ ℝ) volume) ∧ HasCompactSupport (convolution ρ s (ContinuousLinearMap.lsmul ℝ ℝ) volume) ∧ tsupport (convolution ρ s (ContinuousLinearMap.lsmul ℝ ℝ) volume) ⊆ {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} ∧ ∀ y, ‖convolution ρ s (ContinuousLinearMap.lsmul ℝ ℝ) volume y‖ ≤ 1 := by
  intro m δ σ ρ s hσ hσδ hρs hρnn hρint hρsupp hs hs1 hs0
  set G : Euclid (m + 1) → Euclid (m + 1) := convolution ρ s (ContinuousLinearMap.lsmul ℝ ℝ) volume
    with hG_def
  -- Step 1: `ρ` vanishes off `B̄_σ(0)`, so it has compact support; `∫ ρ = 1 ≠ 0`, so it is
  -- integrable.
  have hρc : HasCompactSupport ρ := by
    refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid (m + 1)) σ) fun x hx => ?_
    by_contra h
    exact hx (ball_subset_closedBall (hρsupp h))
  have hρi : Integrable ρ := integrable_of_integral_eq_one hρint
  -- Step 2: `s` is a.e.-strongly measurable and bounded by `1`, hence locally integrable.
  have hsloc : LocallyIntegrable s volume := by
    rw [locallyIntegrable_iff]
    intro K hK
    exact Measure.integrableOn_of_bounded hK.measure_lt_top.ne hs
      (Eventually.of_forall hs1) (M := 1)
  -- Step 3: `G = ρ ⋆ s` is `C^∞` by differentiation under the integral sign.
  have hG : ContDiff ℝ (⊤ : ℕ∞) G := hρc.contDiff_convolution_left _ hρs hsloc
  -- Step 4: `|G y| ≤ ∫ ρ(t) |s(y − t)| dt ≤ ∫ ρ = 1`.
  have hGle : ∀ y, ‖G y‖ ≤ 1 := by
    intro y
    rw [hG_def, convolution_def, ← hρint]
    refine norm_integral_le_of_norm_le hρi (Eventually.of_forall fun t => ?_)
    rw [ContinuousLinearMap.lsmul_apply, norm_smul, Real.norm_of_nonneg (hρnn t)]
    exact mul_le_of_le_one_right (hρnn t) (hs1 _)
  -- Step 5: `support G ⊆ support s + support ρ ⊆ Q_δ + B_σ(0) ⊆ P`, using `|tᵢ| ≤ |t|`.
  set P : Set (Euclid (m + 1)) := {y | ∀ i, δ - σ ≤ y i ∧ y i ≤ 1 - δ + σ}
  have hsuppG : support G ⊆ P := by
    intro y hy
    obtain ⟨a, ha, t, ht, rfl⟩ := support_convolution_subset_swap _ hy
    have haQ : ∀ i, δ < a i ∧ a i < 1 - δ := by
      by_contra h
      exact ha (hs0 a h)
    have htn : ‖t‖ < σ := by simpa using hρsupp ht
    intro i
    have hti : |t i| < σ := by
      have := PiLp.norm_apply_le t i
      rw [Real.norm_eq_abs] at this
      linarith
    obtain ⟨ha1, ha2⟩ := haQ i
    obtain ⟨ht1, ht2⟩ := abs_lt.1 hti
    simp only [PiLp.add_apply]
    constructor <;> linarith
  -- Step 6: `P` is closed and, as `0 < σ < δ`, lies in `Q₁ ⊆ B̄_{√(m+1)}(0)`; so it is compact.
  have hPclosed : IsClosed P := by
    have : P = ⋂ i, ({y : Euclid (m + 1) | δ - σ ≤ y i} ∩
        {y : Euclid (m + 1) | y i ≤ 1 - δ + σ}) := by
      ext y; simp [P]
    rw [this]
    exact isClosed_iInter fun i => (isClosed_le continuous_const (by fun_prop)).inter
      (isClosed_le (by fun_prop) continuous_const)
  have hPQ1 : P ⊆ {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} := by
    intro y hy i
    obtain ⟨h1, h2⟩ := hy i
    exact ⟨by linarith, by linarith⟩
  have hQ1bdd : {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} ⊆
      closedBall (0 : Euclid (m + 1)) (Real.sqrt (m + 1)) := by
    intro y hy
    rw [mem_closedBall, dist_zero_right, EuclideanSpace.norm_eq]
    apply Real.sqrt_le_sqrt
    calc ∑ i, ‖y i‖ ^ 2 ≤ ∑ _i : Fin (m + 1), (1 : ℝ) := Finset.sum_le_sum fun i _ => by
            obtain ⟨h0, h1⟩ := hy i
            rw [Real.norm_eq_abs, sq_abs]; nlinarith
      _ = m + 1 := by simp
  have hPcompact : IsCompact P :=
    isCompact_of_isClosed_isBounded hPclosed (isBounded_closedBall.subset (hPQ1.trans hQ1bdd))
  -- Step 7: `tsupport G = closure (support G) ⊆ P`, so it is compact and lies in `Q₁`.
  have htsupp : tsupport G ⊆ P := closure_minimal hsuppG hPclosed
  exact ⟨hG, hPcompact.of_isClosed_subset (isClosed_tsupport G) htsupp, htsupp.trans hPQ1, hGle⟩

/-- **Vanishing on compact null sets from an `ε + C ∫ a` bound** (steps 5(i) and 6 of the
top-dimensional null-set argument): let `q : X → ℝⁿ` be measurable and `h ∈ L¹(ν)` (`ν` need not
be finite), and suppose that for every `ε > 0` there is `C` with `|∫ h · a(q) dν| ≤ ε + C ∫ a`
for all smooth compactly supported `0 ≤ a ≤ 1`.  Then `∫_{q⁻¹K} h dν = 0` for every compact
Lebesgue-null `K ⊆ ℝⁿ`.  Along the cut-offs `a_k` of `K` given by
`Submission.cmr_tdn_null_set_cutoffs`, dominated convergence (majorant `|h|`) gives
`∫ h · a_k(q) dν → ∫_{q⁻¹K} h dν`, while `ε + C ∫ a_k → ε`; so `|∫_{q⁻¹K} h dν| ≤ ε` for every
`ε > 0`. -/
theorem Submission.cmr_tdn_null_of_average_bound : ∀ (n : ℕ) (X : Type) [MeasurableSpace X] (ν : Measure X) (q : X → Euclid n) (h : X → ℝ), Measurable q → Integrable h ν → (∀ ε : ℝ, 0 < ε → ∃ C : ℝ, ∀ a : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) a → HasCompactSupport a → (∀ y, 0 ≤ a y) → (∀ y, a y ≤ 1) → |∫ x, h x * a (q x) ∂ν| ≤ ε + C * ∫ y, a y) → ∀ K : Set (Euclid n), IsCompact K → volume K = 0 → ∫ x in q ⁻¹' K, h x ∂ν = 0 := by
  intro n X _ ν q h hq hh hbd K hK hK0
  -- smooth cut-offs `a k` of `K`: `a k = 1` on `K`, `a k → 0` pointwise off `K`, `∫ a k → 0`
  obtain ⟨a, ha, hac, ha0, ha1, haK, haoff, haint⟩ :=
    Submission.cmr_tdn_null_set_cutoffs n K hK hK0
  -- dominated convergence with majorant `|h|`: `∫ h (a k ∘ q) dν → ∫ 1_{q⁻¹K} h dν`
  have hE : MeasurableSet (q ⁻¹' K) := hq hK.isClosed.measurableSet
  have hlim : Tendsto (fun k => ∫ x, h x * a k (q x) ∂ν) atTop
      (𝓝 (∫ x in q ⁻¹' K, h x ∂ν)) := by
    rw [← integral_indicator hE]
    refine tendsto_integral_of_dominated_convergence (fun x => |h x|)
      (fun k => hh.aestronglyMeasurable.mul
        ((ha k).continuous.measurable.comp hq).aestronglyMeasurable)
      hh.abs (fun k => Eventually.of_forall fun x => ?_) (Eventually.of_forall fun x => ?_)
    · rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (ha0 k (q x))]
      exact mul_le_of_le_one_right (abs_nonneg _) (ha1 k (q x))
    · by_cases hx : q x ∈ K
      · have h1 : ∀ k, a k (q x) = 1 := fun k => haK k (q x) hx
        simp only [indicator_of_mem (show x ∈ q ⁻¹' K from hx), h1, mul_one]
        exact tendsto_const_nhds
      · rw [indicator_of_notMem (show x ∉ q ⁻¹' K from hx)]
        refine tendsto_nhds_of_eventually_eq ?_
        filter_upwards [haoff (q x) hx] with k hk
        rw [hk, mul_zero]
  -- for `ε > 0`: `|∫ h (a k ∘ q) dν| ≤ ε + C ∫ a k → ε`, so `|∫_{q⁻¹K} h dν| ≤ ε`
  refine abs_nonpos_iff.1 (le_of_forall_pos_le_add fun ε hε => ?_)
  obtain ⟨C, hC⟩ := hbd ε hε
  have hR : Tendsto (fun k => ε + C * ∫ y, a k y) atTop (𝓝 (ε + C * 0)) :=
    tendsto_const_nhds.add (haint.const_mul C)
  rw [mul_zero, add_zero] at hR
  rw [zero_add]
  exact le_of_tendsto_of_tendsto' hlim.abs hR fun k => hC (a k) (ha k) (hac k) (ha0 k) (ha1 k)

/-- **Compact Lebesgue-null sets are `q_#(h ν)`-null under a divergence bound** (Lemma TD of the
parent proof, for the finite signed measure `m = q_#(h ν)`): if `|∫ h · div g(q) dν| ≤ Λ` for all
smooth compactly supported fields `g` with `‖g‖ ≤ 1`, then `∫_{q⁻¹K} h dν = 0` for every compact
Lebesgue-null `K ⊆ ℝⁿ`.  The field `g = 0` gives `Λ ≥ 0`, and
`Submission.cmr_tdn_directional_bound` gives `|∫ h (a(q + z) − a(q)) dν| ≤ Λ‖z‖` for smooth
compactly supported `|a| ≤ 1`.  Given `ε > 0`, take `r = ε / (Λ + 1)`, so that `rΛ ≤ ε`; averaging
over `B_r(0)` (`Submission.cmr_tdn_ball_average_bound`) gives
`|∫ h · a(q) dν| ≤ ε + λ(B_r)⁻¹ ‖h‖₁ ∫ a` for smooth compactly supported `0 ≤ a ≤ 1`, and
`Submission.cmr_tdn_null_of_average_bound` turns these bounds into the claim. -/
theorem Submission.dimred_mbl_fnd_null_of_div_bound : ∀ (n : ℕ) (X : Type) [MeasurableSpace X] (ν : Measure X) (q : X → Euclid n) (h : X → ℝ) (Λ : ℝ), IsFiniteMeasure ν → Measurable q → Integrable h ν → (∀ g : Euclid n → Euclid n, ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → (∀ y, ‖g y‖ ≤ 1) → |∫ x, h x * LinearMap.trace ℝ (Euclid n) (fderiv ℝ g (q x)).toLinearMap ∂ν| ≤ Λ) → ∀ K : Set (Euclid n), IsCompact K → volume K = 0 → ∫ x in q ⁻¹' K, h x ∂ν = 0 := by
  intro n X _ ν q h Λ hν hq hh hdiv
  -- step 1: `Λ ≥ 0`, testing with the field `g = 0`
  have hΛ : 0 ≤ Λ := by
    simpa using hdiv (fun _ => 0) contDiff_const HasCompactSupport.zero fun _ => by simp
  -- step 2: `|∫ h (a(q + z) − a(q)) dν| ≤ Λ‖z‖` for smooth compactly supported `|a| ≤ 1`
  have hdir := Submission.cmr_tdn_directional_bound n X ν q h Λ hν hq hh hdiv
  -- steps 3–6: an `ε + C ∫ a` bound for every `ε > 0` suffices
  refine Submission.cmr_tdn_null_of_average_bound n X ν q h hq hh fun ε hε => ?_
  -- average over `B_r(0)` with `r = ε / (Λ + 1)`, so that `rΛ ≤ ε`
  obtain ⟨r, hr, hrΛ⟩ : ∃ r : ℝ, 0 < r ∧ r * Λ ≤ ε := by
    refine ⟨ε / (Λ + 1), div_pos hε (by linarith), ?_⟩
    rw [div_mul_eq_mul_div, div_le_iff₀ (by linarith)]
    nlinarith
  refine ⟨(volume (ball (0 : Euclid n) r)).toReal⁻¹ * ∫ x, |h x| ∂ν, fun a ha hac ha0 ha1 => ?_⟩
  have hB := Submission.cmr_tdn_ball_average_bound n X ν q h Λ a r hν hq hh hΛ ha.continuous hac
    ha0 ha1 (hdir a ha hac fun y => abs_le.2 ⟨by linarith [ha0 y], ha1 y⟩) hr
  linarith

/-- **Divergence form of `d(b · θ(G, ·))` with bounds uniform in `g`** (the form identity of
step 9 of the representation of currents of locally finite mass, used for the absolute continuity
in Simon 6.2.36).  Let `θ = dx^I` be the `(m+1)`-covector `θ(v) = det (v j (I k))_{k,j}` on `ℝᴾ`,
`p x = (x (I k))_k`, and `ι` a continuous linear right inverse of `p`.  For smooth `g` with
`‖g‖ ≤ 1` put `G = ι ∘ g ∘ p`, `η(x) = b(x) θ(G x, ·)` and `ζ(x) = Db(x) ∧ θ(G x, ·)`, i.e.
`ζ(x)(w) = Σᵢ (-1)ⁱ Db(x)(wᵢ) θ(G x, ŵᵢ)`.  Both are smooth; `η` vanishes where `b` does and `ζ`
where `Db` does, so both are test forms supported in `tsupport b`.  By
`Submission.cmr_df_extDeriv_smul_curryLeft`, `dη(x)(w) = ζ(x)(w) + b(x) Σᵢ (-1)ⁱ θ(DG(x)wᵢ, ŵᵢ)`,
and since `(DG(x)v)(I k) = (Dg(p x)(p v))_k`, `Submission.cmr_df_cons_sum_trace` turns the sum into
`tr(Dg(p x)) θ(w)`.  Finally `‖G x‖ ≤ ‖ι‖` gives `‖η(x)‖ ≤ sup|b| ‖θ‖ ‖ι‖` and
`‖ζ(x)‖ ≤ (m+1) sup‖Db‖ ‖θ‖ ‖ι‖`, and the Euclidean coefficient norm is at most a constant times
the operator norm (`Submission.rsd_mw_tfa_norm_props`), so `K` does not depend on `g`. -/
theorem Submission.dimred_mbl_fnd_coordinate_divergence_form : ∀ (P m : ℕ) (I : Fin (m + 1) → Fin P) (θ : Covector (Euclid P) (m + 1)) (b : Euclid P → ℝ), StrictMono I → (∀ v : Fin (m + 1) → Euclid P, θ v = Matrix.det (Matrix.of fun k j => v j (I k))) → ContDiff ℝ (⊤ : ℕ∞) b → HasCompactSupport b → ∃ K : ℝ, ∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) g → (∀ y, ‖g y‖ ≤ 1) → ∃ (η : DifferentialForm (Euclid P) m) (ζ : DifferentialForm (Euclid P) (m + 1)), IsTestForm η ∧ IsTestForm ζ ∧ tsupport η ⊆ tsupport b ∧ tsupport ζ ⊆ tsupport b ∧ (∀ x, covectorEuclideanNorm (η x) ≤ K) ∧ (∀ x, covectorEuclideanNorm (ζ x) ≤ K) ∧ ∀ x, exteriorDerivative η x = (b x * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g (WithLp.toLp 2 (fun k => x (I k)))).toLinearMap) • θ + ζ x := by
  intro P m I θ b hI hθ hb hbc
  -- Step 0: the coordinate projection `p` and a continuous linear right inverse `ι` of it
  obtain ⟨p, hp⟩ : ∃ p : Euclid P →L[ℝ] Euclid (m + 1),
      ∀ x, p x = WithLp.toLp 2 (fun k => x (I k)) :=
    ⟨LinearMap.toContinuousLinearMap
      { toFun := fun x => WithLp.toLp 2 (fun k => x (I k))
        map_add' := fun x y => rfl
        map_smul' := fun c x => rfl }, fun x => rfl⟩
  obtain ⟨ι, hι⟩ : ∃ ι : Euclid (m + 1) →L[ℝ] Euclid P, ∀ y k, ι y (I k) = y k := by
    refine ⟨∑ k : Fin (m + 1),
      (EuclideanSpace.proj k : Euclid (m + 1) →L[ℝ] ℝ).smulRight
        (EuclideanSpace.single (I k) (1 : ℝ)), fun y k => ?_⟩
    simp [Pi.single_apply, hI.injective.eq_iff]
  -- Step 1: `β₀ = sup |b|`, `β₁ = sup ‖Db‖`, and the norm comparison constants `C₀`, `C₁`
  obtain ⟨β₀, hβ₀⟩ := hb.continuous.bounded_above_of_compact_support hbc
  obtain ⟨β₁, hβ₁⟩ :=
    (hb.continuous_fderiv (by simp)).bounded_above_of_compact_support (hbc.fderiv ℝ)
  obtain ⟨C₀, hC₀, hC₀le⟩ := (Submission.rsd_mw_tfa_norm_props P m).2.2.1
  obtain ⟨C₁, hC₁, hC₁le⟩ := (Submission.rsd_mw_tfa_norm_props P (m + 1)).2.2.1
  have hβ₀0 : 0 ≤ β₀ := (norm_nonneg _).trans (hβ₀ 0)
  have hβ₁0 : 0 ≤ β₁ := (norm_nonneg _).trans (hβ₁ 0)
  have hR0 : 0 ≤ ‖θ‖ * ‖ι‖ := mul_nonneg (norm_nonneg _) (norm_nonneg _)
  refine ⟨C₀ * (β₀ * (‖θ‖ * ‖ι‖)) + C₁ * ((m + 1) * (β₁ * (‖θ‖ * ‖ι‖))), fun g hg hg1 => ?_⟩
  -- Step 2: the vector field `G = ι ∘ g ∘ p`, with `‖θ(G x, ·)‖ ≤ ‖θ‖ ‖ι‖`
  set G : Euclid P → Euclid P := fun x => ι (g (p x))
  have hGs : ContDiff ℝ (⊤ : ℕ∞) G := ι.contDiff.comp (hg.comp p.contDiff)
  have hcb : ∀ x, ‖ContinuousAlternatingMap.curryLeft θ (G x)‖ ≤ ‖θ‖ * ‖ι‖ := fun x => by
    calc _ ≤ ‖ContinuousAlternatingMap.curryLeft θ‖ * ‖G x‖ := ContinuousLinearMap.le_opNorm _ _
      _ ≤ ‖θ‖ * ‖ι‖ := by
        rw [ContinuousAlternatingMap.norm_curryLeft]
        gcongr
        exact (ι.le_opNorm _).trans (mul_le_of_le_one_right (norm_nonneg _) (hg1 _))
  -- Step 3: `ζ(x) = Db(x) ∧ θ(G x, ·)`, which vanishes where `Db` does
  let ζ : DifferentialForm (Euclid P) (m + 1) := fun x =>
    ContinuousAlternatingMap.alternatizeUncurryFin
      ((fderiv ℝ b x).smulRight (ContinuousAlternatingMap.curryLeft θ (G x)))
  have hζsupp : support ζ ⊆ support (fderiv ℝ b) := fun x hx => by
    rw [Function.mem_support] at hx ⊢
    intro h0
    apply hx
    simp only [ζ, h0, ContinuousLinearMap.zero_smulRight]
    exact map_zero (ContinuousAlternatingMap.alternatizeUncurryFinCLM ℝ (Euclid P) ℝ)
  refine ⟨fun y => b y • ContinuousAlternatingMap.curryLeft θ (G y), ζ, ⟨?_, ?_⟩, ⟨?_, ?_⟩,
    tsupport_smul_subset_left _ _, (closure_mono hζsupp).trans (tsupport_fderiv_subset ℝ),
    fun x => ?_, fun x => ?_, fun x => ?_⟩
  -- Step 4: `η` and `ζ` are smooth with compact support
  · exact hb.smul ((ContinuousAlternatingMap.curryLeft θ).contDiff.comp hGs)
  · exact hbc.smul_right
  · exact (ContinuousAlternatingMap.alternatizeUncurryFinCLM ℝ (Euclid P) ℝ).contDiff.comp
      ((contDiff_infty_iff_fderiv.1 hb).2.smulRight
        ((ContinuousAlternatingMap.curryLeft θ).contDiff.comp hGs))
  · exact (hbc.fderiv ℝ).mono hζsupp
  -- Step 5: `|η(x)| ≤ C₀ ‖η(x)‖ ≤ C₀ β₀ ‖θ‖ ‖ι‖` and `|ζ(x)| ≤ C₁ (m+1) β₁ ‖θ‖ ‖ι‖`
  · refine (hC₀le _).trans (le_add_of_le_of_nonneg ?_
      (mul_nonneg hC₁ (mul_nonneg (by positivity) (mul_nonneg hβ₁0 hR0))))
    gcongr
    rw [norm_smul]
    exact mul_le_mul (hβ₀ x) (hcb x) (norm_nonneg _) hβ₀0
  · refine (hC₁le _).trans (le_add_of_nonneg_of_le
      (mul_nonneg hC₀ (mul_nonneg hβ₀0 hR0)) ?_)
    gcongr
    refine (ContinuousAlternatingMap.norm_alternatizeUncurryFin_le _).trans ?_
    gcongr
    rw [ContinuousLinearMap.norm_smulRight_apply]
    exact mul_le_mul (hβ₁ x) (hcb x) (norm_nonneg _) hβ₁0
  -- Step 6: `dη(x) = ζ(x) + b(x) Σᵢ (-1)ⁱ θ(DG(x)wᵢ, ŵᵢ) = ζ(x) + b(x) tr(Dg(p x)) θ`
  · have hbx : DifferentiableAt ℝ b x := (hb.differentiable (by simp)).differentiableAt
    have hgx : HasFDerivAt g (fderiv ℝ g (p x)) (p x) :=
      ((hg.differentiable (by simp)).differentiableAt).hasFDerivAt
    have hGx : HasFDerivAt G (ι.comp ((fderiv ℝ g (p x)).comp p)) x :=
      ι.hasFDerivAt.comp x (hgx.comp x p.hasFDerivAt)
    have hL : ∀ (v : Euclid P) (k : Fin (m + 1)), fderiv ℝ G x v (I k) =
        (fderiv ℝ g (p x)).toLinearMap (WithLp.toLp 2 (fun k' => v (I k'))) k := by
      intro v k
      rw [hGx.fderiv, ← hp v]
      exact hι _ k
    ext w
    have h3 := Submission.cmr_df_extDeriv_smul_curryLeft P m θ b G x hbx
      hGx.differentiableAt w
    have h2 := Submission.cmr_df_cons_sum_trace P m I θ (fderiv ℝ g (p x)).toLinearMap
      (fderiv ℝ G x) hθ hL w
    have hζ : ζ x w = ∑ i : Fin (m + 1),
        (-1 : ℝ) ^ (i : ℕ) * (fderiv ℝ b x (w i) * θ (Fin.cons (G x) (i.removeNth w))) := by
      simp only [ζ, ContinuousAlternatingMap.alternatizeUncurryFin_apply,
        ContinuousLinearMap.smulRight_apply, ContinuousAlternatingMap.smul_apply,
        ContinuousAlternatingMap.curryLeft_apply_apply, smul_eq_mul, zsmul_eq_mul]
      push_cast
      rfl
    rw [h3, ← hp x, ContinuousAlternatingMap.add_apply, ContinuousAlternatingMap.smul_apply,
      smul_eq_mul, hζ, mul_assoc, ← h2, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    ring

/-- **Simon 6.2.36** (`μ_T` charges no `Hⁿ`-null set when `M_W(∂T) < ∞` for `W ⊂⊂ U`): if
`T(ω) = ∫ ⟨ω, ξ⟩ dμ` with `|⟨α, ξ⟩| ≤ |α|`, `M_W(T) = μ(W)` and `μ` lives on `U`, then
`Hⁿ(E) = 0` implies `μ(E) = 0`.  For `n = 0`, `H⁰` is counting measure, so `E = ∅`.  For
`n = m + 1` it suffices to treat a compact `Hⁿ`-null `C ⊆ U`; take an open `W ⊂⊂ U` around `C`.
For each strictly increasing `I`, the coordinate projection `q_I` maps `C` onto a compact
Lebesgue-null `N ⊆ ℝⁿ`, and the coordinate divergence forms give
`|∫ b ⟨θ_I, ξ⟩ div g(q_I) dμ⌞W| ≤ K_b (M_W(∂T) + M_W(T))` uniformly in `‖g‖ ≤ 1`.  Hence
`⟨θ_I, ξ⟩ = 0` `μ`-a.e. on `W ∩ q_I⁻¹(N) ⊇ C`; the coordinate covectors `θ_I` determine `ξ`, so
`ξ = 0` `μ`-a.e. on `C`, and `M_W(T) = μ(W)` forces `μ(C) = 0`. -/
theorem Submission.dimred_mbl_fnd_null_of_representation : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → μ Uᶜ = 0 → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) → AEStronglyMeasurable ξ μ → (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0 := by
  intro P n U T μ ξ hU hB hUc hK hmass hξm hξ hT
  -- Step 9: it suffices to treat compact `Hⁿ`-null subsets of `U`
  refine Submission.cmr_null_of_compact_null P U μ μHE[n] hU hUc hK ?_
  intro C hC hCU hC0
  cases n with
  | zero =>
    -- Step 1: `H⁰` is counting measure, so `C = ∅`
    rw [Measure.euclideanHausdorffMeasure_zero] at hC0
    have hCe : C = ∅ := eq_empty_of_forall_notMem fun x hx => by
      simpa [hC0] using measure_mono (μ := (μH[0] : Measure (Euclid P))) (singleton_subset_iff.2 hx)
    rw [hCe, measure_empty]
  | succ m =>
    -- Step 2: an open `W ⊂⊂ U` around `C`, of finite mass and boundary mass
    obtain ⟨δ, hδ, hδU⟩ := hC.exists_cthickening_subset_open hU hCU
    have hWo : IsOpen (thickening δ C) := isOpen_thickening
    have hCW : C ⊆ thickening δ C := self_subset_thickening hδ C
    have hWcl : closure (thickening δ C) ⊆ cthickening δ C :=
      closure_thickening_subset_cthickening δ C
    have hWc : CompactlyContained (thickening δ C) U :=
      ⟨hC.cthickening.of_isClosed_subset isClosed_closure hWcl, hWcl.trans hδU⟩
    have hWU : thickening δ C ⊆ U := subset_closure.trans hWc.2
    have hμW : μ (thickening δ C) < ∞ :=
      (measure_mono subset_closure).trans_lt (hK _ hWc.1 hWc.2)
    have hTW : T.massOn (thickening δ C) = μ (thickening δ C) := hmass _ hWo
    have hTW' : T.massOn (thickening δ C) ≠ ∞ := by rw [hTW]; exact hμW.ne
    have hbd : T.boundary.massOn (thickening δ C) ≠ ∞ := (hB _ hWo hWc).ne
    -- Steps 3–6: `⟨θ_I, ξ⟩ = 0` `μ`-a.e. on `C` for each coordinate covector `θ_I`
    obtain ⟨hθex, hspan⟩ := Submission.dimred_mbl_fnd_coordinate_covectors_span P (m + 1)
    choose θI hθI using hθex
    have hcoord : ∀ I : Fin (m + 1) → Fin P, StrictMono I →
        ∀ᵐ x ∂μ, x ∈ C → ξ x (θI I) = 0 := by
      intro I hI
      set q : Euclid P → Euclid (m + 1) := fun x => WithLp.toLp 2 (fun k => x (I k))
      have hqc : Continuous q := by fun_prop
      have hN : IsCompact (q '' C) := hC.image hqc
      have hNv : volume (q '' C) = 0 :=
        Submission.cmr_volume_coordProj_image_null P (m + 1) I C hI.injective hC0
      have h := Submission.cmr_ae_zero_of_div_bounds P (m + 1) (thickening δ C) μ
        (fun x => ξ x (θI I)) q (q '' C) (covectorEuclideanNorm (θI I)) hWo hμW
        (hξm.apply_continuousLinearMap _) (fun x => hξ x _) hqc.measurable hN.measurableSet
        (fun ν h Λ hν hh hΛ => Submission.dimred_mbl_fnd_null_of_div_bound (m + 1) (Euclid P) ν q
          h Λ hν hqc.measurable hh hΛ (q '' C) hN hNv) ?_
      · filter_upwards [h] with x hx hxC
        exact hx (hCW hxC) (mem_image_of_mem q hxC)
      · -- Step 4: the divergence bound, uniformly in `g`
        intro b hb hbc hbW
        obtain ⟨K, hKg⟩ :=
          Submission.dimred_mbl_fnd_coordinate_divergence_form P m I (θI I) b hI (hθI I) hb hbc
        refine ⟨K * ((T.boundary.massOn (thickening δ C)).toReal +
          (T.massOn (thickening δ C)).toReal), fun g hg _ hg1 => ?_⟩
        obtain ⟨η, ζ, hη, hζ, hηb, hζb, hηK, hζK, hd⟩ := hKg g hg hg1
        exact Submission.cmr_abs_integral_div_le_mass P m U (thickening δ C) T μ ξ (θI I) b
          (fun x => LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g (q x)).toLinearMap) η ζ K
          hWU hTW' hbd hT (fun k S ω r => Submission.cmr_abs_apply_le_massOn P k U _ S ω r)
          hbW hη hζ hηb hζb hηK hζK hd
    -- Step 7: the coordinate covectors determine `ξ`, so `ξ = 0` `μ`-a.e. on `C`
    have hξC : ∀ᵐ x ∂μ, x ∈ C → ξ x = 0 := by
      have hall : ∀ᵐ x ∂μ, ∀ I : Fin (m + 1) → Fin P, StrictMono I → x ∈ C →
          ξ x (θI I) = 0 := by
        rw [ae_all_iff]
        intro I
        by_cases hI : StrictMono I
        · filter_upwards [hcoord I hI] with x hx _ using hx
        · exact ae_of_all _ fun x h => absurd h hI
      filter_upwards [hall] with x hx hxC
      refine hspan (ξ x) fun I θ hI hθ => ?_
      rw [show θ = θI I from ContinuousAlternatingMap.ext fun v => by rw [hθ, hθI]]
      exact hx I hI hxC
    -- Step 8: `M_W(T) = μ(W)` and `ξ = 0` a.e. on `C` force `μ(C) = 0`
    exact Submission.cmr_measure_null_of_orient_ae_zero P (m + 1) U (thickening δ C) C T μ ξ
      hWo.measurableSet hC.measurableSet hCW hμW hTW hξ hT hξC

/-- **Foundations** (Simon Ch. 6, 2.7–2.8 and 2.35–2.37; Ch. 3, 1.5(2) and 1.6; Ch. 6, 2.6, 2.9
and 3.2(1)).
(REP) A current `T ∈ 𝒟ₙ(U)` with `M_W(T) < ∞` for every open `W ⊂⊂ U` is `T(ω) = ∫ ⟨ω, ξ⟩ dμ`,
where `μ(W) = M_W(T)` for open `W`, `μ(ℝᴾ ∖ U) = 0`, `μ` is finite on compact subsets of `U` and
`|⟨α, ξ(x)⟩| ≤ |α|` (Riesz, 2.7–2.8).  If moreover `M_W(∂T) < ∞` for every open `W ⊂⊂ U`, then
`μ` does not charge `Hⁿ`-null sets (2.36).
(IMC) Tangent locality, restriction, differences and the orientation bound for integer
multiplicity currents.

Proof: the representation `(μ, ξ)` with its six properties is
`dimred_mbl_fnd_exists_massRepresentation_core`; `dimred_mbl_fnd_null_of_representation`,
applied to the same `(μ, ξ)`, gives the absolute continuity; (IMC) is
`cmc_imRep_locality_restrict_sub`. -/
theorem Submission.dimred_mbl_current_foundations : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) ∧ ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) := by
  refine ⟨fun P n U T hU hmass => ?_, Submission.cmc_imRep_locality_restrict_sub⟩
  -- `T = ξ μ` with `μ(W) = M_W(T)` for open `W` (2.7–2.8)
  obtain ⟨μ, ξ, hμU, hμK, hμW, hξ, hξα, hTξ⟩ :=
    Submission.dimred_mbl_fnd_exists_massRepresentation_core P n U T hU hmass
  -- locally finite `M(∂T)`: `μ` vanishes on `Hⁿ`-null sets (2.36)
  exact ⟨μ, ξ, hμU, hμK, hμW, hξ, hξα, hTξ, fun hbd =>
    Submission.dimred_mbl_fnd_null_of_representation P n U T μ ξ hU hbd hμU hμK hμW hξ hξα hTξ⟩

/-- **Restriction of a measure-represented current** (Simon Ch. 6, 2.9:
`T ⌞ A(ω) = ∫_A ⟨ω, T⃗⟩ dμ_T`), for an arbitrary pair `(μ, ξ)` and an arbitrary set `E`: if `μ` is
finite on compact subsets of `U` and `ξ` is `μ`-a.e. strongly measurable with
`|⟨α, ξ(x)⟩| ≤ |α|` (Euclidean coefficient norm) for `μ`-a.e. `x`, then
`ω ↦ ∫_E ⟨ω(x), ξ(x)⟩ dμ(x)` is a current in `U`.  By `rsd_mw_tfa_norm_props`, `|α| ≤ C ‖α‖`.
For `ω` supported in a compact `K ⊆ U` with `‖ω‖ ≤ M`, `cmcs_rc_pairing_integrable_abs_le` then
gives integrability on `μ ⌞ E` and `|∫_E ⟨ω, ξ⟩ dμ| ≤ C M μ(K)`.  The functional is linear
(`integral_add`, `integral_const_mul`), and `cmcs_rc_order_zero_current` turns the order-zero
bound into Simon's sequential continuity. -/
theorem Submission.cmcs_restrict_current : ∀ (P n : ℕ) (U : Set (Euclid P)) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n) (E : Set (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → AEStronglyMeasurable ξ μ → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) n, |ξ x α| ≤ covectorEuclideanNorm α) → ∃ S : GeometricCurrentOn U n, ∀ ω : TestFormOn U n, S ω = ∫ x in E, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ := by
  intro P n U μ ξ E hμK hξm hξb
  -- Step 1: `|α| ≤ C ‖α‖` for every `n`-covector `α`
  obtain ⟨-, -, ⟨C, hC0, hC⟩, -⟩ := Submission.rsd_mw_tfa_norm_props P n
  -- Steps 2 and 4: for `ω` supported in a compact `K ⊆ U` with `‖ω‖ ≤ M`, the pairing is
  -- `μ ⌞ E`-integrable and `|∫_E ⟨ω, ξ⟩ dμ| ≤ C M μ(K)`
  have hpair : ∀ (ω : TestFormOn U n) (K : Set (Euclid P)) (M : ℝ), IsCompact K → K ⊆ U →
      tsupport (ω : DifferentialForm (Euclid P) n) ⊆ K →
      (∀ x, ‖(ω : DifferentialForm (Euclid P) n) x‖ ≤ M) →
      Integrable (fun x => ξ x ((ω : DifferentialForm (Euclid P) n) x)) (μ.restrict E) ∧
        |∫ x in E, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ| ≤ C * M * (μ K).toReal := by
    intro ω K M hK hKU hsupp hM
    exact Submission.cmcs_rc_pairing_integrable_abs_le P n μ ξ E K
      (ω : DifferentialForm (Euclid P) n) (C * M) hξm hξb ω.property.1.1.continuous
      hK.measurableSet (hμK K hK hKU)
      (fun x hx => image_eq_zero_of_notMem_tsupport fun h => hx (hsupp h))
      (fun x => (hC _).trans (mul_le_mul_of_nonneg_left (hM x) hC0))
  -- Step 2: every test form is admissible, with `K = tsupport ω` and `M = sup ‖ω‖ < ∞`
  have hint : ∀ ω : TestFormOn U n,
      Integrable (fun x => ξ x ((ω : DifferentialForm (Euclid P) n) x)) (μ.restrict E) := by
    intro ω
    obtain ⟨M, hM⟩ := ω.property.1.1.continuous.bounded_above_of_compact_support ω.property.1.2
    exact (hpair ω _ M ω.property.1.2 ω.property.2 subset_rfl hM).1
  -- Step 3: `ω ↦ ∫_E ⟨ω, ξ⟩ dμ` is linear
  let L : TestFormOn U n →ₗ[ℝ] ℝ :=
    { toFun := fun ω => ∫ x in E, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ
      map_add' := fun ω₁ ω₂ => by
        simp only [Submodule.coe_add, Pi.add_apply, map_add]
        exact integral_add (hint ω₁) (hint ω₂)
      map_smul' := fun c ω => by
        simp only [Submodule.coe_smul, Pi.smul_apply, map_smul, smul_eq_mul, RingHom.id_apply]
        exact integral_const_mul c _ }
  -- Steps 4 and 5: the order-zero bound with `c_K = C μ(K)` makes `L` a current
  obtain ⟨S, hS⟩ := Submission.cmcs_rc_order_zero_current P n U L fun K hK hKU =>
    ⟨C * (μ K).toReal, fun ω M hsupp hM => by
      calc |L ω| = |∫ x in E, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ| := rfl
        _ ≤ C * M * (μ K).toReal := (hpair ω K M hK hKU hsupp hM).2
        _ = C * (μ K).toReal * M := by ring⟩
  exact ⟨S, hS⟩
/-- **Level splitting of a test form** (a step in the proof of Simon Ch. 6, 4.8,
`spt ⟨T, f, t₊⟩ ⊆ spt T ∩ {f = t}`).  If `tsupport η` misses the level set `{f = t}` of a
continuous `f`, then `η = η₁ + η₂` with test forms `η₁ = χ η` supported in `{f < t}` and
`η₂ = (1 - χ) η` supported in `{t < f}`.  Here `χ` is a smooth Urysohn function equal to `1` on
`K₋ = tsupport η ∩ {f ≤ t}` and to `0` on `K₊ = tsupport η ∩ {t ≤ f}`; these closed sets are
disjoint, with `K₋ ⊆ {f < t}` and `K₊ ⊆ {t < f}`, because `tsupport η` misses `{f = t}`. -/
theorem Submission.cmcs_ss_testForm_level_split : ∀ (P n : ℕ) (U : Set (Euclid P)) (f : Euclid P → ℝ) (t : ℝ) (η : TestFormOn U n), Continuous f → Disjoint (tsupport (η : DifferentialForm (Euclid P) n)) {x | f x = t} → ∃ η₁ η₂ : TestFormOn U n, η = η₁ + η₂ ∧ tsupport (η₁ : DifferentialForm (Euclid P) n) ⊆ {x | f x < t} ∧ tsupport (η₂ : DifferentialForm (Euclid P) n) ⊆ {x | t < f x} := by
  intro P n U f t η hf hη
  obtain ⟨⟨hsmooth, hcpt⟩, hU⟩ := η.property
  set e : DifferentialForm (Euclid P) n := (η : DifferentialForm (Euclid P) n)
  -- the closed halves `K₋ = K ∩ {f ≤ t}` and `K₊ = K ∩ {t ≤ f}` of `K = tsupport η` are
  -- disjoint, since `K` misses `{f = t}`
  have hKl : IsClosed (tsupport e ∩ {x | f x ≤ t}) :=
    (isClosed_tsupport e).inter (isClosed_le hf continuous_const)
  have hKu : IsClosed (tsupport e ∩ {x | t ≤ f x}) :=
    (isClosed_tsupport e).inter (isClosed_le continuous_const hf)
  have hd : Disjoint (tsupport e ∩ {x | t ≤ f x}) (tsupport e ∩ {x | f x ≤ t}) :=
    Set.disjoint_left.2 fun x hxu hxl => Set.disjoint_left.1 hη hxu.1 (le_antisymm hxl.2 hxu.2)
  -- a smooth `χ` with `χ = 0` on `K₊` and `χ = 1` on `K₋`
  obtain ⟨χ, hχ, -, hχ₀, hχ₁⟩ :=
    exists_contDiff_zero_iff_one_iff_of_isClosed (n := (⊤ : ℕ∞)) hKu hKl hd
  -- `χ η` and `(1 - χ) η` are test forms in `U`, with sum `η`
  have h₁ : (fun x => χ x • e x) ∈ TestFormOn U n :=
    ⟨⟨hχ.smul hsmooth, hcpt.smul_left (f := χ)⟩, (tsupport_smul_subset_right χ e).trans hU⟩
  have h₂ : (fun x => (1 - χ x) • e x) ∈ TestFormOn U n :=
    ⟨⟨(contDiff_const.sub hχ).smul hsmooth, hcpt.smul_left (f := fun x => 1 - χ x)⟩,
      (tsupport_smul_subset_right (fun x => 1 - χ x) e).trans hU⟩
  refine ⟨⟨_, h₁⟩, ⟨_, h₂⟩, Subtype.ext (funext fun x => ?_), ?_, ?_⟩
  · change e x = χ x • e x + (1 - χ x) • e x
    rw [← add_smul, add_sub_cancel, one_smul]
  · -- `support (χ η) ⊆ K₋`, a closed subset of `{f < t}`
    have hs : support (fun x => χ x • e x) ⊆ tsupport e ∩ {x | f x ≤ t} := fun x hx => by
      have he : x ∈ tsupport e := subset_tsupport e (right_ne_zero_of_smul hx)
      refine ⟨he, show f x ≤ t from le_of_not_ge fun h => ?_⟩
      exact left_ne_zero_of_smul hx ((hχ₀ x).1 ⟨he, h⟩)
    exact (closure_minimal hs hKl).trans fun x hx =>
      lt_of_le_of_ne hx.2 fun h => Set.disjoint_left.1 hη hx.1 h
  · -- `support ((1 - χ) η) ⊆ K₊`, a closed subset of `{t < f}`
    have hs : support (fun x => (1 - χ x) • e x) ⊆ tsupport e ∩ {x | t ≤ f x} := fun x hx => by
      have he : x ∈ tsupport e := subset_tsupport e (right_ne_zero_of_smul hx)
      refine ⟨he, show t ≤ f x from le_of_not_ge fun h => left_ne_zero_of_smul hx ?_⟩
      rw [(hχ₁ x).1 ⟨he, h⟩, sub_self]
    exact (closure_minimal hs hKu).trans fun x hx =>
      lt_of_le_of_ne hx.2 fun h => Set.disjoint_left.1 hη hx.1 h.symm
/-- Restriction commutes with the boundary on forms supported in the restricting set (Simon 6.4.6,
used for 4.8): let `T(ω) = ∫ ⟨ω, ξ⟩ dμ` and `∂T(θ) = ∫ ⟨θ, ξ'⟩ dμ'`, and let `A = T⌞S`,
`B = (∂T)⌞S` be given by the same integrals over `S`.  Then `∂A(θ) = B(θ)` whenever
`spt θ ⊆ S`.  Off `S` both `θ` and `dθ` vanish (`spt dθ ⊆ spt θ`), so both integrals over `S`
are integrals over `ℝᴾ`, and `∂A(θ) = A(dθ) = T(dθ) = ∂T(θ) = B(θ)`. -/
theorem Submission.cmcs_ss_boundary_eq_of_tsupport_subset : ∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (S : Set (Euclid P)) (A : GeometricCurrentOn U (k + 1)) (B : GeometricCurrentOn U k), (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ θ : TestFormOn U k, T.boundary θ = ∫ x, ξ' x ((θ : DifferentialForm (Euclid P) k) x) ∂μ') → (∀ ω : TestFormOn U (k + 1), A ω = ∫ x in S, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ θ : TestFormOn U k, B θ = ∫ x in S, ξ' x ((θ : DifferentialForm (Euclid P) k) x) ∂μ') → ∀ θ : TestFormOn U k, tsupport (θ : DifferentialForm (Euclid P) k) ⊆ S → A.boundary θ = B θ := by
  intro P k U T μ μ' ξ ξ' S A B hT hbT hA hB θ hθ
  -- `θ` and `dθ` vanish off `S`, as `spt dθ ⊆ spt θ ⊆ S`
  have hθ0 : ∀ x, x ∉ S → (θ : DifferentialForm (Euclid P) k) x = 0 := fun x hx =>
    image_eq_zero_of_notMem_tsupport fun h => hx (hθ h)
  have hdθ0 : ∀ x, x ∉ S → exteriorDerivative (θ : DifferentialForm (Euclid P) k) x = 0 :=
    fun x hx => image_eq_zero_of_notMem_tsupport fun h =>
      hx (hθ (tsupport_exteriorDerivative_subset _ h))
  -- so, `ξ x` and `ξ' x` being linear, both integrals over `S` are integrals over `ℝᴾ`
  have hAT : ∫ x in S, ξ x (exteriorDerivative (θ : DifferentialForm (Euclid P) k) x) ∂μ =
      ∫ x, ξ x (exteriorDerivative (θ : DifferentialForm (Euclid P) k) x) ∂μ :=
    setIntegral_eq_integral_of_forall_compl_eq_zero fun x hx => by rw [hdθ0 x hx, map_zero]
  have hBT : ∫ x in S, ξ' x ((θ : DifferentialForm (Euclid P) k) x) ∂μ' =
      ∫ x, ξ' x ((θ : DifferentialForm (Euclid P) k) x) ∂μ' :=
    setIntegral_eq_integral_of_forall_compl_eq_zero fun x hx => by rw [hθ0 x hx, map_zero]
  -- `∂A(θ) = A(dθ) = ∫_S ⟨dθ, ξ⟩ dμ = ∫ ⟨dθ, ξ⟩ dμ = T(dθ) = ∂T(θ) = ∫ ⟨θ, ξ'⟩ dμ'`
  -- `= ∫_S ⟨θ, ξ'⟩ dμ' = B(θ)`
  calc A.boundary θ = A (exteriorDerivativeTestOn U k θ) := GeometricCurrentOn.boundary_apply A θ
    _ = ∫ x in S, ξ x (exteriorDerivative (θ : DifferentialForm (Euclid P) k) x) ∂μ := hA _
    _ = ∫ x, ξ x (exteriorDerivative (θ : DifferentialForm (Euclid P) k) x) ∂μ := hAT
    _ = T (exteriorDerivativeTestOn U k θ) := (hT (exteriorDerivativeTestOn U k θ)).symm
    _ = T.boundary θ := (GeometricCurrentOn.boundary_apply T θ).symm
    _ = ∫ x, ξ' x ((θ : DifferentialForm (Euclid P) k) x) ∂μ' := hbT θ
    _ = ∫ x in S, ξ' x ((θ : DifferentialForm (Euclid P) k) x) ∂μ' := hBT.symm
    _ = B θ := (hB θ).symm
/-- Simon Ch. 6, 4.6–4.8 (support of the slice `∂(T⌞S) − (∂T)⌞S`, `S = {f < t}`): if
`A(ω) = ∫_S ⟨ω, ξ⟩ dμ` and `B(θ) = ∫_S ⟨θ, ξ'⟩ dμ'`, then `∂A(θ) = A(dθ) = 0` and `B(θ) = 0`
whenever `spt θ` misses `S`, because `θ` and `dθ` (`spt dθ ⊆ spt θ`) vanish on `S`. -/
theorem Submission.cmcs_ss_boundary_vanish_of_disjoint : ∀ (P k : ℕ) (U : Set (Euclid P)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (S : Set (Euclid P)) (A : GeometricCurrentOn U (k + 1)) (B : GeometricCurrentOn U k), (∀ ω : TestFormOn U (k + 1), A ω = ∫ x in S, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ θ : TestFormOn U k, B θ = ∫ x in S, ξ' x ((θ : DifferentialForm (Euclid P) k) x) ∂μ') → ∀ θ : TestFormOn U k, Disjoint (tsupport (θ : DifferentialForm (Euclid P) k)) S → A.boundary θ = 0 ∧ B θ = 0 := by
  intro P k U μ μ' ξ ξ' S A B hA hB θ hθ
  -- `θ` vanishes on `S`, and so does `dθ`, as `tsupport dθ ⊆ tsupport θ`
  have hθS : ∀ x ∈ S, (θ : DifferentialForm (Euclid P) k) x = 0 := fun x hx =>
    image_eq_zero_of_notMem_tsupport (hθ.notMem_of_mem_right hx)
  have hdθS : ∀ x ∈ S, exteriorDerivative (θ : DifferentialForm (Euclid P) k) x = 0 :=
    fun x hx => image_eq_zero_of_notMem_tsupport fun hx' =>
      hθ.notMem_of_mem_right hx (tsupport_exteriorDerivative_subset _ hx')
  refine ⟨?_, ?_⟩
  · -- `∂A(θ) = A(dθ) = ∫_S ⟨dθ, ξ⟩ dμ`
    rw [GeometricCurrentOn.boundary_apply, hA]
    refine setIntegral_eq_zero_of_forall_eq_zero fun x hx => ?_
    change ξ x (exteriorDerivative (θ : DifferentialForm (Euclid P) k) x) = 0
    rw [hdθS x hx, map_zero]
  · rw [hB]
    exact setIntegral_eq_zero_of_forall_eq_zero fun x hx => by rw [hθS x hx, map_zero]

/-- **Simon Ch. 6, 4.8** (support of a slice): if `T = ξ μ` and `∂T = ξ' μ'` in `U`,
`A = T ⌞ {f < t}` and `B = (∂T) ⌞ {f < t}` (`f` continuous), then `∂A(η) = B(η)` for every
`η ∈ 𝒟ᵏ(U)` whose support misses the level set `{f = t}`; i.e. the slice `∂A − B` lives on
`{f = t}`.  Split `η = η₁ + η₂` with `spt η₁ ⊆ {f < t}` and `spt η₂ ⊆ {f > t}`
(`cmcs_ss_testForm_level_split`).  Below the level `∂A(η₁) = ∂T(η₁) = B(η₁)`
(`cmcs_ss_boundary_eq_of_tsupport_subset`); above it `∂A(η₂) = 0 = B(η₂)`
(`cmcs_ss_boundary_vanish_of_disjoint`), as `{f > t}` misses `{f < t}`.  Conclude by linearity
of `∂A` and `B`. -/
theorem Submission.cmcs_slice_support : ∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (t : ℝ) (A : GeometricCurrentOn U (k + 1)) (B : GeometricCurrentOn U k), Continuous f → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ θ : TestFormOn U k, T.boundary θ = ∫ x, ξ' x ((θ : DifferentialForm (Euclid P) k) x) ∂μ') → (∀ ω : TestFormOn U (k + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ θ : TestFormOn U k, B θ = ∫ x in {x | f x < t}, ξ' x ((θ : DifferentialForm (Euclid P) k) x) ∂μ') → ∀ η : TestFormOn U k, Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → A.boundary η = B η := by
  intro P k U T μ μ' ξ ξ' f t A B hf hT hbT hA hB η hη
  -- `η = η₁ + η₂` with `spt η₁ ⊆ {f < t}` and `spt η₂ ⊆ {t < f}`
  obtain ⟨η₁, η₂, rfl, h₁, h₂⟩ := Submission.cmcs_ss_testForm_level_split P k U f t η hf hη
  -- below the level: `∂A(η₁) = ∂T(η₁) = B(η₁)`
  have e₁ : A.boundary η₁ = B η₁ :=
    Submission.cmcs_ss_boundary_eq_of_tsupport_subset P k U T μ μ' ξ ξ' {x | f x < t} A B
      hT hbT hA hB η₁ h₁
  -- above the level: `∂A(η₂) = 0 = B(η₂)`, since `spt η₂ ⊆ {t < f}` misses `{f < t}`
  obtain ⟨e₂, e₂'⟩ := Submission.cmcs_ss_boundary_vanish_of_disjoint P k U μ μ' ξ ξ'
    {x | f x < t} A B hA hB η₂ (Set.disjoint_left.2 fun x hx hx' =>
      lt_asymm (show t < f x from h₂ hx) (show f x < t from hx'))
  -- `∂A` and `B` are linear
  rw [A.boundary.toCurrent.map_add, B.toCurrent.map_add, e₁, e₂, e₂']

/-- **`|β ∧ γ| ≤ ‖β‖ |γ|`** (Simon 6.1.1–1.3 and 1.15): for a linear functional `β` and a
`k`-covector `γ` on `ℝᴾ`, the Euclidean coefficient norm of the `(k+1)`-covector
`β ∧ γ = alternatizeUncurryFin (β.smulRight γ)` is at most `‖β‖ |γ|`.  Take an orthonormal basis
`f` with `β(fᵢ) = ‖β‖ [i = i₀]`; then `(β ∧ γ)(f ∘ j)² ≤ ‖β‖² Σᵢ [j i = i₀] γ(f ∘ i.removeNth j)²`.
Summing over `j`, each `j' : Fin k → Fin P` arises as `i.removeNth j` with `j i = i₀` for exactly
`k + 1` pairs `(i, j)`, so `(k+1)! |β ∧ γ|² ≤ ‖β‖² (k+1) k! |γ|²` by
`regcomp_covector_sq_sum_orthonormalBasis` in degrees `k + 1` and `k`.  For `P = 0` there are no
coordinate tuples and `|β ∧ γ| = 0`. -/
theorem Submission.cmcs_wedge_norm_le : ∀ (P k : ℕ) (β : Euclid P →L[ℝ] ℝ) (γ : Covector (Euclid P) k), covectorEuclideanNorm (ContinuousAlternatingMap.alternatizeUncurryFin (β.smulRight γ)) ≤ ‖β‖ * covectorEuclideanNorm γ := by
  intro P k β γ
  classical
  set ω := ContinuousAlternatingMap.alternatizeUncurryFin (β.smulRight γ)
  have hrhs : 0 ≤ ‖β‖ * covectorEuclideanNorm γ :=
    mul_nonneg (norm_nonneg β) (covectorEuclideanNorm_nonneg γ)
  rcases Nat.eq_zero_or_pos P with hP | hP
  · -- `P = 0`: there is no tuple `Fin (k + 1) → Fin 0`, so `|ω| = 0`
    subst hP
    have h0 : covectorEuclideanNorm ω = 0 := by
      simp [covectorEuclideanNorm]
    rw [h0]
    exact hrhs
  · -- an orthonormal basis `f` with `β(fᵢ) = ‖β‖ [i = i₀]`
    set i₀ : Fin P := ⟨0, hP⟩
    obtain ⟨f, hf⟩ := Submission.cmcs_wn_adapted_orthonormalBasis P β i₀
    -- `ω(f ∘ j)² ≤ ‖β‖² Σᵢ [j i = i₀] γ(f ∘ i.removeNth j)²` for every `j`
    have hle : ∑ j : Fin (k + 1) → Fin P, (ω (fun m => f (j m))) ^ 2 ≤
        ∑ j : Fin (k + 1) → Fin P, ‖β‖ ^ 2 * ∑ i : Fin (k + 1),
          (if j i = i₀ then (γ (fun m => f (i.removeNth j m))) ^ 2 else 0) :=
      Finset.sum_le_sum fun j _ => Submission.cmcs_wn_tuple_sq_le P k β γ f i₀ ‖β‖
        f.orthonormal.linearIndependent.injective hf j
    -- count the fibres of `j ↦ i.removeNth j`, then `Σ_j α(f ∘ j)² = m! |α|²` for `m = k + 1, k`
    rw [← Finset.mul_sum,
      Submission.cmcs_wn_removeNth_fiber_sum k P i₀ (fun j' => (γ (fun m => f (j' m))) ^ 2),
      Submission.regcomp_covector_sq_sum_orthonormalBasis P (k + 1) ω f,
      Submission.regcomp_covector_sq_sum_orthonormalBasis P k γ f] at hle
    -- cancel `(k+1)! = (k+1) k! > 0`
    have hpos : (0 : ℝ) < ((k + 1).factorial : ℝ) := by positivity
    have hsq : covectorEuclideanNorm ω ^ 2 ≤ (‖β‖ * covectorEuclideanNorm γ) ^ 2 := by
      refine le_of_mul_le_mul_left ?_ hpos
      calc ((k + 1).factorial : ℝ) * covectorEuclideanNorm ω ^ 2
          ≤ ‖β‖ ^ 2 * (((k : ℝ) + 1) * ((k.factorial : ℝ) * covectorEuclideanNorm γ ^ 2)) := hle
        _ = ((k + 1).factorial : ℝ) * (‖β‖ * covectorEuclideanNorm γ) ^ 2 := by
          push_cast [Nat.factorial_succ]
          ring
    exact (sq_le_sq₀ (covectorEuclideanNorm_nonneg ω) hrhs).mp hsq

/-- **Simon Ch. 6, 4.11 (p. 158), the estimate of the cutoff defect**, for `T` and `∂T`
represented by `(μ, ξ)` and `(μ', ξ')` with `|⟨α, ξ⟩| ≤ |α|` `μ`-a.e.: for a `C^∞` function `g`
and `η ∈ 𝒟ᵏ(U)`, `|∫ g ⟨dη, ξ⟩ dμ − ∫ g ⟨η, ξ'⟩ dμ'| ≤ ∫ |Dg| |η| dμ` in `[0, ∞]`.  The left side
is `|T(g dη) − ∂T(gη)| = |T(dg ∧ η)| = |∫ ⟨dg ∧ η, ξ⟩ dμ|` (`cmcs_cd_defect_identity`, with
`dg ∧ η = alternatizeUncurryFin (Dg.smulRight η)`), which is at most `∫ |⟨dg ∧ η, ξ⟩| dμ` whether
or not the integrand is integrable; and `|⟨dg ∧ η, ξ⟩| ≤ |dg ∧ η| ≤ |Dg| |η|` `μ`-a.e. by the bound
on `ξ` and `cmcs_wedge_norm_le`. -/
theorem Submission.cmcs_cutoff_defect_bound : ∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (g : Euclid P → ℝ) (η : TestFormOn U k), (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ θ : TestFormOn U k, T.boundary θ = ∫ x, ξ' x ((θ : DifferentialForm (Euclid P) k) x) ∂μ') → ContDiff ℝ (⊤ : ℕ∞) g → ENNReal.ofReal |∫ x, g x * ξ x (exteriorDerivative (η : DifferentialForm (Euclid P) k) x) ∂μ - ∫ x, g x * ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ'| ≤ ∫⁻ x, ENNReal.ofReal (‖fderiv ℝ g x‖ * covectorEuclideanNorm ((η : DifferentialForm (Euclid P) k) x)) ∂μ := by
  intro P k U T μ μ' ξ ξ' g η hξ hT hbT hg
  -- Simon 4.11: `T(g dη) − ∂T(gη) = −T(dg ∧ η) = −∫ ⟨dg ∧ η, ξ⟩ dμ`
  rw [Submission.cmcs_cd_defect_identity P k U T μ μ' ξ ξ' g η hT hbT hg, abs_neg,
    ← Real.enorm_eq_ofReal_abs]
  -- `‖∫ G dμ‖ₑ ≤ ∫⁻ ‖G‖ₑ dμ` for every `G`, integrable or not; then bound `G` `μ`-a.e.
  refine (enorm_integral_le_lintegral_enorm _).trans (lintegral_mono_ae ?_)
  filter_upwards [hξ] with x hx
  -- `|⟨dg ∧ η, ξ⟩| ≤ |dg ∧ η| ≤ |Dg| |η|`
  rw [Real.enorm_eq_ofReal_abs]
  exact ENNReal.ofReal_le_ofReal ((hx _).trans (Submission.cmcs_wedge_norm_le P k _ _))
/-- **Normalized mollifier** (step 2 of the smooth-to-`C¹` test reduction): for `r > 0` there is
a `C^∞` function `ρ ≥ 0` on `ℝⁿ` with compact support in `B_r(0)` and `∫ ρ = 1`.  Take the
`ContDiffBump` `B` centred at `0` with `rIn = r/2`, `rOut = r`, so `support B = B_r(0)`; its
integral `I` is positive since `B ≥ 0` and `volume (B_r(0)) > 0`, and `ρ = I⁻¹ B`.  (Mathlib's
`ContDiffBump.normed` is outside the import closure, so the normalization is done by hand.) -/
theorem Submission.dgcr_stc_exists_normalized_mollifier : ∀ (n : ℕ) (r : ℝ), 0 < r → ∃ ρ : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) ρ ∧ HasCompactSupport ρ ∧ (∀ x, 0 ≤ ρ x) ∧ ∫ x, ρ x = 1 ∧ support ρ ⊆ ball (0 : Euclid n) r := by
  intro n r hr
  -- the bump `B` with `rIn = r/2`, `rOut = r`
  let B : ContDiffBump (0 : Euclid n) := ⟨r / 2, r, half_pos hr, half_lt_self hr⟩
  have hBs : HasCompactSupport B := B.hasCompactSupport
  have hBi : Integrable B := B.continuous.integrable_of_hasCompactSupport hBs
  -- `I = ∫ B > 0`: `B ≥ 0` and `support B = B_r(0)` has positive measure
  have hI : 0 < ∫ x, B x := by
    rw [integral_pos_iff_support_of_nonneg (fun x => B.nonneg' x) hBi, B.support_eq]
    exact measure_ball_pos volume 0 hr
  refine ⟨fun x => (∫ y, B y)⁻¹ * B x, contDiff_const.mul B.contDiff, hBs.mul_left,
    fun x => mul_nonneg (inv_nonneg.2 hI.le) (B.nonneg' x), ?_, ?_⟩
  · rw [integral_const_mul, inv_mul_cancel₀ hI.ne']
  · exact (support_mul_subset_right _ _).trans B.support_eq.subset
/-- **Mollification preserves the Lipschitz constant** (step 4 of the Lipschitz smoothing): if
`ψ ≥ 0` is continuous with compact support and `∫ ψ = 1`, and `g` is `K`-Lipschitz, then
`G x = ∫ ψ(y) g(x - y) dy` is `K`-Lipschitz.  Indeed `G x - G x'` is the integral of
`ψ(y) (g(x - y) - g(x' - y))`, whose absolute value is at most `ψ(y) K ‖x - x'‖`, and
`∫ ψ = 1`. -/
theorem Submission.cmcs_ls_mollify_lipschitz : ∀ (P : ℕ) (ψ g : Euclid P → ℝ) (K : NNReal), Continuous ψ → HasCompactSupport ψ → (∀ x, 0 ≤ ψ x) → ∫ x, ψ x = 1 → LipschitzWith K g → LipschitzWith K (fun x => ∫ y, ψ y * g (x - y)) := by
  intro P ψ g K hψc hψs hψ0 hψ1 hg
  -- step 1: `y ↦ ψ y * g (x - y)` is continuous with support in `support ψ`, hence integrable
  have hint : ∀ x : Euclid P, Integrable (fun y => ψ y * g (x - y)) := fun x =>
    (hψc.mul (hg.continuous.comp (continuous_const.sub continuous_id))).integrable_of_hasCompactSupport
      hψs.mul_right
  -- step 5: it suffices to show `dist (G x) (G x') ≤ K * dist x x'`
  refine LipschitzWith.of_dist_le_mul fun x x' => ?_
  -- step 2: `G x - G x'` is a single integral
  rw [Real.dist_eq, ← integral_sub (hint x) (hint x'), ← Real.norm_eq_abs]
  calc ‖∫ y, (ψ y * g (x - y) - ψ y * g (x' - y))‖
      ≤ ∫ y, ψ y * (K * dist x x') := by
        -- step 4: integrate the pointwise bound of step 3 against the integrable majorant
        refine norm_integral_le_of_norm_le
          ((hψc.integrable_of_hasCompactSupport (μ := volume) hψs).mul_const _)
          (Eventually.of_forall fun y => ?_)
        -- step 3: `|ψ y (g (x - y) - g (x' - y))| = ψ y dist (g (x - y)) (g (x' - y))`
        -- `≤ ψ y (K dist (x - y) (x' - y)) = ψ y (K dist x x')`
        rw [← mul_sub, Real.norm_eq_abs, abs_mul, abs_of_nonneg (hψ0 y), ← Real.dist_eq,
          ← dist_sub_right x x' y]
        exact mul_le_mul_of_nonneg_left (hg.dist_le_mul _ _) (hψ0 y)
    _ = K * dist x x' := by rw [integral_mul_const, hψ1, one_mul]

/-- **Smoothing of Lipschitz functions** (Simon Ch. 6, 4.8–4.9: use `f^{(σ)}` in place of a
Lipschitz `f`): a `K`-Lipschitz `g` on `ℝᴾ` and `σ > 0` give a `C^∞` function `g'` with
`‖Dg'‖ ≤ K`, `|g' − g| ≤ Kσ`, and `g'(x) = c` whenever `g ≡ c` on `B_σ(x)`.  Take the normalized
mollifier `ψ` (`support ψ ⊆ B_σ(0)`) and `g' = ψ ⋆ g`, `g'(x) = ∫ ψ(y) g(x − y) dy`: it is `C^∞`
(`ψ` is smooth with compact support, `g` is continuous) and `K`-Lipschitz, so `‖Dg'‖ ≤ K`.  The
last two claims are `dist_convolution_le` on `B_σ(x)`, with `ε = Kσ`, `z₀ = g(x)` and with
`ε = 0`, `z₀ = c`.  (`ContDiffBump.normed` and its convolution lemmas are outside the import
closure.) -/
theorem Submission.cmcs_lipschitz_smoothing : ∀ (P : ℕ) (g : Euclid P → ℝ) (K : NNReal) (σ : ℝ), LipschitzWith K g → 0 < σ → ∃ g' : Euclid P → ℝ, ContDiff ℝ (⊤ : ℕ∞) g' ∧ (∀ x, ‖fderiv ℝ g' x‖ ≤ K) ∧ (∀ x, |g' x - g x| ≤ K * σ) ∧ ∀ (x : Euclid P) (c : ℝ), (∀ y ∈ ball x σ, g y = c) → g' x = c := by
  intro P g K σ hg hσ
  obtain ⟨ψ, hψd, hψs, hψ0, hψ1, hψb⟩ := Submission.dgcr_stc_exists_normalized_mollifier P σ hσ
  -- `g' = ψ ⋆ g`
  have hconv : (fun x => ∫ y, ψ y * g (x - y)) =
      convolution ψ g (ContinuousLinearMap.lsmul ℝ ℝ) volume := by
    funext x
    simp only [convolution_def, ContinuousLinearMap.lsmul_apply, smul_eq_mul]
  refine ⟨fun x => ∫ y, ψ y * g (x - y), ?_, fun x => ?_, fun x => ?_, fun x c hc => ?_⟩
  · rw [hconv]
    exact hψs.contDiff_convolution_left _ hψd hg.continuous.locallyIntegrable
  · exact norm_fderiv_le_of_lipschitz ℝ
      (Submission.cmcs_ls_mollify_lipschitz P ψ g K hψd.continuous hψs hψ0 hψ1 hg)
  · -- `dist (g y) (g x) ≤ K ‖y − x‖ ≤ Kσ` on `B_σ(x)`
    have h := dist_convolution_le (μ := volume) (x₀ := x) (z₀ := g x)
      (mul_nonneg K.coe_nonneg hσ.le) hψb hψ0 hψ1 hg.continuous.aestronglyMeasurable
      (fun y hy => (hg.dist_le_mul y x).trans
        (mul_le_mul_of_nonneg_left (mem_ball.1 hy).le K.coe_nonneg))
    rwa [← hconv, Real.dist_eq] at h
  · -- `g ≡ c` on `B_σ(x)`, so `dist (g' x) c ≤ 0`
    have h := dist_convolution_le (μ := volume) (x₀ := x) (z₀ := c) le_rfl hψb hψ0 hψ1
      hg.continuous.aestronglyMeasurable (fun y hy => by rw [hc y hy, dist_self])
    rw [← hconv] at h
    exact dist_le_zero.1 h

/-- **Smooth cut-off between two levels of a Lipschitz function** (Simon Ch. 6, proof of 4.9, with
`f^{(σ)}` in place of `f`).  If `f : ℝᴾ → ℝ` is `L`-Lipschitz, `t ∈ ℝ` and `0 < h < 1`, there is a
`C^∞` function `g` with `|g| ≤ 2`, `‖Dg‖ ≤ L/(h(1 − h/2))`, `g = 1` on `{f ≤ t − h}`, `g = 0` on
`{f ≥ t}` and `Dg = 0` off the strip `{t − h < f < t}`.  With `δ = h²/4` and
`w = h − 2δ = h(1 − h/2)`, the clamp `G = max 0 (min 1 ((t − δ − f)/w))` is `(L/w)`-Lipschitz,
`G = 1` on `{f < t − h + δ}` and `G = 0` on `{f > t − δ}`; `g` is its smoothing at scale
`σ = δ/(2(L + 1))` (`cmcs_lipschitz_smoothing`), so `|g − G| ≤ Lσ/w ≤ 1`.  As `2Lσ < δ`, `G` is
constant on `B_{2σ}(x)` when `f x ≤ t − h` or `t ≤ f x`; by locality `g` is then constant on
`B_σ(x)`, so `Dg(x) = 0`. -/
theorem Submission.cmcs_level_cutoff : ∀ (P : ℕ) (f : Euclid P → ℝ) (L : NNReal) (t h : ℝ), LipschitzWith L f → 0 < h → h < 1 → ∃ g : Euclid P → ℝ, ContDiff ℝ (⊤ : ℕ∞) g ∧ (∀ x, |g x| ≤ 2) ∧ (∀ x, ‖fderiv ℝ g x‖ ≤ L / (h * (1 - h / 2))) ∧ (∀ x, fderiv ℝ g x ≠ 0 → t - h < f x ∧ f x < t) ∧ (∀ x, f x ≤ t - h → g x = 1) ∧ (∀ x, t ≤ f x → g x = 0) := by
  intro P f L t h hf h0 h1
  -- parameters `δ = h²/4`, `w = h − 2δ = h(1 − h/2)` and `σ = δ/(2(L + 1))`, so `2Lσ < δ`
  set δ : ℝ := h ^ 2 / 4 with hδ
  set w : ℝ := h * (1 - h / 2) with hw
  have hw0 : 0 < w := mul_pos h0 (by linarith)
  have hδ0 : 0 < δ := by positivity
  have hL0 : (0 : ℝ) ≤ L := L.2
  set σ : ℝ := δ / (2 * ((L : ℝ) + 1)) with hσ
  have hσ0 : 0 < σ := by positivity
  have h2Lσ : 2 * (L : ℝ) * σ < δ := by
    rw [hσ, mul_div_assoc', div_lt_iff₀ (by positivity)]
    nlinarith
  -- the clamped profile `G = max 0 (min 1 ((t − δ − f)/w))`: `(L/w)`-Lipschitz, `|G| ≤ 1`,
  -- `G = 1` on `{f < t − h + δ}` and `G = 0` on `{f > t − δ}`
  set G : Euclid P → ℝ := fun x => max 0 (min 1 ((t - δ - f x) / w)) with hGdef
  set K : NNReal := L * Real.toNNReal w⁻¹ with hK
  have hKr : (K : ℝ) = L / w := by
    rw [hK, NNReal.coe_mul, Real.coe_toNNReal _ (inv_pos.2 hw0).le, div_eq_mul_inv]
  have hG : LipschitzWith K G := by
    have hlin : LipschitzWith K fun x => (t - δ - f x) / w := by
      refine LipschitzWith.of_dist_le_mul fun x y => ?_
      have hxy := hf.dist_le_mul x y
      rw [Real.dist_eq] at hxy
      rw [Real.dist_eq, hKr, show (t - δ - f x) / w - (t - δ - f y) / w = (f y - f x) / w by ring,
        abs_div, abs_of_pos hw0, abs_sub_comm, div_mul_eq_mul_div]
      exact div_le_div_of_nonneg_right hxy hw0.le
    exact (hlin.const_min 1).const_max 0
  have hG01 : ∀ y, |G y| ≤ 1 := by
    intro y
    simp only [hGdef]
    rw [abs_le]
    exact ⟨by linarith [le_max_left 0 (min 1 ((t - δ - f y) / w))],
      max_le zero_le_one (min_le_left _ _)⟩
  have hG1 : ∀ y, f y < t - h + δ → G y = 1 := by
    intro y hy
    have : 1 ≤ (t - δ - f y) / w := by rw [le_div_iff₀ hw0]; linarith
    simp [hGdef, min_eq_left this]
  have hG0 : ∀ y, t - δ < f y → G y = 0 := by
    intro y hy
    have : (t - δ - f y) / w ≤ 0 := div_nonpos_of_nonpos_of_nonneg (by linarith) hw0.le
    simp only [hGdef]
    exact max_eq_left ((min_le_right _ _).trans this)
  -- smoothing of `G` at scale `σ`
  obtain ⟨g, hgs, hgd, hga, hgl⟩ := Submission.cmcs_lipschitz_smoothing P G K σ hG hσ0
  -- plateaus: if `G = c` on `B_{2σ}(x)`, then `g = c` on `B_σ(x)`, so `g x = c` and `Dg(x) = 0`
  have hnear : ∀ x, ∀ c : ℝ, (∀ y ∈ ball x (2 * σ), G y = c) → g x = c ∧ fderiv ℝ g x = 0 := by
    intro x c hc
    have hball : ∀ x' ∈ ball x σ, g x' = c := fun x' hx' => hgl x' c fun y hy => hc y (by
      rw [mem_ball] at hx' hy ⊢
      linarith [dist_triangle y x' x])
    have hev : g =ᶠ[𝓝 x] fun _ => c := Filter.eventually_of_mem (ball_mem_nhds x hσ0) hball
    exact ⟨hball x (mem_ball_self hσ0), hev.fderiv_eq.trans (fderiv_const_apply c)⟩
  -- on `B_{2σ}(x)`, `|f y − f x| ≤ L |y − x| < 2Lσ < δ`
  have hclose : ∀ x, ∀ y ∈ ball x (2 * σ), |f y - f x| < δ := by
    intro x y hy
    have hd := hf.dist_le_mul y x
    rw [Real.dist_eq] at hd
    rw [mem_ball] at hy
    have : (L : ℝ) * dist y x ≤ L * (2 * σ) := mul_le_mul_of_nonneg_left hy.le hL0
    linarith
  have hlow : ∀ x, f x ≤ t - h → g x = 1 ∧ fderiv ℝ g x = 0 := fun x hx =>
    hnear x 1 fun y hy => hG1 y (by linarith [(abs_lt.1 (hclose x y hy)).2])
  have hup : ∀ x, t ≤ f x → g x = 0 ∧ fderiv ℝ g x = 0 := fun x hx =>
    hnear x 0 fun y hy => hG0 y (by linarith [(abs_lt.1 (hclose x y hy)).1])
  refine ⟨g, hgs, fun x => ?_, fun x => (hgd x).trans_eq hKr, fun x hx => ?_,
    fun x hx => (hlow x hx).1, fun x hx => (hup x hx).1⟩
  · -- `|g| ≤ |G| + Kσ ≤ 2`, as `Kσ = Lδ/(2(L + 1)w) ≤ 1` (`δ ≤ 2w`)
    have hKσ : (K : ℝ) * σ ≤ 1 := by
      rw [hKr, hσ, div_mul_div_comm, div_le_one (by positivity)]
      have hδw : δ ≤ 2 * w := by rw [hδ, hw]; nlinarith
      nlinarith
    linarith [abs_sub_abs_le_abs_sub (g x) (G x), hga x, hG01 x]
  · -- `Dg = 0` on both plateaus, so `Dg(x) ≠ 0` forces `t − h < f x < t`
    by_contra hcon
    rcases not_and_or.1 hcon with hc | hc
    · exact hx (hlow x (not_lt.1 hc)).2
    · exact hx (hup x (not_lt.1 hc)).2

/-- **Mass of a slice, pointwise in `t`** (Simon 6.4.9, proved as in 6.4.11): let `T = ξ μ`,
`∂T = ξ' μ'` with `|ξ|, |ξ'| ≤ 1`, let `f` be `L`-Lipschitz, and let `A = T ⌞ {f < t}`,
`B = (∂T) ⌞ {f < t}`.  Then `M_W(∂A − B) ≤ L · liminf_{h ↓ 0} h⁻¹ μ(W ∩ {t − h < f < t})`.
For an admissible `η` and `h ∈ (0, 1)`, the smooth cut-off `g_h` of `cmcs_level_cutoff` gives
`Φ_h = ∫ g_h ξ(dη) dμ − ∫ g_h ξ'(η) dμ'` with `|Φ_h| ≤ ∫ |Dg_h| |η| dμ ≤ c_h μ(W ∩ S_h)`,
`c_h = L / (h(1 − h/2))`, `S_h = {t − h < f < t}` (`cmcs_cutoff_defect_bound`,
`cmcs_smp_strip_lintegral_le`); `Φ_h → (∂A − B)(η)` by dominated convergence
(`cmcs_smp_cutoff_integral_tendsto`), and `cmcs_smp_liminf_bound` passes to the liminf. -/
theorem Submission.cmcs_slice_mass_pointwise : ∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal) (t : ℝ) (A : GeometricCurrentOn U (k + 1)) (B : GeometricCurrentOn U k) (W : Set (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ θ : TestFormOn U k, T.boundary θ = ∫ x, ξ' x ((θ : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → (∀ ω : TestFormOn U (k + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ θ : TestFormOn U k, B θ = ∫ x in {x | f x < t}, ξ' x ((θ : DifferentialForm (Euclid P) k) x) ∂μ') → (A.boundary - B).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0) := by
  intro P k U T μ μ' ξ ξ' f L t A B W hμ hμ' hξm hξm' hξ hξ' hT hbT hf hA hB
  -- Step 3: a cut-off `g h` for every `h ∈ (0, 1)` (junk value `0` for other `h`).
  have hcut : ∀ h : ℝ, ∃ g : Euclid P → ℝ, 0 < h → h < 1 →
      ContDiff ℝ (⊤ : ℕ∞) g ∧ (∀ x, |g x| ≤ 2) ∧
        (∀ x, ‖fderiv ℝ g x‖ ≤ L / (h * (1 - h / 2))) ∧
        (∀ x, fderiv ℝ g x ≠ 0 → t - h < f x ∧ f x < t) ∧
        (∀ x, f x ≤ t - h → g x = 1) ∧ (∀ x, t ≤ f x → g x = 0) := by
    intro h
    by_cases hh : 0 < h ∧ h < 1
    · obtain ⟨g, hg⟩ := Submission.cmcs_level_cutoff P f L t h hf hh.1 hh.2
      exact ⟨g, fun _ _ => hg⟩
    · exact ⟨0, fun h0 h1 => (hh ⟨h0, h1⟩).elim⟩
  choose g hg using hcut
  -- Step 1: it suffices to bound `ofReal ((∂A − B) η)` for one admissible `η`.
  apply sSup_le
  rintro r ⟨η, ⟨hηW, hη1⟩, rfl⟩
  have hZ : (A.boundary - B) η =
      (∫ x in {x | f x < t}, ξ x (exteriorDerivative (η : DifferentialForm (Euclid P) k) x) ∂μ) -
        ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ' := by
    change A (exteriorDerivativeTestOn U k η) - B η = _
    rw [hA, hB]
    rfl
  -- Step 2: `F = ξ(dη)` is `μ`-integrable and `F' = ξ'(η)` is `μ'`-integrable.
  have hF : Integrable
      (fun x => ξ x (exteriorDerivative (η : DifferentialForm (Euclid P) k) x)) μ :=
    Submission.cmcs_smp_pairing_integrable P (k + 1) U μ ξ (exteriorDerivativeTestOn U k η)
      hμ hξm hξ
  have hF' : Integrable (fun x => ξ' x ((η : DifferentialForm (Euclid P) k) x)) μ' :=
    Submission.cmcs_smp_pairing_integrable P k U μ' ξ' η hμ' hξm' hξ'
  -- Step 5: `Φ h → (∂A − B)(η)` as `h ↓ 0`, by dominated convergence for each integral.
  have hfm : Measurable f := hf.continuous.measurable
  have hgm : ∀ ν : Measure (Euclid P), ∀ h : ℝ, 0 < h → h < 1 → AEStronglyMeasurable (g h) ν :=
    fun _ h h0 h1 => (hg h h0 h1).1.continuous.aestronglyMeasurable
  have hlim : Tendsto (fun h : ℝ =>
      (∫ x, g h x * ξ x (exteriorDerivative (η : DifferentialForm (Euclid P) k) x) ∂μ) -
        ∫ x, g h x * ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ')
      (𝓝[>] 0) (𝓝 ((A.boundary - B) η)) := by
    rw [hZ]
    exact (Submission.cmcs_smp_cutoff_integral_tendsto P μ _ f t 2 g hF hfm (hgm μ)
      (fun h h0 h1 => (hg h h0 h1).2.1) (fun h h0 h1 => (hg h h0 h1).2.2.2.2.1)
      (fun h h0 h1 => (hg h h0 h1).2.2.2.2.2)).sub
      (Submission.cmcs_smp_cutoff_integral_tendsto P μ' _ f t 2 g hF' hfm (hgm μ')
        (fun h h0 h1 => (hg h h0 h1).2.1) (fun h h0 h1 => (hg h h0 h1).2.2.2.2.1)
        (fun h h0 h1 => (hg h h0 h1).2.2.2.2.2))
  -- Steps 4 and 6: `ofReal |Φ h| ≤ ofReal (L / (h (1 − h/2))) μ(W ∩ S_h)` for `h ∈ (0, 1)`,
  -- then pass to the liminf.
  refine Submission.cmcs_smp_liminf_bound L ((A.boundary - B) η) _
    (fun h => μ (W ∩ {x | t - h < f x ∧ f x < t})) hlim fun h h0 h1 => ?_
  obtain ⟨hgs, -, hgd, hgS, -, -⟩ := hg h h0 h1
  exact (Submission.cmcs_cutoff_defect_bound P k U T μ μ' ξ ξ' (g h) η hξ hT hbT hgs).trans
    (Submission.cmcs_smp_strip_lintegral_le P k μ (g h) (η : DifferentialForm (Euclid P) k) W
      {x | t - h < f x ∧ f x < t} _ hgd hgS hηW hη1)
/-- **Lebesgue's inequality for monotone functions** (Simon Ch. 6, remark before 4.10): if `F` is
nondecreasing, then `∫⁻_{(a,b)} F′ ≤ F(b) − F(a)`.  Let `G = F(·⁺)` be the Stieltjes function of
`F`, with measure `μ_G`; then `μ_G (a, b) = G(b⁻) − G(a) ≤ F(b) − F(a)`.  By Lebesgue's theorem
(`Monotone.ae_hasDerivAt`), `F′ = dμ_G/dt` a.e., and `∫⁻_{(a,b)} dμ_G/dt ≤ μ_G (a, b)` since
`(dμ_G/dt) dt ≤ μ_G` (Lebesgue decomposition). -/
theorem Submission.cmcs_smi_lintegral_ofReal_deriv_le : ∀ (F : ℝ → ℝ) (a b : ℝ), Monotone F → ∫⁻ t in Ioo a b, ENNReal.ofReal (deriv F t) ≤ ENNReal.ofReal (F b - F a) := by
  intro F a b hF
  set G := hF.stieltjesFunction
  -- `F(a) ≤ F(a⁺) = G(a)`, and `G(b⁻) ≤ F(b)` because `G(y) = F(y⁺) ≤ F(b)` for `y < b`
  have hGa : F a ≤ G a := hF.le_rightLim le_rfl
  have hGb : leftLim G b ≤ F b := by
    refine le_of_tendsto (G.mono.tendsto_leftLim b) ?_
    filter_upwards [self_mem_nhdsWithin] with y (hy : y < b)
    exact hF.rightLim_le hy
  calc ∫⁻ t in Ioo a b, ENNReal.ofReal (deriv F t)
      ≤ ∫⁻ t in Ioo a b, G.measure.rnDeriv volume t := by
        -- a.e. `F′(t) = (dμ_G/dt)(t).toReal`
        refine lintegral_mono_ae (ae_restrict_of_ae ?_)
        filter_upwards [hF.ae_hasDerivAt] with t ht
        rw [ht.deriv]
        exact ENNReal.ofReal_toReal_le
    _ ≤ volume.withDensity (G.measure.rnDeriv volume) (Ioo a b) := withDensity_apply_le _ _
    _ ≤ G.measure (Ioo a b) := Measure.le_iff'.1 (Measure.withDensity_rnDeriv_le _ _) _
    _ = ENNReal.ofReal (leftLim G b - G a) := G.measure_Ioo
    _ ≤ ENNReal.ofReal (F b - F a) := ENNReal.ofReal_le_ofReal (by linarith)

/-- **Simon Ch. 6, remark before 4.10** (integrated lower left Dini derivative).  For monotone
`F : ℝ → ℝ`, the lower integral over `(a, b)` of `D(t) = liminf_{h → 0+} (F(t) - F(t - h)) / h`
is at most `F(b) - F(a)`.  `F` is differentiable a.e. (Lebesgue), and at a point of
differentiability the left difference quotients tend to `F'(t)`, so `D = F'` a.e.  Changing the
integrand on a null set needs no measurability of `D`, and `∫_(a,b) F' ≤ F(b) - F(a)` is
`cmcs_smi_lintegral_ofReal_deriv_le`. -/
theorem Submission.cmcs_smi_lintegral_left_dini_le : ∀ (F : ℝ → ℝ) (a b : ℝ), Monotone F → ∫⁻ t in Ioo a b, liminf (fun h : ℝ => ENNReal.ofReal ((F t - F (t - h)) / h)) (𝓝[>] 0) ≤ ENNReal.ofReal (F b - F a) := by
  intro F a b hF
  -- `D = ofReal ∘ deriv F` at every point of differentiability, hence a.e.
  have hae : ∀ᵐ t, liminf (fun h : ℝ => ENNReal.ofReal ((F t - F (t - h)) / h)) (𝓝[>] 0) =
      ENNReal.ofReal (deriv F t) := by
    filter_upwards [hF.ae_differentiableAt] with t ht
    -- `h ↦ -h` maps `𝓝[>] 0` into `𝓝[<] 0`, turning left slopes into the quotients above
    have hneg : Tendsto (fun h : ℝ => -h) (𝓝[>] 0) (𝓝[<] 0) := by
      simpa using tendsto_neg_nhdsGT (a := (0 : ℝ))
    have hlim : Tendsto (fun h : ℝ => (F t - F (t - h)) / h) (𝓝[>] 0) (𝓝 (deriv F t)) := by
      refine (ht.hasDerivAt.tendsto_slope_zero_left.comp hneg).congr fun h => ?_
      simp only [Function.comp_apply, smul_eq_mul]
      rw [← sub_eq_add_neg, inv_neg, div_eq_inv_mul]
      ring
    exact (ENNReal.tendsto_ofReal hlim).liminf_eq
  calc ∫⁻ t in Ioo a b, liminf (fun h : ℝ => ENNReal.ofReal ((F t - F (t - h)) / h)) (𝓝[>] 0)
      = ∫⁻ t in Ioo a b, ENNReal.ofReal (deriv F t) := lintegral_congr_ae (ae_restrict_of_ae hae)
    _ ≤ ENNReal.ofReal (F b - F a) := Submission.cmcs_smi_lintegral_ofReal_deriv_le F a b hF

/-- **Simon Ch. 6, the remark deriving 4.10 from 4.9, for a measure on `ℝ`.**  For any measure
`ν` on `ℝ`, `∫⁻_{(a,b)} liminf_{h → 0+} h⁻¹ ν((t − h, t)) dt ≤ ν((a, b))` (Simon applies this to
`ν((s, t)) = M_W(T ⌞ {s < f < t})`).  When `ν((a, b)) < ∞`, `F(s) = ν((a, min s b))` is finite
and monotone, with `F a = 0` and `F b = ν((a, b))`.  For `0 < h < t − a`, additivity on
`(a, t − h) ∪ (t − h, t) ⊆ (a, t)` gives `h⁻¹ ν((t − h, t)) ≤ (F t − F (t − h)) / h`, so the left
density is at most the lower left Dini derivative of `F`, whose integral
`cmcs_smi_lintegral_left_dini_le` bounds by `F b − F a`. -/
theorem Submission.cmcs_smi_lintegral_left_density_le : ∀ (ν : Measure ℝ) (a b : ℝ), ∫⁻ t in Ioo a b, liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * ν (Ioo (t - h) t)) (𝓝[>] 0) ≤ ν (Ioo a b) := by
  intro ν a b
  by_cases hN : ν (Ioo a b) = ∞
  · rw [hN]
    exact le_top
  -- the distribution function `F(s) = ν((a, min s b))` of `ν` on `(a, b)`
  set F : ℝ → ℝ := fun s => (ν (Ioo a (min s b))).toReal with hFdef
  have hfin : ∀ s, ν (Ioo a (min s b)) ≠ ∞ := fun s =>
    ne_top_of_le_ne_top hN (measure_mono (Ioo_subset_Ioo_right (min_le_right s b)))
  have hFmono : Monotone F := fun s s' hss' =>
    ENNReal.toReal_mono (hfin s') (measure_mono (Ioo_subset_Ioo_right (min_le_min_right b hss')))
  have hofF : ∀ s, ENNReal.ofReal (F s) = ν (Ioo a (min s b)) := fun s =>
    ENNReal.ofReal_toReal (hfin s)
  have hFa : F a = 0 := by
    simp only [hFdef]
    rw [Ioo_eq_empty (not_lt.2 (min_le_left a b)), measure_empty, ENNReal.toReal_zero]
  have hFb : F b = (ν (Ioo a b)).toReal := by
    simp only [hFdef, min_self]
  -- the strip estimate: for `0 < h < t − a`, `h⁻¹ ν((t − h, t)) ≤ (F t − F (t − h)) / h`
  have hstrip : ∀ t ∈ Ioo a b, ∀ h ∈ Ioo 0 (t - a),
      ENNReal.ofReal h⁻¹ * ν (Ioo (t - h) t) ≤ ENNReal.ofReal ((F t - F (t - h)) / h) := by
    intro t ht h hh
    have hmt : min t b = t := min_eq_left ht.2.le
    have hmth : min (t - h) b = t - h := min_eq_left (by linarith [hh.1, ht.2])
    have hunion : ν (Ioo a (t - h)) + ν (Ioo (t - h) t) ≤ ν (Ioo a t) := by
      rw [← measure_union _ measurableSet_Ioo]
      · refine measure_mono (union_subset ?_ ?_)
        · exact Ioo_subset_Ioo_right (by linarith [hh.1])
        · exact Ioo_subset_Ioo_left (by linarith [hh.2])
      · rw [Set.disjoint_left]
        intro x hx1 hx2
        linarith [hx1.2, hx2.1]
    have hle : ν (Ioo (t - h) t) ≤ ENNReal.ofReal (F t - F (t - h)) := by
      rw [ENNReal.ofReal_sub _ ENNReal.toReal_nonneg, hofF, hofF, hmt, hmth]
      refine ENNReal.le_sub_of_add_le_left ?_ hunion
      rw [← hmth]
      exact hfin (t - h)
    calc ENNReal.ofReal h⁻¹ * ν (Ioo (t - h) t)
        ≤ ENNReal.ofReal h⁻¹ * ENNReal.ofReal (F t - F (t - h)) := mul_le_mul_right hle _
      _ = ENNReal.ofReal ((F t - F (t - h)) / h) := by
        rw [← ENNReal.ofReal_mul (inv_nonneg.2 hh.1.le), div_eq_inv_mul]
  -- `(0, t − a) ∈ 𝓝[>] 0`, so the strip estimate compares the two liminfs on `(a, b)`
  have hpt : ∀ t ∈ Ioo a b,
      liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * ν (Ioo (t - h) t)) (𝓝[>] 0) ≤
        liminf (fun h : ℝ => ENNReal.ofReal ((F t - F (t - h)) / h)) (𝓝[>] 0) := by
    intro t ht
    refine liminf_le_liminf ?_
    filter_upwards [Ioo_mem_nhdsGT (sub_pos.2 ht.1)] with h hh
    exact hstrip t ht h hh
  calc ∫⁻ t in Ioo a b, liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * ν (Ioo (t - h) t)) (𝓝[>] 0)
      ≤ ∫⁻ t in Ioo a b, liminf (fun h : ℝ => ENNReal.ofReal ((F t - F (t - h)) / h)) (𝓝[>] 0) :=
        setLIntegral_mono' measurableSet_Ioo hpt
    _ ≤ ENNReal.ofReal (F b - F a) := Submission.cmcs_smi_lintegral_left_dini_le F a b hFmono
    _ = ν (Ioo a b) := by rw [hFb, hFa, sub_zero, ENNReal.ofReal_toReal hN]

/-- **Simon Ch. 6, 4.10** (integrated slice-mass bound, with `μ(W ∩ {a < f < s})` in place of
`M_W(T⌞{a < f < s})`): if `m(t) ≤ L · liminf_{h↓0} h⁻¹ μ(W ∩ {t − h < f < t})` for every
`t ∈ (a, b)`, then `∫⁻_{(a,b)} m ≤ L · μ(W ∩ {a < f < b})`.  The push-forward `ν = f_#(μ⌞W)` has
`ν((s, t)) = μ(W ∩ {s < f < t})`, so the hypothesis reads
`m(t) ≤ L · liminf_{h↓0} h⁻¹ ν((t − h, t))`; pull `L` out of the lower integral (`L ≠ ∞`) and bound
the integrated lower left density of `ν` by `ν((a, b))` (`cmcs_smi_lintegral_left_density_le`).
No measurability of `m` is needed. -/
theorem Submission.cmcs_slice_mass_integral : ∀ (P : ℕ) (μ : Measure (Euclid P)) (f : Euclid P → ℝ) (W : Set (Euclid P)) (L : NNReal) (m : ℝ → ℝ≥0∞) (a b : ℝ), Measurable f → MeasurableSet W → (∀ t ∈ Ioo a b, m t ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) → ∫⁻ t in Ioo a b, m t ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}) := by
  intro P μ f W L m a b hf _hW hm
  -- `ν = f_#(μ⌞W)`, so `ν((s, t)) = μ(f⁻¹(s, t) ∩ W) = μ(W ∩ {s < f < t})`
  set ν : Measure ℝ := (μ.restrict W).map f with hν
  have hνI : ∀ s t : ℝ, ν (Ioo s t) = μ (W ∩ {x | s < f x ∧ f x < t}) := by
    intro s t
    rw [hν, Measure.map_apply hf measurableSet_Ioo,
      Measure.restrict_apply (hf measurableSet_Ioo), Set.inter_comm]
    rfl
  calc ∫⁻ t in Ioo a b, m t
      ≤ ∫⁻ t in Ioo a b, (L : ℝ≥0∞) *
          liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * ν (Ioo (t - h) t)) (𝓝[>] 0) :=
        setLIntegral_mono' measurableSet_Ioo fun t ht => by simpa only [hνI] using hm t ht
    _ = (L : ℝ≥0∞) * ∫⁻ t in Ioo a b,
          liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * ν (Ioo (t - h) t)) (𝓝[>] 0) :=
        lintegral_const_mul' _ _ ENNReal.coe_ne_top
    _ ≤ (L : ℝ≥0∞) * ν (Ioo a b) :=
        mul_le_mul_right (Submission.cmcs_smi_lintegral_left_density_le ν a b) _
    _ = (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}) := by rw [hνI]

/-- **Simon Ch. 6, 4.6–4.11** (slicing by a Lipschitz function), with restrictions taken w.r.t.
the given representations `(μ, ξ)` of `T` and `(μ', ξ')` of `∂T`: `A_t = T⌞{f < t}` and
`B_t = (∂T)⌞{f < t}` are currents (`cmcs_restrict_current`); `∂A_t = B_t` on forms supported away
from `{f = t}` (`cmcs_slice_support`, `f` being continuous); the slice `⟨T, f, t₋⟩ = ∂A_t − B_t`
has `M_W ≤ L · liminf_{h↓0} h⁻¹ μ(W ∩ {t − h < f < t})` (`cmcs_slice_mass_pointwise`); integrating
this bound over `t ∈ (a, b)` gives `L · μ(W ∩ {a < f < b})` (`cmcs_slice_mass_integral`, `f`
measurable and `W` open). -/
theorem Submission.dimred_mbl_slice_mass_bounds : ∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b})) := by
  intro P k U T μ μ' ξ ξ' f L _hU hμ hμ' hξm hξ'm hξ hξ' hT hbT hf
  -- `A_t = T⌞{f < t}` and `B_t = (∂T)⌞{f < t}`
  choose A hA using fun t : ℝ =>
    Submission.cmcs_restrict_current P (k + 1) U μ ξ {x | f x < t} hμ hξm hξ
  choose B hB using fun t : ℝ =>
    Submission.cmcs_restrict_current P k U μ' ξ' {x | f x < t} hμ' hξ'm hξ'
  -- the pointwise slice-mass bound holds for every `W` and `t`
  have hpt : ∀ (W : Set (Euclid P)) (t : ℝ), ((A t).boundary - B t).massOn W ≤
      (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t}))
        (𝓝[>] 0) := fun W t =>
    Submission.cmcs_slice_mass_pointwise P k U T μ μ' ξ ξ' f L t (A t) (B t) W hμ hμ' hξm hξ'm
      hξ hξ' hT hbT hf (hA t) (hB t)
  refine ⟨A, B, hA, hB, fun t η hη => ?_, fun W t _ => hpt W t, fun W a b hW => ?_⟩
  · exact Submission.cmcs_slice_support P k U T μ μ' ξ ξ' f t (A t) (B t) hf.continuous hT hbT
      (hA t) (hB t) η hη
  · exact Submission.cmcs_slice_mass_integral P μ f W L (fun t => ((A t).boundary - B t).massOn W)
      a b hf.continuous.measurable hW.measurableSet fun t _ => hpt W t

/-- Gradient bound for the mollified function (Simon Ch. 2, Lemma 2.5, duality argument): if
`∫_{Q₁} u div g ≤ V` for every smooth `g` with `|g| ≤ 1` and compact support in `Q₁`, then
`f = ρ * 1_{Q₁}u` satisfies `∫_{Q_δ} ‖Df‖ ≤ V` for an even mollifier `ρ` supported in `B_σ(0)`,
`σ < δ`.  Test with `g = −ρ * s`, `s = 1_{Q_δ} ∇f/|∇f|`, and use the adjoint identity
`∫ Df(s) = −∫ 1_{Q₁}u div(ρ * s)`. -/
theorem dimred_mbl_dt_cbm_sa_grad_bound : ∀ (m : ℕ) (u : Euclid (m + 1) → ℝ) (V δ σ : ℝ) (ρ : Euclid (m + 1) → ℝ), IntegrableOn u {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ y, ‖g y‖ ≤ 1) → ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, u y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) ≤ V) → 0 < σ → σ < δ → ContDiff ℝ (⊤ : ℕ∞) ρ → (∀ z, 0 ≤ ρ z) → (∀ z, ρ (-z) = ρ z) → ∫ z, ρ z = 1 → support ρ ⊆ ball (0 : Euclid (m + 1)) σ → ∫ x in {z : Euclid (m + 1) | ∀ i, δ < z i ∧ z i < 1 - δ}, ‖fderiv ℝ (convolution ρ ({y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}.indicator u) (ContinuousLinearMap.lsmul ℝ ℝ) volume) x‖ ≤ V := by
  have smoothed_field := Submission.dimred_mbl_dt_cbm_sa_smoothed_field
  have adjoint := codim1_rdo_dg_sp_mollifier_adjoint
  intro m u V δ σ ρ hu hyp hσ hσδ hρs hρnn hρeven hρint hρsupp
  set Q1 : Set (Euclid (m + 1)) := {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}
  set Qd : Set (Euclid (m + 1)) := {z : Euclid (m + 1) | ∀ i, δ < z i ∧ z i < 1 - δ}
  -- Step 0: `Q₁`, `Q_δ` are measurable, `Q_δ ⊆ Q₁ ⊆ B̄_{√(m+1)}(0)` has finite measure,
  -- `1_{Q₁}u` is integrable and `ρ` is `C¹` with compact support.
  have hQ1m : MeasurableSet Q1 := by
    have : Q1 = ⋂ i, ({y : Euclid (m + 1) | 0 < y i} ∩ {y : Euclid (m + 1) | y i < 1}) := by
      ext y; simp [Q1]
    rw [this]
    refine MeasurableSet.iInter fun i => ?_
    exact (measurableSet_lt measurable_const (by fun_prop)).inter
      (measurableSet_lt (by fun_prop) measurable_const)
  have hQdm : MeasurableSet Qd := by
    have : Qd = ⋂ i, ({y : Euclid (m + 1) | δ < y i} ∩ {y : Euclid (m + 1) | y i < 1 - δ}) := by
      ext y; simp [Qd]
    rw [this]
    refine MeasurableSet.iInter fun i => ?_
    exact (measurableSet_lt measurable_const (by fun_prop)).inter
      (measurableSet_lt (by fun_prop) measurable_const)
  have hδ : 0 < δ := hσ.trans hσδ
  have hQdQ1 : Qd ⊆ Q1 := by
    intro y hy i
    obtain ⟨h1, h2⟩ := hy i
    exact ⟨by linarith, by linarith⟩
  have hQ1bdd : Q1 ⊆ closedBall (0 : Euclid (m + 1)) (Real.sqrt (m + 1)) := by
    intro y hy
    rw [mem_closedBall, dist_zero_right, EuclideanSpace.norm_eq]
    apply Real.sqrt_le_sqrt
    calc ∑ i, ‖y i‖ ^ 2 ≤ ∑ _i : Fin (m + 1), (1 : ℝ) := Finset.sum_le_sum fun i _ => by
            obtain ⟨h0, h1⟩ := hy i
            rw [Real.norm_eq_abs, sq_abs]; nlinarith
      _ = m + 1 := by simp
  have hQdfin : volume Qd < ∞ :=
    (measure_mono (hQdQ1.trans hQ1bdd)).trans_lt measure_closedBall_lt_top
  set ubar : Euclid (m + 1) → ℝ := Q1.indicator u
  have hubar : Integrable ubar := (integrable_indicator_iff hQ1m).2 hu
  have hρc : HasCompactSupport ρ := by
    refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid (m + 1)) σ) fun x hx => ?_
    by_contra h
    exact hx (ball_subset_closedBall (hρsupp h))
  have hρ1 : ContDiff ℝ 1 ρ := hρs.of_le (by exact_mod_cast le_top)
  -- Step 1: `f = ρ * 1_{Q₁}u` is `C^∞`, so `Df` is continuous.
  set f : Euclid (m + 1) → ℝ := convolution ρ ubar (ContinuousLinearMap.lsmul ℝ ℝ) volume
  have hf : ContDiff ℝ (⊤ : ℕ∞) f := hρc.contDiff_convolution_left _ hρs hubar.locallyIntegrable
  have hDf : Continuous (fderiv ℝ f) := hf.continuous_fderiv (by simp)
  -- Step 2: the gradient `w` (Riesz representative of `Df`) and the unit field
  -- `s = 1_{Q_δ} w/|w|`, with `Df(x)(s x) = 1_{Q_δ}(x) ‖Df(x)‖`.
  set w : Euclid (m + 1) → Euclid (m + 1) := fun x =>
    (InnerProductSpace.toDual ℝ (Euclid (m + 1))).symm (fderiv ℝ f x)
  have hw : Continuous w := (InnerProductSpace.toDual ℝ (Euclid (m + 1))).symm.continuous.comp hDf
  have hwn : ∀ x, ‖w x‖ = ‖fderiv ℝ f x‖ := fun x => LinearIsometryEquiv.norm_map _ _
  have hwapp : ∀ x h, fderiv ℝ f x h = inner ℝ (w x) h := fun x h =>
    (InnerProductSpace.toDual_symm_apply).symm
  set s : Euclid (m + 1) → Euclid (m + 1) := Qd.indicator (fun x => ‖w x‖⁻¹ • w x)
  have hs_meas : Measurable s :=
    ((hw.measurable.norm.inv).smul hw.measurable).indicator hQdm
  have hs_le : ∀ x, ‖s x‖ ≤ 1 := by
    intro x
    by_cases hx : x ∈ Qd
    · simp only [s, indicator_of_mem hx, norm_smul, norm_inv, norm_norm]
      by_cases hw0 : ‖w x‖ = 0
      · simp [hw0]
      · rw [inv_mul_cancel₀ hw0]
    · simp [s, indicator_of_notMem hx]
  have hs_zero : ∀ x, x ∉ Qd → s x = 0 := fun x hx => indicator_of_notMem hx _
  have hs_int : Integrable s := by
    have : IntegrableOn (fun x => ‖w x‖⁻¹ • w x) Qd :=
      Measure.integrableOn_of_bounded hQdfin.ne
        ((hw.measurable.norm.inv).smul hw.measurable).aestronglyMeasurable
        (Eventually.of_forall fun x => by
          simp only [norm_smul, norm_inv, norm_norm]
          by_cases hw0 : ‖w x‖ = 0
          · simp [hw0]
          · rw [inv_mul_cancel₀ hw0]) (M := 1)
    exact (integrable_indicator_iff hQdm).2 this
  have hDfs : ∀ x, fderiv ℝ f x (s x) = Qd.indicator (fun x => ‖fderiv ℝ f x‖) x := by
    intro x
    by_cases hx : x ∈ Qd
    · simp only [s, indicator_of_mem hx, map_smul, smul_eq_mul, hwapp x (w x),
        real_inner_self_eq_norm_sq]
      rw [← hwn x]
      by_cases hw0 : ‖w x‖ = 0
      · simp [hw0]
      · field_simp
    · simp [s, indicator_of_notMem hx]
  -- Step 3: the smoothed field `G = ρ * s` is admissible (`smoothed_field`), so testing the
  -- hypothesis with `−G` gives `−∫_{Q₁} u div G ≤ V`.
  set G : Euclid (m + 1) → Euclid (m + 1) := convolution ρ s (ContinuousLinearMap.lsmul ℝ ℝ) volume
  obtain ⟨hG, hGc, hGsupp, hGle⟩ := smoothed_field m δ σ ρ s hσ hσδ hρs hρnn hρint hρsupp
    hs_meas.aestronglyMeasurable hs_le hs_zero
  have h1 := hyp (-G) hG.neg hGc.neg (by rw [tsupport_neg]; exact hGsupp)
    (fun y => by simpa using hGle y)
  have h1' : -∫ y in Q1, u y * LinearMap.trace ℝ (Euclid (m + 1))
      (fderiv ℝ G y : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) ≤ V := by
    rw [← integral_neg]
    convert h1 using 3 with y
    rw [fderiv_neg, ContinuousLinearMap.toLinearMap_neg, map_neg, mul_neg]
  -- Step 4: the adjoint identity `∫ Df(s) = −∫ 1_{Q₁}u div G = −∫_{Q₁} u div G`.
  have h2 := adjoint (m + 1) ρ ubar s hρ1 hρc hρeven hubar hs_int
  have h3 : ∫ z, ubar z * LinearMap.trace ℝ (Euclid (m + 1))
      (fderiv ℝ G z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) =
      ∫ z in Q1, u z * LinearMap.trace ℝ (Euclid (m + 1))
      (fderiv ℝ G z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) := by
    rw [← integral_indicator hQ1m]
    congr 1
    funext z
    by_cases hz : z ∈ Q1
    · simp [ubar, indicator_of_mem hz]
    · simp [ubar, indicator_of_notMem hz]
  -- Step 5: `∫_{Q_δ} ‖Df‖ = ∫ Df(s) = −∫_{Q₁} u div G ≤ V`.
  calc ∫ x in Qd, ‖fderiv ℝ f x‖ = ∫ x, Qd.indicator (fun x => ‖fderiv ℝ f x‖) x :=
        (integral_indicator hQdm).symm
    _ = ∫ x, fderiv ℝ f x (s x) := by
        congr 1; funext x; rw [hDfs]
    _ = -∫ z, ubar z * LinearMap.trace ℝ (Euclid (m + 1))
          (fderiv ℝ G z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) := h2
    _ = -∫ z in Q1, u z * LinearMap.trace ℝ (Euclid (m + 1))
          (fderiv ℝ G z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) := by rw [h3]
    _ ≤ V := h1'
/-- Mollifications converge in `L¹`, uniformly over normalized kernels: for integrable `f` and
`ε > 0` there is `r > 0` with `∫ |ρ * f − f| ≤ ε` for every continuous `ρ ≥ 0` with `∫ ρ = 1`
and `spt ρ ⊆ B_r(0)` (Simon Ch. 2, proof of Lemma 2.5).  Approximate `f` in `L¹` by a continuous
compactly supported `h`; then `ρ * f − f = ρ * (f − h) + (ρ * h − h) + (h − f)`, where
convolution with `ρ` does not increase the `L¹` norm and `ρ * h − h` is uniformly small and
vanishes off a fixed ball. -/
theorem dimred_mbl_dt_cbm_sa_mollify_l1 : ∀ (n : ℕ) (f : Euclid n → ℝ), Integrable f → ∀ ε : ℝ, 0 < ε → ∃ r : ℝ, 0 < r ∧ ∀ ρ : Euclid n → ℝ, Continuous ρ → (∀ z, 0 ≤ ρ z) → ∫ z, ρ z = 1 → support ρ ⊆ ball (0 : Euclid n) r → ∫⁻ x, ‖convolution ρ f (ContinuousLinearMap.lsmul ℝ ℝ) volume x - f x‖ₑ ≤ ENNReal.ofReal ε := by
  intro n f hf ε hε
  -- Step 2: continuous compactly supported functions are dense in `L¹`.  It suffices to
  -- approximate `c 1_s` (`MemLp.induction_dense`): take compact `K ⊆ s` and open `V ⊇ K` with
  -- `vol(s \ K), vol(V \ K) < θ` (regularity) and an Urysohn function `φ`, `1` on `K`, `0` off `V`;
  -- then `|φ c − c 1_s| ≤ |c| (1_{V \ K} + 1_{s \ K})`.
  obtain ⟨h, hfh₀, hhc, hhcont⟩ : ∃ h : Euclid n → ℝ,
      eLpNorm (f - h) 1 volume ≤ ENNReal.ofReal (ε / 4) ∧ HasCompactSupport h ∧ Continuous h := by
    have hf1 : MemLp f 1 volume := memLp_one_iff_integrable.2 hf
    have hε4 : ENNReal.ofReal (ε / 4) ≠ 0 := by simp; positivity
    have hadd : ∀ g₁ g₂ : Euclid n → ℝ, HasCompactSupport g₁ ∧ Continuous g₁ →
        HasCompactSupport g₂ ∧ Continuous g₂ → HasCompactSupport (g₁ + g₂) ∧ Continuous (g₁ + g₂) :=
      fun g₁ g₂ h₁ h₂ => ⟨h₁.1.add h₂.1, h₁.2.add h₂.2⟩
    refine hf1.induction_dense ENNReal.one_ne_top (fun g => HasCompactSupport g ∧ Continuous g) ?_
      hadd hε4
    intro c s hs hsμ δ hδ
    obtain ⟨θ, hθ, hθδ⟩ := ENNReal.exists_nnreal_pos_mul_lt (a := 2 * ‖c‖ₑ)
      (ENNReal.mul_ne_top ENNReal.ofNat_ne_top enorm_ne_top) hδ
    have hθ0 : (θ : ℝ≥0∞) ≠ 0 := ENNReal.coe_ne_zero.2 hθ.ne'
    obtain ⟨K, hKs, hK, hKcl, hsK⟩ := hs.exists_isCompact_isClosed_sdiff_lt hsμ.ne hθ0
    obtain ⟨V, hKV, hV, -, hVK⟩ :=
      hKcl.measurableSet.exists_isOpen_sdiff_lt ((measure_mono hKs).trans_lt hsμ).ne hθ0
    obtain ⟨φ, hφK, hφV, hφc, hφ01⟩ :=
      exists_continuous_one_zero_of_isCompact hK hV.isClosed_compl
        (disjoint_compl_right_iff_subset.2 hKV)
    have hgc : Continuous fun x => φ x * c := φ.continuous.mul continuous_const
    have hgs : HasCompactSupport fun x => φ x * c := hφc.mul_right (f' := fun _ => c)
    refine ⟨fun x => φ x * c, ?_, hgs, hgc⟩
    have hpt : ∀ x, ‖φ x * c - s.indicator (fun _ => c) x‖ₑ ≤
        (V \ K).indicator (fun _ => ‖c‖ₑ) x + (s \ K).indicator (fun _ => ‖c‖ₑ) x := by
      intro x
      by_cases hxK : x ∈ K
      · have h1 : φ x = 1 := hφK hxK
        simp [h1, hKs hxK]
      by_cases hxV : x ∈ V
      · rw [indicator_of_mem (mem_sdiff_of_mem hxV hxK)]
        refine le_trans ?_ le_self_add
        rw [enorm_le_iff_norm_le, Real.norm_eq_abs, Real.norm_eq_abs]
        obtain ⟨h0, h1⟩ := hφ01 x
        by_cases hxs : x ∈ s
        · rw [indicator_of_mem hxs, show φ x * c - c = (φ x - 1) * c by ring, abs_mul]
          exact mul_le_of_le_one_left (abs_nonneg _) (abs_le.2 ⟨by linarith, by linarith⟩)
        · rw [indicator_of_notMem hxs, sub_zero, abs_mul, abs_of_nonneg h0]
          exact mul_le_of_le_one_left (abs_nonneg _) h1
      · have h0 : φ x = 0 := hφV hxV
        rw [indicator_of_notMem (s := V \ K) fun hx => hxV hx.1, zero_add]
        by_cases hxs : x ∈ s
        · rw [indicator_of_mem hxs, indicator_of_mem (mem_sdiff_of_mem hxs hxK), h0]
          simp
        · simp [hxs, h0]
    rw [eLpNorm_one_eq_lintegral_enorm
      (hgc.aestronglyMeasurable.sub (aestronglyMeasurable_const.indicator hs))]
    calc ∫⁻ x, ‖φ x * c - s.indicator (fun _ => c) x‖ₑ
        ≤ ∫⁻ x, ((V \ K).indicator (fun _ => ‖c‖ₑ) x + (s \ K).indicator (fun _ => ‖c‖ₑ) x) :=
          lintegral_mono hpt
      _ = ‖c‖ₑ * volume (V \ K) + ‖c‖ₑ * volume (s \ K) := by
          rw [lintegral_add_left
              (measurable_const.indicator (hV.measurableSet.diff hKcl.measurableSet)),
            lintegral_indicator_const (hV.measurableSet.diff hKcl.measurableSet),
            lintegral_indicator_const (hs.diff hKcl.measurableSet)]
      _ ≤ ‖c‖ₑ * θ + ‖c‖ₑ * θ := by gcongr
      _ = θ * (2 * ‖c‖ₑ) := by ring
      _ ≤ δ := hθδ.le
  have hhi : Integrable h := hhcont.integrable_of_hasCompactSupport hhc
  have hfh : ∫⁻ x, ‖f x - h x‖ₑ ≤ ENNReal.ofReal (ε / 4) := by
    rwa [eLpNorm_one_eq_lintegral_enorm (hf.sub hhi).aestronglyMeasurable] at hfh₀
  -- Step 3: `S` is a closed ball containing `spt h` and its `1`-neighbourhood, and `r ≤ 1` is
  -- such that `|h(a) − h(b)| < η` whenever `|a − b| < r`.
  obtain ⟨R, hR⟩ := hhc.isCompact.isBounded.subset_closedBall (0 : Euclid n)
  set S : Set (Euclid n) := closedBall (0 : Euclid n) (R + 1)
  have hSm : MeasurableSet S := measurableSet_closedBall
  have hSfin : volume S < ∞ := measure_closedBall_lt_top
  set η : ℝ := ε / (4 * ((volume S).toReal + 1)) with hη_def
  have hη : 0 < η := by positivity
  obtain ⟨r₀, hr₀, hr₀h⟩ :=
    Metric.uniformContinuous_iff.1 (hhc.uniformContinuous_of_continuous hhcont) η hη
  refine ⟨min r₀ 1, lt_min hr₀ one_pos, ?_⟩
  intro ρ hρc hρnn hρint hρsupp
  have hρcs : HasCompactSupport ρ := by
    refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid n) (min r₀ 1)) fun x hx => ?_
    by_contra hne
    exact hx (ball_subset_closedBall (hρsupp hne))
  have hρi : Integrable ρ := integrable_of_integral_eq_one hρint
  have hρ1 : ∫⁻ t, ‖ρ t‖ₑ = 1 := by
    have h1 := ofReal_integral_eq_lintegral_ofReal hρi (Eventually.of_forall hρnn)
    rw [hρint, ENNReal.ofReal_one] at h1
    rw [h1]
    congr 1; funext t
    rw [Real.enorm_eq_ofReal (hρnn t)]
  -- Step 1: `L¹` contraction, `∫ |ρ * g| ≤ ∫ |g|` (Tonelli and translation invariance).
  have contraction : ∀ g : Euclid n → ℝ, AEStronglyMeasurable g volume →
      ∫⁻ x, ‖convolution ρ g (ContinuousLinearMap.lsmul ℝ ℝ) volume x‖ₑ ≤ ∫⁻ x, ‖g x‖ₑ := by
    intro g hg
    have hmeas : AEMeasurable (uncurry fun x t =>
        ‖(ContinuousLinearMap.lsmul ℝ ℝ) (ρ t) (g (x - t))‖ₑ)
        ((volume : Measure (Euclid n)).prod volume) :=
      (hρc.aestronglyMeasurable.convolution_integrand (ContinuousLinearMap.lsmul ℝ ℝ) hg).enorm
    calc ∫⁻ x, ‖convolution ρ g (ContinuousLinearMap.lsmul ℝ ℝ) volume x‖ₑ
        ≤ ∫⁻ x, ∫⁻ t, ‖(ContinuousLinearMap.lsmul ℝ ℝ) (ρ t) (g (x - t))‖ₑ :=
          lintegral_mono fun x => by
            rw [convolution_def]
            exact enorm_integral_le_lintegral_enorm _
      _ = ∫⁻ t, ∫⁻ x, ‖(ContinuousLinearMap.lsmul ℝ ℝ) (ρ t) (g (x - t))‖ₑ :=
          lintegral_lintegral_swap hmeas
      _ = ∫⁻ t, ‖ρ t‖ₑ * ∫⁻ x, ‖g x‖ₑ := by
          congr 1; funext t
          simp only [ContinuousLinearMap.lsmul_apply, smul_eq_mul, enorm_mul]
          rw [lintegral_const_mul' _ _ enorm_ne_top,
            lintegral_sub_right_eq_self (fun x => ‖g x‖ₑ) t]
      _ = ∫⁻ x, ‖g x‖ₑ := by
          rw [lintegral_mul_const _ hρc.measurable.enorm, hρ1, one_mul]
  set L := ContinuousLinearMap.lsmul ℝ ℝ (E := ℝ)
  have hhloc : LocallyIntegrable h volume := hhi.locallyIntegrable
  have hfhloc : LocallyIntegrable (f - h) volume := (hf.sub hhi).locallyIntegrable
  -- Step 5: linearity, `ρ * f − ρ * h = ρ * (f − h)`.
  have hlin : ∀ x, convolution ρ f L volume x - convolution ρ h L volume x =
      convolution ρ (f - h) L volume x := by
    intro x
    have e1 := hρcs.convolutionExists_left L hρc hhloc x
    have e2 := hρcs.convolutionExists_left L hρc hfhloc x
    have e3 := e1.distrib_add e2
    rw [show h + (f - h) = f by funext y; simp] at e3
    rw [e3]; ring
  -- Step 4: `|ρ * h − h| ≤ η` everywhere (`dist_convolution_le`), and `ρ * h − h = 0` off `S`.
  have hRle : min r₀ 1 ≤ r₀ := min_le_left _ _
  have hpt : ∀ x, ‖convolution ρ h L volume x - h x‖ₑ ≤
      S.indicator (fun _ => ENNReal.ofReal η) x := by
    intro x
    by_cases hx : x ∈ S
    · rw [indicator_of_mem hx]
      have hd := dist_convolution_le (μ := volume) (f := ρ) (g := h) (x₀ := x) (R := min r₀ 1)
        (ε := η) (z₀ := h x) hη.le hρsupp hρnn hρint hhcont.aestronglyMeasurable
        (fun y hy => (hr₀h (lt_of_lt_of_le (mem_ball.1 hy) hRle)).le)
      rw [dist_eq_norm] at hd
      rw [← ofReal_norm]
      exact ENNReal.ofReal_le_ofReal hd
    · rw [indicator_of_notMem hx]
      have h1 : h x = 0 := by
        by_contra hne
        exact hx (closedBall_subset_closedBall (by linarith) (hR (subset_tsupport _ hne)))
      have h2 : convolution ρ h L volume x = 0 := by
        by_contra hne
        obtain ⟨a, ha, t, ht, rfl⟩ := support_convolution_subset_swap L hne
        have ha' : ‖a‖ ≤ R := mem_closedBall_zero_iff.1 (hR (subset_tsupport _ ha))
        have ht' : ‖t‖ < min r₀ 1 := mem_ball_zero_iff.1 (hρsupp ht)
        exact hx (mem_closedBall_zero_iff.2
          ((norm_add_le a t).trans (by linarith [min_le_right r₀ 1])))
      simp [h1, h2]
  have hstep4 : ∫⁻ x, ‖convolution ρ h L volume x - h x‖ₑ ≤ ENNReal.ofReal (ε / 4) := by
    calc ∫⁻ x, ‖convolution ρ h L volume x - h x‖ₑ
        ≤ ∫⁻ x, S.indicator (fun _ => ENNReal.ofReal η) x := lintegral_mono hpt
      _ = ENNReal.ofReal η * volume S := lintegral_indicator_const hSm _
      _ = ENNReal.ofReal (η * (volume S).toReal) := by
          rw [ENNReal.ofReal_mul hη.le, ENNReal.ofReal_toReal hSfin.ne]
      _ ≤ ENNReal.ofReal (ε / 4) := by
          apply ENNReal.ofReal_le_ofReal
          have hV : 0 ≤ (volume S).toReal := ENNReal.toReal_nonneg
          rw [hη_def, div_mul_eq_mul_div, div_le_div_iff₀ (by positivity) (by positivity)]
          nlinarith
  -- Step 6: `ρ * f − f = ρ * (f − h) + (ρ * h − h) − (f − h)`; each term is at most `ε / 4`.
  have hpt2 : ∀ x, ‖convolution ρ f L volume x - f x‖ₑ ≤
      ‖convolution ρ (f - h) L volume x‖ₑ + ‖convolution ρ h L volume x - h x‖ₑ +
        ‖f x - h x‖ₑ := by
    intro x
    have e : convolution ρ f L volume x - f x = convolution ρ (f - h) L volume x +
        (convolution ρ h L volume x - h x) - (f x - h x) := by
      rw [← hlin x]; ring
    rw [e]
    exact (enorm_sub_le).trans (add_le_add_left (enorm_add_le _ _) _)
  have hc1 : Continuous (convolution ρ (f - h) L volume) :=
    hρcs.continuous_convolution_left L hρc hfhloc
  have hc2 : Continuous (convolution ρ h L volume) :=
    hρcs.continuous_convolution_left L hρc hhloc
  have hm1 : AEMeasurable (fun x => ‖convolution ρ (f - h) L volume x‖ₑ) volume :=
    hc1.measurable.enorm.aemeasurable
  have hm2 : AEMeasurable (fun x => ‖convolution ρ h L volume x - h x‖ₑ) volume :=
    (hc2.sub hhcont).measurable.enorm.aemeasurable
  calc ∫⁻ x, ‖convolution ρ f L volume x - f x‖ₑ
      ≤ ∫⁻ x, (‖convolution ρ (f - h) L volume x‖ₑ + ‖convolution ρ h L volume x - h x‖ₑ +
          ‖f x - h x‖ₑ) := lintegral_mono hpt2
    _ = (∫⁻ x, ‖convolution ρ (f - h) L volume x‖ₑ) +
          (∫⁻ x, ‖convolution ρ h L volume x - h x‖ₑ) + ∫⁻ x, ‖f x - h x‖ₑ := by
        have h12 : AEMeasurable (fun x => ‖convolution ρ (f - h) L volume x‖ₑ +
            ‖convolution ρ h L volume x - h x‖ₑ) volume := hm1.add hm2
        rw [lintegral_add_left' h12, lintegral_add_left' hm1]
    _ ≤ ENNReal.ofReal (ε / 4) + ENNReal.ofReal (ε / 4) + ENNReal.ofReal (ε / 4) := by
        refine add_le_add (add_le_add ?_ hstep4) hfh
        exact (contraction (f - h) (hf.sub hhi).aestronglyMeasurable).trans hfh
    _ = ENNReal.ofReal (3 * ε / 4) := by
        rw [← ENNReal.ofReal_add (by positivity) (by positivity),
          ← ENNReal.ofReal_add (by positivity) (by positivity)]
        ring_nf
    _ ≤ ENNReal.ofReal ε := ENNReal.ofReal_le_ofReal (by linarith)

/-- `C¹` approximation on `Q_δ` with total variation at most `V` (Simon Ch. 2, 2.5 as used in
2.7): the mollifications `v_k = φ_k * 1_{Q₁} u` by the even normalized bumps `φ_k` of radius
`σ_k = δ / (k + 2) < δ` satisfy `∫_{Q_δ} ‖Dv_k‖ ≤ V` (duality with smoothed unit fields, which are
admissible test fields since `σ_k < δ`), and `v_k → 1_{Q₁} u` in `L¹`, where `1_{Q₁} u = u` on
`Q_δ`. -/
theorem dimred_mbl_dt_cbm_smooth_approx : ∀ (m : ℕ) (u : Euclid (m + 1) → ℝ) (V δ : ℝ), IntegrableOn u {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ y, ‖g y‖ ≤ 1) → ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, u y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) ≤ V) → 0 < δ → ∃ v : ℕ → Euclid (m + 1) → ℝ, (∀ k, ContDiff ℝ 1 (v k)) ∧ (∀ k, ∫ x in {z : Euclid (m + 1) | ∀ i, δ < z i ∧ z i < 1 - δ}, ‖fderiv ℝ (v k) x‖ ≤ V) ∧ Tendsto (fun k => ∫ x in {z : Euclid (m + 1) | ∀ i, δ < z i ∧ z i < 1 - δ}, |v k x - u x|) atTop (𝓝 0) := by
  have grad_bound := Submission.dimred_mbl_dt_cbm_sa_grad_bound
  have mollify_l1 := Submission.dimred_mbl_dt_cbm_sa_mollify_l1
  intro m u V δ hu hyp hδ
  set Q1 : Set (Euclid (m + 1)) := {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}
  set Qd : Set (Euclid (m + 1)) := {z : Euclid (m + 1) | ∀ i, δ < z i ∧ z i < 1 - δ}
  -- Step 1: `Q₁` and `Q_δ ⊆ Q₁` are measurable, and `ū = 1_{Q₁} u` is integrable.
  have hQ1m : MeasurableSet Q1 := by
    have : Q1 = ⋂ i, ({y : Euclid (m + 1) | 0 < y i} ∩ {y : Euclid (m + 1) | y i < 1}) := by
      ext y; simp [Q1]
    rw [this]
    refine MeasurableSet.iInter fun i => ?_
    exact (measurableSet_lt measurable_const (by fun_prop)).inter
      (measurableSet_lt (by fun_prop) measurable_const)
  have hQdm : MeasurableSet Qd := by
    have : Qd = ⋂ i, ({y : Euclid (m + 1) | δ < y i} ∩ {y : Euclid (m + 1) | y i < 1 - δ}) := by
      ext y; simp [Qd]
    rw [this]
    refine MeasurableSet.iInter fun i => ?_
    exact (measurableSet_lt measurable_const (by fun_prop)).inter
      (measurableSet_lt (by fun_prop) measurable_const)
  have hQdQ1 : Qd ⊆ Q1 := by
    intro y hy i
    obtain ⟨h1, h2⟩ := hy i
    exact ⟨by linarith, by linarith⟩
  set ubar : Euclid (m + 1) → ℝ := Q1.indicator u
  have hubar : Integrable ubar := (integrable_indicator_iff hQ1m).2 hu
  -- The radii `σ_k = δ / (k + 2) ∈ (0, δ)` and the even normalized bumps `φ_k ≥ 0`, `∫ φ_k = 1`,
  -- with support `B_{σ_k}(0)`.
  set σ : ℕ → ℝ := fun k => δ / ((k : ℝ) + 2)
  have hσpos : ∀ k, 0 < σ k := fun k => by
    simp only [σ]; positivity
  have hσlt : ∀ k, σ k < δ := fun k => by
    simp only [σ]
    rw [div_lt_iff₀ (by positivity)]
    have : (0 : ℝ) ≤ k := Nat.cast_nonneg k
    nlinarith
  let φ : ℕ → ContDiffBump (0 : Euclid (m + 1)) := fun k =>
    ⟨σ k / 2, σ k, by linarith [hσpos k], by linarith [hσpos k]⟩
  set ρ : ℕ → Euclid (m + 1) → ℝ := fun k => (φ k).normed volume
  have hρc : ∀ k, HasCompactSupport (ρ k) := fun k => (φ k).hasCompactSupport_normed (μ := volume)
  have hρs : ∀ k, ContDiff ℝ (⊤ : ℕ∞) (ρ k) := fun k => (φ k).contDiff_normed (μ := volume)
  have hρ1 : ∀ k, ContDiff ℝ (1 : ℕ∞) (ρ k) := fun k => (φ k).contDiff_normed (μ := volume)
  have hρcont : ∀ k, Continuous (ρ k) := fun k => (φ k).continuous_normed (μ := volume)
  have hρnn : ∀ k z, 0 ≤ ρ k z := fun k z => (φ k).nonneg_normed (μ := volume) z
  have hρeven : ∀ k z, ρ k (-z) = ρ k z := fun k z => (φ k).normed_neg (μ := volume) z
  have hρint : ∀ k, ∫ z, ρ k z = 1 := fun k => (φ k).integral_normed (μ := volume)
  have hρsupp : ∀ k, support (ρ k) = ball (0 : Euclid (m + 1)) (σ k) := fun k =>
    (φ k).support_normed_eq (μ := volume)
  -- Step 5: `v_k = φ_k * ū`.
  refine ⟨fun k => convolution (ρ k) ubar (ContinuousLinearMap.lsmul ℝ ℝ) volume, ?_, ?_, ?_⟩
  · -- Step 2: `v_k` is `C¹` (differentiation under the integral sign).
    intro k
    have h := (hρc k).contDiff_convolution_left
      (ContinuousLinearMap.lsmul ℝ ℝ) (hρ1 k) hubar.locallyIntegrable (μ := volume)
    simpa using h
  · -- Step 3: the gradient bound on `Q_δ`, since `σ_k < δ`.
    intro k
    exact grad_bound m u V δ (σ k) (ρ k) hu hyp (hσpos k) (hσlt k) (hρs k)
      (hρnn k) (hρeven k) (hρint k) (hρsupp k).le
  · -- Step 4: `∫_{Q_δ} |v_k − u| = ∫_{Q_δ} |v_k − ū| ≤ ∫ |v_k − ū| ≤ ε / 2` once `σ_k < r`.
    rw [Metric.tendsto_atTop]
    intro ε hε
    obtain ⟨r, hr, hρr⟩ := mollify_l1 (m + 1) ubar hubar (ε / 2) (by positivity)
    obtain ⟨N, hN⟩ := exists_nat_gt (δ / r)
    refine ⟨N, fun k hk => ?_⟩
    have hσr : σ k < r := by
      simp only [σ]
      rw [div_lt_iff₀ (by positivity)]
      have hkN : (N : ℝ) ≤ k := by exact_mod_cast hk
      have : δ < r * N := by
        rw [div_lt_iff₀ hr] at hN; linarith
      nlinarith
    have hl := hρr (ρ k) (hρcont k) (hρnn k) (hρint k)
      (by rw [hρsupp k]; exact ball_subset_ball hσr.le)
    set w : Euclid (m + 1) → ℝ := convolution (ρ k) ubar (ContinuousLinearMap.lsmul ℝ ℝ) volume
    have hwc : Continuous w :=
      (hρc k).continuous_convolution_left _ (hρcont k) hubar.locallyIntegrable
    have heq : ∫ x in Qd, |w x - u x| = ∫ x in Qd, |w x - ubar x| := by
      refine setIntegral_congr_fun hQdm fun x hx => ?_
      simp only [ubar, indicator_of_mem (hQdQ1 hx)]
    have hmeas : AEStronglyMeasurable (fun x => |w x - ubar x|) (volume.restrict Qd) :=
      ((hwc.aestronglyMeasurable.sub hubar.aestronglyMeasurable).norm).restrict
    have hlin : ∫ x in Qd, |w x - ubar x| =
        (∫⁻ x in Qd, ENNReal.ofReal |w x - ubar x|).toReal :=
      integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall fun x => abs_nonneg _) hmeas
    have hle : (∫⁻ x in Qd, ENNReal.ofReal |w x - ubar x|) ≤ ENNReal.ofReal (ε / 2) := by
      refine le_trans (setLIntegral_le_lintegral _ _) ?_
      refine le_trans (le_of_eq ?_) hl
      congr 1; funext x; rw [Real.enorm_eq_ofReal_abs]
    have hnn : 0 ≤ ∫ x in Qd, |w x - u x| := integral_nonneg fun x => abs_nonneg _
    rw [Real.dist_eq, sub_zero, abs_of_nonneg hnn, heq, hlin]
    calc (∫⁻ x in Qd, ENNReal.ofReal |w x - ubar x|).toReal ≤ ε / 2 :=
          ENNReal.toReal_le_of_le_ofReal (by positivity) hle
      _ < ε := by linarith

/-- Mollification does not increase the variation (Simon Ch. 2, Lemma 2.5, formula (4)): if
`|∫ u div g| ≤ M` for every `g ∈ C¹_c(ℝᴾ; ℝᴾ)` with `|g| ≤ 1`, then `∫ |D(η * u)| ≤ M` for an even
mollifier `η ≥ 0` with `∫ η = 1`.  With `w = η * u`, the field `s = 1_{spt w} |∇w|⁻¹ ∇w`
(`0⁻¹ = 0`) is Borel, bounded by `1`, compactly supported and has `Dw(s) = |Dw|`;
`codim1_rdo_dg_sp_mollifier_adjoint` moves `η` onto `s`, and `g = η * s` is admissible. -/
theorem codim1_rdo_dg_sp_mollify_variation : ∀ (P : ℕ) (u : Euclid P → ℝ) (M : ℝ), Integrable u → HasCompactSupport u → (∀ g : Euclid P → Euclid P, ContDiff ℝ 1 g → HasCompactSupport g → (∀ z, ‖g z‖ ≤ 1) → |∫ z, u z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ g z : Euclid P →ₗ[ℝ] Euclid P)| ≤ M) → ∀ η : Euclid P → ℝ, ContDiff ℝ 1 η → HasCompactSupport η → (∀ z, 0 ≤ η z) → (∀ z, η (-z) = η z) → ∫ z, η z = 1 → ∫ z, ‖fderiv ℝ (convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume) z‖ ≤ M := by
  intro P u M hu huc hM η hη hηc hη0 heven hη1
  -- Step 1: `w = η * u` is `C¹` with compact support `S = spt w`.
  set w := convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume
  have hwc : HasCompactSupport w := hηc.convolution _ huc
  have hDw : Continuous (fderiv ℝ w) :=
    (hηc.contDiff_convolution_left _ hη hu.locallyIntegrable).continuous_fderiv one_ne_zero
  set S := tsupport w
  have hSm : MeasurableSet S := (isClosed_tsupport w).measurableSet
  -- Step 2: the gradient `∇w = (toDual)⁻¹ Dw` is continuous, `|∇w| = |Dw|`, `Dw(∇w) = |∇w|²`.
  set grad : Euclid P → Euclid P :=
    fun x => (InnerProductSpace.toDual ℝ (Euclid P)).symm (fderiv ℝ w x)
  have hgc : Continuous grad := (InnerProductSpace.toDual ℝ (Euclid P)).symm.continuous.comp hDw
  have hgn : ∀ x, ‖grad x‖ = ‖fderiv ℝ w x‖ := fun x => LinearIsometryEquiv.norm_map _ _
  have hgg : ∀ x, fderiv ℝ w x (grad x) = ‖grad x‖ ^ 2 := by
    intro x
    rw [← InnerProductSpace.toDual_symm_apply (𝕜 := ℝ) (x := grad x) (y := fderiv ℝ w x)]
    exact real_inner_self_eq_norm_sq _
  -- Step 3: the unit field `f = |∇w|⁻¹ ∇w` (`0⁻¹ = 0`) and `s = 1_S f`.
  set f : Euclid P → Euclid P := fun x => ‖grad x‖⁻¹ • grad x with hf
  have hfm : Measurable f := hgc.norm.measurable.inv.smul hgc.measurable
  have hf1 : ∀ x, ‖f x‖ ≤ 1 := by
    intro x
    simp only [hf, norm_smul, norm_inv, norm_norm]
    rcases eq_or_ne ‖grad x‖ 0 with h | h
    · simp [h]
    · rw [inv_mul_cancel₀ h]
  set s : Euclid P → Euclid P := S.indicator f with hs
  have hs1 : ∀ x, ‖s x‖ ≤ 1 := fun x => (norm_indicator_le_norm_self f x).trans (hf1 x)
  have hsc : HasCompactSupport s :=
    HasCompactSupport.intro hwc.isCompact fun x hx => indicator_of_notMem hx f
  have hsi : Integrable s := by
    rw [hs, integrable_indicator_iff hSm]
    exact Measure.integrableOn_of_bounded hwc.isCompact.measure_lt_top.ne
      hfm.aestronglyMeasurable (Eventually.of_forall hf1)
  -- Step 4: `Dw(x)(s x) = |Dw(x)|` for all `x`.
  have hDs : ∀ x, fderiv ℝ w x (s x) = ‖fderiv ℝ w x‖ := by
    intro x
    by_cases hx : x ∈ S
    · simp only [hs, indicator_of_mem hx, hf, map_smul, hgg, smul_eq_mul, ← hgn]
      rcases eq_or_ne ‖grad x‖ 0 with h | h
      · simp [h]
      · field_simp
    · rw [fderiv_of_notMem_tsupport ℝ hx]
      simp
  -- Step 5: `g = η * s` is admissible: `C¹`, compact support, `|g| ≤ ∫ η = 1`.
  set g := convolution η s (ContinuousLinearMap.lsmul ℝ ℝ) volume with hg
  have hgC1 : ContDiff ℝ 1 g := hηc.contDiff_convolution_left _ hη hsi.locallyIntegrable
  have hgcs : HasCompactSupport g := hηc.convolution _ hsc
  have hηi : Integrable η := hη.continuous.integrable_of_hasCompactSupport hηc
  have hg1 : ∀ z, ‖g z‖ ≤ 1 := by
    intro z
    rw [hg, convolution_def]
    refine (norm_integral_le_of_norm_le hηi (Eventually.of_forall fun t => ?_)).trans hη1.le
    rw [ContinuousLinearMap.lsmul_apply, norm_smul, Real.norm_of_nonneg (hη0 t)]
    exact mul_le_of_le_one_right (hη0 t) (hs1 _)
  -- Steps 6–7: the adjoint identity, then the hypothesis for `g`.
  calc ∫ z, ‖fderiv ℝ w z‖ = ∫ z, fderiv ℝ w z (s z) :=
        integral_congr_ae (Eventually.of_forall fun z => (hDs z).symm)
    _ = -∫ z, u z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ g z : Euclid P →ₗ[ℝ] Euclid P) :=
        Submission.codim1_rdo_dg_sp_mollifier_adjoint P η u s hη hηc heven hu hsi
    _ ≤ |∫ z, u z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ g z : Euclid P →ₗ[ℝ] Euclid P)| :=
        neg_le_abs _
    _ ≤ M := hM g hgC1 hgcs hg1

/-- **Integer density, layers and truncation bounds** (Simon Ch. 6, first step and (3)–(7) of the
proof of 3.14; Remarks 2.35, 3.15; Ch. 2, Lemma 2.5).  An integer multiplicity `R ∈ 𝒟_{n+1}(ℝ^{n+1})`
with compact support is `R(ω) = ∫ θ ω(e)` for an integrable integer density `θ` vanishing off
`spt R`: an orientation of an `(n+1)`-plane in `ℝ^{n+1}` is `±e₀ ∧ ⋯ ∧ eₙ`, and `θ = 0` a.e. off
`spt R` by `dtc_vanish_off_support`.  The layers `Uⱼ = {θ ≥ j}` give `Xⱼ = [[Uⱼ]]` with
`Σⱼ ∂Xⱼ = ∂R` (dominated convergence, `∫ dη(e) = 0`).  For the mass bounds, `∂R` tested with `⋆g`
bounds `∫ θ div g` for smooth fields `|g| ≤ 1`; for an admissible `η`, integration by parts and
`codim1_rdo_dg_sp_mollifier_adjoint` give `∫ Ψ(ρₖ * θ) dη(e) ≤ M(∂R)` for Simon's smoothed
truncations `Ψ` (`|Ψ'| ≤ 1`, `Ψ = (1 - 4δ) Σⱼ 1_{[j,∞)}` on `ℤ`); letting `k → ∞` (Lebesgue
differentiation) and `δ → 0` bounds `M(Σ_{j=a}^b ∂Xⱼ)`. -/
theorem dtc_bc_lc_fd_bim_layers : ∀ (n : ℕ) (R : GeometricCurrentOn (univ : Set (Euclid (n + 1))) (n + 1)), IsIntegerMultiplicity R → IsCompact R.support → ∃ (U : ℤ → Set (Euclid (n + 1))) (X : ℤ → GeometricCurrentOn (univ : Set (Euclid (n + 1))) (n + 1)), (∀ j, MeasurableSet (U j)) ∧ (∀ j, U (j + 1) ⊆ U j) ∧ (∀ (j : ℤ) (ω : TestFormOn (univ : Set (Euclid (n + 1))) (n + 1)), X j ω = ∫ x in U j, (ω : DifferentialForm (Euclid (n + 1)) (n + 1)) x (fun i => EuclideanSpace.single i (1 : ℝ))) ∧ (∀ η : TestFormOn (univ : Set (Euclid (n + 1))) n, HasSum (fun j => (X j).boundary η) (R.boundary η)) ∧ (∀ j, (X j).boundary.mass ≤ R.boundary.mass) ∧ ∀ (N : ℕ) (Y : GeometricCurrentOn (univ : Set (Euclid (n + 1))) n), (∀ η : TestFormOn (univ : Set (Euclid (n + 1))) n, Y η = ∑ j ∈ Finset.Icc (-(N : ℤ)) N, (X j).boundary η) → Y.mass ≤ R.boundary.mass := by
  intro n R hIM hcpt
  classical
  -- Step 1. The determinant covector `D` of the standard basis `e`: `α = α(e) D` for every
  -- `(n+1)`-covector `α`, and `D(τ) = ±1` for orthonormal `τ`.
  obtain ⟨D, hD, hDe, hαD⟩ : ∃ D : Covector (Euclid (n + 1)) (n + 1),
      (∀ v, D v = (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis.det v) ∧
      D (fun i => EuclideanSpace.single i (1 : ℝ)) = 1 ∧
      (∀ (α : Covector (Euclid (n + 1)) (n + 1)) (v : Fin (n + 1) → Euclid (n + 1)),
        α v = α (fun i => EuclideanSpace.single i (1 : ℝ)) * D v) := by
    have hcont : Continuous fun v : Fin (n + 1) → Euclid (n + 1) =>
        (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis.det v := by
      simp only [Module.Basis.det_apply]
      refine Continuous.matrix_det (continuous_pi fun i => continuous_pi fun j => ?_)
      simp only [Module.Basis.toMatrix_apply, OrthonormalBasis.coe_toBasis_repr_apply,
        EuclideanSpace.basisFun_repr]
      exact (EuclideanSpace.proj i).continuous.comp (continuous_apply j)
    have hbe : ⇑(EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis =
        fun i => EuclideanSpace.single i (1 : ℝ) := by
      funext i; simp
    refine ⟨⟨⟨(EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis.det.toMultilinearMap, hcont⟩,
      (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis.det.map_eq_zero_of_eq'⟩, fun v => rfl, ?_, ?_⟩
    · change (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis.det _ = 1
      rw [← hbe, Module.Basis.det_self]
    · intro α v
      have h := AlternatingMap.eq_smul_basis_det (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis
        α.toAlternatingMap
      rw [hbe] at h
      exact congrArg (fun f : Euclid (n + 1) [⋀^Fin (n + 1)]→ₗ[ℝ] ℝ => f v) h
  have hDτ : ∀ τ : Fin (n + 1) → Euclid (n + 1), Orthonormal ℝ τ → D τ = 1 ∨ D τ = -1 := by
    intro τ hτ
    have hsp := hτ.linearIndependent.span_eq_top_of_card_eq_finrank'
      (by rw [finrank_euclideanSpace, Fintype.card_fin])
    have h := OrthonormalBasis.det_to_matrix_orthonormalBasis_real
      (EuclideanSpace.basisFun (Fin (n + 1)) ℝ) (OrthonormalBasis.mk hτ hsp.ge)
    rwa [OrthonormalBasis.coe_mk, ← hD] at h
  -- Step 2. `R` is given by an integrable integer density `θ` vanishing off `spt R`.
  obtain ⟨θ, hθm, hθ0, hθi, hRθ⟩ : ∃ θ : Euclid (n + 1) → ℤ, Measurable θ ∧
      (∀ x ∉ R.support, θ x = 0) ∧ Integrable (fun x => (θ x : ℝ)) ∧
      ∀ ω : TestFormOn (univ : Set (Euclid (n + 1))) (n + 1),
        R ω = ∫ x, (θ x : ℝ) * (ω : DifferentialForm (Euclid (n + 1)) (n + 1)) x
          (fun i => EuclideanSpace.single i (1 : ℝ)) := by
    obtain ⟨Rep, hRep⟩ := hIM
    have hμ : (μHE[n + 1] : Measure (Euclid (n + 1))) = volume :=
      EuclideanSpace.euclideanHausdorffMeasure_eq_volume (n + 1)
    have hVm : MeasurableSet Rep.carrier := Rep.measurableSet_carrier
    -- `ξ(x)(α) = α(e) s(x)` with `s(x) = ξ(x)(D)`
    have horient : ∀ x (α : Covector (Euclid (n + 1)) (n + 1)), Rep.orient x α =
        α (fun i => EuclideanSpace.single i (1 : ℝ)) * Rep.orient x D := by
      intro x α
      have hα : α = α (fun i => EuclideanSpace.single i (1 : ℝ)) • D := by
        ext v
        rw [ContinuousAlternatingMap.smul_apply, smul_eq_mul]
        exact hαD α v
      conv_lhs => rw [hα]
      rw [map_smul, smul_eq_mul]
    have hsm : AEStronglyMeasurable (fun x => Rep.orient x D) (volume.restrict Rep.carrier) :=
      hμ ▸ (continuous_eval_const D).comp_aestronglyMeasurable Rep.aestronglyMeasurable_orient
    have hs1 : ∀ᵐ x ∂(volume.restrict Rep.carrier), Rep.orient x D = 1 ∨ Rep.orient x D = -1 := by
      rw [← hμ]
      filter_upwards [Rep.orients] with x hx
      obtain ⟨Q, -, τ, hτ, -, hξ⟩ := hx
      rcases hξ with h | h <;> rw [h D] <;> rcases hDτ τ hτ with h' | h' <;> rw [h']
      exacts [Or.inl rfl, Or.inr rfl, Or.inr rfl, Or.inl (neg_neg 1)]
    -- the integer density `θ₁ = ±θ₀` on `V`
    obtain ⟨s', hs'm, hss'⟩ : ∃ s' : Euclid (n + 1) → ℝ, Measurable s' ∧
        (fun x => Rep.orient x D) =ᵐ[volume.restrict Rep.carrier] s' :=
      ⟨_, hsm.stronglyMeasurable_mk.measurable, hsm.ae_eq_mk⟩
    obtain ⟨θ₁, hθ₁⟩ : ∃ θ₁ : Euclid (n + 1) → ℤ, ∀ x, θ₁ x = if x ∈ Rep.carrier then
        (if 0 < s' x then (Rep.mult x : ℤ) else -(Rep.mult x : ℤ)) else 0 := ⟨_, fun x => rfl⟩
    have hθ₁m : Measurable θ₁ := (funext hθ₁ : θ₁ = _) ▸
      Measurable.ite hVm (Measurable.ite (measurableSet_lt measurable_const hs'm)
        (measurable_from_nat.comp Rep.measurable_mult)
        ((measurable_from_nat (f := fun m : ℕ => -(m : ℤ))).comp Rep.measurable_mult))
        measurable_const
    have hθ₁m' : Measurable fun x => (θ₁ x : ℝ) := measurable_from_top.comp hθ₁m
    have hθ₁ae : ∀ᵐ x ∂(volume.restrict Rep.carrier), ∀ α : Covector (Euclid (n + 1)) (n + 1),
        (Rep.mult x : ℝ) * Rep.orient x α = (θ₁ x : ℝ) * α (fun i => EuclideanSpace.single i (1 : ℝ)) := by
      filter_upwards [hs1, hss', ae_restrict_mem hVm] with x hx hxs hxV α
      rw [horient x α, hθ₁ x, ite_eq_left hxV, ← hxs]
      rcases hx with h | h <;> rw [h]
      · rw [ite_eq_left one_pos, mul_one, Int.cast_natCast]
      · rw [ite_eq_right (lt_asymm neg_one_lt_zero), mul_neg_one, Int.cast_neg, Int.cast_natCast,
          neg_mul, mul_neg]
    -- `R(ω) = ∫ θ₁ ω(e)`
    have hRθ₁ : ∀ ω : TestFormOn (univ : Set (Euclid (n + 1))) (n + 1),
        R ω = ∫ x, (θ₁ x : ℝ) * (ω : DifferentialForm (Euclid (n + 1)) (n + 1)) x
          (fun i => EuclideanSpace.single i (1 : ℝ)) := by
      intro ω
      rw [hRep ω, IMRep.action, hμ, setIntegral_congr_ae hVm (by
          filter_upwards [ae_restrict_iff' hVm |>.1 hθ₁ae] with x hx hxV using hx hxV _)]
      refine setIntegral_eq_integral_of_forall_compl_eq_zero fun x hx => ?_
      rw [hθ₁ x, ite_eq_right hx, Int.cast_zero, zero_mul]
    -- local integrability of `θ₁`
    have hθ₁loc : LocallyIntegrable (fun x => (θ₁ x : ℝ)) volume := by
      rw [locallyIntegrable_iff]
      intro K hK
      refine ⟨hθ₁m'.aestronglyMeasurable, ?_⟩
      have hnorm : ∀ x, ‖(θ₁ x : ℝ)‖ₑ = Rep.carrier.indicator (fun x => (Rep.mult x : ℝ≥0∞)) x := by
        intro x
        rw [hθ₁ x]
        by_cases hx : x ∈ Rep.carrier
        · rw [ite_eq_left hx, indicator_of_mem hx]
          split_ifs
          · rw [Int.cast_natCast, Real.enorm_natCast]
          · rw [Int.cast_neg, Int.cast_natCast, enorm_neg, Real.enorm_natCast]
        · rw [ite_eq_right hx, indicator_of_notMem hx, Int.cast_zero, enorm_zero]
      rw [HasFiniteIntegral, lintegral_congr hnorm, lintegral_indicator hVm,
        Measure.restrict_restrict hVm, ← hμ]
      exact (Rep.locallyIntegrable_mult K hK (subset_univ K)).lt_top
    -- `θ₁ = 0` a.e. off `spt R`
    have hZ : ∀ᵐ x ∂volume, x ∈ R.zeroRegion → (θ₁ x : ℝ) = 0 := by
      refine R.isOpen_zeroRegion.ae_eq_zero_of_integral_contDiff_smul_eq_zero
        (hθ₁loc.locallyIntegrableOn _) fun g hg hgc hgZ => ?_
      have h0 := Submission.dtc_vanish_off_support (n + 1) (n + 1) univ R
        ⟨fun x => g x • D, ⟨⟨hg.smul_const D, hgc.smul_right⟩, subset_univ _⟩⟩
        (Set.disjoint_left.2 fun x hx hxR => hxR.2 (hgZ (tsupport_smul_subset_left _ _ hx)))
      rw [hRθ₁] at h0
      rw [← h0]
      refine integral_congr_ae (Eventually.of_forall fun x => ?_)
      change g x • (θ₁ x : ℝ) = (θ₁ x : ℝ) * (g x • D) (fun i => EuclideanSpace.single i (1 : ℝ))
      rw [ContinuousAlternatingMap.smul_apply, hDe, smul_eq_mul, smul_eq_mul, mul_one, mul_comm]
    -- `θ = θ₁ 1_{spt R}`
    have hSm : MeasurableSet R.support := MeasurableSet.univ.diff R.isOpen_zeroRegion.measurableSet
    refine ⟨fun x => if x ∈ R.support then θ₁ x else 0, Measurable.ite hSm hθ₁m measurable_const,
      fun x hx => ite_eq_right hx, ?_, fun ω => ?_⟩
    · refine ((integrable_indicator_iff hSm).2 (hθ₁loc.integrableOn_isCompact hcpt)).congr
        (Eventually.of_forall fun x => ?_)
      dsimp only
      by_cases hx : x ∈ R.support
      · rw [indicator_of_mem hx, ite_eq_left hx]
      · rw [indicator_of_notMem hx, ite_eq_right hx, Int.cast_zero]
    · rw [hRθ₁ ω]
      refine integral_congr_ae ?_
      filter_upwards [hZ] with x hx
      by_cases hxs : x ∈ R.support
      · rw [ite_eq_left hxs]
      · rw [ite_eq_right hxs, hx (by_contra fun h => hxs ⟨mem_univ x, h⟩), Int.cast_zero]
  have hθc : HasCompactSupport fun x => (θ x : ℝ) :=
    HasCompactSupport.intro hcpt fun x hx => by rw [hθ0 x hx, Int.cast_zero]
  -- Step 3. The currents `[[S]](ω) = ∫_S ω(e)`.
  have hcur : ∀ S : Set (Euclid (n + 1)), ∃ T : GeometricCurrentOn (univ : Set (Euclid (n + 1))) (n + 1),
      ∀ ω : TestFormOn (univ : Set (Euclid (n + 1))) (n + 1), T ω = ∫ x in S,
        (ω : DifferentialForm (Euclid (n + 1)) (n + 1)) x (fun i => EuclideanSpace.single i (1 : ℝ)) := by
    intro S
    have hint : ∀ ω : TestFormOn (univ : Set (Euclid (n + 1))) (n + 1),
        Integrable (fun x => (ω : DifferentialForm (Euclid (n + 1)) (n + 1)) x
          (fun i => EuclideanSpace.single i (1 : ℝ))) := fun ω =>
      ((continuous_eval_const _).comp ω.property.1.1.continuous).integrable_of_hasCompactSupport
        (ω.property.1.2.comp_left rfl)
    refine ⟨⟨{ toFun := (fun ω => ∫ x in S, (ω : DifferentialForm (Euclid (n + 1)) (n + 1)) x
                  (fun i => EuclideanSpace.single i (1 : ℝ))),
                map_add' := fun ω₁ ω₂ => integral_add (hint ω₁).integrableOn (hint ω₂).integrableOn,
                map_smul' := fun c ω => integral_const_mul c _ }, fun ωs hωs => ?_⟩, fun ω => rfl⟩
    obtain ⟨K, hK, -, hsupp, -, hconv⟩ := hωs
    have h0 := Metric.tendstoUniformlyOn_iff.1 (hconv 0)
    rw [Metric.tendsto_nhds]
    intro ε hε
    have hC : 0 ≤ volume.real K := measureReal_nonneg
    filter_upwards [h0 (ε / (volume.real K + 1)) (by positivity)] with j hj
    have hbd : ∀ x, ‖(ωs j : DifferentialForm (Euclid (n + 1)) (n + 1)) x
        (fun i => EuclideanSpace.single i (1 : ℝ))‖ ≤ K.indicator (fun _ => ε / (volume.real K + 1)) x := by
      intro x
      by_cases hx : x ∈ K
      · rw [indicator_of_mem hx]
        refine (((ωs j : DifferentialForm (Euclid (n + 1)) (n + 1)) x).le_opNorm _).trans ?_
        have h1 := hj x hx
        have hz : iteratedFDeriv ℝ 0 ((0 : TestFormOn (univ : Set (Euclid (n + 1))) (n + 1)) :
            DifferentialForm (Euclid (n + 1)) (n + 1)) x = 0 := by
          ext m; rw [iteratedFDeriv_zero_apply]; rfl
        rw [hz, dist_zero_left, norm_iteratedFDeriv_zero] at h1
        simp only [PiLp.norm_single, norm_one, Finset.prod_const_one, mul_one]
        exact h1.le
      · rw [indicator_of_notMem hx, image_eq_zero_of_notMem_tsupport (fun h => hx (hsupp j h))]
        simp
    rw [dist_zero_right]
    calc ‖∫ x in S, (ωs j : DifferentialForm (Euclid (n + 1)) (n + 1)) x
          (fun i => EuclideanSpace.single i (1 : ℝ))‖
        ≤ ∫ x in S, K.indicator (fun _ => ε / (volume.real K + 1)) x :=
          norm_integral_le_of_norm_le ((integrable_indicator_iff hK.measurableSet).2
            (integrableOn_const hK.measure_lt_top.ne)).integrableOn (Eventually.of_forall hbd)
      _ ≤ ∫ x, K.indicator (fun _ => ε / (volume.real K + 1)) x :=
          setIntegral_le_integral ((integrable_indicator_iff hK.measurableSet).2
            (integrableOn_const hK.measure_lt_top.ne)) (Eventually.of_forall fun x =>
              indicator_nonneg (fun _ _ => by positivity) x)
      _ = volume.real K * (ε / (volume.real K + 1)) := by
          rw [integral_indicator_const _ hK.measurableSet, smul_eq_mul]
      _ < ε := by
          rw [mul_div_assoc', div_lt_iff₀ (by positivity)]
          nlinarith
  choose X hX using fun j : ℤ => hcur {x | j ≤ θ x}
  -- Step 4. `∫ ∂ᵥh = 0` for `C¹` compactly supported `h` (translation invariance).
  have hS5 : ∀ (h : Euclid (n + 1) → ℝ) (h' : Euclid (n + 1) → Euclid (n + 1) →L[ℝ] ℝ),
      (∀ x, HasFDerivAt h (h' x) x) → Continuous h' → HasCompactSupport h →
        ∀ v, Integrable (fun x => h' x v) ∧ ∫ x, h' x v = 0 := by
    intro h h' hd hc hcs v
    have hcont : Continuous h := continuous_iff_continuousAt.2 fun x => (hd x).continuousAt
    have hcs' : HasCompactSupport h' := HasCompactSupport.intro hcs fun x hx =>
      (hd x).unique ((hasFDerivAt_const (0 : ℝ) x).congr_of_eventuallyEq
        (notMem_tsupport_iff_eventuallyEq.1 hx))
    obtain ⟨C, hC⟩ := hc.bounded_above_of_compact_support hcs'
    have hK : IsCompact (cthickening ‖v‖ (tsupport h')) := hcs'.isCompact.cthickening
    have key := hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := volume)
      (F := fun (t : ℝ) x => h (x + t • v)) (x₀ := 0)
      (bound := (cthickening ‖v‖ (tsupport h')).indicator fun _ => C * ‖v‖)
      (Metric.ball_mem_nhds 0 one_pos)
      (Eventually.of_forall fun t =>
        (hcont.comp (continuous_id.add continuous_const)).aestronglyMeasurable)
      (by simp only [zero_smul, add_zero]; exact hcont.integrable_of_hasCompactSupport hcs)
      (F' := fun t x => h' (x + t • v) v)
      ((hc.comp (continuous_id.add continuous_const)).clm_apply continuous_const).aestronglyMeasurable
      (Eventually.of_forall fun a t ht => by
        by_cases hmem : a + t • v ∈ tsupport h'
        · have haK : a ∈ cthickening ‖v‖ (tsupport h') := by
            refine mem_cthickening_of_dist_le a (a + t • v) ‖v‖ (tsupport h') hmem ?_
            rw [dist_self_add_right, norm_smul]
            rw [mem_ball_zero_iff] at ht
            exact mul_le_of_le_one_left (norm_nonneg v) ht.le
          rw [indicator_of_mem haK]
          exact ((h' _).le_opNorm v).trans (mul_le_mul_of_nonneg_right (hC _) (norm_nonneg _))
        · rw [image_eq_zero_of_notMem_tsupport hmem, zero_apply, norm_zero]
          exact indicator_nonneg (fun _ _ => (norm_nonneg _).trans ((h' 0).le_opNorm v |>.trans
            (mul_le_mul_of_nonneg_right (hC _) (norm_nonneg _)))) a)
      ((integrable_indicator_iff hK.measurableSet).2 (integrableOn_const hK.measure_lt_top.ne))
      (Eventually.of_forall fun a t _ => by
        have := (hd (a + t • v)).comp_hasDerivAt t (((hasDerivAt_id t).smul_const v).const_add a)
        rwa [one_smul] at this)
    have h1 := key.1
    have h2 := key.2
    rw [show (fun t : ℝ => ∫ x, h (x + t • v)) = fun _ => ∫ x, h x from
      funext fun t => integral_add_right_eq_self h (t • v)] at h2
    have h3 := h2.unique (hasDerivAt_const 0 _)
    simp only [zero_smul, add_zero] at h1 h3
    exact ⟨h1, h3⟩
  -- the vector field `φ_α = Σᵢ (-1)ⁱ α(e_î) eᵢ` of an `n`-covector `α`
  let Φ : Covector (Euclid (n + 1)) n →L[ℝ] Euclid (n + 1) :=
    (PiLp.continuousLinearEquiv 2 ℝ fun _ : Fin (n + 1) => ℝ).symm.toContinuousLinearMap.comp
      (ContinuousLinearMap.pi fun i => ((-1 : ℝ) ^ (i : ℕ)) • ContinuousAlternatingMap.apply ℝ
        (Euclid (n + 1)) ℝ (Fin.removeNth i fun i => EuclideanSpace.single i (1 : ℝ)))
  have hΦi : ∀ (α : Covector (Euclid (n + 1)) n) (i : Fin (n + 1)),
      Φ α i = (-1 : ℝ) ^ (i : ℕ) * α (Fin.removeNth i fun i => EuclideanSpace.single i (1 : ℝ)) :=
    fun α i => rfl
  have hΦ : ∀ (α : Covector (Euclid (n + 1)) n) (A : Euclid (n + 1) →L[ℝ] ℝ), A (Φ α) =
