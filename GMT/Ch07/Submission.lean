    have hB₃0 : 0 ≤ B₃ := (mul_nonneg h2AKω (Real.rpow_nonneg hR₁0.le _)).trans_eq hB₃.symm
    have hC₃0 : 0 ≤ C₃ := (mul_nonneg hca.le
