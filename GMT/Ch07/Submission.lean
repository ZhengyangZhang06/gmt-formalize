  obtain ⟨Hc, hHc_lip, hHc_eq⟩ : ∃ Hc : (Euclid P → Euclid P) → (Euclid P → Euclid P) →
      Set (Euclid P) → Euclid (P + 1) → Euclid P,
      (∀ (Λ : NNReal) (F G : Euclid P → Euclid P) (S : Set (Euclid P)), LipschitzWith Λ F →
        LipschitzWith Λ G → IsCompact S → ∃ L : NNReal, LipschitzWith L (Hc F G S)) ∧
      ∀ (F G : Euclid P → Euclid P) (S : Set (Euclid P)), IsCompact S → ∀ x ∈ S,
        ∀ t ∈ Icc (0 : ℝ) 1,
          Hc F G S (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x))) = F x + t • (G x - F x) := by
    -- a radius `R S` with `S ⊆ B̄(0, R S)` for every compact `S`
    have hR : ∀ S : Set (Euclid P), ∃ R : ℝ, IsCompact S → S ⊆ closedBall 0 R := by
      intro S
      by_cases hS : IsCompact S
      · obtain ⟨R, hR⟩ := hS.isBounded.subset_closedBall 0
        exact ⟨R, fun _ => hR⟩
      · exact ⟨0, fun h => absurd h hS⟩
    choose R hR using hR
    -- the coordinates `y = ι(y₀, tail y)` of `ℝ^{P+1}`; both are 1-Lipschitz
    let tl : Euclid (P + 1) → Euclid P := fun y => WithLp.toLp 2 (Fin.tail (WithLp.ofLp y))
    have htl : ∀ (t : ℝ) (x : Euclid P),
        tl (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x))) = x := by
      intro t x
      simp [tl]
    have htl_lip : ∀ y y' : Euclid (P + 1), dist (tl y) (tl y') ≤ dist y y' := by
      intro y y'
      rw [EuclideanSpace.dist_eq, EuclideanSpace.dist_eq]
      refine Real.sqrt_le_sqrt ?_
      rw [Fin.sum_univ_succ]
      exact le_add_of_nonneg_left (sq_nonneg _)
    have hfst_lip : LipschitzWith 1 (fun y : Euclid (P + 1) => y 0) :=
      LipschitzWith.of_dist_le_mul fun y y' => by simpa using PiLp.dist_apply_le y y' 0
    -- `a u − b v = (a − b) u + b (u − v)`
    have hsplit : ∀ (a b : ℝ) (u v : Euclid P), a • u - b • v = (a - b) • u + b • (u - v) := by
      intro a b u v
      rw [sub_smul, smul_sub]
      abel
    refine ⟨fun F G S y => F (tl y) + max 0 (min 1 (y 0)) •
      (max 0 (min 1 (R S + 1 - ‖tl y‖)) • (G (tl y) - F (tl y))), ?_, ?_⟩
    · intro Λ F G S hF hG hS
      -- `χ(x) = max 0 (min 1 (R S + 1 − ‖x‖))` is 1-Lipschitz, `0 ≤ χ ≤ 1`, and `χ(x) ≠ 0` forces
      -- `‖x‖ ≤ |R S| + 1`
      set χ : Euclid P → ℝ := fun x => max 0 (min 1 (R S + 1 - ‖x‖))
      have hχ_lip : ∀ x x', |χ x - χ x'| ≤ dist x x' := by
        have hlin : LipschitzWith 1 (fun x : Euclid P => R S + 1 - ‖x‖) := by
          refine LipschitzWith.of_dist_le_mul fun x x' => ?_
          rw [Real.dist_eq, NNReal.coe_one, one_mul, dist_eq_norm]
          calc |R S + 1 - ‖x‖ - (R S + 1 - ‖x'‖)| = |‖x'‖ - ‖x‖| := by ring_nf
            _ ≤ ‖x' - x‖ := abs_norm_sub_norm_le x' x
            _ = ‖x - x'‖ := norm_sub_rev x' x
        intro x x'
        have h := ((hlin.const_min 1).const_max 0).dist_le_mul x x'
        rwa [NNReal.coe_one, one_mul, Real.dist_eq] at h
      have hχ0 : ∀ x, 0 ≤ χ x := fun x => le_max_left _ _
      have hχ1 : ∀ x, |χ x| ≤ 1 := fun x => by
        rw [abs_of_nonneg (hχ0 x)]
        exact max_le zero_le_one (min_le_left _ _)
      have hχsupp : ∀ x, χ x ≠ 0 → ‖x‖ ≤ |R S| + 1 := by
        intro x hx
        by_contra h
        refine hx (max_eq_left (min_le_of_right_le ?_))
        linarith [le_abs_self (R S)]
      -- `D = G − F` is `2Λ`-Lipschitz, and `‖D(x)‖ ≤ B` where `χ(x) ≠ 0`
      set B : ℝ := ‖G 0 - F 0‖ + 2 * Λ * (|R S| + 1)
      have hΛ : (0 : ℝ) ≤ Λ := Λ.2
      have hB0 : 0 ≤ B := by positivity
      have hD_lip : ∀ x x', ‖(G x - F x) - (G x' - F x')‖ ≤ 2 * Λ * dist x x' := by
        intro x x'
        have hFd := hF.dist_le_mul x x'
        have hGd := hG.dist_le_mul x x'
        rw [dist_eq_norm] at hFd hGd
        calc ‖(G x - F x) - (G x' - F x')‖ = ‖(G x - G x') - (F x - F x')‖ := by
              congr 1
              abel
          _ ≤ ‖G x - G x'‖ + ‖F x - F x'‖ := norm_sub_le _ _
          _ ≤ Λ * dist x x' + Λ * dist x x' := add_le_add hGd hFd
          _ = 2 * Λ * dist x x' := by ring
      have hD_bd : ∀ x, χ x ≠ 0 → ‖G x - F x‖ ≤ B := by
        intro x hx
        have h0 := hD_lip x 0
        rw [dist_zero_right] at h0
        have h3 := norm_sub_norm_le (G x - F x) (G 0 - F 0)
        have h4 : 2 * Λ * ‖x‖ ≤ 2 * Λ * (|R S| + 1) :=
          mul_le_mul_of_nonneg_left (hχsupp x hx) (by positivity)
        linarith
      -- `φ = χ • D` is bounded by `B` and `(B + 2Λ)`-Lipschitz
      have hφ_bd : ∀ x, ‖χ x • (G x - F x)‖ ≤ B := by
        intro x
        by_cases hx : χ x = 0
        · rw [hx, zero_smul, norm_zero]
          exact hB0
        · rw [norm_smul, Real.norm_eq_abs]
          calc |χ x| * ‖G x - F x‖ ≤ 1 * B :=
                mul_le_mul (hχ1 x) (hD_bd x hx) (norm_nonneg _) zero_le_one
            _ = B := one_mul B
      have hφ_one : ∀ x x', χ x ≠ 0 →
          dist (χ x • (G x - F x)) (χ x' • (G x' - F x')) ≤ (B + 2 * Λ) * dist x x' := by
        intro x x' hx
/-- **A positive multiple of an oriented `n`-plane with the integer slice property has integer
multiplicity** (Simon Ch. 6, 8.2, the integrality step; step 10 of the integer multiplicity
criterion for cycles).  Here `n = d + 1`, `v = (v₁, …, vₙ)` is orthonormal, `V₀ = span v`, `θ₀ > 0`,
`C(ω) = θ₀ ∫_{V₀} ⟨ω, v₁ ∧ ⋯ ∧ vₙ⟩ dHⁿ`, and `C` has the integer slice property.
`Submission.dmcbr_cipi_slice_integer_multiplicity` (slicing `C` by `⟨·, v₁⟩` with (SL), plus the
half-space Stokes formula) gives, for `L¹`-a.e. `t`, an integer multiplicity current `Z` with
`Z(φ) = θ₀ ∫_{L_t} ⟨φ, v₂ ∧ ⋯ ∧ vₙ⟩ dH^d`, where `L_t = t v₁ + span(v₂, …, vₙ)`.  The a.e.
filter of `L¹` is non-trivial, so fix such `t` and `Z`, and an IMRep `R` of `Z`.  `(v₂, …, vₙ)` is
orthonormal, so `Submission.cbr_cipi_affine_plane_measure` shows that `L_t` is closed and that
`ν = H^d⌞L_t` is finite on compact sets and positive on `B₁(t v₁)`.  Let
`ζ₀ = θ₀ (v₂ ∧ ⋯ ∧ vₙ)`, i.e. `⟨α, ζ₀⟩ = θ₀ α(v₂, …, vₙ)`.  Then `|⟨α, ζ₀⟩| ≤ θ₀ |α|`
(`Submission.regcomp_covector_eval_orthonormal_le`), `⟨β, ζ₀⟩ = θ₀` for some `β` with `|β| = 1`
(`Submission.regcomp_exists_covector_eval_orthonormal_eq_one`), and `Z(φ) = ∫ ⟨φ, ζ₀⟩ dν`.  So
`Submission.cbr_ci_const_vector_massOn` gives `M_G(Z) = θ₀ ν(G)` for every open `G`, and (MR) gives
`M_G(Z) = R.measure(G)`.  Hence `R.measure(G) = θ₀ ν(G)` for every open `G`, and
`Submission.cbr_cipi_imrep_weight_const_nat` gives `θ₀ ∈ ℕ`. -/
theorem Submission.dmcbr_ci_plane_multiplicity_nat : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → ∀ (P d : ℕ) (v : Fin (d + 1) → Euclid P) (θ₀ : ℝ) (C : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), Orthonormal ℝ v → 0 < θ₀ → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = θ₀ * ∫ y in (Submodule.span ℝ (Set.range v) : Set (Euclid P)), (ω : DifferentialForm (Euclid P) (d + 1)) y v ∂μHE[(d + 1)]) → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (C).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B)) → ∃ m : ℕ, θ₀ = m := by
  intro hMR hSL P d v θ₀ C hv hθ₀ hC hISP
  -- Step 1: for a.e. `t` the slice boundary `Z` is integer multiplicity, with
  -- `Z(φ) = θ₀ ∫_{L_t} ⟨φ, v₂ ∧ ⋯ ∧ vₙ⟩ dH^d`; the a.e. filter on `ℝ` is non-trivial
  obtain ⟨t, Z, ⟨R, hR⟩, hZ⟩ :=
    (Submission.dmcbr_cipi_slice_integer_multiplicity hSL P d v θ₀ C hv hθ₀ hC hISP).exists
  -- Step 2: `L_t` is closed, and `ν = H^d⌞L_t` is finite on compact sets and positive on
  -- `B₁(t v₁)`
  have hw : Orthonormal ℝ (Fin.tail v) := hv.comp Fin.succ (Fin.succ_injective d)
  obtain ⟨-, hclosed, hfin, hpos⟩ :=
    Submission.cbr_cipi_affine_plane_measure P d (Fin.tail v) (t • v 0) hw
  -- Step 3: the constant `d`-vector `ζ₀ = θ₀ (v₂ ∧ ⋯ ∧ vₙ)`
  obtain ⟨ζ₀, hζ₀⟩ : ∃ ζ₀ : MultiVector P d, ∀ α : Covector (Euclid P) d,
      ζ₀ α = θ₀ * α (Fin.tail v) :=
    ⟨θ₀ • ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (Fin.tail v), fun α => rfl⟩
  -- Step 4: `M_G(Z) = θ₀ ν(G)` for open `G`: `|⟨α, ζ₀⟩| ≤ θ₀ |α|`, `ζ₀` is normed by a unit
  -- covector, and `Z(φ) = ∫ ⟨φ, ζ₀⟩ dν`
  have hmass := Submission.cbr_ci_const_vector_massOn P d _ ζ₀ θ₀ Z hfin
    (fun α => by
      rw [hζ₀, abs_mul, abs_of_pos hθ₀]
      exact mul_le_mul_of_nonneg_left
        (Submission.regcomp_covector_eval_orthonormal_le P d α _ hw) hθ₀.le)
    (by
      obtain ⟨β, hβ1, hβv⟩ :=
        Submission.regcomp_exists_covector_eval_orthonormal_eq_one P d _ hw
      exact ⟨β, hβ1.le, by rw [hζ₀, hβv, mul_one]⟩)
    (fun φ => by
      rw [hZ φ, ← integral_const_mul]
      simp only [hζ₀])
  -- Step 5: by (MR), `R.measure(G) = M_G(Z) = θ₀ ν(G)` for open `G`; the IM weight is then `θ₀`
  -- on a set of positive measure, so `θ₀ ∈ ℕ`
  exact Submission.cbr_cipi_imrep_weight_const_nat P d univ R _ θ₀ hθ₀ hclosed.measurableSet
    hfin ⟨t • v 0, 1, hpos 1 one_pos⟩ fun G hG => by
      rw [← hMR P d univ Z R isOpen_univ hR G hG, hmass G hG]

/-- **Pointwise tangent plane and integer multiplicity at a good point** (step 9 of the
integer-multiplicity criterion for cycles, with the blow-up steps 5–8 and the integrality step 10;
closure theorem, Simon Ch. 6, 8.2–8.3).  Let `θ₀ := θ(a) > 0` and let `η₀` be the lower density
constant of `LD`.  *Claim*: every blow-up sequence `λᵢ → 0` has a subsequence along which
`Hⁿ⌞η_{a,λᵢ}(M) → Hⁿ⌞span v` for an orthonormal `v` with `ζ(a) = v₁ ∧ ⋯ ∧ vₙ`, and `θ₀ ∈ ℕ`.
Indeed `Submission.dmcbr_ci_blowup_limit` gives a subsequence and a limit cycle `C = θ₀ ζ(a) ν`
with the integer slice property; `Submission.dmcbr_ci_pw_blowup_lower_density` gives `ν` lower
density `η₀/θ₀`, and `∂C = 0` gives `∫ ⟨dψ, ζ(a)⟩ dν = 0`, so
`Submission.dmcbr_ci_constant_cycle_planes` gives `ζ(a) = v₁ ∧ ⋯ ∧ vₙ` and
`ν = Σᵢ αᵢ Hⁿ⌞(wᵢ + span v)` with `Σᵢ αᵢ ≤ 1` and some `wᵢ = 0`.
`Submission.dmcbr_ci_plane_weight_ge_one` gives `αᵢ ≥ 1`, so
`Submission.dmcbr_ci_pw_single_plane_of_unit_weights` gives `ν = Hⁿ⌞span v`, and
`Submission.dmcbr_ci_plane_multiplicity_nat` gives `θ₀ ∈ ℕ`.  The claim for `λᵢ = 1/(i+1)` gives
the plane `Q := span v₀`, of dimension `n`, oriented by `ζ(a)`.  For any other sequence the plane
`span v` is `Q`: `β(v) = ζ(a)(β) = β(v₀)` for every `n`-covector `β`, in particular for
`β(u) = det (⟨u_a, w_b⟩)` (`Submission.cbr_ci_pw_pu_inner_det_covector`), so
`Submission.cbr_ci_pw_pu_span_le_of_inner_det_eq` gives both inclusions.  Hence
`Submission.dmcbr_ci_pw_approxTangent_of_subseq` (the subsequence principle) makes `Q` the
approximate tangent space of `M` at `a`. -/
theorem Submission.dmcbr_ci_pointwise_tangent_integer : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint 