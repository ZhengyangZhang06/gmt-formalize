        _ = ψ v := by rw [hχφ]
        _ = y + ι a + ι' b := hψv
    · rintro ⟨a, ha, rfl⟩
      exact ⟨hFM a ha, a, ha, u a, mem_ball_zero_iff.2 (hgood a ha).2.2.2.2, rfl⟩
