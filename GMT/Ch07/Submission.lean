            (hK.isClosed.measurableSet.inter (hAm j)) (measure_ne_top _ _)
            (ε := ENNReal.ofReal (η / (m + 1))) (by
              rw [Ne, ENNReal.ofReal_eq_zero, not_le]; positivity)
          refine ⟨F, hFsub, hFcl, ?_⟩
