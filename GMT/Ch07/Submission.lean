      have hψ : ∀ u ∈ T, Function.invFunOn Φ T (Φ u) = u := fun u hu => hΦinj.leftInvOn_invFunOn hu
      have hH₀ : LipschitzOnWith (K' * (2 * C A')) (fun z => F' (Function.invFunOn Φ T z))
          (Φ '' T) := by
