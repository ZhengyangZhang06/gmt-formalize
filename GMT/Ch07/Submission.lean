    have hδ0 : 0 < δ := div_pos hη0 (by linarith)
    obtain ⟨ω₀, hω₀t, hω₀V, hω₀1, hω₀β⟩ := Submission.dor_ims_smooth_unit_approx P n K' V
      β δ hK'c isOpen_thickening hK'V hβc (fun x _ => hβ1 x) hδ0
    let ω : TestFormOn U n := ⟨ω₀, hω₀t, hω₀V.trans (hVG.trans inter_subset_right)⟩
    have hadm : ω ∈ massAdmissibleOn U n W := ⟨hω₀V.trans (hVG.trans inter_subset_left), hω₀1⟩
    -- `ξ(ω)` is integrable: measurable, `|ξ(ω)| ≤ 1_V` and `μ(V) < ∞`
    have hfi : Integrable (fun x => ξ x ((ω : DifferentialForm (Euclid P) n) x)) μ := by
      refine Integrable.mono' ((integrableOn_const (C := (1 : ℝ)) hVfin).integrable_indicator hVm)
        (hξω ω₀ hω₀t.1.continuous) ?_
      filter_upwards with x
      change ‖ξ x (ω₀ x)‖ ≤ V.indicator (fun _ => (1 : ℝ)) x
      by_cases hxV : x ∈ V
      · rw [indicator_of_mem hxV, Real.norm_eq_abs]
        exact (hξ1 x _).trans (hω₀1 x)
      · rw [indicator_of_notMem hxV, image_eq_zero_of_notMem_tsupport (fun h => hxV (hω₀V h)),
          map_zero, norm_zero]
    -- `ξ(ω) ≥ (1 - δ) 1_{K'} - 1_{V \ K'}`, hence `T(ω) ≥ (1 - δ) μ(K') - μ(V \ K')`
    have hi1 : Integrable (K'.indicator fun _ => 1 - δ) μ :=
      (integrableOn_const (C := 1 - δ) hK'fin).integrable_indicator hK'm
    have hi2 : Integrable ((V \ K').indicator fun _ => (1 : ℝ)) μ :=
      (integrableOn_const (C := (1 : ℝ)) hVK'fin).integrable_indicator hVK'm
    have hle : (fun x => K'.indicator (fun _ => 1 - δ) x -
        (V \ K').indicator (fun _ => (1 : ℝ)) x) ≤ᵐ[μ]
          fun x => ξ x ((ω : DifferentialForm (Euclid P) n) x) := by
      filter_upwards with x
      change _ ≤ ξ x (ω₀ x)
      by_cases hxK' : x ∈ K'
      · rw [indicator_of_mem hxK', indicator_of_notMem (fun h => h.2 hxK'), sub_zero]
        have h1 := hξ1 x (ω₀ x - β x)
        have h2 : covectorEuclideanNorm (ω₀ x - β x) ≤ δ := hω₀β x hxK'
        rw [map_sub, hgoodK' x hxK'] at h1
        linarith [neg_abs_le (ξ x (ω₀ x) - 1)]
      · rw [indicator_of_notMem hxK', zero_sub]
        by_cases hxV : x ∈ V
        · rw [indicator_of_mem (show x ∈ V \ K' from ⟨hxV, hxK'⟩)]
          linarith [neg_abs_le (ξ x (ω₀ x)), hξ1 x (ω₀ x), hω₀1 x]
        · rw [indicator_of_notMem (fun h => hxV h.1), neg_zero,
            image_eq_zero_of_notMem_tsupport (fun h => hxV (hω₀V h)), map_zero]
    have hint : ∫ x, (K'.indicator (fun _ => 1 - δ) x - (V \ K').indicator (fun _ => (1 : ℝ)) x)
        ∂μ ≤ ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ :=
      integral_mono_ae (hi1.sub hi2) hfi hle
    rw [integral_sub hi1 hi2, integral_indicator_const _ hK'm, integral_indicator_const _ hVK'm,
      smul_eq_mul, smul_eq_mul, mul_one, ← hT ω] at hint
    -- arithmetic: `T(ω) > r`
    have hm1 : (r : ℝ) + ε < m₀ := by
      have := ENNReal.toReal_strict_mono hKfin.ne hrK
      rwa [ENNReal.toReal_add ENNReal.coe_ne_top ENNReal.coe_ne_top, ENNReal.coe_toReal,
        ENNReal.coe_toReal] at this
    have hc' : μ.real (K \ K') < η := ENNReal.toReal_lt_of_lt_ofReal hKK'
    have hb : μ.real (V \ K') < η := ENNReal.toReal_lt_of_lt_ofReal hVK'
    have hsplit : μ.real (K ∩ K') + μ.real (K \ K') = m₀ :=
      measureReal_inter_add_sdiff hK'm hKfin.ne
    rw [inter_eq_right.2 (hK'K.trans sdiff_subset)] at hsplit
    have hc0 : 0 ≤ μ.real (K \ K') := measureReal_nonneg
    have hδm : μ.real K' * δ < η := by
      have h1 : m₀ * δ < η := by
        rw [hδ, ← mul_div_assoc, div_lt_iff₀ (by linarith)]
        nlinarith
      have h2 : μ.real K' * δ ≤ m₀ * δ :=
        mul_le_mul_of_nonneg_right (by linarith) hδ0.le
      linarith
    have hrT : (r : ℝ) < T ω := by linarith
    calc (r : ℝ≥0∞) = ENNReal.ofReal r := ENNReal.ofReal_coe_nnreal.symm
      _ ≤ ENNReal.ofReal (T ω) := ENNReal.ofReal_le_ofReal hrT.le
      _ ≤ T.massOn W := T.le_massOn hadm
/-- **Densities of a cone with translation-invariant weight** (Simon 6.2.8, 6.3.2(3) and 7.3.1(2);
the `ℝx`-translation step for tangent objects of cones in the proof of A.4, chapter-A.txt lines
125–131).  Let `S = τ(M, θ, ξ)` be a cone in `ℝᴾ` whose weight `μ_R = θHⁿ⌞M` is invariant under
translation by the subspace `L`.  If `Θⁿ(μ_S, w) = θ`, then `Θⁿ(μ_S, y + λw) = θ` for `y ∈ L` and
`λ > 0`.  First `M_W(S) = μ_R(W)` for open `W` (6.3.2(3)): `⟨ω, ξ⟩ ≤ |ω|` gives `≤`, and Lusin's
theorem with a smooth partition of unity approximating the dual covector field of `ξ` gives `≥`.
The cone property `η_{0,λ#}S = S` gives `M_{B_{λρ}(λx)}(S) = λⁿ M_{B_ρ(x)}(S)`, and `-y ∈ L` gives
`μ_R(B_ρ(y + λw)) = μ_R(B_ρ(λw))`.  Hence the density ratio of `S` at `y + λw` and radius `ρ`
equals that at `w` and radius `ρ/λ`, and `ρ/λ → 0+` as `ρ → 0+`. -/
theorem Submission.idtp_cttp_cone_density_translation_invariant : ∀ (P n : ℕ) (S : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n) (L : Submodule ℝ (Euclid P)), R.Represents S → IsConeCurrent S → (∀ v ∈ L, ∀ A : Set (Euclid P), MeasurableSet A → R.measure ((fun x => x + v) ⁻¹' A) = R.measure A) → ∀ y ∈ L, ∀ lam : ℝ, 0 < lam → ∀ (w : Euclid P) (θ : ℝ), HasMassDensity S w θ → HasMassDensity S (y + lam • w) θ := by
  intro P n
  -- Step 1 (coefficients): `|α| = ‖coef α‖` for the continuous linear map
  -- `coef α = (α(e_I))_I`, `I` strictly increasing (and `0` otherwise)
  obtain ⟨coef, hcoef⟩ : ∃ coef : Covector (Euclid P) n →L[ℝ] EuclideanSpace ℝ (Fin n → Fin P),
      ∀ α : Covector (Euclid P) n, covectorEuclideanNorm α = ‖coef α‖ := by
    let c : (Fin n → Fin P) → Covector (Euclid P) n →L[ℝ] ℝ := fun I =>
      if StrictMono I then
        ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ fun i =>
          EuclideanSpace.basisFun (Fin P) ℝ (I i)
      else 0
    refine ⟨(EuclideanSpace.equiv (Fin n → Fin P) ℝ).symm.toContinuousLinearMap.comp
      (ContinuousLinearMap.pi c), fun α => ?_⟩
    rw [EuclideanSpace.norm_eq, covectorEuclideanNorm]
    congr 1
    refine Finset.sum_congr rfl fun I _ => ?_
    by_cases hI : StrictMono I <;> simp [c, hI]
  -- Step 2 (Simon Ch. 6, 1.2 and 1.5–1.7): a unit orientation `ξ = ±τ₁ ∧ ⋯ ∧ τₙ` has
  -- `|ξ(α)| ≤ |α|`, and `Ld ζ = Σ_I ζ(dx^I) dx^I` has `|Ld ξ| ≤ 1` and `ξ(Ld ξ) = 1`
  obtain ⟨Ld, hLd⟩ : ∃ Ld : MultiVector P n →L[ℝ] Covector (Euclid P) n,
      ∀ (ξ : MultiVector P n) (Q : Submodule ℝ (Euclid P)), IsUnitOrientationOf ξ Q →
        (∀ α : Covector (Euclid P) n, |ξ α| ≤ covectorEuclideanNorm α) ∧
          covectorEuclideanNorm (Ld ξ) ≤ 1 ∧ ξ (Ld ξ) = 1 := by
    -- `W u v = Σ_σ sgn σ ∏ₖ ⟨uₖ, v_{σ k}⟩ = det(⟨uₖ, vⱼ⟩)`; `dx^I = W (e ∘ I)` and `δ_τ = W τ`
    let W : (Fin n → Euclid P) → Covector (Euclid P) n := fun u =>
      ContinuousMultilinearMap.alternatization
        ((ContinuousMultilinearMap.mkPiAlgebra ℝ (Fin n) ℝ).compContinuousLinearMap
          fun k => innerSL ℝ (u k))
    have hW : ∀ u v, W u v =
        ∑ σ : Equiv.Perm (Fin n), Equiv.Perm.sign σ • ∏ k, inner ℝ (u k) (v (σ k)) := by
      intro u v
      simp only [W, ContinuousMultilinearMap.alternatization_apply_apply,
        ContinuousMultilinearMap.compContinuousLinearMap_apply,
        ContinuousMultilinearMap.mkPiAlgebra_apply, innerSL_apply_apply, Function.comp_apply]
    -- `W u v = W v u` (the determinant of the transpose)
    have hWsymm : ∀ u v, W u v = W v u := by
      intro u v
      rw [hW, hW]
      refine Fintype.sum_equiv (Equiv.inv (Equiv.Perm (Fin n))) _ _ fun σ => ?_
      rw [Equiv.inv_apply, Equiv.Perm.sign_inv,
        ← Equiv.prod_comp σ (fun k => inner ℝ (v k) (u (σ⁻¹ k)))]
      simp only [Equiv.Perm.coe_inv, Equiv.symm_apply_apply, real_inner_comm]
    -- `W u u = 1` for orthonormal `u`: only `σ = 1` contributes
    have hW1 : ∀ u, Orthonormal ℝ u → W u u = 1 := by
      intro u hu
      rw [hW, Finset.sum_eq_single (1 : Equiv.Perm (Fin n))]
      · rw [Equiv.Perm.sign_one, one_smul]
        refine Finset.prod_eq_one fun k _ => ?_
        rw [Equiv.Perm.coe_one, id, real_inner_self_eq_norm_sq, hu.norm_eq_one, one_pow]
      · intro σ _ hσ
        obtain ⟨k, hk⟩ : ∃ k, σ k ≠ k := by
          by_contra! h
          exact hσ (Equiv.ext h)
        rw [Finset.prod_eq_zero (Finset.mem_univ k) (hu.inner_eq_zero hk.symm), smul_zero]
      · exact fun h => absurd (Finset.mem_univ _) h
    -- Kronecker property `dx^I(e_J) = δ_IJ` for strictly increasing `I`, `J`
    let e := EuclideanSpace.basisFun (Fin P) ℝ
    have he : ∀ i j, inner ℝ (e i) (e j) = if i = j then (1 : ℝ) else 0 :=
      orthonormal_iff_ite.mp e.orthonormal
    have hK : ∀ I J : Fin n → Fin P, StrictMono I → StrictMono J →
        W (fun k => e (I k)) (fun k => e (J k)) = if I = J then 1 else 0 := by
      intro I J hI hJ
      split_ifs with hIJ
      · subst hIJ
        have hIo : Orthonormal ℝ (fun k => e (I k)) := e.orthonormal.comp I hI.injective
        exact hW1 _ hIo
      · rw [hW]
        refine Finset.sum_eq_zero fun σ _ => ?_
        rw [Finset.prod_eq_zero_iff.mpr, smul_zero]
        by_contra! h
        apply hIJ
        have hJσ : J ∘ σ = I := funext fun k => by
          have := h k (Finset.mem_univ k)
          rw [he] at this
          split_ifs at this with hk
          · exact hk.symm
          · exact absurd rfl this
        rw [← (StrictMono.range_inj_of_wellFoundedLT hI hJ), ← hJσ, EquivLike.range_comp]
    -- expansion `α = Σ_{I ∈ Sinc} α(e_I) dx^I`
    let Sinc : Finset (Fin n → Fin P) := Finset.univ.filter StrictMono
    have hE : ∀ α : Covector (Euclid P) n,
        α = ∑ I ∈ Sinc, α (fun k => e (I k)) • W (fun k => e (I k)) := by
      intro α
      apply ContinuousAlternatingMap.toAlternatingMap_injective
      refine e.toBasis.ext_alternating fun f hf => ?_
      simp only [OrthonormalBasis.coe_toBasis, ContinuousAlternatingMap.coe_toAlternatingMap]
      set σ := Tuple.sort f
      have hJ : StrictMono (f ∘ σ) :=
        (Tuple.monotone_sort f).strictMono_of_injective (hf.comp σ.injective)
      have hperm : ∀ β : Covector (Euclid P) n,
          β (fun k => e (f k)) = Equiv.Perm.sign σ⁻¹ • β (fun k => e ((f ∘ σ) k)) := by
        intro β
        have : (fun k => e (f k)) = (fun k => e ((f ∘ σ) k)) ∘ ⇑(σ⁻¹) := by
          funext k
          simp
        rw [this]
        exact β.toAlternatingMap.map_perm _ _
      rw [hperm α, hperm, ContinuousAlternatingMap.sum_apply, Finset.sum_eq_single (f ∘ σ)]
      · rw [ContinuousAlternatingMap.smul_apply, hK _ _ hJ hJ, ite_eq_left rfl, smul_eq_mul,
          mul_one]
      · intro I hI hIJ
        rw [ContinuousAlternatingMap.smul_apply, hK _ _ (Finset.mem_filter.mp hI).2 hJ,
          ite_eq_right hIJ, smul_zero]
      · exact fun h => absurd (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hJ⟩) h
    -- `|β| = (Σ_{I ∈ Sinc} β(e_I)²)^{1/2}`
    have hnorm : ∀ β : Covector (Euclid P) n,
        covectorEuclideanNorm β = Real.sqrt (∑ I ∈ Sinc, β (fun k => e (I k)) ^ 2) := by
      intro β
      rw [covectorEuclideanNorm, Finset.sum_filter]
    -- Cauchy–Binet `Σ_{I ∈ Sinc} dx^I(τ)² = 1` for orthonormal `τ`
    have hCB : ∀ τ : Fin n → Euclid P, Orthonormal ℝ τ →
        ∑ I ∈ Sinc, W (fun k => e (I k)) τ ^ 2 = 1 := by
      intro τ hτ
      have h := congrArg (fun β : Covector (Euclid P) n => β τ) (hE (W τ))
      simp only [ContinuousAlternatingMap.sum_apply, ContinuousAlternatingMap.smul_apply,
        smul_eq_mul, hW1 τ hτ] at h
      rw [h]
      refine Finset.sum_congr rfl fun I _ => ?_
      rw [hWsymm τ, sq]
    refine ⟨∑ I ∈ Sinc, (ContinuousLinearMap.apply ℝ ℝ (W fun k => e (I k))).smulRight
      (W fun k => e (I k)), ?_⟩
    rintro ξ Q ⟨τ, hτ, -, hξ⟩
    have hξ2 : ∀ α β : Covector (Euclid P) n, ξ α * ξ β = α τ * β τ := by
      intro α β
      rcases hξ with h | h
      · rw [h, h]
      · rw [h, h, neg_mul_neg]
    have hξabs : ∀ α : Covector (Euclid P) n, |ξ α| = |α τ| := by
      intro α
      rcases hξ with h | h
      · rw [h]
      · rw [h, abs_neg]
    have hLζ : ∀ ζ : MultiVector P n, (∑ I ∈ Sinc, (ContinuousLinearMap.apply ℝ ℝ
        (W fun k => e (I k))).smulRight (W fun k => e (I k))) ζ =
        ∑ I ∈ Sinc, ζ (W fun k => e (I k)) • W fun k => e (I k) := by
      intro ζ
      simp only [sum_apply, ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.apply_apply]
    have hCBτ := hCB τ hτ
    refine ⟨fun α => ?_, ?_, ?_⟩
    · rw [hξabs, hnorm]
      apply Real.abs_le_sqrt
      have h := congrArg (fun β : Covector (Euclid P) n => β τ) (hE α)
      simp only [ContinuousAlternatingMap.sum_apply, ContinuousAlternatingMap.smul_apply,
        smul_eq_mul] at h
      rw [h]
      calc (∑ I ∈ Sinc, α (fun k => e (I k)) * W (fun k => e (I k)) τ) ^ 2
          ≤ (∑ I ∈ Sinc, α (fun k => e (I k)) ^ 2) * ∑ I ∈ Sinc, W (fun k => e (I k)) τ ^ 2 :=
            Finset.sum_mul_sq_le_sq_mul_sq _ _ _
        _ = ∑ I ∈ Sinc, α (fun k => e (I k)) ^ 2 := by rw [hCBτ, mul_one]
    · rw [hnorm, hLζ]
      have : ∑ J ∈ Sinc, (∑ I ∈ Sinc, ξ (W fun k => e (I k)) • W fun k => e (I k))
          (fun k => e (J k)) ^ 2 = 1 := by
        rw [← hCBτ]
        refine Finset.sum_congr rfl fun J hJ => ?_
        rw [ContinuousAlternatingMap.sum_apply, Finset.sum_eq_single J]
        · rw [ContinuousAlternatingMap.smul_apply, hK _ _ (Finset.mem_filter.mp hJ).2
            (Finset.mem_filter.mp hJ).2, ite_eq_left rfl, smul_eq_mul, mul_one, sq, sq, hξ2]
        · intro I hI hIJ
          rw [ContinuousAlternatingMap.smul_apply, hK _ _ (Finset.mem_filter.mp hI).2
            (Finset.mem_filter.mp hJ).2, ite_eq_right hIJ, smul_zero]
        · exact fun h => absurd hJ h
      rw [this, Real.sqrt_one]
    · rw [hLζ, map_sum, ← hCBτ]
      refine Finset.sum_congr rfl fun I _ => ?_
      rw [map_smul, smul_eq_mul, hξ2, sq]
  -- Step 3 (Simon Ch. 6, 1.15 and 2.5): if `coef ∘ β` is continuous on a compact `K ⊆ V`
  -- (`V` open) with `|β| ≤ 1` there, a test form `ω = Σₐ fₐ β(a)` supported in `V`, with
  -- `|ω| ≤ 1` and `|ω - β| ≤ δ` on `K`, comes from a smooth partition of unity `(fₐ)` on `K`
  -- subordinate to a finite cover of `K` by small balls `B_s(a)`, `a ∈ K`
  have hsmooth : ∀ (K V : Set (Euclid P)) (β : Euclid P → Covector (Euclid P) n) (δ : ℝ),
      IsCompact K → IsOpen V → K ⊆ V → ContinuousOn (fun x => coef (β x)) K →
      (∀ x ∈ K, ‖coef (β x)‖ ≤ 1) → 0 < δ →
      ∃ ω : DifferentialForm (Euclid P) n, IsTestForm ω ∧ tsupport ω ⊆ V ∧
        (∀ x, ‖coef (ω x)‖ ≤ 1) ∧ ∀ x ∈ K, ‖coef (ω x) - coef (β x)‖ ≤ δ := by
    intro K V β δ hK hV hKV hβ hβ1 hδ
    -- a modulus `s` of uniform continuity of `coef ∘ β` on `K`, and a margin `r`
    obtain ⟨s, hs, hβs⟩ := Metric.uniformContinuousOn_iff.1
      (hK.uniformContinuousOn_of_continuous hβ) δ hδ
    obtain ⟨r, hr, hrV⟩ := hK.exists_cthickening_subset_open hV hKV
    have hsr : 0 < min s r := lt_min hs hr
    -- a finite cover of `K` by balls `B_{min s r}(a)`, `a ∈ t ⊆ K`, and a smooth partition of
    -- unity on `K` subordinate to it
    obtain ⟨t, htK, hKt⟩ :=
      hK.elim_nhds_subcover (fun a => ball a (min s r)) fun a _ => ball_mem_nhds a hsr
    obtain ⟨f, hf⟩ := SmoothPartitionOfUnity.exists_isSubordinate
      (modelWithCornersSelf ℝ (Euclid P)) hK.isClosed
      (fun a : t => ball (a : Euclid P) (min s r)) (fun a => isOpen_ball) fun x hx => by
        obtain ⟨a, ha, hxa⟩ := mem_iUnion₂.1 (hKt hx)
        exact mem_iUnion.2 ⟨⟨a, ha⟩, hxa⟩
    have hsum : ∀ x, ∑ a : t, f a x ≤ 1 := fun x => by
      rw [← finsum_eq_sum_of_fintype]
      exact f.sum_le_one x
    have hsum1 : ∀ x ∈ K, ∑ a : t, f a x = 1 := fun x hx => by
      rw [← finsum_eq_sum_of_fintype]
      exact f.sum_eq_one hx
    have hfa : ∀ (a : t) (x : Euclid P), f a x ≠ 0 → dist x a < min s r := fun a x h =>
      mem_ball.1 (hf a (subset_tsupport _ h))
    -- `spt ω ⊆ cthickening (min s r) K ⊆ cthickening r K ⊆ V`
    have hsupp : support (fun x => ∑ a : t, f a x • β a) ⊆ thickening (min s r) K := by
      intro x hx
      rw [Function.mem_support] at hx
      obtain ⟨a, -, ha⟩ := Finset.exists_ne_zero_of_sum_ne_zero hx
      have hfx : f a x ≠ 0 := fun h => ha (by rw [h, zero_smul])
      exact mem_thickening_iff.2 ⟨a, htK a a.2, hfa a x hfx⟩
    have htsupp : tsupport (fun x => ∑ a : t, f a x • β a) ⊆ cthickening (min s r) K :=
      (closure_mono hsupp).trans (closure_thickening_subset_cthickening _ _)
    refine ⟨fun x => ∑ a : t, f a x • β a, ⟨?_, ?_⟩, ?_, fun x => ?_, fun x hx => ?_⟩
    · exact ContDiff.sum fun a _ => (contMDiff_iff_contDiff.1 (f a).contMDiff).smul contDiff_const
    · exact hK.cthickening.of_isClosed_subset (isClosed_tsupport _) htsupp
    · exact htsupp.trans ((cthickening_mono (min_le_right s r) K).trans hrV)
    · -- `|ω x| ≤ Σₐ fₐ(x) |β(a)| ≤ Σₐ fₐ(x) ≤ 1`
      rw [map_sum]
      calc ‖∑ a : t, coef (f a x • β a)‖ ≤ ∑ a : t, ‖coef (f a x • β a)‖ := norm_sum_le _ _
        _ ≤ ∑ a : t, f a x := Finset.sum_le_sum fun a _ => by
            rw [map_smul, norm_smul, Real.norm_of_nonneg (f.nonneg a x)]
            exact mul_le_of_le_one_right (f.nonneg a x) (hβ1 a (htK a a.2))
        _ ≤ 1 := hsum x
    · -- on `K`: `ω x - β x = Σₐ fₐ(x) (β(a) - β(x))` and `|β(a) - β(x)| < δ` when `fₐ(x) ≠ 0`
      have hdiff : coef (∑ a : t, f a x • β a) - coef (β x) =
          ∑ a : t, f a x • (coef (β a) - coef (β x)) := by
        simp only [map_sum, map_smul, smul_sub, Finset.sum_sub_distrib, ← Finset.sum_smul,
          hsum1 x hx, one_smul]
      rw [hdiff]
      calc ‖∑ a : t, f a x • (coef (β a) - coef (β x))‖
          ≤ ∑ a : t, ‖f a x • (coef (β a) - coef (β x))‖ := norm_sum_le _ _
        _ ≤ ∑ a : t, f a x * δ := Finset.sum_le_sum fun a _ => by
            rw [norm_smul, Real.norm_of_nonneg (f.nonneg a x)]
            rcases eq_or_ne (f a x) 0 with h | h
            · simp [h]
            · refine mul_le_mul_of_nonneg_left ?_ (f.nonneg a x)
              rw [← dist_eq_norm]
              refine (hβs a (htK a a.2) x hx ?_).le
              rw [dist_comm]
              exact (hfa a x h).trans_le (min_le_left s r)
        _ = δ := by rw [← Finset.sum_mul, hsum1 x hx, one_mul]
  intro S R L hR hcone hinv y hy lam hlam w θ hθ
  have hac : R.measure ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
  -- Step 4 (Simon Ch. 6, 3.1 (‡)): `S(ω) = ∫ ⟨ω, ξ⟩ dμ_R` with `μ_R = θ Hⁿ⌞M`, the integrand
  -- being bounded by `sup |ω|` `μ_R`-a.e. and vanishing off the compact `spt ω`
  have haction : ∀ ω : TestFormOn (univ : Set (Euclid P)) n,
      Integrable (fun x => R.orient x ((ω : DifferentialForm (Euclid P) n) x)) R.measure ∧
        S ω = ∫ x, R.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂R.measure := by
    intro ω
    rw [hR ω]
    obtain ⟨⟨hsm, hcpt⟩, -⟩ := ω.2
    set f : DifferentialForm (Euclid P) n := (ω : DifferentialForm (Euclid P) n)
    have hmult : Measurable fun x => (R.mult x : ℝ≥0∞) := measurable_from_nat.comp R.measurable_mult
    have hmeas : AEStronglyMeasurable (fun x => R.orient x (f x)) R.measure :=
      isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable₂
        (R.aestronglyMeasurable_orient.mono_ac hac) hsm.continuous.aestronglyMeasurable
    obtain ⟨C, hC⟩ := hsm.continuous.bounded_above_of_compact_support hcpt
    have hKm : MeasurableSet (tsupport f) := (isClosed_tsupport f).measurableSet
    have hbound : ∀ᵐ x ∂R.measure,
        ‖R.orient x (f x)‖ ≤ (tsupport f).indicator (fun _ => C) x := by
      filter_upwards [hac.ae_le R.orients] with x hx
      obtain ⟨Q, -, τ, hτ, -, hξ⟩ := hx
      by_cases hxK : x ∈ tsupport f
      · rw [Set.indicator_of_mem hxK]
        have hτ1 : ‖f x τ‖ ≤ ‖f x‖ := by
          simpa [hτ.norm_eq_one] using (f x).le_opNorm τ
        rcases hξ with h | h
        · rw [h]
          exact hτ1.trans (hC x)
        · rw [h, norm_neg]
          exact hτ1.trans (hC x)
      · rw [Set.indicator_of_notMem hxK, image_eq_zero_of_notMem_tsupport hxK, map_zero,
          norm_zero]
    have hKfin : R.measure (tsupport f) ≠ ∞ := by
      rw [IMRep.measure, withDensity_apply _ hKm, Measure.restrict_restrict hKm,
        Set.inter_comm (tsupport f) R.carrier]
      exact R.locallyIntegrable_mult _ hcpt (subset_univ _)
    have hint : Integrable (fun x => R.orient x (f x)) R.measure :=
      ((integrable_indicator_iff hKm).2 (integrableOn_const hKfin)).mono' hmeas hbound
    refine ⟨hint, ?_⟩
    rw [IMRep.measure, integral_withDensity_eq_integral_toReal_smul hmult
      (ae_of_all _ fun x => ENNReal.natCast_lt_top _), IMRep.action]
    simp only [ENNReal.toReal_natCast, smul_eq_mul]
  have hfin : ∀ K : Set (Euclid P), IsCompact K → R.measure K < ∞ := by
    intro K hK
    rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
      Measure.restrict_restrict hK.measurableSet, inter_comm]
    exact (R.locallyIntegrable_mult K hK (subset_univ K)).lt_top
  -- Step 5 (Simon Ch. 6, 3.2(3), upper bound): `M_W(S) ≤ μ_R(W)`, since for admissible `ω`,
  -- `⟨ω, ξ⟩ ≤ |ω| ≤ 1` `μ_R`-a.e. and `⟨ω, ξ⟩ = 0` off `spt ω ⊆ W`
  have hupper : ∀ W : Set (Euclid P), S.massOn W ≤ R.measure W := by
    intro W
    have hdual : ∀ᵐ x ∂R.measure, ∀ α : Covector (Euclid P) n,
        |R.orient x α| ≤ covectorEuclideanNorm α := by
      refine hac.ae_le ?_
      filter_upwards [R.orients] with x hx
      obtain ⟨Q, -, hQ⟩ := hx
      exact (hLd _ Q hQ).1
    apply sSup_le
    rintro r ⟨ω, ⟨hωW, hω1⟩, rfl⟩
    set K := tsupport (ω : DifferentialForm (Euclid P) n)
    have hKm : MeasurableSet K := (isClosed_tsupport _).measurableSet
    have hμK : R.measure K ≠ ∞ := (hfin K ω.2.1.2.isCompact).ne
    obtain ⟨hint, heq⟩ := haction ω
    have hle : (fun x => R.orient x ((ω : DifferentialForm (Euclid P) n) x)) ≤ᵐ[R.measure]
        K.indicator fun _ => (1 : ℝ) := by
      filter_upwards [hdual] with x hx
      by_cases hxK : x ∈ K
      · rw [indicator_of_mem hxK]
        exact (le_abs_self _).trans ((hx _).trans (hω1 x))
      · rw [indicator_of_notMem hxK, image_eq_zero_of_notMem_tsupport hxK, map_zero]
    calc ENNReal.ofReal (S ω)
        = ENNReal.ofReal (∫ x, R.orient x ((ω : DifferentialForm (Euclid P) n) x)
            ∂R.measure) := by rw [heq]
      _ ≤ ENNReal.ofReal (∫ x, K.indicator (fun _ => (1 : ℝ)) x ∂R.measure) :=
          ENNReal.ofReal_le_ofReal (integral_mono_ae hint
            ((integrableOn_const hμK).integrable_indicator hKm) hle)
      _ = R.measure K := by
          rw [integral_indicator_const _ hKm, smul_eq_mul, mul_one, measureReal_def,
            ENNReal.ofReal_toReal hμK]
      _ ≤ R.measure W := measure_mono hωW
  -- Step 6 (Simon Ch. 6, 3.2(3), lower bound): `μ_R(W) ≤ M_W(S)` for open `W`.  Take a compact
  -- `K ⊆ W` of nearly full measure; by Lusin (Simon 1.17) `β = Ld ∘ ξ` is continuous on a compact
  -- `K' ⊆ K` with `μ_R(K \ K') < η`; for a thin open `V ⊇ K'` and the form `ω` of Step 3 with
  -- `|ω - β| ≤ δ` on `K'`, `S(ω) ≥ (1 - δ) μ_R(K') - μ_R(V \ K')` is close to `μ_R(W)`
  have hlower : ∀ W : Set (Euclid P), IsOpen W → R.measure W ≤ S.massOn W := by
    intro W hW
    have hgm : AEStronglyMeasurable (fun x => coef (Ld (R.orient x))) R.measure :=
      (coef.comp Ld).continuous.comp_aestronglyMeasurable
        (R.aestronglyMeasurable_orient.mono_ac hac)
    -- `μ_R`-a.e. `x` is good: `|ξ(x)(α)| ≤ |α|`, `|Ld ξ(x)| ≤ 1`, `ξ(x)(Ld ξ(x)) = 1`, and
    -- `coef (Ld ξ(x)) = g x` for the measurable version `g = hgm.mk _`
    have hgood : ∀ᵐ x ∂R.measure,
        ((∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α) ∧
          covectorEuclideanNorm (Ld (R.orient x)) ≤ 1 ∧ R.orient x (Ld (R.orient x)) = 1) ∧
        coef (Ld (R.orient x)) = hgm.mk _ x := by
      have h1 : ∀ᵐ x ∂R.measure,
          (∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α) ∧
            covectorEuclideanNorm (Ld (R.orient x)) ≤ 1 ∧ R.orient x (Ld (R.orient x)) = 1 := by
        refine hac.ae_le ?_
        filter_upwards [R.orients] with x hx
        obtain ⟨Q, -, hQ⟩ := hx
        exact hLd _ Q hQ
      exact h1.and hgm.ae_eq_mk
    obtain ⟨Z, hZ, hZm, hZ0⟩ := exists_measurable_superset_of_null (ae_iff.1 hgood)
    -- it suffices to beat every `r < μ_R(W)`; fix `η > 0` with `r + 4η < μ_R(W)`
    refine ENNReal.le_of_forall_nnreal_lt fun r hr => ?_
    obtain ⟨ε, hε0, hrε⟩ := ENNReal.lt_iff_exists_add_pos_lt.1 hr
    set η : ℝ := (ε : ℝ) / 4 with hη
    have hη0 : 0 < η := div_pos (NNReal.coe_pos.2 hε0) four_pos
    -- a compact `K ⊆ W` with `r + 4η < μ_R(K)`, from the exhaustion `Fⱼ ∩ B̄ⱼ(0)` of `W`
    obtain ⟨F, hFc, hFG, hFU, hFm⟩ := hW.exists_iUnion_isClosed
    have hKm : Monotone fun j : ℕ => F j ∩ closedBall (0 : Euclid P) j := fun i j hij =>
      inter_subset_inter (hFm hij) (closedBall_subset_closedBall (Nat.cast_le.2 hij))
    have hKU : ⋃ j : ℕ, F j ∩ closedBall (0 : Euclid P) j = W := by
      refine Subset.antisymm (iUnion_subset fun j => inter_subset_left.trans (hFG j))
        fun x hx => ?_
      rw [← hFU] at hx
      obtain ⟨i, hi⟩ := mem_iUnion.1 hx
      obtain ⟨k, hk⟩ := exists_nat_ge ‖x‖
      refine mem_iUnion.2 ⟨max i k, hFm (le_max_left i k) hi, ?_⟩
      rw [mem_closedBall, dist_zero_right]
      exact hk.trans (Nat.cast_le.2 (le_max_right i k))
    have hlt : (r : ℝ≥0∞) + ε < R.measure (⋃ j : ℕ, F j ∩ closedBall (0 : Euclid P) j) := by
      rwa [hKU]
    obtain ⟨j, hj⟩ :=
      ((tendsto_order.1 (tendsto_measure_iUnion_atTop (μ := R.measure) hKm)).1 _ hlt).exists
    set K := F j ∩ closedBall (0 : Euclid P) j
    have hrK : (r : ℝ≥0∞) + ε < R.measure K := hj
    have hKc : IsCompact K := (isCompact_closedBall _ _).inter_left (hFc j)
    have hKG : K ⊆ W := inter_subset_left.trans (hFG j)
    have hKfin : R.measure K < ∞ := hfin K hKc
    -- Lusin (Simon 1.17) for `g = hgm.mk _` on `K \ Z`: `μ_R⌞(K \ Z)` is finite, hence
    -- inner regular; for a countable basis `(O_k)` and weights `ηs_k` with `Σ ηs_k < η`, take
    -- compact `C_k ⊆ (K \ Z) ∩ g⁻¹(O_k)`, `D_k ⊆ (K \ Z) \ g⁻¹(O_k)` with small defects, and
    -- `K' = ⋂ₖ (C_k ∪ D_k)`; on `K'`, `g⁻¹(O_k) = D_kᶜ`
    obtain ⟨K', hK'c, hK'K, hK'small, hgc⟩ : ∃ K' : Set (Euclid P), IsCompact K' ∧
        K' ⊆ K \ Z ∧ R.measure ((K \ Z) \ K') < ENNReal.ofReal η ∧ ContinuousOn (hgm.mk _) K' := by
      have hA : MeasurableSet (K \ Z) := hKc.measurableSet.diff hZm
      have hμA : R.measure (K \ Z) ≠ ∞ := ((measure_mono sdiff_subset).trans_lt hKfin).ne
      have hg : Measurable (hgm.mk _) := hgm.stronglyMeasurable_mk.measurable
      have : IsFiniteMeasure (R.measure.restrict (K \ Z)) := isFiniteMeasure_restrict.mpr hμA
      have approx : ∀ B, B ⊆ K \ Z → MeasurableSet B → ∀ η' : ℝ≥0∞, η' ≠ 0 →
          ∃ C ⊆ B, IsCompact C ∧ R.measure (B \ C) < η' := by
        intro B hBA hB η' hη'
        obtain ⟨C, hCB, hC, hlt⟩ :=
          hB.exists_isCompact_sdiff_lt (μ := R.measure.restrict (K \ Z)) (measure_ne_top _ _) hη'
        exact ⟨C, hCB, hC, by rwa [Measure.restrict_eq_self _ (sdiff_subset.trans hBA)] at hlt⟩
      obtain ⟨O, hO⟩ := TopologicalSpace.exists_seq_basis (EuclideanSpace ℝ (Fin n → Fin P))
      obtain ⟨ηs, hηs, hηsε⟩ :=
        ENNReal.exists_pos_sum_of_countable' (ENNReal.ofReal_pos.2 hη0).ne' ℕ
      have hS : ∀ k, MeasurableSet (hgm.mk _ ⁻¹' O k) :=
        fun k => hg (hO.isOpen (mem_range_self k)).measurableSet
      choose C hCA hC hCμ using fun k =>
        approx ((K \ Z) ∩ hgm.mk _ ⁻¹' O k) inter_subset_left (hA.inter (hS k)) (ηs k / 2)
          (ENNReal.half_pos (hηs k).ne').ne'
      choose D hDA hD hDμ using fun k =>
        approx ((K \ Z) \ hgm.mk _ ⁻¹' O k) sdiff_subset (hA.diff (hS k)) (ηs k / 2)
          (ENNReal.half_pos (hηs k).ne').ne'
      have hE : ∀ k, R.measure ((K \ Z) \ (C k ∪ D k)) < ηs k := by
        intro k
        calc R.measure ((K \ Z) \ (C k ∪ D k))
            ≤ R.measure (((K \ Z) ∩ hgm.mk _ ⁻¹' O k) \ C k ∪
                ((K \ Z) \ hgm.mk _ ⁻¹' O k) \ D k) := by
              refine measure_mono fun x hx => ?_
              by_cases hxO : hgm.mk _ x ∈ O k
              · exact Or.inl ⟨⟨hx.1, hxO⟩, fun hxC => hx.2 (Or.inl hxC)⟩
              · exact Or.inr ⟨⟨hx.1, hxO⟩, fun hxD => hx.2 (Or.inr hxD)⟩
          _ ≤ R.measure (((K \ Z) ∩ hgm.mk _ ⁻¹' O k) \ C k) +
                R.measure (((K \ Z) \ hgm.mk _ ⁻¹' O k) \ D k) := measure_union_le _ _
          _ < ηs k / 2 + ηs k / 2 := ENNReal.add_lt_add (hCμ k) (hDμ k)
          _ = ηs k := ENNReal.add_halves _
      refine ⟨⋂ k, (C k ∪ D k), ?_, ?_, ?_, ?_⟩
      · exact ((hC 0).union (hD 0)).of_isClosed_subset
          (isClosed_iInter fun k => ((hC k).union (hD k)).isClosed) (iInter_subset _ 0)
      · exact (iInter_subset _ 0).trans
          (union_subset ((hCA 0).trans inter_subset_left) ((hDA 0).trans sdiff_subset))
      · calc R.measure ((K \ Z) \ ⋂ k, (C k ∪ D k))
            = R.measure (⋃ k, (K \ Z) \ (C k ∪ D k)) := by rw [sdiff_iInter]
          _ ≤ ∑' k, R.measure ((K \ Z) \ (C k ∪ D k)) := measure_iUnion_le _
          _ ≤ ∑' k, ηs k := ENNReal.tsum_le_tsum fun k => (hE k).le
          _ < ENNReal.ofReal η := hηsε
      · rw [hO.continuousOn_iff]
        rintro _ ⟨k, rfl⟩
        refine ⟨(D k)ᶜ, (hD k).isClosed.isOpen_compl, ?_⟩
        ext x
        refine ⟨fun ⟨hxO, hxK⟩ => ⟨fun hxD => (hDA k hxD).2 hxO, hxK⟩,
          fun ⟨hxD, hxK⟩ => ⟨?_, hxK⟩⟩
        rcases mem_iInter.mp hxK k with hxC | hxD'
        · exact (hCA k hxC).2
        · exact absurd hxD' hxD
    have hgoodK' : ∀ x ∈ K',
        ((∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α) ∧
          covectorEuclideanNorm (Ld (R.orient x)) ≤ 1 ∧ R.orient x (Ld (R.orient x)) = 1) ∧
        coef (Ld (R.orient x)) = hgm.mk _ x := fun x hx => by
      by_contra h
      exact (hK'K hx).2 (hZ h)
    have hβc : ContinuousOn (fun x => coef (Ld (R.orient x))) K' :=
      hgc.congr fun x hx => (hgoodK' x hx).2
    have hK'G : K' ⊆ W := hK'K.trans (sdiff_subset.trans hKG)
    have hK'm : MeasurableSet K' := hK'c.measurableSet
    have hK'fin : R.measure K' ≠ ∞ :=
      ((measure_mono (hK'K.trans sdiff_subset)).trans_lt hKfin).ne
    have hKK' : R.measure (K \ K') < ENNReal.ofReal η := by
      calc R.measure (K \ K') ≤ R.measure ((K \ Z) \ K' ∪ Z) := measure_mono fun x hx => by
            by_cases hxZ : x ∈ Z
            · exact Or.inr hxZ
            · exact Or.inl ⟨⟨hx.1, hxZ⟩, hx.2⟩
        _ ≤ R.measure ((K \ Z) \ K') + R.measure Z := measure_union_le _ _
        _ < ENNReal.ofReal η := by rwa [hZ0, add_zero]
    -- a thin open thickening `V` of `K'`: `K' ⊆ V ⊆ W` and `μ_R(V \ K') < η`
    obtain ⟨ρ, hρ0, hρG⟩ := hK'c.exists_cthickening_subset_open hW hK'G
    have hthick : R.measure (thickening ρ K') ≠ ∞ :=
      ((measure_mono (thickening_subset_cthickening_of_le (le_refl ρ) K')).trans_lt
        (hfin _ hK'c.cthickening)).ne
    obtain ⟨t, htV, ht⟩ := (((tendsto_order.1 (tendsto_measure_thickening_of_isClosed
      ⟨ρ, hρ0, hthick⟩ hK'c.isClosed)).2 _ (ENNReal.lt_add_right hK'fin
        (ENNReal.ofReal_pos.2 hη0).ne')).and (Ioo_mem_nhdsGT hρ0)).exists
    set V := thickening t K'
    have hK'V : K' ⊆ V := self_subset_thickening ht.1 K'
    have hVG : V ⊆ W := (thickening_subset_cthickening_of_le ht.2.le K').trans hρG
    have hVK' : R.measure (V \ K') < ENNReal.ofReal η :=
      measure_sdiff_lt_of_lt_add hK'm.nullMeasurableSet hK'V hK'fin htV
    have hVK'fin : R.measure (V \ K') ≠ ∞ := (hVK'.trans ENNReal.ofReal_lt_top).ne
    have hVK'm : MeasurableSet (V \ K') := isOpen_thickening.measurableSet.diff hK'm
    -- a test form `ω` supported in `V` with `|ω| ≤ 1` and `|ω - Ld ∘ ξ| ≤ δ` on `K'`
    set m : ℝ := R.measure.real K
    have hm0 : 0 ≤ m := measureReal_nonneg
    set δ : ℝ := η / (m + 1) with hδ
    have hδ0 : 0 < δ := div_pos hη0 (by linarith)
    obtain ⟨ω₀, hω₀t, hω₀V, hω₀1, hω₀β⟩ := hsmooth K' V (fun x => Ld (R.orient x)) δ hK'c
      isOpen_thickening hK'V hβc
      (fun x hx => by rw [← hcoef]; exact (hgoodK' x hx).1.2.1) hδ0
    let ω : TestFormOn (univ : Set (Euclid P)) n := ⟨ω₀, hω₀t, subset_univ _⟩
    have hadm : ω ∈ massAdmissibleOn univ n W :=
      ⟨hω₀V.trans hVG, fun x => by rw [hcoef]; exact hω₀1 x⟩
    obtain ⟨hfi, hfe⟩ := haction ω
    -- `ξ(ω) ≥ (1 - δ) 1_{K'} - 1_{V \ K'}` a.e., hence `S(ω) ≥ (1 - δ) μ_R(K') - μ_R(V \ K')`
    have hi1 : Integrable (K'.indicator fun _ => 1 - δ) R.measure :=
      (integrableOn_const (C := 1 - δ) hK'fin).integrable_indicator hK'm
    have hi2 : Integrable ((V \ K').indicator fun _ => (1 : ℝ)) R.measure :=
      (integrableOn_const (C := (1 : ℝ)) hVK'fin).integrable_indicator hVK'm
    have hle : (fun x => K'.indicator (fun _ => 1 - δ) x -
        (V \ K').indicator (fun _ => (1 : ℝ)) x) ≤ᵐ[R.measure]
          fun x => R.orient x ((ω : DifferentialForm (Euclid P) n) x) := by
      filter_upwards [hgood] with x hx
      obtain ⟨⟨hx1, -, hx3⟩, -⟩ := hx
      change _ ≤ R.orient x (ω₀ x)
      by_cases hxK' : x ∈ K'
      · rw [indicator_of_mem hxK', indicator_of_notMem (fun h => h.2 hxK'), sub_zero]
        have h1 := hx1 (ω₀ x - Ld (R.orient x))
        have h2 : covectorEuclideanNorm (ω₀ x - Ld (R.orient x)) ≤ δ := by
          rw [hcoef, map_sub]
          exact hω₀β x hxK'
        rw [map_sub, hx3] at h1
        linarith [neg_abs_le (R.orient x (ω₀ x) - 1)]
      · rw [indicator_of_notMem hxK', zero_sub]
        by_cases hxV : x ∈ V
        · rw [indicator_of_mem (show x ∈ V \ K' from ⟨hxV, hxK'⟩)]
          have h3 : covectorEuclideanNorm (ω₀ x) ≤ 1 := by
            rw [hcoef]
            exact hω₀1 x
          linarith [neg_abs_le (R.orient x (ω₀ x)), hx1 (ω₀ x)]
        · rw [indicator_of_notMem (fun h => hxV h.1), neg_zero,
            image_eq_zero_of_notMem_tsupport (fun h => hxV (hω₀V h)), map_zero]
    have hint : ∫ x, (K'.indicator (fun _ => 1 - δ) x - (V \ K').indicator (fun _ => (1 : ℝ)) x)
        ∂R.measure ≤ ∫ x, R.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂R.measure :=
      integral_mono_ae (hi1.sub hi2) hfi hle
    rw [integral_sub hi1 hi2, integral_indicator_const _ hK'm, integral_indicator_const _ hVK'm,
      smul_eq_mul, smul_eq_mul, mul_one, ← hfe] at hint
    -- arithmetic: `S(ω) > r`
    have hm1 : (r : ℝ) + ε < m := by
      have := ENNReal.toReal_strict_mono hKfin.ne hrK
      rwa [ENNReal.toReal_add ENNReal.coe_ne_top ENNReal.coe_ne_top, ENNReal.coe_toReal,
        ENNReal.coe_toReal] at this
    have hc : R.measure.real (K \ K') < η := ENNReal.toReal_lt_of_lt_ofReal hKK'
    have hb : R.measure.real (V \ K') < η := ENNReal.toReal_lt_of_lt_ofReal hVK'
    have hsplit : R.measure.real (K ∩ K') + R.measure.real (K \ K') = m :=
      measureReal_inter_add_sdiff hK'm hKfin.ne
    rw [inter_eq_right.2 (hK'K.trans sdiff_subset)] at hsplit
    have hc0 : 0 ≤ R.measure.real (K \ K') := measureReal_nonneg
    have hδm : R.measure.real K' * δ < η := by
      have h1 : m * δ < η := by
        rw [hδ, ← mul_div_assoc, div_lt_iff₀ (by linarith)]
        nlinarith
      have h2 : R.measure.real K' * δ ≤ m * δ :=
        mul_le_mul_of_nonneg_right (by linarith) hδ0.le
      linarith
    have hrT : (r : ℝ) < S ω := by linarith
    calc (r : ℝ≥0∞) = ENNReal.ofReal r := ENNReal.ofReal_coe_nnreal.symm
      _ ≤ ENNReal.ofReal (S ω) := ENNReal.ofReal_le_ofReal hrT.le
      _ ≤ S.massOn W := S.le_massOn hadm
  -- Step 7 (Simon Ch. 6, 3.2(3)): `M_W(S) = μ_R(W)` for every open `W`
  have hmass : ∀ W : Set (Euclid P), IsOpen W → S.massOn W = R.measure W :=
    fun W hW => le_antisymm (hupper W) (hlower W hW)
  -- Step 8 (Simon 7.3.1(2) via 6.2.23): for `c > 0`, the cone property `η_{0,c#}S = S` reads
  -- `S(ω) = S(η_{0,c}^# ω)` with `η_{0,c}^# ω(z) = c⁻ⁿ ω(c⁻¹z)` (multilinearity), so
  -- `ω'(z) = ω(c⁻¹z)` defines a test form with `S(ω') = cⁿ S(ω)`
  have hdil : ∀ c : ℝ, 0 < c → ∀ ω : TestFormOn (univ : Set (Euclid P)) n,
      ∃ ω' : TestFormOn (univ : Set (Euclid P)) n,
        (∀ z, (ω' : DifferentialForm (Euclid P) n) z =
          (ω : DifferentialForm (Euclid P) n) (c⁻¹ • z)) ∧ S ω' = c ^ n * S ω := by
    intro c hc ω
    have hc1 := hcone c hc ω
    have hV : dilation (0 : Euclid P) c '' univ = univ := by
      refine eq_univ_of_forall fun x => ⟨c • x, mem_univ _, ?_⟩
      simp [dilation, dilationCLM, smul_smul, mul_inv_cancel₀ hc.ne']
    have h : IsTestForm (ω : DifferentialForm (Euclid P) n) ∧
        tsupport (ω : DifferentialForm (Euclid P) n) ⊆ dilation (0 : Euclid P) c '' univ :=
      ⟨ω.property.1, by rw [hV]; exact subset_univ _⟩
    rw [currentEval, dite_eq_left h] at hc1
    obtain ⟨ω₁, hω₁, hS₁⟩ : ∃ ω₁ : TestFormOn (univ : Set (Euclid P)) n,
        (∀ z, (ω₁ : DifferentialForm (Euclid P) n) z =
          (c⁻¹ ^ n) • (ω : DifferentialForm (Euclid P) n) (c⁻¹ • z)) ∧ S ω₁ = S ω := by
      refine ⟨_, fun z => ?_, hc1⟩
      ext v
      change (ω : DifferentialForm (Euclid P) n) (-(c⁻¹ • (0 : Euclid P)) + dilationCLM P c z)
          (fun i => dilationCLM P c (v i)) = _
      simp only [dilationCLM, smul_zero, neg_zero, zero_add, smul_apply,
        ContinuousLinearMap.id_apply, ContinuousAlternatingMap.smul_apply, smul_eq_mul]
      rw [ContinuousAlternatingMap.map_smul_univ, Finset.prod_const, Finset.card_univ,
        Fintype.card_fin, smul_eq_mul]
    refine ⟨(c ^ n) • ω₁, fun z => ?_, ?_⟩
    · change (c ^ n) • (ω₁ : DifferentialForm (Euclid P) n) z = _
      rw [hω₁, smul_smul, ← mul_pow, mul_inv_cancel₀ hc.ne', one_pow, one_smul]
    · rw [map_smul, smul_eq_mul, hS₁]
  -- Step 9: `cⁿ M_{B_ρ(x)}(S) ≤ M_{B_{cρ}(cx)}(S)`: `ω ↦ ω'` maps admissible forms for `B_ρ(x)`
  -- to admissible forms for `B_{cρ}(cx)`
  have hscale : ∀ c : ℝ, 0 < c → ∀ (x : Euclid P) (ρ : ℝ),
      ENNReal.ofReal (c ^ n) * S.massOn (ball x ρ) ≤ S.massOn (ball (c • x) (c * ρ)) := by
    intro c hc x ρ
    rw [GeometricCurrentOn.massOn, ENNReal.mul_sSup]
    refine iSup₂_le fun _ ⟨ω, ⟨hωB, hω1⟩, hω⟩ => ?_
    subst hω
    obtain ⟨ω', hω', hS'⟩ := hdil c hc ω
    have hadm : ω' ∈ massAdmissibleOn univ n (ball (c • x) (c * ρ)) := by
      refine ⟨fun z hz => ?_, fun z => ?_⟩
      · have hsub : tsupport (ω' : DifferentialForm (Euclid P) n) ⊆
            (fun z => c⁻¹ • z) ⁻¹' tsupport (ω : DifferentialForm (Euclid P) n) := by
          have hfun : (ω' : DifferentialForm (Euclid P) n) =
              (ω : DifferentialForm (Euclid P) n) ∘ fun z => c⁻¹ • z := funext hω'
          rw [hfun]
          exact tsupport_comp_subset_preimage _ (continuous_const_smul _)
        have h2 := hωB (hsub hz)
        rw [mem_ball, dist_eq_norm] at h2 ⊢
        calc ‖z - c • x‖ = ‖c • (c⁻¹ • z - x)‖ := by
              rw [smul_sub, smul_smul, mul_inv_cancel₀ hc.ne', one_smul]
          _ = c * ‖c⁻¹ • z - x‖ := by rw [norm_smul, Real.norm_of_nonneg hc.le]
          _ < c * ρ := mul_lt_mul_of_pos_left h2 hc
      · rw [hω']
        exact hω1 _
    calc ENNReal.ofReal (c ^ n) * ENNReal.ofReal (S ω) = ENNReal.ofReal (S ω') := by
          rw [← ENNReal.ofReal_mul (by positivity), hS']
      _ ≤ S.massOn (ball (c • x) (c * ρ)) := S.le_massOn hadm
  -- Step 10: `M_{B_{cρ}(cx)}(S) = cⁿ M_{B_ρ(x)}(S)`, using Step 9 for `c` and `c⁻¹`
  have hscale_eq : ∀ c : ℝ, 0 < c → ∀ (x : Euclid P) (ρ : ℝ),
      S.massOn (ball (c • x) (c * ρ)) = ENNReal.ofReal (c ^ n) * S.massOn (ball x ρ) := by
    intro c hc x ρ
    refine le_antisymm ?_ (hscale c hc x ρ)
    have h1 := hscale c⁻¹ (inv_pos.2 hc) (c • x) (c * ρ)
    rw [smul_smul, inv_mul_cancel₀ hc.ne', one_smul, ← mul_assoc, inv_mul_cancel₀ hc.ne',
      one_mul] at h1
    calc S.massOn (ball (c • x) (c * ρ))
        = ENNReal.ofReal (c ^ n) * (ENNReal.ofReal (c⁻¹ ^ n) *
            S.massOn (ball (c • x) (c * ρ))) := by
          rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity), ← mul_pow,
            mul_inv_cancel₀ hc.ne', one_pow, ENNReal.ofReal_one, one_mul]
      _ ≤ ENNReal.ofReal (c ^ n) * S.massOn (ball x ρ) := by gcongr
  -- Step 11: `B_ρ(y + λw) = (· + (-y))⁻¹(B_ρ(λw))` with `-y ∈ L` and `ρ = λ(ρ/λ)`, so
  -- `M_{B_ρ(y + λw)}(S) = μ_R(B_ρ(y + λw)) = μ_R(B_ρ(λw)) = M_{B_ρ(λw)}(S) = λⁿ M_{B_{ρ/λ}(w)}(S)`
  have hball : ∀ ρ : ℝ, S.massOn (ball (y + lam • w) ρ) =
      ENNReal.ofReal (lam ^ n) * S.massOn (ball w (ρ / lam)) := by
    intro ρ
    have htr : ball (y + lam • w) ρ = (fun x => x + -y) ⁻¹' ball (lam • w) ρ := by
      ext x
      simp only [mem_preimage, mem_ball, dist_eq_norm]
      rw [show x + -y - lam • w = x - (y + lam • w) by abel]
    have hρ : lam * (ρ / lam) = ρ := by field_simp
    rw [hmass _ isOpen_ball, htr, hinv (-y) (L.neg_mem hy) _ measurableSet_ball,
      ← hmass _ isOpen_ball, ← hscale_eq lam hlam w (ρ / lam), hρ]
  -- Step 12: the density ratio of `S` at `y + λw` and radius `ρ > 0` equals that at `w` and
  -- radius `ρ/λ` (cancel `0 < λⁿ < ∞`), and `ρ/λ → 0+` as `ρ → 0+`
  refine ⟨hθ.1, ?_⟩
  have hratio : ∀ ρ : ℝ, 0 < ρ →
      S.massOn (ball (y + lam • w) ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n)) =
        S.massOn (ball w (ρ / lam)) / (unitBallVolume n * ENNReal.ofReal ((ρ / lam) ^ n)) := by
    intro ρ hρ
    have hρn : ENNReal.ofReal (ρ ^ n) =
        ENNReal.ofReal (lam ^ n) * ENNReal.ofReal ((ρ / lam) ^ n) := by
      rw [← ENNReal.ofReal_mul (by positivity), ← mul_pow, mul_div_cancel₀ ρ hlam.ne']
    rw [hball ρ, hρn, mul_left_comm, ENNReal.mul_div_mul_left _ _
      (ENNReal.ofReal_pos.2 (pow_pos hlam n)).ne' ENNReal.ofReal_ne_top]
  have hmap : Tendsto (fun ρ : ℝ => ρ / lam) (𝓝[>] 0) (𝓝[>] 0) := by
    refine tendsto_nhdsWithin_iff.2
      ⟨?_, eventually_nhdsWithin_of_forall fun ρ hρ => div_pos hρ hlam⟩
    have h0 : Tendsto (fun ρ : ℝ => ρ / lam) (𝓝 0) (𝓝 (0 / lam)) :=
      (continuous_id.div_const lam).tendsto 0
    rw [zero_div] at h0
    exact h0.mono_left nhdsWithin_le_nhds
  exact (hθ.2.comp hmap).congr' (eventually_nhdsWithin_of_forall fun ρ hρ => (hratio ρ hρ).symm)
/-- **Boundary rectifiability in `ℝᴾ` for compactly supported integer multiplicity currents**
(Simon Ch. 6, 6.2 first case and 6.3), from the deformation theorem (DTr) and the closure theorem
`CL_P(d)`: if `T ∈ 𝒟_{d+1}(ℝᴾ)` is integer multiplicity with compact support, `M(T) < ∞` and
`M(∂T) < ∞`, then `∂T` is integer multiplicity.  (DTr) with `ρ_k = 2⁻ᵏ` gives
`T - Q_k - S_k = ∂R_k` with `∂Q_k` integer multiplicity, `M(∂Q_k) ≤ c M(∂T)`,
`M(R_k) ≤ c ρ_k M(T)` and `M(S_k) ≤ c ρ_k M(∂T)`.  The evaluation bound by mass gives
`|Q_k(ω) - T(ω)| ≤ |S_k(ω)| + |R_k(dω)| ≤ ρ_k c (C_ω M(∂T) + C_{dω} M(T)) → 0`, so `Q_k ⇀ T` and
`∂Q_k ⇀ ∂T`.  Since `∂∂Q_k = 0` (and `∂ = 0` in degree `0`), `M_W(∂Q_k) + M_W(∂∂Q_k) ≤ c M(∂T)`
for every open `W`, and `CL_P(d)` in `U = ℝᴾ` shows that `∂T` is integer multiplicity. -/
theorem Submission.dtc_bc_tc_cl_bim_boundary_im_of_compact_support : (∀ (P m : ℕ), m + 1 < P → ∃ c : NNReal, 1 ≤ c ∧ ∀ (ρ : ℝ) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 0 < ρ → IsIntegerMultiplicity T → IsCompact T.support → T.mass < ∞ → T.boundary.mass < ∞ → ∃ (Q : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q ∧ IsIntegerMultiplicity Q.boundary ∧ IsIntegerMultiplicity R ∧ T - Q - S = R.boundary ∧ (Q = 0 ∨ ENNReal.ofReal (ρ ^ (m + 1)) ≤ Q.mass) ∧ Q.mass ≤ c * T.mass ∧ Q.boundary.mass ≤ c * T.boundary.mass ∧ R.mass ≤ c * ENNReal.ofReal ρ * T.mass ∧ S.mass ≤ c * ENNReal.ofReal ρ * T.boundary.mass ∧ Q.support ∪ R.support ⊆ thickening (3 * Real.sqrt P * ρ) T.support ∧ Q.boundary.support ∪ S.support ⊆ thickening (3 * Real.sqrt P * ρ) T.boundary.support) → ∀ (P d : ℕ), d + 1 < P → (∀ (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U d) (T : GeometricCurrentOn U d), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T) → ∀ T : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1), IsIntegerMultiplicity T → IsCompact T.support → T.mass < ∞ → T.boundary.mass < ∞ → IsIntegerMultiplicity T.boundary := by
  -- the zero current has zero local mass
  have massOn_zero_aux : ∀ {P m : ℕ} {U : Set (Euclid P)} (W : Set (Euclid P)),
      (0 : GeometricCurrentOn U m).massOn W = 0 := by
    intro P m U W
    apply le_antisymm _ bot_le
    apply sSup_le
    rintro _ ⟨ω, -, rfl⟩
    simp
  -- `boundaryMassOn (∂Z) W = 0`: by definition in degree `0`, by `∂∂ = 0` otherwise
  have boundaryMassOn_boundary_aux : ∀ {P : ℕ} {U : Set (Euclid P)} (k : ℕ)
      (Z : GeometricCurrentOn U (k + 1)) (W : Set (Euclid P)), boundaryMassOn Z.boundary W = 0 := by
    intro P U k Z W
    cases k with
    | zero => rfl
    | succ m =>
      change Z.boundary.boundary.massOn W = 0
      rw [GeometricCurrentOn.boundary_boundary]
      exact massOn_zero_aux W
  intro hDTr P d hdP hCL T hT hTc hm hbm
  -- Steps 1–2: (DTr) with `ρ_k = (1/2)^k`
  obtain ⟨c, -, hc⟩ := hDTr P d hdP
  have hρ : ∀ k : ℕ, (0 : ℝ) < (1 / 2 : ℝ) ^ k := fun k => by positivity
  choose Q R S _ hQb _ hEq _ _ hQbm hRm hSm _ _ using
    fun k => hc ((1 / 2 : ℝ) ^ k) T (hρ k) hT hTc hm hbm
  -- Step 3: a uniform bound for the Euclidean coefficient norm of a test form
  have hbound : ∀ {m : ℕ} (ω : TestFormOn (univ : Set (Euclid P)) m), ∃ C : ℝ, 0 < C ∧
      ∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) m) x) ≤ C := by
    intro m ω
    have hω1 : IsSmoothForm (ω : DifferentialForm (Euclid P) m) := ω.property.1.1
    have hω2 : HasCompactSupport (ω : DifferentialForm (Euclid P) m) := ω.property.1.2
    have hωc : Continuous (ω : DifferentialForm (Euclid P) m) := hω1.continuous
    have hcont :
        Continuous fun x => covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) m) x) :=
      (Submission.rsd_mw_tfa_norm_props P m).2.2.2.comp hωc
    have hcs :
        HasCompactSupport fun x => covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) m) x) :=
      hω2.comp_left (g := fun α : Covector (Euclid P) m => covectorEuclideanNorm α)
        (covectorEuclideanNorm_zero P m)
    obtain ⟨C, hC⟩ := hcs.exists_bound_of_continuous hcont
    refine ⟨max C 1, lt_max_of_lt_right one_pos, fun x => ?_⟩
    exact (le_abs_self _).trans ((Real.norm_eq_abs _ ▸ hC x).trans (le_max_left _ _))
  -- Step 4: `|Q_k(ω) - T(ω)| ≤ ρ_k A`, hence `Q_k ⇀ T`
  have hconv : WeaklyConvergesOn Q T := by
    intro ω
    obtain ⟨C₁, hC₁, hb₁⟩ := hbound ω
    obtain ⟨C₂, hC₂, hb₂⟩ := hbound (exteriorDerivativeTestOn univ (d + 1) ω)
    set A : ℝ≥0∞ := ENNReal.ofReal C₁ * ((c : ℝ≥0∞) * T.boundary.mass) +
      ENNReal.ofReal C₂ * ((c : ℝ≥0∞) * T.mass) with hA
    have hAfin : A ≠ ∞ := by
      rw [hA]
      exact ENNReal.add_ne_top.mpr ⟨ENNReal.mul_ne_top ENNReal.ofReal_ne_top
        (ENNReal.mul_ne_top ENNReal.coe_ne_top hbm.ne), ENNReal.mul_ne_top ENNReal.ofReal_ne_top
        (ENNReal.mul_ne_top ENNReal.coe_ne_top hm.ne)⟩
    have hkey : ∀ k, |Q k ω - T ω| ≤ (1 / 2 : ℝ) ^ k * A.toReal := by
      intro k
      have e : T ω - Q k ω - S k ω = R k (exteriorDerivativeTestOn univ (d + 1) ω) := by
        have := congrArg (fun Z : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1) => Z ω) (hEq k)
        exact this
      have hS :
          (S k).massOn univ ≤ (c : ℝ≥0∞) * ENNReal.ofReal ((1 / 2 : ℝ) ^ k) * T.boundary.mass :=
        hSm k
      have hR : (R k).massOn univ ≤ (c : ℝ≥0∞) * ENNReal.ofReal ((1 / 2 : ℝ) ^ k) * T.mass := hRm k
      have hSfin : (S k).massOn univ ≠ ∞ := ne_top_of_le_ne_top
        (ENNReal.mul_ne_top (ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.ofReal_ne_top) hbm.ne) hS
      have hRfin : (R k).massOn univ ≠ ∞ := ne_top_of_le_ne_top
        (ENNReal.mul_ne_top (ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.ofReal_ne_top) hm.ne) hR
      have h1 : ENNReal.ofReal |S k ω| ≤ ENNReal.ofReal C₁ * (S k).massOn univ := by
        have h := Submission.cmr_abs_apply_le_massOn P (d + 1) univ univ (S k) ω C₁ hSfin
          (subset_univ _) hb₁
        calc ENNReal.ofReal |S k ω| ≤ ENNReal.ofReal (C₁ * ((S k).massOn univ).toReal) :=
              ENNReal.ofReal_le_ofReal h
          _ = ENNReal.ofReal C₁ * (S k).massOn univ := by
              rw [ENNReal.ofReal_mul hC₁.le, ENNReal.ofReal_toReal hSfin]
      have h2 : ENNReal.ofReal |R k (exteriorDerivativeTestOn univ (d + 1) ω)| ≤
          ENNReal.ofReal C₂ * (R k).massOn univ := by
        have h := Submission.cmr_abs_apply_le_massOn P (d + 2) univ univ (R k)
          (exteriorDerivativeTestOn univ (d + 1) ω) C₂ hRfin (subset_univ _) hb₂
        calc ENNReal.ofReal |R k (exteriorDerivativeTestOn univ (d + 1) ω)| ≤
              ENNReal.ofReal (C₂ * ((R k).massOn univ).toReal) := ENNReal.ofReal_le_ofReal h
          _ = ENNReal.ofReal C₂ * (R k).massOn univ := by
              rw [ENNReal.ofReal_mul hC₂.le, ENNReal.ofReal_toReal hRfin]
      have hle : ENNReal.ofReal |Q k ω - T ω| ≤ ENNReal.ofReal ((1 / 2 : ℝ) ^ k) * A := by
        have habs : |Q k ω - T ω| ≤ |S k ω| + |R k (exteriorDerivativeTestOn univ (d + 1) ω)| := by
          rw [← e]
          calc |Q k ω - T ω| = |-(S k ω) - (T ω - Q k ω - S k ω)| := by ring_nf
            _ ≤ |-(S k ω)| + |T ω - Q k ω - S k ω| := abs_sub _ _
            _ = |S k ω| + |T ω - Q k ω - S k ω| := by rw [abs_neg]
        calc ENNReal.ofReal |Q k ω - T ω|
            ≤ ENNReal.ofReal |S k ω| +
                ENNReal.ofReal |R k (exteriorDerivativeTestOn univ (d + 1) ω)| :=
              (ENNReal.ofReal_le_ofReal habs).trans ENNReal.ofReal_add_le
          _ ≤ ENNReal.ofReal C₁ *
                ((c : ℝ≥0∞) * ENNReal.ofReal ((1 / 2 : ℝ) ^ k) * T.boundary.mass) +
              ENNReal.ofReal C₂ * ((c : ℝ≥0∞) * ENNReal.ofReal ((1 / 2 : ℝ) ^ k) * T.mass) := by
              gcongr
              · exact h1.trans (by gcongr)
              · exact h2.trans (by gcongr)
          _ = ENNReal.ofReal ((1 / 2 : ℝ) ^ k) * A := by rw [hA]; ring
      have := ENNReal.toReal_mono (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hAfin) hle
      rwa [ENNReal.toReal_ofReal (abs_nonneg _), ENNReal.toReal_mul,
        ENNReal.toReal_ofReal (hρ k).le] at this
    rw [tendsto_iff_dist_tendsto_zero]
    have hlim : Tendsto (fun k : ℕ => (1 / 2 : ℝ) ^ k * A.toReal) atTop (𝓝 0) := by
      simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 2)
        (by norm_num : (1 / 2 : ℝ) < 1)).mul_const A.toReal
    exact squeeze_zero (fun k => dist_nonneg) (fun k => by rw [Real.dist_eq]; exact hkey k) hlim
  -- Steps 5–7: `∂Q_k ⇀ ∂T` with `M_W(∂Q_k) + M_W(∂∂Q_k) ≤ c M(∂T)`, then `CL_P(d)` in `ℝᴾ`
  refine hCL univ (fun k => (Q k).boundary) T.boundary isOpen_univ hQb ?_ hconv.boundary
  intro W _ _
  refine lt_of_le_of_lt (b := (c : ℝ≥0∞) * T.boundary.mass) (iSup_le fun k => ?_)
    (ENNReal.mul_lt_top ENNReal.coe_lt_top hbm)
  rw [boundaryMassOn_boundary_aux d (Q k) W, add_zero]
  exact ((Q k).boundary.massOn_mono (subset_univ W)).trans (hQbm k)
/-- **Density of a bounded field against a finite measure `μ ≪ Lⁿ`** (Radon–Nikodym, Simon
1.3.24): if `μ(ℝⁿ) < ∞`, `μ ≪ Lⁿ` and `|h| ≤ 1` `μ`-a.e., then `u = ρ h̃`, with `ρ = dμ/dLⁿ` and
`h̃` a strongly measurable representative of `h`, is Lebesgue integrable, `∫ |u| dy ≤ μ(ℝⁿ)`, and
`∫ g h dμ = ∫ u g dy` for every `g`.  Here `μ = Lⁿ⌞ρ` because the singular part of `μ` vanishes. -/
theorem Submission.cbr_ci_pw_td_finite_ac_density : ∀ (n : ℕ) (μ : Measure (Euclid n)) (h : Euclid n → ℝ), μ univ < ∞ → μ ≪ volume → AEStronglyMeasurable h μ → (∀ᵐ y ∂μ, |h y| ≤ 1) → ∃ u : Euclid n → ℝ, Integrable u ∧ ∫ y, |u y| ≤ (μ univ).toReal ∧ ∀ g : Euclid n → ℝ, ∫ y, g y * h y ∂μ = ∫ y, u y * g y := by
  intro n μ h hfin hac hhm hhb
  have : IsFiniteMeasure μ := ⟨hfin⟩
  set ρ : Euclid n → ℝ≥0∞ := μ.rnDeriv volume with hρ
  have hρm : Measurable ρ := Measure.measurable_rnDeriv μ volume
  have hρfin : ∀ᵐ y ∂(volume : Measure (Euclid n)), ρ y < ∞ := Measure.rnDeriv_lt_top μ volume
  have hμeq : μ = (volume : Measure (Euclid n)).withDensity ρ := by
    conv_lhs => rw [Measure.haveLebesgueDecomposition_add μ volume]
    rw [Measure.singularPart_eq_zero_of_ac hac, zero_add]
  let h' := hhm.mk h
  have hh'm : StronglyMeasurable h' := hhm.stronglyMeasurable_mk
  have hhh' : h =ᵐ[μ] h' := hhm.ae_eq_mk
  have hint : Integrable (fun y => (ρ y).toReal) :=
    integrable_toReal_of_lintegral_ne_top hρm.aemeasurable (Measure.lintegral_rnDeriv_lt_top μ volume).ne
  have h1 : ∀ᵐ y ∂μ, |h' y| ≤ 1 := (hhb.and hhh').mono fun y hy => hy.2 ▸ hy.1
  rw [hμeq, ae_withDensity_iff hρm] at h1
  have hbound : ∀ᵐ y ∂(volume : Measure (Euclid n)), ‖(ρ y).toReal * h' y‖ ≤ (ρ y).toReal := by
    filter_upwards [h1] with y hy
    by_cases h0 : ρ y = 0
    · simp [h0]
    · rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg ENNReal.toReal_nonneg]
      exact mul_le_of_le_one_right ENNReal.toReal_nonneg (hy h0)
  have hu : Integrable (fun y => (ρ y).toReal * h' y) :=
    hint.mono' ((ENNReal.measurable_toReal.comp hρm).stronglyMeasurable.mul hh'm).aestronglyMeasurable hbound
  refine ⟨fun y => (ρ y).toReal * h' y, hu, ?_, ?_⟩
  · have hlin : ∫⁻ y, ρ y = μ univ := by
      conv_rhs => rw [hμeq]
      rw [withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
    calc ∫ y, |(ρ y).toReal * h' y| ≤ ∫ y, (ρ y).toReal :=
          integral_mono_ae hu.abs hint (hbound.mono fun y hy => by simpa [Real.norm_eq_abs] using hy)
      _ = (∫⁻ y, ρ y).toReal := integral_toReal hρm.aemeasurable hρfin
      _ = (μ univ).toReal := by rw [hlin]
  · intro g
    calc ∫ y, g y * h y ∂μ = ∫ y, g y * h' y ∂μ :=
          integral_congr_ae (hhh'.mono fun y hy => by simp only [hy])
      _ = ∫ y, g y * h' y ∂((volume : Measure (Euclid n)).withDensity ρ) := by rw [← hμeq]
      _ = ∫ y, (ρ y).toReal • (g y * h' y) :=
          integral_withDensity_eq_integral_toReal_smul hρm hρfin _
      _ = ∫ y, (ρ y).toReal * h' y * g y := by
          congr 1; funext y; rw [smul_eq_mul]; ring

/-- **Top-dimensional currents with finite mass and locally finite boundary mass have `L¹`
densities.**  Assume the mass representation (REP).  If `U ⊆ ℝⁿ` is open (`n = d + 1`),
`Y ∈ 𝒟ₙ(U)`, `M_U(Y) < ∞` and `M_W(∂Y) < ∞` for `W ⊂⊂ U`, then `Y(ω) = ∫_U u ω(e) dy` for an
integrable `u` with `∫_U |u| ≤ M_U(Y)`, `e = (e₁, …, eₙ)` the standard basis.  (REP) gives
`(μ, ξ)`; the boundary bound gives `μ ≪ Hⁿ = Lⁿ`, and `μ(ℝⁿ) ≤ μ(U) + μ(Uᶜ) = M_U(Y)`.  For
`δ = dy` (`δ(e) = 1`) every top covector is `λ = λ(e) δ`, so `ξ(ω) = ω(e) ξ(δ)`; the density of
`μ` against the field `ξ(δ)`, `|ξ(δ)| ≤ |δ| = 1`, is the required `u`. -/
theorem Submission.cbr_ci_pw_top_current_density : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → ∀ (d : ℕ) (U : Set (Euclid (d + 1))) (Y : GeometricCurrentOn U (d + 1)), IsOpen U → Y.massOn U < ∞ → (∀ W : Set (Euclid (d + 1)), IsOpen W → CompactlyContained W U → Y.boundary.massOn W < ∞) → ∃ u : Euclid (d + 1) → ℝ, IntegrableOn u U ∧ ENNReal.ofReal (∫ y in U, |u y|) ≤ Y.massOn U ∧ ∀ ω : TestFormOn U (d + 1), Y ω = ∫ y in U, u y * (ω : DifferentialForm (Euclid (d + 1)) (d + 1)) y (fun i => EuclideanSpace.single i (1 : ℝ)) := by
  intro REP d U Y hU hYU hbd
  have hloc : ∀ W : Set (Euclid (d + 1)), IsOpen W → CompactlyContained W U → Y.massOn W < ∞ :=
    fun W _ hW => lt_of_le_of_lt (Y.massOn_mono (subset_closure.trans hW.2)) hYU
  obtain ⟨μ, ξ, hμU, -, hμW, hξm, hξb, hrep, hnull⟩ := REP (d + 1) (d + 1) U Y hU hloc
  have hnull' : ∀ E : Set (Euclid (d + 1)), μHE[d + 1] E = 0 → μ E = 0 := hnull hbd
  have hμuniv : μ univ ≤ Y.massOn U := by
    calc μ univ ≤ μ U + μ Uᶜ := by
          rw [← union_compl_self U]; exact measure_union_le _ _
      _ = Y.massOn U := by rw [hμU, add_zero, hμW U hU]
  have hμfin : μ univ < ∞ := lt_of_le_of_lt hμuniv hYU
  have hac : μ ≪ volume := by
    intro E hE
    apply hnull' E
    rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
    exact hE
  obtain ⟨δ, hδ⟩ := Submission.dgoj_exists_det_covector (d + 1)
  obtain ⟨hδn, hspan⟩ := Submission.cbr_ci_pw_td_top_covector_spans (d + 1) δ hδ
  set h : Euclid (d + 1) → ℝ := fun y => ξ y δ
  have hhm : AEStronglyMeasurable h μ :=
    (ContinuousLinearMap.apply ℝ ℝ δ).continuous.comp_aestronglyMeasurable hξm
  have hhb : ∀ᵐ y ∂μ, |h y| ≤ 1 :=
    Eventually.of_forall fun y => (hξb y δ).trans hδn.le
  obtain ⟨u, hui, hul1, hug⟩ :=
    Submission.cbr_ci_pw_td_finite_ac_density (d + 1) μ h hμfin hac hhm hhb
  refine ⟨u, hui.integrableOn, ?_, ?_⟩
  · apply ENNReal.ofReal_le_of_le_toReal
    calc ∫ y in U, |u y| ≤ ∫ y, |u y| :=
          setIntegral_le_integral hui.abs (Eventually.of_forall fun y => abs_nonneg _)
      _ ≤ (μ univ).toReal := hul1
      _ ≤ (Y.massOn U).toReal := ENNReal.toReal_mono hYU.ne hμuniv
  · intro ω
    rw [hrep ω]
    have hpt : ∀ y, ξ y ((ω : DifferentialForm (Euclid (d + 1)) (d + 1)) y) =
        (ω : DifferentialForm (Euclid (d + 1)) (d + 1)) y
          (fun i => EuclideanSpace.single i (1 : ℝ)) * h y := by
      intro y
      conv_lhs => rw [hspan ((ω : DifferentialForm (Euclid (d + 1)) (d + 1)) y)]
      rw [map_smul, smul_eq_mul]
    simp_rw [hpt]
    rw [hug]
    symm
    apply setIntegral_eq_integral_of_forall_compl_eq_zero
    intro y hy
    have hy' : y ∉ tsupport (ω : DifferentialForm (Euclid (d + 1)) (d + 1)) :=
      fun h' => hy (ω.2.2 h')
    rw [image_eq_zero_of_notMem_tsupport hy']
    simp
/-- Reflection symmetries of the coordinate Steiner symmetrization (Simon, Ch. 1, proof of 2.10).
Write `y[i↦t]` for `y` with `i`-th coordinate replaced by `t`, `R_i(y) = y[i↦-y_i]`,
`A^j_y = {t : y[j↦t] ∈ A}` and `S_j(A) = {y : A^j_y ≠ ∅, |y_j| ≤ L¹(A^j_y)/2}`.  Then (a) `S_j(A)`
is invariant under `R_j`, and (b) if `i ≠ j` and `A` is invariant under `R_i`, so is `S_j(A)`.
For (a), `R_j(y)[j↦t] = y[j↦t]`; for (b), `R_i(y)[j↦t] = R_i(y[j↦t])` and `R_i` is an involution,
so the `j`-slices of `y` and of its reflection agree, while `|(R_i y)_j| = |y_j|`. -/
theorem Submission.cbr_ci_iso_steiner_reflection : ∀ (d : ℕ) (j : Fin d) (A : Set (Euclid d)), (∀ x ∈ {y : Euclid d | {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}.Nonempty ∧ |y j| ≤ (volume {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}).toReal / 2}, WithLp.toLp 2 (Function.update x.ofLp j (-x j)) ∈ {y : Euclid d | {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}.Nonempty ∧ |y j| ≤ (volume {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}).toReal / 2}) ∧ ∀ i : Fin d, i ≠ j → (∀ x ∈ A, WithLp.toLp 2 (Function.update x.ofLp i (-x i)) ∈ A) → ∀ x ∈ {y : Euclid d | {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}.Nonempty ∧ |y j| ≤ (volume {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}).toReal / 2}, WithLp.toLp 2 (Function.update x.ofLp i (-x i)) ∈ {y : Euclid d | {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}.Nonempty ∧ |y j| ≤ (volume {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}).toReal / 2} := by
  intro d j A
  refine ⟨fun x hx => ?_, fun i hij hA x hx => ?_⟩
  · -- (a) `R_j(x)[j↦t] = x[j↦t]`, so the `j`-slice is unchanged, and `|(R_j x)_j| = |x_j|`
    simpa using hx
  · -- (b) `R_i` is an involution and commutes with `y ↦ y[j↦t]`, so the `j`-slices of `x` and
    -- `R_i(x)` agree; moreover `(R_i x)_j = x_j` since `i ≠ j`
    have hR : ∀ z : Euclid d, WithLp.toLp 2 (update (WithLp.toLp 2 (update z.ofLp i (-z i))).ofLp i
        (-(WithLp.toLp 2 (update z.ofLp i (-z i))) i)) = z := by
      intro z
      ext k
      by_cases hk : k = i
      · subst hk
        simp
      · simp [hk]
    have hcomm : ∀ t : ℝ, WithLp.toLp 2 (update (update x.ofLp i (-x i)) j t) =
        WithLp.toLp 2 (update (WithLp.toLp 2 (update x.ofLp j t)).ofLp i
          (-(WithLp.toLp 2 (update x.ofLp j t)) i)) := by
      intro t
      simp only [update_of_ne hij]
      rw [update_comm hij]
    have hslice : {t : ℝ | WithLp.toLp 2 (update (WithLp.toLp 2 (update x.ofLp i (-x i))).ofLp j t) ∈ A} =
        {t : ℝ | WithLp.toLp 2 (update x.ofLp j t) ∈ A} := by
      ext t
      simp only [Set.mem_ofPred_eq]
      rw [hcomm t]
      constructor
      · intro h
        have h' := hA _ h
        rwa [hR] at h'
      · exact hA _
    have hxj : (WithLp.toLp 2 (update x.ofLp i (-x i))) j = x j := by
      simp [hij.symm]
    show _ ∧ _
    rw [hslice, hxj]
    exact hx
/-- **Steiner symmetrization does not increase the diameter** (Simon 2.10, proof of the
isodiametric inequality).  For compact `A ⊆ ℝᵈ` and `j < d`, write `y[j↦t]` for `y` with its `j`-th
coordinate replaced by `t`, `A^j_y = {t : y[j↦t] ∈ A}`, `λ(y) = L¹(A^j_y)` and
`S_j(A) = {y : A^j_y ≠ ∅, |y_j| ≤ λ(y)/2}`; then `ediam S_j(A) ≤ ediam A`.  Each slice `A^j_y` is
compact, so it contains `a_y = inf A^j_y` and `b_y = sup A^j_y`, and `λ(y) ≤ b_y - a_y`.  For
`x, y ∈ S_j(A)`, `|x_j - y_j| ≤ (λ(x) + λ(y))/2 ≤ max(b_y - a_x, b_x - a_y)`, and replacing the
`j`-th coordinates of `x, y` by the matching endpoints gives two points of `A` at distance at least
`|x - y|`. -/
theorem Submission.cbr_ci_iso_steiner_ediam_le : ∀ (d : ℕ) (j : Fin d) (A : Set (Euclid d)), IsCompact A → ediam {y : Euclid d | {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}.Nonempty ∧ |y j| ≤ (volume {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}).toReal / 2} ≤ ediam A := by
  intro d j A hA
  -- (1) every slice `A^j_y` is compact: closed, and contained in the compact image of `A`
  -- under the `j`-th coordinate
  have hslice : ∀ y : Euclid d,
      IsCompact {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A} := by
    intro y
    have hf : Continuous fun t : ℝ => WithLp.toLp 2 (Function.update y.ofLp j t) :=
      (PiLp.continuous_toLp 2 _).comp (continuous_const.update j continuous_id)
    refine (hA.image (PiLp.continuous_apply 2 _ j)).of_isClosed_subset
      (hA.isClosed.preimage hf) fun t ht => ⟨_, ht, by simp⟩
  -- (2) a nonempty compact `P ⊆ ℝ` contains `inf P` and `sup P`, and `L¹(P) ≤ sup P - inf P`
  have hlen : ∀ P : Set ℝ, IsCompact P → P.Nonempty →
      sInf P ∈ P ∧ sSup P ∈ P ∧ (volume P).toReal ≤ sSup P - sInf P := by
    intro P hP hne
    refine ⟨hP.sInf_mem hne, hP.sSup_mem hne, ?_⟩
    refine ENNReal.toReal_le_of_le_ofReal
      (sub_nonneg.mpr (csInf_le_csSup hne hP.bddBelow hP.bddAbove)) ?_
    calc volume P ≤ volume (Icc (sInf P) (sSup P)) :=
          measure_mono fun t ht => ⟨csInf_le hP.bddBelow ht, le_csSup hP.bddAbove ht⟩
      _ = ENNReal.ofReal (sSup P - sInf P) := Real.volume_Icc
  -- (3) two-point estimate: replacing the `j`-th coordinates by `a, b` with
  -- `|x_j - y_j| ≤ |a - b|` does not decrease the distance
  have hpt : ∀ (x y : Euclid d) (a b : ℝ), WithLp.toLp 2 (Function.update x.ofLp j a) ∈ A →
      WithLp.toLp 2 (Function.update y.ofLp j b) ∈ A → |x j - y j| ≤ |a - b| →
      edist x y ≤ ediam A := by
    intro x y a b ha hb hab
    refine le_trans ?_ (edist_le_ediam_of_mem ha hb)
    rw [edist_dist, edist_dist]
    refine ENNReal.ofReal_le_ofReal ?_
    rw [EuclideanSpace.dist_eq, EuclideanSpace.dist_eq]
    refine Real.sqrt_le_sqrt (Finset.sum_le_sum fun i _ => ?_)
    by_cases hi : i = j
    · subst hi
      simp only [Function.update_self, Real.dist_eq]
      exact pow_le_pow_left₀ (abs_nonneg _) hab 2
    · simp only [Function.update_of_ne hi, le_refl]
  -- (4) for `x, y ∈ S_j(A)`, `|x_j - y_j| ≤ (λ(x) + λ(y))/2` is realised by a pair of points of `A`
  refine ediam_le ?_
  rintro x ⟨hxne, hxj⟩ y ⟨hyne, hyj⟩
  obtain ⟨hax, hbx, hlx⟩ := hlen _ (hslice x) hxne
  obtain ⟨hay, hby, hly⟩ := hlen _ (hslice y) hyne
  have hx := abs_le.mp hxj
  have hy := abs_le.mp hyj
  rcases le_total
      (sSup {t : ℝ | WithLp.toLp 2 (Function.update x.ofLp j t) ∈ A} -
        sInf {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A})
      (sSup {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A} -
        sInf {t : ℝ | WithLp.toLp 2 (Function.update x.ofLp j t) ∈ A}) with h | h
  · refine hpt x y _ _ hax hby ?_
    rw [abs_sub_comm _ (sSup _)]
    exact (abs_le.mpr ⟨by linarith, by linarith⟩).trans (le_abs_self _)
  · refine hpt x y _ _ hbx hay ?_
    exact (abs_le.mpr ⟨by linarith, by linarith⟩).trans (le_abs_self _)
/-- **Simon, Ch. 1, Note after the proof of 2.10** (p. 12): for compact `A ⊆ ℝᵈ` and a coordinate
`j`, the length `y ↦ L¹{t : y[j ↦ t] ∈ A}` of the slice of `A` along the `j`-th coordinate line
through `y` is upper semicontinuous.  Every slice lies in `[-R, R]` (`A ⊆ B_R(0)`), so has finite
length.  Given `L¹(A^j_x) < r`, outer regularity gives an open `U ⊇ A^j_x` with `L¹(U) < r`; the
compact set `C = A ∖ {z : z_j ∈ U}` has closed image under `π z = z[j ↦ 0]`, `π x ∉ π(C)`, and for
`y` in the neighbourhood `π⁻¹(π(C)ᶜ)` of `x` the slice `A^j_y` lies in `U`, so `L¹(A^j_y) < r`. -/
theorem Submission.cbr_ci_iso_slice_length_usc : ∀ (d : ℕ) (j : Fin d) (A : Set (Euclid d)), IsCompact A → UpperSemicontinuous (fun y : Euclid d => (volume {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}).toReal) := by
  intro d j A hA
  -- every slice lies in `[-R, R]`, so it has finite length
  obtain ⟨R, hR⟩ := hA.isBounded.subset_closedBall (0 : Euclid d)
  have hfin : ∀ y : Euclid d,
      volume {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A} ≠ ∞ := by
    intro y
    refine ne_top_of_le_ne_top (measure_Icc_lt_top (a := -R) (b := R)).ne (measure_mono ?_)
    intro t ht
    have h1 := PiLp.norm_apply_le (WithLp.toLp 2 (Function.update y.ofLp j t) : Euclid d) j
    rw [WithLp.ofLp_toLp, Function.update_self, Real.norm_eq_abs] at h1
    exact abs_le.mp (h1.trans (mem_closedBall_zero_iff.mp (hR ht)))
  refine upperSemicontinuous_iff.mpr fun x => upperSemicontinuousAt_iff.mpr fun r hr => ?_
  -- outer regularity: an open `U` around the slice through `x` with `L¹(U) < r`
  obtain ⟨U, hxU, hUo, hUr⟩ := Set.exists_isOpen_lt_of_lt
    {t : ℝ | WithLp.toLp 2 (Function.update x.ofLp j t) ∈ A} (ENNReal.ofReal r)
    ((ENNReal.lt_ofReal_iff_toReal_lt (hfin x)).mpr hr)
  -- the projection `z ↦ z[j ↦ 0]` and the compact part of `A` off `{z : z_j ∈ U}`
  let proj : Euclid d → Euclid d := fun z => WithLp.toLp 2 (Function.update z.ofLp j 0)
  have hproj : Continuous proj :=
    (PiLp.continuous_toLp 2 _).comp
      ((continuous_update j).comp ((PiLp.continuous_ofLp 2 _).prodMk continuous_const))
  have hC : IsCompact (A \ {z : Euclid d | z.ofLp j ∈ U}) :=
    hA.diff (hUo.preimage (PiLp.continuous_apply 2 _ j))
  -- `π x ∉ π(C)`: a point of `C` over `π x` would put its `j`-th coordinate in the slice at `x`
  have hx : proj x ∉ proj '' (A \ {z : Euclid d | z.ofLp j ∈ U}) := by
    rintro ⟨z, ⟨hzA, hzU⟩, hzx⟩
    have h : Function.update z.ofLp j 0 = Function.update x.ofLp j 0 := by
      simpa only [proj, WithLp.ofLp_toLp] using congrArg WithLp.ofLp hzx
    have hz : WithLp.toLp 2 (Function.update x.ofLp j (z.ofLp j)) = z := by
      calc WithLp.toLp 2 (Function.update x.ofLp j (z.ofLp j))
          = WithLp.toLp 2 (Function.update (Function.update x.ofLp j 0) j (z.ofLp j)) := by
            rw [Function.update_idem]
        _ = z := by rw [← h, Function.update_idem, Function.update_eq_self, WithLp.toLp_ofLp]
    exact hzU (hxU (show WithLp.toLp 2 (Function.update x.ofLp j (z.ofLp j)) ∈ A by
      rw [hz]; exact hzA))
  -- on the neighbourhood `π⁻¹(π(C)ᶜ)` of `x` every slice lies in `U`
  filter_upwards [((hC.image hproj).isClosed.isOpen_compl.preimage hproj).mem_nhds hx] with y hy
  have hy' : proj y ∉ proj '' (A \ {z : Euclid d | z.ofLp j ∈ U}) := hy
  have hyU : {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A} ⊆ U := by
    intro t ht
    by_contra htU
    refine hy' ⟨WithLp.toLp 2 (Function.update y.ofLp j t), ⟨ht, ?_⟩, ?_⟩
    · show (WithLp.toLp 2 (Function.update y.ofLp j t)).ofLp j ∉ U
      rwa [WithLp.ofLp_toLp, Function.update_self]
    · simp only [proj, Function.update_idem]
  exact ENNReal.toReal_lt_of_lt_ofReal ((measure_mono hyU).trans_lt hUr)
/-- **Steiner symmetrization of a compact set is compact** (Simon Ch. 1, the Note after the proof
of 2.10: `S_j(A)` is compact because the slice length is upper semicontinuous).  Let `A ⊆ ℝ^d` be
compact, `A^j_y = {t : y[j ↦ t] ∈ A}` and `λ(y) = L¹(A^j_y)`.  If `λ` is upper semicontinuous,
then `S_j(A) = {y : A^j_y ≠ ∅, |y_j| ≤ λ(y)/2}` is compact: `{y : A^j_y ≠ ∅} = π⁻¹(π(A))` for
`π z = z[j ↦ 0]`, `{y : |y_j| ≤ λ(y)/2}` is a superlevel set of the upper semicontinuous
`λ − 2|y_j|`, and `S_j(A) ⊆ closedBall(0, 3R)` whenever `A ⊆ closedBall(0, R)`. -/
theorem Submission.cbr_ci_iso_steiner_isCompact : ∀ (d : ℕ) (j : Fin d) (A : Set (Euclid d)), IsCompact A → UpperSemicontinuous (fun y : Euclid d => (volume {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}).toReal) → IsCompact {y : Euclid d | {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}.Nonempty ∧ |y j| ≤ (volume {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}).toReal / 2} := by
  intro d j A hA hlen
  -- Step 1: `π z = z[j ↦ 0]` is continuous, and `π z = π y` forces `y[j ↦ z_j] = z`
  let π : Euclid d → Euclid d := fun z => WithLp.toLp 2 (Function.update z.ofLp j 0)
  have hπ : Continuous π :=
    (PiLp.continuous_toLp 2 _).comp ((PiLp.continuous_ofLp 2 _).update j continuous_const)
  have hπ_eq : ∀ y z : Euclid d, π z = π y →
      WithLp.toLp 2 (Function.update y.ofLp j (z j)) = z := by
    intro y z h
    ext i
    by_cases hi : i = j
    · subst hi
      simp
    · have := congrArg (fun w : Euclid d => w i) h
      simp only [π, Function.update_of_ne hi] at this ⊢
      exact this.symm
  -- Step 2: `{y : A^j_y ≠ ∅} = π⁻¹(π(A))` is closed, `π(A)` being compact
  have hN : IsClosed
      {y : Euclid d | {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}.Nonempty} := by
    convert (hA.image hπ).isClosed.preimage hπ using 1
    ext y
    constructor
    · rintro ⟨t, ht⟩
      exact ⟨_, ht, by simp [π]⟩
    · rintro ⟨z, hz, h⟩
      exact ⟨z j, by rw [mem_ofPred_eq, hπ_eq y z h]; exact hz⟩
  -- Step 3: `{y : 0 ≤ λ(y) − 2|y_j|}` is closed, `λ − 2|y_j|` being upper semicontinuous
  have hM : IsClosed {y : Euclid d | 0 ≤
      (volume {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}).toReal + -(2 * |y j|)} :=
    (hlen.add ((PiLp.continuous_apply 2 _ j).abs.const_mul 2).neg.upperSemicontinuous)
      |>.isClosed_preimage 0
  -- Step 4: `S_j(A)` is the intersection of these two closed sets
  have hS : IsClosed {y : Euclid d |
      {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}.Nonempty ∧
        |y j| ≤ (volume {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}).toReal / 2} := by
    convert hN.inter hM using 1
    ext y
    simp only [mem_ofPred_eq, mem_inter_iff]
    exact and_congr Iff.rfl ⟨fun h => by linarith, fun h => by linarith⟩
  -- Step 5: `S_j(A) ⊆ closedBall(0, 3R)` when `A ⊆ closedBall(0, R)`
  obtain ⟨R, hR⟩ := hA.isBounded.subset_closedBall 0
  refine Metric.isCompact_of_isClosed_isBounded hS
    ((isBounded_closedBall (x := (0 : Euclid d)) (r := 3 * R)).subset ?_)
  rintro y ⟨⟨t, ht⟩, hy⟩
  rw [mem_closedBall_zero_iff]
  -- every `s ∈ A^j_y` has `|s| ≤ ‖y[j ↦ s]‖ ≤ R`
  have hnorm : ∀ s : ℝ, WithLp.toLp 2 (Function.update y.ofLp j s) ∈ A → |s| ≤ R := by
    intro s hs
    have h1 := PiLp.norm_apply_le (WithLp.toLp 2 (Function.update y.ofLp j s)) j
    have h2 := mem_closedBall_zero_iff.1 (hR hs)
    simp only [Function.update_self, Real.norm_eq_abs] at h1
    linarith
  -- hence `A^j_y ⊆ [−R, R]` and `λ(y) ≤ 2R`
  have hR0 : 0 ≤ R := (abs_nonneg t).trans (hnorm t ht)
  have hvol : (volume {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}).toReal ≤ 2 * R := by
    refine ENNReal.toReal_le_of_le_ofReal (by linarith) ?_
    calc volume {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}
        ≤ volume (Icc (-R) R) := measure_mono fun s hs => abs_le.1 (hnorm s hs)
      _ = ENNReal.ofReal (2 * R) := by rw [Real.volume_Icc]; ring_nf
  -- `y − y[j ↦ t] = (y_j − t) e_j`
  have hdiff : ‖y - WithLp.toLp 2 (Function.update y.ofLp j t)‖ = |y j - t| := by
    have : y - WithLp.toLp 2 (Function.update y.ofLp j t) = EuclideanSpace.single j (y j - t) := by
      ext i
      by_cases hi : i = j
      · subst hi
        simp
      · simp [hi]
    rw [this, PiLp.norm_single, Real.norm_eq_abs]
  have hz : ‖WithLp.toLp 2 (Function.update y.ofLp j t)‖ ≤ R := mem_closedBall_zero_iff.1 (hR ht)
  -- Step 6: `‖y‖ ≤ ‖y[j ↦ t]‖ + |y_j − t| ≤ R + |y_j| + |t| ≤ 3R`, using `|y_j| ≤ λ(y)/2 ≤ R`
  calc ‖y‖ = ‖WithLp.toLp 2 (Function.update y.ofLp j t) +
        (y - WithLp.toLp 2 (Function.update y.ofLp j t))‖ := by rw [add_sub_cancel]
    _ ≤ ‖WithLp.toLp 2 (Function.update y.ofLp j t)‖ +
        ‖y - WithLp.toLp 2 (Function.update y.ofLp j t)‖ := norm_add_le _ _
    _ ≤ R + (|y j| + |t|) := by
        rw [hdiff]
        gcongr
        exact abs_sub _ _
    _ ≤ 3 * R := by linarith [hnorm t ht]
/-- **Cavalieri's principle along a coordinate direction** (Simon Ch. 1, proof of 2.10: Steiner
symmetrization keeps Lebesgue measure "by Fubini").  If measurable `S, A ⊆ ℝᵈ` have line slices
`{t : y[j↦t] ∈ S}`, `{t : y[j↦t] ∈ A}` of equal `L¹`-measure through every `y`, then
`Lᵈ(S) = Lᵈ(A)`.  With `d = n + 1`, `φ(t, z) = Fin.insertNth j t z` is measure preserving from
`L¹ ⊗ Lⁿ` to `Lᵈ`; its fibre over `z` is the slice through `φ(0, z)`, and Tonelli
(`Measure.prod_apply_symm`) integrates the equal slice measures over `z`. -/
theorem Submission.cbr_ci_iso_svol_volume_eq_of_slice_volume_eq : ∀ (d : ℕ) (j : Fin d) (S A : Set (Euclid d)), MeasurableSet S → MeasurableSet A → (∀ y : Euclid d, volume {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ S} = volume {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}) → volume S = volume A := by
  intro d j S A hS hA hslice
  cases d with
  | zero => exact Fin.elim0 j
  | succ n =>
    -- `φ(t, z) = Fin.insertNth j t z`, measure preserving from `L¹ ⊗ Lⁿ` to `Lᵈ`
    let e := MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) j
    let φ : ℝ × (Fin n → ℝ) → Euclid (n + 1) := fun p => WithLp.toLp 2 (e.symm p)
    have hφ : MeasurePreserving φ volume volume :=
      (PiLp.volume_preserving_toLp (Fin (n + 1))).comp
        (MeasurePreserving.symm e (volume_preserving_piFinSuccAbove _ j))
    -- the fibre of `φ` over `z` is the coordinate slice through `φ(0, z)`
    have hfibre (B : Set (Euclid (n + 1))) (z : Fin n → ℝ) :
        (fun t => φ (t, z)) ⁻¹' B =
          {t : ℝ | WithLp.toLp 2 (Function.update (φ (0, z)).ofLp j t) ∈ B} := by
      ext t
      change WithLp.toLp 2 (j.insertNth t z) ∈ B ↔
        WithLp.toLp 2 (Function.update (j.insertNth 0 z) j t) ∈ B
      rw [Fin.update_insertNth]
    -- Tonelli: `Lᵈ(B) = (L¹ ⊗ Lⁿ)(φ⁻¹ B) = ∫⁻ z, L¹(fibre of φ⁻¹ B over z)`
    have hvol (B : Set (Euclid (n + 1))) (hB : MeasurableSet B) :
        volume B = ∫⁻ z : Fin n → ℝ, volume ((fun t => φ (t, z)) ⁻¹' B) :=
      (hφ.measure_preimage hB.nullMeasurableSet).symm.trans
        (Measure.prod_apply_symm (hB.preimage hφ.measurable))
    rw [hvol S hS, hvol A hA]
    refine lintegral_congr fun z => ?_
    rw [hfibre S z, hfibre A z]
    exact hslice (φ (0, z))
/-- Steiner symmetrization in direction `j` keeps the length of every line slice: for compact
`A ⊆ ℝᵈ` and `y ∈ ℝᵈ`, `L¹{t | y[j↦t] ∈ S_j(A)} = L¹(B)` with `B = {t | y[j↦t] ∈ A}`.  Each
point `y[j↦t]` of the line has `j`-th coordinate `t` and slice `B`, so the left set is
`{t | B ≠ ∅ ∧ |t| ≤ ℓ/2}`, `ℓ = L¹(B)`.  It is empty if `B = ∅` and `[-ℓ/2, ℓ/2]` otherwise, of
length `ℓ`, which is finite because `B` lies in the compact projection `π_j(A)`. -/
theorem Submission.cbr_ci_iso_svol_steiner_slice_volume_eq : ∀ (d : ℕ) (j : Fin d) (A : Set (Euclid d)), IsCompact A → ∀ y : Euclid d, volume {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ {x : Euclid d | {s : ℝ | WithLp.toLp 2 (Function.update x.ofLp j s) ∈ A}.Nonempty ∧ |x j| ≤ (volume {s : ℝ | WithLp.toLp 2 (Function.update x.ofLp j s) ∈ A}).toReal / 2}} = volume {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A} := by
  intro d j A hA y
  -- `B = A^j_y = {s | y[j↦s] ∈ A}`
  obtain ⟨B, hB⟩ : ∃ B : Set ℝ, {s : ℝ | WithLp.toLp 2 (update y.ofLp j s) ∈ A} = B :=
    ⟨_, rfl⟩
  -- steps 1–2: `(y[j↦t])_j = t` and `(y[j↦t])[j↦s] = y[j↦s]` (`WithLp.ofLp_toLp` is `rfl`), so
  -- `A^j_{y[j↦t]} = B` and the left set is `{t | B ≠ ∅ ∧ |t| ≤ ℓ/2}`, `ℓ = (L¹ B).toReal`
  simp only [mem_ofPred_eq, update_idem, update_self, hB]
  -- step 3: `B ⊆ π_j(A)`, which is compact, so `L¹(B) < ∞`
  have hBfin : volume B ≠ ∞ := by
    have hπ : IsCompact ((fun x : Euclid d => x j) '' A) := hA.image (PiLp.continuous_apply 2 _ j)
    refine (measure_lt_top_of_subset ?_ hπ.measure_lt_top.ne).ne
    rintro s hs
    rw [← hB] at hs
    exact ⟨_, hs, update_self j s y.ofLp⟩
  rcases B.eq_empty_or_nonempty with rfl | hBne
  -- step 4: if `B = ∅`, the left set is empty
  · simp only [Set.not_nonempty_empty, false_and, ofPred_false]
  -- step 5: otherwise it is `[-ℓ/2, ℓ/2]`, of measure `ofReal ℓ = L¹(B)`
  · have hIcc : {t : ℝ | B.Nonempty ∧ |t| ≤ (volume B).toReal / 2} =
        Icc (-((volume B).toReal / 2)) ((volume B).toReal / 2) := by
      ext t
      rw [mem_ofPred_eq, mem_Icc, ← abs_le, and_iff_right hBne]
    rw [hIcc, Real.volume_Icc, sub_neg_eq_add, add_halves, ENNReal.ofReal_toReal hBfin]

/-- **Simon Ch. 1, proof of 2.10 (p. 12): Steiner symmetrization preserves Lebesgue measure.**
Let `A ⊆ ℝ^d` be compact, `j ∈ Fin d`, `A^j_y = {t : y[j↦t] ∈ A}`.  If the Steiner symmetral
`S_j(A) = {y : A^j_y ≠ ∅, |y_j| ≤ ½ L¹(A^j_y)}` is measurable, then `L^d(S_j(A)) = L^d(A)`, "by
Fubini": each line in direction `e_j` meets `S_j(A)` in `∅` or a centred segment of length
`L¹(A^j_y)`, hence in a set of the same `L¹`-measure as its trace on the measurable set `A`, and
Cavalieri's principle along `e_j` compares the volumes. -/
theorem Submission.cbr_ci_iso_steiner_volume_eq : ∀ (d : ℕ) (j : Fin d) (A : Set (Euclid d)), IsCompact A → MeasurableSet {y : Euclid d | {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}.Nonempty ∧ |y j| ≤ (volume {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}).toReal / 2} → volume {y : Euclid d | {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}.Nonempty ∧ |y j| ≤ (volume {t : ℝ | WithLp.toLp 2 (Function.update y.ofLp j t) ∈ A}).toReal / 2} = volume A := by
  intro d j A hA hS
  exact Submission.cbr_ci_iso_svol_volume_eq_of_slice_volume_eq d j _ A hS hA.measurableSet
    (Submission.cbr_ci_iso_svol_steiner_slice_volume_eq d j A hA)
/-- Iterated coordinate Steiner symmetrization (Simon, Ch. 1, proof of 2.10): every compact
`A ⊆ ℝ^d` has a compact replacement `K` with `L^d(K) = L^d(A)`, `ediam K ≤ ediam A` and `-x ∈ K`
for all `x ∈ K`.  Write `y[i↦t]` for `y` with `i`-th coordinate replaced by `t`,
`R_k(y) = y[k↦-y_k]`, `B^i_y = {t : y[i↦t] ∈ B}`, `S_i(B) = {y : B^i_y ≠ ∅, |y_i| ≤ L¹(B^i_y)/2}`.
By induction over finite `F ⊆ Fin d` there is a compact `K_F` with the measure of `A`, diameter at
most `ediam A` and `R_k(K_F) ⊆ K_F` for `k ∈ F`: for `i ∉ F`, `S_i(K_F)` is compact, has the same
measure and no larger diameter (sibling lemmas), is `R_i`-invariant since `R_i(y)[i↦t] = y[i↦t]`,
and stays `R_k`-invariant for `k ∈ F` since `R_k(y)[i↦t] = R_k(y[i↦t])` and `R_k` is an involution.
For `K = K_{Fin d}`, flipping the coordinates of `x ∈ K` one at a time shows `-x ∈ K`. -/
theorem Submission.cbr_ci_iso_exists_symmetric_replacement : ∀ (d : ℕ) (A : Set (Euclid d)), IsCompact A → ∃ K : Set (Euclid d), IsCompact K ∧ volume K = volume A ∧ ediam K ≤ ediam A ∧ ∀ x ∈ K, -x ∈ K := by
  intro d A hA
  -- Step 1: for every finite set `F` of coordinates there is a compact `K_F` with the measure of
  -- `A`, diameter at most `ediam A`, and invariant under `R_k` for every `k ∈ F`
  have hF : ∀ F : Finset (Fin d), ∃ K : Set (Euclid d), IsCompact K ∧ volume K = volume A ∧
      ediam K ≤ ediam A ∧
      ∀ k ∈ F, ∀ x ∈ K, WithLp.toLp 2 (Function.update x.ofLp k (-x k)) ∈ K := by
    intro F
    induction F using Finset.induction_on with
    | empty => exact ⟨A, hA, rfl, le_rfl, by simp⟩
    | insert i F hi ih =>
      -- replace `K' = K_F` by its Steiner symmetrization `S_i(K')` in the new direction `i`
      obtain ⟨K', hK', hvol', hdiam', hsym'⟩ := ih
      have hS := Submission.cbr_ci_iso_steiner_isCompact d i K' hK'
        (Submission.cbr_ci_iso_slice_length_usc d i K' hK')
      refine ⟨_, hS,
        (Submission.cbr_ci_iso_steiner_volume_eq d i K' hK' hS.measurableSet).trans hvol',
        (Submission.cbr_ci_iso_steiner_ediam_le d i K' hK').trans hdiam', fun k hk x hx => ?_⟩
      rcases Finset.mem_insert.1 hk with rfl | hkF
      · -- `R_k(x)[k↦t] = x[k↦t]`, so the `k`-slice is unchanged, and `|(R_k x)_k| = |x_k|`
        simpa using hx
      · -- `k ≠ i`: `R_k` is an involution preserving `K'` with `R_k(x)[i↦t] = R_k(x[i↦t])`, so
        -- `x` and `R_k(x)` have the same `i`-slice of `K'`, and `(R_k x)_i = x_i`
        have hki : k ≠ i := by
          rintro rfl
          exact hi hkF
        have hR := hsym' k hkF
        have hinv : ∀ z : Euclid d, WithLp.toLp 2 (Function.update
            (WithLp.toLp 2 (Function.update z.ofLp k (-z k))).ofLp k
            (-(WithLp.toLp 2 (Function.update z.ofLp k (-z k))) k)) = z := by
          intro z
          ext m
          by_cases hm : m = k
          · subst hm
            simp
          · simp [hm]
        have hcomm : ∀ t : ℝ,
            WithLp.toLp 2 (Function.update (Function.update x.ofLp k (-x k)) i t) =
              WithLp.toLp 2 (Function.update (WithLp.toLp 2 (Function.update x.ofLp i t)).ofLp k
                (-(WithLp.toLp 2 (Function.update x.ofLp i t)) k)) := by
          intro t
          simp only [Function.update_of_ne hki]
          rw [Function.update_comm hki]
        have hslice : {t : ℝ | WithLp.toLp 2 (Function.update
            (WithLp.toLp 2 (Function.update x.ofLp k (-x k))).ofLp i t) ∈ K'} =
            {t : ℝ | WithLp.toLp 2 (Function.update x.ofLp i t) ∈ K'} := by
          ext t
          simp only [Set.mem_ofPred_eq]
          rw [hcomm t]
          constructor
          · intro h
            have h' := hR _ h
            rwa [hinv] at h'
          · exact hR _
        have hxi : (WithLp.toLp 2 (Function.update x.ofLp k (-x k))) i = x i := by
          simp [hki.symm]
        show _ ∧ _
        rw [hslice, hxi]
        exact hx
  -- Step 4: `K = K_{Fin d}` is invariant under every coordinate reflection
  obtain ⟨K, hK, hvol, hdiam, hsym⟩ := hF Finset.univ
  refine ⟨K, hK, hvol, hdiam, fun x hx => ?_⟩
  -- Step 5: `x^G ∈ K` for every finite `G`, where `x^G` flips the coordinates of `x` in `G`
  have hG : ∀ G : Finset (Fin d), WithLp.toLp 2 (fun k => if k ∈ G then -x k else x k) ∈ K := by
    intro G
    induction G using Finset.induction_on with
    | empty => simpa using hx
    | insert i G hi ih =>
      -- `x^{insert i G} = R_i(x^G)` because `i ∉ G`
      convert hsym i (Finset.mem_univ i) _ ih using 1
      ext k
      by_cases hk : k = i
      · subst hk
        simp [hi]
      · simp [hk]
  -- `x^{Fin d} = -x`
  convert hG Finset.univ using 1
  ext k
  simp

/-- **Simon 2.10** (isodiametric inequality, Ch. 1, p. 11): `Lᵈ(A) ≤ ω_d (diam A / 2)ᵈ` for every
`A ⊆ ℝᵈ`.  If `ediam A = ∞` then `d ≠ 0` (subsets of `ℝ⁰` are subsingletons) and the right side is
`ω_d · ∞ = ∞`, as `ω_d > 0`.  Otherwise the closure `Ā` is compact, `ediam Ā = ediam A` and
`Lᵈ(A) ≤ Lᵈ(Ā)`; a centrally symmetric compact `K` with `Lᵈ(K) = Lᵈ(Ā)` and `ediam K ≤ ediam Ā`
satisfies the bound, and the bound is monotone in the diameter. -/
theorem Submission.cbr_ci_iso_volume_le_ediam_pow : ∀ (d : ℕ) (A : Set (Euclid d)), volume A ≤ unitBallVolume d * (ediam A / 2) ^ d := by
  intro d A
  by_cases hA : ediam A = ⊤
  · -- unbounded `A`: then `d ≠ 0`, and the right side is `ω_d · ∞ = ∞`
    have hd : d ≠ 0 := by
      rintro rfl
      exact ENNReal.zero_ne_top ((ediam_subsingleton Set.subsingleton_of_subsingleton).symm.trans hA)
    have hω : unitBallVolume d ≠ 0 := (measure_ball_pos volume (0 : Euclid d) one_pos).ne'
    have h2 : ediam A / 2 = ⊤ := by
      rw [hA]
      exact ENNReal.top_div_of_ne_top ENNReal.ofNat_ne_top
    rw [h2, ENNReal.top_pow hd, ENNReal.mul_top hω]
    exact le_top
  · -- bounded `A`: pass to the compact closure, then to a centrally symmetric replacement
    have hc : IsCompact (closure A) := (isBounded_iff_ediam_ne_top.2 hA).isCompact_closure
    obtain ⟨K, -, hKA, hKd, hKs⟩ :=
      Submission.cbr_ci_iso_exists_symmetric_replacement d (closure A) hc
    rw [ediam_closure] at hKd
    calc volume A ≤ volume (closure A) := measure_mono subset_closure
      _ = volume K := hKA.symm
      _ ≤ unitBallVolume d * (ediam K / 2) ^ d := Submission.cbr_ci_iso_volume_le_of_neg_mem d K hKs
      _ ≤ unitBallVolume d * (ediam A / 2) ^ d := by gcongr

/-- Lebesgue measure on `ℝ^d` is at most `(ω_d / 2^d) • μH[d]` (Simon Ch. 1, "Completion of the
proof of 2.9", pp. 12–13, in Mathlib's unnormalised `μH[d]`, whose weight is `diam^d`).  Put
`c = ω_d / 2^d`; `c ≠ 0, ∞` since `0 < ω_d < ∞`.  The isodiametric inequality
`L^d(s) ≤ ω_d (diam s / 2)^d = c · diam(s)^d` gives `c⁻¹ L^d(s) ≤ diam(s)^d` for every `s`, so
`c⁻¹ • L^d ≤ μH[d]` (`Measure.le_hausdorffMeasure`: cover by sets `C_k` of small diameter,
`c⁻¹ L^d(B) ≤ Σ c⁻¹ L^d(C_k) ≤ Σ diam(C_k)^d`).  Multiplying back by `c` gives
`L^d ≤ c • μH[d]` setwise. -/
theorem Submission.cbr_ci_iso_volume_le_smul_hausdorff : ∀ (d : ℕ), (volume : Measure (Euclid d)) ≤ (unitBallVolume d / 2 ^ d) • (μH[(d : ℝ)] : Measure (Euclid d)) := by
  intro d
  -- Step 1: `c = ω_d / 2^d` is neither `0` nor `∞`
  set c : ℝ≥0∞ := unitBallVolume d / 2 ^ d with hc
  have hω0 : unitBallVolume d ≠ 0 :=
    (Metric.measure_ball_pos volume (0 : Euclid d) one_pos).ne'
  have hωtop : unitBallVolume d ≠ ∞ := measure_ball_lt_top.ne
  have hc0 : c ≠ 0 := ENNReal.div_ne_zero.2 ⟨hω0, ENNReal.pow_ne_top ENNReal.ofNat_ne_top⟩
  have hctop : c ≠ ∞ := ENNReal.div_ne_top hωtop (pow_ne_zero d two_ne_zero)
  -- Step 2: the isodiametric inequality gives `c⁻¹ L^d(s) ≤ diam(s)^d` for every `s`
  have hdiam : ∀ s : Set (Euclid d), c⁻¹ * volume s ≤ ediam s ^ d := by
    intro s
    have hiso : volume s ≤ c * ediam s ^ d :=
      calc volume s ≤ unitBallVolume d * (ediam s / 2) ^ d :=
            Submission.cbr_ci_iso_volume_le_ediam_pow d s
        _ = c * ediam s ^ d := by
            rw [hc, div_eq_mul_inv, div_eq_mul_inv, mul_pow, ENNReal.inv_pow]
            ring
    calc c⁻¹ * volume s ≤ c⁻¹ * (c * ediam s ^ d) := by gcongr
      _ = ediam s ^ d := by rw [← mul_assoc, ENNReal.inv_mul_cancel hc0 hctop, one_mul]
  -- Step 3: `ν = c⁻¹ • L^d ≤ μH[d]`; the bound is needed only for sets of diameter `≤ 1`
  have hν : c⁻¹ • (volume : Measure (Euclid d)) ≤ μH[(d : ℝ)] := by
    refine Measure.le_hausdorffMeasure (d : ℝ) _ 1 one_pos fun s _ => ?_
    rw [Measure.smul_apply, smul_eq_mul, ENNReal.rpow_natCast]
    exact hdiam s
  -- Step 4: `L^d(s) = c · ν(s) ≤ c · μH[d](s)` for every set `s`
  refine Measure.le_iff'.2 fun s => ?_
  rw [Measure.smul_apply, smul_eq_mul]
  calc volume s = c * (c⁻¹ * volume s) := by
        rw [← mul_assoc, ENNReal.mul_inv_cancel hc0 hctop, one_mul]
    _ ≤ c * μH[(d : ℝ)] s := by
        gcongr
        simpa only [Measure.smul_apply, smul_eq_mul] using Measure.le_iff'.1 hν s

/-- `Hⁿ = μHE[n]` is dominated by Simon's normalisation `ωₙ (diam/2)ⁿ` (Simon, Ch. 1, 2.1–2.2 and
the completion of the proof of 2.9): `μHE[n] ≤ (ωₙ/2ⁿ) • μH[n]` on every `ℝᴾ`.  By definition
`μHE[n] = c • μH[n]` with `c = addHaarScalarFactor volume μH[n]` on `ℝⁿ`, so `volume = c • μH[n]`
on `ℝⁿ`.  On the unit cube `K` of `ℝⁿ`, `volume K = 1` gives `c · μH[n](K) = 1`, which forces
`0 < μH[n](K) < ∞`; with `volume K ≤ (ωₙ/2ⁿ) μH[n](K)` (isodiametric inequality) this gives
`c ≤ ωₙ/2ⁿ`, whence `μHE[n](s) = c · μH[n](s) ≤ (ωₙ/2ⁿ) μH[n](s)` for every `s ⊆ ℝᴾ`. -/
theorem Submission.cbr_ci_euclideanHausdorff_le_isodiametric : ∀ (P n : ℕ), (μHE[n] : Measure (Euclid P)) ≤ (unitBallVolume n / 2 ^ n) • (μH[(n : ℝ)] : Measure (Euclid P)) := by
  intro P n
  -- `c` is the constant with `μHE[n] = c • μH[n]` on every space, so `volume = c • μH[n]` on `ℝⁿ`
  obtain ⟨c, hc⟩ : ∃ c : NNReal,
      Measure.addHaarScalarFactor (volume : Measure (EuclideanSpace ℝ (Fin n))) μH[(n : ℝ)] = c :=
    ⟨_, rfl⟩
  have hvol : (volume : Measure (Euclid n)) = c • (μH[(n : ℝ)] : Measure (Euclid n)) := by
    rw [← EuclideanSpace.euclideanHausdorffMeasure_eq_volume, Measure.euclideanHausdorffMeasure_def,
      hc]
  -- `volume ≤ (ωₙ/2ⁿ) • μH[n]` on `ℝⁿ` (isodiametric inequality, completion of the proof of 2.9)
  have hiso : (volume : Measure (Euclid n)) ≤
      (unitBallVolume n / 2 ^ n) • (μH[(n : ℝ)] : Measure (Euclid n)) :=
    Submission.cbr_ci_iso_volume_le_smul_hausdorff n
  -- the unit cube `K` of `ℝⁿ` has `volume K = 1`, so `c · μH[n](K) = 1` and `0 < μH[n](K) < ∞`
  set K : Set (Euclid n) := parallelepiped (stdOrthonormalBasis ℝ (Euclid n))
  have hK : (c : ℝ≥0∞) * μH[(n : ℝ)] K = 1 := by
    rw [← Measure.coe_nnreal_smul_apply, ← hvol]
    exact (stdOrthonormalBasis ℝ (Euclid n)).volume_parallelepiped
  have hc0 : (c : ℝ≥0∞) ≠ 0 := by
    intro h
    rw [h, zero_mul] at hK
    exact zero_ne_one hK
  have hK0 : μH[(n : ℝ)] K ≠ 0 := by
    intro h
    rw [h, mul_zero] at hK
    exact zero_ne_one hK
  have hKtop : μH[(n : ℝ)] K ≠ ∞ := by
    intro h
    rw [h, ENNReal.mul_top hc0] at hK
    exact ENNReal.top_ne_one hK
  -- hence `c ≤ ωₙ/2ⁿ`
  have hcle : (c : ℝ≥0∞) ≤ unitBallVolume n / 2 ^ n := by
    have h := Measure.le_iff'.1 hiso K
    rw [hvol, Measure.coe_nnreal_smul_apply, Measure.smul_apply, smul_eq_mul] at h
    exact (ENNReal.mul_le_mul_iff_left hK0 hKtop).1 h
  -- conclusion on `ℝᴾ`: `μHE[n](s) = c · μH[n](s) ≤ (ωₙ/2ⁿ) · μH[n](s)`
  refine Measure.le_iff'.2 fun s => ?_
  rw [Measure.euclideanHausdorffMeasure_def, hc, Measure.coe_nnreal_smul_apply,
    Measure.smul_apply, smul_eq_mul]
  exact mul_le_mul_of_nonneg_right hcle zero_le

/-- **Almost every point of `M` is good** (Simon Ch. 1, 3.26(1), and Lebesgue points of `θζ` by
Besicovitch differentiation).  Let `M ⊆ ℝᴾ` be Borel with `Hⁿ(M) < ∞`, `θ` Borel with `θ > 0` on
`M` and `∫_M θ dHⁿ < ∞`, and `ζ` strongly measurable with `|⟨α, ζ(x)⟩| ≤ |α|`.  Then for
`Hⁿ`-a.e. `a ∈ M`: (i) `limsup_{r↓0} Hⁿ(M ∩ B̄_r(a)) / (ωₙrⁿ) ≤ 1`, and (ii)
`(ωₙrⁿ)⁻¹ ∫_{M ∩ B̄_r(a)} ‖θ(x)ζ(x) − θ(a)ζ(a)‖ dHⁿ(x) → 0` as `r ↓ 0`.  Vitali's covering lemma
with the finite-tail argument and the isodiametric normalisation `Hⁿ ≤ (ωₙ/2ⁿ) μH[n]` give the
sharp density comparison `t Hⁿ(A) ≤ μ(ℝᴾ)` (Simon 3.3, 3.5); outer regularity of `Hⁿ⌞M` turns it
into (i).  The field `τ = θζ` is bounded by a multiple of `θ`, hence in `L¹(Hⁿ⌞M)`, and Besicovitch
differentiation for closed balls makes its Lebesgue error, normalised by `Hⁿ(M ∩ B̄_r(a))`, tend to
`0`; by (i) the same holds with the normalisation `ωₙrⁿ`, which is (ii). -/
theorem Submission.dtc_bc_tc_cl_ci_ae_good_points : ∀ (P n : ℕ) (M : Set (Euclid P)) (θ : Euclid P → ℝ) (ζ : Euclid P → MultiVector P n), MeasurableSet M → μHE[n] M < ∞ → Measurable θ → StronglyMeasurable ζ → (∀ x ∈ M, 0 < θ x) → ∫⁻ x in M, ENNReal.ofReal (θ x) ∂μHE[n] < ∞ → (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ζ x α| ≤ covectorEuclideanNorm α) → ∀ᵐ a ∂(μHE[n].restrict M), limsup (fun r : ℝ => μHE[n] (M ∩ closedBall a r) / (unitBallVolume n * ENNReal.ofReal (r ^ n))) (𝓝[>] 0) ≤ 1 ∧ Tendsto (fun r : ℝ => (∫⁻ x in M ∩ closedBall a r, ‖θ x • ζ x - θ a • ζ a‖ₑ ∂μHE[n]) / (unitBallVolume n * ENNReal.ofReal (r ^ n))) (𝓝[>] 0) (𝓝 0) := by
  -- Step 3 (density comparison; Simon Ch. 1, 3.3 with the finite tail 3.5): under the
  -- isodiametric normalisation `Hⁿ ≤ (ωₙ/2ⁿ) μH[n]`, if `0 < t < limsup_{r↓0} μ(B̄_r(x))/(ωₙrⁿ)`
  -- at every `x ∈ A`, then `t Hⁿ(A) ≤ μ(ℝᴾ)`
  have gp_density_comparison : ∀ (P n : ℕ) (μ : Measure (Euclid P)) (A : Set (Euclid P)) (t : ℝ≥0∞), (μHE[n] : Measure (Euclid P)) ≤ (unitBallVolume n / 2 ^ n) • (μH[(n : ℝ)] : Measure (Euclid P)) → 0 < t → (∀ x ∈ A, t < limsup (fun r : ℝ => μ (closedBall x r) / (unitBallVolume n * ENNReal.ofReal (r ^ n))) (𝓝[>] 0)) → t * μHE[n] A ≤ μ univ := by
    intro P n μ A t hIB ht hA
    -- Step 1: trivial cases
    rcases eq_or_ne (μ univ) ∞ with hμ | hμ
    · rw [hμ]; exact le_top
    rcases A.eq_empty_or_nonempty with hAe | ⟨x₀, hx₀⟩
    · simp [hAe]
    have htop : t ≠ ∞ := ne_top_of_lt (hA x₀ hx₀)
    have hω0 : unitBallVolume n ≠ 0 := (measure_ball_pos _ _ one_pos).ne'
    have hωtop : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
    set ω := unitBallVolume n with hωdef
    have htω0 : t * ω ≠ 0 := mul_ne_zero ht.ne' hω0
    have htωtop : t * ω ≠ ∞ := ENNReal.mul_ne_top htop hωtop
    -- Step 2: fineness
    have hfine : ∀ x ∈ A, ∀ η : ℝ, 0 < η → ∃ ρ : ℝ, 0 < ρ ∧ ρ < η ∧
        t * ω * ENNReal.ofReal ρ ^ n < μ (closedBall x ρ) := by
      intro x hx η hη
      have hfreq : ∃ᶠ r in 𝓝[>] (0:ℝ), t < μ (closedBall x r) / (ω * ENNReal.ofReal (r ^ n)) :=
        frequently_lt_of_lt_limsup (by isBoundedDefault) (hA x hx)
      obtain ⟨ρ, hρ, hρη⟩ := (hfreq.and_eventually (Ioo_mem_nhdsGT hη)).exists
      refine ⟨ρ, hρη.1, hρη.2, ?_⟩
      have hw0 : ω * ENNReal.ofReal (ρ ^ n) ≠ 0 :=
        mul_ne_zero hω0 (ENNReal.ofReal_pos.2 (pow_pos hρη.1 n)).ne'
      have hwtop : ω * ENNReal.ofReal (ρ ^ n) ≠ ∞ := ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top
      rw [ENNReal.lt_div_iff_mul_lt (Or.inl hw0) (Or.inl hwtop)] at hρ
      rw [← ENNReal.ofReal_pow hρη.1.le, mul_assoc]
      exact hρ
    -- Steps 3–8: for every scale δ and slack ε a cheap countable cover of A
    set D : ℝ≥0∞ := 2 ^ n * (μ univ / (t * ω)) with hD
    have hcover : ∀ δ : ℝ, 0 < δ → ∀ ε : ℝ≥0∞, ε ≠ 0 →
        ∃ u : Set (Euclid P × ℝ), u.Countable ∧ ∃ c : u → Set (Euclid P),
          (∀ b, ediam (c b) ≤ ENNReal.ofReal (5 * δ)) ∧ A ⊆ ⋃ b, c b ∧
          ∑' b, ediam (c b) ^ (n : ℝ) ≤ D + ε := by
      intro δ hδ ε hε
      set T : Set (Euclid P × ℝ) := {p | p.1 ∈ A ∧ 0 < p.2 ∧ p.2 < δ / 2 ∧
        t * ω * ENNReal.ofReal p.2 ^ n < μ (closedBall p.1 p.2)} with hT
      -- Step 3: Vitali selection with the intersection-and-radius property
      obtain ⟨u, huT, hdisj, hmeet⟩ := Vitali.exists_disjoint_subfamily_covering_enlargement
        (fun p : Euclid P × ℝ => closedBall p.1 p.2) T (fun p => p.2) 2 one_lt_two
        (fun p hp => hp.2.1.le) (δ / 2) (fun p hp => hp.2.2.1.le)
        (fun p hp => nonempty_closedBall.2 hp.2.1.le)
      -- Step 5: countability
      have hucount : u.Countable := by
        apply hdisj.countable_of_nonempty_interior
        intro p hp
        refine ⟨p.1, interior_mono ball_subset_closedBall ?_⟩
        rw [isOpen_ball.interior_eq]
        exact mem_ball_self (huT hp).2.1
      have : Countable u := hucount.to_subtype
      refine ⟨u, hucount, ?_⟩
      -- Step 6: packing
      set s : u → ℝ≥0∞ := fun b => ENNReal.ofReal (b : Euclid P × ℝ).2 ^ n with hs
      have hpack : t * ω * ∑' b, s b ≤ μ univ := by
        rw [← ENNReal.tsum_mul_left]
        calc ∑' b : u, t * ω * s b
            ≤ ∑' b : u, μ (closedBall (b : Euclid P × ℝ).1 (b : Euclid P × ℝ).2) :=
              ENNReal.tsum_le_tsum fun b => (huT b.2).2.2.2.le
          _ = μ (⋃ b ∈ u, closedBall b.1 b.2) :=
              (measure_biUnion hucount hdisj fun b _ => measurableSet_closedBall).symm
          _ ≤ μ univ := measure_mono (subset_univ _)
      have hS : ∑' b, s b ≤ μ univ / (t * ω) := by
        rw [ENNReal.le_div_iff_mul_le (Or.inl htω0) (Or.inl htωtop), mul_comm]; exact hpack
      have hSfin : ∑' b, s b ≠ ∞ := ne_top_of_le_ne_top (ENNReal.div_ne_top hμ htω0) hS
      -- Step 8 (tail): a finite subfamily whose complement has small total cost
      have htail := ENNReal.tendsto_tsum_compl_atTop_zero hSfin
      have h10top : (10 : ℝ≥0∞) ^ n ≠ ∞ := ENNReal.pow_ne_top (by norm_num)
      have h10ne : (10 : ℝ≥0∞) ^ n ≠ 0 := pow_ne_zero _ (by norm_num)
      obtain ⟨F, hF⟩ := (htail.eventually (gt_mem_nhds (ENNReal.div_pos hε h10top))).exists
      classical
      refine ⟨fun b => if b ∈ F then closedBall (b : Euclid P × ℝ).1 (b : Euclid P × ℝ).2
        else closedBall (b : Euclid P × ℝ).1 (5 * (b : Euclid P × ℝ).2), ?_, ?_, ?_⟩
      · -- diameters
        intro b
        have hb := huT b.2
        have hρ0 : 0 < (b : Euclid P × ℝ).2 := hb.2.1
        have hρδ : (b : Euclid P × ℝ).2 < δ / 2 := hb.2.2.1
        dsimp only
        split_ifs
        · refine ediam_le_of_forall_dist_le fun y hy z hz => ?_
          rw [mem_closedBall] at hy hz
          linarith [dist_triangle_right y z (b : Euclid P × ℝ).1]
        · refine ediam_le_of_forall_dist_le fun y hy z hz => ?_
          rw [mem_closedBall] at hy hz
          linarith [dist_triangle_right y z (b : Euclid P × ℝ).1]
      · -- Step 7 (Simon 3.5): the tail enlargements cover what the finite part misses
        intro x hx
        by_cases hxK : x ∈ ⋃ b ∈ F, closedBall (b : Euclid P × ℝ).1 (b : Euclid P × ℝ).2
        · obtain ⟨b, hbF, hxb⟩ := mem_iUnion₂.1 hxK
          exact mem_iUnion.2 ⟨b, by simp only [hbF, ite_true]; exact hxb⟩
        · have hKc : IsClosed (⋃ b ∈ F, closedBall (b : Euclid P × ℝ).1 (b : Euclid P × ℝ).2) :=
            isClosed_biUnion_finset fun b _ => isClosed_closedBall
          obtain ⟨η, hη, hηball⟩ := Metric.isOpen_iff.1 hKc.isOpen_compl x hxK
          obtain ⟨ρ, hρ0, hρη, hρμ⟩ := hfine x hx (min (η / 2) (δ / 2)) (by positivity)
          have haT : (x, ρ) ∈ T := ⟨hx, hρ0, lt_of_lt_of_le hρη (min_le_right _ _), hρμ⟩
          obtain ⟨b, hbu, ⟨z, hz1, hz2⟩, hle⟩ := hmeet (x, ρ) haT
          have hzx : dist z x ≤ ρ := hz1
          have hzb : dist z b.1 ≤ b.2 := hz2
          have hle' : ρ ≤ 2 * b.2 := hle
          have hbF : (⟨b, hbu⟩ : u) ∉ F := by
            intro hbF
            have hzK : z ∈ ⋃ b ∈ F, closedBall (b : Euclid P × ℝ).1 (b : Euclid P × ℝ).2 :=
              mem_biUnion hbF hz2
            have hzball : z ∈ ball x η := by
              rw [mem_ball]
              have : ρ < η / 2 := lt_of_lt_of_le hρη (min_le_left _ _)
              linarith
            exact hηball hzball hzK
          refine mem_iUnion.2 ⟨⟨b, hbu⟩, ?_⟩
          simp only [hbF, ite_false]
          rw [mem_closedBall]
          have hb0 : 0 < b.2 := (huT hbu).2.1
          calc dist x b.1 ≤ dist x z + dist z b.1 := dist_triangle _ _ _
            _ ≤ ρ + b.2 := by rw [dist_comm] at hzx; linarith
            _ ≤ 5 * b.2 := by linarith
      · -- Step 8: the cost of the cover
        have hterm : ∀ b : u, ediam (if b ∈ F then closedBall (b : Euclid P × ℝ).1 (b : Euclid P × ℝ).2
            else closedBall (b : Euclid P × ℝ).1 (5 * (b : Euclid P × ℝ).2)) ^ (n : ℝ)
            ≤ 2 ^ n * s b + {b : u | b ∉ F}.indicator (fun b => 10 ^ n * s b) b := by
          intro b
          have hb0 : 0 < (b : Euclid P × ℝ).2 := (huT b.2).2.1
          rw [ENNReal.rpow_natCast]
          split_ifs with hbF
          · have hd : ediam (closedBall (b : Euclid P × ℝ).1 (b : Euclid P × ℝ).2)
                ≤ 2 * ENNReal.ofReal (b : Euclid P × ℝ).2 := by
              calc _ ≤ ENNReal.ofReal (2 * (b : Euclid P × ℝ).2) :=
                    ediam_le_of_forall_dist_le fun y hy z hz => by
                      rw [mem_closedBall] at hy hz
                      linarith [dist_triangle_right y z (b : Euclid P × ℝ).1]
                _ = 2 * ENNReal.ofReal (b : Euclid P × ℝ).2 := by
                    rw [ENNReal.ofReal_mul (by norm_num)]; norm_num
            calc _ ≤ (2 * ENNReal.ofReal (b : Euclid P × ℝ).2) ^ n := by gcongr
              _ = 2 ^ n * s b := by rw [mul_pow]
              _ ≤ _ := le_self_add
          · have hd : ediam (closedBall (b : Euclid P × ℝ).1 (5 * (b : Euclid P × ℝ).2))
                ≤ 10 * ENNReal.ofReal (b : Euclid P × ℝ).2 := by
              calc _ ≤ ENNReal.ofReal (10 * (b : Euclid P × ℝ).2) :=
                    ediam_le_of_forall_dist_le fun y hy z hz => by
                      rw [mem_closedBall] at hy hz
                      linarith [dist_triangle_right y z (b : Euclid P × ℝ).1]
                _ = 10 * ENNReal.ofReal (b : Euclid P × ℝ).2 := by
                    rw [ENNReal.ofReal_mul (by norm_num)]; norm_num
            have hind : {b : u | b ∉ F}.indicator (fun b => 10 ^ n * s b) b = 10 ^ n * s b :=
              indicator_of_mem (show b ∈ {b : u | b ∉ F} from hbF) _
            calc _ ≤ (10 * ENNReal.ofReal (b : Euclid P × ℝ).2) ^ n := by gcongr
              _ = 10 ^ n * s b := by rw [mul_pow]
              _ ≤ _ := by rw [hind]; exact le_add_self
        calc ∑' b, _ ≤ ∑' b : u, (2 ^ n * s b + {b : u | b ∉ F}.indicator (fun b => 10 ^ n * s b) b) :=
              ENNReal.tsum_le_tsum hterm
          _ = 2 ^ n * ∑' b, s b + 10 ^ n * ∑' b : {b : u // b ∉ F}, s b := by
              rw [ENNReal.tsum_add, ENNReal.tsum_mul_left, ← tsum_subtype {b : u | b ∉ F}
                (fun b => 10 ^ n * s b), ENNReal.tsum_mul_left]
              rfl
          _ ≤ D + ε := by
              refine add_le_add (by rw [hD]; exact mul_le_mul_right hS _) ?_
              calc 10 ^ n * ∑' b : {b : u // b ∉ F}, s b ≤ 10 ^ n * (ε / 10 ^ n) :=
                    mul_le_mul_right hF.le _
                _ = ε := ENNReal.mul_div_cancel h10ne h10top
    -- Step 9: the Hausdorff measure bound
    have hH : μH[(n : ℝ)] A ≤ D := by
      refine ENNReal.le_of_forall_pos_le_add fun ε hε _ => ?_
      have hε' : (ε : ℝ≥0∞) ≠ 0 := by simpa using hε.ne'
      have hk : ∀ k : ℕ, ∃ u : Set (Euclid P × ℝ), u.Countable ∧ ∃ c : u → Set (Euclid P),
          (∀ b, ediam (c b) ≤ ENNReal.ofReal (5 * (1 / ((k : ℝ) + 1)))) ∧ A ⊆ ⋃ b, c b ∧
          ∑' b, ediam (c b) ^ (n : ℝ) ≤ D + ε := fun k => hcover _ (by positivity) _ hε'
      choose u hu c hc1 hc2 hc3 using hk
      have : ∀ k, Countable (u k) := fun k => (hu k).to_subtype
      have hlim := Measure.hausdorffMeasure_le_liminf_tsum (X := Euclid P) (ι := fun k => u k)
        (n : ℝ) A (l := atTop) (fun k : ℕ => ENNReal.ofReal (5 * (1 / ((k : ℝ) + 1))))
        (by
          rw [show (0 : ℝ≥0∞) = ENNReal.ofReal (5 * 0) by simp]
          exact ENNReal.tendsto_ofReal (tendsto_one_div_add_atTop_nhds_zero_nat.const_mul 5))
        c (Eventually.of_forall hc1) (Eventually.of_forall hc2)
      exact hlim.trans (liminf_le_of_frequently_le' (Frequently.of_forall hc3))
    -- Step 10: the isodiametric normalisation
    have hle : μHE[n] A ≤ ω / 2 ^ n * μH[(n : ℝ)] A := by
      have := Measure.le_iff'.1 hIB A
      rwa [Measure.smul_apply, smul_eq_mul] at this
    have h2 : (2 : ℝ≥0∞) ^ n ≠ 0 := pow_ne_zero _ two_ne_zero
    have h2top : (2 : ℝ≥0∞) ^ n ≠ ∞ := ENNReal.pow_ne_top ENNReal.ofNat_ne_top
    calc t * μHE[n] A ≤ t * (ω / 2 ^ n * D) := by gcongr; exact hle.trans (by gcongr)
      _ = μ univ := by
        rw [hD, ← mul_assoc (ω / 2 ^ n), ENNReal.div_mul_cancel h2 h2top, ← mul_assoc,
          ENNReal.mul_div_cancel htω0 htωtop]
  -- Step 4 (upper density bound; Simon Ch. 1, 3.26(1)): for `Hⁿ⌞M`-a.e. `a`,
  -- `limsup_{r↓0} Hⁿ(M ∩ B̄_r(a))/(ωₙrⁿ) ≤ 1`
  have gp_upper_density_le_one : ∀ (P n : ℕ) (M : Set (Euclid P)), (μHE[n] : Measure (Euclid P)) ≤ (unitBallVolume n / 2 ^ n) • (μH[(n : ℝ)] : Measure (Euclid P)) → MeasurableSet M → μHE[n] M < ∞ → ∀ᵐ a ∂(μHE[n].restrict M), limsup (fun r : ℝ => μHE[n] (M ∩ closedBall a r) / (unitBallVolume n * ENNReal.ofReal (r ^ n))) (𝓝[>] 0) ≤ 1 := by
    intro P n M hIB hM hMfin
    set Θ : Euclid P → ℝ≥0∞ := fun x => limsup (fun r : ℝ => μHE[n] (M ∩ closedBall x r) /
      (unitBallVolume n * ENNReal.ofReal (r ^ n))) (𝓝[>] 0) with hΘ
    have : IsFiniteMeasure ((μHE[n] : Measure (Euclid P)).restrict M) :=
      isFiniteMeasure_restrict.2 hMfin.ne
    -- Step 2: each superlevel set `A_t`, `1 < t < ∞`, is null
    have key : ∀ t : ℝ≥0∞, 1 < t → t ≠ ∞ → μHE[n] {x | x ∈ M ∧ t < Θ x} = 0 := by
      intro t ht1 httop
      set A := {x | x ∈ M ∧ t < Θ x} with hAdef
      have hAM : A ⊆ M := fun x hx => hx.1
      have hAfin : μHE[n] A ≠ ∞ := (lt_of_le_of_lt (measure_mono hAM) hMfin).ne
      have hle : t * μHE[n] A ≤ μHE[n] A := by
        refine ENNReal.le_of_forall_pos_le_add fun ε hε _ => ?_
        have hlt : ((μHE[n] : Measure (Euclid P)).restrict M) A < μHE[n] A + ε := by
          rw [Measure.restrict_apply' hM, inter_eq_left.2 hAM]
          exact ENNReal.lt_add_right hAfin (by simpa using hε.ne')
        obtain ⟨U, hUA, hUo, hU⟩ := Set.exists_isOpen_lt_of_lt A _ hlt
        rw [Measure.restrict_apply hUo.measurableSet] at hU
        have h := gp_density_comparison P n ((μHE[n] : Measure (Euclid P)).restrict (M ∩ U)) A t hIB
          (zero_lt_one.trans ht1) (fun x hx => ?_)
        · rw [Measure.restrict_apply_univ, inter_comm] at h
          exact h.trans hU.le
        · obtain ⟨η, hη, hball⟩ := Metric.isOpen_iff.1 hUo x (hUA hx)
          have heq : (fun r : ℝ => ((μHE[n] : Measure (Euclid P)).restrict (M ∩ U)) (closedBall x r) /
                (unitBallVolume n * ENNReal.ofReal (r ^ n))) =ᶠ[𝓝[>] 0]
              (fun r : ℝ => μHE[n] (M ∩ closedBall x r) / (unitBallVolume n * ENNReal.ofReal (r ^ n))) := by
            have hsmall : ∀ᶠ r in 𝓝[>] (0 : ℝ), r < η :=
              nhdsWithin_le_nhds (gt_mem_nhds hη)
            filter_upwards [hsmall] with r hr
            rw [Measure.restrict_apply measurableSet_closedBall]
            have hsub : closedBall x r ⊆ U := (closedBall_subset_ball hr).trans hball
            congr 2
            ext y
            constructor
            · rintro ⟨hy, hyM, -⟩
              exact ⟨hyM, hy⟩
            · rintro ⟨hyM, hy⟩
              exact ⟨hy, hyM, hsub hy⟩
          rw [limsup_congr heq]
          exact hx.2
      by_contra hA0
      have : μHE[n] A * 1 < μHE[n] A * t := ENNReal.mul_lt_mul_right hA0 hAfin ht1
      rw [mul_one, mul_comm] at this
      exact absurd hle (not_le.2 this)
    -- Step 3: the exceptional set is a countable union of null sets
    have hcover : {x | x ∈ M ∧ 1 < Θ x} ⊆
        ⋃ k : ℕ, {x | x ∈ M ∧ 1 + ((k : ℝ≥0∞) + 1)⁻¹ < Θ x} := by
      intro x hx
      obtain ⟨k, hk⟩ := ENNReal.exists_inv_nat_lt (tsub_pos_of_lt hx.2).ne'
      refine mem_iUnion.2 ⟨k, hx.1, ?_⟩
      have h1 : ((k : ℝ≥0∞) + 1)⁻¹ < Θ x - 1 :=
        lt_of_le_of_lt (ENNReal.inv_le_inv.2 le_self_add) hk
      rw [add_comm]
      exact lt_tsub_iff_right.1 h1
    have hnull : μHE[n] {x | x ∈ M ∧ 1 < Θ x} = 0 := by
      refine measure_mono_null hcover (measure_iUnion_null fun k => key _ ?_ ?_)
      · exact ENNReal.lt_add_right ENNReal.one_ne_top (ENNReal.inv_ne_zero.2
          (ENNReal.add_ne_top.2 ⟨ENNReal.natCast_ne_top k, ENNReal.one_ne_top⟩))
      · exact ENNReal.add_ne_top.2 ⟨ENNReal.one_ne_top, ENNReal.inv_ne_top.2 (by simp)⟩
    -- Step 4: conclusion
    rw [ae_iff, Measure.restrict_apply' hM]
    refine measure_mono_null ?_ hnull
    intro x hx
    exact ⟨hx.2, not_le.1 hx.1⟩
  -- Steps 5–6 (Lebesgue points by Besicovitch differentiation): for `Hⁿ⌞M`-a.e. `a` at
  -- which `M` has finite upper density, the Lebesgue error of `τ` normalised by `ωₙrⁿ` tends to `0`
  have gp_lebesgue_error_tendsto : ∀ (P n : ℕ) (M : Set (Euclid P)) (τ : Euclid P → MultiVector P n), MeasurableSet M → μHE[n] M < ∞ → StronglyMeasurable τ → ∫⁻ x in M, ‖τ x‖ₑ ∂μHE[n] < ∞ → ∀ᵐ a ∂(μHE[n].restrict M), limsup (fun r : ℝ => μHE[n] (M ∩ closedBall a r) / (unitBallVolume n * ENNReal.ofReal (r ^ n))) (𝓝[>] 0) < ∞ → Tendsto (fun r : ℝ => (∫⁻ x in M ∩ closedBall a r, ‖τ x - τ a‖ₑ ∂μHE[n]) / (unitBallVolume n * ENNReal.ofReal (r ^ n))) (𝓝[>] 0) (𝓝 0) := by
    intro P n M τ hM hMfin hτ hfin
    have : IsFiniteMeasure ((μHE[n] : Measure (Euclid P)).restrict M) := isFiniteMeasure_restrict.2 hMfin.ne
    have hL := (Besicovitch.vitaliFamily ((μHE[n] : Measure (Euclid P)).restrict M)).ae_tendsto_lintegral_enorm_sub_div
      (E := MultiVector P n) (f := τ) (Integrable.locallyIntegrable ⟨hτ.aestronglyMeasurable, hfin⟩)
    filter_upwards [hL] with a ha hlim
    have hball := ha.comp (Besicovitch.tendsto_filterAt ((μHE[n] : Measure (Euclid P)).restrict M) a)
    -- rewrite the Besicovitch quotient in terms of `M ∩ closedBall a r`
    have hq : Tendsto (fun r : ℝ => (∫⁻ x in M ∩ closedBall a r, ‖τ x - τ a‖ₑ ∂μHE[n]) /
        μHE[n] (M ∩ closedBall a r)) (𝓝[>] 0) (𝓝 0) := by
      refine hball.congr fun r => ?_
      simp only [Function.comp_apply]
      rw [Measure.restrict_restrict measurableSet_closedBall,
        Measure.restrict_apply measurableSet_closedBall, inter_comm]
    -- the density quotient is eventually bounded by a finite constant
    obtain ⟨C, hC1, hC2⟩ := exists_between hlim
    have hev : ∀ᶠ r in 𝓝[>] (0 : ℝ),
        μHE[n] (M ∩ closedBall a r) / (unitBallVolume n * ENNReal.ofReal (r ^ n)) < C :=
      eventually_lt_of_limsup_lt hC1
    have hupper : ∀ᶠ r in 𝓝[>] (0 : ℝ),
        (∫⁻ x in M ∩ closedBall a r, ‖τ x - τ a‖ₑ ∂μHE[n]) / (unitBallVolume n * ENNReal.ofReal (r ^ n))
          ≤ C * ((∫⁻ x in M ∩ closedBall a r, ‖τ x - τ a‖ₑ ∂μHE[n]) / μHE[n] (M ∩ closedBall a r)) := by
      filter_upwards [hev] with r hr
      set I := ∫⁻ x in M ∩ closedBall a r, ‖τ x - τ a‖ₑ ∂μHE[n]
      set m := μHE[n] (M ∩ closedBall a r)
      set w := unitBallVolume n * ENNReal.ofReal (r ^ n)
      by_cases hm0 : m = 0
      · have hI : I = 0 := setLIntegral_measure_zero _ _ hm0
        simp [hI]
      · have hmtop : m ≠ ∞ := (lt_of_le_of_lt (measure_mono inter_subset_left) hMfin).ne
        have hIw : I / w = I / m * (m / w) := by
          rw [div_eq_mul_inv, div_eq_mul_inv, div_eq_mul_inv, mul_assoc, ← mul_assoc m⁻¹,
            ENNReal.inv_mul_cancel hm0 hmtop, one_mul]
        rw [hIw, mul_comm C]
        gcongr
    have hCq : Tendsto (fun r : ℝ => C * ((∫⁻ x in M ∩ closedBall a r, ‖τ x - τ a‖ₑ ∂μHE[n]) /
        μHE[n] (M ∩ closedBall a r))) (𝓝[>] 0) (𝓝 0) := by
      simpa using ENNReal.Tendsto.const_mul hq (Or.inr hC2.ne)
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hCq
      (Eventually.of_forall fun _ => zero_le) hupper
  -- Steps 1–2 (bounded field, integrability): `θζ` is strongly measurable and
  -- `∫_M ‖θζ‖ dμ < ∞`
  have gp_weighted_field_l1 : ∀ (P n : ℕ) (μ : Measure (Euclid P)) (M : Set (Euclid P)) (θ : Euclid P → ℝ) (ζ : Euclid P → MultiVector P n), MeasurableSet M → Measurable θ → StronglyMeasurable ζ → (∀ x ∈ M, 0 < θ x) → ∫⁻ x in M, ENNReal.ofReal (θ x) ∂μ < ∞ → (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ζ x α| ≤ covectorEuclideanNorm α) → StronglyMeasurable (fun x => θ x • ζ x) ∧ ∫⁻ x in M, ‖θ x • ζ x‖ₑ ∂μ < ∞ := by
    intro P n μ M θ ζ hM hθ hζ hpos hint hbound
    refine ⟨hθ.stronglyMeasurable.smul hζ, ?_⟩
    classical
    set C : ℝ := Real.sqrt ((Fintype.card (Fin n → Fin P) : ℝ)) with hC
    have hC0 : 0 ≤ C := Real.sqrt_nonneg _
    -- Step 1: the Euclidean coefficient norm is dominated by `C` times the operator norm
    have hcov : ∀ α : Covector (Euclid P) n, covectorEuclideanNorm α ≤ C * ‖α‖ := by
      intro α
      have hterm : ∀ I : Fin n → Fin P,
          (if StrictMono I then (α (fun i ↦ EuclideanSpace.basisFun (Fin P) ℝ (I i))) ^ 2 else 0)
            ≤ ‖α‖ ^ 2 := by
        intro I
        split_ifs
        · have h1 : ‖α (fun i ↦ EuclideanSpace.basisFun (Fin P) ℝ (I i))‖ ≤ ‖α‖ := by
            have := α.le_opNorm (fun i ↦ EuclideanSpace.basisFun (Fin P) ℝ (I i))
            simpa using this
          have h2 : |α (fun i ↦ EuclideanSpace.basisFun (Fin P) ℝ (I i))| ≤ ‖α‖ := by
            simpa [Real.norm_eq_abs] using h1
          nlinarith [abs_nonneg (α (fun i ↦ EuclideanSpace.basisFun (Fin P) ℝ (I i))),
            sq_abs (α (fun i ↦ EuclideanSpace.basisFun (Fin P) ℝ (I i)))]
        · positivity
      have hsum : (∑ I : Fin n → Fin P,
          if StrictMono I then (α (fun i ↦ EuclideanSpace.basisFun (Fin P) ℝ (I i))) ^ 2 else 0)
            ≤ (Fintype.card (Fin n → Fin P) : ℝ) * ‖α‖ ^ 2 := by
        calc _ ≤ ∑ _I : Fin n → Fin P, ‖α‖ ^ 2 := Finset.sum_le_sum fun I _ => hterm I
          _ = _ := by simp
      unfold covectorEuclideanNorm
      calc Real.sqrt _ ≤ Real.sqrt ((Fintype.card (Fin n → Fin P) : ℝ) * ‖α‖ ^ 2) :=
            Real.sqrt_le_sqrt hsum
        _ = C * ‖α‖ := by
            rw [Real.sqrt_mul (by positivity), Real.sqrt_sq (norm_nonneg _)]
    -- Step 2: `‖ζ x‖ ≤ C`
    have hζC : ∀ x, ‖ζ x‖ ≤ C := by
      intro x
      refine ContinuousLinearMap.opNorm_le_bound _ hC0 fun α => ?_
      rw [Real.norm_eq_abs]
      exact (hbound x α).trans (hcov α)
    -- Step 3: the lintegral bound
    calc ∫⁻ x in M, ‖θ x • ζ x‖ₑ ∂μ ≤ ∫⁻ x in M, ENNReal.ofReal C * ENNReal.ofReal (θ x) ∂μ := by
          refine setLIntegral_mono' hM fun x hx => ?_
          have hθx : 0 < θ x := hpos x hx
          have hn : ‖θ x • ζ x‖ ≤ C * θ x := by
            refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) fun α => ?_
            rw [FunLike.coe_smul, Pi.smul_apply, smul_eq_mul, Real.norm_eq_abs, abs_mul,
              abs_of_pos hθx]
            calc θ x * |ζ x α| ≤ θ x * (C * ‖α‖) := by
                  gcongr
                  exact (hbound x α).trans (hcov α)
              _ = C * θ x * ‖α‖ := by ring
          rw [← ofReal_norm, ← ENNReal.ofReal_mul hC0]
          exact ENNReal.ofReal_le_ofReal hn
      _ = ENNReal.ofReal C * ∫⁻ x in M, ENNReal.ofReal (θ x) ∂μ :=
          lintegral_const_mul _ hθ.ennreal_ofReal
      _ < ∞ := ENNReal.mul_lt_top ENNReal.ofReal_lt_top hint
  intro P n M θ ζ hM hMfin hθ hζ hpos hint hbound
  -- (i): upper density at most `1`, from the isodiametric normalisation `Hⁿ ≤ (ωₙ/2ⁿ) μH[n]`
  have h1 := gp_upper_density_le_one P n M
    (Submission.cbr_ci_euclideanHausdorff_le_isodiametric P n) hM hMfin
  -- `τ = θζ` is strongly measurable with `∫_M ‖τ‖ dHⁿ < ∞`
  obtain ⟨hτm, hτf⟩ := gp_weighted_field_l1 P n μHE[n] M θ ζ hM hθ hζ hpos hint hbound
  -- Lebesgue points of `τ`, normalised by `ωₙrⁿ` where the upper density of `M` is finite
  have h2 := gp_lebesgue_error_tendsto P n M (fun x => θ x • ζ x) hM hMfin hτm hτf
  -- (ii): where (i) holds the upper density is finite
  filter_upwards [h1, h2] with a ha1 ha2
  exact ⟨ha1, ha2 (ha1.trans_lt ENNReal.one_lt_top)⟩
/-- **The integer multiplicity current `c[[ℝⁿ]]`** (Simon 6.2.2, 6.2.34, 6.3.1 (‡)): for `c ∈ ℤ`
there is an integer multiplicity `C ∈ 𝒟ₙ(ℝⁿ)` with `C(ω) = c ∫ ⟨ω(y), e₁ ∧ ⋯ ∧ eₙ⟩ dLⁿ(y)`, where
`e` is the standard basis of `ℝⁿ`.

Take the triple `R` of `c[[ℝⁿ]]` (`R(ω) = c ∫ ω(y)(e) dLⁿ(y)`) and the current `C = τ(R)` it
defines.  Then `R` represents `C`, so `C` is integer multiplicity and `C(ω) = R(ω)`. -/
theorem Submission.dtc_bc_cz_unit_current : ∀ (n : ℕ) (c : ℤ), 0 < n → ∃ C : GeometricCurrentOn (univ : Set (Euclid n)) n, IsIntegerMultiplicity C ∧ ∀ ω : TestFormOn (univ : Set (Euclid n)) n, C ω = (c : ℝ) * ∫ y, (ω : DifferentialForm (Euclid n) n) y ⇑(EuclideanSpace.basisFun (Fin n) ℝ) := by
  intro n c hn
  obtain ⟨R, hR⟩ := Submission.dtc_bc_cz_unit_current_imrep n c hn
  obtain ⟨C, hC⟩ := Submission.dtc_imrep_current n n univ R
  exact ⟨C, ⟨R, hC⟩, fun ω => (hC ω).trans (hR ω)⟩
/-- **Change of variables for the dilation `η_{x,λ}(y) = λ⁻¹(y − x)`, `λ > 0`** (the `λⁿ`
scaling of Lebesgue measure under `η_{x,λⱼ}` in the proof of Simon 7.3.1, (1),
chapter-07.txt lines 326–335).  For every `F : ℝᴾ → ℝ`, with no measurability or integrability
assumption (a non-integrable function has integral `0`), `∫ F(η_{x,λ}(y)) dy = λᴾ ∫ F(z) dz`:
`F ∘ η_{x,λ} = G(· − x)` with `G = F(λ⁻¹ ·)`, Lebesgue measure is translation invariant, and
`∫ F(λ⁻¹y) dy = λ^{dim ℝᴾ} ∫ F = λᴾ ∫ F` (Haar scaling). -/
theorem Submission.dtc_bc_cz_blowUp_eval_integral_dilation : ∀ (P : ℕ) (F : Euclid P → ℝ) (x : Euclid P) (lam : ℝ), 0 < lam → ∫ y, F (dilation x lam y) = lam ^ P * ∫ z, F z := by
  intro P F x lam hlam
  -- Step 1: `η_{x,λ}(y) = −λ⁻¹x + λ⁻¹y = λ⁻¹(y − x)`.
  have hη : ∀ y, dilation x lam y = lam⁻¹ • (y - x) := by
    intro y
    simp [dilation, dilationCLM, sub_eq_neg_add]
  simp_rw [hη]
  -- Step 2: translation invariance, `∫ G(y − x) dy = ∫ G(y) dy` for `G = F(λ⁻¹ ·)`.
  rw [integral_sub_right_eq_self (fun y => F (lam⁻¹ • y)) x]
  -- Step 3: Haar scaling `∫ F(λ⁻¹y) dy = λ^{finrank ℝᴾ} ∫ F` (`λ ≥ 0`), and `finrank ℝᴾ = P`.
  rw [Measure.integral_comp_inv_smul_of_nonneg volume F hlam.le, finrank_euclideanSpace_fin,
    smul_eq_mul]
/-- **The dilation `η_{x,λ}` maps `B_ρ(x)` onto `B_{ρ/λ}(0)`** (Simon 7.3, `η_{x,λ}(y) = λ⁻¹(y − x)`,
`λ > 0`).  Since `‖η(y)‖ = λ⁻¹‖y − x‖`, `η⁻¹(B_{ρ/λ}(0)) = B_ρ(x)`; and since `η(x + λz) = z`,
`η(B_ρ(x)) = B_{ρ/λ}(0)`.  No sign condition on `ρ` is needed (both sides are empty if `ρ ≤ 0`). -/
theorem Submission.dtc_bc_cz_blowUp_eval_dilation_ball : ∀ (P : ℕ) (x : Euclid P) (ρ lam : ℝ), 0 < lam → dilation x lam ⁻¹' ball 0 (ρ / lam) = ball x ρ ∧ dilation x lam '' ball x ρ = ball 0 (ρ / lam) := by
  intro P x ρ lam hlam
  -- Step 1: `η(y) = −λ⁻¹x + λ⁻¹y = λ⁻¹(y − x)`.
  have h1 : ∀ y, dilation x lam y = lam⁻¹ • (y - x) := by
    intro y
    simp [dilation, dilationCLM, sub_eq_neg_add]
  -- Step 2: `η(y) ∈ B_{ρ/λ}(0) ↔ λ⁻¹‖y − x‖ < ρ/λ ↔ ‖y − x‖ < ρ ↔ y ∈ B_ρ(x)`.
  have hpre : dilation x lam ⁻¹' ball 0 (ρ / lam) = ball x ρ := by
    ext y
    rw [mem_preimage, mem_ball, mem_ball, dist_zero_right, h1, norm_smul, dist_eq_norm,
      Real.norm_eq_abs, abs_inv, abs_of_pos hlam, lt_div_iff₀ hlam, inv_mul_eq_div,
      div_mul_cancel₀ _ hlam.ne']
  refine ⟨hpre, Subset.antisymm ?_ ?_⟩
  · -- Step 3: `η(B_ρ(x)) ⊆ B_{ρ/λ}(0)` by the preimage identity.
    rw [image_subset_iff, hpre]
  · -- Step 4: `z = η(x + λz)` and `x + λz ∈ η⁻¹(B_{ρ/λ}(0)) = B_ρ(x)`.
    intro z hz
    have hz' : dilation x lam (x + lam • z) = z := by
      rw [h1, add_sub_cancel_left, smul_smul, inv_mul_cancel₀ hlam.ne', one_smul]
    refine ⟨x + lam • z, ?_, hz'⟩
    rw [← hpre, mem_preimage, hz']
    exact hz
/-- **Blow-ups of a top-dimensional current that is `c[[ℝ^{m+1}]]` near `x`** (codimension-zero
case `n = P` of the proof of Simon 7.3.1, chapter-07.txt lines 326–338: the dilations
`η_{x,λⱼ#}T` of (1), line 331, and `∂η_{x,λⱼ#}T = 0` in `B_R(0)`, line 336; push-forward
6.2.23–6.2.24(1), chapter-06.txt lines 408–414).  Let `η = η_{x,λ}`, `η(y) = λ⁻¹(y − x)`, `λ > 0`,
`B_ρ(x) ⊆ U`, and `e = (e₁, …, e_{m+1})` the standard basis.  (i) If `T(ω) = c ∫ ω(y)(e) dy` for
`ω ∈ 𝒟^{m+1}(U)` with `spt ω ⊆ B_ρ(x)`, then `η_#T(ω) = c ∫ ω(z)(e) dz` for
`ω ∈ 𝒟^{m+1}(ℝ^{m+1})` with `spt ω ⊆ B_{ρ/λ}(0)`.  (ii) If `∂T` vanishes on forms supported in
`B_ρ(x)`, then `∂(η_#T)` vanishes on forms supported in `B_{ρ/λ}(0)`.

`η⁻¹(B_{ρ/λ}(0)) = B_ρ(x)` and `η(B_ρ(x)) = B_{ρ/λ}(0) ⊆ η(U)`
(`dtc_bc_cz_blowUp_eval_dilation_ball`), so `ω' = ω ∘ η` is supported in `B_ρ(x)`, and
`η_#T(ω) = λ^{-(m+1)} T(ω')` (`dtc_blowUp_testForm_corr`).  (i) `T(ω') = c ∫ ω(η(y))(e) dy =
c λ^{m+1} ∫ ω(z)(e) dz` (`dtc_bc_cz_blowUp_eval_integral_dilation`).  (ii)
`∂(η_#T) = η_#(∂T)` (`dtc_blowUp_algebra`), so `∂(η_#T)(β) = λ^{-m} ∂T(β ∘ η) = 0`. -/
theorem Submission.dtc_bc_cz_blowUp_eval : ∀ (m : ℕ) (U : Set (Euclid (m + 1))) (T : GeometricCurrentOn U (m + 1)) (x : Euclid (m + 1)) (ρ c lam : ℝ) (hlam : 0 < lam), ball x ρ ⊆ U → ((∀ ω : TestFormOn U (m + 1), tsupport (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) ⊆ ball x ρ → T ω = c * ∫ y, (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) y ⇑(EuclideanSpace.basisFun (Fin (m + 1)) ℝ)) → ∀ ω : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1), tsupport (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) ⊆ ball 0 (ρ / lam) → currentEval (blowUp T x lam hlam.ne') (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) = c * ∫ z, (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) z ⇑(EuclideanSpace.basisFun (Fin (m + 1)) ℝ)) ∧ ((∀ β : TestFormOn U m, tsupport (β : DifferentialForm (Euclid (m + 1)) m) ⊆ ball x ρ → T.boundary β = 0) → ∀ β : TestFormOn (dilation x lam '' U) m, tsupport (β : DifferentialForm (Euclid (m + 1)) m) ⊆ ball 0 (ρ / lam) → (blowUp T x lam hlam.ne').boundary β = 0) := by
  intro m U T x ρ c lam hlam hball
  obtain ⟨hpre, himg⟩ := Submission.dtc_bc_cz_blowUp_eval_dilation_ball (m + 1) x ρ lam hlam
  -- Step 1: if `ω' = ω ∘ η` and `spt ω ⊆ B_{ρ/λ}(0)`, then `spt ω' ⊆ η⁻¹(B_{ρ/λ}(0)) = B_ρ(x)`.
  have hsupp : ∀ {k : ℕ} (ω ω' : DifferentialForm (Euclid (m + 1)) k),
      (∀ y, ω' y = ω (dilation x lam y)) → tsupport ω ⊆ ball 0 (ρ / lam) →
        tsupport ω' ⊆ ball x ρ := by
    intro k ω ω' hω' hω
    have hfun : ω' = ω ∘ dilation x lam := funext hω'
    rw [hfun, ← hpre]
    exact (tsupport_comp_subset_preimage ω
      (continuous_const.add (dilationCLM (m + 1) lam).continuous)).trans (preimage_mono hω)
  refine ⟨fun hT ω hω => ?_, fun hTb β hβ => ?_⟩
  · -- Step 2 (i): `ω ∈ 𝒟^{m+1}(η(U))`, as `B_{ρ/λ}(0) = η(B_ρ(x)) ⊆ η(U)`, so
    -- `η_#T(ω) = λ^{-(m+1)} T(ω ∘ η) = λ^{-(m+1)} c ∫ ω(η(y))(e) dy = c ∫ ω(z)(e) dz`.
    obtain ⟨ha, -, hval⟩ := Submission.dtc_blowUp_testForm_corr (m + 1) (m + 1) U x lam hlam
    have hmem : IsTestForm (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) ∧
        tsupport (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) ⊆ dilation x lam '' U :=
      ⟨ω.property.1, hω.trans (himg.symm.subset.trans (image_mono hball))⟩
    obtain ⟨ω', hω'⟩ := ha ⟨ω, hmem⟩
    have hint : ∫ y, (ω' : DifferentialForm (Euclid (m + 1)) (m + 1)) y
        ⇑(EuclideanSpace.basisFun (Fin (m + 1)) ℝ) = lam ^ (m + 1) *
          ∫ z, (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) z
            ⇑(EuclideanSpace.basisFun (Fin (m + 1)) ℝ) := by
      rw [← Submission.dtc_bc_cz_blowUp_eval_integral_dilation (m + 1)
        (fun z => (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) z
          ⇑(EuclideanSpace.basisFun (Fin (m + 1)) ℝ)) x lam hlam]
      congr 1
      funext y
      rw [hω' y]
    rw [currentEval, dite_eq_left hmem, hval T ⟨ω, hmem⟩ ω' hω', hT ω' (hsupp _ _ hω' hω), hint,
      inv_pow]
    field_simp
  · -- Step 3 (ii): `∂(η_#T)(β) = η_#(∂T)(β) = λ^{-m} ∂T(β ∘ η) = 0`.
    obtain ⟨ha, -, hval⟩ := Submission.dtc_blowUp_testForm_corr (m + 1) m U x lam hlam
    obtain ⟨β', hβ'⟩ := ha β
    rw [(Submission.dtc_blowUp_algebra (m + 1) U x lam hlam).2.2.2 m T, hval T.boundary β β' hβ',
      hTb β' (hsupp _ _ hβ' hβ), mul_zero]
/-- **Pairing error against a constant multivector** (step 2 of the proof of
`Submission.cbr_ci_bl_constant_vector_limit`, for a single measure).  Let `w` be a continuous
covector field with `‖w‖ ≤ A` that vanishes outside `B̄_R = closedBall 0 R`, and suppose
`E = A ∫_{B̄_R} ‖τ − ζ₀‖ dν'` is finite.  The error `g(x) = ⟨w(x), τ(x) − ζ₀⟩` is a.e. strongly
measurable, being the continuous evaluation of `τ − ζ₀` at `w`.  By `le_opENorm`, and since
`w = 0` off `B̄_R`, `‖g(x)‖ ≤ 1_{B̄_R}(x) A ‖τ(x) − ζ₀‖`.  Hence `∫ ‖g‖ dν' ≤ E < ∞` and `g` is
integrable.  As `⟨w, τ⟩ = ⟨w, ζ₀⟩ + g`, the difference of the two integrals is `∫ g dν'`, and
`|∫ g dν'| ≤ ∫ ‖g‖ dν' ≤ E`. -/
theorem Submission.cbr_ci_bl_cvl_pairing_error_le : ∀ (P n : ℕ) (ν' : Measure (Euclid P)) (τ : Euclid P → MultiVector P n) (ζ₀ : MultiVector P n) (w : Euclid P → Covector (Euclid P) n) (A R : ℝ), AEStronglyMeasurable τ ν' → Continuous w → (∀ x, ‖w x‖ ≤ A) → (∀ x, x ∉ closedBall (0 : Euclid P) R → w x = 0) → Integrable (fun x => ζ₀ (w x)) ν' → ENNReal.ofReal A * ∫⁻ x in closedBall (0 : Euclid P) R, ‖τ x - ζ₀‖ₑ ∂ν' ≠ ∞ → |∫ x, τ x (w x) ∂ν' - ∫ x, ζ₀ (w x) ∂ν'| ≤ (ENNReal.ofReal A * ∫⁻ x in closedBall (0 : Euclid P) R, ‖τ x - ζ₀‖ₑ ∂ν').toReal := by
  intro P n ν' τ ζ₀ w A R hτ hw hwA hw0 hζ hE
  -- the error integrand `g(x) = ⟨w(x), τ(x) − ζ₀⟩`
  set g : Euclid P → ℝ := fun x => (τ x - ζ₀) (w x) with hg
  -- Step 1: `g` is a.e. strongly measurable (continuous evaluation of `τ − ζ₀` at `w`)
  have hgm : AEStronglyMeasurable g ν' :=
    Continuous.comp_aestronglyMeasurable₂ (g := fun (L : MultiVector P n) v => L v)
      isBoundedBilinearMap_apply.continuous (hτ.sub aestronglyMeasurable_const)
      hw.aestronglyMeasurable
  -- Step 2: `‖g(x)‖ₑ ≤ 1_{B̄_R}(x) A ‖τ(x) − ζ₀‖ₑ`
  have hpt : ∀ x, ‖g x‖ₑ ≤
      (closedBall (0 : Euclid P) R).indicator (fun x => ENNReal.ofReal A * ‖τ x - ζ₀‖ₑ) x := by
    intro x
    by_cases hx : x ∈ closedBall (0 : Euclid P) R
    · rw [indicator_of_mem hx, mul_comm]
      calc ‖g x‖ₑ ≤ ‖τ x - ζ₀‖ₑ * ‖w x‖ₑ := (τ x - ζ₀).le_opENorm (w x)
        _ ≤ ‖τ x - ζ₀‖ₑ * ENNReal.ofReal A := by
          gcongr
          rw [← ofReal_norm]
          exact ENNReal.ofReal_le_ofReal (hwA x)
    · rw [indicator_of_notMem hx, hg]
      simp [hw0 x hx]
  -- Step 3: `∫⁻ ‖g‖ₑ ≤ A ∫⁻_{B̄_R} ‖τ − ζ₀‖ₑ = E < ∞`
  have hlint : ∫⁻ x, ‖g x‖ₑ ∂ν' ≤
      ENNReal.ofReal A * ∫⁻ x in closedBall (0 : Euclid P) R, ‖τ x - ζ₀‖ₑ ∂ν' := by
    calc ∫⁻ x, ‖g x‖ₑ ∂ν'
        ≤ ∫⁻ x, (closedBall (0 : Euclid P) R).indicator
            (fun x => ENNReal.ofReal A * ‖τ x - ζ₀‖ₑ) x ∂ν' := lintegral_mono hpt
      _ = ∫⁻ x in closedBall (0 : Euclid P) R, ENNReal.ofReal A * ‖τ x - ζ₀‖ₑ ∂ν' :=
          lintegral_indicator measurableSet_closedBall _
      _ = ENNReal.ofReal A * ∫⁻ x in closedBall (0 : Euclid P) R, ‖τ x - ζ₀‖ₑ ∂ν' :=
          lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
  -- Step 4: `g` is integrable
  have hgi : Integrable g ν' := ⟨hgm, hasFiniteIntegral_iff_enorm.2 (hlint.trans_lt hE.lt_top)⟩
  -- Step 5: `⟨w, τ⟩ = ⟨w, ζ₀⟩ + g`, so the difference of the integrals is `∫ g`
  have hint : ∫ x, τ x (w x) ∂ν' - ∫ x, ζ₀ (w x) ∂ν' = ∫ x, g x ∂ν' := by
    have hsplit : (fun x => τ x (w x)) = fun x => ζ₀ (w x) + g x := by
      funext x
      simp [hg]
    rw [hsplit, integral_add hζ hgi, add_sub_cancel_left]
  -- Step 6: `|∫ g| ≤ (∫⁻ ‖g‖ₑ).toReal ≤ E.toReal`
  rw [hint, ← Real.norm_eq_abs, ← toReal_enorm]
  calc (‖∫ x, g x ∂ν'‖ₑ).toReal ≤ (∫⁻ x, ‖g x‖ₑ ∂ν').toReal :=
        ENNReal.toReal_mono (hlint.trans_lt hE.lt_top).ne (enorm_integral_le_lintegral_enorm _)
    _ ≤ _ := ENNReal.toReal_mono hE hlint

/-- **Pairings with a compactly supported form converge.**  Let `νₖ, ν` be measures on `ℝᴾ`, each
`νₖ` finite on compact sets, with `∫ f dνₖ → ∫ f dν` for every continuous compactly supported `f`,
and let `τₖ : ℝᴾ → Λₙ` be `νₖ`-a.e. strongly measurable with `∫_{B̄_R(0)} ‖τₖ − ζ₀‖ dνₖ → 0` for
every `R > 0`.  Then `∫ τₖ(w) dνₖ → ∫ ζ₀(w) dν` for every continuous compactly supported
`w : ℝᴾ → Λⁿ`.  Take `A ≥ ‖w‖` and `R > 0` with `w = 0` off `B̄_R(0)`.  Then `f = ζ₀ ∘ w` is
continuous with compact support, hence `νₖ`-integrable; the error estimate
`cbr_ci_bl_cvl_pairing_error_le` gives `|∫ τₖ(w) dνₖ − ∫ f dνₖ| ≤ A ∫_{B̄_R(0)} ‖τₖ − ζ₀‖ dνₖ → 0`,
and `∫ f dνₖ → ∫ f dν` by hypothesis. -/
theorem Submission.cbr_ci_bl_cvl_pairing_tendsto : ∀ (P n : ℕ) (νs : ℕ → Measure (Euclid P)) (ν : Measure (Euclid P)) (τs : ℕ → Euclid P → MultiVector P n) (ζ₀ : MultiVector P n) (w : Euclid P → Covector (Euclid P) n), (∀ (k : ℕ) (K : Set (Euclid P)), IsCompact K → νs k K < ∞) → (∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → Tendsto (fun k => ∫ x, f x ∂(νs k)) atTop (𝓝 (∫ x, f x ∂ν))) → (∀ k, AEStronglyMeasurable (τs k) (νs k)) → (∀ R : ℝ, 0 < R → Tendsto (fun k => ∫⁻ x in closedBall (0 : Euclid P) R, ‖τs k x - ζ₀‖ₑ ∂(νs k)) atTop (𝓝 0)) → Continuous w → HasCompactSupport w → Tendsto (fun k => ∫ x, τs k x (w x) ∂(νs k)) atTop (𝓝 (∫ x, ζ₀ (w x) ∂ν)) := by
  intro P n νs ν τs ζ₀ w hfin hconv hmeas hlim hw hwc
  -- Step 1: `‖w‖ ≤ A`, and `w = 0` off `B̄_R(0)` for some `R > 0`
  obtain ⟨A, hA⟩ := hw.bounded_above_of_compact_support hwc
  obtain ⟨R₀, hR₀⟩ := hwc.isCompact.isBounded.subset_closedBall (0 : Euclid P)
  obtain ⟨R, hR, hsupp⟩ : ∃ R : ℝ, 0 < R ∧ tsupport w ⊆ closedBall (0 : Euclid P) R :=
    ⟨max R₀ 1, lt_max_of_lt_right one_pos,
      hR₀.trans (closedBall_subset_closedBall (le_max_left R₀ 1))⟩
  have hzero : ∀ x, x ∉ closedBall (0 : Euclid P) R → w x = 0 := fun x hx =>
    image_eq_zero_of_notMem_tsupport fun hxw => hx (hsupp hxw)
  -- Step 2: `f = ζ₀ ∘ w` is continuous with compact support, hence `νₖ`-integrable
  have hfc : Continuous fun x => ζ₀ (w x) := ζ₀.continuous.comp hw
  have hfs : HasCompactSupport fun x => ζ₀ (w x) := hwc.comp_left (map_zero ζ₀)
  have hfi : ∀ k, Integrable (fun x => ζ₀ (w x)) (νs k) := fun k => by
    have : IsFiniteMeasureOnCompacts (νs k) := ⟨fun K hK => hfin k K hK⟩
    exact hfc.integrable_of_hasCompactSupport hfs
  -- Step 3: `eₖ = ofReal A · δₖ(R) → 0`; eventually `eₖ < 1`, so `eₖ ≠ ∞`; `eₖ.toReal → 0`
  have he : Tendsto (fun k => ENNReal.ofReal A *
      ∫⁻ x in closedBall (0 : Euclid P) R, ‖τs k x - ζ₀‖ₑ ∂(νs k)) atTop (𝓝 0) := by
    simpa only [mul_zero] using
      ENNReal.Tendsto.const_mul (hlim R hR) (Or.inr ENNReal.ofReal_ne_top)
  have he1 : ∀ᶠ k in atTop, ENNReal.ofReal A *
      ∫⁻ x in closedBall (0 : Euclid P) R, ‖τs k x - ζ₀‖ₑ ∂(νs k) < 1 :=
    (tendsto_order.1 he).2 1 one_pos
  have heR : Tendsto (fun k => (ENNReal.ofReal A *
      ∫⁻ x in closedBall (0 : Euclid P) R, ‖τs k x - ζ₀‖ₑ ∂(νs k)).toReal) atTop (𝓝 0) := by
    simpa only [Function.comp_def, ENNReal.toReal_zero] using
      (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp he
  -- Step 4: `pairing_error` bounds `dₖ = ∫ τₖ(w) dνₖ − ∫ f dνₖ` by `eₖ.toReal`, so `dₖ → 0`
  have hd : Tendsto (fun k => ∫ x, τs k x (w x) ∂(νs k) - ∫ x, ζ₀ (w x) ∂(νs k)) atTop
      (𝓝 0) := by
    refine squeeze_zero_norm' ?_ heR
    filter_upwards [he1] with k hk
    rw [Real.norm_eq_abs]
    exact Submission.cbr_ci_bl_cvl_pairing_error_le P n (νs k) (τs k) ζ₀ w A R (hmeas k) hw hA
      hzero (hfi k) (ne_top_of_lt hk)
  -- Step 5: `∫ τₖ(w) dνₖ = dₖ + ∫ f dνₖ → 0 + ∫ f dν`
  have hlim' := hd.add (hconv (fun x => ζ₀ (w x)) hfc hfs)
  rw [zero_add] at hlim'
  exact hlim'.congr fun k => sub_add_cancel _ _
/-- **Mass bound for a current `L¹`-close to a constant `n`-vector** (step 4 of the weak
convergence and limsup mass bound for such currents, used for blow-ups of cycles).  Let
`X ∈ 𝒟ₙ(ℝᴾ)` satisfy `X(ω) = ∫ ⟨ω(x), τ(x)⟩ dν'(x)` for every test form, with `ν'` finite on
compact sets, and let `|⟨α, ζ₀⟩| ≤ s|α|` and `‖α‖ ≤ B|α|` for all covectors `α`.  Then for open
`G ⊆ B̄_R(0)`, `M_G(X) ≤ s ν'(G) + B ∫_{B̄_R(0)} ‖τ − ζ₀‖ dν'`.  Fix an admissible `ω`
(`tsupport ω ⊆ G`, `|ω| ≤ 1`); it vanishes off `G ⊆ B̄_R(0)` and `‖ω‖ ≤ B`, so the pairing-error
estimate bounds `X(ω) − ∫ ⟨ω, ζ₀⟩ dν'` by the error term `E`, while `⟨ω, ζ₀⟩ ≤ s 1_G` pointwise
gives `∫ ⟨ω, ζ₀⟩ dν' ≤ s ν'(G)`.  As `ν'(G) < ∞`, `X(ω) ≤ s ν'(G) + E` in `[0, ∞]`. -/
theorem Submission.cbr_ci_bl_cvl_massOn_le : ∀ (P n : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) n) (ν' : Measure (Euclid P)) (τ : Euclid P → MultiVector P n) (ζ₀ : MultiVector P n) (s B R : ℝ) (G : Set (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → ν' K < ∞) → AEStronglyMeasurable τ ν' → 0 ≤ s → (∀ α : Covector (Euclid P) n, |ζ₀ α| ≤ s * covectorEuclideanNorm α) → 0 ≤ B → (∀ α : Covector (Euclid P) n, ‖α‖ ≤ B * covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) n, X ω = ∫ x, τ x ((ω : DifferentialForm (Euclid P) n) x) ∂ν') → IsOpen G → G ⊆ closedBall (0 : Euclid P) R → X.massOn G ≤ ENNReal.ofReal s * ν' G + ENNReal.ofReal B * ∫⁻ x in closedBall (0 : Euclid P) R, ‖τ x - ζ₀‖ₑ ∂ν' := by
  intro P n X ν' τ ζ₀ s B R G hfin hτ hs hζ₀ hB hBnorm hrep hG hGR
  have : IsFiniteMeasureOnCompacts ν' := ⟨hfin⟩
  -- Step 1: `ν'(G) ≤ ν'(B̄_R(0)) < ∞`
  have hGfin : ν' G ≠ ∞ :=
    ((measure_mono hGR).trans_lt (hfin _ (isCompact_closedBall 0 R))).ne
  -- Step 2: `M_G(X)` is the supremum of `X(ω)` over admissible `ω`; fix one, and dispose of the
  -- case `E = ∞`
  refine sSup_le ?_
  rintro r ⟨ω, ⟨hωG, hω1⟩, rfl⟩
  show ENNReal.ofReal (X ω) ≤ _
  by_cases hEtop : ENNReal.ofReal B * ∫⁻ x in closedBall (0 : Euclid P) R, ‖τ x - ζ₀‖ₑ ∂ν' = ∞
  · rw [hEtop, add_top]
    exact le_top
  -- Step 3: `w = ω̂` is continuous with compact support, vanishes off `G ⊆ B̄_R(0)`, and
  -- `‖w‖ ≤ B|w| ≤ B`; hence `ζ₀ ∘ w` is `ν'`-integrable
  have hwcont : Continuous (ω : DifferentialForm (Euclid P) n) := ω.2.1.1.continuous
  have hwcs : HasCompactSupport (ω : DifferentialForm (Euclid P) n) := ω.2.1.2
  rw [hrep ω]
  generalize (ω : DifferentialForm (Euclid P) n) = w at hwcont hwcs hωG hω1 ⊢
  have hw0 : ∀ x, x ∉ G → w x = 0 := fun x hx =>
    image_eq_zero_of_notMem_tsupport fun h => hx (hωG h)
  have hwR : ∀ x, x ∉ closedBall (0 : Euclid P) R → w x = 0 := fun x hx =>
    hw0 x fun h => hx (hGR h)
  have hwB : ∀ x, ‖w x‖ ≤ B := fun x =>
    (hBnorm (w x)).trans ((mul_le_mul_of_nonneg_left (hω1 x) hB).trans (mul_one B).le)
  have hfint : Integrable (fun x => ζ₀ (w x)) ν' :=
    (ζ₀.continuous.comp hwcont).integrable_of_hasCompactSupport (hwcs.comp_left (map_zero ζ₀))
  -- Step 4: the pairing-error estimate gives `X(ω) ≤ ∫ ζ₀(w) dν' + E`
  have herr := Submission.cbr_ci_bl_cvl_pairing_error_le P n ν' τ ζ₀ w B R hτ hwcont hwB hwR
    hfint hEtop
  -- Step 5: `ζ₀(w) ≤ s 1_G` pointwise, so `∫ ζ₀(w) dν' ≤ s ν'(G)`
  have hGm : MeasurableSet G := hG.measurableSet
  have hmain : ∫ x, ζ₀ (w x) ∂ν' ≤ s * (ν' G).toReal := by
    refine (integral_mono hfint ((integrable_indicator_iff hGm).2 (integrableOn_const hGfin))
      fun x => ?_).trans_eq ?_
    · show ζ₀ (w x) ≤ G.indicator (fun _ => s) x
      by_cases hx : x ∈ G
      · rw [indicator_of_mem hx]
        exact (le_abs_self _).trans ((hζ₀ (w x)).trans
          ((mul_le_mul_of_nonneg_left (hω1 x) hs).trans (mul_one s).le))
      · rw [indicator_of_notMem hx, hw0 x hx, map_zero]
    · rw [integral_indicator_const _ hGm, smul_eq_mul, measureReal_def, mul_comm]
  -- Step 6: `ofReal(X(ω)) ≤ ofReal(s ν'(G)) + ofReal(E) = ofReal(s) ν'(G) + E`
  generalize ENNReal.ofReal B * ∫⁻ x in closedBall (0 : Euclid P) R, ‖τ x - ζ₀‖ₑ ∂ν' = E
    at hEtop herr ⊢
  calc ENNReal.ofReal (∫ x, τ x (w x) ∂ν')
      ≤ ENNReal.ofReal (s * (ν' G).toReal + E.toReal) :=
        ENNReal.ofReal_le_ofReal (by linarith [(abs_sub_le_iff.1 herr).1])
    _ ≤ ENNReal.ofReal (s * (ν' G).toReal) + ENNReal.ofReal E.toReal := ENNReal.ofReal_add_le
    _ = ENNReal.ofReal s * ν' G + E := by
        rw [ENNReal.ofReal_mul hs, ENNReal.ofReal_toReal hGfin, ENNReal.ofReal_toReal hEtop]
/-- **Radial slice bound** (Simon Ch. 6, 4.9–4.11 for the `1`-Lipschitz `f(y) = |y|`).  If
`S = τ(M, θ, ξ)` has `∂S = 0` on `B_R(0)`, `B̄_R(0) ⊆ U`, `t < R` and `|β| ≤ s`, then
`|∫_{M ∩ B_t(0)} θ ⟨dβ, ξ⟩ dHⁿ| ≤ s · liminf_{h ↓ 0} h⁻¹ μ_S({t − h < |x| < t})`.
For `0 < h < 1` let `g_h` be the level cut-off of `|·|` (`cmcs_level_cutoff`): `g_h = 1` on
`{|x| ≤ t − h}`, `g_h = 0` on `{|x| ≥ t}`, and `|Dg_h| ≤ 1/(h(1 − h/2))` vanishes off the strip
`A_h = {t − h < |x| < t}`.  The defect estimate `dtc_bc_tc_rs_cutoff_defect` (`V = B_R(0)`) gives
`|∫_M g_h θ ⟨dβ, ξ⟩ dHⁿ| ≤ s/(h(1 − h/2)) · μ_S(A_h)`.  With the integrand truncated to
`B̄_t(0)` (integrable by `dpf_pfc_imrep_pairing_integrable_abs_le`), dominated convergence
(`cmcs_smp_cutoff_integral_tendsto`) gives `∫_M g_h θ ⟨dβ, ξ⟩ dHⁿ → ∫_{M ∩ B_t(0)} θ ⟨dβ, ξ⟩ dHⁿ`,
and `cmcs_smp_liminf_bound` (`L = s`) passes to the `liminf`. -/
theorem Submission.dtc_bc_tc_rs_radius_bound : ∀ (P m : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U (m + 1)) (Rp : IMRep U (m + 1)) (R t : ℝ), closedBall (0 : Euclid P) R ⊆ U → Rp.Represents S → (∀ ω : TestFormOn U m, tsupport (ω : DifferentialForm (Euclid P) m) ⊆ ball 0 R → S.boundary ω = 0) → t < R → ∀ (β : TestFormOn (univ : Set (Euclid P)) m) (s : ℝ), (∀ x, covectorEuclideanNorm ((β : DifferentialForm (Euclid P) m) x) ≤ s) → ENNReal.ofReal |∫ x in Rp.carrier ∩ ball 0 t, (Rp.mult x : ℝ) * Rp.orient x (exteriorDerivative (β : DifferentialForm (Euclid P) m) x) ∂μHE[m + 1]| ≤ ENNReal.ofReal s * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * Rp.measure {x : Euclid P | t - h < ‖x‖ ∧ ‖x‖ < t}) (𝓝[>] 0) := by
  intro P m U S Rp R t hRU hrep hbd htR β s hs
  -- step 1: `s ≥ |β(0)| ≥ 0`
  have hs0 : 0 ≤ s := (covectorEuclideanNorm_nonneg _).trans (hs 0)
  -- step 2: if `t ≤ 0` then `B_t(0) = ∅` and the integral vanishes
  rcases le_or_gt t 0 with ht | ht
  · rw [ball_eq_empty.2 ht, inter_empty, Measure.restrict_empty, integral_zero_measure, abs_zero,
      ENNReal.ofReal_zero]
    exact zero_le
  -- step 3: the level cut-offs `g_h` of `|·|` for `0 < h < 1` (`g_h = 0` for other `h`)
  have hcut : ∀ h : ℝ, ∃ g : Euclid P → ℝ, 0 < h → h < 1 → ContDiff ℝ (⊤ : ℕ∞) g ∧
      (∀ x, |g x| ≤ 2) ∧ (∀ x, ‖fderiv ℝ g x‖ ≤ ((1 : NNReal) : ℝ) / (h * (1 - h / 2))) ∧
      (∀ x, fderiv ℝ g x ≠ 0 → t - h < ‖x‖ ∧ ‖x‖ < t) ∧ (∀ x, ‖x‖ ≤ t - h → g x = 1) ∧
      ∀ x, t ≤ ‖x‖ → g x = 0 := by
    intro h
    by_cases hh : 0 < h ∧ h < 1
    · obtain ⟨g, hg⟩ :=
        Submission.cmcs_level_cutoff P norm 1 t h lipschitzWith_one_norm hh.1 hh.2
      exact ⟨g, fun _ _ => hg⟩
    · exact ⟨0, fun h0 h1 => absurd ⟨h0, h1⟩ hh⟩
  choose g hg using hcut
  -- `tsupport g_h ⊆ B̄_t(0) ⊆ B_R(0) ⊆ U`, as `g_h = 0` on `{|x| ≥ t}`
  have hCR : closedBall (0 : Euclid P) t ⊆ ball 0 R := closedBall_subset_ball htR
  have hCU : closedBall (0 : Euclid P) t ⊆ U := (closedBall_subset_closedBall htR.le).trans hRU
  have hgt : ∀ h : ℝ, 0 < h → h < 1 → tsupport (g h) ⊆ closedBall 0 t := fun h h0 h1 =>
    closure_minimal (fun x hx => mem_closedBall_zero_iff.2 (not_lt.1 fun hxt =>
      mem_support.1 hx ((hg h h0 h1).2.2.2.2.2 x hxt.le))) isClosed_closedBall
  -- step 4: `F = 1_{B̄_t(0)} θ ⟨dβ, ξ⟩` is `Hⁿ⌞M`-integrable (`dβ` is a bounded test form)
  have hdβ : IsTestForm (exteriorDerivative (β : DifferentialForm (Euclid P) m)) :=
    exteriorDerivative_isTestForm β.property.1
  have hdβc : Continuous (exteriorDerivative (β : DifferentialForm (Euclid P) m)) :=
    ContDiff.continuous hdβ.1
  obtain ⟨B, hB⟩ := hdβc.bounded_above_of_compact_support hdβ.2
  have hF := (Submission.dpf_pfc_imrep_pairing_integrable_abs_le P (m + 1) U (closedBall 0 t) Rp
    ((closedBall 0 t).indicator (exteriorDerivative (β : DifferentialForm (Euclid P) m))) B
    (isCompact_closedBall 0 t) hCU (hdβc.aestronglyMeasurable.indicator measurableSet_closedBall)
    (fun x hx => indicator_of_notMem hx _)
    (fun x => (norm_indicator_le_norm_self _ x).trans (hB x))).1
  -- step 5: `∫ g_h F d(Hⁿ⌞M) = ∫_M g_h θ ⟨dβ, ξ⟩ dHⁿ`, as `g_h = 0` off `B̄_t(0)`
  have hΦ : ∀ h : ℝ, 0 < h → h < 1 →
      ∫ x, g h x * ((Rp.mult x : ℝ) * Rp.orient x ((closedBall 0 t).indicator
        (exteriorDerivative (β : DifferentialForm (Euclid P) m)) x))
          ∂(μHE[m + 1].restrict Rp.carrier) =
      ∫ x in Rp.carrier, g h x * ((Rp.mult x : ℝ) *
        Rp.orient x (exteriorDerivative (β : DifferentialForm (Euclid P) m) x)) ∂μHE[m + 1] := by
    intro h h0 h1
    refine integral_congr_ae (Eventually.of_forall fun x => ?_)
    by_cases hx : x ∈ closedBall (0 : Euclid P) t
    · simp only [indicator_of_mem hx]
    · have hxt : t ≤ ‖x‖ := (not_le.1 fun hle => hx (mem_closedBall_zero_iff.2 hle)).le
      simp only [(hg h h0 h1).2.2.2.2.2 x hxt, zero_mul]
  -- step 6: the strip estimate `|∫ g_h F| ≤ s/(h(1 − h/2)) · μ(A_h)` (`cutoff_defect`)
  have hstrip : ∀ h : ℝ, 0 < h → h < 1 →
      ENNReal.ofReal |∫ x, g h x * ((Rp.mult x : ℝ) * Rp.orient x ((closedBall 0 t).indicator
        (exteriorDerivative (β : DifferentialForm (Euclid P) m)) x))
          ∂(μHE[m + 1].restrict Rp.carrier)| ≤
      ENNReal.ofReal ((s.toNNReal : ℝ) / (h * (1 - h / 2))) *
        Rp.measure {x : Euclid P | t - h < ‖x‖ ∧ ‖x‖ < t} := by
    intro h h0 h1
    obtain ⟨hgs, -, hgd, hgA, -, -⟩ := hg h h0 h1
    have hA : MeasurableSet {x : Euclid P | t - h < ‖x‖ ∧ ‖x‖ < t} :=
      (measurableSet_lt measurable_const measurable_norm).inter
        (measurableSet_lt measurable_norm measurable_const)
    rw [hΦ h h0 h1, Real.coe_toNNReal s hs0, ← lintegral_indicator_const hA]
    refine (Submission.dtc_bc_tc_rs_cutoff_defect P m U (ball 0 R) S Rp (g h) β hrep hbd hgs
      ((hgt h h0 h1).trans hCU) ((hgt h h0 h1).trans hCR)).trans (lintegral_mono fun x => ?_)
    -- pointwise: `|Dg_h| |β| ≤ s/(h(1 − h/2))` on `A_h`, and `Dg_h = 0` off `A_h`
    by_cases hx : fderiv ℝ (g h) x = 0
    · rw [hx, norm_zero, zero_mul, ENNReal.ofReal_zero]
      exact zero_le
    · rw [indicator_of_mem (show x ∈ {x : Euclid P | t - h < ‖x‖ ∧ ‖x‖ < t} from hgA x hx)]
      refine ENNReal.ofReal_le_ofReal ?_
      calc ‖fderiv ℝ (g h) x‖ * covectorEuclideanNorm ((β : DifferentialForm (Euclid P) m) x)
          ≤ ((1 : NNReal) : ℝ) / (h * (1 - h / 2)) * s :=
            mul_le_mul (hgd x) (hs x) (covectorEuclideanNorm_nonneg _)
              (div_nonneg (NNReal.coe_nonneg _) (mul_pos h0 (by linarith)).le)
        _ = s / (h * (1 - h / 2)) := by rw [NNReal.coe_one]; ring
  -- step 7: `∫ g_h F d(Hⁿ⌞M) → ∫_{M ∩ B_t(0)} θ ⟨dβ, ξ⟩ dHⁿ` as `h ↓ 0`
  have hlim := Submission.cmcs_smp_cutoff_integral_tendsto P (μHE[m + 1].restrict Rp.carrier) _
    norm t 2 g hF measurable_norm
    (fun h h0 h1 => (ContDiff.continuous (hg h h0 h1).1).aestronglyMeasurable)
    (fun h h0 h1 => (hg h h0 h1).2.1) (fun h h0 h1 => (hg h h0 h1).2.2.2.2.1)
    (fun h h0 h1 => (hg h h0 h1).2.2.2.2.2)
  -- the limit: `{|x| < t} = B_t(0)`, `(Hⁿ⌞M)⌞B_t(0) = Hⁿ⌞(M ∩ B_t(0))` and `F = θ ⟨dβ, ξ⟩` there
  have hball : {x : Euclid P | ‖x‖ < t} = ball 0 t := by
    ext x
    exact mem_ball_zero_iff.symm
  have hI : ∫ x in {x : Euclid P | ‖x‖ < t}, (Rp.mult x : ℝ) * Rp.orient x
        ((closedBall 0 t).indicator (exteriorDerivative (β : DifferentialForm (Euclid P) m)) x)
          ∂(μHE[m + 1].restrict Rp.carrier) =
      ∫ x in Rp.carrier ∩ ball 0 t, (Rp.mult x : ℝ) *
        Rp.orient x (exteriorDerivative (β : DifferentialForm (Euclid P) m) x) ∂μHE[m + 1] := by
    rw [hball, Measure.restrict_restrict measurableSet_ball, inter_comm]
    refine setIntegral_congr_fun (Rp.measurableSet_carrier.inter measurableSet_ball) fun x hx => ?_
    simp only [indicator_of_mem (ball_subset_closedBall hx.2)]
  rw [hI] at hlim
  -- step 8: `cmcs_smp_liminf_bound` with `L = s`, `z = |I|` and `Φ(h) = |∫ g_h F|`
  exact Submission.cmcs_smp_liminf_bound s.toNNReal _ _ _ hlim.abs fun h h0 h1 => by
    simpa only [abs_abs] using hstrip h h0 h1
/-- Helly selection with no concentration on left intervals (the compactness ingredient of the
choice of the slicing level in the proof of Simon 6.7.2, "an argument as in 6.7(2) of Ch. 2"): if
`μⱼ([a, b]) ≤ Λ < ∞`, then along a subsequence `φ` and off a countable set `N`, every
`s ∈ (a, b) \ N` and `ε > 0` admit `δ > 0` with `μ_{φ j}([s - δ, s]) ≤ ε` for all large `j`.
By Tychonoff, `μ_{φ j}([a, d]) → G(d)` for every rational `d ∈ (a, b)`; `N` is the discontinuity
set of the nondecreasing `G̃(t) = sup ({0} ∪ {G(d) : d < t})`, and `[s - δ, s] ⊆ [a, d₂] \ [a, d₁]`
for rationals `d₁ < s - δ`, `s < d₂` with `G(d₂) - G(d₁) < ε`. -/
theorem Submission.cmc_fc_gs_helly_no_concentration : ∀ (μ : ℕ → Measure ℝ) (a b : ℝ) (Λ : ℝ≥0∞), Λ ≠ ∞ → (∀ j, μ j (Icc a b) ≤ Λ) → ∃ (φ : ℕ → ℕ) (N : Set ℝ), StrictMono φ ∧ N.Countable ∧ ∀ s ∈ Ioo a b, s ∉ N → ∀ ε : ℝ≥0∞, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ᶠ j in atTop, μ (φ j) (Icc (s - δ) s) ≤ ε := by
  intro μ a b Λ hΛ hμ
  -- `μⱼ([a, x]) ≤ μⱼ([a, b]) ≤ Λ < ∞` for `x ≤ b`
  have hle : ∀ j x, x ≤ b → μ j (Icc a x) ≤ Λ := fun j x hx =>
    (measure_mono (Icc_subset_Icc_right hx)).trans (hμ j)
  have hfin : ∀ j x, x ≤ b → μ j (Icc a x) ≠ ∞ := fun j x hx =>
    ((hle j x hx).trans_lt hΛ.lt_top).ne
  -- Helly selection: `d ↦ μⱼ([a, d])` lies in the compact box `∏_{d ∈ ℚ ∩ (a, b)} [0, Λ]` of
  -- the first countable space `ℝ^(ℚ ∩ (a, b))`
  have hK : IsCompact (univ.pi fun _ : {q : ℚ // (q : ℝ) ∈ Ioo a b} => Icc (0 : ℝ) Λ.toReal) :=
    isCompact_univ_pi fun _ => isCompact_Icc
  obtain ⟨G, hGK, φ, hφ, hlim⟩ := hK.tendsto_subseq
    (x := fun j d => (μ j (Icc a (d.1 : ℝ))).toReal)
    fun j d _ => ⟨ENNReal.toReal_nonneg, ENNReal.toReal_mono hΛ (hle j _ d.2.2.le)⟩
  have hGd : ∀ d : {q : ℚ // (q : ℝ) ∈ Ioo a b},
      Tendsto (fun j => (μ (φ j) (Icc a (d.1 : ℝ))).toReal) atTop (𝓝 (G d)) :=
    tendsto_pi_nhds.1 hlim
  -- `G` is nondecreasing
  have hGmono : ∀ d d' : {q : ℚ // (q : ℝ) ∈ Ioo a b}, (d.1 : ℝ) ≤ d'.1 → G d ≤ G d' :=
    fun d d' h => le_of_tendsto_of_tendsto' (hGd d) (hGd d') fun j =>
      ENNReal.toReal_mono (hfin _ _ d'.2.2.le) (measure_mono (Icc_subset_Icc_right h))
  -- `G̃(t) = sup ({0} ∪ {G(d) : d < t})`
  obtain ⟨Gt, hGt⟩ : ∃ Gt : ℝ → ℝ, ∀ t, Gt t = sSup (insert 0 (G '' {d | (d.1 : ℝ) < t})) :=
    ⟨_, fun _ => rfl⟩
  have hbdd : ∀ t, BddAbove (insert 0 (G '' {d | (d.1 : ℝ) < t})) := fun t =>
    ⟨Λ.toReal, by
      rintro x (rfl | ⟨d, -, rfl⟩)
      exacts [ENNReal.toReal_nonneg, (hGK d (mem_univ d)).2]⟩
  -- (α) `G(d) ≤ G̃(t)` if `d < t`; (β) `G̃(t) ≤ G(d)` if `t < d`
  have hα : ∀ d t, (d.1 : ℝ) < t → G d ≤ Gt t := fun d t h => by
    rw [hGt]
    exact le_csSup (hbdd t) (mem_insert_of_mem _ ⟨d, h, rfl⟩)
  have hβ : ∀ d t, t < (d.1 : ℝ) → Gt t ≤ G d := fun d t h => by
    rw [hGt]
    refine csSup_le (insert_nonempty _ _) ?_
    rintro x (rfl | ⟨d', hd', rfl⟩)
    exacts [(hGK d (mem_univ d)).1, hGmono d' d (lt_trans hd' h).le]
  have hmono : Monotone Gt := fun t t' h => by
    rw [hGt, hGt]
    exact csSup_le_csSup (hbdd t') (insert_nonempty _ _)
      (insert_subset_insert (image_mono fun d hd => lt_of_lt_of_le hd h))
  -- `N` is the countable set of discontinuities of the monotone `G̃`
  refine ⟨φ, {t | ¬ContinuousAt Gt t}, hφ, hmono.countable_not_continuousAt, ?_⟩
  intro s hs hsN ε hε
  have hcont : ContinuousAt Gt s := by
    by_contra h
    exact hsN h
  rcases eq_or_ne ε ∞ with rfl | hε'
  · exact ⟨1, one_pos, Eventually.of_forall fun _ => le_top⟩
  have he : 0 < ε.toReal := ENNReal.toReal_pos hε.ne' hε'
  obtain ⟨η₀, hη₀, hcη⟩ := Metric.continuousAt_iff.1 hcont (ε.toReal / 2) (half_pos he)
  -- `δ = η = min (η₀ / 3, (s - a) / 3, (b - s) / 2)`
  obtain ⟨hsa, hsb⟩ := hs
  set η := min (η₀ / 3) (min ((s - a) / 3) ((b - s) / 2))
  have h1 : η ≤ η₀ / 3 := min_le_left _ _
  have h2 : η ≤ (s - a) / 3 := (min_le_right _ _).trans (min_le_left _ _)
  have h3 : η ≤ (b - s) / 2 := (min_le_right _ _).trans (min_le_right _ _)
  have hη : 0 < η := lt_min (by linarith) (lt_min (by linarith) (by linarith))
  -- rationals `d₁ ∈ (s - 2η, s - η)` and `d₂ ∈ (s, s + η)`, both in `(a, b)`
  obtain ⟨q₁, hq₁, hq₁'⟩ := exists_rat_btwn (show s - 2 * η < s - η by linarith)
  obtain ⟨q₂, hq₂, hq₂'⟩ := exists_rat_btwn (show s < s + η by linarith)
  have hd₁ : (q₁ : ℝ) ∈ Ioo a b := ⟨by linarith, by linarith⟩
  have hd₂ : (q₂ : ℝ) ∈ Ioo a b := ⟨by linarith, by linarith⟩
  -- `G(d₂) - G(d₁) ≤ G̃(s + η) - G̃(s - 2η) < ε`
  have hup := @hcη (s + η) (by rw [Real.dist_eq, abs_lt]; constructor <;> linarith)
  have hdown := @hcη (s - 2 * η) (by rw [Real.dist_eq, abs_lt]; constructor <;> linarith)
  rw [Real.dist_eq, abs_lt] at hup hdown
  have hlt : G ⟨q₂, hd₂⟩ - G ⟨q₁, hd₁⟩ < ε.toReal := by
    have := hα ⟨q₂, hd₂⟩ (s + η) hq₂'
    have := hβ ⟨q₁, hd₁⟩ (s - 2 * η) hq₁
    linarith [hup.2, hdown.1]
  -- `μ_{φ j}([s - η, s]) ≤ μ_{φ j}([a, d₂] \ [a, d₁])`, which tends to `G(d₂) - G(d₁) < ε`
  refine ⟨η, hη, (((hGd ⟨q₂, hd₂⟩).sub (hGd ⟨q₁, hd₁⟩)).eventually_lt_const hlt).mono
    fun j hj => ?_⟩
  have hsub : Icc (s - η) s ⊆ Icc a (q₂ : ℝ) \ Icc a (q₁ : ℝ) := by
    rintro x ⟨hx1, hx2⟩
    exact ⟨⟨by linarith, by linarith⟩, fun hx => by linarith [hx.2]⟩
  calc μ (φ j) (Icc (s - η) s) ≤ μ (φ j) (Icc a (q₂ : ℝ) \ Icc a (q₁ : ℝ)) := measure_mono hsub
    _ = μ (φ j) (Icc a (q₂ : ℝ)) - μ (φ j) (Icc a (q₁ : ℝ)) :=
      measure_sdiff (Icc_subset_Icc_right (by linarith)) measurableSet_Icc.nullMeasurableSet
        (hfin _ _ hd₁.2.le)
    _ = ENNReal.ofReal ((μ (φ j) (Icc a (q₂ : ℝ))).toReal - (μ (φ j) (Icc a (q₁ : ℝ))).toReal) := by
      rw [ENNReal.ofReal_sub _ ENNReal.toReal_nonneg, ENNReal.ofReal_toReal (hfin _ _ hd₂.2.le),
        ENNReal.ofReal_toReal (hfin _ _ hd₁.2.le)]
    _ ≤ ENNReal.ofReal ε.toReal := ENNReal.ofReal_le_ofReal hj.le
    _ = ε := ENNReal.ofReal_toReal hε'
/-- **Simon 7.2.4, proof** (choice of a good slice; Tonelli for the sliding window): for an
s-finite measure `ν` on `ℝ` and `h ∈ ℝ`, `t ↦ ν((t − h, t))` is measurable and
`∫ ν((t − h, t)) dt = h₊ · ν(ℝ)`, where `h₊ = max h 0`.  The set
`E = {(t, x) : t − h < x < t}` is measurable, its `t`-sections are `(t − h, t)` and its
`x`-sections are `(x, x + h)`; computing `(L¹ ⊗ ν)(E)` in both orders gives the identity. -/
theorem Submission.cmc_fc_gs_aqf_window_lintegral : ∀ (ν : Measure ℝ) [SFinite ν] (h : ℝ), Measurable (fun t : ℝ => ν (Ioo (t - h) t)) ∧ ∫⁻ t, ν (Ioo (t - h) t) ∂volume = ENNReal.ofReal h * ν univ := by
  intro ν _ h
  -- the window set `E = {(t, x) : t - h < x < t}` and its two families of sections
  set E : Set (ℝ × ℝ) := {p | p.1 - h < p.2} ∩ {p | p.2 < p.1} with hE
  have hEm : MeasurableSet E :=
    (measurableSet_lt (measurable_fst.sub_const h) measurable_snd).inter
      (measurableSet_lt measurable_snd measurable_fst)
  have hsec : ∀ t : ℝ, Prod.mk t ⁻¹' E = Ioo (t - h) t := fun t => rfl
  have hsec' : ∀ x : ℝ, (fun t => (t, x)) ⁻¹' E = Ioo x (x + h) := by
    intro x
    ext t
    simp only [hE, mem_preimage, mem_inter_iff, mem_ofPred_eq, mem_Ioo]
    constructor <;> rintro ⟨h₁, h₂⟩ <;> constructor <;> linarith
  refine ⟨?_, ?_⟩
  · simpa only [hsec] using measurable_measure_prodMk_left (ν := ν) hEm
  · -- Tonelli in both orders for `L¹ ⊗ ν` on `E`, then `L¹((x, x + h)) = h₊`
    calc ∫⁻ t, ν (Ioo (t - h) t) ∂volume = (volume.prod ν) E := by
          rw [Measure.prod_apply hEm]
          simp only [hsec]
      _ = ∫⁻ x, volume (Ioo x (x + h)) ∂ν := by
          rw [Measure.prod_apply_symm hEm]
          simp only [hsec']
      _ = ENNReal.ofReal h * ν univ := by
          simp only [Real.volume_Ioo, add_sub_cancel_left, lintegral_const]

/-- **Double Fatou for left window quotients.**  If `ν_j(ℝ) ≤ Λ < ∞` for all `j`, then for
a.e. `t`, `liminf_j liminf_n Q_{j,n}(t) < ∞`, where `Q_{j,n}(t) = (n + 1) ν_j((t - 1/(n+1), t))`.
By the window lemma `∫⁻ Q_{j,n} = (n + 1) · (1/(n+1)) · ν_j(ℝ) = ν_j(ℝ) ≤ Λ`; Fatou's lemma in
`n` and then in `j` bounds the integral of the iterated `liminf` by `Λ`, and a measurable
`[0, ∞]`-valued function with finite integral is finite a.e. -/
theorem Submission.cmc_fc_gs_aqf_ae_seq_liminf_finite : ∀ (ν : ℕ → Measure ℝ) (Λ : ℝ≥0∞), Λ ≠ ∞ → (∀ j, ν j univ ≤ Λ) → ∀ᵐ t ∂(volume : Measure ℝ), liminf (fun j => liminf (fun n : ℕ => ((n : ℝ≥0∞) + 1) * ν j (Ioo (t - 1 / ((n : ℝ) + 1)) t)) atTop) atTop ≠ ∞ := by
  intro ν Λ hΛ hν
  -- each `ν j` has total mass at most `Λ < ∞`, so it is finite (hence s-finite)
  have hfin : ∀ j, IsFiniteMeasure (ν j) := fun j => ⟨(hν j).trans_lt hΛ.lt_top⟩
  -- the window quotients `Q j n t = (n + 1) ν_j((t - 1/(n+1), t))` are measurable
  set Q : ℕ → ℕ → ℝ → ℝ≥0∞ := fun j n t =>
    ((n : ℝ≥0∞) + 1) * ν j (Ioo (t - 1 / ((n : ℝ) + 1)) t)
  have hQm : ∀ j n, Measurable (Q j n) := fun j n =>
    (Submission.cmc_fc_gs_aqf_window_lintegral (ν j) (1 / ((n : ℝ) + 1))).1.const_mul _
  -- `(n + 1) · ofReal (1/(n+1)) = 1`
  have hnorm : ∀ n : ℕ, ((n : ℝ≥0∞) + 1) * ENNReal.ofReal (1 / ((n : ℝ) + 1)) = 1 := by
    intro n
    have hpos : (0 : ℝ) < (n : ℝ) + 1 := by positivity
    rw [one_div, ENNReal.ofReal_inv_of_pos hpos, ENNReal.ofReal_add n.cast_nonneg zero_le_one,
      ENNReal.ofReal_natCast, ENNReal.ofReal_one]
    exact ENNReal.mul_inv_cancel (by simp) (by simp)
  -- `∫⁻ Q j n = ν_j(ℝ)` by the window lemma
  have hQint : ∀ j n, ∫⁻ t, Q j n t = ν j univ := by
    intro j n
    obtain ⟨hm, hint⟩ := Submission.cmc_fc_gs_aqf_window_lintegral (ν j) (1 / ((n : ℝ) + 1))
    show ∫⁻ t, ((n : ℝ≥0∞) + 1) * ν j (Ioo (t - 1 / ((n : ℝ) + 1)) t) = ν j univ
    rw [lintegral_const_mul _ hm, hint, ← mul_assoc, hnorm, one_mul]
  -- first Fatou: `∫⁻ liminf_n Q j n ≤ liminf_n ν_j(ℝ) = ν_j(ℝ) ≤ Λ`
  have hqm : ∀ j, Measurable fun t => liminf (fun n => Q j n t) atTop :=
    fun j => Measurable.liminf (hQm j)
  have hqint : ∀ j, ∫⁻ t, liminf (fun n => Q j n t) atTop ≤ Λ := by
    intro j
    calc ∫⁻ t, liminf (fun n => Q j n t) atTop
        ≤ liminf (fun n => ∫⁻ t, Q j n t) atTop := lintegral_liminf_le (hQm j)
      _ = ν j univ := by simp_rw [hQint j]; exact liminf_const _
      _ ≤ Λ := hν j
  -- second Fatou: `∫⁻ liminf_j liminf_n Q j n ≤ liminf_j Λ = Λ`
  have hFm : Measurable fun t => liminf (fun j => liminf (fun n => Q j n t) atTop) atTop :=
    Measurable.liminf hqm
  have hFint : ∫⁻ t, liminf (fun j => liminf (fun n => Q j n t) atTop) atTop ≤ Λ :=
    calc ∫⁻ t, liminf (fun j => liminf (fun n => Q j n t) atTop) atTop
        ≤ liminf (fun j => ∫⁻ t, liminf (fun n => Q j n t) atTop) atTop := lintegral_liminf_le hqm
      _ ≤ liminf (fun _ : ℕ => Λ) atTop := liminf_le_liminf (Eventually.of_forall hqint)
      _ = Λ := liminf_const Λ
  -- a measurable function with finite integral is finite a.e.
  filter_upwards [ae_lt_top hFm (ne_top_of_le_ne_top hΛ hFint)] with t ht
  exact ht.ne
/-- **Simon 7.2.4, good slices** (comparison of difference quotients): for `a < t < b`,
`liminf_{h ↓ 0} h⁻¹ μ((t − h, t)) ≤ liminf_n (n + 1) (μ⌞[a, b])((t − 1/(n + 1), t))`.  Along
`hₙ = 1/(n + 1) → 0⁺` the liminf can only grow; once `hₙ < t − a` the window `(t − hₙ, t)` lies in
`[a, b]`, where `μ⌞[a, b]` agrees with `μ`, and `ofReal hₙ⁻¹ = n + 1`. -/
theorem Submission.cmc_fc_gs_aqf_liminf_le_seq : ∀ (μ : Measure ℝ) (a b t : ℝ), t ∈ Ioo a b → liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (Ioo (t - h) t)) (𝓝[>] 0) ≤ liminf (fun n : ℕ => ((n : ℝ≥0∞) + 1) * (μ.restrict (Icc a b)) (Ioo (t - 1 / ((n : ℝ) + 1)) t)) atTop := by
  intro μ a b t ht
  -- `hₙ = 1/(n + 1) → 0` through positive values
  have hv : Tendsto (fun n : ℕ => 1 / ((n : ℝ) + 1)) atTop (𝓝[>] 0) :=
    tendsto_nhdsWithin_iff.2 ⟨tendsto_one_div_add_atTop_nhds_zero_nat,
      Eventually.of_forall fun n => Set.mem_Ioi.2 (by positivity)⟩
  refine (hv.liminf_le_liminf_comp
    (u := fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (Ioo (t - h) t))).trans_eq (liminf_congr ?_)
  -- eventually `hₙ < t − a`, so the window lies in `[a, b]`
  filter_upwards [(tendsto_order.1 (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ))).2 _
    (sub_pos.2 ht.1)] with n hn
  have hsub : Ioo (t - 1 / ((n : ℝ) + 1)) t ⊆ Icc a b := fun x hx =>
    ⟨by linarith [hx.1], by linarith [hx.2, ht.2]⟩
  simp only [Function.comp_apply]
  rw [Measure.restrict_apply measurableSet_Ioo, Set.inter_eq_left.2 hsub, one_div, inv_inv,
    ENNReal.ofReal_add (Nat.cast_nonneg n) zero_le_one, ENNReal.ofReal_natCast, ENNReal.ofReal_one]

/-- Lower left difference quotients have a.e. finite `liminf` over `j` (the Fatou/Tonelli
ingredient of the choice of the slicing level in the proof of Simon 6.7.2, "an argument as in
6.7(2) of Ch. 2"): if `μⱼ([a, b]) ≤ Λ < ∞`, then for a.e. `t ∈ (a, b)`,
`liminf_j liminf_{h ↓ 0} h⁻¹ μⱼ((t - h, t)) < ∞`.  For `νⱼ = μⱼ⌞[a, b]`, so `νⱼ(ℝ) ≤ Λ`, Tonelli
and Fatou (twice) make the iterated `liminf` of `(n + 1) νⱼ((t - 1/(n + 1), t))` finite off a null
set, and for `t ∈ (a, b)` it bounds the `liminf` along `h ↓ 0` for every `j`. -/
theorem Submission.cmc_fc_gs_ae_quotient_finite : ∀ (μ : ℕ → Measure ℝ) (a b : ℝ) (Λ : ℝ≥0∞), Λ ≠ ∞ → (∀ j, μ j (Icc a b) ≤ Λ) → ∀ᵐ t ∂(volume : Measure ℝ), t ∈ Ioo a b → liminf (fun j => liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ j (Ioo (t - h) t)) (𝓝[>] 0)) atTop ≠ ∞ := by
  intro μ a b Λ hΛ hμ
  -- `νⱼ = μⱼ⌞[a, b]` has `νⱼ(ℝ) = μⱼ([a, b]) ≤ Λ`, so off a null set the iterated `liminf` of its
  -- sequential quotients is finite
  filter_upwards [Submission.cmc_fc_gs_aqf_ae_seq_liminf_finite (fun j => (μ j).restrict (Icc a b))
    Λ hΛ fun j => (Measure.restrict_apply_univ _).trans_le (hμ j)] with t ht hat
  -- for `t ∈ (a, b)` and every `j`, the `liminf` along `h ↓ 0` is at most that of `νⱼ`
  exact ne_top_of_le_ne_top ht <| liminf_le_liminf <| Eventually.of_forall fun j =>
    Submission.cmc_fc_gs_aqf_liminf_le_seq (μ j) a b t hat

/-- **Choice of a good slicing level** (Simon Ch. 6, proof of Theorem 7.2, chapter-06.txt
line 2090: "by 4.5(1),(2) and an argument as in 6.7(2) of Ch. 2").  If `μⱼ([a, b]) ≤ Λ < ∞`,
there are `s ∈ (a, b)`, a subsequence `φ` and `C < ∞` such that every lower left difference
quotient `liminf_{h↓0} h⁻¹ μ_{φ(j)}((s − h, s))` is `≤ C` and, for every `ε > 0`, eventually
`μ_{φ(j)}([s − δ, s]) ≤ ε` for some `δ > 0`.  Helly selection gives `φ₁` and a countable set `N`
off which no mass concentrates from the left along `φ₁`; Tonelli and Fatou, applied to
`μ ∘ φ₁`, give `L(t) := liminf_j liminf_{h↓0} h⁻¹ μ_{φ₁(j)}((t − h, t)) < ∞` for a.e.
`t ∈ (a, b)`.  As `(a, b)` has positive Lebesgue measure and `N` is null, some `s ∈ (a, b) ∖ N`
has `L(s) < ∞`; the quotients at `s` are `< L(s) + 1 =: C` for infinitely many `j`, which gives
a second extraction `φ₂`, and `φ := φ₁ ∘ φ₂`. -/
theorem Submission.cmc_fc_good_slice : ∀ (μ : ℕ → Measure ℝ) (a b : ℝ) (Λ : ℝ≥0∞), a < b → Λ ≠ ∞ → (∀ j, μ j (Icc a b) ≤ Λ) → ∃ (s : ℝ) (φ : ℕ → ℕ) (C : ℝ≥0∞), a < s ∧ s < b ∧ StrictMono φ ∧ C ≠ ∞ ∧ (∀ j, liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (φ j) (Ioo (s - h) s)) (𝓝[>] 0) ≤ C) ∧ ∀ ε : ℝ≥0∞, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ᶠ j in atTop, μ (φ j) (Icc (s - δ) s) ≤ ε := by
  intro μ a b Λ hab hΛ hμ
  -- Steps 1–3: Helly selection; off the countable set `N` no mass concentrates along `φ₁`
  obtain ⟨φ₁, N, hφ₁, hN, hconc⟩ := Submission.cmc_fc_gs_helly_no_concentration μ a b Λ hΛ hμ
  -- Step 4: Tonelli and Fatou for the subsequence `μ ∘ φ₁`, which is still bounded by `Λ`
  have hfin := Submission.cmc_fc_gs_ae_quotient_finite (fun j => μ (φ₁ j)) a b Λ hΛ
    fun j => hμ (φ₁ j)
  -- Step 5: `(a, b)` is not Lebesgue-null and `N` is, so a good level `s ∈ (a, b) ∖ N` exists
  have hab' : volume (Ioo a b) ≠ 0 := by
    rw [Real.volume_Ioo]
    exact (ENNReal.ofReal_pos.2 (sub_pos.2 hab)).ne'
  have := ae_restrict_neBot.2 hab'
  obtain ⟨s, hs, hsN, hL⟩ := ((ae_restrict_mem (s := Ioo a b) measurableSet_Ioo).and
    (ae_restrict_of_ae ((hN.ae_notMem volume).and hfin))).exists
  -- Step 6: the quotients at `s` are `< L + 1` infinitely often; extract `φ₂` along them
  obtain ⟨φ₂, hφ₂, hlt⟩ := extraction_of_frequently_atTop
    (frequently_lt_of_liminf_lt (by isBoundedDefault) (ENNReal.lt_add_right (hL hs) one_ne_zero))
  refine ⟨s, φ₁ ∘ φ₂, _, hs.1, hs.2, hφ₁.comp hφ₂,
    ENNReal.add_ne_top.2 ⟨hL hs, ENNReal.one_ne_top⟩, fun k => (hlt k).le, fun ε hε => ?_⟩
  -- Steps 7–8: the `δ` of Helly selection works along `φ₁ ∘ φ₂`, since `φ₂ → ∞`
  obtain ⟨δ, hδ, hev⟩ := hconc s hs hsN ε hε
  exact ⟨δ, hδ, hφ₂.tendsto_atTop.eventually hev⟩
/-- **Radial slicing bound** (Simon Ch. 6, 4.9–4.11 for `f(y) = |y|`, chapter-06.txt
lines 1335–1403, with the a.e. differentiation of 4.10 replaced by Tonelli and Fatou).  If
`S = τ(M, θ, ξ)`, `B̄_R(0) ⊆ U` and `∂S = 0` in `B_R(0)`, then some `t ∈ (R/4, R/2)` and `σ`
satisfy `|∫_{M ∩ B_t(0)} θ⟨dβ, ξ⟩ dHⁿ| ≤ σ s` for every `β ∈ 𝒟ᵐ(ℝᴾ)` with `|β| ≤ s`.  With
`μ = θ Hⁿ⌞M`, `μ(B̄_{R/2}(0)) < ∞`, so the radial image `ν = |·|_# μ` has `ν([R/4, R/2]) < ∞` and
`cmc_fc_good_slice` (for the constant sequence `ν`) gives `t ∈ (R/4, R/2)` and `C < ∞` with
`liminf_{h↓0} h⁻¹ μ({t − h < |x| < t}) ≤ C`.  As `t < R`, `dtc_bc_tc_rs_radius_bound` bounds the
truncated integral by `s C`; take `σ = C`. -/
theorem Submission.dtc_bc_tc_radial_slice_bound : ∀ (P m : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U (m + 1)) (Rp : IMRep U (m + 1)) (R : ℝ), IsOpen U → 0 < R → closedBall (0 : Euclid P) R ⊆ U → Rp.Represents S → (∀ ω : TestFormOn U m, tsupport (ω : DifferentialForm (Euclid P) m) ⊆ ball 0 R → S.boundary ω = 0) → ∃ t σ : ℝ, R / 4 < t ∧ t < R / 2 ∧ ∀ (β : TestFormOn (univ : Set (Euclid P)) m) (s : ℝ), (∀ x, covectorEuclideanNorm ((β : DifferentialForm (Euclid P) m) x) ≤ s) → |∫ x in Rp.carrier ∩ ball 0 t, (Rp.mult x : ℝ) * Rp.orient x (exteriorDerivative (β : DifferentialForm (Euclid P) m) x) ∂μHE[m + 1]| ≤ σ * s := by
  intro P m U S Rp R _hU hR hRU hrep hbd
  -- `μ(B̄_{R/2}(0)) = ∫_{M ∩ B̄_{R/2}(0)} θ dHⁿ < ∞`, `B̄_{R/2}(0)` being a compact subset of `U`
  have hfin : Rp.measure (closedBall (0 : Euclid P) (R / 2)) ≠ ∞ := by
    rw [IMRep.measure, withDensity_apply _ measurableSet_closedBall,
      Measure.restrict_restrict measurableSet_closedBall, inter_comm]
    exact Rp.locallyIntegrable_mult _ (isCompact_closedBall 0 (R / 2))
      ((closedBall_subset_closedBall (by linarith)).trans hRU)
  -- the radial image `ν = |·|_# μ`: `ν((t − h, t)) = μ({t − h < |x| < t})` and
  -- `ν([R/4, R/2]) ≤ μ(B̄_{R/2}(0))`
  have hνIoo : ∀ t h : ℝ, Rp.measure.map (fun x : Euclid P => ‖x‖) (Ioo (t - h) t) =
      Rp.measure {x : Euclid P | t - h < ‖x‖ ∧ ‖x‖ < t} :=
    fun t h => Measure.map_apply measurable_norm measurableSet_Ioo
  have hνIcc : Rp.measure.map (fun x : Euclid P => ‖x‖) (Icc (R / 4) (R / 2)) ≤
      Rp.measure (closedBall (0 : Euclid P) (R / 2)) := by
    rw [Measure.map_apply measurable_norm measurableSet_Icc]
    exact measure_mono fun x hx => mem_closedBall_zero_iff.2 hx.2
  -- a good radius `t ∈ (R/4, R/2)`: `liminf_{h↓0} h⁻¹ μ({t − h < |x| < t}) ≤ C < ∞`
  obtain ⟨t, _φ, C, hat, htb, -, hC, hlim, -⟩ := Submission.cmc_fc_good_slice
    (fun _ => Rp.measure.map (fun x : Euclid P => ‖x‖)) (R / 4) (R / 2) _ (by linarith) hfin
    fun _ => hνIcc
  have hliminf : liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ *
      Rp.measure {x : Euclid P | t - h < ‖x‖ ∧ ‖x‖ < t}) (𝓝[>] 0) ≤ C := by
    simpa only [hνIoo] using hlim 0
  -- `σ = C`: as `t < R`, the bound at the fixed radius `t` gives `|I_t(β)| ≤ s C`
  refine ⟨t, C.toReal, hat, htb, fun β s hs => ?_⟩
  have hs0 : 0 ≤ s := (covectorEuclideanNorm_nonneg _).trans (hs 0)
  rw [← ENNReal.ofReal_le_ofReal_iff (mul_nonneg ENNReal.toReal_nonneg hs0),
    ENNReal.ofReal_mul ENNReal.toReal_nonneg, ENNReal.ofReal_toReal hC, mul_comm C]
  calc _ ≤ _ := Submission.dtc_bc_tc_rs_radius_bound P m U S Rp R t hRU hrep hbd
        (by linarith) β s hs
    _ ≤ ENNReal.ofReal s * C := by gcongr
/-- Deleting from the Borel set `M` a set that is `Hⁿ`-null near `x` keeps the approximate
tangent space of `M` at `x` (Simon Ch. 3, 1.4): if `M' ⊆ M` and `Hⁿ((M ∖ M') ∩ B_δ(x)) = 0`, then
`TₓM = Q` gives `TₓM' = Q`.  Choose `R₀ > 0` with `spt f ⊆ B̄_{R₀}(0)`.  For
`0 < λ < δ/(R₀ + 1)`, a point `z = η_{x,λ}(y)` of `η_{x,λ}(M) ∖ η_{x,λ}(M')` with `f(z) ≠ 0` has
`y ∈ M ∖ M'` and `|y − x| = λ|z| ≤ λR₀ < δ`, so it lies in `η_{x,λ}((M ∖ M') ∩ B_δ(x))`, which is
`Hⁿ`-null by `rsd_cmr_ir_blowUp_image_measure`.  Hence `f = 0` a.e. on
`η_{x,λ}(M) ∖ η_{x,λ}(M')`, and the Borel set `η_{x,λ}(M)` and its subset `η_{x,λ}(M')` carry the
same integral of `f` for all small `λ` (as in the proof of 1.6 "⇒"). -/
theorem Submission.rsd_cmr_ir_approxTangent_of_local_null : ∀ (P n : ℕ) (M M' : Set (Euclid P)) (x : Euclid P) (δ : ℝ) (Q : Submodule ℝ (Euclid P)), MeasurableSet M → M' ⊆ M → 0 < δ → μHE[n] ((M \ M') ∩ ball x δ) = 0 → HasApproximateTangentSpaceAt n M x Q → HasApproximateTangentSpaceAt n M' x Q := by
  intro P n M M' x δ Q hM hM'M hδ hnull hT
  refine ⟨hT.1, fun f => ?_⟩
  -- `spt f ⊆ B̄_{R₀}(0)` with `R₀ > 0`
  obtain ⟨R₀, hR₀, hfR₀⟩ := f.hasCompactSupport.isCompact.isBounded.subset_closedBall_lt 0 0
  have hR₀' : (0 : ℝ) < R₀ + 1 := by linarith
  refine (hT.2 f).congr' ?_
  filter_upwards [Ioo_mem_nhdsGT (div_pos hδ hR₀')] with r hr
  have hr0 : r ≠ 0 := hr.1.ne'
  -- `Z_λ = η_{x,λ}((M ∖ M') ∩ B_δ(x))` is `Hⁿ`-null
  have hZ : μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' ((M \ M') ∩ ball x δ)) = 0 := by
    rw [Submission.rsd_cmr_ir_blowUp_image_measure P n x r _ hr.1, hnull, mul_zero]
  -- `η_{x,λ}(y) = λ⁻¹ • (y − x)`
  have hη : Poincare.SimonGMT.Chapter03.blowUpMap x r = fun y => r⁻¹ • (y - x) := rfl
  rw [hη] at hZ ⊢
  -- `η_{x,λ}(M)` is Borel: it is the preimage of `M` under `z ↦ x + λ • z`
  have hmeas : MeasurableSet ((fun y => r⁻¹ • (y - x)) '' M) := by
    have himg : (fun y => r⁻¹ • (y - x)) '' M = (fun z => x + r • z) ⁻¹' M := by
      ext z
      constructor
      · rintro ⟨y, hy, rfl⟩
        simpa [smul_smul, mul_inv_cancel₀ hr0] using hy
      · intro hz
        exact ⟨x + r • z, hz, by simp [smul_smul, inv_mul_cancel₀ hr0]⟩
    rw [himg]
    exact hM.preimage (by fun_prop)
  -- `f` vanishes on `η_{x,λ}(M) ∖ η_{x,λ}(M')` off `Z_λ`, hence a.e. there
  refine setIntegral_eq_of_subset_of_ae_sdiff_eq_zero hmeas.nullMeasurableSet
    (image_mono hM'M) ?_
  filter_upwards [measure_eq_zero_iff_ae_notMem.mp hZ] with z hzZ hz
  obtain ⟨⟨y, hyM, rfl⟩, hyM'⟩ := hz
  apply image_eq_zero_of_notMem_tsupport
  intro hyf
  apply hzZ
  refine ⟨y, ⟨⟨hyM, fun h => hyM' ⟨y, h, rfl⟩⟩, ?_⟩, rfl⟩
  -- `|y − x| = λ|η_{x,λ}(y)| ≤ λR₀ < λ(R₀ + 1) < δ`
  have h1 : ‖r⁻¹ • (y - x)‖ ≤ R₀ := mem_closedBall_zero_iff.mp (hfR₀ hyf)
  rw [norm_smul, norm_inv, Real.norm_of_nonneg hr.1.le, inv_mul_le_iff₀ hr.1] at h1
  have h2 := (lt_div_iff₀ hR₀').mp hr.2
  rw [mem_ball, dist_eq_norm]
  linarith [hr.1]

/-- **Restricting an integer multiplicity triple to a locally full-measure subset.**  If
`R = (M, θ, ξ)` is an integer multiplicity triple in `U` and `A` is Borel, then `(M ∩ A, θ', ξ)` is
one in `U'` provided `M ∩ A ⊆ U'`, `θ'` is measurable, positive on `M ∩ A` and locally integrable
on `M ∩ A` in `U'`, and `Hⁿ`-a.e. `x ∈ M ∩ A` has a ball `B_δ(x)` with `Hⁿ((M \ A) ∩ B_δ(x)) = 0`.
This is used for `(M ∩ B, 1, ξ)`, `B` open, and for `(M_X ∩ K, θ_X, ξ_X)` in the constant
multiplicity reduction behind Simon 7.4.2 (via Ch. 5, Corollary 7.3).  All fields but the
orientation pass from `R` to the subset `M ∩ A ⊆ M`; at such `x`, `T_x(M ∩ A) = T_xM`
(Simon Ch. 3, Definition 1.4, chapter-03.txt lines 77–84) by
`Submission.rsd_cmr_ir_approxTangent_of_local_null`, since `M \ (M ∩ A) = M \ A`. -/
theorem Submission.rsd_cmr_imrep_restrict : ∀ (P n : ℕ) (U U' A : Set (Euclid P)) (R : IMRep U n) (θ : Euclid P → ℕ), MeasurableSet A → R.carrier ∩ A ⊆ U' → Measurable θ → (∀ x ∈ R.carrier ∩ A, 0 < θ x) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U' → ∫⁻ x in R.carrier ∩ A ∩ K, (θ x : ℝ≥0∞) ∂μHE[n] ≠ ∞) → (∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ A)), ∃ δ : ℝ, 0 < δ ∧ μHE[n] ((R.carrier \ A) ∩ ball x δ) = 0) → ∃ R' : IMRep U' n, R'.carrier = R.carrier ∩ A ∧ R'.mult = θ ∧ R'.orient = R.orient := by
  intro P n U U' A R θ hA hsub hθ hθpos hθint hlocal
  refine ⟨{ carrier := R.carrier ∩ A
            mult := θ
            orient := R.orient
            measurableSet_carrier := R.measurableSet_carrier.inter hA
            carrier_subset := hsub
            rectifiable := R.rectifiable.mono inter_subset_left
            measurable_mult := hθ
            mult_pos := hθpos
            locallyIntegrable_mult := hθint
            aestronglyMeasurable_orient :=
              R.aestronglyMeasurable_orient.mono_set inter_subset_left
            orients := ?_ }, rfl, rfl, rfl⟩
  -- `Hⁿ⌞(M ∩ A)`-a.e. `x` has `T_xM = Q` oriented by `ξ(x)` (from `Hⁿ⌞M`-a.e., `M ∩ A ⊆ M`) and
  -- a ball `B_δ(x)` on which `M \ (M ∩ A) = M \ A` is `Hⁿ`-null, so `T_x(M ∩ A) = Q`.
  filter_upwards [ae_restrict_of_ae_restrict_of_subset inter_subset_left R.orients, hlocal]
    with x ⟨Q, hQ, hξ⟩ ⟨δ, hδ, hnull⟩
  refine ⟨Q, Submission.rsd_cmr_ir_approxTangent_of_local_null P n R.carrier (R.carrier ∩ A) x δ Q
    R.measurableSet_carrier inter_subset_left hδ ?_ hQ, hξ⟩
  rwa [Set.sdiff_self_inter]
/-- **Truncation at a good slicing radius** (Simon Ch. 6, 2.7–2.9 and 3.1; the truncation step of
the blow-up compactness argument for Simon 7.3.1(2)).  Let `S = τ(M, θ, ξ)` be integer multiplicity
in `U`, `B̄_R(0) ⊆ U`, with `∂S = 0` in `B_R(0)`.  `dtc_bc_tc_radial_slice_bound` gives
`ρ ∈ (R/4, R/2)` and `σ` with `|∫_{M ∩ B_ρ(0)} θ ⟨dβ, ξ⟩ dHⁿ| ≤ σ sup |β|` for `β ∈ 𝒟ᵐ(ℝᴾ)`.  The
truncation `Ŝ = S⌞B_ρ(0) = τ(M ∩ B_ρ(0), θ, ξ)` is an integer multiplicity current in `ℝᴾ`
(`rsd_cmr_imrep_restrict`, `dtc_imrep_current`).  It agrees with `S` on forms supported in
`B_ρ(0)`, the integrand vanishing on `M \ B_ρ(0)`, so `∂Ŝ(β) = S(dβ) = ∂S(β) = 0` there.  By
`cmc_massOn_eq_imRep_measure`, `M_O(Ŝ) = μ_Ŝ(O) ≤ μ_S(O) = M_O(S)` for open `O` and
`M(Ŝ) ≤ ∫_{M ∩ B̄_R(0)} θ dHⁿ < ∞`; the slicing bound with `sup |β| ≤ 1` gives `M(∂Ŝ) ≤ σ`. -/
theorem Submission.dtc_bc_tc_truncation : ∀ (P m : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U (m + 1)) (R : ℝ), IsOpen U → 0 < R → closedBall (0 : Euclid P) R ⊆ U → IsIntegerMultiplicity S → (∀ ω : TestFormOn U m, tsupport (ω : DifferentialForm (Euclid P) m) ⊆ ball 0 R → S.boundary ω = 0) → ∃ (ρ : ℝ) (Ŝ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), R / 4 < ρ ∧ ρ < R / 2 ∧ IsIntegerMultiplicity Ŝ ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ ball 0 ρ → Ŝ ω = currentEval S (ω : DifferentialForm (Euclid P) (m + 1))) ∧ (∀ β : TestFormOn (univ : Set (Euclid P)) m, tsupport (β : DifferentialForm (Euclid P) m) ⊆ ball 0 ρ → Ŝ.boundary β = 0) ∧ (∀ O : Set (Euclid P), IsOpen O → Ŝ.massOn O ≤ S.massOn O) ∧ Ŝ.mass < ∞ ∧ Ŝ.boundary.mass < ∞ := by
  intro P m U S R hU hR hRU hS hbd
  -- (1) a representation `S = τ(M, θ, ξ)` in `U`
  obtain ⟨Rp, hRp⟩ := hS
  -- (2) a good radius `ρ = t ∈ (R/4, R/2)` with the slicing bound
  obtain ⟨t, σ, ht1, ht2, hσ⟩ :=
    Submission.dtc_bc_tc_radial_slice_bound P m U S Rp R hU hR hRU hRp hbd
  have htR : ball (0 : Euclid P) t ⊆ closedBall 0 R :=
    ball_subset_closedBall.trans (closedBall_subset_closedBall (by linarith))
  have htU : ball (0 : Euclid P) t ⊆ U := htR.trans hRU
  -- `∫_{M ∩ B̄_R(0)} θ dHⁿ < ∞`, as `B̄_R(0) ⊆ U` is compact
  have hfin : ∫⁻ x in Rp.carrier ∩ closedBall 0 R, (Rp.mult x : ℝ≥0∞) ∂μHE[m + 1] ≠ ∞ :=
    Rp.locallyIntegrable_mult _ (isCompact_closedBall 0 R) hRU
  -- (3) `R̂ = (M ∩ B_t(0), θ, ξ)` is a triple in `ℝᴾ`: every `x ∈ M ∩ B_t(0)` has
  -- `B_{t - |x|}(x) ⊆ B_t(0)`, a ball missing `M \ B_t(0)`
  obtain ⟨Rh, hRhc, hRhm, hRho⟩ := Submission.rsd_cmr_imrep_restrict P (m + 1) U univ
    (ball 0 t) Rp Rp.mult measurableSet_ball (subset_univ _) Rp.measurable_mult
    (fun x hx => Rp.mult_pos x hx.1)
    (fun K _ _ => ne_top_of_le_ne_top hfin
      (lintegral_mono_set fun x hx => ⟨hx.1.1, htR hx.1.2⟩))
    (ae_restrict_of_forall_mem (Rp.measurableSet_carrier.inter measurableSet_ball)
      fun x hx => ⟨t - ‖x‖, sub_pos.mpr (mem_ball_zero_iff.mp hx.2),
        measure_mono_null (fun y hy => absurd
          (ball_subset_ball' (by rw [dist_zero_right, sub_add_cancel]) hy.2) hy.1.2)
          measure_empty⟩)
  -- (4) `Ŝ = τ(R̂)`, i.e. `Ŝ(ω) = ∫_{M ∩ B_t(0)} θ ⟨ω, ξ⟩ dHⁿ`
  obtain ⟨Ŝ, hŜ⟩ := Submission.dtc_imrep_current P (m + 1) univ Rh
  have hŜω : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Ŝ ω =
      ∫ x in Rp.carrier ∩ ball 0 t, (Rp.mult x : ℝ) *
        Rp.orient x ((ω : DifferentialForm (Euclid P) (m + 1)) x) ∂μHE[m + 1] := by
    intro ω
    rw [hŜ ω, IMRep.action, hRhc, hRhm, hRho]
  -- (5) agreement with `S` on forms supported in `B_t(0)`: the integrand vanishes on
  -- `M \ B_t(0)`, which misses `spt ω`
  have hagree : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1),
      tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ ball 0 t →
        Ŝ ω = currentEval S (ω : DifferentialForm (Euclid P) (m + 1)) := by
    intro ω hω
    have hωU : IsTestForm (ω : DifferentialForm (Euclid P) (m + 1)) ∧
        tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ U := ⟨ω.2.1, hω.trans htU⟩
    have hSω : currentEval S (ω : DifferentialForm (Euclid P) (m + 1)) =
        Rp.action (ω : DifferentialForm (Euclid P) (m + 1)) := by
      rw [currentEval, dite_eq_left hωU]
      exact hRp ⟨(ω : DifferentialForm (Euclid P) (m + 1)), hωU⟩
    rw [hSω, IMRep.action, hŜω]
    refine (setIntegral_eq_of_subset_of_forall_sdiff_eq_zero Rp.measurableSet_carrier
      inter_subset_left fun x hx => ?_).symm
    have hx0 : (ω : DifferentialForm (Euclid P) (m + 1)) x = 0 :=
      image_eq_zero_of_notMem_tsupport fun h => hx.2 ⟨hx.1, hω h⟩
    rw [hx0, map_zero, mul_zero]
  -- (6) `∂Ŝ(β) = Ŝ(dβ) = S(dβ) = ∂S(β) = 0` for `spt β ⊆ B_t(0) ⊆ B_R(0)`
  have hbdry : ∀ β : TestFormOn (univ : Set (Euclid P)) m,
      tsupport (β : DifferentialForm (Euclid P) m) ⊆ ball 0 t → Ŝ.boundary β = 0 := by
    intro β hβ
    have hβU : (β : DifferentialForm (Euclid P) m) ∈ TestFormOn U m := ⟨β.2.1, hβ.trans htU⟩
    have hdβ : IsTestForm (exteriorDerivative (β : DifferentialForm (Euclid P) m)) ∧
        tsupport (exteriorDerivative (β : DifferentialForm (Euclid P) m)) ⊆ U :=
      ⟨exteriorDerivative_isTestForm β.2.1,
        (tsupport_exteriorDerivative_subset _).trans (hβ.trans htU)⟩
    calc Ŝ.boundary β = Ŝ (exteriorDerivativeTestOn univ m β) := rfl
      _ = currentEval S (exteriorDerivative (β : DifferentialForm (Euclid P) m)) :=
          hagree _ ((tsupport_exteriorDerivative_subset _).trans hβ)
      _ = S.boundary ⟨_, hβU⟩ := by
          rw [currentEval, dite_eq_left hdβ]
          rfl
      _ = 0 := hbd _ (hβ.trans (ball_subset_ball (by linarith)))
  -- (7) `μ_R̂ = θ Hⁿ⌞(M ∩ B_t(0)) ≤ θ Hⁿ⌞M = μ_S` on open sets
  have hle : ∀ O : Set (Euclid P), IsOpen O → Rh.measure O ≤ Rp.measure O := by
    intro O hO
    rw [IMRep.measure, IMRep.measure, withDensity_apply _ hO.measurableSet,
      withDensity_apply _ hO.measurableSet, hRhc, hRhm]
    exact lintegral_mono' (Measure.restrict_mono subset_rfl
      (Measure.restrict_mono inter_subset_left le_rfl)) le_rfl
  refine ⟨t, Ŝ, ht1, ht2, ⟨Rh, hŜ⟩, hagree, hbdry, fun O hO => ?_, ?_, ?_⟩
  · -- `M_O(Ŝ) = μ_R̂(O) ≤ μ_S(O) = M_O(S)`
    rw [Submission.cmc_massOn_eq_imRep_measure P (m + 1) univ Ŝ Rh isOpen_univ hŜ O hO,
      Submission.cmc_massOn_eq_imRep_measure P (m + 1) U S Rp hU hRp O hO]
    exact hle O hO
  · -- (8) `M(Ŝ) = ∫_{M ∩ B_t(0)} θ dHⁿ ≤ ∫_{M ∩ B̄_R(0)} θ dHⁿ < ∞`
    rw [GeometricCurrentOn.mass, Submission.cmc_massOn_eq_imRep_measure P (m + 1) univ Ŝ Rh
      isOpen_univ hŜ univ isOpen_univ, IMRep.measure, withDensity_apply _ MeasurableSet.univ,
      Measure.restrict_univ, hRhc, hRhm]
    exact lt_of_le_of_lt (lintegral_mono_set (inter_subset_inter_right _ htR)) hfin.lt_top
  · -- (9) `∂Ŝ(β) = ∫_{M ∩ B_t(0)} θ ⟨dβ, ξ⟩ dHⁿ ≤ σ` for admissible `β`, so `M(∂Ŝ) ≤ σ`
    refine lt_of_le_of_lt ?_ (ENNReal.ofReal_lt_top (r := σ * 1))
    apply sSup_le
    rintro r ⟨β, ⟨-, hβ1⟩, rfl⟩
    refine ENNReal.ofReal_le_ofReal ?_
    calc Ŝ.boundary β = Ŝ (exteriorDerivativeTestOn univ m β) := rfl
      _ = ∫ x in Rp.carrier ∩ ball 0 t, (Rp.mult x : ℝ) * Rp.orient x
          (exteriorDerivative (β : DifferentialForm (Euclid P) m) x) ∂μHE[m + 1] := hŜω _
      _ ≤ σ * 1 := (le_abs_self _).trans (hσ β 1 hβ1)

/-- Common convergent subsequence for countably many bounded real sequences.  The points
`xᵢ = (b_k(i))_k` lie in the product `Π_k [-M_k, M_k]`, which is compact (Tychonoff,
`isCompact_univ_pi`); `ℝ^ι` is first countable since `ι` is countable, so `IsCompact.tendsto_subseq`
gives a strictly increasing `σ` and a limit `a` with `x_{σ(i)} → a`.  Evaluation at `k` is
continuous, hence `b_k(σ(i)) → a(k)` for every `k`. -/
theorem Submission.codim1_zsl_pc_diagonal_subseq : ∀ (ι : Type) [Countable ι] (b : ι → ℕ → ℝ) (M : ι → ℝ), (∀ k i, |b k i| ≤ M k) → ∃ σ : ℕ → ℕ, StrictMono σ ∧ ∀ k, ∃ L : ℝ, Tendsto (fun i => b k (σ i)) atTop (𝓝 L) := by
  intro ι _ b M hb
  have hS : IsCompact (Set.pi univ (fun k => Icc (-M k) (M k))) :=
    isCompact_univ_pi (fun k => isCompact_Icc)
  have hx : ∀ i, (fun k => b k i) ∈ Set.pi univ (fun k => Icc (-M k) (M k)) := by
    intro i
    rw [Set.mem_univ_pi]
    intro k
    exact Set.mem_Icc.mpr (abs_le.mp (hb k i))
  obtain ⟨a, -, σ, hσ, hlim⟩ := hS.tendsto_subseq hx
  exact ⟨σ, hσ, fun k => ⟨a k, ((continuous_apply k).tendsto a).comp hlim⟩⟩
/-- **Uniform local mass bounds give uniform evaluation bounds** (Simon Ch. 6, 2.5; first step
of the weak compactness Lemma 2.15).  With `N ≥ 0` such that `|α| ≤ N ‖α‖` and a ball
`W = B_R(0) ⊇ K`, the constant is `c = N · supⱼ M_W(Tⱼ)`: if `spt ω ⊆ K` and `‖ω(x)‖ ≤ s` then
`|ω(x)| ≤ N s`, so the evaluation bound gives `|Tⱼ(ω)| ≤ N s M_W(Tⱼ) ≤ c s`. -/
theorem Submission.dtc_bc_tc_wc_local_bound : ∀ (P n : ℕ) (Ts : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) n), (∀ W : Set (Euclid P), IsOpen W → Bornology.IsBounded W → ⨆ j, (Ts j).massOn W < ∞) → ∀ K : Set (Euclid P), IsCompact K → ∃ c : ℝ, 0 ≤ c ∧ ∀ (j : ℕ) (ω : TestFormOn (univ : Set (Euclid P)) n) (s : ℝ), tsupport (ω : DifferentialForm (Euclid P) n) ⊆ K → (∀ x, ‖(ω : DifferentialForm (Euclid P) n) x‖ ≤ s) → |Ts j ω| ≤ c * s := by
  intro P n Ts hTs K hK
  -- `|α| ≤ N ‖α‖` for the Euclidean coefficient norm
  obtain ⟨N, hN0, hN⟩ := (Submission.rsd_mw_tfa_norm_props P n).2.2.1
  -- `K ⊆ W := B_R(0)`, and `m := supⱼ M_W(Tⱼ) < ∞`
  obtain ⟨R, hKR⟩ := hK.isBounded.subset_ball (0 : Euclid P)
  have hm := hTs (ball 0 R) isOpen_ball isBounded_ball
  refine ⟨N * (⨆ j, (Ts j).massOn (ball 0 R)).toReal, mul_nonneg hN0 ENNReal.toReal_nonneg, ?_⟩
  intro j ω s hωK hωs
  -- `M_W(Tⱼ) ≤ m < ∞`
  have hj : (Ts j).massOn (ball 0 R) ≤ ⨆ j, (Ts j).massOn (ball 0 R) :=
    le_iSup (fun j => (Ts j).massOn (ball 0 R)) j
  have hs : 0 ≤ s := (norm_nonneg _).trans (hωs 0)
  -- the evaluation bound with `r = N s`
  have hev := Submission.cmr_abs_apply_le_massOn P n univ (ball 0 R) (Ts j) ω (N * s)
    (hj.trans_lt hm).ne (hωK.trans hKR)
    fun x => (hN _).trans (mul_le_mul_of_nonneg_left (hωs x) hN0)
  calc |Ts j ω| ≤ N * s * ((Ts j).massOn (ball 0 R)).toReal := hev
    _ ≤ N * s * (⨆ j, (Ts j).massOn (ball 0 R)).toReal :=
        mul_le_mul_of_nonneg_left (ENNReal.toReal_mono hm.ne hj) (mul_nonneg hN0 hs)
    _ = N * (⨆ j, (Ts j).massOn (ball 0 R)).toReal * s := by ring
/-- **Convergence on a sup-norm-dense family extends to all test forms** (Simon Ch. 6, Lemma
2.15, the boundedness half of the sequential Banach–Alaoglu argument used for 7.2.4).  Suppose the
`Sᵢ` are uniformly bounded on forms supported in each compact `K` (`|Sᵢ(ω)| ≤ c s` when
`‖ω(x)‖ ≤ s`), every `ω` is a uniform limit of forms `ωₖ ∈ D` supported in one compact `K`, and
`(Sᵢ(δ))ᵢ` converges for every `δ ∈ D`.  For `ε > 0` pick `k` with `‖ω(x) − ωₖ(x)‖ < η`,
`η = ε / (3 (c + 1))`.  Since `spt (ω − ωₖ) ⊆ K`, linearity gives `|Sᵢ(ω) − Sᵢ(ωₖ)| ≤ c η < ε / 3`
for every `i`, and `(Sᵢ(ωₖ))ᵢ` is Cauchy; the `ε / 3` estimate shows that `(Sᵢ(ω))ᵢ` is Cauchy, so
it converges in `ℝ`. -/
theorem Submission.dtc_bc_tc_wc_dense_extension : ∀ (P n : ℕ) (S : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) n) (D : Set (TestFormOn (univ : Set (Euclid P)) n)), (∀ K : Set (Euclid P), IsCompact K → ∃ c : ℝ, 0 ≤ c ∧ ∀ (i : ℕ) (ω : TestFormOn (univ : Set (Euclid P)) n) (s : ℝ), tsupport (ω : DifferentialForm (Euclid P) n) ⊆ K → (∀ x, ‖(ω : DifferentialForm (Euclid P) n) x‖ ≤ s) → |S i ω| ≤ c * s) → (∀ ω : TestFormOn (univ : Set (Euclid P)) n, ∃ (K : Set (Euclid P)) (ωs : ℕ → TestFormOn (univ : Set (Euclid P)) n), IsCompact K ∧ tsupport (ω : DifferentialForm (Euclid P) n) ⊆ K ∧ (∀ k, ωs k ∈ D) ∧ (∀ k, tsupport (ωs k : DifferentialForm (Euclid P) n) ⊆ K) ∧ TendstoUniformly (fun k x => (ωs k : DifferentialForm (Euclid P) n) x) (ω : DifferentialForm (Euclid P) n) atTop) → (∀ δ ∈ D, ∃ L : ℝ, Tendsto (fun i => S i δ) atTop (𝓝 L)) → ∀ ω : TestFormOn (univ : Set (Euclid P)) n, ∃ L : ℝ, Tendsto (fun i => S i ω) atTop (𝓝 L) := by
  intro P n S D hbound hdense hconv ω
  -- Step 1: `K` and `ωₖ ∈ D` from (b), `c ≥ 0` from (a); it suffices that `(Sᵢ(ω))ᵢ` is Cauchy
  obtain ⟨K, ωs, hK, hωK, hωsD, hωsK, hunif⟩ := hdense ω
  obtain ⟨c, hc0, hc⟩ := hbound K hK
  refine cauchySeq_tendsto_of_complete (Metric.cauchySeq_iff.mpr fun ε hε => ?_)
  -- Step 2: some `k` with `dist (ω(x), ωₖ(x)) < η = ε / (3 (c + 1))` for every `x`
  have hη : 0 < ε / (3 * (c + 1)) := by positivity
  obtain ⟨k, hk⟩ := (Metric.tendstoUniformly_iff.mp hunif _ hη).exists
  -- Step 3: `spt (ω − ωₖ) ⊆ K` and `‖(ω − ωₖ)(x)‖ ≤ η`, so linearity and (a) give
  -- `|Sᵢ(ω) − Sᵢ(ωₖ)| = |Sᵢ(ω − ωₖ)| ≤ c η < ε / 3` for every `i`
  have hsupp : tsupport ((ω - ωs k : TestFormOn (univ : Set (Euclid P)) n) :
      DifferentialForm (Euclid P) n) ⊆ K := by
    rw [Submodule.coe_sub]
    exact (tsupport_sub _ _).trans (union_subset hωK (hωsK k))
  have hnorm : ∀ x, ‖((ω - ωs k : TestFormOn (univ : Set (Euclid P)) n) :
      DifferentialForm (Euclid P) n) x‖ ≤ ε / (3 * (c + 1)) := by
    intro x
    rw [Submodule.coe_sub, Pi.sub_apply, ← dist_eq_norm]
    exact (hk x).le
  have hcη : c * (ε / (3 * (c + 1))) < ε / 3 := by
    rw [mul_div_assoc', div_lt_div_iff₀ (by positivity) (by norm_num)]
    nlinarith
  have hclose : ∀ i, |S i ω - S i (ωs k)| < ε / 3 := by
    intro i
    have hsub : S i ω - S i (ωs k) = S i (ω - ωs k) := (map_sub (S i).toCurrent ω (ωs k)).symm
    rw [hsub]
    exact (hc i _ _ hsupp hnorm).trans_lt hcη
  -- Step 4: `(Sᵢ(ωₖ))ᵢ` converges by (c), hence is Cauchy
  obtain ⟨L, hL⟩ := hconv (ωs k) (hωsD k)
  obtain ⟨I, hI⟩ := Metric.cauchySeq_iff.mp hL.cauchySeq (ε / 3) (by positivity)
  -- Step 5: the `ε / 3` estimate for `i, l ≥ I`
  refine ⟨I, fun i hi l hl => ?_⟩
  have h3 := hI i hi l hl
  rw [Real.dist_eq] at h3 ⊢
  obtain ⟨h1l, h1r⟩ := abs_lt.mp (hclose i)
  obtain ⟨h2l, h2r⟩ := abs_lt.mp (hclose l)
  obtain ⟨h3l, h3r⟩ := abs_lt.mp h3
  exact abs_lt.mpr ⟨by linarith, by linarith⟩
/-- **A pointwise limit of currents with uniform zeroth-order bounds is a current** (Simon 6.2.13;
the limit step in the proof of Lemma 6.2.15).  Put `L(ω) = lim_i S_i(ω)`.  By uniqueness of
limits `L` is linear, and letting `i → ∞` in `|S_i(ω)| ≤ c s` gives `|L(ω)| ≤ c s` whenever
`spt ω ⊆ K` and `‖ω(x)‖ ≤ s` for all `x`.  So `Submission.cmcs_rc_order_zero_current` gives a
current `C` with `C(ω) = L(ω)`, and `S_i(ω) → C(ω)` for every `ω`. -/
theorem Submission.dtc_bc_tc_wc_limit_current : ∀ (P n : ℕ) (S : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) n), (∀ K : Set (Euclid P), IsCompact K → ∃ c : ℝ, 0 ≤ c ∧ ∀ (i : ℕ) (ω : TestFormOn (univ : Set (Euclid P)) n) (s : ℝ), tsupport (ω : DifferentialForm (Euclid P) n) ⊆ K → (∀ x, ‖(ω : DifferentialForm (Euclid P) n) x‖ ≤ s) → |S i ω| ≤ c * s) → (∀ ω : TestFormOn (univ : Set (Euclid P)) n, ∃ L : ℝ, Tendsto (fun i => S i ω) atTop (𝓝 L)) → ∃ C : GeometricCurrentOn (univ : Set (Euclid P)) n, WeaklyConvergesOn S C := by
  intro P n S hbd hlim
  -- Step 1: the pointwise limit `L(ω) = lim_i S_i(ω)`
  choose L hL using hlim
  -- Steps 2–3: `L` is linear, by uniqueness of limits
  let Λ : TestFormOn (univ : Set (Euclid P)) n →ₗ[ℝ] ℝ :=
    { toFun := L
      map_add' := fun ω η => by
        refine tendsto_nhds_unique (hL (ω + η)) ?_
        simpa only [map_add] using (hL ω).add (hL η)
      map_smul' := fun a ω => by
        refine tendsto_nhds_unique (hL (a • ω)) ?_
        simpa only [map_smul, smul_eq_mul, RingHom.id_apply] using (hL ω).const_mul a }
  -- Steps 4–5: `|L(ω)| ≤ c s` in the limit, so `order_zero_current` makes `L` a current `C`
  obtain ⟨C, hC⟩ := Submission.cmcs_rc_order_zero_current P n univ Λ fun K hK _ => by
    obtain ⟨c, -, hc⟩ := hbd K hK
    exact ⟨c, fun ω s hsupp hs => le_of_tendsto' (hL ω).abs fun i => hc i ω s hsupp hs⟩
  -- Step 6: `S_i(ω) → L(ω) = C(ω)`
  refine ⟨C, fun ω => ?_⟩
  rw [hC ω]
  exact hL ω

/-- **Weak compactness under local mass bounds** (Simon Ch. 6, Lemma 2.15 for `U = ℝᴾ`, the
subsequence step of 3.11): the sequential Banach–Alaoglu argument.  The mass bounds give
`|Tⱼ(ω)| ≤ c_K s` whenever `spt ω ⊆ K` and `‖ω(x)‖ ≤ s` for all `x` (`dtc_bc_tc_wc_local_bound`).
A countable `D ⊆ 𝒟ⁿ(ℝᴾ)` approximates every test form uniformly with supports in a common compact
set (`dor_lmbs_testForm_countable_approx`).  Every test form is bounded with compact support, so
each `(Tⱼ(δ))ⱼ` is bounded, and a diagonal subsequence `σ` makes `T_{σ(i)}(δ)` converge for every
`δ ∈ D` (`codim1_zsl_pc_diagonal_subseq`).  The uniform bounds extend the convergence to every
test form (`dtc_bc_tc_wc_dense_extension`), and the pointwise limit is a current `C` with
`T_{σ(i)} ⇀ C` (`dtc_bc_tc_wc_limit_current`). -/
theorem Submission.dtc_bc_tc_weak_compactness : ∀ (P n : ℕ) (Ts : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) n), (∀ W : Set (Euclid P), IsOpen W → Bornology.IsBounded W → ⨆ j, (Ts j).massOn W < ∞) → ∃ (φ : ℕ → ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n), StrictMono φ ∧ WeaklyConvergesOn (fun j => Ts (φ j)) C := by
  intro P n Ts hT
  -- Step 1: `|Tⱼ(ω)| ≤ c_K s` whenever `spt ω ⊆ K` and `‖ω(x)‖ ≤ s` for all `x`
  have hbound := Submission.dtc_bc_tc_wc_local_bound P n Ts hT
  -- Step 2: a countable `D` approximating every test form uniformly, with common compact supports
  obtain ⟨D, hDc, hD⟩ := Submission.dor_lmbs_testForm_countable_approx P n univ isOpen_univ
  -- Step 3: a test form `δ` has `‖δ(x)‖ ≤ s` and compact support, so `|Tⱼ(δ)| ≤ c s` for all `j`
  have hbdd : ∀ δ : TestFormOn (univ : Set (Euclid P)) n, ∃ M : ℝ, ∀ j, |Ts j δ| ≤ M := by
    intro δ
    obtain ⟨s, hs⟩ := δ.property.1.1.continuous.bounded_above_of_compact_support δ.property.1.2
    obtain ⟨c, -, hc⟩ := hbound _ δ.property.1.2
    exact ⟨c * s, fun j => hc j δ s subset_rfl hs⟩
  choose M hM using hbdd
  -- Step 4: a diagonal subsequence `σ` along which `Tⱼ(δ)` converges for every `δ ∈ D`
  have : Countable D := hDc.to_subtype
  obtain ⟨σ, hσ, hσD⟩ := Submission.codim1_zsl_pc_diagonal_subseq D
    (fun δ j => Ts j δ) (fun δ => M δ) fun δ j => hM δ j
  -- Step 5: `Sᵢ = T_{σ(i)}` inherits the bounds of step 1
  have hSbound : ∀ K : Set (Euclid P), IsCompact K → ∃ c : ℝ, 0 ≤ c ∧
      ∀ (i : ℕ) (ω : TestFormOn (univ : Set (Euclid P)) n) (s : ℝ),
        tsupport (ω : DifferentialForm (Euclid P) n) ⊆ K →
          (∀ x, ‖(ω : DifferentialForm (Euclid P) n) x‖ ≤ s) → |Ts (σ i) ω| ≤ c * s := by
    intro K hK
    obtain ⟨c, hc0, hc⟩ := hbound K hK
    exact ⟨c, hc0, fun i => hc (σ i)⟩
  -- Step 6: `T_{σ(i)}(ω)` converges for every test form `ω` (drop `K ⊆ univ` and the `dω` clause)
  have hconv := Submission.dtc_bc_tc_wc_dense_extension P n (fun i => Ts (σ i)) D hSbound
    (fun ω => by
      obtain ⟨K, ωs, hK, -, hωK, hωsD, hωsK, hunif, -⟩ := hD ω
      exact ⟨K, ωs, hK, hωK, hωsD, hωsK, hunif⟩)
    fun δ hδD => hσD ⟨δ, hδD⟩
  -- Step 7: the pointwise limit is a current `C` with `T_{σ(i)} ⇀ C`
  obtain ⟨C, hC⟩ := Submission.dtc_bc_tc_wc_limit_current P n (fun i => Ts (σ i)) hSbound hconv
  exact ⟨σ, C, hσ, hC⟩
/-- **A limsup bound on a compact set through its closed thickenings** (steps 5 and 6 of the proof
of `Submission.cbr_ci_bl_constant_vector_limit`, where `a_k = μ_k(K)` and `c = s`).  Write
`K_r = cthickening r K`; it is compact.  For `r > 0`, since `c ≠ ∞`,
`limsup_k c ν_k(K_r) = c limsup_k ν_k(K_r) ≤ c ν(K_r)`.  Given `d > c ν(K_r)`, pick
`c ν(K_r) < b < d`; eventually `c ν_k(K_r) < b` and `v_k < d − b`, so `a_k ≤ b + (d − b) = d`.
Hence `limsup_k a_k ≤ c ν(K_r)` for every `r > 0`.  As `K` is closed and `ν(K_1) < ∞`,
`ν(K_r) → ν(K)` as `r ↓ 0`, and letting `r ↓ 0` gives `limsup_k a_k ≤ c ν(K)`. -/
theorem Submission.cbr_ci_bl_cvl_limsup_le_of_cthickening : ∀ (P : ℕ) (a : ℕ → ℝ≥0∞) (νs : ℕ → Measure (Euclid P)) (ν : Measure (Euclid P)) (c : ℝ≥0∞) (K : Set (Euclid P)), IsCompact K → c ≠ ∞ → (∀ K' : Set (Euclid P), IsCompact K' → ν K' < ∞) → (∀ K' : Set (Euclid P), IsCompact K' → limsup (fun k => νs k K') atTop ≤ ν K') → (∀ r : ℝ, 0 < r → ∃ v : ℕ → ℝ≥0∞, Tendsto v atTop (𝓝 0) ∧ ∀ k, a k ≤ c * νs k (cthickening r K) + v k) → limsup a atTop ≤ c * ν K := by
  intro P a νs ν c K hK hc hνK hlim hv
  -- Steps 1–2: `limsup a ≤ c ν(K_r)` for every `r > 0`, where `K_r = cthickening r K`
  have hr : ∀ r : ℝ, 0 < r → limsup a atTop ≤ c * ν (cthickening r K) := by
    intro r hr
    obtain ⟨v, hv0, hav⟩ := hv r hr
    -- Step 1: `limsup_k c ν_k(K_r) = c limsup_k ν_k(K_r) ≤ c ν(K_r)`, as `K_r` is compact
    have hmain : limsup (fun k => c * νs k (cthickening r K)) atTop ≤ c * ν (cthickening r K) := by
      rw [ENNReal.limsup_const_mul_of_ne_top hc]
      gcongr
      exact hlim (cthickening r K) hK.cthickening
    -- Step 2: for `d > c ν(K_r)` pick `c ν(K_r) < b < d`; eventually
    -- `a_k ≤ c ν_k(K_r) + v_k ≤ b + (d - b) = d`
    refine le_of_forall_gt_imp_ge_of_dense fun d hd => ?_
    obtain ⟨b, hb, hbd⟩ := exists_between hd
    have h1 : ∀ᶠ k in atTop, c * νs k (cthickening r K) < b :=
      eventually_lt_of_limsup_lt (hmain.trans_lt hb)
    have h2 : ∀ᶠ k in atTop, v k < d - b := (tendsto_order.1 hv0).2 _ (tsub_pos_of_lt hbd)
    refine limsup_le_of_le (h := ?_)
    filter_upwards [h1, h2] with k hk1 hk2
    calc a k ≤ c * νs k (cthickening r K) + v k := hav k
      _ ≤ b + (d - b) := add_le_add hk1.le hk2.le
      _ = d := add_tsub_cancel_of_le hbd.le
  -- Step 3: `c ν(K_r) → c ν(K)` as `r ↓ 0`, since `K` is closed and `ν(K_1) < ∞`
  have htend : Tendsto (fun r => c * ν (cthickening r K)) (𝓝[>] 0) (𝓝 (c * ν K)) :=
    (ENNReal.Tendsto.const_mul (tendsto_measure_cthickening_of_isClosed
      ⟨1, one_pos, (hνK _ hK.cthickening).ne⟩ hK.isClosed) (Or.inr hc)).mono_left
      nhdsWithin_le_nhds
  exact ge_of_tendsto htend (eventually_nhdsWithin_of_forall hr)

/-- **Blow-up limit with a constant orienting vector** (the weak convergence `Γ_k ⇀ C` of the
blow-ups and the upper bound for their mass measures, in the proof that cycles with the integer
slice property are integer multiplicity; `|·|` is `covectorEuclideanNorm`).  Let
`X_k(ω) = ∫ ⟨ω, τ_k⟩ dν_k` and `C(ω) = ∫ ⟨ω, ζ₀⟩ dν`, where `∫ f dν_k → ∫ f dν` for continuous
compactly supported `f`, `limsup_k ν_k(K) ≤ ν(K)` for compact `K`, `|⟨α, ζ₀⟩| ≤ s |α|`, and
`∫_{B̄_R(0)} ‖τ_k − ζ₀‖ dν_k → 0` for every `R > 0`.  Let `μ_k` be the mass measure of `X_k`.  Then
`X_k ⇀ C` by `Submission.cbr_ci_bl_cvl_pairing_tendsto` with `w = ω`.  Fix a compact `K` and
`r > 0`, and choose `R > 0` with `cthickening r K ⊆ B̄_R(0)`.  The open set
`G = thickening r K` satisfies `K ⊆ G ⊆ cthickening r K`.  Apply
`Submission.cbr_ci_bl_cvl_massOn_le` with `B = Pⁿ` (`Submission.cbr_ci_bl_covector_opNorm_le`):
`μ_k(K) ≤ M_G(X_k) ≤ s ν_k(cthickening r K) + Pⁿ ∫_{B̄_R(0)} ‖τ_k − ζ₀‖ dν_k`.  The last term tends
to `0`, so `Submission.cbr_ci_bl_cvl_limsup_le_of_cthickening` gives `limsup_k μ_k(K) ≤ s ν(K)`. -/
theorem Submission.cbr_ci_bl_constant_vector_limit : ∀ (P n : ℕ) (Xs : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) n) (C : GeometricCurrentOn (univ : Set (Euclid P)) n) (νs : ℕ → Measure (Euclid P)) (ν : Measure (Euclid P)) (μs : ℕ → Measure (Euclid P)) (τs : ℕ → Euclid P → MultiVector P n) (ζ₀ : MultiVector P n) (s : ℝ), (∀ (k : ℕ) (K : Set (Euclid P)), IsCompact K → νs k K < ∞) → (∀ K : Set (Euclid P), IsCompact K → ν K < ∞) → (∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → Tendsto (fun k => ∫ x, f x ∂(νs k)) atTop (𝓝 (∫ x, f x ∂ν))) → (∀ K : Set (Euclid P), IsCompact K → limsup (fun k => νs k K) atTop ≤ ν K) → (∀ k, AEStronglyMeasurable (τs k) (νs k)) → 0 ≤ s → (∀ α : Covector (Euclid P) n, |ζ₀ α| ≤ s * covectorEuclideanNorm α) → (∀ R : ℝ, 0 < R → Tendsto (fun k => ∫⁻ x in closedBall (0 : Euclid P) R, ‖τs k x - ζ₀‖ₑ ∂(νs k)) atTop (𝓝 0)) → (∀ (k : ℕ) (ω : TestFormOn (univ : Set (Euclid P)) n), Xs k ω = ∫ x, τs k x ((ω : DifferentialForm (Euclid P) n) x) ∂(νs k)) → (∀ ω : TestFormOn (univ : Set (Euclid P)) n, C ω = ∫ x, ζ₀ ((ω : DifferentialForm (Euclid P) n) x) ∂ν) → (∀ (k : ℕ) (W : Set (Euclid P)), IsOpen W → (Xs k).massOn W = μs k W) → WeaklyConvergesOn Xs C ∧ ∀ K : Set (Euclid P), IsCompact K → limsup (fun k => μs k K) atTop ≤ ENNReal.ofReal s * ν K := by
  intro P n Xs C νs ν μs τs ζ₀ s hνsK hνK hconv hlimsup hτ hs hζ₀ hδ hX hC hmass
  refine ⟨fun ω => ?_, fun K hK => ?_⟩
  · -- weak convergence: `ω` is continuous with compact support, so
    -- `X_k(ω) = ∫ ⟨ω, τ_k⟩ dν_k → ∫ ⟨ω, ζ₀⟩ dν = C(ω)`
    have hω : IsTestForm (ω : DifferentialForm (Euclid P) n) ∧
        tsupport (ω : DifferentialForm (Euclid P) n) ⊆ univ := ω.property
    rw [hC ω]
    exact (Submission.cbr_ci_bl_cvl_pairing_tendsto P n νs ν τs ζ₀
      (ω : DifferentialForm (Euclid P) n) hνsK hconv hτ hδ hω.1.1.continuous hω.1.2).congr
      fun k => (hX k ω).symm
  · -- mass bound: for `r > 0` compare `μ_k(K)` with `ν_k(cthickening r K)` up to an error `v_k → 0`
    refine Submission.cbr_ci_bl_cvl_limsup_le_of_cthickening P (fun k => μs k K) νs ν
      (ENNReal.ofReal s) K hK ENNReal.ofReal_ne_top hνK hlimsup fun r hr => ?_
    -- `cthickening r K` is compact, hence contained in some `B̄_R(0)` with `R > 0`
    obtain ⟨R, hR, hKR⟩ := (hK.cthickening (r := r)).isBounded.subset_closedBall_lt 0 (0 : Euclid P)
    -- `v_k = Pⁿ ∫_{B̄_R(0)} ‖τ_k − ζ₀‖ dν_k → 0`
    have hv := ENNReal.Tendsto.const_mul (a := ENNReal.ofReal ((P : ℝ) ^ n)) (hδ R hR)
      (Or.inr ENNReal.ofReal_ne_top)
    rw [mul_zero] at hv
    refine ⟨_, hv, fun k => ?_⟩
    -- `M_G(X_k) ≤ s ν_k(G) + v_k` for the open `G = thickening r K ⊆ cthickening r K ⊆ B̄_R(0)`,
    -- using `‖α‖ ≤ Pⁿ |α|`
    have hM := Submission.cbr_ci_bl_cvl_massOn_le P n (Xs k) (νs k) (τs k) ζ₀ s ((P : ℝ) ^ n) R
      (thickening r K) (hνsK k) (hτ k) hs hζ₀ (by positivity)
      (Submission.cbr_ci_bl_covector_opNorm_le P n) (hX k) isOpen_thickening
      ((thickening_subset_cthickening r K).trans hKR)
    rw [hmass k _ isOpen_thickening] at hM
    -- `μ_k(K) ≤ μ_k(G) = M_G(X_k)` and `ν_k(G) ≤ ν_k(cthickening r K)`
    calc μs k K ≤ μs k (thickening r K) := measure_mono (self_subset_thickening hr K)
      _ ≤ _ := hM
      _ ≤ ENNReal.ofReal s * νs k (cthickening r K) + ENNReal.ofReal ((P : ℝ) ^ n) *
          ∫⁻ x in closedBall (0 : Euclid P) R, ‖τs k x - ζ₀‖ₑ ∂(νs k) := by
        gcongr
        exact thickening_subset_cthickening r K

/-- **`Hⁿ` and the measure `θ Hⁿ⌞M` under the blow-up map `η = η_{a,λ}`, `λ > 0`** (step 2 of the
blow-up argument in the integer-multiplicity criterion for cycles; `η_{x,λ}(y) = λ⁻¹(y − x)` and
the change of variables for `η_{x,λ#}` as in the proof of Simon Ch. 6, 8.1, chapter-06.txt
lines 2230–2238).  `η = blowUpMap a λ` is the contract's `dilation a λ`, `D(y) = −λ⁻¹a + λ⁻¹y`,
an affine homeomorphism with inverse `x ↦ a + λx`; so (i) `η(M) = D(M)` is Borel.
`Hⁿ(D(s)) = λ⁻ⁿ Hⁿ(s)` for every `s`, as `D(s)` is the translate by `−λ⁻¹a` of `λ⁻¹s`.  For Borel
`B` this gives (ii): `Hⁿ(B ∩ D(M)) = Hⁿ(D(D⁻¹B ∩ M)) = λ⁻ⁿ Hⁿ(D⁻¹B ∩ M)`.  (iii) follows from
(ii): pull `λ⁻ⁿ` out of `withDensity` and transport the density along `D`, as
`θ(a + λD(x)) = θ(x)`. -/
theorem Submission.cbr_ci_bl_blowUp_restrict_scaling : ∀ (P n : ℕ) (M : Set (Euclid P)) (θ : Euclid P → ℝ) (a : Euclid P) (lam : ℝ), MeasurableSet M → Measurable θ → 0 < lam → MeasurableSet (Poincare.SimonGMT.Chapter03.blowUpMap a lam '' M) ∧ μHE[n].restrict (Poincare.SimonGMT.Chapter03.blowUpMap a lam '' M) = ENNReal.ofReal (lam⁻¹ ^ n) • Measure.map (dilation a lam) (μHE[n].restrict M) ∧ ENNReal.ofReal (lam⁻¹ ^ n) • Measure.map (dilation a lam) ((μHE[n].restrict M).withDensity (fun x => ENNReal.ofReal (θ x))) = (μHE[n].restrict (Poincare.SimonGMT.Chapter03.blowUpMap a lam '' M)).withDensity (fun y => ENNReal.ofReal (θ (a + lam • y))) := by
  intro P n M θ a lam hM _ hlam
  -- Step 1: `η = blowUpMap a λ` is `D = dilation a λ`, `y ↦ −λ⁻¹a + λ⁻¹y`, an affine
  -- homeomorphism with inverse `x ↦ a + λx`
  have hηD : Poincare.SimonGMT.Chapter03.blowUpMap a lam = dilation a lam := by
    funext y
    simp only [Poincare.SimonGMT.Chapter03.blowUpMap, dilation, dilationCLM,
      _root_.smul_apply, ContinuousLinearMap.id_apply, smul_sub]
    abel
  have hDc : (((Homeomorph.smulOfNeZero lam⁻¹ (inv_ne_zero hlam.ne')).trans
      (Homeomorph.addLeft (-(lam⁻¹ • a)))) : Euclid P → Euclid P) = dilation a lam := by
    funext y
    simp [dilation, dilationCLM]
  have hme : MeasurableEmbedding (dilation a lam) := by
    rw [← hDc]
    exact Homeomorph.measurableEmbedding _
  have hιD : ∀ x, a + lam • dilation a lam x = x := fun x => by
    simp [dilation, dilationCLM, smul_add, smul_smul, mul_inv_cancel₀ hlam.ne']
  -- Step 2: `Hⁿ(D(s)) = λ⁻ⁿ Hⁿ(s)`: `D(s)` is the translate by `−λ⁻¹a` of `λ⁻¹s`
  have himage : ∀ s : Set (Euclid P),
      μHE[n] (dilation a lam '' s) = ENNReal.ofReal (lam⁻¹ ^ n) * μHE[n] s := by
    intro s
    have hs : dilation a lam '' s =
        (fun z => -(lam⁻¹ • a) + z) '' ((fun y => lam⁻¹ • y) '' s) := by
      rw [Set.image_image]
      rfl
    rw [hs, (isometry_add_left (-(lam⁻¹ • a))).euclideanHausdorffMeasure_image, Set.image_smul,
      Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hlam.ne') s, ENNReal.smul_def,
      smul_eq_mul, ← ENNReal.ofReal_coe_nnreal]
    congr 2
    simp [abs_of_pos hlam]
  -- Step 3, (ii): on Borel `B`, `Hⁿ(B ∩ D(M)) = Hⁿ(D(D⁻¹B ∩ M)) = λ⁻ⁿ Hⁿ(D⁻¹B ∩ M)`
  have hrestrict : μHE[n].restrict (dilation a lam '' M) =
      ENNReal.ofReal (lam⁻¹ ^ n) • Measure.map (dilation a lam) (μHE[n].restrict M) := by
    ext B hB
    rw [Measure.restrict_apply hB, Measure.smul_apply, hme.map_apply,
      Measure.restrict_apply (hme.measurable hB), smul_eq_mul, ← himage,
      Set.image_preimage_inter]
  rw [hηD]
  refine ⟨hme.measurableSet_image.mpr hM, hrestrict, ?_⟩
  -- Step 4, (iii): pull out the scalar and transport the density along `D`, using
  -- `θ(a + λD(x)) = θ(x)`
  rw [hrestrict, withDensity_smul_measure]
  congr 1
  ext B hB
  rw [hme.map_apply, withDensity_apply _ (hme.measurable hB), withDensity_apply _ hB,
    hme.restrict_map, hme.lintegral_map]
  simp only [hιD]

/-- **One blow-up scale of a cycle `Γ = μ ∧ ζ` with `μ = θ Hⁿ⌞M`** (Simon 7.3, the blow-ups
`η_{a,λ#}Γ`).  Let `D = η_{a,λ}` (`dilation a λ`, which equals `blowUpMap a λ`),
`c = λ^{-n}` and `μ' = c D_#μ`, and let `Γ'` satisfy the dilation identities (h2), (h4), (h5)
for `∂`, the representation and `M_W`.  `D` is the homeomorphism `y ↦ −λ⁻¹a + λ⁻¹y`, with
`a + λD(x) = x`, and `Submission.cbr_ci_bl_blowUp_restrict_scaling` gives that `η(M)` is Borel
and `μ' = θ(a + λ·) Hⁿ⌞η(M)`.  Then `Γ(ω) = ∫ ⟨ω, ζ⟩ dμ`, as `θ > 0` on `M`;
`∂Γ'(ω) = λ^{-d} ∂Γ(ω ∘ D) = 0`; `μ'(K) ≤ c μ(ℝᴾ) < ∞`;
`M_W(Γ') = c M_{D⁻¹W}(Γ) = c μ(D⁻¹W) = μ'(W)` for open `W`;
`Γ'(ω) = ∫ ⟨ω(y), ζ(a + λy)⟩ dμ'(y)` by (h4); `μ'(η(M)ᶜ) = c μ(Mᶜ) = 0`; and rewriting through
the density of `μ'` gives `Γ'(ω) = ∫_{η(M)} θ(a + λy) ⟨ω(y), ζ(a + λy)⟩ dHⁿ(y)`. -/
theorem Submission.cbr_ci_bl_blowup_scale : ∀ (P d : ℕ) (Γ Γ' : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (μ : Measure (Euclid P)) (M : Set (Euclid P)) (θ : Euclid P → ℝ) (ζ : Euclid P → MultiVector P (d + 1)) (a : Euclid P) (lam : ℝ), 0 < lam → Γ.boundary = 0 → μ univ < ∞ → (∀ W : Set (Euclid P), IsOpen W → Γ.massOn W = μ W) → MeasurableSet M → Measurable θ → StronglyMeasurable ζ → μ = (μHE[(d + 1)].restrict M).withDensity (fun x => ENNReal.ofReal (θ x)) → (∀ x ∈ M, 0 < θ x) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), Γ ω = ∫ x in M, θ x * ζ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μHE[(d + 1)]) → (∀ ω ω' : TestFormOn (univ : Set (Euclid P)) d, (∀ y : Euclid P, (ω' : DifferentialForm (Euclid P) d) y = (ω : DifferentialForm (Euclid P) d) (dilation a lam y)) → Γ'.boundary ω = lam⁻¹ ^ d * Γ.boundary ω') → ((∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), Γ ω = ∫ x, ζ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → ∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), Γ' ω = ∫ y, ζ (a + lam • y) ((ω : DifferentialForm (Euclid P) (d + 1)) y) ∂(ENNReal.ofReal (lam⁻¹ ^ (d + 1)) • Measure.map (dilation a lam) μ)) → (∀ W : Set (Euclid P), Γ'.massOn (dilation a lam '' W) = ENNReal.ofReal (lam⁻¹ ^ (d + 1)) * Γ.massOn W) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), Γ ω = ∫ x, ζ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) ∧ Γ'.boundary = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → (ENNReal.ofReal (lam⁻¹ ^ (d + 1)) • Measure.map (dilation a lam) μ) K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → Γ'.massOn W = (ENNReal.ofReal (lam⁻¹ ^ (d + 1)) • Measure.map (dilation a lam) μ) W) ∧ AEStronglyMeasurable (fun y => ζ (a + lam • y)) (ENNReal.ofReal (lam⁻¹ ^ (d + 1)) • Measure.map (dilation a lam) μ) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), Γ' ω = ∫ y, ζ (a + lam • y) ((ω : DifferentialForm (Euclid P) (d + 1)) y) ∂(ENNReal.ofReal (lam⁻¹ ^ (d + 1)) • Measure.map (dilation a lam) μ)) ∧ (ENNReal.ofReal (lam⁻¹ ^ (d + 1)) • Measure.map (dilation a lam) μ) (Poincare.SimonGMT.Chapter03.blowUpMap a lam '' M)ᶜ = 0 ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), Γ' ω = ∫ y, (θ (a + lam • y) • ζ (a + lam • y)) ((ω : DifferentialForm (Euclid P) (d + 1)) y) ∂(μHE[(d + 1)].restrict (Poincare.SimonGMT.Chapter03.blowUpMap a lam '' M))) := by
  intro P d Γ Γ' μ M θ ζ a lam hlam hΓb hμfin hmass hM hθ hζ hμ hθpos hΓrep h2 h4 h5
  -- Step 1: `D = dilation a λ` is the homeomorphism `y ↦ −λ⁻¹a + λ⁻¹y`; it equals
  -- `η = blowUpMap a λ`, is smooth, and `a + λη(x) = x`
  obtain ⟨e, he⟩ : ∃ e : Euclid P ≃ₜ Euclid P, ⇑e = dilation a lam :=
    ⟨(Homeomorph.smulOfNeZero lam⁻¹ (inv_ne_zero hlam.ne')).trans
      (Homeomorph.addLeft (-(lam⁻¹ • a))), by funext y; simp [dilation, dilationCLM]⟩
  have hDme : MeasurableEmbedding (dilation a lam) := by
    rw [← he]
    exact e.measurableEmbedding
  have hDcont : Continuous (dilation a lam) := by
    rw [← he]
    exact e.continuous
  have hDsurj : Surjective (dilation a lam) := by
    rw [← he]
    exact e.surjective
  have hDinj : Injective (dilation a lam) := by
    rw [← he]
    exact e.injective
  have hDsmooth : ∀ k : WithTop ℕ∞, ContDiff ℝ k (dilation a lam) := fun _ =>
    contDiff_const.add (dilationCLM P lam).contDiff
  have hDη : dilation a lam = Poincare.SimonGMT.Chapter03.blowUpMap a lam := by
    funext y
    simp only [dilation, dilationCLM, Poincare.SimonGMT.Chapter03.blowUpMap, _root_.smul_apply,
      ContinuousLinearMap.id_apply, smul_sub, neg_add_eq_sub]
  have hηinv : ∀ x, a + lam • Poincare.SimonGMT.Chapter03.blowUpMap a lam x = x := fun x => by
    rw [Poincare.SimonGMT.Chapter03.blowUpMap, smul_inv_smul₀ hlam.ne', add_sub_cancel]
  -- `η(M)` is Borel and `μ' = c D_#μ = (Hⁿ⌞η(M)) ⌞ θ(a + λ·)` (sibling `blowup_measure`)
  obtain ⟨hηM, -, hμ'⟩ :=
    Submission.cbr_ci_bl_blowUp_restrict_scaling P (d + 1) M θ a lam hM hθ hlam
  rw [← hμ] at hμ'
  have hμ'apply : ∀ s : Set (Euclid P),
      (ENNReal.ofReal (lam⁻¹ ^ (d + 1)) • Measure.map (dilation a lam) μ) s =
        ENNReal.ofReal (lam⁻¹ ^ (d + 1)) * μ (dilation a lam ⁻¹' s) := fun s => by
    rw [Measure.smul_apply, hDme.map_apply, smul_eq_mul]
  -- Step 2 (P0): `Γ(ω) = ∫ ζ(ω) dμ`, since `(ofReal θ).toReal = θ` on `M`
  have hP0 : ∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1),
      Γ ω = ∫ x, ζ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ := by
    intro ω
    rw [hΓrep ω, hμ, integral_withDensity_eq_integral_toReal_smul hθ.ennreal_ofReal
      (Eventually.of_forall fun _ => ENNReal.ofReal_lt_top)]
    refine setIntegral_congr_fun hM fun x hx => ?_
    simp only [ENNReal.toReal_ofReal (hθpos x hx).le, smul_eq_mul]
  -- Step 3 (P7): `∂Γ'(ω) = λ^{-d} ∂Γ(ω ∘ D) = 0`, `ω ∘ D` being a test form
  have hP7 : Γ'.boundary = 0 := by
    refine GeometricCurrentOn.ext fun ω => ?_
    have hcpt : HasCompactSupport ((ω : DifferentialForm (Euclid P) d) ∘ dilation a lam) := by
      rw [← he]
      exact ω.property.1.2.comp_homeomorph e
    have hmem : (ω : DifferentialForm (Euclid P) d) ∘ dilation a lam ∈
        testFormOnSubmodule (univ : Set (Euclid P)) d := by
      show IsTestForm ((ω : DifferentialForm (Euclid P) d) ∘ dilation a lam) ∧
        tsupport ((ω : DifferentialForm (Euclid P) d) ∘ dilation a lam) ⊆ univ
      exact ⟨⟨ω.property.1.1.comp (hDsmooth _), hcpt⟩, subset_univ _⟩
    rw [h2 ω ⟨_, hmem⟩ fun _ => rfl, hΓb]
    simp only [GeometricCurrentOn.zero_apply, mul_zero]
  -- Step 4 (P1): `μ'(K) = c μ(D⁻¹K) ≤ c μ(ℝᴾ) < ∞`
  have hP1 : ∀ K : Set (Euclid P), IsCompact K →
      (ENNReal.ofReal (lam⁻¹ ^ (d + 1)) • Measure.map (dilation a lam) μ) K < ∞ := fun K _ => by
    rw [hμ'apply]
    exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top
      ((measure_mono (subset_univ _)).trans_lt hμfin)
  -- Step 5 (P2): `M_W(Γ') = M_{D(D⁻¹W)}(Γ') = c M_{D⁻¹W}(Γ) = c μ(D⁻¹W) = μ'(W)`
  have hP2 : ∀ W : Set (Euclid P), IsOpen W →
      Γ'.massOn W = (ENNReal.ofReal (lam⁻¹ ^ (d + 1)) • Measure.map (dilation a lam) μ) W := by
    intro W hW
    rw [hμ'apply, ← hmass _ (hW.preimage hDcont), ← h5, image_preimage_eq W hDsurj]
  -- Step 6 (P3): `y ↦ a + λy` is measurable, so `y ↦ ζ(a + λy)` is strongly measurable
  have hAmeas : Measurable fun y : Euclid P => a + lam • y :=
    (continuous_const.add (continuous_const_smul lam)).measurable
  -- Step 7 (P5): `(h4)` applied to (P0)
  have hP5 := h4 hP0
  -- Step 8 (P6): `μ'(η(M)ᶜ) = c μ((D⁻¹(D(M)))ᶜ) = c μ(Mᶜ) = 0`
  have hμMc : μ Mᶜ = 0 := by
    rw [hμ]
    exact withDensity_absolutelyContinuous _ _
      (by rw [Measure.restrict_apply' hM, compl_inter_self, measure_empty])
  have hP6 : (ENNReal.ofReal (lam⁻¹ ^ (d + 1)) • Measure.map (dilation a lam) μ)
      (Poincare.SimonGMT.Chapter03.blowUpMap a lam '' M)ᶜ = 0 := by
    rw [hμ'apply, preimage_compl, ← hDη, hDinj.preimage_image, hμMc, mul_zero]
  -- Step 9 (P8): rewrite (P5) through `μ' = (Hⁿ⌞η(M)) ⌞ θ(a + λ·)`; for `y = η(x)`, `x ∈ M`,
  -- `a + λy = x` and `(ofReal θ(x)).toReal = θ(x)`
  have hθA : Measurable fun y : Euclid P => ENNReal.ofReal (θ (a + lam • y)) :=
    (hθ.comp hAmeas).ennreal_ofReal
