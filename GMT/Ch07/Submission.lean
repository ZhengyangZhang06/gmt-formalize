      exact ⟨hd.differentiableAt, hDinj _ (hTreg l _ hz.2).2 (hDΦGp l _ (hTsub l hz.2))⟩
  have htanB : ∀ l, ∀ᵐ z ∂(volume.restrict (S l)), HasApproximateTangentSpaceAt (k + m') MB
