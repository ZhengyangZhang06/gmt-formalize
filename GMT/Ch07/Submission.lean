  have hPc : CauchySeq fun n => toH₀ (ζ n) := by
    rw [Metric.cauchySeq_iff]
    intro ε hε
    obtain ⟨N, hN⟩ := Metric.cauchySeq_iff.1 hQ.cauchySeq (ε / (2 * R)) (by positivity)
    refine ⟨N, fun n hn l hl => ?_⟩
    rw [dist_eq_norm]
    refine (hPQ n l).trans_lt ?_
