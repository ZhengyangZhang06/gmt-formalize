    refine ⟨O ∩ (W ∩ ball p δ₁), hOo.inter (hW.inter isOpen_ball), ⟨hpO, hpW, mem_ball_self hδ₁⟩,
      fun χ hχ hχO => ?_⟩
    -- the local field `Y = χ X` and its deformation `Ψ (Φ y + t DΦ(y) Y(y))`
    have hYX : tsupport (fun x => χ x • X x) ⊆ tsupport X := tsupport_smul_subset_right _ _
    have hYO : tsupport (fun x => χ x • X x) ⊆ O ∩ (W ∩ ball p δ₁) :=
      (tsupport_smul_subset_left _ _).trans hχO
    obtain ⟨Vf, hVf⟩ : ∃ Vf : Euclid P → Euclid P, ∀ y, Vf y = fderiv ℝ H.symm y (χ y • X y) :=
      ⟨_, fun _ => rfl⟩
    obtain ⟨φ, hφ⟩ : ∃ φ : ℝ → Euclid P → Euclid P,
        ∀ t y, φ t y = if y ∈ O then Ψ (H.symm y + t • Vf y) else y := ⟨_, fun _ _ => rfl⟩
    obtain ⟨hid, C, hφev, hexp⟩ := gconj Ψ H.symm (fun x => χ x • X x) Vf φ B O hBo hOo
      (fun b hb => hΨC b (hBV b hb)) (fun y hy => ⟨(hΦ y hy).1, (hΦ y hy).2.1, (hΦ y hy).2.2.1⟩)
      (hχ.smul hX) (hXc.mono (support_smul_subset_right χ X)) (fun y hy => (hYO hy).1) hVf hφ
    -- tangency: `DΦ(z) Y(z)` lies in `{x | A (g x) = x}` for `z ∈ N`
    have htan : ∀ z ∈ N, z ∈ tsupport (fun x => χ x • X x) → A (g (Vf z)) = Vf z := by
      intro z hzN hzY
      have hsz := hsl z hzN (hYO hzY)
      obtain ⟨-, hzB, hΨz, hinvz⟩ := hΦ z (hYO hzY).1
      have hzψ : ψ (vp + g (H.symm z)) = z := by
        rw [hΨ, hsz, sub_self, add_zero] at hΨz; exact hΨz
      have hT := Submission.chart_tangentSpace_eq_range_fderiv P d 2 N W V ψ (vp + g (H.symm z))
        (by norm_num) hV hW hψ hψinj hψim hψprop hψD (hBV _ hzB)
      rw [hzψ] at hT
      obtain ⟨h, hh⟩ : X z ∈ range (fderiv ℝ ψ (vp + g (H.symm z))) := by
        rw [← hT]; exact hXT z ⟨hzN, hXU (hYX hzY)⟩
      have hDΨu : fderiv ℝ Ψ (H.symm z) (A (χ z • h)) = χ z • X z := by
        rw [(hΨD _ (hBV _ hzB)).fderiv, add_apply, ContinuousLinearMap.comp_apply, sub_apply,
          ContinuousLinearMap.id_apply, ContinuousLinearMap.comp_apply, hg, sub_self, add_zero,
          map_smul, hh]
      rw [hVf, ← hDΨu, hinvz, hg]
    refine (hGood _).2 ⟨φ, C, ?_, hexp⟩
    filter_upwards [hφev] with t ht
    obtain ⟨h1, h2, h3⟩ := ht
    refine ⟨h1, fun x hx => hid t x fun h => hx (hYX h), fun z hz => ?_, h3⟩
    by_cases hzY : z ∈ tsupport (fun x => χ x • X x)
    · have hS : A (g (H.symm z + t • Vf z)) = H.symm z + t • Vf z := by
        rw [map_add, map_smul, map_add, map_smul, hsl z hz (hYO hzY), htan z hz hzY]
      rw [hφ, ite_eq_left (hYO hzY).1, hΨ, hS, sub_self, add_zero]
      exact ((Set.ext_iff.1 hψim _).1 (mem_image_of_mem ψ (hBV _ (h2 z hzY)))).2
    · rw [hid t z hzY]; exact hz
  -- `N ∩ K` is compact, as `(N̄ \ N) ∩ U = ∅`
  have hNK : IsCompact (N ∩ tsupport X) := by
    have h : N ∩ tsupport X = closure N ∩ tsupport X := by
      refine Subset.antisymm (inter_subset_inter_left _ subset_closure) fun x hx => ⟨?_, hx.2⟩
      by_contra hxN
      exact (hNU.subset ⟨⟨hx.1, hxN⟩, hXU hx.2⟩ : x ∈ (∅ : Set (Euclid P)))
    rw [h]; exact hXc.isCompact.inter_left isClosed_closure
  -- a partition of unity subordinate to finitely many straightening charts and `U \ N̄`
  choose O hOo hpO hOgood using fun p : ↥(N ∩ tsupport X) => glocal p.1 p.2.1
  obtain ⟨s, hs⟩ := hNK.elim_finite_subcover O hOo fun x hx => mem_iUnion.2 ⟨⟨x, hx⟩, hpO ⟨x, hx⟩⟩
  have hGopen : ∀ j : Option ↥s, IsOpen (Option.elim j (U \ closure N) fun i => O i.1) := by
    rintro (_ | i)
    · exact hU.sdiff isClosed_closure
    · exact hOo _
  have hGcover : tsupport X ⊆ ⋃ j : Option ↥s, Option.elim j (U \ closure N) fun i => O i.1 := by
    intro x hx
    by_cases hxN : x ∈ N
    · obtain ⟨i, hi, hxi⟩ := mem_iUnion₂.1 (hs ⟨hxN, hx⟩)
      exact mem_iUnion.2 ⟨some ⟨i, hi⟩, hxi⟩
    · exact mem_iUnion.2 ⟨none, hXU hx, fun hxc =>
        (hNU.subset ⟨⟨hxc, hxN⟩, hXU hx⟩ : x ∈ (∅ : Set (Euclid P)))⟩
  obtain ⟨f, hf⟩ := SmoothPartitionOfUnity.exists_isSubordinate
    (modelWithCornersSelf ℝ (Euclid P)) (isClosed_tsupport X) _ hGopen hGcover
  have hfC : ∀ j, ContDiff ℝ 1 (f j) := fun j =>
    (contMDiff_iff_contDiff.1 (f j).contMDiff).of_le (by exact_mod_cast le_top)
  have hdecomp : ∑ j, (fun x => f j x • X x) = X := by
    funext x
    rw [Finset.sum_apply]
    by_cases hx : x ∈ tsupport X
    · rw [← Finset.sum_smul, ← finsum_eq_sum_of_fintype, f.sum_eq_one hx, one_smul]
    · simp only [image_eq_zero_of_notMem_tsupport hx, smul_zero, Finset.sum_const_zero]
  have hpieces : ∀ j ∈ (Finset.univ : Finset (Option ↥s)), ContDiff ℝ 1 (fun x => f j x • X x) ∧
      HasCompactSupport (fun x => f j x • X x) ∧ Good (fun x => f j x • X x) := by
    rintro (_ | i) -
    · -- away from `N`: `id + t f₀ X`, as `f₀ X = 0` on `N`
      have hAC : ContDiff ℝ 1 (fun x => f none x • X x) := (hfC _).smul hX
      have hAc : HasCompactSupport (fun x => f none x • X x) :=
        hXc.mono (support_smul_subset_right (f none) X)
      refine ⟨hAC, hAc, (hGood _).2 ?_⟩
      obtain ⟨MA, hMA⟩ := hAc.exists_bound_of_continuous hAC.continuous
      refine ⟨fun t x => x + t • (f none x • X x), MA, Eventually.of_forall fun t =>
        ⟨contDiff_id.add (hAC.const_smul t), fun x hx => ?_, fun z hz => ?_, fun x => ?_⟩,
        fun ε hε => Eventually.of_forall fun t x => ?_⟩
      · beta_reduce
        rw [image_eq_zero_of_notMem_tsupport hx, smul_zero, smul_zero, add_zero]
      · have hz0 : f none z = 0 :=
          image_eq_zero_of_notMem_tsupport fun h => (hf none h).2 (subset_closure hz)
        beta_reduce
        rw [hz0, zero_smul, smul_zero, add_zero]; exact hz
      · beta_reduce
        rw [add_sub_cancel_left, norm_smul, Real.norm_eq_abs, mul_comm]
        exact mul_le_mul_of_nonneg_right (hMA x) (abs_nonneg t)
      · have hd : HasFDerivAt (fun x => x + t • (f none x • X x)) (ContinuousLinearMap.id ℝ _ +
            t • fderiv ℝ (fun x => f none x • X x) x) x :=
          (hasFDerivAt_id x).add ((hAC.differentiable one_ne_zero x).hasFDerivAt.const_smul t)
        beta_reduce
        rw [hd.fderiv, add_sub_cancel_left, sub_self, norm_zero]
        exact mul_nonneg hε.le (abs_nonneg t)
    · exact ⟨(hfC _).smul hX, hXc.mono (support_smul_subset_right (f (some i)) X),
        hOgood i.1 (f (some i)) (hfC _) (hf (some i))⟩
  obtain ⟨-, -, hGX⟩ := Finset.sum_induction_nonempty (fun j x => f j x • X x)
    (fun A => ContDiff ℝ 1 A ∧ HasCompactSupport A ∧ Good A)
    (fun A B hA hB => ⟨hA.1.add hB.1, hA.2.1.add hB.2.1,
      gadd A B hA.1 hA.2.1 hB.1 hB.2.1 hA.2.2 hB.2.2⟩)
    Finset.univ_nonempty hpieces
  rw [hdecomp] at hGX
  -- final family: `φ_t` for good small `t` (where `‖Dφ_t - I‖ ≤ 1/2`), `id` otherwise
  obtain ⟨φ, C, hφ, hexp⟩ := (hGood X).1 hGX
  obtain ⟨MX, hMX⟩ := (hXc.fderiv ℝ).exists_bound_of_continuous (hX.continuous_fderiv one_ne_zero)
  obtain ⟨η, hη, hηU⟩ := hXc.isCompact.exists_cthickening_subset_open hU hXU
  obtain ⟨G, hG⟩ : ∃ G : ℝ → Prop, ∀ t, G t ↔ (ContDiff ℝ 1 (φ t) ∧
      (∀ x, x ∉ tsupport X → φ t x = x) ∧ MapsTo (φ t) N N ∧ ∀ x, ‖φ t x - x‖ ≤ C * |t|) ∧
      (∀ x, ‖fderiv ℝ (φ t) x - ContinuousLinearMap.id ℝ (Euclid P) - t • fderiv ℝ X x‖ ≤
        1 / 4 * |t|) ∧ |t| * 1 < 1 ∧ |t| * MX < 1 / 4 ∧ |t| * C < η := ⟨_, fun _ => Iff.rfl⟩
  have hGev : ∀ᶠ t in 𝓝 (0:ℝ), G t := by
    filter_upwards [hφ, hexp (1 / 4) (by norm_num), hev 1 1 one_pos, hev MX (1 / 4) (by norm_num),
      hev C η hη] with t h1 h2 h3 h4 h5
    exact (hG t).2 ⟨h1, h2, h3, h4, h5⟩
  refine ⟨fun t => if G t then φ t else id, fun t => ?_, fun ε hε => ?_⟩
  · by_cases ht : G t
    · simp only [ht, ↓reduceIte]
      obtain ⟨⟨h1, h2, h3, h4⟩, h5, h6, h7, h8⟩ := (hG t).1 ht
      have hD : ∀ x, ‖fderiv ℝ (φ t) x - ContinuousLinearMap.id ℝ (Euclid P)‖ ≤ 1 / 2 := by
        intro x
        have hx := (norm_le_norm_add_norm_sub' (fderiv ℝ (φ t) x - ContinuousLinearMap.id ℝ _)
          (t • fderiv ℝ X x)).trans (add_le_add le_rfl (h5 x))
        rw [norm_smul, Real.norm_eq_abs] at hx
        have := mul_le_mul_of_nonneg_left (hMX x) (abs_nonneg t)
        linarith only [hx, this, h6, h7]
      have hdiff : Differentiable ℝ (φ t) := h1.differentiable one_ne_zero
      have happrox : ApproximatesLinearOn (φ t)
          ((ContinuousLinearEquiv.refl ℝ (Euclid P) : Euclid P ≃L[ℝ] Euclid P) :
            Euclid P →L[ℝ] Euclid P) univ (1 / 2 : NNReal) := by
        intro x _ y _
        have := Convex.norm_image_sub_le_of_norm_hasFDerivWithin_le' (f := φ t)
          (φ := ContinuousLinearMap.id ℝ (Euclid P)) (s := univ)
          (fun z _ => (hdiff z).hasFDerivAt.hasFDerivWithinAt) (fun z _ => hD z) convex_univ
          (mem_univ y) (mem_univ x)
        simpa using this
      have hc : Subsingleton (Euclid P) ∨ (1 / 2 : NNReal) <
          ‖(((ContinuousLinearEquiv.refl ℝ (Euclid P)).symm : Euclid P ≃L[ℝ] Euclid P) :
            Euclid P →L[ℝ] Euclid P)‖₊⁻¹ := by
        rcases subsingleton_or_nontrivial (Euclid P) with h | h
        · exact Or.inl h
        · right; simp; norm_num
      refine ⟨h1, ⟨injOn_univ.1 (happrox.injOn hc), happrox.surjective hc⟩, fun x v w hvw => ?_,
        h2, fun x hx => ⟨h3 hx.1, ?_⟩⟩
      · have h0 := (fderiv ℝ (φ t) x - ContinuousLinearMap.id ℝ _).le_of_opNorm_le (hD x) (v - w)
        rw [sub_apply, map_sub, hvw, sub_self, zero_sub, norm_neg,
          ContinuousLinearMap.id_apply] at h0
        exact sub_eq_zero.1 (norm_le_zero_iff.1 (by linarith only [h0, norm_nonneg (v - w)]))
      · by_cases hxK : x ∈ tsupport X
        · refine hηU (mem_cthickening_of_dist_le _ x _ _ hxK ?_)
          rw [dist_eq_norm]
          exact (h4 x).trans (by rw [mul_comm]; exact h8.le)
        · rw [h2 x hxK]; exact hx.2
    · simp only [ht, ↓reduceIte]
      refine ⟨contDiff_id, bijective_id, fun x => ?_, fun x _ => rfl, fun x hx => hx⟩
      rw [fderiv_id]; exact injective_id
  · obtain ⟨δ, hδ, h⟩ := Metric.eventually_nhds_iff.1 (hGev.and (hexp ε hε))
    refine ⟨δ, hδ, fun t ht x => ?_⟩
    obtain ⟨hGt, h2⟩ := h (show dist t 0 < δ by rwa [Real.dist_eq, sub_zero])
    simp only [hGt, ↓reduceIte]
    exact h2 x

/-- **First variation bound for the mass of a deformation** (Simon Ch. 4, 2.2; Ch. 2, 5.2–5.3).
Let `R = (M, θ, ξ)`, `μ_V(W) = ∫_{M ∩ W} θ dHⁿ < ∞`, `X ∈ C¹_c` with `spt X ⊆ W`, and let `φₜ` be
`C¹` maps with `φₜ = id` off `spt X` and `‖Dφₜ − I − t DX‖ ≤ ε|t|` for small `|t|`.  If `S` acts by
`S(ω) = ∫_M θ ⟨ω(φₜx) ∘ Dφₜ(x), ξ(x)⟩ dHⁿ`, then `M_W(S) ≤ μ_V(W) + t δV(X) + ε|t|` for small `|t|`.
At a.e. `x ∈ M`, `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ` for an orthonormal basis `τ` of `TₓM` and
`div_M X(x) = Σₐ τₐ · DX(x)τₐ`, so on `W` the integrand is at most
`θ |ω|_E det(Dφₜτᵢ · Dφₜτⱼ)^{1/2} ≤ θ (1 + t div_M X + ε'|t|)`, `ε' = ε/(μ_V(W) + 1)`; off `W`,
`φₜ x = x ∉ spt ω` and the integrand vanishes.  Integrate (a non-integrable integrand has integral
`0` and the bound is nonnegative) and take the supremum over admissible `ω`. -/
theorem Submission.pushforward_action_massOn_le_first_variation : ∀ (P n : ℕ) (U W : Set (Euclid P)) (R : IMRep U n) (X : Euclid P → Euclid P) (φ : ℝ → Euclid P → Euclid P), IsOpen W → R.measure W ≠ ∞ → ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ W → (∀ t, ContDiff ℝ 1 (φ t)) → (∀ t x, x ∉ tsupport X → φ t x = x) → (∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ t : ℝ, |t| < δ → ∀ x, ‖fderiv ℝ (φ t) x - ContinuousLinearMap.id ℝ (Euclid P) - t • fderiv ℝ X x‖ ≤ ε * |t|) → ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ t : ℝ, |t| < δ → ∀ S : GeometricCurrentOn U n, (∀ ω : TestFormOn U n, S ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (φ t x)).compContinuousLinearMap (fderiv ℝ (φ t) x)) ∂μHE[n]) → S.massOn W ≤ ENNReal.ofReal ((R.measure W).toReal + t * R.firstVariation X + ε * |t|) := by
  intro P n U W R X φ hWo hRW hX hXc hXW _hφ hφid hφD ε hε
  classical
  have hDXc : Continuous (fderiv ℝ X) := hX.continuous_fderiv one_ne_zero
  -- `div_M X = trace(p_{TₓM} ∘ DX)` is a.e. strongly measurable: `p_{TₓM}` is (TM) and the trace
  -- of a composition is continuous
  have hdvm : AEStronglyMeasurable (tangentialDivergence n R.carrier X)
      (μHE[n].restrict R.carrier) := by
    have h1 : Continuous fun L : Euclid P →L[ℝ] Euclid P =>
        LinearMap.trace ℝ (Euclid P) L.toLinearMap :=
      ((LinearMap.trace ℝ (Euclid P)).comp
        (ContinuousLinearMap.coeLM ℝ)).continuous_of_finiteDimensional
    have h2 : Continuous fun pL : (Euclid P →L[ℝ] Euclid P) × (Euclid P →L[ℝ] Euclid P) =>
        LinearMap.trace ℝ (Euclid P) (pL.1.comp pL.2).toLinearMap :=
      h1.comp (continuous_fst.clm_comp continuous_snd)
    have h3 : Continuous fun pL : (Euclid P →L[ℝ] Euclid P) × (Euclid P →L[ℝ] Euclid P) =>
        LinearMap.trace ℝ (Euclid P) (pL.1.toLinearMap ∘ₗ pL.2.toLinearMap) := by
      simpa only [ContinuousLinearMap.toLinearMap_comp] using h2
    have hq := (Submission.imrep_approxTangent_starProjection_aesm P n U R).prodMk
      hDXc.aestronglyMeasurable
    have hr := h3.comp_aestronglyMeasurable hq
    exact hr
  set μ : Measure (Euclid P) := μHE[n].restrict R.carrier
  set θ : Euclid P → ℝ := fun x => (R.mult x : ℝ) with hθ
  set dv : Euclid P → ℝ := tangentialDivergence n R.carrier X
  set m : ℝ := (R.measure W).toReal with hm
  have hθ0 : ∀ x, 0 ≤ θ x := fun x => Nat.cast_nonneg _
  have hm0 : 0 ≤ m := ENNReal.toReal_nonneg
  -- `A` bounds `‖DX‖`: `DX` is continuous with compact support
  obtain ⟨C, hC⟩ := hDXc.bounded_above_of_compact_support (hXc.fderiv ℝ)
  set A : ℝ := max C 0
  have hA0 : 0 ≤ A := le_max_right _ _
  have hDXA : ∀ x, ‖fderiv ℝ X x‖ ≤ A := fun x => (hC x).trans (le_max_left _ _)
  -- constants: `ε' = ε / (m + 1)`; `η, δ₁` from the Jacobian bound at `(A, ε')`; `δ₂` from the
  -- hypothesis on `Dφₜ` at `η`
  set ε' : ℝ := ε / (m + 1) with hε'
  have hε'0 : 0 < ε' := div_pos hε (by linarith)
  obtain ⟨η, hη, δ₁, hδ₁, hJ⟩ :=
    Submission.fvmb_orthonormal_gram_sqrt_det_le_first_order P n A ε' hA0 hε'0
  obtain ⟨δ₂, hδ₂, hD⟩ := hφD η hη
  refine ⟨min δ₁ δ₂, lt_min hδ₁ hδ₂, fun t ht S hS => ?_⟩
  have ht₁ : |t| < δ₁ := ht.trans_le (min_le_left _ _)
  have ht₂ : |t| < δ₂ := ht.trans_le (min_le_right _ _)
  -- `θ 1_W` is integrable with integral `m`: `∫_{M ∩ W} θ dHⁿ = μ_V(W) < ∞`
  have hWm : MeasurableSet W := hWo.measurableSet
  have hθm : Measurable θ :=
    (measurable_from_nat (f := (Nat.cast : ℕ → ℝ))).comp R.measurable_mult
  have hRW' : R.measure W = ∫⁻ x in W, (R.mult x : ℝ≥0∞) ∂μ := withDensity_apply _ hWm
  have hθW : Integrable (W.indicator θ) μ := by
    rw [integrable_indicator_iff hWm]
    have := integrable_toReal_of_lintegral_ne_top (μ := μ.restrict W)
      (f := fun x => (R.mult x : ℝ≥0∞))
      ((measurable_from_nat (f := (Nat.cast : ℕ → ℝ≥0∞))).comp R.measurable_mult).aemeasurable
      (hRW' ▸ hRW)
    simpa [IntegrableOn, hθ] using this
  have hmW : ∫ x, W.indicator θ x ∂μ = m := by
    rw [integral_indicator hWm, integral_eq_lintegral_of_nonneg_ae (ae_of_all _ hθ0)
      hθm.aestronglyMeasurable, hm, hRW']
    simp only [hθ, ENNReal.ofReal_natCast]
  -- fix an admissible form `ω`; `g` is the integrand of `S(ω)` and `h` its majorant
  apply sSup_le
  rintro r ⟨ω, ⟨hωW, hω1⟩, rfl⟩
  apply ENNReal.ofReal_le_ofReal
  rw [hS ω]
  obtain ⟨g, hg⟩ : ∃ g : Euclid P → ℝ, g = fun x => (R.mult x : ℝ) * R.orient x
      (((ω : DifferentialForm (Euclid P) n) (φ t x)).compContinuousLinearMap
        (fderiv ℝ (φ t) x)) := ⟨_, rfl⟩
  obtain ⟨h, hh⟩ : ∃ h : Euclid P → ℝ,
      h = fun x => W.indicator θ x * (1 + ε' * |t|) + t * (θ x * dv x) := ⟨_, rfl⟩
  -- pointwise bounds at the a.e. points where `ξ(x)` orients `TₓM`
  have key : ∀ᵐ x ∂μ,
      g x ≤ h x ∧ 0 ≤ h x ∧ ‖θ x * dv x‖ ≤ ((n : ℝ) * A) * W.indicator θ x := by
    filter_upwards [Submission.fvmb_imrep_ae_unitOrientation_approxTangentPlane P n U R]
      with x hx
    obtain ⟨τ, hτ, hspan, hsign⟩ := hx
    -- `div_M X(x) = Σₐ τₐ · DX(x)τₐ`, hence `|div_M X(x)| ≤ nA`
    have hdvx : dv x = ∑ a, inner ℝ (τ a) (fderiv ℝ X x (τ a)) :=
      Submission.fvmb_trace_starProjection_comp_eq_sum_inner P n _ τ (fderiv ℝ X x) hτ hspan
    have hdvA : |dv x| ≤ n * A := by
      rw [hdvx]
      calc |∑ a, inner ℝ (τ a) (fderiv ℝ X x (τ a))|
          ≤ ∑ a, |inner ℝ (τ a) (fderiv ℝ X x (τ a))| := Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ _a : Fin n, A := Finset.sum_le_sum fun a _ => by
          calc |inner ℝ (τ a) (fderiv ℝ X x (τ a))|
              ≤ ‖τ a‖ * ‖fderiv ℝ X x (τ a)‖ := abs_real_inner_le_norm _ _
            _ ≤ ‖τ a‖ * (‖fderiv ℝ X x‖ * ‖τ a‖) :=
              mul_le_mul_of_nonneg_left (ContinuousLinearMap.le_opNorm _ _) (norm_nonneg _)
            _ ≤ A := by rw [hτ.1 a, one_mul, mul_one]; exact hDXA x
        _ = n * A := by simp
    by_cases hxW : x ∈ W
    · -- in `W`, with `β = ω(φₜx) ∘ Dφₜ(x)`:
      -- `|ξ(x)(β)| = |ω(φₜx)(Dφₜτ)| ≤ |ω|_E det(Dφₜτᵢ · Dφₜτⱼ)^{1/2} ≤ 1 + t div_M X + ε'|t|`
      obtain ⟨β, hβ⟩ : ∃ β : Covector (Euclid P) n,
          β = ((ω : DifferentialForm (Euclid P) n) (φ t x)).compContinuousLinearMap
            (fderiv ℝ (φ t) x) := ⟨_, rfl⟩
      have hξ : |R.orient x β| =
          |(ω : DifferentialForm (Euclid P) n) (φ t x) fun i => fderiv ℝ (φ t) x (τ i)| := by
        rcases hsign with hs | hs
        · rw [hs, hβ, ContinuousAlternatingMap.compContinuousLinearMap_apply]
          rfl
        · rw [hs, abs_neg, hβ, ContinuousAlternatingMap.compContinuousLinearMap_apply]
          rfl
      have hJx := hJ t ht₁ (fderiv ℝ X x) (fderiv ℝ (φ t) x) (hDXA x) (hD t ht₂ x) τ hτ
      rw [← hdvx] at hJx
      have hbound : |R.orient x β| ≤ 1 + t * dv x + ε' * |t| := by
        rw [hξ]
        refine ((Submission.covectorEuclideanNorm_gram_bounds P n).1 _ _).trans ?_
        exact (mul_le_of_le_one_left (Real.sqrt_nonneg _) (hω1 _)).trans hJx
      have hgx : g x = θ x * R.orient x β := by
        rw [hg, hβ]
      have hhx : h x = θ x * (1 + t * dv x + ε' * |t|) := by
        simp only [hh, Set.indicator_of_mem hxW]
        ring
      refine ⟨?_, ?_, ?_⟩
      · rw [hgx, hhx]
        exact mul_le_mul_of_nonneg_left ((le_abs_self _).trans hbound) (hθ0 x)
      · rw [hhx]
        exact mul_nonneg (hθ0 x) ((abs_nonneg _).trans hbound)
      · rw [Set.indicator_of_mem hxW, Real.norm_eq_abs, abs_mul, abs_of_nonneg (hθ0 x)]
        calc θ x * |dv x| ≤ θ x * (n * A) := mul_le_mul_of_nonneg_left hdvA (hθ0 x)
          _ = n * A * θ x := by ring
    · -- off `W`: `x ∉ spt X`, so `DX(x) = 0` and `φₜ x = x ∉ spt ω`
      have hxX : x ∉ tsupport X := fun hx => hxW (hXW hx)
      have hdv0 : dv x = 0 := by
        rw [hdvx, fderiv_of_notMem_tsupport ℝ hxX]
        simp
      have hω0 : (ω : DifferentialForm (Euclid P) n) (φ t x) = 0 := by
        rw [hφid t x hxX]
        exact image_eq_zero_of_notMem_tsupport fun hx => hxW (hωW hx)
      have hz : (0 : Covector (Euclid P) n).compContinuousLinearMap (fderiv ℝ (φ t) x) = 0 := by
        ext v
        simp
      have hg0 : g x = 0 := by
        simp only [hg, hω0, hz, map_zero, mul_zero]
      have hh0 : h x = 0 := by
        simp only [hh, Set.indicator_of_notMem hxW, hdv0, zero_mul, mul_zero, add_zero]
      refine ⟨by rw [hg0, hh0], by rw [hh0], ?_⟩
      rw [hdv0, Set.indicator_of_notMem hxW]
      simp
  -- integrate: `∫ g ≤ ∫ h = m (1 + ε'|t|) + t δV(X)` and `m ε' ≤ ε`
  have hθdv : Integrable (fun x => θ x * dv x) μ :=
    (hθW.const_mul ((n : ℝ) * A)).mono' (hθm.aestronglyMeasurable.mul hdvm)
      (key.mono fun x hx => hx.2.2)
  have hhint : Integrable h μ := by
    rw [hh]
    exact (hθW.mul_const _).add (hθdv.const_mul t)
  have hint_h : ∫ x, h x ∂μ = m * (1 + ε' * |t|) + t * R.firstVariation X := by
    simp only [hh]
    rw [integral_add (hθW.mul_const _) (hθdv.const_mul t), integral_mul_const,
      integral_const_mul, hmW]
    rfl
  have hgh : ∫ x, g x ∂μ ≤ ∫ x, h x ∂μ := by
    by_cases hgi : Integrable g μ
    · exact integral_mono_ae hgi hhint (key.mono fun x hx => hx.1)
    · rw [integral_undef hgi]
      exact integral_nonneg_of_ae (key.mono fun x hx => hx.2.1)
  have hεm : m * ε' ≤ ε := by
    rw [hε', mul_div_assoc', div_le_iff₀ (by linarith)]
    nlinarith
  have hεm' : m * ε' * |t| ≤ ε * |t| := mul_le_mul_of_nonneg_right hεm (abs_nonneg t)
  calc ∫ x, (R.mult x : ℝ) * R.orient x
        (((ω : DifferentialForm (Euclid P) n) (φ t x)).compContinuousLinearMap
          (fderiv ℝ (φ t) x)) ∂μ = ∫ x, g x ∂μ := by rw [hg]
    _ ≤ ∫ x, h x ∂μ := hgh
    _ = m * (1 + ε' * |t|) + t * R.firstVariation X := hint_h
    _ = m + t * R.firstVariation X + m * ε' * |t| := by ring
    _ ≤ m + t * R.firstVariation X + ε * |t| := by linarith

/-- **The weight of a cone is homogeneous of degree `n`** (proof of Simon 7.4.5,
chapter-07.txt lines 697–699, "by virtue of the fact that `C` is a cone").  If the cone `C` is
represented by `R = (M, θ, ξ)` with weight `μ = θHⁿ⌞M` and `λ > 0`, then `μ(λA) = λⁿ μ(A)` for
every Borel `A`.  The dilated triple `R_λ = (λ⁻¹M, θ(λ·), ξ(λ·))` is integer multiplicity, and
`R_λ(ω) = R(λ⁻ⁿ ω(λ⁻¹·)) = C(λ⁻ⁿ ω(λ⁻¹·)) = C(ω)` as `η_{0,λ#}C = C`, so `R_λ` represents `C`.
By the uniqueness of the weight (Simon Ch. 6, 3.2(3)), `μ(A) = μ_{R_λ}(A) = λ⁻ⁿ μ(λA)`. -/
theorem Submission.cone_current_imrep_measure_smul_image : ∀ (P n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n), IsConeCurrent C → R.Represents C → ∀ lam : ℝ, 0 < lam → ∀ A : Set (Euclid P), MeasurableSet A → R.measure ((fun x => lam • x) '' A) = ENNReal.ofReal (lam ^ n) * R.measure A := by
  intro P n C R hC hR lam hlam A hA
  -- Step 1: the dilated triple `R_λ = (λ⁻¹M, θ(λ·), ξ(λ·))` is integer multiplicity, with
  -- `R_λ(ω) = R(λ⁻ⁿ ω(λ⁻¹·))` for every form `ω` and `μ_{R_λ}(A) = λ⁻ⁿ μ(λA)` for Borel `A`
  obtain ⟨Rl, hcar, hmult, horient⟩ := Submission.imrep_univ_smul_rescale_exists P n R lam hlam
  obtain ⟨haction, hmeasure⟩ :=
    Submission.imrep_smul_rescale_action_measure P n R Rl lam hlam hcar hmult horient
  -- Step 2: `R_λ` represents `C`: `C(ω) = C(ω') = R(ω') = R_λ(ω)` for `ω' = λ⁻ⁿ ω(λ⁻¹·)`
  have hRl : Rl.Represents C := by
    intro ω
    obtain ⟨ω', hω', hCω'⟩ := Submission.cone_current_apply_dilation_pullback P n C hC lam hlam ω
    rw [← hCω', hR ω', haction]
    congr 1
    funext y
    exact hω' y
  -- Step 3: the weight does not depend on the representation, so `μ_{R_λ} = μ` and
  -- `μ(A) = λ⁻ⁿ μ(λA)`
  have hA' := hmeasure A hA
  rw [Submission.imrep_measure_eq_of_represents_same_current P n univ C Rl R isOpen_univ hRl hR]
    at hA'
  -- Step 4: multiply by `λⁿ`, using `λⁿ λ⁻ⁿ = 1`
  have hpow : ENNReal.ofReal (lam ^ n) * ENNReal.ofReal (lam⁻¹ ^ n) = 1 := by
    rw [← ENNReal.ofReal_mul (pow_nonneg hlam.le n), ← mul_pow, mul_inv_cancel₀ hlam.ne', one_pow,
      ENNReal.ofReal_one]
  rw [hA', ← mul_assoc, hpow, one_mul]
/-- **Planar fibre geometry** (fibre count for the cone-sector endpoint density in the proof of
Simon 7.3.3).  Let `Q ⊆ ℝᴾ` be a plane with orthonormal basis `a, e`, `π = Q.starProjection`,
`Ax = ⟨x, a⟩e − ⟨x, e⟩a` and `f(x) = arctan(⟨x, e⟩/⟨x, a⟩)`.  Then (a) `|p_T(Ax)| ≤ |πx| ≤ |x|`
for every subspace `T`; (b) for `t > 0` and `|α| < Real.pi/2`, the point
`x₀ = t(cos α a + sin α e)` has `⟨x₀, a⟩ > 0`, `|x₀| = t`, `f(x₀) = α`, `πx₀ = x₀` and
`|π(Ax₀)| = t`; (c) every other `x` with `⟨x, a⟩ > 0`, `|x| = t` and `f(x) = α` has `|πx| < t`.
A dimension count gives `Q = span{a, e}`, hence `πx = ⟨x, a⟩a + ⟨x, e⟩e` and `|Ax| = |πx|`; in
(c), `|πx| = |x|` would give `x ∈ Q`, `x = ua + ve` with `u² + v² = t²`, and then `cos α = u/t`,
`sin α = v/t` force `x = x₀`. -/
theorem Submission.idtp_cse_fc_planar_fibre_geometry : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P), Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → (∀ (T : Submodule ℝ (Euclid P)) (x : Euclid P), ‖T.starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ≤ ‖Q.starProjection x‖ ∧ ‖Q.starProjection x‖ ≤ ‖x‖) ∧ ∀ t α : ℝ, 0 < t → |α| < Real.pi / 2 → (0 < inner ℝ (t • (Real.cos α • a + Real.sin α • e)) a ∧ ‖t • (Real.cos α • a + Real.sin α • e)‖ = t ∧ Real.arctan (inner ℝ (t • (Real.cos α • a + Real.sin α • e)) e / inner ℝ (t • (Real.cos α • a + Real.sin α • e)) a) = α ∧ Q.starProjection (t • (Real.cos α • a + Real.sin α • e)) = t • (Real.cos α • a + Real.sin α • e) ∧ ‖Q.starProjection (inner ℝ (t • (Real.cos α • a + Real.sin α • e)) a • e - inner ℝ (t • (Real.cos α • a + Real.sin α • e)) e • a)‖ = t) ∧ ∀ x : Euclid P, 0 < inner ℝ x a → ‖x‖ = t → Real.arctan (inner ℝ x e / inner ℝ x a) = α → x ≠ t • (Real.cos α • a + Real.sin α • e) → ‖Q.starProjection x‖ < t := by
  intro P Q a e hQ haQ heQ ha he hae
  -- Step 1: the Gram matrix of `(a, e)`
  have haa : inner ℝ a a = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, ha, one_pow]
  have hee : inner ℝ e e = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, he, one_pow]
  have hea : inner ℝ e a = (0 : ℝ) := by rw [real_inner_comm, hae]
  -- Step 2: `Q = span {a, e}` by a dimension count, so every `w ∈ Q` is `c₁ a + c₂ e`
  have hQmem : ∀ w ∈ Q, ∃ c₁ c₂ : ℝ, w = c₁ • a + c₂ • e := by
    have hon : Orthonormal ℝ ![a, e] := by
      rw [orthonormal_iff_ite]
      intro i j
      fin_cases i <;> fin_cases j <;> simp [ha, he, hae, hea]
    have hspan : Submodule.span ℝ (Set.range ![a, e]) = Q := by
      refine Submodule.eq_of_le_of_finrank_eq ?_ ?_
      · rw [Submodule.span_le, Set.range_subset_iff]
        intro i
        fin_cases i
        · simpa using haQ
        · simpa using heQ
      · rw [finrank_span_eq_card hon.linearIndependent, hQ, Fintype.card_fin]
    intro w hw
    rw [← hspan, Submodule.mem_span_range_iff_exists_fun] at hw
    obtain ⟨c, rfl⟩ := hw
    exact ⟨c 0, c 1, by simp [Fin.sum_univ_two]⟩
  -- Step 3: `πx = ⟨x, a⟩ a + ⟨x, e⟩ e`
  have hproj : ∀ x : Euclid P, Q.starProjection x = inner ℝ x a • a + inner ℝ x e • e := by
    intro x
    refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero
      (Q.add_mem (Q.smul_mem _ haQ) (Q.smul_mem _ heQ)) fun w hw => ?_
    obtain ⟨c₁, c₂, rfl⟩ := hQmem w hw
    simp only [inner_sub_left, inner_add_left, inner_add_right, real_inner_smul_left,
      real_inner_smul_right, haa, hee, hae, hea]
    ring
  -- Step 4: `‖u e − v a‖² = u² + v² = ‖u a + v e‖²`, hence `‖Ax‖ = ‖πx‖`
  have hnormA : ∀ u v : ℝ, ‖u • e - v • a‖ ^ 2 = u ^ 2 + v ^ 2 := by
    intro u v
    rw [← real_inner_self_eq_norm_sq]
    simp only [inner_sub_left, inner_sub_right, real_inner_smul_left, real_inner_smul_right, haa,
      hee, hae, hea]
    ring
  have hnormP : ∀ u v : ℝ, ‖u • a + v • e‖ ^ 2 = u ^ 2 + v ^ 2 := by
    intro u v
    rw [← real_inner_self_eq_norm_sq]
    simp only [inner_add_left, inner_add_right, real_inner_smul_left, real_inner_smul_right, haa,
      hee, hae, hea]
    ring
  have hAx : ∀ x : Euclid P, ‖inner ℝ x a • e - inner ℝ x e • a‖ = ‖Q.starProjection x‖ := by
    intro x
    rw [hproj x]
    exact (pow_left_inj₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).1
      ((hnormA _ _).trans (hnormP _ _).symm)
  -- Step 5: part (a)
  refine ⟨fun T x => ⟨(T.norm_starProjection_apply_le _).trans (hAx x).le,
    Q.norm_starProjection_apply_le x⟩, fun t α ht hα => ?_⟩
  -- Step 6: part (b)
  obtain ⟨hα₁, hα₂⟩ := abs_lt.1 hα
  have hcos : 0 < Real.cos α := Real.cos_pos_of_mem_Ioo ⟨hα₁, hα₂⟩
  have hx₀Q : t • (Real.cos α • a + Real.sin α • e) ∈ Q :=
    Q.smul_mem t (Q.add_mem (Q.smul_mem _ haQ) (Q.smul_mem _ heQ))
  have hx₀a : inner ℝ (t • (Real.cos α • a + Real.sin α • e)) a = t * Real.cos α := by
    simp only [real_inner_smul_left, inner_add_left, haa, hea]
    ring
  have hx₀e : inner ℝ (t • (Real.cos α • a + Real.sin α • e)) e = t * Real.sin α := by
    simp only [real_inner_smul_left, inner_add_left, hee, hae]
    ring
  have hx₀n : ‖t • (Real.cos α • a + Real.sin α • e)‖ = t := by
    have h1 : ‖Real.cos α • a + Real.sin α • e‖ = 1 :=
      (pow_left_inj₀ (norm_nonneg _) zero_le_one two_ne_zero).1
        (by rw [hnormP, Real.cos_sq_add_sin_sq, one_pow])
    rw [norm_smul, h1, mul_one, Real.norm_eq_abs, abs_of_pos ht]
  refine ⟨⟨?_, hx₀n, ?_, Submodule.starProjection_eq_self_iff.2 hx₀Q, ?_⟩, ?_⟩
  · rw [hx₀a]
    exact mul_pos ht hcos
  · rw [hx₀a, hx₀e, mul_div_mul_left _ _ ht.ne', ← Real.tan_eq_sin_div_cos,
      Real.arctan_tan hα₁ hα₂]
  · rw [Submodule.starProjection_eq_self_iff.2 (Q.sub_mem (Q.smul_mem _ heQ) (Q.smul_mem _ haQ)),
      hAx, Submodule.starProjection_eq_self_iff.2 hx₀Q, hx₀n]
  -- Steps 7–8: part (c)
  · intro x hxa hxt hxα hne
    refine not_le.1 fun hlt => ?_
    have hπx : ‖Q.starProjection x‖ = ‖x‖ :=
      le_antisymm (Q.norm_starProjection_apply_le x) (by rw [hxt]; exact hlt)
    have hx : x = inner ℝ x a • a + inner ℝ x e • e := by
      rw [← hproj x,
        Submodule.starProjection_eq_self_iff.2 ((Q.mem_iff_norm_starProjection x).2 hπx)]
    have huv : inner ℝ x a ^ 2 + inner ℝ x e ^ 2 = t ^ 2 := by
      rw [← hnormP, ← hx, hxt]
    have hu0 : inner ℝ x a ≠ 0 := hxa.ne'
    have hsqrt : √(1 + (inner ℝ x e / inner ℝ x a) ^ 2) = t / inner ℝ x a := by
      rw [← Real.sqrt_sq (div_pos ht hxa).le]
      congr 1
      field_simp
      linarith [huv]
    have hcosα : Real.cos α = inner ℝ x a / t := by
      rw [← hxα, Real.cos_arctan, hsqrt, one_div_div]
    have hsinα : Real.sin α = inner ℝ x e / t := by
      rw [← hxα, Real.sin_arctan, hsqrt]
      field_simp
    apply hne
    rw [hcosα, hsinα, smul_add, smul_smul, smul_smul, mul_div_cancel₀ _ ht.ne',
      mul_div_cancel₀ _ ht.ne']
    exact hx

/-- **The tangential rotation ratio of an integer multiplicity triple is measurable**
(Simon 7.3.3, proof; Ch. 6, 3.1).  For `R = (M, θ, ξ)` with weight `μ = θ Hⁿ⌞M`, a subspace `Q`
with projection `π` and `A x = ⟨x, a⟩ e − ⟨x, e⟩ a`, the ratio `|p_{TₓM}(A x)|² / |π x|²` is
`μ`-a.e. strongly measurable: `x ↦ p_{TₓM}` is `Hⁿ⌞M`-a.e. strongly measurable, hence
`μ`-a.e. strongly measurable as `μ ≪ Hⁿ⌞M`; evaluation at the continuous field `A` is continuous
bilinear, `|π x|²` is continuous, and real division (`t / 0 = 0`) is measurable. -/
theorem Submission.idtp_cse_fd_fs_frame_ratio_aesm : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P), AEStronglyMeasurable (fun x : Euclid P => ‖(approxTangentPlane n R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2) R.measure := by
  intro P n U R Q a e
  -- `x ↦ p_{TₓM}` is `μ`-a.e. strongly measurable, since `μ = (Hⁿ⌞M).withDensity θ ≪ Hⁿ⌞M`
  have hT : AEStronglyMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection)
      R.measure :=
    (Submission.imrep_approxTangent_starProjection_aesm P n U R).mono_ac
      (withDensity_absolutelyContinuous _ _)
  -- evaluation `(L, v) ↦ L v` at the continuous field `A x = ⟨x, a⟩ e − ⟨x, e⟩ a`
  have hA : Continuous fun x : Euclid P => inner ℝ x a • e - inner ℝ x e • a := by fun_prop
  have hN : AEStronglyMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection
      (inner ℝ x a • e - inner ℝ x e • a)) R.measure :=
    (ContinuousLinearMap.id ℝ (Euclid P →L[ℝ] Euclid P)).aestronglyMeasurable_comp₂ hT
      hA.aestronglyMeasurable
  -- the denominator `|π x|²` is continuous, and real division is measurable
  have hD : Continuous fun x : Euclid P => ‖Q.starProjection x‖ ^ 2 := by fun_prop
  exact (hN.norm.fun_pow 2).aemeasurable.fun_div hD.measurable.aemeasurable |>.aestronglyMeasurable
/-- **Transfer of a push-forward density identity.**  Let `ν` be a finite measure on `X`,
`φ : X → ℝ²` measurable, `g` `ν`-a.e. strongly measurable with `0 ≤ g ≤ 1` `ν`-a.e., and
`H : ℝ² → [0, ∞]` a.e.-measurable with `∫ b H dp = ∫ (b ∘ φ) g dν` for every Borel `b ≥ 0`.  Then
`H < ∞` a.e., `H` is integrable, `∫ b H dp = ∫ (b ∘ φ) g dν` for every bounded Borel
`b : ℝ² → ℝ`, and `∫_S H dp = ∫_{φ⁻¹(S)} g dν` for every Borel `S`.  Taking `b ≡ 1` gives
`∫ H dp ≤ ν(X) < ∞`; for a Borel `0 ≤ β ≤ M` both sides are integrable and their lower integrals
agree (`b = ofReal ∘ β`); a bounded `b` is `max(b, 0) − max(−b, 0)`; and `b = 1_S` gives the set
identity. -/
theorem Submission.idtp_cse_fd_fs_pushforward_signed_transfer : ∀ (X : Type) [MeasurableSpace X] (ν : Measure X) (φ : X → ℝ × ℝ) (g : X → ℝ) (H : ℝ × ℝ → ℝ≥0∞), ν univ ≠ ∞ → Measurable φ → AEStronglyMeasurable g ν → (∀ᵐ x ∂ν, 0 ≤ g x ∧ g x ≤ 1) → AEMeasurable H volume → (∀ b : ℝ × ℝ → ℝ≥0∞, Measurable b → ∫⁻ p : ℝ × ℝ, b p * H p = ∫⁻ x, b (φ x) * ENNReal.ofReal (g x) ∂ν) → (∀ᵐ p : ℝ × ℝ, H p ≠ ∞) ∧ Integrable (fun p : ℝ × ℝ => (H p).toReal) ∧ (∀ b : ℝ × ℝ → ℝ, Measurable b → (∃ M : ℝ, ∀ p, |b p| ≤ M) → ∫ p : ℝ × ℝ, b p * (H p).toReal = ∫ x, b (φ x) * g x ∂ν) ∧ ∀ S : Set (ℝ × ℝ), MeasurableSet S → ∫⁻ p in S, H p = ∫⁻ x in φ ⁻¹' S, ENNReal.ofReal (g x) ∂ν := by
  intro X _ ν φ g H hν hφ hg hg01 hH htr
  have : IsFiniteMeasure ν := ⟨lt_top_iff_ne_top.mpr hν⟩
  -- the identity with `b ≡ 1`, and `∫ ofReal g dν ≤ ν(X) < ∞` since `g ≤ 1` a.e.
  have hfin : ∫⁻ p : ℝ × ℝ, H p ≠ ∞ := by
    have h1 := htr (fun _ => 1) measurable_const
    simp only [one_mul] at h1
    rw [h1]
    refine ne_top_of_le_ne_top hν ?_
    calc ∫⁻ x, ENNReal.ofReal (g x) ∂ν ≤ ∫⁻ _, 1 ∂ν :=
          lintegral_mono_ae (hg01.mono fun x hx => ENNReal.ofReal_le_one.mpr hx.2)
      _ = ν univ := lintegral_one
  -- (i) and (ii)
  have hi : ∀ᵐ p : ℝ × ℝ, H p ≠ ∞ := (ae_lt_top' hH hfin).mono fun p hp => hp.ne
  have hii : Integrable (fun p : ℝ × ℝ => (H p).toReal) :=
    integrable_toReal_of_lintegral_ne_top hH hfin
  -- the signed identity for a Borel `β` with `0 ≤ β ≤ M`, via lower integrals
  have hpos : ∀ β : ℝ × ℝ → ℝ, Measurable β → ∀ M : ℝ, (∀ p, 0 ≤ β p ∧ β p ≤ M) →
      Integrable (fun p => β p * (H p).toReal) ∧ Integrable (fun x => β (φ x) * g x) ν ∧
      ∫ p : ℝ × ℝ, β p * (H p).toReal = ∫ x, β (φ x) * g x ∂ν := by
    intro β hβ M hβM
    have hint1 : Integrable (fun p => β p * (H p).toReal) :=
      hii.bdd_mul hβ.aestronglyMeasurable (Eventually.of_forall fun p => by
        rw [Real.norm_eq_abs, abs_of_nonneg (hβM p).1]
        exact (hβM p).2)
    have hint2 : Integrable (fun x => β (φ x) * g x) ν := by
      refine Integrable.of_bound ((hβ.comp hφ).aestronglyMeasurable.mul hg) M ?_
      filter_upwards [hg01] with x hx
      rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (hβM (φ x)).1 hx.1)]
      calc β (φ x) * g x ≤ M * 1 :=
            mul_le_mul (hβM (φ x)).2 hx.2 hx.1 ((hβM (φ x)).1.trans (hβM (φ x)).2)
        _ = M := mul_one M
    refine ⟨hint1, hint2, ?_⟩
    rw [integral_eq_lintegral_of_nonneg_ae
        (Eventually.of_forall fun p => mul_nonneg (hβM p).1 ENNReal.toReal_nonneg)
        hint1.aestronglyMeasurable,
      integral_eq_lintegral_of_nonneg_ae (hg01.mono fun x hx => mul_nonneg (hβM (φ x)).1 hx.1)
        hint2.aestronglyMeasurable]
    congr 1
    calc ∫⁻ p, ENNReal.ofReal (β p * (H p).toReal)
        = ∫⁻ p, ENNReal.ofReal (β p) * H p := by
          refine lintegral_congr_ae ?_
          filter_upwards [hi] with p hp
          rw [ENNReal.ofReal_mul (hβM p).1, ENNReal.ofReal_toReal hp]
      _ = ∫⁻ x, ENNReal.ofReal (β (φ x)) * ENNReal.ofReal (g x) ∂ν :=
          htr (fun p => ENNReal.ofReal (β p)) (ENNReal.measurable_ofReal.comp hβ)
      _ = ∫⁻ x, ENNReal.ofReal (β (φ x) * g x) ∂ν := by
          refine lintegral_congr fun x => ?_
          rw [ENNReal.ofReal_mul (hβM (φ x)).1]
  refine ⟨hi, hii, ?_, ?_⟩
  · -- (iii): split `b = max b 0 - max (-b) 0`
    rintro b hb ⟨M, hM⟩
    have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
    obtain ⟨i1, i2, e1⟩ := hpos (fun p => max (b p) 0) (hb.max measurable_const) M
      fun p => ⟨le_max_right _ _, max_le ((le_abs_self _).trans (hM p)) hM0⟩
    obtain ⟨i3, i4, e2⟩ := hpos (fun p => max (-b p) 0) (hb.neg.max measurable_const) M
      fun p => ⟨le_max_right _ _, max_le ((neg_le_abs _).trans (hM p)) hM0⟩
    calc ∫ p, b p * (H p).toReal
        = ∫ p, (max (b p) 0 * (H p).toReal - max (-b p) 0 * (H p).toReal) := by
          refine integral_congr_ae (Eventually.of_forall fun p => ?_)
          dsimp only
          rw [← sub_mul, max_zero_sub_eq_self]
      _ = (∫ p, max (b p) 0 * (H p).toReal) - ∫ p, max (-b p) 0 * (H p).toReal :=
          integral_sub i1 i3
      _ = (∫ x, max (b (φ x)) 0 * g x ∂ν) - ∫ x, max (-b (φ x)) 0 * g x ∂ν := by rw [e1, e2]
      _ = ∫ x, (max (b (φ x)) 0 * g x - max (-b (φ x)) 0 * g x) ∂ν := (integral_sub i2 i4).symm
      _ = ∫ x, b (φ x) * g x ∂ν := by
          refine integral_congr_ae (Eventually.of_forall fun x => ?_)
          dsimp only
          rw [← sub_mul, max_zero_sub_eq_self]
  · -- (iv): the identity with `b = 1_S`
    intro S hS
    have key := htr (S.indicator 1) (measurable_one.indicator hS)
    calc ∫⁻ p in S, H p = ∫⁻ p, S.indicator H p := (lintegral_indicator hS H).symm
      _ = ∫⁻ p, S.indicator 1 p * H p := by
          refine lintegral_congr fun p => ?_
          by_cases hp : p ∈ S <;> simp [hp]
      _ = ∫⁻ x, S.indicator 1 (φ x) * ENNReal.ofReal (g x) ∂ν := key
      _ = ∫⁻ x, (φ ⁻¹' S).indicator (fun x => ENNReal.ofReal (g x)) x ∂ν := by
          refine lintegral_congr fun x => ?_
          by_cases hx : φ x ∈ S <;> simp [hx]
      _ = ∫⁻ x in φ ⁻¹' S, ENNReal.ofReal (g x) ∂ν := lintegral_indicator (hφ hS) _

/-- **Signed fibre identity** (flux density for the cone-sector endpoint density in the proof of
Simon 7.3.3).  Let `R = (M, θ, ξ)` be a `2`-dimensional integer multiplicity triple in `ℝᴾ`,
`μ = θ H²⌞M`, `Q` a plane with orthonormal basis `a, e`, `π = Q.starProjection`,
`Ax = ⟨x, a⟩e − ⟨x, e⟩a`, `G(x) = |p_{TₓM}(Ax)|² / |πx|²`, `f(x) = arctan(⟨x, e⟩/⟨x, a⟩)`,
`F̃(x) = (|x|, f(x))` and
`Z(s, s') = {x : ⟨x, a⟩ > 0, ||x| − 1| < s', |f(x)| < s', |x − πx| < s|x|}`.  If
`∫ b H = ∫_{Z(s, s)} b(F̃) G dμ` for every Borel `b : ℝ² → [0, ∞]`, then `H < ∞` a.e., `H` is
integrable, the identity holds for bounded signed Borel `b`, and
`∫_{(1 − s', 1 + s') × (−s', s')} H = ∫_{Z(s, s')} G dμ` for `s' ≤ s`.  Self-adjointness of `π`
and Bessel's inequality for `a, e` give `|p_T(Ax)|² ≤ |Ax|² ≤ |πx|²`, so `0 ≤ G ≤ 1`
(`t / 0 = 0`); `Z(s, s) ⊆ B̄_{1+|s|}(0)` has finite `μ`-measure, so the push-forward transfer
applies to `μ⌞Z(s, s)`, and `F̃⁻¹((1 − s', 1 + s') × (−s', s')) ∩ Z(s, s) = Z(s, s')`. -/
theorem Submission.idtp_cse_fd_fibre_signed_identity : ∀ (P : ℕ) (R : IMRep (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (s : ℝ) (H : ℝ × ℝ → ℝ≥0∞), Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → AEMeasurable H volume → (∀ b : ℝ × ℝ → ℝ≥0∞, Measurable b → ∫⁻ p : ℝ × ℝ, b p * H p = ∫⁻ x in {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖}, b (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a)) * ENNReal.ofReal (‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2) ∂R.measure) → (∀ᵐ p : ℝ × ℝ, H p ≠ ∞) ∧ Integrable (fun p : ℝ × ℝ => (H p).toReal) ∧ (∀ b : ℝ × ℝ → ℝ, Measurable b → (∃ M : ℝ, ∀ p, |b p| ≤ M) → ∫ p : ℝ × ℝ, b p * (H p).toReal = ∫ x in {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖}, b (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a)) * (‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2) ∂R.measure) ∧ ∀ s' : ℝ, s' ≤ s → ∫⁻ p in Ioo (1 - s') (1 + s') ×ˢ Ioo (-s') s', H p = ∫⁻ x in {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s' ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' ∧ ‖x - Q.starProjection x‖ < s * ‖x‖}, ENNReal.ofReal (‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2) ∂R.measure := by
  intro P R Q a e s H hQ haQ heQ ha he hae hHm hH
  -- `Z = Z(s, s)`
  set Z : Set (Euclid P) := {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧
    |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} with hZ
  -- Step 1: the frame bound `|p_T(Ax)|² ≤ |Ax|² = ⟨πx, a⟩² + ⟨πx, e⟩² ≤ |πx|²`
  have haa : inner ℝ a a = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, ha, one_pow]
  have hee : inner ℝ e e = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, he, one_pow]
  have hea : inner ℝ e a = (0 : ℝ) := by rw [real_inner_comm, hae]
  have hframe : ∀ (T : Submodule ℝ (Euclid P)) (x : Euclid P),
      ‖T.starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 ≤ ‖Q.starProjection x‖ ^ 2 := by
    intro T x
    -- `π` is self-adjoint and fixes `a, e ∈ Q`
    have hya : inner ℝ (Q.starProjection x) a = inner ℝ x a := by
      rw [Submodule.inner_starProjection_left_eq_right,
        Submodule.starProjection_eq_self_iff.2 haQ]
    have hye : inner ℝ (Q.starProjection x) e = inner ℝ x e := by
      rw [Submodule.inner_starProjection_left_eq_right,
        Submodule.starProjection_eq_self_iff.2 heQ]
    have hA : ∀ u v : ℝ, ‖u • e - v • a‖ ^ 2 = u ^ 2 + v ^ 2 := by
      intro u v
      rw [← real_inner_self_eq_norm_sq]
      simp only [inner_sub_left, inner_sub_right, real_inner_smul_left, real_inner_smul_right,
        haa, hee, hae, hea]
      ring
    -- Bessel: `0 ≤ |y − ⟨y, a⟩a − ⟨y, e⟩e|² = |y|² − ⟨y, a⟩² − ⟨y, e⟩²`
    have hB : ∀ y : Euclid P, inner ℝ y a ^ 2 + inner ℝ y e ^ 2 ≤ ‖y‖ ^ 2 := by
      intro y
      have h : ‖y - (inner ℝ y a • a + inner ℝ y e • e)‖ ^ 2 =
          ‖y‖ ^ 2 - (inner ℝ y a ^ 2 + inner ℝ y e ^ 2) := by
        rw [← real_inner_self_eq_norm_sq, ← real_inner_self_eq_norm_sq y]
        simp only [inner_sub_left, inner_sub_right, inner_add_left, inner_add_right,
          real_inner_smul_left, real_inner_smul_right, haa, hee, hae, hea, real_inner_comm y a,
          real_inner_comm y e]
        ring
      rw [← sub_nonneg, ← h]
      positivity
    calc ‖T.starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2
        ≤ ‖inner ℝ x a • e - inner ℝ x e • a‖ ^ 2 := by
          gcongr
          exact T.norm_starProjection_apply_le _
      _ = inner ℝ (Q.starProjection x) a ^ 2 + inner ℝ (Q.starProjection x) e ^ 2 := by
          rw [hA, hya, hye]
      _ ≤ ‖Q.starProjection x‖ ^ 2 := hB _
  -- Step 2: `F̃ = (|·|, f)` is Borel
  have hφ : Measurable fun x : Euclid P => (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a)) :=
    continuous_norm.measurable.prodMk (Real.continuous_arctan.measurable.comp
      ((continuous_id.inner continuous_const).measurable.div
        (continuous_id.inner continuous_const).measurable))
  -- Step 3: `Z ⊆ B̄_{1+|s|}(0)`, so `μ(Z) < ∞` by local integrability of `θ`
  have hZK : Z ⊆ closedBall (0 : Euclid P) (1 + |s|) := by
    intro x hx
    rw [mem_closedBall_zero_iff]
    have h1 := le_abs_self (‖x‖ - 1)
    have h2 := le_abs_self s
    have h3 := hx.2.1
    linarith
  have hfin : R.measure.restrict Z univ ≠ ∞ := by
    rw [Measure.restrict_apply_univ]
    refine ne_top_of_le_ne_top ?_ (measure_mono hZK)
    rw [IMRep.measure, withDensity_apply _ measurableSet_closedBall,
      Measure.restrict_restrict measurableSet_closedBall, inter_comm]
    exact R.locallyIntegrable_mult _ (isCompact_closedBall 0 _) (subset_univ _)
  -- Step 4: the push-forward transfer for `ν = μ⌞Z`, `φ = F̃`, `g = G` (`0 ≤ G ≤ 1`)
  obtain ⟨h1, h2, h3, h4⟩ := Submission.idtp_cse_fd_fs_pushforward_signed_transfer (Euclid P)
    (R.measure.restrict Z) (fun x => (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a)))
    (fun x => ‖(approxTangentPlane 2 R.carrier x).starProjection
      (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2) H hfin hφ
    (Submission.idtp_cse_fd_fs_frame_ratio_aesm P 2 univ R Q a e).restrict
    (ae_of_all _ fun x => ⟨div_nonneg (sq_nonneg _) (sq_nonneg _),
      div_le_one_of_le₀ (hframe _ x) (sq_nonneg _)⟩) hHm hH
  refine ⟨h1, h2, h3, fun s' hs' => ?_⟩
  -- Step 5: `F̃⁻¹((1 − s', 1 + s') × (−s', s')) ∩ Z(s, s) = Z(s, s')` for `s' ≤ s`
  have hS : MeasurableSet (Ioo (1 - s') (1 + s') ×ˢ Ioo (-s') s') :=
    measurableSet_Ioo.prod measurableSet_Ioo
  have hset : (fun x : Euclid P => (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a))) ⁻¹'
      (Ioo (1 - s') (1 + s') ×ˢ Ioo (-s') s') ∩ Z = {x : Euclid P | 0 < inner ℝ x a ∧
        |‖x‖ - 1| < s' ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' ∧
        ‖x - Q.starProjection x‖ < s * ‖x‖} := by
    ext x
    simp only [hZ, mem_inter_iff, mem_preimage, mem_prod, mem_Ioo, mem_ofPred_eq, abs_lt]
    constructor
    · rintro ⟨⟨⟨hr₁, hr₂⟩, hf₁, hf₂⟩, hxa, -, -, hxπ⟩
      exact ⟨hxa, ⟨by linarith, by linarith⟩, ⟨hf₁, hf₂⟩, hxπ⟩
    · rintro ⟨hxa, ⟨hr₁, hr₂⟩, ⟨hf₁, hf₂⟩, hxπ⟩
      exact ⟨⟨⟨by linarith, by linarith⟩, hf₁, hf₂⟩, hxa, ⟨by linarith, by linarith⟩,
        ⟨by linarith, by linarith⟩, hxπ⟩
  rw [h4 _ hS, Measure.restrict_restrict (hφ hS), hset]

/-- **Simon 7.3.3, proof (gap in a cone sector)**: let `R = (M, θ, ξ)` represent `C ∈ 𝒟₂(ℝᴾ)`,
`μ = θH²⌞M`, `q(x) = x − π_Q x` and `f(x) = arctan(⟨x, e⟩/⟨x, a⟩)`.  Assume the localization
`Loc(s)`: for `0 < s' ≤ s`, every `x ∈ spt C` with `⟨x, a⟩ > 0`, `|‖x‖ − 1| < s'`, `|f(x)| < s'`
and `|q(x)| ≤ 2s|x|` has `|q(x)| < (s'/4)|x|` and `|x − a| < 3s'`.  Then `μ`-a.e. `x` with
`⟨x, a⟩ > 0`, `|‖x‖ − 1| < s` and `|f(x)| < s` has `|q(x)| < (s/2)|x|` or `2s|x| < |q(x)|`.
Indeed `spt C = ℝᴾ ∩ spt μ = spt μ`, which is `μ`-conull as `ℝᴾ` is second countable, hence
hereditarily Lindelöf; at `x ∈ spt C` with `|q(x)| ≤ 2s|x|`, `Loc(s)` with `s' = s` gives
`|q(x)| < (s/4)|x| ≤ (s/2)|x|`. -/
theorem Submission.idtp_cse_fd_gap_ae : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (R : IMRep (univ : Set (Euclid P)) 2) (s : ℝ), R.Represents C → 0 < s → (∀ s' : ℝ, 0 < s' → s' ≤ s → ∀ x ∈ C.support, 0 < inner ℝ x a → |‖x‖ - 1| < s' → |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' → ‖x - Q.starProjection x‖ ≤ 2 * s * ‖x‖ → ‖x - Q.starProjection x‖ < s' / 4 * ‖x‖ ∧ dist x a < 3 * s') → ∀ᵐ x ∂R.measure, 0 < inner ℝ x a → |‖x‖ - 1| < s → |Real.arctan (inner ℝ x e / inner ℝ x a)| < s → ‖x - Q.starProjection x‖ < s / 2 * ‖x‖ ∨ 2 * s * ‖x‖ < ‖x - Q.starProjection x‖ := by
  intro P C Q a e R s hRC hs hloc
  -- `spt C = ℝᴾ ∩ spt μ = spt μ`, as `ℝᴾ` is open and `R` represents `C`
  have hspt : C.support = R.measure.support := by
    rw [Submission.imrep_represents_support_eq_inter_measure_support P 2 univ C R isOpen_univ hRC,
      univ_inter]
  -- `μ`-a.e. `x` lies in `spt μ = spt C` (`ℝᴾ` is second countable, hence hereditarily Lindelöf)
  filter_upwards [Measure.support_mem_ae (μ := R.measure)] with x hx hxa hx1 hxf
  rw [← hspt] at hx
  -- either `2s|x| < |q(x)|`, or `|q(x)| ≤ 2s|x|` and `Loc(s)` gives `|q(x)| < (s/4)|x| ≤ (s/2)|x|`
  rcases le_or_gt ‖x - Q.starProjection x‖ (2 * s * ‖x‖) with hle | hlt
  · refine Or.inl ((hloc s hs le_rfl x hx hxa hx1 hxf hle).1.trans_le ?_)
    exact mul_le_mul_of_nonneg_right (by linarith) (norm_nonneg x)
  · exact Or.inr hlt

/-- **Integrals against the weight of a cone scale homogeneously** (scaling step 5(i) of the
flux-density argument for planar sectors of 2-dimensional minimizing cones, proof of Simon 7.3.3).
If the cone `C` is represented by `R = (M, θ, ξ)` with weight `μ = θHⁿ⌞M` and `r > 0`, then
`∫ φ(rx) dμ(x) = r⁻ⁿ ∫ φ dμ` for every `φ : ℝᴾ → ℝ`.  `S(x) = rx` is a homeomorphism, hence a
measurable embedding, and `S⁻¹(A) = r⁻¹A` with `μ(r⁻¹A) = r⁻ⁿ μ(A)` (homogeneity of the weight of
a cone) gives `S_#μ = r⁻ⁿ μ`; integrals commute with the push-forward along `S`. -/
theorem Submission.idtp_cse_fd_cone_integral_smul : ∀ (P n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n), IsConeCurrent C → R.Represents C → ∀ r : ℝ, 0 < r → ∀ φ : Euclid P → ℝ, ∫ x, φ (r • x) ∂R.measure = (r ^ n)⁻¹ * ∫ x, φ x ∂R.measure := by
  intro P n C R hC hR r hr φ
  -- Step 1: `S(x) = rx` is a homeomorphism of `ℝᴾ`, hence a measurable embedding
  have hS : MeasurableEmbedding (fun x : Euclid P => r • x) :=
    measurableEmbedding_const_smul₀ hr.ne'
  -- Step 2: `S_#μ = r⁻ⁿ μ`, as `S⁻¹(A) = r⁻¹A` and `μ(r⁻¹A) = r⁻ⁿ μ(A)` for Borel `A`
  have hmap : Measure.map (fun x : Euclid P => r • x) R.measure =
      ENNReal.ofReal (r⁻¹ ^ n) • R.measure := by
    ext A hA
    rw [Measure.map_apply hS.measurable hA, Set.preimage_smul₀ hr.ne', ← Set.image_smul,
      Submission.cone_current_imrep_measure_smul_image P n C R hC hR r⁻¹ (inv_pos.2 hr) A hA,
      Measure.smul_apply, smul_eq_mul]
  -- Step 3: change of variables, `∫ φ(rx) dμ = ∫ φ d(S_#μ) = r⁻ⁿ ∫ φ dμ`, and `r⁻¹ⁿ = (rⁿ)⁻¹`
  have h := hS.integral_map (μ := R.measure) φ
  rw [hmap, integral_smul_measure, ENNReal.toReal_ofReal (pow_nonneg (inv_nonneg.2 hr.le) n),
    smul_eq_mul, inv_pow] at h
  exact h.symm

/-- **Flux-density hypotheses (α) and (β)** (steps 4–6 of the flux-density argument for
`idtp_cse_flux_density_eq`).  Let `C` be a `2`-dimensional cone, `μ = μ_R` the weight of a
representation `R` of `C`, `f(x) = arctan(⟨x, e⟩ / ⟨x, a⟩)`, `G(x) = |p_{Tₓ}(Ax)|² / |πx|²`
and `Z` the sector `{⟨x, a⟩ > 0, ||x| − 1| < s, |f(x)| < s, |x − πx| < s|x|}`.  If the tangent
planes are dilation invariant (TS), `H` is the density of the push-forward of `G μ⌞Z` under
`x ↦ (|x|, f(x))` (SI), and the rotation conservation law (RC) holds, then
(α) `∫ ψ'(p₂) l(p₁) H(p) dp = 0`, and
(β) `∫ l(p₁ / r) ψ(p₂) H(p) dp = r² ∫ l(p₁) ψ(p₂) H(p) dp` for `|r − 1| < s / 4`.
(α) is (SI) followed by (RC).  For (β), both radial windows lie in `(1 − s, 1 + s)`, so the
`Z`-integrals are integrals over the dilation-invariant sector `Z'` obtained by dropping the
radial condition; `|ry| / r = |y|`, `f(ry) = f(y)`, `1_{Z'}(ry) = 1_{Z'}(y)` and, by (TS),
`G(ry) = G(y)` for `μ`-a.e. `y`, so the cone scaling `∫ φ(ry) dμ(y) = r⁻² ∫ φ dμ`
(`Submission.idtp_cse_fd_cone_integral_smul`) concludes. -/
theorem Submission.idtp_cse_fd_alpha_beta : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2) (R : IMRep (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (s : ℝ) (H : ℝ × ℝ → ℝ), IsConeCurrent C → R.Represents C → 0 < s → s ≤ 1 / 4 → (∀ r : ℝ, 0 < r → ∀ᵐ x ∂R.measure, approxTangentPlane 2 R.carrier (r • x) = approxTangentPlane 2 R.carrier x) → (∀ b : ℝ × ℝ → ℝ, Measurable b → (∃ M : ℝ, ∀ p, |b p| ≤ M) → ∫ p : ℝ × ℝ, b p * H p = ∫ x in {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖}, b (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a)) * (‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2) ∂R.measure) → (∀ ψ l : ℝ → ℝ, ContDiff ℝ 1 ψ → ContDiff ℝ 1 l → tsupport ψ ⊆ Ioo (-s) s → tsupport l ⊆ Ioo (1 - s) (1 + s) → ∫ x in {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖}, deriv ψ (Real.arctan (inner ℝ x e / inner ℝ x a)) * l ‖x‖ * (‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2) ∂R.measure = 0) → (∀ ψ l : ℝ → ℝ, ContDiff ℝ 1 ψ → ContDiff ℝ 1 l → tsupport ψ ⊆ Ioo (-s) s → tsupport l ⊆ Ioo (1 - s) (1 + s) → ∫ p : ℝ × ℝ, deriv ψ p.2 * l p.1 * H p = 0) ∧ (∀ (l ψ : ℝ → ℝ) (r : ℝ), ContDiff ℝ 1 l → ContDiff ℝ 1 ψ → tsupport l ⊆ Ioo (1 - s / 2) (1 + s / 2) → tsupport ψ ⊆ Ioo (-s) s → |r - 1| < s / 4 → ∫ p : ℝ × ℝ, l (p.1 / r) * ψ p.2 * H p = r ^ 2 * ∫ p : ℝ × ℝ, l p.1 * ψ p.2 * H p) := by
  intro P C R Q a e s H hC hR hs hs4 hTS hSI hRC
  -- `f(x) = arctan(⟨x, e⟩ / ⟨x, a⟩)` and `G(x) = |p_{Tₓ}(Ax)|² / |πx|²`.
  obtain ⟨f, hf⟩ : ∃ f : Euclid P → ℝ, ∀ x, Real.arctan (inner ℝ x e / inner ℝ x a) = f x :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨G, hG⟩ : ∃ G : Euclid P → ℝ, ∀ x, ‖(approxTangentPlane 2 R.carrier x).starProjection
      (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2 = G x :=
    ⟨_, fun _ => rfl⟩
  simp only [hf, hG] at hSI hRC
  -- Step 0: continuous functions with `tsupport` in a bounded interval, and the derivatives of
  -- such `C¹` functions, are bounded; so are products of bounded functions.
  have hcpt : ∀ (g : ℝ → ℝ) (u v : ℝ), tsupport g ⊆ Ioo u v → HasCompactSupport g :=
    fun g u v hg => isCompact_Icc.of_isClosed_subset (isClosed_tsupport g)
      (hg.trans Ioo_subset_Icc_self)
  have hbdd : ∀ g : ℝ → ℝ, Continuous g → HasCompactSupport g → ∃ M : ℝ, ∀ t, |g t| ≤ M := by
    intro g hg hgc
    obtain ⟨M, hM⟩ := hg.bounded_above_of_compact_support hgc
    exact ⟨M, fun t => (Real.norm_eq_abs (g t)) ▸ hM t⟩
  have hbdd_mul : ∀ (g₁ g₂ : ℝ × ℝ → ℝ) (M₁ M₂ : ℝ), (∀ p, |g₁ p| ≤ M₁) →
      (∀ p, |g₂ p| ≤ M₂) → ∃ M : ℝ, ∀ p, |g₁ p * g₂ p| ≤ M := by
    intro g₁ g₂ M₁ M₂ h₁ h₂
    refine ⟨M₁ * M₂, fun p => ?_⟩
    rw [abs_mul]
    exact mul_le_mul (h₁ p) (h₂ p) (abs_nonneg _) ((abs_nonneg _).trans (h₁ p))
  refine ⟨fun ψ l hψ hl hψs hls => ?_, fun l ψ r hl hψ hls hψs hr => ?_⟩
  -- Step 1: (α) is (SI) applied to `b(p) = ψ'(p₂) l(p₁)`, followed by (RC).
  · obtain ⟨A, hA⟩ := hbdd (deriv ψ) (hψ.continuous_deriv le_rfl) (hcpt ψ _ _ hψs).deriv
    obtain ⟨B, hB⟩ := hbdd l hl.continuous (hcpt l _ _ hls)
    obtain ⟨M, hM⟩ := hbdd_mul (fun p => deriv ψ p.2) (fun p => l p.1) A B (fun p => hA p.2)
      (fun p => hB p.1)
    have hmeas : Measurable fun p : ℝ × ℝ => deriv ψ p.2 * l p.1 :=
      (((hψ.continuous_deriv le_rfl).comp continuous_snd).mul
        (hl.continuous.comp continuous_fst)).measurable
    exact (hSI (fun p => deriv ψ p.2 * l p.1) hmeas ⟨M, hM⟩).trans (hRC ψ l hψ hl hψs hls)
  -- Step 2: setup for (β).
  · obtain ⟨hr₁, hr₂⟩ := abs_lt.mp hr
    have hr0 : 0 < r := by linarith
    obtain ⟨A, hA⟩ := hbdd l hl.continuous (hcpt l _ _ hls)
    obtain ⟨B, hB⟩ := hbdd ψ hψ.continuous (hcpt ψ _ _ hψs)
    obtain ⟨M₁, hM₁⟩ := hbdd_mul (fun p => l (p.1 / r)) (fun p => ψ p.2) A B
      (fun p => hA _) (fun p => hB _)
    obtain ⟨M₂, hM₂⟩ := hbdd_mul (fun p => l p.1) (fun p => ψ p.2) A B
      (fun p => hA _) (fun p => hB _)
    have hmeas₁ : Measurable fun p : ℝ × ℝ => l (p.1 / r) * ψ p.2 :=
      ((hl.continuous.comp (continuous_fst.div_const r)).mul
        (hψ.continuous.comp continuous_snd)).measurable
    have hmeas₂ : Measurable fun p : ℝ × ℝ => l p.1 * ψ p.2 :=
      ((hl.continuous.comp continuous_fst).mul (hψ.continuous.comp continuous_snd)).measurable
    -- (2.1): both sides of (β) are integrals over the sector `Z`.
    have hSI₁ := hSI _ hmeas₁ ⟨M₁, hM₁⟩
    have hSI₂ := hSI _ hmeas₂ ⟨M₂, hM₂⟩
    -- The sector `Z` and the dilation-invariant sector `Z' ⊇ Z` without the radial condition.
    obtain ⟨Z, hZ⟩ : ∃ Z : Set (Euclid P), Z = {x : Euclid P | 0 < inner ℝ x a ∧
        |‖x‖ - 1| < s ∧ |f x| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} := ⟨_, rfl⟩
    obtain ⟨Z', hZ'⟩ : ∃ Z' : Set (Euclid P), Z' = {x : Euclid P | 0 < inner ℝ x a ∧
        |f x| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} := ⟨_, rfl⟩
    rw [← hZ] at hSI₁ hSI₂
    have hZ'meas : MeasurableSet Z' := by
      have hia : Measurable fun y : Euclid P => inner ℝ y a :=
        (continuous_id.inner continuous_const).measurable
      have hie : Measurable fun y : Euclid P => inner ℝ y e :=
        (continuous_id.inner continuous_const).measurable
      have hfm : Measurable fun y => |f y| := by
        simp only [← hf]
        exact continuous_abs.measurable.comp (Real.continuous_arctan.measurable.comp (hie.div hia))
      have hq : Measurable fun y : Euclid P => ‖y - Q.starProjection y‖ :=
        (continuous_id.sub Q.starProjection.continuous).norm.measurable
      have hn : Measurable fun y : Euclid P => s * ‖y‖ :=
        (continuous_const.mul continuous_norm).measurable
      rw [hZ']
      exact (measurableSet_lt measurable_const hia).inter
        ((measurableSet_lt hfm measurable_const).inter (measurableSet_lt hq hn))
    have hZZ' : Z ⊆ Z' := by
      rw [hZ, hZ']
      rintro x ⟨hxa, -, hxf, hxq⟩
      exact ⟨hxa, hxf, hxq⟩
    -- Step 3: both integrands vanish on `Z' \ Z` (radial windows).
    have hrad : ∀ x : Euclid P, x ∈ Z' → |‖x‖ - 1| < s → x ∈ Z := by
      intro x hx hx1
      rw [hZ'] at hx
      obtain ⟨hxa, hxf, hxq⟩ := hx
      rw [hZ]
      exact ⟨hxa, hx1, hxf, hxq⟩
    have hvan₁ : ∀ x ∈ Z' \ Z, l (‖x‖ / r) * ψ (f x) * G x = 0 := by
      rintro x ⟨hxZ', hxZ⟩
      by_cases hl0 : l (‖x‖ / r) = 0
      · rw [hl0, zero_mul, zero_mul]
      refine absurd (hrad x hxZ' ?_) hxZ
      obtain ⟨ht₁, ht₂⟩ := hls (subset_tsupport l (Function.mem_support.mpr hl0))
      have hx : ‖x‖ = r * (‖x‖ / r) := (mul_div_cancel₀ _ hr0.ne').symm
      generalize ‖x‖ / r = t at hx ht₁ ht₂
      have ht0 : 0 < t := by linarith
      rw [abs_lt]
      constructor
      · nlinarith [mul_lt_mul_of_pos_right (show 1 - s / 4 < r by linarith) ht0,
          mul_lt_mul_of_pos_left ht₁ (show (0 : ℝ) < 1 - s / 4 by linarith)]
      · nlinarith [mul_lt_mul_of_pos_right (show r < 1 + s / 4 by linarith) ht0,
          mul_lt_mul_of_pos_left ht₂ (show (0 : ℝ) < 1 + s / 4 by linarith)]
    have hvan₂ : ∀ x ∈ Z' \ Z, l ‖x‖ * ψ (f x) * G x = 0 := by
      rintro x ⟨hxZ', hxZ⟩
      by_cases hl0 : l ‖x‖ = 0
      · rw [hl0, zero_mul, zero_mul]
      refine absurd (hrad x hxZ' ?_) hxZ
      obtain ⟨ht₁, ht₂⟩ := hls (subset_tsupport l (Function.mem_support.mpr hl0))
      rw [abs_lt]
      constructor <;> linarith
    -- Step 4: dilation invariance of `|·| / r`, `f`, `Z'` and, `μ`-a.e., of `G`.
    have hnorm : ∀ y : Euclid P, ‖r • y‖ = r * ‖y‖ := fun y => norm_smul_of_nonneg hr0.le y
    have hfr : ∀ y, f (r • y) = f y := fun y => by
      rw [← hf, ← hf, real_inner_smul_left, real_inner_smul_left, mul_div_mul_left _ _ hr0.ne']
    have hZ'r : ∀ y, r • y ∈ Z' ↔ y ∈ Z' := by
      intro y
      have hproj : r • y - Q.starProjection (r • y) = r • (y - Q.starProjection y) := by
        rw [map_smul, smul_sub]
      rw [hZ', Set.mem_ofPred_eq, Set.mem_ofPred_eq, hfr, hproj, hnorm, hnorm,
        real_inner_smul_left, mul_pos_iff_of_pos_left hr0, mul_left_comm,
        mul_lt_mul_iff_right₀ hr0]
    have hGr : ∀ y, approxTangentPlane 2 R.carrier (r • y) = approxTangentPlane 2 R.carrier y →
        G (r • y) = G y := by
      intro y hy
      have hA : inner ℝ (r • y) a • e - inner ℝ (r • y) e • a =
          r • (inner ℝ y a • e - inner ℝ y e • a) := by
        rw [real_inner_smul_left, real_inner_smul_left, smul_sub, mul_smul, mul_smul]
      rw [← hG, ← hG, hy, hA, map_smul, map_smul, hnorm, hnorm, mul_pow, mul_pow,
        mul_div_mul_left _ _ (pow_ne_zero 2 hr0.ne')]
    -- `φ := 1_{Z'} h₁` satisfies `φ(ry) = (1_{Z'} h₂)(y)` for `μ`-a.e. `y`.
    have hae : (fun y => Z'.indicator (fun x => l (‖x‖ / r) * ψ (f x) * G x) (r • y))
        =ᵐ[R.measure] Z'.indicator fun x => l ‖x‖ * ψ (f x) * G x := by
      filter_upwards [hTS r hr0] with y hy
      by_cases hyZ : y ∈ Z'
      · rw [Set.indicator_of_mem ((hZ'r y).2 hyZ), Set.indicator_of_mem hyZ, hnorm,
          mul_div_cancel_left₀ _ hr0.ne', hfr, hGr y hy]
      · rw [Set.indicator_of_notMem (fun h => hyZ ((hZ'r y).1 h)),
          Set.indicator_of_notMem hyZ]
    -- Step 5: the cone scaling of `μ`.
    have hcone := Submission.idtp_cse_fd_cone_integral_smul P 2 C R hC hR r hr0
      (Z'.indicator fun x => l (‖x‖ / r) * ψ (f x) * G x)
    rw [integral_congr_ae hae, integral_indicator hZ'meas, integral_indicator hZ'meas,
      setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hZ'meas hZZ' hvan₁,
      setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hZ'meas hZZ' hvan₂] at hcone
    -- Step 6: conclusion.
    rw [hSI₁, hSI₂, hcone, ← mul_assoc, mul_inv_cancel₀ (pow_ne_zero 2 hr0.ne'), one_mul]
/-- **Flux density, identifying the constant** (steps 7–9 of the proof of
`idtp_cse_flux_density_eq`).  Let `0 < s ≤ 1`, `B = (1 − s/8, 1 + s/8) × (−s, s)` and
`B' = (1 − s/8, 1 + s/8) × (−s/8, s/8)`.  If `H < ∞` a.e., `toReal ∘ H = c·p₁` a.e. on `B`, and the
box integrals `I(s') = ∫_{(1−s', 1+s') × (−s', s')} H` (`0 < s' ≤ s/8`) satisfy `I(s')/s'² → 4m` as
`s' ↓ 0`, then `H = m·p₁` a.e. on `B'`.  Indeed `H = c·p₁` a.e. on `B`, so `c ≥ 0` (`p₁ > 0` on the
non-null `B' ⊆ B`); by Tonelli `I(s') = 4c·s'²`, and uniqueness of limits gives `c = m`. -/
theorem Submission.idtp_cse_fd_identify_constant : ∀ (s c : ℝ) (m : ℕ) (H : ℝ × ℝ → ℝ≥0∞) (I : ℝ → ℝ≥0∞), 0 < s → s ≤ 1 → (∀ᵐ p : ℝ × ℝ, H p ≠ ∞) → (∀ᵐ p : ℝ × ℝ, p ∈ Ioo (1 - s / 8) (1 + s / 8) ×ˢ Ioo (-s) s → (H p).toReal = c * p.1) → (∀ s' : ℝ, 0 < s' → s' ≤ s / 8 → ∫⁻ p in Ioo (1 - s') (1 + s') ×ˢ Ioo (-s') s', H p = I s') → Tendsto (fun s' : ℝ => I s' / ENNReal.ofReal (s' ^ 2)) (𝓝[>] 0) (𝓝 (4 * (m : ℝ≥0∞))) → ∀ᵐ p : ℝ × ℝ, p ∈ Ioo (1 - s / 8) (1 + s / 8) ×ˢ Ioo (-(s / 8)) (s / 8) → H p = ENNReal.ofReal ((m : ℝ) * p.1) := by
  intro s c m H I hs hs1 hfin hH hI hlim
  -- step 1: `H = ofReal (c p₁)` a.e. on `B`
  have h1 : ∀ᵐ p : ℝ × ℝ, p ∈ Ioo (1 - s / 8) (1 + s / 8) ×ˢ Ioo (-s) s →
      H p = ENNReal.ofReal (c * p.1) := by
    filter_upwards [hfin, hH] with p hp1 hp2 hpB
    rw [← hp2 hpB, ENNReal.ofReal_toReal hp1]
  -- step 2: `c ≥ 0`, since `B' ⊆ B` has positive measure and `p₁ > 0` on it
  have hc : 0 ≤ c := by
    refine le_of_not_gt fun hneg => ?_
    have hpos : volume (Ioo (1 - s / 8) (1 + s / 8) ×ˢ Ioo (-(s / 8)) (s / 8)) ≠ 0 := by
      rw [Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Ioo, Real.volume_Ioo]
      refine mul_ne_zero ?_ ?_ <;> rw [ne_eq, ENNReal.ofReal_eq_zero, not_le] <;> linarith
    apply hpos
    rw [measure_eq_zero_iff_ae_notMem]
    filter_upwards [hH] with p hp hpB'
    have h0 := hp ⟨hpB'.1, by linarith [hpB'.2.1], by linarith [hpB'.2.2]⟩
    have hp1 : 0 < p.1 := by linarith [hpB'.1.1]
    have := mul_neg_of_neg_of_pos hneg hp1
    linarith [ENNReal.toReal_nonneg (a := H p)]
  -- step 3: the box integrals, `I s' = ofReal (4c) · ofReal (s'²)`
  have h3 : ∀ s' : ℝ, 0 < s' → s' ≤ s / 8 →
      I s' = ENNReal.ofReal (4 * c) * ENNReal.ofReal (s' ^ 2) := by
    intro s' hs' hs'8
    have hsub : Ioo (1 - s') (1 + s') ×ˢ Ioo (-s') s' ⊆
        Ioo (1 - s / 8) (1 + s / 8) ×ˢ Ioo (-s) s :=
      prod_mono (Ioo_subset_Ioo (by linarith) (by linarith))
        (Ioo_subset_Ioo (by linarith) (by linarith))
    rw [← hI s' hs' hs'8, setLIntegral_congr_fun_ae (measurableSet_Ioo.prod measurableSet_Ioo)
      (h1.mono fun p hp hpS => hp (hsub hpS)), Measure.volume_eq_prod,
      setLIntegral_prod (fun p : ℝ × ℝ => ENNReal.ofReal (c * p.1)) (by fun_prop)]
    simp only [setLIntegral_const, Real.volume_Ioo]
    have hint : ∫ x in Ioo (1 - s') (1 + s'), c * x = 2 * c * s' := by
      rw [← integral_Ioc_eq_integral_Ioo, ← intervalIntegral.integral_of_le (by linarith),
        intervalIntegral.integral_const_mul, integral_id]
      ring
    have hlint : ∫⁻ x in Ioo (1 - s') (1 + s'), ENNReal.ofReal (c * x) =
        ENNReal.ofReal (2 * c * s') := by
      rw [← hint, ofReal_integral_eq_lintegral_ofReal]
      · exact (by fun_prop : Continuous fun x : ℝ => c * x).integrableOn_Icc.mono_set
          Ioo_subset_Icc_self
      · exact (ae_restrict_iff' measurableSet_Ioo).mpr
          (Eventually.of_forall fun x hx => mul_nonneg hc (by linarith [hx.1]))
    rw [lintegral_mul_const' _ _ ENNReal.ofReal_ne_top, hlint,
      ← ENNReal.ofReal_mul (mul_nonneg (mul_nonneg (by norm_num) hc) hs'.le),
      ← ENNReal.ofReal_mul (by linarith)]
    congr 1
    ring
  -- step 4: `c = m`, by uniqueness of limits along `𝓝[>] 0`
  have h4 : ENNReal.ofReal (4 * c) = 4 * (m : ℝ≥0∞) := by
    have hev : (fun _ : ℝ => ENNReal.ofReal (4 * c)) =ᶠ[𝓝[>] 0]
        fun s' : ℝ => I s' / ENNReal.ofReal (s' ^ 2) := by
      filter_upwards [Ioc_mem_nhdsGT (show (0 : ℝ) < s / 8 by positivity)] with s' hs'
      rw [h3 s' hs'.1 hs'.2, ENNReal.mul_div_cancel_right _ ENNReal.ofReal_ne_top]
      rw [ne_eq, ENNReal.ofReal_eq_zero, not_le]
      exact pow_pos hs'.1 2
    exact tendsto_nhds_unique (tendsto_const_nhds.congr' hev) hlim
  have hcm : c = m := by
    have h4' : ENNReal.ofReal (4 * c) = ENNReal.ofReal (4 * (m : ℝ)) := by
      rw [h4, ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_natCast, ENNReal.ofReal_ofNat]
    rw [ENNReal.ofReal_eq_ofReal_iff (by positivity) (by positivity)] at h4'
    linarith
  -- step 5: conclusion on `B' ⊆ B`
  filter_upwards [h1] with p hp hpB'
  rw [hp ⟨hpB'.1, by linarith [hpB'.2.1], by linarith [hpB'.2.2]⟩, hcm]
/-- **Simon 7.1.2, first claim (pp. 181–182).**  If `T ∈ 𝒟ₙ(U)` is minimizing in `N ∩ U`
(`N` an embedded `C²` submanifold, `(N̄ \ N) ∩ U = ∅`), `∂T = 0` in `U`, and `T = τ(M, θ, ξ)` with
`Hⁿ(M \ N) = 0`, then `V = v(M, θ)` is stationary in `N ∩ U`.  Fix `X` tangent to `N` and an
open `W ⊂⊂ U` containing `spt X`.  If `μ_V(W) = 0`, then `div_M X = 0` `μ_V`-a.e.  Otherwise the
deformations `φ_t` push `T` forward to competitors with `spt(φ_{t#}T − T) ⊆ spt X ∩ N`, so
`μ_V(W) ≤ M_W(φ_{t#}T) ≤ μ_V(W) + t δV(X) + ε|t|` for all small `t` of both signs, which forces
`δV(X) = 0`.  No separate case `n = 0` is needed, since `∂S = ∂T` is vacuous there. -/
theorem Submission.stationaryAlong_of_minimizing_in_submanifold :
    ∀ (P n d : ℕ) (U N : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n),
      IsOpen U → IsEmbeddedSubmanifold 2 d N → (closure N \ N) ∩ U = ∅ →
      IsMinimizingIn T (N ∩ U) → BoundaryVanishes T → R.Represents T →
      μHE[n] (R.carrier \ N) = 0 → R.IsStationaryAlong N := by
  intro P n d U N T R hU hN hNU hmin hT hR hMN X hX hXc hXU hXN
  -- `∂S₁ = 0 = ∂S₂` gives `∂S₁ = ∂S₂` (vacuous in degree `0`).
  have hsame : ∀ {m : ℕ} (S₁ S₂ : GeometricCurrentOn U m), BoundaryVanishes S₁ →
      BoundaryVanishes S₂ → SameBoundary S₁ S₂ := by
    intro m S₁ S₂ h₁ h₂
    cases m with
    | zero => trivial
    | succ m => exact (show S₁.boundary = 0 from h₁).trans (show S₂.boundary = 0 from h₂).symm
  -- An open `W ⊂⊂ U` containing `K = spt X`, with `μ_V(W) < ∞` and `M_W(T) = μ_V(W)`.
  obtain ⟨W, hWo, hKW, hWU, hWc⟩ := exists_open_between_and_isCompact_closure hXc hU hXU
  have hWm : MeasurableSet W := hWo.measurableSet
  have hRW : R.measure W = ∫⁻ x in W, (R.mult x : ℝ≥0∞) ∂(μHE[n].restrict R.carrier) := by
    rw [IMRep.measure, withDensity_apply _ hWm]
  have hRWfin : R.measure W ≠ ∞ := by
    rw [hRW, Measure.restrict_restrict hWm]
    refine ne_top_of_le_ne_top (R.locallyIntegrable_mult _ hWc hWU) (lintegral_mono_set ?_)
    exact fun x hx => ⟨hx.2, subset_closure hx.1⟩
  have hTW : T.massOn W = R.measure W :=
    Submission.imrep_represents_massOn_eq_measure P n U W T R hU hR hWo
      (subset_closure.trans hWU)
  -- If `μ_V(W) = 0`, then `Hⁿ(M ∩ W) = 0` and `DX = 0` off `W`, so `div_M X = 0` a.e. on `M`.
  by_cases hW0 : R.measure W = 0
  · have hMW : μHE[n].restrict R.carrier W = 0 := by
      refine le_antisymm ?_ bot_le
      calc μHE[n].restrict R.carrier W
          = ∫⁻ _ in W, 1 ∂(μHE[n].restrict R.carrier) := (setLIntegral_one W).symm
        _ ≤ ∫⁻ x in W, (R.mult x : ℝ≥0∞) ∂(μHE[n].restrict R.carrier) := by
          refine lintegral_mono_ae ?_
          filter_upwards [ae_restrict_of_ae (ae_restrict_mem R.measurableSet_carrier)] with x hx
          exact Nat.one_le_cast.2 (R.mult_pos x hx)
        _ = 0 := by rw [← hRW, hW0]
    rw [IMRep.firstVariation]
    refine integral_eq_zero_of_ae ?_
    filter_upwards [measure_eq_zero_iff_ae_notMem.1 hMW] with x hx
    have hDX : fderiv ℝ X x = 0 := fderiv_of_notMem_tsupport ℝ fun h => hx (hKW h)
    simp [tangentialDivergence, hDX]
  have hm : 0 < (R.measure W).toReal := ENNReal.toReal_pos hW0 hRWfin
  -- The deformations `φ_t` along `N`, fixing `ℝᴾ \ K` pointwise.
  obtain ⟨φ, hφ, hφD⟩ :=
    Submission.tangential_c1_deformation_exists P d U N X hU hN hNU hX hXc hXU hXN
  -- `K ∩ N = K ∩ N̄` is compact, since `(N̄ \ N) ∩ U = ∅` and `K ⊆ U`.
  have hKNc : IsCompact (tsupport X ∩ N) := by
    have h : tsupport X ∩ N = tsupport X ∩ closure N := by
      refine Subset.antisymm (inter_subset_inter_right _ subset_closure) ?_
      rintro x ⟨hxK, hxN⟩
      refine ⟨hxK, ?_⟩
      by_contra h
      exact hNU.subset ⟨⟨hxN, h⟩, hXU hxK⟩
    rw [h]
    exact hXc.inter_right isClosed_closure
  -- Every push-forward `φ_{t#}T` is an admissible competitor in 7.1.1, so `μ_V(W) ≤ M_W(φ_{t#}T)`.
  have hcomp : ∀ (t : ℝ) (S : GeometricCurrentOn U n), IsIntegerMultiplicity S →
      BoundaryVanishes S →
      (∀ ω : TestFormOn U n, S ω = ∫ x in R.carrier, (R.mult x : ℝ) *
        R.orient x (((ω : DifferentialForm (Euclid P) n) (φ t x)).compContinuousLinearMap
          (fderiv ℝ (φ t) x)) ∂μHE[n]) →
      R.measure W ≤ S.massOn W := by
    intro t S hSi hSb hSω
    -- `φ_t` is injective and fixes `ℝᴾ \ K` pointwise, so it maps `K` into `K`.
    have hφK : ∀ x ∈ tsupport X, φ t x ∈ tsupport X := by
      intro x hx
      by_contra h
      have hfix : φ t x = x := (hφ t).2.1.1 ((hφ t).2.2.2.1 _ h)
      exact h (by rwa [hfix])
    -- `spt(φ_{t#}T − T) ⊆ K ∩ N`: near `y ∉ K ∩ N` the integrands agree `Hⁿ`-a.e. on `M`.
    have hsub : (S - T).support ⊆ tsupport X ∩ N := by
      intro y hy
      by_contra hyKN
      obtain ⟨ε, hε, hεU⟩ :=
        Metric.isOpen_iff.1 (hU.inter hKNc.isClosed.isOpen_compl) y ⟨hy.1, hyKN⟩
      have hcl : closure (ball y (ε / 2)) ⊆ ball y ε :=
        closure_ball_subset_closedBall.trans (closedBall_subset_ball (half_lt_self hε))
      have hball : ball y (ε / 2) ∈ {V : Set (Euclid P) | IsOpen V ∧ IsCompact (closure V) ∧
          closure V ⊆ U ∧ (S - T).VanishesOn V} := by
        refine ⟨isOpen_ball,
          (isCompact_closedBall y (ε / 2)).closure_of_subset ball_subset_closedBall,
          fun z hz => (hεU (hcl hz)).1, ?_⟩
        intro ω hω
        have hω0 : ∀ z ∈ tsupport X ∩ N, (ω : DifferentialForm (Euclid P) n) z = 0 :=
          fun z hz => image_eq_zero_of_notMem_tsupport fun hzω =>
            (hεU (ball_subset_ball (half_le_self hε.le) (hω hzω))).2 hz
        change S ω - T ω = 0
        rw [hSω ω, hR ω, IMRep.action, sub_eq_zero]
        refine setIntegral_congr_ae R.measurableSet_carrier ?_
        filter_upwards [measure_eq_zero_iff_ae_notMem.1 hMN] with x hxMN hxM
        have hxN : x ∈ N := by
          by_contra h
          exact hxMN ⟨hxM, h⟩
        have harg : ((ω : DifferentialForm (Euclid P) n) (φ t x)).compContinuousLinearMap
            (fderiv ℝ (φ t) x) = (ω : DifferentialForm (Euclid P) n) x := by
          by_cases hxK : x ∈ tsupport X
          · rw [hω0 x ⟨hxK, hxN⟩, hω0 (φ t x) ⟨hφK x hxK, ((hφ t).2.2.2.2 ⟨hxN, hXU hxK⟩).1⟩]
            ext v
            simp
          · have hφx : φ t =ᶠ[𝓝 x] id := by
              filter_upwards [(isClosed_tsupport X).isOpen_compl.mem_nhds hxK] with z hz
              exact (hφ t).2.2.2.1 z hz
            rw [hφx.fderiv_eq, fderiv_id, (hφ t).2.2.2.1 x hxK]
            ext v
            simp
        rw [harg]
      exact hy.2 (mem_sUnion_of_mem (mem_ball_self (half_pos hε)) hball)
    have hSTc : IsCompact (S - T).support := by
      have h : (S - T).support = (tsupport X ∩ N) ∩ ((S - T).zeroRegion)ᶜ :=
        Subset.antisymm (fun y hy => ⟨hsub hy, hy.2⟩) fun y hy => ⟨hXU hy.1.1, hy.2⟩
      rw [h]
      exact hKNc.inter_right (S - T).isOpen_zeroRegion.isClosed_compl
    rw [← hTW]
    exact hmin.2 W S hWo ⟨hWc, hWU⟩ hSi (hsame S T hSb hT) hSTc fun y hy =>
      ⟨⟨(hsub hy).2, hXU (hsub hy).1⟩, hKW (hsub hy).1⟩
  -- The expansion `M_W(φ_{t#}T) ≤ μ_V(W) + t δV(X) + ε|t|` for `|t| < δ` gives `|δV(X)| ≤ ε`.
  have hbound : ∀ ε : ℝ, 0 < ε → |R.firstVariation X| ≤ ε := by
    intro ε hε
    obtain ⟨δ, hδ, hδS⟩ := Submission.pushforward_action_massOn_le_first_variation P n U W R X
      φ hWo hRWfin hX hXc hKW (fun t => (hφ t).1) (fun t => (hφ t).2.2.2.1) hφD ε hε
    have key : ∀ t : ℝ, |t| < δ → 0 ≤ t * R.firstVariation X + ε * |t| := by
      intro t ht
      obtain ⟨S, hSi, hSb, hSω⟩ := Submission.imrep_c1_diffeo_pushforward_im P n U
        (tsupport X) T R (φ t) hU hR hXc hXU (hφ t).1 (hφ t).2.1 (hφ t).2.2.1 (hφ t).2.2.2.1
      have h := (ENNReal.ofReal_toReal hRWfin).le.trans
        ((hcomp t S hSi (hSb hT) hSω).trans (hδS t ht S hSω))
      by_contra hneg
      exact not_lt.2 h ((ENNReal.ofReal_lt_ofReal_iff hm).2 (by linarith [not_le.1 hneg]))
    have h₁ := key (δ / 2) (by rw [abs_of_pos (half_pos hδ)]; exact half_lt_self hδ)
    have h₂ := key (-(δ / 2)) (by rw [abs_neg, abs_of_pos (half_pos hδ)]; exact half_lt_self hδ)
    rw [abs_of_pos (half_pos hδ)] at h₁
    rw [abs_neg, abs_of_pos (half_pos hδ)] at h₂
    rw [abs_le]
    constructor <;> nlinarith
  by_contra ha
  have h := hbound (|R.firstVariation X| / 2) (half_pos (abs_pos.2 ha))
  linarith [abs_pos.2 ha]

/-- **`TₓM ⊆ TₓN`** (Simon Ch. 3, 1.4 and Ch. 2, §4, (4.1)–(4.3); used in Ch. 4, 2.6–2.7).  Let
`N` be an embedded `C¹` `d`-dimensional submanifold, `Hⁿ(M \ N) = 0` and `x ∈ N`.  Then every
approximate tangent plane `Q` of `M` at `x` lies in `TₓN`.  Write `x = ψ(v)` for a chart `ψ` of
`N` and `A = Dψ(v)`: `N` is flat at `x` along `A(ℝᵈ)` (`atsm_chart_image_flat`), hence
`Q ⊆ A(ℝᵈ)` (`atsm_approxTangent_le_of_flat`), and `A(ℝᵈ) = TₓN`
(`chart_tangentSpace_eq_range_fderiv`). -/
theorem Submission.approxTangent_le_submanifold_tangentSpace : ∀ (P n d : ℕ) (N M : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)), IsEmbeddedSubmanifold 1 d N → x ∈ N → μHE[n] (M \ N) = 0 → HasApproximateTangentSpaceAt n M x Q → (Q : Set (Euclid P)) ⊆ tangentSpace N x := by
  intro P n d N M x Q hN hxN hnull hQ
  -- a chart `ψ : V → W ∩ N` of `N` around `x`, and `v ∈ V` with `ψ v = x`
  obtain ⟨V, W, ψ, hV, hW, hxW, hψ, hinj, himg, hprop, hDψ⟩ := hN x hxN
  obtain ⟨v, hv, rfl⟩ : x ∈ ψ '' V := by
    rw [himg]
    exact ⟨hxW, hxN⟩
  -- `N` is flat at `ψ v` along `A(ℝᵈ)`, `A = Dψ(v)`
  have hflat : ∀ ε : ℝ, 0 < ε → ∃ ρ : ℝ, 0 < ρ ∧ ∀ z ∈ N, dist z (ψ v) < ρ →
      ∃ t ∈ LinearMap.range (fderiv ℝ ψ v : Euclid d →ₗ[ℝ] Euclid P),
        ‖z - ψ v - t‖ ≤ ε * ‖z - ψ v‖ := by
    intro ε hε
    obtain ⟨ρ, hρ, hρN⟩ := Submission.atsm_chart_image_flat P d N W V ψ v hV hW
      (by exact_mod_cast hψ) hinj himg hprop (hDψ v hv) hv ε hε
    refine ⟨ρ, hρ, fun z hz hzρ => ?_⟩
    obtain ⟨h, hh⟩ := hρN z hz hzρ
    exact ⟨_, LinearMap.mem_range_self (fderiv ℝ ψ v : Euclid d →ₗ[ℝ] Euclid P) h, hh⟩
  -- hence `Q ⊆ A(ℝᵈ)`, and `A(ℝᵈ) = T_{ψ v}N`
  have hQA := Submission.atsm_approxTangent_le_of_flat P n N M (ψ v) Q _ hnull hflat hQ
  rw [Submission.chart_tangentSpace_eq_range_fderiv P d 1 N W V ψ v le_rfl hV hW hψ hinj himg
    hprop hDψ hv]
  intro w hw
  exact LinearMap.mem_range.1 (hQA hw)

/-- **Simon Ch. 2, §4** (4.1–4.3 and the definition of `Cˡ` functions on `M`): the tangent
projection `z ↦ P_{T_zN}` of an embedded `C²` submanifold `N ⊆ ℝᴾ` is `C¹` on `N`, i.e. it is the
restriction to `N` of a map that is `C¹` on an open `O ⊇ N`.  Along a chart `ψ`,
`T_{ψ(v)}N = range Dψ(v)` (`Submission.chart_tangentSpace_eq_range_fderiv`), and the projection
onto `range L` is `L (L*L)⁻¹ L*`, a smooth function of `L` near each injective `L`.  The inverse
function theorem for `Λ ∘ ψ`, `Λ` a left inverse of `Dψ(v₀)`, gives a `C¹` left inverse `φ` of
`ψ` on an open subset of `ℝᴾ`; by 4.2 (`ψ` is proper, so a homeomorphism onto `W ∩ N`),
`φ ∘ ψ = id` on all of `N` near `ψ(v₀)`, so `y ↦ P_{range Dψ(φ(y))}` extends `P_N` near `ψ(v₀)`.
A smooth partition of unity on the union `O` of these neighbourhoods glues the local
extensions. -/
theorem Submission.submanifold_tangentProjection_c1_extension : ∀ (P d : ℕ) (N : Set (Euclid P)), IsEmbeddedSubmanifold 2 d N → ∃ (O : Set (Euclid P)) (pr : Euclid P → (Euclid P →L[ℝ] Euclid P)), IsOpen O ∧ N ⊆ O ∧ ContDiffOn ℝ 1 pr O ∧ ∀ z ∈ N, pr z = (Submodule.span ℝ (tangentSpace N z)).starProjection := by
  intro P d N hN
  classical
  -- Step 1: `L ↦ P_{range L} = L (L*L)⁻¹ L*` is `C¹` near every injective `L₀`.
  have hproj : ∀ L₀ : Euclid d →L[ℝ] Euclid P, Injective L₀ →
      ContDiffAt ℝ 1 (fun L : Euclid d →L[ℝ] Euclid P =>
        (LinearMap.range (L : Euclid d →ₗ[ℝ] Euclid P)).starProjection) L₀ := by
    intro L₀ hL₀
    -- the adjoint `L ↦ L*`, as an `ℝ`-linear continuous map
    let adj : (Euclid d →L[ℝ] Euclid P) →L[ℝ] (Euclid P →L[ℝ] Euclid d) :=
      { toFun := fun L => ContinuousLinearMap.adjoint L
        map_add' := fun A B => map_add _ A B
        map_smul' := fun c A => by simp
        cont := ContinuousLinearMap.adjoint.continuous }
    have hadj : ∀ L, adj L = ContinuousLinearMap.adjoint L := fun _ => rfl
    -- the Gram operator `L*L` is invertible at `L₀`
    let G : (Euclid d →L[ℝ] Euclid P) → (Euclid d →L[ℝ] Euclid d) := fun L => adj L ∘L L
    have hG : ContDiff ℝ 1 G := adj.contDiff.clm_comp contDiff_id
    have hGunit : IsUnit (G L₀) := by
      have hinj : Injective (G L₀) := by
        intro x y hxy
        have h0 : G L₀ (x - y) = 0 := by simp [map_sub, hxy]
        have h1 : inner ℝ (L₀ (x - y)) (L₀ (x - y)) = 0 := by
          have := congrArg (fun z => inner ℝ z (x - y)) h0
          simpa only [G, ContinuousLinearMap.coe_comp, comp_apply, hadj,
            ContinuousLinearMap.adjoint_inner_left, inner_zero_left] using this
        have h2 : L₀ (x - y) = L₀ 0 := by rw [inner_self_eq_zero.1 h1, map_zero]
        exact sub_eq_zero.1 (hL₀ h2)
      rw [ContinuousLinearMap.isUnit_iff_bijective]
      refine ⟨hinj, ?_⟩
      simpa using (LinearMap.injective_iff_surjective
        (f := (G L₀ : Euclid d →ₗ[ℝ] Euclid d))).1 hinj
    let Γ : (Euclid d →L[ℝ] Euclid P) → (Euclid P →L[ℝ] Euclid P) :=
      fun L => L ∘L (Ring.inverse (G L) ∘L adj L)
    have hinv : ContDiffAt ℝ 1 (fun L => Ring.inverse (G L)) L₀ := by
      have h := contDiffAt_ringInverse ℝ (n := 1) hGunit.unit
      rw [IsUnit.unit_spec] at h
      exact h.comp L₀ hG.contDiffAt
    have hΓ : ContDiffAt ℝ 1 Γ L₀ :=
      contDiffAt_id.clm_comp (hinv.clm_comp adj.contDiff.contDiffAt)
    -- `Γ L = P_{range L}` wherever `L*L` is invertible, in particular near `L₀`
    have hev : ∀ᶠ L in 𝓝 L₀, IsUnit (G L) :=
      hG.continuous.continuousAt.preimage_mem_nhds (Units.isOpen.mem_nhds hGunit)
    refine hΓ.congr_of_eventuallyEq ?_
    filter_upwards [hev] with L hL
    ext1 x
    refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero ⟨_, rfl⟩ ?_
    rintro w ⟨a, rfl⟩
    have hcancel : G L (Ring.inverse (G L) (adj L x)) = adj L x := by
      have := congrArg (fun T : Euclid d →L[ℝ] Euclid d => T (adj L x))
        (Ring.mul_inverse_cancel (G L) hL)
      simpa [mul_apply_eq_comp] using this
    -- `L*(x - Γ L x) = 0`, i.e. `x - Γ L x ⊥ range L`
    have hperp : adj L (x - Γ L x) = 0 := by
      have : adj L (Γ L x) = G L (Ring.inverse (G L) (adj L x)) := rfl
      rw [map_sub, this, hcancel, sub_self]
    have : inner ℝ (x - Γ L x) (L a) = inner ℝ (adj L (x - Γ L x)) a := by
      rw [hadj, ContinuousLinearMap.adjoint_inner_left]
    rw [ContinuousLinearMap.coe_coe, this, hperp, inner_zero_left]
  -- Step 2: a `C¹` left inverse, defined on an open subset of `ℝᴾ`, of a `C¹` immersion `ψ`
  -- near `v₀`: the inverse function theorem for `Λ ∘ ψ`, `Λ` a left inverse of `Dψ(v₀)`.
  have hlinv : ∀ (V : Set (Euclid d)) (ψ : Euclid d → Euclid P) (v₀ : Euclid d), IsOpen V →
      ContDiffOn ℝ 1 ψ V → v₀ ∈ V → Injective (fderiv ℝ ψ v₀) →
      ∃ (O : Set (Euclid P)) (φ : Euclid P → Euclid d) (ε : ℝ), 0 < ε ∧ IsOpen O ∧
        ContDiffOn ℝ 1 φ O ∧ MapsTo φ O V ∧
        ∀ v : Euclid d, dist v v₀ < ε → v ∈ V ∧ ψ v ∈ O ∧ φ (ψ v) = v := by
    intro V ψ v₀ hV hψ hv₀ hinj
    obtain ⟨Λl, hΛl⟩ := LinearMap.exists_leftInverse_of_injective
      (fderiv ℝ ψ v₀ : Euclid d →ₗ[ℝ] Euclid P) (LinearMap.ker_eq_bot.2 hinj)
    let Λ : Euclid P →L[ℝ] Euclid d := LinearMap.toContinuousLinearMap Λl
    have hΛ : ∀ x, Λ (fderiv ℝ ψ v₀ x) = x := fun x => by
      simpa [Λ] using LinearMap.congr_fun hΛl x
    have hid : Λ ∘L fderiv ℝ ψ v₀ = ContinuousLinearMap.id ℝ (Euclid d) := by
      ext1 x
      simp [hΛ]
    let χ : Euclid d → Euclid d := fun v => Λ (ψ v)
    have hψat : ∀ v ∈ V, ContDiffAt ℝ 1 ψ v := fun v hv => hψ.contDiffAt (hV.mem_nhds hv)
    have hχat : ∀ v ∈ V, ContDiffAt ℝ 1 χ v := fun v hv =>
      Λ.contDiff.contDiffAt.comp v (hψat v hv)
    have hχderiv : ∀ v ∈ V, HasFDerivAt χ (Λ ∘L fderiv ℝ ψ v) v := fun v hv =>
      Λ.hasFDerivAt.comp v ((hψat v hv).differentiableAt one_ne_zero).hasFDerivAt
    -- the open set where `D(Λ ∘ ψ)` is invertible
    let D : Set (Euclid d) := V ∩ (fun v => Λ ∘L fderiv ℝ ψ v) ⁻¹' {A | IsUnit A}
    have hDopen : IsOpen D :=
      (continuousOn_const.clm_comp
        (hψ.continuousOn_fderiv_of_isOpen hV le_rfl)).isOpen_inter_preimage hV Units.isOpen
    have hv₀D : v₀ ∈ D :=
      ⟨hv₀, show IsUnit (Λ ∘L fderiv ℝ ψ v₀) by rw [hid]; exact isUnit_one⟩
    -- the inverse function theorem for `χ = Λ ∘ ψ` at `v₀`, where `Dχ(v₀) = id`
    have hstrict : HasStrictFDerivAt χ
        ((ContinuousLinearEquiv.refl ℝ (Euclid d) : Euclid d ≃L[ℝ] Euclid d) :
          Euclid d →L[ℝ] Euclid d) v₀ := by
      refine (hχat v₀ hv₀).hasStrictFDerivAt' ?_ one_ne_zero
      have := hχderiv v₀ hv₀
      rw [hid] at this
      exact this
    let h := hstrict.toOpenPartialHomeomorph χ
    have hcoe : (h : Euclid d → Euclid d) = χ := rfl
    let S := h.source ∩ D
    have hSopen : IsOpen S := h.open_source.inter hDopen
    have hv₀S : v₀ ∈ S := ⟨hstrict.mem_toOpenPartialHomeomorph_source, hv₀D⟩
    let T := h.target ∩ h.symm ⁻¹' S
    have hTopen : IsOpen T := h.isOpen_inter_preimage_symm hSopen
    -- `h⁻¹` is `C¹` on `T`, where the derivative of `h` is invertible
    have hsymm : ∀ t ∈ T, ContDiffAt ℝ 1 h.symm t := by
      intro t ht
      have hs : h.symm t ∈ S := ht.2
      obtain ⟨u, hu⟩ := hs.2.2
      apply h.contDiffAt_symm ht.1 (f₀' := ContinuousLinearEquiv.unitsEquiv ℝ (Euclid d) u)
      · have he : ((ContinuousLinearEquiv.unitsEquiv ℝ (Euclid d) u : Euclid d ≃L[ℝ] Euclid d) :
            Euclid d →L[ℝ] Euclid d) = Λ ∘L fderiv ℝ ψ (h.symm t) := by
          ext1 x
          simp [ContinuousLinearEquiv.unitsEquiv_apply, hu]
        rw [he, hcoe]
        exact hχderiv _ hs.2.1
      · rw [hcoe]
        exact hχat _ hs.2.1
    obtain ⟨ε, hε, hεS⟩ := Metric.isOpen_iff.1 hSopen v₀ hv₀S
    refine ⟨Λ ⁻¹' T, fun y => h.symm (Λ y), ε, hε, hTopen.preimage Λ.continuous, ?_, ?_, ?_⟩
    · intro y hy
      exact ((hsymm (Λ y) hy).comp y Λ.contDiff.contDiffAt).contDiffWithinAt
    · intro y hy
      exact (hy.2 : h.symm (Λ y) ∈ S).2.1
    · intro v hv
      have hvS : v ∈ S := hεS (mem_ball.2 hv)
      have hleft : h.symm (h v) = v := h.left_inv hvS.1
      refine ⟨hvS.2.1, ⟨h.map_source hvS.1, ?_⟩, hleft⟩
      show h.symm (h v) ∈ S
      rw [hleft]
      exact hvS
  -- Step 3: a proper injective chart has a continuous inverse: `ψ v` close to `ψ v₀` forces `v`
  -- close to `v₀`.
  have hprox : ∀ (V : Set (Euclid d)) (W : Set (Euclid P)) (ψ : Euclid d → Euclid P)
      (v₀ : Euclid d), IsOpen W → ContinuousOn ψ V → InjOn ψ V →
      (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → v₀ ∈ V → ψ v₀ ∈ W →
      ∀ ε : ℝ, 0 < ε → ∃ ρ : ℝ, 0 < ρ ∧ ∀ v ∈ V, dist (ψ v) (ψ v₀) < ρ → dist v v₀ < ε := by
    intro V W ψ v₀ hW hψ hinj hprop hv₀ hv₀W ε hε
    obtain ⟨r, hr, hrW⟩ := Metric.isOpen_iff.1 hW (ψ v₀) hv₀W
    -- `C = {v ∈ V : |ψ v - ψ v₀| ≤ r / 2, |v - v₀| ≥ ε}` is compact and `ψ v₀ ∉ ψ(C)`
    have hC : IsCompact ((V ∩ ψ ⁻¹' closedBall (ψ v₀) (r / 2)) ∩ (ball v₀ ε)ᶜ) :=
      (hprop _ ((closedBall_subset_ball (by linarith)).trans hrW)
        (isCompact_closedBall _ _)).inter_right isOpen_ball.isClosed_compl
    have himg := hC.image_of_continuousOn (hψ.mono fun x hx => hx.1.1)
    have hnot : ψ v₀ ∉ ψ '' ((V ∩ ψ ⁻¹' closedBall (ψ v₀) (r / 2)) ∩ (ball v₀ ε)ᶜ) := by
      rintro ⟨w, ⟨⟨hwV, -⟩, hwb⟩, hw⟩
      exact hwb (by rw [hinj hwV hv₀ hw]; exact mem_ball_self hε)
    obtain ⟨ρ, hρ, hρC⟩ := Metric.isOpen_iff.1 himg.isClosed.isOpen_compl (ψ v₀) hnot
    refine ⟨min ρ (r / 2), lt_min hρ (by linarith), fun v hv hdist => ?_⟩
    by_contra hcon
    exact hρC (mem_ball.2 (lt_of_lt_of_le hdist (min_le_left _ _)))
      ⟨v, ⟨⟨hv, mem_closedBall.2 (lt_of_lt_of_le hdist (min_le_right _ _)).le⟩,
        fun hvb => hcon (mem_ball.1 hvb)⟩, rfl⟩
  -- Step 4: near each `p = ψ v₀ ∈ N`, `y ↦ P_{range Dψ(φ y)}` is a `C¹` extension of `P_N`.
  have hloc : ∀ p ∈ N, ∃ (U : Set (Euclid P)) (f : Euclid P → (Euclid P →L[ℝ] Euclid P)),
      IsOpen U ∧ p ∈ U ∧ ContDiffOn ℝ 1 f U ∧
        ∀ z ∈ N ∩ U, f z = (Submodule.span ℝ (tangentSpace N z)).starProjection := by
    intro p hp
    obtain ⟨V, W, ψ, hV, hW, hpW, hψ, hinj, himg, hprop, hDψ⟩ := hN p hp
    have hpV : p ∈ ψ '' V := by rw [himg]; exact ⟨hpW, hp⟩
    obtain ⟨v₀, hv₀, rfl⟩ := hpV
    have hψ1 : ContDiffOn ℝ 1 ψ V := hψ.of_le (by exact_mod_cast (by norm_num : (1 : ℕ) ≤ 2))
    have hDψ1 : ContDiffOn ℝ 1 (fun v => fderiv ℝ ψ v) V := hψ.fderiv_of_isOpen hV (by norm_num)
    obtain ⟨O₁, φ, ε, hε, hO₁, hφ, hφV, hφψ⟩ := hlinv V ψ v₀ hV hψ1 hv₀ (hDψ v₀ hv₀)
    obtain ⟨ρ, hρ, hρε⟩ := hprox V W ψ v₀ hW hψ1.continuousOn hinj hprop hv₀ hpW ε hε
    refine ⟨O₁ ∩ ball (ψ v₀) ρ ∩ W,
      fun y => (LinearMap.range (fderiv ℝ ψ (φ y) : Euclid d →ₗ[ℝ] Euclid P)).starProjection,
      (hO₁.inter isOpen_ball).inter hW,
      ⟨⟨(hφψ v₀ (by simpa using hε)).2.1, mem_ball_self hρ⟩, hpW⟩, ?_, ?_⟩
    · intro y hy
      have hφy : φ y ∈ V := hφV hy.1.1
      exact ((hproj _ (hDψ _ hφy)).comp y ((hDψ1.contDiffAt (hV.mem_nhds hφy)).comp y
        (hφ.contDiffAt (hO₁.mem_nhds hy.1.1)))).contDiffWithinAt
    · rintro z ⟨hzN, ⟨hzO, hzρ⟩, hzW⟩
      have hzV : z ∈ ψ '' V := by rw [himg]; exact ⟨hzW, hzN⟩
      obtain ⟨v, hv, rfl⟩ := hzV
      -- `T_{ψ v}N = range Dψ(v)`
      have hspan : Submodule.span ℝ (tangentSpace N (ψ v)) =
          LinearMap.range (fderiv ℝ ψ v : Euclid d →ₗ[ℝ] Euclid P) := by
        rw [Submission.chart_tangentSpace_eq_range_fderiv P d 2 N W V ψ v (by norm_num) hV hW hψ
          hinj himg hprop hDψ hv, ← ContinuousLinearMap.coe_coe, ← LinearMap.coe_range,
          Submodule.span_eq]
      show (LinearMap.range (fderiv ℝ ψ (φ (ψ v)) : Euclid d →ₗ[ℝ] Euclid P)).starProjection = _
      rw [(hφψ v (hρε v hv (mem_ball.1 hzρ))).2.2, hspan]
  -- Step 5: glue the local extensions by a smooth partition of unity on `O = ⋃ₚ Uₚ`.
  choose! U f hU hpU hf hfN using hloc
  let O : Set (Euclid P) := ⋃ p ∈ N, U p
  have hO : IsOpen O := isOpen_biUnion fun p hp => hU p hp
  have hNO : N ⊆ O := fun p hp => mem_biUnion hp (hpU p hp)
  let O' : TopologicalSpace.Opens (Euclid P) := ⟨O, hO⟩
  have : LocallyCompactSpace O' := ChartedSpace.locallyCompactSpace (Euclid P) O'
  let t : O' → Set (Euclid P →L[ℝ] Euclid P) := fun x =>
    if (x : Euclid P) ∈ N then {(Submodule.span ℝ (tangentSpace N x)).starProjection} else univ
  have ht : ∀ x, Convex ℝ (t x) := by
    intro x
    by_cases hx : (x : Euclid P) ∈ N
    · simp only [t, ite_eq_left hx]
      exact convex_singleton _
    · simp only [t, ite_eq_right hx]
      exact convex_univ
  obtain ⟨g, hg⟩ := exists_contMDiffMap_forall_mem_convex_of_local (n := 1)
    (modelWithCornersSelf ℝ (Euclid P)) ht fun x => by
      have hx : (x : Euclid P) ∈ ⋃ p ∈ N, U p := x.2
      obtain ⟨p, hp, hxp⟩ := mem_iUnion₂.1 hx
      refine ⟨Subtype.val ⁻¹' U p,
        (continuous_subtype_val.isOpen_preimage _ (hU p hp)).mem_nhds hxp, fun y => f p y,
        fun y hy => ?_, fun y hy => ?_⟩
      · exact ContMDiffAt.contMDiffWithinAt ((contMDiffAt_subtype_iff (U := O') (f := f p)).2
          (contMDiffAt_iff_contDiffAt.2 ((hf p hp).contDiffAt ((hU p hp).mem_nhds hy))))
      · by_cases hyN : (y : Euclid P) ∈ N
        · simp only [t, ite_eq_left hyN, mem_singleton_iff]
          exact hfN p hp y ⟨hyN, hy⟩
        · simp only [t, ite_eq_right hyN, mem_univ]
  refine ⟨O, fun y => if hy : y ∈ O then g ⟨y, hy⟩ else 0, hO, hNO, fun y hy => ?_, fun z hz => ?_⟩
  · have hgy : ContMDiffAt (modelWithCornersSelf ℝ (Euclid P))
        (modelWithCornersSelf ℝ (Euclid P →L[ℝ] Euclid P)) 1
        (fun x : O' => (fun y => if hy : y ∈ O then g ⟨y, hy⟩ else 0) (x : Euclid P))
        ⟨y, hy⟩ := by
      refine (g.contMDiff ⟨y, hy⟩).congr_of_eventuallyEq (Eventually.of_forall fun x => ?_)
      have hx : (x : Euclid P) ∈ O := x.2
      simp only [dite_eq_left hx]
    exact (contMDiffAt_iff_contDiffAt.1 ((contMDiffAt_subtype_iff (U := O')
      (f := fun y => if hy : y ∈ O then g ⟨y, hy⟩ else 0)).1 hgy)).contDiffWithinAt
  · have h1 := hg ⟨z, hNO hz⟩
    simp only [t, ite_eq_left hz, mem_singleton_iff] at h1
    show (if hy : z ∈ O then g ⟨z, hy⟩ else 0) = _
    rw [dite_eq_left (hNO hz)]
    exact h1

/-- **Simon Ch. 4, 2.7 and 3.14** (with Ch. 2, 5.9): if `V = v(M, θ)` is stationary in `N ∩ U`,
where `N` is an embedded `C²` submanifold with `(N̄ \ N) ∩ U = ∅` and `Hⁿ(M \ N) = 0`, then `V`
has generalized mean curvature `H` in `U`, bounded on compact subsets of `U`.  Extend
`z ↦ P_{T_zN}` to a `C¹` field `pr` on an open `O ⊇ N` and take `H` with
`H(x) = Σⱼ (Dpr(x)[p eⱼ])*(p eⱼ)` on `N ∩ U`, `p = p_{TₓM}`.  For `X ∈ C¹_c(U)`, the tangential
part `X^T` (equal to `pr·X` near `N`) is tangent to `N` on `N ∩ U`, so `δV(X^T) = 0` and
`δV(X) = δV(X − X^T)`.  At `Hⁿ`-a.e. `x ∈ M`, `x ∈ N` and `TₓM ⊆ TₓN`, so
`div_M(X − X^T)(x) = −X(x)·H(x)`; integrating against `θ` gives `δV(X) = −∫ X·H dμ_V`. -/
theorem Submission.meanCurvature_bounded_of_stationaryAlong : ∀ (P n d : ℕ) (U N : Set (Euclid P)) (R : IMRep U n), IsOpen U → IsEmbeddedSubmanifold 2 d N → (closure N \ N) ∩ U = ∅ → μHE[n] (R.carrier \ N) = 0 → R.IsStationaryAlong N → R.HasLocallyBoundedMeanCurvature := by
  intro P n d U N R hU hN hNU hMN hstat
  -- the `C¹` extension `pr` of `z ↦ P_{T_zN}` to an open set `O ⊇ N`
  obtain ⟨O, pr, hO, hNO, hpr, hprN⟩ :=
    Submission.submanifold_tangentProjection_c1_extension P d N hN
  -- `p(x) = p_{TₓM}` is `Hⁿ⌞M`-a.e. strongly measurable, and `‖p(x)‖ ≤ 1`
  have hp : AEStronglyMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection)
      (μHE[n].restrict R.carrier) := Submission.imrep_approxTangent_starProjection_aesm P n U R
  -- `H` with `H(x) = Σⱼ (Dpr(x)[p eⱼ])*(p eⱼ)` on `N ∩ U`, measurable and bounded on compact
  -- subsets of `U`
  obtain ⟨H, hHm, hHb, hH⟩ := Submission.mcs_exists_meanCurvature_field P
    (μHE[n].restrict R.carrier) U N O pr _ hU hO hNO hpr hNU hp
    fun x => Submodule.starProjection_norm_le _
  -- `T_zN` is a linear subspace for `z ∈ N`, the range of `Dψ` in a chart
  have hTN : ∀ z ∈ N, ∃ T : Submodule ℝ (Euclid P), tangentSpace N z = T := by
    intro z hz
    obtain ⟨V, W, ψ, hV, hW, hzW, hψ, hinj, hψV, hproper, hDψ⟩ := hN z hz
    obtain ⟨v, hv, rfl⟩ : z ∈ ψ '' V := hψV ▸ ⟨hzW, hz⟩
    exact ⟨LinearMap.range (fderiv ℝ ψ v : Euclid d →ₗ[ℝ] Euclid P),
      Submission.chart_tangentSpace_eq_range_fderiv P d 2 N W V ψ v one_le_two hV hW hψ hinj hψV
        hproper hDψ hv⟩
  -- `C²` charts are `C¹` charts
  have hN1 : IsEmbeddedSubmanifold 1 d N := fun y hy => by
    obtain ⟨V, W, ψ, hV, hW, hyW, hψ, h⟩ := hN y hy
    exact ⟨V, W, ψ, hV, hW, hyW, hψ.of_le (by norm_num), h⟩
  -- `Hⁿ⌞M`-a.e. point lies in `N`, as `Hⁿ(M \ N) = 0`
  have hMN' : ∀ᵐ x ∂(μHE[n].restrict R.carrier), x ∈ N := by
    rw [ae_restrict_iff' R.measurableSet_carrier]
    filter_upwards [measure_eq_zero_iff_ae_notMem.1 hMN] with x hx hxM
    by_contra hxN
    exact hx ⟨hxM, hxN⟩
  refine ⟨H, hHm.mono_ac (withDensity_absolutelyContinuous _ _),
    fun K hK hKU => (hHb K hK hKU).imp fun Λ hΛ => ae_of_all _ hΛ, fun X hX hXc hXU => ?_⟩
  -- the tangential part `X^T ∈ C¹_c(U)`, equal to `pr·X` near every point of `N`
  obtain ⟨XT, hXT, hXTc, hXTU, hXTN⟩ :=
    Submission.mcs_exists_c1_field_eq_proj_near P U N O pr X hU hO hNO hpr hNU hX hXc hXU
  -- `X^T(z) = P_{T_zN} X(z) ∈ T_zN` on `N ∩ U`, so `δV(X^T) = 0` by stationarity
  have hXT0 : R.firstVariation XT = 0 := by
    refine hstat XT hXT hXTc hXTU fun z hz => ?_
    obtain ⟨T, hT⟩ := hTN z hz.1
    have hmem : XT z ∈ Submodule.span ℝ (tangentSpace N z) := by
      rw [(hXTN z hz.1).eq_of_nhds, hprN z hz.1]
      exact Submodule.starProjection_apply_mem _ _
    rw [hT, Submodule.span_eq] at hmem
    rwa [hT]
  -- `δV(X) = δV(X^T) + δV(X − X^T) = δV(X − X^T)`
  have hsplit : R.firstVariation X = R.firstVariation (X - XT) := by
    have h := Submission.mcs_firstVariation_add P n U R XT (X - XT) hp hXT hXTc hXTU (hX.sub hXT)
      (hXc.sub hXTc) ((tsupport_sub X XT).trans (union_subset hXU hXTU))
    rwa [add_sub_cancel, hXT0, zero_add] at h
  -- at `Hⁿ⌞M`-a.e. `x`: `x ∈ M ∩ N` and `TₓM ⊆ TₓN`, so `div_M(X − X^T)(x) = −X(x)·H(x)`
  have hdiv : ∀ᵐ x ∂(μHE[n].restrict R.carrier),
      tangentialDivergence n R.carrier (X - XT) x = -inner ℝ (X x) (H x) := by
    filter_upwards [ae_restrict_mem R.measurableSet_carrier, hMN', R.orients]
      with x hxM hxN ⟨Q, hQ, _⟩
    have hex : ∃ Q, HasApproximateTangentSpaceAt n R.carrier x Q := ⟨Q, hQ⟩
    have hTx : HasApproximateTangentSpaceAt n R.carrier x (approxTangentPlane n R.carrier x) := by
      rw [approxTangentPlane, dite_eq_left hex]
      exact hex.choose_spec
    have hQS : approxTangentPlane n R.carrier x ≤ Submodule.span ℝ (tangentSpace N x) :=
      fun u hu => Submodule.subset_span (Submission.approxTangent_le_submanifold_tangentSpace P n d
        N R.carrier x _ hN1 hxN hMN hTx hu)
    have hY : (X - XT) =ᶠ[𝓝 x] fun y => X y - pr y (X y) :=
      (hXTN x hxN).mono fun y hy => by rw [Pi.sub_apply, hy]
    have hprx : DifferentiableAt ℝ pr x :=
      (hpr.differentiableOn one_ne_zero).differentiableAt (hO.mem_nhds (hNO hxN))
    rw [tangentialDivergence, Submission.mcs_trace_normal_part_eq_neg_inner P _ _ pr X (X - XT) x
      hQS (hprN x hxN) hprx (hX.differentiable one_ne_zero x) hY, hH x ⟨hxN, R.carrier_subset hxM⟩]
  -- integrate against `θ`: `∫_M θ div_M(X − X^T) dHⁿ = −∫ X·H dμ_V`
  have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) :=
    (measurable_from_nat (f := fun k : ℕ => (k : ℝ≥0∞))).comp R.measurable_mult
  rw [hsplit, IMRep.firstVariation, IMRep.measure, integral_withDensity_eq_integral_toReal_smul hθ
    (ae_of_all _ fun x => ENNReal.natCast_lt_top _), ← integral_neg]
  refine integral_congr_ae ?_
  filter_upwards [hdiv] with x hx
  rw [hx, ENNReal.toReal_natCast, smul_eq_mul, mul_neg]

/-- **Simon 7.1.2** (chapter-07.txt lines 29–60, with README erratum 1).  For a representation
`R = (M, θ, ξ)` of `T`, `Hⁿ(M ∖ spt T) = 0`, hence `Hⁿ(M ∖ N) = 0` because `spt T ⊆ N`.
Comparing `T` with the competitors `φ_{t#}T` of 1.2 (2), (3), where `φ_t` preserves `N ∩ U` and
is the identity off `spt X` (Ch. 4, 2.1 with `U ∩ N` in place of `U`), shows that `v(M, θ)` is
stationary in `N ∩ U`; stationarity in `N ∩ U` then gives a generalized mean curvature in `U`
that is bounded on compact sets (Ch. 4, 2.7 and 3.14).  The hypothesis `ℓ ≤ k` is not used. -/
theorem Submission.minimizing_implies_stationary : MinimizingImpliesStationary := by
  intro n k ℓ _hℓk U N T hU hN hNcl hTN hmin hbdry R hR
  -- `μ_T(U ∖ spt T) = 0` and `spt T ⊆ N`.
  have hnull : μHE[n] (R.carrier \ N) = 0 :=
    measure_mono_null (Set.sdiff_subset_sdiff_right hTN)
      (Submission.imrep_carrier_sdiff_support_null (n + k) n U T R hU hR)
  have hstat : R.IsStationaryAlong N :=
    Submission.stationaryAlong_of_minimizing_in_submanifold (n + k) n (n + ℓ) U N T R hU hN hNcl
      hmin hbdry hR hnull
  exact ⟨hstat, Submission.meanCurvature_bounded_of_stationaryAlong (n + k) n (n + ℓ) U N R hU hN
    hNcl hnull hstat⟩
/-- **Approximate tangent planes of a bi-Lipschitz piece image** (Simon Ch. 3, 1.4, by the density
argument of Theorem 1.6): if `g : ℝⁿ → ℝᴾ` is `L`-Lipschitz, `A` is Borel,
`c‖a − a'‖ ≤ ‖g(a) − g(a')‖` on `A` (`c > 0`) and `g` is differentiable with injective derivative
on `A`, then for a.e. `b ∈ A`, `g(A)` has approximate tangent space `range Dg(b)` at `g(b)`.
At a density point `b` of `A` that is a Lebesgue point of the Jacobian `0 ≤ J_g ≤ Lⁿ`, the
injective area formula turns the blow-up integrals into
`∫ 1_A(b + rv) J_g(b + rv) f(r⁻¹(g(b + rv) − g(b))) dv`, which tends to
`J_g(b) ∫ f(Dg(b)v) dv = ∫_{range Dg(b)} f dHⁿ`. -/
theorem Submission.idtp_caf_piece_image_approxTangent_ae : ∀ (P n : ℕ) (g : Euclid n → Euclid P) (A : Set (Euclid n)) (L : NNReal) (c : ℝ), 1 ≤ n → LipschitzWith L g → MeasurableSet A → 0 < c → (∀ a ∈ A, ∀ a' ∈ A, c * ‖a - a'‖ ≤ ‖g a - g a'‖) → (∀ a ∈ A, DifferentiableAt ℝ g a ∧ Injective (fderiv ℝ g a)) → ∀ᵐ a ∂(volume.restrict A), HasApproximateTangentSpaceAt n (g '' A) (g a) (LinearMap.range (fderiv ℝ g a : Euclid n →ₗ[ℝ] Euclid P)) := by
  intro P n g A L c _ hg hA hc hco hdiff
  -- the area Jacobian `J = J_g` is Borel and nonnegative
  set J : Euclid n → ℝ := Poincare.SimonGMT.Chapter02.areaJacobianAt g with hJ_def
  have hJm : Measurable J := Poincare.SimonGMT.Chapter02.measurable_areaJacobianAt g
  have hJ0 : ∀ a, 0 ≤ J a := Poincare.SimonGMT.Chapter02.areaJacobianAt_nonneg g
  -- `Hⁿ(Dg(a)(S)) = J(a) λ(S)` for every `a` and every `S`
  have hlin : ∀ (a : Euclid n) (S : Set (Euclid n)),
      μHE[n] (fderiv ℝ g a '' S) = ENNReal.ofReal (J a) * volume S := by
    intro a S
    have h := LinearMap.euclideanHausdorffMeasure_image_eq_normDet_mul_volume
      (fderiv ℝ g a : Euclid n →ₗ[ℝ] Euclid P) S
    rw [finrank_euclideanSpace_fin, ContinuousLinearMap.coe_coe] at h
    rw [h, hJ_def, Poincare.SimonGMT.Chapter02.areaJacobianAt_eq_normDet]
  -- `J ≤ Lⁿ`: `Dg(a)` is `L`-Lipschitz, so `J(a) λ(B̄₁(0)) = Hⁿ(Dg(a)(B̄₁(0))) ≤ Lⁿ λ(B̄₁(0))`
  have hJL : ∀ a, J a ≤ (L : ℝ) ^ n := by
    intro a
    have hTL : LipschitzWith L (fderiv ℝ g a) :=
      (fderiv ℝ g a).lipschitzWith.weaken (by
        rw [← NNReal.coe_le_coe, coe_nnnorm]
        exact norm_fderiv_le_of_lipschitz ℝ hg)
    have hle := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
      (hTL.lipschitzOnWith (s := closedBall (0 : Euclid n) 1))
    rw [hlin, EuclideanSpace.euclideanHausdorffMeasure_eq_volume] at hle
    have hle' := (ENNReal.mul_le_mul_iff_left
      (measure_closedBall_pos volume (0 : Euclid n) one_pos).ne' measure_closedBall_lt_top.ne).1 hle
    rw [← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_pow NNReal.zero_le_coe,
      ENNReal.ofReal_le_ofReal_iff (pow_nonneg NNReal.zero_le_coe n)] at hle'
    exact hle'
  -- `g` is injective on `A`, so the injective Lipschitz area formula holds on `A`
  have hinj : InjOn g A := by
    intro a ha a' ha' h
    have h1 := hco a ha a' ha'
    rw [h, sub_self, norm_zero, ← mul_zero c] at h1
    exact sub_eq_zero.1 (norm_le_zero_iff.1 (le_of_mul_le_mul_left h1 hc))
  have harea : ∀ φ : Euclid P → ℝ≥0∞,
      ∫⁻ y in g '' A, φ y ∂μHE[n] = ∫⁻ x in A, ENNReal.ofReal (J x) * φ (g x) ∂volume := by
    intro φ
    have h := Poincare.SimonGMT.Chapter02.weighted_area_formula_lipschitz_injOn hg hA hinj φ
    rw [finrank_euclideanSpace_fin] at h
    exact h
  -- a.e. point of `A` is a density point of `A` and a Lebesgue point of the bounded Borel `J`
  have hdens := Besicovitch.ae_tendsto_measure_inter_div (volume : Measure (Euclid n)) A
  have hJloc : LocallyIntegrable J volume :=
    (locallyIntegrable_const ((L : ℝ) ^ n)).mono hJm.aestronglyMeasurable
      (Eventually.of_forall fun a => by
        rw [Real.norm_of_nonneg (hJ0 a), Real.norm_of_nonneg (pow_nonneg NNReal.zero_le_coe n)]
        exact hJL a)
  have hleb : ∀ᵐ b ∂(volume : Measure (Euclid n)),
      Tendsto (fun ρ : ℝ => ⨍ a in closedBall b ρ, ‖J a - J b‖ ∂volume) (𝓝[>] 0) (𝓝 0) := by
    filter_upwards [(Besicovitch.vitaliFamily
      (volume : Measure (Euclid n))).ae_tendsto_average_norm_sub hJloc] with b hb
    exact hb.comp (Besicovitch.tendsto_filterAt volume b)
  filter_upwards [ae_restrict_mem hA, hdens, ae_restrict_of_ae hleb] with b hbA hbdens hbleb
  obtain ⟨hgb, hinjb⟩ := hdiff b hbA
  have hcob : ∀ a ∈ A, c * ‖a - b‖ ≤ ‖g a - g b‖ := fun a ha => hco a ha b hbA
  -- at a density point, `c‖v‖ ≤ ‖Dg(b)v‖`
  have hγ := Submission.pit_fderiv_lower_bound_of_density P n g A c b hc hcob hgb hbdens
  refine ⟨?_, fun f => ?_⟩
  · rw [LinearMap.finrank_range_of_inj hinjb, finrank_euclideanSpace_fin]
  · -- `∫_{range Dg(b)} f dHⁿ = J(b) ∫ f(Dg(b)v) dv`
    rw [Submission.pit_setIntegral_range_linear P n (fderiv ℝ g b) (J b) f (hJ0 b) (hlin b)
      (map_continuous f)]
    -- the rescaled area integrals converge to it, and equal the blow-up integrals for `r > 0`
    refine (Submission.idtp_caf_rescaled_integral_tendsto P n g A J ((L : ℝ) ^ n) c b f
      hg.continuous hA hJm (fun a => ⟨hJ0 a, hJL a⟩) hc hcob hgb hγ hbdens hbleb
      (map_continuous f) f.hasCompactSupport).congr' ?_
    filter_upwards [self_mem_nhdsWithin] with r (hr : 0 < r)
    exact (Submission.pit_blowUp_image_setIntegral_eq_rescaled P n g A J b r f hg.continuous hA
      hJm hJ0 harea hr (map_continuous f)).symm
/-- **Approximate tangent planes along a bi-Lipschitz piece** (Simon Ch. 3, 1.4–1.5).  Let
`M ⊆ ℝᴾ` be Borel with `Hⁿ(M ∩ K) < ∞` for compact `K`, and `g : ℝⁿ → ℝᴾ` Lipschitz with
`c‖a − a'‖ ≤ ‖g a − g a'‖` on the Borel set `A`, differentiable with injective derivative on `A`,
and `g(A) ⊆ M`.  Then `T_{g(a)}M = range Dg(a)` for Lebesgue-a.e. `a ∈ A`: `g(A) ⊆ M` is Borel and
locally `Hⁿ`-finite, so `g(A)` and `M` have the same approximate tangent planes `Hⁿ`-a.e. on
`g(A)`; this pulls back to a.e. `a ∈ A`, where `g(A)` has approximate tangent space
`range Dg(a)` at `g(a)`. -/
theorem Submission.idtp_caf_piece_approxTangentPlane_ae : ∀ (P n : ℕ) (M : Set (Euclid P)) (g : Euclid n → Euclid P) (A : Set (Euclid n)) (L : NNReal) (c : ℝ), 1 ≤ n → MeasurableSet M → (∀ K : Set (Euclid P), IsCompact K → μHE[n] (M ∩ K) ≠ ∞) → LipschitzWith L g → MeasurableSet A → 0 < c → (∀ a ∈ A, ∀ a' ∈ A, c * ‖a - a'‖ ≤ ‖g a - g a'‖) → (∀ a ∈ A, DifferentiableAt ℝ g a ∧ Injective (fderiv ℝ g a)) → g '' A ⊆ M → ∀ᵐ a ∂(volume.restrict A), approxTangentPlane n M (g a) = LinearMap.range (fderiv ℝ g a : Euclid n →ₗ[ℝ] Euclid P) := by
  intro P n M g A L c hn hM hMfin hg hA hc hlow hdiff hAM
  -- Step 1: `g(A)` is Borel, and `Hⁿ⌞g(A)`-a.e. properties hold at `g a` for a.e. `a ∈ A`
  obtain ⟨hgA, hpull⟩ :=
    Submission.ptd_piece_image_measurable_ae_pullback P n g A L c hg hA hc hlow
  -- Step 2: `g(A) ⊆ M` is locally `Hⁿ`-finite
  have hgAfin : ∀ K : Set (Euclid P), IsCompact K → K ⊆ univ → μHE[n] (g '' A ∩ K) ≠ ∞ :=
    fun K hK _ => ne_top_of_le_ne_top (hMfin K hK) (measure_mono (inter_subset_inter_left K hAM))
  -- Step 3: `g(A)` and `M` have the same approximate tangent planes `Hⁿ⌞g(A)`-a.e.
  have htrans : ∀ᵐ y ∂(μHE[n].restrict (g '' A)), ∀ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n (g '' A) y Q ↔ HasApproximateTangentSpaceAt n M y Q := by
    rw [ae_restrict_iff' hgA]
    filter_upwards [Submission.doraggt_ae_approxTangent_transfer P n univ (g '' A) M isOpen_univ
      hgA hM hgAfin fun K hK _ => hMfin K hK] with y hy hyA using hy (mem_univ y) hyA (hAM hyA)
  -- Step 4: pull back to a.e. `a ∈ A`; step 5: the tangent plane of the piece at `g a`
  filter_upwards [hpull _ htrans,
    Submission.idtp_caf_piece_image_approxTangent_ae P n g A L c hn hg hA hc hlow hdiff]
    with a hQ hT
  -- Step 6: `range Dg(a)` is the approximate tangent space of `M` at `g a`
  exact Submission.dpf_itt_approxTangentPlane_eq P n M (g a) _ ((hQ _).1 hT)
/-- **Fibre sums of `Hⁿ`-a.e. equal weights agree `Lⁿ`-a.e.** (Simon Ch. 2, 1.8(i): Lipschitz
images of `Hⁿ`-null sets are `Hⁿ`-null).  Let `S ⊆ V`, `F = G` on `V` with `G` Lipschitz, and
`h = h'` `Hⁿ⌞S`-a.e.  Enlarge `{h ≠ h'}` to a Borel `Hⁿ⌞S`-null set `N`; then `Hⁿ(N ∩ S) = 0`, so
`F(N ∩ S) = G(N ∩ S)` is `Hⁿ = Lⁿ`-null.  For `y ∉ F(N ∩ S)` every `x ∈ S` with `F(x) = y` lies
outside `N`, so `h(x) = h'(x)` and the fibre sums `Σ_{x ∈ S, F(x) = y}` of `h` and `h'` agree. -/
theorem Submission.idtp_caf_paf_fiberSum_ae_congr : ∀ (P n : ℕ) (S V : Set (Euclid P)) (F G : Euclid P → Euclid n) (LG : NNReal) (h h' : Euclid P → ℝ≥0∞), S ⊆ V → LipschitzWith LG G → EqOn F G V → h =ᵐ[μHE[n].restrict S] h' → (fun y : Euclid n => ∑' x : ↥(S ∩ F ⁻¹' {y}), h x) =ᵐ[volume] (fun y : Euclid n => ∑' x : ↥(S ∩ F ⁻¹' {y}), h' x) := by
  intro P n S V F G LG h h' hSV hG hFG hh
  -- a Borel `Hⁿ⌞S`-null set `N ⊇ {h ≠ h'}`; then `Hⁿ(N ∩ S) = 0`
  obtain ⟨N, hNsub, hNmeas, hN0⟩ := exists_measurable_superset_of_null (ae_iff.1 hh)
  rw [Measure.restrict_apply hNmeas] at hN0
  -- `F(N ∩ S) = G(N ∩ S)` is `Hⁿ`-null (Lipschitz image), i.e. `Lⁿ`-null
  have hFG' : F '' (N ∩ S) = G '' (N ∩ S) := image_congr fun x hx => hFG (hSV hx.2)
  have hM : volume (F '' (N ∩ S)) = 0 := by
    rw [hFG', ← EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
    refine le_antisymm ?_ zero_le
    calc μHE[n] (G '' (N ∩ S)) ≤ (LG : ℝ≥0∞) ^ n * μHE[n] (N ∩ S) :=
          Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
            hG.lipschitzOnWith
      _ = 0 := by rw [hN0, mul_zero]
  -- off `F(N ∩ S)` every fibre point lies outside `N`, where `h = h'`
  filter_upwards [measure_eq_zero_iff_ae_notMem.1 hM] with y hy
  refine tsum_congr fun x => ?_
  by_contra hne
  exact hy ⟨x, ⟨hNsub hne, x.2.1⟩, x.2.2⟩
/-- **Weighted area formula, fibre side** (Simon Ch. 2, §3, (3.4)–(3.5), for the Lipschitz map
`Φ : ℝⁿ → ℝⁿ`).  Let `g` be continuous and injective on the Borel set `A`, let `F ∘ g = Φ` on `A`
with `Φ` Lipschitz, and let `h ≥ 0` be Borel.  Then `y ↦ Σ_{x ∈ g(A), F(x) = y} h(x)` is
`Lⁿ`-a.e. measurable and its integral is `∫_A |det DΦ(a)| h(g(a)) dLⁿ(a)`.  The carrier fibre
over `y` is `g(A ∩ Φ⁻¹{y})`, so the fibre sum is `Σ_{a ∈ A, Φ(a) = y} h(g(a))`.  The formula for
`Φ` is proved in place from Mathlib's change of variables, as the SimonGMT area formula is not
available in this file.  Off the null images of the non-differentiability set (Rademacher and
the Lipschitz image bound) and of the critical set (Sard), the fibre sum splits over a countable
partition of `A` into pieces on which `Φ` is injective, and on each piece the injective change
of variables formula applies. -/
theorem Submission.idtp_caf_paf_fiber_side : ∀ (P n : ℕ) (g : Euclid n → Euclid P) (A : Set (Euclid n)) (F : Euclid P → Euclid n) (Φ : Euclid n → Euclid n) (LΦ : NNReal) (h : Euclid P → ℝ≥0∞), Continuous g → MeasurableSet A → InjOn g A → LipschitzWith LΦ Φ → (∀ a ∈ A, F (g a) = Φ a) → Measurable h → AEMeasurable (fun y : Euclid n => ∑' x : ↥(g '' A ∩ F ⁻¹' {y}), h x) volume ∧ ∫⁻ y, (∑' x : ↥(g '' A ∩ F ⁻¹' {y}), h x) ∂volume = ∫⁻ a in A, ENNReal.ofReal |LinearMap.det (fderiv ℝ Φ a : Euclid n →ₗ[ℝ] Euclid n)| * h (g a) ∂volume := by
  intro P n g A F Φ LΦ h hg hA hgA hΦ hFg hh
  -- the weight `w = h ∘ g` on the parameter side is Borel
  set w : Euclid n → ℝ≥0∞ := fun a => h (g a)
  have hw : Measurable w := hh.comp hg.measurable
  -- `g(A) ∩ F⁻¹{y} = g(A ∩ Φ⁻¹{y})`, and `tsum_image` reindexes the fibre sum
  have hfib : ∀ y, (∑' x : ↥(g '' A ∩ F ⁻¹' {y}), h x) = ∑' a : ↥(A ∩ Φ ⁻¹' {y}), w a := by
    intro y
    have hset : g '' A ∩ F ⁻¹' {y} = g '' (A ∩ Φ ⁻¹' {y}) := by
      ext x
      simp only [mem_inter_iff, mem_image, mem_preimage, mem_singleton_iff]
      constructor
      · rintro ⟨⟨a, ha, rfl⟩, hy⟩
        exact ⟨a, ⟨ha, (hFg a ha).symm.trans hy⟩, rfl⟩
      · rintro ⟨a, ⟨ha, hy⟩, rfl⟩
        exact ⟨⟨a, ha, rfl⟩, (hFg a ha).trans hy⟩
    rw [hset, tsum_image h (hgA.mono inter_subset_left)]
  simp only [hfib]
  -- `D`: differentiability points of `Φ`; `s`: the points of `A ∩ D` with `det DΦ ≠ 0`
  set D : Set (Euclid n) := {x | DifferentiableAt ℝ Φ x}
  have hDm : MeasurableSet D := measurableSet_of_differentiableAt ℝ Φ
  have hdetm : Measurable fun x => (fderiv ℝ Φ x).det :=
    ContinuousLinearMap.continuous_det.measurable.comp (measurable_fderiv ℝ Φ)
  set s : Set (Euclid n) := A ∩ D ∩ {x | (fderiv ℝ Φ x).det ≠ 0}
  have hsm : MeasurableSet s := (hA.inter hDm).inter (hdetm (measurableSet_singleton 0).compl)
  -- precision `r B` with `r B * ‖B⁻¹‖ < 1` whenever `B` is invertible
  let r : (Euclid n →L[ℝ] Euclid n) → NNReal := fun B =>
    if hB : B.det ≠ 0 then
      (‖((B.toContinuousLinearEquivOfDetNeZero hB).symm : Euclid n →L[ℝ] Euclid n)‖₊ + 1)⁻¹
    else 1
  have rpos : ∀ B, r B ≠ 0 := by
    intro B
    simp only [r]
    split_ifs
    · exact inv_ne_zero (by positivity)
    · exact one_ne_zero
  -- a countable measurable partition of `s` into pieces `S k` on which `Φ` is close to `B k`
  obtain ⟨t, B, ht_disj, ht_meas, hst, happrox, hB⟩ :=
    exists_partition_approximatesLinearOn_of_hasFDerivWithinAt Φ s (fderiv ℝ Φ)
      (fun x hx => (hx.1.2 : DifferentiableAt ℝ Φ x).hasFDerivAt.hasFDerivWithinAt) r rpos
  set S : ℕ → Set (Euclid n) := fun k => s ∩ t k
  have hSm : ∀ k, MeasurableSet (S k) := fun k => hsm.inter (ht_meas k)
  have hSdisj : Pairwise (Disjoint on S) := fun i j hij =>
    (ht_disj hij).mono inter_subset_right inter_subset_right
  have hSU : ⋃ k, S k = s := by
    simp only [S, ← inter_iUnion]
    exact inter_eq_left.mpr hst
  have hSder : ∀ k, ∀ x ∈ S k, HasFDerivWithinAt Φ (fderiv ℝ Φ x) (S k) x := fun k x hx =>
    (hx.1.1.2 : DifferentiableAt ℝ Φ x).hasFDerivAt.hasFDerivWithinAt
  -- `Φ` is injective on each piece: `B k = DΦ(z)` is invertible and `r (B k) * ‖(B k)⁻¹‖ < 1`
  have hSinj : ∀ k, InjOn Φ (S k) := by
    intro k x hx y hy hxy
    obtain ⟨z, hz, hBz⟩ := hB ⟨x, hx.1⟩ k
    have hdet : (B k).det ≠ 0 := hBz ▸ hz.2
    set e := (B k).toContinuousLinearEquivOfDetNeZero hdet
    set N : ℝ := ‖(e.symm : Euclid n →L[ℝ] Euclid n)‖
    have hr : ((r (B k) : NNReal) : ℝ) = (N + 1)⁻¹ := by
      simp only [r, dite_eq_left hdet, NNReal.coe_inv, NNReal.coe_add, coe_nnnorm,
        NNReal.coe_one, N, e]
    have happ := happrox k x hx y hy
    rw [hxy, sub_self, zero_sub, norm_neg, hr] at happ
    have h1 : ‖x - y‖ ≤ N * ‖B k (x - y)‖ := by
      have hxy' : e.symm (B k (x - y)) = x - y := by
        rw [show B k (x - y) = e (x - y) from rfl, ContinuousLinearEquiv.symm_apply_apply]
      calc ‖x - y‖ = ‖(e.symm : Euclid n →L[ℝ] Euclid n) (B k (x - y))‖ := by
              rw [ContinuousLinearEquiv.coe_coe, hxy']
        _ ≤ N * ‖B k (x - y)‖ := (e.symm : Euclid n →L[ℝ] Euclid n).le_opNorm _
    have hN : 0 ≤ N := norm_nonneg _
    have h2 : ‖x - y‖ ≤ N * ((N + 1)⁻¹ * ‖x - y‖) :=
      h1.trans (mul_le_mul_of_nonneg_left happ hN)
    have h3 : ‖x - y‖ ≤ 0 := by
      have hN1 : 0 < N + 1 := by linarith
      have h4 : N * ((N + 1)⁻¹ * ‖x - y‖) = ‖x - y‖ - (N + 1)⁻¹ * ‖x - y‖ := by
        field_simp
        ring
      rw [h4] at h2
      have h5 : (N + 1)⁻¹ * ‖x - y‖ ≤ 0 := by linarith
      have h6 : 0 < (N + 1)⁻¹ := inv_pos.mpr hN1
      nlinarith [norm_nonneg (x - y)]
    exact sub_eq_zero.mp (norm_le_zero_iff.mp h3)
  -- `G k y`: the fibre sum of `w` over `S k ∩ Φ⁻¹{y}`, which has at most one point
  set G : ℕ → Euclid n → ℝ≥0∞ := fun k y => ∑' a, (S k ∩ Φ ⁻¹' {y}).indicator w a
  have hG_apply : ∀ k, ∀ x ∈ S k, G k (Φ x) = w x := by
    intro k x hx
    simp only [G]
    rw [tsum_eq_single x]
    · exact indicator_of_mem (show x ∈ S k ∩ Φ ⁻¹' {Φ x} from ⟨hx, rfl⟩) w
    · intro a hax
      exact indicator_of_notMem (fun ha => hax (hSinj k ha.1 hx ha.2)) w
  have hG_zero : ∀ k y, y ∉ Φ '' S k → G k y = 0 := by
    intro k y hy
    simp only [G]
    exact (tsum_congr fun a => indicator_of_notMem (fun ha => hy ⟨a, ha.1, ha.2⟩) w).trans
      tsum_zero
  have hG_meas : ∀ k, Measurable (G k) := by
    intro k
    have hemb := measurableEmbedding_of_fderivWithin (hSm k) (hSder k) (hSinj k)
    have hGe : G k = Function.extend ((S k).domRestrict Φ) (fun x => w x) 0 := by
      funext y
      by_cases hy : ∃ x : S k, (S k).domRestrict Φ x = y
      · obtain ⟨x, rfl⟩ := hy
        rw [hemb.injective.extend_apply]
        exact hG_apply k x x.2
      · rw [extend_apply' _ _ _ hy, hG_zero k y]
        · rfl
        · rintro ⟨x, hx, rfl⟩
          exact hy ⟨⟨x, hx⟩, rfl⟩
    rw [hGe]
    exact hemb.measurable_extend (hw.comp measurable_subtype_coe) measurable_const
  -- injective change of variables on each piece
  have hG_int : ∀ k, ∫⁻ y, G k y =
      ∫⁻ x in S k, ENNReal.ofReal |(fderiv ℝ Φ x).det| * w x := by
    intro k
    rw [← setLIntegral_eq_of_support_subset (s := Φ '' S k) (fun y hy => by
        by_contra hy'
        exact hy (hG_zero k y hy')),
      lintegral_image_eq_lintegral_abs_det_fderiv_mul volume (hSm k) (hSder k) (hSinj k)]
    exact setLIntegral_congr_fun (hSm k) (fun x hx => by rw [hG_apply k x hx])
  -- null images: of `Dᶜ` (Rademacher, Lipschitz image bound) and of the critical set (Sard)
  have hDc : volume Dᶜ = 0 := ae_iff.mp (hΦ.ae_differentiableAt (μ := volume))
  have hnull1 : volume (Φ '' Dᶜ) = 0 := by
    have h1 := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
      (hΦ.lipschitzOnWith (s := Dᶜ))
    rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume, hDc, mul_zero] at h1
    exact nonpos_iff_eq_zero.mp h1
  have hnull2 : volume (Φ '' (A ∩ D ∩ {x | (fderiv ℝ Φ x).det = 0})) = 0 :=
    addHaar_image_eq_zero_of_det_fderivWithin_eq_zero volume
      (fun x hx => (hx.1.2 : DifferentiableAt ℝ Φ x).hasFDerivAt.hasFDerivWithinAt)
      (fun x hx => hx.2)
  -- off these null sets, the fibre sum over `A` splits over the pieces
  have hae : ∀ᵐ y ∂volume, (∑' a : ↥(A ∩ Φ ⁻¹' {y}), w a) = ∑' k, G k y := by
    filter_upwards [measure_eq_zero_iff_ae_notMem.mp (measure_union_null hnull1 hnull2)] with y hy
    rw [tsum_subtype (A ∩ Φ ⁻¹' {y}) w]
    simp only [G]
    rw [ENNReal.tsum_comm]
    refine tsum_congr fun a => ?_
    by_cases ha : a ∈ A ∩ Φ ⁻¹' {y}
    · have haD : a ∈ D := by
        by_contra hD
        exact hy (Or.inl ⟨a, hD, ha.2⟩)
      have hadet : (fderiv ℝ Φ a).det ≠ 0 := by
        intro h0
        exact hy (Or.inr ⟨a, ⟨⟨ha.1, haD⟩, h0⟩, ha.2⟩)
      have has : a ∈ s := ⟨⟨ha.1, haD⟩, hadet⟩
      obtain ⟨k, hk⟩ := mem_iUnion.mp (hst has)
      rw [indicator_of_mem ha, tsum_eq_single k]
      · exact (indicator_of_mem (show a ∈ S k ∩ Φ ⁻¹' {y} from ⟨⟨has, hk⟩, ha.2⟩) w).symm
      · intro j hj
        exact indicator_of_notMem (fun haj => Set.disjoint_left.mp (ht_disj hj) haj.1.2 hk) w
    · rw [indicator_of_notMem ha]
      exact ((tsum_congr fun k => indicator_of_notMem
        (fun hak => ha ⟨hak.1.1.1.1, hak.2⟩) w).trans tsum_zero).symm
  have hGsum : Measurable fun y => ∑' k, G k y := Measurable.tsum hG_meas
  refine ⟨hGsum.aemeasurable.congr (Filter.EventuallyEq.symm hae), ?_⟩
  rw [lintegral_congr_ae hae, lintegral_tsum (fun k => (hG_meas k).aemeasurable)]
  simp only [hG_int]
  rw [← lintegral_iUnion hSm hSdisj, hSU]
  -- the integrand vanishes a.e. on `A \ s`
  rw [← inter_eq_left.mpr (show s ⊆ A from fun x hx => hx.1.1), ← setLIntegral_indicator hsm]
  apply lintegral_congr_ae
  filter_upwards [ae_restrict_of_ae (hΦ.ae_differentiableAt (μ := volume)), ae_restrict_mem hA]
    with x hxD hxA
  by_cases hxs : x ∈ s
  · rw [indicator_of_mem hxs]
  · rw [indicator_of_notMem hxs]
    have h0 : (fderiv ℝ Φ x).det = 0 := by
      by_contra h0
      exact hxs ⟨⟨hxA, hxD⟩, h0⟩
    have h0' : LinearMap.det (fderiv ℝ Φ x : Euclid n →ₗ[ℝ] Euclid n) = 0 := h0
    simp [h0']
/-- **Carrier side of the area formula on one piece** (Simon Ch. 3, 2.4–2.5, with the injective
area formula of Ch. 2, §3).  Let `g : ℝⁿ → ℝᴾ` be Lipschitz, injective on the Borel set `A` and
differentiable at every point of `A`, let `F = G` on an open `V ⊇ g(A)` with `F` differentiable on
`g(A)`, and let `T(g(a)) = range Dg(a)` for a.e. `a ∈ A`.  With `u` the standard orthonormal basis
of `T(x)` and `J_T(x) = √det(DF(x)uᵢ · DF(x)uⱼ)`, every `h ≥ 0` has
`∫_{g(A)} J_T h dHⁿ = ∫_A |det D(G ∘ g)| h ∘ g dLⁿ`.

The area formula is proved inline.  `J L = √det(L eᵢ · L eⱼ)` is the Jacobian of a linear
`L : ℝᵐ → Y`; for injective `L`, `L = ι ∘ M` with `ι` an isometry and `J L = |det M|`, so
`Hᵐ(L(S)) = J L · Hᵐ(S)`.  On pieces where `g` is close to an injective linear map, Hausdorff
measure of the image is comparable to `J`, giving `Hⁿ(g(E)) = ∫_E J(Dg)` where `Dg` is injective;
where `Dg` is not injective, the graphs `x ↦ (g x, εx)` show `Hⁿ(g(E)) = 0` as `ε → 0`.  A.e. on
`A`, `D(G ∘ g)(a) = DF(g(a)) ∘ Dg(a)` and comparing volumes of the image of the unit ball gives
`|det D(G ∘ g)(a)| = J_T(g(a)) · J(Dg(a))`. -/
theorem Submission.idtp_caf_paf_carrier_side : ∀ (P n : ℕ) (g : Euclid n → Euclid P) (A : Set (Euclid n)) (Lg : NNReal) (V : Set (Euclid P)) (F G : Euclid P → Euclid n) (T : Euclid P → Submodule ℝ (Euclid P)) (h : Euclid P → ℝ≥0∞), LipschitzWith Lg g → MeasurableSet A → InjOn g A → (∀ a ∈ A, DifferentiableAt ℝ g a) → IsOpen V → g '' A ⊆ V → EqOn F G V → (∀ x ∈ g '' A, DifferentiableAt ℝ F x) → (∀ᵐ a ∂(volume.restrict A), T (g a) = LinearMap.range (fderiv ℝ g a : Euclid n →ₗ[ℝ] Euclid P)) → ∫⁻ x in g '' A, ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ (T x)) => inner ℝ (fderiv ℝ F x (stdOrthonormalBasis ℝ (T x) i)) (fderiv ℝ F x (stdOrthonormalBasis ℝ (T x) j))))) * h x ∂μHE[n] = ∫⁻ a in A, ENNReal.ofReal |LinearMap.det (fderiv ℝ (G ∘ g) a : Euclid n →ₗ[ℝ] Euclid n)| * h (g a) ∂volume := by
  classical
  -- the Jacobian `J L = √det(L eᵢ · L eⱼ)` of a linear map `L : ℝᵐ → Y`
  obtain ⟨Jac, hJac⟩ : ∃ Jac : ∀ {m : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y],
      (EuclideanSpace ℝ (Fin m) →L[ℝ] Y) → ℝ,
      ∀ {m : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]
        (L : EuclideanSpace ℝ (Fin m) →L[ℝ] Y),
        Jac L = Real.sqrt (Matrix.det (Matrix.of fun i j : Fin m =>
          inner ℝ (L (EuclideanSpace.single i 1)) (L (EuclideanSpace.single j 1)))) :=
    ⟨fun {m} {_} [_] [_] L => Real.sqrt (Matrix.det (Matrix.of fun i j : Fin m =>
      inner ℝ (L (EuclideanSpace.single i 1)) (L (EuclideanSpace.single j 1)))),
      fun _ => rfl⟩
  have jac_nonneg : ∀ {m : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]
      (L : EuclideanSpace ℝ (Fin m) →L[ℝ] Y), 0 ≤ Jac L := by
    intro m Y _ _ L
    rw [hJac]
    exact Real.sqrt_nonneg _
  -- an injective `L` factors as `ι ∘ M` with `ι` an isometry, and `J L = |det M| ≠ 0`
  have jac_factor : ∀ {m : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]
      [FiniteDimensional ℝ Y] (L : EuclideanSpace ℝ (Fin m) →L[ℝ] Y), Injective L →
      ∃ (ι : EuclideanSpace ℝ (Fin m) →ₗᵢ[ℝ] Y)
        (M : EuclideanSpace ℝ (Fin m) →ₗ[ℝ] EuclideanSpace ℝ (Fin m)),
        (∀ x, ι (M x) = L x) ∧ Jac L = |LinearMap.det M| ∧ LinearMap.det M ≠ 0 := by
    intro m Y _ _ _ L hL
    have hW : Module.finrank ℝ (LinearMap.range (L : EuclideanSpace ℝ (Fin m) →ₗ[ℝ] Y)) = m := by
      rw [LinearMap.finrank_range_of_inj hL, finrank_euclideanSpace_fin]
    obtain ⟨u⟩ : Nonempty (OrthonormalBasis (Fin m) ℝ
        (LinearMap.range (L : EuclideanSpace ℝ (Fin m) →ₗ[ℝ] Y))) :=
      ⟨(stdOrthonormalBasis ℝ _).reindex (finCongr hW)⟩
    obtain ⟨ι, M, hιM⟩ : ∃ (ι : EuclideanSpace ℝ (Fin m) →ₗᵢ[ℝ] Y)
        (M : EuclideanSpace ℝ (Fin m) →ₗ[ℝ] EuclideanSpace ℝ (Fin m)), ∀ x, ι (M x) = L x := by
      refine ⟨(LinearMap.range (L : EuclideanSpace ℝ (Fin m) →ₗ[ℝ] Y)).subtypeₗᵢ.comp
          u.repr.symm.toLinearIsometry,
        u.repr.toLinearEquiv.toLinearMap ∘ₗ (L : EuclideanSpace ℝ (Fin m) →ₗ[ℝ] Y).rangeRestrict,
        fun x => ?_⟩
      change ((u.repr.symm (u.repr ((L : EuclideanSpace ℝ (Fin m) →ₗ[ℝ] Y).rangeRestrict x)) :
        LinearMap.range (L : EuclideanSpace ℝ (Fin m) →ₗ[ℝ] Y)) : Y) = L x
      rw [LinearIsometryEquiv.symm_apply_apply]
      rfl
    have hdetM : LinearMap.det M ≠ 0 := by
      rw [Ne, LinearMap.det_eq_zero_iff_ker_ne_bot, not_not, LinearMap.ker_eq_bot]
      intro x y hxy
      apply hL
      rw [← hιM x, ← hιM y, hxy]
    refine ⟨ι, M, hιM, ?_, hdetM⟩
    have hgram : (Matrix.of fun i j : Fin m =>
        inner ℝ (L (EuclideanSpace.single i 1)) (L (EuclideanSpace.single j 1))) =
        Matrix.transpose (LinearMap.toMatrix (EuclideanSpace.basisFun (Fin m) ℝ).toBasis
          (EuclideanSpace.basisFun (Fin m) ℝ).toBasis M) *
          LinearMap.toMatrix (EuclideanSpace.basisFun (Fin m) ℝ).toBasis
            (EuclideanSpace.basisFun (Fin m) ℝ).toBasis M := by
      ext i j
      rw [Matrix.of_apply, ← hιM, ← hιM, LinearIsometry.inner_map_map, Matrix.mul_apply,
        PiLp.inner_apply]
      refine Finset.sum_congr rfl fun k _ => ?_
      simp only [Matrix.transpose_apply, LinearMap.toMatrix_apply, OrthonormalBasis.coe_toBasis,
        OrthonormalBasis.coe_toBasis_repr_apply, EuclideanSpace.basisFun_apply,
        EuclideanSpace.basisFun_repr, RCLike.inner_apply, conj_trivial]
      ring
    rw [hJac, hgram, Matrix.det_mul, Matrix.det_transpose, LinearMap.det_toMatrix, ← sq,
      Real.sqrt_sq_eq_abs]
  -- the linear area formula `Hᵈ(L(S)) = J L · Hᵈ(S)` for injective `L` (`d = m`)
  have linear_area : ∀ {m d : ℕ}, m = d → ∀ {Y : Type} [NormedAddCommGroup Y]
      [InnerProductSpace ℝ Y] [FiniteDimensional ℝ Y] [MeasurableSpace Y] [BorelSpace Y]
      (L : EuclideanSpace ℝ (Fin m) →L[ℝ] Y), Injective L →
      ∀ (s : Set (EuclideanSpace ℝ (Fin m))), μHE[d] (L '' s) = ENNReal.ofReal (Jac L) * μHE[d] s := by
    intro m d hd Y _ _ _ _ _ L hL s
    subst hd
    obtain ⟨ι, M, hιM, hJ, -⟩ := jac_factor L hL
    have himage : L '' s = ι '' (M '' s) := by
      rw [image_image]
      exact image_congr fun x _ => (hιM x).symm
    rw [himage, ι.isometry.euclideanHausdorffMeasure_image,
      EuclideanSpace.euclideanHausdorffMeasure_eq_volume, Measure.addHaar_image_linearMap, hJ]
  have jac_eq_zero : ∀ {m : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]
      (L : EuclideanSpace ℝ (Fin m) →L[ℝ] Y), ¬ Injective L → Jac L = 0 := by
    intro m Y _ _ L hL
    obtain ⟨w, hw0, hLw⟩ : ∃ w, w ≠ 0 ∧ L w = 0 := by
      have hker : LinearMap.ker (L : EuclideanSpace ℝ (Fin m) →ₗ[ℝ] Y) ≠ ⊥ := fun h =>
        hL (LinearMap.ker_eq_bot.mp h)
      obtain ⟨w, hw, hw0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hker
      exact ⟨w, hw0, hw⟩
    have hdet : Matrix.det (Matrix.of fun i j : Fin m =>
        inner ℝ (L (EuclideanSpace.single i 1)) (L (EuclideanSpace.single j 1))) = 0 := by
      rw [← Matrix.exists_mulVec_eq_zero_iff]
      refine ⟨fun j => w j, ?_, ?_⟩
      · intro h
        apply hw0
        ext j
        exact congrFun h j
      · ext i
        have hw : w = ∑ j, w j • EuclideanSpace.single j (1 : ℝ) := by
          ext k
          simp [Finset.sum_apply, Pi.single_apply]
        have : ∑ j, inner ℝ (L (EuclideanSpace.single i 1)) (L (EuclideanSpace.single j 1)) * w j
            = inner ℝ (L (EuclideanSpace.single i 1)) (L w) := by
          conv_rhs => rw [hw]
          simp [map_sum, map_smul, inner_sum, inner_smul_right, mul_comm]
        simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.zero_apply]
        rw [this, hLw, inner_zero_right]
    rw [hJac, hdet, Real.sqrt_zero]
  have jac_pos : ∀ {m : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]
      [FiniteDimensional ℝ Y] (L : EuclideanSpace ℝ (Fin m) →L[ℝ] Y), Injective L → 0 < Jac L := by
    intro m Y _ _ _ L hL
    obtain ⟨ι, M, -, hJ, hdet⟩ := jac_factor L hL
    rw [hJ]
    exact abs_pos.mpr hdet
  have continuous_jac : ∀ {m : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y],
      Continuous (fun L : EuclideanSpace ℝ (Fin m) →L[ℝ] Y => Jac L) := by
    intro m Y _ _
    simp only [hJac]
    apply Real.continuous_sqrt.comp
    apply Continuous.matrix_det
    refine continuous_pi fun i => continuous_pi fun j => ?_
    simp only [Matrix.of_apply]
    exact ((ContinuousLinearMap.apply ℝ Y _).continuous).inner
      ((ContinuousLinearMap.apply ℝ Y _).continuous)
  -- comparing pairwise distances compares Hausdorff measures of images
  have image_le_of_dist_le : ∀ {X Z : Type} [MetricSpace X] [MeasurableSpace X] [BorelSpace X]
      [MetricSpace Z] [MeasurableSpace Z] [BorelSpace Z] [Nonempty X]
      {f g : X → Z} {s : Set X} {K : NNReal}, InjOn g s →
      (∀ x ∈ s, ∀ y ∈ s, dist (f x) (f y) ≤ K * dist (g x) (g y)) →
      ∀ (d : ℕ), μHE[d] (f '' s) ≤ (K : ℝ≥0∞) ^ d * μHE[d] (g '' s) := by
    intro X Z _ _ _ _ _ _ _ f g s K hg hfg d
    have hh : LipschitzOnWith K (f ∘ invFunOn g s) (g '' s) := by
      rw [lipschitzOnWith_iff_dist_le_mul]
      rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
      simpa only [comp_apply, hg.leftInvOn_invFunOn hx,
        hg.leftInvOn_invFunOn hy] using hfg x hx y hy
    have himage : (f ∘ invFunOn g s) '' (g '' s) = f '' s := by
      rw [image_comp, hg.invFunOn_image Subset.rfl]
    simpa only [himage] using
      Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn d hh
  -- sharp comparisons for a map approximating an injective linear map
  have approx_upper : ∀ {n : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]
      [FiniteDimensional ℝ Y] [MeasurableSpace Y] [BorelSpace Y]
      {f : EuclideanSpace ℝ (Fin n) → Y} {L : EuclideanSpace ℝ (Fin n) →L[ℝ] Y}
      {s : Set (EuclideanSpace ℝ (Fin n))} {δ K : NNReal},
      ApproximatesLinearOn f L s δ → AntilipschitzWith K L →
      μHE[n] (f '' s) ≤ ((1 + δ * K : NNReal) : ℝ≥0∞) ^ n * (ENNReal.ofReal (Jac L) * μHE[n] s) := by
    intro n Y _ _ _ _ _ f L s δ K hf hL
    rw [← linear_area rfl L hL.injective s]
    apply image_le_of_dist_le hL.injective.injOn
    intro x hx y hy
    have hb : ‖x - y‖ ≤ K * ‖L x - L y‖ := by
      simpa only [dist_eq_norm] using hL.le_mul_dist x y
    have herror : ‖f x - f y - (L x - L y)‖ ≤ (δ : ℝ) * K * ‖L x - L y‖ := by
      calc
        _ ≤ δ * ‖x - y‖ := by simpa only [map_sub] using hf x hx y hy
        _ ≤ δ * (K * ‖L x - L y‖) := mul_le_mul_of_nonneg_left hb δ.2
        _ = _ := by ring
    simp only [dist_eq_norm, NNReal.coe_add, NNReal.coe_one, NNReal.coe_mul]
    calc
      ‖f x - f y‖ ≤ ‖f x - f y - (L x - L y)‖ + ‖L x - L y‖ := norm_le_norm_sub_add _ _
      _ ≤ (δ : ℝ) * K * ‖L x - L y‖ + ‖L x - L y‖ := add_le_add herror le_rfl
      _ = (1 + (δ : ℝ) * K) * ‖L x - L y‖ := by ring
  have approx_lower : ∀ {n : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]
      [FiniteDimensional ℝ Y] [MeasurableSpace Y] [BorelSpace Y]
      {f : EuclideanSpace ℝ (Fin n) → Y} {L : EuclideanSpace ℝ (Fin n) →L[ℝ] Y}
      {s : Set (EuclideanSpace ℝ (Fin n))} {δ K : NNReal},
      ApproximatesLinearOn f L s δ → AntilipschitzWith K L → δ * K < 1 →
      ENNReal.ofReal (Jac L) * μHE[n] s ≤
        (((1 - δ * K)⁻¹ : NNReal) : ℝ≥0∞) ^ n * μHE[n] (f '' s) := by
    intro n Y _ _ _ _ _ f L s δ K hf hL hδ
    have hδR : (δ : ℝ) * K < 1 := hδ
    have hdist : ∀ x ∈ s, ∀ y ∈ s, dist (L x) (L y) ≤
        ((1 - δ * K)⁻¹ : NNReal) * dist (f x) (f y) := by
      intro x hx y hy
      have hb : ‖x - y‖ ≤ K * ‖L x - L y‖ := by
        simpa only [dist_eq_norm] using hL.le_mul_dist x y
      have herror : ‖f x - f y - (L x - L y)‖ ≤ (δ : ℝ) * K * ‖L x - L y‖ := by
        calc
          _ ≤ δ * ‖x - y‖ := by simpa only [map_sub] using hf x hx y hy
          _ ≤ δ * (K * ‖L x - L y‖) := mul_le_mul_of_nonneg_left hb δ.2
          _ = _ := by ring
      have htriangle : ‖L x - L y‖ ≤ ‖f x - f y‖ + ‖f x - f y - (L x - L y)‖ := by
        simpa only [norm_sub_rev, add_comm] using
          (norm_le_norm_sub_add (L x - L y) (f x - f y))
      simp only [dist_eq_norm, NNReal.coe_inv, NNReal.coe_sub hδ.le,
        NNReal.coe_one, NNReal.coe_mul, inv_mul_eq_div]
      apply (le_div_iff₀ (sub_pos.mpr hδR)).mpr
      nlinarith
    have hfinj : InjOn f s := by
      intro x hx y hy hxy
      apply hL.injective
      apply dist_le_zero.mp
      simpa only [hxy, dist_self, mul_zero] using hdist x hx y hy
    rw [← linear_area rfl L hL.injective s]
    exact image_le_of_dist_le hfinj hdist _
  -- one radius controlling both the image measure and the Jacobians of nearby maps
  have radius_area : ∀ {n : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]
      [FiniteDimensional ℝ Y] [MeasurableSpace Y] [BorelSpace Y]
      (L : EuclideanSpace ℝ (Fin n) →L[ℝ] Y), Injective L → ∀ {q : NNReal}, 1 < q →
      ∃ δ : NNReal, 0 < δ ∧
        (∀ B : EuclideanSpace ℝ (Fin n) →L[ℝ] Y, ‖B - L‖ ≤ δ →
          ENNReal.ofReal (Jac B) ≤ q * ENNReal.ofReal (Jac L) ∧
          ENNReal.ofReal (Jac L) ≤ q * ENNReal.ofReal (Jac B)) ∧
        (∀ (s : Set (EuclideanSpace ℝ (Fin n))) (f : EuclideanSpace ℝ (Fin n) → Y),
          ApproximatesLinearOn f L s δ →
          μHE[n] (f '' s) ≤ q * (ENNReal.ofReal (Jac L) * μHE[n] s) ∧
            ENNReal.ofReal (Jac L) * μHE[n] s ≤ q * μHE[n] (f '' s)) := by
    intro n Y _ _ _ _ _ L hL q hq
    obtain ⟨K, _, hK⟩ := (L : EuclideanSpace ℝ (Fin n) →ₗ[ℝ] Y).exists_antilipschitzWith
      (LinearMap.ker_eq_bot.mpr hL)
    have hsmall : ∀ᶠ δ : NNReal in 𝓝 0, δ * K < 1 := by
      exact (continuousAt_id.mul continuousAt_const).eventually_lt
        continuousAt_const (by simp)
    have hupper : ∀ᶠ δ : NNReal in 𝓝 0, (1 + δ * K) ^ n < q := by
      exact ((continuousAt_const.add (continuousAt_id.mul continuousAt_const)).pow _).eventually_lt
        continuousAt_const (by simpa using hq)
    have hlower : ∀ᶠ δ : NNReal in 𝓝 0, ((1 - δ * K)⁻¹) ^ n < q := by
      apply ContinuousAt.eventually_lt _ continuousAt_const (by simpa using hq)
      apply ContinuousAt.pow
      apply ContinuousAt.inv₀
      · exact continuousAt_const.sub (continuousAt_id.mul continuousAt_const)
      · simp
    have hJ : 0 < Jac L := jac_pos L hL
    have hqR : (1 : ℝ) < q := hq
    have hmul : Jac L < (q : ℝ) * Jac L := by nlinarith
    have hnear : ∀ᶠ B : EuclideanSpace ℝ (Fin n) →L[ℝ] Y in 𝓝 L,
        Jac B < (q : ℝ) * Jac L ∧ Jac L < (q : ℝ) * Jac B :=
      (continuous_jac.continuousAt.eventually_lt continuousAt_const hmul).and
        (continuousAt_const.eventually_lt
          (continuousAt_const.mul continuous_jac.continuousAt) hmul)
    obtain ⟨ε, hε, hnear⟩ := Metric.eventually_nhds_iff.mp hnear
    have hevent : ∀ᶠ δ : NNReal in 𝓝[>] 0,
        0 < δ ∧ δ * K < 1 ∧ (1 + δ * K) ^ n < q ∧ ((1 - δ * K)⁻¹) ^ n < q ∧ (δ : ℝ) < ε := by
      have hεnhds : ∀ᶠ δ : NNReal in 𝓝 0, (δ : ℝ) < ε :=
        (NNReal.continuous_coe.continuousAt.eventually_lt continuousAt_const (by simpa using hε))
      filter_upwards [self_mem_nhdsWithin,
        hsmall.filter_mono nhdsWithin_le_nhds, hupper.filter_mono nhdsWithin_le_nhds,
        hlower.filter_mono nhdsWithin_le_nhds, hεnhds.filter_mono nhdsWithin_le_nhds]
        with δ hδ hsmall hupper hlower hδε
      exact ⟨hδ, hsmall, hupper, hlower, hδε⟩
    obtain ⟨δ, hδ, hδsmall, hδupper, hδlower, hδε⟩ := hevent.exists
    refine ⟨δ, hδ, ?_, fun s f hf => ⟨?_, ?_⟩⟩
    · intro B hB
      have hdist : dist B L < ε := by
        rw [dist_eq_norm]
        exact hB.trans_lt hδε
      obtain ⟨hupper, hlower⟩ := hnear hdist
      constructor
      · simpa only [ENNReal.ofReal_mul (NNReal.coe_nonneg q), ENNReal.ofReal_coe_nnreal] using
          ENNReal.ofReal_le_ofReal hupper.le
      · simpa only [ENNReal.ofReal_mul (NNReal.coe_nonneg q), ENNReal.ofReal_coe_nnreal] using
          ENNReal.ofReal_le_ofReal hlower.le
    · refine (approx_upper hf hK).trans ?_
      gcongr
      exact_mod_cast hδupper.le
    · refine (approx_lower hf hK hδsmall).trans ?_
      gcongr
      exact_mod_cast hδlower.le
  -- on a.e. point of an approximation piece the derivative is close to the linear map
  have approx_fderiv : ∀ {n : ℕ} {Y : Type} [NormedAddCommGroup Y] [NormedSpace ℝ Y]
      {f : EuclideanSpace ℝ (Fin n) → Y} {s : Set (EuclideanSpace ℝ (Fin n))}
      {A : EuclideanSpace ℝ (Fin n) →L[ℝ] Y} {δ : NNReal},
      ApproximatesLinearOn f A s δ → MeasurableSet s →
      ∀ (f' : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n) →L[ℝ] Y),
      (∀ x ∈ s, HasFDerivWithinAt f (f' x) s x) →
      ∀ᵐ x ∂(volume : Measure (EuclideanSpace ℝ (Fin n))).restrict s, ‖f' x - A‖₊ ≤ δ := by
    intro n Y _ _ f s A δ hf hs f' hf'
    open scoped Pointwise in
    filter_upwards [Besicovitch.ae_tendsto_measure_inter_div volume s, ae_restrict_mem hs]
    intro x hx xs
    apply ContinuousLinearMap.opNorm_le_bound _ δ.2 fun z => ?_
    suffices H : ∀ ε, 0 < ε → ‖(f' x - A) z‖ ≤ (δ + ε) * (‖z‖ + ε) + ‖f' x - A‖ * ε by
      have :
          Tendsto (fun ε : ℝ => ((δ : ℝ) + ε) * (‖z‖ + ε) + ‖f' x - A‖ * ε) (𝓝[>] 0)
            (𝓝 ((δ + 0) * (‖z‖ + 0) + ‖f' x - A‖ * 0)) :=
        Tendsto.mono_left (Continuous.tendsto
          (((continuous_const.add continuous_id).mul (continuous_const.add continuous_id)).add
            (continuous_const.mul continuous_id)) 0) nhdsWithin_le_nhds
      simp only [add_zero, mul_zero] at this
      apply le_of_tendsto_of_tendsto tendsto_const_nhds this
      filter_upwards [self_mem_nhdsWithin]
      exact H
    intro ε εpos
    have B₁ : ∀ᶠ r in 𝓝[>] (0 : ℝ), (s ∩ ({x} + r • closedBall z ε)).Nonempty :=
      Measure.eventually_nonempty_inter_smul_of_density_one volume s x hx _ measurableSet_closedBall
        (Metric.measure_closedBall_pos volume z εpos).ne'
    obtain ⟨ρ, ρpos, hρ⟩ :
        ∃ ρ > 0, ball x ρ ∩ s ⊆ {y | ‖f y - f x - (f' x) (y - x)‖ ≤ ε * ‖y - x‖} :=
      mem_nhdsWithin_iff.1 ((hf' x xs).isLittleO.bound εpos)
    have B₂ : ∀ᶠ r in 𝓝[>] (0 : ℝ), {x} + r • closedBall z ε ⊆ ball x ρ := by
      apply nhdsWithin_le_nhds
      exact eventually_singleton_add_smul_subset isBounded_closedBall (ball_mem_nhds x ρpos)
    obtain ⟨r, ⟨y, ⟨ys, hy⟩⟩, rρ, rpos⟩ :
        ∃ r : ℝ, (s ∩ ({x} + r • closedBall z ε)).Nonempty ∧
          {x} + r • closedBall z ε ⊆ ball x ρ ∧ 0 < r :=
      (B₁.and (B₂.and self_mem_nhdsWithin)).exists
    obtain ⟨a, az, ya⟩ : ∃ a, a ∈ closedBall z ε ∧ y = x + r • a := by
      simp only [mem_smul_set, image_add_left, mem_preimage, singleton_add] at hy
      rcases hy with ⟨a, az, ha⟩
      exact ⟨a, az, by simp only [ha, add_neg_cancel_left]⟩
    have norm_a : ‖a‖ ≤ ‖z‖ + ε :=
      calc
        ‖a‖ = ‖z + (a - z)‖ := by simp only [add_sub_cancel]
        _ ≤ ‖z‖ + ‖a - z‖ := norm_add_le _ _
        _ ≤ ‖z‖ + ε := by grw [mem_closedBall_iff_norm.1 az]
    have I : r * ‖(f' x - A) a‖ ≤ r * (δ + ε) * (‖z‖ + ε) :=
      calc
        r * ‖(f' x - A) a‖ = ‖(f' x - A) (r • a)‖ := by
          simp only [map_smul, norm_smul, Real.norm_eq_abs, abs_of_nonneg rpos.le]
        _ = ‖f y - f x - A (y - x) - (f y - f x - (f' x) (y - x))‖ := by
          simp only [ya, add_sub_cancel_left, sub_sub_sub_cancel_left, sub_apply, map_smul,
            smul_sub]
        _ ≤ ‖f y - f x - A (y - x)‖ + ‖f y - f x - (f' x) (y - x)‖ := norm_sub_le _ _
        _ ≤ δ * ‖y - x‖ + ε * ‖y - x‖ := (add_le_add (hf _ ys _ xs) (hρ ⟨rρ hy, ys⟩))
        _ = r * (δ + ε) * ‖a‖ := by
          simp only [ya, add_sub_cancel_left, norm_smul, Real.norm_eq_abs, abs_of_nonneg rpos.le]
          ring
        _ ≤ r * (δ + ε) * (‖z‖ + ε) := by gcongr
    calc
      ‖(f' x - A) z‖ = ‖(f' x - A) a + (f' x - A) (z - a)‖ := by
        congr 1
        simp only [sub_apply, map_sub]
        abel
      _ ≤ ‖(f' x - A) a‖ + ‖(f' x - A) (z - a)‖ := norm_add_le _ _
      _ ≤ (δ + ε) * (‖z‖ + ε) + ‖f' x - A‖ * ‖z - a‖ := by
        apply add_le_add
        · rw [mul_assoc] at I; exact (mul_le_mul_iff_right₀ rpos).1 I
        · apply ContinuousLinearMap.le_opNorm
      _ ≤ (δ + ε) * (‖z‖ + ε) + ‖f' x - A‖ * ε := by
        rw [mem_closedBall_iff_norm'] at az
        gcongr
  -- the area formula with injective derivative, up to a factor `q²`
  have regular_comparison : ∀ {n : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]
      [FiniteDimensional ℝ Y] [MeasurableSpace Y] [BorelSpace Y]
      {s : Set (EuclideanSpace ℝ (Fin n))} {f : EuclideanSpace ℝ (Fin n) → Y}
      {f' : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n) →L[ℝ] Y},
      MeasurableSet s → (∀ x ∈ s, HasFDerivWithinAt f (f' x) s x) →
      (∀ x ∈ s, Injective (f' x)) → InjOn f s → ∀ {q : NNReal}, 1 < q →
      μHE[n] (f '' s) ≤ (q : ℝ≥0∞) ^ 2 * ∫⁻ x in s, ENNReal.ofReal (Jac (f' x)) ∂volume ∧
        (∫⁻ x in s, ENNReal.ofReal (Jac (f' x)) ∂volume) ≤ (q : ℝ≥0∞) ^ 2 * μHE[n] (f '' s) := by
    intro n Y _ _ _ _ _ s f f' hs hf' hreg hinj q hq
    rcases eq_empty_or_nonempty s with rfl | hsne
    · simp
    have hchoice : ∀ L : EuclideanSpace ℝ (Fin n) →L[ℝ] Y, ∃ δ : NNReal, 0 < δ ∧ (Injective L →
        (∀ B : EuclideanSpace ℝ (Fin n) →L[ℝ] Y, ‖B - L‖ ≤ δ →
          ENNReal.ofReal (Jac B) ≤ q * ENNReal.ofReal (Jac L) ∧
          ENNReal.ofReal (Jac L) ≤ q * ENNReal.ofReal (Jac B)) ∧
        (∀ (t : Set (EuclideanSpace ℝ (Fin n))) (g : EuclideanSpace ℝ (Fin n) → Y),
          ApproximatesLinearOn g L t δ →
          μHE[n] (g '' t) ≤ q * (ENNReal.ofReal (Jac L) * μHE[n] t) ∧
            ENNReal.ofReal (Jac L) * μHE[n] t ≤ q * μHE[n] (g '' t))) := by
      intro L
      by_cases hL : Injective L
      · obtain ⟨δ, hδ, hJ, harea⟩ := radius_area L hL hq
        exact ⟨δ, hδ, fun _ => ⟨hJ, harea⟩⟩
      · exact ⟨1, zero_lt_one, fun h => (hL h).elim⟩
    choose δ hδpos hδ using hchoice
    obtain ⟨t, L, hdisj, ht, hcover, happrox, hactual⟩ :=
      exists_partition_approximatesLinearOn_of_hasFDerivWithinAt f s f' hf'
        δ (fun L => (hδpos L).ne')
    have hLreg (i : ℕ) : Injective (L i) := by
      obtain ⟨x, hx, hL⟩ := hactual hsne i
      rw [hL]
      exact hreg x hx
    have hseq : s = ⋃ i, s ∩ t i := by
      rw [← inter_iUnion]
      exact Subset.antisymm (subset_inter Subset.rfl hcover) inter_subset_left
    have hsumimage : μHE[n] (f '' s) = ∑' i, μHE[n] (f '' (s ∩ t i)) := by
      conv_lhs => rw [hseq, image_iUnion]
      apply measure_iUnion
      · intro i j hij
        exact Disjoint.image (Disjoint.mono inter_subset_right inter_subset_right (hdisj hij))
          hinj inter_subset_left inter_subset_left
      · intro i
        apply (hs.inter (ht i)).image_of_continuousOn_injOn
        · exact (fun x hx => (hf' x hx.1).continuousWithinAt.mono inter_subset_left)
        · exact hinj.mono inter_subset_left
    have hsumintegral :
        (∫⁻ x in s, ENNReal.ofReal (Jac (f' x)) ∂volume) =
          ∑' i, ∫⁻ x in s ∩ t i, ENNReal.ofReal (Jac (f' x)) ∂volume := by
      conv_lhs => rw [hseq]
      exact lintegral_iUnion (fun i => hs.inter (ht i))
        (pairwise_disjoint_mono hdisj (fun _ => inter_subset_right)) _
    have hvol : (μHE[n] : Measure (EuclideanSpace ℝ (Fin n))) = volume :=
      EuclideanSpace.euclideanHausdorffMeasure_eq_volume n
    have hpiece (i : ℕ) :
        μHE[n] (f '' (s ∩ t i)) ≤ (q : ℝ≥0∞) ^ 2 *
            ∫⁻ x in s ∩ t i, ENNReal.ofReal (Jac (f' x)) ∂volume ∧
          (∫⁻ x in s ∩ t i, ENNReal.ofReal (Jac (f' x)) ∂volume) ≤
            (q : ℝ≥0∞) ^ 2 * μHE[n] (f '' (s ∩ t i)) := by
      have hJ := (hδ (L i) (hLreg i)).1
      obtain ⟨harea_upper, harea_lower⟩ := (hδ (L i) (hLreg i)).2 (s ∩ t i) f (happrox i)
      rw [hvol] at harea_upper harea_lower
      have hderiv := approx_fderiv (happrox i) (hs.inter (ht i)) f'
        (fun x hx => (hf' x hx.1).mono inter_subset_left)
      have hJupper :
          (∫⁻ x in s ∩ t i, ENNReal.ofReal (Jac (f' x)) ∂volume) ≤
            q * (ENNReal.ofReal (Jac (L i)) * volume (s ∩ t i)) := by
        calc
          _ ≤ ∫⁻ _ in s ∩ t i, (q : ℝ≥0∞) * ENNReal.ofReal (Jac (L i)) ∂volume := by
            apply lintegral_mono_ae
            filter_upwards [hderiv] with x hx
            exact (hJ (f' x) hx).1
          _ = _ := by rw [setLIntegral_const, mul_assoc]
      have hJlower : ENNReal.ofReal (Jac (L i)) * volume (s ∩ t i) ≤
          q * ∫⁻ x in s ∩ t i, ENNReal.ofReal (Jac (f' x)) ∂volume := by
        calc
          _ = ∫⁻ _ in s ∩ t i, ENNReal.ofReal (Jac (L i)) ∂volume :=
            (setLIntegral_const _ _).symm
          _ ≤ ∫⁻ x in s ∩ t i, (q : ℝ≥0∞) * ENNReal.ofReal (Jac (f' x)) ∂volume := by
            apply lintegral_mono_ae
            filter_upwards [hderiv] with x hx
            exact (hJ (f' x) hx).2
          _ = _ := lintegral_const_mul' _ _ ENNReal.coe_ne_top
      constructor
      · calc
          _ ≤ q * (ENNReal.ofReal (Jac (L i)) * volume (s ∩ t i)) := harea_upper
          _ ≤ q * (q * ∫⁻ x in s ∩ t i, ENNReal.ofReal (Jac (f' x)) ∂volume) := by gcongr
          _ = _ := by rw [pow_two, mul_assoc]
      · calc
          _ ≤ q * (ENNReal.ofReal (Jac (L i)) * volume (s ∩ t i)) := hJupper
          _ ≤ q * (q * μHE[n] (f '' (s ∩ t i))) := by gcongr
          _ = _ := by rw [pow_two, mul_assoc]
    rw [hsumimage, hsumintegral]
    constructor
    · calc
        _ ≤ ∑' i, (q : ℝ≥0∞) ^ 2 * ∫⁻ x in s ∩ t i, ENNReal.ofReal (Jac (f' x)) ∂volume :=
          ENNReal.tsum_le_tsum (fun i => (hpiece i).1)
        _ = _ := ENNReal.tsum_mul_left
    · calc
        _ ≤ ∑' i, (q : ℝ≥0∞) ^ 2 * μHE[n] (f '' (s ∩ t i)) :=
          ENNReal.tsum_le_tsum (fun i => (hpiece i).2)
        _ = _ := ENNReal.tsum_mul_left
  -- the area formula with injective derivative
  have regular_area : ∀ {n : ℕ} {Y : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y]
      [FiniteDimensional ℝ Y] [MeasurableSpace Y] [BorelSpace Y]
      {s : Set (EuclideanSpace ℝ (Fin n))} {f : EuclideanSpace ℝ (Fin n) → Y}
      {f' : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n) →L[ℝ] Y},
      MeasurableSet s → (∀ x ∈ s, HasFDerivWithinAt f (f' x) s x) →
      (∀ x ∈ s, Injective (f' x)) → InjOn f s →
      μHE[n] (f '' s) = ∫⁻ x in s, ENNReal.ofReal (Jac (f' x)) ∂volume := by
    intro n Y _ _ _ _ _ s f f' hs hf' hreg hinj
    have hlimit (a : ℝ≥0∞) :
        Tendsto (fun q : NNReal => (q : ℝ≥0∞) ^ 2 * a) (𝓝[>] 1) (𝓝 a) := by
      have hcoe : Tendsto (fun q : NNReal => (q : ℝ≥0∞)) (𝓝[>] 1) (𝓝 1) :=
        (ENNReal.tendsto_coe.2 tendsto_id).mono_left nhdsWithin_le_nhds
      simpa only [one_pow, one_mul] using
        ENNReal.Tendsto.mul_const (ENNReal.Tendsto.pow (n := 2) hcoe) (Or.inl (by simp))
    apply le_antisymm
    · apply ge_of_tendsto (hlimit _)
      filter_upwards [self_mem_nhdsWithin] with q hq
      exact (regular_comparison hs hf' hreg hinj hq).1
    · apply ge_of_tendsto (hlimit _)
      filter_upwards [self_mem_nhdsWithin] with q hq
      exact (regular_comparison hs hf' hreg hinj hq).2
  -- critical points: the graphs `x ↦ (f x, εx)` have injective derivatives and shrinking area
  have critical_finite : ∀ {P n : ℕ} {s : Set (EuclideanSpace ℝ (Fin n))}
      {f : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin P)}, MeasurableSet s →
      (∀ x ∈ s, DifferentiableAt ℝ f x) → (∀ x ∈ s, ¬ Injective (fderiv ℝ f x)) →
      volume s ≠ ⊤ → ∀ {B : ℝ}, (∀ x ∈ s, ‖fderiv ℝ f x‖ ≤ B) → μHE[n] (f '' s) = 0 := by
    intro P n s f hs hf hcrit hfinite B hB
    obtain ⟨G, hGapply, hGcont, hGderiv⟩ : ∃ G : (EuclideanSpace ℝ (Fin n) →L[ℝ]
        EuclideanSpace ℝ (Fin P)) → ℝ → (EuclideanSpace ℝ (Fin n) →L[ℝ]
          WithLp 2 (EuclideanSpace ℝ (Fin P) × EuclideanSpace ℝ (Fin n))),
        (∀ L ε x, G L ε x = WithLp.toLp 2 (L x, ε • x)) ∧
        Continuous (fun p : (EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin P)) × ℝ =>
          G p.1 p.2) ∧
        ∀ (L : EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin P))
          (x : EuclideanSpace ℝ (Fin n)), HasFDerivAt f L x → ∀ ε : ℝ,
            HasFDerivAt (fun y => (WithLp.toLp 2 (f y, ε • y) :
              WithLp 2 (EuclideanSpace ℝ (Fin P) × EuclideanSpace ℝ (Fin n)))) (G L ε) x := by
      refine ⟨fun L ε => (WithLp.prodContinuousLinearEquiv 2 ℝ (EuclideanSpace ℝ (Fin P))
          (EuclideanSpace ℝ (Fin n))).symm.toContinuousLinearMap.comp
          (L.prod (ε • ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin n)))),
        fun _ _ _ => rfl, ?_, ?_⟩
      · apply Continuous.clm_comp continuous_const
        exact (ContinuousLinearMap.prodₗᵢ ℝ).continuous.comp
          (continuous_fst.prodMk (continuous_snd.smul continuous_const))
      · intro L x hL ε
        exact (WithLp.prodContinuousLinearEquiv 2 ℝ (EuclideanSpace ℝ (Fin P))
          (EuclideanSpace ℝ (Fin n))).symm.toContinuousLinearMap.hasFDerivAt.comp
          x (hL.prodMk ((hasFDerivAt_id x).const_smul ε))
    have hc : Continuous (fun p : (EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin P)) × ℝ =>
        Jac (G p.1 p.2)) := continuous_jac.comp hGcont
    have hzero : ∀ x ∈ s, Jac (G (fderiv ℝ f x) 0) = 0 := by
      intro x hx
      apply jac_eq_zero
      intro hg
      apply hcrit x hx
      intro y z hyz
      apply hg
      rw [hGapply, hGapply, zero_smul, zero_smul, hyz]
    have hgraph : ∀ ε : ℝ, ε ≠ 0 →
        μHE[n] (f '' s) ≤ ∫⁻ x in s, ENNReal.ofReal (Jac (G (fderiv ℝ f x) ε)) ∂volume := by
      intro ε hε
      have hinj : Injective (fun y : EuclideanSpace ℝ (Fin n) => (WithLp.toLp 2 (f y, ε • y) :
          WithLp 2 (EuclideanSpace ℝ (Fin P) × EuclideanSpace ℝ (Fin n)))) := by
        intro x y h
        have he : ε • x = ε • y := congrArg WithLp.snd h
        exact (smul_right_injective _ hε) he
      have hp : LipschitzWith 1 (WithLp.fst :
          WithLp 2 (EuclideanSpace ℝ (Fin P) × EuclideanSpace ℝ (Fin n)) →
            EuclideanSpace ℝ (Fin P)) :=
        LipschitzWith.of_dist_le_mul (fun x y => by
          rw [NNReal.coe_one, one_mul]; exact WithLp.dist_fst_le x y)
      have himg : f '' s = WithLp.fst '' ((fun y : EuclideanSpace ℝ (Fin n) =>
          (WithLp.toLp 2 (f y, ε • y) :
            WithLp 2 (EuclideanSpace ℝ (Fin P) × EuclideanSpace ℝ (Fin n)))) '' s) := by
        rw [image_image]
        rfl
      have hproj := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
        (hp.lipschitzOnWith (s := (fun y : EuclideanSpace ℝ (Fin n) =>
          (WithLp.toLp 2 (f y, ε • y) :
            WithLp 2 (EuclideanSpace ℝ (Fin P) × EuclideanSpace ℝ (Fin n)))) '' s))
      rw [ENNReal.coe_one, one_pow, one_mul, ← himg] at hproj
      refine hproj.trans_eq ?_
      refine regular_area hs (fun x hx => (hGderiv _ x (hf x hx).hasFDerivAt ε).hasFDerivWithinAt)
        (fun x _ y z h => ?_) hinj.injOn
      rw [hGapply, hGapply] at h
      have he : ε • y = ε • z := congrArg WithLp.snd h
      exact (smul_right_injective _ hε) he
    obtain ⟨C, hC⟩ := ((isCompact_closedBall
      (0 : EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin P)) B).prod
      (isCompact_Icc : IsCompact (Icc (-1 : ℝ) 1))).exists_bound_of_continuousOn hc.continuousOn
    have hlim : Tendsto (fun ε : ℝ => ∫⁻ x in s,
        ENNReal.ofReal (Jac (G (fderiv ℝ f x) ε)) ∂volume) (𝓝[>] 0) (𝓝 0) := by
      have hmeas (ε : ℝ) : Measurable (fun x : EuclideanSpace ℝ (Fin n) =>
          ENNReal.ofReal (Jac (G (fderiv ℝ f x) ε))) :=
        (hc.measurable.comp ((measurable_fderiv ℝ f).prodMk measurable_const)).ennreal_ofReal
      have hbound : ∀ᶠ ε : ℝ in 𝓝[>] 0, ∀ᵐ x ∂volume.restrict s,
          ENNReal.ofReal (Jac (G (fderiv ℝ f x) ε)) ≤ ENNReal.ofReal C := by
        have hnear : Icc (-1 : ℝ) 1 ∈ 𝓝[>] (0 : ℝ) := nhdsWithin_le_nhds
          (Icc_mem_nhds (by norm_num : (-1 : ℝ) < 0) (by norm_num : (0 : ℝ) < 1))
        filter_upwards [hnear] with ε hε
        filter_upwards [ae_restrict_mem hs] with x hx
        apply ENNReal.ofReal_le_ofReal
        exact (le_abs_self _).trans (hC ⟨fderiv ℝ f x, ε⟩
          ⟨by simpa only [mem_closedBall, dist_zero_right] using hB x hx, hε⟩)
      have hfin : (∫⁻ _ : EuclideanSpace ℝ (Fin n), ENNReal.ofReal C ∂volume.restrict s) ≠ ⊤ := by
        rw [lintegral_const, Measure.restrict_apply_univ]
        exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top hfinite
      have hpoint : ∀ᵐ x ∂volume.restrict s,
          Tendsto (fun ε : ℝ => ENNReal.ofReal (Jac (G (fderiv ℝ f x) ε))) (𝓝[>] 0) (𝓝 0) := by
        filter_upwards [ae_restrict_mem hs] with x hx
        have hc' : Continuous (fun ε : ℝ => ENNReal.ofReal (Jac (G (fderiv ℝ f x) ε))) :=
          ENNReal.continuous_ofReal.comp (hc.comp (continuous_const.prodMk continuous_id))
        have h0 := (hc'.continuousAt (x := (0 : ℝ))).tendsto.mono_left
          (nhdsWithin_le_nhds (s := Ioi (0 : ℝ)))
        rwa [hzero x hx, ENNReal.ofReal_zero] at h0
      have := tendsto_lintegral_filter_of_dominated_convergence
        (fun _ : EuclideanSpace ℝ (Fin n) => ENNReal.ofReal C)
        (Eventually.of_forall hmeas) hbound hfin hpoint
      rwa [lintegral_zero] at this
    apply le_antisymm _ bot_le
    apply ge_of_tendsto hlim
    filter_upwards [self_mem_nhdsWithin] with ε hε
    exact hgraph ε (ne_of_gt hε)
  have critical : ∀ {P n : ℕ} {s : Set (EuclideanSpace ℝ (Fin n))}
      {f : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin P)}, MeasurableSet s →
      (∀ x ∈ s, DifferentiableAt ℝ f x) → (∀ x ∈ s, ¬ Injective (fderiv ℝ f x)) →
      μHE[n] (f '' s) = 0 := by
    intro P n s f hs hf hcrit
    have hnull (k : ℕ) : μHE[n] (f '' (s ∩ closedBall 0 k ∩ {x | ‖fderiv ℝ f x‖ ≤ k})) = 0 := by
      apply critical_finite ((hs.inter measurableSet_closedBall).inter
          (measurableSet_le (measurable_fderiv ℝ f).norm measurable_const))
        (fun x hx => hf x hx.1.1) (fun x hx => hcrit x hx.1.1)
      · exact ne_top_of_le_ne_top measure_closedBall_lt_top.ne
          (measure_mono (fun _ hx => hx.1.2))
      · exact fun _ hx => hx.2
    have hcover : s ⊆ ⋃ k : ℕ, s ∩ closedBall 0 k ∩ {x | ‖fderiv ℝ f x‖ ≤ k} := by
      intro x hx
      obtain ⟨k, hk⟩ := exists_nat_gt (max ‖x‖ ‖fderiv ℝ f x‖)
      refine mem_iUnion.mpr ⟨k, ⟨hx, ?_⟩, (le_max_right _ _).trans hk.le⟩
      simpa only [mem_closedBall, dist_zero_right] using (le_max_left _ _).trans hk.le
    apply measure_mono_null (image_mono hcover)
    rw [image_iUnion]
    exact measure_iUnion_null hnull
  -- the area formula for sets `E ⊆ A`
  have area_set : ∀ {P n : ℕ} {g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin P)}
      {A : Set (EuclideanSpace ℝ (Fin n))}, InjOn g A → (∀ a ∈ A, DifferentiableAt ℝ g a) →
      ∀ {E : Set (EuclideanSpace ℝ (Fin n))}, MeasurableSet E → E ⊆ A →
      μHE[n] (g '' E) = ∫⁻ x in E, ENNReal.ofReal (Jac (fderiv ℝ g x)) ∂volume := by
    intro P n g A hgi hgd E hE hEA
    have hSm : MeasurableSet {x : EuclideanSpace ℝ (Fin n) | Jac (fderiv ℝ g x) ≠ 0} :=
      (measurableSet_eq_fun (continuous_jac.measurable.comp (measurable_fderiv ℝ g))
        measurable_const).compl
    have hreg : μHE[n] (g '' (E ∩ {x | Jac (fderiv ℝ g x) ≠ 0})) =
        ∫⁻ x in E ∩ {x | Jac (fderiv ℝ g x) ≠ 0}, ENNReal.ofReal (Jac (fderiv ℝ g x)) ∂volume :=
      regular_area (hE.inter hSm)
        (fun x hx => (hgd x (hEA hx.1)).hasFDerivAt.hasFDerivWithinAt)
        (fun x hx => by
          by_contra hni
          exact hx.2 (jac_eq_zero _ hni))
        (hgi.mono (inter_subset_left.trans hEA))
    have hcrit : μHE[n] (g '' (E \ {x | Jac (fderiv ℝ g x) ≠ 0})) = 0 :=
      critical (hE.diff hSm) (fun x hx => hgd x (hEA hx.1))
        (fun x hx hinj => hx.2 (jac_pos _ hinj).ne')
    have hzero : ∫⁻ x in E \ {x | Jac (fderiv ℝ g x) ≠ 0},
        ENNReal.ofReal (Jac (fderiv ℝ g x)) ∂volume = 0 := by
      have h0 : ∀ x ∈ E \ {x | Jac (fderiv ℝ g x) ≠ 0},
          ENNReal.ofReal (Jac (fderiv ℝ g x)) = 0 := fun x hx => by
        have hx0 : Jac (fderiv ℝ g x) = 0 := not_not.mp hx.2
        rw [hx0, ENNReal.ofReal_zero]
      rw [setLIntegral_congr_fun (hE.diff hSm) h0, lintegral_zero]
    rw [← lintegral_inter_add_sdiff _ E hSm, hzero, add_zero, ← hreg]
    apply le_antisymm
    · calc μHE[n] (g '' E)
          = μHE[n] (g '' (E ∩ {x | Jac (fderiv ℝ g x) ≠ 0}) ∪
              g '' (E \ {x | Jac (fderiv ℝ g x) ≠ 0})) := by
            rw [← image_union, inter_union_sdiff]
        _ ≤ μHE[n] (g '' (E ∩ {x | Jac (fderiv ℝ g x) ≠ 0})) +
              μHE[n] (g '' (E \ {x | Jac (fderiv ℝ g x) ≠ 0})) := measure_union_le _ _
        _ = _ := by rw [hcrit, add_zero]
    · exact measure_mono (image_mono inter_subset_left)
  -- the weighted area formula (no measurability of the weight)
  have area_weighted : ∀ {P n : ℕ} {g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin P)}
      {A : Set (EuclideanSpace ℝ (Fin n))}, MeasurableSet A → InjOn g A →
      (∀ a ∈ A, DifferentiableAt ℝ g a) → ∀ (w : EuclideanSpace ℝ (Fin P) → ℝ≥0∞),
      ∫⁻ y in g '' A, w y ∂μHE[n] =
        ∫⁻ x in A, ENNReal.ofReal (Jac (fderiv ℝ g x)) * w (g x) ∂volume := by
    intro P n g A hA hgi hgd w
    have hcont : ContinuousOn g A := fun x hx => (hgd x hx).continuousAt.continuousWithinAt
    have hemb := hcont.measurableEmbedding hA hgi
    have hsub := MeasurableEmbedding.subtype_coe hA
    have hJm : Measurable (fun x : EuclideanSpace ℝ (Fin n) =>
        ENNReal.ofReal (Jac (fderiv ℝ g x))) :=
      (continuous_jac.measurable.comp (measurable_fderiv ℝ g)).ennreal_ofReal
    have hmap : Measure.map (A.domRestrict g)
        (((volume : Measure (EuclideanSpace ℝ (Fin n))).withDensity
          (fun x => ENNReal.ofReal (Jac (fderiv ℝ g x)))).comap (Subtype.val : A → _)) =
        (μHE[n] : Measure (EuclideanSpace ℝ (Fin P))).restrict (g '' A) := by
      ext t ht
      rw [Measure.map_apply hemb.measurable ht, hsub.comap_apply]
      have hB : MeasurableSet (Subtype.val '' ((A.domRestrict g) ⁻¹' t)) :=
        hsub.measurableSet_image' (hemb.measurable ht)
      have hBs : Subtype.val '' ((A.domRestrict g) ⁻¹' t) ⊆ A := by
        rintro x ⟨u, _, rfl⟩
        exact u.property
      rw [withDensity_apply _ hB, ← area_set hgi hgd hB hBs, Measure.restrict_apply ht]
      congr 1
      ext y
      constructor
      · rintro ⟨x, ⟨u, hu, rfl⟩, rfl⟩
        exact ⟨hu, ⟨u, u.property, rfl⟩⟩
      · rintro ⟨hy, x, hx, rfl⟩
        exact ⟨x, ⟨⟨x, hx⟩, hy, rfl⟩, rfl⟩
    rw [← hmap, hemb.lintegral_map]
    change (∫⁻ x : A, (fun x : EuclideanSpace ℝ (Fin n) => w (g x)) x ∂
      (((volume : Measure (EuclideanSpace ℝ (Fin n))).withDensity
        (fun x => ENNReal.ofReal (Jac (fderiv ℝ g x)))).comap (Subtype.val : A → _))) = _
    rw [lintegral_subtype_comap hA (fun x : EuclideanSpace ℝ (Fin n) => w (g x)),
      setLIntegral_withDensity_eq_setLIntegral_mul_non_measurable₀ _ _ _ hA]
    · rfl
    · exact Eventually.of_forall fun _ => ENNReal.ofReal_lt_top
    · exact hJm.aemeasurable
  -- `|det (B ∘ L)| = √det(B uᵢ · B uⱼ) · J L` for `u` the standard basis of `range L`
  have stepA : ∀ {P n : ℕ} (B : EuclideanSpace ℝ (Fin P) →L[ℝ] EuclideanSpace ℝ (Fin n))
      (L : EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin P))
      (T : Submodule ℝ (EuclideanSpace ℝ (Fin P))),
      T = LinearMap.range (L : EuclideanSpace ℝ (Fin n) →ₗ[ℝ] EuclideanSpace ℝ (Fin P)) →
      |LinearMap.det ((B.comp L : EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin n)) :
          EuclideanSpace ℝ (Fin n) →ₗ[ℝ] EuclideanSpace ℝ (Fin n))| =
        Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ T) =>
          inner ℝ (B (stdOrthonormalBasis ℝ T i)) (B (stdOrthonormalBasis ℝ T j)))) * Jac L := by
    intro P n B L T hT
    obtain ⟨ιu, hιiso, hιsingle, hιmem, hιsurj⟩ : ∃ ιu : EuclideanSpace ℝ (Fin (Module.finrank ℝ T))
        →L[ℝ] EuclideanSpace ℝ (Fin P), Isometry ιu ∧
        (∀ i, ιu (EuclideanSpace.single i 1) = stdOrthonormalBasis ℝ T i) ∧
        (∀ v, ιu v ∈ T) ∧ (∀ y ∈ T, ∃ v, ιu v = y) := by
      refine ⟨(T.subtypeₗᵢ.comp
          (stdOrthonormalBasis ℝ T).repr.symm.toLinearIsometry).toContinuousLinearMap,
        (T.subtypeₗᵢ.comp (stdOrthonormalBasis ℝ T).repr.symm.toLinearIsometry).isometry,
        fun i => ?_, fun v => ?_, fun y hy => ?_⟩
      · change ((((stdOrthonormalBasis ℝ T).repr.symm (EuclideanSpace.single i 1)) : T) :
          EuclideanSpace ℝ (Fin P)) = _
        rw [OrthonormalBasis.repr_symm_single]
      · exact ((stdOrthonormalBasis ℝ T).repr.symm v).2
      · refine ⟨(stdOrthonormalBasis ℝ T).repr ⟨y, hy⟩, ?_⟩
        change ((((stdOrthonormalBasis ℝ T).repr.symm
          ((stdOrthonormalBasis ℝ T).repr ⟨y, hy⟩)) : T) : EuclideanSpace ℝ (Fin P)) = y
        rw [LinearIsometryEquiv.symm_apply_apply]
    have hJT : Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ T) =>
          inner ℝ (B (stdOrthonormalBasis ℝ T i)) (B (stdOrthonormalBasis ℝ T j)))) =
        Jac (B.comp ιu) := by
      rw [hJac]
      simp only [ContinuousLinearMap.comp_apply, hιsingle]
    rw [hJT]
    by_cases hL : Injective L
    · have hdim : Module.finrank ℝ T = n := by
        rw [hT, LinearMap.finrank_range_of_inj hL, finrank_euclideanSpace_fin]
      by_cases hBι : Injective (B.comp ιu)
      · -- compare the volumes of the image of the unit ball
        have hball0 : volume (ball (0 : EuclideanSpace ℝ (Fin n)) 1) ≠ 0 :=
          (measure_ball_pos volume _ one_pos).ne'
        have hballtop : volume (ball (0 : EuclideanSpace ℝ (Fin n)) 1) ≠ ⊤ :=
          measure_ball_lt_top.ne
        have hvol : (μHE[n] : Measure (EuclideanSpace ℝ (Fin n))) = volume :=
          EuclideanSpace.euclideanHausdorffMeasure_eq_volume n
        have hS : ιu '' (ιu ⁻¹' (L '' ball 0 1)) = L '' ball 0 1 := by
          apply image_preimage_eq_of_subset
          rintro _ ⟨x, -, rfl⟩
          obtain ⟨v, hv⟩ := hιsurj (L x) (hT ▸ LinearMap.mem_range_self _ x)
          exact ⟨v, hv⟩
        have h1 := Measure.addHaar_image_linearMap volume
          ((B.comp L : EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin n)) :
            EuclideanSpace ℝ (Fin n) →ₗ[ℝ] EuclideanSpace ℝ (Fin n)) (ball 0 1)
        have h2 : (B.comp L) '' ball 0 1 = (B.comp ιu) '' (ιu ⁻¹' (L '' ball 0 1)) := by
          rw [ContinuousLinearMap.coe_comp, ContinuousLinearMap.coe_comp, image_comp,
            image_comp, hS]
        have h3 := linear_area hdim (B.comp ιu) hBι (ιu ⁻¹' (L '' ball 0 1))
        have h4 := linear_area rfl L hL (ball 0 1)
        have h5 : μHE[n] (ιu ⁻¹' (L '' ball 0 1)) = μHE[n] (L '' ball 0 1) := by
          rw [← hιiso.euclideanHausdorffMeasure_image, hS]
        change volume ((B.comp L) '' ball 0 1) = _ at h1
        rw [h2, ← hvol, h3, h5, h4, hvol] at h1
        rw [← mul_assoc, ← ENNReal.ofReal_mul (jac_nonneg _)] at h1
        have h6 := (ENNReal.mul_left_inj hball0 hballtop).mp h1
        rw [ENNReal.ofReal_eq_ofReal_iff (mul_nonneg (jac_nonneg _) (jac_nonneg _))
          (abs_nonneg _)] at h6
        exact h6.symm
      · rw [jac_eq_zero _ hBι, zero_mul, abs_eq_zero, LinearMap.det_eq_zero_iff_ker_ne_bot]
        intro hker
        apply hBι
        intro v w hvw
        obtain ⟨x, hx⟩ : ιu v ∈ LinearMap.range
            (L : EuclideanSpace ℝ (Fin n) →ₗ[ℝ] EuclideanSpace ℝ (Fin P)) := hT ▸ hιmem v
        obtain ⟨y, hy⟩ : ιu w ∈ LinearMap.range
            (L : EuclideanSpace ℝ (Fin n) →ₗ[ℝ] EuclideanSpace ℝ (Fin P)) := hT ▸ hιmem w
        have hxy : x = y := by
          have hinj := LinearMap.ker_eq_bot.mp hker
          apply hinj
          change B (L x) = B (L y)
          rw [show L x = ιu v from hx, show L y = ιu w from hy]
          exact hvw
        apply hιiso.injective
        rw [← hx, ← hy, hxy]
    · rw [jac_eq_zero _ hL, mul_zero, abs_eq_zero, LinearMap.det_eq_zero_iff_ker_ne_bot]
      intro hker
      apply hL
      intro x y hxy
      have hinj := LinearMap.ker_eq_bot.mp hker
      apply hinj
      change B (L x) = B (L y)
      rw [hxy]
  -- the statement: apply the weighted area formula to `g`, then compare integrands a.e.
  intro P n g A Lg V F G T h hg hA hgi hgd hV hgV hFG hFd hT
  rw [area_weighted hA hgi hgd]
  refine lintegral_congr_ae ?_
  filter_upwards [hT, ae_restrict_mem hA] with a hTa ha
  have hFG' : F =ᶠ[𝓝 (g a)] G :=
    Filter.eventuallyEq_of_mem (hV.mem_nhds (hgV (mem_image_of_mem g ha))) hFG
  rw [fderiv_comp a ((hFd (g a) (mem_image_of_mem g ha)).congr_of_eventuallyEq hFG'.symm)
      (hgd a ha), ← hFG'.fderiv_eq, stepA _ _ _ hTa, ENNReal.ofReal_mul (Real.sqrt_nonneg _)]
  ring

/-- **Area formula on one parametrized piece** (Simon Ch. 3, (2.4)–(2.5), from the Euclidean area
formula of Ch. 2, 3.4–3.5).  Let `g : ℝⁿ → ℝᴾ` be Lipschitz, injective and differentiable on the
Borel set `A`, let `F = G` on an open `V ⊇ g(A)` with `G` Lipschitz and `F` differentiable on
`g(A)`, and let `T(g(a)) = range Dg(a)` for a.e. `a ∈ A`.  With `u` the standard orthonormal basis
of `T(x)` and `J_T(x) = √det(DF(x)uᵢ · DF(x)uⱼ)`, every `Hⁿ⌞g(A)`-measurable `h ≥ 0` has an
a.e. measurable fibre sum `Σ_h(y) = ∑_{x ∈ g(A), F(x) = y} h(x)` and
`∫ Σ_h dLⁿ = ∫_{g(A)} J_T h dHⁿ`.  Replace `h` by a Borel `h̃ = h` `Hⁿ⌞g(A)`-a.e. (`Σ_h = Σ_h̃`
`Lⁿ`-a.e., `G` being Lipschitz); the area formula for `Φ = G ∘ g` gives
`∫ Σ_h̃ dLⁿ = ∫_A |det DΦ| h̃ ∘ g dLⁿ`, which the Jacobian chain rule and the area formula for `g`
identify with `∫_{g(A)} J_T h̃ dHⁿ`. -/
theorem Submission.idtp_caf_piece_area_formula : ∀ (P n : ℕ) (g : Euclid n → Euclid P) (A : Set (Euclid n)) (Lg : NNReal) (V : Set (Euclid P)) (F G : Euclid P → Euclid n) (LG : NNReal) (T : Euclid P → Submodule ℝ (Euclid P)) (h : Euclid P → ℝ≥0∞), LipschitzWith Lg g → MeasurableSet A → InjOn g A → (∀ a ∈ A, DifferentiableAt ℝ g a) → IsOpen V → g '' A ⊆ V → LipschitzWith LG G → EqOn F G V → (∀ x ∈ g '' A, DifferentiableAt ℝ F x) → (∀ᵐ a ∂(volume.restrict A), T (g a) = LinearMap.range (fderiv ℝ g a : Euclid n →ₗ[ℝ] Euclid P)) → AEMeasurable h (μHE[n].restrict (g '' A)) → AEMeasurable (fun y : Euclid n => ∑' x : ↥(g '' A ∩ F ⁻¹' {y}), h x) volume ∧ ∫⁻ y, (∑' x : ↥(g '' A ∩ F ⁻¹' {y}), h x) ∂volume = ∫⁻ x in g '' A, ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ (T x)) => inner ℝ (fderiv ℝ F x (stdOrthonormalBasis ℝ (T x) i)) (fderiv ℝ F x (stdOrthonormalBasis ℝ (T x) j))))) * h x ∂μHE[n] := by
  intro P n g A Lg V F G LG T h hg hA hgi hgd hV hgV hG hFG hFd hT hh
  -- Borel representative `h̃ = hh.mk h` of `h`; the fibre sums of `h` and `h̃` agree `Lⁿ`-a.e.
  have hfib := Submission.idtp_caf_paf_fiberSum_ae_congr P n (g '' A) V F G LG h (hh.mk h) hgV hG
    hFG hh.ae_eq_mk
  -- fibre side for the Lipschitz `Φ = G ∘ g` (`F = G` at `g(a) ∈ V`), carrier side for `h̃`
  obtain ⟨hmeas, hint⟩ := Submission.idtp_caf_paf_fiber_side P n g A F (G ∘ g) (LG * Lg)
    (hh.mk h) hg.continuous hA hgi (hG.comp hg) (fun a ha => hFG (hgV (mem_image_of_mem g ha)))
    hh.measurable_mk
  have hcar := Submission.idtp_caf_paf_carrier_side P n g A Lg V F G T (hh.mk h) hg hA hgi hgd hV
    hgV hFG hFd hT
  refine ⟨hmeas.congr hfib.symm, ?_⟩
  rw [lintegral_congr_ae hfib, hint, ← hcar]
  -- back from `h̃` to `h`, `Hⁿ⌞g(A)`-a.e.
  refine lintegral_congr_ae ?_
  filter_upwards [hh.ae_eq_mk] with x hx
  rw [hx]
/-- Gluing step of the weighted area formula on a rectifiable carrier (Simon Ch. 3, 2.4–2.5).
Let `S ⊆ ℝᴾ` contain the pairwise disjoint Borel pieces `Sₖ` (`k` in a countable type), with
`Hⁿ(S ∖ ⋃ₖ Sₖ) = 0` and `Lⁿ(F(S ∖ ⋃ₖ Sₖ)) = 0`.  If on every piece the fibre sum
`y ↦ ∑_{x ∈ Sₖ, F(x) = y} h(x)` is `Lⁿ`-a.e. measurable with integral `∫_{Sₖ} φ h dHⁿ`, then the
same holds on `S`.  Off the null set `F(S ∖ ⋃ₖ Sₖ)` the fibre of `S` is the disjoint union of the
fibres of the `Sₖ`, so the fibre sum over `S` is a.e. the sum over `k` of the fibre sums over the
`Sₖ`; integrate term by term and use `Hⁿ⌞S = ∑ₖ Hⁿ⌞Sₖ`. -/
theorem Submission.idtp_caf_glue_pieces : ∀ (P n : ℕ) (ι : Type) [Countable ι] (S : Set (Euclid P)) (pieces : ι → Set (Euclid P)) (F : Euclid P → Euclid n) (φ h : Euclid P → ℝ≥0∞), (∀ k, MeasurableSet (pieces k)) → (∀ k, pieces k ⊆ S) → Pairwise (fun k k' => Disjoint (pieces k) (pieces k')) → μHE[n] (S \ ⋃ k, pieces k) = 0 → volume (F '' (S \ ⋃ k, pieces k)) = 0 → (∀ k, AEMeasurable (fun y : Euclid n => ∑' x : ↥(pieces k ∩ F ⁻¹' {y}), h x) volume ∧ ∫⁻ y, (∑' x : ↥(pieces k ∩ F ⁻¹' {y}), h x) ∂volume = ∫⁻ x in pieces k, φ x * h x ∂μHE[n]) → AEMeasurable (fun y : Euclid n => ∑' x : ↥(S ∩ F ⁻¹' {y}), h x) volume ∧ ∫⁻ y, (∑' x : ↥(S ∩ F ⁻¹' {y}), h x) ∂volume = ∫⁻ x in S, φ x * h x ∂μHE[n] := by
  intro P n ι _ S pieces F φ h hmeas hsub hdisj hnull himg hpiece
  -- Off the null set `F(S \ ⋃ₖ Sₖ)` the fibre of `S` is the disjoint union of the fibres of the
  -- pieces, so the fibre sum over `S` splits as the sum over `k` of the fibre sums over `Sₖ`
  have hfib : ∀ᵐ y ∂(volume : Measure (Euclid n)),
      ∑' x : ↥(S ∩ F ⁻¹' {y}), h x = ∑' k, ∑' x : ↥(pieces k ∩ F ⁻¹' {y}), h x := by
    filter_upwards [measure_eq_zero_iff_ae_notMem.mp himg] with y hy
    have hset : S ∩ F ⁻¹' {y} = ⋃ k, (pieces k ∩ F ⁻¹' {y}) := by
      ext x
      simp only [mem_inter_iff, mem_preimage, mem_singleton_iff, mem_iUnion]
      constructor
      · rintro ⟨hxS, hxy⟩
        by_contra hx
        refine hy ⟨x, ⟨hxS, ?_⟩, hxy⟩
        simp only [mem_iUnion, not_exists]
        exact fun k hk => hx ⟨k, hk, hxy⟩
      · rintro ⟨k, hxk, hxy⟩
        exact ⟨hsub k hxk, hxy⟩
    rw [hset]
    exact ENNReal.tsum_biUnion fun i _ j _ hij =>
      (hdisj hij).mono inter_subset_left inter_subset_left
  -- A countable sum of a.e. measurable fibre sums is a.e. measurable
  have hsum : AEMeasurable
      (fun y : Euclid n => ∑' k, ∑' x : ↥(pieces k ∩ F ⁻¹' {y}), h x) volume :=
    AEMeasurable.tsum fun k => (hpiece k).1
  refine ⟨hsum.congr (hfib.mono fun y hy => hy.symm), ?_⟩
  -- `S` and `⋃ₖ Sₖ` agree up to an `Hⁿ`-null set
  have hae : (⋃ k, pieces k) =ᵐ[μHE[n]] S :=
    ae_eq_set.mpr ⟨by rw [Set.sdiff_eq_empty.mpr (iUnion_subset hsub), measure_empty], hnull⟩
  calc ∫⁻ y, (∑' x : ↥(S ∩ F ⁻¹' {y}), h x) ∂volume
      = ∫⁻ y, ∑' k, ∑' x : ↥(pieces k ∩ F ⁻¹' {y}), h x ∂volume := lintegral_congr_ae hfib
    _ = ∑' k, ∫⁻ y, ∑' x : ↥(pieces k ∩ F ⁻¹' {y}), h x ∂volume :=
      lintegral_tsum fun k => (hpiece k).1
    _ = ∑' k, ∫⁻ x in pieces k, φ x * h x ∂μHE[n] := tsum_congr fun k => (hpiece k).2
    _ = ∫⁻ x in ⋃ k, pieces k, φ x * h x ∂μHE[n] := (lintegral_iUnion hmeas hdisj _).symm
    _ = ∫⁻ x in S, φ x * h x ∂μHE[n] := setLIntegral_congr hae

/-- **Simon Ch. 3, 2.4–2.5** (weighted area formula on a countably `n`-rectifiable carrier) for a
map `F : ℝᴾ → ℝⁿ` that is `C¹` on an open set `Z`: the fibre sums
`y ↦ Σ_{x ∈ M ∩ Z, F(x) = y} h(x)` are `Lⁿ`-a.e. measurable and
`∫ Σ_{x ∈ M ∩ Z, F(x) = y} h(x) dLⁿ(y) = ∫_{M ∩ Z} J*(x) h(x) dHⁿ(x)`, where `J*(x)` is the
square root of the Gram determinant of `DF(x)` on the standard orthonormal basis of the
approximate tangent plane `TₓM`.  As in Simon's proof, `M ∩ Z` is cut, up to an `Hⁿ`-null set
with `Lⁿ`-null `F`-image, into countably many disjoint Borel pieces
`gᵢ(Bᵢ ∩ gᵢ⁻¹(Zₗ)) = gᵢ(Bᵢ) ∩ Zₗ`: the `gᵢ(Bᵢ)` are bi-Lipschitz images covering `M` up to a
null set (Lemma 1.2 and Remark 1.3, with bi-Lipschitz pieces in place of `C¹` submanifolds), and
`F` agrees with a Lipschitz map `Gₗ` on an open `Vₗ ⊇ Zₗ`.  On each piece `TₓM = range Dgᵢ`
a.e., so the single-piece area formula applies, and the pieces are glued by countable
additivity. -/
theorem Submission.idtp_carrier_area_formula : ∀ (P n : ℕ) (M Z : Set (Euclid P)) (F : Euclid P → Euclid n) (h : Euclid P → ℝ≥0∞), 1 ≤ n → MeasurableSet M → CountablyRectifiable n M → (∀ K : Set (Euclid P), IsCompact K → μHE[n] (M ∩ K) ≠ ∞) → IsOpen Z → ContDiffOn ℝ 1 F Z → AEMeasurable h (μHE[n].restrict M) → AEMeasurable (fun y : Euclid n => ∑' x : ↥(M ∩ Z ∩ F ⁻¹' {y}), h x) volume ∧ ∫⁻ y, (∑' x : ↥(M ∩ Z ∩ F ⁻¹' {y}), h x) ∂volume = ∫⁻ x in M ∩ Z, ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ (approxTangentPlane n M x)) => inner ℝ (fderiv ℝ F x (stdOrthonormalBasis ℝ (approxTangentPlane n M x) i)) (fderiv ℝ F x (stdOrthonormalBasis ℝ (approxTangentPlane n M x) j))))) * h x ∂μHE[n] := by
  intro P n M Z F h hn hM hrect hfin hZ hF hh
  -- Step 1: `Z = ⋃ₗ Zₗ` (disjoint Borel), `Zₗ ⊆ Vₗ ⊆ Z`, `Vₗ` open, `F = Gₗ` on `Vₗ` with `Gₗ`
  -- Lipschitz
  obtain ⟨V, Zs, G, hVo, -, hZsm, hZsV, hZsd, hZsU, hGL, hFG⟩ :=
    Submission.idtp_caf_lipschitz_localization P n Z F hZ hF
  choose LG hLG using hGL
  have hZsZ : ∀ l, Zs l ⊆ Z := fun l => by rw [← hZsU]; exact subset_iUnion Zs l
  -- Step 2: up to an `Hⁿ`-null set, `M` is the disjoint union of the Borel bi-Lipschitz images
  -- `gᵢ(Bᵢ) ⊆ M`, `Dgᵢ` existing and injective on `Bᵢ`
  obtain ⟨g, B, m, hgL, hBm, hm, hlow, hdiff, hgBm, hgBM, hgBd, hnull⟩ :=
    Submission.dpf_rectifiable_bilipschitz_pieces P n M hM hrect
  choose Lg hLg using hgL
  -- Step 3: the parameter sets `Aᵢₗ = Bᵢ ∩ gᵢ⁻¹(Zₗ)` and the pieces `gᵢ(Aᵢₗ) = gᵢ(Bᵢ) ∩ Zₗ`,
  -- indexed by `k = (i, l)`
  obtain ⟨A, hA⟩ : ∃ A : ℕ × ℕ → Set (Euclid n), ∀ k, A k = B k.1 ∩ g k.1 ⁻¹' Zs k.2 :=
    ⟨fun k => B k.1 ∩ g k.1 ⁻¹' Zs k.2, fun _ => rfl⟩
  have hAm : ∀ k, MeasurableSet (A k) := fun k => by
    rw [hA]
    exact (hBm k.1).inter ((hLg k.1).continuous.measurable (hZsm k.2))
  have hAB : ∀ k, A k ⊆ B k.1 := fun k => by
    rw [hA]
    exact inter_subset_left
  have hAimg : ∀ k, g k.1 '' A k = g k.1 '' B k.1 ∩ Zs k.2 := fun k => by
    rw [hA]
    exact image_inter_preimage _ _ _
  have hAm' : ∀ k, MeasurableSet (g k.1 '' A k) := fun k => by
    rw [hAimg]
    exact (hgBm k.1).inter (hZsm k.2)
  have hAM : ∀ k, g k.1 '' A k ⊆ M := fun k => (image_mono (hAB k)).trans (hgBM k.1)
  have hAZ : ∀ k, g k.1 '' A k ⊆ Zs k.2 := fun k => by
    rw [hAimg]
    exact inter_subset_right
  -- Step 4: the remainder `(M ∩ Z) ∖ ⋃ₖ gᵢ(Aᵢₗ) ⊆ M ∖ ⋃ᵢ gᵢ(Bᵢ)` is `Hⁿ`-null
  have hrem : μHE[n] ((M ∩ Z) \ ⋃ k : ℕ × ℕ, g k.1 '' A k) = 0 := by
    refine measure_mono_null ?_ hnull
    rintro x ⟨⟨hxM, hxZ⟩, hxA⟩
    refine ⟨hxM, fun hxB => hxA ?_⟩
    obtain ⟨i, hi⟩ := mem_iUnion.1 hxB
    obtain ⟨l, hl⟩ := mem_iUnion.1 (show x ∈ ⋃ l, Zs l by rwa [hZsU])
    refine mem_iUnion.2 ⟨(i, l), ?_⟩
    rw [hAimg]
    exact ⟨hi, hl⟩
  -- Step 5: glue the pieces; the `F`-image of the remainder is `Lⁿ`-null (`F` is `C¹` on `Z`)
  refine Submission.idtp_caf_glue_pieces P n (ℕ × ℕ) (M ∩ Z) (fun k => g k.1 '' A k) F _ h hAm'
    (fun k => subset_inter (hAM k) ((hAZ k).trans (hZsZ k.2))) ?_ hrem
    (Submission.idtp_caf_null_image P n Z ((M ∩ Z) \ ⋃ k : ℕ × ℕ, g k.1 '' A k) F hZ hF
      (fun x hx => hx.1.2) hrem) fun k => ?_
  · -- the pieces are pairwise disjoint: distinct `i` by Step 2, distinct `l` by Step 1
    intro k k' hkk'
    show Disjoint (g k.1 '' A k) (g k'.1 '' A k')
    rw [hAimg k, hAimg k']
    by_cases h1 : k.1 = k'.1
    · have h2 : k.2 ≠ k'.2 := fun h2 => hkk' (Prod.ext h1 h2)
      exact (hZsd h2).mono inter_subset_right inter_subset_right
    · exact (hgBd h1).mono inter_subset_left inter_subset_left
  · -- Step 6: on the piece `gᵢ(Aᵢₗ)`, `TₓM = range Dgᵢ` a.e. and the single-piece area formula
    -- applies with the Lipschitz extension `Gₗ` of `F|Vₗ`
    have hlowA : ∀ a ∈ A k, ∀ a' ∈ A k, m k.1 * ‖a - a'‖ ≤ ‖g k.1 a - g k.1 a'‖ :=
      fun a ha a' ha' => hlow k.1 a (hAB k ha) a' (hAB k ha')
    have hinj : InjOn (g k.1) (A k) := fun a ha a' ha' he => by
      have hle := hlowA a ha a' ha'
      rw [he, sub_self, norm_zero] at hle
      exact sub_eq_zero.1 (norm_le_zero_iff.1 (nonpos_of_mul_nonpos_right hle (hm k.1)))
    exact Submission.idtp_caf_piece_area_formula P n (g k.1) (A k) (Lg k.1) (V k.2) F (G k.2)
      (LG k.2) (approxTangentPlane n M) h (hLg k.1) (hAm k) hinj
      (fun a ha => (hdiff k.1 a (hAB k ha)).1) (hVo k.2) ((hAZ k).trans (hZsV k.2)) (hLG k.2)
      (hFG k.2)
      (fun x hx => hF.differentiableOn_one.differentiableAt (hZ.mem_nhds (hZsZ k.2 (hAZ k hx))))
      (Submission.idtp_caf_piece_approxTangentPlane_ae P n M (g k.1) (A k) (Lg k.1) (m k.1) hn hM
        hfin (hLg k.1) (hAm k) (hm k.1) hlowA (fun a ha => hdiff k.1 a (hAB k ha)) (hAM k))
      (hh.mono_set (hAM k))

/-- The carrier area formula (Simon Ch. 3, 2.4–2.5) for `n = 2` and a map `F : ℝᴾ → ℝ × ℝ` that is
`C¹` on an open set `Z`, with the Jacobian in product coordinates: the fibre sums
`p ↦ Σ_{x ∈ M ∩ Z, F(x) = p} h(x)` are a.e. measurable and
`∫ Σ_{x ∈ M ∩ Z, F(x) = p} h(x) dp = ∫_{M ∩ Z} J_F(x) h(x) dH²(x)`, where `J_F(x)` is the square
root of `det((DF(x)uᵢ)₁(DF(x)uⱼ)₁ + (DF(x)uᵢ)₂(DF(x)uⱼ)₂)` for the standard orthonormal basis `u`
of `TₓM`.  The coordinate isomorphism `κ : ℝ × ℝ ≃ ℝ²` preserves Lebesgue measure and inner
products, so this is `Submission.idtp_carrier_area_formula` for `κ ∘ F`, transported along `κ`. -/
theorem Submission.idtp_cse_fa_area_formula_prod : ∀ (P : ℕ) (M Z : Set (Euclid P)) (F : Euclid P → ℝ × ℝ) (h : Euclid P → ℝ≥0∞), MeasurableSet M → CountablyRectifiable 2 M → (∀ K : Set (Euclid P), IsCompact K → μHE[2] (M ∩ K) ≠ ∞) → IsOpen Z → ContDiffOn ℝ 1 F Z → AEMeasurable h (μHE[2].restrict M) → AEMeasurable (fun p : ℝ × ℝ => ∑' x : ↥(M ∩ Z ∩ F ⁻¹' {p}), h x) volume ∧ ∫⁻ p : ℝ × ℝ, (∑' x : ↥(M ∩ Z ∩ F ⁻¹' {p}), h x) = ∫⁻ x in M ∩ Z, ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ (approxTangentPlane 2 M x)) => (fderiv ℝ F x (stdOrthonormalBasis ℝ (approxTangentPlane 2 M x) i)).1 * (fderiv ℝ F x (stdOrthonormalBasis ℝ (approxTangentPlane 2 M x) j)).1 + (fderiv ℝ F x (stdOrthonormalBasis ℝ (approxTangentPlane 2 M x) i)).2 * (fderiv ℝ F x (stdOrthonormalBasis ℝ (approxTangentPlane 2 M x) j)).2))) * h x ∂μHE[2] := by
  intro P M Z F h hM hrect hfin hZ hF hh
  -- Step 1: the coordinate isomorphism `κ : ℝ × ℝ ≃L Euclid 2`, `κ p = (p.1, p.2)`, with
  -- `⟪κ p, κ p'⟫ = p.1 p'.1 + p.2 p'.2`
  let κ : (ℝ × ℝ) ≃L[ℝ] Euclid 2 :=
    (ContinuousLinearEquiv.finTwoArrow ℝ ℝ).symm.trans (EuclideanSpace.equiv (Fin 2) ℝ).symm
  have hκi : ∀ p p' : ℝ × ℝ, inner ℝ (κ p) (κ p') = p.1 * p'.1 + p.2 * p'.2 := by
    intro p p'
    simp only [κ, ContinuousLinearEquiv.trans_apply, ContinuousLinearEquiv.finTwoArrow_symm_apply,
      PiLp.continuousLinearEquiv_symm_apply, PiLp.inner_apply, RCLike.inner_apply, conj_trivial,
      Fin.sum_univ_two, Fin.isValue, Matrix.cons_val_zero, Matrix.cons_val_one]
    ring
  -- Step 2: `κ` is a measure-preserving measurable embedding
  have hκ : MeasurePreserving κ volume volume :=
    (PiLp.volume_preserving_toLp (Fin 2)).comp (volume_preserving_finTwoArrow ℝ).symm
  have hκe : MeasurableEmbedding κ := κ.toHomeomorph.measurableEmbedding
  -- Step 3: `Φ = κ ∘ F` has the same Gram Jacobian as `F`
  have hgram : ∀ x v w, inner ℝ (fderiv ℝ (κ ∘ F) x v) (fderiv ℝ (κ ∘ F) x w) =
      (fderiv ℝ F x v).1 * (fderiv ℝ F x w).1 + (fderiv ℝ F x v).2 * (fderiv ℝ F x w).2 := by
    intro x v w
    rw [κ.comp_fderiv]
    exact hκi _ _
  -- Step 4: the fibres of `F` over `p` are the fibres of `Φ` over `κ p`
  have hS : (fun p : ℝ × ℝ => ∑' x : ↥(M ∩ Z ∩ F ⁻¹' {p}), h x) =
      (fun y : Euclid 2 => ∑' x : ↥(M ∩ Z ∩ (κ ∘ F) ⁻¹' {y}), h x) ∘ κ := by
    funext p
    have hfib : M ∩ Z ∩ (κ ∘ F) ⁻¹' {κ p} = M ∩ Z ∩ F ⁻¹' {p} := by
      ext x
      simp only [mem_inter_iff, mem_preimage, mem_singleton_iff, comp_apply, κ.injective.eq_iff]
    exact congrArg (fun s : Set (Euclid P) => ∑' x : ↥s, h x) hfib.symm
  -- Step 5: the area formula on the carrier for `Φ : ℝᴾ → Euclid 2`
  obtain ⟨hmeas, hint⟩ := Submission.idtp_carrier_area_formula P 2 M Z (κ ∘ F) h (by norm_num)
    hM hrect hfin hZ (κ.contDiff.comp_contDiffOn hF) hh
  -- Step 6: transport along `κ`
  refine ⟨?_, ?_⟩
  · rw [hS]
    exact (hκ.aemeasurable_comp_iff hκe).2 hmeas
  · rw [hS]
    refine (hκ.lintegral_comp_emb hκe _).trans (hint.trans ?_)
    simp only [hgram]

/-- **Fibre-sum identities for the polar map on the carrier** (Simon Ch. 3, 2.4–2.5, the weighted
area formula, with the Jacobian computed).  Let `R = (M, θ, ξ)` be an integer multiplicity triple in
`ℝᴾ` with `x ∈ TₓM` for `μ = θ H²⌞M`-a.e. `x`, and let `(a, e)` be an orthonormal basis of the plane
`Q`, `π = p_Q`.  Put `f(x) = arctan(⟨x, e⟩/⟨x, a⟩)`, `F̃ = (|·|, f)`, `Ax = ⟨x, a⟩e − ⟨x, e⟩a`,
`w(x) = |p_{TₓM}(Ax)|` and `Z_s = {⟨x, a⟩ > 0, ||x| − 1| < s, |f(x)| < s, |x − πx| < s|x|}`.  Then
the fibre sums `H(p) = Σ_{x ∈ M ∩ Z_s, F̃(x) = p} θ(x) w(x)` and
`N(p) = Σ_{x ∈ M ∩ Z_s, F̃(x) = p} θ(x)` are a.e. measurable and, for Borel `b ≥ 0`,
`∫ b H = ∫_{Z_s} b(F̃) w²/|πx|² dμ` and `∫ b N = ∫_{Z_s} b(F̃) w/|πx|² dμ`.  `Z_s` is open and `F̃`
is `C¹` on it, so the carrier area formula applies to `h = θ (b ∘ F̃) w` and `h = θ (b ∘ F̃)`, whose
fibre sums are `b(p) H(p)` and `b(p) N(p)`.  `H²`-a.e. on `M`, `TₓM` is a plane containing `x`,
along which the Jacobian of `F̃` is `w(x)/|πx|²`; and `μ = θ H²⌞M`. -/
theorem Submission.idtp_cse_fibre_area_identities : ∀ (P : ℕ) (R : IMRep (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (s : ℝ), Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → (∀ᵐ x ∂R.measure, (approxTangentPlane 2 R.carrier x).starProjection x = x) → AEMeasurable (fun p : ℝ × ℝ => ∑' x : ↥(R.carrier ∩ {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} ∩ (fun x : Euclid P => (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a))) ⁻¹' {p}), (R.mult x : ℝ≥0∞) * ENNReal.ofReal ‖(approxTangentPlane 2 R.carrier (x : Euclid P)).starProjection (inner ℝ (x : Euclid P) a • e - inner ℝ (x : Euclid P) e • a)‖) volume ∧ AEMeasurable (fun p : ℝ × ℝ => ∑' x : ↥(R.carrier ∩ {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} ∩ (fun x : Euclid P => (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a))) ⁻¹' {p}), (R.mult x : ℝ≥0∞)) volume ∧ ∀ b : ℝ × ℝ → ℝ≥0∞, Measurable b → (∫⁻ p : ℝ × ℝ, b p * ∑' x : ↥(R.carrier ∩ {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} ∩ (fun x : Euclid P => (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a))) ⁻¹' {p}), (R.mult x : ℝ≥0∞) * ENNReal.ofReal ‖(approxTangentPlane 2 R.carrier (x : Euclid P)).starProjection (inner ℝ (x : Euclid P) a • e - inner ℝ (x : Euclid P) e • a)‖ = ∫⁻ x in {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖}, b (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a)) * ENNReal.ofReal (‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2) ∂R.measure) ∧ (∫⁻ p : ℝ × ℝ, b p * ∑' x : ↥(R.carrier ∩ {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} ∩ (fun x : Euclid P => (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a))) ⁻¹' {p}), (R.mult x : ℝ≥0∞) = ∫⁻ x in {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖}, b (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a)) * ENNReal.ofReal (‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ / ‖Q.starProjection x‖ ^ 2) ∂R.measure) := by
  intro P R Q a e s hQ haQ heQ ha he hae hrad
  -- Step 1: `M` is Borel and countably `2`-rectifiable, and `H²(M ∩ K) ≤ ∫_{M ∩ K} θ dH² < ∞` for
  -- compact `K`, as `θ ≥ 1` on `M`
  have hM : MeasurableSet R.carrier := R.measurableSet_carrier
  have hθm : Measurable fun x => (R.mult x : ℝ≥0∞) :=
    (measurable_from_nat (f := fun k : ℕ => (k : ℝ≥0∞))).comp R.measurable_mult
  have hfin : ∀ K : Set (Euclid P), IsCompact K → μHE[2] (R.carrier ∩ K) ≠ ∞ := by
    intro K hK
    refine ne_top_of_le_ne_top (R.locallyIntegrable_mult K hK (subset_univ K)) ?_
    calc μHE[2] (R.carrier ∩ K) = ∫⁻ _ in R.carrier ∩ K, 1 ∂μHE[2] := (setLIntegral_one _).symm
      _ ≤ _ := setLIntegral_mono hθm fun x hx => Nat.one_le_cast.2 (R.mult_pos x hx.1)
  -- Step 2: `H²⌞M`-a.e., `TₓM` is a plane (`ξ` orients it) containing `x` (the hypothesis, as
  -- `H²⌞M ≪ μ = θ H²⌞M` with `θ > 0` on `M`)
  have hac : μHE[2].restrict R.carrier ≪ R.measure :=
    withDensity_absolutelyContinuous' hθm.aemeasurable
      ((ae_restrict_iff' hM).2 (ae_of_all _ fun x hx => Nat.cast_ne_zero.2 (R.mult_pos x hx).ne'))
  have hgood : ∀ᵐ x ∂(μHE[2].restrict R.carrier),
      Module.finrank ℝ (approxTangentPlane 2 R.carrier x) = 2 ∧
        (approxTangentPlane 2 R.carrier x).starProjection x = x := by
    filter_upwards [hac.ae_le hrad,
      Submission.fvmb_imrep_ae_unitOrientation_approxTangentPlane P 2 univ R] with x hx hξ
    obtain ⟨τ, hτ, hspan, -⟩ := hξ
    refine ⟨?_, hx⟩
    rw [← hspan, finrank_span_eq_card hτ.linearIndependent, Fintype.card_fin]
  -- Step 3: let `Z` be open, `F` be `C¹` on `Z` with Jacobian `J` along `TₓM` at the good points of
  -- `M ∩ Z`, and `J c = θ g`.  The carrier area formula for `h = (b ∘ F) c` gives
  -- `∫ b(p) Σ_{x ∈ M ∩ Z, F(x) = p} c(x) dp = ∫_{M ∩ Z} θ (b ∘ F) g dH² = ∫_Z (b ∘ F) g dμ`
  have main : ∀ (Z : Set (Euclid P)) (F : Euclid P → ℝ × ℝ) (J : Euclid P → ℝ), IsOpen Z →
      ContDiffOn ℝ 1 F Z → Measurable F →
      (∀ x ∈ R.carrier ∩ Z, Module.finrank ℝ (approxTangentPlane 2 R.carrier x) = 2 →
        (approxTangentPlane 2 R.carrier x).starProjection x = x →
        Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ
            (approxTangentPlane 2 R.carrier x)) =>
          (fderiv ℝ F x (stdOrthonormalBasis ℝ (approxTangentPlane 2 R.carrier x) i)).1 *
              (fderiv ℝ F x (stdOrthonormalBasis ℝ (approxTangentPlane 2 R.carrier x) j)).1 +
            (fderiv ℝ F x (stdOrthonormalBasis ℝ (approxTangentPlane 2 R.carrier x) i)).2 *
              (fderiv ℝ F x (stdOrthonormalBasis ℝ (approxTangentPlane 2 R.carrier x) j)).2)) =
          J x) →
      ∀ (c : Euclid P → ℝ≥0∞) (g : Euclid P → ℝ), AEMeasurable c (μHE[2].restrict R.carrier) →
      (∀ x, ENNReal.ofReal (J x) * c x = (R.mult x : ℝ≥0∞) * ENNReal.ofReal (g x)) →
      AEMeasurable (fun p : ℝ × ℝ => ∑' x : ↥(R.carrier ∩ Z ∩ F ⁻¹' {p}), c x) volume ∧
      ∀ b : ℝ × ℝ → ℝ≥0∞, Measurable b →
        ∫⁻ p : ℝ × ℝ, b p * ∑' x : ↥(R.carrier ∩ Z ∩ F ⁻¹' {p}), c x =
          ∫⁻ x in Z, b (F x) * ENNReal.ofReal (g x) ∂R.measure := by
    intro Z F J hZo hZF hFm hJ c g hc hcg
    have hZm : MeasurableSet Z := hZo.measurableSet
    -- the carrier area formula in product coordinates
    have haf := fun (h : Euclid P → ℝ≥0∞) (hh : AEMeasurable h (μHE[2].restrict R.carrier)) =>
      Submission.idtp_cse_fa_area_formula_prod P R.carrier Z F h hM R.rectifiable hfin hZo hZF hh
    refine ⟨(haf c hc).1, fun b hb => ?_⟩
    obtain ⟨-, hint⟩ := haf (fun x => b (F x) * c x) ((hb.comp hFm).aemeasurable.mul hc)
    -- the fibre sum of `(b ∘ F) c` over `p` is `b(p)` times the fibre sum of `c`
    have hfib : ∀ p : ℝ × ℝ, ∑' x : ↥(R.carrier ∩ Z ∩ F ⁻¹' {p}), b (F x) * c x =
        b p * ∑' x : ↥(R.carrier ∩ Z ∩ F ⁻¹' {p}), c x := by
      intro p
      rw [← ENNReal.tsum_mul_left]
      refine tsum_congr fun x => ?_
      rw [show F x = p from x.2.2]
    -- `∫_Z φ dμ = ∫_{M ∩ Z} θ φ dH²`, as `μ = θ H²⌞M`
    have hμ : ∫⁻ x in Z, b (F x) * ENNReal.ofReal (g x) ∂R.measure =
        ∫⁻ x in R.carrier ∩ Z, (R.mult x : ℝ≥0∞) * (b (F x) * ENNReal.ofReal (g x)) ∂μHE[2] := by
      rw [IMRep.measure, setLIntegral_withDensity_eq_setLIntegral_mul_non_measurable _ hθm _ hZm
        (ae_of_all _ fun x => ENNReal.natCast_lt_top _), Measure.restrict_restrict hZm, inter_comm]
      rfl
    rw [hμ, lintegral_congr fun p => (hfib p).symm, hint]
    -- at the good points, which are `H²`-almost all of `M ∩ Z`, the Jacobian is `J`
    refine lintegral_congr_ae ?_
    filter_upwards [ae_restrict_mem (hM.inter hZm),
      ae_restrict_of_ae_restrict_of_subset inter_subset_left hgood] with x hx hx'
    rw [hJ x hx hx'.1 hx'.2, mul_left_comm, hcg x, mul_left_comm]
  -- Step 4: `Z_s` is open, `F̃` is `C¹` on `Z_s ⊆ {⟨x, a⟩ > 0}` and Borel, and along a plane
  -- `T ∋ x` its Jacobian is `|p_T(Ax)|/|πx|²`
  obtain ⟨hZo, hFc⟩ := Submission.idtp_cse_fa_sector_open_contDiffOn P Q a e s
  have hFm : Measurable fun x : Euclid P => (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a)) := by
    fun_prop
  have hJ := fun x (hx : x ∈ R.carrier ∩ {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧
      |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖}) =>
    Submission.idtp_cse_fa_polar_gram_jacobian P Q (approxTangentPlane 2 R.carrier x) a e x hQ haQ
      heQ ha he hae hx.2.1
  -- Step 5: `w` is `H²⌞M`-a.e. measurable, `p_{TₓM}` being so
  have hw : AEMeasurable (fun x => ENNReal.ofReal
      ‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖)
      (μHE[2].restrict R.carrier) := by
    have hA : Continuous fun x : Euclid P => inner ℝ x a • e - inner ℝ x e • a := by fun_prop
    exact ((continuous_fst.clm_apply continuous_snd).comp_aestronglyMeasurable₂
      (Submission.imrep_approxTangent_starProjection_aesm P 2 univ R)
      hA.aestronglyMeasurable).norm.aemeasurable.ennreal_ofReal
  -- Step 6: Step 3 with `c = θ w`, `g = w²/|πx|²` (for `H`) and `c = θ`, `g = w/|πx|²` (for `N`)
  obtain ⟨hH, hH'⟩ := main _ _ _ hZo (hFc.mono fun x hx => hx.1) hFm hJ
    (fun x => (R.mult x : ℝ≥0∞) * ENNReal.ofReal
      ‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖)
    (fun x => ‖(approxTangentPlane 2 R.carrier x).starProjection
      (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2)
    (hθm.aemeasurable.mul hw) fun x => by
      rw [mul_left_comm, ← ENNReal.ofReal_mul (by positivity)]
      congr 2
      ring
  obtain ⟨hN, hN'⟩ := main _ _ _ hZo (hFc.mono fun x hx => hx.1) hFm hJ
    (fun x => (R.mult x : ℝ≥0∞))
    (fun x => ‖(approxTangentPlane 2 R.carrier x).starProjection
      (inner ℝ x a • e - inner ℝ x e • a)‖ / ‖Q.starProjection x‖ ^ 2)
    hθm.aemeasurable fun x => mul_comm _ _
  exact ⟨hH, hN, fun b hb => ⟨hH' b hb, hN' b hb⟩⟩

/-- **Simon A.4** (proof, p. 228; chapter-A.txt lines 125–131), moving test functions: if every
`μⱼ` is finite on compact sets, `∫ g dμⱼ → ∫ g dμ` for every `g ∈ C_c(ℝᴾ)` and `sⱼ → 1`, then
`∫ f(sⱼ y) dμⱼ(y) → ∫ f dμ` for every `f ∈ C_c(ℝᴾ)`.  If `f = 0` off `B̄_R(0)`, then for large `j`
both `f` and `f(sⱼ ·)` vanish off `K = B̄_{2R}(0)` and `f(sⱼ ·) → f` uniformly; an Urysohn
function `g ∈ C_c` with `0 ≤ g ≤ 1` and `g = 1` on `K` gives `|f(sⱼ ·) - f| ≤ δ g`, so
`|∫ f(sⱼ ·) dμⱼ - ∫ f dμⱼ| ≤ δ ∫ g dμⱼ`, and `∫ g dμⱼ` is bounded for large `j`. -/
theorem Submission.idtp_cttp_bti_rescaled_tests_tendsto : ∀ (P : ℕ) (μs : ℕ → Measure (Euclid P)) (μ : Measure (Euclid P)) (s : ℕ → ℝ) (f : Euclid P → ℝ), (∀ j, ∀ K : Set (Euclid P), IsCompact K → μs j K < ∞) → (∀ g : Euclid P → ℝ, Continuous g → HasCompactSupport g → Tendsto (fun j => ∫ x, g x ∂(μs j)) atTop (𝓝 (∫ x, g x ∂μ))) → Tendsto s atTop (𝓝 1) → Continuous f → HasCompactSupport f → Tendsto (fun j => ∫ y, f (s j • y) ∂(μs j)) atTop (𝓝 (∫ x, f x ∂μ)) := by
  intro P μs μ s f hfin hconv hs hf hfc
  have : ∀ j, IsFiniteMeasureOnCompacts (μs j) := fun j => ⟨fun K hK => hfin j K hK⟩
  -- `f = 0` off `B̄_R(0)`, `R ≥ 0`
  obtain ⟨R, hR, hfR⟩ : ∃ R : ℝ, 0 ≤ R ∧ ∀ w : Euclid P, R < ‖w‖ → f w = 0 := by
    obtain ⟨R₀, hR₀⟩ :=
      (show IsCompact (tsupport f) from hfc).isBounded.subset_closedBall (0 : Euclid P)
    refine ⟨max R₀ 0, le_max_right _ _, fun w hw => image_eq_zero_of_notMem_tsupport fun hw' => ?_⟩
    linarith [le_max_left R₀ 0, mem_closedBall_zero_iff.1 (hR₀ hw')]
  have hKc : IsCompact (closedBall (0 : Euclid P) (2 * R)) := isCompact_closedBall _ _
  -- for large `j`, `sⱼ > 1/2`, so `f(sⱼ ·) = 0` off `K = B̄_{2R}(0)`
  have hvan : ∀ᶠ j in atTop, ∀ w ∉ closedBall (0 : Euclid P) (2 * R), f (s j • w) = 0 := by
    filter_upwards [hs.eventually (lt_mem_nhds (by norm_num : (1 / 2 : ℝ) < 1))] with j hj w hw
    rw [mem_closedBall_zero_iff, not_le] at hw
    apply hfR
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (show (0 : ℝ) < s j by linarith)]
    nlinarith
  -- Urysohn: `g ∈ C_c`, `0 ≤ g ≤ 1`, `g = 1` on `K`
  obtain ⟨g, hgK, -, hgc, hg01⟩ :=
    exists_continuous_one_zero_of_isCompact hKc isClosed_empty (disjoint_empty _)
  -- uniform continuity of `f`: for large `j`, `|f(sⱼ ·) - f| ≤ δ g`
  have key : ∀ δ > 0, ∀ᶠ j in atTop, ∀ w, ‖f (s j • w) - f w‖ ≤ δ * g w := by
    intro δ hδ
    obtain ⟨η, hη, hfη⟩ :=
      Metric.uniformContinuous_iff.1 (hfc.uniformContinuous_of_continuous hf) δ hδ
    have hR1 : 0 < 2 * R + 1 := by linarith
    filter_upwards [hvan, Metric.tendsto_nhds.1 hs (η / (2 * R + 1)) (div_pos hη hR1)]
      with j hjv hj w
    by_cases hw : w ∈ closedBall (0 : Euclid P) (2 * R)
    · rw [hgK hw, Pi.one_apply, mul_one, ← dist_eq_norm]
      refine (hfη ?_).le
      rw [Real.dist_eq] at hj
      have hw' := mem_closedBall_zero_iff.1 hw
      calc dist (s j • w) w = |s j - 1| * ‖w‖ := by
            rw [dist_eq_norm, ← Real.norm_eq_abs, ← norm_smul, sub_smul, one_smul]
        _ ≤ |s j - 1| * (2 * R + 1) := mul_le_mul_of_nonneg_left (by linarith) (abs_nonneg _)
        _ < η / (2 * R + 1) * (2 * R + 1) := mul_lt_mul_of_pos_right hj hR1
        _ = η := div_mul_cancel₀ _ hR1.ne'
    · have hw' : 2 * R < ‖w‖ := by rwa [mem_closedBall_zero_iff, not_le] at hw
      rw [hjv w hw, hfR w (by linarith), sub_zero, norm_zero]
      exact mul_nonneg hδ.le (hg01 w).1
  -- `∫ g dμⱼ ≤ M` for large `j`
  obtain ⟨M, hM, hgM⟩ : ∃ M : ℝ, 0 < M ∧ ∀ᶠ j in atTop, ∫ x, g x ∂(μs j) ≤ M :=
    ⟨max (∫ x, g x ∂μ + 1) 1, lt_max_of_lt_right one_pos,
      ((hconv g g.continuous hgc).eventually (gt_mem_nhds (lt_add_one _))).mono
        fun j hj => hj.le.trans (le_max_left _ _)⟩
  -- `∫ f(sⱼ ·) dμⱼ - ∫ f dμⱼ → 0`
  have hdiff : Tendsto (fun j => ∫ y, f (s j • y) ∂(μs j) - ∫ y, f y ∂(μs j)) atTop (𝓝 0) := by
    rw [Metric.tendsto_nhds]
    intro ε hε
    have hδ : 0 < ε / (2 * M) := div_pos hε (mul_pos two_pos hM)
    filter_upwards [key _ hδ, hvan, hgM] with j hj hjv hjM
    have hfj : Integrable (fun y => f (s j • y)) (μs j) :=
      (hf.comp (continuous_const_smul (s j))).integrable_of_hasCompactSupport
        (HasCompactSupport.intro hKc hjv)
    rw [dist_zero_right, ← integral_sub hfj (hf.integrable_of_hasCompactSupport hfc)]
    calc ‖∫ y, (f (s j • y) - f y) ∂(μs j)‖ ≤ ∫ y, ε / (2 * M) * g y ∂(μs j) :=
          norm_integral_le_of_norm_le
            ((g.continuous.integrable_of_hasCompactSupport hgc).const_mul _)
            (Eventually.of_forall hj)
      _ = ε / (2 * M) * ∫ y, g y ∂(μs j) := integral_const_mul _ _
      _ ≤ ε / (2 * M) * M := mul_le_mul_of_nonneg_left hjM hδ.le
      _ = ε / 2 := by field_simp
      _ < ε := half_lt_self hε
  -- `∫ f(sⱼ ·) dμⱼ = ∫ f dμⱼ + (∫ f(sⱼ ·) dμⱼ - ∫ f dμⱼ) → ∫ f dμ + 0`
  have hlim := (hconv f hf hfc).add hdiff
  rw [add_zero] at hlim
  exact hlim.congr fun j => add_sub_cancel _ _
/-- **Simon, Appendix A, proof of A.4 (p. 228)**: the identity behind
`ψ_{βx,1} = lim φ_{x+λⱼβx,λⱼ}`.  If `μ` is `n`-homogeneous, `μ(c·A) = cⁿμ(A)` for `c > 0`, and
`ν(B) = λ⁻ⁿμ(η_{p,λ}⁻¹B)` is its blow-up at `p` with scale `λ > 0`, then for `s = 1 + λt > 0`,
`∫ f(y − tp) dν(y) = sⁿ ∫ f(sy) dν(y)` for every continuous `f`.  With `τ = (· − tp)` and
`m_s = (s ·)`, `η⁻¹(τ⁻¹B) = s·η⁻¹(m_s⁻¹B)`, hence `τ_#ν = sⁿ(m_s)_#ν`. -/
theorem Submission.idtp_cttp_bti_blowup_translate_integral : ∀ (P n : ℕ) (μ ν : Measure (Euclid P)) (p : Euclid P) (lam t : ℝ), 0 < lam → 0 < 1 + lam * t → (∀ c : ℝ, 0 < c → ∀ A : Set (Euclid P), MeasurableSet A → μ ((fun x => c • x) '' A) = ENNReal.ofReal (c ^ n) * μ A) → (∀ B : Set (Euclid P), MeasurableSet B → ν B = ENNReal.ofReal (lam⁻¹ ^ n) * μ (dilation p lam ⁻¹' B)) → ∀ f : Euclid P → ℝ, Continuous f → ∫ y, f (y - t • p) ∂ν = (1 + lam * t) ^ n * ∫ y, f ((1 + lam * t) • y) ∂ν := by
  intro P n μ ν p lam t hlam hs hhom hblow f hf
  set s := 1 + lam * t with hs_def
  -- `τ`, `m_s` and `η = η_{p,λ}` are continuous, hence Borel
  have hτ : Measurable fun y : Euclid P => y - t • p :=
    (continuous_id.sub continuous_const).measurable
  have hm : Measurable fun y : Euclid P => s • y := (continuous_const_smul s).measurable
  have hη : Measurable (dilation p lam) :=
    (continuous_const.add (dilationCLM P lam).continuous).measurable
  -- `sλ⁻¹ = λ⁻¹ + t` and `s(λ⁻¹s⁻¹) = λ⁻¹`
  have h1 : s * lam⁻¹ = lam⁻¹ + t := by
    rw [hs_def]
    field_simp
  have h2 : s * (lam⁻¹ * s⁻¹) = lam⁻¹ := by
    rw [mul_left_comm, mul_inv_cancel₀ hs.ne', mul_one]
  -- `η⁻¹(τ⁻¹B) = s·η⁻¹(m_s⁻¹B)`: the image under `m_s` is the preimage under `m_{s⁻¹}`, and
  -- `s·η(s⁻¹y) = η(y) − tp`
  have hset : ∀ B : Set (Euclid P), dilation p lam ⁻¹' ((fun y => y - t • p) ⁻¹' B) =
      (fun x => s • x) '' (dilation p lam ⁻¹' ((fun y => s • y) ⁻¹' B)) := by
    intro B
    rw [image_eq_preimage_of_inverse (f := fun x : Euclid P => s • x) (g := fun x => s⁻¹ • x)
      (fun x => inv_smul_smul₀ hs.ne' x) (fun x => smul_inv_smul₀ hs.ne' x)]
    ext y
    have key : s • (-(lam⁻¹ • p) + lam⁻¹ • s⁻¹ • y) = -(lam⁻¹ • p) + lam⁻¹ • y - t • p := by
      simp only [smul_add, smul_neg, smul_smul]
      rw [h2, h1, add_smul]
      abel
    simp only [mem_preimage, dilation, dilationCLM, smul_apply, ContinuousLinearMap.id_apply]
    rw [key]
  -- `τ_#ν = sⁿ(m_s)_#ν` on Borel sets, by the blow-up formula and homogeneity at `c = s`
  have hmap : ν.map (fun y => y - t • p) = ENNReal.ofReal (s ^ n) • ν.map (fun y => s • y) := by
    ext B hB
    rw [Measure.map_apply hτ hB, Measure.smul_apply, Measure.map_apply hm hB, smul_eq_mul,
      hblow _ (hτ hB), hblow _ (hm hB), hset, hhom s hs _ (hη (hm hB)), mul_left_comm]
  -- change of variables; no integrability of `f` is needed
  rw [← integral_map hτ.aemeasurable hf.aestronglyMeasurable, hmap, integral_smul_measure,
    integral_map hm.aemeasurable hf.aestronglyMeasurable,
    ENNReal.toReal_ofReal (pow_nonneg hs.le n), smul_eq_mul]

/-- **Simon, Appendix A, proof of A.4 (p. 228; chapter-A.txt lines 125–131)**: the step
`ψ_{βx,1} = lim φ_{x+λⱼβx,λⱼ} = ψ` for the mass measures of the blow-ups of a cone.  If `C` is an
integer multiplicity cone, `λⱼ → 0` and `μ_{η_{p,λⱼ#}C} → μ_{C'}`, then `μ_{C'}` is invariant
under translation by every `v ∈ ℝp`.  For `C = τ(M, θ, ξ)` and `η = η_{x,λ}`,
`η_#C = τ(η(M), θ ∘ η⁻¹, ξ ∘ η⁻¹)` with weight `λ⁻ⁿ η_#μ_C`, since `Hⁿ(η(s)) = λ⁻ⁿ Hⁿ(s)`,
`η_#C(ω) = λ⁻ⁿ C(ω ∘ η)` and `T_{η(y)}η(M) = T_yM`.  For `x = 0` the cone property and uniqueness
of the weight give `μ_C(cA) = cⁿ μ_C(A)`.  With `sⱼ = 1 + λⱼt → 1`, for `f ∈ C_c`,
`∫ f(y − tp) dμⱼ = sⱼⁿ ∫ f(sⱼy) dμⱼ → ∫ f dμ_{C'}`, so `∫ f(y − tp) dμ_{C'} = ∫ f dμ_{C'}`.
Both `μ_{C'}` and its translate are finite on compact sets, hence regular, and Riesz uniqueness
gives `(τ_v)_#μ_{C'} = μ_{C'}`. -/
theorem Submission.idtp_cttp_blowup_limit_translation_invariant : ∀ (P n : ℕ) (C C' : GeometricCurrentOn (univ : Set (Euclid P)) n) (p : Euclid P) (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), IsIntegerMultiplicity C → IsConeCurrent C → Tendsto lams atTop (𝓝 0) → MassMeasuresConverge (fun j => blowUp C p (lams j) (hlams j).ne') C' → ∀ R' : IMRep (univ : Set (Euclid P)) n, R'.Represents C' → ∀ v ∈ Submodule.span ℝ {p}, ∀ A : Set (Euclid P), MeasurableSet A → R'.measure ((fun x => x + v) ⁻¹' A) = R'.measure A := by
  intro P n C C' p lams hlams hIM hcone hlim hconv R' hR' v hv A hA
  obtain ⟨R, hR⟩ := hIM
  -- `η_{x,λ}` is onto, with inverse `z ↦ x + λz`
  have hsurj : ∀ (x : Euclid P) (lam : ℝ), 0 < lam → dilation x lam '' univ = univ :=
    fun x lam hlam => image_univ_of_surjective fun z =>
      ⟨x + lam • z, by simp [dilation, dilationCLM, smul_add, smul_smul, hlam.ne']⟩
  -- `Hⁿ(η_{x,λ}(s)) = λ⁻ⁿ Hⁿ(s)`: `η_{x,λ}(s)` is the translate by `−λ⁻¹x` of `λ⁻¹s`
  have himage : ∀ (x : Euclid P) (lam : ℝ), 0 < lam → ∀ s : Set (Euclid P),
      μHE[n] (dilation x lam '' s) = ENNReal.ofReal (lam⁻¹ ^ n) * μHE[n] s := by
    intro x lam hlam s
    have hs : dilation x lam '' s =
        (fun z => -(lam⁻¹ • x) + z) '' ((fun y => lam⁻¹ • y) '' s) := by
      rw [Set.image_image]
      rfl
    rw [hs, (isometry_add_left (-(lam⁻¹ • x))).euclideanHausdorffMeasure_image, Set.image_smul,
      Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hlam.ne') s, ENNReal.smul_def,
      smul_eq_mul, ← ENNReal.ofReal_coe_nnreal]
    congr 2
    simp [abs_of_pos hlam]
  -- Step 1 (blow-ups): `η_{x,λ#}C = τ(η(M), θ ∘ η⁻¹, ξ ∘ η⁻¹)` and its weight is
  -- `B ↦ λ⁻ⁿ μ_R(η⁻¹(B))`, `η = η_{x,λ}`
  have hrep : ∀ (x : Euclid P) (lam : ℝ) (hlam : 0 < lam),
      ∃ Rb : IMRep (dilation x lam '' (univ : Set (Euclid P))) n,
        Rb.Represents (blowUp C x lam hlam.ne') ∧ ∀ s : Set (Euclid P), MeasurableSet s →
          Rb.measure s = ENNReal.ofReal (lam⁻¹ ^ n) * R.measure (dilation x lam ⁻¹' s) := by
    intro x lam hlam
    have hne : lam ≠ 0 := hlam.ne'
    let η : Euclid P ≃ₜ Euclid P := (Homeomorph.smulOfNeZero lam⁻¹ (inv_ne_zero hne)).trans
      (Homeomorph.addLeft (-(lam⁻¹ • x)))
    have hη : ⇑η = dilation x lam := by
      funext y
      simp [η, dilation, dilationCLM]
    have hme : MeasurableEmbedding (dilation x lam) := by
      rw [← hη]
      exact η.measurableEmbedding
    have hιη : ∀ y, x + lam • dilation x lam y = y := fun y => by
      simp [dilation, dilationCLM, smul_add, smul_smul, hne]
    -- `ω ∈ 𝒟ⁿ(η(ℝᴾ))` gives `ω ∘ η ∈ 𝒟ⁿ(ℝᴾ)`
    have hpull : ∀ ω : TestFormOn (dilation x lam '' (univ : Set (Euclid P))) n,
        ∃ ω' : TestFormOn (univ : Set (Euclid P)) n, ∀ y : Euclid P,
          (ω' : DifferentialForm (Euclid P) n) y =
            (ω : DifferentialForm (Euclid P) n) (dilation x lam y) := by
      intro ω
      obtain ⟨⟨hsmooth, hcompact⟩, -⟩ := ω.property
      refine ⟨⟨fun y => (ω : DifferentialForm (Euclid P) n) (dilation x lam y), ?_⟩, fun y => rfl⟩
      change IsTestForm (fun y => (ω : DifferentialForm (Euclid P) n) (dilation x lam y)) ∧
        tsupport (fun y => (ω : DifferentialForm (Euclid P) n) (dilation x lam y)) ⊆ univ
      refine ⟨⟨hsmooth.comp (contDiff_const.add (dilationCLM P lam).contDiff), ?_⟩, subset_univ _⟩
      have h := hcompact.comp_homeomorph η
      rwa [hη] at h
    -- `η_#C(ω) = C(η^#ω) = λ⁻ⁿ C(ω ∘ η)`, as `(η^#ω)(y) = ω(η(y)) ∘ (λ⁻¹ id) = λ⁻ⁿ ω(η(y))`
    have hblow : ∀ (ω : TestFormOn (dilation x lam '' (univ : Set (Euclid P))) n)
        (ω' : TestFormOn (univ : Set (Euclid P)) n), (∀ y : Euclid P,
          (ω' : DifferentialForm (Euclid P) n) y =
            (ω : DifferentialForm (Euclid P) n) (dilation x lam y)) →
        blowUp C x lam hne ω = lam⁻¹ ^ n * C ω' := by
      intro ω ω' hω
      unfold blowUp
      rw [GeometricCurrentOn.affinePushforward_apply, GeometricCurrentOn.restrictDomain_apply,
        show lam⁻¹ ^ n * C ω' = C (lam⁻¹ ^ n • ω') by rw [map_smul, smul_eq_mul]]
      congr 1
      apply Subtype.ext
      funext y
      ext u
      rw [testFormOnInclusion_coe, affinePullbackTestOn_coe]
      simp only [affinePullbackForm, ContinuousAlternatingMap.compContinuousLinearMap_apply]
      have hu : ⇑(dilationCLM P lam) ∘ u = fun i => lam⁻¹ • u i := by
        funext i
        simp [dilationCLM]
      rw [hu, ContinuousAlternatingMap.map_smul_univ, Finset.prod_const, Finset.card_univ,
        Fintype.card_fin, show -(lam⁻¹ • x) + dilationCLM P lam y = dilation x lam y from rfl,
        ← hω y]
      simp
    -- `T_{η(y)}η(M) = T_yM`: `η_{η(y),r}(η(M)) = η_{y,λr}(M)`, and `λr ↓ 0` as `r ↓ 0`
    have htan : ∀ (y : Euclid P) (Q : Submodule ℝ (Euclid P)),
        HasApproximateTangentSpaceAt n R.carrier y Q →
          HasApproximateTangentSpaceAt n (dilation x lam '' R.carrier) (dilation x lam y) Q := by
      intro y Q hT
      refine ⟨hT.1, fun f => ?_⟩
      have hset : ∀ r : ℝ, Poincare.SimonGMT.Chapter03.blowUpMap (dilation x lam y) r ''
          (dilation x lam '' R.carrier) =
            Poincare.SimonGMT.Chapter03.blowUpMap y (lam * r) '' R.carrier := by
        intro r
        rw [image_image]
        congr 1
        funext w
        simp only [Poincare.SimonGMT.Chapter03.blowUpMap, dilation, dilationCLM,
          smul_apply, ContinuousLinearMap.id_apply, add_sub_add_left_eq_sub]
        rw [← smul_sub, smul_smul, mul_inv, mul_comm]
      simp_rw [hset]
      have hr : Tendsto (fun r : ℝ => lam * r) (𝓝[>] 0) (𝓝[>] 0) := by
        refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ ?_ ?_
        · simpa using (tendsto_id.const_mul lam).mono_left (nhdsWithin_le_nhds (a := (0 : ℝ)))
        · filter_upwards [self_mem_nhdsWithin] with r hr
          exact mul_pos hlam hr
      exact (hT.2 f).comp hr
    -- `η_#Hⁿ = λⁿ Hⁿ`, as `η⁻¹(B) = η_{−λ⁻¹x,λ⁻¹}(B)`
    have hmap : Measure.map (dilation x lam) (μHE[n] : Measure (Euclid P)) =
        ENNReal.ofReal (lam ^ n) • (μHE[n] : Measure (Euclid P)) := by
      ext B hB
      have hpre : dilation x lam ⁻¹' B = dilation (-(lam⁻¹ • x)) lam⁻¹ '' B :=
        (congrFun (Set.image_eq_preimage_of_inverse
          (fun z => by simp [dilation, dilationCLM, smul_add, smul_smul, hne])
          (fun y => by simp [dilation, dilationCLM, smul_add, smul_smul, hne])) B).symm
      rw [Measure.map_apply hme.measurable hB, hpre, himage _ _ (inv_pos.mpr hlam), inv_inv,
        Measure.smul_apply, smul_eq_mul]
    have hc0 : 0 ≤ lam⁻¹ ^ n := by positivity
    set c : ℝ≥0∞ := ENNReal.ofReal (lam⁻¹ ^ n) with hc
    -- `Hⁿ⌞η(s) = c • η_#(Hⁿ⌞s)`, hence change of variables along `η`
    have hkey : ∀ s : Set (Euclid P),
        μHE[n].restrict (dilation x lam '' s) = c • (μHE[n].restrict s).map (dilation x lam) := by
      intro s
      have h1 : (μHE[n].restrict s).map (dilation x lam) =
          ENNReal.ofReal (lam ^ n) • μHE[n].restrict (dilation x lam '' s) := by
        rw [← hme.injective.preimage_image s, ← hme.restrict_map, hmap, Measure.restrict_smul,
          hme.injective.preimage_image]
      rw [h1, smul_smul, hc, ← ENNReal.ofReal_mul hc0, ← mul_pow, inv_mul_cancel₀ hne,
        one_pow, ENNReal.ofReal_one, one_smul]
    have hlint : ∀ (s : Set (Euclid P)) (g : Euclid P → ℝ≥0∞),
        ∫⁻ z in dilation x lam '' s, g z ∂μHE[n] = c * ∫⁻ y in s, g (dilation x lam y) ∂μHE[n] := by
      intro s g
      rw [hkey s, lintegral_smul_measure, hme.lintegral_map, smul_eq_mul]
    have hint : ∀ (s : Set (Euclid P)) (g : Euclid P → ℝ),
        ∫ z in dilation x lam '' s, g z ∂μHE[n] =
          lam⁻¹ ^ n * ∫ y in s, g (dilation x lam y) ∂μHE[n] := by
      intro s g
      rw [hkey s, integral_smul_measure, hme.integral_map, hc, ENNReal.toReal_ofReal hc0,
        smul_eq_mul]
    refine ⟨{ carrier := dilation x lam '' R.carrier
              mult := fun z => R.mult (x + lam • z)
              orient := fun z => R.orient (x + lam • z)
              measurableSet_carrier := hme.measurableSet_image.mpr R.measurableSet_carrier
              carrier_subset := image_mono R.carrier_subset
              rectifiable := ?_
              measurable_mult := R.measurable_mult.comp (by fun_prop)
              mult_pos := ?_
              locallyIntegrable_mult := ?_
              aestronglyMeasurable_orient := ?_
              orients := ?_ }, ?_, ?_⟩
    · -- `η(M) ⊆ η(M₀) ∪ ⋃ⱼ range (η ∘ Fⱼ)` with `Hⁿ(η(M₀)) = 0` and `η ∘ Fⱼ` Lipschitz
      obtain ⟨M₀, hM₀, F, hF, hcover⟩ := R.rectifiable
      refine ⟨dilation x lam '' M₀, by rw [himage x lam hlam, hM₀, mul_zero],
        fun j => dilation x lam ∘ F j, fun j => ?_, ?_⟩
      · obtain ⟨K, hK⟩ := hF j
        exact ⟨_, ((isometry_add_left (-(lam⁻¹ • x))).lipschitzWith.comp
          (dilationCLM P lam).lipschitzWith).comp hK⟩
      · rintro _ ⟨y, hy, rfl⟩
        rcases hcover hy with h0 | h1
        · exact Or.inl ⟨y, h0, rfl⟩
        · obtain ⟨j, w, rfl⟩ := mem_iUnion.mp h1
          exact Or.inr (mem_iUnion.mpr ⟨j, w, rfl⟩)
    · rintro _ ⟨y, hy, rfl⟩
      show 0 < R.mult (x + lam • dilation x lam y)
      rw [hιη]
      exact R.mult_pos y hy
    · -- `η(M) ∩ K = η(M ∩ η⁻¹(K))`, and `η⁻¹(K)` is compact
      intro K hK _
      rw [← image_inter_preimage, hlint]
      simp only [hιη]
      refine ENNReal.mul_ne_top ENNReal.ofReal_ne_top
        (R.locallyIntegrable_mult _ ?_ (subset_univ _))
      rw [← hη]
      exact η.isCompact_preimage.mpr hK
    · rw [hkey]
      refine (hme.aestronglyMeasurable_map_iff.mpr ?_).smul_measure c
      simpa [Function.comp_def, hιη] using R.aestronglyMeasurable_orient
    · rw [hkey]
      refine Measure.ae_smul_measure (hme.ae_map_iff.mpr (R.orients.mono fun y hy => ?_)) c
      obtain ⟨Q, hQ, hξ⟩ := hy
      exact ⟨Q, htan y Q hQ, by simpa [hιη] using hξ⟩
    · -- `η_#C(ω) = λ⁻ⁿ C(ω ∘ η) = λ⁻ⁿ ∫_M θ ⟨ω ∘ η, ξ⟩ dHⁿ = ∫_{η(M)} θ' ⟨ω, ξ'⟩ dHⁿ`
      intro ω
      obtain ⟨ω', hω'⟩ := hpull ω
      rw [hblow ω ω' hω', hR ω']
      simp only [IMRep.action]
      rw [hint]
      congr 1
      refine setIntegral_congr_fun R.measurableSet_carrier fun y _ => ?_
      simp [hιη, hω']
    · -- `μ_{Rb}(B) = c ∫_{η⁻¹(B)} θ d(Hⁿ⌞M) = c μ_R(η⁻¹(B))`
      intro s hs
      simp only [IMRep.measure]
      rw [withDensity_apply _ hs, withDensity_apply _ (hme.measurable hs), hkey,
        Measure.restrict_smul, hme.restrict_map, lintegral_smul_measure, hme.lintegral_map]
      simp [hιη]
  -- Step 2 (local finiteness): `μ_{R₀}(K) = ∫_{M ∩ K} θ dHⁿ < ∞` for compact `K ⊆ U`
  have hfin : ∀ (U : Set (Euclid P)) (R₀ : IMRep U n) (K : Set (Euclid P)), IsCompact K →
      K ⊆ U → R₀.measure K < ∞ := by
    intro U R₀ K hK hKU
    rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
      Measure.restrict_restrict hK.measurableSet, inter_comm]
    exact lt_top_iff_ne_top.2 (R₀.locallyIntegrable_mult K hK hKU)
  -- Step 3 (cone scaling): `μ_R(cB) = cⁿ μ_R(B)`.  As `η_{0,c#}C = C`, the representation of
  -- `η_{0,c#}C` from Step 1, read in `ℝᴾ`, represents `C`, so its weight is `μ_R`; and
  -- `η_{0,c}⁻¹(B) = cB`
  have hhom : ∀ c : ℝ, 0 < c → ∀ B : Set (Euclid P), MeasurableSet B →
      R.measure ((fun x => c • x) '' B) = ENNReal.ofReal (c ^ n) * R.measure B := by
    intro c hc B hB
    obtain ⟨Rc, hRc, hRcm⟩ := hrep 0 c hc
    have hU := hsurj 0 c hc
    let Rc' : IMRep (univ : Set (Euclid P)) n :=
      { carrier := Rc.carrier
        mult := Rc.mult
        orient := Rc.orient
        measurableSet_carrier := Rc.measurableSet_carrier
        carrier_subset := subset_univ _
        rectifiable := Rc.rectifiable
        measurable_mult := Rc.measurable_mult
        mult_pos := Rc.mult_pos
        locallyIntegrable_mult := fun K hK _ =>
          Rc.locallyIntegrable_mult K hK (by rw [hU]; exact subset_univ K)
        aestronglyMeasurable_orient := Rc.aestronglyMeasurable_orient
        orients := Rc.orients }
    have hRc' : Rc'.Represents C := by
      intro ω
      have hω : IsTestForm (ω : DifferentialForm (Euclid P) n) ∧
          tsupport (ω : DifferentialForm (Euclid P) n) ⊆ dilation 0 c '' univ :=
        ⟨ω.2.1, by rw [hU]; exact subset_univ _⟩
      rw [← hcone c hc ω, currentEval, dite_eq_left hω]
      exact hRc ⟨(ω : DifferentialForm (Euclid P) n), hω⟩
    have heq : Rc.measure = R.measure :=
      Submission.imrep_measure_eq_of_represents_same_current P n univ C Rc' R isOpen_univ hRc' hR
    have hpre : dilation (0 : Euclid P) c ⁻¹' B = (fun x => c • x) '' B := by
      rw [image_eq_preimage_of_inverse (f := fun x : Euclid P => c • x) (g := fun x => c⁻¹ • x)
        (fun x => inv_smul_smul₀ hc.ne' x) (fun x => smul_inv_smul₀ hc.ne' x)]
      ext y
      simp [dilation, dilationCLM]
    have h1 := hRcm B hB
    rw [heq, hpre] at h1
    rw [h1, ← mul_assoc, ← ENNReal.ofReal_mul (pow_nonneg hc.le n), ← mul_pow,
      mul_inv_cancel₀ hc.ne', one_pow, ENNReal.ofReal_one, one_mul]
  -- representations `Rⱼ` of the blow-ups; (*) `∫ g dμⱼ → ∫ g dμ_{R'}` for `g ∈ C_c`
  choose Rs hRs hRsm using fun j => hrep p (lams j) (hlams j)
  have hconv' : ∀ g : Euclid P → ℝ, Continuous g → HasCompactSupport g →
      Tendsto (fun j => ∫ x, g x ∂(Rs j).measure) atTop (𝓝 (∫ x, g x ∂R'.measure)) :=
    fun g hg hgc => hconv Rs hRs R' hR' g hg hgc (subset_univ _)
  have hfinj : ∀ j, ∀ K : Set (Euclid P), IsCompact K → (Rs j).measure K < ∞ := fun j K hK =>
    hfin _ (Rs j) K hK (by rw [hsurj p (lams j) (hlams j)]; exact subset_univ K)
  -- Step 4: `∫ f(y − tp) dμ_{R'} = ∫ f dμ_{R'}` for `f ∈ C_c` and `t ∈ ℝ`
  have hinv : ∀ (t : ℝ) (f : Euclid P → ℝ), Continuous f → HasCompactSupport f →
      ∫ y, f (y - t • p) ∂R'.measure = ∫ y, f y ∂R'.measure := by
    intro t f hf hfc
    have hft : Continuous fun y => f (y - t • p) := hf.comp (continuous_id.sub continuous_const)
    have hftc : HasCompactSupport fun y => f (y - t • p) :=
      hfc.comp_homeomorph (Homeomorph.subRight (t • p))
    -- `sⱼ = 1 + λⱼt → 1`
    have hs : Tendsto (fun j => 1 + lams j * t) atTop (𝓝 1) := by
      simpa using (hlim.mul_const t).const_add 1
    -- (**) `∫ f(y − tp) dμⱼ = sⱼⁿ ∫ f(sⱼy) dμⱼ` once `sⱼ > 0`
    have heq : (fun j => (1 + lams j * t) ^ n * ∫ y, f ((1 + lams j * t) • y) ∂(Rs j).measure)
        =ᶠ[atTop] fun j => ∫ y, f (y - t • p) ∂(Rs j).measure := by
      filter_upwards [hs.eventually (lt_mem_nhds one_pos)] with j hj
      exact (Submission.idtp_cttp_bti_blowup_translate_integral P n R.measure (Rs j).measure p
        (lams j) t (hlams j) hj hhom (hRsm j) f hf).symm
    -- `sⱼⁿ ∫ f(sⱼy) dμⱼ → 1ⁿ ∫ f dμ_{R'}`
    have hlim' := (hs.pow n).mul (Submission.idtp_cttp_bti_rescaled_tests_tendsto P
      (fun j => (Rs j).measure) R'.measure (fun j => 1 + lams j * t) f hfinj hconv' hs hf hfc)
    rw [one_pow, one_mul] at hlim'
    exact tendsto_nhds_unique (hconv' _ hft hftc) (hlim'.congr' heq)
  -- Step 5: `v = ap`; `(τ_v)_#μ_{R'}` and `μ_{R'}` are finite on compact sets, hence regular, and
  -- agree on `C_c` by Step 4 with `t = −a`, so they are equal (Riesz uniqueness)
  obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.1 hv
  have hτ : Measurable fun x : Euclid P => x + a • p :=
    (continuous_id.add continuous_const).measurable
  have : IsFiniteMeasureOnCompacts R'.measure := ⟨fun K hK => hfin _ R' K hK (subset_univ K)⟩
  have : IsFiniteMeasureOnCompacts (R'.measure.map fun x => x + a • p) := ⟨fun K hK => by
    rw [Measure.map_apply hτ hK.measurableSet]
    exact hfin _ R' _ ((Homeomorph.addRight (a • p)).isCompact_preimage.2 hK) (subset_univ _)⟩
  have hmeq : R'.measure.map (fun x => x + a • p) = R'.measure := by
    refine Measure.ext_of_integral_eq_on_compactlySupported fun g => ?_
    rw [integral_map hτ.aemeasurable (map_continuous g).aestronglyMeasurable]
    simpa using hinv (-a) g (map_continuous g) g.hasCompactSupport
  rw [← Measure.map_apply hτ hA, hmeq]

/-- **Vanishing boundary gives the ambient weak-derivative identity** (the zero weak derivatives
step of the planar constancy argument, after Simon 6.2.34).  Let `∂S = 0` in `V` and
`S(ω) = ∫_{V ∩ Q} g(x) ω(x)(τ₁, …, τₙ) dHⁿ(x)` for an orthonormal family `τ` with `Q = span τ`.
Then `∫_{V ∩ Q} g · D_{τⱼ} f dHⁿ = 0` for every smooth compactly supported `f` with
`spt f ⊆ V`: test `∂S = 0` against `φ = f · α`, where `α(w) = β(⟨τ, w⟩)` pulls back the
coordinate covector `β = eⱼ ⌟ δ`, so that `dφ(x)(τ) = Df(x)(τⱼ)`. -/
theorem Submission.idtp_pc_boundary_weak_derivative : ∀ (P n : ℕ) (V : Set (Euclid P)) (S : GeometricCurrentOn V n) (τ : Fin n → Euclid P) (g : Euclid P → ℝ), 1 ≤ n → Orthonormal ℝ τ → BoundaryVanishes S → (∀ ω : TestFormOn V n, S ω = ∫ x in V ∩ (Submodule.span ℝ (Set.range τ) : Set (Euclid P)), g x * (ω : DifferentialForm (Euclid P) n) x τ ∂μHE[n]) → ∀ f : Euclid P → ℝ, ContDiff ℝ (⊤ : ℕ∞) f → HasCompactSupport f → tsupport f ⊆ V → ∀ j : Fin n, ∫ x in V ∩ (Submodule.span ℝ (Set.range τ) : Set (Euclid P)), g x * fderiv ℝ f x (τ j) ∂μHE[n] = 0 := by
  intro P n V S τ g hn hτ hbd hrep f hf hfc hfV j
  -- Degree: `n = m + 1`, so `BoundaryVanishes S` is `∂S = 0`.
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  have hbd' : S.boundary = 0 := hbd
  -- The coordinate covector `β` on `ℝ^{m+1}` and its pullback `α` by `y ↦ (⟨τₖ, y⟩)ₖ`.
  obtain ⟨β, hβ⟩ := Submission.dgcr_bwd_coordinate_covector m j
  let Ls₀ : Euclid P →ₗ[ℝ] Euclid (m + 1) :=
    { toFun := fun y => (WithLp.equiv 2 (Fin (m + 1) → ℝ)).symm (fun k => inner ℝ (τ k) y)
      map_add' := fun y z => by ext k; simp [inner_add_right]
      map_smul' := fun c y => by ext k; simp [inner_smul_right] }
  let Ls : Euclid P →L[ℝ] Euclid (m + 1) := LinearMap.toContinuousLinearMap Ls₀
  have hLsτ : ∀ i, Ls (τ i) = EuclideanSpace.single i (1 : ℝ) := by
    intro i
    ext k
    simp [Ls, Ls₀, orthonormal_iff_ite.mp hτ, eq_comm]
  let α : Covector (Euclid P) m := β.compContinuousLinearMap Ls
  have hα : ∀ i : Fin (m + 1), α (i.removeNth τ) = if i = j then (-1 : ℝ) ^ (j : ℕ) else 0 := by
    intro i
    have : (fun l => Ls (i.removeNth τ l)) =
        i.removeNth (fun l : Fin (m + 1) => EuclideanSpace.single l (1 : ℝ)) := by
      funext l
      simp [Fin.removeNth_apply, hLsτ]
    show β (fun l => Ls (i.removeNth τ l)) = _
    rw [this, hβ i]
  -- The test form `φ = f · α ∈ 𝒟^m(V)`.
  let φ : DifferentialForm (Euclid P) m := fun y => f y • α
  have hφtest : IsTestForm φ ∧ tsupport φ ⊆ V := by
    refine ⟨⟨?_, ?_⟩, ?_⟩
    · exact hf.smul contDiff_const
    · exact hfc.smul_right
    · exact (tsupport_smul_subset_left _ _).trans hfV
  let φt : TestFormOn V m := ⟨φ, hφtest⟩
  -- `dφ(x)(τ) = Σᵢ (−1)ⁱ Df(x)(τᵢ) α(τ without τᵢ) = Df(x)(τⱼ)`.
  have hd : ∀ x, exteriorDerivative φ x τ = fderiv ℝ f x (τ j) := by
    intro x
    have hfd : DifferentiableAt ℝ f x := (hf.differentiable (by simp)).differentiableAt
    rw [exteriorDerivative_apply (hfd.smul_const α) τ]
    have h1 : ∀ i : Fin (m + 1),
        (fun y => (f y • α) (i.removeNth τ)) = fun y => f y * α (i.removeNth τ) := by
      intro i; funext y; simp [smul_eq_mul]
    simp only [h1]
    simp only [fderiv_mul_const hfd, hα]
    rw [Finset.sum_eq_single j]
    · simp only [ite_true]
      rw [zsmul_eq_mul]
      push_cast
      simp only [Pi.smul_apply, smul_eq_mul]
      rw [← mul_assoc, ← pow_add, ← two_mul, pow_mul]
      simp
    · intro i _ hij
      simp [hij]
    · simp
  -- `0 = ∂S(φ) = S(dφ) = ∫_{V ∩ Q} g · dφ(τ) dHⁿ = ∫_{V ∩ Q} g · D_{τⱼ} f dHⁿ`.
  have h0 : S.boundary φt = 0 := by rw [hbd']; rfl
  rw [GeometricCurrentOn.boundary_apply] at h0
  have h2 := hrep (exteriorDerivativeTestOn V m φt)
  rw [h0] at h2
  rw [h2]
  refine integral_congr_ae (Eventually.of_forall fun x => ?_)
  simp only
  rw [← hd x]
  rfl
/-- Chapter 7 of Simon's *Introduction to GMT*: the headline results above. -/
theorem main_theorem : MinimizingImpliesStationary ∧ ExistenceOfMinimizingFilling ∧ CompactnessOfMinimizingCurrents ∧ DensityAndTangentCones ∧ IntegerDensityAndTangentPlanes ∧ RegularSetDense ∧ DensityOneImpliesRegular ∧ SingularSetSmallWhereDensityBelowTwo ∧ HalfSpaceConeLiesInBoundary ∧ CodimensionOneRegularity ∧ RegularComponentsAreMinimizing := by sorry

theorem Submission.dgcr_bwd_coordinate_form : ∀ (m : ℕ) (a : Euclid (m + 1) → ℝ) (j : Fin (m + 1)), ContDiff ℝ (⊤ : ℕ∞) a → ∃ ψ : DifferentialForm (Euclid (m + 1)) m, IsSmoothForm ψ ∧ tsupport ψ ⊆ tsupport a ∧ ∀ x : Euclid (m + 1), exteriorDerivative ψ x (fun i => EuclideanSpace.single i (1 : ℝ)) = fderiv ℝ a x (EuclideanSpace.single j (1 : ℝ)) := by
  intro m a j ha
  obtain ⟨β, hβ⟩ := Submission.dgcr_bwd_coordinate_covector m j
  refine ⟨fun y => a y • β, ha.smul contDiff_const, tsupport_smul_subset_left _ _, fun x => ?_⟩
  have hax : DifferentiableAt ℝ a x := (ha.differentiable (by simp)).differentiableAt
  rw [Submission.dgcr_bwd_extDeriv_smul_const (m + 1) m a β x _ hax, Finset.sum_eq_single j]
  · rw [hβ j, ite_eq_left rfl, ← mul_assoc, mul_comm ((-1 : ℝ) ^ (j : ℕ)), mul_assoc, ← pow_add,
      ← two_mul, pow_mul]
    simp
  · intro i _ hij
    rw [hβ i, ite_eq_right hij]
    simp
  · intro hj
    exact absurd (Finset.mem_univ j) hj
/-- **Weak derivatives of a top-dimensional density vanish** (steps 3–5 of the Constancy Theorem,
Simon Ch. 6, 2.34).  Let `X(ω) = ∫ G ⟨ω, e₁ ∧ ⋯ ∧ e_{m+1}⟩ dL^{m+1}` on `V ⊆ ℝ^{m+1}` with `∂X = 0`
on test forms supported in `B ⊆ V`.  Then `∫_B G ∂ⱼa = 0` for every `a ∈ C_c^∞` with `spt a ⊆ B`:
`ψ = a γⱼ` is an `m`-test form with `spt ψ ⊆ spt a ⊆ B` and `dψ(e₁, …, e_{m+1}) = ∂ⱼa`, so
`0 = ∂X(ψ) = X(dψ) = ∫ G ∂ⱼa`, and `G ∂ⱼa` vanishes off `spt a ⊆ B`. -/
theorem Submission.dtc_bc_cz_tc_weak_derivs : ∀ (m : ℕ) (V B : Set (Euclid (m + 1))) (X : GeometricCurrentOn V (m + 1)) (G : Euclid (m + 1) → ℝ), B ⊆ V → (∀ β : TestFormOn V m, tsupport (β : DifferentialForm (Euclid (m + 1)) m) ⊆ B → X.boundary β = 0) → (∀ ω : TestFormOn V (m + 1), X ω = ∫ y, G y * (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) y ⇑(EuclideanSpace.basisFun (Fin (m + 1)) ℝ)) → ∀ a : Euclid (m + 1) → ℝ, ContDiff ℝ (⊤ : ℕ∞) a → HasCompactSupport a → tsupport a ⊆ B → ∀ j : Fin (m + 1), ∫ v in B, G v * fderiv ℝ a v (EuclideanSpace.single j (1 : ℝ)) = 0 := by
  intro m V B X G hBV hbdry hrep a ha hacpt haB j
  -- `ψ = a γⱼ` is smooth, `spt ψ ⊆ spt a` and `dψ(e₁, …, e_{m+1}) = ∂ⱼa`
  obtain ⟨ψ, hψs, hψsupp, hψd⟩ := Submission.dgcr_bwd_coordinate_form m a j ha
  -- `spt ψ` is a closed subset of the compact set `spt a ⊆ B ⊆ V`: `ψ` is a test form in `V`
  have hψc : HasCompactSupport ψ :=
    IsCompact.of_isClosed_subset hacpt (isClosed_tsupport ψ) hψsupp
  let β : TestFormOn V m := ⟨ψ, ⟨⟨hψs, hψc⟩, hψsupp.trans (haB.trans hBV)⟩⟩
  -- `0 = ∂X(ψ) = X(dψ) = ∫ G ⟨dψ, e₁ ∧ ⋯ ∧ e_{m+1}⟩`
  have h0 : X.boundary β = 0 := hbdry β (hψsupp.trans haB)
  rw [GeometricCurrentOn.boundary_apply, hrep] at h0
  have hbasis : ⇑(EuclideanSpace.basisFun (Fin (m + 1)) ℝ) =
      fun i => EuclideanSpace.single i (1 : ℝ) := by
    funext i
    simp
  -- hence `∫ G ∂ⱼa = 0`
  have h1 : ∫ y, G y * fderiv ℝ a y (EuclideanSpace.single j (1 : ℝ)) = 0 := by
    rw [← h0]
    congr 1
    funext y
    change G y * fderiv ℝ a y (EuclideanSpace.single j (1 : ℝ)) =
      G y * exteriorDerivative ψ y ⇑(EuclideanSpace.basisFun (Fin (m + 1)) ℝ)
    rw [hbasis, hψd y]
  -- `G ∂ⱼa` vanishes off `spt a ⊆ B`, so `∫_B G ∂ⱼa = ∫ G ∂ⱼa`
  rw [setIntegral_eq_integral_of_forall_compl_eq_zero]
  · exact h1
  · intro v hv
    have hva : v ∉ tsupport a := fun h => hv (haB h)
    simp [fderiv_of_notMem_tsupport ℝ hva]
/-- **Mollification approximates a `C¹_c` function in a directional derivative** (step 3 of the
extension from smooth to `C¹` tests in the graph-cycle regularity step of Simon 7.4.3).  For
`φ ∈ C¹_c(ℝⁿ)`, `δ > 0`, a direction `v` and `ε > 0` there is `ψ ∈ C^∞_c(ℝⁿ)` with `spt ψ` in the
closed `δ`-neighbourhood of `spt φ` and `|Dψ(x)v − Dφ(x)v| ≤ ε` for all `x`.  Take `r₀ > 0` with
`|∂ᵥφ(a) − ∂ᵥφ(b)| < ε` when `|a − b| < r₀` (`∂ᵥφ` is continuous with compact support), a
normalized mollifier `ρ` with `spt ρ ⊆ B_r(0)`, `r = min r₀ δ`, and `ψ = ρ ⋆ φ`; then
`∂ᵥψ = ρ ⋆ ∂ᵥφ`, which is within `ε` of `∂ᵥφ`. -/
theorem Submission.dgcr_stc_mollify_C1_fderiv_approx : ∀ (n : ℕ) (φ : Euclid n → ℝ), ContDiff ℝ 1 φ → HasCompactSupport φ → ∀ (δ : ℝ), 0 < δ → ∀ (v : Euclid n) (ε : ℝ), 0 < ε → ∃ ψ : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) ψ ∧ HasCompactSupport ψ ∧ tsupport ψ ⊆ cthickening δ (tsupport φ) ∧ ∀ x, |fderiv ℝ ψ x v - fderiv ℝ φ x v| ≤ ε := by
  intro n φ hφ hφc δ hδ v ε hε
  -- `∂ᵥφ = Dφ(·) v` is continuous with compact support, hence uniformly continuous: it varies by
  -- less than `ε` on balls of radius `r₀`
  have hDφ : Continuous (fderiv ℝ φ) := hφ.continuous_fderiv one_ne_zero
  have hDφc : HasCompactSupport (fderiv ℝ φ) := hφc.fderiv ℝ
  have hg : Continuous fun x => fderiv ℝ φ x v := hDφ.clm_apply continuous_const
  have hgc : HasCompactSupport fun x => fderiv ℝ φ x v :=
    hDφc.comp_left (g := fun A : Euclid n →L[ℝ] ℝ => A v) rfl
  obtain ⟨r₀, hr₀, hr₀g⟩ :=
    Metric.uniformContinuous_iff.mp (hgc.uniformContinuous_of_continuous hg) ε hε
  -- a normalized mollifier `ρ` with `spt ρ ⊆ B_r(0)`, `r = min r₀ δ`; `ψ = ρ ⋆ φ`
  obtain ⟨ρ, hρ, hρc, hρ0, hρ1, hρs⟩ :=
    Submission.dgcr_stc_exists_normalized_mollifier n (min r₀ δ) (lt_min hr₀ hδ)
  have hρi : LocallyIntegrable ρ volume := hρ.continuous.locallyIntegrable
  let L := ContinuousLinearMap.lsmul ℝ ℝ (E := ℝ)
  -- `spt ψ ⊆ spt ρ + spt φ ⊆ B_r(0) + spt φ`, inside the closed set `cthickening δ (spt φ)`
  have hsupp : tsupport (convolution ρ φ L volume) ⊆ cthickening δ (tsupport φ) := by
    refine closure_minimal (fun z hz => ?_) isClosed_cthickening
    obtain ⟨a, ha, b, hb, rfl⟩ := Set.mem_add.mp (support_convolution_subset L hz)
    refine mem_cthickening_of_dist_le _ b δ _ (subset_tsupport φ hb) ?_
    rw [dist_eq_norm, add_sub_cancel_right]
    exact (mem_ball_zero_iff.mp (hρs ha)).le.trans (min_le_right r₀ δ)
  -- `ψ` is smooth, and compactly supported as `cthickening δ (spt φ)` is compact
  refine ⟨convolution ρ φ L volume,
    hρc.contDiff_convolution_left L hρ hφ.continuous.locallyIntegrable,
    (IsCompact.cthickening hφc).of_isClosed_subset (isClosed_tsupport _) hsupp, hsupp, fun x => ?_⟩
  -- `Dψ(x) v = (ρ ⋆ ∂ᵥφ)(x)`
  rw [(hφc.hasFDerivAt_convolution_right L hρi hφ x).fderiv,
    convolution_precompR_apply L hρi hDφc hDφ x v, ← Real.dist_eq]
  -- `ρ ≥ 0`, `∫ ρ = 1`, `spt ρ ⊆ B_r(0)` and `|∂ᵥφ(y) − ∂ᵥφ(x)| < ε` on `B_r(x)`
  exact dist_convolution_le hε.le hρs hρ0 hρ1 hg.aestronglyMeasurable fun y hy =>
    (hr₀g ((mem_ball.mp hy).trans_le (min_le_left r₀ δ))).le

/-- Step 14 of the proof that an integer multiplicity cycle carried by a `C¹` graph is regular
(Simon 7.4.3, via Allard's theorem): weak derivatives tested against `C^∞` functions may be
tested against `C¹` functions.  If `∫_D G ∂ⱼa = 0` for every `a ∈ C_c^∞(D)`, then `∫ G ∂ᵢφ = 0`
for every `φ ∈ C_c¹(D)`.  On the compact set `K = cthickening δ (spt φ) ⊆ D`, `G` is integrable
and `∂ᵢφ` is bounded.  The mollified tests `ψ` satisfy `spt ψ ⊆ K` and `|∂ᵢψ − ∂ᵢφ| ≤ ε`, so
`∫_K G ∂ᵢφ = 0` in the limit; every integrand vanishes off `K`. -/
theorem Submission.dgcr_smooth_tests_to_C1_tests : ∀ (n : ℕ) (D : Set (Euclid n)) (G : Euclid n → ℝ), IsOpen D → LocallyIntegrableOn G D volume → (∀ a : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) a → HasCompactSupport a → tsupport a ⊆ D → ∀ j : Fin n, ∫ v in D, G v * fderiv ℝ a v (EuclideanSpace.single j (1 : ℝ)) = 0) → ∀ φ : Euclid n → ℝ, ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∀ i : Fin n, ∫ x, G x * fderiv ℝ φ x ((EuclideanSpace.basisFun (Fin n) ℝ) i) = 0 := by
  intro n D G hD hG htest φ hφ hφc hφD i
  rw [EuclideanSpace.basisFun_apply]
  -- step 1: `K = cthickening δ (tsupport φ) ⊆ D` is compact and `G` is integrable on `K`
  obtain ⟨δ, hδ, hKD⟩ := hφc.isCompact.exists_cthickening_subset_open hD hφD
  have hK : IsCompact (cthickening δ (tsupport φ)) := hφc.isCompact.cthickening
  have hGK : IntegrableOn G (cthickening δ (tsupport φ)) volume :=
    hG.integrableOn_compact_subset hKD hK
  -- `G ∂ᵢu` vanishes off `K` when `tsupport u ⊆ K`
  have hvan : ∀ u : Euclid n → ℝ, tsupport u ⊆ cthickening δ (tsupport φ) →
      ∀ x ∉ cthickening δ (tsupport φ), G x * fderiv ℝ u x (EuclideanSpace.single i 1) = 0 :=
    fun u hu x hx => by rw [fderiv_of_notMem_tsupport ℝ fun h => hx (hu h), zero_apply, mul_zero]
  -- step 2: `∂ᵢφ` is continuous, hence bounded on `K`
  have hf : Continuous fun x => fderiv ℝ φ x (EuclideanSpace.single i 1) :=
    (hφ.continuous_fderiv one_ne_zero).clm_apply continuous_const
  obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn hf.continuousOn
  -- step 3: the integral over `ℝⁿ` is the integral over `K`
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero (hvan φ (self_subset_cthickening _))]
  -- step 4: smooth tests `ψ` with `tsupport ψ ⊆ K` approximate `∂ᵢφ` uniformly on `K`
  refine Submission.dgcr_stc_setIntegral_mul_eq_zero_of_uniform_approx n
    (cthickening δ (tsupport φ)) G (fun x => fderiv ℝ φ x (EuclideanSpace.single i 1)) C
    isClosed_cthickening.measurableSet hGK hf.aestronglyMeasurable
    (fun x hx => (Real.norm_eq_abs _).symm.trans_le (hC x hx)) fun ε hε => ?_
  obtain ⟨ψ, hψ, hψc, hψK, hψε⟩ := Submission.dgcr_stc_mollify_C1_fderiv_approx n φ hφ hφc δ hδ
    (EuclideanSpace.single i 1) ε hε
  refine ⟨fun x => fderiv ℝ ψ x (EuclideanSpace.single i 1),
    ((hψ.continuous_fderiv (by simp)).clm_apply continuous_const).aestronglyMeasurable,
    fun x _ => (abs_sub_comm _ _).trans_le (hψε x), ?_⟩
  -- `∫_K G ∂ᵢψ = ∫ G ∂ᵢψ = ∫_D G ∂ᵢψ`, which vanishes as `ψ` is a smooth test in `D`
  have hvanD : ∀ x ∉ D, G x * fderiv ℝ ψ x (EuclideanSpace.single i 1) = 0 :=
    fun x hx => hvan ψ hψK x fun h => hx (hKD h)
  rw [setIntegral_eq_integral_of_forall_compl_eq_zero (hvan ψ hψK),
    ← setIntegral_eq_integral_of_forall_compl_eq_zero hvanD]
  exact htest ψ hψ hψc (hψK.trans hKD) i

/-- **Constancy theorem in top dimension** (Simon Ch. 6, Theorem 2.34, for `n`-currents in
`ℝⁿ`; Lemma B of the codimension-zero blow-up step).  Let `X ∈ 𝒟ₙ(V)`, `n = m + 1`, be integer
multiplicity and `B ⊆ V` open and connected with `∂X = 0` in `B`.  Then `X = c[[B]]` in `B` for
some `c ∈ ℤ`: `X(ω) = c ∫ ω(e₁, …, eₙ) dLⁿ` whenever `spt ω ⊆ B`.  `X(ω) = ∫ g ω(e) dLⁿ` for an
integer-valued `L¹_loc` density `g`; `∂X = 0` in `B` kills the weak derivatives of `g` against
`C_c^∞(B)` tests, hence (by mollification) against `C_c¹(B)` tests, and distributional constancy
gives `g = c₀` a.e. on `B`.  `B` has positive measure unless empty, so `c₀ ∈ ℤ`. -/
theorem Submission.dtc_bc_cz_top_constancy : ∀ (m : ℕ) (V B : Set (Euclid (m + 1))) (X : GeometricCurrentOn V (m + 1)), IsOpen V → IsIntegerMultiplicity X → IsOpen B → IsPreconnected B → B ⊆ V → (∀ β : TestFormOn V m, tsupport (β : DifferentialForm (Euclid (m + 1)) m) ⊆ B → X.boundary β = 0) → ∃ c : ℤ, ∀ ω : TestFormOn V (m + 1), tsupport (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) ⊆ B → X ω = (c : ℝ) * ∫ y, (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) y ⇑(EuclideanSpace.basisFun (Fin (m + 1)) ℝ) := by
  intro m V B X hV hIM hB hBc hBV hbd
  -- step 1: the integer density `g` of `X`, `X(ω) = ∫ g ω(e) dLⁿ`
  obtain ⟨g, hgloc, hrep⟩ := Submission.dtc_bc_cz_top_density (m + 1) V X m.succ_pos hV hIM
  -- steps 2–5: `∂X = 0` in `B` gives `∫_B g ∂ⱼa = 0` for every `a ∈ C_c^∞(B)`
  have hweak := Submission.dtc_bc_cz_tc_weak_derivs m V B X (fun y => (g y : ℝ)) hBV hbd hrep
  -- step 6: `C¹` tests by mollification; distributional constancy gives `g = c₀` a.e. on `B`
  have hgB : LocallyIntegrableOn (fun y => (g y : ℝ)) B volume := hgloc.mono_set hBV
  obtain ⟨c₀, hc₀⟩ : ∃ c₀ : ℝ, ∀ᵐ y ∂(volume.restrict B), (g y : ℝ) = c₀ :=
    Poincare.SimonGMT.Chapter08.ae_eq_const_of_weak_coordinate_derivatives_zero hgB hB hBc
      (Submission.dgcr_smooth_tests_to_C1_tests (m + 1) B _ hB hgB hweak)
  -- step 7: the constant is an integer, `g(y₀)` for some `y₀ ∈ B` (any `c` if `B = ∅`)
  obtain ⟨c, hc⟩ : ∃ c : ℤ, ∀ᵐ y ∂(volume.restrict B), (g y : ℝ) = c := by
    rcases B.eq_empty_or_nonempty with rfl | hne
    · exact ⟨0, by simp⟩
    obtain ⟨y₀, -, hy₀⟩ :=
      Measure.exists_mem_of_measure_ne_zero_of_ae (hB.measure_pos volume hne).ne' hc₀
    refine ⟨g y₀, ?_⟩
    filter_upwards [hc₀] with y hy
    rw [hy, hy₀]
  -- step 8: `X(ω) = ∫ g ω(e) = c ∫ ω(e)`, as `ω = 0` off `B`
  refine ⟨c, fun ω hω => ?_⟩
  rw [hrep ω, ← integral_const_mul]
  refine integral_congr_ae ?_
  filter_upwards [(ae_restrict_iff' hB.measurableSet).mp hc] with y hy
  by_cases hyB : y ∈ B
  · rw [hy hyB]
  · rw [image_eq_zero_of_notMem_tsupport fun h => hyB (hω h)]
    simp

/-- **Simon 7.1.1 in codimension zero.**  If `n ≥ 1` and `C ∈ 𝒟ₙ(ℝⁿ)` is integer multiplicity,
then `C` is minimizing in every `A ⊆ ℝⁿ`; in fact every competitor equals `C`.  For a competitor
`S`, the current `X = S − C` is integer multiplicity (Simon 6.3.2(1)) with `∂X = ∂S − ∂C = 0`, so
the Constancy Theorem (6.2.34) gives `X = c[[ℝⁿ]]` with `c ∈ ℤ`.  As `spt X` is compact, testing
`X` with a bump form supported away from `spt X` forces `c = 0`.  Hence `S = C` and
`M_W(C) = M_W(S)`. -/
theorem Submission.dtc_bc_cz_isMinimizingIn : ∀ (n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid n)) n) (A : Set (Euclid n)), 0 < n → IsIntegerMultiplicity C → IsMinimizingIn C A := by
  intro n C A hn hC
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  refine ⟨hC, fun W S _ _ hS hbd hcpt _ => ?_⟩
  -- 1. `X = S − C` is an integer multiplicity cycle in `ℝⁿ`
  have hX : IsIntegerMultiplicity (S - C) :=
    Submission.dtc_isIntegerMultiplicity_sub (m + 1) (m + 1) univ S C isOpen_univ hn hS hC
  have hcycle : ∀ β : TestFormOn (univ : Set (Euclid (m + 1))) m,
      tsupport (β : DifferentialForm (Euclid (m + 1)) m) ⊆ univ → (S - C).boundary β = 0 := by
    intro β _
    have hbd' : S.boundary = C.boundary := hbd
    show S.boundary β - C.boundary β = 0
    rw [hbd', sub_self]
  -- 2. Constancy Theorem on `ℝⁿ`: `X = c[[ℝⁿ]]` with `c ∈ ℤ`
  obtain ⟨c, hc⟩ := Submission.dtc_bc_cz_top_constancy m univ univ (S - C) isOpen_univ hX
    isOpen_univ isPreconnected_univ Subset.rfl hcycle
  -- 3. `spt X` is compact, so `c = 0`
  have hc0 : (c : ℝ) = 0 := Submission.dtc_bc_cz_isMinimizingIn_const_eq_zero (m + 1) (S - C) c
    hn hcpt fun ω => hc ω (subset_univ _)
  -- 4. hence `S = C`, and `M_W(C) = M_W(S)`
  have hSC : S = C := by
    ext ω
    have h : (S - C) ω = 0 := by rw [hc ω (subset_univ _), hc0, zero_mul]
    exact sub_eq_zero.mp h
  rw [hSC]

/-- **Blow-ups of a top-dimensional current away from `spt ∂T`** (step 1 of the proof of
Simon 7.3.1(2) in the case `k = 0`, via the Constancy Theorem, Simon 6.2.34).  Let `n ≥ 1`,
`T ∈ 𝒟ₙ(U)` integer multiplicity in the open set `U ⊆ ℝⁿ`, `x ∈ U ∖ spt ∂T` and `λⱼ ↓ 0`.  As `x`
lies in the zero region of `∂T`, `∂T = 0` in a ball `B_r(x) ⊆ U`, so `T = c[[ℝⁿ]]` in `B_r(x)`
for some `c ∈ ℤ` (constancy).  `C = c[[ℝⁿ]]` is integer multiplicity, hence minimizing in `ℝⁿ`.
In `B_{r/λⱼ}(0) = η_{x,λⱼ}(B_r(x))`, which eventually contains every ball `B_R(0)`,
`η_{x,λⱼ#}T = C` and `∂η_{x,λⱼ#}T = 0`; local agreement on these balls gives `η_{x,λⱼ#}T ⇀ C`,
`μ_{η_{x,λⱼ#}T} → μ_C` (locality of the weight measure) and `∂C = 0`. -/
theorem Submission.dtc_bc_codim_zero : ∀ (n : ℕ) (U : Set (Euclid n)) (T : GeometricCurrentOn U n) (x : Euclid n), 0 < n → IsOpen U → IsIntegerMultiplicity T → x ∈ U → x ∉ boundarySupport T → ∀ (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), Tendsto lams atTop (𝓝 0) → ∃ C : GeometricCurrentOn (univ : Set (Euclid n)) n, ConvergesWeakly (fun j => blowUp T x (lams j) (hlams j).ne') C ∧ MassMeasuresConverge (fun j => blowUp T x (lams j) (hlams j).ne') C ∧ IsMinimizingIn C univ ∧ BoundaryVanishes C := by
  intro n U T x hn hU hT hxU hx lams hlams hlim
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  -- step 3: `x ∉ spt ∂T` puts `x` in the zero region of `∂T`, so `∂T = 0` in a ball `B_r(x) ⊆ U`
  have hxZ : x ∈ T.boundary.zeroRegion := by
    by_contra h
    exact hx ((mem_sdiff x).2 ⟨hxU, h⟩)
  obtain ⟨W, ⟨hWo, -, hWU, hWv⟩, hxW⟩ := mem_sUnion.1 hxZ
  obtain ⟨r, hr, hrW⟩ := Metric.isOpen_iff.1 hWo x hxW
  have hrU : ball x r ⊆ U := hrW.trans (subset_closure.trans hWU)
  have hTb : ∀ β : TestFormOn U m, tsupport (β : DifferentialForm (Euclid (m + 1)) m) ⊆ ball x r →
      T.boundary β = 0 := fun β hβ => hWv β (hβ.trans hrW)
  -- steps 1–3: `T = c[[ℝⁿ]]` in `B_r(x)` for some `c ∈ ℤ` (constancy theorem)
  obtain ⟨c, hTc⟩ := Submission.dtc_bc_cz_top_constancy m U (ball x r) T hU hT isOpen_ball
    (convex_ball x r).isPreconnected hrU hTb
  -- step 4: the limit `C = c[[ℝⁿ]]` is integer multiplicity
  obtain ⟨C, hCim, hC⟩ := Submission.dtc_bc_cz_unit_current (m + 1) c hn
  -- `η_{x,λ}(y) = λ⁻¹(y − x)`, so the domains `η_{x,λⱼ}(U)` are open
  have hdil : ∀ (lam : ℝ) (y : Euclid (m + 1)), dilation x lam y = lam⁻¹ • (y - x) := by
    intro lam y
    simp only [dilation, dilationCLM, smul_apply, ContinuousLinearMap.id_apply]
    rw [smul_sub, neg_add_eq_sub]
  have hopen : ∀ j, IsOpen (dilation x (lams j) '' U) := by
    intro j
    rw [show dilation x (lams j) = (fun y => (lams j)⁻¹ • y) ∘ fun y => y - x from
      funext (hdil (lams j))]
    exact (isOpenMap_smul₀ (inv_ne_zero (hlams j).ne')).comp (isOpenMap_sub_right x) U hU
  -- steps 5 and 7: for large `j`, `B_R(0) ⊆ B_{r/λⱼ}(0) ⊆ η_{x,λⱼ}(U)`, and in `B_{r/λⱼ}(0)`
  -- `η_{x,λⱼ#}T = c[[ℝⁿ]] = C` and `∂η_{x,λⱼ#}T = 0`
  have hev : ∀ R : ℝ, ∀ᶠ j in atTop, ball (0 : Euclid (m + 1)) R ⊆ dilation x (lams j) '' U ∧
      (∀ ω : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1),
        tsupport (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) ⊆ ball 0 R →
          currentEval (blowUp T x (lams j) (hlams j).ne')
            (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) = C ω) ∧
      ∀ β : TestFormOn (dilation x (lams j) '' U) m,
        tsupport (β : DifferentialForm (Euclid (m + 1)) m) ⊆ ball 0 R →
          (blowUp T x (lams j) (hlams j).ne').boundary β = 0 := by
    intro R
    have hR1 : 0 < |R| + 1 := by positivity
    filter_upwards [(tendsto_order.1 hlim).2 _ (div_pos hr hR1)] with j hj
    have hlam := hlams j
    -- `R ≤ r / λⱼ` since `λⱼ (|R| + 1) < r`
    have hRr : ball (0 : Euclid (m + 1)) R ⊆ ball 0 (r / lams j) := by
      refine ball_subset_ball ?_
      rw [le_div_iff₀ hlam]
      rw [lt_div_iff₀ hR1] at hj
      nlinarith [le_abs_self R]
    -- `B_{r/λ}(0) = η_{x,λ}(B_r(x)) ⊆ η_{x,λ}(U)`
    have hball : ball (0 : Euclid (m + 1)) (r / lams j) ⊆ dilation x (lams j) '' U := by
      intro z hz
      rw [mem_ball_zero_iff, lt_div_iff₀ hlam] at hz
      refine ⟨x + lams j • z, hrU ?_, ?_⟩
      · rw [mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hlam.le]
        linarith [mul_comm (lams j) ‖z‖]
      · rw [hdil, add_sub_cancel_left, smul_smul, inv_mul_cancel₀ hlam.ne', one_smul]
    have hval := Submission.dtc_bc_cz_blowUp_eval m U T x r c (lams j) (hlams j) hrU
    exact ⟨hRr.trans hball, fun ω hω => (hval.1 hTc ω (hω.trans hRr)).trans (hC ω).symm,
      fun β hβ => hval.2 hTb β (hβ.trans hRr)⟩
  -- steps 6–8: weak convergence, convergence of the mass measures (via the locality of the
  -- weight measure) and `∂C = 0`
  obtain ⟨hconv, hmass, hbd⟩ := Submission.dtc_bc_cz_local_agreement
    Submission.dtc_bc_measure_restrict_eq_of_eqOn (m + 1) m (fun j => dilation x (lams j) '' U)
    (fun j => blowUp T x (lams j) (hlams j).ne') C hopen hev
  -- step 9: `C` is minimizing in `ℝⁿ`
  exact ⟨C, hconv, hmass, Submission.dtc_bc_cz_isMinimizingIn (m + 1) C univ hn hCim, hbd⟩
/-- **Null set of points with small fillings** (Simon Ch. 6, 8.2 (4)–(6); the lower density
bound in the proof of 7.2.4).  Assume (VO).  Let `μ = μ_C` be finite on compact sets with
`M_W(C) = μ(W)` for open `W`, and `C(ω) = ∫ ⟨ω, ξ⟩ dμ` with `|ξ| ≤ 1` `μ`-a.e.  Let
`0 ≤ κ < 1 ≤ λ`.  Suppose that every `x ∈ E` has, at arbitrarily small scales `δ`, a radius
`ρ < δ` with `μ(∂B_ρ(x)) = 0` and a filling `S` with `∂S = ∂A`, where `A = C⌞B_ρ(x)`,
`M(S) ≤ κ μ(B_ρ(x))` and `spt S ⊆ B̄_{λδ}(x)`.  Then `μ(E) = 0`.
Fix `θ ∈ (κ, 1)` and a `W`-admissible `ω`.  The cone bound for the cycle `S − A` gives
`A(ω) ≤ θ μ(B_ρ(x))` at small scales.  The covering lemma then gives
`C(ω) ≤ μ(W) − (1 − θ) μ(E')` for each piece `E' = E ∩ B_k(0) ⊆ W = B_{k+1}(0)`.  Taking the
supremum over `ω` gives `μ(W) = M_W(C) ≤ μ(W) − (1 − θ) μ(E')`, so `μ(E') = 0`. -/
theorem Submission.cbrld_measure_eq_zero_of_small_fillings : (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → ∀ (P d : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (κ lam : ℝ) (E : Set (Euclid P)), 0 ≤ κ → κ < 1 → 1 ≤ lam → (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ W : Set (Euclid P), IsOpen W → C.massOn W = μ W) → AEStronglyMeasurable ξ μ → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ x ∈ E, ∀ δ : ℝ, 0 < δ → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ ∧ μ (sphere x ρ) = 0 ∧ ∃ (A S : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ y in ball x ρ, ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y) ∂μ) ∧ S.boundary = A.boundary ∧ S.mass ≤ ENNReal.ofReal κ * μ (ball x ρ) ∧ S.support ⊆ closedBall x (lam * δ)) → μ E = 0 := by
  intro hVO P d C μ ξ κ lam E hκ0 hκ1 hlam hμK hCμ hξm hξ hCξ hE
  have hball_fin : ∀ (x : Euclid P) (r : ℝ), μ (ball x r) < ∞ := fun x r =>
    (measure_mono ball_subset_closedBall).trans_lt (hμK _ (isCompact_closedBall x r))
  -- a fixed `θ ∈ (κ, 1)` plays the role of `κ + ε` in the covering lemma
  obtain ⟨θ, hκθ, hθ1⟩ := exists_between hκ1
  have hlam0 : 0 < lam := by linarith
  -- Steps 3–4: a piece `E' ⊆ E` inside an open `W` of finite measure is `μ`-null
  have hpiece : ∀ E' W : Set (Euclid P), E' ⊆ E → IsOpen W → E' ⊆ W → μ W < ∞ → μ E' = 0 := by
    intro E' W hE'E hWo hE'W hWfin
    have hE'fin : μ E' < ∞ := (measure_mono hE'W).trans_lt hWfin
    -- Step 3: every `W`-admissible `ω` satisfies `C(ω) ≤ μ(W) - (1 - θ) μ(E')`
    have hest : ∀ ω ∈ massAdmissibleOn (univ : Set (Euclid P)) (d + 1) W,
        C ω ≤ (μ W).toReal - (1 - θ) * (μ E').toReal := by
      intro ω hω
      have hωc : Continuous (ω : DifferentialForm (Euclid P) (d + 1)) :=
        ContDiff.continuous ω.property.1.1
      -- `g(y) = ξ(y)(ω(y))` is `μ`-a.e. strongly measurable with `|g| ≤ 1` `μ`-a.e.
      have hgm : AEStronglyMeasurable
          (fun y => ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y)) μ :=
        (isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable
          (hξm.prodMk hωc.aestronglyMeasurable) :)
      have hg1 : ∀ᵐ y ∂μ, |ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y)| ≤ 1 := by
        filter_upwards [hξ] with y hy
        exact (hy _).trans (hω.2 y)
      -- `g = 0` off `W`, so `C(ω) = ∫_W g dμ`
      have hCW : C ω = ∫ y in W, ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y) ∂μ := by
        rw [hCξ ω]
        refine (setIntegral_eq_integral_of_forall_compl_eq_zero fun y hy => ?_).symm
        rw [image_eq_zero_of_notMem_tsupport fun h => hy (hω.1 h), map_zero]
      -- the cone constant of `ω`
      obtain ⟨c, hc, hcone⟩ := Submission.cbrld_cycle_eval_le_radius_mul_mass hVO P d ω
      have hden : 0 < (c + 1) * lam * (1 + κ) :=
        mul_pos (mul_pos (by linarith) hlam0) (by linarith)
      obtain ⟨δ₀, hδ₀⟩ : ∃ δ₀ : ℝ, δ₀ = (θ - κ) / ((c + 1) * lam * (1 + κ)) := ⟨_, rfl⟩
      have hδ₀pos : 0 < δ₀ := by rw [hδ₀]; exact div_pos (by linarith) hden
      have hδ₀eq : δ₀ * ((c + 1) * lam * (1 + κ)) = θ - κ := by
        rw [hδ₀]; exact div_mul_cancel₀ _ hden.ne'
      -- Step 3(i): `∫_{B̄_ρ(x)} g dμ ≤ θ μ(B̄_ρ(x))` at arbitrarily small radii
      have hsmall : ∀ x ∈ E', ∀ δ' : ℝ, 0 < δ' → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ' ∧
          ∫ y in closedBall x ρ, ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y) ∂μ ≤
            θ * (μ (closedBall x ρ)).toReal := by
        intro x hx δ' hδ'
        have hδpos : 0 < min δ' δ₀ := lt_min hδ' hδ₀pos
        obtain ⟨ρ, hρ0, hρδ, hsph, A, S, hA, hbd, hSm, hSs⟩ := hE x (hE'E hx) (min δ' δ₀) hδpos
        refine ⟨ρ, hρ0, hρδ.trans_le (min_le_left _ _), ?_⟩
        have hR : 0 < lam * min δ' δ₀ := mul_pos hlam0 hδpos
        have hAs : A.support ⊆ closedBall x (lam * min δ' δ₀) :=
          (Submission.cbrld_ns_ball_current_support_subset P (d + 1) μ ξ A x ρ hA).trans
            (closedBall_subset_closedBall (hρδ.le.trans (le_mul_of_one_le_left hδpos.le hlam)))
        -- comparison with the cycle `S - A` at scale `R = λ min(δ', δ₀)`
        have hcmp := Submission.cbrld_ns_eval_le_of_small_filling P d A S ω (μ (ball x ρ)) x c κ
          (lam * min δ' δ₀) hc hκ0 hR (hball_fin x ρ) hω.2 hcone hbd
          (Submission.cbrld_ns_ball_current_mass_le P (d + 1) μ ξ A x ρ hξ hA) hSm hAs hSs
        have hcR : c * (lam * min δ' δ₀) * (1 + κ) ≤ θ - κ := by
          have h1 : 0 ≤ c * lam * (1 + κ) := mul_nonneg (mul_nonneg hc hlam0.le) (by linarith)
          have h2 : c * lam * (1 + κ) ≤ (c + 1) * lam * (1 + κ) :=
            mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (by linarith) hlam0.le)
              (by linarith)
          calc c * (lam * min δ' δ₀) * (1 + κ) = c * lam * (1 + κ) * min δ' δ₀ := by ring
            _ ≤ c * lam * (1 + κ) * δ₀ := mul_le_mul_of_nonneg_left (min_le_right _ _) h1
            _ ≤ (c + 1) * lam * (1 + κ) * δ₀ := mul_le_mul_of_nonneg_right h2 hδ₀pos.le
            _ = θ - κ := by rw [← hδ₀eq]; ring
        -- `μ(∂B_ρ(x)) = 0`, so closed and open balls agree `μ`-a.e.
        have hae : closedBall x ρ =ᵐ[μ] ball x ρ := by
          refine ae_eq_set.2 ⟨by rw [closedBall_sdiff_ball]; exact hsph, ?_⟩
          rw [sdiff_eq_empty.2 ball_subset_closedBall, measure_empty]
        rw [setIntegral_congr_set hae, measure_congr hae, ← hA ω]
        calc A ω ≤ (κ + c * (lam * min δ' δ₀) * (1 + κ)) * (μ (ball x ρ)).toReal := hcmp
          _ ≤ θ * (μ (ball x ρ)).toReal :=
            mul_le_mul_of_nonneg_right (by linarith) ENNReal.toReal_nonneg
      -- Step 3(ii): the covering lemma with `θ`
      rw [hCW]
      exact Submission.cbrld_vitali_setIntegral_le P μ
        (fun y => ξ y ((ω : DifferentialForm (Euclid P) (d + 1)) y)) θ E' W hμK hgm hg1
        hθ1.le hWo hE'W hWfin hsmall
    -- Step 4: `μ(W) = M_W(C) ≤ max(μ(W) - (1 - θ) μ(E'), 0)`
    have hmass : C.massOn W ≤ ENNReal.ofReal (max ((μ W).toReal - (1 - θ) * (μ E').toReal) 0) := by
      refine sSup_le ?_
      rintro _ ⟨ω, hω, rfl⟩
      exact ENNReal.ofReal_le_ofReal ((hest ω hω).trans (le_max_left _ _))
    rw [hCμ W hWo] at hmass
    have hreal := ENNReal.toReal_le_of_le_ofReal (le_max_right _ _) hmass
    by_contra hne
    have hpos : 0 < (μ E').toReal := ENNReal.toReal_pos hne hE'fin.ne
    have hWpos : 0 < (μ W).toReal :=
      hpos.trans_le (ENNReal.toReal_mono hWfin.ne (measure_mono hE'W))
    have hprod : 0 < (1 - θ) * (μ E').toReal := mul_pos (by linarith) hpos
    rcases le_total ((μ W).toReal - (1 - θ) * (μ E').toReal) 0 with h | h
    · rw [max_eq_right h] at hreal
      linarith
    · rw [max_eq_left h] at hreal
      linarith
  -- Step 2: `E = ⋃ₖ (E ∩ B_k(0))`, and each piece lies in the open `B_{k+1}(0)`
  have hcover : E ⊆ ⋃ k : ℕ, E ∩ ball (0 : Euclid P) k := by
    intro y hy
    obtain ⟨k, hk⟩ := exists_nat_gt (dist y 0)
    exact mem_iUnion.2 ⟨k, hy, mem_ball.2 hk⟩
  exact measure_mono_null hcover (measure_iUnion_null fun k : ℕ =>
    hpiece (E ∩ ball (0 : Euclid P) k) (ball (0 : Euclid P) (k + 1)) inter_subset_left isOpen_ball
      (fun z hz => ball_subset_ball (by linarith) hz.2) (hball_fin _ _))

/-- **Lower density bound for cycles with the integer slice property** (Simon Ch. 6, proof of
8.2, with the lower density in place of `Θ^{*n}`; `n = d + 1 < P`).  The local filling
`dtc_bc_tc_cl_ld_exists_small_filling`, fed with (SL) = `cmc_slice_mass_bounds`, (MR) and (Isor),
gives `η₀ > 0` such that every `x` with `liminf_{r↓0} μ(B_r(x))/(ωₙrⁿ) < η₀` has, at arbitrarily
small scales `δ`, a radius `ρ < δ` with `μ(∂B_ρ(x)) = 0` and a filling `S` of `∂(C⌞B_ρ(x))` with
`M(S) ≤ μ(B_ρ(x))/2` and `spt S ⊆ B̄_{(1+3√P)δ}(x)`.  The set of these points is `μ`-null by
`cbrld_measure_eq_zero_of_small_fillings` with `κ = 1/2` and `λ = 1 + 3√P`. -/
theorem Submission.dtc_bc_tc_cl_lower_density : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 1 ≤ c ∧ ∀ Z : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Z → IsCompact Z.support → Z.boundary = 0 → Z.mass < ∞ → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2), IsIntegerMultiplicity Y ∧ Y.boundary = Z ∧ Y.mass ≤ ENNReal.ofReal (c * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1)) * Z.mass.toReal) ∧ Y.support ⊆ thickening (3 * Real.sqrt P * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1))) Z.support) → ∀ (P d : ℕ), d + 1 < P → (∃ η₀ : ℝ, 0 < η₀ ∧ ∀ (C : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)), C.boundary = 0 → (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ W : Set (Euclid P), IsOpen W → C.massOn W = μ W) → AEStronglyMeasurable ξ μ → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (C).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B)) → ∀ᵐ x ∂μ, ENNReal.ofReal η₀ ≤ liminf (fun r : ℝ => μ (ball x r) / (unitBallVolume (d + 1) * ENNReal.ofReal (r ^ (d + 1)))) (𝓝[>] 0)) := by
  intro hMR hVO hIsor P d hPd
  -- steps 2–4: small fillings of sphere slices at points of lower density `< η₀`
  obtain ⟨η₀, hη₀, hfill⟩ := Submission.dtc_bc_tc_cl_ld_exists_small_filling
    Submission.cmc_slice_mass_bounds hMR hIsor P d hPd
  refine ⟨η₀, hη₀, fun C μ ξ hCb hμ hCμ hξm hξb hC hISP => ?_⟩
  -- steps 0, 5, 6: the points of lower density `< η₀` form a `μ`-null set
  rw [ae_iff]
  refine Submission.cbrld_measure_eq_zero_of_small_fillings hVO P d C μ ξ (1 / 2)
    (1 + 3 * Real.sqrt P) _ (by norm_num) (by norm_num) (le_add_of_nonneg_right (by positivity))
    hμ hCμ hξm hξb hC fun x hx δ hδ => ?_
  exact hfill C μ ξ hCb hμ hξm hξb hC hISP x (not_le.mp hx) δ hδ

/-- **Closure theorem for compactly supported currents** (Simon Ch. 6, 8.2, the step
`CL_P(d), BR_P(d) ⟹ CL*_{P,d+1}` used for 7.2.4 and 7.3.1): if `K ⊆ ℝᴾ` is compact,
`Tⱼ ∈ 𝒟_{d+1}(ℝᴾ)` are integer multiplicity with integer multiplicity boundaries, `spt Tⱼ ⊆ K`,
`supⱼ (M(Tⱼ) + M(∂Tⱼ)) < ∞` and `Tⱼ ⇀ T`, then `T` is integer multiplicity.  `spt T ⊆ K` by
(VO) and `M(T), M(∂T) < ∞` by lower semicontinuity; `∂T` is integer multiplicity by `CL_P(d)`
(`∂∂Tⱼ = 0`), so it has a compactly supported integer multiplicity filling `Y`.  The integer slice
property holds for the `Tⱼ` and `Y`, passes to the weak limit `T` and then to the compactly
supported cycle `Γ = T − Y`; the lower density bound and the cycle case make `Γ` integer
multiplicity, and so is `T = Γ − (0 − Y)` by (IMC)(c). -/
theorem Submission.dtc_bc_tc_cl_closure_compact_support : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 1 ≤ c ∧ ∀ Z : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Z → IsCompact Z.support → Z.boundary = 0 → Z.mass < ∞ → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2), IsIntegerMultiplicity Y ∧ Y.boundary = Z ∧ Y.mass ≤ ENNReal.ofReal (c * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1)) * Z.mass.toReal) ∧ Y.support ⊆ thickening (3 * Real.sqrt P * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1))) Z.support) → ∀ (P d : ℕ), d + 1 < P → (∀ (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U d) (T : GeometricCurrentOn U d), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T) → (∀ (U : Set (Euclid P)) (R : GeometricCurrentOn U (d + 1)), IsOpen U → IsIntegerMultiplicity R → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → R.boundary.massOn W < ∞) → IsIntegerMultiplicity R.boundary) → (∀ (Ts : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (T : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (K : Set (Euclid P)), IsCompact K → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ j, IsIntegerMultiplicity (Ts j).boundary) → (∀ j, (Ts j).support ⊆ K) → ⨆ j, ((Ts j).mass + (Ts j).boundary.mass) < ∞ → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T) := by
  intro hMR hRect hVO hIsor P d hdP hCL hBR Ts T K hK hTsIM hTsbIM hTsK hbound hconv
  have hIMCc := hRect.2.2.1
  -- (REP) and (MM) from the sibling foundations; `0` is integer multiplicity
  obtain ⟨hREP, ⟨-, -, hMM⟩, -⟩ := Submission.dtc_bc_tc_cl_foundations
  have hzero := Submission.cbr_cc_current_algebra.1
  -- `S := supⱼ (M(Tⱼ) + M(∂Tⱼ)) < ∞` bounds `M(Tⱼ)`, `M(∂Tⱼ)` and their `liminf`s
  obtain ⟨S, hS, hSlt⟩ : ∃ S : ℝ≥0∞, (∀ j, (Ts j).mass + (Ts j).boundary.mass ≤ S) ∧ S < ∞ :=
    ⟨_, le_iSup (fun j => (Ts j).mass + (Ts j).boundary.mass), hbound⟩
  have hTsS : ∀ j, (Ts j).mass ≤ S := fun j => le_self_add.trans (hS j)
  have hTsbS : ∀ j, (Ts j).boundary.mass ≤ S := fun j => le_add_self.trans (hS j)
  have hliminf : ∀ u : ℕ → ℝ≥0∞, (∀ j, u j ≤ S) → liminf u atTop ≤ S := fun u hu =>
    liminf_le_of_frequently_le' (Frequently.of_forall hu)
  -- Step 1: `spt T ⊆ K` by (VO), so `spt T` is compact; `M(T), M(∂T) < ∞` by lower
  -- semicontinuity of mass (Simon 6.2.14), `∂Tⱼ ⇀ ∂T`
  have hTvan : ∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1),
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) (d + 1))) K → T ω = 0 := by
    intro ω hω
    have h0 : ∀ j, Ts j ω = 0 := fun j => hVO P (d + 1) univ (Ts j) ω (hω.mono_right (hTsK j))
    exact tendsto_nhds_unique (hconv ω) (by simp only [h0]; exact tendsto_const_nhds)
  have hTsupp : IsCompact T.support :=
    (Submission.rsd_cmr_support_subset_of_vanish P (d + 1) univ K T isOpen_univ hK
      (subset_univ K) hTvan).2
  have hTmass : T.mass < ∞ :=
    ((hconv.massOn_le_liminf univ).trans (hliminf _ hTsS)).trans_lt hSlt
  have hTbmass : T.boundary.mass < ∞ :=
    ((hconv.boundary.massOn_le_liminf univ).trans (hliminf _ hTsbS)).trans_lt hSlt
  -- Step 2: `∂T` is integer multiplicity by CL_P(d) applied to `∂Tⱼ ⇀ ∂T` (`∂∂Tⱼ = 0`)
  have hbb : ∀ (m : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1))
      (W : Set (Euclid P)), boundaryMassOn X.boundary W = 0 := by
    intro m
    cases m with
    | zero => intro X W; rfl
    | succ k =>
      intro X W
      show X.boundary.boundary.massOn W = 0
      rw [GeometricCurrentOn.boundary_boundary]
      refine le_antisymm (sSup_le ?_) zero_le
      rintro _ ⟨ω, -, rfl⟩
      simp
  have hTbIM : IsIntegerMultiplicity T.boundary := by
    refine hCL univ (fun j => (Ts j).boundary) T.boundary isOpen_univ hTsbIM (fun W _ _ => ?_)
      hconv.boundary
    refine lt_of_le_of_lt (iSup_le fun j => ?_) hSlt
    show (Ts j).boundary.massOn W + boundaryMassOn (Ts j).boundary W ≤ S
    rw [hbb d (Ts j) W, add_zero]
    exact ((Ts j).boundary.massOn_mono (subset_univ W)).trans (hTsbS j)
  -- Step 3: a compactly supported integer multiplicity filling `Y` of `∂T` with `M(Y) < ∞`
  obtain ⟨Y, hYIM, hYb, hYmass, hYsupp⟩ :=
    Submission.dtc_bc_tc_cl_cc_compact_im_filling hMR hIMCc hVO hIsor P d (by omega) T hTsupp
      hTbmass hTbIM
  -- Step 4: `Γ = T − Y` is a cycle of finite mass with compact support
  have hΓb : (T - Y).boundary = 0 := by
    ext η
    have h : Y.boundary η = T.boundary η := by rw [hYb]
    change T.boundary η - Y.boundary η = 0
    rw [h, sub_self]
  have hΓmass : (T - Y).mass < ∞ := by
    refine ((Submission.cbr_cc_current_algebra).2.1 P (d + 1) univ (T - Y) T Y 1 (-1)
      (fun ω => by change T ω - Y ω = _; push_cast; ring) univ).trans_lt ?_
    simp only [Int.natAbs_one, Int.natAbs_neg, Nat.cast_one, one_mul]
    exact ENNReal.add_lt_top.2 ⟨hTmass, hYmass⟩
  have hΓsupp : IsCompact (T - Y).support := by
    refine (Submission.rsd_cmr_support_subset_of_vanish P (d + 1) univ (T.support ∪ Y.support)
      (T - Y) isOpen_univ (hTsupp.union hYsupp) (subset_univ _) fun ω hω => ?_).2
    change T ω - Y ω = 0
    rw [hVO P (d + 1) univ T ω (hω.mono_right subset_union_left),
      hVO P (d + 1) univ Y ω (hω.mono_right subset_union_right), sub_zero]
  -- Step 5: currents `X` with `X`, `∂X` integer multiplicity have the integer slice property
  have hISPIM := Submission.dtc_bc_tc_cl_cc_slice_property_of_im hRect
    Submission.cmc_slice_mass_bounds hMM Submission.cbr_setIntegral_eq_of_integral_eq P d hBR
  -- Step 6: so do the `Tⱼ` and `Y`, and SLIM_{P,d} gives it for the weak limit `T`
  have hSLIM := Submission.dtc_bc_tc_cl_slice_property_of_weak_limit hMR hRect P d hdP hCL
  have hTsW : ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ →
      ⨆ i, ((Ts i).massOn W + (Ts i).boundary.massOn W) < ∞ := fun W _ _ =>
    lt_of_le_of_lt (iSup_le fun i => (add_le_add ((Ts i).massOn_mono (subset_univ W))
      ((Ts i).boundary.massOn_mono (subset_univ W))).trans (hS i)) hSlt
  have hISPT := hSLIM Ts T (fun i => hISPIM (Ts i) (hTsIM i) (hTsbIM i)) hTsW hconv
  have hISPY := hISPIM Y hYIM (hYb ▸ hTbIM)
  -- Step 7: the integer slice property passes to `Γ = T − Y` (slices are linear in the current)
  have hTmW : ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ → T.massOn W < ∞ :=
    fun W _ _ => (T.massOn_mono (subset_univ W)).trans_lt hTmass
  have hTbmW : ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ →
      T.boundary.massOn W < ∞ :=
    fun W _ _ => (T.boundary.massOn_mono (subset_univ W)).trans_lt hTbmass
  have hYmW : ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ → Y.massOn W < ∞ :=
    fun W _ _ => (Y.massOn_mono (subset_univ W)).trans_lt hYmass
  have hYbmW : ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ →
      Y.boundary.massOn W < ∞ := by
    rw [hYb]
    exact hTbmW
  have hISPΓ := Submission.cbr_cc_slice_property_sub hREP Submission.cmc_slice_mass_bounds hIMCc
    Submission.cbr_setIntegral_eq_of_integral_eq d P T Y hTmW hTbmW hYmW hYbmW hISPT hISPY
  -- Step 8: LD_{P,d} and CYC_{P,d} make the cycle `Γ` integer multiplicity
  have hΓIM := Submission.dtc_bc_tc_cl_cycle_isIntegerMultiplicity hMR hRect hVO P d hdP hSLIM
    (Submission.dtc_bc_tc_cl_lower_density hMR hVO hIsor P d hdP) (T - Y) hΓb hΓmass hΓsupp hISPΓ
  -- `T = Γ − (0 − Y)` is integer multiplicity by (IMC)(c)
  have hT : (T - Y) - (0 - Y) = T := by
    ext ω
    change (T ω - Y ω) - ((0 : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) ω - Y ω) = T ω
    rw [GeometricCurrentOn.zero_apply]
    ring
  rw [← hT]
  exact hIMCc P (d + 1) univ _ _ isOpen_univ hΓIM
    (hIMCc P (d + 1) univ _ _ isOpen_univ (hzero P (d + 1) univ) hYIM)

/-- **Closure theorem in `ℝᴾ`, positive codimension** (Simon Ch. 6, Theorem 3.11: weak limits of
integer multiplicity currents with locally bounded `M_W(Tⱼ) + M_W(∂Tⱼ)` are integer multiplicity,
proved in §8 (Theorem 8.2, Remarks 8.3) with 6.1–6.3).  Let `m + 1 < P` and `Tⱼ, T ∈ 𝒟_{m+1}(ℝᴾ)`
with every `Tⱼ` integer multiplicity, `supⱼ (M_W(Tⱼ) + M_W(∂Tⱼ)) < ∞` for every bounded open `W`
and `Tⱼ ⇀ T`; then `T` is integer multiplicity.  Fix `P` and prove, by induction on `d < P`, the
closure theorem `CL_P(d)` in every open `U ⊆ ℝᴾ`.  `CL_P(0)` is
`dtc_bc_tc_cl_closure_degree_zero`.  For `d + 1 < P`, `CL_P(d)` and the deformation theorem give
boundary rectifiability `BR_P(d)` (`dtc_bc_tc_cl_boundary_isIntegerMultiplicity`); `CL_P(d)`,
`BR_P(d)` and the isoperimetric filling give the closure theorem `CL*_{P,d+1}` for sequences with
supports in a fixed compact set (`dtc_bc_tc_cl_closure_compact_support`); and `BR_P(d)` with
`CL*_{P,d+1}` gives `CL_P(d+1)` by localization (`dtc_bc_tc_cl_closure_succ`).  Finally apply
`CL_P(m+1)` in `U = ℝᴾ`: an open `W ⊂⊂ ℝᴾ` has compact, hence bounded, closure, so `W` is
bounded, and `boundaryMassOn` of an `(m+1)`-current is the mass of its boundary. -/
theorem Submission.dtc_bc_tc_closure : ∀ (P m : ℕ) (Ts : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), m + 1 < P → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → Bornology.IsBounded W → ⨆ j, ((Ts j).massOn W + (Ts j).boundary.massOn W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T := by
  intro P m Ts T hmP hTs hmass hconv
  -- the accepted siblings (MR), (IMC), (VO)
  have hMR := Submission.cmc_massOn_eq_imRep_measure
  have hIMC := Submission.cmc_imRep_locality_restrict_sub
  have hVO := Submission.dtc_vanish_off_support
  -- (REP), the deformation theorem and the isoperimetric filling, in positive codimension
  have hREP := Submission.dtc_bc_tc_cl_foundations.1
  obtain ⟨hDT, hIso⟩ := Submission.dtc_bc_tc_cl_deformation_isoperimetric hMR hIMC hVO
  -- `CL_P(d)` for every `d < P`, by induction on `d`
  have hCL : ∀ d : ℕ, d < P → ∀ (U : Set (Euclid P)) (Xs : ℕ → GeometricCurrentOn U d)
      (X : GeometricCurrentOn U d), IsOpen U → (∀ j, IsIntegerMultiplicity (Xs j)) →
      (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U →
        ⨆ j, ((Xs j).massOn W + boundaryMassOn (Xs j) W) < ∞) →
      WeaklyConvergesOn Xs X → IsIntegerMultiplicity X := by
    intro d
    induction d with
    | zero => exact fun _ => Submission.dtc_bc_tc_cl_closure_degree_zero hREP hMR hIMC P
    | succ d ih =>
      intro hd
      -- `CL_P(d) ⟹ BR_P(d)`, then `CL_P(d) ∧ BR_P(d) ⟹ CL*_{P,d+1}`, then `CL_P(d+1)`
      have hCLd := ih (by omega)
      have hBR :=
        Submission.dtc_bc_tc_cl_boundary_isIntegerMultiplicity hMR hIMC hVO hDT P d hd hCLd
      exact Submission.dtc_bc_tc_cl_closure_succ hMR hIMC hVO P d hd hBR
        (Submission.dtc_bc_tc_cl_closure_compact_support hMR hIMC hVO hIso P d hd hCLd hBR)
  -- `CL_P(m+1)` in `U = ℝᴾ`: `W ⊂⊂ ℝᴾ` is bounded, and `boundaryMassOn` is `M_W(∂Tⱼ)`
  refine hCL (m + 1) hmP univ Ts T isOpen_univ hTs (fun W hW hWU => ?_) hconv
  exact hmass W hW (isBounded_closure_iff.mp hWU.1.isBounded)

/-- **Truncated compactness** (Simon Ch. 6, 4.9–4.10 and 3.11, as used for 7.3.1(2)).  Let
`n = m + 1 < P` and let `Sⱼ ∈ 𝒟ₙ(Uⱼ)` be integer multiplicity such that, for every `R`, eventually
`B̄_R(0) ⊆ Uⱼ`, `M_{B_R(0)}(Sⱼ) ≤ c_R < ∞` and `∂Sⱼ = 0` in `B_R(0)`.  Choose `ψ` strictly
increasing with `B̄_{k+1}(0) ⊆ U_{ψ(k)}` and `∂S_{ψ(k)} = 0` in `B_{k+1}(0)`.  Truncating
`S_{ψ(k)}` at a good slicing radius `ρ'_k ∈ ((k + 1)/4, (k + 1)/2)` gives integer multiplicity
`T_k ∈ 𝒟ₙ(ℝᴾ)` which agree with `S_{ψ(k)}` and have no boundary in `B_{ρ'_k}(0)`, with
`M_O(T_k) ≤ M_O(S_{ψ(k)})` and `M(T_k), M(∂T_k) < ∞`; hence `sup_k (M_W(T_k) + M_W(∂T_k)) < ∞` for
bounded open `W`.  A weakly convergent subsequence `T_{φ'(j)} ⇀ C` has an integer multiplicity
limit (Federer–Fleming), and agreement on `B_{ρ_j}(0)` with `ρ_j → ∞` gives `∂C = 0` and
`S_{φ(j)} ⇀ C`. -/
theorem Submission.dtc_bc_truncated_compactness : ∀ (P m : ℕ) (Us : ℕ → Set (Euclid P)) (Ss : (j : ℕ) → GeometricCurrentOn (Us j) (m + 1)), m + 1 < P → (∀ j, IsOpen (Us j)) → (∀ R : ℝ, ∀ᶠ j in atTop, closedBall (0 : Euclid P) R ⊆ Us j) → (∀ j, IsIntegerMultiplicity (Ss j)) → (∀ R : ℝ, ∃ c : ℝ≥0∞, c ≠ ∞ ∧ ∀ᶠ j in atTop, (Ss j).massOn (ball 0 R) ≤ c) → (∀ R : ℝ, ∀ᶠ j in atTop, ∀ ω : TestFormOn (Us j) m, tsupport (ω : DifferentialForm (Euclid P) m) ⊆ ball 0 R → (Ss j).boundary ω = 0) → ∃ (φ : ℕ → ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (Ŝ : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (ρ : ℕ → ℝ), StrictMono φ ∧ IsIntegerMultiplicity C ∧ C.boundary = 0 ∧ ConvergesWeakly (fun j => Ss (φ j)) C ∧ (∀ j, IsIntegerMultiplicity (Ŝ j)) ∧ (∀ W : Set (Euclid P), IsOpen W → Bornology.IsBounded W → ⨆ j, ((Ŝ j).massOn W + (Ŝ j).boundary.massOn W) < ∞) ∧ WeaklyConvergesOn Ŝ C ∧ Tendsto ρ atTop atTop ∧ (∀ j, closedBall (0 : Euclid P) (ρ j) ⊆ Us (φ j)) ∧ ∀ (j : ℕ) (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)), tsupport (ω : DifferentialForm (Euclid P) (m + 1)) ⊆ ball 0 (ρ j) → Ŝ j ω = currentEval (Ss (φ j)) (ω : DifferentialForm (Euclid P) (m + 1)) := by
  intro P m Us Ss hmP hUo hUs hIM hmass hbd
  -- Step 1: `ψ` strictly increasing, `B̄_{k+1}(0) ⊆ U_{ψ(k)}` and `∂S_{ψ(k)} = 0` on `B_{k+1}(0)`.
  obtain ⟨ψ, hψ, hψk⟩ := Filter.extraction_forall_of_eventually fun k : ℕ =>
    (hUs ((k : ℝ) + 1)).and (hbd ((k : ℝ) + 1))
  -- Steps 2–3: truncate `S_{ψ(k)}` at a good radius `ρ'_k ∈ ((k + 1)/4, (k + 1)/2)`.
  choose ρ' T hρlo hρhi hTIM hTeq hTbd hTmass hTfin hTbfin using fun k : ℕ =>
    Submission.dtc_bc_tc_truncation P m (Us (ψ k)) (Ss (ψ k)) ((k : ℝ) + 1) (hUo (ψ k))
      (by positivity) (hψk k).1 (hIM (ψ k)) (hψk k).2
  have hρ' : Tendsto ρ' atTop atTop := by
    refine tendsto_atTop_atTop.2 fun b => ⟨⌈4 * b⌉₊, fun k hk => ?_⟩
    have : 4 * b ≤ k := (Nat.le_ceil _).trans (Nat.cast_le.2 hk)
    linarith [hρlo k]
  -- Step 4: `sup_k (M_W(T_k) + M_W(∂T_k)) < ∞` for every bounded open `W`.
  have hbound : ∀ W : Set (Euclid P), IsOpen W → Bornology.IsBounded W →
      ⨆ k, ((T k).massOn W + (T k).boundary.massOn W) < ∞ := by
    intro W hWo hWb
    obtain ⟨r, hWr⟩ := hWb.subset_ball (0 : Euclid P)
    obtain ⟨c, hc, hcev⟩ := hmass r
    -- for large `k`: `M_W(T_k) ≤ M_{B_r(0)}(S_{ψ(k)}) ≤ c` and `M_W(∂T_k) = 0` (`W ⊆ B_{ρ'_k}(0)`)
    have hev : ∀ᶠ k in atTop, (T k).massOn W + (T k).boundary.massOn W ≤ c := by
      filter_upwards [hψ.tendsto_atTop.eventually hcev, hρ'.eventually_ge_atTop r] with k hk hkr
      have hb : (T k).boundary.massOn W ≤ 0 := by
        refine sSup_le ?_
        rintro _ ⟨β, hβ, rfl⟩
        dsimp only
        rw [hTbd k β (hβ.1.trans (hWr.trans (ball_subset_ball hkr))), ENNReal.ofReal_zero]
      calc (T k).massOn W + (T k).boundary.massOn W ≤ c + 0 :=
            add_le_add (((hTmass k W hWo).trans ((Ss (ψ k)).massOn_mono hWr)).trans hk) hb
        _ = c := add_zero c
    obtain ⟨K, hK⟩ := eventually_atTop.1 hev
    -- the finitely many earlier terms are finite, as `M(T_k) < ∞` and `M(∂T_k) < ∞`
    have hfin : ∀ k, (T k).massOn W + (T k).boundary.massOn W < ∞ := fun k =>
      ENNReal.add_lt_top.2 ⟨((T k).massOn_mono (subset_univ W)).trans_lt (hTfin k),
        ((T k).boundary.massOn_mono (subset_univ W)).trans_lt (hTbfin k)⟩
    calc ⨆ k, ((T k).massOn W + (T k).boundary.massOn W)
        ≤ c + ∑ k ∈ Finset.range K, ((T k).massOn W + (T k).boundary.massOn W) := by
          refine iSup_le fun k => ?_
          rcases le_or_gt K k with hKk | hkK
          · exact (hK k hKk).trans le_self_add
          · exact (Finset.single_le_sum (f := fun k => (T k).massOn W + (T k).boundary.massOn W)
              (fun _ _ => zero_le) (Finset.mem_range.2 hkK)).trans le_add_self
      _ < ∞ := ENNReal.add_lt_top.2 ⟨hc.lt_top, ENNReal.sum_lt_top.2 fun k _ => hfin k⟩
  -- Step 5: a weakly convergent subsequence (Simon 6.2.15) with integer multiplicity limit
  -- (Simon 6.3.11).
  obtain ⟨φ', C, hφ', hconv⟩ := Submission.dtc_bc_tc_weak_compactness P (m + 1) T
    fun W hWo hWb => lt_of_le_of_lt (iSup_mono fun k => le_self_add) (hbound W hWo hWb)
  have hsub : ∀ W : Set (Euclid P), IsOpen W → Bornology.IsBounded W →
      ⨆ j, ((T (φ' j)).massOn W + (T (φ' j)).boundary.massOn W) < ∞ := fun W hWo hWb =>
    lt_of_le_of_lt (iSup_le fun j =>
      le_iSup (fun k => (T k).massOn W + (T k).boundary.massOn W) (φ' j)) (hbound W hWo hWb)
  have hρ : Tendsto (fun j => ρ' (φ' j)) atTop atTop := hρ'.comp hφ'.tendsto_atTop
  -- Step 6: `φ = ψ ∘ φ'`, `Ŝ_j = T_{φ'(j)}`, `ρ_j = ρ'_{φ'(j)}`.
  refine ⟨fun j => ψ (φ' j), C, fun j => T (φ' j), fun j => ρ' (φ' j), hψ.comp hφ',
    Submission.dtc_bc_tc_closure P m (fun j => T (φ' j)) C hmP (fun j => hTIM (φ' j)) hsub hconv,
    ?_, ?_, fun j => hTIM (φ' j), hsub, hconv, hρ, fun j => ?_, fun j => hTeq (φ' j)⟩
  · -- `∂C = 0`: `∂C(β) = lim_j ∂T_{φ'(j)}(β)`, and `∂T_{φ'(j)}(β) = 0` once `spt β ⊆ B_{ρ_j}(0)`
    ext β
    have hβc : HasCompactSupport (β : DifferentialForm (Euclid P) m) := β.property.1.2
    obtain ⟨r, hr⟩ := hβc.isCompact.isBounded.subset_ball (0 : Euclid P)
    refine tendsto_nhds_unique (hconv.boundary β) (tendsto_const_nhds.congr' ?_)
    filter_upwards [hρ.eventually_ge_atTop r] with j hj
    exact (hTbd (φ' j) β (hr.trans (ball_subset_ball hj))).symm
  · -- `S_{φ(j)} ⇀ C`: `currentEval(S_{φ(j)}, ω) = T_{φ'(j)}(ω)` once `spt ω ⊆ B_{ρ_j}(0)`
    intro ω
    have hωc : HasCompactSupport (ω : DifferentialForm (Euclid P) (m + 1)) := ω.property.1.2
    obtain ⟨r, hr⟩ := hωc.isCompact.isBounded.subset_ball (0 : Euclid P)
    refine (hconv ω).congr' ?_
    filter_upwards [hρ.eventually_ge_atTop r] with j hj
    exact hTeq (φ' j) ω (hr.trans (ball_subset_ball hj))
  · -- `B̄_{ρ_j}(0) ⊆ B̄_{φ'(j)+1}(0) ⊆ U_{φ(j)}`
    have h0 : (0 : ℝ) ≤ φ' j := Nat.cast_nonneg _
    exact (closedBall_subset_closedBall (by linarith [hρhi (φ' j)])).trans (hψk (φ' j)).1

/-- **Closure theorem for integer multiplicity cycles of bounded mass** (Simon Ch. 6, Theorem 8.2
in the case `∂Tⱼ = 0`, Remark 6.4, with `U = ℝᴾ`).  Let `n < P` and `Tⱼ, T ∈ 𝒟ₙ(ℝᴾ)` with every
`Tⱼ` an integer multiplicity cycle, `supⱼ M(Tⱼ) < ∞` and `Tⱼ ⇀ T`; then `T` is integer
multiplicity.  For every `W`, `M_W(Tⱼ) ≤ M_{ℝᴾ}(Tⱼ) = M(Tⱼ)` (`massOn_mono`) and `M_W(∂Tⱼ) = 0`,
so `supⱼ (M_W(Tⱼ) + M_W(∂Tⱼ)) ≤ supⱼ M(Tⱼ) < ∞`.  For `n = m + 1` (where `∂Tⱼ = 0` and the zero
current has zero mass) this is the hypothesis of the closure theorem `dtc_bc_tc_closure`; for
`n = 0` (where `boundaryMassOn` is `0`) it is the hypothesis of the degree-zero closure theorem
`dtc_bc_tc_cl_closure_degree_zero` in `U = ℝᴾ`. -/
theorem Submission.dtc_bc_lc_fd_bim_closure_cycles : ∀ (P n : ℕ) (Ts : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) n) (T : GeometricCurrentOn (univ : Set (Euclid P)) n), n < P → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ j, BoundaryVanishes (Ts j)) → ⨆ j, (Ts j).mass < ∞ → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T := by
  intro P n
  cases n with
  | zero =>
    intro Ts T _ hTs _ hmass hconv
    -- `CL_P(0)` in `U = ℝᴾ`: `boundaryMassOn` of a `0`-current is `0`, and `M_W(Tⱼ) ≤ M(Tⱼ)`
    refine Submission.dtc_bc_tc_cl_closure_degree_zero Submission.dtc_bc_tc_cl_foundations.1
      Submission.cmc_massOn_eq_imRep_measure Submission.cmc_imRep_locality_restrict_sub P univ Ts T
      isOpen_univ hTs (fun W _ _ => lt_of_le_of_lt (iSup_mono fun j => ?_) hmass) hconv
    rw [boundaryMassOn, add_zero]
    exact (Ts j).massOn_mono (subset_univ W)
  | succ m =>
    intro Ts T hmP hTs hbd hmass hconv
    -- the closure theorem in degree `m + 1`: `M_W(∂Tⱼ) = M_W(0) = 0` and `M_W(Tⱼ) ≤ M(Tⱼ)`
    refine Submission.dtc_bc_tc_closure P m Ts T hmP hTs
      (fun W _ _ => lt_of_le_of_lt (iSup_mono fun j => ?_) hmass) hconv
    have hbW : (Ts j).boundary.massOn W = 0 := by
      rw [show (Ts j).boundary = 0 from hbd j]
      refine le_antisymm (sSup_le ?_) bot_le
      rintro _ ⟨ω, _, rfl⟩
      simp
    rw [hbW, add_zero]
    exact (Ts j).massOn_mono (subset_univ W)
namespace Submission

/-- Mollification by an even `C¹` kernel `η` with compact support commutes with `D` and is
self-adjoint: `∫ D(η * u)(x)(s x) dx = −∫ u div(η * s)` for integrable `u`, `s` (Simon Ch. 2,
Lemma 2.5).  Both derivatives are convolutions with the odd, bounded `Dη`, and Fubini applies to
`Dη(x − z)(s x) u(z)`, which is dominated by `C ‖s x‖ |u z|`. -/
theorem codim1_rdo_dg_sp_mollifier_adjoint : ∀ (P : ℕ) (η u : Euclid P → ℝ) (s : Euclid P → Euclid P), ContDiff ℝ 1 η → HasCompactSupport η → (∀ z, η (-z) = η z) → Integrable u → Integrable s → ∫ x, fderiv ℝ (convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume) x (s x) = -∫ z, u z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ (convolution η s (ContinuousLinearMap.lsmul ℝ ℝ) volume) z : Euclid P →ₗ[ℝ] Euclid P) := by
  intro P η u s hη hηc heven hu hs
  -- Step 0: `Dη` is continuous with compact support, hence bounded by some `C`.
  have hDc : Continuous (fderiv ℝ η) := hη.continuous_fderiv one_ne_zero
  have hDcs : HasCompactSupport (fderiv ℝ η) := hηc.fderiv ℝ
  obtain ⟨C, hC⟩ := hDc.bounded_above_of_compact_support hDcs
  -- Step 1: `η` is even, so `Dη` is odd (chain rule for `η = η ∘ (−id)`).
  have hodd : ∀ y, fderiv ℝ η (-y) = -fderiv ℝ η y := by
    intro y
    have h1 : HasFDerivAt (η ∘ fun z => -z)
        ((fderiv ℝ η (-y)).comp (-ContinuousLinearMap.id ℝ (Euclid P))) y :=
      ((hη.differentiable one_ne_zero) (-y)).hasFDerivAt.comp y (hasFDerivAt_id y).neg
    rw [show (η ∘ fun z => -z) = η from funext heven] at h1
    ext v
    rw [h1.fderiv]
    simp
  -- Step 2: `D(η * u)(x) = (Dη * u)(x)`, so `D(η * u)(x)(s x) = ∫ Dη(x − z)(s x) u(z) dz`.
  have hLHS : ∀ x, fderiv ℝ (convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume) x (s x) =
      ∫ z, fderiv ℝ η (x - z) (s x) * u z := by
    intro x
    rw [(hηc.hasFDerivAt_convolution_left _ hη hu.locallyIntegrable x).fderiv, convolution_eq_swap,
      ContinuousLinearMap.integral_apply
        ((hDcs.convolutionExists_left _ hDc hu.locallyIntegrable x).integrable_swap)]
    simp
  -- Step 3: `div(η * s)(z) = trace D(η * s)(z) = ∫ Dη(z − x)(s x) dx`: the trace `T` is a
  -- continuous linear functional, and the trace of the rank-one map `v ↦ a(v) w` is `a(w)`.
  have hRHS : ∀ z, LinearMap.trace ℝ (Euclid P)
      (fderiv ℝ (convolution η s (ContinuousLinearMap.lsmul ℝ ℝ) volume) z :
        Euclid P →ₗ[ℝ] Euclid P) = ∫ x, fderiv ℝ η (z - x) (s x) := by
    let T : (Euclid P →L[ℝ] Euclid P) →L[ℝ] ℝ := LinearMap.toContinuousLinearMap
      (LinearMap.trace ℝ (Euclid P) ∘ₗ ContinuousLinearMap.coeLM ℝ)
    have hTA : ∀ A : Euclid P →L[ℝ] Euclid P,
        T A = LinearMap.trace ℝ (Euclid P) (A : Euclid P →ₗ[ℝ] Euclid P) := fun A => rfl
    have hrk : ∀ (a : Euclid P →L[ℝ] ℝ) (w : Euclid P), T (ContinuousLinearMap.precompL (Euclid P)
        (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] Euclid P →L[ℝ] Euclid P) a w) = a w := by
      intro a w
      have h : ((ContinuousLinearMap.precompL (Euclid P)
          (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] Euclid P →L[ℝ] Euclid P) a w :
            Euclid P →L[ℝ] Euclid P) : Euclid P →ₗ[ℝ] Euclid P) =
          (a : Euclid P →ₗ[ℝ] ℝ).smulRight w := by
        ext v
        simp
      rw [hTA, h, LinearMap.trace_smulRight]
      rfl
    intro z
    rw [(hηc.hasFDerivAt_convolution_left _ hη hs.locallyIntegrable z).fderiv, convolution_eq_swap]
    have hT := ContinuousLinearMap.integral_comp_comm T
      ((hDcs.convolutionExists_left (ContinuousLinearMap.precompL (Euclid P)
        (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] Euclid P →L[ℝ] Euclid P)) hDc
          hs.locallyIntegrable z).integrable_swap)
    simp_rw [hrk] at hT
    exact hT.symm
  -- Step 4: Fubini for `H(x, z) = Dη(x − z)(s x) u(z)`, dominated by `C ‖s x‖ |u z|`.
  have hint : Integrable (uncurry fun x z => fderiv ℝ η (x - z) (s x) * u z)
      ((volume : Measure (Euclid P)).prod volume) := by
    refine Integrable.mono' ((hs.norm.mul_prod hu.norm).const_mul C) ?_ (Eventually.of_forall ?_)
    · exact ((ContinuousLinearMap.apply ℝ ℝ).aestronglyMeasurable_comp₂
        hs.aestronglyMeasurable.comp_fst
        (hDc.comp (continuous_fst.sub continuous_snd)).aestronglyMeasurable).mul
        hu.aestronglyMeasurable.comp_snd
    · rintro ⟨x, z⟩
      simp only [uncurry_apply_pair, norm_mul]
      calc ‖fderiv ℝ η (x - z) (s x)‖ * ‖u z‖ ≤ (C * ‖s x‖) * ‖u z‖ := by
            gcongr
            exact ((fderiv ℝ η (x - z)).le_opNorm (s x)).trans (by gcongr; exact hC _)
        _ = C * (‖s x‖ * ‖u z‖) := by ring
  -- Step 5: combine, using `Dη(z − x) = −Dη(x − z)` to identify the swapped integral.
  calc ∫ x, fderiv ℝ (convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume) x (s x)
      = ∫ x, ∫ z, fderiv ℝ η (x - z) (s x) * u z := by simp_rw [hLHS]
    _ = ∫ z, ∫ x, fderiv ℝ η (x - z) (s x) * u z := integral_integral_swap hint
    _ = -∫ z, u z * LinearMap.trace ℝ (Euclid P)
          (fderiv ℝ (convolution η s (ContinuousLinearMap.lsmul ℝ ℝ) volume) z :
            Euclid P →ₗ[ℝ] Euclid P) := by
      rw [← integral_neg]
      congr 1
      funext z
      rw [hRHS z, ← integral_const_mul, ← integral_neg]
      congr 1
      funext x
      rw [← neg_sub x z, hodd, neg_apply]
      ring
/-- Mollification does not increase the variation (Simon Ch. 2, Lemma 2.5, formula (4)): if
`|∫ u div g| ≤ M` for every `g ∈ C¹_c(ℝᴾ; ℝᴾ)` with `|g| ≤ 1`, then `∫ |D(η * u)| ≤ M` for an even
mollifier `η ≥ 0` with `∫ η = 1`.  With `w = η * u`, the field `s = 1_{spt w} |∇w|⁻¹ ∇w`
(`0⁻¹ = 0`) is Borel, bounded by `1`, compactly supported and has `Dw(s) = |Dw|`;
`codim1_rdo_dg_sp_mollifier_adjoint` moves `η` onto `s`, and `g = η * s` is admissible. -/
theorem codim1_rdo_dg_sp_mollify_variation : ∀ (P : ℕ) (u : Euclid P → ℝ) (M : ℝ), Integrable u → HasCompactSupport u → (∀ g : Euclid P → Euclid P, ContDiff ℝ 1 g → HasCompactSupport g → (∀ z, ‖g z‖ ≤ 1) → |∫ z, u z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ g z : Euclid P →ₗ[ℝ] Euclid P)| ≤ M) → ∀ η : Euclid P → ℝ, ContDiff ℝ 1 η → HasCompactSupport η → (∀ z, 0 ≤ η z) → (∀ z, η (-z) = η z) → ∫ z, η z = 1 → ∫ z, ‖fderiv ℝ (convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume) z‖ ≤ M := by
  intro P u M hu huc hM η hη hηc hη0 heven hη1
  -- Step 1: `w = η * u` is `C¹` with compact support `S = spt w`.
  set w := convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume
  have hwc : HasCompactSupport w := hηc.convolution _ huc
  have hDw : Continuous (fderiv ℝ w) :=
    (hηc.contDiff_convolution_left _ hη hu.locallyIntegrable).continuous_fderiv one_ne_zero
  set S := tsupport w
  have hSm : MeasurableSet S := (isClosed_tsupport w).measurableSet
  -- Step 2: the gradient `∇w = (toDual)⁻¹ Dw` is continuous, `|∇w| = |Dw|`, `Dw(∇w) = |∇w|²`.
  set grad : Euclid P → Euclid P :=
    fun x => (InnerProductSpace.toDual ℝ (Euclid P)).symm (fderiv ℝ w x)
  have hgc : Continuous grad := (InnerProductSpace.toDual ℝ (Euclid P)).symm.continuous.comp hDw
  have hgn : ∀ x, ‖grad x‖ = ‖fderiv ℝ w x‖ := fun x => LinearIsometryEquiv.norm_map _ _
  have hgg : ∀ x, fderiv ℝ w x (grad x) = ‖grad x‖ ^ 2 := by
    intro x
    rw [← InnerProductSpace.toDual_symm_apply (𝕜 := ℝ) (x := grad x) (y := fderiv ℝ w x)]
    exact real_inner_self_eq_norm_sq _
  -- Step 3: the unit field `f = |∇w|⁻¹ ∇w` (`0⁻¹ = 0`) and `s = 1_S f`.
  set f : Euclid P → Euclid P := fun x => ‖grad x‖⁻¹ • grad x with hf
  have hfm : Measurable f := hgc.norm.measurable.inv.smul hgc.measurable
  have hf1 : ∀ x, ‖f x‖ ≤ 1 := by
    intro x
    simp only [hf, norm_smul, norm_inv, norm_norm]
    rcases eq_or_ne ‖grad x‖ 0 with h | h
    · simp [h]
    · rw [inv_mul_cancel₀ h]
  set s : Euclid P → Euclid P := S.indicator f with hs
  have hs1 : ∀ x, ‖s x‖ ≤ 1 := fun x => (norm_indicator_le_norm_self f x).trans (hf1 x)
  have hsc : HasCompactSupport s :=
    HasCompactSupport.intro hwc.isCompact fun x hx => indicator_of_notMem hx f
  have hsi : Integrable s := by
    rw [hs, integrable_indicator_iff hSm]
    exact Measure.integrableOn_of_bounded hwc.isCompact.measure_lt_top.ne
      hfm.aestronglyMeasurable (Eventually.of_forall hf1)
  -- Step 4: `Dw(x)(s x) = |Dw(x)|` for all `x`.
  have hDs : ∀ x, fderiv ℝ w x (s x) = ‖fderiv ℝ w x‖ := by
    intro x
    by_cases hx : x ∈ S
    · simp only [hs, indicator_of_mem hx, hf, map_smul, hgg, smul_eq_mul, ← hgn]
      rcases eq_or_ne ‖grad x‖ 0 with h | h
      · simp [h]
      · field_simp
    · rw [fderiv_of_notMem_tsupport ℝ hx]
      simp
  -- Step 5: `g = η * s` is admissible: `C¹`, compact support, `|g| ≤ ∫ η = 1`.
  set g := convolution η s (ContinuousLinearMap.lsmul ℝ ℝ) volume with hg
  have hgC1 : ContDiff ℝ 1 g := hηc.contDiff_convolution_left _ hη hsi.locallyIntegrable
  have hgcs : HasCompactSupport g := hηc.convolution _ hsc
  have hηi : Integrable η := hη.continuous.integrable_of_hasCompactSupport hηc
  have hg1 : ∀ z, ‖g z‖ ≤ 1 := by
    intro z
    rw [hg, convolution_def]
    refine (norm_integral_le_of_norm_le hηi (Eventually.of_forall fun t => ?_)).trans hη1.le
    rw [ContinuousLinearMap.lsmul_apply, norm_smul, Real.norm_of_nonneg (hη0 t)]
    exact mul_le_of_le_one_right (hη0 t) (hs1 _)
  -- Steps 6–7: the adjoint identity, then the hypothesis for `g`.
  calc ∫ z, ‖fderiv ℝ w z‖ = ∫ z, fderiv ℝ w z (s z) :=
        integral_congr_ae (Eventually.of_forall fun z => (hDs z).symm)
    _ = -∫ z, u z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ g z : Euclid P →ₗ[ℝ] Euclid P) :=
        Submission.codim1_rdo_dg_sp_mollifier_adjoint P η u s hη hηc heven hu hsi
    _ ≤ |∫ z, u z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ g z : Euclid P →ₗ[ℝ] Euclid P)| :=
        neg_le_abs _
    _ ≤ M := hM g hgC1 hgcs hg1

/-- **Integer density, layers and truncation bounds** (Simon Ch. 6, first step and (3)–(7) of the
proof of 3.14; Remarks 2.35, 3.15; Ch. 2, Lemma 2.5).  An integer multiplicity `R ∈ 𝒟_{n+1}(ℝ^{n+1})`
with compact support is `R(ω) = ∫ θ ω(e)` for an integrable integer density `θ` vanishing off
`spt R`: an orientation of an `(n+1)`-plane in `ℝ^{n+1}` is `±e₀ ∧ ⋯ ∧ eₙ`, and `θ = 0` a.e. off
`spt R` by `dtc_vanish_off_support`.  The layers `Uⱼ = {θ ≥ j}` give `Xⱼ = [[Uⱼ]]` with
`Σⱼ ∂Xⱼ = ∂R` (dominated convergence, `∫ dη(e) = 0`).  For the mass bounds, `∂R` tested with `⋆g`
bounds `∫ θ div g` for smooth fields `|g| ≤ 1`; for an admissible `η`, integration by parts and
`codim1_rdo_dg_sp_mollifier_adjoint` give `∫ Ψ(ρₖ * θ) dη(e) ≤ M(∂R)` for Simon's smoothed
truncations `Ψ` (`|Ψ'| ≤ 1`, `Ψ = (1 - 4δ) Σⱼ 1_{[j,∞)}` on `ℤ`); letting `k → ∞` (Lebesgue
differentiation) and `δ → 0` bounds `M(Σ_{j=a}^b ∂Xⱼ)`. -/
theorem dtc_bc_lc_fd_bim_layers : ∀ (n : ℕ) (R : GeometricCurrentOn (univ : Set (Euclid (n + 1))) (n + 1)), IsIntegerMultiplicity R → IsCompact R.support → ∃ (U : ℤ → Set (Euclid (n + 1))) (X : ℤ → GeometricCurrentOn (univ : Set (Euclid (n + 1))) (n + 1)), (∀ j, MeasurableSet (U j)) ∧ (∀ j, U (j + 1) ⊆ U j) ∧ (∀ (j : ℤ) (ω : TestFormOn (univ : Set (Euclid (n + 1))) (n + 1)), X j ω = ∫ x in U j, (ω : DifferentialForm (Euclid (n + 1)) (n + 1)) x (fun i => EuclideanSpace.single i (1 : ℝ))) ∧ (∀ η : TestFormOn (univ : Set (Euclid (n + 1))) n, HasSum (fun j => (X j).boundary η) (R.boundary η)) ∧ (∀ j, (X j).boundary.mass ≤ R.boundary.mass) ∧ ∀ (N : ℕ) (Y : GeometricCurrentOn (univ : Set (Euclid (n + 1))) n), (∀ η : TestFormOn (univ : Set (Euclid (n + 1))) n, Y η = ∑ j ∈ Finset.Icc (-(N : ℤ)) N, (X j).boundary η) → Y.mass ≤ R.boundary.mass := by
  intro n R hIM hcpt
  classical
  -- Step 1. The determinant covector `D` of the standard basis `e`: `α = α(e) D` for every
  -- `(n+1)`-covector `α`, and `D(τ) = ±1` for orthonormal `τ`.
  obtain ⟨D, hD, hDe, hαD⟩ : ∃ D : Covector (Euclid (n + 1)) (n + 1),
      (∀ v, D v = (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis.det v) ∧
      D (fun i => EuclideanSpace.single i (1 : ℝ)) = 1 ∧
      (∀ (α : Covector (Euclid (n + 1)) (n + 1)) (v : Fin (n + 1) → Euclid (n + 1)),
        α v = α (fun i => EuclideanSpace.single i (1 : ℝ)) * D v) := by
    have hcont : Continuous fun v : Fin (n + 1) → Euclid (n + 1) =>
        (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis.det v := by
      simp only [Module.Basis.det_apply]
      refine Continuous.matrix_det (continuous_pi fun i => continuous_pi fun j => ?_)
      simp only [Module.Basis.toMatrix_apply, OrthonormalBasis.coe_toBasis_repr_apply,
        EuclideanSpace.basisFun_repr]
      exact (EuclideanSpace.proj i).continuous.comp (continuous_apply j)
    have hbe : ⇑(EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis =
        fun i => EuclideanSpace.single i (1 : ℝ) := by
      funext i; simp
    refine ⟨⟨⟨(EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis.det.toMultilinearMap, hcont⟩,
      (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis.det.map_eq_zero_of_eq'⟩, fun v => rfl, ?_, ?_⟩
    · change (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis.det _ = 1
      rw [← hbe, Module.Basis.det_self]
    · intro α v
      have h := AlternatingMap.eq_smul_basis_det (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis
        α.toAlternatingMap
      rw [hbe] at h
      exact congrArg (fun f : Euclid (n + 1) [⋀^Fin (n + 1)]→ₗ[ℝ] ℝ => f v) h
  have hDτ : ∀ τ : Fin (n + 1) → Euclid (n + 1), Orthonormal ℝ τ → D τ = 1 ∨ D τ = -1 := by
    intro τ hτ
    have hsp := hτ.linearIndependent.span_eq_top_of_card_eq_finrank'
      (by rw [finrank_euclideanSpace, Fintype.card_fin])
    have h := OrthonormalBasis.det_to_matrix_orthonormalBasis_real
      (EuclideanSpace.basisFun (Fin (n + 1)) ℝ) (OrthonormalBasis.mk hτ hsp.ge)
    rwa [OrthonormalBasis.coe_mk, ← hD] at h
  -- Step 2. `R` is given by an integrable integer density `θ` vanishing off `spt R`.
  obtain ⟨θ, hθm, hθ0, hθi, hRθ⟩ : ∃ θ : Euclid (n + 1) → ℤ, Measurable θ ∧
      (∀ x ∉ R.support, θ x = 0) ∧ Integrable (fun x => (θ x : ℝ)) ∧
      ∀ ω : TestFormOn (univ : Set (Euclid (n + 1))) (n + 1),
        R ω = ∫ x, (θ x : ℝ) * (ω : DifferentialForm (Euclid (n + 1)) (n + 1)) x
          (fun i => EuclideanSpace.single i (1 : ℝ)) := by
    obtain ⟨Rep, hRep⟩ := hIM
    have hμ : (μHE[n + 1] : Measure (Euclid (n + 1))) = volume :=
      EuclideanSpace.euclideanHausdorffMeasure_eq_volume (n + 1)
    have hVm : MeasurableSet Rep.carrier := Rep.measurableSet_carrier
    -- `ξ(x)(α) = α(e) s(x)` with `s(x) = ξ(x)(D)`
    have horient : ∀ x (α : Covector (Euclid (n + 1)) (n + 1)), Rep.orient x α =
        α (fun i => EuclideanSpace.single i (1 : ℝ)) * Rep.orient x D := by
      intro x α
      have hα : α = α (fun i => EuclideanSpace.single i (1 : ℝ)) • D := by
        ext v
        rw [ContinuousAlternatingMap.smul_apply, smul_eq_mul]
        exact hαD α v
      conv_lhs => rw [hα]
      rw [map_smul, smul_eq_mul]
    have hsm : AEStronglyMeasurable (fun x => Rep.orient x D) (volume.restrict Rep.carrier) :=
      hμ ▸ (continuous_eval_const D).comp_aestronglyMeasurable Rep.aestronglyMeasurable_orient
    have hs1 : ∀ᵐ x ∂(volume.restrict Rep.carrier), Rep.orient x D = 1 ∨ Rep.orient x D = -1 := by
      rw [← hμ]
      filter_upwards [Rep.orients] with x hx
      obtain ⟨Q, -, τ, hτ, -, hξ⟩ := hx
      rcases hξ with h | h <;> rw [h D] <;> rcases hDτ τ hτ with h' | h' <;> rw [h']
      exacts [Or.inl rfl, Or.inr rfl, Or.inr rfl, Or.inl (neg_neg 1)]
    -- the integer density `θ₁ = ±θ₀` on `V`
    obtain ⟨s', hs'm, hss'⟩ : ∃ s' : Euclid (n + 1) → ℝ, Measurable s' ∧
        (fun x => Rep.orient x D) =ᵐ[volume.restrict Rep.carrier] s' :=
      ⟨_, hsm.stronglyMeasurable_mk.measurable, hsm.ae_eq_mk⟩
    obtain ⟨θ₁, hθ₁⟩ : ∃ θ₁ : Euclid (n + 1) → ℤ, ∀ x, θ₁ x = if x ∈ Rep.carrier then
        (if 0 < s' x then (Rep.mult x : ℤ) else -(Rep.mult x : ℤ)) else 0 := ⟨_, fun x => rfl⟩
    have hθ₁m : Measurable θ₁ := (funext hθ₁ : θ₁ = _) ▸
      Measurable.ite hVm (Measurable.ite (measurableSet_lt measurable_const hs'm)
        (measurable_from_nat.comp Rep.measurable_mult)
        ((measurable_from_nat (f := fun m : ℕ => -(m : ℤ))).comp Rep.measurable_mult))
        measurable_const
    have hθ₁m' : Measurable fun x => (θ₁ x : ℝ) := measurable_from_top.comp hθ₁m
    have hθ₁ae : ∀ᵐ x ∂(volume.restrict Rep.carrier), ∀ α : Covector (Euclid (n + 1)) (n + 1),
        (Rep.mult x : ℝ) * Rep.orient x α = (θ₁ x : ℝ) * α (fun i => EuclideanSpace.single i (1 : ℝ)) := by
      filter_upwards [hs1, hss', ae_restrict_mem hVm] with x hx hxs hxV α
      rw [horient x α, hθ₁ x, ite_eq_left hxV, ← hxs]
      rcases hx with h | h <;> rw [h]
      · rw [ite_eq_left one_pos, mul_one, Int.cast_natCast]
      · rw [ite_eq_right (lt_asymm neg_one_lt_zero), mul_neg_one, Int.cast_neg, Int.cast_natCast,
          neg_mul, mul_neg]
    -- `R(ω) = ∫ θ₁ ω(e)`
    have hRθ₁ : ∀ ω : TestFormOn (univ : Set (Euclid (n + 1))) (n + 1),
        R ω = ∫ x, (θ₁ x : ℝ) * (ω : DifferentialForm (Euclid (n + 1)) (n + 1)) x
          (fun i => EuclideanSpace.single i (1 : ℝ)) := by
      intro ω
      rw [hRep ω, IMRep.action, hμ, setIntegral_congr_ae hVm (by
          filter_upwards [ae_restrict_iff' hVm |>.1 hθ₁ae] with x hx hxV using hx hxV _)]
      refine setIntegral_eq_integral_of_forall_compl_eq_zero fun x hx => ?_
      rw [hθ₁ x, ite_eq_right hx, Int.cast_zero, zero_mul]
    -- local integrability of `θ₁`
    have hθ₁loc : LocallyIntegrable (fun x => (θ₁ x : ℝ)) volume := by
      rw [locallyIntegrable_iff]
      intro K hK
      refine ⟨hθ₁m'.aestronglyMeasurable, ?_⟩
      have hnorm : ∀ x, ‖(θ₁ x : ℝ)‖ₑ = Rep.carrier.indicator (fun x => (Rep.mult x : ℝ≥0∞)) x := by
        intro x
        rw [hθ₁ x]
        by_cases hx : x ∈ Rep.carrier
        · rw [ite_eq_left hx, indicator_of_mem hx]
          split_ifs
          · rw [Int.cast_natCast, Real.enorm_natCast]
          · rw [Int.cast_neg, Int.cast_natCast, enorm_neg, Real.enorm_natCast]
        · rw [ite_eq_right hx, indicator_of_notMem hx, Int.cast_zero, enorm_zero]
      rw [HasFiniteIntegral, lintegral_congr hnorm, lintegral_indicator hVm,
        Measure.restrict_restrict hVm, ← hμ]
      exact (Rep.locallyIntegrable_mult K hK (subset_univ K)).lt_top
    -- `θ₁ = 0` a.e. off `spt R`
    have hZ : ∀ᵐ x ∂volume, x ∈ R.zeroRegion → (θ₁ x : ℝ) = 0 := by
      refine R.isOpen_zeroRegion.ae_eq_zero_of_integral_contDiff_smul_eq_zero
        (hθ₁loc.locallyIntegrableOn _) fun g hg hgc hgZ => ?_
      have h0 := Submission.dtc_vanish_off_support (n + 1) (n + 1) univ R
        ⟨fun x => g x • D, ⟨⟨hg.smul_const D, hgc.smul_right⟩, subset_univ _⟩⟩
        (Set.disjoint_left.2 fun x hx hxR => hxR.2 (hgZ (tsupport_smul_subset_left _ _ hx)))
      rw [hRθ₁] at h0
      rw [← h0]
      refine integral_congr_ae (Eventually.of_forall fun x => ?_)
      change g x • (θ₁ x : ℝ) = (θ₁ x : ℝ) * (g x • D) (fun i => EuclideanSpace.single i (1 : ℝ))
      rw [ContinuousAlternatingMap.smul_apply, hDe, smul_eq_mul, smul_eq_mul, mul_one, mul_comm]
    -- `θ = θ₁ 1_{spt R}`
    have hSm : MeasurableSet R.support := MeasurableSet.univ.diff R.isOpen_zeroRegion.measurableSet
    refine ⟨fun x => if x ∈ R.support then θ₁ x else 0, Measurable.ite hSm hθ₁m measurable_const,
      fun x hx => ite_eq_right hx, ?_, fun ω => ?_⟩
    · refine ((integrable_indicator_iff hSm).2 (hθ₁loc.integrableOn_isCompact hcpt)).congr
        (Eventually.of_forall fun x => ?_)
      dsimp only
      by_cases hx : x ∈ R.support
      · rw [indicator_of_mem hx, ite_eq_left hx]
      · rw [indicator_of_notMem hx, ite_eq_right hx, Int.cast_zero]
    · rw [hRθ₁ ω]
      refine integral_congr_ae ?_
      filter_upwards [hZ] with x hx
      by_cases hxs : x ∈ R.support
      · rw [ite_eq_left hxs]
      · rw [ite_eq_right hxs, hx (by_contra fun h => hxs ⟨mem_univ x, h⟩), Int.cast_zero]
  have hθc : HasCompactSupport fun x => (θ x : ℝ) :=
    HasCompactSupport.intro hcpt fun x hx => by rw [hθ0 x hx, Int.cast_zero]
  -- Step 3. The currents `[[S]](ω) = ∫_S ω(e)`.
  have hcur : ∀ S : Set (Euclid (n + 1)), ∃ T : GeometricCurrentOn (univ : Set (Euclid (n + 1))) (n + 1),
      ∀ ω : TestFormOn (univ : Set (Euclid (n + 1))) (n + 1), T ω = ∫ x in S,
        (ω : DifferentialForm (Euclid (n + 1)) (n + 1)) x (fun i => EuclideanSpace.single i (1 : ℝ)) := by
    intro S
    have hint : ∀ ω : TestFormOn (univ : Set (Euclid (n + 1))) (n + 1),
        Integrable (fun x => (ω : DifferentialForm (Euclid (n + 1)) (n + 1)) x
          (fun i => EuclideanSpace.single i (1 : ℝ))) := fun ω =>
      ((continuous_eval_const _).comp ω.property.1.1.continuous).integrable_of_hasCompactSupport
        (ω.property.1.2.comp_left rfl)
    refine ⟨⟨{ toFun := (fun ω => ∫ x in S, (ω : DifferentialForm (Euclid (n + 1)) (n + 1)) x
                  (fun i => EuclideanSpace.single i (1 : ℝ))),
                map_add' := fun ω₁ ω₂ => integral_add (hint ω₁).integrableOn (hint ω₂).integrableOn,
                map_smul' := fun c ω => integral_const_mul c _ }, fun ωs hωs => ?_⟩, fun ω => rfl⟩
    obtain ⟨K, hK, -, hsupp, -, hconv⟩ := hωs
    have h0 := Metric.tendstoUniformlyOn_iff.1 (hconv 0)
    rw [Metric.tendsto_nhds]
    intro ε hε
    have hC : 0 ≤ volume.real K := measureReal_nonneg
    filter_upwards [h0 (ε / (volume.real K + 1)) (by positivity)] with j hj
    have hbd : ∀ x, ‖(ωs j : DifferentialForm (Euclid (n + 1)) (n + 1)) x
        (fun i => EuclideanSpace.single i (1 : ℝ))‖ ≤ K.indicator (fun _ => ε / (volume.real K + 1)) x := by
      intro x
      by_cases hx : x ∈ K
      · rw [indicator_of_mem hx]
        refine (((ωs j : DifferentialForm (Euclid (n + 1)) (n + 1)) x).le_opNorm _).trans ?_
        have h1 := hj x hx
        have hz : iteratedFDeriv ℝ 0 ((0 : TestFormOn (univ : Set (Euclid (n + 1))) (n + 1)) :
            DifferentialForm (Euclid (n + 1)) (n + 1)) x = 0 := by
          ext m; rw [iteratedFDeriv_zero_apply]; rfl
        rw [hz, dist_zero_left, norm_iteratedFDeriv_zero] at h1
        simp only [PiLp.norm_single, norm_one, Finset.prod_const_one, mul_one]
        exact h1.le
      · rw [indicator_of_notMem hx, image_eq_zero_of_notMem_tsupport (fun h => hx (hsupp j h))]
        simp
    rw [dist_zero_right]
    calc ‖∫ x in S, (ωs j : DifferentialForm (Euclid (n + 1)) (n + 1)) x
          (fun i => EuclideanSpace.single i (1 : ℝ))‖
        ≤ ∫ x in S, K.indicator (fun _ => ε / (volume.real K + 1)) x :=
