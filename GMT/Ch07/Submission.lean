      obtain ⟨h₁, hh₁L, hh₁eq⟩ := hH₀.extend_finite_dimension
      have hpq : ∀ y, L.starProjection (Lᗮ.starProjection y) = 0 := fun y => by
        rw [Submodule.starProjection_apply L, Submodule.orthogonalProjectionOnto_eq_zero_iff.mpr
