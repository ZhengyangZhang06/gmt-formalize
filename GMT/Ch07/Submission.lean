    have htsX : tsupport X ⊆ SX := closure_minimal hsuppX hSXclosed
    have hSXZ : SX ⊆ Z := by
      intro z hz
      rw [hSX] at hz
      exact (hZ' z).2 ⟨hζs hz.1, mem_ball_zero_iff.2 (hz.2.trans_lt ht₁t)⟩
    have hSXcpt : IsCompact SX := by
      refine isCompact_of_isClosed_isBounded hSXclosed ((Metric.isBounded_closedBall (x := y)
        (r := s + t₁)).subset fun z hz => ?_)
      rw [hSX] at hz
      rw [mem_closedBall, dist_eq_norm]
      have h1 : ‖π (z - y)‖ < s := by
        have := hζs hz.1
        rw [hB, mem_ball_zero_iff] at this
        exact this
      calc ‖z - y‖ = ‖ι (π (z - y)) + ι' (π' (z - y))‖ := by rw [← hdecomp]
        _ ≤ ‖ι (π (z - y))‖ + ‖ι' (π' (z - y))‖ := norm_add_le _ _
        _ = ‖π (z - y)‖ + ‖π' (z - y)‖ := by rw [LinearIsometry.norm_map, LinearIsometry.norm_map]
        _ ≤ s + t₁ := add_le_add h1.le hz.2
    have hXcs : HasCompactSupport X := hSXcpt.of_isClosed_subset (isClosed_tsupport X) htsX
    have hXF : ∀ a ∈ B, X (F a) = ι' (ζ a) := by
      intro a ha
      rw [hX]
      show ψ (‖π' (F a - y)‖ ^ 2) • ι' (ζ (π (F a - y))) = ι' (ζ a)
      rw [hπF, hπ'F]
      by_cases hat : a ∈ tsupport ζ
      · rw [hψ1 _ (pow_le_pow_left₀ (norm_nonneg _) (ht₀ a hat) 2), one_smul]
      · rw [image_eq_zero_of_notMem_tsupport hat, map_zero, smul_zero]
    -- the integrand `f = div_M X`
    obtain ⟨f, hf⟩ : ∃ f : Pz → ℝ, f = fun x => LinearMap.trace ℝ Pz
        ((Submodule.span ℝ (T x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ X x).toLinearMap) :=
      ⟨_, rfl⟩
    have hstat' : ∫ x in M, f x ∂μHE[Module.finrank ℝ E] = 0 := by
      rw [hf]; exact hstat X hXsmooth hXcs (htsX.trans (hSXZ.trans hZU))
    have hf0 : ∀ x ∉ Z, f x = 0 := by
      intro x hx
      have hD : fderiv ℝ X x = 0 := by
        by_contra h
        exact hx (hSXZ (htsX (support_fderiv_subset ℝ h)))
      rw [hf]
      simp only [hD, ContinuousLinearMap.toLinearMap_zero, LinearMap.comp_zero, map_zero]
    have hstep1 : ∫ x in M, f x ∂μHE[Module.finrank ℝ E] =
        ∫ x in F '' B, f x ∂μHE[Module.finrank ℝ E] := by
      rw [← setIntegral_eq_integral_of_forall_compl_eq_zero hf0,
        Measure.restrict_restrict hZopen.measurableSet, inter_comm, hMZ]
    -- the two integrands
    obtain ⟨φ₁, hφ₁⟩ : ∃ φ₁ : E → ℝ,
        φ₁ = fun x => ∑ j, inner ℝ (fderiv ℝ u x (bE j)) (fderiv ℝ ζ x (bE j)) := ⟨_, rfl⟩
    obtain ⟨φ₂, hφ₂⟩ : ∃ φ₂ : E → ℝ, φ₂ = fun x => ∑ j, inner ℝ ((fderiv ℝ u x).comp
        (1 - J (fderiv ℝ u x) • R (fderiv ℝ u x)) (bE j)) (fderiv ℝ ζ x (bE j)) := ⟨_, rfl⟩
    -- `J(Du) div_M X ∘ F = ⟨Du - G(Du), Dζ⟩` on the ball
    have hfF : ∀ a ∈ B, J (fderiv ℝ u a) * f (F a) = φ₁ a - φ₂ a := by
      intro a ha
      obtain ⟨p, hp⟩ : ∃ p, p = fderiv ℝ u a := ⟨_, rfl⟩
      obtain ⟨W, hW⟩ : ∃ W, W = fderiv ℝ ζ a := ⟨_, rfl⟩
      have hgR' : ∀ z, (1 + ContinuousLinearMap.adjoint p ∘L p) (R p z) = z := fun z =>
        congrArg (fun T' : E →L[ℝ] E => T' z) (hgR p)
      have hRsa : ∀ v w : E, inner ℝ (R p v) w = inner ℝ v (R p w) := fun v w => by
        rw [← ContinuousLinearMap.adjoint_inner_right, hRadj]
      have hAAR : ∀ w, ContinuousLinearMap.adjoint (L p) (L p (R p w)) = w := fun w => by
        have h := congrArg (fun T' : E →L[ℝ] E => T' (R p w)) (hgram p)
        exact h.trans (hgR' w)
      have hspan_eq : Submodule.span ℝ (T (F a)) =
          LinearMap.range ((L p : E →L[ℝ] Pz) : E →ₗ[ℝ] Pz) := by
        have hset : (LinearMap.range ((L p : E →L[ℝ] Pz) : E →ₗ[ℝ] Pz) : Set Pz) =
            Set.range (L p) := by
          rw [LinearMap.coe_range, ContinuousLinearMap.coe_coe]
        rw [htan' a ha, ← hp, ← hset, Submodule.span_eq]
      have hproj : ∀ z, (Submodule.span ℝ (T (F a))).starProjection z =
          L p (R p (ContinuousLinearMap.adjoint (L p) z)) := by
        intro z
        refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero ?_ fun w hw => ?_
        · rw [hspan_eq]; exact ⟨_, rfl⟩
        · rw [hspan_eq] at hw
          obtain ⟨x, rfl⟩ := hw
          rw [ContinuousLinearMap.coe_coe, ← ContinuousLinearMap.adjoint_inner_left, map_sub, hAAR,
            sub_self, inner_zero_left]
      have hchain : ∀ x, fderiv ℝ X (F a) (L p x) = ι' (W x) := by
        have h1 : fderiv ℝ (X ∘ F) a = fderiv ℝ X (F a) ∘L fderiv ℝ F a :=
          fderiv_comp a (hXsmooth.differentiable one_ne_zero (F a)) (hFderiv a ha).differentiableAt
        have h2 : fderiv ℝ (X ∘ F) a = fderiv ℝ (fun b => ι'.toContinuousLinearMap (ζ b)) a := by
          apply Filter.EventuallyEq.fderiv_eq
          filter_upwards [hBopen.mem_nhds ha] with b hb
          exact hXF b hb
        have h3 : fderiv ℝ (fun b => ι'.toContinuousLinearMap (ζ b)) a =
            ι'.toContinuousLinearMap ∘L W := by
          rw [hW]
          exact (ι'.toContinuousLinearMap.hasFDerivAt.comp a
            (hζ.differentiable one_ne_zero a).hasFDerivAt).fderiv
        rw [hDF a ha, ← hp, h2, h3] at h1
        intro x
        exact (congrArg (fun T' : E →L[ℝ] Pz => T' x) h1).symm
      have hAι' : ∀ b, ContinuousLinearMap.adjoint (L p) (ι' b) = ContinuousLinearMap.adjoint p b := by
        intro b
        refine ext_inner_right ℝ fun v => ?_
        rw [ContinuousLinearMap.adjoint_inner_left, ContinuousLinearMap.adjoint_inner_left, hL]
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.comp_apply,
          LinearIsometry.coe_toContinuousLinearMap]
        rw [inner_add_right, real_inner_comm (ι v) (ι' b), hperp, zero_add,
          LinearIsometry.inner_map_map]
      have htr : f (F a) = ∑ j, inner ℝ (p (R p (bE j))) (W (bE j)) := by
        have e1 : (Submodule.span ℝ (T (F a))).starProjection.toLinearMap ∘ₗ
            (fderiv ℝ X (F a)).toLinearMap = (L p).toLinearMap ∘ₗ
            ((R p).toLinearMap ∘ₗ (ContinuousLinearMap.adjoint (L p)).toLinearMap ∘ₗ
              (fderiv ℝ X (F a)).toLinearMap) := LinearMap.ext fun z => hproj _
        have e2 : ((R p).toLinearMap ∘ₗ (ContinuousLinearMap.adjoint (L p)).toLinearMap ∘ₗ
              (fderiv ℝ X (F a)).toLinearMap) ∘ₗ (L p).toLinearMap =
            (R p).toLinearMap ∘ₗ (ContinuousLinearMap.adjoint p).toLinearMap ∘ₗ W.toLinearMap :=
          LinearMap.ext fun x => by
            show R p (ContinuousLinearMap.adjoint (L p) (fderiv ℝ X (F a) (L p x))) = _
            rw [hchain, hAι']; rfl
        rw [hf]
        show LinearMap.trace ℝ Pz ((Submodule.span ℝ (T (F a))).starProjection.toLinearMap ∘ₗ
          (fderiv ℝ X (F a)).toLinearMap) = _
        rw [e1, LinearMap.trace_comp_comm', e2, LinearMap.trace_eq_sum_inner _ bE]
        refine Finset.sum_congr rfl fun j _ => ?_
        show inner ℝ (bE j) (R p (ContinuousLinearMap.adjoint p (W (bE j)))) = _
        rw [← hRsa, ContinuousLinearMap.adjoint_inner_right]
      have hφ₁a : φ₁ a = ∑ j, inner ℝ (p (bE j)) (W (bE j)) := by rw [hφ₁, hp, hW]
      have hφ₂a : φ₂ a = ∑ j, inner ℝ ((p.comp (1 - J p • R p)) (bE j)) (W (bE j)) := by
        rw [hφ₂, hp, hW]
      rw [htr, hφ₁a, hφ₂a, ← hp, ← Finset.sum_sub_distrib, Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [← inner_sub_left, ContinuousLinearMap.comp_apply, ContinuousLinearMap.sub_apply,
        ContinuousLinearMap.one_apply, ContinuousLinearMap.smul_apply, map_sub, sub_sub_cancel,
        map_smul, real_inner_smul_left]
    -- pull the integral back to the ball with the area formula
    have hDucont : ContinuousOn (fderiv ℝ u) B := hu.continuousOn_fderiv_of_isOpen hBopen le_rfl
    have hDumeas : Measurable (fderiv ℝ u) := measurable_fderiv ℝ u
    have hDζc : Continuous (fderiv ℝ ζ) := hζ.continuous_fderiv one_ne_zero
    have hGc : Continuous (fun q : E →L[ℝ] K => q.comp (1 - J q • R q)) :=
      continuous_id.clm_comp (continuous_const.sub (hJc.smul hRc))
    have hφ₁meas : Measurable φ₁ := by
      rw [hφ₁]
      exact Finset.measurable_sum _ fun j _ => continuous_inner.measurable.comp
        (((ContinuousLinearMap.apply ℝ K (bE j)).continuous.measurable.comp hDumeas).prodMk
          ((ContinuousLinearMap.apply ℝ K (bE j)).continuous.measurable.comp hDζc.measurable))
    have hφ₂meas : Measurable φ₂ := by
      rw [hφ₂]
      exact Finset.measurable_sum _ fun j _ => continuous_inner.measurable.comp
        (((ContinuousLinearMap.apply ℝ K (bE j)).continuous.measurable.comp
          (hGc.measurable.comp hDumeas)).prodMk
          ((ContinuousLinearMap.apply ℝ K (bE j)).continuous.measurable.comp hDζc.measurable))
    obtain ⟨g', hg'⟩ : ∃ g' : Pz → ℝ, g' = fun x =>
        (φ₁ (π (x - y)) - φ₂ (π (x - y))) / J (fderiv ℝ u (π (x - y))) := ⟨_, rfl⟩
    have hπy : Measurable (fun x : Pz => π (x - y)) :=
      π.continuous.measurable.comp (measurable_id.sub_const y)
    have hg'meas : Measurable g' := by
      rw [hg']
      exact ((hφ₁meas.comp hπy).sub (hφ₂meas.comp hπy)).div
        (hJc.measurable.comp (hDumeas.comp hπy))
    have hfg' : EqOn f g' (F '' B) := by
      rintro _ ⟨a, ha, rfl⟩
      rw [hg']
      show f (F a) = (φ₁ (π (F a - y)) - φ₂ (π (F a - y))) / J (fderiv ℝ u (π (F a - y)))
      rw [hπF, ← hfF a ha, mul_div_cancel_left₀ _ (hJpos _).ne']
    have hstep2 : ∫ x in F '' B, f x ∂μHE[Module.finrank ℝ E] =
        ∫ a in B, (φ₁ a - φ₂ a) ∂μHE[Module.finrank ℝ E] := by
      rw [setIntegral_congr_fun hFBmeas hfg', AF2, integral_map hFae hg'meas.aestronglyMeasurable,
        integral_withDensity_eq_integral_toReal_smul hρmeas
          (Eventually.of_forall fun a => by rw [hρ]; exact ENNReal.ofReal_lt_top)]
      refine setIntegral_congr_fun hBmeas fun a ha => ?_
      rw [hρ, hg']
      show (ENNReal.ofReal (J (fderiv ℝ u a))).toReal • ((φ₁ (π (F a - y)) - φ₂ (π (F a - y))) /
        J (fderiv ℝ u (π (F a - y)))) = φ₁ a - φ₂ a
      rw [hπF, ENNReal.toReal_ofReal (hJpos _).le, smul_eq_mul, mul_div_assoc',
        mul_div_cancel_left₀ _ (hJpos _).ne']
    -- both integrands are integrable on the ball: continuous, supported in `spt ζ ⊆ B`
    have hDζ0 : ∀ x ∉ tsupport ζ, fderiv ℝ ζ x = 0 := fun x hx => by
      by_contra h; exact hx (support_fderiv_subset ℝ h)
    have hint : ∀ φ : E → ℝ, ContinuousOn φ B → (∀ x ∉ tsupport ζ, φ x = 0) →
        IntegrableOn φ B μHE[Module.finrank ℝ E] := fun φ hφ h0 =>
      ((hφ.mono hζs).integrableOn_compact hζc.isCompact).of_forall_sdiff_eq_zero hBmeas
        (fun x hx => h0 x hx.2)
    have hφ₁int : IntegrableOn φ₁ B μHE[Module.finrank ℝ E] := by
      refine hint φ₁ ?_ fun x hx => ?_
      · rw [hφ₁]
        exact continuousOn_finset_sum _ fun j _ => (hDucont.clm_apply continuousOn_const).inner
          (hDζc.continuousOn.clm_apply continuousOn_const)
      · rw [hφ₁]
        exact Finset.sum_eq_zero fun j _ => by
          rw [hDζ0 x hx, ContinuousLinearMap.zero_apply, inner_zero_right]
    have hφ₂int : IntegrableOn φ₂ B μHE[Module.finrank ℝ E] := by
      refine hint φ₂ ?_ fun x hx => ?_
      · rw [hφ₂]
        exact continuousOn_finset_sum _ fun j _ =>
          ((hGc.comp_continuousOn hDucont).clm_apply continuousOn_const).inner
          (hDζc.continuousOn.clm_apply continuousOn_const)
      · rw [hφ₂]
        exact Finset.sum_eq_zero fun j _ => by
          rw [hDζ0 x hx, ContinuousLinearMap.zero_apply, inner_zero_right]
    have key : ∫ x in B, φ₁ x ∂μHE[Module.finrank ℝ E] -
        ∫ x in B, φ₂ x ∂μHE[Module.finrank ℝ E] = 0 := by
      rw [← integral_sub hφ₁int hφ₂int, ← hstep2, ← hstep1, hstat']
    rw [hφ₁, hφ₂] at key
    simp only [← he, hGeq]
    exact sub_eq_zero.mp key
  intro m k _
  obtain ⟨G, hG1, hG2, hG3, hG4⟩ := hAll (E := Euclid m) (K := Euclid k)
  exact ⟨G, hG1, hG2, hG3, fun P U M y ι ι' s t u hperp hspan hs ht _ hZU hu hut hMZ htan _ hstat ζ hζ
    hζc hζs => hG4 (EuclideanSpace.basisFun (Fin m) ℝ) (fun j => EuclideanSpace.single j 1)
      (EuclideanSpace.basisFun_apply (Fin m) ℝ) m finrank_euclideanSpace_fin volume
      (EuclideanSpace.euclideanHausdorffMeasure_eq_volume m).symm U M (tangentSpace M) y ι ι' s t u
      hperp hspan hs ht hZU hu hut hMZ htan hstat ζ hζ hζc hζs⟩
/-- **A `C¹` field of tangent projections near a point of a `C²` submanifold** (Simon Ch. 4,
2.5–2.7; Ch. 2, 5.9).  Near `y₀ ∈ N ∩ U` there is a `C¹` field `Pt` of self-adjoint operators with
`‖DPt‖ ≤ β` on `B_{2r}(y₀)` such that `Pt(q)` is the orthogonal projection onto `T_qN` for every
`q ∈ N ∩ B_{3r}(y₀)`.  Instead of the nearest-point projection of a tubular neighbourhood we use a
`C¹` retraction parameter built from a `C²` chart `ψ : V → W`, `ψ(v₀) = y₀`: `Pt(y) = G(Dψ(σ(y)))`,
where `G(B) = B (B*B)⁻¹ B*` is the orthogonal projection onto `range B` and `σ = λ ∘ L` with `L` a
linear left inverse of `Dψ(v₀)` and `λ` a local inverse of `L ∘ ψ` (inverse function theorem), so
that `σ(ψ(z)) = z` near `v₀`.  `dsmc_chart_tangentSpace_eq_range` gives `T_{ψ(z)}N = range Dψ(z)`
and the continuity of `ψ⁻¹` at `y₀`; `β` bounds `‖DPt‖` on the compact `B̄_{2r}(y₀)`. -/
theorem Submission.dsmc_tangent_projection_field : ∀ (P d : ℕ) (U N : Set (Euclid P)) (y₀ : Euclid P), IsOpen U → IsEmbeddedSubmanifold 2 d N → y₀ ∈ N ∩ U → ∃ (r β : ℝ) (Pt : Euclid P → (Euclid P →L[ℝ] Euclid P)), 0 < r ∧ 0 ≤ β ∧ closedBall y₀ (3 * r) ⊆ U ∧ ContDiffOn ℝ 1 Pt (ball y₀ (3 * r)) ∧ (∀ y ∈ ball y₀ (3 * r), ∀ u w : Euclid P, inner ℝ (Pt y u) w = inner ℝ u (Pt y w)) ∧ (∀ y ∈ ball y₀ (2 * r), ‖fderiv ℝ Pt y‖ ≤ β) ∧ (∀ q ∈ N ∩ ball y₀ (3 * r), ∀ u : Euclid P, Pt q u ∈ tangentSpace N q) ∧ (∀ q ∈ N ∩ ball y₀ (3 * r), ∀ u ∈ tangentSpace N q, Pt q u = u) := by
  intro P d U N y₀ hU hN hy₀
  -- Step 1: a `C²` chart `ψ : V → W` with `y₀ = ψ(v₀)`; `T_{ψ(z)}N = range Dψ(z)` and `ψ⁻¹` is
  -- continuous at `y₀` (chart lemma); `z ↦ Dψ(z)` is `C¹` on `V`
  obtain ⟨hy₀N, hy₀U⟩ := hy₀
  obtain ⟨V, W, ψ, hV, hW, hy₀W, hψ, hinj, himg, hprop, hDψ⟩ := hN y₀ hy₀N
  obtain ⟨v₀, hv₀V, rfl⟩ : y₀ ∈ ψ '' V := by rw [himg]; exact ⟨hy₀W, hy₀N⟩
  have hchart := Submission.dsmc_chart_tangentSpace_eq_range P 2 d N V W ψ (by norm_num) hV hW hψ
    hinj himg hprop hDψ
  have hA : ContDiffOn ℝ 1 (fun z => fderiv ℝ ψ z) V := hψ.fderiv_of_isOpen hV (by norm_num)
  -- Step 2: for injective `B`, `G(B) = B (B*B)⁻¹ B*` is `C¹` near `B`, self-adjoint, maps into
  -- `range B` and fixes `range B` pointwise
  obtain ⟨G, hG⟩ : ∃ G : (Euclid d →L[ℝ] Euclid P) → (Euclid P →L[ℝ] Euclid P),
      ∀ B : Euclid d →L[ℝ] Euclid P, Injective B → ContDiffAt ℝ 1 G B ∧
        (∀ u w : Euclid P, inner ℝ (G B u) w = inner ℝ u (G B w)) ∧
        (∀ u : Euclid P, G B u ∈ Set.range B) ∧ ∀ a : Euclid d, G B (B a) = B a := by
    -- the real adjoint `B ↦ B*` as a continuous linear map
    let adjL : (Euclid d →L[ℝ] Euclid P) →L[ℝ] (Euclid P →L[ℝ] Euclid d) :=
      { toFun := fun B => ContinuousLinearMap.adjoint B
        map_add' := fun B C => by simp
        map_smul' := fun c B => by simp
        cont := ContinuousLinearMap.adjoint.continuous }
    have hadj : ∀ B, adjL B = ContinuousLinearMap.adjoint B := fun B => rfl
    refine ⟨fun B => B ∘L (Ring.inverse (adjL B ∘L B) ∘L adjL B), fun B hB => ?_⟩
    -- `C = B*B` is self-adjoint with `⟨C a, a⟩ = ‖B a‖²`, hence injective and a unit
    set C : Euclid d →L[ℝ] Euclid d := adjL B ∘L B with hC_def
    have hCsymm : ∀ x y : Euclid d, inner ℝ (C x) y = inner ℝ x (C y) := by
      intro x y
      simp only [hC_def, ContinuousLinearMap.comp_apply, hadj]
      rw [ContinuousLinearMap.adjoint_inner_left, ContinuousLinearMap.adjoint_inner_right]
    have hCinj : Injective C := by
      intro x y hxy
      have h0 : C (x - y) = 0 := by rw [map_sub, hxy, sub_self]
      have h1 : inner ℝ (C (x - y)) (x - y) = ‖B (x - y)‖ ^ 2 := by
        simp only [hC_def, ContinuousLinearMap.comp_apply, hadj]
        rw [ContinuousLinearMap.adjoint_inner_left, real_inner_self_eq_norm_sq]
      rw [h0, inner_zero_left] at h1
      have h2 : B (x - y) = 0 := by
        have : ‖B (x - y)‖ = 0 := by nlinarith [norm_nonneg (B (x - y))]
        exact norm_eq_zero.1 this
      exact sub_eq_zero.1 (hB (by rw [h2, map_zero]))
    have hCunit : IsUnit C := by
      rw [ContinuousLinearMap.isUnit_iff_bijective]
      exact ⟨hCinj, LinearMap.injective_iff_surjective.1 hCinj⟩
    -- `C⁻¹` is a two-sided inverse of `C`, and self-adjoint
    set Ci := Ring.inverse C
    have hCiC : ∀ x, Ci (C x) = x := fun x => by
      have := Ring.inverse_mul_cancel C hCunit
      simpa using congrArg (fun T : Euclid d →L[ℝ] Euclid d => T x) this
    have hCCi : ∀ x, C (Ci x) = x := fun x => by
      have := Ring.mul_inverse_cancel C hCunit
      simpa using congrArg (fun T : Euclid d →L[ℝ] Euclid d => T x) this
    have hCisymm : ∀ x y : Euclid d, inner ℝ (Ci x) y = inner ℝ x (Ci y) := by
      intro x y
      calc inner ℝ (Ci x) y = inner ℝ (Ci x) (C (Ci y)) := by rw [hCCi]
        _ = inner ℝ (C (Ci x)) (Ci y) := (hCsymm _ _).symm
        _ = inner ℝ x (Ci y) := by rw [hCCi]
    refine ⟨?_, ?_, fun u => ⟨_, rfl⟩, ?_⟩
    · -- `B' ↦ B'*B'` is smooth and `Ring.inverse` is smooth at the unit `C`
      obtain ⟨u, hu⟩ := hCunit
      have hinv : ContDiffAt ℝ 1
          (fun B' : Euclid d →L[ℝ] Euclid P => Ring.inverse (adjL B' ∘L B')) B := by
        have h1 : ContDiffAt ℝ 1 (fun B' : Euclid d →L[ℝ] Euclid P => adjL B' ∘L B') B :=
          adjL.contDiff.contDiffAt.clm_comp contDiffAt_id
        have h2 : ContDiffAt ℝ 1 Ring.inverse (adjL B ∘L B) := by
          have := contDiffAt_ringInverse ℝ (n := 1) u
          rw [hu] at this
          exact this
        exact ContDiffAt.comp (g := Ring.inverse)
          (f := fun B' : Euclid d →L[ℝ] Euclid P => adjL B' ∘L B') B h2 h1
      exact contDiffAt_id.clm_comp (hinv.clm_comp adjL.contDiff.contDiffAt)
    · intro u w
      simp only [ContinuousLinearMap.comp_apply]
      rw [← ContinuousLinearMap.adjoint_inner_right, ← hadj, hCisymm,
        hadj, ContinuousLinearMap.adjoint_inner_left]
      rfl
    · intro a
      simp only [ContinuousLinearMap.comp_apply]
      have : adjL B (B a) = C a := rfl
      rw [this, hCiC]
  -- Steps 3–4: a `C¹` map `σ` on an open `O ∋ y₀`, with values in `V`, such that `σ(ψ(z)) = z`
  -- for `z` in an open `O₁ ∋ v₀`.  A continuous linear left inverse `L` of `A = Dψ(v₀)` plays
  -- the role of the projection onto `T_{y₀}N = range A` (e.g. `L = A⁻¹ ∘ p_{range A}`), so
  -- `f = L ∘ ψ` has `Df(v₀) = id`; `λ` is the local inverse of `f` given by the inverse function
  -- theorem, restricted to an open set on which it is `C¹` and maps into `V`, and `σ = λ ∘ L`.
  obtain ⟨O, O₁, σ, hO, hO₁, hv₀O₁, hσ, hσV, hσψ⟩ : ∃ (O : Set (Euclid P)) (O₁ : Set (Euclid d))
      (σ : Euclid P → Euclid d), IsOpen O ∧ IsOpen O₁ ∧ v₀ ∈ O₁ ∧ ContDiffOn ℝ 1 σ O ∧
        MapsTo σ O V ∧ ∀ z ∈ O₁, ψ z ∈ O ∧ σ (ψ z) = z := by
    set A := fderiv ℝ ψ v₀
    obtain ⟨L₀, hL₀⟩ := LinearMap.exists_leftInverse_of_injective (A : Euclid d →ₗ[ℝ] Euclid P)
      (LinearMap.ker_eq_bot.2 (hDψ v₀ hv₀V))
    let L : Euclid P →L[ℝ] Euclid d := LinearMap.toContinuousLinearMap L₀
    have hLA : ∀ a, L (A a) = a := fun a => by
      have := LinearMap.congr_fun hL₀ a
      simpa [L] using this
    set f : Euclid d → Euclid d := fun z => L (ψ z)
    have hψat : ContDiffAt ℝ 1 ψ v₀ := (hψ.contDiffAt (hV.mem_nhds hv₀V)).of_le (by norm_num)
    have hfat : ContDiffAt ℝ 1 f v₀ := L.contDiff.contDiffAt.comp v₀ hψat
    have hderiv0 : HasFDerivAt f (L ∘L A) v₀ :=
      L.hasFDerivAt.comp v₀ (hψat.differentiableAt (by norm_num)).hasFDerivAt
    have hLA' : L ∘L A =
        ((ContinuousLinearEquiv.refl ℝ (Euclid d) : Euclid d ≃L[ℝ] Euclid d) :
          Euclid d →L[ℝ] Euclid d) := by
      ext1 a
      simp [hLA]
    have hderiv : HasFDerivAt f
        ((ContinuousLinearEquiv.refl ℝ (Euclid d) : Euclid d ≃L[ℝ] Euclid d) :
          Euclid d →L[ℝ] Euclid d) v₀ :=
      hLA' ▸ hderiv0
    have hstrict : HasStrictFDerivAt f
        ((ContinuousLinearEquiv.refl ℝ (Euclid d) : Euclid d ≃L[ℝ] Euclid d) :
          Euclid d →L[ℝ] Euclid d) v₀ :=
      hfat.hasStrictFDerivAt' hderiv one_ne_zero
    -- the inverse function theorem: a partial homeomorphism `e = f` near `v₀`
    set e := HasStrictFDerivAt.toOpenPartialHomeomorph f hstrict
    have he_coe : (e : Euclid d → Euclid d) = f := rfl
    have hv₀src : v₀ ∈ e.source := hstrict.mem_toOpenPartialHomeomorph_source
    have hfv₀tgt : f v₀ ∈ e.target := hstrict.image_mem_toOpenPartialHomeomorph_target
    have hsymm_v₀ : e.symm (f v₀) = v₀ := e.left_inv hv₀src
    have hsymm : ContDiffAt ℝ 1 e.symm (f v₀) := by
      refine e.contDiffAt_symm (f₀' := ContinuousLinearEquiv.refl ℝ (Euclid d)) hfv₀tgt ?_ ?_
      · rw [hsymm_v₀]; exact hderiv
      · rw [hsymm_v₀]; exact hfat
    -- `O₂ ∋ f(v₀)` open, inside the target, on which `e⁻¹` is `C¹` with values in `V`
    have hev : ∀ᶠ w in 𝓝 (f v₀), ContDiffAt ℝ 1 e.symm w := hsymm.eventually (by simp)
    have hpre : e.symm ⁻¹' V ∈ 𝓝 (f v₀) :=
      (e.continuousAt_symm hfv₀tgt).preimage_mem_nhds (by rw [hsymm_v₀]; exact hV.mem_nhds hv₀V)
    have hnhds : e.target ∩ (e.symm ⁻¹' V ∩ {w | ContDiffAt ℝ 1 e.symm w}) ∈ 𝓝 (f v₀) :=
      Filter.inter_mem (e.open_target.mem_nhds hfv₀tgt) (Filter.inter_mem hpre hev)
    obtain ⟨O₂, hO₂sub, hO₂open, hfv₀O₂⟩ := _root_.mem_nhds_iff.1 hnhds
    -- `O = L⁻¹(O₂)`, `O₁ = e.source ∩ f⁻¹(O₂)`, `σ = e⁻¹ ∘ L`
    refine ⟨L ⁻¹' O₂, e.source ∩ f ⁻¹' O₂, fun y => e.symm (L y), hO₂open.preimage L.continuous,
      ?_, ⟨hv₀src, hfv₀O₂⟩, ?_, fun y hy => (hO₂sub hy).2.1, ?_⟩
    · have : ContinuousOn f e.source := by rw [← he_coe]; exact e.continuousOn
      exact this.isOpen_inter_preimage e.open_source hO₂open
    · intro y hy
      have h1 : ContDiffAt ℝ 1 e.symm (L y) := (hO₂sub hy).2.2
      exact (h1.comp y L.contDiff.contDiffAt).contDiffWithinAt
    · rintro z ⟨hzsrc, hzO₂⟩
      refine ⟨hzO₂, ?_⟩
      show e.symm (f z) = z
      rw [← he_coe]
      exact e.left_inv hzsrc
  -- Step 5: `Pt(y) = G(Dψ(σ(y)))` is `C¹` on `O`
  set Pt : Euclid P → (Euclid P →L[ℝ] Euclid P) := fun y => G (fderiv ℝ ψ (σ y))
  have hPtO : ContDiffOn ℝ 1 Pt O := fun y hy =>
    (hG _ (hDψ _ (hσV hy))).1.comp_contDiffWithinAt y ((hA (σ y) (hσV hy)).comp y (hσ y hy) hσV)
  -- Step 6: `B_{ε₁}(v₀) ⊆ O₁`; `z ∈ V`, `|ψ(z) − y₀| < δ₁` give `|z − v₀| < ε₁`; choose `r > 0`
  -- with `3r ≤ δ₁` and `B̄_{3r}(y₀) ⊆ U ∩ W ∩ O`
  obtain ⟨ε₁, hε₁, hball⟩ := Metric.isOpen_iff.1 hO₁ v₀ hv₀O₁
  obtain ⟨δ₁, hδ₁, hδ₁'⟩ := (hchart v₀ hv₀V).2.1 ε₁ hε₁
  obtain ⟨ρ, hρ, hρsub⟩ := Metric.isOpen_iff.1 ((hU.inter hW).inter hO) (ψ v₀)
    ⟨⟨hy₀U, hy₀W⟩, (hσψ v₀ hv₀O₁).1⟩
  set r := min (ρ / 6) (δ₁ / 3)
  have hr : 0 < r := lt_min (by linarith) (by linarith)
  have h3r : 3 * r < ρ := by have := min_le_left (ρ / 6) (δ₁ / 3); linarith
  have h3rδ : 3 * r ≤ δ₁ := by have := min_le_right (ρ / 6) (δ₁ / 3); linarith
  have hcl : closedBall (ψ v₀) (3 * r) ⊆ U ∩ W ∩ O := (closedBall_subset_ball h3r).trans hρsub
  have hballO : ball (ψ v₀) (3 * r) ⊆ O :=
    ball_subset_closedBall.trans (hcl.trans inter_subset_right)
  have hPt3 : ContDiffOn ℝ 1 Pt (ball (ψ v₀) (3 * r)) := hPtO.mono hballO
  -- Step 7: `DPt` is continuous on `B_{3r}(y₀)`, hence bounded on the compact `B̄_{2r}(y₀)`
  have hcont2 : ContinuousOn (fderiv ℝ Pt) (closedBall (ψ v₀) (2 * r)) :=
    (hPt3.continuousOn_fderiv_of_isOpen isOpen_ball le_rfl).mono
      (closedBall_subset_ball (show 2 * r < 3 * r by linarith))
  obtain ⟨C, hC⟩ := IsCompact.exists_bound_of_continuousOn
    (E := Euclid P →L[ℝ] Euclid P →L[ℝ] Euclid P) (isCompact_closedBall (ψ v₀) (2 * r)) hcont2
  -- Step 8: `q ∈ N ∩ B_{3r}(y₀)` is `ψ(z)` with `z ∈ O₁`, so `Pt(q) = G(Dψ(z))` and
  -- `T_qN = range Dψ(z)`
  have hNq : ∀ q ∈ N ∩ ball (ψ v₀) (3 * r), ∃ z ∈ V,
      Pt q = G (fderiv ℝ ψ z) ∧ tangentSpace N q = Set.range (fderiv ℝ ψ z) := by
    rintro q ⟨hqN, hqB⟩
    obtain ⟨z, hzV, rfl⟩ : q ∈ ψ '' V := by
      rw [himg]; exact ⟨(hcl (ball_subset_closedBall hqB)).1.2, hqN⟩
    have hzO₁ : z ∈ O₁ := hball (mem_ball.2 (hδ₁' z hzV (lt_of_lt_of_le (mem_ball.1 hqB) h3rδ)))
    refine ⟨z, hzV, ?_, (hchart z hzV).1⟩
    show G (fderiv ℝ ψ (σ (ψ z))) = G (fderiv ℝ ψ z)
    rw [(hσψ z hzO₁).2]
  -- Step 9: assemble, with `β = max C 0`
  refine ⟨r, max C 0, Pt, hr, le_max_right _ _, fun y hy => (hcl hy).1.1, hPt3,
    fun y hy u w => (hG _ (hDψ _ (hσV (hballO hy)))).2.1 u w,
    fun y hy => (hC y (ball_subset_closedBall hy)).trans (le_max_left _ _), ?_, ?_⟩
  · intro q hq u
    obtain ⟨z, hzV, hPtq, hTq⟩ := hNq q hq
    rw [hPtq, hTq]
    exact (hG _ (hDψ z hzV)).2.2.1 u
  · intro q hq u hu
    obtain ⟨z, hzV, hPtq, hTq⟩ := hNq q hq
    rw [hTq] at hu
    obtain ⟨a, rfl⟩ := hu
    rw [hPtq]
    exact (hG _ (hDψ z hzV)).2.2.2 a
/-- **Approximate tangent planes of a set carried by a `Cʳ` submanifold lie in its tangent
spaces** (Simon Ch. 3, 1.4–1.5, chapter-03.txt lines 75–90; Ch. 2, 4.1 and 4.3, chapter-02.txt
lines 850–871).  Let `N` be an embedded `Cʳ` `d`-submanifold of `ℝᴾ`, `r ≥ 1`, let `x ∈ N`, let
`Hⁿ(M \ N) = 0` and let `Q` be an approximate tangent space of `M` at `x`.  Then `Q ⊆ T_xN`.
A chart `ψ` of `N` with `x = ψ(v₀)` gives `T_xN = Dψ(v₀)(ℝᵈ)` and the secant estimate
`|y − x − Dψ(v₀)a| ≤ ε|y − x|` for `y ∈ N` near `x`.  Every `w ∈ Q` is, at every small scale `λ`,
within `s` of a rescaled secant `λ⁻¹(y − x)` with `y ∈ M ∩ N`; hence `w ∈ Dψ(v₀)(ℝᵈ)`. -/
theorem Submission.dsmc_approxTangentPlane_subset_tangentSpace : ∀ (P n r d : ℕ) (M N : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)), 1 ≤ r → IsEmbeddedSubmanifold r d N → x ∈ N → μHE[n] (M \ N) = 0 → HasApproximateTangentSpaceAt n M x Q → (Q : Set (Euclid P)) ⊆ tangentSpace N x := by
  intro P n r d M N x Q hr hN hxN hMN hQ
  -- a chart `ψ : V → W` of `N` at `x`; `x ∈ W ∩ N = ψ(V)`, so `x = ψ(v₀)` with `v₀ ∈ V`
  obtain ⟨V, W, ψ, hV, hW, hxW, hψ, hinj, himg, hprop, hrank⟩ := hN x hxN
  obtain ⟨v₀, hv₀, rfl⟩ : x ∈ ψ '' V := by
    rw [himg]
    exact ⟨hxW, hxN⟩
  -- `T_xN = Dψ(v₀)(ℝᵈ)`, and `N` satisfies the secant estimate at `x` for `Dψ(v₀)`
  obtain ⟨hT, -, hsec⟩ := Submission.dsmc_chart_tangentSpace_eq_range P r d N V W ψ hr hV hW hψ
    hinj himg hprop hrank v₀ hv₀
  intro w hw
  rw [hT]
  -- the blow-up points `y ∈ M ∩ N` with `|λ⁻¹(y − x) − w| < s`, `0 < λ < λ₀`, lie in `N`
  refine Submission.dsmc_att_mem_range_of_secant_blowUp P d N (ψ v₀) w (fderiv ℝ ψ v₀) hsec
    fun s hs => ?_
  obtain ⟨lam₀, hlam₀, hpts⟩ :=
    Submission.dsmc_att_blowUp_points_of_approxTangent P n M N (ψ v₀) w Q hMN hQ hw s hs
  refine ⟨lam₀, hlam₀, fun lam hlam hlt => ?_⟩
  obtain ⟨y, hy, hyw⟩ := hpts lam hlam hlt
  exact ⟨y, hy.2, hyw⟩
/-- **Cut-off quadratic moments over `n`-planes** (the constant `cₙ` of the measurability proof
for the approximate tangent planes of Simon Ch. 3, 1.4).  For `n ≥ 1` one constant `c > 0`,
depending only on `n`, gives `∫_Q max(1 − |y|², 0)⟨u, y⟩² dHⁿ(y) = c|p_Q u|²` for every `P`,
every `n`-dimensional subspace `Q ⊆ ℝᴾ` and every `u ∈ ℝᴾ`.  On `ℝⁿ` put
`q(w) = ∫ max(1 − |z|², 0)⟨w, z⟩² dHⁿ(z)` and `c = q(e)`, `|e| = 1`: linear isometries preserve
`Hⁿ`, so `q` is invariant under them, `q(tw) = t²q(w)`, and a reflection maps `|w|e` to `w`,
whence `q(w) = c|w|²`; `c > 0` since the integrand is continuous, `≥ 0`, compactly supported and
`3/16` at `e/2`.  An isometry `ι = L⁻¹ : ℝⁿ → Q ⊆ ℝᴾ` carries `Hⁿ` to `Hⁿ⌞Q`, and
`⟨u, ι z⟩ = ⟨L(p_Q u), z⟩`, so the integral is `q(L(p_Q u)) = c|p_Q u|²`. -/
theorem Submission.exists_plane_cutoff_quadratic_moment_eq : ∀ n : ℕ, 0 < n → ∃ c : ℝ, 0 < c ∧ ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)), Module.finrank ℝ Q = n → ∀ u : Euclid P, ∫ y in (Q : Set (Euclid P)), max (1 - ‖y‖ ^ 2) 0 * inner ℝ u y ^ 2 ∂μHE[n] = c * ‖Q.starProjection u‖ ^ 2 := by
  intro n hn
  -- The moment `q(w)` on the model plane `ℝⁿ`; the constant is `c = q(e)` for a unit vector `e`.
  obtain ⟨q, hq_def⟩ : ∃ q : Euclid n → ℝ,
      ∀ w, q w = ∫ z, max (1 - ‖z‖ ^ 2) 0 * inner ℝ w z ^ 2 ∂μHE[n] :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨e, he⟩ : ∃ e : Euclid n, ‖e‖ = 1 := ⟨EuclideanSpace.single ⟨0, hn⟩ 1, by simp⟩
  -- `q(Rw) = q(w)` for a linear isometry `R`: substitute `z = Rz'`, `R` preserves `Hⁿ`.
  have hq_iso : ∀ (R : Euclid n ≃ₗᵢ[ℝ] Euclid n) (w : Euclid n), q (R w) = q w := by
    intro R w
    have key : ∫ z, max (1 - ‖R z‖ ^ 2) 0 * inner ℝ (R w) (R z) ^ 2 ∂μHE[n] =
        ∫ z, max (1 - ‖z‖ ^ 2) 0 * inner ℝ (R w) z ^ 2 ∂μHE[n] :=
      (R.toIsometryEquiv.measurePreserving_euclideanHausdorffMeasure n).integral_comp
        R.toHomeomorph.measurableEmbedding (fun y => max (1 - ‖y‖ ^ 2) 0 * inner ℝ (R w) y ^ 2)
    simp only [LinearIsometryEquiv.norm_map, LinearIsometryEquiv.inner_map_map] at key
    rw [hq_def, hq_def, ← key]
  have hq_smul : ∀ (t : ℝ) (w : Euclid n), q (t • w) = t ^ 2 * q w := by
    intro t w
    rw [hq_def, hq_def, ← integral_const_mul]
    congr 1
    funext z
    rw [real_inner_smul_left]
    ring
  -- `q(w) = c|w|²`: the reflection in `(|w|e − w)ᗮ` maps `|w|e` to `w`.
  have hq : ∀ w : Euclid n, q w = q e * ‖w‖ ^ 2 := by
    intro w
    have h1 : ‖‖w‖ • e‖ = ‖w‖ := by rw [norm_smul, he, mul_one, norm_norm]
    obtain ⟨R, hR⟩ : ∃ R : Euclid n ≃ₗᵢ[ℝ] Euclid n, R (‖w‖ • e) = w :=
      ⟨_, Submodule.reflection_sub h1⟩
    calc q w = q (R (‖w‖ • e)) := by rw [hR]
      _ = q (‖w‖ • e) := hq_iso R _
      _ = q e * ‖w‖ ^ 2 := by rw [hq_smul, mul_comm]
  -- `c > 0`: on `ℝⁿ`, `Hⁿ` is Lebesgue measure, and the integrand is `3/16` at `e/2`.
  have hc : 0 < q e := by
    have hcont : Continuous fun z : Euclid n => max (1 - ‖z‖ ^ 2) 0 * inner ℝ e z ^ 2 := by
      fun_prop
    have hsupp : HasCompactSupport fun z : Euclid n => max (1 - ‖z‖ ^ 2) 0 * inner ℝ e z ^ 2 := by
      refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid n) 1) fun z hz => ?_
      have h1 : 1 < ‖z‖ := by simpa using hz
      have h2 : 1 - ‖z‖ ^ 2 ≤ 0 := by nlinarith
      simp [max_eq_right h2]
    have hnonneg : 0 ≤ fun z : Euclid n => max (1 - ‖z‖ ^ 2) 0 * inner ℝ e z ^ 2 :=
      fun z => mul_nonneg (le_max_right _ _) (sq_nonneg _)
    have hx : (fun z : Euclid n => max (1 - ‖z‖ ^ 2) 0 * inner ℝ e z ^ 2) ((1 / 2 : ℝ) • e) ≠ 0 := by
      simp only [norm_smul, he, real_inner_smul_right, real_inner_self_eq_norm_sq]
      norm_num
    rw [hq_def, EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
    exact hcont.integral_pos_of_hasCompactSupport_nonneg_nonzero hsupp hnonneg hx
  refine ⟨q e, hc, fun P Q hQ u => ?_⟩
  -- An orthonormal basis of `Q` indexed by `Fin n` gives `L : Q ≃ ℝⁿ`; `ι = L⁻¹` is an isometry
  -- of `ℝⁿ` onto `Q ⊆ ℝᴾ`, so `ι_# Hⁿ = Hⁿ⌞Q`.
  obtain ⟨L, -⟩ : ∃ L : Q ≃ₗᵢ[ℝ] Euclid n, True :=
    ⟨((stdOrthonormalBasis ℝ Q).reindex (finCongr hQ)).repr, trivial⟩
  have hι : Isometry fun z : Euclid n => ((L.symm z : Q) : Euclid P) :=
    isometry_subtype_coe.comp L.symm.isometry
  have hrange : Set.range (fun z : Euclid n => ((L.symm z : Q) : Euclid P)) =
      (Q : Set (Euclid P)) := by
    ext y
    refine ⟨?_, fun hy => ⟨L ⟨y, hy⟩, by simp⟩⟩
    rintro ⟨z, rfl⟩
    exact (L.symm z).2
  have hemb : MeasurableEmbedding fun z : Euclid n => ((L.symm z : Q) : Euclid P) :=
    hι.isClosedEmbedding.measurableEmbedding
  have hnorm : ∀ z : Euclid n, ‖((L.symm z : Q) : Euclid P)‖ = ‖z‖ := fun z => L.symm.norm_map z
  -- `⟨u, ι z⟩ = ⟨p_Q u, ι z⟩ = ⟨L(p_Q u), z⟩`.
  have hinner : ∀ z : Euclid n, inner ℝ u ((L.symm z : Q) : Euclid P) =
      inner ℝ (L (Q.orthogonalProjectionOnto u)) z := by
    intro z
    rw [LinearIsometryEquiv.inner_map_eq_flip,
      Submodule.inner_orthogonalProjectionOnto_eq_of_mem_right]
  rw [← hrange, ← hι.map_euclideanHausdorffMeasure, hemb.integral_map]
  simp only [hnorm, hinner]
  rw [← hq_def, hq, LinearIsometryEquiv.norm_map, Submodule.starProjection_apply]
  rfl
/-- A field of orthogonal projections `p_x = (K x).starProjection` is a.e.-measurable (Borel
σ-algebra of the operator-norm topology) when each quadratic form `x ↦ |p_x u|²` is.  As `p_x` is
self-adjoint and idempotent, `⟪p_x u, w⟫ = (|p_x(u + w)|² − |p_x(u − w)|²)/4`, so the matrix
coefficients `⟪p_x e_a, e_b⟫` are a.e.-measurable, and `p_x = Σ_{a,b} ⟪p_x e_a, e_b⟫ ⟪e_a, ·⟫ e_b`
is a continuous linear function of them. -/
theorem Submission.aemeasurable_starProjection_of_aemeasurable_norm_sq : ∀ (P : ℕ) (μ : Measure (Euclid P)) (K : Euclid P → Submodule ℝ (Euclid P)), (∀ u : Euclid P, AEMeasurable (fun x => ‖(K x).starProjection u‖ ^ 2) μ) → AEMeasurable (fun x => (K x).starProjection) μ := by
  intro P μ K h
  -- by polarization every coefficient `x ↦ ⟪p_x u, w⟫` is a.e.-measurable
  have hcoef : ∀ u w : Euclid P,
      AEMeasurable (fun x => inner ℝ ((K x).starProjection u) w) μ := by
    intro u w
    have key : ∀ x, inner ℝ ((K x).starProjection u) w =
        (‖(K x).starProjection (u + w)‖ ^ 2 - ‖(K x).starProjection (u - w)‖ ^ 2) / 4 := by
      intro x
      have hsym : inner ℝ ((K x).starProjection u) w =
          inner ℝ ((K x).starProjection u) ((K x).starProjection w) := by
        rw [Submodule.inner_starProjection_left_eq_right,
          Submodule.inner_starProjection_left_eq_right,
          Submodule.starProjection_eq_self_iff.2 ((K x).starProjection_apply_mem w)]
      rw [hsym, map_add, map_sub, norm_add_sq_real, norm_sub_sq_real]
      ring
    simp_rw [key]
    exact ((h (u + w)).sub (h (u - w))).div_const 4
  -- `p_x = Λ (g x)`, `Λ m = ∑ m_{ab} ⟪e_a, ·⟫ e_b`, `g x = (⟪p_x e_a, e_b⟫)_{ab}`
  let e := EuclideanSpace.basisFun (Fin P) ℝ
  let Λ : (Fin P × Fin P → ℝ) → (Euclid P →L[ℝ] Euclid P) := fun m =>
    ∑ ab, m ab • (innerSL ℝ (e ab.1)).smulRight (e ab.2)
  have heq : (fun x => (K x).starProjection) =
      fun x => Λ fun ab => inner ℝ ((K x).starProjection (e ab.1)) (e ab.2) := by
    funext x
    refine ContinuousLinearMap.ext fun v => ?_
    simp only [Λ, FunLike.coe_sum, Finset.sum_apply, FunLike.coe_smul,
      Pi.smul_apply, ContinuousLinearMap.smulRight_apply, innerSL_apply_apply,
      Fintype.sum_prod_type]
    calc (K x).starProjection v = (K x).starProjection (∑ a, inner ℝ (e a) v • e a) := by
          rw [e.sum_repr']
      _ = ∑ a, inner ℝ (e a) v • (K x).starProjection (e a) := by
          simp only [map_sum, map_smul]
      _ = ∑ a, inner ℝ (e a) v • ∑ b, inner ℝ (e b) ((K x).starProjection (e a)) • e b := by
          simp only [e.sum_repr']
      _ = _ := by
          refine Finset.sum_congr rfl fun a _ => ?_
          rw [Finset.smul_sum]
          refine Finset.sum_congr rfl fun b _ => ?_
          rw [real_inner_comm (e b), smul_smul, smul_smul, mul_comm]
  -- `Λ` is continuous and `g` is a.e.-measurable coordinatewise
  have hΛ : Continuous Λ :=
    continuous_finsetSum _ fun ab _ => (continuous_apply ab).smul continuous_const
  rw [heq]
  exact hΛ.measurable.comp_aemeasurable (AEMeasurable.of_eval fun ab => hcoef _ _)
/-- For an integer multiplicity triple `R = (M, θ, ξ)` in an open set `U`, `Hⁿ⌞M` is σ-finite.
The open set `U ⊆ ℝᴾ` is σ-compact, `U = ⋃ⱼ Kⱼ` with `Kⱼ` compact.  As `θ ≥ 1` on `M`,
`Hⁿ(M ∩ Kⱼ) ≤ ∫_{M ∩ Kⱼ} θ dHⁿ < ∞`, and `M ⊆ ⋃ⱼ (M ∩ Kⱼ)`. -/
theorem Submission.dsmc_imrep_carrier_sigmaFinite : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), IsOpen U → SigmaFinite (μHE[n].restrict R.carrier) := by
  intro P n U R hU
  -- `U` is locally compact and second countable, hence σ-compact
  obtain ⟨K, hKc, hKU⟩ : IsSigmaCompact U := by
    have := hU.locallyCompactSpace
    exact isSigmaCompact_iff_sigmaCompactSpace.mpr inferInstance
  -- `Hⁿ(M ∩ Kⱼ) ≤ ∫_{M ∩ Kⱼ} θ dHⁿ < ∞`, since `θ ≥ 1` on `M`
  have hfin : ∀ j, μHE[n] (R.carrier ∩ K j) < ∞ := by
    intro j
    calc μHE[n] (R.carrier ∩ K j) = ∫⁻ _ in R.carrier ∩ K j, 1 ∂μHE[n] :=
          (setLIntegral_one _).symm
      _ ≤ ∫⁻ x in R.carrier ∩ K j, (R.mult x : ℝ≥0∞) ∂μHE[n] :=
          setLIntegral_mono' (R.measurableSet_carrier.inter (hKc j).isClosed.measurableSet)
            fun x hx => Nat.one_le_cast.mpr (R.mult_pos x hx.1)
      _ < ∞ := (R.locallyIntegrable_mult (K j) (hKc j)
          ((subset_iUnion K j).trans hKU.subset)).lt_top
  -- `M ⊆ U = ⋃ⱼ Kⱼ`, so the sets `M ∩ Kⱼ` cover `M`
  refine Poincare.SimonGMT.Chapter03.sigmaFinite_restrict_of_hausdorff_finite_cover
    (fun j => R.carrier ∩ K j) ?_ hfin
  rw [← inter_iUnion, hKU]
  exact fun x hx => ⟨hx, R.carrier_subset hx⟩
/-- The blow-up integrals `x ↦ ∫_{η_{x,r}(M)} f dHⁿ` of a continuous `f ≥ 0` are Borel
measurable when `Hⁿ⌞M` is s-finite; `M` need not be measurable.  As `η_{x,r}` is a translation
followed by the dilation by `r⁻¹`, `Hⁿ(η_{x,r}(s)) = r⁻ⁿ Hⁿ(s)` for every set `s`, so
`Hⁿ⌞η_{x,r}(M) = r⁻ⁿ (η_{x,r})_#(Hⁿ⌞M)` (on Borel `B`, `η(M) ∩ B = η(M ∩ η⁻¹B)`).  Hence the
integral is `(r⁻ⁿ ∫ f(r⁻¹(y − x)) d(Hⁿ⌞M)(y)).toReal`, measurable in `x` by Tonelli for the
s-finite `Hⁿ⌞M`. -/
theorem Submission.dsmc_measurable_blowUp_image_setIntegral : ∀ (P n : ℕ) (M : Set (Euclid P)), SFinite (μHE[n].restrict M) → ∀ f : Euclid P → ℝ, Continuous f → (∀ y, 0 ≤ f y) → ∀ r : ℝ, 0 < r → Measurable (fun x : Euclid P => ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, f y ∂μHE[n]) := by
  intro P n M hM f hf hf0 r hr
  set η : Euclid P → Euclid P → Euclid P := fun x => Poincare.SimonGMT.Chapter03.blowUpMap x r
    with hη
  -- `(x, y) ↦ η_x(y) = r⁻¹(y − x)` is continuous
  have hηc : Continuous fun p : Euclid P × Euclid P => η p.1 p.2 := by
    simp only [hη, Poincare.SimonGMT.Chapter03.blowUpMap]
    fun_prop
  have hηm : ∀ x, Measurable (η x) := fun x =>
    (hηc.comp (Continuous.prodMk continuous_const continuous_id)).measurable
  -- `Hⁿ(η_x(s)) = r⁻ⁿ Hⁿ(s)` for every set `s`
  have hscale : ∀ x (s : Set (Euclid P)), μHE[n] (η x '' s) = ‖r⁻¹‖₊ ^ n • μHE[n] s := by
    intro x s
    have himg : η x '' s = (fun y => r⁻¹ • y) '' (IsometryEquiv.subRight x '' s) := by
      rw [Set.image_image]
      rfl
    rw [himg, Set.image_smul, Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hr.ne'),
      (IsometryEquiv.subRight x).isometry.euclideanHausdorffMeasure_image]
  -- `Hⁿ⌞η_x(M) = r⁻ⁿ (η_x)_#(Hⁿ⌞M)`, checked on Borel sets
  have hrestr : ∀ x, μHE[n].restrict (η x '' M) =
      ‖r⁻¹‖₊ ^ n • (μHE[n].restrict M).map (η x) := by
    intro x
    ext B hB
    rw [Measure.restrict_apply hB, Measure.smul_apply, Measure.map_apply (hηm x) hB,
      Measure.restrict_apply (hηm x hB), Set.inter_comm, ← Set.image_inter_preimage, hscale,
      Set.inter_comm]
  -- `∫_{η_x(M)} f dHⁿ = (r⁻ⁿ ∫ f ∘ η_x d(Hⁿ⌞M)).toReal`, also when `f` is not integrable
  have hint : ∀ x, ∫ y in η x '' M, f y ∂μHE[n] =
      (‖r⁻¹‖₊ ^ n • ∫⁻ y, ENNReal.ofReal (f (η x y)) ∂(μHE[n].restrict M)).toReal := by
    intro x
    rw [integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall hf0) hf.aestronglyMeasurable,
      hrestr, lintegral_smul_measure, lintegral_map hf.measurable.ennreal_ofReal (hηm x)]
  -- Tonelli for the s-finite measure `Hⁿ⌞M`
  show Measurable fun x => ∫ y in η x '' M, f y ∂μHE[n]
  simp_rw [hint]
  exact ((Measurable.lintegral_prod_right'
    (f := fun p : Euclid P × Euclid P => ENNReal.ofReal (f (η p.1 p.2)))
    (ENNReal.continuous_ofReal.comp (hf.comp hηc)).measurable).const_smul _).ennreal_toReal

/-- **The approximate tangent projections of an integer multiplicity triple are measurable**
(Simon Ch. 3, 1.4; Ch. 4, 2.3).  For `R = (M, θ, ξ)` in an open `U ⊆ ℝᴾ`, `x ↦ p_{TₓM}` is
a.e.-measurable for `μ_R = θHⁿ⌞M`.  As `μ_R ≪ ν = Hⁿ⌞M`, it suffices to treat `ν`, which is
σ-finite.  If `n = 0`, every candidate plane is `{0}`.  If `n ≥ 1`, `TₓM` is an approximate tangent
plane at `ν`-a.e. `x`, so for `f_u(y) = max(1 − |y|², 0)⟨u, y⟩²` the blow-up integrals
`∫_{η_{x,1/(k+1)}(M)} f_u dHⁿ`, which are Borel in `x`, converge `ν`-a.e. to
`∫_{TₓM} f_u dHⁿ = c|p_x u|²`.  Hence each `x ↦ |p_x u|²`, and so `x ↦ p_x`, is
`ν`-a.e.-measurable. -/
theorem Submission.dsmc_approxTangentPlane_starProjection_aemeasurable : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), IsOpen U → AEMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) R.measure := by
  intro P n U R hU
  -- `μ_R = θHⁿ⌞M ≪ Hⁿ⌞M`, so it suffices to work with `ν = Hⁿ⌞M`
  refine AEMeasurable.mono_ac ?_ (withDensity_absolutelyContinuous _ _)
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · -- `n = 0`: every candidate plane is `0`-dimensional, so `p_x = 0` for every `x`
    have h0 : ∀ x, (approxTangentPlane 0 R.carrier x).starProjection = 0 := by
      intro x
      have hK : approxTangentPlane 0 R.carrier x = ⊥ := by
        rw [approxTangentPlane]
        split_ifs with h
        · exact Submodule.finrank_eq_zero.1 h.choose_spec.1
        · rfl
      refine ContinuousLinearMap.ext fun v => ?_
      exact (Submodule.mem_bot ℝ).1
        (hK.le ((approxTangentPlane 0 R.carrier x).starProjection_apply_mem v))
    simp only [h0]
    exact aemeasurable_const
  have : SigmaFinite ((μHE[n] : Measure (Euclid P)).restrict R.carrier) :=
    Submission.dsmc_imrep_carrier_sigmaFinite P n U R hU
  obtain ⟨c, hc, hcQ⟩ := Submission.exists_plane_cutoff_quadratic_moment_eq n hn
  -- `TₓM` is an approximate tangent plane of `M` at `ν`-a.e. `x`
  have hT : ∀ᵐ x ∂(μHE[n].restrict R.carrier),
      HasApproximateTangentSpaceAt n R.carrier x (approxTangentPlane n R.carrier x) := by
    filter_upwards [R.orients] with x hx
    obtain ⟨Q, hQ, -⟩ := hx
    have h : ∃ Q, HasApproximateTangentSpaceAt n R.carrier x Q := ⟨Q, hQ⟩
    rw [approxTangentPlane, dite_eq_left h]
    exact h.choose_spec
  refine Submission.aemeasurable_starProjection_of_aemeasurable_norm_sq P _ _ fun u => ?_
  -- the test function `f_u(y) = max(1 − |y|², 0)⟨u, y⟩² ∈ C_c(ℝᴾ)`
  let f : Euclid P → ℝ := fun y => max (1 - ‖y‖ ^ 2) 0 * inner ℝ u y ^ 2
  have hf : Continuous f := by fun_prop
  have hf0 : ∀ y, 0 ≤ f y := fun y => mul_nonneg (le_max_right _ _) (sq_nonneg _)
  have hfc : HasCompactSupport f := by
    refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid P) 1) fun y hy => ?_
    have h1 : 1 < ‖y‖ := by simpa using hy
    have h2 : 1 - ‖y‖ ^ 2 ≤ 0 := by nlinarith
    simp [f, max_eq_right h2]
  let F : CompactlySupportedContinuousMap (Euclid P) ℝ := ⟨⟨f, hf⟩, hfc⟩
  -- the scales `1/(k+1) ↓ 0`
  have hr : Tendsto (fun k : ℕ => 1 / ((k : ℝ) + 1)) atTop (𝓝[>] 0) :=
    tendsto_nhdsWithin_iff.2 ⟨tendsto_one_div_add_atTop_nhds_zero_nat,
      Eventually.of_forall fun k => mem_Ioi.2 (by positivity)⟩
  -- the blow-up integrals `Φₖ(x) = ∫_{η_{x,1/(k+1)}(M)} f_u dHⁿ` are Borel functions of `x`
  let Φ : ℕ → Euclid P → ℝ := fun k x =>
    ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x (1 / ((k : ℝ) + 1)) '' R.carrier, f y ∂μHE[n]
  have hΦ : ∀ k, Measurable (Φ k) := fun k =>
    Submission.dsmc_measurable_blowUp_image_setIntegral P n R.carrier inferInstance f hf hf0 _
      (by positivity)
  -- at `ν`-a.e. `x` they converge to `∫_{TₓM} f_u dHⁿ = c|p_x u|²`
  have hlim : ∀ᵐ x ∂(μHE[n].restrict R.carrier), Tendsto (fun k => Φ k x) atTop
      (𝓝 (c * ‖(approxTangentPlane n R.carrier x).starProjection u‖ ^ 2)) := by
    filter_upwards [hT] with x hx
    rw [← hcQ P _ hx.1 u]
    exact (hx.2 F).comp hr
  refine ((aemeasurable_of_tendsto_metrizable_ae' (fun k => (hΦ k).aemeasurable) hlim).const_mul
    c⁻¹).congr (Eventually.of_forall fun x => ?_)
  exact inv_mul_cancel_left₀ hc.ne' _
/-- **Integrating factor for the monotonicity identity** (Simon Ch. 4, 3.16–3.17).  If `I` is
continuous on `(0, r]`, has derivative `I'` on `(0, r)` and `n I(s) − s I'(s) ≤ κ s I(s)` there,
then `s ↦ e^{κs} s⁻ⁿ I(s)` is nondecreasing on `(0, r]`.  On `(0, r]` this function equals
`G(s) = exp(κs − n log s) I(s)`, and `G'(s) = exp(κs − n log s) s⁻¹ (κ s I(s) − (n I(s) − s I'(s)))
≥ 0` on `(0, r)`, so the mean value theorem applies. -/
theorem Submission.dsmc_em_exp_monotoneOn_of_deriv_ineq : ∀ (n : ℕ) (κ r : ℝ) (I I' : ℝ → ℝ), ContinuousOn I (Ioc 0 r) → (∀ s ∈ Ioo 0 r, HasDerivAt I (I' s) s) → (∀ s ∈ Ioo 0 r, (n : ℝ) * I s - s * I' s ≤ κ * s * I s) → MonotoneOn (fun s => Real.exp (κ * s) / s ^ n * I s) (Ioc 0 r) := by
  intro n κ r I I' hIc hId hineq
  -- on `(0, r]`, `e^{κs}/sⁿ · I(s) = G(s) := exp(κs − n log s) · I(s)`
  refine MonotoneOn.congr (f₁ := fun s => Real.exp (κ * s - n * Real.log s) * I s) ?_ ?_
  swap
  · intro s hs
    simp only [Real.exp_sub, Real.exp_nat_mul, Real.exp_log hs.1]
  -- `G` is continuous on `(0, r]`
  have hGc : ContinuousOn (fun s => Real.exp (κ * s - n * Real.log s) * I s) (Ioc 0 r) := by
    refine ContinuousOn.mul (Real.continuous_exp.comp_continuousOn ?_) hIc
    exact (continuousOn_const.mul continuousOn_id).sub
      (continuousOn_const.mul (Real.continuousOn_log.mono fun s hs => hs.1.ne'))
  -- `G' = exp(κs − n log s) · ((κ − n/s) I + I') ≥ 0` on `(0, r)`; mean value theorem
  refine monotoneOn_of_hasDerivWithinAt_nonneg (convex_Ioc 0 r) hGc
    (f' := fun s => Real.exp (κ * s - n * Real.log s) * ((κ - n * s⁻¹) * I s + I' s)) ?_ ?_
  · intro s hs
    rw [interior_Ioc] at hs
    have h1 : HasDerivAt (fun s => κ * s - n * Real.log s) (κ * 1 - n * s⁻¹) s :=
      ((hasDerivAt_id' s).const_mul κ).sub ((Real.hasDerivAt_log hs.1.ne').const_mul (n : ℝ))
    exact ((h1.exp.mul (hId s hs)).congr_deriv (by ring)).hasDerivWithinAt
  · intro s hs
    rw [interior_Ioc] at hs
    have key : (κ - n * s⁻¹) * I s + I' s = s⁻¹ * (κ * s * I s - (n * I s - s * I' s)) := by
      linear_combination (-(κ * I s + I' s)) * mul_inv_cancel₀ hs.1.ne'
    rw [key]
    exact mul_nonneg (Real.exp_pos _).le
      (mul_nonneg (inv_nonneg.mpr hs.1.le) (sub_nonneg.mpr (hineq s hs)))
/-- **Differentiation of radial cutoff integrals** (Simon Ch. 4, 3.3–3.4, where
`I(ρ) = ∫ φ(r/ρ) dμ` is differentiated in `ρ`; here the cutoff is written in the squared ratio
`|x - z|²/t²`).  If `μ(B_r(z)) < ∞` and `η` is `C¹` with `η = 0` on `[1, ∞)`, then
`I(t) = ∫ η(|x - z|²/t²) dμ` is continuous on `(0, r]` and, for `0 < s < r`,
`I'(s) = -(∫ 2 (|x - z|²/s²) η'(|x - z|²/s²) dμ)/s` (dominated convergence and differentiation
under the integral sign). -/
theorem Submission.dsmc_em_cutoff_integral_hasDerivAt : ∀ (P : ℕ) (μ : Measure (Euclid P)) (z : Euclid P) (r : ℝ) (η : ℝ → ℝ), μ (ball z r) < ∞ → ContDiff ℝ 1 η → (∀ u, 1 ≤ u → η u = 0) → ContinuousOn (fun t => ∫ x, η (‖x - z‖ ^ 2 / t ^ 2) ∂μ) (Ioc 0 r) ∧ ∀ s ∈ Ioo 0 r, HasDerivAt (fun t => ∫ x, η (‖x - z‖ ^ 2 / t ^ 2) ∂μ) (-(∫ x, 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ∂μ) / s) s := by
  intro P μ z r η hμ hη hη1
  have hηc : Continuous η := hη.continuous
  have hη'c : Continuous (deriv η) := hη.continuous_deriv le_rfl
  -- `η' = deriv η` vanishes on `(1, ∞)` (where `η` is locally zero), hence on `[1, ∞)`.
  have hη'1 : ∀ u, 1 ≤ u → deriv η u = 0 := by
    have hIoi : Ioi (1 : ℝ) ⊆ {u | deriv η u = 0} := fun u hu => by
      have hloc : η =ᶠ[𝓝 u] fun _ => (0 : ℝ) := by
        filter_upwards [Ioi_mem_nhds hu] with v hv
        exact hη1 v (le_of_lt hv)
      show deriv η u = 0
      rw [hloc.deriv_eq, deriv_const]
    have hIci : Ici (1 : ℝ) ⊆ {u | deriv η u = 0} := by
      rw [← closure_Ioi]
      exact closure_minimal hIoi (isClosed_eq hη'c continuous_const)
    exact fun u hu => hIci hu
  -- Bounds on `[0, 1]` for `η` and for `u ↦ 2 u η'(u)`.
  obtain ⟨C, hC⟩ := isCompact_Icc.exists_bound_of_continuousOn (s := Icc (0 : ℝ) 1)
    hηc.continuousOn
  obtain ⟨K, hK⟩ := isCompact_Icc.exists_bound_of_continuousOn (s := Icc (0 : ℝ) 1)
    (f := fun u : ℝ => 2 * u * deriv η u) (by fun_prop)
  have hg1 : ∀ u, 1 ≤ u → 2 * u * deriv η u = 0 := fun u hu => by
    rw [hη'1 u hu, mul_zero]
  -- For `0 < t ≤ r`, `g(|x - z|²/t²)` vanishes off `B_t(z) ⊆ B_r(z)` and is dominated there.
  have hdom : ∀ (g : ℝ → ℝ) (B : ℝ), (∀ u, 1 ≤ u → g u = 0) → (∀ u ∈ Icc (0 : ℝ) 1, ‖g u‖ ≤ B) →
      ∀ t, 0 < t → t ≤ r → ∀ x : Euclid P,
        ‖g (‖x - z‖ ^ 2 / t ^ 2)‖ ≤ (ball z r).indicator (fun _ => B) x := by
    intro g B hg0 hgB t ht htr x
    have hB : 0 ≤ B := (norm_nonneg _).trans (hgB 0 ⟨le_rfl, zero_le_one⟩)
    by_cases hx : ‖x - z‖ < t
    · have hxr : x ∈ ball z r := by
        rw [mem_ball, dist_eq_norm]
        exact hx.trans_le htr
      rw [indicator_of_mem hxr]
      apply hgB
      refine ⟨by positivity, ?_⟩
      rw [div_le_one (by positivity)]
      exact pow_le_pow_left₀ (norm_nonneg _) hx.le 2
    · rw [not_lt] at hx
      rw [hg0 _ ?_, norm_zero]
      · exact indicator_nonneg (fun _ _ => hB) x
      · rw [le_div_iff₀ (by positivity), one_mul]
        exact pow_le_pow_left₀ ht.le hx 2
  have hint : ∀ c : ℝ, Integrable ((ball z r).indicator (fun _ => c)) μ := fun c =>
    (integrable_indicator_iff measurableSet_ball).2 (integrableOn_const hμ.ne)
  have hcont : ∀ t : ℝ, Continuous fun x : Euclid P => η (‖x - z‖ ^ 2 / t ^ 2) := fun t => by
    fun_prop
  -- Pointwise derivative in `t ≠ 0`.
  have hderiv : ∀ x : Euclid P, ∀ t : ℝ, t ≠ 0 →
      HasDerivAt (fun t => η (‖x - z‖ ^ 2 / t ^ 2))
        (-(2 * (‖x - z‖ ^ 2 / t ^ 2) * deriv η (‖x - z‖ ^ 2 / t ^ 2)) / t) t := by
    intro x t ht
    have h1 := (hasDerivAt_const t (‖x - z‖ ^ 2)).div (hasDerivAt_pow 2 t) (pow_ne_zero 2 ht)
    have h2 := (hη.differentiable one_ne_zero (‖x - z‖ ^ 2 / t ^ 2)).hasDerivAt.comp t h1
    refine h2.congr_deriv ?_
    field_simp
    ring
  refine ⟨?_, fun s hs => ?_⟩
  · -- (i) continuity on `(0, r]` by dominated convergence
    refine continuousOn_of_dominated (F := fun t x => η (‖x - z‖ ^ 2 / t ^ 2))
      (bound := (ball z r).indicator (fun _ => C)) (fun t _ => (hcont t).aestronglyMeasurable)
      (fun t ht => Eventually.of_forall (hdom η C hη1 hC t ht.1 ht.2)) (hint C)
      (Eventually.of_forall fun x t ht => (hderiv x t ht.1.ne').continuousAt.continuousWithinAt)
  · -- (ii) differentiation under the integral sign on `(s/2, r)`
    have hs0 : 0 < s := hs.1
    have hb : ∀ x : Euclid P, ∀ t ∈ Ioo (s / 2) r,
        ‖-(2 * (‖x - z‖ ^ 2 / t ^ 2) * deriv η (‖x - z‖ ^ 2 / t ^ 2)) / t‖ ≤
          (ball z r).indicator (fun _ => K) x / (s / 2) := by
      intro x t ht
      have ht0 : 0 < t := by linarith [ht.1]
      have h1 : ‖2 * (‖x - z‖ ^ 2 / t ^ 2) * deriv η (‖x - z‖ ^ 2 / t ^ 2)‖ ≤
          (ball z r).indicator (fun _ => K) x :=
        hdom (fun u => 2 * u * deriv η u) K hg1 hK t ht0 ht.2.le x
      have h2 : 0 ≤ (ball z r).indicator (fun _ => K) x := (norm_nonneg _).trans h1
      rw [norm_div, norm_neg, Real.norm_of_nonneg ht0.le]
      calc ‖2 * (‖x - z‖ ^ 2 / t ^ 2) * deriv η (‖x - z‖ ^ 2 / t ^ 2)‖ / t
          ≤ (ball z r).indicator (fun _ => K) x / t := by gcongr
        _ ≤ (ball z r).indicator (fun _ => K) x / (s / 2) := by
          gcongr
          exact ht.1.le
    have key := hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := μ) (x₀ := s)
      (F := fun t x => η (‖x - z‖ ^ 2 / t ^ 2))
      (F' := fun t x => -(2 * (‖x - z‖ ^ 2 / t ^ 2) * deriv η (‖x - z‖ ^ 2 / t ^ 2)) / t)
      (bound := fun x => (ball z r).indicator (fun _ => K) x / (s / 2))
      (Ioo_mem_nhds (by linarith) hs.2)
      (Eventually.of_forall fun t => (hcont t).aestronglyMeasurable)
      ((hint C).mono' (hcont s).aestronglyMeasurable
        (Eventually.of_forall (hdom η C hη1 hC s hs0 hs.2.le)))
      (by fun_prop : Continuous fun x : Euclid P =>
        -(2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)) / s).aestronglyMeasurable
      (Eventually.of_forall hb) ((hint K).div_const (s / 2))
      (Eventually.of_forall fun x t ht => hderiv x t (by linarith [ht.1] : 0 < t).ne')
    have hval : ∫ x, -(2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)) / s ∂μ =
        -(∫ x, 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ∂μ) / s := by
      rw [integral_div, integral_neg]
    rw [← hval]
    exact key.2
/-- **Radial first-variation inequality** (Simon Ch. 4, 3.2–3.3 with the bounded generalized mean
curvature of 3.14–3.16).  Test the first variation of `v(M, θ)` with the radial field
`X(x) = η(u(x)) (x - z)`, `u(x) = ‖x - z‖² / s²`, where `η ≥ 0` is `C¹`, nonincreasing and vanishes
on `[1, ∞)`.  Then `μ`-a.e. `n η(u) + 2 u η'(u) ≤ div_M X ≤ n η(u)`, and
`|X · H| ≤ κ s η(u)`, so `n ∫ η(u) dμ + ∫ 2 u η'(u) dμ ≤ ∫ div_M X dμ = -∫ X · H dμ ≤ κ s ∫ η(u) dμ`. -/
theorem Submission.dsmc_em_cutoff_first_variation_le : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (H : Euclid P → Euclid P) (κ : ℝ) (z : Euclid P) (r : ℝ) (η : ℝ → ℝ), closedBall z r ⊆ U → AEMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) R.measure → (∀ x, ‖H x‖ ≤ κ) → (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ ball z r → R.firstVariation X = -∫ x, inner ℝ (X x) (H x) ∂R.measure) → ContDiff ℝ 1 η → (∀ u, 0 ≤ η u) → (∀ u, deriv η u ≤ 0) → (∀ u, 1 ≤ u → η u = 0) → ∀ s : ℝ, 0 < s → s < r → (n : ℝ) * ∫ x, η (‖x - z‖ ^ 2 / s ^ 2) ∂R.measure + ∫ x, 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ∂R.measure ≤ κ * s * ∫ x, η (‖x - z‖ ^ 2 / s ^ 2) ∂R.measure := by
  intro P n U R H κ z r η hzU hPm hHκ hfv hη hη0 hη'0 hη1 s hs hsr
  classical
  set μ : Measure (Euclid P) := R.measure with hμ
  /- Step 0.  `κ ≥ 0`; `μ(B̄_s(z)) < ∞`; `η' = deriv η` is continuous and vanishes on `(1, ∞)`;
  `η` and `η'` are bounded on `[0, 1]`. -/
  have hκ0 : 0 ≤ κ := (norm_nonneg _).trans (hHκ 0)
  have hBc : IsCompact (closedBall z s) := isCompact_closedBall z s
  have hBm : MeasurableSet (closedBall z s) := measurableSet_closedBall
  have hBU : closedBall z s ⊆ U := (closedBall_subset_closedBall hsr.le).trans hzU
  have hBr : closedBall z s ⊆ ball z r := closedBall_subset_ball hsr
  have hμB : μ (closedBall z s) < ∞ := by
    rw [hμ, IMRep.measure, withDensity_apply _ hBm, Measure.restrict_restrict hBm, inter_comm]
    exact lt_top_iff_ne_top.mpr (R.locallyIntegrable_mult _ hBc hBU)
  have hind : ∀ c : ℝ, Integrable ((closedBall z s).indicator fun _ => c) μ := fun c =>
    (integrable_indicator_iff hBm).mpr (integrableOn_const hμB.ne)
  have hηd : ∀ u, HasDerivAt η (deriv η u) u := fun u =>
    ((hη.differentiable (by norm_num)) u).hasDerivAt
  have hηc : Continuous η := hη.continuous
  have hη'c : Continuous (deriv η) := hη.continuous_deriv le_rfl
  have hη'1 : ∀ u, 1 < u → deriv η u = 0 := by
    intro u hu
    have : η =ᶠ[𝓝 u] fun _ => 0 := by
      filter_upwards [Ioi_mem_nhds hu] with v hv
      exact hη1 v hv.le
    rw [this.deriv_eq]
    simp
  obtain ⟨C, hC⟩ : ∃ C, ∀ u ∈ Icc (0 : ℝ) 1, ‖η u‖ ≤ C :=
    isCompact_Icc.exists_bound_of_continuousOn hηc.continuousOn
  obtain ⟨M, hM⟩ : ∃ M, ∀ u ∈ Icc (0 : ℝ) 1, ‖deriv η u‖ ≤ M :=
    isCompact_Icc.exists_bound_of_continuousOn hη'c.continuousOn
  -- the radius ratio `u(x) = ‖x - z‖² / s²`
  have hucont : Continuous fun x : Euclid P => ‖x - z‖ ^ 2 / s ^ 2 := by fun_prop
  have hu0 : ∀ x : Euclid P, 0 ≤ ‖x - z‖ ^ 2 / s ^ 2 := fun x => by positivity
  have hu_le : ∀ x ∈ closedBall z s, ‖x - z‖ ^ 2 / s ^ 2 ≤ 1 := by
    intro x hx
    rw [mem_closedBall, dist_eq_norm] at hx
    rw [div_le_one (pow_pos hs 2)]
    exact pow_le_pow_left₀ (norm_nonneg _) hx 2
  have hu_gt : ∀ x, x ∉ closedBall z s → 1 < ‖x - z‖ ^ 2 / s ^ 2 := by
    intro x hx
    rw [mem_closedBall, dist_eq_norm, not_le] at hx
    rw [one_lt_div (pow_pos hs 2)]
    exact pow_lt_pow_left₀ hx hs.le two_ne_zero
  -- the two integrands vanish off `B̄_s(z)` and are bounded on it
  have hFint : Integrable (fun x => η (‖x - z‖ ^ 2 / s ^ 2)) μ := by
    refine Integrable.mono' (hind C) (hηc.comp hucont).aestronglyMeasurable
      (ae_of_all _ fun x => ?_)
    by_cases hx : x ∈ closedBall z s
    · rw [indicator_of_mem hx]
      exact hC _ ⟨hu0 x, hu_le x hx⟩
    · rw [indicator_of_notMem hx, hη1 _ (hu_gt x hx).le, norm_zero]
  have hGint : Integrable
      (fun x => 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)) μ := by
    refine Integrable.mono' (hind (2 * M))
      ((continuous_const.mul hucont).mul (hη'c.comp hucont)).aestronglyMeasurable
      (ae_of_all _ fun x => ?_)
    by_cases hx : x ∈ closedBall z s
    · have h1 := hu_le x hx
      have h2 := hM _ ⟨hu0 x, h1⟩
      rw [Real.norm_eq_abs] at h2
      rw [indicator_of_mem hx, Real.norm_eq_abs, abs_mul, abs_mul, abs_two,
        abs_of_nonneg (hu0 x)]
      calc 2 * (‖x - z‖ ^ 2 / s ^ 2) * |deriv η (‖x - z‖ ^ 2 / s ^ 2)| ≤ 2 * 1 * M :=
            mul_le_mul (mul_le_mul_of_nonneg_left h1 zero_le_two) h2 (abs_nonneg _)
              (by norm_num)
        _ = 2 * M := by ring
    · rw [indicator_of_notMem hx, hη'1 _ (hu_gt x hx), mul_zero, norm_zero]
  /- Step 1.  The radial field `X(x) = η(u(x)) (x - z)` is `C¹`, with
  `DX(x) v = η(u) v + η'(u) (2/s²) ⟪x - z, v⟫ (x - z)` and `tsupport X ⊆ B̄_s(z) ⊆ B_r(z)`. -/
  let X : Euclid P → Euclid P := fun x => η (‖x - z‖ ^ 2 / s ^ 2) • (x - z)
  have hXd : ∀ x, HasFDerivAt X
      (η (‖x - z‖ ^ 2 / s ^ 2) • ContinuousLinearMap.id ℝ (Euclid P) +
        ((deriv η (‖x - z‖ ^ 2 / s ^ 2) * (2 / s ^ 2)) • innerSL ℝ (x - z)).smulRight
          (x - z)) x := by
    intro x
    have h1 : HasFDerivAt (fun x : Euclid P => x - z) (ContinuousLinearMap.id ℝ _) x :=
      (hasFDerivAt_id x).sub_const z
    have h3 : HasFDerivAt (fun x : Euclid P => ‖x - z‖ ^ 2 / s ^ 2)
        ((s ^ 2)⁻¹ • (2 • (innerSL ℝ (x - z)).comp (ContinuousLinearMap.id ℝ (Euclid P)))) x := by
      simpa only [div_eq_mul_inv] using HasFDerivAt.mul_const h1.norm_sq (s ^ 2)⁻¹
    have h5 := ((hηd (‖x - z‖ ^ 2 / s ^ 2)).comp_hasFDerivAt x h3).smul h1
    refine HasFDerivAt.congr_fderiv (f := X) h5 (ContinuousLinearMap.ext fun v => ?_)
    simp only [add_apply, FunLike.coe_smul, Pi.smul_apply,
      ContinuousLinearMap.id_apply, ContinuousLinearMap.smulRight_apply, innerSL_apply_apply,
      ContinuousLinearMap.comp_apply, Function.comp_apply, smul_eq_mul]
    congr 2
    rw [nsmul_eq_mul]
    push_cast
    ring
  have hXcd : ContDiff ℝ 1 X := by
    have h1 : ContDiff ℝ 1 (fun x : Euclid P => ‖x - z‖ ^ 2 / s ^ 2) :=
      ((contDiff_norm_sq ℝ).comp (contDiff_id.sub contDiff_const)).div_const _
    exact (hη.comp h1).smul (contDiff_id.sub contDiff_const)
  have hXzero : ∀ x, x ∉ closedBall z s → X x = 0 := by
    intro x hx
    show η (‖x - z‖ ^ 2 / s ^ 2) • (x - z) = 0
    rw [hη1 _ (hu_gt x hx).le, zero_smul]
  have hXts : tsupport X ⊆ closedBall z s := by
    refine closure_minimal (fun x hx => ?_) isClosed_closedBall
    by_contra h
    exact hx (hXzero x h)
  have hXcs : HasCompactSupport X := HasCompactSupport.intro hBc hXzero
  /- Step 2.  `μ`-a.e. the tangent projection is `∑ᵢ τᵢ ⟪τᵢ, ·⟫` for an orthonormal family `τ`
  of size `n` (`R.orients` and uniqueness of approximate tangent spaces). -/
  have hproj : ∀ τ : Fin n → Euclid P, Orthonormal ℝ τ →
      (Submodule.span ℝ (range τ)).starProjection =
        ∑ i, InnerProductSpace.rankOne ℝ (τ i) (τ i) := by
    intro τ hτ
    let b0 := Module.Basis.span hτ.linearIndependent
    have hb0 : ∀ i, (b0 i : Euclid P) = τ i := fun i =>
      congrArg Subtype.val (Module.Basis.span_apply hτ.linearIndependent i)
    have hb0o : Orthonormal ℝ b0 := by
      have e : (Submodule.span ℝ (range τ)).subtypeₗᵢ ∘ b0 = τ := funext hb0
      rw [← (Submodule.span ℝ (range τ)).subtypeₗᵢ.orthonormal_comp_iff, e]
      exact hτ
    rw [OrthonormalBasis.starProjection_eq_sum_rankOne (b0.toOrthonormalBasis hb0o),
      Module.Basis.coe_toOrthonormalBasis]
    simp only [hb0]
  have hμac : μ ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
  have hPae : ∀ᵐ x ∂μ, ∃ τ : Fin n → Euclid P, Orthonormal ℝ τ ∧
      (approxTangentPlane n R.carrier x).starProjection =
        ∑ i, InnerProductSpace.rankOne ℝ (τ i) (τ i) := by
    refine hμac.ae_le ?_
    filter_upwards [R.orients] with x ⟨Q, hQ, τ, hτ, hspan, _⟩
    have hex : ∃ Q', HasApproximateTangentSpaceAt n R.carrier x Q' := ⟨Q, hQ⟩
    have happrox : approxTangentPlane n R.carrier x = Q := by
      rw [approxTangentPlane, dite_eq_left hex]
      exact hex.choose_spec.unique hQ
    exact ⟨τ, hτ, by rw [happrox, ← hspan, hproj τ hτ]⟩
  /- Step 3.  `div_M X = n η(u) + η'(u) (2/s²) ∑ᵢ ⟪τᵢ, x - z⟫²`, and by Bessel's inequality and
  `η' ≤ 0`, `n η(u) + 2 u η'(u) ≤ div_M X ≤ n η(u)` `μ`-a.e. -/
  let d : Euclid P → ℝ := fun x => tangentialDivergence n R.carrier X x
  -- `trace ((∑ τᵢ ⊗ τᵢ) ∘ L) = ∑ ⟪τᵢ, L τᵢ⟫`
  have htr : ∀ (τ : Fin n → Euclid P) (L : Euclid P →L[ℝ] Euclid P),
      LinearMap.trace ℝ (Euclid P) ((∑ i, InnerProductSpace.rankOne ℝ (τ i) (τ i) :
        Euclid P →L[ℝ] Euclid P).toLinearMap ∘ₗ L.toLinearMap) =
        ∑ i, inner ℝ (τ i) (L (τ i)) := by
    intro τ L
    rw [← ContinuousLinearMap.toLinearMap_comp, ContinuousLinearMap.finsetSum_comp,
      ContinuousLinearMap.toLinearMap_sum, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [ContinuousLinearMap.toLinearMap_comp, LinearMap.trace_comp_comm',
      ← ContinuousLinearMap.toLinearMap_comp, InnerProductSpace.comp_rankOne,
      InnerProductSpace.trace_rankOne]
  -- Bessel's inequality
  have hbessel : ∀ (τ : Fin n → Euclid P), Orthonormal ℝ τ → ∀ v : Euclid P,
      ∑ i, inner ℝ (τ i) v ^ 2 ≤ ‖v‖ ^ 2 := by
    intro τ hτ v
    have := hτ.sum_inner_products_le (s := Finset.univ) (x := v)
    simpa [Real.norm_eq_abs, sq_abs] using this
  have hdae : ∀ᵐ x ∂μ,
      n * η (‖x - z‖ ^ 2 / s ^ 2) + 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ≤
        d x ∧ d x ≤ n * η (‖x - z‖ ^ 2 / s ^ 2) := by
    filter_upwards [hPae] with x ⟨τ, hτ, hPx⟩
    have h1 : ∀ i, inner ℝ (τ i) (τ i) = (1 : ℝ) := fun i => by
      rw [real_inner_self_eq_norm_sq, hτ.1 i, one_pow]
    have e : d x = n * η (‖x - z‖ ^ 2 / s ^ 2) + deriv η (‖x - z‖ ^ 2 / s ^ 2) * (2 / s ^ 2) *
        ∑ i, inner ℝ (τ i) (x - z) ^ 2 := by
      show tangentialDivergence n R.carrier X x = _
      unfold tangentialDivergence
      rw [hPx, (hXd x).fderiv, htr]
      simp only [add_apply, FunLike.coe_smul, Pi.smul_apply, ContinuousLinearMap.id_apply,
        ContinuousLinearMap.smulRight_apply, innerSL_apply_apply, smul_eq_mul, inner_add_right,
        inner_smul_right, h1, Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ,
        Fintype.card_fin, nsmul_eq_mul, mul_one, Finset.mul_sum]
      congr 1
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [real_inner_comm (x - z) (τ i)]
      ring
    have hb := hbessel τ hτ (x - z)
    have hS0 : 0 ≤ ∑ i, inner ℝ (τ i) (x - z) ^ 2 := Finset.sum_nonneg fun i _ => sq_nonneg _
    have hk : deriv η (‖x - z‖ ^ 2 / s ^ 2) * (2 / s ^ 2) ≤ 0 :=
      mul_nonpos_of_nonpos_of_nonneg (hη'0 _) (div_nonneg zero_le_two (sq_nonneg s))
    have h2 := mul_le_mul_of_nonpos_left hb hk
    have h3 := mul_nonpos_of_nonpos_of_nonneg hk hS0
    have e2 : deriv η (‖x - z‖ ^ 2 / s ^ 2) * (2 / s ^ 2) * ‖x - z‖ ^ 2 =
        2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) := by ring
    rw [e]
    exact ⟨e2 ▸ add_le_add le_rfl h2, add_le_of_nonpos_right h3⟩
  /- Step 4.  `div_M X` is `μ`-integrable: it is `AEStronglyMeasurable` (the tangent projection
  is `μ`-measurable, `DX` is continuous, `(A, B) ↦ trace (A ∘ B)` is continuous) and
  `|div_M X| ≤ n η(u) + |2 u η'(u)|` `μ`-a.e. -/
  have hTc : Continuous fun p : (Euclid P →L[ℝ] Euclid P) × (Euclid P →L[ℝ] Euclid P) =>
      LinearMap.trace ℝ (Euclid P) (p.1.toLinearMap ∘ₗ p.2.toLinearMap) := by
    have h1 : Continuous fun A : Euclid P →L[ℝ] Euclid P =>
        LinearMap.trace ℝ (Euclid P) A.toLinearMap :=
      ((LinearMap.trace ℝ (Euclid P)).comp
        (ContinuousLinearMap.coeLM ℝ)).continuous_of_finiteDimensional
    exact h1.comp (continuous_fst.clm_comp continuous_snd)
  have hPmeas : AEStronglyMeasurable
      (fun x => (approxTangentPlane n R.carrier x).starProjection) μ := hPm.aestronglyMeasurable
  have hdmeas : AEStronglyMeasurable d μ := by
    have h3 := hTc.comp_aestronglyMeasurable
      (hPmeas.prodMk (hXcd.continuous_fderiv one_ne_zero).aestronglyMeasurable)
    show AEStronglyMeasurable (fun x => tangentialDivergence n R.carrier X x) μ
    unfold tangentialDivergence
    exact h3
  have hdint : Integrable d μ := by
    refine Integrable.mono' ((hFint.const_mul n).add hGint.abs) hdmeas ?_
    filter_upwards [hdae] with x hx
    have h0 : 0 ≤ (n : ℝ) * η (‖x - z‖ ^ 2 / s ^ 2) := mul_nonneg (Nat.cast_nonneg n) (hη0 _)
    have hG1 := neg_abs_le (2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2))
    have hG2 := abs_nonneg (2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2))
    show ‖d x‖ ≤ n * η (‖x - z‖ ^ 2 / s ^ 2) +
      |2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)|
    rw [Real.norm_eq_abs, abs_le]
    exact ⟨by linarith [hx.1], by linarith [hx.2]⟩
  /- Step 5.  `∫ f dμ = ∫_M θ f dHⁿ`, so `∫ div_M X dμ = R.firstVariation X`. -/
  have hμint : ∀ f : Euclid P → ℝ,
      ∫ x, f x ∂μ = ∫ x in R.carrier, (R.mult x : ℝ) * f x ∂μHE[n] := by
    intro f
    have hθ : (fun x => (R.mult x : ℝ≥0∞)) = fun x => ((R.mult x : NNReal) : ℝ≥0∞) := by
      funext x
      simp
    have hθm : Measurable fun x => (R.mult x : NNReal) :=
      measurable_from_top.comp R.measurable_mult
    rw [hμ, IMRep.measure, hθ, integral_withDensity_eq_integral_smul hθm]
    refine integral_congr_ae (ae_of_all _ fun x => ?_)
    simp [NNReal.smul_def]
  /- Step 6.  Integrate: `n ∫ η(u) + ∫ 2 u η'(u) ≤ ∫ div_M X = -∫ X · H ≤ κ s ∫ η(u)`, using
  `|X · H| ≤ ‖X‖ κ ≤ κ s η(u)` (`X = 0` off `B̄_s(z)`). -/
  have e1 : (n : ℝ) * ∫ x, η (‖x - z‖ ^ 2 / s ^ 2) ∂μ +
      ∫ x, 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ∂μ =
      ∫ x, ((n : ℝ) * η (‖x - z‖ ^ 2 / s ^ 2) +
        2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)) ∂μ := by
    rw [integral_add (hFint.const_mul _) hGint, integral_const_mul]
  have e3 : ∫ x, ((n : ℝ) * η (‖x - z‖ ^ 2 / s ^ 2) +
        2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)) ∂μ ≤ ∫ x, d x ∂μ := by
    refine integral_mono_ae ((hFint.const_mul _).add hGint) hdint ?_
    filter_upwards [hdae] with x hx
    exact hx.1
  have e4 : ∫ x, d x ∂μ = -∫ x, inner ℝ (X x) (H x) ∂μ := by
    rw [hμint]
    exact hfv X hXcd hXcs (hXts.trans hBr)
  have e5 : -∫ x, inner ℝ (X x) (H x) ∂μ ≤ κ * s * ∫ x, η (‖x - z‖ ^ 2 / s ^ 2) ∂μ := by
    have h1 : -∫ x, inner ℝ (X x) (H x) ∂μ ≤ ∫ x, ‖inner ℝ (X x) (H x)‖ ∂μ := by
      refine (neg_le_abs _).trans ?_
      rw [← Real.norm_eq_abs]
      exact norm_integral_le_integral_norm _
    have h2 : ∫ x, ‖inner ℝ (X x) (H x)‖ ∂μ ≤ ∫ x, κ * s * η (‖x - z‖ ^ 2 / s ^ 2) ∂μ := by
      refine integral_mono_of_nonneg (ae_of_all _ fun x => norm_nonneg _) (hFint.const_mul _)
        (ae_of_all _ fun x => ?_)
      show ‖inner ℝ (X x) (H x)‖ ≤ κ * s * η (‖x - z‖ ^ 2 / s ^ 2)
      by_cases hx : x ∈ closedBall z s
      · have hXn : ‖X x‖ ≤ η (‖x - z‖ ^ 2 / s ^ 2) * s := by
          show ‖η (‖x - z‖ ^ 2 / s ^ 2) • (x - z)‖ ≤ η (‖x - z‖ ^ 2 / s ^ 2) * s
          rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (hη0 _)]
          exact mul_le_mul_of_nonneg_left (by rwa [mem_closedBall, dist_eq_norm] at hx) (hη0 _)
        calc ‖inner ℝ (X x) (H x)‖ ≤ ‖X x‖ * ‖H x‖ := norm_inner_le_norm _ _
          _ ≤ (η (‖x - z‖ ^ 2 / s ^ 2) * s) * κ :=
            mul_le_mul hXn (hHκ x) (norm_nonneg _) (mul_nonneg (hη0 _) hs.le)
          _ = κ * s * η (‖x - z‖ ^ 2 / s ^ 2) := by ring
      · rw [hXzero x hx, inner_zero_left, norm_zero]
        exact mul_nonneg (mul_nonneg hκ0 hs.le) (hη0 _)
    rw [integral_const_mul] at h2
    exact h1.trans h2
  calc (n : ℝ) * ∫ x, η (‖x - z‖ ^ 2 / s ^ 2) ∂μ +
        ∫ x, 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ∂μ = _ := e1
    _ ≤ _ := e3
    _ = _ := e4
    _ ≤ _ := e5
/-- **Radial cutoffs for the monotonicity formula** (Simon Ch. 4, 3.1–3.4).  With
`g = Real.smoothTransition` and `ηⱼ(u) = g((j + 2)(1 − u))`, every `ηⱼ` is `C¹`, nonnegative and
nonincreasing, vanishes for `u ≥ 1`, and `ηⱼ(|x − z|²/s²)` increases to the indicator of the
open ball `B_s(z)`; by dominated convergence `∫ ηⱼ(|x − z|²/s²) dμ → μ(B_s(z))` whenever
`μ(B_s(z)) < ∞`. -/
theorem Submission.dsmc_em_cutoff_tendsto_ball : ∃ η : ℕ → ℝ → ℝ, (∀ j, ContDiff ℝ 1 (η j)) ∧ (∀ j u, 0 ≤ η j u) ∧ (∀ j u, deriv (η j) u ≤ 0) ∧ (∀ j u, 1 ≤ u → η j u = 0) ∧ ∀ (P : ℕ) (μ : Measure (Euclid P)) (z : Euclid P) (s : ℝ), 0 < s → μ (ball z s) < ∞ → Tendsto (fun j => ∫ x, η j (‖x - z‖ ^ 2 / s ^ 2) ∂μ) atTop (𝓝 (μ.real (ball z s))) := by
  -- Steps 1–5: `ηⱼ(u) = g((j + 2)(1 − u))` is `C¹`, `≥ 0`, antitone, and `0` for `u ≥ 1`.
  have hanti : ∀ j : ℕ, Antitone fun u : ℝ => Real.smoothTransition (((j : ℝ) + 2) * (1 - u)) := by
    intro j a b hab
    apply Real.smoothTransition.monotone
    have hj : (0 : ℝ) ≤ (j : ℝ) + 2 := by positivity
    nlinarith
  have hzero : ∀ (j : ℕ) (u : ℝ), 1 ≤ u →
      Real.smoothTransition (((j : ℝ) + 2) * (1 - u)) = 0 := by
    intro j u hu
    apply Real.smoothTransition.zero_of_nonpos
    have hj : (0 : ℝ) ≤ (j : ℝ) + 2 := by positivity
    nlinarith
  refine ⟨fun j u => Real.smoothTransition (((j : ℝ) + 2) * (1 - u)), fun j => ?_,
    fun j u => Real.smoothTransition.nonneg _, fun j u => (hanti j).deriv_nonpos, hzero, ?_⟩
  · exact Real.smoothTransition.contDiff.comp (contDiff_const.mul (contDiff_const.sub contDiff_id))
  -- Step 6: dominated convergence with the bound `1_{B_s(z)}`.
  intro P μ z s hs hμ
  have hs2 : 0 < s ^ 2 := by positivity
  -- `|x − z|²/s² < 1` exactly on the open ball
  have hlt : ∀ x : Euclid P, x ∈ ball z s → ‖x - z‖ ^ 2 / s ^ 2 < 1 := by
    intro x hx
    rw [mem_ball, dist_eq_norm] at hx
    rw [div_lt_one hs2]
    exact pow_lt_pow_left₀ hx (norm_nonneg _) two_ne_zero
  have hge : ∀ x : Euclid P, x ∉ ball z s → 1 ≤ ‖x - z‖ ^ 2 / s ^ 2 := by
    intro x hx
    rw [mem_ball, dist_eq_norm, not_lt] at hx
    rw [one_le_div hs2]
    exact pow_le_pow_left₀ hs.le hx 2
  have hint : Integrable ((ball z s).indicator (1 : Euclid P → ℝ)) μ :=
    (integrable_indicator_iff measurableSet_ball).2 (integrableOn_const hμ.ne)
  rw [← integral_indicator_one measurableSet_ball]
  refine tendsto_integral_of_dominated_convergence ((ball z s).indicator 1)
    (F := fun (j : ℕ) (x : Euclid P) =>
      Real.smoothTransition (((j : ℝ) + 2) * (1 - ‖x - z‖ ^ 2 / s ^ 2)))
    (fun j => ?_) hint (fun j => ae_of_all _ fun x => ?_) (ae_of_all _ fun x => ?_)
  · -- (a) each integrand is continuous
    exact (Real.smoothTransition.continuous.comp (by fun_prop)).aestronglyMeasurable
  · -- (a) `|ηⱼ(u(x))| ≤ 1_{B_s(z)}(x)`
    by_cases hx : x ∈ ball z s
    · rw [indicator_of_mem hx, Pi.one_apply, Real.norm_eq_abs,
        abs_of_nonneg (Real.smoothTransition.nonneg _)]
      exact Real.smoothTransition.le_one _
    · rw [indicator_of_notMem hx, hzero j _ (hge x hx), norm_zero]
  · -- (b) pointwise convergence to `1_{B_s(z)}(x)`
    by_cases hx : x ∈ ball z s
    · rw [indicator_of_mem hx, Pi.one_apply]
      have hpos : 0 < 1 - ‖x - z‖ ^ 2 / s ^ 2 := sub_pos.2 (hlt x hx)
      obtain ⟨N, hN⟩ := exists_nat_ge (1 / (1 - ‖x - z‖ ^ 2 / s ^ 2))
      rw [div_le_iff₀ hpos] at hN
      refine tendsto_const_nhds.congr' (eventually_atTop.2 ⟨N, fun j hj => ?_⟩)
      have hj : (N : ℝ) ≤ j := by exact_mod_cast hj
      refine (Real.smoothTransition.one_of_one_le ?_).symm
      nlinarith
    · rw [indicator_of_notMem hx]
      exact tendsto_const_nhds.congr fun j => (hzero j _ (hge x hx)).symm

/-- **Monotonicity of `e^{κρ} ρ⁻ⁿ μ_R(B_ρ(z))` under bounded generalized mean curvature**
(Simon Ch. 4, 3.14–3.17).  If `δV(X) = -∫ X · H dμ_R` for `C¹` fields `X` supported in `B_r(z)`,
`B̄_r(z) ⊆ U` and `|H| ≤ κ`, then `e^{κs} s⁻ⁿ μ_R(B_s(z))` is nondecreasing on `(0, r]`.  For each
radial cutoff `ηⱼ`, `I(s) = ∫ ηⱼ(|x - z|²/s²) dμ_R` satisfies `n I - s I' ≤ κ s I` on `(0, r)`, so
`e^{κs} s⁻ⁿ I(s)` is nondecreasing; letting `j → ∞` gives `I(s) → μ_R(B_s(z))`. -/
theorem Submission.dsmc_exp_ball_mass_monotone : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (H : Euclid P → Euclid P) (κ : ℝ) (z : Euclid P) (r : ℝ), closedBall z r ⊆ U → AEMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) R.measure → AEStronglyMeasurable H R.measure → (∀ x, ‖H x‖ ≤ κ) → (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ ball z r → R.firstVariation X = -∫ x, inner ℝ (X x) (H x) ∂R.measure) → ∀ σ ρ : ℝ, 0 < σ → σ ≤ ρ → ρ ≤ r → ENNReal.ofReal (Real.exp (κ * σ) / σ ^ n) * R.measure (ball z σ) ≤ ENNReal.ofReal (Real.exp (κ * ρ) / ρ ^ n) * R.measure (ball z ρ) := by
  intro P n U R H κ z r hzU hPm _ hHκ hfv σ ρ hσ hσρ hρr
  have hρ : 0 < ρ := hσ.trans_le hσρ
  -- (a) `μ(B̄_r(z)) < ∞` (`R.locallyIntegrable_mult`), so `μ(B_t(z)) < ∞` for `t ≤ r`
  have hμB : R.measure (closedBall z r) < ∞ := by
    rw [IMRep.measure, withDensity_apply _ measurableSet_closedBall,
      Measure.restrict_restrict measurableSet_closedBall, inter_comm]
    exact lt_top_iff_ne_top.mpr (R.locallyIntegrable_mult _ (isCompact_closedBall z r) hzU)
  have hμt : ∀ t, t ≤ r → R.measure (ball z t) < ∞ := fun t ht =>
    (measure_mono (ball_subset_closedBall.trans (closedBall_subset_closedBall ht))).trans_lt hμB
  -- (b) for each cutoff `ηⱼ`, `e^{κs} s⁻ⁿ ∫ ηⱼ(|x - z|²/s²) dμ` is nondecreasing on `(0, r]`
  obtain ⟨η, hηC, hη0, hη'0, hη1, hlim⟩ := Submission.dsmc_em_cutoff_tendsto_ball
  have hj : ∀ j, Real.exp (κ * σ) / σ ^ n * ∫ x, η j (‖x - z‖ ^ 2 / σ ^ 2) ∂R.measure ≤
      Real.exp (κ * ρ) / ρ ^ n * ∫ x, η j (‖x - z‖ ^ 2 / ρ ^ 2) ∂R.measure := by
    intro j
    obtain ⟨hcont, hderiv⟩ := Submission.dsmc_em_cutoff_integral_hasDerivAt P R.measure z r (η j)
      (hμt r le_rfl) (hηC j) (hη1 j)
    refine Submission.dsmc_em_exp_monotoneOn_of_deriv_ineq n κ r _ _ hcont hderiv (fun s hs => ?_)
      ⟨hσ, hσρ.trans hρr⟩ ⟨hρ, hρr⟩ hσρ
    -- `n I(s) - s I'(s) = n I(s) + ∫ 2 u η'(u) dμ ≤ κ s I(s)`
    have h := Submission.dsmc_em_cutoff_first_variation_le P n U R H κ z r (η j) hzU hPm hHκ hfv
      (hηC j) (hη0 j) (hη'0 j) (hη1 j) s hs.1 hs.2
    rw [mul_div_cancel₀ _ hs.1.ne', sub_neg_eq_add]
    exact h
  -- (c) let `j → ∞`: the integrals tend to `μ(B_σ(z))` and `μ(B_ρ(z))`
  have hreal : Real.exp (κ * σ) / σ ^ n * R.measure.real (ball z σ) ≤
      Real.exp (κ * ρ) / ρ ^ n * R.measure.real (ball z ρ) :=
    le_of_tendsto_of_tendsto'
      ((hlim P R.measure z σ hσ (hμt σ (hσρ.trans hρr))).const_mul _)
      ((hlim P R.measure z ρ hρ (hμt ρ hρr)).const_mul _) hj
  -- (d) transfer to `[0, ∞]`
  rw [← ofReal_measureReal (hμt σ (hσρ.trans hρr)).ne, ← ofReal_measureReal (hμt ρ hρr).ne,
    ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
  exact ENNReal.ofReal_le_ofReal hreal

/-- Simon Ch. 5, proof of Theorem 5.2, (3)–(5) (p. 123: "(4) evidently implies that there is
`S(ξ) = lim S_ℓ` such that (5)"), in a complete metric space: if `dist(v_j, v_{j+1})² ≤ a q^j` with
`0 ≤ q ≤ 1/4`, then `v_j → w` and `dist(v_j, w)² ≤ 4 a q^j`.  With `h = √q ≤ 1/2` the consecutive
distances are `≤ √a h^j`, so `(v_j)` is Cauchy and `dist(v_j, w) ≤ √a h^j / (1 − h) ≤ 2 √a h^j`. -/
theorem Submission.dorag_ted_pl_geometric_limit : ∀ (X : Type) [MetricSpace X] [CompleteSpace X] (v : ℕ → X) (a q : ℝ), 0 ≤ q → q ≤ 1 / 4 → (∀ j : ℕ, dist (v j) (v (j + 1)) ^ 2 ≤ a * q ^ j) → ∃ w : X, Tendsto v atTop (𝓝 w) ∧ ∀ j : ℕ, dist (v j) w ^ 2 ≤ 4 * a * q ^ j := by
  intro X _ _ v a q hq hq4 hv
  -- Step 1: `a ≥ 0` (take `j = 0`)
  have ha : 0 ≤ a := by
    have hv0 := hv 0
    rw [pow_zero, mul_one] at hv0
    exact (sq_nonneg _).trans hv0
  -- Step 2: `h = √q` has `0 ≤ h ≤ 1/2` and `(√a h^j)² = a q^j`
  set h := Real.sqrt q
  have h0 : 0 ≤ h := Real.sqrt_nonneg q
  have h2 : h ^ 2 = q := Real.sq_sqrt hq
  have hhalf : h ≤ 1 / 2 := (Real.sqrt_le_left (by norm_num)).2 (by norm_num; linarith)
  have h1 : h < 1 := by linarith
  have hC : ∀ j : ℕ, 0 ≤ Real.sqrt a * h ^ j := fun j =>
    mul_nonneg (Real.sqrt_nonneg a) (pow_nonneg h0 j)
  have hCsq : ∀ j : ℕ, (Real.sqrt a * h ^ j) ^ 2 = a * q ^ j := fun j => by
    rw [mul_pow, Real.sq_sqrt ha, ← pow_mul, mul_comm j 2, pow_mul, h2]
  -- Step 3: `dist(v_j, v_{j+1}) ≤ √a h^j`
  have hstep : ∀ j : ℕ, dist (v j) (v (j + 1)) ≤ Real.sqrt a * h ^ j := fun j => by
    rw [← pow_le_pow_iff_left₀ dist_nonneg (hC j) two_ne_zero, hCsq j]
    exact hv j
  -- Step 4: `(v_j)` is Cauchy, so it converges in the complete space `X`
  obtain ⟨w, hw⟩ :=
    cauchySeq_tendsto_of_complete (cauchySeq_of_le_geometric h (Real.sqrt a) h1 hstep)
  refine ⟨w, hw, fun j => ?_⟩
  -- Step 5: `dist(v_j, w) ≤ √a h^j / (1 − h) ≤ 2 √a h^j`
  have htail : dist (v j) w ≤ 2 * (Real.sqrt a * h ^ j) := by
    refine (dist_le_of_le_geometric_of_tendsto h (Real.sqrt a) h1 hstep hw j).trans ?_
    rw [div_le_iff₀ (by linarith)]
    nlinarith [hC j]
  -- Step 6: square
  calc dist (v j) w ^ 2 ≤ (2 * (Real.sqrt a * h ^ j)) ^ 2 := pow_le_pow_left₀ dist_nonneg htail 2
    _ = 4 * a * q ^ j := by rw [mul_pow, hCsq j]; ring
/-- **Limits of orthogonal projections onto `n`-planes** (Simon Ch. 5, proof of Theorem 5.2:
"(4) evidently implies that there is `S(ξ) (= lim S_ℓ)` such that (5)").  If every `S_j` is an
`n`-dimensional subspace of `ℝᴾ` and `p_{S_j} eᵢ → wᵢ` for every standard basis vector `eᵢ`, then
`wᵢ = p_{S'} eᵢ` for an `n`-dimensional subspace `S'`: the operator `L` with `L eᵢ = wᵢ` is the
pointwise limit of the `p_{S_j}`, hence idempotent and self-adjoint, hence the orthogonal
projection onto `S' = range L`, and `dim S' = trace p_{S'} = lim trace p_{S_j} = n`. -/
theorem Submission.dorag_ted_pl_proj_limit_rank : ∀ (P n : ℕ) (S : ℕ → Submodule ℝ (Euclid P)) (w : Fin P → Euclid P), (∀ j, Module.finrank ℝ (S j) = n) → (∀ i : Fin P, Tendsto (fun j => (S j).starProjection (EuclideanSpace.single i (1 : ℝ))) atTop (𝓝 (w i))) → ∃ S' : Submodule ℝ (Euclid P), Module.finrank ℝ S' = n ∧ ∀ i : Fin P, S'.starProjection (EuclideanSpace.single i (1 : ℝ)) = w i := by
  intro P n S w hS hw
  -- the standard orthonormal basis `eᵢ = EuclideanSpace.single i 1`
  obtain ⟨b, hb⟩ : ∃ b : OrthonormalBasis (Fin P) ℝ (Euclid P),
      ∀ i, b i = EuclideanSpace.single i (1 : ℝ) :=
    ⟨EuclideanSpace.basisFun (Fin P) ℝ, EuclideanSpace.basisFun_apply (Fin P) ℝ⟩
  -- Step 1: column expansion `A x = ∑ᵢ xᵢ • A eᵢ`
  have hcol : ∀ (A : Euclid P →L[ℝ] Euclid P) (x : Euclid P),
      A x = ∑ i, inner ℝ (b i) x • A (b i) := by
    intro A x
    conv_lhs => rw [← b.sum_repr' x]
    simp only [map_sum, map_smul]
  -- Step 2: the limit operator, `L eᵢ = wᵢ`
  obtain ⟨L, hLb⟩ : ∃ L : Euclid P →L[ℝ] Euclid P, ∀ i, L (b i) = w i :=
    ⟨LinearMap.toContinuousLinearMap (b.toBasis.constr ℝ w), fun i => by
      rw [LinearMap.coe_toContinuousLinearMap', ← b.coe_toBasis, b.toBasis.constr_basis]⟩
  -- Step 3: `p_{S_j} x → L x` for every `x`
  have hconv : ∀ x, Tendsto (fun j => (S j).starProjection x) atTop (𝓝 (L x)) := by
    intro x
    have h1 : (fun j => (S j).starProjection x) =
        fun j => ∑ i, inner ℝ (b i) x • (S j).starProjection (b i) :=
      funext fun j => hcol _ x
    rw [h1, hcol L x]
    refine tendsto_finsetSum _ fun i _ => ?_
    rw [hLb i, hb i]
    exact (hw i).const_smul _
  -- Step 4: `L` is idempotent
  have hidem : ∀ x, L (L x) = L x := by
    intro x
    -- `p_{S_j} (p_{S_j} x) = p_{S_j} x → L x`
    have h1 : Tendsto (fun j => (S j).starProjection ((S j).starProjection x)) atTop
        (𝓝 (L x)) := by
      have : (fun j => (S j).starProjection ((S j).starProjection x)) =
          fun j => (S j).starProjection x :=
        funext fun j => Submodule.starProjection_eq_self_iff.mpr
          (Submodule.starProjection_apply_mem _ _)
      rw [this]
      exact hconv x
    -- `p_{S_j} (p_{S_j} x) = p_{S_j} (p_{S_j} x - L x) + p_{S_j} (L x) → 0 + L (L x)`
    have h2 : Tendsto (fun j => (S j).starProjection ((S j).starProjection x)) atTop
        (𝓝 (L (L x))) := by
      have hsplit : (fun j => (S j).starProjection ((S j).starProjection x)) =
          fun j => (S j).starProjection ((S j).starProjection x - L x) +
            (S j).starProjection (L x) :=
        funext fun j => by rw [← map_add, sub_add_cancel]
      rw [hsplit, ← zero_add (L (L x))]
      refine Tendsto.add ?_ (hconv (L x))
      have h0 : Tendsto (fun j => (S j).starProjection x - L x) atTop (𝓝 0) := by
        simpa using (hconv x).sub_const (L x)
      exact squeeze_zero_norm (fun j => Submodule.norm_starProjection_apply_le _ _)
        (by simpa using h0.norm)
    exact tendsto_nhds_unique h2 h1
  -- Step 5: `L` is symmetric
  have hsymm : ∀ x y, inner ℝ (L x) y = inner ℝ x (L y) := by
    intro x y
    have h1 : Tendsto (fun j => inner ℝ ((S j).starProjection x) y) atTop
        (𝓝 (inner ℝ (L x) y)) := (hconv x).inner tendsto_const_nhds
    have h2 : Tendsto (fun j => inner ℝ ((S j).starProjection x) y) atTop
        (𝓝 (inner ℝ x (L y))) := by
      simp_rw [Submodule.inner_starProjection_left_eq_right]
      exact tendsto_const_nhds.inner (hconv y)
    exact tendsto_nhds_unique h1 h2
  -- Step 6: `L` is the orthogonal projection onto `S' := range L`
  have hL : IsStarProjection L :=
    ⟨ContinuousLinearMap.ext hidem, ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mpr hsymm⟩
  obtain ⟨_, hLeq⟩ := isStarProjection_iff_eq_starProjection_range.mp hL
  -- Steps 7–8: `dim K = trace p_K = ∑ᵢ ⟪eᵢ, p_K eᵢ⟫`
  have htr : ∀ K : Submodule ℝ (Euclid P),
      (Module.finrank ℝ K : ℝ) = ∑ i, inner ℝ (b i) (K.starProjection (b i)) := by
    intro K
    have hproj : LinearMap.IsProj K (K.starProjection : Euclid P →ₗ[ℝ] Euclid P) :=
      ⟨fun x => K.starProjection_apply_mem x,
        fun x hx => Submodule.starProjection_eq_self_iff.mpr hx⟩
    rw [← hproj.trace, LinearMap.trace_eq_sum_inner _ b]
    rfl
  -- Step 9: `dim S' = lim_j dim S_j = n`
  have hlim : Tendsto (fun j => ∑ i, inner ℝ (b i) ((S j).starProjection (b i))) atTop
      (𝓝 (∑ i, inner ℝ (b i) (w i))) := by
    refine tendsto_finsetSum _ fun i _ => ?_
    rw [hb i]
    exact tendsto_const_nhds.inner (hw i)
  have hsum : ∑ i, inner ℝ (b i) (w i) = (n : ℝ) := by
    refine tendsto_nhds_unique hlim ?_
    have : (fun j => ∑ i, inner ℝ (b i) ((S j).starProjection (b i))) = fun _ => (n : ℝ) :=
      funext fun j => by rw [← htr, hS j]
    rw [this]
    exact tendsto_const_nhds
  refine ⟨LinearMap.range (L : Euclid P →ₗ[ℝ] Euclid P), ?_, fun i => ?_⟩
  · have : (Module.finrank ℝ (LinearMap.range (L : Euclid P →ₗ[ℝ] Euclid P)) : ℝ) = n := by
      rw [htr, ← hsum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [← hLeq, hLb i]
    exact_mod_cast this
  · rw [← hb i, ← hLeq]
    exact hLb i

/-- **Limit of geometrically converging `n`-planes** (Simon Ch. 5, proof of Theorem 5.2, (4)–(5):
"(4) evidently implies that there is `S(ξ)` (`= lim S_ℓ`) such that (5)").  With the squared
Hilbert–Schmidt distance `d(A, B) = Σᵢ |A eᵢ − B eᵢ|²`, if `dim Sⱼ = n`, `0 ≤ q ≤ 1/4` and
`d(p_{S_{j+1}}, p_{S_j}) ≤ a qʲ`, then some `n`-plane `S'` has `d(p_{S'}, p_{S_j}) ≤ 4 a qʲ`.
The vectors `vⱼ = (p_{S_j} eᵢ)ᵢ` of the complete `ℓ²`-product `PiLp 2` satisfy
`dist(vⱼ, vₖ)² = d(p_{S_j}, p_{S_k})`, so they converge to some `w` with `dist(vⱼ, w)² ≤ 4 a qʲ`;
the columns `p_{S_j} eᵢ` then converge to `wᵢ`, and `wᵢ = p_{S'} eᵢ` for an `n`-plane `S'`. -/
theorem Submission.dorag_ted_planes_limit : ∀ (P n : ℕ) (S : ℕ → Submodule ℝ (Euclid P)) (a q : ℝ), (∀ j, Module.finrank ℝ (S j) = n) → 0 ≤ q → q ≤ 1 / 4 → (∀ j : ℕ, ∑ i : Fin P, ‖(S (j + 1)).starProjection (EuclideanSpace.single i (1 : ℝ)) - (S j).starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2 ≤ a * q ^ j) → ∃ S' : Submodule ℝ (Euclid P), Module.finrank ℝ S' = n ∧ ∀ j : ℕ, ∑ i : Fin P, ‖S'.starProjection (EuclideanSpace.single i (1 : ℝ)) - (S j).starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2 ≤ 4 * a * q ^ j := by
  intro P n S a q hS hq0 hq1 hstep
  -- the Hilbert–Schmidt vectors `vⱼ = (p_{S_j} eᵢ)ᵢ` in the complete `ℓ²`-product
  let v : ℕ → PiLp 2 (fun _ : Fin P => Euclid P) := fun j =>
    WithLp.toLp 2 fun i => (S j).starProjection (EuclideanSpace.single i (1 : ℝ))
  -- `dist(u, u')² = Σᵢ |uᵢ − u'ᵢ|²`
  have hdist : ∀ u u' : PiLp 2 (fun _ : Fin P => Euclid P),
      dist u u' ^ 2 = ∑ i : Fin P, ‖u i - u' i‖ ^ 2 := fun u u' => by
    rw [PiLp.dist_sq_eq_of_L2]
    simp only [dist_eq_norm]
  -- `vⱼ → w` with `dist(vⱼ, w)² ≤ 4 a qʲ`, since `dist(vⱼ, vⱼ₊₁)² = d(p_{S_{j+1}}, p_{S_j})`
  obtain ⟨w, hw, hvw⟩ := Submission.dorag_ted_pl_geometric_limit
    (PiLp 2 (fun _ : Fin P => Euclid P)) v a q hq0 hq1 fun j => by
      rw [dist_comm, hdist]
      exact hstep j
  -- the columns converge, `p_{S_j} eᵢ → wᵢ`, so `wᵢ = p_{S'} eᵢ` for an `n`-plane `S'`
  obtain ⟨S', hS', hS'w⟩ := Submission.dorag_ted_pl_proj_limit_rank P n S (fun i => w i) hS
    fun i => ((PiLp.continuous_apply 2 _ i).tendsto w).comp hw
  refine ⟨S', hS', fun j => ?_⟩
  -- `d(p_{S'}, p_{S_j}) = dist(vⱼ, w)²`
  calc ∑ i : Fin P, ‖S'.starProjection (EuclideanSpace.single i (1 : ℝ)) -
        (S j).starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2
      = dist (v j) w ^ 2 := by
        rw [dist_comm, hdist]
        simp only [hS'w]
        rfl
    _ ≤ 4 * a * q ^ j := hvw j
/-- **Simon Ch. 5, Remark 4.6 and proof of Theorem 5.2, (6)–(8)** (integrated Hilbert–Schmidt
triangle inequalities).  Let `eᵢ` be the standard basis of `ℝᴾ`, `d = Σᵢ |A₁eᵢ − A₂eᵢ|²` and
`f_k(x) = Σᵢ |τ(x)eᵢ − A_keᵢ|²`.  Then, as lower integrals in `[0, ∞]` over an arbitrary set `s`,
(i) `d μ(s) ≤ 2∫_s f₁ dμ + 2∫_s f₂ dμ` and (ii) `∫_s f₁ dμ ≤ 2∫_s f₂ dμ + 2d μ(s)`.  Both integrate
`|u − w|² ≤ 2|u − v|² + 2|v − w|²` over `s`.  Additivity of the lower integral in (i) uses the a.e.
strong measurability of `τ`; in (ii) the second summand is constant. -/
theorem Submission.dorag_ted_hs_integral_compare : ∀ (P : ℕ) (μ : Measure (Euclid P)) (τ : Euclid P → (Euclid P →L[ℝ] Euclid P)) (A₁ A₂ : Euclid P →L[ℝ] Euclid P) (s : Set (Euclid P)), AEStronglyMeasurable τ μ → ENNReal.ofReal (∑ i : Fin P, ‖A₁ (EuclideanSpace.single i (1 : ℝ)) - A₂ (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) * μ s ≤ 2 * (∫⁻ x in s, ENNReal.ofReal (∑ i : Fin P, ‖τ x (EuclideanSpace.single i (1 : ℝ)) - A₁ (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂μ) + 2 * (∫⁻ x in s, ENNReal.ofReal (∑ i : Fin P, ‖τ x (EuclideanSpace.single i (1 : ℝ)) - A₂ (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂μ) ∧ (∫⁻ x in s, ENNReal.ofReal (∑ i : Fin P, ‖τ x (EuclideanSpace.single i (1 : ℝ)) - A₁ (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂μ) ≤ 2 * (∫⁻ x in s, ENNReal.ofReal (∑ i : Fin P, ‖τ x (EuclideanSpace.single i (1 : ℝ)) - A₂ (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂μ) + 2 * ENNReal.ofReal (∑ i : Fin P, ‖A₁ (EuclideanSpace.single i (1 : ℝ)) - A₂ (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) * μ s := by
  intro P μ τ A₁ A₂ s hτ
  set d : ℝ := ∑ i : Fin P,
    ‖A₁ (EuclideanSpace.single i (1 : ℝ)) - A₂ (EuclideanSpace.single i (1 : ℝ))‖ ^ 2
  set f : (Euclid P →L[ℝ] Euclid P) → Euclid P → ℝ := fun A x => ∑ i : Fin P,
    ‖τ x (EuclideanSpace.single i (1 : ℝ)) - A (EuclideanSpace.single i (1 : ℝ))‖ ^ 2
  -- Step 1: `Σᵢ |uᵢ − wᵢ|² ≤ 2Σᵢ |uᵢ − vᵢ|² + 2Σᵢ |vᵢ − wᵢ|²`, by the triangle inequality and
  -- `(α + β)² ≤ 2α² + 2β²`
  have key : ∀ u v w : Fin P → Euclid P,
      ∑ i, ‖u i - w i‖ ^ 2 ≤ 2 * ∑ i, ‖u i - v i‖ ^ 2 + 2 * ∑ i, ‖v i - w i‖ ^ 2 := by
    intro u v w
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_le_sum fun i _ => ?_
    nlinarith [norm_sub_le_norm_sub_add_norm_sub (u i) (v i) (w i), norm_nonneg (u i - w i),
      norm_nonneg (u i - v i), norm_nonneg (v i - w i), sq_nonneg (‖u i - v i‖ - ‖v i - w i‖)]
  -- Step 2: nonnegativity, and `ofReal (2a + 2b) = 2 ofReal a + 2 ofReal b` for `a, b ≥ 0`
  have hd0 : 0 ≤ d := Finset.sum_nonneg fun i _ => sq_nonneg _
  have hf0 : ∀ A x, 0 ≤ f A x := fun A x => Finset.sum_nonneg fun i _ => sq_nonneg _
  have hof : ∀ a b : ℝ, 0 ≤ a → 0 ≤ b →
      ENNReal.ofReal (2 * a + 2 * b) = 2 * ENNReal.ofReal a + 2 * ENNReal.ofReal b := by
    intro a b ha hb
    rw [ENNReal.ofReal_add (by positivity) (by positivity), ENNReal.ofReal_mul zero_le_two,
      ENNReal.ofReal_mul zero_le_two, ENNReal.ofReal_ofNat]
  -- Step 3: `f A = Φ_A ∘ τ` with `Φ_A(L) = Σᵢ |Leᵢ − Aeᵢ|²` continuous, so `ofReal ∘ f A` is a.e.
  -- measurable for `μ⌞s`
  have hmeas : ∀ A, AEMeasurable (fun x => ENNReal.ofReal (f A x)) (μ.restrict s) := by
    intro A
    have hc : Continuous fun L : Euclid P →L[ℝ] Euclid P => ∑ i : Fin P,
        ‖L (EuclideanSpace.single i (1 : ℝ)) - A (EuclideanSpace.single i (1 : ℝ))‖ ^ 2 := by
      fun_prop
    exact ENNReal.measurable_ofReal.comp_aemeasurable
      (hc.comp_aestronglyMeasurable hτ.restrict).aemeasurable
  constructor
  · -- Step 4, (i): `ofReal d ≤ 2 ofReal (f₁ x) + 2 ofReal (f₂ x)`; integrate over `s`
    have hpt : ∀ x,
        ENNReal.ofReal d ≤ 2 * ENNReal.ofReal (f A₁ x) + 2 * ENNReal.ofReal (f A₂ x) := by
      intro x
      have h := key (fun i => A₁ (EuclideanSpace.single i (1 : ℝ)))
        (fun i => τ x (EuclideanSpace.single i (1 : ℝ)))
        (fun i => A₂ (EuclideanSpace.single i (1 : ℝ)))
      simp only [norm_sub_rev (A₁ _) (τ x _)] at h
      rw [← hof _ _ (hf0 A₁ x) (hf0 A₂ x)]
      exact ENNReal.ofReal_le_ofReal h
    calc ENNReal.ofReal d * μ s = ∫⁻ _ in s, ENNReal.ofReal d ∂μ := (setLIntegral_const s _).symm
      _ ≤ ∫⁻ x in s, (2 * ENNReal.ofReal (f A₁ x) + 2 * ENNReal.ofReal (f A₂ x)) ∂μ :=
          lintegral_mono hpt
      _ = (∫⁻ x in s, 2 * ENNReal.ofReal (f A₁ x) ∂μ) +
            ∫⁻ x in s, 2 * ENNReal.ofReal (f A₂ x) ∂μ :=
          lintegral_add_left' ((hmeas A₁).const_mul 2) _
      _ = 2 * (∫⁻ x in s, ENNReal.ofReal (f A₁ x) ∂μ) +
            2 * ∫⁻ x in s, ENNReal.ofReal (f A₂ x) ∂μ := by
          rw [lintegral_const_mul' _ _ ENNReal.ofNat_ne_top,
            lintegral_const_mul' _ _ ENNReal.ofNat_ne_top]
  · -- Step 5, (ii): `ofReal (f₁ x) ≤ 2 ofReal (f₂ x) + 2 ofReal d`; integrate over `s`
    have hpt : ∀ x,
        ENNReal.ofReal (f A₁ x) ≤ 2 * ENNReal.ofReal (f A₂ x) + 2 * ENNReal.ofReal d := by
      intro x
      have h := key (fun i => τ x (EuclideanSpace.single i (1 : ℝ)))
        (fun i => A₂ (EuclideanSpace.single i (1 : ℝ)))
        (fun i => A₁ (EuclideanSpace.single i (1 : ℝ)))
      simp only [norm_sub_rev (A₂ _) (A₁ _)] at h
      rw [← hof _ _ (hf0 A₂ x) hd0]
      exact ENNReal.ofReal_le_ofReal h
    calc (∫⁻ x in s, ENNReal.ofReal (f A₁ x) ∂μ)
        ≤ ∫⁻ x in s, (2 * ENNReal.ofReal (f A₂ x) + 2 * ENNReal.ofReal d) ∂μ :=
          lintegral_mono hpt
      _ = (∫⁻ x in s, 2 * ENNReal.ofReal (f A₂ x) ∂μ) + ∫⁻ _ in s, 2 * ENNReal.ofReal d ∂μ :=
          lintegral_add_right _ measurable_const
      _ = 2 * (∫⁻ x in s, ENNReal.ofReal (f A₂ x) ∂μ) + 2 * ENNReal.ofReal d * μ s := by
          rw [lintegral_const_mul' _ _ ENNReal.ofNat_ne_top, setLIntegral_const]
/-- **Orthogonal frame adapted to an `n`-plane** (Step 0 of the graph first-variation estimate in
the tilt-excess step of Allard's theorem, used for Simon 7.4.3).  Let `T ⊆ ℝⁿ⁺ᵏ` have dimension
`n`, let `ι : ℝⁿ → ℝⁿ⁺ᵏ`, `ι' : ℝᵏ → ℝⁿ⁺ᵏ` be linear isometries with orthogonal ranges and
`ι(ℝⁿ) ⊆ T`, and let `P : ℝⁿ⁺ᵏ → ℝⁿ` satisfy `P ∘ ι = id` and `P ∘ ι' = 0`.  Then `range ι = T`
(both have dimension `n`), so `ι'w ∈ Tᗮ`, and `range ι' = Tᗮ` (both have dimension `k`).  Every
`y` splits as `y = p_T y + (y − p_T y) = ιu + ι'w` with `Py = u`.  This gives `⟪ιu', y⟫ = ⟪u', Py⟫`,
`p_T y = ι(Py)`, Pythagoras `|y|² = |Py|² + |y − p_T y|²`, and `|Py| ≤ |y|`. -/
theorem Submission.dorag_tes_gv_adapted_frame : ∀ (n k : ℕ) (T : Submodule ℝ (Euclid (n + k))) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (P : Euclid (n + k) →L[ℝ] Euclid n), Module.finrank ℝ T = n → (∀ v w, inner ℝ (ι v) (ι' w) = 0) → (∀ v, ι v ∈ T) → (∀ v, P (ι v) = v) → (∀ w, P (ι' w) = 0) → (∀ (u : Euclid n) (y : Euclid (n + k)), inner ℝ (ι u) y = inner ℝ u (P y)) ∧ (∀ y, T.starProjection y = ι (P y)) ∧ (∀ w, ι' w ∈ Tᗮ) ∧ (∀ y, ‖y‖ ^ 2 = ‖P y‖ ^ 2 + ‖y - T.starProjection y‖ ^ 2) ∧ (∀ y, ‖P y‖ ≤ ‖y‖) := by
  intro n k T ι ι' P hT hιι' hιT hPι hPι'
  -- `range ι ⊆ T`, and both have dimension `n`, so `range ι = T`
  have hrange : LinearMap.range ι.toLinearMap = T := by
    refine Submodule.eq_of_le_of_finrank_eq ?_ ?_
    · rintro _ ⟨v, rfl⟩
      exact hιT v
    · rw [LinearMap.finrank_range_of_inj ι.injective, finrank_euclideanSpace_fin, hT]
  -- (c): `ι'w` is orthogonal to every `ιv`, hence to `T`
  have hι'T : ∀ w, ι' w ∈ Tᗮ := by
    intro w
    rw [← hrange, Submodule.mem_orthogonal]
    rintro _ ⟨v, rfl⟩
    exact hιι' v w
  -- `range ι' ⊆ Tᗮ`, and both have dimension `(n + k) − n = k`, so `range ι' = Tᗮ`
  have hrange' : LinearMap.range ι'.toLinearMap = Tᗮ := by
    refine Submodule.eq_of_le_of_finrank_eq ?_ ?_
    · rintro _ ⟨w, rfl⟩
      exact hι'T w
    · have h := Submodule.finrank_add_finrank_orthogonal T
      rw [finrank_euclideanSpace_fin, hT] at h
      rw [LinearMap.finrank_range_of_inj ι'.injective, finrank_euclideanSpace_fin]
      omega
  -- `y = p_T y + (y − p_T y) = ιu + ι'w`
  have hdecomp : ∀ y, ∃ u w, y = ι u + ι' w := by
    intro y
    obtain ⟨u, hu⟩ : T.starProjection y ∈ LinearMap.range ι.toLinearMap :=
      hrange ▸ T.starProjection_apply_mem y
    obtain ⟨w, hw⟩ : y - T.starProjection y ∈ LinearMap.range ι'.toLinearMap :=
      hrange' ▸ T.sub_starProjection_mem_orthogonal y
    rw [LinearIsometry.coe_toLinearMap] at hu hw
    exact ⟨u, w, by rw [hu, hw, add_sub_cancel]⟩
  -- `P(ιu + ι'w) = u`
  have hP : ∀ u w, P (ι u + ι' w) = u := fun u w => by rw [map_add, hPι, hPι', add_zero]
  -- (a): `⟪ιu, ιu₀ + ι'w⟫ = ⟪u, u₀⟫ = ⟪u, P(ιu₀ + ι'w)⟫`
  have hadj : ∀ (u : Euclid n) (y : Euclid (n + k)), inner ℝ (ι u) y = inner ℝ u (P y) := by
    intro u y
    obtain ⟨u₀, w, rfl⟩ := hdecomp y
    rw [hP, inner_add_right, hιι', add_zero, LinearIsometry.inner_map_map]
  -- (b): `p_T(ιu₀ + ι'w) = ιu₀ + 0 = ι(P(ιu₀ + ι'w))`
  have hpT : ∀ y, T.starProjection y = ι (P y) := by
    intro y
    obtain ⟨u₀, w, rfl⟩ := hdecomp y
    rw [hP, map_add, Submodule.starProjection_eq_self_iff.mpr (hιT u₀),
      (T.starProjection_apply_eq_zero_iff).mpr (hι'T w), add_zero]
  -- (d): Pythagoras for `y = p_T y + (y − p_T y)`, with `|p_T y| = |ι(Py)| = |Py|`
  have hpyth : ∀ y, ‖y‖ ^ 2 = ‖P y‖ ^ 2 + ‖y - T.starProjection y‖ ^ 2 := by
    intro y
    have h0 : inner ℝ (T.starProjection y) (y - T.starProjection y) = 0 := by
      rw [real_inner_comm]
      exact T.starProjection_inner_eq_zero y _ (T.starProjection_apply_mem y)
    have h1 : ‖T.starProjection y‖ = ‖P y‖ := by rw [hpT, LinearIsometry.norm_map]
    have h2 := norm_add_sq_real (T.starProjection y) (y - T.starProjection y)
    rw [add_sub_cancel, h0, h1] at h2
    linarith
  -- (e): `|Py|² ≤ |y|²` by (d)
  have hPle : ∀ y, ‖P y‖ ≤ ‖y‖ := by
    intro y
    have h : ‖P y‖ ^ 2 ≤ ‖y‖ ^ 2 := by
      rw [hpyth y]
      exact le_add_of_nonneg_right (sq_nonneg _)
    exact (pow_le_pow_iff_left₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).mp h
  exact ⟨hadj, hpT, hι'T, hpyth, hPle⟩

/-- **Graph-plane estimates at one point** (Simon Ch. 5, proof of 4.5, (7), (9), (10),
`chapter-05.txt` lines 833–872).  `Q = {ιw + ι'(Lw)}` is the graph plane of `L`, `‖L‖ ≤ 1`, over
`T = ι(ℝⁿ)`, and (Q1), (Q2) are the tilt bounds `|⟨p_Q a, b⟩ − ⟨a, b⟩| ≤ t|a||b|` on `T` and
`|p_Q e|² ≤ t|e|²` on `Tᗮ`.  Let `α` be the Riesz vector of `λ = proj_j ∘ L`.  Every
`q = ιw + ι'(Lw) ∈ Q` has `⟨q, ι'ε_j⟩ = λw = ⟨q, ια⟩`, so `p_Q(ι'ε_j) = p_Q(ια)` ((7)).  Hence
`⟨p_Q(ια), ια⟩ = |p_Q(ια)|² = |p_Q(ι'ε_j)|² ≤ t`, and (Q1) with `a = b = ια` gives
`‖λ‖² = |ια|² ≤ t + t|ια|² ≤ 2t`.  For `m` with Riesz vector `β`, `⟨ιβ, y⟩ = ⟨β, Py⟩`
(`dorag_tes_gv_adapted_frame`) gives `m(P p_Q(ι'ε_j)) = ⟨p_Q(ια), ιβ⟩`, Parseval gives
`Σᵢ λ(eᵢ)m(eᵢ) = ⟨α, β⟩ = ⟨ια, ιβ⟩`, and (Q1) bounds the difference by `t‖λ‖‖m‖ ≤ t‖m‖`. -/
theorem Submission.dorag_tes_gv_graph_plane_pointwise : ∀ (n k : ℕ) (T Q : Submodule ℝ (Euclid (n + k))) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (P : Euclid (n + k) →L[ℝ] Euclid n) (L : Euclid n →L[ℝ] Euclid k) (j : Fin k) (t : ℝ), Module.finrank ℝ T = n → (∀ v w, inner ℝ (ι v) (ι' w) = 0) → (∀ v, ι v ∈ T) → (∀ v, P (ι v) = v) → (∀ w, P (ι' w) = 0) → Q = LinearMap.range (ι.toLinearMap + ι'.toLinearMap ∘ₗ L.toLinearMap) → ‖L‖ ≤ 1 → 0 ≤ t → (∀ a b : Euclid (n + k), a ∈ T → b ∈ T → |inner ℝ (Q.starProjection a) b - inner ℝ a b| ≤ t * ‖a‖ * ‖b‖) → (∀ e : Euclid (n + k), e ∈ Tᗮ → ‖Q.starProjection e‖ ^ 2 ≤ t * ‖e‖ ^ 2) → ‖(EuclideanSpace.proj j).comp L‖ ^ 2 ≤ 2 * t ∧ ∀ m : Euclid n →L[ℝ] ℝ, |m (P (Q.starProjection (ι' (EuclideanSpace.single j (1 : ℝ))))) - ∑ i : Fin n, ((EuclideanSpace.proj j).comp L) (EuclideanSpace.single i (1 : ℝ)) * m (EuclideanSpace.single i (1 : ℝ))| ≤ t * ‖m‖ := by
  intro n k T Q ι ι' P L j t hT hιι' hιT hPι hPι' hQ hL ht hQ1 hQ2
  obtain ⟨hadj, -, hι'T, -, -⟩ :=
    Submission.dorag_tes_gv_adapted_frame n k T ι ι' P hT hιι' hιT hPι hPι'
  -- `λ = proj_j ∘ L` has `|λw| = |(Lw)_j| ≤ |Lw| ≤ |w|`, so `‖λ‖ ≤ 1`
  have hlamj : ∀ w, (EuclideanSpace.proj j).comp L w = L w j := fun w => rfl
  have hlam1 : ‖(EuclideanSpace.proj j).comp L‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun w => ?_
    calc ‖(EuclideanSpace.proj j).comp L w‖ = ‖L w j‖ := by rw [hlamj]
      _ ≤ ‖L w‖ := PiLp.norm_apply_le (L w) j
      _ ≤ ‖L‖ * ‖w‖ := L.le_opNorm w
      _ ≤ 1 * ‖w‖ := mul_le_mul_of_nonneg_right hL (norm_nonneg w)
  generalize (EuclideanSpace.proj j).comp L = lam at hlam1 hlamj ⊢
  -- Riesz vectors: `⟨γ, w⟩ = μ w` and `|ιγ| = ‖μ‖`
  have riesz : ∀ μ : Euclid n →L[ℝ] ℝ,
      ∃ γ : Euclid n, (∀ w, inner ℝ γ w = μ w) ∧ ‖ι γ‖ = ‖μ‖ := fun μ =>
    ⟨(InnerProductSpace.toDual ℝ (Euclid n)).symm μ, fun _ => InnerProductSpace.toDual_symm_apply,
      by rw [ι.norm_map, LinearIsometryEquiv.norm_map]⟩
  obtain ⟨α, hα, ha⟩ := riesz lam
  -- (7): `ι'ε_j − ια ⊥ Q`, since `⟨q, ι'ε_j⟩ = λw = ⟨q, ια⟩` for `q = ιw + ι'(Lw)`
  have hgraph : Q.starProjection (ι' (EuclideanSpace.single j (1 : ℝ))) =
      Q.starProjection (ι α) := by
    have hperp : ι' (EuclideanSpace.single j (1 : ℝ)) - ι α ∈ Qᗮ := by
      rw [Submodule.mem_orthogonal]
      intro q hq
      rw [hQ] at hq
      obtain ⟨w, rfl⟩ := LinearMap.mem_range.1 hq
      have h1 : inner ℝ (ι w) (ι' (EuclideanSpace.single j (1 : ℝ))) = 0 := hιι' _ _
      have h2 : inner ℝ (ι' (L w)) (ι' (EuclideanSpace.single j (1 : ℝ))) = lam w := by
        rw [LinearIsometry.inner_map_map, EuclideanSpace.inner_single_right, hlamj]
        simp
      have h3 : inner ℝ (ι w) (ι α) = lam w := by
        rw [LinearIsometry.inner_map_map, real_inner_comm, hα]
      have h4 : inner ℝ (ι' (L w)) (ι α) = 0 := by
        rw [real_inner_comm]
        exact hιι' _ _
      simp only [LinearMap.add_apply, LinearMap.coe_comp, Function.comp_apply,
        LinearIsometry.coe_toLinearMap, ContinuousLinearMap.coe_coe]
      rw [inner_sub_right, inner_add_left, inner_add_left, h1, h2, h3, h4]
      ring
    have h0 := (Submodule.starProjection_apply_eq_zero_iff (K := Q)).2 hperp
    rwa [map_sub, sub_eq_zero] at h0
  -- (9): `⟨p_Q(ια), ια⟩ = |p_Q(ια)|² = |p_Q(ι'ε_j)|² ≤ t` by (Q2)
  have hpa : inner ℝ (Q.starProjection (ι α)) (ι α) = ‖Q.starProjection (ι α)‖ ^ 2 := by
    have h := Submodule.starProjection_inner_eq_zero (K := Q) (ι α) _
      (Q.starProjection_apply_mem (ι α))
    rw [inner_sub_left, sub_eq_zero] at h
    rw [real_inner_comm, h, real_inner_self_eq_norm_sq]
  have hpa_le : ‖Q.starProjection (ι α)‖ ^ 2 ≤ t := by
    have h := hQ2 _ (hι'T (EuclideanSpace.single j (1 : ℝ)))
    have he : ‖ι' (EuclideanSpace.single j (1 : ℝ))‖ = 1 := by simp
    rwa [he, one_pow, mul_one, hgraph] at h
  refine ⟨?_, fun m => ?_⟩
  · -- (Q1) with `a = b = ια`: `|ια|² ≤ |p_Q(ια)|² + t|ια|² ≤ t + t`
    have h := hQ1 (ι α) (ι α) (hιT α) (hιT α)
    rw [hpa, real_inner_self_eq_norm_sq, ha] at h
    have hsq : ‖lam‖ * ‖lam‖ ≤ 1 := by nlinarith [norm_nonneg lam]
    nlinarith [(abs_le.1 h).1, mul_le_mul_of_nonneg_left hsq ht]
  · -- (10): with `β` the Riesz vector of `m`, `m(P y) = ⟨β, P y⟩ = ⟨ιβ, y⟩`
    obtain ⟨β, hβ, hb⟩ := riesz m
    have hmP : m (P (Q.starProjection (ι' (EuclideanSpace.single j (1 : ℝ))))) =
        inner ℝ (Q.starProjection (ι α)) (ι β) := by
      rw [← hβ, ← hadj, hgraph, real_inner_comm]
    -- Parseval in the basis `(eᵢ)`: `Σᵢ λ(eᵢ)m(eᵢ) = ⟨α, β⟩ = ⟨ια, ιβ⟩`
    have hsum : ∑ i : Fin n, lam (EuclideanSpace.single i (1 : ℝ)) *
        m (EuclideanSpace.single i (1 : ℝ)) = inner ℝ (ι α) (ι β) := by
      rw [LinearIsometry.inner_map_map,
        ← (EuclideanSpace.basisFun (Fin n) ℝ).sum_inner_mul_inner α β]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [EuclideanSpace.basisFun_apply, hα, real_inner_comm, hβ]
    rw [hmP, hsum]
    calc |inner ℝ (Q.starProjection (ι α)) (ι β) - inner ℝ (ι α) (ι β)|
        ≤ t * ‖ι α‖ * ‖ι β‖ := hQ1 _ _ (hιT α) (hιT β)
      _ = t * ‖lam‖ * ‖m‖ := by rw [ha, hb]
      _ ≤ t * 1 * ‖m‖ :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hlam1 ht) (norm_nonneg m)
      _ = t * ‖m‖ := by rw [mul_one]
/-- First variation of a vertical field (Simon Ch. 4, 2.2–2.3): for differentiable `ζ` and a
fixed `e`, `D(ζe)(x) = Dζ(x)(·) e`, so `p_x ∘ D(ζe)(x)` is the rank-one map `y ↦ Dζ(x)(y) p_x e`
and `div_M(ζe)(x) = Dζ(x)(p_x e)`.  As `μ_V = (Hⁿ⌞M).withDensity θ` with `θ` measurable and
finite, `δV(ζe) = ∫_M θ Dζ(x)(p_x e) dHⁿ = ∫ Dζ(x)(p_x e) dμ_V`, with no integrability needed. -/
theorem Submission.dorag_tes_gv_vertical_field_first_variation : ∀ (m n : ℕ) (U : Set (Euclid m)) (R : IMRep U n) (ζ : Euclid m → ℝ) (e : Euclid m), Differentiable ℝ ζ → R.firstVariation (fun x => ζ x • e) = ∫ x, fderiv ℝ ζ x ((approxTangentPlane n R.carrier x).starProjection e) ∂R.measure := by
  intro m n U R ζ e hζ
  -- `div_M(ζe)(x) = trace(p_x ∘ Dζ(x).smulRight e) = trace(Dζ(x).smulRight (p_x e)) = Dζ(x)(p_x e)`
  have hdiv : ∀ x, tangentialDivergence n R.carrier (fun x => ζ x • e) x =
      fderiv ℝ ζ x ((approxTangentPlane n R.carrier x).starProjection e) := by
    intro x
    unfold tangentialDivergence
    rw [fderiv_smul_const (hζ x) e]
    have hrank : (approxTangentPlane n R.carrier x).starProjection.toLinearMap ∘ₗ
        ((fderiv ℝ ζ x).smulRight e).toLinearMap =
        (fderiv ℝ ζ x).toLinearMap.smulRight
          ((approxTangentPlane n R.carrier x).starProjection e) := by
      ext y
      simp [map_smul]
    rw [hrank, LinearMap.trace_smulRight]
    rfl
  -- `μ_V = (Hⁿ⌞M).withDensity θ`, `θ` measurable and finite: `∫ g dμ_V = ∫_M θ g dHⁿ` for all `g`
  unfold IMRep.firstVariation IMRep.measure
  have hmeas : Measurable fun x => ((R.mult x : ℕ) : ℝ≥0∞) :=
    measurable_from_nat.comp R.measurable_mult
  rw [integral_withDensity_eq_integral_toReal_smul hmeas (Eventually.of_forall fun x => by simp)]
  refine integral_congr_ae (Eventually.of_forall fun x => ?_)
  simp only [hdiv x, ENNReal.toReal_natCast, smul_eq_mul]
/-- **Cutoff extension along a projection** (Steps 3.1–3.3 of the graph first-variation estimate):
if `n ≥ 1`, `ζ ∈ C¹(ℝⁿ)` has `tsupport ζ ⊆ B̆_{r/2}(0)` and `‖Dζ‖ ≤ G`, then
`ψ = (ζ ∘ φ) h₀`, `φ(x) = P(x − ξ)`, with `h₀` the `ContDiffBump` at `ξ` of radii `7r/8 < r`, is
`C¹` with compact support in `B_r(ξ)` and `|ψ| ≤ Gr/2` (`ζ` is `G`-Lipschitz and vanishes on the
sphere `|v| = r/2`).  If `|x − ξ|² ≤ |φ(x)|² + r²/16`, then `Dψ(x) = Dζ(φ(x)) ∘ P`: for
`|φ(x)| < r/2` we get `|x − ξ| < 7r/8`, so `h₀ = 1` near `x`; for `|φ(x)| ≥ r/2` both sides
vanish, `φ(x)` lying outside `tsupport ζ`. -/
theorem Submission.dorag_tes_gv_cutoff_extension : ∀ (n m : ℕ), 0 < n → ∀ (ξ : Euclid m) (r : ℝ) (P : Euclid m →L[ℝ] Euclid n) (ζ : Euclid n → ℝ) (G : ℝ), 0 < r → ContDiff ℝ 1 ζ → HasCompactSupport ζ → tsupport ζ ⊆ ball (0 : Euclid n) (r / 2) → (∀ v, ‖fderiv ℝ ζ v‖ ≤ G) → ∃ ψ : Euclid m → ℝ, ContDiff ℝ 1 ψ ∧ HasCompactSupport ψ ∧ tsupport ψ ⊆ closedBall ξ r ∧ (∀ x, |ψ x| ≤ G * (r / 2)) ∧ ∀ x, ‖x - ξ‖ ^ 2 ≤ ‖P (x - ξ)‖ ^ 2 + r ^ 2 / 16 → fderiv ℝ ψ x = (fderiv ℝ ζ (P (x - ξ))).comp P := by
  intro n m hn ξ r P ζ G hr hζ hζc hζs hζG
  have hG : 0 ≤ G := (norm_nonneg _).trans (hζG 0)
  have hζdiff : Differentiable ℝ ζ := hζ.differentiable one_ne_zero
  -- `ζ` is `G`-Lipschitz and vanishes outside `B̆_{r/2}(0)`
  have hζlip : ∀ v w, |ζ v - ζ w| ≤ G * ‖v - w‖ := by
    intro v w
    simpa [Real.norm_eq_abs] using convex_univ.norm_image_sub_le_of_norm_fderiv_le (𝕜 := ℝ)
      (fun x _ => hζdiff x) (fun x _ => hζG x) (mem_univ w) (mem_univ v)
  have hζs' : ∀ v, r / 2 ≤ ‖v‖ → v ∉ tsupport ζ := by
    intro v hv h
    have := hζs h
    rw [mem_ball, dist_zero_right] at this
    linarith
  -- `|ζ v| ≤ G r/2`: compare `v` with `w = v + (r/2 − |v|) u` on the sphere `|w| = r/2`
  have hζsup : ∀ v, |ζ v| ≤ G * (r / 2) := by
    intro v
    by_cases hv : r / 2 ≤ ‖v‖
    · rw [image_eq_zero_of_notMem_tsupport (hζs' v hv), abs_zero]
      positivity
    · replace hv := not_le.mp hv
      obtain ⟨u, hu1, hu⟩ : ∃ u : Euclid n, ‖u‖ = 1 ∧ ‖v + (r / 2 - ‖v‖) • u‖ = r / 2 := by
        by_cases hv0 : v = 0
        · refine ⟨EuclideanSpace.single ⟨0, hn⟩ (1 : ℝ), by simp, ?_⟩
          subst hv0
          simp [norm_smul, abs_of_pos hr]
        · have hvpos : 0 < ‖v‖ := norm_pos_iff.mpr hv0
          refine ⟨‖v‖⁻¹ • v, by rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hvpos.ne'], ?_⟩
          have : v + (r / 2 - ‖v‖) • (‖v‖⁻¹ • v) = ((r / 2) / ‖v‖) • v := by
            rw [smul_smul, ← one_smul ℝ v, smul_smul, ← add_smul, one_smul]
            congr 1
            field_simp
            ring
          rw [this, norm_smul, Real.norm_eq_abs, abs_of_pos (by positivity),
            div_mul_cancel₀ _ hvpos.ne']
      have hw : ζ (v + (r / 2 - ‖v‖) • u) = 0 := image_eq_zero_of_notMem_tsupport (hζs' _ hu.ge)
      calc |ζ v| = |ζ v - ζ (v + (r / 2 - ‖v‖) • u)| := by rw [hw, sub_zero]
        _ ≤ G * ‖v - (v + (r / 2 - ‖v‖) • u)‖ := hζlip _ _
        _ = G * (r / 2 - ‖v‖) := by
            rw [sub_add_cancel_left, norm_neg, norm_smul, hu1, mul_one, Real.norm_eq_abs,
              abs_of_pos (by linarith)]
        _ ≤ G * (r / 2) := by gcongr; linarith [norm_nonneg v]
  -- `ψ = (ζ ∘ φ) h₀`, `φ(y) = P(y − ξ)`
  let h0 : ContDiffBump ξ := ⟨7 * r / 8, r, by positivity, by linarith⟩
  have hφd : ∀ x, HasFDerivAt (fun y : Euclid m => P (y - ξ)) P x := by
    intro x
    have h := P.hasFDerivAt.comp x ((hasFDerivAt_id x).sub_const ξ)
    rwa [ContinuousLinearMap.comp_id] at h
  have hφc : Continuous (fun y : Euclid m => P (y - ξ)) :=
    P.continuous.comp (continuous_id.sub continuous_const)
  refine ⟨fun x => ζ (P (x - ξ)) * h0 x, ?_, ?_, ?_, ?_, ?_⟩
  · exact (hζ.comp (P.contDiff.comp (contDiff_id.sub contDiff_const))).mul h0.contDiff
  · exact HasCompactSupport.mul_left (f := fun x => ζ (P (x - ξ))) h0.hasCompactSupport
  · exact tsupport_mul_subset_right.trans h0.tsupport_eq.subset
  · intro x
    rw [abs_mul, abs_of_nonneg h0.nonneg]
    calc |ζ (P (x - ξ))| * h0 x ≤ G * (r / 2) * 1 :=
          mul_le_mul (hζsup _) h0.le_one h0.nonneg (by positivity)
      _ = G * (r / 2) := mul_one _
  · intro x hx
    by_cases hφ : ‖P (x - ξ)‖ < r / 2
    · -- `|x − ξ|² < r²/4 + r²/16 < (7r/8)²`, so `h₀ = 1` near `x` and the chain rule applies
      have hx' : ‖x - ξ‖ < 7 * r / 8 := by
        have h1 : ‖x - ξ‖ ^ 2 < (7 * r / 8) ^ 2 := by nlinarith [norm_nonneg (P (x - ξ))]
        nlinarith [norm_nonneg (x - ξ)]
      have hev : (fun y => ζ (P (y - ξ)) * h0 y) =ᶠ[𝓝 x] fun y => ζ (P (y - ξ)) := by
        filter_upwards [h0.eventuallyEq_one_of_mem_ball (show x ∈ ball ξ (7 * r / 8) by
          rwa [mem_ball, dist_eq_norm])] with y hy
        rw [hy, Pi.one_apply, mul_one]
      rw [hev.fderiv_eq]
      exact ((hζdiff _).hasFDerivAt.comp x (hφd x)).fderiv
    · -- `φ = P(· − ξ)` maps a neighbourhood of `x` outside `tsupport ζ`: both sides vanish
      have hns := hζs' _ (not_lt.mp hφ)
      have hev : (fun y => ζ (P (y - ξ)) * h0 y) =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
        filter_upwards [((isClosed_tsupport ζ).isOpen_compl.preimage hφc).mem_nhds hns] with y hy
        rw [image_eq_zero_of_notMem_tsupport hy, zero_mul]
      rw [hev.fderiv_eq, fderiv_of_notMem_tsupport ℝ hns]
      simp

/-- **First-variation bound for vertical cutoff fields** (Simon Ch. 5, proof of 4.5: the
first-variation identity (6) tested with the vertical field `X = ζ̃ e`).  Let `R` satisfy
`δV(X) = −∫ X · H dμ` for `X ∈ C¹_c` with `spt X ⊆ W ⊆ U`, where `|H| ≤ κ`, `μ = μ_V`, and
`x ↦ p_{TₓM}` is `μ`-measurable.  Let `B_r(ξ) ⊆ W`, `|Py| ≤ |y|`, and
`|x − ξ|² ≤ |P(x − ξ)|² + r²/16` on `spt μ ∩ B_r(ξ)`.  If `ζ ∈ C¹_c(ℝⁿ)`,
`spt ζ ⊆ B̆ⁿ_{r/2}(0)`, `‖Dζ‖ ≤ G` and `|e| ≤ 1`, then `u(x) = Dζ(P(x − ξ))(P(p_{TₓM} e))` is
`μ`-integrable on `B_r(ξ)` and `|∫_{B_r(ξ)} u dμ| ≤ G (κr/2) μ(B_r(ξ))`.
Proof: extend `ζ` to the cutoff `ψ` of `dorag_tes_gv_cutoff_extension`, test with `X = ψ e`,
compute `δV(X) = ∫ Dψ(p_{TₓM} e) dμ` by `dorag_tes_gv_vertical_field_first_variation`, localize
to `B_r(ξ)` (where `Dψ = Dζ(P(· − ξ)) ∘ P` on the conull set `spt μ`), and bound
`|ψ e · H| ≤ (Gr/2) κ 1_{B_r(ξ)}`. -/
theorem Submission.dorag_tes_gv_vertical_variation_bound : ∀ (n m : ℕ), 0 < n → ∀ (U W : Set (Euclid m)) (R : IMRep U n) (H : Euclid m → Euclid m) (κ : ℝ) (ξ : Euclid m) (r : ℝ) (P : Euclid m →L[ℝ] Euclid n) (ζ : Euclid n → ℝ) (G : ℝ) (e : Euclid m), W ⊆ U → (∀ x, ‖H x‖ ≤ κ) → (∀ X : Euclid m → Euclid m, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ W → R.firstVariation X = -∫ x, inner ℝ (X x) (H x) ∂R.measure) → AEStronglyMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) R.measure → 0 < r → closedBall ξ r ⊆ W → (∀ y, ‖P y‖ ≤ ‖y‖) → (∀ x ∈ R.measure.support ∩ closedBall ξ r, ‖x - ξ‖ ^ 2 ≤ ‖P (x - ξ)‖ ^ 2 + r ^ 2 / 16) → ContDiff ℝ 1 ζ → HasCompactSupport ζ → tsupport ζ ⊆ ball (0 : Euclid n) (r / 2) → (∀ v, ‖fderiv ℝ ζ v‖ ≤ G) → ‖e‖ ≤ 1 → IntegrableOn (fun x => fderiv ℝ ζ (P (x - ξ)) (P ((approxTangentPlane n R.carrier x).starProjection e))) (closedBall ξ r) R.measure ∧ ENNReal.ofReal |∫ x in closedBall ξ r, fderiv ℝ ζ (P (x - ξ)) (P ((approxTangentPlane n R.carrier x).starProjection e)) ∂R.measure| ≤ ENNReal.ofReal G * (ENNReal.ofReal (κ * r / 2) * R.measure (closedBall ξ r)) := by
  intro n m hn U W R H κ ξ r P ζ G e hWU hHκ hFV hp hr hBW hPle hspt hζ hζc hζs hζG he
  -- Step 1: `G, κ ≥ 0`.
  have hG : 0 ≤ G := (norm_nonneg _).trans (hζG 0)
  have hκ : 0 ≤ κ := (norm_nonneg _).trans (hHκ 0)
  -- Step 2: `μ(B_r(ξ)) < ∞`, since `B_r(ξ)` is a compact subset of `U`.
  have hfin : R.measure (closedBall ξ r) ≠ ∞ := by
    unfold IMRep.measure
    rw [withDensity_apply _ measurableSet_closedBall,
      Measure.restrict_restrict measurableSet_closedBall, inter_comm]
    exact R.locallyIntegrable_mult _ (isCompact_closedBall ξ r) (hBW.trans hWU)
  -- Step 3: the cutoff `ψ` extending `ζ ∘ P(· − ξ)`.
  obtain ⟨ψ, hψ, hψc, hψs, hψb, hψd⟩ :=
    Submission.dorag_tes_gv_cutoff_extension n m hn ξ r P ζ G hr hζ hζc hζs hζG
  have hψ0 : ∀ x, x ∉ closedBall ξ r → ψ x = 0 := fun x hx =>
    image_eq_zero_of_notMem_tsupport fun h => hx (hψs h)
  -- Step 4: `X = ψ e` is an admissible test field.
  have hX : ContDiff ℝ 1 (fun x => ψ x • e) := hψ.smul contDiff_const
  have hXc : HasCompactSupport (fun x => ψ x • e) := hψc.smul_right
  have hXs : tsupport (fun x => ψ x • e) ⊆ W :=
    (tsupport_smul_subset_left _ _).trans (hψs.trans hBW)
  have hfv : R.firstVariation (fun x => ψ x • e) =
      -∫ x, inner ℝ (ψ x • e) (H x) ∂R.measure := hFV _ hX hXc hXs
  -- Step 5: `δV(ψ e) = ∫ Dψ(x)(p_{TₓM} e) dμ`.
  rw [Submission.dorag_tes_gv_vertical_field_first_variation m n U R ψ e
    (hψ.differentiable one_ne_zero)] at hfv
  -- Step 6: localization to `B_r(ξ)`, where `Dψ = Dζ(P(· − ξ)) ∘ P` on `spt μ`.
  have hloc : ∫ x, fderiv ℝ ψ x ((approxTangentPlane n R.carrier x).starProjection e) ∂R.measure =
      ∫ x in closedBall ξ r, fderiv ℝ ζ (P (x - ξ))
        (P ((approxTangentPlane n R.carrier x).starProjection e)) ∂R.measure := by
    rw [← setIntegral_eq_integral_of_forall_compl_eq_zero (s := closedBall ξ r)]
    · refine setIntegral_congr_ae measurableSet_closedBall ?_
      filter_upwards [Measure.support_mem_ae (μ := R.measure)] with x hxs hxB
      rw [hψd x (hspt x ⟨hxs, hxB⟩), ContinuousLinearMap.comp_apply]
    · intro x hx
      rw [fderiv_of_notMem_tsupport ℝ (fun h => hx (hψs h)), zero_apply]
  -- Step 8: `|ψ e · H| ≤ (Gr/2) κ 1_{B_r(ξ)}`, hence the bound on `∫ ψ e · H dμ`.
  have hpt : ∀ x, ‖inner ℝ (ψ x • e) (H x)‖ ≤
      (closedBall ξ r).indicator (fun _ => G * (r / 2) * κ) x := by
    intro x
    by_cases hx : x ∈ closedBall ξ r
    · rw [indicator_of_mem hx, real_inner_smul_left, norm_mul, Real.norm_eq_abs,
        Real.norm_eq_abs]
      have heH : |inner ℝ e (H x)| ≤ κ :=
        calc |inner ℝ e (H x)| ≤ ‖e‖ * ‖H x‖ := abs_real_inner_le_norm _ _
          _ ≤ 1 * κ := mul_le_mul he (hHκ x) (norm_nonneg _) zero_le_one
          _ = κ := one_mul κ
      exact mul_le_mul (hψb x) heH (abs_nonneg _) (by positivity)
    · rw [indicator_of_notMem hx, hψ0 x hx, zero_smul, inner_zero_left, norm_zero]
  have hbd : |∫ x, inner ℝ (ψ x • e) (H x) ∂R.measure| ≤
      G * (r / 2) * κ * R.measure.real (closedBall ξ r) := by
    rw [← Real.norm_eq_abs]
    calc ‖∫ x, inner ℝ (ψ x • e) (H x) ∂R.measure‖
        ≤ ∫ x, (closedBall ξ r).indicator (fun _ => G * (r / 2) * κ) x ∂R.measure :=
          norm_integral_le_of_norm_le
            ((integrable_indicator_iff measurableSet_closedBall).2 (integrableOn_const hfin))
            (Eventually.of_forall hpt)
      _ = G * (r / 2) * κ * R.measure.real (closedBall ξ r) := by
          rw [integral_indicator_const _ measurableSet_closedBall, smul_eq_mul, mul_comm]
  -- Step 10: `u` is a.e. strongly measurable and bounded by `G`, hence integrable on `B_r(ξ)`.
  have hmeas : AEStronglyMeasurable (fun x => fderiv ℝ ζ (P (x - ξ))
      (P ((approxTangentPlane n R.carrier x).starProjection e))) R.measure := by
    have hDζ : Continuous fun x : Euclid m => fderiv ℝ ζ (P (x - ξ)) :=
      (hζ.continuous_fderiv one_ne_zero).comp
        (P.continuous.comp (continuous_id.sub continuous_const))
    exact isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable
      (hDζ.aestronglyMeasurable.prodMk
        (P.continuous.comp_aestronglyMeasurable (hp.apply_continuousLinearMap e)))
  have hint : IntegrableOn (fun x => fderiv ℝ ζ (P (x - ξ))
      (P ((approxTangentPlane n R.carrier x).starProjection e))) (closedBall ξ r) R.measure := by
    refine Measure.integrableOn_of_bounded (M := G) hfin hmeas (Eventually.of_forall fun x => ?_)
    calc ‖fderiv ℝ ζ (P (x - ξ)) (P ((approxTangentPlane n R.carrier x).starProjection e))‖
        ≤ ‖fderiv ℝ ζ (P (x - ξ))‖ *
            ‖P ((approxTangentPlane n R.carrier x).starProjection e)‖ :=
          ContinuousLinearMap.le_opNorm _ _
      _ ≤ G * 1 := mul_le_mul (hζG _)
          ((hPle _).trans ((Submodule.norm_starProjection_apply_le _ _).trans he))
          (norm_nonneg _) hG
      _ = G := mul_one G
  -- Steps 7 and 9: `∫_{B_r(ξ)} u dμ = −∫ ψ e · H dμ`, then pass to `ℝ≥0∞`.
  refine ⟨hint, ?_⟩
  rw [← hloc, hfv, abs_neg]
  calc ENNReal.ofReal |∫ x, inner ℝ (ψ x • e) (H x) ∂R.measure|
      ≤ ENNReal.ofReal (G * (κ * r / 2 * R.measure.real (closedBall ξ r))) :=
        ENNReal.ofReal_le_ofReal (hbd.trans_eq (by ring))
    _ = ENNReal.ofReal G * (ENNReal.ofReal (κ * r / 2) * R.measure (closedBall ξ r)) := by
        rw [ENNReal.ofReal_mul hG, ENNReal.ofReal_mul (by positivity), ofReal_measureReal hfin]
/-- Splitting estimate for set integrals (the splitting of `B_r(ξ)` into the graph part and its
complement in the graph first-variation estimate, for abstract integrands).  If `g` is integrable
on `A`, then `∫_A g = ∫_B u − ∫_{B∖A} u − ∫_A (u − g)`; the first term is bounded by `C`, the
second by `G μ(B ∖ F)` (as `|u| ≤ G` on `B` and `u = 0` on `(B ∖ A) ∩ F`), and the third by
`G ∫_B t` (as `|u − g| ≤ G t` on `A ⊆ B`).  Otherwise `∫_A g = 0`. -/
theorem Submission.dorag_tes_gv_split_integral_estimate : ∀ (X : Type) [MeasurableSpace X] (μ : Measure X) (A B F : Set X) (u g t : X → ℝ) (G : ℝ) (C : ℝ≥0∞), MeasurableSet A → MeasurableSet B → MeasurableSet F → A ⊆ B → 0 ≤ G → IntegrableOn u B μ → ENNReal.ofReal |∫ x in B, u x ∂μ| ≤ C → (∀ᵐ x ∂μ, x ∈ B → |u x| ≤ G) → (∀ᵐ x ∂μ, x ∈ B → x ∉ A → x ∈ F → u x = 0) → (∀ᵐ x ∂μ, x ∈ A → |u x - g x| ≤ G * t x) → ENNReal.ofReal |∫ x in A, g x ∂μ| ≤ ENNReal.ofReal G * (∫⁻ x in B, ENNReal.ofReal (t x) ∂μ + μ (B \ F)) + C := by
  intro X _ μ A B F u g t G C hA hB hF hAB hG hu hC hbd hzero hdiff
  -- if `g` is not integrable on `A`, the left side is `ofReal |0| = 0`
  by_cases hg : IntegrableOn g A μ
  swap
  · rw [integral_undef hg]
    simp
  -- `∫_A g = ∫_B u − ∫_{B∖A} u − ∫_A (u − g)`
  have huA : IntegrableOn u A μ := hu.mono_set hAB
  have hgA : ∫ x in A, g x ∂μ =
      ∫ x in B, u x ∂μ - ∫ x in B \ A, u x ∂μ - ∫ x in A, (u x - g x) ∂μ := by
    rw [integral_sub huA hg, ← integral_inter_add_sdiff hA hu, inter_eq_right.mpr hAB]
    ring
  -- off `A`: `‖u‖ₑ ≤ ofReal G · 1_{X∖F}` a.e. on `B ∖ A`
  have hoff : ENNReal.ofReal |∫ x in B \ A, u x ∂μ| ≤ ENNReal.ofReal G * μ (B \ F) := by
    calc ENNReal.ofReal |∫ x in B \ A, u x ∂μ| = ‖∫ x in B \ A, u x ∂μ‖ₑ :=
          (Real.enorm_eq_ofReal_abs _).symm
      _ ≤ ∫⁻ x in B \ A, ‖u x‖ₑ ∂μ := enorm_integral_le_lintegral_enorm _
      _ ≤ ∫⁻ x in B \ A, Fᶜ.indicator (fun _ => ENNReal.ofReal G) x ∂μ := by
          refine lintegral_mono_ae ?_
          rw [ae_restrict_iff' (hB.diff hA)]
          filter_upwards [hbd, hzero] with x hxbd hxzero hx
          by_cases hxF : x ∈ F
          · simp [hxzero hx.1 hx.2 hxF]
          · rw [indicator_of_mem (mem_compl hxF), Real.enorm_eq_ofReal_abs]
            exact ENNReal.ofReal_le_ofReal (hxbd hx.1)
      _ = ENNReal.ofReal G * μ (Fᶜ ∩ (B \ A)) := by
          rw [lintegral_indicator_const hF.compl, Measure.restrict_apply hF.compl]
      _ ≤ ENNReal.ofReal G * μ (B \ F) := by
          gcongr
          exact fun x hx => ⟨hx.2.1, hx.1⟩
  -- on `A`: `‖u − g‖ₑ ≤ ofReal G · ofReal t` a.e. on `A`, and `A ⊆ B`
  have hon : ENNReal.ofReal |∫ x in A, (u x - g x) ∂μ| ≤
      ENNReal.ofReal G * ∫⁻ x in B, ENNReal.ofReal (t x) ∂μ := by
    calc ENNReal.ofReal |∫ x in A, (u x - g x) ∂μ| = ‖∫ x in A, (u x - g x) ∂μ‖ₑ :=
          (Real.enorm_eq_ofReal_abs _).symm
      _ ≤ ∫⁻ x in A, ‖u x - g x‖ₑ ∂μ := enorm_integral_le_lintegral_enorm _
      _ ≤ ∫⁻ x in A, ENNReal.ofReal G * ENNReal.ofReal (t x) ∂μ := by
          refine lintegral_mono_ae ?_
          rw [ae_restrict_iff' hA]
          filter_upwards [hdiff] with x hx hxA
          rw [Real.enorm_eq_ofReal_abs, ← ENNReal.ofReal_mul hG]
          exact ENNReal.ofReal_le_ofReal (hx hxA)
      _ = ENNReal.ofReal G * ∫⁻ x in A, ENNReal.ofReal (t x) ∂μ :=
          lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
      _ ≤ ENNReal.ofReal G * ∫⁻ x in B, ENNReal.ofReal (t x) ∂μ := by
          gcongr
  -- triangle inequality and subadditivity of `ofReal`, then the three bounds
  calc ENNReal.ofReal |∫ x in A, g x ∂μ|
      ≤ ENNReal.ofReal (|∫ x in B, u x ∂μ| + |∫ x in B \ A, u x ∂μ| +
          |∫ x in A, (u x - g x) ∂μ|) := by
        refine ENNReal.ofReal_le_ofReal ?_
        rw [hgA]
        refine (abs_sub _ _).trans ?_
        gcongr
        exact abs_sub _ _
    _ ≤ ENNReal.ofReal |∫ x in B, u x ∂μ| + ENNReal.ofReal |∫ x in B \ A, u x ∂μ| +
          ENNReal.ofReal |∫ x in A, (u x - g x) ∂μ| := by
        refine ENNReal.ofReal_add_le.trans ?_
        gcongr
        exact ENNReal.ofReal_add_le
    _ ≤ C + ENNReal.ofReal G * μ (B \ F) +
          ENNReal.ofReal G * ∫⁻ x in B, ENNReal.ofReal (t x) ∂μ := by
        gcongr
    _ = ENNReal.ofReal G * (∫⁻ x in B, ENNReal.ofReal (t x) ∂μ + μ (B \ F)) + C := by
        ring
/-- **Hilbert–Schmidt inequalities for orthogonal projections** (Simon Ch. 5, Remark 4.4 and
(10)–(11) in the proof of 4.5; chapter-05.txt lines 715–737, 869–883).  Write
`eᵢ = EuclideanSpace.single i 1`, `|A|² = Σᵢ ‖A eᵢ‖²` and `p_Q = Q.starProjection`.  Then
(a) `‖A y‖² ≤ |A|² ‖y‖²` (operator norm `≤` inner product norm); (b)
`|p_S − p_T|² ≤ 2|p_Q − p_S|² + 2|p_Q − p_T|²`; (c) `|⟨p_Q a, b⟩ − ⟨a, b⟩| ≤ |p_Q − p_T|² ‖a‖ ‖b‖`
for `a, b ∈ T`, since `⟨p_Q a, b⟩ − ⟨a, b⟩ = −⟨(p_Q − p_T) a, (p_Q − p_T) b⟩`; (d)
`‖p_Q e‖² ≤ |p_Q − p_T|² ‖e‖²` for `e ∈ Tᗮ`, since `p_Q e = (p_Q − p_T) e`. -/
theorem Submission.dorag_tes_projection_algebra : ∀ (N : ℕ), (∀ (A : Euclid N →L[ℝ] Euclid N) (y : Euclid N), ‖A y‖ ^ 2 ≤ (∑ i : Fin N, ‖A (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) * ‖y‖ ^ 2) ∧ (∀ Q S T : Submodule ℝ (Euclid N), ∑ i : Fin N, ‖S.starProjection (EuclideanSpace.single i (1 : ℝ)) - T.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2 ≤ 2 * ∑ i : Fin N, ‖Q.starProjection (EuclideanSpace.single i (1 : ℝ)) - S.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2 + 2 * ∑ i : Fin N, ‖Q.starProjection (EuclideanSpace.single i (1 : ℝ)) - T.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∧ (∀ (Q T : Submodule ℝ (Euclid N)) (a b : Euclid N), a ∈ T → b ∈ T → |inner ℝ (Q.starProjection a) b - inner ℝ a b| ≤ (∑ i : Fin N, ‖Q.starProjection (EuclideanSpace.single i (1 : ℝ)) - T.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) * ‖a‖ * ‖b‖) ∧ ∀ (Q T : Submodule ℝ (Euclid N)) (e : Euclid N), e ∈ Tᗮ → ‖Q.starProjection e‖ ^ 2 ≤ (∑ i : Fin N, ‖Q.starProjection (EuclideanSpace.single i (1 : ℝ)) - T.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) * ‖e‖ ^ 2 := by
  intro N
  -- (a): `y = Σᵢ yᵢ eᵢ`, so `‖Ay‖ ≤ Σᵢ |yᵢ| ‖Aeᵢ‖`; then Cauchy–Schwarz and `Σᵢ yᵢ² = ‖y‖²`.
  have ha : ∀ (A : Euclid N →L[ℝ] Euclid N) (y : Euclid N), ‖A y‖ ^ 2 ≤
      (∑ i : Fin N, ‖A (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) * ‖y‖ ^ 2 := by
    intro A y
    have hAy : A y = ∑ i : Fin N, y i • A (EuclideanSpace.single i (1 : ℝ)) := by
      conv_lhs => rw [← (EuclideanSpace.basisFun (Fin N) ℝ).sum_repr y]
      simp [map_sum, map_smul]
    have h1 : ‖A y‖ ≤ ∑ i : Fin N, |y i| * ‖A (EuclideanSpace.single i (1 : ℝ))‖ := by
      rw [hAy]
      refine (norm_sum_le _ _).trans (le_of_eq ?_)
      simp [norm_smul]
    have h2 := Finset.sum_mul_sq_le_sq_mul_sq Finset.univ (fun i : Fin N => |y i|)
      (fun i => ‖A (EuclideanSpace.single i (1 : ℝ))‖)
    have h3 : ∑ i : Fin N, |y i| ^ 2 = ‖y‖ ^ 2 := by
      simp [EuclideanSpace.real_norm_sq_eq]
    calc ‖A y‖ ^ 2 ≤ (∑ i : Fin N, |y i| * ‖A (EuclideanSpace.single i (1 : ℝ))‖) ^ 2 :=
          pow_le_pow_left₀ (norm_nonneg _) h1 2
      _ ≤ (∑ i : Fin N, |y i| ^ 2) * ∑ i : Fin N, ‖A (EuclideanSpace.single i (1 : ℝ))‖ ^ 2 := h2
      _ = _ := by rw [h3, mul_comm]
  refine ⟨ha, ?_, ?_, ?_⟩
  · -- (b): termwise `‖sᵢ − tᵢ‖ ≤ ‖qᵢ − sᵢ‖ + ‖qᵢ − tᵢ‖` and `(u + w)² ≤ 2u² + 2w²`.
    intro Q S T
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_le_sum fun i _ => ?_
    have h : ‖S.starProjection (EuclideanSpace.single i (1 : ℝ)) -
        T.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ≤
        ‖Q.starProjection (EuclideanSpace.single i (1 : ℝ)) -
          S.starProjection (EuclideanSpace.single i (1 : ℝ))‖ +
        ‖Q.starProjection (EuclideanSpace.single i (1 : ℝ)) -
          T.starProjection (EuclideanSpace.single i (1 : ℝ))‖ := by
      rw [norm_sub_rev (Q.starProjection _) (S.starProjection _)]
      exact norm_sub_le_norm_sub_add_norm_sub _ _ _
    nlinarith [mul_self_le_mul_self (norm_nonneg _) h,
      sq_nonneg (‖Q.starProjection (EuclideanSpace.single i (1 : ℝ)) -
        S.starProjection (EuclideanSpace.single i (1 : ℝ))‖ -
        ‖Q.starProjection (EuclideanSpace.single i (1 : ℝ)) -
        T.starProjection (EuclideanSpace.single i (1 : ℝ))‖)]
  · -- (c): with `B = p_Q − p_T`, `⟨p_Q a, b⟩ − ⟨a, b⟩ = −⟨Ba, Bb⟩`; Cauchy–Schwarz and (a).
    intro Q T a b haT hbT
    have hBa := ha (Q.starProjection - T.starProjection) a
    have hBb := ha (Q.starProjection - T.starProjection) b
    simp only [sub_apply, Submodule.starProjection_eq_self_iff.mpr haT,
      Submodule.starProjection_eq_self_iff.mpr hbT] at hBa hBb
    have hid : inner ℝ (Q.starProjection a) b - inner ℝ a b =
        -inner ℝ (Q.starProjection a - a) (Q.starProjection b - b) := by
      have h1 : inner ℝ (Q.starProjection a) (Q.starProjection b) =
          inner ℝ (Q.starProjection a) b := by
        rw [Submodule.inner_starProjection_left_eq_right Q a,
          Submodule.starProjection_eq_self_iff.mpr (Q.starProjection_apply_mem b),
          ← Submodule.inner_starProjection_left_eq_right Q a]
      have h2 : inner ℝ a (Q.starProjection b) = inner ℝ (Q.starProjection a) b :=
        (Submodule.inner_starProjection_left_eq_right Q a b).symm
      simp only [inner_sub_left, inner_sub_right, h1, h2]
      ring
    rw [hid, abs_neg]
    refine (abs_real_inner_le_norm _ _).trans ?_
    set H := ∑ i : Fin N, ‖Q.starProjection (EuclideanSpace.single i (1 : ℝ)) -
      T.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2
    have hH : 0 ≤ H := Finset.sum_nonneg fun i _ => sq_nonneg _
    have hsq : (‖Q.starProjection a - a‖ * ‖Q.starProjection b - b‖) ^ 2 ≤
        (H * ‖a‖ * ‖b‖) ^ 2 := by
      calc (‖Q.starProjection a - a‖ * ‖Q.starProjection b - b‖) ^ 2 =
            ‖Q.starProjection a - a‖ ^ 2 * ‖Q.starProjection b - b‖ ^ 2 := by ring
        _ ≤ (H * ‖a‖ ^ 2) * (H * ‖b‖ ^ 2) :=
          mul_le_mul hBa hBb (sq_nonneg _) (mul_nonneg hH (sq_nonneg _))
        _ = (H * ‖a‖ * ‖b‖) ^ 2 := by ring
    exact (pow_le_pow_iff_left₀ (mul_nonneg (norm_nonneg _) (norm_nonneg _))
      (mul_nonneg (mul_nonneg hH (norm_nonneg _)) (norm_nonneg _)) two_ne_zero).mp hsq
  · -- (d): `p_T e = 0`, so `p_Q e = (p_Q − p_T) e`; then (a).
    intro Q T e he
    have hBe := ha (Q.starProjection - T.starProjection) e
    simp only [sub_apply,
      (Submodule.starProjection_apply_eq_zero_iff T).mpr he, sub_zero] at hBe
    exact hBe

/-- **First variation along a Lipschitz graph, tested with vertical fields** (Simon Ch. 5, proof
of 4.5, (5)–(13); chapter-05.txt lines 807–893).  Write `φ(x) = P(x − ξ)`, `Φ(v) = ξ + ιv + ι'f(v)`,
`D = B̆ⁿ_{r/2}(0)`, `fʲ = proj_j ∘ f` and `tilt(x) = Σᵢ ‖p_{TₓM} eᵢ − p_T eᵢ‖²`.  Then (i)
`∫_{Φ(D)} ‖Dfʲ(φ)‖² dμ ≤ 2 ∫_{B_r(ξ)} tilt dμ` ((9), (13)), and (ii) for `ζ ∈ C¹_c(D)` with
`‖Dζ‖ ≤ G`, `|∫_{Φ(D)} Σᵢ ∂ᵢfʲ(φ) ∂ᵢζ(φ) dμ| ≤ G (∫_{B_r(ξ)} tilt dμ + μ(B_r(ξ) \ Φ(ℝⁿ)) +
(κr/2) μ(B_r(ξ)))` ((8), (11), (12)).  On `Φ(D)` the graph identity (7) and
`dorag_tes_projection_algebra` (c), (d) give the pointwise bounds; the vertical field `ζ(φ) e`,
`e = ι' εⱼ`, is tested in the first variation (6). -/
theorem Submission.dorag_tes_graph_first_variation_estimate : ∀ (n k : ℕ), 0 < n → ∀ (U W : Set (Euclid (n + k))) (R : IMRep U n) (H : Euclid (n + k) → Euclid (n + k)) (κ : ℝ) (ξ : Euclid (n + k)) (r : ℝ) (T : Submodule ℝ (Euclid (n + k))) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (P : Euclid (n + k) →L[ℝ] Euclid n) (f : Euclid n → Euclid k), IsOpen W → W ⊆ U → AEStronglyMeasurable H R.measure → (∀ x, ‖H x‖ ≤ κ) → (∀ X : Euclid (n + k) → Euclid (n + k), ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ W → R.firstVariation X = -∫ x, inner ℝ (X x) (H x) ∂R.measure) → AEStronglyMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) R.measure → 0 < r → closedBall ξ r ⊆ W → Module.finrank ℝ T = n → (∀ v w, inner ℝ (ι v) (ι' w) = 0) → (∀ v, ι v ∈ T) → (∀ v, P (ι v) = v) → (∀ w, P (ι' w) = 0) → (∀ v w, ‖f v - f w‖ ≤ ‖v - w‖) → (∀ v, ‖f v‖ ≤ r / 4) → (∀ x ∈ R.measure.support ∩ closedBall ξ r, ‖(x - ξ) - T.starProjection (x - ξ)‖ ≤ r / 4) → (∀ᵐ x ∂R.measure, x ∈ closedBall ξ r → ∀ v : Euclid n, x = ξ + ι v + ι' (f v) → DifferentiableAt ℝ f v ∧ approxTangentPlane n R.carrier x = LinearMap.range (ι.toLinearMap + ι'.toLinearMap ∘ₗ (fderiv ℝ f v).toLinearMap)) → (∀ j : Fin k, ∫⁻ x in (fun v => ξ + ι v + ι' (f v)) '' ball (0 : Euclid n) (r / 2), ENNReal.ofReal (‖fderiv ℝ (fun v => EuclideanSpace.proj j (f v)) (P (x - ξ))‖ ^ 2) ∂R.measure ≤ 2 * ∫⁻ x in closedBall ξ r, ENNReal.ofReal (∑ i : Fin (n + k), ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) - T.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure) ∧ ∀ (j : Fin k) (ζ : Euclid n → ℝ) (G : ℝ), ContDiff ℝ 1 ζ → HasCompactSupport ζ → tsupport ζ ⊆ ball (0 : Euclid n) (r / 2) → (∀ v, ‖fderiv ℝ ζ v‖ ≤ G) → ENNReal.ofReal |∫ x in (fun v => ξ + ι v + ι' (f v)) '' ball (0 : Euclid n) (r / 2), ∑ i : Fin n, fderiv ℝ (fun v => EuclideanSpace.proj j (f v)) (P (x - ξ)) (EuclideanSpace.single i (1 : ℝ)) * fderiv ℝ ζ (P (x - ξ)) (EuclideanSpace.single i (1 : ℝ)) ∂R.measure| ≤ ENNReal.ofReal G * (∫⁻ x in closedBall ξ r, ENNReal.ofReal (∑ i : Fin (n + k), ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) - T.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure + R.measure (closedBall ξ r \ range (fun v => ξ + ι v + ι' (f v))) + ENNReal.ofReal (κ * r / 2) * R.measure (closedBall ξ r)) := by
  intro n k hn U W R H κ ξ r T ι ι' P f _ hWU _ hHκ hFV hpx hr hBW hT hιι' hιT hPι hPι' hfLip hfbd
    hheight htan
  -- Frame: `|y|² = |Py|² + |y − p_T y|²` and `|Py| ≤ |y|`.
  obtain ⟨-, -, -, hpyth, hPle⟩ :=
    Submission.dorag_tes_gv_adapted_frame n k T ι ι' P hT hιι' hιT hPι hPι'
  -- Graph geometry: `φ(Φ(v)) = v`, `|Φ(v) − ξ|² = |v|² + |f(v)|²`, `Φ(D) ⊆ B_r(ξ)`.
  have hLip : LipschitzWith 1 f := LipschitzWith.of_dist_le_mul fun v w => by
    simpa [dist_eq_norm] using hfLip v w
  have hΦsub : ∀ v, (ξ + ι v + ι' (f v)) - ξ = ι v + ι' (f v) := fun v => by abel
  have hPΦ : ∀ v, P ((ξ + ι v + ι' (f v)) - ξ) = v := fun v => by
    rw [hΦsub, map_add, hPι, hPι', add_zero]
  have hnormΦ : ∀ v, ‖(ξ + ι v + ι' (f v)) - ξ‖ ^ 2 = ‖v‖ ^ 2 + ‖f v‖ ^ 2 := fun v => by
    rw [hΦsub, norm_add_sq_real, hιι', LinearIsometry.norm_map, LinearIsometry.norm_map]; ring
  have hΦD : (fun v => ξ + ι v + ι' (f v)) '' ball (0 : Euclid n) (r / 2) ⊆ closedBall ξ r := by
    rintro _ ⟨v, hv, rfl⟩
    rw [mem_closedBall, dist_eq_norm]
    have hv' : ‖v‖ < r / 2 := by simpa using hv
    have h1 := hnormΦ v
    have h3 : ‖f v‖ ^ 2 ≤ (r / 4) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) (hfbd v) 2
    have h4 : ‖v‖ ^ 2 ≤ (r / 2) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hv'.le 2
    have h5 : ‖(ξ + ι v + ι' (f v)) - ξ‖ ^ 2 ≤ r ^ 2 := by nlinarith
    nlinarith [norm_nonneg ((ξ + ι v + ι' (f v)) - ξ)]
  -- `Φ(D) = {x | Φ(φ(x)) = x} ∩ φ⁻¹(D)` and `Φ(ℝⁿ) = {x | Φ(φ(x)) = x}` are Borel.
  have hΦcont : Continuous (fun v => ξ + ι v + ι' (f v)) :=
    (continuous_const.add ι.continuous).add (ι'.continuous.comp hLip.continuous)
  have hφcont : Continuous (fun x : Euclid (n + k) => P (x - ξ)) :=
    P.continuous.comp (continuous_id.sub continuous_const)
  have hclosed : IsClosed {x : Euclid (n + k) | ξ + ι (P (x - ξ)) + ι' (f (P (x - ξ))) = x} :=
    isClosed_eq (hΦcont.comp hφcont) continuous_id
  have hAeq : (fun v => ξ + ι v + ι' (f v)) '' ball (0 : Euclid n) (r / 2) =
      {x : Euclid (n + k) | ξ + ι (P (x - ξ)) + ι' (f (P (x - ξ))) = x} ∩
        (fun x => P (x - ξ)) ⁻¹' ball (0 : Euclid n) (r / 2) := by
    ext x
    constructor
    · rintro ⟨v, hv, rfl⟩
      refine ⟨?_, ?_⟩
      · show ξ + ι (P ((ξ + ι v + ι' (f v)) - ξ)) + ι' (f (P ((ξ + ι v + ι' (f v)) - ξ))) =
          ξ + ι v + ι' (f v)
        rw [hPΦ v]
      · show P ((ξ + ι v + ι' (f v)) - ξ) ∈ ball (0 : Euclid n) (r / 2)
        rw [hPΦ v]; exact hv
    · rintro ⟨h1, h2⟩
      exact ⟨P (x - ξ), h2, h1⟩
  have hFeq : range (fun v => ξ + ι v + ι' (f v)) =
      {x : Euclid (n + k) | ξ + ι (P (x - ξ)) + ι' (f (P (x - ξ))) = x} := by
    ext x
    constructor
    · rintro ⟨v, rfl⟩
      show ξ + ι (P ((ξ + ι v + ι' (f v)) - ξ)) + ι' (f (P ((ξ + ι v + ι' (f v)) - ξ))) =
        ξ + ι v + ι' (f v)
      rw [hPΦ v]
    · intro h
      exact ⟨P (x - ξ), h⟩
  have hAmeas : MeasurableSet ((fun v => ξ + ι v + ι' (f v)) '' ball (0 : Euclid n) (r / 2)) := by
    rw [hAeq]
    exact hclosed.measurableSet.inter (isOpen_ball.preimage hφcont).measurableSet
  have hFmeas : MeasurableSet (range (fun v => ξ + ι v + ι' (f v))) := by
    rw [hFeq]; exact hclosed.measurableSet
  -- Pointwise bounds μ-a.e. on `Φ(D)` (Simon (7), (9)–(11)): the tangent identification
  -- `TₓM = range(ι + ι' ∘ Df(v))`, `Dfʲ(v) = proj_j ∘ Df(v)`, `‖Df(v)‖ ≤ 1`, and
  -- `dorag_tes_projection_algebra` (c), (d) for `(TₓM, T)` with `t = tilt(x)`.
  have hpa := Submission.dorag_tes_projection_algebra (n + k)
  have key : ∀ j : Fin k, ∀ᵐ x ∂R.measure,
      x ∈ (fun v => ξ + ι v + ι' (f v)) '' ball (0 : Euclid n) (r / 2) →
      ‖fderiv ℝ (fun v => EuclideanSpace.proj j (f v)) (P (x - ξ))‖ ^ 2 ≤
          2 * (∑ i : Fin (n + k), ‖(approxTangentPlane n R.carrier x).starProjection
            (EuclideanSpace.single i (1 : ℝ)) -
              T.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∧
        ∀ m : Euclid n →L[ℝ] ℝ,
          |m (P ((approxTangentPlane n R.carrier x).starProjection
              (ι' (EuclideanSpace.single j (1 : ℝ))))) -
            ∑ i : Fin n, fderiv ℝ (fun v => EuclideanSpace.proj j (f v)) (P (x - ξ))
              (EuclideanSpace.single i (1 : ℝ)) * m (EuclideanSpace.single i (1 : ℝ))| ≤
            (∑ i : Fin (n + k), ‖(approxTangentPlane n R.carrier x).starProjection
              (EuclideanSpace.single i (1 : ℝ)) -
                T.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) * ‖m‖ := by
    intro j
    filter_upwards [htan] with x hx hxA
    obtain ⟨v, hv, rfl⟩ := hxA
    obtain ⟨hdiff, hQ⟩ := hx (hΦD ⟨v, hv, rfl⟩) v rfl
    have hchain : fderiv ℝ (fun v => EuclideanSpace.proj j (f v)) v =
        (EuclideanSpace.proj j).comp (fderiv ℝ f v) :=
      ((EuclideanSpace.proj j : Euclid k →L[ℝ] ℝ).hasFDerivAt.comp v hdiff.hasFDerivAt).fderiv
    have hL : ‖fderiv ℝ f v‖ ≤ 1 := by
      simpa using norm_fderiv_le_of_lipschitz ℝ (x₀ := v) hLip
    dsimp only
    rw [hPΦ v, hchain]
    exact Submission.dorag_tes_gv_graph_plane_pointwise n k T _ ι ι' P (fderiv ℝ f v) j
      (∑ i : Fin (n + k), ‖(approxTangentPlane n R.carrier (ξ + ι v + ι' (f v))).starProjection
        (EuclideanSpace.single i (1 : ℝ)) - T.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2)
      hT hιι' hιT hPι hPι' hQ hL (Finset.sum_nonneg fun i _ => sq_nonneg _)
      (fun a b ha hb => hpa.2.2.1 _ T a b ha hb) (fun e he => hpa.2.2.2 _ T e he)
  refine ⟨fun j => ?_, fun j ζ G hζ hζc hζs hζG => ?_⟩
  · -- (i): integrate `‖Dfʲ(φ)‖² ≤ 2 tilt` over `Φ(D) ⊆ B_r(ξ)` ((9), (13)).
    calc ∫⁻ x in (fun v => ξ + ι v + ι' (f v)) '' ball (0 : Euclid n) (r / 2),
