    rw [WithLp.ofLp_sum, Finset.sum_apply, WithLp.ofLp_zero, Pi.zero_apply]
    refine (Finset.sum_congr rfl fun i _ => ?_).trans (hg2 κ (x - x₀) (hmaps hx))
    rw [h1]
