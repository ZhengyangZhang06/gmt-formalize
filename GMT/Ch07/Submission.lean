        (hgT j) hgm hf hab hs1 hsc hsu hθj hWm hWc hWj
/-- Transfer of null sets to almost every slice (Simon 7.4.3, slicing step; co-area formula of
Ch. 2, 6.6 and slices of Ch. 6, 4.3): if the slice measures `ν_t` satisfy the co-area identity
`∫_ℝ ∫ φ dν_t dt = ∫ w φ dμ` for every Borel `φ ≥ 0`, then a property holding `μ`-a.e. holds
`ν_t`-a.e. for a.e. `t`.  With `Z ⊇ {¬p}` a Borel `μ`-null hull and `φ = 1_Z`, the right side
vanishes, so `ν_t(Z) = ∫ 1_Z dν_t = 0` for a.e. `t`. -/
theorem Submission.dor_lmbsf_si_coarea_ae_transfer : ∀ (P : ℕ) (μ : Measure (Euclid P)) (ν : ℝ → Measure (Euclid P)) (w : Euclid P → ℝ≥0∞) (p : Euclid P → Prop), (∀ φ : Euclid P → ℝ≥0∞, Measurable φ → AEMeasurable (fun t => ∫⁻ x, φ x ∂(ν t)) ∧ ∫⁻ t, ∫⁻ x, φ x ∂(ν t) = ∫⁻ x, w x * φ x ∂μ) → (∀ᵐ x ∂μ, p x) → ∀ᵐ t, ∀ᵐ x ∂(ν t), p x := by
  intro P μ ν w p hco hp
  -- a Borel `μ`-null hull `Z` of `{x | ¬p x}`
  set Z := toMeasurable μ {x | ¬p x} with hZ
  have hZm : MeasurableSet Z := measurableSet_toMeasurable _ _
  have hμZ : μ Z = 0 := by rw [hZ, measure_toMeasurable]; exact ae_iff.mp hp
  -- co-area identity for `φ = 1_Z`: `∫_ℝ ν_t(Z) dt = ∫ w 1_Z dμ = 0`
  obtain ⟨hae, heq⟩ := hco (Z.indicator 1) (measurable_one.indicator hZm)
  have hzero : ∫⁻ x, w x * Z.indicator 1 x ∂μ = 0 := by
    refine (lintegral_congr_ae ?_).trans lintegral_zero
    filter_upwards [measure_eq_zero_iff_ae_notMem.mp hμZ] with x hx
    simp [indicator_of_notMem hx]
  rw [hzero, lintegral_eq_zero_iff' hae] at heq
  -- for a.e. `t`, `ν_t(Z) = 0`, so `ν_t`-a.e. `x` lies outside `Z ⊇ {¬p}`
  filter_upwards [heq] with t ht
  have hνZ : ν t Z = 0 := by
    rw [← lintegral_indicator_one hZm]; exact ht
  filter_upwards [measure_eq_zero_iff_ae_notMem.mp hνZ] with x hx
  by_contra hpx
  exact hx (subset_toMeasurable μ {x | ¬p x} hpx)

/-- Orthonormal frame of `Q` adapted to a unit vector `ν ∈ Q` (Simon Ch. 6, 4.3, used for the
orientation of the slices in 7.4): if `dim Q = n + 1`, then `Q' = Q ∩ ν^⊥` has an orthonormal
basis `σ = (σ₁, …, σₙ)`, so that `(ν, σ₁, …, σₙ)` is an orthonormal basis of `Q`.  The dimension
count is `dim (ℝν) + dim (ν^⊥ ∩ Q) = dim Q`. -/
theorem Submission.dor_lmbsf_io_adapted_frame : ∀ (P n : ℕ) (Q : Submodule ℝ (Euclid P)) (ν : Euclid P), Module.finrank ℝ Q = n + 1 → ν ∈ Q → ‖ν‖ = 1 → ∃ σ : Fin n → Euclid P, Orthonormal ℝ σ ∧ Submodule.span ℝ (Set.range σ) = Q ⊓ (ℝ ∙ ν)ᗮ ∧ Orthonormal ℝ (Fin.cons ν σ : Fin (n + 1) → Euclid P) ∧ (∀ i, σ i ∈ Q) ∧ ∀ i, inner ℝ ν (σ i) = 0 := by
  intro P n Q ν hQ hνQ hν
  set Q' : Submodule ℝ (Euclid P) := Q ⊓ (ℝ ∙ ν)ᗮ
  have hν0 : ν ≠ 0 := by
    intro h; rw [h, norm_zero] at hν; exact zero_ne_one hν
  have hle : (ℝ ∙ ν) ≤ Q := (Submodule.span_singleton_le_iff_mem ν Q).2 hνQ
  -- `dim Q' = n`
  have hdim : Module.finrank ℝ Q' = n := by
    have h1 := Submodule.finrank_add_inf_finrank_orthogonal hle
    rw [finrank_span_singleton hν0, hQ] at h1
    have : Q' = (ℝ ∙ ν)ᗮ ⊓ Q := inf_comm _ _
    rw [this]; omega
  -- `σ` is an orthonormal basis `b` of `Q'`, viewed in `ℝᴾ`
  let b : OrthonormalBasis (Fin n) ℝ Q' := (stdOrthonormalBasis ℝ Q').reindex (finCongr hdim)
  let σ : Fin n → Euclid P := fun i => (b i : Euclid P)
  have hσ : Orthonormal ℝ σ := b.orthonormal.comp_linearIsometry Q'.subtypeₗᵢ
  have hσmem : ∀ i, σ i ∈ Q' := fun i => (b i).2
  have hσspan : Submodule.span ℝ (Set.range σ) = Q' := by
    have hrange : Set.range σ = Q'.subtype '' Set.range b := by
      ext x; simp [σ]
    have htop : Submodule.span ℝ (Set.range b) = ⊤ := by simpa using b.toBasis.span_eq
    rw [hrange, Submodule.span_image, htop, Submodule.map_top, Submodule.range_subtype]
  have hσQ : ∀ i, σ i ∈ Q := fun i => (hσmem i).1
  have hνσ : ∀ i, inner ℝ ν (σ i) = 0 := fun i =>
    (Submodule.mem_orthogonal_singleton_iff_inner_right).1 (hσmem i).2
  refine ⟨σ, hσ, hσspan, ?_, hσQ, hνσ⟩
  -- `Fin.cons ν σ` is orthonormal: split both indices into `0` and successors
  rw [orthonormal_iff_ite] at hσ ⊢
  intro i j
  refine Fin.cases ?_ (fun i' => ?_) i <;> refine Fin.cases ?_ (fun j' => ?_) j
  · simp [hν]
  · simp [hνσ j', (Fin.succ_ne_zero j').symm]
  · simp [real_inner_comm, hνσ i', Fin.succ_ne_zero i']
  · simp [hσ i' j']
/-- Step 3(i) of the Jacobian identity for the orientation of a `C¹` graph (Simon 7.4.3, via
Allard's theorem; `n`-covectors as in Ch. 6, §1): if `τ` is an orthonormal `n`-frame and every
`bⱼ` lies in `L = span τ`, then `α(b₁, …, bₙ) = det(⟨τᵢ, bⱼ⟩) α(τ₁, …, τₙ)` for every
`n`-covector `α`.  The restriction of `α` to `L` is `α(τ) det_τ`, and the coordinates of `bⱼ` in
the basis `τ` of `L` are `⟨τᵢ, bⱼ⟩`. -/
theorem Submission.dgoj_covector_eq_det_mul_of_mem_span : ∀ (P n : ℕ) (τ b : Fin n → Euclid P), Orthonormal ℝ τ → (∀ j, b j ∈ Submodule.span ℝ (Set.range τ)) → ∀ α : Covector (Euclid P) n, α b = (Matrix.of fun i j => inner ℝ (τ i) (b j)).det * α τ := by
  intro P n τ b hτ hb α
  set L := Submodule.span ℝ (Set.range τ)
  -- `τ` is a basis `e` of `L`
  let e : Module.Basis (Fin n) ℝ L := Module.Basis.span hτ.linearIndependent
  have he : ∀ i, (e i : Euclid P) = τ i := fun i => by
    rw [Module.Basis.span_apply hτ.linearIndependent i]
  -- the restriction `α_L` of `α` to `L`
  let αL : L [⋀^Fin n]→ₗ[ℝ] ℝ := α.toAlternatingMap.compLinearMap L.subtype
  let b' : Fin n → L := fun j => ⟨b j, hb j⟩
  have h1 : α b = αL b' := rfl
  have h2 : α τ = αL e := by
    show α τ = α (fun i => (e i : Euclid P))
    congr 1
    funext i
    exact (he i).symm
  -- coordinates of `b'` in `e` are the inner products with `τ`
  have hrepr : ∀ i j, e.repr (b' j) i = inner ℝ (τ i) (b j) := by
    intro i j
    have hs : (b j : Euclid P) = ∑ l, e.repr (b' j) l • τ l := by
      have := congrArg (Subtype.val) (e.sum_repr (b' j))
      simp only [Submodule.coe_sum, Submodule.coe_smul, he] at this
      exact this.symm
    rw [hs, hτ.inner_right_fintype]
  have hmat : e.toMatrix b' = Matrix.of fun i j => inner ℝ (τ i) (b j) := by
    ext i j
    rw [Module.Basis.toMatrix_apply, hrepr, Matrix.of_apply]
  -- `α_L = α_L(e) • det_e`
  have h3 : αL b' = αL e * e.det b' := by
    conv_lhs => rw [AlternatingMap.eq_smul_basis_det e αL]
    rfl
  rw [h1, h2, h3, Module.Basis.det_apply, hmat, mul_comm]

/-- Sign lemma for unit orientations (Simon 6.1.1; used for the slice orientation
`ξ ⌞ ∇^M f/|∇^M f|` of 6.4.3 in the slicing step of the proof of 7.4.3): if
`ζ = ±τ₁ ∧ ⋯ ∧ τₘ` is a unit orientation of `Q` and `ρ` is an orthonormal `m`-frame in `Q`, then
`ζ = ρ₁ ∧ ⋯ ∧ ρₘ` or `ζ = -ρ₁ ∧ ⋯ ∧ ρₘ`.  The change of frame `M = (⟨τᵢ, ρⱼ⟩)` satisfies
`Mᵀ M = I`, so `det M = ±1`, and `β(ρ) = det M · β(τ)` for every `m`-covector `β`. -/
theorem Submission.dor_lmbsf_io_orientation_frame_sign : ∀ (P m : ℕ) (ζ : MultiVector P m) (Q : Submodule ℝ (Euclid P)) (ρ : Fin m → Euclid P), IsUnitOrientationOf ζ Q → Orthonormal ℝ ρ → (∀ j, ρ j ∈ Q) → (∀ β : Covector (Euclid P) m, ζ β = β ρ) ∨ ∀ β : Covector (Euclid P) m, ζ β = -β ρ := by
  intro P m ζ Q ρ hζ hρ hρQ
  obtain ⟨τ, hτ, hspan, hsign⟩ := hζ
  set M : Matrix (Fin m) (Fin m) ℝ := Matrix.of fun i j => inner ℝ (τ i) (ρ j) with hM
  have hρspan : ∀ j, ρ j ∈ Submodule.span ℝ (Set.range τ) := fun j => hspan ▸ hρQ j
  -- `β(ρ) = det M · β(τ)`
  have hdet : ∀ β : Covector (Euclid P) m, β ρ = M.det * β τ :=
    Submission.dgoj_covector_eq_det_mul_of_mem_span P m τ ρ hτ hρspan
  -- Parseval in `span τ`: `⟨x, y⟩ = ∑ᵢ ⟨τᵢ, x⟩ ⟨τᵢ, y⟩`
  have hparseval : ∀ x y : Euclid P, y ∈ Submodule.span ℝ (Set.range τ) →
      inner ℝ x y = ∑ i, inner ℝ (τ i) x * inner ℝ (τ i) y := by
    intro x y hy
    obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).1 hy
    simp only [hτ.inner_right_fintype, inner_sum, inner_smul_right]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [real_inner_comm, mul_comm]
  -- `M` is orthogonal, so `det M = ±1`
  have hMM : M.transpose * M = 1 := by
    ext j k
    rw [Matrix.mul_apply, Matrix.one_apply]
    simp only [Matrix.transpose_apply, hM, Matrix.of_apply]
    rw [← hparseval (ρ j) (ρ k) (hρspan k)]
    exact orthonormal_iff_ite.1 hρ j k
  have hdet2 : M.det * M.det = 1 := by
    have := congrArg Matrix.det hMM
    rwa [Matrix.det_mul, Matrix.det_transpose, Matrix.det_one] at this
  have hpm : M.det = 1 ∨ M.det = -1 := by
    have h0 : (M.det - 1) * (M.det + 1) = 0 := by linear_combination hdet2
    rcases mul_eq_zero.1 h0 with h | h
    · left; linarith
    · right; linarith
  rcases hsign with h | h <;> rcases hpm with hd | hd
  · left; intro β; rw [h, hdet, hd, one_mul]
  · right; intro β; rw [h, hdet, hd]; ring
  · right; intro β; rw [h, hdet, hd, one_mul]
  · left; intro β; rw [h, hdet, hd]; ring
/-- Step 3 of the orientation of a slice (Simon 6.4.3, `⟨v⌞w, a⟩ = ⟨v, w ∧ a⟩`): if `ν` is a
unit vector orthogonal to `σ₀, …, σₙ₋₁`, then `(ν♭ ∧ α)(ν, σ₀, …, σₙ₋₁) = α(σ₀, …, σₙ₋₁)` for
every `n`-covector `α`, where `ν♭ ∧ α` is the alternatization of `w ↦ ⟨ν, w⟩ α`,
`(ν♭ ∧ α)(v) = ∑ᵢ (-1)ⁱ ⟨ν, vᵢ⟩ α(v₀, …, v̂ᵢ, …, vₙ)`.  The term `i = 0` is
`⟨ν, ν⟩ α(σ) = α(σ)`; every other term has a factor `⟨ν, σⱼ⟩ = 0`. -/
theorem Submission.dor_lmbsf_io_wedge_eval_cons : ∀ (P n : ℕ) (ν : Euclid P) (σ : Fin n → Euclid P) (α : Covector (Euclid P) n), ‖ν‖ = 1 → (∀ i, inner ℝ ν (σ i) = 0) → ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ ν).smulRight α) (Fin.cons ν σ : Fin (n + 1) → Euclid P) = α σ := by
  intro P n ν σ α hν hνσ
  -- expand at `v = (ν, σ₀, …, σₙ₋₁)` and split off the term `i = 0`
  rw [ContinuousAlternatingMap.alternatizeUncurryFin_apply, Fin.sum_univ_succ]
  -- `⟨ν, ν⟩ = ‖ν‖² = 1`, `v` without `v₀` is `σ`, and `⟨ν, vⱼ₊₁⟩ = ⟨ν, σⱼ⟩ = 0`
  simp [Fin.removeNth_zero, Fin.tail_cons, innerSL_apply_apply, hνσ, hν]

/-- Orientation of a slice (Simon Ch. 6, 4.3: `⟨v⌞w, a⟩ = ⟨v, w ∧ a⟩`, and `ξ⌞ν` orients
`TₓM ∩ ν^⊥`): if the `(n+1)`-vector `ζ` orients `Q`, `ν ∈ Q` is a unit vector and
`⟨α, ζ'⟩ = ⟨ν♭ ∧ α, ζ⟩` for every `n`-covector `α`, then `ζ'` orients `Q ∩ ν^⊥`.  In an
orthonormal frame `(ν, σ)` of `Q` adapted to `ν`, `ζ` is `±` evaluation at `(ν, σ)` and
`(ν♭ ∧ α)(ν, σ) = α(σ)`, so `ζ'(α) = ±α(σ)`. -/
theorem Submission.dor_lmbsf_interior_product_orientation : ∀ (P n : ℕ) (ζ : MultiVector P (n + 1)) (ζ' : MultiVector P n) (Q : Submodule ℝ (Euclid P)) (ν : Euclid P), IsUnitOrientationOf ζ Q → ν ∈ Q → ‖ν‖ = 1 → (∀ α : Covector (Euclid P) n, ζ' α = ζ (ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ ν).smulRight α))) → IsUnitOrientationOf ζ' (Q ⊓ (ℝ ∙ ν)ᗮ) := by
  intro P n ζ ζ' Q ν hζ hνQ hν hζ'
  -- `dim Q = n + 1`, read off the orthonormal frame `τ` oriented by `ζ`
  have hdim : Module.finrank ℝ Q = n + 1 := by
    obtain ⟨τ, hτ, hτQ, -⟩ := hζ
    rw [← hτQ, finrank_span_eq_card hτ.linearIndependent, Fintype.card_fin]
  -- an orthonormal frame `(ν, σ)` of `Q`, with `σ` an orthonormal basis of `Q ∩ ν^⊥`
  obtain ⟨σ, hσ, hσspan, hνσo, hσQ, hνσ⟩ :=
    Submission.dor_lmbsf_io_adapted_frame P n Q ν hdim hνQ hν
  have hνσQ : ∀ j, (Fin.cons ν σ : Fin (n + 1) → Euclid P) j ∈ Q := by
    intro j
    refine Fin.cases ?_ (fun i => ?_) j
    · simpa using hνQ
    · simpa using hσQ i
  -- `(ν♭ ∧ α)(ν, σ) = α(σ)`
  have hwedge : ∀ α : Covector (Euclid P) n,
      ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ ν).smulRight α)
        (Fin.cons ν σ : Fin (n + 1) → Euclid P) = α σ := fun α =>
    Submission.dor_lmbsf_io_wedge_eval_cons P n ν σ α hν hνσ
  -- `ζ` is `±` evaluation at `(ν, σ)`, so `ζ'` is `±` evaluation at `σ`
  refine ⟨σ, hσ, hσspan, ?_⟩
  rcases Submission.dor_lmbsf_io_orientation_frame_sign P (n + 1) ζ Q _ hζ hνσo hνσQ with h | h
  · exact Or.inl fun α => by rw [hζ' α, h, hwedge]
  · exact Or.inr fun α => by rw [hζ' α, h, hwedge]
/-- **Normalized mollifier** (step 2 of the smooth-to-`C¹` test reduction): for `r > 0` there is
a `C^∞` function `ρ ≥ 0` on `ℝⁿ` with compact support in `B_r(0)` and `∫ ρ = 1`.  Take the
`ContDiffBump` `B` centred at `0` with `rIn = r/2`, `rOut = r`, so `support B = B_r(0)`; its
integral `I` is positive since `B ≥ 0` and `volume (B_r(0)) > 0`, and `ρ = I⁻¹ B`.  (Mathlib's
`ContDiffBump.normed` is outside the import closure, so the normalization is done by hand.) -/
theorem Submission.dgcr_stc_exists_normalized_mollifier : ∀ (n : ℕ) (r : ℝ), 0 < r → ∃ ρ : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) ρ ∧ HasCompactSupport ρ ∧ (∀ x, 0 ≤ ρ x) ∧ ∫ x, ρ x = 1 ∧ support ρ ⊆ ball (0 : Euclid n) r := by
  intro n r hr
  -- the bump `B` with `rIn = r/2`, `rOut = r`
  let B : ContDiffBump (0 : Euclid n) := ⟨r / 2, r, half_pos hr, half_lt_self hr⟩
  have hBs : HasCompactSupport B := B.hasCompactSupport
  have hBi : Integrable B := B.continuous.integrable_of_hasCompactSupport hBs
  -- `I = ∫ B > 0`: `B ≥ 0` and `support B = B_r(0)` has positive measure
  have hI : 0 < ∫ x, B x := by
    rw [integral_pos_iff_support_of_nonneg (fun x => B.nonneg' x) hBi, B.support_eq]
    exact measure_ball_pos volume 0 hr
  refine ⟨fun x => (∫ y, B y)⁻¹ * B x, contDiff_const.mul B.contDiff, hBs.mul_left,
    fun x => mul_nonneg (inv_nonneg.2 hI.le) (B.nonneg' x), ?_, ?_⟩
  · rw [integral_const_mul, inv_mul_cancel₀ hI.ne']
  · exact (support_mul_subset_right _ _).trans B.support_eq.subset
/-- **Mollification preserves the Lipschitz constant** (step 4 of the Lipschitz smoothing): if
`ψ ≥ 0` is continuous with compact support and `∫ ψ = 1`, and `g` is `K`-Lipschitz, then
`G x = ∫ ψ(y) g(x - y) dy` is `K`-Lipschitz.  Indeed `G x - G x'` is the integral of
`ψ(y) (g(x - y) - g(x' - y))`, whose absolute value is at most `ψ(y) K ‖x - x'‖`, and
`∫ ψ = 1`. -/
theorem Submission.cmcs_ls_mollify_lipschitz : ∀ (P : ℕ) (ψ g : Euclid P → ℝ) (K : NNReal), Continuous ψ → HasCompactSupport ψ → (∀ x, 0 ≤ ψ x) → ∫ x, ψ x = 1 → LipschitzWith K g → LipschitzWith K (fun x => ∫ y, ψ y * g (x - y)) := by
  intro P ψ g K hψc hψs hψ0 hψ1 hg
  -- step 1: `y ↦ ψ y * g (x - y)` is continuous with support in `support ψ`, hence integrable
  have hint : ∀ x : Euclid P, Integrable (fun y => ψ y * g (x - y)) := fun x =>
    (hψc.mul (hg.continuous.comp (continuous_const.sub continuous_id))).integrable_of_hasCompactSupport
      hψs.mul_right
  -- step 5: it suffices to show `dist (G x) (G x') ≤ K * dist x x'`
  refine LipschitzWith.of_dist_le_mul fun x x' => ?_
  -- step 2: `G x - G x'` is a single integral
  rw [Real.dist_eq, ← integral_sub (hint x) (hint x'), ← Real.norm_eq_abs]
  calc ‖∫ y, (ψ y * g (x - y) - ψ y * g (x' - y))‖
      ≤ ∫ y, ψ y * (K * dist x x') := by
        -- step 4: integrate the pointwise bound of step 3 against the integrable majorant
        refine norm_integral_le_of_norm_le
          ((hψc.integrable_of_hasCompactSupport (μ := volume) hψs).mul_const _)
          (Eventually.of_forall fun y => ?_)
        -- step 3: `|ψ y (g (x - y) - g (x' - y))| = ψ y dist (g (x - y)) (g (x' - y))`
        -- `≤ ψ y (K dist (x - y) (x' - y)) = ψ y (K dist x x')`
        rw [← mul_sub, Real.norm_eq_abs, abs_mul, abs_of_nonneg (hψ0 y), ← Real.dist_eq,
          ← dist_sub_right x x' y]
        exact mul_le_mul_of_nonneg_left (hg.dist_le_mul _ _) (hψ0 y)
    _ = K * dist x x' := by rw [integral_mul_const, hψ1, one_mul]

/-- **Smoothing of Lipschitz functions** (Simon Ch. 6, 4.8–4.9: use `f^{(σ)}` in place of a
Lipschitz `f`): a `K`-Lipschitz `g` on `ℝᴾ` and `σ > 0` give a `C^∞` function `g'` with
`‖Dg'‖ ≤ K`, `|g' − g| ≤ Kσ`, and `g'(x) = c` whenever `g ≡ c` on `B_σ(x)`.  Take the normalized
mollifier `ψ` (`support ψ ⊆ B_σ(0)`) and `g' = ψ ⋆ g`, `g'(x) = ∫ ψ(y) g(x − y) dy`: it is `C^∞`
(`ψ` is smooth with compact support, `g` is continuous) and `K`-Lipschitz, so `‖Dg'‖ ≤ K`.  The
last two claims are `dist_convolution_le` on `B_σ(x)`, with `ε = Kσ`, `z₀ = g(x)` and with
`ε = 0`, `z₀ = c`.  (`ContDiffBump.normed` and its convolution lemmas are outside the import
closure.) -/
theorem Submission.cmcs_lipschitz_smoothing : ∀ (P : ℕ) (g : Euclid P → ℝ) (K : NNReal) (σ : ℝ), LipschitzWith K g → 0 < σ → ∃ g' : Euclid P → ℝ, ContDiff ℝ (⊤ : ℕ∞) g' ∧ (∀ x, ‖fderiv ℝ g' x‖ ≤ K) ∧ (∀ x, |g' x - g x| ≤ K * σ) ∧ ∀ (x : Euclid P) (c : ℝ), (∀ y ∈ ball x σ, g y = c) → g' x = c := by
  intro P g K σ hg hσ
  obtain ⟨ψ, hψd, hψs, hψ0, hψ1, hψb⟩ := Submission.dgcr_stc_exists_normalized_mollifier P σ hσ
  -- `g' = ψ ⋆ g`
  have hconv : (fun x => ∫ y, ψ y * g (x - y)) =
      convolution ψ g (ContinuousLinearMap.lsmul ℝ ℝ) volume := by
    funext x
    simp only [convolution_def, ContinuousLinearMap.lsmul_apply, smul_eq_mul]
  refine ⟨fun x => ∫ y, ψ y * g (x - y), ?_, fun x => ?_, fun x => ?_, fun x c hc => ?_⟩
  · rw [hconv]
    exact hψs.contDiff_convolution_left _ hψd hg.continuous.locallyIntegrable
  · exact norm_fderiv_le_of_lipschitz ℝ
      (Submission.cmcs_ls_mollify_lipschitz P ψ g K hψd.continuous hψs hψ0 hψ1 hg)
  · -- `dist (g y) (g x) ≤ K ‖y − x‖ ≤ Kσ` on `B_σ(x)`
    have h := dist_convolution_le (μ := volume) (x₀ := x) (z₀ := g x)
      (mul_nonneg K.coe_nonneg hσ.le) hψb hψ0 hψ1 hg.continuous.aestronglyMeasurable
      (fun y hy => (hg.dist_le_mul y x).trans
        (mul_le_mul_of_nonneg_left (mem_ball.1 hy).le K.coe_nonneg))
    rwa [← hconv, Real.dist_eq] at h
  · -- `g ≡ c` on `B_σ(x)`, so `dist (g' x) c ≤ 0`
    have h := dist_convolution_le (μ := volume) (x₀ := x) (z₀ := c) le_rfl hψb hψ0 hψ1
      hg.continuous.aestronglyMeasurable (fun y hy => by rw [hc y hy, dist_self])
    rw [← hconv] at h
    exact dist_le_zero.1 h

/-- **Smoothing the Lipschitz cut-off** (step 1 of the Lipschitz Leibniz rule): for an
`L`-Lipschitz `f` on `ℝᴾ` and `a < b`, the cut-off `h = γ_{a,b} ∘ f`,
`h(x) = min{1, max{0, (b − f(x))/(b − a)}}`, is a uniform limit of `C^∞` functions `h_k` with
`‖Dh_k‖ ≤ c` and `|h_k| ≤ 2`.  The clamp `γ_{a,b}` is `(b − a)⁻¹`-Lipschitz, so `h` is
`K`-Lipschitz with `K = (b − a)⁻¹L`, and `|h| ≤ 1`.  `cmcs_lipschitz_smoothing` with
`σ_k = 1/((K + 1)(k + 1))` gives `C^∞` functions `h_k` with `‖Dh_k‖ ≤ K` and
`|h_k − h| ≤ Kσ_k ≤ 1/(k + 1)`; take `c = K`. -/
theorem Submission.dor_lmbsf_ll_cutoff_smooth_approx : ∀ (P : ℕ) (f : Euclid P → ℝ) (L : NNReal) (a b : ℝ), LipschitzWith L f → a < b → ∃ (hs : ℕ → Euclid P → ℝ) (c : ℝ), (∀ k, ContDiff ℝ (⊤ : ℕ∞) (hs k)) ∧ (∀ k x, ‖fderiv ℝ (hs k) x‖ ≤ c) ∧ (∀ k x, |hs k x| ≤ 2) ∧ TendstoUniformly hs (fun x => min 1 (max 0 ((b - f x) / (b - a)))) atTop := by
  intro P f L a b hf hab
  have hba : 0 < b - a := sub_pos.mpr hab
  set h : Euclid P → ℝ := fun x => min 1 (max 0 ((b - f x) / (b - a))) with hh_def
  -- step 1: the clamp `γ_{a,b}` is `(b - a)⁻¹`-Lipschitz
  have hγ : LipschitzWith (Real.toNNReal (b - a)⁻¹)
      (fun s : ℝ => min 1 (max 0 ((b - s) / (b - a)))) := by
    apply LipschitzWith.of_dist_le_mul
    intro s t
    rw [Real.coe_toNNReal _ (inv_nonneg.mpr hba.le)]
    simp only [Real.dist_eq]
    calc |min 1 (max 0 ((b - s) / (b - a))) - min 1 (max 0 ((b - t) / (b - a)))|
        ≤ |max 0 ((b - s) / (b - a)) - max 0 ((b - t) / (b - a))| :=
          abs_min_sub_min_le_max _ _ _ _ |>.trans (by simp)
      _ ≤ |(b - s) / (b - a) - (b - t) / (b - a)| := by
          rw [max_comm 0, max_comm 0]; exact abs_max_sub_max_le_abs _ _ _
      _ = (b - a)⁻¹ * |s - t| := by
          rw [div_sub_div_same, abs_div, abs_of_pos hba, abs_sub_comm]
          ring_nf
  -- step 2: `h = γ_{a,b} ∘ f` is `K`-Lipschitz, `K = (b - a)⁻¹ L`
  set K : NNReal := Real.toNNReal (b - a)⁻¹ * L with hK_def
  have hhK : LipschitzWith K h := hγ.comp hf
  -- steps 4–5: smooth `h` at the scales `σ_k = 1/((K + 1)(k + 1))`
  have hσ : ∀ k : ℕ, 0 < 1 / (((K : ℝ) + 1) * ((k : ℝ) + 1)) := fun k => by positivity
  have hex := fun k : ℕ => Submission.cmcs_lipschitz_smoothing P h K
    (1 / (((K : ℝ) + 1) * ((k : ℝ) + 1))) hhK (hσ k)
  choose hs hs_smooth hs_deriv hs_close _ using hex
  -- `K σ_k ≤ 1/(k + 1)`
  have hKσ : ∀ k : ℕ, (K : ℝ) * (1 / (((K : ℝ) + 1) * ((k : ℝ) + 1))) ≤ 1 / ((k : ℝ) + 1) := by
    intro k
    have hK0 : (0 : ℝ) ≤ K := K.2
    rw [mul_one_div, div_le_div_iff₀ (by positivity) (by positivity)]
    nlinarith
  -- step 3: `|h| ≤ 1`
  have hh01 : ∀ x, |h x| ≤ 1 := by
    intro x
    rw [abs_le]
    constructor
    · simp only [h]; exact le_trans (by norm_num) (le_min (by norm_num) (le_max_left _ _))
    · exact min_le_left _ _
  -- step 6: take `c = K`
  refine ⟨hs, K, hs_smooth, hs_deriv, ?_, ?_⟩
  · -- `|h_k| ≤ |h_k - h| + |h| ≤ 1/(k + 1) + 1 ≤ 2`
    intro k x
    have h1 := hs_close k x
    have h2 := hKσ k
    have h3 : 1 / ((k : ℝ) + 1) ≤ 1 := by
      rw [div_le_one (by positivity)]; linarith [(Nat.cast_nonneg k : (0 : ℝ) ≤ k)]
    calc |hs k x| = |(hs k x - h x) + h x| := by ring_nf
      _ ≤ |hs k x - h x| + |h x| := abs_add_le _ _
      _ ≤ 1 + 1 := add_le_add (h1.trans (h2.trans h3)) (hh01 x)
      _ = 2 := by norm_num
  · -- `|h_k - h| ≤ 1/(k + 1) ≤ 1/(N + 1) < ε` for `k ≥ N`
    rw [Metric.tendstoUniformly_iff]
    intro ε hε
    obtain ⟨N, hN⟩ := exists_nat_one_div_lt hε
    filter_upwards [eventually_ge_atTop N] with k hk x
    rw [dist_comm, Real.dist_eq]
    calc |hs k x - h x| ≤ (K : ℝ) * (1 / (((K : ℝ) + 1) * ((k : ℝ) + 1))) := hs_close k x
      _ ≤ 1 / ((k : ℝ) + 1) := hKσ k
      _ ≤ 1 / ((N : ℝ) + 1) := by
          apply one_div_le_one_div_of_le (by positivity)
          exact_mod_cast Nat.add_le_add_right hk 1
      _ < ε := hN
/-- **Simon 6.4.11** (Leibniz rule behind the cutoff identity
`T(γ∘f dω) − T(d(γ∘f ω)) = −T(γ'(f) df ∧ ω)`): if `g` and the `k`-form `η` are differentiable
at `x`, then `d(gη)(x) = g(x) dη(x) + dg(x) ∧ η(x)`, where `dg(x) ∧ η(x)` is the alternation of
`v ↦ Dg(x)(v) η(x)`.  Unfold `d = extDeriv = alternatizeUncurryFin ∘ fderiv`, apply the product
rule `fderiv_fun_smul`, and use additivity and `ℝ`-homogeneity of `alternatizeUncurryFin`. -/
theorem Submission.cmcs_cd_extDeriv_smul_leibniz : ∀ (P k : ℕ) (g : Euclid P → ℝ) (η : DifferentialForm (Euclid P) k) (x : Euclid P), DifferentiableAt ℝ g x → DifferentiableAt ℝ η x → exteriorDerivative (fun y => g y • η y) x = g x • exteriorDerivative η x + ContinuousAlternatingMap.alternatizeUncurryFin ((fderiv ℝ g x).smulRight (η x)) := by
  intro P k g η x hg hη
  -- `d θ x = alternatizeUncurryFin (fderiv ℝ θ x)` by definition
  show ContinuousAlternatingMap.alternatizeUncurryFin (fderiv ℝ (fun y => g y • η y) x) =
    g x • ContinuousAlternatingMap.alternatizeUncurryFin (fderiv ℝ η x) +
      ContinuousAlternatingMap.alternatizeUncurryFin ((fderiv ℝ g x).smulRight (η x))
  -- product rule, then linearity of the alternation
  rw [fderiv_fun_smul hg hη, ContinuousAlternatingMap.alternatizeUncurryFin_add,
    ContinuousAlternatingMap.alternatizeUncurryFin_smul]
/-- **Simon Ch. 6, 4.11** (the multiplier step behind `T(γ∘f dω)` and `T(d(γ∘f ω))`): test forms
in `U` are closed under multiplication by `C^∞` functions.  For `ω ∈ 𝒟ⁿ(U)` and `g ∈ C^∞`, the
form `gω` is `C^∞`; it vanishes wherever `ω` does, so `spt(gω) ⊆ spt ω ⊆ U`, and `spt(gω)` is
compact as a closed subset of the compact set `spt ω`.  Neither openness of `U` nor compact
support of `g` is needed. -/
theorem Submission.cmcs_cd_smul_mem_testFormOn : ∀ (P n : ℕ) (U : Set (Euclid P)) (g : Euclid P → ℝ) (ω : TestFormOn U n), ContDiff ℝ (⊤ : ℕ∞) g → (fun x => g x • (ω : DifferentialForm (Euclid P) n) x) ∈ TestFormOn U n := by
  intro P n U g ω hg
  -- `ω ∈ 𝒟ⁿ(U)`: `ω` is `C^∞`, `spt ω` is compact and `spt ω ⊆ U`
  have hω : IsTestForm (ω : DifferentialForm (Euclid P) n) ∧
      tsupport (ω : DifferentialForm (Euclid P) n) ⊆ U := ω.property
  have hsmooth : ContDiff ℝ (⊤ : ℕ∞) (ω : DifferentialForm (Euclid P) n) := hω.1.1
  have hcompact : IsCompact (tsupport (ω : DifferentialForm (Euclid P) n)) := hω.1.2
  -- `gω` vanishes wherever `ω` does, so `spt(gω) ⊆ spt ω`
  have hsub : tsupport (fun x => g x • (ω : DifferentialForm (Euclid P) n) x) ⊆
      tsupport (ω : DifferentialForm (Euclid P) n) :=
    tsupport_smul_subset_right (fun x => g x) _
  -- `spt(gω)` is a closed subset of the compact set `spt ω`
  have hcpt : IsCompact (tsupport fun x => g x • (ω : DifferentialForm (Euclid P) n) x) :=
    hcompact.of_isClosed_subset (isClosed_tsupport _) hsub
  exact ⟨⟨hg.smul hsmooth, hcpt⟩, hsub.trans hω.2⟩

/-- **Simon 6.4.11, the cut-off defect identity**, with a smooth `g` in place of `γ ∘ f` and with
`T`, `∂T` written through integral representations `T = ξ μ`, `∂T = ξ' μ'`: for `g ∈ C^∞` and
`η ∈ 𝒟^k(U)`, `T(g dη) − ∂T(gη) = −T(dg ∧ η)`, where
`dg ∧ η = alternatizeUncurryFin (Dg.smulRight η)`.  The forms `gη` and `g dη` are test forms by
`cmcs_cd_smul_mem_testFormOn`, and `d(gη) − g dη = dg ∧ η` pointwise by the Leibniz rule
`cmcs_cd_extDeriv_smul_leibniz`.  Every equality of integrals is a representation hypothesis or
`integral_congr_ae` for a pointwise identity, so no integrability is needed. -/
theorem Submission.cmcs_cd_defect_identity : ∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (g : Euclid P → ℝ) (η : TestFormOn U k), (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ θ : TestFormOn U k, T.boundary θ = ∫ x, ξ' x ((θ : DifferentialForm (Euclid P) k) x) ∂μ') → ContDiff ℝ (⊤ : ℕ∞) g → ∫ x, g x * ξ x (exteriorDerivative (η : DifferentialForm (Euclid P) k) x) ∂μ - ∫ x, g x * ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ' = -∫ x, ξ x (ContinuousAlternatingMap.alternatizeUncurryFin ((fderiv ℝ g x).smulRight ((η : DifferentialForm (Euclid P) k) x))) ∂μ := by
  intro P k U T μ μ' ξ ξ' g η hT hbT hg
  -- Step 1: the test forms `dη`, `gη`, `g dη` and `d(gη)`
  let dη : TestFormOn U (k + 1) := exteriorDerivativeTestOn U k η
  let ηg : TestFormOn U k :=
    ⟨fun x => g x • (η : DifferentialForm (Euclid P) k) x,
      Submission.cmcs_cd_smul_mem_testFormOn P k U g η hg⟩
  let ωg : TestFormOn U (k + 1) :=
    ⟨fun x => g x • (dη : DifferentialForm (Euclid P) (k + 1)) x,
      Submission.cmcs_cd_smul_mem_testFormOn P (k + 1) U g dη hg⟩
  let dηg : TestFormOn U (k + 1) := exteriorDerivativeTestOn U k ηg
  -- Step 2: the first integral is `T(g dη)`
  have h1 : ∫ x, g x * ξ x (exteriorDerivative (η : DifferentialForm (Euclid P) k) x) ∂μ =
      T ωg := by
    rw [hT ωg]
    refine integral_congr_ae (Eventually.of_forall fun x => ?_)
    change g x * ξ x (exteriorDerivative (η : DifferentialForm (Euclid P) k) x) =
      ξ x (g x • exteriorDerivative (η : DifferentialForm (Euclid P) k) x)
    rw [map_smul, smul_eq_mul]
  -- Step 3: the second integral is `∂T(gη) = T(d(gη))`
  have h2 : ∫ x, g x * ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ' = T dηg := by
    rw [show T dηg = T.boundary ηg from (GeometricCurrentOn.boundary_apply T ηg).symm, hbT ηg]
    refine integral_congr_ae (Eventually.of_forall fun x => ?_)
    change g x * ξ' x ((η : DifferentialForm (Euclid P) k) x) =
      ξ' x (g x • (η : DifferentialForm (Euclid P) k) x)
    rw [map_smul, smul_eq_mul]
  -- Step 4: pointwise, `d(gη) − g dη = dg ∧ η` by the Leibniz rule
  have h3 : ∀ x, ((dηg - ωg : TestFormOn U (k + 1)) : DifferentialForm (Euclid P) (k + 1)) x =
      ContinuousAlternatingMap.alternatizeUncurryFin
        ((fderiv ℝ g x).smulRight ((η : DifferentialForm (Euclid P) k) x)) := by
    intro x
    have hgx : DifferentiableAt ℝ g x := hg.differentiable (by simp) x
    have hηx : DifferentiableAt ℝ (η : DifferentialForm (Euclid P) k) x :=
      η.property.1.1.differentiable (by simp) x
    change exteriorDerivative (fun y => g y • (η : DifferentialForm (Euclid P) k) y) x -
      g x • exteriorDerivative (η : DifferentialForm (Euclid P) k) x = _
    rw [Submission.cmcs_cd_extDeriv_smul_leibniz P k g _ x hgx hηx]
    abel
  -- Step 5: linearity of `T`
  have h4 : T ωg - T dηg = -T (dηg - ωg) := by
    have hsub := LinearMap.map_sub (T.toCurrent : ↥(TestFormOn U (k + 1)) →ₗ[ℝ] ℝ) dηg ωg
    change T.toCurrent ωg - T.toCurrent dηg = -T.toCurrent (dηg - ωg)
    rw [hsub]
    ring
  -- Steps 6 and 7: `T(d(gη) − g dη)` as an integral
  rw [h1, h2, h4, hT]
  congr 1
  exact integral_congr_ae (Eventually.of_forall fun x => congrArg (ξ x) (h3 x))
/-- **Simon Ch. 6, 1.1 and 1.7**: a unit orientation `ξ = ±τ₁ ∧ ⋯ ∧ τₙ` of a plane (`τ`
orthonormal) is a nonzero `n`-vector of norm at most one.  `|ξ(α)| = |α(τ)| ≤ ‖α‖ ∏ᵢ ‖τᵢ‖ = ‖α‖`
gives `‖ξ‖ ≤ 1`.  The covector `δ(w) = Σ_σ sgn σ ∏ᵢ ⟨τᵢ, w_{σ(i)}⟩ = det(⟨τᵢ, wⱼ⟩)`, the
alternatization of `w ↦ ∏ᵢ ⟨τᵢ, wᵢ⟩`, has `δ(τ) = 1` by orthonormality, so `ξ(δ) = ±1 ≠ 0`. -/
theorem Submission.imsupp_unit_orientation_ne_zero_norm_le_one : ∀ (P n : ℕ) (ξ : MultiVector P n) (Q : Submodule ℝ (Euclid P)), IsUnitOrientationOf ξ Q → ξ ≠ 0 ∧ ‖ξ‖ ≤ 1 := by
  rintro P n ξ Q ⟨τ, hτ, -, hξ⟩
  -- `|ξ(α)| = |α(τ)|` for either sign
  have hnorm : ∀ α : Covector (Euclid P) n, ‖ξ α‖ = ‖α τ‖ := fun α => by
    rcases hξ with h | h
    · rw [h α]
    · rw [h α, norm_neg]
  refine ⟨fun h0 => ?_, ContinuousLinearMap.opNorm_le_bound ξ zero_le_one fun α => ?_⟩
  · -- the covector `δ(w) = Σ_σ sgn σ ∏ᵢ ⟨τᵢ, w_{σ(i)}⟩` has `δ(τ) = 1`: the term `σ = 1` is
    -- `∏ᵢ ‖τᵢ‖² = 1`, and for `σ ≠ 1` some factor `⟨τᵢ, τ_{σ(i)}⟩`, `σ(i) ≠ i`, vanishes
    obtain ⟨δ, hδ⟩ : ∃ δ : Covector (Euclid P) n, δ τ = 1 := by
      refine ⟨ContinuousMultilinearMap.alternatization
        ((ContinuousMultilinearMap.mkPiAlgebra ℝ (Fin n) ℝ).compContinuousLinearMap
          fun i => innerSL ℝ (τ i)), ?_⟩
      rw [ContinuousMultilinearMap.alternatization_apply_apply,
        Finset.sum_eq_single (1 : Equiv.Perm (Fin n))]
      · rw [Equiv.Perm.sign_one, one_smul, Equiv.Perm.coe_one, Function.comp_id,
          ContinuousMultilinearMap.compContinuousLinearMap_apply,
          ContinuousMultilinearMap.mkPiAlgebra_apply]
        refine Finset.prod_eq_one fun i _ => ?_
        rw [innerSL_apply_apply, real_inner_self_eq_norm_sq, hτ.norm_eq_one, one_pow]
      · intro σ _ hσ
        obtain ⟨i, hi⟩ : ∃ i, σ i ≠ i := by
          by_contra! h
          exact hσ (Equiv.ext h)
        rw [ContinuousMultilinearMap.compContinuousLinearMap_apply,
          ContinuousMultilinearMap.mkPiAlgebra_apply,
          Finset.prod_eq_zero (Finset.mem_univ i) ?_, smul_zero]
        rw [innerSL_apply_apply, Function.comp_apply]
        exact hτ.inner_eq_zero hi.symm
      · exact fun h => absurd (Finset.mem_univ _) h
    -- `ξ = 0` would give `0 = ‖ξ(δ)‖ = ‖δ(τ)‖ = 1`
    have h := hnorm δ
    rw [h0, hδ, zero_apply, norm_zero, norm_one] at h
    exact zero_ne_one h
  · -- `|ξ(α)| = |α(τ)| ≤ ‖α‖ ∏ᵢ ‖τᵢ‖ = ‖α‖`
    rw [hnorm, one_mul]
    calc ‖α τ‖ ≤ ‖α‖ * ∏ i, ‖τ i‖ := ContinuousAlternatingMap.le_opNorm α τ
      _ = ‖α‖ := by rw [Finset.prod_eq_one fun i _ => hτ.norm_eq_one i, mul_one]

/-- **Simon Ch. 6, 3.1 (‡)**: the integrand `θ ⟨ω, ξ⟩` of `τ(M, θ, ξ)(ω)` is `Hⁿ⌞M`-integrable.
`ω` is continuous with compact support `K = spt ω ⊆ U`, so `‖ω‖ ≤ C` and `ω = 0` off `K`, and
`‖ξ‖ ≤ 1` `Hⁿ⌞M`-a.e.; hence `|θ ⟨ω, ξ⟩| ≤ C θ 1_K`, integrable as `∫_{M ∩ K} θ dHⁿ < ∞`. -/
theorem Submission.rsd_cmr_ic_action_integrable : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (ω : TestFormOn U n), Integrable (fun x => (R.mult x : ℝ) * R.orient x ((ω : DifferentialForm (Euclid P) n) x)) (μHE[n].restrict R.carrier) := by
  intro P n U R ω
  have hω : IsTestForm (ω : DifferentialForm (Euclid P) n) ∧
      tsupport (ω : DifferentialForm (Euclid P) n) ⊆ U := ω.2
  obtain ⟨⟨hsmooth, hcpt⟩, hsupp⟩ := hω
  have hcont : Continuous (ω : DifferentialForm (Euclid P) n) := ContDiff.continuous hsmooth
  -- `‖ω‖ ≤ C`, and `K = spt ω` is closed
  obtain ⟨C, hC⟩ := hcpt.exists_bound_of_continuous hcont
  have hKm : MeasurableSet (tsupport (ω : DifferentialForm (Euclid P) n)) :=
    (isClosed_tsupport _).measurableSet
  have hθ : Measurable fun x => (R.mult x : ℝ) := measurable_from_nat.comp R.measurable_mult
  -- `1_K θ` is `Hⁿ⌞M`-integrable: `∫_{M ∩ K} θ dHⁿ < ∞`
  have hh : Integrable ((tsupport (ω : DifferentialForm (Euclid P) n)).indicator
      fun x => (R.mult x : ℝ)) (μHE[n].restrict R.carrier) := by
    rw [integrable_indicator_iff hKm, IntegrableOn, Measure.restrict_restrict hKm, inter_comm]
    refine ⟨hθ.aestronglyMeasurable, ?_⟩
    rw [hasFiniteIntegral_iff_ofReal (Eventually.of_forall fun x => Nat.cast_nonneg _)]
    simp only [ENNReal.ofReal_natCast]
    exact (R.locallyIntegrable_mult _ hcpt.isCompact hsupp).lt_top
  -- `θ ⟨ω, ξ⟩` is a.e. strongly measurable and dominated by `C θ 1_K`
  refine (hh.const_mul C).mono' (hθ.aestronglyMeasurable.mul
    (isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable
      (R.aestronglyMeasurable_orient.prodMk hcont.aestronglyMeasurable))) ?_
  filter_upwards [R.orients] with x hx
  obtain ⟨Q, -, hQ⟩ := hx
  have hξ := (Submission.imsupp_unit_orientation_ne_zero_norm_le_one P n _ Q hQ).2
  by_cases hK : x ∈ tsupport (ω : DifferentialForm (Euclid P) n)
  · rw [indicator_of_mem hK, norm_mul, Real.norm_natCast, mul_comm C]
    refine mul_le_mul_of_nonneg_left ?_ (Nat.cast_nonneg _)
    calc ‖R.orient x ((ω : DifferentialForm (Euclid P) n) x)‖
        ≤ ‖R.orient x‖ * ‖(ω : DifferentialForm (Euclid P) n) x‖ := (R.orient x).le_opNorm _
      _ ≤ 1 * C := mul_le_mul hξ (hC x) (norm_nonneg _) zero_le_one
      _ = C := one_mul C
  · simp [indicator_of_notMem hK, image_eq_zero_of_notMem_tsupport hK]

/-- **Simon Ch. 6, 3.1 (‡) under bounded multipliers**: if `h_k` are measurable, `|h_k| ≤ C`
and `h_k → h` pointwise, then `∫_M θ h_k ⟨ω, ξ⟩ dHⁿ → ∫_M θ h ⟨ω, ξ⟩ dHⁿ`.  The integrands are
`h_k G` with `G = θ ⟨ω, ξ⟩` `Hⁿ⌞M`-integrable, dominated by `C |G|` and converging pointwise to
`h G`, so dominated convergence applies. -/
theorem Submission.dor_lmbsf_ll_action_mul_tendsto : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (ω : TestFormOn U n) (hs : ℕ → Euclid P → ℝ) (h : Euclid P → ℝ) (C : ℝ), (∀ k, Measurable (hs k)) → (∀ k x, |hs k x| ≤ C) → (∀ x, Tendsto (fun k => hs k x) atTop (𝓝 (h x))) → Tendsto (fun k => ∫ x in R.carrier, (R.mult x : ℝ) * hs k x * R.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) atTop (𝓝 (∫ x in R.carrier, (R.mult x : ℝ) * h x * R.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n])) := by
  intro P n U R ω hs h C hmeas hbdd hlim
  -- `G = θ ⟨ω, ξ⟩` is `Hⁿ⌞M`-integrable
  have hG := Submission.rsd_cmr_ic_action_integrable P n U R ω
  set G : Euclid P → ℝ :=
    fun x => (R.mult x : ℝ) * R.orient x ((ω : DifferentialForm (Euclid P) n) x)
  -- the integrands are `h_k G` and `h G`
  have key : ∀ k,
      (fun x => (R.mult x : ℝ) * hs k x * R.orient x ((ω : DifferentialForm (Euclid P) n) x))
        = fun x => hs k x * G x := by
    intro k; funext x; simp only [G]; ring
  have keyh : (fun x => (R.mult x : ℝ) * h x * R.orient x ((ω : DifferentialForm (Euclid P) n) x))
      = fun x => h x * G x := by
    funext x; simp only [G]; ring
  rw [keyh]
  simp_rw [key]
  -- dominated convergence with bound `C |G|`
  refine tendsto_integral_of_dominated_convergence (fun x => C * ‖G x‖) ?_ ?_ ?_ ?_
  · intro k; exact (hmeas k).aestronglyMeasurable.mul hG.aestronglyMeasurable
  · exact hG.norm.const_mul C
  · intro k
    filter_upwards with x
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (by simpa [Real.norm_eq_abs] using hbdd k x) (norm_nonneg _)
  · filter_upwards with x
    exact (hlim x).mul_const (G x)

/-- Signed co-area integral (Simon Ch. 2, 6.6, used for the slices in 7.4): if the slice
measures `ν t` satisfy the co-area identity `∫ (∫ φ dν_t) dt = ∫ w φ dμ` for every Borel
`φ ≥ 0`, and `∫ w |q| dμ < ∞`, then `t ↦ ∫ q dν_t` is integrable and
`∫ (∫ q dν_t) dt = ∫ w q dμ`.  Apply the identity to `q⁺` and `q⁻` and subtract; where
`w = ∞`, finiteness of `∫ w |q| dμ` forces `q = 0` `μ`-a.e. -/
theorem Submission.dor_lmbsf_si_coarea_signed_integral : ∀ (P : ℕ) (μ : Measure (Euclid P)) (ν : ℝ → Measure (Euclid P)) (w : Euclid P → ℝ≥0∞) (q : Euclid P → ℝ), (∀ φ : Euclid P → ℝ≥0∞, Measurable φ → AEMeasurable (fun t => ∫⁻ x, φ x ∂(ν t)) ∧ ∫⁻ t, ∫⁻ x, φ x ∂(ν t) = ∫⁻ x, w x * φ x ∂μ) → Measurable w → Measurable q → ∫⁻ x, w x * ‖q x‖ₑ ∂μ ≠ ∞ → Integrable (fun t => ∫ x, q x ∂(ν t)) ∧ ∫ t, ∫ x, q x ∂(ν t) = ∫ x, (w x).toReal * q x ∂μ := by
  intro P μ ν w q hco hw hq hfin
  -- `q⁺ = ofReal q` and `q⁻ = ofReal (-q)` are Borel and bounded by `|q|`
  have hqp : Measurable fun x => ENNReal.ofReal (q x) := hq.ennreal_ofReal
  have hqn : Measurable fun x => ENNReal.ofReal (-q x) := hq.neg.ennreal_ofReal
  have hle_p : ∀ x, ENNReal.ofReal (q x) ≤ ‖q x‖ₑ := fun x => by
    rw [← ofReal_norm, Real.norm_eq_abs]; exact ENNReal.ofReal_le_ofReal (le_abs_self _)
  have hle_n : ∀ x, ENNReal.ofReal (-q x) ≤ ‖q x‖ₑ := fun x => by
    rw [← ofReal_norm, Real.norm_eq_abs]; exact ENNReal.ofReal_le_ofReal (neg_le_abs _)
  -- the co-area identity for `q⁺`, `q⁻` and `|q|`, all with finite total integral
  obtain ⟨haeP, heqP⟩ := hco _ hqp
  obtain ⟨haeN, heqN⟩ := hco _ hqn
  obtain ⟨haeA, heqA⟩ := hco _ hq.enorm
  have hfinP : ∫⁻ t, ∫⁻ x, ENNReal.ofReal (q x) ∂(ν t) ≠ ∞ := by
    rw [heqP]; exact ne_top_of_le_ne_top hfin (lintegral_mono fun x => mul_le_mul_right (hle_p x) _)
  have hfinN : ∫⁻ t, ∫⁻ x, ENNReal.ofReal (-q x) ∂(ν t) ≠ ∞ := by
    rw [heqN]; exact ne_top_of_le_ne_top hfin (lintegral_mono fun x => mul_le_mul_right (hle_n x) _)
  have hfinA : ∫⁻ t, ∫⁻ x, ‖q x‖ₑ ∂(ν t) ≠ ∞ := by rw [heqA]; exact hfin
  -- `q` is `ν t`-integrable for a.e. `t`, where `∫ q dν_t = ∫ q⁺ dν_t - ∫ q⁻ dν_t`
  have hint : ∀ᵐ t, Integrable q (ν t) := by
    filter_upwards [ae_lt_top' haeA hfinA] with t ht
    exact ⟨hq.aestronglyMeasurable, ht⟩
  have hrepr : (fun t => ∫ x, q x ∂(ν t)) =ᵐ[volume] fun t =>
      (∫⁻ x, ENNReal.ofReal (q x) ∂(ν t)).toReal - (∫⁻ x, ENNReal.ofReal (-q x) ∂(ν t)).toReal := by
    filter_upwards [hint] with t ht
    exact integral_eq_lintegral_pos_part_sub_lintegral_neg_part ht
  have hIP : Integrable (fun t => (∫⁻ x, ENNReal.ofReal (q x) ∂(ν t)).toReal) :=
    integrable_toReal_of_lintegral_ne_top haeP hfinP
  have hIN : Integrable (fun t => (∫⁻ x, ENNReal.ofReal (-q x) ∂(ν t)).toReal) :=
    integrable_toReal_of_lintegral_ne_top haeN hfinN
  refine ⟨(hIP.sub hIN).congr hrepr.symm, ?_⟩
  -- the left side is `(∫ w q⁺ dμ).toReal - (∫ w q⁻ dμ).toReal`
  rw [integral_congr_ae hrepr, integral_sub hIP hIN, integral_toReal haeP (ae_lt_top' haeP hfinP),
    integral_toReal haeN (ae_lt_top' haeN hfinN), heqP, heqN]
  -- `h = w q` is `μ`-integrable since `|h| ≤ w |q|`; split `∫ h dμ` into its two parts
  have hh : Integrable (fun x => (w x).toReal * q x) μ := by
    refine ⟨(hw.ennreal_toReal.mul hq).aestronglyMeasurable, ?_⟩
    refine lt_of_le_of_lt (lintegral_mono fun x => ?_) hfin.lt_top
    rw [enorm_mul]
    gcongr
    rw [Real.enorm_eq_ofReal ENNReal.toReal_nonneg]
    exact ENNReal.ofReal_toReal_le
  rw [integral_eq_lintegral_pos_part_sub_lintegral_neg_part hh]
  -- `w |q| < ∞` `μ`-a.e., and there `ofReal (w r) = w ofReal r` whenever `|r| ≤ |q|`
  -- (if `w = ∞` then `q = 0`, so `r = 0`)
  have hnull : ∀ᵐ x ∂μ, w x * ‖q x‖ₑ < ∞ := ae_lt_top (hw.mul hq.enorm) hfin
  have key : ∀ x, w x * ‖q x‖ₑ < ∞ → ∀ r : ℝ, |r| ≤ |q x| →
      ENNReal.ofReal ((w x).toReal * r) = w x * ENNReal.ofReal r := by
    intro x hx r hr
    by_cases hwx : w x = ∞
    · have hq0 : q x = 0 := by
        by_contra hq0
        rw [hwx, ENNReal.top_mul (by simpa using hq0)] at hx
        exact lt_irrefl _ hx
      have : r = 0 := by rw [hq0, abs_zero] at hr; exact abs_nonpos_iff.mp hr
      simp [this]
    · rw [ENNReal.ofReal_mul ENNReal.toReal_nonneg, ENNReal.ofReal_toReal hwx]
  have e1 : ∫⁻ x, ENNReal.ofReal ((w x).toReal * q x) ∂μ = ∫⁻ x, w x * ENNReal.ofReal (q x) ∂μ := by
    refine lintegral_congr_ae ?_
    filter_upwards [hnull] with x hx
    exact key x hx (q x) le_rfl
  have e2 : ∫⁻ x, ENNReal.ofReal (-((w x).toReal * q x)) ∂μ =
      ∫⁻ x, w x * ENNReal.ofReal (-q x) ∂μ := by
    refine lintegral_congr_ae ?_
    filter_upwards [hnull] with x hx
    rw [← mul_neg]
    exact key x hx (-q x) (by rw [abs_neg])
  rw [e1, e2]
/-- Countable compact exhaustion, swapping "for every compact `K ⊆ U`" and "for a.e. `t`" (used
for the local integrability of the slices of Simon Ch. 6, 4.1–4.3 in the slicing step of the
proof of 7.4.3): if every `F t` is monotone and, for each compact `K ⊆ U`, `F t K ≠ ∞` for a.e.
`t`, then for a.e. `t`, `F t K ≠ ∞` for all compact `K ⊆ U` at once.  The compact sets
`Kᵢ = B̄(0, i) ∖ {y : dist(y, Uᶜ) < 1/(i+1)}` lie in `U`, and every compact `K ⊆ U` lies in some
`Kᵢ` (it is bounded and at positive distance from `Uᶜ`); intersect the countably many full-measure
sets and use `F t K ≤ F t Kᵢ`. -/
theorem Submission.dor_lmbsf_si_ae_forall_compact : ∀ (P : ℕ) (U : Set (Euclid P)) (F : ℝ → Set (Euclid P) → ℝ≥0∞), IsOpen U → (∀ t, Monotone (F t)) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ∀ᵐ t, F t K ≠ ∞) → ∀ᵐ t, ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → F t K ≠ ∞ := by
  intro P U F hU hmono hK
  -- the compact sets `Kᵢ = B̄(0, i) ∖ thickening (1/(i+1)) Uᶜ ⊆ U`
  let Kn : ℕ → Set (Euclid P) := fun i => closedBall 0 i \ thickening (1 / ((i : ℝ) + 1)) Uᶜ
  have hKc : ∀ i, IsCompact (Kn i) := fun i =>
    (isCompact_closedBall 0 (i : ℝ)).diff isOpen_thickening
  have hKU : ∀ i, Kn i ⊆ U := by
    intro i x hx
    by_contra hxU
    exact hx.2 (self_subset_thickening (by positivity) _ hxU)
  -- every compact `K ⊆ U` lies in some `Kᵢ`: `K ⊆ B̄(0, R)` and `thickening δ K ⊆ U`
  have hcover : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ∃ i, K ⊆ Kn i := by
    intro K hKc' hKU'
    obtain ⟨δ, hδ, hδK⟩ := hKc'.exists_thickening_subset_open hU hKU'
    obtain ⟨R, hR⟩ := hKc'.isBounded.subset_closedBall 0
    obtain ⟨i₁, hi₁⟩ := exists_nat_ge R
    obtain ⟨i₂, hi₂⟩ := exists_nat_one_div_lt hδ
    refine ⟨max i₁ i₂, fun x hx => ⟨?_, ?_⟩⟩
    · exact closedBall_subset_closedBall (hi₁.trans (by exact_mod_cast le_max_left i₁ i₂)) (hR hx)
    · intro hxt
      rw [mem_thickening_iff] at hxt
      obtain ⟨y, hyU, hxy⟩ := hxt
      have hlt : (1 : ℝ) / ((max i₁ i₂ : ℕ) + 1) ≤ 1 / ((i₂ : ℝ) + 1) := by
        gcongr; exact_mod_cast le_max_right i₁ i₂
      have hy : y ∈ thickening δ K := by
        rw [mem_thickening_iff]
        exact ⟨x, hx, by rw [dist_comm]; linarith⟩
      exact hyU (hδK hy)
  -- for a.e. `t`, `F t Kᵢ ≠ ∞` for all `i` at once; then `F t K ≤ F t Kᵢ`
  have hall : ∀ᵐ t, ∀ i, F t (Kn i) ≠ ∞ := ae_all_iff.mpr fun i => hK _ (hKc i) (hKU i)
  filter_upwards [hall] with t ht K hKc' hKU'
  obtain ⟨i, hi⟩ := hcover K hKc' hKU'
  exact ne_top_of_le_ne_top (ht i) (hmono t hi)
/-- The orientation field of a slice (Simon Ch. 6, 4.3–4.4: `ξₜ = ξ⌞(∇ᴹf/|∇ᴹf|)`, with
`⟨v⌞w, a⟩ = ⟨v, w ∧ a⟩`; the slices of Ch. 6, 4.5 enter the upper mass bound in the proof of
7.4.3): for a strongly measurable `(n+1)`-vector field `ζ` and a Borel vector field `g`, the
`n`-vector field `ζ' = ζ⌞(g/|g|)`, `⟨α, ζ'⟩ = ⟨(g/|g|)♭ ∧ α, ζ⟩`, is strongly measurable,
`|g| ζ' = ζ⌞g`, and `|⟨g♭ ∧ α, ζ⟩| ≤ (n + 1) |ζ| |g| |α|`.  The wedge `(v, α) ↦ v♭ ∧ α` is
bounded bilinear with `|v♭ ∧ α| ≤ (n + 1) |v| |α|`, so `(ζ₀, v) ↦ ζ₀ ∘ (v♭ ∧ ·)` is continuous. -/
theorem Submission.dor_lmbsf_si_slice_orientation_field : ∀ (P n : ℕ) (ζ : Euclid P → MultiVector P (n + 1)) (g : Euclid P → Euclid P), StronglyMeasurable ζ → Measurable g → ∃ ζ' : Euclid P → MultiVector P n, StronglyMeasurable ζ' ∧ (∀ x (α : Covector (Euclid P) n), ζ' x α = ζ x (ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ (‖g x‖⁻¹ • g x)).smulRight α))) ∧ (∀ x (α : Covector (Euclid P) n), ‖g x‖ * ζ' x α = ζ x (ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ (g x)).smulRight α))) ∧ ∀ x (α : Covector (Euclid P) n), |ζ x (ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ (g x)).smulRight α))| ≤ ((n : ℝ) + 1) * ‖ζ x‖ * ‖g x‖ * ‖α‖ := by
  intro P n ζ g hζ hg
  -- the wedge `B(v, α) = v♭ ∧ α`, with `|v♭ ∧ α| ≤ (n + 1) |v| |α|`
  let B : Euclid P × Covector (Euclid P) n → Covector (Euclid P) (n + 1) := fun p =>
    ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ p.1).smulRight p.2)
  have hBnorm : ∀ v α, ‖B (v, α)‖ ≤ ((n : ℝ) + 1) * ‖v‖ * ‖α‖ := fun v α => by
    refine (ContinuousAlternatingMap.norm_alternatizeUncurryFin_le _).trans_eq ?_
    rw [ContinuousLinearMap.norm_smulRight_apply, innerSL_apply_norm, mul_assoc]
  -- `B` is bilinear: compare the arguments of `alternatizeUncurryFin` at each `y`
  have hB : IsBoundedBilinearMap ℝ B :=
    { add_left := fun v w α => by
        simp only [B, map_add, ← ContinuousAlternatingMap.alternatizeUncurryFin_add]
        congr 1
        ext y
        simp [add_smul]
      smul_left := fun c v α => by
        simp only [B, map_smul, ← ContinuousAlternatingMap.alternatizeUncurryFin_smul]
        congr 1
        ext y
        simp [smul_smul]
      add_right := fun v α β => by
        simp only [B, ← ContinuousAlternatingMap.alternatizeUncurryFin_add]
        congr 1
        ext y
        simp
      smul_right := fun c v α => by
        simp only [B, ← ContinuousAlternatingMap.alternatizeUncurryFin_smul]
        congr 1
        ext y
        simp [smul_smul, mul_comm]
      bound := ⟨(n : ℝ) + 1, by positivity, hBnorm⟩ }
  -- `A v = v♭ ∧ ·`, a continuous linear map in `v`
  let A : Euclid P →L[ℝ] Covector (Euclid P) n →L[ℝ] Covector (Euclid P) (n + 1) :=
    hB.toContinuousLinearMap
  -- `Ξ(ζ₀, v) = ζ₀ ∘ (v♭ ∧ ·)` is continuous, since composition is bounded bilinear
  let Ξ : MultiVector P (n + 1) × Euclid P → MultiVector P n := fun p => p.1.comp (A p.2)
  have hΞ : Continuous Ξ := isBoundedBilinearMap_comp.continuous.comp
    (continuous_fst.prodMk (A.continuous.comp continuous_snd))
  -- `ζ' = Ξ(ζ, g/|g|)`, where `g/|g|` is Borel
  have hν : Measurable fun x => ‖g x‖⁻¹ • g x := hg.norm.inv.smul hg
  refine ⟨fun x => Ξ (ζ x, ‖g x‖⁻¹ • g x),
    hΞ.comp_stronglyMeasurable (hζ.prodMk hν.stronglyMeasurable), fun x α => rfl, ?_, ?_⟩
  · -- `|g| ζ' = ζ⌞g`: linearity of `A` and of `ζ(x)`; trivial where `g(x) = 0`
    intro x α
    show ‖g x‖ * ζ x (A (‖g x‖⁻¹ • g x) α) = ζ x (A (g x) α)
    by_cases hgx : g x = 0
    · simp [hgx]
    · rw [map_smul, smul_apply, map_smul, smul_eq_mul, ← mul_assoc,
        mul_inv_cancel₀ (norm_ne_zero_iff.mpr hgx), one_mul]
  · -- `|⟨g♭ ∧ α, ζ⟩| ≤ |ζ| |g♭ ∧ α| ≤ (n + 1) |ζ| |g| |α|`
    intro x α
    show |ζ x (A (g x) α)| ≤ _
    rw [← Real.norm_eq_abs]
    calc ‖ζ x (A (g x) α)‖ ≤ ‖ζ x‖ * ‖A (g x) α‖ := (ζ x).le_opNorm _
      _ ≤ ‖ζ x‖ * (((n : ℝ) + 1) * ‖g x‖ * ‖α‖) := by gcongr; exact hBnorm (g x) α
      _ = ((n : ℝ) + 1) * ‖ζ x‖ * ‖g x‖ * ‖α‖ := by ring
/-- **Simon 6.3.1, Ch. 3 Remark 1.5(1)**: for `Hⁿ`-a.e. `x ∈ M`, the orientation `ξ(x)` of an
integer multiplicity triple `(M, θ, ξ)` orients the chosen approximate tangent plane `TₓM`.
`R.orients` gives, a.e. on `M`, an approximate tangent plane `Q` at `x` oriented by `ξ(x)`; the
chosen witness `approxTangentPlane n M x` is then `Q`, approximate tangent planes being unique. -/
theorem Submission.fvmb_imrep_ae_unitOrientation_approxTangentPlane : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), IsUnitOrientationOf (R.orient x) (approxTangentPlane n R.carrier x) := by
  intro P n U R
  filter_upwards [R.orients] with x hx
  obtain ⟨Q, hQ, hξ⟩ := hx
  -- the chosen witness of `∃ Q', HasApproximateTangentSpaceAt n M x Q'` is `Q`
  have h : ∃ Q', HasApproximateTangentSpaceAt n R.carrier x Q' := ⟨Q, hQ⟩
  have hT : approxTangentPlane n R.carrier x = Q := by
    rw [approxTangentPlane, dite_eq_left h]
    exact h.choose_spec.unique hQ
  rw [hT]
  exact hξ
/-- A unit orientation has norm at most `1` (step 1(c) of the proof of Simon Ch. 6, 3.2(3)).
If `ξ α = ±α(τ₁, …, τₙ)` for an orthonormal family `τ`, then `|ξ α| = |α(τ)| ≤ ‖α‖ ∏ᵢ ‖τᵢ‖ = ‖α‖`
for every `n`-covector `α`, so the operator norm of `ξ` is at most `1`. -/
theorem Submission.unit_orientation_norm_le_one : ∀ (P n : ℕ) (Q : Submodule ℝ (Euclid P)) (ξ : MultiVector P n), IsUnitOrientationOf ξ Q → ‖ξ‖ ≤ 1 := by
  rintro P n Q ξ ⟨τ, hτ, -, hξ⟩
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun α => ?_
  -- `|α(τ)| ≤ ‖α‖ ∏ᵢ ‖τᵢ‖ = ‖α‖`, as `‖τᵢ‖ = 1`
  have hbound : ‖α τ‖ ≤ ‖α‖ := by
    simpa [hτ.1] using α.le_opNorm τ
  rcases hξ with h | h
  · rw [h, one_mul]
    exact hbound
  · rw [h, norm_neg, one_mul]
    exact hbound
/-- The vector representing `β ↦ ζ(β ∧ α)` (steps 4(a), 4(b) of the parent proof; Simon Ch. 6,
proof of Lemma 4.5(2), display (3)).  Write `β ∧ α` for `alternatizeUncurryFin (β.smulRight α)`,
`eₗ` for the standard basis of `ℝᴾ` and `V = Σₗ ζ(⟨eₗ, ·⟩ ∧ α) eₗ`.  Then `ζ(β ∧ α) = β(V)` for
every `1`-covector `β`, as `β ↦ ζ(β ∧ α)` is linear and `β = Σₗ β(eₗ) ⟨eₗ, ·⟩`.  If `ζ` orients
`Q` and `v ∈ Qᗮ`, then `(⟨v, ·⟩ ∧ α)(τ) = Σᵢ (-1)ⁱ ⟨v, τᵢ⟩ α(…) = 0` for the basis `τ` of `Q`, so
`⟨v, V⟩ = ζ(⟨v, ·⟩ ∧ α) = 0` and `V ∈ Qᗮᗮ = Q`. -/
theorem Submission.dor_lmbsf_ll_wedge_representing_vector : ∀ (P n : ℕ) (ζ : MultiVector P (n + 1)) (α : Covector (Euclid P) n), (∀ β : Euclid P →L[ℝ] ℝ, ζ (ContinuousAlternatingMap.alternatizeUncurryFin (β.smulRight α)) = β (∑ l : Fin P, ζ (ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ (EuclideanSpace.single l (1 : ℝ))).smulRight α)) • EuclideanSpace.single l (1 : ℝ))) ∧ ∀ Q : Submodule ℝ (Euclid P), IsUnitOrientationOf ζ Q → (∑ l : Fin P, ζ (ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ (EuclideanSpace.single l (1 : ℝ))).smulRight α)) • EuclideanSpace.single l (1 : ℝ)) ∈ Q := by
  intro P n ζ α
  -- `Φ(β) = ζ(β ∧ α)` is linear in `β`
  let Φ : (Euclid P →L[ℝ] ℝ) → ℝ := fun β =>
    ζ (ContinuousAlternatingMap.alternatizeUncurryFin (β.smulRight α))
  have hΦadd : ∀ β₁ β₂ : Euclid P →L[ℝ] ℝ, Φ (β₁ + β₂) = Φ β₁ + Φ β₂ := by
    intro β₁ β₂
    have : (β₁ + β₂).smulRight α = β₁.smulRight α + β₂.smulRight α := by
      ext v; simp [add_smul]
    simp only [Φ, this, ContinuousAlternatingMap.alternatizeUncurryFin_add, map_add]
  have hΦsmul : ∀ (c : ℝ) (β : Euclid P →L[ℝ] ℝ), Φ (c • β) = c • Φ β := by
    intro c β
    have : (c • β).smulRight α = c • β.smulRight α := by
      ext v; simp [mul_smul]
    simp only [Φ, this, ContinuousAlternatingMap.alternatizeUncurryFin_smul, map_smul]
  let Φl : (Euclid P →L[ℝ] ℝ) →ₗ[ℝ] ℝ :=
    { toFun := Φ, map_add' := hΦadd, map_smul' := hΦsmul }
  -- `β = Σₗ β(eₗ) ⟨eₗ, ·⟩`
  have hβexp : ∀ β : Euclid P →L[ℝ] ℝ, β = ∑ l : Fin P,
      β (EuclideanSpace.single l (1 : ℝ)) • innerSL ℝ (EuclideanSpace.single l (1 : ℝ)) := by
    intro β
    ext v
    have hv : v = ∑ l : Fin P, v l • EuclideanSpace.single l (1 : ℝ) := by
      conv_lhs => rw [← (EuclideanSpace.basisFun (Fin P) ℝ).sum_repr v]
      simp
    simp only [FunLike.coe_sum, Finset.sum_apply, FunLike.coe_smul,
      Pi.smul_apply, innerSL_apply_apply, EuclideanSpace.inner_single_left, map_one, one_mul,
      smul_eq_mul]
    conv_lhs => rw [hv]
    simp [map_sum, map_smul, mul_comm]
  -- `ζ(β ∧ α) = Σₗ β(eₗ) ζ(⟨eₗ, ·⟩ ∧ α) = β(V)`
  have hid : ∀ β : Euclid P →L[ℝ] ℝ, Φ β = β (∑ l : Fin P,
      Φ (innerSL ℝ (EuclideanSpace.single l (1 : ℝ))) • EuclideanSpace.single l (1 : ℝ)) := by
    intro β
    have h1 : Φ β = Φl β := rfl
    rw [h1, hβexp β, map_sum]
    simp only [map_sum, map_smul, smul_eq_mul]
    apply Finset.sum_congr rfl
    intro l _
    simp only [Φl, LinearMap.coe_mk, AddHom.coe_mk]
    have := hβexp β
    rw [← this]
    ring
  refine ⟨hid, ?_⟩
  intro Q hQ
  obtain ⟨τ, -, hspan, hsign⟩ := hQ
  -- `ζ(⟨v, ·⟩ ∧ α) = ±(⟨v, ·⟩ ∧ α)(τ) = 0` for `v ∈ Qᗮ`, as every `τᵢ ∈ Q`
  have hzero : ∀ v ∈ Qᗮ, Φ (innerSL ℝ v) = 0 := by
    intro v hv
    have hτQ : ∀ i, τ i ∈ Q := fun i => hspan ▸ Submodule.subset_span (Set.mem_range_self i)
    have hval :
        ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ v).smulRight α) τ = 0 := by
      rw [ContinuousAlternatingMap.alternatizeUncurryFin_apply]
      apply Finset.sum_eq_zero
      intro i _
      simp [Submodule.inner_left_of_mem_orthogonal (hτQ i) hv]
    rcases hsign with h | h
    · simp only [Φ, h, hval]
    · simp only [Φ, h, hval, neg_zero]
  -- `⟨u, V⟩ = ζ(⟨u, ·⟩ ∧ α) = 0` for `u ∈ Qᗮ`, so `V ∈ Qᗮᗮ = Q`
  rw [← Submodule.orthogonal_orthogonal Q, Submodule.mem_orthogonal]
  intro u hu
  have := hid (innerSL ℝ u)
  rw [hzero u hu, innerSL_apply_apply] at this
  exact this.symm
/-- Scaling of `Hⁿ` under the blow-up `η_{x,r}(z) = r⁻¹(z − x)`, `r > 0`:
`Hⁿ(η_{x,r}(S) ∩ B̄_R(0)) = r⁻ⁿ Hⁿ(S ∩ B̄_{rR}(x))`.  As `‖η_{x,r}(z)‖ = r⁻¹‖z − x‖`, the left side
is `Hⁿ(η_{x,r}(S ∩ B̄_{rR}(x)))`; and `η_{x,r}` is the homothety of centre `x` and ratio `r⁻¹`,
which multiplies `Hⁿ` by `‖r⁻¹‖₊ⁿ = r⁻ⁿ`, followed by the translation by `−x`, an isometry. -/
theorem Submission.ptd_tl_blowUp_measure_scaling : ∀ (P n : ℕ) (x : Euclid P) (r R : ℝ) (S : Set (Euclid P)), 0 < r → μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' S ∩ closedBall 0 R) = (ENNReal.ofReal r)⁻¹ ^ n * μHE[n] (S ∩ closedBall x (r * R)) := by
  intro P n x r R S hr
  -- `‖η(z)‖ = r⁻¹‖z − x‖`, since `r > 0`
  have hnorm : ∀ z : Euclid P,
      ‖Poincare.SimonGMT.Chapter03.blowUpMap x r z‖ = r⁻¹ * ‖z - x‖ := by
    intro z
    rw [Poincare.SimonGMT.Chapter03.blowUpMap, norm_smul, Real.norm_eq_abs,
      abs_of_pos (inv_pos.mpr hr)]
  -- `η(S) ∩ B̄_R(0) = η(S ∩ B̄_{rR}(x))`
  have hset : Poincare.SimonGMT.Chapter03.blowUpMap x r '' S ∩ closedBall 0 R =
      Poincare.SimonGMT.Chapter03.blowUpMap x r '' (S ∩ closedBall x (r * R)) := by
    ext y
    constructor
    · rintro ⟨⟨z, hz, rfl⟩, hy⟩
      refine ⟨z, ⟨hz, ?_⟩, rfl⟩
      rw [mem_closedBall_zero_iff, hnorm] at hy
      rw [mem_closedBall, dist_eq_norm, ← mul_inv_cancel_left₀ hr.ne' ‖z - x‖]
      exact mul_le_mul_of_nonneg_left hy hr.le
    · rintro ⟨z, ⟨hz, hzx⟩, rfl⟩
      refine ⟨⟨z, hz, rfl⟩, ?_⟩
      rw [mem_closedBall, dist_eq_norm] at hzx
      rw [mem_closedBall_zero_iff, hnorm, ← inv_mul_cancel_left₀ hr.ne' R]
      exact mul_le_mul_of_nonneg_left hzx (inv_pos.mpr hr).le
  -- `η = τ ∘ h`: the homothety `h` of centre `x` and ratio `r⁻¹`, then the translation by `−x`
  have hcomp : Poincare.SimonGMT.Chapter03.blowUpMap x r =
      (fun y : Euclid P => y + -x) ∘ AffineMap.homothety x r⁻¹ := by
    funext z
    simp [Poincare.SimonGMT.Chapter03.blowUpMap, AffineMap.homothety_apply]
  -- `μ(η(T)) = μ(h(T)) = ‖r⁻¹‖₊ⁿ μ(T) = (ofReal r)⁻¹ⁿ μ(T)`
  have hscale : ∀ T : Set (Euclid P), μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' T) =
      (ENNReal.ofReal r)⁻¹ ^ n * μHE[n] T := by
    intro T
    rw [hcomp, Set.image_comp, (isometry_add_right (-x)).euclideanHausdorffMeasure_image,
      euclideanHausdorffMeasure_homothety_image n x (inv_ne_zero hr.ne') T, ENNReal.smul_def,
      smul_eq_mul, ENNReal.coe_pow, nnnorm_inv, ENNReal.coe_inv (nnnorm_ne_zero_iff.mpr hr.ne'),
      Real.nnnorm_of_nonneg hr.le, ← ENNReal.ofReal_eq_coe_nnreal hr.le]
  rw [hset, hscale]
/-- Localized Besicovitch density (Simon Ch. 3, Remark 1.5(2) and the proof of Theorem 1.6, with
Simon Ch. 1, Theorem 3.16 = Mathlib's `Besicovitch.ae_tendsto_measure_inter_div`).  Let `U` be
open, `A ⊆ B ⊆ U` Borel, and `Hⁿ(B ∩ K) < ∞` for every compact `K ⊆ U`.  Then for `Hⁿ⌞A`-a.e.
`x` and every `ε > 0`, `Hⁿ((B \ A) ∩ B̄_ρ(x)) ≤ ε Hⁿ(B ∩ B̄_ρ(x))` for all small `ρ > 0`; the
exceptional set does not depend on `ε`.

Proof sketch:
* Cover `U` by countably many open balls `B_r(y)` with `B̄_r(y) ⊆ U`.
* On each ball, `ν = Hⁿ⌞(B ∩ B̄_r(y))` is finite, so Besicovitch gives
  `ν(A ∩ B̄_ρ(x))/ν(B̄_ρ(x)) → 1` for `ν⌞A = (Hⁿ⌞A)⌞B̄_r(y)`-a.e. `x`.
* For `x ∈ B_r(y)` and small `ρ`, this quotient is `a/β`, where
  `a = Hⁿ(A ∩ B̄_ρ(x))` and `β = Hⁿ(B ∩ B̄_ρ(x)) < ∞`.
* If `ε ≥ 1`, the bound is monotonicity.
* If `ε < 1`, eventually `a/β > 1 − ε`, which forces `0 < β < ∞`; hence
  `Hⁿ((B \ A) ∩ B̄_ρ(x)) = β − a ≤ εβ`. -/
theorem Submission.ptd_tl_ae_excess_le : ∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ ε : ℝ≥0∞, 0 < ε → ∀ᶠ ρ in 𝓝[>] (0 : ℝ), μHE[n] ((B \ A) ∩ closedBall x ρ) ≤ ε * μHE[n] (B ∩ closedBall x ρ) := by
  intro P n U A B hU hA hB hAB hBU hfin
  -- Step 1: countably many open balls `B(y, r y)`, `y ∈ D`, with `B̄(y, r y) ⊆ U` cover `U`
  have hr : ∀ x ∈ U, ∃ r : ℝ, 0 < r ∧ closedBall x r ⊆ U := by
    intro x hx
    obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.1 hU x hx
    exact ⟨δ / 2, half_pos hδ, (closedBall_subset_ball (half_lt_self hδ)).trans hball⟩
  choose! r hr0 hrU using hr
  obtain ⟨D, hDU, hDc, hcov⟩ := TopologicalSpace.countable_cover_nhdsWithin
    (f := fun y => ball y (r y)) (s := U)
    fun x hx => mem_nhdsWithin_of_mem_nhds (ball_mem_nhds x (hr0 x hx))
  -- Steps 2–3: Besicovitch density for the finite measures `Hⁿ⌞(B ∩ B̄(y, r y))`, off one
  -- `Hⁿ⌞A`-null set for all `y ∈ D` at once
  have hpiece : ∀ᵐ x ∂(μHE[n].restrict A), ∀ y ∈ D, x ∈ closedBall y (r y) →
      Tendsto (fun ρ : ℝ => (μHE[n].restrict (B ∩ closedBall y (r y))) (A ∩ closedBall x ρ) /
        (μHE[n].restrict (B ∩ closedBall y (r y))) (closedBall x ρ)) (𝓝[>] 0) (𝓝 1) := by
    rw [ae_ball_iff hDc]
    intro y hy
    have : IsFiniteMeasure ((μHE[n] : Measure (Euclid P)).restrict (B ∩ closedBall y (r y))) :=
      ⟨by
        rw [Measure.restrict_apply_univ]
        exact (hfin _ (isCompact_closedBall y (r y)) (hrU y (hDU hy))).lt_top⟩
    have h := Besicovitch.ae_tendsto_measure_inter_div
      ((μHE[n] : Measure (Euclid P)).restrict (B ∩ closedBall y (r y))) A
    -- `(Hⁿ⌞(B ∩ K))⌞A = (Hⁿ⌞A)⌞K` since `A ⊆ B`
    have hres : ((μHE[n] : Measure (Euclid P)).restrict (B ∩ closedBall y (r y))).restrict A =
        ((μHE[n] : Measure (Euclid P)).restrict A).restrict (closedBall y (r y)) := by
      rw [Measure.restrict_restrict hA, Measure.restrict_restrict measurableSet_closedBall]
      congr 1
      ext z
      exact ⟨fun ⟨hzA, _, hzK⟩ => ⟨hzK, hzA⟩, fun ⟨hzK, hzA⟩ => ⟨hzA, hAB hzA, hzK⟩⟩
    rwa [hres, ae_restrict_iff' measurableSet_closedBall] at h
  filter_upwards [hpiece, ae_restrict_mem hA] with x hx hxA ε hε
  -- Step 4: `x ∈ B(y, r y)` for some `y ∈ D`, so `B̄_ρ(x) ⊆ B̄(y, r y)` for `ρ < δ`
  obtain ⟨y, hyD, hxy⟩ := mem_iUnion₂.1 (hcov (hBU (hAB hxA)))
  obtain ⟨δ, hδ, hδy⟩ := Metric.isOpen_iff.1 isOpen_ball x hxy
  have hsmall : ∀ ρ : ℝ, ρ < δ → closedBall x ρ ⊆ closedBall y (r y) := fun ρ hρ =>
    ((closedBall_subset_ball hρ).trans hδy).trans ball_subset_closedBall
  have hBK : MeasurableSet (B ∩ closedBall y (r y)) := hB.inter measurableSet_closedBall
  -- (i)–(ii): for `ρ < δ` the quotient is `Hⁿ(A ∩ B̄_ρ(x)) / Hⁿ(B ∩ B̄_ρ(x))`
  have hT : Tendsto (fun ρ : ℝ => μHE[n] (A ∩ closedBall x ρ) / μHE[n] (B ∩ closedBall x ρ))
      (𝓝[>] 0) (𝓝 1) := by
    refine (hx y hyD (ball_subset_closedBall hxy)).congr' ?_
    filter_upwards [Ioo_mem_nhdsGT hδ] with ρ hρ
    rw [Measure.restrict_apply' hBK, Measure.restrict_apply' hBK]
    congr 2
    · ext z
      exact ⟨fun ⟨hz, _⟩ => hz, fun ⟨hzA, hzx⟩ => ⟨⟨hzA, hzx⟩, hAB hzA, hsmall ρ hρ.2 hzx⟩⟩
    · ext z
      exact ⟨fun ⟨hzx, hzB, _⟩ => ⟨hzB, hzx⟩, fun ⟨hzB, hzx⟩ => ⟨hzx, hzB, hsmall ρ hρ.2 hzx⟩⟩
  -- (iii): `Hⁿ(B ∩ B̄_ρ(x)) ≤ Hⁿ(B ∩ B̄(y, r y)) < ∞` for `ρ < δ`
  have hfinρ : ∀ ρ : ℝ, ρ < δ → μHE[n] (B ∩ closedBall x ρ) ≠ ∞ := fun ρ hρ =>
    ne_top_of_le_ne_top (hfin _ (isCompact_closedBall y (r y)) (hrU y (hDU hyD)))
      (measure_mono (inter_subset_inter_right B (hsmall ρ hρ)))
  -- (iv): `Hⁿ((B \ A) ∩ B̄_ρ(x)) + Hⁿ(A ∩ B̄_ρ(x)) = Hⁿ(B ∩ B̄_ρ(x))`
  have hsplit : ∀ ρ : ℝ, μHE[n] ((B \ A) ∩ closedBall x ρ) + μHE[n] (A ∩ closedBall x ρ) =
      μHE[n] (B ∩ closedBall x ρ) := by
    intro ρ
    rw [← measure_union _ (hA.inter measurableSet_closedBall)]
    · congr 1
      ext z
      constructor
      · rintro (⟨⟨hzB, -⟩, hzx⟩ | ⟨hzA, hzx⟩)
        · exact ⟨hzB, hzx⟩
        · exact ⟨hAB hzA, hzx⟩
      · rintro ⟨hzB, hzx⟩
        by_cases hzA : z ∈ A
        · exact Or.inr ⟨hzA, hzx⟩
        · exact Or.inl ⟨⟨hzB, hzA⟩, hzx⟩
    · rw [Set.disjoint_left]
      rintro z ⟨⟨-, hzA⟩, -⟩ ⟨hzA', -⟩
      exact hzA hzA'
  -- Step 5: the excess estimate
  rcases le_or_gt 1 ε with hε1 | hε1
  · -- (a) `ε ≥ 1`: monotonicity
    refine Eventually.of_forall fun ρ => ?_
    calc μHE[n] ((B \ A) ∩ closedBall x ρ) ≤ μHE[n] (B ∩ closedBall x ρ) :=
          measure_mono (inter_subset_inter_left _ sdiff_subset)
      _ = 1 * μHE[n] (B ∩ closedBall x ρ) := (one_mul _).symm
      _ ≤ ε * μHE[n] (B ∩ closedBall x ρ) := by gcongr
  · -- (b) `ε < 1`: eventually `a / β > 1 − ε`, with `β ≠ ∞`
    have hsub : 1 - ε < 1 := ENNReal.sub_lt_self ENNReal.one_ne_top one_ne_zero hε.ne'
    filter_upwards [hT (isOpen_Ioi.mem_nhds hsub), Ioo_mem_nhdsGT hδ] with ρ hρq hρ
    set β := μHE[n] (B ∩ closedBall x ρ)
    set a := μHE[n] (A ∩ closedBall x ρ)
    set e := μHE[n] ((B \ A) ∩ closedBall x ρ)
    have hβtop : β ≠ ∞ := hfinρ ρ hρ.2
    have hsplitρ : e + a = β := hsplit ρ
    -- `β ≠ 0`, since otherwise `a / β = 0 / 0 = 0 ≤ 1 − ε`
    have hβ0 : β ≠ 0 := by
      intro h0
      have ha0 : a = 0 := nonpos_iff_eq_zero.1 (h0 ▸ hsplitρ ▸ le_add_self)
      have : a / β = 0 := by rw [ha0, ENNReal.zero_div]
      rw [mem_preimage, this, mem_Ioi] at hρq
      exact not_lt_zero hρq
    have hlt : (1 - ε) * β < a :=
      (ENNReal.lt_div_iff_mul_lt (Or.inl hβ0) (Or.inl hβtop)).1 hρq
    -- `e + (1 − ε)β ≤ e + a = β = εβ + (1 − ε)β`, and `(1 − ε)β ≠ ∞`
    have h1 : e + (1 - ε) * β ≤ ε * β + (1 - ε) * β := by
      calc e + (1 - ε) * β ≤ e + a := by gcongr
        _ = β := hsplitρ
        _ = (ε + (1 - ε)) * β := by rw [add_tsub_cancel_of_le hε1.le, one_mul]
        _ = ε * β + (1 - ε) * β := add_mul _ _ _
    exact ENNReal.le_of_add_le_add_right (ENNReal.mul_ne_top (by simp) hβtop) h1

/-- **Upper density theorem for `Hⁿ` off a Borel set of finite measure** (Simon Ch. 1, 3.3 and
3.6, with the crude covering constant `6ⁿ`; chapter-01.txt lines 602–721).  If `S ⊆ ℝᴾ` is Borel
with `Hⁿ(S) < ∞`, then for `Hⁿ`-a.e. `x ∉ S`, `Hⁿ(S ∩ B̄_ρ(x)) / ρⁿ → 0` as `ρ ↓ 0`.  A failure
at `x` puts `x` in a threshold set `{x ∉ S : Hⁿ(S ∩ B̄_ρ(x)) > t ρⁿ frequently as ρ ↓ 0}` with
`t = (k + 1)⁻¹`.  Vitali's lemma (factor `2`, enlarged radius `3ρ`) and separability give
`t · μH[n](E) ≤ 6ⁿ Hⁿ(G)` whenever each `x ∈ E` has arbitrarily small `ρ` with
`t ρⁿ ≤ Hⁿ(G ∩ B̄_ρ(x))`.  Taking `G = S \ F` for a closed `F ⊆ S` with `Hⁿ(S \ F)` small (weak
regularity of the finite measure `Hⁿ⌞S`), which agrees with `S` near `x ∉ F`, every threshold set
is `μH[n]`-null, hence `Hⁿ`-null. -/
theorem Submission.regcomp_atl_upper_density_zero : ∀ (P n : ℕ) (S : Set (Euclid P)), MeasurableSet S → μHE[n] S ≠ ∞ → ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)), x ∉ S → Tendsto (fun ρ : ℝ => μHE[n] (S ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n) (𝓝[>] 0) (𝓝 0) := by
  intro P n S hS hfin
  -- Step 2, Vitali selection (Simon 1.3.4): a countable disjoint subfamily whose
  -- 3-fold enlargements cover the centres.
  have vitali : ∀ (E : Set (Euclid P)) (p : Euclid P → ℝ → Prop) (δ : ℝ),
      (∀ x ∈ E, ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ ∧ p x ρ) →
      ∃ u : Set (Euclid P × ℝ), u.Countable ∧ (∀ a ∈ u, a.1 ∈ E ∧ 0 < a.2 ∧ a.2 < δ ∧ p a.1 a.2) ∧
        u.PairwiseDisjoint (fun a => closedBall a.1 a.2) ∧
        E ⊆ ⋃ a ∈ u, closedBall a.1 (3 * a.2) := by
    intro E p δ hE
    obtain ⟨u, huT, hdisj, hcov⟩ := Vitali.exists_disjoint_subfamily_covering_enlargement
      (fun a : Euclid P × ℝ => closedBall a.1 a.2)
      {a : Euclid P × ℝ | a.1 ∈ E ∧ 0 < a.2 ∧ a.2 < δ ∧ p a.1 a.2} (fun a => a.2) 2 (by norm_num)
      (fun a ha => ha.2.1.le) δ (fun a ha => ha.2.2.1.le)
      (fun a ha => nonempty_closedBall.2 ha.2.1.le)
    refine ⟨u, ?_, fun a ha => huT ha, hdisj, ?_⟩
    · apply hdisj.countable_of_nonempty_interior
      intro a ha
      refine ⟨a.1, interior_mono ball_subset_closedBall ?_⟩
      rw [isOpen_ball.interior_eq]
      exact mem_ball_self (huT ha).2.1
    · intro x hx
      obtain ⟨ρ, hρ0, hρδ, hp⟩ := hE x hx
      obtain ⟨b, hbu, ⟨w, hw1, hw2⟩, hle⟩ := hcov (x, ρ) ⟨hx, hρ0, hρδ, hp⟩
      refine mem_iUnion₂.2 ⟨b, hbu, ?_⟩
      rw [mem_closedBall]
      have h1 : dist w x ≤ ρ := hw1
      have h2 : dist w b.1 ≤ b.2 := hw2
      have hle' : ρ ≤ 2 * b.2 := hle
      calc dist x b.1 ≤ dist x w + dist w b.1 := dist_triangle _ _ _
        _ ≤ ρ + b.2 := add_le_add (by rw [dist_comm]; exact h1) h2
        _ ≤ 3 * b.2 := by linarith
  -- Step 2, comparison (Simon 1.3.3 with the crude constant 6 ^ n).
  have comparison : ∀ (t : ℝ≥0∞) (E G : Set (Euclid P)), t ≠ 0 → t ≠ ∞ → MeasurableSet G →
      (∀ x ∈ E, ∀ δ : ℝ, 0 < δ → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ ∧
        t * ENNReal.ofReal ρ ^ n ≤ μHE[n] (G ∩ closedBall x ρ)) →
      t * μH[(n : ℝ)] E ≤ 6 ^ n * μHE[n] G := by
    intro t E G ht0 httop hG hE
    have hfam : ∀ j : ℕ, ∃ u : Set (Euclid P × ℝ), u.Countable ∧
        (∀ a ∈ u, a.1 ∈ E ∧ 0 < a.2 ∧ a.2 < 1 / ((j : ℝ) + 1) ∧
          t * ENNReal.ofReal a.2 ^ n ≤ μHE[n] (G ∩ closedBall a.1 a.2)) ∧
        u.PairwiseDisjoint (fun a => closedBall a.1 a.2) ∧
        E ⊆ ⋃ a ∈ u, closedBall a.1 (3 * a.2) :=
      fun j => vitali E (fun c ρ => t * ENNReal.ofReal ρ ^ n ≤ μHE[n] (G ∩ closedBall c ρ))
        (1 / ((j : ℝ) + 1)) (fun x hx => hE x hx _ (by positivity))
    choose u hucount hu hdisj hcover using hfam
    have : ∀ j, Countable (u j) := fun j => (hucount j).to_subtype
    -- packing estimate
    have hsum : ∀ j, t * ∑' a : u j, ENNReal.ofReal (a : Euclid P × ℝ).2 ^ n ≤ μHE[n] G := by
      intro j
      rw [← ENNReal.tsum_mul_left]
      calc ∑' a : u j, t * ENNReal.ofReal (a : Euclid P × ℝ).2 ^ n
          ≤ ∑' a : u j, μHE[n] (G ∩ closedBall (a : Euclid P × ℝ).1 (a : Euclid P × ℝ).2) :=
            ENNReal.tsum_le_tsum fun a => (hu j a a.2).2.2.2
        _ = μHE[n] (⋃ a ∈ u j, G ∩ closedBall a.1 a.2) :=
            (measure_biUnion (hucount j) ((hdisj j).mono fun a => inter_subset_right)
              fun a _ => hG.inter measurableSet_closedBall).symm
        _ ≤ μHE[n] G := measure_mono (iUnion₂_subset fun a _ => inter_subset_left)
    -- diameter estimate
    have hdiam : ∀ j (a : u j), ediam (closedBall (a : Euclid P × ℝ).1 (3 * (a : Euclid P × ℝ).2))
        ≤ ENNReal.ofReal (6 * (a : Euclid P × ℝ).2) := by
      intro j a
      apply ediam_le_of_forall_dist_le
      intro y hy z hz
      rw [mem_closedBall] at hy hz
      calc dist y z ≤ dist y (a : Euclid P × ℝ).1 + dist z (a : Euclid P × ℝ).1 :=
            dist_triangle_right _ _ _
        _ ≤ 6 * (a : Euclid P × ℝ).2 := by linarith
    have hterm : ∀ j, t * ∑' a : u j,
        ediam (closedBall (a : Euclid P × ℝ).1 (3 * (a : Euclid P × ℝ).2)) ^ (n : ℝ) ≤
          6 ^ n * μHE[n] G := by
      intro j
      calc t * ∑' a : u j, ediam (closedBall (a : Euclid P × ℝ).1 (3 * (a : Euclid P × ℝ).2)) ^ (n : ℝ)
          ≤ t * ∑' a : u j, 6 ^ n * ENNReal.ofReal (a : Euclid P × ℝ).2 ^ n := by
            gcongr with a
            rw [ENNReal.rpow_natCast]
            calc ediam (closedBall (a : Euclid P × ℝ).1 (3 * (a : Euclid P × ℝ).2)) ^ n
                ≤ ENNReal.ofReal (6 * (a : Euclid P × ℝ).2) ^ n := by gcongr; exact hdiam j a
              _ = 6 ^ n * ENNReal.ofReal (a : Euclid P × ℝ).2 ^ n := by
                rw [ENNReal.ofReal_mul (show (0 : ℝ) ≤ 6 by norm_num), mul_pow]
                norm_num
        _ = 6 ^ n * (t * ∑' a : u j, ENNReal.ofReal (a : Euclid P × ℝ).2 ^ n) := by
            rw [ENNReal.tsum_mul_left]; ring
        _ ≤ 6 ^ n * μHE[n] G := by gcongr; exact hsum j
    have hH := MeasureTheory.Measure.hausdorffMeasure_le_liminf_tsum (X := Euclid P)
      (ι := fun j => (u j)) (n : ℝ) E (l := atTop)
      (fun j : ℕ => ENNReal.ofReal (6 * (1 / ((j : ℝ) + 1))))
      (by
        rw [← ENNReal.ofReal_zero]
        apply ENNReal.tendsto_ofReal
        have := tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)
        simpa using this.const_mul 6)
      (fun j a => closedBall (a : Euclid P × ℝ).1 (3 * (a : Euclid P × ℝ).2))
      (Eventually.of_forall fun j a => (hdiam j a).trans (ENNReal.ofReal_le_ofReal (by
        have := (hu j a a.2).2.2.1
        linarith)))
      (Eventually.of_forall fun j x hx => by
        obtain ⟨a, ha, hxa⟩ := mem_iUnion₂.1 (hcover j hx)
        exact mem_iUnion.2 ⟨⟨a, ha⟩, hxa⟩)
    have hbound : ∀ j, ∑' a : u j,
        ediam (closedBall (a : Euclid P × ℝ).1 (3 * (a : Euclid P × ℝ).2)) ^ (n : ℝ) ≤
          6 ^ n * μHE[n] G / t := by
      intro j
      rw [ENNReal.le_div_iff_mul_le (Or.inl ht0) (Or.inl httop), mul_comm]
      exact hterm j
    have hlim : μH[(n : ℝ)] E ≤ 6 ^ n * μHE[n] G / t :=
      hH.trans (liminf_le_of_frequently_le' (Frequently.of_forall hbound))
    calc t * μH[(n : ℝ)] E ≤ t * (6 ^ n * μHE[n] G / t) := by gcongr
      _ = 6 ^ n * μHE[n] G := ENNReal.mul_div_cancel ht0 httop
  -- Step 3, each threshold set is null (Simon 1.3.6).
  have threshold : ∀ t : ℝ≥0∞, t ≠ 0 → t ≠ ∞ →
      μHE[n] {x : Euclid P | x ∉ S ∧ ∃ᶠ ρ in 𝓝[>] (0 : ℝ),
        t < μHE[n] (S ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n} = 0 := by
    intro t ht0 httop
    set N := {x : Euclid P | x ∉ S ∧ ∃ᶠ ρ in 𝓝[>] (0 : ℝ),
      t < μHE[n] (S ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n} with hN
    have key : ∀ ε : ℝ≥0∞, ε ≠ 0 → μH[(n : ℝ)] N < ε := by
      intro ε hε
      have : IsFiniteMeasure ((μHE[n] : Measure (Euclid P)).restrict S) :=
        ⟨by rw [Measure.restrict_apply_univ]; exact hfin.lt_top⟩
      have : ((μHE[n] : Measure (Euclid P)).restrict S).WeaklyRegular :=
        Measure.WeaklyRegular.of_pseudoMetrizableSpace_of_isFiniteMeasure _
      have hpos : t * ε / 6 ^ n ≠ 0 := by
        apply ENNReal.div_ne_zero.2
        exact ⟨mul_ne_zero ht0 hε, ENNReal.pow_ne_top (by norm_num)⟩
      obtain ⟨F, hFS, hFc, hFlt⟩ := hS.exists_isClosed_sdiff_lt
        (μ := (μHE[n] : Measure (Euclid P)).restrict S)
        (by rw [Measure.restrict_apply hS, inter_self]; exact hfin) hpos
      have hG : MeasurableSet (S \ F) := hS.diff hFc.measurableSet
      have hμG : μHE[n] (S \ F) < t * ε / 6 ^ n := by
        rwa [Measure.restrict_apply hG, inter_eq_left.2 sdiff_subset] at hFlt
      have hhyp : ∀ x ∈ N, ∀ δ : ℝ, 0 < δ → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ ∧
          t * ENNReal.ofReal ρ ^ n ≤ μHE[n] ((S \ F) ∩ closedBall x ρ) := by
        intro x hx δ hδ
        obtain ⟨hxS, hfreq⟩ := hx
        have hxF : x ∉ F := fun h => hxS (hFS h)
        obtain ⟨r₁, hr₁, hball⟩ := Metric.isOpen_iff.1 hFc.isOpen_compl x hxF
        have hev : ∀ᶠ ρ in 𝓝[>] (0 : ℝ), ρ ∈ Ioo 0 (min δ (r₁ / 2)) :=
          Ioo_mem_nhdsGT (by positivity)
        obtain ⟨ρ, hρq, hρ⟩ := (hfreq.and_eventually hev).exists
        refine ⟨ρ, hρ.1, lt_of_lt_of_le hρ.2 (min_le_left _ _), ?_⟩
        have hρpos : ENNReal.ofReal ρ ^ n ≠ 0 :=
          pow_ne_zero _ (ENNReal.ofReal_pos.2 hρ.1).ne'
        have hρtop : ENNReal.ofReal ρ ^ n ≠ ∞ := ENNReal.pow_ne_top ENNReal.ofReal_ne_top
        have h1 : t * ENNReal.ofReal ρ ^ n < μHE[n] (S ∩ closedBall x ρ) :=
          (ENNReal.lt_div_iff_mul_lt (Or.inl hρpos) (Or.inl hρtop)).1 hρq
        have h2 : S ∩ closedBall x ρ = (S \ F) ∩ closedBall x ρ := by
          ext y
          constructor
          · rintro ⟨hyS, hyB⟩
            refine ⟨⟨hyS, fun hyF => hball ?_ hyF⟩, hyB⟩
            rw [mem_ball]
            have := mem_closedBall.1 hyB
            have := hρ.2
            have := min_le_right δ (r₁ / 2)
            linarith
          · rintro ⟨⟨hyS, _⟩, hyB⟩
            exact ⟨hyS, hyB⟩
        rw [← h2]
        exact h1.le
      have hcomp := comparison t N (S \ F) ht0 httop hG hhyp
      have h6 : (6 : ℝ≥0∞) ^ n ≠ 0 := pow_ne_zero _ (by norm_num)
      have h6' : (6 : ℝ≥0∞) ^ n ≠ ∞ := ENNReal.pow_ne_top (by norm_num)
      have hlt : t * μH[(n : ℝ)] N < t * ε := by
        calc t * μH[(n : ℝ)] N ≤ 6 ^ n * μHE[n] (S \ F) := hcomp
          _ < 6 ^ n * (t * ε / 6 ^ n) := ENNReal.mul_lt_mul_right h6 h6' hμG
          _ = t * ε := ENNReal.mul_div_cancel h6 h6'
      exact (ENNReal.mul_lt_mul_iff_right ht0 httop).1 hlt
    have hH : μH[(n : ℝ)] N = 0 := by
      by_contra h
      exact lt_irrefl _ (key _ h)
    rw [Measure.euclideanHausdorffMeasure_def, Measure.smul_apply, hH, smul_zero]
  -- Steps 1 and 4, every failure of convergence lies in a threshold set.
  rw [ae_iff]
  apply measure_mono_null (t := ⋃ k : ℕ, {x : Euclid P | x ∉ S ∧ ∃ᶠ ρ in 𝓝[>] (0 : ℝ),
    ((k : ℝ≥0∞) + 1)⁻¹ < μHE[n] (S ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n})
  · intro x hx
    simp only [mem_ofPred_eq, Classical.not_imp] at hx
    obtain ⟨hxS, hnt⟩ := hx
    rw [ENNReal.tendsto_nhds_zero] at hnt
    push Not at hnt
    obtain ⟨ε, hε, hfreq⟩ := hnt
    obtain ⟨k, hk⟩ := ENNReal.exists_inv_nat_lt hε.ne'
    refine mem_iUnion.2 ⟨k, hxS, hfreq.mono fun ρ hρ => ?_⟩
    calc ((k : ℝ≥0∞) + 1)⁻¹ ≤ (k : ℝ≥0∞)⁻¹ := ENNReal.inv_le_inv.2 le_self_add
      _ < ε := hk
      _ < _ := hρ
  · exact measure_iUnion_null fun k => threshold _ (by simp) (by simp)

/-- **Upper density theorem for `Hⁿ` off a Borel set of locally finite measure in `U`** (Simon
Ch. 1, Remark 3.7(2); chapter-01.txt lines 705–711).  If `U ⊆ ℝᴾ` is open and `S` is Borel with
`Hⁿ(S ∩ K) < ∞` for every compact `K ⊆ U`, then for `Hⁿ`-a.e. `x ∈ U ∖ S`,
`Hⁿ(S ∩ B̄_ρ(x)) / ρⁿ → 0` as `ρ ↓ 0`.  Countably many balls `B_{r_y}(y)` with
`B̄_{r_y}(y) ⊆ U` cover `U` (Lindelöf); the finite-measure version applies to each piece
`S ∩ B_{r_y}(y)`, and near `x ∈ B_{r_y}(y)` the piece agrees with `S`. -/
theorem Submission.regcomp_atl_local_density_zero : ∀ (P n : ℕ) (U S : Set (Euclid P)), IsOpen U → MeasurableSet S → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (S ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)), x ∈ U → x ∉ S → Tendsto (fun ρ : ℝ => μHE[n] (S ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n) (𝓝[>] 0) (𝓝 0) := by
  intro P n U S hU hS hfin
  -- Step 1, a countable cover of `U` by balls `B(y, r y)` with `B̄(y, r y) ⊆ U`.
  have hr : ∀ x ∈ U, ∃ r : ℝ, 0 < r ∧ closedBall x r ⊆ U := by
    intro x hx
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hU x hx
    exact ⟨ε / 2, half_pos hε, (closedBall_subset_ball (half_lt_self hε)).trans hball⟩
  choose! r hr0 hrU using hr
  obtain ⟨D, hDU, hDc, hcov⟩ := TopologicalSpace.countable_cover_nhdsWithin
    (f := fun y => ball y (r y)) (s := U)
    fun x hx => mem_nhdsWithin_of_mem_nhds (ball_mem_nhds x (hr0 x hx))
  -- Steps 2 and 3, the finite-measure theorem on each piece `S ∩ B(y, r y)`, simultaneously
  -- for the countably many `y ∈ D`.
  have hpiece : ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)), ∀ y ∈ D, x ∉ S ∩ ball y (r y) →
      Tendsto (fun ρ : ℝ => μHE[n] (S ∩ ball y (r y) ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n)
        (𝓝[>] 0) (𝓝 0) := by
    rw [ae_ball_iff hDc]
    intro y hy
    apply Submission.regcomp_atl_upper_density_zero P n _ (hS.inter measurableSet_ball)
    exact ne_top_of_le_ne_top (hfin _ (isCompact_closedBall y (r y)) (hrU y (hDU hy)))
      (measure_mono (inter_subset_inter_right S ball_subset_closedBall))
  -- Step 4, localization: for small `ρ`, `B̄(x, ρ) ⊆ B(y, r y)`, so the piece agrees with `S`.
  filter_upwards [hpiece] with x hx hxU hxS
  obtain ⟨y, hyD, hxy⟩ := mem_iUnion₂.1 (hcov hxU)
  obtain ⟨ε, hε, hεy⟩ := Metric.isOpen_iff.1 isOpen_ball x hxy
  refine (hx y hyD fun h => hxS h.1).congr' ?_
  filter_upwards [Ioo_mem_nhdsGT hε] with ρ hρ
  rw [inter_assoc, inter_eq_right.2 ((closedBall_subset_ball hρ.2).trans hεy)]

/-- **Simon Ch. 3, Remark 1.5(3)** (the upper bound, with `ε = 1`): if `D` has approximate
tangent space `Q` at `x` and `Hⁿ(D ∩ B̄_{r₀}(x)) < ∞`, then `Hⁿ(D ∩ B̄_ρ(x)) ≤ Cρⁿ` for all
small `ρ > 0`.

* Test Definition 1.4 with `φ = max(0, min(1, 2 − |w|)) ∈ C_c`, `1_{B̄₁(0)} ≤ φ ≤ 1_{B̄₂(0)}`:
  `∫_{η_{x,ρ}(D)} φ dHⁿ → Λ := ∫_Q φ dHⁿ`, so for `0 < ρ < r₁` it is `< C := |Λ| + 1`, and
  `2ρ < r₀`.
* By the blow-up scaling, `Hⁿ(η_{x,ρ}(D) ∩ B̄₂(0)) = ρ⁻ⁿHⁿ(D ∩ B̄_{2ρ}(x)) < ∞`, so `φ` is
  integrable on `η_{x,ρ}(D)` and `Hⁿ(η_{x,ρ}(D) ∩ B̄₁(0)) ≤ ∫_{η_{x,ρ}(D)} φ dHⁿ < C`.
* Scaling back, `Hⁿ(D ∩ B̄_ρ(x)) = ρⁿHⁿ(η_{x,ρ}(D) ∩ B̄₁(0)) ≤ Cρⁿ`. -/
theorem Submission.ptd_tl_measure_closedBall_le_of_tangent : ∀ (P n : ℕ) (D : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)) (r₀ : ℝ), MeasurableSet D → 0 < r₀ → μHE[n] (D ∩ closedBall x r₀) ≠ ∞ → HasApproximateTangentSpaceAt n D x Q → ∃ C r₁ : ℝ, 0 < r₁ ∧ ∀ ρ : ℝ, 0 < ρ → ρ < r₁ → μHE[n] (D ∩ closedBall x ρ) ≤ ENNReal.ofReal (C * ρ ^ n) := by
  intro P n D x Q r₀ _ hr₀ hfin hT
  -- Step 1: the cutoff `φ = max(0, min(1, 2 − ‖w‖)) ∈ C_c`, `1_{B̄₁(0)} ≤ φ ≤ 1_{B̄₂(0)}`
  have hout : ∀ w : Euclid P, w ∉ closedBall (0 : Euclid P) 2 → max 0 (min 1 (2 - ‖w‖)) = 0 := by
    intro w hw
    rw [mem_closedBall_zero_iff, not_le] at hw
    exact max_eq_left ((min_le_right _ _).trans (by linarith))
  let φ : CompactlySupportedContinuousMap (Euclid P) ℝ :=
    ⟨⟨fun w => max 0 (min 1 (2 - ‖w‖)), by fun_prop⟩,
      HasCompactSupport.intro (isCompact_closedBall 0 2) hout⟩
  have hφ0 : ∀ w, 0 ≤ φ w := fun w => le_max_left _ _
  have hφ1 : ∀ w, φ w ≤ 1 := fun w => max_le zero_le_one (min_le_left _ _)
  have hφB : ∀ w ∈ closedBall (0 : Euclid P) 1, φ w = 1 := by
    intro w hw
    rw [mem_closedBall_zero_iff] at hw
    show max 0 (min 1 (2 - ‖w‖)) = 1
    rw [min_eq_left (by linarith), max_eq_right zero_le_one]
  -- Step 2: `∫_{η_{x,ρ}(D)} φ dHⁿ → Λ := ∫_Q φ dHⁿ`; choose `r₁` such that
  -- `∫_{η_{x,ρ}(D)} φ dHⁿ < |Λ| + 1` and `ρ < r₀/2` for `0 < ρ < r₁`
  set Λ := ∫ w in (Q : Set (Euclid P)), φ w ∂μHE[n]
  have hC : (0 : ℝ) ≤ |Λ| + 1 := by positivity
  have hev : ∀ᶠ ρ in 𝓝[>] (0 : ℝ),
      (∫ w in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' D, φ w ∂μHE[n]) < |Λ| + 1 ∧
        ρ < r₀ / 2 :=
    ((hT.2 φ).eventually_lt_const ((le_abs_self Λ).trans_lt (lt_add_one _))).and
      (Filter.mem_of_superset (Ioo_mem_nhdsGT (half_pos hr₀)) fun ρ hρ => hρ.2)
  obtain ⟨r₁, hr₁, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1 hev
  refine ⟨|Λ| + 1, r₁, hr₁, fun ρ hρ hρr₁ => ?_⟩
  obtain ⟨hI, hρr₀⟩ := hsub ⟨hρ, hρr₁⟩
  have hρ0 : ENNReal.ofReal ρ ≠ 0 := (ENNReal.ofReal_pos.2 hρ).ne'
  -- the blow-up scaling with `R = 2` and `R = 1`
  have h2 := Submission.ptd_tl_blowUp_measure_scaling P n x ρ 2 D hρ
  have h1 := Submission.ptd_tl_blowUp_measure_scaling P n x ρ 1 D hρ
  rw [mul_one ρ] at h1
  set T := Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' D
  -- Step 3: `Hⁿ(T ∩ B̄₂(0)) = ρ⁻ⁿHⁿ(D ∩ B̄_{2ρ}(x)) < ∞`, as `2ρ < r₀`
  have hTfin : μHE[n] (T ∩ closedBall 0 2) ≠ ∞ := by
    rw [h2]
    refine ENNReal.mul_ne_top (ENNReal.pow_ne_top (ENNReal.inv_ne_top.2 hρ0)) ?_
    refine ne_top_of_le_ne_top hfin (measure_mono (Set.inter_subset_inter_right _ ?_))
    exact closedBall_subset_closedBall (by linarith)
  -- Step 4: `|φ| ≤ 1_{B̄₂(0)}`, which is integrable for `Hⁿ⌞T`; hence so is `φ`
  have hint : Integrable (fun w => φ w) (μHE[n].restrict T) := by
    refine Integrable.mono' (g := (closedBall (0 : Euclid P) 2).indicator fun _ => (1 : ℝ)) ?_
      φ.continuous.aestronglyMeasurable (ae_of_all _ fun w => ?_)
    · rw [integrable_indicator_iff measurableSet_closedBall]
      refine integrableOn_const ?_
      rw [Measure.restrict_apply measurableSet_closedBall, Set.inter_comm]
      exact hTfin
    · by_cases hw : w ∈ closedBall (0 : Euclid P) 2
      · rw [Set.indicator_of_mem hw, Real.norm_of_nonneg (hφ0 w)]
        exact hφ1 w
      · rw [Set.indicator_of_notMem hw, norm_le_zero_iff]
        exact hout w hw
  -- Step 5: `Hⁿ(T ∩ B̄₁(0)) = ∫⁻ 1_{B̄₁(0)} d(Hⁿ⌞T) ≤ ∫⁻ φ d(Hⁿ⌞T) = ∫_T φ dHⁿ < |Λ| + 1`
  have hball : μHE[n] (T ∩ closedBall 0 1) ≤ ENNReal.ofReal (|Λ| + 1) :=
    calc μHE[n] (T ∩ closedBall 0 1)
        = ∫⁻ w, (closedBall (0 : Euclid P) 1).indicator 1 w ∂(μHE[n].restrict T) := by
          rw [lintegral_indicator_one measurableSet_closedBall,
            Measure.restrict_apply measurableSet_closedBall, Set.inter_comm]
      _ ≤ ∫⁻ w, ENNReal.ofReal (φ w) ∂(μHE[n].restrict T) := by
          refine lintegral_mono fun w => ?_
          by_cases hw : w ∈ closedBall (0 : Euclid P) 1
          · rw [Set.indicator_of_mem hw, Pi.one_apply, hφB w hw, ENNReal.ofReal_one]
          · rw [Set.indicator_of_notMem hw]
            exact zero_le
      _ = ENNReal.ofReal (∫ w, φ w ∂(μHE[n].restrict T)) :=
          (ofReal_integral_eq_lintegral_ofReal hint (ae_of_all _ hφ0)).symm
      _ ≤ ENNReal.ofReal (|Λ| + 1) := ENNReal.ofReal_le_ofReal hI.le
  -- Step 6: `Hⁿ(D ∩ B̄_ρ(x)) = ρⁿHⁿ(T ∩ B̄₁(0)) ≤ (|Λ| + 1)ρⁿ`
  calc μHE[n] (D ∩ closedBall x ρ)
      = ENNReal.ofReal ρ ^ n * ((ENNReal.ofReal ρ)⁻¹ ^ n * μHE[n] (D ∩ closedBall x ρ)) := by
        rw [← mul_assoc, ← mul_pow, ENNReal.mul_inv_cancel hρ0 ENNReal.ofReal_ne_top, one_pow,
          one_mul]
    _ = ENNReal.ofReal ρ ^ n * μHE[n] (T ∩ closedBall 0 1) := by rw [h1]
    _ ≤ ENNReal.ofReal ρ ^ n * ENNReal.ofReal (|Λ| + 1) := by gcongr
    _ = ENNReal.ofReal ((|Λ| + 1) * ρ ^ n) := by
        rw [ENNReal.ofReal_mul hC, ENNReal.ofReal_pow hρ.le, mul_comm (ENNReal.ofReal ρ ^ n)]
/-- Zero `n`-density of the excess `B ∖ A` (step 6 of the tangent-locality argument for a piece):
if `Hⁿ(A ∩ B̄_ρ(x)) ≤ Cρⁿ` for `0 < ρ < r₁`, `Hⁿ(B ∩ B̄_{r₀}(x)) < ∞`, and for every `ε > 0`
eventually `Hⁿ((B ∖ A) ∩ B̄_ρ(x)) ≤ ε Hⁿ(B ∩ B̄_ρ(x))`, then `ρ⁻ⁿ Hⁿ((B ∖ A) ∩ B̄_ρ(x)) → 0` as
`ρ ↓ 0`.  With `ε = 1/2`, subadditivity and cancellation of the finite half give
`Hⁿ(B ∩ B̄_ρ(x)) ≤ 2Cρⁿ` for small `ρ`; then `ε = δ/(2C + 1)` gives
`Hⁿ((B ∖ A) ∩ B̄_ρ(x)) ≤ δρⁿ`. -/
theorem Submission.ptd_tl_excess_density_zero : ∀ (P n : ℕ) (A B : Set (Euclid P)) (x : Euclid P) (r₀ C r₁ : ℝ), 0 < r₀ → μHE[n] (B ∩ closedBall x r₀) ≠ ∞ → 0 < r₁ → (∀ ρ : ℝ, 0 < ρ → ρ < r₁ → μHE[n] (A ∩ closedBall x ρ) ≤ ENNReal.ofReal (C * ρ ^ n)) → (∀ ε : ℝ≥0∞, 0 < ε → ∀ᶠ ρ in 𝓝[>] (0 : ℝ), μHE[n] ((B \ A) ∩ closedBall x ρ) ≤ ε * μHE[n] (B ∩ closedBall x ρ)) → Tendsto (fun ρ : ℝ => μHE[n] ((B \ A) ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n) (𝓝[>] 0) (𝓝 0) := by
  intro P n A B x r₀ C r₁ hr₀ hfin hr₁ hG hE
  -- Step 1: for `ρ > 0`, `ofReal (Cρⁿ) = ofReal C · (ofReal ρ)ⁿ`
  have hA : ∀ ρ : ℝ, 0 < ρ → ρ < r₁ →
      μHE[n] (A ∩ closedBall x ρ) ≤ ENNReal.ofReal C * ENNReal.ofReal ρ ^ n := by
    intro ρ hρ hρ₁
    rw [← ENNReal.ofReal_pow hρ.le, ← ENNReal.ofReal_mul' (pow_nonneg hρ.le n)]
    exact hG ρ hρ hρ₁
  -- Step 2: eventually `Hⁿ(B ∩ B̄_ρ(x)) ≤ κ (ofReal ρ)ⁿ` with `κ = 2 ofReal C`
  set κ : ℝ≥0∞ := 2 * ENNReal.ofReal C with hκ
  have hB : ∀ᶠ ρ in 𝓝[>] (0 : ℝ), μHE[n] (B ∩ closedBall x ρ) ≤ κ * ENNReal.ofReal ρ ^ n := by
    filter_upwards [Ioo_mem_nhdsGT (lt_min hr₀ hr₁),
      hE 2⁻¹ (ENNReal.inv_pos.2 ENNReal.ofNat_ne_top)] with ρ hρ he
    have hρ₀ : ρ ≤ r₀ := hρ.2.le.trans (min_le_left _ _)
    have hρ₁ : ρ < r₁ := hρ.2.trans_le (min_le_right _ _)
    have hβ : μHE[n] (B ∩ closedBall x ρ) ≠ ∞ :=
      ne_top_of_le_ne_top hfin
        (measure_mono (inter_subset_inter_right B (closedBall_subset_closedBall hρ₀)))
    -- `B ∩ B̄_ρ(x) ⊆ (A ∩ B̄_ρ(x)) ∪ ((B ∖ A) ∩ B̄_ρ(x))`, so subadditivity applies
    have hsub : μHE[n] (B ∩ closedBall x ρ) ≤
        μHE[n] (A ∩ closedBall x ρ) + μHE[n] ((B \ A) ∩ closedBall x ρ) := by
      refine (measure_mono ?_).trans (measure_union_le _ _)
      rintro y ⟨hyB, hyρ⟩
      by_cases hyA : y ∈ A
      · exact Or.inl ⟨hyA, hyρ⟩
      · exact Or.inr ⟨⟨hyB, hyA⟩, hyρ⟩
    -- `β/2 + β/2 = β ≤ a + e ≤ a + β/2`; cancelling the finite `β/2` gives `β/2 ≤ a`
    have hhalf : μHE[n] (B ∩ closedBall x ρ) / 2 ≤ μHE[n] (A ∩ closedBall x ρ) := by
      refine (ENNReal.add_le_add_iff_right (ENNReal.div_ne_top hβ two_ne_zero)).1 ?_
      rw [ENNReal.add_halves, ENNReal.div_eq_inv_mul]
      exact hsub.trans (add_le_add le_rfl he)
    calc μHE[n] (B ∩ closedBall x ρ)
        = μHE[n] (B ∩ closedBall x ρ) / 2 + μHE[n] (B ∩ closedBall x ρ) / 2 :=
          (ENNReal.add_halves _).symm
      _ ≤ μHE[n] (A ∩ closedBall x ρ) + μHE[n] (A ∩ closedBall x ρ) := add_le_add hhalf hhalf
      _ = 2 * μHE[n] (A ∩ closedBall x ρ) := (two_mul _).symm
      _ ≤ 2 * (ENNReal.ofReal C * ENNReal.ofReal ρ ^ n) := by gcongr; exact hA ρ hρ.1 hρ₁
      _ = κ * ENNReal.ofReal ρ ^ n := by rw [hκ, mul_assoc]
  -- Step 3: for `δ > 0`, `ε = δ/(κ + 1)` gives `Hⁿ((B ∖ A) ∩ B̄_ρ(x)) ≤ δ (ofReal ρ)ⁿ` eventually
  rw [ENNReal.tendsto_nhds_zero]
  intro δ hδ
  have hκ₁ : κ + 1 ≠ ∞ :=
    ENNReal.add_ne_top.2 ⟨ENNReal.mul_ne_top ENNReal.ofNat_ne_top ENNReal.ofReal_ne_top,
      ENNReal.one_ne_top⟩
  have hκ₀ : κ + 1 ≠ 0 := by positivity
  filter_upwards [hB, hE (δ / (κ + 1)) (ENNReal.div_pos hδ.ne' hκ₁)] with ρ hρB hρe
  -- Step 4: hence `Hⁿ((B ∖ A) ∩ B̄_ρ(x)) / (ofReal ρ)ⁿ ≤ δ`
  refine ENNReal.div_le_of_le_mul ?_
  calc μHE[n] ((B \ A) ∩ closedBall x ρ)
      ≤ δ / (κ + 1) * μHE[n] (B ∩ closedBall x ρ) := hρe
    _ ≤ δ / (κ + 1) * ((κ + 1) * ENNReal.ofReal ρ ^ n) := by
        gcongr
        exact hρB.trans (by gcongr; exact le_self_add)
    _ = δ * ENNReal.ofReal ρ ^ n := by rw [← mul_assoc, ENNReal.div_mul_cancel hκ₀ hκ₁]

/-- **Simon Ch. 3, Remark 1.5(2)** (locality of approximate tangent spaces): if `A ⊆ B` are Borel,
`Hⁿ(B ∩ B̄_{r₀}(x)) < ∞` and `Hⁿ((B ∖ A) ∩ B̄_ρ(x)) / ρⁿ → 0` as `ρ ↓ 0`, then `B` and `A` have
the same approximate tangent spaces at `x`.  If `f ∈ C_c` vanishes off `B̄_R(0)` and `|f| ≤ M`,
then for `0 < ρ < r₀/R` the difference `∫_{η_{x,ρ}(B)} f − ∫_{η_{x,ρ}(A)} f = ∫_{η_{x,ρ}(B ∖ A)} f`
is at most `M Hⁿ(η_{x,ρ}(B ∖ A) ∩ B̄_R(0)) = M ρ⁻ⁿ Hⁿ((B ∖ A) ∩ B̄_{ρR}(x))` in absolute value
(by `Submission.ptd_tl_blowUp_measure_scaling`), and this tends to `0`. -/
theorem Submission.ptd_tl_tangent_iff_of_density_zero : ∀ (P n : ℕ) (A B : Set (Euclid P)) (x : Euclid P) (r₀ : ℝ), MeasurableSet A → MeasurableSet B → A ⊆ B → 0 < r₀ → μHE[n] (B ∩ closedBall x r₀) ≠ ∞ → Tendsto (fun ρ : ℝ => μHE[n] ((B \ A) ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n) (𝓝[>] 0) (𝓝 0) → ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q := by
  intro P n A B x r₀ hA hB hAB hr₀ hfin hdens Q
  -- Step 1: for `ρ ≠ 0`, `η_{x,ρ}` is injective and `η_{x,ρ}(S) = (y ↦ x + ρy)⁻¹(S)` is Borel
  have hinj : ∀ ρ : ℝ, ρ ≠ 0 → Injective (Poincare.SimonGMT.Chapter03.blowUpMap x ρ) := by
    intro ρ hρ a b hab
    exact sub_left_injective (smul_right_injective (Euclid P) (inv_ne_zero hρ) hab)
  have hmeas : ∀ ρ : ℝ, ρ ≠ 0 → ∀ S : Set (Euclid P), MeasurableSet S →
      MeasurableSet (Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' S) := by
    intro ρ hρ S hS
    have himage : Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' S =
        (fun y => x + ρ • y) ⁻¹' S := by
      ext y
      constructor
      · rintro ⟨z, hz, rfl⟩
        simpa [Poincare.SimonGMT.Chapter03.blowUpMap, smul_inv_smul₀ hρ] using hz
      · intro hy
        exact ⟨x + ρ • y, hy, by simp [Poincare.SimonGMT.Chapter03.blowUpMap, inv_smul_smul₀ hρ]⟩
    rw [himage]
    exact hS.preimage (by fun_prop)
  -- Step 2: for every `f ∈ C_c`, `Δ_f(ρ) = ∫_{η_{x,ρ}(B)} f − ∫_{η_{x,ρ}(A)} f → 0`
  have key : ∀ f : CompactlySupportedContinuousMap (Euclid P) ℝ,
      Tendsto (fun ρ : ℝ =>
        (∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' B, f y ∂μHE[n]) -
          ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' A, f y ∂μHE[n]) (𝓝[>] 0) (𝓝 0) := by
    intro f
    -- (a): `f` vanishes off `B̄_R(0)` for some `R > 0`, and `|f| ≤ M`
    obtain ⟨R, hRpos, hout⟩ : ∃ R : ℝ, 0 < R ∧
        ∀ y : Euclid P, y ∉ closedBall (0 : Euclid P) R → f y = 0 := by
      obtain ⟨R₀, hR₀⟩ := f.hasCompactSupport.isCompact.isBounded.subset_closedBall 0
      exact ⟨max R₀ 1, lt_of_lt_of_le one_pos (le_max_right _ _), fun y hy =>
        image_eq_zero_of_notMem_tsupport fun hy' =>
          hy (closedBall_subset_closedBall (le_max_left _ _) (hR₀ hy'))⟩
    obtain ⟨M, hM⟩ := f.continuous.bounded_above_of_compact_support f.hasCompactSupport
    -- (b): `f` is integrable on `S` whenever `Hⁿ(S ∩ B̄_R(0)) < ∞`
    have hint : ∀ S : Set (Euclid P), μHE[n] (S ∩ closedBall 0 R) ≠ ∞ →
        IntegrableOn (fun y => f y) S μHE[n] := by
      intro S hS
      refine Integrable.mono' (g := (closedBall (0 : Euclid P) R).indicator fun _ => M) ?_
        f.continuous.aestronglyMeasurable (ae_of_all _ fun y => ?_)
      · rw [integrable_indicator_iff measurableSet_closedBall]
        refine integrableOn_const ?_
        rw [Measure.restrict_apply measurableSet_closedBall, Set.inter_comm]
        exact hS
      · by_cases hy : y ∈ closedBall (0 : Euclid P) R
        · rw [Set.indicator_of_mem hy]
          exact hM y
        · rw [Set.indicator_of_notMem hy, hout y hy, norm_zero]
    -- (c)–(e) give `|Δ_f(ρ)| ≤ M Hⁿ(η_{x,ρ}(B ∖ A) ∩ B̄_R(0))` for `0 < ρ < r₀/R`; (f) sends the
    -- bound to `0`
    refine squeeze_zero_norm' (a := fun ρ : ℝ => M *
      (μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' (B \ A) ∩ closedBall 0 R)).toReal)
      ?_ ?_
    · filter_upwards [Ioo_mem_nhdsGT (div_pos hr₀ hRpos)] with ρ hρ
      have hρ0 : 0 < ρ := hρ.1
      have hρR : ρ * R < r₀ := (lt_div_iff₀ hRpos).1 hρ.2
      -- (c): for `S ⊆ B`, `Hⁿ(η_{x,ρ}(S) ∩ B̄_R(0)) = ρ⁻ⁿ Hⁿ(S ∩ B̄_{ρR}(x)) < ∞`
      have hfinS : ∀ S ⊆ B,
          μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' S ∩ closedBall 0 R) ≠ ∞ := by
        intro S hS
        rw [Submission.ptd_tl_blowUp_measure_scaling P n x ρ R S hρ0]
        exact ENNReal.mul_ne_top
          (ENNReal.pow_ne_top (ENNReal.inv_ne_top.2 (ENNReal.ofReal_pos.2 hρ0).ne'))
          (ne_top_of_le_ne_top hfin
            (measure_mono (inter_subset_inter hS (closedBall_subset_closedBall hρR.le))))
      -- (d): `Δ_f(ρ) = ∫_{η_{x,ρ}(B ∖ A)} f`, as `η_{x,ρ}(B ∖ A) = η_{x,ρ}(B) ∖ η_{x,ρ}(A)`
      have hsplit : (∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' B, f y ∂μHE[n]) -
          ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' A, f y ∂μHE[n] =
          ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' (B \ A), f y ∂μHE[n] := by
        rw [image_sdiff (hinj ρ hρ0.ne'), setIntegral_sdiff (hmeas ρ hρ0.ne' A hA)
          (hint _ (hfinS B subset_rfl)) (image_mono hAB)]
      -- (e): `f = 0` off `B̄_R(0)` and `|f| ≤ M`
      have hball : ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' (B \ A), f y ∂μHE[n] =
          ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' (B \ A) ∩ closedBall 0 R,
            f y ∂μHE[n] :=
        setIntegral_eq_of_subset_of_forall_sdiff_eq_zero (hmeas ρ hρ0.ne' _ (hB.diff hA))
          inter_subset_left fun y hy => hout y fun h => hy.2 ⟨hy.1, h⟩
      rw [hsplit, hball]
      exact norm_setIntegral_le_of_norm_le_const (lt_top_iff_ne_top.2 (hfinS _ sdiff_subset))
        fun y _ => hM y
    -- (f): `Hⁿ(η_{x,ρ}(B ∖ A) ∩ B̄_R(0)) = Rⁿ Hⁿ((B ∖ A) ∩ B̄_{ρR}(x)) / (ρR)ⁿ → 0`, by (†)
    -- along `ρ ↦ ρR`
    have hlin : Tendsto (fun ρ : ℝ => ρ * R) (𝓝[>] 0) (𝓝[>] 0) := by
      refine tendsto_nhdsWithin_iff.2 ⟨?_, ?_⟩
      · exact ((continuous_mul_const R).tendsto' 0 0 (zero_mul R)).mono_left nhdsWithin_le_nhds
      · filter_upwards [self_mem_nhdsWithin] with ρ (hρ : 0 < ρ)
        exact mul_pos hρ hRpos
    have hsmall : Tendsto (fun ρ : ℝ =>
        μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' (B \ A) ∩ closedBall 0 R))
        (𝓝[>] 0) (𝓝 0) := by
      have h := ENNReal.Tendsto.const_mul (hdens.comp hlin)
        (Or.inr (ENNReal.pow_ne_top ENNReal.ofReal_ne_top) :
          (0 : ℝ≥0∞) ≠ 0 ∨ ENNReal.ofReal R ^ n ≠ ∞)
      rw [mul_zero] at h
      refine h.congr' ?_
      filter_upwards [self_mem_nhdsWithin] with ρ (hρ : 0 < ρ)
      have hβ : ENNReal.ofReal R ^ n * (ENNReal.ofReal R ^ n)⁻¹ = 1 :=
        ENNReal.mul_inv_cancel (pow_ne_zero n (ENNReal.ofReal_pos.2 hRpos).ne')
          (ENNReal.pow_ne_top ENNReal.ofReal_ne_top)
      simp only [Function.comp_apply]
      rw [Submission.ptd_tl_blowUp_measure_scaling P n x ρ R (B \ A) hρ,
        ENNReal.ofReal_mul hρ.le, mul_pow, ← ENNReal.inv_pow, div_eq_mul_inv,
        ENNReal.mul_inv (Or.inl (pow_ne_zero n (ENNReal.ofReal_pos.2 hρ).ne'))
          (Or.inl (ENNReal.pow_ne_top ENNReal.ofReal_ne_top))]
      calc ENNReal.ofReal R ^ n * (μHE[n] ((B \ A) ∩ closedBall x (ρ * R)) *
            ((ENNReal.ofReal ρ ^ n)⁻¹ * (ENNReal.ofReal R ^ n)⁻¹))
          = ENNReal.ofReal R ^ n * (ENNReal.ofReal R ^ n)⁻¹ *
            ((ENNReal.ofReal ρ ^ n)⁻¹ * μHE[n] ((B \ A) ∩ closedBall x (ρ * R))) := by ring
        _ = (ENNReal.ofReal ρ ^ n)⁻¹ * μHE[n] ((B \ A) ∩ closedBall x (ρ * R)) := by
          rw [hβ, one_mul]
    have h := ((ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp hsmall).const_mul M
    rwa [ENNReal.toReal_zero, mul_zero] at h
  -- Steps 3–4: transfer the limits of Definition 1.4 in both directions; `finrank Q = n` is shared
  constructor
  · rintro ⟨hdim, hconv⟩
    refine ⟨hdim, fun f => ?_⟩
    have h := (hconv f).sub (key f)
    rw [sub_zero] at h
    exact h.congr fun ρ => sub_sub_cancel _ _
  · rintro ⟨hdim, hconv⟩
    refine ⟨hdim, fun f => ?_⟩
    have h := (hconv f).add (key f)
    rw [add_zero] at h
    exact h.congr fun ρ => add_sub_cancel _ _

/-- **Simon Ch. 3, Remarks 1.5(2)–(3) and the proof of Theorem 1.6 "⇒"**: let `U` be open,
`A ⊆ B ⊆ U` Borel, and `Hⁿ(B ∩ K) < ∞` for every compact `K ⊆ U`.  Then for `Hⁿ⌞A`-a.e. `x`,
simultaneously for every subspace `Q`, `B` has approximate tangent space `Q` at `x` iff `A` does.

* Off one `Hⁿ⌞A`-null set, independent of `Q`, `x ∈ A` and for every `ε > 0`,
  `Hⁿ((B \ A) ∩ B̄_ρ(x)) ≤ ε Hⁿ(B ∩ B̄_ρ(x))` for all small `ρ > 0` (Besicovitch).
* `B̄_{s/2}(x) ⊆ B_s(x) ⊆ U` is compact, so `Hⁿ(B ∩ B̄_{s/2}(x)) < ∞`.
* A tangent plane of `B` or of `A` at `x` gives `Hⁿ(A ∩ B̄_ρ(x)) ≤ Cρⁿ` for small `ρ` (via
  `A ⊆ B` in the first case), hence `Hⁿ((B \ A) ∩ B̄_ρ(x)) = o(ρⁿ)`, and then the blow-up integrals
  of `B` and `A` have the same limits. -/
theorem Submission.ptd_ae_approxTangent_iff_of_subset : ∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q := by
  intro P n U A B hU hA hB hAB hBU hfin
  -- Steps 2–4: off one `Hⁿ⌞A`-null set, chosen before `Q`, `x ∈ A` and the excess of `B` over
  -- `A` near `x` is eventually small relative to `Hⁿ(B ∩ B̄_ρ(x))`
  filter_upwards [Submission.ptd_tl_ae_excess_le P n U A B hU hA hB hAB hBU hfin,
    ae_restrict_mem hA] with x hexc hxA Q
  -- a compact ball `B̄_{s/2}(x) ⊆ B_s(x) ⊆ U`, so `Hⁿ(B ∩ B̄_{s/2}(x)) < ∞`
  obtain ⟨s, hs, hsU⟩ := Metric.isOpen_iff.1 hU x (hBU (hAB hxA))
  have hr₀ : 0 < s / 2 := half_pos hs
  have hBfin : μHE[n] (B ∩ closedBall x (s / 2)) ≠ ∞ :=
    hfin _ (isCompact_closedBall x (s / 2)) ((closedBall_subset_ball (half_lt_self hs)).trans hsU)
  have hAB_le : ∀ ρ : ℝ, μHE[n] (A ∩ closedBall x ρ) ≤ μHE[n] (B ∩ closedBall x ρ) :=
    fun ρ => measure_mono (inter_subset_inter_left _ hAB)
  -- Steps 6–7: a growth bound `Hⁿ(A ∩ B̄_ρ(x)) ≤ Cρⁿ` makes the excess `o(ρⁿ)`, which forces
  -- the same approximate tangent spaces
  have hiff : ∀ C r₁ : ℝ, 0 < r₁ →
      (∀ ρ : ℝ, 0 < ρ → ρ < r₁ → μHE[n] (A ∩ closedBall x ρ) ≤ ENNReal.ofReal (C * ρ ^ n)) →
      (HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q) :=
    fun C r₁ hr₁ hgrowth =>
      Submission.ptd_tl_tangent_iff_of_density_zero P n A B x (s / 2) hA hB hAB hr₀ hBfin
        (Submission.ptd_tl_excess_density_zero P n A B x (s / 2) C r₁ hr₀ hBfin hr₁ hgrowth
          hexc) Q
  -- Step 8: step 5 turns the assumed tangent plane into the growth bound
  constructor
  · -- the growth bound for `B` passes to `A ⊆ B`
    intro hTB
    obtain ⟨C, r₁, hr₁, hgrowth⟩ :=
      Submission.ptd_tl_measure_closedBall_le_of_tangent P n B x Q (s / 2) hB hr₀ hBfin hTB
    exact (hiff C r₁ hr₁ fun ρ hρ hρr₁ => (hAB_le ρ).trans (hgrowth ρ hρ hρr₁)).1 hTB
  · intro hTA
    obtain ⟨C, r₁, hr₁, hgrowth⟩ :=
      Submission.ptd_tl_measure_closedBall_le_of_tangent P n A x Q (s / 2) hA hr₀
        (ne_top_of_le_ne_top hBfin (hAB_le (s / 2))) hTA
    exact (hiff C r₁ hr₁ hgrowth).2 hTA
/-- Borel image and null-set pullback along a bi-Lipschitz piece: if `F : ℝⁿ → ℝᴾ` is Lipschitz,
`B ⊆ ℝⁿ` is Borel and `m‖a − a'‖ ≤ ‖F a − F a'‖` on `B` (`m > 0`), then `F(B)` is Borel
(Lusin–Souslin), and a property holding `Hⁿ⌞F(B)`-a.e. holds at `F b` for Lebesgue-a.e. `b ∈ B`:
`invFunOn F B` is `m⁻¹`-Lipschitz on `F(B)` (Simon Ch. 2, 1.8(i)) and maps the `Hⁿ`-null bad
image set onto a superset of the bad parameters, and `Hⁿ` is Lebesgue measure on `ℝⁿ`. -/
theorem Submission.ptd_piece_image_measurable_ae_pullback : ∀ (P n : ℕ) (F : Euclid n → Euclid P) (B : Set (Euclid n)) (L : NNReal) (m : ℝ), LipschitzWith L F → MeasurableSet B → 0 < m → (∀ a ∈ B, ∀ a' ∈ B, m * ‖a - a'‖ ≤ ‖F a - F a'‖) → MeasurableSet (F '' B) ∧ ∀ p : Euclid P → Prop, (∀ᵐ y ∂(μHE[n].restrict (F '' B)), p y) → ∀ᵐ b ∂(volume.restrict B), p (F b) := by
  intro P n F B L m hF hB hm hlow
  -- Step 1: the lower bound makes `F` injective on `B`
  have hinj : InjOn F B := fun a ha a' ha' h => by
    have hle := hlow a ha a' ha'
    rw [h, sub_self, norm_zero] at hle
    exact sub_eq_zero.1 (norm_le_zero_iff.1 (nonpos_of_mul_nonpos_right hle hm))
  -- Step 2: Lusin–Souslin
  have hFB : MeasurableSet (F '' B) := hB.image_of_continuousOn_injOn hF.continuous.continuousOn hinj
  refine ⟨hFB, fun p hp => ?_⟩
  -- Step 3: `G = invFunOn F B` is `m⁻¹`-Lipschitz on `F '' B`
  have hG : LipschitzOnWith (Real.toNNReal m⁻¹) (invFunOn F B) (F '' B) := by
    refine LipschitzOnWith.of_dist_le' ?_
    rintro _ ⟨a, ha, rfl⟩ _ ⟨a', ha', rfl⟩
    rw [hinj.leftInvOn_invFunOn ha, hinj.leftInvOn_invFunOn ha', dist_eq_norm, dist_eq_norm,
      inv_mul_eq_div, le_div_iff₀' hm]
    exact hlow a ha a' ha'
  -- Step 4: the bad parameters lie in the `G`-image of the `Hⁿ`-null bad image set
  rw [ae_restrict_iff' hFB, ae_iff] at hp
  rw [ae_restrict_iff' hB, ae_iff, ← EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
  have hnull : μHE[n] (invFunOn F B '' {y | ¬(y ∈ F '' B → p y)}) = 0 := by
    refine le_zero_iff.1 ?_
    calc μHE[n] (invFunOn F B '' {y | ¬(y ∈ F '' B → p y)})
        ≤ (Real.toNNReal m⁻¹ : ℝ≥0∞) ^ n * μHE[n] {y | ¬(y ∈ F '' B → p y)} :=
          Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
            (hG.mono fun y hy => (not_imp.1 hy).1)
      _ = 0 := by rw [hp, mul_zero]
  refine measure_mono_null (fun b hb => ?_) hnull
  obtain ⟨hbB, hpb⟩ := not_imp.1 (show ¬(b ∈ B → p (F b)) from hb)
  exact ⟨F b, show ¬(F b ∈ F '' B → p (F b)) from not_imp.2 ⟨mem_image_of_mem F hbB, hpb⟩,
    hinj.leftInvOn_invFunOn hbB⟩
/-- **Simon Ch. 3, 1.4** (change of variables under the blow-up `η_{x,r}`): for `r > 0`, every
set `M` and every `f`, `∫_{η_{x,r}(M)} f dHⁿ = r⁻ⁿ ∫_M f(η_{x,r}(y)) dHⁿ(y)`.
`η_{x,r} = (r⁻¹ • ·) ∘ (· − x)` is a homeomorphism with `Hⁿ(η_{x,r}(S)) = r⁻ⁿ Hⁿ(S)` for every
`S` (translation is an isometry), so `Hⁿ⌞η_{x,r}(M) = r⁻ⁿ η_{x,r#}(Hⁿ⌞M)`. -/
theorem Submission.pit_setIntegral_blowUpMap_image : ∀ (P n : ℕ) (M : Set (Euclid P)) (x : Euclid P) (r : ℝ), 0 < r → ∀ f : Euclid P → ℝ, ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, f y ∂μHE[n] = r⁻¹ ^ n * ∫ y in M, f (Poincare.SimonGMT.Chapter03.blowUpMap x r y) ∂μHE[n] := by
  intro P n M x r hr f
  -- `η_{x,r} = (r⁻¹ • ·) ∘ (· - x)` is a homeomorphism
  obtain ⟨e, he⟩ : ∃ e : Euclid P ≃ₜ Euclid P,
      ⇑e = Poincare.SimonGMT.Chapter03.blowUpMap x r :=
    ⟨(Homeomorph.subRight x).trans (Homeomorph.smulOfNeZero r⁻¹ (inv_ne_zero hr.ne')), rfl⟩
  -- `Hⁿ(η_{x,r}(S)) = ‖r⁻¹‖₊ⁿ Hⁿ(S)` for every set `S`
  have hscale : ∀ S : Set (Euclid P), μHE[n] (e '' S) = ‖r⁻¹‖₊ ^ n • μHE[n] S := by
    intro S
    have hS : e '' S = (fun y => r⁻¹ • y) '' ((IsometryEquiv.subRight x) '' S) := by
      rw [image_image, he]
      rfl
    rw [hS, image_smul, Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hr.ne'),
      (IsometryEquiv.subRight x).isometry.euclideanHausdorffMeasure_image]
  -- `Hⁿ⌞η_{x,r}(M) = ‖r⁻¹‖₊ⁿ η_{x,r#}(Hⁿ⌞M)`, checked on Borel sets
  have hmeas : μHE[n].restrict (e '' M) = (‖r⁻¹‖₊ ^ n) • (μHE[n].restrict M).map e := by
    ext A hA
    rw [Measure.restrict_apply hA, Measure.smul_apply, Measure.map_apply e.measurable hA,
      Measure.restrict_apply (hA.preimage e.measurable), ← hscale, image_inter e.injective,
      e.image_preimage]
  -- change of variables, with `‖r⁻¹‖₊ⁿ = r⁻¹ ^ n`
  rw [← he, hmeas, integral_smul_nnreal_measure, e.measurableEmbedding.integral_map,
    NNReal.smul_def, smul_eq_mul, NNReal.coe_pow, coe_nnnorm, Real.norm_eq_abs,
    abs_of_pos (inv_pos.2 hr)]

/-- **Rescaled area formula** (Jacobian kept abstract): if `F` is continuous, `B` and `J ≥ 0` are
Borel and `∫⁻_{F(B)} g dHⁿ = ∫⁻_B J(x) g(F(x)) dλ(x)` for every `g ≥ 0`, then for `r > 0` and
continuous `f`,
`∫_{η_{F(b),r}(F(B))} f dHⁿ = ∫ 1_B(b + rc) J(b + rc) f(r⁻¹(F(b + rc) − F(b))) dλ(c)`.
The area hypothesis says `Hⁿ⌞F(B) = F_#ν` with `ν = J λ⌞B`, which transports every integral;
the substitution `a = b + rc` produces the factor `rⁿ` that cancels the `r⁻ⁿ` of the blow-up. -/
theorem Submission.pit_blowUp_image_setIntegral_eq_rescaled : ∀ (P n : ℕ) (F : Euclid n → Euclid P) (B : Set (Euclid n)) (J : Euclid n → ℝ) (b : Euclid n) (r : ℝ) (f : Euclid P → ℝ), Continuous F → MeasurableSet B → Measurable J → (∀ a, 0 ≤ J a) → (∀ g : Euclid P → ℝ≥0∞, ∫⁻ y in F '' B, g y ∂μHE[n] = ∫⁻ x in B, ENNReal.ofReal (J x) * g (F x) ∂volume) → 0 < r → Continuous f → ∫ z in Poincare.SimonGMT.Chapter03.blowUpMap (F b) r '' (F '' B), f z ∂μHE[n] = ∫ c, B.indicator J (b + r • c) * f (r⁻¹ • (F (b + r • c) - F b)) ∂volume := by
  intro P n F B J b r f hF hB hJ hJ0 harea hr hf
  -- blow-up scaling: `∫_{η(F(B))} f dHⁿ = r⁻ⁿ ∫_{F(B)} f ∘ η dHⁿ`, `η = η_{F(b),r}`
  rw [Submission.pit_setIntegral_blowUpMap_image P n (F '' B) (F b) r hr f]
  -- `Hⁿ⌞F(B) = F_#ν`: the area hypothesis with `g = 1_T` for every Borel `T`
  have hmeas : μHE[n].restrict (F '' B) =
      Measure.map F ((volume.restrict B).withDensity fun x => ENNReal.ofReal (J x)) := by
    ext T hT
    have h := harea (T.indicator 1)
    rw [lintegral_indicator_one hT] at h
    rw [h, Measure.map_apply hF.measurable hT, withDensity_apply _ (hT.preimage hF.measurable),
      ← lintegral_indicator (hT.preimage hF.measurable)]
    congr 1
    funext x
    by_cases hx : F x ∈ T <;> simp [hx]
  -- `∫_{F(B)} f ∘ η dHⁿ = ∫ 1_B J (f ∘ η ∘ F) dλ`, with no integrability needed
  have hη : Continuous fun z => f (Poincare.SimonGMT.Chapter03.blowUpMap (F b) r z) := by
    unfold Poincare.SimonGMT.Chapter03.blowUpMap
    fun_prop
  have hpull : ∫ y in F '' B, f (Poincare.SimonGMT.Chapter03.blowUpMap (F b) r y) ∂μHE[n] =
      ∫ x, B.indicator J x * f (r⁻¹ • (F x - F b)) ∂volume := by
    rw [hmeas, integral_map hF.aemeasurable hη.aestronglyMeasurable]
    have h := integral_withDensity_eq_integral_smul (μ := volume.restrict B) hJ.real_toNNReal
      (fun x => f (Poincare.SimonGMT.Chapter03.blowUpMap (F b) r (F x)))
    simp only [ENNReal.ofReal]
    rw [h, ← integral_indicator hB]
    congr 1
    funext x
    by_cases hx : x ∈ B
    · simp [hx, NNReal.smul_def, hJ0 x, Poincare.SimonGMT.Chapter03.blowUpMap]
    · simp [hx]
  rw [hpull]
  -- substitution `a = b + rc`: `∫ G(b + rc) dλ(c) = r⁻ⁿ ∫ G dλ`
  set G : Euclid n → ℝ := fun x => B.indicator J x * f (r⁻¹ • (F x - F b))
  have hsubst : ∫ c, G (b + r • c) ∂volume = r⁻¹ ^ n * ∫ a, G a ∂volume := by
    rw [Measure.integral_comp_smul volume (fun x => G (b + x)) r,
      integral_add_left_eq_self (fun x => G x) b, finrank_euclideanSpace_fin, smul_eq_mul,
      ← inv_pow, abs_of_pos (pow_pos (inv_pos.2 hr) n)]
  exact hsubst.symm
/-- Co-Lipschitz bounds pass to the derivative at density points: if `m > 0`,
`m‖a − b‖ ≤ ‖F(a) − F(b)‖` for every `a ∈ B` (`B` arbitrary), `F` is differentiable at `b` and
`λ(B ∩ B̄_ρ(b)) / λ(B̄_ρ(b)) → 1` as `ρ ↓ 0`, then `m‖c‖ ≤ ‖DF(b)c‖` for every `c`.
For small `r > 0` the ball `B_{rδ}(b + rc)`, a fixed fraction `(δ / (‖c‖ + δ))ⁿ` of
`B̄_{r(‖c‖+δ)}(b)`, must meet `B`; the bound at such a point and differentiability give
`m‖c‖ ≤ ‖DF(b)c‖ + δ(m + ‖DF(b)‖ + ‖c‖ + δ)`, and `δ ↓ 0`. -/
theorem Submission.pit_fderiv_lower_bound_of_density : ∀ (P n : ℕ) (F : Euclid n → Euclid P) (B : Set (Euclid n)) (m : ℝ) (b : Euclid n), 0 < m → (∀ a ∈ B, m * ‖a - b‖ ≤ ‖F a - F b‖) → DifferentiableAt ℝ F b → Tendsto (fun ρ : ℝ => volume (B ∩ closedBall b ρ) / volume (closedBall b ρ)) (𝓝[>] 0) (𝓝 1) → ∀ c : Euclid n, m * ‖c‖ ≤ ‖fderiv ℝ F b c‖ := by
  intro P n F B m b hm hB hF hdens c
  set L := fderiv ℝ F b with hL
  have hFL : HasFDerivAt F L b := hF.hasFDerivAt
  -- main estimate: for every `δ > 0`, `m‖c‖ ≤ ‖Lc‖ + δ (m + ‖L‖ + ‖c‖ + δ)`
  have key : ∀ δ : ℝ, 0 < δ → m * ‖c‖ ≤ ‖L c‖ + δ * (m + ‖L‖ + ‖c‖ + δ) := by
    intro δ hδ
    have hK : 0 < ‖c‖ + δ := by positivity
    -- differentiability: `‖F a - F b - L (a - b)‖ ≤ δ ‖a - b‖` near `b`
    obtain ⟨ε, hε, hεF⟩ := Metric.eventually_nhds_iff.1 (hFL.isLittleO.bound hδ)
    -- density: the ratio exceeds `1 - q`, `q = (δ / (‖c‖ + δ)) ^ n`, on some `(0, ρ₀)`
    obtain ⟨q, hq_def⟩ : ∃ q : ℝ≥0∞, q = ENNReal.ofReal ((δ / (‖c‖ + δ)) ^ n) := ⟨_, rfl⟩
    have hq : q ≠ 0 := by
      rw [hq_def, Ne, ENNReal.ofReal_eq_zero, not_le]
      positivity
    have hlt : 1 - q < 1 := ENNReal.sub_lt_self ENNReal.one_ne_top one_ne_zero hq
    obtain ⟨ρ₀, hρ₀, hρ₀sub⟩ :=
      mem_nhdsGT_iff_exists_Ioo_subset.1 (hdens.eventually_const_lt hlt)
    have hρ₀' : 0 < ρ₀ := hρ₀
    -- the radius `ρ = r (‖c‖ + δ)`
    obtain ⟨ρ, hρ, hρε, hρρ₀⟩ : ∃ ρ : ℝ, 0 < ρ ∧ ρ < ε ∧ ρ < ρ₀ :=
      ⟨min ε ρ₀ / 2, by positivity, by linarith [min_le_left ε ρ₀, lt_min hε hρ₀'],
        by linarith [min_le_right ε ρ₀, lt_min hε hρ₀']⟩
    obtain ⟨r, hr_def⟩ : ∃ r : ℝ, r = ρ / (‖c‖ + δ) := ⟨_, rfl⟩
    have hr : 0 < r := by rw [hr_def]; positivity
    have hrK : r * (‖c‖ + δ) = ρ := by rw [hr_def]; field_simp
    -- some point of `B` lies in `B_{rδ}(b + r c)`, else the ratio at `ρ` is `≤ 1 - q`
    obtain ⟨a, haB, ha⟩ : ∃ a ∈ B, ‖a - (b + r • c)‖ < r * δ := by
      by_contra! hcon
      have hsub : ball (b + r • c) (r * δ) ⊆ closedBall b ρ := by
        intro x hx
        rw [mem_ball, dist_eq_norm] at hx
        rw [mem_closedBall, dist_eq_norm]
        calc ‖x - b‖ = ‖(x - (b + r • c)) + r • c‖ := by congr 1; abel
          _ ≤ ‖x - (b + r • c)‖ + ‖r • c‖ := norm_add_le _ _
          _ = ‖x - (b + r • c)‖ + r * ‖c‖ := by rw [norm_smul, Real.norm_of_nonneg hr.le]
          _ ≤ ρ := by rw [← hrK]; linarith
      have hBsub : B ∩ closedBall b ρ ⊆ closedBall b ρ \ ball (b + r • c) (r * δ) := by
        rintro x ⟨hxB, hx⟩
        refine ⟨hx, fun hxW => ?_⟩
        rw [mem_ball, dist_eq_norm] at hxW
        exact (hcon x hxB).not_gt hxW
      have hVfin : volume (closedBall b ρ) ≠ ∞ := measure_closedBall_lt_top.ne
      have hball : volume (ball (b + r • c) (r * δ)) = q * volume (closedBall b ρ) := by
        rw [Measure.addHaar_ball_of_pos volume _ (mul_pos hr hδ),
          Measure.addHaar_closedBall volume _ hρ.le, finrank_euclideanSpace_fin, ← mul_assoc,
          hq_def, ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ (δ / (‖c‖ + δ)) ^ n), ← mul_pow,
          ← hrK]
        congr 3
        field_simp
      have hle : volume (B ∩ closedBall b ρ) ≤ (1 - q) * volume (closedBall b ρ) := by
        calc volume (B ∩ closedBall b ρ)
            ≤ volume (closedBall b ρ \ ball (b + r • c) (r * δ)) := measure_mono hBsub
          _ = volume (closedBall b ρ) - volume (ball (b + r • c) (r * δ)) :=
            measure_sdiff hsub measurableSet_ball.nullMeasurableSet measure_ball_lt_top.ne
          _ = (1 - q) * volume (closedBall b ρ) := by
            rw [hball, ENNReal.sub_mul (fun _ _ => hVfin), one_mul]
      have hgt : 1 - q < volume (B ∩ closedBall b ρ) / volume (closedBall b ρ) :=
        hρ₀sub ⟨hρ, hρρ₀⟩
      exact lt_irrefl _ (hgt.trans_le (ENNReal.div_le_of_le_mul hle))
    -- the estimate at `a`, with `a - b = r c + e`, `‖e‖ < r δ`
    obtain ⟨e, he_def⟩ : ∃ e : Euclid n, e = a - (b + r • c) := ⟨_, rfl⟩
    rw [← he_def] at ha
    have hab : a - b = r • c + e := by rw [he_def]; abel
    have hab_le : ‖a - b‖ ≤ r * ‖c‖ + ‖e‖ := by
      rw [hab]
      refine (norm_add_le _ _).trans ?_
      rw [norm_smul, Real.norm_of_nonneg hr.le]
    have hab_lt : ‖a - b‖ < r * (‖c‖ + δ) := by rw [mul_add]; linarith
    have hdist : dist a b < ε := by rw [dist_eq_norm]; linarith
    have h1 : m * ‖a - b‖ ≤ ‖F a - F b‖ := hB a haB
    have h2 : ‖F a - F b‖ ≤ ‖L (a - b)‖ + δ * ‖a - b‖ := by
      have h := hεF hdist
      have h' := norm_sub_norm_le (F a - F b) (L (a - b))
      linarith
    have h3 : ‖L (a - b)‖ ≤ r * ‖L c‖ + ‖L‖ * ‖e‖ := by
      rw [hab, map_add, map_smul]
      refine (norm_add_le _ _).trans ?_
      rw [norm_smul, Real.norm_of_nonneg hr.le]
      linarith [L.le_opNorm e]
    have h4 : r * ‖c‖ ≤ ‖a - b‖ + ‖e‖ := by
      have : r • c = (a - b) - e := by rw [hab]; abel
      calc r * ‖c‖ = ‖r • c‖ := by rw [norm_smul, Real.norm_of_nonneg hr.le]
        _ = ‖(a - b) - e‖ := by rw [this]
        _ ≤ ‖a - b‖ + ‖e‖ := norm_sub_le _ _
    have h5 : ‖L‖ * ‖e‖ ≤ ‖L‖ * (r * δ) := mul_le_mul_of_nonneg_left ha.le (norm_nonneg _)
    have h6 : m * ‖e‖ ≤ m * (r * δ) := mul_le_mul_of_nonneg_left ha.le hm.le
    have h7 : δ * ‖a - b‖ ≤ δ * (r * (‖c‖ + δ)) := mul_le_mul_of_nonneg_left hab_lt.le hδ.le
    have h8 : m * (r * ‖c‖) ≤ m * (‖a - b‖ + ‖e‖) := mul_le_mul_of_nonneg_left h4 hm.le
    have hfin : r * (m * ‖c‖) ≤ r * (‖L c‖ + δ * (m + ‖L‖ + ‖c‖ + δ)) := by
      linarith
    exact le_of_mul_le_mul_left hfin hr
  -- let `δ → 0⁺`
  have hlim : Tendsto (fun δ : ℝ => ‖L c‖ + δ * (m + ‖L‖ + ‖c‖ + δ)) (𝓝[>] 0) (𝓝 ‖L c‖) := by
    have hcont : Continuous (fun δ : ℝ => ‖L c‖ + δ * (m + ‖L‖ + ‖c‖ + δ)) := by fun_prop
    simpa using (hcont.tendsto 0).mono_left nhdsWithin_le_nhds
  exact ge_of_tendsto hlim (eventually_nhdsWithin_of_forall fun δ hδ => key δ hδ)
/-- If `F` has derivative `L` at `b` and `f` is continuous with compact support, then
`∫_{B̄_R(0)} |f(r⁻¹(F(b + rc) − F(b))) − f(Lc)| dc → 0` as `r ↓ 0` (the error term `T₃` in the
limit of rescaled integrals over the image of a `C¹` piece; cf. the tangent-plane limit in Simon
Ch. 3, proof of 1.6 "⇒").  With `V = |B̄_R(0)|` and `S = |R| + 1`, take `η` from the uniform
continuity of `f` for `ε / (V + 1)`, then `δ₀` with `‖F(b + k) − F(b) − Lk‖ ≤ (η / 2S)‖k‖` for
`‖k‖ < δ₀`; for `0 < r < δ₀ / S` the integrand is `≤ ε / (V + 1)` on the ball. -/
theorem Submission.pit_ril_diffQuot_integral_tendsto : ∀ (P n : ℕ) (F : Euclid n → Euclid P) (L : Euclid n →L[ℝ] Euclid P) (b : Euclid n) (f : Euclid P → ℝ) (R : ℝ), HasFDerivAt F L b → Continuous f → HasCompactSupport f → Tendsto (fun r : ℝ => ∫ c in closedBall (0 : Euclid n) R, ‖f (r⁻¹ • (F (b + r • c) - F b)) - f (L c)‖ ∂volume) (𝓝[>] 0) (𝓝 0) := by
  intro P n F L b f R hF hfc hfs
  -- `D = B̄_R(0)` has finite measure `V`, and `‖c‖ < S = |R| + 1` on `D`
  have hDfin : (volume : Measure (Euclid n)) (closedBall 0 R) < ∞ := measure_closedBall_lt_top
  set V : ℝ := (volume : Measure (Euclid n)).real (closedBall 0 R)
  have hV : 0 ≤ V := measureReal_nonneg
  set S : ℝ := |R| + 1
  have hS : 0 < S := by positivity
  have hcS : ∀ c ∈ closedBall (0 : Euclid n) R, ‖c‖ < S := fun c hc =>
    ((mem_closedBall_zero_iff.1 hc).trans (le_abs_self R)).trans_lt (lt_add_one _)
  -- uniform continuity of `f` and the little-o form of `HasFDerivAt`
  have huc := Metric.uniformContinuous_iff.1 (hfs.uniformContinuous_of_continuous hfc)
  have hlo := hasFDerivAt_iff_isLittleO_nhds_zero.1 hF
  rw [Metric.tendsto_nhdsWithin_nhds]
  intro ε hε
  have hV1 : 0 < V + 1 := by linarith
  set ε₁ : ℝ := ε / (V + 1) with hε₁_def
  have hε₁ : 0 < ε₁ := div_pos hε hV1
  obtain ⟨η, hη, hηf⟩ := huc ε₁ hε₁
  set θ : ℝ := η / (2 * S) with hθ_def
  have hθ : 0 < θ := div_pos hη (by linarith)
  obtain ⟨δ₀, hδ₀, hδ₀F⟩ := Metric.eventually_nhds_iff.1 (hlo.bound hθ)
  refine ⟨δ₀ / S, div_pos hδ₀ hS, fun r hr hrδ => ?_⟩
  rw [mem_Ioi] at hr
  rw [Real.dist_eq, sub_zero, abs_of_pos hr] at hrδ
  have hrS : r * S < δ₀ := (lt_div_iff₀ hS).1 hrδ
  -- pointwise bound on the integrand
  have hpt : ∀ c ∈ closedBall (0 : Euclid n) R,
      ‖‖f (r⁻¹ • (F (b + r • c) - F b)) - f (L c)‖‖ ≤ ε₁ := by
    intro c hc
    have hc' := hcS c hc
    have hnorm : ‖r • c‖ = r * ‖c‖ := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hr]
    have hrc : dist (r • c) 0 < δ₀ := by
      rw [dist_zero_right, hnorm]
      calc r * ‖c‖ ≤ r * S := mul_le_mul_of_nonneg_left hc'.le hr.le
        _ < δ₀ := hrS
    have hbound := hδ₀F hrc
    have heq : r⁻¹ • (F (b + r • c) - F b) - L c
        = r⁻¹ • (F (b + r • c) - F b - L (r • c)) := by
      rw [map_smul, smul_sub _ (F (b + r • c) - F b), inv_smul_smul₀ hr.ne']
    have hclose : dist (r⁻¹ • (F (b + r • c) - F b)) (L c) < η := by
      rw [dist_eq_norm, heq, norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hr]
      calc r⁻¹ * ‖F (b + r • c) - F b - L (r • c)‖
          ≤ r⁻¹ * (θ * ‖r • c‖) := mul_le_mul_of_nonneg_left hbound (inv_nonneg.2 hr.le)
        _ = θ * ‖c‖ := by rw [hnorm]; field_simp
        _ ≤ θ * S := mul_le_mul_of_nonneg_left hc'.le hθ.le
        _ = η / 2 := by rw [hθ_def]; field_simp
        _ < η := half_lt_self hη
    have := hηf hclose
    rw [Real.dist_eq] at this
    rw [norm_norm, Real.norm_eq_abs]
    exact this.le
  -- integral bound
  have hint := norm_setIntegral_le_of_norm_le_const hDfin hpt
  rw [dist_zero_right]
  calc ‖∫ c in closedBall (0 : Euclid n) R, ‖f (r⁻¹ • (F (b + r • c) - F b)) - f (L c)‖‖
      ≤ ε₁ * V := hint
    _ < ε := by
      rw [hε₁_def, div_mul_eq_mul_div, div_lt_iff₀ hV1]
      nlinarith
/-- At a point `b` of Lebesgue density one of the Borel set `B` (`λ(B ∩ B̄_ρ(b))/λ(B̄_ρ(b)) → 1`
as `ρ ↓ 0`, the quotient taken in `[0, ∞]`), the averages `⨍_{B̄_s(b)} 1_{ℝⁿ∖B} dλ` tend to `0`
as `s ↓ 0`.  For `s > 0`, `0 < λ(B̄_s(b)) < ∞` and, by additivity, the average equals
`1 − (λ(B ∩ B̄_s(b))/λ(B̄_s(b))).toReal`; `toReal` is continuous at `1`. -/
theorem Submission.pit_ril_compl_average_tendsto : ∀ (n : ℕ) (B : Set (Euclid n)) (b : Euclid n), MeasurableSet B → Tendsto (fun ρ : ℝ => volume (B ∩ closedBall b ρ) / volume (closedBall b ρ)) (𝓝[>] 0) (𝓝 1) → Tendsto (fun s : ℝ => ⨍ a in closedBall b s, Bᶜ.indicator (fun _ => (1 : ℝ)) a ∂volume) (𝓝[>] 0) (𝓝 0) := by
  intro n B b hB hlim
  -- `q(ρ).toReal → 1` (`toReal` is continuous at `1 ≠ ∞`), so `1 - q(ρ).toReal → 0`
  have h1 : Tendsto (fun ρ : ℝ =>
      1 - (volume (B ∩ closedBall b ρ) / volume (closedBall b ρ)).toReal) (𝓝[>] 0) (𝓝 0) := by
    have h := (tendsto_const_nhds : Tendsto (fun _ : ℝ => (1 : ℝ)) (𝓝[>] 0) (𝓝 1)).sub
      ((ENNReal.tendsto_toReal ENNReal.one_ne_top).comp hlim)
    rwa [ENNReal.toReal_one, sub_self] at h
  refine h1.congr' ?_
  -- for `s > 0`, `0 < λ(C_s) < ∞` and the average equals `1 - q(s).toReal`
  filter_upwards [self_mem_nhdsWithin] with s (hs : 0 < s)
  have hfin : volume (closedBall b s) ≠ ∞ := measure_closedBall_lt_top.ne
  have hC : volume.real (closedBall b s) ≠ 0 :=
    (ENNReal.toReal_pos (measure_closedBall_pos volume b hs).ne' hfin).ne'
  -- `λ_ℝ(C_s ∩ B) + λ_ℝ(C_s \ B) = λ_ℝ(C_s)`
  have hsplit := measureReal_inter_add_sdiff (μ := volume) (s := closedBall b s) hB hfin
  rw [setAverage_eq, setIntegral_indicator hB.compl, setIntegral_const, smul_eq_mul, smul_eq_mul,
    mul_one, ENNReal.toReal_div, ← measureReal_def, ← measureReal_def, inter_comm B,
    ← Set.sdiff_eq, ← hsplit]
  rw [← hsplit] at hC
  field_simp
  ring
/-- Localised three-term estimate for the rescaled area integrals (one fixed `r > 0`).  With
`Φ_r(c) = r⁻¹(F(b + rc) − F(b))` and `D = B̄_{R/m}(0)`, the integrands
`X(c) = 1_B(b + rc) J(b + rc) f(Φ_r(c))` and `Y(c) = J(b) f(Lc)` vanish off `D` (by the lower
bounds for `F` on `B` and for `L`, as `f = 0` off the open `R`-ball), and pointwise
`|X − Y| ≤ KM·1_{Bᶜ}(b + rc) + M|J(b + rc) − J(b)| + J(b)|f(Φ_r(c)) − f(Lc)|`, by cases on
`b + rc ∈ B`; all are bounded Borel functions, so integrate over `D`. -/
theorem Submission.pit_ril_three_term_bound : ∀ (P n : ℕ) (F : Euclid n → Euclid P) (L : Euclid n →L[ℝ] Euclid P) (B : Set (Euclid n)) (J : Euclid n → ℝ) (K m : ℝ) (b : Euclid n) (f : Euclid P → ℝ) (R M r : ℝ), Continuous F → MeasurableSet B → Measurable J → (∀ a, 0 ≤ J a ∧ J a ≤ K) → 0 < m → (∀ a ∈ B, m * ‖a - b‖ ≤ ‖F a - F b‖) → (∀ c, m * ‖c‖ ≤ ‖L c‖) → Continuous f → (∀ w, R ≤ ‖w‖ → f w = 0) → (∀ w, ‖f w‖ ≤ M) → 0 < r → ‖(∫ c, B.indicator J (b + r • c) * f (r⁻¹ • (F (b + r • c) - F b)) ∂volume) - J b * (∫ c, f (L c) ∂volume)‖ ≤ K * M * (∫ c in closedBall (0 : Euclid n) (R / m), Bᶜ.indicator (fun _ => (1 : ℝ)) (b + r • c) ∂volume) + M * (∫ c in closedBall (0 : Euclid n) (R / m), ‖J (b + r • c) - J b‖ ∂volume) + J b * (∫ c in closedBall (0 : Euclid n) (R / m), ‖f (r⁻¹ • (F (b + r • c) - F b)) - f (L c)‖ ∂volume) := by
  intro P n F L B J K m b f R M r hF hB hJ hJK hm hFB hL hf hfR hfM hr
  -- constants: `0 ≤ M`, `0 ≤ J b ≤ K`, `0 ≤ K`, and `λ(D) < ∞` for `D = B̄_{R/m}(0)`
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hfM 0)
  have hJb0 : 0 ≤ J b := (hJK b).1
  have hJbK : J b ≤ K := (hJK b).2
  have hK0 : 0 ≤ K := hJb0.trans hJbK
  have hDfin : volume (closedBall (0 : Euclid n) (R / m)) ≠ ∞ := measure_closedBall_lt_top.ne
  -- measurability of the integrands
  have hshift : Continuous fun c : Euclid n => b + r • c :=
    continuous_const.add (continuous_id.const_smul r)
  have hΦ : Continuous fun c : Euclid n => f (r⁻¹ • (F (b + r • c) - F b)) :=
    hf.comp (((hF.comp hshift).sub continuous_const).const_smul r⁻¹)
  have hfL : Continuous fun c : Euclid n => f (L c) := hf.comp L.continuous
  have hIJ : Measurable fun c : Euclid n => B.indicator J (b + r • c) :=
    (hJ.indicator hB).comp hshift.measurable
  have hg₁ : Measurable fun c : Euclid n => Bᶜ.indicator (fun _ => (1 : ℝ)) (b + r • c) :=
    (measurable_const.indicator hB.compl).comp hshift.measurable
  have hg₂ : Measurable fun c : Euclid n => ‖J (b + r • c) - J b‖ :=
    ((hJ.comp hshift.measurable).sub measurable_const).norm
  have hg₃ : Continuous fun c : Euclid n => ‖f (r⁻¹ • (F (b + r • c) - F b)) - f (L c)‖ :=
    (hΦ.sub hfL).norm
  -- bounded measurable functions are integrable on `D`
  have hIJb : ∀ c : Euclid n, ‖B.indicator J (b + r • c)‖ ≤ K := by
    intro c
    by_cases h : b + r • c ∈ B
    · rw [Set.indicator_of_mem h, Real.norm_of_nonneg (hJK _).1]
      exact (hJK _).2
    · rw [Set.indicator_of_notMem h, norm_zero]
      exact hK0
  have hXint : IntegrableOn
      (fun c : Euclid n => B.indicator J (b + r • c) * f (r⁻¹ • (F (b + r • c) - F b)))
      (closedBall (0 : Euclid n) (R / m)) volume := by
    refine Measure.integrableOn_of_bounded (M := K * M) hDfin
      (hIJ.mul hΦ.measurable).aestronglyMeasurable (Eventually.of_forall fun c => ?_)
    rw [norm_mul]
    exact mul_le_mul (hIJb c) (hfM _) (norm_nonneg _) hK0
  have hYint : IntegrableOn (fun c : Euclid n => J b * f (L c))
      (closedBall (0 : Euclid n) (R / m)) volume := by
    refine Measure.integrableOn_of_bounded (M := K * M) hDfin
      (measurable_const.mul hfL.measurable).aestronglyMeasurable (Eventually.of_forall fun c => ?_)
    rw [norm_mul, Real.norm_of_nonneg hJb0]
    exact mul_le_mul hJbK (hfM _) (norm_nonneg _) hK0
  have hg₁int : IntegrableOn (fun c : Euclid n => Bᶜ.indicator (fun _ => (1 : ℝ)) (b + r • c))
      (closedBall (0 : Euclid n) (R / m)) volume := by
    refine Measure.integrableOn_of_bounded (M := 1) hDfin hg₁.aestronglyMeasurable
      (Eventually.of_forall fun c => ?_)
    by_cases h : b + r • c ∈ Bᶜ
    · rw [Set.indicator_of_mem h, norm_one]
    · rw [Set.indicator_of_notMem h, norm_zero]
      exact zero_le_one
  have hg₂int : IntegrableOn (fun c : Euclid n => ‖J (b + r • c) - J b‖)
      (closedBall (0 : Euclid n) (R / m)) volume := by
    refine Measure.integrableOn_of_bounded (M := K) hDfin hg₂.aestronglyMeasurable
      (Eventually.of_forall fun c => ?_)
    rw [norm_norm, Real.norm_eq_abs, abs_sub_le_iff]
    constructor <;> linarith [hJK (b + r • c), hJK b]
  have hg₃int : IntegrableOn
      (fun c : Euclid n => ‖f (r⁻¹ • (F (b + r • c) - F b)) - f (L c)‖)
      (closedBall (0 : Euclid n) (R / m)) volume := by
    refine Measure.integrableOn_of_bounded (M := M + M) hDfin hg₃.aestronglyMeasurable
      (Eventually.of_forall fun c => ?_)
    rw [norm_norm]
    exact (norm_sub_le _ _).trans (add_le_add (hfM _) (hfM _))
  -- localisation: both integrands vanish off `D`
  have hloc : ∀ c : Euclid n, c ∉ closedBall (0 : Euclid n) (R / m) → R < m * ‖c‖ := by
    intro c hc
    rw [mem_closedBall, dist_zero_right, not_le, div_lt_iff₀ hm] at hc
    rwa [mul_comm] at hc
  have hXloc : ∀ c : Euclid n, c ∉ closedBall (0 : Euclid n) (R / m) →
      B.indicator J (b + r • c) * f (r⁻¹ • (F (b + r • c) - F b)) = 0 := by
    intro c hc
    by_cases h : b + r • c ∈ B
    · have h1 := hFB _ h
      rw [add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hr.le] at h1
      have h2 : R ≤ ‖r⁻¹ • (F (b + r • c) - F b)‖ := by
        rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hr.le)]
        calc R ≤ m * ‖c‖ := (hloc c hc).le
          _ = r⁻¹ * (m * (r * ‖c‖)) := by rw [mul_left_comm m r, inv_mul_cancel_left₀ hr.ne']
          _ ≤ r⁻¹ * ‖F (b + r • c) - F b‖ := mul_le_mul_of_nonneg_left h1 (inv_nonneg.2 hr.le)
      rw [hfR _ h2, mul_zero]
    · rw [Set.indicator_of_notMem h, zero_mul]
  have hYloc : ∀ c : Euclid n, c ∉ closedBall (0 : Euclid n) (R / m) → J b * f (L c) = 0 := by
    intro c hc
    rw [hfR _ ((hloc c hc).le.trans (hL c)), mul_zero]
  -- pointwise three-term estimate, by cases on `b + r • c ∈ B`
  have hpt : ∀ c : Euclid n,
      ‖B.indicator J (b + r • c) * f (r⁻¹ • (F (b + r • c) - F b)) - J b * f (L c)‖ ≤
        K * M * Bᶜ.indicator (fun _ => (1 : ℝ)) (b + r • c) + M * ‖J (b + r • c) - J b‖ +
          J b * ‖f (r⁻¹ • (F (b + r • c) - F b)) - f (L c)‖ := by
    intro c
    have hu := hfM (r⁻¹ • (F (b + r • c) - F b))
    have hv := hfM (L c)
    have hA : 0 ≤ M * ‖J (b + r • c) - J b‖ := mul_nonneg hM0 (norm_nonneg _)
    have hB' : 0 ≤ J b * ‖f (r⁻¹ • (F (b + r • c) - F b)) - f (L c)‖ :=
      mul_nonneg hJb0 (norm_nonneg _)
    by_cases h : b + r • c ∈ B
    · rw [Set.indicator_of_mem h, Set.indicator_of_notMem (Set.notMem_compl_iff.2 h), mul_zero,
        zero_add]
      have hJu := mul_le_mul_of_nonneg_left hu (norm_nonneg (J (b + r • c) - J b))
      calc ‖J (b + r • c) * f (r⁻¹ • (F (b + r • c) - F b)) - J b * f (L c)‖
          = ‖(J (b + r • c) - J b) * f (r⁻¹ • (F (b + r • c) - F b)) +
              J b * (f (r⁻¹ • (F (b + r • c) - F b)) - f (L c))‖ := by
            congr 1
            ring
        _ ≤ ‖(J (b + r • c) - J b) * f (r⁻¹ • (F (b + r • c) - F b))‖ +
              ‖J b * (f (r⁻¹ • (F (b + r • c) - F b)) - f (L c))‖ := norm_add_le _ _
        _ = ‖J (b + r • c) - J b‖ * ‖f (r⁻¹ • (F (b + r • c) - F b))‖ +
              J b * ‖f (r⁻¹ • (F (b + r • c) - F b)) - f (L c)‖ := by
            rw [norm_mul, norm_mul, Real.norm_of_nonneg hJb0]
        _ ≤ M * ‖J (b + r • c) - J b‖ + J b * ‖f (r⁻¹ • (F (b + r • c) - F b)) - f (L c)‖ := by
            linarith [mul_comm M ‖J (b + r • c) - J b‖]
    · rw [Set.indicator_of_notMem h, Set.indicator_of_mem (Set.mem_compl h), zero_mul, zero_sub,
        norm_neg, norm_mul, Real.norm_of_nonneg hJb0, mul_one]
      have hJv : J b * ‖f (L c)‖ ≤ K * M := mul_le_mul hJbK hv (norm_nonneg _) hK0
      linarith
  -- integrate the pointwise estimate over `D`
  have h1 : (∫ c, B.indicator J (b + r • c) * f (r⁻¹ • (F (b + r • c) - F b)) ∂volume) =
      ∫ c in closedBall (0 : Euclid n) (R / m),
        B.indicator J (b + r • c) * f (r⁻¹ • (F (b + r • c) - F b)) ∂volume :=
    (setIntegral_eq_integral_of_forall_compl_eq_zero hXloc).symm
  have h2 : J b * (∫ c, f (L c) ∂volume) =
      ∫ c in closedBall (0 : Euclid n) (R / m), J b * f (L c) ∂volume := by
    rw [← integral_const_mul]
    exact (setIntegral_eq_integral_of_forall_compl_eq_zero hYloc).symm
  have hG₁₂ : IntegrableOn (fun c : Euclid n => K * M * Bᶜ.indicator (fun _ => (1 : ℝ)) (b + r • c) +
      M * ‖J (b + r • c) - J b‖) (closedBall (0 : Euclid n) (R / m)) volume :=
    (hg₁int.const_mul _).add (hg₂int.const_mul _)
  have hG : IntegrableOn (fun c : Euclid n => K * M * Bᶜ.indicator (fun _ => (1 : ℝ)) (b + r • c) +
      M * ‖J (b + r • c) - J b‖ + J b * ‖f (r⁻¹ • (F (b + r • c) - F b)) - f (L c)‖)
      (closedBall (0 : Euclid n) (R / m)) volume :=
    hG₁₂.add (hg₃int.const_mul _)
  rw [h1, h2, ← integral_sub hXint hYint]
  refine (norm_integral_le_of_norm_le hG (Eventually.of_forall hpt)).trans_eq ?_
  rw [integral_add hG₁₂ (hg₃int.const_mul _), integral_add (hg₁int.const_mul _) (hg₂int.const_mul _),
    integral_const_mul, integral_const_mul, integral_const_mul]
/-- **Rescaled integrals at a point of vanishing ball averages**: for `R > 0`, if
`⨍_{B̄_s(b)} h → 0` as `s → 0⁺`, then `∫_{B̄_R(0)} h(b + rc) dc → 0` as `r → 0⁺`.
For `r > 0`, dilation by `r` and translation by `b` give
`∫_{B̄_R(0)} h(b + rc) dc = r⁻ⁿ ∫_{B̄_{rR}(b)} h = ω Rⁿ ⨍_{B̄_{rR}(b)} h`, `ω = λ(B̄₁(0))`. -/
theorem Submission.pit_integral_closedBall_rescale_tendsto : ∀ (n : ℕ) (h : Euclid n → ℝ) (b : Euclid n) (R : ℝ), 0 < R → Tendsto (fun s : ℝ => ⨍ a in closedBall b s, h a ∂volume) (𝓝[>] 0) (𝓝 0) → Tendsto (fun r : ℝ => ∫ c in closedBall (0 : Euclid n) R, h (b + r • c) ∂volume) (𝓝[>] 0) (𝓝 0) := by
  intro n h b R hR hlim
  -- `ω = λ(B̄₁(0)) ∈ (0, ∞)` and `λ(B̄_s(z)) = sⁿ ω` for `s ≥ 0`
  set ω : ℝ := volume.real (closedBall (0 : Euclid n) 1) with hω_def
  have hω : 0 < ω := by
    rw [hω_def, measureReal_def]
    exact ENNReal.toReal_pos (measure_closedBall_pos volume 0 one_pos).ne'
      measure_closedBall_lt_top.ne
  have hvol : ∀ (z : Euclid n) {s : ℝ}, 0 ≤ s → volume.real (closedBall z s) = s ^ n * ω := by
    intro z s hs
    rw [Measure.addHaar_real_closedBall' volume z hs, finrank_euclideanSpace_fin]
  -- for `r > 0`: `∫_{B̄_R(0)} h(b + rc) dc = Rⁿ ω ⨍_{B̄_{rR}(b)} h`
  have key : ∀ r : ℝ, 0 < r → ∫ c in closedBall (0 : Euclid n) R, h (b + r • c) ∂volume =
      R ^ n * ω * ⨍ a in closedBall b (r * R), h a ∂volume := by
    intro r hr
    set H : Euclid n → ℝ := (closedBall b (r * R)).indicator h with hH
    have hmem : ∀ c : Euclid n, b + r • c ∈ closedBall b (r * R) ↔ c ∈ closedBall (0 : Euclid n) R := by
      intro c
      rw [mem_closedBall, mem_closedBall, dist_self_add_left, dist_zero_right, norm_smul,
        Real.norm_eq_abs, abs_of_pos hr, mul_le_mul_iff_of_pos_left hr]
    -- `1_{B̄_R(0)}(c) h(b + rc) = H(b + rc)`
    have h1 : ∫ c in closedBall (0 : Euclid n) R, h (b + r • c) ∂volume =
        ∫ c, H (b + r • c) ∂volume := by
      rw [← integral_indicator measurableSet_closedBall]
      congr 1
      ext c
      by_cases hc : c ∈ closedBall (0 : Euclid n) R
      · rw [indicator_of_mem hc, hH, indicator_of_mem ((hmem c).2 hc)]
      · rw [indicator_of_notMem hc, hH, indicator_of_notMem (mt (hmem c).1 hc)]
    -- dilation by `r` and translation by `b`
    have h2 : ∫ c, H (b + r • c) ∂volume = (r ^ n)⁻¹ * ∫ a in closedBall b (r * R), h a ∂volume := by
      rw [Measure.integral_comp_smul volume (fun x => H (b + x)) r, integral_add_left_eq_self H b,
        hH, integral_indicator measurableSet_closedBall, finrank_euclideanSpace_fin, smul_eq_mul,
        abs_of_pos (inv_pos.2 (pow_pos hr n))]
    have h3 : ⨍ a in closedBall b (r * R), h a ∂volume =
        ((r * R) ^ n * ω)⁻¹ * ∫ a in closedBall b (r * R), h a ∂volume := by
      rw [setAverage_eq, hvol b (mul_pos hr hR).le, smul_eq_mul]
    rw [h1, h2, h3, mul_pow]
    field_simp
  -- `r ↦ rR` maps `𝓝[>] 0` into `𝓝[>] 0`
  have hmap : Tendsto (fun r : ℝ => r * R) (𝓝[>] 0) (𝓝[>] 0) := by
    rw [tendsto_nhdsWithin_iff]
    refine ⟨?_, ?_⟩
    · have hc : Tendsto (fun r : ℝ => r * R) (𝓝 0) (𝓝 (0 * R)) :=
        (continuous_id.mul continuous_const).tendsto 0
      rw [zero_mul] at hc
      exact hc.mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with r hr
      exact mul_pos hr hR
  have hlim' := (hlim.comp hmap).const_mul (R ^ n * ω)
  rw [mul_zero] at hlim'
  refine hlim'.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with r hr
  exact (key r hr).symm

/-- **Rescaled integrals at a density point of `B` and a Lebesgue point of `J`**: let
`m|a − b| ≤ |F(a) − F(b)|` on `B`, `m|c| ≤ |Lc|` for `L = DF(b)`, `0 ≤ J ≤ K`, let `B` have
density `1` at `b` and `⨍_{B̄_ρ(b)} |J − J(b)| → 0`.  Then for `f ∈ C_c(ℝᴾ)`,
`∫ 1_B(b + rc) J(b + rc) f(r⁻¹(F(b + rc) − F(b))) dc → J(b) ∫ f(Lc) dc` as `r → 0⁺`.
With `f = 0` off `B_R(0)` and `|f| ≤ M`, the error is at most `K M T₁ + M T₂ + J(b) T₃`, where
`T₁, T₂, T₃` integrate `1_{Bᶜ}(b + rc)`, `|J(b + rc) − J(b)|` and
`|f(r⁻¹(F(b + rc) − F(b))) − f(Lc)|` over `B̄_{R/m}(0)`; each tends to `0`. -/
theorem Submission.pit_rescaled_integral_tendsto : ∀ (P n : ℕ) (F : Euclid n → Euclid P) (B : Set (Euclid n)) (J : Euclid n → ℝ) (K m : ℝ) (b : Euclid n) (f : Euclid P → ℝ), Continuous F → MeasurableSet B → Measurable J → (∀ a, 0 ≤ J a ∧ J a ≤ K) → 0 < m → (∀ a ∈ B, m * ‖a - b‖ ≤ ‖F a - F b‖) → DifferentiableAt ℝ F b → (∀ c, m * ‖c‖ ≤ ‖fderiv ℝ F b c‖) → Tendsto (fun ρ : ℝ => volume (B ∩ closedBall b ρ) / volume (closedBall b ρ)) (𝓝[>] 0) (𝓝 1) → Tendsto (fun ρ : ℝ => ⨍ a in closedBall b ρ, ‖J a - J b‖ ∂volume) (𝓝[>] 0) (𝓝 0) → Continuous f → HasCompactSupport f → Tendsto (fun r : ℝ => ∫ c, B.indicator J (b + r • c) * f (r⁻¹ • (F (b + r • c) - F b)) ∂volume) (𝓝[>] 0) (𝓝 (J b * ∫ c, f (fderiv ℝ F b c) ∂volume)) := by
  intro P n F B J K m b f hF hB hJ hJK hm hFB hdiff hL hdens hLeb hf hfc
  -- `f = 0` off `B_R(0)` and `|f| ≤ M`; the integrals live on `B̄_{R/m}(0)`
  obtain ⟨R, hR, hRf⟩ := hfc.exists_pos_le_norm
  obtain ⟨M, hM⟩ := hf.bounded_above_of_compact_support hfc
  have hRm : 0 < R / m := div_pos hR hm
  -- `T₁ → 0`: `B` has density `1` at `b`
  have hT₁ := Submission.pit_integral_closedBall_rescale_tendsto n
    (Bᶜ.indicator fun _ => (1 : ℝ)) b (R / m) hRm
    (Submission.pit_ril_compl_average_tendsto n B b hB hdens)
  -- `T₂ → 0`: `b` is a Lebesgue point of `J`
  have hT₂ := Submission.pit_integral_closedBall_rescale_tendsto n (fun a => ‖J a - J b‖) b
    (R / m) hRm hLeb
  -- `T₃ → 0`: `r⁻¹(F(b + rc) − F(b)) → Lc` uniformly on `B̄_{R/m}(0)`
  have hT₃ := Submission.pit_ril_diffQuot_integral_tendsto P n F (fderiv ℝ F b) b f (R / m)
    hdiff.hasFDerivAt hf hfc
  have hlim := ((hT₁.const_mul (K * M)).add (hT₂.const_mul M)).add (hT₃.const_mul (J b))
  simp only [mul_zero, add_zero] at hlim
  -- squeeze `|I(r) − J(b) ∫ f(Lc) dc| ≤ K M T₁(r) + M T₂(r) + J(b) T₃(r)` for `r > 0`
  rw [tendsto_iff_norm_sub_tendsto_zero]
  refine squeeze_zero' (Eventually.of_forall fun r => norm_nonneg _) ?_ hlim
  filter_upwards [self_mem_nhdsWithin] with r hr
  exact Submission.pit_ril_three_term_bound P n F (fderiv ℝ F b) B J K m b f R M r hF hB hJ hJK
    hm hFB hL hf hRf hM hr
/-- Integral over the range of a linear map with constant Jacobian: if `T : ℝⁿ → ℝᴾ` is linear
and `Hⁿ(T(S)) = j λ(S)` for every `S ⊆ ℝⁿ` (`j ≥ 0`, `λ` Lebesgue measure), then for continuous
`f`, `∫_{T(ℝⁿ)} f dHⁿ = j ∫ f(T(c)) dλ(c)`.  On Borel `A`, `A ∩ T(ℝⁿ) = T(T⁻¹(A))`, so
`Hⁿ⌞T(ℝⁿ) = j T_#λ`. -/
theorem Submission.pit_setIntegral_range_linear : ∀ (P n : ℕ) (T : Euclid n →L[ℝ] Euclid P) (j : ℝ) (f : Euclid P → ℝ), 0 ≤ j → (∀ S : Set (Euclid n), μHE[n] (T '' S) = ENNReal.ofReal j * volume S) → Continuous f → ∫ y in (LinearMap.range (T : Euclid n →ₗ[ℝ] Euclid P) : Set (Euclid P)), f y ∂μHE[n] = j * ∫ c, f (T c) ∂volume := by
  intro P n T j f hj hT hf
  -- the carrier of the submodule `range T` is the set `T(ℝⁿ)`
  have hrange : (LinearMap.range (T : Euclid n →ₗ[ℝ] Euclid P) : Set (Euclid P)) = range T := by
    rw [LinearMap.coe_range, ContinuousLinearMap.coe_coe]
  -- `Hⁿ⌞T(ℝⁿ) = ofReal(j) • T_#λ`, checked on Borel sets
  have hmeas : μHE[n].restrict (range T) = ENNReal.ofReal j • volume.map T := by
    ext A hA
    rw [Measure.restrict_apply hA, Measure.smul_apply, Measure.map_apply T.measurable hA,
      ← image_preimage_eq_inter_range, hT, smul_eq_mul]
  -- change of variables, with `(ofReal j).toReal = j` since `j ≥ 0`
  rw [hrange, hmeas, integral_smul_measure,
    integral_map T.measurable.aemeasurable hf.aestronglyMeasurable,
    ENNReal.toReal_ofReal hj, smul_eq_mul]
/-- **Simon Ch. 3, 1.4** (approximate tangent spaces of a bi-Lipschitz piece): let `F : ℝⁿ → ℝᴾ`
be `L`-Lipschitz, `B ⊆ ℝⁿ` Borel and `m > 0` with `m|a − a'| ≤ |F a − F a'|` on `B`, and let `F`
be differentiable at every point of `B` with injective derivative.  Then for a.e. `b ∈ B`,
`F(B)` has approximate tangent space `range DF(b)` at `F b`.
With `J := normDet DF` (Borel, `0 ≤ J ≤ Lⁿ`) the injective area formula holds on `B`.  A.e.
`b ∈ B` is a density point of `B` and a Lebesgue point of `J`; there
`∫_{η_{F b,r}(F(B))} f dHⁿ = ∫ 1_B J(b + rc) f(r⁻¹(F(b + rc) − F b)) dc` tends to
`J(b) ∫ f(DF(b)c) dc = ∫_{range DF(b)} f dHⁿ` as `r ↓ 0`. -/
theorem Submission.ptd_piece_image_approxTangent_ae : ∀ (P n : ℕ) (F : Euclid n → Euclid P) (B : Set (Euclid n)) (L : NNReal) (m : ℝ), LipschitzWith L F → MeasurableSet B → 0 < m → (∀ a ∈ B, ∀ a' ∈ B, m * ‖a - a'‖ ≤ ‖F a - F a'‖) → (∀ a ∈ B, DifferentiableAt ℝ F a ∧ Injective (fderiv ℝ F a)) → ∀ᵐ b ∂(volume.restrict B), HasApproximateTangentSpaceAt n (F '' B) (F b) (LinearMap.range (fderiv ℝ F b : Euclid n →ₗ[ℝ] Euclid P)) := by
  intro P n F B L m hF hB hm hcolip hreg
  have hfin : Module.finrank ℝ (Euclid n) = n := finrank_euclideanSpace_fin
  -- the area Jacobian `J = normDet DF`
  obtain ⟨J, hJ⟩ : ∃ J : Euclid n → ℝ, J = Poincare.SimonGMT.Chapter02.areaJacobianAt F :=
    ⟨_, rfl⟩
  have hJmeas : Measurable J := hJ ▸ Poincare.SimonGMT.Chapter02.measurable_areaJacobianAt F
  have hJnonneg : ∀ a, 0 ≤ J a := hJ ▸ Poincare.SimonGMT.Chapter02.areaJacobianAt_nonneg F
  -- `Hⁿ(T(S)) = normDet T · λ(S)` for every linear `T`
  have hlin : ∀ (T : Euclid n →L[ℝ] Euclid P) (S : Set (Euclid n)),
      μHE[n] (T '' S) = ENNReal.ofReal (T : Euclid n →ₗ[ℝ] Euclid P).normDet * volume S := by
    intro T S
    have h := LinearMap.euclideanHausdorffMeasure_image_eq_normDet_mul_volume
      (T : Euclid n →ₗ[ℝ] Euclid P) S
    rw [hfin] at h
    simpa using h
  have hJlin : ∀ a (S : Set (Euclid n)),
      μHE[n] (fderiv ℝ F a '' S) = ENNReal.ofReal (J a) * volume S := by
    intro a S
    rw [hlin, hJ, Poincare.SimonGMT.Chapter02.areaJacobianAt_eq_normDet]
  -- `J ≤ Lⁿ`: compare `Hⁿ(DF(a)(B̄₁(0)))` with the Lipschitz bound `‖DF(a)‖ ≤ L`
  have hJle : ∀ a, J a ≤ (L : ℝ) ^ n := by
    intro a
    have hTL : ‖fderiv ℝ F a‖₊ ≤ L := by
      have h := norm_fderiv_le_of_lipschitz ℝ (x₀ := a) hF
      exact_mod_cast h
    have hpos : volume (closedBall (0 : Euclid n) 1) ≠ 0 :=
      (measure_closedBall_pos volume (0 : Euclid n) one_pos).ne'
    have hfin' : volume (closedBall (0 : Euclid n) 1) ≠ ∞ := measure_closedBall_lt_top.ne
    have hle : ENNReal.ofReal (J a) * volume (closedBall (0 : Euclid n) 1) ≤
        (L : ℝ≥0∞) ^ n * volume (closedBall (0 : Euclid n) 1) := by
      rw [← hJlin a, ← EuclideanSpace.euclideanHausdorffMeasure_eq_volume n]
      calc μHE[n] (fderiv ℝ F a '' closedBall 0 1)
          ≤ (‖fderiv ℝ F a‖₊ : ℝ≥0∞) ^ n * μHE[n] (closedBall (0 : Euclid n) 1) :=
            Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
              (fderiv ℝ F a).lipschitzWith.lipschitzOnWith
        _ ≤ (L : ℝ≥0∞) ^ n * μHE[n] (closedBall (0 : Euclid n) 1) := by gcongr
    have h2 : ENNReal.ofReal (J a) ≤ (L : ℝ≥0∞) ^ n :=
      (ENNReal.mul_le_mul_iff_left hpos hfin').1 hle
    rw [← ENNReal.ofReal_le_ofReal_iff (by positivity), ENNReal.ofReal_pow L.coe_nonneg,
      ENNReal.ofReal_coe_nnreal]
    exact h2
  -- `F` is injective on `B`, so the area formula holds on `B` with weight `J`
  have hinjOn : InjOn F B := by
    intro a ha a' ha' hFa
    have h := hcolip a ha a' ha'
    rw [hFa, sub_self, norm_zero] at h
    have h' : ‖a - a'‖ ≤ 0 := le_of_mul_le_mul_left (by simpa using h) hm
    exact sub_eq_zero.1 (norm_le_zero_iff.1 h')
  have harea : ∀ g : Euclid P → ℝ≥0∞,
      ∫⁻ y in F '' B, g y ∂μHE[n] = ∫⁻ x in B, ENNReal.ofReal (J x) * g (F x) ∂volume := by
    intro g
    have h := Poincare.SimonGMT.Chapter02.weighted_area_formula_lipschitz_injOn hF hB hinjOn g
    rw [hfin] at h
    rw [h, hJ]
  -- `J` is bounded and Borel, hence locally integrable
  have hJloc : LocallyIntegrable J volume := by
    rw [locallyIntegrable_iff]
    intro k hk
    refine Measure.integrableOn_of_bounded hk.measure_lt_top.ne hJmeas.aestronglyMeasurable
      (M := (L : ℝ) ^ n) (Eventually.of_forall fun a => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (hJnonneg a)]
    exact hJle a
  -- a.e. `b ∈ B` is a density point of `B` and a Lebesgue point of `J`
  have hleb := IsUnifLocDoublingMeasure.ae_tendsto_average_norm_sub (volume : Measure (Euclid n))
    hJloc 1
  filter_upwards [ae_restrict_mem hB, Besicovitch.ae_tendsto_measure_inter_div volume B,
    ae_restrict_of_ae hleb] with b hbB hα hβ
  have hβ' : Tendsto (fun ρ : ℝ => ⨍ a in closedBall b ρ, ‖J a - J b‖ ∂volume) (𝓝[>] 0) (𝓝 0) :=
    hβ (fun _ => b) id tendsto_id (eventually_nhdsWithin_of_forall fun ρ (hρ : 0 < ρ) =>
      mem_closedBall_self (by simpa using hρ.le))
  obtain ⟨hdb, hinj⟩ := hreg b hbB
  have hcolb : ∀ a ∈ B, m * ‖a - b‖ ≤ ‖F a - F b‖ := fun a ha => hcolip a ha b hbB
  have hγ : ∀ c, m * ‖c‖ ≤ ‖fderiv ℝ F b c‖ :=
    Submission.pit_fderiv_lower_bound_of_density P n F B m b hm hcolb hdb hα
  refine ⟨?_, fun f => ?_⟩
  · rw [LinearMap.finrank_range_of_inj (by simpa using hinj), hfin]
  · rw [Submission.pit_setIntegral_range_linear P n (fderiv ℝ F b) (J b) f (hJnonneg b)
      (hJlin b) f.continuous]
    refine (Submission.pit_rescaled_integral_tendsto P n F B J ((L : ℝ) ^ n) m b f hF.continuous
      hB hJmeas (fun a => ⟨hJnonneg a, hJle a⟩) hm hcolb hdb hγ hα hβ' f.continuous
      f.hasCompactSupport).congr' ?_
    filter_upwards [self_mem_nhdsWithin] with r hr
    exact (Submission.pit_blowUp_image_setIntegral_eq_rescaled P n F B J b r f hF.continuous hB
      hJmeas hJnonneg harea hr f.continuous).symm

/-- **Simon Ch. 3, proof of Theorem 1.6 "⇒"**, for a bi-Lipschitz piece: let `U` be open,
`Y ⊆ U` Borel with `Hⁿ(Y ∩ C) < ∞` for compact `C ⊆ U`, `F` Lipschitz, `B` Borel with
`m|a − a'| ≤ |F(a) − F(a')|` on `B`, `DF(a)` injective for `a ∈ B`, and `F(B) ⊆ Y`.  Then for
a.e. `b ∈ B`, `Y` has approximate tangent space `range DF(b)` at `F(b)`.  The image `F(B)` itself
has this tangent space at `F(b)` for a.e. `b`; `Y` and its Borel subset `F(B)` have the same
approximate tangent spaces `Hⁿ`-a.e. on `F(B)`; and `Hⁿ⌞F(B)`-null sets pull back along `F` to
Lebesgue-null subsets of `B`. -/
theorem Submission.dpf_approxTangent_ae_bilipschitz_piece : ∀ (P n : ℕ) (U Y : Set (Euclid P)) (F : Euclid n → Euclid P) (B : Set (Euclid n)) (L : NNReal) (m : ℝ), IsOpen U → MeasurableSet Y → Y ⊆ U → (∀ C : Set (Euclid P), IsCompact C → C ⊆ U → μHE[n] (Y ∩ C) ≠ ∞) → LipschitzWith L F → MeasurableSet B → 0 < m → (∀ a ∈ B, ∀ a' ∈ B, m * ‖a - a'‖ ≤ ‖F a - F a'‖) → (∀ a ∈ B, DifferentiableAt ℝ F a ∧ Injective (fderiv ℝ F a)) → F '' B ⊆ Y → ∀ᵐ b ∂(volume.restrict B), HasApproximateTangentSpaceAt n Y (F b) (LinearMap.range (fderiv ℝ F b : Euclid n →ₗ[ℝ] Euclid P)) := by
  intro P n U Y F B L m hU hY hYU hfin hF hB hm hbi hdiff hFBY
  -- Step 0(a)–(b): `F(B)` is Borel; `Hⁿ⌞F(B)`-a.e. properties hold at `F(b)` for a.e. `b ∈ B`
  obtain ⟨hA, hpull⟩ := Submission.ptd_piece_image_measurable_ae_pullback P n F B L m hF hB hm hbi
  -- Steps 1–3 and 6: `Hⁿ`-a.e. on `F(B)`, `Y` and `F(B)` have the same approximate tangent spaces
  have hloc := Submission.ptd_ae_approxTangent_iff_of_subset P n U (F '' B) Y hU hA hY hFBY hYU hfin
  -- Steps 4, 5 and 7: `F(B)` has approximate tangent space `range DF(b)` at `F(b)` for a.e. `b ∈ B`
  filter_upwards [hpull _ hloc,
    Submission.ptd_piece_image_approxTangent_ae P n F B L m hF hB hm hbi hdiff] with b hYA hA'
  exact (hYA _).2 hA'
/-- **Markov selection of a good parameter** (Simon, Ch. 6, proof of 5.1, (10): a slicing radius
in `(σ/2, σ)`).  If `g : ℝ → [0, ∞]` is a.e.-measurable, `p` holds for a.e. `t`, `a < b` and
`∫_{(a,b)} g ≤ I`, then some `t ∈ (a, b)` has `p t` and `(b − a) g(t) ≤ 2I`.  Otherwise
`2I < (b − a) g` a.e. on `(a, b)`, which is impossible for `I = ∞` as `(a, b)` is not null; for
`I < ∞` integration gives `2I(b − a) ≤ (b − a)I`, so `I = 0`, whence `g = 0` a.e. on `(a, b)`,
contradicting `0 < (b − a) g` a.e. there. -/
theorem Submission.dor_lmb_fcd_sd_markov_point : ∀ (g : ℝ → ℝ≥0∞) (p : ℝ → Prop) (a b : ℝ) (I : ℝ≥0∞), a < b → AEMeasurable g → (∀ᵐ t, p t) → ∫⁻ t in Ioo a b, g t ≤ I → ∃ t ∈ Ioo a b, p t ∧ ENNReal.ofReal (b - a) * g t ≤ 2 * I := by
  intro g p a b I hab hg hp hI
  set c : ℝ≥0∞ := ENNReal.ofReal (b - a) with hc
  have hc0 : c ≠ 0 := by simpa [hc] using hab
  have hctop : c ≠ ∞ := ENNReal.ofReal_ne_top
  have hvol : volume (Ioo a b) = c := Real.volume_Ioo
  -- Step 1: otherwise `2I < c g(t)` for every `t ∈ (a, b)` with `p t`
  by_contra hcon
  have hbad : ∀ t ∈ Ioo a b, p t → 2 * I < c * g t := fun t ht hpt =>
    not_le.1 fun hle => hcon ⟨t, ht, hpt, hle⟩
  -- Step 2: `2I < c g` almost everywhere on `(a, b)`
  have hae : ∀ᵐ t ∂(volume.restrict (Ioo a b)), 2 * I < c * g t := by
    rw [ae_restrict_iff' measurableSet_Ioo]
    filter_upwards [hp] with t ht htI
    exact hbad t htI ht
  -- Step 3: `(a, b)` is not null
  have hnull : ¬ ∀ᵐ _t ∂(volume.restrict (Ioo a b)), False := by
    intro h
    have h0 : volume.restrict (Ioo a b) = 0 := ae_eq_bot.1 (eventually_false_iff_eq_bot.1 h)
    rw [Measure.restrict_eq_zero, hvol] at h0
    exact hc0 h0
  rcases eq_or_ne I ∞ with hItop | hItop
  · -- Step 4: `I = ∞`
    apply hnull
    filter_upwards [hae] with t ht
    rw [hItop] at ht
    simp at ht
  · -- Step 5: `I < ∞` forces `I = 0`
    have h1 : ∫⁻ _t in Ioo a b, 2 * I ≤ ∫⁻ t in Ioo a b, c * g t :=
      lintegral_mono_ae (hae.mono fun t ht => ht.le)
    rw [setLIntegral_const, lintegral_const_mul'' _ hg.restrict, hvol] at h1
    have h2 : 2 * I * c ≤ I * c :=
      calc 2 * I * c ≤ c * ∫⁻ t in Ioo a b, g t := h1
        _ ≤ c * I := by gcongr
        _ = I * c := mul_comm c I
    have h3 : 2 * I ≤ I := (ENNReal.mul_le_mul_iff_left hc0 hctop).1 h2
    have hI0 : I = 0 := by
      have h4 : I + I ≤ 0 + I := by rw [zero_add, ← two_mul]; exact h3
      exact nonpos_iff_eq_zero.1 (ENNReal.le_of_add_le_add_right hItop h4)
    -- Step 6: `g = 0` a.e. on `(a, b)` contradicts `0 < c g` a.e.
    have hg0 : ∀ᵐ t ∂(volume.restrict (Ioo a b)), g t = 0 :=
      (lintegral_eq_zero_iff' hg.restrict).1 (nonpos_iff_eq_zero.1 (hI.trans hI0.le))
    apply hnull
    filter_upwards [hae, hg0] with t ht ht0
    rw [hI0, ht0] at ht
    simp at ht
/-- **Faces of the unit cubical lattice** (Simon Ch. 6, §5: the `n`-faces `F ∈ 𝓛ₙ` used in the proof
of the deformation theorem 5.1).  Let `n = m + 1` and `p = (z, ι)` with `ι : Fin n → Fin P` strictly
increasing.  The map `Φ_p(y) = z + Σⱼ yⱼ e_{ι(j)}` has coordinates `z_{ι(k)} + y_k` at `ι(k)` and
`zᵢ` off `range ι`, so it is an isometric embedding `ℝⁿ → ℝᴾ` with `Φ_p⁻¹(F_p) = [0, 1]ⁿ` and
`F_p ⊆ range Φ_p`.  As `μHE[n] = volume` on `ℝⁿ`, `Φ_p#μHE[n] = μHE[n]⌞range Φ_p` and `∂[0, 1]ⁿ` is
Lebesgue-null, `Hⁿ⌞F_p = Φ_p#(Lⁿ⌞(0, 1)ⁿ)`; hence `Hⁿ(F_p) = 1` and
`∫_{F_p} f dHⁿ = ∫_{(0, 1)ⁿ} f ∘ Φ_p`.  `F_p` is closed with diameter `≤ √P`, and the non-integer
coordinates of a point of `Φ_p((0, 1)ⁿ)` determine `ι` and `z`, so it lies in no other face
`F_q`. -/
theorem Submission.dor_lmb_fcd_fr_face_geometry : ∀ (P m : ℕ) (p : (Fin P → ℤ) × (Fin (m + 1) → Fin P)), StrictMono p.2 → volume {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} = 1 ∧ μHE[m + 1] {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)} = 1 ∧ (μHE[m + 1] : Measure (Euclid P)).restrict {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)} = Measure.map (fun y : Euclid (m + 1) => WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (volume.restrict {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}) ∧ (∀ f : Euclid P → ℝ, ∫ x in {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)}, f x ∂μHE[m + 1] = ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, f (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ))) ∧ (∀ y : Euclid (m + 1), (∀ i, 0 ≤ y i ∧ y i ≤ 1) → WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ) ∈ {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)}) ∧ (∀ y y' : Euclid (m + 1), dist (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y' j • EuclideanSpace.single (p.2 j) (1 : ℝ)) = dist y y') ∧ (∀ x ∈ {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)}, ∀ x' ∈ {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)}, dist x x' ≤ Real.sqrt P) ∧ IsClosed {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)} ∧ ∀ q : (Fin P → ℤ) × (Fin (m + 1) → Fin P), StrictMono q.2 → q ≠ p → ∀ y : Euclid (m + 1), (∀ i, 0 < y i ∧ y i < 1) → WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ) ∉ {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range q.2 → (q.1 i : ℝ) ≤ x i ∧ x i ≤ q.1 i + 1) ∧ (i ∉ Set.range q.2 → x i = q.1 i)} := by
  intro P m p hp
  -- the face map `Φ = Φ_p`, the closed face `F = F_p`, the open cube `Q = Q₁`, the closed cube `C`
  let Φ : Euclid (m + 1) → Euclid P := fun y =>
    WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)
  let F : Set (Euclid P) := {x : Euclid P | ∀ i : Fin P,
    (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)}
  let Q : Set (Euclid (m + 1)) := {y | ∀ i, 0 < y i ∧ y i < 1}
  let C : Set (Euclid (m + 1)) := {y | ∀ i, 0 ≤ y i ∧ y i ≤ 1}
  show volume Q = 1 ∧ μHE[m + 1] F = 1 ∧
    (μHE[m + 1] : Measure (Euclid P)).restrict F = Measure.map Φ (volume.restrict Q) ∧
    (∀ f : Euclid P → ℝ, ∫ x in F, f x ∂μHE[m + 1] = ∫ y in Q, f (Φ y)) ∧
    (∀ y : Euclid (m + 1), (∀ i, 0 ≤ y i ∧ y i ≤ 1) → Φ y ∈ F) ∧
    (∀ y y' : Euclid (m + 1), dist (Φ y) (Φ y') = dist y y') ∧
    (∀ x ∈ F, ∀ x' ∈ F, dist x x' ≤ Real.sqrt P) ∧ IsClosed F ∧
    ∀ q : (Fin P → ℤ) × (Fin (m + 1) → Fin P), StrictMono q.2 → q ≠ p →
      ∀ y : Euclid (m + 1), (∀ i, 0 < y i ∧ y i < 1) → Φ y ∉ {x : Euclid P | ∀ i : Fin P,
        (i ∈ Set.range q.2 → (q.1 i : ℝ) ≤ x i ∧ x i ≤ q.1 i + 1) ∧
          (i ∉ Set.range q.2 → x i = q.1 i)}
  have hinj : Injective p.2 := hp.injective
  -- Step 1: coordinates of `Φ`
  have hcoord : ∀ y i, Φ y i = p.1 i + ∑ j, if i = p.2 j then y j else 0 := by
    intro y i
    simp [Φ, Pi.single_apply]
  have hcoord_mem : ∀ y k, Φ y (p.2 k) = p.1 (p.2 k) + y k := by
    intro y k
    rw [hcoord]
    simp [hinj.eq_iff]
  have hcoord_nmem : ∀ y i, i ∉ range p.2 → Φ y i = p.1 i := by
    intro y i hi
    rw [hcoord, add_eq_left]
    exact Finset.sum_eq_zero fun j _ => ite_eq_right fun h => hi ⟨j, h.symm⟩
  -- Step 2: `Φ` is an isometry, hence a measurable embedding
  have hdist : ∀ y y' : Euclid (m + 1), dist (Φ y) (Φ y') = dist y y' := by
    intro y y'
    rw [EuclideanSpace.dist_eq, EuclideanSpace.dist_eq]
    congr 1
    symm
    refine Fintype.sum_of_injective p.2 hinj _ _ (fun i hi => ?_) (fun k => ?_)
    · rw [hcoord_nmem y i hi, hcoord_nmem y' i hi, dist_self]
      simp
    · rw [hcoord_mem, hcoord_mem, dist_add_left]
  have hiso : Isometry Φ := Isometry.of_dist_eq hdist
  have hemb : MeasurableEmbedding Φ := hiso.isClosedEmbedding.measurableEmbedding
  -- Step 3: `Φ` maps the closed cube `C` into `F`, `F ⊆ range Φ` and `Φ⁻¹(F) = C`
  have hCF : ∀ y : Euclid (m + 1), (∀ i, 0 ≤ y i ∧ y i ≤ 1) → Φ y ∈ F := by
    intro y hy i
    constructor
    · rintro ⟨k, rfl⟩
      rw [hcoord_mem]
      constructor <;> linarith [(hy k).1, (hy k).2]
    · exact hcoord_nmem y i
  have hFrange : F ⊆ range Φ := by
    intro x hx
    refine ⟨WithLp.toLp 2 fun k => x (p.2 k) - p.1 (p.2 k), PiLp.ext fun i => ?_⟩
    by_cases hi : i ∈ range p.2
    · obtain ⟨k, rfl⟩ := hi
      rw [hcoord_mem]
      simp
    · rw [hcoord_nmem _ i hi]
      exact ((hx i).2 hi).symm
  have hpreF : Φ ⁻¹' F = C := by
    ext y
    refine ⟨fun hy k => ?_, hCF y⟩
    have h := (hy (p.2 k)).1 ⟨k, rfl⟩
    rw [hcoord_mem] at h
    constructor <;> linarith [h.1, h.2]
  -- Step 4: `volume Q = volume C = 1`
  have hvol := PiLp.volume_preserving_ofLp (Fin (m + 1))
  have hQ_eq : Q = WithLp.ofLp ⁻¹' (Set.univ.pi fun _ : Fin (m + 1) => Set.Ioo (0 : ℝ) 1) := by
    ext y
    simp [Q, Set.mem_pi]
  have hC_eq : C = WithLp.ofLp ⁻¹' (Set.Icc (0 : Fin (m + 1) → ℝ) 1) := by
    ext y
    simp [C, Pi.le_def, forall_and]
  have hQmeas : MeasurableSet Q := by
    rw [hQ_eq]
    exact hvol.measurable (MeasurableSet.univ_pi fun _ => measurableSet_Ioo)
  have hvolQ : volume Q = 1 := by
    rw [hQ_eq, hvol.measure_preimage
      (MeasurableSet.univ_pi fun _ => measurableSet_Ioo).nullMeasurableSet, Real.volume_pi_Ioo]
    simp
  have hvolC : volume C = 1 := by
    rw [hC_eq, hvol.measure_preimage measurableSet_Icc.nullMeasurableSet, Real.volume_Icc_pi]
    simp
  have hQC : volume.restrict C = volume.restrict Q := by
    refine (Measure.restrict_congr_set ?_).symm
    refine ae_eq_of_subset_of_measure_ge (fun y hy i => ⟨(hy i).1.le, (hy i).2.le⟩)
      (hvolC.trans hvolQ.symm).le hQmeas.nullMeasurableSet ?_
    rw [hvolC]
    exact ENNReal.one_ne_top
  -- Step 5: `F` is closed
  have hcont : ∀ i : Fin P, Continuous fun x : Euclid P => x i := fun i =>
    PiLp.continuous_apply 2 _ i
  have hFclosed : IsClosed F := by
    have hF : F = ⋂ i : Fin P, {x : Euclid P | (i ∈ Set.range p.2 →
        (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)} :=
      Set.ofPred_forall _
    rw [hF]
    refine isClosed_iInter fun i =>
      (isClosed_imp isOpen_const ?_).inter (isClosed_imp isOpen_const ?_)
    · exact (isClosed_le continuous_const (hcont i)).inter (isClosed_le (hcont i) continuous_const)
    · exact isClosed_eq (hcont i) continuous_const
  have hFmeas : MeasurableSet F := hFclosed.measurableSet
  -- Step 6: `Hⁿ⌞F = Φ#(volume⌞Q)`
  have hmeas :
      (μHE[m + 1] : Measure (Euclid P)).restrict F = Measure.map Φ (volume.restrict Q) := by
    have h1 : Measure.map Φ (volume : Measure (Euclid (m + 1))) =
        (μHE[m + 1] : Measure (Euclid P)).restrict (range Φ) := by
      rw [← hiso.map_euclideanHausdorffMeasure, EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
    rw [← hQC, ← hpreF, ← hemb.restrict_map, h1, Measure.restrict_restrict hFmeas,
      inter_eq_left.2 hFrange]
  -- Step 7: `Hⁿ(F) = 1`
  have hFmass : μHE[m + 1] F = 1 := by
    have h := congrArg (fun μ : Measure (Euclid P) => μ univ) hmeas
    simp only [Measure.restrict_apply_univ] at h
    rw [h, hemb.map_apply, preimage_univ, Measure.restrict_apply_univ, hvolQ]
  refine ⟨hvolQ, hFmass, hmeas, fun f => ?_, hCF, hdist, ?_, hFclosed, ?_⟩
  -- Step 8: the integral formula
  · rw [hmeas, hemb.integral_map]
  -- Step 9: `diam F ≤ √P`
  · intro x hx x' hx'
    rw [EuclideanSpace.dist_eq]
    refine Real.sqrt_le_sqrt ?_
    calc ∑ i, dist (x i) (x' i) ^ 2 ≤ ∑ _i : Fin P, (1 : ℝ) := by
          refine Finset.sum_le_sum fun i _ => pow_le_one₀ dist_nonneg ?_
          by_cases hi : i ∈ range p.2
          · have h := (hx i).1 hi
            have h' := (hx' i).1 hi
            rw [Real.dist_eq, abs_le]
            constructor <;> linarith [h.1, h.2, h'.1, h'.2]
          · rw [(hx i).2 hi, (hx' i).2 hi, dist_self]
            exact zero_le_one
      _ = P := by simp
  -- Step 10: the open face `Φ(Q)` meets no other closed face
  · intro q hq hqp y hy hx
    apply hqp
    have hsub : range p.2 ⊆ range q.2 := by
      rintro _ ⟨k, rfl⟩
      by_contra hk
      have h := (hx (p.2 k)).2 hk
      rw [hcoord_mem] at h
      have a1 : (p.1 (p.2 k) : ℝ) < q.1 (p.2 k) := by linarith [(hy k).1]
      have a2 : (q.1 (p.2 k) : ℝ) < p.1 (p.2 k) + 1 := by linarith [(hy k).2]
      have b1 : p.1 (p.2 k) < q.1 (p.2 k) := by exact_mod_cast a1
      have b2 : q.1 (p.2 k) < p.1 (p.2 k) + 1 := by exact_mod_cast a2
      omega
    have hrange : range p.2 = range q.2 := by
      apply Set.eq_of_subset_of_card_le hsub
      rw [Set.card_range_of_injective hq.injective, Set.card_range_of_injective hinj]
    have h2 : p.2 = q.2 := (hp.range_inj_of_wellFoundedLT hq).1 hrange
    have h1 : p.1 = q.1 := by
      funext i
      by_cases hi : i ∈ range p.2
      · obtain ⟨k, rfl⟩ := hi
        have h := (hx (p.2 k)).1 (hrange ▸ ⟨k, rfl⟩)
        rw [hcoord_mem] at h
        have a1 : (q.1 (p.2 k) : ℝ) < p.1 (p.2 k) + 1 := by linarith [h.1, (hy k).2]
        have a2 : (p.1 (p.2 k) : ℝ) < q.1 (p.2 k) + 1 := by linarith [h.2, (hy k).1]
        have b1 : q.1 (p.2 k) < p.1 (p.2 k) + 1 := by exact_mod_cast a1
        have b2 : p.1 (p.2 k) < q.1 (p.2 k) + 1 := by exact_mod_cast a2
        omega
      · have h : (p.1 i : ℝ) = q.1 i := by
          rw [← hcoord_nmem y i hi]
          exact (hx i).2 (hrange ▸ hi)
        exact_mod_cast h
    exact Prod.ext h1.symm h2.symm

/-- **The `(m + 1)`-cells of the unit cubical lattice meeting a compact set** (Simon Ch. 6, proof
of the deformation theorem 5.1, (26)–(33), with `n = m + 1`).  `L_n` is the set of points of `ℝᴾ`
with at least `P − n` integer coordinates, `L_{n−1}` the set of those with at least `P − m`.
(0) `Hⁿ(L_{n−1}) = 0`: `L_{n−1}` lies in the countably many coordinate planes
`A(t, z) = {x : xᵢ = zᵢ, i ∈ t}`, `P ≤ m + |t|`, each the Lipschitz image of a space of dimension
`P − |t| < m + 1`.
(1) `L_n` is a finite union of finite intersections of the closed sets `{x : xᵢ ∈ ℤ}`.
(2) The faces `F_p` meeting the bounded set `K` have bounded integer corners, so they are finitely
many, and (3) by `diam F_p ≤ √P` they lie in the closed `√P`-neighbourhood of `K`.
(4) A point `x ∈ (L_n ∩ K) \ L_{n−1}` has exactly `n` non-integer coordinates; with `ι` their
increasing enumeration and `y` their fractional parts, `x = Φ_{(⌊x⌋, ι)}(y)`, `y ∈ Q₁`, and
`(⌊x⌋, ι)` is a face meeting `K`.  (5) By (0) this covers `Hⁿ`-a.e. point of `L_n ∩ K`. -/
theorem Submission.dor_lmb_fcd_fr_skeleton_cells : ∀ (P m : ℕ) (K : Set (Euclid P)), m + 1 < P → IsCompact K → ∃ s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P)), (∀ p ∈ s, StrictMono p.2) ∧ (∀ p ∈ s, {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧ (i ∉ Set.range p.2 → x i = p.1 i)} ⊆ cthickening (Real.sqrt P) K) ∧ IsClosed {x : Euclid P | ∃ t : Finset (Fin P), P ≤ m + 1 + t.card ∧ ∀ i ∈ t, ∃ z : ℤ, x i = z} ∧ ∀ᵐ x ∂(μHE[m + 1].restrict ({x : Euclid P | ∃ t : Finset (Fin P), P ≤ m + 1 + t.card ∧ ∀ i ∈ t, ∃ z : ℤ, x i = z} ∩ K)), ∃ p ∈ s, ∃ y : Euclid (m + 1), (∀ i, 0 < y i ∧ y i < 1) ∧ WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ) = x := by
  intro P m K hmP hK
  -- Step 0: `Hⁿ(L_{n−1}) = 0`, i.e. the points with at least `P − m` integer coordinates are
  -- `μHE[m + 1]`-null
  have hnull : μHE[m + 1] {x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + s.card ∧
      ∀ i ∈ s, ∃ z : ℤ, x i = z} = 0 := by
    -- each coordinate plane `A(s, z)` with `P ≤ m + |s|` is `μH[m + 1]`-null
    have hplane : ∀ s : Finset (Fin P), P ≤ m + s.card → ∀ z : Fin P → ℤ,
        μH[((m + 1 : ℕ) : ℝ)] {x : Euclid P | ∀ i ∈ s, x i = z i} = 0 := by
      intro s hs z
      -- `A(s, z)` is the image of the Lipschitz map `g : t ↦ (zᵢ on s, tᵢ off s)`
      let g : ({i // i ∉ s} → ℝ) → Euclid P := fun t =>
        WithLp.toLp 2 fun i => if h : i ∈ s then (z i : ℝ) else t ⟨i, h⟩
      have hg1 : LipschitzWith 1 fun t : {i // i ∉ s} → ℝ =>
          fun i : Fin P => if h : i ∈ s then (z i : ℝ) else t ⟨i, h⟩ := by
        refine LipschitzWith.of_dist_le_mul fun t t' => ?_
        rw [NNReal.coe_one, one_mul]
        refine (dist_pi_le_iff dist_nonneg).2 fun i => ?_
        by_cases h : i ∈ s
        · simp [h]
        · simpa [h] using dist_le_pi_dist t t' ⟨i, h⟩
      have hg : LipschitzWith _ g := (PiLp.lipschitzWith_toLp 2 fun _ : Fin P => ℝ).comp hg1
      have hsub : {x : Euclid P | ∀ i ∈ s, x i = z i} ⊆ g '' univ := by
        intro x hx
        refine ⟨fun j => x j.1, mem_univ _, ?_⟩
        ext i
        by_cases h : i ∈ s
        · simp [g, h, hx i h]
        · simp [g, h]
      -- the source of `g` has dimension `P − |s| ≤ m < m + 1`, so it is `μH[m + 1]`-null
      have hcard : Fintype.card {i // i ∉ s} ≤ m := by
        rw [Fintype.card_subtype_compl, Fintype.card_coe, Fintype.card_fin]
        omega
      have huniv : (μH[((m + 1 : ℕ) : ℝ)] : Measure ({i // i ∉ s} → ℝ)) univ = 0 := by
        rw [← Metric.iUnion_ball_nat (0 : {i // i ∉ s} → ℝ)]
        refine measure_iUnion_null fun n => ?_
        refine (Measure.hausdorffMeasure_zero_or_top
          (d₁ := (Fintype.card {i // i ∉ s} : ℝ)) ?_ _).resolve_right ?_
        · exact_mod_cast Nat.lt_succ_of_le hcard
        · rw [hausdorffMeasure_pi_real]
          exact measure_ball_lt_top.ne
      refine measure_mono_null hsub (nonpos_iff_eq_zero.1 ?_)
      calc μH[((m + 1 : ℕ) : ℝ)] (g '' univ)
          ≤ _ ^ ((m + 1 : ℕ) : ℝ) * μH[((m + 1 : ℕ) : ℝ)] (univ : Set ({i // i ∉ s} → ℝ)) :=
            hg.hausdorffMeasure_image_le (Nat.cast_nonneg _) univ
        _ = 0 := by rw [huniv, mul_zero]
    -- the set is covered by the countably many planes `A(s, z)`, `P ≤ m + |s|`, `z ∈ ℤᴾ`
    have hcover : {x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + s.card ∧
        ∀ i ∈ s, ∃ z : ℤ, x i = z} ⊆ ⋃ (s : {s : Finset (Fin P) // P ≤ m + s.card})
          (z : Fin P → ℤ), {x : Euclid P | ∀ i ∈ s.1, x i = z i} := by
      rintro x ⟨s, hs, hx⟩
      choose! z hz using hx
      exact mem_iUnion₂.2 ⟨⟨s, hs⟩, z, hz⟩
    -- countable subadditivity gives `μH[m + 1]`-nullity, and `μHE[m + 1] = c • μH[m + 1]`
    have hnullH : μH[((m + 1 : ℕ) : ℝ)] {x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + s.card ∧
        ∀ i ∈ s, ∃ z : ℤ, x i = z} = 0 :=
      measure_mono_null hcover
        (measure_iUnion_null fun s => measure_iUnion_null fun z => hplane s.1 s.2 z)
    rw [Measure.euclideanHausdorffMeasure_def, Measure.smul_apply, hnullH, smul_zero]
  -- Step 1: `L_n` is closed, a finite union of finite intersections of the closed sets
  -- `{x : xᵢ ∈ ℤ}`
  have hLclosed : IsClosed {x : Euclid P | ∃ t : Finset (Fin P), P ≤ m + 1 + t.card ∧
      ∀ i ∈ t, ∃ z : ℤ, x i = z} := by
    have hcoord : ∀ i : Fin P, IsClosed {x : Euclid P | ∃ z : ℤ, x i = z} := by
      intro i
      have h : {x : Euclid P | ∃ z : ℤ, x i = z} =
          (fun x : Euclid P => x i) ⁻¹' range ((↑) : ℤ → ℝ) := by
        ext x
        exact ⟨fun ⟨z, hz⟩ => ⟨z, hz.symm⟩, fun ⟨z, hz⟩ => ⟨z, hz.symm⟩⟩
      rw [h]
      exact Int.isClosedEmbedding_coe_real.isClosed_range.preimage (by fun_prop)
    have h : {x : Euclid P | ∃ t : Finset (Fin P), P ≤ m + 1 + t.card ∧
        ∀ i ∈ t, ∃ z : ℤ, x i = z} = ⋃ (t : Finset (Fin P)) (_ : P ≤ m + 1 + t.card),
          ⋂ i ∈ t, {x : Euclid P | ∃ z : ℤ, x i = z} := by
      ext x
      simp only [mem_ofPred_eq, mem_iUnion, mem_iInter, exists_prop]
    rw [h]
    exact isClosed_iUnion_of_finite fun t => isClosed_iUnion_of_finite fun _ =>
      isClosed_iInter fun i => isClosed_iInter fun _ => hcoord i
  classical
  -- Step 2: the faces `F_p` meeting `K ⊆ B̄_R(0)` have corners with `|zᵢ| ≤ ⌈R⌉ + 1`, so they
  -- form a finite set
  obtain ⟨R, hR⟩ := hK.isBounded.exists_norm_le
  have hKcoord : ∀ x ∈ K, ∀ i : Fin P, |x i| ≤ R := fun x hx i =>
    (Real.norm_eq_abs (x i)).symm.le.trans ((PiLp.norm_apply_le x i).trans (hR x hx))
  let faces : Set ((Fin P → ℤ) × (Fin (m + 1) → Fin P)) := {p | StrictMono p.2 ∧ ∃ k ∈ K,
    k ∈ {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧
      (i ∉ Set.range p.2 → x i = p.1 i)}}
  have hfin : faces.Finite := by
    refine ((Set.Finite.pi (t := fun _ : Fin P => Set.Icc (-(⌈R⌉ + 1)) (⌈R⌉ + 1))
      fun _ => Set.finite_Icc _ _).prod (Set.finite_univ (α := Fin (m + 1) → Fin P))).subset ?_
    rintro p ⟨-, k, hkK, hkF⟩
    have hceil := Int.le_ceil R
    refine ⟨fun i _ => ?_, mem_univ _⟩
    -- `zᵢ ≤ xᵢ ≤ R` and `zᵢ ≥ xᵢ − 1 ≥ −R − 1` for `x ∈ F_p ∩ K`
    obtain ⟨hk₁, hk₂⟩ := abs_le.1 (hKcoord k hkK i)
    have hzb : (p.1 i : ℝ) ≤ R ∧ -R - 1 ≤ (p.1 i : ℝ) := by
      by_cases hi : i ∈ Set.range p.2
      · obtain ⟨h₁, h₂⟩ := (hkF i).1 hi
        constructor <;> linarith
      · have h := (hkF i).2 hi
        constructor <;> linarith
    have h₁ : ((-(⌈R⌉ + 1) : ℤ) : ℝ) ≤ p.1 i := by
      push_cast
      linarith [hzb.2]
    have h₂ : (p.1 i : ℝ) ≤ ((⌈R⌉ + 1 : ℤ) : ℝ) := by
      push_cast
      linarith [hzb.1]
    exact ⟨by exact_mod_cast h₁, by exact_mod_cast h₂⟩
  refine ⟨hfin.toFinset, fun p hp => (hfin.mem_toFinset.1 hp).1, fun p hp => ?_, hLclosed, ?_⟩
  · -- Step 3: `diam F_p ≤ √P` and `F_p ∩ K ≠ ∅` give `F_p ⊆ cthickening √P K`
    obtain ⟨hp2, k, hkK, hkF⟩ := hfin.mem_toFinset.1 hp
    obtain ⟨-, -, -, -, -, -, hdiam, -, -⟩ := Submission.dor_lmb_fcd_fr_face_geometry P m p hp2
    exact fun x hx => mem_cthickening_of_dist_le x k _ K hkK (hdiam x hx k hkF)
  · -- Steps 4–5: off the null set `L_{n−1}` (step 0), every `x ∈ L_n ∩ K` is `Φ_p(y)` for a face
    -- `p` meeting `K` and some `y ∈ Q₁`
    rw [ae_restrict_iff' (hLclosed.inter hK.isClosed).measurableSet]
    filter_upwards [measure_eq_zero_iff_ae_notMem.1 hnull] with x hxL' hx
    obtain ⟨⟨t, ht, hxt⟩, hxK⟩ := hx
    -- `T` the integer and `S` the non-integer coordinates of `x`: `|T| = P − n`, `|S| = n`
    set T : Finset (Fin P) := Finset.univ.filter fun i => ∃ z : ℤ, x i = z with hT
    set S : Finset (Fin P) := Finset.univ.filter fun i => ¬ ∃ z : ℤ, x i = z with hS
    have hTS : T.card + S.card = P := by
      rw [hT, hS, Finset.card_filter_add_card_filter_not, Finset.card_univ, Fintype.card_fin]
    have htT : t.card ≤ T.card := Finset.card_le_card fun i hi =>
      Finset.mem_filter.2 ⟨Finset.mem_univ i, hxt i hi⟩
    have hT' : ¬ P ≤ m + T.card := fun h =>
      hxL' ⟨T, h, fun i hi => (Finset.mem_filter.1 hi).2⟩
    have hScard : S.card = m + 1 := by omega
    -- `ι` enumerates `S` increasingly, `z = ⌊x⌋`, and `y` collects the fractional parts
    let ι := S.orderEmbOfFin hScard
    have hιS : Set.range ι = S := Finset.range_orderEmbOfFin S hScard
    let y : Euclid (m + 1) := WithLp.toLp 2 fun k => Int.fract (x (ι k))
    have hy : ∀ k, 0 < y k ∧ y k < 1 := by
      intro k
      have hk : ι k ∈ S := Finset.orderEmbOfFin_mem S hScard k
      rw [hS, Finset.mem_filter] at hk
      exact ⟨Int.fract_pos.2 fun h => hk.2 ⟨_, h⟩, Int.fract_lt_one _⟩
    have hΦ : WithLp.toLp 2 (fun i => ((⌊x i⌋ : ℤ) : ℝ)) +
        ∑ j, y j • EuclideanSpace.single (ι j) (1 : ℝ) = x := by
      ext i
      rw [PiLp.add_apply, PiLp.toLp_apply, WithLp.ofLp_sum, Finset.sum_apply]
      simp only [PiLp.smul_apply, PiLp.single_apply, smul_eq_mul, mul_ite, mul_one, mul_zero]
      by_cases hi : i ∈ S
      · -- `i = ι(j₀)`: the coordinate is `⌊xᵢ⌋ + fract xᵢ = xᵢ`
        obtain ⟨j₀, rfl⟩ : i ∈ Set.range ι := by rw [hιS]; exact hi
        rw [Fintype.sum_eq_single j₀, ite_eq_left rfl]
        · exact Int.floor_add_fract _
        · intro j hj
          exact ite_eq_right (ι.injective.ne hj.symm)
      · -- `i ∉ range ι`: the coordinate is `⌊xᵢ⌋ = xᵢ ∈ ℤ`
        obtain ⟨z, hz⟩ : ∃ z : ℤ, x i = z := by
          by_contra h
          exact hi (Finset.mem_filter.2 ⟨Finset.mem_univ i, h⟩)
        have h0 : ∀ j, (if i = ι j then y j else 0) = 0 := fun j =>
          ite_eq_right fun h => hi (by rw [h]; exact Finset.orderEmbOfFin_mem S hScard j)
        simp only [h0, Finset.sum_const_zero, add_zero, hz, Int.floor_intCast]
    -- `x = Φ_p(y) ∈ F_p ∩ K` for `p = (⌊x⌋, ι)`, so `p` is one of the faces
    let p : (Fin P → ℤ) × (Fin (m + 1) → Fin P) := (fun i => ⌊x i⌋, ι)
    have hΦp : WithLp.toLp 2 (fun i => (p.1 i : ℝ)) +
        ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ) = x := hΦ
    have hp : p ∈ faces := by
      refine ⟨ι.strictMono, x, hxK, ?_⟩
      obtain ⟨-, -, -, -, hcube, -, -, -, -⟩ :=
        Submission.dor_lmb_fcd_fr_face_geometry P m p ι.strictMono
      have h := hcube y fun k => ⟨(hy k).1.le, (hy k).2.le⟩
      rwa [hΦp] at h
    exact ⟨p, hfin.mem_toFinset.2 hp, y, hy, hΦp⟩
/-- **Unit orientations of the approximate tangent plane of a set in a coordinate plane** (Simon
Ch. 6, proof of 5.1, (26)–(27)).  Let `A ⊆ x + V`, `V = span{e_{ι j}}`, have approximate tangent
space `Q` at `x`, and let `ξ` orient `Q`.  The blow-ups `λ⁻¹(A − x)` lie in `V`, so every test
function vanishing on `V` has zero limit integral `∫_Q f dHⁿ`; since `Q` is the support of `Hⁿ⌞Q`,
this forces `Q ⊆ V`.  The orthonormal frame `τ` of `Q` then satisfies `τₖ = Σⱼ Mⱼₖ e_{ι j}` with
`MᵀM = 1`, so `α(τ) = det M · α(e_ι)` with `det M = ±1` for every `n`-covector `α`. -/
theorem Submission.dor_lmb_fcd_fr_plane_orientation : ∀ (P n : ℕ) (ι : Fin n → Fin P) (A : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)) (ξ : MultiVector P n), StrictMono ι → (∀ a ∈ A, ∀ i, (∀ j, ι j ≠ i) → a i = x i) → HasApproximateTangentSpaceAt n A x Q → IsUnitOrientationOf ξ Q → (∀ α : Covector (Euclid P) n, ξ α = α (fun j => EuclideanSpace.single (ι j) (1 : ℝ))) ∨ (∀ α : Covector (Euclid P) n, ξ α = -α (fun j => EuclideanSpace.single (ι j) (1 : ℝ))) := by
  intro P n ι A x Q ξ hι hA hQ hξ
  obtain ⟨τ, hτ, hτQ, hξτ⟩ := hξ
  -- Step 1: every `q ∈ Q` has `qᵢ = 0` for `i ∉ range ι`
  have hQV : ∀ q ∈ Q, ∀ i, (∀ j, ι j ≠ i) → q i = 0 := by
    intro q hq i hi
    by_contra hqi
    have hc : 0 < |q i| := abs_pos.2 hqi
    -- the test function `g w = max 0 (|qᵢ| - |w - q|)`: positive near `q`, zero where `wᵢ = 0`
    let g : Euclid P → ℝ := fun w => max 0 (|q i| - dist w q)
    have hgc : Continuous g := by fun_prop
    have hgs : HasCompactSupport g := by
      refine HasCompactSupport.intro (isCompact_closedBall q |q i|) fun w hw => ?_
      rw [mem_closedBall, not_le] at hw
      exact max_eq_left (by linarith)
    let f : CompactlySupportedContinuousMap (Euclid P) ℝ :=
      { toFun := g
        continuous_toFun := hgc
        hasCompactSupport' := hgs }
    have hfg : ∀ w, f w = g w := fun _ => rfl
    have hg0 : ∀ w : Euclid P, w i = 0 → g w = 0 := by
      intro w hw
      have h1 : |q i| ≤ dist w q := by
        have h2 := PiLp.norm_apply_le (w - q) i
        rw [dist_eq_norm]
        simpa [hw] using h2
      exact max_eq_left (by linarith)
    -- the integrals over the blow-ups `λ⁻¹(A - x) ⊆ {wᵢ = 0}` vanish, so `∫_Q f dHⁿ = 0`
    have hlim : ∫ y in (Q : Set (Euclid P)), f y ∂μHE[n] = 0 := by
      refine tendsto_nhds_unique (hQ.2 f) (tendsto_const_nhds.congr fun r => ?_)
      refine (setIntegral_eq_zero_of_forall_eq_zero ?_).symm
      rintro _ ⟨a, ha, rfl⟩
      rw [hfg]
      apply hg0
      simp [Poincare.SimonGMT.Chapter03.blowUpMap, hA a ha i hi]
    -- but `q` lies in the support `Q` of `Hⁿ⌞Q` and `f > 0` near `q`, so `∫_Q f dHⁿ > 0`
    have hpos : 0 < ∫ y in (Q : Set (Euclid P)), f y ∂μHE[n] := by
      have := Poincare.SimonGMT.Chapter03.regular_euclideanHausdorffMeasure_restrict_submodule hQ.1
      have hf0 : (0 : Euclid P → ℝ) ≤ ⇑f := fun w => by rw [hfg]; exact le_max_left _ _
      rw [integral_pos_iff_support_of_nonneg hf0 f.integrable]
      have hq' : q ∈ (μHE[n].restrict (Q : Set (Euclid P))).support := by
        rw [Poincare.SimonGMT.Chapter03.support_euclideanHausdorffMeasure_restrict_submodule hQ.1]
        exact hq
      refine (Measure.mem_support_iff_forall q).1 hq' _ ?_
      refine Filter.mem_of_superset (ball_mem_nhds q hc) fun w hw => ?_
      rw [mem_ball] at hw
      rw [Function.mem_support, hfg]
      exact (lt_max_of_lt_right (by linarith)).ne'
    linarith
  -- Step 2: the frame `τ` lies in `V = span{e_ι}`
  have hτV : ∀ k i, (∀ j, ι j ≠ i) → τ k i = 0 := fun k i hi =>
    hQV (τ k) (by rw [← hτQ]; exact Submodule.subset_span (mem_range_self k)) i hi
  -- coordinates `m k = (τ k (ι j))ⱼ` of `τ k` in the frame `e_ι`, and `L w = Σⱼ wⱼ e_{ι j}`
  let m : Fin n → Fin n → ℝ := fun k j => τ k (ι j)
  let L : (Fin n → ℝ) →ₗ[ℝ] Euclid P :=
    Fintype.linearCombination ℝ fun j => EuclideanSpace.single (ι j) (1 : ℝ)
  have hLm : ∀ k, L (m k) = τ k := by
    intro k
    refine PiLp.ext fun i => ?_
    simp only [L, m, Fintype.linearCombination_apply, WithLp.ofLp_sum, WithLp.ofLp_smul,
      Finset.sum_apply, Pi.smul_apply, smul_eq_mul, PiLp.single_apply, mul_ite, mul_one, mul_zero]
    by_cases h : ∃ j, ι j = i
    · obtain ⟨j, rfl⟩ := h
      simp [hι.injective.eq_iff]
    · have h' : ∀ j, ι j ≠ i := fun j hj => h ⟨j, hj⟩
      rw [hτV k i h']
      exact Finset.sum_eq_zero fun j _ => ite_eq_right (h' j).symm
  have hLe : ∀ k, L (Pi.basisFun ℝ (Fin n) k) = EuclideanSpace.single (ι k) (1 : ℝ) := by
    intro k
    rw [Pi.basisFun_apply, Fintype.linearCombination_apply_single, one_smul]
  -- Step 3: `M = (τ k (ι j))` is orthogonal, so `det M = ±1`
  let M : Matrix (Fin n) (Fin n) ℝ := (Pi.basisFun ℝ (Fin n)).toMatrix m
  have hMM : M.transpose * M = 1 := by
    ext k l
    rw [Matrix.mul_apply, Matrix.one_apply, ← orthonormal_iff_ite.1 hτ k l, PiLp.inner_apply]
    simp only [Matrix.transpose_apply, M, Module.Basis.toMatrix_apply, Pi.basisFun_repr, m]
    refine Fintype.sum_of_injective ι hι.injective _ _ ?_ fun j => ?_
    · rintro i hi
      rw [hτV k i fun j hj => hi ⟨j, hj⟩]
      simp
    · simp [mul_comm]
  have hdet : M.det = 1 ∨ M.det = -1 := by
    have h := congrArg Matrix.det hMM
    rw [Matrix.det_mul, Matrix.det_transpose, Matrix.det_one] at h
    exact mul_self_eq_one_iff.1 h
  -- Step 4: `α(τ) = det M · α(e_ι)` for every `n`-covector `α`
  have hα : ∀ α : Covector (Euclid P) n,
      α τ = M.det * α (fun j => EuclideanSpace.single (ι j) (1 : ℝ)) := by
    intro α
    have key := DFunLike.congr_fun
      (AlternatingMap.eq_smul_basis_det (Pi.basisFun ℝ (Fin n)) (α.toAlternatingMap.compLinearMap L)) m
    simp only [AlternatingMap.compLinearMap_apply, AlternatingMap.smul_apply, smul_eq_mul,
      ContinuousAlternatingMap.coe_toAlternatingMap, hLm, hLe, Module.Basis.det_apply] at key
    rw [mul_comm] at key
    exact key
  rcases hξτ with h | h <;> rcases hdet with hd | hd
  · exact Or.inl fun α => by rw [h, hα, hd, one_mul]
  · exact Or.inr fun α => by rw [h, hα, hd, neg_one_mul]
  · exact Or.inr fun α => by rw [h, hα, hd, one_mul]
  · exact Or.inl fun α => by rw [h, hα, hd, neg_one_mul, neg_neg]
/-- **Coordinate covectors** (Simon Ch. 6, §1, 1.1, 1.2 and 1.5).  For `J : Fin k → Fin P`,
`dx^J = dx^{J(0)} ∧ ⋯ ∧ dx^{J(k−1)}` is the alternatization of the continuous multilinear map
`v ↦ ∏ᵣ (v_r)_{J(r)}`, so `dx^J(v) = Σ_σ sign σ ∏ᵣ (v_{σ(r)})_{J(r)}`.  At `e_I` the `σ`-term is
`[I ∘ σ = J]`; for strictly increasing `I, J`, `I ∘ σ = J` makes `σ` strictly increasing, hence
`σ = id` and `I = J`, so `dx^J(e_I) = [I = J]`.  For an injective family of strictly increasing
`J_l`, `(Σ_l c_l dx^{J_l})(e_I)` is `c_l` if `I = J_l` and `0` if `I ∉ range J`; summing the
squares over strictly increasing `I` gives `covectorEuclideanNorm (Σ_l c_l dx^{J_l}) = √(Σ_l c_l²)`.
-/
theorem Submission.dor_lmb_fcd_fr_coordinate_covectors : ∀ (P k : ℕ), ∃ dx : (Fin k → Fin P) → Covector (Euclid P) k, (∀ I J : Fin k → Fin P, StrictMono I → StrictMono J → dx J (fun r => EuclideanSpace.single (I r) (1 : ℝ)) = if I = J then 1 else 0) ∧ ∀ (N : ℕ) (J : Fin N → Fin k → Fin P) (c : Fin N → ℝ), Function.Injective J → (∀ l, StrictMono (J l)) → covectorEuclideanNorm (∑ l, c l • dx (J l)) = Real.sqrt (∑ l, c l ^ 2) := by
  intro P k
  classical
  -- Step 1: `dx^J` is the alternatization of `v ↦ ∏ᵣ (v_r)_{J(r)}`
  let dx : (Fin k → Fin P) → Covector (Euclid P) k := fun J =>
    ContinuousMultilinearMap.alternatization
      ((ContinuousMultilinearMap.mkPiAlgebra ℝ (Fin k) ℝ).compContinuousLinearMap
        (fun r => EuclideanSpace.proj (J r)))
  have hdx : ∀ (J : Fin k → Fin P) (v : Fin k → Euclid P),
      dx J v = ∑ σ : Equiv.Perm (Fin k), Equiv.Perm.sign σ • ∏ r, (v (σ r)) (J r) := by
    intro J v
    simp only [dx, ContinuousMultilinearMap.alternatization_apply_apply,
      ContinuousMultilinearMap.compContinuousLinearMap_apply,
      ContinuousMultilinearMap.mkPiAlgebra_apply, Function.comp_apply]
    rfl
  -- Step 2: if `I ∘ σ = J` with `I, J` strictly increasing, then `σ = id` and `I = J`
  have hperm : ∀ (I J : Fin k → Fin P), StrictMono I → StrictMono J →
      ∀ σ : Equiv.Perm (Fin k), (∀ r, I (σ r) = J r) → σ = 1 ∧ I = J := by
    intro I J hI hJ σ hσ
    have hσmono : StrictMono σ := by
      intro a b hab
      have : I (σ a) < I (σ b) := by rw [hσ a, hσ b]; exact hJ hab
      exact hI.lt_iff_lt.mp this
    have hrange : Set.range σ = Set.range (id : Fin k → Fin k) := by
      rw [Set.range_id]; exact σ.surjective.range_eq
    have hid : (σ : Fin k → Fin k) = id :=
      (StrictMono.range_inj_of_wellFoundedLT hσmono strictMono_id).mp hrange
    have hσ1 : σ = 1 := by
      ext r; simp [congrFun hid r]
    refine ⟨hσ1, ?_⟩
    funext r
    have := hσ r
    rw [hσ1] at this
    simpa using this
  -- duality `dx^J(e_I) = [I = J]` for strictly increasing `I, J`
  have hdual : ∀ I J : Fin k → Fin P, StrictMono I → StrictMono J →
      dx J (fun r => EuclideanSpace.single (I r) (1 : ℝ)) = if I = J then 1 else 0 := by
    intro I J hI hJ
    rw [hdx]
    have hterm : ∀ σ : Equiv.Perm (Fin k),
        ∏ r, (EuclideanSpace.single (I (σ r)) (1 : ℝ)) (J r) =
          if (∀ r, I (σ r) = J r) then 1 else 0 := by
      intro σ
      split_ifs with h
      · refine Finset.prod_eq_one fun r _ => ?_
        rw [h r]; simp
      · push Not at h
        obtain ⟨r, hr⟩ := h
        refine Finset.prod_eq_zero (Finset.mem_univ r) ?_
        simp [Ne.symm hr]
    simp_rw [hterm]
    split_ifs with hIJ
    · subst hIJ
      rw [Finset.sum_eq_single (1 : Equiv.Perm (Fin k))]
      · simp
      · intro σ _ hσ
        rw [ite_eq_right]
        · simp
        · intro h
          exact hσ (hperm I I hI hI σ h).1
      · simp
    · refine Finset.sum_eq_zero fun σ _ => ?_
      rw [ite_eq_right]
      · simp
      · intro h
        exact hIJ (hperm I J hI hJ σ h).2
  refine ⟨dx, hdual, ?_⟩
  intro N J c hJinj hJmono
  -- Step 3: values of `Σ_l c_l dx^{J_l}` on the coordinate frames `e_I`
  have hval : ∀ I : Fin k → Fin P, StrictMono I →
      (∑ l, c l • dx (J l)) (fun r => EuclideanSpace.basisFun (Fin P) ℝ (I r)) =
        ∑ l, if I = J l then c l else 0 := by
    intro I hI
    simp only [EuclideanSpace.basisFun_apply]
    rw [ContinuousAlternatingMap.sum_apply]
    refine Finset.sum_congr rfl fun l _ => ?_
    rw [ContinuousAlternatingMap.smul_apply, hdual I (J l) hI (hJmono l)]
    split_ifs <;> simp
  -- by injectivity of `J`, at most one `l` has `J_l = I`
  have hsq : ∀ I : Fin k → Fin P,
      (∑ l, if I = J l then c l else 0) ^ 2 = ∑ l, if I = J l then c l ^ 2 else 0 := by
    intro I
    by_cases hex : ∃ l, I = J l
    · obtain ⟨l₀, hl₀⟩ := hex
      have h1 : (∑ l, if I = J l then c l else 0) = c l₀ := by
        rw [Finset.sum_eq_single l₀]
        · simp [hl₀]
        · intro l _ hl
          rw [ite_eq_right]
          intro h
          exact hl (hJinj (h.symm.trans hl₀))
        · simp
      have h2 : (∑ l, if I = J l then c l ^ 2 else 0) = c l₀ ^ 2 := by
        rw [Finset.sum_eq_single l₀]
        · simp [hl₀]
        · intro l _ hl
          rw [ite_eq_right]
          intro h
          exact hl (hJinj (h.symm.trans hl₀))
        · simp
      rw [h1, h2]
    · push Not at hex
      simp [hex]
  -- Step 4: sum the squares over strictly increasing `I` and exchange the finite sums
  unfold covectorEuclideanNorm
  congr 1
  calc (∑ I : Fin k → Fin P, if StrictMono I then
          ((∑ l, c l • dx (J l)) (fun i => EuclideanSpace.basisFun (Fin P) ℝ (I i))) ^ 2 else 0)
      = ∑ I : Fin k → Fin P, ∑ l, (if I = J l then c l ^ 2 else 0) := by
        refine Finset.sum_congr rfl fun I _ => ?_
        split_ifs with hI
        · rw [hval I hI, hsq I]
        · symm
          refine Finset.sum_eq_zero fun l _ => ?_
          rw [ite_eq_right]
          rintro rfl
          exact hI (hJmono l)
    _ = ∑ l, ∑ I : Fin k → Fin P, (if I = J l then c l ^ 2 else 0) := Finset.sum_comm
    _ = ∑ l, c l ^ 2 := by
        refine Finset.sum_congr rfl fun l _ => ?_
        simp
/-- **Simon Ch. 6, 3.2(3), upper bound**: if `T = τ(M, θ, ξ)` then `M_W(T) ≤ μ_T(W)` for every
`W`.  For admissible `ω`, `⟨ω, ξ⟩ ≤ |ω| ≤ 1` `μ_T`-a.e. (`|ξ(α)| ≤ |α|` for unit orientations)
and `⟨ω, ξ⟩ = 0` off `spt ω`, so `T(ω) = ∫ ⟨ω, ξ⟩ dμ_T ≤ μ_T(spt ω) ≤ μ_T(W)`. -/
theorem Submission.dor_ims_massOn_le_measure : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), R.Represents T → ∀ W : Set (Euclid P), T.massOn W ≤ R.measure W := by
  intro P n U T R hR W
  obtain ⟨L, hL⟩ := Submission.dor_ims_unitOrientation_dual P n
  -- `|ξ(x)(α)| ≤ |α|` for `μ_T`-a.e. `x`: `ξ(x)` is a unit orientation `Hⁿ⌞M`-a.e., and
  -- `μ_T = θ Hⁿ⌞M ≪ Hⁿ⌞M`
  have hdual : ∀ᵐ x ∂R.measure, ∀ α : Covector (Euclid P) n,
      |R.orient x α| ≤ covectorEuclideanNorm α := by
    have hac : R.measure ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
    refine hac.ae_le ?_
    filter_upwards [R.orients] with x hx
    obtain ⟨Q, -, hQ⟩ := hx
    exact (hL _ Q hQ).1
  apply sSup_le
  rintro r ⟨ω, ⟨hωW, hω1⟩, rfl⟩
  -- `K = spt ω` is a compact subset of `U`, so `μ_T(K) = ∫_{M ∩ K} θ dHⁿ < ∞`
  set K := tsupport (ω : DifferentialForm (Euclid P) n)
  have hKm : MeasurableSet K := (isClosed_tsupport _).measurableSet
  have hμK : R.measure K ≠ ∞ := by
    rw [IMRep.measure, withDensity_apply _ hKm, Measure.restrict_restrict hKm, inter_comm]
    exact R.locallyIntegrable_mult K ω.2.1.2.isCompact ω.2.2
  obtain ⟨hint, haction⟩ := Submission.dor_ims_action_eq_integral P n U R ω
  -- `⟨ω, ξ⟩ ≤ 1_K` `μ_T`-a.e.: `⟨ω(x), ξ(x)⟩ ≤ |ω(x)| ≤ 1` on `K` and `ω = 0` off `K`
  have hle : (fun x => R.orient x ((ω : DifferentialForm (Euclid P) n) x)) ≤ᵐ[R.measure]
      K.indicator fun _ => (1 : ℝ) := by
    filter_upwards [hdual] with x hx
    by_cases hxK : x ∈ K
    · rw [indicator_of_mem hxK]
      exact (le_abs_self _).trans ((hx _).trans (hω1 x))
    · rw [indicator_of_notMem hxK, image_eq_zero_of_notMem_tsupport hxK, map_zero]
  calc ENNReal.ofReal (T ω)
      = ENNReal.ofReal (∫ x, R.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂R.measure) := by
        rw [hR ω, haction]
    _ ≤ ENNReal.ofReal (∫ x, K.indicator (fun _ => (1 : ℝ)) x ∂R.measure) :=
        ENNReal.ofReal_le_ofReal (integral_mono_ae hint
          ((integrableOn_const hμK).integrable_indicator hKm) hle)
    _ = R.measure K := by
        rw [integral_indicator_const _ hKm, smul_eq_mul, mul_one, measureReal_def,
          ENNReal.ofReal_toReal hμK]
    _ ≤ R.measure W := measure_mono hωW
/-- `Λⁿ(ℝᴾ)` is finite-dimensional: `α ↦ (α(e_{I(1)}, …, e_{I(n)}))_{I : Fin n → Fin P}` is a linear
map into the finite-dimensional space `(Fin n → Fin P) → ℝ`, injective because an alternating map
is determined by its values on tuples of basis vectors. -/
theorem Submission.dor_ims_lusin_covector_finiteDimensional : ∀ (P n : ℕ), FiniteDimensional ℝ (Covector (Euclid P) n) := by
  intro P n
  let e := (EuclideanSpace.basisFun (Fin P) ℝ).toBasis
  -- `L α = (α(e ∘ I))_I`
  let L : Covector (Euclid P) n →ₗ[ℝ] (Fin n → Fin P) → ℝ :=
    { toFun := fun α I => α fun k => e (I k)
      map_add' := fun α β => rfl
      map_smul' := fun c α => rfl }
  refine FiniteDimensional.of_injective L fun α β h => ?_
  apply ContinuousAlternatingMap.toAlternatingMap_injective
  exact e.ext_alternating fun v _ => congrFun h v
/-- **Change of variables along an isometry** (the Jacobian-one case of the area formula behind
Simon Ch. 6, 2.24(3) and 3.3–3.9).  An isometry `f : ℝᴾ → ℝ^Q`, not necessarily linear, is a
closed and hence measurable embedding, and `f_#Hᵈ = Hᵈ⌞f(ℝᴾ)`; so `f_#(Hᵈ⌞A) = Hᵈ⌞f(A)` for every
`A ⊆ ℝᴾ`, and `∫_{f(A)} g dHᵈ = ∫_A g ∘ f dHᵈ` for every real or `[0, ∞]`-valued `g`, with no
measurability or integrability assumptions. -/
theorem Submission.dor_lmb_fc_dtop_ip_isometry_change_of_variables : ∀ (P Q d : ℕ) (f : Euclid P → Euclid Q), Isometry f → MeasurableEmbedding f ∧ (∀ A : Set (Euclid P), Measure.map f ((μHE[d] : Measure (Euclid P)).restrict A) = (μHE[d] : Measure (Euclid Q)).restrict (f '' A)) ∧ (∀ (A : Set (Euclid P)) (g : Euclid Q → ℝ), ∫ y in f '' A, g y ∂μHE[d] = ∫ x in A, g (f x) ∂μHE[d]) ∧ ∀ (A : Set (Euclid P)) (g : Euclid Q → ℝ≥0∞), ∫⁻ y in f '' A, g y ∂μHE[d] = ∫⁻ x in A, g (f x) ∂μHE[d] := by
  intro P Q d f hf
  have hfe : MeasurableEmbedding f := hf.isClosedEmbedding.measurableEmbedding
  -- `f_#(Hᵈ⌞A) = (f_#Hᵈ)⌞f(A) = (Hᵈ⌞range f)⌞f(A) = Hᵈ⌞f(A)`, using `f⁻¹(f(A)) = A`
  have hmap : ∀ A : Set (Euclid P), Measure.map f ((μHE[d] : Measure (Euclid P)).restrict A) =
      (μHE[d] : Measure (Euclid Q)).restrict (f '' A) := by
    intro A
    rw [← Measure.restrict_restrict_of_subset (image_subset_range f A),
      ← hf.map_euclideanHausdorffMeasure, hfe.restrict_map, hf.injective.preimage_image]
  refine ⟨hfe, hmap, fun A g => ?_, fun A g => ?_⟩
  · rw [← hmap A, hfe.integral_map]
  · rw [← hmap A, hfe.lintegral_map]

/-- Approximate tangent spaces are transported by a linear isometric embedding `L : ℝᴾ → ℝ^Q`
(Simon Ch. 3, 1.4; cf. `T_y(f(M))` in Ch. 6, 3.7): if `S = TₓM` then `L(S) = T_{Lx}(L(M))`.  The
injective `L` restricts to `S ≃ L(S)`, so `dim L(S) = d`.  By linearity
`η_{Lx,r}(L(M)) = L(η_{x,r}(M))` for every `r`; for `f ∈ C_c(ℝ^Q)`, `f ∘ L ∈ C_c(ℝᴾ)` as `L` is a
closed embedding, and the Jacobian-one change of variables `∫_{L(A)} f dHᵈ = ∫_A f ∘ L dHᵈ`
(`dor_lmb_fc_dtop_ip_isometry_change_of_variables`) turns the blow-up integrals and the limit
`∫_{L(S)} f dHᵈ` into those of `f ∘ L`. -/
theorem Submission.dor_lmb_fc_dtop_ip_approxTangent_isometry : ∀ (P Q d : ℕ) (L : Euclid P →L[ℝ] Euclid Q) (M : Set (Euclid P)) (x : Euclid P) (S : Submodule ℝ (Euclid P)), Isometry L → HasApproximateTangentSpaceAt d M x S → HasApproximateTangentSpaceAt d (L '' M) (L x) (Submodule.map (L : Euclid P →ₗ[ℝ] Euclid Q) S) := by
  intro P Q d L M x S hL hS
  -- `∫_{L(A)} h dHᵈ = ∫_A h ∘ L dHᵈ` for every `A ⊆ ℝᴾ`
  obtain ⟨-, -, hint, -⟩ :=
    Submission.dor_lmb_fc_dtop_ip_isometry_change_of_variables P Q d L hL
  -- `dim L(S) = dim S = d`, as the injective `L` restricts to `S ≃ L(S)`
  refine ⟨(Submodule.equivMapOfInjective (L : Euclid P →ₗ[ℝ] Euclid Q) hL.injective
    S).finrank_eq.symm.trans hS.1, fun f => ?_⟩
  -- `g = f ∘ L ∈ C_c(ℝᴾ)`, as `L` is a closed embedding
  let g : CompactlySupportedContinuousMap (Euclid P) ℝ :=
    ⟨⟨f ∘ L, (map_continuous f).comp L.continuous⟩,
      f.hasCompactSupport.comp_isClosedEmbedding hL.isClosedEmbedding⟩
  -- `∫_{L(S)} f dHᵈ = ∫_S g dHᵈ`
  have hlim : ∫ y in (Submodule.map (L : Euclid P →ₗ[ℝ] Euclid Q) S : Set (Euclid Q)),
      f y ∂μHE[d] = ∫ y in (S : Set (Euclid P)), g y ∂μHE[d] := by
    rw [Submodule.map_coe, ContinuousLinearMap.coe_coe, hint]
    rfl
  rw [hlim]
  refine (hS.2 g).congr fun r => ?_
  -- `η_{Lx,r}(L(M)) = L(η_{x,r}(M))`, so `∫_{η_{Lx,r}(L(M))} f dHᵈ = ∫_{η_{x,r}(M)} g dHᵈ`
  have hblow : Poincare.SimonGMT.Chapter03.blowUpMap (L x) r '' (L '' M) =
      L '' (Poincare.SimonGMT.Chapter03.blowUpMap x r '' M) := by
    rw [image_image, image_image]
    refine image_congr fun w _ => ?_
    simp only [Poincare.SimonGMT.Chapter03.blowUpMap, map_smul, map_sub]
  rw [hblow, hint]
  rfl
/-- **Simon Ch. 6, 3.4–3.5 and 3.7** (the Jacobian-one case): an isometric linear map
`L : ℝᴾ → ℝ^Q` transports unit orientations.  If `ξ = ±τ₁ ∧ ⋯ ∧ τ_d` orients `S` (`τ`
orthonormal), then `L ∘ τ` is orthonormal, since `L` fixes `0` and so preserves norms and inner
products; it spans `L(S)`, the span of an image being the image of the span; and `(∧L)ξ = ξ ∘ L^*`
pairs as `β ↦ ξ(L^*β) = ±(L^*β)(τ) = ±β(L ∘ τ)`, so `(∧L)ξ = ±Lτ₁ ∧ ⋯ ∧ Lτ_d` with the same
sign. -/
theorem Submission.dor_lmb_fc_dtop_ip_unitOrientation_isometry : ∀ (P Q d : ℕ) (L : Euclid P →L[ℝ] Euclid Q) (ξ : MultiVector P d) (S : Submodule ℝ (Euclid P)), Isometry L → IsUnitOrientationOf ξ S → IsUnitOrientationOf (ξ.comp (ContinuousAlternatingMap.compContinuousLinearMapCLM L)) (Submodule.map (L : Euclid P →ₗ[ℝ] Euclid Q) S) := by
  intro P Q d L ξ S hL hξ
  obtain ⟨τ, hτo, hτS, hτ⟩ := hξ
  -- `L 0 = 0`, so the isometry `L` preserves norms: it is a linear isometry `ℝᴾ →ₗᵢ ℝ^Q`
  let Li : Euclid P →ₗᵢ[ℝ] Euclid Q :=
    { toLinearMap := (L : Euclid P →ₗ[ℝ] Euclid Q)
      norm_map' := hL.norm_map_of_map_zero (map_zero L) }
  refine ⟨L ∘ τ, hτo.comp_linearIsometry Li, ?_, ?_⟩
  · -- `span (range (L ∘ τ)) = span (L '' range τ) = (span (range τ)).map L`
    rw [Set.range_comp, ← hτS]
    exact Submodule.span_image (L : Euclid P →ₗ[ℝ] Euclid Q)
  · -- `((∧L)ξ)(β) = ξ(L^*β)` and `(L^*β)(τ) = β(L ∘ τ)` hold by definition
    rcases hτ with h | h
    · exact Or.inl fun β => h (β.compContinuousLinearMap L)
    · exact Or.inr fun β => h (β.compContinuousLinearMap L)

/-- **Simon Ch. 6, 2.23–2.24 and 3.3–3.9 for a linear isometric embedding `L : ℝᴾ → ℝ^Q`**: if
`R = (M, θ, ξ)` represents `T` in `ℝᴾ`, then `R' = (L(M), θ ∘ L*, L_#ξ ∘ L*)`, where
`L_#ξ(x) = ξ(x) ∘ L^#` and `L*` is the adjoint, represents `L_#T` in `ℝ^Q`, and
`μ_{R'}(B) = μ_R(L⁻¹(B))` for Borel `B`.  The Jacobian of `L` is `1`, so the area formula is the
change of variables `Hᵈ⌞L(A) = L_#(Hᵈ⌞A)` (`dor_lmb_fc_dtop_ip_isometry_change_of_variables`).
`L` preserves inner products, so `L*` is a continuous linear left inverse of `L`; `L(M)` is
rectifiable as `L` is `1`-Lipschitz; `L_#ξ(x)` orients `T_{Lx}L(M) = L(TₓM)`
(`dor_lmb_fc_dtop_ip_approxTangent_isometry`, `dor_lmb_fc_dtop_ip_unitOrientation_isometry`); and
`L_#T(ω) = T(L^#ω)` with `⟨L^#ω(x), ξ(x)⟩ = ⟨ω(Lx), L_#ξ(x)⟩`. -/
theorem Submission.dor_lmb_fc_dtop_ip_image_imrep : ∀ (P Q d : ℕ) (L : Euclid P →L[ℝ] Euclid Q) (hL : IsProperMap (fun x => (0 : Euclid Q) + L x)) (T : GeometricCurrentOn (univ : Set (Euclid P)) d) (R : IMRep (univ : Set (Euclid P)) d), Isometry L → R.Represents T → ∃ R' : IMRep (univ : Set (Euclid Q)) d, R'.Represents (GeometricCurrentOn.affinePushforward (V := (univ : Set (Euclid Q))) L 0 hL T) ∧ ∀ s : Set (Euclid Q), MeasurableSet s → R'.measure s = R.measure (L ⁻¹' s) := by
  intro P Q d L hL T R hLi hR
  obtain ⟨hme, hmap, hint, hlint⟩ :=
    Submission.dor_lmb_fc_dtop_ip_isometry_change_of_variables P Q d L hLi
  -- `L` preserves inner products, so `⟨L*(Lx), y⟩ = ⟨Lx, Ly⟩ = ⟨x, y⟩`: `L*` is a left inverse
  have hAL : ∀ x, ContinuousLinearMap.adjoint L (L x) = x := by
    let Li : Euclid P →ₗᵢ[ℝ] Euclid Q :=
      { toLinearMap := L, norm_map' := (AddMonoidHomClass.isometry_iff_norm L).mp hLi }
    refine fun x => ext_inner_right ℝ fun y => ?_
    rw [ContinuousLinearMap.adjoint_inner_left]
    exact Li.inner_map_map x y
  -- `ζ ↦ ζ ∘ L^#` is continuous on `d`-vectors
  have hΦ : Continuous fun ζ : MultiVector P d =>
      ζ.comp (ContinuousAlternatingMap.compContinuousLinearMapCLM L) :=
    continuous_id.clm_comp continuous_const
  refine ⟨{ carrier := L '' R.carrier
            mult := fun y => R.mult (ContinuousLinearMap.adjoint L y)
            orient := fun y => (R.orient (ContinuousLinearMap.adjoint L y)).comp
              (ContinuousAlternatingMap.compContinuousLinearMapCLM L)
            measurableSet_carrier := hme.measurableSet_image.mpr R.measurableSet_carrier
            carrier_subset := subset_univ _
            rectifiable := ?_
            measurable_mult :=
              R.measurable_mult.comp (ContinuousLinearMap.adjoint L).continuous.measurable
            mult_pos := ?_
            locallyIntegrable_mult := ?_
            aestronglyMeasurable_orient := ?_
            orients := ?_ }, ?_, ?_⟩
  · -- `L(M) ⊆ L(M₀) ∪ ⋃ⱼ range (L ∘ Fⱼ)` with `Hᵈ(L(M₀)) = Hᵈ(M₀) = 0` and `L ∘ Fⱼ` Lipschitz
    obtain ⟨M₀, hM₀, F, hF, hcover⟩ := R.rectifiable
    refine ⟨L '' M₀, by rw [hLi.euclideanHausdorffMeasure_image, hM₀], fun j => L ∘ F j,
      fun j => ?_, ?_⟩
    · obtain ⟨K, hK⟩ := hF j
      exact ⟨_, hLi.lipschitzWith.comp hK⟩
    · rintro _ ⟨x, hx, rfl⟩
      rcases hcover hx with h0 | h1
      · exact Or.inl ⟨x, h0, rfl⟩
      · obtain ⟨j, v, rfl⟩ := mem_iUnion.mp h1
        exact Or.inr (mem_iUnion.mpr ⟨j, v, rfl⟩)
  · rintro _ ⟨x, hx, rfl⟩
    show 0 < R.mult (ContinuousLinearMap.adjoint L (L x))
    rw [hAL]
    exact R.mult_pos x hx
  · -- `L(M) ∩ K = L(M ∩ L⁻¹(K))`, and `L⁻¹(K)` is compact as `L` is a closed embedding
    intro K hK _
    rw [← image_inter_preimage, hlint]
    simp only [hAL]
    exact R.locallyIntegrable_mult _
      (hLi.isClosedEmbedding.isProperMap.isCompact_preimage hK) (subset_univ _)
  · -- `Hᵈ⌞L(M) = L_#(Hᵈ⌞M)` and `ξ' ∘ L = L_#ξ`
    rw [← hmap]
    refine hme.aestronglyMeasurable_map_iff.mpr ?_
    simp only [Function.comp_def, hAL]
    exact hΦ.comp_aestronglyMeasurable R.aestronglyMeasurable_orient
  · -- for `Hᵈ⌞M`-a.e. `x`, `L_#ξ(x)` orients `L(TₓM)`, the approximate tangent of `L(M)` at `Lx`
    rw [← hmap]
    refine hme.ae_map_iff.mpr (R.orients.mono fun x hx => ?_)
    obtain ⟨S, hS, hξ⟩ := hx
    refine ⟨S.map (L : Euclid P →ₗ[ℝ] Euclid Q),
      Submission.dor_lmb_fc_dtop_ip_approxTangent_isometry P Q d L R.carrier x S hLi hS, ?_⟩
    simpa only [hAL] using
      Submission.dor_lmb_fc_dtop_ip_unitOrientation_isometry P Q d L (R.orient x) S hLi hξ
  · -- `L_#T(ω) = T(L^#ω) = ∫_M θ ⟨L^#ω, ξ⟩ dHᵈ = ∫_M θ'(Lx) ⟨ω(Lx), ξ'(Lx)⟩ dHᵈ(x) = R'(ω)`
    intro ω
    have h1 : (GeometricCurrentOn.affinePushforward (V := (univ : Set (Euclid Q))) L 0 hL T) ω =
        R.action (affinePullbackForm L 0 (ω : DifferentialForm (Euclid Q) d)) :=
      hR (affinePullbackTestOn L 0 hL univ d ω)
    rw [h1]
    simp only [IMRep.action]
    rw [hint]
    refine setIntegral_congr_fun R.measurableSet_carrier fun x _ => ?_
    simp [affinePullbackForm, hAL]
  · -- `μ_{R'}(B) = ∫_{L⁻¹(B)} θ'(Lx) d(Hᵈ⌞M)(x) = μ_R(L⁻¹(B))`
    intro s hs
    simp only [IMRep.measure]
    rw [withDensity_apply _ hs, withDensity_apply _ (hme.measurable hs), ← hmap,
      hme.restrict_map, hme.lintegral_map]
    simp only [hAL]

/-- **Simon Ch. 6, 2.23 and 3.3–3.9 for a linear isometric embedding `L : ℝᴾ → ℝ^Q`**: if `T`
is an integer multiplicity current in `ℝᴾ`, then so is `L_#T` in `ℝ^Q`, and `M(L_#T) = M(T)`.
If `R = (M, θ, ξ)` represents `T`, the image triple `R'` of `dor_lmb_fc_dtop_ip_image_imrep`
represents `L_#T` and has `μ_{R'}(B) = μ_R(L⁻¹(B))` for Borel `B`.  Applying Simon 6.3.2(3),
`M_W(X) = μ(W)` for open `W` (`dor_imrep_massOn_eq_measure_and_support`), on both sides gives
`M(L_#T) = μ_{R'}(ℝ^Q) = μ_R(L⁻¹(ℝ^Q)) = μ_R(ℝᴾ) = M(T)`. -/
theorem Submission.dor_lmb_fc_dtop_isometric_pushforward_im : ∀ (P Q d : ℕ) (L : Euclid P →L[ℝ] Euclid Q) (hL : IsProperMap (fun x => (0 : Euclid Q) + L x)) (T : GeometricCurrentOn (univ : Set (Euclid P)) d), Isometry L → IsIntegerMultiplicity T → IsIntegerMultiplicity (GeometricCurrentOn.affinePushforward (V := (univ : Set (Euclid Q))) L 0 hL T) ∧ (GeometricCurrentOn.affinePushforward (V := (univ : Set (Euclid Q))) L 0 hL T).mass = T.mass := by
  intro P Q d L hL T hLi hT
  obtain ⟨R, hR⟩ := hT
  obtain ⟨R', hR', hμ⟩ := Submission.dor_lmb_fc_dtop_ip_image_imrep P Q d L hL T R hLi hR
  refine ⟨⟨R', hR'⟩, ?_⟩
  -- `M(X) = M_U(X)` with `U = univ` open on both sides, so (C1) applies with `W = univ`
  calc (GeometricCurrentOn.affinePushforward (V := (univ : Set (Euclid Q))) L 0 hL T).mass
      = R'.measure univ :=
        (Submission.dor_imrep_massOn_eq_measure_and_support Q d univ _ R' isOpen_univ hR').1
          univ isOpen_univ
    _ = R.measure (L ⁻¹' univ) := hμ univ MeasurableSet.univ
    _ = T.mass := by
        rw [preimage_univ]
        exact ((Submission.dor_imrep_massOn_eq_measure_and_support P d univ T R isOpen_univ
          hR).1 univ isOpen_univ).symm
/-- **Pull-back along the coordinate projection `ℝ^{P+1} → ℝᴾ` preserves the Euclidean coefficient
norm of covectors** (Simon Ch. 6, 1.15; used for the cut-off pull-back in the proof of 7.4.3).
If `(p y)ᵢ = y_{castSucc i}`, then `p e_{castSucc i} = eᵢ` and `p e_last = 0`.  Reindexing the
coefficient sum of `p^*α` along the injective map `I ↦ castSucc ∘ I`, the coefficients off its
range have an argument `p e_last = 0` and vanish, while `c_{castSucc ∘ I}(p^*α) = c_I(α)` on it
(`castSucc ∘ I` is strictly increasing iff `I` is). -/
theorem Submission.dor_lmb_fc_dtop_cp_proj_covector_norm : ∀ (P d : ℕ) (p : Euclid (P + 1) →L[ℝ] Euclid P), (∀ (y : Euclid (P + 1)) (i : Fin P), p y i = y (Fin.castSucc i)) → ∀ α : Covector (Euclid P) d, covectorEuclideanNorm (α.compContinuousLinearMap p) = covectorEuclideanNorm α := by
  intro P d p hp α
  classical
  -- Step 1: `p e_{castSucc i} = e_i` and `p e_last = 0`
  have hcs : ∀ i : Fin P, p (EuclideanSpace.basisFun (Fin (P + 1)) ℝ (Fin.castSucc i)) =
      EuclideanSpace.basisFun (Fin P) ℝ i := by
    intro i
    ext j
    rw [hp]
    simp [Fin.castSucc_inj]
  have hlast : p (EuclideanSpace.basisFun (Fin (P + 1)) ℝ (Fin.last P)) = 0 := by
    ext j
    rw [hp]
    simp [(Fin.castSucc_lt_last j).ne]
  -- Step 2: compare the coefficient sums under the square roots
  unfold covectorEuclideanNorm
  congr 1
  symm
  -- Step 3: reindex along the injective map `I ↦ castSucc ∘ I`
  refine Fintype.sum_of_injective (fun I : Fin d → Fin P => Fin.castSucc ∘ I)
    (fun I I' h => funext fun k => Fin.castSucc_injective P (congrFun h k)) _ _ ?_ ?_
  -- Step 4: off the range some `J k` is `last`, so the coefficient has a zero argument
  · intro J hJ
    by_cases hJs : StrictMono J
    · obtain ⟨k, hk⟩ : ∃ k, J k = Fin.last P := by
        by_contra hne
        exact hJ ⟨fun k => (J k).castPred fun h => hne ⟨k, h⟩,
          funext fun k => Fin.castSucc_castPred _ _⟩
      rw [ite_eq_left hJs, ContinuousAlternatingMap.compContinuousLinearMap_apply,
        α.map_coord_zero k (by simp only [Function.comp_apply, hk, hlast]), zero_pow two_ne_zero]
    · rw [ite_eq_right hJs]
  -- Step 5: on the range, `StrictMono (castSucc ∘ I) ↔ StrictMono I` and `p e_{castSucc I} = e_I`
  · intro I
    have hiff : StrictMono (Fin.castSucc ∘ I) ↔ StrictMono I :=
      ⟨fun h _ _ hab => Fin.castSucc_lt_castSucc_iff.1 (h hab), Fin.strictMono_castSucc.comp⟩
    by_cases hI : StrictMono I
    · rw [ite_eq_left hI, ite_eq_left (hiff.2 hI),
        ContinuousAlternatingMap.compContinuousLinearMap_apply]
      congr 2
      funext k
      exact (hcs (I k)).symm
    · rw [ite_eq_right hI, ite_eq_right (mt hiff.1 hI)]
/-- **The Euclidean coefficient norm is a continuous seminorm dominated by the operator norm**
(Simon Ch. 6, 1.15 and 2.4; used by the smooth approximation of test forms behind the mass of
`τ(M, θ, ξ)`).  With `e` the standard basis of `ℝᴾ`, let `c_I α = α(e_{I(0)}, …, e_{I(n-1)})`
for strictly increasing `I : Fin n → Fin P` and `c_I α = 0` otherwise.  Then
`covectorEuclideanNorm α = ‖v α‖` for the coefficient vector
`v α = (c_I α)_I ∈ EuclideanSpace ℝ (Fin n → Fin P)`, which is linear in `α`; this gives the
triangle inequality and homogeneity.  `|c_I α| ≤ ‖α‖ ∏ₖ ‖e_{I(k)}‖ = ‖α‖` gives the bound with
`C = √(card (Fin n → Fin P))`, and then the norm is `C`-Lipschitz, hence continuous. -/
theorem Submission.rsd_mw_tfa_norm_props : ∀ (P n : ℕ), (∀ α α' : Covector (Euclid P) n, covectorEuclideanNorm (α + α') ≤ covectorEuclideanNorm α + covectorEuclideanNorm α') ∧ (∀ (t : ℝ) (α : Covector (Euclid P) n), covectorEuclideanNorm (t • α) = |t| * covectorEuclideanNorm α) ∧ (∃ C : ℝ, 0 ≤ C ∧ ∀ α : Covector (Euclid P) n, covectorEuclideanNorm α ≤ C * ‖α‖) ∧ Continuous (fun α : Covector (Euclid P) n => covectorEuclideanNorm α) := by
  intro P n
  classical
  -- Step 1: the coefficients `c_I α` and the coefficient vector `v α`, with `N α = ‖v α‖`
  let e := EuclideanSpace.basisFun (Fin P) ℝ
  let c : (Fin n → Fin P) → Covector (Euclid P) n → ℝ := fun I α =>
    if StrictMono I then α (fun i => e (I i)) else 0
  let v : Covector (Euclid P) n → EuclideanSpace ℝ (Fin n → Fin P) := fun α =>
    WithLp.toLp 2 (fun I => c I α)
  have hN : ∀ α : Covector (Euclid P) n, covectorEuclideanNorm α = ‖v α‖ := by
    intro α
    rw [EuclideanSpace.norm_eq]
    unfold covectorEuclideanNorm
    congr 1
    refine Finset.sum_congr rfl fun I _ => ?_
    by_cases hI : StrictMono I <;> simp [v, c, e, hI]
  -- Step 2: `v` is additive and `ℝ`-homogeneous
  have hadd : ∀ α α' : Covector (Euclid P) n, v (α + α') = v α + v α' := by
    intro α α'
    simp only [v, ← WithLp.toLp_add]
    congr 1
    funext I
    by_cases hI : StrictMono I <;> simp [c, hI]
  have hsmul : ∀ (t : ℝ) (α : Covector (Euclid P) n), v (t • α) = t • v α := by
    intro t α
    simp only [v, ← WithLp.toLp_smul]
    congr 1
    funext I
    by_cases hI : StrictMono I <;> simp [c, hI]
  -- Step 3: (i), the triangle inequality in `EuclideanSpace ℝ (Fin n → Fin P)`
  have h1 : ∀ α α' : Covector (Euclid P) n,
      covectorEuclideanNorm (α + α') ≤ covectorEuclideanNorm α + covectorEuclideanNorm α' := by
    intro α α'
    rw [hN, hN, hN, hadd]
    exact norm_add_le _ _
  -- Step 4: (ii), homogeneity of the Euclidean norm
  have h2 : ∀ (t : ℝ) (α : Covector (Euclid P) n),
      covectorEuclideanNorm (t • α) = |t| * covectorEuclideanNorm α := by
    intro t α
    rw [hN, hN, hsmul, norm_smul, Real.norm_eq_abs]
  -- Step 5: `|c_I α| ≤ ‖α‖ ∏ₖ ‖e_{I(k)}‖ = ‖α‖`
  have hc : ∀ (I : Fin n → Fin P) (α : Covector (Euclid P) n), |c I α| ≤ ‖α‖ := by
    intro I α
    by_cases hI : StrictMono I
    · simpa [c, e, hI, Real.norm_eq_abs] using α.le_opNorm (fun i => e (I i))
    · simp [c, hI]
  -- Step 6: (iii) with `C = √(card (Fin n → Fin P))`
  have h3 : ∀ α : Covector (Euclid P) n,
      covectorEuclideanNorm α ≤ Real.sqrt (Fintype.card (Fin n → Fin P)) * ‖α‖ := by
    intro α
    have hsum : ∑ I, ‖(v α).ofLp I‖ ^ 2 ≤ ∑ _I : Fin n → Fin P, ‖α‖ ^ 2 :=
      Finset.sum_le_sum fun I _ => by
        simpa [v, Real.norm_eq_abs] using pow_le_pow_left₀ (abs_nonneg _) (hc I α) 2
    rw [hN, EuclideanSpace.norm_eq]
    calc Real.sqrt (∑ I, ‖(v α).ofLp I‖ ^ 2) ≤ Real.sqrt (∑ _I : Fin n → Fin P, ‖α‖ ^ 2) :=
          Real.sqrt_le_sqrt hsum
      _ = Real.sqrt (Fintype.card (Fin n → Fin P)) * ‖α‖ := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
            Real.sqrt_mul (Nat.cast_nonneg _), Real.sqrt_sq (norm_nonneg _)]
  -- Step 7: (iv), `|N α - N α'| ≤ N (α - α') ≤ C ‖α - α'‖`, so `N` is Lipschitz
  have hlip : ∀ α α' : Covector (Euclid P) n, dist (covectorEuclideanNorm α)
      (covectorEuclideanNorm α') ≤ Real.sqrt (Fintype.card (Fin n → Fin P)) * dist α α' := by
    intro α α'
    have ha : covectorEuclideanNorm α ≤
        covectorEuclideanNorm (α - α') + covectorEuclideanNorm α' := by
      simpa only [sub_add_cancel] using h1 (α - α') α'
    have hb : covectorEuclideanNorm α' ≤
        covectorEuclideanNorm (α - α') + covectorEuclideanNorm α := by
      have h := h1 (α' - α) α
      rwa [sub_add_cancel, ← neg_sub, covectorEuclideanNorm_neg] at h
    have hC := h3 (α - α')
    rw [Real.dist_eq, dist_eq_norm, abs_le]
    constructor <;> linarith
  exact ⟨h1, h2, ⟨_, Real.sqrt_nonneg _, h3⟩,
    (LipschitzWith.of_dist_le_mul (K := ⟨_, Real.sqrt_nonneg _⟩) hlip).continuous⟩
/-- **Leibniz bound for `f • g`** (used for the cut-off pull-backs `ζ • L^#ω` in the
flat-convergence step behind Simon 7.4.3).  For `C^∞` maps `f : ℝ^Q → ℝ` and `g : ℝ^Q → F`,
`‖Dᵏ(f • g)(x)‖ ≤ ∑_{i ≤ k} C(k, i) ‖Dⁱf(x)‖ ‖D^{k-i}g(x)‖`.  This is Mathlib's
`norm_iteratedFDeriv_smul_le`, whose module `Mathlib.Analysis.Calculus.ContDiff.Bounds` is not
imported here, so its argument is reproduced: for a continuous bilinear `B` (all spaces in
`Type`), `‖Dⁿ(B(u, v))(z)‖ ≤ ‖B‖ ∑_{i ≤ n} C(n, i) ‖Dⁱu(z)‖ ‖D^{n-i}v(z)‖` by induction on `n`,
using `D(B(u, v)) = B.precompR(u, Dv) + B.precompL(Du, v)`, `‖B.precompR‖, ‖B.precompL‖ ≤ ‖B‖`
and Pascal's rule; then take `B = lsmul`, with `‖lsmul‖ ≤ 1`. -/
theorem Submission.dor_lmb_fc_dtop_cp_leibniz_smul_bound : ∀ (Q : ℕ) (F : Type) [NormedAddCommGroup F] [NormedSpace ℝ F] (f : Euclid Q → ℝ) (g : Euclid Q → F), ContDiff ℝ (⊤ : ℕ∞) f → ContDiff ℝ (⊤ : ℕ∞) g → ∀ (k : ℕ) (x : Euclid Q), ‖iteratedFDeriv ℝ k (fun y => f y • g y) x‖ ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * ‖iteratedFDeriv ℝ i f x‖ * ‖iteratedFDeriv ℝ (k - i) g x‖ := by
  intro Q F _ _ f g hf hg k x
  -- Steps 1–6: the bound for a continuous bilinear `B`, by induction on the order `n`,
  -- simultaneously for all real normed spaces `E₁, F₁, G₁` in `Type`
  have key : ∀ (n : ℕ) (E₁ F₁ G₁ : Type) [NormedAddCommGroup E₁] [NormedSpace ℝ E₁]
      [NormedAddCommGroup F₁] [NormedSpace ℝ F₁] [NormedAddCommGroup G₁] [NormedSpace ℝ G₁]
      (B : E₁ →L[ℝ] F₁ →L[ℝ] G₁) (u : Euclid Q → E₁) (v : Euclid Q → F₁),
      ContDiff ℝ ((n : ℕ) : WithTop ℕ∞) u → ContDiff ℝ ((n : ℕ) : WithTop ℕ∞) v →
      ∀ z : Euclid Q, ‖iteratedFDeriv ℝ n (fun y => B (u y) (v y)) z‖ ≤
        ‖B‖ * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * ‖iteratedFDeriv ℝ i u z‖ *
          ‖iteratedFDeriv ℝ (n - i) v z‖ := by
    intro n
    induction n with
    | zero =>
      -- Step 2: `‖B (u z) (v z)‖ ≤ ‖B‖ ‖u z‖ ‖v z‖`
      intro E₁ F₁ G₁ _ _ _ _ _ _ B u v _ _ z
      simp only [norm_iteratedFDeriv_zero, zero_add, Finset.range_one, Finset.sum_singleton,
        Nat.choose_self, Nat.cast_one, one_mul, Nat.sub_zero, ← mul_assoc]
      exact B.le_opNorm₂ (u z) (v z)
    | succ n IH =>
      intro E₁ F₁ G₁ _ _ _ _ _ _ B u v hu hv z
      -- Step 3: `u, v, Du, Dv` are `Cⁿ`
      have In : ((n : ℕ) : WithTop ℕ∞) + 1 ≤ ((n + 1 : ℕ) : WithTop ℕ∞) := by
        simp only [Nat.cast_succ, le_refl]
      have hu' : ContDiff ℝ ((n : ℕ) : WithTop ℕ∞) u := hu.of_le (Nat.cast_le.2 (Nat.le_succ n))
      have hv' : ContDiff ℝ ((n : ℕ) : WithTop ℕ∞) v := hv.of_le (Nat.cast_le.2 (Nat.le_succ n))
      have hDu : ContDiff ℝ ((n : ℕ) : WithTop ℕ∞) (fderiv ℝ u) := hu.fderiv_right In
      have hDv : ContDiff ℝ ((n : ℕ) : WithTop ℕ∞) (fderiv ℝ v) := hv.fderiv_right In
      -- the operator norms of `B.precompR`, `B.precompL` need these instances in scope
      let _ : NormedAddCommGroup ((Euclid Q →L[ℝ] F₁) →L[ℝ] Euclid Q →L[ℝ] G₁) := inferInstance
      let _ : NormedSpace ℝ ((Euclid Q →L[ℝ] F₁) →L[ℝ] Euclid Q →L[ℝ] G₁) := inferInstance
      let _ : NormedAddCommGroup (F₁ →L[ℝ] Euclid Q →L[ℝ] G₁) := inferInstance
      let _ : NormedSpace ℝ (F₁ →L[ℝ] Euclid Q →L[ℝ] G₁) := inferInstance
      -- Step 5, first term: the claim for `(B.precompR, u, Dv)`
      have I1 : ‖iteratedFDeriv ℝ n (fun y => B.precompR (Euclid Q) (u y) (fderiv ℝ v y)) z‖ ≤
          ‖B‖ * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * ‖iteratedFDeriv ℝ i u z‖ *
            ‖iteratedFDeriv ℝ (n + 1 - i) v z‖ := by
        calc ‖iteratedFDeriv ℝ n (fun y => B.precompR (Euclid Q) (u y) (fderiv ℝ v y)) z‖
            ≤ ‖B.precompR (Euclid Q)‖ * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
                ‖iteratedFDeriv ℝ i u z‖ * ‖iteratedFDeriv ℝ (n - i) (fderiv ℝ v) z‖ :=
              IH E₁ (Euclid Q →L[ℝ] F₁) (Euclid Q →L[ℝ] G₁) (B.precompR (Euclid Q)) u
                (fderiv ℝ v) hu' hDv z
          _ ≤ ‖B‖ * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
                ‖iteratedFDeriv ℝ i u z‖ * ‖iteratedFDeriv ℝ (n - i) (fderiv ℝ v) z‖ := by
              gcongr
              exact B.norm_precompR_le (Euclid Q)
          _ = ‖B‖ * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * ‖iteratedFDeriv ℝ i u z‖ *
                ‖iteratedFDeriv ℝ (n + 1 - i) v z‖ := by
              congr 1
              refine Finset.sum_congr rfl fun i hi => ?_
              rw [norm_iteratedFDeriv_fderiv,
                Nat.succ_sub (Nat.lt_succ_iff.1 (Finset.mem_range.1 hi))]
      -- Step 5, second term: the claim for `(B.precompL, Du, v)`
      have I2 : ‖iteratedFDeriv ℝ n (fun y => B.precompL (Euclid Q) (fderiv ℝ u y) (v y)) z‖ ≤
          ‖B‖ * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * ‖iteratedFDeriv ℝ (i + 1) u z‖ *
            ‖iteratedFDeriv ℝ (n - i) v z‖ := by
        calc ‖iteratedFDeriv ℝ n (fun y => B.precompL (Euclid Q) (fderiv ℝ u y) (v y)) z‖
            ≤ ‖B.precompL (Euclid Q)‖ * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
                ‖iteratedFDeriv ℝ i (fderiv ℝ u) z‖ * ‖iteratedFDeriv ℝ (n - i) v z‖ :=
              IH (Euclid Q →L[ℝ] E₁) F₁ (Euclid Q →L[ℝ] G₁) (B.precompL (Euclid Q)) (fderiv ℝ u)
                v hDu hv' z
          _ ≤ ‖B‖ * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
                ‖iteratedFDeriv ℝ i (fderiv ℝ u) z‖ * ‖iteratedFDeriv ℝ (n - i) v z‖ := by
              gcongr
              exact B.norm_precompL_le (Euclid Q)
          _ = ‖B‖ * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
                ‖iteratedFDeriv ℝ (i + 1) u z‖ * ‖iteratedFDeriv ℝ (n - i) v z‖ := by
              congr 1
              refine Finset.sum_congr rfl fun i _ => ?_
              rw [norm_iteratedFDeriv_fderiv]
      -- Step 3: `D(B(u, v)) = B.precompR(u, Dv) + B.precompL(Du, v)`
      have J : fderiv ℝ (fun y => B (u y) (v y)) = fun y =>
          B.precompR (Euclid Q) (u y) (fderiv ℝ v y) + B.precompL (Euclid Q) (fderiv ℝ u y) (v y) := by
        funext y
        exact B.fderiv_of_bilinear (hu.differentiable (by positivity) y)
          (hv.differentiable (by positivity) y)
      -- Step 4: split the top derivative and use the triangle inequality
      have A : ContDiff ℝ ((n : ℕ) : WithTop ℕ∞)
          (fun y => B.precompR (Euclid Q) (u y) (fderiv ℝ v y)) :=
        (B.precompR (Euclid Q)).isBoundedBilinearMap.contDiff.comp₂ hu' hDv
      have A' : ContDiff ℝ ((n : ℕ) : WithTop ℕ∞)
          (fun y => B.precompL (Euclid Q) (fderiv ℝ u y) (v y)) :=
        (B.precompL (Euclid Q)).isBoundedBilinearMap.contDiff.comp₂ hDu hv'
      rw [← norm_iteratedFDeriv_fderiv, J, fun_iteratedFDeriv_add_apply A.contDiffAt A'.contDiffAt]
      refine (norm_add_le _ _).trans ((add_le_add I1 I2).trans (le_of_eq ?_))
      -- Step 6: Pascal's rule
      simp_rw [← mul_add, mul_assoc]
      congr 1
      exact (Finset.sum_choose_succ_mul
        (fun i j => ‖iteratedFDeriv ℝ i u z‖ * ‖iteratedFDeriv ℝ j v z‖) n).symm
  -- Step 7: specialize to `B = lsmul`, with `‖lsmul‖ ≤ 1`
  have h := key k ℝ F F (ContinuousLinearMap.lsmul ℝ ℝ) f g (contDiff_infty.1 hf k)
    (contDiff_infty.1 hg k) x
  have hB : ‖(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] F →L[ℝ] F)‖ ≤ 1 :=
    ContinuousLinearMap.opNorm_lsmul_le
  have hsum : 0 ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * ‖iteratedFDeriv ℝ i f x‖ *
      ‖iteratedFDeriv ℝ (k - i) g x‖ := by positivity
  simp only [ContinuousLinearMap.lsmul_apply] at h
  exact h.trans (mul_le_of_le_one_left hsum hB)

/-- **Cut-off pull-backs of a null sequence of test forms tend to `0`** (Simon Ch. 6: the
topology of `𝒟ⁿ(U)` in §1, before 1.15, and the cut-off pull-back `ω ↦ ζ f^#ω` of 2.23, here for
linear `f`).  Let `L : ℝ^Q → ℝᴾ` be linear and `ζ` smooth with compact support.  If `ωⱼ → 0` in
`𝒟ᵈ(ℝᴾ)` and `ηⱼ = ζ · L^#ωⱼ`, then `ηⱼ → 0` in `𝒟ᵈ(ℝ^Q)`.  Every `ηⱼ` is supported in the
compact `spt ζ`.  Each `D^l ωⱼ → 0` uniformly on all of `ℝᴾ`, since it vanishes off the common
compact set.  The chain rule gives `‖D^l(L^#ωⱼ)(y)‖ ≤ ‖L‖ᵈ ‖L‖ˡ ‖D^l ωⱼ(Ly)‖`, and the
derivatives of `ζ` are bounded.  The Leibniz bound then gives `supᵧ ‖D^k ηⱼ(y)‖ → 0`. -/
theorem Submission.dor_lmb_fc_dtop_cp_cutoff_pullback_converges : ∀ (P Q d : ℕ) (L : Euclid Q →L[ℝ] Euclid P) (ζ : Euclid Q → ℝ), ContDiff ℝ (⊤ : ℕ∞) ζ → HasCompactSupport ζ → ∀ (ωs : ℕ → TestFormOn (univ : Set (Euclid P)) d) (ηs : ℕ → TestFormOn (univ : Set (Euclid Q)) d), (∀ (j : ℕ) (y : Euclid Q), (ηs j : DifferentialForm (Euclid Q) d) y = ζ y • ((ωs j : DifferentialForm (Euclid P) d) (L y)).compContinuousLinearMap L) → TestFormOnConverges ωs 0 → TestFormOnConverges ηs 0 := by
  intro P Q d L ζ hζ hζc ωs ηs hη hω
  -- Step 1: a compact `C ⊇ tsupport ωⱼ` on which every `D^l ωⱼ → 0` uniformly
  obtain ⟨C, -, -, hωC, -, hωD⟩ := hω
  have hωs : ∀ j, ContDiff ℝ (⊤ : ℕ∞) (ωs j : DifferentialForm (Euclid P) d) := fun j =>
    (ωs j).property.1.1
  -- Step 2: `D^l ωⱼ → 0` uniformly on all of `ℝᴾ`, since it vanishes off `C`
  have hdecay : ∀ (l : ℕ) (ε : ℝ), 0 < ε → ∀ᶠ j in atTop, ∀ x : Euclid P,
      ‖iteratedFDeriv ℝ l (ωs j : DifferentialForm (Euclid P) d) x‖ < ε := by
    intro l ε hε
    filter_upwards [Metric.tendstoUniformlyOn_iff.mp (hωD l) ε hε] with j hj x
    by_cases hx : x ∈ C
    · have hjx := hj x hx
      simp only [ZeroMemClass.coe_zero, iteratedFDeriv_zero, Pi.zero_apply, dist_zero_left] at hjx
      exact hjx
    · have hx' : x ∉ tsupport (iteratedFDeriv ℝ l (ωs j : DifferentialForm (Euclid P) d)) :=
        fun h => hx (hωC j (tsupport_iteratedFDeriv_subset l h))
      rw [image_eq_zero_of_notMem_tsupport hx', norm_zero]
      exact hε
  -- Step 3: `ηⱼ = ζ • gⱼ` with `gⱼ = Λ ∘ ωⱼ ∘ L` smooth, where `Λ α = α ∘ (L × ⋯ × L)`
  let Λ : Covector (Euclid P) d →L[ℝ] Covector (Euclid Q) d :=
    ContinuousAlternatingMap.compContinuousLinearMapCLM L
  let g : ℕ → Euclid Q → Covector (Euclid Q) d := fun j y =>
    ((ωs j : DifferentialForm (Euclid P) d) (L y)).compContinuousLinearMap L
  have hgΛ : ∀ j, g j = Λ ∘ ((ωs j : DifferentialForm (Euclid P) d) ∘ L) := fun j => rfl
  have hηg : ∀ j, (ηs j : DifferentialForm (Euclid Q) d) = fun y => ζ y • g j y := fun j =>
    funext (hη j)
  have hgs : ∀ j, ContDiff ℝ (⊤ : ℕ∞) (g j) := fun j => by
    rw [hgΛ j]
    exact Λ.contDiff.comp ((hωs j).comp L.contDiff)
  -- Step 4: `‖D^l gⱼ(y)‖ ≤ ‖L‖ᵈ ‖L‖ˡ ‖D^l ωⱼ(Ly)‖`, as `D^l gⱼ(y) = Λ ∘ D^l ωⱼ(Ly) ∘ (L, …, L)`
  have hΛ : ∀ (l : ℕ) (A : ContinuousMultilinearMap ℝ (fun _ : Fin l => Euclid Q)
      (Covector (Euclid P) d)), ‖Λ.compContinuousMultilinearMap A‖ ≤ ‖L‖ ^ d * ‖A‖ := by
    intro l A
    refine ContinuousMultilinearMap.opNorm_le_bound (by positivity) fun m => ?_
    calc ‖Λ.compContinuousMultilinearMap A m‖ = ‖(A m).compContinuousLinearMap L‖ := rfl
      _ ≤ ‖A m‖ * ‖L‖ ^ Fintype.card (Fin d) := (A m).norm_compContinuousLinearMap_le L
      _ ≤ ‖A‖ * (∏ i, ‖m i‖) * ‖L‖ ^ d := by
          rw [Fintype.card_fin]
          gcongr
          exact A.le_opNorm m
      _ = ‖L‖ ^ d * ‖A‖ * ∏ i, ‖m i‖ := by ring
  have hgD : ∀ (l j : ℕ) (y : Euclid Q), ‖iteratedFDeriv ℝ l (g j) y‖ ≤
      ‖L‖ ^ d * (‖iteratedFDeriv ℝ l (ωs j : DifferentialForm (Euclid P) d) (L y)‖ * ‖L‖ ^ l) := by
    intro l j y
    rw [hgΛ j, Λ.iteratedFDeriv_comp_left (i := l) ((hωs j).comp L.contDiff).contDiffAt (by simp),
      L.iteratedFDeriv_comp_right (i := l) (hωs j) y (by simp)]
    refine (hΛ l _).trans ?_
    gcongr
    refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans_eq ?_
    simp
  -- Step 5: every `D^i ζ` is bounded
  have hZ : ∀ i : ℕ, ∃ Z : ℝ, ∀ y, ‖iteratedFDeriv ℝ i ζ y‖ ≤ Z := fun i =>
    (hζ.continuous_iteratedFDeriv (m := i) (by simp)).bounded_above_of_compact_support
      (hζc.iteratedFDeriv i)
  choose Z hZ using hZ
  -- Steps 6 and 8: all supports lie in the compact set `tsupport ζ`
  refine ⟨tsupport ζ, hζc.isCompact, subset_univ _, fun j => ?_, ?_, fun k => ?_⟩
  · rw [hηg j]
    exact tsupport_smul_subset_left _ _
  · simp
  -- Step 7: eventually `‖D^k ηⱼ(y)‖ ≤ S δ < ε` for all `y`, with `δ = ε / (S + 1)`
  refine Metric.tendstoUniformlyOn_iff.mpr fun ε hε => ?_
  obtain ⟨S, hS⟩ : ∃ S : ℝ, S = ∑ i ∈ Finset.range (k + 1),
      (k.choose i : ℝ) * |Z i| * (‖L‖ ^ d * ‖L‖ ^ (k - i)) := ⟨_, rfl⟩
  have hS0 : 0 ≤ S := by
    rw [hS]
    exact Finset.sum_nonneg fun i _ => by positivity
  have hδ : 0 < ε / (S + 1) := div_pos hε (by linarith)
  have hev : ∀ᶠ j in atTop, ∀ i ∈ Finset.range (k + 1), ∀ x : Euclid P,
      ‖iteratedFDeriv ℝ (k - i) (ωs j : DifferentialForm (Euclid P) d) x‖ < ε / (S + 1) :=
    (Filter.eventually_all_finset _).2 fun i _ => hdecay (k - i) _ hδ
  filter_upwards [hev] with j hj y _
  simp only [ZeroMemClass.coe_zero, iteratedFDeriv_zero, Pi.zero_apply, dist_zero_left]
  rw [hηg j]
  calc ‖iteratedFDeriv ℝ k (fun y => ζ y • g j y) y‖
      ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * ‖iteratedFDeriv ℝ i ζ y‖ *
          ‖iteratedFDeriv ℝ (k - i) (g j) y‖ :=
        Submission.dor_lmb_fc_dtop_cp_leibniz_smul_bound Q (Covector (Euclid Q) d) ζ (g j) hζ
          (hgs j) k y
    _ ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |Z i| *
          (‖L‖ ^ d * ‖L‖ ^ (k - i) * (ε / (S + 1))) := by
        refine Finset.sum_le_sum fun i hi => ?_
        have h1 : ‖iteratedFDeriv ℝ i ζ y‖ ≤ |Z i| := (hZ i y).trans (le_abs_self _)
        have h2 : ‖iteratedFDeriv ℝ (k - i) (g j) y‖ ≤
            ‖L‖ ^ d * ‖L‖ ^ (k - i) * (ε / (S + 1)) := by
          refine (hgD (k - i) j y).trans ?_
          have h3 := (hj i hi (L y)).le
          calc ‖L‖ ^ d * (‖iteratedFDeriv ℝ (k - i) (ωs j : DifferentialForm (Euclid P) d) (L y)‖ *
                ‖L‖ ^ (k - i)) ≤ ‖L‖ ^ d * (ε / (S + 1) * ‖L‖ ^ (k - i)) := by gcongr
            _ = ‖L‖ ^ d * ‖L‖ ^ (k - i) * (ε / (S + 1)) := by ring
        gcongr
    _ = S * (ε / (S + 1)) := by
        rw [hS, Finset.sum_mul]
        exact Finset.sum_congr rfl fun i _ => by ring
    _ < ε := by
        rw [← mul_div_assoc, div_lt_iff₀ (by linarith)]
        nlinarith

/-- **Cut-off pull-back of test forms along the coordinate projection `ℝ^{P+1} → ℝᴾ`** (Simon
Ch. 6, 2.23 for the projection `p`; used for the top-dimensional deformation step behind 7.4.3).
Given a compact `K`, choose `K ⊆ V = B_r(0)` and a `C^∞` bump `ζ` with `0 ≤ ζ ≤ 1`, `ζ = 1` on
`B̄_r(0)` and compact support, and put `E ω = ζ · p^#ω`, `(p^#ω)(y) = ω(py)(p·, …, p·)`.  Then `E`
is linear, `E ω = p^#ω` on `V`, so `d(E ω) = p^#(dω)` on the open set `V` (locality of `d` and
`d ∘ p^# = p^# ∘ d`); `spt E ω ⊆ spt p^#ω ⊆ p⁻¹(spt ω)`; `|E ω(y)| = ζ(y) |ω(py)| ≤ |ω(py)|`, as
`p^*` preserves the Euclidean coefficient norm; and `ωⱼ → 0` implies `E ωⱼ → 0`. -/
theorem Submission.dor_lmb_fc_dtop_cutoff_pullback : ∀ (P d : ℕ) (p : Euclid (P + 1) →L[ℝ] Euclid P), (∀ (y : Euclid (P + 1)) (i : Fin P), p y i = y (Fin.castSucc i)) → ∀ K : Set (Euclid (P + 1)), IsCompact K → ∃ (V : Set (Euclid (P + 1))) (E : TestFormOn (univ : Set (Euclid P)) d →ₗ[ℝ] TestFormOn (univ : Set (Euclid (P + 1))) d), IsOpen V ∧ K ⊆ V ∧ (∀ (ω : TestFormOn (univ : Set (Euclid P)) d) (y : Euclid (P + 1)), y ∈ V → (E ω : DifferentialForm (Euclid (P + 1)) d) y = ((ω : DifferentialForm (Euclid P) d) (p y)).compContinuousLinearMap p) ∧ (∀ (ω : TestFormOn (univ : Set (Euclid P)) d) (y : Euclid (P + 1)), y ∈ V → exteriorDerivative (E ω : DifferentialForm (Euclid (P + 1)) d) y = (exteriorDerivative (ω : DifferentialForm (Euclid P) d) (p y)).compContinuousLinearMap p) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) d, tsupport (E ω : DifferentialForm (Euclid (P + 1)) d) ⊆ p ⁻¹' tsupport (ω : DifferentialForm (Euclid P) d)) ∧ (∀ (ω : TestFormOn (univ : Set (Euclid P)) d) (y : Euclid (P + 1)), covectorEuclideanNorm ((E ω : DifferentialForm (Euclid (P + 1)) d) y) ≤ covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) d) (p y))) ∧ ∀ ωs : ℕ → TestFormOn (univ : Set (Euclid P)) d, TestFormOnConverges ωs 0 → TestFormOnConverges (fun j => E (ωs j)) 0 := by
  intro P d p hp K hK
  -- Step 1: `K ⊆ V = B_r(0)`, and a `C^∞` bump `ζ` with `ζ = 1` on `B̄_r(0)` and compact support
  obtain ⟨r, hr, hKr⟩ := hK.isBounded.subset_ball_lt 0 (0 : Euclid (P + 1))
  let ζ : ContDiffBump (0 : Euclid (P + 1)) := ⟨r, r + 1, hr, lt_add_one r⟩
  have hζV : ∀ y ∈ ball (0 : Euclid (P + 1)) r, ζ y = 1 := fun y hy =>
    ζ.one_of_mem_closedBall (ball_subset_closedBall hy)
  -- Step 2: `p^#ω = Λ ∘ ω ∘ p` with `Λ α = α(p·, …, p·)`; `E ω = ζ • p^#ω` is a test form
  let Λ : Covector (Euclid P) d →L[ℝ] Covector (Euclid (P + 1)) d :=
    ContinuousAlternatingMap.compContinuousLinearMapCLM p
  have hmem : ∀ ω : TestFormOn (univ : Set (Euclid P)) d,
      (fun y => ζ y • ((ω : DifferentialForm (Euclid P) d) (p y)).compContinuousLinearMap p) ∈
        TestFormOn (univ : Set (Euclid (P + 1))) d := by
    intro ω
    have hω : ContDiff ℝ (⊤ : ℕ∞) (ω : DifferentialForm (Euclid P) d) := ω.property.1.1
    refine ⟨⟨?_, ?_⟩, subset_univ _⟩
    · exact ζ.contDiff.smul (Λ.contDiff.comp (hω.comp p.contDiff))
    · exact ζ.hasCompactSupport.smul_right
  -- Step 3: `E` is linear, since `ω ↦ ω(py)(p·, …, p·)` is
  let E : TestFormOn (univ : Set (Euclid P)) d →ₗ[ℝ] TestFormOn (univ : Set (Euclid (P + 1))) d :=
    { toFun := fun ω => ⟨_, hmem ω⟩
      map_add' := fun ω η => by
        apply Subtype.ext
        funext y
        ext v
        simp [mul_add]
      map_smul' := fun c ω => by
        apply Subtype.ext
        funext y
        ext v
        simp [mul_left_comm] }
  have hE : ∀ (ω : TestFormOn (univ : Set (Euclid P)) d) (y : Euclid (P + 1)),
      (E ω : DifferentialForm (Euclid (P + 1)) d) y =
        ζ y • ((ω : DifferentialForm (Euclid P) d) (p y)).compContinuousLinearMap p :=
    fun _ _ => rfl
  refine ⟨ball 0 r, E, isOpen_ball, hKr, ?_, ?_, ?_, ?_, ?_⟩
  -- Step 4: (i), `E ω = p^#ω` on `V`, where `ζ = 1`
  · intro ω y hy
    rw [hE, hζV y hy, one_smul]
  -- Step 5: (ii), `E ω = p^#ω` near `y ∈ V` (`V` open), and `d(p^#ω) = p^#(dω)`
  · intro ω y hy
    have hω : ContDiff ℝ (⊤ : ℕ∞) (ω : DifferentialForm (Euclid P) d) := ω.property.1.1
    have hloc : (E ω : DifferentialForm (Euclid (P + 1)) d) =ᶠ[𝓝 y]
        affinePullbackForm p 0 (ω : DifferentialForm (Euclid P) d) := by
      filter_upwards [isOpen_ball.mem_nhds hy] with z hz
      rw [hE, hζV z hz, one_smul]
      simp [affinePullbackForm]
    calc exteriorDerivative (E ω : DifferentialForm (Euclid (P + 1)) d) y
        = exteriorDerivative (affinePullbackForm p 0 (ω : DifferentialForm (Euclid P) d)) y :=
          hloc.extDeriv_eq
      _ = affinePullbackForm p 0 (exteriorDerivative (ω : DifferentialForm (Euclid P) d)) y :=
          congrFun (exteriorDerivative_affinePullbackForm p 0 hω) y
      _ = (exteriorDerivative (ω : DifferentialForm (Euclid P) d) (p y)).compContinuousLinearMap
            p := by
          simp [affinePullbackForm]
  -- Step 6: (iii), `spt (ζ • p^#ω) ⊆ spt p^#ω = spt (Λ ∘ (ω ∘ p)) ⊆ p⁻¹(spt ω)`
  · intro ω
    show tsupport (fun y => ζ y •
      ((ω : DifferentialForm (Euclid P) d) (p y)).compContinuousLinearMap p) ⊆ _
    exact (tsupport_smul_subset_right (fun y => ζ y)
      (fun y => ((ω : DifferentialForm (Euclid P) d) (p y)).compContinuousLinearMap p)).trans
      ((tsupport_comp_subset (g := Λ) (map_zero Λ) ((ω : DifferentialForm (Euclid P) d) ∘ p)).trans
        (tsupport_comp_subset_preimage (ω : DifferentialForm (Euclid P) d) p.continuous))
  -- Step 7: (iv), `|ζ(y) p^*(ω(py))| = |ζ(y)| |ω(py)| ≤ |ω(py)|`, as `0 ≤ ζ ≤ 1`
  · intro ω y
    rw [hE, (Submission.rsd_mw_tfa_norm_props (P + 1) d).2.1,
      Submission.dor_lmb_fc_dtop_cp_proj_covector_norm P d p hp, abs_of_nonneg (ζ.nonneg' y)]
    exact mul_le_of_le_one_left (covectorEuclideanNorm_nonneg _) ζ.le_one
  -- Step 8: (v), sequential continuity of the cut-off pull-back
  · intro ωs hωs
    exact Submission.dor_lmb_fc_dtop_cp_cutoff_pullback_converges P (P + 1) d p ζ ζ.contDiff
      ζ.hasCompactSupport ωs (fun j => E (ωs j)) (fun j y => hE (ωs j) y) hωs
/-- **Projected cells of the cubical grid of side `ρ` in `ℝ^{N+1}`** (parent steps 5(c) and 9;
the top-dimensional case of the Deformation Theorem, Simon Ch. 6, 5.1).  `p : ℝ^{N+1} → ℝᴺ`
forgets the last coordinate, `ι : Fin N → Fin (N + 1)` is strictly increasing, `F̃` is the cell
at `z` spanned by the directions `ι`, and `G` is the cube at `z ∘ castSucc`.  (a) If
`last ∈ range ι`, one argument of `ω(py)(pe_{ι 0}, …, pe_{ι (N−1)})` is `p e_last = 0`, so the
integrand vanishes.  (b) Otherwise `ι = castSucc` and `p e_{castSucc k} = e_k`; the isometric
embedding `j(x) = (x, ρ z_last)` has `p ∘ j = id` and `j(G) = F̃`, so
`μHE[N].map j = μHE[N]⌞range j` turns `∫_{F̃} ⋯ dHᴺ` into `∫_G ω(x)(e_0, …, e_{N−1}) dHᴺ`, and
`G = p(F̃)`. -/
theorem Submission.dor_lmb_fc_dtop_projected_cell_integral : ∀ (N : ℕ) (ρ : ℝ) (p : Euclid (N + 1) →L[ℝ] Euclid N) (z : Fin (N + 1) → ℤ) (ι : Fin N → Fin (N + 1)), (∀ (y : Euclid (N + 1)) (i : Fin N), p y i = y (Fin.castSucc i)) → StrictMono ι → (Fin.last N ∈ Set.range ι → ∀ ω : DifferentialForm (Euclid N) N, ∫ y in {y : Euclid (N + 1) | ∀ i : Fin (N + 1), (i ∈ Set.range ι → ρ * z i ≤ y i ∧ y i ≤ ρ * (z i + 1)) ∧ (i ∉ Set.range ι → y i = ρ * z i)}, ω (p y) (fun k => p (EuclideanSpace.single (ι k) (1 : ℝ))) ∂μHE[N] = 0) ∧ (Fin.last N ∉ Set.range ι → (∀ ω : DifferentialForm (Euclid N) N, ∫ y in {y : Euclid (N + 1) | ∀ i : Fin (N + 1), (i ∈ Set.range ι → ρ * z i ≤ y i ∧ y i ≤ ρ * (z i + 1)) ∧ (i ∉ Set.range ι → y i = ρ * z i)}, ω (p y) (fun k => p (EuclideanSpace.single (ι k) (1 : ℝ))) ∂μHE[N] = ∫ x in {x : Euclid N | ∀ i : Fin N, ρ * z (Fin.castSucc i) ≤ x i ∧ x i ≤ ρ * (z (Fin.castSucc i) + 1)}, ω x (fun k => EuclideanSpace.single k (1 : ℝ)) ∂μHE[N]) ∧ ∀ x : Euclid N, (∀ i : Fin N, ρ * z (Fin.castSucc i) ≤ x i ∧ x i ≤ ρ * (z (Fin.castSucc i) + 1)) → ∃ y : Euclid (N + 1), (∀ i : Fin (N + 1), (i ∈ Set.range ι → ρ * z i ≤ y i ∧ y i ≤ ρ * (z i + 1)) ∧ (i ∉ Set.range ι → y i = ρ * z i)) ∧ p y = x) := by
  intro N ρ p z ι hp hι
  -- Step 1: `p e_last = 0` and `p e_{castSucc k} = e_k`.
  have hplast : p (EuclideanSpace.single (Fin.last N) (1 : ℝ)) = 0 := by
    ext i
    rw [hp]
    simp only [PiLp.single_apply, Fin.castSucc_ne_last, ↓reduceIte, PiLp.zero_apply]
  have hpcs : ∀ k : Fin N,
      p (EuclideanSpace.single (Fin.castSucc k) (1 : ℝ)) = EuclideanSpace.single k (1 : ℝ) := by
    intro k
    ext i
    rw [hp]
    simp only [PiLp.single_apply, Fin.castSucc_inj]
  refine ⟨?_, fun hlast => ?_⟩
  · -- (a) Step 2: if `ι k₀ = last`, the `k₀`-th argument `p e_last` is `0`, so the integrand
    -- vanishes identically.
    rintro ⟨k₀, hk₀⟩ ω
    have h0 : ∀ y : Euclid (N + 1),
        ω (p y) (fun k => p (EuclideanSpace.single (ι k) (1 : ℝ))) = 0 := fun y =>
      (ω (p y)).map_coord_zero k₀ (by simp only [hk₀, hplast])
    simp only [h0, integral_zero]
  · -- (b) Step 3: `ι` avoids `last`, so `ι = castSucc ∘ ι'` with `ι' : Fin N → Fin N` strictly
    -- increasing, hence injective, hence surjective, hence `ι' = id`.
    let ι' : Fin N → Fin N := fun k => (ι k).castPred fun h => hlast ⟨k, h⟩
    have hι' : StrictMono ι' := fun a b hab => by
      simpa [ι', Fin.castPred_lt_castPred_iff] using hι hab
    have hι'id : ι' = id := by
      refine (hι'.range_inj_of_wellFoundedLT strictMono_id).1 ?_
      rw [range_id]
      exact (Finite.injective_iff_surjective.1 hι'.injective).range_eq
    have hιcs : ι = Fin.castSucc := by
      funext k
      exact (Fin.castSucc_castPred (ι k) fun h => hlast ⟨k, h⟩).symm.trans
        (congrArg Fin.castSucc (congrFun hι'id k))
    subst hιcs
    -- Step 4: the isometric embedding `j(x) = (x, ρ z_last)`, with `p ∘ j = id`.
    let j : Euclid N → Euclid (N + 1) := fun x =>
      WithLp.toLp 2 (Fin.snoc (α := fun _ => ℝ) (fun i => x i) (ρ * z (Fin.last N)))
    have hj_cs : ∀ (x : Euclid N) (i : Fin N), j x (Fin.castSucc i) = x i := by
      intro x i
      simp [j]
    have hj_last : ∀ x : Euclid N, j x (Fin.last N) = ρ * z (Fin.last N) := by
      intro x
      simp [j]
    have hpj : ∀ x : Euclid N, p (j x) = x := by
      intro x
      ext i
      rw [hp, hj_cs]
    have hjiso : Isometry j := by
      refine Isometry.of_dist_eq fun x x' => ?_
      rw [EuclideanSpace.dist_eq, EuclideanSpace.dist_eq, Fin.sum_univ_castSucc]
      simp only [hj_cs, hj_last, dist_self]
      simp
    have hjme : MeasurableEmbedding j := hjiso.isClosedEmbedding.measurableEmbedding
    set S : Set (Euclid (N + 1)) := {y : Euclid (N + 1) | ∀ i : Fin (N + 1),
      (i ∈ Set.range Fin.castSucc → ρ * z i ≤ y i ∧ y i ≤ ρ * (z i + 1)) ∧
        (i ∉ Set.range Fin.castSucc → y i = ρ * z i)}
    set G : Set (Euclid N) := {x : Euclid N | ∀ i : Fin N,
      ρ * z (Fin.castSucc i) ≤ x i ∧ x i ≤ ρ * (z (Fin.castSucc i) + 1)}
    -- `j⁻¹(F̃) = G` and `F̃ ⊆ range j`, i.e. `F̃ = j(G)`.
    have hnotlast : ∀ i : Fin (N + 1), i ∉ Set.range Fin.castSucc → i = Fin.last N := by
      intro i hi
      by_contra hne
      exact hi ⟨i.castPred hne, Fin.castSucc_castPred i hne⟩
    have hpre : j ⁻¹' S = G := by
      ext x
      simp only [S, G, Set.mem_preimage, Set.mem_ofPred_eq]
      constructor
      · intro h i
        have h' := (h (Fin.castSucc i)).1 ⟨i, rfl⟩
        rwa [hj_cs] at h'
      · intro h i
        refine ⟨?_, fun hi => ?_⟩
        · rintro ⟨i', rfl⟩
          rw [hj_cs]
          exact h i'
        · obtain rfl := hnotlast i hi
          rw [hj_last]
    have hSsub : S ⊆ Set.range j := by
      intro y hy
      refine ⟨p y, ?_⟩
      ext i
      induction i using Fin.lastCases with
      | last =>
        rw [hj_last]
        exact ((hy (Fin.last N)).2 fun ⟨k, hk⟩ => Fin.castSucc_ne_last k hk).symm
      | cast i => rw [hj_cs, hp]
    -- Step 5: `Hᴺ⌞F̃ = j_#(Hᴺ⌞G)` since `μHE[N].map j = μHE[N]⌞range j`; change variables.
    have hmeas : (μHE[N] : Measure (Euclid (N + 1))).restrict S =
        ((μHE[N] : Measure (Euclid N)).restrict G).map j := by
      rw [← hpre, ← hjme.restrict_map, hjiso.map_euclideanHausdorffMeasure,
        Measure.restrict_restrict_of_subset hSsub]
    refine ⟨fun ω => ?_, fun x hx => ⟨j x, ?_, hpj x⟩⟩
    · rw [hmeas, hjme.integral_map]
      simp only [hpj, hpcs]
    · show j x ∈ S
      rw [← Set.mem_preimage, hpre]
      exact hx
/-- **Simon 6.1.15, 6.3.4–3.5** (Euclidean coefficient norm versus Gram determinants):
(1) `|α(v₁, …, vₙ)| ≤ |α|_E · det(⟨vᵢ, vⱼ⟩)^{1/2}` for every `n`-covector `α` on `ℝᴾ`;
(2) every orthonormal `τ₁, …, τₙ` admits an `n`-covector `α` with `|α|_E ≤ 1` and `α(τ) = 1`.
Expand `α(v) = Σ_I α(e_I) det V_I` over strictly increasing `I` (multilinearity, alternation,
Leibniz).  For the determinant covector `u ↦ det(⟨uₐ, v_b⟩)` this is Cauchy–Binet,
`det(⟨vᵢ, vⱼ⟩) = Σ_I (det V_I)²`; then (1) is Cauchy–Schwarz over the `I`, and (2) holds for the
determinant covector of `τ`. -/
theorem Submission.covectorEuclideanNorm_gram_bounds : ∀ (P n : ℕ), (∀ (α : Covector (Euclid P) n) (v : Fin n → Euclid P), |α v| ≤ covectorEuclideanNorm α * Real.sqrt (Matrix.det (Matrix.of fun i j => inner ℝ (v i) (v j)))) ∧ ∀ τ : Fin n → Euclid P, Orthonormal ℝ τ → ∃ α : Covector (Euclid P) n, covectorEuclideanNorm α ≤ 1 ∧ α τ = 1 := by
  intro P n
  classical
  set e := EuclideanSpace.basisFun (Fin P) ℝ with he
  -- `α(v) = Σ_I α(e_I) det V_I` over strictly increasing `I`, with `(V_I)ₐⱼ = ⟨e_{I a}, vⱼ⟩`
  have hexp : ∀ (α : Covector (Euclid P) n) (v : Fin n → Euclid P),
      α v = ∑ I : Fin n → Fin P, if StrictMono I then
        α (fun i => e (I i)) * Matrix.det (Matrix.of fun a j => inner ℝ (e (I a)) (v j)) else 0 := by
    intro α v
    set c : Fin n → Fin P → ℝ := fun j k => inner ℝ (e k) (v j) with hc
    have hv : v = fun j => ∑ k, c j k • e k := funext fun j => (e.sum_repr' (v j)).symm
    -- multilinearity: `α(v) = Σ_f (∏ⱼ vⱼ(f j)) α(e_f)`
    have h2 : α v = ∑ f : Fin n → Fin P, (∏ j, c j (f j)) * α (fun j => e (f j)) := by
      conv_lhs => rw [hv]
      rw [α.map_sum]
      refine Finset.sum_congr rfl fun f _ => ?_
      rw [← smul_eq_mul, ← α.map_smul_univ]
    -- alternation: non-injective `f` contribute `0`
    have h3 : ∀ f : Fin n → Fin P, ¬ Injective f → α (fun j => e (f j)) = 0 := fun f hf =>
      α.map_eq_zero_of_not_injective _ (fun h => hf (Injective.of_comp (f := ⇑e) h))
    rw [h2, ← Finset.sum_filter_of_ne (p := Injective) (fun f _ hne => by
      by_contra hf
      exact hne (by rw [h3 f hf, mul_zero]))]
    rw [← Finset.sum_filter]
    simp only [Matrix.det_apply, Matrix.of_apply, Finset.mul_sum]
    rw [← Finset.sum_product']
    symm
    -- `(I, σ) ↦ I ∘ σ` is a bijection onto the injective `f`; `α(e_{I ∘ σ}) = sgn σ · α(e_I)`
    refine Finset.sum_bij (fun p _ => fun j => p.1 (p.2 j)) ?_ ?_ ?_ ?_
    · intro p hp
      simp only [Finset.mem_product, Finset.mem_filter, Finset.mem_univ, true_and] at hp ⊢
      exact hp.1.injective.comp p.2.injective
    · intro p hp q hq hpq
      simp only [Finset.mem_product, Finset.mem_filter, Finset.mem_univ, true_and, and_true] at hp hq
      have hrange : Set.range p.1 = Set.range q.1 := by
        have h1 : Set.range (fun j => p.1 (p.2 j)) = Set.range p.1 := (EquivLike.range_comp p.1 p.2)
        have h2 : Set.range (fun j => q.1 (q.2 j)) = Set.range q.1 := (EquivLike.range_comp q.1 q.2)
        rw [← h1, ← h2, hpq]
      have hI : p.1 = q.1 := (StrictMono.range_inj_of_wellFoundedLT hp hq).mp hrange
      have hσ : p.2 = q.2 := by
        ext j
        have := congr_fun hpq j
        rw [hI] at this
        exact congrArg Fin.val (hq.injective this)
      exact Prod.ext hI hσ
    · intro f hf
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hf
      refine ⟨(f ∘ Tuple.sort f, (Tuple.sort f)⁻¹), ?_, ?_⟩
      · simp only [Finset.mem_product, Finset.mem_filter, Finset.mem_univ, true_and, and_true]
        exact (Tuple.monotone_sort f).strictMono_of_injective (hf.comp (Tuple.sort f).injective)
      · funext j
        simp
    · intro p hp
      have hperm : α (fun j => e (p.1 (p.2 j))) = Equiv.Perm.sign p.2 • α (fun j => e (p.1 j)) :=
        α.toAlternatingMap.map_perm (fun j => e (p.1 j)) p.2
      rw [hperm]
      simp only [hc, Units.smul_def, zsmul_eq_mul]
      ring
  -- the determinant covector `u ↦ det(⟨uₐ, τ_b⟩)`
  have hdet : ∀ τ : Fin n → Euclid P, ∃ β : Covector (Euclid P) n,
      ∀ u : Fin n → Euclid P, β u = Matrix.det (Matrix.of fun a b => inner ℝ (u a) (τ b)) := by
    intro τ
    let L : Euclid P →ₗ[ℝ] (Fin n → ℝ) :=
      LinearMap.pi fun b => (innerSL ℝ (τ b) : Euclid P →L[ℝ] ℝ).toLinearMap
    let f : Euclid P [⋀^Fin n]→ₗ[ℝ] ℝ := Matrix.detRowAlternating.compLinearMap L
    have hf : ∀ u, f u = Matrix.det (Matrix.of fun a b => inner ℝ (u a) (τ b)) := by
      intro u
      show Matrix.det (Matrix.of fun a b => L (u a) b) = _
      congr 1
      ext a b
      simp [L, real_inner_comm]
    have hcont : Continuous fun u : Fin n → Euclid P =>
        Matrix.det (Matrix.of fun a b => inner ℝ (u a) (τ b)) := by
      apply Continuous.matrix_det
      apply continuous_matrix
      intro a b
      exact Continuous.inner (f := fun u : Fin n → Euclid P => u a) (g := fun _ => τ b)
        (continuous_apply a) continuous_const
    refine ⟨{ f with cont := ?_ }, fun u => hf u⟩
    have : (f : (Fin n → Euclid P) → ℝ) =
        fun u => Matrix.det (Matrix.of fun a b => inner ℝ (u a) (τ b)) := funext hf
    simpa [this] using hcont
  -- Cauchy–Binet: `det(⟨vᵢ, vⱼ⟩) = Σ_I (det V_I)²`, the expansion of the determinant covector of `v`
  have hcb : ∀ v : Fin n → Euclid P, Matrix.det (Matrix.of fun i j => inner ℝ (v i) (v j)) =
      ∑ I : Fin n → Fin P, if StrictMono I then
        Matrix.det (Matrix.of fun a j => inner ℝ (e (I a)) (v j)) ^ 2 else 0 := by
    intro v
    obtain ⟨β, hβ⟩ := hdet v
    rw [← hβ v, hexp β v]
    refine Finset.sum_congr rfl fun I _ => ?_
    split_ifs
    · rw [hβ, pow_two]
    · rfl
  refine ⟨fun α v => ?_, fun τ hτ => ?_⟩
  · -- (1): Cauchy–Schwarz for `Σ_I α(e_I) det V_I`
    set a : (Fin n → Fin P) → ℝ := fun I => if StrictMono I then α (fun i => e (I i)) else 0
      with ha
    set d : (Fin n → Fin P) → ℝ := fun I => if StrictMono I then
      Matrix.det (Matrix.of fun a j => inner ℝ (e (I a)) (v j)) else 0 with hd
    have hv : α v = ∑ I, a I * d I := by
      rw [hexp α v]
      refine Finset.sum_congr rfl fun I _ => ?_
      simp only [ha, hd]
      split_ifs <;> simp
    have hnorm : covectorEuclideanNorm α = Real.sqrt (∑ I, a I ^ 2) := by
      unfold covectorEuclideanNorm
      rw [← he]
      congr 1
      refine Finset.sum_congr rfl fun I _ => ?_
      simp only [ha]
      split_ifs <;> simp
    have hgram : Matrix.det (Matrix.of fun i j => inner ℝ (v i) (v j)) = ∑ I, d I ^ 2 := by
      rw [hcb v]
      refine Finset.sum_congr rfl fun I _ => ?_
      simp only [hd]
      split_ifs <;> simp
    rw [hv, hnorm, hgram, abs_le]
    constructor
    · have := Real.sum_mul_le_sqrt_mul_sqrt Finset.univ (fun I => -a I) d
      simp only [neg_sq, neg_mul, Finset.sum_neg_distrib] at this
      linarith
    · exact Real.sum_mul_le_sqrt_mul_sqrt Finset.univ a d
  · -- (2): the determinant covector `β` of `τ` has `β(τ) = det 1 = 1` and
    -- `|β|_E² = Σ_I β(e_I)² = det(⟨τᵢ, τⱼ⟩) = 1`
    obtain ⟨β, hβ⟩ := hdet τ
    have hone : (Matrix.of fun a b => inner ℝ (τ a) (τ b) : Matrix (Fin n) (Fin n) ℝ) = 1 := by
      ext a b
      rw [Matrix.of_apply, Matrix.one_apply]
      exact (orthonormal_iff_ite.mp hτ) a b
    have hβτ : β τ = 1 := by rw [hβ, hone, Matrix.det_one]
    refine ⟨β, ?_, hβτ⟩
    have hsum : (∑ I : Fin n → Fin P, if StrictMono I then (β (fun i => e (I i))) ^ 2 else 0) = 1 := by
      have := hcb τ
      rw [hone, Matrix.det_one] at this
      rw [this]
      refine Finset.sum_congr rfl fun I _ => ?_
      split_ifs
      · rw [hβ]
      · rfl
    unfold covectorEuclideanNorm
    rw [← he, hsum, Real.sqrt_one]
/-- Steps 3–5 of the orientation push-forward (Simon 6.3.4–3.5, with the orthonormal basis of
`span v` chosen by Gram–Schmidt): a linearly independent family `v` in `ℝᴾ` has an orthonormal
frame `σ` with the same span such that `A = (⟨σᵢ, vⱼ⟩)` satisfies `det(⟨vᵢ, vⱼ⟩) = (det A)²`,
`det A ≠ 0` and `|det A| ≤ ∏ᵢ |vᵢ|`.  Gram–Schmidt in `W = span v` makes `A` the upper-triangular
matrix of `v` in an orthonormal basis of `W`, and Parseval gives `(⟨vᵢ, vⱼ⟩) = AᵀA`. -/
theorem Submission.dpf_exists_orthonormal_frame_det_gram : ∀ (P n : ℕ) (v : Fin n → Euclid P), LinearIndependent ℝ v → ∃ σ : Fin n → Euclid P, Orthonormal ℝ σ ∧ Submodule.span ℝ (Set.range σ) = Submodule.span ℝ (Set.range v) ∧ Matrix.det (Matrix.of fun i j => inner ℝ (v i) (v j)) = Matrix.det (Matrix.of fun i j => inner ℝ (σ i) (v j)) ^ 2 ∧ Matrix.det (Matrix.of fun i j => inner ℝ (σ i) (v j)) ≠ 0 ∧ |Matrix.det (Matrix.of fun i j => inner ℝ (σ i) (v j))| ≤ ∏ i, ‖v i‖ := by
  intro P n v hv
  set W := Submodule.span ℝ (Set.range v)
  -- `v` regarded in `W` is a linearly independent spanning family `w`
  let w : Fin n → W := fun j => ⟨v j, Submodule.subset_span ⟨j, rfl⟩⟩
  have hw : LinearIndependent ℝ w := LinearIndependent.of_comp W.subtype hv
  have hspan_w : Submodule.span ℝ (Set.range w) = ⊤ := by
    apply Submodule.map_injective_of_injective W.injective_subtype
    rw [Submodule.map_span, ← Set.range_comp, Submodule.map_top, Submodule.range_subtype]
    rfl
  -- the Gram–Schmidt orthonormal basis `b` of `W`, and `σ = b` regarded in `ℝᴾ`
  let b := InnerProductSpace.gramSchmidtOrthonormalBasis (finrank_span_eq_card hv) w
  let σ : Fin n → Euclid P := fun i => (b i : Euclid P)
  -- `A` is the (upper-triangular) matrix of `w` in the basis `b`
  have hA : (Matrix.of fun i j => inner ℝ (σ i) (v j)) = b.toBasis.toMatrix w := by
    ext i j
    rw [Module.Basis.toMatrix_apply, OrthonormalBasis.coe_toBasis_repr_apply,
      OrthonormalBasis.repr_apply_apply, Submodule.coe_inner]
    rfl
  have hdet : Matrix.det (Matrix.of fun i j => inner ℝ (σ i) (v j)) =
      ∏ i, inner ℝ (σ i) (v i) := by
    rw [hA, ← Module.Basis.det_apply, InnerProductSpace.gramSchmidtOrthonormalBasis_det]
    rfl
  refine ⟨σ, b.orthonormal.comp_linearIsometry W.subtypeₗᵢ, ?_, ?_, ?_, ?_⟩
  · -- `span σ = W`
    have hb : Submodule.span ℝ (Set.range b) = ⊤ := b.toBasis.span_eq
    have hσ : Set.range σ = W.subtype '' Set.range b := Set.range_comp _ _
    rw [hσ, Submodule.span_image, hb, Submodule.map_top, Submodule.range_subtype]
  · -- Parseval: `(⟨vᵢ, vⱼ⟩) = AᵀA`
    have hG : (Matrix.of fun i j => inner ℝ (v i) (v j)) =
        Matrix.transpose (Matrix.of fun i j => inner ℝ (σ i) (v j)) *
          Matrix.of fun i j => inner ℝ (σ i) (v j) := by
      ext i j
      have hp := b.sum_inner_mul_inner (w i) (w j)
      simp only [Submodule.coe_inner] at hp
      rw [Matrix.mul_apply, Matrix.of_apply, ← hp]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [Matrix.transpose_apply, Matrix.of_apply, Matrix.of_apply, real_inner_comm]
    rw [hG, Matrix.det_mul, Matrix.det_transpose, sq]
  · -- `det A = det_b w` is a unit
    rw [hA, ← Module.Basis.det_apply]
    exact ((Module.Basis.is_basis_iff_det b.toBasis).mp ⟨hw, hspan_w⟩).ne_zero
  · -- Cauchy–Schwarz on the diagonal entries
    rw [hdet, Finset.abs_prod]
    refine Finset.prod_le_prod₀ (fun i _ => abs_nonneg _) fun i _ => ?_
    calc |inner ℝ (σ i) (v i)| ≤ ‖σ i‖ * ‖v i‖ := abs_real_inner_le_norm _ _
      _ = ‖v i‖ := by rw [show ‖σ i‖ = 1 from b.norm_eq_one i, one_mul]

/-- **Simon Ch. 6, 2.27–2.29 and 3.9** (analytic toolkit, and the Lipschitz push-forward of
integer multiplicity currents vanishing off a compact set).  (i) If `X = τ(M, θ, ξ)` in `ℝᴾ`
vanishes off the compact `E`, then `μ_R(ℝᴾ ∖ E) = M_{ℝᴾ∖E}(X) = 0`, so `Hᵏ(M ∖ E) = 0` (`θ ≥ 1`
on `M`), `M(X) = μ_R(ℝᴾ) = μ_R(E) < ∞`, and `R.action γ` depends only on `γ|_E`.  (ii) Hadamard:
`|α(v)| ≤ |α| ∏ᵢ |vᵢ|`, from `|α(v)| ≤ |α| det(⟨vᵢ, vⱼ⟩)^{1/2}` and a Gram–Schmidt frame with
`det(⟨vᵢ, vⱼ⟩) = (det A)²`, `|det A| ≤ ∏ᵢ |vᵢ|`.  (iii) `ξ = ±τ₁ ∧ ⋯ ∧ τₖ` a.e. with `τ`
orthonormal, so `|θ ξ(γ)| ≤ c θ` and `|R.action γ| ≤ c μ_R(ℝᴾ)`.  (iv) `F_j = ψ_j ⋆ F` with
normalized `C^∞` bumps `ψ_j` supported in `B_{1/(j+1)}(0)` are `Λ`-Lipschitz and
`|F_j - F| ≤ Λ/(j+1)`.  (v) A smooth Urysohn function for `cthickening 1 E ⊆ thickening 2 E`.
(vi) Given (IPF), `push k F X = Y_X(F)` for `Y_X` from (IPF) for a chosen finite-mass
representation of `X`: it is integer multiplicity, depends only on `F|_E`, is the limit of
`X(η_j) = R.action(F_j^#ω)`, has `M ≤ Λᵏ M(X)` (Hadamard with `‖DF_j‖ ≤ Λ`, then (iii)), and
vanishes off `F(E)` (for large `j`, `F_j(E)` avoids `spt ω`). -/
theorem Submission.dor_lmb_fcdp_toolkit_push : ((∀ (P k : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) k) (R : IMRep (univ : Set (Euclid P)) k) (E : Set (Euclid P)), R.Represents X → IsCompact E → (∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) E → X ω = 0) → μHE[k] (R.carrier \ E) = 0 ∧ X.mass = R.measure univ ∧ R.measure univ ≠ ∞ ∧ ∀ γ γ' : DifferentialForm (Euclid P) k, EqOn γ γ' E → R.action γ = R.action γ') ∧ (∀ (N m : ℕ) (α : Covector (Euclid N) m) (v : Fin m → Euclid N), |α v| ≤ covectorEuclideanNorm α * ∏ i, ‖v i‖) ∧ (∀ (P k : ℕ) (U : Set (Euclid P)) (R : IMRep U k) (γ : DifferentialForm (Euclid P) k) (c : ℝ), R.measure univ ≠ ∞ → 0 ≤ c → (∀ᵐ x ∂(μHE[k].restrict R.carrier), ∀ τ : Fin k → Euclid P, Orthonormal ℝ τ → |γ x τ| ≤ c) → |R.action γ| ≤ c * (R.measure univ).toReal) ∧ (∀ (N N' : ℕ) (Λ : NNReal) (F : Euclid N → Euclid N'), LipschitzWith Λ F → ∃ Fs : ℕ → Euclid N → Euclid N', (∀ j, ContDiff ℝ (⊤ : ℕ∞) (Fs j)) ∧ (∀ j, LipschitzWith Λ (Fs j)) ∧ TendstoUniformly Fs F atTop) ∧ ∀ (P : ℕ) (E : Set (Euclid P)), IsCompact E → ∃ (χ : Euclid P → ℝ) (W : Set (Euclid P)), ContDiff ℝ (⊤ : ℕ∞) χ ∧ HasCompactSupport χ ∧ (∀ x, 0 ≤ χ x ∧ χ x ≤ 1) ∧ IsOpen W ∧ E ⊆ W ∧ ∀ x ∈ W, χ x = 1) ∧ ((∀ (N N' k : ℕ) (R : IMRep (univ : Set (Euclid N)) k), R.measure univ ≠ ∞ → ∃ Y : (Euclid N → Euclid N') → GeometricCurrentOn (univ : Set (Euclid N')) k, (∀ (F : Euclid N → Euclid N') (Λ : NNReal), LipschitzWith Λ F → IsIntegerMultiplicity (Y F) ∧ ∀ Fs : ℕ → Euclid N → Euclid N', (∀ j, ContDiff ℝ 1 (Fs j)) → (∀ j, LipschitzWith Λ (Fs j)) → TendstoUniformly Fs F atTop → ∀ ω : TestFormOn (univ : Set (Euclid N')) k, Tendsto (fun j => R.action (fun x => ((ω : DifferentialForm (Euclid N') k) (Fs j x)).compContinuousLinearMap (fderiv ℝ (Fs j) x))) atTop (𝓝 (Y F ω))) ∧ ∀ (F F' : Euclid N → Euclid N') (Λ : NNReal), LipschitzWith Λ F → LipschitzWith Λ F' → (∀ᵐ x ∂(μHE[k].restrict R.carrier), F x = F' x) → Y F = Y F') → ∀ P : ℕ, ∃ push : ∀ k : ℕ, (Euclid P → Euclid P) → GeometricCurrentOn (univ : Set (Euclid P)) k → GeometricCurrentOn (univ : Set (Euclid P)) k, ∀ (k : ℕ) (Λ : NNReal) (F : Euclid P → Euclid P) (E : Set (Euclid P)) (X : GeometricCurrentOn (univ : Set (Euclid P)) k), LipschitzWith Λ F → IsCompact E → IsIntegerMultiplicity X → (∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) E → X ω = 0) → IsIntegerMultiplicity (push k F X) ∧ (∀ F' : Euclid P → Euclid P, LipschitzWith Λ F' → EqOn F F' E → push k F X = push k F' X) ∧ (∀ (Fs : ℕ → Euclid P → Euclid P) (ω : TestFormOn (univ : Set (Euclid P)) k) (ηs : ℕ → TestFormOn (univ : Set (Euclid P)) k), (∀ j, ContDiff ℝ 1 (Fs j)) → (∀ j, LipschitzWith Λ (Fs j)) → TendstoUniformly Fs F atTop → (∀ j, ∀ x ∈ E, (ηs j : DifferentialForm (Euclid P) k) x = ((ω : DifferentialForm (Euclid P) k) (Fs j x)).compContinuousLinearMap (fderiv ℝ (Fs j) x)) → Tendsto (fun j => X (ηs j)) atTop (𝓝 (push k F X ω))) ∧ (push k F X).mass ≤ (Λ : ℝ≥0∞) ^ k * X.mass ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) (F '' E) → push k F X ω = 0) := by
  -- (i) compactly vanishing integer multiplicity representations
  have hi : ∀ (P k : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) k) (R : IMRep (univ : Set (Euclid P)) k) (E : Set (Euclid P)), R.Represents X → IsCompact E → (∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) E → X ω = 0) → μHE[k] (R.carrier \ E) = 0 ∧ X.mass = R.measure univ ∧ R.measure univ ≠ ∞ ∧ ∀ γ γ' : DifferentialForm (Euclid P) k, EqOn γ γ' E → R.action γ = R.action γ' := by
    intro P k X R E hR hE hXE
    have hmass :=
      (Submission.dor_imrep_massOn_eq_measure_and_support P k univ X R isOpen_univ hR).1
    have hEm : MeasurableSet E := hE.isClosed.measurableSet
    have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) := measurable_from_nat.comp R.measurable_mult
    -- `μ_R(ℝᴾ ∖ E) = M_{ℝᴾ∖E}(X) = 0`: admissible forms supported off `E` are killed by `X`
    have hμEc : R.measure Eᶜ = 0 := by
      rw [← hmass Eᶜ hE.isClosed.isOpen_compl]
      refine le_antisymm (sSup_le ?_) bot_le
      rintro _ ⟨ω, ⟨hωE, -⟩, rfl⟩
      dsimp only
      rw [hXE ω (subset_compl_iff_disjoint_right.mp hωE), ENNReal.ofReal_zero]
    -- `Hᵏ(M ∖ E) = 0`, since `θ ≥ 1` on `M`
    have hnull : μHE[k] (R.carrier \ E) = 0 := by
      rw [IMRep.measure, withDensity_apply_eq_zero' hθ.aemeasurable,
        Measure.restrict_apply' R.measurableSet_carrier] at hμEc
      refine measure_mono_null ?_ hμEc
      intro x hx
      exact ⟨⟨Nat.cast_ne_zero.mpr (R.mult_pos x hx.1).ne', hx.2⟩, hx.1⟩
    -- `Hᵏ⌞M`-a.e. point lies in `E`
    have hae : ∀ᵐ x ∂(μHE[k].restrict R.carrier), x ∈ E := by
      rw [ae_iff, Measure.restrict_apply' R.measurableSet_carrier]
      refine measure_mono_null ?_ hnull
      intro x hx
      exact ⟨hx.2, hx.1⟩
    -- `μ_R(ℝᴾ) = μ_R(E) = ∫_{M ∩ E} θ dHᵏ < ∞`
    have hfin : R.measure univ ≠ ∞ := by
      rw [← measure_add_measure_compl hEm, hμEc, add_zero, IMRep.measure, withDensity_apply _ hEm,
        Measure.restrict_restrict hEm, inter_comm]
      exact R.locallyIntegrable_mult E hE (subset_univ E)
    refine ⟨hnull, hmass univ isOpen_univ, hfin, fun γ γ' hγ => ?_⟩
    -- the integrands agree on `E`, hence `Hᵏ⌞M`-a.e.
    refine integral_congr_ae ?_
    filter_upwards [hae] with x hx
    rw [hγ hx]
  -- (ii) Hadamard's inequality for the Euclidean coefficient norm
  have hii : ∀ (N m : ℕ) (α : Covector (Euclid N) m) (v : Fin m → Euclid N), |α v| ≤ covectorEuclideanNorm α * ∏ i, ‖v i‖ := by
    intro N m α v
    by_cases hv : LinearIndependent ℝ v
    · obtain ⟨σ, -, -, hG, -, hA⟩ := Submission.dpf_exists_orthonormal_frame_det_gram N m v hv
      calc |α v| ≤ covectorEuclideanNorm α *
            Real.sqrt (Matrix.det (Matrix.of fun i j => inner ℝ (v i) (v j))) :=
            (Submission.covectorEuclideanNorm_gram_bounds N m).1 α v
        _ = covectorEuclideanNorm α * |Matrix.det (Matrix.of fun i j => inner ℝ (σ i) (v j))| := by
            rw [hG, Real.sqrt_sq_eq_abs]
        _ ≤ covectorEuclideanNorm α * ∏ i, ‖v i‖ :=
            mul_le_mul_of_nonneg_left hA (covectorEuclideanNorm_nonneg α)
    · -- a linearly dependent family is killed by every alternating map
      rw [show α v = 0 from α.toAlternatingMap.map_linearDependent v hv, abs_zero]
      exact mul_nonneg (covectorEuclideanNorm_nonneg α)
        (Finset.prod_nonneg fun i _ => norm_nonneg _)
  -- (iii) the action is bounded by `c μ_R(ℝᴾ)` when `γ` is bounded by `c` on orthonormal frames
  have hiii : ∀ (P k : ℕ) (U : Set (Euclid P)) (R : IMRep U k) (γ : DifferentialForm (Euclid P) k) (c : ℝ), R.measure univ ≠ ∞ → 0 ≤ c → (∀ᵐ x ∂(μHE[k].restrict R.carrier), ∀ τ : Fin k → Euclid P, Orthonormal ℝ τ → |γ x τ| ≤ c) → |R.action γ| ≤ c * (R.measure univ).toReal := by
    intro P k U R γ c hfin hc hγ
    have hθm : Measurable fun x => (R.mult x : ℝ) := measurable_from_nat.comp R.measurable_mult
    -- `∫⁻ θ d(Hᵏ⌞M) = μ_R(ℝᴾ)`, so `θ` is `Hᵏ⌞M`-integrable with `∫ θ d(Hᵏ⌞M) = μ_R(ℝᴾ)`
    have hlint : ∫⁻ x, ENNReal.ofReal (R.mult x : ℝ) ∂(μHE[k].restrict R.carrier) =
        R.measure univ := by
      rw [IMRep.measure, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
      exact lintegral_congr fun x => ENNReal.ofReal_natCast _
    have hθ0 : 0 ≤ᵐ[μHE[k].restrict R.carrier] fun x => (R.mult x : ℝ) :=
      ae_of_all _ fun x => Nat.cast_nonneg _
    have hθint : Integrable (fun x => (R.mult x : ℝ)) (μHE[k].restrict R.carrier) :=
      ⟨hθm.aestronglyMeasurable, (hasFiniteIntegral_iff_ofReal hθ0).mpr (hlint ▸ hfin.lt_top)⟩
    have hθI : ∫ x, (R.mult x : ℝ) ∂(μHE[k].restrict R.carrier) = (R.measure univ).toReal := by
      rw [integral_eq_lintegral_of_nonneg_ae hθ0 hθm.aestronglyMeasurable, hlint]
    rw [← Real.norm_eq_abs, IMRep.action]
    calc ‖∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (γ x) ∂μHE[k]‖
        ≤ ∫ x, c * (R.mult x : ℝ) ∂(μHE[k].restrict R.carrier) := by
          refine norm_integral_le_of_norm_le (hθint.const_mul c) ?_
          -- a.e. `ξ(x)(β) = ±β(τ)` with `τ` orthonormal, so `|ξ(x)(γ x)| = |γ(x)(τ)| ≤ c`
          filter_upwards [hγ, R.orients] with x hx hor
          obtain ⟨Q, -, τ, hτ, -, hξ⟩ := hor
          rw [norm_mul, Real.norm_natCast, mul_comm c]
          refine mul_le_mul_of_nonneg_left ?_ (Nat.cast_nonneg _)
          rcases hξ with h | h
          · rw [h, Real.norm_eq_abs]
            exact hx τ hτ
          · rw [h, norm_neg, Real.norm_eq_abs]
            exact hx τ hτ
      _ = c * (R.measure univ).toReal := by rw [integral_const_mul, hθI]
  -- (iv) `C^∞` `Λ`-Lipschitz approximations by mollification
  have hiv : ∀ (N N' : ℕ) (Λ : NNReal) (F : Euclid N → Euclid N'), LipschitzWith Λ F → ∃ Fs : ℕ → Euclid N → Euclid N', (∀ j, ContDiff ℝ (⊤ : ℕ∞) (Fs j)) ∧ (∀ j, LipschitzWith Λ (Fs j)) ∧ TendstoUniformly Fs F atTop := by
    intro N N' Λ F hF
    -- normalized `C^∞` bumps `ψ = φ / ∫ φ` supported in `B_r(0)`
    have hker : ∀ r : ℝ, 0 < r → ∃ ψ : Euclid N → ℝ, ContDiff ℝ (⊤ : ℕ∞) ψ ∧
        HasCompactSupport ψ ∧ (∀ y, 0 ≤ ψ y) ∧ ∫ y, ψ y = 1 ∧ support ψ ⊆ ball 0 r := by
      intro r hr
      let φ : ContDiffBump (0 : Euclid N) := ⟨r / 2, r, half_pos hr, half_lt_self hr⟩
      have hφ : 0 < ∫ y, φ y := by
        rw [integral_pos_iff_support_of_nonneg φ.nonneg'
          (φ.continuous.integrable_of_hasCompactSupport φ.hasCompactSupport), φ.support_eq]
        exact measure_ball_pos _ _ hr
      have hsupp : support (fun y => φ y / ∫ y, φ y) ⊆ support φ := fun y hy =>
        (div_ne_zero_iff.1 hy).1
      exact ⟨fun y => φ y / ∫ y, φ y, φ.contDiff.div_const _, φ.hasCompactSupport.mono hsupp,
        fun y => div_nonneg φ.nonneg hφ.le, by rw [integral_div, div_self hφ.ne'],
        hsupp.trans φ.support_eq.subset⟩
    choose ψ hψ hψc hψ0 hψ1 hψs using fun j : ℕ =>
      hker (1 / ((j : ℝ) + 1)) Nat.one_div_pos_of_nat
    have hFi : LocallyIntegrable F volume := hF.continuous.locallyIntegrable
    refine ⟨fun j => convolution (ψ j) F (ContinuousLinearMap.lsmul ℝ ℝ) volume,
      fun j => (hψc j).contDiff_convolution_left _ (hψ j) hFi, fun j => ?_, ?_⟩
    · -- `ψ_j ⋆ F` is `Λ`-Lipschitz: it averages the differences `F(x - t) - F(x' - t)`
      have hconv : ∀ x, Integrable (fun t => ψ j t • F (x - t)) volume := fun x =>
        ((hψc j).convolutionExists_left (ContinuousLinearMap.lsmul ℝ ℝ) (hψ j).continuous hFi
          x).integrable
      refine LipschitzWith.of_dist_le_mul fun x x' => ?_
      dsimp only
      rw [dist_eq_norm, convolution_def, convolution_def]
      simp only [ContinuousLinearMap.lsmul_apply]
      rw [← integral_sub (hconv x) (hconv x')]
      calc ‖∫ t, (ψ j t • F (x - t) - ψ j t • F (x' - t))‖ ≤ ∫ t, ψ j t * (Λ * dist x x') := by
            refine norm_integral_le_of_norm_le
              (((hψ j).continuous.integrable_of_hasCompactSupport (hψc j)).mul_const _)
              (ae_of_all _ fun t => ?_)
            rw [← smul_sub, norm_smul, Real.norm_of_nonneg (hψ0 j t)]
            refine mul_le_mul_of_nonneg_left ?_ (hψ0 j t)
            rw [← dist_eq_norm]
            calc dist (F (x - t)) (F (x' - t)) ≤ Λ * dist (x - t) (x' - t) := hF.dist_le_mul _ _
              _ = Λ * dist x x' := by rw [dist_sub_right]
        _ = Λ * dist x x' := by rw [integral_mul_const, hψ1 j, one_mul]
    · -- `dist((ψ_j ⋆ F)(x), F(x)) ≤ Λ/(j+1)`, as `F` moves by `≤ Λ/(j+1)` on `B_{1/(j+1)}(x)`
      rw [Metric.tendstoUniformly_iff]
      intro ε hε
      have hlim : Tendsto (fun j : ℕ => (Λ : ℝ) * (1 / ((j : ℝ) + 1))) atTop (𝓝 0) := by
        have := (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)).const_mul (Λ : ℝ)
        rwa [mul_zero] at this
      filter_upwards [hlim.eventually (gt_mem_nhds hε)] with j hj x
      rw [dist_comm]
      refine (dist_convolution_le (by positivity) (hψs j) (hψ0 j) (hψ1 j)
        hF.continuous.aestronglyMeasurable fun y hy => ?_).trans_lt hj
      calc dist (F y) (F x) ≤ Λ * dist y x := hF.dist_le_mul y x
        _ ≤ Λ * (1 / ((j : ℝ) + 1)) := mul_le_mul_of_nonneg_left (mem_ball.mp hy).le Λ.coe_nonneg
  -- (v) smooth cut-off functions
  have hv : ∀ (P : ℕ) (E : Set (Euclid P)), IsCompact E → ∃ (χ : Euclid P → ℝ) (W : Set (Euclid P)), ContDiff ℝ (⊤ : ℕ∞) χ ∧ HasCompactSupport χ ∧ (∀ x, 0 ≤ χ x ∧ χ x ≤ 1) ∧ IsOpen W ∧ E ⊆ W ∧ ∀ x ∈ W, χ x = 1 := by
    intro P E hE
    obtain ⟨χ, hχ, hχr, hχs, hχ1⟩ := exists_contDiff_support_eq_eq_one_iff (n := ⊤)
      (isOpen_thickening (δ := 2) (E := E)) (isClosed_cthickening (δ := 1) (E := E))
      (cthickening_subset_thickening' two_pos one_lt_two E)
    refine ⟨χ, thickening 1 E, hχ, ?_, fun x => hχr ⟨x, rfl⟩, isOpen_thickening,
      self_subset_thickening one_pos E,
      fun x hx => (hχ1 x).mp (thickening_subset_cthickening 1 E hx)⟩
    exact HasCompactSupport.of_support_subset_isCompact (hE.cthickening (r := 2))
      (hχs ▸ thickening_subset_cthickening 2 E)
  refine ⟨⟨hi, hii, hiii, hiv, hv⟩, ?_⟩
  -- (vi) the push-forward operator, assuming (IPF)
  intro hIPF P
  -- for `X` with a finite-mass IM representation `R`, choose `Y_X` from (IPF) for `R`
  obtain ⟨Ych, hYch⟩ : ∃ Ych : ∀ k : ℕ, GeometricCurrentOn (univ : Set (Euclid P)) k →
      (Euclid P → Euclid P) → GeometricCurrentOn (univ : Set (Euclid P)) k,
      ∀ (k : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) k),
        (∃ R : IMRep (univ : Set (Euclid P)) k, R.Represents X ∧ R.measure univ ≠ ∞) →
        ∃ (R : IMRep (univ : Set (Euclid P)) k) (hR : R.measure univ ≠ ∞),
          R.Represents X ∧ Ych k X = Classical.choose (hIPF P P k R hR) := by
    classical
    exact ⟨fun k X => if h : ∃ R : IMRep (univ : Set (Euclid P)) k, R.Represents X ∧
      R.measure univ ≠ ∞ then Classical.choose (hIPF P P k h.choose h.choose_spec.2)
      else fun _ => X, fun k X h => ⟨h.choose, h.choose_spec.2, h.choose_spec.1, dite_eq_left h⟩⟩
  refine ⟨fun k F X => Ych k X F, ?_⟩
  rintro k Λ F E X hF hE ⟨R', hR'⟩ hXE
  dsimp only
  -- by (i) every representation of `X` has finite mass
  obtain ⟨R, hRfin, hRX, hY⟩ := hYch k X ⟨R', hR', (hi P k X R' E hR' hE hXE).2.2.1⟩
  obtain ⟨hYa, hYb⟩ := Classical.choose_spec (hIPF P P k R hRfin)
  rw [← hY] at hYa hYb
  obtain ⟨hnull, hmass, -, hloc⟩ := hi P k X R E hRX hE hXE
  have hae : ∀ᵐ x ∂(μHE[k].restrict R.carrier), x ∈ E := by
    rw [ae_iff, Measure.restrict_apply' R.measurableSet_carrier]
    refine measure_mono_null ?_ hnull
    intro x hx
    exact ⟨hx.2, hx.1⟩
  -- `C^∞` `Λ`-Lipschitz `F_j → F` by (iv); `push k F X (ω) = lim R.action(F_j^#ω)`
  obtain ⟨Fs, hFs, hFsL, hFsU⟩ := hiv P P Λ F hF
  have hFs1 : ∀ j, ContDiff ℝ 1 (Fs j) := fun j => (hFs j).of_le (by exact_mod_cast le_top)
  have hlim := (hYa F Λ hF).2 Fs hFs1 hFsL hFsU
  refine ⟨(hYa F Λ hF).1, fun F' hF' hFF' => hYb F F' Λ hF hF' ?_,
    fun Fs' ω ηs hFs' hFsL' hFsU' hη => ?_, ?_, fun ω hω => ?_⟩
  · -- (P2): `F = F'` on `E`, hence `Hᵏ⌞M`-a.e.
    filter_upwards [hae] with x hx using hFF' hx
  · -- (P3): `X(η_j) = R.action(η_j) = R.action(F_j^#ω) → push k F X (ω)`
    refine ((hYa F Λ hF).2 Fs' hFs' hFsL' hFsU' ω).congr fun j => ?_
    rw [hRX (ηs j)]
    exact hloc _ _ fun x hx => (hη j x hx).symm
  · -- (P4): for admissible `ω`, `|R.action(F_j^#ω)| ≤ Λᵏ μ_R(ℝᴾ)` by (ii) and (iii)
    rw [hmass, GeometricCurrentOn.mass, GeometricCurrentOn.massOn]
    refine sSup_le ?_
    rintro _ ⟨ω, ⟨-, hω1⟩, rfl⟩
    dsimp only
    have hbd : ∀ j, |R.action (fun x => ((ω : DifferentialForm (Euclid P) k)
        (Fs j x)).compContinuousLinearMap (fderiv ℝ (Fs j) x))| ≤
        (Λ : ℝ) ^ k * (R.measure univ).toReal := by
      intro j
      refine hiii P k univ R _ _ hRfin (by positivity) (ae_of_all _ fun x τ hτ => ?_)
      rw [ContinuousAlternatingMap.compContinuousLinearMap_apply]
      calc |(ω : DifferentialForm (Euclid P) k) (Fs j x) (fderiv ℝ (Fs j) x ∘ τ)|
          ≤ covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) k) (Fs j x)) *
            ∏ i, ‖(fderiv ℝ (Fs j) x ∘ τ) i‖ := hii P k _ _
        _ ≤ 1 * ∏ _i : Fin k, (Λ : ℝ) := by
          refine mul_le_mul (hω1 _)
            (Finset.prod_le_prod₀ (fun i _ => norm_nonneg _) fun i _ => ?_)
            (Finset.prod_nonneg fun i _ => norm_nonneg _) zero_le_one
          -- `‖DF_j(x) τᵢ‖ ≤ ‖DF_j(x)‖ ≤ Λ`
          calc ‖(fderiv ℝ (Fs j) x ∘ τ) i‖ ≤ ‖fderiv ℝ (Fs j) x‖ * ‖τ i‖ :=
                (fderiv ℝ (Fs j) x).le_opNorm _
            _ ≤ Λ := by
                rw [hτ.1 i, mul_one]
                exact norm_fderiv_le_of_lipschitz ℝ (hFsL j)
        _ = (Λ : ℝ) ^ k := by rw [one_mul, Fin.prod_const]
    have hle : Ych k X F ω ≤ (Λ : ℝ) ^ k * (R.measure univ).toReal :=
      le_of_tendsto' (hlim ω) fun j => (le_abs_self _).trans (hbd j)
    calc ENNReal.ofReal (Ych k X F ω)
        ≤ ENNReal.ofReal ((Λ : ℝ) ^ k * (R.measure univ).toReal) := ENNReal.ofReal_le_ofReal hle
      _ = (Λ : ℝ≥0∞) ^ k * R.measure univ := by
        rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_toReal hRfin,
          ENNReal.ofReal_pow NNReal.zero_le_coe, ENNReal.ofReal_coe_nnreal]
  · -- (P5): for large `j`, `F_j(E)` avoids `spt ω`, so `F_j^#ω = 0` on `E`
    obtain ⟨δ, hδ, hδK⟩ := (hE.image hF.continuous).exists_cthickening_subset_open
      (isClosed_tsupport _).isOpen_compl (subset_compl_iff_disjoint_left.mpr hω)
    have hev : ∀ᶠ j in atTop, R.action (fun x => ((ω : DifferentialForm (Euclid P) k)
        (Fs j x)).compContinuousLinearMap (fderiv ℝ (Fs j) x)) = 0 := by
      filter_upwards [Metric.tendstoUniformly_iff.mp hFsU δ hδ] with j hj
      refine (hloc _ 0 fun x hx => ?_).trans ?_
      · have hmem : Fs j x ∉ tsupport (ω : DifferentialForm (Euclid P) k) :=
          hδK (thickening_subset_cthickening δ _
            (mem_thickening_iff.mpr ⟨F x, mem_image_of_mem F hx, by rw [dist_comm]; exact hj x⟩))
        rw [image_eq_zero_of_notMem_tsupport hmem]
        ext v
        simp
      · simp [IMRep.action]
    exact tendsto_nhds_unique (hlim ω) (tendsto_const_nhds.congr' (hev.mono fun j hj => hj.symm))
/-- Step 4(d) of the local unit representation of `∂[[E]]` (Simon 7.5; Gram–Schmidt as in the
graph chart): if `a₁, …, aₙ` are linearly independent in `ℝᴾ`, the Gram determinant
`Γ = det(⟨aᵢ, aⱼ⟩)` is positive and `ξ = Γ^{-1/2} a₁ ∧ ⋯ ∧ aₙ`, i.e.
`⟨α, ξ⟩ = Γ^{-1/2} α(a₁, …, aₙ)`, is a unit orientation of `span a`.  For an orthonormal frame
`σ` of `span a` and `R = (⟨σᵢ, aⱼ⟩)`, `Γ = (det R)²` and `α(a) = det R · α(σ)`, so
`ξ = sign(det R) σ₁ ∧ ⋯ ∧ σₙ`. -/
theorem Submission.codim1_lur_normalized_wedge_orientation : ∀ (P n : ℕ) (a : Fin n → Euclid P), LinearIndependent ℝ a → 0 < Matrix.det (Matrix.of fun i j : Fin n => inner ℝ (a i) (a j)) ∧ ∀ ξ : MultiVector P n, (∀ α : Covector (Euclid P) n, ξ α = (Real.sqrt (Matrix.det (Matrix.of fun i j : Fin n => inner ℝ (a i) (a j))))⁻¹ * α a) → IsUnitOrientationOf ξ (Submodule.span ℝ (Set.range a)) := by
  intro P n a ha
  -- an orthonormal frame `σ` of `span a` with `Γ = (det R)²`, `R = (⟨σᵢ, aⱼ⟩)` invertible
  obtain ⟨σ, hσ, hspan, hgram, hdet, -⟩ :=
    Submission.dpf_exists_orthonormal_frame_det_gram P n a ha
  set d := Matrix.det (Matrix.of fun i j => inner ℝ (σ i) (a j))
  refine ⟨hgram ▸ sq_pos_of_ne_zero hdet, fun ξ hξ => ⟨σ, hσ, hspan, ?_⟩⟩
  -- `α(a) = det R · α(σ)`, hence `⟨α, ξ⟩ = |det R|⁻¹ det R · α(σ)`
  have hξ' : ∀ α : Covector (Euclid P) n, ξ α = |d|⁻¹ * d * α σ := fun α => by
    rw [hξ, hgram, Real.sqrt_sq_eq_abs, mul_assoc,
      Submission.dgoj_covector_eq_det_mul_of_mem_span P n σ a hσ
        (fun j => hspan ▸ Submodule.subset_span ⟨j, rfl⟩) α]
  rcases hdet.lt_or_gt with hneg | hpos
  · exact Or.inr fun α => by
      rw [hξ', abs_of_neg hneg, inv_neg, neg_mul, inv_mul_cancel₀ hdet, neg_one_mul]
  · exact Or.inl fun α => by
      rw [hξ', abs_of_pos hpos, inv_mul_cancel₀ hdet, one_mul]
/-- A mass-summable series of integer multiplicity densities converges `Hⁿ`-a.e. and integrates
termwise against test forms (the `L¹` convergence of the densities `θ_q ξ_q` in the proof of
Simon Ch. 6, Lemma 3.13).  With `g_r = 1_{M_r} θ_r`, `∫ g_r dHⁿ = μ_{R_r}(M_r) ≤ μ_{R_r}(U)`, so
`Σ_r g_r < ∞` `Hⁿ`-a.e.; as `‖ξ_r‖ ≤ 1` `Hⁿ`-a.e. on `M_r`, the densities `D_r = 1_{M_r} θ_r ξ_r`
satisfy `‖D_r‖ ≤ g_r`, so `η = Σ_r D_r` converges absolutely `Hⁿ`-a.e., and dominated convergence
for series with the bounds `(sup ‖ω‖) g_r` gives `Σ_r τ(M_r, θ_r, ξ_r)(ω) = ∫ ⟨ω, η⟩ dHⁿ`. -/
theorem Submission.dor_lmb_fc_ims_density_series : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : ℕ → IMRep U n), ∑' r, (R r).measure U ≠ ∞ → ∃ η : Euclid P → MultiVector P n, (∀ᵐ x ∂μHE[n], HasSum (fun r => (R r).carrier.indicator (fun y => ((R r).mult y : ℝ) • (R r).orient y) x) (η x)) ∧ ∀ ω : TestFormOn U n, HasSum (fun r => (R r).action (ω : DifferentialForm (Euclid P) n)) (∫ x, η x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) := by
  have hnorm := Submission.unit_orientation_norm_le_one
  intro P n U R hfin
  set D : ℕ → Euclid P → MultiVector P n := fun r x =>
    (R r).carrier.indicator (fun y => ((R r).mult y : ℝ) • (R r).orient y) x
  set g : ℕ → Euclid P → ℝ := fun r x =>
    (R r).carrier.indicator (fun y => ((R r).mult y : ℝ)) x
  have hg_nonneg : ∀ r x, 0 ≤ g r x := fun r x =>
    Set.indicator_nonneg (fun y _ => Nat.cast_nonneg _) x
  have hmult_meas : ∀ r, Measurable (fun y => ((R r).mult y : ℝ)) := fun r =>
    measurable_from_nat.comp (R r).measurable_mult
  have hg_meas : ∀ r, Measurable (g r) := fun r =>
    (hmult_meas r).indicator (R r).measurableSet_carrier
  -- ∫⁻ g_r dHⁿ = μ_{R_r}(M_r) ≤ μ_{R_r}(U)
  have hg_lint : ∀ r, ∫⁻ x, ENNReal.ofReal (g r x) ∂μHE[n] ≤ (R r).measure U := by
    intro r
    have hM := (R r).measurableSet_carrier
    have h1 : (fun x => ENNReal.ofReal (g r x)) =
        (R r).carrier.indicator (fun y => ((R r).mult y : ℝ≥0∞)) := by
      funext x
      by_cases hx : x ∈ (R r).carrier <;> simp [g, hx]
    calc ∫⁻ x, ENNReal.ofReal (g r x) ∂μHE[n]
        = ∫⁻ x in (R r).carrier, ((R r).mult x : ℝ≥0∞) ∂μHE[n] := by
          rw [h1, lintegral_indicator hM]
      _ = (R r).measure (R r).carrier := by
          rw [IMRep.measure, withDensity_apply _ hM, Measure.restrict_restrict hM, inter_self]
      _ ≤ (R r).measure U := measure_mono (R r).carrier_subset
  have hsum_lint : ∫⁻ x, ∑' r, ENNReal.ofReal (g r x) ∂μHE[n] ≠ ∞ := by
    rw [lintegral_tsum (fun r => (hg_meas r).ennreal_ofReal.aemeasurable)]
    exact ne_top_of_le_ne_top hfin (ENNReal.tsum_le_tsum hg_lint)
  have hfinite : ∀ᵐ x ∂μHE[n], ∑' r, ENNReal.ofReal (g r x) < ∞ :=
    ae_lt_top (Measurable.tsum fun r => (hg_meas r).ennreal_ofReal) hsum_lint
  have hg_summ : ∀ᵐ x ∂μHE[n], Summable (fun r => g r x) := by
    filter_upwards [hfinite] with x hx
    have := ENNReal.summable_toReal hx.ne
    simpa [ENNReal.toReal_ofReal (hg_nonneg _ x)] using this
  -- ‖D_r(x)‖ ≤ g_r(x) a.e., from ‖ξ‖ ≤ 1 for unit orientations
  have hD_bound : ∀ r, ∀ᵐ x ∂μHE[n], ‖D r x‖ ≤ g r x := by
    intro r
    have h := (R r).orients
    rw [ae_restrict_iff' (R r).measurableSet_carrier] at h
    filter_upwards [h] with x hx
    by_cases hxM : x ∈ (R r).carrier
    · obtain ⟨Q, -, hQ⟩ := hx hxM
      have h1 := hnorm P n Q _ hQ
      simp only [D, g, Set.indicator_of_mem hxM]
      calc ‖((R r).mult x : ℝ) • (R r).orient x‖
          ≤ ‖((R r).mult x : ℝ)‖ * ‖(R r).orient x‖ := ContinuousLinearMap.opNorm_smul_le _ _
        _ ≤ ‖((R r).mult x : ℝ)‖ * 1 := mul_le_mul_of_nonneg_left h1 (norm_nonneg _)
        _ = ((R r).mult x : ℝ) := by rw [mul_one, Real.norm_natCast]
    · simp only [D, g, Set.indicator_of_notMem hxM]
      exact ContinuousLinearMap.opNorm_zero.le
  have hD_bound' : ∀ᵐ x ∂μHE[n], ∀ r, ‖D r x‖ ≤ g r x := ae_all_iff.2 hD_bound
  have hD_summ : ∀ᵐ x ∂μHE[n], Summable (fun r => D r x) := by
    filter_upwards [hD_bound', hg_summ] with x h1 h2
    exact Summable.of_norm_bounded (E := MultiVector P n) h2 h1
  refine ⟨fun x => ∑' r, D r x, ?_, ?_⟩
  · filter_upwards [hD_summ] with x hx
    exact hx.hasSum
  · intro ω
    set w : DifferentialForm (Euclid P) n := (ω : DifferentialForm (Euclid P) n)
    have hw_cont : Continuous w := ContDiff.continuous ω.property.1.1
    obtain ⟨B, hB⟩ : ∃ B, ∀ x, ‖w x‖ ≤ B :=
      hw_cont.bounded_above_of_compact_support ω.property.1.2
    have hDr_meas : ∀ r, AEStronglyMeasurable (D r) μHE[n] := by
      intro r
      refine (aestronglyMeasurable_indicator_iff (R r).measurableSet_carrier).2 ?_
      exact (hmult_meas r).aestronglyMeasurable.smul (R r).aestronglyMeasurable_orient
    have hF_meas : ∀ r, AEStronglyMeasurable (fun x => D r x (w x)) μHE[n] := fun r =>
      isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable
        ((hDr_meas r).prodMk hw_cont.aestronglyMeasurable)
    have h_bound : ∀ r, ∀ᵐ x ∂μHE[n], ‖D r x (w x)‖ ≤ B * g r x := by
      intro r
      filter_upwards [hD_bound r] with x hx
      calc ‖D r x (w x)‖ ≤ ‖D r x‖ * ‖w x‖ := (D r x).le_opNorm _
        _ ≤ g r x * B := mul_le_mul hx (hB x) (norm_nonneg _) (hg_nonneg r x)
        _ = B * g r x := mul_comm _ _
    have h_summ : ∀ᵐ x ∂μHE[n], Summable (fun r => B * g r x) :=
      hg_summ.mono fun x hx => hx.mul_left B
    have h_int : Integrable (fun x => ∑' r, B * g r x) μHE[n] := by
      have hG : Integrable (fun x => (∑' r, ENNReal.ofReal (g r x)).toReal) μHE[n] :=
        integrable_toReal_of_lintegral_ne_top
          (Measurable.tsum fun r => (hg_meas r).ennreal_ofReal).aemeasurable hsum_lint
      refine (hG.const_mul B).congr ?_
      filter_upwards [hg_summ] with x hx
      rw [tsum_mul_left, ← ENNReal.ofReal_tsum_of_nonneg (fun r => hg_nonneg r x) hx,
        ENNReal.toReal_ofReal (tsum_nonneg fun r => hg_nonneg r x)]
    have hlim : ∀ᵐ x ∂μHE[n], HasSum (fun r => D r x (w x)) ((∑' r, D r x) (w x)) := by
      filter_upwards [hD_summ] with x hx
      exact hx.hasSum.mapL (ContinuousLinearMap.apply ℝ ℝ (w x))
    have hHS := hasSum_integral_of_dominated_convergence (fun r x => B * g r x) hF_meas
      h_bound h_summ h_int hlim
    convert hHS using 1
    funext r
    have hM := (R r).measurableSet_carrier
    have h1 : (fun x => D r x (w x)) =
        (R r).carrier.indicator (fun x => ((R r).mult x : ℝ) * (R r).orient x (w x)) := by
      funext x
      by_cases hx : x ∈ (R r).carrier <;> simp [D, hx]
    rw [h1, integral_indicator hM]
    rfl
/-- **Mass of a difference** (Simon (6.2.5), chapter-06.txt line 231; this subadditivity makes the
flat distances `d_W` of 7.1 (lines 2018–2022) pseudometrics and is used in the proof of 7.2):
`M_G(A − B) ≤ M_G(A) + M_G(B)` for every set `G`.  If `ω` is admissible for `M_G` then so is `−ω`
(same support, same coefficient norm), and `(A − B)(ω) = A(ω) + B(−ω)`, so
`ofReal ((A − B)(ω)) ≤ ofReal (A(ω)) + ofReal (B(−ω)) ≤ M_G(A) + M_G(B)`. -/
theorem Submission.cmc_fc_cs_massOn_sub_le : ∀ (P n : ℕ) (U G : Set (Euclid P)) (A B : GeometricCurrentOn U n), (A - B).massOn G ≤ A.massOn G + B.massOn G := by
  intro P n U G A B
  -- Step 1: it suffices to bound `ofReal ((A − B)(ω))` for each admissible `ω`
  refine sSup_le ?_
  rintro _ ⟨ω, hω, rfl⟩
  -- Step 2: `−ω` is admissible: same support, same coefficient norm
  have hneg : -ω ∈ massAdmissibleOn U n G := by
    refine ⟨?_, fun x => ?_⟩
    · rw [Submodule.coe_neg, tsupport_neg]
      exact hω.1
    · rw [Submodule.coe_neg, Pi.neg_apply, covectorEuclideanNorm_neg]
      exact hω.2 x
  -- Step 3: `(A − B)(ω) = A(ω) − B(ω) = A(ω) + B(−ω)`, by linearity of `B`
  have hsplit : (A - B) ω = A ω + B (-ω) := by
    have hB : B (-ω) = -B ω := B.toCurrent.map_neg ω
    change A ω - B ω = A ω + B (-ω)
    rw [hB, sub_eq_add_neg]
  -- Steps 4–5: `ofReal` is subadditive, and each term is bounded by the corresponding mass
  calc ENNReal.ofReal ((A - B) ω) = ENNReal.ofReal (A ω + B (-ω)) := by rw [hsplit]
    _ ≤ ENNReal.ofReal (A ω) + ENNReal.ofReal (B (-ω)) := ENNReal.ofReal_add_le
    _ ≤ A.massOn G + B.massOn G := add_le_add (A.le_massOn hω) (B.le_massOn hneg)
/-- **Diagonal extraction** (Simon Ch. 6, proof of 7.2, chapter-06.txt lines 2101–2105:
"apply (1) with `ε = 1, 1/2, 1/4` etc. to extract a subsequence `{T_{j_r}}` …
`d(T_{j_{r+1}}, T_{j_r}) < 2^{-r}`", with `2^{-r}`-closeness replaced by an arbitrary relation
`C r`).  If, for each `r`, every infinite `I ⊆ ℕ` contains an infinite `J ⊆ I` all of whose pairs
are `C r`-related, then some strictly increasing `φ` has `C r (φ (r + 1)) (φ r)` for every `r`.
Refining `I₀ = ℕ` gives nested infinite sets `I_{r+1} ⊆ I_r` with `I_{r+1}` pairwise
`C r`-related; an increasing choice `φ(r) ∈ I_{r+1}` puts both `φ(r)` and `φ(r + 1)` in
`I_{r+1}`. -/
theorem Submission.cmc_fc_cs_diagonal_subseq : ∀ (C : ℕ → ℕ → ℕ → Prop), (∀ (r : ℕ) (I : Set ℕ), I.Infinite → ∃ J ⊆ I, J.Infinite ∧ ∀ j ∈ J, ∀ l ∈ J, C r j l) → ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ r, C r (φ (r + 1)) (φ r) := by
  intro C hC
  -- Step 1: refinements `F(r, I) ⊆ I`, infinite, with all pairs in relation `C r`
  choose F hFsub hFinf hFC using hC
  -- Step 2: nested infinite index sets `I₀ = ℕ`, `I_{r+1} = F(r, I_r)`
  let I : ℕ → {s : Set ℕ // s.Infinite} := fun r =>
    Nat.rec ⟨univ, infinite_univ⟩ (fun r s => ⟨F r s.1 s.2, hFinf r s.1 s.2⟩) r
  have hsub : ∀ r, (I (r + 1)).1 ⊆ (I r).1 := fun r => hFsub r (I r).1 (I r).2
  have hpair : ∀ r, ∀ j ∈ (I (r + 1)).1, ∀ l ∈ (I (r + 1)).1, C r j l :=
    fun r => hFC r (I r).1 (I r).2
  -- Step 3: `I_{r+1}` is unbounded: `g(r, a) ∈ I_{r+1}` and `a < g(r, a)`
  choose g hgI hglt using fun r : ℕ => (I (r + 1)).2.exists_gt
  -- Step 4: diagonal choice `φ(0) = g(0, 0)`, `φ(r + 1) = g(r + 1, φ(r)) ∈ I_{r+2}`
  let φ : ℕ → ℕ := fun r => Nat.rec (g 0 0) (fun r a => g (r + 1) a) r
  have hφI : ∀ r, φ r ∈ (I (r + 1)).1 := by
    intro r
    cases r with
    | zero => exact hgI 0 0
    | succ r => exact hgI (r + 1) (φ r)
  have hφ : StrictMono φ := strictMono_nat_of_lt_succ fun r => hglt (r + 1) (φ r)
  -- Step 5: `φ(r + 1) ∈ I_{r+2} ⊆ I_{r+1}` and `φ(r) ∈ I_{r+1} = F(r, I_r)`
  exact ⟨φ, hφ, fun r => hpair r _ (hsub (r + 1) (hφI (r + 1))) _ (hφI r)⟩
/-- **A bounded Borel tangent field representing `β ↦ ⟨β ∧ ω, ξ⟩`** (Simon Ch. 6, proof of
Lemma 4.5(2), display (3)).  Let `R = (M, θ, ξ)` be an integer multiplicity `(n+1)`-triple and `ω`
a continuous `n`-form with `‖ω‖ ≤ B`.  Let `ξ₀` be a strongly measurable version of `ξ`, replaced
by `0` where its norm exceeds `1`.  Then `W = Σₗ ξ₀(eₗ♭ ∧ ω) eₗ` is Borel, vanishes where `ω` does
and is bounded by `P (n+1) B`.  For `H^{n+1}`-a.e. `x ∈ M`, `ξ(x)` orients `TₓM`, so `‖ξ(x)‖ ≤ 1`
and `ξ₀(x) = ξ(x)`; there `W(x)` is the representing vector of `β ↦ ⟨β ∧ ω(x), ξ(x)⟩`, which
lies in `TₓM`. -/
theorem Submission.dor_lmbsf_ll_tangent_wedge_field : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U (n + 1)) (ω : DifferentialForm (Euclid P) n) (B : ℝ), Continuous ω → (∀ x, ‖ω x‖ ≤ B) → ∃ (W : Euclid P → Euclid P) (c' : ℝ), Measurable W ∧ (∀ x, ω x = 0 → W x = 0) ∧ (∀ x, ‖W x‖ ≤ c') ∧ ∀ᵐ x ∂(μHE[n + 1].restrict R.carrier), W x ∈ approxTangentPlane (n + 1) R.carrier x ∧ ∀ β : Euclid P →L[ℝ] ℝ, R.orient x (ContinuousAlternatingMap.alternatizeUncurryFin (β.smulRight (ω x))) = β (W x) := by
  intro P n U R ω B hω hB
  classical
  -- a strongly measurable version `ξ₁` of `ξ`, and its truncation `ξ₀` to the closed unit ball
  have hξm := R.aestronglyMeasurable_orient
  set ξ₁ : Euclid P → MultiVector P (n + 1) := hξm.mk R.orient with hξ₁_def
  have hξ₁ : StronglyMeasurable ξ₁ := hξm.stronglyMeasurable_mk
  have hξ₁ae : R.orient =ᵐ[μHE[n + 1].restrict R.carrier] ξ₁ := hξm.ae_eq_mk
  set S : Set (Euclid P) := {x | ‖ξ₁ x‖ ≤ 1} with hS_def
  have hS : MeasurableSet S :=
    measurableSet_le (hξ₁.norm (β := MultiVector P (n + 1))).measurable measurable_const
  set ξ₀ : Euclid P → MultiVector P (n + 1) := S.piecewise ξ₁ 0 with hξ₀_def
  have hξ₀ : StronglyMeasurable ξ₀ := hξ₁.piecewise hS stronglyMeasurable_const
  have hξ₀norm : ∀ x, ‖ξ₀ x‖ ≤ 1 := by
    intro x
    by_cases hx : x ∈ S
    · rw [hξ₀_def, Set.piecewise_eq_of_mem _ _ _ hx]; exact hx
    · rw [hξ₀_def, Set.piecewise_eq_of_notMem _ _ _ hx, Pi.zero_apply]
      exact (norm_zero (E := MultiVector P (n + 1))).le.trans zero_le_one
  -- the coefficient forms `Aₗ = eₗ♭ ∧ ω` are continuous
  set e : Fin P → Euclid P := fun l => EuclideanSpace.single l (1 : ℝ) with he_def
  set A : Fin P → Euclid P → Covector (Euclid P) (n + 1) := fun l x =>
    ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ (e l)).smulRight (ω x)) with hA_def
  have hA : ∀ l, Continuous (A l) := by
    intro l
    have h1 : Continuous (fun x => (innerSL ℝ (e l)).smulRight (ω x)) :=
      (isBoundedBilinearMap_smulRight (𝕜 := ℝ) (E := Euclid P)).continuous.comp
        (continuous_const.prodMk hω)
    have h2 := (ContinuousAlternatingMap.alternatizeUncurryFinCLM ℝ (Euclid P) ℝ (n := n)).continuous.comp h1
    simpa [Function.comp_def, ContinuousAlternatingMap.alternatizeUncurryFinCLM_apply] using h2
  -- the coefficients `ξ₀(Aₗ)` are strongly measurable
  have hcoef : ∀ l, StronglyMeasurable (fun x => ξ₀ x (A l x)) := by
    intro l
    have h2 : StronglyMeasurable (A l) := (hA l).stronglyMeasurable
    exact (isBoundedBilinearMap_apply (𝕜 := ℝ) (E := Covector (Euclid P) (n + 1)) (F := ℝ)).continuous.comp_stronglyMeasurable
      (hξ₀.prodMk h2)
  set W : Euclid P → Euclid P := fun x => ∑ l : Fin P, ξ₀ x (A l x) • e l with hW_def
  -- `‖Aₗ‖ ≤ (n+1) ‖eₗ♭‖ ‖ω‖ ≤ (n+1) B`
  have hAnorm : ∀ l x, ‖A l x‖ ≤ (n + 1) * B := by
    intro l x
    have h1 := ContinuousAlternatingMap.norm_alternatizeUncurryFin_le ((innerSL ℝ (e l)).smulRight (ω x))
    have h2 : ‖(innerSL ℝ (e l)).smulRight (ω x)‖ = ‖innerSL ℝ (e l)‖ * ‖ω x‖ :=
      ContinuousLinearMap.norm_smulRight_apply _ _
    have h3 : ‖innerSL ℝ (e l)‖ = 1 := by
      rw [innerSL_apply_norm]; simp [e]
    calc ‖A l x‖ ≤ (n + 1) * ‖(innerSL ℝ (e l)).smulRight (ω x)‖ := h1
      _ = (n + 1) * ‖ω x‖ := by rw [h2, h3, one_mul]
      _ ≤ (n + 1) * B := by gcongr; exact hB x
  refine ⟨W, (P : ℝ) * ((n + 1) * B), ?_, ?_, ?_, ?_⟩
  · exact Finset.measurable_sum _ (fun l _ => (hcoef l).measurable.smul_const (e l))
  · intro x hx
    have hA0 : ∀ l, A l x = 0 := by
      intro l
      have h0 : (innerSL ℝ (e l)).smulRight (0 : Covector (Euclid P) n) = 0 := by ext; simp
      ext v
      simp only [hA_def, hx, h0, ContinuousAlternatingMap.alternatizeUncurryFin_apply]
      simp
    simp only [hW_def, hA0, map_zero, zero_smul, Finset.sum_const_zero]
  · intro x
    calc ‖W x‖ ≤ ∑ l : Fin P, ‖ξ₀ x (A l x) • e l‖ := norm_sum_le _ _
      _ ≤ ∑ l : Fin P, (n + 1) * B := by
          apply Finset.sum_le_sum
          intro l _
          rw [norm_smul]
          have he1 : ‖e l‖ = 1 := by simp [e]
          rw [he1, mul_one]
          calc ‖ξ₀ x (A l x)‖ ≤ ‖ξ₀ x‖ * ‖A l x‖ := (ξ₀ x).le_opNorm _
            _ ≤ 1 * ((n + 1) * B) := by
                gcongr
                · exact hξ₀norm x
                · exact hAnorm l x
            _ = (n + 1) * B := one_mul _
      _ = (P : ℝ) * ((n + 1) * B) := by simp
  -- a.e. on `M`: `ξ` orients `TₓM`, so `‖ξ‖ ≤ 1` and `ξ₀ = ξ₁ = ξ`; then `W` is the representing
  -- vector of `β ↦ ξ(β ∧ ω)`
  · filter_upwards [hξ₁ae, Submission.fvmb_imrep_ae_unitOrientation_approxTangentPlane P (n + 1) U R] with x hx1 hx2
    have hnorm : ‖R.orient x‖ ≤ 1 := Submission.unit_orientation_norm_le_one P (n + 1) _ _ hx2
    have hxS : x ∈ S := by
      show ‖ξ₁ x‖ ≤ 1
      rw [← hx1]; exact hnorm
    have hξ₀x : ξ₀ x = R.orient x := by
      rw [hξ₀_def, Set.piecewise_eq_of_mem _ _ _ hxS, hx1]
    obtain ⟨hidt, hmem⟩ := Submission.dor_lmbsf_ll_wedge_representing_vector P n (R.orient x) (ω x)
    have hWx : W x = ∑ l : Fin P, R.orient x (ContinuousAlternatingMap.alternatizeUncurryFin
        ((innerSL ℝ (EuclideanSpace.single l (1 : ℝ))).smulRight (ω x))) • EuclideanSpace.single l (1 : ℝ) := by
      simp only [hW_def, hA_def, he_def, hξ₀x]
    refine ⟨?_, ?_⟩
    · rw [hWx]; exact hmem _ hx2
    · intro β; rw [hWx]; exact hidt β

/-- **Simon Ch. 6, proof of Lemma 4.5(2), displays (1)–(4)** (Leibniz rule for the Lipschitz
cut-off `h = γ ∘ f`, `γ(s) = min{1, max{0, (b − s)/(b − a)}}`): if `T = τ(M, θ, ξ)`,
`∂T = τ(M', θ', ξ')` and the weak-limit property (G5) holds, then for `ω ∈ 𝒟ⁿ(U)` and `a < b`,
`∫_{M'} θ' h ⟨ω, ξ'⟩ dHⁿ = ∫_M θ h ⟨dω, ξ⟩ dH^{n+1} − (b − a)⁻¹ ∫_{M ∩ {a < f < b}} θ ⟨g♭ ∧ ω, ξ⟩
dH^{n+1}`.  Take `C^∞` functions `h_k → h` uniformly with `‖Dh_k‖ ≤ c` and `|h_k| ≤ 2`, and a
bounded Borel field `W`, zero off `spt ω`, with `W ∈ TₓM` and `ξ(β ∧ ω) = β(W)` for
`H^{n+1}`-a.e. `x ∈ M`.  The defect identity gives `∂T(h_k ω) = T(h_k dω) + ∫_M θ Dh_k[W]`.  As
`k → ∞` the outer terms converge by dominated convergence and the last term by (G5), with limit
`−(b − a)⁻¹ ∫_{M ∩ {a < f < b}} θ ⟨g, W⟩`, and `⟨g, W⟩ = ξ(g♭ ∧ ω)` a.e. on `M`. -/
theorem Submission.dor_lmbsf_lipschitz_cutoff_leibniz : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (n + 1)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (f : Euclid P → ℝ) (L : NNReal) (g : Euclid P → Euclid P), IsOpen U → RT.Represents T → RB.Represents T.boundary → LipschitzWith L f → Measurable g → (∀ x, ‖g x‖ ≤ L) → (∀ (a b : ℝ), a < b → ∀ (hs : ℕ → Euclid P → ℝ) (c : ℝ), (∀ k, ContDiff ℝ 1 (hs k)) → (∀ k x, ‖fderiv ℝ (hs k) x‖ ≤ c) → TendstoUniformly hs (fun x => min 1 (max 0 ((b - f x) / (b - a)))) atTop → ∀ (W : Euclid P → Euclid P) (K : Set (Euclid P)) (c' : ℝ), Measurable W → IsCompact K → K ⊆ U → (∀ x, x ∉ K → W x = 0) → (∀ x, ‖W x‖ ≤ c') → (∀ᵐ x ∂(μHE[n + 1].restrict RT.carrier), W x ∈ approxTangentPlane (n + 1) RT.carrier x) → Tendsto (fun k => ∫ x in RT.carrier, (RT.mult x : ℝ) * fderiv ℝ (hs k) x (W x) ∂μHE[n + 1]) atTop (𝓝 (∫ x in RT.carrier ∩ {x | a < f x ∧ f x < b}, (RT.mult x : ℝ) * (-(b - a)⁻¹ * inner ℝ (g x) (W x)) ∂μHE[n + 1]))) → ∀ (ω : TestFormOn U n) (a b : ℝ), a < b → ∫ x in RB.carrier, (RB.mult x : ℝ) * min 1 (max 0 ((b - f x) / (b - a))) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n] = (∫ x in RT.carrier, (RT.mult x : ℝ) * min 1 (max 0 ((b - f x) / (b - a))) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - (b - a)⁻¹ * ∫ x in RT.carrier ∩ {x | a < f x ∧ f x < b}, (RT.mult x : ℝ) * RT.orient x (ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ (g x)).smulRight ((ω : DifferentialForm (Euclid P) n) x))) ∂μHE[n + 1] := by
  intro P n U T RT RB f L g _hU hRT hRB hf _hgm _hgL hG5 ω a b hab
  -- `ω` is continuous and bounded, and `K = spt ω` is a compact subset of `U`
  obtain ⟨⟨hωs, hωK⟩, hωU⟩ : IsTestForm (ω : DifferentialForm (Euclid P) n) ∧
      tsupport (ω : DifferentialForm (Euclid P) n) ⊆ U := ω.2
  have hωc : Continuous (ω : DifferentialForm (Euclid P) n) := hωs.continuous
  obtain ⟨B, hB⟩ := hωc.bounded_above_of_compact_support hωK
  -- Step 1: `C^∞` cut-offs `h_k → h` uniformly, with `‖Dh_k‖ ≤ c` and `|h_k| ≤ 2`
  obtain ⟨hs, c, hs_smooth, hs_deriv, hs_bdd, hs_unif⟩ :=
    Submission.dor_lmbsf_ll_cutoff_smooth_approx P f L a b hf hab
  have hs_meas : ∀ k, Measurable (hs k) := fun k => (hs_smooth k).continuous.measurable
  -- Step 4: `W` is bounded, Borel and zero off `spt ω`; `W ∈ TₓM` and `ξ(β ∧ ω) = β(W)` a.e.
  obtain ⟨W, c', hWm, hW0, hWc, hWae⟩ :=
    Submission.dor_lmbsf_ll_tangent_wedge_field P n U RT (ω : DifferentialForm (Euclid P) n) B
      hωc hB
  -- Step 4(d): (G5) for `h_k`, `W` and `K = spt ω`
  have hmid := hG5 a b hab hs c (fun k => (hs_smooth k).of_le (by exact_mod_cast le_top))
    hs_deriv hs_unif W (tsupport (ω : DifferentialForm (Euclid P) n)) c' hWm hωK hωU
    (fun x hx => hW0 x (image_eq_zero_of_notMem_tsupport hx)) hWc (hWae.mono fun x hx => hx.1)
  -- Step 3: the outer terms converge by dominated convergence
  have hlimB : Tendsto (fun k => ∫ x in RB.carrier, (RB.mult x : ℝ) * hs k x *
      RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) atTop
      (𝓝 (∫ x in RB.carrier, (RB.mult x : ℝ) * min 1 (max 0 ((b - f x) / (b - a))) *
        RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n])) :=
    Submission.dor_lmbsf_ll_action_mul_tendsto P n U RB ω hs
      (fun x => min 1 (max 0 ((b - f x) / (b - a)))) 2 hs_meas hs_bdd hs_unif.tendsto_at
  have hlimT : Tendsto (fun k => ∫ x in RT.carrier, (RT.mult x : ℝ) * hs k x *
      RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) atTop
      (𝓝 (∫ x in RT.carrier, (RT.mult x : ℝ) * min 1 (max 0 ((b - f x) / (b - a))) *
        RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1])) :=
    Submission.dor_lmbsf_ll_action_mul_tendsto P (n + 1) U RT (exteriorDerivativeTestOn U n ω) hs
      (fun x => min 1 (max 0 ((b - f x) / (b - a)))) 2 hs_meas hs_bdd hs_unif.tendsto_at
  -- Step 2: `T = (θ ξ) H^{n+1}⌞M` and `∂T = (θ' ξ') Hⁿ⌞M'`
  have hrepT : ∀ η : TestFormOn U (n + 1), T η = ∫ x, ((RT.mult x : ℝ) • RT.orient x)
      ((η : DifferentialForm (Euclid P) (n + 1)) x) ∂(μHE[n + 1].restrict RT.carrier) := by
    intro η
    rw [hRT η]
    simp only [IMRep.action, smul_apply, smul_eq_mul]
  have hrepB : ∀ η : TestFormOn U n, T.boundary η = ∫ x, ((RB.mult x : ℝ) • RB.orient x)
      ((η : DifferentialForm (Euclid P) n) x) ∂(μHE[n].restrict RB.carrier) := by
    intro η
    rw [hRB η]
    simp only [IMRep.action, smul_apply, smul_eq_mul]
  -- Steps 2 and 4(c): `∂T(h_k ω) = T(h_k dω) + T(dh_k ∧ ω)` and `ξ(dh_k ∧ ω) = Dh_k[W]` a.e.
  have hk : ∀ k, ∫ x in RB.carrier, (RB.mult x : ℝ) * hs k x *
      RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n] =
      (∫ x in RT.carrier, (RT.mult x : ℝ) * hs k x *
        RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) +
      ∫ x in RT.carrier, (RT.mult x : ℝ) * fderiv ℝ (hs k) x (W x) ∂μHE[n + 1] := by
    intro k
    have hid := Submission.cmcs_cd_defect_identity P n U T (μHE[n + 1].restrict RT.carrier)
      (μHE[n].restrict RB.carrier) (fun x => (RT.mult x : ℝ) • RT.orient x)
      (fun x => (RB.mult x : ℝ) • RB.orient x) (hs k) ω hrepT hrepB (hs_smooth k)
    have e1 : ∫ x, hs k x * ((RT.mult x : ℝ) • RT.orient x)
        (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x)
          ∂(μHE[n + 1].restrict RT.carrier) =
        ∫ x in RT.carrier, (RT.mult x : ℝ) * hs k x *
          RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1] :=
      integral_congr_ae (Eventually.of_forall fun x => by
        simp only [smul_apply, smul_eq_mul]
        ring)
    have e2 : ∫ x, hs k x * ((RB.mult x : ℝ) • RB.orient x)
        ((ω : DifferentialForm (Euclid P) n) x) ∂(μHE[n].restrict RB.carrier) =
        ∫ x in RB.carrier, (RB.mult x : ℝ) * hs k x *
          RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n] :=
      integral_congr_ae (Eventually.of_forall fun x => by
        simp only [smul_apply, smul_eq_mul]
        ring)
    have e3 : ∫ x, ((RT.mult x : ℝ) • RT.orient x)
        (ContinuousAlternatingMap.alternatizeUncurryFin ((fderiv ℝ (hs k) x).smulRight
          ((ω : DifferentialForm (Euclid P) n) x))) ∂(μHE[n + 1].restrict RT.carrier) =
        ∫ x in RT.carrier, (RT.mult x : ℝ) * fderiv ℝ (hs k) x (W x) ∂μHE[n + 1] := by
      refine integral_congr_ae ?_
      filter_upwards [hWae] with x hx
      rw [smul_apply, smul_eq_mul, hx.2]
    rw [e1, e2, e3] at hid
    linarith
  -- Step 4(e): the (G5) limit is `−(b − a)⁻¹ ∫_{M ∩ {a < f < b}} θ ξ(g♭ ∧ ω)`
  have hval : ∫ x in RT.carrier ∩ {x | a < f x ∧ f x < b},
      (RT.mult x : ℝ) * (-(b - a)⁻¹ * inner ℝ (g x) (W x)) ∂μHE[n + 1] =
      -(b - a)⁻¹ * ∫ x in RT.carrier ∩ {x | a < f x ∧ f x < b}, (RT.mult x : ℝ) *
        RT.orient x (ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ (g x)).smulRight
          ((ω : DifferentialForm (Euclid P) n) x))) ∂μHE[n + 1] := by
    rw [← integral_const_mul]
    refine integral_congr_ae ?_
    filter_upwards [ae_restrict_of_ae_restrict_of_subset inter_subset_left hWae] with x hx
    rw [hx.2, innerSL_apply_apply]
    ring
  -- Step 5: let `k → ∞`; limits are unique
  have hlim := tendsto_nhds_unique hlimB ((hlimT.add hmid).congr fun k => (hk k).symm)
  rw [hlim, hval]
  ring

/-- **The slices of an integer multiplicity triple** (Simon Ch. 6, Lemma 4.1, Remark 4.2, 4.3,
Definition 4.4 and the proof of Lemma 4.5(1)).  Let `RT = (M, θ, ξ)` be an integer multiplicity
`(n+1)`-triple in `U`, `f` `L`-Lipschitz and `g` Borel with `|g| ≤ L` and `g(x) ∈ TₓM` a.e. on `M`.
Assume the co-area identity on the slices `Mₜ = M ∩ {g ≠ 0} ∩ f⁻¹(t)`, that every `Mₜ` is
countably `n`-rectifiable and that, when `Hⁿ⌞Mₜ` is locally finite in `U`, `Mₜ` has approximate
tangent space `TₓM ∩ g(x)^⊥` a.e.  Let `ξ₀` be a strongly measurable version of `ξ` and
`ζ' = ξ₀ ⌞ (g/|g|)♭`.  For a.e. `t`, `θ Hⁿ⌞Mₜ` is locally finite and a.e. `x ∈ Mₜ` has `ξ₀(x)`
orienting `TₓM` and `g(x) ∈ TₓM`; then `Rₜ = (Mₜ, θ, ζ')` is an integer multiplicity `n`-triple
(`ζ'(x)` orients `TₓM ∩ g(x)^⊥`), and otherwise `Rₜ` is the empty triple.  The co-area identity
with `φ = θ 1_W` gives `∫ μ_{Rₜ}(W) dt ≤ L μ_{RT}(W)`.  The signed co-area identity for
`q = θ ζ'(ω)` and `q 1_{a<f<b}`, where `|g| q = θ ξ₀(g♭ ∧ ω)` and `|g| |q| ≤ (n+1) L sup|ω| θ` on
`spt ω`, gives the integrability of `t ↦ τ(Rₜ)(ω)` and, as `f ≡ t` on `Mₜ`,
`∫_a^b τ(Rₜ)(ω) dt = ∫_{M ∩ {a<f<b}} θ ⟨g♭ ∧ ω, ξ⟩ dH^{n+1}`. -/
theorem Submission.dor_lmbsf_slice_imreps : ∀ (P n : ℕ) (U : Set (Euclid P)) (RT : IMRep U (n + 1)) (f : Euclid P → ℝ) (L : NNReal) (g : Euclid P → Euclid P), IsOpen U → LipschitzWith L f → Measurable g → (∀ x, ‖g x‖ ≤ L) → (∀ᵐ x ∂(μHE[n + 1].restrict RT.carrier), g x ∈ approxTangentPlane (n + 1) RT.carrier x) → (∀ φ : Euclid P → ℝ≥0∞, Measurable φ → AEMeasurable (fun t => ∫⁻ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}, φ x ∂μHE[n]) ∧ ∫⁻ t, (∫⁻ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}, φ x ∂μHE[n]) = ∫⁻ x in RT.carrier, ‖g x‖ₑ * φ x ∂μHE[n + 1]) → (∀ t, CountablyRectifiable n (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t})) → (∀ t, (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t})), HasApproximateTangentSpaceAt n (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}) x (approxTangentPlane (n + 1) RT.carrier x ⊓ (ℝ ∙ g x)ᗮ)) → ∃ Rs : ℝ → IMRep U n, (∀ t, (Rs t).carrier ⊆ f ⁻¹' {t}) ∧ (∀ W : Set (Euclid P), MeasurableSet W → AEMeasurable (fun t => (Rs t).measure W) ∧ ∫⁻ t, (Rs t).measure W ≤ (L : ℝ≥0∞) * RT.measure W) ∧ (∀ ω : TestFormOn U n, Integrable (fun s => (Rs s).action (ω : DifferentialForm (Euclid P) n))) ∧ ∀ (ω : TestFormOn U n) (a b : ℝ), a < b → ∫ s in a..b, (Rs s).action (ω : DifferentialForm (Euclid P) n) = ∫ x in RT.carrier ∩ {x | a < f x ∧ f x < b}, (RT.mult x : ℝ) * RT.orient x (ContinuousAlternatingMap.alternatizeUncurryFin ((innerSL ℝ (g x)).smulRight ((ω : DifferentialForm (Euclid P) n) x))) ∂μHE[n + 1] := by
  intro P n U RT f L g hU hf hg hgL hgT hco hrect htan
  classical
  have hfm : Measurable f := hf.continuous.measurable
  have hθm : Measurable fun x => (RT.mult x : ℝ≥0∞) := measurable_from_nat.comp RT.measurable_mult
  have hθm' : Measurable fun x => (RT.mult x : ℝ) := measurable_from_nat.comp RT.measurable_mult
  have hgL' : ∀ x, ‖g x‖ₑ ≤ (L : ℝ≥0∞) := fun x =>
    enorm_le_coe.mpr (by rw [← NNReal.coe_le_coe, coe_nnnorm]; exact hgL x)
  have hMt : ∀ t, MeasurableSet (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}) := fun t =>
    (RT.measurableSet_carrier.inter (hg (measurableSet_singleton 0).compl)).inter
      (hfm (measurableSet_singleton t))
  -- `∫_S 1_W θ = ∫_{S ∩ W} θ`
  have hind : ∀ W : Set (Euclid P), MeasurableSet W → ∀ (μ' : Measure (Euclid P))
      (S : Set (Euclid P)), ∫⁻ x in S, W.indicator (fun x => (RT.mult x : ℝ≥0∞)) x ∂μ' =
        ∫⁻ x in S ∩ W, (RT.mult x : ℝ≥0∞) ∂μ' := by
    intro W hW μ' S
    rw [lintegral_indicator hW, Measure.restrict_restrict hW, inter_comm W]
  -- a strongly measurable version `ξ₀` of the orientation `ξ` of `RT`, and the slice orientation
  -- field `ζ' = ξ₀ ⌞ (g/|g|)♭`
  obtain ⟨ξ₀, hξ₀, hξξ₀⟩ : ∃ ξ₀ : Euclid P → MultiVector P (n + 1), StronglyMeasurable ξ₀ ∧
      RT.orient =ᵐ[μHE[n + 1].restrict RT.carrier] ξ₀ :=
    ⟨_, RT.aestronglyMeasurable_orient.stronglyMeasurable_mk,
      RT.aestronglyMeasurable_orient.ae_eq_mk⟩
  obtain ⟨ζ', hζ'm, hζ'ν, hζ'g, hζbd⟩ :=
    Submission.dor_lmbsf_si_slice_orientation_field P n ξ₀ g hξ₀ hg
  -- good points of `M`: `ξ₀(x)` is a unit orientation of `TₓM` and `g(x) ∈ TₓM`
  have hgood : ∀ᵐ x ∂(μHE[n + 1].restrict RT.carrier),
      IsUnitOrientationOf (ξ₀ x) (approxTangentPlane (n + 1) RT.carrier x) ∧
        g x ∈ approxTangentPlane (n + 1) RT.carrier x := by
    filter_upwards [Submission.fvmb_imrep_ae_unitOrientation_approxTangentPlane P (n + 1) U RT,
      hξξ₀, hgT] with x h1 h2 h3
    exact ⟨h2 ▸ h1, h3⟩
  -- step 1: for a.e. `t`, a.e. point of `Mₜ` is a good point of `M`
  have hgood_t : ∀ᵐ t, ∀ᵐ x ∂(μHE[n].restrict (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t})),
      IsUnitOrientationOf (ξ₀ x) (approxTangentPlane (n + 1) RT.carrier x) ∧
        g x ∈ approxTangentPlane (n + 1) RT.carrier x :=
    Submission.dor_lmbsf_si_coarea_ae_transfer P (μHE[n + 1].restrict RT.carrier)
      (fun t => μHE[n].restrict (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t})) (fun x => ‖g x‖ₑ) _
      hco hgood
  -- step 2: for a.e. `t`, `θ Hⁿ⌞Mₜ` is locally finite in `U`; by the co-area identity with
  -- `φ = θ 1_K`, `∫ ∫_{Mₜ ∩ K} θ dHⁿ dt ≤ L ∫_{M ∩ K} θ dH^{n+1} < ∞` for compact `K ⊆ U`
  have hfin : ∀ᵐ t, ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
      ∫⁻ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} ∩ K, (RT.mult x : ℝ≥0∞) ∂μHE[n] ≠ ∞ := by
    refine Submission.dor_lmbsf_si_ae_forall_compact P U
      (fun t K => ∫⁻ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} ∩ K, (RT.mult x : ℝ≥0∞) ∂μHE[n])
      hU (fun t => by
        intro K₁ K₂ hK
        exact lintegral_mono_set (inter_subset_inter_right _ hK)) ?_
    intro K hK hKU
    have hKm : MeasurableSet K := hK.isClosed.measurableSet
    obtain ⟨hae, heq⟩ := hco _ (hθm.indicator hKm)
    have hlt : ∫⁻ t, ∫⁻ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t},
        K.indicator (fun x => (RT.mult x : ℝ≥0∞)) x ∂μHE[n] ≠ ∞ := by
      rw [heq]
      refine ne_top_of_le_ne_top (ENNReal.mul_ne_top (ENNReal.coe_ne_top (r := L))
        (RT.locallyIntegrable_mult K hK hKU)) ?_
      calc ∫⁻ x in RT.carrier, ‖g x‖ₑ * K.indicator (fun x => (RT.mult x : ℝ≥0∞)) x ∂μHE[n + 1]
          ≤ ∫⁻ x in RT.carrier, (L : ℝ≥0∞) * K.indicator (fun x => (RT.mult x : ℝ≥0∞)) x
              ∂μHE[n + 1] := lintegral_mono fun x => mul_le_mul' (hgL' x) le_rfl
        _ = (L : ℝ≥0∞) * ∫⁻ x in RT.carrier ∩ K, (RT.mult x : ℝ≥0∞) ∂μHE[n + 1] := by
          rw [lintegral_const_mul' _ _ ENNReal.coe_ne_top, hind K hKm]
    filter_upwards [ae_lt_top' hae hlt] with t ht
    rw [hind K hKm] at ht
    exact ht.ne
  -- the good levels
  obtain ⟨G, hGae, hGfin, hGgood⟩ : ∃ G : ℝ → Prop, (∀ᵐ t, G t) ∧
      (∀ t, G t → ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
        ∫⁻ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} ∩ K, (RT.mult x : ℝ≥0∞) ∂μHE[n] ≠ ∞) ∧
      (∀ t, G t → ∀ᵐ x ∂(μHE[n].restrict (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t})),
        IsUnitOrientationOf (ξ₀ x) (approxTangentPlane (n + 1) RT.carrier x) ∧
          g x ∈ approxTangentPlane (n + 1) RT.carrier x) :=
    ⟨_, hfin.and hgood_t, fun _ ht => ht.1, fun _ ht => ht.2⟩
  -- steps 3 and 4: `Rₜ = (Mₜ, θ, ζ')` for good `t`, the empty triple otherwise
  have hR : ∀ t, ∃ R : IMRep U n,
      R.carrier = (if G t then RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} else ∅) ∧
        R.mult = RT.mult ∧ R.orient = ζ' := by
    intro t
    by_cases ht : G t
    · -- `Hⁿ⌞Mₜ` is locally finite in `U`, as `θ ≥ 1` on `Mₜ`
      have hfinH : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
          μHE[n] (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} ∩ K) ≠ ∞ := by
        intro K hK hKU
        refine ne_top_of_le_ne_top (hGfin t ht K hK hKU) ?_
        calc μHE[n] (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} ∩ K)
            = ∫⁻ _ in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} ∩ K, 1 ∂μHE[n] :=
              (setLIntegral_one _).symm
          _ ≤ ∫⁻ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} ∩ K, (RT.mult x : ℝ≥0∞) ∂μHE[n] :=
              setLIntegral_mono' ((hMt t).inter hK.isClosed.measurableSet) fun x hx =>
                Nat.one_le_cast.mpr (RT.mult_pos x hx.1.1.1)
      -- `ζ'(x)` orients `TₓM ∩ g(x)^⊥`, the approximate tangent space of `Mₜ` at `x`
      have horients : ∀ᵐ x ∂(μHE[n].restrict (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t})),
          ∃ Q : Submodule ℝ (Euclid P),
            HasApproximateTangentSpaceAt n (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}) x Q ∧
              IsUnitOrientationOf (ζ' x) Q := by
        filter_upwards [htan t hfinH, hGgood t ht, ae_restrict_mem (hMt t)] with x hxT hxg hxM
        have hn : ‖g x‖ ≠ 0 := norm_ne_zero_iff.mpr hxM.1.2
        have h1 : ‖‖g x‖⁻¹ • g x‖ = 1 := by
          rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hn]
        have h := Submission.dor_lmbsf_interior_product_orientation P n (ξ₀ x) (ζ' x)
          (approxTangentPlane (n + 1) RT.carrier x) (‖g x‖⁻¹ • g x) hxg.1
          (Submodule.smul_mem _ _ hxg.2) h1 (hζ'ν x)
        rw [Submodule.span_singleton_smul_eq (inv_ne_zero hn).isUnit] at h
        exact ⟨_, hxT, h⟩
      exact ⟨{ carrier := RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}
               mult := RT.mult
               orient := ζ'
               measurableSet_carrier := hMt t
               carrier_subset := fun x hx => RT.carrier_subset hx.1.1
               rectifiable := hrect t
               measurable_mult := RT.measurable_mult
               mult_pos := fun x hx => RT.mult_pos x hx.1.1
               locallyIntegrable_mult := hGfin t ht
               aestronglyMeasurable_orient := hζ'm.aestronglyMeasurable
               orients := horients }, by rw [ite_eq_left ht], rfl, rfl⟩
    · exact ⟨{ carrier := ∅
               mult := RT.mult
               orient := ζ'
               measurableSet_carrier := MeasurableSet.empty
               carrier_subset := empty_subset _
               rectifiable := (hrect t).mono (empty_subset _)
               measurable_mult := RT.measurable_mult
               mult_pos := fun x hx => absurd hx (notMem_empty x)
               locallyIntegrable_mult := fun K _ _ => by simp
               aestronglyMeasurable_orient := hζ'm.aestronglyMeasurable
               orients := by simp }, by rw [ite_eq_right ht], rfl, rfl⟩
  choose Rs hRc hRm hRo using hR
  -- mass and action of `Rₜ` at good levels
  have hmeas : ∀ W : Set (Euclid P), MeasurableSet W → ∀ t, G t →
      (Rs t).measure W = ∫⁻ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t},
        W.indicator (fun x => (RT.mult x : ℝ≥0∞)) x ∂μHE[n] := by
    intro W hW t ht
    rw [IMRep.measure, withDensity_apply _ hW, hRc t, hRm t, ite_eq_left ht, lintegral_indicator hW]
  have hact : ∀ (ω : DifferentialForm (Euclid P) n) t, G t →
      (Rs t).action ω = ∫ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t},
        (RT.mult x : ℝ) * ζ' x (ω x) ∂μHE[n] := by
    intro ω t ht
    rw [IMRep.action, hRc t, hRm t, hRo t, ite_eq_left ht]
  -- the signed co-area identity
  have hsig : ∀ q : Euclid P → ℝ, Measurable q →
      ∫⁻ x in RT.carrier, ‖g x‖ₑ * ‖q x‖ₑ ∂μHE[n + 1] ≠ ∞ →
      Integrable (fun t => ∫ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}, q x ∂μHE[n]) ∧
        ∫ t, ∫ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}, q x ∂μHE[n] =
          ∫ x in RT.carrier, ‖g x‖ * q x ∂μHE[n + 1] := by
    intro q hq hq'
    have h := Submission.dor_lmbsf_si_coarea_signed_integral P (μHE[n + 1].restrict RT.carrier)
      (fun t => μHE[n].restrict (RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t})) (fun x => ‖g x‖ₑ) q
      hco hg.enorm hq hq'
    simp only [toReal_enorm] at h
    exact h
  -- the integrand `q_ω = θ ζ'(ω)`: measurability and the co-area bound
  -- `|g| |q_ω| = θ |ξ₀(g♭ ∧ ω)| ≤ (n+1) L sup|ω| θ 1_{spt ω}` a.e. on `M`
  have hqm : ∀ ω : TestFormOn U n,
      Measurable fun x => (RT.mult x : ℝ) * ζ' x ((ω : DifferentialForm (Euclid P) n) x) := by
    intro ω
    have hωc : Continuous (ω : DifferentialForm (Euclid P) n) := ContDiff.continuous ω.2.1.1
    exact hθm'.mul ((continuous_fst.clm_apply continuous_snd).comp_stronglyMeasurable
      (hζ'm.prodMk hωc.stronglyMeasurable)).measurable
  have hqfin : ∀ ω : TestFormOn U n, ∫⁻ x in RT.carrier,
      ‖g x‖ₑ * ‖(RT.mult x : ℝ) * ζ' x ((ω : DifferentialForm (Euclid P) n) x)‖ₑ ∂μHE[n + 1] ≠
        ∞ := by
    intro ω
    have hK : IsCompact (tsupport (ω : DifferentialForm (Euclid P) n)) := ω.2.1.2.isCompact
    have hKm : MeasurableSet (tsupport (ω : DifferentialForm (Euclid P) n)) :=
      hK.isClosed.measurableSet
    obtain ⟨c, hc⟩ := (ContDiff.continuous ω.2.1.1).bounded_above_of_compact_support ω.2.1.2
    have hbound : ∀ᵐ x ∂(μHE[n + 1].restrict RT.carrier),
        ‖g x‖ₑ * ‖(RT.mult x : ℝ) * ζ' x ((ω : DifferentialForm (Euclid P) n) x)‖ₑ ≤
          (tsupport (ω : DifferentialForm (Euclid P) n)).indicator
            (fun x => (RT.mult x : ℝ≥0∞) * ENNReal.ofReal (((n : ℝ) + 1) * L * c)) x := by
      filter_upwards [hgood] with x hx
      by_cases hxK : x ∈ tsupport (ω : DifferentialForm (Euclid P) n)
      · rw [indicator_of_mem hxK]
        have hξ1 : ‖ξ₀ x‖ ≤ 1 := Submission.unit_orientation_norm_le_one P (n + 1) _ _ hx.1
        have hreal : ‖g x‖ * ‖(RT.mult x : ℝ) * ζ' x ((ω : DifferentialForm (Euclid P) n) x)‖ ≤
            (RT.mult x : ℝ) * (((n : ℝ) + 1) * L * c) := by
          have h1 : ‖g x‖ * ‖(RT.mult x : ℝ) * ζ' x ((ω : DifferentialForm (Euclid P) n) x)‖ =
              (RT.mult x : ℝ) * |ξ₀ x (ContinuousAlternatingMap.alternatizeUncurryFin
                ((innerSL ℝ (g x)).smulRight ((ω : DifferentialForm (Euclid P) n) x)))| := by
            rw [← hζ'g x]
            simp only [Real.norm_eq_abs, abs_mul, Nat.abs_cast, abs_norm]
            ring
          rw [h1]
          gcongr
          calc |ξ₀ x (ContinuousAlternatingMap.alternatizeUncurryFin
                ((innerSL ℝ (g x)).smulRight ((ω : DifferentialForm (Euclid P) n) x)))|
              ≤ ((n : ℝ) + 1) * ‖ξ₀ x‖ * ‖g x‖ * ‖(ω : DifferentialForm (Euclid P) n) x‖ :=
                hζbd x _
            _ ≤ ((n : ℝ) + 1) * 1 * L * c := by
                gcongr
                exacts [hgL x, hc x]
            _ = ((n : ℝ) + 1) * L * c := by ring
        calc ‖g x‖ₑ * ‖(RT.mult x : ℝ) * ζ' x ((ω : DifferentialForm (Euclid P) n) x)‖ₑ
            = ENNReal.ofReal
                (‖g x‖ * ‖(RT.mult x : ℝ) * ζ' x ((ω : DifferentialForm (Euclid P) n) x)‖) := by
              rw [ENNReal.ofReal_mul (norm_nonneg _), ofReal_norm, ofReal_norm]
          _ ≤ ENNReal.ofReal ((RT.mult x : ℝ) * (((n : ℝ) + 1) * L * c)) :=
              ENNReal.ofReal_le_ofReal hreal
          _ = (RT.mult x : ℝ≥0∞) * ENNReal.ofReal (((n : ℝ) + 1) * L * c) := by
              rw [ENNReal.ofReal_mul (Nat.cast_nonneg _), ENNReal.ofReal_natCast]
      · simp [indicator_of_notMem hxK, image_eq_zero_of_notMem_tsupport hxK]
    refine ne_top_of_le_ne_top ?_ (lintegral_mono_ae hbound)
    rw [lintegral_indicator hKm, Measure.restrict_restrict hKm, inter_comm (tsupport _),
      lintegral_mul_const' _ _ ENNReal.ofReal_ne_top]
    exact ENNReal.mul_ne_top (RT.locallyIntegrable_mult _ hK ω.2.2) ENNReal.ofReal_ne_top
  refine ⟨Rs, fun t x hx => ?_, fun W hW => ?_, fun ω => ?_, fun ω a b hab => ?_⟩
  · -- (1): `Rₜ` is carried by `f⁻¹(t)`
    rw [hRc t] at hx
    split_ifs at hx with ht
    · exact hx.2
    · exact absurd hx (notMem_empty x)
  · -- (2): co-area identity with `φ = θ 1_W` and `|g| ≤ L`
    obtain ⟨hae, heq⟩ := hco _ (hθm.indicator hW)
    have hcongr : (fun t => (Rs t).measure W) =ᵐ[volume] fun t =>
        ∫⁻ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t},
          W.indicator (fun x => (RT.mult x : ℝ≥0∞)) x ∂μHE[n] := by
      filter_upwards [hGae] with t ht using hmeas W hW t ht
    refine ⟨hae.congr hcongr.symm, ?_⟩
    rw [lintegral_congr_ae hcongr, heq]
    calc ∫⁻ x in RT.carrier, ‖g x‖ₑ * W.indicator (fun x => (RT.mult x : ℝ≥0∞)) x ∂μHE[n + 1]
        ≤ ∫⁻ x in RT.carrier, (L : ℝ≥0∞) * W.indicator (fun x => (RT.mult x : ℝ≥0∞)) x
            ∂μHE[n + 1] := lintegral_mono fun x => mul_le_mul' (hgL' x) le_rfl
      _ = (L : ℝ≥0∞) * RT.measure W := by
        rw [lintegral_const_mul' _ _ ENNReal.coe_ne_top, IMRep.measure, withDensity_apply _ hW,
          lintegral_indicator hW]
  · -- (3): `t ↦ τ(Rₜ)(ω)` agrees a.e. with the integrable `t ↦ ∫_{Mₜ} q_ω dHⁿ`
    obtain ⟨hint, -⟩ := hsig _ (hqm ω) (hqfin ω)
    refine hint.congr ?_
    filter_upwards [hGae] with t ht using (hact _ t ht).symm
  · -- (4'): signed co-area identity for `q_ω 1_{a<f<b}`, with `f ≡ t` on `Mₜ` and
    -- `|g| ζ'(ω) = ξ₀(g♭ ∧ ω)`
    have hS : MeasurableSet {x | a < f x ∧ f x < b} :=
      (measurableSet_lt measurable_const hfm).inter (measurableSet_lt hfm measurable_const)
    have hq'fin : ∫⁻ x in RT.carrier, ‖g x‖ₑ * ‖{x | a < f x ∧ f x < b}.indicator
        (fun x => (RT.mult x : ℝ) * ζ' x ((ω : DifferentialForm (Euclid P) n) x)) x‖ₑ
          ∂μHE[n + 1] ≠ ∞ := by
      refine ne_top_of_le_ne_top (hqfin ω) (lintegral_mono fun x => ?_)
      by_cases hx : x ∈ {x | a < f x ∧ f x < b}
      · rw [indicator_of_mem hx]
      · rw [indicator_of_notMem hx, enorm_zero, mul_zero]
        exact zero_le
    obtain ⟨-, heq⟩ := hsig _ ((hqm ω).indicator hS) hq'fin
    rw [intervalIntegral.integral_of_le hab.le, integral_Ioc_eq_integral_Ioo,
      ← integral_indicator measurableSet_Ioo, ← setIntegral_indicator hS]
    calc ∫ s, (Ioo a b).indicator (fun s => (Rs s).action (ω : DifferentialForm (Euclid P) n)) s
        = ∫ s, ∫ x in RT.carrier ∩ {x | g x ≠ 0} ∩ f ⁻¹' {s}, {x | a < f x ∧ f x < b}.indicator
            (fun x => (RT.mult x : ℝ) * ζ' x ((ω : DifferentialForm (Euclid P) n) x)) x
              ∂μHE[n] := by
          refine integral_congr_ae ?_
          filter_upwards [hGae] with s hs
          by_cases hs' : s ∈ Ioo a b
          · rw [indicator_of_mem hs', hact _ s hs]
            refine setIntegral_congr_fun (hMt s) fun x hx => ?_
            have hfx : f x = s := hx.2
            have hxS : x ∈ {x | a < f x ∧ f x < b} := by
              show a < f x ∧ f x < b
              rw [hfx]
              exact hs'
            rw [indicator_of_mem hxS]
          · rw [indicator_of_notMem hs']
            refine (setIntegral_eq_zero_of_forall_eq_zero fun x hx => ?_).symm
            have hfx : f x = s := hx.2
            have hxS : x ∉ {x | a < f x ∧ f x < b} := by
              show ¬(a < f x ∧ f x < b)
              rw [hfx]
              exact hs'
            exact indicator_of_notMem hxS _
      _ = ∫ x in RT.carrier, ‖g x‖ * {x | a < f x ∧ f x < b}.indicator
            (fun x => (RT.mult x : ℝ) * ζ' x ((ω : DifferentialForm (Euclid P) n) x)) x
              ∂μHE[n + 1] := heq
      _ = ∫ x in RT.carrier, {x | a < f x ∧ f x < b}.indicator (fun x => (RT.mult x : ℝ) *
            RT.orient x (ContinuousAlternatingMap.alternatizeUncurryFin
              ((innerSL ℝ (g x)).smulRight ((ω : DifferentialForm (Euclid P) n) x)))) x
                ∂μHE[n + 1] := by
          refine integral_congr_ae ?_
          filter_upwards [hξξ₀] with x hx
          by_cases hxS : x ∈ {x | a < f x ∧ f x < b}
          · rw [indicator_of_mem hxS, indicator_of_mem hxS, hx, ← hζ'g x]
            ring
          · rw [indicator_of_notMem hxS, indicator_of_notMem hxS, mul_zero]

/-- **Simon Ch. 6, 4.4–4.5(2) for an integer multiplicity `T = τ(M, θ, ξ)` and a Lipschitz `f`**
(for a.e. `t`, `R_t = (M ∩ {g ≠ 0} ∩ f⁻¹(t), θ, ξ⌞ν)` with `ν = g/|g|`).
`dor_lmbsf_tangential_gradient` gives the tangential gradient `g` of `f` along `M`: `|g| ≤ L`,
`g ∈ TₓM`, the co-area formula, rectifiable slices with tangent planes `TₓM ∩ g(x)^⊥`, and the
weak limit of the gradients of `C¹` approximations of `γ_{a,b} ∘ f`.  `dor_lmbsf_slice_imreps`
builds the slices, with (1)–(3) and `∫_a^b τ(R_s)(ω) ds = ∫_{M ∩ {a < f < b}} θ ξ(g♭ ∧ ω) dH^{n+1}`
(co-area, Simon 4.2).  `dor_lmbsf_lipschitz_cutoff_leibniz` is the Leibniz rule
`∂T(γω) = T(dγ ∧ ω) + T(γ dω)` for the Lipschitz cut-off `γ = γ_{a,b} ∘ f`, with
`T(dγ ∧ ω) = −(b − a)⁻¹ ∫_{M ∩ {a < f < b}} θ ξ(g♭ ∧ ω) dH^{n+1}`; solving it for this middle term
gives (4). -/
theorem Submission.dor_lmbs_imrep_slice_family : (∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q) → ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (n + 1)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → RT.Represents T → RB.Represents T.boundary → LipschitzWith L f → ∃ Rs : ℝ → IMRep U n, (∀ t, (Rs t).carrier ⊆ f ⁻¹' {t}) ∧ (∀ W : Set (Euclid P), MeasurableSet W → AEMeasurable (fun t => (Rs t).measure W) ∧ ∫⁻ t, (Rs t).measure W ≤ (L : ℝ≥0∞) * RT.measure W) ∧ (∀ ω : TestFormOn U n, Integrable (fun s => (Rs s).action (ω : DifferentialForm (Euclid P) n))) ∧ ∀ (ω : TestFormOn U n) (a b : ℝ), a < b → ∫ s in a..b, (Rs s).action (ω : DifferentialForm (Euclid P) n) = (b - a) * ((∫ x in RT.carrier, (RT.mult x : ℝ) * min 1 (max 0 ((b - f x) / (b - a))) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier, (RB.mult x : ℝ) * min 1 (max 0 ((b - f x) / (b - a))) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) := by
  intro hTL P n U T RT RB f L hU hRT hRB hf
  -- the tangential gradient `g` of `f` along `M`
  obtain ⟨g, hgm, hgL, hgtan, hcoarea, hrect, hslice, hweak⟩ :=
    Submission.dor_lmbsf_tangential_gradient hTL P n U RT f L hU hf
  -- the slices `R_t`, conclusions (1)–(3), and `∫_a^b τ(R_s)(ω) ds` as a middle term
  obtain ⟨Rs, hcarrier, hmass, hint, hmiddle⟩ :=
    Submission.dor_lmbsf_slice_imreps P n U RT f L g hU hf hgm hgL hgtan hcoarea hrect hslice
  refine ⟨Rs, hcarrier, hmass, hint, fun ω a b hab => ?_⟩
  -- (4): the Leibniz identity `A = B - (b - a)⁻¹ * S` solved for `S = (b - a) * (B - A)`
  rw [hmiddle ω a b hab, Submission.dor_lmbsf_lipschitz_cutoff_leibniz P n U T RT RB f L g hU hRT
    hRB hf hgm hgL hweak ω a b hab, sub_sub_cancel, mul_inv_cancel_left₀ (sub_pos.mpr hab).ne']
/-- An open `U ⊆ ℝᴾ` is exhausted by the compact sets
`Kᵢ = B̄(0, i + 1) ∩ {x : 1 / (i + 1) ≤ dist(x, y) for all y ∉ U}`: each `Kᵢ ⊆ U` (take `y = x`),
and a compact `C ⊆ U` has a margin `δ > 0` with `thickening δ C ⊆ U` and a radius `R` with
`C ⊆ B̄(0, R)`, so `C ⊆ Kᵢ` once `1 / (i + 1) < δ` and `R ≤ i + 1`. -/
theorem Submission.dor_lmbs_tfa_compact_exhaustion : ∀ (P : ℕ) (U : Set (Euclid P)), IsOpen U → ∃ K : ℕ → Set (Euclid P), (∀ i, IsCompact (K i)) ∧ (∀ i, K i ⊆ U) ∧ ∀ C : Set (Euclid P), IsCompact C → C ⊆ U → ∃ i, C ⊆ K i := by
  intro P U hU
  refine ⟨fun i => closedBall (0 : Euclid P) ((i : ℝ) + 1) ∩ ⋂ y ∈ Uᶜ, {x | 1 / ((i : ℝ) + 1) ≤ dist x y},
    fun i => ?_, fun i => ?_, fun C hC hCU => ?_⟩
  · exact (isCompact_closedBall _ _).inter_right
      (isClosed_biInter fun y _ => isClosed_le continuous_const (continuous_id.dist continuous_const))
  · -- `x ∉ U` would give `1 / (i + 1) ≤ dist x x = 0`
    intro x hx
    by_contra hxU
    have h : 1 / ((i : ℝ) + 1) ≤ dist x x := mem_iInter₂.1 hx.2 x hxU
    rw [dist_self] at h
    have : (0 : ℝ) < 1 / ((i : ℝ) + 1) := by positivity
    linarith
  · obtain ⟨δ, hδ, hδU⟩ := hC.exists_thickening_subset_open hU hCU
    obtain ⟨R, hR⟩ := hC.isBounded.subset_closedBall (0 : Euclid P)
    obtain ⟨N, hN⟩ := exists_nat_one_div_lt hδ
    obtain ⟨M, hM⟩ := exists_nat_ge R
    have hNi : (N : ℝ) ≤ (max N M : ℕ) := by exact_mod_cast le_max_left N M
    have hMi : (M : ℝ) ≤ (max N M : ℕ) := by exact_mod_cast le_max_right N M
    refine ⟨max N M, fun x hx => ⟨?_, mem_iInter₂.2 fun y hy => ?_⟩⟩
    · have hxR := mem_closedBall.1 (hR hx)
      rw [mem_closedBall]
      linarith
    · -- `y ∉ thickening δ C` gives `δ ≤ dist x y`
      have hxy : δ ≤ dist x y := by
        by_contra h
        exact hy (hδU (mem_thickening_iff.2 ⟨x, hx, by rw [dist_comm]; linarith⟩))
      have hle : 1 / (((max N M : ℕ) : ℝ) + 1) ≤ 1 / ((N : ℝ) + 1) :=
        one_div_le_one_div_of_le (by positivity) (by linarith)
      show 1 / (((max N M : ℕ) : ℝ) + 1) ≤ dist x y
      linarith
/-- `Λⁿ(ℝᴾ)` is finite-dimensional: `α ↦ (α(e_{I(1)}, …, e_{I(n)}))_{I : Fin n → Fin P}` is a linear
map into the finite-dimensional space `(Fin n → Fin P) → ℝ`, injective because an alternating map
is determined by its values on tuples of basis vectors. -/
theorem Submission.dor_lmbs_tfa_covector_finiteDimensional : ∀ (P n : ℕ), FiniteDimensional ℝ (Covector (Euclid P) n) := by
  intro P n
  let e := (EuclideanSpace.basisFun (Fin P) ℝ).toBasis
  -- `L α = (α(e ∘ I))_I`
  let L : Covector (Euclid P) n →ₗ[ℝ] (Fin n → Fin P) → ℝ :=
    { toFun := fun α I => α fun k => e (I k)
      map_add' := fun α β => rfl
      map_smul' := fun c α => rfl }
  refine FiniteDimensional.of_injective L fun α β h => ?_
  apply ContinuousAlternatingMap.toAlternatingMap_injective
  exact e.ext_alternating fun v _ => congrFun h v

/-- Test forms supported in a fixed compact `K` have a countable subfamily `D` approximating every
such `ω` together with `dω`, uniformly on `ℝᴾ`.  The covector spaces are finite-dimensional
(`dor_lmbs_tfa_covector_finiteDimensional`), so `C(K, Λⁿ × Λⁿ⁺¹)` is second countable; pull back
a countable dense subset of the image of `X = {ω : spt ω ⊆ K}` under `Φ ω = (ω, dω)|_K`.  On `K`
the pointwise distances are at most the uniform distance; off `K` all four values vanish. -/
theorem Submission.dor_lmbs_tfa_fixed_support_dense : ∀ (P n : ℕ) (U K : Set (Euclid P)), IsCompact K → ∃ D : Set (TestFormOn U n), D.Countable ∧ (∀ η ∈ D, tsupport (η : DifferentialForm (Euclid P) n) ⊆ K) ∧ ∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ K → ∀ ε : ℝ, 0 < ε → ∃ η ∈ D, (∀ x, dist ((ω : DifferentialForm (Euclid P) n) x) ((η : DifferentialForm (Euclid P) n) x) < ε) ∧ ∀ x, dist (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) (exteriorDerivative (η : DifferentialForm (Euclid P) n) x) < ε := by
  intro P n U K hK
  -- Step 1: a form supported in `K` vanishes off `K`, and so does its exterior derivative
  have hzero : ∀ η : TestFormOn U n, tsupport (η : DifferentialForm (Euclid P) n) ⊆ K →
      ∀ x ∉ K, (η : DifferentialForm (Euclid P) n) x = 0 ∧
        exteriorDerivative (η : DifferentialForm (Euclid P) n) x = 0 := fun η hη x hx =>
    ⟨image_eq_zero_of_notMem_tsupport fun h => hx (hη h),
      image_eq_zero_of_notMem_tsupport fun h => hx (hη (tsupport_exteriorDerivative_subset _ h))⟩
  -- Step 2: `Λⁿ` and `Λⁿ⁺¹` are finite-dimensional, hence proper and second countable
  have := Submission.dor_lmbs_tfa_covector_finiteDimensional P n
  have := Submission.dor_lmbs_tfa_covector_finiteDimensional P (n + 1)
  have : ProperSpace (Covector (Euclid P) n) := FiniteDimensional.proper_real _
  have : ProperSpace (Covector (Euclid P) (n + 1)) := FiniteDimensional.proper_real _
  have : SecondCountableTopology (Covector (Euclid P) n) := secondCountable_of_proper
  have : SecondCountableTopology (Covector (Euclid P) (n + 1)) := secondCountable_of_proper
  -- Step 3: `K` is compact, so `C(K, Λⁿ × Λⁿ⁺¹)` carries the sup metric, and it is second
  -- countable: up to `ε`, `f` is determined by a modulus `j` of uniform continuity at scale `ε / 4`
  -- and by the indices, in a dense sequence `s`, of `ε / 4`-approximations of its values on a
  -- finite `1 / (j + 1)`-net `t j` of `K`
  have : CompactSpace K := isCompact_iff_compactSpace.mp hK
  have : SecondCountableTopology C(K, Covector (Euclid P) n × Covector (Euclid P) (n + 1)) := by
    refine Metric.secondCountable_of_countable_discretization
      (α := C(K, Covector (Euclid P) n × Covector (Euclid P) (n + 1))) fun ε hε => ?_
    obtain ⟨s, hs⟩ := TopologicalSpace.exists_dense_seq
      (Covector (Euclid P) n × Covector (Euclid P) (n + 1))
    choose r hr using fun y : Covector (Euclid P) n × Covector (Euclid P) (n + 1) =>
      hs.exists_dist_lt y (by positivity : (0 : ℝ) < ε / 4)
    have hnet : ∀ j : ℕ, ∃ t : Finset K, ∀ x : K, ∃ p ∈ t, dist x p < 1 / ((j : ℝ) + 1) := by
      intro j
      obtain ⟨t, -, ht⟩ := (isCompact_univ : IsCompact (univ : Set K)).elim_nhds_subcover
        (fun x => ball x (1 / ((j : ℝ) + 1))) fun x _ => ball_mem_nhds x (by positivity)
      exact ⟨t, fun x => by simpa using ht (mem_univ x)⟩
    choose t ht using hnet
    have hmod : ∀ f : C(K, Covector (Euclid P) n × Covector (Euclid P) (n + 1)), ∃ j : ℕ,
        ∀ x y : K, dist x y < 1 / ((j : ℝ) + 1) → dist (f x) (f y) < ε / 4 := by
      intro f
      obtain ⟨δ, hδ, hfδ⟩ := Metric.uniformContinuous_iff.1
        (CompactSpace.uniformContinuous_of_continuous f.continuous) (ε / 4) (by positivity)
      obtain ⟨j, hj⟩ := exists_nat_one_div_lt hδ
      exact ⟨j, fun x y hxy => hfδ (hxy.trans hj)⟩
    choose J hJ using hmod
    refine ⟨ℕ × List ℕ, inferInstance, fun f => (J f, (t (J f)).toList.map fun p => r (f p)),
      fun f g hfg => (ContinuousMap.dist_le hε.le).2 fun x => ?_⟩
    obtain ⟨hj, hl⟩ := Prod.mk.inj hfg
    rw [← hj] at hl
    -- `x` is `1 / (j + 1)`-close to a net point `p`, where `f p` and `g p` have a common index
    obtain ⟨p, hp, hxp⟩ := ht (J f) x
    have hrp : r (f p) = r (g p) := List.map_inj_left.1 hl p (Finset.mem_toList.2 hp)
    have h₁ := hJ f x p hxp
    have h₂ := hr (f p)
    have h₃ := hr (g p)
    have h₄ := hJ g x p (hj ▸ hxp)
    rw [hrp] at h₂
    rw [dist_comm] at h₃ h₄
    linarith [dist_triangle4 (f x) (f p) (s (r (g p))) (g x),
      dist_triangle (s (r (g p))) (g p) (g x)]
  -- Step 4: `Φ ω = (ω, dω)|_K`
  let Φ : TestFormOn U n → C(K, Covector (Euclid P) n × Covector (Euclid P) (n + 1)) := fun ω =>
    ⟨fun x => ((ω : DifferentialForm (Euclid P) n) x,
        exteriorDerivative (ω : DifferentialForm (Euclid P) n) x),
      (ω.property.1.1.continuous.prodMk
        (exteriorDerivative_isTestForm ω.property.1).1.continuous).comp continuous_subtype_val⟩
  let X : Set (TestFormOn U n) := {ω | tsupport (ω : DifferentialForm (Euclid P) n) ⊆ K}
  -- Step 5: a countable `T ⊆ Φ(X)` dense in `Φ(X)`, and a choice `σ` of preimages in `X`
  obtain ⟨T, hTc, hTX, hXT⟩ := TopologicalSpace.exists_countable_dense_subset (Φ '' X)
  have hT : ∀ t ∈ T, ∃ η, η ∈ X ∧ Φ η = t := fun t ht => hTX ht
  choose! σ hσX hσΦ using hT
  -- Step 6: `D = σ(T)` is countable and supported in `K`
  refine ⟨σ '' T, hTc.image σ, ?_, ?_⟩
  · rintro _ ⟨t, ht, rfl⟩
    exact hσX t ht
  -- Step 7: pick `t ∈ T` with `dist (Φ ω) t < ε` and put `η = σ t`
  intro ω hω ε hε
  obtain ⟨t, ht, hdist⟩ := (Metric.mem_closure_iff
    (α := C(K, Covector (Euclid P) n × Covector (Euclid P) (n + 1)))).1 (hXT ⟨ω, hω, rfl⟩) ε hε
  rw [← hσΦ t ht] at hdist
  have key : ∀ x, dist ((ω : DifferentialForm (Euclid P) n) x)
      ((σ t : DifferentialForm (Euclid P) n) x) < ε ∧
      dist (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x)
        (exteriorDerivative (σ t : DifferentialForm (Euclid P) n) x) < ε := by
    intro x
    by_cases hx : x ∈ K
    · -- (a) on `K`: both distances are at most `dist (Φ ω) (Φ η) < ε`
      have h := (ContinuousMap.dist_apply_le_dist (f := Φ ω) (g := Φ (σ t)) ⟨x, hx⟩).trans_lt hdist
      rw [Prod.dist_eq] at h
      exact ⟨(le_max_left _ _).trans_lt h, (le_max_right _ _).trans_lt h⟩
    · -- (b) off `K`: all four values vanish
      obtain ⟨h₁, h₂⟩ := hzero ω hω x hx
      obtain ⟨h₃, h₄⟩ := hzero (σ t) (hσX t ht) x hx
      rw [h₁, h₂, h₃, h₄, dist_self, dist_self]
      exact ⟨hε, hε⟩
  exact ⟨σ t, ⟨t, ht, rfl⟩, fun x => (key x).1, fun x => (key x).2⟩

/-- **A countable family of test forms, dense for `ω` and `dω` with common compact supports**
(Simon Ch. 6, proof of 4.5(2), p. 157: "a countable dense set of `ω ∈ 𝒟ⁿ(U)`").  Take the
compact exhaustion `Kᵢ` of `U` (`dor_lmbs_tfa_compact_exhaustion`) and, for each `i`, a
countable `Dᵢ` approximating every `ω` with `spt ω ⊆ Kᵢ` uniformly together with `dω`
(`dor_lmbs_tfa_fixed_support_dense`); then `D = ⋃ᵢ Dᵢ`.  Given `ω`, `spt ω ⊆ Kᵢ` for some `i`,
and `ωₖ ∈ Dᵢ` within `1/(k+1)` of `ω` and of `dω` gives `ωₖ → ω`, `dωₖ → dω` uniformly. -/
theorem Submission.dor_lmbs_testForm_countable_approx : ∀ (P n : ℕ) (U : Set (Euclid P)), IsOpen U → ∃ D : Set (TestFormOn U n), D.Countable ∧ ∀ ω : TestFormOn U n, ∃ (K : Set (Euclid P)) (ωs : ℕ → TestFormOn U n), IsCompact K ∧ K ⊆ U ∧ tsupport (ω : DifferentialForm (Euclid P) n) ⊆ K ∧ (∀ k, ωs k ∈ D) ∧ (∀ k, tsupport (ωs k : DifferentialForm (Euclid P) n) ⊆ K) ∧ TendstoUniformly (fun k x => (ωs k : DifferentialForm (Euclid P) n) x) (ω : DifferentialForm (Euclid P) n) atTop ∧ TendstoUniformly (fun k x => exteriorDerivative (ωs k : DifferentialForm (Euclid P) n) x) (exteriorDerivative (ω : DifferentialForm (Euclid P) n)) atTop := by
  intro P n U hU
  -- step 1: the compact exhaustion `Kᵢ` of `U`
  obtain ⟨K, hKc, hKU, hKex⟩ := Submission.dor_lmbs_tfa_compact_exhaustion P U hU
  -- steps 2–4: a countable `Dᵢ` for the test forms supported in `Kᵢ`
  choose D hDc hDK hDω using fun i =>
    Submission.dor_lmbs_tfa_fixed_support_dense P n U (K i) (hKc i)
  -- step 5: `D = ⋃ᵢ Dᵢ`
  refine ⟨⋃ i, D i, Set.countable_iUnion hDc, fun ω => ?_⟩
  -- step 6: `spt ω` is a compact subset of `U`, so it lies in some `Kᵢ`
  obtain ⟨i, hi⟩ :=
    hKex (tsupport (ω : DifferentialForm (Euclid P) n)) ω.property.1.2 ω.property.2
  -- `ωₖ ∈ Dᵢ` within `1/(k+1)` of `ω` and of `dω`
  choose ωs hωsD hωs using fun k : ℕ =>
    hDω i ω hi (1 / ((k : ℝ) + 1)) Nat.one_div_pos_of_nat
  have hsmall : ∀ ε : ℝ, 0 < ε → ∀ᶠ k : ℕ in atTop, 1 / ((k : ℝ) + 1) < ε := fun ε hε => by
    obtain ⟨N, hN⟩ := exists_nat_one_div_lt hε
    filter_upwards [Filter.eventually_ge_atTop N] with k hk
    exact (Nat.one_div_le_one_div hk).trans_lt hN
  refine ⟨K i, ωs, hKc i, hKU i, hi, fun k => Set.mem_iUnion.2 ⟨i, hωsD k⟩,
    fun k => hDK i (ωs k) (hωsD k), ?_, ?_⟩
  · rw [Metric.tendstoUniformly_iff]
    intro ε hε
    filter_upwards [hsmall ε hε] with k hk x
    exact ((hωs k).1 x).trans hk
  · rw [Metric.tendstoUniformly_iff]
    intro ε hε
    filter_upwards [hsmall ε hε] with k hk x
    exact ((hωs k).2 x).trans hk

/-- **From averaged slice identities to the pointwise slice identity** (Simon Ch. 6, end of the
proof of 4.5(2), with Remark 4.2).  If `s ↦ τ(R_s)(ω)` is locally integrable and its averages over
`[a, b]` are the cut-off integrals `∫_M θ γ_{a,b}(f) ⟨dω, ξ⟩ − ∫_{M'} θ' γ_{a,b}(f) ⟨ω, ξ'⟩`, then
for a.e. `t` and every `ω`, `τ(R_t)(ω) = ∫_{M ∩ {f < t}} θ ⟨dω, ξ⟩ − ∫_{M' ∩ {f < t}} θ' ⟨ω, ξ'⟩`.
For a fixed `ω` this follows from the Lebesgue differentiation theorem (left averages over
`[y, t]`, `y ↑ t`) and dominated convergence of the cut-offs `γ_{y,t}(f) → 1_{f < t}`; the null set
is made independent of `ω` with the countable family of `dor_lmbs_testForm_countable_approx`, and
the identity passes to all `ω` by dominated convergence along `ω_k → ω`, `dω_k → dω` uniformly with
supports in a common compact set. -/
theorem Submission.dor_lmbs_slice_identity_of_averages : ∀ (P n : ℕ) (U : Set (Euclid P)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (Rs : ℝ → IMRep U n) (f : Euclid P → ℝ), IsOpen U → Measurable f → (∀ ω : TestFormOn U n, LocallyIntegrable (fun s => (Rs s).action (ω : DifferentialForm (Euclid P) n))) → (∀ (ω : TestFormOn U n) (a b : ℝ), a < b → ∫ s in a..b, (Rs s).action (ω : DifferentialForm (Euclid P) n) = (b - a) * ((∫ x in RT.carrier, (RT.mult x : ℝ) * min 1 (max 0 ((b - f x) / (b - a))) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier, (RB.mult x : ℝ) * min 1 (max 0 ((b - f x) / (b - a))) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n])) → ∀ᵐ t, ∀ ω : TestFormOn U n, (Rs t).action (ω : DifferentialForm (Euclid P) n) = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n] := by
  intro P n U RT RB Rs f hU hf hloc havg
  -- Step 1: pairings with a triple `R = (N, φ, ζ)`.  A unit orientation has norm at most `1`, so
  -- `|φ ζ(β)| ≤ C φ 1_K` when `‖β‖ ≤ C` and `β = 0` off the compact `K ⊆ U`.
  have horient : ∀ (k : ℕ) (R : IMRep U k), ∀ᵐ x ∂(μHE[k].restrict R.carrier),
      ∀ α : Covector (Euclid P) k, ‖R.orient x α‖ ≤ ‖α‖ := by
    intro k R
    filter_upwards [R.orients] with x hx α
    obtain ⟨Q, -, τ, hτ, -, hξ⟩ := hx
    have hα : ‖α τ‖ ≤ ‖α‖ := by simpa [hτ.1] using α.le_opNorm τ
    rcases hξ with hξ | hξ <;> simpa [hξ α] using hα
  have hmult : ∀ (k : ℕ) (R : IMRep U k), Measurable fun x => (R.mult x : ℝ) :=
    fun k R => measurable_from_nat.comp R.measurable_mult
  have hmultK : ∀ (k : ℕ) (R : IMRep U k) (K : Set (Euclid P)), IsCompact K → K ⊆ U →
      Integrable (K.indicator fun x => (R.mult x : ℝ)) (μHE[k].restrict R.carrier) := by
    intro k R K hK hKU
    rw [integrable_indicator_iff hK.measurableSet, IntegrableOn,
      Measure.restrict_restrict hK.measurableSet, inter_comm]
    refine ⟨(hmult k R).aestronglyMeasurable, ?_⟩
    rw [hasFiniteIntegral_iff_ofReal (Eventually.of_forall fun x => Nat.cast_nonneg _)]
    simpa only [ENNReal.ofReal_natCast] using
      lt_top_iff_ne_top.2 (R.locallyIntegrable_mult K hK hKU)
  have hmeas : ∀ (k : ℕ) (R : IMRep U k) (β : Euclid P → Covector (Euclid P) k), Continuous β →
      AEStronglyMeasurable (fun x => (R.mult x : ℝ) * R.orient x (β x))
        (μHE[k].restrict R.carrier) :=
    fun k R β hβ => (hmult k R).aestronglyMeasurable.mul
      (Continuous.comp_aestronglyMeasurable₂
        (g := fun (L : MultiVector P k) (v : Covector (Euclid P) k) => L v)
        (continuous_fst.clm_apply continuous_snd) R.aestronglyMeasurable_orient
        hβ.aestronglyMeasurable)
  have hbound : ∀ (k : ℕ) (R : IMRep U k) (K : Set (Euclid P))
      (β : Euclid P → Covector (Euclid P) k) (C : ℝ), (∀ x, ‖β x‖ ≤ C) →
      (∀ x, x ∉ K → β x = 0) → ∀ᵐ x ∂(μHE[k].restrict R.carrier),
        ‖(R.mult x : ℝ) * R.orient x (β x)‖ ≤ C * K.indicator (fun x => (R.mult x : ℝ)) x := by
    intro k R K β C hC hK
    filter_upwards [horient k R] with x hx
    by_cases hxK : x ∈ K
    · rw [indicator_of_mem hxK, norm_mul, Real.norm_natCast, mul_comm C]
      exact mul_le_mul_of_nonneg_left ((hx _).trans (hC x)) (Nat.cast_nonneg _)
    · rw [indicator_of_notMem hxK, hK x hxK, map_zero, mul_zero, norm_zero, mul_zero]
  have hint : ∀ (k : ℕ) (R : IMRep U k) (K : Set (Euclid P))
      (β : Euclid P → Covector (Euclid P) k), IsCompact K → K ⊆ U → Continuous β →
      (∀ x, x ∉ K → β x = 0) →
      Integrable (fun x => (R.mult x : ℝ) * R.orient x (β x)) (μHE[k].restrict R.carrier) := by
    intro k R K β hK hKU hβ hβK
    obtain ⟨C, hC⟩ := hβ.bounded_above_of_compact_support (HasCompactSupport.intro hK hβK)
    exact ((hmultK k R K hK hKU).const_mul C).mono' (hmeas k R β hβ) (hbound k R K β C hC hβK)
  -- dominated convergence along `β_j → β` uniformly, with supports in a common compact `K`
  have hlim : ∀ (k : ℕ) (R : IMRep U k) (ν : Measure (Euclid P)) (K : Set (Euclid P))
      (βs : ℕ → Euclid P → Covector (Euclid P) k) (β : Euclid P → Covector (Euclid P) k),
      ν ≤ μHE[k].restrict R.carrier → IsCompact K → K ⊆ U → Continuous β →
      (∀ j, Continuous (βs j)) → (∀ x, x ∉ K → β x = 0) → (∀ j x, x ∉ K → βs j x = 0) →
      TendstoUniformly βs β atTop →
      Tendsto (fun j => ∫ x, (R.mult x : ℝ) * R.orient x (βs j x) ∂ν) atTop
        (𝓝 (∫ x, (R.mult x : ℝ) * R.orient x (β x) ∂ν)) := by
    intro k R ν K βs β hν hK hKU hβ hβs hβK hβsK hconv
    obtain ⟨C, hC⟩ := hβ.bounded_above_of_compact_support (HasCompactSupport.intro hK hβK)
    refine tendsto_integral_filter_of_dominated_convergence
      (fun x => (C + 1) * K.indicator (fun x => (R.mult x : ℝ)) x)
      (Eventually.of_forall fun j => (hmeas k R (βs j) (hβs j)).mono_measure hν) ?_
      (((hmultK k R K hK hKU).const_mul (C + 1)).mono_measure hν)
      (Eventually.of_forall fun x => tendsto_const_nhds.mul
        (((R.orient x).continuous.tendsto (β x)).comp (hconv.tendsto_at x)))
    filter_upwards [Metric.tendstoUniformly_iff.1 hconv 1 one_pos] with j hj
    refine ae_mono hν (hbound k R K (βs j) (C + 1) (fun x => ?_) (hβsK j))
    have hjx : ‖β x - βs j x‖ < 1 := by simpa [dist_eq_norm] using hj x
    calc ‖βs j x‖ = ‖β x - (β x - βs j x)‖ := by rw [sub_sub_cancel]
      _ ≤ ‖β x‖ + ‖β x - βs j x‖ := norm_sub_le _ _
      _ ≤ C + 1 := add_le_add (hC x) hjx.le
  -- Step 2: the cut-offs `γ_{y,t}(f) = min 1 (max 0 ((t - f) / (t - y)))` lie in `[0, 1]` and
  -- tend to `1_{f < t}` as `y ↑ t`.
  have hcut : ∀ (k : ℕ) (R : IMRep U k) (K : Set (Euclid P))
      (β : Euclid P → Covector (Euclid P) k) (t : ℝ), IsCompact K → K ⊆ U → Continuous β →
      (∀ x, x ∉ K → β x = 0) →
      Tendsto (fun y => ∫ x in R.carrier,
          (R.mult x : ℝ) * min 1 (max 0 ((t - f x) / (t - y))) * R.orient x (β x) ∂μHE[k])
        (𝓝[<] t)
        (𝓝 (∫ x in R.carrier ∩ {x | f x < t}, (R.mult x : ℝ) * R.orient x (β x) ∂μHE[k])) := by
    intro k R K β t hK hKU hβ hβK
    rw [← setIntegral_indicator
      (measurableSet_lt hf measurable_const : MeasurableSet {x | f x < t})]
    refine tendsto_integral_filter_of_dominated_convergence
      (fun x => ‖(R.mult x : ℝ) * R.orient x (β x)‖) (Eventually.of_forall fun y => ?_)
      (Eventually.of_forall fun y => Eventually.of_forall fun x => ?_)
      (hint k R K β hK hKU hβ hβK).norm (Eventually.of_forall fun x => ?_)
    · have hγ : Measurable fun x => min (1 : ℝ) (max 0 ((t - f x) / (t - y))) :=
        measurable_const.min (measurable_const.max ((measurable_const.sub hf).div_const _))
      have h := (hmeas k R β hβ).mul hγ.aestronglyMeasurable
      refine h.congr (Eventually.of_forall fun x => ?_)
      simp only [Pi.mul_apply]
      ring
    · have h0 : 0 ≤ min (1 : ℝ) (max 0 ((t - f x) / (t - y))) :=
        le_min zero_le_one (le_max_left _ _)
      rw [mul_right_comm, norm_mul, Real.norm_of_nonneg h0]
      exact mul_le_of_le_one_right (norm_nonneg _) (min_le_left _ _)
    · by_cases hx : f x < t
      · rw [indicator_of_mem (show x ∈ {x | f x < t} from hx)]
        refine tendsto_const_nhds.congr' ?_
        filter_upwards [Ioo_mem_nhdsLT hx] with y hy
        have h1 : 1 ≤ (t - f x) / (t - y) :=
          (one_le_div (sub_pos.2 hy.2)).2 (by linarith [hy.1])
        rw [max_eq_right (zero_le_one.trans h1), min_eq_left h1, mul_one]
      · rw [indicator_of_notMem (show x ∉ {x | f x < t} from hx)]
        refine tendsto_const_nhds.congr' ?_
        filter_upwards [self_mem_nhdsWithin] with y hy
        have h1 : (t - f x) / (t - y) ≤ 0 :=
          div_nonpos_of_nonpos_of_nonneg (by linarith [not_lt.1 hx]) (sub_pos.2 hy).le
        rw [max_eq_left h1, min_eq_right zero_le_one, mul_zero, zero_mul]
  -- Step 3: for a fixed `ω`, Lebesgue differentiation on `[y, t]`, `y ↑ t`, with (ii) for
  -- `(a, b) = (y, t)` identifies `τ(R_t)(ω)` with the limit of Step 2 off a null set.
  have hpt : ∀ ω : TestFormOn U n, ∀ᵐ t, (Rs t).action (ω : DifferentialForm (Euclid P) n) =
      (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) *
          RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) -
        ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) *
          RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n] := by
    intro ω
    have hω : IsTestForm (ω : DifferentialForm (Euclid P) n) ∧
        tsupport (ω : DifferentialForm (Euclid P) n) ⊆ U := ω.2
    have hK : IsCompact (tsupport (ω : DifferentialForm (Euclid P) n)) := hω.1.2
    filter_upwards
      [(IsUnifLocDoublingMeasure.vitaliFamily (volume : Measure ℝ) 1).ae_tendsto_average (hloc ω)]
      with t ht
    refine tendsto_nhds_unique ((ht.comp (Real.tendsto_Icc_vitaliFamily_left t)).congr' ?_)
      ((hcut (n + 1) RT _ _ t hK hω.2
        (ContDiff.continuous (exteriorDerivative_isTestForm hω.1).1)
        fun x hx => image_eq_zero_of_notMem_tsupport fun h =>
          hx (tsupport_exteriorDerivative_subset _ h)).sub
      (hcut n RB _ _ t hK hω.2 (ContDiff.continuous hω.1.1)
        fun x hx => image_eq_zero_of_notMem_tsupport hx))
    filter_upwards [self_mem_nhdsWithin] with y (hy : y < t)
    simp only [Function.comp_apply]
    rw [setAverage_eq, measureReal_def, Real.volume_Icc, ENNReal.toReal_ofReal (sub_pos.2 hy).le,
      integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hy.le, havg ω y t hy,
      smul_eq_mul, inv_mul_cancel_left₀ (sub_pos.2 hy).ne']
  -- Steps 4–6: one null set for the countable family `D`; every `ω` is a limit of forms in `D`
  -- with `ω_k → ω`, `dω_k → dω` uniformly and supports in one compact `K ⊆ U`.
  obtain ⟨D, hDc, hD⟩ := Submission.dor_lmbs_testForm_countable_approx P n U hU
  filter_upwards [(ae_ball_iff hDc).2 fun η _ => hpt η] with t ht ω
  obtain ⟨K, ωs, hK, hKU, hωK, hωsD, hωsK, hconv, hdconv⟩ := hD ω
  have hω : IsTestForm (ω : DifferentialForm (Euclid P) n) := ω.2.1
  have hωs : ∀ j, IsTestForm (ωs j : DifferentialForm (Euclid P) n) := fun j => (ωs j).2.1
  have hA := hlim n (Rs t) _ K (fun j => (ωs j : DifferentialForm (Euclid P) n)) _ le_rfl hK hKU
    (ContDiff.continuous hω.1) (fun j => ContDiff.continuous (hωs j).1)
    (fun x hx => image_eq_zero_of_notMem_tsupport fun h => hx (hωK h))
    (fun j x hx => image_eq_zero_of_notMem_tsupport fun h => hx (hωsK j h)) hconv
  have hB := (hlim (n + 1) RT (μHE[n + 1].restrict (RT.carrier ∩ {x | f x < t})) K
      (fun j => exteriorDerivative (ωs j : DifferentialForm (Euclid P) n)) _
      (Measure.restrict_mono inter_subset_left le_rfl) hK hKU
      (ContDiff.continuous (exteriorDerivative_isTestForm hω).1)
      (fun j => ContDiff.continuous (exteriorDerivative_isTestForm (hωs j)).1)
      (fun x hx => image_eq_zero_of_notMem_tsupport fun h =>
        hx (hωK (tsupport_exteriorDerivative_subset _ h)))
      (fun j x hx => image_eq_zero_of_notMem_tsupport fun h =>
        hx (hωsK j (tsupport_exteriorDerivative_subset _ h))) hdconv).sub
    (hlim n RB (μHE[n].restrict (RB.carrier ∩ {x | f x < t})) K
      (fun j => (ωs j : DifferentialForm (Euclid P) n)) _
      (Measure.restrict_mono inter_subset_left le_rfl) hK hKU (ContDiff.continuous hω.1)
      (fun j => ContDiff.continuous (hωs j).1)
      (fun x hx => image_eq_zero_of_notMem_tsupport fun h => hx (hωK h))
      (fun j x hx => image_eq_zero_of_notMem_tsupport fun h => hx (hωsK j h)) hconv)
  exact tendsto_nhds_unique hA (hB.congr fun j => (ht (ωs j) (hωsD j)).symm)
/-- Local finiteness of an integer multiplicity representation `(M, θ, ξ)` in `U` (Simon Ch. 6,
Definition 3.1).  For compact `K ⊆ U`, `μ_R(K) = ∫_{M ∩ K} θ dHⁿ < ∞` by the local integrability
of `θ`, and `Hⁿ(M ∩ K) = ∫_{M ∩ K} 1 dHⁿ ≤ ∫_{M ∩ K} θ dHⁿ < ∞` since `θ ≥ 1` on `M`. -/
theorem Submission.rsd_imrep_compact_measure_ne_top : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (K : Set (Euclid P)), IsCompact K → K ⊆ U → μHE[n] (R.carrier ∩ K) ≠ ∞ ∧ R.measure K ≠ ∞ := by
  intro P n U R K hK hKU
  have hint := R.locallyIntegrable_mult K hK hKU
  -- `μ_R(K) = ∫_K θ d(Hⁿ⌞M) = ∫_{M ∩ K} θ dHⁿ`, `K` being closed, hence Borel
  have hmeas : R.measure K = ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
    rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
      Measure.restrict_restrict hK.measurableSet, inter_comm]
  refine ⟨?_, by rw [hmeas]; exact hint⟩
  refine ne_top_of_le_ne_top hint ?_
  -- `Hⁿ(M ∩ K) = ∫_{M ∩ K} 1 dHⁿ ≤ ∫_{M ∩ K} θ dHⁿ`, as `1 ≤ θ` on `M`
  calc μHE[n] (R.carrier ∩ K) = ∫⁻ _ in R.carrier ∩ K, (1 : ℝ≥0∞) ∂μHE[n] := by
        rw [setLIntegral_one]
    _ ≤ ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
        refine setLIntegral_mono (measurable_from_nat.comp R.measurable_mult) ?_
        intro x hx
        exact_mod_cast R.mult_pos x hx.1
/-- Restricting an integer multiplicity triple `R = (C, θ, ξ)` to a Borel sub-carrier `C' ⊆ C`
with multiplicity `0 < θ' ≤ θ` on `C'`, keeping the orientation `ξ`, gives again a triple in `U`,
provided `Hⁿ`-a.e. point of `C'` inherits the approximate tangent spaces of `C` (Simon Ch. 6, 3.1).

Every field of `IMRep` for `(C', θ', ξ)` is inherited from `R`: `C' ⊆ C ⊆ U` is countably
rectifiable, `∫_{C' ∩ K} θ' dHⁿ ≤ ∫_{C' ∩ K} θ dHⁿ ≤ ∫_{C ∩ K} θ dHⁿ < ∞`, `Hⁿ⌞C' ≤ Hⁿ⌞C` carries
the measurability of `ξ`, and `R.orients` restricted to `C'` gives the orientation condition once
`T_x C = Q` is transferred to `T_x C' = Q`. -/
theorem Submission.regcomp_rim_sub_imrep : ∀ (P n : ℕ) (U C' : Set (Euclid P)) (R : IMRep U n) (θ' : Euclid P → ℕ), MeasurableSet C' → C' ⊆ R.carrier → Measurable θ' → (∀ x ∈ C', 0 < θ' x) → (∀ x ∈ C', θ' x ≤ R.mult x) → (∀ᵐ x ∂(μHE[n].restrict C'), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n R.carrier x Q → HasApproximateTangentSpaceAt n C' x Q) → ∃ R' : IMRep U n, R'.carrier = C' ∧ R'.mult = θ' ∧ R'.orient = R.orient := by
  intro P n U C' R θ' hC' hC'C hθ' hpos hle htan
  -- Step 6: `∫_{C' ∩ K} θ' ≤ ∫_{C' ∩ K} θ ≤ ∫_{C ∩ K} θ < ∞`
  have hint : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
      ∫⁻ x in C' ∩ K, (θ' x : ℝ≥0∞) ∂μHE[n] ≠ ∞ := by
    intro K hK hKU
    have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) :=
      (measurable_from_nat (f := fun k : ℕ => (k : ℝ≥0∞))).comp R.measurable_mult
    refine ne_top_of_le_ne_top (R.locallyIntegrable_mult K hK hKU) ?_
    calc ∫⁻ x in C' ∩ K, (θ' x : ℝ≥0∞) ∂μHE[n]
        ≤ ∫⁻ x in C' ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] :=
          setLIntegral_mono hθ fun x hx => by exact_mod_cast hle x hx.1
      _ ≤ ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] :=
          lintegral_mono_set (inter_subset_inter_left K hC'C)
  -- Step 7: `ξ` is a.e. strongly measurable for `Hⁿ⌞C' ≤ Hⁿ⌞C`
  have hmeas : AEStronglyMeasurable R.orient (μHE[n].restrict C') :=
    R.aestronglyMeasurable_orient.mono_measure (Measure.restrict_mono hC'C le_rfl)
  -- Step 8: restrict `R.orients` to `C'` and transfer the approximate tangent space
  have hor : ∀ᵐ x ∂(μHE[n].restrict C'), ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n C' x Q ∧ IsUnitOrientationOf (R.orient x) Q := by
    filter_upwards [ae_restrict_of_ae_restrict_of_subset hC'C R.orients, htan] with x hx hxt
    obtain ⟨Q, hQ, hξ⟩ := hx
    exact ⟨Q, hxt Q hQ, hξ⟩
  -- Step 9: assemble `R' = (C', θ', ξ)`
  exact ⟨IMRep.mk C' θ' R.orient hC' (hC'C.trans R.carrier_subset) (R.rectifiable.mono hC'C) hθ'
    hpos hint hmeas hor, rfl, rfl, rfl⟩
/-- **An integer multiplicity triple defines a current** (Simon 6.3.1 (‡)): for an `IMRep`
`R = (M, θ, ξ)` in `U`, `ω ↦ ∫_M θ⟨ω, ξ⟩ dHⁿ` is a current `T ∈ 𝒟ₙ(U)`, so `T = τ(M, θ, ξ)`.

Write `μ = Hⁿ⌞M`.  A unit orientation has `|ξ(x)(α)| = |α(τ₁, …, τₙ)| ≤ ‖α‖` (`τ` orthonormal),
the integrand is a.e. strongly measurable, and `1_K θ` is `μ`-integrable for compact `K ⊆ U`.
Hence for a test form `ω` the integrand is dominated by `sup|ω| · 1_{spt ω} θ`, so the functional
is defined and linear.  If `ωⱼ → 0` in `𝒟ⁿ(U)` with supports in the compact `K`, then
`|T(ωⱼ)| ≤ sup_K |ωⱼ| · ∫_K θ dμ → 0`. -/
theorem Submission.dtc_imrep_current : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∃ T : GeometricCurrentOn U n, R.Represents T := by
  intro P n U R
  set μ := μHE[n].restrict R.carrier with hμ
  -- (1) a unit orientation has norm at most one
  have hbound : ∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ ‖α‖ := by
    filter_upwards [R.orients] with x hx
    obtain ⟨Q, -, τ, hτ, -, hξ⟩ := hx
    intro α
    have hτn : ∀ i, ‖τ i‖ = 1 := fun i => hτ.1 i
    have hατ : |α τ| ≤ ‖α‖ := by
      have h := α.le_opNorm τ
      simp only [hτn, Finset.prod_const_one, mul_one, Real.norm_eq_abs] at h
      exact h
    rcases hξ with h | h
    · rw [h]; exact hατ
    · rw [h, abs_neg]; exact hατ
  have hθmeas : AEStronglyMeasurable (fun x => (R.mult x : ℝ)) μ :=
    ((measurable_from_nat (f := fun k : ℕ => (k : ℝ))).comp R.measurable_mult).aestronglyMeasurable
  -- (2) measurability of the integrand
  have hmeas : ∀ ω : DifferentialForm (Euclid P) n, Continuous ω →
      AEStronglyMeasurable (fun x => (R.mult x : ℝ) * R.orient x (ω x)) μ := by
    intro ω hω
    have h2 : AEStronglyMeasurable (fun x => R.orient x (ω x)) μ :=
      Continuous.comp_aestronglyMeasurable₂
        (g := fun (L : MultiVector P n) (α : Covector (Euclid P) n) => L α)
        (isBoundedBilinearMap_apply (𝕜 := ℝ) (E := Covector (Euclid P) n) (F := ℝ)).continuous
        R.aestronglyMeasurable_orient hω.aestronglyMeasurable
    exact hθmeas.mul h2
  -- (3) `θ` is integrable over compact subsets of `U`
  have hθK : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
      Integrable (K.indicator fun x => (R.mult x : ℝ)) μ := by
    intro K hK hKU
    rw [integrable_indicator_iff hK.isClosed.measurableSet]
    refine ⟨hθmeas.restrict, ?_⟩
    show ∫⁻ x, ‖(R.mult x : ℝ)‖ₑ ∂(μ.restrict K) < ∞
    rw [hμ, Measure.restrict_restrict hK.isClosed.measurableSet, inter_comm]
    simp only [Real.enorm_natCast]
    exact lt_top_iff_ne_top.mpr (R.locallyIntegrable_mult K hK hKU)
  -- (4) integrability of the integrand for test forms
  have hint : ∀ ω : TestFormOn U n,
      Integrable (fun x => (R.mult x : ℝ) * R.orient x ((ω : DifferentialForm (Euclid P) n) x))
        μ := by
    intro ω
    have hωc : Continuous (ω : DifferentialForm (Euclid P) n) := ω.property.1.1.continuous
    obtain ⟨C, hC⟩ := HasCompactSupport.exists_bound_of_continuous ω.property.1.2 hωc
    have hK : IsCompact (tsupport (ω : DifferentialForm (Euclid P) n)) := ω.property.1.2
    refine Integrable.mono' ((hθK _ hK ω.property.2).const_mul C) (hmeas _ hωc) ?_
    filter_upwards [hbound] with x hx
    by_cases hxK : x ∈ tsupport (ω : DifferentialForm (Euclid P) n)
    · rw [indicator_of_mem hxK, norm_mul, Real.norm_natCast, Real.norm_eq_abs]
      calc (R.mult x : ℝ) * |R.orient x ((ω : DifferentialForm (Euclid P) n) x)|
          ≤ (R.mult x : ℝ) * ‖(ω : DifferentialForm (Euclid P) n) x‖ := by
            gcongr; exact hx _
        _ ≤ (R.mult x : ℝ) * C := by gcongr; exact hC x
        _ = C * (R.mult x : ℝ) := mul_comm _ _
    · have h0 : (ω : DifferentialForm (Euclid P) n) x = 0 := image_eq_zero_of_notMem_tsupport hxK
      simp [h0, indicator_of_notMem hxK]
  -- (5) the linear functional `ω ↦ ∫_M θ ⟨ω, ξ⟩ dHⁿ`
  let L : TestFormOn U n →ₗ[ℝ] ℝ :=
    { toFun := fun ω => R.action (ω : DifferentialForm (Euclid P) n)
      map_add' := by
        intro ω η
        simp only [IMRep.action, Submodule.coe_add, Pi.add_apply, map_add, mul_add]
        exact integral_add (hint ω) (hint η)
      map_smul' := by
        intro c ω
        simp only [IMRep.action, Submodule.coe_smul, Pi.smul_apply, map_smul, smul_eq_mul,
          RingHom.id_apply]
        rw [← integral_const_mul]
        congr 1
        funext x
        ring }
  refine ⟨⟨L, ?_⟩, fun ω => rfl⟩
  -- (6) sequential continuity
  intro ωs hconv
  obtain ⟨K, hK, hKU, hsupp, -, hderiv⟩ := hconv
  have h0 := hderiv 0
  rw [Metric.tendstoUniformlyOn_iff] at h0
  set CK := ∫ x, K.indicator (fun x => (R.mult x : ℝ)) x ∂μ with hCKdef
  have hCK : 0 ≤ CK := integral_nonneg fun x => indicator_nonneg (fun _ _ => Nat.cast_nonneg _) x
  rw [Metric.tendsto_atTop]
  intro ε hε
  have hε' : 0 < ε / (CK + 1) := div_pos hε (by linarith)
  obtain ⟨N, hN⟩ := eventually_atTop.mp (h0 (ε / (CK + 1)) hε')
  refine ⟨N, fun j hj => ?_⟩
  have hptw : ∀ x ∈ K, ‖(ωs j : DifferentialForm (Euclid P) n) x‖ < ε / (CK + 1) := by
    intro x hx
    have h := hN j hj x hx
    rw [dist_comm, dist_eq_norm] at h
    simpa [norm_iteratedFDeriv_zero] using h
  rw [Real.dist_eq, sub_zero]
  have hle : |L (ωs j)| ≤ ∫ x, (ε / (CK + 1)) * K.indicator (fun x => (R.mult x : ℝ)) x ∂μ := by
    refine (Real.norm_eq_abs _).symm.le.trans (norm_integral_le_of_norm_le
      ((hθK K hK hKU).const_mul _) ?_)
    filter_upwards [hbound] with x hx
    by_cases hxK : x ∈ K
    · rw [indicator_of_mem hxK, norm_mul, Real.norm_natCast, Real.norm_eq_abs]
      calc (R.mult x : ℝ) * |R.orient x ((ωs j : DifferentialForm (Euclid P) n) x)|
          ≤ (R.mult x : ℝ) * ‖(ωs j : DifferentialForm (Euclid P) n) x‖ := by
            gcongr; exact hx _
        _ ≤ (R.mult x : ℝ) * (ε / (CK + 1)) := by gcongr; exact (hptw x hxK).le
        _ = ε / (CK + 1) * (R.mult x : ℝ) := mul_comm _ _
    · have h0 : (ωs j : DifferentialForm (Euclid P) n) x = 0 :=
        image_eq_zero_of_notMem_tsupport (fun h => hxK (hsupp j h))
      simp [h0, indicator_of_notMem hxK]
  rw [integral_const_mul, ← hCKdef] at hle
  calc |L (ωs j)| ≤ ε / (CK + 1) * CK := hle
    _ < ε := by
      rw [div_mul_eq_mul_div, div_lt_iff₀ (by linarith)]
      nlinarith
/-- **Algebra of unit orientations** (Simon 6.1.1, 6.1.7, 6.2.2): for `n`-vectors on `ℝᴾ`,
(a) two unit orientations `ξ`, `ξ'` of the same subspace `T` agree up to sign, `ξ' = ±ξ`;
(b) a unit orientation `ξ` satisfies `|ξ(β)| ≤ ‖β‖` for every `n`-covector `β`;
(c) if `A : ℝⁿ → ℝᴾ` is injective, then `J_A = det(⟨Aeₖ, Aeₗ⟩)^{1/2} > 0` and
`J_A⁻¹ A_#e : β ↦ J_A⁻¹ β(Ae₁, …, Aeₙ)` is a unit orientation of `range A`;
(d) if `A` is not injective, then `β(Ae₁, …, Aeₙ) = 0` for every `n`-covector `β`.
For an orthonormal `τ` and `bⱼ ∈ span τ`, with `M = (⟨τᵢ, bⱼ⟩)`, `α(b) = det M · α(τ)` (expand
`α` in the basis `τ` of `span τ`) and `det(⟨bₖ, bₗ⟩) = (det M)²` (Parseval).  Two orthonormal
frames of `T` therefore differ by `det M = ±1`; for injective `A`, a Gram–Schmidt frame `τ` of
`range A` gives an invertible `M` and `J_A = |det M|`; a non-injective `A` makes `(Aeₖ)` linearly
dependent. -/
theorem Submission.dtc_bc_lc_pfi_unitOrientation_algebra : ∀ (P n : ℕ), (∀ (ξ ξ' : MultiVector P n) (T : Submodule ℝ (Euclid P)), IsUnitOrientationOf ξ T → IsUnitOrientationOf ξ' T → ξ' = ξ ∨ ξ' = -ξ) ∧ (∀ (ξ : MultiVector P n) (T : Submodule ℝ (Euclid P)), IsUnitOrientationOf ξ T → ∀ β : Covector (Euclid P) n, |ξ β| ≤ ‖β‖) ∧ (∀ A : Euclid n →L[ℝ] Euclid P, Injective A → 0 < Real.sqrt (Matrix.det (Matrix.of fun k l : Fin n => inner ℝ (A (EuclideanSpace.single k 1)) (A (EuclideanSpace.single l 1)))) ∧ IsUnitOrientationOf ((Real.sqrt (Matrix.det (Matrix.of fun k l : Fin n => inner ℝ (A (EuclideanSpace.single k 1)) (A (EuclideanSpace.single l 1)))))⁻¹ • ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ (fun k : Fin n => A (EuclideanSpace.single k 1))) (LinearMap.range (A : Euclid n →ₗ[ℝ] Euclid P))) ∧ ∀ A : Euclid n →L[ℝ] Euclid P, ¬ Injective A → ∀ β : Covector (Euclid P) n, β (fun k : Fin n => A (EuclideanSpace.single k 1)) = 0 := by
  intro P n
  -- Step 1 (expansion): for orthonormal `τ` and `bⱼ ∈ span τ`, `α(b) = det(⟨τᵢ, bⱼ⟩) α(τ)`
  have hE : ∀ (τ b : Fin n → Euclid P), Orthonormal ℝ τ →
      (∀ j, b j ∈ Submodule.span ℝ (Set.range τ)) → ∀ α : Covector (Euclid P) n,
        α b = (Matrix.of fun i j => inner ℝ (τ i) (b j)).det * α τ := by
    intro τ b hτ hb α
    set L := Submodule.span ℝ (Set.range τ)
    -- `τ` is a basis `e` of `L`
    let e : Module.Basis (Fin n) ℝ L := Module.Basis.span hτ.linearIndependent
    have he : ∀ i, (e i : Euclid P) = τ i := fun i => by
      rw [Module.Basis.span_apply hτ.linearIndependent i]
    -- the restriction `α_L` of `α` to `L`
    let αL : L [⋀^Fin n]→ₗ[ℝ] ℝ := α.toAlternatingMap.compLinearMap L.subtype
    let b' : Fin n → L := fun j => ⟨b j, hb j⟩
    have h1 : α b = αL b' := rfl
    have h2 : α τ = αL e := by
      show α τ = α (fun i => (e i : Euclid P))
      congr 1
      funext i
      exact (he i).symm
    -- coordinates of `b'` in `e` are the inner products with `τ`
    have hrepr : ∀ i j, e.repr (b' j) i = inner ℝ (τ i) (b j) := by
      intro i j
      have hs : (b j : Euclid P) = ∑ l, e.repr (b' j) l • τ l := by
        have := congrArg (Subtype.val) (e.sum_repr (b' j))
        simp only [Submodule.coe_sum, Submodule.coe_smul, he] at this
        exact this.symm
      rw [hs, hτ.inner_right_fintype]
    have hmat : e.toMatrix b' = Matrix.of fun i j => inner ℝ (τ i) (b j) := by
      ext i j
      rw [Module.Basis.toMatrix_apply, hrepr, Matrix.of_apply]
    -- `α_L = α_L(e) • det_e`
    have h3 : αL b' = αL e * e.det b' := by
      conv_lhs => rw [AlternatingMap.eq_smul_basis_det e αL]
      rfl
    rw [h1, h2, h3, Module.Basis.det_apply, hmat, mul_comm]
  -- Step 2 (coordinates): for orthonormal `τ` and `bⱼ ∈ span τ`, `bⱼ = Σᵢ ⟨τᵢ, bⱼ⟩ τᵢ`
  have hcoord : ∀ (τ b : Fin n → Euclid P), Orthonormal ℝ τ →
      (∀ j, b j ∈ Submodule.span ℝ (Set.range τ)) → ∀ j, b j = ∑ i, inner ℝ (τ i) (b j) • τ i := by
    intro τ b hτ hb j
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp (hb j)
    have hci : ∀ i, inner ℝ (τ i) (b j) = c i := fun i => by rw [← hc, hτ.inner_right_fintype]
    calc b j = ∑ i, c i • τ i := hc.symm
      _ = ∑ i, inner ℝ (τ i) (b j) • τ i := Finset.sum_congr rfl fun i _ => by rw [hci i]
  -- Step 3 (Parseval): `(⟨bₖ, bₗ⟩) = MᵀM` for `M = (⟨τᵢ, bⱼ⟩)`, so `det(⟨bₖ, bₗ⟩) = (det M)²`
  have hG : ∀ (τ b : Fin n → Euclid P), Orthonormal ℝ τ →
      (∀ j, b j ∈ Submodule.span ℝ (Set.range τ)) →
        (Matrix.of fun k l => inner ℝ (b k) (b l)).det =
          (Matrix.of fun i j => inner ℝ (τ i) (b j)).det ^ 2 := by
    intro τ b hτ hb
    have hmat : (Matrix.of fun k l => inner ℝ (b k) (b l)) =
        (Matrix.of fun i j => inner ℝ (τ i) (b j)).transpose *
          Matrix.of fun i j => inner ℝ (τ i) (b j) := by
      ext k l
      rw [Matrix.mul_apply, Matrix.of_apply]
      conv_lhs => rw [hcoord τ b hτ hb k]
      rw [sum_inner]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [real_inner_smul_left, Matrix.transpose_apply, Matrix.of_apply, Matrix.of_apply]
    rw [hmat, Matrix.det_mul, Matrix.det_transpose, sq]
  -- Step 4: the standard basis `eₖ = single k 1` of `ℝⁿ` is independent and spanning
  have he_fun : ⇑(EuclideanSpace.basisFun (Fin n) ℝ).toBasis =
      fun k : Fin n => (EuclideanSpace.single k 1 : Euclid n) := by
    rw [OrthonormalBasis.coe_toBasis]
    funext k
    exact EuclideanSpace.basisFun_apply (Fin n) ℝ k
  have he_li : LinearIndependent ℝ (fun k : Fin n => (EuclideanSpace.single k 1 : Euclid n)) := by
    have := (EuclideanSpace.basisFun (Fin n) ℝ).toBasis.linearIndependent
    rwa [he_fun] at this
  have he_span :
      Submodule.span ℝ (Set.range fun k : Fin n => (EuclideanSpace.single k 1 : Euclid n)) = ⊤ := by
    have := (EuclideanSpace.basisFun (Fin n) ℝ).toBasis.span_eq
    rwa [he_fun] at this
  refine ⟨?_, ?_, ?_, ?_⟩
  · -- (a) `τ'` lies in `span τ`, so `α(τ') = det O · α(τ)` with `(det O)² = det 1 = 1`
    rintro ξ ξ' T ⟨τ, hτ, hτT, hξ⟩ ⟨τ', hτ', hτ'T, hξ'⟩
    have hmem : ∀ j, τ' j ∈ Submodule.span ℝ (Set.range τ) := fun j => by
      rw [hτT, ← hτ'T]
      exact Submodule.subset_span ⟨j, rfl⟩
    obtain ⟨d, hexp, hd⟩ : ∃ d : ℝ, (∀ α : Covector (Euclid P) n, α τ' = d * α τ) ∧ d ^ 2 = 1 := by
      refine ⟨_, hE τ τ' hτ hmem, ?_⟩
      rw [← hG τ τ' hτ hmem]
      have h1 : (Matrix.of fun k l => inner ℝ (τ' k) (τ' l)) = 1 := by
        ext k l
        rw [Matrix.of_apply, Matrix.one_apply]
        exact orthonormal_iff_ite.mp hτ' k l
      rw [h1, Matrix.det_one]
    -- the signs `s, s' = ±1` of `ξ = s τ` and `ξ' = s' τ'`
    obtain ⟨s, hs, hξs⟩ : ∃ s : ℝ, s * s = 1 ∧ ∀ α, ξ α = s * α τ := by
      rcases hξ with h | h
      · exact ⟨1, one_mul 1, fun α => by rw [h, one_mul]⟩
      · exact ⟨-1, by norm_num, fun α => by rw [h, neg_one_mul]⟩
    obtain ⟨s', hs', hξs'⟩ : ∃ s : ℝ, s * s = 1 ∧ ∀ α, ξ' α = s * α τ' := by
      rcases hξ' with h | h
      · exact ⟨1, one_mul 1, fun α => by rw [h, one_mul]⟩
      · exact ⟨-1, by norm_num, fun α => by rw [h, neg_one_mul]⟩
    -- `ξ' = c ξ` with `c = s' · det O · s` and `c² = 1`
    have hc : ∀ α : Covector (Euclid P) n, ξ' α = (s' * d * s) * ξ α := by
      intro α
      rw [hξs' α, hexp α, hξs α]
      linear_combination (-(s' * d * α τ)) * hs
    have hc1 : (s' * d * s) * (s' * d * s) = 1 := by
      linear_combination (s' * s' * d ^ 2) * hs + (s' * s') * hd + hs'
    rcases mul_self_eq_one_iff.mp hc1 with h | h
    · left
      exact ContinuousLinearMap.ext fun α => by rw [hc α, h, one_mul]
    · right
      exact ContinuousLinearMap.ext fun α => by rw [hc α, h, neg_apply, neg_one_mul]
  · -- (b) `|ξ(β)| = |β(τ)| ≤ ‖β‖ ∏ᵢ ‖τᵢ‖ = ‖β‖`
    rintro ξ T ⟨τ, hτ, -, hξ⟩ β
    have h1 : |β τ| ≤ ‖β‖ := by
      have h := β.le_opNorm τ
      rw [Finset.prod_eq_one fun i _ => hτ.1 i, mul_one, Real.norm_eq_abs] at h
      exact h
    rcases hξ with h | h
    · rw [h β]
      exact h1
    · rw [h β, abs_neg]
      exact h1
  · -- (c) a Gram–Schmidt frame `τ` of `range A = span (Aeₖ)`, and `M = (⟨τᵢ, Aeⱼ⟩)`
    intro A hA
    set v : Fin n → Euclid P := fun k => A (EuclideanSpace.single k 1) with hv_def
    have hv : LinearIndependent ℝ v :=
      he_li.map' (A : Euclid n →ₗ[ℝ] Euclid P) (LinearMap.ker_eq_bot.mpr hA)
    have hspan_v :
        Submodule.span ℝ (Set.range v) = LinearMap.range (A : Euclid n →ₗ[ℝ] Euclid P) := by
      rw [LinearMap.range_eq_map, ← he_span, Submodule.map_span, ← Set.range_comp]
      rfl
    obtain ⟨τ, hτ, hτspan⟩ : ∃ τ : Fin n → Euclid P, Orthonormal ℝ τ ∧
        Submodule.span ℝ (Set.range τ) = Submodule.span ℝ (Set.range v) :=
      ⟨InnerProductSpace.gramSchmidtNormed ℝ v, InnerProductSpace.gramSchmidtNormed_orthonormal hv,
        by rw [InnerProductSpace.span_gramSchmidtNormed_range, InnerProductSpace.span_gramSchmidt]⟩
    have hvmem : ∀ j, v j ∈ Submodule.span ℝ (Set.range τ) := fun j => by
      rw [hτspan]
      exact Submodule.subset_span ⟨j, rfl⟩
    -- `M` is invertible: `M c = 0` gives `Σⱼ cⱼ vⱼ = Σᵢ (M c)ᵢ τᵢ = 0`, so `c = 0`
    have hMne : (Matrix.of fun i j => inner ℝ (τ i) (v j)).det ≠ 0 := by
      intro h0
      obtain ⟨c, hc0, hc⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr h0
      apply hc0
      funext j
      refine Fintype.linearIndependent_iff.mp hv c ?_ j
      calc ∑ j, c j • v j = ∑ j, c j • ∑ i, inner ℝ (τ i) (v j) • τ i :=
            Finset.sum_congr rfl fun j _ => by rw [← hcoord τ v hτ hvmem j]
        _ = ∑ i, (∑ j, inner ℝ (τ i) (v j) * c j) • τ i := by
            simp only [Finset.smul_sum, smul_smul, Finset.sum_smul]
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
            rw [mul_comm]
        _ = 0 := by
            refine Finset.sum_eq_zero fun i _ => ?_
            have := congrFun hc i
            simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.zero_apply] at this
            rw [this, zero_smul]
    obtain ⟨d, hd0, hexp, hgram⟩ : ∃ d : ℝ, d ≠ 0 ∧ (∀ α : Covector (Euclid P) n, α v = d * α τ) ∧
        (Matrix.of fun k l => inner ℝ (v k) (v l)).det = d ^ 2 :=
      ⟨_, hMne, hE τ v hτ hvmem, hG τ v hτ hvmem⟩
    -- `J_A = ((det M)²)^{1/2} = |det M| > 0` and `J_A⁻¹ β(Ae) = sign(det M) β(τ)`
    have hJ : Real.sqrt (Matrix.det (Matrix.of fun k l : Fin n =>
        inner ℝ (A (EuclideanSpace.single k 1)) (A (EuclideanSpace.single l 1)))) = |d| := by
      rw [← Real.sqrt_sq_eq_abs, ← hgram]
    rw [hJ]
    refine ⟨abs_pos.mpr hd0, τ, hτ, hτspan.trans hspan_v, ?_⟩
    have hval : ∀ α : Covector (Euclid P) n,
        (|d|⁻¹ • ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ v) α = (|d|⁻¹ * d) * α τ := by
      intro α
      rw [smul_apply, ContinuousAlternatingMap.apply_apply, smul_eq_mul, hexp α, mul_assoc]
    rcases lt_or_gt_of_ne hd0 with hneg | hpos
    · right
      intro α
      rw [hval, abs_of_neg hneg, inv_neg, neg_mul, inv_mul_cancel₀ hd0, neg_one_mul]
    · left
      intro α
      rw [hval, abs_of_pos hpos, inv_mul_cancel₀ hd0, one_mul]
  · -- (d) if `(Aeₖ)` were independent, `A` would be injective (`e` spans `ℝⁿ`)
    intro A hA β
    have hdep : ¬ LinearIndependent ℝ (fun k : Fin n => A (EuclideanSpace.single k 1)) := fun hli =>
      hA (LinearMap.injective_of_linearIndependent (f := (A : Euclid n →ₗ[ℝ] Euclid P)) he_span hli)
    exact β.toAlternatingMap.map_linearDependent _ hdep
/-- Zero `n`-density of the excess `B ∖ A` (step 5 of the tangent-locality argument): if
`Hⁿ(A ∩ B̄_ρ(x)) ≤ Cρⁿ` for `0 < ρ < r₁`, `Hⁿ(B ∩ B̄_{r₀}(x)) < ∞`, and for every `ε > 0`
eventually `Hⁿ((B ∖ A) ∩ B̄_ρ(x)) ≤ ε Hⁿ(B ∩ B̄_ρ(x))`, then `ρ⁻ⁿ Hⁿ((B ∖ A) ∩ B̄_ρ(x)) → 0`.
Subadditivity and `ε = 1/2` give `Hⁿ(B ∩ B̄_ρ(x)) ≤ 2Cρⁿ` for small `ρ` (cancelling the finite
half), and then `ε = δ/(2C + 1)` gives `Hⁿ((B ∖ A) ∩ B̄_ρ(x)) ≤ δρⁿ`. -/
theorem Submission.rsdic_tl_excess_density_zero : ∀ (P n : ℕ) (A B : Set (Euclid P)) (x : Euclid P) (r₀ C r₁ : ℝ), 0 < r₀ → μHE[n] (B ∩ closedBall x r₀) ≠ ∞ → 0 < r₁ → (∀ ρ : ℝ, 0 < ρ → ρ < r₁ → μHE[n] (A ∩ closedBall x ρ) ≤ ENNReal.ofReal (C * ρ ^ n)) → (∀ ε : ℝ≥0∞, 0 < ε → ∀ᶠ ρ in 𝓝[>] (0 : ℝ), μHE[n] ((B \ A) ∩ closedBall x ρ) ≤ ε * μHE[n] (B ∩ closedBall x ρ)) → Tendsto (fun ρ : ℝ => μHE[n] ((B \ A) ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n) (𝓝[>] 0) (𝓝 0) := by
  intro P n A B x r₀ C r₁ hr₀ hfin hr₁ hA hBA
  -- Steps 1–3: eventually `Hⁿ(B ∩ B̄_ρ(x)) ≤ K ρⁿ` with `K = 2 ofReal(C)`
  set K : ℝ≥0∞ := 2 * ENNReal.ofReal C with hK
  have hB : ∀ᶠ ρ in 𝓝[>] (0 : ℝ), μHE[n] (B ∩ closedBall x ρ) ≤ K * ENNReal.ofReal ρ ^ n := by
    -- Step 1: eventually `0 < ρ < min r₀ r₁`, so `Hⁿ(B ∩ B̄_ρ(x)) ≤ Hⁿ(B ∩ B̄_{r₀}(x)) < ∞`
    filter_upwards [Ioo_mem_nhdsGT (lt_min hr₀ hr₁),
      hBA 2⁻¹ (ENNReal.inv_pos.2 ENNReal.ofNat_ne_top)] with ρ hρ he
    have hρ₀ : ρ ≤ r₀ := (hρ.2.trans_le (min_le_left _ _)).le
    have hρ₁ : ρ < r₁ := hρ.2.trans_le (min_le_right _ _)
    have hfinρ : μHE[n] (B ∩ closedBall x ρ) ≠ ∞ :=
      ne_top_of_le_ne_top hfin (measure_mono (inter_subset_inter_right B
        (closedBall_subset_closedBall hρ₀)))
    -- Step 2: subadditivity, `Hⁿ(B ∩ B̄_ρ) ≤ Hⁿ(A ∩ B̄_ρ) + Hⁿ((B ∖ A) ∩ B̄_ρ)`
    have hsub : μHE[n] (B ∩ closedBall x ρ) ≤
        μHE[n] (A ∩ closedBall x ρ) + μHE[n] ((B \ A) ∩ closedBall x ρ) := by
      refine (measure_mono ?_).trans (measure_union_le _ _)
      rintro y ⟨hyB, hyρ⟩
      by_cases hyA : y ∈ A
      · exact Or.inl ⟨hyA, hyρ⟩
      · exact Or.inr ⟨⟨hyB, hyA⟩, hyρ⟩
    -- Step 3: with `ε = 1/2`, cancelling the finite half gives `Hⁿ(B ∩ B̄_ρ)/2 ≤ Hⁿ(A ∩ B̄_ρ)`
    have hhalf : μHE[n] (B ∩ closedBall x ρ) / 2 ≤ μHE[n] (A ∩ closedBall x ρ) := by
      refine (ENNReal.add_le_add_iff_right (ENNReal.div_ne_top hfinρ two_ne_zero)).1 ?_
      rw [ENNReal.add_halves, ENNReal.div_eq_inv_mul]
      exact hsub.trans (add_le_add_right he _)
    calc μHE[n] (B ∩ closedBall x ρ)
        = μHE[n] (B ∩ closedBall x ρ) / 2 + μHE[n] (B ∩ closedBall x ρ) / 2 :=
          (ENNReal.add_halves _).symm
      _ ≤ μHE[n] (A ∩ closedBall x ρ) + μHE[n] (A ∩ closedBall x ρ) := add_le_add hhalf hhalf
      _ = 2 * μHE[n] (A ∩ closedBall x ρ) := (two_mul _).symm
      _ ≤ 2 * ENNReal.ofReal (C * ρ ^ n) := by gcongr; exact hA ρ hρ.1 hρ₁
      _ = K * ENNReal.ofReal ρ ^ n := by
          rw [ENNReal.ofReal_mul' (pow_nonneg hρ.1.le n), ENNReal.ofReal_pow hρ.1.le, hK,
            mul_assoc]
  -- Step 4: for `δ ∈ (0, ∞)`, `ε = δ/(K + 1)` gives `Hⁿ((B ∖ A) ∩ B̄_ρ) ≤ δρⁿ` eventually
  rw [ENNReal.tendsto_nhds_zero]
  intro δ hδ
  by_cases hδt : δ = ∞
  · exact Eventually.of_forall fun ρ => hδt ▸ le_top
  have hK1 : K + 1 ≠ ∞ :=
    ENNReal.add_ne_top.2 ⟨ENNReal.mul_ne_top ENNReal.ofNat_ne_top ENNReal.ofReal_ne_top,
      ENNReal.one_ne_top⟩
  have hK0 : K + 1 ≠ 0 := by positivity
  filter_upwards [hB, hBA _ (ENNReal.div_pos hδ.ne' hK1)] with ρ hρB hρe
  refine ENNReal.div_le_of_le_mul ?_
  calc μHE[n] ((B \ A) ∩ closedBall x ρ) ≤ δ / (K + 1) * μHE[n] (B ∩ closedBall x ρ) := hρe
    _ ≤ δ / (K + 1) * ((K + 1) * ENNReal.ofReal ρ ^ n) := by
        gcongr
        exact hρB.trans (by gcongr; exact le_self_add)
    _ = δ * ENNReal.ofReal ρ ^ n := by rw [← mul_assoc, ENNReal.div_mul_cancel hK0 hK1]
/-- Scaling of `Hⁿ` under the blow-up `η_{x,r}(z) = r⁻¹(z − x)`, `r > 0`:
`Hⁿ(η_{x,r}(S) ∩ B̄_R(0)) = r⁻ⁿ Hⁿ(S ∩ B̄_{rR}(x))`.  As `‖η_{x,r}(z)‖ = r⁻¹‖z − x‖`, the left side
is `Hⁿ(η_{x,r}(S ∩ B̄_{rR}(x)))`; and `η_{x,r}` is the homothety of centre `x` and ratio `r⁻¹`,
which multiplies `Hⁿ` by `‖r⁻¹‖₊ⁿ = r⁻ⁿ`, followed by the translation by `−x`, an isometry. -/
theorem Submission.rsdic_tl_blowUp_measure_scaling : ∀ (P n : ℕ) (x : Euclid P) (r R : ℝ) (S : Set (Euclid P)), 0 < r → μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' S ∩ closedBall 0 R) = (ENNReal.ofReal r)⁻¹ ^ n * μHE[n] (S ∩ closedBall x (r * R)) := by
  intro P n x r R S hr
  -- `‖η(z)‖ = r⁻¹‖z − x‖`, since `r > 0`
  have hnorm : ∀ z : Euclid P,
      ‖Poincare.SimonGMT.Chapter03.blowUpMap x r z‖ = r⁻¹ * ‖z - x‖ := by
    intro z
    rw [Poincare.SimonGMT.Chapter03.blowUpMap, norm_smul, Real.norm_eq_abs,
      abs_of_pos (inv_pos.mpr hr)]
  -- `η(S) ∩ B̄_R(0) = η(S ∩ B̄_{rR}(x))`
  have hset : Poincare.SimonGMT.Chapter03.blowUpMap x r '' S ∩ closedBall 0 R =
      Poincare.SimonGMT.Chapter03.blowUpMap x r '' (S ∩ closedBall x (r * R)) := by
    ext y
    constructor
    · rintro ⟨⟨z, hz, rfl⟩, hy⟩
      refine ⟨z, ⟨hz, ?_⟩, rfl⟩
      rw [mem_closedBall_zero_iff, hnorm] at hy
      rw [mem_closedBall, dist_eq_norm, ← mul_inv_cancel_left₀ hr.ne' ‖z - x‖]
      exact mul_le_mul_of_nonneg_left hy hr.le
    · rintro ⟨z, ⟨hz, hzx⟩, rfl⟩
      refine ⟨⟨z, hz, rfl⟩, ?_⟩
      rw [mem_closedBall, dist_eq_norm] at hzx
      rw [mem_closedBall_zero_iff, hnorm, ← inv_mul_cancel_left₀ hr.ne' R]
      exact mul_le_mul_of_nonneg_left hzx (inv_pos.mpr hr).le
  -- `η = τ ∘ h`: the homothety `h` of centre `x` and ratio `r⁻¹`, then the translation by `−x`
  have hcomp : Poincare.SimonGMT.Chapter03.blowUpMap x r =
      (fun y : Euclid P => y + -x) ∘ AffineMap.homothety x r⁻¹ := by
    funext z
    simp [Poincare.SimonGMT.Chapter03.blowUpMap, AffineMap.homothety_apply]
  -- `μ(η(T)) = μ(h(T)) = ‖r⁻¹‖₊ⁿ μ(T) = (ofReal r)⁻¹ⁿ μ(T)`
  have hscale : ∀ T : Set (Euclid P), μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' T) =
      (ENNReal.ofReal r)⁻¹ ^ n * μHE[n] T := by
    intro T
    rw [hcomp, Set.image_comp, (isometry_add_right (-x)).euclideanHausdorffMeasure_image,
      euclideanHausdorffMeasure_homothety_image n x (inv_ne_zero hr.ne') T, ENNReal.smul_def,
      smul_eq_mul, ENNReal.coe_pow, nnnorm_inv, ENNReal.coe_inv (nnnorm_ne_zero_iff.mpr hr.ne'),
      Real.nnnorm_of_nonneg hr.le, ← ENNReal.ofReal_eq_coe_nnreal hr.le]
  rw [hset, hscale]

/-- Comparison of blow-up integrals (proof of Simon 3.1.6): for Borel `A ⊆ B`, `r > 0` and a
continuous `f` with `|f| ≤ C` vanishing off `B̄_R(0)`,
`|∫_{η_{x,r}(B)} f dHⁿ − ∫_{η_{x,r}(A)} f dHⁿ| ≤ C Hⁿ(η_{x,r}(B \ A) ∩ B̄_R(0))`.  Since `η_{x,r}` is
injective, `η_{x,r}(B)` is the disjoint union of `η_{x,r}(A)` and `η_{x,r}(B \ A)`, both Borel
(`η_{x,r}(T)` is the preimage of `T` under `y ↦ x + ry`); the difference of the integrals is the
integral over `η_{x,r}(B \ A)`, which equals the integral over `η_{x,r}(B \ A) ∩ B̄_R(0)`. -/
theorem Submission.regcomp_atl_pc_blowUp_setIntegral_sub_le : ∀ (P n : ℕ) (A B : Set (Euclid P)) (x : Euclid P) (r R C : ℝ) (f : Euclid P → ℝ), Continuous f → MeasurableSet A → MeasurableSet B → A ⊆ B → 0 < r → μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' B ∩ closedBall 0 R) ≠ ∞ → (∀ y : Euclid P, ‖f y‖ ≤ C) → (∀ y : Euclid P, y ∉ closedBall (0 : Euclid P) R → f y = 0) → ‖(∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' B, f y ∂μHE[n]) - ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' A, f y ∂μHE[n]‖ ≤ C * (μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' (B \ A) ∩ closedBall 0 R)).toReal := by
  intro P n A B x r R C f hf hA hB hAB hr hfin hC hzero
  -- Step 1: `η = η_{x,r}` is injective
  have hinj : Injective (Poincare.SimonGMT.Chapter03.blowUpMap x r : Euclid P → Euclid P) := by
    intro z w h
    have h' : z - x = w - x :=
      smul_right_injective (Euclid P) (inv_ne_zero hr.ne') h
    simpa using h'
  -- Step 2: `η(T) = g⁻¹(T)` for `g y = x + r • y`, so `η` maps Borel sets to Borel sets
  have himage : ∀ T : Set (Euclid P),
      Poincare.SimonGMT.Chapter03.blowUpMap x r '' T = (fun y : Euclid P => x + r • y) ⁻¹' T := by
    intro T
    ext y
    constructor
    · rintro ⟨z, hz, rfl⟩
      simpa [Poincare.SimonGMT.Chapter03.blowUpMap, smul_smul, mul_inv_cancel₀ hr.ne'] using hz
    · intro hy
      refine ⟨x + r • y, hy, ?_⟩
      simp [Poincare.SimonGMT.Chapter03.blowUpMap, smul_smul, inv_mul_cancel₀ hr.ne']
  have hmeas : ∀ T : Set (Euclid P), MeasurableSet T →
      MeasurableSet (Poincare.SimonGMT.Chapter03.blowUpMap x r '' T) := by
    intro T hT
    rw [himage T]
    exact (by fun_prop : Continuous fun y : Euclid P => x + r • y).measurable hT
  -- Step 3: `f` is integrable on `η(T)` for Borel `T ⊆ B`
  have hint : ∀ T : Set (Euclid P), MeasurableSet T → T ⊆ B →
      IntegrableOn f (Poincare.SimonGMT.Chapter03.blowUpMap x r '' T) μHE[n] := by
    intro T hT hTB
    have hfinT : μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' T ∩ closedBall 0 R) ≠ ∞ :=
      ne_top_of_le_ne_top hfin (measure_mono (inter_subset_inter_left _ (image_mono hTB)))
    exact (Measure.integrableOn_of_bounded hfinT hf.aestronglyMeasurable
      (Eventually.of_forall hC)).of_forall_sdiff_eq_zero (hmeas T hT)
      fun y hy => hzero y fun h => hy.2 ⟨hy.1, h⟩
  -- Step 4: `∫_{η(B)} f − ∫_{η(A)} f = ∫_{η(B∖A)} f`
  have hBA : MeasurableSet (B \ A) := hB.diff hA
  have hunion : ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' B, f y ∂μHE[n] =
      (∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' A, f y ∂μHE[n]) +
        ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' (B \ A), f y ∂μHE[n] := by
    rw [← setIntegral_union ((disjoint_image_iff hinj).mpr disjoint_sdiff_right) (hmeas _ hBA)
      (hint A hA hAB) (hint _ hBA sdiff_subset), ← image_union, union_sdiff_cancel hAB]
  -- Step 5: localization to `B̄_R(0)`
  have hloc : ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' (B \ A), f y ∂μHE[n] =
      ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' (B \ A) ∩ closedBall 0 R, f y ∂μHE[n] :=
    setIntegral_eq_of_subset_of_forall_sdiff_eq_zero (hmeas _ hBA) inter_subset_left
      fun y hy => hzero y fun h => hy.2 ⟨hy.1, h⟩
  -- Step 6: the estimate
  have hfinS : μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' (B \ A) ∩ closedBall 0 R) < ∞ :=
    (measure_mono (inter_subset_inter_left _ (image_mono sdiff_subset))).trans_lt hfin.lt_top
  rw [hunion, add_sub_cancel_left, hloc, ← measureReal_def]
  exact norm_setIntegral_le_of_norm_le_const hfinS fun y _ => hC y
/-- Rescaling a vanishing `n`-density quotient (the final limit in the proof of Simon 3.1.6): if
`g(ρ)/ρⁿ → 0` as `ρ ↓ 0` and `R > 0`, then `r⁻ⁿ g(rR) → 0` as `r ↓ 0`.  The substitution
`ρ = rR` maps `𝓝[>] 0` to itself, multiplying by the finite constant `Rⁿ` keeps the limit `0`,
and `Rⁿ · g(rR)/(rR)ⁿ = r⁻ⁿ g(rR)` for `r > 0`. -/
theorem Submission.regcomp_atl_pc_density_rescale_tendsto : ∀ (n : ℕ) (g : ℝ → ℝ≥0∞) (R : ℝ), 0 < R → Tendsto (fun ρ : ℝ => g ρ / ENNReal.ofReal ρ ^ n) (𝓝[>] 0) (𝓝 0) → Tendsto (fun r : ℝ => (ENNReal.ofReal r)⁻¹ ^ n * g (r * R)) (𝓝[>] 0) (𝓝 0) := by
  intro n g R hR hg
  -- Step 1: `r ↦ r * R` maps `𝓝[>] 0` to `𝓝[>] 0`
  have hmap : Tendsto (fun r : ℝ => r * R) (𝓝[>] 0) (𝓝[>] 0) := by
    refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ ?_ ?_
    · exact ((continuous_mul_const R).tendsto' 0 0 (zero_mul R)).mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with r (hr : 0 < r)
      exact mul_pos hr hR
  -- Step 2: `g (r * R) / ofReal (r * R) ^ n → 0`
  have hcomp : Tendsto (fun r : ℝ => g (r * R) / ENNReal.ofReal (r * R) ^ n) (𝓝[>] 0) (𝓝 0) :=
    hg.comp hmap
  -- Step 3: multiplication by the finite constant `ofReal R ^ n`
  have hbtop : ENNReal.ofReal R ^ n ≠ ∞ := ENNReal.pow_ne_top ENNReal.ofReal_ne_top
  have hconst : Tendsto
      (fun r : ℝ => ENNReal.ofReal R ^ n * (g (r * R) / ENNReal.ofReal (r * R) ^ n))
      (𝓝[>] 0) (𝓝 0) := by
    have h := ENNReal.Tendsto.const_mul hcomp (Or.inr hbtop)
    rwa [mul_zero] at h
  -- Step 4: for `r > 0`, `Rⁿ · g(rR)/(rR)ⁿ = r⁻ⁿ g(rR)`
  have heq : (fun r : ℝ => ENNReal.ofReal R ^ n * (g (r * R) / ENNReal.ofReal (r * R) ^ n))
      =ᶠ[𝓝[>] 0] fun r : ℝ => (ENNReal.ofReal r)⁻¹ ^ n * g (r * R) := by
    filter_upwards [self_mem_nhdsWithin] with r (hr : 0 < r)
    have ha0 : ENNReal.ofReal r ^ n ≠ 0 := ENNReal.pow_ne_zero (ENNReal.ofReal_pos.mpr hr).ne' n
    have hatop : ENNReal.ofReal r ^ n ≠ ∞ := ENNReal.pow_ne_top ENNReal.ofReal_ne_top
    have hb0 : ENNReal.ofReal R ^ n ≠ 0 := ENNReal.pow_ne_zero (ENNReal.ofReal_pos.mpr hR).ne' n
    calc ENNReal.ofReal R ^ n * (g (r * R) / ENNReal.ofReal (r * R) ^ n)
        = ENNReal.ofReal R ^ n *
            ((ENNReal.ofReal r ^ n)⁻¹ * (ENNReal.ofReal R ^ n)⁻¹ * g (r * R)) := by
          rw [ENNReal.ofReal_mul hr.le, mul_pow, ENNReal.div_eq_inv_mul,
            ENNReal.mul_inv (Or.inl ha0) (Or.inl hatop)]
      _ = ENNReal.ofReal R ^ n * (ENNReal.ofReal R ^ n)⁻¹ *
            ((ENNReal.ofReal r ^ n)⁻¹ * g (r * R)) := by ring
      _ = (ENNReal.ofReal r)⁻¹ ^ n * g (r * R) := by
          rw [ENNReal.mul_inv_cancel hb0 hbtop, one_mul, ENNReal.inv_pow]
  -- Step 5: the two functions agree eventually along `𝓝[>] 0`
  exact hconst.congr' heq
/-- Asymptotically equal blow-up integrals give equal approximate tangent spaces (Simon Ch. 3,
Definition 1.4; last step of the proof of 3.1.6).  With `η_r = η_{x,r}`, `I(r) = ∫_{η_r(M)} f dHⁿ`,
`I'(r) = ∫_{η_r(M')} f dHⁿ` and `I(r) − I'(r) → 0` as `r ↓ 0` for every `f ∈ C_c(ℝᴾ)`:
`I' = I − (I − I')` and `I = I' + (I − I')` have the same limit `∫_Q f dHⁿ` as `I`, resp. `I'`,
while the condition `dim Q = n` does not involve `M`, `M'`. -/
theorem Submission.regcomp_atl_pc_tangent_iff_of_integral_sub_tendsto : ∀ (P n : ℕ) (M M' : Set (Euclid P)) (x : Euclid P), (∀ f : CompactlySupportedContinuousMap (Euclid P) ℝ, Tendsto (fun r : ℝ => (∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, f y ∂μHE[n]) - ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M', f y ∂μHE[n]) (𝓝[>] 0) (𝓝 0)) → ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q := by
  intro P n M M' x hD Q
  constructor
  · -- (⇒) `I' = I − (I − I') → L − 0 = L`
    rintro ⟨hQ, hM⟩
    refine ⟨hQ, fun f => ?_⟩
    have h := (hM f).sub (hD f)
    rw [sub_zero] at h
    exact h.congr fun r => sub_sub_cancel _ _
  · -- (⇐) `I = I' + (I − I') → L + 0 = L`
    rintro ⟨hQ, hM'⟩
    refine ⟨hQ, fun f => ?_⟩
    have h := (hM' f).add (hD f)
    rw [add_zero] at h
    exact h.congr fun r => add_sub_cancel _ _
/-- Scaling of `Hⁿ` under the blow-up `η_{x,r}(z) = r⁻¹(z − x)`, `r > 0` (proof of Simon 3.1.6):
`Hⁿ(η_{x,r}(S) ∩ B̄_R(0)) = r⁻ⁿ Hⁿ(S ∩ B̄_{rR}(x))`.  Since `‖η_{x,r}(z)‖ = r⁻¹‖z − x‖`, the left
side is `Hⁿ(η_{x,r}(S ∩ B̄_{rR}(x)))`; `η_{x,r}` is the homothety of centre `x` and ratio `r⁻¹`
followed by the translation by `−x`, which preserves `Hⁿ`, while the homothety multiplies it by
`‖r⁻¹‖₊ⁿ = r⁻ⁿ`. -/
theorem Submission.regcomp_atl_blowUp_measure_scaling : ∀ (P n : ℕ) (x : Euclid P) (r R : ℝ) (S : Set (Euclid P)), 0 < r → μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' S ∩ closedBall 0 R) = (ENNReal.ofReal r)⁻¹ ^ n * μHE[n] (S ∩ closedBall x (r * R)) := by
  intro P n x r R S hr
  -- `‖η(z)‖ = r⁻¹‖z − x‖`
  have hnorm : ∀ z : Euclid P,
      ‖Poincare.SimonGMT.Chapter03.blowUpMap x r z‖ = r⁻¹ * ‖z - x‖ := by
    intro z
    rw [Poincare.SimonGMT.Chapter03.blowUpMap, norm_smul, Real.norm_eq_abs,
      abs_of_pos (inv_pos.mpr hr)]
  -- Step 1: `η(S) ∩ B̄(0, R) = η(S ∩ B̄(x, rR))`
  have hset : Poincare.SimonGMT.Chapter03.blowUpMap x r '' S ∩ closedBall 0 R =
      Poincare.SimonGMT.Chapter03.blowUpMap x r '' (S ∩ closedBall x (r * R)) := by
    ext y
    constructor
    · rintro ⟨⟨z, hz, rfl⟩, hy⟩
      refine ⟨z, ⟨hz, ?_⟩, rfl⟩
      rw [mem_closedBall_zero_iff, hnorm] at hy
      rw [mem_closedBall, dist_eq_norm]
      calc ‖z - x‖ = r * (r⁻¹ * ‖z - x‖) := by field_simp
        _ ≤ r * R := mul_le_mul_of_nonneg_left hy hr.le
    · rintro ⟨z, ⟨hz, hzx⟩, rfl⟩
      refine ⟨⟨z, hz, rfl⟩, ?_⟩
      rw [mem_closedBall, dist_eq_norm] at hzx
      rw [mem_closedBall_zero_iff, hnorm]
      calc r⁻¹ * ‖z - x‖ ≤ r⁻¹ * (r * R) := mul_le_mul_of_nonneg_left hzx (inv_pos.mpr hr).le
        _ = R := by field_simp
  -- Step 2: `η = τ ∘ h` with `h = homothety x r⁻¹` and `τ y = y + (-x)`
  have hcomp : Poincare.SimonGMT.Chapter03.blowUpMap x r =
      (fun y : Euclid P => y + -x) ∘ AffineMap.homothety x r⁻¹ := by
    funext z
    simp [Poincare.SimonGMT.Chapter03.blowUpMap, AffineMap.homothety_apply]
  -- Step 3: `μ(η(T)) = (ENNReal.ofReal r)⁻¹ ^ n * μ(T)`
  have hscale : ∀ T : Set (Euclid P), μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' T) =
      (ENNReal.ofReal r)⁻¹ ^ n * μHE[n] T := by
    intro T
    rw [hcomp, Set.image_comp, (isometry_add_right (-x)).euclideanHausdorffMeasure_image,
      euclideanHausdorffMeasure_homothety_image n x (inv_ne_zero hr.ne') T, ENNReal.smul_def,
      smul_eq_mul, ENNReal.coe_pow, nnnorm_inv, ENNReal.coe_inv (nnnorm_ne_zero_iff.mpr hr.ne'),
      Real.nnnorm_of_nonneg hr.le, ← ENNReal.ofReal_eq_coe_nnreal hr.le]
  -- Step 4: conclusion
  rw [hset, hscale]

/-- **Simon Ch. 3, Remark 1.5(2)** (locality of approximate tangent spaces): if `A ⊆ B` are Borel,
`Hⁿ(B ∩ B̄_{r₀}(x)) < ∞` and `Hⁿ((B ∖ A) ∩ B̄_ρ(x)) / ρⁿ → 0` as `ρ ↓ 0`, then `B` and `A` have
the same approximate tangent spaces at `x`.  If `f ∈ C_c` vanishes off `B̄_R(0)` and `|f| ≤ M`,
then for `0 < ρ < r₀/R` the difference `∫_{η_{x,ρ}(B)} f − ∫_{η_{x,ρ}(A)} f = ∫_{η_{x,ρ}(B ∖ A)} f`
is at most `M Hⁿ(η_{x,ρ}(B ∖ A) ∩ B̄_R(0)) = M ρ⁻ⁿ Hⁿ((B ∖ A) ∩ B̄_{ρR}(x))` in absolute value,
and this tends to `0`. -/
theorem Submission.rsdic_tl_tangent_iff_of_density_zero : ∀ (P n : ℕ) (A B : Set (Euclid P)) (x : Euclid P) (r₀ : ℝ), MeasurableSet A → MeasurableSet B → A ⊆ B → 0 < r₀ → μHE[n] (B ∩ closedBall x r₀) ≠ ∞ → Tendsto (fun ρ : ℝ => μHE[n] ((B \ A) ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n) (𝓝[>] 0) (𝓝 0) → ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q := by
  intro P n A B x r₀ hA hB hAB hr₀ hfin hdens Q
  -- Step 1: for `ρ ≠ 0`, `η_{x,ρ}` is injective and `η_{x,ρ}(S) = (y ↦ x + ρy)⁻¹(S)`
  have hinj : ∀ ρ : ℝ, ρ ≠ 0 → Injective (Poincare.SimonGMT.Chapter03.blowUpMap x ρ) := by
    intro ρ hρ a b hab
    exact sub_left_injective (smul_right_injective (Euclid P) (inv_ne_zero hρ) hab)
  have hmeas : ∀ ρ : ℝ, ρ ≠ 0 → ∀ S : Set (Euclid P), MeasurableSet S →
      MeasurableSet (Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' S) := by
    intro ρ hρ S hS
    have himage : Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' S =
        (fun y => x + ρ • y) ⁻¹' S := by
      ext y
      constructor
      · rintro ⟨z, hz, rfl⟩
        simpa [Poincare.SimonGMT.Chapter03.blowUpMap, smul_inv_smul₀ hρ] using hz
      · intro hy
        exact ⟨x + ρ • y, hy, by simp [Poincare.SimonGMT.Chapter03.blowUpMap, inv_smul_smul₀ hρ]⟩
    rw [himage]
    exact hS.preimage (by fun_prop)
  -- Steps 2–7: for every `f ∈ C_c`, `∫_{η_{x,ρ}(B)} f − ∫_{η_{x,ρ}(A)} f → 0`
  have key : ∀ f : CompactlySupportedContinuousMap (Euclid P) ℝ,
      Tendsto (fun ρ : ℝ =>
        (∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' B, f y ∂μHE[n]) -
          ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' A, f y ∂μHE[n]) (𝓝[>] 0) (𝓝 0) := by
    intro f
    -- Step 2: `f` vanishes off `B̄_R(0)` for some `R > 0`, and `|f| ≤ M`
    obtain ⟨R, hRpos, hout⟩ : ∃ R : ℝ, 0 < R ∧
        ∀ y : Euclid P, y ∉ closedBall (0 : Euclid P) R → f y = 0 := by
      obtain ⟨R₀, hR₀⟩ := f.hasCompactSupport.isCompact.isBounded.subset_closedBall 0
      exact ⟨max R₀ 1, lt_of_lt_of_le one_pos (le_max_right _ _), fun y hy =>
        image_eq_zero_of_notMem_tsupport fun hy' =>
          hy (closedBall_subset_closedBall (le_max_left _ _) (hR₀ hy'))⟩
    obtain ⟨M, hM⟩ := f.continuous.bounded_above_of_compact_support f.hasCompactSupport
    -- Step 3: `f` is integrable on `S` whenever `Hⁿ(S ∩ B̄_R(0)) < ∞`
    have hint : ∀ S : Set (Euclid P), μHE[n] (S ∩ closedBall 0 R) ≠ ∞ →
        IntegrableOn (fun y => f y) S μHE[n] := by
      intro S hS
      refine Integrable.mono' (g := (closedBall (0 : Euclid P) R).indicator fun _ => M) ?_
        f.continuous.aestronglyMeasurable (ae_of_all _ fun y => ?_)
      · rw [integrable_indicator_iff measurableSet_closedBall]
        refine integrableOn_const ?_
        rw [Measure.restrict_apply measurableSet_closedBall, Set.inter_comm]
        exact hS
      · by_cases hy : y ∈ closedBall (0 : Euclid P) R
        · rw [Set.indicator_of_mem hy]
          exact hM y
        · rw [Set.indicator_of_notMem hy, hout y hy, norm_zero]
    -- Steps 4–6 give `|∫_{η_{x,ρ}(B)} f − ∫_{η_{x,ρ}(A)} f| ≤ M Hⁿ(η_{x,ρ}(B ∖ A) ∩ B̄_R(0))` for
    -- `0 < ρ < r₀/R`; step 7 sends the bound to `0`
    refine squeeze_zero_norm' (a := fun ρ : ℝ => M *
      (μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' (B \ A) ∩ closedBall 0 R)).toReal)
      ?_ ?_
    · filter_upwards [Ioo_mem_nhdsGT (div_pos hr₀ hRpos)] with ρ hρ
      have hρ0 : 0 < ρ := hρ.1
      have hρR : ρ * R < r₀ := (lt_div_iff₀ hRpos).1 hρ.2
      -- Step 4: for `S ⊆ B`, `Hⁿ(η_{x,ρ}(S) ∩ B̄_R(0)) = ρ⁻ⁿ Hⁿ(S ∩ B̄_{ρR}(x)) < ∞`
      have hfinS : ∀ S ⊆ B,
          μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' S ∩ closedBall 0 R) ≠ ∞ := by
        intro S hS
        rw [Submission.rsdic_tl_blowUp_measure_scaling P n x ρ R S hρ0]
        exact ENNReal.mul_ne_top
          (ENNReal.pow_ne_top (ENNReal.inv_ne_top.2 (ENNReal.ofReal_pos.2 hρ0).ne'))
          (ne_top_of_le_ne_top hfin
            (measure_mono (inter_subset_inter hS (closedBall_subset_closedBall hρR.le))))
      -- Step 5: `∫_{η_{x,ρ}(B)} f − ∫_{η_{x,ρ}(A)} f = ∫_{η_{x,ρ}(B ∖ A)} f`
      have hsplit : (∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' B, f y ∂μHE[n]) -
          ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' A, f y ∂μHE[n] =
          ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' (B \ A), f y ∂μHE[n] := by
        rw [image_sdiff (hinj ρ hρ0.ne'), setIntegral_sdiff (hmeas ρ hρ0.ne' A hA)
          (hint _ (hfinS B subset_rfl)) (image_mono hAB)]
      -- Step 6: `f = 0` off `B̄_R(0)` and `|f| ≤ M`
      have hball : ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' (B \ A), f y ∂μHE[n] =
          ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' (B \ A) ∩ closedBall 0 R,
            f y ∂μHE[n] :=
        setIntegral_eq_of_subset_of_forall_sdiff_eq_zero (hmeas ρ hρ0.ne' _ (hB.diff hA))
          inter_subset_left fun y hy => hout y fun h => hy.2 ⟨hy.1, h⟩
      rw [hsplit, hball]
      exact norm_setIntegral_le_of_norm_le_const (lt_top_iff_ne_top.2 (hfinS _ sdiff_subset))
        fun y _ => hM y
    -- Step 7: `Hⁿ(η_{x,ρ}(B ∖ A) ∩ B̄_R(0)) = Rⁿ Hⁿ((B ∖ A) ∩ B̄_{ρR}(x)) / (ρR)ⁿ → 0`, by (†)
    -- along `ρ ↦ ρR`
    have hlin : Tendsto (fun ρ : ℝ => ρ * R) (𝓝[>] 0) (𝓝[>] 0) := by
      refine tendsto_nhdsWithin_iff.2 ⟨?_, ?_⟩
      · exact ((continuous_mul_const R).tendsto' 0 0 (zero_mul R)).mono_left nhdsWithin_le_nhds
      · filter_upwards [self_mem_nhdsWithin] with ρ (hρ : 0 < ρ)
        exact mul_pos hρ hRpos
    have hsmall : Tendsto (fun ρ : ℝ =>
        μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' (B \ A) ∩ closedBall 0 R))
        (𝓝[>] 0) (𝓝 0) := by
      have h := ENNReal.Tendsto.const_mul (hdens.comp hlin)
        (Or.inr (ENNReal.pow_ne_top ENNReal.ofReal_ne_top) :
          (0 : ℝ≥0∞) ≠ 0 ∨ ENNReal.ofReal R ^ n ≠ ∞)
      rw [mul_zero] at h
      refine h.congr' ?_
      filter_upwards [self_mem_nhdsWithin] with ρ (hρ : 0 < ρ)
      have hβ : ENNReal.ofReal R ^ n * (ENNReal.ofReal R ^ n)⁻¹ = 1 :=
        ENNReal.mul_inv_cancel (pow_ne_zero n (ENNReal.ofReal_pos.2 hRpos).ne')
          (ENNReal.pow_ne_top ENNReal.ofReal_ne_top)
      simp only [Function.comp_apply]
      rw [Submission.rsdic_tl_blowUp_measure_scaling P n x ρ R (B \ A) hρ,
        ENNReal.ofReal_mul hρ.le, mul_pow, ← ENNReal.inv_pow, div_eq_mul_inv,
        ENNReal.mul_inv (Or.inl (pow_ne_zero n (ENNReal.ofReal_pos.2 hρ).ne'))
          (Or.inl (ENNReal.pow_ne_top ENNReal.ofReal_ne_top))]
      calc ENNReal.ofReal R ^ n * (μHE[n] ((B \ A) ∩ closedBall x (ρ * R)) *
            ((ENNReal.ofReal ρ ^ n)⁻¹ * (ENNReal.ofReal R ^ n)⁻¹))
          = ENNReal.ofReal R ^ n * (ENNReal.ofReal R ^ n)⁻¹ *
            ((ENNReal.ofReal ρ ^ n)⁻¹ * μHE[n] ((B \ A) ∩ closedBall x (ρ * R))) := by ring
        _ = (ENNReal.ofReal ρ ^ n)⁻¹ * μHE[n] ((B \ A) ∩ closedBall x (ρ * R)) := by
          rw [hβ, one_mul]
    have h := ((ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp hsmall).const_mul M
    rwa [ENNReal.toReal_zero, mul_zero] at h
  -- Step 8: transfer the limits of Definition 1.4 in both directions
  constructor
  · rintro ⟨hdim, hconv⟩
    refine ⟨hdim, fun f => ?_⟩
    have h := (hconv f).sub (key f)
    rw [sub_zero] at h
    exact h.congr fun ρ => sub_sub_cancel _ _
  · rintro ⟨hdim, hconv⟩
    refine ⟨hdim, fun f => ?_⟩
    have h := (hconv f).add (key f)
    rw [add_zero] at h
    exact h.congr fun ρ => add_sub_cancel _ _
/-- **Simon Ch. 3, Remark 1.5(3)**: if `D` has an approximate tangent space at `x` and
`Hⁿ(D ∩ B̄_{r₀}(x)) < ∞`, then `Hⁿ(D ∩ B̄_ρ(x)) ≤ Cρⁿ` for all small `ρ > 0`.  Test the tangent
condition with `f = max(0, min(1, 2 − |y|)) ∈ C_c`: for `ρ ≤ r₀/2`, `f` is integrable on
`η_{x,ρ}(D)` (as `Hⁿ(η_{x,ρ}(D) ∩ B̄₂(0)) ≤ ρ⁻ⁿHⁿ(D ∩ B̄_{r₀}(x)) < ∞`), and
`ρ⁻ⁿHⁿ(D ∩ B̄_ρ(x)) ≤ Hⁿ(η_{x,ρ}(D) ∩ B̄₁(0)) ≤ ∫_{η_{x,ρ}(D)} f dHⁿ → ∫_Q f dHⁿ =: L`, so
`C = L + 1` works. -/
theorem Submission.rsdic_measure_closedBall_le_of_tangent : ∀ (P n : ℕ) (D : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)) (r₀ : ℝ), MeasurableSet D → 0 < r₀ → μHE[n] (D ∩ closedBall x r₀) ≠ ∞ → HasApproximateTangentSpaceAt n D x Q → ∃ C r₁ : ℝ, 0 < r₁ ∧ ∀ ρ : ℝ, 0 < ρ → ρ < r₁ → μHE[n] (D ∩ closedBall x ρ) ≤ ENNReal.ofReal (C * ρ ^ n) := by
  intro P n D x Q r₀ _ hr₀ hfin hT
  -- Step 1 (scaling): `Hⁿ(a + c • W) = |c|ⁿ Hⁿ(W)`, by translation invariance and homogeneity
  have hscale : ∀ (a : Euclid P) (c : ℝ), c ≠ 0 → ∀ W : Set (Euclid P),
      μHE[n] ((fun t => a + c • t) '' W) = ‖c‖₊ ^ n • μHE[n] W := by
    intro a c hc W
    have himg : (fun t => a + t) '' ((fun t => c • t) '' W) = (fun t => a + c • t) '' W :=
      Set.image_image _ _ _
    have hsm := Measure.euclideanHausdorffMeasure_smul₀ (E := Euclid P) n hc W
    rw [← Set.image_smul] at hsm
    rw [← himg, (isometry_add_left a).euclideanHausdorffMeasure_image, hsm]
  -- Step 2: the test function `f = max(0, min(1, 2 − |y|)) ∈ C_c`, `1_{B̄₁(0)} ≤ f ≤ 1_{B̄₂(0)}`
  have hout : ∀ y : Euclid P, y ∉ closedBall (0 : Euclid P) 2 → max 0 (min 1 (2 - ‖y‖)) = 0 := by
    intro y hy
    rw [mem_closedBall_zero_iff, not_le] at hy
    exact max_eq_left ((min_le_right _ _).trans (by linarith))
  let f : CompactlySupportedContinuousMap (Euclid P) ℝ :=
    ⟨⟨fun y => max 0 (min 1 (2 - ‖y‖)), by fun_prop⟩,
      HasCompactSupport.intro (isCompact_closedBall 0 2) hout⟩
  have hf0 : ∀ y, 0 ≤ f y := fun y => le_max_left _ _
  have hf1 : ∀ y, f y ≤ 1 := fun y => max_le zero_le_one (min_le_left _ _)
  have hfB : ∀ y ∈ closedBall (0 : Euclid P) 1, f y = 1 := by
    intro y hy
    rw [mem_closedBall_zero_iff] at hy
    show max 0 (min 1 (2 - ‖y‖)) = 1
    rw [min_eq_left (by linarith), max_eq_right zero_le_one]
  -- Step 5: choose `r₁` with `∫_{η_{x,ρ}(D)} f dHⁿ < L + 1` and `ρ < r₀/2` for `0 < ρ < r₁`
  set L := ∫ y in (Q : Set (Euclid P)), f y ∂μHE[n]
  have hev : ∀ᶠ ρ in 𝓝[>] (0 : ℝ),
      (∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' D, f y ∂μHE[n]) < L + 1 ∧
        ρ < r₀ / 2 :=
    ((hT.2 f).eventually_lt_const (lt_add_one L)).and
      (Filter.mem_of_superset (Ioo_mem_nhdsGT (half_pos hr₀)) fun ρ hρ => hρ.2)
  obtain ⟨r₁, hr₁, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1 hev
  refine ⟨L + 1, r₁, hr₁, fun ρ hρ hρr₁ => ?_⟩
  obtain ⟨hg, hρr₀⟩ := hsub ⟨hρ, hρr₁⟩
  set T := Poincare.SimonGMT.Chapter03.blowUpMap x ρ '' D
  have hnorm : ∀ d : Euclid P, ‖d - x‖ = ρ * ‖ρ⁻¹ • (d - x)‖ := by
    intro d
    rw [norm_smul, norm_inv, Real.norm_of_nonneg hρ.le, mul_inv_cancel_left₀ hρ.ne']
  -- Step 3: `Hⁿ(η_{x,ρ}(D) ∩ B̄₂(0)) ≤ ρ⁻ⁿ Hⁿ(D ∩ B̄_{r₀}(x)) < ∞`, so `f` is integrable on
  -- `η_{x,ρ}(D)`
  have hTfin : μHE[n] (T ∩ closedBall 0 2) ≠ ∞ := by
    have hsubset : T ∩ closedBall 0 2 ⊆
        (fun t => -(ρ⁻¹ • x) + ρ⁻¹ • t) '' (D ∩ closedBall x r₀) := by
      rintro _ ⟨⟨d, hd, rfl⟩, hd2⟩
      refine ⟨d, ⟨hd, ?_⟩, ?_⟩
      · rw [mem_closedBall_zero_iff] at hd2
        rw [mem_closedBall, dist_eq_norm, hnorm d]
        have : ρ * ‖ρ⁻¹ • (d - x)‖ ≤ ρ * 2 := mul_le_mul_of_nonneg_left hd2 hρ.le
        linarith
      · simp only [Poincare.SimonGMT.Chapter03.blowUpMap, smul_sub]
        abel
    refine ne_top_of_le_ne_top ?_ (measure_mono hsubset)
    rw [hscale _ _ (inv_ne_zero hρ.ne'), ENNReal.smul_def, smul_eq_mul]
    exact ENNReal.mul_ne_top ENNReal.coe_ne_top hfin
  have hint : Integrable (fun y => f y) (μHE[n].restrict T) := by
    refine Integrable.mono' (g := (closedBall (0 : Euclid P) 2).indicator fun _ => (1 : ℝ)) ?_
      f.continuous.aestronglyMeasurable (ae_of_all _ fun y => ?_)
    · rw [integrable_indicator_iff measurableSet_closedBall]
      refine integrableOn_const ?_
      rw [Measure.restrict_apply measurableSet_closedBall, Set.inter_comm]
      exact hTfin
    · by_cases hy : y ∈ closedBall (0 : Euclid P) 2
      · rw [Set.indicator_of_mem hy, Real.norm_of_nonneg (hf0 y)]
        exact hf1 y
      · rw [Set.indicator_of_notMem hy, norm_le_zero_iff]
        exact hout y hy
  -- Step 4: `D ∩ B̄_ρ(x) ⊆ x + ρ • (η_{x,ρ}(D) ∩ B̄₁(0))` and
  -- `Hⁿ(η_{x,ρ}(D) ∩ B̄₁(0)) ≤ ∫_{η_{x,ρ}(D)} f dHⁿ < L + 1`
  have hsub1 : D ∩ closedBall x ρ ⊆ (fun t => x + ρ • t) '' (T ∩ closedBall 0 1) := by
    rintro d ⟨hd, hdx⟩
    refine ⟨ρ⁻¹ • (d - x), ⟨⟨d, hd, rfl⟩, ?_⟩, ?_⟩
    · rw [mem_closedBall, dist_eq_norm, hnorm d] at hdx
      rw [mem_closedBall_zero_iff]
      by_contra hlt
      rw [not_le] at hlt
      have : ρ * 1 < ρ * ‖ρ⁻¹ • (d - x)‖ := mul_lt_mul_of_pos_left hlt hρ
      linarith
    · simp only [smul_smul, mul_inv_cancel₀ hρ.ne', one_smul, add_sub_cancel]
  have hball : μHE[n] (T ∩ closedBall 0 1) ≤ ENNReal.ofReal (L + 1) :=
    calc μHE[n] (T ∩ closedBall 0 1)
        = ∫⁻ y, (closedBall (0 : Euclid P) 1).indicator 1 y ∂(μHE[n].restrict T) := by
          rw [lintegral_indicator_one measurableSet_closedBall,
            Measure.restrict_apply measurableSet_closedBall, Set.inter_comm]
      _ ≤ ∫⁻ y, ENNReal.ofReal (f y) ∂(μHE[n].restrict T) := by
          refine lintegral_mono fun y => ?_
          by_cases hy : y ∈ closedBall (0 : Euclid P) 1
          · rw [Set.indicator_of_mem hy, hfB y hy, Pi.one_apply, ENNReal.ofReal_one]
          · rw [Set.indicator_of_notMem hy]
            exact zero_le
      _ = ENNReal.ofReal (∫ y, f y ∂(μHE[n].restrict T)) :=
          (ofReal_integral_eq_lintegral_ofReal hint (ae_of_all _ hf0)).symm
      _ ≤ ENNReal.ofReal (L + 1) := ENNReal.ofReal_le_ofReal hg.le
  -- Step 6: `Hⁿ(D ∩ B̄_ρ(x)) ≤ ρⁿ Hⁿ(η_{x,ρ}(D) ∩ B̄₁(0)) ≤ (L + 1)ρⁿ`
  calc μHE[n] (D ∩ closedBall x ρ)
      ≤ μHE[n] ((fun t => x + ρ • t) '' (T ∩ closedBall 0 1)) := measure_mono hsub1
    _ = ‖ρ‖₊ ^ n • μHE[n] (T ∩ closedBall 0 1) := hscale _ _ hρ.ne' _
    _ ≤ ‖ρ‖₊ ^ n • ENNReal.ofReal (L + 1) := by
        rw [ENNReal.smul_def, ENNReal.smul_def, smul_eq_mul, smul_eq_mul]
        exact mul_le_mul_of_nonneg_left hball zero_le
    _ = ENNReal.ofReal ((L + 1) * ρ ^ n) := by
        rw [ENNReal.ofReal_mul' (pow_nonneg hρ.le n), ENNReal.ofReal_pow hρ.le, ENNReal.smul_def,
          smul_eq_mul, mul_comm, ENNReal.coe_pow, ← enorm_eq_nnnorm, Real.enorm_eq_ofReal hρ.le]

/-- **Simon Ch. 3, Remarks 1.5(2) and 1.8(1)**: if `A ⊆ B ⊆ U` are Borel and `Hⁿ(B ∩ K) < ∞` for
compact `K ⊆ U`, then for `Hⁿ`-a.e. `x ∈ A`, `B` and `A` have the same approximate tangent spaces
at `x`.  Off a `Hⁿ⌞A`-null set independent of `Q`, `Hⁿ((B ∖ A) ∩ B̄_ρ(x)) ≤ ε Hⁿ(B ∩ B̄_ρ(x))` for
small `ρ` (Besicovitch).  A tangent plane of `B` or of `A` at `x` gives
`Hⁿ(A ∩ B̄_ρ(x)) ≤ Cρⁿ` (Remark 1.5(3), using `A ⊆ B` in the first case), hence
`Hⁿ((B ∖ A) ∩ B̄_ρ(x)) = o(ρⁿ)`, and then the blow-up integrals of `B` and `A` have the same
limits. -/
theorem Submission.rsdic_ae_tangent_iff_of_subset : ∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q := by
  intro P n U A B hU hA hB hAB hBU hfin
  -- Steps 1–4: for `Hⁿ⌞A`-a.e. `x`, `x ∈ A` and the excess of `B` over `A` near `x` is eventually
  -- small relative to `Hⁿ(B ∩ B̄_ρ(x))`; the exceptional set does not depend on `Q`
  filter_upwards [Submission.rsdic_tl_ae_excess_le P n U A B hU hA hB hAB hBU hfin,
    ae_restrict_mem hA] with x hexc hxA Q
  -- a compact ball `B̄_{s/2}(x) ⊆ B_s(x) ⊆ U`, so `Hⁿ(B ∩ B̄_{s/2}(x)) < ∞`
  obtain ⟨s, hs, hsU⟩ := Metric.isOpen_iff.1 hU x (hBU (hAB hxA))
  have hr₀ : 0 < s / 2 := half_pos hs
  have hBfin : μHE[n] (B ∩ closedBall x (s / 2)) ≠ ∞ :=
    hfin _ (isCompact_closedBall x (s / 2)) ((closedBall_subset_ball (half_lt_self hs)).trans hsU)
  have hAB' : ∀ ρ : ℝ, μHE[n] (A ∩ closedBall x ρ) ≤ μHE[n] (B ∩ closedBall x ρ) :=
    fun ρ => measure_mono (inter_subset_inter_left _ hAB)
  -- Steps 5–7: a growth bound `Hⁿ(A ∩ B̄_ρ(x)) ≤ Cρⁿ` gives `Hⁿ((B ∖ A) ∩ B̄_ρ(x)) = o(ρⁿ)`, which
  -- forces equal approximate tangent spaces
  have key : ∀ C r₁ : ℝ, 0 < r₁ →
      (∀ ρ : ℝ, 0 < ρ → ρ < r₁ → μHE[n] (A ∩ closedBall x ρ) ≤ ENNReal.ofReal (C * ρ ^ n)) →
      (HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q) :=
    fun C r₁ hr₁ hgrowth =>
      Submission.rsdic_tl_tangent_iff_of_density_zero P n A B x (s / 2) hA hB hAB hr₀ hBfin
        (Submission.rsdic_tl_excess_density_zero P n A B x (s / 2) C r₁ hr₀ hBfin hr₁ hgrowth hexc)
        Q
  constructor
  · -- the growth bound for `B` passes to `A ⊆ B`
    intro hTB
    obtain ⟨C, r₁, hr₁, hgrowth⟩ :=
      Submission.rsdic_measure_closedBall_le_of_tangent P n B x Q (s / 2) hB hr₀ hBfin hTB
    exact (key C r₁ hr₁ fun ρ hρ hρr₁ => (hAB' ρ).trans (hgrowth ρ hρ hρr₁)).1 hTB
  · intro hTA
    obtain ⟨C, r₁, hr₁, hgrowth⟩ :=
      Submission.rsdic_measure_closedBall_le_of_tangent P n A x Q (s / 2) hA hr₀
        (ne_top_of_le_ne_top hBfin (hAB' (s / 2))) hTA
    exact (key C r₁ hr₁ hgrowth).2 hTA
/-- **The cylinder over a rectifiable set** (the carrier of `[[(0,1)]] × T`, Simon Ch. 6, 2.17–2.21
and the proof of 2.27): let `M ⊆ ℝᴾ` be Borel and countably `k`-rectifiable with `Hᵏ(M) < ∞`, and
let `ι(t, x) = (t, x₁, …, x_P)`.  There is a Borel `C ⊆ ι((0,1) × M)` which is countably
`(k+1)`-rectifiable, satisfies `Hᵏ⁺¹⌞C = ι_#(L¹⌞(0,1) ⊗ Hᵏ⌞M)`, and for `Hᵏ⁺¹`-a.e. `y ∈ C`, if `M`
has approximate tangent space `Q` at `(y₁, …, y_P)` then `C` has approximate tangent space
`ℝe₀ ⊕ Q` at `y`.  Cut `M` into bi-Lipschitz pieces `F i (B i)` up to an `Hᵏ`-null set and take
`C = ι((0,1) × ⋃ F i (B i))`, parametrized by `G i(b) = ι(b₀, F i(b₁, …, b_k))` on
`π⁻¹((0,1) × B i)`, `π(b) = (b₀, (b₁, …, b_k))`.  The Gram matrix of `DG i(b)` is
`diag(1, Gram DF i)`, so `JG i = JF i ∘ π₂`; the area formula for `G i` and for `F i`, the measure
preserving `π` and Tonelli give the measure identity.  The tangent planes come from the piece lemma
for `F i` on `M` and for `G i` on `C`, with `range DG i(b) = ℝe₀ ⊕ range DF i(π₂ b)`. -/
theorem Submission.dor_lmb_fcdp_cylinder : ∀ (P k : ℕ) (M : Set (Euclid P)), MeasurableSet M → CountablyRectifiable k M → μHE[k] M ≠ ∞ → ∃ C : Set (Euclid (P + 1)), MeasurableSet C ∧ C ⊆ (fun p : ℝ × Euclid P => (WithLp.toLp 2 (Fin.cons p.1 (WithLp.ofLp p.2) : Fin (P + 1) → ℝ) : Euclid (P + 1))) '' (Ioo (0 : ℝ) 1 ×ˢ M) ∧ CountablyRectifiable (k + 1) C ∧ μHE[k + 1].restrict C = ((volume.restrict (Ioo (0 : ℝ) 1)).prod (μHE[k].restrict M)).map (fun p : ℝ × Euclid P => (WithLp.toLp 2 (Fin.cons p.1 (WithLp.ofLp p.2) : Fin (P + 1) → ℝ) : Euclid (P + 1))) ∧ ∀ᵐ y ∂(μHE[k + 1].restrict C), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt k M (WithLp.toLp 2 (Fin.tail (WithLp.ofLp y)) : Euclid P) Q → HasApproximateTangentSpaceAt (k + 1) C y (Submodule.span ℝ (insert (EuclideanSpace.single (0 : Fin (P + 1)) (1 : ℝ)) ((fun v : Euclid P => (WithLp.toLp 2 (Fin.cons (0 : ℝ) (WithLp.ofLp v) : Fin (P + 1) → ℝ) : Euclid (P + 1))) '' (Q : Set (Euclid P))))) := by
  intro P k M hM hrect hfin
  -- `ι_n(t, x) = (t, x₁, …, x_n)` and `π_n(y) = (y₀, (y₁, …, y_n))`, mutually inverse linear maps
  have hι : ∀ n : ℕ, ∃ L : ℝ × Euclid n →L[ℝ] Euclid (n + 1), ∀ p, L p =
      (WithLp.toLp 2 (Fin.cons p.1 (WithLp.ofLp p.2) : Fin (n + 1) → ℝ) : Euclid (n + 1)) := by
    intro n
    refine ⟨LinearMap.toContinuousLinearMap
      { toFun := fun p =>
          (WithLp.toLp 2 (Fin.cons p.1 (WithLp.ofLp p.2) : Fin (n + 1) → ℝ) : Euclid (n + 1))
        map_add' := ?_
        map_smul' := ?_ }, fun p => rfl⟩
    · intro p q
      ext i
      refine Fin.cases ?_ (fun j => ?_) i <;> simp
    · intro c p
      ext i
      refine Fin.cases ?_ (fun j => ?_) i <;> simp
  have hπ : ∀ n : ℕ, ∃ L : Euclid (n + 1) →L[ℝ] ℝ × Euclid n, ∀ y,
      L y = (WithLp.ofLp y 0, (WithLp.toLp 2 (Fin.tail (WithLp.ofLp y)) : Euclid n)) := by
    intro n
    refine ⟨LinearMap.toContinuousLinearMap
      { toFun := fun y => (WithLp.ofLp y 0, (WithLp.toLp 2 (Fin.tail (WithLp.ofLp y)) : Euclid n))
        map_add' := ?_
        map_smul' := ?_ }, fun p => rfl⟩
    · intro p q
      ext <;> simp [Fin.tail]
    · intro c p
      ext <;> simp [Fin.tail]
  choose ιL hιL using hι
  choose πL hπL using hπ
  have hπι : ∀ n p, πL n (ιL n p) = p := by
    intro n p
    rw [hιL, hπL]
    simp
  have hιπ : ∀ n y, ιL n (πL n y) = y := by
    intro n y
    rw [hπL, hιL]
    simp
  have hinner : ∀ n p q, inner ℝ (ιL n p) (ιL n q) = p.1 * q.1 + inner ℝ p.2 q.2 := by
    intro n p q
    rw [hιL, hιL, PiLp.inner_apply, PiLp.inner_apply, Fin.sum_univ_succ]
    simp [mul_comm]
  have hnorm : ∀ n p, ‖ιL n p‖ ^ 2 = p.1 ^ 2 + ‖p.2‖ ^ 2 := by
    intro n p
    rw [← real_inner_self_eq_norm_sq, ← real_inner_self_eq_norm_sq, hinner, sq]
  have hιinj : ∀ n, Injective (ιL n) := fun n => LeftInverse.injective (hπι n)
  -- A1: `π_n` maps Lebesgue measure on `ℝⁿ⁺¹` to Lebesgue measure on `ℝ × ℝⁿ`
  have hπmp : ∀ n, MeasurePreserving (πL n) volume volume := by
    intro n
    have h := ((MeasurePreserving.id (volume : Measure ℝ)).prod
      (PiLp.volume_preserving_toLp (Fin n))).comp
      ((volume_preserving_piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) 0).comp
        (PiLp.volume_preserving_ofLp (Fin (n + 1))))
    convert h using 1
    funext y
    rw [hπL]
    simp [MeasurableEquiv.piFinSuccAbove_apply]
  have hπe0 : ∀ n, πL n (EuclideanSpace.single 0 1) = (1, 0) := by
    intro n
    rw [hπL]
    ext
    · simp
    · simp [Fin.tail]
  have hπes : ∀ n (j : Fin n),
      πL n (EuclideanSpace.single j.succ 1) = (0, EuclideanSpace.single j 1) := by
    intro n j
    rw [hπL]
    ext l
    · simp
    · simp [Fin.tail, PiLp.single_apply]
  -- the statement's `ι`, `J`, `ê₀` and `pr` in terms of `ι_P` and `π_P`
  have hιfun : (fun p : ℝ × Euclid P =>
      (WithLp.toLp 2 (Fin.cons p.1 (WithLp.ofLp p.2) : Fin (P + 1) → ℝ) : Euclid (P + 1))) =
      ιL P := funext fun p => (hιL P p).symm
  have hJfun : (fun v : Euclid P =>
      (WithLp.toLp 2 (Fin.cons (0 : ℝ) (WithLp.ofLp v) : Fin (P + 1) → ℝ) : Euclid (P + 1))) =
      fun v => ιL P (0, v) := funext fun v => (hιL P (0, v)).symm
  have he0 : (EuclideanSpace.single (0 : Fin (P + 1)) (1 : ℝ)) = ιL P (1, 0) := by
    rw [← hπe0, hιπ]
  have hpr : ∀ y : Euclid (P + 1),
      (WithLp.toLp 2 (Fin.tail (WithLp.ofLp y)) : Euclid P) = (πL P y).2 := fun y => by rw [hπL]
  rw [hιfun, hJfun, he0]
  simp only [hpr]
  -- B1: the bi-Lipschitz pieces `F i (B i)` of `M` (accepted `dpf_rectifiable_bilipschitz_pieces`)
  obtain ⟨F, B, m, hFL, hB, hm, hbi, hdiff, hFBm, hFBM, hdisj, hnull⟩ :=
    Submission.dpf_rectifiable_bilipschitz_pieces P k M hM hrect
  choose L hL using hFL
  have hFinj : ∀ i, InjOn (F i) (B i) := by
    intro i a ha a' ha' h
    have h1 := hbi i a ha a' ha'
    rw [h, sub_self, norm_zero] at h1
    have h2 : ‖a - a'‖ ≤ 0 := by nlinarith [norm_nonneg (a - a'), hm i]
    exact sub_eq_zero.mp (norm_le_zero_iff.mp h2)
  -- `A i = F i (B i)`, `C i = ι((0,1) × A i)`, `G i = ι ∘ (id × F i) ∘ π` on
  -- `Bh i = π⁻¹((0,1) × B i)`
  set A : ℕ → Set (Euclid P) := fun i => F i '' B i
  set C : ℕ → Set (Euclid (P + 1)) := fun i => ιL P '' (Ioo (0 : ℝ) 1 ×ˢ A i)
  set G : ℕ → Euclid (k + 1) → Euclid (P + 1) := fun i b => ιL P ((πL k b).1, F i (πL k b).2)
  set Bh : ℕ → Set (Euclid (k + 1)) := fun i => πL k ⁻¹' (Ioo (0 : ℝ) 1 ×ˢ B i)
  have hmeas_img : ∀ T : Set (ℝ × Euclid P), MeasurableSet T → MeasurableSet (ιL P '' T) :=
    fun T hT => hT.image_of_continuousOn_injOn (ιL P).continuous.continuousOn (hιinj P).injOn
  have hCm : ∀ i, MeasurableSet (C i) := fun i => hmeas_img _ (measurableSet_Ioo.prod (hFBm i))
  have hCU : ιL P '' (Ioo (0 : ℝ) 1 ×ˢ ⋃ i, A i) = ⋃ i, C i := by
    rw [prod_iUnion, image_iUnion]
  have hCdisj : Pairwise (Disjoint on C) := fun i j hij =>
    (disjoint_image_iff (hιinj P)).mpr (disjoint_prod.mpr (Or.inr (hdisj hij)))
  have hBhm : ∀ i, MeasurableSet (Bh i) := fun i =>
    (measurableSet_Ioo.prod (hB i)).preimage (πL k).continuous.measurable
  have hGC : ∀ i, G i '' Bh i = C i := by
    intro i
    ext y
    constructor
    · rintro ⟨b, hb, rfl⟩
      exact ⟨((πL k b).1, F i (πL k b).2), ⟨hb.1, mem_image_of_mem _ hb.2⟩, rfl⟩
    · rintro ⟨⟨t, x⟩, ⟨ht, u, hu, rfl⟩, rfl⟩
      refine ⟨ιL k (t, u), ?_, ?_⟩
      · show πL k (ιL k (t, u)) ∈ Ioo (0 : ℝ) 1 ×ˢ B i
        rw [hπι]
        exact ⟨ht, hu⟩
      · show ιL P ((πL k (ιL k (t, u))).1, F i (πL k (ιL k (t, u))).2) = ιL P (t, F i u)
        rw [hπι]
  -- A2: `G i` is Lipschitz
  have hGlip : ∀ i, ∃ K, LipschitzWith K (G i) := fun i =>
    ⟨_, (ιL P).lipschitzWith.comp ((LipschitzWith.prod_fst.comp (πL k).lipschitzWith).prodMk
      ((hL i).comp (LipschitzWith.prod_snd.comp (πL k).lipschitzWith)))⟩
  -- A3: `DG i(b) c = ι(c₀, DF i(π₂ b)(π₂ c))`, which is injective
  have hGd : ∀ i, ∀ b ∈ Bh i, HasFDerivAt (G i) ((ιL P).comp
      (((ContinuousLinearMap.id ℝ ℝ).prodMap (fderiv ℝ (F i) (πL k b).2)).comp (πL k))) b := by
    intro i b hb
    have h1 : HasFDerivAt (Prod.map (id : ℝ → ℝ) (F i))
        ((ContinuousLinearMap.id ℝ ℝ).prodMap (fderiv ℝ (F i) (πL k b).2)) (πL k b) :=
      HasFDerivAt.prodMap (πL k b) (hasFDerivAt_id _) (hdiff i _ hb.2).1.hasFDerivAt
    exact (ιL P).hasFDerivAt.comp b (h1.comp b (πL k).hasFDerivAt)
  have hDap : ∀ i b c, ((ιL P).comp (((ContinuousLinearMap.id ℝ ℝ).prodMap
      (fderiv ℝ (F i) (πL k b).2)).comp (πL k))) c =
      ιL P ((πL k c).1, fderiv ℝ (F i) (πL k b).2 (πL k c).2) := fun _ _ _ => rfl
  have hGdinj : ∀ i, ∀ b ∈ Bh i, Injective (fderiv ℝ (G i) b) := by
    intro i b hb c c' h
    rw [(hGd i b hb).fderiv, hDap, hDap] at h
    obtain ⟨h3, h4⟩ := Prod.mk.inj (hιinj P h)
    rw [← hιπ k c, ← hιπ k c']
    exact congrArg (ιL k) (Prod.ext h3 ((hdiff i _ hb.2).2 h4))
  -- A4: the Gram matrix of `DG i(b)` is `diag(1, Gram DF i(π₂ b))`, so `JG i(b) = JF i(π₂ b)`
  have hGJ : ∀ i, ∀ b ∈ Bh i, Real.sqrt (Matrix.det (Matrix.of fun a c : Fin (k + 1) =>
      inner ℝ (fderiv ℝ (G i) b (EuclideanSpace.single a 1))
        (fderiv ℝ (G i) b (EuclideanSpace.single c 1)))) =
      Real.sqrt (Matrix.det (Matrix.of fun a c : Fin k =>
        inner ℝ (fderiv ℝ (F i) (πL k b).2 (EuclideanSpace.single a 1))
          (fderiv ℝ (F i) (πL k b).2 (EuclideanSpace.single c 1)))) := by
    intro i b hb
    rw [(hGd i b hb).fderiv, Matrix.det_succ_row_zero, Fin.sum_univ_succ]
    simp only [Matrix.of_apply, hDap, hπe0, hπes, hinner, map_zero, inner_zero_left,
      inner_zero_right, Fin.succAbove_zero, mul_zero, zero_mul, add_zero, mul_one, Fin.val_zero,
      pow_zero, one_mul, Finset.sum_const_zero]
    congr 2
    ext a c
    simp only [Matrix.submatrix_apply, Matrix.of_apply, hπes, zero_mul, zero_add]
  -- B5(d): `range DG i(b) = span{ê₀} ⊔ J(range DF i(π₂ b))`
  have hGrange : ∀ i, ∀ b ∈ Bh i,
      LinearMap.range (fderiv ℝ (G i) b : Euclid (k + 1) →ₗ[ℝ] Euclid (P + 1)) =
      Submodule.span ℝ (insert (ιL P (1, 0)) ((fun v => ιL P (0, v)) ''
        (LinearMap.range (fderiv ℝ (F i) (πL k b).2 : Euclid k →ₗ[ℝ] Euclid P) :
          Set (Euclid P)))) := by
    intro i b hb
    rw [(hGd i b hb).fderiv]
    apply le_antisymm
    · rintro _ ⟨c, rfl⟩
      have hsplit : ιL P ((πL k c).1, fderiv ℝ (F i) (πL k b).2 (πL k c).2) =
          (πL k c).1 • ιL P (1, 0) + ιL P (0, fderiv ℝ (F i) (πL k b).2 (πL k c).2) := by
        rw [← map_smul, ← map_add]
        congr 1
        ext <;> simp
      show ((ιL P).comp (((ContinuousLinearMap.id ℝ ℝ).prodMap
        (fderiv ℝ (F i) (πL k b).2)).comp (πL k))) c ∈ _
      rw [hDap, hsplit]
      exact Submodule.add_mem _ (Submodule.smul_mem _ _ (Submodule.subset_span (mem_insert _ _)))
        (Submodule.subset_span (mem_insert_of_mem _ ⟨_, ⟨_, rfl⟩, rfl⟩))
    · rw [Submodule.span_le]
      rintro _ (rfl | ⟨_, ⟨w, rfl⟩, rfl⟩)
      · exact ⟨EuclideanSpace.single 0 1,
          by simp only [ContinuousLinearMap.coe_coe, hDap, hπe0, map_zero]⟩
      · exact ⟨ιL k (0, w), by simp only [ContinuousLinearMap.coe_coe, hDap, hπι]⟩
  -- B5(b): `min(1, m i) |b − b'| ≤ |G i b − G i b'|` on `Bh i`
  have hGlow : ∀ i, ∀ b ∈ Bh i, ∀ b' ∈ Bh i, min 1 (m i) * ‖b - b'‖ ≤ ‖G i b - G i b'‖ := by
    intro i b hb b' hb'
    have h1 : G i b - G i b' =
        ιL P ((πL k b).1 - (πL k b').1, F i (πL k b).2 - F i (πL k b').2) := by
      rw [← map_sub]
      rfl
    have h2 : b - b' = ιL k ((πL k b).1 - (πL k b').1, (πL k b).2 - (πL k b').2) := by
      rw [show ((πL k b).1 - (πL k b').1, (πL k b).2 - (πL k b').2) = πL k (b - b') by
        rw [map_sub]; rfl, hιπ]
    have hX : ‖b - b'‖ ^ 2 =
        ((πL k b).1 - (πL k b').1) ^ 2 + ‖(πL k b).2 - (πL k b').2‖ ^ 2 := by
      rw [h2, hnorm]
    have hY : ‖G i b - G i b'‖ ^ 2 =
        ((πL k b).1 - (πL k b').1) ^ 2 + ‖F i (πL k b).2 - F i (πL k b').2‖ ^ 2 := by
      rw [h1, hnorm]
    have hμ0 : 0 < min 1 (m i) := lt_min one_pos (hm i)
    have hμT : min 1 (m i) * ‖(πL k b).2 - (πL k b').2‖ ≤ ‖F i (πL k b).2 - F i (πL k b').2‖ :=
      (mul_le_mul_of_nonneg_right (min_le_right _ _) (norm_nonneg _)).trans (hbi i _ hb.2 _ hb'.2)
    have e1 : min 1 (m i) ^ 2 * ((πL k b).1 - (πL k b').1) ^ 2 ≤ ((πL k b).1 - (πL k b').1) ^ 2 :=
      mul_le_of_le_one_left (sq_nonneg _) (pow_le_one₀ hμ0.le (min_le_left _ _))
    have e2 : (min 1 (m i) * ‖(πL k b).2 - (πL k b').2‖) ^ 2 ≤
        ‖F i (πL k b).2 - F i (πL k b').2‖ ^ 2 :=
      pow_le_pow_left₀ (mul_nonneg hμ0.le (norm_nonneg _)) hμT 2
    refine (pow_le_pow_iff_left₀ (mul_nonneg hμ0.le (norm_nonneg _)) (norm_nonneg _)
      two_ne_zero).mp ?_
    rw [mul_pow, hX, hY, mul_add, ← mul_pow (min 1 (m i)) ‖(πL k b).2 - (πL k b').2‖]
    exact add_le_add e1 e2
  have hGinj : ∀ i, InjOn (G i) (Bh i) := by
    intro i b hb b' hb' h
    have h1 := hGlow i b hb b' hb'
    rw [h, sub_self, norm_zero] at h1
    have h2 : ‖b - b'‖ ≤ 0 := by nlinarith [norm_nonneg (b - b'), lt_min one_pos (hm i)]
    exact sub_eq_zero.mp (norm_le_zero_iff.mp h2)
  have hfinA : ∀ i, IsFiniteMeasure (μHE[k].restrict (A i)) := fun i =>
    isFiniteMeasure_restrict.mpr (ne_top_of_le_ne_top hfin (measure_mono (hFBM i)))
  -- A5–A6: `Hᵏ⁺¹⌞C i = ι_#(L¹⌞(0,1) ⊗ Hᵏ⌞A i)`, by the area formula (accepted
  -- `codim1_lura_gram_area_formula`) for `G i` and for `F i`, the measure preserving `π`
  -- and Tonelli
  have hpiece : ∀ i, μHE[k + 1].restrict (C i) =
      ((volume.restrict (Ioo (0 : ℝ) 1)).prod (μHE[k].restrict (A i))).map (ιL P) := by
    intro i
    have := hfinA i
    obtain ⟨hJm, hGA⟩ := Submission.codim1_lura_gram_area_formula k P (F i)
    have hGAh := (Submission.codim1_lura_gram_area_formula (k + 1) (P + 1) (G i)).2 (Bh i)
      (hBhm i) (fun b hb => (hGd i b hb).differentiableAt) (hGdinj i) (hGinj i)
    ext S hS
    have hιS : MeasurableSet (ιL P ⁻¹' S) := (ιL P).continuous.measurable hS
    have hhm : Measurable fun p : ℝ × Euclid k => ENNReal.ofReal (Real.sqrt (Matrix.det
        (Matrix.of fun a c : Fin k => inner ℝ (fderiv ℝ (F i) p.2 (EuclideanSpace.single a 1))
          (fderiv ℝ (F i) p.2 (EuclideanSpace.single c 1))))) *
        S.indicator 1 (ιL P (p.1, F i p.2)) :=
      (ENNReal.measurable_ofReal.comp (hJm.comp measurable_snd)).mul
        ((measurable_one.indicator hS).comp ((ιL P).continuous.comp
          (continuous_fst.prodMk ((hL i).continuous.comp continuous_snd))).measurable)
    rw [← lintegral_indicator_one (μ := μHE[k + 1].restrict (C i)) hS, ← hGC i, hGAh,
      Measure.map_apply (ιL P).continuous.measurable hS, Measure.prod_apply hιS,
      setLIntegral_congr_fun (hBhm i) (fun b hb => by rw [hGJ i b hb])]
    rw [(hπmp k).setLIntegral_comp_preimage (measurableSet_Ioo.prod (hB i)) hhm,
      Measure.volume_eq_prod, ← Measure.prod_restrict, lintegral_prod _ hhm.aemeasurable]
    refine lintegral_congr fun t => ?_
    rw [← lintegral_indicator_one (measurable_prodMk_left hιS)]
    exact (hGA (B i) (hB i) (fun a ha => (hdiff i a ha).1) (fun a ha => (hdiff i a ha).2)
      (hFinj i) (fun x => S.indicator 1 (ιL P (t, x)))).symm
  -- B4: sum over the pieces, using `Hᵏ(M ∖ ⋃ A i) = 0`
  have hMA : μHE[k].restrict M = Measure.sum fun i => μHE[k].restrict (A i) := by
    rw [← Measure.restrict_iUnion hdisj hFBm]
    refine Measure.restrict_congr_set (ae_eq_set.mpr ⟨hnull, ?_⟩)
    rw [sdiff_eq_empty.mpr (iUnion_subset hFBM), measure_empty]
  have hmeasure : μHE[k + 1].restrict (ιL P '' (Ioo (0 : ℝ) 1 ×ˢ ⋃ i, A i)) =
      ((volume.restrict (Ioo (0 : ℝ) 1)).prod (μHE[k].restrict M)).map (ιL P) := by
    rw [hCU, Measure.restrict_iUnion hCdisj hCm, hMA, Measure.prod_sum_right,
      Measure.map_sum (ιL P).continuous.measurable.aemeasurable]
    exact congrArg Measure.sum (funext hpiece)
  -- B2: the cylinder `C = ι((0,1) × ⋃ A i) = ⋃ C i` is Borel with `Hᵏ⁺¹(C) = Hᵏ(M) < ∞`
  set Ctot := ιL P '' (Ioo (0 : ℝ) 1 ×ˢ ⋃ i, A i)
  have hCtotm : MeasurableSet Ctot :=
    hmeas_img _ (measurableSet_Ioo.prod (MeasurableSet.iUnion hFBm))
  have hCfin : μHE[k + 1] Ctot ≠ ∞ := by
    have : IsFiniteMeasure (μHE[k].restrict M) := isFiniteMeasure_restrict.mpr hfin
    have : IsFiniteMeasure (volume.restrict (Ioo (0 : ℝ) 1)) :=
      isFiniteMeasure_restrict.mpr measure_Ioo_lt_top.ne
    rw [← Measure.restrict_apply_univ, hmeasure]
    exact measure_ne_top _ _
  -- B5: the tangent planes, piece by piece (accepted `dpf_approxTangent_ae_bilipschitz_piece`)
  have htan : ∀ i, ∀ᵐ y ∂(μHE[k + 1].restrict (C i)), ∀ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt k M (πL P y).2 Q → HasApproximateTangentSpaceAt (k + 1) Ctot y
        (Submodule.span ℝ (insert (ιL P (1, 0))
          ((fun v => ιL P (0, v)) '' (Q : Set (Euclid P))))) := by
    intro i
    obtain ⟨K, hK⟩ := hGlip i
    -- (a) `M` has approximate tangent space `range DF i(u)` at `F i u` for a.e. `u ∈ B i`
    have hTM := Submission.dpf_approxTangent_ae_bilipschitz_piece P k univ M (F i) (B i) (L i)
      (m i) isOpen_univ hM (subset_univ _)
      (fun K' _ _ => ne_top_of_le_ne_top hfin (measure_mono inter_subset_left))
      (hL i) (hB i) (hm i) (hbi i) (hdiff i) (hFBM i)
    -- (b) `C` has approximate tangent space `range DG i(b)` at `G i b` for a.e. `b ∈ Bh i`
    have hTC := Submission.dpf_approxTangent_ae_bilipschitz_piece (P + 1) (k + 1) univ Ctot (G i)
      (Bh i) K (min 1 (m i)) isOpen_univ hCtotm (subset_univ _)
      (fun K' _ _ => ne_top_of_le_ne_top hCfin (measure_mono inter_subset_left)) hK (hBhm i)
      (lt_min one_pos (hm i)) (hGlow i)
      (fun b hb => ⟨(hGd i b hb).differentiableAt, hGdinj i b hb⟩)
      (by rw [hGC i, hCU]; exact subset_iUnion C i)
    -- (c) (a) holds at `π₂ b` for a.e. `b ∈ Bh i`, since `π` is measure preserving
    have hTM' : ∀ᵐ b ∂(volume.restrict (Bh i)), HasApproximateTangentSpaceAt k M (F i (πL k b).2)
        (LinearMap.range (fderiv ℝ (F i) (πL k b).2 : Euclid k →ₗ[ℝ] Euclid P)) := by
      refine ((hπmp k).restrict_preimage
        (measurableSet_Ioo.prod (hB i))).quasiMeasurePreserving.ae
        (p := fun p : ℝ × Euclid k => HasApproximateTangentSpaceAt k M (F i p.2)
          (LinearMap.range (fderiv ℝ (F i) p.2 : Euclid k →ₗ[ℝ] Euclid P))) ?_
      rw [Measure.volume_eq_prod, ← Measure.prod_restrict]
      exact Measure.quasiMeasurePreserving_snd.ae hTM
    -- (d) there, uniqueness of approximate tangent spaces and `range DG i(b) = ℝe₀ ⊕ J(range DF i)`
    have hcomb : ∀ᵐ b ∂(volume.restrict (Bh i)), ∀ Q : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt k M (πL P (G i b)).2 Q →
        HasApproximateTangentSpaceAt (k + 1) Ctot (G i b)
          (Submodule.span ℝ (insert (ιL P (1, 0))
            ((fun v => ιL P (0, v)) '' (Q : Set (Euclid P))))) := by
      filter_upwards [hTC, hTM', ae_restrict_mem (hBhm i)] with b hbC hbM hb Q hQ
      have hprG : (πL P (G i b)).2 = F i (πL k b).2 := by
        show (πL P (ιL P ((πL k b).1, F i (πL k b).2))).2 = _
        rw [hπι]
      rw [hprG] at hQ
      rw [hQ.unique hbM, ← hGrange i b hb]
      exact hbC
    -- (e) the exceptional set is the image of a Lebesgue-null set under the Lipschitz `G i`
    rw [← hGC i, ae_iff, Measure.restrict_apply' ((hGC i).symm ▸ hCm i)]
    rw [ae_iff, Measure.restrict_apply' (hBhm i)] at hcomb
    refine measure_mono_null (t := G i '' ({b | ¬∀ Q : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt k M (πL P (G i b)).2 Q →
        HasApproximateTangentSpaceAt (k + 1) Ctot (G i b) (Submodule.span ℝ (insert (ιL P (1, 0))
          ((fun v => ιL P (0, v)) '' (Q : Set (Euclid P)))))} ∩ Bh i)) ?_ ?_
    · rintro _ ⟨hy, b, hb, rfl⟩
      exact ⟨b, ⟨hy, hb⟩, rfl⟩
    · refine le_antisymm (le_trans
        (Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn (k + 1)
          hK.lipschitzOnWith) ?_) bot_le
      rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume, hcomb, mul_zero]
  refine ⟨Ctot, hCtotm, image_mono (prod_mono subset_rfl (iUnion_subset hFBM)), ?_, hmeasure, ?_⟩
  -- B3: `C ⊆ ⋃ range (G i)`, every `G i` being Lipschitz
  · refine ⟨∅, measure_empty, G, hGlip, ?_⟩
    rw [empty_union, hCU]
    exact iUnion_mono fun i => hGC i ▸ image_subset_range _ _
  · have hCC : μHE[k + 1].restrict Ctot = μHE[k + 1].restrict (⋃ i, C i) := by rw [hCU]
    rw [hCC, ae_restrict_iUnion_iff]
    exact htan

/-- **Smooth pull-backs and the homotopy formula on forms** (Simon 6.2.23–6.2.26, dual form).
(a) The pull-back `Φ^#α(x) = α(Φ x) ∘ DΦ(x)` of a smooth form by a `C^∞` map is smooth.
(b) Let `F, G` be `C^∞`, `h(t, x) = F x + t(G x - F x)` the affine homotopy (6.2.26) and `ω` a
smooth `(k+1)`-form.  Then `Kω(x) = ∫₀¹ (ι_{G x - F x} ω(h(t, x))) ∘ D_x h(t, x) dt` is smooth and
`G^#ω - F^#ω = d(Kω) + K(dω)`, the homotopy formula 6.2.25 tested on `ω`.  The precomposition
`L ↦ (γ ↦ γ ∘ L)` is analytic, which gives (a).  For (b) we work on a proper normed space `E`:
with `H = h` on `ℝ × E`, `Θ = H^#ω` and `e = (1, 0)`, `dΘ = H^#(dω)` and Cartan's formula
`d(ι_e Θ) + ι_e dΘ = DΘ[e]` hold; pulling back by `y ↦ (t, y)` turns `ι_e Θ` and `ι_e dΘ` into the
integrands of `Kω` and `K(dω)` and `DΘ[e]` into `∂_t (h_t^#ω)`.  Integrating over `t ∈ [0, 1]`
and differentiating under the integral sign gives the formula. -/
theorem Submission.dor_lmb_fcdp_smooth_homotopy : (∀ (N N' m : ℕ) (Φ : Euclid N → Euclid N') (α : DifferentialForm (Euclid N') m), ContDiff ℝ (⊤ : ℕ∞) Φ → IsSmoothForm α → IsSmoothForm (fun x => (α (Φ x)).compContinuousLinearMap (fderiv ℝ Φ x))) ∧ ∀ (P k : ℕ) (F G : Euclid P → Euclid P) (ω : DifferentialForm (Euclid P) (k + 1)), ContDiff ℝ (⊤ : ℕ∞) F → ContDiff ℝ (⊤ : ℕ∞) G → IsSmoothForm ω → IsSmoothForm (fun x => ∫ t in (0 : ℝ)..1, ((ω (F x + t • (G x - F x))).curryLeft (G x - F x)).compContinuousLinearMap (fderiv ℝ F x + t • (fderiv ℝ G x - fderiv ℝ F x))) ∧ ∀ x, (ω (G x)).compContinuousLinearMap (fderiv ℝ G x) - (ω (F x)).compContinuousLinearMap (fderiv ℝ F x) = exteriorDerivative (fun x' => ∫ t in (0 : ℝ)..1, ((ω (F x' + t • (G x' - F x'))).curryLeft (G x' - F x')).compContinuousLinearMap (fderiv ℝ F x' + t • (fderiv ℝ G x' - fderiv ℝ F x'))) x + ∫ t in (0 : ℝ)..1, ((exteriorDerivative ω (F x + t • (G x - F x))).curryLeft (G x - F x)).compContinuousLinearMap (fderiv ℝ F x + t • (fderiv ℝ G x - fderiv ℝ F x)) := by
  -- the pull-back `x ↦ α(x) ∘ L(x)` is `C^∞` when `α` and `L` are, as `L ↦ (γ ↦ γ ∘ L)` is analytic
  have hpb : ∀ (E₁ E₂ E₃ : Type) [NormedAddCommGroup E₁] [NormedSpace ℝ E₁]
      [NormedAddCommGroup E₂] [NormedSpace ℝ E₂] [NormedAddCommGroup E₃] [NormedSpace ℝ E₃]
      (m : ℕ) (α : E₁ → E₂ [⋀^Fin m]→L[ℝ] ℝ) (L : E₁ → E₃ →L[ℝ] E₂),
      ContDiff ℝ (⊤ : ℕ∞) α → ContDiff ℝ (⊤ : ℕ∞) L →
        ContDiff ℝ (⊤ : ℕ∞) (fun x => (α x).compContinuousLinearMap (L x)) := by
    intro E₁ E₂ E₃ _ _ _ _ _ _ m α L hα hL
    have hΨ : ContDiff ℝ (⊤ : ℕ∞) (ContinuousAlternatingMap.compContinuousLinearMapCLM :
        (E₃ →L[ℝ] E₂) → (E₂ [⋀^Fin m]→L[ℝ] ℝ) →L[ℝ] (E₃ [⋀^Fin m]→L[ℝ] ℝ)) :=
      (ContinuousAlternatingMap.analyticOnNhd_compContinuousLinearMapCLM univ).contDiff
    exact (hΨ.comp hL).clm_apply hα
  -- (a) `Φ^#α(x) = α(Φ x) ∘ DΦ(x)`
  refine ⟨fun N N' m Φ α hΦ hα => hpb (Euclid N) (Euclid N') (Euclid N) m (fun x => α (Φ x))
    (fderiv ℝ Φ) (hα.comp hΦ) (contDiff_infty_iff_fderiv.mp hΦ).2, ?_⟩
  -- (b) on an abstract proper normed space `E`, then for `E = ℝᴾ`
  suffices key : ∀ (E : Type) [NormedAddCommGroup E] [NormedSpace ℝ E] [ProperSpace E] (k : ℕ)
      (F G : E → E) (ω : DifferentialForm E (k + 1)), ContDiff ℝ (⊤ : ℕ∞) F →
      ContDiff ℝ (⊤ : ℕ∞) G → IsSmoothForm ω → IsSmoothForm (fun x => ∫ t in (0 : ℝ)..1,
        ((ω (F x + t • (G x - F x))).curryLeft (G x - F x)).compContinuousLinearMap
