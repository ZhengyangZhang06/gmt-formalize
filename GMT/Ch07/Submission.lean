  have hFψ : ∀ a ∈ PH.target, y + ι a + ι' (u a) = ψ (χ a) := by
    intro a ha
    have h1 : π (ψ (χ a) - y) = a := PH.right_inv ha
    have h2 : ψ (χ a) - y = ι a + ι' (u a) := by
      conv_lhs => rw [hdec (ψ (χ a) - y)]
