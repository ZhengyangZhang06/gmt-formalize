    obtain ⟨vp, hvpV, hvp⟩ : p ∈ ψ '' V := by rw [hψim]; exact ⟨hpW, hp⟩
    have hψ2 : ∀ v ∈ V, ContDiffAt ℝ 2 ψ v := fun v hv => hψ.contDiffAt (hV.mem_nhds hv)
