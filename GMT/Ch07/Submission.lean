        ∃ m : ℕ, θ a = m := by
    intro lams hlams hlams0
    -- (a) the blow-up limit `C = θ(a) ζ(a) ν`, with the integer slice property
    obtain ⟨φ, ν, C, Γs, μs, ξs, hφ, hνK, hνball, hνpos, hCrep, hCb, hCmass, hCisp, hconv, hΓsb,
        hμsK, -, hξsm, hξsbd, hΓsrep, hlimsup, hμsN, hHlimsup, hfconv⟩ :=
      Submission.cbr_ci_blowup_limit hSL hRU hCT P d hSLIM Γ μ M θ ζ a η₁ lams hΓb hΓisp hμfin
        hμmass hM hHM hθ hζ hμeq hθpos hζbd hζunit hΓrep haM hη₁ hdens hupper hLeb hlams hlams0
    -- (b) `ν` has lower density `≥ η₀/θ(a)` at `ν`-a.e. point
    have hνdens := Submission.cbr_ci_pw_blowup_lower_density P d η₀ (θ a) ν (ζ a) C hLD hθ₀ hCb
      hνK hCmass (hζbd a) hCrep hCisp
    -- (c) `0 = ∂C(ψ) = C(dψ) = θ(a) ∫ ⟨dψ, ζ(a)⟩ dν`
    have hbdry : ∀ ψ : TestFormOn (univ : Set (Euclid P)) d,
        ∫ y, ζ a (exteriorDerivative (ψ : DifferentialForm (Euclid P) d) y) ∂ν = 0 := by
      intro ψ
      have h : C.boundary ψ = 0 := by rw [hCb]; rfl
      rw [GeometricCurrentOn.boundary_apply, hCrep, integral_const_mul] at h
      exact (mul_eq_zero.mp h).resolve_left hθ₀.ne'
    -- (d) `ζ(a) = v₁ ∧ ⋯ ∧ vₙ` and `ν = Σᵢ αᵢ Hⁿ⌞(wᵢ + span v)`
    obtain ⟨v, N, w, α, hv, hζv, hw, hwv, hαc, hαsum, hw0, hνeq⟩ :=
      Submission.cbr_ci_constant_cycle_planes P d ν (ζ a) (η₀ / θ a) hc hνK (hζbd a)
        (hζunit a haM) hbdry hνball hνpos hνdens
    have hCv : ∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1),
        C ω = θ a * ∫ y, (ω : DifferentialForm (Euclid P) (d + 1)) y v ∂ν := by
      intro ω
      rw [hCrep ω, integral_const_mul]
      simp only [hζv]
    -- (e) every weight is `≥ 1`
    have hα1 : ∀ i, 1 ≤ α i :=
      Submission.cbr_ci_plane_weight_ge_one hREP hSL hCT P d v (θ a) N w α ν C Γs μs ξs
        (fun k => Poincare.SimonGMT.Chapter03.blowUpMap a (lams (φ k)) '' M) hv hθ₀ hw hwv
        (fun i => hc.trans_le (hαc i)) hνeq hCv hconv hΓsb hμsK hξsm hξsbd hΓsrep hlimsup hμsN
        hHlimsup
    -- (f) `N ≤ Σᵢ αᵢ ≤ 1`: a single plane through `0` of weight one, `ν = Hⁿ⌞span v`
    have hνV : ν = (μHE[(d + 1)]).restrict (Submodule.span ℝ (Set.range v) : Set (Euclid P)) :=
      Submission.cbr_ci_pw_single_plane_of_unit_weights P N (μHE[(d + 1)]) ν
        (Submodule.span ℝ (Set.range v)) w α hα1 hαsum hw0 hνeq
    -- (h) `C = θ(a) [[span v]]` has the integer slice property, so `θ(a) ∈ ℕ`
    obtain ⟨m, hm⟩ := Submission.cbr_ci_plane_multiplicity_nat hMR hSL P d v (θ a) C hv hθ₀
      (fun ω => by rw [hCv ω, hνV]) hCisp
    -- (g) `∫_{η_{a,λ}(M)} f dHⁿ → ∫ f dν = ∫_{span v} f dHⁿ` along the subsequence
    refine ⟨φ, v, hφ, hv, hζv, fun f hf hfc => ?_, m, hm⟩
    have h := hfconv f hf hfc
    rwa [hνV] at h
  -- Step 2: the plane `Q := span v₀`, from the blow-up sequence `1/(i+1)`
  obtain ⟨-, v₀, -, hv₀, hζv₀, -, m, hm⟩ := claim (fun i => 1 / ((i : ℝ) + 1))
    (fun _ => Nat.one_div_pos_of_nat) tendsto_one_div_add_atTop_nhds_zero_nat
  have hQ : Module.finrank ℝ (Submodule.span ℝ (Set.range v₀)) = d + 1 := by
    rw [finrank_span_eq_card hv₀.linearIndependent, Fintype.card_fin]
  refine ⟨Submodule.span ℝ (Set.range v₀), ?_, ⟨v₀, hv₀, rfl, Or.inl hζv₀⟩, m, hm⟩
  -- Step 3: the plane of every blow-up sequence is `Q`, so `Q` is the approximate tangent space
  refine Submission.cbr_ci_pw_approxTangent_of_subseq P (d + 1) M a _ hQ
    fun lams hlams hlams0 => ?_
  obtain ⟨φ, v, hφ, hv, hζv, hconv, -⟩ := claim lams hlams hlams0
  have hspan : Submodule.span ℝ (Set.range v) = Submodule.span ℝ (Set.range v₀) :=
    Submission.cbr_ci_pw_span_eq_of_covector_eval_eq P (d + 1) v v₀ hv hv₀
      fun β => (hζv β).symm.trans (hζv₀ β)
  refine ⟨φ, hφ, fun f hf hfc => ?_⟩
  have h := hconv f hf hfc
  rwa [hspan] at h
/-- **Simon Ch. 3, 1.4** (measurability of the approximate tangent planes): if `Hⁿ(M ∩ K) < ∞`
for every compact `K` and `Q(x)` is an approximate tangent space of `M` at `Hⁿ⌞M`-a.e. `x`, then
`x ↦ p_{Q(x)} = (Q x).starProjection` is `Hⁿ⌞M`-a.e. strongly measurable.  For `n = 0`,
`Q(x) = 0` a.e.  For `n ≥ 1` and `f_u(y) = max(1 − |y|², 0)⟨u, y⟩²`, the blow-up integrals
`x ↦ ∫_{η_{x,1/(k+1)}(M)} f_u dHⁿ` are continuous and tend a.e. to
`∫_{Q(x)} f_u dHⁿ = c|p_{Q(x)} u|²`, so every `x ↦ |p_{Q(x)} u|²` is a.e.-measurable, and hence
so is `x ↦ p_{Q(x)}`. -/
theorem Submission.cbr_ci_imc_tangent_field_aestronglyMeasurable : ∀ (P n : ℕ) (M : Set (Euclid P)) (Q : Euclid P → Submodule ℝ (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → μHE[n] (M ∩ K) ≠ ∞) → (∀ᵐ x ∂(μHE[n].restrict M), HasApproximateTangentSpaceAt n M x (Q x)) → AEStronglyMeasurable (fun x => (Q x).starProjection) (μHE[n].restrict M) := by
  intro P n M Q hloc htan
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · -- `n = 0`: `dim Q(x) = 0`, so `Q(x) = 0` and `p_{Q(x)} = 0` a.e.
    refine (aestronglyMeasurable_const (b := (0 : Euclid P →L[ℝ] Euclid P))).congr ?_
    filter_upwards [htan] with x hx
    have h0 : Q x = ⊥ := Submodule.finrank_eq_zero.1 hx.1
    rw [h0]
    ext v
    simp
  · -- `n ≥ 1`: `∫_{Q'} f_u dHⁿ = c|p_{Q'} u|²` for every `n`-plane `Q'`
    obtain ⟨c, hc, hmom⟩ := Submission.exists_plane_cutoff_quadratic_moment_eq n hn
    apply AEMeasurable.aestronglyMeasurable
    apply Submission.aemeasurable_starProjection_of_aemeasurable_norm_sq
    intro u
    -- the test function `f_u ∈ C_c(ℝᴾ)`, vanishing outside the closed unit ball
    set f : Euclid P → ℝ := fun y => max (1 - ‖y‖ ^ 2) 0 * inner ℝ u y ^ 2 with hf_def
    have hfc : Continuous f := by
      simp only [hf_def]
      fun_prop
    have hfs : HasCompactSupport f := by
      apply HasCompactSupport.intro (isCompact_closedBall (0 : Euclid P) 1)
      intro y hy
      simp only [mem_closedBall, dist_zero_right, not_le] at hy
      have h1 : 1 - ‖y‖ ^ 2 ≤ 0 := by nlinarith [norm_nonneg y]
      simp [hf_def, max_eq_right h1]
    let F : CompactlySupportedContinuousMap (Euclid P) ℝ := ⟨⟨f, hfc⟩, hfs⟩
    -- the radii `r_k = 1/(k + 1) → 0⁺`
    let r : ℕ → ℝ := fun k => 1 / ((k : ℝ) + 1)
    have hrpos : ∀ k, 0 < r k := fun k => by positivity
    have hr : Tendsto r atTop (𝓝[>] 0) :=
      tendsto_nhdsWithin_iff.2 ⟨tendsto_one_div_add_atTop_nhds_zero_nat,
        Eventually.of_forall hrpos⟩
    -- the blow-up integrals are continuous in `x`, hence measurable
    have hmeas : ∀ k, AEMeasurable (fun x => ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x (r k) '' M, f y ∂μHE[n]) (μHE[n].restrict M) := fun k =>
      (Submission.continuous_blowUp_image_setIntegral P n M hloc f hfc hfs (r k) (hrpos k)).measurable.aemeasurable
    -- and tend a.e. to `∫_{Q(x)} f_u dHⁿ = c|p_{Q(x)} u|²`
    have hlim : ∀ᵐ x ∂(μHE[n].restrict M), Tendsto (fun k => ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x (r k) '' M, f y ∂μHE[n]) atTop (𝓝 (c * ‖(Q x).starProjection u‖ ^ 2)) := by
      filter_upwards [htan] with x hx
      rw [← hmom P (Q x) hx.1 u]
      exact (hx.2 F).comp hr
    have h1 : AEMeasurable (fun x => c * ‖(Q x).starProjection u‖ ^ 2) (μHE[n].restrict M) :=
      aemeasurable_of_tendsto_metrizable_ae' hmeas hlim
    refine (h1.const_mul c⁻¹).congr (Eventually.of_forall fun x => ?_)
    simp only
    rw [← mul_assoc, inv_mul_cancel₀ hc.ne', one_mul]
/-- **Simon Ch. 6, 3.1** (integer multiplicity currents): if `Γ(ω) = ∫_M θ ⟨ω, ζ⟩ dHⁿ` with `M`
Borel and countably `n`-rectifiable, `θ > 0` on `M`, `∫_M θ dHⁿ < ∞`, and `Hⁿ`-a.e. on `M` the
density `θ` is an integer and `ζ` orients an approximate tangent space of `M`, then `Γ` is integer
multiplicity.  The bad set is `Hⁿ`-null; removing a measurable null hull `N₀` of it leaves a Borel
carrier `M'' = M \ N₀` on which everything holds pointwise, which has the approximate tangent
spaces of `M` (Ch. 3, 1.4) and `Hⁿ⌞M'' = Hⁿ⌞M`; the multiplicity is `⌊θ⌋₊` on `M''`. -/
theorem Submission.cbr_ci_imc_isIntegerMultiplicity_of_rectifiable : ∀ (P n : ℕ) (Γ : GeometricCurrentOn (univ : Set (Euclid P)) n) (M : Set (Euclid P)) (θ : Euclid P → ℝ) (ζ : Euclid P → MultiVector P n), MeasurableSet M → CountablyRectifiable n M → Measurable θ → StronglyMeasurable ζ → (∀ x ∈ M, 0 < θ x) → ∫⁻ x in M, ENNReal.ofReal (θ x) ∂μHE[n] < ∞ → (∀ ω : TestFormOn (univ : Set (Euclid P)) n, Γ ω = ∫ x in M, θ x * ζ x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → (∀ᵐ x ∂(μHE[n].restrict M), ∃ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ∧ IsUnitOrientationOf (ζ x) Q ∧ ∃ m : ℕ, θ x = m) → IsIntegerMultiplicity Γ := by
  intro P n Γ M θ ζ hM hrect hθ hζ hpos hint hrep hae
  classical
  set p : Euclid P → Prop := fun x => ∃ Q : Submodule ℝ (Euclid P),
    HasApproximateTangentSpaceAt n M x Q ∧ IsUnitOrientationOf (ζ x) Q ∧ ∃ m : ℕ, θ x = m
  -- the bad set `{x ∈ M | ¬ p x}` is `Hⁿ`-null, and so is its measurable hull `N₀`
  have hbad : μHE[n] {x | x ∈ M ∧ ¬ p x} = 0 := by
    rw [ae_restrict_iff' hM, ae_iff] at hae
    simpa only [not_imp] using hae
  set N₀ := toMeasurable (μHE[n]) {x | x ∈ M ∧ ¬ p x} with hN₀_def
  have hN₀m : MeasurableSet N₀ := measurableSet_toMeasurable _ _
  have hN₀ : μHE[n] N₀ = 0 := by rw [hN₀_def, measure_toMeasurable]; exact hbad
  -- the carrier `M'' = M \ N₀` is Borel, `p` holds on all of it, and `M'' =ᵐ M`
  set M'' := M \ N₀
  have hM''m : MeasurableSet M'' := hM.diff hN₀m
  have hM''sub : M'' ⊆ M := Set.sdiff_subset
  have hgood : ∀ x ∈ M'', p x := by
    intro x hx
    by_contra h
    exact hx.2 (subset_toMeasurable _ _ ⟨hx.1, h⟩)
  have hdiff : μHE[n] (M \ M'') = 0 := by
    refine measure_mono_null (fun x hx => ?_) hN₀
    by_contra h
    exact hx.2 ⟨hx.1, h⟩
  have hdiff' : μHE[n] (M'' \ M) = 0 := by
    rw [Set.sdiff_eq_empty.2 hM''sub, measure_empty]
  -- the multiplicity `⌊θ⌋₊` on `M''`, which is `θ` there
  let mult : Euclid P → ℕ := fun x => if x ∈ M'' then ⌊θ x⌋₊ else 0
  have hmult_eq : ∀ x ∈ M'', (mult x : ℝ) = θ x := by
    intro x hx
    obtain ⟨Q, -, -, m, hm⟩ := hgood x hx
    simp [mult, hx, hm]
  have hmult_meas : Measurable mult :=
    Measurable.ite hM''m (Nat.floor_mono.measurable.comp hθ) measurable_const
  have hmult_pos : ∀ x ∈ M'', 0 < mult x := by
    intro x hx
    have h2 := hpos x (hM''sub hx)
    rw [← hmult_eq x hx] at h2
    exact_mod_cast h2
  have hmult_int : ∀ K : Set (Euclid P), IsCompact K → K ⊆ univ →
      ∫⁻ x in M'' ∩ K, (mult x : ℝ≥0∞) ∂μHE[n] ≠ ∞ := by
    intro K _ _
    apply ne_of_lt
    calc ∫⁻ x in M'' ∩ K, (mult x : ℝ≥0∞) ∂μHE[n]
        ≤ ∫⁻ x in M'', (mult x : ℝ≥0∞) ∂μHE[n] := lintegral_mono_set inter_subset_left
      _ = ∫⁻ x in M'', ENNReal.ofReal (θ x) ∂μHE[n] := by
        apply setLIntegral_congr_fun hM''m
        intro x hx
        simp only
        rw [← hmult_eq x hx, ENNReal.ofReal_natCast]
      _ ≤ ∫⁻ x in M, ENNReal.ofReal (θ x) ∂μHE[n] := lintegral_mono_set hM''sub
      _ < ∞ := hint
  -- `M` and `M''` have the same approximate tangent spaces (Ch. 3, 1.4)
  have horients : ∀ᵐ x ∂(μHE[n].restrict M''), ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n M'' x Q ∧ IsUnitOrientationOf (ζ x) Q := by
    rw [ae_restrict_iff' hM''m]
    refine Eventually.of_forall fun x hx => ?_
    obtain ⟨Q, hQ, hor, -⟩ := hgood x hx
    exact ⟨Q, (Submission.hasApproximateTangentSpaceAt_iff_of_null_sdiff P n M M'' x Q
      hdiff hdiff').1 hQ, hor⟩
  let R : IMRep (univ : Set (Euclid P)) n :=
    { carrier := M''
      mult := mult
      orient := ζ
      measurableSet_carrier := hM''m
      carrier_subset := subset_univ _
      rectifiable := hrect.mono hM''sub
      measurable_mult := hmult_meas
      mult_pos := hmult_pos
      locallyIntegrable_mult := hmult_int
      aestronglyMeasurable_orient := hζ.aestronglyMeasurable
      orients := horients }
  -- `R` represents `Γ`: `Hⁿ⌞M = Hⁿ⌞M''` and `mult = θ` on `M''`
  refine ⟨R, fun ω => ?_⟩
  rw [hrep ω]
  have hres : μHE[n].restrict M = μHE[n].restrict M'' :=
    Measure.restrict_congr_set (ae_eq_set.2 ⟨hdiff, hdiff'⟩)
  show _ = ∫ x in M'', (mult x : ℝ) * ζ x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]
  rw [hres]
  refine setIntegral_congr_fun hM''m (fun x hx => ?_)
  simp only [hmult_eq x hx]

/-- **Integer multiplicity criterion** (Simon Ch. 6, 3.1, with Ch. 3, 1.4 and the rectifiability
criterion `(RECT)`, assumed as the first hypothesis).  Let `Γ(ω) = ∫_M θ⟨ω, ζ⟩ dHⁿ` with `M` Borel,
`Hⁿ(M) < ∞`, `θ > 0` on `M` and `∫_M θ dHⁿ < ∞`.  If at `Hⁿ`-a.e. `x ∈ M` the multiplicity `θ(x)` is
a natural number and `ζ(x)` orients an approximate tangent space of `M`, then `Γ` is integer
multiplicity.  At such `x` the plane `Tₓ = approxTangentPlane n M x` is an approximate tangent
space; `Hⁿ(M ∩ K) ≤ Hⁿ(M) < ∞`, so `x ↦ p_{Tₓ}` is `Hⁿ⌞M`-a.e. strongly measurable and `(RECT)`
makes `M` countably `n`-rectifiable.  The representation is then assembled on a Borel part of `M`
of full measure. -/
theorem Submission.cbr_ci_isIntegerMultiplicity_of_ae_tangent : (∀ (P n : ℕ) (M : Set (Euclid P)) (Q : Euclid P → Submodule ℝ (Euclid P)), MeasurableSet M → μHE[n] M ≠ ∞ → AEStronglyMeasurable (fun x => (Q x).starProjection) (μHE[n].restrict M) → (∀ᵐ x ∂(μHE[n].restrict M), HasApproximateTangentSpaceAt n M x (Q x)) → CountablyRectifiable n M) → ∀ (P n : ℕ) (Γ : GeometricCurrentOn (univ : Set (Euclid P)) n) (M : Set (Euclid P)) (θ : Euclid P → ℝ) (ζ : Euclid P → MultiVector P n), MeasurableSet M → μHE[n] M < ∞ → Measurable θ → StronglyMeasurable ζ → (∀ x ∈ M, 0 < θ x) → ∫⁻ x in M, ENNReal.ofReal (θ x) ∂μHE[n] < ∞ → (∀ ω : TestFormOn (univ : Set (Euclid P)) n, Γ ω = ∫ x in M, θ x * ζ x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → (∀ᵐ x ∂(μHE[n].restrict M), ∃ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ∧ IsUnitOrientationOf (ζ x) Q ∧ ∃ m : ℕ, θ x = m) → IsIntegerMultiplicity Γ := by
  intro hRECT P n Γ M θ ζ hM hfin hθ hζ hpos hint hrep hae
  -- `Tₓ = approxTangentPlane n M x` is an approximate tangent space of `M` at a.e. `x ∈ M`
  have htan : ∀ᵐ x ∂(μHE[n].restrict M),
      HasApproximateTangentSpaceAt n M x (approxTangentPlane n M x) := by
    filter_upwards [hae] with x hx
    obtain ⟨Q, hQ, -⟩ := hx
    have h : ∃ Q, HasApproximateTangentSpaceAt n M x Q := ⟨Q, hQ⟩
    rw [approxTangentPlane, dite_eq_left h]
    exact h.choose_spec
  -- `Hⁿ(M ∩ K) ≤ Hⁿ(M) < ∞`, so `x ↦ p_{Tₓ}` is a.e. strongly measurable and `(RECT)` applies
  have hloc : ∀ K : Set (Euclid P), IsCompact K → μHE[n] (M ∩ K) ≠ ∞ := fun K _ =>
    ne_top_of_le_ne_top hfin.ne (measure_mono inter_subset_left)
  have hrect : CountablyRectifiable n M :=
    hRECT P n M (approxTangentPlane n M) hM hfin.ne
      (Submission.cbr_ci_imc_tangent_field_aestronglyMeasurable P n M _ hloc htan) htan
  -- assemble the integer multiplicity representation of `Γ` on the rectifiable `M`
  exact Submission.cbr_ci_imc_isIntegerMultiplicity_of_rectifiable P n Γ M θ ζ hM hrect hθ hζ
    hpos hint hrep hae
/-- **The integer slice property passes to weak limits** (Simon Ch. 6, 8.2–8.3, the slicing step
of the closure theorem used in 7.2.4).  Assume (REP), (MR), (IMC), (SL) and CL(d).  If `Xᵢ ⇀ X`
in `ℝᴾ`, every `Xᵢ ∈ 𝒟_{d+1}(ℝᴾ)` has the integer slice property and
`supᵢ (M_W(Xᵢ) + M_W(∂Xᵢ)) < ∞` for every open `W ⊂⊂ ℝᴾ`, then `X` has the integer slice
property.  Represent `Xᵢ` and `∂Xᵢ` by (REP) and pass by (T1) to a subsequence with limit measures
`ν`, `ν'`.  For a.e. `t` the slices `Z_{j,t} = ∂A_{j,t} − B_{j,t}` of the subsequence are integer
multiplicity (ISP), have `liminfⱼ (M_{W_k}(Z_{j,t}) + M_{W_k}(∂Z_{j,t})) < ∞` on every ball
`W_k = B_{k+1}(0)` (`cbrsl_slice_boundary_mass_bound`, `cbrsl_ae_liminf_lt_top`), and
`ν{f = t} = ν'{f = t} = 0`.  Then (T2) gives `Z_{j,t} ⇀ ∂A − B`, which is integer multiplicity by
`cbrsl_isIntegerMultiplicity_of_local_liminf_bounds`. -/
theorem Submission.cbr_slice_property_of_weak_limit : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → ∀ d : ℕ, (∀ (P : ℕ) (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U d) (T : GeometricCurrentOn U d), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T) → ∀ (P : ℕ) (Xs : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (X : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), (∀ i, (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), Xs i ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (Xs i).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B))) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ → ⨆ i, ((Xs i).massOn W + (Xs i).boundary.massOn W) < ∞) → WeaklyConvergesOn Xs X → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), X ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (X).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B)) := by
  intro hREP hMR hIMC hSL d hCL P Xs X hISP hbound hconv μ μ' ξ ξ' hμ hμ' hξm hξm' hξ hξ' hX hXb
    f L hf
  -- integer multiplicity is local in `ℝᴾ` and passes to open subdomains
  have hLOC := Submission.cbr_isIntegerMultiplicity_of_local hREP hMR hIMC
  -- every ball `B_r(0)` is compactly contained in `ℝᴾ`
  have hball : ∀ r : ℝ, CompactlyContained (ball (0 : Euclid P) r) univ := fun r =>
    ⟨(isCompact_closedBall 0 r).of_isClosed_subset isClosed_closure closure_ball_subset_closedBall,
      subset_univ _⟩
  -- Step 1: `M_W(Xᵢ)` and `M_W(∂Xᵢ)` are bounded by `Λ_W = supᵢ (M_W(Xᵢ) + M_W(∂Xᵢ)) < ∞`
  have hfin : ∀ i, ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ →
      (Xs i).massOn W < ∞ ∧ (Xs i).boundary.massOn W < ∞ := fun i W hW hWc =>
    ⟨(le_self_add.trans (le_iSup (fun j => (Xs j).massOn W + (Xs j).boundary.massOn W) i)).trans_lt
        (hbound W hW hWc),
      (le_add_self.trans (le_iSup (fun j => (Xs j).massOn W + (Xs j).boundary.massOn W) i)).trans_lt
        (hbound W hW hWc)⟩
  -- Step 3: mass representations `(μᵢ, ξᵢ)` of `Xᵢ` and `(μ'ᵢ, ξ'ᵢ)` of `∂Xᵢ` (REP)
  choose μs ξs _ hμsK hμsW hξsm hξs hXs _ using fun i =>
    hREP P (d + 1) univ (Xs i) isOpen_univ fun W hW hWc => (hfin i W hW hWc).1
  choose μs' ξs' _ hμs'K hμs'W hξs'm hξs' hXs' _ using fun i =>
    hREP P d univ (Xs i).boundary isOpen_univ fun W hW hWc => (hfin i W hW hWc).2
  -- `μᵢ(W) + μ'ᵢ(W) = M_W(Xᵢ) + M_W(∂Xᵢ) ≤ Λ_W` for open `W`
  have hsum : ∀ i, ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ →
      μs i W + μs' i W ≤ ⨆ j, ((Xs j).massOn W + (Xs j).boundary.massOn W) := fun i W hW _ => by
    rw [← hμsW i W hW, ← hμs'W i W hW]
    exact le_iSup (fun j => (Xs j).massOn W + (Xs j).boundary.massOn W) i
  -- for compact `K ⊆ B_r(0)`: `supᵢ μᵢ(K) ≤ Λ_{B_r(0)}` and `supᵢ μ'ᵢ(K) ≤ Λ_{B_r(0)}`
  have hsupK : ∀ K : Set (Euclid P), IsCompact K → K ⊆ univ →
      ⨆ i, μs i K < ∞ ∧ ⨆ i, μs' i K < ∞ := by
    intro K hK _
    obtain ⟨r, hr⟩ := hK.isBounded.subset_ball (0 : Euclid P)
    have hW := hbound _ isOpen_ball (hball r)
    exact ⟨(iSup_le fun i => (measure_mono hr).trans
        (le_self_add.trans (hsum i _ isOpen_ball (hball r)))).trans_lt hW,
      (iSup_le fun i => (measure_mono hr).trans
        (le_add_self.trans (hsum i _ isOpen_ball (hball r)))).trans_lt hW⟩
  -- Step 4: limit measures `ν`, `ν'` along a subsequence `φ = φ₁ ∘ φ₂` (T1, applied twice)
  obtain ⟨φ₁, ν, hφ₁, -, hνK, -, hνlim, -⟩ :=
    (Submission.cbr_measure_convergence_tools).1 P univ μs isOpen_univ fun K hK hKU =>
      (hsupK K hK hKU).1
  obtain ⟨φ₂, ν', hφ₂, -, hν'K, -, hν'lim, -⟩ :=
    (Submission.cbr_measure_convergence_tools).1 P univ (fun j => μs' (φ₁ j)) isOpen_univ
      fun K hK hKU => (iSup_le fun j => le_iSup (fun i => μs' i K) (φ₁ j)).trans_lt
        (hsupK K hK hKU).2
  -- a further subsequence keeps the `limsup` bound
  have hνlim' : ∀ K : Set (Euclid P), IsCompact K → K ⊆ univ →
      limsup (fun j => μs (φ₁ (φ₂ j)) K) atTop ≤ ν K := fun K hK hKU =>
    (hφ₂.tendsto_atTop.limsup_comp_le_limsup (u := fun j => μs (φ₁ j) K)).trans (hνlim K hK hKU)
  -- the subsequence still converges weakly to `X`
  have hconvφ : WeaklyConvergesOn (fun j => Xs (φ₁ (φ₂ j))) X := fun ω =>
    (hconv ω).comp (hφ₁.tendsto_atTop.comp hφ₂.tendsto_atTop)
  -- Step 5: slices `A_{j,t}` of `X_{φ j}` and `B_{j,t}` of `∂X_{φ j}`, with
  -- `M_W(Z_{j,t}) + M_W(∂Z_{j,t}) ≤ L liminf_{h↓0} h⁻¹ (μ_{φ j} + μ'_{φ j})(W ∩ {t − h < f < t})`
  -- for `Z_{j,t} = ∂A_{j,t} − B_{j,t}`
  choose A B hA hB hAB using fun j =>
    Submission.cbrsl_slice_boundary_mass_bound hSL P d univ (Xs (φ₁ (φ₂ j))) (μs (φ₁ (φ₂ j)))
      (μs' (φ₁ (φ₂ j))) (ξs (φ₁ (φ₂ j))) (ξs' (φ₁ (φ₂ j))) f L isOpen_univ (hμsK _) (hμs'K _)
      (hξsm _) (hξs'm _) (ae_of_all _ (hξs _)) (ae_of_all _ (hξs' _)) (hXs _) (hXs' _) hf
  -- Step 6: (ISP) of the `X_{φ j}`: for a.e. `t`, every `Z_{j,t}` is integer multiplicity
  have hIM : ∀ᵐ t ∂(volume : Measure ℝ), ∀ j,
      IsIntegerMultiplicity ((A j t).boundary - B j t) := by
    rw [ae_all_iff]
    intro j
    filter_upwards [hISP (φ₁ (φ₂ j)) (μs (φ₁ (φ₂ j))) (μs' (φ₁ (φ₂ j))) (ξs (φ₁ (φ₂ j)))
      (ξs' (φ₁ (φ₂ j))) (fun K hK => hμsK _ K hK (subset_univ K))
      (fun K hK => hμs'K _ K hK (subset_univ K)) (hξsm _) (hξs'm _) (ae_of_all _ (hξs _))
      (ae_of_all _ (hξs' _)) (hXs _) (hXs' _) f L hf] with t ht
    exact ht (A j t) (B j t) (hA j t) (hB j t)
  -- Step 7: good parameters (MM): for a.e. `t`,
  -- `liminfⱼ (M_{W_k}(Z_{j,t}) + M_{W_k}(∂Z_{j,t})) < ∞` for every `W_k = B_{k+1}(0)`, as
  -- `(μ_{φ j} + μ'_{φ j})(W_k) ≤ Λ_{W_k}`
  have hΛ : ∀ k : ℕ, ⨆ j, (μs (φ₁ (φ₂ j)) + μs' (φ₁ (φ₂ j)))
      (ball (0 : Euclid P) ((k : ℝ) + 1)) < ∞ := fun k =>
    (iSup_le fun j => (Measure.add_apply _ _ _).trans_le (hsum (φ₁ (φ₂ j)) _ isOpen_ball
      (hball ((k : ℝ) + 1)))).trans_lt (hbound _ isOpen_ball (hball ((k : ℝ) + 1)))
  have hgood := Submission.cbrsl_ae_liminf_lt_top (Submission.cbr_measure_convergence_tools).2.2 P
    (fun j => μs (φ₁ (φ₂ j)) + μs' (φ₁ (φ₂ j))) f L
    (fun j k t => ((A j t).boundary - B j t).massOn (ball (0 : Euclid P) ((k : ℝ) + 1)) +
      boundaryMassOn ((A j t).boundary - B j t) (ball (0 : Euclid P) ((k : ℝ) + 1)))
    hf.continuous hΛ fun j k t => hAB j _ t isOpen_ball
  -- the level sets `{f = t}` are `ν`- and `ν'`-null for all but countably many `t`
  have hlevel : ∀ ν₀ : Measure (Euclid P), (∀ K : Set (Euclid P), IsCompact K → K ⊆ univ →
      ν₀ K < ∞) → ∀ᵐ t ∂(volume : Measure ℝ), ν₀ {x | f x = t} = 0 := by
    intro ν₀ hν₀
    have : IsFiniteMeasureOnCompacts ν₀ := ⟨fun K hK => hν₀ K hK (subset_univ K)⟩
    filter_upwards [(Measure.countable_meas_level_set_pos (μ := ν₀)
      hf.continuous.measurable).ae_notMem volume] with t ht
    simpa using ht
  -- Steps 8–11: for such `t`, `Z_{j,t} ⇀ ∂A − B` (T2 for `X_{φ j}` and `∂X_{φ j}`), and
  -- `cbrsl_isIntegerMultiplicity_of_local_liminf_bounds` makes `∂A − B` integer multiplicity
  filter_upwards [hIM, hgood, hlevel ν hνK, hlevel ν' hν'K] with t hIMt hgoodt hνt hν't
  intro A' B' hA' hB'
  refine Submission.cbrsl_isIntegerMultiplicity_of_local_liminf_bounds d hCL hLOC P
    (fun j => (A j t).boundary - B j t) (A'.boundary - B') hIMt (fun η => ?_) hgoodt
  have h1 := (Submission.cbr_measure_convergence_tools).2.1 P (d + 1) univ
    (fun j => Xs (φ₁ (φ₂ j))) X (fun j => μs (φ₁ (φ₂ j))) (fun j => ξs (φ₁ (φ₂ j))) μ ν ξ f t
    isOpen_univ hf.continuous hconvφ (fun j => hμsK _) (fun j => hξsm _)
    (fun j => ae_of_all _ (hξs _)) (fun j => hXs _) (fun K hK _ => hμ K hK) hξm hξ hX hνK hνlim'
    hνt (exteriorDerivativeTestOn univ d η)
  have h2 := (Submission.cbr_measure_convergence_tools).2.1 P d univ
    (fun j => (Xs (φ₁ (φ₂ j))).boundary) X.boundary (fun j => μs' (φ₁ (φ₂ j)))
    (fun j => ξs' (φ₁ (φ₂ j))) μ' ν' ξ' f t isOpen_univ hf.continuous hconvφ.boundary
    (fun j => hμs'K _) (fun j => hξs'm _) (fun j => ae_of_all _ (hξs' _)) (fun j => hXs' _)
    (fun K hK _ => hμ' K hK) hξm' hξ' hXb hν'K hν'lim hν't η
  -- `(∂S − R)(η) = S(dη) − R(η)`
  have hval : ∀ (S : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1))
      (R : GeometricCurrentOn (univ : Set (Euclid P)) d),
      (S.boundary - R) η = S (exteriorDerivativeTestOn univ d η) - R η := fun _ _ => rfl
  show Tendsto (fun j => ((A j t).boundary - B j t) η) atTop (𝓝 ((A'.boundary - B') η))
  simp only [hval, hA, hB, hA', hB']
  exact h1.sub h2
/-- **Deformation onto the `n`-skeleton** (Simon Ch. 6, proof of the Deformation Theorem 5.1,
displays (1)–(25), chapter-06.txt lines 1405–1928), `n = m + 1`: an integer multiplicity
`T ∈ 𝒟ₙ(ℝᴾ)` with compact support and `M(T), M(∂T) < ∞` has `T − Q₀ − S₁ = ∂R₁` with `Q₀`, `R₁`
integer multiplicity, `spt Q₀` in the `n`-skeleton `L_n` of the unit cubical grid, masses at most
`c M(T)` resp. `c M(∂T)`, and supports within `√P` of `spt T` resp. `spt ∂T`.  If `n ≥ P` then
`L_n = ℝᴾ`, and `Q₀ = T`, `R₁ = S₁ = 0`.  Otherwise the good centre `a` (`cmcdt_good_center` for
the finite mass measures of `T` and `∂T`) gives `M_{d<r}(T) ≤ C r^{n+1} M(T)` and
`M_{d<r}(∂T) ≤ C r^{n+1} M(∂T)` for `d = dist(·, L*(a))`; `cmcsd_shell_decomposition` cuts `T`
into integer multiplicity shells `W_j` at radii `r_j ∈ (2^{-j-3}, 2^{-j-2})`; the retraction `ψ` of
`cmcdt_skeleton_retraction` is `(c_R/r_j)`-Lipschitz on `{d ≥ r_j}`, and its McShane extension
`φ_j` is `Λ_j`-Lipschitz, `Λ_j = max(1, √P c_R/r_j) ≤ c₄ 2^j` for `c₄ = 1 + 8√P c_R`;
`cmcsd_dyadic_series_bounds` sums the mass series, and `cmcsd_telescoping_deformation` (with the
push-forwards and homotopies of `cmcdt_lipschitz_pushforward_homotopy`, the series of
`cmcdt_im_series` and `δ = √P`) deforms and sums the shells, with
`c = (1 + √P)(2c₄)^{m+1}(1 + C)`. -/
theorem Submission.cmcdt_skeleton_deformation : (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → ∀ (P m : ℕ), ∃ c : NNReal, 1 ≤ c ∧ ∀ T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity T → IsCompact T.support → T.mass < ∞ → T.boundary.mass < ∞ → ∃ (Q₀ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R₁ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S₁ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q₀ ∧ IsIntegerMultiplicity R₁ ∧ T - Q₀ - S₁ = R₁.boundary ∧ Q₀.support ⊆ {x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} ∧ Q₀.mass ≤ c * T.mass ∧ Q₀.boundary.mass ≤ c * T.boundary.mass ∧ R₁.mass ≤ c * T.mass ∧ S₁.mass ≤ c * T.boundary.mass ∧ Q₀.support ∪ R₁.support ⊆ cthickening (Real.sqrt P) T.support ∧ Q₀.boundary.support ∪ S₁.support ⊆ cthickening (Real.sqrt P) T.boundary.support := by
  intro hVO hMR hREP hIMC hSL P m
  -- `M(0) = 0` in every degree
  have hzero : ∀ k : ℕ, (0 : GeometricCurrentOn (univ : Set (Euclid P)) k).mass = 0 := by
    intro k
    refine le_antisymm (sSup_le ?_) zero_le
    rintro _ ⟨ω, -, rfl⟩
    simp
  by_cases hPm : m + 1 < P
  swap
  · -- Step 1: for `n = m + 1 ≥ P`, `L_n = ℝᴾ` (take `s = ∅`); `Q₀ = T`, `R₁ = S₁ = 0`, `c = 1`
    have hPm' : P ≤ m + 1 := not_lt.1 hPm
    have hsc := Submission.cmcsd_support_calculus P
    refine ⟨1, le_rfl, fun T hT _ _ _ => ⟨T, 0, 0, hT,
      Submission.cmcsd_zero_isIntegerMultiplicity P (m + 2) univ, ?_,
      fun x _ => ⟨∅, by simpa using hPm', by simp⟩, by rw [ENNReal.coe_one, one_mul],
      by rw [ENNReal.coe_one, one_mul], by rw [hzero]; exact zero_le, by rw [hzero]; exact zero_le,
      ?_, ?_⟩⟩
    · ext ω
      change T ω - T ω - 0 = 0
      ring
    · rw [(hsc (m + 2)).2.2.2.1, union_empty]
      exact self_subset_cthickening _
    · rw [(hsc (m + 1)).2.2.2.1, union_empty]
      exact self_subset_cthickening _
  -- Step 2: the constants `c_R` (RET), `C` (GC); the operators `push`, `homot` (PF); (IMS)
  obtain ⟨cR, hcR, hRET⟩ := Submission.cmcdt_skeleton_retraction P m hPm
  obtain ⟨C, hGC⟩ := Submission.cmcdt_good_center P m hPm
  obtain ⟨push, homot, hPF⟩ :=
    Submission.cmcdt_lipschitz_pushforward_homotopy hVO hMR hREP hIMC P
  have hIMS := Submission.cmcdt_im_series hVO hMR hIMC P
  -- `c₄ = 1 + 8√P c_R`, `X = (2c₄)^{m+1}(1 + C)` and `c = (1 + √P) X`
  obtain ⟨c₄, hc₄⟩ : ∃ c₄ : NNReal, c₄ = 1 + 8 * NNReal.sqrt P * Real.toNNReal cR := ⟨_, rfl⟩
  obtain ⟨X, hX⟩ : ∃ X : NNReal, X = (2 * c₄) ^ (m + 1) * (1 + C) := ⟨_, rfl⟩
  have h2c₄ : 1 ≤ 2 * c₄ := by
    rw [hc₄]
    calc (1 : NNReal) ≤ 2 * 1 := by norm_num
      _ ≤ 2 * (1 + 8 * NNReal.sqrt P * Real.toNNReal cR) := mul_le_mul_right le_self_add 2
  have hX1 : 1 ≤ X := by
    rw [hX]
    exact one_le_mul_of_one_le_of_one_le (one_le_pow₀ h2c₄) le_self_add
  have hXc : X ≤ (1 + NNReal.sqrt P) * X := le_mul_of_one_le_left zero_le le_self_add
  have hYX : (2 * c₄) ^ m * (1 + C) ≤ X := by
    rw [hX]
    exact mul_le_mul_left (pow_le_pow_right₀ h2c₄ (Nat.le_succ m)) _
  have hYc : (2 * c₄) ^ m * (1 + C) ≤ (1 + NNReal.sqrt P) * X := hYX.trans hXc
  have hXcast : (2 * (c₄ : ℝ≥0∞)) ^ (m + 1) * (1 + C) = (X : ℝ≥0∞) := by
    rw [hX]
    norm_cast
  have hYcast : (2 * (c₄ : ℝ≥0∞)) ^ m * (1 + C) = (((2 * c₄) ^ m * (1 + C) : NNReal) : ℝ≥0∞) := by
    norm_cast
  have hsqrt : ENNReal.ofReal (Real.sqrt P) = (NNReal.sqrt P : ℝ≥0∞) := by
    rw [← ENNReal.ofReal_coe_nnreal, Real.coe_sqrt, NNReal.coe_natCast]
  refine ⟨(1 + NNReal.sqrt P) * X, one_le_mul_of_one_le_of_one_le le_self_add hX1,
    fun T hT hTc hTm hbTm => ?_⟩
  -- Step 3: the finite mass measures `μ_T` (IMRep, MR) and `μ_∂T` (REP)
  obtain ⟨μ, -, hμfin, -, -, -, hμW, -, -⟩ :=
    Submission.cmcsd_sh_im_mass_measure hVO hMR hIMC P (m + 1) T hT hTm
  obtain ⟨μ', -, hμ'fin, -, -, -, hμ'W, -⟩ :=
    Submission.cmcsd_sh_finite_mass_measure hVO hREP P m T.boundary hbTm
  -- the good centre `a` (GC) and the retraction `ψ` (RET) for `L*(a)`
  obtain ⟨a, ha, hdens⟩ := hGC μ μ' hμfin hμ'fin
  obtain ⟨ψ, hψL, hψLip⟩ := hRET a ha
  set Ls : Set (Euclid P) :=
    {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z}
  -- `M_{d<r}(T) = μ_T{d < r}` (`{d < r}` is open) and `M(T) = μ_T(ℝᴾ)`, likewise for `∂T`
  have hdens' : ∀ r : ℝ, 0 < r → r ≤ 1 / 4 →
      T.massOn {x | infDist x Ls < r} ≤ C * ENNReal.ofReal (r ^ (m + 2)) * T.mass ∧
        T.boundary.massOn {x | infDist x Ls < r} ≤
          C * ENNReal.ofReal (r ^ (m + 2)) * T.boundary.mass := by
    intro r hr hr4
    have hopen : IsOpen {x : Euclid P | infDist x Ls < r} :=
      isOpen_lt (continuous_infDist_pt Ls) continuous_const
    have hTμ : T.mass = μ univ := hμW univ isOpen_univ
    have hbTμ : T.boundary.mass = μ' univ := hμ'W univ isOpen_univ
    rw [hμW _ hopen, hμ'W _ hopen, hTμ, hbTμ]
    exact hdens r hr hr4
  -- Step 4: the shells `W_j`, `D_j` and slices `Z_j` at radii `r_j ∈ (2^{-j-3}, 2^{-j-2})`
  obtain ⟨r, W, D, Z, hr, hWsum, hW0, hWs, hWim, hWfin, hDfin, hZfin, hWspt, hDspt, hZspt,
      hW0m, hWm, hD0m, hDm, hZm⟩ :=
    Submission.cmcsd_shell_decomposition hVO hMR hREP hIMC hSL P m T (fun x => infDist x Ls) C
      hT hTc hTm hbTm (lipschitz_infDist_pt Ls) hdens'
  have hrpos : ∀ j, 0 < r j := fun j => (pow_pos (by norm_num) _).trans (hr j).1
  have hr4 : ∀ j, r j ≤ 1 / 4 := fun j =>
    (hr j).2.le.trans
      (calc (1 / 2 : ℝ) ^ (j + 2) ≤ (1 / 2 : ℝ) ^ 2 :=
            pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega)
        _ = 1 / 4 := by norm_num)
  have hrdec : ∀ j, r (j + 1) < r j := fun j =>
    calc r (j + 1) < (1 / 2 : ℝ) ^ (j + 1 + 2) := (hr (j + 1)).2
      _ = (1 / 2 : ℝ) ^ (j + 3) := by ring
      _ < r j := (hr j).1
  -- Step 5: `ψ` is `(c_R/r_j)`-Lipschitz on `{d ≥ r_j}`; `φ_j` is its McShane extension
  have hψon : ∀ j, LipschitzOnWith (Real.toNNReal (cR / r j)) ψ {x | r j ≤ infDist x Ls} := by
    intro j
    refine LipschitzOnWith.of_dist_le_mul fun x hx y hy => ?_
    rw [Real.coe_toNNReal _ (div_pos hcR (hrpos j)).le]
    exact hψLip (r j) (hrpos j) (hr4 j) x y hx hy
  choose φ hφ hφψ using fun j =>
    Submission.cmcsd_lipschitz_extension P {x | r j ≤ infDist x Ls} ψ _ (hψon j)
  obtain ⟨Λ, hΛ⟩ : ∃ Λ : ℕ → NNReal,
      Λ = fun j => max 1 (NNReal.sqrt P * Real.toNNReal (cR / r j)) := ⟨_, rfl⟩
  have hΛ1 : ∀ j, 1 ≤ Λ j := fun j => by
    rw [hΛ]
    exact le_max_left _ _
  have hΛmono : ∀ j, Λ j ≤ Λ (j + 1) := fun j => by
    rw [hΛ]
    exact max_le_max le_rfl (mul_le_mul_right (Real.toNNReal_le_toNNReal
      (div_le_div_of_nonneg_left hcR.le (hrpos (j + 1)) (hrdec j).le)) _)
  have hΛφ : ∀ j, LipschitzWith (Λ j) (φ j) := fun j => by
    rw [hΛ]
    exact (hφ j).weaken (le_max_right _ _)
  -- `Λ_j ≤ c₄ 2^j`, as `1/r_j < 2^{j+3}`
  have hΛc₄ : ∀ j, (Λ j : ℝ) ≤ c₄ * 2 ^ j := by
    intro j
    have h2j : (1 : ℝ) ≤ 2 ^ j := one_le_pow₀ (by norm_num)
    have hsq : (0 : ℝ) ≤ Real.sqrt P := Real.sqrt_nonneg _
    have hr8 : 1 ≤ 8 * 2 ^ j * r j := by
      have h1 : (1 / 2 : ℝ) ^ (j + 3) * (8 * 2 ^ j) = 1 := by
        rw [show (8 : ℝ) * 2 ^ j = 2 ^ (j + 3) by ring, ← mul_pow]
        norm_num
      have h2 : (1 / 2 : ℝ) ^ (j + 3) * (8 * 2 ^ j) < r j * (8 * 2 ^ j) :=
        mul_lt_mul_of_pos_right (hr j).1 (by positivity)
      linarith
    have hcRr : cR / r j ≤ 8 * cR * 2 ^ j := by
      rw [div_le_iff₀ (hrpos j)]
      nlinarith [mul_le_mul_of_nonneg_left hr8 hcR.le]
    have hΛj : (Λ j : ℝ) = max 1 (Real.sqrt P * (cR / r j)) := by
      rw [hΛ]
      simp only [NNReal.coe_max, NNReal.coe_one, NNReal.coe_mul, Real.coe_sqrt,
        NNReal.coe_natCast, Real.coe_toNNReal _ (div_pos hcR (hrpos j)).le]
    have hc₄r : (c₄ : ℝ) = 1 + 8 * Real.sqrt P * cR := by
      rw [hc₄]
      simp only [NNReal.coe_add, NNReal.coe_one, NNReal.coe_mul, NNReal.coe_ofNat,
        Real.coe_sqrt, NNReal.coe_natCast, Real.coe_toNNReal _ hcR.le]
    rw [hΛj, hc₄r]
    have h8 : (0 : ℝ) ≤ 8 * Real.sqrt P * cR * 2 ^ j := by positivity
    refine max_le (by nlinarith) ?_
    calc Real.sqrt P * (cR / r j) ≤ Real.sqrt P * (8 * cR * 2 ^ j) :=
          mul_le_mul_of_nonneg_left hcRr hsq
      _ ≤ (1 + 8 * Real.sqrt P * cR) * 2 ^ j := by nlinarith
  -- Step 6: `φ_j = ψ` on `{d ≥ r_j}`, which contains `spt W_j ∪ spt D_j ∪ spt Z_j`
  have hφeq : ∀ j x, r j ≤ infDist x Ls → φ j x = ψ x := fun j x hx => hφψ j hx
  have hZeq : ∀ j, EqOn (φ (j + 1)) (φ j) (Z j).support := by
    intro j x hx
    have hxd : infDist x Ls = r j := (hZspt j hx).2
    rw [hφeq (j + 1) x ((hrdec j).le.trans hxd.ge), hφeq j x hxd.ge]
  have hsptd : ∀ j, ∀ x ∈ (W j).support ∪ (D j).support ∪ (Z j).support,
      r j ≤ infDist x Ls := by
    intro j x hx
    rcases hx with (hx | hx) | hx
    · exact (hWspt j hx).2
    · exact (hDspt j hx).2
    · exact ((hZspt j hx).2 : infDist x Ls = r j).ge
  have hdist : ∀ j, ∀ x ∈ (W j).support ∪ (D j).support ∪ (Z j).support,
      dist (φ j x) x ≤ Real.sqrt P := by
    intro j x hx
    rw [hφeq j x (hsptd j x hx)]
    exact (hψL x ((hrpos j).trans_le (hsptd j x hx))).2
  have hLmap : ∀ j, ∀ x ∈ (W j).support, φ j x ∈
      {x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} := by
    intro j x hx
    have hxd : r j ≤ infDist x Ls := (hWspt j hx).2
    rw [hφeq j x hxd]
    exact (hψL x ((hrpos j).trans_le hxd)).1
  -- `L_n` is closed: a finite union of finite intersections of preimages of `ℤ ⊆ ℝ`
  have hcoord : ∀ i : Fin P, Continuous fun x : Euclid P => x i := fun i =>
    (EuclideanSpace.proj (𝕜 := ℝ) i).continuous
  have hZcl : IsClosed (range (Int.cast : ℤ → ℝ)) := Int.isClosedEmbedding_coe_real.isClosed_range
  have hLcl : IsClosed
      {x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} := by
    have hU :
        {x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} =
          ⋃ s : Finset (Fin P),
            {x : Euclid P | P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} := by
      ext x
      simp only [mem_ofPred_eq, mem_iUnion]
    rw [hU]
    refine isClosed_iUnion_of_finite fun s => ?_
    by_cases hs : P ≤ m + 1 + s.card
    · have hS : {x : Euclid P | P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} =
          ⋂ i ∈ s, (fun x : Euclid P => x i) ⁻¹' range (Int.cast : ℤ → ℝ) := by
        ext x
        simp only [mem_ofPred_eq, mem_iInter, mem_preimage, mem_range, hs, true_and]
        exact forall₂_congr fun i _ => exists_congr fun z => eq_comm
      rw [hS]
      exact isClosed_biInter fun i _ => hZcl.preimage (hcoord i)
    · have hS : {x : Euclid P | P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} = ∅ := by
        ext x
        simp only [mem_ofPred_eq, hs, false_and, mem_empty_iff_false]
      rw [hS]
      exact isClosed_empty
  -- Step 7: the dyadic mass series
  obtain ⟨hdy1, hdy2⟩ := Submission.cmcsd_dyadic_series_bounds c₄ Λ hΛc₄
  have hWser : ∑' j, (2 * (Λ j : ℝ≥0∞)) ^ (m + 1) * (W j).mass ≤
      (2 * (c₄ : ℝ≥0∞)) ^ (m + 1) * (1 + C) * T.mass :=
    hdy1 C T.mass (m + 1) (m + 1) (fun j => (W j).mass) le_rfl hW0m hWm
  have hDser : ∑' j, (2 * (Λ j : ℝ≥0∞)) ^ m * (D j).mass ≤
      (2 * (c₄ : ℝ≥0∞)) ^ m * (1 + C) * T.boundary.mass :=
    hdy1 C T.boundary.mass m (m + 1) (fun j => (D j).mass) (Nat.le_succ m) hD0m hDm
  have hZlim : Tendsto (fun j => (2 * (Λ j : ℝ≥0∞)) ^ m * (Z j).mass) atTop (𝓝 0) :=
    hdy2 (4 * C) T.mass m (fun j => (Z j).mass)
      (ENNReal.mul_ne_top (by norm_num) ENNReal.coe_ne_top) hTm.ne hZm
  have hWfin' : ∑' j, (2 * (Λ j : ℝ≥0∞)) ^ (m + 1) * (W j).mass < ∞ := by
    refine hWser.trans_lt ?_
    rw [hXcast]
    exact ENNReal.mul_lt_top ENNReal.coe_lt_top hTm
  have hDfin' : ∑' j, (2 * (Λ j : ℝ≥0∞)) ^ m * (D j).mass < ∞ := by
    refine hDser.trans_lt ?_
    rw [hYcast]
    exact ENNReal.mul_lt_top ENNReal.coe_lt_top hbTm
  -- Step 8: deform the shells by `φ_j` and sum (PF, IMS), with `δ = √P`
  obtain ⟨Q₀, R₁, S₁, hQim, hRim, hid, hQspt, hRspt, hbQspt, hSspt, hQm, hbQm, hRm, hSm⟩ :=
    Submission.cmcsd_telescoping_deformation hVO P m push homot hPF hIMS T W D Z φ Λ (Real.sqrt P)
      {x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z}
      T.support T.boundary.support hWsum hW0 hWs hWim hWfin hDfin hZfin hΛφ hΛ1 hΛmono hZeq hdist
      hLcl hLmap (fun j => (hWspt j).trans inter_subset_left)
      (fun j => (hDspt j).trans inter_subset_left) hWfin' hDfin' hZlim
  refine ⟨Q₀, R₁, S₁, hQim, hRim, hid, fun x hx => (hQspt hx).1, ?_, ?_, ?_, ?_,
    union_subset (fun x hx => (hQspt hx).2) hRspt, union_subset hbQspt hSspt⟩
  · -- `M(Q₀) ≤ Σ_j (2Λ_j)^{m+1} M(W_j) ≤ X M(T) ≤ c M(T)`
    calc Q₀.mass ≤ (X : ℝ≥0∞) * T.mass := hQm.trans (hWser.trans_eq (by rw [hXcast]))
      _ ≤ _ := mul_le_mul_left (ENNReal.coe_le_coe.2 hXc) _
  · -- `M(∂Q₀) ≤ Σ_j (2Λ_j)^m M(D_j) ≤ (2c₄)^m (1 + C) M(∂T) ≤ c M(∂T)`
    calc Q₀.boundary.mass ≤ (((2 * c₄) ^ m * (1 + C) : NNReal) : ℝ≥0∞) * T.boundary.mass :=
          hbQm.trans (hDser.trans_eq (by rw [hYcast]))
      _ ≤ _ := mul_le_mul_left (ENNReal.coe_le_coe.2 hYc) _
  · -- `M(R₁) ≤ √P Σ_j (2Λ_j)^{m+1} M(W_j) ≤ √P X M(T) ≤ c M(T)`
    calc R₁.mass ≤ ENNReal.ofReal (Real.sqrt P) * ((X : ℝ≥0∞) * T.mass) :=
          hRm.trans (mul_le_mul_right (hWser.trans_eq (by rw [hXcast])) _)
      _ = ((NNReal.sqrt P * X : NNReal) : ℝ≥0∞) * T.mass := by
          rw [hsqrt]
          push_cast
          ring
      _ ≤ _ := mul_le_mul_left (ENNReal.coe_le_coe.2 (mul_le_mul_left le_add_self X)) _
  · -- `M(S₁) ≤ √P Σ_j (2Λ_j)^m M(D_j) ≤ √P (2c₄)^m (1 + C) M(∂T) ≤ c M(∂T)`
    calc S₁.mass ≤ ENNReal.ofReal (Real.sqrt P) *
          ((((2 * c₄) ^ m * (1 + C) : NNReal) : ℝ≥0∞) * T.boundary.mass) :=
          hSm.trans (mul_le_mul_right (hDser.trans_eq (by rw [hYcast])) _)
      _ = ((NNReal.sqrt P * ((2 * c₄) ^ m * (1 + C)) : NNReal) : ℝ≥0∞) * T.boundary.mass := by
          rw [hsqrt]
          push_cast
          ring
      _ ≤ _ := mul_le_mul_left (ENNReal.coe_le_coe.2 (mul_le_mul' le_add_self hYX)) _
/-- **Simon Ch. 5, Theorem 5.2 with Remark 5.3 (Allard regularity), bounded mean curvature
(`p = 2n` in 5.1).**  If `z ∈ spt μ`, `μ(B̄_ρ(z)) ≤ (1 + δ₀)ωₙρⁿ` and `κρ ≤ δ₀`, then
`spt μ ∩ B_{γρ}(z)` is the graph over `B_{γρ}(0)` of a `C¹` map `u` with `u(0) = 0` and
`‖Du‖ ≤ ε`.  Parts 0, 8.1–8.9 and 9 of the proof: the base plane (`dorag_affine_approximation`),
tilt-excess decay at every point of `spt μ ∩ B_{δ₀ρ/2}(z)` (`dorag_tilt_excess_decay`; its
one-step decay contains the harmonic approximation of Part 6), the graph criterion
(`dorag_lipschitz_approximation`) and `C¹` regularity (`dorag_graph_c1_of_tilt_decay`), with
`L₀ = min{ε, 1/4}`, `δ₀ = min{δ₁, δ₂, δ₃, δ₅, t^{2n+2}}` and `γ = δ₀/16`. -/
theorem Submission.dimred_cdg_allard_bounded_curvature_graph : ∀ (n k : ℕ), 0 < n → ∀ ε : ℝ, 0 < ε → ∃ δ₀ γ : ℝ, 0 < δ₀ ∧ 0 < γ ∧ γ ≤ 1 ∧ ∀ (U W : Set (Euclid (n + k))) (R : IMRep U n) (H : Euclid (n + k) → Euclid (n + k)) (κ ρ : ℝ) (z : Euclid (n + k)), IsOpen W → W ⊆ U → 0 < ρ → closedBall z ρ ⊆ W → AEStronglyMeasurable H R.measure → (∀ x, ‖H x‖ ≤ κ) → (∀ X : Euclid (n + k) → Euclid (n + k), ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ W → R.firstVariation X = -∫ x, inner ℝ (X x) (H x) ∂R.measure) → z ∈ R.measure.support → R.measure (closedBall z ρ) ≤ ENNReal.ofReal (1 + δ₀) * unitBallVolume n * ENNReal.ofReal (ρ ^ n) → κ * ρ ≤ δ₀ → ∃ (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (u : Euclid n → Euclid k), (∀ v w, inner ℝ (ι v) (ι' w) = 0) ∧ u 0 = 0 ∧ ContDiffOn ℝ 1 u (ball 0 (γ * ρ)) ∧ (∀ v ∈ ball (0 : Euclid n) (γ * ρ), ‖fderiv ℝ u v‖ ≤ ε) ∧ R.measure.support ∩ ball z (γ * ρ) = ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) (γ * ρ)) ∩ ball z (γ * ρ) := by
  have h_db := Submission.dorag_standing_density_bounds
  have h_aa := Submission.dorag_affine_approximation
  have h_la := Submission.dorag_lipschitz_approximation
  have h_td := Submission.dorag_tilt_excess_decay
  have h_gc := Submission.dorag_graph_c1_of_tilt_decay
  intro n k hn ε hε
  -- Part 0: the constants of the children (Simon 5.2 with `p = 2n`)
  obtain ⟨δ₁, C₂, hδ₁, hδ₁8, -, hDB⟩ := h_db n k hn
  obtain ⟨δ₃, C₃, hδ₃, -, hC₃, hAA⟩ := h_aa n k hn
  obtain ⟨δ₅, β, β', C₇, hδ₅, -, hβ', hβ'β, -, -, hLA⟩ :=
    h_la n k hn (2 * C₃) (by linarith)
  obtain ⟨δ₂, C, hδ₂, -, hC, hTD⟩ := h_td n k hn
  have hC₃0 : 0 < C₃ := by linarith
  have hω_fin : unitBallVolume n ≠ ⊤ := measure_ball_lt_top.ne
  obtain ⟨ω, hω⟩ : ∃ ω : ℝ, ω = (unitBallVolume n).toReal := ⟨_, rfl⟩
  have hω0 : 0 ≤ ω := by rw [hω]; exact ENNReal.toReal_nonneg
  have hω_eq : ENNReal.ofReal ω = unitBallVolume n := by
    rw [hω, ENNReal.ofReal_toReal hω_fin]
  obtain ⟨L₀, hL₀⟩ : ∃ L₀ : ℝ, L₀ = min ε (1 / 4) := ⟨_, rfl⟩
  have hL₀0 : 0 < L₀ := by rw [hL₀]; exact lt_min hε (by norm_num)
  have hL₀ε : L₀ ≤ ε := by rw [hL₀]; exact min_le_left _ _
  have hL₀4 : L₀ ≤ 1 / 4 := by rw [hL₀]; exact min_le_right _ _
  obtain ⟨A, hA⟩ : ∃ A : ℝ, A = (2 * C + 4 * ω * C) * 2 ^ n * C₃ := ⟨_, rfl⟩
  have hA0 : 0 ≤ A := by rw [hA]; positivity
  obtain ⟨t, ht⟩ : ∃ t : ℝ, t = β' * L₀ / (A + 1) := ⟨_, rfl⟩
  have hA1 : A + 1 ≠ 0 := by positivity
  have ht0 : 0 < t := by rw [ht]; positivity
  have htA : (A + 1) * t = β' * L₀ := by rw [ht]; field_simp
  have htβ' : t ≤ β' * L₀ := by have := mul_nonneg hA0 ht0.le; linarith
  have htβ : t ≤ β * L₀ := htβ'.trans (by gcongr)
  have hAt : A * t ^ 2 ≤ β' ^ 2 * L₀ ^ 2 := by
    calc A * t ^ 2 ≤ (A + 1) * t ^ 2 := by have := sq_nonneg t; linarith
      _ = β' * L₀ * t := by rw [← htA]; ring
      _ ≤ β' * L₀ * (β' * L₀) := by gcongr
      _ = β' ^ 2 * L₀ ^ 2 := by ring
  obtain ⟨δ₀, hδ₀⟩ : ∃ δ₀ : ℝ,
      δ₀ = min δ₁ (min δ₂ (min δ₃ (min δ₅ (t ^ (2 * n + 2))))) := ⟨_, rfl⟩
  have hδ₀0 : 0 < δ₀ := by
    rw [hδ₀]; exact lt_min hδ₁ (lt_min hδ₂ (lt_min hδ₃ (lt_min hδ₅ (by positivity))))
  have hδ₀δ₁ : δ₀ ≤ δ₁ := by rw [hδ₀]; exact min_le_left _ _
  have hδ₀δ₂ : δ₀ ≤ δ₂ := by rw [hδ₀]; exact (min_le_right _ _).trans (min_le_left _ _)
  have hδ₀δ₃ : δ₀ ≤ δ₃ := by
    rw [hδ₀]; exact (min_le_right _ _).trans ((min_le_right _ _).trans (min_le_left _ _))
  have hδ₀δ₅ : δ₀ ≤ δ₅ := by
    rw [hδ₀]
    exact (min_le_right _ _).trans
      ((min_le_right _ _).trans ((min_le_right _ _).trans (min_le_left _ _)))
  have hδ₀t : δ₀ ≤ t ^ (2 * n + 2) := by
    rw [hδ₀]
    exact (min_le_right _ _).trans
      ((min_le_right _ _).trans ((min_le_right _ _).trans (min_le_right _ _)))
  have hδ₀8 : δ₀ ≤ 1 / 8 := hδ₀δ₁.trans hδ₁8
  have hδ₀1 : δ₀ ≤ 1 := by linarith
  -- `α = 1/(2n+2)` and `δ₀ ≤ δ₀ ^ α ≤ t`
  have hα0 : (0 : ℝ) < (1 : ℝ) / (2 * (n : ℝ) + 2) := by positivity
  have hα1 : (1 : ℝ) / (2 * (n : ℝ) + 2) ≤ 1 := by
    rw [div_le_one (by positivity)]; have : (0 : ℝ) ≤ n := Nat.cast_nonneg n; linarith
  have hd0 : 0 < δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2)) := Real.rpow_pos_of_pos hδ₀0 _
  have hδ₀d : δ₀ ≤ δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2)) :=
    Real.self_le_rpow_of_le_one hδ₀0.le hδ₀1 hα1
  have hdt : δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2)) ≤ t := by
    calc δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2))
        ≤ (t ^ (2 * n + 2)) ^ ((1 : ℝ) / (2 * (n : ℝ) + 2)) :=
          Real.rpow_le_rpow hδ₀0.le hδ₀t hα0.le
      _ = t := by
          rw [show (1 : ℝ) / (2 * (n : ℝ) + 2) = ((2 * n + 2 : ℕ) : ℝ)⁻¹ by push_cast; ring]
          exact Real.pow_rpow_inv_natCast ht0.le (by omega)
  -- `E₀ = 2ⁿC₃δ₀^{2α}` bounds every normalized tilt-excess `E_*` below (Simon 5.2, (1))
  obtain ⟨E₀, hE₀⟩ : ∃ E₀ : ℝ,
      E₀ = 2 ^ n * C₃ * (δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2))) ^ 2 := ⟨_, rfl⟩
  have hE₀0 : 0 ≤ E₀ := by rw [hE₀]; positivity
  have hdE₀ : (δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2))) ^ 2 ≤ E₀ := by
    rw [hE₀]
    have h2n : (1 : ℝ) ≤ 2 ^ n := one_le_pow₀ (by norm_num)
    exact le_mul_of_one_le_left (sq_nonneg _) (one_le_mul_of_one_le_of_one_le h2n hC₃)
  have hAE₀ : A * (δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2))) ^ 2 ≤ β' ^ 2 * L₀ ^ 2 :=
    (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hd0.le hdt 2) hA0).trans hAt
  refine ⟨δ₀, δ₀ / 16, hδ₀0, by positivity, by linarith, ?_⟩
  intro U W R H κ ρ z hW hWU hρ hzρ hH hHκ hMC hz hmass hκρ
  have hκ0 : 0 ≤ κ := (norm_nonneg _).trans (hHκ 0)
  obtain ⟨hDBa, -, -, -⟩ :=
    hDB δ₀ hδ₀0 hδ₀δ₁ U W R H κ ρ z hW hWU hρ hzρ hH hHκ hMC hz hmass hκρ
  have hδρ : 0 < δ₀ * ρ := mul_pos hδ₀0 hρ
  have hδρ8 : δ₀ * ρ ≤ ρ / 8 := by
    have := mul_le_mul_of_nonneg_right hδ₀8 hρ.le; linarith
  have hzmem : ∀ r : ℝ, 0 ≤ r → z ∈ R.measure.support ∩ closedBall z r := fun r hr =>
    ⟨hz, mem_closedBall_self hr⟩
  -- (8.1) the base plane `T₀`: affine approximation at `(z, 2δ₀ρ)`
  obtain ⟨T₀, hT₀n, hT₀a, hT₀b⟩ := hAA δ₀ hδ₀0 hδ₀δ₃ U W R H κ ρ z hW hWU hρ hzρ hH hHκ hMC
    hz hmass hκρ z (hzmem _ (by positivity)) (2 * δ₀ * ρ) (by positivity) le_rfl
  rw [show 2 * δ₀ * ρ / 2 = δ₀ * ρ by ring] at hT₀b
  -- (8.2–8.3) tilt-excess decay at every point of `spt μ ∩ B_{δ₀ρ/2}(z)`, with `E_* ≤ E₀`
  have hdecay : ∀ y ∈ R.measure.support ∩ closedBall z (δ₀ * ρ / 2),
      ∃ S : Submodule ℝ (Euclid (n + k)), Module.finrank ℝ S = n ∧
        (∀ s : ℝ, 0 < s → s ≤ δ₀ * ρ / 2 →
          ∫⁻ x in closedBall y s, ENNReal.ofReal (∑ i : Fin (n + k),
            ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) -
              S.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure ≤
            ENNReal.ofReal (C * (s / (δ₀ * ρ / 2)) * s ^ n * E₀)) ∧
        ENNReal.ofReal (∑ i : Fin (n + k),
          ‖S.starProjection (EuclideanSpace.single i (1 : ℝ)) -
            T₀.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ≤
          ENNReal.ofReal (C * E₀) := by
    intro y hy
    have hyz : dist y z ≤ δ₀ * ρ / 2 := mem_closedBall.1 hy.2
    obtain ⟨S, hSn, hS1, hS2⟩ := hTD δ₀ hδ₀0 hδ₀δ₂ U W R H κ ρ z hW hWU hρ hzρ hH hHκ hMC hz
      hmass hκρ y ⟨hy.1, closedBall_subset_closedBall (by linarith) hy.2⟩ (δ₀ * ρ / 2) T₀
      (by positivity) (by linarith) hT₀n
    have hE : max (ENNReal.ofReal (1 / (δ₀ * ρ / 2) ^ n) *
        ∫⁻ x in closedBall y (δ₀ * ρ / 2), ENNReal.ofReal (∑ i : Fin (n + k),
          ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) -
            T₀.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure)
        (ENNReal.ofReal (κ ^ 2 * (δ₀ * ρ / 2) ^ 2 / δ₀)) ≤ ENNReal.ofReal E₀ := by
      apply max_le
      · calc _ ≤ ENNReal.ofReal (1 / (δ₀ * ρ / 2) ^ n) * ENNReal.ofReal
              (C₃ * (δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2))) ^ 2 * (δ₀ * ρ) ^ n) := by
              gcongr
              exact (lintegral_mono_set (closedBall_subset_closedBall' (by linarith))).trans
                hT₀b
          _ = ENNReal.ofReal E₀ := by
              rw [← ENNReal.ofReal_mul (by positivity), hE₀]
              congr 1
              rw [div_pow, one_div_div, div_mul_eq_mul_div, div_eq_iff (by positivity)]
              ring
      · apply ENNReal.ofReal_le_ofReal
        rw [div_le_iff₀ hδ₀0]
        have hκσ : κ * (δ₀ * ρ / 2) ≤ δ₀ ^ 2 / 2 := by
          linarith [mul_le_mul_of_nonneg_right hκρ hδ₀0.le]
        calc κ ^ 2 * (δ₀ * ρ / 2) ^ 2 = (κ * (δ₀ * ρ / 2)) ^ 2 := by ring
          _ ≤ (δ₀ ^ 2 / 2) ^ 2 := pow_le_pow_left₀ (by positivity) hκσ 2
          _ ≤ δ₀ ^ 2 * δ₀ := by
              linarith [pow_pos hδ₀0 3, mul_le_mul_of_nonneg_left hδ₀1 (pow_pos hδ₀0 3).le]
          _ ≤ E₀ * δ₀ := by
              gcongr
              exact (pow_le_pow_left₀ hδ₀0.le hδ₀d 2).trans hdE₀
    refine ⟨S, hSn, fun s hs hsσ => ?_, ?_⟩
    · calc _ ≤ _ := hS1 s hs hsσ
        _ ≤ ENNReal.ofReal (C * (s / (δ₀ * ρ / 2)) * s ^ n) * ENNReal.ofReal E₀ := by gcongr
        _ = _ := (ENNReal.ofReal_mul (by positivity)).symm
    · calc _ ≤ _ := hS2
        _ ≤ ENNReal.ofReal C * ENNReal.ofReal E₀ := by gcongr
        _ = _ := (ENNReal.ofReal_mul hC.le).symm
  -- pointwise `|p_x − p_T|² ≤ 2|p_x − p_S|² + 2|p_S − p_T|²`
  have hsplit : ∀ P Q S : Submodule ℝ (Euclid (n + k)),
      ENNReal.ofReal (∑ i : Fin (n + k), ‖P.starProjection (EuclideanSpace.single i (1 : ℝ)) -
        Q.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ≤
      2 * ENNReal.ofReal (∑ i : Fin (n + k),
        ‖P.starProjection (EuclideanSpace.single i (1 : ℝ)) -
          S.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) +
      2 * ENNReal.ofReal (∑ i : Fin (n + k),
        ‖S.starProjection (EuclideanSpace.single i (1 : ℝ)) -
          Q.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) := by
    intro P Q S
    have key : ∀ a b c : Euclid (n + k),
        ‖a - c‖ ^ 2 ≤ 2 * ‖a - b‖ ^ 2 + 2 * ‖b - c‖ ^ 2 := by
      intro a b c
      have h1 := norm_sub_le_norm_sub_add_norm_sub a b c
      have h2 := pow_le_pow_left₀ (norm_nonneg _) h1 2
      linarith [sq_nonneg (‖a - b‖ - ‖b - c‖)]
    have hsum : ∑ i : Fin (n + k), ‖P.starProjection (EuclideanSpace.single i (1 : ℝ)) -
          Q.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2 ≤
        2 * ∑ i : Fin (n + k), ‖P.starProjection (EuclideanSpace.single i (1 : ℝ)) -
          S.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2 +
        2 * ∑ i : Fin (n + k), ‖S.starProjection (EuclideanSpace.single i (1 : ℝ)) -
          Q.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2 := by
      rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
      exact Finset.sum_le_sum fun i _ => key _ _ _
    have h := ENNReal.ofReal_le_ofReal hsum
    rw [ENNReal.ofReal_add (by positivity) (by positivity), ENNReal.ofReal_mul (by positivity),
      ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_ofNat] at h
    exact h
  -- (8.4) hypothesis of the graph criterion (Simon 5.2.7) for `T₀` on `B_{δ₀ρ/2}(z)`
  have h5Bhyp : ∀ y ∈ R.measure.support ∩ closedBall z (δ₀ * ρ / 2), ∀ t' : ℝ, 0 < t' →
      t' ≤ δ₀ * ρ / 2 →
      ∫⁻ x in closedBall y t', ENNReal.ofReal (∑ i : Fin (n + k),
        ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) -
          T₀.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure ≤
        ENNReal.ofReal (β' ^ 2 * L₀ ^ 2 * t' ^ n) := by
    intro y hy t' ht'0 ht'σ
    obtain ⟨S, -, hS1, hS2⟩ := hdecay y hy
    have hball : R.measure (closedBall y t') ≤ ENNReal.ofReal (2 * ω * t' ^ n) := by
      refine (hDBa y ?_ t' ht'0 (by linarith)).trans (le_of_eq ?_)
      · exact closedBall_subset_closedBall (by linarith) hy.2
      · rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by norm_num), hω_eq,
          ENNReal.ofReal_ofNat]
    refine (lintegral_mono fun x => hsplit (approxTangentPlane n R.carrier x) T₀ S).trans ?_
    rw [lintegral_add_right _ measurable_const, setLIntegral_const,
      lintegral_const_mul' _ _ (by simp)]
    refine (add_le_add (mul_le_mul_right (hS1 t' ht'0 ht'σ) 2)
      (mul_le_mul' (mul_le_mul_right hS2 2) hball)).trans ?_
    have hreal : 2 * (C * (t' / (δ₀ * ρ / 2)) * t' ^ n * E₀) +
        2 * (C * E₀) * (2 * ω * t' ^ n) ≤ β' ^ 2 * L₀ ^ 2 * t' ^ n := by
      have hq : t' / (δ₀ * ρ / 2) ≤ 1 := div_le_one_of_le₀ ht'σ (by positivity)
      have hX : 0 ≤ 2 * C * E₀ * t' ^ n := by positivity
      have hkey : A * (δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2))) ^ 2 * t' ^ n -
          (2 * (C * (t' / (δ₀ * ρ / 2)) * t' ^ n * E₀) + 2 * (C * E₀) * (2 * ω * t' ^ n)) =
          2 * C * E₀ * t' ^ n * (1 - t' / (δ₀ * ρ / 2)) := by
        rw [hA, hE₀]; ring
      have := mul_nonneg hX (sub_nonneg.2 hq)
      have := mul_le_mul_of_nonneg_right hAE₀ (pow_nonneg ht'0.le n)
      linarith
    have h := ENNReal.ofReal_le_ofReal hreal
    rw [ENNReal.ofReal_add (by positivity) (by positivity),
      ENNReal.ofReal_mul (p := 2) (q := C * (t' / (δ₀ * ρ / 2)) * t' ^ n * E₀) (by norm_num),
      ENNReal.ofReal_mul (p := 2 * (C * E₀)) (q := 2 * ω * t' ^ n) (by positivity),
      ENNReal.ofReal_mul (p := 2) (q := C * E₀) (by norm_num), ENNReal.ofReal_ofNat] at h
    exact h
  -- (8.4) Lipschitz approximation and graph criterion at `(z, δ₀ρ, T₀, L₀)`
  obtain ⟨ι, ι', f, hιι', -, hfL, -, -, h5B⟩ := hLA δ₀ hδ₀0 hδ₀δ₅ U W R H κ ρ z hW hWU hρ hzρ
    hH hHκ hMC hz hmass hκρ z (hzmem _ (by positivity)) (δ₀ * ρ) L₀ T₀ hδρ le_rfl hT₀n hL₀0
    (by linarith) (hdt.trans htβ)
    (hT₀b.trans (ENNReal.ofReal_le_ofReal (by gcongr; linarith)))
    (fun x hx => (hT₀a x ⟨hx.1, closedBall_subset_closedBall (by linarith) hx.2⟩).trans
      (le_of_eq (by ring)))
  have hgraph := h5B h5Bhyp
  -- `|v| ≤ |ιv + ι'w|`
  have hnorm : ∀ v w, ‖v‖ ≤ ‖ι v + ι' w‖ := by
    intro v w
    have h : ‖ι v + ι' w‖ ^ 2 = ‖v‖ ^ 2 + ‖w‖ ^ 2 := by
      rw [norm_add_sq_real, hιι', LinearIsometry.norm_map, LinearIsometry.norm_map]; ring
    refine (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).1 ?_
    rw [h]; linarith [sq_nonneg ‖w‖]
  -- `f(0) = 0`, since `z ∈ spt μ`
  have hf0 : f 0 = 0 := by
    have hzg : z ∈ range (fun v => z + ι v + ι' (f v)) ∩ closedBall z (δ₀ * ρ / 8) := by
      rw [← hgraph]; exact hzmem _ (by positivity)
    obtain ⟨v₀, hv₀⟩ := hzg.1
    have hsum : ι v₀ + ι' (f v₀) = 0 := by
      have h : z + (ι v₀ + ι' (f v₀)) = z + 0 := by rw [← add_assoc, add_zero]; exact hv₀
      exact add_left_cancel h
    have hv : v₀ = 0 := by
      have := hnorm v₀ (f v₀)
      rw [hsum, norm_zero] at this
      exact norm_le_zero_iff.1 this
    subst hv
    have h1 : ι' (f 0) = 0 := by simpa using hsum
    rw [← norm_eq_zero, ← LinearIsometry.norm_map ι' (f 0), h1, norm_zero]
  -- (8.5–8.8) `f` is `C¹` on `B_{δ₀ρ/16}(0)`
  have hC1 : ContDiffOn ℝ 1 f (ball (0 : Euclid n) (δ₀ * ρ / 8 / 2)) :=
    h_gc n k hn U W R H κ ι ι' f z (δ₀ * ρ / 8) (δ₀ * ρ / 2) (C * E₀ / (δ₀ * ρ / 2)) hW hWU
      hH hHκ hMC hιι' (fun v w => (hfL v w).trans (by gcongr)) hf0 (by positivity)
      (by positivity) ((closedBall_subset_closedBall (by linarith)).trans hzρ) hgraph
      (fun ξ hξ => by
        obtain ⟨S, hSn, hS1, -⟩ :=
          hdecay ξ ⟨hξ.1, closedBall_subset_closedBall (by linarith) hξ.2⟩
        exact ⟨S, hSn, fun s hs hsσ => (hS1 s hs hsσ).trans (le_of_eq (by congr 1; ring))⟩)
  -- (8.9, 9) conclusion with `u := f`
  have hlip : LipschitzWith (Real.toNNReal L₀) f := LipschitzWith.of_dist_le_mul fun v w => by
    rw [dist_eq_norm, dist_eq_norm, Real.coe_toNNReal _ hL₀0.le]; exact hfL v w
  have hball8 : ball z (δ₀ / 16 * ρ) ⊆ closedBall z (δ₀ * ρ / 8) :=
    ball_subset_closedBall.trans (closedBall_subset_closedBall (by linarith))
  refine ⟨ι, ι', f, hιι', hf0, ?_, fun v _ => ?_, ?_⟩
  · rw [show δ₀ / 16 * ρ = δ₀ * ρ / 8 / 2 by ring]; exact hC1
  · exact (norm_fderiv_le_of_lipschitz ℝ hlip).trans
      (by rw [Real.coe_toNNReal _ hL₀0.le]; exact hL₀ε)
  · ext x
    constructor
    · rintro ⟨hx, hxb⟩
      have hx' : x ∈ range (fun v => z + ι v + ι' (f v)) ∩ closedBall z (δ₀ * ρ / 8) := by
        rw [← hgraph]; exact ⟨hx, hball8 hxb⟩
      obtain ⟨⟨v, rfl⟩, -⟩ := hx'
      refine ⟨⟨v, ?_, rfl⟩, hxb⟩
      rw [mem_ball, dist_eq_norm] at hxb
      rw [mem_ball_zero_iff]
      calc ‖v‖ ≤ ‖ι v + ι' (f v)‖ := hnorm v (f v)
        _ = ‖z + ι v + ι' (f v) - z‖ := by congr 1; abel
        _ < _ := hxb
    · rintro ⟨⟨v, -, rfl⟩, hxb⟩
      have hx' : z + ι v + ι' (f v) ∈ R.measure.support ∩ closedBall z (δ₀ * ρ / 8) := by
        rw [hgraph]; exact ⟨⟨v, rfl⟩, hball8 hxb⟩
      exact ⟨hx'.1, hxb⟩

namespace Submission

end Submission

/-- **Zero and negated currents** (Simon Ch. 6, 2.4–2.5 and 3.1).
(a) The empty triple `(∅, 0, 0)` in `U` represents `0`, so `0` is integer multiplicity.
(b) If `X` is integer multiplicity, so is `0 − X` (integer multiplicity calculus (c)).
(c) `(0 − X)(ω) = X(−ω)`, and `ω ↦ −ω` permutes the admissible forms for `M_G`
(`tsupport (−ω) = tsupport ω`, `|−ω(x)| = |ω(x)|`), so `M_G(0 − X) = M_G(X)`.
(d) If `s > 0`, `M(X) < ∞` and `|ω(x)| ≤ s`, then `±s⁻¹ω` are admissible for `M(X) = M_U(X)`
(the coefficient norm is absolutely homogeneous), so `|X(ω)| = s |X(s⁻¹ω)| ≤ s M(X)`. -/
theorem Submission.dor_lmb_fcd_sd_zero_neg : ∀ (P k : ℕ) (U : Set (Euclid P)), IsOpen U → IsIntegerMultiplicity (0 : GeometricCurrentOn U k) ∧ (∀ X : GeometricCurrentOn U k, IsIntegerMultiplicity X → IsIntegerMultiplicity (0 - X)) ∧ (∀ (X : GeometricCurrentOn U k) (G : Set (Euclid P)), (0 - X).massOn G = X.massOn G) ∧ ∀ (X : GeometricCurrentOn U k) (ω : TestFormOn U k) (s : ℝ), 0 < s → X.mass ≠ ∞ → (∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) k) x) ≤ s) → |X ω| ≤ s * X.mass.toReal := by
  intro P k U hU
  -- (a) the empty triple `(∅, 0, 0)` in `U` represents the zero current
  have h0 : IsIntegerMultiplicity (0 : GeometricCurrentOn U k) := by
    refine ⟨{ carrier := ∅
              mult := fun _ => 0
              orient := fun _ => 0
              measurableSet_carrier := MeasurableSet.empty
              carrier_subset := empty_subset U
              rectifiable :=
                Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty
              measurable_mult := measurable_const
              mult_pos := fun x hx => absurd hx (notMem_empty x)
              locallyIntegrable_mult := fun K _ _ => by simp
              aestronglyMeasurable_orient := aestronglyMeasurable_const
              orients := by simp }, fun ω => ?_⟩
    simp [IMRep.action]
  -- `(0 − X)(ω) = −X(ω) = X(−ω)`
  have hsub : ∀ (X : GeometricCurrentOn U k) (ω : TestFormOn U k), (0 - X) ω = X (-ω) := by
    intro X ω
    show (0 : GeometricCurrentOn U k) ω - X ω = X (-ω)
    rw [GeometricCurrentOn.zero_apply, zero_sub]
    exact (map_neg X.toCurrent ω).symm
  -- `ω ↦ −ω` preserves admissibility: `tsupport (−ω) = tsupport ω`, `|−ω(x)| = |ω(x)|`
  have hadm : ∀ (G : Set (Euclid P)) (ω : TestFormOn U k), ω ∈ massAdmissibleOn U k G →
      -ω ∈ massAdmissibleOn U k G := by
    intro G ω hω
    refine ⟨?_, fun x => ?_⟩
    · simpa using hω.1
    · simpa using hω.2 x
  -- (b) `0 − X` is integer multiplicity, by (IMC)(c)
  refine ⟨h0, fun X hX => Submission.cmc_imRep_locality_restrict_sub.2.2.1 P k U 0 X hU h0 hX,
    fun X G => ?_, ?_⟩
  · -- (c) `M_G(0 − X) = M_G(X)`
    apply le_antisymm
    · apply sSup_le
      rintro r ⟨ω, hω, rfl⟩
      show ENNReal.ofReal ((0 - X) ω) ≤ X.massOn G
      rw [hsub]
      exact X.le_massOn (hadm G ω hω)
    · apply sSup_le
      rintro r ⟨ω, hω, rfl⟩
      show ENNReal.ofReal (X ω) ≤ (0 - X).massOn G
      have h := (0 - X).le_massOn (hadm G ω hω)
      rwa [hsub, show -(-ω) = ω from neg_neg ω] at h
  · -- (d) `|X(ω)| ≤ s M(X)` when `|ω(x)| ≤ s`
    intro X ω s hs hX hω
    -- homogeneity of the coefficient norm
    have hsmul : ∀ (c : ℝ) (α : Covector (Euclid P) k),
        covectorEuclideanNorm (c • α) = |c| * covectorEuclideanNorm α := by
      intro c α
      simp only [covectorEuclideanNorm, ContinuousAlternatingMap.smul_apply, smul_eq_mul, mul_pow]
      rw [← Real.sqrt_sq_eq_abs, ← Real.sqrt_mul (sq_nonneg c), Finset.mul_sum]
      congr 1
      refine Finset.sum_congr rfl fun I _ => ?_
      split_ifs <;> ring
    -- `s⁻¹ω` is admissible for `M(X) = M_U(X)`
    have hω' : s⁻¹ • ω ∈ massAdmissibleOn U k U := by
      refine ⟨(s⁻¹ • ω).property.2, fun x => ?_⟩
      rw [Submodule.coe_smul, Pi.smul_apply, hsmul, abs_of_pos (inv_pos.2 hs)]
      calc s⁻¹ * covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) k) x) ≤ s⁻¹ * s :=
            mul_le_mul_of_nonneg_left (hω x) (inv_nonneg.2 hs.le)
        _ = 1 := inv_mul_cancel₀ hs.ne'
    have h1 : X (s⁻¹ • ω) ≤ X.mass.toReal :=
      (ENNReal.ofReal_le_iff_le_toReal hX).1 (X.le_massOn hω')
    have h2 : X (-(s⁻¹ • ω)) ≤ X.mass.toReal :=
      (ENNReal.ofReal_le_iff_le_toReal hX).1 (X.le_massOn (hadm U _ hω'))
    have hlin : X (s⁻¹ • ω) = s⁻¹ * X ω := map_smul X.toCurrent s⁻¹ ω
    have hneg : X (-(s⁻¹ • ω)) = -X (s⁻¹ • ω) := map_neg X.toCurrent _
    have habs : |X (s⁻¹ • ω)| ≤ X.mass.toReal := abs_le.2 ⟨by linarith, h1⟩
    calc |X ω| = |s * X (s⁻¹ • ω)| := by rw [hlin, ← mul_assoc, mul_inv_cancel₀ hs.ne', one_mul]
      _ = s * |X (s⁻¹ • ω)| := by rw [abs_mul, abs_of_pos hs]
      _ ≤ s * X.mass.toReal := mul_le_mul_of_nonneg_left habs hs.le

/-- **Integer combinations of oriented grid cubes in `ℝⁿ` are integer multiplicity** (Simon Ch. 6,
2.2, 2.4 and 3.2(1)), `n = m + 1`.  Each grid cube `G_z = ρ(z + [0, 1]ⁿ)` is closed, hence Borel,
so `[[G_z]](ω) = ∫_{G_z} ω(x)(e₀, …, eₘ) dHⁿ(x)` is an integer multiplicity current; the finite
integer combination `Σ_{z ∈ s} β_z [[G_z]]` is integer multiplicity (differences of integer
multiplicity currents being integer multiplicity) and agrees with `X` on every test form. -/
theorem Submission.dor_lmb_fc_dtop_cube_chain_im : ∀ (m : ℕ) (ρ : ℝ) (s : Finset (Fin (m + 1) → ℤ)) (β : (Fin (m + 1) → ℤ) → ℤ) (X : GeometricCurrentOn (univ : Set (Euclid (m + 1))) (m + 1)), 0 < ρ → (∀ ω : TestFormOn (univ : Set (Euclid (m + 1))) (m + 1), X ω = ∑ z ∈ s, (β z : ℝ) * ∫ x in {x : Euclid (m + 1) | ∀ i : Fin (m + 1), ρ * z i ≤ x i ∧ x i ≤ ρ * (z i + 1)}, (ω : DifferentialForm (Euclid (m + 1)) (m + 1)) x (fun k => EuclideanSpace.single k (1 : ℝ)) ∂μHE[m + 1]) → IsIntegerMultiplicity X := by
  intro m ρ s β X _ hX
  -- the grid cube `G_z = ρ(z + [0, 1]ⁿ)` is closed, hence Borel
  have hG : ∀ z : Fin (m + 1) → ℤ, MeasurableSet
      {x : Euclid (m + 1) | ∀ i : Fin (m + 1), ρ * z i ≤ x i ∧ x i ≤ ρ * (z i + 1)} := by
    intro z
    refine IsClosed.measurableSet ?_
    simp only [ofPred_forall, ofPred_and]
    exact isClosed_iInter fun i =>
      (isClosed_le continuous_const (PiLp.continuous_apply _ _ i)).inter
        (isClosed_le (PiLp.continuous_apply _ _ i) continuous_const)
  -- the integer multiplicity cube currents `[[G_z]]`
  choose A hA hAω using fun z => Submission.dor_lmb_fc_dtop_cci_borel_current_im (m + 1) _ (hG z)
  -- `Y = Σ_{z ∈ s} β_z [[G_z]]` is integer multiplicity
  obtain ⟨Y, hY, hYω, -⟩ := Submission.cbr_cc_current_algebra.2.2
    Submission.cmc_imRep_locality_restrict_sub.2.2.1 (m + 1) (m + 1) univ (Fin (m + 1) → ℤ) s A β
    isOpen_univ fun z _ => hA z
  -- `X = Y` on every test form
  have hXY : X = Y := GeometricCurrentOn.ext fun ω => by
    rw [hX ω, hYω ω]
    exact Finset.sum_congr rfl fun z _ => by rw [hAω]
  exact hXY ▸ hY

/-- **Shell-wise push-forwards and homotopies telescope** (Simon Ch. 6, proof of 5.1, with the
homotopy formula 2.25).  Let `push`, `homot` satisfy, on integer multiplicity currents vanishing
off a compact set, PF(1) `push(id, X) = X`, PF(2) linearity, PF(3) locality and PF(5)
`∂push(F, X) = push(F, ∂X)`, `push(G, X) − push(F, X) − homot(F, G, ∂X) = ∂homot(F, G, X)`.
For shells `Wⱼ` with `∂W₀ = D₀ − Z₀`, `∂Wⱼ₊₁ = Dⱼ₊₁ + Zⱼ − Zⱼ₊₁` and maps with `φⱼ₊₁ = φⱼ` on
`Eⱼ`, writing `hⱼ = homot(id, φⱼ, ·)`:
(S1) `Σ_{j≤N} (push(φⱼ, Wⱼ) − Wⱼ − ∂hⱼ(Wⱼ)) = Σ_{j≤N} hⱼ(Dⱼ) − h_N(Z_N)`;
(S2) `Σ_{j≤N} ∂push(φⱼ, Wⱼ) = Σ_{j≤N} push(φⱼ, Dⱼ) − push(φ_N, Z_N)`.

On a shell, `∂X = (D′ − (0 − Z′)) − Z″` is integer multiplicity (zero_neg, (IMC)(c)), so PF(5),
PF(1) and three applications of PF(2) give the shell identities; PF(3) identifies the
`Zⱼ`-terms of consecutive shells, and the sums telescope by induction on `N`. -/
theorem Submission.dor_lmb_fcd_sd_telescoping : ∀ (P m : ℕ) (push : ∀ k : ℕ, (Euclid P → Euclid P) → GeometricCurrentOn (univ : Set (Euclid P)) k → GeometricCurrentOn (univ : Set (Euclid P)) k) (homot : ∀ k : ℕ, (Euclid P → Euclid P) → (Euclid P → Euclid P) → GeometricCurrentOn (univ : Set (Euclid P)) k → GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)), (∀ (k : ℕ) (E : Set (Euclid P)) (X : GeometricCurrentOn (univ : Set (Euclid P)) k), IsCompact E → IsIntegerMultiplicity X → (∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) (E) → X ω = 0) → push k (fun x => x) X = X) → (∀ (k : ℕ) (Λ : NNReal) (F G : Euclid P → Euclid P) (E : Set (Euclid P)) (X Y : GeometricCurrentOn (univ : Set (Euclid P)) k), LipschitzWith Λ F → LipschitzWith Λ G → IsCompact E → IsIntegerMultiplicity X → IsIntegerMultiplicity Y → (∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) (E) → X ω = 0) → (∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) (E) → Y ω = 0) → push k F (X - Y) = push k F X - push k F Y ∧ homot k F G (X - Y) = homot k F G X - homot k F G Y) → (∀ (k : ℕ) (Λ : NNReal) (F G F' G' : Euclid P → Euclid P) (E : Set (Euclid P)) (X : GeometricCurrentOn (univ : Set (Euclid P)) k), LipschitzWith Λ F → LipschitzWith Λ G → LipschitzWith Λ F' → LipschitzWith Λ G' → IsCompact E → IsIntegerMultiplicity X → (∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) (E) → X ω = 0) → EqOn F F' E → EqOn G G' E → push k F X = push k F' X ∧ homot k F G X = homot k F' G' X) → (∀ (k : ℕ) (Λ : NNReal) (F G : Euclid P → Euclid P) (E : Set (Euclid P)) (X : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)), LipschitzWith Λ F → LipschitzWith Λ G → IsCompact E → IsIntegerMultiplicity X → IsIntegerMultiplicity X.boundary → (∀ ω : TestFormOn (univ : Set (Euclid P)) (k + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (k + 1))) (E) → X ω = 0) → (push (k + 1) F X).boundary = push k F X.boundary ∧ push (k + 1) G X - push (k + 1) F X - homot k F G X.boundary = (homot (k + 1) F G X).boundary) → ∀ (E : ℕ → Set (Euclid P)) (φ : ℕ → Euclid P → Euclid P) (Λ : ℕ → NNReal) (W : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (D Z : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) m), (∀ j, IsCompact (E j)) → (∀ j, E j ⊆ E (j + 1)) → (∀ j, LipschitzWith (Λ j) (φ j)) → (∀ j, 1 ≤ Λ j) → (∀ j, Λ j ≤ Λ (j + 1)) → (∀ j, EqOn (φ (j + 1)) (φ j) (E j)) → (∀ j, IsIntegerMultiplicity (W j)) → (∀ j, IsIntegerMultiplicity (D j)) → (∀ j, IsIntegerMultiplicity (Z j)) → (∀ j (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (E j) → W j ω = 0) → (∀ j (ω : TestFormOn (univ : Set (Euclid P)) m), Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) (E j) → D j ω = 0) → (∀ j (ω : TestFormOn (univ : Set (Euclid P)) m), Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) (E j) → Z j ω = 0) → (∀ ω : TestFormOn (univ : Set (Euclid P)) m, (W 0).boundary ω = D 0 ω - Z 0 ω) → (∀ j (ω : TestFormOn (univ : Set (Euclid P)) m), (W (j + 1)).boundary ω = D (j + 1) ω + Z j ω - Z (j + 1) ω) → (∀ N (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)), ∑ j ∈ Finset.range (N + 1), push (m + 1) (φ j) (W j) ω - ∑ j ∈ Finset.range (N + 1), W j ω - ∑ j ∈ Finset.range (N + 1), (homot (m + 1) (fun x => x) (φ j) (W j)).boundary ω = ∑ j ∈ Finset.range (N + 1), homot m (fun x => x) (φ j) (D j) ω - homot m (fun x => x) (φ N) (Z N) ω) ∧ ∀ N (ω : TestFormOn (univ : Set (Euclid P)) m), ∑ j ∈ Finset.range (N + 1), (push (m + 1) (φ j) (W j)).boundary ω = ∑ j ∈ Finset.range (N + 1), push m (φ j) (D j) ω - push m (φ N) (Z N) ω := by
  intro P m push homot hid hlin hloc hhom E φ Λ W D Z hEc hEs hφ hΛ1 hΛs hφE hW hD hZ hWE hDE
    hZE hW0 hWs
  -- values of a difference: `(A − B)(ω) = A(ω) − B(ω)`
  have hsub : ∀ {k : ℕ} (A B : GeometricCurrentOn (univ : Set (Euclid P)) k)
      (ω : TestFormOn (univ : Set (Euclid P)) k), (A - B) ω = A ω - B ω := fun _ _ _ => rfl
  -- Step 1: `id` is `Λⱼ`-Lipschitz and `φⱼ` is `Λⱼ₊₁`-Lipschitz
  have hidL : ∀ j, LipschitzWith (Λ j) (fun x : Euclid P => x) := fun j =>
    LipschitzWith.id.weaken (hΛ1 j)
  have hφL : ∀ j, LipschitzWith (Λ (j + 1)) (φ j) := fun j => (hφ j).weaken (hΛs j)
  -- `0` and `0 − X` are integer multiplicity (zero_neg), and so is `A − B` ((IMC)(c))
  have hz := Submission.dor_lmb_fcd_sd_zero_neg P m univ isOpen_univ
  have hIM : ∀ A B : GeometricCurrentOn (univ : Set (Euclid P)) m, IsIntegerMultiplicity A →
      IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B) := fun A B hA hB =>
    Submission.cmc_imRep_locality_restrict_sub.2.2.1 P m univ A B isOpen_univ hA hB
  -- Step 2: `push(F, 0)` and `homot(F, G, 0)` vanish (PF(2) with `X = Y = 0`, `E = ∅`)
  have hzero : ∀ (L : NNReal) (F G : Euclid P → Euclid P), LipschitzWith L F →
      LipschitzWith L G → (∀ ω, push m F 0 ω = 0) ∧ ∀ η, homot m F G 0 η = 0 := by
    intro L F G hF hG
    have h00 : (0 : GeometricCurrentOn (univ : Set (Euclid P)) m) - 0 = 0 :=
      GeometricCurrentOn.ext fun ω => by rw [hsub, GeometricCurrentOn.zero_apply, sub_self]
    obtain ⟨hp, hh⟩ := hlin m L F G ∅ 0 0 hF hG isCompact_empty hz.1 hz.1 (fun _ _ => rfl)
      (fun _ _ => rfl)
    rw [h00] at hp hh
    refine ⟨fun ω => ?_, fun η => ?_⟩
    · have h := congrArg (fun T => T ω) hp
      simp only [hsub] at h
      linarith
    · have h := congrArg (fun T => T η) hh
      simp only [hsub] at h
      linarith
  -- Step 3: the one-shell identities (i) and (ii)
  have shell : ∀ (j : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1))
      (D' Z' Z'' : GeometricCurrentOn (univ : Set (Euclid P)) m),
      IsIntegerMultiplicity X → IsIntegerMultiplicity D' → IsIntegerMultiplicity Z' →
      IsIntegerMultiplicity Z'' →
      (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1),
        Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (E j) → X ω = 0) →
      (∀ ω : TestFormOn (univ : Set (Euclid P)) m,
        Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) (E j) → D' ω = 0) →
      (∀ ω : TestFormOn (univ : Set (Euclid P)) m,
        Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) (E j) → Z' ω = 0) →
      (∀ ω : TestFormOn (univ : Set (Euclid P)) m,
        Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) (E j) → Z'' ω = 0) →
      (∀ ω, X.boundary ω = D' ω + Z' ω - Z'' ω) →
      (∀ η, push (m + 1) (φ j) X η - X η - (homot (m + 1) (fun x => x) (φ j) X).boundary η =
        homot m (fun x => x) (φ j) D' η + homot m (fun x => x) (φ j) Z' η -
          homot m (fun x => x) (φ j) Z'' η) ∧
      ∀ ω, (push (m + 1) (φ j) X).boundary ω =
        push m (φ j) D' ω + push m (φ j) Z' ω - push m (φ j) Z'' ω := by
    intro j X D' Z' Z'' hX hD' hZ' hZ'' hXE hD'E hZ'E hZ''E hbd
    -- `0 − Z′` and `D′ − (0 − Z′)` are integer multiplicity and vanish off `Eⱼ`
    have hnZ := hz.2.1 Z' hZ'
    have hDnZ := hIM D' (0 - Z') hD' hnZ
    have hnZE : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
        Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) (E j) → (0 - Z') ω = 0 :=
      fun ω hω => by rw [hsub, hZ'E ω hω, GeometricCurrentOn.zero_apply, sub_zero]
    have hDnZE : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
        Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) (E j) →
          (D' - (0 - Z')) ω = 0 :=
      fun ω hω => by rw [hsub, hD'E ω hω, hnZE ω hω, sub_zero]
    -- `∂X = (D′ − (0 − Z′)) − Z″` is integer multiplicity
    have hbdX : X.boundary = (D' - (0 - Z')) - Z'' := GeometricCurrentOn.ext fun ω => by
      simp only [hbd, hsub, GeometricCurrentOn.zero_apply]
      ring
    have hbdIM : IsIntegerMultiplicity X.boundary := by
      rw [hbdX]
      exact hIM _ _ hDnZ hZ''
    -- PF(2) for `(D′ − (0 − Z′), Z″)`, `(D′, 0 − Z′)`, `(0, Z′)` expands `push(F, ∂X)` and
    -- `homot(F, G, ∂X)`
    have hexp : ∀ F G : Euclid P → Euclid P, LipschitzWith (Λ j) F → LipschitzWith (Λ j) G →
        (∀ ω, push m F X.boundary ω = push m F D' ω + push m F Z' ω - push m F Z'' ω) ∧
        ∀ η, homot m F G X.boundary η =
          homot m F G D' η + homot m F G Z' η - homot m F G Z'' η := by
      intro F G hF hG
      obtain ⟨p₁, k₁⟩ := hlin m (Λ j) F G (E j) (D' - (0 - Z')) Z'' hF hG (hEc j) hDnZ hZ''
        hDnZE hZ''E
      obtain ⟨p₂, k₂⟩ := hlin m (Λ j) F G (E j) D' (0 - Z') hF hG (hEc j) hD' hnZ hD'E hnZE
      obtain ⟨p₃, k₃⟩ := hlin m (Λ j) F G (E j) 0 Z' hF hG (hEc j) hz.1 hZ' (fun _ _ => rfl)
        hZ'E
      obtain ⟨p₀, k₀⟩ := hzero (Λ j) F G hF hG
      rw [hbdX]
      refine ⟨fun ω => ?_, fun η => ?_⟩
      · rw [p₁, hsub, p₂, hsub, p₃, hsub, p₀]
        ring
      · rw [k₁, hsub, k₂, hsub, k₃, hsub, k₀]
        ring
    -- (i): PF(5) with `(F, G) = (id, φⱼ)` and PF(1); (ii): PF(5) with `(F, G) = (φⱼ, φⱼ)`
    obtain ⟨-, h₅⟩ := hhom m (Λ j) (fun x => x) (φ j) (E j) X (hidL j) (hφ j) (hEc j) hX hbdIM
      hXE
    obtain ⟨h₅', -⟩ := hhom m (Λ j) (φ j) (φ j) (E j) X (hφ j) (hφ j) (hEc j) hX hbdIM hXE
    rw [hid (m + 1) (E j) X (hEc j) hX hXE] at h₅
    refine ⟨fun η => ?_, fun ω => ?_⟩
    · have h := congrArg (fun T => T η) h₅
      simp only [hsub] at h
      have e := (hexp (fun x => x) (φ j) (hidL j) (hφ j)).2 η
      linarith
    · rw [h₅']
      exact (hexp (φ j) (φ j) (hφ j) (hφ j)).1 ω
  -- Steps 5 and 6: the shells `0` (with `Z′ = 0`) and `j + 1` (`Zⱼ` vanishes off `Eⱼ ⊆ Eⱼ₊₁`)
  have s₀ := shell 0 (W 0) (D 0) 0 (Z 0) (hW 0) (hD 0) hz.1 (hZ 0) (hWE 0) (hDE 0)
    (fun _ _ => rfl) (hZE 0) (fun ω => by rw [hW0 ω, GeometricCurrentOn.zero_apply, add_zero])
  have s := fun j : ℕ => shell (j + 1) (W (j + 1)) (D (j + 1)) (Z j) (Z (j + 1)) (hW _) (hD _)
    (hZ j) (hZ _) (hWE _) (hDE _) (fun ω hω => hZE j ω (hω.mono_right (hEs j))) (hZE _) (hWs j)
  -- Step 7: PF(3) on `Eⱼ`, where `φⱼ₊₁ = φⱼ`, identifies the `Zⱼ`-terms of consecutive shells
  have hZZ : ∀ j, (∀ η, homot m (fun x => x) (φ (j + 1)) (Z j) η =
      homot m (fun x => x) (φ j) (Z j) η) ∧
      ∀ ω, push m (φ (j + 1)) (Z j) ω = push m (φ j) (Z j) ω := by
    intro j
    have k := (hloc m (Λ (j + 1)) (fun x => x) (φ (j + 1)) (fun x => x) (φ j) (E j) (Z j)
      (hidL (j + 1)) (hφ (j + 1)) (hidL (j + 1)) (hφL j) (hEc j) (hZ j) (hZE j)
      (eqOn_refl _ _) (hφE j)).2
    have p := (hloc m (Λ (j + 1)) (φ (j + 1)) (fun x => x) (φ j) (fun x => x) (E j) (Z j)
      (hφ (j + 1)) (hidL (j + 1)) (hφL j) (hidL (j + 1)) (hEc j) (hZ j) (hZE j) (hφE j)
      (eqOn_refl _ _)).1
    exact ⟨fun η => by rw [k], fun ω => by rw [p]⟩
  -- Step 8: telescoping by induction on `N`
  refine ⟨fun N => ?_, fun N => ?_⟩
  · induction N with
    | zero =>
      intro η
      simp only [zero_add, Finset.sum_range_one]
      have h₁ := s₀.1 η
      have h₂ := (hzero (Λ 0) (fun x => x) (φ 0) (hidL 0) (hφ 0)).2 η
      linarith
    | succ N ih =>
      intro η
      rw [Finset.sum_range_succ _ (N + 1), Finset.sum_range_succ _ (N + 1),
        Finset.sum_range_succ _ (N + 1), Finset.sum_range_succ _ (N + 1)]
      have h₁ := (s N).1 η
      have h₂ := (hZZ N).1 η
      have h₃ := ih η
      linarith
  · induction N with
    | zero =>
      intro ω
      simp only [zero_add, Finset.sum_range_one]
      have h₁ := s₀.2 ω
      have h₂ := (hzero (Λ 0) (φ 0) (φ 0) (hφ 0) (hφ 0)).1 ω
      linarith
    | succ N ih =>
      intro ω
      rw [Finset.sum_range_succ _ (N + 1), Finset.sum_range_succ _ (N + 1)]
      have h₁ := (s N).2 ω
      have h₂ := (hZZ N).2 ω
      have h₃ := ih ω
      linarith
/-- **Limits of the deformation series** (Simon Ch. 6, proof of the Deformation Theorem 5.1,
(19)–(21), (24), (25); used for the flat convergence in the proof of 7.5.1).  By (IMS) the series
`Q = ∑ⱼ Vⱼ`, `R₁ = ∑ⱼ (0 − Hⱼ)` and `S₁ = ∑ⱼ (0 − E′ⱼ)` converge on every test form to integer
multiplicity currents with `M(Q) ≤ ∑ⱼ M(Vⱼ)`, `M(R₁) ≤ ∑ⱼ M(Hⱼ)` and `M(S₁) ≤ ∑ⱼ M(E′ⱼ)`.  A
current of small mass is small on each test form, `|X(ω)| ≤ s M(X)` when `|ω| ≤ s`; so `A_N(ω)` and
`K_N(ω)` tend to `0`, and letting `N → ∞` in (h1) gives `T − Q = ∂R₁ + S₁`.  For an admissible
`ω`, `∂Q(ω) = lim_N ∑_{j≤N} ∂Vⱼ(ω) = lim_N (∑_{j≤N} Yⱼ(ω) − L_N(ω))` by (h2), and the latter is
at most `c M(∂T) + M(L_N) → c M(∂T)`; hence `M(∂Q) ≤ c M(∂T)`.  Sums of currents vanishing off
`F₁` (or `F₂`) vanish off the same set. -/
theorem Submission.dor_lmb_fcd_sd_series_limit : (∀ (P m : ℕ) (U : Set (Euclid P)) (X : ℕ → GeometricCurrentOn U (m + 1)), IsOpen U → (∀ r, IsIntegerMultiplicity (X r)) → ∑' r, (X r).mass ≠ ∞ → ∃ Y : GeometricCurrentOn U (m + 1), IsIntegerMultiplicity Y ∧ (∀ ω : TestFormOn U (m + 1), HasSum (fun r => X r ω) (Y ω)) ∧ Y.mass ≤ ∑' r, (X r).mass) → ∀ (P m : ℕ) (c : ℝ) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (V E' A Kc : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (H : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (Y L : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) m) (F₁ F₂ : Set (Euclid P)), T.mass ≠ ∞ → T.boundary.mass ≠ ∞ → (∀ j, IsIntegerMultiplicity (V j)) → (∀ j, IsIntegerMultiplicity (H j)) → (∀ j, IsIntegerMultiplicity (E' j)) → (∀ N (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)), ∑ j ∈ Finset.range (N + 1), V j ω - T ω + A N ω - ∑ j ∈ Finset.range (N + 1), (H j).boundary ω = ∑ j ∈ Finset.range (N + 1), E' j ω - Kc N ω) → (∀ N (ω : TestFormOn (univ : Set (Euclid P)) m), ∑ j ∈ Finset.range (N + 1), (V j).boundary ω = ∑ j ∈ Finset.range (N + 1), Y j ω - L N ω) → Tendsto (fun N => (A N).mass) atTop (𝓝 0) → Tendsto (fun N => (Kc N).mass) atTop (𝓝 0) → Tendsto (fun N => (L N).mass) atTop (𝓝 0) → ∑' j, (V j).mass ≤ ENNReal.ofReal c * T.mass → ∑' j, (H j).mass ≤ ENNReal.ofReal c * T.mass → ∑' j, (E' j).mass ≤ ENNReal.ofReal c * T.boundary.mass → ∑' j, (Y j).mass ≤ ENNReal.ofReal c * T.boundary.mass → (∀ j (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (F₁) → V j ω = 0) → (∀ j (ω : TestFormOn (univ : Set (Euclid P)) (m + 2)), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 2))) (F₂) → H j ω = 0) → (∀ j (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (F₂) → E' j ω = 0) → ∃ (Q : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R₁ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S₁ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q ∧ IsIntegerMultiplicity R₁ ∧ IsIntegerMultiplicity S₁ ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), T ω - Q ω = R₁.boundary ω + S₁ ω) ∧ Q.mass ≤ ENNReal.ofReal c * T.mass ∧ Q.boundary.mass ≤ ENNReal.ofReal c * T.boundary.mass ∧ R₁.mass ≤ ENNReal.ofReal c * T.mass ∧ S₁.mass ≤ ENNReal.ofReal c * T.boundary.mass ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (F₁) → Q ω = 0) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 2), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 2))) (F₂) → R₁ ω = 0) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (F₂) → S₁ ω = 0 := by
  intro IMS P m c T V E' A Kc H Y L F₁ F₂ hT hbT hV hH hE' h1 h2 hA hK hL hVm hHm hE'm hYm hVF hHF
    hE'F
  -- `0 − X` acts as `−X` on test forms
  have hneg_apply : ∀ {k : ℕ} (X : GeometricCurrentOn (univ : Set (Euclid P)) k)
      (ω : TestFormOn (univ : Set (Euclid P)) k), (0 - X) ω = -X ω :=
    fun X ω => zero_sub (X ω)
  -- zero_neg in the degrees `m`, `m + 1` and `m + 2`
  obtain ⟨-, -, hnegm₀, -⟩ := Submission.dor_lmb_fcd_sd_zero_neg P m univ isOpen_univ
  obtain ⟨-, hneg₁, hnegm₁, hsmall₁⟩ :=
    Submission.dor_lmb_fcd_sd_zero_neg P (m + 1) univ isOpen_univ
  obtain ⟨-, hneg₂, hnegm₂, -⟩ := Submission.dor_lmb_fcd_sd_zero_neg P (m + 1 + 1) univ isOpen_univ
  -- Step 1: the bounds `c M(T)` and `c M(∂T)` are finite
  have hcT : ENNReal.ofReal c * T.mass ≠ ∞ := ENNReal.mul_ne_top ENNReal.ofReal_ne_top hT
  have hcbT : ENNReal.ofReal c * T.boundary.mass ≠ ∞ :=
    ENNReal.mul_ne_top ENNReal.ofReal_ne_top hbT
  -- Step 2: `Q = ∑ⱼ Vⱼ`
  obtain ⟨Q, hQ, hQsum, hQm⟩ := IMS P m univ V isOpen_univ hV (ne_top_of_le_ne_top hcT hVm)
  -- Step 3: `R₁ = ∑ⱼ (0 − Hⱼ)`, with `M(0 − Hⱼ) = M(Hⱼ)`
  have eH : ∑' j, (0 - H j : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1 + 1)).mass =
      ∑' j, (H j).mass := tsum_congr fun j => hnegm₂ (H j) univ
  obtain ⟨R₁, hR₁, hR₁sum, hR₁m⟩ := IMS P (m + 1) univ (fun j => 0 - H j) isOpen_univ
    (fun j => hneg₂ (H j) (hH j)) (ne_top_of_le_ne_top hcT (eH.le.trans hHm))
  -- Step 4: `S₁ = ∑ⱼ (0 − E′ⱼ)`, with `M(0 − E′ⱼ) = M(E′ⱼ)`
  have eE : ∑' j, (0 - E' j).mass = ∑' j, (E' j).mass := tsum_congr fun j => hnegm₁ (E' j) univ
  obtain ⟨S₁, hS₁, hS₁sum, hS₁m⟩ := IMS P m univ (fun j => 0 - E' j) isOpen_univ
    (fun j => hneg₁ (E' j) (hE' j)) (ne_top_of_le_ne_top hcbT (eE.le.trans hE'm))
  -- Step 5: if `M(X_N) → 0` then `X_N(ω) → 0`, since `|X_N(ω)| ≤ s M(X_N)` for a bound `s` of `|ω|`
  have hweak : ∀ X : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1),
      Tendsto (fun N => (X N).mass) atTop (𝓝 0) →
      ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Tendsto (fun N => X N ω) atTop (𝓝 0) := by
    intro X hX ω
    -- `x ↦ |ω(x)| = √(∑_I ω(x)(e_I)²)` is continuous, since each coefficient `ω(x)(e_I)` is
    have hcont : Continuous fun x =>
        covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) (m + 1)) x) := by
      have hω : Continuous (ω : DifferentialForm (Euclid P) (m + 1)) := ω.property.1.1.continuous
      unfold covectorEuclideanNorm
      refine Real.continuous_sqrt.comp (continuous_finsetSum _ fun I _ => ?_)
      split_ifs
      · exact ((continuous_eval_const _).comp hω).pow 2
      · exact continuous_const
    have hcs : HasCompactSupport fun x =>
        covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) (m + 1)) x) := by
      refine ω.property.1.2.mono' fun x hx => subset_tsupport _ fun h0 => hx ?_
      simp only [h0, covectorEuclideanNorm_zero]
    obtain ⟨s₀, hs₀⟩ := hcont.bddAbove_range_of_hasCompactSupport hcs
    have hs : ∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) (m + 1)) x) ≤
        max s₀ 1 := fun x => (hs₀ (mem_range_self x)).trans (le_max_left _ _)
    have hlim : Tendsto (fun N => max s₀ 1 * (X N).mass.toReal) atTop (𝓝 0) := by
      simpa using ((ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp hX).const_mul (max s₀ 1)
    refine squeeze_zero_norm' ?_ hlim
    filter_upwards [hX.eventually (gt_mem_nhds zero_lt_one)] with N hN
    rw [Real.norm_eq_abs]
    exact hsmall₁ (X N) ω (max s₀ 1) (lt_max_of_lt_right one_pos) (ne_top_of_lt hN) hs
  -- Step 6: letting `N → ∞` in (h1) gives `T − Q = ∂R₁ + S₁`
  have hid : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1),
      T ω - Q ω = R₁.boundary ω + S₁ ω := by
    intro ω
    have sH : HasSum (fun j => (H j).boundary ω) (-R₁.boundary ω) := by
      have e : (fun j => (H j).boundary ω) =
          fun j => -(0 - H j) (exteriorDerivativeTestOn univ (m + 1) ω) := by
        funext j
        rw [hneg_apply, neg_neg]
        rfl
      rw [e]
      exact (hR₁sum _).neg
    have sE : HasSum (fun j => E' j ω) (-S₁ ω) := by
      have e : (fun j => E' j ω) = fun j => -(0 - E' j) ω := by
        funext j
        rw [hneg_apply, neg_neg]
      rw [e]
      exact (hS₁sum ω).neg
    have tV : Tendsto (fun N => ∑ j ∈ Finset.range (N + 1), V j ω) atTop (𝓝 (Q ω)) :=
      (hQsum ω).tendsto_sum_nat.comp (tendsto_add_atTop_nat 1)
    have tH : Tendsto (fun N => ∑ j ∈ Finset.range (N + 1), (H j).boundary ω) atTop
        (𝓝 (-R₁.boundary ω)) := sH.tendsto_sum_nat.comp (tendsto_add_atTop_nat 1)
    have tE : Tendsto (fun N => ∑ j ∈ Finset.range (N + 1), E' j ω) atTop (𝓝 (-S₁ ω)) :=
      sE.tendsto_sum_nat.comp (tendsto_add_atTop_nat 1)
    have tl : Tendsto (fun N => ∑ j ∈ Finset.range (N + 1), V j ω - T ω + A N ω -
        ∑ j ∈ Finset.range (N + 1), (H j).boundary ω) atTop
        (𝓝 (Q ω - T ω + 0 - -R₁.boundary ω)) :=
      ((tV.sub tendsto_const_nhds).add (hweak A hA ω)).sub tH
    have tr : Tendsto (fun N => ∑ j ∈ Finset.range (N + 1), V j ω - T ω + A N ω -
        ∑ j ∈ Finset.range (N + 1), (H j).boundary ω) atTop (𝓝 (-S₁ ω - 0)) :=
      (tE.sub (hweak Kc hK ω)).congr fun N => (h1 N ω).symm
    have := tendsto_nhds_unique tl tr
    linarith
  -- Step 7: `M(∂Q) ≤ c M(∂T)`, tested on each admissible `ω`
  have hbQ : Q.boundary.mass ≤ ENNReal.ofReal c * T.boundary.mass := by
    refine sSup_le ?_
    rintro _ ⟨ω, hω, rfl⟩
    have t1 : Tendsto (fun N => ∑ j ∈ Finset.range (N + 1), Y j ω - L N ω) atTop
        (𝓝 (Q.boundary ω)) :=
      ((hQsum (exteriorDerivativeTestOn univ m ω)).tendsto_sum_nat.comp
        (tendsto_add_atTop_nat 1)).congr fun N => h2 N ω
    have t2 : Tendsto (fun N => ENNReal.ofReal c * T.boundary.mass + (L N).mass) atTop
        (𝓝 (ENNReal.ofReal c * T.boundary.mass)) := by
      simpa using (tendsto_const_nhds (x := ENNReal.ofReal c * T.boundary.mass)).add hL
    refine le_of_tendsto_of_tendsto' (ENNReal.tendsto_ofReal t1) t2 fun N => ?_
    calc ENNReal.ofReal (∑ j ∈ Finset.range (N + 1), Y j ω - L N ω)
        = ENNReal.ofReal (∑ j ∈ Finset.range (N + 1), Y j ω + (0 - L N) ω) := by
          rw [hneg_apply, ← sub_eq_add_neg]
      _ ≤ ENNReal.ofReal (∑ j ∈ Finset.range (N + 1), Y j ω) + ENNReal.ofReal ((0 - L N) ω) :=
          ENNReal.ofReal_add_le
      _ ≤ ∑ j ∈ Finset.range (N + 1), ENNReal.ofReal (Y j ω) + (0 - L N).massOn univ :=
          add_le_add (Finset.le_sum_of_subadditive ENNReal.ofReal ENNReal.ofReal_zero.le
            (fun _ _ => ENNReal.ofReal_add_le) _ _) ((0 - L N).le_massOn hω)
      _ ≤ ∑ j ∈ Finset.range (N + 1), (Y j).mass + (L N).mass :=
          add_le_add (Finset.sum_le_sum fun j _ => (Y j).le_massOn hω) (hnegm₀ (L N) univ).le
      _ ≤ ENNReal.ofReal c * T.boundary.mass + (L N).mass :=
          add_le_add ((ENNReal.sum_le_tsum _).trans hYm) le_rfl
  -- Steps 8–9: the vanishing sets, and all conclusions
  refine ⟨Q, R₁, S₁, hQ, hR₁, hS₁, hid, hQm.trans hVm, hbQ, hR₁m.trans (eH.le.trans hHm),
    hS₁m.trans (eE.le.trans hE'm), fun ω hω => ?_, fun ω hω => ?_, fun ω hω => ?_⟩
  · have hz : ∀ j, V j ω = 0 := fun j => hVF j ω hω
    rw [← (hQsum ω).tsum_eq]
    simp [hz]
  · have hz : ∀ j, (0 - H j : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1 + 1)) ω = 0 :=
      fun j => by rw [hneg_apply, hHF j ω hω, neg_zero]
    rw [← (hR₁sum ω).tsum_eq]
    simp [hz]
  · have hz : ∀ j, (0 - E' j) ω = 0 := fun j => by rw [hneg_apply, hE'F j ω hω, neg_zero]
    rw [← (hS₁sum ω).tsum_eq]
    simp [hz]

/-- **Deformation of the shells onto the skeleton: assembly** (Simon Ch. 6, 5.1, displays (11)–(18)
and the end of the proof of the deformation theorem).  With `Vⱼ = φⱼ#Wⱼ`, `Hⱼ = h#(id, φⱼ)Wⱼ`,
`Yⱼ = φⱼ#Dⱼ`, `E′ⱼ = h#(id, φⱼ)Dⱼ`, `L_N = φ_N#Z_N` and `K_N = h#(id, φ_N)Z_N`, the telescoping
identities and `Σ_{j≤N} Wⱼ = T − A_N` give `Σ_{j≤N} Vⱼ − T + A_N − ∂Σ_{j≤N} Hⱼ = Σ_{j≤N} E′ⱼ − K_N`
and `∂Σ_{j≤N} Vⱼ = Σ_{j≤N} Yⱼ − L_N`.  As `Λⱼ ≤ c₄2ʲ` and `|φⱼ − id| = |ψ − id| ≤ √P` on `Eⱼ`,
the mass bounds `M(φ#X) ≤ Λᵏ M(X)`, `M(h#X) ≤ √P (2Λ)ᵏ M(X)` and the dyadic decay of `M(Wⱼ)`,
`M(Dⱼ)`, `M(Zⱼ)` give `Σ M(Vⱼ), Σ M(Hⱼ) ≤ c M(T)`, `Σ M(Yⱼ), Σ M(E′ⱼ) ≤ c M(∂T)` and
`M(L_N), M(K_N) → 0`; `Vⱼ` lives on `ψ(Eⱼ) ⊆ F₁` and `Hⱼ`, `E′ⱼ` on the segments from `x` to
`ψ(x)`, inside `F₂`.  The series limit then yields `Q`, `R₁`, `S₁`. -/
theorem Submission.dor_lmb_fcd_sd_core : (∀ (P m : ℕ) (U : Set (Euclid P)) (X : ℕ → GeometricCurrentOn U (m + 1)), IsOpen U → (∀ r, IsIntegerMultiplicity (X r)) → ∑' r, (X r).mass ≠ ∞ → ∃ Y : GeometricCurrentOn U (m + 1), IsIntegerMultiplicity Y ∧ (∀ ω : TestFormOn U (m + 1), HasSum (fun r => X r ω) (Y ω)) ∧ Y.mass ≤ ∑' r, (X r).mass) → ∀ (P m : ℕ) (push : ∀ k : ℕ, (Euclid P → Euclid P) → GeometricCurrentOn (univ : Set (Euclid P)) k → GeometricCurrentOn (univ : Set (Euclid P)) k) (homot : ∀ k : ℕ, (Euclid P → Euclid P) → (Euclid P → Euclid P) → GeometricCurrentOn (univ : Set (Euclid P)) k → GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)), (∀ (k : ℕ) (E : Set (Euclid P)) (X : GeometricCurrentOn (univ : Set (Euclid P)) k), IsCompact E → IsIntegerMultiplicity X → (∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) (E) → X ω = 0) → push k (fun x => x) X = X) → (∀ (k : ℕ) (Λ : NNReal) (F G : Euclid P → Euclid P) (E : Set (Euclid P)) (X Y : GeometricCurrentOn (univ : Set (Euclid P)) k), LipschitzWith Λ F → LipschitzWith Λ G → IsCompact E → IsIntegerMultiplicity X → IsIntegerMultiplicity Y → (∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) (E) → X ω = 0) → (∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) (E) → Y ω = 0) → push k F (X - Y) = push k F X - push k F Y ∧ homot k F G (X - Y) = homot k F G X - homot k F G Y) → (∀ (k : ℕ) (Λ : NNReal) (F G F' G' : Euclid P → Euclid P) (E : Set (Euclid P)) (X : GeometricCurrentOn (univ : Set (Euclid P)) k), LipschitzWith Λ F → LipschitzWith Λ G → LipschitzWith Λ F' → LipschitzWith Λ G' → IsCompact E → IsIntegerMultiplicity X → (∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) (E) → X ω = 0) → EqOn F F' E → EqOn G G' E → push k F X = push k F' X ∧ homot k F G X = homot k F' G' X) → (∀ (k : ℕ) (Λ : NNReal) (F G : Euclid P → Euclid P) (E : Set (Euclid P)) (X : GeometricCurrentOn (univ : Set (Euclid P)) k), LipschitzWith Λ F → LipschitzWith Λ G → IsCompact E → IsIntegerMultiplicity X → (∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) (E) → X ω = 0) → IsIntegerMultiplicity (push k F X) ∧ IsIntegerMultiplicity (homot k F G X) ∧ (push k F X).mass ≤ (Λ : ℝ≥0∞) ^ k * X.mass ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) k, Disjoint (tsupport (ω : DifferentialForm (Euclid P) k)) (F '' E) → push k F X ω = 0) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (k + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (k + 1))) ({y : Euclid P | ∃ x ∈ E, ∃ t ∈ Icc (0 : ℝ) 1, y = F x + t • (G x - F x)}) → homot k F G X ω = 0) ∧ ∀ δ : ℝ, (∀ x ∈ E, dist (F x) (G x) ≤ δ) → (homot k F G X).mass ≤ ENNReal.ofReal δ * (2 * (Λ : ℝ≥0∞)) ^ k * X.mass) → (∀ (k : ℕ) (Λ : NNReal) (F G : Euclid P → Euclid P) (E : Set (Euclid P)) (X : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)), LipschitzWith Λ F → LipschitzWith Λ G → IsCompact E → IsIntegerMultiplicity X → IsIntegerMultiplicity X.boundary → (∀ ω : TestFormOn (univ : Set (Euclid P)) (k + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (k + 1))) (E) → X ω = 0) → (push (k + 1) F X).boundary = push k F X.boundary ∧ push (k + 1) G X - push (k + 1) F X - homot k F G X.boundary = (homot (k + 1) F G X).boundary) → ∀ (c c₄ C : ℝ) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (ψ : Euclid P → Euclid P) (E : ℕ → Set (Euclid P)) (φ : ℕ → Euclid P → Euclid P) (Λ : ℕ → NNReal) (W A : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (D Z : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) m) (F₁ F₂ : Set (Euclid P)), 0 ≤ c₄ → 0 ≤ C → c₄ ^ (m + 1) * (1 + 2 * C) ≤ c → Real.sqrt P * (2 * c₄) ^ (m + 1) * (1 + 2 * C) ≤ c → c₄ ^ m * (1 + 2 * C) ≤ c → Real.sqrt P * (2 * c₄) ^ m * (1 + 2 * C) ≤ c → T.mass ≠ ∞ → T.boundary.mass ≠ ∞ → (∀ j, IsCompact (E j)) → (∀ j, E j ⊆ E (j + 1)) → (∀ j, LipschitzWith (Λ j) (φ j)) → (∀ j, 1 ≤ Λ j) → (∀ j, Λ j ≤ Λ (j + 1)) → (∀ j, (Λ j : ℝ) ≤ c₄ * 2 ^ j) → (∀ j, EqOn (φ j) ψ (E j)) → (∀ j, ∀ x ∈ E j, dist (ψ x) x ≤ Real.sqrt P) → (∀ j, ψ '' E j ⊆ F₁) → (∀ j, ∀ x ∈ E j, ∀ t ∈ Icc (0 : ℝ) 1, x + t • (ψ x - x) ∈ F₂) → (∀ j, IsIntegerMultiplicity (W j)) → (∀ j, IsIntegerMultiplicity (D j)) → (∀ j, IsIntegerMultiplicity (Z j)) → (∀ j (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (E j) → W j ω = 0) → (∀ j (ω : TestFormOn (univ : Set (Euclid P)) m), Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) (E j) → D j ω = 0) → (∀ j (ω : TestFormOn (univ : Set (Euclid P)) m), Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) (E j) → Z j ω = 0) → (∀ ω : TestFormOn (univ : Set (Euclid P)) m, (W 0).boundary ω = D 0 ω - Z 0 ω) → (∀ j (ω : TestFormOn (univ : Set (Euclid P)) m), (W (j + 1)).boundary ω = D (j + 1) ω + Z j ω - Z (j + 1) ω) → (∀ N (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)), ∑ j ∈ Finset.range (N + 1), W j ω = T ω - A N ω) → (W 0).mass ≤ T.mass → (∀ j, (W (j + 1)).mass ≤ ENNReal.ofReal (C * (1 / 2) ^ ((j + 2) * (m + 2))) * T.mass) → (D 0).mass ≤ T.boundary.mass → (∀ j, (D (j + 1)).mass ≤ ENNReal.ofReal (C * (1 / 2) ^ ((j + 2) * (m + 2))) * T.boundary.mass) → (∀ j, (Z j).mass ≤ ENNReal.ofReal (4 * C * (1 / 2) ^ ((j + 2) * (m + 1))) * T.mass) → Tendsto (fun N => (A N).mass) atTop (𝓝 0) → ∃ (Q : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R₁ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S₁ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q ∧ IsIntegerMultiplicity R₁ ∧ IsIntegerMultiplicity S₁ ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), T ω - Q ω = R₁.boundary ω + S₁ ω) ∧ Q.mass ≤ ENNReal.ofReal c * T.mass ∧ Q.boundary.mass ≤ ENNReal.ofReal c * T.boundary.mass ∧ R₁.mass ≤ ENNReal.ofReal c * T.mass ∧ S₁.mass ≤ ENNReal.ofReal c * T.boundary.mass ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (F₁) → Q ω = 0) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 2), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 2))) (F₂) → R₁ ω = 0) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (F₂) → S₁ ω = 0 := by
  intro hIMS P m push homot hPF1 hPF2 hPF3 hPF4 hPF5 c c₄ C T ψ E φ Λ W A D Z F₁ F₂ hc₄ hC hcV hcH
    hcY hcE hT hbT hEc hEsub hφL hΛ1 hΛmono hΛc hφψ hψdist hψF₁ hψF₂ hWim hDim hZim hWv hDv hZv
    hbW0 hbW hWsum hW0 hW hD0 hD hZ hA
  -- Step 1: `id` is `Λⱼ`-Lipschitz, as `1 ≤ Λⱼ`
  have hid : ∀ j, LipschitzWith (Λ j) (fun x : Euclid P => x) :=
    fun j => LipschitzWith.id.weaken (hΛ1 j)
  -- Step 2: `φ_{j+1} = ψ = φⱼ` on `Eⱼ ⊆ E_{j+1}`
  have hφstep : ∀ j, EqOn (φ (j + 1)) (φ j) (E j) :=
    fun j x hx => (hφψ (j + 1) (hEsub j hx)).trans (hφψ j hx).symm
  -- Step 3: the telescoping identities (S1), (S2)
  obtain ⟨hS1, hS2⟩ := Submission.dor_lmb_fcd_sd_telescoping P m push homot hPF1 hPF2 hPF3 hPF5
    E φ Λ W D Z hEc hEsub hφL hΛ1 hΛmono hφstep hWim hDim hZim hWv hDv hZv hbW0 hbW
  -- (h1): add `Σ_{j≤N} Wⱼ = T − A_N` to (S1)
  have h1 : ∀ N (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)),
      ∑ j ∈ Finset.range (N + 1), push (m + 1) (φ j) (W j) ω - T ω + A N ω -
          ∑ j ∈ Finset.range (N + 1), (homot (m + 1) (fun x => x) (φ j) (W j)).boundary ω =
        ∑ j ∈ Finset.range (N + 1), homot m (fun x => x) (φ j) (D j) ω -
          homot m (fun x => x) (φ N) (Z N) ω := fun N ω => by
    have hS := hS1 N ω
    have hT' := hWsum N ω
    linarith
  -- Step 4: PF(4) for `push_k(φⱼ, ·)` and `homot_k(id, φⱼ, ·)` on `Wⱼ`, `Dⱼ`, `Zⱼ`
  have hpW := fun j : ℕ => hPF4 (m + 1) (Λ j) (φ j) (φ j) (E j) (W j) (hφL j) (hφL j) (hEc j)
    (hWim j) (hWv j)
  have hhW := fun j : ℕ => hPF4 (m + 1) (Λ j) (fun x => x) (φ j) (E j) (W j) (hid j) (hφL j)
    (hEc j) (hWim j) (hWv j)
  have hpD := fun j : ℕ => hPF4 m (Λ j) (φ j) (φ j) (E j) (D j) (hφL j) (hφL j) (hEc j)
    (hDim j) (hDv j)
  have hhD := fun j : ℕ => hPF4 m (Λ j) (fun x => x) (φ j) (E j) (D j) (hid j) (hφL j) (hEc j)
    (hDim j) (hDv j)
  have hpZ := fun j : ℕ => hPF4 m (Λ j) (φ j) (φ j) (E j) (Z j) (hφL j) (hφL j) (hEc j)
    (hZim j) (hZv j)
  have hhZ := fun j : ℕ => hPF4 m (Λ j) (fun x => x) (φ j) (E j) (Z j) (hid j) (hφL j) (hEc j)
    (hZim j) (hZv j)
  -- `|x − φⱼ(x)| = |ψ(x) − x| ≤ √P` on `Eⱼ`
  have hδ : ∀ j, ∀ x ∈ E j, dist x (φ j x) ≤ Real.sqrt P := fun j x hx => by
    rw [hφψ j hx, dist_comm]
    exact hψdist j x hx
  -- Step 5(a), (b): `Λᵏ M(X) ≤ c₄ᵏ y (1/2)ᵉ M₀` from `Λ ≤ c₄2ʲ`, `M(X) ≤ y (1/2)ᵇ M₀`, `jk + e ≤ b`
  have key : ∀ (a κ y r : ℝ) (L : ℝ≥0∞) (j k b e : ℕ) (M M₀ : ℝ≥0∞),
      0 ≤ a → 0 ≤ κ → 0 ≤ y → L ≤ ENNReal.ofReal (κ * 2 ^ j) → j * k + e ≤ b →
      a * κ ^ k * y * (1 / 2) ^ e ≤ r → M ≤ ENNReal.ofReal (y * (1 / 2) ^ b) * M₀ →
      ENNReal.ofReal a * L ^ k * M ≤ ENNReal.ofReal r * M₀ := by
    intro a κ y r L j k b e M M₀ ha hκ hy hL hb hr hM
    have hκ2 : 0 ≤ κ * 2 ^ j := by positivity
    have hak : 0 ≤ a * (κ * 2 ^ j) ^ k := by positivity
    have hreal : a * (κ * 2 ^ j) ^ k * (y * (1 / 2) ^ b) ≤ r := by
      obtain ⟨l, rfl⟩ := Nat.exists_eq_add_of_le hb
      have h2 : (2 : ℝ) ^ (j * k) * (1 / 2) ^ (j * k) = 1 := by rw [← mul_pow]; norm_num
      calc a * (κ * 2 ^ j) ^ k * (y * (1 / 2) ^ (j * k + e + l))
          = a * κ ^ k * y * (1 / 2) ^ e * ((2 : ℝ) ^ (j * k) * (1 / 2) ^ (j * k)) *
              (1 / 2) ^ l := by
            rw [mul_pow, ← pow_mul, pow_add, pow_add]; ring
        _ ≤ a * κ ^ k * y * (1 / 2) ^ e := by
            rw [h2, mul_one]
            exact mul_le_of_le_one_right (by positivity) (pow_le_one₀ (by norm_num) (by norm_num))
        _ ≤ r := hr
    calc ENNReal.ofReal a * L ^ k * M
        ≤ ENNReal.ofReal a * ENNReal.ofReal (κ * 2 ^ j) ^ k *
            (ENNReal.ofReal (y * (1 / 2) ^ b) * M₀) := by gcongr
      _ = ENNReal.ofReal (a * (κ * 2 ^ j) ^ k * (y * (1 / 2) ^ b)) * M₀ := by
          rw [← ENNReal.ofReal_pow hκ2, ← ENNReal.ofReal_mul ha, ← mul_assoc,
            ← ENNReal.ofReal_mul hak]
      _ ≤ ENNReal.ofReal r * M₀ := by gcongr
  have keyP : ∀ (κ y r : ℝ) (L : ℝ≥0∞) (j k b e : ℕ) (M M₀ : ℝ≥0∞),
      0 ≤ κ → 0 ≤ y → L ≤ ENNReal.ofReal (κ * 2 ^ j) → j * k + e ≤ b →
      κ ^ k * y * (1 / 2) ^ e ≤ r → M ≤ ENNReal.ofReal (y * (1 / 2) ^ b) * M₀ →
      L ^ k * M ≤ ENNReal.ofReal r * M₀ := by
    intro κ y r L j k b e M M₀ hκ hy hL hb hr hM
