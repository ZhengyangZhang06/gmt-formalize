  have hnorm0 : ∀ f, MemLp f 2 μ → ‖toH₀ f‖ ^ 2 = ∫ x, ‖f x‖ ^ 2 ∂μ := fun f hf => by
    rw [hnorm]
    refine integral_congr_ae ?_
    filter_upwards [hcoe f hf] with x h1
    rw [h1]
  have hipH : ∀ u v : Fin m → Euclid m → Euclid k, (∀ j, MemLp (u j) 2 μ) →
