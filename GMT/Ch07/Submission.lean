      have hβball : ∀ τ : ℝ, a + (c * Real.sin (τ / c)) • w ∈ ball (0 : Euclid m) s := by
        intro τ
        rw [mem_ball_zero_iff]
        have h1 : |c * Real.sin (τ / c)| ≤ c := by
          rw [abs_mul, abs_of_pos hc]
