          have hinter : μ (⋂ m : ℕ, K \ ⋃ j ∈ Finset.range m, A j) = 0 := by
            refine measure_mono_null ?_ hnull
            intro x hx
            rw [mem_iInter] at hx
            rw [← iUnion_disjointed, mem_compl_iff, mem_iUnion]
            rintro ⟨j, hj⟩
            exact (hx (j + 1)).2 (mem_iUnion₂.2 ⟨j, Finset.mem_range.2 (Nat.lt_succ_self j), hj⟩)
