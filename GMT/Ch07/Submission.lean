        hqι a y (hM2Gp hy)]
    · rw [indicator_of_notMem hyC,
        indicator_of_notMem (show y ∉ (fun y => ι a + y) ⁻¹' C from hyC)]
  · -- (ii) `B(ω) = ∫_E A(♭_g ω(t + ·)) dHᵏ(t)`
    have hflateq : flat = ⇑flatL := funext fun α => ContinuousAlternatingMap.ext fun v => by
