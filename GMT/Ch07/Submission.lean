  -- Step 5(c): `Σⱼ aⱼ ≤ (A₀ + 2B) M₀` if `a₀ ≤ A₀ M₀` and `a_{j+1} ≤ B (1/2)ʲ M₀`
  have hgeom : ∀ b : ℝ, 0 ≤ b →
