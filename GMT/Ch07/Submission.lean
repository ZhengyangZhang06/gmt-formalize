/-- **Harmonic approximation with affine decay** (Simon Ch. 5, Lemma 3.1 and estimates 3.2–3.4, as
used in (17')–(19') of the Allard graph proof).  Take the harmonic approximation `h` of `w` on
`B̆_{R₀}(0)` (`dorag_ha_approximation`), `a = h(0)` and `b = Dh(0)`.  The interior estimates
(`dorag_ha_interior_estimates`, constant `C_H`) give `‖b‖ ≤ C_H`, `|a| ≤ C_H (R₀⁻ⁿ∫h²)^{1/2}` and
`|h(v) − a − b(v)| ≤ C_H|v|²/R₀` for `|v| ≤ R₀/4`; with `h² ≤ 2w² + 2(h − w)²` and
`(w − a − b)² ≤ 2(h − w)² + 2(h − a − b)²` this gives the claim for `C = max(√2·C_H, 2, 2ωₙC_H²)`
and `δ_h = δ(ε')`. -/
theorem Submission.dorag_harmonic_affine_approximation : ∀ n : ℕ, 0 < n → ∃ C : ℝ, 0 < C ∧ ∀ ε' : ℝ, 0 < ε' → ∃ δh : ℝ, 0 < δh ∧ ∀ (R₀ : ℝ) (w : Euclid n → ℝ) (Lw : NNReal), 0 < R₀ → LipschitzWith Lw w → ∫ v in ball (0 : Euclid n) R₀, ‖fderiv ℝ w v‖ ^ 2 ≤ R₀ ^ n → (∀ ζ : Euclid n → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ → tsupport ζ ⊆ ball (0 : Euclid n) R₀ → ∀ G : ℝ, (∀ v, ‖fderiv ℝ ζ v‖ ≤ G) → |∫ v in ball (0 : Euclid n) R₀, ∑ i : Fin n, fderiv ℝ w v (EuclideanSpace.single i (1 : ℝ)) * fderiv ℝ ζ v (EuclideanSpace.single i (1 : ℝ))| ≤ δh * R₀ ^ n * G) → ∃ (a : ℝ) (b : Euclid n →L[ℝ] ℝ), ‖b‖ ≤ C ∧ |a| ≤ C * Real.sqrt ((∫ v in ball (0 : Euclid n) R₀, w v ^ 2) / R₀ ^ n) + C * Real.sqrt ε' * R₀ ∧ ∀ θ' : ℝ, 0 < θ' → θ' ≤ 1 / 4 → ∫ v in ball (0 : Euclid n) (θ' * R₀), (w v - a - b v) ^ 2 ≤ C * (ε' / θ' ^ (n + 2) + θ' ^ 2) * (θ' * R₀) ^ (n + 2) := by
  intro n hn
  obtain ⟨CH, hCH, hest⟩ := Submission.dorag_ha_interior_estimates n hn
  -- `C = max(√2·C_H, 2, 2ωₙC_H²)` with `ωₙ = Lⁿ(B̆₁(0))`
  obtain ⟨C, hC1, hC2, hC3⟩ : ∃ C : ℝ, Real.sqrt 2 * CH ≤ C ∧ 2 ≤ C ∧
      2 * (volume (ball (0 : Euclid n) 1)).toReal * CH ^ 2 ≤ C :=
    ⟨max (Real.sqrt 2 * CH) (max 2 (2 * (volume (ball (0 : Euclid n) 1)).toReal * CH ^ 2)),
      le_max_left _ _, (le_max_left _ _).trans (le_max_right _ _),
      (le_max_right _ _).trans (le_max_right _ _)⟩
  have hsqrt2 : (1 : ℝ) ≤ Real.sqrt 2 := Real.one_le_sqrt.mpr (by norm_num)
  have hCHC : CH ≤ C := le_trans (by nlinarith) hC1
  refine ⟨C, by linarith, fun ε' hε' => ?_⟩
  obtain ⟨δ, hδ, happrox⟩ := Submission.dorag_ha_approximation n hn ε' hε'
  refine ⟨δ, hδ, fun R₀ w Lw hR₀ hLw hEw hζ => ?_⟩
  -- the harmonic approximation `h` of `w` on `B̆_{R₀}(0)`
  obtain ⟨h, hsmooth, hharm, hDhint, hDh, hdint, hdist⟩ := happrox R₀ w Lw hR₀ hLw hEw hζ
  -- `w` is continuous, so `w²` is integrable on the bounded ball; `h² ≤ 2w² + 2(h − w)²`
  have hwint : IntegrableOn (fun v => w v ^ 2) (ball (0 : Euclid n) R₀) :=
    ((hLw.continuous.pow 2).continuousOn.integrableOn_compact
      (isCompact_closedBall 0 R₀)).mono_set ball_subset_closedBall
  have hbound : ∀ v, h v ^ 2 ≤ 2 * w v ^ 2 + 2 * (h v - w v) ^ 2 := fun v => by
    nlinarith [sq_nonneg (h v - 2 * w v)]
  have hgint : IntegrableOn (fun v => 2 * w v ^ 2 + 2 * (h v - w v) ^ 2)
      (ball (0 : Euclid n) R₀) :=
    (hwint.const_mul 2).add (hdint.const_mul 2)
  have hhint : IntegrableOn (fun v => h v ^ 2) (ball (0 : Euclid n) R₀) := by
    refine hgint.mono' (((hsmooth 0).continuousOn.pow 2).aestronglyMeasurable measurableSet_ball)
      (Eventually.of_forall fun v => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
    exact hbound v
  obtain ⟨ha, hb, htaylor⟩ := hest R₀ h hR₀ hsmooth hharm hDhint hDh hhint
  refine ⟨h 0, fderiv ℝ h 0, hb.trans hCHC, ?_, ?_⟩
  · -- `|a| ≤ C_H (R₀⁻ⁿ∫h²)^{1/2} ≤ √2·C_H ((R₀⁻ⁿ∫w²)^{1/2} + √ε'·R₀)`
    set X := (∫ v in ball (0 : Euclid n) R₀, w v ^ 2) / R₀ ^ n with hX
    have hX0 : 0 ≤ X :=
      div_nonneg (setIntegral_nonneg measurableSet_ball fun v _ => sq_nonneg _) (by positivity)
    have hIh : ∫ v in ball (0 : Euclid n) R₀, h v ^ 2 ≤
        2 * (∫ v in ball (0 : Euclid n) R₀, w v ^ 2) +
          2 * ∫ v in ball (0 : Euclid n) R₀, (h v - w v) ^ 2 := by
      calc ∫ v in ball (0 : Euclid n) R₀, h v ^ 2
          ≤ ∫ v in ball (0 : Euclid n) R₀, (2 * w v ^ 2 + 2 * (h v - w v) ^ 2) :=
            setIntegral_mono hhint hgint hbound
        _ = 2 * (∫ v in ball (0 : Euclid n) R₀, w v ^ 2) +
              2 * ∫ v in ball (0 : Euclid n) R₀, (h v - w v) ^ 2 := by
            rw [integral_add (hwint.const_mul 2) (hdint.const_mul 2), integral_const_mul,
              integral_const_mul]
    have hquot : (∫ v in ball (0 : Euclid n) R₀, h v ^ 2) / R₀ ^ n ≤
        2 * X + 2 * (ε' * R₀ ^ 2) := by
      rw [div_le_iff₀ (by positivity), hX]
      calc ∫ v in ball (0 : Euclid n) R₀, h v ^ 2
          ≤ 2 * (∫ v in ball (0 : Euclid n) R₀, w v ^ 2) + 2 * (ε' * R₀ ^ (n + 2)) := by
            linarith
        _ = (2 * ((∫ v in ball (0 : Euclid n) R₀, w v ^ 2) / R₀ ^ n) + 2 * (ε' * R₀ ^ 2)) *
              R₀ ^ n := by
            field_simp
            ring
    -- `√(x + y) ≤ √x + √y`
    have hsqrt_add : ∀ x y : ℝ, 0 ≤ x → 0 ≤ y → Real.sqrt (x + y) ≤ Real.sqrt x + Real.sqrt y :=
      fun x y hx hy => by
        rw [Real.sqrt_le_left (by positivity)]
        nlinarith [Real.sq_sqrt hx, Real.sq_sqrt hy, Real.sqrt_nonneg x, Real.sqrt_nonneg y,
          mul_nonneg (Real.sqrt_nonneg x) (Real.sqrt_nonneg y)]
    have hsqrt : Real.sqrt ((∫ v in ball (0 : Euclid n) R₀, h v ^ 2) / R₀ ^ n) ≤
        Real.sqrt 2 * Real.sqrt X + Real.sqrt 2 * (Real.sqrt ε' * R₀) := by
      calc Real.sqrt ((∫ v in ball (0 : Euclid n) R₀, h v ^ 2) / R₀ ^ n)
          ≤ Real.sqrt (2 * X + 2 * (ε' * R₀ ^ 2)) := Real.sqrt_le_sqrt hquot
        _ ≤ Real.sqrt (2 * X) + Real.sqrt (2 * (ε' * R₀ ^ 2)) :=
            hsqrt_add _ _ (by positivity) (by positivity)
        _ = Real.sqrt 2 * Real.sqrt X + Real.sqrt 2 * (Real.sqrt ε' * R₀) := by
            rw [Real.sqrt_mul zero_le_two, Real.sqrt_mul zero_le_two, Real.sqrt_mul hε'.le,
              Real.sqrt_sq hR₀.le]
    calc |h 0| ≤ CH * Real.sqrt ((∫ v in ball (0 : Euclid n) R₀, h v ^ 2) / R₀ ^ n) := ha
      _ ≤ CH * (Real.sqrt 2 * Real.sqrt X + Real.sqrt 2 * (Real.sqrt ε' * R₀)) :=
          mul_le_mul_of_nonneg_left hsqrt hCH.le
      _ = Real.sqrt 2 * CH * Real.sqrt X + Real.sqrt 2 * CH * Real.sqrt ε' * R₀ := by ring
      _ ≤ C * Real.sqrt X + C * Real.sqrt ε' * R₀ := by gcongr
  · -- `∫_{B̆_{θ'R₀}} (w − a − b)² ≤ 2∫_{B̆_{R₀}} (h − w)² + 2 Lⁿ(B̆_{θ'R₀}) (C_H (θ'R₀)²/R₀)²`
    intro θ' hθ' hθ'4
    have hr : 0 < θ' * R₀ := mul_pos hθ' hR₀
    have hsub : ball (0 : Euclid n) (θ' * R₀) ⊆ ball 0 R₀ := ball_subset_ball (by nlinarith)
    have hpt : ∀ v ∈ ball (0 : Euclid n) (θ' * R₀), (w v - h 0 - fderiv ℝ h 0 v) ^ 2 ≤
        2 * (h v - w v) ^ 2 + 2 * (CH * (θ' * R₀) ^ 2 / R₀) ^ 2 := by
      intro v hv
      have hv' : ‖v‖ ≤ θ' * R₀ := (mem_ball_zero_iff.mp hv).le
      have h1 : |h v - h 0 - fderiv ℝ h 0 v| ≤ CH * (θ' * R₀) ^ 2 / R₀ :=
        (htaylor v (by nlinarith)).trans (by gcongr)
      have h2 : (h v - h 0 - fderiv ℝ h 0 v) ^ 2 ≤ (CH * (θ' * R₀) ^ 2 / R₀) ^ 2 := by
        rw [← sq_abs]
        exact pow_le_pow_left₀ (abs_nonneg _) h1 2
      nlinarith [sq_nonneg ((h v - w v) + (h v - h 0 - fderiv ℝ h 0 v))]
    have hdint' : IntegrableOn (fun v => (h v - w v) ^ 2) (ball (0 : Euclid n) (θ' * R₀)) :=
      hdint.mono_set hsub
    have hcint : IntegrableOn (fun _ : Euclid n => 2 * (CH * (θ' * R₀) ^ 2 / R₀) ^ 2)
        (ball (0 : Euclid n) (θ' * R₀)) :=
      integrableOn_const measure_ball_lt_top.ne
    have hvol : volume.real (ball (0 : Euclid n) (θ' * R₀)) =
        (θ' * R₀) ^ n * (volume (ball (0 : Euclid n) 1)).toReal := by
      rw [measureReal_def, Measure.addHaar_ball_of_pos volume 0 hr, finrank_euclideanSpace_fin,
        ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity)]
    have hsmall : ∫ v in ball (0 : Euclid n) (θ' * R₀), (h v - w v) ^ 2 ≤ ε' * R₀ ^ (n + 2) :=
      (setIntegral_mono_set hdint (Eventually.of_forall fun v => sq_nonneg _)
        hsub.eventuallyLE).trans hdist
    calc ∫ v in ball (0 : Euclid n) (θ' * R₀), (w v - h 0 - fderiv ℝ h 0 v) ^ 2
        ≤ ∫ v in ball (0 : Euclid n) (θ' * R₀),
            (2 * (h v - w v) ^ 2 + 2 * (CH * (θ' * R₀) ^ 2 / R₀) ^ 2) :=
          integral_mono_of_nonneg (Eventually.of_forall fun v => sq_nonneg _)
            ((hdint'.const_mul 2).add hcint) (ae_restrict_of_forall_mem measurableSet_ball hpt)
      _ = 2 * (∫ v in ball (0 : Euclid n) (θ' * R₀), (h v - w v) ^ 2) +
            2 * (CH * (θ' * R₀) ^ 2 / R₀) ^ 2 *
              ((θ' * R₀) ^ n * (volume (ball (0 : Euclid n) 1)).toReal) := by
          rw [integral_add (hdint'.const_mul 2) hcint, setIntegral_const, integral_const_mul, hvol,
            smul_eq_mul]
          ring
      _ ≤ 2 * (ε' * R₀ ^ (n + 2)) +
            2 * (CH * (θ' * R₀) ^ 2 / R₀) ^ 2 *
              ((θ' * R₀) ^ n * (volume (ball (0 : Euclid n) 1)).toReal) := by
          gcongr
      _ = 2 * (ε' / θ' ^ (n + 2)) * (θ' * R₀) ^ (n + 2) +
            2 * (volume (ball (0 : Euclid n) 1)).toReal * CH ^ 2 * θ' ^ 2 *
              (θ' * R₀) ^ (n + 2) := by
          field_simp
          ring
      _ ≤ C * (ε' / θ' ^ (n + 2)) * (θ' * R₀) ^ (n + 2) + C * θ' ^ 2 * (θ' * R₀) ^ (n + 2) := by
          gcongr
      _ = C * (ε' / θ' ^ (n + 2) + θ' ^ 2) * (θ' * R₀) ^ (n + 2) := by ring
/-- Facts about `D = δ^{1/(2n+2)}` used in the tilt-excess decay step: if `δ ≤ min(1, η^{2n+2})`
then `0 < D ≤ η`, `δ ≤ D` and `√δ ≤ D`. -/
theorem Submission.dorag_tesDecay_rpow (n : ℕ) (δ η : ℝ) (hδ : 0 < δ) (hδ1 : δ ≤ 1) (hη : 0 < η)
    (hδη : δ ≤ η ^ (2 * n + 2)) :
    0 < δ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2)) ∧ δ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2)) ≤ η ∧
      δ ≤ δ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2)) ∧ Real.sqrt δ ≤ δ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2)) := by
  have hα : (1 : ℝ) / (2 * (n : ℝ) + 2) = (((2 * n + 2 : ℕ) : ℝ))⁻¹ := by
    push_cast
    ring
  have hαpos : 0 < (1 : ℝ) / (2 * (n : ℝ) + 2) := by positivity
  have hα2 : (1 : ℝ) / (2 * (n : ℝ) + 2) ≤ 1 / 2 := by
    rw [div_le_div_iff₀ (by positivity) (by norm_num)]
    nlinarith [(Nat.cast_nonneg n : (0 : ℝ) ≤ n)]
  refine ⟨Real.rpow_pos_of_pos hδ _, ?_, ?_, ?_⟩
  · calc δ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2))
        ≤ (η ^ (2 * n + 2)) ^ ((1 : ℝ) / (2 * (n : ℝ) + 2)) :=
          Real.rpow_le_rpow hδ.le hδη hαpos.le
      _ = η := by rw [hα, Real.pow_rpow_inv_natCast hη.le (by omega)]
  · calc δ = δ ^ (1 : ℝ) := (Real.rpow_one δ).symm
      _ ≤ δ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2)) :=
          Real.rpow_le_rpow_of_exponent_ge hδ hδ1 (by linarith)
  · rw [Real.sqrt_eq_rpow]
    exact Real.rpow_le_rpow_of_exponent_ge hδ hδ1 hα2

/-- The height bound produced by the plane reduction of Step 1:
`2C₃Dσ + (4a/M)^{1/2}σ = C₁₁Dσ` for `a = C₃D²σⁿ`, `M = ω_nσⁿ/2`. -/
theorem Submission.dorag_tesDecay_height_const (n : ℕ) (C₃ ω D σ : ℝ) (hC₃ : 0 ≤ C₃) (hω : 0 < ω)
    (hD : 0 ≤ D) (hσ : 0 < σ) :
    C₃ * D * (2 * σ) + Real.sqrt (4 * (C₃ * D ^ 2 * σ ^ n) / (ω * σ ^ n / 2)) * σ =
      (2 * C₃ + Real.sqrt (8 * C₃ / ω)) * D * σ := by
  have hσn : 0 < σ ^ n := pow_pos hσ n
  have h1 : 4 * (C₃ * D ^ 2 * σ ^ n) / (ω * σ ^ n / 2) = 8 * C₃ / ω * D ^ 2 := by
    field_simp
    ring
  rw [h1, Real.sqrt_mul (by positivity), Real.sqrt_sq hD]
  ring

/-- A finite `[0, ∞]` quantity bounded by `ofReal a` is `ofReal I` for a real `0 ≤ I ≤ a`. -/
theorem Submission.dorag_tesDecay_real_of_le {J : ℝ≥0∞} {a : ℝ} (ha : 0 ≤ a)
    (h : J ≤ ENNReal.ofReal a) : ∃ I : ℝ, 0 ≤ I ∧ ENNReal.ofReal I = J ∧ I ≤ a :=
  ⟨J.toReal, ENNReal.toReal_nonneg, ENNReal.ofReal_toReal (ne_top_of_le_ne_top ENNReal.ofReal_ne_top h),
    ENNReal.toReal_le_of_le_ofReal ha h⟩

/-- Step 1, the normalised excess `E₀ = max(σ⁻ⁿI, κ²σ²/δ)` (`I = ∫_{B_σ(ξ)}|p_x − p_{T'}|² dμ`):
`I ≤ σⁿE₀`, `κ²σ² ≤ δE₀`, `E₀ ≤ C₃D²` (as `κσ ≤ δ²`) and `κσ ≤ D E₀^{1/2}` (as `δ^{1/2} ≤ D`). -/
theorem Submission.dorag_tesDecay_excess_facts (n : ℕ) (C₃ D δ E₀ I κ ρ σ : ℝ) (hδ : 0 < δ)
    (hδ8 : δ ≤ 1 / 8) (hσ : 0 < σ) (hσδρ : σ ≤ δ * ρ) (hκ : 0 ≤ κ) (hκρ : κ * ρ ≤ δ)
    (hC₃ : 1 ≤ C₃) (hδD : δ ≤ D) (hsδD : Real.sqrt δ ≤ D)
    (hIa : I ≤ C₃ * D ^ 2 * σ ^ n) (hE₀def : E₀ = max (1 / σ ^ n * I) (κ ^ 2 * σ ^ 2 / δ)) :
    0 ≤ E₀ ∧ I ≤ σ ^ n * E₀ ∧ κ ^ 2 * σ ^ 2 ≤ δ * E₀ ∧ E₀ ≤ C₃ * D ^ 2 ∧
      κ * σ ≤ D * Real.sqrt E₀ := by
  have hE₀1 : 1 / σ ^ n * I ≤ E₀ := hE₀def ▸ le_max_left _ _
  have hE₀2 : κ ^ 2 * σ ^ 2 / δ ≤ E₀ := hE₀def ▸ le_max_right _ _
  have hσn : 0 < σ ^ n := pow_pos hσ n
  have hκE : κ ^ 2 * σ ^ 2 ≤ δ * E₀ := by
    calc κ ^ 2 * σ ^ 2 = δ * (κ ^ 2 * σ ^ 2 / δ) := by field_simp
      _ ≤ δ * E₀ := by gcongr
  refine ⟨le_trans (by positivity) hE₀2, ?_, hκE, ?_, ?_⟩
  · calc I = σ ^ n * (1 / σ ^ n * I) := by field_simp
      _ ≤ σ ^ n * E₀ := by gcongr
  · rw [hE₀def]
    apply max_le
    · calc 1 / σ ^ n * I ≤ 1 / σ ^ n * (C₃ * D ^ 2 * σ ^ n) := by gcongr
        _ = C₃ * D ^ 2 := by field_simp
    · have hκσ : κ * σ ≤ δ * δ := by
        calc κ * σ ≤ κ * (δ * ρ) := by gcongr
          _ = δ * (κ * ρ) := by ring
          _ ≤ δ * δ := by gcongr
      have h1 : κ ^ 2 * σ ^ 2 ≤ δ ^ 4 := by
        calc κ ^ 2 * σ ^ 2 = (κ * σ) ^ 2 := by ring
          _ ≤ (δ * δ) ^ 2 := pow_le_pow_left₀ (mul_nonneg hκ hσ.le) hκσ 2
          _ = δ ^ 4 := by ring
      have h3 : δ ^ 3 ≤ D ^ 2 := by
        calc δ ^ 3 ≤ δ ^ 2 := pow_le_pow_of_le_one hδ.le (by linarith) (by norm_num)
          _ ≤ D ^ 2 := pow_le_pow_left₀ hδ.le hδD 2
      rw [div_le_iff₀ hδ]
      calc κ ^ 2 * σ ^ 2 ≤ δ ^ 4 := h1
        _ = δ ^ 3 * δ := by ring
        _ ≤ D ^ 2 * δ := by gcongr
        _ = 1 * (D ^ 2 * δ) := by ring
        _ ≤ C₃ * (D ^ 2 * δ) := by gcongr
        _ = C₃ * D ^ 2 * δ := by ring
  · rw [← Real.sqrt_sq (mul_nonneg hκ hσ.le)]
    calc Real.sqrt ((κ * σ) ^ 2) ≤ Real.sqrt (δ * E₀) :=
          Real.sqrt_le_sqrt (by rw [mul_pow]; exact hκE)
      _ = Real.sqrt δ * Real.sqrt E₀ := Real.sqrt_mul hδ.le _
      _ ≤ D * Real.sqrt E₀ := by gcongr

/-- Step 11: `θE₀ = θE_*(ξ, σ, T')` is at most `θE_*(ξ, σ, T)` when `E(ξ, σ, T') ≤ E(ξ, σ, T)`. -/
theorem Submission.dorag_tesDecay_rhs (θ E₀ a b I : ℝ) (J : ℝ≥0∞) (hθ : 0 ≤ θ) (ha : 0 ≤ a)
    (hE₀ : E₀ = max (a * I) b) (hI : ENNReal.ofReal I ≤ J) :
    ENNReal.ofReal (θ * E₀) ≤ ENNReal.ofReal θ * max (ENNReal.ofReal a * J) (ENNReal.ofReal b) := by
  rw [ENNReal.ofReal_mul hθ, hE₀, ENNReal.ofReal_max, ENNReal.ofReal_mul ha]
  gcongr

/-- `μ_V = θ Hⁿ⌞M ≪ Hⁿ⌞M`: an `Hⁿ⌞(M ∩ W)`-a.e. property holds `μ_V`-a.e. on `W`. -/
theorem Submission.dorag_tesDecay_ae_of_carrier {P n : ℕ} {U W : Set (Euclid P)} (R : IMRep U n)
    (hW : MeasurableSet W) {p : Euclid P → Prop}
    (h : ∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ W)), p x) : ∀ᵐ x ∂R.measure, x ∈ W → p x := by
  have h1 : ∀ᵐ x ∂(μHE[n].restrict R.carrier), x ∈ W → p x := by
    rw [← ae_restrict_iff' hW, Measure.restrict_restrict hW, Set.inter_comm]
    exact h
  exact (withDensity_absolutelyContinuous _ _).ae_le h1

/-- The energy normalisation of Step 7: `s⁻²(2 + C₇)I ≤ (σ/8)ⁿ` for `s² = (2 + C₇)8ⁿE₀`. -/
theorem Submission.dorag_tesDecay_energy_real (n : ℕ) (C₇ E₀ I σ : ℝ) (hC₇ : 0 < C₇) (hE₀ : 0 < E₀)
    (hσ : 0 < σ) (hIle : I ≤ σ ^ n * E₀) :
    (Real.sqrt ((2 + C₇) * 8 ^ n * E₀))⁻¹ ^ 2 * (2 * I + C₇ * I) ≤ (σ / 4 / 2) ^ n := by
  have hpos : 0 < (2 + C₇) * 8 ^ n * E₀ := by positivity
  rw [inv_pow, Real.sq_sqrt hpos.le]
  have h8 : (σ / 4 / 2) ^ n = σ ^ n / 8 ^ n := by
    rw [show σ / 4 / 2 = σ / 8 by ring, div_pow]
  rw [h8, inv_mul_le_iff₀ hpos]
  have h8pos : (0 : ℝ) < 8 ^ n := by positivity
  calc 2 * I + C₇ * I = (2 + C₇) * I := by ring
    _ ≤ (2 + C₇) * (σ ^ n * E₀) := by gcongr
    _ = (2 + C₇) * 8 ^ n * E₀ * (σ ^ n / 8 ^ n) := by field_simp

/-- The weak-form normalisation of Step 7 (Simon (15)–(17)): the right side of the weak equation
for `fʲ`, divided by `s = ((2 + C₇)8ⁿE₀)^{1/2}`, is at most `δ_h(σ/8)ⁿG`. -/
theorem Submission.dorag_tesDecay_weak_real (n k : ℕ) (C₃ C₇ ω D δh E₀ I κ σ G : ℝ)
    (hC₃ : 1 ≤ C₃) (hC₇ : 0 < C₇) (hω : 0 < ω) (hD : 0 ≤ D) (hE₀ : 0 < E₀) (hσ : 0 < σ)
    (hG : 0 ≤ G) (hIle : I ≤ σ ^ n * E₀) (hE₀le : E₀ ≤ C₃ * D ^ 2)
    (hκσ : κ * σ ≤ D * Real.sqrt E₀)
    (hδh : 8 ^ n * ((2 + 2 ^ (n + 1) * k) * (1 + C₇) * Real.sqrt C₃ + 2 * ω / 4 ^ (n + 1)) /
      Real.sqrt ((2 + C₇) * 8 ^ n) * D ≤ δh) :
    (Real.sqrt ((2 + C₇) * 8 ^ n * E₀))⁻¹ *
        (G * ((2 + 2 ^ (n + 1) * k) * (I + C₇ * I) + κ * (σ / 4) * (2 * ω * (σ / 4) ^ n))) ≤
      δh * (σ / 4 / 2) ^ n * G := by
  set r := Real.sqrt E₀ with hr
  have hrpos : 0 < r := Real.sqrt_pos.mpr hE₀
  have hrr : r * r = E₀ := Real.mul_self_sqrt hE₀.le
  have hC₁₃ : 0 < (2 + C₇) * 8 ^ n := by positivity
  have hsC : 0 < Real.sqrt ((2 + C₇) * 8 ^ n) := Real.sqrt_pos.mpr hC₁₃
  have hs : Real.sqrt ((2 + C₇) * 8 ^ n * E₀) = Real.sqrt ((2 + C₇) * 8 ^ n) * r := by
    rw [Real.sqrt_mul hC₁₃.le]
  have hsC₃ : 1 ≤ Real.sqrt C₃ := by
    rw [show (1 : ℝ) = Real.sqrt 1 by simp]
    exact Real.sqrt_le_sqrt hC₃
  -- `√E₀ ≤ √C₃ D`
  have hrD : r ≤ Real.sqrt C₃ * D := by
    rw [hr, ← Real.sqrt_sq hD, ← Real.sqrt_mul (by linarith)]
    exact Real.sqrt_le_sqrt hE₀le
  -- `I ≤ σⁿ √E₀ √C₃ D`
  have hI' : I ≤ σ ^ n * r * (Real.sqrt C₃ * D) := by
    calc I ≤ σ ^ n * E₀ := hIle
      _ = σ ^ n * r * r := by rw [← hrr]; ring
      _ ≤ σ ^ n * r * (Real.sqrt C₃ * D) := by gcongr
  set B := (2 + 2 ^ (n + 1) * k) * (1 + C₇) * Real.sqrt C₃ + 2 * ω / 4 ^ (n + 1) with hB
  have hX : (2 + 2 ^ (n + 1) * (k : ℝ)) * (I + C₇ * I) + κ * (σ / 4) * (2 * ω * (σ / 4) ^ n) ≤
      σ ^ n * r * D * B := by
    have h1 : (2 + 2 ^ (n + 1) * (k : ℝ)) * (I + C₇ * I) ≤
        (2 + 2 ^ (n + 1) * (k : ℝ)) * (1 + C₇) * (σ ^ n * r * (Real.sqrt C₃ * D)) := by
      have : (2 + 2 ^ (n + 1) * (k : ℝ)) * (I + C₇ * I) =
          (2 + 2 ^ (n + 1) * (k : ℝ)) * (1 + C₇) * I := by
        ring
      rw [this]
      gcongr
    have h2 : κ * (σ / 4) * (2 * ω * (σ / 4) ^ n) = (κ * σ) * (2 * ω * σ ^ n / 4 ^ (n + 1)) := by
      rw [div_pow, pow_succ]
      field_simp
    have h3 : (κ * σ) * (2 * ω * σ ^ n / 4 ^ (n + 1)) ≤ (D * r) * (2 * ω * σ ^ n / 4 ^ (n + 1)) := by
      gcongr
    calc (2 + 2 ^ (n + 1) * (k : ℝ)) * (I + C₇ * I) + κ * (σ / 4) * (2 * ω * (σ / 4) ^ n)
        ≤ (2 + 2 ^ (n + 1) * (k : ℝ)) * (1 + C₇) * (σ ^ n * r * (Real.sqrt C₃ * D)) +
            (D * r) * (2 * ω * σ ^ n / 4 ^ (n + 1)) := by rw [h2]; exact add_le_add h1 h3
      _ = σ ^ n * r * D * B := by rw [hB]; ring
  have h8 : (σ / 4 / 2) ^ n = σ ^ n / 8 ^ n := by
    rw [show σ / 4 / 2 = σ / 8 by ring, div_pow]
  have hB0 : 0 ≤ B := by positivity
  calc (Real.sqrt ((2 + C₇) * 8 ^ n * E₀))⁻¹ *
        (G * ((2 + 2 ^ (n + 1) * k) * (I + C₇ * I) + κ * (σ / 4) * (2 * ω * (σ / 4) ^ n)))
      ≤ (Real.sqrt ((2 + C₇) * 8 ^ n * E₀))⁻¹ * (G * (σ ^ n * r * D * B)) := by gcongr
    _ = (8 ^ n * B / Real.sqrt ((2 + C₇) * 8 ^ n) * D) * (σ / 4 / 2) ^ n * G := by
      rw [hs, h8]
      field_simp
    _ ≤ δh * (σ / 4 / 2) ^ n * G := by gcongr

/-- Step 7 (Simon (17)–(18)): for each component `fʲ` of the Lipschitz approximation, the
harmonic approximation lemma applied to `w = s⁻¹fʲ` on `Bⁿ_{σ/8}` gives an affine
`a + b` with `‖b‖ ≤ C_H`, `|a| ≤ C_H s⁻¹C₇Dσω^{1/2} + C_Hε'^{1/2}σ/8` and the `L²` decay
on `Bⁿ_{θ'σ/8}`. -/
theorem Submission.dorag_tesDecay_harmonic_step (n k : ℕ) (f : Euclid n → Euclid k)
    (C₃ C₇ CH ω D δh ε' E₀ I κ σ s θ' : ℝ)
    (hHA' : ∀ (R₀ : ℝ) (w : Euclid n → ℝ) (Lw : NNReal), 0 < R₀ → LipschitzWith Lw w →
      ∫ v in ball (0 : Euclid n) R₀, ‖fderiv ℝ w v‖ ^ 2 ≤ R₀ ^ n →
      (∀ ζ : Euclid n → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ →
        tsupport ζ ⊆ ball (0 : Euclid n) R₀ → ∀ G : ℝ, (∀ v, ‖fderiv ℝ ζ v‖ ≤ G) →
        |∫ v in ball (0 : Euclid n) R₀, ∑ i : Fin n, fderiv ℝ w v (EuclideanSpace.single i (1 : ℝ)) *
          fderiv ℝ ζ v (EuclideanSpace.single i (1 : ℝ))| ≤ δh * R₀ ^ n * G) →
      ∃ (a : ℝ) (b : Euclid n →L[ℝ] ℝ), ‖b‖ ≤ CH ∧
        |a| ≤ CH * Real.sqrt ((∫ v in ball (0 : Euclid n) R₀, w v ^ 2) / R₀ ^ n) +
          CH * Real.sqrt ε' * R₀ ∧
        ∀ θ' : ℝ, 0 < θ' → θ' ≤ 1 / 4 → ∫ v in ball (0 : Euclid n) (θ' * R₀), (w v - a - b v) ^ 2 ≤
          CH * (ε' / θ' ^ (n + 2) + θ' ^ 2) * (θ' * R₀) ^ (n + 2))
    (hGE : ∀ j : Fin k, ∫ v in ball (0 : Euclid n) (σ / 4 / 2),
      ‖fderiv ℝ (fun v => EuclideanSpace.proj j (f v)) v‖ ^ 2 ≤ 2 * I + C₇ * I)
    (hGW : ∀ (j : Fin k) (ζ : Euclid n → ℝ) (G : ℝ), ContDiff ℝ 1 ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ ball (0 : Euclid n) (σ / 4 / 2) → (∀ v, ‖fderiv ℝ ζ v‖ ≤ G) →
      |∫ v in ball (0 : Euclid n) (σ / 4 / 2), ∑ i : Fin n,
        fderiv ℝ (fun v => EuclideanSpace.proj j (f v)) v (EuclideanSpace.single i (1 : ℝ)) *
          fderiv ℝ ζ v (EuclideanSpace.single i (1 : ℝ))| ≤
        G * ((2 + 2 ^ (n + 1) * k) * (I + C₇ * I) + κ * (σ / 4) * (2 * ω * (σ / 4) ^ n)))
    (hf1 : ∀ v w, ‖f v - f w‖ ≤ ‖v - w‖) (hfb : ∀ v, ‖f v‖ ≤ C₇ * D * σ)
    (hsdef : s = Real.sqrt ((2 + C₇) * 8 ^ n * E₀))
    (hC₃ : 1 ≤ C₃) (hC₇ : 0 < C₇) (hCH : 0 < CH) (hω : 0 < ω) (hD : 0 ≤ D) (hE₀ : 0 < E₀)
    (hσ : 0 < σ) (hθ' : 0 < θ') (hθ'4 : θ' ≤ 1 / 4)
    (hIE : I ≤ σ ^ n * E₀) (hE₀le : E₀ ≤ C₃ * D ^ 2) (hκσE : κ * σ ≤ D * Real.sqrt E₀)
    (hD14 : 8 ^ n * ((2 + 2 ^ (n + 1) * k) * (1 + C₇) * Real.sqrt C₃ + 2 * ω / 4 ^ (n + 1)) /
      Real.sqrt ((2 + C₇) * 8 ^ n) * D ≤ δh)
    (hvol : volume.real (ball (0 : Euclid n) (σ / 4 / 2)) = (σ / 4 / 2) ^ n * ω) :
    ∀ j : Fin k, ∃ (a : ℝ) (b : Euclid n →L[ℝ] ℝ), ‖b‖ ≤ CH ∧
      |a| ≤ CH * (s⁻¹ * (C₇ * D * σ) * Real.sqrt ω) + CH * Real.sqrt ε' * (σ / 4 / 2) ∧
      ∫ v in ball (0 : Euclid n) (θ' * (σ / 4 / 2)),
          (s⁻¹ * EuclideanSpace.proj j (f v) - a - b v) ^ 2 ≤
        CH * (ε' / θ' ^ (n + 2) + θ' ^ 2) * (θ' * (σ / 4 / 2)) ^ (n + 2) := by
  intro j
  have hs : 0 < s := hsdef ▸ Real.sqrt_pos.mpr (by positivity)
  have hsi : 0 < s⁻¹ := inv_pos.mpr hs
  have hR₀ : 0 < σ / 4 / 2 := by positivity
  have hderiv : ∀ v, fderiv ℝ (fun v => s⁻¹ * EuclideanSpace.proj j (f v)) v =
      s⁻¹ • fderiv ℝ (fun v => EuclideanSpace.proj j (f v)) v := by
    intro v
    have : (fun v => s⁻¹ * EuclideanSpace.proj j (f v)) =
        s⁻¹ • fun v => EuclideanSpace.proj j (f v) := rfl
    rw [this, fderiv_const_smul_field]
    rfl
  have hproj : ∀ y : Euclid k, |EuclideanSpace.proj j y| ≤ ‖y‖ := fun y => by
    simpa using PiLp.norm_apply_le y j
  -- `w = s⁻¹fʲ` is `s⁻¹`-Lipschitz
  have hwLip : LipschitzWith (Real.toNNReal s⁻¹) (fun v => s⁻¹ * EuclideanSpace.proj j (f v)) := by
    refine LipschitzWith.of_dist_le_mul fun v w => ?_
    rw [Real.coe_toNNReal _ hsi.le, Real.dist_eq, dist_eq_norm, ← mul_sub, ← map_sub, abs_mul,
      abs_of_pos hsi]
    gcongr
    exact (hproj _).trans (hf1 v w)
  -- the energy of `w` on `Bⁿ_{σ/8}` is at most `(σ/8)ⁿ`
  have hwE : ∫ v in ball (0 : Euclid n) (σ / 4 / 2),
      ‖fderiv ℝ (fun v => s⁻¹ * EuclideanSpace.proj j (f v)) v‖ ^ 2 ≤ (σ / 4 / 2) ^ n := by
    simp_rw [hderiv, norm_smul, mul_pow, Real.norm_eq_abs, abs_of_pos hsi]
    rw [integral_const_mul]
    refine le_trans ?_ (Submission.dorag_tesDecay_energy_real n C₇ E₀ I σ hC₇ hE₀ hσ hIE)
    rw [← hsdef]
    exact mul_le_mul_of_nonneg_left (hGE j) (by positivity)
  -- `w` is weakly `δ_h`-harmonic on `Bⁿ_{σ/8}`
  have hwW : ∀ ζ : Euclid n → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ ball (0 : Euclid n) (σ / 4 / 2) → ∀ G : ℝ, (∀ v, ‖fderiv ℝ ζ v‖ ≤ G) →
      |∫ v in ball (0 : Euclid n) (σ / 4 / 2), ∑ i : Fin n,
        fderiv ℝ (fun v => s⁻¹ * EuclideanSpace.proj j (f v)) v (EuclideanSpace.single i (1 : ℝ)) *
          fderiv ℝ ζ v (EuclideanSpace.single i (1 : ℝ))| ≤ δh * (σ / 4 / 2) ^ n * G := by
    intro ζ hζ hζc hζs G hG
    have hG0 : 0 ≤ G := (norm_nonneg _).trans (hG 0)
    have h1 := hGW j ζ G hζ hζc hζs hG
    simp_rw [hderiv, smul_apply, smul_eq_mul, mul_assoc, ← Finset.mul_sum]
    rw [integral_const_mul, abs_mul, abs_of_pos hsi]
    refine le_trans (mul_le_mul_of_nonneg_left h1 hsi.le) ?_
    rw [hsdef]
    exact (Submission.dorag_tesDecay_weak_real n k C₃ C₇ ω D δh E₀ I κ σ G hC₃ hC₇ hω hD hE₀
      hσ hG0 hIE hE₀le hκσE hD14).trans_eq (mul_assoc _ _ _)
  obtain ⟨a, b, hb, ha, hab⟩ := hHA' (σ / 4 / 2) (fun v => s⁻¹ * EuclideanSpace.proj j (f v))
    (Real.toNNReal s⁻¹) hR₀ hwLip hwE hwW
  refine ⟨a, b, hb, ha.trans ?_, hab θ' hθ' hθ'4⟩
  -- `|a| ≤ A`, from `|w| ≤ s⁻¹C₇Dσ` on `Bⁿ_{σ/8}`
  gcongr
  have hw2 : ∫ v in ball (0 : Euclid n) (σ / 4 / 2), (s⁻¹ * EuclideanSpace.proj j (f v)) ^ 2 ≤
      (s⁻¹ * (C₇ * D * σ)) ^ 2 * ((σ / 4 / 2) ^ n * ω) := by
    refine (le_abs_self _).trans ?_
    rw [← Real.norm_eq_abs, ← hvol]
    refine norm_setIntegral_le_of_norm_le_const measure_ball_lt_top fun v _ => ?_
    rw [Real.norm_eq_abs, abs_pow, abs_mul, abs_of_pos hsi]
    gcongr
    exact (hproj _).trans (hfb v)
  calc Real.sqrt ((∫ v in ball (0 : Euclid n) (σ / 4 / 2),
        (s⁻¹ * EuclideanSpace.proj j (f v)) ^ 2) / (σ / 4 / 2) ^ n)
      ≤ Real.sqrt ((s⁻¹ * (C₇ * D * σ)) ^ 2 * ω) := by
        apply Real.sqrt_le_sqrt
        rw [div_le_iff₀ (by positivity)]
        exact hw2.trans_eq (by ring)
    _ = s⁻¹ * (C₇ * D * σ) * Real.sqrt ω := by
        rw [Real.sqrt_mul (by positivity), Real.sqrt_sq (by positivity)]

/-- Bounds on the affine data `c, Λ` of Step 8 (Simon (18)): `|c| ≤ C₁₅DR₀` and
`‖Λ‖ ≤ kC_H(C₁₃C₃)^{1/2}D`, `R₀ = σ/8`. -/
theorem Submission.dorag_tesDecay_affine_consts (k : ℕ) (C₃ C₁₃ C₇ CH ω D E₀ ε' σ s A c Λ : ℝ)
    (hs : s = Real.sqrt (C₁₃ * E₀)) (hE₀ : 0 < E₀) (hE₀le : E₀ ≤ C₃ * D ^ 2) (hC₃ : 0 ≤ C₃)
    (hC₁₃ : 0 < C₁₃) (hD : 0 ≤ D) (hε'1 : ε' ≤ 1) (hCH : 0 < CH) (hC₇ : 0 < C₇) (hω : 0 < ω)
    (hσ : 0 < σ)
    (hA : A = CH * (s⁻¹ * (C₇ * D * σ) * Real.sqrt ω) + CH * Real.sqrt ε' * (σ / 4 / 2))
    (hc : c ≤ k * s * A) (hΛ : Λ ≤ k * s * CH) :
    c ≤ (k + 1) * CH * (8 * C₇ * Real.sqrt ω + Real.sqrt (C₁₃ * C₃)) * D * (σ / 4 / 2) ∧
      Λ ≤ k * CH * Real.sqrt (C₁₃ * C₃) * D := by
  have hspos : 0 < s := by rw [hs]; exact Real.sqrt_pos.mpr (mul_pos hC₁₃ hE₀)
  have hsle : s ≤ Real.sqrt (C₁₃ * C₃) * D := by
    rw [hs, ← Real.sqrt_sq hD, ← Real.sqrt_mul (by positivity)]
    exact Real.sqrt_le_sqrt (by rw [mul_assoc]; gcongr)
  have hε's : Real.sqrt ε' ≤ 1 := by
    rw [show (1 : ℝ) = Real.sqrt 1 by simp]
    exact Real.sqrt_le_sqrt hε'1
  have hkA : (k : ℝ) * s * A ≤
      k * CH * (8 * C₇ * Real.sqrt ω + Real.sqrt (C₁₃ * C₃)) * D * (σ / 4 / 2) := by
    have h1 : (k : ℝ) * s * A =
        k * (CH * (C₇ * D * σ) * Real.sqrt ω + s * (CH * Real.sqrt ε' * (σ / 4 / 2))) := by
      rw [hA]
      field_simp
    rw [h1]
    have h3 : (k : ℝ) * (CH * (C₇ * D * σ) * Real.sqrt ω + s * (CH * Real.sqrt ε' * (σ / 4 / 2))) ≤
        k * (CH * (C₇ * D * σ) * Real.sqrt ω +
          (Real.sqrt (C₁₃ * C₃) * D) * (CH * 1 * (σ / 4 / 2))) := by
      gcongr
    refine h3.trans (le_of_eq ?_)
    ring
  constructor
  · refine hc.trans (hkA.trans ?_)
    gcongr
    linarith
  · refine hΛ.trans ?_
    calc (k : ℝ) * s * CH ≤ k * (Real.sqrt (C₁₃ * C₃) * D) * CH := by gcongr
      _ = k * CH * Real.sqrt (C₁₃ * C₃) * D := by ring

/-- The final real inequality of Steps 9–10 (Simon (20)–(23)), with `R₀ = σ/8`, `t = θ'R₀`:
`(θ₀σ)^{-n}C_T(t^{-2}((1 + n2ⁿ)ks²Q + K²C₇I) + κ²t²·2ωtⁿ) ≤ θ₀E₀`, `θ₀ = θ'/32`. -/
theorem Submission.dorag_tesDecay_final_real (n k : ℕ)
    (CT CH C₇ C₁₃ C₁₇ C₁₆ ω θ' ε' D δ E₀ I s Q K σ R₀ t κ : ℝ)
    (hCT : 0 < CT) (hCH : 0 < CH) (hC₇ : 0 < C₇) (hC₁₃ : 0 < C₁₃) (hω : 0 < ω)
    (hθ' : 0 < θ') (hθ'4 : θ' ≤ 1 / 4) (hε' : 0 ≤ ε') (hδ : 0 ≤ δ) (hE₀ : 0 ≤ E₀)
    (hR₀ : 0 < R₀) (hσ : σ = 8 * R₀) (ht : t = θ' * R₀) (hs : s ^ 2 = C₁₃ * E₀)
    (hQ : Q = CH * (ε' / θ' ^ (n + 2) + θ' ^ 2) * t ^ (n + 2))
    (hK : 0 ≤ K) (hKle : K ≤ C₁₇ * D * R₀) (hI : 0 ≤ I) (hIle : I ≤ σ ^ n * E₀)
    (hκ : κ ^ 2 * σ ^ 2 ≤ δ * E₀)
    (hC₁₆ : C₁₆ = 4 ^ n * CT * ((1 + n * 2 ^ n) * (k + 1) * CH * C₁₃ + C₁₇ ^ 2 * C₇ * 8 ^ n +
      2 * ω))
    (h1 : C₁₆ * θ' ^ 2 ≤ θ' / 128) (h2 : C₁₆ * (ε' / θ' ^ (n + 2)) ≤ θ' / 128)
    (h3 : C₁₆ * (D ^ 2 / θ' ^ (n + 2)) ≤ θ' / 128) (h4 : C₁₆ * δ ≤ θ' / 128) :
    1 / (θ' / 32 * σ) ^ n * (CT * (1 / t ^ 2 * ((1 + n * 2 ^ n) * (k * s ^ 2 * Q) +
      K ^ 2 * (C₇ * I)) + κ ^ 2 * t ^ 2 * (2 * ω * t ^ n))) ≤ θ' / 32 * E₀ := by
  subst hσ ht
  set t := θ' * R₀ with ht
  have htpos : 0 < t := mul_pos hθ' hR₀
  have hθ'pos : 0 < θ' ^ (n + 2) := pow_pos hθ' _
  have hpre : 1 / (θ' / 32 * (8 * R₀)) ^ n = 4 ^ n / t ^ n := by
    rw [show θ' / 32 * (8 * R₀) = t / 4 by rw [ht]; ring, div_pow]
    field_simp
  have htn : 0 < t ^ n := pow_pos htpos n
  set a := ε' / θ' ^ (n + 2) with ha
  set b := D ^ 2 / θ' ^ (n + 2) with hb
  have ha0 : 0 ≤ a := by positivity
  have hb0 : 0 ≤ b := by positivity
  -- the three terms
  have hT1 : 4 ^ n / t ^ n * (CT * (1 / t ^ 2 * ((1 + n * 2 ^ n) * (k * s ^ 2 * Q)))) =
      4 ^ n * CT * ((1 + n * 2 ^ n) * k * CH * C₁₃) * (a + θ' ^ 2) * E₀ := by
    rw [hs, hQ]
    field_simp
    ring
  have hT2 : 4 ^ n / t ^ n * (CT * (1 / t ^ 2 * (K ^ 2 * (C₇ * I)))) ≤
      4 ^ n * CT * (C₁₇ ^ 2 * C₇ * 8 ^ n) * b * E₀ := by
    have hK2 : K ^ 2 ≤ (C₁₇ * D * R₀) ^ 2 := pow_le_pow_left₀ hK hKle 2
    calc 4 ^ n / t ^ n * (CT * (1 / t ^ 2 * (K ^ 2 * (C₇ * I))))
        ≤ 4 ^ n / t ^ n * (CT * (1 / t ^ 2 * ((C₁₇ * D * R₀) ^ 2 * (C₇ * ((8 * R₀) ^ n * E₀))))) := by
          gcongr
      _ = 4 ^ n * CT * (C₁₇ ^ 2 * C₇ * 8 ^ n) * b * E₀ := by
          rw [hb, ht]
          field_simp
          ring
  have hT3 : 4 ^ n / t ^ n * (CT * (κ ^ 2 * t ^ 2 * (2 * ω * t ^ n))) ≤
      4 ^ n * CT * (2 * ω) * δ * E₀ := by
    have htσ : t ^ 2 ≤ (8 * R₀) ^ 2 := by
      have : t ≤ 8 * R₀ := by rw [ht]; nlinarith
      exact pow_le_pow_left₀ htpos.le this 2
    have hκt : κ ^ 2 * t ^ 2 ≤ δ * E₀ := le_trans (by gcongr) hκ
    calc 4 ^ n / t ^ n * (CT * (κ ^ 2 * t ^ 2 * (2 * ω * t ^ n)))
        = 4 ^ n * CT * (2 * ω) * (κ ^ 2 * t ^ 2) := by field_simp
      _ ≤ 4 ^ n * CT * (2 * ω) * (δ * E₀) := by gcongr
      _ = 4 ^ n * CT * (2 * ω) * δ * E₀ := by ring
  -- coefficient comparisons with `C₁₆`
  have hc1 : 4 ^ n * CT * ((1 + n * 2 ^ n) * k * CH * C₁₃) ≤ C₁₆ := by
    rw [hC₁₆]
    have : (1 + n * 2 ^ n) * (k : ℝ) * CH * C₁₃ ≤
        (1 + n * 2 ^ n) * (k + 1) * CH * C₁₃ + C₁₇ ^ 2 * C₇ * 8 ^ n + 2 * ω := by
      have h0 : (0 : ℝ) ≤ C₁₇ ^ 2 * C₇ * 8 ^ n + 2 * ω := by positivity
      have h1' : (1 + n * 2 ^ n) * (k : ℝ) * CH * C₁₃ ≤ (1 + n * 2 ^ n) * (k + 1) * CH * C₁₃ := by
        gcongr
        linarith
      linarith
    gcongr
  have hc2 : 4 ^ n * CT * (C₁₇ ^ 2 * C₇ * 8 ^ n) ≤ C₁₆ := by
    rw [hC₁₆]
    gcongr
    have : (0 : ℝ) ≤ (1 + n * 2 ^ n) * (k + 1) * CH * C₁₃ := by positivity
    linarith
  have hc3 : 4 ^ n * CT * (2 * ω) ≤ C₁₆ := by
    rw [hC₁₆]
    gcongr
    have : (0 : ℝ) ≤ (1 + n * 2 ^ n) * (k + 1) * CH * C₁₃ := by positivity
    have : (0 : ℝ) ≤ C₁₇ ^ 2 * C₇ * 8 ^ n := by positivity
    linarith
  rw [hpre]
  calc 4 ^ n / t ^ n * (CT * (1 / t ^ 2 * ((1 + n * 2 ^ n) * (k * s ^ 2 * Q) + K ^ 2 * (C₇ * I)) +
        κ ^ 2 * t ^ 2 * (2 * ω * t ^ n)))
      = 4 ^ n / t ^ n * (CT * (1 / t ^ 2 * ((1 + n * 2 ^ n) * (k * s ^ 2 * Q)))) +
          4 ^ n / t ^ n * (CT * (1 / t ^ 2 * (K ^ 2 * (C₇ * I)))) +
          4 ^ n / t ^ n * (CT * (κ ^ 2 * t ^ 2 * (2 * ω * t ^ n))) := by ring
    _ ≤ 4 ^ n * CT * ((1 + n * 2 ^ n) * k * CH * C₁₃) * (a + θ' ^ 2) * E₀ +
          4 ^ n * CT * (C₁₇ ^ 2 * C₇ * 8 ^ n) * b * E₀ + 4 ^ n * CT * (2 * ω) * δ * E₀ := by
          rw [hT1]
          exact add_le_add (add_le_add le_rfl hT2) hT3
    _ ≤ C₁₆ * (a + θ' ^ 2) * E₀ + C₁₆ * b * E₀ + C₁₆ * δ * E₀ := by
          gcongr
    _ = (C₁₆ * a + C₁₆ * θ' ^ 2 + C₁₆ * b + C₁₆ * δ) * E₀ := by ring
    _ ≤ (θ' / 128 + θ' / 128 + θ' / 128 + θ' / 128) * E₀ := by gcongr
    _ = θ' / 32 * E₀ := by ring

/-- Steps 9–10, `ENNReal` form: the chain of the tilt-height, graph-height, affine-assembly and
density estimates gives `(θ₀σ)^{-n}∫_{B_{θ₀σ}(ξ)}|p_x − p_S|² dμ ≤ θ₀E₀`. -/
theorem Submission.dorag_tesDecay_conclude (n k : ℕ) (X J L MF Mt : ℝ≥0∞)
    (CT CH C₇ C₁₃ C₁₇ C₁₆ ω θ' ε' D δ E₀ I s Q K σ R₀ t κ : ℝ)
    (hX : X ≤ ENNReal.ofReal CT * (ENNReal.ofReal (1 / t ^ 2) * J +
      ENNReal.ofReal (κ ^ 2 * t ^ 2) * Mt))
    (hJ : J ≤ ENNReal.ofReal (1 + n * 2 ^ n) * L + ENNReal.ofReal (K ^ 2) * MF)
    (hL : L ≤ ENNReal.ofReal (k * s ^ 2 * Q)) (hMF : MF ≤ ENNReal.ofReal (C₇ * I))
    (hMt : Mt ≤ ENNReal.ofReal (2 * ω * t ^ n))
    (hCT : 0 < CT) (hCH : 0 < CH) (hC₇ : 0 < C₇) (hC₁₃ : 0 < C₁₃) (hω : 0 < ω)
    (hθ' : 0 < θ') (hθ'4 : θ' ≤ 1 / 4) (hε' : 0 ≤ ε') (hδ : 0 ≤ δ) (hE₀ : 0 ≤ E₀)
    (hR₀ : 0 < R₀) (hσ : σ = 8 * R₀) (ht : t = θ' * R₀) (hs : s ^ 2 = C₁₃ * E₀)
    (hQ : Q = CH * (ε' / θ' ^ (n + 2) + θ' ^ 2) * t ^ (n + 2))
    (hK : 0 ≤ K) (hKle : K ≤ C₁₇ * D * R₀) (hI : 0 ≤ I) (hIle : I ≤ σ ^ n * E₀)
    (hκ : κ ^ 2 * σ ^ 2 ≤ δ * E₀)
    (hC₁₆ : C₁₆ = 4 ^ n * CT * ((1 + n * 2 ^ n) * (k + 1) * CH * C₁₃ + C₁₇ ^ 2 * C₇ * 8 ^ n +
      2 * ω))
    (h1 : C₁₆ * θ' ^ 2 ≤ θ' / 128) (h2 : C₁₆ * (ε' / θ' ^ (n + 2)) ≤ θ' / 128)
    (h3 : C₁₆ * (D ^ 2 / θ' ^ (n + 2)) ≤ θ' / 128) (h4 : C₁₆ * δ ≤ θ' / 128) :
    ENNReal.ofReal (1 / (θ' / 32 * σ) ^ n) * X ≤ ENNReal.ofReal (θ' / 32 * E₀) := by
  have htpos : 0 < t := ht ▸ mul_pos hθ' hR₀
  have hσpos : 0 < σ := by rw [hσ]; positivity
  have hQ0 : 0 ≤ Q := by rw [hQ]; positivity
  calc ENNReal.ofReal (1 / (θ' / 32 * σ) ^ n) * X
      ≤ ENNReal.ofReal (1 / (θ' / 32 * σ) ^ n) * (ENNReal.ofReal CT * (ENNReal.ofReal (1 / t ^ 2) *
        (ENNReal.ofReal (1 + n * 2 ^ n) * ENNReal.ofReal (k * s ^ 2 * Q) +
          ENNReal.ofReal (K ^ 2) * ENNReal.ofReal (C₇ * I)) +
        ENNReal.ofReal (κ ^ 2 * t ^ 2) * ENNReal.ofReal (2 * ω * t ^ n))) := by
        gcongr
        refine hX.trans ?_
        gcongr
        refine hJ.trans ?_
        gcongr
    _ = ENNReal.ofReal (1 / (θ' / 32 * σ) ^ n * (CT * (1 / t ^ 2 * ((1 + n * 2 ^ n) *
          (k * s ^ 2 * Q) + K ^ 2 * (C₇ * I)) + κ ^ 2 * t ^ 2 * (2 * ω * t ^ n)))) := by
        rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_add (by positivity) (by positivity), ← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_add (by positivity) (by positivity),
          ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
    _ ≤ ENNReal.ofReal (θ' / 32 * E₀) :=
        ENNReal.ofReal_le_ofReal (Submission.dorag_tesDecay_final_real n k CT CH C₇ C₁₃ C₁₇ C₁₆ ω θ'
          ε' D δ E₀ I s Q K σ R₀ t κ hCT hCH hC₇ hC₁₃ hω hθ' hθ'4 hε' hδ hE₀ hR₀ hσ ht hs hQ hK
          hKle hI hIle hκ hC₁₆ h1 h2 h3 h4)

/-- Steps 3–9 of the tilt-excess decay (Simon Ch. 5, proof of 4.5, (5)–(22)).  Let `f` be the
`1`-Lipschitz approximation over the plane `T'` (tilt `I ≤ σⁿE₀` and height `≤ C₁₁Dσ` on `B_σ(ξ)`)
with the estimate (4′) for the non-graph part.  Then (Steps 3–6) every component `fʲ` has energy
`≤ (2 + C₇)I` and is weakly harmonic up to an error, on `Bⁿ_{σ/8}`; (Step 7) the harmonic
approximation lemma applies to `(C₁₃E₀)^{-1/2}fʲ`; (Step 8) the components assemble to an affine
map `c + Λ`; (Step 9) the height about `S = graph Λ` at `τ = ξ + ι'c` is controlled, and the
tilt-height estimate at `(τ, θ'σ/8)` gives `(θ₀σ)^{-n}∫_{B_{θ₀σ}(ξ)}|p_x − p_S|² dμ ≤ θ₀E₀`,
`θ₀ = θ'/32`. -/
theorem Submission.dorag_tesDecay_core (n k : ℕ) (hn : 0 < n) (U W : Set (Euclid (n + k)))
    (R : IMRep U n) (H : Euclid (n + k) → Euclid (n + k)) (κ : ℝ) (ξ : Euclid (n + k)) (σ : ℝ)
    (T' : Submodule ℝ (Euclid (n + k))) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k))
    (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (f : Euclid n → Euclid k)
    (C₃ C₇ C₁₁ C₁₃ C₁₄ C₁₅ C₁₆ C₁₇ CT CH ω θ' ε' δh D δ E₀ I : ℝ)
    (hW : IsOpen W) (hWU : W ⊆ U) (hH : AEStronglyMeasurable H R.measure)
    (hHκ : ∀ x, ‖H x‖ ≤ κ)
    (hMC : ∀ X : Euclid (n + k) → Euclid (n + k), ContDiff ℝ 1 X → HasCompactSupport X →
      tsupport X ⊆ W → R.firstVariation X = -∫ x, inner ℝ (X x) (H x) ∂R.measure)
    (hTH : ∀ (ξ : Euclid (n + k)) (r : ℝ) (S : Submodule ℝ (Euclid (n + k))), 0 < r →
      closedBall ξ r ⊆ W → Module.finrank ℝ S = n →
      ∫⁻ x in closedBall ξ (r / 2), ENNReal.ofReal (∑ i : Fin (n + k),
        ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) -
          S.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure ≤
        ENNReal.ofReal CT * (ENNReal.ofReal (1 / r ^ 2) * ∫⁻ x in closedBall ξ r,
          ENNReal.ofReal (‖(x - ξ) - S.starProjection (x - ξ)‖ ^ 2) ∂R.measure +
          ENNReal.ofReal (κ ^ 2 * r ^ 2) * R.measure (closedBall ξ r)))
    (hHA' : ∀ (R₀ : ℝ) (w : Euclid n → ℝ) (Lw : NNReal), 0 < R₀ → LipschitzWith Lw w →
      ∫ v in ball (0 : Euclid n) R₀, ‖fderiv ℝ w v‖ ^ 2 ≤ R₀ ^ n →
      (∀ ζ : Euclid n → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ →
        tsupport ζ ⊆ ball (0 : Euclid n) R₀ → ∀ G : ℝ, (∀ v, ‖fderiv ℝ ζ v‖ ≤ G) →
        |∫ v in ball (0 : Euclid n) R₀, ∑ i : Fin n, fderiv ℝ w v (EuclideanSpace.single i (1 : ℝ)) *
          fderiv ℝ ζ v (EuclideanSpace.single i (1 : ℝ))| ≤ δh * R₀ ^ n * G) →
      ∃ (a : ℝ) (b : Euclid n →L[ℝ] ℝ), ‖b‖ ≤ CH ∧
        |a| ≤ CH * Real.sqrt ((∫ v in ball (0 : Euclid n) R₀, w v ^ 2) / R₀ ^ n) +
          CH * Real.sqrt ε' * R₀ ∧
        ∀ θ' : ℝ, 0 < θ' → θ' ≤ 1 / 4 → ∫ v in ball (0 : Euclid n) (θ' * R₀), (w v - a - b v) ^ 2 ≤
          CH * (ε' / θ' ^ (n + 2) + θ' ^ 2) * (θ' * R₀) ^ (n + 2))
    (hσ : 0 < σ) (hBW : closedBall ξ σ ⊆ W)
    (hμ : ∀ y ∈ closedBall ξ σ, ∀ t : ℝ, 0 < t → t ≤ σ →
      R.measure (closedBall y t) ≤ ENNReal.ofReal (2 * ω * t ^ n))
    (hmult : ∀ᵐ x ∂R.measure, x ∈ closedBall ξ σ → R.mult x = 1)
    (hT'n : Module.finrank ℝ T' = n)
    (hT'h : ∀ x ∈ R.measure.support ∩ closedBall ξ σ,
      ‖(x - ξ) - T'.starProjection (x - ξ)‖ ≤ C₁₁ * D * σ)
    (hItilt : ∫⁻ x in closedBall ξ (σ / 4), ENNReal.ofReal (∑ i : Fin (n + k),
      ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) -
        T'.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure ≤ ENNReal.ofReal I)
    (hιι' : ∀ v w, inner ℝ (ι v) (ι' w) = 0) (hιT : ∀ v, ι v ∈ T')
    (hfL : ∀ v w, ‖f v - f w‖ ≤ 1 * ‖v - w‖) (hfb : ∀ v, ‖f v‖ ≤ C₇ * D * σ)
    (h5A : R.measure (closedBall ξ (σ / 2) \ range (fun v => ξ + ι v + ι' (f v))) +
      μHE[n] ((range (fun v => ξ + ι v + ι' (f v)) \ R.measure.support) ∩ closedBall ξ (σ / 4)) ≤
        ENNReal.ofReal (C₇ * I))
    (hωeq : unitBallVolume n = ENNReal.ofReal ω)
    (hC₃ : 1 ≤ C₃) (hC₇ : 0 < C₇) (hC₁₁ : 0 < C₁₁) (hCT : 0 < CT) (hCH : 0 < CH) (hω : 0 < ω)
    (hC₁₃def : C₁₃ = (2 + C₇) * 8 ^ n)
    (hC₁₄def : C₁₄ = 8 ^ n * ((2 + 2 ^ (n + 1) * k) * (1 + C₇) * Real.sqrt C₃ +
      2 * ω / 4 ^ (n + 1)) / Real.sqrt ((2 + C₇) * 8 ^ n))
    (hC₁₅def : C₁₅ = (k + 1) * CH * (8 * C₇ * Real.sqrt ω + Real.sqrt (C₁₃ * C₃)))
    (hC₁₇def : C₁₇ = 8 * C₁₁ + C₁₅ + k * CH * Real.sqrt (C₁₃ * C₃))
    (hC₁₆def : C₁₆ = 4 ^ n * CT * ((1 + n * 2 ^ n) * (k + 1) * CH * C₁₃ +
      C₁₇ ^ 2 * C₇ * 8 ^ n + 2 * ω))
    (hθ' : 0 < θ') (hθ'4 : θ' ≤ 1 / 4) (hθ'C : θ' * C₁₆ ≤ 1 / 128) (hε' : 0 < ε')
    (hε'1 : ε' ≤ 1) (hε'C : ε' * C₁₆ ≤ θ' ^ (n + 3) / 128)
    (hD : 0 < D) (hD1 : D ≤ 1) (hD7 : D * C₇ ≤ 1 / 16) (hD11 : D * C₁₁ ≤ 1 / 16)
    (hD14 : D * C₁₄ ≤ δh) (hD15 : D * C₁₅ ≤ θ' / 4) (hD16a : D * C₁₆ ≤ θ' ^ (n + 3) / 128)
    (hD16b : D * C₁₆ ≤ θ' / 128) (hδ : 0 < δ) (hδD : δ ≤ D)
    (hI0 : 0 ≤ I) (hE₀p : 0 < E₀) (hIE : I ≤ σ ^ n * E₀) (hκE : κ ^ 2 * σ ^ 2 ≤ δ * E₀)
    (hE₀le : E₀ ≤ C₃ * D ^ 2) (hκσE : κ * σ ≤ D * Real.sqrt E₀) :
    ∃ S : Submodule ℝ (Euclid (n + k)), Module.finrank ℝ S = n ∧
      ENNReal.ofReal (1 / (θ' / 32 * σ) ^ n) * ∫⁻ x in closedBall ξ (θ' / 32 * σ),
        ENNReal.ofReal (∑ i : Fin (n + k), ‖(approxTangentPlane n R.carrier x).starProjection
          (EuclideanSpace.single i (1 : ℝ)) - S.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2)
          ∂R.measure ≤ ENNReal.ofReal (θ' / 32 * E₀) := by
  have hC₁₃ : 0 < C₁₃ := by rw [hC₁₃def]; positivity
  have hC₁₆ : 0 < C₁₆ := by rw [hC₁₆def]; positivity
  have hE₀0 : 0 ≤ E₀ := hE₀p.le
  have hAESM := Submission.dorag_approxTangent_starProjection_aesm (n + k) n U R
  have hnull := Submission.dorag_support_sdiff_carrier_null n k hn U W R H κ hW hWU hH hHκ hMC
  have hf1 : ∀ v w, ‖f v - f w‖ ≤ ‖v - w‖ := fun v w => by simpa using hfL v w
  have hfLip : LipschitzWith 1 f := LipschitzWith.of_dist_le_mul fun v w => by
    simpa [dist_eq_norm] using hfL v w
  /- Steps 3–6: energy bound and weak harmonic equation for `fʲ` on `Bⁿ_{σ/8}`. -/
  have hGT := Submission.dorag_tesDecay_ae_of_carrier R hW.measurableSet
    (Submission.dorag_lipschitz_graph_approxTangent n k hn U W R ι ι' ξ f 1 hW hWU hιι' hfLip)
  have hσ4 : σ / 4 ≤ σ := by linarith only [hσ]
  have hsmall : ∀ C : ℝ, D * C ≤ 1 / 16 → C * D * σ ≤ σ / 4 / 4 := fun C hC => by
    calc C * D * σ = (D * C) * σ := by ring
      _ ≤ 1 / 16 * σ := by gcongr
      _ = σ / 4 / 4 := by ring
  have hμσ4 : R.measure (closedBall ξ (σ / 4)) ≤ ENNReal.ofReal (2 * ω * (σ / 4) ^ n) :=
    hμ ξ (mem_closedBall_self hσ.le) (σ / 4) (by positivity) hσ4
  obtain ⟨hGE, hGW⟩ := Submission.dorag_tes_graph_weak_harmonic n k hn U W R H κ ξ (σ / 4) I (C₇ * I)
    (2 * ω * (σ / 4) ^ n) T' ι ι' f hW hWU hH hHκ hMC hAESM (by positivity)
    ((closedBall_subset_closedBall hσ4).trans hBW) hI0 (by positivity) (by positivity) hT'n hιι' hιT
    hf1 (fun v => (hfb v).trans (hsmall C₇ hD7))
    (fun x hx => (hT'h x ⟨hx.1, closedBall_subset_closedBall hσ4 hx.2⟩).trans (hsmall C₁₁ hD11))
    (by
      filter_upwards [hGT] with x hx hxB using hx (hBW (closedBall_subset_closedBall hσ4 hxB)))
    (by filter_upwards [hmult] with x hx hxB using hx (closedBall_subset_closedBall hσ4 hxB))
    hnull hItilt
    ((add_le_add (measure_mono (sdiff_subset_sdiff_left (closedBall_subset_closedBall
      (by linarith only [hσ] : σ / 4 ≤ σ / 2)))) le_rfl).trans h5A)
    hμσ4
  /- Step 7: harmonic approximation of `w = s⁻¹fʲ`, `s = (C₁₃E₀)^{1/2}`, on `Bⁿ_{R₀}`, `R₀ = σ/8`. -/
  obtain ⟨s, hsdef⟩ : ∃ s : ℝ, s = Real.sqrt (C₁₃ * E₀) := ⟨_, rfl⟩
  have hs : 0 < s := hsdef ▸ Real.sqrt_pos.mpr (mul_pos hC₁₃ hE₀p)
  have hs2 : s ^ 2 = C₁₃ * E₀ := by rw [hsdef, Real.sq_sqrt (by positivity)]
  have hsi : 0 < s⁻¹ := inv_pos.mpr hs
  have hR₀ : 0 < σ / 4 / 2 := by positivity
  obtain ⟨t, htdef⟩ : ∃ t : ℝ, t = θ' * (σ / 4 / 2) := ⟨_, rfl⟩
  have ht : 0 < t := htdef ▸ mul_pos hθ' hR₀
  obtain ⟨A, hAdef⟩ : ∃ A : ℝ,
      A = CH * (s⁻¹ * (C₇ * D * σ) * Real.sqrt ω) + CH * Real.sqrt ε' * (σ / 4 / 2) := ⟨_, rfl⟩
  have hvol : volume.real (ball (0 : Euclid n) (σ / 4 / 2)) = (σ / 4 / 2) ^ n * ω := by
    rw [Measure.real, Measure.addHaar_ball_of_pos volume 0 hR₀, finrank_euclideanSpace_fin]
    change (ENNReal.ofReal ((σ / 4 / 2) ^ n) * unitBallVolume n).toReal = _
    rw [hωeq, ← ENNReal.ofReal_mul (by positivity), ENNReal.toReal_ofReal (by positivity)]
  have hwj := Submission.dorag_tesDecay_harmonic_step n k f C₃ C₇ CH ω D δh ε' E₀ I κ σ s θ' hHA'
    hGE hGW hf1 hfb (by rw [hsdef, hC₁₃def]) hC₃ hC₇ hCH hω hD.le hE₀p hσ hθ' hθ'4 hIE hE₀le hκσE
    (by rw [← hC₁₄def, mul_comm]; exact hD14) hvol
  clear hHA' hGE hGW
  rw [← hAdef, ← htdef] at hwj
  /- Step 8: the affine map `c + Λ`. -/
  obtain ⟨c, Λ, hc, hΛ, hfcΛ⟩ := Submission.dorag_tes_componentwise_affine_assembly n k f s A CH
    (CH * (ε' / θ' ^ (n + 2) + θ' ^ 2) * t ^ (n + 2)) t hfLip.continuous hs hwj
  obtain ⟨hc', hΛ'⟩ := Submission.dorag_tesDecay_affine_consts k C₃ C₁₃ C₇ CH ω D E₀ ε' σ s A ‖c‖ ‖Λ‖
    hsdef hE₀p hE₀le (by linarith only [hC₃]) hC₁₃ hD.le hε'1 hCH hC₇ hω hσ hAdef hc hΛ
  rw [← hC₁₅def] at hc'
  /- Step 9: height about `S = graph Λ` at `τ = ξ + ι'c`, then tilt via the tilt-height estimate. -/
  have hcR : ‖c‖ ≤ t / 4 := by
    calc ‖c‖ ≤ C₁₅ * D * (σ / 4 / 2) := hc'
      _ = (D * C₁₅) * (σ / 4 / 2) := by ring
      _ ≤ θ' / 4 * (σ / 4 / 2) := by gcongr
      _ = t / 4 := by rw [htdef]; ring
  have hτξ : dist (ξ + ι' c) ξ = ‖c‖ := by
    rw [dist_eq_norm, add_sub_cancel_left, LinearIsometry.norm_map]
  have htσ : t ≤ σ / 32 := by
    calc t = θ' * (σ / 4 / 2) := htdef
      _ ≤ 1 / 4 * (σ / 4 / 2) := by gcongr
      _ = σ / 32 := by ring
  have hBt2 : closedBall (ξ + ι' c) t ⊆ closedBall ξ (σ / 2) :=
    closedBall_subset_closedBall' (by rw [hτξ]; linarith only [hcR, htσ, ht, hσ])
  have hBtσ : closedBall (ξ + ι' c) t ⊆ closedBall ξ σ :=
    hBt2.trans (closedBall_subset_closedBall (by linarith only [hσ]))
  obtain ⟨hSn, hSh⟩ := Submission.dorag_tes_graph_affine_height n k hn U R ξ T' ι ι' f c Λ t
    (C₁₁ * D * σ) ht (by positivity) hT'n hιι' hιT hf1
    (by filter_upwards [hmult] with x hx hxB using hx (hBtσ hxB))
    (fun x hx => hT'h x ⟨hx.1, hBtσ hx.2⟩)
  have hTHS := hTH (ξ + ι' c) t _ ht (hBtσ.trans hBW) hSn
  have hμt : R.measure (closedBall (ξ + ι' c) t) ≤ ENNReal.ofReal (2 * ω * t ^ n) :=
    hμ (ξ + ι' c) (hBtσ (mem_closedBall_self ht.le)) t ht (htσ.trans (by linarith only [hσ]))
  have hμtF : R.measure (closedBall (ξ + ι' c) t \ range fun v => ξ + ι v + ι' (f v)) ≤
      ENNReal.ofReal (C₇ * I) :=
    (measure_mono (sdiff_subset_sdiff_left hBt2)).trans (le_self_add.trans h5A)
  have hθσ : θ' / 32 * σ = t / 4 := by rw [htdef]; ring
  have hBsub : closedBall ξ (θ' / 32 * σ) ⊆ closedBall (ξ + ι' c) (t / 2) :=
    closedBall_subset_closedBall' (by rw [hθσ, dist_comm, hτξ]; linarith only [hcR])
  obtain ⟨K, hKdef⟩ : ∃ K : ℝ, K = C₁₁ * D * σ + ‖c‖ + ‖Λ‖ * t := ⟨_, rfl⟩
  rw [← hKdef] at hSh
  have hK0 : 0 ≤ K := by rw [hKdef]; positivity
  have hKle : K ≤ C₁₇ * D * (σ / 4 / 2) := by
    have htR : t ≤ σ / 4 / 2 := by
      rw [htdef]
      exact mul_le_of_le_one_left hR₀.le (by linarith only [hθ'4])
    calc K = C₁₁ * D * σ + ‖c‖ + ‖Λ‖ * t := hKdef
      _ ≤ C₁₁ * D * σ + C₁₅ * D * (σ / 4 / 2) +
          (k * CH * Real.sqrt (C₁₃ * C₃) * D) * (σ / 4 / 2) := by gcongr
      _ = C₁₇ * D * (σ / 4 / 2) := by rw [hC₁₇def]; ring
  obtain ⟨Q, hQdef⟩ : ∃ Q : ℝ, Q = CH * (ε' / θ' ^ (n + 2) + θ' ^ 2) * t ^ (n + 2) := ⟨_, rfl⟩
  rw [← hQdef] at hfcΛ
  refine ⟨_, hSn, ?_⟩
  -- Step 10: the choice of `θ'`, `ε'` and `δ₂`
  have hc1 : C₁₆ * θ' ^ 2 ≤ θ' / 128 := by
    calc C₁₆ * θ' ^ 2 = (θ' * C₁₆) * θ' := by ring
      _ ≤ 1 / 128 * θ' := by gcongr
      _ = θ' / 128 := by ring
  have hc2 : C₁₆ * (ε' / θ' ^ (n + 2)) ≤ θ' / 128 := by
    rw [mul_div_assoc', div_le_iff₀ (by positivity)]
    calc C₁₆ * ε' = ε' * C₁₆ := by ring
      _ ≤ θ' ^ (n + 3) / 128 := hε'C
      _ = θ' / 128 * θ' ^ (n + 2) := by ring
  have hc3 : C₁₆ * (D ^ 2 / θ' ^ (n + 2)) ≤ θ' / 128 := by
    rw [mul_div_assoc', div_le_iff₀ (by positivity)]
    calc C₁₆ * D ^ 2 = (D * C₁₆) * D := by ring
      _ ≤ θ' ^ (n + 3) / 128 * 1 := by gcongr
      _ = θ' / 128 * θ' ^ (n + 2) := by ring
  have hc4 : C₁₆ * δ ≤ θ' / 128 := by
    calc C₁₆ * δ ≤ C₁₆ * D := by gcongr
      _ = D * C₁₆ := by ring
      _ ≤ θ' / 128 := hD16b
  exact Submission.dorag_tesDecay_conclude n k _ _ _ _ _ CT CH C₇ C₁₃ C₁₇ C₁₆ ω θ' ε' D δ E₀ I s Q K σ
    (σ / 4 / 2) t κ ((lintegral_mono_set hBsub).trans hTHS) hSh hfcΛ hμtF hμt hCT hCH hC₇ hC₁₃ hω
    hθ' hθ'4 hε'.le hδ.le hE₀0 hR₀ (by ring) htdef hs2 hQdef hK0 hKle hI0 hIE hκE hC₁₆def hc1 hc2 hc3
    hc4

/-- **Tilt-excess decay, one step** (Simon Ch. 5, Theorem 4.5 with `p = 2n`, bounded `H`; parent
proof Part 7, Claim 7A, Steps 0–11).  There are `θ₀ ∈ (0, 1/4]` and `δ₂ ∈ (0, 1/8]` such that under
(SA_δ), `δ ≤ δ₂`, for every `ξ ∈ spt μ ∩ B_{δρ}(z)`, `σ ∈ (0, δρ]` and `n`-plane `T` there is an
`n`-plane `S` with `E_*(ξ, θ₀σ, S) ≤ θ₀E_*(ξ, σ, T)`.
Step 1 replaces `T` by a plane `T'` with `E(ξ, σ, T') ≤ C₃δ^{2α}` and height `≤ C₁₁δ^ασ`
(affine approximation and plane reduction).  Step 2 is the Lipschitz approximation `f` over `T'`;
Steps 3–6 give the energy bound and the weak harmonic equation for `fʲ` on `Bⁿ_{σ/8}`; Step 7 is
the harmonic approximation of `(C₁₃E₀)^{-1/2}fʲ`; Step 8 assembles the affine map `c + Λ`; Step 9
bounds the height about `S = graph Λ` at `τ = ξ + ι'c` and converts it to tilt; Step 10 fixes
`θ' = 32θ₀`, `ε'` and `δ₂` in this order. -/
theorem Submission.dorag_tilt_excess_one_step_decay : ∀ (n k : ℕ), 0 < n → ∃ θ₀ δ₂ : ℝ, 0 < θ₀ ∧ θ₀ ≤ 1 / 4 ∧ 0 < δ₂ ∧ δ₂ ≤ 1 / 8 ∧ ∀ δ : ℝ, 0 < δ → δ ≤ δ₂ → ∀ (U W : Set (Euclid (n + k))) (R : IMRep U n) (H : Euclid (n + k) → Euclid (n + k)) (κ ρ : ℝ) (z : Euclid (n + k)), IsOpen W → W ⊆ U → 0 < ρ → closedBall z ρ ⊆ W → AEStronglyMeasurable H R.measure → (∀ x, ‖H x‖ ≤ κ) → (∀ X : Euclid (n + k) → Euclid (n + k), ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ W → R.firstVariation X = -∫ x, inner ℝ (X x) (H x) ∂R.measure) → z ∈ R.measure.support → R.measure (closedBall z ρ) ≤ ENNReal.ofReal (1 + δ) * unitBallVolume n * ENNReal.ofReal (ρ ^ n) → κ * ρ ≤ δ → ∀ ξ ∈ R.measure.support ∩ closedBall z (δ * ρ), ∀ (σ : ℝ) (T : Submodule ℝ (Euclid (n + k))), 0 < σ → σ ≤ δ * ρ → Module.finrank ℝ T = n → ∃ S : Submodule ℝ (Euclid (n + k)), Module.finrank ℝ S = n ∧ max (ENNReal.ofReal (1 / (θ₀ * σ) ^ n) * ∫⁻ x in closedBall ξ (θ₀ * σ), ENNReal.ofReal (∑ i : Fin (n + k), ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) - S.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure) (ENNReal.ofReal (κ ^ 2 * (θ₀ * σ) ^ 2 / δ)) ≤ ENNReal.ofReal θ₀ * max (ENNReal.ofReal (1 / σ ^ n) * ∫⁻ x in closedBall ξ σ, ENNReal.ofReal (∑ i : Fin (n + k), ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) - T.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure) (ENNReal.ofReal (κ ^ 2 * σ ^ 2 / δ)) := by
  intro n k hn
  /- Step 0: the constants.  Sibling constants first. -/
  obtain ⟨δ₁, C₂, hδ₁, hδ₁8, -, hDB⟩ := Submission.dorag_standing_density_bounds n k hn
  obtain ⟨δ₃, C₃, hδ₃, hδ₃8, hC₃, hAA⟩ := Submission.dorag_affine_approximation n k hn
  obtain ⟨CT, hCT, hTH⟩ := Submission.dorag_tilt_height_estimate n k
  obtain ⟨CH, hCH, hHA⟩ := Submission.dorag_harmonic_affine_approximation n hn
  -- `ω = ω_n ∈ (0, ∞)`
  have hωfin : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
  have hω0 : unitBallVolume n ≠ 0 := (measure_ball_pos volume (0 : Euclid n) one_pos).ne'
  obtain ⟨ω, hωdef⟩ : ∃ ω : ℝ, ω = (unitBallVolume n).toReal := ⟨_, rfl⟩
  have hω : 0 < ω := hωdef ▸ ENNReal.toReal_pos hω0 hωfin
  have hωeq : unitBallVolume n = ENNReal.ofReal ω := by rw [hωdef, ENNReal.ofReal_toReal hωfin]
  have h2ω : ∀ x : ℝ, 0 ≤ x → 2 * unitBallVolume n * ENNReal.ofReal x = ENNReal.ofReal (2 * ω * x) := by
    intro x hx
    rw [hωeq, ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_ofNat]
  -- `C₁₁ = 2C₃ + (8C₃/ω)^{1/2}` and the Lipschitz approximation constants for `C₆ = C₁₁`
  obtain ⟨C₁₁, hC₁₁def⟩ : ∃ C : ℝ, C = 2 * C₃ + Real.sqrt (8 * C₃ / ω) := ⟨_, rfl⟩
  have hC₃C₁₁ : C₃ ≤ C₁₁ := by
    rw [hC₁₁def]
    have := Real.sqrt_nonneg (8 * C₃ / ω)
    linarith only [this, hC₃]
  have hC₁₁ : 1 ≤ C₁₁ := hC₃.trans hC₃C₁₁
  have hC₁₁0 : 0 < C₁₁ := by linarith only [hC₁₁]
  obtain ⟨δ₅, β, β', C₇, hδ₅, -, hβ', hβ'β, -, hC₇, hLA⟩ :=
    Submission.dorag_lipschitz_approximation n k hn C₁₁ hC₁₁
  have hβ : 0 < β := hβ'.trans_le hβ'β
  -- `C₁₃, …, C₁₆` (Steps 6–9)
  obtain ⟨C₁₃, hC₁₃def⟩ : ∃ C : ℝ, C = (2 + C₇) * 8 ^ n := ⟨_, rfl⟩
  obtain ⟨C₁₄, hC₁₄def⟩ : ∃ C : ℝ, C = 8 ^ n * ((2 + 2 ^ (n + 1) * k) * (1 + C₇) * Real.sqrt C₃ +
      2 * ω / 4 ^ (n + 1)) / Real.sqrt ((2 + C₇) * 8 ^ n) := ⟨_, rfl⟩
  obtain ⟨C₁₅, hC₁₅def⟩ : ∃ C : ℝ,
      C = (k + 1) * CH * (8 * C₇ * Real.sqrt ω + Real.sqrt (C₁₃ * C₃)) := ⟨_, rfl⟩
  obtain ⟨C₁₇, hC₁₇def⟩ : ∃ C : ℝ, C = 8 * C₁₁ + C₁₅ + k * CH * Real.sqrt (C₁₃ * C₃) := ⟨_, rfl⟩
  obtain ⟨C₁₆, hC₁₆def⟩ : ∃ C : ℝ, C = 4 ^ n * CT * ((1 + n * 2 ^ n) * (k + 1) * CH * C₁₃ +
      C₁₇ ^ 2 * C₇ * 8 ^ n + 2 * ω) := ⟨_, rfl⟩
  have hC₁₃ : 0 < C₁₃ := by rw [hC₁₃def]; positivity
  have hC₁₄ : 0 < C₁₄ := by rw [hC₁₄def]; positivity
  have hC₁₅ : 0 < C₁₅ := by rw [hC₁₅def]; positivity
  have hC₁₆ : 0 < C₁₆ := by rw [hC₁₆def]; positivity
  -- Step 10: `θ'` with `C₁₆θ'² ≤ θ'/128`, then `ε'` with `C₁₆θ'^{-n-2}ε' ≤ θ'/128`
  obtain ⟨θ', hθ'def⟩ : ∃ θ : ℝ, θ = min (1 / 4) (1 / 128 / C₁₆) := ⟨_, rfl⟩
  have hθ' : 0 < θ' := by rw [hθ'def]; positivity
  have hθ'4 : θ' ≤ 1 / 4 := hθ'def ▸ min_le_left _ _
  have hθ'C : θ' * C₁₆ ≤ 1 / 128 :=
    (le_div_iff₀ hC₁₆).mp (hθ'def ▸ min_le_right _ _)
  obtain ⟨ε', hε'def⟩ : ∃ ε : ℝ, ε = min 1 (θ' ^ (n + 3) / 128 / C₁₆) := ⟨_, rfl⟩
  have hε' : 0 < ε' := by rw [hε'def]; positivity
  have hε'1 : ε' ≤ 1 := hε'def ▸ min_le_left _ _
  have hε'C : ε' * C₁₆ ≤ θ' ^ (n + 3) / 128 :=
    (le_div_iff₀ hC₁₆).mp (hε'def ▸ min_le_right _ _)
  obtain ⟨δh, hδh, hHA'⟩ := hHA ε' hε'
  -- the smallness threshold for `D = δ^{1/(2n+2)}`, and `δ₂`
  obtain ⟨η, hηdef⟩ : ∃ η : ℝ, η = min (min (min β (1 / 16 / C₁₁)) (min (1 / 16 / C₇) (δh / C₁₄)))
      (min (min (θ' / 4 / C₁₅) (θ' ^ (n + 3) / 128 / C₁₆)) (min (θ' / 128 / C₁₆) 1)) := ⟨_, rfl⟩
  have hη : 0 < η := by rw [hηdef]; positivity
  have hηs : η ≤ β ∧ η ≤ 1 / 16 / C₁₁ ∧ η ≤ 1 / 16 / C₇ ∧ η ≤ δh / C₁₄ ∧ η ≤ θ' / 4 / C₁₅ ∧
      η ≤ θ' ^ (n + 3) / 128 / C₁₆ ∧ η ≤ θ' / 128 / C₁₆ ∧ η ≤ 1 := by
    rw [hηdef]
    simp only [min_le_iff, le_refl, true_or, or_true, and_self]
  obtain ⟨hηβ, hη11, hη7, hη14, hη15, hη16a, hη16b, hη1⟩ := hηs
  obtain ⟨δ₂, hδ₂def⟩ : ∃ d : ℝ, d = min (min (min (min (1 / 8) δ₁) δ₃) δ₅) (η ^ (2 * n + 2)) :=
    ⟨_, rfl⟩
  have hδ₂ : 0 < δ₂ := by rw [hδ₂def]; positivity
  have hδ₂8 : δ₂ ≤ 1 / 8 := by
    rw [hδ₂def]
    exact (min_le_left _ _).trans ((min_le_left _ _).trans ((min_le_left _ _).trans
      (min_le_left _ _)))
  refine ⟨θ' / 32, δ₂, by positivity, by linarith only [hθ'4], hδ₂, hδ₂8, ?_⟩
  intro δ hδ hδδ₂ U W R H κ ρ z hW hWU hρ hzρ hH hHκ hMC hz hdens hκρ ξ hξ σ T hσ hσδρ hT
  have hδs : δ ≤ 1 / 8 ∧ δ ≤ δ₁ ∧ δ ≤ δ₃ ∧ δ ≤ δ₅ ∧ δ ≤ η ^ (2 * n + 2) := by
    rw [hδ₂def] at hδδ₂
    simp only [le_min_iff] at hδδ₂
    tauto
  obtain ⟨hδ8, hδ₁', hδ₃', hδ₅', hδη⟩ := hδs
  -- `D = δ^α`, `α = 1/(2n+2)`
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = δ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2)) := ⟨_, rfl⟩
  obtain ⟨hD, hDη, hδD, hsδD⟩ :=
    Submission.dorag_tesDecay_rpow n δ η hδ (by linarith only [hδ8]) hη hδη
  rw [← hDdef] at hD hDη hδD hsδD
  have hDβ : D ≤ β := hDη.trans hηβ
  have hD11 : D * C₁₁ ≤ 1 / 16 := (le_div_iff₀ hC₁₁0).mp (hDη.trans hη11)
  have hD7 : D * C₇ ≤ 1 / 16 := (le_div_iff₀ hC₇).mp (hDη.trans hη7)
  have hD14 : D * C₁₄ ≤ δh := (le_div_iff₀ hC₁₄).mp (hDη.trans hη14)
  have hD15 : D * C₁₅ ≤ θ' / 4 := (le_div_iff₀ hC₁₅).mp (hDη.trans hη15)
  have hD16a : D * C₁₆ ≤ θ' ^ (n + 3) / 128 := (le_div_iff₀ hC₁₆).mp (hDη.trans hη16a)
  have hD16b : D * C₁₆ ≤ θ' / 128 := (le_div_iff₀ hC₁₆).mp (hDη.trans hη16b)
  have hD1 : D ≤ 1 := hDη.trans hη1
  -- elementary facts about the data
  have hκ : 0 ≤ κ := (norm_nonneg _).trans (hHκ 0)
  have hξz : dist ξ z ≤ δ * ρ := mem_closedBall.mp hξ.2
  have hδρ : 0 < δ * ρ := mul_pos hδ hρ
  have hδρ8 : δ * ρ ≤ ρ / 8 := by
    calc δ * ρ ≤ 1 / 8 * ρ := mul_le_mul_of_nonneg_right hδ8 hρ.le
      _ = ρ / 8 := by ring
  have hBz : closedBall ξ σ ⊆ closedBall z (4 * δ * ρ) :=
    closedBall_subset_closedBall' (by linarith only [hσδρ, hξz, hδρ])
  have hBW : closedBall ξ σ ⊆ W :=
    (closedBall_subset_closedBall' (by linarith only [hσδρ, hξz, hδρ8, hρ])).trans hzρ
  have hσρ : σ ≤ (1 - 4 * δ) * ρ := by linarith only [hσδρ, hδρ8, hρ]
  obtain ⟨hDBa, hDBb, -, hDBd⟩ :=
    hDB δ hδ hδ₁' U W R H κ ρ z hW hWU hρ hzρ hH hHκ hMC hz hdens hκρ
  clear hDB
  have hAESM := Submission.dorag_approxTangent_starProjection_aesm (n + k) n U R
  /- Step 1: affine approximation at `(ξ, 2σ)` and reduction to a plane `T'` with small tilt and
  height. -/
  obtain ⟨T₁, hT₁n, hT₁h, hT₁t⟩ := hAA δ hδ hδ₃' U W R H κ ρ z hW hWU hρ hzρ hH hHκ hMC hz hdens hκρ ξ
    ⟨hξ.1, mem_closedBall.mpr (by linarith only [hξz, hδρ])⟩ (2 * σ) (by linarith only [hσ])
    (by linarith only [hσδρ])
  clear hAA
  rw [← hDdef] at hT₁h hT₁t
  rw [show 2 * σ / 2 = σ by ring] at hT₁t
  have hμσ : ENNReal.ofReal (ω * σ ^ n / 2) ≤ R.measure (closedBall ξ σ) := by
    have h := hDBb ξ ⟨hξ.1, hBz (mem_closedBall_self hσ.le)⟩ σ hσ hσρ
    rw [hωeq, ← ENNReal.ofReal_mul hω.le] at h
    rw [ENNReal.ofReal_div_of_pos two_pos, ENNReal.ofReal_ofNat]
    exact ENNReal.div_le_of_le_mul (h.trans_eq (mul_comm _ _))
  obtain ⟨T', hT'TT, hT'a, hT'T, hT'h⟩ := Submission.dorag_tes_plane_reduction (n + k) R.measure
    (approxTangentPlane n R.carrier) ξ σ (C₃ * D ^ 2 * σ ^ n) (ω * σ ^ n / 2) (C₃ * D * (2 * σ)) T T₁
    hσ (by positivity) (by positivity) hAESM hμσ hT₁t
    (fun x hx => hT₁h x ⟨hx.1, closedBall_subset_closedBall (by linarith only [hσ]) hx.2⟩)
  rw [Submission.dorag_tesDecay_height_const n C₃ ω D σ (by linarith only [hC₃]) hω hD.le hσ,
    ← hC₁₁def]
    at hT'h
  have hT'n : Module.finrank ℝ T' = n := by
    rcases hT'TT with rfl | rfl <;> assumption
  -- `I = ∫_{B_σ(ξ)} |p_x − p_{T'}|² dμ` and `E₀ = E_*(ξ, σ, T')`
  obtain ⟨I, hI0, hIeq, hIa⟩ := Submission.dorag_tesDecay_real_of_le (by positivity) hT'a
  rw [← hIeq] at hT'T
  obtain ⟨E₀, hE₀def⟩ : ∃ E : ℝ, E = max (1 / σ ^ n * I) (κ ^ 2 * σ ^ 2 / δ) := ⟨_, rfl⟩
  obtain ⟨hE₀0, hIE, hκE, hE₀le, hκσE⟩ := Submission.dorag_tesDecay_excess_facts n C₃ D δ E₀ I κ ρ σ
    hδ hδ8 hσ hσδρ hκ hκρ hC₃ hδD hsδD hIa hE₀def
  have hE₀2 : κ ^ 2 * σ ^ 2 / δ ≤ E₀ := hE₀def ▸ le_max_right _ _
  -- it suffices to prove `E_*(ξ, θ₀σ, S) ≤ θ₀E₀`
  have hRHS := Submission.dorag_tesDecay_rhs (θ' / 32) E₀ (1 / σ ^ n) (κ ^ 2 * σ ^ 2 / δ) I _
    (by positivity) (by positivity) hE₀def hT'T
  have hθ32 : θ' / 32 ≤ 1 := by linarith only [hθ'4]
  have hsecond : ENNReal.ofReal (κ ^ 2 * (θ' / 32 * σ) ^ 2 / δ) ≤ ENNReal.ofReal (θ' / 32 * E₀) := by
    apply ENNReal.ofReal_le_ofReal
    rw [show κ ^ 2 * (θ' / 32 * σ) ^ 2 / δ = (θ' / 32) ^ 2 * (κ ^ 2 * σ ^ 2 / δ) by ring]
    calc (θ' / 32) ^ 2 * (κ ^ 2 * σ ^ 2 / δ) ≤ (θ' / 32) ^ 2 * E₀ := by gcongr
      _ ≤ θ' / 32 * E₀ := by
        gcongr
        rw [sq]
        exact mul_le_of_le_one_left (by positivity) hθ32
  rcases hE₀0.eq_or_lt with hE₀z | hE₀p
  · /- `E₀ = 0`: `S = T'` works. -/
    have hIz : I = 0 := by
      have := hIE
      rw [← hE₀z, mul_zero] at this
      exact le_antisymm this hI0
    refine ⟨T', hT'n, le_trans (max_le ?_ hsecond) hRHS⟩
    refine (mul_le_mul_right (lintegral_mono_set (closedBall_subset_closedBall
      (mul_le_of_le_one_left hσ.le hθ32))) _).trans ?_
    rw [← hIeq, hIz, ENNReal.ofReal_zero, mul_zero]
    exact zero_le
  /- `E₀ > 0`.  Step 2: Lipschitz approximation over `T'` with `L = 1`. -/
  obtain ⟨ι, ι', f, hιι', hιT, hfL, hfb, h5A, -⟩ := hLA δ hδ hδ₅' U W R H κ ρ z hW hWU hρ hzρ hH hHκ
    hMC hz hdens hκρ ξ hξ σ 1 T' hσ hσδρ hT'n one_pos le_rfl (by rw [← hDdef, mul_one]; exact hDβ)
    (by rw [← hDdef, ← hIeq]; exact ENNReal.ofReal_le_ofReal (hIa.trans (by gcongr)))
    (by rw [← hDdef]; exact hT'h)
  clear hLA
  rw [← hDdef] at hfb
  rw [one_pow, div_one, ← hIeq, ← ENNReal.ofReal_mul hC₇.le] at h5A
  /- Steps 3–9: the core estimate. -/
  obtain ⟨S, hSn, hS⟩ := Submission.dorag_tesDecay_core n k hn U W R H κ ξ σ T' ι ι' f C₃ C₇ C₁₁ C₁₃
    C₁₄ C₁₅ C₁₆ C₁₇ CT CH ω θ' ε' δh D δ E₀ I hW hWU hH hHκ hMC
    (fun ξ' r S' => hTH U W R H κ ξ' r S' hW hWU hH hHκ hMC) hHA' hσ hBW
    (fun y hy t ht htσ => (hDBa y (hBz hy) t ht (htσ.trans hσρ)).trans_eq (h2ω _ (by positivity)))
    (by filter_upwards [hDBd] with x hx hxB using hx (hBz hxB)) hT'n hT'h
    (by rw [hIeq]; exact lintegral_mono_set (closedBall_subset_closedBall (by linarith only [hσ])))
    hιι' hιT hfL hfb h5A hωeq hC₃ hC₇ hC₁₁0 hCT hCH hω hC₁₃def hC₁₄def hC₁₅def hC₁₇def hC₁₆def hθ'
    hθ'4 hθ'C hε' hε'1 hε'C hD hD1 hD7 hD11 hD14 hD15 hD16a hD16b hδ hδD hI0 hE₀p hIE hκE hE₀le hκσE
  exact ⟨S, hSn, le_trans (max_le hS hsecond) hRHS⟩

/-- **Tilt-excess decay at all scales** (Simon Ch. 5, Remark 4.6 and the proof of Theorem 5.2,
(1)–(8), at a general scale `σ ∈ (0, δρ]` and for a general initial `n`-plane `T`).  Iterating the
one-step decay `E_*(θ₀r, S') ≤ θ₀E_*(r, S)` at the scales `θ₀ʲσ` from `S₀ = T` gives `n`-planes `Sⱼ`
with `E_*(θ₀ʲσ, Sⱼ) ≤ θ₀ʲE_*`.  With the density bounds `½ωₙtⁿ ≤ μ(B_t(ξ)) ≤ 2ωₙtⁿ` this gives
`|p_{Sⱼ₊₁} − p_{Sⱼ}|² ≤ aθ₀ʲ`, `a = 8E_*/(ωₙθ₀ⁿ)`, so the `Sⱼ` converge to an `n`-plane `S` with
`|p_S − p_{Sⱼ}|² ≤ 4aθ₀ʲ` (`j = 0` is the tilt bound), and comparing with `Sⱼ` for
`θ₀ʲ⁺¹σ < s ≤ θ₀ʲσ` gives `∫_{B_s(ξ)} |p_x − p_S|² dμ ≤ C(s/σ)sⁿE_*`. -/
theorem Submission.dorag_tilt_excess_decay : ∀ (n k : ℕ), 0 < n → ∃ δ₂ C : ℝ, 0 < δ₂ ∧ δ₂ ≤ 1 / 8 ∧ 0 < C ∧ ∀ δ : ℝ, 0 < δ → δ ≤ δ₂ → ∀ (U W : Set (Euclid (n + k))) (R : IMRep U n) (H : Euclid (n + k) → Euclid (n + k)) (κ ρ : ℝ) (z : Euclid (n + k)), IsOpen W → W ⊆ U → 0 < ρ → closedBall z ρ ⊆ W → AEStronglyMeasurable H R.measure → (∀ x, ‖H x‖ ≤ κ) → (∀ X : Euclid (n + k) → Euclid (n + k), ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ W → R.firstVariation X = -∫ x, inner ℝ (X x) (H x) ∂R.measure) → z ∈ R.measure.support → R.measure (closedBall z ρ) ≤ ENNReal.ofReal (1 + δ) * unitBallVolume n * ENNReal.ofReal (ρ ^ n) → κ * ρ ≤ δ → ∀ ξ ∈ R.measure.support ∩ closedBall z (δ * ρ), ∀ (σ : ℝ) (T : Submodule ℝ (Euclid (n + k))), 0 < σ → σ ≤ δ * ρ → Module.finrank ℝ T = n → ∃ S : Submodule ℝ (Euclid (n + k)), Module.finrank ℝ S = n ∧ (∀ s : ℝ, 0 < s → s ≤ σ → ∫⁻ x in closedBall ξ s, ENNReal.ofReal (∑ i : Fin (n + k), ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) - S.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure ≤ ENNReal.ofReal (C * (s / σ) * s ^ n) * max (ENNReal.ofReal (1 / σ ^ n) * ∫⁻ x in closedBall ξ σ, ENNReal.ofReal (∑ i : Fin (n + k), ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) - T.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure) (ENNReal.ofReal (κ ^ 2 * σ ^ 2 / δ))) ∧ ENNReal.ofReal (∑ i : Fin (n + k), ‖S.starProjection (EuclideanSpace.single i (1 : ℝ)) - T.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ≤ ENNReal.ofReal C * max (ENNReal.ofReal (1 / σ ^ n) * ∫⁻ x in closedBall ξ σ, ENNReal.ofReal (∑ i : Fin (n + k), ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) - T.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure) (ENNReal.ofReal (κ ^ 2 * σ ^ 2 / δ)) := by
  intro n k hn
  -- Step 0: `θ₀ ∈ (0, 1/4]` and `δₛ` from the one-step decay, `δ₁` from the density bounds,
  -- `ω = ωₙ ∈ (0, ∞)`, `δ₂ = min δₛ δ₁`, and `C = 4C₁₀θ₀⁻ⁿ + (2 + 16ωC₁₀)θ₀⁻ⁿ⁻¹` with
  -- `C₁₀ = 8/ω`, i.e. `C = 32/(ωθ₀ⁿ) + 130/θ₀ⁿ⁺¹`.
  obtain ⟨θ₀, δs, hθ₀, hθ₀le, hδs, hδsle, hstep⟩ :=
    Submission.dorag_tilt_excess_one_step_decay n k hn
  obtain ⟨δ₁, C₂, hδ₁, hδ₁le, -, hdens⟩ := Submission.dorag_standing_density_bounds n k hn
  obtain ⟨ω, hω_pos, hω⟩ : ∃ ω : ℝ, 0 < ω ∧ unitBallVolume n = ENNReal.ofReal ω := by
    have h0 : unitBallVolume n ≠ 0 := (measure_ball_pos volume (0 : Euclid n) one_pos).ne'
    have htop : unitBallVolume n ≠ ⊤ :=
      (measure_ball_lt_top (μ := (volume : Measure (Euclid n))) (x := 0) (r := 1)).ne
    exact ⟨(unitBallVolume n).toReal, ENNReal.toReal_pos h0 htop,
      (ENNReal.ofReal_toReal htop).symm⟩
  have hθ₀1 : θ₀ < 1 := by linarith
  obtain ⟨C, hC⟩ : ∃ C : ℝ, C = 32 / (ω * θ₀ ^ n) + 130 / θ₀ ^ (n + 1) := ⟨_, rfl⟩
  have hC1 : 32 / (ω * θ₀ ^ n) ≤ C := by rw [hC]; exact le_add_of_nonneg_right (by positivity)
  have hC2 : 130 / θ₀ ^ (n + 1) ≤ C := by rw [hC]; exact le_add_of_nonneg_left (by positivity)
  have hCpos : 0 < C := by rw [hC]; positivity
  refine ⟨min δs δ₁, C, lt_min hδs hδ₁, (min_le_left _ _).trans hδsle, hCpos, ?_⟩
  intro δ hδ hδ₂ U W R H κ ρ z hW hWU hρ hball hHm hHκ hfv hz hmass hκρ ξ hξ σ T hσ hσle hT
  have hδs' : δ ≤ δs := hδ₂.trans (min_le_left _ _)
  have hδ₁' : δ ≤ δ₁ := hδ₂.trans (min_le_right _ _)
  -- Abbreviations: `I r S = ∫_{B_r(ξ)} |p_x − p_S|² dμ`, `E r S = E_*(ξ, r, S)` and
  -- `d S S' = |p_S − p_{S'}|²`.
  obtain ⟨I, hI⟩ : ∃ I : ℝ → Submodule ℝ (Euclid (n + k)) → ℝ≥0∞, ∀ r S, I r S =
      ∫⁻ x in closedBall ξ r, ENNReal.ofReal (∑ i : Fin (n + k),
        ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) -
          S.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure :=
    ⟨_, fun _ _ => rfl⟩
  obtain ⟨E, hE⟩ : ∃ E : ℝ → Submodule ℝ (Euclid (n + k)) → ℝ≥0∞, ∀ r S,
      E r S = max (ENNReal.ofReal (1 / r ^ n) * I r S) (ENNReal.ofReal (κ ^ 2 * r ^ 2 / δ)) :=
    ⟨_, fun _ _ => rfl⟩
  obtain ⟨d, hd⟩ : ∃ d : Submodule ℝ (Euclid (n + k)) → Submodule ℝ (Euclid (n + k)) → ℝ,
      ∀ S S', d S S' = ∑ i : Fin (n + k), ‖S.starProjection (EuclideanSpace.single i (1 : ℝ)) -
        S'.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2 :=
    ⟨_, fun _ _ => rfl⟩
  suffices key : ∃ S : Submodule ℝ (Euclid (n + k)), Module.finrank ℝ S = n ∧
      (∀ s : ℝ, 0 < s → s ≤ σ → I s S ≤ ENNReal.ofReal (C * (s / σ) * s ^ n) * E σ T) ∧
      ENNReal.ofReal (d S T) ≤ ENNReal.ofReal C * E σ T by
    simpa only [hE, hI, hd] using key
  -- Step 1: the density bounds `½ωtⁿ ≤ μ(B_t(ξ)) ≤ 2ωtⁿ` for `0 < t ≤ δρ`.
  obtain ⟨hDa, hDb, -, -⟩ :=
    hdens δ hδ hδ₁' U W R H κ ρ z hW hWU hρ hball hHm hHκ hfv hz hmass hκρ
  have hδρ : 0 < δ * ρ := mul_pos hδ hρ
  have hξ4 : ξ ∈ closedBall z (4 * δ * ρ) := closedBall_subset_closedBall (by linarith) hξ.2
  have ht4 : ∀ t : ℝ, t ≤ δ * ρ → t ≤ (1 - 4 * δ) * ρ := fun t ht =>
    ht.trans (by nlinarith [mul_le_mul_of_nonneg_right (hδ₁'.trans hδ₁le) hρ.le])
  have hDup : ∀ t : ℝ, 0 < t → t ≤ δ * ρ →
      R.measure (closedBall ξ t) ≤ 2 * ENNReal.ofReal ω * ENNReal.ofReal (t ^ n) := by
    intro t ht htle
    rw [← hω]
    exact hDa ξ hξ4 t ht (ht4 t htle)
  have hDlo : ∀ t : ℝ, 0 < t → t ≤ δ * ρ →
      ENNReal.ofReal ω * ENNReal.ofReal (t ^ n) ≤ 2 * R.measure (closedBall ξ t) := by
    intro t ht htle
    rw [← hω]
    exact hDb ξ ⟨hξ.1, hξ4⟩ t ht (ht4 t htle)
  -- (P4): the integrated Hilbert–Schmidt triangle inequalities on the balls `B_r(ξ)`.
  have hcmp : ∀ (A B : Submodule ℝ (Euclid (n + k))) (r : ℝ),
      ENNReal.ofReal (d A B) * R.measure (closedBall ξ r) ≤ 2 * I r A + 2 * I r B ∧
        I r A ≤ 2 * I r B + 2 * ENNReal.ofReal (d A B) * R.measure (closedBall ξ r) := by
    intro A B r
    simp only [hI, hd]
    exact Submission.dorag_ted_hs_integral_compare (n + k) R.measure
      (fun x => (approxTangentPlane n R.carrier x).starProjection) A.starProjection
      B.starProjection (closedBall ξ r)
      (Submission.dorag_approxTangent_starProjection_aesm (n + k) n U R)
  have hImono : ∀ (S : Submodule ℝ (Euclid (n + k))) (r r' : ℝ), r ≤ r' → I r S ≤ I r' S := by
    intro S r r' hrr'
    rw [hI, hI]
    exact lintegral_mono_set (closedBall_subset_closedBall hrr')
  have hIE : ∀ (S : Submodule ℝ (Euclid (n + k))) (r : ℝ), 0 < r →
      I r S ≤ ENNReal.ofReal (r ^ n) * E r S := by
    intro S r hr
    have hrn : 0 < r ^ n := pow_pos hr n
    calc I r S = ENNReal.ofReal (r ^ n) * (ENNReal.ofReal (1 / r ^ n) * I r S) := by
          rw [← mul_assoc, ← ENNReal.ofReal_mul hrn.le, mul_one_div_cancel hrn.ne',
            ENNReal.ofReal_one, one_mul]
      _ ≤ ENNReal.ofReal (r ^ n) * E r S := by
          rw [hE]
          exact mul_le_mul_of_nonneg_left (le_max_left _ _) zero_le
  -- Step 3: iterate the one-step decay at the scales `θ₀ʲσ`, starting from `S₀ = T`.
  have hstep' : ∀ (r : ℝ) (S : Submodule ℝ (Euclid (n + k))), 0 < r → r ≤ δ * ρ →
      Module.finrank ℝ S = n → ∃ S' : Submodule ℝ (Euclid (n + k)),
        Module.finrank ℝ S' = n ∧ E (θ₀ * r) S' ≤ ENNReal.ofReal θ₀ * E r S := by
    intro r S hr hrle hS
    obtain ⟨S', hS', hdec⟩ := hstep δ hδ hδs' U W R H κ ρ z hW hWU hρ hball hHm hHκ hfv hz
      hmass hκρ ξ hξ r S hr hrle hS
    refine ⟨S', hS', ?_⟩
    simp only [hE, hI]
    exact hdec
  choose! next hnext_rank hnext_dec using hstep'
  obtain ⟨Sq, hSq0, hSqs⟩ : ∃ Sq : ℕ → Submodule ℝ (Euclid (n + k)),
      Sq 0 = T ∧ ∀ j, Sq (j + 1) = next (θ₀ ^ j * σ) (Sq j) :=
    ⟨fun j => Nat.rec (motive := fun _ => Submodule ℝ (Euclid (n + k))) T
      (fun j Sj => next (θ₀ ^ j * σ) Sj) j, rfl, fun _ => rfl⟩
  have hscale : ∀ j : ℕ, 0 < θ₀ ^ j * σ ∧ θ₀ ^ j * σ ≤ δ * ρ := fun j =>
    ⟨by positivity, (mul_le_of_le_one_left hσ.le (pow_le_one₀ hθ₀.le hθ₀1.le)).trans hσle⟩
  have hiter : ∀ j : ℕ, Module.finrank ℝ (Sq j) = n ∧
      E (θ₀ ^ j * σ) (Sq j) ≤ ENNReal.ofReal (θ₀ ^ j) * E σ T := by
    intro j
    induction j with
    | zero =>
      rw [hSq0]
      refine ⟨hT, le_of_eq ?_⟩
      rw [pow_zero, one_mul, ENNReal.ofReal_one, one_mul]
    | succ j ih =>
      rw [hSqs]
      refine ⟨hnext_rank _ _ (hscale j).1 (hscale j).2 ih.1, ?_⟩
      have h := hnext_dec _ _ (hscale j).1 (hscale j).2 ih.1
      rw [show θ₀ * (θ₀ ^ j * σ) = θ₀ ^ (j + 1) * σ by ring] at h
      calc E (θ₀ ^ (j + 1) * σ) (next (θ₀ ^ j * σ) (Sq j))
          ≤ ENNReal.ofReal θ₀ * E (θ₀ ^ j * σ) (Sq j) := h
        _ ≤ ENNReal.ofReal θ₀ * (ENNReal.ofReal (θ₀ ^ j) * E σ T) :=
          mul_le_mul_of_nonneg_left ih.2 zero_le
        _ = ENNReal.ofReal (θ₀ ^ (j + 1)) * E σ T := by
          rw [← mul_assoc, ← ENNReal.ofReal_mul hθ₀.le, pow_succ, mul_comm θ₀]
  -- If `E_* = ∞` there is nothing to prove: take `S = T`.
  by_cases hfin : E σ T = ⊤
  · refine ⟨T, hT, fun s hs _ => ?_, ?_⟩
    · rw [hfin, ENNReal.mul_top (ENNReal.ofReal_pos.2 (by positivity)).ne']
      exact le_top
    · rw [hfin, ENNReal.mul_top (ENNReal.ofReal_pos.2 hCpos).ne']
      exact le_top
  obtain ⟨E₀, hE₀, hE₀eq⟩ : ∃ E₀ : ℝ, 0 ≤ E₀ ∧ E σ T = ENNReal.ofReal E₀ :=
    ⟨(E σ T).toReal, ENNReal.toReal_nonneg, (ENNReal.ofReal_toReal hfin).symm⟩
  -- `∫_{B_r(ξ)} |p_x − p_{Sⱼ}|² ≤ (θ₀ʲσ)ⁿθ₀ʲE_*` for `r ≤ θ₀ʲσ` (Step 3).
  have hIq : ∀ (j : ℕ) (r : ℝ), r ≤ θ₀ ^ j * σ →
      I r (Sq j) ≤ ENNReal.ofReal ((θ₀ ^ j * σ) ^ n * (θ₀ ^ j * E₀)) := by
    intro j r hr
    calc I r (Sq j) ≤ I (θ₀ ^ j * σ) (Sq j) := hImono _ _ _ hr
      _ ≤ ENNReal.ofReal ((θ₀ ^ j * σ) ^ n) * E (θ₀ ^ j * σ) (Sq j) := hIE _ _ (hscale j).1
      _ ≤ ENNReal.ofReal ((θ₀ ^ j * σ) ^ n) * (ENNReal.ofReal (θ₀ ^ j) * E σ T) :=
          mul_le_mul_of_nonneg_left (hiter j).2 zero_le
      _ = ENNReal.ofReal ((θ₀ ^ j * σ) ^ n * (θ₀ ^ j * E₀)) := by
          rw [hE₀eq, ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity)]
  have hcmb : ∀ a b : ℝ, 0 ≤ a → 0 ≤ b →
      2 * (2 * ENNReal.ofReal a + 2 * ENNReal.ofReal b) =
        ENNReal.ofReal (2 * (2 * a + 2 * b)) := by
    intro a b ha hb
    rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_add (by positivity) (by positivity),
      ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity),
      ENNReal.ofReal_ofNat]
  have hcmb' : ∀ a b w v : ℝ, 0 ≤ a → 0 ≤ b → 0 ≤ w → 0 ≤ v →
      2 * ENNReal.ofReal a + 2 * ENNReal.ofReal b * (2 * ENNReal.ofReal w * ENNReal.ofReal v) =
        ENNReal.ofReal (2 * a + 2 * b * (2 * w * v)) := by
    intro a b w v ha hb hw hv
    rw [ENNReal.ofReal_add (by positivity) (by positivity), ENNReal.ofReal_mul (by positivity),
      ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity),
      ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity),
      ENNReal.ofReal_ofNat]
  -- Step 2 (one-step tilt bound): `|p_{Sⱼ₊₁} − p_{Sⱼ}|² ≤ aθ₀ʲ` with `a = C₁₀θ₀⁻ⁿE_*`.
  have hB : ∀ j : ℕ, d (Sq (j + 1)) (Sq j) ≤ 8 * E₀ / (ω * θ₀ ^ n) * θ₀ ^ j := by
    intro j
    obtain ⟨hrpos, hrle⟩ := hscale (j + 1)
    have hrr' : θ₀ ^ (j + 1) * σ ≤ θ₀ ^ j * σ := by
      rw [pow_succ]
      exact mul_le_mul_of_nonneg_right
        (mul_le_of_le_one_right (pow_nonneg hθ₀.le j) hθ₀1.le) hσ.le
    have hdnn : 0 ≤ d (Sq (j + 1)) (Sq j) := by rw [hd]; positivity
    have key : ENNReal.ofReal (d (Sq (j + 1)) (Sq j) * (ω * (θ₀ ^ (j + 1) * σ) ^ n)) ≤
        ENNReal.ofReal (2 * (2 * ((θ₀ ^ (j + 1) * σ) ^ n * (θ₀ ^ (j + 1) * E₀)) +
          2 * ((θ₀ ^ j * σ) ^ n * (θ₀ ^ j * E₀)))) :=
      calc ENNReal.ofReal (d (Sq (j + 1)) (Sq j) * (ω * (θ₀ ^ (j + 1) * σ) ^ n))
          = ENNReal.ofReal (d (Sq (j + 1)) (Sq j)) *
              (ENNReal.ofReal ω * ENNReal.ofReal ((θ₀ ^ (j + 1) * σ) ^ n)) := by
            rw [ENNReal.ofReal_mul hdnn, ENNReal.ofReal_mul hω_pos.le]
        _ ≤ ENNReal.ofReal (d (Sq (j + 1)) (Sq j)) *
              (2 * R.measure (closedBall ξ (θ₀ ^ (j + 1) * σ))) :=
            mul_le_mul_of_nonneg_left (hDlo _ hrpos hrle) zero_le
        _ = 2 * (ENNReal.ofReal (d (Sq (j + 1)) (Sq j)) *
              R.measure (closedBall ξ (θ₀ ^ (j + 1) * σ))) := by ring
        _ ≤ 2 * (2 * I (θ₀ ^ (j + 1) * σ) (Sq (j + 1)) + 2 * I (θ₀ ^ (j + 1) * σ) (Sq j)) :=
            mul_le_mul_of_nonneg_left (hcmp _ _ _).1 zero_le
        _ ≤ 2 * (2 * ENNReal.ofReal ((θ₀ ^ (j + 1) * σ) ^ n * (θ₀ ^ (j + 1) * E₀)) +
              2 * ENNReal.ofReal ((θ₀ ^ j * σ) ^ n * (θ₀ ^ j * E₀))) := by
            have h1 := hIq (j + 1) _ le_rfl
            have h2 := hIq j _ hrr'
            gcongr
        _ = ENNReal.ofReal (2 * (2 * ((θ₀ ^ (j + 1) * σ) ^ n * (θ₀ ^ (j + 1) * E₀)) +
              2 * ((θ₀ ^ j * σ) ^ n * (θ₀ ^ j * E₀)))) :=
            hcmb _ _ (by positivity) (by positivity)
    rw [ENNReal.ofReal_le_ofReal_iff (by positivity)] at key
    -- Divide by `ω(θ₀ʲ⁺¹σ)ⁿ = ωθ₀ⁿ(θ₀ʲσ)ⁿ`, using `θ₀ⁿ⁺¹ ≤ 1`.
    have hu : 0 < (θ₀ ^ j * σ) ^ n := pow_pos (hscale j).1 n
    have e1 : (θ₀ ^ (j + 1) * σ) ^ n = θ₀ ^ n * (θ₀ ^ j * σ) ^ n := by
      rw [pow_succ, mul_comm (θ₀ ^ j) θ₀, mul_assoc, mul_pow]
    have hY : θ₀ ^ n * θ₀ ≤ 1 :=
      (mul_le_of_le_one_left hθ₀.le (pow_le_one₀ hθ₀.le hθ₀1.le)).trans hθ₀1.le
    have h3 : d (Sq (j + 1)) (Sq j) * (ω * θ₀ ^ n) * (θ₀ ^ j * σ) ^ n ≤
        8 * E₀ * θ₀ ^ j * (θ₀ ^ j * σ) ^ n :=
      calc d (Sq (j + 1)) (Sq j) * (ω * θ₀ ^ n) * (θ₀ ^ j * σ) ^ n
          = d (Sq (j + 1)) (Sq j) * (ω * (θ₀ ^ (j + 1) * σ) ^ n) := by rw [e1]; ring
        _ ≤ 2 * (2 * ((θ₀ ^ (j + 1) * σ) ^ n * (θ₀ ^ (j + 1) * E₀)) +
              2 * ((θ₀ ^ j * σ) ^ n * (θ₀ ^ j * E₀))) := key
        _ = 4 * (θ₀ ^ n * θ₀) * ((θ₀ ^ j * σ) ^ n * θ₀ ^ j * E₀) +
              4 * ((θ₀ ^ j * σ) ^ n * θ₀ ^ j * E₀) := by rw [e1, pow_succ]; ring
        _ ≤ 4 * 1 * ((θ₀ ^ j * σ) ^ n * θ₀ ^ j * E₀) + 4 * ((θ₀ ^ j * σ) ^ n * θ₀ ^ j * E₀) :=
            add_le_add (mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_left hY (by norm_num : (0 : ℝ) ≤ 4)) (by positivity)) le_rfl
        _ = 8 * E₀ * θ₀ ^ j * (θ₀ ^ j * σ) ^ n := by ring
    rw [div_mul_eq_mul_div, le_div_iff₀ (by positivity)]
    exact le_of_mul_le_mul_right h3 hu
  -- Step 4: the limit plane `S`, with `|p_S − p_{Sⱼ}|² ≤ 4aθ₀ʲ`.
  obtain ⟨S', hS'rank, hS'd⟩ := Submission.dorag_ted_planes_limit (n + k) n Sq
    (8 * E₀ / (ω * θ₀ ^ n)) θ₀ (fun j => (hiter j).1) hθ₀.le hθ₀le
    (fun j => by have h := hB j; rwa [hd] at h)
  have hS'd' : ∀ j, d S' (Sq j) ≤ 4 * (8 * E₀ / (ω * θ₀ ^ n)) * θ₀ ^ j := fun j => by
    rw [hd]; exact hS'd j
  refine ⟨S', hS'rank, fun s hs hsσ => ?_, ?_⟩
  · -- Step 5: interpolation between the scales `θ₀ʲ⁺¹σ < s ≤ θ₀ʲσ`.
    obtain ⟨j, hj1, hj2⟩ :=
      exists_nat_pow_near_of_lt_one (div_pos hs hσ) ((div_le_one hσ).2 hsσ) hθ₀ hθ₀1
    have hsj : s ≤ θ₀ ^ j * σ := by rwa [div_le_iff₀ hσ] at hj2
    have hjσ : θ₀ ^ j * σ ≤ s / θ₀ := by
      rw [le_div_iff₀ hθ₀]
      calc θ₀ ^ j * σ * θ₀ = θ₀ ^ (j + 1) * σ := by ring
        _ ≤ s := ((lt_div_iff₀ hσ).1 hj1).le
    have hpow : (θ₀ ^ j * σ) ^ n ≤ s ^ n / θ₀ ^ n := by
      rw [← div_pow]
      exact pow_le_pow_left₀ (hscale j).1.le hjσ n
    have ht : θ₀ ^ j ≤ s / σ / θ₀ := by
      rw [le_div_iff₀ hθ₀, ← pow_succ]
      exact hj1.le
    have hω0 : ω ≠ 0 := hω_pos.ne'
    have hθn : θ₀ ^ n ≠ 0 := (pow_pos hθ₀ n).ne'
    calc I s S' ≤ 2 * I s (Sq j) + 2 * ENNReal.ofReal (d S' (Sq j)) *
          R.measure (closedBall ξ s) := (hcmp _ _ _).2
      _ ≤ 2 * ENNReal.ofReal ((θ₀ ^ j * σ) ^ n * (θ₀ ^ j * E₀)) +
          2 * ENNReal.ofReal (4 * (8 * E₀ / (ω * θ₀ ^ n)) * θ₀ ^ j) *
            (2 * ENNReal.ofReal ω * ENNReal.ofReal (s ^ n)) := by
          have h1 := hIq j s hsj
          have h2 : ENNReal.ofReal (d S' (Sq j)) ≤
              ENNReal.ofReal (4 * (8 * E₀ / (ω * θ₀ ^ n)) * θ₀ ^ j) :=
            ENNReal.ofReal_le_ofReal (hS'd' j)
          have h3 := hDup s hs (hsσ.trans hσle)
          gcongr
      _ = ENNReal.ofReal (2 * ((θ₀ ^ j * σ) ^ n * (θ₀ ^ j * E₀)) +
          2 * (4 * (8 * E₀ / (ω * θ₀ ^ n)) * θ₀ ^ j) * (2 * ω * s ^ n)) :=
          hcmb' _ _ _ _ (by positivity) (by positivity) hω_pos.le (by positivity)
      _ ≤ ENNReal.ofReal (C * (s / σ) * s ^ n * E₀) := by
          refine ENNReal.ofReal_le_ofReal ?_
          calc 2 * ((θ₀ ^ j * σ) ^ n * (θ₀ ^ j * E₀)) +
                2 * (4 * (8 * E₀ / (ω * θ₀ ^ n)) * θ₀ ^ j) * (2 * ω * s ^ n)
              = 2 * ((θ₀ ^ j * σ) ^ n * (θ₀ ^ j * E₀)) +
                128 * (s ^ n / θ₀ ^ n) * (θ₀ ^ j * E₀) := by
                field_simp
                ring
            _ ≤ 2 * (s ^ n / θ₀ ^ n * (θ₀ ^ j * E₀)) + 128 * (s ^ n / θ₀ ^ n) * (θ₀ ^ j * E₀) := by
                gcongr
            _ = 130 * (s ^ n / θ₀ ^ n) * E₀ * θ₀ ^ j := by ring
            _ ≤ 130 * (s ^ n / θ₀ ^ n) * E₀ * (s / σ / θ₀) := by gcongr
            _ = 130 / θ₀ ^ (n + 1) * (s / σ) * s ^ n * E₀ := by ring
            _ ≤ C * (s / σ) * s ^ n * E₀ := by gcongr
      _ = ENNReal.ofReal (C * (s / σ) * s ^ n) * E σ T := by
          rw [hE₀eq, ENNReal.ofReal_mul (by positivity)]
  · -- Step 4 with `j = 0` (`S₀ = T`): `|p_S − p_T|² ≤ 4a = 4C₁₀θ₀⁻ⁿE_* ≤ CE_*`.
    have h0 := hS'd' 0
    rw [hSq0, pow_zero, mul_one] at h0
    rw [hE₀eq, ← ENNReal.ofReal_mul hCpos.le]
    refine ENNReal.ofReal_le_ofReal (h0.trans ?_)
    calc 4 * (8 * E₀ / (ω * θ₀ ^ n)) = 32 / (ω * θ₀ ^ n) * E₀ := by ring
      _ ≤ C * E₀ := mul_le_mul_of_nonneg_right hC1 hE₀

/-- **Simon Ch. 5, Theorem 5.2 with Remark 5.3 (Allard regularity), bounded mean curvature
(`p = 2n` in 5.1).**  If `z ∈ spt μ`, `μ(B̄_ρ(z)) ≤ (1 + δ₀)ωₙρⁿ` and `κρ ≤ δ₀`, then
`spt μ ∩ B_{γρ}(z)` is the graph over `B_{γρ}(0)` of a `C¹` map `u` with `u(0) = 0` and
`‖Du‖ ≤ ε`.  Parts 8.1–8.9 of the proof: the base plane (`dorag_affine_approximation`),
tilt-excess decay at every point of `spt μ ∩ B_{δ₀ρ/2}(z)` (`dorag_tilt_excess_decay`), the
graph criterion (`dorag_lipschitz_approximation`) and `C¹` regularity
(`dorag_graph_c1_of_tilt_decay`), with `δ₀ = min{δ₁, δ₂, δ₃, δ₅, t^{2n+2}}` and `γ = δ₀/16`. -/
theorem Submission.dor_allard_bounded_curvature_graph : ∀ (n k : ℕ), 0 < n → ∀ ε : ℝ, 0 < ε → ∃ δ₀ γ : ℝ, 0 < δ₀ ∧ 0 < γ ∧ γ ≤ 1 ∧ ∀ (U W : Set (Euclid (n + k))) (R : IMRep U n) (H : Euclid (n + k) → Euclid (n + k)) (κ ρ : ℝ) (z : Euclid (n + k)), IsOpen W → W ⊆ U → 0 < ρ → closedBall z ρ ⊆ W → AEStronglyMeasurable H R.measure → (∀ x, ‖H x‖ ≤ κ) → (∀ X : Euclid (n + k) → Euclid (n + k), ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ W → R.firstVariation X = -∫ x, inner ℝ (X x) (H x) ∂R.measure) → z ∈ R.measure.support → R.measure (closedBall z ρ) ≤ ENNReal.ofReal (1 + δ₀) * unitBallVolume n * ENNReal.ofReal (ρ ^ n) → κ * ρ ≤ δ₀ → ∃ (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (u : Euclid n → Euclid k), (∀ v w, inner ℝ (ι v) (ι' w) = 0) ∧ u 0 = 0 ∧ ContDiffOn ℝ 1 u (ball 0 (γ * ρ)) ∧ (∀ v ∈ ball (0 : Euclid n) (γ * ρ), ‖fderiv ℝ u v‖ ≤ ε) ∧ R.measure.support ∩ ball z (γ * ρ) = ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) (γ * ρ)) ∩ ball z (γ * ρ) := by
  have h_db := Submission.dorag_standing_density_bounds
  have h_aa := Submission.dorag_affine_approximation
  have h_la := Submission.dorag_lipschitz_approximation
  have h_td := Submission.dorag_tilt_excess_decay
  have h_gc := Submission.dorag_graph_c1_of_tilt_decay
  intro n k hn ε hε
  -- Part 0: the constants of the children (Simon 5.2 with `p = 2n`)
  obtain ⟨δ₁, C₂, hδ₁, hδ₁8, -, hDB⟩ := h_db n k hn
  obtain ⟨δ₃, C₃, hδ₃, -, hC₃, hAA⟩ := h_aa n k hn
  obtain ⟨δ₅, β, β', C₇, hδ₅, -, hβ', hβ'β, -, -, hLA⟩ :=
    h_la n k hn (2 * C₃) (by linarith)
  obtain ⟨δ₂, C, hδ₂, -, hC, hTD⟩ := h_td n k hn
  have hC₃0 : 0 < C₃ := by linarith
  have hω_fin : unitBallVolume n ≠ ⊤ := measure_ball_lt_top.ne
  obtain ⟨ω, hω⟩ : ∃ ω : ℝ, ω = (unitBallVolume n).toReal := ⟨_, rfl⟩
  have hω0 : 0 ≤ ω := by rw [hω]; exact ENNReal.toReal_nonneg
  have hω_eq : ENNReal.ofReal ω = unitBallVolume n := by
    rw [hω, ENNReal.ofReal_toReal hω_fin]
  obtain ⟨L₀, hL₀⟩ : ∃ L₀ : ℝ, L₀ = min ε (1 / 4) := ⟨_, rfl⟩
  have hL₀0 : 0 < L₀ := by rw [hL₀]; exact lt_min hε (by norm_num)
  have hL₀ε : L₀ ≤ ε := by rw [hL₀]; exact min_le_left _ _
  have hL₀4 : L₀ ≤ 1 / 4 := by rw [hL₀]; exact min_le_right _ _
  obtain ⟨A, hA⟩ : ∃ A : ℝ, A = (2 * C + 4 * ω * C) * 2 ^ n * C₃ := ⟨_, rfl⟩
  have hA0 : 0 ≤ A := by rw [hA]; positivity
  obtain ⟨t, ht⟩ : ∃ t : ℝ, t = β' * L₀ / (A + 1) := ⟨_, rfl⟩
  have hA1 : A + 1 ≠ 0 := by positivity
  have ht0 : 0 < t := by rw [ht]; positivity
  have htA : (A + 1) * t = β' * L₀ := by rw [ht]; field_simp
  have htβ' : t ≤ β' * L₀ := by have := mul_nonneg hA0 ht0.le; linarith
  have htβ : t ≤ β * L₀ := htβ'.trans (by gcongr)
  have hAt : A * t ^ 2 ≤ β' ^ 2 * L₀ ^ 2 := by
    calc A * t ^ 2 ≤ (A + 1) * t ^ 2 := by have := sq_nonneg t; linarith
      _ = β' * L₀ * t := by rw [← htA]; ring
      _ ≤ β' * L₀ * (β' * L₀) := by gcongr
      _ = β' ^ 2 * L₀ ^ 2 := by ring
  obtain ⟨δ₀, hδ₀⟩ : ∃ δ₀ : ℝ,
      δ₀ = min δ₁ (min δ₂ (min δ₃ (min δ₅ (t ^ (2 * n + 2))))) := ⟨_, rfl⟩
  have hδ₀0 : 0 < δ₀ := by
    rw [hδ₀]; exact lt_min hδ₁ (lt_min hδ₂ (lt_min hδ₃ (lt_min hδ₅ (by positivity))))
  have hδ₀δ₁ : δ₀ ≤ δ₁ := by rw [hδ₀]; exact min_le_left _ _
  have hδ₀δ₂ : δ₀ ≤ δ₂ := by rw [hδ₀]; exact (min_le_right _ _).trans (min_le_left _ _)
  have hδ₀δ₃ : δ₀ ≤ δ₃ := by
    rw [hδ₀]; exact (min_le_right _ _).trans ((min_le_right _ _).trans (min_le_left _ _))
  have hδ₀δ₅ : δ₀ ≤ δ₅ := by
    rw [hδ₀]
    exact (min_le_right _ _).trans
      ((min_le_right _ _).trans ((min_le_right _ _).trans (min_le_left _ _)))
  have hδ₀t : δ₀ ≤ t ^ (2 * n + 2) := by
    rw [hδ₀]
    exact (min_le_right _ _).trans
      ((min_le_right _ _).trans ((min_le_right _ _).trans (min_le_right _ _)))
  have hδ₀8 : δ₀ ≤ 1 / 8 := hδ₀δ₁.trans hδ₁8
  have hδ₀1 : δ₀ ≤ 1 := by linarith
  -- `α = 1/(2n+2)` and `δ₀ ≤ δ₀ ^ α ≤ t`
  have hα0 : (0 : ℝ) < (1 : ℝ) / (2 * (n : ℝ) + 2) := by positivity
  have hα1 : (1 : ℝ) / (2 * (n : ℝ) + 2) ≤ 1 := by
    rw [div_le_one (by positivity)]; have : (0 : ℝ) ≤ n := Nat.cast_nonneg n; linarith
  have hd0 : 0 < δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2)) := Real.rpow_pos_of_pos hδ₀0 _
  have hδ₀d : δ₀ ≤ δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2)) :=
    Real.self_le_rpow_of_le_one hδ₀0.le hδ₀1 hα1
  have hdt : δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2)) ≤ t := by
    calc δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2))
        ≤ (t ^ (2 * n + 2)) ^ ((1 : ℝ) / (2 * (n : ℝ) + 2)) :=
          Real.rpow_le_rpow hδ₀0.le hδ₀t hα0.le
      _ = t := by
          rw [show (1 : ℝ) / (2 * (n : ℝ) + 2) = ((2 * n + 2 : ℕ) : ℝ)⁻¹ by push_cast; ring]
          exact Real.pow_rpow_inv_natCast ht0.le (by omega)
  -- `E₀ = 2ⁿC₃δ₀^{2α}` bounds every normalized tilt-excess `E_*` below (Simon 5.2, (1))
  obtain ⟨E₀, hE₀⟩ : ∃ E₀ : ℝ,
      E₀ = 2 ^ n * C₃ * (δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2))) ^ 2 := ⟨_, rfl⟩
  have hE₀0 : 0 ≤ E₀ := by rw [hE₀]; positivity
  have hdE₀ : (δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2))) ^ 2 ≤ E₀ := by
    rw [hE₀]
    have h2n : (1 : ℝ) ≤ 2 ^ n := one_le_pow₀ (by norm_num)
    exact le_mul_of_one_le_left (sq_nonneg _) (one_le_mul_of_one_le_of_one_le h2n hC₃)
  have hAE₀ : A * (δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2))) ^ 2 ≤ β' ^ 2 * L₀ ^ 2 :=
    (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hd0.le hdt 2) hA0).trans hAt
  refine ⟨δ₀, δ₀ / 16, hδ₀0, by positivity, by linarith, ?_⟩
  intro U W R H κ ρ z hW hWU hρ hzρ hH hHκ hMC hz hmass hκρ
  have hκ0 : 0 ≤ κ := (norm_nonneg _).trans (hHκ 0)
  obtain ⟨hDBa, -, -, -⟩ :=
    hDB δ₀ hδ₀0 hδ₀δ₁ U W R H κ ρ z hW hWU hρ hzρ hH hHκ hMC hz hmass hκρ
  have hδρ : 0 < δ₀ * ρ := mul_pos hδ₀0 hρ
  have hδρ8 : δ₀ * ρ ≤ ρ / 8 := by
    have := mul_le_mul_of_nonneg_right hδ₀8 hρ.le; linarith
  have hzmem : ∀ r : ℝ, 0 ≤ r → z ∈ R.measure.support ∩ closedBall z r := fun r hr =>
    ⟨hz, mem_closedBall_self hr⟩
  -- (8.1) the base plane `T₀`: affine approximation at `(z, 2δ₀ρ)`
  obtain ⟨T₀, hT₀n, hT₀a, hT₀b⟩ := hAA δ₀ hδ₀0 hδ₀δ₃ U W R H κ ρ z hW hWU hρ hzρ hH hHκ hMC
    hz hmass hκρ z (hzmem _ (by positivity)) (2 * δ₀ * ρ) (by positivity) le_rfl
  rw [show 2 * δ₀ * ρ / 2 = δ₀ * ρ by ring] at hT₀b
  -- (8.2–8.3) tilt-excess decay at every point of `spt μ ∩ B_{δ₀ρ/2}(z)`, with `E_* ≤ E₀`
  have hdecay : ∀ y ∈ R.measure.support ∩ closedBall z (δ₀ * ρ / 2),
      ∃ S : Submodule ℝ (Euclid (n + k)), Module.finrank ℝ S = n ∧
        (∀ s : ℝ, 0 < s → s ≤ δ₀ * ρ / 2 →
          ∫⁻ x in closedBall y s, ENNReal.ofReal (∑ i : Fin (n + k),
            ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) -
              S.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure ≤
            ENNReal.ofReal (C * (s / (δ₀ * ρ / 2)) * s ^ n * E₀)) ∧
        ENNReal.ofReal (∑ i : Fin (n + k),
          ‖S.starProjection (EuclideanSpace.single i (1 : ℝ)) -
            T₀.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ≤
          ENNReal.ofReal (C * E₀) := by
    intro y hy
    have hyz : dist y z ≤ δ₀ * ρ / 2 := mem_closedBall.1 hy.2
    obtain ⟨S, hSn, hS1, hS2⟩ := hTD δ₀ hδ₀0 hδ₀δ₂ U W R H κ ρ z hW hWU hρ hzρ hH hHκ hMC hz
      hmass hκρ y ⟨hy.1, closedBall_subset_closedBall (by linarith) hy.2⟩ (δ₀ * ρ / 2) T₀
      (by positivity) (by linarith) hT₀n
    have hE : max (ENNReal.ofReal (1 / (δ₀ * ρ / 2) ^ n) *
        ∫⁻ x in closedBall y (δ₀ * ρ / 2), ENNReal.ofReal (∑ i : Fin (n + k),
          ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) -
            T₀.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure)
        (ENNReal.ofReal (κ ^ 2 * (δ₀ * ρ / 2) ^ 2 / δ₀)) ≤ ENNReal.ofReal E₀ := by
      apply max_le
      · calc _ ≤ ENNReal.ofReal (1 / (δ₀ * ρ / 2) ^ n) * ENNReal.ofReal
              (C₃ * (δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2))) ^ 2 * (δ₀ * ρ) ^ n) := by
              gcongr
              exact (lintegral_mono_set (closedBall_subset_closedBall' (by linarith))).trans
                hT₀b
          _ = ENNReal.ofReal E₀ := by
              rw [← ENNReal.ofReal_mul (by positivity), hE₀]
              congr 1
              rw [div_pow, one_div_div, div_mul_eq_mul_div, div_eq_iff (by positivity)]
              ring
      · apply ENNReal.ofReal_le_ofReal
        rw [div_le_iff₀ hδ₀0]
        have hκσ : κ * (δ₀ * ρ / 2) ≤ δ₀ ^ 2 / 2 := by
          linarith [mul_le_mul_of_nonneg_right hκρ hδ₀0.le]
        calc κ ^ 2 * (δ₀ * ρ / 2) ^ 2 = (κ * (δ₀ * ρ / 2)) ^ 2 := by ring
          _ ≤ (δ₀ ^ 2 / 2) ^ 2 := pow_le_pow_left₀ (by positivity) hκσ 2
          _ ≤ δ₀ ^ 2 * δ₀ := by
              linarith [pow_pos hδ₀0 3, mul_le_mul_of_nonneg_left hδ₀1 (pow_pos hδ₀0 3).le]
          _ ≤ E₀ * δ₀ := by
              gcongr
              exact (pow_le_pow_left₀ hδ₀0.le hδ₀d 2).trans hdE₀
    refine ⟨S, hSn, fun s hs hsσ => ?_, ?_⟩
    · calc _ ≤ _ := hS1 s hs hsσ
        _ ≤ ENNReal.ofReal (C * (s / (δ₀ * ρ / 2)) * s ^ n) * ENNReal.ofReal E₀ := by gcongr
        _ = _ := (ENNReal.ofReal_mul (by positivity)).symm
    · calc _ ≤ _ := hS2
        _ ≤ ENNReal.ofReal C * ENNReal.ofReal E₀ := by gcongr
        _ = _ := (ENNReal.ofReal_mul hC.le).symm
  -- pointwise `|p_x − p_T|² ≤ 2|p_x − p_S|² + 2|p_S − p_T|²`
  have hsplit : ∀ P Q S : Submodule ℝ (Euclid (n + k)),
      ENNReal.ofReal (∑ i : Fin (n + k), ‖P.starProjection (EuclideanSpace.single i (1 : ℝ)) -
        Q.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ≤
      2 * ENNReal.ofReal (∑ i : Fin (n + k),
        ‖P.starProjection (EuclideanSpace.single i (1 : ℝ)) -
          S.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) +
      2 * ENNReal.ofReal (∑ i : Fin (n + k),
        ‖S.starProjection (EuclideanSpace.single i (1 : ℝ)) -
          Q.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) := by
    intro P Q S
    have key : ∀ a b c : Euclid (n + k),
        ‖a - c‖ ^ 2 ≤ 2 * ‖a - b‖ ^ 2 + 2 * ‖b - c‖ ^ 2 := by
      intro a b c
      have h1 := norm_sub_le_norm_sub_add_norm_sub a b c
      have h2 := pow_le_pow_left₀ (norm_nonneg _) h1 2
      linarith [sq_nonneg (‖a - b‖ - ‖b - c‖)]
    have hsum : ∑ i : Fin (n + k), ‖P.starProjection (EuclideanSpace.single i (1 : ℝ)) -
          Q.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2 ≤
        2 * ∑ i : Fin (n + k), ‖P.starProjection (EuclideanSpace.single i (1 : ℝ)) -
          S.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2 +
        2 * ∑ i : Fin (n + k), ‖S.starProjection (EuclideanSpace.single i (1 : ℝ)) -
          Q.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2 := by
      rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
      exact Finset.sum_le_sum fun i _ => key _ _ _
    have h := ENNReal.ofReal_le_ofReal hsum
    rw [ENNReal.ofReal_add (by positivity) (by positivity), ENNReal.ofReal_mul (by positivity),
      ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_ofNat] at h
    exact h
  -- (8.4) hypothesis of the graph criterion (Simon 5.2.7) for `T₀` on `B_{δ₀ρ/2}(z)`
  have h5Bhyp : ∀ y ∈ R.measure.support ∩ closedBall z (δ₀ * ρ / 2), ∀ t' : ℝ, 0 < t' →
      t' ≤ δ₀ * ρ / 2 →
      ∫⁻ x in closedBall y t', ENNReal.ofReal (∑ i : Fin (n + k),
        ‖(approxTangentPlane n R.carrier x).starProjection (EuclideanSpace.single i (1 : ℝ)) -
          T₀.starProjection (EuclideanSpace.single i (1 : ℝ))‖ ^ 2) ∂R.measure ≤
        ENNReal.ofReal (β' ^ 2 * L₀ ^ 2 * t' ^ n) := by
    intro y hy t' ht'0 ht'σ
    obtain ⟨S, -, hS1, hS2⟩ := hdecay y hy
    have hball : R.measure (closedBall y t') ≤ ENNReal.ofReal (2 * ω * t' ^ n) := by
      refine (hDBa y ?_ t' ht'0 (by linarith)).trans (le_of_eq ?_)
      · exact closedBall_subset_closedBall (by linarith) hy.2
      · rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by norm_num), hω_eq,
          ENNReal.ofReal_ofNat]
    refine (lintegral_mono fun x => hsplit (approxTangentPlane n R.carrier x) T₀ S).trans ?_
    rw [lintegral_add_right _ measurable_const, setLIntegral_const,
      lintegral_const_mul' _ _ (by simp)]
    refine (add_le_add (mul_le_mul_right (hS1 t' ht'0 ht'σ) 2)
      (mul_le_mul' (mul_le_mul_right hS2 2) hball)).trans ?_
    have hreal : 2 * (C * (t' / (δ₀ * ρ / 2)) * t' ^ n * E₀) +
        2 * (C * E₀) * (2 * ω * t' ^ n) ≤ β' ^ 2 * L₀ ^ 2 * t' ^ n := by
      have hq : t' / (δ₀ * ρ / 2) ≤ 1 := div_le_one_of_le₀ ht'σ (by positivity)
      have hX : 0 ≤ 2 * C * E₀ * t' ^ n := by positivity
      have hkey : A * (δ₀ ^ ((1 : ℝ) / (2 * (n : ℝ) + 2))) ^ 2 * t' ^ n -
          (2 * (C * (t' / (δ₀ * ρ / 2)) * t' ^ n * E₀) + 2 * (C * E₀) * (2 * ω * t' ^ n)) =
          2 * C * E₀ * t' ^ n * (1 - t' / (δ₀ * ρ / 2)) := by
        rw [hA, hE₀]; ring
      have := mul_nonneg hX (sub_nonneg.2 hq)
      have := mul_le_mul_of_nonneg_right hAE₀ (pow_nonneg ht'0.le n)
      linarith
    have h := ENNReal.ofReal_le_ofReal hreal
    rw [ENNReal.ofReal_add (by positivity) (by positivity),
      ENNReal.ofReal_mul (p := 2) (q := C * (t' / (δ₀ * ρ / 2)) * t' ^ n * E₀) (by norm_num),
      ENNReal.ofReal_mul (p := 2 * (C * E₀)) (q := 2 * ω * t' ^ n) (by positivity),
      ENNReal.ofReal_mul (p := 2) (q := C * E₀) (by norm_num), ENNReal.ofReal_ofNat] at h
    exact h
  -- (8.4) Lipschitz approximation and graph criterion at `(z, δ₀ρ, T₀, L₀)`
  obtain ⟨ι, ι', f, hιι', -, hfL, -, -, h5B⟩ := hLA δ₀ hδ₀0 hδ₀δ₅ U W R H κ ρ z hW hWU hρ hzρ
    hH hHκ hMC hz hmass hκρ z (hzmem _ (by positivity)) (δ₀ * ρ) L₀ T₀ hδρ le_rfl hT₀n hL₀0
    (by linarith) (hdt.trans htβ)
    (hT₀b.trans (ENNReal.ofReal_le_ofReal (by gcongr; linarith)))
    (fun x hx => (hT₀a x ⟨hx.1, closedBall_subset_closedBall (by linarith) hx.2⟩).trans
      (le_of_eq (by ring)))
  have hgraph := h5B h5Bhyp
  -- `|v| ≤ |ιv + ι'w|`
  have hnorm : ∀ v w, ‖v‖ ≤ ‖ι v + ι' w‖ := by
    intro v w
    have h : ‖ι v + ι' w‖ ^ 2 = ‖v‖ ^ 2 + ‖w‖ ^ 2 := by
      rw [norm_add_sq_real, hιι', LinearIsometry.norm_map, LinearIsometry.norm_map]; ring
    refine (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).1 ?_
    rw [h]; linarith [sq_nonneg ‖w‖]
  -- `f(0) = 0`, since `z ∈ spt μ`
  have hf0 : f 0 = 0 := by
    have hzg : z ∈ range (fun v => z + ι v + ι' (f v)) ∩ closedBall z (δ₀ * ρ / 8) := by
      rw [← hgraph]; exact hzmem _ (by positivity)
    obtain ⟨v₀, hv₀⟩ := hzg.1
    have hsum : ι v₀ + ι' (f v₀) = 0 := by
      have h : z + (ι v₀ + ι' (f v₀)) = z + 0 := by rw [← add_assoc, add_zero]; exact hv₀
      exact add_left_cancel h
    have hv : v₀ = 0 := by
      have := hnorm v₀ (f v₀)
      rw [hsum, norm_zero] at this
      exact norm_le_zero_iff.1 this
    subst hv
    have h1 : ι' (f 0) = 0 := by simpa using hsum
    rw [← norm_eq_zero, ← LinearIsometry.norm_map ι' (f 0), h1, norm_zero]
  -- (8.5–8.8) `f` is `C¹` on `B_{δ₀ρ/16}(0)`
  have hC1 : ContDiffOn ℝ 1 f (ball (0 : Euclid n) (δ₀ * ρ / 8 / 2)) :=
    h_gc n k hn U W R H κ ι ι' f z (δ₀ * ρ / 8) (δ₀ * ρ / 2) (C * E₀ / (δ₀ * ρ / 2)) hW hWU
      hH hHκ hMC hιι' (fun v w => (hfL v w).trans (by gcongr)) hf0 (by positivity)
      (by positivity) ((closedBall_subset_closedBall (by linarith)).trans hzρ) hgraph
      (fun ξ hξ => by
        obtain ⟨S, hSn, hS1, -⟩ :=
          hdecay ξ ⟨hξ.1, closedBall_subset_closedBall (by linarith) hξ.2⟩
        exact ⟨S, hSn, fun s hs hsσ => (hS1 s hs hsσ).trans (le_of_eq (by congr 1; ring))⟩)
  -- (8.9, 9) conclusion with `u := f`
  have hlip : LipschitzWith (Real.toNNReal L₀) f := LipschitzWith.of_dist_le_mul fun v w => by
    rw [dist_eq_norm, dist_eq_norm, Real.coe_toNNReal _ hL₀0.le]; exact hfL v w
  have hball8 : ball z (δ₀ / 16 * ρ) ⊆ closedBall z (δ₀ * ρ / 8) :=
    ball_subset_closedBall.trans (closedBall_subset_closedBall (by linarith))
  refine ⟨ι, ι', f, hιι', hf0, ?_, fun v _ => ?_, ?_⟩
  · rw [show δ₀ / 16 * ρ = δ₀ * ρ / 8 / 2 by ring]; exact hC1
  · exact (norm_fderiv_le_of_lipschitz ℝ hlip).trans
      (by rw [Real.coe_toNNReal _ hL₀0.le]; exact hL₀ε)
  · ext x
    constructor
    · rintro ⟨hx, hxb⟩
      have hx' : x ∈ range (fun v => z + ι v + ι' (f v)) ∩ closedBall z (δ₀ * ρ / 8) := by
        rw [← hgraph]; exact ⟨hx, hball8 hxb⟩
      obtain ⟨⟨v, rfl⟩, -⟩ := hx'
      refine ⟨⟨v, ?_, rfl⟩, hxb⟩
      rw [mem_ball, dist_eq_norm] at hxb
      rw [mem_ball_zero_iff]
      calc ‖v‖ ≤ ‖ι v + ι' (f v)‖ := hnorm v (f v)
        _ = ‖z + ι v + ι' (f v) - z‖ := by congr 1; abel
        _ < _ := hxb
    · rintro ⟨⟨v, -, rfl⟩, hxb⟩
      have hx' : z + ι v + ι' (f v) ∈ R.measure.support ∩ closedBall z (δ₀ * ρ / 8) := by
        rw [hgraph]; exact ⟨⟨v, rfl⟩, hball8 hxb⟩
      exact ⟨hx'.1, hxb⟩

/-- **Blow-ups of `M ∩ N` approach every vector of an approximate tangent space** (Simon Ch. 3,
Definition 1.4, chapter-03.txt lines 77–83, tested as in Remark 1.5(3), lines 90–92).  If
`Hⁿ(M \ N) = 0`, `Q` is an approximate tangent space of `M` at `x`, `w ∈ Q` and `s > 0`, then for
all small `λ > 0` some `y ∈ M ∩ N` has `|λ⁻¹(y − x) − w| < s`.  The tent `f = max(0, s − |· − w|)`
lies in `C_c`, vanishes off `B_s(w)` and has `∫_Q f dHⁿ > 0`, so `∫_{η_{x,λ}(M)} f dHⁿ > 0` for
small `λ`; hence `Hⁿ(η_{x,λ}(M) ∩ B_s(w)) ≠ 0`, and since `η_{x,λ}(M \ N)` is `Hⁿ`-null,
`η_{x,λ}(M ∩ N)` meets `B_s(w)`. -/
theorem Submission.dsmc_att_blowUp_points_of_approxTangent : ∀ (P n : ℕ) (M N : Set (Euclid P)) (x w : Euclid P) (Q : Submodule ℝ (Euclid P)), μHE[n] (M \ N) = 0 → HasApproximateTangentSpaceAt n M x Q → w ∈ Q → ∀ s : ℝ, 0 < s → ∃ lam₀ : ℝ, 0 < lam₀ ∧ ∀ lam : ℝ, 0 < lam → lam < lam₀ → ∃ y ∈ M ∩ N, ‖lam⁻¹ • (y - x) - w‖ < s := by
  intro P n M N x w Q hMN hQ hw s hs
  -- the tent `g = max(0, s − |· − w|)`: continuous, `g ≥ 0`, `g(w) = s` and `{g ≠ 0} ⊆ B_s(w)`
  set g : Euclid P → ℝ := fun y => max 0 (s - ‖y - w‖)
  have hg_cont : Continuous g :=
    continuous_const.max (continuous_const.sub (continuous_id.sub continuous_const).norm)
  have hg_nonneg : ∀ y, 0 ≤ g y := fun y => le_max_left _ _
  have hg_ball : ∀ y, g y ≠ 0 → y ∈ ball w s := by
    intro y hy
    rw [mem_ball, dist_eq_norm]
    by_contra h
    exact hy (max_eq_left (by linarith [not_lt.mp h]))
  have hg_supp : HasCompactSupport g :=
    HasCompactSupport.intro (isCompact_closedBall w s) fun y hy =>
      not_not.mp fun h => hy (ball_subset_closedBall (hg_ball y h))
  let f : CompactlySupportedContinuousMap (Euclid P) ℝ := ⟨⟨g, hg_cont⟩, hg_supp⟩
  -- `∫_Q f dHⁿ > 0`, hence `∫_{η_{x,λ}(M)} f dHⁿ > 0` for every `λ ∈ (0, λ₀)`
  have hI : 0 < ∫ y in (Q : Set (Euclid P)), g y ∂μHE[n] :=
    Submission.dsmc_att_setIntegral_submodule_pos P n Q g w hQ.1 hg_cont hg_supp hg_nonneg hw
      (by simp [g, hs])
  obtain ⟨lam₀, hlam₀, hpos⟩ :=
    mem_nhdsGT_iff_exists_Ioo_subset.mp ((hQ.2 f).eventually (lt_mem_nhds hI))
  refine ⟨lam₀, hlam₀, fun lam hlam hlam₀' => ?_⟩
  set η := Poincare.SimonGMT.Chapter03.blowUpMap x lam with hη
  -- a positive integral of `f` over `η(M)` forces `Hⁿ(η(M) ∩ B_s(w)) ≠ 0`
  have hball : μHE[n] (η '' M ∩ ball w s) ≠ 0 := by
    intro h0
    have hF : 0 < ∫ y in η '' M, f y ∂μHE[n] := hpos ⟨hlam, hlam₀'⟩
    have hF0 : ∫ y in η '' M, f y ∂μHE[n] = 0 := by
      apply integral_eq_zero_of_ae
      rw [EventuallyEq, ae_iff]
      refine measure_mono_null (fun y hy => hg_ball y hy) ?_
      rw [Measure.restrict_apply measurableSet_ball, inter_comm]
      exact h0
    exact hF.ne' hF0
  -- `η(M \ N)` is `Hⁿ`-null and `η(M) ∩ B_s(w) ⊆ (η(M ∩ N) ∩ B_s(w)) ∪ η(M \ N)`
  have hnull : μHE[n] (η '' (M \ N)) = 0 :=
    Submission.dsmc_att_blowUpMap_image_null P n (M \ N) x lam hlam.ne' hMN
  have hcov : η '' M ∩ ball w s ⊆ (η '' (M ∩ N) ∩ ball w s) ∪ η '' (M \ N) := by
    rintro z ⟨⟨y, hyM, rfl⟩, hz⟩
    by_cases hyN : y ∈ N
    · exact Or.inl ⟨⟨y, ⟨hyM, hyN⟩, rfl⟩, hz⟩
    · exact Or.inr ⟨y, ⟨hyM, hyN⟩, rfl⟩
  have hne : μHE[n] (η '' (M ∩ N) ∩ ball w s) ≠ 0 := fun h0 =>
    hball (measure_mono_null hcov (measure_union_null h0 hnull))
  -- so `η(M ∩ N)` meets `B_s(w)`
  obtain ⟨z, ⟨y, hy, rfl⟩, hz⟩ := nonempty_of_measure_ne_zero hne
  refine ⟨y, hy, ?_⟩
  rw [mem_ball, dist_eq_norm] at hz
  simpa [hη, Poincare.SimonGMT.Chapter03.blowUpMap] using hz
namespace Submission

/-- The orthogonal cylinder `{z + ιv + ι'w : |v| < s, |w| < h}` is open: with `A = ι*` and
`B = ι'*`, it equals `{x : |A(x − z)| < s} ∩ {x : |B(x − z)| < h}`. -/
theorem dgid_orthogonal_cylinder_isOpen : ∀ (n k : ℕ) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (z : Euclid (n + k)) (s h : ℝ), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → (∀ x : Euclid (n + k), ∃ v : Euclid n, ∃ w : Euclid k, x = ι v + ι' w) → IsOpen {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} := by
  intro n k ι ι' z s h horth hdec
  set A := ι.toContinuousLinearMap.adjoint with hAdef
  set B := ι'.toContinuousLinearMap.adjoint with hBdef
  -- `A (ιv + ι'w) = v` and `B (ιv + ι'w) = w`, tested against every vector.
  have hA : ∀ v w, A (ι v + ι' w) = v := by
    intro v w
    apply ext_inner_right ℝ
    intro v'
    rw [hAdef, ContinuousLinearMap.adjoint_inner_left, inner_add_left,
      LinearIsometry.coe_toContinuousLinearMap, LinearIsometry.inner_map_map,
      real_inner_comm (ι v') (ι' w), horth v' w, add_zero]
  have hB : ∀ v w, B (ι v + ι' w) = w := by
    intro v w
    apply ext_inner_right ℝ
    intro w'
    rw [hBdef, ContinuousLinearMap.adjoint_inner_left, inner_add_left,
      LinearIsometry.coe_toContinuousLinearMap, LinearIsometry.inner_map_map, horth v w', zero_add]
  have hset : {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} =
      {x | ‖A (x - z)‖ < s} ∩ {x | ‖B (x - z)‖ < h} := by
    ext x
    constructor
    · rintro ⟨v, hv, w, hw, rfl⟩
      have e : z + ι v + ι' w - z = ι v + ι' w := by abel
      refine ⟨?_, ?_⟩
      · show ‖A (z + ι v + ι' w - z)‖ < s
        rw [e, hA]; exact mem_ball_zero_iff.mp hv
      · show ‖B (z + ι v + ι' w - z)‖ < h
        rw [e, hB]; exact mem_ball_zero_iff.mp hw
    · rintro ⟨hx1, hx2⟩
      obtain ⟨v, w, hvw⟩ := hdec (x - z)
      have hx1' : ‖A (x - z)‖ < s := hx1
      have hx2' : ‖B (x - z)‖ < h := hx2
      rw [hvw, hA] at hx1'
      rw [hvw, hB] at hx2'
      refine ⟨v, mem_ball_zero_iff.mpr hx1', w, mem_ball_zero_iff.mpr hx2', ?_⟩
      rw [add_assoc, ← hvw]; abel
  rw [hset]
  exact (isOpen_lt (by fun_prop) continuous_const).inter (isOpen_lt (by fun_prop) continuous_const)

end Submission

/-- Steps 2 and 9–12(c) of the proof that an integer multiplicity cycle carried by a `C¹` graph is
regular (Simon 7.4.3, via Allard's theorem): if `spt μ_T ∩ C = Σ := Φ(B_s(0))` for the graph map
`Φ(v) = z + ιv + ι'u(v)` and the cylinder `C ⊆ U`, then on `C` the current `T = τ(M, θ, ξ_R)` is
`ω ↦ ∫_Σ g ⟨ω, ξ⟩ dHⁿ` for an integer density `g`, and `g ∘ Φ` is locally integrable.  As
`Hⁿ(M ∖ spt μ_T) = 0`, `M ∩ C ⊆ Σ` up to an `Hⁿ`-null set; there the approximate tangent plane of
`M` is `range DΦ`, so `ξ_R = ±ξ` and `g := 1_M θ ξ_R(β) = ±θ`; `Φ_#(Lⁿ⌞B_s(0)) ≤ Hⁿ⌞Σ` transfers
integrality and local integrability to `g ∘ Φ`. -/
theorem Submission.dgcr_graph_integer_density_on_graph : ∀ (n k : ℕ) (U : Set (Euclid (n + k))) (T : GeometricCurrentOn U n) (R : IMRep U n) (ι : Euclid n →ₗᵢ[ℝ] Euclid (n + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + k)) (u : Euclid n → Euclid k) (z : Euclid (n + k)) (s h : ℝ) (ξ : Euclid (n + k) → MultiVector (n + k) n) (β : Euclid (n + k) → Covector (Euclid (n + k)) n), 0 < n → R.Represents T → (∀ v w, inner ℝ (ι v) (ι' w) = 0) → 0 < s → 0 < h → ContDiffOn ℝ 1 u (ball 0 s) → {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} ⊆ U → R.measure.support ∩ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} = (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s → ContinuousOn β ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s) → (∀ x ∈ (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s, ξ x (β x) = 1) → (∀ v ∈ ball (0 : Euclid n) s, IsUnitOrientationOf (ξ (z + ι v + ι' (u v))) (LinearMap.range (fderiv ℝ (fun v => z + ι v + ι' (u v)) v : Euclid n →ₗ[ℝ] Euclid (n + k)))) → ∃ g : Euclid (n + k) → ℝ, LocallyIntegrableOn (fun v => g (z + ι v + ι' (u v))) (ball (0 : Euclid n) s) volume ∧ (∀ᵐ v ∂(volume.restrict (ball (0 : Euclid n) s)), ∃ m : ℤ, g (z + ι v + ι' (u v)) = m) ∧ ∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid (n + k)) n) ⊆ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} → T ω = ∫ x in (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s, g x * ξ x ((ω : DifferentialForm (Euclid (n + k)) n) x) ∂μHE[n] := by
  intro n k U T R ι ι' u z s h ξ β _hn hRep horth hs _hh hu hCU hsupp hβ hξβ hξ
  -- the cylinder `C` is open (orthogonal coordinates), and `Σ = spt μ_T ∩ C ⊆ C` is Borel
  have hCopen : IsOpen {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h,
      x = z + ι v + ι' w} :=
    dgid_orthogonal_cylinder_isOpen n k ι ι' z s h horth
      (dgcr_orthogonal_coordinates n k ι ι' horth).1
  have hSigC : (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s ⊆
      {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w} := by
    rw [← hsupp]; exact inter_subset_right
  have hSigmeas : MeasurableSet ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s) := by
    rw [← hsupp]; exact R.measure.isClosed_support.measurableSet.inter hCopen.measurableSet
  -- `Hⁿ((M ∩ C) ∖ Σ) = 0`, since `Hⁿ(M ∖ spt μ_T) = 0`
  have hnull : μHE[n] ((R.carrier ∩ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h,
      x = z + ι v + ι' w}) \ ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s)) = 0 := by
    refine measure_mono_null ?_ (dgid_carrier_sdiff_measure_support_null (n + k) n U R)
    rintro x ⟨⟨hxM, hxC⟩, hxSig⟩
    refine ⟨hxM, fun hxs => hxSig ?_⟩
    rw [← hsupp]; exact ⟨hxs, hxC⟩
  -- at `Hⁿ`-a.e. `x = Φ(v) ∈ M ∩ Σ` the approximate tangent plane of `M` is `range DΦ(v)`, which
  -- both `ξ_R(x)` and `ξ(x)` orient, so `ξ_R(x) = ±ξ(x)`
  have horient : ∀ᵐ x ∂(μHE[n].restrict
      (R.carrier ∩ (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s)),
      R.orient x = ξ x ∨ R.orient x = -ξ x := by
    have h1 := ae_restrict_of_ae_restrict_of_subset
      (inter_subset_left : R.carrier ∩ (fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s ⊆
        R.carrier) R.orients
    filter_upwards [h1, ae_restrict_mem (R.measurableSet_carrier.inter hSigmeas)] with x hx hxmem
    obtain ⟨Q, hQtan, hQor⟩ := hx
    obtain ⟨v, hv, rfl⟩ := hxmem.2
    obtain ⟨r, hr, hrC⟩ := Metric.isOpen_iff.mp hCopen _ (hSigC hxmem.2)
    have hnull' : μHE[n] ((R.carrier ∩ ball (z + ι v + ι' (u v)) r) \
        ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s)) = 0 :=
      measure_mono_null (fun y (hy : y ∈ (R.carrier ∩ ball (z + ι v + ι' (u v)) r) \
        ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s)) => (⟨⟨hy.1.1, hrC hy.1.2⟩, hy.2⟩ :
          y ∈ (R.carrier ∩ {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h,
            x = z + ι v + ι' w}) \ ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s))) hnull
    have hQ := dgcr_approxTangent_eq_graph_tangent n k ι ι' u z s r R.carrier v Q horth hu hv hr
      hnull' hQtan
    subst hQ
    exact dgcr_unitOrientation_eq_or_neg (n + k) n _ _ _ (hξ v hv) hQor
  -- the signed density `g = 1_M θ ξ_R(β)` represents `T` on `C` as an integral over `Σ`
  obtain ⟨g, hgm, hgae, hgrep⟩ := dgid_imrep_signed_density_representation (n + k) n U R
    {x | ∃ v ∈ ball (0 : Euclid n) s, ∃ w ∈ ball (0 : Euclid k) h, x = z + ι v + ι' w}
    ((fun v => z + ι v + ι' (u v)) '' ball (0 : Euclid n) s) ξ β hSigmeas hnull
    (hβ.aestronglyMeasurable hSigmeas) hξβ horient
  -- transfer to the disc: `Φ_#(Lⁿ⌞B_s(0)) ≤ Hⁿ⌞Σ`, and `1_M θ` has finite integral over the
  -- compact images `Φ(K) ⊆ C ⊆ U`
  have hΦcont : ContinuousOn (fun v => z + ι v + ι' (u v)) (ball (0 : Euclid n) s) :=
    (continuousOn_const.add ι.continuous.continuousOn).add
      (ι'.continuous.comp_continuousOn hu.continuousOn)
  have hfin : ∀ K : Set (Euclid n), IsCompact K → K ⊆ ball (0 : Euclid n) s →
      ∫⁻ x in (fun v => z + ι v + ι' (u v)) '' K,
        R.carrier.indicator (fun y => (R.mult y : ℝ≥0∞)) x ∂μHE[n] ≠ ∞ := by
    intro K hK hKD
    rw [lintegral_indicator R.measurableSet_carrier, Measure.restrict_restrict R.measurableSet_carrier]
    exact R.locallyIntegrable_mult _ (hK.image_of_continuousOn (hΦcont.mono hKD))
      ((image_mono hKD).trans (hSigC.trans hCU))
  obtain ⟨hloc, hint⟩ := dgid_dominated_pullback_integer_locallyIntegrable n (n + k)
    (fun v => z + ι v + ι' (u v)) (ball (0 : Euclid n) s) g
    (R.carrier.indicator fun y => (R.mult y : ℝ≥0∞)) isOpen_ball hΦcont
    (dgcr_graph_measure_bounds n k ι ι' u z s horth hs hu).1
    ((measurable_from_nat.comp R.measurable_mult).indicator R.measurableSet_carrier) hfin hgm hgae
  refine ⟨g, hloc, hint, fun ω hω => ?_⟩
  rw [hRep ω]
  exact hgrep ω hω
/-- **An `L¹` pairing that vanishes on uniform approximants vanishes in the limit** (step 5 of the
extension from smooth to `C¹` tests in the graph-cycle regularity step of Simon 7.4.3).  Let
`K ⊆ ℝⁿ` be measurable, `G` integrable on `K` and `f` AE-strongly measurable with `|f| ≤ C` on `K`.
If for every `ε > 0` some AE-strongly measurable `g` with `|f − g| ≤ ε` on `K` has `∫_K G g = 0`,
then `∫_K G f = 0`: `|g| ≤ C + ε` on `K`, so both products are integrable on `K`, and
`|∫_K G f| = |∫_K G (f − g)| ≤ ε ∫_K |G|` for every `ε > 0`. -/
theorem Submission.dgcr_stc_setIntegral_mul_eq_zero_of_uniform_approx : ∀ (n : ℕ) (K : Set (Euclid n)) (G f : Euclid n → ℝ) (C : ℝ), MeasurableSet K → IntegrableOn G K volume → AEStronglyMeasurable f (volume.restrict K) → (∀ x ∈ K, |f x| ≤ C) → (∀ ε : ℝ, 0 < ε → ∃ g : Euclid n → ℝ, AEStronglyMeasurable g (volume.restrict K) ∧ (∀ x ∈ K, |f x - g x| ≤ ε) ∧ ∫ x in K, G x * g x = 0) → ∫ x in K, G x * f x = 0 := by
  intro n K G f C hK hG hf hfC happrox
  -- `M = ∫_K |G| ≥ 0`, and `G f` is integrable on `K` since `|f| ≤ C` on `K`.
  have hM : 0 ≤ ∫ x in K, |G x| := integral_nonneg fun x => abs_nonneg (G x)
  have hGf : Integrable (fun x => G x * f x) (volume.restrict K) :=
    Integrable.mul_bdd hG hf (ae_restrict_of_forall_mem hK fun x hx => hfC x hx)
  -- `|∫_K G f| ≤ ε M` for every `ε > 0`.
  have hbound : ∀ ε : ℝ, 0 < ε → |∫ x in K, G x * f x| ≤ ε * ∫ x in K, |G x| := by
    intro ε hε
    obtain ⟨g, hg, hfg, hGg⟩ := happrox ε hε
    -- `|g| ≤ |f| + |f − g| ≤ C + ε` on `K`, so `G g` is integrable on `K`.
    have hGg_int : Integrable (fun x => G x * g x) (volume.restrict K) :=
      Integrable.mul_bdd (c := C + ε) hG hg (ae_restrict_of_forall_mem hK fun x hx => by
        have h1 := abs_le.mp (hfC x hx)
        have h2 := abs_le.mp (hfg x hx)
        rw [Real.norm_eq_abs]
        exact abs_le.mpr ⟨by linarith [h1.1, h2.2], by linarith [h1.2, h2.1]⟩)
    -- `∫_K G f = ∫_K G f − ∫_K G g = ∫_K G (f − g)`.
    have heq : ∫ x in K, G x * f x = ∫ x in K, G x * (f x - g x) := by
      simp_rw [mul_sub]
      rw [integral_sub hGf hGg_int, hGg, sub_zero]
    -- `|G (f − g)| ≤ |G| ε` on `K`.
    rw [heq]
    calc |∫ x in K, G x * (f x - g x)| ≤ ∫ x in K, |G x| * ε :=
          norm_integral_le_of_norm_le ((Integrable.abs hG).mul_const ε)
            (ae_restrict_of_forall_mem hK fun x hx => by
              rw [Real.norm_eq_abs, abs_mul]
              exact mul_le_mul_of_nonneg_left (hfg x hx) (abs_nonneg _))
      _ = ε * ∫ x in K, |G x| := by rw [integral_mul_const, mul_comm]
  -- If `a = |∫_K G f| > 0`, then `ε = a / (2(M + 1))` gives `a ≤ a M / (2(M + 1)) < a`.
  by_contra hne
  set M := ∫ x in K, |G x|
  set a := |∫ x in K, G x * f x|
  have ha : 0 < a := abs_pos.mpr hne
  have hpos : 0 < 2 * (M + 1) := by linarith
  have h := hbound (a / (2 * (M + 1))) (div_pos ha hpos)
  rw [div_mul_eq_mul_div, le_div_iff₀ hpos] at h
  nlinarith
/-- The blow-up integrals `x ↦ ∫_{η_{x,r}(M)} f dHⁿ` of a continuous `f ≥ 0` are Borel
measurable when `Hⁿ⌞M` is s-finite; `M` need not be measurable.  As `η_{x,r}` is a translation
followed by the dilation by `r⁻¹`, `Hⁿ(η_{x,r}(s)) = r⁻ⁿ Hⁿ(s)` for every set `s`, so
`Hⁿ⌞η_{x,r}(M) = r⁻ⁿ (η_{x,r})_#(Hⁿ⌞M)` (on Borel `B`, `η(M) ∩ B = η(M ∩ η⁻¹B)`).  Hence the
integral is `(r⁻ⁿ ∫ f(r⁻¹(y − x)) d(Hⁿ⌞M)(y)).toReal`, measurable in `x` by Tonelli for the
s-finite `Hⁿ⌞M`. -/
theorem Submission.dsmc_measurable_blowUp_image_setIntegral : ∀ (P n : ℕ) (M : Set (Euclid P)), SFinite (μHE[n].restrict M) → ∀ f : Euclid P → ℝ, Continuous f → (∀ y, 0 ≤ f y) → ∀ r : ℝ, 0 < r → Measurable (fun x : Euclid P => ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, f y ∂μHE[n]) := by
  intro P n M hM f hf hf0 r hr
  set η : Euclid P → Euclid P → Euclid P := fun x => Poincare.SimonGMT.Chapter03.blowUpMap x r
    with hη
  -- `(x, y) ↦ η_x(y) = r⁻¹(y − x)` is continuous
  have hηc : Continuous fun p : Euclid P × Euclid P => η p.1 p.2 := by
    simp only [hη, Poincare.SimonGMT.Chapter03.blowUpMap]
    fun_prop
  have hηm : ∀ x, Measurable (η x) := fun x =>
    (hηc.comp (Continuous.prodMk continuous_const continuous_id)).measurable
  -- `Hⁿ(η_x(s)) = r⁻ⁿ Hⁿ(s)` for every set `s`
  have hscale : ∀ x (s : Set (Euclid P)), μHE[n] (η x '' s) = ‖r⁻¹‖₊ ^ n • μHE[n] s := by
    intro x s
    have himg : η x '' s = (fun y => r⁻¹ • y) '' (IsometryEquiv.subRight x '' s) := by
      rw [Set.image_image]
      rfl
    rw [himg, Set.image_smul, Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hr.ne'),
      (IsometryEquiv.subRight x).isometry.euclideanHausdorffMeasure_image]
  -- `Hⁿ⌞η_x(M) = r⁻ⁿ (η_x)_#(Hⁿ⌞M)`, checked on Borel sets
  have hrestr : ∀ x, μHE[n].restrict (η x '' M) =
      ‖r⁻¹‖₊ ^ n • (μHE[n].restrict M).map (η x) := by
    intro x
    ext B hB
    rw [Measure.restrict_apply hB, Measure.smul_apply, Measure.map_apply (hηm x) hB,
      Measure.restrict_apply (hηm x hB), Set.inter_comm, ← Set.image_inter_preimage, hscale,
      Set.inter_comm]
  -- `∫_{η_x(M)} f dHⁿ = (r⁻ⁿ ∫ f ∘ η_x d(Hⁿ⌞M)).toReal`, also when `f` is not integrable
  have hint : ∀ x, ∫ y in η x '' M, f y ∂μHE[n] =
      (‖r⁻¹‖₊ ^ n • ∫⁻ y, ENNReal.ofReal (f (η x y)) ∂(μHE[n].restrict M)).toReal := by
    intro x
    rw [integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall hf0) hf.aestronglyMeasurable,
      hrestr, lintegral_smul_measure, lintegral_map hf.measurable.ennreal_ofReal (hηm x)]
  -- Tonelli for the s-finite measure `Hⁿ⌞M`
  show Measurable fun x => ∫ y in η x '' M, f y ∂μHE[n]
  simp_rw [hint]
  exact ((Measurable.lintegral_prod_right'
    (f := fun p : Euclid P × Euclid P => ENNReal.ofReal (f (η p.1 p.2)))
    (ENNReal.continuous_ofReal.comp (hf.comp hηc)).measurable).const_smul _).ennreal_toReal

/-- **The approximate tangent projections of an integer multiplicity triple are measurable**
(Simon Ch. 3, 1.4; Ch. 4, 2.3).  For `R = (M, θ, ξ)` in an open `U ⊆ ℝᴾ`, `x ↦ p_{TₓM}` is
a.e.-measurable for `μ_R = θHⁿ⌞M`.  As `μ_R ≪ ν = Hⁿ⌞M`, it suffices to treat `ν`, which is
σ-finite.  If `n = 0`, every candidate plane is `{0}`.  If `n ≥ 1`, `TₓM` is an approximate tangent
plane at `ν`-a.e. `x`, so for `f_u(y) = max(1 − |y|², 0)⟨u, y⟩²` the blow-up integrals
`∫_{η_{x,1/(k+1)}(M)} f_u dHⁿ`, which are Borel in `x`, converge `ν`-a.e. to
`∫_{TₓM} f_u dHⁿ = c|p_x u|²`.  Hence each `x ↦ |p_x u|²`, and so `x ↦ p_x`, is
`ν`-a.e.-measurable. -/
theorem Submission.dsmc_approxTangentPlane_starProjection_aemeasurable : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), IsOpen U → AEMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) R.measure := by
  intro P n U R hU
  -- `μ_R = θHⁿ⌞M ≪ Hⁿ⌞M`, so it suffices to work with `ν = Hⁿ⌞M`
  refine AEMeasurable.mono_ac ?_ (withDensity_absolutelyContinuous _ _)
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · -- `n = 0`: every candidate plane is `0`-dimensional, so `p_x = 0` for every `x`
    have h0 : ∀ x, (approxTangentPlane 0 R.carrier x).starProjection = 0 := by
      intro x
      have hK : approxTangentPlane 0 R.carrier x = ⊥ := by
        rw [approxTangentPlane]
        split_ifs with h
        · exact Submodule.finrank_eq_zero.1 h.choose_spec.1
        · rfl
      refine ContinuousLinearMap.ext fun v => ?_
      exact (Submodule.mem_bot ℝ).1
        (hK.le ((approxTangentPlane 0 R.carrier x).starProjection_apply_mem v))
    simp only [h0]
    exact aemeasurable_const
  have : SigmaFinite ((μHE[n] : Measure (Euclid P)).restrict R.carrier) :=
    Submission.dsmc_imrep_carrier_sigmaFinite P n U R hU
  obtain ⟨c, hc, hcQ⟩ := Submission.exists_plane_cutoff_quadratic_moment_eq n hn
  -- `TₓM` is an approximate tangent plane of `M` at `ν`-a.e. `x`
  have hT : ∀ᵐ x ∂(μHE[n].restrict R.carrier),
      HasApproximateTangentSpaceAt n R.carrier x (approxTangentPlane n R.carrier x) := by
    filter_upwards [R.orients] with x hx
    obtain ⟨Q, hQ, -⟩ := hx
    have h : ∃ Q, HasApproximateTangentSpaceAt n R.carrier x Q := ⟨Q, hQ⟩
    rw [approxTangentPlane, dite_eq_left h]
    exact h.choose_spec
  refine Submission.aemeasurable_starProjection_of_aemeasurable_norm_sq P _ _ fun u => ?_
  -- the test function `f_u(y) = max(1 − |y|², 0)⟨u, y⟩² ∈ C_c(ℝᴾ)`
  let f : Euclid P → ℝ := fun y => max (1 - ‖y‖ ^ 2) 0 * inner ℝ u y ^ 2
  have hf : Continuous f := by fun_prop
  have hf0 : ∀ y, 0 ≤ f y := fun y => mul_nonneg (le_max_right _ _) (sq_nonneg _)
  have hfc : HasCompactSupport f := by
    refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid P) 1) fun y hy => ?_
    have h1 : 1 < ‖y‖ := by simpa using hy
    have h2 : 1 - ‖y‖ ^ 2 ≤ 0 := by nlinarith
    simp [f, max_eq_right h2]
  let F : CompactlySupportedContinuousMap (Euclid P) ℝ := ⟨⟨f, hf⟩, hfc⟩
  -- the scales `1/(k+1) ↓ 0`
  have hr : Tendsto (fun k : ℕ => 1 / ((k : ℝ) + 1)) atTop (𝓝[>] 0) :=
    tendsto_nhdsWithin_iff.2 ⟨tendsto_one_div_add_atTop_nhds_zero_nat,
      Eventually.of_forall fun k => mem_Ioi.2 (by positivity)⟩
  -- the blow-up integrals `Φₖ(x) = ∫_{η_{x,1/(k+1)}(M)} f_u dHⁿ` are Borel functions of `x`
  let Φ : ℕ → Euclid P → ℝ := fun k x =>
    ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x (1 / ((k : ℝ) + 1)) '' R.carrier, f y ∂μHE[n]
  have hΦ : ∀ k, Measurable (Φ k) := fun k =>
    Submission.dsmc_measurable_blowUp_image_setIntegral P n R.carrier inferInstance f hf hf0 _
      (by positivity)
  -- at `ν`-a.e. `x` they converge to `∫_{TₓM} f_u dHⁿ = c|p_x u|²`
  have hlim : ∀ᵐ x ∂(μHE[n].restrict R.carrier), Tendsto (fun k => Φ k x) atTop
      (𝓝 (c * ‖(approxTangentPlane n R.carrier x).starProjection u‖ ^ 2)) := by
    filter_upwards [hT] with x hx
    rw [← hcQ P _ hx.1 u]
    exact (hx.2 F).comp hr
  refine ((aemeasurable_of_tendsto_metrizable_ae' (fun k => (hΦ k).aemeasurable) hlim).const_mul
    c⁻¹).congr (Eventually.of_forall fun x => ?_)
  exact inv_mul_cancel_left₀ hc.ne' _
/-- **Integrating factor for the monotonicity identity** (Simon Ch. 4, 3.16–3.17).  If `I` is
continuous on `(0, r]`, has derivative `I'` on `(0, r)` and `n I(s) − s I'(s) ≤ κ s I(s)` there,
then `s ↦ e^{κs} s⁻ⁿ I(s)` is nondecreasing on `(0, r]`.  On `(0, r]` this function equals
`G(s) = exp(κs − n log s) I(s)`, and `G'(s) = exp(κs − n log s) s⁻¹ (κ s I(s) − (n I(s) − s I'(s)))
≥ 0` on `(0, r)`, so the mean value theorem applies. -/
theorem Submission.dsmc_em_exp_monotoneOn_of_deriv_ineq : ∀ (n : ℕ) (κ r : ℝ) (I I' : ℝ → ℝ), ContinuousOn I (Ioc 0 r) → (∀ s ∈ Ioo 0 r, HasDerivAt I (I' s) s) → (∀ s ∈ Ioo 0 r, (n : ℝ) * I s - s * I' s ≤ κ * s * I s) → MonotoneOn (fun s => Real.exp (κ * s) / s ^ n * I s) (Ioc 0 r) := by
  intro n κ r I I' hIc hId hineq
  -- on `(0, r]`, `e^{κs}/sⁿ · I(s) = G(s) := exp(κs − n log s) · I(s)`
  refine MonotoneOn.congr (f₁ := fun s => Real.exp (κ * s - n * Real.log s) * I s) ?_ ?_
  swap
  · intro s hs
    simp only [Real.exp_sub, Real.exp_nat_mul, Real.exp_log hs.1]
  -- `G` is continuous on `(0, r]`
  have hGc : ContinuousOn (fun s => Real.exp (κ * s - n * Real.log s) * I s) (Ioc 0 r) := by
    refine ContinuousOn.mul (Real.continuous_exp.comp_continuousOn ?_) hIc
    exact (continuousOn_const.mul continuousOn_id).sub
      (continuousOn_const.mul (Real.continuousOn_log.mono fun s hs => hs.1.ne'))
  -- `G' = exp(κs − n log s) · ((κ − n/s) I + I') ≥ 0` on `(0, r)`; mean value theorem
  refine monotoneOn_of_hasDerivWithinAt_nonneg (convex_Ioc 0 r) hGc
    (f' := fun s => Real.exp (κ * s - n * Real.log s) * ((κ - n * s⁻¹) * I s + I' s)) ?_ ?_
  · intro s hs
    rw [interior_Ioc] at hs
    have h1 : HasDerivAt (fun s => κ * s - n * Real.log s) (κ * 1 - n * s⁻¹) s :=
      ((hasDerivAt_id' s).const_mul κ).sub ((Real.hasDerivAt_log hs.1.ne').const_mul (n : ℝ))
    exact ((h1.exp.mul (hId s hs)).congr_deriv (by ring)).hasDerivWithinAt
  · intro s hs
    rw [interior_Ioc] at hs
    have key : (κ - n * s⁻¹) * I s + I' s = s⁻¹ * (κ * s * I s - (n * I s - s * I' s)) := by
      linear_combination (-(κ * I s + I' s)) * mul_inv_cancel₀ hs.1.ne'
    rw [key]
    exact mul_nonneg (Real.exp_pos _).le
      (mul_nonneg (inv_nonneg.mpr hs.1.le) (sub_nonneg.mpr (hineq s hs)))
/-- **Differentiation of radial cutoff integrals** (Simon Ch. 4, 3.3–3.4, where
`I(ρ) = ∫ φ(r/ρ) dμ` is differentiated in `ρ`; here the cutoff is written in the squared ratio
`|x - z|²/t²`).  If `μ(B_r(z)) < ∞` and `η` is `C¹` with `η = 0` on `[1, ∞)`, then
`I(t) = ∫ η(|x - z|²/t²) dμ` is continuous on `(0, r]` and, for `0 < s < r`,
`I'(s) = -(∫ 2 (|x - z|²/s²) η'(|x - z|²/s²) dμ)/s` (dominated convergence and differentiation
under the integral sign). -/
theorem Submission.dsmc_em_cutoff_integral_hasDerivAt : ∀ (P : ℕ) (μ : Measure (Euclid P)) (z : Euclid P) (r : ℝ) (η : ℝ → ℝ), μ (ball z r) < ∞ → ContDiff ℝ 1 η → (∀ u, 1 ≤ u → η u = 0) → ContinuousOn (fun t => ∫ x, η (‖x - z‖ ^ 2 / t ^ 2) ∂μ) (Ioc 0 r) ∧ ∀ s ∈ Ioo 0 r, HasDerivAt (fun t => ∫ x, η (‖x - z‖ ^ 2 / t ^ 2) ∂μ) (-(∫ x, 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ∂μ) / s) s := by
  intro P μ z r η hμ hη hη1
  have hηc : Continuous η := hη.continuous
  have hη'c : Continuous (deriv η) := hη.continuous_deriv le_rfl
  -- `η' = deriv η` vanishes on `(1, ∞)` (where `η` is locally zero), hence on `[1, ∞)`.
  have hη'1 : ∀ u, 1 ≤ u → deriv η u = 0 := by
    have hIoi : Ioi (1 : ℝ) ⊆ {u | deriv η u = 0} := fun u hu => by
      have hloc : η =ᶠ[𝓝 u] fun _ => (0 : ℝ) := by
        filter_upwards [Ioi_mem_nhds hu] with v hv
        exact hη1 v (le_of_lt hv)
      show deriv η u = 0
      rw [hloc.deriv_eq, deriv_const]
    have hIci : Ici (1 : ℝ) ⊆ {u | deriv η u = 0} := by
      rw [← closure_Ioi]
      exact closure_minimal hIoi (isClosed_eq hη'c continuous_const)
    exact fun u hu => hIci hu
  -- Bounds on `[0, 1]` for `η` and for `u ↦ 2 u η'(u)`.
  obtain ⟨C, hC⟩ := isCompact_Icc.exists_bound_of_continuousOn (s := Icc (0 : ℝ) 1)
    hηc.continuousOn
  obtain ⟨K, hK⟩ := isCompact_Icc.exists_bound_of_continuousOn (s := Icc (0 : ℝ) 1)
    (f := fun u : ℝ => 2 * u * deriv η u) (by fun_prop)
  have hg1 : ∀ u, 1 ≤ u → 2 * u * deriv η u = 0 := fun u hu => by
    rw [hη'1 u hu, mul_zero]
  -- For `0 < t ≤ r`, `g(|x - z|²/t²)` vanishes off `B_t(z) ⊆ B_r(z)` and is dominated there.
  have hdom : ∀ (g : ℝ → ℝ) (B : ℝ), (∀ u, 1 ≤ u → g u = 0) → (∀ u ∈ Icc (0 : ℝ) 1, ‖g u‖ ≤ B) →
      ∀ t, 0 < t → t ≤ r → ∀ x : Euclid P,
        ‖g (‖x - z‖ ^ 2 / t ^ 2)‖ ≤ (ball z r).indicator (fun _ => B) x := by
    intro g B hg0 hgB t ht htr x
    have hB : 0 ≤ B := (norm_nonneg _).trans (hgB 0 ⟨le_rfl, zero_le_one⟩)
    by_cases hx : ‖x - z‖ < t
    · have hxr : x ∈ ball z r := by
        rw [mem_ball, dist_eq_norm]
        exact hx.trans_le htr
      rw [indicator_of_mem hxr]
      apply hgB
      refine ⟨by positivity, ?_⟩
      rw [div_le_one (by positivity)]
      exact pow_le_pow_left₀ (norm_nonneg _) hx.le 2
    · rw [not_lt] at hx
      rw [hg0 _ ?_, norm_zero]
      · exact indicator_nonneg (fun _ _ => hB) x
      · rw [le_div_iff₀ (by positivity), one_mul]
        exact pow_le_pow_left₀ ht.le hx 2
  have hint : ∀ c : ℝ, Integrable ((ball z r).indicator (fun _ => c)) μ := fun c =>
    (integrable_indicator_iff measurableSet_ball).2 (integrableOn_const hμ.ne)
  have hcont : ∀ t : ℝ, Continuous fun x : Euclid P => η (‖x - z‖ ^ 2 / t ^ 2) := fun t => by
    fun_prop
  -- Pointwise derivative in `t ≠ 0`.
  have hderiv : ∀ x : Euclid P, ∀ t : ℝ, t ≠ 0 →
      HasDerivAt (fun t => η (‖x - z‖ ^ 2 / t ^ 2))
        (-(2 * (‖x - z‖ ^ 2 / t ^ 2) * deriv η (‖x - z‖ ^ 2 / t ^ 2)) / t) t := by
    intro x t ht
    have h1 := (hasDerivAt_const t (‖x - z‖ ^ 2)).div (hasDerivAt_pow 2 t) (pow_ne_zero 2 ht)
    have h2 := (hη.differentiable one_ne_zero (‖x - z‖ ^ 2 / t ^ 2)).hasDerivAt.comp t h1
    refine h2.congr_deriv ?_
    field_simp
    ring
  refine ⟨?_, fun s hs => ?_⟩
  · -- (i) continuity on `(0, r]` by dominated convergence
    refine continuousOn_of_dominated (F := fun t x => η (‖x - z‖ ^ 2 / t ^ 2))
      (bound := (ball z r).indicator (fun _ => C)) (fun t _ => (hcont t).aestronglyMeasurable)
      (fun t ht => Eventually.of_forall (hdom η C hη1 hC t ht.1 ht.2)) (hint C)
      (Eventually.of_forall fun x t ht => (hderiv x t ht.1.ne').continuousAt.continuousWithinAt)
  · -- (ii) differentiation under the integral sign on `(s/2, r)`
    have hs0 : 0 < s := hs.1
    have hb : ∀ x : Euclid P, ∀ t ∈ Ioo (s / 2) r,
        ‖-(2 * (‖x - z‖ ^ 2 / t ^ 2) * deriv η (‖x - z‖ ^ 2 / t ^ 2)) / t‖ ≤
          (ball z r).indicator (fun _ => K) x / (s / 2) := by
      intro x t ht
      have ht0 : 0 < t := by linarith [ht.1]
      have h1 : ‖2 * (‖x - z‖ ^ 2 / t ^ 2) * deriv η (‖x - z‖ ^ 2 / t ^ 2)‖ ≤
          (ball z r).indicator (fun _ => K) x :=
        hdom (fun u => 2 * u * deriv η u) K hg1 hK t ht0 ht.2.le x
      have h2 : 0 ≤ (ball z r).indicator (fun _ => K) x := (norm_nonneg _).trans h1
      rw [norm_div, norm_neg, Real.norm_of_nonneg ht0.le]
      calc ‖2 * (‖x - z‖ ^ 2 / t ^ 2) * deriv η (‖x - z‖ ^ 2 / t ^ 2)‖ / t
          ≤ (ball z r).indicator (fun _ => K) x / t := by gcongr
        _ ≤ (ball z r).indicator (fun _ => K) x / (s / 2) := by
          gcongr
          exact ht.1.le
    have key := hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := μ) (x₀ := s)
      (F := fun t x => η (‖x - z‖ ^ 2 / t ^ 2))
      (F' := fun t x => -(2 * (‖x - z‖ ^ 2 / t ^ 2) * deriv η (‖x - z‖ ^ 2 / t ^ 2)) / t)
      (bound := fun x => (ball z r).indicator (fun _ => K) x / (s / 2))
      (Ioo_mem_nhds (by linarith) hs.2)
      (Eventually.of_forall fun t => (hcont t).aestronglyMeasurable)
      ((hint C).mono' (hcont s).aestronglyMeasurable
        (Eventually.of_forall (hdom η C hη1 hC s hs0 hs.2.le)))
      (by fun_prop : Continuous fun x : Euclid P =>
        -(2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)) / s).aestronglyMeasurable
      (Eventually.of_forall hb) ((hint K).div_const (s / 2))
      (Eventually.of_forall fun x t ht => hderiv x t (by linarith [ht.1] : 0 < t).ne')
    have hval : ∫ x, -(2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)) / s ∂μ =
        -(∫ x, 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ∂μ) / s := by
      rw [integral_div, integral_neg]
    rw [← hval]
    exact key.2
/-- **Radial first-variation inequality** (Simon Ch. 4, 3.2–3.3 with the bounded generalized mean
curvature of 3.14–3.16).  Test the first variation of `v(M, θ)` with the radial field
`X(x) = η(u(x)) (x - z)`, `u(x) = ‖x - z‖² / s²`, where `η ≥ 0` is `C¹`, nonincreasing and vanishes
on `[1, ∞)`.  Then `μ`-a.e. `n η(u) + 2 u η'(u) ≤ div_M X ≤ n η(u)`, and
`|X · H| ≤ κ s η(u)`, so `n ∫ η(u) dμ + ∫ 2 u η'(u) dμ ≤ ∫ div_M X dμ = -∫ X · H dμ ≤ κ s ∫ η(u) dμ`. -/
theorem Submission.dsmc_em_cutoff_first_variation_le : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (H : Euclid P → Euclid P) (κ : ℝ) (z : Euclid P) (r : ℝ) (η : ℝ → ℝ), closedBall z r ⊆ U → AEMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) R.measure → (∀ x, ‖H x‖ ≤ κ) → (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ ball z r → R.firstVariation X = -∫ x, inner ℝ (X x) (H x) ∂R.measure) → ContDiff ℝ 1 η → (∀ u, 0 ≤ η u) → (∀ u, deriv η u ≤ 0) → (∀ u, 1 ≤ u → η u = 0) → ∀ s : ℝ, 0 < s → s < r → (n : ℝ) * ∫ x, η (‖x - z‖ ^ 2 / s ^ 2) ∂R.measure + ∫ x, 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ∂R.measure ≤ κ * s * ∫ x, η (‖x - z‖ ^ 2 / s ^ 2) ∂R.measure := by
  intro P n U R H κ z r η hzU hPm hHκ hfv hη hη0 hη'0 hη1 s hs hsr
  classical
  set μ : Measure (Euclid P) := R.measure with hμ
  /- Step 0.  `κ ≥ 0`; `μ(B̄_s(z)) < ∞`; `η' = deriv η` is continuous and vanishes on `(1, ∞)`;
  `η` and `η'` are bounded on `[0, 1]`. -/
  have hκ0 : 0 ≤ κ := (norm_nonneg _).trans (hHκ 0)
  have hBc : IsCompact (closedBall z s) := isCompact_closedBall z s
  have hBm : MeasurableSet (closedBall z s) := measurableSet_closedBall
  have hBU : closedBall z s ⊆ U := (closedBall_subset_closedBall hsr.le).trans hzU
  have hBr : closedBall z s ⊆ ball z r := closedBall_subset_ball hsr
  have hμB : μ (closedBall z s) < ∞ := by
    rw [hμ, IMRep.measure, withDensity_apply _ hBm, Measure.restrict_restrict hBm, inter_comm]
    exact lt_top_iff_ne_top.mpr (R.locallyIntegrable_mult _ hBc hBU)
  have hind : ∀ c : ℝ, Integrable ((closedBall z s).indicator fun _ => c) μ := fun c =>
    (integrable_indicator_iff hBm).mpr (integrableOn_const hμB.ne)
  have hηd : ∀ u, HasDerivAt η (deriv η u) u := fun u =>
    ((hη.differentiable (by norm_num)) u).hasDerivAt
  have hηc : Continuous η := hη.continuous
  have hη'c : Continuous (deriv η) := hη.continuous_deriv le_rfl
  have hη'1 : ∀ u, 1 < u → deriv η u = 0 := by
    intro u hu
    have : η =ᶠ[𝓝 u] fun _ => 0 := by
      filter_upwards [Ioi_mem_nhds hu] with v hv
      exact hη1 v hv.le
    rw [this.deriv_eq]
    simp
  obtain ⟨C, hC⟩ : ∃ C, ∀ u ∈ Icc (0 : ℝ) 1, ‖η u‖ ≤ C :=
    isCompact_Icc.exists_bound_of_continuousOn hηc.continuousOn
  obtain ⟨M, hM⟩ : ∃ M, ∀ u ∈ Icc (0 : ℝ) 1, ‖deriv η u‖ ≤ M :=
    isCompact_Icc.exists_bound_of_continuousOn hη'c.continuousOn
  -- the radius ratio `u(x) = ‖x - z‖² / s²`
  have hucont : Continuous fun x : Euclid P => ‖x - z‖ ^ 2 / s ^ 2 := by fun_prop
  have hu0 : ∀ x : Euclid P, 0 ≤ ‖x - z‖ ^ 2 / s ^ 2 := fun x => by positivity
  have hu_le : ∀ x ∈ closedBall z s, ‖x - z‖ ^ 2 / s ^ 2 ≤ 1 := by
    intro x hx
    rw [mem_closedBall, dist_eq_norm] at hx
    rw [div_le_one (pow_pos hs 2)]
    exact pow_le_pow_left₀ (norm_nonneg _) hx 2
  have hu_gt : ∀ x, x ∉ closedBall z s → 1 < ‖x - z‖ ^ 2 / s ^ 2 := by
    intro x hx
    rw [mem_closedBall, dist_eq_norm, not_le] at hx
    rw [one_lt_div (pow_pos hs 2)]
    exact pow_lt_pow_left₀ hx hs.le two_ne_zero
  -- the two integrands vanish off `B̄_s(z)` and are bounded on it
  have hFint : Integrable (fun x => η (‖x - z‖ ^ 2 / s ^ 2)) μ := by
    refine Integrable.mono' (hind C) (hηc.comp hucont).aestronglyMeasurable
      (ae_of_all _ fun x => ?_)
    by_cases hx : x ∈ closedBall z s
    · rw [indicator_of_mem hx]
      exact hC _ ⟨hu0 x, hu_le x hx⟩
    · rw [indicator_of_notMem hx, hη1 _ (hu_gt x hx).le, norm_zero]
  have hGint : Integrable
      (fun x => 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)) μ := by
    refine Integrable.mono' (hind (2 * M))
      ((continuous_const.mul hucont).mul (hη'c.comp hucont)).aestronglyMeasurable
      (ae_of_all _ fun x => ?_)
    by_cases hx : x ∈ closedBall z s
    · have h1 := hu_le x hx
      have h2 := hM _ ⟨hu0 x, h1⟩
      rw [Real.norm_eq_abs] at h2
      rw [indicator_of_mem hx, Real.norm_eq_abs, abs_mul, abs_mul, abs_two,
        abs_of_nonneg (hu0 x)]
      calc 2 * (‖x - z‖ ^ 2 / s ^ 2) * |deriv η (‖x - z‖ ^ 2 / s ^ 2)| ≤ 2 * 1 * M :=
            mul_le_mul (mul_le_mul_of_nonneg_left h1 zero_le_two) h2 (abs_nonneg _)
              (by norm_num)
        _ = 2 * M := by ring
    · rw [indicator_of_notMem hx, hη'1 _ (hu_gt x hx), mul_zero, norm_zero]
  /- Step 1.  The radial field `X(x) = η(u(x)) (x - z)` is `C¹`, with
  `DX(x) v = η(u) v + η'(u) (2/s²) ⟪x - z, v⟫ (x - z)` and `tsupport X ⊆ B̄_s(z) ⊆ B_r(z)`. -/
  let X : Euclid P → Euclid P := fun x => η (‖x - z‖ ^ 2 / s ^ 2) • (x - z)
  have hXd : ∀ x, HasFDerivAt X
      (η (‖x - z‖ ^ 2 / s ^ 2) • ContinuousLinearMap.id ℝ (Euclid P) +
        ((deriv η (‖x - z‖ ^ 2 / s ^ 2) * (2 / s ^ 2)) • innerSL ℝ (x - z)).smulRight
          (x - z)) x := by
    intro x
    have h1 : HasFDerivAt (fun x : Euclid P => x - z) (ContinuousLinearMap.id ℝ _) x :=
      (hasFDerivAt_id x).sub_const z
    have h3 : HasFDerivAt (fun x : Euclid P => ‖x - z‖ ^ 2 / s ^ 2)
        ((s ^ 2)⁻¹ • (2 • (innerSL ℝ (x - z)).comp (ContinuousLinearMap.id ℝ (Euclid P)))) x := by
      simpa only [div_eq_mul_inv] using HasFDerivAt.mul_const h1.norm_sq (s ^ 2)⁻¹
    have h5 := ((hηd (‖x - z‖ ^ 2 / s ^ 2)).comp_hasFDerivAt x h3).smul h1
    refine HasFDerivAt.congr_fderiv (f := X) h5 (ContinuousLinearMap.ext fun v => ?_)
    simp only [add_apply, FunLike.coe_smul, Pi.smul_apply,
      ContinuousLinearMap.id_apply, ContinuousLinearMap.smulRight_apply, innerSL_apply_apply,
      ContinuousLinearMap.comp_apply, Function.comp_apply, smul_eq_mul]
    congr 2
    rw [nsmul_eq_mul]
    push_cast
    ring
  have hXcd : ContDiff ℝ 1 X := by
    have h1 : ContDiff ℝ 1 (fun x : Euclid P => ‖x - z‖ ^ 2 / s ^ 2) :=
      ((contDiff_norm_sq ℝ).comp (contDiff_id.sub contDiff_const)).div_const _
    exact (hη.comp h1).smul (contDiff_id.sub contDiff_const)
  have hXzero : ∀ x, x ∉ closedBall z s → X x = 0 := by
    intro x hx
    show η (‖x - z‖ ^ 2 / s ^ 2) • (x - z) = 0
    rw [hη1 _ (hu_gt x hx).le, zero_smul]
  have hXts : tsupport X ⊆ closedBall z s := by
    refine closure_minimal (fun x hx => ?_) isClosed_closedBall
    by_contra h
    exact hx (hXzero x h)
  have hXcs : HasCompactSupport X := HasCompactSupport.intro hBc hXzero
  /- Step 2.  `μ`-a.e. the tangent projection is `∑ᵢ τᵢ ⟪τᵢ, ·⟫` for an orthonormal family `τ`
  of size `n` (`R.orients` and uniqueness of approximate tangent spaces). -/
  have hproj : ∀ τ : Fin n → Euclid P, Orthonormal ℝ τ →
      (Submodule.span ℝ (range τ)).starProjection =
        ∑ i, InnerProductSpace.rankOne ℝ (τ i) (τ i) := by
    intro τ hτ
    let b0 := Module.Basis.span hτ.linearIndependent
    have hb0 : ∀ i, (b0 i : Euclid P) = τ i := fun i =>
      congrArg Subtype.val (Module.Basis.span_apply hτ.linearIndependent i)
    have hb0o : Orthonormal ℝ b0 := by
      have e : (Submodule.span ℝ (range τ)).subtypeₗᵢ ∘ b0 = τ := funext hb0
      rw [← (Submodule.span ℝ (range τ)).subtypeₗᵢ.orthonormal_comp_iff, e]
      exact hτ
    rw [OrthonormalBasis.starProjection_eq_sum_rankOne (b0.toOrthonormalBasis hb0o),
      Module.Basis.coe_toOrthonormalBasis]
    simp only [hb0]
  have hμac : μ ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
  have hPae : ∀ᵐ x ∂μ, ∃ τ : Fin n → Euclid P, Orthonormal ℝ τ ∧
      (approxTangentPlane n R.carrier x).starProjection =
        ∑ i, InnerProductSpace.rankOne ℝ (τ i) (τ i) := by
    refine hμac.ae_le ?_
    filter_upwards [R.orients] with x ⟨Q, hQ, τ, hτ, hspan, _⟩
    have hex : ∃ Q', HasApproximateTangentSpaceAt n R.carrier x Q' := ⟨Q, hQ⟩
    have happrox : approxTangentPlane n R.carrier x = Q := by
      rw [approxTangentPlane, dite_eq_left hex]
      exact hex.choose_spec.unique hQ
    exact ⟨τ, hτ, by rw [happrox, ← hspan, hproj τ hτ]⟩
  /- Step 3.  `div_M X = n η(u) + η'(u) (2/s²) ∑ᵢ ⟪τᵢ, x - z⟫²`, and by Bessel's inequality and
  `η' ≤ 0`, `n η(u) + 2 u η'(u) ≤ div_M X ≤ n η(u)` `μ`-a.e. -/
  let d : Euclid P → ℝ := fun x => tangentialDivergence n R.carrier X x
  -- `trace ((∑ τᵢ ⊗ τᵢ) ∘ L) = ∑ ⟪τᵢ, L τᵢ⟫`
  have htr : ∀ (τ : Fin n → Euclid P) (L : Euclid P →L[ℝ] Euclid P),
      LinearMap.trace ℝ (Euclid P) ((∑ i, InnerProductSpace.rankOne ℝ (τ i) (τ i) :
        Euclid P →L[ℝ] Euclid P).toLinearMap ∘ₗ L.toLinearMap) =
        ∑ i, inner ℝ (τ i) (L (τ i)) := by
    intro τ L
    rw [← ContinuousLinearMap.toLinearMap_comp, ContinuousLinearMap.finsetSum_comp,
      ContinuousLinearMap.toLinearMap_sum, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [ContinuousLinearMap.toLinearMap_comp, LinearMap.trace_comp_comm',
      ← ContinuousLinearMap.toLinearMap_comp, InnerProductSpace.comp_rankOne,
      InnerProductSpace.trace_rankOne]
  -- Bessel's inequality
  have hbessel : ∀ (τ : Fin n → Euclid P), Orthonormal ℝ τ → ∀ v : Euclid P,
      ∑ i, inner ℝ (τ i) v ^ 2 ≤ ‖v‖ ^ 2 := by
    intro τ hτ v
    have := hτ.sum_inner_products_le (s := Finset.univ) (x := v)
    simpa [Real.norm_eq_abs, sq_abs] using this
  have hdae : ∀ᵐ x ∂μ,
      n * η (‖x - z‖ ^ 2 / s ^ 2) + 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ≤
        d x ∧ d x ≤ n * η (‖x - z‖ ^ 2 / s ^ 2) := by
    filter_upwards [hPae] with x ⟨τ, hτ, hPx⟩
    have h1 : ∀ i, inner ℝ (τ i) (τ i) = (1 : ℝ) := fun i => by
      rw [real_inner_self_eq_norm_sq, hτ.1 i, one_pow]
    have e : d x = n * η (‖x - z‖ ^ 2 / s ^ 2) + deriv η (‖x - z‖ ^ 2 / s ^ 2) * (2 / s ^ 2) *
        ∑ i, inner ℝ (τ i) (x - z) ^ 2 := by
      show tangentialDivergence n R.carrier X x = _
      unfold tangentialDivergence
      rw [hPx, (hXd x).fderiv, htr]
      simp only [add_apply, FunLike.coe_smul, Pi.smul_apply, ContinuousLinearMap.id_apply,
        ContinuousLinearMap.smulRight_apply, innerSL_apply_apply, smul_eq_mul, inner_add_right,
        inner_smul_right, h1, Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ,
        Fintype.card_fin, nsmul_eq_mul, mul_one, Finset.mul_sum]
      congr 1
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [real_inner_comm (x - z) (τ i)]
      ring
    have hb := hbessel τ hτ (x - z)
    have hS0 : 0 ≤ ∑ i, inner ℝ (τ i) (x - z) ^ 2 := Finset.sum_nonneg fun i _ => sq_nonneg _
    have hk : deriv η (‖x - z‖ ^ 2 / s ^ 2) * (2 / s ^ 2) ≤ 0 :=
      mul_nonpos_of_nonpos_of_nonneg (hη'0 _) (div_nonneg zero_le_two (sq_nonneg s))
    have h2 := mul_le_mul_of_nonpos_left hb hk
    have h3 := mul_nonpos_of_nonpos_of_nonneg hk hS0
    have e2 : deriv η (‖x - z‖ ^ 2 / s ^ 2) * (2 / s ^ 2) * ‖x - z‖ ^ 2 =
        2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) := by ring
    rw [e]
    exact ⟨e2 ▸ add_le_add le_rfl h2, add_le_of_nonpos_right h3⟩
  /- Step 4.  `div_M X` is `μ`-integrable: it is `AEStronglyMeasurable` (the tangent projection
  is `μ`-measurable, `DX` is continuous, `(A, B) ↦ trace (A ∘ B)` is continuous) and
  `|div_M X| ≤ n η(u) + |2 u η'(u)|` `μ`-a.e. -/
  have hTc : Continuous fun p : (Euclid P →L[ℝ] Euclid P) × (Euclid P →L[ℝ] Euclid P) =>
      LinearMap.trace ℝ (Euclid P) (p.1.toLinearMap ∘ₗ p.2.toLinearMap) := by
    have h1 : Continuous fun A : Euclid P →L[ℝ] Euclid P =>
        LinearMap.trace ℝ (Euclid P) A.toLinearMap :=
      ((LinearMap.trace ℝ (Euclid P)).comp
        (ContinuousLinearMap.coeLM ℝ)).continuous_of_finiteDimensional
    exact h1.comp (continuous_fst.clm_comp continuous_snd)
  have hPmeas : AEStronglyMeasurable
      (fun x => (approxTangentPlane n R.carrier x).starProjection) μ := hPm.aestronglyMeasurable
  have hdmeas : AEStronglyMeasurable d μ := by
    have h3 := hTc.comp_aestronglyMeasurable
      (hPmeas.prodMk (hXcd.continuous_fderiv one_ne_zero).aestronglyMeasurable)
    show AEStronglyMeasurable (fun x => tangentialDivergence n R.carrier X x) μ
    unfold tangentialDivergence
    exact h3
  have hdint : Integrable d μ := by
    refine Integrable.mono' ((hFint.const_mul n).add hGint.abs) hdmeas ?_
    filter_upwards [hdae] with x hx
    have h0 : 0 ≤ (n : ℝ) * η (‖x - z‖ ^ 2 / s ^ 2) := mul_nonneg (Nat.cast_nonneg n) (hη0 _)
    have hG1 := neg_abs_le (2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2))
    have hG2 := abs_nonneg (2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2))
    show ‖d x‖ ≤ n * η (‖x - z‖ ^ 2 / s ^ 2) +
      |2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)|
    rw [Real.norm_eq_abs, abs_le]
    exact ⟨by linarith [hx.1], by linarith [hx.2]⟩
  /- Step 5.  `∫ f dμ = ∫_M θ f dHⁿ`, so `∫ div_M X dμ = R.firstVariation X`. -/
  have hμint : ∀ f : Euclid P → ℝ,
      ∫ x, f x ∂μ = ∫ x in R.carrier, (R.mult x : ℝ) * f x ∂μHE[n] := by
    intro f
    have hθ : (fun x => (R.mult x : ℝ≥0∞)) = fun x => ((R.mult x : NNReal) : ℝ≥0∞) := by
      funext x
      simp
    have hθm : Measurable fun x => (R.mult x : NNReal) :=
      measurable_from_top.comp R.measurable_mult
    rw [hμ, IMRep.measure, hθ, integral_withDensity_eq_integral_smul hθm]
    refine integral_congr_ae (ae_of_all _ fun x => ?_)
    simp [NNReal.smul_def]
  /- Step 6.  Integrate: `n ∫ η(u) + ∫ 2 u η'(u) ≤ ∫ div_M X = -∫ X · H ≤ κ s ∫ η(u)`, using
  `|X · H| ≤ ‖X‖ κ ≤ κ s η(u)` (`X = 0` off `B̄_s(z)`). -/
  have e1 : (n : ℝ) * ∫ x, η (‖x - z‖ ^ 2 / s ^ 2) ∂μ +
      ∫ x, 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ∂μ =
      ∫ x, ((n : ℝ) * η (‖x - z‖ ^ 2 / s ^ 2) +
        2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)) ∂μ := by
    rw [integral_add (hFint.const_mul _) hGint, integral_const_mul]
  have e3 : ∫ x, ((n : ℝ) * η (‖x - z‖ ^ 2 / s ^ 2) +
        2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)) ∂μ ≤ ∫ x, d x ∂μ := by
    refine integral_mono_ae ((hFint.const_mul _).add hGint) hdint ?_
    filter_upwards [hdae] with x hx
    exact hx.1
  have e4 : ∫ x, d x ∂μ = -∫ x, inner ℝ (X x) (H x) ∂μ := by
    rw [hμint]
    exact hfv X hXcd hXcs (hXts.trans hBr)
  have e5 : -∫ x, inner ℝ (X x) (H x) ∂μ ≤ κ * s * ∫ x, η (‖x - z‖ ^ 2 / s ^ 2) ∂μ := by
    have h1 : -∫ x, inner ℝ (X x) (H x) ∂μ ≤ ∫ x, ‖inner ℝ (X x) (H x)‖ ∂μ := by
      refine (neg_le_abs _).trans ?_
      rw [← Real.norm_eq_abs]
      exact norm_integral_le_integral_norm _
    have h2 : ∫ x, ‖inner ℝ (X x) (H x)‖ ∂μ ≤ ∫ x, κ * s * η (‖x - z‖ ^ 2 / s ^ 2) ∂μ := by
      refine integral_mono_of_nonneg (ae_of_all _ fun x => norm_nonneg _) (hFint.const_mul _)
        (ae_of_all _ fun x => ?_)
      show ‖inner ℝ (X x) (H x)‖ ≤ κ * s * η (‖x - z‖ ^ 2 / s ^ 2)
      by_cases hx : x ∈ closedBall z s
      · have hXn : ‖X x‖ ≤ η (‖x - z‖ ^ 2 / s ^ 2) * s := by
          show ‖η (‖x - z‖ ^ 2 / s ^ 2) • (x - z)‖ ≤ η (‖x - z‖ ^ 2 / s ^ 2) * s
          rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (hη0 _)]
          exact mul_le_mul_of_nonneg_left (by rwa [mem_closedBall, dist_eq_norm] at hx) (hη0 _)
        calc ‖inner ℝ (X x) (H x)‖ ≤ ‖X x‖ * ‖H x‖ := norm_inner_le_norm _ _
          _ ≤ (η (‖x - z‖ ^ 2 / s ^ 2) * s) * κ :=
            mul_le_mul hXn (hHκ x) (norm_nonneg _) (mul_nonneg (hη0 _) hs.le)
          _ = κ * s * η (‖x - z‖ ^ 2 / s ^ 2) := by ring
      · rw [hXzero x hx, inner_zero_left, norm_zero]
        exact mul_nonneg (mul_nonneg hκ0 hs.le) (hη0 _)
    rw [integral_const_mul] at h2
    exact h1.trans h2
  calc (n : ℝ) * ∫ x, η (‖x - z‖ ^ 2 / s ^ 2) ∂μ +
        ∫ x, 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ∂μ = _ := e1
    _ ≤ _ := e3
    _ = _ := e4
    _ ≤ _ := e5
/-- Helly selection with no concentration on left intervals (the compactness ingredient of the
choice of the slicing level in the proof of Simon 6.7.2, "an argument as in 6.7(2) of Ch. 2"): if
`μⱼ([a, b]) ≤ Λ < ∞`, then along a subsequence `φ` and off a countable set `N`, every
`s ∈ (a, b) \ N` and `ε > 0` admit `δ > 0` with `μ_{φ j}([s - δ, s]) ≤ ε` for all large `j`.
By Tychonoff, `μ_{φ j}([a, d]) → G(d)` for every rational `d ∈ (a, b)`; `N` is the discontinuity
set of the nondecreasing `G̃(t) = sup ({0} ∪ {G(d) : d < t})`, and `[s - δ, s] ⊆ [a, d₂] \ [a, d₁]`
for rationals `d₁ < s - δ`, `s < d₂` with `G(d₂) - G(d₁) < ε`. -/
theorem Submission.cmc_fc_gs_helly_no_concentration : ∀ (μ : ℕ → Measure ℝ) (a b : ℝ) (Λ : ℝ≥0∞), Λ ≠ ∞ → (∀ j, μ j (Icc a b) ≤ Λ) → ∃ (φ : ℕ → ℕ) (N : Set ℝ), StrictMono φ ∧ N.Countable ∧ ∀ s ∈ Ioo a b, s ∉ N → ∀ ε : ℝ≥0∞, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ᶠ j in atTop, μ (φ j) (Icc (s - δ) s) ≤ ε := by
  intro μ a b Λ hΛ hμ
  -- `μⱼ([a, x]) ≤ μⱼ([a, b]) ≤ Λ < ∞` for `x ≤ b`
  have hle : ∀ j x, x ≤ b → μ j (Icc a x) ≤ Λ := fun j x hx =>
    (measure_mono (Icc_subset_Icc_right hx)).trans (hμ j)
  have hfin : ∀ j x, x ≤ b → μ j (Icc a x) ≠ ∞ := fun j x hx =>
    ((hle j x hx).trans_lt hΛ.lt_top).ne
  -- Helly selection: `d ↦ μⱼ([a, d])` lies in the compact box `∏_{d ∈ ℚ ∩ (a, b)} [0, Λ]` of
  -- the first countable space `ℝ^(ℚ ∩ (a, b))`
  have hK : IsCompact (univ.pi fun _ : {q : ℚ // (q : ℝ) ∈ Ioo a b} => Icc (0 : ℝ) Λ.toReal) :=
    isCompact_univ_pi fun _ => isCompact_Icc
  obtain ⟨G, hGK, φ, hφ, hlim⟩ := hK.tendsto_subseq
    (x := fun j d => (μ j (Icc a (d.1 : ℝ))).toReal)
    fun j d _ => ⟨ENNReal.toReal_nonneg, ENNReal.toReal_mono hΛ (hle j _ d.2.2.le)⟩
  have hGd : ∀ d : {q : ℚ // (q : ℝ) ∈ Ioo a b},
      Tendsto (fun j => (μ (φ j) (Icc a (d.1 : ℝ))).toReal) atTop (𝓝 (G d)) :=
    tendsto_pi_nhds.1 hlim
  -- `G` is nondecreasing
  have hGmono : ∀ d d' : {q : ℚ // (q : ℝ) ∈ Ioo a b}, (d.1 : ℝ) ≤ d'.1 → G d ≤ G d' :=
    fun d d' h => le_of_tendsto_of_tendsto' (hGd d) (hGd d') fun j =>
      ENNReal.toReal_mono (hfin _ _ d'.2.2.le) (measure_mono (Icc_subset_Icc_right h))
  -- `G̃(t) = sup ({0} ∪ {G(d) : d < t})`
  obtain ⟨Gt, hGt⟩ : ∃ Gt : ℝ → ℝ, ∀ t, Gt t = sSup (insert 0 (G '' {d | (d.1 : ℝ) < t})) :=
    ⟨_, fun _ => rfl⟩
  have hbdd : ∀ t, BddAbove (insert 0 (G '' {d | (d.1 : ℝ) < t})) := fun t =>
    ⟨Λ.toReal, by
      rintro x (rfl | ⟨d, -, rfl⟩)
      exacts [ENNReal.toReal_nonneg, (hGK d (mem_univ d)).2]⟩
  -- (α) `G(d) ≤ G̃(t)` if `d < t`; (β) `G̃(t) ≤ G(d)` if `t < d`
  have hα : ∀ d t, (d.1 : ℝ) < t → G d ≤ Gt t := fun d t h => by
    rw [hGt]
    exact le_csSup (hbdd t) (mem_insert_of_mem _ ⟨d, h, rfl⟩)
  have hβ : ∀ d t, t < (d.1 : ℝ) → Gt t ≤ G d := fun d t h => by
    rw [hGt]
    refine csSup_le (insert_nonempty _ _) ?_
    rintro x (rfl | ⟨d', hd', rfl⟩)
    exacts [(hGK d (mem_univ d)).1, hGmono d' d (lt_trans hd' h).le]
  have hmono : Monotone Gt := fun t t' h => by
    rw [hGt, hGt]
    exact csSup_le_csSup (hbdd t') (insert_nonempty _ _)
      (insert_subset_insert (image_mono fun d hd => lt_of_lt_of_le hd h))
  -- `N` is the countable set of discontinuities of the monotone `G̃`
  refine ⟨φ, {t | ¬ContinuousAt Gt t}, hφ, hmono.countable_not_continuousAt, ?_⟩
  intro s hs hsN ε hε
  have hcont : ContinuousAt Gt s := by
    by_contra h
    exact hsN h
  rcases eq_or_ne ε ∞ with rfl | hε'
  · exact ⟨1, one_pos, Eventually.of_forall fun _ => le_top⟩
  have he : 0 < ε.toReal := ENNReal.toReal_pos hε.ne' hε'
  obtain ⟨η₀, hη₀, hcη⟩ := Metric.continuousAt_iff.1 hcont (ε.toReal / 2) (half_pos he)
  -- `δ = η = min (η₀ / 3, (s - a) / 3, (b - s) / 2)`
  obtain ⟨hsa, hsb⟩ := hs
  set η := min (η₀ / 3) (min ((s - a) / 3) ((b - s) / 2))
  have h1 : η ≤ η₀ / 3 := min_le_left _ _
  have h2 : η ≤ (s - a) / 3 := (min_le_right _ _).trans (min_le_left _ _)
  have h3 : η ≤ (b - s) / 2 := (min_le_right _ _).trans (min_le_right _ _)
  have hη : 0 < η := lt_min (by linarith) (lt_min (by linarith) (by linarith))
  -- rationals `d₁ ∈ (s - 2η, s - η)` and `d₂ ∈ (s, s + η)`, both in `(a, b)`
  obtain ⟨q₁, hq₁, hq₁'⟩ := exists_rat_btwn (show s - 2 * η < s - η by linarith)
  obtain ⟨q₂, hq₂, hq₂'⟩ := exists_rat_btwn (show s < s + η by linarith)
  have hd₁ : (q₁ : ℝ) ∈ Ioo a b := ⟨by linarith, by linarith⟩
  have hd₂ : (q₂ : ℝ) ∈ Ioo a b := ⟨by linarith, by linarith⟩
  -- `G(d₂) - G(d₁) ≤ G̃(s + η) - G̃(s - 2η) < ε`
  have hup := @hcη (s + η) (by rw [Real.dist_eq, abs_lt]; constructor <;> linarith)
  have hdown := @hcη (s - 2 * η) (by rw [Real.dist_eq, abs_lt]; constructor <;> linarith)
  rw [Real.dist_eq, abs_lt] at hup hdown
  have hlt : G ⟨q₂, hd₂⟩ - G ⟨q₁, hd₁⟩ < ε.toReal := by
    have := hα ⟨q₂, hd₂⟩ (s + η) hq₂'
    have := hβ ⟨q₁, hd₁⟩ (s - 2 * η) hq₁
    linarith [hup.2, hdown.1]
  -- `μ_{φ j}([s - η, s]) ≤ μ_{φ j}([a, d₂] \ [a, d₁])`, which tends to `G(d₂) - G(d₁) < ε`
  refine ⟨η, hη, (((hGd ⟨q₂, hd₂⟩).sub (hGd ⟨q₁, hd₁⟩)).eventually_lt_const hlt).mono
    fun j hj => ?_⟩
  have hsub : Icc (s - η) s ⊆ Icc a (q₂ : ℝ) \ Icc a (q₁ : ℝ) := by
    rintro x ⟨hx1, hx2⟩
    exact ⟨⟨by linarith, by linarith⟩, fun hx => by linarith [hx.2]⟩
  calc μ (φ j) (Icc (s - η) s) ≤ μ (φ j) (Icc a (q₂ : ℝ) \ Icc a (q₁ : ℝ)) := measure_mono hsub
    _ = μ (φ j) (Icc a (q₂ : ℝ)) - μ (φ j) (Icc a (q₁ : ℝ)) :=
      measure_sdiff (Icc_subset_Icc_right (by linarith)) measurableSet_Icc.nullMeasurableSet
        (hfin _ _ hd₁.2.le)
    _ = ENNReal.ofReal ((μ (φ j) (Icc a (q₂ : ℝ))).toReal - (μ (φ j) (Icc a (q₁ : ℝ))).toReal) := by
      rw [ENNReal.ofReal_sub _ ENNReal.toReal_nonneg, ENNReal.ofReal_toReal (hfin _ _ hd₂.2.le),
        ENNReal.ofReal_toReal (hfin _ _ hd₁.2.le)]
    _ ≤ ENNReal.ofReal ε.toReal := ENNReal.ofReal_le_ofReal hj.le
    _ = ε := ENNReal.ofReal_toReal hε'

/-- Choice of a good cutting level (the Helly extraction, Fatou's lemma for the slice masses and the
choice of the level in the localization step of the proof of Simon 6.7.2, stated abstractly): if
`νⱼ([a, b]) ≤ Λ`, `∫ Fⱼ ≤ Λ < ∞` and `Goodⱼ` holds a.e. for every `j`, then there are
`s ∈ (a, b)`, a subsequence `φ` and `C < ∞` with `Goodⱼ(s)` for all `j`, `F_{φ j}(s) ≤ C`, and for
every `ε > 0` some `δ > 0` with `ν_{φ j}([s - δ, s]) ≤ ε` for all large `j`.
Helly selection gives `φ₁` and a countable `N`; by Fatou `h = liminf F_{φ₁ i}` has `∫ h ≤ Λ`, so
a.e. `t` has every `Goodⱼ(t)`, `h(t) < ∞` and `t ∉ N`.  Such an `s` lies in `(a, b)`, and `φ₂`
extracts `F_{φ₁ (φ₂ j)}(s) < h(s) + 1 = C`; `φ = φ₁ ∘ φ₂`. -/
theorem Submission.dor_lmb_fcl_good_level : ∀ (ν : ℕ → Measure ℝ) (F : ℕ → ℝ → ℝ≥0∞) (Good : ℕ → ℝ → Prop) (a b : ℝ) (Λ : ℝ≥0∞), a < b → Λ ≠ ∞ → (∀ j, ν j (Icc a b) ≤ Λ) → (∀ j, AEMeasurable (F j)) → (∀ j, ∫⁻ t, F j t ≤ Λ) → (∀ j, ∀ᵐ t, Good j t) → ∃ s ∈ Ioo a b, ∃ (φ : ℕ → ℕ) (C : ℝ≥0∞), StrictMono φ ∧ C ≠ ∞ ∧ (∀ j, Good j s) ∧ (∀ j, F (φ j) s ≤ C) ∧ ∀ ε : ℝ≥0∞, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ᶠ j in atTop, ν (φ j) (Icc (s - δ) s) ≤ ε := by
  intro ν F Good a b Λ hab hΛ hν hF hFΛ hGood
  -- Step 1 (Helly): `φ₁` and a countable `N` off which `ν_{φ₁ i}` does not concentrate
  obtain ⟨φ₁, N, hφ₁, hN, hH⟩ := Submission.cmc_fc_gs_helly_no_concentration ν a b Λ hΛ hν
  -- Step 2 (Fatou along `φ₁`): `∫ h ≤ liminf ∫ F_{φ₁ i} ≤ Λ` for `h = liminf F_{φ₁ i}`
  have hmeas : ∀ i, AEMeasurable (F (φ₁ i)) := fun i => hF (φ₁ i)
  have hfatou : ∫⁻ t, liminf (fun i => F (φ₁ i) t) atTop ≤ Λ :=
    (lintegral_liminf_le' hmeas).trans
      (liminf_le_of_frequently_le' (Frequently.of_forall fun i => hFΛ (φ₁ i)))
  -- Step 3: `h` is a.e.-measurable with finite integral, hence finite a.e.
  have hfin : ∀ᵐ t, liminf (fun i => F (φ₁ i) t) atTop < ∞ :=
    ae_lt_top' (AEMeasurable.liminf hmeas) (hfatou.trans_lt hΛ.lt_top).ne
  -- Step 4: a.e. `t` has `Goodⱼ(t)` for all `j`, `h(t) < ∞` and `t ∉ N` (`N` is countable)
  have hae : ∀ᵐ t, (∀ j, Good j t) ∧ liminf (fun i => F (φ₁ i) t) atTop < ∞ ∧ t ∉ N := by
    filter_upwards [ae_all_iff.2 hGood, hfin,
      measure_eq_zero_iff_ae_notMem.1 (hN.measure_zero volume)] with t h1 h2 h3
    exact ⟨h1, h2, h3⟩
  -- Step 5: `(a, b)` has positive measure, so it meets this full-measure set
  obtain ⟨s, hs, hGs, hhs, hsN⟩ : ∃ s ∈ Ioo a b,
      (∀ j, Good j s) ∧ liminf (fun i => F (φ₁ i) s) atTop < ∞ ∧ s ∉ N := by
    by_contra hcon
    refine (ENNReal.ofReal_pos.2 (sub_pos.2 hab)).ne' ?_
    rw [← Real.volume_Ioo]
    exact measure_mono_null (fun t ht hPt => hcon ⟨t, ht, hPt⟩) (ae_iff.1 hae)
  -- Step 6: `h(s) < h(s) + 1 = C`, so `F_{φ₁ i}(s) < C` frequently; extract `φ₂`
  obtain ⟨φ₂, hφ₂, hC⟩ := extraction_of_frequently_atTop
    (frequently_lt_of_liminf_lt (h := ENNReal.lt_add_right hhs.ne one_ne_zero))
  -- Step 7: `φ = φ₁ ∘ φ₂`; no concentration passes to `φ` since `φ₂ j ≥ j`
  refine ⟨s, hs, φ₁ ∘ φ₂, liminf (fun i => F (φ₁ i) s) atTop + 1, hφ₁.comp hφ₂,
    ENNReal.add_ne_top.2 ⟨hhs.ne, ENNReal.one_ne_top⟩, hGs, fun j => (hC j).le, fun ε hε => ?_⟩
  obtain ⟨δ, hδ, hev⟩ := hH s hs hsN ε hε
  obtain ⟨J, hJ⟩ := eventually_atTop.1 hev
  exact ⟨δ, hδ, eventually_atTop.2 ⟨J, fun j hj => hJ (φ₂ j) (le_trans hj (hφ₂.id_le j))⟩⟩
/-- **Compact distance sublevel sets** (Simon Ch. 6, proof of 7.2, localization): if `U ⊆ ℝᴾ` is
open and `C ⊆ U` is compact and nonempty, there is `δ₀ > 0` such that for every `r ≤ δ₀` the
sublevel set `{x : dist(x, C) ≤ r}` is compact and contained in `U`.  Take `δ₀` with
`cthickening δ₀ C ⊆ U`; each such sublevel set is closed (`dist(·, C)` is continuous) and lies in
the compact set `cthickening δ₀ C`. -/
theorem Submission.cmc_fcl_dist_sublevel_compact : ∀ (P : ℕ) (U C : Set (Euclid P)), IsOpen U → IsCompact C → C ⊆ U → C.Nonempty → ∃ δ₀ : ℝ, 0 < δ₀ ∧ ∀ r : ℝ, r ≤ δ₀ → IsCompact {x | infDist x C ≤ r} ∧ {x | infDist x C ≤ r} ⊆ U := by
  intro P U C hU hC hCU hCne
  -- some closed thickening `cthickening δ₀ C` of `C` lies in `U`
  obtain ⟨δ₀, hδ₀, hsub⟩ := hC.exists_cthickening_subset_open hU hCU
  refine ⟨δ₀, hδ₀, fun r hr => ?_⟩
  -- `{dist(·, C) ≤ r} ⊆ cthickening δ₀ C`, since `infEDist x C = ofReal (dist(x, C))` for `C ≠ ∅`
  have hsubset : {x | infDist x C ≤ r} ⊆ cthickening δ₀ C := by
    intro x hx
    have hx' : infDist x C ≤ δ₀ := le_trans hx hr
    rw [mem_cthickening_iff, ← ENNReal.ofReal_toReal (infEDist_ne_top hCne)]
    exact ENNReal.ofReal_le_ofReal hx'
  -- the sublevel set of the continuous function `dist(·, C)` is closed
  have hclosed : IsClosed {x | infDist x C ≤ r} :=
    isClosed_le (continuous_infDist_pt C) continuous_const
  -- a closed subset of the compact set `cthickening δ₀ C ⊆ U`
  exact ⟨hC.cthickening.of_isClosed_subset hclosed hsubset, hsubset.trans hsub⟩
/-- **Weak convergence of sublevel restrictions without concentration at the cut level**
(Simon 7.2.4, localization step).  Let `G = {g < s}` for a continuous `g`, and let `Tⱼ, T` and
their restrictions `T'ⱼ = Tⱼ⌞G`, `T' = T⌞G` act by `ω ↦ ∫ ⟨ω, ξⱼ⟩ dμⱼ` (resp. `∫_G`), with
`μⱼ(G), μ(G) < ∞` and `|⟨α, ξⱼ⟩|, |⟨α, ξ⟩| ≤ |α|` a.e.  If `Tⱼ ⇀ T` and, for every `ε > 0`,
`μⱼ{s − δ ≤ g ≤ s} ≤ ε` for some `δ > 0` and all large `j`, then `T'ⱼ ⇀ T'`.  Fix `ω` with
`|ω| ≤ c`; a smooth cutoff `χ` (`χ = 1` on `{g ≤ s − δ'}`, `χ = 0` on `{g ≥ s − δ'/2}`) gives a
test form `χω` with `|T'ⱼ(ω) − Tⱼ(χω)| ≤ c μⱼ{s − δ' < g < s}` and
`|T'(ω) − T(χω)| ≤ c μ{s − δ' < g < s}`; the latter layer shrinks by continuity from above, the
former by hypothesis, and `Tⱼ(χω) → T(χω)`. -/
theorem Submission.cmc_fcl_weakConverges_sublevel : ∀ (P d : ℕ) (U : Set (Euclid P)) (g : Euclid P → ℝ) (s : ℝ) (μs : ℕ → Measure (Euclid P)) (μ : Measure (Euclid P)) (ξs : ℕ → Euclid P → MultiVector P d) (ξ : Euclid P → MultiVector P d) (Ts Ts' : ℕ → GeometricCurrentOn U d) (T T' : GeometricCurrentOn U d), Continuous g → (∀ j, μs j {x | g x < s} < ∞) → μ {x | g x < s} < ∞ → (∀ j, AEStronglyMeasurable (ξs j) (μs j)) → AEStronglyMeasurable ξ μ → (∀ j, ∀ᵐ x ∂(μs j), ∀ α : Covector (Euclid P) d, |ξs j x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) d, |ξ x α| ≤ covectorEuclideanNorm α) → (∀ (j : ℕ) (ω : TestFormOn U d), Ts j ω = ∫ x, ξs j x ((ω : DifferentialForm (Euclid P) d) x) ∂(μs j)) → (∀ ω : TestFormOn U d, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) d) x) ∂μ) → (∀ (j : ℕ) (ω : TestFormOn U d), Ts' j ω = ∫ x in {x | g x < s}, ξs j x ((ω : DifferentialForm (Euclid P) d) x) ∂(μs j)) → (∀ ω : TestFormOn U d, T' ω = ∫ x in {x | g x < s}, ξ x ((ω : DifferentialForm (Euclid P) d) x) ∂μ) → WeaklyConvergesOn Ts T → (∀ ε : ℝ≥0∞, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ᶠ j in atTop, μs j {x | s - δ ≤ g x ∧ g x ≤ s} ≤ ε) → WeaklyConvergesOn Ts' T' := by
  intro P d U g s μs μ ξs ξ Ts Ts' T T' hg hμsG hμG hξsm hξm hξsb hξb hTs hT hTs' hT' hconv hconc
    ω
  obtain ⟨w, hwdef⟩ : ∃ w : DifferentialForm (Euclid P) d, w = (ω : DifferentialForm (Euclid P) d) :=
    ⟨_, rfl⟩
  have hwc : Continuous w := by rw [hwdef]; exact ω.property.1.1.continuous
  -- Step 1: a bound `c` for the coefficient norm of `ω`.
  have hnc : Continuous fun α : Covector (Euclid P) d => covectorEuclideanNorm α := by
    unfold covectorEuclideanNorm
    apply Continuous.sqrt
    apply continuous_finsetSum
    intro I _
    split_ifs
    · exact (continuous_eval_const _).pow 2
    · exact continuous_const
  obtain ⟨c, hc⟩ : ∃ c : ℝ, ∀ x, covectorEuclideanNorm (w x) ≤ c := by
    have hwcs : HasCompactSupport w := by
      rw [hwdef]
      exact ω.property.1.2
    have hcs : HasCompactSupport (covectorEuclideanNorm ∘ w) :=
      hwcs.comp_left (covectorEuclideanNorm_zero P d)
    obtain ⟨C, hC⟩ := hcs.exists_bound_of_continuous (hnc.comp hwc)
    exact ⟨C, fun x => le_trans (le_abs_self _) (by simpa [Real.norm_eq_abs] using hC x)⟩
  have hc0 : 0 ≤ c := le_trans (covectorEuclideanNorm_nonneg _) (hc 0)
  have hGm : MeasurableSet {x | g x < s} := measurableSet_lt hg.measurable measurable_const
  -- Step 2: the cutoff estimate, for an arbitrary measure.
  have key : ∀ (ν : Measure (Euclid P)) (ζ : Euclid P → MultiVector P d) (χ : Euclid P → ℝ) (r : ℝ),
      ν {x | g x < s} < ∞ → AEStronglyMeasurable ζ ν →
      (∀ᵐ x ∂ν, ∀ α : Covector (Euclid P) d, |ζ x α| ≤ covectorEuclideanNorm α) →
      Continuous χ → (∀ x, χ x ∈ Icc (0 : ℝ) 1) → (∀ x, g x ≤ r → χ x = 1) →
      (∀ x, s ≤ g x → χ x = 0) →
      |∫ x in {x | g x < s}, ζ x (w x) ∂ν - ∫ x, ζ x (χ x • w x) ∂ν| ≤
        c * ν.real {x | r < g x ∧ g x < s} := by
    intro ν ζ χ r hνG hζm hζb hχc hχ01 hχ1 hχ0
    have hF : AEStronglyMeasurable (fun x => ζ x (w x)) ν :=
      (continuous_fst.clm_apply continuous_snd).comp_aestronglyMeasurable
        (hζm.prodMk hwc.aestronglyMeasurable)
    have hFb : ∀ᵐ x ∂ν, |ζ x (w x)| ≤ c := hζb.mono fun x hx => (hx _).trans (hc x)
    have hint1 : IntegrableOn (fun x => ζ x (w x)) {x | g x < s} ν :=
      Measure.integrableOn_of_bounded hνG.ne hF
        (ae_restrict_of_ae (hFb.mono fun x hx => by rwa [Real.norm_eq_abs]))
    have hχF : ∀ x, |ζ x (w x)| ≤ c → |χ x * ζ x (w x)| ≤ c := by
      intro x hx
      rw [abs_mul]
      have h01 := hχ01 x
      calc |χ x| * |ζ x (w x)| ≤ 1 * c :=
            mul_le_mul (by rw [abs_of_nonneg h01.1]; exact h01.2) hx (abs_nonneg _) zero_le_one
        _ = c := one_mul c
    have hint2 : IntegrableOn (fun x => χ x * ζ x (w x)) {x | g x < s} ν :=
      Measure.integrableOn_of_bounded hνG.ne (hχc.aestronglyMeasurable.mul hF)
        (ae_restrict_of_ae (hFb.mono fun x hx => by rw [Real.norm_eq_abs]; exact hχF x hx))
    have hsmul : ∀ x, ζ x (χ x • w x) = χ x * ζ x (w x) := fun x => by
      rw [map_smul, smul_eq_mul]
    have h2 : ∫ x, ζ x (χ x • w x) ∂ν = ∫ x in {x | g x < s}, χ x * ζ x (w x) ∂ν := by
      simp_rw [hsmul]
      exact (setIntegral_eq_integral_of_forall_compl_eq_zero fun x hx => by
        have : s ≤ g x := not_lt.1 hx
        rw [hχ0 x this, zero_mul]).symm
    rw [h2, ← integral_sub hint1 hint2]
    have h3 : ∫ x in {x | g x < s}, (ζ x (w x) - χ x * ζ x (w x)) ∂ν =
        ∫ x in {x | r < g x ∧ g x < s}, (ζ x (w x) - χ x * ζ x (w x)) ∂ν := by
      apply setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hGm (fun x hx => hx.2)
      intro x hx
      have : g x ≤ r := by
        by_contra h
        exact hx.2 ⟨lt_of_not_ge h, hx.1⟩
      rw [hχ1 x this]
      ring
    rw [h3, ← Real.norm_eq_abs]
    apply norm_setIntegral_le_of_norm_le_const_ae
      (lt_of_le_of_lt (measure_mono fun x hx => hx.2) hνG)
    apply ae_restrict_of_ae
    filter_upwards [hFb] with x hx
    rw [Real.norm_eq_abs, show ζ x (w x) - χ x * ζ x (w x) = (1 - χ x) * ζ x (w x) by ring,
      abs_mul]
    have h01 := hχ01 x
    calc |1 - χ x| * |ζ x (w x)| ≤ 1 * c :=
          mul_le_mul (by rw [abs_of_nonneg (by linarith [h01.2])]; linarith [h01.1]) hx
            (abs_nonneg _) zero_le_one
      _ = c := one_mul c
  -- Step 3: the ε-argument.
  rw [Metric.tendsto_atTop]
  intro ε hε
  obtain ⟨η, hηdef⟩ : ∃ η : ℝ, η = ε / (3 * (c + 1)) := ⟨_, rfl⟩
  have hη : 0 < η := by rw [hηdef]; positivity
  obtain ⟨δ₁, hδ₁, hμδ₁⟩ :
      ∃ δ₁ : ℝ, 0 < δ₁ ∧ μ {x | s - δ₁ < g x ∧ g x < s} ≤ ENNReal.ofReal η := by
    let S : ℕ → Set (Euclid P) := fun i => {x | s - 1 / ((i : ℝ) + 1) < g x ∧ g x < s}
    have hSm : ∀ i, NullMeasurableSet (S i) μ := fun i =>
      ((measurableSet_lt measurable_const hg.measurable).inter hGm).nullMeasurableSet
    have hSanti : Antitone S := by
      intro i k hik x hx
      refine ⟨lt_of_le_of_lt ?_ hx.1, hx.2⟩
      have : (1 : ℝ) / ((k : ℝ) + 1) ≤ 1 / ((i : ℝ) + 1) :=
        one_div_le_one_div_of_le (by positivity) (by exact_mod_cast Nat.add_le_add_right hik 1)
      linarith
    have hSfin : ∃ i, μ (S i) ≠ ∞ :=
      ⟨0, (lt_of_le_of_lt (measure_mono fun x hx => hx.2) hμG).ne⟩
    have hinter : (⋂ i, S i) = ∅ := by
      ext x
      simp only [S, mem_iInter, mem_ofPred_eq, mem_empty_iff_false, iff_false, not_forall]
      by_cases hxs : g x < s
      · obtain ⟨i, hi⟩ := exists_nat_one_div_lt (sub_pos.2 hxs)
        exact ⟨i, fun h => by linarith [h.1]⟩
      · exact ⟨0, fun h => hxs h.2⟩
    have ht := tendsto_measure_iInter_atTop hSm hSanti hSfin
    rw [hinter, measure_empty] at ht
    have hev := (ENNReal.tendsto_nhds_zero.1 ht) (ENNReal.ofReal η) (ENNReal.ofReal_pos.2 hη)
    obtain ⟨i, hi⟩ := hev.exists
    exact ⟨1 / ((i : ℝ) + 1), by positivity, hi⟩
  obtain ⟨δ₂, hδ₂, hev₂⟩ := hconc (ENNReal.ofReal η) (ENNReal.ofReal_pos.2 hη)
  have hδ' : 0 < min δ₁ δ₂ := lt_min hδ₁ hδ₂
  obtain ⟨χ, hχs, hχ01, hχ1, hχ0'⟩ : ∃ χ : Euclid P → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) χ ∧
      (∀ x, χ x ∈ Icc (0 : ℝ) 1) ∧ (∀ x, g x ≤ s - min δ₁ δ₂ → χ x = 1) ∧
      (∀ x, s - min δ₁ δ₂ / 2 ≤ g x → χ x = 0) := by
    obtain ⟨f, hf1, hf0, hf01⟩ := exists_contMDiffMap_one_nhds_of_subset_interior
      (modelWithCornersSelf ℝ (Euclid P)) (n := ⊤) (s := {x | g x ≤ s - min δ₁ δ₂})
      (t := {x | g x < s - min δ₁ δ₂ / 2}) (isClosed_le hg continuous_const)
      (by
        rw [(isOpen_lt hg continuous_const).interior_eq]
        intro x (hx : g x ≤ s - min δ₁ δ₂)
        show g x < s - min δ₁ δ₂ / 2
        linarith)
    refine ⟨f, contMDiff_iff_contDiff.1 f.contMDiff, hf01, fun x hx => hf1.self_of_nhdsSet x hx,
      fun x hx => hf0 x (by simp only [mem_ofPred_eq, not_lt]; exact hx)⟩
  have hχ0 : ∀ x, s ≤ g x → χ x = 0 := fun x hx => hχ0' x (by linarith)
  have hws : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) w := by rw [hwdef]; exact ω.property.1.1
  have hwcs : HasCompactSupport w := by rw [hwdef]; exact ω.property.1.2
  have hwU : tsupport w ⊆ U := by rw [hwdef]; exact ω.property.2
  have hsupp : support (fun x => χ x • w x) ⊆ support w := by
    intro x hx h0
    apply hx
    simp only [h0, smul_zero]
  have h1 : IsSmoothForm (fun x => χ x • w x) := hχs.smul hws
  have h2 : HasCompactSupport (fun x => χ x • w x) :=
    hwcs.mono' (hsupp.trans (subset_tsupport w))
  have h3 : tsupport (fun x => χ x • w x) ⊆ U := (closure_mono hsupp).trans hwU
  have hmem : (fun x => χ x • w x) ∈ TestFormOn U d := ⟨⟨h1, h2⟩, h3⟩
  let χω : TestFormOn U d := ⟨fun x => χ x • w x, hmem⟩
  have hconvχ := hconv χω
  rw [Metric.tendsto_atTop] at hconvχ
  obtain ⟨N₁, hN₁⟩ := hconvχ η hη
  obtain ⟨N₂, hN₂⟩ := eventually_atTop.1 hev₂
  refine ⟨max N₁ N₂, fun j hj => ?_⟩
  have hj₁ : N₁ ≤ j := le_trans (le_max_left _ _) hj
  have hj₂ : N₂ ≤ j := le_trans (le_max_right _ _) hj
  have e1 := key (μs j) (ξs j) χ (s - min δ₁ δ₂) (hμsG j) (hξsm j) (hξsb j) hχs.continuous hχ01
    hχ1 hχ0
  have e2 := key μ ξ χ (s - min δ₁ δ₂) hμG hξm hξb hχs.continuous hχ01 hχ1 hχ0
  have hm1 : (μs j).real {x | s - min δ₁ δ₂ < g x ∧ g x < s} ≤ η := by
    have : μs j {x | s - min δ₁ δ₂ < g x ∧ g x < s} ≤ ENNReal.ofReal η :=
      le_trans (measure_mono (show {x | s - min δ₁ δ₂ < g x ∧ g x < s} ⊆
          {x | s - δ₂ ≤ g x ∧ g x ≤ s} from
          fun x hx => ⟨by linarith [hx.1, min_le_right δ₁ δ₂], hx.2.le⟩)) (hN₂ j hj₂)
    exact ENNReal.toReal_le_of_le_ofReal hη.le this
  have hm2 : μ.real {x | s - min δ₁ δ₂ < g x ∧ g x < s} ≤ η := by
    have : μ {x | s - min δ₁ δ₂ < g x ∧ g x < s} ≤ ENNReal.ofReal η :=
      le_trans (measure_mono (show {x | s - min δ₁ δ₂ < g x ∧ g x < s} ⊆
          {x | s - δ₁ < g x ∧ g x < s} from
          fun x hx => ⟨by linarith [hx.1, min_le_left δ₁ δ₂], hx.2⟩)) hμδ₁
    exact ENNReal.toReal_le_of_le_ofReal hη.le this
  have h3 : dist (Ts j χω) (T χω) < η := hN₁ j hj₁
  have hTsχ : Ts j χω = ∫ x, ξs j x (χ x • w x) ∂(μs j) := hTs j χω
  have hTχ : T χω = ∫ x, ξ x (χ x • w x) ∂μ := hT χω
  rw [Real.dist_eq, hTsχ, hTχ] at h3
  rw [Real.dist_eq, hTs' j ω, hT' ω, ← hwdef]
  have hc1 := mul_le_mul_of_nonneg_left hm1 hc0
  have hc2 := mul_le_mul_of_nonneg_left hm2 hc0
  have habs := abs_sub_le (∫ x in {x | g x < s}, ξs j x (w x) ∂(μs j))
    (∫ x, ξs j x (χ x • w x) ∂(μs j)) (∫ x in {x | g x < s}, ξ x (w x) ∂μ)
  have habs2 := abs_sub_le (∫ x, ξs j x (χ x • w x) ∂(μs j)) (∫ x, ξ x (χ x • w x) ∂μ)
    (∫ x in {x | g x < s}, ξ x (w x) ∂μ)
  rw [abs_sub_comm (∫ x, ξ x (χ x • w x) ∂μ)] at habs2
  have hfin : (2 * c + 1) * η < ε := by
    rw [hηdef]
    rw [mul_div_assoc', div_lt_iff₀ (by positivity)]
    nlinarith
  linarith
/-- **Lipschitz order statistic** (proof of Simon Ch. 6, Lemma 5.4, the retraction of the
deformation theorem): for `m + 1 < P` the `ℓ`-th largest entry
`κ u = max_{|I| = ℓ} min_{i ∈ I} u i`, `ℓ = P − (m + 1)`, of `u : Fin P → ℝ` is `≤` at least `ℓ`
entries of `u`, `≥` at least `m + 2` entries, and is `1`-Lipschitz for the sup norm.  A maximizing
`I` gives the first property; if at most `m + 1` entries were `≤ κ u`, then `ℓ` entries `> κ u`
would form an `I` with `min_I u > κ u`; and each `min_I` is `1`-Lipschitz for the sup norm, hence
so is their maximum. -/
theorem Submission.dor_lmb_fcdr_order_stat : ∀ (P m : ℕ), m + 1 < P → ∃ κ : (Fin P → ℝ) → ℝ, (∀ u : Fin P → ℝ, ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, κ u ≤ u i) ∧ (∀ u : Fin P → ℝ, ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, u i ≤ κ u) ∧ ∀ u v : Fin P → ℝ, ∀ t : ℝ, (∀ i, |u i - v i| ≤ t) → |κ u - κ v| ≤ t := by
  intro P m hmP
  classical
  -- `𝓕` = the `ℓ`-element index sets, `ℓ = P − (m + 1) ≥ 1`; `𝓕` and its members are nonempty
  let F : Finset (Finset (Fin P)) := Finset.powersetCard (P - (m + 1)) Finset.univ
  have hF : F.Nonempty := Finset.powersetCard_nonempty.2 (by rw [Finset.card_fin]; omega)
  have hFI : ∀ I ∈ F, I.Nonempty ∧ I.card = P - (m + 1) := fun I hI => by
    have hc := (Finset.mem_powersetCard.1 hI).2
    exact ⟨Finset.card_pos.1 (by omega), hc⟩
  -- `g u I = min_{i ∈ I} u i` (the empty set, not in `𝓕`, gets `0`); `κ u = max_{I ∈ 𝓕} g u I`
  let g : (Fin P → ℝ) → Finset (Fin P) → ℝ := fun u I => if h : I.Nonempty then I.inf' h u else 0
  have hg : ∀ u I (hI : I ∈ F), g u I = I.inf' (hFI I hI).1 u := fun u I hI =>
    dite_eq_left (hFI I hI).1
  refine ⟨fun u => F.sup' hF (g u), fun u => ?_, fun u => ?_, fun u v t huv => ?_⟩
  · -- (1): a maximizing `I` has `ℓ` indices with `κ u ≤ u i`
    obtain ⟨I, hI, hIu⟩ := Finset.exists_mem_eq_sup' hF (g u)
    refine ⟨I, by have := (hFI I hI).2; omega, fun i hi => ?_⟩
    show F.sup' hF (g u) ≤ u i
    rw [hIu, hg u I hI]
    exact Finset.inf'_le u hi
  · -- (2): otherwise `ℓ` entries `> κ u` would form `I ∈ 𝓕` with `g u I > κ u`
    refine ⟨Finset.univ.filter (fun i => u i ≤ F.sup' hF (g u)), ?_,
      fun i hi => (Finset.mem_filter.1 hi).2⟩
    by_contra hlt
    have hsum := Finset.card_filter_add_card_filter_not (s := Finset.univ)
      (fun i => u i ≤ F.sup' hF (g u))
    rw [Finset.card_fin] at hsum
    obtain ⟨I, hIB, hIc⟩ := Finset.exists_subset_card_eq
      (s := Finset.univ.filter (fun i => ¬ u i ≤ F.sup' hF (g u))) (n := P - (m + 1)) (by omega)
    have hI : I ∈ F := Finset.mem_powersetCard.2 ⟨Finset.subset_univ I, hIc⟩
    have h1 : g u I ≤ F.sup' hF (g u) := Finset.le_sup' (g u) hI
    have h2 : F.sup' hF (g u) < g u I := by
      rw [hg u I hI, Finset.lt_inf'_iff]
      exact fun i hi => lt_of_not_ge (Finset.mem_filter.1 (hIB hi)).2
    exact absurd h1 (not_le.2 h2)
  · -- (3): each `g · I`, hence `κ`, is `1`-Lipschitz for the sup norm
    have key : ∀ u v : Fin P → ℝ, (∀ i, |u i - v i| ≤ t) →
        F.sup' hF (g u) ≤ F.sup' hF (g v) + t := by
      intro u v huv
      refine Finset.sup'_le hF (g u) fun I hI => ?_
      obtain ⟨i₀, hi₀, hv⟩ := Finset.exists_mem_eq_inf' (hFI I hI).1 v
      have h1 : g u I ≤ u i₀ := by rw [hg u I hI]; exact Finset.inf'_le u hi₀
      have h2 : g v I = v i₀ := by rw [hg v I hI]; exact hv
      have h3 : g v I ≤ F.sup' hF (g v) := Finset.le_sup' (g v) hI
      have h4 := (abs_le.1 (huv i₀)).2
      linarith
    have hvu : ∀ i, |v i - u i| ≤ t := fun i => by rw [abs_sub_comm]; exact huv i
    show |F.sup' hF (g u) - F.sup' hF (g v)| ≤ t
    rw [abs_sub_le_iff]
    constructor <;> linarith [key u v huv, key v u hvu]
/-- **Distance to `L*(a)` from an integer translate** (Simon Ch. 6, 5.4, closed-form retraction,
Claim C).  Let `|aᵢ - 1/2| < 1/4` for all `i`, and let `κ(u) ≥ uᵢ` for at least `m + 2` indices `i`
(every `u`).  If `x - y ∈ ℤᴾ` then `dist(x, L*(a)) ≤ √(m + 2) κ(r(y))`, where
`r_j(y) = max((y_j - a_j)/(1 - a_j), (a_j - y_j)/a_j)` and `L*(a)` is the set of points with at least
`m + 2` coordinates in `aᵢ + ℤ`.  As `0 < a_j, 1 - a_j ≤ 1`, `|y_j - a_j| ≤ r_j(y)`.  On a set `J`
of `m + 2` indices with `r_i(y) ≤ κ(r(y))` put `x*_i = x_i - y_i + a_i` (`i ∈ J`), `x*_i = x_i`
(`i ∉ J`); then `x* ∈ L*(a)` and `|x - x*|² = Σ_{i ∈ J} (y_i - a_i)² ≤ (m + 2) κ(r(y))²`. -/
theorem Submission.dor_lmb_fcdr_dual_dist : ∀ (P m : ℕ) (a : Euclid P), (∀ i, |a i - 1 / 2| < 1 / 4) → ∀ κ : (Fin P → ℝ) → ℝ, (∀ u : Fin P → ℝ, ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, u i ≤ κ u) → ∀ x y : Euclid P, (∀ i, ∃ k : ℤ, x i - y i = k) → infDist x {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} ≤ Real.sqrt (m + 2) * κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)) := by
  intro P m a ha κ hκ x y hxy
  set u : Fin P → ℝ := fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j) with hu_def
  -- Steps 1–2: `1/4 < a_j < 3/4`, so `|y_j - a_j| ≤ r_j(y) = u j`
  have hbound : ∀ j, |y j - a j| ≤ u j := by
    intro j
    obtain ⟨h1l, h1r⟩ := abs_lt.mp (ha j)
    have ha0 : 0 < a j := by linarith
    have ha1 : 0 < 1 - a j := by linarith
    rcases le_total (a j) (y j) with h | h
    · rw [abs_of_nonneg (sub_nonneg.mpr h)]
      have hle : y j - a j ≤ (y j - a j) / (1 - a j) := by
        rw [le_div_iff₀ ha1]
        nlinarith
      exact hle.trans (le_max_left _ _)
    · rw [abs_sub_comm, abs_of_nonneg (sub_nonneg.mpr h)]
      have hle : a j - y j ≤ (a j - y j) / a j := by
        rw [le_div_iff₀ ha0]
        nlinarith
      exact hle.trans (le_max_right _ _)
  -- Step 3: a set `J` of exactly `m + 2` indices with `|y_i - a_i| ≤ u i ≤ κ u`, so `κ u ≥ 0`
  obtain ⟨s, hs_card, hs⟩ := hκ u
  obtain ⟨J, hJs, hJcard⟩ := Finset.exists_subset_card_eq hs_card
  choose k hk using hxy
  have hJbound : ∀ i ∈ J, |y i - a i| ≤ κ u := fun i hi =>
    (hbound i).trans (hs i (hJs hi))
  have hκ_nonneg : 0 ≤ κ u := by
    have hJne : J.Nonempty := by
      rw [← Finset.card_pos, hJcard]; omega
    obtain ⟨i, hi⟩ := hJne
    exact (abs_nonneg _).trans (hJbound i hi)
  -- Step 4: the shifted point `x*` lies in `L*(a)`
  let xs : Euclid P := WithLp.toLp 2 (fun i => if i ∈ J then x i - y i + a i else x i)
  have hxs_mem : xs ∈ {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧
      ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} := by
    refine ⟨J, hJcard.ge, fun i hi => ⟨k i, ?_⟩⟩
    show (if i ∈ J then x i - y i + a i else x i) - a i = k i
    rw [ite_eq_left hi, ← hk i]
    ring
  -- Step 5: `dist(x, L*(a)) ≤ |x - x*| = (Σ_{i ∈ J} (y_i - a_i)²)^{1/2} ≤ √(m + 2) κ u`
  refine (infDist_le_dist_of_mem hxs_mem).trans ?_
  rw [EuclideanSpace.dist_eq]
  have hsum : ∑ i, dist (x i) (xs i) ^ 2 ≤ ((m : ℝ) + 2) * (κ u) ^ 2 := by
    have h1 : ∑ i, dist (x i) (xs i) ^ 2 = ∑ i ∈ J, dist (x i) (xs i) ^ 2 := by
      symm
      apply Finset.sum_subset (Finset.subset_univ J)
      intro i _ hi
      show dist (x i) (if i ∈ J then x i - y i + a i else x i) ^ 2 = 0
      rw [ite_eq_right hi, dist_self]
      ring
    rw [h1]
    have h2 : ∑ i ∈ J, dist (x i) (xs i) ^ 2 ≤ J.card • (κ u ^ 2) := by
      apply Finset.sum_le_card_nsmul
      intro i hi
      show dist (x i) (if i ∈ J then x i - y i + a i else x i) ^ 2 ≤ κ u ^ 2
      rw [ite_eq_left hi, Real.dist_eq]
      have hxy' : x i - (x i - y i + a i) = y i - a i := by ring
      rw [hxy']
      exact pow_le_pow_left₀ (abs_nonneg _) (hJbound i hi) 2
    rw [hJcard, nsmul_eq_mul] at h2
    push_cast at h2
    exact h2
  calc Real.sqrt (∑ i, dist (x i) (xs i) ^ 2)
      ≤ Real.sqrt (((m : ℝ) + 2) * (κ u) ^ 2) := Real.sqrt_le_sqrt hsum
    _ = Real.sqrt ((m : ℝ) + 2) * κ u := by
      rw [Real.sqrt_mul (by positivity), Real.sqrt_sq hκ_nonneg]
/-- **Simon Ch. 6, Lemma 5.4** (step 4(i) of the closed-form retraction): with
`r_j(y) = max((y_j − a_j)/(1 − a_j), (a_j − y_j)/a_j)` and `κ(r(y)) > 0`, the point
`Φ(y)_i = a_i + (y_i − a_i)/max(r_i(y), κ(r(y)))` lies in the cube `[0, 1]ᴾ`, and `Φ(y)_i ∈ {0, 1}`
on an index set `s` with `P ≤ m + 1 + |s|`.  As `1/4 < a_i < 3/4`, `μ_i = max(r_i(y), κ(r(y)))` is
positive and dominates `(y_i − a_i)/(1 − a_i)` and `(a_i − y_i)/a_i`, so
`−a_i ≤ (y_i − a_i)/μ_i ≤ 1 − a_i`.  On the indices with `κ(r(y)) ≤ r_i(y)` given by the hypothesis
on `κ`, `μ_i = r_i(y)` and the quotient is exactly `1 − a_i` (`y_i ≥ a_i`) or `−a_i` (`y_i < a_i`). -/
theorem Submission.dor_lmb_fcdr_cube_skeleton : ∀ (P m : ℕ) (a : Euclid P), (∀ i, |a i - 1 / 2| < 1 / 4) → ∀ κ : (Fin P → ℝ) → ℝ, (∀ u : Fin P → ℝ, ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, κ u ≤ u i) → ∀ Φ : Euclid P → Euclid P, (∀ (y : Euclid P) (i : Fin P), Φ y i = a i + (y i - a i) / max (max ((y i - a i) / (1 - a i)) ((a i - y i) / a i)) (κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)))) → ∀ y : Euclid P, 0 < κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)) → (∀ i, 0 ≤ Φ y i ∧ Φ y i ≤ 1) ∧ ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, Φ y i = 0 ∨ Φ y i = 1 := by
  intro P m a ha κ hκ Φ hΦ y hy
  -- `|a_i − 1/2| < 1/4` gives `0 < a_i < 1`
  have ha' : ∀ i, 0 < a i ∧ a i < 1 := fun i => by
    obtain ⟨h1, h2⟩ := abs_lt.mp (ha i)
    constructor <;> linarith
  -- if `μ > 0` dominates `(z − b)/(1 − b)` and `(b − z)/b`, then `0 ≤ b + (z − b)/μ ≤ 1`
  have bounds : ∀ b z μ : ℝ, 0 < b → b < 1 → 0 < μ → (z - b) / (1 - b) ≤ μ → (b - z) / b ≤ μ →
      0 ≤ b + (z - b) / μ ∧ b + (z - b) / μ ≤ 1 := by
    intro b z μ hb0 hb1 hμ h1 h2
    rw [div_le_iff₀ (by linarith)] at h1
    rw [div_le_iff₀ hb0] at h2
    constructor
    · have : -b ≤ (z - b) / μ := by
        rw [le_div_iff₀ hμ]
        linarith
      linarith
    · have : (z - b) / μ ≤ 1 - b := by
        rw [div_le_iff₀ hμ]
        linarith
      linarith
  -- if moreover `0 < k ≤ r = max((z − b)/(1 − b), (b − z)/b)`, then `max(r, k) = r` and the
  -- coordinate is `b + (1 − b) = 1` (`z ≥ b`) or `b − b = 0` (`z < b`)
  have skel : ∀ b z k : ℝ, 0 < b → b < 1 → 0 < k → k ≤ max ((z - b) / (1 - b)) ((b - z) / b) →
      b + (z - b) / max (max ((z - b) / (1 - b)) ((b - z) / b)) k = 0 ∨
        b + (z - b) / max (max ((z - b) / (1 - b)) ((b - z) / b)) k = 1 := by
    intro b z k hb0 hb1 hk hkr
    have h1b : 0 < 1 - b := by linarith
    rw [max_eq_left hkr]
    rcases le_or_gt b z with h | h
    · right
      have e1 : (b - z) / b ≤ 0 := div_nonpos_of_nonpos_of_nonneg (by linarith) hb0.le
      have e2 : 0 ≤ (z - b) / (1 - b) := div_nonneg (by linarith) h1b.le
      rw [max_eq_left (e1.trans e2)] at hkr ⊢
      have hzb : z - b ≠ 0 := by
        intro h0
        rw [h0, zero_div] at hkr
        linarith
      rw [div_div_cancel₀ hzb]
      ring
    · left
      have e1 : (z - b) / (1 - b) ≤ 0 := div_nonpos_of_nonpos_of_nonneg (by linarith) h1b.le
      have e2 : 0 ≤ (b - z) / b := div_nonneg (by linarith) hb0.le
      rw [max_eq_right (e1.trans e2), ← neg_sub b z, neg_div, div_div_cancel₀ (sub_pos.mpr h).ne']
      ring
  -- `μ_i = max(r_i(y), κ(r(y))) ≥ κ(r(y)) > 0` dominates both quotients in `r_i(y)`
  refine ⟨fun i => ?_, ?_⟩
  · rw [hΦ y i]
    exact bounds (a i) (y i) _ (ha' i).1 (ha' i).2 (hy.trans_le (le_max_right _ _))
      ((le_max_left _ _).trans (le_max_left _ _)) ((le_max_right _ _).trans (le_max_left _ _))
  · -- the indices with `κ(r(y)) ≤ r_i(y)` land on a face: `Φ(y)_i ∈ {0, 1}`
    obtain ⟨s, hs, hsκ⟩ := hκ fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)
    refine ⟨s, hs, fun i hi => ?_⟩
    rw [hΦ y i]
    exact skel (a i) (y i) _ (ha' i).1 (ha' i).2 hy (hsκ i hi)
/-- **Simon Ch. 6, Lemma 5.4** (retraction onto the `n`-skeleton), integer-translation
compatibility of the cube map `Φ(y)ᵢ = aᵢ + (yᵢ − aᵢ)/max(rᵢ(y), κ(r(y)))`, where
`rⱼ(y) = max((yⱼ − aⱼ)/(1 − aⱼ), (aⱼ − yⱼ)/aⱼ)`: if `y, y' ∈ [0, 1]ᴾ` and `y' − y ∈ ℤᴾ`, then
`Φ(y') = Φ(y) + (y' − y)`.  Each coordinate has `y'ⱼ = yⱼ` or `{yⱼ, y'ⱼ} = {0, 1}`, where
`rⱼ = 1`; so `r(y') = r(y)`, `κ(r(y)) ≤ rᵢ₀(y) ≤ 1` for some `i₀` (as `m + 1 < P`), and `Φ` is the
identity on the moved coordinates. -/
theorem Submission.dor_lmb_fcdr_cube_periodic : ∀ (P m : ℕ), m + 1 < P → ∀ a : Euclid P, (∀ i, |a i - 1 / 2| < 1 / 4) → ∀ κ : (Fin P → ℝ) → ℝ, (∀ u : Fin P → ℝ, ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, κ u ≤ u i) → ∀ Φ : Euclid P → Euclid P, (∀ (y : Euclid P) (i : Fin P), Φ y i = a i + (y i - a i) / max (max ((y i - a i) / (1 - a i)) ((a i - y i) / a i)) (κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)))) → ∀ y y' : Euclid P, (∀ i, 0 ≤ y i ∧ y i ≤ 1) → (∀ i, 0 ≤ y' i ∧ y' i ≤ 1) → (∀ i, ∃ k : ℤ, y' i - y i = k) → ∀ i, Φ y' i = Φ y i + (y' i - y i) := by
  intro P m hmP a ha κ hκ Φ hΦ y y' hy hy' hint i
  -- `0 < aⱼ < 1`
  have ha0 : ∀ j, 0 < a j := fun j => by linarith [(abs_lt.mp (ha j)).1]
  have ha1 : ∀ j, 0 < 1 - a j := fun j => by linarith [(abs_lt.mp (ha j)).2]
  -- `ρⱼ(t) = max((t − aⱼ)/(1 − aⱼ), (aⱼ − t)/aⱼ)` has `ρⱼ(0) = ρⱼ(1) = 1` and `ρⱼ ≤ 1` on `[0, 1]`
  have hρ0 : ∀ j, max ((0 - a j) / (1 - a j)) ((a j - 0) / a j) = 1 := fun j => by
    rw [sub_zero, div_self (ha0 j).ne']
    exact max_eq_right ((div_le_one (ha1 j)).mpr (by linarith))
  have hρ1 : ∀ j, max ((1 - a j) / (1 - a j)) ((a j - 1) / a j) = 1 := fun j => by
    rw [div_self (ha1 j).ne']
    exact max_eq_left ((div_le_one (ha0 j)).mpr (by linarith))
  have hρle : ∀ j, max ((y j - a j) / (1 - a j)) ((a j - y j) / a j) ≤ 1 := fun j =>
    max_le ((div_le_one (ha1 j)).mpr (by linarith [(hy j).2]))
      ((div_le_one (ha0 j)).mpr (by linarith [(hy j).1]))
  -- `y'ⱼ − yⱼ ∈ ℤ ∩ [−1, 1]`, so `y'ⱼ = yⱼ` or `{yⱼ, y'ⱼ} = {0, 1}`
  have hcase : ∀ j, y' j = y j ∨ (y j = 0 ∧ y' j = 1) ∨ (y j = 1 ∧ y' j = 0) := by
    intro j
    obtain ⟨k, hk⟩ := hint j
    obtain ⟨h₀, h₁⟩ := hy j
    obtain ⟨h₀', h₁'⟩ := hy' j
    have hk1 : k ≤ 1 := by
      have : (k : ℝ) ≤ 1 := by linarith
      exact_mod_cast this
    have hk2 : -1 ≤ k := by
      have : (-1 : ℝ) ≤ k := by linarith
      exact_mod_cast this
    rcases (show k = -1 ∨ k = 0 ∨ k = 1 by omega) with rfl | rfl | rfl <;> push_cast at hk
    · exact Or.inr (Or.inr ⟨by linarith, by linarith⟩)
    · exact Or.inl (by linarith)
    · exact Or.inr (Or.inl ⟨by linarith, by linarith⟩)
  -- hence `r(y') = r(y)` and `κ(r(y')) = κ(r(y))`
  have hr : ∀ j, max ((y' j - a j) / (1 - a j)) ((a j - y' j) / a j)
      = max ((y j - a j) / (1 - a j)) ((a j - y j) / a j) := by
    intro j
    rcases hcase j with h | ⟨h0, h1⟩ | ⟨h0, h1⟩
    · rw [h]
    · rw [h0, h1, hρ0 j, hρ1 j]
    · rw [h0, h1, hρ0 j, hρ1 j]
  have hκeq : κ (fun j => max ((y' j - a j) / (1 - a j)) ((a j - y' j) / a j))
      = κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)) :=
    congrArg κ (funext hr)
  -- `κ(r(y)) ≤ 1`: `s` is nonempty as `P ≤ m + 1 + |s|` and `m + 1 < P`
  have hκle : κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)) ≤ 1 := by
    obtain ⟨s, hs, hsκ⟩ := hκ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j))
    have hne : s.Nonempty := Finset.card_pos.mp (by omega)
    obtain ⟨i₀, hi₀⟩ := hne
    exact (hsκ i₀ hi₀).trans (hρle i₀)
  -- coordinates with `y'ᵢ = yᵢ` agree; on `{yᵢ, y'ᵢ} = {0, 1}`, `max(rᵢ, κ) = 1` and `Φ` fixes `yᵢ`
  rw [hΦ y' i, hΦ y i, hκeq, hr i]
  rcases hcase i with h | ⟨h0, h1⟩ | ⟨h0, h1⟩
  · rw [h]
    ring
  · rw [h0, h1, hρ0 i, max_eq_left hκle]
    ring
  · rw [h0, h1, hρ1 i, max_eq_left hκle]
    ring
/-- **Claim B** (Simon Ch. 6, Lemma 5.4, step 6 of the corrected closed-form proof: Lipschitz bound
for the cube retraction `Φ`).  Let `|aᵢ − 1/2| < 1/4`, let `κ` be `1`-Lipschitz for the sup norm,
`rⱼ(y) = max((yⱼ − aⱼ)/(1 − aⱼ), (aⱼ − yⱼ)/aⱼ)` and `Φ(y)ᵢ = aᵢ + (yᵢ − aᵢ)/max(rᵢ(y), κ(r(y)))`.
If `κ(r(y)) > 0` then `|Φ(y) − Φ(y')| ≤ 4√P |y − y'| / κ(r(y))`: each `rⱼ` is `4`-Lipschitz, so the
denominators `μ = max(rᵢ(y), κ(r(y)))` and `μ'` differ by at most `4|y − y'|`; `|y'ᵢ − aᵢ| ≤ (3/4)μ'`,
and `u/μ − u'/μ' = (u − u')/μ + (u'/μ')(μ' − μ)/μ` bounds each coordinate by
`4|y − y'|/κ(r(y))`. -/
theorem Submission.dor_lmb_fcdr_cube_lipschitz : ∀ (P : ℕ) (a : Euclid P), (∀ i, |a i - 1 / 2| < 1 / 4) → ∀ κ : (Fin P → ℝ) → ℝ, (∀ u v : Fin P → ℝ, ∀ t : ℝ, (∀ i, |u i - v i| ≤ t) → |κ u - κ v| ≤ t) → ∀ Φ : Euclid P → Euclid P, (∀ (y : Euclid P) (i : Fin P), Φ y i = a i + (y i - a i) / max (max ((y i - a i) / (1 - a i)) ((a i - y i) / a i)) (κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)))) → ∀ y y' : Euclid P, 0 < κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)) → dist (Φ y) (Φ y') ≤ 4 * Real.sqrt P / κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)) * dist y y' := by
  intro P a ha κ hκ Φ hΦ y y' hk
  -- Step 1: `1/4 < aᵢ < 3/4`, and `|yⱼ − y'ⱼ| ≤ dist y y'`
  have a_bounds : ∀ c : ℝ, |c - 1 / 2| < 1 / 4 → 1 / 4 < c ∧ c < 3 / 4 := fun c hc => by
    rcases abs_lt.mp hc with ⟨h1, h2⟩
    constructor <;> linarith
  have hcoord : ∀ j, |y j - y' j| ≤ dist y y' := fun j => by
    have := PiLp.dist_apply_le y y' j
    rwa [Real.dist_eq] at this
  -- Step 2: `rⱼ` is `4`-Lipschitz in `yⱼ`, so `|κ(r(y)) − κ(r(y'))| ≤ 4 dist y y'`
  have div_lip : ∀ s x x' δ : ℝ, 1 / 4 < s → |x - x'| ≤ δ → |x / s - x' / s| ≤ 4 * δ := by
    intro s x x' δ hs h
    have hs0 : (0 : ℝ) < s := by linarith
    have hδ : 0 ≤ δ := le_trans (abs_nonneg _) h
    rw [← sub_div, abs_div, abs_of_pos hs0, div_le_iff₀ hs0]
    nlinarith [mul_nonneg hδ (by linarith : (0 : ℝ) ≤ 4 * s - 1)]
  have r_lip : ∀ c b b' δ : ℝ, |c - 1 / 2| < 1 / 4 → |b - b'| ≤ δ →
      |max ((b - c) / (1 - c)) ((c - b) / c) - max ((b' - c) / (1 - c)) ((c - b') / c)|
        ≤ 4 * δ := by
    intro c b b' δ hc h
    obtain ⟨hc1, hc2⟩ := a_bounds c hc
    refine le_trans (abs_max_sub_max_le_max _ _ _ _) (max_le ?_ ?_)
    · apply div_lip _ _ _ _ (by linarith)
      rwa [sub_sub_sub_cancel_right]
    · apply div_lip _ _ _ _ hc1
      rw [sub_sub_sub_cancel_left, abs_sub_comm]
      exact h
  have hkk : |κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j))
      - κ (fun j => max ((y' j - a j) / (1 - a j)) ((a j - y' j) / a j))| ≤ 4 * dist y y' :=
    hκ _ _ _ (fun j => r_lip _ _ _ _ (ha j) (hcoord j))
  -- Step 3: `|b − c| ≤ (3/4) r(b)`; in particular `r(b) ≥ 0`, and `r(b) = 0` forces `b = c`
  have abs_le_r : ∀ c b : ℝ, |c - 1 / 2| < 1 / 4 →
      |b - c| ≤ 3 / 4 * max ((b - c) / (1 - c)) ((c - b) / c) := by
    intro c b hc
    obtain ⟨hc1, hc2⟩ := a_bounds c hc
    have h1c : (0 : ℝ) < 1 - c := by linarith
    have hc0 : (0 : ℝ) < c := by linarith
    rcases le_total c b with h | h
    · rw [abs_of_nonneg (sub_nonneg.mpr h)]
      have hq : 0 ≤ (b - c) / (1 - c) := div_nonneg (sub_nonneg.mpr h) h1c.le
      have he : (b - c) / (1 - c) * (1 - c) = b - c := div_mul_cancel₀ _ h1c.ne'
      have hm := le_max_left ((b - c) / (1 - c)) ((c - b) / c)
      nlinarith [mul_nonneg hq (by linarith : (0 : ℝ) ≤ c - 1 / 4)]
    · rw [abs_of_nonpos (sub_nonpos.mpr h)]
      have hq : 0 ≤ (c - b) / c := div_nonneg (sub_nonneg.mpr h) hc0.le
      have he : (c - b) / c * c = c - b := div_mul_cancel₀ _ hc0.ne'
      have hm := le_max_right ((b - c) / (1 - c)) ((c - b) / c)
      nlinarith [mul_nonneg hq (by linarith : (0 : ℝ) ≤ 3 / 4 - c)]
  -- Step 4: `|u/μ − u'/μ'| ≤ 4δ/μ`
  have key : ∀ u u' μ μ' δ : ℝ, 0 < μ → 0 ≤ μ' → |u'| ≤ 3 / 4 * μ' → |u - u'| ≤ δ →
      |μ - μ'| ≤ 4 * δ → |u / μ - u' / μ'| ≤ 4 * δ / μ := by
    intro u u' μ μ' δ hμ hμ'0 hu' huu hμμ
    have hX : u / μ * μ = u := div_mul_cancel₀ u hμ.ne'
    have hX' : u' / μ' * μ' = u' ∧ |u' / μ'| ≤ 3 / 4 := by
      rcases hμ'0.eq_or_lt with h | h
      · -- (b) `μ' = 0` forces `u' = 0`
        subst h
        have hu0 : u' = 0 := abs_nonpos_iff.mp (by linarith)
        subst hu0
        norm_num
      · -- (a) `μ' > 0` gives `|u'|/μ' ≤ 3/4`
        refine ⟨div_mul_cancel₀ u' h.ne', ?_⟩
        rw [abs_div, abs_of_pos h, div_le_iff₀ h]
        exact hu'
    rw [le_div_iff₀ hμ]
    have hsplit : (u / μ - u' / μ') * μ = (u - u') - u' / μ' * (μ - μ') := by
      linear_combination hX - hX'.1
    have habs : |u / μ - u' / μ'| * μ = |(u / μ - u' / μ') * μ| := by
      rw [abs_mul, abs_of_pos hμ]
    rw [habs, hsplit]
    have h1 : |u' / μ' * (μ - μ')| ≤ 3 / 4 * (4 * δ) := by
      rw [abs_mul]
      exact mul_le_mul hX'.2 hμμ (abs_nonneg _) (by norm_num)
    have h2 := abs_le.mp h1
    have h3 := abs_le.mp huu
    rw [abs_le]
    constructor <;> linarith [h2.1, h2.2, h3.1, h3.2]
  -- Steps 3–5 for one coordinate: `|Φ(y)ᵢ − Φ(y')ᵢ| ≤ 4δ/κ(r(y))`
  have coord_bound : ∀ c b b' k k' δ : ℝ, |c - 1 / 2| < 1 / 4 → 0 < k → |b - b'| ≤ δ →
      |k - k'| ≤ 4 * δ →
      |(c + (b - c) / max (max ((b - c) / (1 - c)) ((c - b) / c)) k) -
        (c + (b' - c) / max (max ((b' - c) / (1 - c)) ((c - b') / c)) k')| ≤ 4 * δ / k := by
    intro c b b' k k' δ hc hk hbb hkk
    have hδ : 0 ≤ δ := le_trans (abs_nonneg _) hbb
    have hr' : |b' - c| ≤ 3 / 4 * max ((b' - c) / (1 - c)) ((c - b') / c) := abs_le_r c b' hc
    have hr'0 : 0 ≤ max ((b' - c) / (1 - c)) ((c - b') / c) := by
      have := abs_nonneg (b' - c)
      linarith
    have hμk : k ≤ max (max ((b - c) / (1 - c)) ((c - b) / c)) k := le_max_right _ _
    have hμ : 0 < max (max ((b - c) / (1 - c)) ((c - b) / c)) k := lt_of_lt_of_le hk hμk
    have hμ' : max ((b' - c) / (1 - c)) ((c - b') / c)
        ≤ max (max ((b' - c) / (1 - c)) ((c - b') / c)) k' := le_max_left _ _
    have huu : |(b - c) - (b' - c)| ≤ δ := by
      rw [sub_sub_sub_cancel_right]
      exact hbb
    have hμμ : |max (max ((b - c) / (1 - c)) ((c - b) / c)) k
        - max (max ((b' - c) / (1 - c)) ((c - b') / c)) k'| ≤ 4 * δ :=
      le_trans (abs_max_sub_max_le_max _ _ _ _) (max_le (r_lip c b b' δ hc hbb) hkk)
    have hu' : |b' - c| ≤ 3 / 4 * max (max ((b' - c) / (1 - c)) ((c - b') / c)) k' := by
      linarith
    rw [add_sub_add_left_eq_sub]
    exact le_trans (key _ _ _ _ _ hμ (le_trans hr'0 hμ') hu' huu hμμ)
      (div_le_div_of_nonneg_left (by linarith) hk hμk)
  have hi : ∀ i, |Φ y i - Φ y' i|
      ≤ 4 * dist y y' / κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)) := by
    intro i
    rw [hΦ y i, hΦ y' i]
    exact coord_bound _ _ _ _ _ _ (ha i) hk (hcoord i) hkk
  -- Step 5: sum the squares over the `P` coordinates
  rw [EuclideanSpace.dist_eq]
  calc Real.sqrt (∑ i, dist (Φ y i) (Φ y' i) ^ 2)
      ≤ Real.sqrt (∑ _i : Fin P,
          (4 * dist y y' / κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j))) ^ 2) := by
        apply Real.sqrt_le_sqrt
        apply Finset.sum_le_sum
        intro i _
        rw [Real.dist_eq]
        exact pow_le_pow_left₀ (abs_nonneg _) (hi i) 2
    _ = 4 * Real.sqrt P / κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j))
          * dist y y' := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
          Real.sqrt_mul (Nat.cast_nonneg _),
          Real.sqrt_sq (div_nonneg (by positivity) hk.le)]
        ring
/-- **Lipschitz on every closed unit grid cube implies Lipschitz along segments** (Simon Ch. 6,
5.4, closed-form retraction, step 7(i)).  If `|f x − f y| ≤ K |x − y|` whenever `x, y ∈ S` lie in
a common closed cube `z + [0, 1]ᴾ` (`z ∈ ℤᴾ`), then `|f x − f y| ≤ K |x − y|` whenever
`[x, y] ⊆ S`.  With `γ(t) = x + t (y − x)`, the parameters `t ∈ [0, 1]` at which a non-constant
coordinate `γᵢ(t)` is an integer, together with `0` and `1`, are finitely many,
`0 = t₀ < ⋯ < t_N = 1`.  Between consecutive breakpoints no coordinate crosses an integer, so
`γ(t_k)` and `γ(t_{k+1})` lie in the cube `⌊γ(s)⌋ + [0, 1]ᴾ`, `s = (t_k + t_{k+1})/2`; the cube
estimates `K (t_{k+1} − t_k) |x − y|` telescope along the triangle inequality to `K |x − y|`. -/
theorem Submission.dor_lmb_fcdr_grid_segment : ∀ (P : ℕ) (f : Euclid P → Euclid P) (S : Set (Euclid P)) (K : ℝ), 0 ≤ K → (∀ (z : Fin P → ℤ) (x y : Euclid P), x ∈ S → y ∈ S → (∀ i, (z i : ℝ) ≤ x i ∧ x i ≤ z i + 1) → (∀ i, (z i : ℝ) ≤ y i ∧ y i ≤ z i + 1) → dist (f x) (f y) ≤ K * dist x y) → ∀ x y : Euclid P, segment ℝ x y ⊆ S → dist (f x) (f y) ≤ K * dist x y := by
  intro P f S K hK hcube x y hseg
  -- Step 1: `γ t = x + t (y − x)`, `t ∈ [0, 1]`, parametrises `[x, y] ⊆ S`, and
  -- `|γ a − γ b| = |a − b| |x − y|`
  let γ : ℝ → Euclid P := fun t => x + t • (y - x)
  have hγi : ∀ t i, γ t i = x i + t * (y i - x i) := fun t i => by simp [γ]
  have hγS : ∀ t, 0 ≤ t → t ≤ 1 → γ t ∈ S := fun t h0 h1 =>
    hseg (by rw [segment_eq_image']; exact ⟨t, ⟨h0, h1⟩, rfl⟩)
  have hγdist : ∀ a b, dist (γ a) (γ b) = |a - b| * dist x y := by
    intro a b
    have h : γ a - γ b = (a - b) • (y - x) := by
      simp only [γ]; rw [add_sub_add_left_eq_sub, sub_smul]
    rw [dist_eq_norm (γ a) (γ b), h, norm_smul, Real.norm_eq_abs, ← dist_eq_norm y x,
      dist_comm y x]
  have hγ0 : γ 0 = x := by simp [γ]
  have hγ1 : γ 1 = y := by simp [γ]
  -- Step 2: the breakpoints `T ⊆ [0, 1]`: `0`, `1` and every `t` with `γᵢ(t) = m ∈ ℤ`,
  -- `xᵢ ≠ yᵢ`, i.e. `t = (m − xᵢ)/(yᵢ − xᵢ)` with `m ∈ [⌊min(xᵢ, yᵢ)⌋, ⌈max(xᵢ, yᵢ)⌉]` (for
  -- `xᵢ = yᵢ` this quotient is `0 ∈ T`) ...
  let B : Finset ℝ := Finset.univ.biUnion fun i : Fin P =>
    (Finset.Icc ⌊min (x i) (y i)⌋ ⌈max (x i) (y i)⌉).image fun m : ℤ =>
      ((m : ℝ) - x i) / (y i - x i)
  let T : Finset ℝ := (insert 0 (insert 1 B)).filter fun t => 0 ≤ t ∧ t ≤ 1
  have hmemT : ∀ u, u ∈ T ↔ (u = 0 ∨ u = 1 ∨ u ∈ B) ∧ 0 ≤ u ∧ u ≤ 1 := fun u =>
    Finset.mem_filter.trans <|
      and_congr_left' (Finset.mem_insert.trans (or_congr_right Finset.mem_insert))
  have hmemB : ∀ (i : Fin P) (m : ℤ), min (x i) (y i) < m → (m : ℝ) < max (x i) (y i) →
      ((m : ℝ) - x i) / (y i - x i) ∈ B := fun i m h1 h2 =>
    Finset.mem_biUnion.2 ⟨i, Finset.mem_univ i, Finset.mem_image.2 ⟨m,
      Finset.mem_Icc.2 ⟨Int.floor_le_iff.2 (by linarith), Int.le_ceil_iff.2 (by linarith)⟩, rfl⟩⟩
  have hT : ∀ u ∈ T, 0 ≤ u ∧ u ≤ 1 := fun u hu => ((hmemT u).1 hu).2
  have h0T : (0 : ℝ) ∈ T := (hmemT 0).2 ⟨Or.inl rfl, le_rfl, zero_le_one⟩
  have h1T : (1 : ℝ) ∈ T := (hmemT 1).2 ⟨Or.inr (Or.inl rfl), zero_le_one, le_rfl⟩
  -- ... listed increasingly as `0 = t 0 < t 1 < ⋯ < t N = 1`, `N = card T − 1`
  have hcard : 2 ≤ T.card := by
    have h := Finset.card_le_card (show ({0, 1} : Finset ℝ) ⊆ T by
      intro u hu
      rcases Finset.mem_insert.1 hu with rfl | hu
      · exact h0T
      · rw [Finset.mem_singleton.1 hu]; exact h1T)
    rwa [Finset.card_pair zero_ne_one] at h
  let e := T.orderEmbOfFin rfl
  let t : ℕ → ℝ := fun k => if h : k < T.card then e ⟨k, h⟩ else 1
  let N := T.card - 1
  have h0 : 0 < T.card := lt_of_lt_of_le two_pos hcard
  have hNlt : N < T.card := Nat.sub_lt h0 one_pos
  have ht0 : t 0 = 0 := by
    have : t 0 = e ⟨0, h0⟩ := dite_eq_left h0
    rw [this, Finset.orderEmbOfFin_zero rfl h0]
    exact le_antisymm (Finset.min'_le T 0 h0T) (Finset.le_min' T _ 0 fun u hu => (hT u hu).1)
  have htN : t N = 1 := by
    have : t N = e ⟨T.card - 1, hNlt⟩ := dite_eq_left hNlt
    rw [this, Finset.orderEmbOfFin_last rfl h0]
    exact le_antisymm (Finset.max'_le T _ 1 fun u hu => (hT u hu).2) (Finset.le_max' T 1 h1T)
  -- `t k < t (k + 1)` are consecutive breakpoints
  have hstep : ∀ k < N, t k ∈ T ∧ t (k + 1) ∈ T ∧ t k < t (k + 1) ∧
      ∀ u ∈ T, ¬(t k < u ∧ u < t (k + 1)) := by
    intro k hk
    have hk1 : k < T.card := hk.trans hNlt
    have hk2 : k + 1 < T.card := Nat.add_lt_of_lt_sub hk
    have htk : t k = e ⟨k, hk1⟩ := dite_eq_left hk1
    have htk' : t (k + 1) = e ⟨k + 1, hk2⟩ := dite_eq_left hk2
    rw [htk, htk']
    refine ⟨T.orderEmbOfFin_mem rfl _, T.orderEmbOfFin_mem rfl _,
      e.strictMono (Fin.mk_lt_mk.2 k.lt_succ_self), ?_⟩
    rintro u hu ⟨h1, h2⟩
    have hu' : u ∈ Set.range e := by rw [Finset.range_orderEmbOfFin]; exact hu
    obtain ⟨j, rfl⟩ := hu'
    have h1' : k < j.val := Fin.lt_def.1 (e.lt_iff_lt.1 h1)
    have h2' : j.val < k + 1 := Fin.lt_def.1 (e.lt_iff_lt.1 h2)
    exact absurd h1' (not_lt.2 (Nat.lt_add_one_iff.1 h2'))
  -- Step 3: if no breakpoint lies strictly between `a < b`, no coordinate of `γ` passes strictly
  -- across an integer `m` on `[a, b]`: otherwise `(m − xᵢ)/(yᵢ − xᵢ)` would be such a breakpoint
  have hcross : ∀ a b, 0 ≤ a → b ≤ 1 → a < b → (∀ u ∈ T, ¬(a < u ∧ u < b)) →
      ∀ (i : Fin P) (m : ℤ), ¬(γ a i < m ∧ (m : ℝ) < γ b i) ∧ ¬(γ b i < m ∧ (m : ℝ) < γ a i) := by
    intro a b ha hb hab hgap i m
    have hbreak : a < ((m : ℝ) - x i) / (y i - x i) → ((m : ℝ) - x i) / (y i - x i) < b →
        min (x i) (y i) < m → (m : ℝ) < max (x i) (y i) → False := fun h1 h2 h3 h4 =>
      hgap _ ((hmemT _).2 ⟨Or.inr (Or.inr (hmemB i m h3 h4)), by linarith, by linarith⟩) ⟨h1, h2⟩
    simp only [hγi]
    constructor
    · rintro ⟨h1, h2⟩
      have hd : 0 < y i - x i := not_le.1 fun hd =>
        by linarith [mul_le_mul_of_nonpos_right hab.le hd]
      exact hbreak ((lt_div_iff₀ hd).2 (by linarith)) ((div_lt_iff₀ hd).2 (by linarith))
        (by linarith [min_le_left (x i) (y i), mul_nonneg ha hd.le])
        (by linarith [le_max_right (x i) (y i), mul_le_of_le_one_left hd.le hb])
    · rintro ⟨h1, h2⟩
      have hd : y i - x i < 0 := not_le.1 fun hd =>
        by linarith [mul_le_mul_of_nonneg_right hab.le hd]
      exact hbreak ((lt_div_iff_of_neg hd).2 (by linarith)) ((div_lt_iff_of_neg hd).2 (by linarith))
        (by linarith [min_le_right (x i) (y i), mul_nonneg (sub_nonneg.2 hb) (neg_nonneg.2 hd.le)])
        (by linarith [le_max_left (x i) (y i), mul_nonneg ha (neg_nonneg.2 hd.le)])
  -- Steps 3–4: each piece `γ(t k), γ(t (k + 1))` lies in the closed cube `z + [0, 1]ᴾ`,
  -- `z = ⌊γ(midpoint)⌋`, so the cube estimate bounds it by `K (t (k + 1) − t k) |x − y|`
  have key : ∀ k < N,
      dist (f (γ (t k))) (f (γ (t (k + 1)))) ≤ K * dist x y * (t (k + 1) - t k) := by
    intro k hk
    obtain ⟨haT, hbT, hab, hgap⟩ := hstep k hk
    set a := t k
    set b := t (k + 1)
    obtain ⟨ha0, ha1⟩ := hT a haT
    obtain ⟨hb0, hb1⟩ := hT b hbT
    let z : Fin P → ℤ := fun i => ⌊γ ((a + b) / 2) i⌋
    have hz : ∀ i, ((z i : ℝ) ≤ γ a i ∧ γ a i ≤ z i + 1) ∧
        ((z i : ℝ) ≤ γ b i ∧ γ b i ≤ z i + 1) := by
      intro i
      have hmid : γ ((a + b) / 2) i = (γ a i + γ b i) / 2 := by rw [hγi, hγi, hγi]; ring
      have hz1 : (z i : ℝ) ≤ (γ a i + γ b i) / 2 := hmid ▸ Int.floor_le _
      have hz2 : (γ a i + γ b i) / 2 < z i + 1 := hmid ▸ Int.lt_floor_add_one _
      obtain ⟨hc1, hc2⟩ := hcross a b ha0 hb1 hab hgap i (z i)
      obtain ⟨hd1, hd2⟩ := hcross a b ha0 hb1 hab hgap i (z i + 1)
      rw [Int.cast_add, Int.cast_one] at hd1 hd2
      exact ⟨⟨not_lt.1 fun h => hc1 ⟨h, by linarith⟩, not_lt.1 fun h => hd2 ⟨by linarith, h⟩⟩,
        not_lt.1 fun h => hc2 ⟨h, by linarith⟩, not_lt.1 fun h => hd1 ⟨by linarith, h⟩⟩
    calc dist (f (γ a)) (f (γ b)) ≤ K * dist (γ a) (γ b) :=
          hcube z (γ a) (γ b) (hγS a ha0 ha1) (hγS b hb0 hb1) (fun i => (hz i).1) fun i => (hz i).2
      _ = K * dist x y * (b - a) := by
          rw [hγdist, abs_sub_comm, abs_of_pos (sub_pos.2 hab)]; ring
  -- Step 5: triangle inequality along `γ(t 0), …, γ(t N)`, then telescoping
  calc dist (f x) (f y) = dist (f (γ (t 0))) (f (γ (t N))) := by rw [ht0, htN, hγ0, hγ1]
    _ ≤ ∑ k ∈ Finset.range N, dist (f (γ (t k))) (f (γ (t (k + 1)))) :=
        dist_le_range_sum_dist (fun k => f (γ (t k))) N
    _ ≤ ∑ k ∈ Finset.range N, K * dist x y * (t (k + 1) - t k) :=
        Finset.sum_le_sum fun k hk => key k (Finset.mem_range.1 hk)
    _ = K * dist x y * (t N - t 0) := by rw [← Finset.mul_sum, Finset.sum_range_sub]
    _ = K * dist x y := by rw [ht0, htN]; ring
/-- **Simon Ch. 6, Lemma 5.4** (retraction onto the `n`-skeleton, `n = m + 1 < P`; the printed
construction, with the derivative bound proved directly).  Let `|aᵢ − 1/2| < 1/4`, `L*(a)` the set
of points with at least `m + 2` coordinates in `aᵢ + ℤ`, `rⱼ(y) = max((yⱼ − aⱼ)/(1 − aⱼ),
(aⱼ − yⱼ)/aⱼ)`, `κ` the `ℓ`-th largest entry (`ℓ = P − (m + 1)`),
`Φ(y)ᵢ = aᵢ + (yᵢ − aᵢ)/max(rᵢ(y), κ(r(y)))` the closed form of the composed radial retractions of
`[0, 1]ᴾ`, and `ψ(x) = ⌊x⌋ + Φ(x − ⌊x⌋)`.  Off `L*(a)`, `κ(r(x − ⌊x⌋)) > 0` (Claim C), so `ψ(x)`
has `ℓ` integer coordinates and `|ψ(x) − x| ≤ √P`.  On a grid cube `z + [0, 1]ᴾ`,
`ψ = z + Φ(· − z)` by periodicity, and Claims B and C bound its Lipschitz constant on
`{dist(·, L*(a)) ≥ r/2}` by `4√P/κ ≤ 2c₁/r`, `c₁ = 4√P √(m + 2)`.  If `|x − y| < r`, the segment
`[x, y]` stays in `{dist(·, L*(a)) ≥ r/2}` and cutting it at the grid gives `(2c₁/r)|x − y|`; if
`|x − y| ≥ r`, then `|ψ(x) − ψ(y)| ≤ |x − y| + 2√P ≤ ((1/4 + 2√P)/r)|x − y|`.  So
`c = 2c₁ + 2√P + 1/4` works. -/
theorem Submission.dor_lmb_fcd_retraction : ∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 0 < c ∧ ∀ a : Euclid P, (∀ i, |a i - 1 / 2| < 1 / 4) → ∃ ψ : Euclid P → Euclid P, (∀ x : Euclid P, 0 < infDist x {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} → (∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, ψ x i = z) ∧ dist (ψ x) x ≤ Real.sqrt P) ∧ ∀ r : ℝ, 0 < r → r ≤ 1 / 4 → ∀ x y : Euclid P, r ≤ infDist x {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} → r ≤ infDist y {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} → dist (ψ x) (ψ y) ≤ c / r * dist x y := by
  intro P m hmP
  -- Step 2: `κ`, the `ℓ`-th largest entry, `ℓ = P − (m + 1)`
  obtain ⟨κ, hκ1, hκ2, hκ3⟩ := Submission.dor_lmb_fcdr_order_stat P m hmP
  -- `c = 2c₁ + 2√P + 1/4 ≥ max(2c₁, 1/4 + 2√P)`, `c₁ = 4√P √(m + 2)`
  refine ⟨8 * Real.sqrt P * Real.sqrt (m + 2) + 2 * Real.sqrt P + 1 / 4, by positivity,
    fun a ha => ?_⟩
  set L : Set (Euclid P) := {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧
    ∀ i ∈ s, ∃ z : ℤ, w i - a i = z}
  have hsP := Real.sqrt_nonneg (P : ℝ)
  have hsm := Real.sqrt_nonneg ((m : ℝ) + 2)
  -- Step 3: the closed-form cube map `Φ`
  let Φ : Euclid P → Euclid P := fun y => WithLp.toLp 2 fun i => a i + (y i - a i) /
    max (max ((y i - a i) / (1 - a i)) ((a i - y i) / a i))
      (κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)))
  have hΦ : ∀ (y : Euclid P) (i : Fin P), Φ y i = a i + (y i - a i) /
      max (max ((y i - a i) / (1 - a i)) ((a i - y i) / a i))
        (κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j))) := fun _ _ => rfl
  -- integer points `z ∈ ℤᴾ` of `ℝᴾ`, and Step 5: `ψ(x) = ⌊x⌋ + Φ(x − ⌊x⌋)`
  let zv : (Fin P → ℤ) → Euclid P := fun z => WithLp.toLp 2 fun i => (z i : ℝ)
  let ψ : Euclid P → Euclid P := fun x => zv (fun j => ⌊x j⌋) + Φ (x - zv (fun j => ⌊x j⌋))
  have hψ : ∀ x i, ψ x i = ⌊x i⌋ + Φ (x - zv (fun j => ⌊x j⌋)) i := fun _ _ => rfl
  have hint : ∀ (z : Fin P → ℤ) (x : Euclid P) (i : Fin P), ∃ k : ℤ, x i - (x - zv z) i = k :=
    fun z x i => ⟨z i, show x i - (x i - z i) = z i by ring⟩
  -- Claim C: `dist(x, L*(a)) ≤ √(m + 2) κ(r(y))` if `x − y ∈ ℤᴾ`; so `κ(r(y)) > 0` off `L*(a)`
  have hdual : ∀ x y : Euclid P, (∀ i, ∃ k : ℤ, x i - y i = k) →
      infDist x L ≤ Real.sqrt (m + 2) *
        κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)) :=
    Submission.dor_lmb_fcdr_dual_dist P m a ha κ hκ2
  have hκpos : ∀ x y : Euclid P, (∀ i, ∃ k : ℤ, x i - y i = k) → 0 < infDist x L →
      0 < κ (fun j => max ((y j - a j) / (1 - a j)) ((a j - y j) / a j)) := by
    intro x y hxy hx
    by_contra hneg
    have h := mul_nonpos_of_nonneg_of_nonpos hsm (not_lt.1 hneg)
    linarith [hdual x y hxy]
  -- Step 5: on a grid cube `z + [0, 1]ᴾ`, `ψ = z + Φ(· − z)` (periodicity of `Φ`)
  have hψcube : ∀ (z : Fin P → ℤ) (x : Euclid P), (∀ i, (z i : ℝ) ≤ x i ∧ x i ≤ z i + 1) →
      ψ x = zv z + Φ (x - zv z) := by
    intro z x hx
    have hper := Submission.dor_lmb_fcdr_cube_periodic P m hmP a ha κ hκ1 Φ hΦ
      (x - zv (fun j => ⌊x j⌋)) (x - zv z)
      (fun j => show 0 ≤ x j - ⌊x j⌋ ∧ x j - ⌊x j⌋ ≤ 1 from
        ⟨by linarith [Int.floor_le (x j)], by linarith [Int.lt_floor_add_one (x j)]⟩)
      (fun j => show 0 ≤ x j - z j ∧ x j - z j ≤ 1 from
        ⟨by linarith [(hx j).1], by linarith [(hx j).2]⟩)
      (fun j => ⟨⌊x j⌋ - z j, show (x j - z j) - (x j - ⌊x j⌋) = ((⌊x j⌋ - z j : ℤ) : ℝ) by
        push_cast; ring⟩)
    ext i
    show (⌊x i⌋ : ℝ) + Φ (x - zv (fun j => ⌊x j⌋)) i = z i + Φ (x - zv z) i
    rw [hper i]
    show (⌊x i⌋ : ℝ) + Φ (x - zv (fun j => ⌊x j⌋)) i
      = z i + (Φ (x - zv (fun j => ⌊x j⌋)) i + ((x i - z i) - (x i - ⌊x i⌋)))
    ring
  -- Step 5: the first conclusion
  have hfirst : ∀ x : Euclid P, 0 < infDist x L →
      (∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, ψ x i = z) ∧
        dist (ψ x) x ≤ Real.sqrt P := by
    intro x hx
    obtain ⟨h01, s, hs, hs01⟩ := Submission.dor_lmb_fcdr_cube_skeleton P m a ha κ hκ1 Φ hΦ
      (x - zv (fun j => ⌊x j⌋)) (hκpos x _ (hint _ x) hx)
    refine ⟨⟨s, hs, fun i hi => ?_⟩, ?_⟩
    · -- `Φ(x − ⌊x⌋)ᵢ ∈ {0, 1}` on `s`
      rcases hs01 i hi with h | h
      · exact ⟨⌊x i⌋, by rw [hψ, h, add_zero]⟩
      · exact ⟨⌊x i⌋ + 1, by rw [hψ, h]; push_cast; ring⟩
    · -- `|ψ(x)ᵢ − xᵢ| = |Φ(x − ⌊x⌋)ᵢ − (xᵢ − ⌊xᵢ⌋)| ≤ 1`
      rw [EuclideanSpace.dist_eq]
      apply Real.sqrt_le_sqrt
      calc ∑ i, dist (ψ x i) (x i) ^ 2 ≤ ∑ _i : Fin P, (1 : ℝ) := by
            refine Finset.sum_le_sum fun i _ => ?_
            have h1 := h01 i
            have h2 := Int.floor_le (x i)
            have h3 := Int.lt_floor_add_one (x i)
            have h5 : |ψ x i - x i| ≤ 1 := by
              rw [hψ, abs_le]
              constructor <;> linarith [h1.1, h1.2]
            rw [Real.dist_eq]
            calc |ψ x i - x i| ^ 2 ≤ 1 ^ 2 := pow_le_pow_left₀ (abs_nonneg _) h5 2
              _ = 1 := one_pow 2
        _ = P := by
            rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, mul_one]
  -- Claims B and C on a grid cube: `|ψ(p) − ψ(q)| ≤ (4√P/κ) |p − q| ≤ (c/r) |p − q|` when
  -- `dist(p, L*(a)) ≥ r/2`
  have hcubeLip : ∀ r : ℝ, 0 < r → ∀ (z : Fin P → ℤ) (p q : Euclid P), r / 2 ≤ infDist p L →
      (∀ i, (z i : ℝ) ≤ p i ∧ p i ≤ z i + 1) → (∀ i, (z i : ℝ) ≤ q i ∧ q i ≤ z i + 1) →
      dist (ψ p) (ψ q) ≤
        (8 * Real.sqrt P * Real.sqrt (m + 2) + 2 * Real.sqrt P + 1 / 4) / r * dist p q := by
    intro r hr z p q hp hpz hqz
    have hk := hκpos p (p - zv z) (hint z p) (by linarith)
    have hd := hdual p (p - zv z) (hint z p)
    have hB := Submission.dor_lmb_fcdr_cube_lipschitz P a ha κ hκ3 Φ hΦ (p - zv z) (q - zv z) hk
    rw [dist_sub_right p q (zv z)] at hB
    rw [hψcube z p hpz, hψcube z q hqz, dist_add_left]
    refine hB.trans (mul_le_mul_of_nonneg_right ?_ dist_nonneg)
    -- `4√P/κ ≤ 8√P√(m + 2)/r ≤ c/r`, as `r ≤ 2√(m + 2) κ`
    have key : ∀ k : ℝ, 0 < k → r / 2 ≤ Real.sqrt (m + 2) * k →
        4 * Real.sqrt P / k ≤
          (8 * Real.sqrt P * Real.sqrt (m + 2) + 2 * Real.sqrt P + 1 / 4) / r := by
      intro k hk hrk
      rw [div_le_div_iff₀ hk hr]
      nlinarith [mul_nonneg hsP (by linarith : (0 : ℝ) ≤ 2 * (Real.sqrt (m + 2) * k) - r),
        mul_nonneg (by positivity : (0 : ℝ) ≤ 2 * Real.sqrt P + 1 / 4) hk.le]
    exact key _ hk (hp.trans hd)
  -- `[x, y] ⊆ ℝᴾ`: `|x − p| + |y − p| ≤ |x − y|` for `p ∈ [x, y]`
  have hseg : ∀ x y p : Euclid P, p ∈ segment ℝ x y → dist x p + dist y p ≤ dist x y := by
    intro x y p hp
    rw [segment_eq_image'] at hp
    obtain ⟨θ, ⟨hθ0, hθ1⟩, hθ⟩ := hp
    have hθ' : x + θ • (y - x) = p := hθ
    have e1 : x - p = (-θ) • (y - x) := by rw [← hθ', neg_smul]; abel
    have e2 : y - p = (1 - θ) • (y - x) := by rw [← hθ', sub_smul, one_smul]; abel
    rw [dist_eq_norm x p, dist_eq_norm y p, e1, e2, norm_smul, norm_smul, Real.norm_eq_abs,
      Real.norm_eq_abs, abs_neg, abs_of_nonneg hθ0, abs_of_nonneg (sub_nonneg.2 hθ1),
      dist_comm, dist_eq_norm]
    linarith
  refine ⟨ψ, hfirst, fun r hr hr4 x y hx hy => ?_⟩
  have hc0 : 0 ≤ (8 * Real.sqrt P * Real.sqrt (m + 2) + 2 * Real.sqrt P + 1 / 4) / r := by
    positivity
  rcases lt_or_ge (dist x y) r with hxy | hxy
  · -- Step 7(i): `|x − y| < r`, so `dist(·, L*(a)) ≥ r/2` on `[x, y]`; cut `[x, y]` at the grid
    refine Submission.dor_lmb_fcdr_grid_segment P ψ {p | r / 2 ≤ infDist p L} _ hc0
      (fun z p q hp _ hpz hqz => hcubeLip r hr z p q hp hpz hqz) x y fun p hp => ?_
    show r / 2 ≤ infDist p L
    have h1 : infDist x L ≤ infDist p L + dist x p := infDist_le_infDist_add_dist
    have h2 : infDist y L ≤ infDist p L + dist y p := infDist_le_infDist_add_dist
    linarith [hseg x y p hp]
  · -- Step 7(ii): `|x − y| ≥ r`, so `|ψ(x) − ψ(y)| ≤ |x − y| + 2√P ≤ (c/r)|x − y|`
    have h1 := (hfirst x (by linarith)).2
    have h2 := (hfirst y (by linarith)).2
    have h3 := dist_triangle4 (ψ x) x y (ψ y)
    rw [dist_comm y (ψ y)] at h3
    have hd : 0 ≤ dist x y := dist_nonneg
    calc dist (ψ x) (ψ y) ≤ dist x y + 2 * Real.sqrt P := by linarith
      _ ≤ (8 * Real.sqrt P * Real.sqrt (m + 2) + 2 * Real.sqrt P + 1 / 4) / r * dist x y := by
        rw [div_mul_eq_mul_div, le_div_iff₀ hr]
        nlinarith [mul_nonneg hsP (sub_nonneg.2 hxy),
          mul_nonneg hd (by linarith : (0 : ℝ) ≤ 1 / 4 - r), mul_nonneg (mul_nonneg hsP hsm) hd]
/-- **Tube about the shifted dual skeleton** (Simon Ch. 6, proof of 5.1, the identity before
display (6), inclusion `⊆`).  Let `L*(a)` be the set of `w` with `w_i − a_i ∈ ℤ` for at least
`m + 2` indices `i`.  It contains `a`, so `infDist x L*(a) < r` gives `w ∈ L*(a)` with
`|x − w| < r`.  Enumerate `m + 2` of the indices of `w` by `e`, and put
`z_k = w_{e(k)} − a_{e(k)} ∈ ℤ`.  Then
`Σ_k (x_{e(k)} − a_{e(k)} − z_k)² = Σ_k (x_{e(k)} − w_{e(k)})² ≤ |x − w|² < r²`. -/
theorem Submission.dor_lmb_fcd_gc_tube_cover : ∀ (P m : ℕ), m + 1 < P → ∀ (a x : Euclid P) (r : ℝ), infDist x {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} < r → ∃ e : Fin (m + 2) → Fin P, Function.Injective e ∧ ∃ z : Fin (m + 2) → ℤ, ∑ k, (x (e k) - a (e k) - z k) ^ 2 < r ^ 2 := by
  classical
  intro P m hPm a x r hx
  set L := {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z}
  -- Steps 1–2: `a ∈ L*(a)` (all `P ≥ m + 2` indices), so some `w ∈ L*(a)` has `|x − w| < r`
  have hne : L.Nonempty := ⟨a, Finset.univ, by simp; omega, fun i _ => ⟨0, by simp⟩⟩
  obtain ⟨w, ⟨s, hs, hsz⟩, hxw⟩ := (infDist_lt_iff hne).1 hx
  -- Step 3: `m + 2` of the indices in `s`, enumerated injectively by `e`
  obtain ⟨J, hJs, hJ⟩ := Finset.exists_subset_card_eq hs
  let e : Fin (m + 2) → Fin P := fun k => J.orderEmbOfFin hJ k
  have he : Function.Injective e := (J.orderEmbOfFin hJ).injective
  have hes : ∀ k, e k ∈ s := fun k => hJs (J.orderEmbOfFin_mem hJ k)
  -- Step 4: `z_k = w_{e(k)} − a_{e(k)} ∈ ℤ`
  choose z hz using fun k => hsz (e k) (hes k)
  refine ⟨e, he, z, ?_⟩
  have hterm : ∀ k, x (e k) - a (e k) - z k = x (e k) - w (e k) := fun k => by
    rw [← hz k]; ring
  -- Step 5: the `m + 2` selected squares are among the `P` nonnegative squares
  have hsub : ∑ k, (x (e k) - w (e k)) ^ 2 ≤ ∑ i, (x i - w i) ^ 2 := by
    have := Finset.sum_map Finset.univ ⟨e, he⟩ (fun i => (x i - w i) ^ 2)
    simp only [Function.Embedding.coeFn_mk] at this
    rw [← this]
    exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
      fun i _ _ => sq_nonneg _
  -- Step 6: `Σ_i (x_i − w_i)² = |x − w|²`
  have hdist : ∑ i, (x i - w i) ^ 2 = dist x w ^ 2 := by
    rw [EuclideanSpace.dist_eq, Real.sq_sqrt (Finset.sum_nonneg fun i _ => sq_nonneg _)]
    simp [Real.dist_eq, sq_abs]
  have h0 : 0 ≤ dist x w := dist_nonneg
  -- Step 7
  calc ∑ k, (x (e k) - a (e k) - z k) ^ 2 = ∑ k, (x (e k) - w (e k)) ^ 2 := by
        simp_rw [hterm]
    _ ≤ ∑ i, (x i - w i) ^ 2 := hsub
    _ = dist x w ^ 2 := hdist
    _ < r ^ 2 := by nlinarith
/-- **Simon, Ch. 6, proof of 5.1** ((1)–(4) and the summation after them: the bad set of centres
is small).  Let `ρ` be a finite measure on `ℝᵈ` and `β > 0`.  Call a centre `g` of the open cube
`(1/4, 3/4)ᵈ` bad if `β rᵈ ρ(ℝᵈ) < ρ(O_r(g))` for some `r ∈ (0, 1/4]`, where
`O_r(g) = {y : |y − g − z| < r for some z ∈ ℤᵈ}` is the open `r`-neighbourhood of `g + ℤᵈ`.  Then
the bad set has Lebesgue measure at most `10ᵈ/β`.  Vitali's covering lemma gives bad centres `b`
with pairwise disjoint sup-metric balls `B(b, r_b)` such that the balls `B(b, 3r_b)` cover the bad
set.  The sets `O_{r_b}(b)` are then pairwise disjoint as well, so `Σ_b β r_bᵈ ≤ 1`, and the
bad set has measure at most `Σ_b (6r_b)ᵈ ≤ 6ᵈ/β`. -/
theorem Submission.dor_lmb_fcd_gc_bad_set_volume : ∀ (d : ℕ) (ρ : Measure (Fin d → ℝ)), IsFiniteMeasure ρ → ∀ β : ℝ, 0 < β → volume {g : Fin d → ℝ | (∀ k, |g k - 1 / 2| < 1 / 4) ∧ ∃ r : ℝ, 0 < r ∧ r ≤ 1 / 4 ∧ ENNReal.ofReal (β * r ^ d) * ρ univ < ρ {y | ∃ z : Fin d → ℤ, ∑ k, (y k - g k - z k) ^ 2 < r ^ 2}} ≤ ENNReal.ofReal (10 ^ d / β) := by
  classical
  intro d ρ hρ β hβ
  set O : (Fin d → ℝ) → ℝ → Set (Fin d → ℝ) := fun g r =>
    {y | ∃ z : Fin d → ℤ, ∑ k, (y k - g k - z k) ^ 2 < r ^ 2} with hO
  set Bad := {g : Fin d → ℝ | (∀ k, |g k - 1 / 2| < 1 / 4) ∧ ∃ r : ℝ, 0 < r ∧ r ≤ 1 / 4 ∧
    ENNReal.ofReal (β * r ^ d) * ρ univ < ρ (O g r)}
  -- step 1: the periodic sets `O_r(g)` are open
  have hOopen : ∀ g r, IsOpen (O g r) := by
    intro g r
    have : O g r = ⋃ z : Fin d → ℤ, {y | ∑ k, (y k - g k - z k) ^ 2 < r ^ 2} := by
      ext y; simp [hO]
    rw [this]
    exact isOpen_iUnion fun z => isOpen_lt (by fun_prop) continuous_const
  -- step 2: if `ρ(ℝᵈ) = 0` the bad set is empty
  by_cases h0 : ρ univ = 0
  · have : Bad = ∅ := by
      ext g
      simp only [mem_empty_iff_false, iff_false]
      rintro ⟨-, r, -, -, hr⟩
      rw [h0, mul_zero, measure_mono_null (subset_univ _) h0] at hr
      exact lt_irrefl _ hr
    rw [this, measure_empty]
    exact bot_le
  have hfin : ρ univ ≠ ∞ := measure_ne_top ρ univ
  -- step 3: a radius `r_g` for every bad centre `g`
  have hrad : ∀ g ∈ Bad, ∃ r : ℝ, 0 < r ∧ r ≤ 1 / 4 ∧
      ENNReal.ofReal (β * r ^ d) * ρ univ < ρ (O g r) := fun g hg => hg.2
  choose! rad hrad0 hrad1 hradlt using hrad
  -- step 4: Vitali's covering lemma for the balls `B(g, r_g)`, with `τ = 2`
  obtain ⟨u, huBad, hudisj, hucov⟩ := Vitali.exists_disjoint_subfamily_covering_enlargement
    (fun g => ball g (rad g)) Bad rad 2 one_lt_two (fun g hg => (hrad0 g hg).le) (1 / 4) hrad1
    (fun g hg => ⟨g, mem_ball_self (hrad0 g hg)⟩)
  -- step 5: `u` is countable
  have hucount : u.Countable := hudisj.countable_of_isOpen (fun _ _ => isOpen_ball)
    (fun g hg => ⟨g, mem_ball_self (hrad0 g (huBad hg))⟩)
  -- step 6: the balls `B(b, 3 r_b)`, `b ∈ u`, cover the bad set
  have hBadsub : Bad ⊆ ⋃ b ∈ u, ball b (3 * rad b) := by
    intro g hg
    obtain ⟨b, hbu, ⟨y, hy1, hy2⟩, hle⟩ := hucov g hg
    refine mem_iUnion₂.2 ⟨b, hbu, ?_⟩
    rw [mem_ball] at hy1 hy2 ⊢
    calc dist g b ≤ dist g y + dist y b := dist_triangle _ _ _
      _ < rad g + rad b := by rw [dist_comm g y]; exact add_lt_add hy1 hy2
      _ ≤ 3 * rad b := by linarith
  -- step 7: the periodic sets `O_{r_b}(b)`, `b ∈ u`, are pairwise disjoint
  have hcoord : ∀ (y g : Fin d → ℝ) (r : ℝ) (z : Fin d → ℤ),
      ∑ k, (y k - g k - z k) ^ 2 < r ^ 2 → 0 < r → ∀ k, |y k - g k - z k| < r := by
    intro y g r z h hr k
    have hk : (y k - g k - z k) ^ 2 < r ^ 2 :=
      lt_of_le_of_lt (Finset.single_le_sum (f := fun i => (y i - g i - z i) ^ 2)
        (fun i _ => sq_nonneg _) (Finset.mem_univ k)) h
    exact abs_lt_of_sq_lt_sq hk hr.le
  have hOdisj : u.PairwiseDisjoint fun b => O b (rad b) := by
    intro b hb b' hb' hne
    rw [Function.onFun, Set.disjoint_left]
    rintro y ⟨z, hz⟩ ⟨z', hz'⟩
    have hb0 := hrad0 b (huBad hb)
    have hb'0 := hrad0 b' (huBad hb')
    have h1 := hcoord y b (rad b) z hz hb0
    have h2 := hcoord y b' (rad b') z' hz' hb'0
    have hr1 := hrad1 b (huBad hb)
    have hr2 := hrad1 b' (huBad hb')
    -- the centres lie in `(1/4, 3/4)ᵈ` and the radii are `≤ 1/4`, so the integer shifts agree
    have hzz : z = z' := by
      funext k
      have a1 := abs_lt.1 (h1 k)
      have a2 := abs_lt.1 (h2 k)
      have a3 := abs_lt.1 ((huBad hb).1 k)
      have a4 := abs_lt.1 ((huBad hb').1 k)
      have c1 : (z k : ℝ) < z' k + 1 := by linarith
      have c2 : (z' k : ℝ) < z k + 1 := by linarith
      have c1' : z k < z' k + 1 := by exact_mod_cast c1
      have c2' : z' k < z k + 1 := by exact_mod_cast c2
      omega
    subst hzz
    -- then `y − z` lies in both balls `B(b, r_b)` and `B(b', r_{b'})`
    have hv : (fun k => y k - z k) ∈ ball b (rad b) ∩ ball b' (rad b') := by
      constructor
      · rw [mem_ball, dist_pi_lt_iff hb0]
        intro k
        rw [Real.dist_eq]
        have := h1 k
        rwa [show y k - z k - b k = y k - b k - z k by ring]
      · rw [mem_ball, dist_pi_lt_iff hb'0]
        intro k
        rw [Real.dist_eq]
        have := h2 k
        rwa [show y k - z k - b' k = y k - b' k - z k by ring]
    exact (Set.disjoint_left.1 (hudisj hb hb' hne)) hv.1 hv.2
  -- step 8: `S = Σ_{b ∈ u} β r_bᵈ ≤ 1`
  set S : ℝ≥0∞ := ∑' b : u, ENNReal.ofReal (β * rad b ^ d)
  have hSle : S ≤ 1 := by
    have hsum : S * ρ univ ≤ 1 * ρ univ := by
      calc S * ρ univ = ∑' b : u, ENNReal.ofReal (β * rad b ^ d) * ρ univ :=
            (ENNReal.tsum_mul_right).symm
        _ ≤ ∑' b : u, ρ (O b (rad b)) :=
            ENNReal.tsum_le_tsum fun b => (hradlt b (huBad b.2)).le
        _ = ρ (⋃ b ∈ u, O b (rad b)) :=
            (measure_biUnion hucount hOdisj fun b _ => (hOopen _ _).measurableSet).symm
        _ ≤ ρ univ := measure_mono (subset_univ _)
        _ = 1 * ρ univ := (one_mul _).symm
    exact (ENNReal.mul_le_mul_iff_left h0 hfin).1 hsum
  -- step 9: the volume estimate
  calc volume Bad ≤ volume (⋃ b ∈ u, ball b (3 * rad b)) := measure_mono hBadsub
    _ ≤ ∑' b : u, volume (ball (b : Fin d → ℝ) (3 * rad b)) := measure_biUnion_le _ hucount _
    _ = ∑' b : u, ENNReal.ofReal (6 ^ d / β) * ENNReal.ofReal (β * rad b ^ d) := by
        refine tsum_congr fun b => ?_
        have hb0 := hrad0 b (huBad b.2)
        rw [Real.volume_pi_ball _ (by positivity), Fintype.card_fin,
          ← ENNReal.ofReal_mul (by positivity)]
        congr 1
        field_simp
        ring
    _ = ENNReal.ofReal (6 ^ d / β) * S := ENNReal.tsum_mul_left
    _ ≤ ENNReal.ofReal (6 ^ d / β) * 1 := by gcongr
    _ ≤ ENNReal.ofReal (10 ^ d / β) := by
        rw [mul_one]
        apply ENNReal.ofReal_le_ofReal
        gcongr
        norm_num
/-- **Simon, Ch. 6, proof of 5.1** ((5) and the choice of `a`, cube version).  If sets
`E_e ⊆ ℝ^d`, one for each map `e : Fin d → Fin P`, have total Lebesgue outer measure
`< (1/2)^P`, then some `a` in the open cube `(1/4, 3/4)^P` has `(a_{e(k)})_k ∉ E_e` for every
injective `e`.  By Fubini over the coordinates in `range e` and the rest, the centres in the cube
whose `e`-projection lies in `E_e` have volume `≤ L^d(E_e)`; the cube has volume `(1/2)^P`, so the
union bound leaves a good centre. -/
theorem Submission.dor_lmb_fcd_gc_cube_selection : ∀ (P d : ℕ) (E : (Fin d → Fin P) → Set (Fin d → ℝ)), ∑ e, volume (E e) < ENNReal.ofReal ((1 / 2) ^ P) → ∃ a : Euclid P, (∀ i, |a i - 1 / 2| < 1 / 4) ∧ ∀ e : Fin d → Fin P, Function.Injective e → (fun k => a (e k)) ∉ E e := by
  classical
  intro P d E hsum
  -- Step 2 (Fubini): for injective `e`, the points of the cube whose `e`-projection lies in `F`
  -- have volume at most `volume F`
  have fubini : ∀ e : Fin d → Fin P, Function.Injective e → ∀ F : Set (Fin d → ℝ),
      volume {x : Fin P → ℝ | (∀ i, x i ∈ Ioo (1 / 4 : ℝ) (3 / 4)) ∧ (fun k => x (e k)) ∈ F} ≤
        volume F := by
    intro e he F
    let p : Fin P → Prop := fun i => i ∈ range e
    let Φ := MeasurableEquiv.piEquivPiSubtypeProd (fun _ : Fin P => ℝ) p
    have hΦ : MeasurePreserving Φ := by
      convert volume_preserving_piEquivPiSubtypeProd (fun _ : Fin P => ℝ) p
    let σ : Fin d ≃ {i // p i} := Equiv.ofInjective e he
    let ψ := (MeasurableEquiv.piCongrLeft (fun _ : {i // p i} => ℝ) σ).symm
    have hψ : MeasurePreserving ψ :=
      (volume_measurePreserving_piCongrLeft (fun _ : {i // p i} => ℝ) σ).symm _
    have hψapp : ∀ u k, ψ u k = u (σ k) := by
      intro u k
      simp [ψ, MeasurableEquiv.piCongrLeft, Equiv.piCongrLeft_symm_apply]
    let G : Set ({i // p i} → ℝ) := ψ ⁻¹' F
    let H : Set ({i // ¬ p i} → ℝ) := Set.pi univ fun _ => Ioo (1 / 4 : ℝ) (3 / 4)
    have hsub : {x : Fin P → ℝ | (∀ i, x i ∈ Ioo (1 / 4 : ℝ) (3 / 4)) ∧ (fun k => x (e k)) ∈ F} ⊆
        Φ ⁻¹' (G ×ˢ H) := by
      rintro x ⟨hx1, hx2⟩
      refine ⟨?_, fun i _ => hx1 i⟩
      show ψ (fun i => x i) ∈ F
      have : ψ (fun i : {i // p i} => x i) = fun k => x (e k) := by
        funext k; rw [hψapp]; rfl
      rw [this]; exact hx2
    have hG : volume G = volume F := hψ.measure_preimage_equiv F
    have hH : volume H ≤ 1 := by
      rw [Real.volume_pi_Ioo]
      refine Finset.prod_le_one fun i _ => ?_
      rw [ENNReal.ofReal_le_one]; norm_num
    calc volume {x : Fin P → ℝ | (∀ i, x i ∈ Ioo (1 / 4 : ℝ) (3 / 4)) ∧ (fun k => x (e k)) ∈ F}
        ≤ volume (Φ ⁻¹' (G ×ˢ H)) := measure_mono hsub
      _ = volume (G ×ˢ H) := hΦ.measure_preimage_equiv _
      _ = volume G * volume H := by
          rw [Measure.volume_eq_prod]; exact Measure.prod_prod G H
      _ ≤ volume G * 1 := by gcongr
      _ = volume F := by rw [mul_one, hG]
  have hI : ∀ t : ℝ, |t - 1 / 2| < 1 / 4 ↔ t ∈ Ioo (1 / 4 : ℝ) (3 / 4) := by
    intro t
    rw [abs_sub_lt_iff, mem_Ioo]
    constructor <;> rintro ⟨h1, h2⟩ <;> constructor <;> linarith
  -- Step 1: the open cube `Q` in `Euclid P` has volume `(1/2)^P`
  let Q : Set (Euclid P) := {a | ∀ i, a i ∈ Ioo (1 / 4 : ℝ) (3 / 4)}
  have hofLp : MeasurePreserving (MeasurableEquiv.toLp 2 (Fin P → ℝ)).symm :=
    EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin P)
  have hQ : volume Q = ENNReal.ofReal ((1 / 2) ^ P) := by
    have : Q = (MeasurableEquiv.toLp 2 (Fin P → ℝ)).symm ⁻¹'
        (Set.pi univ fun _ => Ioo (1 / 4 : ℝ) (3 / 4)) := by
      ext a; simp [Q, Set.mem_pi]
    rw [this, hofLp.measure_preimage_equiv, Real.volume_pi_Ioo, Finset.prod_const,
      Finset.card_univ, Fintype.card_fin, ← ENNReal.ofReal_pow (by norm_num)]
    norm_num
  -- Step 3: the sets of centres with a bad projection
  let A : (Fin d → Fin P) → Set (Euclid P) := fun e =>
    {a | Function.Injective e ∧ a ∈ Q ∧ (fun k => a (e k)) ∈ E e}
  have hA : ∀ e, volume (A e) ≤ volume (E e) := by
    intro e
    by_cases he : Function.Injective e
    · have hsub : A e ⊆ (MeasurableEquiv.toLp 2 (Fin P → ℝ)).symm ⁻¹'
          {x : Fin P → ℝ | (∀ i, x i ∈ Ioo (1 / 4 : ℝ) (3 / 4)) ∧ (fun k => x (e k)) ∈ E e} := by
        rintro a ⟨-, haQ, haE⟩
        exact ⟨haQ, haE⟩
      calc volume (A e) ≤ _ := measure_mono hsub
        _ = _ := hofLp.measure_preimage_equiv _
        _ ≤ volume (E e) := fubini e he (E e)
    · have : A e = ∅ := by
        ext a; simp only [mem_empty_iff_false, iff_false]; exact fun h => he h.1
      rw [this, measure_empty]; exact bot_le
  -- Steps 4–5: union bound and choice of `a`
  by_contra hcon
  push Not at hcon
  have hcov : Q ⊆ ⋃ e, A e := by
    intro a haQ
    obtain ⟨e, he, haE⟩ := hcon a fun i => (hI _).2 (haQ i)
    exact mem_iUnion.2 ⟨e, he, haQ, haE⟩
  have : volume Q < volume Q :=
    calc volume Q ≤ volume (⋃ e, A e) := measure_mono hcov
      _ ≤ ∑ e, volume (A e) := measure_iUnion_fintype_le _ _
      _ ≤ ∑ e, volume (E e) := Finset.sum_le_sum fun e _ => hA e
      _ < ENNReal.ofReal ((1 / 2) ^ P) := hsum
      _ = volume Q := hQ.symm
  exact lt_irrefl _ this
/-- **Simon, Ch. 6, proof of 5.1** (choice of the centre `a`, (5)–(7)).  Put `d = m + 2`,
`K = #(Fin d → Fin P)`, `β = 2K·10ᵈ·2ᴾ + 1` and `C = Kβ`.  For each `e : Fin d → Fin P` let
`E_e` be the union of the bad sets of centres of the image measures of `μ` and `μ'` under
`x ↦ (x_{e(k)})_k`.  Each bad set has volume `≤ 10ᵈ/β`, so `Σ_e |E_e| < (1/2)ᴾ` and the cube
selection gives `a` with `(a_{e(k)})_k ∉ E_e` for every injective `e`.  The `r`-tube about
`L*(a)` lies in the union over injective `e` of the preimages of the periodic
`r`-neighbourhoods of `(a_{e(k)})_k`, each of `ν`-measure `≤ β rᵈ ν(ℝᴾ)` for `ν = μ, μ'`; hence
`ν(tube) ≤ Kβ rᵈ ν(ℝᴾ)`. -/
theorem Submission.dor_lmb_fcd_good_center : ∀ (P m : ℕ), m + 1 < P → ∃ C : NNReal, ∀ μ μ' : Measure (Euclid P), IsFiniteMeasure μ → IsFiniteMeasure μ' → ∃ a : Euclid P, (∀ i, |a i - 1 / 2| < 1 / 4) ∧ ∀ r : ℝ, 0 < r → r ≤ 1 / 4 → μ {x | infDist x {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} < r} ≤ C * ENNReal.ofReal (r ^ (m + 2)) * μ univ ∧ μ' {x | infDist x {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} < r} ≤ C * ENNReal.ofReal (r ^ (m + 2)) * μ' univ := by
  have c1 := Submission.dor_lmb_fcd_gc_tube_cover
  have c2 := Submission.dor_lmb_fcd_gc_bad_set_volume
  have c3 := Submission.dor_lmb_fcd_gc_cube_selection
  classical
  intro P m hPm
  -- Step 4: the constants `β` and `C = Kβ`, depending only on `P` and `m`
  set K : ℕ := Fintype.card (Fin (m + 2) → Fin P) with hK
  set β : ℝ := 2 * K * 10 ^ (m + 2) * 2 ^ P + 1 with hβ
  have hβpos : 0 < β := by positivity
  refine ⟨Real.toNNReal (K * β), ?_⟩
  intro μ μ' hμ hμ'
  -- the coordinate projections `x ↦ (x_{e(k)})_k`
  let prj : (Fin (m + 2) → Fin P) → Euclid P → (Fin (m + 2) → ℝ) := fun e x k => x (e k)
  have hprj : ∀ e, Measurable (prj e) := fun e =>
    (continuous_pi fun k => PiLp.continuous_apply 2 (fun _ : Fin P => ℝ) (e k)).measurable
  -- the bad sets of centres of the projected measures (steps 2–3)
  let Bad : Measure (Fin (m + 2) → ℝ) → Set (Fin (m + 2) → ℝ) := fun ρ =>
    {g | (∀ k, |g k - 1 / 2| < 1 / 4) ∧ ∃ r : ℝ, 0 < r ∧ r ≤ 1 / 4 ∧
      ENNReal.ofReal (β * r ^ (m + 2)) * ρ univ <
        ρ {y | ∃ z : Fin (m + 2) → ℤ, ∑ k, (y k - g k - z k) ^ 2 < r ^ 2}}
  let E : (Fin (m + 2) → Fin P) → Set (Fin (m + 2) → ℝ) := fun e =>
    Bad (μ.map (prj e)) ∪ Bad (μ'.map (prj e))
  have hE : ∀ e, volume (E e) ≤ 2 * ENNReal.ofReal (10 ^ (m + 2) / β) := by
    intro e
    calc volume (E e) ≤ volume (Bad (μ.map (prj e))) + volume (Bad (μ'.map (prj e))) :=
          measure_union_le _ _
      _ ≤ ENNReal.ofReal (10 ^ (m + 2) / β) + ENNReal.ofReal (10 ^ (m + 2) / β) :=
          add_le_add (c2 (m + 2) _ inferInstance β hβpos) (c2 (m + 2) _ inferInstance β hβpos)
      _ = 2 * ENNReal.ofReal (10 ^ (m + 2) / β) := (two_mul _).symm
  -- the exceptional sets do not exhaust the cube
  have hsum : ∑ e, volume (E e) < ENNReal.ofReal ((1 / 2) ^ P) := by
    calc ∑ e, volume (E e) ≤ ∑ _e : Fin (m + 2) → Fin P, 2 * ENNReal.ofReal (10 ^ (m + 2) / β) :=
          Finset.sum_le_sum fun e _ => hE e
      _ = ENNReal.ofReal (2 * K * 10 ^ (m + 2) / β) := by
          rw [Finset.sum_const, Finset.card_univ, ← hK, nsmul_eq_mul,
            show (2 : ℝ≥0∞) = ENNReal.ofReal 2 by simp, ← ENNReal.ofReal_natCast,
            ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
          congr 1
          ring
      _ < ENNReal.ofReal ((1 / 2) ^ P) := by
          rw [ENNReal.ofReal_lt_ofReal_iff (by positivity), div_lt_iff₀ hβpos, hβ]
          have h2 : ((1 : ℝ) / 2) ^ P * 2 ^ P = 1 := by
            rw [← mul_pow]; norm_num
          have h3 : (0 : ℝ) < (1 / 2) ^ P := by positivity
          have h4 : ((1 : ℝ) / 2) ^ P * (2 * K * 10 ^ (m + 2) * 2 ^ P + 1) =
              2 * K * 10 ^ (m + 2) * ((1 / 2) ^ P * 2 ^ P) + (1 / 2) ^ P := by ring
          rw [h4, h2]
          linarith
  -- choice of a good centre `a` for both measures
  obtain ⟨a, ha, hgood⟩ := c3 P (m + 2) E hsum
  refine ⟨a, ha, ?_⟩
  intro r hr0 hr1
  -- Step 5: the estimate for any finite `ν` for which `a` is good
  have key : ∀ ν : Measure (Euclid P), IsFiniteMeasure ν →
      (∀ e : Fin (m + 2) → Fin P, Function.Injective e → prj e a ∉ Bad (ν.map (prj e))) →
      ν {x | infDist x {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧
        ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} < r} ≤
        (Real.toNNReal (K * β) : ℝ≥0∞) * ENNReal.ofReal (r ^ (m + 2)) * ν univ := by
    intro ν hν hνgood
    let O : (Fin (m + 2) → Fin P) → Set (Fin (m + 2) → ℝ) := fun e =>
      {y | ∃ z : Fin (m + 2) → ℤ, ∑ k, (y k - prj e a k - z k) ^ 2 < r ^ 2}
    let T : (Fin (m + 2) → Fin P) → Set (Euclid P) := fun e =>
      {x | Function.Injective e ∧ prj e x ∈ O e}
    -- step 1: the `r`-tube about `L*(a)` lies in the periodic coordinate cylinders
    have hcover : {x | infDist x {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧
        ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} < r} ⊆ ⋃ e, T e := by
      intro x hx
      obtain ⟨e, he, z, hz⟩ := c1 P m hPm a x r hx
      exact mem_iUnion.2 ⟨e, he, z, hz⟩
    -- each cylinder family has `ν`-measure `≤ β rᵈ ν(ℝᴾ)`, since `a` is good
    have hT : ∀ e, ν (T e) ≤ ENNReal.ofReal (β * r ^ (m + 2)) * ν univ := by
      intro e
      by_cases he : Function.Injective e
      · have hsub : T e ⊆ prj e ⁻¹' O e := fun x hx => hx.2
        have hcube : ∀ k, |prj e a k - 1 / 2| < 1 / 4 := fun k => ha (e k)
        have hnot := hνgood e he
        have hle : (ν.map (prj e)) (O e) ≤
            ENNReal.ofReal (β * r ^ (m + 2)) * (ν.map (prj e)) univ := by
          by_contra hlt
          exact hnot ⟨hcube, r, hr0, hr1, not_le.1 hlt⟩
        calc ν (T e) ≤ ν (prj e ⁻¹' O e) := measure_mono hsub
          _ ≤ (ν.map (prj e)) (O e) := Measure.le_map_apply (hprj e).aemeasurable _
          _ ≤ ENNReal.ofReal (β * r ^ (m + 2)) * (ν.map (prj e)) univ := hle
          _ = ENNReal.ofReal (β * r ^ (m + 2)) * ν univ := by
              rw [Measure.map_apply (hprj e) MeasurableSet.univ, preimage_univ]
      · have : T e = ∅ := by
          ext x
          simp only [mem_empty_iff_false, iff_false]
          exact fun hx => he hx.1
        rw [this, measure_empty]
        exact bot_le
    -- subadditivity over the `K` maps `e`
    calc ν {x | infDist x {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧
          ∀ i ∈ s, ∃ z : ℤ, w i - a i = z} < r} ≤ ν (⋃ e, T e) := measure_mono hcover
      _ ≤ ∑ e, ν (T e) := measure_iUnion_fintype_le ν T
      _ ≤ ∑ _e : Fin (m + 2) → Fin P, ENNReal.ofReal (β * r ^ (m + 2)) * ν univ :=
          Finset.sum_le_sum fun e _ => hT e
      _ = (Real.toNNReal (K * β) : ℝ≥0∞) * ENNReal.ofReal (r ^ (m + 2)) * ν univ := by
          rw [Finset.sum_const, Finset.card_univ, ← hK, nsmul_eq_mul, ← mul_assoc]
          congr 1
          rw [← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (by positivity),
            show ((Real.toNNReal (K * β) : ℝ≥0∞)) = ENNReal.ofReal (K * β) from rfl,
            ← ENNReal.ofReal_mul (by positivity)]
          congr 1
          ring
  exact ⟨key μ hμ fun e he h => hgood e he (Or.inl h),
    key μ' hμ' fun e he h => hgood e he (Or.inr h)⟩
/-- **Push-forward of `τ(M, θ, ξ)` by a `C¹` map** (Simon 6.2.23–6.2.24(2), with a compact `K`
carrying `Hⁿ⌞M` in place of `B̄_t(y)`).  If `Hⁿ(M \ K) = 0`, `f` is `C¹` on an open `O ⊇ K` and
`f(K) ⊆ U`, then `Q(ω) = ∫_M θ ⟨ω(f x) ∘ Df(x), ξ⟩ dHⁿ` is a current in `U` with compact support
`spt Q ⊆ f(K)`.  With `‖Df‖ ≤ Λ` on `K`, `|θ ⟨ω(f x) ∘ Df(x), ξ⟩| ≤ ‖ω‖_∞ Λⁿ θ 1_K` a.e., so `Q` is
well defined, linear and `|Q(ω)| ≤ ‖ω‖_∞ Λⁿ ∫_{M ∩ K} θ dHⁿ`, which gives continuity; forms
vanishing on `f(K)` are killed by `Q`. -/
theorem Submission.dor_lmb_pc_pushforward_current_exists : ∀ (P n : ℕ) (U K O : Set (Euclid P)) (R : IMRep U n) (f : Euclid P → Euclid P), IsOpen U → IsCompact K → K ⊆ U → μHE[n] (R.carrier \ K) = 0 → IsOpen O → K ⊆ O → ContDiffOn ℝ 1 f O → f '' K ⊆ U → ∃ Q : GeometricCurrentOn U n, (∀ ω : TestFormOn U n, Q ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[n]) ∧ IsCompact Q.support ∧ Q.support ⊆ f '' K := by
  intro P n U K O R f hU hK hKU hnull hO hKO hf hfKU
  -- Step 1: `f` and `Df` are continuous on `O`, `f(K)` is compact and `‖Df‖ ≤ Λ` on `K`
  have hfc : ContinuousOn f O := hf.continuousOn
  have hdfc : ContinuousOn (fderiv ℝ f) O := hf.continuousOn_fderiv_of_isOpen hO le_rfl
  have hfK : IsCompact (f '' K) := hK.image_of_continuousOn (hfc.mono hKO)
  obtain ⟨Λ, hΛ0, hΛ⟩ : ∃ Λ : ℝ, 0 ≤ Λ ∧ ∀ x ∈ K, ‖fderiv ℝ f x‖ ≤ Λ := by
    obtain ⟨Λ, hΛ⟩ := hK.exists_bound_of_continuousOn (hdfc.mono hKO)
    exact ⟨max Λ 0, le_max_right _ _, fun x hx => (hΛ x hx).trans (le_max_left _ _)⟩
  -- Step 2: `Hⁿ⌞M` is carried by `K`
  have hKm : MeasurableSet K := hK.isClosed.measurableSet
  have hae : ∀ᵐ x ∂(μHE[n].restrict R.carrier), x ∈ K := by
    rw [ae_restrict_iff' R.measurableSet_carrier]
    filter_upwards [measure_eq_zero_iff_ae_notMem.1 hnull] with x hx hxM
    by_contra hxK
    exact hx ⟨hxM, hxK⟩
  -- Step 3: the pulled-back covector field `β_ω(x) = ω(f x) ∘ Df(x)` is continuous on `O`
  obtain ⟨β, hβ⟩ : ∃ β : TestFormOn U n → Euclid P → Covector (Euclid P) n, ∀ ω x,
      β ω x = ((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x) :=
    ⟨fun ω x => ((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap
      (fderiv ℝ f x), fun _ _ => rfl⟩
  have hcomp : Continuous fun p : Covector (Euclid P) n × (Euclid P →L[ℝ] Euclid P) =>
      p.1.compContinuousLinearMap p.2 :=
    continuous_iff_continuousAt.2 fun p =>
      (ContinuousAlternatingMap.hasStrictFDerivAt_compContinuousLinearMap p).hasFDerivAt.continuousAt
  have hβc : ∀ ω : TestFormOn U n, ContinuousOn (β ω) O := by
    intro ω
    have hω : Continuous (ω : DifferentialForm (Euclid P) n) := ContDiff.continuous ω.property.1.1
    have h : ContinuousOn (fun x => ((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap
        (fderiv ℝ f x)) O := hcomp.comp_continuousOn ((hω.comp_continuousOn hfc).prodMk hdfc)
    exact h.congr fun x _ => hβ ω x
  -- Step 4: `β_ω` is linear in `ω`
  have hβadd : ∀ (ω η : TestFormOn U n) x, β (ω + η) x = β ω x + β η x := by
    intro ω η x
    simp only [hβ]
    ext v
    simp
  have hβsmul : ∀ (c : ℝ) (ω : TestFormOn U n) x, β (c • ω) x = c • β ω x := by
    intro c ω x
    simp only [hβ]
    ext v
    simp
  -- Step 5: the truncation `1_K β_ω` is measurable, vanishes off `K` and `‖1_K β_ω‖ ≤ M Λⁿ`
  have hFm : ∀ ω : TestFormOn U n,
      AEStronglyMeasurable (K.indicator (β ω)) (μHE[n].restrict R.carrier) := fun ω =>
    (aestronglyMeasurable_indicator_iff hKm).2 (((hβc ω).mono hKO).aestronglyMeasurable hKm)
  have hFB : ∀ (ω : TestFormOn U n) (M : ℝ), (∀ z, ‖(ω : DifferentialForm (Euclid P) n) z‖ ≤ M) →
      ∀ x, ‖K.indicator (β ω) x‖ ≤ M * Λ ^ n := by
    intro ω M hM x
    have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
    by_cases hx : x ∈ K
    · rw [indicator_of_mem hx, hβ]
      calc ‖((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x)‖
          ≤ ‖(ω : DifferentialForm (Euclid P) n) (f x)‖ * ‖fderiv ℝ f x‖ ^ Fintype.card (Fin n) :=
            ContinuousAlternatingMap.norm_compContinuousLinearMap_le _ _
        _ ≤ M * Λ ^ n := by
            rw [Fintype.card_fin]
            exact mul_le_mul (hM _) (pow_le_pow_left₀ (norm_nonneg _) (hΛ x hx) n)
              (pow_nonneg (norm_nonneg _) n) hM0
    · rw [indicator_of_notMem hx, norm_zero]
      exact mul_nonneg hM0 (pow_nonneg hΛ0 n)
  -- Step 6: integrability and `|∫_M θ ⟨β_ω, ξ⟩| ≤ M Λⁿ ∫_{M ∩ K} θ`
  have hpair : ∀ (ω : TestFormOn U n) (M : ℝ),
      (∀ z, ‖(ω : DifferentialForm (Euclid P) n) z‖ ≤ M) →
      Integrable (fun x => (R.mult x : ℝ) * R.orient x (β ω x)) (μHE[n].restrict R.carrier) ∧
      |∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (β ω x) ∂μHE[n]| ≤
        M * Λ ^ n * (∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal := by
    intro ω M hM
    obtain ⟨hint, hle⟩ := Submission.dpf_pfc_imrep_pairing_integrable_abs_le P n U K R
      (K.indicator (β ω)) (M * Λ ^ n) hK hKU (hFm ω) (fun x hx => indicator_of_notMem hx _)
      (hFB ω M hM)
    have heq : (fun x => (R.mult x : ℝ) * R.orient x (K.indicator (β ω) x))
        =ᵐ[μHE[n].restrict R.carrier] fun x => (R.mult x : ℝ) * R.orient x (β ω x) := by
      filter_upwards [hae] with x hx
      rw [indicator_of_mem hx]
    exact ⟨hint.congr heq, by rwa [← integral_congr_ae heq]⟩
  have hint : ∀ ω : TestFormOn U n,
      Integrable (fun x => (R.mult x : ℝ) * R.orient x (β ω x)) (μHE[n].restrict R.carrier) := by
    intro ω
    obtain ⟨M, hM⟩ := (ContDiff.continuous ω.property.1.1).bounded_above_of_compact_support
      ω.property.1.2
    exact (hpair ω M hM).1
  -- Step 7: the linear functional `Q(ω) = ∫_M θ ⟨β_ω, ξ⟩ dHⁿ`
  let I : TestFormOn U n →ₗ[ℝ] ℝ :=
    { toFun := fun ω => ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (β ω x) ∂μHE[n]
      map_add' := fun ω η => by
        simp only [hβadd, map_add, mul_add]
        exact integral_add (hint ω) (hint η)
      map_smul' := fun c ω => by
        have h : ∀ x, (R.mult x : ℝ) * R.orient x (β (c • ω) x) =
            c * ((R.mult x : ℝ) * R.orient x (β ω x)) := by
          intro x
          rw [hβsmul, map_smul, smul_eq_mul]
          ring
        simp only [h, RingHom.id_apply, smul_eq_mul]
        exact integral_const_mul c _ }
  have hIapply : ∀ ω : TestFormOn U n,
      I ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (β ω x) ∂μHE[n] := fun _ => rfl
  -- Step 8: continuity, from `supₓ ‖ωⱼ(x)‖ → 0`
  have hcont : ∀ ωs : ℕ → TestFormOn U n, TestFormOnConverges ωs 0 →
      Tendsto (fun j => I (ωs j)) atTop (𝓝 0) := by
    intro ωs hωs
    obtain ⟨-, -, -, -, hunif⟩ := Submission.dpf_pfc_testFormOnConverges_zero_uniform P n U ωs hωs
    have hc : 0 ≤ (∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal :=
      ENNReal.toReal_nonneg
    have hA : 0 ≤ Λ ^ n * (∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal :=
      mul_nonneg (pow_nonneg hΛ0 n) hc
    rw [Metric.tendsto_nhds]
    intro δ hδ
    have hε : 0 < δ / (Λ ^ n * (∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal + 1) :=
      div_pos hδ (by linarith)
    filter_upwards [hunif _ hε] with j hj
    rw [Real.dist_eq, sub_zero, hIapply]
    calc |∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (β (ωs j) x) ∂μHE[n]|
        ≤ δ / (Λ ^ n * (∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal + 1) *
            Λ ^ n * (∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal :=
          (hpair (ωs j) _ hj).2
      _ = δ * (Λ ^ n * (∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal) /
            (Λ ^ n * (∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal + 1) := by
          ring
      _ < δ := by
          rw [div_lt_iff₀ (by linarith)]
          nlinarith
  let Q : GeometricCurrentOn U n := ⟨I, hcont⟩
  -- Step 9: `Q` kills every form vanishing near `f(K)`, so `spt Q ⊆ f(K)` is compact
  have hvan : ∀ ω : TestFormOn U n,
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (f '' K) → Q ω = 0 := by
    intro ω hω
    change I ω = 0
    rw [hIapply]
    apply integral_eq_zero_of_ae
    filter_upwards [hae] with x hx
    have hfx : (ω : DifferentialForm (Euclid P) n) (f x) = 0 :=
      image_eq_zero_of_notMem_tsupport (disjoint_right.1 hω (mem_image_of_mem f hx))
    have h0 : ((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap
        (fderiv ℝ f x) = 0 := by
      rw [hfx]
      ext v
      simp
    rw [Pi.zero_apply, hβ, h0, map_zero, mul_zero]
  obtain ⟨hsub, hcpt⟩ :=
    Submission.rsd_cmr_support_subset_of_vanish P n U (f '' K) Q hU hfK hfKU hvan
  refine ⟨Q, fun ω => ?_, hcpt, hsub⟩
  change I ω = _
  simp only [hIapply, hβ]
/-- **Simon Ch. 6, 2.5** (step 8(b) of the level cut in the proof of 7.2.4): if `Y = T − S` on
the forms supported in `W`, then `M_W(Y) ≤ M_W(T) + M_W(S)`.  `M_W(Y)` is the supremum of `Y(ω)`
over the forms `ω ∈ 𝒟ⁿ(U)` admissible for `M_W` (`spt ω ⊆ W`, `|ω| ≤ 1`).  For such `ω` the
form `−ω` is admissible as well, since it has the same support and pointwise coefficient norm.
As `Y(ω) = T(ω) − S(ω) = T(ω) + S(−ω)` and `ofReal` is subadditive, `Y(ω)` is bounded by
`M_W(T) + M_W(S)`. -/
theorem Submission.dor_lmb_glc_massOn_sub_le : ∀ (P n : ℕ) (U W : Set (Euclid P)) (T S Y : GeometricCurrentOn U n), (∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ W → Y ω = T ω - S ω) → Y.massOn W ≤ T.massOn W + S.massOn W := by
  intro P n U W T S Y hY
  -- Step 1: `M_W(Y)` is a supremum, so fix an admissible `ω`
  apply sSup_le
  rintro r ⟨ω, hω, rfl⟩
  -- Step 2: `−ω` is admissible (same support, same coefficient norm)
  have hnω : -ω ∈ massAdmissibleOn U n W := by
    refine ⟨?_, fun x => ?_⟩
    · rw [Submodule.coe_neg, tsupport_neg]
      exact hω.1
    · rw [Submodule.coe_neg, Pi.neg_apply, covectorEuclideanNorm_neg]
      exact hω.2 x
  -- Step 3: `Y(ω) = T(ω) − S(ω) = T(ω) + S(−ω)`, as `spt ω ⊆ W`
  have hY' : Y ω = T ω + S (-ω) := by
    rw [hY ω hω.1, map_neg S.toCurrent ω, sub_eq_add_neg]
  -- Steps 4–5: subadditivity of `ofReal`, and each admissible value is bounded by the mass
  calc ENNReal.ofReal (Y ω) = ENNReal.ofReal (T ω + S (-ω)) := by rw [hY']
    _ ≤ ENNReal.ofReal (T ω) + ENNReal.ofReal (S (-ω)) := ENNReal.ofReal_add_le
    _ ≤ T.massOn W + S.massOn W := add_le_add (T.le_massOn hω) (S.le_massOn hnω)
/-- Simon 7.2.4 (3) and Ch. 6, 4.5(2): by cancellation `X = D + Q` acts as
`ω ↦ ∫_{M̂∩B_t(y)} θ̂⟨dω, ξ̂⟩ dH^{n+1}` (informally `∂(R⌞B_t(y))`), so `∂X = 0` by `d² = 0`,
`X(ω) = 0` if `spt ω` misses `B̄_t(y)`, and `X(ω) = R(dω) = ∂R(ω)` if `spt ω ⊆ B_t(y)`. -/
theorem Submission.dor_lmb_glc_cut_cycle : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : GeometricCurrentOn U (n + 1)) (RR : IMRep U (n + 1)) (RB : IMRep U n) (D Q : GeometricCurrentOn U n) (y : Euclid P) (t : ℝ), RR.Represents R → (∀ ω : TestFormOn U n, D ω = ∫ x in RB.carrier ∩ ball y t, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → (∀ ω : TestFormOn U n, Q ω = (∫ x in RR.carrier ∩ ball y t, (RR.mult x : ℝ) * RR.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier ∩ ball y t, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → ∃ X : GeometricCurrentOn U n, (∀ ω : TestFormOn U n, X ω = D ω + Q ω) ∧ BoundaryVanishes X ∧ (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (closedBall y t) → X ω = 0) ∧ ∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ ball y t → X ω = R.boundary ω := by
  intro P n U R RR RB D Q y t hR hD hQ
  -- `X := D + Q` is a current, as the sum of two continuous functionals
  let X : GeometricCurrentOn U n :=
    { toCurrent := D.toCurrent + Q.toCurrent
      continuous' := fun ωs h => by
        simpa using (D.continuous' ωs h).add (Q.continuous' ωs h) }
  have hXDQ : ∀ ω : TestFormOn U n, X ω = D ω + Q ω := fun _ => rfl
  -- (‡) `X(ω) = ∫_{M̂∩B} θ̂⟨dω, ξ̂⟩ dH^{n+1}`, by cancellation
  have hX : ∀ ω : TestFormOn U n, X ω = ∫ x in RR.carrier ∩ ball y t,
      (RR.mult x : ℝ) * RR.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x)
        ∂μHE[n + 1] := fun ω => by
    rw [hXDQ, hD, hQ]
    ring
  clear_value X
  refine ⟨X, hXDQ, ?_, fun ω hω => ?_, fun ω hω => ?_⟩
  · -- `∂X(η) = X(dη) = ∫ θ̂⟨d(dη), ξ̂⟩ = 0` as `d² = 0` (vacuous for `n = 0`)
    cases n with
    | zero => trivial
    | succ m =>
      show X.boundary = 0
      refine GeometricCurrentOn.ext fun η => ?_
      rw [GeometricCurrentOn.boundary_apply, hX, GeometricCurrentOn.zero_apply]
      refine setIntegral_eq_zero_of_forall_eq_zero fun x _ => ?_
      change (RR.mult x : ℝ) * RR.orient x
        (exteriorDerivative (exteriorDerivative (η : DifferentialForm (Euclid P) m)) x) = 0
      rw [exteriorDerivative_sq η.property.1.1, Pi.zero_apply, map_zero, mul_zero]
  · -- `dω` vanishes on `B ⊆ B̄`, which misses `spt ω ⊇ spt dω`
    have hdω : ∀ x ∈ ball y t, exteriorDerivative (ω : DifferentialForm (Euclid P) n) x = 0 :=
      fun x hx => image_eq_zero_of_notMem_tsupport fun hx' =>
        hω.notMem_of_mem_right (ball_subset_closedBall hx)
          (tsupport_exteriorDerivative_subset _ hx')
    rw [hX]
    exact setIntegral_eq_zero_of_forall_eq_zero fun x hx => by rw [hdω x hx.2, map_zero, mul_zero]
  · -- `∂R(ω) = R(dω) = ∫_{M̂} θ̂⟨dω, ξ̂⟩`, and `dω` vanishes on `M̂ \ B` as `spt dω ⊆ spt ω ⊆ B`
    have hdω : ∀ x ∉ ball y t, exteriorDerivative (ω : DifferentialForm (Euclid P) n) x = 0 :=
      fun x hx => image_eq_zero_of_notMem_tsupport fun hx' =>
        hx (hω (tsupport_exteriorDerivative_subset _ hx'))
    rw [hX, GeometricCurrentOn.boundary_apply, hR (exteriorDerivativeTestOn U n ω), IMRep.action]
    refine (setIntegral_eq_of_subset_of_forall_sdiff_eq_zero RR.measurableSet_carrier
      inter_subset_left fun x hx => ?_).symm
    show (RR.mult x : ℝ) * RR.orient x
      (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) = 0
    rw [hdω x fun hxB => hx.2 ⟨hx.1, hxB⟩, map_zero, mul_zero]
/-- **Countable gluing of the co-area identity over disjoint Borel pieces** (Simon Ch. 3, 2.8–2.9
summed over the decomposition `M = ⋃ⱼ Mⱼ` of Remark 1.3).  If `g` vanishes off the pairwise disjoint
Borel pieces `S j ⊆ M` and each piece satisfies `∫ ∫_{(S j)_t} φ dν dt = ∫_{S j} |g| φ dμ` (with an
a.e.-measurable slice integral), then so does `M`: the slice `M_t = M ∩ {g ≠ 0} ∩ f⁻¹(t)` is the
disjoint union of the `(S j)_t`, both sides are series over `j`, and monotone convergence exchanges
`∫ dt` with `∑ⱼ`. -/
theorem Submission.dor_lmbsf_tg_coarea_gluing : ∀ (P : ℕ) (μ ν : Measure (Euclid P)) (M : Set (Euclid P)) (S : ℕ → Set (Euclid P)) (g : Euclid P → Euclid P) (f : Euclid P → ℝ) (φ : Euclid P → ℝ≥0∞), MeasurableSet M → (∀ j, MeasurableSet (S j)) → Pairwise (fun i j => Disjoint (S i) (S j)) → (∀ j, S j ⊆ M) → Measurable g → (∀ x, (∀ j, x ∉ S j) → g x = 0) → Measurable f → (∀ j, AEMeasurable (fun t => ∫⁻ x in S j ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}, φ x ∂ν) ∧ ∫⁻ t, (∫⁻ x in S j ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}, φ x ∂ν) = ∫⁻ x in S j, ‖g x‖ₑ * φ x ∂μ) → AEMeasurable (fun t => ∫⁻ x in M ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}, φ x ∂ν) ∧ ∫⁻ t, (∫⁻ x in M ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}, φ x ∂ν) = ∫⁻ x in M, ‖g x‖ₑ * φ x ∂μ := by
  intro P μ ν M S g f φ _ hS hdisj hSM hg hg0 hf hpiece
  -- Step 1: `M_t = ⋃ⱼ (S j)_t`, since `g = 0` off `⋃ⱼ S j` and `S j ⊆ M`
  have hset : ∀ t : ℝ,
      M ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} = ⋃ j, S j ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t} := by
    intro t
    ext x
    simp only [mem_inter_iff, mem_ofPred_eq, mem_preimage, mem_singleton_iff, mem_iUnion]
    constructor
    · rintro ⟨⟨-, hgx⟩, hfx⟩
      obtain ⟨j, hj⟩ : ∃ j, x ∈ S j := by
        by_contra h
        exact hgx (hg0 x fun j hj => h ⟨j, hj⟩)
      exact ⟨j, ⟨hj, hgx⟩, hfx⟩
    · rintro ⟨j, ⟨hj, hgx⟩, hfx⟩
      exact ⟨⟨hSM j hj, hgx⟩, hfx⟩
  -- Step 2: the slices `(S j)_t` are Borel and pairwise disjoint
  have hmeas : ∀ (t : ℝ) j, MeasurableSet (S j ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}) := fun t j =>
    ((hS j).inter (hg (measurableSet_singleton 0).compl)).inter (hf (measurableSet_singleton t))
  have hdisj' : ∀ t : ℝ, Pairwise (Disjoint on fun j => S j ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}) :=
    fun t i j hij => (hdisj hij).mono (inter_subset_left.trans inter_subset_left)
      (inter_subset_left.trans inter_subset_left)
  -- Step 3: `∫_{M_t} φ dν = ∑ⱼ ∫_{(S j)_t} φ dν` for every `t`
  have hslice : ∀ t : ℝ, ∫⁻ x in M ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}, φ x ∂ν =
      ∑' j, ∫⁻ x in S j ∩ {x | g x ≠ 0} ∩ f ⁻¹' {t}, φ x ∂ν := fun t => by
    rw [hset t, lintegral_iUnion (hmeas t) (hdisj' t)]
  -- Step 6: `|g| φ` vanishes off `⋃ⱼ S j ⊆ M`, so `∫_M |g| φ dμ = ∑ⱼ ∫_{S j} |g| φ dμ`
  have hsupp : support (fun x => ‖g x‖ₑ * φ x) ⊆ ⋃ j, S j := by
    intro x hx
    rw [mem_support] at hx
    by_contra h
    exact hx (by simp [hg0 x fun j hj => h (mem_iUnion.2 ⟨j, hj⟩)])
  have hrhs : ∫⁻ x in M, ‖g x‖ₑ * φ x ∂μ = ∑' j, ∫⁻ x in S j, ‖g x‖ₑ * φ x ∂μ := by
    rw [setLIntegral_eq_of_support_subset (hsupp.trans (iUnion_subset hSM)),
      ← setLIntegral_eq_of_support_subset hsupp, lintegral_iUnion hS hdisj]
  -- Steps 4, 5 and 7: the series is a.e.-measurable, and monotone convergence for series
  simp only [hslice]
  refine ⟨AEMeasurable.tsum fun j => (hpiece j).1, ?_⟩
  rw [lintegral_tsum fun j => (hpiece j).1, hrhs]
  exact tsum_congr fun j => (hpiece j).2
/-- **Approximate tangent spaces glue over a countable Borel cover** (Simon Ch. 3, Remark 1.5(2),
with the decomposition of Remark 1.3; used in Ch. 6, proof of Lemma 4.1(2)).  Assume tangent
locality (TL): for Borel `A ⊆ B ⊆ U`, `U` open and `B` locally `Hⁿ`-finite in `U`, the sets `B`
and `A` have the same approximate tangent spaces at `Hⁿ`-a.e. `x ∈ A`.  Let `B ⊆ U` be Borel and
locally `Hⁿ`-finite in `U`, and let Borel sets `S j ⊆ B` cover `B`.  If `S j` has approximate
tangent space `Q(x)` at `Hⁿ`-a.e. `x ∈ S j` for every `j`, then `B` has approximate tangent space
`Q(x)` at `Hⁿ`-a.e. `x ∈ B`.
* (TL) with `A = S j`, evaluated at `Q(x)`, transfers the tangent space from `S j` to `B`,
  `Hⁿ`-a.e. on `S j`.
* A countable union of null sets is null (`ae_restrict_iUnion_iff`), and `B ⊆ ⋃ j, S j`. -/
theorem Submission.dor_lmbsf_tg_tangent_gluing : (∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q) → ∀ (P n : ℕ) (U B : Set (Euclid P)) (S : ℕ → Set (Euclid P)) (Q : Euclid P → Submodule ℝ (Euclid P)), IsOpen U → MeasurableSet B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → (∀ j, MeasurableSet (S j)) → (∀ j, S j ⊆ B) → B ⊆ ⋃ j, S j → (∀ j, ∀ᵐ x ∂(μHE[n].restrict (S j)), HasApproximateTangentSpaceAt n (S j) x (Q x)) → ∀ᵐ x ∂(μHE[n].restrict B), HasApproximateTangentSpaceAt n B x (Q x) := by
  intro hTL P n U B S Q hU hB hBU hfin hS hSB hBS hpiece
  -- Steps 1–2: on `S j`, (TL) with `A = S j` turns `TₓS j = Q(x)` into `TₓB = Q(x)`
  have hj : ∀ j, ∀ᵐ x ∂(μHE[n].restrict (S j)), HasApproximateTangentSpaceAt n B x (Q x) := by
    intro j
    filter_upwards [hTL P n U (S j) B hU (hS j) hB (hSB j) hBU hfin, hpiece j] with x hx hxQ
    exact (hx (Q x)).2 hxQ
  -- Step 3: a countable union of null sets is null, so this holds `Hⁿ`-a.e. on `⋃ j, S j`
  have hcover : ∀ᵐ x ∂(μHE[n].restrict (⋃ j, S j)), HasApproximateTangentSpaceAt n B x (Q x) :=
    (ae_restrict_iUnion_iff S _).2 hj
  -- Step 4: restrict to `B ⊆ ⋃ j, S j`
  exact ae_restrict_of_ae_restrict_of_subset hBS hcover
/-- **Gluing weak limits over a countable a.e.-partition** (Simon Ch. 6, proof of 4.5(2): the
reduction to a single piece).  If the disjoint Borel pieces `S j ⊆ M` cover `M` up to a `μ`-null
set, the `u k` are dominated on `M` by the integrable `D`, and `∫_{S j} u k → ∫_{S j ∩ E} v` for
every `j`, then `∫_M u k → ∫_{M ∩ E} v`.  Countable additivity writes both sides as series over
the pieces, the terms are bounded by the summable `∫_{S j} D`, and Tannery's theorem (the `ε/3`
argument of Mathlib's `tendsto_tsum_of_dominated_convergence`, inlined) passes to the limit. -/
theorem Submission.dor_lmbsf_tg_weak_limit_gluing : ∀ (P : ℕ) (μ : Measure (Euclid P)) (M E : Set (Euclid P)) (S : ℕ → Set (Euclid P)) (u : ℕ → Euclid P → ℝ) (v D : Euclid P → ℝ), MeasurableSet M → MeasurableSet E → (∀ j, MeasurableSet (S j)) → Pairwise (fun i j => Disjoint (S i) (S j)) → (∀ j, S j ⊆ M) → μ (M \ ⋃ j, S j) = 0 → IntegrableOn D M μ → (∀ k, AEStronglyMeasurable (u k) (μ.restrict M)) → (∀ k, ∀ᵐ x ∂(μ.restrict M), ‖u k x‖ ≤ D x) → IntegrableOn v (M ∩ E) μ → (∀ j, Tendsto (fun k => ∫ x in S j, u k x ∂μ) atTop (𝓝 (∫ x in S j ∩ E, v x ∂μ))) → Tendsto (fun k => ∫ x in M, u k x ∂μ) atTop (𝓝 (∫ x in M ∩ E, v x ∂μ)) := by
  intro P μ M E S u v D _ hE hS hdisj hSM hnull hD hum hule hv hlim
  -- Step 1: `M =ᵐ ⋃ⱼ Sⱼ` and `M ∩ E =ᵐ ⋃ⱼ (Sⱼ ∩ E)`
  have hUM : (⋃ j, S j) ⊆ M := iUnion_subset hSM
  have hae : M =ᵐ[μ] ⋃ j, S j :=
    ae_eq_set.2 ⟨hnull, by rw [Set.sdiff_eq_empty.2 hUM, measure_empty]⟩
  have haeE : M ∩ E =ᵐ[μ] ⋃ j, S j ∩ E := by
    rw [← iUnion_inter]
    exact hae.inter .rfl
  -- Steps 2–4: `∫_M u k = Σⱼ ∫_{Sⱼ} u k` and `∫_{M ∩ E} v = Σⱼ ∫_{Sⱼ ∩ E} v`
  have hsum_u : ∀ k, HasSum (fun j => ∫ x in S j, u k x ∂μ) (∫ x in M, u k x ∂μ) := by
    intro k
    have hk : IntegrableOn (u k) M μ := Integrable.mono' hD (hum k) (hule k)
    rw [Measure.restrict_congr_set hae]
    exact hasSum_integral_iUnion hS hdisj (hk.congr_set_ae hae.symm)
  have hsum_v : HasSum (fun j => ∫ x in S j ∩ E, v x ∂μ) (∫ x in M ∩ E, v x ∂μ) := by
    rw [Measure.restrict_congr_set haeE]
    exact hasSum_integral_iUnion (fun j => (hS j).inter hE)
      (fun i j hij => (hdisj hij).mono inter_subset_left inter_subset_left)
      (hv.congr_set_ae haeE.symm)
  -- Step 5: `|∫_{Sⱼ} u k| ≤ ∫_{Sⱼ} D`, and `Σⱼ ∫_{Sⱼ} D` converges
  have hsum_D : Summable fun j => ∫ x in S j, D x ∂μ :=
    (hasSum_integral_iUnion hS hdisj (hD.mono_set hUM)).summable
  have hbound : ∀ k j, ‖∫ x in S j, u k x ∂μ‖ ≤ ∫ x in S j, D x ∂μ := fun k j =>
    norm_integral_le_of_norm_le (hD.mono_set (hSM j))
      (ae_restrict_of_ae_restrict_of_subset (hSM j) (hule k))
  -- Step 6: Tannery's theorem, by an `ε/3` argument
  have tannery : ∀ (f : ℕ → ℕ → ℝ) (g bound : ℕ → ℝ), Summable bound →
      (∀ j, Tendsto (fun k => f k j) atTop (𝓝 (g j))) → (∀ k j, ‖f k j‖ ≤ bound j) →
      Tendsto (fun k => ∑' j, f k j) atTop (𝓝 (∑' j, g j)) := by
    intro f g bound h_sum hab h_bound
    have h_g_le (j : ℕ) : ‖g j‖ ≤ bound j :=
      le_of_tendsto (tendsto_norm.comp (hab j)) (Eventually.of_forall fun k => h_bound k j)
    have h_sumg : Summable (‖g ·‖) :=
      h_sum.of_norm_bounded fun j => (norm_norm (g j)).symm ▸ h_g_le j
    have h_suma (k : ℕ) : Summable (‖f k ·‖) :=
      h_sum.of_norm_bounded <| by simpa only [norm_norm] using h_bound k
    rw [Metric.tendsto_nhds]
    intro ε hε
    obtain ⟨B, hB⟩ := h_sum
    obtain ⟨T, hT⟩ : ∃ T : Finset ℕ, dist (∑ j ∈ T, bound j) B < ε / 3 := by
      rw [HasSum, Metric.tendsto_nhds] at hB
      exact Eventually.exists <| hB _ (by positivity)
    -- the tail of `Σ bound` off `T` is `< ε/3`
    have h1 : ∑' (j : (Tᶜ : Set ℕ)), bound j < ε / 3 := by
      calc _ ≤ ‖∑' (j : (Tᶜ : Set ℕ)), bound j‖ := Real.le_norm_self _
           _ = ‖B - ∑ j ∈ T, bound j‖ := congrArg _ ?_
           _ < ε / 3 := by rwa [dist_eq_norm, norm_sub_rev] at hT
      simpa only [hB.summable.sum_add_tsum_compl, eq_sub_iff_add_eq'] using hB.tsum_eq
    -- the finitely many terms on `T` converge
    have h2 : Tendsto (fun k => ∑ j ∈ T, f k j) atTop (𝓝 (∑ j ∈ T, g j)) :=
      tendsto_finsetSum _ fun j _ => hab j
    rw [Metric.tendsto_nhds] at h2
    filter_upwards [h2 (ε / 3) (by positivity)] with k hk
    rw [dist_eq_norm, ← (h_suma k).of_norm.tsum_sub h_sumg.of_norm,
      ← ((h_suma k).of_norm.sub h_sumg.of_norm).sum_add_tsum_compl (s := T),
      (by ring : ε = ε / 3 + (ε / 3 + ε / 3))]
    refine (norm_add_le _ _).trans_lt (add_lt_add ?_ ?_)
    · simpa only [dist_eq_norm, Finset.sum_sub_distrib] using hk
    · rw [((h_suma k).subtype _).of_norm.tsum_sub (h_sumg.subtype _).of_norm]
      refine (norm_sub_le _ _).trans_lt (add_lt_add ?_ ?_)
      · refine ((norm_tsum_le_tsum_norm ((h_suma k).subtype _)).trans ?_).trans_lt h1
        exact ((h_suma k).subtype _).tsum_le_tsum (h_bound k ·) (hB.summable.subtype _)
      · refine ((norm_tsum_le_tsum_norm (h_sumg.subtype _)).trans ?_).trans_lt h1
        exact (h_sumg.subtype _).tsum_le_tsum (h_g_le ·) (hB.summable.subtype _)
  -- Step 7: conclusion
  have key := tannery _ _ _ hsum_D hlim hbound
  rw [hsum_v.tsum_eq] at key
  exact key.congr fun k => (hsum_u k).tsum_eq
/-- **Countably many `C¹` charts inside `U`** (Simon Ch. 2, §4 (4.1); Ch. 3, Lemma 1.2 and
Remark 1.3).  Let `U ⊆ ℝᴾ` be open and `M ⊆ U` with `M ⊆ N₀ ∪ ⋃ₗ Nₗ`, each `Nₗ` an embedded
`m`-dimensional `C¹` submanifold.  Then there are countably many charts `(Vₛ, ψₛ)`: `Vₛ ⊆ ℝᵐ`
open, `ψₛ` `C¹` and injective on `Vₛ` with injective differential at every point of `Vₛ`, and
`ψₛ(Vₛ) ⊆ U`, such that `M ⊆ N₀ ∪ ⋃ₛ ψₛ(Vₛ)`. -/
theorem Submission.dor_lmbsf_cp_submanifold_chart_cover : ∀ (P m : ℕ) (U M N₀ : Set (Euclid P)) (N : ℕ → Set (Euclid P)), IsOpen U → M ⊆ U → (∀ l, IsEmbeddedSubmanifold 1 m (N l)) → M ⊆ N₀ ∪ ⋃ l, N l → ∃ (V : ℕ → Set (Euclid m)) (ψ : ℕ → Euclid m → Euclid P), (∀ s, IsOpen (V s) ∧ ContDiffOn ℝ 1 (ψ s) (V s) ∧ InjOn (ψ s) (V s) ∧ (∀ y ∈ V s, Injective (fderiv ℝ (ψ s) y)) ∧ ψ s '' V s ⊆ U) ∧ M ⊆ N₀ ∪ ⋃ s, ψ s '' V s := by
  classical
  intro P m U M N₀ N hU hMU hN hMN
  -- a chart `(V, W, ψ)` of `Nₗ` at every `z ∈ Nₗ`, with `ψ(V) = W ∩ Nₗ`
  have hch : ∀ (l : ℕ) (z : N l), ∃ (V : Set (Euclid m)) (W : Set (Euclid P))
      (ψ : Euclid m → Euclid P), IsOpen V ∧ IsOpen W ∧ (z : Euclid P) ∈ W ∧
      ContDiffOn ℝ 1 ψ V ∧ InjOn ψ V ∧ ψ '' V = W ∩ N l ∧ ∀ y ∈ V, Injective (fderiv ℝ ψ y) := by
    intro l z
    obtain ⟨V, W, ψ, hV, hW, hzW, hψ, hinj, himg, -, hD⟩ := hN l z z.2
    exact ⟨V, W, ψ, hV, hW, hzW, by simpa using hψ, hinj, himg, hD⟩
  choose V W ψ hV hW hzW hψ hinj himg hD using hch
  -- Lindelöf: countably many `W l z`, `z ∈ T l`, cover `Nₗ`
  have hT : ∀ l, ∃ T : Set (N l), T.Countable ∧ ⋃ z ∈ T, W l z = ⋃ z, W l z :=
    fun l => TopologicalSpace.isOpen_iUnion_countable (W l) (hW l)
  choose T hTc hTU using hT
  let I := Σ l : ℕ, T l
  have : ∀ l, Countable (T l) := fun l => (hTc l).to_subtype
  have : Countable I := inferInstance
  -- shrink each domain to `V ∩ ψ⁻¹(U)`; the extra index `none` carries the empty chart
  let V' : Option I → Set (Euclid m) := fun o =>
    match o with
    | none => ∅
    | some i => V i.1 i.2 ∩ ψ i.1 i.2 ⁻¹' U
  let ψ' : Option I → Euclid m → Euclid P := fun o =>
    match o with
    | none => 0
    | some i => ψ i.1 i.2
  have hchart : ∀ o : Option I, IsOpen (V' o) ∧ ContDiffOn ℝ 1 (ψ' o) (V' o) ∧
      InjOn (ψ' o) (V' o) ∧ (∀ y ∈ V' o, Injective (fderiv ℝ (ψ' o) y)) ∧ ψ' o '' V' o ⊆ U := by
    intro o
    cases o with
    | none => simp [V', ψ']
    | some i =>
      refine ⟨(hψ i.1 i.2).continuousOn.isOpen_inter_preimage (hV i.1 i.2) hU,
        (hψ i.1 i.2).mono inter_subset_left, (hinj i.1 i.2).mono inter_subset_left,
        fun y hy => hD i.1 i.2 y hy.1, ?_⟩
      rintro _ ⟨y, hy, rfl⟩
      exact hy.2
  -- enumerate the countable index set `Option I` by `ℕ`
  obtain ⟨σ, hσ⟩ := exists_surjective_nat (Option I)
  refine ⟨fun s => V' (σ s), fun s => ψ' (σ s), fun s => hchart (σ s), ?_⟩
  -- covering: `x ∈ M ∩ Nₗ` lies in some `W l z ∩ Nₗ = ψ(V)`, and its preimage in `ψ⁻¹(U)`
  intro x hxM
  rcases hMN hxM with h0 | hx
  · exact Or.inl h0
  · right
    obtain ⟨l, hxl⟩ := mem_iUnion.1 hx
    have hxW : x ∈ ⋃ z ∈ T l, W l z := by
      rw [hTU l]
      exact mem_iUnion.2 ⟨⟨x, hxl⟩, hzW l ⟨x, hxl⟩⟩
    obtain ⟨z, hzT, hxz⟩ := mem_iUnion₂.1 hxW
    have hx' : x ∈ ψ l z '' V l z := by
      rw [himg l z]
      exact ⟨hxz, hxl⟩
    obtain ⟨v, hv, hvx⟩ := hx'
    obtain ⟨s, hs⟩ := hσ (some ⟨l, ⟨z, hzT⟩⟩)
    refine mem_iUnion.2 ⟨s, v, ?_, ?_⟩
    · show v ∈ V' (σ s)
      rw [hs]
      exact ⟨hv, by simpa [hvx] using hMU hxM⟩
    · show ψ' (σ s) v = x
      rw [hs]
      exact hvx
/-- **Simon Ch. 3, Lemma 1.2** ("only if", C¹ pieces of a chart), assuming the C¹ approximation
of Lipschitz functions (Ch. 2, Theorem 1.5).  Countably many balls `B_r(c)` with
`B̄_{2r}(c) ⊆ V` cover `V` (Lindelöf); `ψ` is Lipschitz on `B̄_{2r}(c)`, so `f ∘ ψ` has a Lipschitz
extension `ũ` from `B̄_r(c)` (McShane), and `C¹` functions `G_k` agree with `ũ` off a set of
measure `< (k+1)⁻¹`.  The pieces are `B̄_r(c) ∩ {ũ = G_k}` inside `C' = B̄_{2r}(c)`, enumerated
by `ℕ` with an empty piece as padding; the remainder lies in `⋃_b ⋂_k {ũ_b ≠ G_{b,k}}`, a null
set. -/
theorem Submission.dor_lmbsf_cp_chart_c1_pieces : (∀ (m : ℕ) (u : Euclid m → ℝ) (K : NNReal), LipschitzWith K u → ∀ ε : ℝ≥0∞, 0 < ε → ∃ G : Euclid m → ℝ, ContDiff ℝ 1 G ∧ volume {y | u y ≠ G y} < ε) → ∀ (m P : ℕ) (V : Set (Euclid m)) (ψ : Euclid m → Euclid P) (f : Euclid P → ℝ) (L : NNReal), IsOpen V → ContDiffOn ℝ 1 ψ V → LipschitzWith L f → ∃ (C C' : ℕ → Set (Euclid m)) (F : ℕ → Euclid m → ℝ), (∀ k, IsCompact (C k) ∧ IsCompact (C' k) ∧ Convex ℝ (C' k) ∧ C k ⊆ interior (C' k) ∧ C' k ⊆ V ∧ ContDiff ℝ 1 (F k) ∧ ∀ y ∈ C k, f (ψ y) = F k y) ∧ volume (V \ ⋃ k, C k) = 0 := by
  classical
  intro CA m P V ψ f L hV hψ hf
  -- balls `B_r(c)` with `r > 0` and `B̄_{2r}(c) ⊆ V`; countably many of them cover `V`
  let B := {p : Euclid m × ℝ // 0 < p.2 ∧ closedBall p.1 (2 * p.2) ⊆ V}
  obtain ⟨T, hTc, hTU⟩ := TopologicalSpace.isOpen_iUnion_countable
    (fun b : B => ball b.1.1 b.1.2) (fun _ => isOpen_ball)
  have hcovV : V ⊆ ⋃ b ∈ T, ball b.1.1 b.1.2 := by
    intro v hv
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hV v hv
    have hsub : closedBall v (2 * (ε / 3)) ⊆ V :=
      (closedBall_subset_ball (by linarith)).trans hball
    let b : B := ⟨(v, ε / 3), by positivity, hsub⟩
    rw [hTU]
    exact mem_iUnion.2 ⟨b, mem_ball_self (by positivity)⟩
  -- on each ball: a Lipschitz extension `u` of `f ∘ ψ` and `C¹` functions `G k` with
  -- `volume {u ≠ G k} < (k+1)⁻¹`
  have hdata : ∀ b : B, ∃ (G : ℕ → Euclid m → ℝ) (u : Euclid m → ℝ), (∀ k, ContDiff ℝ 1 (G k)) ∧
      Continuous u ∧ (∀ y ∈ closedBall b.1.1 b.1.2, f (ψ y) = u y) ∧
      ∀ k : ℕ, volume {y | u y ≠ G k y} < ((k : ℝ≥0∞) + 1)⁻¹ := by
    intro b
    obtain ⟨Λ, hΛ⟩ := (hψ.mono b.2.2).exists_lipschitzOnWith one_ne_zero (convex_closedBall _ _)
      (isCompact_closedBall _ _)
    have hu : LipschitzOnWith (L * Λ) (f ∘ ψ) (closedBall b.1.1 b.1.2) :=
      (hf.comp_lipschitzOnWith hΛ).mono (closedBall_subset_closedBall (by linarith [b.2.1]))
    obtain ⟨u, hu', hequ⟩ := hu.extend_real
    have hk : ∀ k : ℕ, ∃ G : Euclid m → ℝ, ContDiff ℝ 1 G ∧
        volume {y | u y ≠ G y} < ((k : ℝ≥0∞) + 1)⁻¹ := fun k =>
      CA m u (L * Λ) hu' _ (ENNReal.inv_pos.2 (by simp))
    choose G hG hGvol using hk
    exact ⟨G, u, hG, hu'.continuous, fun y hy => hequ hy, hGvol⟩
  choose G u hG hucont hequ hGvol using hdata
  have : Countable T := hTc.to_subtype
  -- the pieces indexed by `Option (T × ℕ)`, with the empty piece at `none`
  let Cp : Option (T × ℕ) → Set (Euclid m) := fun o =>
    match o with
    | none => ∅
    | some (b, k) => closedBall b.1.1.1 b.1.1.2 ∩ {y | u b.1 y = G b.1 k y}
  let C'p : Option (T × ℕ) → Set (Euclid m) := fun o =>
    match o with
    | none => ∅
    | some (b, _) => closedBall b.1.1.1 (2 * b.1.1.2)
  let Fp : Option (T × ℕ) → Euclid m → ℝ := fun o =>
    match o with
    | none => 0
    | some (b, k) => G b.1 k
  have hprop : ∀ o, IsCompact (Cp o) ∧ IsCompact (C'p o) ∧ Convex ℝ (C'p o) ∧
      Cp o ⊆ interior (C'p o) ∧ C'p o ⊆ V ∧ ContDiff ℝ 1 (Fp o) ∧
      ∀ y ∈ Cp o, f (ψ y) = Fp o y := by
    intro o
    cases o with
    | none => exact ⟨isCompact_empty, isCompact_empty, convex_empty, empty_subset _, empty_subset _,
        contDiff_zero_fun, fun y hy => hy.elim⟩
    | some bk =>
      obtain ⟨b, k⟩ := bk
      refine ⟨(isCompact_closedBall _ _).inter_right
          (isClosed_eq (hucont b.1) (hG b.1 k).continuous),
        isCompact_closedBall _ _, convex_closedBall _ _, ?_, b.1.2.2, hG b.1 k, ?_⟩
      · intro y hy
        apply ball_subset_interior_closedBall
        have := hy.1
        rw [mem_closedBall] at this
        rw [mem_ball]
        linarith [b.1.2.1]
      · intro y hy
        exact (hequ b.1 y hy.1).trans hy.2
  obtain ⟨σ, hσ⟩ := exists_surjective_nat (Option (T × ℕ))
  refine ⟨fun s => Cp (σ s), fun s => C'p (σ s), fun s => Fp (σ s), fun s => hprop (σ s), ?_⟩
  -- the remainder lies in `⋃_b ⋂_k {u_b ≠ G_{b,k}}`
  have hsub : V \ ⋃ s, Cp (σ s) ⊆ ⋃ b : T, ⋂ k : ℕ, {y | u b.1 y ≠ G b.1 k y} := by
    rintro v ⟨hv, hvnot⟩
    obtain ⟨b, hbT, hvb⟩ := mem_iUnion₂.1 (hcovV hv)
    refine mem_iUnion.2 ⟨⟨b, hbT⟩, mem_iInter.2 fun k => ?_⟩
    intro heq
    obtain ⟨s, hs⟩ := hσ (some (⟨b, hbT⟩, k))
    apply hvnot
    refine mem_iUnion.2 ⟨s, ?_⟩
    rw [hs]
    exact ⟨ball_subset_closedBall hvb, heq⟩
  refine measure_mono_null hsub (measure_iUnion_null fun b => ?_)
  -- each `⋂_k {u_b ≠ G_{b,k}}` has measure `< (n+1)⁻¹ ≤ n⁻¹` for every `n`
  by_contra hne
  obtain ⟨n, hn⟩ := ENNReal.exists_inv_nat_lt hne
  have h1 : volume (⋂ k : ℕ, {y | u b.1 y ≠ G b.1 k y}) ≤ ((n : ℝ≥0∞) + 1)⁻¹ :=
    (measure_mono (iInter_subset _ n)).trans (hGvol b.1 n).le
  have h2 : ((n : ℝ≥0∞) + 1)⁻¹ ≤ (n : ℝ≥0∞)⁻¹ :=
    ENNReal.inv_le_inv.2 le_self_add
  exact absurd (h1.trans h2) (not_le.2 hn)
/-- **Lipschitz (`C¹`) images of Lebesgue-null sets are `Hᵐ`-null** (Simon Ch. 3, §2, discussion
after 2.4; Ch. 2, Theorem 1.8(i)).  If `ψ` is `C¹` on an open `V ⊆ ℝᵐ` and `Z ⊆ V` is `Lᵐ`-null,
then `Hᵐ(ψ(Z)) = 0`: `ψ` is Lipschitz near each point of `V`, countably many such neighbourhoods
cover `V` (Lindelöf), and on each the Lipschitz image bound gives `Hᵐ(ψ(Z ∩ t)) ≤ Kᵐ Lᵐ(Z ∩ t) = 0`.
-/
theorem Submission.dor_lmbsf_cp_c1_image_null : ∀ (m P : ℕ) (V Z : Set (Euclid m)) (ψ : Euclid m → Euclid P), IsOpen V → ContDiffOn ℝ 1 ψ V → Z ⊆ V → volume Z = 0 → μHE[m] (ψ '' Z) = 0 := by
  intro m P V Z ψ hV hψ hZV hZ
  -- Step 1: every `y ∈ V` has an open neighbourhood on which `ψ` is Lipschitz
  have hloc : ∀ y : V, ∃ K : NNReal, ∃ t : Set (Euclid m), IsOpen t ∧ (y : Euclid m) ∈ t ∧
      LipschitzOnWith K ψ t := by
    intro y
    obtain ⟨K, t, ht, hK⟩ := (hψ.contDiffAt (hV.mem_nhds y.2)).exists_lipschitzOnWith
    obtain ⟨u, hut, hu, hyu⟩ := _root_.mem_nhds_iff.1 ht
    exact ⟨K, u, hu, hyu, hK.mono hut⟩
  choose K t ht hyt hK using hloc
  -- Step 2: Lindelöf gives a countable subfamily covering `V ⊇ Z`
  obtain ⟨T, hTc, hT⟩ := TopologicalSpace.isOpen_iUnion_countable t ht
  have hcov : Z ⊆ ⋃ y ∈ T, t y := by
    intro z hz
    have : z ∈ ⋃ y, t y := mem_iUnion.2 ⟨⟨z, hZV hz⟩, hyt _⟩
    rw [← hT] at this
    exact this
  -- Step 3: `ψ(Z) ⊆ ⋃_{y ∈ T} ψ(Z ∩ t y)`
  have hsub : ψ '' Z ⊆ ⋃ y ∈ T, ψ '' (Z ∩ t y) := by
    rintro _ ⟨z, hz, rfl⟩
    obtain ⟨y, hyT, hzy⟩ := mem_iUnion₂.1 (hcov hz)
    exact mem_iUnion₂.2 ⟨y, hyT, z, ⟨hz, hzy⟩, rfl⟩
  -- Steps 4 and 5: each piece is null by the Lipschitz image bound and `μHE[m] = volume`
  refine measure_mono_null hsub ((measure_biUnion_null_iff hTc).2 fun y _ => ?_)
  refine le_antisymm ?_ zero_le
  calc μHE[m] (ψ '' (Z ∩ t y)) ≤ (K y : ℝ≥0∞) ^ m * μHE[m] (Z ∩ t y) :=
        Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn m
          ((hK y).mono inter_subset_right)
    _ = 0 := by
        rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume,
          measure_mono_null inter_subset_left hZ, mul_zero]
/-- **Approximate tangent planes of `M` on a chart piece** (Simon Ch. 3, Remark 1.5(2) and the
proof of Theorem 1.6 "⇒"; Step 7 of `dor_lmbsf_lipschitz_chart_pieces`).  Assume the locality
principle (TL): for Borel `A ⊆ B ⊆ U` with `Hⁿ(B ∩ K) < ∞` for compact `K ⊆ U`, at `Hⁿ`-a.e.
`x ∈ A` the sets `B` and `A` have the same approximate tangent spaces.  Let `ψ` be `C¹` on the
convex compact `C'` with `ψ(C') ⊆ U`, let `C ⊆ int C'` be compact, and let `ψ(C')` have
approximate tangent space `Dψ(y)(ℝᵐ)` at `ψ(y)` for `y ∈ int C'`.  Then at `Hᵐ`-a.e.
`x ∈ M ∩ ψ(C)`, `M` has approximate tangent space `Dψ(y)(ℝᵐ)` for every `y ∈ C` with `ψ(y) = x`.
`S = ψ(C')` is compact, and `Hᵐ(S) ≤ Λᵐ Lᵐ(C') < ∞` since `ψ` is Lipschitz on `C'`; apply (TL)
to `M ∩ ψ(C) ⊆ S` and to `M ∩ ψ(C) ⊆ M`. -/
theorem Submission.dor_lmbsf_cp_chart_tangent_ae : (∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q) → ∀ (P m : ℕ) (U M : Set (Euclid P)) (C C' : Set (Euclid m)) (ψ : Euclid m → Euclid P), IsOpen U → MeasurableSet M → M ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[m] (M ∩ K) ≠ ∞) → ContDiffOn ℝ 1 ψ C' → ψ '' C' ⊆ U → IsCompact C → IsCompact C' → Convex ℝ C' → C ⊆ interior C' → (∀ y ∈ interior C', HasApproximateTangentSpaceAt m (ψ '' C') (ψ y) (LinearMap.range (fderiv ℝ ψ y : Euclid m →ₗ[ℝ] Euclid P))) → ∀ᵐ x ∂(μHE[m].restrict (M ∩ ψ '' C)), ∀ y ∈ C, ψ y = x → HasApproximateTangentSpaceAt m M x (LinearMap.range (fderiv ℝ ψ y : Euclid m →ₗ[ℝ] Euclid P)) := by
  intro TL P m U M C C' ψ hU hM hMU hfin hψ hψU hC hC' hconv hCC' hIT
  have hψC' : ContinuousOn ψ C' := hψ.continuousOn
  have hCsub : C ⊆ C' := hCC'.trans interior_subset
  -- `S = ψ(C')` and `ψ(C)` are compact
  have hS : IsCompact (ψ '' C') := hC'.image_of_continuousOn hψC'
  have hSC : IsCompact (ψ '' C) := hC.image_of_continuousOn (hψC'.mono hCsub)
  -- `Hᵐ(S) ≤ Λᵐ Hᵐ(C') = Λᵐ Lᵐ(C') < ∞`, `ψ` being `Λ`-Lipschitz on the convex compact `C'`
  obtain ⟨Λ, hΛ⟩ := hψ.exists_lipschitzOnWith one_ne_zero hconv hC'
  have hSfin : μHE[m] (ψ '' C') ≠ ∞ := by
    refine ne_of_lt (lt_of_le_of_lt
      (Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn m hΛ) ?_)
    rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
    exact ENNReal.mul_lt_top (ENNReal.pow_lt_top ENNReal.coe_lt_top) hC'.measure_lt_top
  -- (TL) for `A = M ∩ ψ(C) ⊆ S` and for `A ⊆ M`
  have hA : MeasurableSet (M ∩ ψ '' C) := hM.inter hSC.isClosed.measurableSet
  have h1 := TL P m U (M ∩ ψ '' C) (ψ '' C') hU hA hS.isClosed.measurableSet
    (fun x hx => image_mono hCsub hx.2) hψU
    (fun K _ _ => ne_top_of_le_ne_top hSfin (measure_mono inter_subset_left))
  have h2 := TL P m U (M ∩ ψ '' C) M hU hA hM inter_subset_left hMU hfin
  -- at `x = ψ y`, transfer the tangent plane of `S` to `A`, then to `M`
  filter_upwards [h1, h2] with x hx1 hx2 y hy hyx
  have hS' := hIT y (hCC' hy)
  rw [hyx] at hS'
  exact (hx2 _).2 ((hx1 _).1 hS')
/-- **Slicing (Simon Ch. 6, §4), chart pieces, step 8: the gradient bound at density points**
(the estimate behind `|∇ᴹf| ≤ Lip f`, cf. Simon Ch. 3, 2.1 and Ch. 2, 4.10).  Let `F = f ∘ ψ` on
a Borel set `Z ⊆ ℝᵐ`, with `F` and `ψ` differentiable at every point of `Z` and `f`
`L`-Lipschitz.  Assuming the direction property (DD) of density points, `|DF(y)e| ≤ L |Dψ(y)e|`
for `Lᵐ`-a.e. `y ∈ Z` and every `e`.  By the Lebesgue density theorem
(`Besicovitch.ae_tendsto_measure_inter_div_of_measurableSet`) a.e. `y ∈ Z` is a density point of
`Z`.  For a unit vector `v`, (DD) gives `yᵢ ∈ Z ∖ {y}` with `yᵢ → y` and
`(yᵢ − y)/|yᵢ − y| → v`.  The difference quotients satisfy `|F(yᵢ) − F(y)| ≤ L |ψ(yᵢ) − ψ(y)|`
and converge to `DF(y)v` and `Dψ(y)v` (`HasFDerivWithinAt.lim`), so `|DF(y)v| ≤ L |Dψ(y)v|`.
A general `e ≠ 0` follows by linearity from `v = e/|e|`. -/
theorem Submission.dor_lmbsf_cp_gradient_bound_ae : (∀ (d : ℕ) (Z : Set (Euclid d)) (y : Euclid d), Tendsto (fun r => volume (Z ∩ closedBall y r) / volume (closedBall y r)) (𝓝[>] 0) (𝓝 1) → ∀ v : Euclid d, ‖v‖ = 1 → ∃ ys : ℕ → Euclid d, (∀ i, ys i ∈ Z ∧ ys i ≠ y) ∧ Tendsto ys atTop (𝓝 y) ∧ Tendsto (fun i => ‖ys i - y‖⁻¹ • (ys i - y)) atTop (𝓝 v)) → ∀ (m P : ℕ) (Z : Set (Euclid m)) (F : Euclid m → ℝ) (ψ : Euclid m → Euclid P) (f : Euclid P → ℝ) (L : NNReal), MeasurableSet Z → (∀ y ∈ Z, DifferentiableAt ℝ F y ∧ DifferentiableAt ℝ ψ y) → (∀ y ∈ Z, f (ψ y) = F y) → LipschitzWith L f → ∀ᵐ y ∂volume, y ∈ Z → ∀ e : Euclid m, |fderiv ℝ F y e| ≤ (L : ℝ) * ‖fderiv ℝ ψ y e‖ := by
  intro DD m P Z F ψ f L hZ hdiff heq hf
  -- step 1: almost every point of `Z` is a Lebesgue density point of `Z`
  filter_upwards [Besicovitch.ae_tendsto_measure_inter_div_of_measurableSet volume hZ] with y hy hyZ
  have hdens : Tendsto (fun r => volume (Z ∩ closedBall y r) / volume (closedBall y r))
      (𝓝[>] 0) (𝓝 1) := by
    simpa [Set.indicator_of_mem hyZ] using hy
  -- steps 2–5: the bound in a unit direction `v`
  have hunit : ∀ v : Euclid m, ‖v‖ = 1 → |fderiv ℝ F y v| ≤ (L : ℝ) * ‖fderiv ℝ ψ y v‖ := by
    intro v hv
    -- step 2: points `yᵢ ∈ Z ∖ {y}`, `yᵢ → y`, approaching `y` from the direction `v`
    obtain ⟨ys, hys, hlim, hdir⟩ := DD m Z y hdens v hv
    -- step 3: `|F(yᵢ) − F(y)| = |f(ψ(yᵢ)) − f(ψ(y))| ≤ L |ψ(yᵢ) − ψ(y)|`, divided by `|yᵢ − y|`
    have hineq : ∀ i, |‖ys i - y‖⁻¹ • (F (ys i) - F y)| ≤
        (L : ℝ) * ‖‖ys i - y‖⁻¹ • (ψ (ys i) - ψ y)‖ := by
      intro i
      have hci : 0 ≤ ‖ys i - y‖⁻¹ := inv_nonneg.2 (norm_nonneg _)
      rw [smul_eq_mul, abs_mul, abs_of_nonneg hci, norm_smul, Real.norm_of_nonneg hci,
        ← heq _ (hys i).1, ← heq y hyZ]
      have h1 := hf.dist_le_mul (ψ (ys i)) (ψ y)
      rw [Real.dist_eq, dist_eq_norm] at h1
      calc ‖ys i - y‖⁻¹ * |f (ψ (ys i)) - f (ψ y)|
          ≤ ‖ys i - y‖⁻¹ * ((L : ℝ) * ‖ψ (ys i) - ψ y‖) := mul_le_mul_of_nonneg_left h1 hci
        _ = (L : ℝ) * (‖ys i - y‖⁻¹ * ‖ψ (ys i) - ψ y‖) := by ring
    -- step 4: the difference quotients along `yᵢ − y` converge to `DF(y)v` and `Dψ(y)v`
    have hd0 : Tendsto (fun i => ys i - y) atTop (𝓝 0) := by
      simpa using hlim.sub_const y
    have hF' := ((hdiff y hyZ).1.hasFDerivAt.hasFDerivWithinAt (s := univ)).lim hd0
      (Eventually.of_forall fun _ => mem_univ _) hdir
    have hψ' := ((hdiff y hyZ).2.hasFDerivAt.hasFDerivWithinAt (s := univ)).lim hd0
      (Eventually.of_forall fun _ => mem_univ _) hdir
    simp only [add_sub_cancel] at hF' hψ'
    -- step 5: the non-strict inequality passes to the limit
    exact le_of_tendsto_of_tendsto' hF'.abs (hψ'.norm.const_mul _) hineq
  -- step 6: a general `e ≠ 0` by linearity, from the unit vector `‖e‖⁻¹ • e`
  intro e
  by_cases he : e = 0
  · simp [he]
  · have hne : ‖e‖ ≠ 0 := norm_ne_zero_iff.2 he
    have hv : ‖‖e‖⁻¹ • e‖ = 1 := by
      rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hne]
    have h := hunit _ hv
    rw [map_smul, map_smul, smul_eq_mul, abs_mul, norm_smul, abs_inv, abs_norm, norm_inv,
      norm_norm] at h
    have hpos : 0 < ‖e‖⁻¹ := inv_pos.2 (norm_pos_iff.2 he)
    have h2 : ‖e‖⁻¹ * |fderiv ℝ F y e| ≤ ‖e‖⁻¹ * ((L : ℝ) * ‖fderiv ℝ ψ y e‖) := by
      calc ‖e‖⁻¹ * |fderiv ℝ F y e| ≤ (L : ℝ) * (‖e‖⁻¹ * ‖fderiv ℝ ψ y e‖) := h
        _ = ‖e‖⁻¹ * ((L : ℝ) * ‖fderiv ℝ ψ y e‖) := by ring
    exact le_of_mul_le_mul_left h2 hpos
/-- **Disjoint Borel refinement of chart pieces** (Simon Ch. 3, Remark 1.3).  Let `M ⊆ ℝᴾ` be
Borel, `Cⱼ ⊆ ℝᵐ` compact and `ψⱼ` continuous on `Cⱼ`, with `μ(M ∖ ⋃ⱼ ψⱼ(Cⱼ)) = 0`, and suppose
that for `μ⌞(M ∩ ψⱼ(Cⱼ))`-a.e. `x` every `y ∈ Cⱼ` with `ψⱼ(y) = x` satisfies `Goodⱼ(y)`.  Then
there are Borel sets `Yⱼ ⊆ Cⱼ` of good points whose images `ψⱼ(Yⱼ) ⊆ M` are pairwise disjoint
and cover `M` up to a `μ`-null set. -/
theorem Submission.dor_lmbsf_cp_disjoint_refinement : ∀ (m P : ℕ) (μ : Measure (Euclid P)) (M : Set (Euclid P)) (C : ℕ → Set (Euclid m)) (ψ : ℕ → Euclid m → Euclid P) (Good : ℕ → Euclid m → Prop), MeasurableSet M → (∀ j, IsCompact (C j) ∧ ContinuousOn (ψ j) (C j)) → μ (M \ ⋃ j, ψ j '' C j) = 0 → (∀ j, ∀ᵐ x ∂(μ.restrict (M ∩ ψ j '' C j)), ∀ y ∈ C j, ψ j y = x → Good j y) → ∃ Y : ℕ → Set (Euclid m), (∀ j, MeasurableSet (Y j) ∧ Y j ⊆ C j ∧ ψ j '' Y j ⊆ M ∧ ∀ y ∈ Y j, Good j y) ∧ Pairwise (fun i j => Disjoint (ψ i '' Y i) (ψ j '' Y j)) ∧ μ (M \ ⋃ j, ψ j '' Y j) = 0 := by
  classical
  intro m P μ M C ψ Good hM hC hnull hgood
  -- `Eⱼ = ψⱼ(Cⱼ)` is compact, hence Borel, and `Aⱼ = M ∩ Eⱼ` is Borel
  let E : ℕ → Set (Euclid P) := fun j => ψ j '' C j
  have hEc : ∀ j, IsCompact (E j) := fun j => (hC j).1.image_of_continuousOn (hC j).2
  have hEm : ∀ j, MeasurableSet (E j) := fun j => (hEc j).isClosed.measurableSet
  let A : ℕ → Set (Euclid P) := fun j => M ∩ E j
  have hAm : ∀ j, MeasurableSet (A j) := fun j => hM.inter (hEm j)
  -- a Borel set `Tⱼ` containing the exceptional points, with `μ(Tⱼ ∩ Aⱼ) = 0`
  have hT : ∀ j, ∃ T : Set (Euclid P), {x | ¬ ∀ y ∈ C j, ψ j y = x → Good j y} ⊆ T ∧
      MeasurableSet T ∧ μ (T ∩ A j) = 0 := by
    intro j
    obtain ⟨T, hsub, hTm, hT0⟩ := exists_measurable_superset_of_null (ae_iff.1 (hgood j))
    exact ⟨T, hsub, hTm, by rwa [Measure.restrict_apply hTm] at hT0⟩
  choose T hTsub hTm hT0 using hT
  -- Remark 1.3: `Dⱼ = Aⱼ ∖ ⋃_{i<j} Aᵢ`; then `M'ⱼ = Dⱼ ∖ Tⱼ` and `Yⱼ = Cⱼ ∩ ψⱼ⁻¹(M'ⱼ)`
  let D : ℕ → Set (Euclid P) := disjointed A
  let M' : ℕ → Set (Euclid P) := fun j => D j \ T j
  have hDm : ∀ j, MeasurableSet (D j) := MeasurableSet.disjointed hAm
  have hM'm : ∀ j, MeasurableSet (M' j) := fun j => (hDm j).diff (hTm j)
  have hDA : ∀ j, D j ⊆ A j := disjointed_subset A
  -- `ψⱼ(Yⱼ) = M'ⱼ`, since `M'ⱼ ⊆ Aⱼ ⊆ ψⱼ(Cⱼ)`
  have himg : ∀ j, ψ j '' (C j ∩ ψ j ⁻¹' M' j) = M' j := by
    intro j
    ext x
    constructor
    · rintro ⟨y, ⟨_, hy⟩, rfl⟩
      exact hy
    · intro hx
      obtain ⟨y, hy, rfl⟩ := (hDA j hx.1).2
      exact ⟨y, ⟨hy, hx⟩, rfl⟩
  refine ⟨fun j => C j ∩ ψ j ⁻¹' M' j, fun j => ⟨?_, inter_subset_left, ?_, ?_⟩, ?_, ?_⟩
  · -- `Yⱼ` is Borel: on `Cⱼ`, `ψⱼ` agrees with the Borel map equal to `ψⱼ` on `Cⱼ`, `0` off it
    have hpw : Measurable ((C j).piecewise (ψ j) (fun _ => 0)) :=
      (hC j).2.measurable_piecewise continuousOn_const (hC j).1.isClosed.measurableSet
    have : C j ∩ ψ j ⁻¹' M' j = C j ∩ (C j).piecewise (ψ j) (fun _ => 0) ⁻¹' M' j := by
      ext y
      constructor
      · rintro ⟨hy, hy'⟩
        exact ⟨hy, by simpa [Set.piecewise_eq_of_mem _ _ _ hy] using hy'⟩
      · rintro ⟨hy, hy'⟩
        exact ⟨hy, by simpa [Set.piecewise_eq_of_mem _ _ _ hy] using hy'⟩
    show MeasurableSet (C j ∩ ψ j ⁻¹' M' j)
    rw [this]
    exact (hC j).1.isClosed.measurableSet.inter (hpw (hM'm j))
  · -- `ψⱼ(Yⱼ) = M'ⱼ ⊆ Aⱼ ⊆ M`
    rw [himg j]
    exact fun x hx => (hDA j hx.1).1
  · -- points of `Yⱼ` are good, since `ψⱼ(y) ∉ Tⱼ`
    intro y hy
    have hx : ψ j y ∉ T j := hy.2.2
    have : ψ j y ∉ {x | ¬ ∀ y ∈ C j, ψ j y = x → Good j y} := fun h => hx (hTsub j h)
    simp only [mem_ofPred_eq, not_not] at this
    exact this y hy.1 rfl
  · -- the images lie in the pairwise disjoint `Dⱼ`
    intro i j hij
    simp only
    rw [himg i, himg j]
    exact (disjoint_disjointed A hij).mono sdiff_subset sdiff_subset
  · -- `M ∖ ⋃ⱼ ψⱼ(Yⱼ) ⊆ (M ∖ ⋃ⱼ Eⱼ) ∪ ⋃ⱼ (Tⱼ ∩ Aⱼ)`, a `μ`-null set
    have hsub : M \ ⋃ j, ψ j '' (C j ∩ ψ j ⁻¹' M' j) ⊆ (M \ ⋃ j, E j) ∪ ⋃ j, (T j ∩ A j) := by
      rintro x ⟨hxM, hxnot⟩
      by_cases hxE : x ∈ ⋃ j, E j
      · right
        have hxA : x ∈ ⋃ j, A j := by
          obtain ⟨j, hj⟩ := mem_iUnion.1 hxE
          exact mem_iUnion.2 ⟨j, hxM, hj⟩
        rw [← iUnion_disjointed] at hxA
        obtain ⟨j, hj⟩ := mem_iUnion.1 hxA
        have hxT : x ∈ T j := by
          by_contra hxT
          exact hxnot (mem_iUnion.2 ⟨j, by rw [himg j]; exact ⟨hj, hxT⟩⟩)
        exact mem_iUnion.2 ⟨j, hxT, hDA j hj⟩
      · exact Or.inl ⟨hxM, hxE⟩
    refine measure_mono_null hsub ?_
    rw [measure_union_null_iff]
    exact ⟨hnull, measure_iUnion_null hT0⟩
/-- **Tangential lift of a gradient on a `C¹` chart** (Simon Ch. 2, §4; Ch. 3, 2.1).  Let `ψ` be
`C¹` on the open set `V ⊆ ℝᵐ` with injective differential and `F : ℝᵐ → ℝ` be `C¹`.  With
`A(y) = Dψ(y)`, `Γ(y) = A(y)* A(y)` and `a(y)` the Riesz vector of `DF(y)`, the field
`Φ(y) = A(y) Γ(y)⁻¹ a(y)` is continuous on `V`, lies in `Dψ(y)(ℝᵐ)`, satisfies
`⟨Φ(y), Dψ(y)e⟩ = DF(y)e`, and `|Φ(y)| ≤ L` whenever `|DF(y)e| ≤ L |Dψ(y)e|` for all `e`. -/
theorem Submission.dor_lmbsf_cp_chart_tangent_lift : ∀ (m P : ℕ) (V : Set (Euclid m)) (ψ : Euclid m → Euclid P) (F : Euclid m → ℝ), IsOpen V → ContDiffOn ℝ 1 ψ V → (∀ y ∈ V, Injective (fderiv ℝ ψ y)) → ContDiff ℝ 1 F → ∃ Φ : Euclid m → Euclid P, ContinuousOn Φ V ∧ ∀ y ∈ V, Φ y ∈ LinearMap.range (fderiv ℝ ψ y : Euclid m →ₗ[ℝ] Euclid P) ∧ (∀ e : Euclid m, inner ℝ (Φ y) (fderiv ℝ ψ y e) = fderiv ℝ F y e) ∧ ∀ L : NNReal, (∀ e : Euclid m, |fderiv ℝ F y e| ≤ (L : ℝ) * ‖fderiv ℝ ψ y e‖) → ‖Φ y‖ ≤ (L : ℝ) := by
  classical
  intro m P V ψ F hV hψ hinj hF
  let A : Euclid m → (Euclid m →L[ℝ] Euclid P) := fun y => fderiv ℝ ψ y
  let Γ : Euclid m → (Euclid m →L[ℝ] Euclid m) :=
    fun y => (ContinuousLinearMap.adjoint (A y)).comp (A y)
  let a : Euclid m → Euclid m :=
    fun y => (InnerProductSpace.toDual ℝ (Euclid m)).symm (fderiv ℝ F y)
  -- `Γ(y)` is injective, hence a unit, on `V`
  have hunit : ∀ y ∈ V, IsUnit (Γ y) := by
    intro y hy
    rw [ContinuousLinearMap.isUnit_iff_isUnit_toLinearMap, LinearMap.isUnit_iff_ker_eq_bot,
      LinearMap.ker_eq_bot']
    intro e he
    have h1 : inner ℝ (Γ y e) e = ‖A y e‖ ^ 2 := by
      simp only [Γ, ContinuousLinearMap.comp_apply, ContinuousLinearMap.adjoint_inner_left]
      exact real_inner_self_eq_norm_sq (A y e)
    have h2 : Γ y e = 0 := he
    rw [h2, inner_zero_left] at h1
    have h3 : A y e = 0 := by
      have : ‖A y e‖ = 0 := by nlinarith [norm_nonneg (A y e)]
      exact norm_eq_zero.1 this
    exact hinj y hy (by simpa [A] using h3)
  refine ⟨fun y => A y (Ring.inverse (Γ y) (a y)), ?_, ?_⟩
  · -- continuity: `fderiv`, adjoint, composition, `Ring.inverse` at units, evaluation
    have hA : ContinuousOn A V := hψ.continuousOn_fderiv_of_isOpen hV le_rfl
    have hAadj : ContinuousOn (fun y => ContinuousLinearMap.adjoint (A y)) V :=
      (ContinuousLinearMap.adjoint (𝕜 := ℝ) (E := Euclid m) (F := Euclid P)).continuous
        |>.comp_continuousOn hA
    have hΓ : ContinuousOn Γ V := hAadj.clm_comp hA
    have hinv : ContinuousOn (fun y => Ring.inverse (Γ y)) V := by
      intro y hy
      obtain ⟨u, hu⟩ := hunit y hy
      have hc := NormedRing.inverse_continuousAt u
      rw [hu] at hc
      exact hc.comp_continuousWithinAt (hΓ y hy)
    have ha : Continuous a :=
      (InnerProductSpace.toDual ℝ (Euclid m)).symm.continuous.comp
        (hF.continuous_fderiv one_ne_zero)
    exact hA.clm_apply (hinv.clm_apply ha.continuousOn)
  · intro y hy
    set w := Ring.inverse (Γ y) (a y) with hw
    have hΓw : Γ y w = a y := by
      obtain ⟨u, hu⟩ := hunit y hy
      rw [hw, ← hu, Ring.inverse_unit, ← mul_apply_eq_comp, Units.mul_inv, one_apply_eq_self]
    -- the defining identity `⟨A w, A e⟩ = ⟨Γ w, e⟩ = ⟨a, e⟩ = DF(y) e`
    have hdef : ∀ e : Euclid m, inner ℝ (A y w) (fderiv ℝ ψ y e) = fderiv ℝ F y e := by
      intro e
      have : inner ℝ (A y w) (A y e) = inner ℝ (Γ y w) e := by
        simp only [Γ, ContinuousLinearMap.comp_apply, ContinuousLinearMap.adjoint_inner_left]
      change inner ℝ (A y w) (A y e) = _
      rw [this, hΓw]
      simp [a, InnerProductSpace.toDual_symm_apply]
    refine ⟨⟨w, rfl⟩, hdef, fun L hL => ?_⟩
    -- `|Φ|² = DF(y) w ≤ L |A w| = L |Φ|`
    have hsq : ‖A y w‖ ^ 2 ≤ (L : ℝ) * ‖A y w‖ := by
      rw [← real_inner_self_eq_norm_sq]
      calc inner ℝ (A y w) (A y w) = fderiv ℝ F y w := hdef w
        _ ≤ |fderiv ℝ F y w| := le_abs_self _
        _ ≤ (L : ℝ) * ‖fderiv ℝ ψ y w‖ := hL w
    change ‖A y w‖ ≤ (L : ℝ)
    by_cases h0 : ‖A y w‖ = 0
    · rw [h0]; exact L.coe_nonneg
    · have hpos : 0 < ‖A y w‖ := lt_of_le_of_ne (norm_nonneg _) (Ne.symm h0)
      nlinarith
/-- Borel gluing over pairwise disjoint injective images (Lusin–Souslin; the Borel field `g` on
the chart pieces in the slicing step of the proof of Simon 7.4.3): if `ψⱼ` is continuous and
injective and `Φⱼ` continuous on the Borel set `Yⱼ ⊆ ℝᵐ`, and the images `Mⱼ = ψⱼ(Yⱼ)` are
pairwise disjoint, then some Borel `g : ℝᴾ → ℝᴾ` has `g(ψⱼ(y)) = Φⱼ(y)` for `y ∈ Yⱼ` and `g = 0`
off `⋃ⱼ Mⱼ`.  `ψⱼ|_{Yⱼ}` is a measurable embedding, so the extension `gⱼ` of `Φⱼ|_{Yⱼ}` along it
by `0` is Borel; `g(x) = gₙ(x)` for the least `n` with `x ∈ Mₙ ∪ (⋃ⱼ Mⱼ)ᶜ`. -/
theorem Submission.dor_lmbsf_cp_measurable_glue : ∀ (m P : ℕ) (Y : ℕ → Set (Euclid m)) (ψ Φ : ℕ → Euclid m → Euclid P), (∀ j, MeasurableSet (Y j) ∧ ContinuousOn (ψ j) (Y j) ∧ InjOn (ψ j) (Y j) ∧ ContinuousOn (Φ j) (Y j)) → Pairwise (fun i j => Disjoint (ψ i '' Y i) (ψ j '' Y j)) → ∃ g : Euclid P → Euclid P, Measurable g ∧ (∀ j, ∀ y ∈ Y j, g (ψ j y) = Φ j y) ∧ ∀ x, (∀ j, x ∉ ψ j '' Y j) → g x = 0 := by
  classical
  intro m P Y ψ Φ hY hdisj
  -- Lusin–Souslin: `Mⱼ = ψⱼ(Yⱼ)` is Borel
  have hM : ∀ j, MeasurableSet (ψ j '' Y j) := fun j =>
    (hY j).1.image_of_continuousOn_injOn (hY j).2.1 (hY j).2.2.1
  -- `gⱼ`: the extension of `Φⱼ|_{Yⱼ}` by `0` along the measurable embedding `ψⱼ|_{Yⱼ}`
  obtain ⟨gj, hgj, hgj_val, hgj_zero⟩ : ∃ gj : ℕ → Euclid P → Euclid P,
      (∀ j, Measurable (gj j)) ∧ (∀ j, ∀ y ∈ Y j, gj j (ψ j y) = Φ j y) ∧
        ∀ j x, x ∉ ψ j '' Y j → gj j x = 0 := by
    have hemb : ∀ j, MeasurableEmbedding ((Y j).domRestrict (ψ j)) := fun j =>
      (hY j).2.1.measurableEmbedding (hY j).1 (hY j).2.2.1
    refine ⟨fun j => Function.extend ((Y j).domRestrict (ψ j)) ((Y j).domRestrict (Φ j)) 0,
      fun j => (hemb j).measurable_extend (hY j).2.2.2.domRestrict.measurable measurable_const,
      fun j y hy => (hemb j).injective.extend_apply _ _ ⟨y, hy⟩, fun j x hx => ?_⟩
    refine Function.extend_apply' _ _ x ?_
    rintro ⟨y, hy⟩
    exact hx ⟨y, y.2, hy⟩
  -- glue by least index: `g(x) = gₙ(x)` for the least `n` with `x ∈ Mₙ ∪ (⋃ⱼ Mⱼ)ᶜ`
  have hp : ∀ x, ∃ n, x ∈ ψ n '' Y n ∪ (⋃ j, ψ j '' Y j)ᶜ := fun x => by
    by_cases hx : x ∈ ⋃ j, ψ j '' Y j
    · obtain ⟨j, hj⟩ := Set.mem_iUnion.1 hx
      exact ⟨j, Set.mem_union_left _ hj⟩
    · exact ⟨0, Set.mem_union_right _ (Set.mem_compl hx)⟩
  refine ⟨fun x => gj (Nat.find (hp x)) x,
    Measurable.find (p := fun n x => x ∈ ψ n '' Y n ∪ (⋃ j, ψ j '' Y j)ᶜ) hgj
      (fun n => (hM n).union (MeasurableSet.iUnion hM).compl) hp, ?_, ?_⟩
  · -- at `ψⱼ(y)` the least index is `j`, by disjointness
    intro j y hy
    have hx : ψ j y ∈ ψ j '' Y j := Set.mem_image_of_mem _ hy
    have hfind : Nat.find (hp (ψ j y)) = j := by
      rcases Nat.find_spec (hp (ψ j y)) with h | h
      · by_contra hne
        exact Set.disjoint_left.1 (hdisj hne) h hx
      · exact absurd (Set.mem_iUnion.2 ⟨j, hx⟩) h
    show gj (Nat.find (hp (ψ j y))) (ψ j y) = Φ j y
    rw [hfind]
    exact hgj_val j y hy
  · -- off `⋃ⱼ Mⱼ` every `gₙ` vanishes
    intro x hx
    exact hgj_zero _ x (hx _)
/-- **A `C¹` immersion is locally injective.**  If `G : ℝᵐ → ℝᴾ` is `C¹` and `DG(x)` is injective,
then for some `r > 0` the map `G` and every `DG(z)`, `z ∈ B̄_r(x)`, are injective.  `L = DG(x)` is
anti-Lipschitz on the finite-dimensional `ℝᵐ`, `c ‖v‖ ≤ ‖L v‖` with `c > 0`, and continuity of
`DG` gives `‖DG(z) - L‖ ≤ c/2` on `B̄_r(x)`.  If `DG(z) u = 0` then
`c ‖u‖ ≤ ‖L u‖ = ‖(DG(z) - L) u‖ ≤ (c/2) ‖u‖`; if `G a = G b`, the mean value inequality
`‖G a - G b - L (a - b)‖ ≤ (c/2) ‖a - b‖` gives `c ‖a - b‖ ≤ (c/2) ‖a - b‖`.  So `u = 0`, `a = b`. -/
theorem Submission.dor_lmbsf_c1c_immersion_local_injOn : ∀ (P m : ℕ) (G : Euclid m → Euclid P) (x : Euclid m), ContDiff ℝ 1 G → Function.Injective (fderiv ℝ G x) → ∃ r : ℝ, 0 < r ∧ Set.InjOn G (Metric.closedBall x r) ∧ ∀ z ∈ Metric.closedBall x r, Function.Injective (fderiv ℝ G z) := by
  intro P m G x hG hx
  set L : Euclid m →L[ℝ] Euclid P := fderiv ℝ G x
  -- `L` is injective on the finite-dimensional `ℝᵐ`, hence anti-Lipschitz: `c ‖v‖ ≤ ‖L v‖`
  obtain ⟨K, hKpos, hK⟩ :=
    (L : Euclid m →ₗ[ℝ] Euclid P).exists_antilipschitzWith (LinearMap.ker_eq_bot.2 hx)
  have hK' : (0 : ℝ) < K := hKpos
  set c : ℝ := (K : ℝ)⁻¹
  have hcpos : 0 < c := inv_pos.2 hK'
  have hLc : ∀ v, c * ‖v‖ ≤ ‖L v‖ := fun v =>
    (inv_mul_le_iff₀ hK').2 (L.bound_of_antilipschitz hK v)
  -- continuity of `DG` gives `δ > 0` with `‖DG(z) - L‖ ≤ c/2` on `B̄_{δ/2}(x)`
  obtain ⟨δ, hδpos, hδ⟩ :=
    Metric.continuous_iff.1 (hG.continuous_fderiv one_ne_zero) x (c / 2) (half_pos hcpos)
  have hbound : ∀ z ∈ closedBall x (δ / 2), ‖fderiv ℝ G z - L‖ ≤ c / 2 := by
    intro z hz
    have h := hδ z (lt_of_le_of_lt (mem_closedBall.1 hz) (half_lt_self hδpos))
    rw [dist_eq_norm] at h
    exact h.le
  refine ⟨δ / 2, half_pos hδpos, ?_, ?_⟩
  · -- mean value inequality: `‖G a - G b - L (a - b)‖ ≤ (c/2) ‖a - b‖`
    intro a ha b hb hab
    have hmvt := (convex_closedBall x (δ / 2)).norm_image_sub_le_of_norm_fderiv_le'
      (fun z _ => (hG.differentiable one_ne_zero) z) hbound hb ha
    rw [hab, sub_self, zero_sub, norm_neg] at hmvt
    have h1 := hLc (a - b)
    have h2 : ‖a - b‖ = 0 :=
      le_antisymm (by nlinarith [norm_nonneg (a - b)]) (norm_nonneg _)
    exact sub_eq_zero.1 (norm_eq_zero.1 h2)
  · -- if `DG(z) u = 0` then `c ‖u‖ ≤ ‖L u‖ = ‖(DG(z) - L) u‖ ≤ (c/2) ‖u‖`
    intro z hz v w hvw
    have hu : fderiv ℝ G z (v - w) = 0 := by rw [map_sub, hvw, sub_self]
    have h1 := hLc (v - w)
    have h2 : ‖L (v - w)‖ ≤ c / 2 * ‖v - w‖ := by
      have h3 : L (v - w) = -((fderiv ℝ G z - L) (v - w)) := by
        rw [sub_apply, hu, zero_sub, neg_neg]
      rw [h3, norm_neg]
      calc ‖(fderiv ℝ G z - L) (v - w)‖ ≤ ‖fderiv ℝ G z - L‖ * ‖v - w‖ :=
            ContinuousLinearMap.le_opNorm _ _
        _ ≤ c / 2 * ‖v - w‖ := by gcongr; exact hbound z hz
    have h4 : ‖v - w‖ = 0 :=
      le_antisymm (by nlinarith [norm_nonneg (v - w)]) (norm_nonneg _)
    exact sub_eq_zero.1 (norm_eq_zero.1 h4)
/-- **A `C¹` chart on a ball** (Simon Ch. 3, proof of Lemma 1.2, step 5): if `G : ℝᵐ → ℝᴾ` is
`C¹`, injective on `B̄_r(x)` and has injective derivative on `B_r(x)`, then `G(B_r(x))` is an
embedded `m`-dimensional `C¹` submanifold.  Every point is charted by `ψ = G` on `V = B_r(x)`
with `W = ℝᴾ \ G(∂B_r(x))`: `W` is open because the sphere is compact; injectivity on `B̄_r(x)`
gives `G(B_r(x)) ⊆ W`, so `ψ(V) = W ∩ G(B_r(x))`; and for compact `K ⊆ W`, sphere points map
outside `K`, so `B_r(x) ∩ G⁻¹(K) = B̄_r(x) ∩ G⁻¹(K)` is compact. -/
theorem Submission.dor_lmbsf_c1c_injOn_closedBall_chart : ∀ (P m : ℕ) (G : Euclid m → Euclid P) (x : Euclid m) (r : ℝ), ContDiff ℝ 1 G → Set.InjOn G (Metric.closedBall x r) → (∀ z ∈ Metric.ball x r, Function.Injective (fderiv ℝ G z)) → IsEmbeddedSubmanifold 1 m (G '' Metric.ball x r) := by
  intro P m G x r hG hinj hD
  -- `W = ℝᴾ \ G(∂B_r(x))` is open: the sphere is compact and `G` is continuous
  have hW : IsOpen (G '' Metric.sphere x r)ᶜ :=
    ((isCompact_sphere x r).image hG.continuous).isClosed.isOpen_compl
  -- `G(B_r(x)) ⊆ W`: `G` is injective on `B̄_r(x)` and the sphere misses the open ball
  have hNW : G '' Metric.ball x r ⊆ (G '' Metric.sphere x r)ᶜ := by
    rintro _ ⟨v, hv, rfl⟩ ⟨s, hs, hsv⟩
    have hsv' : s = v :=
      hinj (Metric.sphere_subset_closedBall hs) (Metric.ball_subset_closedBall hv) hsv
    subst hsv'
    exact (Metric.mem_ball.1 hv).ne (Metric.mem_sphere.1 hs)
  -- the same chart `(V, W, ψ) = (B_r(x), W, G)` serves every point of `G(B_r(x))`
  intro y hy
  refine ⟨Metric.ball x r, (G '' Metric.sphere x r)ᶜ, G, Metric.isOpen_ball, hW, hNW hy, ?_,
    hinj.mono Metric.ball_subset_closedBall, (Set.inter_eq_right.2 hNW).symm, ?_, hD⟩
  · exact_mod_cast hG.contDiffOn
  -- properness: for compact `K ⊆ W`, `B_r(x) ∩ G⁻¹(K) = B̄_r(x) ∩ G⁻¹(K)` is compact
  · intro K hKW hK
    have hball : Metric.ball x r ∩ G ⁻¹' K = Metric.closedBall x r ∩ G ⁻¹' K := by
      refine Set.Subset.antisymm
        (Set.inter_subset_inter_left _ Metric.ball_subset_closedBall) ?_
      rintro z ⟨hz, hzK⟩
      refine ⟨?_, hzK⟩
      rcases (Metric.mem_closedBall.1 hz).lt_or_eq with h | h
      · exact Metric.mem_ball.2 h
      · exact (hKW (Set.mem_preimage.1 hzK) ⟨z, Metric.mem_sphere.2 h, rfl⟩).elim
    rw [hball]
    exact (isCompact_closedBall x r).inter_right (hK.isClosed.preimage hG.continuous)
/-- **A Lipschitz map `ℝᵐ → ℝᴾ` agrees with countably many `C¹` maps off a set with `Hᵐ`-null
image** (Simon Ch. 3, proof of Lemma 1.2), given the scalar `C¹` approximation (H) of Ch. 2,
Theorem 1.5.  Apply (H) to each `K`-Lipschitz coordinate `Fᵖ` with `ε = 1/i` and put
`Gᵢ = (g_{ip})_p`, so `Lᵐ({F ≠ Gᵢ}) ≤ Σ_p Lᵐ({Fᵖ ≠ g_{ip}}) ≤ P/i`.  Hence `Z = ⋂ᵢ {F ≠ Gᵢ}` is
`Lᵐ`-null, `E = F(Z)` has `Hᵐ(E) ≤ Kᵐ Hᵐ(Z) = Kᵐ Lᵐ(Z) = 0`, and off `Z`, `F = Gᵢ` for some `i`. -/
theorem Submission.dor_lmbsf_c1c_lipschitz_range_c1_pieces : ∀ (P m : ℕ) (F : Euclid m → Euclid P) (K : NNReal), LipschitzWith K F → (∀ (u : Euclid m → ℝ) (L : NNReal), LipschitzWith L u → ∀ ε : ℝ≥0∞, 0 < ε → ∃ g : Euclid m → ℝ, ContDiff ℝ 1 g ∧ volume {y | u y ≠ g y} < ε) → ∃ (E : Set (Euclid P)) (G : ℕ → Euclid m → Euclid P), μHE[m] E = 0 ∧ (∀ i, ContDiff ℝ 1 (G i)) ∧ Set.range F ⊆ E ∪ ⋃ i, Set.range (G i) := by
  intro P m F K hF H
  -- the coordinates `Fᵖ` are `K`-Lipschitz, since `|a_p| ≤ |a|`
  have hcoord : ∀ p : Fin P, LipschitzWith K fun y => F y p := by
    intro p
    refine LipschitzWith.of_dist_le_mul fun a b => ?_
    calc dist (F a p) (F b p) = ‖(F a - F b) p‖ := by
          rw [PiLp.sub_apply, Real.dist_eq, Real.norm_eq_abs]
      _ ≤ ‖F a - F b‖ := PiLp.norm_apply_le _ _
      _ = dist (F a) (F b) := (dist_eq_norm _ _).symm
      _ ≤ K * dist a b := hF.dist_le_mul a b
  -- (H) for each coordinate with `ε = 1/i`: `Lᵐ({Fᵖ ≠ g_{ip}}) < 1/i`
  choose g hg hgvol using fun (i : ℕ) (p : Fin P) =>
    H (fun y => F y p) K (hcoord p) (i : ℝ≥0∞)⁻¹ (ENNReal.inv_pos.2 (ENNReal.natCast_ne_top i))
  -- `Gᵢ = (g_{ip})_p` is `C¹`
  obtain ⟨G, hGp⟩ : ∃ G : ℕ → Euclid m → Euclid P, ∀ i y p, G i y p = g i p y :=
    ⟨fun i y => WithLp.toLp 2 fun p => g i p y, fun _ _ _ => rfl⟩
  have hGc : ∀ i, ContDiff ℝ 1 (G i) := fun i =>
    (contDiff_piLp 2).2 fun p => by simpa only [hGp] using hg i p
  -- `Z = ⋂ᵢ {F ≠ Gᵢ}`: `Lᵐ(Z) ≤ Lᵐ({F ≠ Gᵢ}) ≤ Σ_p Lᵐ({Fᵖ ≠ g_{ip}}) ≤ P/i`
  set Z : Set (Euclid m) := ⋂ i, {y | F y ≠ G i y} with hZ_def
  have hZi : ∀ i : ℕ, volume Z ≤ (P : ℝ≥0∞) * (i : ℝ≥0∞)⁻¹ := by
    intro i
    calc volume Z ≤ volume (⋃ p : Fin P, {y | F y p ≠ g i p y}) := by
          refine measure_mono fun y hy => ?_
          have hne : F y ≠ G i y := mem_iInter.1 hy i
          by_contra hcon
          simp only [mem_iUnion, mem_ofPred_eq, not_exists, not_not] at hcon
          exact hne (PiLp.ext fun p => by rw [hGp, hcon p])
      _ ≤ ∑ p : Fin P, volume {y | F y p ≠ g i p y} := measure_iUnion_fintype_le _ _
      _ ≤ ∑ _p : Fin P, (i : ℝ≥0∞)⁻¹ := Finset.sum_le_sum fun p _ => (hgvol i p).le
      _ = (P : ℝ≥0∞) * (i : ℝ≥0∞)⁻¹ := by simp
  -- `P/i → 0`, so `Lᵐ(Z) = 0`
  have hZ0 : volume Z = 0 := by
    have ht := ENNReal.Tendsto.const_mul ENNReal.tendsto_inv_nat_nhds_zero
      (Or.inr (ENNReal.natCast_ne_top P))
    rw [mul_zero] at ht
    exact le_antisymm (ge_of_tendsto' ht hZi) zero_le
  refine ⟨F '' Z, G, ?_, hGc, ?_⟩
  · -- `Hᵐ(F(Z)) ≤ Kᵐ Hᵐ(Z) = Kᵐ Lᵐ(Z) = 0`
    have h := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn m
      (hF.lipschitzOnWith (s := Z))
    rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume m, hZ0, mul_zero] at h
    exact le_antisymm h zero_le
  · -- `F z ∈ F(Z)` if `z ∈ Z`, otherwise `F z = Gᵢ z` for some `i`
    rintro _ ⟨z, rfl⟩
    by_cases hz : z ∈ Z
    · exact Or.inl ⟨z, hz, rfl⟩
    · rw [hZ_def] at hz
      simp only [mem_iInter, mem_ofPred_eq, not_forall, not_not] at hz
      obtain ⟨i, hi⟩ := hz
      exact Or.inr (mem_iUnion.2 ⟨i, z, hi.symm⟩)
/-- **Simon Ch. 3, proof of Lemma 1.2 ("only if"), last paragraph**, for one `C¹` map
`G : ℝᵐ → ℝᴾ`: `G(ℝᵐ) ⊆ N₀ ∪ ⋃ₗ Nₗ` with `Hᵐ(N₀) = 0` and each `Nₗ` an embedded `C¹`
`m`-submanifold.  `N₀ = G({x : DG(x) not injective})` is `Hᵐ`-null (Simon: by the area formula of
Ch. 2 §3).  Here this is checked directly: if `DG(x) e = 0`, `|e| = 1`, and `‖DG - DG(x)‖ ≤ λM`,
`‖DG‖ ≤ M` on `B̄_ρ(x)`, then with `Ψ = id + (λ⁻¹ - 1) e ⊗ e` (`det Ψ = λ⁻¹`) the map `G ∘ Ψ` is
`2M`-Lipschitz on `Ψ⁻¹(B̄_ρ(x))`, so `Hᵐ(G(B̄_ρ(x))) ≤ (2M)ᵐ λ |B̄_ρ(x)|`; a Besicovitch disjoint
cover of the critical points in `B_R(0)` gives `Hᵐ(G(·)) ≤ (2M)ᵐ λ |B̄_{R+1}(0)|` for every `λ`.
At a regular point `x`, `G` is injective with injective derivative on some `B̄_{r_x}(x)`, so
`G(B_{r_x}(x))` is a submanifold; countably many of these balls cover the regular set (Lindelöf,
left implicit by Simon), and no ball is needed if it is empty. -/
theorem Submission.dor_lmbsf_c1c_c1_range_cover : ∀ (P m : ℕ) (G : Euclid m → Euclid P), ContDiff ℝ 1 G → ∃ (N₀ : Set (Euclid P)) (N : ℕ → Set (Euclid P)), μHE[m] N₀ = 0 ∧ (∀ l, IsEmbeddedSubmanifold 1 m (N l)) ∧ Set.range G ⊆ N₀ ∪ ⋃ l, N l := by
  intro P m G hG
  -- Step 1: `G` is differentiable everywhere, with continuous derivative.
  have hGd : Differentiable ℝ G := hG.differentiable one_ne_zero
  have hDG : Continuous (fderiv ℝ G) := hG.continuous_fderiv one_ne_zero
  -- Step 2: the critical image `N₀ = G({x : DG(x) not injective})` is `Hᵐ`-null.
  have hN₀ : μHE[m] (G '' {x | ¬ Injective (fderiv ℝ G x)}) = 0 := by
    have hvol : (μHE[m] : Measure (Euclid m)) = volume :=
      EuclideanSpace.euclideanHausdorffMeasure_eq_volume m
    have hcov : {x | ¬ Injective (fderiv ℝ G x)} =
        ⋃ k : ℕ, {x | ¬ Injective (fderiv ℝ G x)} ∩ ball (0 : Euclid m) k := by
      rw [← inter_iUnion, iUnion_ball_nat, inter_univ]
    rw [hcov, image_iUnion]
    refine measure_iUnion_null fun k => ?_
    set R : ℝ := (k : ℝ)
    obtain ⟨M₀, hM₀⟩ := (isCompact_closedBall (0 : Euclid m) (R + 1)).exists_bound_of_continuousOn
      hDG.continuousOn
    set M : ℝ := max M₀ 1
    have hM : 0 < M := lt_of_lt_of_le one_pos (le_max_right _ _)
    have hMK : ∀ y ∈ closedBall (0 : Euclid m) (R + 1), ‖fderiv ℝ G y‖ ≤ M :=
      fun y hy => (hM₀ y hy).trans (le_max_left _ _)
    -- one ball `B̄_ρ(x)` around a critical point `x`
    have hloc : ∀ lam : ℝ, 0 < lam → lam ≤ 1 → ∀ x, ¬ Injective (fderiv ℝ G x) → ∀ ρ : ℝ,
        (∀ y ∈ closedBall x ρ, ‖fderiv ℝ G y - fderiv ℝ G x‖ ≤ lam * M) →
        closedBall x ρ ⊆ closedBall 0 (R + 1) →
        μHE[m] (G '' closedBall x ρ) ≤
          ((2 * M).toNNReal : ℝ≥0∞) ^ m * ENNReal.ofReal lam * volume (closedBall x ρ) := by
      intro lam hlam0 hlam1 x hx ρ hρ hρK
      obtain ⟨v, hv0, hv⟩ : ∃ v, fderiv ℝ G x v = 0 ∧ v ≠ 0 := by
        simpa only [injective_iff_map_eq_zero, not_forall, exists_prop] using hx
      set e : Euclid m := (‖v‖⁻¹ : ℝ) • v
      have he : ‖e‖ = 1 := norm_smul_inv_norm hv
      have hee : inner ℝ e e = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, he, one_pow]
      have hDe : fderiv ℝ G x e = 0 := by simp [e, hv0]
      set Ψ : Euclid m →L[ℝ] Euclid m :=
        ContinuousLinearMap.id ℝ _ + (lam⁻¹ - 1) • (innerSL ℝ e).smulRight e
      have hΨ : ∀ u, Ψ u = u + ((lam⁻¹ - 1) * inner ℝ e u) • e := by
        intro u
        simp [Ψ, smul_smul]
      -- `det Ψ = 1 + (λ⁻¹ - 1) |e|² = λ⁻¹` (matrix determinant lemma)
      have hdet : LinearMap.det (Ψ : Euclid m →ₗ[ℝ] Euclid m) = lam⁻¹ := by
        have hee' : e.ofLp ⬝ᵥ e.ofLp = 1 := by
          rw [← hee, EuclideanSpace.inner_eq_star_dotProduct]
          simp
        set b := (EuclideanSpace.basisFun (Fin m) ℝ).toBasis
        have hmat : LinearMap.toMatrix b b (Ψ : Euclid m →ₗ[ℝ] Euclid m) =
            1 + Matrix.replicateCol Unit ((lam⁻¹ - 1) • e.ofLp) * Matrix.replicateRow Unit e.ofLp := by
          ext i j
          simp [LinearMap.toMatrix_apply, b, hΨ, Matrix.one_apply, Matrix.mul_apply,
            EuclideanSpace.inner_single_right, PiLp.single_apply]
          ring
        rw [← LinearMap.det_toMatrix b, hmat, Matrix.det_one_add_replicateCol_mul_replicateRow,
          dotProduct_smul, hee', smul_eq_mul, mul_one]
        ring
      have hsurj : Surjective Ψ := by
        intro y
        refine ⟨y + ((lam - 1) * inner ℝ e y) • e, ?_⟩
        have hcoef : (lam - 1) * inner ℝ e y +
            (lam⁻¹ - 1) * (inner ℝ e y + (lam - 1) * inner ℝ e y * 1) = 0 := by
          field_simp
          ring
        rw [hΨ, inner_add_right, inner_smul_right, hee, add_assoc, ← add_smul, hcoef, zero_smul,
          add_zero]
      -- `D(G ∘ Ψ) u = DG u + (λ⁻¹ - 1) ⟨e, u⟩ DG e` with `‖DG e‖ = ‖(DG - DG(x)) e‖ ≤ λM`
      have hLip : LipschitzOnWith (2 * M).toNNReal (G ∘ Ψ) (Ψ ⁻¹' closedBall x ρ) := by
        refine Convex.lipschitzOnWith_of_nnnorm_fderiv_le (𝕜 := ℝ)
          (fun z _ => (hGd (Ψ z)).comp z Ψ.differentiableAt) (fun z hz => ?_)
          ((convex_closedBall x ρ).linear_preimage (Ψ : Euclid m →ₗ[ℝ] Euclid m))
        have hy : Ψ z ∈ closedBall x ρ := hz
        rw [fderiv_comp z (hGd (Ψ z)) Ψ.differentiableAt, ContinuousLinearMap.fderiv,
          ← NNReal.coe_le_coe, coe_nnnorm, Real.coe_toNNReal _ (by positivity)]
        refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) fun u => ?_
        have h1 : ‖fderiv ℝ G (Ψ z) u‖ ≤ M * ‖u‖ :=
          ((fderiv ℝ G (Ψ z)).le_opNorm u).trans
            (mul_le_mul_of_nonneg_right (hMK _ (hρK hy)) (norm_nonneg _))
        have h2 : ‖fderiv ℝ G (Ψ z) e‖ ≤ lam * M := by
          have h3 : fderiv ℝ G (Ψ z) e = (fderiv ℝ G (Ψ z) - fderiv ℝ G x) e := by
            rw [sub_apply, hDe, sub_zero]
          rw [h3]
          calc ‖(fderiv ℝ G (Ψ z) - fderiv ℝ G x) e‖
              ≤ ‖fderiv ℝ G (Ψ z) - fderiv ℝ G x‖ * ‖e‖ := ContinuousLinearMap.le_opNorm _ _
            _ ≤ lam * M := by rw [he, mul_one]; exact hρ _ hy
        have h4 : |lam⁻¹ - 1| ≤ lam⁻¹ := by
          have : 1 ≤ lam⁻¹ := (one_le_inv₀ hlam0).2 hlam1
          rw [abs_of_nonneg (by linarith)]
          linarith
        have h5 : |inner ℝ e u| ≤ ‖u‖ := by
          simpa [he] using abs_real_inner_le_norm e u
        rw [ContinuousLinearMap.comp_apply, hΨ u, map_add, map_smul]
        calc ‖fderiv ℝ G (Ψ z) u + ((lam⁻¹ - 1) * inner ℝ e u) • fderiv ℝ G (Ψ z) e‖
            ≤ ‖fderiv ℝ G (Ψ z) u‖ + ‖((lam⁻¹ - 1) * inner ℝ e u) • fderiv ℝ G (Ψ z) e‖ :=
              norm_add_le _ _
          _ = ‖fderiv ℝ G (Ψ z) u‖ + |lam⁻¹ - 1| * |inner ℝ e u| * ‖fderiv ℝ G (Ψ z) e‖ := by
              rw [norm_smul, Real.norm_eq_abs, abs_mul]
          _ ≤ M * ‖u‖ + lam⁻¹ * ‖u‖ * (lam * M) := by gcongr
          _ = 2 * M * ‖u‖ := by
              rw [show lam⁻¹ * ‖u‖ * (lam * M) = (lam⁻¹ * lam) * (M * ‖u‖) by ring,
                inv_mul_cancel₀ hlam0.ne', one_mul]
              ring
      have hvolΨ : volume (Ψ ⁻¹' closedBall x ρ) = ENNReal.ofReal lam * volume (closedBall x ρ) := by
        rw [Measure.addHaar_preimage_continuousLinearMap volume
          (by rw [hdet]; exact inv_ne_zero hlam0.ne'), hdet, inv_inv, abs_of_pos hlam0]
      calc μHE[m] (G '' closedBall x ρ) = μHE[m] ((G ∘ Ψ) '' (Ψ ⁻¹' closedBall x ρ)) := by
            rw [image_comp, image_preimage_eq _ hsurj]
        _ ≤ ((2 * M).toNNReal : ℝ≥0∞) ^ m * μHE[m] (Ψ ⁻¹' closedBall x ρ) :=
            Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn m hLip
        _ = ((2 * M).toNNReal : ℝ≥0∞) ^ m * ENNReal.ofReal lam * volume (closedBall x ρ) := by
            rw [hvol, hvolΨ, mul_assoc]
    -- `G` is `M`-Lipschitz on `B̄_{R+1}(0)`, so it maps volume-null sets there to `Hᵐ`-null sets
    have hLipK : LipschitzOnWith M.toNNReal G (closedBall 0 (R + 1)) := by
      refine Convex.lipschitzOnWith_of_nnnorm_fderiv_le (𝕜 := ℝ) (fun y _ => hGd y)
        (fun y hy => ?_) (convex_closedBall _ _)
      rw [← NNReal.coe_le_coe, coe_nnnorm, Real.coe_toNNReal _ hM.le]
      exact hMK y hy
    -- Besicovitch: disjoint balls `B̄_{ρ x}(x)` with `ρ x < r x` cover almost all critical points
    have hmain : ∀ lam : ℝ, 0 < lam → lam ≤ 1 →
        μHE[m] (G '' ({x | ¬ Injective (fderiv ℝ G x)} ∩ ball 0 R)) ≤
          ((2 * M).toNNReal : ℝ≥0∞) ^ m * ENNReal.ofReal lam *
            volume (closedBall (0 : Euclid m) (R + 1)) := by
      intro lam hlam0 hlam1
      have hr : ∀ x : Euclid m, ∃ r : ℝ, 0 < r ∧ r ≤ 1 ∧
          ∀ y ∈ ball x r, ‖fderiv ℝ G y - fderiv ℝ G x‖ < lam * M := by
        intro x
        obtain ⟨δ, hδ, hδ'⟩ := Metric.continuous_iff.1 hDG x (lam * M) (by positivity)
        refine ⟨min δ 1, lt_min hδ one_pos, min_le_right _ _, fun y hy => ?_⟩
        have h := hδ' y (lt_of_lt_of_le (mem_ball.1 hy) (min_le_left _ _))
        rwa [dist_eq_norm] at h
      choose r hr0 hr1 hr using hr
      obtain ⟨t, ρ, ht, hts, hρ, hnull, hdisj⟩ := Besicovitch.exists_disjoint_closedBall_covering_ae
        volume (fun _ => univ) ({x | ¬ Injective (fderiv ℝ G x)} ∩ ball 0 R)
        (fun _ _ δ hδ => ⟨δ / 2, mem_univ _, half_pos hδ, half_lt_self hδ⟩) r (fun x _ => hr0 x)
      have hballK : ∀ x ∈ t, closedBall x (ρ x) ⊆ closedBall 0 (R + 1) := by
        intro x hx y hy
        have hx' : ‖x‖ < R := mem_ball_zero_iff.1 (hts hx).2
        rw [mem_closedBall, dist_eq_norm] at hy
        rw [mem_closedBall_zero_iff]
        calc ‖y‖ = ‖(y - x) + x‖ := by rw [sub_add_cancel]
          _ ≤ ‖y - x‖ + ‖x‖ := norm_add_le _ _
          _ ≤ R + 1 := by linarith [(hρ x hx).2.2, hr1 x]
      have hsub : G '' ({x | ¬ Injective (fderiv ℝ G x)} ∩ ball 0 R) ⊆
          G '' (({x | ¬ Injective (fderiv ℝ G x)} ∩ ball 0 R) \ ⋃ x ∈ t, closedBall x (ρ x)) ∪
            ⋃ x ∈ t, G '' closedBall x (ρ x) := by
        rintro _ ⟨y, hy, rfl⟩
        by_cases hyU : y ∈ ⋃ x ∈ t, closedBall x (ρ x)
        · obtain ⟨x, hx, hyx⟩ := mem_iUnion₂.1 hyU
          exact Or.inr (mem_iUnion₂.2 ⟨x, hx, mem_image_of_mem G hyx⟩)
        · exact Or.inl (mem_image_of_mem G ⟨hy, hyU⟩)
      have h0 : μHE[m] (G '' (({x | ¬ Injective (fderiv ℝ G x)} ∩ ball 0 R) \
          ⋃ x ∈ t, closedBall x (ρ x))) = 0 := by
        refine le_antisymm ?_ bot_le
        calc μHE[m] (G '' (({x | ¬ Injective (fderiv ℝ G x)} ∩ ball 0 R) \
                ⋃ x ∈ t, closedBall x (ρ x)))
            ≤ (M.toNNReal : ℝ≥0∞) ^ m * μHE[m] (({x | ¬ Injective (fderiv ℝ G x)} ∩ ball 0 R) \
                ⋃ x ∈ t, closedBall x (ρ x)) :=
              Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn m
                (hLipK.mono fun y hy =>
                  closedBall_subset_closedBall (by linarith) (ball_subset_closedBall hy.1.2))
          _ = 0 := by rw [hvol, hnull, mul_zero]
      calc μHE[m] (G '' ({x | ¬ Injective (fderiv ℝ G x)} ∩ ball 0 R))
          ≤ μHE[m] (G '' (({x | ¬ Injective (fderiv ℝ G x)} ∩ ball 0 R) \
              ⋃ x ∈ t, closedBall x (ρ x))) + μHE[m] (⋃ x ∈ t, G '' closedBall x (ρ x)) :=
            (measure_mono hsub).trans (measure_union_le _ _)
        _ ≤ ∑' x : t, μHE[m] (G '' closedBall (x : Euclid m) (ρ x)) := by
            rw [h0, zero_add]
            exact measure_biUnion_le _ ht _
        _ ≤ ∑' x : t, ((2 * M).toNNReal : ℝ≥0∞) ^ m * ENNReal.ofReal lam *
              volume (closedBall (x : Euclid m) (ρ x)) :=
            ENNReal.tsum_le_tsum fun x => hloc lam hlam0 hlam1 x (hts x.2).1 (ρ x)
              (fun y hy => (hr x y (closedBall_subset_ball (hρ x x.2).2.2 hy)).le) (hballK x x.2)
        _ = ((2 * M).toNNReal : ℝ≥0∞) ^ m * ENNReal.ofReal lam *
              volume (⋃ x ∈ t, closedBall x (ρ x)) := by
            rw [ENNReal.tsum_mul_left, measure_biUnion ht hdisj fun _ _ => measurableSet_closedBall]
        _ ≤ ((2 * M).toNNReal : ℝ≥0∞) ^ m * ENNReal.ofReal lam *
              volume (closedBall (0 : Euclid m) (R + 1)) := by
            gcongr
            exact iUnion₂_subset hballK
    -- let `λ → 0`
    have hlim : Tendsto (fun lam : ℝ => ((2 * M).toNNReal : ℝ≥0∞) ^ m * ENNReal.ofReal lam *
        volume (closedBall (0 : Euclid m) (R + 1))) (𝓝[>] 0) (𝓝 0) := by
      have h1 : Tendsto (fun lam : ℝ => ENNReal.ofReal lam) (𝓝[>] 0) (𝓝 0) := by
        simpa using (ENNReal.tendsto_ofReal (tendsto_id (x := 𝓝 (0 : ℝ)))).mono_left
          nhdsWithin_le_nhds
      simpa using ENNReal.Tendsto.mul_const (ENNReal.Tendsto.const_mul h1
        (Or.inr (ENNReal.pow_ne_top ENNReal.coe_ne_top))) (Or.inr measure_closedBall_lt_top.ne)
    refine le_antisymm (ge_of_tendsto hlim ?_) bot_le
    filter_upwards [Ioo_mem_nhdsGT one_pos] with lam hlam
    exact hmain lam hlam.1 hlam.2.le
  have hcrit : ∀ x, ¬ Injective (fderiv ℝ G x) → G x ∈ G '' {x | ¬ Injective (fderiv ℝ G x)} :=
    fun x hx => mem_image_of_mem G hx
  -- Step 3: at a regular point `x`, `G(B_{r_x}(x))` is an embedded `C¹` `m`-submanifold.
  have hchart : ∀ x : {x : Euclid m // Injective (fderiv ℝ G x)}, ∃ r : ℝ, 0 < r ∧
      IsEmbeddedSubmanifold 1 m (G '' ball (x : Euclid m) r) := by
    rintro ⟨x, hx⟩
    obtain ⟨r, hr, hinj, hder⟩ := Submission.dor_lmbsf_c1c_immersion_local_injOn P m G x hG hx
    exact ⟨r, hr, Submission.dor_lmbsf_c1c_injOn_closedBall_chart P m G x r hG hinj
      fun z hz => hder z (ball_subset_closedBall hz)⟩
  choose r hr hN using hchart
  -- Step 4: with no regular point, `Nₗ = ∅` (vacuously a submanifold) and `G(ℝᵐ) ⊆ N₀`.
  rcases isEmpty_or_nonempty {x : Euclid m // Injective (fderiv ℝ G x)} with hR | hR
  · refine ⟨_, fun _ => ∅, hN₀, fun _ y hy => absurd hy (notMem_empty y), ?_⟩
    rintro _ ⟨x, rfl⟩
    exact Or.inl (hcrit x fun hx => hR.false ⟨x, hx⟩)
  -- Otherwise countably many balls `B_{r_{xₗ}}(xₗ)` cover the regular set (Lindelöf).
  obtain ⟨f, hf⟩ := (HereditarilyLindelofSpace.isLindelof
    {x : Euclid m | Injective (fderiv ℝ G x)}).indexed_countable_subcover
    (fun x : {x : Euclid m // Injective (fderiv ℝ G x)} => ball (x : Euclid m) (r x))
    (fun _ => isOpen_ball) fun x hx => mem_iUnion.mpr ⟨⟨x, hx⟩, mem_ball_self (hr _)⟩
  refine ⟨_, fun l => G '' ball (f l : Euclid m) (r (f l)), hN₀, fun l => hN (f l), ?_⟩
  -- Step 5: `G(x) ∈ N₀` if `x` is critical, and `G(x) ∈ Nₗ` if `x ∈ B_{r_{xₗ}}(xₗ)`.
  rintro _ ⟨x, rfl⟩
  by_cases hx : Injective (fderiv ℝ G x)
  · obtain ⟨l, hl⟩ := mem_iUnion.mp
      (hf (show x ∈ {x : Euclid m | Injective (fderiv ℝ G x)} from hx))
    exact Or.inr (mem_iUnion.mpr ⟨l, mem_image_of_mem G hl⟩)
  · exact Or.inl (hcrit x hx)
/-- **Minimizing `0`-currents do not meet the constraint set** (the case `n = 0` of Simon 7.4.3,
which the book leaves implicit since Ch. 6 §3 takes `n ≥ 1`; here for an arbitrary `A`).  If
`T ∈ 𝒟₀(U)` is minimizing in `A`, then `spt T ∩ A = ∅`.  Let
`T = τ(M, θ, ξ)` and suppose `x ∈ spt T ∩ A`.  Since `spt T = U ∩ spt μ_T` and, in degree `0`,
`U ∩ spt μ_T = M`, `x ∈ M`.  Deleting `x` gives `R' = (M \ {x}, θ, ξ)`, which represents
`S = T − D` with `D(ω) = θ(x)ξ(x)(ω(x))`, and `spt(S − T) = spt(−D) = {x} ⊆ A ∩ W` for a ball
`W ⊂⊂ U` about `x`.  As `μ_T(W) = μ_{R'}(W) + θ(x)` with `μ_T(W) < ∞` and `θ(x) ≥ 1`,
`M_W(S) = μ_{R'}(W) < M_W(T)`, contradicting minimality. -/
theorem Submission.dor_zero_dim_minimizing_support_disjoint : ∀ (P : ℕ) (U A : Set (Euclid P)) (T : GeometricCurrentOn U 0), IsOpen U → IsMinimizingIn T A → T.support ∩ A = ∅ := by
  intro P U A T hU hmin
  obtain ⟨⟨R, hR⟩, hminT⟩ := hmin
  refine eq_empty_iff_forall_notMem.mpr fun x hx => ?_
  obtain ⟨hxT, hxA⟩ := hx
  obtain ⟨-, hMfin, hMorient, hMspt⟩ := Submission.dor_zdm_imrep_zero_structure P U R
  obtain ⟨hmassT, hsptT⟩ := Submission.dor_imrep_massOn_eq_measure_and_support P 0 U T R hU hR
  -- `x` is a carrier point: `spt T = U ∩ spt μ_R = M`
  have hxM : x ∈ R.carrier := by
    rw [← hMspt hU, ← hsptT]
    exact hxT
  have hxU : x ∈ U := R.carrier_subset hxM
  -- delete `x`: `R' = (M \ {x}, θ, ξ)`, `μ_R = μ_{R'} + θ(x) δ_x`
  obtain ⟨R', -, hmeas, hact⟩ := Submission.dor_zdm_imrep_zero_erase_point P U R x hxM
  -- the point current `D(ω) = θ(x) ξ(x)(ω(x))`; the competitor `S = T − D` is represented by `R'`
  obtain ⟨⟨D, hD⟩, -⟩ :=
    Submission.dor_zdm_point_current P 0 U x ((R.mult x : ℝ) • R.orient x) hU hxU
  have hS : R'.Represents (T - D) := by
    intro ω
    change T ω - D ω = _
    rw [hR ω, hD ω, hact ω, smul_apply, smul_eq_mul]
  -- `spt(S − T) = {x}`: `(S − T)(ω) = −θ(x) ξ(x)(ω(x))` and `θ(x) ξ(x) ≠ 0`
  have hξ : (R.mult x : ℝ) • R.orient x ≠ 0 :=
    smul_ne_zero (by exact_mod_cast (R.mult_pos x hxM).ne') (hMorient x hxM).2
  have hspt : (T - D - T).support = {x} := by
    refine (Submission.dor_zdm_point_current P 0 U x (-((R.mult x : ℝ) • R.orient x)) hU
      hxU).2 (T - D - T) (fun ω => ?_) ((neg_ne_zero (α := MultiVector P 0)).mpr hξ)
    change T ω - D ω - T ω = _
    rw [hD ω, neg_apply, sub_sub_cancel_left]
  -- minimality on `W = B_{r/2}(x)`, `W ⊂⊂ U`
  obtain ⟨r, hr, hrU⟩ := Metric.isOpen_iff.mp hU x hxU
  have hr2 : 0 < r / 2 := half_pos hr
  have hcl : closure (ball x (r / 2)) = closedBall x (r / 2) := closure_ball x hr2.ne'
  have hKU : closedBall x (r / 2) ⊆ U := (closedBall_subset_ball (half_lt_self hr)).trans hrU
  have hxW : x ∈ ball x (r / 2) := mem_ball_self hr2
  have hle := hminT (ball x (r / 2)) (T - D) isOpen_ball
    ⟨by rw [hcl]; exact isCompact_closedBall x (r / 2), by rw [hcl]; exact hKU⟩ ⟨R', hS⟩
    trivial (by rw [hspt]; exact isCompact_singleton)
    (by rw [hspt]; exact singleton_subset_iff.mpr ⟨hxA, hxW⟩)
  -- `M_W(T) = μ_R(W)`, `M_W(S) = μ_{R'}(W)` and `μ_R(W) = μ_{R'}(W) + θ(x) < ∞`
  rw [hmassT _ isOpen_ball,
    (Submission.dor_imrep_massOn_eq_measure_and_support P 0 U (T - D) R' hU hS).1 _
      isOpen_ball] at hle
  have hRW : R.measure (ball x (r / 2)) = R'.measure (ball x (r / 2)) + (R.mult x : ℝ≥0∞) := by
    rw [hmeas, Measure.add_apply, Measure.smul_apply, Measure.dirac_apply_of_mem hxW,
      smul_eq_mul, mul_one]
  have hfin : R.measure (ball x (r / 2)) ≠ ∞ :=
    ne_top_of_le_ne_top (hMfin _ (isCompact_closedBall x (r / 2)) hKU).2
      (measure_mono ball_subset_closedBall)
  rw [hRW] at hfin hle
  have hθ : (R.mult x : ℝ≥0∞) ≠ 0 := by exact_mod_cast (R.mult_pos x hxM).ne'
  exact absurd hle (not_le.mpr (ENNReal.lt_add_right (ENNReal.add_ne_top.mp hfin).1 hθ))
/-- **Bounded mean curvature and monotonicity for a varifold stationary in `U ∩ N`** (Simon Ch. 4,
2.5–2.7 and 3.14–3.17; step 2 of the proof of 7.4.3).  `dsmc_tangent_projection_field` gives `r₀`,
`β` and a `C¹` field `Pt` of tangent projections of `N` near `y₀`; put `κ = nβ`.  For
`T = τ(M, θ, ξ)` with `spt T ⊆ N`, `μ_R` is carried by `U ∩ spt μ_R = spt T ⊆ N`
(`dor_imrep_massOn_eq_measure_and_support`, `M ⊆ U`); as `θ ≥ 1` on `M`, `Hⁿ(M \ N) = 0`, so
`TₓM ⊆ TₓN` at `μ_R`-a.e. `x` (`dsmc_approxTangentPlane_subset_tangentSpace`).  Then
`dsmc_firstVariation_eq_neg_meanCurvature` gives (a), and `dsmc_exp_ball_mass_monotone` on
`B̄_{r₀}(z) ⊆ U`, `B_{r₀}(z) ⊆ B_{2r₀}(y₀)` gives (b). -/
theorem Submission.dor_stationary_mean_curvature_monotonicity : ∀ (n k ℓ : ℕ), ℓ ≤ k → 0 < n → ∀ (U N : Set (Euclid (n + k))) (y₀ : Euclid (n + k)), IsOpen U → IsEmbeddedSubmanifold 2 (n + ℓ) N → (closure N \ N) ∩ U = ∅ → y₀ ∈ N ∩ U → ∃ r₀ κ : ℝ, 0 < r₀ ∧ 0 ≤ κ ∧ closedBall y₀ (3 * r₀) ⊆ U ∧ ∀ (T : GeometricCurrentOn U n) (R : IMRep U n), R.Represents T → T.support ⊆ N → R.IsStationaryAlong N → (∃ H : Euclid (n + k) → Euclid (n + k), AEStronglyMeasurable H R.measure ∧ (∀ x, ‖H x‖ ≤ κ) ∧ ∀ X : Euclid (n + k) → Euclid (n + k), ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ ball y₀ (2 * r₀) → R.firstVariation X = -∫ x, inner ℝ (X x) (H x) ∂R.measure) ∧ ∀ z ∈ ball y₀ r₀, ∀ σ ρ : ℝ, 0 < σ → σ ≤ ρ → ρ ≤ r₀ → ENNReal.ofReal (Real.exp (κ * σ) / σ ^ n) * R.measure (ball z σ) ≤ ENNReal.ofReal (Real.exp (κ * ρ) / ρ ^ n) * R.measure (ball z ρ) := by
  intro n k ℓ _ _ U N y₀ hU hN _ hy₀
  -- Step 1: a `C¹` field `Pt` of tangent projections of `N` near `y₀`; `r₀ = r` and `κ = nβ`
  obtain ⟨r, β, Pt, hr, hβ, hcl, hPt, hsym, hDPt, hPtT, hPtfix⟩ :=
    Submission.dsmc_tangent_projection_field (n + k) (n + ℓ) U N y₀ hU hN hy₀
  refine ⟨r, n * β, hr, by positivity, hcl, fun T R hRT hTN hstat => ?_⟩
  -- Step 2: `μ_R ≪ Hⁿ⌞M` with `M ⊆ U`, and `U ∩ spt μ_R = spt T ⊆ N`, so `μ_R(ℝᴾ \ N) = 0`
  have hac : R.measure ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
  have hU0 : R.measure Uᶜ = 0 := by
    refine hac ?_
    rw [Measure.restrict_apply' R.measurableSet_carrier]
    exact measure_mono_null (fun x hx => (hx.1 (R.carrier_subset hx.2)).elim) measure_empty
  have hspt := (Submission.dor_imrep_massOn_eq_measure_and_support (n + k) n U T R hU hRT).2
  have hN0 : R.measure Nᶜ = 0 := by
    refine measure_mono_null (fun x hxN => ?_)
      (measure_union_null hU0 (Measure.measure_compl_support (μ := R.measure)))
    by_contra hx
    simp only [mem_union, mem_compl_iff, not_or, not_not] at hx hxN
    exact hxN (hTN (by rw [hspt]; exact hx))
  have hNae : ∀ᵐ x ∂R.measure, x ∈ N := mem_ae_iff.2 hN0
  -- `θ ≥ 1` on `M`, so `Hⁿ⌞M ≪ μ_R` and `Hⁿ(M \ N) = 0`
  have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) := measurable_from_nat.comp R.measurable_mult
  have hac' : μHE[n].restrict R.carrier ≪ R.measure := by
    refine withDensity_absolutelyContinuous' hθ.aemeasurable ?_
    filter_upwards [ae_restrict_mem R.measurableSet_carrier] with x hx
    exact_mod_cast (R.mult_pos x hx).ne'
  have hMN : μHE[n] (R.carrier \ N) = 0 := by
    have h := hac' hN0
    rwa [Measure.restrict_apply' R.measurableSet_carrier, inter_comm, ← Set.sdiff_eq] at h
  -- Step 3: `TₓM ⊆ TₓN` at `μ_R`-a.e. `x`, `TₓM` being an approximate tangent plane there
  have hTM : ∀ᵐ x ∂R.measure, x ∈ ball y₀ (3 * r) →
      (approxTangentPlane n R.carrier x : Set (Euclid (n + k))) ⊆ tangentSpace N x := by
    filter_upwards [hac.ae_le R.orients, hNae] with x hx hxN _
    obtain ⟨Q, hQ, -⟩ := hx
    have h : ∃ Q, HasApproximateTangentSpaceAt n R.carrier x Q := ⟨Q, hQ⟩
    rw [approxTangentPlane, dite_eq_left h]
    exact Submission.dsmc_approxTangentPlane_subset_tangentSpace (n + k) n 2 (n + ℓ) R.carrier N
      x h.choose (by norm_num) hN hxN hMN h.choose_spec
  have hpm := Submission.dsmc_approxTangentPlane_starProjection_aemeasurable (n + k) n U R hU
  -- Step 4: (a), the generalized mean curvature `H` of `V` in `B_{2r₀}(y₀)`, `|H| ≤ nβ`
  obtain ⟨H, hHm, hHb, hHfv⟩ := Submission.dsmc_firstVariation_eq_neg_meanCurvature (n + k) n U N
    R Pt y₀ r β hβ (ball_subset_closedBall.trans hcl) hPt hsym hDPt hPtT hPtfix hNae hTM hpm hstat
  refine ⟨⟨H, hHm, hHb, hHfv⟩, fun z hz σ ρ hσ hσρ hρ => ?_⟩
  -- Step 5: (b) in `B_{r₀}(z)`, as `B̄_{r₀}(z) ⊆ B̄_{3r₀}(y₀)` and `B_{r₀}(z) ⊆ B_{2r₀}(y₀)`
  have hz' : dist z y₀ < r := hz
  exact Submission.dsmc_exp_ball_mass_monotone (n + k) n U R H (n * β) z r
    ((closedBall_subset_closedBall' (by linarith)).trans hcl) hpm hHm hHb
    (fun X hX hXc hXs => hHfv X hX hXc (hXs.trans (ball_subset_ball' (by linarith)))) σ ρ hσ hσρ hρ
/-- **`C¹` approximation of Lipschitz functions** (Simon Ch. 2, Theorem 1.5, the part about
values).  If `u : ℝᵐ → ℝ` is `K`-Lipschitz and `ε > 0`, some `G ∈ C¹(ℝᵐ)` agrees with `u` off a
set of measure `< ε`.  By Rademacher's theorem, the Borel set `B` of points where `u` is
differentiable has null complement, and `Du` is Borel.  Lusin's theorem gives a closed `C ⊆ B`,
`Lᵐ(B \ C) < ε / 2`, on which `Du` is continuous.  Egorov's theorem applied to the Whitney
remainders gives a closed `A ⊆ C`, `Lᵐ(C \ A) < ε / 2`, on which `(u, Du)` satisfies Whitney's
condition 1.6(∗).  Whitney's extension theorem gives `G ∈ C¹` with `G = u` on `A`, and
`{u ≠ G} ⊆ Bᶜ ∪ (B \ C) ∪ (C \ A)`. -/
theorem Submission.dor_lmbsf_lipschitz_c1_approx : ∀ (m : ℕ) (u : Euclid m → ℝ) (K : NNReal), LipschitzWith K u → ∀ ε : ℝ≥0∞, 0 < ε → ∃ G : Euclid m → ℝ, ContDiff ℝ 1 G ∧ volume {y | u y ≠ G y} < ε := by
  intro m u K hu ε hε
  -- Rademacher: the Borel set `B` of differentiability points of `u` has null complement
  set B : Set (Euclid m) := {x | DifferentiableAt ℝ u x}
  have hB : MeasurableSet B := measurableSet_of_differentiableAt ℝ u
  have hBc : volume Bᶜ = 0 := ae_iff.mp hu.ae_differentiableAt
  -- Lusin: a closed `C ⊆ B`, `Lᵐ(B \ C) < ε / 2`, on which `Du` is continuous
  obtain ⟨C, hCB, hC, hDC, hBC⟩ := Submission.codim1_rdo_c1a_lusin_isClosed m (fderiv ℝ u) B
    (measurable_fderiv ℝ u) hB (ε / 2) (ENNReal.half_pos hε.ne')
  -- Egorov on the Whitney remainders: a closed `A ⊆ C`, `Lᵐ(C \ A) < ε / 2`, satisfying 1.6(∗)
  obtain ⟨A, hAC, hA, hCA, hrem⟩ := Submission.codim1_rdo_c1a_whitney_remainder m u K C hu hC
    (fun x hx => hCB hx) hDC (ε / 2) (ENNReal.half_pos hε.ne')
  -- Whitney's extension theorem: `G ∈ C¹` with `G = u` on `A`
  obtain ⟨G, hG, hGA, -⟩ := Submission.codim1_rdo_c1a_whitney_extension m A u (fderiv ℝ u) hA
    hu.continuous.continuousOn (hDC.mono hAC) hrem
  refine ⟨G, hG, ?_⟩
  -- `{u ≠ G} ⊆ Aᶜ ⊆ Bᶜ ∪ (B \ C) ∪ (C \ A)`
  calc volume {y | u y ≠ G y} ≤ volume (Bᶜ ∪ ((B \ C) ∪ (C \ A))) := by
        refine measure_mono fun y hy => ?_
        have hyA : y ∉ A := fun hyA => hy (hGA hyA).symm
        by_cases hyB : y ∈ B
        · by_cases hyC : y ∈ C
          · exact Or.inr (Or.inr ⟨hyC, hyA⟩)
          · exact Or.inr (Or.inl ⟨hyB, hyC⟩)
        · exact Or.inl hyB
    _ ≤ volume Bᶜ + (volume (B \ C) + volume (C \ A)) :=
        (measure_union_le _ _).trans (add_le_add le_rfl (measure_union_le _ _))
    _ < ε / 2 + ε / 2 := by
        rw [hBc, zero_add]
        exact ENNReal.add_lt_add hBC hCA
    _ = ε := ENNReal.add_halves ε

/-- **Simon Ch. 3, Lemma 1.2, "only if" part** (chapter-03.txt lines 22–65): a countably
`m`-rectifiable `M ⊆ ℝᴾ` lies in `N₀ ∪ ⋃ₗ Nₗ` with `Hᵐ(N₀) = 0` and each `Nₗ` an embedded
`m`-dimensional `C¹` submanifold.  Write `M ⊆ M₀ ∪ ⋃ⱼ Fⱼ(ℝᵐ)` with `Hᵐ(M₀) = 0` and `Fⱼ`
Lipschitz.  The `C¹` approximation theorem (Simon Ch. 2, Theorem 1.5) gives `C¹` maps `G_{ji}`
with `Fⱼ(ℝᵐ) ⊆ Eⱼ ∪ ⋃ᵢ G_{ji}(ℝᵐ)` and `Hᵐ(Eⱼ) = 0`.  Each `G_{ji}(ℝᵐ)` lies in an `Hᵐ`-null set
`N₀_{ji}` (the critical image, by the area formula) together with countably many submanifolds
`N_{jis}` (images of small balls about regular points).  Take
`N₀ = M₀ ∪ ⋃ⱼ Eⱼ ∪ ⋃_{j,i} N₀_{ji}` and `Nₗ = N_{jis}` for `l = Nat.pair j (Nat.pair i s)`. -/
theorem Submission.dor_lmbsf_rectifiable_c1_cover : ∀ (P m : ℕ) (M : Set (Euclid P)), CountablyRectifiable m M → ∃ (N₀ : Set (Euclid P)) (N : ℕ → Set (Euclid P)), μHE[m] N₀ = 0 ∧ (∀ l, IsEmbeddedSubmanifold 1 m (N l)) ∧ M ⊆ N₀ ∪ ⋃ l, N l := by
  intro P m M hM
  -- Step 1: `M ⊆ M₀ ∪ ⋃ⱼ Fⱼ(ℝᵐ)` with `Hᵐ(M₀) = 0` and `Fⱼ` `Kⱼ`-Lipschitz
  obtain ⟨M₀, hM₀, F, hF, hMF⟩ := hM
  choose K hK using hF
  -- Steps 2–3: `Fⱼ(ℝᵐ) ⊆ Eⱼ ∪ ⋃ᵢ G_{ji}(ℝᵐ)` with `Hᵐ(Eⱼ) = 0` and `G_{ji}` `C¹`
  choose E G hE hG hFG using fun j =>
    Submission.dor_lmbsf_c1c_lipschitz_range_c1_pieces P m (F j) (K j) (hK j)
      (Submission.dor_lmbsf_lipschitz_c1_approx m)
  -- Steps 4–6: `G_{ji}(ℝᵐ) ⊆ N₀_{ji} ∪ ⋃ₛ N_{jis}` with `Hᵐ(N₀_{ji}) = 0` and `N_{jis}`
  -- embedded `C¹` submanifolds
  choose N₀' N' hN₀' hN' hGN using fun j i =>
    Submission.dor_lmbsf_c1c_c1_range_cover P m (G j i) (hG j i)
  -- Step 7: collect the null sets and enumerate the submanifolds by `l = ⟨j, ⟨i, s⟩⟩`
  refine ⟨M₀ ∪ (⋃ j, E j) ∪ ⋃ j, ⋃ i, N₀' j i,
    fun l => N' l.unpair.1 l.unpair.2.unpair.1 l.unpair.2.unpair.2,
    measure_union_null (measure_union_null hM₀ (measure_iUnion_null hE))
      (measure_iUnion_null fun j => measure_iUnion_null (hN₀' j)),
    fun l => hN' _ _ _, ?_⟩
  intro y hy
  rcases hMF hy with hy | hy
  · exact Or.inl (Or.inl (Or.inl hy))
  obtain ⟨j, hj⟩ := mem_iUnion.1 hy
  rcases hFG j hj with hy | hy
  · exact Or.inl (Or.inl (Or.inr (mem_iUnion.2 ⟨j, hy⟩)))
  obtain ⟨i, hi⟩ := mem_iUnion.1 hy
  rcases hGN j i hi with hy | hy
  · exact Or.inl (Or.inr (mem_iUnion₂.2 ⟨j, i, hy⟩))
  obtain ⟨s, hs⟩ := mem_iUnion.1 hy
  refine Or.inr (mem_iUnion.2 ⟨Nat.pair j (Nat.pair i s), ?_⟩)
  simpa only [Nat.unpair_pair] using hs
/-- **Local `C¹` globalization by a bump cutoff** (the cut-off step letting the globally `C¹`
results apply to a map that is only `C¹` on an open set).  Let `W` be open, `χ` be `C¹` on `W`
and `y ∈ W`; choose `B_ρ(y) ⊆ W` and the smooth bump `φ` centred at `y` with `φ = 1` on
`B̄_{ρ/4}(y)` and `tsupport φ = B̄_{ρ/2}(y) ⊆ W`.  Then `g = φ χ` is `C¹` near points of `W`
(product of a `C^∞` and a `C¹` map) and vanishes near points outside `W`, so `g` is `C¹` on
`ℝᵏ`; and `g = χ` on `B_ε(y)`, `ε = ρ/4`. -/
theorem Submission.dor_lmbsf_cit_c1_local_extension : ∀ (P k : ℕ) (W : Set (Euclid k)) (χ : Euclid k → Euclid P) (y : Euclid k), IsOpen W → ContDiffOn ℝ 1 χ W → y ∈ W → ∃ (g : Euclid k → Euclid P) (ε : ℝ), 0 < ε ∧ ball y ε ⊆ W ∧ ContDiff ℝ 1 g ∧ EqOn g χ (ball y ε) := by
  intro P k W χ y hW hχ hy
  -- Step 1, a ball `B_ρ(y) ⊆ W`.
  obtain ⟨ρ, hρ, hball⟩ := Metric.isOpen_iff.1 hW y hy
  -- Step 2, the bump `φ`: `φ = 1` on `B̄_{ρ/4}(y)` and `tsupport φ = B̄_{ρ/2}(y) ⊆ W`.
  let φ : ContDiffBump y := ⟨ρ / 4, ρ / 2, by positivity, by linarith⟩
  have hsupp : tsupport φ ⊆ W := by
    rw [φ.tsupport_eq]
    exact (closedBall_subset_ball (by change ρ / 2 < ρ; linarith)).trans hball
  -- Step 3, `g = φ χ` and `ε = ρ/4`, so `B_ε(y) ⊆ W`.
  refine ⟨fun x => φ x • χ x, ρ / 4, by positivity,
    (ball_subset_ball (by linarith)).trans hball, ?_, fun x hx => ?_⟩
  · -- Steps 4–6, `g` is `C¹` at every point.
    refine contDiff_iff_contDiffAt.2 fun x => ?_
    by_cases hx : x ∈ W
    · -- Step 4, on `W`, `g` is the product of the `C^∞` map `φ` and the `C¹` map `χ`.
      exact φ.contDiffAt.fun_smul (hχ.contDiffAt (hW.mem_nhds hx))
    · -- Step 5, off `W`, `x ∉ tsupport φ` and `g = 0` near `x`.
      refine (contDiffAt_const (c := (0 : Euclid P))).congr_of_eventuallyEq ?_
      filter_upwards [(isClosed_tsupport φ).compl_mem_nhds fun h => hx (hsupp h)] with z hz
      rw [image_eq_zero_of_notMem_tsupport hz, zero_smul]
  · -- `φ = 1` on `B_ε(y) ⊆ B̄_{ρ/4}(y)`, so `g = χ` there.
    change φ x • χ x = χ x
    rw [φ.one_of_mem_closedBall (ball_subset_closedBall hx), one_smul]
/-- **Gram cofactor identity** (the Jacobian identity `|G ∘ Φ| · JΦ = JΦₛ` of the co-area formula
for one straightened piece, Simon Ch. 3, 2.8–2.9).  If `u ∈ span{a₀, …, aₙ}`, `⟨u, a₀⟩ = 1` and
`⟨u, a_{k+1}⟩ = 0` for all `k`, then `det[⟨a_{i+1}, a_{j+1}⟩]_{i,j<n} = ‖u‖² · det[⟨aᵢ, aⱼ⟩]_{i,j≤n}`.
Write `u = ∑ cₗ aₗ`.  The Gram matrix `A = [⟨aᵢ, aⱼ⟩]` satisfies `A c = e₀` and `‖u‖² = c₀`, so
`adj(A) e₀ = adj(A) A c = det A · c`; the `(0, 0)` entry of `adj(A)` is the cofactor
`det[⟨a_{i+1}, a_{j+1}⟩]` (Cramer's rule).  No linear independence is needed. -/
theorem Submission.dor_lmbsf_pc_gram_det_succ_eq : ∀ (P n : ℕ) (a : Fin (n + 1) → Euclid P) (u : Euclid P), u ∈ Submodule.span ℝ (Set.range a) → inner ℝ u (a 0) = 1 → (∀ k : Fin n, inner ℝ u (a k.succ) = 0) → Matrix.det (Matrix.of fun i j : Fin n => inner ℝ (a i.succ) (a j.succ)) = ‖u‖ ^ 2 * Matrix.det (Matrix.of fun i j : Fin (n + 1) => inner ℝ (a i) (a j)) := by
  intro P n a u hu h0 hk
  classical
  -- `u = ∑ cₗ aₗ`
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp hu
  set A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ := Matrix.of fun i j => inner ℝ (a i) (a j)
  -- `⟨u, aᵢ⟩ = δᵢ₀`
  have hua : ∀ i, inner ℝ u (a i) = (Pi.single 0 1 : Fin (n + 1) → ℝ) i := by
    intro i
    refine Fin.cases ?_ (fun k => ?_) i
    · simp [h0]
    · simp [hk k, Fin.succ_ne_zero]
  -- `A c = e₀`
  have hAc : A.mulVec c = Pi.single 0 1 := by
    ext i
    simp only [Matrix.mulVec, dotProduct, A, Matrix.of_apply]
    have : ∑ j, inner ℝ (a i) (a j) * c j = inner ℝ (a i) u := by
      rw [← hc, inner_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [real_inner_smul_right]; ring
    rw [this, real_inner_comm, hua]
  -- `‖u‖² = c₀`
  have hnorm : ‖u‖ ^ 2 = c 0 := by
    rw [← real_inner_self_eq_norm_sq]
    calc inner ℝ u u = inner ℝ (∑ l, c l • a l) u := by rw [hc]
      _ = ∑ l, c l * inner ℝ (a l) u := by
          rw [sum_inner]; refine Finset.sum_congr rfl (fun l _ => ?_); rw [real_inner_smul_left]
      _ = c 0 := by
          have hl : ∀ l, inner ℝ (a l) u = (Pi.single 0 1 : Fin (n + 1) → ℝ) l := fun l => by
            rw [real_inner_comm, hua]
          simp_rw [hl]
          simp [Pi.single_apply]
  -- `adj(A) e₀ = adj(A) A c = det A · c`, read off at the `0`-th entry
  have hadj : A.adjugate.mulVec (A.mulVec c) = A.det • c := by
    rw [Matrix.mulVec_mulVec, Matrix.adjugate_mul, Matrix.smul_mulVec, Matrix.one_mulVec]
  rw [hAc] at hadj
  have h00 := congrFun hadj 0
  simp only [Matrix.mulVec, dotProduct, Pi.single_apply, mul_ite, mul_one, mul_zero,
    Finset.sum_ite_eq', Finset.mem_univ, ite_true, Pi.smul_apply, smul_eq_mul] at h00
  -- the `(0, 0)` cofactor of `A` is the Gram determinant of `a₁, …, aₙ`
  rw [Matrix.adjugate_fin_succ_eq_det_submatrix] at h00
  simp only [Fin.val_zero, add_zero, pow_zero, one_mul, Fin.succAbove_zero] at h00
  rw [hnorm, mul_comm, ← h00]
  rfl
/-- **Locality of approximate tangent spaces** (Simon Ch. 3, Definition 1.4): if `M' ⊆ M`, `M` is
Borel and `x ∉ closure (M \ M')`, then an approximate tangent space `Q` of `M'` at `x` is also one
of `M`.  Some `ρ > 0` has `|z − x| ≥ ρ` on `M \ M'`, and a test function `f` vanishes on
`|p| ≥ R`.  For `0 < r < ρ / R`, `η_{x,r}(M)` and `η_{x,r}(M')` differ only where
`|p| ≥ ρ / r > R`, so `∫_{η_{x,r}(M)} f dHⁿ = ∫_{η_{x,r}(M')} f dHⁿ` and the limit transfers. -/
theorem Submission.dor_lmbsf_cit_approxTangent_of_subset : ∀ (P n : ℕ) (M M' : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)), MeasurableSet M → M' ⊆ M → x ∉ closure (M \ M') → HasApproximateTangentSpaceAt n M' x Q → HasApproximateTangentSpaceAt n M x Q := by
  intro P n M M' x Q hM hM'M hx hM'
  refine ⟨hM'.1, fun f => ?_⟩
  -- `x ∉ closure (M \ M')`: some `ρ > 0` has `ρ ≤ |x − z|` for all `z ∈ M \ M'`
  obtain ⟨ρ, hρ, hρM⟩ : ∃ ρ > 0, ∀ z ∈ M \ M', ρ ≤ dist x z := by
    simpa only [Metric.mem_closure_iff, not_forall, not_exists, not_and, not_lt,
      exists_prop] using hx
  -- `f` has compact support: `f p = 0` once `R ≤ |p|`
  obtain ⟨R, hR, hfR⟩ : ∃ R : ℝ, 0 < R ∧ ∀ p : Euclid P, R ≤ ‖p‖ → f p = 0 :=
    f.hasCompactSupport.exists_pos_le_norm
  -- for `0 < r < ρ / R` the blown-up integrals over `M` and `M'` agree
  refine (hM'.2 f).congr' ?_
  filter_upwards [Ioo_mem_nhdsGT (div_pos hρ hR)] with r hr
  obtain ⟨hr0, hrR⟩ := hr
  rw [lt_div_iff₀ hR] at hrR
  -- `η_{x,r}(M)` is the preimage of `M` under `p ↦ x + r p`, hence Borel
  have hmeas : MeasurableSet (Poincare.SimonGMT.Chapter03.blowUpMap x r '' M) := by
    have himage : Poincare.SimonGMT.Chapter03.blowUpMap x r '' M =
        (fun p : Euclid P => x + r • p) ⁻¹' M := by
      ext p
      constructor
      · rintro ⟨z, hz, rfl⟩
        simpa [Poincare.SimonGMT.Chapter03.blowUpMap, smul_smul, hr0.ne'] using hz
      · intro hp
        exact ⟨x + r • p, hp, by
          simp [Poincare.SimonGMT.Chapter03.blowUpMap, smul_smul, hr0.ne']⟩
    rw [himage]
    exact hM.preimage (by fun_prop)
  symm
  refine setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hmeas (image_mono hM'M) ?_
  -- a point of `η_{x,r}(M) \ η_{x,r}(M')` comes from `z ∈ M \ M'`, so its norm is `≥ ρ / r > R`
  rintro _ ⟨⟨z, hzM, rfl⟩, hzM'⟩
  have hz : z ∈ M \ M' := ⟨hzM, fun h => hzM' ⟨z, h, rfl⟩⟩
  apply hfR
  rw [Poincare.SimonGMT.Chapter03.blowUpMap, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hr0.le),
    ← dist_eq_norm, dist_comm, inv_mul_eq_div, le_div_iff₀ hr0]
  linarith [hρM z hz]

/-- **Approximate tangent space of an injective `C¹` image** (Simon Ch. 3, 1.4; the step "since
`x ∈ Nⱼ` and `Nⱼ` is a `C¹` submanifold, `lim_{λ↓0} ∫_{η_{x,λ}(Nⱼ)} f dHⁿ = ∫_{TₓNⱼ} f dHⁿ`" of
the proof of 1.6 "⇒", chapter-03.txt lines 113–125).  Let `χ` be `C¹` on the open `V ⊇ C`, `C`
compact, `χ` injective on `C`, `y ∈ int C` and `Dχ(y)` injective.  On a ball
`B_ε(y) ⊆ V ∩ int C`, `χ` agrees with a globally `C¹` map `g`, so `Dg(y) = Dχ(y)` and `g` has a
lower Lipschitz bound on some `B_δ(y) ⊆ B_ε(y)`.  Hence `χ(B_δ(y)) = g(B_δ(y))` has approximate
tangent space `Q = Dχ(y)(ℝᵏ)` at `χ(y)`.  The rest of `χ(C)` lies in the compact set
`χ(C \ B_δ(y))`, which misses `χ(y)` by injectivity, so it does not change the blow-up limits. -/
theorem Submission.dor_lmbsf_c1_image_approxTangent : ∀ (k P : ℕ) (V C : Set (Euclid k)) (χ : Euclid k → Euclid P) (y : Euclid k), IsOpen V → ContDiffOn ℝ 1 χ V → IsCompact C → C ⊆ V → InjOn χ C → y ∈ interior C → Injective (fderiv ℝ χ y) → HasApproximateTangentSpaceAt k (χ '' C) (χ y) (LinearMap.range (fderiv ℝ χ y : Euclid k →ₗ[ℝ] Euclid P)) := by
  intro k P V C χ y hV hχ hC hCV hinj hy hDχ
  -- Step 1, `χ` agrees on `B_ε(y) ⊆ W = V ∩ int C` with a globally `C¹` map `g`
  obtain ⟨g, ε, hε, hεW, hg, hgχ⟩ := Submission.dor_lmbsf_cit_c1_local_extension P k
    (V ∩ interior C) χ y (hV.inter isOpen_interior) (hχ.mono inter_subset_left)
    ⟨hCV (interior_subset hy), hy⟩
  -- Step 2, `g(y) = χ(y)` and `Dg(y) = Dχ(y)`, since `g = χ` near `y`
  have hgy : g y = χ y := hgχ (mem_ball_self hε)
  have hDg : fderiv ℝ g y = fderiv ℝ χ y :=
    (hgχ.eventuallyEq_of_mem (ball_mem_nhds y hε)).fderiv_eq
  -- Step 3, `μ|a − b| ≤ |g(a) − g(b)|` on `B_δ₀(y)`; take `δ = min(ε, δ₀)`
  obtain ⟨δ₀, μ, hδ₀, hμ, hlip⟩ :=
    Submission.codim1_rdo_c1cov_local_lower_lipschitz P k g y hg (by rwa [hDg])
  obtain ⟨δ, hδ, hδε, hδδ₀⟩ : ∃ δ : ℝ, 0 < δ ∧ ball y δ ⊆ ball y ε ∧ ball y δ ⊆ ball y δ₀ :=
    ⟨min ε δ₀, lt_min hε hδ₀, ball_subset_ball (min_le_left _ _),
      ball_subset_ball (min_le_right _ _)⟩
  -- Step 4, `M' = g(B_δ(y)) = χ(B_δ(y))` has approximate tangent space `Q` at `χ(y)`
  have hpiece := Submission.codim1_rdo_c1_piece_approxTangent P k g y δ μ hg hμ
    (fun a ha b hb => hlip a (hδδ₀ ha) b (hδδ₀ hb)) y (mem_ball_self hδ)
  rw [(hgχ.mono hδε).image_eq, hgy, hDg] at hpiece
  -- Step 5, `M = χ(C)` is compact, `M' ⊆ M`, and `M \ M' ⊆ χ(C \ B_δ(y))`, a compact set that
  -- misses `χ(y)` because `χ` is injective on `C`
  have hδC : ball y δ ⊆ C := hδε.trans (hεW.trans (inter_subset_right.trans interior_subset))
  have hχC : ContinuousOn χ C := hχ.continuousOn.mono hCV
  have hfar : χ y ∉ closure (χ '' C \ χ '' ball y δ) := by
    intro hcl
    obtain ⟨z, ⟨hzC, hzδ⟩, hzy⟩ := closure_minimal (subset_image_sdiff χ C (ball y δ))
      ((hC.diff isOpen_ball).image_of_continuousOn (hχC.mono sdiff_subset)).isClosed hcl
    rw [hinj hzC (interior_subset hy) hzy] at hzδ
    exact hzδ (mem_ball_self hδ)
  -- Step 6, the part of `χ(C)` away from `χ(y)` does not change the blow-up limits
  exact Submission.dor_lmbsf_cit_approxTangent_of_subset P k (χ '' C) (χ '' ball y δ) (χ y) _
    (hC.image_of_continuousOn hχC).isClosed.measurableSet (image_mono hδC) hfar hpiece
/-- **Density points see every direction.**  If `y` is a Lebesgue density point of an arbitrary set
`Z ⊆ ℝᵈ`, i.e. `Lᵈ(Z ∩ B̄_r(y)) / Lᵈ(B̄_r(y)) → 1` as `r ↓ 0`, then every unit vector `v` is a limit
of secant directions `(yᵢ - y)/|yᵢ - y|` with `yᵢ ∈ Z ∖ {y}` and `yᵢ → y`.  For `0 < η ≤ 1` and
`r > 0` the ball `B_{ηr/4}(y + (r/2)v)` lies in `B̄_r(y) ∖ {y}` and in the `η`-cone around `v`, and
it has measure `(η/4)ᵈ Lᵈ(B̄_r(y))`, so density one forces `Z` to meet it for all small `r`; take
`η = 1/(i+1)` and `r < 1/(i+1)`. -/
theorem Submission.dor_lmbsf_density_directions : ∀ (d : ℕ) (Z : Set (Euclid d)) (y : Euclid d), Tendsto (fun r => volume (Z ∩ closedBall y r) / volume (closedBall y r)) (𝓝[>] 0) (𝓝 1) → ∀ v : Euclid d, ‖v‖ = 1 → ∃ ys : ℕ → Euclid d, (∀ i, ys i ∈ Z ∧ ys i ≠ y) ∧ Tendsto ys atTop (𝓝 y) ∧ Tendsto (fun i => ‖ys i - y‖⁻¹ • (ys i - y)) atTop (𝓝 v) := by
  intro d Z y hdens v hv
  -- the ball `B_{ηr/4}(y + (r/2)v)` lies in `B_r(y) ∖ {y}`, inside the `η`-cone around `v`
  have cone : ∀ η r : ℝ, 0 < η → η ≤ 1 → 0 < r → ∀ z ∈ ball (y + (r / 2) • v) (η * r / 4),
      ‖z - y‖ < r ∧ z ≠ y ∧ ‖‖z - y‖⁻¹ • (z - y) - v‖ < η := by
    intro η r hη hη1 hr z hz
    have hs : (0 : ℝ) < r / 2 := by positivity
    -- the offset `w = z - y - (r/2)v` of `z` from the centre has `‖w‖ < ηr/4 ≤ r/4`
    have hw : ‖z - y - (r / 2) • v‖ < η * r / 4 := by
      rwa [mem_ball, dist_eq_norm, sub_add_eq_sub_sub] at hz
    have hw' : ‖z - y - (r / 2) • v‖ < r / 4 := hw.trans_le (by nlinarith)
    have hsv : ‖(r / 2) • v‖ = r / 2 := by rw [norm_smul, hv, mul_one, Real.norm_of_nonneg hs.le]
    have hdiff : |‖z - y‖ - r / 2| ≤ ‖z - y - (r / 2) • v‖ := by
      simpa only [hsv] using abs_norm_sub_norm_le (z - y) ((r / 2) • v)
    obtain ⟨hlo, hhi⟩ := abs_le.1 hdiff
    have hpos : 0 < ‖z - y‖ := by linarith
    refine ⟨by linarith, fun h => by rw [h, sub_self, norm_zero] at hpos; exact lt_irrefl _ hpos,
      ?_⟩
    -- `‖z - y‖⁻¹ (z - y) - v = (‖z - y‖⁻¹ - (r/2)⁻¹) (z - y) + (r/2)⁻¹ w`
    have hdecomp : ‖z - y‖⁻¹ • (z - y) - v
        = (‖z - y‖⁻¹ - (r / 2)⁻¹) • (z - y) + (r / 2)⁻¹ • (z - y - (r / 2) • v) := by
      rw [sub_smul ‖z - y‖⁻¹ (r / 2)⁻¹ (z - y), smul_sub (r / 2)⁻¹ (z - y) ((r / 2) • v), smul_smul,
        inv_mul_cancel₀ hs.ne', one_smul]
      abel
    have h1 : ‖(‖z - y‖⁻¹ - (r / 2)⁻¹) • (z - y)‖ ≤ ‖z - y - (r / 2) • v‖ / (r / 2) := by
      have hne : ‖z - y‖ ≠ 0 := hpos.ne'
      have e : (‖z - y‖⁻¹ - (r / 2)⁻¹) * ‖z - y‖ = (r / 2 - ‖z - y‖) / (r / 2) := by
        field_simp
      calc ‖(‖z - y‖⁻¹ - (r / 2)⁻¹) • (z - y)‖ = |(‖z - y‖⁻¹ - (r / 2)⁻¹) * ‖z - y‖| := by
            rw [norm_smul, Real.norm_eq_abs, abs_mul, abs_norm]
        _ = |‖z - y‖ - r / 2| / (r / 2) := by rw [e, abs_div, abs_of_pos hs, abs_sub_comm]
        _ ≤ ‖z - y - (r / 2) • v‖ / (r / 2) := by gcongr
    have h2 : ‖(r / 2)⁻¹ • (z - y - (r / 2) • v)‖ = ‖z - y - (r / 2) • v‖ / (r / 2) := by
      rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hs.le), inv_mul_eq_div]
    calc ‖‖z - y‖⁻¹ • (z - y) - v‖
        ≤ ‖(‖z - y‖⁻¹ - (r / 2)⁻¹) • (z - y)‖ + ‖(r / 2)⁻¹ • (z - y - (r / 2) • v)‖ := by
          rw [hdecomp]; exact norm_add_le _ _
      _ ≤ ‖z - y - (r / 2) • v‖ / (r / 2) + ‖z - y - (r / 2) • v‖ / (r / 2) := by
          rw [h2]; linarith
      _ < η := by rw [← add_div, div_lt_iff₀ hs]; linarith
  -- for `0 < η ≤ 1`, `Z` meets `B_{ηr/4}(y + (r/2)v)` for all small `r > 0`: otherwise
  -- `Lᵈ(Z ∩ B̄_r(y)) ≤ Lᵈ(B̄_r(y)) - Lᵈ(B_{ηr/4}(y + (r/2)v)) = (1 - (η/4)ᵈ) Lᵈ(B̄_r(y))`
  have hit : ∀ η : ℝ, 0 < η → η ≤ 1 → ∃ r₀ : ℝ, 0 < r₀ ∧ ∀ r : ℝ, 0 < r → r < r₀ →
      ∃ z ∈ Z, z ∈ ball (y + (r / 2) • v) (η * r / 4) := by
    intro η hη hη1
    have hκ : ENNReal.ofReal ((η / 4) ^ d) ≠ 0 := by
      rw [Ne, ENNReal.ofReal_eq_zero, not_le]; positivity
    obtain ⟨r₀, hr₀, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1
      (hdens.eventually_const_lt (ENNReal.sub_lt_self ENNReal.one_ne_top one_ne_zero hκ))
    refine ⟨r₀, hr₀, fun r hr hrr₀ => ?_⟩
    by_contra! hZ
    have hB : ball (y + (r / 2) • v) (η * r / 4) ⊆ closedBall y r := fun z hz => by
      rw [mem_closedBall, dist_eq_norm]; exact (cone η r hη hη1 hr z hz).1.le
    have hvol : volume (ball (y + (r / 2) • v) (η * r / 4))
        = ENNReal.ofReal ((η / 4) ^ d) * volume (closedBall y r) := by
      rw [Measure.addHaar_ball_of_pos volume _ (by positivity : (0 : ℝ) < η * r / 4),
        Measure.addHaar_closedBall volume _ hr.le, finrank_euclideanSpace_fin, ← mul_assoc,
        ← ENNReal.ofReal_mul (by positivity), ← mul_pow, show η / 4 * r = η * r / 4 by ring]
    have hle : volume (Z ∩ closedBall y r)
        ≤ (1 - ENNReal.ofReal ((η / 4) ^ d)) * volume (closedBall y r) :=
      calc volume (Z ∩ closedBall y r)
          ≤ volume (closedBall y r \ ball (y + (r / 2) • v) (η * r / 4)) :=
            measure_mono fun z hz => ⟨hz.2, hZ z hz.1⟩
        _ = volume (closedBall y r) - volume (ball (y + (r / 2) • v) (η * r / 4)) :=
            measure_sdiff hB measurableSet_ball.nullMeasurableSet measure_ball_lt_top.ne
        _ = (1 - ENNReal.ofReal ((η / 4) ^ d)) * volume (closedBall y r) := by
            rw [hvol, ENNReal.sub_mul fun _ _ => measure_closedBall_lt_top.ne, one_mul]
    have hgt : 1 - ENNReal.ofReal ((η / 4) ^ d)
        < volume (Z ∩ closedBall y r) / volume (closedBall y r) := hsub ⟨hr, hrr₀⟩
    exact lt_irrefl _ (hgt.trans_le (ENNReal.div_le_of_le_mul hle))
  -- take `η = 1/(i+1)` and `0 < rᵢ < min(r₀, 1/(i+1))`
  have hη : ∀ i : ℕ, (0 : ℝ) < 1 / ((i : ℝ) + 1) := fun i => by positivity
  have hη1 : ∀ i : ℕ, 1 / ((i : ℝ) + 1) ≤ 1 := fun i =>
    (div_le_one (by positivity)).2 (by linarith [(Nat.cast_nonneg i : (0 : ℝ) ≤ i)])
  have hseq : ∀ i : ℕ, ∃ z ∈ Z, ∃ r : ℝ, 0 < r ∧ r < 1 / ((i : ℝ) + 1) ∧
      z ∈ ball (y + (r / 2) • v) (1 / ((i : ℝ) + 1) * r / 4) := by
    intro i
    obtain ⟨r₀, hr₀, h⟩ := hit _ (hη i) (hη1 i)
    have hm : 0 < min r₀ (1 / ((i : ℝ) + 1)) := lt_min hr₀ (hη i)
    obtain ⟨z, hzZ, hz⟩ := h (min r₀ (1 / ((i : ℝ) + 1)) / 2) (by positivity)
      (by linarith [min_le_left r₀ (1 / ((i : ℝ) + 1))])
    exact ⟨z, hzZ, _, by positivity, by linarith [min_le_right r₀ (1 / ((i : ℝ) + 1))], hz⟩
  choose ys hysZ rs hrs hrsi hysB using hseq
  have hcone := fun i => cone _ (rs i) (hη i) (hη1 i) (hrs i) (ys i) (hysB i)
  refine ⟨ys, fun i => ⟨hysZ i, (hcone i).2.1⟩, ?_, ?_⟩
  · rw [tendsto_iff_norm_sub_tendsto_zero]
    exact squeeze_zero (fun i => norm_nonneg _) (fun i => ((hcone i).1.trans (hrsi i)).le)
      tendsto_one_div_add_atTop_nhds_zero_nat
  · rw [tendsto_iff_norm_sub_tendsto_zero]
    exact squeeze_zero (fun i => norm_nonneg _) (fun i => (hcone i).2.2.le)
      tendsto_one_div_add_atTop_nhds_zero_nat

/-- **Chart pieces of a rectifiable set carrying a Lipschitz function** (Simon Ch. 3, Lemma 1.2,
Remarks 1.3 and 1.5(2), 2.1).  Given (TL), `M` is covered, up to an `H^{n+1}`-null set, by compact
pieces `ψⱼ(Cⱼ)` of injective `C¹` immersions `ψⱼ : Vⱼ → U` with `f ∘ ψⱼ = Fⱼ ∈ C¹` on `Cⱼ`
(index `j = Nat.pair s k`: piece `k` of chart `s`).  These are refined to disjoint Borel pieces
`ψⱼ(Yⱼ) ⊆ M` at whose points `TₓM = Dψⱼ(y)(ℝ^{n+1})` and `|DFⱼ(y)e| ≤ L|Dψⱼ(y)e|`; the tangential
lifts `Dψⱼ(DψⱼᵀDψⱼ)⁻¹∇Fⱼ` glue to a Borel `g` with `|g| ≤ L` (the gradient `∇^M f`). -/
theorem Submission.dor_lmbsf_lipschitz_chart_pieces : (∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q) → ∀ (P n : ℕ) (U M : Set (Euclid P)) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → MeasurableSet M → M ⊆ U → CountablyRectifiable (n + 1) M → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n + 1] (M ∩ K) ≠ ∞) → LipschitzWith L f → ∃ (V C Y : ℕ → Set (Euclid (n + 1))) (ψ : ℕ → Euclid (n + 1) → Euclid P) (F : ℕ → Euclid (n + 1) → ℝ) (g : Euclid P → Euclid P), (∀ j, IsOpen (V j) ∧ ContDiffOn ℝ 1 (ψ j) (V j) ∧ InjOn (ψ j) (V j) ∧ (∀ y ∈ V j, Injective (fderiv ℝ (ψ j) y)) ∧ ψ j '' V j ⊆ U) ∧ (∀ j, IsCompact (C j) ∧ C j ⊆ V j ∧ MeasurableSet (Y j) ∧ Y j ⊆ C j ∧ ContDiff ℝ 1 (F j)) ∧ (∀ j, ψ j '' Y j ⊆ M) ∧ Pairwise (fun i j => Disjoint (ψ i '' Y i) (ψ j '' Y j)) ∧ μHE[n + 1] (M \ ⋃ j, ψ j '' Y j) = 0 ∧ (∀ j, ∀ y ∈ Y j, f (ψ j y) = F j y ∧ HasApproximateTangentSpaceAt (n + 1) M (ψ j y) (LinearMap.range (fderiv ℝ (ψ j) y : Euclid (n + 1) →ₗ[ℝ] Euclid P))) ∧ Measurable g ∧ (∀ x, ‖g x‖ ≤ L) ∧ (∀ x, (∀ j, x ∉ ψ j '' Y j) → g x = 0) ∧ ∀ j, ∀ y ∈ Y j, g (ψ j y) ∈ LinearMap.range (fderiv ℝ (ψ j) y : Euclid (n + 1) →ₗ[ℝ] Euclid P) ∧ ∀ e : Euclid (n + 1), inner ℝ (g (ψ j y)) (fderiv ℝ (ψ j) y e) = fderiv ℝ (F j) y e := by
  intro TL P n U M f L hU hMmeas hMU hrect hfin hf
  -- `M ⊆ N₀ ∪ ⋃ₗ Nₗ` with `H^{n+1}(N₀) = 0` and embedded `C¹` submanifolds `Nₗ`
  obtain ⟨N₀, N, hN₀, hN, hMN⟩ := Submission.dor_lmbsf_rectifiable_c1_cover P (n + 1) M hrect
  -- countably many charts `ψₛ : Vₛ → U` with `M ⊆ N₀ ∪ ⋃ₛ ψₛ(Vₛ)`
  obtain ⟨V, ψ, hchart, hMV⟩ :=
    Submission.dor_lmbsf_cp_submanifold_chart_cover P (n + 1) U M N₀ N hU hMU hN hMN
  -- compact pieces `C s k ⊆ int C' s k`, `C' s k ⊆ Vₛ`, with `f ∘ ψₛ = F s k` on `C s k`,
  -- covering `Vₛ` up to a Lebesgue-null set
  choose C C' F hpiece hnull using fun s =>
    Submission.dor_lmbsf_cp_chart_c1_pieces Submission.dor_lmbsf_lipschitz_c1_approx (n + 1) P
      (V s) (ψ s) f L (hchart s).1 (hchart s).2.1 hf
  -- the pieces miss only `N₀ ∪ ⋃ₛ ψₛ(Vₛ ∖ ⋃ₖ C s k)`, which is `H^{n+1}`-null
  have hcov : μHE[n + 1] (M \ ⋃ j, ψ (Nat.unpair j).1 '' C (Nat.unpair j).1 (Nat.unpair j).2)
      = 0 := by
    refine measure_mono_null ?_ (measure_union_null hN₀ (measure_iUnion_null fun s =>
      Submission.dor_lmbsf_cp_c1_image_null (n + 1) P (V s) (V s \ ⋃ k, C s k) (ψ s)
        (hchart s).1 (hchart s).2.1 sdiff_subset (hnull s)))
    rintro x ⟨hxM, hx⟩
    rcases hMV hxM with hx₀ | hx₁
    · exact mem_union_left _ hx₀
    · obtain ⟨s, y, hyV, rfl⟩ := mem_iUnion.1 hx₁
      refine mem_union_right _ (mem_iUnion.2 ⟨s, y, ⟨hyV, fun hyC => hx ?_⟩, rfl⟩)
      obtain ⟨k, hyk⟩ := mem_iUnion.1 hyC
      exact mem_iUnion.2
        ⟨Nat.pair s k, by simpa only [Nat.unpair_pair] using mem_image_of_mem (ψ s) hyk⟩
  -- index the pieces by `j = Nat.pair s k`
  obtain ⟨Vj, ψj, Cj, C'j, Fj, hchartj, hpiecej, hcovj⟩ : ∃ (Vj : ℕ → Set (Euclid (n + 1)))
      (ψj : ℕ → Euclid (n + 1) → Euclid P) (Cj C'j : ℕ → Set (Euclid (n + 1)))
      (Fj : ℕ → Euclid (n + 1) → ℝ),
      (∀ j, IsOpen (Vj j) ∧ ContDiffOn ℝ 1 (ψj j) (Vj j) ∧ InjOn (ψj j) (Vj j) ∧
        (∀ y ∈ Vj j, Injective (fderiv ℝ (ψj j) y)) ∧ ψj j '' Vj j ⊆ U) ∧
      (∀ j, IsCompact (Cj j) ∧ IsCompact (C'j j) ∧ Convex ℝ (C'j j) ∧ Cj j ⊆ interior (C'j j) ∧
        C'j j ⊆ Vj j ∧ ContDiff ℝ 1 (Fj j) ∧ ∀ y ∈ Cj j, f (ψj j y) = Fj j y) ∧
      μHE[n + 1] (M \ ⋃ j, ψj j '' Cj j) = 0 :=
    ⟨fun j => V (Nat.unpair j).1, fun j => ψ (Nat.unpair j).1,
      fun j => C (Nat.unpair j).1 (Nat.unpair j).2, fun j => C' (Nat.unpair j).1 (Nat.unpair j).2,
      fun j => F (Nat.unpair j).1 (Nat.unpair j).2, fun j => hchart _, fun j => hpiece _ _, hcov⟩
  have hCV : ∀ j, Cj j ⊆ Vj j := fun j =>
    (hpiecej j).2.2.2.1.trans (interior_subset.trans (hpiecej j).2.2.2.2.1)
  -- (TL) and the tangent planes of `ψⱼ(C'ⱼ)`: `TₓM = Dψⱼ(y)(ℝ^{n+1})` a.e. on `M ∩ ψⱼ(Cⱼ)`
  have htan : ∀ j, ∀ᵐ x ∂(μHE[n + 1].restrict (M ∩ ψj j '' Cj j)), ∀ y ∈ Cj j, ψj j y = x →
      HasApproximateTangentSpaceAt (n + 1) M x
        (LinearMap.range (fderiv ℝ (ψj j) y : Euclid (n + 1) →ₗ[ℝ] Euclid P)) := by
    intro j
    obtain ⟨hVo, hψc, hψi, hψd, hψU⟩ := hchartj j
    obtain ⟨hCc, hC'c, hC'conv, hCC', hC'V, -, -⟩ := hpiecej j
    exact Submission.dor_lmbsf_cp_chart_tangent_ae TL P (n + 1) U M (Cj j) (C'j j) (ψj j) hU
      hMmeas hMU hfin (hψc.mono hC'V) ((image_mono hC'V).trans hψU) hCc hC'c hC'conv hCC'
      fun y hy => Submission.dor_lmbsf_c1_image_approxTangent (n + 1) P (Vj j) (C'j j) (ψj j) y
        hVo hψc hC'c hC'V (hψi.mono hC'V) hy (hψd y (hC'V (interior_subset hy)))
  -- density points: `|DFⱼ(y)e| ≤ L|Dψⱼ(y)e|` off a Lebesgue-null set, whose image is null
  have hbd : ∀ j, ∀ᵐ x ∂(μHE[n + 1].restrict (M ∩ ψj j '' Cj j)), ∀ y ∈ Cj j, ψj j y = x →
      ∀ e : Euclid (n + 1), |fderiv ℝ (Fj j) y e| ≤ (L : ℝ) * ‖fderiv ℝ (ψj j) y e‖ := by
    intro j
    obtain ⟨hVo, hψc, -, -, -⟩ := hchartj j
    obtain ⟨hCc, -, -, -, -, hFc, hfF⟩ := hpiecej j
    have hae := ae_iff.1 (Submission.dor_lmbsf_cp_gradient_bound_ae
      Submission.dor_lmbsf_density_directions (n + 1) P (Cj j) (Fj j) (ψj j) f L hCc.measurableSet
      (fun y hy => ⟨hFc.differentiable one_ne_zero y,
        (hψc.differentiableOn one_ne_zero).differentiableAt (hVo.mem_nhds (hCV j hy))⟩) hfF hf)
    refine ae_restrict_of_ae (ae_iff.2 (measure_mono_null ?_
      (Submission.dor_lmbsf_cp_c1_image_null (n + 1) P (Vj j) _ (ψj j) hVo hψc ?_ hae)))
    · intro x hx
      by_contra hx'
      refine hx fun y hy hyx => ?_
      subst hyx
      by_contra hbad
      exact hx' ⟨y, fun h => hbad (h hy), rfl⟩
    · exact fun y hy => hCV j (not_imp.1 hy).1
  -- disjoint Borel pieces `ψⱼ(Yⱼ) ⊆ M` consisting of good points
  obtain ⟨Y, hY, hdisj, hYnull⟩ := Submission.dor_lmbsf_cp_disjoint_refinement (n + 1) P
    μHE[n + 1] M Cj ψj
    (fun j y => HasApproximateTangentSpaceAt (n + 1) M (ψj j y)
        (LinearMap.range (fderiv ℝ (ψj j) y : Euclid (n + 1) →ₗ[ℝ] Euclid P)) ∧
      ∀ e : Euclid (n + 1), |fderiv ℝ (Fj j) y e| ≤ (L : ℝ) * ‖fderiv ℝ (ψj j) y e‖)
    hMmeas (fun j => ⟨(hpiecej j).1, (hchartj j).2.1.continuousOn.mono (hCV j)⟩) hcovj
    fun j => by
      filter_upwards [htan j, hbd j] with x h₁ h₂ y hy hyx
      subst hyx
      exact ⟨h₁ y hy rfl, h₂ y hy rfl⟩
  have hYV : ∀ j, Y j ⊆ Vj j := fun j => (hY j).2.1.trans (hCV j)
  -- tangential lifts `Φⱼ` of `DFⱼ` (e.g. `Dψⱼ(DψⱼᵀDψⱼ)⁻¹∇Fⱼ`), glued into a Borel `g`,
  -- zero off `⋃ⱼ ψⱼ(Yⱼ)`
  choose Φ hΦc hΦ using fun j => Submission.dor_lmbsf_cp_chart_tangent_lift (n + 1) P (Vj j)
    (ψj j) (Fj j) (hchartj j).1 (hchartj j).2.1 (hchartj j).2.2.2.1 (hpiecej j).2.2.2.2.2.1
  obtain ⟨g, hgm, hgval, hg0⟩ := Submission.dor_lmbsf_cp_measurable_glue (n + 1) P Y ψj Φ
    (fun j => ⟨(hY j).1, (hchartj j).2.1.continuousOn.mono (hYV j),
      (hchartj j).2.2.1.mono (hYV j), (hΦc j).mono (hYV j)⟩) hdisj
  refine ⟨Vj, Cj, Y, ψj, Fj, g, hchartj, fun j => ⟨(hpiecej j).1, hCV j, (hY j).1, (hY j).2.1,
    (hpiecej j).2.2.2.2.2.1⟩, fun j => (hY j).2.2.1, hdisj, hYnull,
    fun j y hy => ⟨(hpiecej j).2.2.2.2.2.2 y ((hY j).2.1 hy), ((hY j).2.2.2 y hy).1⟩, hgm,
    fun x => ?_, hg0, fun j y hy => ?_⟩
  · by_cases hx : ∃ j, x ∈ ψj j '' Y j
    · obtain ⟨j, y, hy, rfl⟩ := hx
      rw [hgval j y hy]
      exact (hΦ j y (hYV j hy)).2.2 L ((hY j).2.2.2 y hy).2
    · rw [hg0 x fun j hj => hx ⟨j, hj⟩, norm_zero]
      exact L.coe_nonneg
  · rw [hgval j y hy]
    exact ⟨(hΦ j y (hYV j hy)).1, (hΦ j y (hYV j hy)).2.1⟩

/-- **Slice area formula and Tonelli** (Simon Ch. 2, (3.5), sliced along the first coordinate).
Let `S ⊆ ℝⁿ⁺¹` be Borel and `Φ : ℝⁿ⁺¹ → ℝᴾ` differentiable with injective `DΦ(w)` at every
`w ∈ S` and injective on `S`; put `J'(w) = √det(⟨DΦ(w)eᵢ₊₁, DΦ(w)eⱼ₊₁⟩)`.  Then for Borel `φ ≥ 0`,
`t ↦ ∫_{Φ(S ∩ {w₀ = t})} φ dHⁿ` is a.e.-measurable and
`∫_ℝ ∫_{Φ(S ∩ {w₀ = t})} φ dHⁿ dt = ∫_S J'(w) φ(Φ(w)) dw`.  With `ins_t(z) = (t, z)` and
`ι(z) = (0, z)`, the slice `Φ(S ∩ {w₀ = t})` is the injective image of `S_t = ins_t⁻¹(S)` under
`Φ ∘ ins_t`, whose derivative `DΦ(ins_t z) ∘ ι` is injective with `ι eₖ = eₖ₊₁`; so the Gram area
formula (`codim1_lura_gram_area_formula`) gives `∫_{ℝⁿ} H(ins_t z) dz` for the Borel integrand
`H = 1_S · J' · (φ ∘ Φ)`.  The splitting `(t, z) ↦ ins_t(z)`, `ℝ × ℝⁿ ≅ ℝⁿ⁺¹`, is measure
preserving (`ofLp`, `piFinSuccAbove 0`, `toLp`), and Tonelli gives both claims. -/
theorem Submission.dor_lmbsf_pc_slice_area_tonelli : ∀ (P n : ℕ) (Φ : Euclid (n + 1) → Euclid P) (S : Set (Euclid (n + 1))), MeasurableSet S → (∀ w ∈ S, DifferentiableAt ℝ Φ w) → (∀ w ∈ S, Injective (fderiv ℝ Φ w)) → InjOn Φ S → ∀ φ : Euclid P → ℝ≥0∞, Measurable φ → AEMeasurable (fun t : ℝ => ∫⁻ x in Φ '' (S ∩ {w | w 0 = t}), φ x ∂μHE[n]) ∧ ∫⁻ t : ℝ, (∫⁻ x in Φ '' (S ∩ {w | w 0 = t}), φ x ∂μHE[n]) = ∫⁻ w in S, ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun i j : Fin n => inner ℝ (fderiv ℝ Φ w (EuclideanSpace.single i.succ 1)) (fderiv ℝ Φ w (EuclideanSpace.single j.succ 1))))) * φ (Φ w) ∂volume := by
  have hR := Submission.codim1_lura_gram_area_formula
  intro P n Φ S hS hd hinj hInj φ hφ
  classical
  -- the slice embeddings `z ↦ (t, z)` and their common linear part `ι`
  let ins : ℝ → Euclid n → Euclid (n + 1) := fun t z =>
    WithLp.toLp 2 (Fin.cons t (WithLp.ofLp z) : Fin (n + 1) → ℝ)
  let ιlin : Euclid n →ₗ[ℝ] Euclid (n + 1) :=
    { toFun := fun z => WithLp.toLp 2 (Fin.cons 0 (WithLp.ofLp z) : Fin (n + 1) → ℝ)
      map_add' := by
        intro y z; ext j; refine Fin.cases ?_ (fun k => ?_) j <;> simp
      map_smul' := by
        intro c y; ext j; refine Fin.cases ?_ (fun k => ?_) j <;> simp }
  let ι : Euclid n →L[ℝ] Euclid (n + 1) := LinearMap.toContinuousLinearMap ιlin
  have hins : ∀ t z, ins t z = ins t 0 + ι z := by
    intro t z; ext j; refine Fin.cases ?_ (fun k => ?_) j <;> simp [ins, ι, ιlin]
  have hinsD : ∀ t z, HasFDerivAt (ins t) ι z := by
    intro t z
    have : ins t = fun z => ins t 0 + ι z := funext (hins t)
    rw [this]
    exact ι.hasFDerivAt.const_add _
  have hιe : ∀ k : Fin n, ι (EuclideanSpace.single k 1) = EuclideanSpace.single k.succ 1 := by
    intro k; ext j; refine Fin.cases ?_ (fun l => ?_) j <;> simp [ι, ιlin, Pi.single_apply]
  -- slice Jacobian and integrand
  let J' : Euclid (n + 1) → ℝ := fun w => Real.sqrt (Matrix.det (Matrix.of fun i j : Fin n =>
    inner ℝ (fderiv ℝ Φ w (EuclideanSpace.single i.succ 1)) (fderiv ℝ Φ w (EuclideanSpace.single j.succ 1))))
  have hJ'm : Measurable J' := by
    have hc : Continuous (fun L : Euclid (n + 1) →L[ℝ] Euclid P => Real.sqrt (Matrix.det
        (Matrix.of fun i j : Fin n => inner ℝ (L (EuclideanSpace.single i.succ 1))
          (L (EuclideanSpace.single j.succ 1))))) := by
      refine Real.continuous_sqrt.comp (Continuous.matrix_det ?_)
      refine continuous_pi fun k => continuous_pi fun l => ?_
      exact (continuous_id.clm_apply continuous_const).inner (continuous_id.clm_apply continuous_const)
    exact hc.measurable.comp (measurable_fderiv ℝ Φ)
  let H : Euclid (n + 1) → ℝ≥0∞ := S.indicator (fun w => ENNReal.ofReal (J' w) * φ (Φ w))
  have hΦc : ContinuousOn Φ S := fun w hw => (hd w hw).continuousAt.continuousWithinAt
  have hHm : Measurable H := by
    have hpw : Measurable (S.piecewise Φ (fun _ => 0)) :=
      hΦc.measurable_piecewise continuousOn_const hS
    have : H = S.indicator (fun w => ENNReal.ofReal (J' w) * φ (S.piecewise Φ (fun _ => 0) w)) := by
      ext w
      by_cases hw : w ∈ S
      · simp [H, hw, Set.piecewise_eq_of_mem]
      · simp [H, hw]
    rw [this]
    exact ((hJ'm.ennreal_ofReal).mul (hφ.comp hpw)).indicator hS
  -- the inner integral, slice by slice
  have hinner : ∀ t : ℝ, ∫⁻ x in Φ '' (S ∩ {w | w 0 = t}), φ x ∂μHE[n] = ∫⁻ z, H (ins t z) := by
    intro t
    let St : Set (Euclid n) := ins t ⁻¹' S
    have hinsc : Continuous (ins t) := by
      have : ins t = fun z => ins t 0 + ι z := funext (hins t)
      rw [this]; exact continuous_const.add ι.continuous
    have hSt : MeasurableSet St := hinsc.measurable hS
    have himg : Φ '' (S ∩ {w | w 0 = t}) = (Φ ∘ ins t) '' St := by
      rw [image_comp]
      congr 1
      ext w
      constructor
      · rintro ⟨hwS, hwt⟩
        refine ⟨WithLp.toLp 2 (Fin.tail (WithLp.ofLp w)), ?_, ?_⟩
        · have : ins t (WithLp.toLp 2 (Fin.tail (WithLp.ofLp w))) = w := by
            ext j; refine Fin.cases ?_ (fun k => ?_) j
            · simpa [ins] using hwt.symm
            · simp [ins, Fin.tail]
          show ins t _ ∈ S
          rw [this]; exact hwS
        · ext j; refine Fin.cases ?_ (fun k => ?_) j
          · simpa [ins] using hwt.symm
          · simp [ins, Fin.tail]
      · rintro ⟨z, hz, rfl⟩
        exact ⟨hz, by simp [ins]⟩
    have hdt : ∀ z ∈ St, DifferentiableAt ℝ (Φ ∘ ins t) z := fun z hz =>
      (hd _ hz).comp z (hinsD t z).differentiableAt
    have hDt : ∀ z ∈ St, fderiv ℝ (Φ ∘ ins t) z = (fderiv ℝ Φ (ins t z)).comp ι := fun z hz =>
      ((hd _ hz).hasFDerivAt.comp z (hinsD t z)).fderiv
    have hιinj : Injective ι := by
      intro y z hyz
      ext k
      have := congrArg (fun v : Euclid (n + 1) => v k.succ) hyz
      simpa [ι, ιlin] using this
    have hinjt : ∀ z ∈ St, Injective (fderiv ℝ (Φ ∘ ins t) z) := by
      intro z hz
      rw [hDt z hz]
      exact (hinj _ hz).comp hιinj
    have hInjt : InjOn (Φ ∘ ins t) St := by
      intro y hy z hz hyz
      have h1 : ins t y = ins t z := hInj hy hz hyz
      have h2 : ι y = ι z := by
        rw [hins t y, hins t z] at h1; exact add_left_cancel h1
      exact hιinj h2
    rw [himg, (hR n P (Φ ∘ ins t)).2 St hSt hdt hinjt hInjt φ, ← lintegral_indicator hSt]
    congr 1
    ext z
    by_cases hz : z ∈ St
    · have hz' : ins t z ∈ S := hz
      simp only [indicator_of_mem hz, H, indicator_of_mem hz', hDt z hz, J',
        ContinuousLinearMap.comp_apply, hιe, comp_apply]
    · have hz' : ins t z ∉ S := hz
      simp only [indicator_of_notMem hz, H, indicator_of_notMem hz']
  -- the volume-preserving splitting `ℝ × ℝⁿ ≃ ℝⁿ⁺¹`
  have he : MeasurePreserving (fun p : ℝ × Euclid n => ins p.1 p.2) volume volume := by
    have h1 : MeasurePreserving (Prod.map (id : ℝ → ℝ) (WithLp.ofLp : Euclid n → (Fin n → ℝ)))
        (volume : Measure (ℝ × Euclid n)) (volume : Measure (ℝ × (Fin n → ℝ))) :=
      (MeasurePreserving.id volume).prod (PiLp.volume_preserving_ofLp (Fin n))
    have h2 := (volume_preserving_piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) 0).symm
    have h3 := PiLp.volume_preserving_toLp (Fin (n + 1))
    have h := h3.comp (h2.comp h1)
    convert h using 1
    funext p
    simp [ins, MeasurableEquiv.piFinSuccAbove_symm_apply]
    rfl
  have hHe : Measurable (fun p : ℝ × Euclid n => H (ins p.1 p.2)) := hHm.comp he.measurable
  refine ⟨?_, ?_⟩
  · simp_rw [hinner]
    exact hHe.lintegral_prod_right'.aemeasurable
  · simp_rw [hinner]
    rw [← lintegral_indicator hS]
    change ∫⁻ t, ∫⁻ z, H (ins t z) = ∫⁻ w, H w
    rw [← he.lintegral_comp hHm]
    exact (lintegral_prod _ hHe.aemeasurable).symm

/-- **Co-area formula for a patch parametrized over the slices `{w(0) = t}`** (Simon Ch. 2, §6).
Let `S ⊆ ℝⁿ⁺¹` be Borel, `Φ : ℝⁿ⁺¹ → ℝᴾ` differentiable with injective `DΦ(w)` at every `w ∈ S`
and injective on `S`, and let `G(Φ(w)) ∈ DΦ(w)(ℝⁿ⁺¹)` with `⟨G(Φ(w)), DΦ(w)e⟩ = e(0)` for
`w ∈ S`.  Then for Borel `φ ≥ 0`, `t ↦ ∫_{Φ(S ∩ {w(0) = t})} φ dHⁿ` is a.e.-measurable and
`∫_ℝ ∫_{Φ(S ∩ {w(0) = t})} φ dHⁿ dt = ∫_{Φ(S)} |G| φ dHⁿ⁺¹`.
Let `J(w)`, `J'(w)` be the Gram-determinant Jacobians of `DΦ(w)` on `e₀, …, eₙ` and on
`e₁, …, eₙ`.  Slicing gives `∫_ℝ ∫_{Φ(S ∩ {w(0) = t})} φ dHⁿ dt = ∫_S J'(w) φ(Φ(w)) dw`, the area
formula gives `∫_{Φ(S)} |G| φ dHⁿ⁺¹ = ∫_S J(w) |G(Φ(w))| φ(Φ(w)) dw`, and at `w ∈ S` the vector
`u = G(Φ(w))` lies in the span of the `aₗ = DΦ(w)eₗ` with `⟨u, aₗ⟩ = δₗ₀`, so the Gram cofactor
identity `det(⟨aᵢ₊₁, aⱼ₊₁⟩) = |u|² det(⟨aᵢ, aⱼ⟩)` gives `J'(w) = |u| J(w)`. -/
theorem Submission.dor_lmbsf_pc_param_coarea : ∀ (P n : ℕ) (Φ : Euclid (n + 1) → Euclid P) (S : Set (Euclid (n + 1))) (G : Euclid P → Euclid P), MeasurableSet S → (∀ w ∈ S, DifferentiableAt ℝ Φ w) → (∀ w ∈ S, Injective (fderiv ℝ Φ w)) → InjOn Φ S → (∀ w ∈ S, G (Φ w) ∈ LinearMap.range (fderiv ℝ Φ w : Euclid (n + 1) →ₗ[ℝ] Euclid P) ∧ ∀ e : Euclid (n + 1), inner ℝ (G (Φ w)) (fderiv ℝ Φ w e) = e 0) → ∀ φ : Euclid P → ℝ≥0∞, Measurable φ → AEMeasurable (fun t : ℝ => ∫⁻ x in Φ '' (S ∩ {w | w 0 = t}), φ x ∂μHE[n]) ∧ ∫⁻ t : ℝ, (∫⁻ x in Φ '' (S ∩ {w | w 0 = t}), φ x ∂μHE[n]) = ∫⁻ x in Φ '' S, ‖G x‖ₑ * φ x ∂μHE[n + 1] := by
  intro P n Φ S G hS hd hinj hInj hG φ hφ
  -- slicing: the slice integral is a.e.-measurable in `t` and integrates to `∫_S J' · φ ∘ Φ`
  obtain ⟨hmeas, heq⟩ :=
    Submission.dor_lmbsf_pc_slice_area_tonelli P n Φ S hS hd hinj hInj φ hφ
  refine ⟨hmeas, ?_⟩
  -- area formula with weight `|G| φ`: `∫_{Φ(S)} |G| φ dHⁿ⁺¹ = ∫_S J · (|G| φ) ∘ Φ`
  rw [heq, (Submission.codim1_lura_gram_area_formula (n + 1) P Φ).2 S hS hd hinj hInj
    (fun x => ‖G x‖ₑ * φ x)]
  -- the integrands agree on `S`: `J'(w) = |G(Φ(w))| J(w)`
  refine setLIntegral_congr_fun hS fun w hw => ?_
  obtain ⟨⟨v, hv⟩, hinner⟩ := hG w hw
  set a : Fin (n + 1) → Euclid P := fun i => fderiv ℝ Φ w (EuclideanSpace.single i 1)
  -- `u = G(Φ(w)) = DΦ(w)v = Σₗ vₗ aₗ` lies in the span of the `aₗ`
  have hspan : G (Φ w) ∈ Submodule.span ℝ (Set.range a) := by
    rw [Submodule.mem_span_range_iff_exists_fun]
    refine ⟨fun i => v i, ?_⟩
    have hv' : fderiv ℝ Φ w v = G (Φ w) := hv
    rw [← hv']
    have hvsum : v = ∑ i, v i • EuclideanSpace.single i (1 : ℝ) := by
      ext j
      simp [Finset.sum_apply, Pi.single_apply, Finset.sum_ite_eq]
    conv_rhs => rw [hvsum]
    simp [a, map_sum, map_smul]
  -- `⟨u, aₗ⟩ = eₗ(0) = δₗ₀`
  have ha0 : inner ℝ (G (Φ w)) (a 0) = 1 := by
    simp [a, hinner]
  have hak : ∀ k : Fin n, inner ℝ (G (Φ w)) (a k.succ) = 0 := by
    intro k
    simp [a, hinner, Fin.succ_ne_zero]
  -- Gram cofactor identity, then square roots
  have hgram := Submission.dor_lmbsf_pc_gram_det_succ_eq P n a (G (Φ w)) hspan ha0 hak
  simp only [a] at hgram
  rw [hgram, Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq (norm_nonneg _),
    ENNReal.ofReal_mul (norm_nonneg _), ofReal_norm]
  ring
/-- Straightening charts for the co-area step of the limsup mass bound (density one implies
regular, Simon 7.5 via the co-area formula of Ch. 2, §5): if `F : ℝ^{n+1} → ℝ` is `C¹`, then
`{DF ≠ 0}` is covered by countably many open sets `Ψ_q(B_q)`, where `B_q` is open and `Ψ_q` is
`C¹`, injective and with bijective derivative on `B_q`, and `F(Ψ_q(w)) = w(0)` on `B_q`.  Near `y₀`
with `DF(y₀) e_i ≠ 0` the map `Θ(y) = (F(y), y ∘ i.succAbove)` has injective derivative at `y₀`, so
its local inverse `χ` on an open `O` (`codim1_zsl_gc_local_inverse`) is such a chart with
`y₀ ∈ χ(O)`; second countability selects countably many of these charts. -/
theorem Submission.dor_lmbsf_pc_straightening_cover : ∀ (n : ℕ) (F : Euclid (n + 1) → ℝ), ContDiff ℝ 1 F → ∃ (B : ℕ → Set (Euclid (n + 1))) (Ψ : ℕ → Euclid (n + 1) → Euclid (n + 1)), (∀ q, IsOpen (B q)) ∧ (∀ q, ContDiffOn ℝ 1 (Ψ q) (B q)) ∧ (∀ q, InjOn (Ψ q) (B q)) ∧ (∀ q, ∀ w ∈ B q, Bijective (fderiv ℝ (Ψ q) w)) ∧ (∀ q, ∀ w ∈ B q, F (Ψ q w) = w 0) ∧ (∀ q, IsOpen (Ψ q '' B q)) ∧ {y | fderiv ℝ F y ≠ 0} ⊆ ⋃ q, Ψ q '' B q := by
  have hR3 := Submission.codim1_zsl_gc_local_inverse
  intro n F hF
  classical
  have hFd : Differentiable ℝ F := hF.differentiable one_ne_zero
  -- pointwise straightening
  have hloc : ∀ y₀ : Euclid (n + 1), fderiv ℝ F y₀ ≠ 0 →
      ∃ (B : Set (Euclid (n + 1))) (Ψ : Euclid (n + 1) → Euclid (n + 1)), IsOpen B ∧
        ContDiffOn ℝ 1 Ψ B ∧ InjOn Ψ B ∧ (∀ w ∈ B, Bijective (fderiv ℝ Ψ w)) ∧
        (∀ w ∈ B, F (Ψ w) = w 0) ∧ IsOpen (Ψ '' B) ∧ y₀ ∈ Ψ '' B := by
    intro y₀ hy₀
    have hexp : ∀ v : Euclid (n + 1), v = ∑ j, v j • EuclideanSpace.single j (1 : ℝ) := by
      intro v; ext j; simp [Finset.sum_apply, Pi.single_apply, Finset.sum_ite_eq]
    obtain ⟨i, hi⟩ : ∃ i : Fin (n + 1), fderiv ℝ F y₀ (EuclideanSpace.single i 1) ≠ 0 := by
      by_contra! h
      apply hy₀
      ext1 v
      rw [hexp v, map_sum]
      simp [h]
    -- the linear part `y ↦ (0, y ∘ i.succAbove)`
    let Llin : Euclid (n + 1) →ₗ[ℝ] Euclid (n + 1) :=
      { toFun := fun y => WithLp.toLp 2 (Fin.cons 0 (fun k => y (i.succAbove k)) : Fin (n + 1) → ℝ)
        map_add' := by
          intro y z; ext j; refine Fin.cases ?_ (fun k => ?_) j <;> simp
        map_smul' := by
          intro c y; ext j; refine Fin.cases ?_ (fun k => ?_) j <;> simp }
    let L : Euclid (n + 1) →L[ℝ] Euclid (n + 1) := LinearMap.toContinuousLinearMap Llin
    have hL0 : ∀ y, L y 0 = 0 := fun y => by simp [L, Llin]
    have hLs : ∀ y (k : Fin n), L y k.succ = y (i.succAbove k) := fun y k => by simp [L, Llin]
    let e0 : Euclid (n + 1) := EuclideanSpace.single 0 1
    let Θ : Euclid (n + 1) → Euclid (n + 1) := fun y => F y • e0 + L y
    have hΘ0 : ∀ y, Θ y 0 = F y := fun y => by simp [Θ, e0, hL0]
    have hΘc : ContDiff ℝ 1 Θ := (hF.smul contDiff_const).add L.contDiff
    have hΘD : ∀ y, fderiv ℝ Θ y = (fderiv ℝ F y).smulRight e0 + L := by
      intro y
      have h1 : HasFDerivAt (fun y => F y • e0) ((fderiv ℝ F y).smulRight e0) y :=
        (hFd y).hasFDerivAt.smul_const e0
      exact (h1.add L.hasFDerivAt).fderiv
    have hinj0 : Injective (fderiv ℝ Θ y₀) := by
      rw [hΘD y₀]
      have hker : ∀ h : Euclid (n + 1), ((fderiv ℝ F y₀).smulRight e0 + L) h = 0 → h = 0 := by
        intro h hh
        have hc0 := congrArg (fun v : Euclid (n + 1) => v 0) hh
        have hcs : ∀ k : Fin n, h (i.succAbove k) = 0 := by
          intro k
          have := congrArg (fun v : Euclid (n + 1) => v k.succ) hh
          simpa [e0, hLs, Fin.succ_ne_zero] using this
        have hhi : h = h i • EuclideanSpace.single i (1 : ℝ) := by
          ext j
          rcases Fin.eq_self_or_eq_succAbove i j with rfl | ⟨k, rfl⟩
          · simp
          · simp [hcs k, Fin.succAbove_ne]
        have hDF : fderiv ℝ F y₀ h = 0 := by simpa [e0, hL0] using hc0
        rw [hhi, map_smul, smul_eq_mul] at hDF
        have hi0 : h i = 0 := by
          rcases mul_eq_zero.mp hDF with h' | h'
          · exact h'
          · exact absurd h' hi
        rw [hhi, hi0, zero_smul]
      intro h1 h2 h12
      have := hker (h1 - h2) (by rw [map_sub, h12, sub_self])
      exact sub_eq_zero.mp this
    obtain ⟨V₀, O, χ, hV₀, hO, hy₀V₀, -, hχ, hχmaps, hΘχ, hχΘ⟩ :=
      hR3 (n + 1) Θ univ y₀ isOpen_univ (mem_univ _) hΘc.contDiffOn hinj0
    have hχd : ∀ a ∈ O, DifferentiableAt ℝ χ a := fun a ha =>
      (hχ.differentiableOn one_ne_zero a ha).differentiableAt (hO.mem_nhds ha)
    have himg : χ '' O = V₀ := by
      apply Subset.antisymm
      · rintro _ ⟨a, ha, rfl⟩; exact hχmaps ha
      · intro z hz; exact ⟨Θ z, (hχΘ z hz).1, (hχΘ z hz).2⟩
    refine ⟨O, χ, hO, hχ, ?_, ?_, ?_, ?_, ?_⟩
    · intro a ha b hb hab
      rw [← hΘχ a ha, ← hΘχ b hb, hab]
    · intro a ha
      have hid : fderiv ℝ (Θ ∘ χ) a = ContinuousLinearMap.id ℝ (Euclid (n + 1)) := by
        rw [Filter.EventuallyEq.fderiv_eq (f₁ := Θ ∘ χ) (f := id) ?_, fderiv_id]
        filter_upwards [hO.mem_nhds ha] with b hb using hΘχ b hb
      rw [fderiv_comp a (hΘc.differentiable one_ne_zero _) (hχd a ha)] at hid
      have hli : Function.LeftInverse (fderiv ℝ Θ (χ a)) (fderiv ℝ χ a) := fun u => by
        simpa using DFunLike.congr_fun hid u
      have hinj : Injective (fderiv ℝ χ a) := hli.injective
      exact ⟨hinj, LinearMap.surjective_of_injective
        (f := (fderiv ℝ χ a : Euclid (n + 1) →ₗ[ℝ] Euclid (n + 1))) hinj⟩
    · intro a ha
      rw [← hΘ0, hΘχ a ha]
    · rw [himg]; exact hV₀
    · rw [himg]; exact hy₀V₀
  let O' : Set (Euclid (n + 1)) := {y | fderiv ℝ F y ≠ 0}
  choose! Bf Ψf hBf hΨf hinjf hbijf hFf hopenf hmemf using hloc
  obtain ⟨T, hTc, hTU⟩ := TopologicalSpace.isOpen_iUnion_countable
    (fun y : O' => Ψf y '' Bf y) (fun y => hopenf y y.2)
  by_cases hT : T.Nonempty
  · obtain ⟨e, he⟩ := hTc.exists_eq_range hT
    refine ⟨fun q => Bf (e q), fun q => Ψf (e q), fun q => hBf _ (e q).2, fun q => hΨf _ (e q).2,
      fun q => hinjf _ (e q).2, fun q => hbijf _ (e q).2, fun q => hFf _ (e q).2,
      fun q => hopenf _ (e q).2, ?_⟩
    intro y hy
    have h1 : y ∈ ⋃ z : O', Ψf z '' Bf z := mem_iUnion.mpr ⟨⟨y, hy⟩, hmemf y hy⟩
    rw [← hTU] at h1
    obtain ⟨z, hzT, hz⟩ := mem_iUnion₂.mp h1
    rw [he] at hzT
    obtain ⟨q, rfl⟩ := hzT
    exact mem_iUnion.mpr ⟨q, hz⟩
  · refine ⟨fun _ => ∅, fun _ => id, fun _ => isOpen_empty, fun _ => contDiff_id.contDiffOn,
      fun _ => injOn_empty _, fun _ _ h => absurd h (notMem_empty _),
      fun _ _ h => absurd h (notMem_empty _), fun _ => by simp, ?_⟩
    intro y hy
    have h1 : y ∈ ⋃ z : O', Ψf z '' Bf z := mem_iUnion.mpr ⟨⟨y, hy⟩, hmemf y hy⟩
    rw [← hTU] at h1
    obtain ⟨z, hzT, -⟩ := mem_iUnion₂.mp h1
    exact absurd ⟨z, hzT⟩ hT

/-- **Co-area formula on one straightened patch of a `C¹` chart** (Simon Ch. 2, §6; Ch. 3,
(2.8)–(2.9)).  Let `ψ : ℝⁿ⁺¹ → ℝᴾ` be `C¹` and injective with injective `Dψ` on the open set `V`,
`F : ℝⁿ⁺¹ → ℝ` be `C¹`, and `Ψ : ℝⁿ⁺¹ → ℝⁿ⁺¹` be `C¹` and injective with bijective `DΨ` on the
open set `B`, straightening `F` to the first coordinate: `F(Ψ(w)) = w(0)` on `B`.  Let
`Z ⊆ V ∩ Ψ(B)` be Borel, with `G(ψ(y)) ∈ Dψ(y)(ℝⁿ⁺¹)` and `⟨G(ψ(y)), Dψ(y)e⟩ = DF(y)e` for
`y ∈ Z`.  Then for Borel `φ ≥ 0`, `t ↦ ∫_{ψ(Z ∩ F⁻¹(t))} φ dHⁿ` is a.e.-measurable and
`∫_ℝ ∫_{ψ(Z ∩ F⁻¹(t))} φ dHⁿ dt = ∫_{ψ(Z)} |G| φ dHⁿ⁺¹`.
On the Borel patch `S = B ∩ Ψ⁻¹(Z)` the map `Φ = ψ ∘ Ψ` is injective, with injective derivative
`DΦ(w) = Dψ(Ψ(w)) ∘ DΨ(w)`.  Since `F ∘ Ψ` is the first coordinate on `B`,
`DF(Ψ(w)) ∘ DΨ(w) = (e ↦ e(0))`, so `G(Φ(w)) ∈ DΦ(w)(ℝⁿ⁺¹)` and `⟨G(Φ(w)), DΦ(w)e⟩ = e(0)`.  The
patch co-area formula applies to `(Φ, S)`, and `Φ(S) = ψ(Z)`,
`Φ(S ∩ {w(0) = t}) = ψ(Z ∩ F⁻¹(t))`. -/
theorem Submission.dor_lmbsf_pc_chart_patch_coarea : ∀ (P n : ℕ) (V B Z : Set (Euclid (n + 1))) (ψ : Euclid (n + 1) → Euclid P) (F : Euclid (n + 1) → ℝ) (Ψ : Euclid (n + 1) → Euclid (n + 1)) (G : Euclid P → Euclid P), IsOpen V → ContDiffOn ℝ 1 ψ V → InjOn ψ V → (∀ y ∈ V, Injective (fderiv ℝ ψ y)) → ContDiff ℝ 1 F → IsOpen B → ContDiffOn ℝ 1 Ψ B → InjOn Ψ B → (∀ w ∈ B, Bijective (fderiv ℝ Ψ w)) → (∀ w ∈ B, F (Ψ w) = w 0) → MeasurableSet Z → Z ⊆ V → Z ⊆ Ψ '' B → (∀ y ∈ Z, G (ψ y) ∈ LinearMap.range (fderiv ℝ ψ y : Euclid (n + 1) →ₗ[ℝ] Euclid P) ∧ ∀ e : Euclid (n + 1), inner ℝ (G (ψ y)) (fderiv ℝ ψ y e) = fderiv ℝ F y e) → ∀ φ : Euclid P → ℝ≥0∞, Measurable φ → AEMeasurable (fun t : ℝ => ∫⁻ x in ψ '' (Z ∩ F ⁻¹' {t}), φ x ∂μHE[n]) ∧ ∫⁻ t : ℝ, (∫⁻ x in ψ '' (Z ∩ F ⁻¹' {t}), φ x ∂μHE[n]) = ∫⁻ x in ψ '' Z, ‖G x‖ₑ * φ x ∂μHE[n + 1] := by
  intro P n V B Z ψ F Ψ G hV hψ hψinj hψreg hF hB hΨ hΨinj hΨbij hFΨ hZ hZV hZB hG φ hφ
  have hΨd : ∀ w ∈ B, DifferentiableAt ℝ Ψ w := fun w hw =>
    (hΨ.differentiableOn one_ne_zero w hw).differentiableAt (hB.mem_nhds hw)
  have hψd : ∀ y ∈ V, DifferentiableAt ℝ ψ y := fun y hy =>
    (hψ.differentiableOn one_ne_zero y hy).differentiableAt (hV.mem_nhds hy)
  -- the patch `S = B ∩ Ψ⁻¹(Z)` is Borel: `Ψ` is continuous on the open set `B`
  set S : Set (Euclid (n + 1)) := B ∩ Ψ ⁻¹' Z with hSdef
  have hSm : MeasurableSet S := by
    classical
    have hpw : Measurable (B.piecewise Ψ (fun _ => 0)) :=
      hΨ.continuousOn.measurable_piecewise continuousOn_const hB.measurableSet
    have : S = B ∩ (B.piecewise Ψ (fun _ => 0)) ⁻¹' Z := by
      ext w
      constructor
      · rintro ⟨hw, hwZ⟩
        exact ⟨hw, by simpa [Set.piecewise_eq_of_mem _ _ _ hw] using hwZ⟩
      · rintro ⟨hw, hwZ⟩
        exact ⟨hw, by simpa [Set.piecewise_eq_of_mem _ _ _ hw] using hwZ⟩
    rw [this]
    exact hB.measurableSet.inter (hpw hZ)
  -- `Φ = ψ ∘ Ψ` is differentiable and injective on `S`, with `DΦ(w) = Dψ(Ψ(w)) ∘ DΨ(w)` injective
  set Φ : Euclid (n + 1) → Euclid P := ψ ∘ Ψ with hΦdef
  have hSZ : ∀ w ∈ S, Ψ w ∈ Z := fun w hw => hw.2
  have hΦd : ∀ w ∈ S, DifferentiableAt ℝ Φ w := fun w hw =>
    (hψd _ (hZV (hSZ w hw))).comp w (hΨd w hw.1)
  have hΦD : ∀ w ∈ S, fderiv ℝ Φ w = (fderiv ℝ ψ (Ψ w)).comp (fderiv ℝ Ψ w) := fun w hw =>
    fderiv_comp w (hψd _ (hZV (hSZ w hw))) (hΨd w hw.1)
  have hΦinjD : ∀ w ∈ S, Injective (fderiv ℝ Φ w) := by
    intro w hw
    rw [hΦD w hw]
    exact (hψreg _ (hZV (hSZ w hw))).comp (hΨbij w hw.1).1
  have hΦinj : InjOn Φ S := by
    intro a ha b hb hab
    exact hΨinj ha.1 hb.1 (hψinj (hZV (hSZ a ha)) (hZV (hSZ b hb)) hab)
  -- `F ∘ Ψ` is the first coordinate near every `w ∈ B`, so `DF(Ψ(w))(DΨ(w)e) = e(0)`
  have hDFΨ : ∀ w ∈ B, ∀ e : Euclid (n + 1), fderiv ℝ F (Ψ w) (fderiv ℝ Ψ w e) = e 0 := by
    intro w hw e
    have h1 : fderiv ℝ (F ∘ Ψ) w =
        fderiv ℝ (EuclideanSpace.proj (0 : Fin (n + 1)) : Euclid (n + 1) → ℝ) w := by
      apply Filter.EventuallyEq.fderiv_eq
      filter_upwards [hB.mem_nhds hw] with v hv
      simp [hFΨ v hv]
    have h2 : fderiv ℝ (F ∘ Ψ) w = (fderiv ℝ F (Ψ w)).comp (fderiv ℝ Ψ w) :=
      fderiv_comp w ((hF.differentiable one_ne_zero) _) (hΨd w hw)
    rw [h2, ContinuousLinearMap.fderiv] at h1
    have := congrArg (fun L : Euclid (n + 1) →L[ℝ] ℝ => L e) h1
    simpa using this
  -- the hypotheses on `G` transported to the parametrization `Φ`
  have hGΦ : ∀ w ∈ S, G (Φ w) ∈ LinearMap.range (fderiv ℝ Φ w : Euclid (n + 1) →ₗ[ℝ] Euclid P) ∧
      ∀ e : Euclid (n + 1), inner ℝ (G (Φ w)) (fderiv ℝ Φ w e) = e 0 := by
    intro w hw
    obtain ⟨⟨v, hv⟩, hinner⟩ := hG (Ψ w) (hSZ w hw)
    refine ⟨?_, ?_⟩
    · -- `G(Φ(w)) = Dψ(Ψ(w))v` and `v = DΨ(w)u` since `DΨ(w)` is surjective
      obtain ⟨u, hu⟩ := (hΨbij w hw.1).2 v
      refine ⟨u, ?_⟩
      have hv' : fderiv ℝ ψ (Ψ w) v = G (ψ (Ψ w)) := hv
      change fderiv ℝ Φ w u = G (Φ w)
      rw [hΦD w hw, ContinuousLinearMap.comp_apply, hu, hv']
      rfl
    · intro e
      rw [hΦD w hw, ContinuousLinearMap.comp_apply]
      change inner ℝ (G (ψ (Ψ w))) _ = _
      rw [hinner, hDFΨ w hw.1 e]
  -- the patch co-area formula for `(Φ, S)`
  obtain ⟨hmeas, heq⟩ :=
    Submission.dor_lmbsf_pc_param_coarea P n Φ S G hSm hΦd hΦinjD hΦinj hGΦ φ hφ
  -- back to the chart: `Φ(S) = ψ(Z)` and `Φ(S ∩ {w(0) = t}) = ψ(Z ∩ F⁻¹(t))`
  have himg : Φ '' S = ψ '' Z := by
    rw [hΦdef, image_comp]
    congr 1
    ext y
    constructor
    · rintro ⟨w, hw, rfl⟩
      exact hw.2
    · intro hy
      obtain ⟨w, hw, rfl⟩ := hZB hy
      exact ⟨w, ⟨hw, hy⟩, rfl⟩
  have himgt : ∀ t : ℝ, Φ '' (S ∩ {w | w 0 = t}) = ψ '' (Z ∩ F ⁻¹' {t}) := by
    intro t
    rw [hΦdef, image_comp]
    congr 1
    ext y
    constructor
    · rintro ⟨w, ⟨⟨hwB, hwZ⟩, hwt⟩, rfl⟩
      refine ⟨hwZ, ?_⟩
      simp only [mem_preimage, mem_singleton_iff, hFΨ w hwB]
      exact hwt
    · rintro ⟨hy, hFy⟩
      obtain ⟨w, hw, rfl⟩ := hZB hy
      refine ⟨w, ⟨⟨hw, hy⟩, ?_⟩, rfl⟩
      simp only [mem_preimage, mem_singleton_iff, hFΨ w hw] at hFy
      exact hFy
  simp only [himgt] at hmeas heq
  rw [himg] at heq
  exact ⟨hmeas, heq⟩
/-- **Gluing countably many co-area pieces** (countable additivity of `∫⁻`).  Let `ψ` be continuous
and injective on `Z = ⋃_q Z_q`, the `Z_q` pairwise disjoint Borel sets, and `F` Borel.  Images
under `ψ` of Borel subsets of `Z` are Borel (Lusin–Souslin) and images of disjoint subsets of `Z`
are disjoint, so `ψ(Z ∩ F⁻¹{t}) = ⋃_q ψ(Z_q ∩ F⁻¹{t})` and `ψ(Z) = ⋃_q ψ(Z_q)` are countable
disjoint Borel unions.  Hence `∫_{ψ(Z ∩ F⁻¹{t})} φ dHⁿ = Σ_q ∫_{ψ(Z_q ∩ F⁻¹{t})} φ dHⁿ`, a countable
sum of a.e.-measurable functions of `t`, and exchanging `∫ dt` with `Σ_q` turns the co-area
identities of the pieces into `∫_ℝ ∫_{ψ(Z ∩ F⁻¹{t})} φ dHⁿ dt = Σ_q ∫_{ψ(Z_q)} g dH^{n+1}
= ∫_{ψ(Z)} g dH^{n+1}`. -/
theorem Submission.dor_lmbsf_pc_coarea_glue : ∀ (P n : ℕ) (Z : Set (Euclid (n + 1))) (Zs : ℕ → Set (Euclid (n + 1))) (ψ : Euclid (n + 1) → Euclid P) (F : Euclid (n + 1) → ℝ) (φ g : Euclid P → ℝ≥0∞), ContinuousOn ψ Z → InjOn ψ Z → Measurable F → (∀ q, MeasurableSet (Zs q)) → Pairwise (fun p q => Disjoint (Zs p) (Zs q)) → (⋃ q, Zs q) = Z → (∀ q, AEMeasurable (fun t : ℝ => ∫⁻ x in ψ '' (Zs q ∩ F ⁻¹' {t}), φ x ∂μHE[n]) ∧ ∫⁻ t : ℝ, (∫⁻ x in ψ '' (Zs q ∩ F ⁻¹' {t}), φ x ∂μHE[n]) = ∫⁻ x in ψ '' Zs q, g x ∂μHE[n + 1]) → AEMeasurable (fun t : ℝ => ∫⁻ x in ψ '' (Z ∩ F ⁻¹' {t}), φ x ∂μHE[n]) ∧ ∫⁻ t : ℝ, (∫⁻ x in ψ '' (Z ∩ F ⁻¹' {t}), φ x ∂μHE[n]) = ∫⁻ x in ψ '' Z, g x ∂μHE[n + 1] := by
  intro P n Z Zs ψ F φ g hψc hψinj hF hZsm hZsd hZsU hq
  have hZsZ : ∀ q, Zs q ⊆ Z := fun q => hZsU ▸ subset_iUnion Zs q
  -- images of Borel subsets of `Z` are Borel (Lusin–Souslin)
  have himgm : ∀ A : Set (Euclid (n + 1)), MeasurableSet A → A ⊆ Z → MeasurableSet (ψ '' A) :=
    fun A hA hAZ => hA.image_of_continuousOn_injOn (hψc.mono hAZ) (hψinj.mono hAZ)
  -- images of disjoint subsets of `Z` are disjoint (`ψ` is injective on `Z`)
  have himgd : ∀ A A' : Set (Euclid (n + 1)), A ⊆ Z → A' ⊆ Z → Disjoint A A' →
      Disjoint (ψ '' A) (ψ '' A') := by
    intro A A' hA hA' hd
    rw [Set.disjoint_left]
    rintro x ⟨a, ha, rfl⟩ ⟨b, hb, hab⟩
    have := hψinj (hA' hb) (hA ha) hab
    exact Set.disjoint_left.mp hd ha (this ▸ hb)
  -- each slice integral is the sum of the slice integrals of the pieces
  have hslice : ∀ t : ℝ, ∫⁻ x in ψ '' (Z ∩ F ⁻¹' {t}), φ x ∂μHE[n] =
      ∑' q, ∫⁻ x in ψ '' (Zs q ∩ F ⁻¹' {t}), φ x ∂μHE[n] := by
    intro t
    have hU : ψ '' (Z ∩ F ⁻¹' {t}) = ⋃ q, ψ '' (Zs q ∩ F ⁻¹' {t}) := by
      rw [← image_iUnion, ← iUnion_inter, hZsU]
    rw [hU, lintegral_iUnion
      (fun q => himgm _ ((hZsm q).inter (hF (measurableSet_singleton t)))
        (inter_subset_left.trans (hZsZ q)))
      (fun p q hpq => himgd _ _ (inter_subset_left.trans (hZsZ p))
        (inter_subset_left.trans (hZsZ q)) ((hZsd hpq).mono inter_subset_left inter_subset_left))]
  -- likewise for the right-hand side
  have hrhs : ∫⁻ x in ψ '' Z, g x ∂μHE[n + 1] = ∑' q, ∫⁻ x in ψ '' Zs q, g x ∂μHE[n + 1] := by
    have hU : ψ '' Z = ⋃ q, ψ '' Zs q := by rw [← image_iUnion, hZsU]
    rw [hU]
    exact lintegral_iUnion (fun q => himgm _ (hZsm q) (hZsZ q))
      (fun p q hpq => himgd _ _ (hZsZ p) (hZsZ q) (hZsd hpq)) g
  simp only [hslice]
  refine ⟨AEMeasurable.tsum (fun q => (hq q).1), ?_⟩
  rw [lintegral_tsum (fun q => (hq q).1), hrhs]
  exact tsum_congr (fun q => (hq q).2)

/-- **Co-area formula on one `C¹` chart piece** (Simon Ch. 3, 2.8–2.9; Ch. 2, 3.5).  Let `ψ` be a
`C¹` injective immersion of the open `V ⊆ ℝⁿ⁺¹` into `ℝᴾ`, `Y ⊆ C ⊆ V` Borel, `F` a `C¹` function
with `f ∘ ψ = F` on `Y`, and `G` the tangential gradient of `f` along `ψ(Y)`.  On `Y`, `G(ψ(y)) = 0`
iff `DF(y) = 0` (write `G(ψ(y)) = Dψ(y)v`, so `|G(ψ(y))|² = DF(y)v`), hence for `Y' = Y ∩ {DF ≠ 0}`
every slice is `ψ(Y) ∩ {G ≠ 0} ∩ f⁻¹{t} = ψ(Y' ∩ F⁻¹{t})`, and `ψ(Y ∖ Y')` contributes nothing to
`∫_{ψ(Y)} |G| φ dHⁿ⁺¹`.  The straightening charts `Ψ_q(B_q)` cover `{DF ≠ 0}`; the Borel pieces
`Z_q = Y' ∩ disjointed (Ψ_q(B_q)) q` are pairwise disjoint with union `Y'`, each satisfies the
co-area identity on its chart, and gluing the pieces gives the identity on `Y'`. -/
theorem Submission.dor_lmbsf_piece_coarea : ∀ (P n : ℕ) (V C Y : Set (Euclid (n + 1))) (ψ : Euclid (n + 1) → Euclid P) (F : Euclid (n + 1) → ℝ) (f : Euclid P → ℝ) (G : Euclid P → Euclid P), IsOpen V → ContDiffOn ℝ 1 ψ V → InjOn ψ V → (∀ y ∈ V, Injective (fderiv ℝ ψ y)) → IsCompact C → C ⊆ V → MeasurableSet Y → Y ⊆ C → ContDiff ℝ 1 F → (∀ y ∈ Y, f (ψ y) = F y) → (∀ y ∈ Y, G (ψ y) ∈ LinearMap.range (fderiv ℝ ψ y : Euclid (n + 1) →ₗ[ℝ] Euclid P) ∧ ∀ e : Euclid (n + 1), inner ℝ (G (ψ y)) (fderiv ℝ ψ y e) = fderiv ℝ F y e) → Measurable G → ∀ φ : Euclid P → ℝ≥0∞, Measurable φ → AEMeasurable (fun t => ∫⁻ x in ψ '' Y ∩ {x | G x ≠ 0} ∩ f ⁻¹' {t}, φ x ∂μHE[n]) ∧ ∫⁻ t, (∫⁻ x in ψ '' Y ∩ {x | G x ≠ 0} ∩ f ⁻¹' {t}, φ x ∂μHE[n]) = ∫⁻ x in ψ '' Y, ‖G x‖ₑ * φ x ∂μHE[n + 1] := by
  intro P n V C Y ψ F f G hV hψ hψinj hDψ _ hCV hY hYC hF hfF hG _ φ hφ
  have hYV : Y ⊆ V := hYC.trans hCV
  -- on `Y`, the tangential gradient vanishes exactly where `DF` does
  have hG0 : ∀ y ∈ Y, G (ψ y) = 0 ↔ fderiv ℝ F y = 0 := by
    intro y hy
    obtain ⟨⟨v, hv⟩, he⟩ := hG y hy
    constructor
    · intro h0
      refine ContinuousLinearMap.ext fun e => ?_
      rw [← he e, h0, inner_zero_left, zero_apply]
    · intro h0
      have hvv : inner ℝ (G (ψ y)) (G (ψ y)) = fderiv ℝ F y v := by
        rw [← he v]
        exact congrArg (inner ℝ (G (ψ y))) hv.symm
      rw [h0, zero_apply] at hvv
      exact inner_self_eq_zero.mp hvv
  -- the regular part `Y' = Y ∩ {DF ≠ 0}` is Borel
  obtain ⟨Y', hY'⟩ : ∃ Y' : Set (Euclid (n + 1)), Y' = Y ∩ {y | fderiv ℝ F y ≠ 0} := ⟨_, rfl⟩
  have hY'Y : Y' ⊆ Y := hY' ▸ inter_subset_left
  have hY'V : Y' ⊆ V := hY'Y.trans hYV
  have hY'm : MeasurableSet Y' := hY' ▸
    hY.inter (isOpen_ne_fun (hF.continuous_fderiv one_ne_zero) continuous_const).measurableSet
  have hmemY' : ∀ y ∈ Y, (y ∈ Y' ↔ fderiv ℝ F y ≠ 0) := fun y hy => by
    rw [hY']
    exact ⟨fun h => h.2, fun h => ⟨hy, h⟩⟩
  -- every slice is the image of a slice of the regular part
  have hslice : ∀ t : ℝ, ψ '' Y ∩ {x | G x ≠ 0} ∩ f ⁻¹' {t} = ψ '' (Y' ∩ F ⁻¹' {t}) := by
    intro t
    ext x
    simp only [mem_inter_iff, mem_image, mem_ofPred_eq, mem_preimage, mem_singleton_iff]
    constructor
    · rintro ⟨⟨⟨y, hy, rfl⟩, hGx⟩, hft⟩
      exact ⟨y, ⟨(hmemY' y hy).mpr fun h => hGx ((hG0 y hy).mpr h), (hfF y hy).symm.trans hft⟩,
        rfl⟩
    · rintro ⟨y, ⟨hy, hFt⟩, rfl⟩
      exact ⟨⟨⟨y, hY'Y hy, rfl⟩, fun h => (hmemY' y (hY'Y hy)).mp hy ((hG0 y (hY'Y hy)).mp h)⟩,
        (hfF y (hY'Y hy)).trans hFt⟩
  -- the critical part `ψ(Y ∖ Y')` carries no `|G| φ`-mass
  have hrhs : ∫⁻ x in ψ '' Y, ‖G x‖ₑ * φ x ∂μHE[n + 1] =
      ∫⁻ x in ψ '' Y', ‖G x‖ₑ * φ x ∂μHE[n + 1] := by
    have hcrit : MeasurableSet (ψ '' (Y \ Y')) :=
      (hY.diff hY'm).image_of_continuousOn_injOn (hψ.continuousOn.mono (sdiff_subset.trans hYV))
        (hψinj.mono (sdiff_subset.trans hYV))
    have hdisj : Disjoint (ψ '' Y') (ψ '' (Y \ Y')) := by
      rw [Set.disjoint_left]
      rintro x ⟨a, ha, rfl⟩ ⟨b, hb, hab⟩
      have := hψinj (hYV hb.1) (hY'V ha) hab
      exact hb.2 (this ▸ ha)
    have hzero : ∫⁻ x in ψ '' (Y \ Y'), ‖G x‖ₑ * φ x ∂μHE[n + 1] = 0 := by
      refine setLIntegral_eq_zero₀ hcrit.nullMeasurableSet ?_
      rintro x ⟨y, ⟨hy, hy'⟩, rfl⟩
      have hDF : fderiv ℝ F y = 0 := not_not.mp fun h => hy' ((hmemY' y hy).mpr h)
      simp [(hG0 y hy).mpr hDF]
    rw [← union_sdiff_cancel hY'Y, image_union, lintegral_union hcrit hdisj, hzero, add_zero]
  -- countably many straightening charts cover `{DF ≠ 0}`; cut `Y'` into disjoint Borel pieces
  obtain ⟨B, Ψ, hBo, hΨc, hΨinj, hΨbij, hFΨ, hΨo, hcover⟩ :=
    Submission.dor_lmbsf_pc_straightening_cover n F hF
  obtain ⟨Zs, hZs⟩ : ∃ Zs : ℕ → Set (Euclid (n + 1)),
      ∀ q, Zs q = Y' ∩ disjointed (fun q => Ψ q '' B q) q := ⟨_, fun _ => rfl⟩
  have hZsm : ∀ q, MeasurableSet (Zs q) := fun q => by
    rw [hZs]
    exact hY'm.inter (MeasurableSet.disjointed (fun p => (hΨo p).measurableSet) q)
  have hZsd : Pairwise (fun p q => Disjoint (Zs p) (Zs q)) := by
    intro p q hpq
    rw [hZs, hZs]
    exact Disjoint.mono inter_subset_right inter_subset_right (disjoint_disjointed _ hpq)
  have hZsU : (⋃ q, Zs q) = Y' := by
    simp only [hZs]
    rw [← inter_iUnion, iUnion_disjointed, inter_eq_left]
    intro y hy
    exact hcover ((hmemY' y (hY'Y hy)).mp hy)
  have hZsY' : ∀ q, Zs q ⊆ Y' := fun q => by
    rw [hZs]
    exact inter_subset_left
  have hZsΨ : ∀ q, Zs q ⊆ Ψ q '' B q := fun q => by
    rw [hZs]
    exact inter_subset_right.trans (disjointed_subset _ q)
  -- the co-area identity on each chart piece
  have hpatch : ∀ q, AEMeasurable (fun t : ℝ => ∫⁻ x in ψ '' (Zs q ∩ F ⁻¹' {t}), φ x ∂μHE[n]) ∧
      ∫⁻ t : ℝ, (∫⁻ x in ψ '' (Zs q ∩ F ⁻¹' {t}), φ x ∂μHE[n]) =
        ∫⁻ x in ψ '' Zs q, ‖G x‖ₑ * φ x ∂μHE[n + 1] := fun q =>
    Submission.dor_lmbsf_pc_chart_patch_coarea P n V (B q) (Zs q) ψ F (Ψ q) G hV hψ hψinj hDψ hF
      (hBo q) (hΨc q) (hΨinj q) (hΨbij q) (hFΨ q) (hZsm q) ((hZsY' q).trans hY'V) (hZsΨ q)
      (fun y hy => hG y (hY'Y (hZsY' q hy))) φ hφ
  -- glue the pieces
  have hglue := Submission.dor_lmbsf_pc_coarea_glue P n Y' Zs ψ F φ (fun x => ‖G x‖ₑ * φ x)
    (hψ.continuousOn.mono hY'V) (hψinj.mono hY'V) hF.continuous.measurable hZsm hZsd hZsU hpatch
  simp only [hslice, hrhs]
  exact hglue

/-- **Slice tangent-plane algebra** (Simon Ch. 6, Lemma 4.1 (2): `∇ᴹf(x) ∈ TₓM` and `TₓMₜ` is
the orthogonal complement of `∇ᴹf(x)` in `TₓM`).  Let `L : ℝᵐ → ℝᴾ` and `ℓ : ℝᵐ → ℝ` be linear,
`g ∈ L(ℝᵐ)` and `⟨g, L e⟩ = ℓ(e)` for every `e`.  Then `g = 0 ⇔ ℓ = 0` (if `ℓ = 0` and
`g = L w`, then `|g|² = ⟨g, L w⟩ = ℓ(w) = 0`), and `L(ℝᵐ) ∩ g^⊥ = L(ker ℓ)`, because `v = L e`
is orthogonal to `g` iff `ℓ(e) = ⟨g, L e⟩ = 0`. -/
theorem Submission.dor_lmbsf_pst_slice_plane_algebra : ∀ (m P : ℕ) (L : Euclid m →L[ℝ] Euclid P) (ℓ : Euclid m →L[ℝ] ℝ) (g : Euclid P), g ∈ LinearMap.range (L : Euclid m →ₗ[ℝ] Euclid P) → (∀ e : Euclid m, inner ℝ g (L e) = ℓ e) → (g = 0 ↔ ℓ = 0) ∧ LinearMap.range (L : Euclid m →ₗ[ℝ] Euclid P) ⊓ (ℝ ∙ g)ᗮ = Submodule.map (L : Euclid m →ₗ[ℝ] Euclid P) (LinearMap.ker (ℓ : Euclid m →ₗ[ℝ] ℝ)) := by
  intro m P L ℓ g hg hgℓ
  refine ⟨⟨fun h => ?_, fun h => ?_⟩, ?_⟩
  · -- Step 1, `g = 0` gives `ℓ(e) = ⟨0, L e⟩ = 0` for every `e`
    ext e
    rw [← hgℓ e, h, inner_zero_left, zero_apply]
  · -- Step 2, `g = L w` and `ℓ = 0` give `⟨g, g⟩ = ⟨g, L w⟩ = ℓ(w) = 0`
    obtain ⟨w, hw⟩ := LinearMap.mem_range.1 hg
    have hgg := hgℓ w
    rw [ContinuousLinearMap.coe_coe] at hw
    rw [hw, h, zero_apply] at hgg
    exact inner_self_eq_zero.1 hgg
  · -- Steps 3–5, `v = L e` lies in `gᗮ` iff `ℓ(e) = ⟨g, L e⟩ = 0`
    ext v
    simp only [Submodule.mem_inf, LinearMap.mem_range, Submodule.mem_map, LinearMap.mem_ker,
      Submodule.mem_orthogonal_singleton_iff_inner_right, ContinuousLinearMap.coe_coe]
    constructor
    · rintro ⟨⟨e, rfl⟩, he⟩
      exact ⟨e, (hgℓ e).symm.trans he, rfl⟩
    · rintro ⟨e, he, rfl⟩
      exact ⟨⟨e, rfl⟩, (hgℓ e).trans he⟩
/-- **Local `C¹` chart of a regular level set** (the implicit function theorem step of Simon
Ch. 2, §6, after 6.3, chapter-02.txt lines 1476–1482: off `{DF = 0}` a level set of a `C¹` map is
a `C¹` submanifold).  `ℓ = DF(y₀) ≠ 0` has `dim ker ℓ = n`; extending an isomorphism
`ker ℓ ≅ ℝⁿ` gives a linear `π` with `π × ℓ` invertible.  Invert `Θ = (π, F)` near `y₀` (inverse
function theorem) inside `W` and the open set where `DΘ` is invertible.  Then
`Λ(z) = Θ⁻¹(z, F(y₀))` on `D = {z | (z, F(y₀)) ∈ target}` has `π ∘ Λ = id`, `F ∘ Λ = F(y₀)` and
`DΛ(z) = DΘ(Λ z)⁻¹ ∘ inl`, injective with range `ker DF(Λ z)`.  For `c = π(y₀)`, `B̄_ρ(c) ⊆ D`
and `N = source ∩ π⁻¹(B_ρ(c))`, a point `y ∈ N` with `F(y) = F(y₀)` is `Λ(π y)`. -/
theorem Submission.dor_lmbsf_pst_level_set_local_chart : ∀ (n : ℕ) (W : Set (Euclid (n + 1))) (F : Euclid (n + 1) → ℝ) (y₀ : Euclid (n + 1)), IsOpen W → ContDiff ℝ 1 F → y₀ ∈ W → fderiv ℝ F y₀ ≠ 0 → ∃ (D : Set (Euclid n)) (Λ : Euclid n → Euclid (n + 1)) (c : Euclid n) (ρ : ℝ) (N : Set (Euclid (n + 1))), IsOpen D ∧ ContDiffOn ℝ 1 Λ D ∧ InjOn Λ D ∧ (∀ z ∈ D, Λ z ∈ W ∧ F (Λ z) = F y₀ ∧ Injective (fderiv ℝ Λ z) ∧ LinearMap.range (fderiv ℝ Λ z : Euclid n →ₗ[ℝ] Euclid (n + 1)) = LinearMap.ker (fderiv ℝ F (Λ z) : Euclid (n + 1) →ₗ[ℝ] ℝ)) ∧ closedBall c ρ ⊆ D ∧ IsOpen N ∧ y₀ ∈ N ∧ N ∩ F ⁻¹' {F y₀} ⊆ Λ '' ball c ρ := by
  intro n W F y₀ hW hF hy₀ hDF
  set ℓ : Euclid (n + 1) →L[ℝ] ℝ := fderiv ℝ F y₀
  set t : ℝ := F y₀
  set K := LinearMap.ker (ℓ : Euclid (n + 1) →ₗ[ℝ] ℝ)
  -- Step 1, `ℓ ≠ 0` is onto `ℝ`, so `dim K = n` by rank–nullity
  have hdimK : Module.finrank ℝ K = Module.finrank ℝ (Euclid n) := by
    obtain ⟨v₀, hv₀⟩ : ∃ v₀, ℓ v₀ ≠ 0 := by
      by_contra! h
      exact hDF (ContinuousLinearMap.ext h)
    have hrange : LinearMap.range (ℓ : Euclid (n + 1) →ₗ[ℝ] ℝ) = ⊤ :=
      eq_top_iff.2 fun r _ => LinearMap.mem_range.2 ⟨(r / ℓ v₀) • v₀, by simp [hv₀]⟩
    have h : _ + Module.finrank ℝ K = _ :=
      LinearMap.finrank_range_add_finrank_ker (ℓ : Euclid (n + 1) →ₗ[ℝ] ℝ)
    rw [hrange, finrank_top, Module.finrank_self, finrank_euclideanSpace_fin] at h
    rw [finrank_euclideanSpace_fin]
    omega
  -- Step 2, `π` extends an isomorphism `e : K ≃ ℝⁿ`, so `ℓ v = 0 = π v` forces `v = 0`
  obtain ⟨π, hπ⟩ : ∃ π : Euclid (n + 1) →L[ℝ] Euclid n, ∀ v, ℓ v = 0 → π v = 0 → v = 0 := by
    let e : K ≃ₗ[ℝ] Euclid n := LinearEquiv.ofFinrankEq _ _ hdimK
    obtain ⟨g, hg⟩ := LinearMap.exists_extend (e : K →ₗ[ℝ] Euclid n)
    refine ⟨LinearMap.toContinuousLinearMap g, fun v hv hπv => ?_⟩
    have hvK : v ∈ K := hv
    have h : e ⟨v, hvK⟩ = 0 := by
      have hgv := congrArg (fun f => f ⟨v, hvK⟩) hg
      simp only [LinearMap.comp_apply, Submodule.subtype_apply, LinearEquiv.coe_coe] at hgv
      rw [← hgv]
      exact hπv
    exact congrArg Subtype.val (e.injective (h.trans (map_zero e).symm))
  -- Step 3, `Θ = (π, F)` is `C¹` with `DΘ(y) = π × DF(y)`
  set Θ : Euclid (n + 1) → Euclid n × ℝ := fun y => (π y, F y)
  have hΘ : ContDiff ℝ 1 Θ := π.contDiff.prodMk hF
  have hΘd : ∀ y, HasFDerivAt Θ (π.prod (fderiv ℝ F y)) y := fun y =>
    π.hasFDerivAt.prodMk (hF.differentiable one_ne_zero y).hasFDerivAt
  -- Step 4, `π × ℓ` is injective by Step 2, hence (equal dimensions) an isomorphism `E₀`
  have hker₀ : LinearMap.ker (π.prod ℓ : Euclid (n + 1) →ₗ[ℝ] Euclid n × ℝ) = ⊥ := by
    refine LinearMap.ker_eq_bot'.2 fun v hv => ?_
    have h : (π v, ℓ v) = ((0 : Euclid n), (0 : ℝ)) := hv
    exact hπ v (congrArg Prod.snd h) (congrArg Prod.fst h)
  have hrange₀ : LinearMap.range (π.prod ℓ : Euclid (n + 1) →ₗ[ℝ] Euclid n × ℝ) = ⊤ := by
    have hdim : Module.finrank ℝ (Euclid (n + 1)) = Module.finrank ℝ (Euclid n × ℝ) := by
      rw [Module.finrank_prod, Module.finrank_self, finrank_euclideanSpace_fin,
        finrank_euclideanSpace_fin]
    exact LinearMap.range_eq_top.2
      ((LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdim).1
        (LinearMap.ker_eq_bot.1 hker₀))
  obtain ⟨E₀, hE₀⟩ : ∃ E₀ : Euclid (n + 1) ≃L[ℝ] Euclid n × ℝ,
      (E₀ : Euclid (n + 1) →L[ℝ] Euclid n × ℝ) = π.prod ℓ :=
    ⟨ContinuousLinearEquiv.ofBijective _ hker₀ hrange₀,
      ContinuousLinearEquiv.coe_ofBijective _ _ _⟩
  have hΘE₀ : HasFDerivAt Θ (E₀ : Euclid (n + 1) →L[ℝ] Euclid n × ℝ) y₀ := by
    rw [hE₀]
    exact hΘd y₀
  -- the set `O` where `DΘ` is invertible is open (`DΘ` is continuous) and contains `y₀`
  set O : Set (Euclid (n + 1)) :=
    fderiv ℝ Θ ⁻¹' range ContinuousLinearEquiv.toContinuousLinearMap
  have hO : IsOpen O :=
    ContinuousLinearEquiv.isOpen.preimage (hΘ.continuous_fderiv one_ne_zero)
  have hy₀O : y₀ ∈ O := ⟨E₀, hΘE₀.fderiv.symm⟩
  -- Step 5, the inverse function theorem for `Θ` at `y₀`, restricted to `O ∩ W`
  have hΘs : HasStrictFDerivAt Θ (E₀ : Euclid (n + 1) →L[ℝ] Euclid n × ℝ) y₀ :=
    hΘ.contDiffAt.hasStrictFDerivAt' hΘE₀ one_ne_zero
  obtain ⟨Φ, hΦ, hΦsrc, hy₀Φ⟩ : ∃ Φ : OpenPartialHomeomorph (Euclid (n + 1)) (Euclid n × ℝ),
      (Φ : Euclid (n + 1) → Euclid n × ℝ) = Θ ∧ Φ.source ⊆ O ∩ W ∧ y₀ ∈ Φ.source :=
    ⟨(hΘs.toOpenPartialHomeomorph Θ).restrOpen (O ∩ W) (hO.inter hW), rfl, inter_subset_right,
      ⟨hΘs.mem_toOpenPartialHomeomorph_source, hy₀O, hy₀⟩⟩
  -- Step 6, the chart `Λ(z) = Φ⁻¹(z, t)` on the open set `D = {z | (z, t) ∈ target Φ}`
  set D : Set (Euclid n) := (fun z => (z, t)) ⁻¹' Φ.target
  set Λ : Euclid n → Euclid (n + 1) := fun z => Φ.symm (z, t)
  have hD : IsOpen D := Φ.open_target.preimage (continuous_id.prodMk continuous_const)
  -- Step 7, for `z ∈ D`, `Λ(z) ∈ source Φ ⊆ O ∩ W` and `Θ(Λ z) = (z, t)`
  have hΛsrc : ∀ z ∈ D, Λ z ∈ Φ.source := fun z hz => Φ.map_target hz
  have hΘΛ : ∀ z ∈ D, Θ (Λ z) = (z, t) := fun z hz => by
    rw [← hΦ]
    exact Φ.right_inv hz
  have hπΛ : ∀ z ∈ D, π (Λ z) = z := fun z hz => congrArg Prod.fst (hΘΛ z hz)
  have hFΛ : ∀ z ∈ D, F (Λ z) = t := fun z hz => congrArg Prod.snd (hΘΛ z hz)
  -- Step 9, `Λ` is `C¹` at `z ∈ D` with `DΛ(z) = E⁻¹ ∘ inl`, `E = DΘ(Λ z) = π × DF(Λ z)`
  have hΛd : ∀ z ∈ D, ∃ E : Euclid (n + 1) ≃L[ℝ] Euclid n × ℝ,
      (E : Euclid (n + 1) →L[ℝ] Euclid n × ℝ) = π.prod (fderiv ℝ F (Λ z)) ∧
      HasFDerivAt Λ ((E.symm : Euclid n × ℝ →L[ℝ] Euclid (n + 1)).comp
        (ContinuousLinearMap.inl ℝ (Euclid n) ℝ)) z ∧ ContDiffAt ℝ 1 Λ z := by
    intro z hz
    obtain ⟨E, hE⟩ := (hΦsrc (hΛsrc z hz)).1
    have hEΘ : (E : Euclid (n + 1) →L[ℝ] Euclid n × ℝ) = π.prod (fderiv ℝ F (Λ z)) := by
      rw [← (hΘd (Λ z)).fderiv]
      exact hE
    have hΦE : HasFDerivAt Φ (E : Euclid (n + 1) →L[ℝ] Euclid n × ℝ) (Φ.symm (z, t)) := by
      rw [hΦ, hEΘ]
      exact hΘd _
    have hΦC : ContDiffAt ℝ 1 Φ (Φ.symm (z, t)) := by
      rw [hΦ]
      exact hΘ.contDiffAt
    exact ⟨E, hEΘ, (Φ.hasFDerivAt_symm hz hΦE).comp z (hasFDerivAt_prodMk_left z t),
      (Φ.contDiffAt_symm hz hΦE hΦC).comp z (contDiffAt_id.prodMk contDiffAt_const)⟩
  -- Step 12, `c = π(y₀) ∈ D` since `(c, t) = Θ(y₀)`; `B̄_ρ(c) ⊆ B_ε(c) ⊆ D` for `ρ = ε/2`
  have hcD : π y₀ ∈ D := by
    show (π y₀, t) ∈ Φ.target
    have h := Φ.map_source hy₀Φ
    rw [hΦ] at h
    exact h
  obtain ⟨ε, hε, hεD⟩ := Metric.isOpen_iff.1 hD (π y₀) hcD
  -- Step 13, `N = source Φ ∩ π⁻¹(B_ρ(c))`
  refine ⟨D, Λ, π y₀, ε / 2, Φ.source ∩ π ⁻¹' ball (π y₀) (ε / 2), hD, fun z hz => ?_,
    ?_, ?_, ?_, ?_, ?_, ?_⟩
  · obtain ⟨E, -, -, hΛC⟩ := hΛd z hz
    exact hΛC.contDiffWithinAt
  · -- Step 8, `π ∘ Λ = id` on `D`
    intro z hz z' hz' h
    rw [← hπΛ z hz, ← hπΛ z' hz', h]
  · intro z hz
    obtain ⟨E, hEΘ, hΛE, -⟩ := hΛd z hz
    have hEv : ∀ v, E v = (π v, fderiv ℝ F (Λ z) v) := fun v => by
      rw [← ContinuousLinearEquiv.coe_coe, hEΘ]
      rfl
    refine ⟨(hΦsrc (hΛsrc z hz)).2, hFΛ z hz, ?_, ?_⟩
    · -- Step 10, `E⁻¹ ∘ inl` is injective
      rw [hΛE.fderiv]
      intro w w' h
      have h' : ((w, 0) : Euclid n × ℝ) = (w', 0) := E.symm.injective h
      exact congrArg Prod.fst h'
    · -- Step 11, `E v = (π v, DF(Λ z) v)`: `E⁻¹(w, 0) ∈ ker DF(Λ z)`, and `v = E⁻¹(π v, 0)`
      -- if `DF(Λ z) v = 0`
      rw [hΛE.fderiv]
      ext v
      rw [LinearMap.mem_range, LinearMap.mem_ker]
      constructor
      · rintro ⟨w, rfl⟩
        have h := hEv (E.symm (w, 0))
        rw [ContinuousLinearEquiv.apply_symm_apply] at h
        exact (congrArg Prod.snd h).symm
      · intro hv
        refine ⟨π v, E.injective ?_⟩
        change E (E.symm (π v, 0)) = E v
        rw [ContinuousLinearMap.coe_coe] at hv
        rw [ContinuousLinearEquiv.apply_symm_apply, hEv, hv]
  · exact (closedBall_subset_ball (half_lt_self hε)).trans hεD
  · exact Φ.open_source.inter (isOpen_ball.preimage π.continuous)
  · exact ⟨hy₀Φ, mem_ball_self (half_pos hε)⟩
  · -- `y ∈ N` with `F y = t` has `Φ(y) = (π y, t)`, so `Λ(π y) = Φ⁻¹(Φ y) = y`
    rintro y ⟨⟨hyΦ, hyB⟩, hyF⟩
    refine ⟨π y, hyB, ?_⟩
    have hyF' : F y = t := hyF
    have h := Φ.left_inv hyΦ
    rw [hΦ] at h
    show Φ.symm (π y, t) = y
    rw [← hyF']
    exact h

/-- **Countable chart cover of a regular level set** (Simon Ch. 2, before 6.4: "the implicit
function theorem implies that either `f⁻¹(y) ∖ C` is empty or else it is a `k`-dimensional `C¹`
submanifold", chapter-02.txt lines 1479–1496; used for the slice tangent planes of Ch. 6,
Lemma 4.1(2)).  Let `W ⊆ ℝ^{n+1}` be open, `F` be `C¹` and `t ∈ ℝ`.  There are countably many
`C¹` maps `Λ_k`, injective on open sets `D_k ⊇ B̄_{ρ_k}(c_k)` and with values in `W ∩ {F = t}`,
such that `DΛ_k(z)` is injective with range `ker DF(Λ_k z)` and every `y ∈ W` with `DF(y) ≠ 0`,
`F(y) = t` is `Λ_k(z)` for some `k` and `z ∈ B_{ρ_k}(c_k)`.  Take the local chart
(`dor_lmbsf_pst_level_set_local_chart`) at each such `y`, with neighbourhood `N_y`, and a
countable subfamily of the open sets `N_y` with the same union (second countability); if there
is no such `y`, take empty charts with `ρ_k = -1`. -/
theorem Submission.dor_lmbsf_pst_level_set_chart_cover : ∀ (n : ℕ) (W : Set (Euclid (n + 1))) (F : Euclid (n + 1) → ℝ) (t : ℝ), IsOpen W → ContDiff ℝ 1 F → ∃ (D : ℕ → Set (Euclid n)) (Λ : ℕ → Euclid n → Euclid (n + 1)) (c : ℕ → Euclid n) (ρ : ℕ → ℝ), (∀ k, IsOpen (D k)) ∧ (∀ k, ContDiffOn ℝ 1 (Λ k) (D k)) ∧ (∀ k, InjOn (Λ k) (D k)) ∧ (∀ k, ∀ z ∈ D k, Λ k z ∈ W ∧ F (Λ k z) = t ∧ Injective (fderiv ℝ (Λ k) z) ∧ LinearMap.range (fderiv ℝ (Λ k) z : Euclid n →ₗ[ℝ] Euclid (n + 1)) = LinearMap.ker (fderiv ℝ F (Λ k z) : Euclid (n + 1) →ₗ[ℝ] ℝ)) ∧ (∀ k, closedBall (c k) (ρ k) ⊆ D k) ∧ ∀ y ∈ W, fderiv ℝ F y ≠ 0 → F y = t → ∃ k, ∃ z ∈ ball (c k) (ρ k), Λ k z = y := by
  intro n W F t hW hF
  by_cases hne : ∃ y, y ∈ W ∧ fderiv ℝ F y ≠ 0 ∧ F y = t
  swap
  · -- Step 1, no regular point of `{F = t}` in `W`: empty charts, `B̄_{-1}(0) = ∅`
    refine ⟨fun _ => ∅, fun _ => 0, fun _ => 0, fun _ => -1, fun _ => isOpen_empty,
      fun _ => contDiffOn_empty, fun _ => injOn_empty _,
      fun _ z hz => (Set.notMem_empty z hz).elim,
      fun _ => (closedBall_eq_empty.2 (by norm_num)).subset, fun y hyW hdF hFy => ?_⟩
    exact (hne ⟨y, hyW, hdF, hFy⟩).elim
  obtain ⟨y₀, hy₀⟩ := hne
  -- Step 2, a local chart `(D y, Λ y, c y, ρ y)` with neighbourhood `N y` at each regular point `y`
  choose D Λ c ρ N hD hΛ hinj hprop hcb hNo hyN hcov using
    fun y : {y // y ∈ W ∧ fderiv ℝ F y ≠ 0 ∧ F y = t} =>
      Submission.dor_lmbsf_pst_level_set_local_chart n W F y hW hF y.2.1 y.2.2.1
  -- Step 3, the `N y` with `y` in a countable `T` have the same union; `T ≠ ∅` as `y₀` is regular
  obtain ⟨T, hTc, hTU⟩ := TopologicalSpace.isOpen_iUnion_countable N hNo
  have hT : ∀ y : {y // y ∈ W ∧ fderiv ℝ F y ≠ 0 ∧ F y = t},
      ∃ i ∈ T, (y : Euclid (n + 1)) ∈ N i := by
    intro y
    have hy : (y : Euclid (n + 1)) ∈ ⋃ i ∈ T, N i := by
      rw [hTU]
      exact mem_iUnion.2 ⟨y, hyN y⟩
    obtain ⟨i, hi, hyi⟩ := mem_iUnion₂.1 hy
    exact ⟨i, hi, hyi⟩
  obtain ⟨i₀, hi₀, -⟩ := hT ⟨y₀, hy₀⟩
  obtain ⟨e, rfl⟩ := hTc.exists_eq_range ⟨i₀, hi₀⟩
  -- Step 4, the charts at the points `e k`, where `F (e k) = t`
  refine ⟨fun k => D (e k), fun k => Λ (e k), fun k => c (e k), fun k => ρ (e k),
    fun k => hD (e k), fun k => hΛ (e k), fun k => hinj (e k), fun k z hz => ?_,
    fun k => hcb (e k), fun y hyW hdF hFy => ?_⟩
  · obtain ⟨h₁, h₂, h₃, h₄⟩ := hprop (e k) z hz
    exact ⟨h₁, h₂.trans (e k).2.2.2, h₃, h₄⟩
  · -- Step 5, `y ∈ N (e k) ∩ F⁻¹(F (e k)) ⊆ Λ (e k) '' B_{ρ (e k)}(c (e k))` for some `k`
    obtain ⟨_, ⟨k, rfl⟩, hyk⟩ := hT ⟨y, hyW, hdF, hFy⟩
    obtain ⟨z, hz, hzy⟩ := hcov (e k) ⟨hyk, hFy.trans (e k).2.2.2.symm⟩
    exact ⟨k, z, hz, hzy⟩
/-- **Approximate tangent spaces of compact `C¹` patches pass to `S`** (Simon Ch. 3, 1.4; the
locality step (TL) applied patch by patch).  Assume (TL).  Let `S` be Borel with `Hⁿ(S) < ∞`, and
for each `k` let `χ_k` be `C¹` on the open `D_k ⊇ K_k = B̄_{ρ_k}(c_k)` and injective on `K_k`.  The
patch `Σ_k = χ_k(K_k)` is compact with `Hⁿ(Σ_k) < ∞` (Lipschitz image of a compact ball), and
`A_k = S ∩ χ_k(B_{ρ_k}(c_k))` is Borel (Lusin–Souslin) with `A_k ⊆ Σ_k` and `A_k ⊆ S`.  Two
applications of (TL) with `U = ℝᴾ` give, `Hⁿ`-a.e. on `A_k`, `Σ_k`-tangent `Q` ⇒ `A_k`-tangent `Q`
⇒ `S`-tangent `Q`; intersecting over the countably many `k` gives the claim `Hⁿ`-a.e. on `S`. -/
theorem Submission.dor_lmbsf_pst_patch_tangent_transfer : (∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q) → ∀ (P n : ℕ) (S : Set (Euclid P)) (D : ℕ → Set (Euclid n)) (χ : ℕ → Euclid n → Euclid P) (c : ℕ → Euclid n) (ρ : ℕ → ℝ), MeasurableSet S → μHE[n] S ≠ ∞ → (∀ k, IsOpen (D k)) → (∀ k, ContDiffOn ℝ 1 (χ k) (D k)) → (∀ k, closedBall (c k) (ρ k) ⊆ D k) → (∀ k, InjOn (χ k) (closedBall (c k) (ρ k))) → ∀ᵐ x ∂(μHE[n].restrict S), ∀ k, ∀ z ∈ ball (c k) (ρ k), χ k z = x → ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n (χ k '' closedBall (c k) (ρ k)) x Q → HasApproximateTangentSpaceAt n S x Q := by
  intro TL P n S D χ c ρ hS hSfin hD hχ hKD hinj
  -- Steps 1–7, for each patch `k`: `Hⁿ⌞S`-a.e., if `x ∈ A_k = S ∩ χ_k(B_k)`, every approximate
  -- tangent space of `Σ_k = χ_k(K_k)` at `x` is one of `S`
  have hpatch : ∀ k, ∀ᵐ x ∂(μHE[n].restrict S), x ∈ S ∩ χ k '' ball (c k) (ρ k) →
      ∀ Q : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt n (χ k '' closedBall (c k) (ρ k)) x Q →
          HasApproximateTangentSpaceAt n S x Q := by
    intro k
    -- Step 1, `Σ_k` is compact, hence Borel
    have hχK : ContinuousOn (χ k) (closedBall (c k) (ρ k)) :=
      ((hχ k).mono (hKD k)).continuousOn
    have hsig : MeasurableSet (χ k '' closedBall (c k) (ρ k)) :=
      ((isCompact_closedBall _ _).image_of_continuousOn hχK).isClosed.measurableSet
    -- Step 2, `χ_k` is `L`-Lipschitz on the convex compact `K_k`, so `Hⁿ(Σ_k) ≤ Lⁿ Hⁿ(K_k) < ∞`
    obtain ⟨L, hL⟩ := ((hχ k).mono (hKD k)).exists_lipschitzOnWith one_ne_zero
      (convex_closedBall _ _) (isCompact_closedBall _ _)
    have hsigfin : μHE[n] (χ k '' closedBall (c k) (ρ k)) ≠ ∞ := by
      refine ne_top_of_le_ne_top (ENNReal.mul_ne_top (ENNReal.pow_ne_top ENNReal.coe_ne_top) ?_)
        (Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n hL)
      rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
      exact (isCompact_closedBall _ _).measure_lt_top.ne
    -- Step 3, `A_k` is Borel (Lusin–Souslin for the injective continuous `χ_k` on `B_k`)
    have hA : MeasurableSet (S ∩ χ k '' ball (c k) (ρ k)) :=
      hS.inter (measurableSet_ball.image_of_continuousOn_injOn
        (hχK.mono ball_subset_closedBall) ((hinj k).mono ball_subset_closedBall))
    -- Steps 4–6, `A_k ⊆ Σ_k` and `A_k ⊆ S`, and (TL) applies to both pairs with `U = ℝᴾ`
    have h1 := TL P n univ _ _ isOpen_univ hA hsig
      (inter_subset_right.trans (image_mono ball_subset_closedBall)) (subset_univ _)
      fun K _ _ => ne_top_of_le_ne_top hsigfin (measure_mono inter_subset_left)
    have h2 := TL P n univ _ _ isOpen_univ hA hS inter_subset_left (subset_univ _)
      fun K _ _ => ne_top_of_le_ne_top hSfin (measure_mono inter_subset_left)
    -- Step 7, `Hⁿ⌞A_k`-a.e., `Σ_k`-tangent `Q` ⇒ `A_k`-tangent `Q` ⇒ `S`-tangent `Q`
    have h3 : ∀ᵐ x ∂(μHE[n].restrict (S ∩ χ k '' ball (c k) (ρ k))),
        ∀ Q : Submodule ℝ (Euclid P),
          HasApproximateTangentSpaceAt n (χ k '' closedBall (c k) (ρ k)) x Q →
            HasApproximateTangentSpaceAt n S x Q := by
      filter_upwards [h1, h2] with x hx1 hx2 Q hQ
      exact (hx2 Q).2 ((hx1 Q).1 hQ)
    exact ae_restrict_of_ae ((ae_restrict_iff' hA).1 h3)
  -- Steps 8–9, intersect over the countably many `k`; `x = χ_k(z)` with `z ∈ B_k` lies in `A_k`
  filter_upwards [ae_all_iff.2 hpatch, ae_restrict_mem hS] with x hx hxS k z hz hzx Q hQ
  exact hx k ⟨hxS, z, hz, hzx⟩ Q hQ
/-- **Slices of one `C¹` chart piece** (Simon Ch. 6, Lemma 4.1(1),(2) for one piece; Ch. 2, 6.4
and Remark 4.4; Ch. 3, Lemma 1.2 "if").  For `y ∈ Y`, `G(ψ(y)) ≠ 0 ⇔ DF(y) ≠ 0`, so
`S_t = ψ(Y ∩ Γ_t)` with `Γ_t = {DF ≠ 0} ∩ F⁻¹(t)`, a Borel set by Lusin–Souslin.  Countably many
`C¹` graph charts `Λ_k` cover `Γ_t ∩ V`, and `χ_k := ψ ∘ Λ_k` is `C¹` with `Dχ_k(z)` injective of
range `Dψ(y)(ker DF(y)) = Dψ(y)(ℝ^{n+1}) ∩ G(ψ(y))^⊥`, `y = Λ_k(z)`.  (i) `S_t ⊆ ⋃_k χ_k(D_k)`.
(ii) The compact patch `χ_k(B̄_{ρ_k}(c_k))` has approximate tangent space `Dχ_k(z)(ℝⁿ)` at
`χ_k(z)`, `z ∈ B_{ρ_k}(c_k)`, and (TL) transfers it to `S_t`, `Hⁿ`-a.e. on `S_t`. -/
theorem Submission.dor_lmbsf_piece_slice_approxTangent : (∀ (P n : ℕ) (U A B : Set (Euclid P)), IsOpen U → MeasurableSet A → MeasurableSet B → A ⊆ B → B ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict A), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n B x Q ↔ HasApproximateTangentSpaceAt n A x Q) → ∀ (P n : ℕ) (V C Y : Set (Euclid (n + 1))) (ψ : Euclid (n + 1) → Euclid P) (F : Euclid (n + 1) → ℝ) (f : Euclid P → ℝ) (G : Euclid P → Euclid P), IsOpen V → ContDiffOn ℝ 1 ψ V → InjOn ψ V → (∀ y ∈ V, Injective (fderiv ℝ ψ y)) → IsCompact C → C ⊆ V → MeasurableSet Y → Y ⊆ C → ContDiff ℝ 1 F → (∀ y ∈ Y, f (ψ y) = F y) → (∀ y ∈ Y, G (ψ y) ∈ LinearMap.range (fderiv ℝ ψ y : Euclid (n + 1) →ₗ[ℝ] Euclid P) ∧ ∀ e : Euclid (n + 1), inner ℝ (G (ψ y)) (fderiv ℝ ψ y e) = fderiv ℝ F y e) → ∀ t : ℝ, CountablyRectifiable n (ψ '' Y ∩ {x | G x ≠ 0} ∩ f ⁻¹' {t}) ∧ (μHE[n] (ψ '' Y ∩ {x | G x ≠ 0} ∩ f ⁻¹' {t}) ≠ ∞ → ∀ᵐ x ∂(μHE[n].restrict (ψ '' Y ∩ {x | G x ≠ 0} ∩ f ⁻¹' {t})), ∀ y ∈ Y, ψ y = x → HasApproximateTangentSpaceAt n (ψ '' Y ∩ {x | G x ≠ 0} ∩ f ⁻¹' {t}) x (LinearMap.range (fderiv ℝ ψ y : Euclid (n + 1) →ₗ[ℝ] Euclid P) ⊓ (ℝ ∙ G x)ᗮ)) := by
  intro hTL P n V C Y ψ F f G hV hψ hψinj hDψ hC hCV hY hYC hF hfF hG t
  have hYV : Y ⊆ V := hYC.trans hCV
  -- Step 1, for `y ∈ Y`: `G(ψ(y)) = 0 ⇔ DF(y) = 0`, and
  -- `Dψ(y)(ℝ^{n+1}) ∩ G(ψ(y))^⊥ = Dψ(y)(ker DF(y))`
  have halg := fun y (hy : y ∈ Y) => Submission.dor_lmbsf_pst_slice_plane_algebra (n + 1) P
    (fderiv ℝ ψ y) (fderiv ℝ F y) (G (ψ y)) (hG y hy).1 (hG y hy).2
  set S := ψ '' Y ∩ {x | G x ≠ 0} ∩ f ⁻¹' {t}
  have hlevel : ∀ y ∈ Y, ψ y ∈ S → fderiv ℝ F y ≠ 0 ∧ F y = t := by
    rintro y hy ⟨⟨-, hGy⟩, hfy⟩
    exact ⟨fun h => hGy ((halg y hy).1.2 h), (hfF y hy).symm.trans hfy⟩
  -- so `S_t = ψ(Y ∩ Γ_t)`
  have hSeq : S = ψ '' (Y ∩ {y | fderiv ℝ F y ≠ 0} ∩ F ⁻¹' {t}) := by
    refine Subset.antisymm (fun x hx => ?_) ?_
    · obtain ⟨y, hy, rfl⟩ := hx.1.1
      exact ⟨y, ⟨⟨hy, (hlevel y hy hx).1⟩, (hlevel y hy hx).2⟩, rfl⟩
    · rintro x ⟨y, ⟨⟨hy, hDF⟩, hFy⟩, rfl⟩
      exact ⟨⟨mem_image_of_mem ψ hy, fun h => hDF ((halg y hy).1.1 h)⟩, (hfF y hy).trans hFy⟩
  -- Step 2, countably many `C¹` graph charts `Λ_k : D_k → Γ_t ∩ V` with
  -- `Γ_t ∩ V = ⋃_k Λ_k(B_{ρ_k}(c_k))`; `χ_k := ψ ∘ Λ_k` is `C¹` on `D_k` and injective on
  -- `B̄_{ρ_k}(c_k)`
  obtain ⟨D, Λ, c, ρ, hDo, hΛ, hΛinj, hΛD, hball, hcover⟩ :=
    Submission.dor_lmbsf_pst_level_set_chart_cover n V F t hV hF
  have hΛV : ∀ k, MapsTo (Λ k) (D k) V := fun k z hz => (hΛD k z hz).1
  have hχ : ∀ k, ContDiffOn ℝ 1 (ψ ∘ Λ k) (D k) := fun k => hψ.comp (hΛ k) (hΛV k)
  have hχinj : ∀ k, InjOn (ψ ∘ Λ k) (closedBall (c k) (ρ k)) := fun k =>
    (hψinj.comp (hΛinj k) (hΛV k)).mono (hball k)
  have hchart : ∀ y ∈ Y, ψ y ∈ S → ∃ k, ∃ z ∈ ball (c k) (ρ k), Λ k z = y := fun y hy hyS =>
    hcover y (hYV hy) (hlevel y hy hyS).1 (hlevel y hy hyS).2
  refine ⟨?_, fun hfin => ?_⟩
  · -- Step 3, (i): `S_t ⊆ ⋃_k χ_k(D_k)`, a countable union of `C¹` images of open sets
    refine (Poincare.SimonGMT.Chapter03.countablyRectifiable_iUnion (fun k => (ψ ∘ Λ k) '' D k)
      fun k => Poincare.SimonGMT.Chapter03.countablyRectifiable_image_contDiffOn_open (hDo k)
        (hχ k)).mono fun x hx => ?_
    obtain ⟨y, hy, rfl⟩ := hx.1.1
    obtain ⟨k, z, hz, rfl⟩ := hchart y hy hx
    exact mem_iUnion.2 ⟨k, z, hball k (ball_subset_closedBall hz), rfl⟩
  -- Step 4, (ii): `S_t` is Borel, so (TL) transfers the tangent planes of the compact patches
  -- `χ_k(B̄_{ρ_k}(c_k))` to `S_t` at `Hⁿ`-a.e. `x ∈ S_t`
  have hSmeas : MeasurableSet S := by
    have hΓ : MeasurableSet (Y ∩ {y | fderiv ℝ F y ≠ 0} ∩ F ⁻¹' {t}) :=
      (hY.inter (isOpen_ne_fun (hF.continuous_fderiv one_ne_zero)
        continuous_const).measurableSet).inter
        (hF.continuous.measurable (measurableSet_singleton t))
    rw [hSeq]
    exact hΓ.image_of_continuousOn_injOn (hψ.continuousOn.mono fun y hy => hYV hy.1.1)
      (hψinj.mono fun y hy => hYV hy.1.1)
  filter_upwards [Submission.dor_lmbsf_pst_patch_tangent_transfer hTL P n S D (fun k => ψ ∘ Λ k)
    c ρ hSmeas hfin hDo hχ hball hχinj, ae_restrict_mem hSmeas] with x hx hxS
  rintro y hy rfl
  obtain ⟨k, z, hz, rfl⟩ := hchart y hy hxS
  -- Step 5, `Dχ_k(z) = Dψ(Λ_k z) ∘ DΛ_k(z)` is injective, with range
  -- `Dψ(Λ_k z)(ker DF(Λ_k z)) = Dψ(Λ_k z)(ℝ^{n+1}) ∩ G(χ_k z)^⊥`
  have hzD : z ∈ D k := hball k (ball_subset_closedBall hz)
  obtain ⟨-, -, hDΛ, hrangeΛ⟩ := hΛD k z hzD
  have hderiv : fderiv ℝ (ψ ∘ Λ k) z = (fderiv ℝ ψ (Λ k z)).comp (fderiv ℝ (Λ k) z) :=
    fderiv_comp z ((hψ.contDiffAt (hV.mem_nhds (hΛV k hzD))).differentiableAt one_ne_zero)
      (((hΛ k).contDiffAt ((hDo k).mem_nhds hzD)).differentiableAt one_ne_zero)
  have hrange : LinearMap.range (fderiv ℝ (ψ ∘ Λ k) z : Euclid n →ₗ[ℝ] Euclid P) =
      LinearMap.range (fderiv ℝ ψ (Λ k z) : Euclid (n + 1) →ₗ[ℝ] Euclid P) ⊓
        (ℝ ∙ G (ψ (Λ k z)))ᗮ := by
    rw [(halg _ hy).2, hderiv, ContinuousLinearMap.toLinearMap_comp, LinearMap.range_comp,
      hrangeΛ]
  -- `image_tangent`: the patch `χ_k(B̄_{ρ_k}(c_k))` has approximate tangent space
  -- `Dχ_k(z)(ℝⁿ)` at `χ_k(z)`, since `z ∈ B_{ρ_k}(c_k) ⊆ int B̄_{ρ_k}(c_k)`
  have himage := Submission.dor_lmbsf_c1_image_approxTangent n P (D k) (closedBall (c k) (ρ k))
    (ψ ∘ Λ k) z (hDo k) (hχ k) (isCompact_closedBall _ _) (hball k) (hχinj k)
    (ball_subset_interior_closedBall hz)
    (by rw [hderiv, ContinuousLinearMap.coe_comp]; exact (hDψ _ (hYV hy)).comp hDΛ)
  rw [hrange] at himage
  exact hx k z hz rfl _ himage
/-- **Weak convergence of derivatives against `C¹` test fields.**  If the `uₖ : ℝᵈ → ℝ` are
`K`-Lipschitz and converge uniformly to `u`, and `Ψ : ℝᵈ → ℝᵈ` is `C¹` with compact support, then
`∫ Duₖ[Ψ] → ∫ Du[Ψ]`.  The limit `u` is again `K`-Lipschitz.  Writing `Ψ = Σₗ Ψₗ eₗ`,
Rademacher's theorem and integration by parts give `∫ Dv[Ψ] = Σₗ ∫ qₗ v` for every Lipschitz `v`,
where `qₗ = DΨₗ[-eₗ]` is continuous with compact support; dominated convergence with the bound
`|qₗ| (|u| + 1)` gives `∫ qₗ uₖ → ∫ qₗ u`. -/
theorem Submission.dor_lmbsf_pwl_fderiv_weak_smooth : ∀ (d : ℕ) (K : NNReal) (us : ℕ → Euclid d → ℝ) (u : Euclid d → ℝ) (Ψ : Euclid d → Euclid d), (∀ k, LipschitzWith K (us k)) → TendstoUniformly us u atTop → ContDiff ℝ 1 Ψ → HasCompactSupport Ψ → Tendsto (fun k => ∫ y, fderiv ℝ (us k) y (Ψ y)) atTop (𝓝 (∫ y, fderiv ℝ u y (Ψ y))) := by
  intro d K us u Ψ hus hU hΨ hΨc
  -- the uniform limit `u` is again `K`-Lipschitz
  have hu : LipschitzWith K u := by
    refine LipschitzWith.of_dist_le_mul fun x y => ?_
    exact le_of_tendsto ((hU.tendsto_at x).dist (hU.tendsto_at y))
      (Eventually.of_forall fun k => (hus k).dist_le_mul x y)
  -- coordinates `Ψₗ = ⟨Ψ, eₗ⟩`: `C¹` with compact support
  set e : Fin d → Euclid d := fun l => EuclideanSpace.single l 1
  set g : Fin d → Euclid d → ℝ := fun l y => Ψ y l
  have hg_smooth : ∀ l, ContDiff ℝ 1 (g l) := fun l =>
    (EuclideanSpace.proj l : Euclid d →L[ℝ] ℝ).contDiff.comp hΨ
  have hg_supp : ∀ l, HasCompactSupport (g l) := fun l =>
    hΨc.comp_left (g := fun v : Euclid d => v l) (by simp)
  have hdecomp : ∀ (L : Euclid d →L[ℝ] ℝ) (x : Euclid d), L x = ∑ l, L (e l) * x l := by
    intro L x
    conv_lhs => rw [← (EuclideanSpace.basisFun (Fin d) ℝ).sum_repr x]
    simp [map_sum, map_smul, e, EuclideanSpace.basisFun_apply, mul_comm]
  -- `qₗ = DΨₗ[-eₗ]` is continuous with compact support
  set q : Fin d → Euclid d → ℝ := fun l y => lineDeriv ℝ (g l) y (-(e l))
  have hq_eq : ∀ l, q l = fun y => fderiv ℝ (g l) y (-(e l)) := fun l => funext fun y =>
    ((hg_smooth l).differentiable one_ne_zero y).lineDeriv_eq_fderiv
  have hq_cont : ∀ l, Continuous (q l) := by
    intro l
    rw [hq_eq l]
    exact ((hg_smooth l).continuous_fderiv one_ne_zero).clm_apply continuous_const
  have hq_supp : ∀ l, HasCompactSupport (q l) := by
    intro l
    rw [hq_eq l]
    exact ((hg_supp l).fderiv (𝕜 := ℝ)).comp_left (g := fun L : Euclid d →L[ℝ] ℝ => L (-(e l)))
      (by simp)
  -- for Lipschitz `v`, `∫ Dv[Ψ] = Σₗ ∫ Dv[eₗ] Ψₗ = Σₗ ∫ qₗ v` (Rademacher, integration by parts)
  have hsum : ∀ (v : Euclid d → ℝ) (C : NNReal), LipschitzWith C v →
      ∫ y, fderiv ℝ v y (Ψ y) = ∑ l, ∫ y, q l y * v y := by
    intro v C hv
    have h1 : (fun y => fderiv ℝ v y (Ψ y)) = fun y => ∑ l, fderiv ℝ v y (e l) * g l y := by
      funext y
      exact hdecomp _ _
    rw [h1, integral_finsetSum]
    · refine Finset.sum_congr rfl fun l _ => ?_
      obtain ⟨D, hD⟩ := (hg_smooth l).lipschitzWith_of_hasCompactSupport (hg_supp l) one_ne_zero
      rw [← hv.integral_lineDeriv_mul_eq hD (hg_supp l) (e l)]
      apply integral_congr_ae
      filter_upwards [hv.ae_differentiableAt] with y hy
      rw [hy.lineDeriv_eq_fderiv]
    · intro l _
      have hgi : Integrable (g l) :=
        (hg_smooth l).continuous.integrable_of_hasCompactSupport (hg_supp l)
      refine Integrable.bdd_mul (c := C * ‖e l‖) hgi
        (measurable_fderiv_apply_const ℝ v (e l)).aestronglyMeasurable
        (Eventually.of_forall fun y => ?_)
      exact (ContinuousLinearMap.le_opNorm _ _).trans
        (mul_le_mul_of_nonneg_right (norm_fderiv_le_of_lipschitz ℝ hv) (norm_nonneg _))
  rw [hsum u K hu]
  have hk : (fun k => ∫ y, fderiv ℝ (us k) y (Ψ y)) = fun k => ∑ l, ∫ y, q l y * us k y := by
    funext k
    exact hsum (us k) K (hus k)
  rw [hk]
  -- dominated convergence for each `∫ qₗ uₖ`, with bound `|qₗ| (|u| + 1)`
  refine tendsto_finsetSum _ fun l _ => ?_
  apply tendsto_integral_filter_of_dominated_convergence (fun y => ‖q l y‖ * (‖u y‖ + 1))
  · exact Eventually.of_forall fun k => ((hq_cont l).mul (hus k).continuous).aestronglyMeasurable
  · rw [Metric.tendstoUniformly_iff] at hU
    filter_upwards [hU 1 one_pos] with k hk
    refine Eventually.of_forall fun y => ?_
    rw [norm_mul]
    gcongr
    have h1 := hk y
    rw [dist_eq_norm] at h1
    have h2 : ‖us k y‖ ≤ ‖u y‖ + ‖u y - us k y‖ := by
      have := norm_sub_norm_le (us k y) (u y)
      rw [norm_sub_rev] at this
      linarith
    linarith
  · exact ((hq_cont l).norm.mul (hu.continuous.norm.add continuous_const))
      |>.integrable_of_hasCompactSupport (hq_supp l).norm.mul_right
  · exact Eventually.of_forall fun y => ((hU.tendsto_at y).const_mul (q l y))

/-- **Weak convergence of derivatives against `L¹` fields.**  If the `uₖ : ℝᵈ → ℝ` are
`K`-Lipschitz and converge uniformly to `u`, then `∫ Duₖ[Φ] → ∫ Du[Φ]` for every integrable
`Φ : ℝᵈ → ℝᵈ`.  The limit `u` is `K`-Lipschitz, and for `K`-Lipschitz `v` and integrable `Θ` the
field `Dv[Θ]` is integrable with `|∫ Dv[Θ]| ≤ K ∫ |Θ|`.  Given `ε > 0`, take a `C¹` compactly
supported `Ψ` with `∫ |Φ - Ψ| ≤ ε/(4K + 1)`: such fields are dense in `L¹`, as each `c 1_s` with
`|s| < ∞` is approximated by `f c`, `f` a smooth Urysohn function for a compact `L ⊆ s` inside an
open `W ⊇ s` with `|W \ L|` small.  Then `|∫ Dv[Φ] - ∫ Dv[Ψ]| ≤ ε/4` for `v = uₖ, u`, and
`∫ Duₖ[Ψ] → ∫ Du[Ψ]` by `dor_lmbsf_pwl_fderiv_weak_smooth`. -/
theorem Submission.dor_lmbsf_pwl_fderiv_weak_integrable : ∀ (d : ℕ) (K : NNReal) (us : ℕ → Euclid d → ℝ) (u : Euclid d → ℝ) (Φ : Euclid d → Euclid d), (∀ k, LipschitzWith K (us k)) → TendstoUniformly us u atTop → Integrable Φ → Tendsto (fun k => ∫ y, fderiv ℝ (us k) y (Φ y)) atTop (𝓝 (∫ y, fderiv ℝ u y (Φ y))) := by
  intro d K us u Φ hus hU hΦ
  -- the uniform limit `u` is `K`-Lipschitz
  have hu : LipschitzWith K u := LipschitzWith.of_dist_le_mul fun x z =>
    le_of_tendsto ((hU.tendsto_at x).dist (hU.tendsto_at z))
      (Eventually.of_forall fun k => (hus k).dist_le_mul x z)
  -- `‖Dv‖ ≤ K` for `K`-Lipschitz `v`, so `Dv[Θ]` is integrable and `|∫ Dv[Θ]| ≤ K ∫ |Θ|`
  have hbound : ∀ v : Euclid d → ℝ, LipschitzWith K v → ∀ Θ : Euclid d → Euclid d,
      Integrable Θ → Integrable (fun y => fderiv ℝ v y (Θ y)) ∧
        ‖∫ y, fderiv ℝ v y (Θ y)‖ ≤ K * ∫ y, ‖Θ y‖ := by
    intro v hv Θ hΘ
    have hmeas : AEStronglyMeasurable (fun y => fderiv ℝ v y (Θ y)) volume :=
      Continuous.comp_aestronglyMeasurable
        (isBoundedBilinearMap_apply (𝕜 := ℝ) (E := Euclid d) (F := ℝ)).continuous
        ((measurable_fderiv ℝ v).aestronglyMeasurable.prodMk hΘ.aestronglyMeasurable)
    have hle : ∀ y, ‖fderiv ℝ v y (Θ y)‖ ≤ K * ‖Θ y‖ := fun y =>
      (ContinuousLinearMap.le_opNorm _ _).trans
        (mul_le_mul_of_nonneg_right (norm_fderiv_le_of_lipschitz ℝ hv) (norm_nonneg _))
    refine ⟨(hΘ.norm.const_mul K).mono' hmeas (Eventually.of_forall hle), ?_⟩
    calc ‖∫ y, fderiv ℝ v y (Θ y)‖ ≤ ∫ y, (K : ℝ) * ‖Θ y‖ :=
          norm_integral_le_of_norm_le (hΘ.norm.const_mul K) (Eventually.of_forall hle)
      _ = K * ∫ y, ‖Θ y‖ := integral_const_mul _ _
  -- `C¹` compactly supported fields are dense in `L¹`.  By `MemLp.induction_dense` it suffices to
  -- approximate `c 1_s` for `s` of finite measure: take a compact `L ⊆ s` and an open `W ⊇ s` with
  -- `|W \ L| < δ/|c|`, and a smooth `f : ℝᵈ → [0, 1]` with `f = 1` on `L` and support
  -- `W ∩ B_R(0) ⊇ L`; then `|f c - c 1_s| ≤ |c| 1_{W \ L}`.
  have hdense : ∀ ε : ℝ≥0∞, ε ≠ 0 → ∃ Ψ : Euclid d → Euclid d,
      eLpNorm (Φ - Ψ) 1 volume ≤ ε ∧ ContDiff ℝ 1 Ψ ∧ HasCompactSupport Ψ := by
    intro ε hε
    refine (memLp_one_iff_integrable.2 hΦ).induction_dense ENNReal.one_ne_top
      (fun Ψ => ContDiff ℝ 1 Ψ ∧ HasCompactSupport Ψ) ?_ ?_ hε
    · intro c s hs hμs δ hδ
      rcases eq_or_ne c 0 with rfl | hc
      · exact ⟨0, by simp, contDiff_const, HasCompactSupport.zero⟩
      have hc0 : ‖c‖ₑ ≠ 0 := enorm_ne_zero.2 hc
      have hη : δ / ‖c‖ₑ / 2 ≠ 0 := by simp [ENNReal.div_eq_zero_iff, hδ]
      obtain ⟨W, hsW, hWo, -, hW⟩ := hs.exists_isOpen_sdiff_lt hμs.ne hη
      obtain ⟨L, hLs, hLc, hL⟩ := hs.exists_isCompact_sdiff_lt hμs.ne hη
      obtain ⟨R, hR⟩ := hLc.isBounded.subset_ball 0
      obtain ⟨f, hfs, hf01, hfsupp, hf1⟩ := exists_contDiff_support_eq_eq_one_iff (n := 1)
        (hWo.inter isOpen_ball) hLc.isClosed (subset_inter (hLs.trans hsW) hR)
      have hf0 : ∀ x, x ∉ W ∩ ball 0 R → f x = 0 := fun x hx =>
        notMem_support.1 (hfsupp.symm ▸ hx)
      refine ⟨fun x => f x • c, ?_, hfs.smul contDiff_const, ?_⟩
      · have hpt : ∀ x, ‖((fun x => f x • c) - s.indicator fun _ => c) x‖
            ≤ ‖(W \ L).indicator (fun _ => c) x‖ := by
          intro x
          obtain ⟨hfx0, hfx1⟩ := hf01 (mem_range_self x)
          by_cases hxs : x ∈ s
          · by_cases hxL : x ∈ L
            · simp [indicator_of_mem hxs, (hf1 x).1 hxL]
            · rw [Pi.sub_apply, indicator_of_mem hxs,
                indicator_of_mem (mem_sdiff_of_mem (hsW hxs) hxL),
                show f x • c - c = (f x - 1) • c by rw [sub_smul, one_smul], norm_smul,
                Real.norm_eq_abs, abs_of_nonpos (by linarith)]
              exact mul_le_of_le_one_left (norm_nonneg _) (by linarith)
          · by_cases hxW : x ∈ W
            · rw [Pi.sub_apply, indicator_of_notMem hxs,
                indicator_of_mem (mem_sdiff_of_mem hxW fun h => hxs (hLs h)), sub_zero, norm_smul,
                Real.norm_eq_abs, abs_of_nonneg hfx0]
              exact mul_le_of_le_one_left (norm_nonneg _) hfx1
            · simp [indicator_of_notMem hxs, hf0 x fun h => hxW h.1]
        have hWL : volume (W \ L) ≤ δ / ‖c‖ₑ := by
          calc volume (W \ L) ≤ volume ((W \ s) ∪ (s \ L)) := measure_mono fun x hx => by
                by_cases h : x ∈ s
                · exact Or.inr ⟨h, hx.2⟩
                · exact Or.inl ⟨hx.1, h⟩
            _ ≤ volume (W \ s) + volume (s \ L) := measure_union_le _ _
            _ ≤ δ / ‖c‖ₑ / 2 + δ / ‖c‖ₑ / 2 := add_le_add hW.le hL.le
            _ = δ / ‖c‖ₑ := ENNReal.add_halves _
        calc eLpNorm ((fun x => f x • c) - s.indicator fun _ => c) 1 volume
            ≤ eLpNorm ((W \ L).indicator fun _ => c) 1 volume :=
              eLpNorm_mono ((hfs.continuous.smul continuous_const).aestronglyMeasurable.sub
                (aestronglyMeasurable_const.indicator hs)) hpt
          _ ≤ ‖c‖ₑ * volume (W \ L) := by
              simpa using eLpNorm_indicator_const_le c 1
                (μ := volume) (hWo.measurableSet.diff hLc.measurableSet).nullMeasurableSet
          _ ≤ ‖c‖ₑ * (δ / ‖c‖ₑ) := by gcongr
          _ = δ := ENNReal.mul_div_cancel hc0 enorm_ne_top
      · refine HasCompactSupport.intro (isCompact_closedBall 0 R) fun x hx => ?_
        rw [hf0 x fun h => hx (ball_subset_closedBall h.2), zero_smul]
    · rintro f g ⟨hf, hf'⟩ ⟨hg, hg'⟩
      exact ⟨hf.add hg, hf'.add hg'⟩
  refine Metric.tendsto_atTop.2 fun ε hε => ?_
  -- a `C¹` compactly supported `Ψ` with `∫ |Φ - Ψ| ≤ η`, where `Kη ≤ ε/4`
  set η : ℝ := ε / (4 * K + 1) with hη
  have hηpos : 0 < η := div_pos hε (by positivity)
  have hKη : (K : ℝ) * η ≤ ε / 4 := by
    rw [hη, mul_div_assoc', div_le_div_iff₀ (by positivity) (by norm_num)]
    nlinarith [K.2]
  obtain ⟨Ψ, hΨε, hΨs, hΨc⟩ := hdense (ENNReal.ofReal η) (ENNReal.ofReal_pos.2 hηpos).ne'
  have hΨi : Integrable Ψ := hΨs.continuous.integrable_of_hasCompactSupport hΨc
  have hdiff : ∫ y, ‖(Φ - Ψ) y‖ ≤ η := by
    rw [integral_norm_eq_lintegral_enorm (hΦ.sub hΨi).aestronglyMeasurable,
      ← eLpNorm_one_eq_lintegral_enorm (hΦ.sub hΨi).aestronglyMeasurable]
    exact ENNReal.toReal_le_of_le_ofReal hηpos.le hΨε
  -- replacing `Φ` by `Ψ` moves `∫ Dv[Φ]` by at most `Kη ≤ ε/4`
  have hclose : ∀ v : Euclid d → ℝ, LipschitzWith K v →
      dist (∫ y, fderiv ℝ v y (Φ y)) (∫ y, fderiv ℝ v y (Ψ y)) ≤ ε / 4 := by
    intro v hv
    rw [dist_eq_norm, ← integral_sub (hbound v hv Φ hΦ).1 (hbound v hv Ψ hΨi).1]
    calc ‖∫ y, (fderiv ℝ v y (Φ y) - fderiv ℝ v y (Ψ y))‖
        = ‖∫ y, fderiv ℝ v y ((Φ - Ψ) y)‖ := by simp only [Pi.sub_apply, map_sub]
      _ ≤ K * ∫ y, ‖(Φ - Ψ) y‖ := (hbound v hv (Φ - Ψ) (hΦ.sub hΨi)).2
      _ ≤ K * η := mul_le_mul_of_nonneg_left hdiff K.2
      _ ≤ ε / 4 := hKη
  -- `∫ Duₖ[Ψ] → ∫ Du[Ψ]` for the `C¹` compactly supported field `Ψ`
  obtain ⟨N, hN⟩ := Metric.tendsto_atTop.1
    (Submission.dor_lmbsf_pwl_fderiv_weak_smooth d K us u Ψ hus hU hΨs hΨc) (ε / 2) (half_pos hε)
  refine ⟨N, fun k hk => ?_⟩
  have h1 := hclose (us k) (hus k)
  have h2 : dist (∫ y, fderiv ℝ (us k) y (Ψ y)) (∫ y, fderiv ℝ u y (Ψ y)) < ε / 2 := hN k hk
  have h3 := hclose u hu
  rw [dist_comm] at h3
  linarith [dist_triangle4 (∫ y, fderiv ℝ (us k) y (Φ y)) (∫ y, fderiv ℝ (us k) y (Ψ y))
    (∫ y, fderiv ℝ u y (Ψ y)) (∫ y, fderiv ℝ u y (Φ y))]
/-- **Functions agreeing on a measurable set have equal derivatives a.e. on it.**  Assume that
density points see every direction (the statement of `Submission.dor_lmbsf_density_directions`).
If `Z ⊆ ℝᵈ` is measurable and `v₁ = v₂` on `Z`, then `Dv₁(y) = Dv₂(y)` at `Lᵈ`-a.e. `y ∈ Z` where
both are differentiable.  By the Besicovitch density theorem a.e. `y ∈ Z` is a density point of `Z`;
there each unit vector `e` is a limit of `(yᵢ - y)/|yᵢ - y|` with `yᵢ ∈ Z ∖ {y}`, `yᵢ → y`, and the
difference quotients of `v₁ - v₂` along `yᵢ` vanish, so `(Dv₁(y) - Dv₂(y)) e = 0`. -/
theorem Submission.dor_lmbsf_pwl_fderiv_eq_ae_of_eqOn : (∀ (d : ℕ) (Z : Set (Euclid d)) (y : Euclid d), Tendsto (fun r => volume (Z ∩ closedBall y r) / volume (closedBall y r)) (𝓝[>] 0) (𝓝 1) → ∀ v : Euclid d, ‖v‖ = 1 → ∃ ys : ℕ → Euclid d, (∀ i, ys i ∈ Z ∧ ys i ≠ y) ∧ Tendsto ys atTop (𝓝 y) ∧ Tendsto (fun i => ‖ys i - y‖⁻¹ • (ys i - y)) atTop (𝓝 v)) → ∀ (d : ℕ) (Z : Set (Euclid d)) (v₁ v₂ : Euclid d → ℝ), MeasurableSet Z → EqOn v₁ v₂ Z → ∀ᵐ y ∂(volume : Measure (Euclid d)), y ∈ Z → DifferentiableAt ℝ v₁ y → DifferentiableAt ℝ v₂ y → fderiv ℝ v₁ y = fderiv ℝ v₂ y := by
  intro hDD d Z v₁ v₂ hZ hEq
  -- a.e. point of `Z` is a Lebesgue density point of `Z`
  have h := Besicovitch.ae_tendsto_measure_inter_div (volume : Measure (Euclid d)) Z
  rw [ae_restrict_iff' hZ] at h
  filter_upwards [h] with y hy hyZ h1 h2
  have hden := hy hyZ
  set L := fderiv ℝ v₁ y - fderiv ℝ v₂ y with hLdef
  have hv : HasFDerivAt (fun x => v₁ x - v₂ x) L y := h1.hasFDerivAt.sub h2.hasFDerivAt
  -- along `yᵢ ∈ Z` with `(yᵢ - y)/|yᵢ - y| → e` the difference quotients of `v₁ - v₂` are `0`
  have hunit : ∀ e : Euclid d, ‖e‖ = 1 → L e = 0 := by
    intro e he
    obtain ⟨ys, hysZ, hys, hdir⟩ := hDD d Z y hden e he
    have hd0 : Tendsto (fun i => ys i - y) atTop (𝓝 0) := by
      simpa using hys.sub_const y
    have hlim := (hv.hasFDerivWithinAt (s := univ)).lim (l := atTop)
      (c := fun i => ‖ys i - y‖⁻¹) (d := fun i => ys i - y) hd0
      (Eventually.of_forall fun _ => mem_univ _) hdir
    have hzero : (fun i => ‖ys i - y‖⁻¹ • ((v₁ (y + (ys i - y)) - v₂ (y + (ys i - y))) -
        (v₁ y - v₂ y))) = fun _ => (0 : ℝ) := by
      funext i
      have hi : y + (ys i - y) = ys i := by abel
      rw [hi, hEq (hysZ i).1, hEq hyZ]
      simp
    rw [hzero] at hlim
    exact tendsto_nhds_unique hlim tendsto_const_nhds
  -- a linear map vanishing on unit vectors is `0`
  have hL : L = 0 := by
    ext e
    by_cases he : e = 0
    · simp [he]
    · have hn : ‖e‖ ≠ 0 := norm_ne_zero_iff.2 he
      have h1' : ‖‖e‖⁻¹ • e‖ = 1 := by
        rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hn]
      have := hunit _ h1'
      rw [map_smul, smul_eq_mul, mul_eq_zero] at this
      rcases this with h | h
      · exact absurd (inv_eq_zero.1 h) hn
      · simpa using h
  exact sub_eq_zero.1 hL

/-- **Chain rule for the cutoff `γ ∘ F`, a.e. on a Borel set.**  Let `a < b`,
`γ(s) = min{1, max{0, (b - s)/(b - a)}}`, `F : ℝᵈ → ℝ` differentiable and `u` Lipschitz with
`u = γ ∘ F` on a Borel set `Z`.  Assuming the density-directions lemma (DD), for a.e. `y ∈ Z`,
`Du(y) = γ'(F(y)) DF(y)`, where `γ' = -(b - a)⁻¹` on `(a, b)` and `γ' = 0` elsewhere.  By
Rademacher `u` is differentiable a.e.  On the kink levels `Z ∩ {F = a}` and `Z ∩ {F = b}`, `u` agrees
with the constants `γ(a) = 1` and `γ(b) = 0`; off them `γ ∘ F` is, near `y`, identically `1`,
`(b - F)/(b - a)` or `0`, hence differentiable with derivative `γ'(F(y)) DF(y)`.  In each case the
agreement lemma `dor_lmbsf_pwl_fderiv_eq_ae_of_eqOn` transfers the derivative to `u`. -/
theorem Submission.dor_lmbsf_pwl_fderiv_cutoff_comp_ae : (∀ (d : ℕ) (Z : Set (Euclid d)) (y : Euclid d), Tendsto (fun r => volume (Z ∩ closedBall y r) / volume (closedBall y r)) (𝓝[>] 0) (𝓝 1) → ∀ v : Euclid d, ‖v‖ = 1 → ∃ ys : ℕ → Euclid d, (∀ i, ys i ∈ Z ∧ ys i ≠ y) ∧ Tendsto ys atTop (𝓝 y) ∧ Tendsto (fun i => ‖ys i - y‖⁻¹ • (ys i - y)) atTop (𝓝 v)) → ∀ (d : ℕ) (Z : Set (Euclid d)) (F u : Euclid d → ℝ) (K : NNReal) (a b : ℝ), MeasurableSet Z → Differentiable ℝ F → LipschitzWith K u → a < b → (∀ y ∈ Z, u y = min 1 (max 0 ((b - F y) / (b - a)))) → ∀ᵐ y ∂(volume : Measure (Euclid d)), y ∈ Z → fderiv ℝ u y = (if a < F y ∧ F y < b then -(b - a)⁻¹ else 0) • fderiv ℝ F y := by
  intro hDD d Z F u K a b hZ hF hu hab hEq
  have hFc : Continuous F := hF.continuous
  have hba : 0 < b - a := sub_pos.2 hab
  set g : Euclid d → ℝ := fun y => min 1 (max 0 ((b - F y) / (b - a))) with hgdef
  -- the Borel pieces `Z ∩ {F ∉ {a, b}}`, `Z ∩ {F = a}`, `Z ∩ {F = b}`
  have hZ0 : MeasurableSet (Z ∩ {y | F y ≠ a ∧ F y ≠ b}) := by
    refine hZ.inter ?_
    have h1 : MeasurableSet {y | F y ≠ a} :=
      (measurableSet_singleton a).compl.preimage hFc.measurable
    have h2 : MeasurableSet {y | F y ≠ b} :=
      (measurableSet_singleton b).compl.preimage hFc.measurable
    exact h1.inter h2
  have hZa : MeasurableSet (Z ∩ F ⁻¹' {a}) :=
    hZ.inter ((measurableSet_singleton a).preimage hFc.measurable)
  have hZb : MeasurableSet (Z ∩ F ⁻¹' {b}) :=
    hZ.inter ((measurableSet_singleton b).preimage hFc.measurable)
  -- Rademacher: `u` is differentiable a.e.
  have hdiff : ∀ᵐ y ∂(volume : Measure (Euclid d)), DifferentiableAt ℝ u y :=
    hu.ae_differentiableAt
  -- `u = γ ∘ F` off the kinks, `u = γ(a) = 1` on `{F = a}` and `u = γ(b) = 0` on `{F = b}`
  have h0 := Submission.dor_lmbsf_pwl_fderiv_eq_ae_of_eqOn hDD d (Z ∩ {y | F y ≠ a ∧ F y ≠ b}) u g
    hZ0 (fun y hy => hEq y hy.1)
  have ha := Submission.dor_lmbsf_pwl_fderiv_eq_ae_of_eqOn hDD d (Z ∩ F ⁻¹' {a}) u (fun _ => 1)
    hZa (by
      intro y hy
      have hFy : F y = a := hy.2
      simp only [hEq y hy.1, hFy, div_self hba.ne']
      simp)
  have hb := Submission.dor_lmbsf_pwl_fderiv_eq_ae_of_eqOn hDD d (Z ∩ F ⁻¹' {b}) u (fun _ => 0)
    hZb (by
      intro y hy
      have hFy : F y = b := hy.2
      simp only [hEq y hy.1, hFy, sub_self, zero_div]
      simp)
  filter_upwards [hdiff, h0, ha, hb] with y hyd hy0 hya hyb hyZ
  -- kink levels: `Du(y) = 0 = γ'(F(y)) DF(y)`
  by_cases hFa : F y = a
  · have h := hya ⟨hyZ, hFa⟩ hyd (differentiableAt_const _)
    rw [h, fderiv_const_apply]
    simp [hFa]
  by_cases hFb : F y = b
  · have h := hyb ⟨hyZ, hFb⟩ hyd (differentiableAt_const _)
    rw [h, fderiv_const_apply]
    simp [hFb]
  -- off the kinks `g = γ ∘ F` is locally `1`, `(b - F)/(b - a)` or `0`
  have hgd : HasFDerivAt g ((if a < F y ∧ F y < b then -(b - a)⁻¹ else 0) • fderiv ℝ F y) y := by
    have hFd : HasFDerivAt F (fderiv ℝ F y) y := (hF y).hasFDerivAt
    rcases lt_or_gt_of_ne hFa with h | h
    · -- `F y < a`: `g = 1` near `y`
      have hev : g =ᶠ[𝓝 y] fun _ => (1 : ℝ) := by
        filter_upwards [hFc.continuousAt.eventually (gt_mem_nhds h)] with z hz
        have : 1 < (b - F z) / (b - a) := by
          rw [one_lt_div hba]; linarith
        simp only [hgdef]
        rw [max_eq_right (by linarith), min_eq_left this.le]
      have hn : ¬ (a < F y ∧ F y < b) := fun h' => absurd h'.1 (not_lt.2 h.le)
      simp only [hn, ite_false, zero_smul]
      exact (hasFDerivAt_const (1 : ℝ) y).congr_of_eventuallyEq hev
    · rcases lt_or_gt_of_ne hFb with h' | h'
      · -- `a < F y < b`: `g = (b - F)/(b - a)` near `y`
        have hev : g =ᶠ[𝓝 y] fun z => (b - F z) / (b - a) := by
          filter_upwards [hFc.continuousAt.eventually (lt_mem_nhds h),
            hFc.continuousAt.eventually (gt_mem_nhds h')] with z hz1 hz2
          have hpos : 0 < (b - F z) / (b - a) := div_pos (by linarith) hba
          have hlt : (b - F z) / (b - a) < 1 := by
            rw [div_lt_one hba]; linarith
          simp only [hgdef]
          rw [max_eq_right hpos.le, min_eq_right hlt.le]
        have hy' : a < F y ∧ F y < b := ⟨h, h'⟩
        simp only [hy', and_self, ite_true]
        have hlin : HasFDerivAt (fun z => (b - F z) / (b - a))
            (-(b - a)⁻¹ • fderiv ℝ F y) y := by
          have := ((hasFDerivAt_const b y).sub hFd).const_mul (b - a)⁻¹
          convert this using 1
          · funext z
            simp only [Pi.sub_apply]
            rw [div_eq_inv_mul]
          · rw [zero_sub, smul_neg, neg_smul]
        exact hlin.congr_of_eventuallyEq hev
      · -- `F y > b`: `g = 0` near `y`
        have hev : g =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
          filter_upwards [hFc.continuousAt.eventually (lt_mem_nhds h')] with z hz
          have : (b - F z) / (b - a) < 0 := div_neg_of_neg_of_pos (by linarith) hba
          simp only [hgdef]
          rw [max_eq_left this.le]
          simp
        have hn : ¬ (a < F y ∧ F y < b) := fun h'' => absurd h''.2 (not_lt.2 h'.le)
        simp only [hn, ite_false, zero_smul]
        exact (hasFDerivAt_const (0 : ℝ) y).congr_of_eventuallyEq hev
  have h := hy0 ⟨hyZ, hFa, hFb⟩ hyd hgd.differentiableAt
  rw [h, hgd.fderiv]
/-- **Cut-off localization of `hₖ ∘ ψ` near a compact subset of a `C¹` chart domain.**  Choose
`δ > 0` with `S = cthickening δ C ⊆ V` and a `C¹` Urysohn function `χ : ℝᵈ → [0, 1]` equal to `1`
on `cthickening (δ/2) C` and to `0` off `thickening δ C`, so `tsupport χ ⊆ S`.  Then
`uₖ = χ · (hₖ ∘ ψ)` and `u = χ · (h ∘ ψ)` agree with `hₖ ∘ ψ`, `h ∘ ψ` on `O = thickening (δ/2) C`.
On `S` the `hₖ ∘ ψ` are bounded by some `B` uniformly in `k` (`ψ(S)` is bounded, the `hₖ` are
`c`-Lipschitz and `hₖ(ψ(y₀))` converges), so the product and chain rules give
`‖Duₖ‖ ≤ B sup ‖Dχ‖ + c sup_S ‖Dψ‖`; `uₖ → u` uniformly because `0 ≤ χ ≤ 1`, and `u` is Lipschitz
as the pointwise limit of the `uₖ`.  For `C = ∅` all the functions are `0`. -/
theorem Submission.dor_lmbsf_pwl_chart_cutoff_localize : ∀ (P d : ℕ) (V C : Set (Euclid d)) (ψ : Euclid d → Euclid P) (hs : ℕ → Euclid P → ℝ) (h : Euclid P → ℝ) (c : ℝ), IsOpen V → ContDiffOn ℝ 1 ψ V → IsCompact C → C ⊆ V → (∀ k, ContDiff ℝ 1 (hs k)) → (∀ k x, ‖fderiv ℝ (hs k) x‖ ≤ c) → TendstoUniformly hs h atTop → ∃ (O : Set (Euclid d)) (K : NNReal) (us : ℕ → Euclid d → ℝ) (u : Euclid d → ℝ), IsOpen O ∧ C ⊆ O ∧ (∀ k, LipschitzWith K (us k)) ∧ LipschitzWith K u ∧ TendstoUniformly us u atTop ∧ (∀ k, ∀ y ∈ O, us k y = hs k (ψ y)) ∧ ∀ y ∈ O, u y = h (ψ y) := by
  intro P d V C ψ hs h c hV hψ hC hCV hhs hhsb hU
  rcases C.eq_empty_or_nonempty with hCe | ⟨y₀, hy₀⟩
  · refine ⟨∅, 0, fun _ _ => 0, fun _ => 0, isOpen_empty, by simp [hCe],
      fun _ => LipschitzWith.const 0, LipschitzWith.const 0, ?_, by simp, by simp⟩
    rw [Metric.tendstoUniformly_iff]
    intro ε hε
    exact Eventually.of_forall fun _ _ => by simpa using hε
  have hc : 0 ≤ c := (norm_nonneg _).trans (hhsb 0 0)
  -- the compact `S = cthickening δ C ⊆ V` and the cut-off `χ`, `1` near `C` and `0` off `S`
  obtain ⟨δ, hδ, hδV⟩ := hC.exists_cthickening_subset_open hV hCV
  have hδ2 : 0 < δ / 2 := by positivity
  set S := cthickening δ C
  have hS : IsCompact S := hC.cthickening
  have hst : Disjoint (thickening δ C)ᶜ (cthickening (δ / 2) C) := by
    rw [disjoint_compl_left_iff_subset]
    exact cthickening_subset_thickening' hδ (by linarith) C
  obtain ⟨χ, hχs, hχr, hχ0, hχ1⟩ := exists_contDiff_zero_iff_one_iff_of_isClosed (n := 1)
    isOpen_thickening.isClosed_compl isClosed_cthickening hst
  have hχ01 : ∀ y, 0 ≤ χ y ∧ χ y ≤ 1 := fun y => hχr ⟨y, rfl⟩
  have hsupp : tsupport χ ⊆ S := by
    apply closure_minimal _ isClosed_cthickening
    intro y hy
    by_contra hcon
    exact hy ((hχ0 y).1 (fun h' => hcon (thickening_subset_cthickening δ C h')))
  have hχc : HasCompactSupport χ := hS.of_isClosed_subset (isClosed_tsupport χ) hsupp
  -- bounds `Mχ` for `‖Dχ‖`, `Mψ` for `‖Dψ‖` on `S` and `B` for `|hₖ ∘ ψ|` on `S`, uniform in `k`
  obtain ⟨Mχ, hMχ⟩ := (hχc.fderiv (𝕜 := ℝ)).exists_bound_of_continuous
    (hχs.continuous_fderiv one_ne_zero)
  obtain ⟨Mψ, hMψ⟩ := hS.exists_bound_of_continuousOn
    ((hψ.continuousOn_fderiv_of_isOpen hV le_rfl).mono hδV)
  have hy₀S : y₀ ∈ S := self_subset_cthickening C hy₀
  have hMχ0 : 0 ≤ Mχ := (norm_nonneg _).trans (hMχ y₀)
  have hMψ0 : 0 ≤ Mψ := (norm_nonneg _).trans (hMψ y₀ hy₀S)
  have hhsL : ∀ k, LipschitzWith ⟨c, hc⟩ (hs k) := fun k =>
    lipschitzWith_of_nnnorm_fderiv_le ((hhs k).differentiable one_ne_zero) (fun x =>
      NNReal.coe_le_coe.mp (by rw [coe_nnnorm]; exact hhsb k x))
  have hψS : IsCompact (ψ '' S) := hS.image_of_continuousOn (hψ.continuousOn.mono hδV)
  obtain ⟨D, hD⟩ := hψS.isBounded.subset_closedBall (ψ y₀)
  obtain ⟨B₀, hB₀⟩ := ((hU.tendsto_at (ψ y₀)).abs).bddAbove_range
  set B := B₀ + c * D
  have hB : ∀ k, ∀ y ∈ S, |hs k (ψ y)| ≤ B := by
    intro k y hy
    have h1 : |hs k (ψ y) - hs k (ψ y₀)| ≤ c * dist (ψ y) (ψ y₀) := by
      have := (hhsL k).dist_le_mul (ψ y) (ψ y₀)
      rw [Real.dist_eq] at this
      exact this
    have h2 : dist (ψ y) (ψ y₀) ≤ D := hD (mem_image_of_mem ψ hy)
    have h3 : |hs k (ψ y₀)| ≤ B₀ := hB₀ ⟨k, rfl⟩
    have h4 := abs_sub_abs_le_abs_sub (hs k (ψ y)) (hs k (ψ y₀))
    have h5 : c * dist (ψ y) (ψ y₀) ≤ c * D := mul_le_mul_of_nonneg_left h2 hc
    linarith
  have hB0 : 0 ≤ B := (abs_nonneg _).trans (hB 0 y₀ hy₀S)
  set K : ℝ := B * Mχ + c * Mψ with hKdef
  have hK0 : 0 ≤ K := by positivity
  -- `uₖ = χ · (hₖ ∘ ψ)` has `‖Duₖ‖ ≤ K`: product and chain rules on `tsupport χ ⊆ S ⊆ V`, and
  -- `uₖ` vanishes near every point off `tsupport χ`
  set us : ℕ → Euclid d → ℝ := fun k y => χ y * hs k (ψ y) with husdef
  have hderiv : ∀ k y, DifferentiableAt ℝ (us k) y ∧ ‖fderiv ℝ (us k) y‖ ≤ K := by
    intro k y
    by_cases hy : y ∈ tsupport χ
    · have hyS : y ∈ S := hsupp hy
      have hyV : y ∈ V := hδV hyS
      have hψd : HasFDerivAt ψ (fderiv ℝ ψ y) y :=
        ((hψ.differentiableOn one_ne_zero y hyV).differentiableAt (hV.mem_nhds hyV)).hasFDerivAt
      have hhd : HasFDerivAt (hs k) (fderiv ℝ (hs k) (ψ y)) (ψ y) :=
        ((hhs k).differentiable one_ne_zero (ψ y)).hasFDerivAt
      have hχd : HasFDerivAt χ (fderiv ℝ χ y) y := (hχs.differentiable one_ne_zero y).hasFDerivAt
      have hprod : HasFDerivAt (us k) (χ y • (fderiv ℝ (hs k) (ψ y)).comp (fderiv ℝ ψ y) +
          (hs k ∘ ψ) y • fderiv ℝ χ y) y := hχd.mul (hhd.comp y hψd)
      refine ⟨hprod.differentiableAt, ?_⟩
      rw [hprod.fderiv]
      calc ‖χ y • (fderiv ℝ (hs k) (ψ y)).comp (fderiv ℝ ψ y) + (hs k ∘ ψ) y • fderiv ℝ χ y‖
          ≤ ‖χ y‖ * (‖fderiv ℝ (hs k) (ψ y)‖ * ‖fderiv ℝ ψ y‖) +
              ‖(hs k ∘ ψ) y‖ * ‖fderiv ℝ χ y‖ := by
            refine (norm_add_le _ _).trans ?_
            rw [norm_smul, norm_smul]
            gcongr
            exact ContinuousLinearMap.opNorm_comp_le _ _
        _ ≤ 1 * (c * Mψ) + B * Mχ := by
            gcongr
            · rw [Real.norm_eq_abs, abs_of_nonneg (hχ01 y).1]
              exact (hχ01 y).2
            · exact hhsb k (ψ y)
            · exact hMψ y hyS
            · rw [Real.norm_eq_abs]
              exact hB k y hyS
            · exact hMχ y
        _ = K := by rw [hKdef]; ring
    · have hev : us k =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
        have : (tsupport χ)ᶜ ∈ 𝓝 y := (isClosed_tsupport χ).isOpen_compl.mem_nhds hy
        filter_upwards [this] with z hz
        simp [us, image_eq_zero_of_notMem_tsupport hz]
      have h0 : HasFDerivAt (us k) (0 : Euclid d →L[ℝ] ℝ) y :=
        (hasFDerivAt_const (0 : ℝ) y).congr_of_eventuallyEq hev
      refine ⟨h0.differentiableAt, ?_⟩
      rw [h0.fderiv, norm_zero]
      exact hK0
  have husL : ∀ k, LipschitzWith ⟨K, hK0⟩ (us k) := fun k =>
    lipschitzWith_of_nnnorm_fderiv_le (fun y => (hderiv k y).1) (fun y =>
      NNReal.coe_le_coe.mp (by rw [coe_nnnorm]; exact (hderiv k y).2))
  -- `uₖ → u = χ · (h ∘ ψ)` uniformly since `0 ≤ χ ≤ 1`; the pointwise limit `u` is `K`-Lipschitz
  set u : Euclid d → ℝ := fun y => χ y * h (ψ y) with hudef
  have hUu : TendstoUniformly us u atTop := by
    rw [Metric.tendstoUniformly_iff] at hU ⊢
    intro ε hε
    filter_upwards [hU ε hε] with k hk
    intro y
    have h1 := hk (ψ y)
    rw [Real.dist_eq] at h1 ⊢
    calc |u y - us k y| = |χ y| * |h (ψ y) - hs k (ψ y)| := by
          rw [← abs_mul]
          congr 1
          simp only [hudef, husdef]
          ring
      _ ≤ 1 * |h (ψ y) - hs k (ψ y)| := by
          gcongr
          rw [abs_of_nonneg (hχ01 y).1]
          exact (hχ01 y).2
      _ < ε := by linarith
  have huL : LipschitzWith ⟨K, hK0⟩ u := by
    refine LipschitzWith.of_dist_le_mul fun x y => ?_
    exact le_of_tendsto ((hUu.tendsto_at x).dist (hUu.tendsto_at y))
      (Eventually.of_forall fun k => (husL k).dist_le_mul x y)
  -- `χ = 1` on `O = thickening (δ / 2) C`
  have hχO : ∀ y ∈ thickening (δ / 2) C, χ y = 1 := fun y hy =>
    (hχ1 y).1 (thickening_subset_cthickening _ _ hy)
  refine ⟨thickening (δ / 2) C, ⟨K, hK0⟩, us, u, isOpen_thickening,
    self_subset_thickening hδ2 C, husL, huL, hUu, ?_, ?_⟩
  · intro k y hy
    simp [husdef, hχO y hy]
  · intro y hy
    simp [hudef, hχO y hy]

/-- Harmonic approximation with affine decay (Simon Ch. 5, Lemma 3.1 with the estimates 3.2–3.4).
For `ε' > 0` let `δ_h = δ(ε')` be the constant of `Submission.dorag_ha_approximation`: it gives `h`
smooth and harmonic on `B = B̆_{R₀}(0)` with `∫_B ‖Dh‖² ≤ R₀ⁿ` and `∫_B (h − w)² ≤ ε'R₀ⁿ⁺²`.  Since
`h² ≤ 2w² + 2(h − w)²`, the interior estimates `Submission.dorag_ha_interior_estimates` (constant
`C_H`) apply to `h`; put `a = h(0)` and `b = Dh(0)`.  Then `‖b‖ ≤ C_H`,
`|a| ≤ √2C_H(√(R₀⁻ⁿ∫_B w²) + √ε'R₀)` and, as `|h(v) − a − b(v)| ≤ C_Hθ'²R₀` on `B̆_{θ'R₀}(0)`,
`∫_{B̆_{θ'R₀}(0)} (w − a − b)² ≤ 2ε'R₀ⁿ⁺² + 2(C_Hθ'²R₀)²(θ'R₀)ⁿω` with `ω = Lⁿ(B̆₁(0))`.  So
`C = max(√2C_H, 2, 2ωC_H²)` works. -/
theorem Submission.dimred_cdg_harmonic_affine_approximation : ∀ n : ℕ, 0 < n → ∃ C : ℝ, 0 < C ∧ ∀ ε' : ℝ, 0 < ε' → ∃ δh : ℝ, 0 < δh ∧ ∀ (R₀ : ℝ) (w : Euclid n → ℝ) (Lw : NNReal), 0 < R₀ → LipschitzWith Lw w → ∫ v in ball (0 : Euclid n) R₀, ‖fderiv ℝ w v‖ ^ 2 ≤ R₀ ^ n → (∀ ζ : Euclid n → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ → tsupport ζ ⊆ ball (0 : Euclid n) R₀ → ∀ G : ℝ, (∀ v, ‖fderiv ℝ ζ v‖ ≤ G) → |∫ v in ball (0 : Euclid n) R₀, ∑ i : Fin n, fderiv ℝ w v (EuclideanSpace.single i (1 : ℝ)) * fderiv ℝ ζ v (EuclideanSpace.single i (1 : ℝ))| ≤ δh * R₀ ^ n * G) → ∃ (a : ℝ) (b : Euclid n →L[ℝ] ℝ), ‖b‖ ≤ C ∧ |a| ≤ C * Real.sqrt ((∫ v in ball (0 : Euclid n) R₀, w v ^ 2) / R₀ ^ n) + C * Real.sqrt ε' * R₀ ∧ ∀ θ' : ℝ, 0 < θ' → θ' ≤ 1 / 4 → ∫ v in ball (0 : Euclid n) (θ' * R₀), (w v - a - b v) ^ 2 ≤ C * (ε' / θ' ^ (n + 2) + θ' ^ 2) * (θ' * R₀) ^ (n + 2) := by
  intro n hn
  obtain ⟨CH, hCH, hIE⟩ := Submission.dorag_ha_interior_estimates n hn
  -- `ω = Lⁿ(B̆₁(0))` and `Lⁿ(B̆_r(0)) = rⁿω`
  obtain ⟨ω, hω_def⟩ : ∃ ω : ℝ, (volume (ball (0 : Euclid n) 1)).toReal = ω := ⟨_, rfl⟩
  have hvol : ∀ r : ℝ, 0 < r → volume.real (ball (0 : Euclid n) r) = r ^ n * ω := by
    intro r hr
    rw [measureReal_def, Measure.addHaar_ball_of_pos volume 0 hr, finrank_euclideanSpace_fin,
      ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity), hω_def]
  -- `C = max(√2·C_H, 2, 2ωC_H²)`
  have hs2 : (1 : ℝ) ≤ Real.sqrt 2 := Real.one_le_sqrt.2 one_le_two
  obtain ⟨C, hC_def⟩ : ∃ C : ℝ, max (max (Real.sqrt 2 * CH) 2) (2 * ω * CH ^ 2) = C := ⟨_, rfl⟩
  have hC1 : Real.sqrt 2 * CH ≤ C := hC_def ▸ (le_max_left _ _).trans (le_max_left _ _)
  have hC2 : (2 : ℝ) ≤ C := hC_def ▸ (le_max_right _ _).trans (le_max_left _ _)
  have hC3 : 2 * ω * CH ^ 2 ≤ C := hC_def ▸ le_max_right _ _
  have hCHC : CH ≤ C := (le_mul_of_one_le_left hCH.le hs2).trans hC1
  refine ⟨C, by linarith, fun ε' hε' => ?_⟩
  -- `δ_h = δ(ε')` from the harmonic approximation lemma
  obtain ⟨δ, hδ, hHA⟩ := Submission.dorag_ha_approximation n hn ε' hε'
  refine ⟨δ, hδ, fun R₀ w Lw hR₀ hLw hE hH => ?_⟩
  obtain ⟨h, hC, hΔ, hI, hD, hI2, hε⟩ := hHA R₀ w Lw hR₀ hLw hE hH
  -- `w²` is continuous, hence integrable on `B_{R₀}`; `h² ≤ 2w² + 2(h − w)²` makes `h²` integrable
  have hw2 : IntegrableOn (fun y => w y ^ 2) (ball (0 : Euclid n) R₀) :=
    ((hLw.continuous.pow 2).continuousOn.integrableOn_compact (isCompact_closedBall _ _)).mono_set
      ball_subset_closedBall
  have hpt : ∀ y, h y ^ 2 ≤ 2 * w y ^ 2 + 2 * (h y - w y) ^ 2 := fun y => by
    nlinarith [sq_nonneg (h y - 2 * w y)]
  have hg : IntegrableOn (fun y => 2 * w y ^ 2 + 2 * (h y - w y) ^ 2) (ball (0 : Euclid n) R₀) :=
    (hw2.const_mul 2).add (hI2.const_mul 2)
  have hh2 : IntegrableOn (fun y => h y ^ 2) (ball (0 : Euclid n) R₀) :=
    Integrable.mono' hg (((hC 0).continuousOn.pow 2).aestronglyMeasurable measurableSet_ball)
      (ae_of_all _ fun y => by
        rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
        exact hpt y)
  -- interior estimates for `h`; put `a = h(0)`, `b = Dh(0)`
  obtain ⟨ha, hb, htay⟩ := hIE R₀ h hR₀ hC hΔ hI hD hh2
  refine ⟨h 0, fderiv ℝ h 0, hb.trans hCHC, ?_, ?_⟩
  · -- `R₀⁻ⁿ∫_{B_{R₀}} h² ≤ 2X + 2ε'R₀²` with `X = R₀⁻ⁿ∫_{B_{R₀}} w²`
    have hRn : 0 < R₀ ^ n := pow_pos hR₀ n
    have hint : ∫ y in ball (0 : Euclid n) R₀, h y ^ 2 ≤
        2 * (∫ y in ball (0 : Euclid n) R₀, w y ^ 2) + 2 * (ε' * R₀ ^ (n + 2)) :=
      calc ∫ y in ball (0 : Euclid n) R₀, h y ^ 2
          ≤ ∫ y in ball (0 : Euclid n) R₀, (2 * w y ^ 2 + 2 * (h y - w y) ^ 2) :=
            setIntegral_mono_on hh2 hg measurableSet_ball fun y _ => hpt y
        _ = 2 * (∫ y in ball (0 : Euclid n) R₀, w y ^ 2) +
              2 * ∫ y in ball (0 : Euclid n) R₀, (h y - w y) ^ 2 := by
            rw [integral_add (hw2.const_mul 2) (hI2.const_mul 2), integral_const_mul,
              integral_const_mul]
        _ ≤ _ := by linarith
    obtain ⟨X, hX_def⟩ : ∃ X : ℝ, (∫ y in ball (0 : Euclid n) R₀, w y ^ 2) / R₀ ^ n = X :=
      ⟨_, rfl⟩
    have hX : 0 ≤ X :=
      hX_def ▸ div_nonneg (setIntegral_nonneg measurableSet_ball fun y _ => sq_nonneg _) hRn.le
    have hquot : (∫ y in ball (0 : Euclid n) R₀, h y ^ 2) / R₀ ^ n ≤ 2 * X + 2 * ε' * R₀ ^ 2 := by
      rw [div_le_iff₀ hRn, ← hX_def]
      calc _ ≤ _ := hint
        _ = _ := by
          rw [add_mul, mul_assoc 2, div_mul_cancel₀ _ hRn.ne', pow_add]
          ring
    -- `√(x + y) ≤ √x + √y`
    have hsub : Real.sqrt (2 * X + 2 * ε' * R₀ ^ 2) ≤
        Real.sqrt (2 * X) + Real.sqrt (2 * ε' * R₀ ^ 2) := by
      rw [Real.sqrt_le_left (by positivity), add_sq, Real.sq_sqrt (by positivity),
        Real.sq_sqrt (by positivity)]
      nlinarith [Real.sqrt_nonneg (2 * X), Real.sqrt_nonneg (2 * ε' * R₀ ^ 2)]
    have hsqrt : Real.sqrt ((∫ y in ball (0 : Euclid n) R₀, h y ^ 2) / R₀ ^ n) ≤
        Real.sqrt 2 * Real.sqrt X + Real.sqrt 2 * Real.sqrt ε' * R₀ :=
      calc _ ≤ Real.sqrt (2 * X + 2 * ε' * R₀ ^ 2) := Real.sqrt_le_sqrt hquot
        _ ≤ Real.sqrt (2 * X) + Real.sqrt (2 * ε' * R₀ ^ 2) := hsub
        _ = _ := by
          rw [Real.sqrt_mul zero_le_two, Real.sqrt_mul' _ (sq_nonneg R₀),
            Real.sqrt_mul zero_le_two, Real.sqrt_sq hR₀.le]
    rw [hX_def]
    calc |h 0| ≤ CH * Real.sqrt ((∫ y in ball (0 : Euclid n) R₀, h y ^ 2) / R₀ ^ n) := ha
      _ ≤ CH * (Real.sqrt 2 * Real.sqrt X + Real.sqrt 2 * Real.sqrt ε' * R₀) :=
        mul_le_mul_of_nonneg_left hsqrt hCH.le
      _ = Real.sqrt 2 * CH * Real.sqrt X + Real.sqrt 2 * CH * Real.sqrt ε' * R₀ := by ring
      _ ≤ C * Real.sqrt X + C * Real.sqrt ε' * R₀ := by gcongr
  · -- affine decay on `B_{θ'R₀}`
    intro θ' hθ' hθ'4
    have hr : 0 < θ' * R₀ := mul_pos hθ' hR₀
    have hsubset : ball (0 : Euclid n) (θ' * R₀) ⊆ ball (0 : Euclid n) R₀ :=
      ball_subset_ball (by nlinarith)
    -- Taylor: `|h(v) − a − b(v)| ≤ C_H θ'² R₀ =: K` on `B_{θ'R₀}`
    obtain ⟨K, hK_def⟩ : ∃ K : ℝ, CH * θ' ^ 2 * R₀ = K := ⟨_, rfl⟩
    have hpt2 : ∀ v ∈ ball (0 : Euclid n) (θ' * R₀),
        (w v - h 0 - fderiv ℝ h 0 v) ^ 2 ≤ 2 * (h v - w v) ^ 2 + 2 * K ^ 2 := by
      intro v hv
      have hv' : ‖v‖ < θ' * R₀ := mem_ball_zero_iff.1 hv
      have hvn : ‖v‖ ^ 2 ≤ (θ' * R₀) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hv'.le 2
      have hT : |h v - h 0 - fderiv ℝ h 0 v| ≤ K := by
        refine (htay v (by nlinarith)).trans ?_
        rw [← hK_def, div_le_iff₀ hR₀]
        nlinarith
      have hsq : (h v - h 0 - fderiv ℝ h 0 v) ^ 2 ≤ K ^ 2 := by
        rw [← sq_abs]
        exact pow_le_pow_left₀ (abs_nonneg _) hT 2
      nlinarith [sq_nonneg (w v - h v - (h v - h 0 - fderiv ℝ h 0 v))]
    have hcont : Continuous fun v => (w v - h 0 - fderiv ℝ h 0 v) ^ 2 :=
      ((hLw.continuous.sub continuous_const).sub (fderiv ℝ h 0).continuous).pow 2
    have hL : IntegrableOn (fun v => (w v - h 0 - fderiv ℝ h 0 v) ^ 2)
        (ball (0 : Euclid n) (θ' * R₀)) :=
      (hcont.continuousOn.integrableOn_compact (isCompact_closedBall _ _)).mono_set
        ball_subset_closedBall
    have hI2' : IntegrableOn (fun v => (h v - w v) ^ 2) (ball (0 : Euclid n) (θ' * R₀)) :=
      hI2.mono_set hsubset
    have hK2 : IntegrableOn (fun _ => 2 * K ^ 2) (ball (0 : Euclid n) (θ' * R₀)) :=
      integrableOn_const measure_ball_lt_top.ne
    have hR : IntegrableOn (fun v => 2 * (h v - w v) ^ 2 + 2 * K ^ 2)
        (ball (0 : Euclid n) (θ' * R₀)) :=
      (hI2'.const_mul 2).add hK2
    calc ∫ v in ball (0 : Euclid n) (θ' * R₀), (w v - h 0 - fderiv ℝ h 0 v) ^ 2
        ≤ ∫ v in ball (0 : Euclid n) (θ' * R₀), (2 * (h v - w v) ^ 2 + 2 * K ^ 2) :=
          setIntegral_mono_on hL hR measurableSet_ball hpt2
      _ = 2 * (∫ v in ball (0 : Euclid n) (θ' * R₀), (h v - w v) ^ 2) +
            2 * K ^ 2 * ((θ' * R₀) ^ n * ω) := by
          rw [integral_add (hI2'.const_mul 2) hK2, integral_const_mul, setIntegral_const,
            hvol _ hr, smul_eq_mul]
          ring
      _ ≤ 2 * (ε' * R₀ ^ (n + 2)) + 2 * K ^ 2 * ((θ' * R₀) ^ n * ω) := by
          gcongr
          exact (setIntegral_mono_set hI2 (ae_of_all _ fun _ => sq_nonneg _)
            hsubset.eventuallyLE).trans hε
      _ = (2 * (ε' / θ' ^ (n + 2)) + 2 * ω * CH ^ 2 * θ' ^ 2) * (θ' * R₀) ^ (n + 2) := by
          rw [← hK_def]
          field_simp
          ring
      _ ≤ (C * (ε' / θ' ^ (n + 2)) + C * θ' ^ 2) * (θ' * R₀) ^ (n + 2) := by
          gcongr
      _ = C * (ε' / θ' ^ (n + 2) + θ' ^ 2) * (θ' * R₀) ^ (n + 2) := by ring
/-- **Test forms are Lipschitz in the Euclidean coefficient norm** (the constant `c` of the cone
inequality, Simon Ch. 6, 2.27/2.30 as used in 8.2(4)–(6)).  `ω` is `C^∞` with compact support, so
`Dω` is continuous with compact support and `‖Dω(z)‖ ≤ L₀` for some `L₀ ≥ 0`; the mean value
inequality on the convex set `ℝᴾ` gives `‖ω(x) - ω(y)‖ ≤ L₀ ‖x - y‖`.  With the bound
`covectorEuclideanNorm β ≤ C ‖β‖` of `Submission.rsd_mw_tfa_norm_props`, `c = C L₀` works. -/
theorem Submission.cbrld_cone_testForm_coeff_lipschitz : ∀ (P k : ℕ) (U : Set (Euclid P)) (ω : TestFormOn U k), ∃ c : ℝ, 0 ≤ c ∧ ∀ x y : Euclid P, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) k) x - (ω : DifferentialForm (Euclid P) k) y) ≤ c * dist x y := by
  intro P k U ω
  -- Step 1: the coefficient norm is dominated by the operator norm, `|β| ≤ C ‖β‖`
  obtain ⟨C, hC0, hC⟩ := (Submission.rsd_mw_tfa_norm_props P k).2.2.1
  -- Step 2: `ω` is smooth with compact support, so `Dω` is continuous with compact support
  have hsm : IsSmoothForm (ω : DifferentialForm (Euclid P) k) := ω.property.1.1
  have hcs : HasCompactSupport (ω : DifferentialForm (Euclid P) k) := ω.property.1.2
  have hcont : Continuous (fderiv ℝ (ω : DifferentialForm (Euclid P) k)) :=
    hsm.continuous_fderiv (by simp)
  have hcs' : HasCompactSupport (fderiv ℝ (ω : DifferentialForm (Euclid P) k)) := hcs.fderiv ℝ
  -- Step 3: `Dω` is bounded, `‖Dω(z)‖ ≤ L ≤ max L 0`
  obtain ⟨L, hL⟩ : ∃ L : ℝ, ∀ z, ‖fderiv ℝ (ω : DifferentialForm (Euclid P) k) z‖ ≤ L :=
    Continuous.bounded_above_of_compact_support
      (f := fderiv ℝ (ω : DifferentialForm (Euclid P) k)) hcont hcs'
  -- Step 4: the mean value inequality on the convex set `ℝᴾ`
  have hdiff : Differentiable ℝ (ω : DifferentialForm (Euclid P) k) :=
    hsm.differentiable (by simp)
  have hmv : ∀ x y : Euclid P, ‖(ω : DifferentialForm (Euclid P) k) x -
      (ω : DifferentialForm (Euclid P) k) y‖ ≤ max L 0 * ‖x - y‖ := fun x y =>
    convex_univ.norm_image_sub_le_of_norm_fderiv_le (fun z _ => hdiff z)
      (fun z _ => (hL z).trans (le_max_left _ _)) (mem_univ y) (mem_univ x)
  -- Step 5: `c = C · max L 0`
  refine ⟨C * max L 0, mul_nonneg hC0 (le_max_right _ _), fun x y => ?_⟩
  have h1 := hC ((ω : DifferentialForm (Euclid P) k) x - (ω : DifferentialForm (Euclid P) k) y)
  have h2 := mul_le_mul_of_nonneg_left (hmv x y) hC0
  rw [dist_eq_norm]
  calc covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) k) x -
        (ω : DifferentialForm (Euclid P) k) y)
      ≤ C * ‖(ω : DifferentialForm (Euclid P) k) x - (ω : DifferentialForm (Euclid P) k) y‖ := h1
    _ ≤ C * (max L 0 * ‖x - y‖) := h2
    _ = C * max L 0 * ‖x - y‖ := by ring
/-- **Simon 6.2.25, 6.2.30** (homotopy formula for a constant form): the affine contraction
`ψ(y) = (n + 1)⁻¹ • α.curryLeft (y - x₀)`, i.e. `ψ(y)(v₁, …, vₙ) = (n + 1)⁻¹ α(y - x₀, v₁, …, vₙ)`,
is a primitive of the constant `(n + 1)`-covector `α`.  Its derivative is the constant map
`(n + 1)⁻¹ • α.curryLeft`, and alternatizing `α.curryLeft` gives `(n + 1) • α`. -/
theorem Submission.cbrld_cone_extDeriv_affine_contraction : ∀ (P n : ℕ) (α : Covector (Euclid P) (n + 1)) (x₀ x : Euclid P), extDeriv (fun y : Euclid P => ((n : ℝ) + 1)⁻¹ • α.curryLeft (y - x₀)) x = α := by
  intro P n α x₀ x
  -- `y ↦ α.curryLeft (y - x₀)` is affine with linear part `α.curryLeft`
  have h1 : HasFDerivAt (fun y : Euclid P => α.curryLeft (y - x₀)) α.curryLeft x := by
    have h := (α.curryLeft.hasFDerivAt (x := x - x₀)).comp x ((hasFDerivAt_id x).sub_const x₀)
    rw [ContinuousLinearMap.comp_id] at h
    exact h
  have hd : HasFDerivAt (fun y : Euclid P => ((n : ℝ) + 1)⁻¹ • α.curryLeft (y - x₀))
      (((n : ℝ) + 1)⁻¹ • α.curryLeft) x := h1.const_smul (((n : ℝ) + 1)⁻¹)
  -- `extDeriv ψ x = (n + 1)⁻¹ • alternatizeUncurryFin α.curryLeft = (n + 1)⁻¹ • (n + 1) • α`
  rw [extDeriv, hd.fderiv, ContinuousAlternatingMap.alternatizeUncurryFin_smul,
    ContinuousAlternatingMap.alternatizeUncurryFin_curryLeft, ← Nat.cast_smul_eq_nsmul ℝ,
    smul_smul]
  have hn : ((n : ℝ) + 1) ≠ 0 := by positivity
  push_cast
  rw [inv_mul_cancel₀ hn, one_smul]
/-- **Localization to a neighbourhood of `spt X`** (Simon 6.2.11): assuming (VO), i.e. that a
current kills every test form whose support misses its support, a current `X` takes the same
value on test forms `φ₁`, `φ₂` that agree on an open set `G ⊇ spt X`.  The difference `φ₁ - φ₂`
vanishes on `G`, so its topological support lies in the closed set `Gᶜ`, which misses `spt X`;
(VO) and linearity give `X(φ₁) - X(φ₂) = X(φ₁ - φ₂) = 0`. -/
theorem Submission.cbrld_cone_eval_eq_of_eqOn_open : (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → ∀ (P k : ℕ) (U G : Set (Euclid P)) (X : GeometricCurrentOn U k) (φ₁ φ₂ : TestFormOn U k), IsOpen G → X.support ⊆ G → EqOn (φ₁ : DifferentialForm (Euclid P) k) (φ₂ : DifferentialForm (Euclid P) k) G → X φ₁ = X φ₂ := by
  intro VO P k U G X φ₁ φ₂ hG hspt heq
  -- `φ₁ - φ₂` vanishes on the open set `G`, so its topological support lies in `Gᶜ`
  have hsub : tsupport ((φ₁ - φ₂ : TestFormOn U k) : DifferentialForm (Euclid P) k) ⊆ Gᶜ := by
    apply closure_minimal _ hG.isClosed_compl
    intro x hx hxG
    apply hx
    change (φ₁ : DifferentialForm (Euclid P) k) x - (φ₂ : DifferentialForm (Euclid P) k) x = 0
    rw [heq hxG, sub_self]
  -- hence it misses `spt X ⊆ G`, and (VO) kills it
  have hdisj : Disjoint (tsupport ((φ₁ - φ₂ : TestFormOn U k) : DifferentialForm (Euclid P) k))
      X.support :=
    Disjoint.mono hsub hspt disjoint_compl_left
  have h := VO P k U X (φ₁ - φ₂) hdisj
  -- linearity of `X`
  have h2 := X.toCurrent.map_sub φ₁ φ₂
  change X (φ₁ - φ₂) = X φ₁ - X φ₂ at h2
  linarith
/-- **Constant forms are boundaries near the support of a cycle** (steps 5 and 7 of the cone
inequality used in Simon Ch. 6, 8.2(4)–(6), via the homotopy formula 2.25 and the cone 2.30).
Assume (VO), the vanishing of a current on test forms supported off its support.  If
`X ∈ 𝒟_{n+1}(ℝᴾ)` has `∂X = 0` and `spt X ⊆ B_r(x₀)`, and the test form `φ` equals the constant
covector `α` on `B_r(x₀)`, then `X(φ) = 0`.  With the bump `ζ` (`ζ = 1` on `B̄_r(x₀)`) and the
primitive `ψ(y) = (n + 1)⁻¹ ι_{y−x₀} α` of `α` (`cbrld_cone_extDeriv_affine_contraction`), the
test form `η = ζψ` has `dη = dψ = α = φ` on `B_r(x₀)`, so `cbrld_cone_eval_eq_of_eqOn_open` gives
`X(φ) = X(dη) = ∂X(η) = 0`. -/
theorem Submission.cbrld_cone_cycle_eval_eq_zero_of_const_on_ball : (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → ∀ (P n : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) (n + 1)) (x₀ : Euclid P) (r : ℝ) (α : Covector (Euclid P) (n + 1)) (φ : TestFormOn (univ : Set (Euclid P)) (n + 1)), 0 < r → X.boundary = 0 → X.support ⊆ ball x₀ r → (∀ x ∈ ball x₀ r, (φ : DifferentialForm (Euclid P) (n + 1)) x = α) → X φ = 0 := by
  intro VO P n X x₀ r α φ hr hbd hspt hφ
  -- Step 1: the cut-off `ζ`, equal to `1` on `B̄_r(x₀)`
  let ζ : ContDiffBump x₀ := ⟨r, r + 1, hr, by linarith⟩
  -- Step 2: the affine primitive `ψ` of `α`
  let ψ : DifferentialForm (Euclid P) n := fun y => ((n : ℝ) + 1)⁻¹ • α.curryLeft (y - x₀)
  have hψ : IsSmoothForm ψ :=
    (α.curryLeft.contDiff.comp (contDiff_id.sub contDiff_const)).const_smul _
  -- Step 3: the compactly supported primitive `η = ζψ`
  let g : DifferentialForm (Euclid P) n := fun y => ζ y • ψ y
  have hg : IsSmoothForm g := ζ.contDiff.smul hψ
  have hgc : HasCompactSupport g := ζ.hasCompactSupport.smul_right
  let η : TestFormOn (univ : Set (Euclid P)) n := ⟨g, ⟨hg, hgc⟩, subset_univ _⟩
  -- Step 4: `X(dη) = ∂X(η) = 0`
  have h0 : X (exteriorDerivativeTestOn univ n η) = 0 := by
    have h := congrArg (fun T : GeometricCurrentOn (univ : Set (Euclid P)) n => T η) hbd
    simpa using h
  -- Step 5: `φ = dη` on `B_r(x₀)`, since `η = ψ` near each point of the ball
  have heq : EqOn (φ : DifferentialForm (Euclid P) (n + 1))
      ((exteriorDerivativeTestOn univ n η : TestFormOn (univ : Set (Euclid P)) (n + 1)) :
        DifferentialForm (Euclid P) (n + 1)) (ball x₀ r) := by
    intro y hy
    rw [hφ y hy]
    change α = extDeriv g y
    have hev : g =ᶠ[𝓝 y] ψ := by
      filter_upwards [isOpen_ball.mem_nhds hy] with z hz
      simp [g, ζ.one_of_mem_closedBall (ball_subset_closedBall hz)]
    rw [hev.extDeriv_eq, Submission.cbrld_cone_extDeriv_affine_contraction P n α x₀ y]
  -- Step 6: localization to the open ball containing `spt X`
  rw [Submission.cbrld_cone_eval_eq_of_eqOn_open VO P (n + 1) univ (ball x₀ r) X φ _ isOpen_ball
    hspt heq, h0]
/-- A small scale below the lower density (Simon Ch. 6, 8.2 (2), with the lower density in place of
`Θ^{*n}`): `ωₙ > 0`, and if `liminf_{r ↓ 0} μ(B_r(x₁)) / (ωₙ rⁿ) < η₀`, then for every `δ > 0` there
is `s ∈ (0, δ)` with `μ(B_s(x₁)) < η₀ ωₙ sⁿ`.  The ratio is frequently below `η₀` along `r ↓ 0`;
clearing the nonzero, finite denominator `ωₙ sⁿ` at such an `s ∈ (0, δ)` gives the bound, and forces
`η₀ ≥ 0`. -/
theorem Submission.cbrldlf_exists_small_scale_of_lower_density : ∀ n : ℕ, 0 < (unitBallVolume n).toReal ∧ ∀ (P : ℕ) (μ : Measure (Euclid P)) (x₁ : Euclid P) (η₀ δ : ℝ), 0 < δ → liminf (fun r : ℝ => μ (ball x₁ r) / (unitBallVolume n * ENNReal.ofReal (r ^ n))) (𝓝[>] 0) < ENNReal.ofReal η₀ → ∃ s : ℝ, 0 < s ∧ s < δ ∧ μ (ball x₁ s) < ENNReal.ofReal (η₀ * (unitBallVolume n).toReal * s ^ n) := by
  intro n
  -- `ωₙ = volume (ball 0 1)` is positive (Haar measure on a nonempty open set) and finite.
  have hω₀ : unitBallVolume n ≠ 0 := (measure_ball_pos volume (0 : Euclid n) one_pos).ne'
  have hωt : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
  refine ⟨ENNReal.toReal_pos hω₀ hωt, fun P μ x₁ η₀ δ hδ hlim => ?_⟩
  -- The ratio is frequently below `η₀`, and eventually `r ∈ (0, δ)`.
  obtain ⟨s, hs, hs₀, hsδ⟩ := ((frequently_lt_of_liminf_lt (by isBoundedDefault) hlim).and_eventually
    (Ioo_mem_nhdsGT hδ)).exists
  refine ⟨s, hs₀, hsδ, ?_⟩
  -- Clear the denominator `ωₙ sⁿ`, which is nonzero and finite.
  rw [ENNReal.div_lt_iff (Or.inl (mul_ne_zero hω₀ (ENNReal.ofReal_pos.2 (pow_pos hs₀ n)).ne'))
    (Or.inl (ENNReal.mul_ne_top hωt ENNReal.ofReal_ne_top))] at hs
  -- `η₀ ≥ 0`, since otherwise the bound would be `μ (ball x₁ s) < 0`.
  have hη₀ : 0 ≤ η₀ := by
    by_contra h
    rw [ENNReal.ofReal_of_nonpos (not_le.1 h).le, zero_mul] at hs
    exact ENNReal.not_lt_zero hs
  rwa [ENNReal.ofReal_mul (mul_nonneg hη₀ ENNReal.toReal_nonneg), ENNReal.ofReal_mul hη₀,
    ENNReal.ofReal_toReal hωt, mul_assoc]
/-- **Simon Ch. 6, 8.2 (3)–(4)** (constants of the isoperimetric filling, corrected), with
`p = m + 1` and `n = m + 2`: for `c ≥ 1` there is `a > 0` such that `0 ≤ F ≤ (a s)ⁿ` and
`0 ≤ M ≤ 2 n a F^{(n-1)/n}` imply `c (2cM)^{1/p} M ≤ F / 2` and `(2cM)^{1/p} ≤ s`.  Take
`K₀ = c (2c)^{1/p} (2n)^{n/p}`, `t = min {1 / (2K₀)^{m+1}, 1 / (4cn)}` and `a = t^{1/n}`, so
`a^{m+2} = t`. -/
theorem Submission.cbrldlf_exists_filling_constant : ∀ (m : ℕ) (c : ℝ), 1 ≤ c → ∃ a : ℝ, 0 < a ∧ ∀ (s F M : ℝ), 0 ≤ s → 0 ≤ F → F ≤ (a * s) ^ (m + 1 + 1) → 0 ≤ M → M ≤ 2 * ((m + 1 + 1 : ℕ) : ℝ) * a * F ^ ((((m + 1 + 1 : ℕ) : ℝ) - 1) / ((m + 1 + 1 : ℕ) : ℝ)) → c * (2 * c * M) ^ ((1 : ℝ) / (m + 1)) * M ≤ F / 2 ∧ (2 * c * M) ^ ((1 : ℝ) / (m + 1)) ≤ s := by
  intro m c hc
  have hc0 : 0 < c := lt_of_lt_of_le one_pos hc
  -- `p = m + 1` and `n = m + 2 = p + 1`
  have hp : (0 : ℝ) < (m : ℝ) + 1 := by positivity
  have hn_eq : ((m + 1 + 1 : ℕ) : ℝ) = ((m : ℝ) + 1) + 1 := by push_cast; ring
  have hn : (0 : ℝ) < ((m + 1 + 1 : ℕ) : ℝ) := by rw [hn_eq]; linarith
  have hpinv : (1 : ℝ) / ((m : ℝ) + 1) = (((m + 1 : ℕ) : ℝ))⁻¹ := by push_cast; rw [one_div]
  set p : ℝ := (m : ℝ) + 1 with hp_def
  set n : ℝ := ((m + 1 + 1 : ℕ) : ℝ) with hn_def
  -- Step 1: the constants `K₀ > 0`, `t > 0` and `a = t^{1/n} > 0`, with `a^{m+2} = t`
  set K₀ : ℝ := c * (2 * c) ^ (1 / p) * (2 * n) ^ (n / p) with hK₀_def
  have hK₀ : 0 < K₀ :=
    mul_pos (mul_pos hc0 (Real.rpow_pos_of_pos (by positivity) _))
      (Real.rpow_pos_of_pos (by positivity) _)
  set t : ℝ := min (1 / (2 * K₀) ^ (m + 1)) (1 / (4 * c * n)) with ht_def
  have ht : 0 < t := lt_min (by positivity) (by positivity)
  set a : ℝ := t ^ (1 / n) with ha_def
  have ha : 0 < a := Real.rpow_pos_of_pos ht _
  have ha_pow : a ^ (m + 1 + 1) = t := by
    rw [ha_def, hn_def, one_div]
    exact Real.rpow_inv_natCast_pow ht.le (by omega)
  -- Step 2 (i): `t^{1/p} ≤ ((1/(2K₀))^{m+1})^{1/(m+1)} = 1/(2K₀)`
  have hi : t ^ (1 / p) ≤ 1 / (2 * K₀) := by
    have h1 : t ≤ (1 / (2 * K₀)) ^ (m + 1) := by
      rw [one_div_pow]; exact min_le_left _ _
    have h2 : t ^ (1 / p) ≤ ((1 / (2 * K₀)) ^ (m + 1)) ^ (1 / p) :=
      Real.rpow_le_rpow ht.le h1 (by positivity)
    have h3 : ((1 / (2 * K₀)) ^ (m + 1)) ^ (1 / p) = 1 / (2 * K₀) := by
      rw [hpinv]
      exact Real.pow_rpow_inv_natCast (by positivity) (by omega)
    rw [h3] at h2
    exact h2
  -- Step 2 (ii): `t ≤ 1/(4cn)`
  have hii : t ≤ 1 / (4 * c * n) := min_le_right _ _
  refine ⟨a, ha, ?_⟩
  -- Step 3: `M ≤ b := 2 n a F^{p/n}`, since `(n - 1)/n = p/n`
  intro s F M hs hF hFas hM hMb
  have hexp : (n - 1) / n = p / n := by rw [hn_eq]; ring
  rw [hexp] at hMb
  set b : ℝ := 2 * n * a * F ^ (p / n) with hb_def
  have hb : 0 ≤ b := by positivity
  constructor
  · -- Step 4: `c (2cM)^{1/p} M = c (2c)^{1/p} M^{n/p}`, as `n/p = 1/p + 1`
    have h4 : c * (2 * c * M) ^ (1 / p) * M = c * (2 * c) ^ (1 / p) * M ^ (n / p) := by
      rw [Real.mul_rpow (by positivity) hM]
      have e : n / p = 1 / p + 1 := by rw [hn_eq]; field_simp; ring
      rw [e, Real.rpow_add' hM (by positivity), Real.rpow_one]
      ring
    -- Step 5: `M^{n/p} ≤ b^{n/p}`
    have h5 : M ^ (n / p) ≤ b ^ (n / p) := Real.rpow_le_rpow hM hMb (by positivity)
    -- Step 6: `b^{n/p} = (2n)^{n/p} t^{1/p} F`
    have h6 : b ^ (n / p) = (2 * n) ^ (n / p) * t ^ (1 / p) * F := by
      rw [hb_def, Real.mul_rpow (by positivity) (by positivity),
        Real.mul_rpow (by positivity) (by positivity)]
      rw [← Real.rpow_mul hF, ha_def, ← Real.rpow_mul ht.le]
      have e1 : p / n * (n / p) = 1 := by field_simp
      have e2 : 1 / n * (n / p) = 1 / p := by field_simp
      rw [e1, e2, Real.rpow_one]
    -- Step 7: `c (2cM)^{1/p} M ≤ K₀ t^{1/p} F ≤ F / 2` by (i)
    calc c * (2 * c * M) ^ (1 / p) * M = c * (2 * c) ^ (1 / p) * M ^ (n / p) := h4
      _ ≤ c * (2 * c) ^ (1 / p) * b ^ (n / p) := by gcongr
      _ = K₀ * t ^ (1 / p) * F := by rw [h6, hK₀_def]; ring
      _ ≤ K₀ * (1 / (2 * K₀)) * F := by gcongr
      _ = F / 2 := by field_simp
  · -- Step 8: `F^{p/n} ≤ ((a s)^{m+2})^{p/n} = (a s)^{m+1}`
    have h8 : F ^ (p / n) ≤ (a * s) ^ (m + 1) := by
      have h := Real.rpow_le_rpow hF hFas (by positivity : (0 : ℝ) ≤ p / n)
      have e : ((a * s) ^ (m + 1 + 1)) ^ (p / n) = (a * s) ^ (m + 1) := by
        rw [← Real.rpow_natCast, ← Real.rpow_mul (by positivity)]
        have e' : ((m + 1 + 1 : ℕ) : ℝ) * (p / n) = ((m + 1 : ℕ) : ℝ) := by
          rw [← hn_def]; field_simp; rw [hp_def]; push_cast; ring
        rw [e', Real.rpow_natCast]
      rw [e] at h
      exact h
    -- Step 9: `2cM ≤ 4cn a^{m+2} s^{m+1} = 4cn t s^{m+1} ≤ s^{m+1}` by (ii)
    have h9 : 2 * c * M ≤ s ^ (m + 1) := by
      calc 2 * c * M ≤ 2 * c * (2 * n * a * F ^ (p / n)) := by gcongr
        _ ≤ 2 * c * (2 * n * a * (a * s) ^ (m + 1)) := by gcongr
        _ = 4 * c * n * a ^ (m + 1 + 1) * s ^ (m + 1) := by ring
        _ = 4 * c * n * t * s ^ (m + 1) := by rw [ha_pow]
        _ ≤ 4 * c * n * (1 / (4 * c * n)) * s ^ (m + 1) := by gcongr
        _ = s ^ (m + 1) := by field_simp
    -- Step 10: `(2cM)^{1/p} ≤ (s^{m+1})^{1/(m+1)} = s`
    have h10 := Real.rpow_le_rpow (by positivity) h9 (by positivity : (0 : ℝ) ≤ 1 / p)
    have e : (s ^ (m + 1)) ^ (1 / p) = s := by
      rw [hpinv]; exact Real.pow_rpow_inv_natCast hs (by omega)
    rw [e] at h10
    exact h10
/-- **Simon Ch. 6, proof of 8.2, (1)–(2)** (slices 4.6–4.9 by `f = |· − x₁|`, `Lip f = 1`): for a
cycle `C`, represent `∂C = 0` by the zero measure.  (SL) gives `A_ρ = C⌞B_ρ(x₁)` and `B_ρ = 0`,
`∂A_ρ` vanishes off `∂B_ρ(x₁)` (4.8) and `M(∂A_ρ) ≤ liminf_{h↓0} h⁻¹μ{ρ − h < |x − x₁| < ρ}` (4.9);
(ISP) makes `∂A_ρ` integer multiplicity for `ρ` outside a Lebesgue-null set. -/
theorem Submission.cbrld_sphere_slice_isIntegerMultiplicity : (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → ∀ (P d : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (x₁ : Euclid P), C.boundary = 0 → (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → AEStronglyMeasurable ξ μ → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (C).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B)) → ∃ N : Set ℝ, volume N = 0 ∧ ∀ ρ : ℝ, 0 < ρ → ρ ∉ N → ∃ A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in ball x₁ ρ, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) ∧ IsIntegerMultiplicity A.boundary ∧ A.boundary.support ⊆ sphere x₁ ρ ∧ A.boundary.mass ≤ liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ {x | ρ - h < dist x x₁ ∧ dist x x₁ < ρ}) (𝓝[>] 0) := by
