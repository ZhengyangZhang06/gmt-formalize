      have hc : ‖a (e0 y) * χ (prL y)‖ ≤ A * B := by
        rw [norm_mul, Real.norm_eq_abs]; exact mul_le_mul (haA _) (hB _) (norm_nonneg _) hA
      have e1 := hFj (prL y)
      have e2 := hGj (prL y)
