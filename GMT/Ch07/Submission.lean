      intro x hx
      rcases lt_trichotomy (f x) t with h | h | h
      · exact Or.inl (Or.inl h)
      · exact Or.inl (Or.inr h)
      · exact Or.inr ⟨hx, h⟩
    have hZ_split : (RZ i).measure (ball 0 G) ≤ (RZ i).measure W + (RZ i).measure Lv +
        (RZ i).measure O' :=
      (measure_mono hcover).trans ((measure_union_le _ _).trans
        (add_le_add (measure_union_le _ _) le_rfl))
    -- (R3): `μ_{S_i}(O') ≤ M_{B_G}(S_i) ≤ c_G`
    have hx : (RS i).measure O' ≤ cG := by
      rw [← mS O' hO'_open hO'U]
      exact ((Ss (ψ (φ₁ i))).massOn_mono inter_subset_left).trans hci
    have hl : 1 ≤ ENNReal.ofReal ((1 + η) ^ (m + 1)) :=
      ENNReal.one_le_ofReal.2 (one_le_pow₀ (by linarith))
    refine halg _ _ _ cG _ hx hcG hl ?_
    calc (Ss (ψ (φ₁ i))).massOn W + (RS i).measure O' =
          (RS i).measure W + (RS i).measure O' := by rw [mS W hW_open hWU]
      _ ≤ (RS i).measure (ball 0 G) := hS_split
      _ = (Ss (ψ (φ₁ i))).massOn (ball 0 G) := (mS _ isOpen_ball (hBi i)).symm
      _ ≤ ENNReal.ofReal ((1 + η) ^ (m + 1)) * (Z i).massOn (ball 0 G) := hret
      _ = ENNReal.ofReal ((1 + η) ^ (m + 1)) * (RZ i).measure (ball 0 G) := by
          rw [mZ _ isOpen_ball (hBi i)]
      _ ≤ ENNReal.ofReal ((1 + η) ^ (m + 1)) *
          ((RZ i).measure W + (RZ i).measure Lv + (RZ i).measure O') := by gcongr
      _ ≤ ENNReal.ofReal ((1 + η) ^ (m + 1)) *
          ((S.massOn W + (Sf (φ₁ i)).massOn W) + (Ps i t).massOn W₀ + (RS i).measure O') := by
          refine mul_le_mul' le_rfl (add_le_add (add_le_add ?_ (hZLv i)) (le_of_eq ?_))
          · rw [← mZ W hW_open hWU]
            exact hZW i
          · rw [← mZ O' hO'_open hO'U, hZO i, mS O' hO'_open hO'U]
      _ = ENNReal.ofReal ((1 + η) ^ (m + 1)) *
          (S.massOn W + ((Sf (φ₁ i)).massOn W + (Ps i t).massOn W₀) + (RS i).measure O') := by
          ring
  -- Step 8(f): `e_i = M_W(S'_{φ₁(i)}) + M_{W₀}(P_i) → 0`; let `i → ∞`, then `η ↓ 0`
  have he : Tendsto (fun i => (Sf (φ₁ i)).massOn W + (Ps i t).massOn W₀) atTop (𝓝 0) := by
    have h1 : Tendsto (fun i => (Sf (φ₁ i)).massOn W) atTop (𝓝 0) :=
      tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds (ha.comp hφ₁.tendsto_atTop)
        (fun i => zero_le) fun i => ((Sf (φ₁ i)).massOn_mono hWW₀).trans le_add_self
    have h2 := (h1.add (ENNReal.tendsto_atTop_zero_of_tsum_ne_top htsum))
    rwa [add_zero] at h2
  have hlim_eta : ∀ η : ℝ, 0 < η → limsup (fun i => (Ss (ψ (φ₁ i))).massOn W) atTop ≤
      ENNReal.ofReal ((1 + η) ^ (m + 1)) * S.massOn W +
        (ENNReal.ofReal ((1 + η) ^ (m + 1)) - 1) * cG := by
    intro η hη
    have hev := ((hψ.comp hφ₁).tendsto_atTop.eventually (hπ_lip η hη)).mono fun i hi =>
      hmain η hη i hi
    have h1 : Tendsto (fun i => S.massOn W + ((Sf (φ₁ i)).massOn W + (Ps i t).massOn W₀)) atTop
        (𝓝 (S.massOn W)) := by
      have h := (tendsto_const_nhds (x := S.massOn W)).add he
      rwa [add_zero] at h
    have htend : Tendsto (fun i => ENNReal.ofReal ((1 + η) ^ (m + 1)) *
        (S.massOn W + ((Sf (φ₁ i)).massOn W + (Ps i t).massOn W₀)) +
          (ENNReal.ofReal ((1 + η) ^ (m + 1)) - 1) * cG) atTop
        (𝓝 (ENNReal.ofReal ((1 + η) ^ (m + 1)) * S.massOn W +
          (ENNReal.ofReal ((1 + η) ^ (m + 1)) - 1) * cG)) :=
      (ENNReal.Tendsto.const_mul h1 (Or.inr ENNReal.ofReal_ne_top)).add tendsto_const_nhds
    exact (limsup_le_limsup hev).trans htend.limsup_eq.le
  have hg : Tendsto (fun η : ℝ => ENNReal.ofReal ((1 + η) ^ (m + 1)) * S.massOn W +
      (ENNReal.ofReal ((1 + η) ^ (m + 1)) - 1) * cG) (𝓝[>] 0) (𝓝 (S.massOn W)) := by
    have hc : Continuous fun η : ℝ => ENNReal.ofReal ((1 + η) ^ (m + 1)) :=
      ENNReal.continuous_ofReal.comp ((continuous_const.add continuous_id).pow (m + 1))
    have hl0 := hc.tendsto 0
    simp only [add_zero, one_pow, ENNReal.ofReal_one] at hl0
    have hl := tendsto_nhdsWithin_of_tendsto_nhds (s := Ioi 0) hl0
    have h1 : Tendsto (fun η : ℝ => ENNReal.ofReal ((1 + η) ^ (m + 1)) * S.massOn W) (𝓝[>] 0)
        (𝓝 (1 * S.massOn W)) := ENNReal.Tendsto.mul_const hl (Or.inl one_ne_zero)
    have h2 : Tendsto (fun η : ℝ => (ENNReal.ofReal ((1 + η) ^ (m + 1)) - 1) * cG) (𝓝[>] 0)
        (𝓝 ((1 - 1) * cG)) :=
      ENNReal.Tendsto.mul_const (ENNReal.Tendsto.sub hl (tendsto_const_nhds (x := (1 : ℝ≥0∞)))
        (Or.inl ENNReal.one_ne_top)) (Or.inr hcG)
    have h3 := h1.add h2
    rwa [one_mul, tsub_self, zero_mul, add_zero] at h3
  exact ge_of_tendsto hg (eventually_nhdsWithin_of_forall fun η hη => hlim_eta η hη)

/-- **Compactness of blow-ups** (Lemma BC in the proof of Simon 7.3.1(2); chapter-07.txt lines
302–309, lines 326–345 of the proof and footnote 2, lines 361–364).  If `T` is minimizing in
`U ∩ N`, `spt T ⊆ U ∩ N`, `x ∈ spt T \ spt ∂T` and `Θⁿ(μ_T, x) = θ`, then for `λⱼ > 0`, `λⱼ → 0`,
a subsequence of the blow-ups `Sⱼ = η_{x,λⱼ#}T` converges weakly to an integer multiplicity
`C ∈ 𝒟ₙ(ℝ^{n+k})` with `∂C = 0` that is minimizing in `ℝ^{n+k}`, and `μ_{Sⱼ} → μ_C` for all
representations.  This is the proof of 7.2.4 (lines 157–161 and 176–288) run on the blow-ups, as
in Remark 7.2.5(2) (lines 166–175) with `Nⱼ = η_{x,λⱼ}(N)`.

For `k = 0` this is `dtc_bc_codim_zero` along the whole sequence.  For `k ≥ 1` and `n = m + 1`,
the blow-ups have open exhausting domains, are minimizing in `η_{x,λⱼ}(U ∩ N)` and supported
there, have `M_{B_R(0)}(Sⱼ)` bounded and `∂Sⱼ = 0` in `B_R(0)` for large `j`, and carry
retractions onto `η_{x,λⱼ}(U ∩ N)` with Lipschitz constants tending to `1`
(`dtc_bc_blowUp_hypotheses`, steps 0 and 3).  Truncating at good slicing radii and applying
Federer–Fleming compactness gives `φ`, `C` (integer multiplicity, `∂C = 0`, `S_{φ(j)} ⇀ C`) and the
truncations `Ŝⱼ` (`dtc_bc_truncated_compactness`, step 2).  These hypotheses persist along `φ`, and
comparison with retracted competitors gives, along a further subsequence of any subsequence,
`limsup M_W(S_{φ(j)}) ≤ M_W(S)` for every competitor `S` of `C` near a compact set
(`dtc_bc_local_comparison`, step 4).  This yields the minimality of `C` in `ℝ^{n+k}` and
`μ_{S_{φ(j)}} → μ_C` (`dtc_bc_minimizing_of_local_comparison`, steps 5–6). -/
theorem Submission.dtc_blowUp_compactness : ∀ (n k ℓ : ℕ), ℓ ≤ k → 0 < n → ∀ (U N : Set (Euclid (n + k))) (T : GeometricCurrentOn U n) (x : Euclid (n + k)) (θ : ℝ), IsOpen U → IsEmbeddedSubmanifold 2 (n + ℓ) N → (closure N \ N) ∩ U = ∅ → IsMinimizingIn T (U ∩ N) → T.support ⊆ U ∩ N → x ∈ T.support \ boundarySupport T → HasMassDensity T x θ → ∀ (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), Tendsto lams atTop (𝓝 0) → ∃ (φ : ℕ → ℕ) (C : GeometricCurrentOn (univ : Set (Euclid (n + k))) n), StrictMono φ ∧ ConvergesWeakly (fun j => blowUp T x (lams (φ j)) (hlams (φ j)).ne') C ∧ MassMeasuresConverge (fun j => blowUp T x (lams (φ j)) (hlams (φ j)).ne') C ∧ IsMinimizingIn C univ ∧ BoundaryVanishes C := by
  intro n k ℓ _ hn U N T x θ hU hN _ hmin hspt hx hθ lams hlams hlim
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · -- step 1: codimension zero, along the whole sequence (`Euclid (n + 0)` is `Euclid n`)
    obtain ⟨C, hconv, hmeas, hCmin, hCbd⟩ := Submission.dtc_bc_codim_zero n U T x hn hU hmin.1
      (hspt hx.1).1 hx.2 lams hlams hlim
    exact ⟨id, C, strictMono_id, hconv, hmeas, hCmin, hCbd⟩
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  -- steps 0 and 3: the blow-ups `Sⱼ = η_{x,λⱼ#}T` satisfy the hypotheses of the abstract argument
  obtain ⟨hUo, hUex, hSmin, hSspt, hSmass, hSbd, hπ⟩ :=
    Submission.dtc_bc_blowUp_hypotheses m k ℓ U N T x θ hU hN hmin hspt hx hθ lams hlams hlim
  -- step 2: truncations `Ŝⱼ` and Federer–Fleming compactness give `φ` and `C`
  obtain ⟨φ, C, Ŝ, ρ, hφ, hCim, hCbd, hconv, hŜim, hŜbd, hŜC, hρ, hρU, hŜS⟩ :=
    Submission.dtc_bc_truncated_compactness (m + 1 + k) m (fun j => dilation x (lams j) '' U)
      (fun j => blowUp T x (lams j) (hlams j).ne') (by omega) hUo hUex (fun j => (hSmin j).1)
      hSmass hSbd
  -- the eventual hypotheses persist along `φ`
  have hφ' : Tendsto φ atTop atTop := hφ.tendsto_atTop
  have hmass : ∀ R : ℝ, ∃ c : ℝ≥0∞, c ≠ ∞ ∧ ∀ᶠ j in atTop,
      (blowUp T x (lams (φ j)) (hlams (φ j)).ne').massOn (ball 0 R) ≤ c := by
    intro R
    obtain ⟨c, hc, hev⟩ := hSmass R
    exact ⟨c, hc, hφ'.eventually hev⟩
  have hret : ∀ G : ℝ, 0 < G → ∃ πs : ℕ → Euclid (m + 1 + k) → Euclid (m + 1 + k),
      (∀ᶠ j in atTop, ContDiffOn ℝ 1 (πs j) (ball 0 G) ∧
        MapsTo (πs j) (ball 0 G) (dilation x (lams (φ j)) '' (U ∩ N)) ∧
        (∀ y ∈ dilation x (lams (φ j)) '' (U ∩ N) ∩ ball 0 G, πs j y = y) ∧
        ∀ y ∈ ball 0 G, ‖πs j y‖ ≤ 2 * ‖y‖) ∧
      ∀ η : ℝ, 0 < η → ∀ᶠ j in atTop, ∀ y ∈ ball 0 G, ∀ z ∈ ball 0 G,
        ‖πs j y - πs j z‖ ≤ (1 + η) * ‖y - z‖ := by
    intro G hG
    obtain ⟨πs, hev, hlip⟩ := hπ G hG
    exact ⟨fun j => πs (φ j), hφ'.eventually hev, fun η hη => hφ'.eventually (hlip η hη)⟩
  -- step 4: comparison with retracted competitors along subsequences of `S_{φ(j)}`
  have hcomp := Submission.dtc_bc_local_comparison (m + 1 + k) m
    (fun j => dilation x (lams (φ j)) '' U) (fun j => dilation x (lams (φ j)) '' (U ∩ N))
    (fun j => blowUp T x (lams (φ j)) (hlams (φ j)).ne') Ŝ C ρ (by omega) (fun j => hUo (φ j))
    (fun j => hSmin (φ j)) (fun j => hSspt (φ j)) hmass hret hCim hŜim hŜbd hŜC hρ hρU hŜS
  -- steps 5–6: `C` is minimizing in `ℝ^{n+k}` and `μ_{S_{φ(j)}} → μ_C`
  obtain ⟨hCmin, hmeas⟩ := Submission.dtc_bc_minimizing_of_local_comparison (m + 1 + k) (m + 1)
    (fun j => dilation x (lams (φ j)) '' U) (fun j => blowUp T x (lams (φ j)) (hlams (φ j)).ne')
    C (fun j => hUo (φ j)) (fun R => hφ'.eventually (hUex R)) hCim hconv hcomp
  exact ⟨φ, C, hφ, hconv, hmeas, hCmin, hCbd⟩

/-- **A constant mass ratio about `0` makes `C` a cone** (proof of Simon 7.3.1, chapter-07.txt
lines 336–360, with Ch. 4, 3.6 and Ch. 6, 2.33).  Let `C = τ(M, θ, ξ)` have `∂C = 0`, let
`V = v(M, θ)` be stationary in `ℝᴾ` and `M_{B_ρ(0)}(C) = ωₙρⁿθ₀` for all `ρ > 0`.  Stationarity
along `ℝᴾ` imposes no tangency condition (`γ(t) = y + tv` shows `v ∈ T_y ℝᴾ`), so `δV(X) = 0`
for every `C¹` compactly supported `X`; and `M_{B_ρ(0)}(C) = μ_V(B_ρ(0))` turns the hypothesis
into `μ_V(B_ρ(0)) = aρⁿ` with `a = ωₙθ₀`.  The monotonicity identity then gives `x ∈ TₓM` for
`μ_V`-a.e. `x`, hence `x ∧ C⃗ = 0` `μ_C`-a.e., and Lemma 6.2.33 gives `η_{0,λ#}C = C`. -/
theorem Submission.dtc_cone_of_constant_density : ∀ (P n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n) (θ : ℝ), 0 < n → IsIntegerMultiplicity C → BoundaryVanishes C → (∀ R : IMRep (univ : Set (Euclid P)) n, R.Represents C → R.IsStationaryAlong univ) → (∀ ρ : ℝ, 0 < ρ → C.massOn (ball 0 ρ) = unitBallVolume n * ENNReal.ofReal (ρ ^ n) * ENNReal.ofReal θ) → IsConeCurrent C := by
  intro P n C θ hn hC hbdry hstat hmass
  obtain ⟨R, hR⟩ := hC
  -- `T_y ℝᴾ` contains every `v` (`γ(t) = y + tv`), so `δV(X) = 0` for every `X ∈ C¹_c(ℝᴾ; ℝᴾ)`
  have hvar : ∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X →
      R.firstVariation X = 0 := by
    intro X hX hXc
    refine hstat R hR X hX hXc (subset_univ _) fun y _ => ?_
    refine ⟨fun t => y + t • X y, (contDiff_const.add (contDiff_id.smul contDiff_const)).contDiffOn,
      mapsTo_univ _ _, by simp, ?_⟩
    simpa using ((hasDerivAt_id (0 : ℝ)).smul_const (X y)).const_add y
  -- `μ_V(B_ρ(0)) = M_{B_ρ(0)}(C) = (ωₙθ₀)ρⁿ`
  have hball : ∀ ρ : ℝ, 0 < ρ →
      R.measure (ball 0 ρ) = unitBallVolume n * ENNReal.ofReal θ * ENNReal.ofReal (ρ ^ n) := by
    intro ρ hρ
    rw [← Submission.dtc_mass_eq_measure P n univ (ball 0 ρ) C R isOpen_univ isOpen_ball
      (subset_univ _) hR, hmass ρ hρ, mul_right_comm]
  -- `x ∈ TₓM` for `μ_V`-a.e. `x`, so `x ∧ C⃗ = 0` `μ_C`-a.e., so `C` is a cone (Lemma 6.2.33)
  exact Submission.dtc_cone_of_wedge_vanishing P n C R hn hR hbdry
    (Submission.dtc_cone_wedge_vanishes P n univ R
      (Submission.dtc_cone_radial_tangency P n R (unitBallVolume n * ENNReal.ofReal θ) hvar hball))

/-- **Simon 7.3.1 (Theorem, p. 187)**: densities and tangent cones of minimizing currents (proof:
chapter-07.txt lines 302–364, with (1) on `U \ spt ∂T` and (2) at `x ∈ spt T \ spt ∂T`, README
erratum 3).  For `n = 0`, `T = 0` (`dtc_dim_zero_eq_zero`): `Θ ≡ 0` and (2) is vacuous.  For
`n > 0`, the restriction `T'` of `T` to `U' = U \ spt ∂T` is a minimizing cycle in `U ∩ N` with the
masses of `T` on subsets of `U'` (`dtc_localize`), so by 7.1.2 (`minimizing_implies_stationary`)
its varifold has locally bounded mean curvature and the monotonicity formula gives the density `Θ`
of `T'`, upper semicontinuous on `U'` (`dtc_density_usc`); `Θ` is also the density of `T`, since
`M_{B_ρ(x)}(T') = M_{B_ρ(x)}(T)` once `B_ρ(x) ⊆ U'`.  At `x ∈ spt T \ spt ∂T`, a subsequence of the
blow-ups `η_{x,λⱼ#}T` converges to a minimizing cycle `C` in `ℝ^{n+k}` with `μ_{η_{x,λⱼ#}T} → μ_C`
(`dtc_blowUp_compactness`), whence `M_{B_ρ(0)}(C) = ωₙρⁿΘ(x)` for every `ρ > 0` and
`Θⁿ(μ_C, 0) = Θ(x)` (`dtc_blowUp_density`, book (1)–(4)).  `C` is stationary in `ℝ^{n+k}` (7.1.2
with `N = U = ℝ^{n+k}`, the identity chart), so its constant density ratio makes it a cone
(`dtc_cone_of_constant_density`). -/
theorem Submission.density_and_tangent_cones : DensityAndTangentCones := by
  intro n k ℓ hℓ U N T hU hN hNU hmin hspt
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · -- Step 1: `n = 0`, so `T = 0`, `Θ ≡ 0`, and (2) is vacuous
    obtain ⟨-, hsupp, hmass⟩ := Submission.dtc_dim_zero_eq_zero (0 + k) U (U ∩ N) T hU hmin hspt
    refine ⟨⟨fun _ => 0, fun x _ => ⟨le_rfl, ?_⟩, upperSemicontinuousOn_const⟩, fun x hx => ?_⟩
    · simp only [hmass, ENNReal.zero_div, ENNReal.ofReal_zero]
      exact tendsto_const_nhds
    · rw [hsupp] at hx
      exact absurd hx.1 (Set.notMem_empty x)
  -- Step 2: `T' = T⌞U'`, `U' = U \ spt ∂T`, is a minimizing cycle with the masses of `T`
  obtain ⟨hU', hmin', hbd', hspt', hmass'⟩ :=
    Submission.dtc_localize (n + k) n U (U ∩ N) T hU hn hmin
  have hNU' : (closure N \ N) ∩ (U \ boundarySupport T) = ∅ :=
    subset_empty_iff.mp ((inter_subset_inter_right _ Set.sdiff_subset).trans hNU.subset)
  have hminN : IsMinimizingIn (T.restrictDomain (Set.sdiff_subset : U \ boundarySupport T ⊆ U))
      (N ∩ (U \ boundarySupport T)) := by
    refine ⟨hmin'.1, fun W S hW hWc hS hSbd hSc hSA => hmin'.2 W S hW hWc hS hSbd hSc ?_⟩
    exact hSA.trans (inter_subset_inter_left W fun y hy => ⟨hy.2.1, hy.1⟩)
  -- Step 3: by 7.1.2 the varifold of `T'` has locally bounded mean curvature in `U'`, so the
  -- density `Θ` of `T'` exists and is upper semicontinuous on `U'`
  obtain ⟨R', hR'⟩ := hmin'.1
  have hH := (Submission.minimizing_implies_stationary n k ℓ hℓ (U \ boundarySupport T) N
    (T.restrictDomain (Set.sdiff_subset : U \ boundarySupport T ⊆ U)) hU' hN hNU'
    (hspt'.trans fun y hy => (hspt hy).2) hminN hbd' R' hR').2
  obtain ⟨Θ, hΘ', hΘusc⟩ :=
    Submission.dtc_density_usc (n + k) n (U \ boundarySupport T) _ R' hU' hn hR' hH
  -- `Θ` is the density of `T` on `U'`: `M_{B_ρ(x)}(T') = M_{B_ρ(x)}(T)` once `B_ρ(x) ⊆ U'`
  have hΘ : ∀ x ∈ U \ boundarySupport T, HasMassDensity T x (Θ x) := by
    intro x hx
    obtain ⟨hΘ0, hlim⟩ := hΘ' x hx
    refine ⟨hΘ0, hlim.congr' ?_⟩
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hU' x hx
    filter_upwards [Ioo_mem_nhdsGT hε] with ρ hρ
    rw [hmass' _ ((ball_subset_ball hρ.2.le).trans hball)]
  refine ⟨⟨Θ, hΘ, hΘusc⟩, fun x hx lams hlams hlim => ?_⟩
  have hxU : x ∈ U := (hspt hx.1).1
  have hxΘ : HasMassDensity T x (Θ x) := hΘ x ⟨hxU, hx.2⟩
  -- Step 4: a subsequence of the blow-ups converges to a minimizing cycle `C`, with mass measures
  obtain ⟨φ, C, hφ, hconv, hmeas, hCmin, hCbd⟩ := Submission.dtc_blowUp_compactness n k ℓ hℓ hn
    U N T x (Θ x) hU hN hNU hmin hspt hx hxΘ lams hlams hlim
  -- Step 5: `M_{B_ρ(0)}(C) = ωₙρⁿΘ(x)` for every `ρ > 0`, and `Θⁿ(μ_C, 0) = Θ(x)`
  obtain ⟨hCball, hCdens⟩ := Submission.dtc_blowUp_density (n + k) n U T C x (Θ x)
    (fun j => lams (φ j)) (fun j => hlams (φ j)) hU hn hxU hmin.1 hCmin.1
    (hlim.comp hφ.tendsto_atTop) hxΘ hmeas
  -- Step 6: `C` is stationary in `ℝ^{n+k}` (7.1.2 with `N = U = ℝ^{n+k}`), hence a cone
  have huniv : IsEmbeddedSubmanifold 2 (n + k) (univ : Set (Euclid (n + k))) := by
    intro y _
    refine ⟨univ, univ, id, isOpen_univ, isOpen_univ, mem_univ y, contDiff_id.contDiffOn,
      injOn_id _, by simp, fun K _ hK => by simpa using hK, fun z _ => ?_⟩
    rw [fderiv_id]
    exact fun a b h => h
  have hCstat : ∀ R : IMRep (univ : Set (Euclid (n + k))) n, R.Represents C →
      R.IsStationaryAlong univ := fun R hR =>
    (Submission.minimizing_implies_stationary n k k le_rfl univ univ C isOpen_univ huniv
      (by simp) (subset_univ _) (by simpa using hCmin) hCbd R hR).1
  exact ⟨φ, C, hφ, hconv, hmeas, hCmin,
    Submission.dtc_cone_of_constant_density (n + k) n C (Θ x) hn hCmin.1 hCbd hCstat hCball,
    Θ x, hxΘ, hCdens⟩

/-- **Simon 7.3.1 (Theorem, p. 187)** (chapter-07.txt lines 302–364; (1) on `U \ spt ∂T` and (2)
at `x ∈ spt T \ spt ∂T`, README erratum 3): densities exist and are upper semicontinuous off
`spt ∂T`, and blow-ups at `x ∈ spt T \ spt ∂T` subconverge, with their mass measures, to minimizing
cones `C` with `Θⁿ(μ_C, 0) = Θⁿ(μ_T, x)`.  The type is that of `Submission.density_and_tangent_cones`
(DAG node `root.density_and_tangent_cones-a1`), which carries out the frozen proof's seven steps
with 7.1.2 in the role of the stationarity sibling; as the frozen proof's registration note
provides, this inherited prerequisite is reused at its identical type. -/
theorem Submission.idtp_cttp_ctc_density_tangent_cones : DensityAndTangentCones :=
  Submission.density_and_tangent_cones

/-- **Tangent cones of minimizing cycles in `ℝᴾ`** (Simon 7.3.1(2), chapter-07.txt lines 302–309,
with the density bound of Ch. 4, 3.13).  Let `C ∈ 𝒟ₙ(ℝᴾ)`, `n ≥ 1`, be minimizing in `ℝᴾ` with
`∂C = 0`, let `p ∈ spt C` and `λⱼ > 0`, `λⱼ → 0`.  If `P < n`, every `n`-covector on `ℝᴾ`
vanishes, so `C` kills every test form and `spt C = ∅` (`rsd_cmr_support_subset_of_vanish`);
hence `P = n + k`.  With `U = N = ℝⁿ⁺ᵏ` (the identity chart) and `spt ∂C = spt 0 = ∅`, Simon 7.3.1
(`idtp_cttp_ctc_density_tangent_cones`) gives a density `Θ` of `C`, upper semicontinuous on `ℝᴾ`,
and at `p` a subsequence `λ_{φ(j)}` and a minimizing cone `C'` with `η_{p,λ_{φ(j)}#}C ⇀ C'`,
`μ_{η_{p,λ_{φ(j)}#}C} → μ_{C'}` and `Θⁿ(μ_C, p) = Θⁿ(μ_{C'}, 0) = θ`.  For a representation
`C = τ(M, ϑ, ξ)`, `M_W(C) = μ_C(W)` with `μ_C = ϑHⁿ⌞M` and `spt C = spt μ_C`
(`dimred_im_mass_measure`), and the density of `μ_C` is `≥ 1` `μ_C`-a.e.
(`dimred_mono_ae_ball_density_ge_one`), so upper semicontinuity of `Θ` gives `θ ≥ 1`
(`dimred_mono_support_density_ge_one_of_usc`).  Finally `∂C' = 0`, `C'` being a weak limit of
blow-ups of the cycle `C` (`idtp_tpf_blowUp_limit_boundaryVanishes`). -/
theorem Submission.idtp_cttp_cycle_tangent_cone : ∀ (P n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n), 1 ≤ n → IsMinimizingIn C univ → BoundaryVanishes C → ∀ p ∈ C.support, ∀ (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), Tendsto lams atTop (𝓝 0) → ∃ (φ : ℕ → ℕ) (C' : GeometricCurrentOn (univ : Set (Euclid P)) n) (θ : ℝ), StrictMono φ ∧ ConvergesWeakly (fun j => blowUp C p (lams (φ j)) (hlams (φ j)).ne') C' ∧ MassMeasuresConverge (fun j => blowUp C p (lams (φ j)) (hlams (φ j)).ne') C' ∧ IsMinimizingIn C' univ ∧ IsConeCurrent C' ∧ BoundaryVanishes C' ∧ 1 ≤ θ ∧ HasMassDensity C p θ ∧ HasMassDensity C' 0 θ := by
  intro P n C hn hmin hbd p hp lams hlams hlim
  -- Step 1: `n ≤ P`; otherwise `n > P` vectors are dependent, every `n`-covector vanishes, `C`
  -- kills every test form and `spt C = ∅`
  have hnP : n ≤ P := by
    by_contra! hPn
    have hcov : ∀ α : Covector (Euclid P) n, α = 0 := fun α => by
      ext v
      refine α.toAlternatingMap.map_linearDependent v fun hv => ?_
      have hcard := hv.fintype_card_le_finrank
      rw [Fintype.card_fin, finrank_euclideanSpace_fin] at hcard
      omega
    refine Set.notMem_empty p ((Submission.rsd_cmr_support_subset_of_vanish P n univ ∅ C
      isOpen_univ isCompact_empty (empty_subset _) fun ω _ => ?_).1 hp)
    rw [show ω = 0 from Subtype.ext (funext fun x => (hcov _).trans (hcov _).symm)]
    exact map_zero C.toCurrent
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hnP
  -- Step 2: `ℝⁿ⁺ᵏ` is an embedded `C²` `(n + k)`-submanifold of itself (the identity chart)
  have huniv : IsEmbeddedSubmanifold 2 (n + k) (univ : Set (Euclid (n + k))) := by
    intro y _
    refine ⟨univ, univ, id, isOpen_univ, isOpen_univ, mem_univ y, contDiff_id.contDiffOn,
      injOn_id _, by simp, fun K _ hK => by simpa using hK, fun z _ => ?_⟩
    rw [fderiv_id]
    exact fun a b h => h
  -- Step 3: `spt ∂C = spt 0 = ∅`
  have hbsupp : boundarySupport C = ∅ := by
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
    change C.boundary = 0 at hbd
    change C.boundary.support = ∅
    rw [hbd]
    exact subset_empty_iff.mp (Submission.rsd_cmr_support_subset_of_vanish (m + 1 + k) m univ ∅ 0
      isOpen_univ isCompact_empty (empty_subset _) fun ω _ => GeometricCurrentOn.zero_apply ω).1
  -- Step 4: Simon 7.3.1 with `U = N = ℝⁿ⁺ᵏ`, `ℓ = k`: the density `Θ` of `C`, upper
  -- semicontinuous on `ℝⁿ⁺ᵏ \ spt ∂C = ℝⁿ⁺ᵏ`, and at `p` the minimizing cone `C'`
  obtain ⟨⟨Θ, hΘ, hΘusc⟩, htan⟩ := Submission.idtp_cttp_ctc_density_tangent_cones n k k le_rfl
    univ univ C isOpen_univ huniv (by simp) (by rwa [Set.inter_self]) (by simp)
  rw [hbsupp, Set.sdiff_empty] at hΘ hΘusc
  obtain ⟨φ, C', hφ, hconv, hmeas, hC'min, hC'cone, θ, hθC, hθC'⟩ :=
    htan p ⟨hp, by rw [hbsupp]; exact Set.notMem_empty p⟩ lams hlams hlim
  -- Step 5: `θ ≥ 1`: for `C = τ(M, ϑ, ξ)`, `M_W(C) = μ_C(W)`, `spt C = spt μ_C`, the density of
  -- `μ_C` is `≥ 1` `μ_C`-a.e., and `Θ` is upper semicontinuous
  obtain ⟨R, hR⟩ := hmin.1
  obtain ⟨hmass, hsupp, -⟩ := Submission.dimred_im_mass_measure (n + k) n univ C R isOpen_univ hR
  have hθ1 : 1 ≤ θ := Submission.dimred_mono_support_density_ge_one_of_usc (n + k) n univ C
    R.measure Θ isOpen_univ hmass (fun x hx => (hsupp x (mem_univ x)).1 hx)
    (Submission.dimred_mono_ae_ball_density_ge_one (n + k) n univ R isOpen_univ) hΘ hΘusc p hp θ
    hθC
  -- Step 6: `∂C' = 0`, `C'` being the weak limit of the blow-ups `η_{p,λ_{φ(j)}#}C` of a cycle
  have hC'bd : BoundaryVanishes C' := Submission.idtp_tpf_blowUp_limit_boundaryVanishes (n + k) n
    univ C p (fun j => lams (φ j)) (fun j => hlams (φ j)) C' isOpen_univ (mem_univ p) hbd
    (hlim.comp hφ.tendsto_atTop) hconv
  exact ⟨φ, C', θ, hφ, hconv, hmeas, hC'min, hC'cone, hC'bd, hθ1, hθC, hθC'⟩
/-- **`Hⁿ` of a disc in the span of an orthonormal family**: if `τ₁, …, τₙ` are orthonormal in
`ℝᴾ`, `Q = span{τ₁, …, τₙ}`, `y ∈ Q` and `ρ > 0`, then `Hⁿ(B_ρ(y) ∩ Q) = ωₙρⁿ`.  The map
`ψ(a) = Σᵢ aᵢτᵢ` is a linear isometry `ℝⁿ → ℝᴾ` with range `Q`, so `ψ(B_ρ(b)) = B_ρ(y) ∩ Q` for
`y = ψ(b)`; `Hⁿ` is invariant under isometries and equals Lebesgue measure on `ℝⁿ`, and
`Lⁿ(B_ρ(b)) = ρⁿ Lⁿ(B₁(0))`. -/
theorem Submission.idtp_cttp_span_ball_measure : ∀ (P n : ℕ) (τ : Fin n → Euclid P), Orthonormal ℝ τ → ∀ y ∈ Submodule.span ℝ (Set.range τ), ∀ ρ : ℝ, 0 < ρ → μHE[n] (ball y ρ ∩ (Submodule.span ℝ (Set.range τ) : Set (Euclid P))) = unitBallVolume n * ENNReal.ofReal (ρ ^ n) := by
  intro P n τ hτ y hy ρ hρ
  -- Step 1: `ψ(a) = Σᵢ aᵢτᵢ` is a linear isometry `ℝⁿ → ℝᴾ`
  let f : Euclid n →ₗ[ℝ] Euclid P :=
    (Fintype.linearCombination ℝ τ).comp (WithLp.linearEquiv 2 ℝ (Fin n → ℝ)).toLinearMap
  have hf : ∀ a, f a = ∑ i, a i • τ i := fun a => by
    simp [f, Fintype.linearCombination_apply]
  -- the basis `v` is passed explicitly: leaving it implicit makes unification time out
  let v : Module.Basis (Fin n) ℝ (Euclid n) := (EuclideanSpace.basisFun (Fin n) ℝ).toBasis
  have hv : Orthonormal ℝ v := by
    rw [OrthonormalBasis.coe_toBasis]
    exact (EuclideanSpace.basisFun (Fin n) ℝ).orthonormal
  have hfv : f ∘ v = τ := by
    funext i
    simp [hf, v]
  let ψ : Euclid n →ₗᵢ[ℝ] Euclid P := f.isometryOfOrthonormal hv (by rw [hfv]; exact hτ)
  have hψ : ∀ a, ψ a = ∑ i, a i • τ i := fun a => by
    rw [LinearMap.coe_isometryOfOrthonormal, hf]
  -- Step 2: `range ψ = Q`
  have hrange : range ψ = (Submodule.span ℝ (range τ) : Set (Euclid P)) := by
    ext z
    constructor
    · rintro ⟨a, rfl⟩
      rw [hψ]
      exact Submodule.sum_mem _ fun i _ =>
        Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
    · intro hz
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp hz
      exact ⟨WithLp.toLp 2 c, by rw [hψ]; simpa using hc⟩
  -- Step 3: `ψ(B_ρ(b)) = B_ρ(y) ∩ Q`, where `y = ψ(b)`
  obtain ⟨b, rfl⟩ : y ∈ range ψ := by rw [hrange]; exact hy
  have himage : ψ '' ball b ρ =
      ball (ψ b) ρ ∩ (Submodule.span ℝ (range τ) : Set (Euclid P)) := by
    rw [← hrange]
    ext z
    constructor
    · rintro ⟨a, ha, rfl⟩
      exact ⟨by rw [mem_ball, ψ.isometry.dist_eq]; exact ha, ⟨a, rfl⟩⟩
    · rintro ⟨hz, ⟨a, rfl⟩⟩
      exact ⟨a, by rw [mem_ball, ← ψ.isometry.dist_eq]; exact hz, rfl⟩
  -- Step 4: isometry invariance of `Hⁿ`, `Hⁿ = Lⁿ` on `ℝⁿ`, and scaling of Haar measure of balls
  rw [← himage, ψ.isometry.euclideanHausdorffMeasure_image,
    EuclideanSpace.euclideanHausdorffMeasure_eq_volume, Measure.addHaar_ball_of_pos _ _ hρ,
    finrank_euclideanSpace_fin, mul_comm]
  rfl

/-- **Reduction of the constancy of an integer density on a plane to `ℝⁿ`** (steps 3 and 6–8 of
the planar constancy step in the integer density of tangent planes, Simon 7.3).  Let
`ι(s) = ∑ᵢ sᵢτᵢ` for an orthonormal family `τ`, `Q = span τ`, `Ω = ι⁻¹(V)` and `h = g ∘ ι`.
Since `Hⁿ⌞Q = ι_#Lⁿ` and the isometry `ι` is a measurable embedding, restricted measures,
integrals, a.e. statements and a.e.-measurability transfer between `V ∩ Q` and `Ω`.  So `Ω` is open,
`Ω = ι*(V ∩ Q)` is connected (`ι*(y) = (⟨τₖ, y⟩)ₖ` is a left inverse of `ι`, and `ι ∘ ι* = id` on
`Q`), and `h` is locally integrable on `Ω`.  A smooth test `ψ` in `Ω` extends to a smooth test `f`
in `V` with `D_{τⱼ}f ∘ ι = ∂ⱼψ`, so `∫_Ω h ∂ⱼψ = ∫_{V∩Q} g D_{τⱼ}f dHⁿ = 0`, and `C¹` tests follow.
Finally, if `h = c₀` a.e. on `Ω`, then `c₀ ∈ ℤ` (`h` is integer valued a.e. and `Lⁿ(Ω) > 0`), and
`g = c₀` `Hⁿ`-a.e. on `V ∩ Q`. -/
theorem Submission.idtp_pc_constancy_reduction : ∀ (P n : ℕ) (V : Set (Euclid P)) (τ : Fin n → Euclid P) (g : Euclid P → ℝ), IsOpen V → Orthonormal ℝ τ → IsConnected (V ∩ (Submodule.span ℝ (Set.range τ) : Set (Euclid P))) → AEStronglyMeasurable g (μHE[n].restrict (Submodule.span ℝ (Set.range τ) : Set (Euclid P))) → (∀ᵐ x ∂(μHE[n].restrict (Submodule.span ℝ (Set.range τ) : Set (Euclid P))), ∃ m : ℤ, g x = m) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ V → ∫⁻ x in K ∩ (Submodule.span ℝ (Set.range τ) : Set (Euclid P)), ‖g x‖ₑ ∂μHE[n] ≠ ∞) → (∀ f : Euclid P → ℝ, ContDiff ℝ (⊤ : ℕ∞) f → HasCompactSupport f → tsupport f ⊆ V → ∀ j : Fin n, ∫ x in V ∩ (Submodule.span ℝ (Set.range τ) : Set (Euclid P)), g x * fderiv ℝ f x (τ j) ∂μHE[n] = 0) → IsOpen {s : Euclid n | ∑ i, s i • τ i ∈ V} ∧ IsPreconnected {s : Euclid n | ∑ i, s i • τ i ∈ V} ∧ LocallyIntegrableOn (fun s : Euclid n => g (∑ i, s i • τ i)) {s : Euclid n | ∑ i, s i • τ i ∈ V} volume ∧ (∀ φ : Euclid n → ℝ, ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ {s : Euclid n | ∑ i, s i • τ i ∈ V} → ∀ i : Fin n, ∫ s, g (∑ k, s k • τ k) * fderiv ℝ φ s ((EuclideanSpace.basisFun (Fin n) ℝ) i) = 0) ∧ ∀ c₀ : ℝ, (∀ᵐ s ∂(volume.restrict {s : Euclid n | ∑ i, s i • τ i ∈ V}), g (∑ i, s i • τ i) = c₀) → ∃ c : ℤ, ∀ᵐ x ∂(μHE[n].restrict (V ∩ (Submodule.span ℝ (Set.range τ) : Set (Euclid P)))), g x = c := by
  intro P n V τ g hV hτ hconn hgm hgint hgloc hweak
  -- the parametrization `ι = L`: a linear isometry, hence a measurable embedding
  let L : Euclid n →ₗ[ℝ] Euclid P :=
    { toFun := fun s => ∑ i, s i • τ i
      map_add' := fun s t => by simp [add_smul, Finset.sum_add_distrib]
      map_smul' := fun c s => by simp [Finset.smul_sum, smul_smul] }
  have hLapp : ∀ s, L s = ∑ i, s i • τ i := fun s => rfl
  have hnorm : ∀ s, ‖L s‖ = ‖s‖ := by
    intro s
    have h1 : ‖L s‖ ^ 2 = ‖s‖ ^ 2 := by
      rw [hLapp, ← real_inner_self_eq_norm_sq, hτ.inner_sum, EuclideanSpace.norm_eq,
        Real.sq_sqrt (Finset.sum_nonneg fun i _ => sq_nonneg _)]
      simp [sq]
    exact (pow_left_inj₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).mp h1
  have hiso : Isometry L := AddMonoidHomClass.isometry_of_norm L hnorm
  have hcont : Continuous L := hiso.continuous
  have hemb : MeasurableEmbedding L := hiso.isClosedEmbedding.measurableEmbedding
  have hinj : Injective L := hiso.injective
  set Q : Set (Euclid P) := (Submodule.span ℝ (Set.range τ) : Set (Euclid P)) with hQ
  -- step 1: `Hⁿ⌞Q = ι_#Lⁿ`, so `Hⁿ⌞(A ∩ Q) = ι_#(Lⁿ⌞ι⁻¹(A))` for measurable `A`
  have hmap : (μHE[n] : Measure (Euclid P)).restrict Q = Measure.map L volume :=
    Submission.idtp_pc_plane_hausdorff_eq_map P n τ hτ
  have htr : ∀ A : Set (Euclid P), MeasurableSet A →
      (μHE[n] : Measure (Euclid P)).restrict (A ∩ Q) =
        Measure.map L (volume.restrict (L ⁻¹' A)) := by
    intro A hA
    rw [← Measure.restrict_restrict hA, hmap, hemb.restrict_map]
  -- step 2: `Ω = ι⁻¹(V)` is open
  set Ω : Set (Euclid n) := {s : Euclid n | ∑ i, s i • τ i ∈ V} with hΩ
  have hΩo : IsOpen Ω := hV.preimage hcont
  -- step 3: the left inverse `ι*(y) = (⟨τₖ, y⟩)ₖ` maps `V ∩ Q` onto `Ω`, so `Ω` is connected
  let Ls : Euclid P → Euclid n :=
    fun y => (WithLp.equiv 2 (Fin n → ℝ)).symm (fun k => inner ℝ (τ k) y)
  have hLscont : Continuous Ls := by
    refine (PiLp.continuous_toLp 2 _).comp ?_
    exact continuous_pi fun k => continuous_const.inner continuous_id
  have hLsL : ∀ s, Ls (L s) = s := by
    intro s
    ext k
    simp [Ls, hLapp, hτ.inner_right_fintype]
  have hrangeL : ∀ y ∈ Q, L (Ls y) = y := by
    intro y hy
    obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp hy
    have : Ls (∑ i, c i • τ i) = (WithLp.equiv 2 (Fin n → ℝ)).symm c := by
      ext k
      simp [Ls, hτ.inner_right_fintype]
    rw [this]
    simp [hLapp]
  have hLmemQ : ∀ s, L s ∈ Q := by
    intro s
    rw [hLapp]
    exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  have himage : Ls '' (V ∩ Q) = Ω := by
    ext s
    constructor
    · rintro ⟨y, ⟨hyV, hyQ⟩, rfl⟩
      show L (Ls y) ∈ V
      rw [hrangeL y hyQ]; exact hyV
    · intro hs
      exact ⟨L s, ⟨hs, hLmemQ s⟩, hLsL s⟩
  have hΩc : IsPreconnected Ω := by
    rw [← himage]
    exact hconn.isPreconnected.image Ls hLscont.continuousOn
  -- step 4: `h = g ∘ ι` is a.e.-strongly measurable, and `∫_{K'} |h| = ∫_{ι(K') ∩ Q} |g| dHⁿ < ∞`
  -- for compact `K' ⊆ Ω`
  have hgm' : AEStronglyMeasurable (fun s => g (L s)) volume := by
    have : AEStronglyMeasurable g (Measure.map L volume) := hmap ▸ hgm
    exact (hemb.aestronglyMeasurable_map_iff).mp this
  have hloc : LocallyIntegrableOn (fun s : Euclid n => g (∑ i, s i • τ i)) Ω volume := by
    refine (locallyIntegrableOn_iff hΩo.isLocallyClosed).mpr fun k hkΩ hk => ?_
    refine ⟨hgm'.restrict, ?_⟩
    have hKc : IsCompact (L '' k) := hk.image hcont
    have hKV : L '' k ⊆ V := by
      rintro _ ⟨s, hs, rfl⟩; exact hkΩ hs
    have hfin := hgloc (L '' k) hKc hKV
    have h1 : ∫⁻ x in L '' k ∩ Q, ‖g x‖ₑ ∂μHE[n] = ∫⁻ s in k, ‖g (L s)‖ₑ := by
      rw [htr _ hKc.isClosed.measurableSet, hemb.lintegral_map, hinj.preimage_image]
    show ∫⁻ s in k, ‖g (L s)‖ₑ < ∞
    rw [← h1]
    exact lt_top_iff_ne_top.mpr hfin
  -- step 5: for a smooth test `ψ` in `Ω`, `∫_Ω h ∂ⱼψ = ∫_{V∩Q} g D_{τⱼ}f dHⁿ = 0`, where `f` is
  -- the extension of `ψ` to a smooth test in `V`
  have hsmooth : ∀ a : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) a → HasCompactSupport a →
      tsupport a ⊆ Ω → ∀ j : Fin n,
        ∫ v in Ω, g (∑ i, v i • τ i) * fderiv ℝ a v (EuclideanSpace.single j (1 : ℝ)) = 0 := by
    intro a ha hac has j
    obtain ⟨f, hf, hfc, hfV, hfa⟩ :=
      Submission.idtp_pc_plane_test_extension P n V τ a hV hτ ha hac has
    have h0 := hweak f hf hfc hfV j
    have h2 : ∫ x in V ∩ Q, g x * fderiv ℝ f x (τ j) ∂μHE[n] =
        ∫ s in Ω, g (L s) * fderiv ℝ f (L s) (τ j) := by
      rw [htr V hV.measurableSet, hemb.integral_map]
      rfl
    rw [h2] at h0
    rw [← h0]
    refine setIntegral_congr_fun hΩo.measurableSet fun s _ => ?_
    simp only [hLapp] at *
    rw [(hfa s).2 j]
  -- step 6: `C¹` tests, by mollification
  refine ⟨hΩo, hΩc, hloc, Submission.dgcr_smooth_tests_to_C1_tests n Ω _ hΩo hloc hsmooth, ?_⟩
  -- step 7: `h = c₀` a.e. on `Ω` forces `c₀ ∈ ℤ`; transfer `g = c₀` back to `V ∩ Q`
  intro c₀ hc₀
  have hne : Ω.Nonempty := by
    rw [← himage]; exact hconn.nonempty.image Ls
  have hint' : ∀ᵐ s ∂(volume : Measure (Euclid n)), ∃ m : ℤ, g (L s) = m := by
    have : ∀ᵐ x ∂(Measure.map L (volume : Measure (Euclid n))), ∃ m : ℤ, g x = m := hmap ▸ hgint
    exact (hemb.ae_map_iff).mp this
  have hpos : (volume : Measure (Euclid n)) Ω ≠ 0 := (hΩo.measure_pos volume hne).ne'
  obtain ⟨s, -, hs1, m, hm⟩ := Measure.exists_mem_of_measure_ne_zero_of_ae hpos
    (hc₀.and (ae_restrict_of_ae hint'))
  have hc : c₀ = m := hs1.symm.trans hm
  refine ⟨m, ?_⟩
  rw [htr V hV.measurableSet, hemb.ae_map_iff]
  filter_upwards [hc₀] with s hs
  rw [← hc]; exact hs
/-- **Constancy theorem for an integer multiplicity cycle carried by an `n`-plane** (Simon Ch. 6,
Theorem 2.34, as applied to currents in a plane in the deformation theorem, Ch. 6, (26)–(27)).
Let `τ` be orthonormal, `Q = span{τ₁, …, τₙ}`, `n ≥ 1`, and let `S ∈ 𝒟ₙ(V)` be integer
multiplicity with `∂S = 0` in `V`, `spt S ⊆ Q` and `V ∩ Q` connected.  Then `S = c[[Q]]` in `V`
for some `c ∈ ℤ`: `S(ω) = c ∫_{V∩Q} ω(x)(τ₁, …, τₙ) dHⁿ(x)`, and `M_W(S) = |c| Hⁿ(W ∩ Q)` for open
`W ⊆ V`.  `S(ω) = ∫_{V∩Q} g ω(τ) dHⁿ` and `M_W(S) = ∫_{W∩Q} |g| dHⁿ` for an integer-valued,
locally `Hⁿ`-integrable signed density `g`; `∂S = 0` kills the weak derivatives of `h = g ∘ ι`,
`ι(s) = Σᵢ sᵢτᵢ`, on the connected open set `Ω = ι⁻¹(V)`.  By distributional constancy
`h = c₀` a.e. on `Ω`, so `g = c ∈ ℤ` `Hⁿ`-a.e. on `V ∩ Q`. -/
theorem Submission.idtp_planar_cycle_eq_const_mul : ∀ (P n : ℕ) (V : Set (Euclid P)) (S : GeometricCurrentOn V n) (τ : Fin n → Euclid P), 1 ≤ n → IsOpen V → Orthonormal ℝ τ → IsIntegerMultiplicity S → BoundaryVanishes S → S.support ⊆ (Submodule.span ℝ (Set.range τ) : Set (Euclid P)) → IsConnected (V ∩ (Submodule.span ℝ (Set.range τ) : Set (Euclid P))) → ∃ c : ℤ, (∀ ω : TestFormOn V n, S ω = (c : ℝ) * ∫ x in V ∩ (Submodule.span ℝ (Set.range τ) : Set (Euclid P)), (ω : DifferentialForm (Euclid P) n) x τ ∂μHE[n]) ∧ ∀ W : Set (Euclid P), IsOpen W → W ⊆ V → S.massOn W = (c.natAbs : ℝ≥0∞) * μHE[n] (W ∩ (Submodule.span ℝ (Set.range τ) : Set (Euclid P))) := by
  intro P n V S τ hn hV hτ hIM hbd hspt hconn
  -- steps 1–5: the integer-valued signed density `g` on `Q`, with `S(ω) = ∫_{V∩Q} g ω(τ) dHⁿ`
  -- and `M_W(S) = ∫_{W∩Q} |g| dHⁿ`
  obtain ⟨g, hgm, hgZ, hgK, hSg, hmass⟩ :=
    Submission.idtp_pc_signed_density P n V S τ hV hτ hIM hspt
  -- step 6: `∂S = 0` gives `∫_{V∩Q} g D_{τⱼ}f dHⁿ = 0` for every `f ∈ C^∞_c(V)`
  have hweak := Submission.idtp_pc_boundary_weak_derivative P n V S τ g hn hτ hbd hSg
  -- `h = g ∘ ι` on `Ω = ι⁻¹(V)`: `Ω` is open and connected, `h ∈ L¹_loc(Ω)` and `∫_Ω h ∂ᵢφ = 0`
  -- for every `φ ∈ C¹_c(Ω)`
  obtain ⟨hΩ, hΩc, hloc, hC1, hconst⟩ :=
    Submission.idtp_pc_constancy_reduction P n V τ g hV hτ hconn hgm hgZ hgK hweak
  -- step 7: distributional constancy, `h = c₀` a.e. on `Ω`; so `g = c ∈ ℤ` `Hⁿ`-a.e. on `V ∩ Q`
  obtain ⟨c₀, hc₀⟩ :=
    Poincare.SimonGMT.Chapter08.ae_eq_const_of_weak_coordinate_derivatives_zero hloc hΩ hΩc hC1
  obtain ⟨c, hc⟩ := hconst c₀ hc₀
  -- step 8: `S(ω) = c ∫_{V∩Q} ω(τ) dHⁿ` and `M_W(S) = ∫_{W∩Q} |c| dHⁿ = |c| Hⁿ(W ∩ Q)`
  refine ⟨c, fun ω => ?_, fun W hW hWV => ?_⟩
  · rw [hSg ω, ← integral_const_mul]
    refine integral_congr_ae ?_
    filter_upwards [hc] with x hx
    rw [hx]
  · rw [hmass W hW hWV, ← setLIntegral_const]
    refine lintegral_congr_ae ?_
    filter_upwards [ae_restrict_of_ae_restrict_of_subset (inter_subset_inter_left _ hWV) hc]
      with x hx
    rw [hx, Real.enorm_eq_ofReal_abs, ← Int.cast_abs, ← Nat.cast_natAbs, ENNReal.ofReal_natCast]
/-- **Tangent cones of a 2-dimensional minimizing cone at `p ≠ 0` are planes through `p`**
(proof of 7.3.3(1), case `n − d = 2`, chapter-07.txt lines 497–510, where the structure of
2-dimensional minimizing cones is cited to [Whi82]).  If `C ∈ 𝒟₂(ℝᴾ)` is a minimizing cone with
`∂C = 0`, `p ∈ spt C \ {0}` and `λⱼ ↓ 0`, then along a subsequence `η_{p,λⱼ#}C ⇀ C' = c[[Q]]`,
`μ_{η_{p,λⱼ#}C} → μ_{C'}`, for a plane `Q = span{τ₁, τ₂} ∋ p` and `c ∈ ℤ` with
`|c| = Θ²(μ_C, p) ≥ 1`.  The tangent cone `C'` is a minimizing cone cycle with
`Θ²(μ_{C'}, 0) = Θ²(μ_C, p) ≥ 1` (7.3.1(2)); since `C` is a cone, `μ_{C'}` and the density of
`C'` are invariant along `ℝp` (proof of A.4, chapter-A.txt lines 125–131); the splitting
Lemma 3.5 (chapter-07.txt lines 410–418) and formula (10) (lines 556–568) put `spt C'` in a plane
`Q ∋ p`; and the Constancy Theorem (Ch. 6, 2.34) gives `C' = c[[Q]]`, so
`Θ²(μ_{C'}, 0) = |c|`. -/
theorem Submission.idtp_cone_tangent_cone_planar : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2), IsMinimizingIn C univ → BoundaryVanishes C → IsConeCurrent C → ∀ p ∈ C.support, p ≠ 0 → ∀ (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), Tendsto lams atTop (𝓝 0) → ∃ (φ : ℕ → ℕ) (C' : GeometricCurrentOn (univ : Set (Euclid P)) 2) (τ : Fin 2 → Euclid P) (c : ℤ), StrictMono φ ∧ ConvergesWeakly (fun j => blowUp C p (lams (φ j)) (hlams (φ j)).ne') C' ∧ MassMeasuresConverge (fun j => blowUp C p (lams (φ j)) (hlams (φ j)).ne') C' ∧ Orthonormal ℝ τ ∧ p ∈ Submodule.span ℝ (Set.range τ) ∧ 1 ≤ c.natAbs ∧ HasMassDensity C p (c.natAbs : ℝ) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) 2, C' ω = (c : ℝ) * ∫ x in (Submodule.span ℝ (Set.range τ) : Set (Euclid P)), (ω : DifferentialForm (Euclid P) 2) x τ ∂μHE[2] := by
  intro P C hC hCb hCcone p hp hp0 lams hlams hlams0
  -- Steps 1–3: a tangent cone `C'` of `C` at `p` along a subsequence `λ_{φ(j)}`; it is a
  -- minimizing cone with `∂C' = 0` and `Θ²(μ_{C'}, 0) = Θ²(μ_C, p) = θ ≥ 1`.
  obtain ⟨φ, C', θ, hφ, hconv, hmass, hC', hC'cone, hC'b, hθ, hCθ, hC'θ⟩ :=
    Submission.idtp_cttp_cycle_tangent_cone P 2 C (by norm_num) hC hCb p hp lams hlams hlams0
  obtain ⟨R', hR'⟩ := hC'.1
  -- Steps 4–5: `μ_{C'}` is invariant under the translations by `v ∈ ℝp`.
  have hinv := Submission.idtp_cttp_blowup_limit_translation_invariant P 2 C C' p
    (fun j => lams (φ j)) (fun j => hlams (φ j)) hC.1 hCcone (hlams0.comp hφ.tendsto_atTop)
    hmass R' hR'
  -- Step 6: hence `Θ²(μ_{C'}, y + λw) = Θ²(μ_{C'}, w)` for `y ∈ ℝp` and `λ > 0`.
  have hdens := Submission.idtp_cttp_cone_density_translation_invariant P 2 C' R'
    (Submodule.span ℝ {p}) hR' hC'cone hinv
  -- Steps 7–9: `spt C' ⊆ Q := span{τ₁, τ₂}` for an orthonormal pair `τ` with `p ∈ Q`.
  obtain ⟨τ, hτ, hpτ, hsupp⟩ :=
    Submission.idtp_cttp_planar_support P C' p θ hp0 hC' hC'b hdens hθ hC'θ
  -- Step 10: the Constancy Theorem gives `C' = c[[Q]]` and `M_W(C') = |c| H²(W ∩ Q)`.
  obtain ⟨c, hc, hcmass⟩ := Submission.idtp_planar_cycle_eq_const_mul P 2 univ C' τ
    (by norm_num) isOpen_univ hτ hC'.1 hC'b hsupp (by
      rw [univ_inter]
      exact (Submodule.span ℝ (Set.range τ)).convex.isConnected
        ⟨0, (Submodule.span ℝ (Set.range τ)).zero_mem⟩)
  -- `M_{B_ρ(0)}(C') = |c| H²(B_ρ(0) ∩ Q) = |c| ω₂ρ²` for `ρ > 0`, so `Θ²(μ_{C'}, 0) = |c|`.
  have hC'c : HasMassDensity C' 0 (c.natAbs : ℝ) := by
    refine ⟨Nat.cast_nonneg _, ?_⟩
    rw [ENNReal.ofReal_natCast]
    refine tendsto_const_nhds.congr' (EventuallyEq.symm ?_)
    filter_upwards [self_mem_nhdsWithin] with ρ hρ
    have hρ' : 0 < ρ := hρ
    have hω₂ : unitBallVolume 2 ≠ 0 := (measure_ball_pos volume (0 : Euclid 2) one_pos).ne'
    have hω₂' : unitBallVolume 2 ≠ ∞ := measure_ball_lt_top.ne
    rw [hcmass (ball 0 ρ) isOpen_ball (subset_univ _),
      Submission.idtp_cttp_span_ball_measure P 2 τ hτ 0 (Submodule.zero_mem _) ρ hρ',
      ENNReal.mul_div_cancel_right
        (mul_ne_zero hω₂ (ENNReal.ofReal_pos.2 (by positivity)).ne')
        (ENNReal.mul_ne_top hω₂' ENNReal.ofReal_ne_top)]
  -- Densities are unique, so `|c| = θ ≥ 1` and `Θ²(μ_C, p) = |c|`.
  have hθc : θ = c.natAbs :=
    (ENNReal.ofReal_eq_ofReal_iff hC'θ.1 hC'c.1).1 (tendsto_nhds_unique hC'θ.2 hC'c.2)
  refine ⟨φ, C', τ, c, hφ, hconv, hmass, hτ, hpτ, ?_, hθc ▸ hCθ, fun ω => ?_⟩
  · exact_mod_cast (hθc ▸ hθ : (1 : ℝ) ≤ c.natAbs)
  · rw [hc ω, univ_inter]

/-- **Tangent plane at an edge point of a planar sector of a 2-dimensional minimizing cone**
(proof of Simon 7.3.3(1), case `n − d = 2`, chapter-07.txt lines 497–510).  Let `C ∈ 𝒟₂(ℝᴾ)` be
a minimizing cone with `∂C = 0`, `a ∈ spt C` a unit vector, `(a, e)` an orthonormal basis of the
plane `Q`, and suppose `C` has density `k ≥ 1` at every point `t(cos φ a + sin φ e)` of the open
sector `t > 0`, `0 < φ < δ`.  Then `m = Θ²(μ_C, a)` is an integer `≥ 1`, along a subsequence of
every `λⱼ ↓ 0` the blow-ups `η_{a,λⱼ#}C` converge to `±m[[Q]]` (oriented by `(a, e)`) with
`λⱼ⁻² ∫ g ∘ η_{a,λⱼ} dμ_C → m ∫_Q g dH²`, and near `a` the support of `C` is localized in a thin
cusp around `Q`.  The tangent cones `c[[Q']]` at `a` (`idtp_cone_tangent_cone_planar`) have
`|c| = m` by uniqueness of densities; the sector points `a + λⱼe ∈ spt C` have mass
`≥ ω₂(λⱼr)²` in `B_{λⱼr}(a + λⱼe)`, so `e ∈ Q'` (`idtp_cse_etp_rescaled_limit_mem`), whence
`Q' = Q` and `c[[Q']] = ±c[[Q]]` (`idtp_cse_etp_plane_frame_sign`); the cusp
(`idtp_cse_etp_cusp`) and the localization (`idtp_cse_etp_localization`) give the last part. -/
theorem Submission.idtp_cse_edge_tangent_plane : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (δ : ℝ) (k : ℕ), IsMinimizingIn C univ → BoundaryVanishes C → IsConeCurrent C → Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → 0 < δ → 1 ≤ k → a ∈ C.support → (∀ t φ : ℝ, 0 < t → 0 < φ → φ < δ → HasMassDensity C (t • (Real.cos φ • a + Real.sin φ • e)) k ∧ ∃ r : ℝ, 0 < r ∧ C.support ∩ ball (t • (Real.cos φ • a + Real.sin φ • e)) r ⊆ (Q : Set (Euclid P))) → ∃ m : ℕ, 1 ≤ m ∧ HasMassDensity C a m ∧ (∀ (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), Tendsto lams atTop (𝓝 0) → ∃ (φ : ℕ → ℕ) (C' : GeometricCurrentOn (univ : Set (Euclid P)) 2) (c : ℤ), StrictMono φ ∧ c.natAbs = m ∧ ConvergesWeakly (fun j => blowUp C a (lams (φ j)) (hlams (φ j)).ne') C' ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) 2, C' ω = (c : ℝ) * ∫ x in (Q : Set (Euclid P)), (ω : DifferentialForm (Euclid P) 2) x ![a, e] ∂μHE[2]) ∧ ∀ R : IMRep (univ : Set (Euclid P)) 2, R.Represents C → ∀ g : Euclid P → ℝ, Continuous g → HasCompactSupport g → Tendsto (fun j => (lams (φ j))⁻¹ ^ 2 * ∫ x, g (dilation a (lams (φ j)) x) ∂R.measure) atTop (𝓝 ((m : ℝ) * ∫ x in (Q : Set (Euclid P)), g x ∂μHE[2]))) ∧ ∃ s₀ : ℝ, 0 < s₀ ∧ s₀ ≤ 1 / 4 ∧ (∀ s' : ℝ, 0 < s' → s' ≤ s₀ → ∀ x ∈ C.support, 0 < inner ℝ x a → |‖x‖ - 1| < s' → |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' → ‖x - Q.starProjection x‖ ≤ 2 * s₀ * ‖x‖ → ‖x - Q.starProjection x‖ < s' / 4 * ‖x‖ ∧ dist x a < 3 * s') := by
  intro P C Q a e δ k hmin hbd hcone hQ haQ heQ ha he hae hδ hk haC hsector
  -- step 0: `C = τ(M, θ, ξ)` with `μ = μ_C`, and `M_W(C) = μ(W)` for open `W`
  obtain ⟨R₀, hR₀⟩ := hmin.1
  obtain ⟨hmass, -, -⟩ := Submission.dimred_im_mass_measure P 2 univ C R₀ isOpen_univ hR₀
  have ha0 : a ≠ 0 := fun h => by
    rw [h, norm_zero] at ha
    exact zero_ne_one ha
  -- `μ` is finite on compact sets
  have hfin : ∀ K : Set (Euclid P), IsCompact K → R₀.measure K ≠ ∞ := by
    intro K hK
    rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
      Measure.restrict_restrict hK.measurableSet, inter_comm]
    exact R₀.locallyIntegrable_mult K hK (subset_univ _)
  -- step 1: `μ(B_ρ(y)) ≥ ω₂ρ²` for `y ∈ spt C` and `ρ > 0`
  have hlow : ∀ y ∈ C.support, ∀ ρ : ℝ, 0 < ρ →
      unitBallVolume 2 * ENNReal.ofReal (ρ ^ 2) ≤ R₀.measure (ball y ρ) := fun y hy ρ hρ =>
    (Submission.idtp_cse_massOn_ball_lower_bound P C hmin hbd y hy ρ hρ).trans_eq
      (hmass _ isOpen_ball (subset_univ _))
  -- the sector points `a + l e`, `0 < l < l₀`, lie in `spt C`
  obtain ⟨l₀, hl₀, hedge⟩ := Submission.idtp_cse_etp_edge_direction_support P C a e δ k hmin.1
    hδ hk fun t φ ht hφ hφδ => (hsector t φ ht hφ hφδ).1
  -- `m := Θ²(μ_C, a) = |c₀|` is an integer `≥ 1`
  obtain ⟨_, _, _, c₀, _, _, _, _, _, hc₀, hc₀dens, _⟩ :=
    Submission.idtp_cone_tangent_cone_planar P C hmin hbd hcone a haC ha0
      (fun j => 1 / ((j : ℝ) + 1)) (fun j => by positivity)
      tendsto_one_div_add_atTop_nhds_zero_nat
  -- step 2: along a subsequence of every `λⱼ → 0`, `η_{a,λⱼ#}C ⇀ ±m[[Q]]`
  have hblow : ∀ (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), Tendsto lams atTop (𝓝 0) →
      ∃ (φ : ℕ → ℕ) (C' : GeometricCurrentOn (univ : Set (Euclid P)) 2) (c : ℤ), StrictMono φ ∧
        c.natAbs = c₀.natAbs ∧
        ConvergesWeakly (fun j => blowUp C a (lams (φ j)) (hlams (φ j)).ne') C' ∧
        (∀ ω : TestFormOn (univ : Set (Euclid P)) 2, C' ω = (c : ℝ) *
          ∫ x in (Q : Set (Euclid P)), (ω : DifferentialForm (Euclid P) 2) x ![a, e] ∂μHE[2]) ∧
        ∀ R : IMRep (univ : Set (Euclid P)) 2, R.Represents C → ∀ g : Euclid P → ℝ,
          Continuous g → HasCompactSupport g →
          Tendsto (fun j => (lams (φ j))⁻¹ ^ 2 * ∫ x, g (dilation a (lams (φ j)) x) ∂R.measure)
            atTop (𝓝 ((c₀.natAbs : ℝ) * ∫ x in (Q : Set (Euclid P)), g x ∂μHE[2])) := by
    intro lams hlams hlams0
    obtain ⟨φ, C', τ, c, hφ, hconv, hmconv, hτ, haτ, hc1, hcdens, hC'⟩ :=
      Submission.idtp_cone_tangent_cone_planar P C hmin hbd hcone a haC ha0 lams hlams hlams0
    -- densities are unique, so `|c| = |c₀|`
    have hcc₀ : c.natAbs = c₀.natAbs := by
      have h := (ENNReal.ofReal_eq_ofReal_iff hcdens.1 hc₀dens.1).1
        (tendsto_nhds_unique hcdens.2 hc₀dens.2)
      exact_mod_cast h
    have hc : c ≠ 0 := Int.natAbs_pos.1 hc1
    -- (V): `λ_{φ(j)}⁻² ∫ g ∘ η_{a,λ_{φ(j)}} dμ_R → |c| ∫_{Q'} g dH²`, `Q' = span τ`
    have hV := Submission.idtp_cse_etp_blowup_vague_limit P 2 C a (fun j => lams (φ j))
      (fun j => hlams (φ j)) C' τ c hτ hc hC' hmconv
    -- step 2(d): `e ∈ Q'`, since `μ(B_{λr}(a + λe)) ≥ ω₂(λr)²` once `λ < l₀`
    have heτ : e ∈ Submodule.span ℝ (Set.range τ) :=
      Submission.idtp_cse_etp_rescaled_limit_mem P R₀.measure
        (Submodule.span ℝ (Set.range τ) : Set (Euclid P)) a e (c.natAbs : ℝ)
        (fun j => lams (φ j)) (fun _ => e) (Submodule.closed_of_finiteDimensional _) hfin
        (fun j => hlams (φ j)) tendsto_const_nhds (hV R₀ hR₀) fun r hr => by
          filter_upwards [(hlams0.comp hφ.tendsto_atTop).eventually_lt_const hl₀] with j hj
          exact hlow _ (hedge _ (hlams (φ j)) hj) _ (mul_pos (hlams (φ j)) hr)
    -- step 2(e): `Q' = Q` and `α(τ) = ε α(a, e)` with `ε = ±1`
    obtain ⟨hQ', ε, hε, hατ⟩ :=
      Submission.idtp_cse_etp_plane_frame_sign P Q a e τ hQ haQ heQ ha he hae hτ haτ heτ
    refine ⟨φ, C', ε * c, hφ, ?_, hconv, fun ω => ?_, fun R hR g hg hgc => ?_⟩
    · rw [Int.natAbs_mul, hε, one_mul, hcc₀]
    · rw [hC' ω, hQ']
      simp_rw [hατ]
      rw [integral_const_mul]
      push_cast
      ring
    · have h := hV R hR g hg hgc
      rwa [hQ', hcc₀] at h
  refine ⟨c₀.natAbs, hc₀, hc₀dens, hblow, ?_⟩
  -- step 3: the cusp, `|x − π_Q x| ≤ |x − a|/20` for `x ∈ spt C` near `a`
  obtain ⟨s₁, hs₁, hcusp⟩ := Submission.idtp_cse_etp_cusp P R₀.measure C.support Q a
    (c₀.natAbs : ℝ) haQ hfin hlow (fun lams hlams hlams0 => by
      obtain ⟨φ, _, _, hφ, _, _, _, hV⟩ := hblow lams hlams hlams0
      exact ⟨φ, hφ, hV R₀ hR₀⟩) (1 / 20) (by norm_num)
  -- step 4: the localization in the box around `a`
  exact Submission.idtp_cse_etp_localization P Q a e C.support s₁ hQ haQ heQ ha he hae hs₁ hcusp
/-- **Simon Ch. 4, 2.3** (tangential divergence of a rotation field): for the skew linear map
`A y = ⟨y, a⟩e − ⟨y, e⟩a` and `X = gA` with `g` differentiable at `x`,
`div_M X(x) = Dg(x)(p(Ax))`, `p = p_{TₓM}`.  The product rule gives `DX(x) = g(x)A + Dg(x)(·)Ax`,
so `p ∘ DX(x)` is a combination of the rank-one maps `u ↦ ⟨a, u⟩pe`, `u ↦ ⟨e, u⟩pa` and
`u ↦ Dg(x)(u)p(Ax)`, with traces `⟨a, pe⟩`, `⟨e, pa⟩` and `Dg(x)(p(Ax))`; `p` being
self-adjoint, `⟨a, pe⟩ = ⟨e, pa⟩`. -/
theorem Submission.idtp_cse_rc_rotation_divergence : ∀ (P n : ℕ) (M : Set (Euclid P)) (a e x : Euclid P) (g : Euclid P → ℝ), DifferentiableAt ℝ g x → tangentialDivergence n M (fun y : Euclid P => g y • (inner ℝ y a • e - inner ℝ y e • a)) x = fderiv ℝ g x ((approxTangentPlane n M x).starProjection (inner ℝ x a • e - inner ℝ x e • a)) := by
  intro P n M a e x g hg
  set p := (approxTangentPlane n M x).starProjection with hp
  -- `A y = ⟪y, a⟫ e − ⟪y, e⟫ a` is the continuous linear map `⟪a, ·⟫ e − ⟪e, ·⟫ a`
  set A : Euclid P →L[ℝ] Euclid P := (innerSL ℝ a).smulRight e - (innerSL ℝ e).smulRight a
    with hA
  have hAy : ∀ y, A y = inner ℝ y a • e - inner ℝ y e • a := fun y => by
    simp [A, real_inner_comm]
  have hX : (fun y : Euclid P => g y • (inner ℝ y a • e - inner ℝ y e • a)) =
      fun y => g y • A y := by
    funext y
    rw [hAy]
  -- product rule: `DX(x) = g(x) A + Dg(x)(·) Ax`
  have hD : fderiv ℝ (fun y => g y • A y) x = g x • A + (fderiv ℝ g x).smulRight (A x) := by
    rw [fderiv_fun_smul hg A.differentiableAt, A.fderiv]
  -- `p ∘ DX(x)` is a combination of rank-one maps
  have hdecomp : p.toLinearMap ∘ₗ (g x • A + (fderiv ℝ g x).smulRight (A x)).toLinearMap =
      g x • ((innerₛₗ ℝ a).smulRight (p e) - (innerₛₗ ℝ e).smulRight (p a)) +
        (fderiv ℝ g x).toLinearMap.smulRight (p (A x)) := by
    ext u
    simp [A, map_sub, map_smul]
  -- `trace (p ∘ A) = ⟪a, p e⟫ − ⟪e, p a⟫ = 0`, `p` being self-adjoint
  have hskew : inner ℝ a (p e) - inner ℝ e (p a) = 0 := by
    rw [hp, ← Submodule.inner_starProjection_left_eq_right, real_inner_comm, sub_self]
  -- `trace (z ↦ ℓ(z) v) = ℓ(v)` (`LinearMap.trace_smulRight`) for each rank-one term
  unfold tangentialDivergence
  rw [hX, hD, ← hp, hdecomp, map_add, map_smul, map_sub, LinearMap.trace_smulRight,
    LinearMap.trace_smulRight, LinearMap.trace_smulRight, innerₛₗ_apply_apply,
    innerₛₗ_apply_apply, hskew, smul_zero, zero_add, ContinuousLinearMap.coe_coe, hAy]
/-- **Conical `C¹` cutoff around a subspace** (step 4 of the parent proof).  With
`π = Q.starProjection` and `u(y) = ‖y − π y‖² / (s² ‖y‖²)`, take
`ζ(y) = smoothTransition((4/3)(1 − u(y)))`.  Off `0`, `u` is smooth, `‖x − π x‖ ≤ (s/2)‖x‖` gives
`u ≤ 1/4` and `ζ = 1`, `s‖x‖ ≤ ‖x − π x‖` gives `u ≥ 1` and `ζ = 0`, and `ζ` is constant near `x`
when either inequality is strict, so `Dζ(x) = 0` there. -/
theorem Submission.idtp_cse_rc_cone_cutoff : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (s : ℝ), 0 < s → ∃ ζ : Euclid P → ℝ, (∀ x : Euclid P, x ≠ 0 → ContDiffAt ℝ 1 ζ x) ∧ (∀ x : Euclid P, x ≠ 0 → ‖x - Q.starProjection x‖ ≤ s / 2 * ‖x‖ → ζ x = 1) ∧ (∀ x : Euclid P, x ≠ 0 → s * ‖x‖ ≤ ‖x - Q.starProjection x‖ → ζ x = 0) ∧ (∀ x : Euclid P, x ≠ 0 → (‖x - Q.starProjection x‖ < s / 2 * ‖x‖ ∨ s * ‖x‖ < ‖x - Q.starProjection x‖) → fderiv ℝ ζ x = 0) := by
  intro P Q s hs
  let ζ : Euclid P → ℝ := fun y =>
    Real.smoothTransition (4 / 3 * (1 - ‖y - Q.starProjection y‖ ^ 2 / (s ^ 2 * ‖y‖ ^ 2)))
  -- (b): `‖x − π x‖ ≤ (s/2)‖x‖` gives `u x ≤ 1/4`, so the argument of `smoothTransition` is `≥ 1`
  have h1 : ∀ x : Euclid P, x ≠ 0 → ‖x - Q.starProjection x‖ ≤ s / 2 * ‖x‖ → ζ x = 1 := by
    intro x hx hle
    have hd : 0 < s ^ 2 * ‖x‖ ^ 2 := mul_pos (pow_pos hs 2) (pow_pos (norm_pos_iff.2 hx) 2)
    have hu : ‖x - Q.starProjection x‖ ^ 2 / (s ^ 2 * ‖x‖ ^ 2) ≤ 1 / 4 := by
      rw [div_le_iff₀ hd]
      nlinarith [pow_le_pow_left₀ (norm_nonneg _) hle 2]
    exact Real.smoothTransition.one_of_one_le (by linarith)
  -- (c): `s‖x‖ ≤ ‖x − π x‖` gives `u x ≥ 1`, so the argument of `smoothTransition` is `≤ 0`
  have h0 : ∀ x : Euclid P, x ≠ 0 → s * ‖x‖ ≤ ‖x - Q.starProjection x‖ → ζ x = 0 := by
    intro x hx hle
    have hd : 0 < s ^ 2 * ‖x‖ ^ 2 := mul_pos (pow_pos hs 2) (pow_pos (norm_pos_iff.2 hx) 2)
    have hu : 1 ≤ ‖x - Q.starProjection x‖ ^ 2 / (s ^ 2 * ‖x‖ ^ 2) := by
      rw [le_div_iff₀ hd]
      nlinarith [pow_le_pow_left₀ (mul_nonneg hs.le (norm_nonneg x)) hle 2]
    exact Real.smoothTransition.zero_of_nonpos (by linarith)
  refine ⟨ζ, fun x hx => ?_, h1, h0, fun x hx hx' => ?_⟩
  · -- (a): `u` is smooth at `x ≠ 0` (the denominator `s² ‖x‖²` is nonzero)
    have hd : s ^ 2 * ‖x‖ ^ 2 ≠ 0 := (mul_pos (pow_pos hs 2) (pow_pos (norm_pos_iff.2 hx) 2)).ne'
    have hu : ContDiffAt ℝ 1
        (fun y : Euclid P => ‖y - Q.starProjection y‖ ^ 2 / (s ^ 2 * ‖y‖ ^ 2)) x :=
      ((contDiff_id.sub Q.starProjection.contDiff).norm_sq ℝ).contDiffAt.fun_div
        (contDiffAt_const.mul (contDiff_norm_sq ℝ).contDiffAt) hd
    exact (Real.smoothTransition.contDiffAt (n := 1)).comp x
      (contDiffAt_const.mul (contDiffAt_const.sub hu))
  · -- (d): `ζ` is constant on an open neighbourhood of `x`
    rcases hx' with hlt | hlt
    · have hV : IsOpen ({y : Euclid P | y ≠ 0} ∩ {y | ‖y - Q.starProjection y‖ < s / 2 * ‖y‖}) :=
        isOpen_ne.inter (isOpen_lt (by fun_prop) (by fun_prop))
      have hev : ζ =ᶠ[𝓝 x] fun _ => (1 : ℝ) := by
        filter_upwards [hV.mem_nhds ⟨hx, hlt⟩] with y hy
        exact h1 y hy.1 hy.2.le
      rw [hev.fderiv_eq, fderiv_const_apply]
    · -- the region `s‖y‖ < ‖y − π y‖` avoids `0`
      have hV : IsOpen {y : Euclid P | s * ‖y‖ < ‖y - Q.starProjection y‖} :=
        isOpen_lt (by fun_prop) (by fun_prop)
      have hev : ζ =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
        filter_upwards [hV.mem_nhds hlt] with y hy
        have hy0 : y ≠ 0 := by
          rintro rfl
          simp at hy
        exact h0 y hy0 hy.le
      rw [hev.fderiv_eq, fderiv_const_apply]
/-- **Orthogonal projection onto a 2-plane in an orthonormal frame** (the linear-algebra half of
the polar-angle differential `idtp_cse_rc_angle_fderiv`, used for Simon 7.3.3(1)).  If `a, e ∈ Q`
are orthonormal and `dim Q = 2`, then `π_Q y = ⟨y, a⟩ a + ⟨y, e⟩ e` and
`|π_Q y|² = ⟨y, a⟩² + ⟨y, e⟩²`.  The orthonormal pair `![a, e]` is independent, so it spans `Q`;
`y − (⟨y, a⟩ a + ⟨y, e⟩ e)` is orthogonal to `a` and `e`, hence to `Q`, and `π_Q y` is the unique
point of `Q` with this property. -/
theorem Submission.idtp_cse_rc_af_plane_projection : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P), Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → ∀ y : Euclid P, Q.starProjection y = inner ℝ y a • a + inner ℝ y e • e ∧ ‖Q.starProjection y‖ ^ 2 = inner ℝ y a ^ 2 + inner ℝ y e ^ 2 := by
  intro P Q a e hQ ha he ha1 he1 hae y
  -- `⟪a, a⟫ = ⟪e, e⟫ = 1` and `⟪a, e⟫ = ⟪e, a⟫ = 0`
  have haa : inner ℝ a a = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, ha1, one_pow]
  have hee : inner ℝ e e = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, he1, one_pow]
  have hea : inner ℝ e a = (0 : ℝ) := by rw [real_inner_comm, hae]
  -- `![a, e]` is orthonormal, hence linearly independent
  have hv : Orthonormal ℝ ![a, e] := by
    rw [orthonormal_iff_ite]
    simp only [Fin.forall_fin_two, Matrix.cons_val_zero, Matrix.cons_val_one, haa, hee, hae, hea]
    simp
  -- `span {a, e} = Q`: the span lies in `Q` and has the same dimension `2`
  have hrange : Set.range ![a, e] = {a, e} := Matrix.range_cons_cons_empty a e ![]
  have hspan : Submodule.span ℝ {a, e} = Q := by
    rw [← hrange]
    refine Submodule.eq_of_le_of_finrank_eq ?_ ?_
    · rw [Submodule.span_le, hrange, Set.insert_subset_iff, Set.singleton_subset_iff]
      exact ⟨ha, he⟩
    · rw [finrank_span_eq_card hv.linearIndependent, hQ, Fintype.card_fin]
  -- `w = ⟪y, a⟫ a + ⟪y, e⟫ e` lies in `Q`, and `y - w` is orthogonal to `a` and `e`
  have hwQ : inner ℝ y a • a + inner ℝ y e • e ∈ Q :=
    Q.add_mem (Q.smul_mem _ ha) (Q.smul_mem _ he)
  have hya : inner ℝ (y - (inner ℝ y a • a + inner ℝ y e • e)) a = (0 : ℝ) := by
    rw [inner_sub_left, inner_add_left, real_inner_smul_left, real_inner_smul_left, haa, hea]
    ring
  have hye : inner ℝ (y - (inner ℝ y a • a + inner ℝ y e • e)) e = (0 : ℝ) := by
    rw [inner_sub_left, inner_add_left, real_inner_smul_left, real_inner_smul_left, hae, hee]
    ring
  -- so `y - w` is orthogonal to `span {a, e} = Q` (the kernel of `⟪y - w, ·⟫`), and `π y = w`
  have hproj : Q.starProjection y = inner ℝ y a • a + inner ℝ y e • e := by
    refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero hwQ fun z hz => ?_
    have hK : Submodule.span ℝ {a, e} ≤
        LinearMap.ker (innerₛₗ ℝ (y - (inner ℝ y a • a + inner ℝ y e • e))) := by
      rw [Submodule.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
      exact ⟨by rw [SetLike.mem_coe, LinearMap.mem_ker, innerₛₗ_apply_apply, hya],
        by rw [SetLike.mem_coe, LinearMap.mem_ker, innerₛₗ_apply_apply, hye]⟩
    rw [← hspan] at hz
    have hz' := hK hz
    rwa [LinearMap.mem_ker, innerₛₗ_apply_apply] at hz'
  -- `‖π y‖² = ⟪w, w⟫ = ⟪y, a⟫² + ⟪y, e⟫²`
  refine ⟨hproj, ?_⟩
  rw [hproj, ← real_inner_self_eq_norm_sq, inner_add_left, inner_add_right, inner_add_right,
    real_inner_smul_left, real_inner_smul_left, real_inner_smul_left, real_inner_smul_left,
    real_inner_smul_right, real_inner_smul_right, real_inner_smul_right, real_inner_smul_right,
    haa, hee, hae, hea]
  ring
/-- **Differential of the polar angle `arctan (⟨y, e⟩ / ⟨y, a⟩)`** (the calculus step of the
rotation argument for cone sectors in Simon 7.3).  If `⟨x, a⟩ ≠ 0`, then
`f(y) = arctan (⟨y, e⟩ / ⟨y, a⟩)` is `C¹` near `x` and, for every `v`,
`Df(x) v = ⟨⟨x, a⟩ e - ⟨x, e⟩ a, v⟩ / (⟨x, a⟩² + ⟨x, e⟩²)`.
* `y ↦ ⟨y, a⟩ = innerSL ℝ a y` and `y ↦ ⟨y, e⟩` are continuous linear, hence smooth and their
  own derivatives; the quotient is `C¹` at `x` because `⟨x, a⟩ ≠ 0`, and so is its `arctan`.
* With `α = ⟨x, a⟩` and `β = ⟨x, e⟩`, the inverse, product and `arctan` chain rules give
  `Df(x) v = (1 + (β / α)²)⁻¹ (β (-(α²)⁻¹ ⟨a, v⟩) + α⁻¹ ⟨e, v⟩)`, which equals
  `(α ⟨e, v⟩ - β ⟨a, v⟩) / (α² + β²)` since `α² + β² ≥ α² > 0`. -/
theorem Submission.idtp_cse_rc_af_polar_angle_fderiv : ∀ (P : ℕ) (a e x : Euclid P), inner ℝ x a ≠ 0 → ContDiffAt ℝ 1 (fun y : Euclid P => Real.arctan (inner ℝ y e / inner ℝ y a)) x ∧ ∀ v : Euclid P, fderiv ℝ (fun y : Euclid P => Real.arctan (inner ℝ y e / inner ℝ y a)) x v = inner ℝ (inner ℝ x a • e - inner ℝ x e • a) v / (inner ℝ x a ^ 2 + inner ℝ x e ^ 2) := by
  intro P a e x hx
  -- Step 1: `y ↦ ⟨y, a⟩` and `y ↦ ⟨y, e⟩` are the continuous linear maps `innerSL ℝ a`, `innerSL ℝ e`
  have hLa : (fun y : Euclid P => inner ℝ y a) = innerSL ℝ a := by
    funext y; rw [innerSL_apply_apply, real_inner_comm]
  have hLe : (fun y : Euclid P => inner ℝ y e) = innerSL ℝ e := by
    funext y; rw [innerSL_apply_apply, real_inner_comm]
  have hda : HasFDerivAt (fun y : Euclid P => inner ℝ y a) (innerSL ℝ a) x :=
    hLa ▸ (innerSL ℝ a).hasFDerivAt
  have hde : HasFDerivAt (fun y : Euclid P => inner ℝ y e) (innerSL ℝ e) x :=
    hLe ▸ (innerSL ℝ e).hasFDerivAt
  -- Step 2: the quotient `q = ⟨·, e⟩ / ⟨·, a⟩` is `C¹` at `x`, and so is `arctan ∘ q`
  have hq : ContDiffAt ℝ 1 (fun y : Euclid P => inner ℝ y e / inner ℝ y a) x := by
    have hca : ContDiffAt ℝ 1 (fun y : Euclid P => inner ℝ y a) x :=
      hLa ▸ (innerSL ℝ a).contDiff.contDiffAt
    have hce : ContDiffAt ℝ 1 (fun y : Euclid P => inner ℝ y e) x :=
      hLe ▸ (innerSL ℝ e).contDiff.contDiffAt
    exact hce.fun_div hca hx
  refine ⟨hq.arctan, fun v => ?_⟩
  -- Step 3: `y ↦ ⟨y, a⟩⁻¹` has derivative `-(α²)⁻¹ ⟨a, ·⟩` at `x`
  have hdinv : HasFDerivAt (fun y : Euclid P => (inner ℝ y a)⁻¹)
      (-(inner ℝ x a ^ 2)⁻¹ • innerSL ℝ a) x :=
    (hasDerivAt_inv hx).comp_hasFDerivAt x hda
  -- Step 4: the product rule for `q = ⟨·, e⟩ ⬝ ⟨·, a⟩⁻¹`
  have hdq : HasFDerivAt (fun y : Euclid P => inner ℝ y e / inner ℝ y a)
      (inner ℝ x e • (-(inner ℝ x a ^ 2)⁻¹ • innerSL ℝ a) + (inner ℝ x a)⁻¹ • innerSL ℝ e) x := by
    simp only [div_eq_mul_inv]
    exact hde.fun_mul hdinv
  -- Step 5: the `arctan` chain rule and uniqueness of the derivative
  have hdf : HasFDerivAt (fun y : Euclid P => Real.arctan (inner ℝ y e / inner ℝ y a))
      ((1 / (1 + (inner ℝ x e / inner ℝ x a) ^ 2)) •
        (inner ℝ x e • (-(inner ℝ x a ^ 2)⁻¹ • innerSL ℝ a) + (inner ℝ x a)⁻¹ • innerSL ℝ e)) x :=
    hdq.arctan
  rw [hdf.fderiv]
  -- Step 6: algebra, with `α ≠ 0` and `α² + β² ≥ α² > 0`
  simp only [smul_apply, add_apply, innerSL_apply_apply, smul_eq_mul, inner_sub_left,
    real_inner_smul_left]
  have hden : inner ℝ x a ^ 2 + inner ℝ x e ^ 2 ≠ 0 := by positivity
  field_simp
  ring

/-- **Simon 7.3.3, proof of (1)** (2-dimensional minimizing cones, chapter text lines 501–504;
polar angle for the rotation field, Ch. 4, 2.2–2.6): if `a, e` is an orthonormal pair in the
`2`-dimensional subspace `Q`, then (i) `|p_Q y|² = (y · a)² + (y · e)²`, and (ii) on `{x · a > 0}`
the angle `f(y) = arctan((y · e)/(y · a))` is `C¹` with
`Df(x)v = ((x · a)e − (x · e)a) · v / |p_Q x|²`.  `(a, e)` is an orthonormal basis of `Q`, so
`p_Q y = (y · a)a + (y · e)e`, which gives (i); the quotient and `arctan` chain rules give `Df(x)v`
with denominator `(x · a)² + (x · e)²`, which is `|p_Q x|²` by (i). -/
theorem Submission.idtp_cse_rc_angle_fderiv : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P), Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → (∀ y : Euclid P, ‖Q.starProjection y‖ ^ 2 = inner ℝ y a ^ 2 + inner ℝ y e ^ 2) ∧ ∀ x : Euclid P, 0 < inner ℝ x a → ContDiffAt ℝ 1 (fun y : Euclid P => Real.arctan (inner ℝ y e / inner ℝ y a)) x ∧ ∀ v : Euclid P, fderiv ℝ (fun y : Euclid P => Real.arctan (inner ℝ y e / inner ℝ y a)) x v = inner ℝ (inner ℝ x a • e - inner ℝ x e • a) v / ‖Q.starProjection x‖ ^ 2 := by
  intro P Q a e hQ ha he ha1 he1 hae
  -- (i): `p_Q y = (y · a)a + (y · e)e`, so `|p_Q y|² = (y · a)² + (y · e)²`
  have hnorm : ∀ y : Euclid P, ‖Q.starProjection y‖ ^ 2 = inner ℝ y a ^ 2 + inner ℝ y e ^ 2 :=
    fun y => (Submission.idtp_cse_rc_af_plane_projection P Q a e hQ ha he ha1 he1 hae y).2
  refine ⟨hnorm, fun x hx => ?_⟩
  -- (ii): `x · a ≠ 0`, and the denominator `(x · a)² + (x · e)²` of `Df(x)v` is `|p_Q x|²` by (i)
  obtain ⟨hf, hDf⟩ := Submission.idtp_cse_rc_af_polar_angle_fderiv P a e x hx.ne'
  exact ⟨hf, fun v => by rw [hDf v, hnorm x]⟩
/-- **Support estimate for the angular test function** (steps 3–4 of the test-function
construction in the rotation argument for cone sectors, Simon 7.3).  Write `π = Q.starProjection`,
`α = ⟨y, a⟩ > 0` and `β = ⟨y, e⟩`, and assume `|π y|² = α² + β²`.  If `0 < s ≤ 1/4`,
`||y| − 1| < s`, `|arctan (β / α)| < s` and `|y − π y| < s |y|`, then `α > 1/2` and `|y| < 5/4`.
* `s ≤ 1/4 < π/4 = arctan 1` and `arctan` is increasing and odd, so `−1 < β / α < 1`; as `α > 0`,
  this is `−α < β < α`, hence `β² < α²`.
* `3/4 < |y| < 5/4`, and Pythagoras `|y|² = |π y|² + |y − π y|²` with `|y − π y|² < s² |y|²`,
  `s² ≤ 1/16` gives `|π y|² > (15/16) |y|² > 135/256`.
* So `2 α² > α² + β² = |π y|² > 135/256`, i.e. `α² > 135/512 > (1/2)²`, and `α > 1/2`. -/
theorem Submission.idtp_cse_rc_tf_support_bound : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (a e y : Euclid P) (s : ℝ), 0 < s → s ≤ 1 / 4 → ‖Q.starProjection y‖ ^ 2 = inner ℝ y a ^ 2 + inner ℝ y e ^ 2 → 0 < inner ℝ y a → |‖y‖ - 1| < s → |Real.arctan (inner ℝ y e / inner ℝ y a)| < s → ‖y - Q.starProjection y‖ < s * ‖y‖ → 1 / 2 < inner ℝ y a ∧ ‖y‖ < 5 / 4 := by
  intro P Q a e y s hs hs4 hproj ha hy harc hq
  -- Step 1: `s ≤ 1/4 < π/4` (as `π ≥ 2`), and `−s < arctan (β / α) < s`
  have hpi : s < Real.pi / 4 := by linarith [Real.two_le_pi]
  obtain ⟨harc₁, harc₂⟩ := abs_lt.1 harc
  -- Step 2: `−1 < β / α < 1`, since `arctan` is monotone with `arctan (±1) = ±π/4`
  have ht₁ : inner ℝ y e / inner ℝ y a < 1 := by
    by_contra h
    have h' := Real.arctan_strictMono.monotone (not_lt.1 h)
    rw [Real.arctan_one] at h'
    linarith
  have ht₂ : -1 < inner ℝ y e / inner ℝ y a := by
    by_contra h
    have h' := Real.arctan_strictMono.monotone (not_lt.1 h)
    rw [Real.arctan_neg, Real.arctan_one] at h'
    linarith
  -- Step 3: multiplying by `α > 0` gives `−α < β < α`, hence `β² < α²`
  rw [div_lt_one ha] at ht₁
  rw [lt_div_iff₀ ha] at ht₂
  have hβα : inner ℝ y e ^ 2 < inner ℝ y a ^ 2 := by nlinarith
  -- Step 4: Pythagoras `|y|² = |π y|² + |y − π y|²`, as `π_{Qᗮ} y = y − π y`
  have hpyth : ‖y‖ ^ 2 = ‖Q.starProjection y‖ ^ 2 + ‖y - Q.starProjection y‖ ^ 2 := by
    rw [← Submodule.starProjection_orthogonal_val]
    exact Q.norm_sq_eq_add_norm_sq_starProjection y
  -- Step 5: `3/4 < |y| < 5/4`, so `|y|² > 9/16`
  obtain ⟨hy₁, hy₂⟩ := abs_lt.1 hy
  have hy34 : 3 / 4 < ‖y‖ := by linarith
  have hysq : 9 / 16 < ‖y‖ ^ 2 := by nlinarith
  -- Step 6: `|y − π y|² < s² |y|²` and `s² ≤ 1/16`, so `|π y|² > (15/16) |y|² > 135/256`
  have hq2 : ‖y - Q.starProjection y‖ ^ 2 < (s * ‖y‖) ^ 2 :=
    pow_lt_pow_left₀ hq (norm_nonneg _) two_ne_zero
  have hs2 : s ^ 2 ≤ 1 / 16 := by nlinarith
  have hπ : 135 / 256 < ‖Q.starProjection y‖ ^ 2 := by
    nlinarith [mul_le_mul_of_nonneg_right hs2 (sq_nonneg ‖y‖)]
  -- Step 7: `2 α² > α² + β² = |π y|² > 135/256`, so `α² > (1/2)²` and `α > 1/2`
  refine ⟨?_, by linarith⟩
  have hα2 : (1 / 2 : ℝ) ^ 2 < inner ℝ y a ^ 2 := by nlinarith
  exact (pow_lt_pow_iff_left₀ (by norm_num) ha.le two_ne_zero).1 hα2
/-- **Extension by zero of a `C¹` function vanishing off a compact subset of `U`** (steps 5–7 of
the test-function construction for the rotation argument of Simon 7.3).  Let `U` be open,
`K ⊆ U` compact, `h` `C¹` at every point of `U`, and `h y ≠ 0`, `y ∈ U` force `y ∈ K`.  Then
`g = U.indicator h` is `C¹` with compact support, `Dg(x) = Dh(x)` on `U` and `Dg(x) = 0` off `U`.
* `g y ≠ 0` forces `y ∈ U` and `h y ≠ 0`, so `support g ⊆ K`; `K` is closed, so `tsupport g ⊆ K`,
  and `g` vanishes off the compact set `K`.
* For `x ∈ U`, `g = h` on the neighbourhood `U` of `x`; for `x ∉ U`, `x ∉ K ⊇ tsupport g`, so
  `g = 0` near `x`.  Either way `g` is `C¹` at `x` with the stated derivative. -/
theorem Submission.idtp_cse_rc_tf_indicator_extension : ∀ (P : ℕ) (U K : Set (Euclid P)) (h : Euclid P → ℝ), IsOpen U → IsCompact K → K ⊆ U → (∀ x ∈ U, ContDiffAt ℝ 1 h x) → (∀ y ∈ U, h y ≠ 0 → y ∈ K) → ContDiff ℝ 1 (U.indicator h) ∧ HasCompactSupport (U.indicator h) ∧ (∀ x ∈ U, fderiv ℝ (U.indicator h) x = fderiv ℝ h x) ∧ (∀ x ∉ U, fderiv ℝ (U.indicator h) x = 0) := by
  intro P U K h hU hK hKU hh hhK
  -- Step 1: `support g ⊆ K`: `g y ≠ 0` forces `y ∈ U` (else `g y = 0`) and then `h y = g y ≠ 0`
  have hsupp : ∀ y, U.indicator h y ≠ 0 → y ∈ K := by
    intro y hy
    by_cases hyU : y ∈ U
    · rw [Set.indicator_of_mem hyU] at hy
      exact hhK y hyU hy
    · exact absurd (Set.indicator_of_notMem hyU h) hy
  -- Step 2: `K` is compact, hence closed, so `tsupport g = closure (support g) ⊆ K`
  have htsupp : tsupport (U.indicator h) ⊆ K :=
    closure_minimal (fun y hy => hsupp y hy) hK.isClosed
  -- Step 4: for `x ∈ U`, `g = h` on the neighbourhood `U` of `x`
  have hin : ∀ x ∈ U, U.indicator h =ᶠ[𝓝 x] h := fun x hx => by
    filter_upwards [hU.mem_nhds hx] with y hy using Set.indicator_of_mem hy h
  -- Step 5: for `x ∉ U`, `x ∉ K ⊇ tsupport g`, so `g = 0` near `x`
  have hout : ∀ x ∉ U, U.indicator h =ᶠ[𝓝 x] fun _ => (0 : ℝ) := fun x hx =>
    notMem_tsupport_iff_eventuallyEq.1 fun hxs => hx (hKU (htsupp hxs))
  refine ⟨contDiff_iff_contDiffAt.2 fun x => ?_, HasCompactSupport.intro hK fun y hy => ?_,
    fun x hx => (hin x hx).fderiv_eq, fun x hx => ?_⟩
  · -- Step 6: `g` is `C¹` at every point, by Steps 4 and 5
    by_cases hx : x ∈ U
    · exact (hh x hx).congr_of_eventuallyEq (hin x hx)
    · exact contDiffAt_const.congr_of_eventuallyEq (hout x hx)
  · -- Step 3: `g` vanishes off the compact set `K`
    by_contra hy'
    exact hy (hsupp y hy')
  · -- Step 5: `Dg(x) = D0(x) = 0`
    rw [(hout x hx).fderiv_eq, fderiv_const_apply]
/-- **Derivative of `ψ(f) · l(|·|) · ζ` in a direction orthogonal to the position vector** (step 8,
formula (★), of the test function for the rotation argument in Simon 7.3).  If `x ≠ 0`,
`⟨x, v⟩ = 0`, `f` and `ζ` are differentiable at `x`, `ψ` at `f(x)` and `l` at `|x|`, then
`h(y) = ψ(f(y)) l(|y|) ζ(y)` has `Dh(x)v = ψ(f(x)) l(|x|) Dζ(x)v + ζ(x) l(|x|) ψ'(f(x)) Df(x)v`:
the radial term drops.
* `N = |·|` is differentiable at `x ≠ 0`; `D(N²)(x)` is `2|x| DN(x)` by the chain rule and
  `2⟨x, ·⟩` directly, so `2|x| DN(x)v = 2⟨x, v⟩ = 0` and `DN(x)v = 0`.
* The chain and product rules for `((ψ ∘ f) · (l ∘ N)) · ζ` give
  `Dh(x)v = ψ(f(x)) l(|x|) Dζ(x)v + ζ(x) (ψ(f(x)) l'(|x|) DN(x)v + l(|x|) ψ'(f(x)) Df(x)v)`. -/
theorem Submission.idtp_cse_rc_tf_product_fderiv : ∀ (P : ℕ) (f ζ : Euclid P → ℝ) (ψ l : ℝ → ℝ) (x v : Euclid P), x ≠ 0 → inner ℝ x v = 0 → DifferentiableAt ℝ f x → DifferentiableAt ℝ ψ (f x) → DifferentiableAt ℝ l ‖x‖ → DifferentiableAt ℝ ζ x → fderiv ℝ (fun y : Euclid P => ψ (f y) * l ‖y‖ * ζ y) x v = ψ (f x) * l ‖x‖ * fderiv ℝ ζ x v + ζ x * l ‖x‖ * (deriv ψ (f x) * fderiv ℝ f x v) := by
  intro P f ζ ψ l x v hx hxv hf hψ hl hζ
  -- Step 1: the norm `N = ‖·‖` is differentiable at `x ≠ 0`
  have hN : HasFDerivAt (fun y : Euclid P => ‖y‖) (fderiv ℝ (fun y : Euclid P => ‖y‖) x) x :=
    ((contDiffAt_norm ℝ (n := 1) hx).differentiableAt one_ne_zero).hasFDerivAt
  -- Step 2: `D(N²)(x) = 2‖x‖ DN(x)` (chain rule) and `D(‖·‖²)(x) = 2⟪x, ·⟫` agree; at `v` this
  -- reads `2‖x‖ DN(x) v = 2⟪x, v⟫ = 0`, so `DN(x) v = 0` as `‖x‖ ≠ 0`
  have hNv : fderiv ℝ (fun y : Euclid P => ‖y‖) x v = 0 := by
    have h2 := DFunLike.congr_fun ((hN.pow 2).unique (hasStrictFDerivAt_norm_sq x).hasFDerivAt) v
    simp only [smul_apply, smul_eq_mul, innerSL_apply_apply, hxv, smul_zero, nsmul_eq_mul,
      Nat.cast_ofNat, Nat.reduceSub, pow_one] at h2
    exact (mul_eq_zero.1 h2).resolve_left (mul_ne_zero two_ne_zero (norm_ne_zero_iff.2 hx))
  -- Step 3: chain rules for `F = ψ ∘ f` and `L = l ∘ N`
  have hF : HasFDerivAt (fun y : Euclid P => ψ (f y)) (deriv ψ (f x) • fderiv ℝ f x) x :=
    hψ.hasDerivAt.comp_hasFDerivAt x hf.hasFDerivAt
  have hL : HasFDerivAt (fun y : Euclid P => l ‖y‖)
      (deriv l ‖x‖ • fderiv ℝ (fun y : Euclid P => ‖y‖) x) x :=
    hl.hasDerivAt.comp_hasFDerivAt x hN
  -- Step 4: the product rule, twice, for `h = (F ⬝ L) ⬝ ζ`
  rw [((hF.fun_mul hL).fun_mul hζ.hasFDerivAt).fderiv]
  -- Step 5: evaluate at `v`, drop the radial term `DL(x) v = l'(‖x‖) DN(x) v = 0`, rearrange
  simp only [add_apply, smul_apply, smul_eq_mul, hNv]
  ring

/-- **`C¹` angular test function adapted to the gap hypothesis** (steps 4, 5 and 7 of the parent
proof).  With `f(y) = arctan(⟨y,e⟩/⟨y,a⟩)`, the cutoff `ζ` of `idtp_cse_rc_cone_cutoff` and
`h = ψ(f)·l(|·|)·ζ`, take `g = 1_U·h` for `U = {⟨y,a⟩ > 0}`.  Where `h ≠ 0` in `U`, the support
hypotheses on `ψ`, `l` and `ζ` put `y` in `Z`, hence in the compact set
`K = {⟨y,a⟩ ≥ 1/2} ∩ B̄(0, 5/4) ⊆ U`; so `g` is `C¹` with compact support, `Dg = Dh` on `U` and
`Dg = 0` off `U`.  For `⟨x,v⟩ = 0`, `Dh(x)v = ψ(f x)·l(|x|)·Dζ(x)v + ζ(x)·l(|x|)·ψ'(f x)·Df(x)v`.
On `Z` the gap forces `|x − πx| < (s/2)|x|`, so `ζ(x) = 1` and `Dζ(x) = 0`; off `Z` the first term
vanishes by the gap and the second because its factors cannot all be nonzero. -/
theorem Submission.idtp_cse_rc_test_function : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (s : ℝ) (ψ l : ℝ → ℝ), Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → 0 < s → s ≤ 1 / 4 → ContDiff ℝ 1 ψ → ContDiff ℝ 1 l → tsupport ψ ⊆ Ioo (-s) s → tsupport l ⊆ Ioo (1 - s) (1 + s) → ∃ g : Euclid P → ℝ, ContDiff ℝ 1 g ∧ HasCompactSupport g ∧ (∀ x v : Euclid P, inner ℝ x v = 0 → (0 < inner ℝ x a → |‖x‖ - 1| < s → |Real.arctan (inner ℝ x e / inner ℝ x a)| < s → ‖x - Q.starProjection x‖ < s / 2 * ‖x‖ ∨ 2 * s * ‖x‖ < ‖x - Q.starProjection x‖) → x ∈ {y : Euclid P | 0 < inner ℝ y a ∧ |‖y‖ - 1| < s ∧ |Real.arctan (inner ℝ y e / inner ℝ y a)| < s ∧ ‖y - Q.starProjection y‖ < s * ‖y‖} → fderiv ℝ g x v = deriv ψ (Real.arctan (inner ℝ x e / inner ℝ x a)) * l ‖x‖ * (inner ℝ (inner ℝ x a • e - inner ℝ x e • a) v / ‖Q.starProjection x‖ ^ 2)) ∧ (∀ x v : Euclid P, inner ℝ x v = 0 → (0 < inner ℝ x a → |‖x‖ - 1| < s → |Real.arctan (inner ℝ x e / inner ℝ x a)| < s → ‖x - Q.starProjection x‖ < s / 2 * ‖x‖ ∨ 2 * s * ‖x‖ < ‖x - Q.starProjection x‖) → x ∉ {y : Euclid P | 0 < inner ℝ y a ∧ |‖y‖ - 1| < s ∧ |Real.arctan (inner ℝ y e / inner ℝ y a)| < s ∧ ‖y - Q.starProjection y‖ < s * ‖y‖} → fderiv ℝ g x v = 0) := by
  intro P Q a e s ψ l hQ ha he hna hne hae hs hs4 hψ hl hψs hls
  -- step 1: the cutoff `ζ`, the identity `|πy|² = ⟨y,a⟩² + ⟨y,e⟩²` and `Df` on `⟨x,a⟩ > 0`
  obtain ⟨ζ, hζC, hζ1, hζ0, hζD⟩ := Submission.idtp_cse_rc_cone_cutoff P Q s hs
  obtain ⟨hπ, hf⟩ := Submission.idtp_cse_rc_angle_fderiv P Q a e hQ ha he hna hne hae
  have hne0 : ∀ x : Euclid P, 0 < inner ℝ x a → x ≠ 0 := by
    rintro x hx rfl
    simp at hx
  -- `f(y) ∈ (-s, s)` where `ψ(f y) ≠ 0` or `ψ'(f y) ≠ 0`, and `||y| - 1| < s` where `l(|y|) ≠ 0`
  have hψ_lt : ∀ t : ℝ, ψ t ≠ 0 → |t| < s := fun t ht => abs_lt.2 (hψs (subset_tsupport ψ ht))
  have hψ'_lt : ∀ t : ℝ, deriv ψ t ≠ 0 → |t| < s := fun t ht =>
    abs_lt.2 (hψs (support_deriv_subset ht))
  have hl_lt : ∀ y : Euclid P, l ‖y‖ ≠ 0 → |‖y‖ - 1| < s := fun y hy => by
    obtain ⟨h1, h2⟩ := hls (subset_tsupport l hy)
    exact abs_lt.2 ⟨by linarith, by linarith⟩
  -- `ζ(y) ≠ 0` forces `|y − πy| < s|y|` (by (c))
  have hζ_lt : ∀ y : Euclid P, y ≠ 0 → ζ y ≠ 0 → ‖y - Q.starProjection y‖ < s * ‖y‖ :=
    fun y hy hζy => lt_of_not_ge fun hc => hζy (hζ0 y hy hc)
  -- step 2: `h = ψ(f)·l(|·|)·ζ`, extended by zero off `U = {⟨y,a⟩ > 0}`
  set U : Set (Euclid P) := {y | 0 < inner ℝ y a}
  set K : Set (Euclid P) := {y | 1 / 2 ≤ inner ℝ y a} ∩ closedBall 0 (5 / 4)
  set h : Euclid P → ℝ := fun y => ψ (Real.arctan (inner ℝ y e / inner ℝ y a)) * l ‖y‖ * ζ y
  have hU : IsOpen U := isOpen_lt continuous_const (by fun_prop)
  have hK : IsCompact K :=
    (isCompact_closedBall 0 (5 / 4)).inter_left (isClosed_le continuous_const (by fun_prop))
  have hKU : K ⊆ U := fun y hy => lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2) hy.1
  -- step 7: `h` is `C¹` at each point of `U`
  have hC : ∀ x ∈ U, ContDiffAt ℝ 1 h x := fun x hx =>
    ((hψ.contDiffAt.comp x (hf x hx).1).mul
      (hl.contDiffAt.comp x (contDiffAt_norm ℝ (hne0 x hx)))).mul (hζC x (hne0 x hx))
  -- steps 3–5: where `h ≠ 0` in `U`, `y ∈ Z`, so `⟨y,a⟩ > 1/2` and `|y| < 5/4`
  have hsupp : ∀ y ∈ U, h y ≠ 0 → y ∈ K := by
    intro y hy hhy
    have h1 : ψ (Real.arctan (inner ℝ y e / inner ℝ y a)) ≠ 0 := fun h0 => hhy (by simp [h, h0])
    have h2 : l ‖y‖ ≠ 0 := fun h0 => hhy (by simp [h, h0])
    have h3 : ζ y ≠ 0 := fun h0 => hhy (by simp [h, h0])
    obtain ⟨hya, hyn⟩ := Submission.idtp_cse_rc_tf_support_bound P Q a e y s hs hs4 (hπ y) hy
      (hl_lt y h2) (hψ_lt _ h1) (hζ_lt y (hne0 y hy) h3)
    exact ⟨hya.le, mem_closedBall_zero_iff.2 hyn.le⟩
  obtain ⟨hg, hgc, hDin, hDout⟩ :=
    Submission.idtp_cse_rc_tf_indicator_extension P U K h hU hK hKU hC hsupp
  -- step 8, formula (★): for `⟨x,a⟩ > 0` and `⟨x,v⟩ = 0` the radial term drops
  have hprod : ∀ x v : Euclid P, 0 < inner ℝ x a → inner ℝ x v = 0 →
      fderiv ℝ h x v = ψ (Real.arctan (inner ℝ x e / inner ℝ x a)) * l ‖x‖ * fderiv ℝ ζ x v +
        ζ x * l ‖x‖ * (deriv ψ (Real.arctan (inner ℝ x e / inner ℝ x a)) *
          (inner ℝ (inner ℝ x a • e - inner ℝ x e • a) v / ‖Q.starProjection x‖ ^ 2)) := by
    intro x v hxa hxv
    rw [← (hf x hxa).2 v]
    exact Submission.idtp_cse_rc_tf_product_fderiv P
      (fun y => Real.arctan (inner ℝ y e / inner ℝ y a)) ζ ψ l x v (hne0 x hxa) hxv
      (hf x hxa).1.differentiableAt_one (hψ.differentiable_one _) (hl.differentiable_one _)
      (hζC x (hne0 x hxa)).differentiableAt_one
  refine ⟨U.indicator h, hg, hgc, ?_, ?_⟩
  · -- step 9: on `Z` the gap forces `|x − πx| < (s/2)|x|`, so `ζ(x) = 1` and `Dζ(x) = 0`
    intro x v hxv hgap hxZ
    obtain ⟨hxa, hx1, hfx, hq⟩ := hxZ
    have hx0 := hne0 x hxa
    have hsx : 0 < s * ‖x‖ := mul_pos hs (norm_pos_iff.2 hx0)
    have hq2 : ‖x - Q.starProjection x‖ < s / 2 * ‖x‖ := by
      rcases hgap hxa hx1 hfx with hq' | hq'
      · exact hq'
      · exact absurd hq' (by linarith)
    rw [hDin x hxa, hprod x v hxa hxv, hζ1 x hx0 hq2.le, hζD x hx0 (Or.inl hq2),
      zero_apply]
    ring
  · -- step 10: off `Z` both terms of (★) vanish
    intro x v hxv hgap hxZ
    by_cases hxa : 0 < inner ℝ x a
    · have hx0 := hne0 x hxa
      have hsx : 0 < s * ‖x‖ := mul_pos hs (norm_pos_iff.2 hx0)
      rw [hDin x hxa, hprod x v hxa hxv]
      -- first term: where `ψ(f x)·l(|x|) ≠ 0` the gap gives `Dζ(x) = 0` by (d)
      have t1 : ψ (Real.arctan (inner ℝ x e / inner ℝ x a)) * l ‖x‖ * fderiv ℝ ζ x v = 0 := by
        by_cases h1 : ψ (Real.arctan (inner ℝ x e / inner ℝ x a)) = 0
        · simp [h1]
        by_cases h2 : l ‖x‖ = 0
        · simp [h2]
        rw [hζD x hx0 ?_, zero_apply, mul_zero]
        rcases hgap hxa (hl_lt x h2) (hψ_lt _ h1) with hq | hq
        · exact Or.inl hq
        · exact Or.inr (by linarith)
      -- second term: `ζ(x)`, `l(|x|)`, `ψ'(f x)` all nonzero would put `x` in `Z`
      have t2 : ζ x * l ‖x‖ * (deriv ψ (Real.arctan (inner ℝ x e / inner ℝ x a)) *
          (inner ℝ (inner ℝ x a • e - inner ℝ x e • a) v / ‖Q.starProjection x‖ ^ 2)) = 0 := by
        by_cases h3 : ζ x = 0
        · simp [h3]
        by_cases h2 : l ‖x‖ = 0
        · simp [h2]
        by_cases h4 : deriv ψ (Real.arctan (inner ℝ x e / inner ℝ x a)) = 0
        · simp [h4]
        exact absurd ⟨hxa, hl_lt x h2, hψ'_lt _ h4, hζ_lt x hx0 h3⟩ hxZ
      rw [t1, t2, add_zero]
    · rw [hDout x hxa, zero_apply]

/-- **Rotation conservation on a cone sector** (Simon Ch. 4, 2.2–2.6: first variation of the
stationary `V = v(M, θ)` along a rotation field, as in the proof of 7.3.3(1)).  Let `(a, e)` be an
orthonormal basis of the 2-plane `Q`, `A y = ⟨y,a⟩e − ⟨y,e⟩a`, `f(y) = arctan(⟨y,e⟩/⟨y,a⟩)`,
`G(x) = |p_{TₓM}(Ax)|²/|πx|²` and `Z = {⟨x,a⟩ > 0, ||x| − 1| < s, |f(x)| < s, |x − πx| < s|x|}`.
If `V` is stationary, `p_{TₓM} x = x` and the gap condition hold `μ_V`-a.e., then
`ψ'(f)·l(|·|)·G` is `μ_V`-integrable on `Z` with integral `0`.
* With `g` from `idtp_cse_rc_test_function`, `X = gA` is `C¹` with compact support, so
  `0 = δV(X) = ∫_M θ div_M X dH²`, and `div_M X(x) = Dg(x)(p_{TₓM}(Ax))`
  (`idtp_cse_rc_rotation_divergence`).
* `μ_V`-a.e., `⟨x, p_{TₓM}(Ax)⟩ = ⟨p_{TₓM} x, Ax⟩ = ⟨x, Ax⟩ = 0` and
  `⟨Ax, p_{TₓM}(Ax)⟩ = |p_{TₓM}(Ax)|²`, so the derivative formulas of `g` give
  `Dg(x)(p_{TₓM}(Ax)) = 1_Z(x)·ψ'(f(x))·l(|x|)·G(x)`; as `μ_V = θ H²⌞M`, this yields
  `∫_Z ψ'(f)·l(|·|)·G dμ_V = δV(X) = 0`.
* `x ↦ p_{TₓM}` is `H²⌞M`-a.e. strongly measurable (`TₓM` is a.e. the plane oriented by `ξ(x)`,
  and the projection onto the plane of a unit simple 2-vector is a Borel function of it),
  `0 ≤ G ≤ 1` since `|Ax| = |πx|`, and `μ_V(Z) ≤ μ_V(B̄₂(0)) < ∞`. -/
theorem Submission.idtp_cse_rotation_conservation : ∀ (P : ℕ) (R : IMRep (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (s : ℝ), Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → 0 < s → s ≤ 1 / 4 → (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → R.firstVariation X = 0) → (∀ᵐ x ∂R.measure, (approxTangentPlane 2 R.carrier x).starProjection x = x) → (∀ᵐ x ∂R.measure, 0 < inner ℝ x a → |‖x‖ - 1| < s → |Real.arctan (inner ℝ x e / inner ℝ x a)| < s → ‖x - Q.starProjection x‖ < s / 2 * ‖x‖ ∨ 2 * s * ‖x‖ < ‖x - Q.starProjection x‖) → ∀ ψ l : ℝ → ℝ, ContDiff ℝ 1 ψ → ContDiff ℝ 1 l → tsupport ψ ⊆ Ioo (-s) s → tsupport l ⊆ Ioo (1 - s) (1 + s) → IntegrableOn (fun x : Euclid P => deriv ψ (Real.arctan (inner ℝ x e / inner ℝ x a)) * l ‖x‖ * (‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2)) {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} R.measure ∧ ∫ x in {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖}, deriv ψ (Real.arctan (inner ℝ x e / inner ℝ x a)) * l ‖x‖ * (‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2) ∂R.measure = 0 := by
  intro P R Q a e s hQ ha he hna hne hae hs hs4 hstat htan hgap ψ l hψ hl hψs hls
  classical
  -- step 6, measurability: `x ↦ p_{TₓM}` is `Hⁿ⌞M`-a.e. strongly measurable.  `TₓM` is a.e. the
  -- plane oriented by `ξ(x)`, and the projection onto the plane of a unit simple `n`-vector is a
  -- Borel function of it (the argument of `Submission.imrep_approxTangent_starProjection_aesm`)
  have haesm : ∀ (n : ℕ) (R : IMRep (univ : Set (Euclid P)) n),
      AEStronglyMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection)
        (μHE[n].restrict R.carrier) := by
    intro n R
    classical
    -- `ev τ = (α ↦ α(τ₁, …, τₙ))`, a continuous alternating map of `τ`
    let ev : Euclid P [⋀^Fin n]→L[ℝ] MultiVector P n :=
      (ContinuousLinearMap.id ℝ (Covector (Euclid P) n)).flipAlternating
    have hev : ∀ (τ : Fin n → Euclid P) (α : Covector (Euclid P) n), ev τ α = α τ :=
      fun τ α => rfl
    -- `Φ(τ, s) = s τ₁ ∧ ⋯ ∧ τₙ` on the compact set `Ω` of orthonormal frames and signs `s = ±1`
    let Φ : (Fin n → Euclid P) × ℝ → MultiVector P n := fun ω => ω.2 • ev ω.1
    have hΦc : Continuous Φ := continuous_snd.smul (ev.coe_continuous.comp continuous_fst)
    let Ω : Set ((Fin n → Euclid P) × ℝ) := {τ | Orthonormal ℝ τ} ×ˢ {1, -1}
    have hΩ : IsCompact Ω := by
