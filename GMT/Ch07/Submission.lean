  refine ⟨s, t, u, hs, ht0, hsδ, huC, hu0,
    fun a ha => ⟨(hgood a ha).2.2.2.1.le, (hgood a ha).2.2.2.2⟩, hZopen, hMZ, hinjF,
    fun a ha => ⟨?_, ?_⟩, ?_⟩
  · -- `DF(a)` is injective: `π ∘ DF(a) = id`
    rw [(hFd a ha).fderiv]
    intro w w' h
    have := congrArg π h
    simpa [hπι, hπι'] using this
