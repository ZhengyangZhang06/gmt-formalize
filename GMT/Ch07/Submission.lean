                rw [hHimg, Nat.unpair_pair]; exact ⟨a, ⟨haG, hk⟩, rfl⟩⟩) hx
            · exact Or.inr (mem_iUnion.mpr ⟨i, a, ⟨haB, haG⟩, rfl⟩)
