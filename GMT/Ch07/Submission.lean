      have hu0 : ∀ y, 0 ≤ (u₁ + u₂) y := fun y => add_nonneg (hu₁0 y) (hu₂0 y)
      have huK : support (u₁ + u₂) ⊆ K₁ ∪ K₂ := fun y hy => by
