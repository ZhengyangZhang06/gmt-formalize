        TendstoUniformlyOn Hs H atTop {y : Euclid (N + 1) | ∃ t ∈ Icc (0 : ℝ) 1, ∃ x ∈ K,
          y = WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x))} ∧
