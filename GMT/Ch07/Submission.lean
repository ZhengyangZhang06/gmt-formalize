    clear cmcdtfrfg_cube_volume cmcdtfr_face_geometry cmcdtfrbv_cutoff_field cmr_cc_det_covector_basis_kronecker cmr_cc_det_covector_exists cmcdtfrbv_face_covectors hVO hMR hIMC
