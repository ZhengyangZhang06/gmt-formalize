  have hDc : Continuous (fderiv ℝ g) := hg.continuous_fderiv (by simp)
  have hDcs : HasCompactSupport (fderiv ℝ g) := hgc.fderiv ℝ
  obtain ⟨KD, hKD⟩ := hDc.bounded_above_of_compact_support hDcs
