            K * ρ ^ (2 * α) * (∫ z in ball x ρ, ‖fderiv ℝ u z‖ ^ 2) + K * ρ ^ ((m : ℝ) + 2 * α) := by
          rw [hvol, hrpow]
          have e1 : 3 * ε₁ ^ 2 * (∫ z in ball x ρ, ‖fderiv ℝ u z - avg‖ ^ 2) ≤
