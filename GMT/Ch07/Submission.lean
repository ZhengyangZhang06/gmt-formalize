      intro x hx
      have h : R0 ^ 2 < ‖x‖ ^ 2 := pow_lt_pow_left₀ hx hR0.le two_ne_zero
      exact ⟨hcut _ h.le, hcut' _ h⟩
    have hcs : ∀ f : Euclid P → ℝ, Continuous f → (∀ x : Euclid P, R0 < ‖x‖ → f x = 0) →
