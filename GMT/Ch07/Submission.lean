    intro j f hf
    have e2 : inner ℝ (toH₀ f) (z j) = ∫ x, inner ℝ (f x) (z j x) ∂μ := by
      rw [hip]
      refine integral_congr_ae ?_
      filter_upwards [hcoe f hf] with x hx
      rw [hx]
    rw [← e2]
    refine ((tendsto_const_nhds (x := toH₀ f)).inner (𝕜 := ℝ)
