    (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ' (W ∩ {x | t - h < f x ∧ f x < t}))
  rw [hbd d (A t) (B t)]
  refine (add_le_add (hmass W t hW) hB').trans ?_
