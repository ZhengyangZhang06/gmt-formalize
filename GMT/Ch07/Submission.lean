      inner ℝ (toH u) (toH v) = ∫ x, ∑ j, inner ℝ (u j x) (v j x) ∂μ := fun u v hu hv => by
    rw [PiLp.inner_apply, integral_finsetSum _ fun j _ => hinner _ _ (hu j) (hv j)]
