      · intro z
        rw [map_add, hpq, add_zero, hpπ]

    -- **the pieces**: `M` is, up to a null set, the disjoint union of the `H k '' Ω k`
    obtain ⟨H, Ω, hHL, hΩm, hHbil, hHM, hdisj, hnull, hpH⟩ : ∃ (H : ℕ → V → F) (Ω : ℕ → Set V),
