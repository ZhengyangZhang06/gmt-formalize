        rw [hK₁_def, hωeq, ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity)]
      rw [h]
      exact hhole.trans (by gcongr)
    -- `C_b/(βL)² + 2^{n/2}ω15ⁿC₉(C_b/(βL)² + 1) ≤ C₇/L²`, as `(βL)² ≤ 1`
