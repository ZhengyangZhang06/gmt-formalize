    intro a ha b hb
    rw [mem_ball, dist_eq_norm]
    have : y + ι a + ι' b - y = ι a + ι' b := by abel
    rw [this]
    calc ‖ι a + ι' b‖ ≤ ‖ι a‖ + ‖ι' b‖ := norm_add_le _ _
      _ = ‖a‖ + ‖b‖ := by rw [ι.norm_map, ι'.norm_map]
      _ < s + t := add_lt_add (mem_ball_zero_iff.1 ha) (mem_ball_zero_iff.1 hb)
      _ ≤ r₀ := hsr₀
