        (hp.lipschitzOnWith (s := (fun y : EuclideanSpace ℝ (Fin n) =>
          (WithLp.toLp 2 (f y, ε • y) :
            WithLp 2 (EuclideanSpace ℝ (Fin P) × EuclideanSpace ℝ (Fin n)))) '' s))
