      · refine measure_mono_null (t := (M \ ⋃ i, Fp i '' Bp i) ∪ ⋃ i, Fp i '' (Bp i \ G i)) ?_
          (measure_union_null hFnull (measure_iUnion_null fun i => ?_))
        · rintro x ⟨hxM, hx⟩
          by_cases hxF : x ∈ ⋃ i, Fp i '' Bp i
