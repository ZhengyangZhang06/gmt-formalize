        cmr_cc_det_covector_basis_kronecker P m (J j') I (θ j') (hJmono j') hI (hθ j')]
      split_ifs
      · rw [smul_eq_mul, smul_eq_mul, mul_one, mul_comm]
      · rw [smul_zero, smul_zero]
