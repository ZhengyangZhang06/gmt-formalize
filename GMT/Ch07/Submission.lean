      ∀ j : Fin m, ∫ x, inner ℝ (fderiv ℝ Φ x (EuclideanSpace.single j (1 : ℝ))) (f x) ∂μ =
        -∫ x, inner ℝ (Φ x) (fderiv ℝ f x (EuclideanSpace.single j (1 : ℝ))) ∂μ := by
    intro U f Φ hU hBU hf hΦ hΦc hΦB j
