        obtain ⟨K, hK_def⟩ : ∃ K : ℝ, CH * lam / (R / 2) = K := ⟨_, rfl⟩
        have hK : 0 ≤ K := hK_def ▸ hK
        rw [hK_def]
        have hTay : ∀ y ∈ ball x₀ (R / 2), ∀ v : Euclid m, ‖v‖ ≤ R / 8 →
