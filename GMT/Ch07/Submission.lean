    have hj : ∫ x, ‖fderiv ℝ ζ x (EuclideanSpace.single j₀ (1 : ℝ))‖ ^ 2 ∂μ ≤
        ∫ x, ∑ j : Fin m, ‖fderiv ℝ ζ x (EuclideanSpace.single j (1 : ℝ))‖ ^ 2 ∂μ :=
