          intro h₁ hh₁
          have : sSup (S '' A u₂) ≤ sSup (S '' A (u₁ + u₂)) - S h₁ := by
            apply hsup_le u₂ hu₂0
            intro h₂ hh₂
            have := key h₁ hh₁ h₂ hh₂
            linarith
          linarith
