        ((ContinuousLinearMap.apply ℝ ℝ (b i)).continuous.comp_stronglyMeasurable
          (hΓ2m.comp_measurable hφ)).measurable
        ((ContinuousLinearMap.apply ℝ ℝ (b i)).continuous.comp_stronglyMeasurable
          (hΓ2m.comp_measurable hψ)).measurable
