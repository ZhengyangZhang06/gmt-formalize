      (hD.continuousOn_fderiv_of_isOpen isOpen_ball le_rfl).clm_apply continuousOn_const
    have hκ : ∀ κ : Fin k, ∀ᵐ x ∂μ, inner ℝ (EuclideanSpace.single κ (1 : ℝ))
