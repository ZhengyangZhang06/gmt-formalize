`Q₀ = ∑ Vⱼ`, `R₁ = ∑ Hⱼ`, `S₁ = ∑ E'ⱼ`, and the telescoping gives `T − Q₀ − S₁ = ∂R₁`. -/
theorem Submission.cmcsd_telescoping_deformation : (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → ∀ (P m : ℕ) (push : ∀ k : ℕ, (Euclid P → Euclid P) → GeometricCurrentOn (univ : Set (Euclid P)) k → GeometricCurrentOn (univ : Set (Euclid P)) k) (homot : ∀ k : ℕ, (Euclid P → Euclid P) → (Euclid P → Euclid P) → GeometricCurrentOn (univ : Set (Euclid P)) k → GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)), ((∀ (k : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) k), IsCompact X.support → X.mass < ∞ → boundaryMassOn X univ < ∞ → push k (fun x => x) X = X) ∧ (∀ (k : ℕ) (Λ : NNReal) (F G : Euclid P → Euclid P) (X Y : GeometricCurrentOn (univ : Set (Euclid P)) k), LipschitzWith Λ F → LipschitzWith Λ G → IsCompact X.support → X.mass < ∞ → boundaryMassOn X univ < ∞ → IsCompact Y.support → Y.mass < ∞ → boundaryMassOn Y univ < ∞ → push k F (X - Y) = push k F X - push k F Y ∧ homot k F G (X - Y) = homot k F G X - homot k F G Y) ∧ (∀ (k : ℕ) (Λ : NNReal) (F G F' G' : Euclid P → Euclid P) (X : GeometricCurrentOn (univ : Set (Euclid P)) k), LipschitzWith Λ F → LipschitzWith Λ G → LipschitzWith Λ F' → LipschitzWith Λ G' → IsCompact X.support → X.mass < ∞ → boundaryMassOn X univ < ∞ → EqOn F F' X.support → EqOn G G' X.support → push k F X = push k F' X ∧ homot k F G X = homot k F' G' X) ∧ (∀ (k : ℕ) (Λ : NNReal) (F G : Euclid P → Euclid P) (X : GeometricCurrentOn (univ : Set (Euclid P)) k), LipschitzWith Λ F → LipschitzWith Λ G → IsCompact X.support → X.mass < ∞ → boundaryMassOn X univ < ∞ → (push k F X).mass ≤ (Λ : ℝ≥0∞) ^ k * X.mass ∧ (push k F X).support ⊆ F '' X.support ∧ (∀ δ : ℝ, (∀ x ∈ X.support, dist (F x) (G x) ≤ δ) → (homot k F G X).mass ≤ ENNReal.ofReal δ * (2 * (Λ : ℝ≥0∞)) ^ k * X.mass) ∧ (homot k F G X).support ⊆ {y : Euclid P | ∃ x ∈ X.support, ∃ t ∈ Icc (0 : ℝ) 1, y = F x + t • (G x - F x)}) ∧ (∀ (k : ℕ) (Λ : NNReal) (F G : Euclid P → Euclid P) (X : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)), LipschitzWith Λ F → LipschitzWith Λ G → IsCompact X.support → X.mass < ∞ → X.boundary.mass < ∞ → (push (k + 1) F X).boundary = push k F X.boundary ∧ push (k + 1) G X - push (k + 1) F X - homot k F G X.boundary = (homot (k + 1) F G X).boundary ∧ (IsIntegerMultiplicity X → IsIntegerMultiplicity (push (k + 1) F X) ∧ IsIntegerMultiplicity (homot (k + 1) F G X))) ∧ ∀ (Λ : NNReal) (F G : Euclid P → Euclid P) (X : GeometricCurrentOn (univ : Set (Euclid P)) 0), LipschitzWith Λ F → LipschitzWith Λ G → IsCompact X.support → X.mass < ∞ → push 0 G X - push 0 F X = (homot 0 F G X).boundary) → (∀ (k : ℕ) (W : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (k + 1)), ∑' i, (W i).mass < ∞ → ∃ S : GeometricCurrentOn (univ : Set (Euclid P)) (k + 1), (∀ ω : TestFormOn (univ : Set (Euclid P)) (k + 1), HasSum (fun i => W i ω) (S ω)) ∧ S.mass ≤ ∑' i, (W i).mass ∧ S.support ⊆ closure (⋃ i, (W i).support) ∧ ((∀ i, IsIntegerMultiplicity (W i)) → IsIntegerMultiplicity S)) → ∀ (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (W : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (D Z : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) m) (φ : ℕ → Euclid P → Euclid P) (Λ : ℕ → NNReal) (δ : ℝ) (L A A' : Set (Euclid P)), (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), HasSum (fun j => W j ω) (T ω)) → (W 0).boundary = D 0 - Z 0 → (∀ j, (W (j + 1)).boundary = D (j + 1) - (Z (j + 1) - Z j)) → (∀ j, IsIntegerMultiplicity (W j)) → (∀ j, IsCompact (W j).support ∧ (W j).mass < ∞ ∧ (W j).boundary.mass < ∞) → (∀ j, IsCompact (D j).support ∧ (D j).mass < ∞ ∧ boundaryMassOn (D j) univ < ∞) → (∀ j, IsCompact (Z j).support ∧ (Z j).mass < ∞ ∧ boundaryMassOn (Z j) univ < ∞) → (∀ j, LipschitzWith (Λ j) (φ j)) → (∀ j, 1 ≤ Λ j) → (∀ j, Λ j ≤ Λ (j + 1)) → (∀ j, EqOn (φ (j + 1)) (φ j) (Z j).support) → (∀ j, ∀ x ∈ (W j).support ∪ (D j).support ∪ (Z j).support, dist (φ j x) x ≤ δ) → IsClosed L → (∀ j, ∀ x ∈ (W j).support, φ j x ∈ L) → (∀ j, (W j).support ⊆ A) → (∀ j, (D j).support ⊆ A') → ∑' j, (2 * (Λ j : ℝ≥0∞)) ^ (m + 1) * (W j).mass < ∞ → ∑' j, (2 * (Λ j : ℝ≥0∞)) ^ m * (D j).mass < ∞ → Tendsto (fun j => (2 * (Λ j : ℝ≥0∞)) ^ m * (Z j).mass) atTop (𝓝 0) → ∃ (Q₀ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R₁ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S₁ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q₀ ∧ IsIntegerMultiplicity R₁ ∧ T - Q₀ - S₁ = R₁.boundary ∧ Q₀.support ⊆ L ∩ cthickening δ A ∧ R₁.support ⊆ cthickening δ A ∧ Q₀.boundary.support ⊆ cthickening δ A' ∧ S₁.support ⊆ cthickening δ A' ∧ Q₀.mass ≤ ∑' j, (2 * (Λ j : ℝ≥0∞)) ^ (m + 1) * (W j).mass ∧ Q₀.boundary.mass ≤ ∑' j, (2 * (Λ j : ℝ≥0∞)) ^ m * (D j).mass ∧ R₁.mass ≤ ENNReal.ofReal δ * ∑' j, (2 * (Λ j : ℝ≥0∞)) ^ (m + 1) * (W j).mass ∧ S₁.mass ≤ ENNReal.ofReal δ * ∑' j, (2 * (Λ j : ℝ≥0∞)) ^ m * (D j).mass := by
  intro hVO P m push homot hPF hIMS T W D Z φ Λ δ L A A' hT hW0 hWs hIM hWnc hDnc hZnc hLip h1
    hmono hEq hdist hL hφL hWA hDA hsumW hsumD hZ
  -- Step 1: support calculus in degree `m`: (i) `X` vanishing off a closed `E` has `spt X ⊆ E`,
  -- (ii) `spt X` is closed, (iii) `spt (A − B) ⊆ spt A ∪ spt B`
  obtain ⟨hS1, hS2, hS3, -, -⟩ := Submission.cmcsd_support_calculus P m
  -- Step 2: the deformed shells satisfy the homotopy identities and the mass and support bounds
  obtain ⟨c1, c2, c3, c4, c5, c6, c7⟩ := Submission.cmcsdtd_shell_deformation P m push homot hPF
    hS2 hS3 W D Z φ Λ δ L A A' hW0 hWs hIM hWnc hDnc hZnc hLip h1 hmono hEq hdist hφL hWA hDA
  -- Step 3: sum the deformed series; `L ∩ cthickening δ A`, `cthickening δ A`, `cthickening δ A'`
  -- are closed
  exact Submission.cmcsdtd_deformed_series_sum hVO P m hS1 hIMS T W
    (fun j => push (m + 1) (φ j) (W j)) (fun j => homot m (φ j) (fun x => x) (D j))
    (fun j => homot m (φ j) (fun x => x) (Z j)) (fun j => homot (m + 1) (φ j) (fun x => x) (W j))
    (fun j => push m (φ j) (D j)) (fun j => push m (φ j) (Z j))
    (fun j => (2 * (Λ j : ℝ≥0∞)) ^ (m + 1) * (W j).mass)
    (fun j => (2 * (Λ j : ℝ≥0∞)) ^ m * (D j).mass) (fun j => (2 * (Λ j : ℝ≥0∞)) ^ m * (Z j).mass)
    δ (L ∩ cthickening δ A) (cthickening δ A) (cthickening δ A') hT c1 c2 c3 c4 c5 c6 hsumW
    hsumD hZ (hL.inter isClosed_cthickening) isClosed_cthickening isClosed_cthickening c7
/-- **Extension by zero** (steps 6.2–6.6 of the localization in the proof of Simon 7.3.1).  Let
`V ⊆ U` be open, `K ⊆ V` compact and `X = τ(M, θ, ξ) ∈ 𝒟ₙ(V)` with `Hⁿ(M \ K) = 0`.  Move the
representation to `U` with carrier in `K` and let `Y ∈ 𝒟ₙ(U)` be the current it defines.  Then
`Y⌞V = X`; `Y` kills every form whose support misses `K`, so `spt Y = K \ Z_Y` is a compact subset
of `K`; and if `∂X = 0`, then for a cutoff `χ ∈ C^∞_c(V)` equal to `1` near `K` we get
`∂Y(ω) = Y(dω) = X(d(χω)) = ∂X(χω) = 0`, since `d(χω) = dω` near the carrier. -/
theorem Submission.dtc_extend_by_zero : ∀ (P n : ℕ) (U V K : Set (Euclid P)) (hVU : V ⊆ U) (X : GeometricCurrentOn V n) (R : IMRep V n), IsOpen U → IsOpen V → IsCompact K → K ⊆ V → R.Represents X → μHE[n] (R.carrier \ K) = 0 → ∃ Y : GeometricCurrentOn U n, Y.restrictDomain hVU = X ∧ Y.support ⊆ K ∧ IsCompact Y.support ∧ (BoundaryVanishes X → BoundaryVanishes Y) ∧ IsIntegerMultiplicity Y := by
  intro P n U V K hVU X R hU hV hK hKV hRX hnull
  -- Step 1: move `R` to `U`, with carrier in `K` and the same action
  obtain ⟨R', hR'K, hR'R⟩ :=
    Submission.dtc_imrep_of_null_off_compact P n U V K R hK hKV (hKV.trans hVU) hnull
  -- Step 2: `Y = τ(R')`, which is integer multiplicity
  obtain ⟨Y, hY⟩ := Submission.dtc_imrep_current P n U R'
  -- Step 4: `Y` vanishes on forms whose support misses `K`
  have hvan : ∀ ω : TestFormOn U n,
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) K → Y ω = 0 := by
    intro ω hω
    rw [hY ω, IMRep.action]
    refine setIntegral_eq_zero_of_forall_eq_zero fun x hx => ?_
    rw [image_eq_zero_of_notMem_tsupport (Set.disjoint_right.mp hω (hR'K hx)), map_zero,
      mul_zero]
  -- Step 5: `spt Y ⊆ K`; a point of `U \ K` has a ball `W ⊂⊂ U \ K` on which `Y` vanishes
  have hspt : Y.support ⊆ K := by
    rintro q ⟨hqU, hqZ⟩
    by_contra hqK
    obtain ⟨r, hr, hrUK⟩ := Metric.isOpen_iff.mp (hU.sdiff hK.isClosed) q ⟨hqU, hqK⟩
    have hcl : closure (ball q (r / 2)) ⊆ ball q r :=
      closure_ball_subset_closedBall.trans (closedBall_subset_ball (half_lt_self hr))
    refine hqZ (mem_sUnion.mpr ⟨ball q (r / 2), ⟨isOpen_ball,
      (isCompact_closedBall q (r / 2)).of_isClosed_subset isClosed_closure
        closure_ball_subset_closedBall,
      hcl.trans (hrUK.trans sdiff_subset), fun ω hω => hvan ω ?_⟩, mem_ball_self (half_pos hr)⟩)
    exact disjoint_sdiff_left.mono_left (hω.trans (subset_closure.trans (hcl.trans hrUK)))
  -- Step 6: `spt Y = K \ Z_Y` is compact
  have hcpt : IsCompact Y.support := by
    have heq : Y.support = K \ Y.zeroRegion :=
      Subset.antisymm (fun x hx => ⟨hspt hx, hx.2⟩) fun x hx => ⟨hVU (hKV hx.1), hx.2⟩
    rw [heq]
    exact hK.diff Y.isOpen_zeroRegion
  -- Step 3: `Y⌞V = X`, since `R'` and `R` have the same action
  have hres : Y.restrictDomain hVU = X := by
    ext ω
    rw [GeometricCurrentOn.restrictDomain_apply, hY (testFormOnInclusion hVU n ω),
      testFormOnInclusion_coe, hR'R, hRX ω]
  refine ⟨Y, hres, hspt, hcpt, ?_, ⟨R', hY⟩⟩
  -- Step 7: `∂X = 0 → ∂Y = 0` (trivial in degree `0`)
  rcases n with _ | m
  · exact fun _ => trivial
  intro hX
  change X.boundary = 0 at hX
  change Y.boundary = 0
  -- Step 7.1: a cutoff `χ ∈ C^∞_c(V)` equal to `1` on an open set `O ⊇ K`
  obtain ⟨δ, hδ, hδV⟩ := hK.exists_cthickening_subset_open hV hKV
  obtain ⟨χ, hχ1, hχ0, -⟩ := exists_contMDiffMap_one_nhds_of_subset_interior
    (modelWithCornersSelf ℝ (Euclid P)) (n := ⊤) hK.isClosed
    ((self_subset_thickening hδ K).trans (thickening_subset_interior_cthickening δ K))
  have hχs : ContDiff ℝ (⊤ : ℕ∞) χ := contMDiff_iff_contDiff.mp χ.contMDiff
  have hχsupp : tsupport χ ⊆ cthickening δ K :=
    closure_minimal (fun x hx => by_contra fun h => hx (hχ0 x h)) isClosed_cthickening
  have hχc : HasCompactSupport χ :=
    hK.cthickening.of_isClosed_subset (isClosed_tsupport _) hχsupp
  obtain ⟨O, hO, hKO, hOχ⟩ := mem_nhdsSet_iff_exists.mp hχ1
  -- Step 7.2: `χω ∈ 𝒟^m(V)` for `ω ∈ 𝒟^m(U)`
  have hcut : ∀ ω : TestFormOn U m,
      (fun x => χ x • (ω : DifferentialForm (Euclid P) m) x) ∈ testFormOnSubmodule V m :=
    fun ω => ⟨⟨hχs.smul ω.property.1.1, hχc.smul_right⟩,
      (tsupport_smul_subset_left _ _).trans (hχsupp.trans hδV)⟩
  -- Step 7.4: `∂Y(ω) = R'(dω) = R'(d(χω)) = R(d(χω)) = X(d(χω)) = ∂X(χω) = 0`
  ext ω
  rw [GeometricCurrentOn.zero_apply, GeometricCurrentOn.boundary_apply,
    hY (exteriorDerivativeTestOn U m ω)]
  have hd : R'.action (exteriorDerivativeTestOn U m ω : DifferentialForm (Euclid P) (m + 1)) =
      R'.action (exteriorDerivativeTestOn V m ⟨_, hcut ω⟩ :
        DifferentialForm (Euclid P) (m + 1)) := by
    unfold IMRep.action
    refine setIntegral_congr_fun R'.measurableSet_carrier fun x hx => ?_
    -- Step 7.3: `χω = ω` near `x ∈ M' ⊆ K ⊆ O`, so `d(χω)(x) = dω(x)`
    have hloc : (fun y => χ y • (ω : DifferentialForm (Euclid P) m) y) =ᶠ[𝓝 x]
        (ω : DifferentialForm (Euclid P) m) :=
      Filter.eventuallyEq_of_mem (hO.mem_nhds (hKO (hR'K hx))) fun y hy => by
        rw [show χ y = 1 from hOχ hy, one_smul]
    show (R'.mult x : ℝ) * R'.orient x (extDeriv (ω : DifferentialForm (Euclid P) m) x) =
      (R'.mult x : ℝ) * R'.orient x
        (extDeriv (fun y => χ y • (ω : DifferentialForm (Euclid P) m) y) x)
    rw [hloc.extDeriv_eq]
  rw [hd, hR'R, ← hRX, ← GeometricCurrentOn.boundary_apply, hX, GeometricCurrentOn.zero_apply]
/-- **Simon 7.2 (proof), cutoff** (an extension to `ℝᴾ` supported in a compact `K ⊂ U` has no
more mass or boundary mass than its restriction to `U`).  Let `X ∈ 𝒟ₘ₊₁(U)` and
`Y ∈ 𝒟ₘ₊₁(ℝᴾ)` with `Y(ιη) = X(η)` for `η ∈ 𝒟ᵐ⁺¹(U)` and `spt Y ⊆ K`.  By Simon 6.2.11, `Y`
kills every `ω` with `spt ω ∩ K = ∅`, and so does `∂Y`, since `spt dω ⊆ spt ω`.  The cutoff
`X̂(ω) = X(ζω)`, `ζ = 1` near `K`, `spt ζ ⊆ U`, gives `M(Y) ≤ M_U(Y)` and `M(∂Y) ≤ M_U(∂Y)`.
Finally `Y`, `X` agree on test forms in `U`, and so do `∂Y`, `∂X`, because `d(ιη) = ι(dη)`;
hence `M_U(Y) = M_U(X) = M(X)` and `M_U(∂Y) = M_U(∂X) = M(∂X)`. -/
theorem Submission.cmc_fc_eu_cutoff_mass_le : ∀ (P m : ℕ) (U K : Set (Euclid P)) (X : GeometricCurrentOn U (m + 1)) (Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsOpen U → IsCompact K → K ⊆ U → Y.restrictDomain (subset_univ U) = X → Y.support ⊆ K → Y.mass ≤ X.mass ∧ Y.boundary.mass ≤ X.boundary.mass := by
  intro P m U K X Y hU hK hKU hYX hYK
  -- `Y(ω) = 0` when `spt ω ∩ K = ∅`, as `spt Y ⊆ K` (Simon 6.2.11)
  have hvan : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1),
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) K → Y ω = 0 :=
    fun ω hω => Submission.dtc_vanish_off_support P (m + 1) univ Y ω (hω.mono_right hYK)
  -- `∂Y(ω) = Y(dω) = 0` when `spt ω ∩ K = ∅`, as `spt dω ⊆ spt ω`
  have hvan' : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) K → Y.boundary ω = 0 := by
    intro ω hω
    rw [GeometricCurrentOn.boundary_apply]
    exact hvan _ (hω.mono_left (tsupport_exteriorDerivative_subset _))
  -- `Y(ιη) = X(η)`, and `∂Y(ιη) = Y(d(ιη)) = Y(ι(dη)) = X(dη) = ∂X(η)`
  have hagree : ∀ η : TestFormOn U (m + 1),
      Y (testFormOnInclusion (subset_univ U) (m + 1) η) = X η := by
    intro η
    rw [← hYX, GeometricCurrentOn.restrictDomain_apply]
  have hagree' : ∀ η : TestFormOn U m,
      Y.boundary (testFormOnInclusion (subset_univ U) m η) = X.boundary η := by
    intro η
    rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.boundary_apply,
      ← hagree (exteriorDerivativeTestOn U m η)]
    rfl
  constructor
  · -- `M(Y) ≤ M_U(Y) = M_U(X) = M(X)`
    calc Y.mass ≤ Y.massOn U :=
          Submission.lcmp_massOn_le_of_vanish_off_compact P (m + 1) univ U K Y hK hU hKU hvan univ
      _ = X.mass :=
          Submission.dtc_massOn_eq_of_agreeOn P (m + 1) univ U U (subset_univ U) Y X
            Subset.rfl fun η _ => hagree η
  · -- `M(∂Y) ≤ M_U(∂Y) = M_U(∂X) = M(∂X)`
    calc Y.boundary.mass ≤ Y.boundary.massOn U :=
          Submission.lcmp_massOn_le_of_vanish_off_compact P m univ U K Y.boundary hK hU hKU
            hvan' univ
      _ = X.boundary.mass :=
          Submission.dtc_massOn_eq_of_agreeOn P m univ U U (subset_univ U) Y.boundary X.boundary
            Subset.rfl fun η _ => hagree' η

/-- **Extension to `ℝᴾ`** (step 3(c) of the flat-convergence argument in the proof of Simon
7.2.4: a current supported in a compact `K ⊂ U` extends to `ℝᴾ` without increasing masses).  Let
`U` be open, `K ⊆ U` compact and `X = τ(M, θ, ξ) ∈ 𝒟_{m+1}(U)` with `spt X ⊆ K`.  Then
`Hⁿ(M \ K) ≤ Hⁿ(M \ spt X) = 0`, so extension by zero gives an integer multiplicity
`Y ∈ 𝒟_{m+1}(ℝᴾ)` with `Y⌞U = X` and `spt Y ⊆ K`.  For a cutoff `ζ ∈ C^∞_c(U; [0, 1])` equal to
`1` near `K` we get `Y(ω) = X(ζω)` and `∂Y(ω) = ∂X(ζω)`, with `|ζω| ≤ 1` whenever `|ω| ≤ 1`, so
`M(Y) ≤ M(X)` and `M(∂Y) ≤ M(∂X)`.  The two hypotheses (restricted representations, and mass
equal to the measure of a representation) are not needed. -/
theorem Submission.cmc_fc_extend_to_univ : (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ∀ (P m : ℕ) (U K : Set (Euclid P)) (X : GeometricCurrentOn U (m + 1)), IsOpen U → IsCompact K → K ⊆ U → IsIntegerMultiplicity X → X.support ⊆ K → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Y ∧ Y.restrictDomain (subset_univ U) = X ∧ Y.support ⊆ K ∧ Y.mass ≤ X.mass ∧ Y.boundary.mass ≤ X.boundary.mass := by
  intro _hIR _hME P m U K X hU hK hKU hX hspt
  -- Steps 1–2: a representation `R = (M, θ, ξ)` of `X` has `Hⁿ(M \ K) ≤ Hⁿ(M \ spt X) = 0`
  obtain ⟨R, hR⟩ := hX
  have hnull : μHE[m + 1] (R.carrier \ K) = 0 :=
    measure_mono_null (sdiff_subset_sdiff_right hspt)
      (Submission.imrep_carrier_sdiff_support_null P (m + 1) U X R hU hR)
  -- Steps 3–6: extension by zero to `ℝᴾ`: `Y⌞U = X`, `spt Y ⊆ K`, `Y` integer multiplicity
  obtain ⟨Y, hres, hsupp, -, -, hYIM⟩ := Submission.dtc_extend_by_zero P (m + 1) univ U K
    (subset_univ U) X R isOpen_univ hU hK hKU hR hnull
  -- Steps 7–8: the cutoff argument gives `M(Y) ≤ M(X)` and `M(∂Y) ≤ M(∂X)`
  obtain ⟨hm, hbm⟩ := Submission.cmc_fc_eu_cutoff_mass_le P m U K X Y hU hK hKU hres hsupp
  exact ⟨Y, hYIM, hres, hsupp, hm, hbm⟩

/-- **M-absolutely convergent series of currents** (Simon Ch. 6, proof of 7.2, p. 172: "the
`M`-absolutely convergent series `R^{(ℓ)} = Σ_{r ≥ ℓ} R_r`").  If `s = Σ_r M(X_r) < ∞`, every
`M(X_r)` is finite and `Σ_r M(X_r)^ℝ = s^ℝ`.  For a test form `ω` with `|ω(x)| ≤ c`,
`|X_r(ω)| ≤ c M(X_r)^ℝ`, so `Σ_r X_r(ω)` converges absolutely; its sum `L(ω)` is linear in `ω`
and satisfies `|L(ω)| ≤ c s^ℝ`, hence is a current `Y`.  For `ω` admissible for `M`,
`X_r(ω) ≤ M(X_r)^ℝ`, so `Y(ω) ≤ s^ℝ` and `M(Y) ≤ s`. -/
theorem Submission.cmc_fc_series_current : ∀ (P n : ℕ) (U : Set (Euclid P)) (X : ℕ → GeometricCurrentOn U n), ∑' r, (X r).mass ≠ ∞ → ∃ Y : GeometricCurrentOn U n, (∀ ω : TestFormOn U n, HasSum (fun r => X r ω) (Y ω)) ∧ Y.mass ≤ ∑' r, (X r).mass := by
  intro P n U X hX
  -- Step 1: every `M(X_r)` is finite and `Σ_r M(X_r)^ℝ = s^ℝ`
  have hfin : ∀ r, (X r).mass ≠ ∞ := ENNReal.ne_top_of_tsum_ne_top hX
  have hm : HasSum (fun r => (X r).mass.toReal) (∑' r, (X r).mass).toReal := by
    rw [ENNReal.tsum_toReal_eq hfin]
    exact (ENNReal.summable_toReal hX).hasSum
  -- Step 2: `|X_r(ω)| ≤ c M(X_r)^ℝ` when `|ω(x)| ≤ c`, so `Σ_r X_r(ω)` converges absolutely
  have hle : ∀ (ω : TestFormOn U n) (c : ℝ), 0 < c →
      (∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) x) ≤ c) →
      ∀ r, ‖X r ω‖ ≤ c * (X r).mass.toReal := fun ω c hc hω r => by
    rw [Real.norm_eq_abs]
    exact Submission.cmc_fc_sc_abs_le_mul_mass P n U (X r) ω c hc (hfin r) hω
  have hsum : ∀ ω : TestFormOn U n, Summable fun r => X r ω := fun ω => by
    obtain ⟨c, hc, hω⟩ := Submission.cmc_fc_sc_testForm_coeff_bound P n U ω
    exact Summable.of_norm_bounded (hm.summable.mul_left c) (hle ω c hc hω)
  -- Step 3: `L(ω) = Σ_r X_r(ω)` is linear, by additivity and homogeneity of convergent sums
  let L : TestFormOn U n →ₗ[ℝ] ℝ :=
    { toFun := fun ω => ∑' r, X r ω
      map_add' := fun ω ω' => by
        simp only [map_add]
        exact (hsum ω).tsum_add (hsum ω')
      map_smul' := fun t ω => by
        simp only [map_smul, smul_eq_mul, RingHom.id_apply]
        exact (hsum ω).tsum_mul_left t }
  have hL : ∀ ω : TestFormOn U n, L ω = ∑' r, X r ω := fun _ => rfl
  -- Step 4: `|L(ω)| ≤ c s^ℝ` when `|ω(x)| ≤ c`, so `L` is a current `Y`
  obtain ⟨Y, hY⟩ := Submission.cmc_fc_sc_current_of_coeff_bound P n U L
    (∑' r, (X r).mass).toReal fun ω c hc hω => by
      rw [hL, ← Real.norm_eq_abs]
      exact (hsum ω).hasSum.norm_le_of_bounded (hm.mul_left c) (hle ω c hc hω)
  refine ⟨Y, fun ω => ?_, ?_⟩
  · rw [hY, hL]
    exact (hsum ω).hasSum
  -- Step 5: for `ω` admissible for `M`, `X_r(ω) ≤ M(X_r)^ℝ`, so `Y(ω) ≤ s^ℝ`
  · refine sSup_le ?_
    rintro _ ⟨ω, hω, rfl⟩
    rw [ENNReal.ofReal_le_iff_le_toReal hX, hY, hL]
    exact hasSum_le (fun r => (ENNReal.ofReal_le_iff_le_toReal (hfin r)).1 ((X r).le_massOn hω))
      (hsum ω).hasSum hm
/-- **Subadditivity of local mass** (Simon 6.2.5).  If `X(ω) = Y(ω) + Z(ω)` for every
`ω ∈ 𝒟ᵈ(U)`, then `M_V(X) ≤ M_V(Y) + M_V(Z)` in `[0, ∞]`.  The admissible forms for `M_V`
(`spt ω ⊆ V`, `|ω| ≤ 1`) depend only on `U`, `d` and `V`; for each of them
`ofReal (X ω) ≤ ofReal (Y ω) + ofReal (Z ω) ≤ M_V(Y) + M_V(Z)`.  Taking the supremum over
admissible `ω` gives the claim. -/
theorem Submission.cmc_fcl_massOn_le_add : ∀ (P d : ℕ) (U : Set (Euclid P)) (X Y Z : GeometricCurrentOn U d) (V : Set (Euclid P)), (∀ ω : TestFormOn U d, X ω = Y ω + Z ω) → X.massOn V ≤ Y.massOn V + Z.massOn V := by
  intro P d U X Y Z V h
  -- Step 4: `M_V(X)` is a supremum, so bound each admissible value `ofReal (X ω)`
  refine sSup_le ?_
  -- Step 1: fix `ω` admissible for `M_V`; the same `ω` is admissible for `Y` and `Z`
  rintro r ⟨ω, hω, rfl⟩
  show ENNReal.ofReal (X ω) ≤ Y.massOn V + Z.massOn V
  -- Steps 2–3: `ofReal` is subadditive, and admissible values are bounded by local mass
  calc ENNReal.ofReal (X ω) = ENNReal.ofReal (Y ω + Z ω) := by rw [h ω]
    _ ≤ ENNReal.ofReal (Y ω) + ENNReal.ofReal (Z ω) := ENNReal.ofReal_add_le
    _ ≤ Y.massOn V + Z.massOn V := add_le_add (Y.le_massOn hω) (Z.le_massOn hω)
/-- **`L¹(ν)` approximation of a unit covector field by continuous compactly supported unit
fields** (steps 3–4 of the `L¹(ν)` approximation of a unit covector field by admissible test
forms).  Let `ν` be a finite Borel measure on `ℝᴾ` and `β` a `ν`-integrable `n`-covector field
with `N(β) ≤ 1` `ν`-a.e., `N = covectorEuclideanNorm`.  Continuous compactly supported maps are
dense in `L¹(ν)` (`ν` is regular), so one of them, `g₀`, has `∫ ‖β − g₀‖ dν ≤ η`.  With `ρ` the
retraction onto `{N ≤ 1}`, `g = ρ ∘ g₀` is continuous, compactly supported (`ρ 0 = 0`), has
`N(g) ≤ 1`, and `N(g − β) ≤ 2 N(g₀ − β) ≤ 2C ‖β − g₀‖` a.e., so `∫ N(g − β) dν ≤ 2Cη < δ`. -/
theorem Submission.rsd_mw_tfa_continuous_approx : ∀ (P n : ℕ) (ν : Measure (Euclid P)) (β : Euclid P → Covector (Euclid P) n), IsFiniteMeasure ν → Integrable β ν → (∀ᵐ x ∂ν, covectorEuclideanNorm (β x) ≤ 1) → ∀ δ : ℝ, 0 < δ → ∃ g : Euclid P → Covector (Euclid P) n, Continuous g ∧ HasCompactSupport g ∧ (∀ x, covectorEuclideanNorm (g x) ≤ 1) ∧ ∫⁻ x, ENNReal.ofReal (covectorEuclideanNorm (g x - β x)) ∂ν < ENNReal.ofReal δ := by
  intro P n ν β hν hβ hβ1 δ hδ
  -- Step 1: the constant `C` of `norm_props` (iii), the retraction `ρ`, and the tolerance `η`
  obtain ⟨-, -, ⟨C, hC0, hC⟩, -⟩ := Submission.rsd_mw_tfa_norm_props P n
  obtain ⟨ρ, hρc, hρ0, hρ1, hρ2⟩ := Submission.rsd_mw_tfa_retraction P n
  set η : ℝ := δ / (2 * (2 * C + 1)) with hη
  have hη0 : 0 < η := by positivity
  -- Step 2: continuous compactly supported maps are dense in `L¹(ν)` (`ν` is finite, hence
  -- regular).  The contract does not import `Integrable.exists_hasCompactSupport_lintegral_sub_le`,
  -- so this goes through `MemLp.induction_dense`: `c • 1_s` is approximated by `φ • c`, with `φ`
  -- a Urysohn function for compact `K ⊆ s ⊆ U` open, `ν (U \ K)` small.
  have hind : ∀ (c : Covector (Euclid P) n) ⦃s : Set (Euclid P)⦄, MeasurableSet s → ν s < ∞ →
      ∀ {ε : ℝ≥0∞}, ε ≠ 0 → ∃ g : Euclid P → Covector (Euclid P) n,
        eLpNorm (g - s.indicator fun _ => c) 1 ν ≤ ε ∧ (Continuous g ∧ HasCompactSupport g) := by
    intro c s hs hsν ε hε
    obtain ⟨t, ht0, htε⟩ :=
      ENNReal.exists_nnreal_pos_mul_lt (a := 2 * ‖c‖ₑ)
        (ENNReal.mul_ne_top ENNReal.ofNat_ne_top enorm_ne_top) hε
    have ht : (t : ℝ≥0∞) ≠ 0 := by exact_mod_cast ht0.ne'
    -- compact `K ⊆ s ⊆ U` open with `ν (s \ K) < t` and `ν (U \ s) < t`
    obtain ⟨K, hKs, hK, hsK⟩ := hs.exists_isCompact_sdiff_lt hsν.ne ht
    obtain ⟨U, hsU, hU, -, hUs⟩ := hs.exists_isOpen_sdiff_lt hsν.ne ht
    -- Urysohn: `φ = 1` on `K`, `φ = 0` off `U`, `0 ≤ φ ≤ 1`, compact support
    obtain ⟨φ, hφK, hφU, hφs, hφ01⟩ := exists_continuous_one_zero_of_isCompact hK hU.isClosed_compl
      (disjoint_compl_right_iff_subset.mpr (hKs.trans hsU))
    have hgc : Continuous fun x => φ x • c := φ.continuous.smul continuous_const
    refine ⟨fun x => φ x • c, ?_, hgc, hφs.smul_right⟩
    -- pointwise `‖φ x • c - 1_s(x) c‖ₑ ≤ 1_{U \ K}(x) ‖c‖ₑ`
    have hle : ∀ x, ‖((fun x => φ x • c) - s.indicator fun _ => c) x‖ₑ ≤
        (U \ K).indicator (fun _ => ‖c‖ₑ) x := by
      intro x
      rw [← ofReal_norm]
      by_cases hxK : x ∈ K
      · simp [hφK hxK, hKs hxK]
      by_cases hxU : x ∈ U
      · rw [indicator_of_mem (mem_sdiff_of_mem hxU hxK), ← ofReal_norm]
        refine ENNReal.ofReal_le_ofReal ?_
        obtain ⟨h0, h1⟩ := hφ01 x
        by_cases hxs : x ∈ s
        · rw [Pi.sub_apply, indicator_of_mem hxs, show φ x • c - c = (φ x - 1) • c by module,
            norm_smul, Real.norm_eq_abs, abs_of_nonpos (by linarith)]
          nlinarith [norm_nonneg c]
        · rw [Pi.sub_apply, indicator_of_notMem hxs, sub_zero, norm_smul, Real.norm_eq_abs,
            abs_of_nonneg h0]
          nlinarith [norm_nonneg c]
      · simp [hφU hxU, show x ∉ s from fun h => hxU (hsU h), hxU]
    rw [eLpNorm_one_eq_lintegral_enorm
      (hgc.aestronglyMeasurable.sub (stronglyMeasurable_const.indicator hs).aestronglyMeasurable)]
    calc ∫⁻ x, ‖((fun x => φ x • c) - s.indicator fun _ => c) x‖ₑ ∂ν
        ≤ ∫⁻ x, (U \ K).indicator (fun _ => ‖c‖ₑ) x ∂ν := lintegral_mono hle
      _ = ‖c‖ₑ * ν (U \ K) := lintegral_indicator_const (hU.measurableSet.diff hK.measurableSet) _
      _ ≤ ‖c‖ₑ * (ν (U \ s) + ν (s \ K)) := by
          gcongr
          refine (measure_mono fun x hx => ?_).trans (measure_union_le (U \ s) (s \ K))
          by_cases hxs : x ∈ s
          · exact Or.inr ⟨hxs, hx.2⟩
          · exact Or.inl ⟨hx.1, hxs⟩
      _ ≤ ‖c‖ₑ * (t + t) := by gcongr
      _ = t * (2 * ‖c‖ₑ) := by ring
      _ ≤ ε := htε.le
  -- the density statement for `β`, with tolerance `η`
  obtain ⟨g₀, hg₀, hg₀c, hg₀s⟩ := (memLp_one_iff_integrable.2 hβ).induction_dense
    ENNReal.one_ne_top (fun g => Continuous g ∧ HasCompactSupport g) hind
    (fun f g hf hg => ⟨hf.1.add hg.1, hf.2.add hg.2⟩) (ENNReal.ofReal_pos.mpr hη0).ne'
  rw [eLpNorm_one_eq_lintegral_enorm (hβ.aestronglyMeasurable.sub hg₀c.aestronglyMeasurable)] at hg₀
  -- Step 3: `g := ρ ∘ g₀`
  refine ⟨ρ ∘ g₀, hρc.comp hg₀c, hg₀s.comp_left hρ0, fun x => hρ1 _, ?_⟩
  -- Step 4: pointwise a.e. estimate
  have hpt : ∀ᵐ x ∂ν, ENNReal.ofReal (covectorEuclideanNorm ((ρ ∘ g₀) x - β x))
      ≤ ENNReal.ofReal (2 * C) * ‖β x - g₀ x‖ₑ := by
    filter_upwards [hβ1] with x hx
    rw [← ofReal_norm, ← ENNReal.ofReal_mul (by positivity)]
    apply ENNReal.ofReal_le_ofReal
    calc covectorEuclideanNorm ((ρ ∘ g₀) x - β x)
        ≤ 2 * covectorEuclideanNorm (g₀ x - β x) := hρ2 _ _ hx
      _ ≤ 2 * (C * ‖g₀ x - β x‖) := by gcongr; exact hC _
      _ = 2 * C * ‖β x - g₀ x‖ := by rw [norm_sub_rev]; ring
  -- Step 5: integration
  calc ∫⁻ x, ENNReal.ofReal (covectorEuclideanNorm ((ρ ∘ g₀) x - β x)) ∂ν
      ≤ ∫⁻ x, ENNReal.ofReal (2 * C) * ‖β x - g₀ x‖ₑ ∂ν := lintegral_mono_ae hpt
    _ = ENNReal.ofReal (2 * C) * ∫⁻ x, ‖β x - g₀ x‖ₑ ∂ν :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
    _ ≤ ENNReal.ofReal (2 * C) * ENNReal.ofReal η := by gcongr; exact hg₀
    _ = ENNReal.ofReal (2 * C * η) := (ENNReal.ofReal_mul (by positivity)).symm
    -- Step 6: arithmetic
    _ < ENNReal.ofReal δ := by
        rw [ENNReal.ofReal_lt_ofReal_iff hδ, hη, mul_div_assoc', div_lt_iff₀ (by positivity)]
        nlinarith

/-- **Smooth uniform approximation keeping the unit bound** (smoothing step in the proof of
`M_W(T) = ∫_{M ∩ W} θ dHⁿ`, Simon 6.3.2(3); `|·|_E` is `covectorEuclideanNorm`).  Let
`η := δ/(2C + 1)`, where `|·|_E ≤ C‖·‖` (`Submission.rsd_mw_tfa_norm_props`).  A continuous
compactly supported covector field `g` with `|g|_E ≤ 1` is uniformly continuous, so
`‖g y − g x‖ < η` when `dist y x < r`.  Mollifying, `h' = ψ ⋆ g` with `ψ = φ / ∫ φ` for a smooth
bump `φ ≥ 0` with `support φ = B_r(0)` is a `C^∞` field with `‖h' − g‖ ≤ η`; then
`|h' − g|_E ≤ Cη` and `|h'|_E ≤ 1 + Cη`.  The rescaled field `h = (1 + Cη)⁻¹h'` has `|h|_E ≤ 1`
and `|h − h'|_E = Cη(1 + Cη)⁻¹|h'|_E ≤ Cη`, hence `|h − g|_E ≤ 2Cη ≤ δ`. -/
theorem Submission.rsd_mw_tfa_smooth_uniform_approx : ∀ (P n : ℕ) (g : Euclid P → Covector (Euclid P) n), Continuous g → HasCompactSupport g → (∀ x, covectorEuclideanNorm (g x) ≤ 1) → ∀ δ : ℝ, 0 < δ → ∃ h : Euclid P → Covector (Euclid P) n, ContDiff ℝ (⊤ : ℕ∞) h ∧ (∀ x, covectorEuclideanNorm (h x) ≤ 1) ∧ ∀ x, covectorEuclideanNorm (h x - g x) ≤ δ := by
  intro P n g hgc hgs hg1 δ hδ
  -- `N := covectorEuclideanNorm` is subadditive, absolutely homogeneous and `N ≤ C ‖·‖`
  obtain ⟨htri, hsmul, ⟨C, hC0, hCle⟩, -⟩ := Submission.rsd_mw_tfa_norm_props P n
  -- Step 1: the tolerance `η = δ / (2C + 1)`
  set η : ℝ := δ / (2 * C + 1) with hη
  have hη0 : 0 < η := div_pos hδ (by linarith)
  have hCη : 0 ≤ C * η := mul_nonneg hC0 hη0.le
  -- Step 2: `g` is uniformly continuous: `‖g y - g x‖ < η` whenever `dist y x < r`
  obtain ⟨r, hr, hgr⟩ := Metric.uniformContinuous_iff.mp
    (hgs.uniformContinuous_of_continuous hgc) η hη0
  -- Step 3: mollify, `h' = ψ ⋆ g` with `ψ = φ / ∫ φ` for a smooth bump `φ`, `support φ = B_r(0)`
  let φ : ContDiffBump (0 : Euclid P) := ⟨r / 2, r, half_pos hr, half_lt_self hr⟩
  have hφ : 0 < ∫ y, φ y := by
    refine (integral_pos_iff_support_of_nonneg φ.nonneg'
      (φ.continuous.integrable_of_hasCompactSupport φ.hasCompactSupport)).mpr ?_
    rw [φ.support_eq]
    exact measure_ball_pos volume 0 hr
  let ψ : Euclid P → ℝ := fun y => φ y / ∫ y, φ y
  have hψφ : support ψ ⊆ support φ := fun y hy h => hy (by simp [ψ, h])
  have hψs : support ψ ⊆ ball 0 r := hψφ.trans φ.support_eq.subset
  have hψ0 : ∀ y, 0 ≤ ψ y := fun y => div_nonneg φ.nonneg hφ.le
  have hψ1 : ∫ y, ψ y = 1 := by rw [integral_div, div_self hφ.ne']
  obtain ⟨h', hh's, hh'g⟩ : ∃ h' : Euclid P → Covector (Euclid P) n,
      ContDiff ℝ (⊤ : ℕ∞) h' ∧ ∀ x, dist (h' x) (g x) ≤ η :=
    ⟨convolution ψ g (ContinuousLinearMap.lsmul ℝ ℝ) volume,
      (φ.hasCompactSupport.mono hψφ).contDiff_convolution_left _ (φ.contDiff.div_const _)
        hgc.locallyIntegrable,
      fun x => dist_convolution_le hη0.le hψs hψ0 hψ1 hgc.aestronglyMeasurable fun y hy =>
        (hgr (mem_ball.mp hy)).le⟩
  -- Step 4: `N(h' - g) ≤ Cη` and `N(h') ≤ 1 + Cη`
  have hdiff : ∀ x, covectorEuclideanNorm (h' x - g x) ≤ C * η := fun x =>
    (hCle _).trans (mul_le_mul_of_nonneg_left (by rw [← dist_eq_norm]; exact hh'g x) hC0)
  have hh'1 : ∀ x, covectorEuclideanNorm (h' x) ≤ 1 + C * η := fun x =>
    calc covectorEuclideanNorm (h' x) = covectorEuclideanNorm ((h' x - g x) + g x) := by
          rw [sub_add_cancel]
      _ ≤ covectorEuclideanNorm (h' x - g x) + covectorEuclideanNorm (g x) := htri _ _
      _ ≤ C * η + 1 := add_le_add (hdiff x) (hg1 x)
      _ = 1 + C * η := add_comm _ _
  -- Step 5: rescale by `s = (1 + Cη)⁻¹ ∈ (0, 1]`
  have hpos : 0 < 1 + C * η := by linarith
  have hne : 1 + C * η ≠ 0 := hpos.ne'
  set s : ℝ := (1 + C * η)⁻¹ with hs
  have hs0 : 0 < s := inv_pos.mpr hpos
  refine ⟨fun x => s • h' x, hh's.const_smul s, fun x => ?_, fun x => ?_⟩
  · show covectorEuclideanNorm (s • h' x) ≤ 1
    rw [hsmul, abs_of_pos hs0, hs, inv_mul_le_iff₀ hpos, mul_one]
    exact hh'1 x
  · show covectorEuclideanNorm (s • h' x - g x) ≤ δ
    -- Step 6: `N(s h' - h') = |s - 1| N(h') = Cη s N(h') ≤ Cη`
    have hsh : s • h' x - h' x = (s - 1) • h' x := by module
    have hs1 : |s - 1| = C * η * s := by
      have hle : s ≤ 1 := inv_le_one_of_one_le₀ (by linarith)
      rw [abs_of_nonpos (by linarith), hs]
      field_simp
      ring
    have h6 : covectorEuclideanNorm (s • h' x - h' x) ≤ C * η := by
      rw [hsh, hsmul, hs1]
      calc C * η * s * covectorEuclideanNorm (h' x) ≤ C * η * s * (1 + C * η) :=
            mul_le_mul_of_nonneg_left (hh'1 x) (mul_nonneg hCη hs0.le)
        _ = C * η := by rw [hs]; field_simp
    -- Step 7: `N(s h' - g) ≤ N(s h' - h') + N(h' - g) ≤ 2Cη ≤ δ`
    calc covectorEuclideanNorm (s • h' x - g x)
        = covectorEuclideanNorm ((s • h' x - h' x) + (h' x - g x)) := by
          rw [sub_add_sub_cancel]
      _ ≤ covectorEuclideanNorm (s • h' x - h' x) + covectorEuclideanNorm (h' x - g x) :=
          htri _ _
      _ ≤ C * η + C * η := add_le_add h6 (hdiff x)
      _ ≤ δ := by
          have h2 : 0 < 2 * C + 1 := by linarith
          have h2C : C * η + C * η = 2 * C * δ / (2 * C + 1) := by rw [hη]; ring
          rw [h2C, div_le_iff₀ h2]
          nlinarith

/-- **Test forms approximating a unit-bounded integrable covector field in `L¹(ν)`** (the
approximation behind `M_W(T) = ∫_{M ∩ W} θ dHⁿ`, Simon 6.3.2(3); `|·|_E` is
`covectorEuclideanNorm`).  Let `m = ν(ℝᴾ)` and `δ = ε/(4(m + 1))`.  The smooth cut-off `χ` of
`Submission.rsd_mw_tfa_smooth_cutoff` satisfies `tsupport χ ⊆ V` and `ν{χ ≠ 1} < ε/8`.  The
continuous field `g₁` of `Submission.rsd_mw_tfa_continuous_approx` satisfies `|g₁|_E ≤ 1` and
`∫ |g₁ − β|_E dν < ε/4`.  Its smoothing `g₂` (`Submission.rsd_mw_tfa_smooth_uniform_approx`)
satisfies `|g₂|_E ≤ 1` and `|g₂ − g₁|_E ≤ δ`.  Then `ω = χ g₂` is a test form, `tsupport ω ⊆ V`
and `|ω|_E ≤ 1`.  For a.e. `x`, `|ω − β|_E ≤ δ + |g₁ − β|_E` where `χ = 1`, and
`|ω − β|_E ≤ 2` where `χ ≠ 1`.  Integrating,
`∫ |ω − β|_E dν ≤ δm + ∫ |g₁ − β|_E dν + 2ν{χ ≠ 1} < ε/4 + ε/4 + ε/4 < ε`. -/
theorem Submission.rsd_mw_exists_testForm_approx : ∀ (P n : ℕ) (ν : Measure (Euclid P)) (V : Set (Euclid P)) (β : Euclid P → Covector (Euclid P) n), IsFiniteMeasure ν → IsOpen V → ν Vᶜ = 0 → Integrable β ν → (∀ᵐ x ∂ν, covectorEuclideanNorm (β x) ≤ 1) → ∀ ε : ℝ, 0 < ε → ∃ ω : DifferentialForm (Euclid P) n, IsTestForm ω ∧ tsupport ω ⊆ V ∧ (∀ x, covectorEuclideanNorm (ω x) ≤ 1) ∧ ∫⁻ x, ENNReal.ofReal (covectorEuclideanNorm (ω x - β x)) ∂ν < ENNReal.ofReal ε := by
  intro P n ν V β hν hV hVc hβ hβ1 ε hε
  -- `N := covectorEuclideanNorm` is subadditive and absolutely homogeneous
  obtain ⟨htri, hsmul, -, -⟩ := Submission.rsd_mw_tfa_norm_props P n
  -- Step 1: a smooth cut-off `χ` with `tsupport χ ⊆ V` and `ν{χ ≠ 1} < ε/8`
  obtain ⟨χ, hχs, hχc, hχV, hχ01, hχν⟩ :=
    Submission.rsd_mw_tfa_smooth_cutoff P ν V hν hV hVc (ε / 8) (by positivity)
  -- Step 2: a continuous compactly supported `g₁` with `N(g₁) ≤ 1` and `∫ N(g₁ - β) dν < ε/4`
  obtain ⟨g₁, hg₁c, hg₁s, hg₁1, hg₁β⟩ :=
    Submission.rsd_mw_tfa_continuous_approx P n ν β hν hβ hβ1 (ε / 4) (by positivity)
  -- Step 3: a smooth `g₂` with `N(g₂) ≤ 1` and `N(g₂ - g₁) ≤ δ = ε/(4(m + 1))`, `m = ν(ℝᴾ)`
  set m : ℝ := (ν univ).toReal with hm
  have hm0 : 0 ≤ m := ENNReal.toReal_nonneg
  set δ : ℝ := ε / (4 * (m + 1)) with hδ
  have hδ0 : 0 < δ := by positivity
  obtain ⟨g₂, hg₂s, hg₂1, hg₂g₁⟩ :=
    Submission.rsd_mw_tfa_smooth_uniform_approx P n g₁ hg₁c hg₁s hg₁1 δ hδ0
  -- Step 4: `ω = χ g₂` is a test form with `tsupport ω ⊆ V` and `N(ω) ≤ 1`
  have hω1 : ∀ x, covectorEuclideanNorm (χ x • g₂ x) ≤ 1 := fun x => by
    rw [hsmul, abs_of_nonneg (hχ01 x).1]
    exact (mul_le_of_le_one_left (covectorEuclideanNorm_nonneg _) (hχ01 x).2).trans (hg₂1 x)
  refine ⟨fun x => χ x • g₂ x, ⟨hχs.smul hg₂s, hχc.smul_right⟩,
    (tsupport_smul_subset_left χ g₂).trans hχV, hω1, ?_⟩
  -- Step 5: a.e., `N(ω - β) ≤ δ + N(g₁ - β)` where `χ = 1` and `N(ω - β) ≤ 2` on `S = {χ ≠ 1}`
  set S : Set (Euclid P) := {x | χ x ≠ 1}
  have hSm : MeasurableSet S := (isOpen_ne_fun hχs.continuous continuous_const).measurableSet
  have hpt : ∀ᵐ x ∂ν, ENNReal.ofReal (covectorEuclideanNorm (χ x • g₂ x - β x)) ≤
      ENNReal.ofReal δ + ENNReal.ofReal (covectorEuclideanNorm (g₁ x - β x)) +
        S.indicator (fun _ => (2 : ℝ≥0∞)) x := by
    filter_upwards [hβ1] with x hx
    by_cases h1 : χ x = 1
    · rw [indicator_of_notMem (not_not.mpr h1), add_zero,
        ← ENNReal.ofReal_add hδ0.le (covectorEuclideanNorm_nonneg _), h1, one_smul]
      refine ENNReal.ofReal_le_ofReal ?_
      calc covectorEuclideanNorm (g₂ x - β x)
          = covectorEuclideanNorm ((g₂ x - g₁ x) + (g₁ x - β x)) := by rw [sub_add_sub_cancel]
        _ ≤ covectorEuclideanNorm (g₂ x - g₁ x) + covectorEuclideanNorm (g₁ x - β x) :=
          htri _ _
        _ ≤ δ + covectorEuclideanNorm (g₁ x - β x) := by linarith [hg₂g₁ x]
    · rw [indicator_of_mem h1]
      refine le_add_left (le_of_le_of_eq (ENNReal.ofReal_le_ofReal ?_) (ENNReal.ofReal_ofNat 2))
      calc covectorEuclideanNorm (χ x • g₂ x - β x)
          = covectorEuclideanNorm (χ x • g₂ x + -β x) := by rw [sub_eq_add_neg]
        _ ≤ covectorEuclideanNorm (χ x • g₂ x) + covectorEuclideanNorm (-β x) := htri _ _
        _ ≤ 2 := by rw [covectorEuclideanNorm_neg]; linarith [hω1 x]
  -- Step 6: integrate, `∫ N(ω - β) dν ≤ δm + ∫ N(g₁ - β) dν + 2ν(S) < 3ε/4`
  have hδm : ENNReal.ofReal δ * ν univ ≤ ENNReal.ofReal (ε / 4) := by
    rw [← ENNReal.ofReal_toReal (measure_ne_top ν univ), ← hm, ← ENNReal.ofReal_mul hδ0.le]
    refine ENNReal.ofReal_le_ofReal ?_
    calc δ * m ≤ δ * (m + 1) := by nlinarith
      _ = ε / 4 := by rw [hδ]; field_simp
  have hS2 : 2 * ν S < ENNReal.ofReal (ε / 4) := by
    calc 2 * ν S = ν S + ν S := two_mul _
      _ < ENNReal.ofReal (ε / 8) + ENNReal.ofReal (ε / 8) := ENNReal.add_lt_add hχν hχν
      _ = ENNReal.ofReal (ε / 4) := by
          rw [← ENNReal.ofReal_add (by positivity) (by positivity)]
          ring_nf
  calc ∫⁻ x, ENNReal.ofReal (covectorEuclideanNorm (χ x • g₂ x - β x)) ∂ν
      ≤ ∫⁻ x, (ENNReal.ofReal δ + ENNReal.ofReal (covectorEuclideanNorm (g₁ x - β x)) +
          S.indicator (fun _ => (2 : ℝ≥0∞)) x) ∂ν := lintegral_mono_ae hpt
    _ = ENNReal.ofReal δ * ν univ +
          ∫⁻ x, ENNReal.ofReal (covectorEuclideanNorm (g₁ x - β x)) ∂ν + 2 * ν S := by
        rw [lintegral_add_right _ (measurable_const.indicator hSm),
          lintegral_add_left measurable_const, lintegral_const, lintegral_indicator_const hSm]
    _ < ENNReal.ofReal (ε / 4) + ENNReal.ofReal (ε / 4) + ENNReal.ofReal (ε / 4) :=
        ENNReal.add_lt_add (ENNReal.add_lt_add_of_le_of_lt
          (ENNReal.mul_ne_top ENNReal.ofReal_ne_top (measure_ne_top ν univ)) hδm hg₁β) hS2
    _ ≤ ENNReal.ofReal ε := by
        rw [← ENNReal.ofReal_add (by positivity) (by positivity),
          ← ENNReal.ofReal_add (by positivity) (by positivity)]
        exact ENNReal.ofReal_le_ofReal (by linarith)

/-- **Simon Ch. 6, Remark 3.2(3), `≥` half** (with 2.5 and Remark 2.6(a)–(b)): `μ_T(W) ≤ M_W(T)`
for `T = τ(M, θ, ξ)` and open `W ⊆ U`.  Given `c < μ_T(W)`, take an open `V ⊆ W` with
`c < μ_T(V) < ∞` and put `ν = μ_T⌞V`.  With `J` as in `Submission.rsd_mw_unit_orientation_dual`,
`β = J ∘ ξ` is `ν`-integrable, and `ν`-a.e. `|β| = 1`, `⟨β, ξ⟩ = 1` and `|⟨α, ξ⟩| ≤ |α|`.  A test
form `ω` with `spt ω ⊆ V`, `|ω| ≤ 1` and `∫ |ω − β| dν < ε = (μ_T(V) − c)/2` is admissible for
`M_W(T)`, and `T(ω) = ∫ ⟨ω, ξ⟩ dν > ν(ℝᴾ) − ε = (μ_T(V) + c)/2 > c`. -/
theorem Submission.rsd_mw_measure_le_massOn : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), R.Represents T → ∀ W : Set (Euclid P), IsOpen W → W ⊆ U → R.measure W ≤ T.massOn W := by
  intro P n U T R hT W hW hWU
  obtain ⟨J, hJ⟩ := Submission.rsd_mw_unit_orientation_dual P n
  -- it suffices to show `c < M_W(T)` for every `c < μ_T(W)`
  refine le_of_forall_lt fun c hcW => ?_
  -- an open `V ⊆ W` with `c < μ_T(V) < ∞`
  obtain ⟨V, hV, hVW, hcV, hVfin⟩ :=
    Submission.rsd_mw_wlm_exists_open_measure_between P n U R W hW hWU c hcW
  -- `ν = μ_T⌞V` is finite, vanishes off `V`, and `ν ≪ μ_T ≪ Hⁿ⌞M`
  set ν := R.measure.restrict V with hν
  have hνfin : IsFiniteMeasure ν := isFiniteMeasure_restrict.2 hVfin.ne
  have hνVc : ν Vᶜ = 0 := by
    rw [hν, Measure.restrict_apply' hV.measurableSet, compl_inter_self, measure_empty]
  have hμac : R.measure ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
  have hνac : ν ≪ μHE[n].restrict R.carrier :=
    Measure.restrict_le_self.absolutelyContinuous.trans hμac
  -- `ν`-a.e. `ξ(x)` is a unit orientation
  have hG : ∀ᵐ x ∂ν, ∃ Q : Submodule ℝ (Euclid P), IsUnitOrientationOf (R.orient x) Q := by
    filter_upwards [hνac.ae_le R.orients] with x hx
    obtain ⟨Q, -, hQ⟩ := hx
    exact ⟨Q, hQ⟩
  have hξ : AEStronglyMeasurable R.orient ν := R.aestronglyMeasurable_orient.mono_ac hνac
  -- `β = J ∘ ξ` is `ν`-integrable, as `‖ξ‖ ≤ 1` `ν`-a.e., and `|β| ≤ 1` `ν`-a.e.
  have hβ : Integrable (fun x => J (R.orient x)) ν := by
    refine Submission.rsd_mw_wlm_integrable_clm_comp P n ν R.orient J hνfin hξ ?_
    filter_upwards [hG] with x hx
    obtain ⟨Q, hQ⟩ := hx
    exact Submission.rsd_mw_wlm_orient_opNorm_le_one P n Q (R.orient x) hQ
  have hβ1 : ∀ᵐ x ∂ν, covectorEuclideanNorm (J (R.orient x)) ≤ 1 := by
    filter_upwards [hG] with x hx
    obtain ⟨Q, hQ⟩ := hx
    exact (hJ _ Q hQ).2.1.le
  -- `c < ∞`, and `ε = (μ_T(V) − c)/2 > 0` in `ℝ`
  have hctop : c ≠ ∞ := ne_top_of_lt hcV
  have hcV' : c.toReal < (R.measure V).toReal := (ENNReal.toReal_lt_toReal hctop hVfin.ne).2 hcV
  set ε := ((R.measure V).toReal - c.toReal) / 2 with hε
  have hε0 : 0 < ε := by linarith
  -- a test form `ω` with `spt ω ⊆ V`, `|ω| ≤ 1` and `∫ |ω − β| dν < ε`
  obtain ⟨ω, hωt, hωV, hω1, hωβ⟩ := Submission.rsd_mw_exists_testForm_approx P n ν V
    (fun x => J (R.orient x)) hνfin hV hνVc hβ hβ1 ε hε0
  -- `ω` is admissible for `M_W(T)`
  let ω' : TestFormOn U n := ⟨ω, hωt, hωV.trans (hVW.trans hWU)⟩
  have hadm : ω' ∈ massAdmissibleOn U n W := ⟨hωV.trans hVW, hω1⟩
  -- `T(ω) = ∫ ⟨ω, ξ⟩ dν > ν(ℝᴾ) − ε`, where `ν(ℝᴾ) = μ_T(V)`
  have hTω : T ω' = ∫ x, R.orient x (ω x) ∂ν :=
    Submission.rsd_mw_wlm_eval_eq_integral_restrict P n U T R hT V ω' hωV
  have hest := Submission.rsd_mw_wlm_sub_lt_integral P n ν R.orient (fun x => J (R.orient x)) ω
    ε hνfin hξ (ContDiff.continuous hωt.1) hω1 (by
      filter_upwards [hG] with x hx
      obtain ⟨Q, hQ⟩ := hx
      exact ⟨(hJ _ Q hQ).1, (hJ _ Q hQ).2.2⟩) hωβ
  have hνuniv : ν univ = R.measure V := Measure.restrict_apply_univ V
  rw [hνuniv] at hest
  have hlt : c.toReal < T ω' := by
    rw [hTω]
    linarith
  -- `c = ofReal c.toReal < ofReal T(ω) ≤ M_W(T)`
  calc c = ENNReal.ofReal c.toReal := (ENNReal.ofReal_toReal hctop).symm
    _ < ENNReal.ofReal (T ω') :=
        (ENNReal.ofReal_lt_ofReal_iff_of_nonneg ENNReal.toReal_nonneg).2 hlt
    _ ≤ T.massOn W := T.le_massOn hadm

/-- **Simon Ch. 6, Remark 3.2(3)** (with 2.7–2.8): for `T = τ(M, θ, ξ)` integer multiplicity,
`M_W(T) = μ_T(W) = ∫_{M ∩ W} θ dHⁿ` for every open `W ⊆ U`.  The bound `M_W(T) ≤ μ_T(W)` holds for
every `W` (`Submission.rsd_mw_massOn_le_measure`); the reverse bound tests `T` against smooth
admissible forms approximating the unit covector field dual to `ξ`
(`Submission.rsd_mw_measure_le_massOn`). -/
theorem Submission.rsd_massOn_eq_measure : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → W ⊆ U → T.massOn W = R.measure W := by
  intro P n U T R _ hT W hW hWU
  exact le_antisymm (Submission.rsd_mw_massOn_le_measure P n U T R hT W)
    (Submission.rsd_mw_measure_le_massOn P n U T R hT W hW hWU)
/-- **Simon Ch. 1, Theorem 3.6 and Remark 3.7(2)** (upper density theorem) for the mass measure
`μ_T = θ Hⁿ⌞M` of `T = τ(M, θ, ξ)` in `ℝᴾ`: if `Θⁿ(μ_T, x) = Θ(x)` at every `x`, then `Θ = 0`
at `Hⁿ`-a.e. `x ∉ M`.  Let `t > 0` and `A = {x ∉ M : Θ(x) > t}`.  As
`M_{B_s(x)}(T) = μ_T(B_s(x))`, the density gives `μ_T(B̄_s(x)) ≥ t ωₙ sⁿ` for small `s > 0` at
each `x ∈ A`, so the comparison theorem bounds `Hⁿ(A) ≤ C μ_T(O)` for every open `O ⊇ A`.  But
`μ_T` vanishes off `M` and is locally finite, so there are open `O ⊇ A` of arbitrarily small
`μ_T`-measure, and `Hⁿ(A) = 0`.  Take the union over `t = 1/(k+1)`. -/
theorem Submission.dimred_cs_mi_density_null_off_carrier : ∀ (P n : ℕ) (S : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n) (Θ : Euclid P → ℝ), R.Represents S → (∀ x : Euclid P, HasMassDensity S x (Θ x)) → (μHE[n] : Measure (Euclid P)) {x | x ∉ R.carrier ∧ 0 < Θ x} = 0 := by
  intro P n S R Θ hRS hΘ
  -- `0 < ωₙ < ∞`
  have hω0 : unitBallVolume n ≠ 0 := (measure_ball_pos volume (0 : Euclid n) one_pos).ne'
  have hωtop : unitBallVolume n ≠ ∞ := measure_ball_ne_top
  -- `μ_R = θ Hⁿ⌞M` vanishes off `M`
  have hoff : ∀ A ⊆ R.carrierᶜ, R.measure A = 0 := by
    intro A hA
    refine withDensity_absolutelyContinuous (μHE[n].restrict R.carrier)
      (fun x => (R.mult x : ℝ≥0∞)) ?_
    rw [Measure.restrict_apply' R.measurableSet_carrier]
    exact measure_mono_null (fun x hx => hA hx.1 hx.2) measure_empty
  -- `μ_R` is locally finite: `μ_R(B̄₁(x)) = ∫_{M ∩ B̄₁(x)} θ dHⁿ < ∞`
  have hloc : ∀ x : Euclid P, R.measure (ball x 1) ≠ ∞ := by
    intro x
    refine ne_top_of_le_ne_top ?_ (measure_mono ball_subset_closedBall)
    rw [IMRep.measure, withDensity_apply _ measurableSet_closedBall,
      Measure.restrict_restrict measurableSet_closedBall, inter_comm]
    exact R.locallyIntegrable_mult _ (isCompact_closedBall x 1) (subset_univ _)
  -- each `{x ∉ M : Θ(x) > 1/(k+1)}` is `Hⁿ`-null
  have hk : ∀ k : ℕ,
      (μHE[n] : Measure (Euclid P)) {x | x ∉ R.carrier ∧ 1 / ((k : ℝ) + 1) < Θ x} = 0 := by
    intro k
    set t : ℝ := 1 / ((k : ℝ) + 1)
    have ht : 0 < t := Nat.one_div_pos_of_nat
    set A : Set (Euclid P) := {x | x ∉ R.carrier ∧ t < Θ x}
    have hc : 0 < t * (unitBallVolume n).toReal := mul_pos ht (ENNReal.toReal_pos hω0 hωtop)
    obtain ⟨C, hC, hcomp⟩ := Submission.dorag_sn_hausdorff_le_mul_of_lower_density P n _ hc
    -- lower density bound `μ_R(B̄_s(x)) ≥ t ωₙ sⁿ` for small `s > 0` on `A`
    have hdens : ∀ x ∈ A, ∃ t₀ : ℝ, 0 < t₀ ∧ ∀ s : ℝ, 0 < s → s < t₀ →
        ENNReal.ofReal (t * (unitBallVolume n).toReal * s ^ n) ≤ R.measure (closedBall x s) := by
      rintro x ⟨-, hx⟩
      obtain ⟨-, hlim⟩ := hΘ x
      have hlt : ENNReal.ofReal t < ENNReal.ofReal (Θ x) :=
        (ENNReal.ofReal_lt_ofReal_iff (ht.trans hx)).2 hx
      -- the density ratio exceeds `t` on some interval `(0, t₀)`
      obtain ⟨t₀, ht₀, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1 (hlim (Ioi_mem_nhds hlt))
      refine ⟨t₀, ht₀, fun s hs hst => ?_⟩
      have hfs : ENNReal.ofReal t <
          S.massOn (ball x s) / (unitBallVolume n * ENNReal.ofReal (s ^ n)) := hsub ⟨hs, hst⟩
      have hd0 : unitBallVolume n * ENNReal.ofReal (s ^ n) ≠ 0 :=
        mul_ne_zero hω0 (ENNReal.ofReal_pos.2 (pow_pos hs n)).ne'
      have hdtop : unitBallVolume n * ENNReal.ofReal (s ^ n) ≠ ∞ :=
        ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top
      calc ENNReal.ofReal (t * (unitBallVolume n).toReal * s ^ n)
          = ENNReal.ofReal t * (unitBallVolume n * ENNReal.ofReal (s ^ n)) := by
            rw [ENNReal.ofReal_mul (mul_nonneg ht.le ENNReal.toReal_nonneg),
              ENNReal.ofReal_mul ht.le, ENNReal.ofReal_toReal hωtop, mul_assoc]
        _ ≤ S.massOn (ball x s) :=
            (ENNReal.le_div_iff_mul_le (Or.inl hd0) (Or.inl hdtop)).1 hfs.le
        _ = R.measure (ball x s) :=
            Submission.rsd_massOn_eq_measure P n univ S R isOpen_univ hRS _ isOpen_ball
              (subset_univ _)
        _ ≤ R.measure (closedBall x s) := measure_mono ball_subset_closedBall
    -- `μ_R(A) = 0`, so for every `ε > 0` some open `O ⊇ A` has `Hⁿ(A) ≤ C μ_R(O) ≤ C ε`
    have hA0 : R.measure A = 0 := hoff A fun x hx => hx.1
    have hCε : ∀ ε : ℝ≥0∞, 0 < ε → (μHE[n] : Measure (Euclid P)) A ≤ C * ε := by
      intro ε hε
      obtain ⟨O, hO, hAO, hOε⟩ := Submission.dorag_sn_open_superset_measure_lt P R.measure A hA0
        (fun x _ => ⟨1, one_pos, hloc x⟩) ε hε
      exact (hcomp R.measure A O hO hAO hdens).trans (mul_le_mul_right hOε.le C)
    -- let `ε = 1/j → 0`, using `C < ∞`
    have hlim : Tendsto (fun j : ℕ => C * (j : ℝ≥0∞)⁻¹) atTop (𝓝 0) := by
      simpa using ENNReal.Tendsto.const_mul ENNReal.tendsto_inv_nat_nhds_zero (Or.inr hC)
    exact le_antisymm (ge_of_tendsto' hlim fun j =>
      hCε _ (ENNReal.inv_pos.2 (ENNReal.natCast_ne_top j))) zero_le
  -- `{x ∉ M : Θ(x) > 0} ⊆ ⋃ₖ {x ∉ M : Θ(x) > 1/(k+1)}`
  refine measure_mono_null (fun x hx => ?_) (measure_iUnion_null hk)
  obtain ⟨k, hkx⟩ := exists_nat_one_div_lt hx.2
  exact mem_iUnion.2 ⟨k, hx.1, hkx⟩

/-- **Simon Ch. 4, p. 91** (Ch. 3, Remark 1.8(1)–(2) and Theorem 1.9): for an integer multiplicity
`T = τ(M, θ, ξ)` in open `U`, `Θⁿ(μ_T, x) = θ(x)` for `μ_T`-a.e. `x`.  Write `μ = Hⁿ⌞M`, so
`μ_T = θμ`, and let `x ∈ M` be a `μ`-generic point, with `B̄_s(x) ⊆ U`.
* `R.orients` gives an approximate tangent plane at `x`, so `μ(B̄_ρ(x))/(ωₙρⁿ) → 1`
  (`Submission.rsd_tendsto_closedBall_density_of_approxTangent`).  The required local finiteness
  of `μ` and `μ_T` is `Submission.rsd_imrep_compact_measure_ne_top`.
* Localized Besicovitch differentiation gives `μ_T(B̄_ρ(x))/μ(B̄_ρ(x)) → θ(x)`
  (`Submission.rsd_ae_tendsto_withDensity_div_closedBall`).
* For small `ρ`, `0 < μ(B̄_ρ(x)) < ∞`, so the product of the two ratios is
  `μ_T(B̄_ρ(x))/(ωₙρⁿ)`, which tends to `θ(x)`.
* Open balls give the same limit (`Submission.rsd_tendsto_ball_density_of_closedBall`), and
  `M_{B_ρ(x)}(T) = μ_T(B_ρ(x))` once `B_ρ(x) ⊆ U` (`Submission.rsd_massOn_eq_measure`).

Since `μ_T ≪ μ`, the `μ`-a.e. statement holds `μ_T`-a.e. -/
theorem Submission.rsd_ae_hasMassDensity_mult : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ᵐ x ∂R.measure, HasMassDensity T x (R.mult x) := by
  intro P n U T R hU hR
  -- `μ = Hⁿ⌞M` and `θ = R.mult`; by definition `μ_T = R.measure = θμ`
  set μ : Measure (Euclid P) := μHE[n].restrict R.carrier with hμ
  set θ : Euclid P → ℝ≥0∞ := fun x => (R.mult x : ℝ≥0∞)
  have hθm : Measurable θ := measurable_from_nat.comp R.measurable_mult
  have hμK : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K ≠ ∞ := fun K hK hKU => by
    rw [hμ, Measure.restrict_apply' R.measurableSet_carrier, inter_comm]
    exact (Submission.rsd_imrep_compact_measure_ne_top P n U R K hK hKU).1
  have hνK : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ.withDensity θ K ≠ ∞ :=
    fun K hK hKU => (Submission.rsd_imrep_compact_measure_ne_top P n U R K hK hKU).2
  -- Besicovitch differentiation of `θμ` with respect to `μ`, at `μ`-a.e. `x ∈ U`
  have hbes := Submission.rsd_ae_tendsto_withDensity_div_closedBall P U μ θ hU hθm hμK hνK
  have key : ∀ᵐ x ∂μ, HasMassDensity T x (R.mult x) := by
    filter_upwards [ae_restrict_mem R.measurableSet_carrier, R.orients, hbes]
      with x hxM hQ hx
    obtain ⟨Q, hxQ, -⟩ := hQ
    have hxU : x ∈ U := R.carrier_subset hxM
    -- a closed ball `B̄_s(x) ⊆ U`; every `B̄_ρ(x)`, `ρ ≤ s`, is a compact subset of `U`
    obtain ⟨s, hs, hsU⟩ := nhds_basis_closedBall.mem_iff.1 (hU.mem_nhds hxU)
    have hsub : ∀ ρ : ℝ, ρ ≤ s → closedBall x ρ ⊆ U := fun ρ hρ =>
      (closedBall_subset_closedBall hρ).trans hsU
    -- `μ(B̄_ρ(x))/(ωₙρⁿ) → 1` (approximate tangent plane at `x`)
    have hden := Submission.rsd_tendsto_closedBall_density_of_approxTangent P n R.carrier x Q s hs
      (Submission.rsd_imrep_compact_measure_ne_top P n U R _ (isCompact_closedBall x s) hsU).1 hxQ
    -- `μ_T(B̄_ρ(x))/(ωₙρⁿ) = [μ_T(B̄_ρ(x))/μ(B̄_ρ(x))] · [μ(B̄_ρ(x))/(ωₙρⁿ)] → θ(x) · 1`
    have hclosed : Tendsto (fun ρ : ℝ => R.measure (closedBall x ρ) /
        (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) (𝓝 (θ x)) := by
      have hprod := ENNReal.Tendsto.mul (hx hxU) (Or.inr ENNReal.one_ne_top) hden
        (Or.inl one_ne_zero)
      rw [mul_one] at hprod
      refine hprod.congr' ?_
      filter_upwards [Ioo_mem_nhdsGT hs, hden.eventually_ne one_ne_zero] with ρ hρ hne
      -- `0 < μ(B̄_ρ(x)) < ∞` for small `ρ`
      have hfin : μHE[n] (R.carrier ∩ closedBall x ρ) ≠ ∞ :=
        (Submission.rsd_imrep_compact_measure_ne_top P n U R _ (isCompact_closedBall x ρ)
          (hsub ρ hρ.2.le)).1
      have hpos : μHE[n] (R.carrier ∩ closedBall x ρ) ≠ 0 := fun h0 =>
        hne (by rw [h0, ENNReal.zero_div])
      have hμρ : μ (closedBall x ρ) = μHE[n] (R.carrier ∩ closedBall x ρ) := by
        rw [hμ, Measure.restrict_apply' R.measurableSet_carrier, inter_comm]
      rw [hμρ]
      exact ENNReal.div_mul_div_cancel hpos hfin
    -- open balls, then `M_{B_ρ(x)}(T) = μ_T(B_ρ(x))` for `ρ < s`
    have hopen := Submission.rsd_tendsto_ball_density_of_closedBall P n R.measure x (θ x) hclosed
    refine ⟨Nat.cast_nonneg _, ?_⟩
    rw [ENNReal.ofReal_natCast]
    refine hopen.congr' ?_
    filter_upwards [Ioo_mem_nhdsGT hs] with ρ hρ
    rw [Submission.rsd_massOn_eq_measure P n U T R hU hR (ball x ρ) isOpen_ball
      (ball_subset_closedBall.trans (hsub ρ hρ.2.le))]
  -- `μ_T = θμ ≪ μ`
  exact (withDensity_absolutelyContinuous μ θ).ae_le key

/-- **Simon Ch. 3, Remark 1.8(2) with Theorem 1.9** (as used in Ch. 4, 3.12): if `S = τ(M, θ, ξ)`
in `ℝᴾ` and `Θ(x) = Θⁿ(μ_S, x)` at every `x`, then `Θ = θ` for `Hⁿ`-a.e. `x ∈ M`.
`Θⁿ(μ_S, x) = θ(x)` for `μ_S`-a.e. `x` (`Submission.rsd_ae_hasMassDensity_mult`), so densities
being unique (`Submission.dimred_cs_mi_hasMassDensity_unique`) gives `Θ = θ` `μ_S`-a.e.  Since
`θ ≥ 1` on `M`, `Hⁿ⌞M ≪ θHⁿ⌞M = μ_S`, which transfers the equality to `Hⁿ⌞M`-a.e. -/
theorem Submission.dimred_cs_mi_density_eq_mult_ae : ∀ (P n : ℕ) (S : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n) (Θ : Euclid P → ℝ), R.Represents S → (∀ x : Euclid P, HasMassDensity S x (Θ x)) → ∀ᵐ x ∂((μHE[n] : Measure (Euclid P)).restrict R.carrier), Θ x = (R.mult x : ℝ) := by
  intro P n S R Θ hR hΘ
  -- `Θ = θ` `μ_S`-a.e., by uniqueness of densities
  have hμ : ∀ᵐ x ∂R.measure, Θ x = (R.mult x : ℝ) := by
    filter_upwards [Submission.rsd_ae_hasMassDensity_mult P n univ S R isOpen_univ hR] with x hx
    exact Submission.dimred_cs_mi_hasMassDensity_unique P n univ S x (Θ x) (R.mult x) (hΘ x) hx
  -- `Hⁿ⌞M ≪ μ_S = θHⁿ⌞M`, as `θ ≠ 0` on `M`
  have hθ : ∀ᵐ x ∂((μHE[n] : Measure (Euclid P)).restrict R.carrier),
      (R.mult x : ℝ≥0∞) ≠ 0 := by
    filter_upwards [ae_restrict_mem R.measurableSet_carrier] with x hx
    exact Nat.cast_ne_zero.2 (R.mult_pos x hx).ne'
  exact (withDensity_absolutelyContinuous'
    (measurable_from_nat.comp R.measurable_mult).aemeasurable hθ).ae_le hμ

/-- **`μ_R = Θ Hⁿ`** (step 5 of the measure invariance of a cone with invariant density, in the
cone splitting of the dimension reduction argument; Simon Ch. 4, 3.12, chapter-04.txt
lines 350–354, the canonical representative `θ_V(x) = Θⁿ(V, x)` of `V = v(M, θ)`).  Let
`S = τ(M, θ, ξ)` in `ℝᴾ`, and let `Θⁿ(μ_S, x) = Θ(x)` at every `x`.  Then `θ Hⁿ⌞M = Θ Hⁿ`, i.e.
`μ_R(A) = ∫⁻_A Θ dHⁿ` for every Borel `A`.  Split `∫⁻_A Θ dHⁿ` along the Borel carrier `M`:
* on `A ∩ M`, `Θ = θ` `Hⁿ`-a.e. (`Submission.dimred_cs_mi_density_eq_mult_ae`), so this part is
  `∫⁻_{A∩M} θ dHⁿ = μ_R(A)`;
* on `A \ M`, `Θ ≤ 0` off the `Hⁿ`-null set `{x ∉ M, Θ(x) > 0}`
  (`Submission.dimred_cs_mi_density_null_off_carrier`), so `ofReal Θ = 0` there `Hⁿ`-a.e.

No measurability of `Θ` is needed: a.e.-equal functions have equal lower integrals. -/
theorem Submission.dimred_cs_mi_measure_eq_withDensity : ∀ (P n : ℕ) (S : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n) (Θ : Euclid P → ℝ), R.Represents S → (∀ x : Euclid P, HasMassDensity S x (Θ x)) → R.measure = (μHE[n] : Measure (Euclid P)).withDensity (fun x => ENNReal.ofReal (Θ x)) := by
  intro P n S R Θ hR hΘ
  -- Step 1: compare both measures on a Borel set `A`
  ext A hA
  -- Steps 2–3: `μ_R(A) = ∫⁻_{A∩M} θ dHⁿ`, and split `∫⁻_A Θ dHⁿ` along `M`
  rw [IMRep.measure, withDensity_apply _ hA, withDensity_apply _ hA, Measure.restrict_restrict hA,
    ← lintegral_inter_add_sdiff _ A R.measurableSet_carrier]
  -- Step 4: on `A ∩ M`, `ofReal Θ = θ` `Hⁿ`-a.e.
  have hM : ∫⁻ x in A ∩ R.carrier, ENNReal.ofReal (Θ x) ∂μHE[n] =
      ∫⁻ x in A ∩ R.carrier, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
    have hae := ae_restrict_of_ae_restrict_of_subset
      (inter_subset_right : A ∩ R.carrier ⊆ R.carrier)
      (Submission.dimred_cs_mi_density_eq_mult_ae P n S R Θ hR hΘ)
    refine lintegral_congr_ae ?_
    filter_upwards [hae] with x hx
    rw [hx, ENNReal.ofReal_natCast]
  -- Step 5: on `A \ M`, `ofReal Θ = 0` `Hⁿ`-a.e., since `{x ∉ M, Θ(x) > 0}` is `Hⁿ`-null
  have hMc : ∫⁻ x in A \ R.carrier, ENNReal.ofReal (Θ x) ∂μHE[n] = 0 := by
    have hnull := Submission.dimred_cs_mi_density_null_off_carrier P n S R Θ hR hΘ
    have hae : ∀ᵐ x ∂μHE[n], x ∈ A \ R.carrier → ENNReal.ofReal (Θ x) = 0 := by
      refine ae_iff.2 (measure_mono_null (fun x hx => ?_) hnull)
      obtain ⟨hxAM, hx0⟩ := not_imp.1 hx
      exact ⟨hxAM.2, ENNReal.ofReal_pos.1 (pos_iff_ne_zero.2 hx0)⟩
    rw [lintegral_congr_ae ((ae_restrict_iff' (hA.diff R.measurableSet_carrier)).2 hae)]
    exact lintegral_zero
  -- Step 6: `∫⁻_A Θ dHⁿ = ∫⁻_{A∩M} θ dHⁿ + 0 = μ_R(A)`
  rw [hM, hMc, add_zero]
/-- **Translation invariance of `ν = Hⁿ.withDensity f` for a translation-invariant density `f`**
(step 6 of the measure invariance proof in the cone splitting argument, with `ofReal ∘ Θ` replaced
by an arbitrary `f`): if `f(y + x) = f(x)` for every `x`, then `ν((y + ·)⁻¹(A)) = ν(A)`, i.e.
`ν(A − y) = ν(A)`, for every Borel `A ⊆ ℝᴾ`.  The translation `τ(x) = y + x` is a bijective
isometry, hence a measurable embedding preserving `Hⁿ`, so
`∫⁻_{τ⁻¹(A)} f(τ(a)) dHⁿ(a) = ∫⁻_A f dHⁿ`; and `f ∘ τ = f` by hypothesis. -/
theorem Submission.dimred_cs_mi_withDensity_translate : ∀ (P n : ℕ) (f : Euclid P → ℝ≥0∞) (y : Euclid P), (∀ x : Euclid P, f (y + x) = f x) → ∀ A : Set (Euclid P), MeasurableSet A → (μHE[n] : Measure (Euclid P)).withDensity f ((fun x => y + x) ⁻¹' A) = (μHE[n] : Measure (Euclid P)).withDensity f A := by
  intro P n f y hf A hA
  -- Step 1: `τ(x) = y + x` is a homeomorphism, hence a measurable embedding; `τ⁻¹(A)` is Borel.
  have hτ : MeasurableEmbedding (fun x : Euclid P => y + x) :=
    (Homeomorph.addLeft y).measurableEmbedding
  -- Step 2: `τ` is a bijective isometry, so it preserves `Hⁿ`.
  have hmp : MeasurePreserving (fun x : Euclid P => y + x) μHE[n] μHE[n] :=
    (IsometryEquiv.addLeft y).measurePreserving_euclideanHausdorffMeasure n
  -- Steps 3–5: `ν(τ⁻¹(A)) = ∫⁻_{τ⁻¹(A)} f(y + a) dHⁿ(a) = ∫⁻_A f dHⁿ = ν(A)`.
  calc (μHE[n] : Measure (Euclid P)).withDensity f ((fun x => y + x) ⁻¹' A)
      = ∫⁻ a in (fun x => y + x) ⁻¹' A, f (y + a) ∂μHE[n] := by
        rw [withDensity_apply _ (hτ.measurable hA)]
        simp only [hf]
    _ = ∫⁻ b in A, f b ∂μHE[n] := hmp.setLIntegral_comp_preimage_emb hτ f A
    _ = (μHE[n] : Measure (Euclid P)).withDensity f A := (withDensity_apply _ hA).symm
/-- **`n`-homogeneity of `f Hⁿ` for a dilation-invariant density `f`** (Simon Lemma 7.3.5,
chapter-07.txt lines 407–420, whose proof is "left to the reader": part (ii) of the invariance of
the mass measure `μ = Θ Hⁿ` of `S` when its density `Θ` is invariant under `w ↦ λw`, with an
arbitrary `f : ℝᴾ → [0, ∞]` in place of `ofReal ∘ Θ`).  If `λ > 0` and `f(λx) = f(x)` for all `x`,
then `(f Hⁿ)(λA) = λⁿ (f Hⁿ)(A)` for every Borel `A ⊆ ℝᴾ`.  `δ(x) = λx` is a homeomorphism, so
`λA = δ(A)` is Borel and `δ⁻¹(λA) = A`; the change of variables (ii) of
`Submission.euclid_hausdorff_dilation_change_of_variables` with `g = f` and `f ∘ δ = f` gives
`(f Hⁿ)(A) = λ⁻ⁿ (f Hⁿ)(λA)`, and `λⁿ λ⁻ⁿ = 1`. -/
theorem Submission.dimred_cs_mi_withDensity_dilate : ∀ (P n : ℕ) (f : Euclid P → ℝ≥0∞) (lam : ℝ), 0 < lam → (∀ x : Euclid P, f (lam • x) = f x) → ∀ A : Set (Euclid P), MeasurableSet A → (μHE[n] : Measure (Euclid P)).withDensity f ((fun x => lam • x) '' A) = ENNReal.ofReal (lam ^ n) * (μHE[n] : Measure (Euclid P)).withDensity f A := by
  intro P n f lam hlam hf A hA
  -- Step 1: `δ(x) = λx` is a homeomorphism, hence a measurable embedding: `D = δ(A)` is Borel and
  -- `δ⁻¹(D) = A` by injectivity.
  have hδ : MeasurableEmbedding (fun x : Euclid P => lam • x) :=
    (Homeomorph.smulOfNeZero lam hlam.ne').measurableEmbedding
  have hD : MeasurableSet ((fun x : Euclid P => lam • x) '' A) := hδ.measurableSet_image.2 hA
  have hpre : (fun x : Euclid P => lam • x) ⁻¹' ((fun x : Euclid P => lam • x) '' A) = A :=
    Set.preimage_image_eq A hδ.injective
  -- Steps 2–3: change of variables (ii) with `c = λ`, `M = D`, `g = f`; with `δ⁻¹(D) = A` and
  -- `f(λz) = f(z)` it reads `∫⁻_A f dHⁿ = λ⁻ⁿ ∫⁻_D f dHⁿ`.
  have h := (Submission.euclid_hausdorff_dilation_change_of_variables P n lam hlam
    ((fun x : Euclid P => lam • x) '' A)).2.1 f
  rw [hpre] at h
  simp only [hf] at h
  -- Steps 4–5: `ν(A) = λ⁻ⁿ ν(D)` by `withDensity_apply` (`A`, `D` Borel), and
  -- `ofReal(λⁿ) ofReal(λ⁻ⁿ) = ofReal((λλ⁻¹)ⁿ) = 1`.
  rw [withDensity_apply _ hD, withDensity_apply _ hA, h, ← mul_assoc,
    ← ENNReal.ofReal_mul (pow_nonneg hlam.le n), ← mul_pow, mul_inv_cancel₀ hlam.ne', one_pow,
    ENNReal.ofReal_one, one_mul]

/-- **Density invariance gives invariance of the mass measure** (the measure step of the cone
splitting in the dimension-reducing argument, Simon 7.3.4–7.3.5, chapter-07.txt lines 380–417).
Let `S = τ(M, θ, ξ)` in `ℝᴾ` have a density `Θ(x)` at every `x`, and let
`HasMassDensity S w θ → HasMassDensity S (y + λw) θ` for `y ∈ L`, `λ > 0`.  Then `μ = θHⁿ⌞M`
satisfies (i) `μ(A − y) = μ(A)` for `y ∈ L` and (ii) `μ(λA) = λⁿμ(A)` for `λ > 0`, `A` Borel.
Densities are unique, so `Θ(y + λw) = Θ(w)`; `μ = Θ·Hⁿ` (Simon Ch. 3, Remark 1.8(2); Ch. 1,
Theorem 3.6); and `Θ·Hⁿ` inherits translation invariance and `n`-homogeneity from `Hⁿ`. -/
theorem Submission.dimred_cs_measure_invariant_of_density_invariant : ∀ (P n : ℕ) (S : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n) (L : Submodule ℝ (Euclid P)), 0 < n → R.Represents S → (∀ x : Euclid P, ∃ θ : ℝ, HasMassDensity S x θ) → (∀ y ∈ L, ∀ lam : ℝ, 0 < lam → ∀ (w : Euclid P) (θ : ℝ), HasMassDensity S w θ → HasMassDensity S (y + lam • w) θ) → (∀ y ∈ L, ∀ A : Set (Euclid P), MeasurableSet A → R.measure ((fun x => y + x) ⁻¹' A) = R.measure A) ∧ ∀ lam : ℝ, 0 < lam → ∀ A : Set (Euclid P), MeasurableSet A → R.measure ((fun x => lam • x) '' A) = ENNReal.ofReal (lam ^ n) * R.measure A := by
  intro P n S R L _hn hRS hdens hinv
  -- Step 1: choose the density `Θ(x)` of `S` at every `x`.
  choose Θ hΘ using hdens
  -- Step 2: `μ = Θ·Hⁿ`.
  have hμ : R.measure = (μHE[n] : Measure (Euclid P)).withDensity (fun x => ENNReal.ofReal (Θ x)) :=
    Submission.dimred_cs_mi_measure_eq_withDensity P n S R Θ hRS hΘ
  -- Step 3: densities are unique, so `Θ(y + λw) = Θ(w)` for `y ∈ L`, `λ > 0`.
  have hΘinv : ∀ y ∈ L, ∀ lam : ℝ, 0 < lam → ∀ w : Euclid P, Θ (y + lam • w) = Θ w :=
    fun y hy lam hlam w => Submission.dimred_cs_mi_hasMassDensity_unique P n univ S (y + lam • w)
      _ _ (hΘ (y + lam • w)) (hinv y hy lam hlam w (Θ w) (hΘ w))
  refine ⟨fun y hy A hA => ?_, fun lam hlam A hA => ?_⟩
  -- Step 4, (i): `Θ(y + x) = Θ(x)` (`λ = 1`), and `Θ·Hⁿ` is invariant under such translations.
  · rw [hμ]
    refine Submission.dimred_cs_mi_withDensity_translate P n _ y (fun x => ?_) A hA
    have h := hΘinv y hy 1 one_pos x
    rw [one_smul] at h
    exact congrArg ENNReal.ofReal h
  -- Step 5, (ii): `Θ(λx) = Θ(x)` (`y = 0 ∈ L`), and `Θ·Hⁿ` is `n`-homogeneous under such dilations.
  · rw [hμ]
    refine Submission.dimred_cs_mi_withDensity_dilate P n _ lam hlam (fun x => ?_) A hA
    have h := hΘinv 0 L.zero_mem lam hlam x
    rw [zero_add] at h
    exact congrArg ENNReal.ofReal h
/-- Continuity in the centre of the blow-up integrals of Simon Ch. 3, 1.4: for `f` continuous with
compact support, `r > 0` and `μ` finite on compact sets, `x ↦ ∫ f(η_{x,r}(y)) dμ(y)` is continuous,
`η_{x,r}(y) = r⁻¹(y − x)`.  With `‖f‖ ≤ C` and `tsupport f ⊆ B̄_R(0)`, the integrand vanishes for
`x ∈ B_1(x₀)` and `y ∉ B = B̄_{1+rR}(x₀)`; so near `x₀` it is dominated by `C·1_B`, integrable as
`μ(B) < ∞`, and dominated convergence gives continuity at `x₀`. -/
theorem Submission.continuous_integral_comp_blowUpMap : ∀ (P : ℕ) (μ : Measure (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → μ K ≠ ∞) → ∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → ∀ r : ℝ, 0 < r → Continuous (fun x : Euclid P => ∫ y, f (Poincare.SimonGMT.Chapter03.blowUpMap x r y) ∂μ) := by
  intro P μ hμ f hf hfs r hr
  -- `‖f‖ ≤ C` and `tsupport f ⊆ closedBall 0 R`
  obtain ⟨C, hC⟩ := hf.bounded_above_of_compact_support hfs
  obtain ⟨R, hR⟩ := hfs.isCompact.isBounded.subset_closedBall 0
  -- `(x, y) ↦ f (r⁻¹ • (y - x))` is jointly continuous
  have hF : Continuous fun p : Euclid P × Euclid P =>
      f (Poincare.SimonGMT.Chapter03.blowUpMap p.1 r p.2) :=
    hf.comp ((continuous_snd.sub continuous_fst).const_smul r⁻¹)
  refine continuous_iff_continuousAt.2 fun x₀ => ?_
  -- dominated convergence with the bound `C · 1_B`, `B = closedBall x₀ (1 + r R)`
  refine continuousAt_of_dominated (bound := (closedBall x₀ (1 + r * R)).indicator fun _ => C)
    (Eventually.of_forall fun x => (hF.comp (Continuous.prodMk_right x)).aestronglyMeasurable)
    ?_ ?_ (Eventually.of_forall fun y => (hF.comp (Continuous.prodMk_left y)).continuousAt)
  · -- for `x ∈ ball x₀ 1`, `f (r⁻¹ • (y - x)) ≠ 0` forces `‖y - x‖ ≤ r R`, so `y ∈ B`
    filter_upwards [ball_mem_nhds x₀ one_pos] with x hx
    refine Eventually.of_forall fun y => ?_
    by_cases hy : y ∈ closedBall x₀ (1 + r * R)
    · rw [indicator_of_mem hy]
      exact hC _
    · rw [indicator_of_notMem hy]
      refine le_of_eq (norm_eq_zero.2 (by_contra fun h => hy ?_))
      have h1 := hR (subset_tsupport f h)
      rw [mem_closedBall, dist_zero_right, Poincare.SimonGMT.Chapter03.blowUpMap, norm_smul,
        Real.norm_eq_abs, abs_inv, abs_of_pos hr, inv_mul_le_iff₀ hr, ← dist_eq_norm] at h1
      rw [mem_ball] at hx
      rw [mem_closedBall]
      linarith [dist_triangle y x x₀]
  · -- `C · 1_B` is integrable: `B` is compact, so `μ B < ∞`
    rw [integrable_indicator_iff measurableSet_closedBall]
    exact integrableOn_const (hμ _ (isCompact_closedBall _ _))

/-- **Simon Ch. 3, 1.4**: if `Hⁿ(M ∩ K) < ∞` for every compact `K`, `f` is continuous with
compact support and `r > 0`, then the blow-up integral `x ↦ ∫_{η_{x,r}(M)} f dHⁿ` is continuous.
It equals `r⁻ⁿ ∫_M f(η_{x,r}(y)) dHⁿ(y)`, continuous in `x` because `Hⁿ⌞M` is finite on compact
sets. -/
theorem Submission.continuous_blowUp_image_setIntegral : ∀ (P n : ℕ) (M : Set (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → μHE[n] (M ∩ K) ≠ ∞) → ∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → ∀ r : ℝ, 0 < r → Continuous (fun x : Euclid P => ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, f y ∂μHE[n]) := by
  intro P n M hM f hf hfs r hr
  -- `Hⁿ⌞M` is finite on compact sets: `(Hⁿ⌞M)(K) = Hⁿ(M ∩ K)`, `K` being closed
  have hμ : ∀ K : Set (Euclid P), IsCompact K → (μHE[n].restrict M) K ≠ ∞ := fun K hK => by
    rw [Measure.restrict_apply hK.isClosed.measurableSet, inter_comm]
    exact hM K hK
  -- change of variables, then continuity of `x ↦ r⁻ⁿ ∫_M f(η_{x,r}(y)) dHⁿ(y)`
  exact (continuous_const.mul
    (Submission.continuous_integral_comp_blowUpMap P _ hμ f hf hfs r hr)).congr fun x =>
      (Submission.setIntegral_blowUpMap_image_eq_inv_pow_mul P n M x r hr f).symm
/-- **Simon Ch. 3, 1.4; Ch. 4**: the approximate tangent planes `TₓM` of an integer multiplicity
representation `R = (M, θ, ξ)` in `ℝᴾ` form an `R.measure`-a.e.-measurable field of orthogonal
projections `x ↦ p_{TₓM}` (Borel σ-algebra of the operator-norm topology).  For `n = 0` every
`TₓM` is `⊥`.  For `n ≥ 1` let `f_u(y) = max(1 − |y|², 0)⟨u, y⟩²`: as `θ ≥ 1` on `M`,
`Hⁿ⌞M` is finite on compact sets, so `x ↦ ∫_{η_{x,r}(M)} f_u dHⁿ` is continuous; at `μ`-a.e. `x`
(`R.orients`, `μ = θHⁿ⌞M ≪ Hⁿ⌞M`) `TₓM` exists and these integrals tend, along `r = 1/(k+1)`, to
`∫_{TₓM} f_u dHⁿ = cₙ|p_{TₓM} u|²`, `cₙ > 0`.  So each `x ↦ |p_{TₓM} u|²` is a.e.-measurable,
hence so is `x ↦ p_{TₓM}`. -/
theorem Submission.imrep_univ_tangent_starProjection_aemeasurable : ∀ (P n : ℕ) (R : IMRep (univ : Set (Euclid P)) n), AEMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) R.measure := by
  intro P n R
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · -- `n = 0`: a `0`-dimensional approximate tangent plane is `⊥`, so `p_{TₓM} = 0` for every `x`
    have h0 : ∀ x, (approxTangentPlane 0 R.carrier x).starProjection = 0 := by
      intro x
      have hx : approxTangentPlane 0 R.carrier x = ⊥ := by
        unfold approxTangentPlane
        split_ifs with h
        · exact Submodule.finrank_eq_zero.1 h.choose_spec.1
        · rfl
      rw [hx, Submodule.starProjection_bot]
    simp_rw [h0]
    exact aemeasurable_const
  obtain ⟨c, hc, hcQ⟩ := Submission.exists_plane_cutoff_quadratic_moment_eq n hn
  -- `Hⁿ(M ∩ K) ≤ ∫_{M ∩ K} θ dHⁿ < ∞` for compact `K`, as `θ ≥ 1` on `M`
  have hM : ∀ K : Set (Euclid P), IsCompact K → μHE[n] (R.carrier ∩ K) ≠ ∞ := by
    intro K hK
    refine ne_top_of_le_ne_top (R.locallyIntegrable_mult K hK (subset_univ K)) ?_
    calc μHE[n] (R.carrier ∩ K) = ∫⁻ _ in R.carrier ∩ K, 1 ∂μHE[n] := (setLIntegral_one _).symm
      _ ≤ ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] :=
        setLIntegral_mono' (R.measurableSet_carrier.inter hK.isClosed.measurableSet)
          fun x hx => by exact_mod_cast R.mult_pos x hx.1
  -- `TₓM` is an approximate tangent plane at `μ`-a.e. `x`, since `μ ≪ Hⁿ⌞M`
  have hT : ∀ᵐ x ∂R.measure,
      HasApproximateTangentSpaceAt n R.carrier x (approxTangentPlane n R.carrier x) := by
    have h : ∀ᵐ x ∂μHE[n].restrict R.carrier,
        HasApproximateTangentSpaceAt n R.carrier x (approxTangentPlane n R.carrier x) := by
      filter_upwards [R.orients] with x hx
      obtain ⟨Q, hQ, -⟩ := hx
      have h : ∃ Q, HasApproximateTangentSpaceAt n R.carrier x Q := ⟨Q, hQ⟩
      unfold approxTangentPlane
      rw [dite_eq_left h]
      exact h.choose_spec
    exact (withDensity_absolutelyContinuous _ _).ae_le h
  refine Submission.aemeasurable_starProjection_of_aemeasurable_norm_sq P R.measure
    (approxTangentPlane n R.carrier) fun u => ?_
  -- the test function `f_u(y) = max(1 − |y|², 0)⟨u, y⟩²`, continuous with support in `B̄₁(0)`
  obtain ⟨φ, hφ_def⟩ : ∃ φ : Euclid P → ℝ, φ = fun y => max (1 - ‖y‖ ^ 2) 0 * inner ℝ u y ^ 2 :=
    ⟨_, rfl⟩
  have hφ : Continuous φ := by
    rw [hφ_def]
    fun_prop
  have hφs : HasCompactSupport φ := by
    refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid P) 1) fun z hz => ?_
    have h1 : 1 < ‖z‖ := by simpa using hz
    have h2 : 1 - ‖z‖ ^ 2 ≤ 0 := by nlinarith
    simp [hφ_def, max_eq_right h2]
  -- `|p_x u|² = lim_k c⁻¹ ∫_{η_{x,1/(k+1)}(M)} f_u dHⁿ` at `μ`-a.e. `x`
  refine aemeasurable_of_tendsto_metrizable_ae' (f := fun (k : ℕ) x => c⁻¹ *
      ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x (1 / ((k : ℝ) + 1)) '' R.carrier, φ y ∂μHE[n])
    (fun k => (continuous_const.mul (Submission.continuous_blowUp_image_setIntegral P n R.carrier
      hM φ hφ hφs (1 / ((k : ℝ) + 1)) (by positivity))).aemeasurable) ?_
  filter_upwards [hT] with x hx
  have hr : Tendsto (fun k : ℕ => 1 / ((k : ℝ) + 1)) atTop (𝓝[>] 0) :=
    tendsto_nhdsWithin_iff.2 ⟨tendsto_one_div_add_atTop_nhds_zero_nat,
      Eventually.of_forall fun k => mem_Ioi.2 (by positivity)⟩
  have hval : ‖(approxTangentPlane n R.carrier x).starProjection u‖ ^ 2 =
      c⁻¹ * ∫ y in (approxTangentPlane n R.carrier x : Set (Euclid P)), φ y ∂μHE[n] := by
    rw [hφ_def, hcQ P _ hx.1 u, inv_mul_cancel_left₀ hc.ne']
  rw [hval]
  exact ((hx.2 ⟨⟨φ, hφ⟩, hφs⟩).comp hr).const_mul c⁻¹
/-- **A.e. strongly measurable maps into `L(ℝᴾ, ℝᴾ)` are a.e. measurable.**  With the operator
norm, `Euclid P →L[ℝ] Euclid P` is a metric space whose measurable structure is its Borel
σ-algebra (`ContinuousLinearMap.instBorelSpace`).  A strongly measurable representative `g` of `f`
is a pointwise limit of simple functions `gₖ`; for open `O ≠ L`, `dist(gₖ, Oᶜ) → dist(g, Oᶜ)`, so
`g⁻¹(O) = {dist(g, Oᶜ) > 0}` is measurable.  Hence `g` is Borel measurable and `f = g` a.e. -/
theorem Submission.dtc_cone_opEuclid_aemeasurable_of_aesm : ∀ (P : ℕ) (μ : Measure (Euclid P)) (f : Euclid P → (Euclid P →L[ℝ] Euclid P)), AEStronglyMeasurable f μ → AEMeasurable f μ := by
  intro P μ f hf
  exact hf.aemeasurable

/-- **The approximate tangent projection of an integer multiplicity triple is a.e. measurable**
(Simon Ch. 3, 1.4 and 1.5(1); Ch. 6, 3.1).  For `R = (M, θ, ξ)`, `x ↦ p_{TₓM}` is
`Hⁿ⌞M`-a.e. strongly measurable, since a.e. `TₓM` is the plane oriented by `ξ(x)`.  A.e. strongly
measurable maps into the finite-dimensional normed space `L(ℝᴾ, ℝᴾ)` are a.e. measurable for its
Borel σ-algebra. -/
theorem Submission.dtc_cone_tangentProjection_aemeasurable : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), AEMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) (μHE[n].restrict R.carrier) := by
  intro P n U R
  exact Submission.dtc_cone_opEuclid_aemeasurable_of_aesm P _ _
    (Submission.imrep_approxTangent_starProjection_aesm P n U R)
/-- **Simon 4.3.6, the stationary monotonicity identity** (Ch. 4, 3.1–3.6, chapter-04.txt
lines 215–307, applied with `U = ℝᴾ`; used in the proof of 7.3.1, chapter-07.txt line 356).
Let `R = (M, θ, ξ)` be an integer multiplicity triple in `ℝᴾ` with `V = v(M, θ)` stationary:
`δV(X) = 0` for every `X ∈ C¹_c(ℝᴾ; ℝᴾ)`.  Then for `z ∈ ℝᴾ` and `0 < σ ≤ ρ`, with closed balls,
`μ_V = θHⁿ⌞M` and `p_x` the orthogonal projection onto `TₓM`,
`σ⁻ⁿμ_V(B_σ(z)) + ∫_{B_ρ(z) \ B_σ(z)} |(x − z) − p_x(x − z)|² / |x − z|ⁿ⁺² dμ_V = ρ⁻ⁿμ_V(B_ρ(z))`.
`δV(X) = ∫ div_M X dμ_V`, and for `X(x) = η(|x − z|²)(x − z)` (3.2), `μ_V`-a.e.
`div_M X = nη + 2η'|p_x(x − z)|²`, since `dim TₓM = n` and `x ↦ p_x` is `μ_V`-measurable
(`dtc_cone_tangentProjection_aemeasurable`, `μ_V ≪ Hⁿ⌞M`).  Simon integrates (3.3) for the
cutoffs `φ(r/t)` against `t⁻ⁿ⁻¹ dt` over `[σ, ρ]` (3.4–3.5); here this is done in the field:
`η = F ∘ m_σ − F ∘ m_ρ` with `F(u) = u^{-n/2}` and `m_c` a `C¹` smoothing of `max(·, c²)` on
`[c², c² + ε]`, so `η → max(·, σ²)^{-n/2} − max(·, ρ²)^{-n/2}` as `ε ↓ 0`.  The divergences
converge pointwise and are uniformly bounded on `B_{ρ+1}(z)`, so dominated convergence (3.6)
gives `n(σ⁻ⁿμ_V(B_σ) − ρ⁻ⁿμ_V(B_ρ) + ∫_{B_ρ \ B_σ} |D^⊥r|²r⁻ⁿ dμ_V) = 0`, with `D^⊥r` the normal
part of `(x − z)/|x − z|`.  For `n = 0`, `TₓM = 0` a.e. and the identity is additivity of
`μ_V`. -/
theorem Submission.dtc_cone_monotonicity_identity : ∀ (P n : ℕ) (R : IMRep (univ : Set (Euclid P)) n), (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → R.firstVariation X = 0) → ∀ (z : Euclid P) (σ ρ : ℝ), 0 < σ → σ ≤ ρ → R.measure (closedBall z σ) / ENNReal.ofReal (σ ^ n) + ∫⁻ x in closedBall z ρ \ closedBall z σ, ENNReal.ofReal (‖(x - z) - (approxTangentPlane n R.carrier x).starProjection (x - z)‖ ^ 2 / ‖x - z‖ ^ (n + 2)) ∂R.measure = R.measure (closedBall z ρ) / ENNReal.ofReal (ρ ^ n) := by
  intro P n R hstat z σ ρ hσ hσρ
  classical
  have hρ : 0 < ρ := hσ.trans_le hσρ
  -- `μ_V = θHⁿ⌞M` is finite on compact sets
  have : IsFiniteMeasureOnCompacts R.measure := ⟨fun K hK => by
    rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
      Measure.restrict_restrict hK.measurableSet, inter_comm]
    exact (R.locallyIntegrable_mult K hK (subset_univ K)).lt_top⟩
  -- `x ↦ p_x` is `μ_V`-measurable, since `μ_V ≪ Hⁿ⌞M`
  have hp : AEMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) R.measure :=
    (Submission.dtc_cone_tangentProjection_aemeasurable P n univ R).mono_ac
      (withDensity_absolutelyContinuous _ _)
  have hpv : AEMeasurable
      (fun x => ‖(approxTangentPlane n R.carrier x).starProjection (x - z)‖ ^ 2) R.measure :=
    (ContinuousLinearMap.measurable_apply₂.comp_aemeasurable
      (hp.prodMk (measurable_id.sub_const z).aemeasurable)).norm.pow_const 2
  -- `μ_V`-a.e., `TₓM` is an `n`-dimensional approximate tangent plane
  have hrank : ∀ᵐ x ∂R.measure, Module.finrank ℝ (approxTangentPlane n R.carrier x) = n := by
    refine (withDensity_absolutelyContinuous _ _).ae_le ?_
    filter_upwards [R.orients] with x hx
    obtain ⟨Q, hQ, -⟩ := hx
    have h : ∃ Q, HasApproximateTangentSpaceAt n R.carrier x Q := ⟨Q, hQ⟩
    rw [approxTangentPlane, dite_eq_left h]
    exact h.choose_spec.finrank_eq
  -- Pythagoras: `|(x - z) - p_x(x - z)|² = |x - z|² - |p_x(x - z)|²`
  have hpyth : ∀ x : Euclid P,
      ‖(x - z) - (approxTangentPlane n R.carrier x).starProjection (x - z)‖ ^ 2 =
        ‖x - z‖ ^ 2 - ‖(approxTangentPlane n R.carrier x).starProjection (x - z)‖ ^ 2 := by
    intro x
    have h := Submodule.norm_sq_eq_add_norm_sq_starProjection (x - z)
      (approxTangentPlane n R.carrier x)
    rw [Submodule.starProjection_orthogonal] at h
    simp only [sub_apply, ContinuousLinearMap.id_apply] at h
    linarith
  -- the first variation is the `μ_V`-integral of `div_M X`
  have hfv : ∀ Y : Euclid P → Euclid P,
      R.firstVariation Y = ∫ x, tangentialDivergence n R.carrier Y x ∂R.measure := by
    intro Y
    have hd : (fun x => (R.mult x : ℝ≥0∞)) = fun x => ((R.mult x : NNReal) : ℝ≥0∞) := by
      funext x
      simp
    have hm : Measurable fun x => (R.mult x : NNReal) :=
      (measurable_from_nat (f := fun k : ℕ => (k : NNReal))).comp R.measurable_mult
    rw [IMRep.measure, IMRep.firstVariation, hd, integral_withDensity_eq_integral_smul hm]
    exact integral_congr_ae (Eventually.of_forall fun x => by simp [NNReal.smul_def])
  -- Simon 4.3.2–4.3.3 for radial fields `X(x) = η(|x - z|²)(x - z)`:
  -- `div_M X = n η(|x - z|²) + 2η'(|x - z|²)|p_x(x - z)|²` `μ_V`-a.e.
  have hrad : ∀ η : ℝ → ℝ, ContDiff ℝ 1 η → ∀ R0 : ℝ, (∀ s, R0 ^ 2 ≤ s → η s = 0) →
      ∫ x, ((n : ℝ) * η (‖x - z‖ ^ 2) + 2 * deriv η (‖x - z‖ ^ 2) *
        ‖(approxTangentPlane n R.carrier x).starProjection (x - z)‖ ^ 2) ∂R.measure = 0 := by
    intro η hη R0 hcut
    have hsub : ContDiff ℝ 1 (fun x : Euclid P => x - z) := contDiff_id.sub contDiff_const
    have hX : ContDiff ℝ 1 (fun x : Euclid P => η (‖x - z‖ ^ 2) • (x - z)) :=
      (hη.comp (hsub.norm_sq ℝ)).smul hsub
    have hXc : HasCompactSupport (fun x : Euclid P => η (‖x - z‖ ^ 2) • (x - z)) := by
      refine (isCompact_closedBall z |R0|).of_isClosed_subset (isClosed_tsupport _) ?_
      refine closure_minimal (fun x hx => ?_) isClosed_closedBall
      by_contra hball
      have hnorm : |R0| < ‖x - z‖ := by
        simpa only [mem_closedBall, dist_eq_norm, not_le] using hball
      have hR0 : R0 ^ 2 ≤ ‖x - z‖ ^ 2 := by
        rw [← sq_abs]
        exact pow_le_pow_left₀ (abs_nonneg _) hnorm.le 2
      exact hx (by simp [hcut _ hR0])
    have hD : ∀ x : Euclid P, HasFDerivAt (fun y : Euclid P => η (‖y - z‖ ^ 2) • (y - z))
        (η (‖x - z‖ ^ 2) • ContinuousLinearMap.id ℝ (Euclid P) +
          (2 * deriv η (‖x - z‖ ^ 2)) • (innerSL ℝ (x - z)).smulRight (x - z)) x := by
      intro x
      have hs : HasFDerivAt (fun y : Euclid P => y - z) (ContinuousLinearMap.id ℝ (Euclid P)) x :=
        hasFDerivAt_sub_const z
      have hηx := ((hη.differentiable (by simp)) (‖x - z‖ ^ 2)).hasDerivAt
      refine ((hηx.comp_hasFDerivAt x hs.norm_sq).smul hs).congr_fderiv
        (ContinuousLinearMap.ext fun w => ?_)
      simp only [Function.comp_apply, add_apply, smul_apply, ContinuousLinearMap.id_apply,
        ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.comp_apply, innerSL_apply_apply]
      module
    have htr : ∀ x : Euclid P,
        tangentialDivergence n R.carrier (fun y : Euclid P => η (‖y - z‖ ^ 2) • (y - z)) x =
          η (‖x - z‖ ^ 2) * (Module.finrank ℝ (approxTangentPlane n R.carrier x) : ℝ) +
            2 * deriv η (‖x - z‖ ^ 2) *
              ‖(approxTangentPlane n R.carrier x).starProjection (x - z)‖ ^ 2 := by
      intro x
      rw [tangentialDivergence, (hD x).fderiv]
      set K := approxTangentPlane n R.carrier x
      have hlin : K.starProjection.toLinearMap ∘ₗ
          (η (‖x - z‖ ^ 2) • ContinuousLinearMap.id ℝ (Euclid P) +
            (2 * deriv η (‖x - z‖ ^ 2)) • (innerSL ℝ (x - z)).smulRight (x - z)).toLinearMap =
          η (‖x - z‖ ^ 2) • K.starProjection.toLinearMap +
            (2 * deriv η (‖x - z‖ ^ 2)) •
              (innerSL ℝ (x - z)).toLinearMap.smulRight (K.starProjection (x - z)) := by
        ext w
        simp [map_smul, smul_smul]
      have htrK : LinearMap.trace ℝ (Euclid P) K.starProjection.toLinearMap =
          (Module.finrank ℝ K : ℝ) := by
        rw [Submodule.starProjection, ContinuousLinearMap.toLinearMap_comp,
          LinearMap.trace_comp_comm']
        have hcomp : K.orthogonalProjectionOnto.toLinearMap.comp K.subtypeL.toLinearMap =
            LinearMap.id := by
          ext y
          simp
        rw [hcomp, LinearMap.trace_id]
      have hinner :
          inner ℝ (x - z) (K.starProjection (x - z)) = ‖K.starProjection (x - z)‖ ^ 2 := by
        rw [← K.inner_starProjection_left_eq_right (x - z) (x - z)]
        simpa using K.re_inner_starProjection_eq_normSq (x - z)
      rw [hlin, map_add, map_smul, map_smul, LinearMap.trace_smulRight, htrK]
      simp only [smul_eq_mul, ContinuousLinearMap.coe_coe, innerSL_apply_apply, hinner]
      ring
    have h0 := hstat _ hX hXc
    rw [hfv] at h0
    rw [← h0]
    refine integral_congr_ae ?_
    filter_upwards [hrank] with x hx
    rw [htr x, hx]
    ring
  -- the smooth transition `τ` (`0` on `(-∞, 0]`, `1` on `[1, ∞)`) and a bound for `τ'`
  have hτc : ContDiff ℝ 1 Real.smoothTransition := Real.smoothTransition.contDiff
  have hτd : ∀ u, HasDerivAt Real.smoothTransition (deriv Real.smoothTransition u) u :=
    fun u => ((hτc.differentiable (by simp)) u).hasDerivAt
  have hτ0 : ∀ u : ℝ, u < 0 → deriv Real.smoothTransition u = 0 := by
    intro u hu
    have h : Real.smoothTransition =ᶠ[𝓝 u] fun _ => 0 := by
      filter_upwards [gt_mem_nhds hu] with w hw
      exact Real.smoothTransition.zero_of_nonpos hw.le
    rw [h.deriv_eq, deriv_const]
  have hτ1 : ∀ u : ℝ, 1 < u → deriv Real.smoothTransition u = 0 := by
    intro u hu
    have h : Real.smoothTransition =ᶠ[𝓝 u] fun _ => 1 := by
      filter_upwards [lt_mem_nhds hu] with w hw
      exact Real.smoothTransition.one_of_one_le hw.le
    rw [h.deriv_eq, deriv_const]
  obtain ⟨Cτ, hCτ⟩ := isCompact_Icc.exists_bound_of_continuousOn
    ((hτc.continuous_deriv le_rfl).continuousOn (s := Icc (0 : ℝ) 1))
  have hCτ0 : 0 ≤ Cτ := (norm_nonneg _).trans (hCτ 0 ⟨le_rfl, zero_le_one⟩)
  -- `m c ε` is `C¹`, equals `c` on `(-∞, c]` and the identity on `(c + ε, ∞)`; `dm c ε = (m c ε)'`
  obtain ⟨m, hm⟩ : ∃ m : ℝ → ℝ → ℝ → ℝ,
      ∀ c ε s, m c ε s = c + (s - c) * Real.smoothTransition ((s - c) / ε) :=
    ⟨_, fun _ _ _ => rfl⟩
  obtain ⟨dm, hdm⟩ : ∃ dm : ℝ → ℝ → ℝ → ℝ, ∀ c ε s, dm c ε s = Real.smoothTransition ((s - c) / ε) +
      (s - c) / ε * deriv Real.smoothTransition ((s - c) / ε) :=
    ⟨_, fun _ _ _ => rfl⟩
  have hm_deriv : ∀ c ε s, ε ≠ 0 → HasDerivAt (m c ε) (dm c ε s) s := by
    intro c ε s hε
    rw [show m c ε = fun t => c + (t - c) * Real.smoothTransition ((t - c) / ε) from
      funext (hm c ε), hdm]
    have h1 : HasDerivAt (fun t : ℝ => t - c) 1 s := (hasDerivAt_id s).sub_const c
    have h3 := (hτd ((s - c) / ε)).comp s (h1.div_const ε)
    refine ((h1.mul h3).const_add c).congr_deriv ?_
    simp only [Function.comp_apply]
    field_simp
  have hm_cd : ∀ c ε, ContDiff ℝ 1 (m c ε) := by
    intro c ε
    rw [show m c ε = fun t => c + (t - c) * Real.smoothTransition ((t - c) / ε) from
      funext (hm c ε)]
    exact contDiff_const.add ((contDiff_id.sub contDiff_const).mul
      (hτc.comp ((contDiff_id.sub contDiff_const).div_const ε)))
  have hm_lo : ∀ c ε s, 0 < ε → s ≤ c → m c ε s = c ∧ dm c ε s = 0 := by
    intro c ε s hε hs
    have hu : (s - c) / ε ≤ 0 := div_nonpos_of_nonpos_of_nonneg (by linarith) hε.le
    refine ⟨by rw [hm, Real.smoothTransition.zero_of_nonpos hu, mul_zero, add_zero], ?_⟩
    rw [hdm, Real.smoothTransition.zero_of_nonpos hu, zero_add]
    rcases hu.lt_or_eq with hu' | hu'
    · rw [hτ0 _ hu', mul_zero]
    · rw [hu', zero_mul]
  have hm_hi : ∀ c ε s, 0 < ε → c + ε < s → m c ε s = s ∧ dm c ε s = 1 := by
    intro c ε s hε hs
    have hu : 1 < (s - c) / ε := (one_lt_div hε).mpr (by linarith)
    refine ⟨by rw [hm, Real.smoothTransition.one_of_one_le hu.le, mul_one]; ring, ?_⟩
    rw [hdm, Real.smoothTransition.one_of_one_le hu.le, hτ1 _ hu, mul_zero, add_zero]
  have hm_ge : ∀ c ε s, 0 < ε → c ≤ m c ε s := by
    intro c ε s hε
    rw [hm]
    rcases le_or_gt s c with hs | hs
    · rw [Real.smoothTransition.zero_of_nonpos
        (div_nonpos_of_nonpos_of_nonneg (by linarith) hε.le), mul_zero, add_zero]
    · have := Real.smoothTransition.nonneg ((s - c) / ε)
      nlinarith
  have hdm_le : ∀ c ε s, |dm c ε s| ≤ 1 + Cτ := by
    intro c ε s
    rw [hdm]
    rcases lt_or_ge ((s - c) / ε) 0 with hu | hu
    · rw [Real.smoothTransition.zero_of_nonpos hu.le, hτ0 _ hu, mul_zero, add_zero, abs_zero]
      linarith
    rcases le_or_gt ((s - c) / ε) 1 with hu1 | hu1
    · have h1 := hCτ _ ⟨hu, hu1⟩
      rw [Real.norm_eq_abs] at h1
      calc |Real.smoothTransition ((s - c) / ε) +
            (s - c) / ε * deriv Real.smoothTransition ((s - c) / ε)|
          ≤ |Real.smoothTransition ((s - c) / ε)| +
            |(s - c) / ε * deriv Real.smoothTransition ((s - c) / ε)| := abs_add_le _ _
        _ ≤ 1 + 1 * Cτ := by
          gcongr
          · rw [abs_of_nonneg (Real.smoothTransition.nonneg _)]
            exact Real.smoothTransition.le_one _
          · rw [abs_mul, abs_of_nonneg hu]
            exact mul_le_mul hu1 h1 (abs_nonneg _) zero_le_one
        _ = 1 + Cτ := by ring
    · rw [Real.smoothTransition.one_of_one_le hu1.le, hτ1 _ hu1, mul_zero, add_zero, abs_one]
      linarith
  -- the profile `F(u) = u^{-n/2}`, so that `F(|x - z|²) = |x - z|⁻ⁿ`, and its derivative
  obtain ⟨F, hF⟩ : ∃ F : ℝ → ℝ, ∀ u, F u = u ^ (-(n : ℝ) / 2) := ⟨_, fun _ => rfl⟩
  obtain ⟨F', hF'⟩ : ∃ F' : ℝ → ℝ, ∀ u, F' u = -(n : ℝ) / 2 * u ^ (-(n : ℝ) / 2 - 1) :=
    ⟨_, fun _ => rfl⟩
  have hF_deriv : ∀ u, 0 < u → HasDerivAt F (F' u) u := by
    intro u hu
    rw [show F = fun u => u ^ (-(n : ℝ) / 2) from funext hF, hF']
    exact Real.hasDerivAt_rpow_const (Or.inl hu.ne')
  have hF_cd : ∀ u, 0 < u → ContDiffAt ℝ 1 F u := by
    intro u hu
    rw [show F = fun u => u ^ (-(n : ℝ) / 2) from funext hF]
    exact Real.contDiffAt_rpow_const_of_ne hu.ne'
  have hσ2 : 0 < σ ^ 2 := by positivity
  have hρ2 : σ ^ 2 ≤ ρ ^ 2 := pow_le_pow_left₀ hσ.le hσρ 2
  have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  have hF_le : ∀ u, σ ^ 2 ≤ u → |F u| ≤ F (σ ^ 2) := by
    intro u hu
    rw [hF, hF, abs_of_pos (Real.rpow_pos_of_pos (hσ2.trans_le hu) _)]
    exact Real.rpow_le_rpow_of_nonpos hσ2 hu (by linarith)
  have hF'_le : ∀ u, σ ^ 2 ≤ u → |F' u| ≤ (n : ℝ) / 2 * (σ ^ 2) ^ (-(n : ℝ) / 2 - 1) := by
    intro u hu
    rw [hF', abs_mul, abs_of_pos (Real.rpow_pos_of_pos (hσ2.trans_le hu) _),
      abs_of_nonpos (by linarith : -(n : ℝ) / 2 ≤ 0), show -(-(n : ℝ) / 2) = (n : ℝ) / 2 by ring]
    exact mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_nonpos hσ2 hu (by linarith))
      (by positivity)
  have hFsq : ∀ t : ℝ, 0 < t → F (t ^ 2) = (t ^ n)⁻¹ := by
    intro t ht
    rw [hF, show t ^ 2 = t ^ (2 : ℝ) by norm_cast, ← Real.rpow_mul ht.le,
      show (2 : ℝ) * (-(n : ℝ) / 2) = -(n : ℝ) by ring, Real.rpow_neg ht.le, Real.rpow_natCast]
  have hF'sq : ∀ t : ℝ, 0 < t → F' (t ^ 2) = -(n : ℝ) / 2 * (t ^ (n + 2))⁻¹ := by
    intro t ht
    rw [hF', show t ^ 2 = t ^ (2 : ℝ) by norm_cast, ← Real.rpow_mul ht.le,
      show (2 : ℝ) * (-(n : ℝ) / 2 - 1) = -((n + 2 : ℕ) : ℝ) by push_cast; ring,
      Real.rpow_neg ht.le, Real.rpow_natCast]
  -- the test profiles `η ε ≈ max(·, σ²)^{-n/2} - max(·, ρ²)^{-n/2}` and their derivatives
  obtain ⟨η, hη⟩ : ∃ η : ℝ → ℝ → ℝ, ∀ ε s, η ε s = F (m (σ ^ 2) ε s) - F (m (ρ ^ 2) ε s) :=
    ⟨_, fun _ _ => rfl⟩
  obtain ⟨dη, hdη⟩ : ∃ dη : ℝ → ℝ → ℝ, ∀ ε s, dη ε s =
      F' (m (σ ^ 2) ε s) * dm (σ ^ 2) ε s - F' (m (ρ ^ 2) ε s) * dm (ρ ^ 2) ε s :=
    ⟨_, fun _ _ => rfl⟩
  have hmpos : ∀ c ε s, 0 < ε → σ ^ 2 ≤ c → 0 < m c ε s :=
    fun c ε s hε hc => hσ2.trans_le (hc.trans (hm_ge c ε s hε))
  have hη_deriv : ∀ ε s, 0 < ε → HasDerivAt (η ε) (dη ε s) s := by
    intro ε s hε
    rw [show η ε = fun s => F (m (σ ^ 2) ε s) - F (m (ρ ^ 2) ε s) from funext (hη ε), hdη]
    exact ((hF_deriv _ (hmpos _ ε s hε le_rfl)).comp s (hm_deriv _ ε s hε.ne')).sub
      ((hF_deriv _ (hmpos _ ε s hε hρ2)).comp s (hm_deriv _ ε s hε.ne'))
  have hη_cd : ∀ ε, 0 < ε → ContDiff ℝ 1 (η ε) := by
    intro ε hε
    rw [show η ε = fun s => F (m (σ ^ 2) ε s) - F (m (ρ ^ 2) ε s) from funext (hη ε)]
    refine contDiff_iff_contDiffAt.2 fun s => ?_
    exact ((hF_cd _ (hmpos _ ε s hε le_rfl)).comp s (hm_cd _ ε).contDiffAt).sub
      ((hF_cd _ (hmpos _ ε s hε hρ2)).comp s (hm_cd _ ε).contDiffAt)
  have hη_cut : ∀ ε s, 0 < ε → ε ≤ 1 → (ρ + 1) ^ 2 ≤ s → η ε s = 0 ∧ dη ε s = 0 := by
    intro ε s hε hε1 hs
    have hs' : ρ ^ 2 + ε < s := by nlinarith
    obtain ⟨h1, h2⟩ := hm_hi (σ ^ 2) ε s hε (by linarith)
    obtain ⟨h3, h4⟩ := hm_hi (ρ ^ 2) ε s hε hs'
    rw [hη, hdη, h1, h2, h3, h4]
    constructor <;> ring
  -- the widths `εₖ = 1/(k + 1)` and the divergences `Gₖ` of the corresponding radial fields
  have hεpos : ∀ k : ℕ, (0 : ℝ) < 1 / ((k : ℝ) + 1) := fun k => by positivity
  have hεle : ∀ k : ℕ, 1 / ((k : ℝ) + 1) ≤ 1 := fun k => by
    rw [div_le_one (by positivity)]
    linarith [(Nat.cast_nonneg k : (0 : ℝ) ≤ k)]
  obtain ⟨G, hG⟩ : ∃ G : ℕ → Euclid P → ℝ, ∀ k x, G k x =
      (n : ℝ) * η (1 / ((k : ℝ) + 1)) (‖x - z‖ ^ 2) + 2 * dη (1 / ((k : ℝ) + 1)) (‖x - z‖ ^ 2) *
        ‖(approxTangentPlane n R.carrier x).starProjection (x - z)‖ ^ 2 :=
    ⟨_, fun _ _ => rfl⟩
  have hG0 : ∀ k, ∫ x, G k x ∂R.measure = 0 := by
    intro k
    have h := hrad (η (1 / ((k : ℝ) + 1))) (hη_cd _ (hεpos k)) (ρ + 1)
      (fun s hs => (hη_cut _ s (hεpos k) (hεle k) hs).1)
    have hder : ∀ s, deriv (η (1 / ((k : ℝ) + 1))) s = dη (1 / ((k : ℝ) + 1)) s :=
      fun s => (hη_deriv _ s (hεpos k)).deriv
    simp only [hder] at h
    simpa only [hG] using h
  -- the defect `Ψ = |D^⊥r|²/rⁿ` and the pointwise limit `L` of the `Gₖ`
  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : Euclid P → ℝ, ∀ x, Ψ x =
      ‖(x - z) - (approxTangentPlane n R.carrier x).starProjection (x - z)‖ ^ 2 /
        ‖x - z‖ ^ (n + 2) :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨L, hL⟩ : ∃ L : Euclid P → ℝ, ∀ x, L x =
      (n : ℝ) * ((closedBall z σ).indicator (fun _ => (σ ^ n)⁻¹) x -
        (closedBall z ρ).indicator (fun _ => (ρ ^ n)⁻¹) x +
          (closedBall z ρ \ closedBall z σ).indicator Ψ x) :=
    ⟨_, fun _ => rfl⟩
  have hεmono : ∀ k k0 : ℕ, k0 ≤ k → 1 / ((k : ℝ) + 1) ≤ 1 / ((k0 : ℝ) + 1) := fun k k0 hk =>
    one_div_le_one_div_of_le (by positivity) (by exact_mod_cast Nat.add_le_add_right hk 1)
  have hlim : ∀ x, Tendsto (fun k : ℕ => G k x) atTop (𝓝 (L x)) := by
    intro x
    by_cases hxσ : x ∈ closedBall z σ
    · -- inside `B_σ(z)` every `Gₖ(x)` is `n(σ⁻ⁿ - ρ⁻ⁿ)`
      have hs : ‖x - z‖ ^ 2 ≤ σ ^ 2 := by
        rw [mem_closedBall, dist_eq_norm] at hxσ
        exact pow_le_pow_left₀ (norm_nonneg _) hxσ 2
      refine tendsto_atTop_of_eventually_const (i₀ := 0) fun k _ => ?_
      obtain ⟨h1, h2⟩ := hm_lo (σ ^ 2) _ _ (hεpos k) hs
      obtain ⟨h3, h4⟩ := hm_lo (ρ ^ 2) _ _ (hεpos k) (hs.trans hρ2)
      rw [hG, hL, hη, hdη, h1, h2, h3, h4, indicator_of_mem hxσ,
        indicator_of_mem (closedBall_subset_closedBall hσρ hxσ),
        indicator_of_notMem (fun h => h.2 hxσ), hFsq σ hσ, hFsq ρ hρ]
      ring
    have hxσ' : σ < ‖x - z‖ := by simpa only [mem_closedBall, dist_eq_norm, not_le] using hxσ
    have hr : 0 < ‖x - z‖ := hσ.trans hxσ'
    have hs1 : σ ^ 2 < ‖x - z‖ ^ 2 := pow_lt_pow_left₀ hxσ' hσ.le two_ne_zero
    by_cases hxρ : x ∈ closedBall z ρ
    · -- on the annulus, eventually `Gₖ(x) = n(|x - z|⁻ⁿ - ρ⁻ⁿ) - n|p_x(x - z)|²/|x - z|ⁿ⁺²`
      have hs2 : ‖x - z‖ ^ 2 ≤ ρ ^ 2 := by
        rw [mem_closedBall, dist_eq_norm] at hxρ
        exact pow_le_pow_left₀ (norm_nonneg _) hxρ 2
      obtain ⟨k0, hk0⟩ := exists_nat_one_div_lt (sub_pos.mpr hs1)
      refine tendsto_atTop_of_eventually_const (i₀ := k0) fun k hk => ?_
      have hεk := hεmono k k0 hk
      obtain ⟨h1, h2⟩ := hm_hi (σ ^ 2) _ (‖x - z‖ ^ 2) (hεpos k) (by linarith)
      obtain ⟨h3, h4⟩ := hm_lo (ρ ^ 2) _ _ (hεpos k) hs2
      rw [hG, hL, hη, hdη, h1, h2, h3, h4, indicator_of_notMem hxσ, indicator_of_mem hxρ,
        indicator_of_mem (show x ∈ closedBall z ρ \ closedBall z σ from ⟨hxρ, hxσ⟩), hΨ, hpyth,
        hFsq _ hr, hFsq ρ hρ, hF'sq _ hr]
      field_simp
      ring
    · -- outside `B_ρ(z)`, eventually `Gₖ(x) = 0`
      have hxρ' : ρ < ‖x - z‖ := by simpa only [mem_closedBall, dist_eq_norm, not_le] using hxρ
      have hs2 : ρ ^ 2 < ‖x - z‖ ^ 2 := pow_lt_pow_left₀ hxρ' hρ.le two_ne_zero
      obtain ⟨k0, hk0⟩ := exists_nat_one_div_lt (sub_pos.mpr hs2)
      refine tendsto_atTop_of_eventually_const (i₀ := k0) fun k hk => ?_
      have hεk := hεmono k k0 hk
      obtain ⟨h1, h2⟩ := hm_hi (σ ^ 2) _ (‖x - z‖ ^ 2) (hεpos k) (by linarith)
      obtain ⟨h3, h4⟩ := hm_hi (ρ ^ 2) _ (‖x - z‖ ^ 2) (hεpos k) (by linarith)
      rw [hG, hL, hη, hdη, h1, h2, h3, h4, indicator_of_notMem hxσ, indicator_of_notMem hxρ,
        indicator_of_notMem (fun h => hxρ h.1)]
      ring
  -- uniform domination of the `Gₖ` on `B_{ρ+1}(z)`
  have hGbound : ∀ k x, ‖G k x‖ ≤ (closedBall z (ρ + 1)).indicator (fun _ =>
      (n : ℝ) * (2 * F (σ ^ 2)) +
        2 * (2 * ((n : ℝ) / 2 * (σ ^ 2) ^ (-(n : ℝ) / 2 - 1) * (1 + Cτ))) * (ρ + 1) ^ 2) x := by
    intro k x
    have hε := hεpos k
    by_cases hx : x ∈ closedBall z (ρ + 1)
    · rw [indicator_of_mem hx, hG, Real.norm_eq_abs]
      have hxr : ‖x - z‖ ≤ ρ + 1 := by rwa [mem_closedBall, dist_eq_norm] at hx
      have hηb : |η (1 / ((k : ℝ) + 1)) (‖x - z‖ ^ 2)| ≤ 2 * F (σ ^ 2) := by
        rw [hη]
        refine (abs_sub _ _).trans ?_
        linarith [hF_le _ (hm_ge (σ ^ 2) (1 / ((k : ℝ) + 1)) (‖x - z‖ ^ 2) hε),
          hF_le _ (hρ2.trans (hm_ge (ρ ^ 2) (1 / ((k : ℝ) + 1)) (‖x - z‖ ^ 2) hε))]
      have hdηb : |dη (1 / ((k : ℝ) + 1)) (‖x - z‖ ^ 2)| ≤
          2 * ((n : ℝ) / 2 * (σ ^ 2) ^ (-(n : ℝ) / 2 - 1) * (1 + Cτ)) := by
        rw [hdη]
        refine (abs_sub _ _).trans ?_
        rw [abs_mul, abs_mul]
        have h1 := hF'_le _ (hm_ge (σ ^ 2) (1 / ((k : ℝ) + 1)) (‖x - z‖ ^ 2) hε)
        have h2 := hF'_le _ (hρ2.trans (hm_ge (ρ ^ 2) (1 / ((k : ℝ) + 1)) (‖x - z‖ ^ 2) hε))
        have h3 := hdm_le (σ ^ 2) (1 / ((k : ℝ) + 1)) (‖x - z‖ ^ 2)
        have h4 := hdm_le (ρ ^ 2) (1 / ((k : ℝ) + 1)) (‖x - z‖ ^ 2)
        have h5 := mul_le_mul h1 h3 (abs_nonneg _) (le_trans (abs_nonneg _) h1)
        have h6 := mul_le_mul h2 h4 (abs_nonneg _) (le_trans (abs_nonneg _) h2)
        linarith
      have hpvb : ‖(approxTangentPlane n R.carrier x).starProjection (x - z)‖ ^ 2 ≤ (ρ + 1) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _)
          (((approxTangentPlane n R.carrier x).norm_starProjection_apply_le (x - z)).trans hxr) 2
      calc |(n : ℝ) * η (1 / ((k : ℝ) + 1)) (‖x - z‖ ^ 2) +
            2 * dη (1 / ((k : ℝ) + 1)) (‖x - z‖ ^ 2) *
              ‖(approxTangentPlane n R.carrier x).starProjection (x - z)‖ ^ 2|
          ≤ (n : ℝ) * |η (1 / ((k : ℝ) + 1)) (‖x - z‖ ^ 2)| +
            2 * |dη (1 / ((k : ℝ) + 1)) (‖x - z‖ ^ 2)| *
              ‖(approxTangentPlane n R.carrier x).starProjection (x - z)‖ ^ 2 := by
            refine (abs_add_le _ _).trans (le_of_eq ?_)
            rw [abs_mul, abs_mul, abs_mul, abs_of_nonneg hn0, abs_two,
              abs_of_nonneg (by positivity :
                (0 : ℝ) ≤ ‖(approxTangentPlane n R.carrier x).starProjection (x - z)‖ ^ 2)]
        _ ≤ _ := by gcongr
    · rw [indicator_of_notMem hx, hG, norm_le_zero_iff]
      have hxr : ρ + 1 < ‖x - z‖ := by
        simpa only [mem_closedBall, dist_eq_norm, not_le] using hx
      obtain ⟨h1, h2⟩ := hη_cut _ _ hε (hεle k)
        (pow_le_pow_left₀ (by linarith) hxr.le 2)
      rw [h1, h2]
      ring
  -- measurability of the `Gₖ` and of `Ψ`
  have hGmeas : ∀ k, AEStronglyMeasurable (G k) R.measure := by
    intro k
    have hε := hεpos k
    have hdη_cont : Continuous (dη (1 / ((k : ℝ) + 1))) := by
      rw [show dη (1 / ((k : ℝ) + 1)) = deriv (η (1 / ((k : ℝ) + 1))) from
        funext fun s => ((hη_deriv _ s hε).deriv).symm]
      exact (hη_cd _ hε).continuous_deriv le_rfl
    have hc1 : Continuous fun x : Euclid P => (n : ℝ) * η (1 / ((k : ℝ) + 1)) (‖x - z‖ ^ 2) :=
      continuous_const.mul ((hη_cd _ hε).continuous.comp (by fun_prop))
    have hc2 : Continuous fun x : Euclid P => 2 * dη (1 / ((k : ℝ) + 1)) (‖x - z‖ ^ 2) :=
      continuous_const.mul (hdη_cont.comp (by fun_prop))
    rw [show G k = fun x => (n : ℝ) * η (1 / ((k : ℝ) + 1)) (‖x - z‖ ^ 2) +
        2 * dη (1 / ((k : ℝ) + 1)) (‖x - z‖ ^ 2) *
          ‖(approxTangentPlane n R.carrier x).starProjection (x - z)‖ ^ 2 from funext (hG k)]
    exact (hc1.aemeasurable.add (hc2.aemeasurable.mul hpv)).aestronglyMeasurable
  have hΨmeas : AEMeasurable Ψ R.measure := by
    rw [show Ψ = fun x =>
        ‖(x - z) - (approxTangentPlane n R.carrier x).starProjection (x - z)‖ ^ 2 /
          ‖x - z‖ ^ (n + 2) from funext hΨ]
    have h1 : AEMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection (x - z))
        R.measure :=
      ContinuousLinearMap.measurable_apply₂.comp_aemeasurable
        (hp.prodMk (measurable_id.sub_const z).aemeasurable)
    exact (((measurable_id.sub_const z).aemeasurable.sub h1).norm.pow_const 2).div
      ((measurable_id.sub_const z).norm.pow_const _).aemeasurable
  have hΨnn : ∀ x, 0 ≤ Ψ x := fun x => by
    rw [hΨ]
    positivity
  -- `Ψ ≤ σ⁻ⁿ` on the annulus, so `Ψ` is integrable there
  have hann : MeasurableSet (closedBall z ρ \ closedBall z σ) :=
    measurableSet_closedBall.diff measurableSet_closedBall
  have hΨint : IntegrableOn Ψ (closedBall z ρ \ closedBall z σ) R.measure := by
    refine Measure.integrableOn_of_bounded (M := (σ ^ n)⁻¹)
      ((measure_mono sdiff_subset).trans_lt (isCompact_closedBall z ρ).measure_lt_top).ne
      hΨmeas.aestronglyMeasurable (ae_restrict_of_forall_mem hann fun x hx => ?_)
    have hxσ' : σ < ‖x - z‖ := by simpa only [mem_closedBall, dist_eq_norm, not_le] using hx.2
    have hr : 0 < ‖x - z‖ := hσ.trans hxσ'
    rw [Real.norm_eq_abs, abs_of_nonneg (hΨnn x), hΨ, hpyth, div_le_iff₀ (by positivity),
      pow_add, ← mul_assoc, inv_mul_eq_div]
    have h1 : 1 ≤ ‖x - z‖ ^ n / σ ^ n := by
      rw [one_le_div (by positivity)]
      exact pow_le_pow_left₀ hσ.le hxσ'.le n
    nlinarith [sq_nonneg ‖(approxTangentPlane n R.carrier x).starProjection (x - z)‖,
      sq_nonneg ‖x - z‖]
  -- dominated convergence: `∫ L dμ = lim ∫ Gₖ dμ = 0`
  have hL0 : ∫ x, L x ∂R.measure = 0 := by
    have hconv := tendsto_integral_of_dominated_convergence _ hGmeas
      ((integrableOn_const (isCompact_closedBall z (ρ + 1)).measure_lt_top.ne).integrable_indicator
        measurableSet_closedBall)
      (fun k => Eventually.of_forall (hGbound k)) (Eventually.of_forall hlim)
    simp only [hG0] at hconv
    exact tendsto_nhds_unique hconv tendsto_const_nhds
  -- `∫ L dμ = n (σ⁻ⁿ μ(B_σ) - ρ⁻ⁿ μ(B_ρ) + ∫_{B_ρ \ B_σ} Ψ dμ)`
  have hint_σ : Integrable ((closedBall z σ).indicator fun _ : Euclid P => (σ ^ n)⁻¹) R.measure :=
    (integrableOn_const (isCompact_closedBall z σ).measure_lt_top.ne).integrable_indicator
      measurableSet_closedBall
  have hint_ρ : Integrable ((closedBall z ρ).indicator fun _ : Euclid P => (ρ ^ n)⁻¹) R.measure :=
    (integrableOn_const (isCompact_closedBall z ρ).measure_lt_top.ne).integrable_indicator
      measurableSet_closedBall
  have hLexp : ∫ x, L x ∂R.measure = (n : ℝ) * (R.measure.real (closedBall z σ) * (σ ^ n)⁻¹ -
      R.measure.real (closedBall z ρ) * (ρ ^ n)⁻¹ +
        ∫ x in closedBall z ρ \ closedBall z σ, Ψ x ∂R.measure) := by
    have hdiff : Integrable (fun x => (closedBall z σ).indicator (fun _ => (σ ^ n)⁻¹) x -
        (closedBall z ρ).indicator (fun _ => (ρ ^ n)⁻¹) x) R.measure := hint_σ.sub hint_ρ
    rw [show L = fun x => (n : ℝ) * ((closedBall z σ).indicator (fun _ => (σ ^ n)⁻¹) x -
        (closedBall z ρ).indicator (fun _ => (ρ ^ n)⁻¹) x +
          (closedBall z ρ \ closedBall z σ).indicator Ψ x) from funext hL,
      integral_const_mul, integral_add hdiff (hΨint.integrable_indicator hann),
      integral_sub hint_σ hint_ρ, integral_indicator_const _ measurableSet_closedBall,
      integral_indicator_const _ measurableSet_closedBall, integral_indicator hann, smul_eq_mul,
      smul_eq_mul]
  -- the real form of Simon 4.3.6
  have hreal : R.measure.real (closedBall z σ) * (σ ^ n)⁻¹ -
      R.measure.real (closedBall z ρ) * (ρ ^ n)⁻¹ +
        ∫ x in closedBall z ρ \ closedBall z σ, Ψ x ∂R.measure = 0 := by
    rcases Nat.eq_zero_or_pos n with hn | hn
    · -- `n = 0`: a.e. `TₓM = 0`, so `Ψ = 1` on the annulus
      have hΨ1 : ∀ᵐ x ∂(R.measure.restrict (closedBall z ρ \ closedBall z σ)), Ψ x = 1 := by
        rw [ae_restrict_iff' hann]
        filter_upwards [hrank] with x hx hxA
        have hxσ' : σ < ‖x - z‖ := by
          simpa only [mem_closedBall, dist_eq_norm, not_le] using hxA.2
        have hbot : approxTangentPlane n R.carrier x = ⊥ :=
          Submodule.finrank_eq_zero.mp (hx.trans hn)
        rw [hΨ, hbot, Submodule.starProjection_bot, zero_apply, sub_zero, hn, zero_add,
          div_self (pow_pos (hσ.trans hxσ') 2).ne']
      have h1 : (σ ^ n)⁻¹ = 1 := by rw [hn, pow_zero, inv_one]
      have h2 : (ρ ^ n)⁻¹ = 1 := by rw [hn, pow_zero, inv_one]
      rw [integral_congr_ae hΨ1, setIntegral_const, smul_eq_mul, mul_one,
        measureReal_sdiff (closedBall_subset_closedBall hσρ) measurableSet_closedBall
          (isCompact_closedBall z ρ).measure_lt_top.ne, h1, h2]
      ring
    · have h := hLexp ▸ hL0
      exact (mul_eq_zero.mp h).resolve_left (by exact_mod_cast hn.ne')
  -- back to `[0, ∞]`
  have hlint : ∫⁻ x in closedBall z ρ \ closedBall z σ, ENNReal.ofReal
      (‖(x - z) - (approxTangentPlane n R.carrier x).starProjection (x - z)‖ ^ 2 /
        ‖x - z‖ ^ (n + 2)) ∂R.measure =
      ENNReal.ofReal (∫ x in closedBall z ρ \ closedBall z σ, Ψ x ∂R.measure) := by
    rw [ofReal_integral_eq_lintegral_ofReal hΨint (Eventually.of_forall hΨnn)]
    simp only [hΨ]
  have hball : ∀ t : ℝ, 0 < t → R.measure (closedBall z t) / ENNReal.ofReal (t ^ n) =
      ENNReal.ofReal (R.measure.real (closedBall z t) * (t ^ n)⁻¹) := by
    intro t ht
    rw [← div_eq_mul_inv, ENNReal.ofReal_div_of_pos (pow_pos ht n), measureReal_def,
      ENNReal.ofReal_toReal (isCompact_closedBall z t).measure_lt_top.ne]
  rw [hlint, hball σ hσ, hball ρ hρ, ← ENNReal.ofReal_add
    (mul_nonneg measureReal_nonneg (inv_nonneg.mpr (pow_nonneg hσ.le n)))
    (integral_nonneg hΨnn)]
  congr 1
  linarith
/-- **Closed-ball masses at points of the spine** (step 1 of the parent proof: the scaling
`(ωₙρⁿ)⁻¹μ_C(B_ρ(0)) = Θⁿ(T, x)` for each `ρ > 0` in Simon's proof of 7.3.1, moved to centres `z`
in the subspace `L` of Lemma 7.3.5).  Let `μ` be invariant under translations by vectors of `L`
and satisfy `μ(λA) = λⁿμ(A)` for `λ > 0`, both on Borel sets.  Then `μ(B̄_ρ(z)) = ρⁿμ(B̄_1(z))`
for `z ∈ L` and `ρ > 0`.  Translation by `-z ∈ L` maps `B̄_r(z)` onto `B̄_r(0)`, and
`B̄_ρ(0) = ρB̄_1(0)`. -/
theorem Submission.dimred_cs_st_closedBall_measure_scaling : ∀ (P n : ℕ) (μ : Measure (Euclid P)) (L : Submodule ℝ (Euclid P)), (∀ y ∈ L, ∀ A : Set (Euclid P), MeasurableSet A → μ ((fun x => y + x) ⁻¹' A) = μ A) → (∀ lam : ℝ, 0 < lam → ∀ A : Set (Euclid P), MeasurableSet A → μ ((fun x => lam • x) '' A) = ENNReal.ofReal (lam ^ n) * μ A) → ∀ z ∈ L, ∀ ρ : ℝ, 0 < ρ → μ (closedBall z ρ) = ENNReal.ofReal (ρ ^ n) * μ (closedBall z 1) := by
  intro P n μ L htrans hhom z hz ρ hρ
  -- translation by `-z ∈ L`: `B̄_r(z) = (x ↦ -z + x)⁻¹' B̄_r(0)`
  have htr : ∀ r : ℝ, μ (closedBall z r) = μ (closedBall 0 r) := by
    intro r
    rw [← htrans (-z) (L.neg_mem hz) (closedBall 0 r) measurableSet_closedBall]
    congr 1
    ext x
    simp only [mem_closedBall, mem_preimage, dist_eq_norm, sub_zero, neg_add_eq_sub]
  -- dilation by `ρ`: `B̄_ρ(0) = (x ↦ ρ • x) '' B̄_1(0)`
  have hsc : (fun x => ρ • x) '' closedBall (0 : Euclid P) 1 = closedBall 0 ρ := by
    rw [Set.image_smul, smul_unitClosedBall_of_nonneg hρ.le]
  rw [htr ρ, htr 1, ← hsc, hhom ρ hρ _ measurableSet_closedBall]

/-- **Simon, proof of 7.3.1 (chapter-07.txt lines 352–360), at a centre `z`.**  Let
`R = (M, θ, ξ)` be an integer multiplicity triple in `ℝᴾ` with `V = v(M, θ)` stationary:
`δV(X) = 0` for every `X ∈ C¹_c(ℝᴾ; ℝᴾ)`.  If `μ_V(B_ρ(z)) = ρⁿμ_V(B_1(z))` for every `ρ > 0`
(closed balls, `μ_V = θHⁿ⌞M`), then `x − z ∈ TₓM`, i.e. `p_x(x − z) = x − z`, for `μ_V`-a.e. `x`.
The ratio `ρ⁻ⁿμ_V(B_ρ(z)) = μ_V(B_1(z))` is constant and finite (`θ` is locally integrable), so
the monotonicity identity 4.3.6 (`dtc_cone_monotonicity_identity`) gives
`∫_{B_ρ(z) \ B_σ(z)} |(x − z) − p_x(x − z)|² / |x − z|ⁿ⁺² dμ_V = 0` for `0 < σ ≤ ρ`.  The
integrand is `μ_V`-a.e.-measurable (`imrep_univ_tangent_starProjection_aemeasurable`), so it
vanishes a.e. on each annulus, where `|x − z| > σ > 0`; the annuli
`B_{k+1}(z) \ B_{1/(k+1)}(z)` exhaust `ℝᴾ \ {z}`, and `p_z(0) = 0`. -/
theorem Submission.dimred_cs_st_tangent_sub_of_ball_ratio : ∀ (P n : ℕ) (R : IMRep (univ : Set (Euclid P)) n) (z : Euclid P), (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → R.firstVariation X = 0) → (∀ ρ : ℝ, 0 < ρ → R.measure (closedBall z ρ) = ENNReal.ofReal (ρ ^ n) * R.measure (closedBall z 1)) → ∀ᵐ x ∂R.measure, (approxTangentPlane n R.carrier x).starProjection (x - z) = x - z := by
  intro P n R z hstat hball
  -- Step 1: `a := μ(B̄_1(z)) < ∞`
  have ha : R.measure (closedBall z 1) ≠ ∞ := by
    have h := R.locallyIntegrable_mult (closedBall z 1) (isCompact_closedBall z 1) (subset_univ _)
    rwa [IMRep.measure, withDensity_apply _ measurableSet_closedBall,
      Measure.restrict_restrict measurableSet_closedBall, Set.inter_comm]
  -- Step 2: the normalized ratio is constantly `a`
  have hratio : ∀ ρ : ℝ, 0 < ρ →
      R.measure (closedBall z ρ) / ENNReal.ofReal (ρ ^ n) = R.measure (closedBall z 1) := by
    intro ρ hρ
    rw [hball ρ hρ, mul_comm, ENNReal.mul_div_cancel_right
      (ENNReal.ofReal_pos.2 (pow_pos hρ n)).ne' ENNReal.ofReal_ne_top]
  -- Step 3: measurability of the defect integrand
  have hp : AEMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection (x - z))
      R.measure :=
    (continuous_fst.clm_apply continuous_snd).aemeasurable2
      (Submission.imrep_univ_tangent_starProjection_aemeasurable P n R)
      (aemeasurable_id.sub_const z)
  have hf : AEMeasurable (fun x => ENNReal.ofReal
      (‖(x - z) - (approxTangentPlane n R.carrier x).starProjection (x - z)‖ ^ 2 /
        ‖x - z‖ ^ (n + 2))) R.measure :=
    ENNReal.measurable_ofReal.comp_aemeasurable
      ((((aemeasurable_id.sub_const z).sub hp).norm.pow_const 2).div
        ((measurable_id.sub_const z).norm.pow_const (n + 2)).aemeasurable)
  -- Step 4: the defect over each annulus vanishes
  have hann : ∀ σ ρ : ℝ, 0 < σ → σ ≤ ρ → ∀ᵐ x ∂R.measure,
      x ∈ closedBall z ρ \ closedBall z σ →
      (approxTangentPlane n R.carrier x).starProjection (x - z) = x - z := by
    intro σ ρ hσ hσρ
    have h := Submission.dtc_cone_monotonicity_identity P n R hstat z σ ρ hσ hσρ
    rw [hratio σ hσ, hratio ρ (hσ.trans_le hσρ)] at h
    have hD := (lintegral_eq_zero_iff' (hf.mono_measure Measure.restrict_le_self)).1
      ((ENNReal.add_right_inj ha).1 (h.trans (add_zero _).symm))
    have hA : MeasurableSet (closedBall z ρ \ closedBall z σ) :=
      measurableSet_closedBall.diff measurableSet_closedBall
    filter_upwards [(ae_restrict_iff' hA).1 hD] with x hx hxA
    have hxσ : σ < ‖x - z‖ := by
      have h2 := hxA.2
      rw [mem_closedBall, dist_eq_norm, not_le] at h2
      exact h2
    have h0 : ‖(x - z) - (approxTangentPlane n R.carrier x).starProjection (x - z)‖ ^ 2 /
        ‖x - z‖ ^ (n + 2) ≤ 0 :=
      ENNReal.ofReal_eq_zero.1 (hx hxA)
    rw [div_le_iff₀ (pow_pos (hσ.trans hxσ) _), zero_mul] at h0
    have hnorm := (pow_eq_zero_iff two_ne_zero).1 (le_antisymm h0 (sq_nonneg _))
    exact (sub_eq_zero.1 (norm_eq_zero.1 hnorm)).symm
  -- Step 5: the annuli `B̄_{k+1}(z) \ B̄_{1/(k+1)}(z)` exhaust `ℝᴾ \ {z}`
  have hk1 : ∀ k : ℕ, (1 : ℝ) ≤ (k : ℝ) + 1 := fun k => le_add_of_nonneg_left k.cast_nonneg
  have hall := ae_all_iff.2 fun k : ℕ => hann (1 / ((k : ℝ) + 1)) ((k : ℝ) + 1) (by positivity)
    (((div_le_one (by positivity)).2 (hk1 k)).trans (hk1 k))
  filter_upwards [hall] with x hx
  rcases eq_or_ne x z with rfl | hxz
  · simp
  have hxpos : 0 < ‖x - z‖ := norm_pos_iff.2 (sub_ne_zero.2 hxz)
  obtain ⟨k, hk⟩ := exists_nat_gt (max ‖x - z‖ ‖x - z‖⁻¹)
  have hk0 : (0 : ℝ) < (k : ℝ) + 1 := by positivity
  refine hx k (Set.mem_sdiff_of_mem ?_ ?_)
  · rw [mem_closedBall, dist_eq_norm]
    linarith [le_max_left ‖x - z‖ ‖x - z‖⁻¹]
  · rw [mem_closedBall, dist_eq_norm, not_le, one_div_lt hk0 hxpos, one_div]
    linarith [le_max_right ‖x - z‖ ‖x - z‖⁻¹]

/-- **Spine tangency** (a step of Simon 7.3.5, whose proof is left to the reader, chapter-07.txt
lines 407–418; argued as in the proof of 7.3.1, lines 355–360).  Let `R = (M, θ, ξ)` be an integer
multiplicity triple in `ℝᴾ` with `V = v(M, θ)` stationary and `L ⊆ ℝᴾ` a subspace such that
`μ_V = θHⁿ⌞M` is invariant under translation by every `y ∈ L` and `μ_V(λA) = λⁿμ_V(A)` for
`λ > 0`.  Then `x ∈ TₓM` and `L ⊆ TₓM` for `μ_V`-a.e. `x`.  For `z ∈ L`,
`μ_V(B̄_ρ(z)) = ρⁿμ_V(B̄_1(z))` (`dimred_cs_st_closedBall_measure_scaling`), so the monotonicity
identity (Ch. 4, 3.6) forces `x − z ∈ TₓM` for `μ_V`-a.e. `x`
(`dimred_cs_st_tangent_sub_of_ball_ratio`).  Apply this to `z = 0` and to every `z` in a finite
set `S` spanning `L` (in place of a countable dense subset of `L`): for `μ_V`-a.e. `x`, `x ∈ TₓM`
and `z = x − (x − z) ∈ TₓM` for `z ∈ S`, so the subspace `TₓM` contains `span S = L`. -/
theorem Submission.dimred_cs_spine_tangent_of_invariant_measure : ∀ (P n : ℕ) (R : IMRep (univ : Set (Euclid P)) n) (L : Submodule ℝ (Euclid P)), 0 < n → (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → R.firstVariation X = 0) → (∀ y ∈ L, ∀ A : Set (Euclid P), MeasurableSet A → R.measure ((fun x => y + x) ⁻¹' A) = R.measure A) → (∀ lam : ℝ, 0 < lam → ∀ A : Set (Euclid P), MeasurableSet A → R.measure ((fun x => lam • x) '' A) = ENNReal.ofReal (lam ^ n) * R.measure A) → ∀ᵐ x ∂R.measure, (approxTangentPlane n R.carrier x).starProjection x = x ∧ ∀ v ∈ L, (approxTangentPlane n R.carrier x).starProjection v = v := by
  intro P n R L _hn hstat htrans hhom
  -- for each `z ∈ L` the ball ratios at `z` are constant, so `x - z ∈ TₓM` for `μ_V`-a.e. `x`
  have htan : ∀ z ∈ L, ∀ᵐ x ∂R.measure,
      (approxTangentPlane n R.carrier x).starProjection (x - z) = x - z := fun z hz =>
    Submission.dimred_cs_st_tangent_sub_of_ball_ratio P n R z hstat
      (Submission.dimred_cs_st_closedBall_measure_scaling P n R.measure L htrans hhom z hz)
  -- a finite set `S ⊆ L` spanning `L`
  obtain ⟨S, hS⟩ : L.FG := IsNoetherian.noetherian L
  have hSL : ∀ z ∈ S, z ∈ L := fun z hz => hS ▸ Submodule.subset_span (Finset.mem_coe.2 hz)
  filter_upwards [htan 0 L.zero_mem, (eventually_all_finset S).2 fun z hz => htan z (hSL z hz)]
    with x hx0 hxS
  rw [sub_zero] at hx0
  have hxT : x ∈ approxTangentPlane n R.carrier x := Submodule.starProjection_eq_self_iff.1 hx0
  -- `z = x - (x - z) ∈ TₓM` for `z ∈ S`, so `L = span S ≤ TₓM`
  have hLT : L ≤ approxTangentPlane n R.carrier x := by
    rw [← hS, Submodule.span_le]
    intro z hz
    have h := (approxTangentPlane n R.carrier x).sub_mem hxT
      (Submodule.starProjection_eq_self_iff.1 (hxS z (Finset.mem_coe.1 hz)))
    rwa [sub_sub_cancel] at h
  exact ⟨hx0, fun v hv => Submodule.starProjection_eq_self_iff.2 (hLT hv)⟩
/-- `x ∧ ξ(x) = 0` a.e. when `x` lies in its approximate tangent plane a.e. (Simon 7.3.1, proof):
`ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ` for an orthonormal basis `τ` of `TₓM`, and `y ↦ β(y, τ₁, …, τₙ)` is linear
and vanishes on each `τᵢ` (repeated entry), hence on `TₓM ∋ x`. -/
theorem Submission.dtc_cone_wedge_vanishes : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), (∀ᵐ x ∂R.measure, (approxTangentPlane n R.carrier x).starProjection x = x) → ∀ᵐ x ∂R.measure, ∀ β : Covector (Euclid P) (n + 1), R.orient x (ContinuousAlternatingMap.curryLeft β x) = 0 := by
  intro P n U R hproj
  -- `μ = θ Hⁿ⌞M ≪ Hⁿ⌞M`, so `ξ` orients an approximate tangent plane `μ`-a.e.
  filter_upwards [hproj, (withDensity_absolutelyContinuous _ _).ae_le R.orients]
    with x hx hor β
  obtain ⟨Q, hQ, τ, -, hspan, hξ⟩ := hor
  -- `TₓM = Q` by uniqueness of approximate tangent planes, so `x ∈ Q`
  have hT : approxTangentPlane n R.carrier x = Q := by
    have h : ∃ Q, HasApproximateTangentSpaceAt n R.carrier x Q := ⟨Q, hQ⟩
    rw [approxTangentPlane, dite_eq_left h]
    exact h.choose_spec.unique hQ
  have hxQ : x ∈ Q := hT ▸ Submodule.starProjection_eq_self_iff.mp hx
  -- `y ↦ β(y, τ)` vanishes on `Q = span(range τ)`
  have hβ : ∀ y ∈ Q, ContinuousAlternatingMap.curryLeft β y τ = 0 := by
    intro y hy
    rw [← hspan] at hy
    induction hy using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨b, rfl⟩ := hy
      rw [ContinuousAlternatingMap.curryLeft_apply_apply]
      exact β.map_eq_zero_of_eq _ (i := 0) (j := b.succ) (by simp) (Fin.succ_ne_zero b).symm
    | zero => simp
    | add y z _ _ hy hz =>
      rw [map_add, ContinuousAlternatingMap.add_apply, hy, hz, add_zero]
    | smul a y _ hy =>
      rw [map_smul, ContinuousAlternatingMap.smul_apply, hy, smul_zero]
  rcases hξ with hξ | hξ
  · rw [hξ, hβ x hxQ]
  · rw [hξ, hβ x hxQ, neg_zero]
/-- **Cone criterion** (Simon 7.3.1(2), via 6.2.23).  If `C ∈ 𝒟ₙ(ℝᴾ)` satisfies `C(ω') = C(ω)`
whenever `λ > 0` and the test forms `ω, ω'` satisfy `ω'(y) = λ⁻ⁿ ω(λ⁻¹y)`, then `C` is a cone.
As `η_{0,λ}(ℝᴾ) = ℝᴾ`, `η_{0,λ#}C(ω) = C(η_{0,λ}^# ω)`, and by multilinearity
`η_{0,λ}^# ω (y) = ω(λ⁻¹y) ∘ (λ⁻¹ id) = λ⁻ⁿ ω(λ⁻¹y)`. -/
theorem Submission.dtc_cwv_isConeCurrent_of_pullback_invariant : ∀ (P n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n), (∀ lam : ℝ, 0 < lam → ∀ ω ω' : TestFormOn (univ : Set (Euclid P)) n, (∀ y, (ω' : DifferentialForm (Euclid P) n) y = (lam⁻¹ ^ n) • (ω : DifferentialForm (Euclid P) n) (lam⁻¹ • y)) → C ω' = C ω) → IsConeCurrent C := by
  intro P n C hC lam hlam ω
  -- Step 1: `η_{0,λ}(ℝᴾ) = ℝᴾ`, so `currentEval` takes its test-form branch.
  have hV : dilation (0 : Euclid P) lam '' univ = univ := by
    refine eq_univ_of_forall fun x => ⟨lam • x, mem_univ _, ?_⟩
    simp [dilation, dilationCLM, smul_smul, mul_inv_cancel₀ hlam.ne']
  have h : IsTestForm (ω : DifferentialForm (Euclid P) n) ∧
      tsupport (ω : DifferentialForm (Euclid P) n) ⊆ dilation (0 : Euclid P) lam '' univ :=
    ⟨ω.property.1, by rw [hV]; exact subset_univ _⟩
  rw [currentEval, dite_eq_left h]
  -- Steps 2–3: unfolding `blowUp`, `η_{0,λ#}C(ω) = C(ω'')` for the affine pullback `ω''` of `ω`,
  -- and `C(ω'') = C(ω)` by the hypothesis.
  refine hC lam hlam ω _ fun y => ?_
  -- Step 4: `ω''(y) = ω(λ⁻¹y) ∘ (λ⁻¹ id) = λ⁻ⁿ ω(λ⁻¹y)` by multilinearity.
  ext v
  change (ω : DifferentialForm (Euclid P) n) (-(lam⁻¹ • (0 : Euclid P)) + dilationCLM P lam y)
      (fun i => dilationCLM P lam (v i)) = _
  simp only [dilationCLM, smul_zero, neg_zero, zero_add, smul_apply,
    ContinuousLinearMap.id_apply, ContinuousAlternatingMap.smul_apply, smul_eq_mul]
  rw [ContinuousAlternatingMap.map_smul_univ, Finset.prod_const, Finset.card_univ,
    Fintype.card_fin, smul_eq_mul]
/-- **Contraction with the Euler field preserves test forms** (Simon Ch. 6, 2.25–2.26 and 2.33,
as used in the proof of 7.3.1).  If `β` is a test `(m+1)`-form, then so is
`ι_X β : z ↦ β(z).curryLeft z` for `X(z) = z`: it is the smooth family of continuous linear maps
`z ↦ curryLeftLI (β z)` applied to the smooth vector `z`, and it vanishes wherever `β` does, so
its support lies in the compact `tsupport β`. -/
theorem Submission.dtc_cwv_euler_contraction_isTestForm : ∀ (P m : ℕ) (β : DifferentialForm (Euclid P) (m + 1)), IsTestForm β → IsTestForm (fun z => ContinuousAlternatingMap.curryLeft (β z) z) := by
  intro P m β hβ
  obtain ⟨hs, hc⟩ := hβ
  refine ⟨?_, ?_⟩
  · -- `z ↦ (curryLeftLI (β z)) z` is a smooth family of continuous linear maps applied to `z`
    change ContDiff ℝ (⊤ : ℕ∞) (fun z => (ContinuousAlternatingMap.curryLeftLI (𝕜 := ℝ)
      (E := Euclid P) (F := ℝ) (n := m)).toContinuousLinearMap (β z) z)
    exact (((ContinuousAlternatingMap.curryLeftLI (𝕜 := ℝ) (E := Euclid P) (F := ℝ)
      (n := m)).toContinuousLinearMap.contDiff).comp hs).clm_apply contDiff_id
  · -- `β z = 0` forces `β(z).curryLeft z = 0`, so the support stays inside `supp β`
    refine hc.mono ?_
    intro z hz
    simp only [mem_support] at hz ⊢
    intro h0
    apply hz
    rw [h0]
    rfl

/-- Differentiation under the integral sign for the dilations `y ↦ s y` (steps 0(a), 0(b), 2 and 3
of the proof of Simon Ch. 6, Lemma 2.33, with `c(s) = s`): for `t > 0`, `s ↦ τ(M, θ, ξ)(sⁿ ω(s ·))`
has derivative `τ(M, θ, ξ)(n tⁿ⁻¹ ω(t ·) + tⁿ Dω(t ·)[·])` at `t`.  For `s ∈ (t/2, 2t)` the
integrands vanish off `B = B̄_{2r/t}(0)`, where `spt ω ⊆ B̄_r(0)`, and are dominated by `K θ 1_B`,
`K` bounding the continuous integrand on `[t/2, 2t] × B` (as `‖ξ‖ ≤ 1` a.e.); `θ 1_B` is
integrable since `θ` is locally `Hⁿ`-integrable. -/
theorem Submission.dtc_cwv_scaled_action_hasDerivAt : ∀ (P n : ℕ) (R : IMRep (univ : Set (Euclid P)) n) (ω : TestFormOn (univ : Set (Euclid P)) n) (t : ℝ), 0 < t → HasDerivAt (fun s : ℝ => R.action (fun y => (s ^ n) • (ω : DifferentialForm (Euclid P) n) (s • y))) (R.action (fun y => ((n : ℝ) * t ^ (n - 1)) • (ω : DifferentialForm (Euclid P) n) (t • y) + (t ^ n) • fderiv ℝ (ω : DifferentialForm (Euclid P) n) (t • y) y)) t := by
  intro P n R ω t ht
  have hws : ContDiff ℝ (⊤ : ℕ∞) (ω : DifferentialForm (Euclid P) n) := ω.property.1.1
  have hwc : HasCompactSupport (ω : DifferentialForm (Euclid P) n) := ω.property.1.2
  set w : DifferentialForm (Euclid P) n := (ω : DifferentialForm (Euclid P) n) with hw_def
  -- Step 1: ‖ξ(x)‖ ≤ 1 for Hⁿ⌞M-a.e. x (sibling `orientation_norm`).
  have hξ : ∀ᵐ x ∂(μHE[n].restrict R.carrier), ‖R.orient x‖ ≤ 1 := by
    filter_upwards [R.orients] with x hx
    obtain ⟨Q, -, hQ⟩ := hx
    exact Submission.unit_orientation_norm_le_one P n Q _ hQ
  -- Step 2: a support radius, a bound for ω; ω and Dω vanish off spt ω.
  have hwcont : Continuous w := hws.continuous
  have hDw : Continuous (fderiv ℝ w) := hws.continuous_fderiv (by simp)
  obtain ⟨K0, hK0⟩ := hwcont.bounded_above_of_compact_support hwc
  obtain ⟨r, hr⟩ : ∃ r, tsupport w ⊆ closedBall (0 : Euclid P) r :=
    hwc.isCompact.isBounded.subset_closedBall 0
  have hvan : ∀ z, z ∉ tsupport w → w z = 0 ∧ fderiv ℝ w z = 0 := fun z hz =>
    ⟨image_eq_zero_of_notMem_tsupport hz,
      image_eq_zero_of_notMem_tsupport (fun h => hz (tsupport_fderiv_subset ℝ h))⟩
  -- Step 5: measurability of the integrands (Φ jointly continuous).
  have hθm : Measurable fun x => (R.mult x : ℝ) := measurable_from_nat.comp R.measurable_mult
  have happly : Continuous fun p : MultiVector P n × Covector (Euclid P) n => p.1 p.2 :=
    continuous_fst.clm_apply continuous_snd
  have hmeas : ∀ φ : Euclid P → Covector (Euclid P) n, Continuous φ →
      AEStronglyMeasurable (fun y => (R.mult y : ℝ) * R.orient y (φ y)) (μHE[n].restrict R.carrier) :=
    fun φ hφ => hθm.aestronglyMeasurable.mul
      (happly.comp_aestronglyMeasurable (R.aestronglyMeasurable_orient.prodMk hφ.aestronglyMeasurable))
  have hcF : ∀ s : ℝ, Continuous (fun y => (s ^ n) • w (s • y)) := by
    intro s
    have h1 : Continuous (fun y : Euclid P => w (s • y)) := hwcont.comp (continuous_const_smul s)
    exact h1.const_smul (s ^ n)
  have hΦ : Continuous (fun p : ℝ × Euclid P => ((n : ℝ) * p.1 ^ (n - 1)) • w (p.1 • p.2) +
      (p.1 ^ n) • fderiv ℝ w (p.1 • p.2) p.2) := by
    have hsy : Continuous (fun p : ℝ × Euclid P => p.1 • p.2) := continuous_fst.smul continuous_snd
    exact (((continuous_const.mul (continuous_fst.pow _))).smul (hwcont.comp hsy)).add
      ((continuous_fst.pow _).smul ((hDw.comp hsy).clm_apply continuous_snd))
  have hcF' : ∀ s : ℝ, Continuous (fun y => ((n : ℝ) * s ^ (n - 1)) • w (s • y) +
      (s ^ n) • fderiv ℝ w (s • y) y) := fun s =>
    hΦ.comp (continuous_const.prodMk continuous_id)
  -- Steps 6–8: localization in B = B̄_ρ(0), the bound K for Φ on [t/2, 2t] × B, integrability.
  set ρ : ℝ := 2 * r / t with hρ
  set B : Set (Euclid P) := closedBall (0 : Euclid P) ρ with hB
  have hBm : MeasurableSet B := measurableSet_closedBall
  obtain ⟨K, hK⟩ := (isCompact_Icc (a := t / 2) (b := 2 * t)).prod (isCompact_closedBall (0 : Euclid P) ρ)
    |>.exists_bound_of_continuousOn hΦ.continuousOn
  have hθB : IntegrableOn (fun x => (R.mult x : ℝ)) B (μHE[n].restrict R.carrier) := by
    refine ⟨hθm.aestronglyMeasurable, ?_⟩
    rw [hasFiniteIntegral_iff_enorm, Measure.restrict_restrict hBm, inter_comm]
    simpa only [Real.enorm_natCast] using
      (R.locallyIntegrable_mult B (isCompact_closedBall 0 ρ) (subset_univ _)).lt_top
  -- membership: if s • y ∈ spt ω with s > t/2 then y ∈ B
  have hmemB : ∀ s : ℝ, t / 2 < s → ∀ y : Euclid P, s • y ∈ tsupport w → y ∈ B := by
    intro s hs y hy
    have h1 : ‖s • y‖ ≤ r := by simpa using hr hy
    have hs0 : 0 < s := by linarith
    rw [norm_smul, Real.norm_of_nonneg hs0.le] at h1
    simp only [hB, mem_closedBall, dist_zero_right, hρ]
    rw [le_div_iff₀ ht]
    nlinarith [norm_nonneg y]
  -- Steps 7–9: hypotheses of the dominated differentiation theorem (step 4 is `h_diff`).
  have hs : Ioo (t / 2) (2 * t) ∈ 𝓝 t := Ioo_mem_nhds (by linarith) (by linarith)
  have hF_meas : ∀ᶠ s in 𝓝 t, AEStronglyMeasurable
      (fun y => (R.mult y : ℝ) * R.orient y ((s ^ n) • w (s • y))) (μHE[n].restrict R.carrier) :=
    Eventually.of_forall fun s => hmeas _ (hcF s)
  have hF'_meas : AEStronglyMeasurable (fun y => (R.mult y : ℝ) * R.orient y
      (((n : ℝ) * t ^ (n - 1)) • w (t • y) + (t ^ n) • fderiv ℝ w (t • y) y))
      (μHE[n].restrict R.carrier) := hmeas _ (hcF' t)
  have hF_int : Integrable (fun y => (R.mult y : ℝ) * R.orient y ((t ^ n) • w (t • y)))
      (μHE[n].restrict R.carrier) := by
    refine ((hθB.integrable_indicator hBm).const_mul (t ^ n * K0)).mono' (hmeas _ (hcF t)) ?_
    filter_upwards [hξ] with y hy
    by_cases hty : t • y ∈ tsupport w
    · have hyB := hmemB t (by linarith) y hty
      rw [indicator_of_mem hyB, norm_mul, Real.norm_natCast]
      calc (R.mult y : ℝ) * ‖R.orient y ((t ^ n) • w (t • y))‖
          ≤ (R.mult y : ℝ) * (‖R.orient y‖ * ‖(t ^ n) • w (t • y)‖) := by
            gcongr; exact (R.orient y).le_opNorm _
        _ ≤ (R.mult y : ℝ) * (1 * (t ^ n * K0)) := by
            gcongr
            rw [norm_smul, Real.norm_of_nonneg (by positivity)]
            gcongr
            exact hK0 _
        _ = t ^ n * K0 * (R.mult y : ℝ) := by ring
    · rw [(hvan _ hty).1, smul_zero, map_zero, mul_zero, norm_zero]
      have hK0n : 0 ≤ K0 := le_trans (norm_nonneg _) (hK0 0)
      by_cases hyB : y ∈ B
      · rw [indicator_of_mem hyB]; positivity
      · rw [indicator_of_notMem hyB, mul_zero]
  have h_bound : ∀ᵐ y ∂(μHE[n].restrict R.carrier), ∀ s ∈ Ioo (t / 2) (2 * t),
      ‖(R.mult y : ℝ) * R.orient y (((n : ℝ) * s ^ (n - 1)) • w (s • y) +
        (s ^ n) • fderiv ℝ w (s • y) y)‖ ≤ K * B.indicator (fun x => (R.mult x : ℝ)) y := by
    filter_upwards [hξ] with y hy s hs
    obtain ⟨hs1, hs2⟩ := hs
    by_cases hsy : s • y ∈ tsupport w
    · have hyB := hmemB s hs1 y hsy
      rw [indicator_of_mem hyB, norm_mul, Real.norm_natCast]
      have hnorm := hK (s, y) ⟨⟨hs1.le, hs2.le⟩, hyB⟩
      calc (R.mult y : ℝ) * ‖R.orient y (((n : ℝ) * s ^ (n - 1)) • w (s • y) +
            (s ^ n) • fderiv ℝ w (s • y) y)‖
          ≤ (R.mult y : ℝ) * (‖R.orient y‖ * ‖((n : ℝ) * s ^ (n - 1)) • w (s • y) +
            (s ^ n) • fderiv ℝ w (s • y) y‖) := by
            gcongr; exact (R.orient y).le_opNorm _
        _ ≤ (R.mult y : ℝ) * (1 * K) := by gcongr
        _ = K * (R.mult y : ℝ) := by ring
    · rw [(hvan _ hsy).1, (hvan _ hsy).2, smul_zero, zero_apply, smul_zero,
        add_zero, map_zero, mul_zero, norm_zero]
      by_cases hyB : y ∈ B
      · rw [indicator_of_mem hyB]
        have hKn : 0 ≤ K := le_trans (norm_nonneg _)
          (hK (t, y) ⟨⟨by linarith, by linarith⟩, hyB⟩)
        positivity
      · rw [indicator_of_notMem hyB, mul_zero]
  have h_diff : ∀ᵐ y ∂(μHE[n].restrict R.carrier), ∀ s ∈ Ioo (t / 2) (2 * t),
      HasDerivAt (fun s => (R.mult y : ℝ) * R.orient y ((s ^ n) • w (s • y)))
        ((R.mult y : ℝ) * R.orient y (((n : ℝ) * s ^ (n - 1)) • w (s • y) +
          (s ^ n) • fderiv ℝ w (s • y) y)) s := by
    refine Eventually.of_forall fun y s _ => ?_
    have h1 : HasDerivAt (fun s : ℝ => s • y) y s := by
      simpa using (hasDerivAt_id s).smul_const y
    have h2 : HasDerivAt (fun s : ℝ => w (s • y)) (fderiv ℝ w (s • y) y) s :=
      ((hws.differentiable (by simp)).differentiableAt (x := s • y)).hasFDerivAt.comp_hasDerivAt s h1
    have h3 : HasDerivAt (fun s : ℝ => (s ^ n) • w (s • y))
        ((s ^ n) • fderiv ℝ w (s • y) y + ((n : ℝ) * s ^ (n - 1)) • w (s • y)) s :=
      (hasDerivAt_pow n s).smul h2
    have h4 := ((R.orient y).hasFDerivAt.comp_hasDerivAt s h3).const_mul (R.mult y : ℝ)
    rw [add_comm] at h4
    exact h4
  have key := hasDerivAt_integral_of_dominated_loc_of_deriv_le hs hF_meas hF_int hF'_meas h_bound
    ((hθB.integrable_indicator hBm).const_mul K) h_diff
  exact key.2
/-- **`∂C = 0` and `x ∧ C⃗ = 0` kill Euler–Lie derivatives** (the homotopy term in the proof of
Simon Ch. 6, Lemma 2.33, as applied in 7.3.1).  Let `C = τ(M, θ, ξ) ∈ 𝒟ₙ(ℝᴾ)`, `n ≥ 1`, with
`∂C = 0` and `ξ(x)(ι_x α) = 0` for `μ_C`-a.e. `x` and every `(n+1)`-covector `α`.  Then
`C(L_X β) = 0` for the Euler field `X(y) = y`, where `L_X β(y) = n β(y) + Dβ(y)[y]`.  By Cartan's
formula `L_X β = d(ι_X β) + ι_X dβ` (`dtc_cone_euler_cartan`), with `ι_X β` and `ι_X dβ` test forms
(`dtc_cwv_euler_contraction_isTestForm`): `C(d ι_X β) = ∂C(ι_X β) = 0`, and
`C(ι_X dβ) = ∫_M θ ξ(ι_y dβ(y)) dHⁿ = 0` since `θ > 0` on `M`. -/
theorem Submission.dtc_cwv_euler_lie_annihilated : ∀ (P n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n), 0 < n → R.Represents C → BoundaryVanishes C → (∀ᵐ x ∂R.measure, ∀ β : Covector (Euclid P) (n + 1), R.orient x (ContinuousAlternatingMap.curryLeft β x) = 0) → ∀ β γ : TestFormOn (univ : Set (Euclid P)) n, (∀ y, (γ : DifferentialForm (Euclid P) n) y = (n : ℝ) • (β : DifferentialForm (Euclid P) n) y + fderiv ℝ (β : DifferentialForm (Euclid P) n) y y) → C γ = 0 := by
  intro P n C R hn hR hb hw β γ hγ
  -- write `n = m + 1`
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  -- `ψ = ι_X β` is a test `m`-form
  have hψ : IsTestForm (fun z => ContinuousAlternatingMap.curryLeft
      ((β : DifferentialForm (Euclid P) (m + 1)) z) z) :=
    Submission.dtc_cwv_euler_contraction_isTestForm P m _ β.property.1
  let ψ : TestFormOn (univ : Set (Euclid P)) m := ⟨_, hψ, subset_univ _⟩
  -- `χ = ι_X dβ` is a test `(m + 1)`-form
  have hdβ : IsTestForm (exteriorDerivative (β : DifferentialForm (Euclid P) (m + 1))) :=
    exteriorDerivative_isTestForm β.property.1
  have hχ := Submission.dtc_cwv_euler_contraction_isTestForm P (m + 1) _ hdβ
  let χ : TestFormOn (univ : Set (Euclid P)) (m + 1) := ⟨_, hχ, subset_univ _⟩
  -- Cartan's formula: `γ = L_X β = dψ + χ`
  have hsplit : γ = exteriorDerivativeTestOn univ m ψ + χ := by
    apply Subtype.ext
    funext y
    have hdiff : DifferentiableAt ℝ (β : DifferentialForm (Euclid P) (m + 1)) y :=
      (β.property.1.1.differentiable (by simp)).differentiableAt
    have hc := Submission.dtc_cone_euler_cartan P m β y hdiff
    rw [hγ y]
    push_cast
    exact hc.symm
  -- `C(dψ) = ∂C(ψ) = 0`
  have hbd : C.boundary = 0 := hb
  have h1 : C (exteriorDerivativeTestOn univ m ψ) = 0 := by
    have := congrArg (fun T : GeometricCurrentOn (univ : Set (Euclid P)) m => T ψ) hbd
    simpa [GeometricCurrentOn.boundary_apply] using this
  -- `C(χ) = ∫_M θ ξ(ι_y dβ(y)) dHⁿ = 0`: the wedge hypothesis passes from `θHⁿ⌞M` to `Hⁿ⌞M`
  have h2 : C χ = 0 := by
    rw [hR χ]
    unfold IMRep.action
    apply integral_eq_zero_of_ae
    have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) :=
      measurable_from_nat.comp R.measurable_mult
    have h' := (ae_withDensity_iff hθ).1 hw
    have hmem : ∀ᵐ x ∂(μHE[m + 1].restrict R.carrier), x ∈ R.carrier :=
      ae_restrict_mem R.measurableSet_carrier
    filter_upwards [h', hmem] with x hx hxM
    have hpos : (R.mult x : ℝ≥0∞) ≠ 0 := by
      have := R.mult_pos x hxM
      exact_mod_cast this.ne'
    have := hx hpos (exteriorDerivative (β : DifferentialForm (Euclid P) (m + 1)) x)
    simp only [Pi.zero_apply]
    change (R.mult x : ℝ) * R.orient x (ContinuousAlternatingMap.curryLeft
      (exteriorDerivative (β : DifferentialForm (Euclid P) (m + 1)) x) x) = 0
    rw [this, mul_zero]
  -- linearity: `C(γ) = C(dψ) + C(χ) = 0`
  rw [hsplit]
  change C.toCurrent (exteriorDerivativeTestOn univ m ψ + χ) = 0
  rw [map_add]
  exact (congrArg₂ (· + ·) h1 h2).trans (add_zero 0)

/-- Dilation invariance of `R.action` (Simon Ch. 6, Lemma 2.33 for the dilations `y ↦ sy`; the
step "`C` is a cone" in the proof of 7.3.1).  Suppose `R.action` annihilates every `L_X β`, where
`L_X β(y) = nβ(y) + Dβ(y)[y]` is the Lie derivative of `β` along the Euler field `X(y) = y`.
Put `β_s(y) = sⁿω(sy)` and `G(s) = R.action β_s`.  For `t > 0`, the derivative
`G'(t) = R.action(y ↦ nt^{n−1}ω(ty) + tⁿDω(ty)[y])` (`Submission.dtc_cwv_scaled_action_hasDerivAt`)
is `t⁻¹ R.action(L_X β_t) = 0`.  So `G` is constant on `(0, ∞)`, and
`R.action ω' = G(λ⁻¹) = G(1) = R.action ω`. -/
theorem Submission.dtc_cwv_action_dilation_invariant : ∀ (P n : ℕ) (R : IMRep (univ : Set (Euclid P)) n), (∀ β γ : TestFormOn (univ : Set (Euclid P)) n, (∀ y, (γ : DifferentialForm (Euclid P) n) y = (n : ℝ) • (β : DifferentialForm (Euclid P) n) y + fderiv ℝ (β : DifferentialForm (Euclid P) n) y y) → R.action (γ : DifferentialForm (Euclid P) n) = 0) → ∀ lam : ℝ, 0 < lam → ∀ ω ω' : TestFormOn (univ : Set (Euclid P)) n, (∀ y, (ω' : DifferentialForm (Euclid P) n) y = (lam⁻¹ ^ n) • (ω : DifferentialForm (Euclid P) n) (lam⁻¹ • y)) → R.action (ω' : DifferentialForm (Euclid P) n) = R.action (ω : DifferentialForm (Euclid P) n) := by
  intro P n R hL lam hlam ω ω' hω'
  have hws : ContDiff ℝ (⊤ : ℕ∞) (ω : DifferentialForm (Euclid P) n) := ω.property.1.1
  have hwc : HasCompactSupport (ω : DifferentialForm (Euclid P) n) := ω.property.1.2
  -- `R.action` is homogeneous under constant rescaling of the form
  have hsmul : ∀ (c : ℝ) (φ : DifferentialForm (Euclid P) n),
      R.action (fun y => c • φ y) = c * R.action φ := by
    intro c φ
    unfold IMRep.action
    rw [← integral_const_mul]
    congr 1
    funext x
    rw [map_smul, smul_eq_mul]
    ring
  -- `β_t(y) = tⁿ ω(t y)` is a test form for `t ≠ 0`
  have hβs : ∀ t : ℝ, ContDiff ℝ (⊤ : ℕ∞)
      (fun y => (t ^ n) • (ω : DifferentialForm (Euclid P) n) (t • y)) := fun t =>
    (hws.comp (contDiff_const_smul t)).const_smul (t ^ n)
  have hβc : ∀ t : ℝ, t ≠ 0 → HasCompactSupport
      (fun y => (t ^ n) • (ω : DifferentialForm (Euclid P) n) (t • y)) := by
    intro t ht
    refine (hwc.comp_smul ht).mono ?_
    intro y hy
    simp only [mem_support] at hy ⊢
    intro h0
    apply hy
    rw [h0, smul_zero]
  -- chain rule: `Dβ_t(y)[y] = tⁿ⁺¹ Dω(t y)[y]`
  have hfd : ∀ (t : ℝ) (y : Euclid P),
      fderiv ℝ (fun z => (t ^ n) • (ω : DifferentialForm (Euclid P) n) (t • z)) y y =
        (t ^ n * t) • fderiv ℝ (ω : DifferentialForm (Euclid P) n) (t • y) y := by
    intro t y
    have h1 : HasFDerivAt (fun z : Euclid P => t • z) (t • ContinuousLinearMap.id ℝ (Euclid P)) y :=
      (hasFDerivAt_id y).const_smul t
    have h2 : HasFDerivAt (fun z : Euclid P => (ω : DifferentialForm (Euclid P) n) (t • z))
        ((fderiv ℝ (ω : DifferentialForm (Euclid P) n) (t • y)).comp
          (t • ContinuousLinearMap.id ℝ (Euclid P))) y :=
      ((hws.differentiable (by simp)).differentiableAt (x := t • y)).hasFDerivAt.comp y h1
    have h3 : HasFDerivAt (fun z : Euclid P => (t ^ n) • (ω : DifferentialForm (Euclid P) n) (t • z))
        ((t ^ n) • (fderiv ℝ (ω : DifferentialForm (Euclid P) n) (t • y)).comp
          (t • ContinuousLinearMap.id ℝ (Euclid P))) y :=
      h2.const_smul (t ^ n)
    rw [h3.fderiv]
    simp [smul_smul]
  -- `γ_t(y) = nβ_t(y) + Dβ_t(y)[y]` is a test form for `t ≠ 0`
  have hγs : ∀ t : ℝ, ContDiff ℝ (⊤ : ℕ∞)
      (fun y => (n : ℝ) • ((t ^ n) • (ω : DifferentialForm (Euclid P) n) (t • y)) +
        fderiv ℝ (fun z => (t ^ n) • (ω : DifferentialForm (Euclid P) n) (t • z)) y y) := by
    intro t
    have hd : ContDiff ℝ (⊤ : ℕ∞)
        (fderiv ℝ (fun z => (t ^ n) • (ω : DifferentialForm (Euclid P) n) (t • z))) :=
      (hβs t).fderiv_right (by simp)
    exact ((hβs t).const_smul (n : ℝ)).add (hd.clm_apply contDiff_id)
  have hγc : ∀ t : ℝ, t ≠ 0 → HasCompactSupport
      (fun y => (n : ℝ) • ((t ^ n) • (ω : DifferentialForm (Euclid P) n) (t • y)) +
        fderiv ℝ (fun z => (t ^ n) • (ω : DifferentialForm (Euclid P) n) (t • z)) y y) := by
    intro t ht
    have h1 : HasCompactSupport
        (fun y => (n : ℝ) • ((t ^ n) • (ω : DifferentialForm (Euclid P) n) (t • y))) := by
      refine (hβc t ht).mono ?_
      intro y hy
      simp only [mem_support] at hy ⊢
      intro h0
      apply hy
      rw [h0, smul_zero]
    have h2 : HasCompactSupport
        (fun y => fderiv ℝ (fun z => (t ^ n) • (ω : DifferentialForm (Euclid P) n) (t • z)) y y) := by
      refine ((hβc t ht).fderiv ℝ).mono ?_
      intro y hy
      simp only [mem_support] at hy ⊢
      intro h0
      apply hy
      rw [h0]
      rfl
    exact h1.add h2
  -- `G(s) = R.action β_s` has derivative `t⁻¹ R.action γ_t = 0` at every `t > 0`
  let G : ℝ → ℝ := fun s => R.action (fun y => (s ^ n) • (ω : DifferentialForm (Euclid P) n) (s • y))
  have hG : ∀ t : ℝ, 0 < t → HasDerivAt G 0 t := by
    intro t ht
    have hD := Submission.dtc_cwv_scaled_action_hasDerivAt P n R ω t ht
    let β : TestFormOn (univ : Set (Euclid P)) n :=
      ⟨fun y => (t ^ n) • (ω : DifferentialForm (Euclid P) n) (t • y), ⟨hβs t, hβc t ht.ne'⟩,
        subset_univ _⟩
    let γ : TestFormOn (univ : Set (Euclid P)) n :=
      ⟨fun y => (n : ℝ) • ((t ^ n) • (ω : DifferentialForm (Euclid P) n) (t • y)) +
        fderiv ℝ (fun z => (t ^ n) • (ω : DifferentialForm (Euclid P) n) (t • z)) y y,
        ⟨hγs t, hγc t ht.ne'⟩, subset_univ _⟩
    have hγ0 : R.action (γ : DifferentialForm (Euclid P) n) = 0 := hL β γ (fun y => rfl)
    have heq : (fun y => ((n : ℝ) * t ^ (n - 1)) • (ω : DifferentialForm (Euclid P) n) (t • y) +
        (t ^ n) • fderiv ℝ (ω : DifferentialForm (Euclid P) n) (t • y) y) =
        fun y => t⁻¹ • (γ : DifferentialForm (Euclid P) n) y := by
      funext y
      change _ = t⁻¹ • ((n : ℝ) • ((t ^ n) • (ω : DifferentialForm (Euclid P) n) (t • y)) +
        fderiv ℝ (fun z => (t ^ n) • (ω : DifferentialForm (Euclid P) n) (t • z)) y y)
      rw [hfd t y, smul_add, smul_smul, smul_smul, smul_smul]
      congr 2
      · rcases Nat.eq_zero_or_pos n with hn | hn
        · subst hn; simp
        · obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
          field_simp
          simp [pow_succ]
      · field_simp
    have h0 : R.action (fun y => ((n : ℝ) * t ^ (n - 1)) • (ω : DifferentialForm (Euclid P) n) (t • y) +
        (t ^ n) • fderiv ℝ (ω : DifferentialForm (Euclid P) n) (t • y) y) = 0 := by
      rw [heq, hsmul, hγ0, mul_zero]
    rw [h0] at hD
    exact hD
  -- `G` is constant on the connected open set `(0, ∞)`
  have hconst : G lam⁻¹ = G 1 :=
    isOpen_Ioi.is_const_of_deriv_eq_zero (convex_Ioi (0 : ℝ)).isPreconnected
      (fun t ht => (hG t ht).differentiableAt.differentiableWithinAt)
      (fun t ht => (hG t ht).deriv) (inv_pos.2 hlam) (show (0 : ℝ) < 1 from one_pos)
  have hG1 : G 1 = R.action (ω : DifferentialForm (Euclid P) n) := by
    simp [G]
  have hGl : G lam⁻¹ = R.action (ω' : DifferentialForm (Euclid P) n) := by
    simp only [G]
    congr 1
    funext y
    rw [hω' y]
  rw [← hGl, hconst, hG1]

/-- **Radial tangency makes a boundaryless current a cone** (step 4 of the cone-splitting proof:
Simon 7.3.1(2) proof, Ch. 6, 2.25–2.27 and 2.33).  Let `S = τ(M, θ, ξ) ∈ 𝒟ₙ(ℝᴾ)`, `n ≥ 1`,
`∂S = 0`, with `x ∈ TₓM` for `μ`-a.e. `x`.  Then `x ∧ ξ(x) = 0` `μ`-a.e.
(`dtc_cone_wedge_vanishes`), so `S` annihilates `L_X β = nβ + Dβ[·]` for the Euler field
(`dtc_cwv_euler_lie_annihilated`), hence `G(s) = S(sⁿ ω(s ·))` is constant on `(0, ∞)`
(`dtc_cwv_action_dilation_invariant`), i.e. `S(λ⁻ⁿ ω(λ⁻¹ ·)) = S(ω)`, and `S` is a cone by the
cone criterion `dtc_cwv_isConeCurrent_of_pullback_invariant`. -/
theorem Submission.dimred_cs_cone_of_radial_tangency : ∀ (P n : ℕ) (S : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n), 0 < n → R.Represents S → BoundaryVanishes S → (∀ᵐ x ∂R.measure, (approxTangentPlane n R.carrier x).starProjection x = x) → IsConeCurrent S := by
  intro P n S R hn hR hb hrad
  -- step 2: `ξ(x)(ι_x β) = 0` for `μ`-a.e. `x` and every `(n + 1)`-covector `β`
  have hw := Submission.dtc_cone_wedge_vanishes P n univ R hrad
  -- step 4: `R.action (L_X β) = S(L_X β) = 0`
  have hL : ∀ β γ : TestFormOn (univ : Set (Euclid P)) n,
      (∀ y, (γ : DifferentialForm (Euclid P) n) y =
        (n : ℝ) • (β : DifferentialForm (Euclid P) n) y +
          fderiv ℝ (β : DifferentialForm (Euclid P) n) y y) →
      R.action (γ : DifferentialForm (Euclid P) n) = 0 := fun β γ hγ =>
    (hR γ).symm.trans (Submission.dtc_cwv_euler_lie_annihilated P n S R hn hR hb hw β γ hγ)
  -- steps 1, 3 and 5: by the cone criterion, `S(ω') = R.action ω' = R.action ω = S(ω)`
  refine Submission.dtc_cwv_isConeCurrent_of_pullback_invariant P n S fun lam hlam ω ω' hω' => ?_
  rw [hR ω', hR ω]
  exact Submission.dtc_cwv_action_dilation_invariant P n R hL lam hlam ω ω' hω'
/-- **Push-forward of an integer multiplicity triple by a linear map** (Simon Ch. 6, 3.3–3.9,
Lemma 3.9, for `f = L`).  Let `R = (M, θ, ξ)` be an `IMRep` in `ℝᴾ` of dimension `m ≥ 1` with
`μ_R(ℝᴾ \ K) = 0` for a compact `K`.  Then `L_#τ(M, θ, ξ)` is represented by a triple carried by
`L(K)`.  `T = τ(M, θ, ξ)` is a current (`dtc_imrep_current`) with
`spt T = spt μ_R ⊆ K` (`dor_imrep_massOn_eq_measure_and_support`), a compact set.  The
`C¹` push-forward along `L` (`dtc_bc_lc_pushforward`, with `DL(x) = L`) is integer multiplicity,
has support in `L(spt T) ⊆ L(K)`, and evaluates `ω` to `∫_M θ ⟨ω(Lx) ∘ ΛᵐL, ξ⟩ dHᵐ = R(L^#ω)`.
A representation `R₁` of it has `spt μ_{R₁} = spt L_#T ⊆ L(K)`, so `μ_{R₁}(ℝᴾ \ L(K)) = 0`, and
`θ₁ ≥ 1` on `M₁` gives `Hᵐ(M₁ \ L(K)) = 0`.  Cutting `R₁` to the compact set `L(K)`
(`dtc_imrep_of_null_off_compact`) keeps its action. -/
theorem Submission.dimred_cs_sp_imrep_linear_pushforward : ∀ (P m : ℕ) (R : IMRep (univ : Set (Euclid P)) m) (L : Euclid P →L[ℝ] Euclid P) (K : Set (Euclid P)), 0 < m → IsCompact K → R.measure Kᶜ = 0 → ∃ R' : IMRep (univ : Set (Euclid P)) m, R'.carrier ⊆ L '' K ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) m, R'.action (ω : DifferentialForm (Euclid P) m) = R.action (affinePullbackForm L 0 (ω : DifferentialForm (Euclid P) m)) := by
  intro P m R L K hm hK hRK
  obtain ⟨m, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
  -- Step 1: `T = τ(M, θ, ξ)` has `spt T = spt μ_R ⊆ K`, so `spt T` is compact
  obtain ⟨T, hT⟩ := Submission.dtc_imrep_current P (m + 1) univ R
  have hsptT : T.support = R.measure.support := by
    rw [(Submission.dor_imrep_massOn_eq_measure_and_support P (m + 1) univ T R isOpen_univ
      hT).2, univ_inter]
  have hTK : T.support ⊆ K := by
    rw [hsptT]
    exact Measure.support_subset_of_isClosed hK.isClosed (mem_ae_iff.mpr hRK)
  have hTc : IsCompact T.support :=
    hK.of_isClosed_subset (hsptT ▸ Measure.isClosed_support) hTK
  -- Step 2: the `C¹` push-forward along `L` is integer multiplicity with support in `L(K)`
  obtain ⟨push, hpush, -⟩ := Submission.dtc_bc_lc_pushforward P m univ L isOpen_univ
    L.contDiff.contDiffOn
  obtain ⟨hform, ⟨R₁, hR₁⟩, hspt, -, -⟩ := hpush T R hT hTc (subset_univ _)
  have hLK : IsCompact (L '' K) := hK.image L.continuous
  -- Step 3: `spt μ_{R₁} = spt L_#T ⊆ L(K)`, so `μ_{R₁}(ℝᴾ \ L(K)) = 0`
  have hμ₁ : R₁.measure (L '' K)ᶜ = 0 := by
    have hsupp₁ : R₁.measure.support ⊆ L '' K := by
      rw [← univ_inter R₁.measure.support,
        ← (Submission.dor_imrep_massOn_eq_measure_and_support P (m + 1) univ (push T) R₁
          isOpen_univ hR₁).2]
      exact hspt.trans (image_mono hTK)
    exact measure_mono_null (compl_subset_compl.mpr hsupp₁) Measure.measure_compl_support
  -- Step 4: `θ₁ ≥ 1` on `M₁`, hence `Hᵐ(M₁ \ L(K)) = 0`
  have hnull : μHE[m + 1] (R₁.carrier \ L '' K) = 0 := by
    have hmeas : MeasurableSet (L '' K)ᶜ := hLK.isClosed.measurableSet.compl
    have h0 : ∫⁻ x in R₁.carrier ∩ (L '' K)ᶜ, (R₁.mult x : ℝ≥0∞) ∂μHE[m + 1] = 0 := by
      rw [← hμ₁, IMRep.measure, withDensity_apply _ hmeas, Measure.restrict_restrict hmeas,
        inter_comm]
    refine nonpos_iff_eq_zero.mp ?_
    calc μHE[m + 1] (R₁.carrier \ L '' K)
        = ∫⁻ _ in R₁.carrier ∩ (L '' K)ᶜ, 1 ∂μHE[m + 1] := by rw [setLIntegral_one, sdiff_eq]
      _ ≤ ∫⁻ x in R₁.carrier ∩ (L '' K)ᶜ, (R₁.mult x : ℝ≥0∞) ∂μHE[m + 1] :=
        setLIntegral_mono
          ((measurable_from_nat (f := fun k : ℕ => (k : ℝ≥0∞))).comp R₁.measurable_mult)
          fun x hx => Nat.one_le_cast.mpr (R₁.mult_pos x hx.1)
      _ = 0 := h0
  -- Step 5: cut `R₁` to the compact set `L(K)`; the action is `R(L^#ω)` since `DL(x) = L`
  obtain ⟨R', hR'K, hR'⟩ := Submission.dtc_imrep_of_null_off_compact P (m + 1) univ univ
    (L '' K) R₁ hLK (subset_univ _) (subset_univ _) hnull
  refine ⟨R', hR'K, fun ω => ?_⟩
  rw [hR' ω, ← hR₁ ω, hform ω]
  simp only [IMRep.action, affinePullbackForm, zero_add, ContinuousLinearMap.fderiv]

/-- **Simon Ch. 6, 2.23–2.24 and 3.9, for a linear map `L`**: if `X = τ(M, θ, ξ)` in `ℝᴾ` has
compact support `K`, then the push-forward `L_#X` is an integer multiplicity current `Y` with
`spt Y ⊆ L(K)`, `∂Y = 0` if `∂X = 0`, and `Y(ω) = τ(M, θ, ξ)(L^#ω)`.  Since `K = spt μ_R`, the
measure `μ_R` is carried by `K`; push `(M, θ, ξ)` forward to a triple `R'` carried by `L(K)` and
let `Y = τ(R')`.  `L(K)` is compact, hence closed, so `spt Y ⊆ L(K)`; and if `∂X = 0` then
`∂Y(φ) = τ(M, θ, ξ)(L^#dφ) = τ(M, θ, ξ)(d(L^#φ)) = 0`. -/
theorem Submission.dimred_cs_sp_linear_pushforward : ∀ (P m : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) m) (R : IMRep (univ : Set (Euclid P)) m) (L : Euclid P →L[ℝ] Euclid P), 0 < m → R.Represents X → IsCompact X.support → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) m, IsIntegerMultiplicity Y ∧ Y.support ⊆ L '' X.support ∧ (BoundaryVanishes X → BoundaryVanishes Y) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) m, Y ω = R.action (affinePullbackForm L 0 (ω : DifferentialForm (Euclid P) m)) := by
  intro P m X R L hm hR hK
  -- Step 1: `spt X = spt μ_R`, so `μ_R(ℝᴾ \ spt X) = 0`
  have hnull : R.measure X.supportᶜ = 0 := by
    rw [(Submission.dor_imrep_massOn_eq_measure_and_support P m univ X R isOpen_univ hR).2,
      univ_inter]
    exact Measure.measure_compl_support
  -- Step 2: push `(M, θ, ξ)` forward to a triple `R'` carried by `L(spt X)`
  obtain ⟨R', hR'sub, hR'act⟩ :=
    Submission.dimred_cs_sp_imrep_linear_pushforward P m R L X.support hm hK hnull
  -- Step 3: `Y = τ(R')`, so `Y(ω) = τ(R')(ω) = τ(M, θ, ξ)(L^#ω)`
  obtain ⟨Y, hY⟩ := Submission.dtc_imrep_current P m univ R'
  have hact : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
      Y ω = R.action (affinePullbackForm L 0 (ω : DifferentialForm (Euclid P) m)) :=
    fun ω => (hY ω).trans (hR'act ω)
  refine ⟨Y, ⟨R', hY⟩, ?_, ?_, hact⟩
  · -- Step 4: `L(spt X)` is compact, hence closed, and contains the carrier of `R'`
    exact Submission.dimred_cs_sp_cp_support_subset_of_carrier_subset P m Y R' (L '' X.support)
      hY (hK.image L.continuous).isClosed hR'sub
  · -- Step 5: for `m = k + 1`, `∂Y(φ) = τ(M, θ, ξ)(L^#dφ) = τ(M, θ, ξ)(d(L^#φ)) = 0`
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_one_of_ne_zero hm.ne'
    intro hX
    change X.boundary = 0 at hX
    change Y.boundary = 0
    ext φ
    have hφ : IsSmoothForm (φ : DifferentialForm (Euclid P) k) := φ.property.1.1
    rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.zero_apply, hact]
    change R.action (affinePullbackForm L 0
      (exteriorDerivative (φ : DifferentialForm (Euclid P) k))) = 0
    rw [← exteriorDerivative_affinePullbackForm L 0 hφ]
    exact Submission.dimred_cs_sp_cp_action_extDeriv_eq_zero P k X R X.support _ hR hK hnull hX
      (affinePullbackForm_isSmoothForm L 0 hφ)
/-- **Orthogonal projection does not increase mass** (Simon 7.3.1, footnote 2; the push-forward
`f_# T(ω) = ∫ ⟨ω(f(x)), dfₓ# ξ(x)⟩ dμ_T(x)` of Ch. 6, 2.24(2); dimension reduction for 7.3.3).
Let `q` be the orthogonal projection onto `V`, `T = τ(M_T, θ_T, ξ_T)` with `μ_T(ℝᴾ \ V) = 0`,
`X = τ(M_X, θ_X, ξ_X)` with `μ_X(ℝᴾ \ K) = 0` for a compact `K`, and `S' = T + q_# X`, i.e.
`S'(ω) = T(ω) + τ(M_X, θ_X, ξ_X)(q^# ω)`.  The integer combination `R = (M, θ, ξ)` with
`1_M θ ξ = 1_{M_T} θ_T ξ_T + 1_{M_X} θ_X ξ_X` `Hᵐ`-a.e. has
`τ(R)(β) = τ(M_T, θ_T, ξ_T)(β) + τ(M_X, θ_X, ξ_X)(β)` whenever both pairings are integrable
(pairing bound).  This holds for test forms, so `R` represents `T + X`, and for `q^# ω`: `M_T`
lies a.e. in `V`, where `q^# ω` vanishes off `spt ω`, and `M_X` lies a.e. in `K`.  As
`μ_T(ℝᴾ \ V) = 0`, `τ(M_T, θ_T, ξ_T)(q^# ω) = T(ω)`, hence `S'(ω) = τ(R)(q^# ω)`.  A unit
orientation satisfies `|⟨α ∘ Λᵐq, ξ⟩| ≤ |α|_E ‖q‖ᵐ ≤ |α|_E` (Hadamard, `‖q‖ ≤ 1`), so for `ω`
with `spt ω ⊆ O` and `|ω|_E ≤ 1`, `S'(ω) ≤ ∫_{M ∩ q⁻¹(spt ω)} θ dHᵐ ≤ μ_R(q⁻¹(O))`. -/
theorem Submission.idtp_fons_cs_sp_projected_massOn_le : ∀ (P m : ℕ) (T X S' : GeometricCurrentOn (univ : Set (Euclid P)) m) (RT RX : IMRep (univ : Set (Euclid P)) m) (V : Submodule ℝ (Euclid P)) (K : Set (Euclid P)), RT.Represents T → RX.Represents X → RT.measure ((V : Set (Euclid P))ᶜ) = 0 → IsCompact K → RX.measure Kᶜ = 0 → (∀ ω : TestFormOn (univ : Set (Euclid P)) m, S' ω = T ω + RX.action (affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m))) → ∃ R : IMRep (univ : Set (Euclid P)) m, (∀ ω : TestFormOn (univ : Set (Euclid P)) m, R.action (ω : DifferentialForm (Euclid P) m) = T ω + X ω) ∧ ∀ O : Set (Euclid P), S'.massOn O ≤ R.measure (V.starProjection ⁻¹' O) := by
  intro P m T X S' RT RX V K hRT hRX hTV hK hXK hS'
  -- Step 1: if `μ_{R'}(ℝᴾ \ C) = 0`, then `Hᵐ⌞M'`-a.e. point lies in `C`, as `θ' ≥ 1` on `M'`
  have hlive : ∀ (R' : IMRep (univ : Set (Euclid P)) m) (C : Set (Euclid P)), R'.measure Cᶜ = 0 →
      ∀ᵐ x ∂(μHE[m].restrict R'.carrier), x ∈ C := by
    intro R' C hC
    have hac : μHE[m].restrict R'.carrier ≪ R'.measure :=
      withDensity_absolutelyContinuous' (f := fun x => (R'.mult x : ℝ≥0∞))
        (measurable_from_nat.comp R'.measurable_mult).aemeasurable
        (by
          filter_upwards [ae_restrict_mem R'.measurableSet_carrier] with x hx
          exact Nat.cast_ne_zero.2 (R'.mult_pos x hx).ne')
    exact ae_iff.2 (hac hC)
  -- Step 2: integrability of `θ' ⟨β, ξ'⟩` on `M'` for a continuous bounded `β` that vanishes
  -- `Hᵐ⌞M'`-a.e. off a compact `C`: apply the pairing bound to `1_C β`, which equals `β` a.e.
  have hint_of : ∀ (R' : IMRep (univ : Set (Euclid P)) m) (β : DifferentialForm (Euclid P) m)
      (C : Set (Euclid P)) (B : ℝ), Continuous β → (∀ x, ‖β x‖ ≤ B) → IsCompact C →
      (∀ᵐ x ∂(μHE[m].restrict R'.carrier), x ∉ C → β x = 0) →
      Integrable (fun x => (R'.mult x : ℝ) * R'.orient x (β x)) (μHE[m].restrict R'.carrier) := by
    intro R' β C B hβ hB hC h0
    refine (Submission.dpf_pfc_imrep_pairing_integrable_abs_le P m univ C R' (C.indicator β) B hC
      (subset_univ C) (hβ.aestronglyMeasurable.indicator hC.isClosed.measurableSet)
      (fun x hx => indicator_of_notMem hx β)
      (fun x => (norm_indicator_le_norm_self β x).trans (hB x))).1.congr ?_
    filter_upwards [h0] with x hx
    by_cases hxC : x ∈ C
    · rw [indicator_of_mem hxC]
    · rw [indicator_of_notMem hxC, hx hxC]
  -- Step 3: the integer combination `R` with `1_M θ ξ = 1_{M_T} θ_T ξ_T + 1_{M_X} θ_X ξ_X` a.e.
  obtain ⟨R, hR⟩ := Submission.rsdic_exists_imrep_int_combination P m univ RT RX 1 1 isOpen_univ
  -- Step 4: `τ(R)(β) = τ(RT)(β) + τ(RX)(β)` when both pairings are integrable, since
  -- `τ(R')(β) = ∫ ⟨β, 1_{M'} θ' ξ'⟩ dHᵐ` for every `R'`
  have hadd : ∀ β : DifferentialForm (Euclid P) m,
      Integrable (fun x => (RT.mult x : ℝ) * RT.orient x (β x)) (μHE[m].restrict RT.carrier) →
      Integrable (fun x => (RX.mult x : ℝ) * RX.orient x (β x)) (μHE[m].restrict RX.carrier) →
      R.action β = RT.action β + RX.action β := by
    intro β hT hX
    have hfun : ∀ R' : IMRep (univ : Set (Euclid P)) m,
        (fun x => R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x (β x)) =
          R'.carrier.indicator (fun y => (R'.mult y : ℝ) * R'.orient y (β y)) := by
      intro R'
      funext x
      by_cases hx : x ∈ R'.carrier
      · simp [indicator_of_mem hx]
      · simp [indicator_of_notMem hx]
    have hact : ∀ R' : IMRep (univ : Set (Euclid P)) m, R'.action β =
        ∫ x, R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x (β x) ∂μHE[m] := by
      intro R'
      rw [hfun R', integral_indicator R'.measurableSet_carrier]
      rfl
    have hint : ∀ R' : IMRep (univ : Set (Euclid P)) m,
        Integrable (fun x => (R'.mult x : ℝ) * R'.orient x (β x)) (μHE[m].restrict R'.carrier) →
        Integrable (fun x => R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x
          (β x)) μHE[m] := by
      intro R' h
      rw [hfun R', integrable_indicator_iff R'.measurableSet_carrier]
      exact h
    rw [hact R, hact RT, hact RX, ← integral_add (hint RT hT) (hint RX hX)]
    refine integral_congr_ae ?_
    filter_upwards [hR] with x hx
    rw [hx]
    simp
  -- Step 5: a test form is continuous, bounded and vanishes off its compact support, so `R`
  -- represents `T + X`
  have htest : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
      R.action (ω : DifferentialForm (Euclid P) m) =
        RT.action (ω : DifferentialForm (Euclid P) m) +
          RX.action (ω : DifferentialForm (Euclid P) m) := by
    intro ω
    obtain ⟨⟨hsmooth, hcpt⟩, -⟩ := ω.2
    have hωc : Continuous (ω : DifferentialForm (Euclid P) m) := ContDiff.continuous hsmooth
    obtain ⟨B, hB⟩ := hωc.bounded_above_of_compact_support hcpt
    have h0 : ∀ R' : IMRep (univ : Set (Euclid P)) m, ∀ᵐ x ∂(μHE[m].restrict R'.carrier),
        x ∉ tsupport (ω : DifferentialForm (Euclid P) m) →
          (ω : DifferentialForm (Euclid P) m) x = 0 :=
      fun R' => Eventually.of_forall fun x hx => image_eq_zero_of_notMem_tsupport hx
    exact hadd _ (hint_of RT _ _ B hωc hB hcpt (h0 RT)) (hint_of RX _ _ B hωc hB hcpt (h0 RX))
  -- Step 6: `q^# ω`, `(q^# ω)(x) = ω(q x) ∘ Λᵐq`, is continuous with `‖q^# ω‖ ≤ sup ‖ω‖`
  -- (`‖q‖ ≤ 1`); it vanishes on `V \ spt ω` (`q x = x` there), so `S'(ω) = τ(R)(q^# ω)`
  have hq1 : ‖V.starProjection‖ ≤ 1 := V.starProjection_norm_le
  have hpull : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
      S' ω =
        R.action (affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m)) := by
    intro ω
    obtain ⟨⟨hsmooth, hcpt⟩, -⟩ := ω.2
    have hωc : Continuous (ω : DifferentialForm (Euclid P) m) := ContDiff.continuous hsmooth
    obtain ⟨B, hB⟩ := hωc.bounded_above_of_compact_support hcpt
    have hβc : Continuous
        (affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m)) :=
      ContDiff.continuous (affinePullbackForm_isSmoothForm V.starProjection 0 hsmooth)
    have hβB : ∀ x,
        ‖affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m) x‖ ≤ B := by
      intro x
      calc ‖affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m) x‖
          ≤ ‖(ω : DifferentialForm (Euclid P) m) (0 + V.starProjection x)‖ *
              ‖V.starProjection‖ ^ Fintype.card (Fin m) :=
            ContinuousAlternatingMap.norm_compContinuousLinearMap_le _ _
        _ ≤ ‖(ω : DifferentialForm (Euclid P) m) (0 + V.starProjection x)‖ :=
            mul_le_of_le_one_right (norm_nonneg _) (pow_le_one₀ (norm_nonneg _) hq1)
        _ ≤ B := hB _
    have hT0 : ∀ᵐ x ∂(μHE[m].restrict RT.carrier),
        x ∉ tsupport (ω : DifferentialForm (Euclid P) m) →
          affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m) x = 0 := by
      filter_upwards [hlive RT _ hTV] with x hxV hx
      have hqx : V.starProjection x = x :=
        Submodule.starProjection_eq_self_iff.2 (SetLike.mem_coe.1 hxV)
      ext v
      simp [affinePullbackForm, ContinuousAlternatingMap.compContinuousLinearMap_apply, hqx,
        image_eq_zero_of_notMem_tsupport hx]
    have hX0 : ∀ᵐ x ∂(μHE[m].restrict RX.carrier), x ∉ K →
        affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m) x = 0 := by
      filter_upwards [hlive RX K hXK] with x hxK hx
      exact absurd hxK hx
    rw [hS' ω, hRT ω, ← Submission.idtp_fons_cs_sp_action_starProjection_eq P m RT V hTV
      (ω : DifferentialForm (Euclid P) m), hadd _ (hint_of RT _ _ B hβc hβB hcpt hT0)
      (hint_of RX _ K B hβc hβB hK hX0)]
  refine ⟨R, fun ω => by rw [htest ω, ← hRT ω, ← hRX ω], fun O => ?_⟩
  -- Step 7: a unit orientation has `|⟨α ∘ Λᵐq, ξ⟩| ≤ |α|_E ‖q‖ᵐ ≤ |α|_E` (Hadamard)
  have hproj : ∀ᵐ x ∂(μHE[m].restrict R.carrier), ∀ α : Covector (Euclid P) m,
      |R.orient x (α.compContinuousLinearMap V.starProjection)| ≤ covectorEuclideanNorm α := by
    filter_upwards [R.orients] with x hx α
    obtain ⟨Q, -, hQ⟩ := hx
    exact ((Submission.dtc_bc_lc_pf_unitOrientation_comp P m (R.orient x) Q V.starProjection
      hQ).1 α).trans (mul_le_of_le_one_right (covectorEuclideanNorm_nonneg α)
        (pow_le_one₀ (norm_nonneg _) hq1))
  -- Step 8: for admissible `ω` with `spt ω ⊆ O`, `|θ ⟨q^# ω, ξ⟩| ≤ θ 1_{q⁻¹(spt ω)}` a.e. on `M`,
  -- so `S'(ω) = τ(R)(q^# ω) ≤ μ_R(q⁻¹(spt ω)) ≤ μ_R(q⁻¹(O))`
  apply sSup_le
  rintro r ⟨ω, ⟨hωO, hω1⟩, rfl⟩
  have hs : MeasurableSet (V.starProjection ⁻¹' tsupport (ω : DifferentialForm (Euclid P) m)) :=
    ((isClosed_tsupport _).preimage V.starProjection.continuous).measurableSet
  have hpt : ∀ᵐ x ∂(μHE[m].restrict R.carrier),
      ‖(R.mult x : ℝ) * R.orient x
          (affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m) x)‖ₑ ≤
        (V.starProjection ⁻¹' tsupport (ω : DifferentialForm (Euclid P) m)).indicator
          (fun y => (R.mult y : ℝ≥0∞)) x := by
    filter_upwards [hproj] with x hx
    by_cases hxs : x ∈ V.starProjection ⁻¹' tsupport (ω : DifferentialForm (Euclid P) m)
    · rw [indicator_of_mem hxs, ← ofReal_norm, ← ENNReal.ofReal_natCast]
      refine ENNReal.ofReal_le_ofReal ?_
      rw [norm_mul, Real.norm_natCast, Real.norm_eq_abs]
      exact mul_le_of_le_one_right (Nat.cast_nonneg _)
        ((hx ((ω : DifferentialForm (Euclid P) m) (0 + V.starProjection x))).trans (hω1 _))
    · have hxs' : V.starProjection x ∉ tsupport (ω : DifferentialForm (Euclid P) m) := hxs
      have h0 :
          affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m) x = 0 := by
        ext v
        simp [affinePullbackForm, ContinuousAlternatingMap.compContinuousLinearMap_apply,
          image_eq_zero_of_notMem_tsupport hxs']
      rw [indicator_of_notMem hxs, h0]
      simp
  calc ENNReal.ofReal (S' ω)
      = ENNReal.ofReal (R.action
          (affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m))) := by
        rw [hpull ω]
    _ ≤ ‖R.action (affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m))‖ₑ :=
        (ENNReal.ofReal_le_ofReal (Real.le_norm_self _)).trans_eq (ofReal_norm _)
    _ ≤ ∫⁻ x in R.carrier, ‖(R.mult x : ℝ) * R.orient x
          (affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m) x)‖ₑ ∂μHE[m] :=
        enorm_integral_le_lintegral_enorm _
    _ ≤ ∫⁻ x in R.carrier,
          (V.starProjection ⁻¹' tsupport (ω : DifferentialForm (Euclid P) m)).indicator
            (fun y => (R.mult y : ℝ≥0∞)) x ∂μHE[m] :=
        lintegral_mono_ae hpt
    _ = R.measure (V.starProjection ⁻¹' tsupport (ω : DifferentialForm (Euclid P) m)) := by
        rw [lintegral_indicator hs, IMRep.measure, withDensity_apply _ hs]
    _ ≤ R.measure (V.starProjection ⁻¹' O) := measure_mono (preimage_mono hωO)
/-- **Orthogonal projection does not increase mass, `spt X` compact** (Simon 7.3.1, footnote 2;
dimension reduction for 7.3.3).  Let `q` be the orthogonal projection onto `V`,
`T = τ(M_T, θ_T, ξ_T)` with `μ_T(ℝᴾ \ V) = 0`, `X = τ(M_X, θ_X, ξ_X)` with `spt X` compact, and
`S'(ω) = T(ω) + τ(M_X, θ_X, ξ_X)(q^# ω)`.  Then some integer multiplicity triple `R` represents
`T + X` and `M_O(S') ≤ μ_R(q⁻¹(O))` for every `O`.  By Ch. 6, 3.2(3) and 2.12, `spt X = spt μ_X`,
and `μ_X(ℝᴾ \ spt μ_X) = 0` as `ℝᴾ` is second countable; so `μ_X` is carried by the compact set
`K = spt X`, which is the case proved above. -/
theorem Submission.dimred_cs_sp_projected_massOn_le : ∀ (P m : ℕ) (T X S' : GeometricCurrentOn (univ : Set (Euclid P)) m) (RT RX : IMRep (univ : Set (Euclid P)) m) (V : Submodule ℝ (Euclid P)), RT.Represents T → RX.Represents X → RT.measure ((V : Set (Euclid P))ᶜ) = 0 → IsCompact X.support → (∀ ω : TestFormOn (univ : Set (Euclid P)) m, S' ω = T ω + RX.action (affinePullbackForm V.starProjection 0 (ω : DifferentialForm (Euclid P) m))) → ∃ R : IMRep (univ : Set (Euclid P)) m, (∀ ω : TestFormOn (univ : Set (Euclid P)) m, R.action (ω : DifferentialForm (Euclid P) m) = T ω + X ω) ∧ ∀ O : Set (Euclid P), S'.massOn O ≤ R.measure (V.starProjection ⁻¹' O) := by
  intro P m T X S' RT RX V hRT hRX hTV hK hS'
  -- `spt X = ℝᴾ ∩ spt μ_X`, and `μ_X` vanishes off its support (`ℝᴾ` is second countable)
  have hXK : RX.measure (X.support)ᶜ = 0 := by
    rw [(Submission.dor_imrep_massOn_eq_measure_and_support P m univ X RX isOpen_univ hRX).2,
      univ_inter]
    exact Measure.measure_compl_support
  -- the compactly carried case, with `K = spt X`
  exact Submission.idtp_fons_cs_sp_projected_massOn_le P m T X S' RT RX V X.support hRT hRX hTV hK
    hXK hS'
/-- Balls of a product measure `μ = Hᵈ⌞L ⊗ μ₀` (`d = dim L`, `μ₀` concentrated on `L^⊥`):
`μ(B_ρ(t + y)) = ∫_{ℝᵈ} μ₀(B_{√(ρ² − |σ|²)}(y)) dLᵈ(σ)` for `t ∈ L`, `y ∈ L^⊥` and `ρ > 0`.  For
`s ∈ L` and `y' ∈ L^⊥`, Pythagoras gives `s + y' ∈ B_ρ(t + y)` iff `y' ∈ B_{√(ρ² − |t − s|²)}(y)`;
an isometric parametrization of `L` by `ℝᵈ` carries `Lᵈ` to `Hᵈ⌞L`, and a translation centres the
integral at `t`. -/
theorem Submission.dimred_cs_psd_ball_formula : ∀ (P : ℕ) (L : Submodule ℝ (Euclid P)) (μ μ₀ : Measure (Euclid P)), μ₀ (Lᗮ : Set (Euclid P))ᶜ = 0 → (∀ A : Set (Euclid P), MeasurableSet A → μ A = ∫⁻ t in (L : Set (Euclid P)), μ₀ ((fun y => t + y) ⁻¹' A) ∂μHE[Module.finrank ℝ L]) → ∀ t ∈ L, ∀ y ∈ Lᗮ, ∀ ρ : ℝ, 0 < ρ → μ (ball (t + y) ρ) = ∫⁻ σ : Euclid (Module.finrank ℝ L), μ₀ (ball y (Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2))) := by
  intro P L μ μ₀ hconc hprod t ht y hy ρ hρ
  -- concentration of `μ₀` on `Lᗮ`
  have hconc' : ∀ X : Set (Euclid P), μ₀ X = μ₀ (X ∩ (Lᗮ : Set (Euclid P))) := by
    intro X
    refine le_antisymm ?_ (measure_mono inter_subset_left)
    calc μ₀ X ≤ μ₀ (X ∩ (Lᗮ : Set (Euclid P))) + μ₀ (X \ (Lᗮ : Set (Euclid P))) :=
          measure_le_inter_add_sdiff μ₀ X _
      _ ≤ μ₀ (X ∩ (Lᗮ : Set (Euclid P))) + μ₀ (Lᗮ : Set (Euclid P))ᶜ := by
          gcongr
          exact fun z hz => hz.2
      _ = μ₀ (X ∩ (Lᗮ : Set (Euclid P))) := by rw [hconc, add_zero]
  -- slicing the ball over a point `s ∈ L`
  have hslice : ∀ s ∈ L, μ₀ ((fun y' => s + y') ⁻¹' ball (t + y) ρ) =
      μ₀ (ball y (Real.sqrt (ρ ^ 2 - ‖t - s‖ ^ 2))) := by
    intro s hs
    rw [hconc' ((fun y' => s + y') ⁻¹' ball (t + y) ρ), hconc' (ball y _)]
    congr 1
    ext y'
    simp only [mem_inter_iff, mem_preimage, mem_ball, SetLike.mem_coe]
    refine and_congr_left fun hy' => ?_
    have horth : inner ℝ (s - t) (y' - y) = 0 :=
      Submodule.inner_right_of_mem_orthogonal (L.sub_mem hs ht) (Lᗮ.sub_mem hy' hy)
    have hpyth : ‖s + y' - (t + y)‖ ^ 2 = ‖t - s‖ ^ 2 + ‖y' - y‖ ^ 2 := by
      have h1 : s + y' - (t + y) = (s - t) + (y' - y) := by abel
      rw [h1, ← norm_neg (t - s), neg_sub]
      have := norm_add_sq_eq_norm_sq_add_norm_sq_real horth
      nlinarith [this]
    rw [dist_eq_norm, dist_eq_norm, Real.lt_sqrt (norm_nonneg _)]
    rw [← sq_lt_sq₀ (norm_nonneg _) hρ.le, hpyth]
    constructor <;> intro h <;> linarith
  rw [hprod _ measurableSet_ball,
    setLIntegral_congr_fun (Submodule.closed_of_finiteDimensional L).measurableSet hslice]
  -- an isometric parametrization of `L` by `ℝᵈ`
  set d := Module.finrank ℝ L
  let b := stdOrthonormalBasis ℝ L
  let ι : Euclid d → Euclid P := fun σ => ((b.repr.symm σ : L) : Euclid P)
  have hι : Isometry ι := L.subtypeₗᵢ.isometry.comp b.repr.symm.isometry
  have hrange : range ι = (L : Set (Euclid P)) := by
    ext z
    constructor
    · rintro ⟨σ, rfl⟩
      exact (b.repr.symm σ).2
    · intro hz
      exact ⟨b.repr ⟨z, hz⟩, by simp [ι]⟩
  have hmap : (volume : Measure (Euclid d)).map ι = μHE[d].restrict (L : Set (Euclid P)) := by
    rw [← EuclideanSpace.euclideanHausdorffMeasure_eq_volume, hι.map_euclideanHausdorffMeasure,
      hrange]
  rw [← hmap, hι.isClosedEmbedding.measurableEmbedding.lintegral_map]
  -- translate
  set σt : Euclid d := b.repr ⟨t, ht⟩
  have hnorm : ∀ σ : Euclid d, ‖t - ι σ‖ = ‖σ - σt‖ := by
    intro σ
    have ht' : t = ι σt := by simp [ι, σt]
    rw [ht', ← dist_eq_norm, hι.dist_eq, dist_eq_norm, norm_sub_rev]
  simp_rw [hnorm]
  exact lintegral_sub_right_eq_self (fun σ => μ₀ (ball y (Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2)))) σt
/-- **Cavalieri slicing of Euclidean balls**: for `ρ ≥ 0`,
`L^{d+m}(B_ρ(0)) = ∫_{ℝᵈ} Lᵐ(B_{√(ρ² − ‖σ‖²)}(0)) dLᵈ(σ)`.  Reindexing along
`Fin d ⊕ Fin m ≃ Fin (d + m)` and splitting the blocks is a linear isometry
`ℝ^{d+m} ≃ ℝᵈ × ℝᵐ` (L² product norm), hence carries `L^{d+m}` to `Lᵈ ⊗ Lᵐ`; it maps `B_ρ(0)`
onto `Q = {(u, v) : ‖u‖² + ‖v‖² < ρ²}`, whose slice over `σ` is `B_{√(ρ² − ‖σ‖²)}(0)`, and Tonelli
gives the formula. -/
theorem Submission.dimred_cs_psd_ball_volume_slice : ∀ (d m : ℕ) (ρ : ℝ), 0 ≤ ρ → volume (ball (0 : Euclid (d + m)) ρ) = ∫⁻ σ : Euclid d, volume (ball (0 : Euclid m) (Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2))) := by
  intro d m ρ hρ
  -- `Φ = ofLp ∘ e : ℝ^{d+m} → ℝᵈ × ℝᵐ` is volume preserving onto `Lᵈ ⊗ Lᵐ`
  let e : Euclid (d + m) ≃ₗᵢ[ℝ] WithLp 2 (Euclid d × Euclid m) :=
    (LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ finSumFinEquiv.symm).trans
      (PiLp.sumPiLpEquivProdLpPiLp 2 (fun _ => ℝ))
  have hΦ : MeasurePreserving (fun x => WithLp.ofLp (e x)) volume
      ((volume : Measure (Euclid d)).prod (volume : Measure (Euclid m))) := by
    have h := (WithLp.volume_preserving_ofLp (Euclid d) (Euclid m)).comp e.measurePreserving
    rw [← Measure.volume_eq_prod]
    exact h
  -- `B_ρ(0) = Φ⁻¹(Q)`, since `‖x‖² = ‖Φ(x).1‖² + ‖Φ(x).2‖²`
  set Q : Set (Euclid d × Euclid m) := {p | ‖p.1‖ ^ 2 + ‖p.2‖ ^ 2 < ρ ^ 2}
  have hQ : MeasurableSet Q :=
    (isOpen_lt (by fun_prop) (by fun_prop)).measurableSet
  have hpre : (fun x => WithLp.ofLp (e x)) ⁻¹' Q = ball (0 : Euclid (d + m)) ρ := by
    ext x
    simp only [mem_preimage, mem_ofPred_eq, mem_ball_zero_iff, Q]
    have hn : ‖x‖ ^ 2 = ‖(WithLp.ofLp (e x)).1‖ ^ 2 + ‖(WithLp.ofLp (e x)).2‖ ^ 2 := by
      rw [← e.norm_map x, WithLp.prod_norm_sq_eq_of_L2]
      rfl
    rw [← hn]
    exact sq_lt_sq₀ (norm_nonneg x) hρ
  -- Tonelli, and the slice of `Q` over `σ` is `B_{√(ρ² − ‖σ‖²)}(0)`
  rw [← hpre, hΦ.measure_preimage hQ.nullMeasurableSet, Measure.prod_apply hQ]
  refine lintegral_congr fun σ => ?_
  congr 1
  ext v
  simp only [mem_preimage, mem_ofPred_eq, mem_ball_zero_iff, Q]
  rw [Real.lt_sqrt (norm_nonneg v)]
  constructor <;> intro h <;> linarith

/-- **Simon 7.3.5** (chapter-07.txt lines 407–417, proof left to the reader): the density step
for a product `[[L]] × S₀`, with `d = dim L`.  If `f(0) = 0` and `f(r)/(ωₘrᵐ) → θ` as `r ↓ 0`, then
`(ω_{d+m}ρ^{d+m})⁻¹ ∫_{ℝᵈ} f(√(ρ² − |σ|²)) dσ → θ` as `ρ ↓ 0`.  Every radius `√(ρ² − |σ|²)`
lies in `[0, ρ]`, so for `a' < θ < b'` the hypothesis gives `a'·Lᵐ(B_r) ≤ f(r) ≤ b'·Lᵐ(B_r)` for
all small `r ≥ 0`.  Integrating in `σ` and using the slice identity
`∫_{ℝᵈ} Lᵐ(B_{√(ρ² − |σ|²)}) dσ = L^{d+m}(B_ρ) = ω_{d+m}ρ^{d+m}` bounds the ratio between `a'`
and `b'` for all small `ρ > 0`; no measurability of `f` is needed. -/
theorem Submission.dimred_cs_psd_radial_density : ∀ (d m : ℕ) (f : ℝ → ℝ≥0∞) (θ : ℝ≥0∞), f 0 = 0 → Tendsto (fun r : ℝ => f r / (unitBallVolume m * ENNReal.ofReal (r ^ m))) (𝓝[>] 0) (𝓝 θ) → Tendsto (fun ρ : ℝ => (∫⁻ σ : Euclid d, f (Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2))) / (unitBallVolume (d + m) * ENNReal.ofReal (ρ ^ (d + m)))) (𝓝[>] 0) (𝓝 θ) := by
  intro d m f θ hf0 hlim
  -- `Lᵏ(B_r(0)) = ωₖrᵏ` for `r > 0`, with `0 < ωₖ < ∞`
  have hvol : ∀ (k : ℕ) (r : ℝ), 0 < r →
      volume (ball (0 : Euclid k) r) = unitBallVolume k * ENNReal.ofReal (r ^ k) := by
    intro k r hr
    rw [Measure.addHaar_ball_of_pos volume (0 : Euclid k) hr, finrank_euclideanSpace_fin, mul_comm]
    rfl
  have hω0 : ∀ k : ℕ, unitBallVolume k ≠ 0 := fun k =>
    (measure_ball_pos volume (0 : Euclid k) one_pos).ne'
  have hωt : ∀ k : ℕ, unitBallVolume k ≠ ⊤ := fun k => measure_ball_lt_top.ne
  have hc0 : ∀ (k : ℕ) (r : ℝ), 0 < r → unitBallVolume k * ENNReal.ofReal (r ^ k) ≠ 0 := by
    intro k r hr
    exact mul_ne_zero (hω0 k) (ENNReal.ofReal_pos.2 (pow_pos hr k)).ne'
  have hct : ∀ (k : ℕ) (r : ℝ), unitBallVolume k * ENNReal.ofReal (r ^ k) ≠ ⊤ := fun k r =>
    ENNReal.mul_ne_top (hωt k) ENNReal.ofReal_ne_top
  -- the comparison profile `v(r) = Lᵐ(B_r(0))`, with `v(0) = 0 = f(0)`
  set v : ℝ → ℝ≥0∞ := fun r => volume (ball (0 : Euclid m) r) with hv
  have hv0 : v 0 = 0 := by simp [hv]
  -- slice identity: `∫_{ℝᵈ} v(√(ρ² − |σ|²)) dσ = ω_{d+m}ρ^{d+m}`
  have hslice : ∀ ρ : ℝ, 0 < ρ → ∫⁻ σ : Euclid d, v (Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2)) =
      unitBallVolume (d + m) * ENNReal.ofReal (ρ ^ (d + m)) := by
    intro ρ hρ
    rw [← hvol _ _ hρ, Submission.dimred_cs_psd_ball_volume_slice d m ρ hρ.le]
  -- every radius `√(ρ² − |σ|²)` lies in `[0, ρ]`
  have hsq_le : ∀ ρ : ℝ, 0 < ρ → ∀ σ : Euclid d, Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2) ≤ ρ := by
    intro ρ hρ σ
    calc Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2) ≤ Real.sqrt (ρ ^ 2) :=
          Real.sqrt_le_sqrt (by nlinarith [norm_nonneg σ])
      _ = ρ := Real.sqrt_sq hρ.le
  refine tendsto_order.2 ⟨fun a ha => ?_, fun b hb => ?_⟩
  · -- lower bound: `a'·v ≤ f` on `[0, s)` integrates to `a' ≤` the ratio for `ρ ∈ (0, s)`
    obtain ⟨a', haa', ha'θ⟩ := exists_between ha
    have h1 : ∀ᶠ r in 𝓝[>] (0 : ℝ), a' < f r / (unitBallVolume m * ENNReal.ofReal (r ^ m)) :=
      (tendsto_order.1 hlim).1 a' ha'θ
    obtain ⟨s, hs, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1 h1
    filter_upwards [Ioo_mem_nhdsGT hs] with ρ hρ
    have hbound : ∀ σ : Euclid d, a' * v (Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2)) ≤
        f (Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2)) := by
      intro σ
      rcases (Real.sqrt_nonneg (ρ ^ 2 - ‖σ‖ ^ 2)).eq_or_lt with h | h
      · rw [← h, hv0, mul_zero]
        exact zero_le
      · have hr : Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2) ∈ Ioo 0 s :=
          ⟨h, lt_of_le_of_lt (hsq_le ρ hρ.1 σ) hρ.2⟩
        have h2 := hsub hr
        simp only [mem_ofPred_eq] at h2
        rw [ENNReal.lt_div_iff_mul_lt (Or.inl (hc0 m _ h)) (Or.inl (hct m _))] at h2
        rw [hv]
        simp only
        rw [hvol m _ h]
        exact h2.le
    have hint := lintegral_mono (μ := (volume : Measure (Euclid d))) hbound
    rw [lintegral_const_mul' _ _ (ne_top_of_lt ha'θ), hslice ρ hρ.1] at hint
    calc a < a' := haa'
      _ = a' * (unitBallVolume (d + m) * ENNReal.ofReal (ρ ^ (d + m))) /
            (unitBallVolume (d + m) * ENNReal.ofReal (ρ ^ (d + m))) :=
          (ENNReal.mul_div_cancel_right (hc0 _ _ hρ.1) (hct _ _)).symm
      _ ≤ _ := ENNReal.div_le_div_right hint _
  · -- upper bound: `f ≤ b'·v` on `[0, s)` integrates to the ratio `≤ b'` for `ρ ∈ (0, s)`
    obtain ⟨b', hθb', hb'b⟩ := exists_between hb
    have h1 : ∀ᶠ r in 𝓝[>] (0 : ℝ), f r / (unitBallVolume m * ENNReal.ofReal (r ^ m)) < b' :=
      (tendsto_order.1 hlim).2 b' hθb'
    obtain ⟨s, hs, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1 h1
    filter_upwards [Ioo_mem_nhdsGT hs] with ρ hρ
    have hbound : ∀ σ : Euclid d, f (Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2)) ≤
        b' * v (Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2)) := by
      intro σ
      rcases (Real.sqrt_nonneg (ρ ^ 2 - ‖σ‖ ^ 2)).eq_or_lt with h | h
      · rw [← h, hf0]
        exact zero_le
      · have hr : Real.sqrt (ρ ^ 2 - ‖σ‖ ^ 2) ∈ Ioo 0 s :=
          ⟨h, lt_of_le_of_lt (hsq_le ρ hρ.1 σ) hρ.2⟩
        have h2 := hsub hr
        simp only [mem_ofPred_eq] at h2
        rw [ENNReal.div_lt_iff (Or.inl (hc0 m _ h)) (Or.inl (hct m _))] at h2
        rw [hv]
        simp only
        rw [hvol m _ h]
        exact h2.le
    have hint := lintegral_mono (μ := (volume : Measure (Euclid d))) hbound
    rw [lintegral_const_mul' _ _ (ne_top_of_lt hb'b), hslice ρ hρ.1] at hint
    calc _ ≤ b' * (unitBallVolume (d + m) * ENNReal.ofReal (ρ ^ (d + m))) /
            (unitBallVolume (d + m) * ENNReal.ofReal (ρ ^ (d + m))) :=
          ENNReal.div_le_div_right hint _
      _ = b' := ENNReal.mul_div_cancel_right (hc0 _ _ hρ.1) (hct _ _)
      _ < b := hb'b
/-- For a nondecreasing `f : ℝ → [0, ∞]`, `∫_{ℝᵈ} f(√(ε² − |σ|²)) dσ ≠ 0` for every `ε > 0` iff
`f(ε) ≠ 0` for every `ε > 0`.  Every radius `√(ε² − |σ|²)` lies in `[0, ε]`, so `f(ε) = 0` kills
the integrand; conversely the integrand is `≥ f(ε/2)` on `B_{ε/2}(0)`, a ball of positive
Lebesgue measure. -/
theorem Submission.dimred_cs_psd_radial_support : ∀ (d : ℕ) (f : ℝ → ℝ≥0∞), Monotone f → ((∀ ε : ℝ, 0 < ε → (∫⁻ σ : Euclid d, f (Real.sqrt (ε ^ 2 - ‖σ‖ ^ 2))) ≠ 0) ↔ ∀ ε : ℝ, 0 < ε → f ε ≠ 0) := by
  intro d f hf
  constructor
  · -- (⇒) if `f(ε) = 0`, then `0 ≤ f(√(ε² − |σ|²)) ≤ f(ε) = 0` for every `σ`
    intro h ε hε hfε
    apply h ε hε
    have hz : ∀ σ : Euclid d, f (Real.sqrt (ε ^ 2 - ‖σ‖ ^ 2)) = 0 := by
      intro σ
      refine le_antisymm ?_ zero_le
      calc f (Real.sqrt (ε ^ 2 - ‖σ‖ ^ 2)) ≤ f ε := by
            apply hf
            calc Real.sqrt (ε ^ 2 - ‖σ‖ ^ 2) ≤ Real.sqrt (ε ^ 2) :=
                  Real.sqrt_le_sqrt (by nlinarith [norm_nonneg σ])
              _ = ε := Real.sqrt_sq hε.le
        _ = 0 := hfε
    simp [hz]
  · -- (⇐) the integral is `≥ f(ε/2) · Lᵈ(B_{ε/2}(0))`, a product of nonzero factors
    intro h ε hε h0
    have hε2 : 0 < ε / 2 := by linarith
    have hle : ∀ σ : Euclid d, (ball (0 : Euclid d) (ε / 2)).indicator (fun _ => f (ε / 2)) σ ≤
        f (Real.sqrt (ε ^ 2 - ‖σ‖ ^ 2)) := by
      intro σ
      by_cases hσ : σ ∈ ball (0 : Euclid d) (ε / 2)
      · rw [indicator_of_mem hσ]
        apply hf
        rw [mem_ball_zero_iff] at hσ
        rw [Real.le_sqrt hε2.le (by nlinarith [norm_nonneg σ])]
        nlinarith [norm_nonneg σ]
      · rw [indicator_of_notMem hσ]
        exact zero_le
    have hint := lintegral_mono (μ := (volume : Measure (Euclid d))) hle
    rw [h0, lintegral_indicator_const measurableSet_ball] at hint
    have hprod : f (ε / 2) * volume (ball (0 : Euclid d) (ε / 2)) = 0 := le_antisymm hint zero_le
    rcases mul_eq_zero.1 hprod with hf0 | hv0
    · exact h _ hε2 hf0
    · exact (measure_ball_pos volume (0 : Euclid d) hε2).ne' hv0

/-- Supports and densities of `[[L]] × S₀` (in the proof of **Simon 7.3.5**, chapter-07.txt
lines 410–418, which the book leaves to the reader): let `d = dim L < n`, let `R`, `R₀` represent
`S`, `S₀` in `ℝᴾ`, and put `μ = μ_R`, `μ₀ = μ_{R₀}`.  If `μ₀(ℝᴾ ∖ L^⊥) = 0` and
`μ(A) = ∫_L μ₀(A − t) dHᵈ(t)` for Borel `A`, then for `t ∈ L`, `y ∈ L^⊥` and `ρ > 0`,
`μ(B_ρ(t + y)) = ∫_{ℝᵈ} f(√(ρ² − |σ|²)) dσ` with `f(r) = μ₀(B_r(y))`.  As `f` is nondecreasing,
`μ` charges every ball about `t + y` iff `μ₀` charges every ball about `y`, i.e.
`t + y ∈ spt S ⟺ y ∈ spt S₀`.  If `(ω_{n−d} r^{n−d})⁻¹ f(r) → θ` as `r ↓ 0`, then
`(ωₙρⁿ)⁻¹ μ(B_ρ(t + y)) → θ`, as `d + (n − d) = n`; so a density of `S₀` at `y` is one of `S`
at `t + y`, and, densities being unique, `S₀` having a density at `y` gives the converse. -/
theorem Submission.dimred_cs_product_support_density : ∀ (P n : ℕ) (L : Submodule ℝ (Euclid P)) (S : GeometricCurrentOn (univ : Set (Euclid P)) n) (S₀ : GeometricCurrentOn (univ : Set (Euclid P)) (n - Module.finrank ℝ L)) (R : IMRep (univ : Set (Euclid P)) n) (R₀ : IMRep (univ : Set (Euclid P)) (n - Module.finrank ℝ L)), Module.finrank ℝ L < n → R.Represents S → R₀.Represents S₀ → R₀.measure (Lᗮ : Set (Euclid P))ᶜ = 0 → (∀ A : Set (Euclid P), MeasurableSet A → R.measure A = ∫⁻ t in (L : Set (Euclid P)), R₀.measure ((fun y => t + y) ⁻¹' A) ∂μHE[Module.finrank ℝ L]) → (∀ y ∈ Lᗮ, ∃ θ : ℝ, HasMassDensity S₀ y θ) → (∀ t ∈ L, ∀ y ∈ Lᗮ, (t + y ∈ S.support ↔ y ∈ S₀.support)) ∧ ∀ t ∈ L, ∀ y ∈ Lᗮ, ∀ θ : ℝ, (HasMassDensity S (t + y) θ ↔ HasMassDensity S₀ y θ) := by
  intro P n L S S₀ R R₀ hdn hR hR₀ hconc hprod hdens
  -- `M_W(S) = μ(W)` and `M_W(S₀) = μ₀(W)` for open `W`; supports are read off from balls
  obtain ⟨hmS, hsS, -⟩ := Submission.dimred_im_mass_measure P n univ S R isOpen_univ hR
  obtain ⟨hmS₀, hsS₀, -⟩ :=
    Submission.dimred_im_mass_measure P (n - Module.finrank ℝ L) univ S₀ R₀ isOpen_univ hR₀
  -- slicing: `μ(B_ρ(t + y)) = ∫_{ℝᵈ} μ₀(B_{√(ρ² − |σ|²)}(y)) dσ`
  have hball := Submission.dimred_cs_psd_ball_formula P L R.measure R₀.measure hconc hprod
  refine ⟨fun t ht y hy => ?_, fun t ht y hy θ => ?_⟩
  · -- supports, via the nondecreasing profile `r ↦ μ₀(B_r(y))`
    have hmono : Monotone fun r : ℝ => R₀.measure (ball y r) :=
      fun a b hab => measure_mono (ball_subset_ball hab)
    rw [hsS _ (mem_univ _), hsS₀ _ (mem_univ _),
      ← Submission.dimred_cs_psd_radial_support (Module.finrank ℝ L) _ hmono]
    exact forall₂_congr fun ε hε => by rw [hball t ht y hy ε hε]
  · -- a density `a` of `S₀` at `y` is a density of `S` at `t + y`
    have key : ∀ a : ℝ, HasMassDensity S₀ y a → HasMassDensity S (t + y) a := by
      rintro a ⟨ha, hlim⟩
      refine ⟨ha, ?_⟩
      have h0 : Tendsto (fun r : ℝ => R₀.measure (ball y r) /
          (unitBallVolume (n - Module.finrank ℝ L) *
            ENNReal.ofReal (r ^ (n - Module.finrank ℝ L)))) (𝓝[>] 0) (𝓝 (ENNReal.ofReal a)) :=
        hlim.congr fun r => by rw [hmS₀ _ isOpen_ball (subset_univ _)]
      have h1 := Submission.dimred_cs_psd_radial_density (Module.finrank ℝ L)
        (n - Module.finrank ℝ L) (fun r => R₀.measure (ball y r)) _ (by simp) h0
      rw [Nat.add_sub_of_le hdn.le] at h1
      refine h1.congr' ?_
      filter_upwards [self_mem_nhdsWithin] with ρ hρ
      rw [hmS _ isOpen_ball (subset_univ _), hball t ht y hy ρ hρ]
    refine ⟨fun h => ?_, key θ⟩
    -- `S₀` has a density `Θ₀` at `y`, which is also one of `S` at `t + y`; densities are unique,
    -- as limits along `𝓝[>] 0` are unique and `ofReal` is injective on `[0, ∞)`
    obtain ⟨Θ₀, hΘ₀⟩ := hdens y hy
    have hS := key Θ₀ hΘ₀
    rwa [(ENNReal.ofReal_eq_ofReal_iff h.1 hS.1).1 (tendsto_nhds_unique h.2 hS.2)]

/-- **Simon 7.3.5** (proof left to the reader, chapter-07.txt lines 407–417), the carrier of a
competitor: let `S₁ = τ(M₁, θ₁, ξ₁)` and `S₂ = τ(M₂, θ₂, ξ₂)` in `ℝᴾ`, `μᵢ = θᵢHʲ⌞Mᵢ`, and let
`F` be closed.  If `μ₂(ℝᴾ ∖ F) = 0` and `spt(S₁ − S₂) ⊆ F`, then `μ₁(ℝᴾ ∖ F) = 0`.  A point off
`F` has a `μ₂`-null ball, so `spt S₂ ⊆ F` (`dimred_im_mass_measure`); off `F` both `S₂` and
`S₁ − S₂` vanish on open sets `W ⊂⊂ ℝᴾ`, so `S₁ = S₂ + (S₁ − S₂)` vanishes on their intersection
and `spt S₁ ⊆ F`; finally `μ₁(ℝᴾ ∖ spt S₁) = 0` (`imrep_carrier_sdiff_support_null`). -/
theorem Submission.dimred_cs_sos_mt_cm_carried_transfer : ∀ (P j : ℕ) (S₁ S₂ : GeometricCurrentOn (univ : Set (Euclid P)) j) (R₁ R₂ : IMRep (univ : Set (Euclid P)) j) (F : Set (Euclid P)), R₁.Represents S₁ → R₂.Represents S₂ → IsClosed F → R₂.measure Fᶜ = 0 → (S₁ - S₂).support ⊆ F → R₁.measure Fᶜ = 0 := by
  intro P j S₁ S₂ R₁ R₂ F hR₁ hR₂ hF hR₂F hsupp
  -- `spt S₂ ⊆ F`: a point `x ∉ F` has a ball `B_ε(x) ⊆ ℝᴾ ∖ F`, which is `μ₂`-null
  have h2 : S₂.support ⊆ F := by
    intro x hx
    by_contra hxF
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hF.isOpen_compl x hxF
    exact ((Submission.dimred_im_mass_measure P j univ S₂ R₂ isOpen_univ hR₂).2.1 x (mem_univ x)).1
      hx ε hε (measure_mono_null hball hR₂F)
  -- `spt S₁ ⊆ F`: off `F`, `S₂` vanishes on some `W₁ ⊂⊂ ℝᴾ` and `S₁ − S₂` on some `W₂ ⊂⊂ ℝᴾ`
  -- about `x`, so `S₁` vanishes on `W₁ ∩ W₂ ⊂⊂ ℝᴾ`
  have h1 : S₁.support ⊆ F := by
    intro x hx
    by_contra hxF
    have hz2 : x ∈ S₂.zeroRegion := by
      by_contra hc
      exact hxF (h2 ⟨mem_univ x, hc⟩)
    have hz3 : x ∈ (S₁ - S₂).zeroRegion := by
      by_contra hc
      exact hxF (hsupp ⟨mem_univ x, hc⟩)
    obtain ⟨W₁, ⟨hW₁o, hW₁c, hW₁U, hW₁v⟩, hxW₁⟩ := mem_sUnion.mp hz2
    obtain ⟨W₂, ⟨hW₂o, -, -, hW₂v⟩, hxW₂⟩ := mem_sUnion.mp hz3
    have hcl : closure (W₁ ∩ W₂) ⊆ closure W₁ := closure_mono inter_subset_left
    apply hx.2
    refine mem_sUnion.mpr ⟨W₁ ∩ W₂, ⟨hW₁o.inter hW₂o, hW₁c.of_isClosed_subset isClosed_closure hcl,
      hcl.trans hW₁U, ?_⟩, hxW₁, hxW₂⟩
    intro ω hω
    have e1 : S₂ ω = 0 := hW₁v ω (hω.trans inter_subset_left)
    have e2 : S₁ ω - S₂ ω = 0 := hW₂v ω (hω.trans inter_subset_right)
    linarith
  -- `μ₁(ℝᴾ ∖ spt S₁) = 0`: `μ₁ ≪ Hʲ⌞M₁` and `Hʲ(M₁ ∖ spt S₁) = 0`
  have h3 : R₁.measure (S₁.support)ᶜ = 0 := by
    apply withDensity_absolutelyContinuous
    rw [Measure.restrict_apply' R₁.measurableSet_carrier, inter_comm, ← Set.sdiff_eq]
    exact Submission.imrep_carrier_sdiff_support_null P j univ S₁ R₁ isOpen_univ hR₁
  exact measure_mono_null (compl_subset_compl.mpr h1) h3
/-- **The comparison box** (proof of Simon 7.3.5, which the book leaves to the reader).  Let
`g = (g₁, …, g_k)` be orthonormal in `ℝᴾ`, `G = span{gᵢ}`, `p = G.starProjection`,
`q = Gᗮ.starProjection`, `r < s`, `C_s = {x : |⟨gᵢ, x⟩| < s for all i}` and
`W = p⁻¹(C_s) ∩ q⁻¹(B_ρ(0))`.  Then `W` is open: `C_s` is a finite intersection of open sets, and
`p`, `q` are continuous.  A vector `t = Σ cᵢgᵢ ∈ G` has `cᵢ = ⟨gᵢ, t⟩`, so `‖t‖ ≤ Σᵢ |⟨gᵢ, t⟩|`.
Hence `‖x‖ ≤ ‖p x‖ + ‖q x‖ ≤ ks + ρ` on `W`, and `W ⊂⊂ ℝᴾ`.  Finally, `⟨gᵢ, p x⟩ = ⟨p gᵢ, x⟩ =
⟨gᵢ, x⟩`, so for `K ⊆ B_ρ(0)` the slab `{|⟨gᵢ, ·⟩| ≤ r} ∩ q⁻¹(K)` lies in `W`. -/
theorem Submission.dimred_cs_sos_mt_cm_comparison_box : ∀ (P k : ℕ) (g : Fin k → Euclid P) (r s ρ : ℝ), Orthonormal ℝ g → r < s → IsOpen ((Submodule.span ℝ (Set.range g)).starProjection ⁻¹' {x | ∀ i, |inner ℝ (g i) x| < s} ∩ (Submodule.span ℝ (Set.range g))ᗮ.starProjection ⁻¹' ball (0 : Euclid P) ρ) ∧ CompactlyContained ((Submodule.span ℝ (Set.range g)).starProjection ⁻¹' {x | ∀ i, |inner ℝ (g i) x| < s} ∩ (Submodule.span ℝ (Set.range g))ᗮ.starProjection ⁻¹' ball (0 : Euclid P) ρ) univ ∧ ∀ K : Set (Euclid P), K ⊆ ball (0 : Euclid P) ρ → {x | ∀ i, |inner ℝ (g i) x| ≤ r} ∩ (Submodule.span ℝ (Set.range g))ᗮ.starProjection ⁻¹' K ⊆ (Submodule.span ℝ (Set.range g)).starProjection ⁻¹' {x | ∀ i, |inner ℝ (g i) x| < s} ∩ (Submodule.span ℝ (Set.range g))ᗮ.starProjection ⁻¹' ball (0 : Euclid P) ρ := by
  intro P k g r s ρ hg hrs
  set G := Submodule.span ℝ (Set.range g)
  -- Step 1: `C_s = ⋂ᵢ {|⟨gᵢ, ·⟩| < s}` is open and `p`, `q` are continuous, so `W` is open
  have hCo : IsOpen {x : Euclid P | ∀ i, |inner ℝ (g i) x| < s} := by
    have hset : {x : Euclid P | ∀ i, |inner ℝ (g i) x| < s} = ⋂ i, {x | |inner ℝ (g i) x| < s} := by
      ext x; simp
    rw [hset]
    exact isOpen_iInter_of_finite fun i =>
      isOpen_lt (continuous_const.inner continuous_id).abs continuous_const
  have hWo : IsOpen (G.starProjection ⁻¹' {x | ∀ i, |inner ℝ (g i) x| < s} ∩
      Gᗮ.starProjection ⁻¹' ball (0 : Euclid P) ρ) :=
    (hCo.preimage G.starProjection.continuous).inter
      (isOpen_ball.preimage Gᗮ.starProjection.continuous)
  -- Step 2: `t = Σ cᵢgᵢ ∈ G` has `cᵢ = ⟨gᵢ, t⟩` and `‖gᵢ‖ = 1`, so `‖t‖ ≤ Σᵢ |⟨gᵢ, t⟩|`
  have hcoord : ∀ t ∈ G, ‖t‖ ≤ ∑ i, |inner ℝ (g i) t| := by
    intro t ht
    obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).1 ht
    calc ‖∑ i, c i • g i‖ ≤ ∑ i, ‖c i • g i‖ := norm_sum_le _ _
      _ = ∑ i, |inner ℝ (g i) (∑ j, c j • g j)| := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [norm_smul, hg.1 i, mul_one, hg.inner_right_fintype c i, Real.norm_eq_abs]
  -- Step 3: on `W`, `‖x‖ ≤ ‖p x‖ + ‖q x‖ ≤ ks + ρ`, so `W` is bounded
  have hbdd : Bornology.IsBounded (G.starProjection ⁻¹' {x | ∀ i, |inner ℝ (g i) x| < s} ∩
      Gᗮ.starProjection ⁻¹' ball (0 : Euclid P) ρ) := by
    rw [isBounded_iff_subset_closedBall 0]
    refine ⟨k * s + ρ, fun x hx => ?_⟩
    rw [mem_closedBall, dist_zero_right]
    have h1 : ‖G.starProjection x‖ ≤ k * s := by
      calc ‖G.starProjection x‖ ≤ ∑ i, |inner ℝ (g i) (G.starProjection x)| :=
            hcoord _ (G.starProjection_apply_mem x)
        _ ≤ ∑ _i : Fin k, s := Finset.sum_le_sum fun i _ => (hx.1 i).le
        _ = k * s := by simp
    have h2 : ‖Gᗮ.starProjection x‖ < ρ := by simpa using hx.2
    calc ‖x‖ = ‖G.starProjection x + Gᗮ.starProjection x‖ := by
          rw [G.starProjection_add_starProjection_orthogonal]
      _ ≤ ‖G.starProjection x‖ + ‖Gᗮ.starProjection x‖ := norm_add_le _ _
      _ ≤ k * s + ρ := by linarith
  -- Step 4: `ℝᴾ` is proper, so the bounded set `W` has compact closure
  refine ⟨hWo, ⟨hbdd.isCompact_closure, subset_univ _⟩, ?_⟩
  -- Step 5: `⟨gᵢ, p x⟩ = ⟨p gᵢ, x⟩ = ⟨gᵢ, x⟩`, so the slab over `K ⊆ B_ρ(0)` lies in `W`
  intro K hK x hx
  refine ⟨fun i => ?_, hK hx.2⟩
  have hgi : inner ℝ (g i) (G.starProjection x) = inner ℝ (g i) x := by
    rw [← G.inner_starProjection_left_eq_right,
      G.starProjection_eq_self_iff.mpr (Submodule.subset_span ⟨i, rfl⟩)]
  rw [hgi]
  exact (hx.1 i).trans_lt hrs

/-- **A norming field bounds `μ(W')` by the mass `M_W(T)`** (the inequality `μ_T(W') ≤ M_W(T)`
behind Simon 6.2.8, `μ_T(W) = M_W(T)`, for the representation 6.2.7 `T(ω) = ∫ ⟨ω, ξ⟩ dμ`;
`|·|_E` is `covectorEuclideanNorm`).  Let `W' ⊂⊂ U` be open with `W' ⊆ W`.  Then `ν = μ⌞W'` is
finite, as `closure W'` is a compact subset of `U`, and the bounded field `β` is `ν`-integrable.
For `ε > 0`, `Submission.rsd_mw_exists_testForm_approx` gives a test form `ω` with
`tsupport ω ⊆ W'`, `|ω|_E ≤ 1` and `∫ |ω − β|_E dν < ε`, so `ω` is admissible for `M_W(T)`.
The function `f = ξ(ω)` vanishes off `W'`, so `T(ω) = ∫ f dν`; and `ν`-a.e.
`1 − f = ξ(β − ω) ≤ |ω − β|_E`, since `ξ(β) = 1` and `|ξ(α)| ≤ |α|_E`.  Hence
`μ(W') − T(ω) = ∫ (1 − f) dν < ε`, and `μ(W') ≤ M_W(T) + ε` for every `ε > 0`. -/
theorem Submission.cmrc_measure_le_massOn_of_norming : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n) (β : Euclid P → Covector (Euclid P) n), (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → AEStronglyMeasurable ξ μ → (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) → AEStronglyMeasurable β μ → (∃ C : ℝ, ∀ x, ‖β x‖ ≤ C) → (∀ x, covectorEuclideanNorm (β x) ≤ 1) → (∀ᵐ x ∂μ, ξ x (β x) = 1) → ∀ W W' : Set (Euclid P), IsOpen W' → CompactlyContained W' U → W' ⊆ W → μ W' ≤ T.massOn W := by
  intro P n U T μ ξ β hμK hξm hξ1 hT hβm hβC hβ1 hξβ W W' hW' hW'U hW'W
  -- `N := covectorEuclideanNorm`, `ν := μ⌞W'`
  -- Step 1: `ν` is finite (`closure W'` is a compact subset of `U`) and `ν(W'ᶜ) = 0`
  have hμW' : μ W' < ∞ := (measure_mono subset_closure).trans_lt (hμK _ hW'U.1 hW'U.2)
  have : IsFiniteMeasure (μ.restrict W') := isFiniteMeasure_restrict.2 hμW'.ne
  have hνc : μ.restrict W' W'ᶜ = 0 := by
    rw [Measure.restrict_apply hW'.measurableSet.compl, compl_inter_self, measure_empty]
  -- Step 2: `β` is bounded, hence `ν`-integrable
  obtain ⟨C, hC⟩ := hβC
  have hβi : Integrable β (μ.restrict W') :=
    Integrable.of_bound hβm.restrict C (Eventually.of_forall hC)
  refine ENNReal.le_of_forall_pos_le_add fun ε hε _ => ?_
  -- Step 3: a test form `ω₀` with `tsupport ω₀ ⊆ W'`, `N(ω₀) ≤ 1` and `∫ N(ω₀ - β) dν < ε`
  obtain ⟨ω₀, hω₀, hω₀W', hω₀1, hω₀β⟩ := Submission.rsd_mw_exists_testForm_approx P n
    (μ.restrict W') W' β inferInstance hW' hνc hβi (Eventually.of_forall hβ1) ε
    (NNReal.coe_pos.2 hε)
  -- Step 4: `ω₀ ∈ 𝒟ⁿ(U)` is admissible for `M_W(T)`, so `T(ω₀) ≤ M_W(T)`
  let ω : TestFormOn U n := ⟨ω₀, hω₀, hω₀W'.trans (subset_closure.trans hW'U.2)⟩
  have hTω : ENNReal.ofReal (T ω) ≤ T.massOn W := T.le_massOn ⟨hω₀W'.trans hW'W, hω₀1⟩
  -- Step 5: `f = ξ(ω₀)` vanishes off `W'`, so `T(ω₀) = ∫ f dν`
  set f : Euclid P → ℝ := fun x => ξ x (ω₀ x) with hf
  have hTf : T ω = ∫ x, f x ∂(μ.restrict W') := by
    rw [hT ω, setIntegral_eq_integral_of_forall_compl_eq_zero fun x hx => ?_]
    simp [hf, image_eq_zero_of_notMem_tsupport fun h => hx (hω₀W' h)]
  -- Step 6: `|f| ≤ N(ω₀) ≤ 1`, so `f` is `ν`-integrable
  have hf1 : ∀ x, |f x| ≤ 1 := fun x => (hξ1 x (ω₀ x)).trans (hω₀1 x)
  have hfm : AEStronglyMeasurable f μ :=
    isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable
      (hξm.prodMk hω₀.1.continuous.aestronglyMeasurable)
  have hfi : Integrable f (μ.restrict W') :=
    Integrable.of_bound hfm.restrict 1 (Eventually.of_forall fun x => by
      simpa [Real.norm_eq_abs] using hf1 x)
  -- Step 7: `ν`-a.e., `1 - f = ξ(β - ω₀) ≤ N(ω₀ - β)`, since `ξ(β) = 1` and `|ξ(α)| ≤ N(α)`
  have hle : ∀ᵐ x ∂(μ.restrict W'), 1 - f x ≤ covectorEuclideanNorm (ω₀ x - β x) := by
    filter_upwards [ae_restrict_of_ae hξβ] with x hx
    have h := abs_le.1 (hξ1 x (ω₀ x - β x))
    rw [map_sub, hx] at h
    linarith [h.1]
  -- Step 8: `μ(W') - T(ω₀) = ∫ (1 - f) dν ≤ ∫ N(ω₀ - β) dν < ε`
  have hint : ENNReal.ofReal (μ.real W' - T ω) < ENNReal.ofReal ε := by
    have h1 : ∫ x, (1 - f x) ∂(μ.restrict W') = μ.real W' - T ω := by
      rw [integral_sub (integrable_const 1) hfi, integral_const, hTf, smul_eq_mul, mul_one,
        measureReal_restrict_apply_univ]
    have hgi : Integrable (fun x => 1 - f x) (μ.restrict W') := (integrable_const 1).sub hfi
    rw [← h1, ofReal_integral_eq_lintegral_ofReal hgi
      (Eventually.of_forall fun x => sub_nonneg.2 (le_of_abs_le (hf1 x)))]
    exact (lintegral_mono_ae (hle.mono fun x hx => ENNReal.ofReal_le_ofReal hx)).trans_lt hω₀β
  -- Step 9: `μ(W') ≤ T(ω₀) + ε ≤ M_W(T) + ε`
  calc μ W' = ENNReal.ofReal (T ω + (μ.real W' - T ω)) := by
        rw [add_sub_cancel, ofReal_measureReal hμW'.ne]
    _ ≤ ENNReal.ofReal (T ω) + ENNReal.ofReal (μ.real W' - T ω) := ENNReal.ofReal_add_le
    _ ≤ T.massOn W + ε := add_le_add hTω (hint.le.trans_eq ENNReal.ofReal_coe_nnreal)
/-- Exhaustion by compactly contained open sets: if `U, W ⊆ ℝᴾ` are open, `μ(ℝᴾ \ U) = 0` and
`μ(W') ≤ m` for every open `W' ⊂⊂ U` with `W' ⊆ W`, then `μ(W) ≤ m`.  The open sets
`W'ⱼ = {y : ‖y‖ < j, (j + 1)⁻¹ < infEDist y (W ∩ U)ᶜ}` have closures inside the compact sets
`{y : ‖y‖ ≤ j, (j + 1)⁻¹ ≤ infEDist y (W ∩ U)ᶜ} ⊆ W ∩ U`, increase with `j` and exhaust `W ∩ U`,
so `μ(W) = μ(W ∩ U) = supⱼ μ(W'ⱼ) ≤ m` by continuity from below. -/
theorem Submission.cmrc_measure_le_of_compactlyContained : ∀ (P : ℕ) (μ : Measure (Euclid P)) (U W : Set (Euclid P)) (m : ℝ≥0∞), IsOpen U → IsOpen W → μ Uᶜ = 0 → (∀ W' : Set (Euclid P), IsOpen W' → CompactlyContained W' U → W' ⊆ W → μ W' ≤ m) → μ W ≤ m := by
  intro P μ U W m hU hW hUc hm
  -- `V j = {y : ‖y‖ < j, (j + 1)⁻¹ < infEDist y (W ∩ U)ᶜ}` exhausts the open set `W ∩ U`
  set V : ℕ → Set (Euclid P) :=
    fun j => {y | ‖y‖ < j ∧ ((j : ℝ≥0∞) + 1)⁻¹ < infEDist y (W ∩ U)ᶜ}
  have hd : Continuous fun y : Euclid P => infEDist y (W ∩ U)ᶜ := continuous_infEDist
  have hpos : ∀ j : ℕ, 0 < ((j : ℝ≥0∞) + 1)⁻¹ := fun j => ENNReal.inv_pos.2 (by simp)
  -- `closure (V j)` lies in `F j = {y : ‖y‖ ≤ j, (j + 1)⁻¹ ≤ infEDist y (W ∩ U)ᶜ}`, a compact
  -- subset of `W ∩ U`
  have hF : ∀ j : ℕ, IsCompact (closure (V j)) ∧ closure (V j) ⊆ W ∩ U := by
    intro j
    have hVF : closure (V j) ⊆
        {y : Euclid P | ‖y‖ ≤ j ∧ ((j : ℝ≥0∞) + 1)⁻¹ ≤ infEDist y (W ∩ U)ᶜ} :=
      closure_minimal (fun y hy => ⟨hy.1.le, hy.2.le⟩)
        ((isClosed_le continuous_norm continuous_const).inter (isClosed_le continuous_const hd))
    refine ⟨(isCompact_closedBall (0 : Euclid P) (j : ℝ)).of_isClosed_subset isClosed_closure
      fun y hy => ?_, fun y hy => ?_⟩
    · rw [mem_closedBall, dist_zero_right]
      exact (hVF hy).1
    · by_contra hy'
      have h := (hVF hy).2
      rw [infEDist_zero_of_mem hy'] at h
      exact (hpos j).not_ge h
  have hVsub : ∀ j, V j ⊆ W ∩ U := fun j => subset_closure.trans (hF j).2
  have hVm : ∀ j, μ (V j) ≤ m := fun j =>
    hm (V j) ((isOpen_lt continuous_norm continuous_const).inter (isOpen_lt continuous_const hd))
      ⟨(hF j).1, (hF j).2.trans inter_subset_right⟩ ((hVsub j).trans inter_subset_left)
  have hmono : Monotone V := by
    intro j k hjk y hy
    refine ⟨hy.1.trans_le (by exact_mod_cast hjk), lt_of_le_of_lt ?_ hy.2⟩
    gcongr
  have hUnion : ⋃ j, V j = W ∩ U := by
    refine Subset.antisymm (iUnion_subset hVsub) fun y hy => ?_
    have hne : infEDist y (W ∩ U)ᶜ ≠ 0 := fun h0 =>
      ((mem_iff_infEDist_zero_of_closed (hW.inter hU).isClosed_compl).2 h0) hy
    obtain ⟨j₁, hj₁⟩ := ENNReal.exists_inv_nat_lt hne
    obtain ⟨j₂, hj₂⟩ := exists_nat_gt ‖y‖
    refine mem_iUnion.2 ⟨max j₁ j₂, hj₂.trans_le (by exact_mod_cast le_max_right j₁ j₂),
      lt_of_le_of_lt ?_ hj₁⟩
    gcongr
    norm_cast
    omega
  -- `μ W = μ (W ∩ U)` since `μ Uᶜ = 0`; continuity from below along the increasing `V j`
  calc μ W = μ (⋃ j, V j) := by rw [hUnion, measure_inter_conull hUc]
    _ = ⨆ j, μ (V j) := hmono.measure_iUnion
    _ ≤ m := iSup_le hVm

/-- **Mass of the current `Ξ(ω) = ∫ ⟨ω, ζ₀⟩ dν` with a constant multivector `ζ₀`** (Simon 6.2.5;
step 5(δ) of the integer-multiplicity criterion for cycles; `|·|_E` is `covectorEuclideanNorm`).
Suppose `ν` is finite on compact sets, `|⟨α, ζ₀⟩| ≤ s |α|_E` for every `α`, and `⟨β, ζ₀⟩ = s` for
some `β` with `|β|_E ≤ 1`.  Then `s ≥ 0`, because `|s| = |⟨β, ζ₀⟩| ≤ s |β|_E`.  Put `μ = s ν` and
`ξ ≡ s⁻¹ ζ₀`.  Then `|⟨α, ξ⟩| ≤ |α|_E` and `Ξ(ω) = ∫ ⟨ω, ξ⟩ dμ`; for `s = 0` both sides vanish,
since then `ζ₀ = 0`.  `Submission.cmrc_massOn_le_of_repr` gives `M_W(Ξ) ≤ μ(W) = s ν(W)`.  For
`s > 0` the constant field `β` norms `ξ`, as `⟨β, ξ⟩ = 1`.  So
`Submission.cmrc_measure_le_massOn_of_norming` gives `μ(W') ≤ M_W(Ξ)` for every open `W' ⊂⊂ ℝᴾ`
with `W' ⊆ W`, and `Submission.cmrc_measure_le_of_compactlyContained` gives `μ(W) ≤ M_W(Ξ)`. -/
theorem Submission.cbr_ci_const_vector_massOn : ∀ (P m : ℕ) (ν : Measure (Euclid P)) (ζ₀ : MultiVector P m) (s : ℝ) (Ξ : GeometricCurrentOn (univ : Set (Euclid P)) m), (∀ K : Set (Euclid P), IsCompact K → ν K < ∞) → (∀ α : Covector (Euclid P) m, |ζ₀ α| ≤ s * covectorEuclideanNorm α) → (∃ β : Covector (Euclid P) m, covectorEuclideanNorm β ≤ 1 ∧ ζ₀ β = s) → (∀ ω : TestFormOn (univ : Set (Euclid P)) m, Ξ ω = ∫ x, ζ₀ ((ω : DifferentialForm (Euclid P) m) x) ∂ν) → ∀ W : Set (Euclid P), IsOpen W → Ξ.massOn W = ENNReal.ofReal s * ν W := by
  rintro P m ν ζ₀ s Ξ hνK hζ₀ ⟨β, hβ1, hζβ⟩ hΞ W hW
  -- Step 1: `s ≥ 0`, since `|s| = |⟨β, ζ₀⟩| ≤ s |β|_E`
  have hs : 0 ≤ s := by
    have h := hζ₀ β
    rw [hζβ] at h
    nlinarith [neg_le_abs s, covectorEuclideanNorm_nonneg β]
  -- Step 2: `ζ₀ = s (s⁻¹ ζ₀)`; for `s = 0` this says `ζ₀ = 0`, as `|⟨α, ζ₀⟩| ≤ 0`
  have hζs : ∀ α : Covector (Euclid P) m, s * (s⁻¹ * ζ₀ α) = ζ₀ α := by
    intro α
    rcases hs.eq_or_lt with h0 | hpos
    · have h := hζ₀ α
      rw [← h0, zero_mul, abs_nonpos_iff] at h
      rw [← h0, zero_mul, h]
    · rw [← mul_assoc, mul_inv_cancel₀ hpos.ne', one_mul]
  -- Step 3: the constant field `ξ ≡ s⁻¹ ζ₀` is unit-bounded, `|⟨α, ξ⟩| ≤ |α|_E`
  have hξ : ∀ (_ : Euclid P) (α : Covector (Euclid P) m),
      |(s⁻¹ • ζ₀) α| ≤ covectorEuclideanNorm α := by
    intro _ α
    rw [_root_.smul_apply, smul_eq_mul, abs_mul, abs_inv]
    rcases hs.eq_or_lt with h0 | hpos
    · rw [← h0, abs_zero, inv_zero, zero_mul]
      exact covectorEuclideanNorm_nonneg α
    · rw [abs_of_pos hpos, inv_mul_le_iff₀ hpos]
      exact hζ₀ α
  -- Step 4: `Ξ(ω) = ∫ ⟨ω, ξ⟩ dμ` for `μ = s ν`
  have hrep : ∀ ω : TestFormOn (univ : Set (Euclid P)) m, Ξ ω =
      ∫ x, (s⁻¹ • ζ₀) ((ω : DifferentialForm (Euclid P) m) x) ∂(ENNReal.ofReal s • ν) := by
    intro ω
    rw [hΞ ω, integral_smul_measure, ENNReal.toReal_ofReal hs, smul_eq_mul,
      ← integral_const_mul]
    simp only [_root_.smul_apply, smul_eq_mul, hζs]
  have hμW : (ENNReal.ofReal s • ν) W = ENNReal.ofReal s * ν W := by
    rw [Measure.smul_apply, smul_eq_mul]
  rw [← hμW]
  -- Step 5: upper bound `M_W(Ξ) ≤ μ(W)`
  refine le_antisymm (Submission.cmrc_massOn_le_of_repr P m univ Ξ (ENNReal.ofReal s • ν)
    (fun _ => s⁻¹ • ζ₀) hξ hrep W) ?_
  -- Step 6: lower bound `μ(W) ≤ M_W(Ξ)`; trivial for `s = 0`, where `μ = 0`
  rcases hs.eq_or_lt with h0 | hpos
  · rw [← h0, ENNReal.ofReal_zero, zero_smul, Measure.coe_zero, Pi.zero_apply]
    exact zero_le
  -- for `s > 0`, `μ` is finite on compact sets and the constant covector `β` norms `ξ`:
  -- `⟨β, ξ⟩ = s⁻¹ ⟨β, ζ₀⟩ = 1`
  have hμK : ∀ K : Set (Euclid P), IsCompact K → K ⊆ univ → (ENNReal.ofReal s • ν) K < ∞ := by
    intro K hK _
    rw [Measure.smul_apply, smul_eq_mul]
    exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top (hνK K hK)
  have hξβ : ∀ᵐ _ ∂(ENNReal.ofReal s • ν), (s⁻¹ • ζ₀) β = 1 := Eventually.of_forall fun _ => by
    rw [_root_.smul_apply, smul_eq_mul, hζβ, inv_mul_cancel₀ hpos.ne']
  -- `μ(W') ≤ M_W(Ξ)` for open `W' ⊂⊂ ℝᴾ` with `W' ⊆ W`; exhaust `W` by such `W'`
  refine Submission.cmrc_measure_le_of_compactlyContained P (ENNReal.ofReal s • ν) univ W
    (Ξ.massOn W) isOpen_univ hW (by rw [compl_univ, measure_empty]) fun W' hW' hW'U hW'W => ?_
  exact Submission.cmrc_measure_le_massOn_of_norming P m univ Ξ (ENNReal.ofReal s • ν)
    (fun _ => s⁻¹ • ζ₀) (fun _ => β) hμK aestronglyMeasurable_const hξ hrep
    aestronglyMeasurable_const ⟨‖β‖, fun _ => le_rfl⟩ (fun _ => hβ1) hξβ W W' hW' hW'U hW'W

/-- **Hausdorff measure of the affine plane through `a` spanned by an orthonormal frame `w`**
(Simon Ch. 1, 2.9, `Hᵐ = Lᵐ` on `ℝᵐ`, transported by an isometry; step 0 of the integer
multiplicity criterion for plane cycles).  Let `S = {y | y − a ∈ span w}`.  Orthonormality gives
`‖Σᵢ cᵢ wᵢ‖ = ‖c‖`, so `J(u) = a + Σᵢ uᵢ wᵢ` is an isometry of `Euclid m` onto `S`.  Hence
`J_*(Lᵐ) = J_*(Hᵐ) = Hᵐ⌞S`, and composing with the volume-preserving `toLp : ℝᵐ → Euclid m`
gives (i).  `S` is the preimage of the closed finite-dimensional subspace `span w` under
`y ↦ y − a`.  For compact `K`, `(Hᵐ⌞S)(K) = Lᵐ(J⁻¹K) < ∞`, as `J` is a closed embedding; and
`(Hᵐ⌞S)(B_r(a)) = Lᵐ(J⁻¹B_r(a)) > 0`, as `J⁻¹B_r(a)` is open and contains `0`. -/
theorem Submission.cbr_cipi_affine_plane_measure : ∀ (P m : ℕ) (w : Fin m → Euclid P) (a : Euclid P), Orthonormal ℝ w → Measure.map (fun z : Fin m → ℝ => a + ∑ i, z i • w i) volume = (μHE[m] : Measure (Euclid P)).restrict {y : Euclid P | y - a ∈ Submodule.span ℝ (Set.range w)} ∧ IsClosed {y : Euclid P | y - a ∈ Submodule.span ℝ (Set.range w)} ∧ (∀ K : Set (Euclid P), IsCompact K → ((μHE[m] : Measure (Euclid P)).restrict {y : Euclid P | y - a ∈ Submodule.span ℝ (Set.range w)}) K < ∞) ∧ ∀ r : ℝ, 0 < r → 0 < ((μHE[m] : Measure (Euclid P)).restrict {y : Euclid P | y - a ∈ Submodule.span ℝ (Set.range w)}) (ball a r) := by
  intro P m w a hw
  set S : Set (Euclid P) := {y : Euclid P | y - a ∈ Submodule.span ℝ (Set.range w)} with hS
  -- Step 1: `J(u) = a + Σᵢ uᵢ wᵢ` is an isometry, as `‖Σᵢ cᵢ wᵢ‖ = ‖c‖` by orthonormality
  set J : Euclid m → Euclid P := fun u => a + ∑ i, u i • w i
  have hnorm : ∀ c : Euclid m, ‖∑ i, c i • w i‖ = ‖c‖ := by
    intro c
    have h1 : ‖∑ i, c i • w i‖ ^ 2 = ‖c‖ ^ 2 := by
      rw [← real_inner_self_eq_norm_sq, hw.inner_sum, EuclideanSpace.real_norm_sq_eq]
      simp [sq]
    exact (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp h1
  have hJ : Isometry J := by
    refine Isometry.of_dist_eq fun u u' => ?_
    rw [dist_eq_norm, dist_eq_norm, ← hnorm (u - u')]
    simp [J, sub_smul, Finset.sum_sub_distrib]
  -- Step 2: `range J = S`, as `y − a ∈ span w` iff `y − a = Σᵢ cᵢ wᵢ` for some `c`
  have hrange : range J = S := by
    ext y
    rw [hS, mem_range, mem_ofPred_eq, Submodule.mem_span_range_iff_exists_fun]
    constructor
    · rintro ⟨u, rfl⟩
      exact ⟨fun i => u i, by simp [J]⟩
    · rintro ⟨c, hc⟩
      exact ⟨WithLp.toLp 2 c, by simp [J, hc]⟩
  -- Step 3: `J_*(Lᵐ) = J_*(Hᵐ) = Hᵐ⌞S`
  have hJm : Measurable J := hJ.continuous.measurable
  have hmapJ : Measure.map J volume = (μHE[m] : Measure (Euclid P)).restrict S := by
    rw [← hrange, ← hJ.map_euclideanHausdorffMeasure,
      EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
  refine ⟨?_, ?_, ?_, ?_⟩
  -- Step 4: (i), as the parametrisation is `J ∘ toLp` and `toLp` preserves volume
  · have hcomp : (fun z : Fin m → ℝ => a + ∑ i, z i • w i) = J ∘ WithLp.toLp 2 := rfl
    rw [hcomp, ← Measure.map_map hJm (PiLp.volume_preserving_toLp (Fin m)).measurable,
      (PiLp.volume_preserving_toLp (Fin m)).map_eq, hmapJ]
  -- Step 5: (ii), `S` is the preimage of the closed subspace `span w` under `y ↦ y − a`
  · exact (Submodule.closed_of_finiteDimensional _).preimage (continuous_id.sub continuous_const)
  -- Step 6: (iii), `(Hᵐ⌞S)(K) = Lᵐ(J⁻¹K) < ∞`, `J` being a closed embedding
  · intro K hK
    rw [← hmapJ, Measure.map_apply hJm hK.isClosed.measurableSet]
    exact (hJ.isClosedEmbedding.isCompact_preimage hK).measure_lt_top
  -- Step 7: (iv), `(Hᵐ⌞S)(B_r(a)) = Lᵐ(J⁻¹B_r(a)) > 0`, an open set containing `0`
  · intro r hr
    rw [← hmapJ, Measure.map_apply hJm measurableSet_ball]
    exact (isOpen_ball.preimage hJ.continuous).measure_pos _ ⟨0, by simp [J, hr]⟩

/-- **Coordinate boxes in the span of an orthonormal frame have `Hᵏ`-measure `(2r)ᵏ`** (Simon
Ch. 1, 2.9, `Hᵏ = Lᵏ` on `ℝᵏ`; box volumes for the splitting lemma, Ch. 7, 3.5).  Let
`G = span g` and `ι(u) = Σᵢ uᵢ gᵢ` for `u : Fin k → ℝ` with the sup norm.  By
`Submission.cbr_cipi_affine_plane_measure` at `a = 0`, `ι_*(Lᵏ) = Hᵏ⌞G`.  Both boxes are Borel
subsets of the closed subspace `G`, so `Hᵏ(S) = (Hᵏ⌞G)(S) = Lᵏ(ι⁻¹S)`.  Orthonormality gives
`ι(u) ∈ G` and `⟨gᵢ, ι(u)⟩ = uᵢ`, so the closed and open boxes pull back to the sup-norm balls
`closedBall 0 r` and `ball 0 r` of `ℝᵏ`, both of volume `(2r)ᵏ`. -/
theorem Submission.dimred_cs_sos_mt_fm_box_measure : ∀ (P k : ℕ) (g : Fin k → Euclid P), Orthonormal ℝ g → ∀ r : ℝ, 0 < r → μHE[k] {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r} = ENNReal.ofReal ((2 * r) ^ k) ∧ μHE[k] {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| < r} = ENNReal.ofReal ((2 * r) ^ k) := by
  intro P k g hg r hr
  set G : Set (Euclid P) := (Submodule.span ℝ (Set.range g) : Set (Euclid P))
  set ι : (Fin k → ℝ) → Euclid P := fun u => ∑ i, u i • g i
  -- Step 1: `ι_*(Lᵏ) = Hᵏ⌞G`, the affine plane measure at `a = 0`
  have hmap : Measure.map ι volume = (μHE[k] : Measure (Euclid P)).restrict G := by
    simpa [ι, G] using (Submission.cbr_cipi_affine_plane_measure P k g 0 hg).1
  -- Step 2: `ι` is continuous, `G` is closed, and the coordinates `|⟨gᵢ, ·⟩|` are continuous
  have hιm : Measurable ι :=
    (continuous_finsetSum _ fun i _ => (continuous_apply i).smul continuous_const).measurable
  have hGc : IsClosed G := (Submodule.span ℝ (Set.range g)).closed_of_finiteDimensional
  have hcont : ∀ i, Continuous fun t : Euclid P => |inner ℝ (g i) t| := fun i =>
    (continuous_const.inner continuous_id).abs
  -- Step 3: `Hᵏ(S) = (Hᵏ⌞G)(S) = Lᵏ(ι⁻¹S)` for Borel `S ⊆ G`
  have key : ∀ S : Set (Euclid P), MeasurableSet S → S ⊆ G → μHE[k] S = volume (ι ⁻¹' S) := by
    intro S hS hSG
    rw [← Measure.map_apply hιm hS, hmap, Measure.restrict_apply hS, inter_eq_left.mpr hSG]
  -- Step 4: `ι(u) ∈ G` and `⟨gᵢ, ι(u)⟩ = uᵢ` by orthonormality
  have hmemG : ∀ u, ι u ∈ Submodule.span ℝ (Set.range g) := fun u =>
    Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span (mem_range_self i))
  have hcoord : ∀ u i, inner ℝ (g i) (ι u) = u i := fun u i => hg.inner_right_fintype u i
  refine ⟨?_, ?_⟩
  -- Step 5: the closed box pulls back to the sup-norm `closedBall 0 r`, of volume `(2r)ᵏ`
  · rw [key _ ?_ fun t ht => ht.1]
    · have hpre : ι ⁻¹' {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r} =
          closedBall 0 r := by
        ext u
        simp only [mem_preimage, mem_ofPred_eq, hcoord, mem_closedBall_zero_iff,
          pi_norm_le_iff_of_nonneg hr.le, Real.norm_eq_abs]
        exact ⟨fun h => h.2, fun h => ⟨hmemG u, h⟩⟩
      rw [hpre, Real.volume_pi_closedBall _ hr.le, Fintype.card_fin]
    · rw [ofPred_and, ofPred_forall]
      exact hGc.measurableSet.inter (MeasurableSet.iInter fun i =>
        (isClosed_le (hcont i) continuous_const).measurableSet)
  -- Step 6: the open box pulls back to the sup-norm `ball 0 r`, of volume `(2r)ᵏ`
  · rw [key _ ?_ fun t ht => ht.1]
    · have hpre : ι ⁻¹' {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| < r} =
          ball 0 r := by
        ext u
        simp only [mem_preimage, mem_ofPred_eq, hcoord, mem_ball_zero_iff, pi_norm_lt_iff hr,
          Real.norm_eq_abs]
        exact ⟨fun h => h.2, fun h => ⟨hmemG u, h⟩⟩
      rw [hpre, Real.volume_pi_ball _ hr, Fintype.card_fin]
    · rw [ofPred_and, ofPred_forall]
      exact hGc.measurableSet.inter (MeasurableSet.iInter fun i =>
        (isOpen_lt (hcont i) continuous_const).measurableSet)

/-- **The frame map of an orthonormal family pushes Lebesgue measure to `Hᵏ` on its span**
(Simon Ch. 1, 2.9, `Hᵏ = Lᵏ` on `ℝᵏ`; the coordinates of the splitting lemma, Ch. 7, 3.5).  Let
`G = span g` and `ι(u) = Σᵢ uᵢ gᵢ` for `u : Fin k → ℝ`.  (i) is
`Submission.cbr_cipi_affine_plane_measure` at `a = 0`, `ι_*(Lᵏ) = Hᵏ⌞G`, and (ii) is
`Submission.dimred_cs_sos_mt_fm_box_measure`: the closed and open coordinate boxes of `G` of
half-width `r` both have `Hᵏ`-measure `(2r)ᵏ`. -/
theorem Submission.dimred_cs_sos_mt_frame_measure : ∀ (P k : ℕ) (g : Fin k → Euclid P), Orthonormal ℝ g → (volume : Measure (Fin k → ℝ)).map (fun u => ∑ i, u i • g i) = μHE[k].restrict (Submodule.span ℝ (Set.range g) : Set (Euclid P)) ∧ ∀ r : ℝ, 0 < r → μHE[k] {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r} = ENNReal.ofReal ((2 * r) ^ k) ∧ μHE[k] {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| < r} = ENNReal.ofReal ((2 * r) ^ k) := by
  intro P k g hg
  refine ⟨?_, Submission.dimred_cs_sos_mt_fm_box_measure P k g hg⟩
  -- (i): the affine plane measure at `a = 0`, where `0 + ι(u) = ι(u)` and `y − 0 = y`
  simpa using (Submission.cbr_cipi_affine_plane_measure P k g 0 hg).1
/-- **Simon 7.3.5, proof (masses in a projection box)**: let `g` be orthonormal with span `G`,
`p = p_G`, `q = p_{G^⊥}`, `0 < r < s`, `Q_r = {t ∈ G : |⟨gᵢ, t⟩| ≤ r ∀ i}`,
`C_s = {x : |⟨gᵢ, x⟩| < s ∀ i}`, `B` open and `W = p⁻¹(C_s) ∩ q⁻¹(B)`.  Let `S`, `A₁`, `A₂` be
represented by `R`, `R_{A₁}`, `R_{A₂}`, whose measures are `A ↦ ∫_E μ(A − t) dHᵏ(t)` for
`(E, μ) = (G, μ₀)`, `(G ∖ Q_r, μ₀)`, `(Q_r, μ₀′)` with `μ₀`, `μ₀′` carried by `G^⊥`.  Then
`M_W(S) = (2s)ᵏ μ₀(B)`, `M_W(A₁) = ((2s)ᵏ − (2r)ᵏ) μ₀(B)` and `M_W(A₂) = (2r)ᵏ μ₀′(B)`.  `W` is
open, so each mass is the measure of `W` (`Submission.imrep_represents_massOn_eq_measure`), and
`Submission.dimred_cs_sos_mt_product_box_measure` turns it into `Hᵏ(E ∩ C_s) μ(B)`.  Here
`G ∩ C_s` is the open box of half-width `s`, while `r < s` gives `Q_r ∩ C_s = Q_r` and
`(G ∖ Q_r) ∩ C_s = (G ∩ C_s) ∖ Q_r`; the box volumes `(2s)ᵏ`, `(2r)ᵏ`
(`Submission.dimred_cs_sos_mt_frame_measure`) and `measure_sdiff` finish. -/
theorem Submission.dimred_cs_sos_mt_cm_box_masses : ∀ (P k m n : ℕ) (g : Fin k → Euclid P) (S A₁ A₂ : GeometricCurrentOn (univ : Set (Euclid P)) n) (R RA₁ RA₂ : IMRep (univ : Set (Euclid P)) n) (R₀ R₀' : IMRep (univ : Set (Euclid P)) m) (r s : ℝ) (B : Set (Euclid P)), Orthonormal ℝ g → 0 < r → r < s → IsOpen B → R.Represents S → RA₁.Represents A₁ → RA₂.Represents A₂ → R₀.measure ((Submodule.span ℝ (Set.range g))ᗮ : Set (Euclid P))ᶜ = 0 → R₀'.measure ((Submodule.span ℝ (Set.range g))ᗮ : Set (Euclid P))ᶜ = 0 → (∀ A : Set (Euclid P), MeasurableSet A → R.measure A = ∫⁻ t in (Submodule.span ℝ (Set.range g) : Set (Euclid P)), R₀.measure ((fun y => t + y) ⁻¹' A) ∂μHE[k]) → (∀ A : Set (Euclid P), MeasurableSet A → RA₁.measure A = ∫⁻ t in (Submodule.span ℝ (Set.range g) : Set (Euclid P)) \ {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r}, R₀.measure ((fun y => t + y) ⁻¹' A) ∂μHE[k]) → (∀ A : Set (Euclid P), MeasurableSet A → RA₂.measure A = ∫⁻ t in {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r}, R₀'.measure ((fun y => t + y) ⁻¹' A) ∂μHE[k]) → S.massOn ((Submodule.span ℝ (Set.range g)).starProjection ⁻¹' {x | ∀ i, |inner ℝ (g i) x| < s} ∩ (Submodule.span ℝ (Set.range g))ᗮ.starProjection ⁻¹' B) = ENNReal.ofReal ((2 * s) ^ k) * R₀.measure B ∧ A₁.massOn ((Submodule.span ℝ (Set.range g)).starProjection ⁻¹' {x | ∀ i, |inner ℝ (g i) x| < s} ∩ (Submodule.span ℝ (Set.range g))ᗮ.starProjection ⁻¹' B) = (ENNReal.ofReal ((2 * s) ^ k) - ENNReal.ofReal ((2 * r) ^ k)) * R₀.measure B ∧ A₂.massOn ((Submodule.span ℝ (Set.range g)).starProjection ⁻¹' {x | ∀ i, |inner ℝ (g i) x| < s} ∩ (Submodule.span ℝ (Set.range g))ᗮ.starProjection ⁻¹' B) = ENNReal.ofReal ((2 * r) ^ k) * R₀'.measure B := by
  intro P k m n g S A₁ A₂ R RA₁ RA₂ R₀ R₀' r s B hg hr hrs hB hR hRA₁ hRA₂ hR₀c hR₀'c hRμ hμA₁ hμA₂
  -- Step 1: `G` and `Q_r` are closed, `C_s` is open, hence `W = p⁻¹(C_s) ∩ q⁻¹(B)` is open
  have hGc : IsClosed (Submodule.span ℝ (Set.range g) : Set (Euclid P)) :=
    (Submodule.span ℝ (Set.range g)).closed_of_finiteDimensional
  have hcont : ∀ i, Continuous fun t : Euclid P => |inner ℝ (g i) t| := fun i =>
    (continuous_const.inner continuous_id).abs
  have hQc : IsClosed
      {t : Euclid P | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r} := by
    rw [ofPred_and, ofPred_forall]
    exact hGc.inter (isClosed_iInter fun i => isClosed_le (hcont i) continuous_const)
  have hCo : IsOpen {x : Euclid P | ∀ i, |inner ℝ (g i) x| < s} := by
    rw [ofPred_forall]
    exact isOpen_iInter_of_finite fun i => isOpen_lt (hcont i) continuous_const
  have hWo : IsOpen ((Submodule.span ℝ (Set.range g)).starProjection ⁻¹'
      {x | ∀ i, |inner ℝ (g i) x| < s} ∩ (Submodule.span ℝ (Set.range g))ᗮ.starProjection ⁻¹' B) :=
    (hCo.preimage (Submodule.span ℝ (Set.range g)).starProjection.continuous).inter
      (hB.preimage (Submodule.span ℝ (Set.range g))ᗮ.starProjection.continuous)
  -- Step 2: the box volumes `Hᵏ(Q_r) = (2r)ᵏ` and `Hᵏ(G ∩ C_s) = (2s)ᵏ`
  obtain ⟨-, hfm⟩ := Submission.dimred_cs_sos_mt_frame_measure P k g hg
  have hQμ := (hfm r hr).1
  have hOμ := (hfm s (hr.trans hrs)).2
  have hGC : (Submodule.span ℝ (Set.range g) : Set (Euclid P)) ∩
      {x : Euclid P | ∀ i, |inner ℝ (g i) x| < s} =
      {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| < s} := rfl
  -- Step 3: `Q_r ⊆ C_s`, hence `Q_r ⊆ G ∩ C_s`, because `r < s`
  have hQC : {t : Euclid P | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r} ⊆
      {x : Euclid P | ∀ i, |inner ℝ (g i) x| < s} := fun t ht i => (ht.2 i).trans_lt hrs
  have hQO : {t : Euclid P | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r} ⊆
      {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| < s} :=
    fun t ht => ⟨ht.1, hQC ht⟩
  -- Step 4: each mass is the measure of the open `W`, which is `Hᵏ(E ∩ C_s) μ(B)`; here
  -- `G ∩ C_s` is the open box of half-width `s` and `Q_r ∩ C_s = Q_r`
  have mS := Submission.imrep_represents_massOn_eq_measure P n univ _ S R isOpen_univ hR hWo
    (subset_univ _)
  have mA₁ := Submission.imrep_represents_massOn_eq_measure P n univ _ A₁ RA₁ isOpen_univ hRA₁ hWo
    (subset_univ _)
  have mA₂ := Submission.imrep_represents_massOn_eq_measure P n univ _ A₂ RA₂ isOpen_univ hRA₂ hWo
    (subset_univ _)
  rw [Submission.dimred_cs_sos_mt_product_box_measure P k _ R.measure R₀.measure _ hR₀c
    hGc.measurableSet subset_rfl hRμ _ B hCo.measurableSet hB.measurableSet, hGC, hOμ] at mS
  rw [Submission.dimred_cs_sos_mt_product_box_measure P k _ RA₂.measure R₀'.measure _ hR₀'c
    hQc.measurableSet (fun t ht => ht.1) hμA₂ _ B hCo.measurableSet hB.measurableSet,
    inter_eq_left.mpr hQC, hQμ] at mA₂
  -- Step 5: `(G ∖ Q_r) ∩ C_s = (G ∩ C_s) ∖ Q_r` has measure `(2s)ᵏ − (2r)ᵏ`
  have hdiff : ((Submodule.span ℝ (Set.range g) : Set (Euclid P)) \
      {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r}) ∩
      {x | ∀ i, |inner ℝ (g i) x| < s} =
      {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| < s} \
      {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r} := by
    rw [← hGC]
    exact sdiff_inter_right_comm _ _ _
  rw [Submission.dimred_cs_sos_mt_product_box_measure P k _ RA₁.measure R₀.measure _ hR₀c
    (hGc.measurableSet.diff hQc.measurableSet) sdiff_subset hμA₁ _ B hCo.measurableSet
    hB.measurableSet, hdiff, measure_sdiff hQO hQc.measurableSet.nullMeasurableSet
    (by rw [hQμ]; exact ENNReal.ofReal_ne_top), hOμ, hQμ] at mA₁
  exact ⟨mS, mA₁, mA₂⟩

/-- **Bounded subsets of the span of an orthonormal frame have finite `Hᵏ`-measure** (Simon
Ch. 1, 2.9, `Hᵏ = Lᵏ` on `ℝᵏ`; integrability over `G` in the splitting lemma, Ch. 7, 3.5).
Let `G = span g`.  A bounded `E ⊆ G` lies in some `closedBall 0 ρ`; put `r = max ρ 0 + 1 > 0`.
For `t ∈ E`, Cauchy–Schwarz and `‖gᵢ‖ = 1` give `|⟨gᵢ, t⟩| ≤ ‖t‖ ≤ ρ ≤ r`, so `E` lies in the
closed coordinate box of `G` of half-width `r`.  By `Submission.dimred_cs_sos_mt_frame_measure`
(ii) that box has `Hᵏ`-measure `(2r)ᵏ < ∞`, and monotonicity finishes. -/
theorem Submission.dimred_cs_sos_mt_si_span_bounded_measure_ne_top : ∀ (P k : ℕ) (g : Fin k → Euclid P), Orthonormal ℝ g → ∀ E : Set (Euclid P), E ⊆ (Submodule.span ℝ (Set.range g) : Set (Euclid P)) → Bornology.IsBounded E → μHE[k] E ≠ ∞ := by
  intro P k g hg E hEG hE
  -- Step 1: `E ⊆ closedBall 0 ρ`; put `r = max ρ 0 + 1`, so that `0 < r` and `ρ ≤ r`
  obtain ⟨ρ, hρ⟩ := hE.subset_closedBall 0
  set r : ℝ := max ρ 0 + 1
  have hr : 0 < r := by linarith [le_max_right ρ 0]
  have hρr : ρ ≤ r := by linarith [le_max_left ρ 0]
  -- Step 2: `E` lies in the closed box of half-width `r`, by Cauchy–Schwarz and `‖gᵢ‖ = 1`
  have hbox : E ⊆ {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r} := by
    intro t ht
    refine ⟨hEG ht, fun i => ?_⟩
    calc |inner ℝ (g i) t| ≤ ‖g i‖ * ‖t‖ := abs_real_inner_le_norm _ _
      _ = ‖t‖ := by rw [hg.1 i, one_mul]
      _ ≤ ρ := mem_closedBall_zero_iff.mp (hρ ht)
      _ ≤ r := hρr
  -- Step 3: the box has `Hᵏ`-measure `(2r)ᵏ < ∞` by frame_measure (ii); monotonicity finishes
  refine ne_top_of_le_ne_top ?_ (measure_mono hbox)
  rw [((Submission.dimred_cs_sos_mt_frame_measure P k g hg).2 r hr).1]
  exact ENNReal.ofReal_ne_top
/-- **Interior product with a frame; translated test forms.**  (a) For `g = (g₁, …, g_k)` in
`ℝᴾ` and `n' = k + m`, `♭α(v) = α(g₁, …, g_k, v₁, …, v_m)` defines a continuous linear map
`♭ : Λ^{n'} → Λ^m`.  Updating `vⱼ` updates only the entry `natAdd k j` of `(g, v)`, so `♭α` is
multilinear; it is alternating because equal entries of `v` stay at distinct indices; it is
continuous; and `‖♭α‖ ≤ (∏ᵢ ‖gᵢ‖) ‖α‖`, so `α ↦ ♭α` is bounded (`LinearMap.mkContinuous`).
(b) For a continuous linear `Φ : Λᵃ → Λᵇ`, a test `a`-form `ω` and `t ∈ ℝᴾ`, `y ↦ Φ(ω(t + y))`
is smooth and vanishes off the closed set `{y : t + y ∈ spt ω}`, the compact translate
`spt ω − t`; hence it is a test form supported there.  This is the interior product `♭_g` of
the product construction `[[E]] ×_g A` used to split off the spine of a cone. -/
theorem Submission.dimred_cs_sos_mt_interior_product : ∀ P : ℕ, (∀ (k m n' : ℕ) (g : Fin k → Euclid P) (h : n' = k + m), ∃ flat : Covector (Euclid P) n' →L[ℝ] Covector (Euclid P) m, ∀ (α : Covector (Euclid P) n') (v : Fin m → Euclid P), flat α v = α (Fin.append g v ∘ Fin.cast h)) ∧ ∀ (a b : ℕ) (flat : Covector (Euclid P) a →L[ℝ] Covector (Euclid P) b) (ω : DifferentialForm (Euclid P) a) (t : Euclid P), IsTestForm ω → IsTestForm (fun y => flat (ω (t + y))) ∧ tsupport (fun y => flat (ω (t + y))) ⊆ (fun y => t + y) ⁻¹' tsupport ω := by
  intro P
  refine ⟨fun k m n' g h => ?_, fun a b flat ω t hω => ?_⟩
  · -- (a) the interior product with the frame `g`; first identify `n'` with `k + m`
    subst h
    -- the entries `castAdd m i` (from `g`) and `natAdd k j` (from `v`) are distinct
    have hne : ∀ (i : Fin k) (j : Fin m), Fin.castAdd m i ≠ Fin.natAdd k j := by
      intro i j hc
      have hv := congrArg Fin.val hc
      have hi := i.isLt
      simp only [Fin.val_castAdd, Fin.val_natAdd] at hv
      omega
    -- updating `v` at `j` updates `Fin.append g v` at `natAdd k j` (for any `DecidableEq`)
    have hupd : ∀ (_ : DecidableEq (Fin m)) (v : Fin m → Euclid P) (j : Fin m) (x : Euclid P),
        Fin.append g (Function.update v j x) =
          Function.update (Fin.append g v) (Fin.natAdd k j) x := by
      intro _ v j x
      funext z
      induction z using Fin.addCases with
      | left i => rw [Fin.append_left, Function.update_of_ne (hne i j), Fin.append_left]
      | right j' =>
        rw [Fin.append_right, Function.update_apply_of_injective _ (Fin.natAdd_injective m k)]
        congr 1
        funext i
        rw [Fin.append_right]
    -- `v ↦ Fin.append g v` is continuous: each entry is a constant `gᵢ` or a projection `vⱼ`
    have hcont : Continuous fun v : Fin m → Euclid P => Fin.append g v := by
      refine continuous_pi fun z => ?_
      induction z using Fin.addCases with
      | left i => simp only [Fin.append_left]; exact continuous_const
      | right j => simp only [Fin.append_right]; exact continuous_apply j
    -- `♭α (v) = α (g, v)` is a continuous alternating map
    let φ : Covector (Euclid P) (k + m) → Covector (Euclid P) m := fun α =>
      { toFun := fun v => α (Fin.append g v)
        map_update_add' := fun v j x y => by
          simp only [hupd _ v j, α.map_update_add]
        map_update_smul' := fun v j c x => by
          simp only [hupd _ v j, α.map_update_smul]
        cont := α.cont.comp hcont
        map_eq_zero_of_eq' := fun v i j hv hij =>
          α.map_eq_zero_of_eq (Fin.append g v) (i := Fin.natAdd k i) (j := Fin.natAdd k j)
            (by rw [Fin.append_right, Fin.append_right]; exact hv)
            ((Fin.natAdd_injective m k).ne hij) }
    have hφ : ∀ α v, φ α v = α (Fin.append g v) := fun α v => rfl
    -- `α ↦ ♭α` is linear
    let L : Covector (Euclid P) (k + m) →ₗ[ℝ] Covector (Euclid P) m :=
      { toFun := φ
        map_add' := fun α β => by
          ext v
          simp only [hφ, ContinuousAlternatingMap.add_apply]
        map_smul' := fun c α => by
          ext v
          simp only [hφ, ContinuousAlternatingMap.smul_apply, RingHom.id_apply] }
    -- and bounded: `|α (g, v)| ≤ ‖α‖ ∏ᵢ ‖gᵢ‖ ∏ⱼ ‖vⱼ‖`, so `‖♭α‖ ≤ (∏ᵢ ‖gᵢ‖) ‖α‖`
    have hbound : ∀ α, ‖L α‖ ≤ (∏ i, ‖g i‖) * ‖α‖ := by
      intro α
      refine ContinuousAlternatingMap.opNorm_le_bound _ (by positivity) fun v => ?_
      calc ‖L α v‖ = ‖α (Fin.append g v)‖ := rfl
        _ ≤ ‖α‖ * ∏ z, ‖Fin.append g v z‖ := α.le_opNorm _
        _ = (∏ i, ‖g i‖) * ‖α‖ * ∏ j, ‖v j‖ := by
          rw [Fin.prod_univ_add]
          simp only [Fin.append_left, Fin.append_right]
          ring
    refine ⟨L.mkContinuous (∏ i, ‖g i‖) hbound, fun α v => ?_⟩
    rw [LinearMap.mkContinuous_apply, Fin.cast_refl, Function.comp_id]
    rfl
  · -- (b) off `{y : t + y ∈ spt ω}` the form `ω (t + y)` vanishes, hence so does its image
    have hsub : tsupport (fun y => flat (ω (t + y))) ⊆ (fun y => t + y) ⁻¹' tsupport ω := by
      refine closure_minimal (fun y hy => ?_)
        ((isClosed_tsupport ω).preimage (continuous_const.add continuous_id))
      by_contra hy'
      apply hy
      show flat (ω (t + y)) = 0
      rw [image_eq_zero_of_notMem_tsupport (f := ω) (x := t + y) hy', map_zero]
    have hs : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) ω := hω.1
    -- `{y : t + y ∈ spt ω}` is the compact translate `spt ω − t`
    have hK : IsCompact ((fun y => t + y) ⁻¹' tsupport ω) := by
      have hK' := (Homeomorph.addLeft t).isCompact_preimage.mpr hω.2
      rwa [Homeomorph.coe_addLeft] at hK'
    refine ⟨⟨?_, ?_⟩, hsub⟩
    · exact flat.contDiff.comp (hs.comp (contDiff_const.add contDiff_id))
    · exact hK.of_isClosed_subset (isClosed_tsupport _) hsub

/-- **Slices of an integer multiplicity current are continuous and integrable over a frame span**
(the product construction of the splitting lemma, Ch. 7, 3.5).  Let `G = span g`, `η = Φ ∘ ω`
and `F(t) = T(η(t + ·))`.  By `Submission.dimred_cs_sos_mt_interior_product` (b) each
`η(t + ·)` is a test form, so `F(t) = τ(M, θ, ξ)(η(t + ·))` as `R_T` represents `T`.  (i) is
`Submission.dimred_cs_sos_mt_si_translate_action_continuous`, `η` being continuous with compact
support.  (ii) A bounded `E ⊆ G` has compact closure, on which the continuous `F` is bounded,
and finite `Hᵏ`-measure by `Submission.dimred_cs_sos_mt_si_span_bounded_measure_ne_top`.
(iii) If `μ_{R_T}(ℝᴾ \ Gᗮ) = 0`, then
`Submission.dimred_cs_sos_mt_si_translate_action_eq_zero_of_concentrated` gives a compact `K`
with `F = 0` on `G \ K`; `F` is integrable on the bounded set `E ∩ K` by (ii) and vanishes on
`E \ K`. -/
theorem Submission.dimred_cs_sos_mt_slice_integrable : ∀ (P k j n' : ℕ) (g : Fin k → Euclid P) (T : GeometricCurrentOn (univ : Set (Euclid P)) j) (RT : IMRep (univ : Set (Euclid P)) j) (flat : Covector (Euclid P) n' →L[ℝ] Covector (Euclid P) j) (ω : TestFormOn (univ : Set (Euclid P)) n'), Orthonormal ℝ g → RT.Represents T → Continuous (fun t => currentEval T (fun y => flat ((ω : DifferentialForm (Euclid P) n') (t + y)))) ∧ (∀ E : Set (Euclid P), MeasurableSet E → E ⊆ (Submodule.span ℝ (Set.range g) : Set (Euclid P)) → Bornology.IsBounded E → IntegrableOn (fun t => currentEval T (fun y => flat ((ω : DifferentialForm (Euclid P) n') (t + y)))) E μHE[k]) ∧ (RT.measure ((Submodule.span ℝ (Set.range g))ᗮ : Set (Euclid P))ᶜ = 0 → ∀ E : Set (Euclid P), MeasurableSet E → E ⊆ (Submodule.span ℝ (Set.range g) : Set (Euclid P)) → IntegrableOn (fun t => currentEval T (fun y => flat ((ω : DifferentialForm (Euclid P) n') (t + y)))) E μHE[k]) := by
  intro P k j n' g T RT flat ω hg hRT
  -- Step 1: `η = Φ ∘ ω` is continuous with compact support
  have hω : IsTestForm (ω : DifferentialForm (Euclid P) n') := ω.2.1
  have hωs : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (ω : DifferentialForm (Euclid P) n') := hω.1
  set η : DifferentialForm (Euclid P) j := fun z => flat ((ω : DifferentialForm (Euclid P) n') z)
  have hηc : Continuous η := flat.continuous.comp hωs.continuous
  have hηs : HasCompactSupport η := hω.2.comp_left flat.map_zero
  -- Step 2: `F(t) = T(η(t + ·)) = τ(M, θ, ξ)(η(t + ·))`, as `η(t + ·)` is a test form
  have hF : (fun t => currentEval T (fun y => flat ((ω : DifferentialForm (Euclid P) n') (t + y))))
      = fun t => RT.action (fun y => η (t + y)) := by
    funext t
    have hmem : IsTestForm (fun y => flat ((ω : DifferentialForm (Euclid P) n') (t + y))) ∧
        tsupport (fun y => flat ((ω : DifferentialForm (Euclid P) n') (t + y))) ⊆ univ :=
      ⟨((Submission.dimred_cs_sos_mt_interior_product P).2 n' j flat ω t hω).1, subset_univ _⟩
    rw [currentEval, dite_eq_left hmem]
    exact hRT _
  rw [hF]
  -- Step 3 (i): continuity of translates
  have hcont : Continuous fun t => RT.action (fun y => η (t + y)) :=
    Submission.dimred_cs_sos_mt_si_translate_action_continuous P j RT η hηc hηs
  -- Step 4 (ii): `F` is bounded on the compact closure of `E`, and `Hᵏ(E) < ∞`
  have hii : ∀ E : Set (Euclid P), MeasurableSet E →
      E ⊆ (Submodule.span ℝ (Set.range g) : Set (Euclid P)) → Bornology.IsBounded E →
      IntegrableOn (fun t => RT.action (fun y => η (t + y))) E μHE[k] := by
    intro E hEm hEG hEb
    obtain ⟨C, hC⟩ := hEb.isCompact_closure.exists_bound_of_continuousOn hcont.continuousOn
    refine Measure.integrableOn_of_bounded (M := C)
      (Submission.dimred_cs_sos_mt_si_span_bounded_measure_ne_top P k g hg E hEG hEb)
      hcont.aestronglyMeasurable ?_
    filter_upwards [ae_restrict_mem hEm] with t ht
    exact hC t (subset_closure ht)
  refine ⟨hcont, hii, fun hconc E hEm hEG => ?_⟩
  -- Step 5 (iii): `F = 0` on `G \ K`, so integrability on `E` reduces to the bounded `E ∩ K`
  obtain ⟨K, hK, hK0⟩ := Submission.dimred_cs_sos_mt_si_translate_action_eq_zero_of_concentrated
    P j (Submodule.span ℝ (Set.range g)) RT η hηs hconc
  refine IntegrableOn.of_forall_sdiff_eq_zero
    (hii (E ∩ K) (hEm.inter hK.isClosed.measurableSet) (inter_subset_left.trans hEG)
      (hK.isBounded.subset inter_subset_right)) hEm ?_
  rintro t ⟨htE, htEK⟩
  exact hK0 t (hEG htE) fun htK => htEK ⟨htE, htK⟩
/-- **A cycle supported in `A ∩ W` gives an admissible competitor** (Simon 7.1.1; 7.2.4 and
Remark 7.2.5(2)).  Let `U` be open, `T ∈ 𝒟ₙ(U)` (`n = m + 1`) minimizing in `A`, `W ⊂⊂ U` open,
and `X ∈ 𝒟ₙ(ℝᴾ)` integer multiplicity with `∂X = 0` and `spt X` a compact subset of `A ∩ W`.  If
`Z₁(ω) = T(ω) + X(ω)` for `ω ∈ 𝒟ⁿ(U)`, then `M_W(T) ≤ M_W(Z₁)`.  `Z₁ = T − ((X|_U − X|_U) − X|_U)`
is integer multiplicity, and `∂Z₁ = ∂T + ∂X = ∂T`.  As `(Z₁ − T)(ω) = X(ω)`, each point of `U`
outside `spt X` has a small neighbourhood, compactly contained in `U`, on which `Z₁ − T`
vanishes.  So `spt(Z₁ − T) ⊆ spt X ⊆ A ∩ W`, and `spt(Z₁ − T) = spt X ∖ Z_{Z₁−T}` is compact. -/
theorem Submission.dimred_mbl_lc_rc_cycle_competitor : ∀ (P m : ℕ) (U A W : Set (Euclid P)) (T Z₁ : GeometricCurrentOn U (m + 1)) (X : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsOpen U → IsMinimizingIn T A → IsOpen W → CompactlyContained W U → IsIntegerMultiplicity X → X.boundary = 0 → IsCompact X.support → X.support ⊆ A ∩ W → (∀ ω : TestFormOn U (m + 1), Z₁ ω = T ω + X (testFormOnInclusion (subset_univ U) (m + 1) ω)) → T.massOn W ≤ Z₁.massOn W := by
  intro P m U A W T Z₁ X hU hT hW hWU hXim hXb hXc hXA hZ
  obtain ⟨hTim, hmin⟩ := hT
  -- Step 1: `X|_U` is integer multiplicity (RO), hence so is `Z₁ = T − ((X|_U − X|_U) − X|_U)`
  set XU : GeometricCurrentOn U (m + 1) := X.restrictDomain (subset_univ U) with hXU
  have hXUim : IsIntegerMultiplicity XU :=
    Submission.dtc_restrictDomain_isIntegerMultiplicity P (m + 1) univ U (subset_univ U) X hU hXim
  have hsub := Submission.cmc_imRep_locality_restrict_sub.2.2.1 P (m + 1) U
  have hZeq : T - ((XU - XU) - XU) = Z₁ := by
    ext ω
    show T ω - ((XU ω - XU ω) - XU ω) = Z₁ ω
    rw [hZ ω, hXU, GeometricCurrentOn.restrictDomain_apply]
    ring
  have hZim : IsIntegerMultiplicity Z₁ :=
    hZeq ▸ hsub T _ hU hTim (hsub _ XU hU (hsub XU XU hU hXUim hXUim) hXUim)
  -- Step 2: `∂Z₁(η) = T(dη) + X(dη) = ∂T(η) + ∂X(η) = ∂T(η)`
  have hbd : SameBoundary Z₁ T := by
    show Z₁.boundary = T.boundary
    ext η
    have hd : testFormOnInclusion (subset_univ U) (m + 1) (exteriorDerivativeTestOn U m η) =
        exteriorDerivativeTestOn univ m (testFormOnInclusion (subset_univ U) m η) := rfl
    rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.boundary_apply, hZ, hd,
      ← X.boundary_apply, hXb, GeometricCurrentOn.zero_apply, add_zero]
  -- Step 3: `(Z₁ − T)(ω) = X(ω)`, so `spt(Z₁ − T) ⊆ spt X`
  have hspt : (Z₁ - T).support ⊆ X.support := by
    rintro x ⟨hxU, hxZ⟩
    refine ⟨mem_univ x, fun hxX => hxZ ?_⟩
    obtain ⟨V, ⟨hVo, -, -, hVX⟩, hxV⟩ := mem_sUnion.1 hxX
    obtain ⟨r, hr, hrU⟩ := Metric.isOpen_iff.1 hU x hxU
    have hcl : closure (V ∩ ball x (r / 2)) ⊆ closedBall x (r / 2) :=
      (closure_mono inter_subset_right).trans closure_ball_subset_closedBall
    refine mem_sUnion.2 ⟨V ∩ ball x (r / 2), ⟨hVo.inter isOpen_ball,
      (isCompact_closedBall x (r / 2)).of_isClosed_subset isClosed_closure hcl,
      hcl.trans ((closedBall_subset_ball (half_lt_self hr)).trans hrU), fun ω hω => ?_⟩,
      hxV, mem_ball_self (half_pos hr)⟩
    show Z₁ ω - T ω = 0
    rw [hZ ω, hVX (testFormOnInclusion (subset_univ U) (m + 1) ω) (hω.trans inter_subset_left),
      add_zero, sub_self]
  -- Step 4: `spt(Z₁ − T) = spt X ∖ Z_{Z₁−T}` is compact, as `spt X ⊆ W ⊆ closure W ⊆ U`
  have hcpt : IsCompact (Z₁ - T).support := by
    have heq : (Z₁ - T).support = X.support ∩ ((Z₁ - T).zeroRegion)ᶜ :=
      Subset.antisymm (fun x hx => ⟨hspt hx, hx.2⟩)
        fun x hx => ⟨hWU.2 (subset_closure (hXA hx.1).2), hx.2⟩
    rw [heq]
    exact hXc.inter_right (Z₁ - T).isOpen_zeroRegion.isClosed_compl
  -- Step 5: minimality of `T` against the competitor `Z₁` in `W`
  exact hmin W Z₁ hW hWU hZim hbd hcpt (hspt.trans hXA)

/-- **Mass of the split competitor** (Simon, Ch. 7, Lemma 3.5).  Let `G = span g` for an
orthonormal frame `g` and `Q_r = {t ∈ G : |⟨gᵢ, t⟩| ≤ r ∀ i}`.  On test forms, through the
interior product `♭` with `g`, let `S = [[G]] × S₀`, `Z = [[Q_r]] × (S₀' − S₀) + E'`,
`A₁ = [[G \ Q_r]] × S₀` and `A₂ = [[Q_r]] × S₀'`, where `S₀ = τ(R₀)` and `S₀' = τ(R₀')` are
carried by `Gᗮ`, and let `S' = S + Z`.  Fix a continuous linear `♭` by
`Submission.dimred_cs_sos_mt_interior_product` (a).  The slices `t ↦ S₀(♭ω(t + ·))` and
`t ↦ S₀'(♭ω(t + ·))` are `Hᵏ`-integrable on `G` and on the closed `Q_r ⊆ G`
(`Submission.dimred_cs_sos_mt_slice_integrable` (iii)), so `∫_G − ∫_{Q_r} = ∫_{G \ Q_r}` gives
`S' = A₁ + (A₂ + E')`.  Two applications of `Submission.lcmp_massOn_le_add_of_eval_eq`, through
`T₂ = A₂ + E'`, and `M_W(E') ≤ M(E')` give `M_W(S') ≤ M_W(A₁) + M_W(A₂) + M(E')`. -/
theorem Submission.dimred_cs_sos_mt_cm_split_mass : ∀ (P k m n : ℕ) (g : Fin k → Euclid P) (h : n = k + m) (S₀ S₀' : GeometricCurrentOn (univ : Set (Euclid P)) m) (R₀ R₀' : IMRep (univ : Set (Euclid P)) m) (S Z E' A₁ A₂ S' : GeometricCurrentOn (univ : Set (Euclid P)) n) (r : ℝ) (W : Set (Euclid P)), Orthonormal ℝ g → R₀.Represents S₀ → R₀'.Represents S₀' → R₀.measure ((Submodule.span ℝ (Set.range g))ᗮ : Set (Euclid P))ᶜ = 0 → R₀'.measure ((Submodule.span ℝ (Set.range g))ᗮ : Set (Euclid P))ᶜ = 0 → (∀ flat : Covector (Euclid P) n → Covector (Euclid P) m, (∀ (α : Covector (Euclid P) n) (v : Fin m → Euclid P), flat α v = α (Fin.append g v ∘ Fin.cast h)) → ∀ ω : TestFormOn (univ : Set (Euclid P)) n, S ω = ∫ t in (Submodule.span ℝ (Set.range g) : Set (Euclid P)), currentEval S₀ (fun y => flat ((ω : DifferentialForm (Euclid P) n) (t + y))) ∂μHE[k]) → (∀ flat : Covector (Euclid P) n → Covector (Euclid P) m, (∀ (α : Covector (Euclid P) n) (v : Fin m → Euclid P), flat α v = α (Fin.append g v ∘ Fin.cast h)) → ∀ ω : TestFormOn (univ : Set (Euclid P)) n, Z ω = (∫ t in {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r}, currentEval (S₀' - S₀) (fun y => flat ((ω : DifferentialForm (Euclid P) n) (t + y))) ∂μHE[k]) + E' ω) → (∀ flat : Covector (Euclid P) n → Covector (Euclid P) m, (∀ (α : Covector (Euclid P) n) (v : Fin m → Euclid P), flat α v = α (Fin.append g v ∘ Fin.cast h)) → ∀ ω : TestFormOn (univ : Set (Euclid P)) n, A₁ ω = ∫ t in (Submodule.span ℝ (Set.range g) : Set (Euclid P)) \ {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r}, currentEval S₀ (fun y => flat ((ω : DifferentialForm (Euclid P) n) (t + y))) ∂μHE[k]) → (∀ flat : Covector (Euclid P) n → Covector (Euclid P) m, (∀ (α : Covector (Euclid P) n) (v : Fin m → Euclid P), flat α v = α (Fin.append g v ∘ Fin.cast h)) → ∀ ω : TestFormOn (univ : Set (Euclid P)) n, A₂ ω = ∫ t in {t | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r}, currentEval S₀' (fun y => flat ((ω : DifferentialForm (Euclid P) n) (t + y))) ∂μHE[k]) → (∀ ω : TestFormOn (univ : Set (Euclid P)) n, S' ω = S ω + Z ω) → S'.massOn W ≤ A₁.massOn W + A₂.massOn W + E'.mass := by
  intro P k m n g h S₀ S₀' R₀ R₀' S Z E' A₁ A₂ S' r W hg hR₀ hR₀' hR₀c hR₀'c hSf hZf hA₁f hA₂f hS'
  -- Step 1: a continuous linear interior product `♭` with the frame `g`
  obtain ⟨flatL, hflatL⟩ := (Submission.dimred_cs_sos_mt_interior_product P).1 k m n g h
  -- Step 2: `G` and `Q_r ⊆ G` are closed, hence Borel
  have hGc : IsClosed ((Submodule.span ℝ (Set.range g) : Set (Euclid P))) :=
    Submodule.closed_of_finiteDimensional _
  have hQc : IsClosed
      {t : Euclid P | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r} := by
    have hset : {t : Euclid P | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r} =
        (Submodule.span ℝ (Set.range g) : Set (Euclid P)) ∩ ⋂ i, {t | |inner ℝ (g i) t| ≤ r} := by
      ext t; simp
    rw [hset]
    exact hGc.inter (isClosed_iInter fun i =>
      isClosed_le (continuous_const.inner continuous_id).abs continuous_const)
  have hQG : {t : Euclid P | t ∈ Submodule.span ℝ (Set.range g) ∧ ∀ i, |inner ℝ (g i) t| ≤ r} ⊆
      (Submodule.span ℝ (Set.range g) : Set (Euclid P)) := fun t ht => ht.1
  -- Step 3: `currentEval (S₀' − S₀) = currentEval S₀' − currentEval S₀`
  have hdiff : ∀ φ : DifferentialForm (Euclid P) m,
      currentEval (S₀' - S₀) φ = currentEval S₀' φ - currentEval S₀ φ := by
    intro φ
    unfold currentEval
    split_ifs with hφ
    · rfl
    · simp
  -- Steps 4–5: the slices are integrable on `G` and `Q_r`, so `S' = A₁ + (A₂ + E')`
  have hact : ∀ ω : TestFormOn (univ : Set (Euclid P)) n, S' ω = A₁ ω + (A₂ ω + E' ω) := by
    intro ω
    have hint := Submission.dimred_cs_sos_mt_slice_integrable P k m n g S₀ R₀ flatL ω hg hR₀
    have hint' := Submission.dimred_cs_sos_mt_slice_integrable P k m n g S₀' R₀' flatL ω hg hR₀'
    have hIG := hint.2.2 hR₀c _ hGc.measurableSet subset_rfl
    have hIQ := hint.2.2 hR₀c _ hQc.measurableSet hQG
    have hIQ' := hint'.2.2 hR₀'c _ hQc.measurableSet hQG
    rw [hS' ω, hSf flatL hflatL ω, hZf flatL hflatL ω, hA₁f flatL hflatL ω, hA₂f flatL hflatL ω]
    simp_rw [hdiff]
    rw [integral_sub hIQ' hIQ, setIntegral_sdiff hQc.measurableSet hIG hQG]
    ring
  -- Step 6: the current `T₂ = A₂ − (0 − E') = A₂ + E'`
  let T₂ : GeometricCurrentOn (univ : Set (Euclid P)) n := A₂ - (0 - E')
  have hT₂ : ∀ ω : TestFormOn (univ : Set (Euclid P)) n, T₂ ω = A₂ ω + E' ω := by
    intro ω
    show A₂ ω - ((0 : GeometricCurrentOn (univ : Set (Euclid P)) n) ω - E' ω) = A₂ ω + E' ω
    rw [GeometricCurrentOn.zero_apply]; ring
  -- Step 7: two triangle inequalities with `c = 1`, and `M_W(E') ≤ M(E')`
  have h1 : S'.massOn W ≤ A₁.massOn W + T₂.massOn W :=
    Submission.lcmp_massOn_le_add_of_eval_eq P n univ W A₁ T₂ S' 1 (by simp)
      (fun ω _ => by rw [hact ω, hT₂ ω, one_mul])
  have h2 : T₂.massOn W ≤ A₂.massOn W + E'.massOn W :=
    Submission.lcmp_massOn_le_add_of_eval_eq P n univ W A₂ E' T₂ 1 (by simp)
      (fun ω _ => by rw [hT₂ ω, one_mul])
  have h3 : E'.massOn W ≤ E'.mass := E'.massOn_mono (subset_univ W)
  -- Step 8: combine the three bounds
  calc S'.massOn W ≤ A₁.massOn W + T₂.massOn W := h1
    _ ≤ A₁.massOn W + (A₂.massOn W + E'.mass) := by
      gcongr
      exact h2.trans (by gcongr)
    _ = A₁.massOn W + A₂.massOn W + E'.mass := by rw [add_assoc]
/-- Measure comparison in the minimality transfer of **Simon Lemma 7.3.5**.  Let `Sᵢ = τ(Rᵢ)` in
`ℝᴾ` with weights `μᵢ = θᵢ Hʲ⌞Mᵢ` (`i = 1, 2`), and let `W₀ ⊆ B` be open with
`K = spt(S₁ − S₂) ⊆ W₀`.  Then `μ₁(B) + μ₂(W₀) = μ₂(B) + μ₁(W₀)` in `[0, ∞]`.  `S₁ − S₂` is integer
multiplicity (`rsd_isIntegerMultiplicity_int_combination`), say `S₁ − S₂ = τ(M, θ, ξ)`, and
`Hʲ(M ∖ K) = 0` (`imrep_carrier_sdiff_support_null`).  If `spt ω ∩ K = ∅`, the integrand
`θ⟨ω, ξ⟩` vanishes on `K`, so `S₁(ω) = S₂(ω)`.  Hence `M_O(S₁) = M_O(S₂)`, i.e. `μ₁(O) = μ₂(O)`
(`imrep_represents_massOn_eq_measure`), for every open `O` disjoint from the closed set `K`.  Apply
this to `B ∖ K` and `W₀ ∖ K`, and split `B` and `W₀` at the Borel set `K`. -/
theorem Submission.dimred_cs_sos_mt_measure_comparison : ∀ (P j : ℕ) (S₁ S₂ : GeometricCurrentOn (univ : Set (Euclid P)) j) (R₁ R₂ : IMRep (univ : Set (Euclid P)) j) (W₀ B : Set (Euclid P)), R₁.Represents S₁ → R₂.Represents S₂ → IsOpen W₀ → IsOpen B → (S₁ - S₂).support ⊆ W₀ → W₀ ⊆ B → R₁.measure B + R₂.measure W₀ = R₂.measure B + R₁.measure W₀ := by
  intro P j S₁ S₂ R₁ R₂ W₀ B hR₁ hR₂ hW₀ hB hKW hWB
  -- `K = spt(S₁ − S₂) = ℝᴾ ∖ Z` is closed, `Z` being the open zero region
  set K := (S₁ - S₂).support
  have hKc : IsClosed K := isClosed_univ.sdiff (S₁ - S₂).isOpen_zeroRegion
  -- `S₁ − S₂ = 1·S₁ + (−1)·S₂` is integer multiplicity; let `R = (M, θ, ξ)` represent it
  have hsub : ∀ ω : TestFormOn (univ : Set (Euclid P)) j, (S₁ - S₂) ω = S₁ ω - S₂ ω :=
    fun ω => LinearMap.sub_apply _ _ ω
  obtain ⟨R, hR⟩ : IsIntegerMultiplicity (S₁ - S₂) :=
    Submission.rsd_isIntegerMultiplicity_int_combination P j univ S₁ S₂ (S₁ - S₂) 1 (-1)
      isOpen_univ ⟨R₁, hR₁⟩ ⟨R₂, hR₂⟩ fun ω => by
        rw [hsub ω]
        push_cast
        ring
  -- `Hʲ(M ∖ K) = 0`
  have hnull := Submission.imrep_carrier_sdiff_support_null P j univ (S₁ - S₂) R isOpen_univ hR
  -- `S₁(ω) = S₂(ω)` for every test form `ω` supported off `K`: the integrand of
  -- `(S₁ − S₂)(ω) = ∫_M θ ⟨ω, ξ⟩ dHʲ` vanishes on `M ∩ K`, and `M ∖ K` is null
  have hvan : ∀ ω : TestFormOn (univ : Set (Euclid P)) j,
      Disjoint (tsupport (ω : DifferentialForm (Euclid P) j)) K → S₁ ω = S₂ ω := by
    intro ω hω
    have h0 : (S₁ - S₂) ω = 0 := by
      rw [hR ω, IMRep.action]
      refine integral_eq_zero_of_ae ?_
      rw [EventuallyEq, ae_restrict_iff' R.measurableSet_carrier]
      filter_upwards [measure_eq_zero_iff_ae_notMem.mp hnull] with x hx hxM
      have hxK : x ∈ K := by
        by_contra hxK
        exact hx ⟨hxM, hxK⟩
      have hωx : (ω : DifferentialForm (Euclid P) j) x = 0 :=
        image_eq_zero_of_notMem_tsupport fun h => hω.notMem_of_mem_left h hxK
      simp [hωx]
    rw [hsub ω] at h0
    linarith
  -- hence `M_O(S₁) = M_O(S₂)`, i.e. `R₁.measure O = R₂.measure O`, for open `O` disjoint from `K`
  have hmeas : ∀ O : Set (Euclid P), IsOpen O → Disjoint O K → R₁.measure O = R₂.measure O := by
    intro O hO hOK
    rw [← Submission.imrep_represents_massOn_eq_measure P j univ O S₁ R₁ isOpen_univ hR₁ hO
        (subset_univ O),
      ← Submission.imrep_represents_massOn_eq_measure P j univ O S₂ R₂ isOpen_univ hR₂ hO
        (subset_univ O)]
    unfold GeometricCurrentOn.massOn
    congr 1
    refine image_congr fun ω hω => ?_
    rw [hvan ω (hOK.mono_left hω.1)]
  -- split `B` and `W₀` at the Borel set `K ⊆ W₀ ⊆ B` and compare
  have hKm : MeasurableSet K := hKc.measurableSet
  have hBK := hmeas (B \ K) (hB.sdiff hKc) disjoint_sdiff_left
  have hWK := hmeas (W₀ \ K) (hW₀.sdiff hKc) disjoint_sdiff_left
  rw [← measure_sdiff_add_inter (μ := R₁.measure) B hKm,
    ← measure_sdiff_add_inter (μ := R₂.measure) W₀ hKm,
    ← measure_sdiff_add_inter (μ := R₂.measure) B hKm,
    ← measure_sdiff_add_inter (μ := R₁.measure) W₀ hKm,
    inter_eq_right.mpr (hKW.trans hWB), inter_eq_right.mpr hKW, hBK, hWK]
  ring

/-- Box cancellation in the competitor mass bound of the minimality transfer of **Simon Lemma
7.3.5**.  Let `S₀ = τ(R₀)` and `S₀′ = τ(R₀′)` in `ℝᴾ` with weights `μ₀ = θ₀ Hᵐ⌞M₀` and `μ₀′`, let
`W₀ ⊆ B` be open with `B` bounded and `spt(S₀′ − S₀) ⊆ W₀`, and let `a, b, e ∈ [0, ∞]` with
`b ≤ a < ∞`.  If `a μ₀(B) ≤ (a − b) μ₀(B) + b μ₀′(B) + e`, then `b M_{W₀}(S₀) ≤ b M_{W₀}(S₀′) + e`.
The measure comparison (`dimred_cs_sos_mt_measure_comparison`) gives
`μ₀′(B) + μ₀(W₀) = μ₀(B) + μ₀′(W₀)`, and `M_{W₀}(S₀) = μ₀(W₀)`, `M_{W₀}(S₀′) = μ₀′(W₀)`
(`imrep_represents_massOn_eq_measure`).  `closure B` is compact, so `μ₀(B) < ∞` by the local
integrability of `θ₀`.  Adding `b μ₀(W₀)` to the hypothesis and using `(a − b) + b = a` gives
`a μ₀(B) + b μ₀(W₀) ≤ a μ₀(B) + (b μ₀′(W₀) + e)`; cancel the finite `a μ₀(B)`. -/
theorem Submission.dimred_cs_sos_mt_cm_box_cancellation : ∀ (P m : ℕ) (S₀ S₀' : GeometricCurrentOn (univ : Set (Euclid P)) m) (R₀ R₀' : IMRep (univ : Set (Euclid P)) m) (W₀ B : Set (Euclid P)) (a b e : ℝ≥0∞), R₀.Represents S₀ → R₀'.Represents S₀' → IsOpen W₀ → IsOpen B → Bornology.IsBounded B → (S₀' - S₀).support ⊆ W₀ → W₀ ⊆ B → b ≤ a → a ≠ ∞ → a * R₀.measure B ≤ (a - b) * R₀.measure B + b * R₀'.measure B + e → b * S₀.massOn W₀ ≤ b * S₀'.massOn W₀ + e := by
  intro P m S₀ S₀' R₀ R₀' W₀ B a b e hR₀ hR₀' hW₀ hB hBb hKW hWB hba ha hineq
  -- measure comparison: `μ₀′(B) + μ₀(W₀) = μ₀(B) + μ₀′(W₀)`
  have hcmp := Submission.dimred_cs_sos_mt_measure_comparison P m S₀' S₀ R₀' R₀ W₀ B hR₀' hR₀
    hW₀ hB hKW hWB
  -- `M_{W₀}(S₀) = μ₀(W₀)` and `M_{W₀}(S₀′) = μ₀′(W₀)`
  rw [Submission.imrep_represents_massOn_eq_measure P m univ W₀ S₀ R₀ isOpen_univ hR₀ hW₀
      (subset_univ W₀),
    Submission.imrep_represents_massOn_eq_measure P m univ W₀ S₀' R₀' isOpen_univ hR₀' hW₀
      (subset_univ W₀)]
  -- `μ₀(B) ≤ μ₀(closure B) = ∫_{M₀ ∩ closure B} θ₀ dHᵐ < ∞`, `closure B` being compact
  have hfin : R₀.measure B ≠ ∞ := by
    have hc : MeasurableSet (closure B) := isClosed_closure.measurableSet
    have hint := R₀.locallyIntegrable_mult (closure B) hBb.isCompact_closure (subset_univ _)
    have hcl : R₀.measure (closure B) =
        ∫⁻ x in R₀.carrier ∩ closure B, (R₀.mult x : ℝ≥0∞) ∂μHE[m] := by
      unfold IMRep.measure
      rw [withDensity_apply _ hc, Measure.restrict_restrict hc, inter_comm]
    rw [← hcl] at hint
    exact ne_top_of_le_ne_top hint (measure_mono subset_closure)
  -- add `b μ₀(W₀)` to the hypothesis and cancel the finite `a μ₀(B)`
  refine ENNReal.le_of_add_le_add_left (ENNReal.mul_ne_top ha hfin) ?_
  calc a * R₀.measure B + b * R₀.measure W₀
      ≤ (a - b) * R₀.measure B + b * R₀'.measure B + e + b * R₀.measure W₀ := by gcongr
    _ = (a - b) * R₀.measure B + b * (R₀'.measure B + R₀.measure W₀) + e := by ring
    _ = (a - b) * R₀.measure B + b * (R₀.measure B + R₀'.measure W₀) + e := by rw [hcmp]
    _ = (a - b + b) * R₀.measure B + (b * R₀'.measure W₀ + e) := by ring
    _ = a * R₀.measure B + (b * R₀'.measure W₀ + e) := by rw [tsub_add_cancel_of_le hba]
/-- **First variation bound for the mass of a deformation** (Simon Ch. 4, 2.2; Ch. 2, 5.2–5.3).
Let `R = (M, θ, ξ)`, `μ_V(W) = ∫_{M ∩ W} θ dHⁿ < ∞`, `X ∈ C¹_c` with `spt X ⊆ W`, and let `φₜ` be
`C¹` maps with `φₜ = id` off `spt X` and `‖Dφₜ − I − t DX‖ ≤ ε|t|` for small `|t|`.  If `S` acts by
`S(ω) = ∫_M θ ⟨ω(φₜx) ∘ Dφₜ(x), ξ(x)⟩ dHⁿ`, then `M_W(S) ≤ μ_V(W) + t δV(X) + ε|t|` for small `|t|`.
At a.e. `x ∈ M`, `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ` for an orthonormal basis `τ` of `TₓM` and
`div_M X(x) = Σₐ τₐ · DX(x)τₐ`, so on `W` the integrand is at most
`θ |ω|_E det(Dφₜτᵢ · Dφₜτⱼ)^{1/2} ≤ θ (1 + t div_M X + ε'|t|)`, `ε' = ε/(μ_V(W) + 1)`; off `W`,
`φₜ x = x ∉ spt ω` and the integrand vanishes.  Integrate (a non-integrable integrand has integral
`0` and the bound is nonnegative) and take the supremum over admissible `ω`. -/
theorem Submission.codim1_ldr_pushforward_massOn_le_first_variation : ∀ (P n : ℕ) (U W : Set (Euclid P)) (R : IMRep U n) (X : Euclid P → Euclid P) (φ : ℝ → Euclid P → Euclid P), IsOpen W → R.measure W ≠ ∞ → ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ W → (∀ t, ContDiff ℝ 1 (φ t)) → (∀ t x, x ∉ tsupport X → φ t x = x) → (∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ t : ℝ, |t| < δ → ∀ x, ‖fderiv ℝ (φ t) x - ContinuousLinearMap.id ℝ (Euclid P) - t • fderiv ℝ X x‖ ≤ ε * |t|) → ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ t : ℝ, |t| < δ → ∀ S : GeometricCurrentOn U n, (∀ ω : TestFormOn U n, S ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (φ t x)).compContinuousLinearMap (fderiv ℝ (φ t) x)) ∂μHE[n]) → S.massOn W ≤ ENNReal.ofReal ((R.measure W).toReal + t * R.firstVariation X + ε * |t|) := by
  intro P n U W R X φ hWo hRW hX hXc hXW _hφ hφid hφD ε hε
  classical
  have hDXc : Continuous (fderiv ℝ X) := hX.continuous_fderiv one_ne_zero
  -- `div_M X = trace(p_{TₓM} ∘ DX)` is a.e. strongly measurable: `p_{TₓM}` is (TM) and the trace
  -- of a composition is continuous
  have hdvm : AEStronglyMeasurable (tangentialDivergence n R.carrier X)
      (μHE[n].restrict R.carrier) := by
    have h1 : Continuous fun L : Euclid P →L[ℝ] Euclid P =>
        LinearMap.trace ℝ (Euclid P) L.toLinearMap :=
      ((LinearMap.trace ℝ (Euclid P)).comp
        (ContinuousLinearMap.coeLM ℝ)).continuous_of_finiteDimensional
    have h2 : Continuous fun pL : (Euclid P →L[ℝ] Euclid P) × (Euclid P →L[ℝ] Euclid P) =>
        LinearMap.trace ℝ (Euclid P) (pL.1.comp pL.2).toLinearMap :=
      h1.comp (continuous_fst.clm_comp continuous_snd)
    have h3 : Continuous fun pL : (Euclid P →L[ℝ] Euclid P) × (Euclid P →L[ℝ] Euclid P) =>
        LinearMap.trace ℝ (Euclid P) (pL.1.toLinearMap ∘ₗ pL.2.toLinearMap) := by
      simpa only [ContinuousLinearMap.toLinearMap_comp] using h2
    have hq := (Submission.imrep_approxTangent_starProjection_aesm P n U R).prodMk
      hDXc.aestronglyMeasurable
    have hr := h3.comp_aestronglyMeasurable hq
    exact hr
  set μ : Measure (Euclid P) := μHE[n].restrict R.carrier
  set θ : Euclid P → ℝ := fun x => (R.mult x : ℝ) with hθ
  set dv : Euclid P → ℝ := tangentialDivergence n R.carrier X
  set m : ℝ := (R.measure W).toReal with hm
  have hθ0 : ∀ x, 0 ≤ θ x := fun x => Nat.cast_nonneg _
  have hm0 : 0 ≤ m := ENNReal.toReal_nonneg
  -- `A` bounds `‖DX‖`: `DX` is continuous with compact support
  obtain ⟨C, hC⟩ := hDXc.bounded_above_of_compact_support (hXc.fderiv ℝ)
  set A : ℝ := max C 0
  have hA0 : 0 ≤ A := le_max_right _ _
  have hDXA : ∀ x, ‖fderiv ℝ X x‖ ≤ A := fun x => (hC x).trans (le_max_left _ _)
  -- constants: `ε' = ε / (m + 1)`; `η, δ₁` from the Jacobian bound at `(A, ε')`; `δ₂` from the
  -- hypothesis on `Dφₜ` at `η`
  set ε' : ℝ := ε / (m + 1) with hε'
  have hε'0 : 0 < ε' := div_pos hε (by linarith)
  obtain ⟨η, hη, δ₁, hδ₁, hJ⟩ :=
    Submission.fvmb_orthonormal_gram_sqrt_det_le_first_order P n A ε' hA0 hε'0
  obtain ⟨δ₂, hδ₂, hD⟩ := hφD η hη
  refine ⟨min δ₁ δ₂, lt_min hδ₁ hδ₂, fun t ht S hS => ?_⟩
  have ht₁ : |t| < δ₁ := ht.trans_le (min_le_left _ _)
  have ht₂ : |t| < δ₂ := ht.trans_le (min_le_right _ _)
  -- `θ 1_W` is integrable with integral `m`: `∫_{M ∩ W} θ dHⁿ = μ_V(W) < ∞`
  have hWm : MeasurableSet W := hWo.measurableSet
  have hθm : Measurable θ :=
    (measurable_from_nat (f := (Nat.cast : ℕ → ℝ))).comp R.measurable_mult
  have hRW' : R.measure W = ∫⁻ x in W, (R.mult x : ℝ≥0∞) ∂μ := withDensity_apply _ hWm
  have hθW : Integrable (W.indicator θ) μ := by
    rw [integrable_indicator_iff hWm]
    have := integrable_toReal_of_lintegral_ne_top (μ := μ.restrict W)
      (f := fun x => (R.mult x : ℝ≥0∞))
      ((measurable_from_nat (f := (Nat.cast : ℕ → ℝ≥0∞))).comp R.measurable_mult).aemeasurable
      (hRW' ▸ hRW)
    simpa [IntegrableOn, hθ] using this
  have hmW : ∫ x, W.indicator θ x ∂μ = m := by
    rw [integral_indicator hWm, integral_eq_lintegral_of_nonneg_ae (ae_of_all _ hθ0)
      hθm.aestronglyMeasurable, hm, hRW']
    simp only [hθ, ENNReal.ofReal_natCast]
  -- fix an admissible form `ω`; `g` is the integrand of `S(ω)` and `h` its majorant
  apply sSup_le
  rintro r ⟨ω, ⟨hωW, hω1⟩, rfl⟩
  apply ENNReal.ofReal_le_ofReal
  rw [hS ω]
  obtain ⟨g, hg⟩ : ∃ g : Euclid P → ℝ, g = fun x => (R.mult x : ℝ) * R.orient x
      (((ω : DifferentialForm (Euclid P) n) (φ t x)).compContinuousLinearMap
        (fderiv ℝ (φ t) x)) := ⟨_, rfl⟩
  obtain ⟨h, hh⟩ : ∃ h : Euclid P → ℝ,
      h = fun x => W.indicator θ x * (1 + ε' * |t|) + t * (θ x * dv x) := ⟨_, rfl⟩
  -- pointwise bounds at the a.e. points where `ξ(x)` orients `TₓM`
  have key : ∀ᵐ x ∂μ,
      g x ≤ h x ∧ 0 ≤ h x ∧ ‖θ x * dv x‖ ≤ ((n : ℝ) * A) * W.indicator θ x := by
    filter_upwards [Submission.fvmb_imrep_ae_unitOrientation_approxTangentPlane P n U R]
      with x hx
    obtain ⟨τ, hτ, hspan, hsign⟩ := hx
    -- `div_M X(x) = Σₐ τₐ · DX(x)τₐ`, hence `|div_M X(x)| ≤ nA`
    have hdvx : dv x = ∑ a, inner ℝ (τ a) (fderiv ℝ X x (τ a)) :=
      Submission.fvmb_trace_starProjection_comp_eq_sum_inner P n _ τ (fderiv ℝ X x) hτ hspan
    have hdvA : |dv x| ≤ n * A := by
      rw [hdvx]
      calc |∑ a, inner ℝ (τ a) (fderiv ℝ X x (τ a))|
          ≤ ∑ a, |inner ℝ (τ a) (fderiv ℝ X x (τ a))| := Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ _a : Fin n, A := Finset.sum_le_sum fun a _ => by
          calc |inner ℝ (τ a) (fderiv ℝ X x (τ a))|
              ≤ ‖τ a‖ * ‖fderiv ℝ X x (τ a)‖ := abs_real_inner_le_norm _ _
            _ ≤ ‖τ a‖ * (‖fderiv ℝ X x‖ * ‖τ a‖) :=
              mul_le_mul_of_nonneg_left (ContinuousLinearMap.le_opNorm _ _) (norm_nonneg _)
            _ ≤ A := by rw [hτ.1 a, one_mul, mul_one]; exact hDXA x
        _ = n * A := by simp
    by_cases hxW : x ∈ W
    · -- in `W`, with `β = ω(φₜx) ∘ Dφₜ(x)`:
      -- `|ξ(x)(β)| = |ω(φₜx)(Dφₜτ)| ≤ |ω|_E det(Dφₜτᵢ · Dφₜτⱼ)^{1/2} ≤ 1 + t div_M X + ε'|t|`
      obtain ⟨β, hβ⟩ : ∃ β : Covector (Euclid P) n,
          β = ((ω : DifferentialForm (Euclid P) n) (φ t x)).compContinuousLinearMap
            (fderiv ℝ (φ t) x) := ⟨_, rfl⟩
      have hξ : |R.orient x β| =
          |(ω : DifferentialForm (Euclid P) n) (φ t x) fun i => fderiv ℝ (φ t) x (τ i)| := by
        rcases hsign with hs | hs
        · rw [hs, hβ, ContinuousAlternatingMap.compContinuousLinearMap_apply]
          rfl
        · rw [hs, abs_neg, hβ, ContinuousAlternatingMap.compContinuousLinearMap_apply]
          rfl
      have hJx := hJ t ht₁ (fderiv ℝ X x) (fderiv ℝ (φ t) x) (hDXA x) (hD t ht₂ x) τ hτ
      rw [← hdvx] at hJx
      have hbound : |R.orient x β| ≤ 1 + t * dv x + ε' * |t| := by
        rw [hξ]
        refine ((Submission.covectorEuclideanNorm_gram_bounds P n).1 _ _).trans ?_
        exact (mul_le_of_le_one_left (Real.sqrt_nonneg _) (hω1 _)).trans hJx
      have hgx : g x = θ x * R.orient x β := by
        rw [hg, hβ]
      have hhx : h x = θ x * (1 + t * dv x + ε' * |t|) := by
        simp only [hh, Set.indicator_of_mem hxW]
        ring
      refine ⟨?_, ?_, ?_⟩
      · rw [hgx, hhx]
        exact mul_le_mul_of_nonneg_left ((le_abs_self _).trans hbound) (hθ0 x)
      · rw [hhx]
        exact mul_nonneg (hθ0 x) ((abs_nonneg _).trans hbound)
      · rw [Set.indicator_of_mem hxW, Real.norm_eq_abs, abs_mul, abs_of_nonneg (hθ0 x)]
        calc θ x * |dv x| ≤ θ x * (n * A) := mul_le_mul_of_nonneg_left hdvA (hθ0 x)
          _ = n * A * θ x := by ring
    · -- off `W`: `x ∉ spt X`, so `DX(x) = 0` and `φₜ x = x ∉ spt ω`
      have hxX : x ∉ tsupport X := fun hx => hxW (hXW hx)
      have hdv0 : dv x = 0 := by
        rw [hdvx, fderiv_of_notMem_tsupport ℝ hxX]
        simp
      have hω0 : (ω : DifferentialForm (Euclid P) n) (φ t x) = 0 := by
        rw [hφid t x hxX]
        exact image_eq_zero_of_notMem_tsupport fun hx => hxW (hωW hx)
      have hz : (0 : Covector (Euclid P) n).compContinuousLinearMap (fderiv ℝ (φ t) x) = 0 := by
        ext v
        simp
      have hg0 : g x = 0 := by
        simp only [hg, hω0, hz, map_zero, mul_zero]
      have hh0 : h x = 0 := by
        simp only [hh, Set.indicator_of_notMem hxW, hdv0, zero_mul, mul_zero, add_zero]
      refine ⟨by rw [hg0, hh0], by rw [hh0], ?_⟩
      rw [hdv0, Set.indicator_of_notMem hxW]
      simp
  -- integrate: `∫ g ≤ ∫ h = m (1 + ε'|t|) + t δV(X)` and `m ε' ≤ ε`
  have hθdv : Integrable (fun x => θ x * dv x) μ :=
    (hθW.const_mul ((n : ℝ) * A)).mono' (hθm.aestronglyMeasurable.mul hdvm)
      (key.mono fun x hx => hx.2.2)
  have hhint : Integrable h μ := by
    rw [hh]
    exact (hθW.mul_const _).add (hθdv.const_mul t)
  have hint_h : ∫ x, h x ∂μ = m * (1 + ε' * |t|) + t * R.firstVariation X := by
    simp only [hh]
    rw [integral_add (hθW.mul_const _) (hθdv.const_mul t), integral_mul_const,
      integral_const_mul, hmW]
    rfl
  have hgh : ∫ x, g x ∂μ ≤ ∫ x, h x ∂μ := by
    by_cases hgi : Integrable g μ
    · exact integral_mono_ae hgi hhint (key.mono fun x hx => hx.1)
    · rw [integral_undef hgi]
      exact integral_nonneg_of_ae (key.mono fun x hx => hx.2.1)
  have hεm : m * ε' ≤ ε := by
    rw [hε', mul_div_assoc', div_le_iff₀ (by linarith)]
    nlinarith
  have hεm' : m * ε' * |t| ≤ ε * |t| := mul_le_mul_of_nonneg_right hεm (abs_nonneg t)
  calc ∫ x, (R.mult x : ℝ) * R.orient x
        (((ω : DifferentialForm (Euclid P) n) (φ t x)).compContinuousLinearMap
          (fderiv ℝ (φ t) x)) ∂μ = ∫ x, g x ∂μ := by rw [hg]
    _ ≤ ∫ x, h x ∂μ := hgh
    _ = m * (1 + ε' * |t|) + t * R.firstVariation X := hint_h
    _ = m + t * R.firstVariation X + m * ε' * |t| := by ring
    _ ≤ m + t * R.firstVariation X + ε * |t| := by linarith

/-- **Simon 6.3.7** (the approximate tangent space of `φ(M)` at `φ(x)` is spanned by the images
`Dφ(x)(τᵢ)`), for the `C¹` diffeomorphism push-forward used in the low-density regularity argument
(7.4.2–7.4.4): if `φ` is `C¹` and bi-Lipschitz with injective derivative and `φ⁻¹(U) = U`, then for
`Hⁿ`-a.e. `x ∈ M`, `M` has the approximate tangent space `Q(x) = approxTangentPlane n M x` at `x`
and `φ(M)` has the approximate tangent space `Dφ(x)(Q(x))` at `φ(x)`.  `M` is, up to an
`Hⁿ`-null set, the union of bi-Lipschitz pieces `Fᵢ(Bᵢ)`; for a.e. `b ∈ Bᵢ`,
`T_{Fᵢ(b)}M = range DFᵢ(b)` and `T_{φ(Fᵢ(b))}φ(M) = range D(φ ∘ Fᵢ)(b) = Dφ(Fᵢ(b))(range DFᵢ(b))`
(density lemma for both `Fᵢ` and `φ ∘ Fᵢ`), and Lipschitz images of null parameter sets are
`Hⁿ`-null. -/
theorem Submission.codim1_ldr_dpf_approxTangent_bilipschitz_image_ae : ∀ (P n : ℕ) (U M : Set (Euclid P)) (φ : Euclid P → Euclid P) (Λ : NNReal), IsOpen U → MeasurableSet M → M ⊆ U → CountablyRectifiable n M → (∀ C : Set (Euclid P), IsCompact C → C ⊆ U → μHE[n] (M ∩ C) ≠ ∞) → ContDiff ℝ 1 φ → (∀ x, Injective (fderiv ℝ φ x)) → LipschitzWith Λ φ → AntilipschitzWith Λ φ → φ ⁻¹' U = U → ∀ᵐ x ∂(μHE[n].restrict M), HasApproximateTangentSpaceAt n M x (approxTangentPlane n M x) ∧ HasApproximateTangentSpaceAt n (φ '' M) (φ x) (Submodule.map (fderiv ℝ φ x : Euclid P →ₗ[ℝ] Euclid P) (approxTangentPlane n M x)) := by
  intro P n U M φ Λ hU hM hMU hrect hloc hφ hφinj hlip hanti hpre
  -- Step 1: bi-Lipschitz pieces `Fᵢ(Bᵢ) ⊆ M` covering `M` up to an `Hⁿ`-null set
  obtain ⟨F, B, m, hFlip, hBmeas, hmpos, hFlow, hFdiff, -, hFM, -, hnull⟩ :=
    Submission.dpf_rectifiable_bilipschitz_pieces P n M hM hrect
  -- Step 3: `φ(M)` is Borel, contained in `U` and locally `Hⁿ`-finite in `U`
  obtain ⟨hφMmeas, hφMU, hφMloc⟩ :=
    Submission.dpf_itt_bilipschitz_image_locfin P n U M φ Λ Λ hM hMU hloc hlip hanti hpre
  -- Step 6: it suffices to prove the conclusion at `Fᵢ(b)` for a.e. `b ∈ Bᵢ`
  refine Submission.dpf_itt_ae_of_ae_pieces P n M F B _ hM hFlip hnull fun i => ?_
  obtain ⟨L, hL⟩ := hFlip i
  -- Step 4: `φ ∘ Fᵢ` is bi-Lipschitz on `Bᵢ`, with injective derivative of range
  -- `Dφ(Fᵢ(b))(range DFᵢ(b))`
  obtain ⟨hφFlip, ⟨m', hm'pos, hφFlow⟩, hφFdiff, hrange⟩ :=
    Submission.dpf_itt_comp_bilipschitz_piece P n (F i) φ (B i) L Λ Λ (m i) hL (hmpos i)
      (hFlow i) (hFdiff i) (hφ.differentiable one_ne_zero) hφinj hlip hanti
  -- Step 2: `T_{Fᵢ(b)}M = range DFᵢ(b)` for a.e. `b ∈ Bᵢ`
  have hM_ae := Submission.codim1_ldr_dpf_approxTangent_ae_bilipschitz_piece P n U M (F i) (B i)
    L (m i) hU hM hMU hloc hL (hBmeas i) (hmpos i) (hFlow i) (hFdiff i) (hFM i)
  -- Step 4: `T_{φ(Fᵢ(b))}φ(M) = range D(φ ∘ Fᵢ)(b)` for a.e. `b ∈ Bᵢ`
  have hφM_ae := Submission.codim1_ldr_dpf_approxTangent_ae_bilipschitz_piece P n U (φ '' M)
    (φ ∘ F i) (B i) (Λ * L) m' hU hφMmeas hφMU hφMloc hφFlip (hBmeas i) hm'pos hφFlow hφFdiff
    (by rw [image_comp]; exact image_mono (hFM i))
  -- Step 5: combine, using `Q(Fᵢ(b)) = range DFᵢ(b)` (uniqueness of approximate tangent planes)
  filter_upwards [hM_ae, hφM_ae, ae_restrict_mem (hBmeas i)] with b hb hφb hbB
  rw [Submission.dpf_itt_approxTangentPlane_eq P n M (F i b) _ hb, ← hrange b hbB]
  exact ⟨hb, hφb⟩
/-- **Simon Ch. 3, 2.3–2.6 (area formula, 2.6)** (chapter-03.txt lines 362–411) for an injective
Lipschitz `C¹` map `φ` on a countably `n`-rectifiable `M`, with the tangential Jacobian
`J(x) = (det(Dφ(x)eₐ · Dφ(x)e_b))^{1/2}`, `e` the standard orthonormal basis of `TₓM`:
`∫_{φ(M)} g dHⁿ = ∫_M J (g ∘ φ) dHⁿ` for every `g ≥ 0`, measurable or not.  Proved through
bi-Lipschitz pieces instead of Simon's `C¹` pieces: `M` is, up to an `Hⁿ`-null set, the disjoint
union of Borel pieces `Pᵢ = Fᵢ(Bᵢ)`; for a.e. `b ∈ Bᵢ`, `T_{Fᵢ b}M = range DFᵢ(b)` (density lemma
and uniqueness of approximate tangent planes).  Both sides split along the pieces (for `φ`, and
for `id`), and on each piece the Lipschitz area formula for `φ ∘ Fᵢ` and for `Fᵢ` together with
`normDet (S ∘ T) = normDet (S|_{range T}) · normDet T` and the Gram identity match the terms. -/
theorem Submission.codim1_ldr_dpf_area_formula_bilipschitz_rectifiable : ∀ (P n : ℕ) (U M : Set (Euclid P)) (φ : Euclid P → Euclid P) (Λ : NNReal), IsOpen U → MeasurableSet M → M ⊆ U → CountablyRectifiable n M → (∀ C : Set (Euclid P), IsCompact C → C ⊆ U → μHE[n] (M ∩ C) ≠ ∞) → ContDiff ℝ 1 φ → LipschitzWith Λ φ → Injective φ → ∀ g : Euclid P → ℝ≥0∞, ∫⁻ y in φ '' M, g y ∂μHE[n] = ∫⁻ x in M, ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ (approxTangentPlane n M x)) => inner ℝ (fderiv ℝ φ x (stdOrthonormalBasis ℝ (approxTangentPlane n M x) i)) (fderiv ℝ φ x (stdOrthonormalBasis ℝ (approxTangentPlane n M x) j))))) * g (φ x) ∂μHE[n] := by
  intro P n U M φ Λ hU hM hMU hrect hloc hφ1 hφ hφinj g
  -- Step 1: disjoint Borel bi-Lipschitz pieces `Fᵢ(Bᵢ) ⊆ M`, covering `M` up to an `Hⁿ`-null set
  obtain ⟨F, B, m, hF, hB, hm, hlow, hdiff, hFBm, hFB, hdisj, hnull⟩ :=
    Submission.dpf_rectifiable_bilipschitz_pieces P n M hM hrect
  -- `Fᵢ` is injective on `Bᵢ`: `mᵢ‖a - a'‖ ≤ ‖Fᵢ a - Fᵢ a'‖` with `mᵢ > 0`
  have hinj : ∀ i, InjOn (F i) (B i) := by
    intro i a ha a' ha' h
    have h1 := hlow i a ha a' ha'
    rw [h, sub_self, norm_zero] at h1
    exact sub_eq_zero.mp (norm_le_zero_iff.mp (nonpos_of_mul_nonpos_right h1 (hm i)))
  -- Step 2: `Q(Fᵢ b) = range DFᵢ(b)` for a.e. `b ∈ Bᵢ`: by the density lemma `M` has approximate
  -- tangent space `range DFᵢ(b)` at `Fᵢ b`, and approximate tangent spaces are unique
  have htan : ∀ i, ∀ᵐ b ∂(volume.restrict (B i)), approxTangentPlane n M (F i b) =
      LinearMap.range (fderiv ℝ (F i) b : Euclid n →ₗ[ℝ] Euclid P) := by
    intro i
    obtain ⟨L, hL⟩ := hF i
    filter_upwards [Submission.codim1_ldr_dpf_approxTangent_ae_bilipschitz_piece P n U M (F i)
      (B i) L (m i) hU hM hMU hloc hL (hB i) (hm i) (hlow i) (hdiff i) (hFB i)] with b hb
    have hex : ∃ Q, HasApproximateTangentSpaceAt n M (F i b) Q := ⟨_, hb⟩
    rw [approxTangentPlane, dite_eq_left hex]
    exact hex.choose_spec.unique hb
  -- Step 4: split both sides along the pieces (`φ`, resp. `id`, is Lipschitz and injective)
  have hsplit : ∀ w : Euclid P → ℝ≥0∞,
      ∫⁻ x in M, w x ∂μHE[n] = ∑' i, ∫⁻ x in F i '' B i, w x ∂μHE[n] := fun w => by
    simpa only [image_id] using Submission.dpf_raf_lintegral_image_eq_tsum_pieces P n M
      (fun i => F i '' B i) id 1 hFBm hFB hdisj hnull LipschitzWith.id injective_id w
  rw [Submission.dpf_raf_lintegral_image_eq_tsum_pieces P n M (fun i => F i '' B i) φ Λ hFBm hFB
    hdisj hnull hφ hφinj g, hsplit]
  -- Steps 3, 5 and 6: the area identity on each piece, with `Q = approxTangentPlane n M`, summed
  refine tsum_congr fun i => ?_
  obtain ⟨L, hL⟩ := hF i
  exact Submission.dpf_raf_piece_area_formula_gram P n (approxTangentPlane n M) φ Λ (F i) L (B i)
    (hφ1.differentiable one_ne_zero) hφ hL (hB i) (hinj i) hφinj.injOn (htan i) g

/-- Simon 6.3.6–3.9 and 6.2.24(3) for a `C¹` bi-Lipschitz bijection `φ` with `φ⁻¹(U) = U` (the
image representation of the diffeomorphism push-forward used for the low-density regularity of
7.4.2–7.4.4 in 7.5.8): `ω ↦ ∫_M θ ⟨ω(φ(x)) ∘ Dφ(x), ξ⟩ dHⁿ` is the action of the integer
multiplicity triple `R' = (φ(M), θ ∘ φ⁻¹, η ∘ φ⁻¹)`, where `η = J⁻¹ ξ(· ∘ Dφ)` and `J` is the Gram
Jacobian of `Dφ` on `TₓM`.  A.e. on `M`, `0 < J` and `η(x)` orients `Dφ(x)TₓM = T_{φ(x)}φ(M)`
(by `R.orients` and uniqueness of approximate tangent planes); the area formula on `φ(M)` then
transfers the action from `φ(M)` to `M`. -/
theorem Submission.codim1_ldr_dpf_imrep_bilipschitz_image_rep : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (φ : Euclid P → Euclid P) (Λ : NNReal), IsOpen U → ContDiff ℝ 1 φ → Bijective φ → (∀ x, Injective (fderiv ℝ φ x)) → LipschitzWith Λ φ → AntilipschitzWith Λ φ → φ ⁻¹' U = U → AEStronglyMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) (μHE[n].restrict R.carrier) → ∃ R' : IMRep U n, ∀ ω : TestFormOn U n, R'.action (ω : DifferentialForm (Euclid P) n) = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (φ x)).compContinuousLinearMap (fderiv ℝ φ x)) ∂μHE[n] := by
  intro P n U R φ Λ hU hφ hbij hinj hlip hanti hpre hproj
  -- Step 2: `θ ≥ 1` on `M`, so `M` has locally finite `Hⁿ`-measure in `U`
  have hfin : ∀ C : Set (Euclid P), IsCompact C → C ⊆ U → μHE[n] (R.carrier ∩ C) ≠ ∞ := by
    intro C hC hCU
    refine ne_top_of_le_ne_top (R.locallyIntegrable_mult C hC hCU) ?_
    calc μHE[n] (R.carrier ∩ C) = ∫⁻ _ in R.carrier ∩ C, 1 ∂μHE[n] := (setLIntegral_one _).symm
      _ ≤ ∫⁻ x in R.carrier ∩ C, (R.mult x : ℝ≥0∞) ∂μHE[n] :=
        setLIntegral_mono' (R.measurableSet_carrier.inter hC.isClosed.measurableSet)
          fun x hx => Nat.one_le_cast.2 (R.mult_pos x hx.1)
  have hφc : Continuous φ := hφ.continuous
  have hDφ : Continuous (fderiv ℝ φ) := hφ.continuous_fderiv one_ne_zero
  -- Step 3 (I): the Gram Jacobian `J` of `Dφ` on `TₓM` is a.e. strongly measurable
  obtain ⟨J, hJ⟩ : ∃ J : Euclid P → ℝ, J = fun x => Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (Module.finrank ℝ (approxTangentPlane n R.carrier x)) => inner ℝ (fderiv ℝ φ x (stdOrthonormalBasis ℝ (approxTangentPlane n R.carrier x) i)) (fderiv ℝ φ x (stdOrthonormalBasis ℝ (approxTangentPlane n R.carrier x) j)))) :=
    ⟨_, rfl⟩
  have hJm : AEStronglyMeasurable J (μHE[n].restrict R.carrier) := by
    rw [hJ]
    exact Submission.dpf_aestronglyMeasurable_gramJacobian P (μHE[n].restrict R.carrier)
      (approxTangentPlane n R.carrier) (fderiv ℝ φ) hproj hDφ.aestronglyMeasurable
  -- Step 4: the orientation `η = J⁻¹ ζ`, `ζ(x)(β) = ξ(x)(β ∘ Dφ(x))`, in source coordinates
  set η : Euclid P → MultiVector P n := fun x => (J x)⁻¹ •
    (R.orient x).comp (ContinuousAlternatingMap.compContinuousLinearMapCLM (fderiv ℝ φ x))
  have hηm : AEStronglyMeasurable η (μHE[n].restrict R.carrier) := by
    have hζ : AEStronglyMeasurable (fun x => (R.orient x).comp
        (ContinuousAlternatingMap.compContinuousLinearMapCLM (fderiv ℝ φ x)))
        (μHE[n].restrict R.carrier) :=
      (continuous_fst.clm_comp continuous_snd).comp_aestronglyMeasurable
        (R.aestronglyMeasurable_orient.prodMk
          (ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM.comp_aestronglyMeasurable
            hDφ.aestronglyMeasurable))
    exact hJm.aemeasurable.inv.aestronglyMeasurable.smul hζ
  -- Step 3: a.e. on `M`, `0 < J` and `η` orients `Dφ(x)TₓM`, the approximate tangent plane of
  -- `φ(M)` at `φ(x)` (`ξ(x)` orients `TₓM` by uniqueness of approximate tangent planes)
  have hgood : ∀ᵐ x ∂(μHE[n].restrict R.carrier), 0 < J x ∧ ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n (φ '' R.carrier) (φ x) Q ∧ IsUnitOrientationOf (η x) Q := by
    filter_upwards [Submission.codim1_ldr_dpf_approxTangent_bilipschitz_image_ae P n U R.carrier
      φ Λ hU R.measurableSet_carrier R.carrier_subset R.rectifiable hfin hφ hinj hlip hanti hpre,
      R.orients] with x hx hξ
    obtain ⟨Q, hQ, hξQ⟩ := hξ
    rw [hQ.unique hx.1] at hξQ
    obtain ⟨hJpos, -, hηQ⟩ := Submission.dpf_unitOrientation_map_gramNormalized P n
      (approxTangentPlane n R.carrier x) (R.orient x) (fderiv ℝ φ x) (J x) hξQ (hinj x)
      (by rw [hJ])
    exact ⟨hJpos, _, hx.2, hηQ⟩
  -- Step 5: `R' = (φ(M), θ ∘ φ⁻¹, η ∘ φ⁻¹)` is an integer multiplicity triple in `U`
  obtain ⟨R', hR'c, hR'⟩ := Submission.dpfir_bilipschitz_image_imrep_exists P n U R φ Λ η hbij
    hlip hanti hpre hηm (hgood.mono fun x hx => hx.2)
  refine ⟨R', fun ω => ?_⟩
  obtain ⟨w, ⟨hws, hwc⟩, hwU⟩ := ω
  show R'.action w = ∫ x in R.carrier,
    (R.mult x : ℝ) * R.orient x ((w (φ x)).compContinuousLinearMap (fderiv ℝ φ x)) ∂μHE[n]
  have hwcont : Continuous w := ContDiff.continuous hws
  -- Step 6(b): `β(x) = ω(φ(x)) ∘ Dφ(x)` is continuous with compact support `⊆ φ⁻¹(spt ω) ⊆ U`
  set β : Euclid P → Covector (Euclid P) n :=
    fun x => (w (φ x)).compContinuousLinearMap (fderiv ℝ φ x) with hβ
  have hβc : Continuous β :=
    (ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM.comp hDφ).clm_apply
      (hwcont.comp hφc)
  have hβsupp : tsupport β ⊆ φ ⁻¹' tsupport w := by
    refine closure_minimal (fun x hx => subset_tsupport w fun h0 => hx ?_)
      ((isClosed_tsupport w).preimage hφc)
    ext v
    simp [hβ, h0]
  have hβcs : HasCompactSupport β :=
    (Metric.isCompact_of_isClosed_isBounded ((isClosed_tsupport w).preimage hφc)
      (hanti.isBounded_preimage hwc.isCompact.isBounded)).of_isClosed_subset
      (isClosed_tsupport β) hβsupp
  have hβU : tsupport β ⊆ U := hβsupp.trans ((preimage_mono hwU).trans hpre.subset)
  -- Step 6(a): `J(x) h(φ(x)) = g_ω(x)` a.e. on `M`, where `h = θ'⟨ω, ξ'⟩` and `g_ω = θ⟨β, ξ⟩`
  have hJh : ∀ᵐ x ∂(μHE[n].restrict R.carrier),
      J x * ((R'.mult (φ x) : ℝ) * R'.orient (φ x) (w (φ x))) =
        (R.mult x : ℝ) * R.orient x (β x) := by
    filter_upwards [hgood] with x hx
    obtain ⟨hmult, horient⟩ := hR' x
    have hηx : η x (w (φ x)) = (J x)⁻¹ * R.orient x (β x) := rfl
    rw [hmult, horient, hηx, mul_left_comm, mul_inv_cancel_left₀ hx.1.ne']
  -- Step 6(c)–(d): the area formula on `φ(M)` transfers integrability and the integral
  have harea : ∀ g : Euclid P → ℝ≥0∞, ∫⁻ y, g y ∂(μHE[n].restrict R'.carrier) =
      ∫⁻ x, ENNReal.ofReal (J x) * g (φ x) ∂(μHE[n].restrict R.carrier) := by
    intro g
    rw [hR'c, hJ]
    exact Submission.codim1_ldr_dpf_area_formula_bilipschitz_rectifiable P n U R.carrier φ Λ hU
      R.measurableSet_carrier R.carrier_subset R.rectifiable hfin hφ hlip hbij.1 g
  exact (Submission.dpfir_integral_eq_of_area_lintegral P (μHE[n].restrict R.carrier)
    (μHE[n].restrict R'.carrier) φ J (fun y => (R'.mult y : ℝ) * R'.orient y (w y))
    (fun x => (R.mult x : ℝ) * R.orient x (β x)) (fun x => by rw [hJ]; exact Real.sqrt_nonneg _)
    harea (Submission.dpfir_imrep_pairing_continuous_integrable P n U R' w hwcont hwc
      hwU).aestronglyMeasurable
    (Submission.dpfir_imrep_pairing_continuous_integrable P n U R β hβc hβcs hβU) hJh).2

/-- **Push-forward of an integer multiplicity current by a `C¹` diffeomorphism** (Simon Ch. 6,
2.23–2.24 and 3.3–3.9; the competitor `φ_#T` of the stationarity argument of 7.1.2, as used in
the proof of 7.5.8).
Let `T = τ(M, θ, ξ)` and let `φ` be a `C¹` bijection of `ℝᴾ` with `Dφ(x)` injective for every
`x` and `φ = id` off a compact `K ⊆ U`.  Then `S(ω) = ∫_M θ ⟨ω(φ(x)) ∘ Dφ(x), ξ(x)⟩ dHⁿ` defines
a current `S = φ_#T` (`Submission.dpf_pushforward_formula_current_exists`).  `φ` is bi-Lipschitz
with `φ⁻¹(U) = U` (`Submission.dpf_c1_compact_perturbation_bilipschitz`), so by the area formula
and the transport `T_{φ(x)}φ(M) = Dφ(x) TₓM` of approximate tangent planes,
`S = τ(φ(M), θ ∘ φ⁻¹, ξ')` with the induced orientation `ξ'` of 3.5/3.7
(`Submission.codim1_ldr_dpf_imrep_bilipschitz_image_rep`, which needs `x ↦ p_{TₓM}` measurable:
`Submission.imrep_approxTangent_starProjection_aesm`).  Hence `S` is integer multiplicity.
Finally `∂S = 0` if `∂T = 0` (2.24(1), by smooth approximation of `φ`:
`Submission.dpf_pushforward_formula_boundaryVanishes`). -/
theorem Submission.codim1_ldr_imrep_c1_diffeo_pushforward_im : ∀ (P n : ℕ) (U K : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n) (φ : Euclid P → Euclid P), IsOpen U → R.Represents T → IsCompact K → K ⊆ U → ContDiff ℝ 1 φ → Bijective φ → (∀ x, Injective (fderiv ℝ φ x)) → (∀ x, x ∉ K → φ x = x) → ∃ S : GeometricCurrentOn U n, IsIntegerMultiplicity S ∧ (BoundaryVanishes T → BoundaryVanishes S) ∧ ∀ ω : TestFormOn U n, S ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (φ x)).compContinuousLinearMap (fderiv ℝ φ x)) ∂μHE[n] := by
  intro P n U K T R φ hU hR hK hKU hφ hbij hinj hid
  -- step 1: `φ` is bi-Lipschitz and `φ⁻¹(U) = U`
  obtain ⟨Λ, hLip, hAnti, hpre⟩ :=
    Submission.dpf_c1_compact_perturbation_bilipschitz P U K φ hK hKU hφ hbij hinj hid
  -- step 2: the push-forward integral is the action of a current `S`
  obtain ⟨S, hS⟩ := Submission.dpf_pushforward_formula_current_exists P n U K R φ hK hKU hφ hid
  -- steps 4–9: an integer multiplicity triple `R'` on `φ(M)` has the same action, so it
  -- represents `S`
  obtain ⟨R', hR'⟩ := Submission.codim1_ldr_dpf_imrep_bilipschitz_image_rep P n U R φ Λ hU hφ
    hbij hinj hLip hAnti hpre (Submission.imrep_approxTangent_starProjection_aesm P n U R)
  -- step 3: `∂S = 0` if `∂T = 0`
  exact ⟨S, ⟨R', fun ω => (hS ω).trans (hR' ω).symm⟩,
    Submission.dpf_pushforward_formula_boundaryVanishes P n U K T S R φ hU hR hK hKU hφ hid hS, hS⟩

/-- **Simon 7.1.2, first claim (pp. 181–182).**  If `T ∈ 𝒟ₙ(U)` is minimizing in `N ∩ U`
(`N` an embedded `C²` submanifold, `(N̄ \ N) ∩ U = ∅`), `∂T = 0` in `U`, and `T = τ(M, θ, ξ)` with
`Hⁿ(M \ N) = 0`, then `V = v(M, θ)` is stationary in `N ∩ U`.  Fix `X` tangent to `N`,
`K = spt X` and an open `W ⊂⊂ U` containing `K`, so that `M_W(T) = μ_V(W) < ∞`.  If `μ_V(W) = 0`
then `div_M X = 0` `Hⁿ`-a.e. on `M`.  Otherwise the tangential deformations `φ_t` push `T` forward
to integer multiplicity `S_t` with `∂S_t = 0` and `spt(S_t − T) ⊆ K ∩ N` (compact, as
`Hⁿ(M \ N) = 0`), so minimality and the first variation expansion give
`μ_V(W) ≤ M_W(S_t) ≤ μ_V(W) + t δV(X) + ε|t|` for all small `t` of both signs, which forces
`δV(X) = 0`.  The degree `n = 0` needs no separate case: there `∂S = ∂T` holds vacuously. -/
theorem Submission.codim1_ldr_stationaryAlong_of_minimizing : ∀ (P n d : ℕ) (U N : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → IsEmbeddedSubmanifold 2 d N → (closure N \ N) ∩ U = ∅ → IsMinimizingIn T (N ∩ U) → BoundaryVanishes T → R.Represents T → μHE[n] (R.carrier \ N) = 0 → R.IsStationaryAlong N := by
  intro P n d U N T R hU hN hNU hmin hT hR hMN X hX hXc hXU hXN
  -- `∂S₁ = 0 = ∂S₂` gives `∂S₁ = ∂S₂` (vacuous in degree `0`).
  have hsame : ∀ {m : ℕ} (S₁ S₂ : GeometricCurrentOn U m), BoundaryVanishes S₁ →
      BoundaryVanishes S₂ → SameBoundary S₁ S₂ := by
    intro m S₁ S₂ h₁ h₂
    cases m with
    | zero => trivial
    | succ m => exact (show S₁.boundary = 0 from h₁).trans (show S₂.boundary = 0 from h₂).symm
  -- An open `W ⊂⊂ U` containing `K = spt X`, with `μ_V(W) < ∞` and `M_W(T) = μ_V(W)`.
  obtain ⟨W, hWo, hKW, hWU, hWc⟩ := exists_open_between_and_isCompact_closure hXc hU hXU
  have hWm : MeasurableSet W := hWo.measurableSet
  have hRW : R.measure W = ∫⁻ x in W, (R.mult x : ℝ≥0∞) ∂(μHE[n].restrict R.carrier) := by
    rw [IMRep.measure, withDensity_apply _ hWm]
  have hRWfin : R.measure W ≠ ∞ := by
    rw [hRW, Measure.restrict_restrict hWm]
    refine ne_top_of_le_ne_top (R.locallyIntegrable_mult _ hWc hWU) (lintegral_mono_set ?_)
    exact fun x hx => ⟨hx.2, subset_closure hx.1⟩
  have hTW : T.massOn W = R.measure W :=
    (Submission.dor_imrep_massOn_eq_measure_and_support P n U T R hU hR).1 W hWo
  -- If `μ_V(W) = 0`, then `Hⁿ(M ∩ W) = 0` (`θ ≥ 1` on `M`) and `DX = 0` off `W`, so
  -- `div_M X = 0` a.e. on `M`.
  by_cases hW0 : R.measure W = 0
  · have hMW : μHE[n].restrict R.carrier W = 0 := by
      refine le_antisymm ?_ bot_le
      calc μHE[n].restrict R.carrier W
          = ∫⁻ _ in W, 1 ∂(μHE[n].restrict R.carrier) := (setLIntegral_one W).symm
        _ ≤ ∫⁻ x in W, (R.mult x : ℝ≥0∞) ∂(μHE[n].restrict R.carrier) := by
          refine lintegral_mono_ae ?_
          filter_upwards [ae_restrict_of_ae (ae_restrict_mem R.measurableSet_carrier)] with x hx
          exact Nat.one_le_cast.2 (R.mult_pos x hx)
        _ = 0 := by rw [← hRW, hW0]
    rw [IMRep.firstVariation]
    refine integral_eq_zero_of_ae ?_
    filter_upwards [measure_eq_zero_iff_ae_notMem.1 hMW] with x hx
    have hDX : fderiv ℝ X x = 0 := fderiv_of_notMem_tsupport ℝ fun h => hx (hKW h)
    simp [tangentialDivergence, hDX]
  have hm : 0 < (R.measure W).toReal := ENNReal.toReal_pos hW0 hRWfin
  -- The deformations `φ_t` along `N`, fixing `ℝᴾ \ K` pointwise.
  obtain ⟨φ, hφ, hφD⟩ :=
    Submission.tangential_c1_deformation_exists P d U N X hU hN hNU hX hXc hXU hXN
  -- `K ∩ N = K ∩ N̄` is compact, since `(N̄ \ N) ∩ U = ∅` and `K ⊆ U`.
  have hKNc : IsCompact (tsupport X ∩ N) := by
    have h : tsupport X ∩ N = tsupport X ∩ closure N := by
      refine Subset.antisymm (inter_subset_inter_right _ subset_closure) ?_
      rintro x ⟨hxK, hxN⟩
      refine ⟨hxK, ?_⟩
      by_contra h
      exact hNU.subset ⟨⟨hxN, h⟩, hXU hxK⟩
    rw [h]
    exact hXc.inter_right isClosed_closure
  -- Every push-forward `S = φ_{t#}T` is an admissible competitor in 7.1.1 with this `W`, so
  -- `μ_V(W) ≤ M_W(S)`.
  have hcomp : ∀ (t : ℝ) (S : GeometricCurrentOn U n), IsIntegerMultiplicity S →
      BoundaryVanishes S →
      (∀ ω : TestFormOn U n, S ω = ∫ x in R.carrier, (R.mult x : ℝ) *
        R.orient x (((ω : DifferentialForm (Euclid P) n) (φ t x)).compContinuousLinearMap
          (fderiv ℝ (φ t) x)) ∂μHE[n]) →
      R.measure W ≤ S.massOn W := by
    intro t S hSi hSb hSω
    -- `φ_t` is injective and fixes `ℝᴾ \ K` pointwise, so it maps `K` into `K`.
    have hφK : ∀ x ∈ tsupport X, φ t x ∈ tsupport X := by
      intro x hx
      by_contra h
      have hfix : φ t x = x := (hφ t).2.1.1 ((hφ t).2.2.2.1 _ h)
      exact h (by rwa [hfix])
    -- `spt(S − T) ⊆ K ∩ N`: near `y ∉ K ∩ N` the integrands of `S ω` and `T ω` agree at every
    -- point of `M ∩ N`, hence `Hⁿ`-a.e. on `M`.
    have hsub : (S - T).support ⊆ tsupport X ∩ N := by
      intro y hy
      by_contra hyKN
      obtain ⟨ε, hε, hεU⟩ :=
        Metric.isOpen_iff.1 (hU.inter hKNc.isClosed.isOpen_compl) y ⟨hy.1, hyKN⟩
      have hcl : closure (ball y (ε / 2)) ⊆ ball y ε :=
        closure_ball_subset_closedBall.trans (closedBall_subset_ball (half_lt_self hε))
      have hball : ball y (ε / 2) ∈ {V : Set (Euclid P) | IsOpen V ∧ IsCompact (closure V) ∧
          closure V ⊆ U ∧ (S - T).VanishesOn V} := by
        refine ⟨isOpen_ball,
          (isCompact_closedBall y (ε / 2)).closure_of_subset ball_subset_closedBall,
          fun z hz => (hεU (hcl hz)).1, ?_⟩
        intro ω hω
        have hω0 : ∀ z ∈ tsupport X ∩ N, (ω : DifferentialForm (Euclid P) n) z = 0 :=
          fun z hz => image_eq_zero_of_notMem_tsupport fun hzω =>
            (hεU (ball_subset_ball (half_le_self hε.le) (hω hzω))).2 hz
        change S ω - T ω = 0
        rw [hSω ω, hR ω, IMRep.action, sub_eq_zero]
        refine setIntegral_congr_ae R.measurableSet_carrier ?_
        filter_upwards [measure_eq_zero_iff_ae_notMem.1 hMN] with x hxMN hxM
        have hxN : x ∈ N := by
          by_contra h
          exact hxMN ⟨hxM, h⟩
        have harg : ((ω : DifferentialForm (Euclid P) n) (φ t x)).compContinuousLinearMap
            (fderiv ℝ (φ t) x) = (ω : DifferentialForm (Euclid P) n) x := by
          by_cases hxK : x ∈ tsupport X
          · -- `x` and `φ_t x` lie in `K ∩ N`, where `ω` vanishes.
            rw [hω0 x ⟨hxK, hxN⟩, hω0 (φ t x) ⟨hφK x hxK, ((hφ t).2.2.2.2 ⟨hxN, hXU hxK⟩).1⟩]
            ext v
            simp
          · -- `φ_t = id` near `x ∉ K`.
            have hφx : φ t =ᶠ[𝓝 x] id := by
              filter_upwards [(isClosed_tsupport X).isOpen_compl.mem_nhds hxK] with z hz
              exact (hφ t).2.2.2.1 z hz
            rw [hφx.fderiv_eq, fderiv_id, (hφ t).2.2.2.1 x hxK]
            ext v
            simp
        rw [harg]
      exact hy.2 (mem_sUnion_of_mem (mem_ball_self (half_pos hε)) hball)
    -- `spt(S − T)` is relatively closed in `U` and lies in the compact `K ∩ N ⊆ U`.
    have hSTc : IsCompact (S - T).support := by
      have h : (S - T).support = (tsupport X ∩ N) ∩ ((S - T).zeroRegion)ᶜ :=
        Subset.antisymm (fun y hy => ⟨hsub hy, hy.2⟩) fun y hy => ⟨hXU hy.1.1, hy.2⟩
      rw [h]
      exact hKNc.inter_right (S - T).isOpen_zeroRegion.isClosed_compl
    rw [← hTW]
    exact hmin.2 W S hWo ⟨hWc, hWU⟩ hSi (hsame S T hSb hT) hSTc fun y hy =>
      ⟨⟨(hsub hy).2, hXU (hsub hy).1⟩, hKW (hsub hy).1⟩
  -- The expansion `M_W(φ_{t#}T) ≤ μ_V(W) + t δV(X) + ε|t|` for `|t| < δ`, used with `t = ±δ/2`,
  -- gives `|δV(X)| ≤ ε`.
  have hbound : ∀ ε : ℝ, 0 < ε → |R.firstVariation X| ≤ ε := by
    intro ε hε
    obtain ⟨δ, hδ, hδS⟩ := Submission.codim1_ldr_pushforward_massOn_le_first_variation P n U W R
      X φ hWo hRWfin hX hXc hKW (fun t => (hφ t).1) (fun t => (hφ t).2.2.2.1) hφD ε hε
    have key : ∀ t : ℝ, |t| < δ → 0 ≤ t * R.firstVariation X + ε * |t| := by
      intro t ht
      obtain ⟨S, hSi, hSb, hSω⟩ := Submission.codim1_ldr_imrep_c1_diffeo_pushforward_im P n U
        (tsupport X) T R (φ t) hU hR hXc hXU (hφ t).1 (hφ t).2.1 (hφ t).2.2.1 (hφ t).2.2.2.1
      have h := (ENNReal.ofReal_toReal hRWfin).le.trans
        ((hcomp t S hSi (hSb hT) hSω).trans (hδS t ht S hSω))
      by_contra hneg
      exact not_lt.2 h ((ENNReal.ofReal_lt_ofReal_iff hm).2 (by linarith [not_le.1 hneg]))
    have h₁ := key (δ / 2) (by rw [abs_of_pos (half_pos hδ)]; exact half_lt_self hδ)
    have h₂ := key (-(δ / 2)) (by rw [abs_neg, abs_of_pos (half_pos hδ)]; exact half_lt_self hδ)
    rw [abs_of_pos (half_pos hδ)] at h₁
    rw [abs_neg, abs_of_pos (half_pos hδ)] at h₂
    rw [abs_le]
    constructor <;> nlinarith
  by_contra ha
  have h := hbound (|R.firstVariation X| / 2) (half_pos (abs_pos.2 ha))
  linarith [abs_pos.2 ha]

namespace Submission

end Submission

/-- **Simon Ch. 6, 2.5 and 3.2(3)**, upper bound: if `T(ω) = ∫_{M'} θ' ⟨ω, ξ'⟩ dHᵏ` for every
`ω` supported in `V`, with `θ' ≥ 0` and `ξ'` a unit orientation `Hᵏ`-a.e. on `M'`, then
`M_W(T) ≤ ∫_{M' ∩ W} θ' dHᵏ` for measurable `W ⊆ V`.  For admissible `ω`, `|ξ'(ω)| ≤ |ω| ≤ 1`
a.e. on `M'` and `ω = 0` off `W`, so `T(ω) ≤ |∫_{M'} θ' ξ'(ω)| ≤ ∫⁻_{M'} 1_W θ'`; no
integrability or measurability of `θ'`, `ξ'` is needed. -/
theorem Submission.codim1_oriented_rep_massOn_le_lintegral : ∀ (P k : ℕ) (U V M' : Set (Euclid P)) (T : GeometricCurrentOn U k) (θ' : Euclid P → ℝ) (ξ' : Euclid P → MultiVector P k), (∀ x, 0 ≤ θ' x) → (∀ᵐ x ∂(μHE[k].restrict M'), ∃ Q : Submodule ℝ (Euclid P), IsUnitOrientationOf (ξ' x) Q) → (∀ ω : TestFormOn U k, tsupport (ω : DifferentialForm (Euclid P) k) ⊆ V → T ω = ∫ x in M', θ' x * ξ' x ((ω : DifferentialForm (Euclid P) k) x) ∂μHE[k]) → ∀ W : Set (Euclid P), MeasurableSet W → W ⊆ V → T.massOn W ≤ ∫⁻ x in M' ∩ W, ENNReal.ofReal (θ' x) ∂μHE[k] := by
  intro P k U V M' T θ' ξ' hθ hξ hT W hW hWV
  obtain ⟨_, hL⟩ := Submission.dor_ims_unitOrientation_dual P k
  -- `|ξ'(x)(α)| ≤ |α|` for `Hᵏ⌞M'`-a.e. `x`
  have hgood : ∀ᵐ x ∂(μHE[k].restrict M'),
      ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α := by
    filter_upwards [hξ] with x ⟨Q, hQ⟩
    exact (hL (ξ' x) Q hQ).1
  -- it suffices to bound `T(ω)` for each admissible `ω`
  refine sSup_le ?_
  rintro r ⟨ω, ⟨hωW, hω1⟩, rfl⟩
  dsimp only
  rw [hT ω (hωW.trans hWV)]
  -- `|θ' ξ'(ω)| ≤ 1_W θ'` a.e. on `M'`: `ω = 0` off `W` and `|ξ'(ω)| ≤ |ω| ≤ 1`
  have hdom : ∀ᵐ x ∂(μHE[k].restrict M'),
      ‖θ' x * ξ' x ((ω : DifferentialForm (Euclid P) k) x)‖ₑ ≤
        W.indicator (fun x => ENNReal.ofReal (θ' x)) x := by
    filter_upwards [hgood] with x hx
    by_cases hxW : x ∈ W
    · rw [indicator_of_mem hxW, Real.enorm_eq_ofReal_abs, abs_mul, abs_of_nonneg (hθ x)]
      refine ENNReal.ofReal_le_ofReal ?_
      calc θ' x * |ξ' x ((ω : DifferentialForm (Euclid P) k) x)|
          ≤ θ' x * 1 := mul_le_mul_of_nonneg_left ((hx _).trans (hω1 x)) (hθ x)
        _ = θ' x := mul_one _
    · rw [image_eq_zero_of_notMem_tsupport fun h => hxW (hωW h), map_zero, mul_zero,
        enorm_zero]
      exact zero_le
  -- `T(ω) ≤ |∫ g| ≤ ∫⁻ |g| ≤ ∫⁻_{M'} 1_W θ' = ∫⁻_{M' ∩ W} θ'`
  calc ENNReal.ofReal (∫ x in M', θ' x * ξ' x ((ω : DifferentialForm (Euclid P) k) x) ∂μHE[k])
      ≤ ‖∫ x in M', θ' x * ξ' x ((ω : DifferentialForm (Euclid P) k) x) ∂μHE[k]‖ₑ := by
        rw [Real.enorm_eq_ofReal_abs]
        exact ENNReal.ofReal_le_ofReal (le_abs_self _)
    _ ≤ ∫⁻ x in M', ‖θ' x * ξ' x ((ω : DifferentialForm (Euclid P) k) x)‖ₑ ∂μHE[k] :=
        enorm_integral_le_lintegral_enorm _
    _ ≤ ∫⁻ x in M', W.indicator (fun x => ENNReal.ofReal (θ' x)) x ∂μHE[k] :=
        lintegral_mono_ae hdom
    _ = ∫⁻ x in M' ∩ W, ENNReal.ofReal (θ' x) ∂μHE[k] := by
        rw [lintegral_indicator hW, Measure.restrict_restrict hW, inter_comm]
/-- **Lower mass bound for an oriented representation** (Simon Ch. 6, 2.5 and 3.2(3)).  If
`T(ω) = ∫_{M'} θ' ⟨ω, ξ'⟩ dHᵏ` for the test forms supported in `V`, with `θ' ≥ 0` measurable and
`ξ'` a.e. a unit orientation, then `I = ∫_{M' ∩ W} θ' dHᵏ ≤ M_W(T)` for every open `W ⊆ V` with
`I < ∞`.  Let `ν = θ' Hᵏ⌞M'` and let `L` be the dual map of `dor_ims_unitOrientation_dual`, so
`ν`-a.e. `|ξ'(α)| ≤ |α|`, `|L(ξ')| ≤ 1` and `ξ'(L(ξ')) = 1`.  Lusin gives a compact `K ⊆ W` of such
points with `ν(W \ K) < η` on which `L ∘ ξ'` is continuous, and the smooth unit approximation an
admissible `ω` with `|ω − L ∘ ξ'| ≤ δ = η/(I + 1)` on `K`.  Then `ξ'(ω) ≥ (1 − δ) 1_K − 1_{W \ K}`
`ν`-a.e., so `T(ω) = ∫ ξ'(ω) dν ≥ (1 − δ) ν(K) − ν(W \ K) > I − 3η`. -/
theorem Submission.codim1_oriented_rep_lintegral_le_massOn : ∀ (P k : ℕ) (U V M' : Set (Euclid P)) (T : GeometricCurrentOn U k) (θ' : Euclid P → ℝ) (ξ' : Euclid P → MultiVector P k), V ⊆ U → Measurable θ' → (∀ x, 0 ≤ θ' x) → AEStronglyMeasurable ξ' (μHE[k].restrict M') → (∀ᵐ x ∂(μHE[k].restrict M'), ∃ Q : Submodule ℝ (Euclid P), IsUnitOrientationOf (ξ' x) Q) → (∀ ω : TestFormOn U k, tsupport (ω : DifferentialForm (Euclid P) k) ⊆ V → T ω = ∫ x in M', θ' x * ξ' x ((ω : DifferentialForm (Euclid P) k) x) ∂μHE[k]) → ∀ W : Set (Euclid P), IsOpen W → W ⊆ V → ∫⁻ x in M' ∩ W, ENNReal.ofReal (θ' x) ∂μHE[k] ≠ ∞ → ∫⁻ x in M' ∩ W, ENNReal.ofReal (θ' x) ∂μHE[k] ≤ T.massOn W := by
  intro P k U V M' T θ' ξ' hVU hθm hθ0 hξm hξo hT W hW hWV hI
  -- Step 1: the dual map `L` of the unit orientations
  obtain ⟨L, hL⟩ := Submission.dor_ims_unitOrientation_dual P k
  -- Step 2: `ν = θ' Hᵏ⌞M'`, with `ν ≪ Hᵏ⌞M'`, `ν(W) = I < ∞` and `∫ g dν = ∫_{M'} θ' g dHᵏ`
  set ν : Measure (Euclid P) :=
    (μHE[k].restrict M').withDensity fun x => ENNReal.ofReal (θ' x) with hν
  have hνμ : ν ≪ μHE[k].restrict M' := withDensity_absolutelyContinuous _ _
  have hνW : ν W = ∫⁻ x in M' ∩ W, ENNReal.ofReal (θ' x) ∂μHE[k] := by
    rw [hν, withDensity_apply _ hW.measurableSet, Measure.restrict_restrict hW.measurableSet,
      inter_comm]
  have hνW' : ν W ≠ ∞ := hνW ▸ hI
  -- `ν`-a.e. `x` is good, and the bad points lie in a measurable `ν`-null set `Z`
  have hgood : ∀ᵐ x ∂ν, (∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) ∧
      covectorEuclideanNorm (L (ξ' x)) ≤ 1 ∧ ξ' x (L (ξ' x)) = 1 :=
    hνμ.ae_le (hξo.mono fun x ⟨Q, hQ⟩ => hL (ξ' x) Q hQ)
  obtain ⟨Z, hZ, hZm, hZ0⟩ := exists_measurable_superset_of_null (ae_iff.mp hgood)
  have hξν : AEStronglyMeasurable ξ' ν := hξm.mono_ac hνμ
  have hdens : ∀ g : Euclid P → ℝ, ∫ x, g x ∂ν = ∫ x in M', θ' x * g x ∂μHE[k] := by
    intro g
    rw [hν, integral_withDensity_eq_integral_toReal_smul hθm.ennreal_ofReal
      (ae_of_all _ fun x => ENNReal.ofReal_lt_top)]
    refine integral_congr_ae (ae_of_all _ fun x => ?_)
    simp only [ENNReal.toReal_ofReal (hθ0 x), smul_eq_mul]
  set m : ℝ := ν.real W
  have hm0 : 0 ≤ m := measureReal_nonneg
  -- Steps 4–8: for every `η > 0` some admissible `ω` has `T(ω) > m - 3η`
  have key : ∀ η : ℝ, 0 < η →
      ∃ ω : TestFormOn U k, ω ∈ massAdmissibleOn U k W ∧ m - 3 * η < T ω := by
    intro η hη
    -- Step 4: Lusin on `W \ Z` gives a compact `K` of good points with `ν(W \ K) < η`
    obtain ⟨K, hKc, hKA, hKν, hLK⟩ := Submission.dor_ims_lusin_continuousOn P k ν (W \ Z)
      (fun x => L (ξ' x)) η (hW.measurableSet.diff hZm)
      (measure_ne_top_of_subset sdiff_subset hνW')
      (L.continuous.comp_aestronglyMeasurable hξν) hη
    have hKW : K ⊆ W := hKA.trans sdiff_subset
    have hKm : MeasurableSet K := hKc.measurableSet
    have hLK1 : ∀ x ∈ K, covectorEuclideanNorm (L (ξ' x)) ≤ 1 := by
      intro x hx
      by_contra h
      exact (hKA hx).2 (hZ fun hg => h hg.2.1)
    have hWK : ν.real (W \ K) < η := by
      refine ENNReal.toReal_lt_of_lt_ofReal ?_
      rwa [← measure_sdiff_null hZ0, sdiff_right_comm]
    -- Step 5: an admissible `ω` with `|ω - L ∘ ξ'| ≤ δ` on `K`
    set δ : ℝ := η / (m + 1) with hδ
    have hδ0 : 0 < δ := div_pos hη (by linarith)
    obtain ⟨ω₀, hω₀, hω₀W, hω₀1, hω₀K⟩ := Submission.dor_ims_smooth_unit_approx P k K W
      (fun x => L (ξ' x)) δ hKc hW hKW hLK hLK1 hδ0
    let ω : TestFormOn U k := ⟨ω₀, hω₀, hω₀W.trans (hWV.trans hVU)⟩
    refine ⟨ω, ⟨hω₀W, hω₀1⟩, ?_⟩
    have hω₀0 : ∀ x, x ∉ W → ω₀ x = 0 := fun x hx =>
      image_eq_zero_of_notMem_tsupport fun h => hx (hω₀W h)
    -- Step 6: `f = ξ'(ω₀)` is `ν`-integrable, as `|f| ≤ 1_W`, and `T(ω) = ∫ f dν`
    have hTω : T ω = ∫ x, ξ' x (ω₀ x) ∂ν := by
      rw [hdens]
      exact hT ω (hω₀W.trans hWV)
    have hfm : AEStronglyMeasurable (fun x => ξ' x (ω₀ x)) ν :=
      isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable
        (hξν.prodMk (ContDiff.continuous hω₀.1).aestronglyMeasurable)
    have hWi : Integrable (W.indicator (1 : Euclid P → ℝ)) ν :=
      (integrable_indicator_iff hW.measurableSet).mpr (integrableOn_const hνW')
    have hfi : Integrable (fun x => ξ' x (ω₀ x)) ν := by
      refine hWi.mono' hfm (hgood.mono fun x hx => ?_)
      by_cases hxW : x ∈ W
      · rw [indicator_of_mem hxW, Pi.one_apply, Real.norm_eq_abs]
        exact (hx.1 _).trans (hω₀1 x)
      · rw [indicator_of_notMem hxW, hω₀0 x hxW, map_zero, norm_zero]
    -- Step 7: `f ≥ (1 - δ) 1_K - 1_{W \ K}` `ν`-a.e.
    have hKi : Integrable (K.indicator (1 : Euclid P → ℝ)) ν :=
      (integrable_indicator_iff hKm).mpr (integrableOn_const (measure_ne_top_of_subset hKW hνW'))
    have hWKi : Integrable ((W \ K).indicator (1 : Euclid P → ℝ)) ν :=
      (integrable_indicator_iff (hW.measurableSet.diff hKm)).mpr
        (integrableOn_const (measure_ne_top_of_subset sdiff_subset hνW'))
    have hlow : ∀ᵐ x ∂ν,
        (1 - δ) * K.indicator 1 x - (W \ K).indicator 1 x ≤ ξ' x (ω₀ x) := by
      refine hgood.mono fun x hx => ?_
      by_cases hxK : x ∈ K
      · -- `f = 1 + ξ'(ω₀ - L(ξ')) ≥ 1 - |ω₀ - L(ξ')| ≥ 1 - δ`
        rw [indicator_of_mem hxK, indicator_of_notMem fun h => h.2 hxK, Pi.one_apply, mul_one,
          sub_zero]
        have h1 : ξ' x (ω₀ x) = 1 + ξ' x (ω₀ x - L (ξ' x)) := by
          rw [map_sub, hx.2.2]
          ring
        have h2 := (hx.1 (ω₀ x - L (ξ' x))).trans (hω₀K x hxK)
        rw [h1]
        linarith [neg_abs_le (ξ' x (ω₀ x - L (ξ' x)))]
      · rw [indicator_of_notMem hxK, mul_zero, zero_sub]
        by_cases hxW : x ∈ W
        · -- `f ≥ -|ω₀| ≥ -1`
          rw [indicator_of_mem (s := W \ K) ⟨hxW, hxK⟩, Pi.one_apply]
          linarith [neg_abs_le (ξ' x (ω₀ x)), (hx.1 (ω₀ x)).trans (hω₀1 x)]
        · -- `ω₀ = 0` off `W`
          rw [indicator_of_notMem fun h => hxW h.1, hω₀0 x hxW, map_zero, neg_zero]
    -- Step 8: `T(ω) ≥ (1 - δ) ν(K) - ν(W \ K) > m - 3η`, as `δ ν(K) ≤ δ m < η`,
    -- `ν(W \ K) < η` and `ν(K) = m - ν(W \ K)`
    have hge : (1 - δ) * ν.real K - ν.real (W \ K) ≤ T ω := by
      rw [hTω, ← integral_indicator_one hKm, ← integral_indicator_one (hW.measurableSet.diff hKm),
        ← integral_const_mul, ← integral_sub (hKi.const_mul _) hWKi]
      exact integral_mono_ae ((hKi.const_mul _).sub hWKi) hfi hlow
    have hsplit : ν.real (W \ K) = m - ν.real K := measureReal_sdiff hKW hKm hνW'
    have hKle : ν.real K ≤ m := measureReal_mono hKW hνW'
    have hδm : δ * m < η := by
      rw [hδ, div_mul_eq_mul_div, div_lt_iff₀ (by linarith)]
      nlinarith
    have hδK : δ * ν.real K ≤ δ * m := mul_le_mul_of_nonneg_left hKle hδ0.le
    have hexp : (1 - δ) * ν.real K = ν.real K - δ * ν.real K := by ring
    linarith
  -- Steps 3 and 9: every `r < I` is at most `M_W(T)`, via `key` for `η = (m - r)/3`
  refine ENNReal.le_of_forall_nnreal_lt fun r hr => ?_
  rw [← hνW] at hr
  have hrm : (r : ℝ) < m := ENNReal.toReal_strict_mono hνW' hr
  obtain ⟨ω, hω, hTω⟩ := key ((m - r) / 3) (by linarith)
  calc (r : ℝ≥0∞) = ENNReal.ofReal r := ENNReal.ofReal_coe_nnreal.symm
    _ ≤ ENNReal.ofReal (T ω) := ENNReal.ofReal_le_ofReal (by linarith)
    _ ≤ T.massOn W := T.le_massOn hω

/-- **Mass of a current given on `V` by an oriented weighted set** (Simon Ch. 6, 2.5 and 3.2(3):
`M_W(T) = ∫_{M ∩ W} θ dHᵏ` for `T = τ(M, θ, ξ)`, with a general weight `θ' ≥ 0`).  Let
`I(W) = ∫⁻_{M' ∩ W} θ' dHᵏ` for an open `W ⊆ V`.  Step 2: `|θ' ξ'(ω)| ≤ θ' 1_W` a.e. on `M'` for
every admissible `ω`, so `M_W(T) ≤ I(W)`.  Step 3: if `I(W) < ∞`, a smooth admissible form close
to `L ∘ ξ'` on a compact `K ⊆ M' ∩ W` of almost full `θ' Hᵏ`-measure gives `I(W) ≤ M_W(T)`, and
equality follows by antisymmetry. -/
theorem Submission.codim1_massOn_eq_lintegral_of_oriented_rep : ∀ (P k : ℕ) (U V M' : Set (Euclid P)) (T : GeometricCurrentOn U k) (θ' : Euclid P → ℝ) (ξ' : Euclid P → MultiVector P k), IsOpen V → V ⊆ U → MeasurableSet M' → M' ⊆ V → Measurable θ' → (∀ x, 0 ≤ θ' x) → AEStronglyMeasurable ξ' (μHE[k].restrict M') → (∀ᵐ x ∂(μHE[k].restrict M'), ∃ Q : Submodule ℝ (Euclid P), IsUnitOrientationOf (ξ' x) Q) → (∀ ω : TestFormOn U k, tsupport (ω : DifferentialForm (Euclid P) k) ⊆ V → T ω = ∫ x in M', θ' x * ξ' x ((ω : DifferentialForm (Euclid P) k) x) ∂μHE[k]) → ∀ W : Set (Euclid P), IsOpen W → W ⊆ V → T.massOn W ≤ ∫⁻ x in M' ∩ W, ENNReal.ofReal (θ' x) ∂μHE[k] ∧ (∫⁻ x in M' ∩ W, ENNReal.ofReal (θ' x) ∂μHE[k] ≠ ∞ → T.massOn W = ∫⁻ x in M' ∩ W, ENNReal.ofReal (θ' x) ∂μHE[k]) := by
  intro P k U V M' T θ' ξ' _hV hVU _hM' _hM'V hθ hθ0 hξ hξQ hT W hW hWV
  -- Step 2: `M_W(T) ≤ I(W)`; the open set `W` is Borel
  have hle := Submission.codim1_oriented_rep_massOn_le_lintegral P k U V M' T θ' ξ' hθ0 hξQ hT W
    hW.measurableSet hWV
  -- Step 3: `I(W) ≤ M_W(T)` when `I(W) < ∞`, hence `M_W(T) = I(W)`
  exact ⟨hle, fun hI => le_antisymm hle
    (Submission.codim1_oriented_rep_lintegral_le_massOn P k U V M' T θ' ξ' hVU hθ hθ0 hξ hξQ hT W hW
      hWV hI)⟩
/-- **Countably `n`-rectifiable sets of finite measure have density one a.e.** (general fact
(G7); Simon Ch. 3, Lemma 1.2, Remark 1.3, the proof of Theorem 1.6 "⇒" and Remark 1.5(3),
chapter-03.txt lines 25–144).  Let `M ⊆ ℝᴾ` be Borel and countably `n`-rectifiable with
`Hⁿ(M) < ∞`.  Then `Hⁿ(M ∩ K) ≤ Hⁿ(M) < ∞` for every compact `K`, so by Theorem 1.6 "⇒" the
approximate tangent space `T_wM` exists for `Hⁿ`-a.e. `w ∈ M`.  At such `w`, `Hⁿ(M ∩ B̄_1(w))` is
finite, so `Hⁿ(M ∩ B̄_t(w)) / (ωₙtⁿ) → 1` by Remark 1.5(3); for the measure `Hⁿ⌞M` this
closed-ball limit gives the open-ball limit `Hⁿ(M ∩ B_t(w)) / (ωₙtⁿ) → 1` as `t ↓ 0`. -/
theorem Submission.codim1_rdo_rectifiable_ae_density_one : ∀ (P n : ℕ) (M : Set (Euclid P)), 1 ≤ n → MeasurableSet M → CountablyRectifiable n M → μHE[n] M ≠ ∞ → ∀ᵐ w ∂(μHE[n].restrict M), Tendsto (fun t : ℝ => μHE[n] (M ∩ ball w t) / (unitBallVolume n * ENNReal.ofReal (t ^ n))) (𝓝[>] 0) (𝓝 1) := by
  intro P n M _ hM hrect hfin
  -- Step 1: `Hⁿ(M ∩ K) ≤ Hⁿ(M) < ∞` for every `K`
  have hloc : ∀ K : Set (Euclid P), μHE[n] (M ∩ K) ≠ ∞ := fun K =>
    ne_top_of_le_ne_top hfin (measure_mono inter_subset_left)
  -- Step 2 (Lemma 1.2, Remark 1.3, Theorem 1.6 "⇒"): approximate tangent spaces `Hⁿ`-a.e. on `M`
  have htan := Submission.codim1_rdo_rectifiable_ae_approxTangent P n M hM hrect fun K _ => hloc K
  -- Step 3: `Hⁿ⌞M` evaluates as `Hⁿ(M ∩ ·)`
  have hν : ∀ s : Set (Euclid P), μHE[n].restrict M s = μHE[n] (M ∩ s) := fun s => by
    rw [Measure.restrict_apply' hM, inter_comm]
  filter_upwards [htan] with w ⟨Q, hQ⟩
  -- Step 4 (Remark 1.5(3)): closed-ball density one at `w`, as `Hⁿ(M ∩ B̄_1(w)) < ∞`
  have hclosed := Submission.rsd_tendsto_closedBall_density_of_approxTangent P n M w Q 1 one_pos
    (hloc _) hQ
  -- Step 5: from closed to open balls, for the measure `Hⁿ⌞M`
  exact (Submission.rsd_tendsto_ball_density_of_closedBall P n (μHE[n].restrict M) w 1
    (hclosed.congr fun ρ => by rw [hν])).congr fun ρ => by rw [hν]
/-- **`μ = Hᵐ⌞B` with approximate tangent planes `ν(y)^⊥`** (Simon Ch. 3, 4.3, first part, given
the rectifiable density theorem (RD)).  Let `μ` be locally finite in the open set `D ⊆ ℝ^{m+1}`,
carried by `D`, with flat tangent measure `Hᵐ⌞ν(y)^⊥` at `μ`-a.e. `y`.  Then `μ = Hᵐ⌞B` for a
Borel countably `m`-rectifiable `B ⊆ D` whose approximate tangent space (Ch. 3, 1.4) at
`Hᵐ`-a.e. `y ∈ B` is `ν(y)^⊥`.  Take `B = (D ∩ R) \ N`, with `R` from
`codim1_rdo_dg_rectifiable_of_flat_tangent` and `N` a Borel `μ`-null set off which the flat
tangent exists, so `Θᵐ(μ, y) = 1` on `B` (`codim1_rdo_dg_flat_tangent_density_cone`).  A Vitali
`5r`-covering bounds `Hᵐ⌞B` locally by `μ`, and small covers give `μ ≪ Hᵐ⌞B`; (RD) gives
`Θᵐ(Hᵐ⌞B, w) = 1` a.e., so Besicovitch differentiation yields `dμ/d(Hᵐ⌞B) = 1` and `μ = Hᵐ⌞B`.
Finally `Hᵐ(η_{y,r}(A)) = r⁻ᵐ Hᵐ(A)` turns the flat tangent measure into Definition 1.4. -/
theorem Submission.codim1_rdo_dg_measure_eq_hausdorff : ∀ (m : ℕ) (D : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)), 1 ≤ m → IsOpen D → μ Dᶜ = 0 → (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μ K ≠ ∞) → Measurable ν → (∀ y, ‖ν y‖ = 1) → (∀ᵐ y ∂μ, ∀ f : Euclid (m + 1) → ℝ, Continuous f → HasCompactSupport f → Tendsto (fun r : ℝ => (r ^ m)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) ∂μ) (𝓝[>] 0) (𝓝 (∫ z in ((Submodule.span ℝ {ν y})ᗮ : Set (Euclid (m + 1))), f z ∂μHE[m]))) → (∀ S : Set (Euclid (m + 1)), MeasurableSet S → CountablyRectifiable m S → μHE[m] S ≠ ∞ → ∀ᵐ w ∂(μHE[m].restrict S), Tendsto (fun t : ℝ => μHE[m] (S ∩ ball w t) / (unitBallVolume m * ENNReal.ofReal (t ^ m))) (𝓝[>] 0) (𝓝 1)) → ∃ B : Set (Euclid (m + 1)), MeasurableSet B ∧ B ⊆ D ∧ CountablyRectifiable m B ∧ μ = μHE[m].restrict B ∧ ∀ᵐ y ∂(μHE[m].restrict B), HasApproximateTangentSpaceAt m B y (Submodule.span ℝ {ν y})ᗮ := by
  intro m D μ ν hm hD hμD hμK hνm hν1 hflat hRD
  -- (step 3 tool) local copy of the accepted `dorag_sn_hausdorff_le_mul_of_lower_density`
  have hcmp_gen : ∀ (N n : ℕ) (c : ℝ), 0 < c → ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ (ν : Measure (Euclid N)) (A O : Set (Euclid N)), IsOpen O → A ⊆ O → (∀ x ∈ A, ∃ t₀ : ℝ, 0 < t₀ ∧ ∀ t : ℝ, 0 < t → t < t₀ → ENNReal.ofReal (c * t ^ n) ≤ ν (closedBall x t)) → μHE[n] A ≤ C * ν O := by
    intro N n c hc
    -- `μHE[n] = k • μH[n]` with a finite factor `k`; take `C = k · 10ⁿ / c`
    set k : NNReal :=
      Measure.addHaarScalarFactor (volume : Measure (EuclideanSpace ℝ (Fin n))) μH[(n : ℝ)]
    refine ⟨(k : ℝ≥0∞) * ENNReal.ofReal (10 ^ n / c),
      ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.ofReal_ne_top, ?_⟩
    intro ν A O hO hAO hA
    have hdiam : ∀ (y : Euclid N) (ρ : ℝ), ediam (closedBall y ρ) ≤ ENNReal.ofReal (2 * ρ) := by
      intro y ρ
      apply ediam_le_of_forall_dist_le
      intro z hz w hw
      rw [mem_closedBall] at hz hw
      linarith [dist_triangle_right z w y]
    -- scale `δ = 1 / (m + 1)`: a countable disjoint family of admissible balls whose 5-times
    -- enlargements cover `A`, of total cost at most `(10ⁿ/c) ν(O)`
    have step : ∀ m : ℕ, ∃ u : Set (Euclid N × ℝ), u.Countable ∧
        (∀ p ∈ u, ediam (closedBall p.1 (5 * p.2)) ≤ ENNReal.ofReal (1 / ((m : ℝ) + 1))) ∧
        A ⊆ ⋃ p : u, closedBall (p : Euclid N × ℝ).1 (5 * (p : Euclid N × ℝ).2) ∧
        ∑' p : u, ediam (closedBall (p : Euclid N × ℝ).1 (5 * (p : Euclid N × ℝ).2)) ^ (n : ℝ) ≤
          ENNReal.ofReal (10 ^ n / c) * ν O := by
      intro m
      set δ : ℝ := 1 / ((m : ℝ) + 1)
      have hδpos : 0 < δ := by positivity
      -- the admissible balls, as (center, radius) pairs
      set T : Set (Euclid N × ℝ) := {p | p.1 ∈ A ∧ 0 < p.2 ∧ 10 * p.2 ≤ δ ∧
        closedBall p.1 p.2 ⊆ O ∧ ENNReal.ofReal (c * p.2 ^ n) ≤ ν (closedBall p.1 p.2)}
      obtain ⟨u, huT, hudisj, hucov⟩ :=
        Vitali.exists_disjoint_subfamily_covering_enlargement_closedBall T (fun p => p.1)
          (fun p => p.2) δ (fun p hp => by linarith [hp.2.2.1, hp.2.1]) 5 (by norm_num)
      -- disjoint balls with nonempty interiors in the separable space `ℝᴺ`
      have hucount : u.Countable := by
        refine hudisj.countable_of_nonempty_interior fun p hp => ?_
        exact ⟨p.1, ball_subset_interior_closedBall (mem_ball_self (huT hp).2.1)⟩
      refine ⟨u, hucount, fun p hp => ?_, ?_, ?_⟩
      · obtain ⟨-, -, hpδ, -, -⟩ := huT hp
        refine (hdiam _ _).trans (ENNReal.ofReal_le_ofReal ?_)
        linarith
      · -- each `x ∈ A` is the center of a small admissible ball
        intro x hx
        obtain ⟨t₀, ht₀, hbound⟩ := hA x hx
        obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hO x (hAO hx)
        set r : ℝ := min (t₀ / 2) (min (ε / 2) (δ / 10))
        have hrpos : 0 < r := by positivity
        have hr₁ := min_le_left (t₀ / 2) (min (ε / 2) (δ / 10))
        have hr₂ := min_le_right (t₀ / 2) (min (ε / 2) (δ / 10))
        have hr₃ := min_le_left (ε / 2) (δ / 10)
        have hr₄ := min_le_right (ε / 2) (δ / 10)
        have hmem : (x, r) ∈ T :=
          ⟨hx, hrpos, by linarith, (closedBall_subset_ball (by linarith)).trans hball,
            hbound r hrpos (by linarith)⟩
        obtain ⟨b, hbu, hsub⟩ := hucov (x, r) hmem
        exact mem_iUnion.2 ⟨⟨b, hbu⟩, hsub (mem_closedBall_self hrpos.le)⟩
      · calc ∑' p : u, ediam (closedBall (p : Euclid N × ℝ).1 (5 * (p : Euclid N × ℝ).2)) ^ (n : ℝ)
            ≤ ∑' p : u, ENNReal.ofReal (10 ^ n / c) *
                ν (closedBall (p : Euclid N × ℝ).1 (p : Euclid N × ℝ).2) := by
              refine ENNReal.tsum_le_tsum fun p => ?_
              obtain ⟨-, hp0, -, -, hpν⟩ := huT p.2
              calc ediam (closedBall (p : Euclid N × ℝ).1 (5 * (p : Euclid N × ℝ).2)) ^ (n : ℝ)
                  ≤ ENNReal.ofReal (2 * (5 * (p : Euclid N × ℝ).2)) ^ (n : ℝ) :=
                    ENNReal.rpow_le_rpow (hdiam _ _) (Nat.cast_nonneg n)
                _ = ENNReal.ofReal (10 ^ n / c) * ENNReal.ofReal (c * (p : Euclid N × ℝ).2 ^ n) := by
                    rw [ENNReal.rpow_natCast, ← ENNReal.ofReal_pow (by positivity),
                      ← ENNReal.ofReal_mul (by positivity)]
                    congr 1
                    field_simp
                    ring
                _ ≤ ENNReal.ofReal (10 ^ n / c) *
                      ν (closedBall (p : Euclid N × ℝ).1 (p : Euclid N × ℝ).2) := by
                    gcongr
          _ = ENNReal.ofReal (10 ^ n / c) * ν (⋃ p ∈ u, closedBall p.1 p.2) := by
              rw [ENNReal.tsum_mul_left,
                measure_biUnion hucount hudisj fun p _ => measurableSet_closedBall]
          _ ≤ ENNReal.ofReal (10 ^ n / c) * ν O := by
              gcongr
              exact iUnion₂_subset fun p hp => (huT hp).2.2.2.1
    choose u hucount hudiam hucov husum using step
    have : ∀ m, Countable (u m) := fun m => (hucount m).to_subtype
    -- covers of mesh `1 / (m + 1) → 0`
    have main : μH[(n : ℝ)] A ≤ ENNReal.ofReal (10 ^ n / c) * ν O := by
      calc μH[(n : ℝ)] A
          ≤ liminf (fun m => ∑' p : u m,
              ediam (closedBall (p : Euclid N × ℝ).1 (5 * (p : Euclid N × ℝ).2)) ^ (n : ℝ)) atTop := by
            refine Measure.hausdorffMeasure_le_liminf_tsum (ι := fun m => u m) (n : ℝ) A
              (fun m : ℕ => ENNReal.ofReal (1 / ((m : ℝ) + 1))) ?_
              (fun m p => closedBall (p : Euclid N × ℝ).1 (5 * (p : Euclid N × ℝ).2))
              (Eventually.of_forall fun m p => hudiam m p p.2) (Eventually.of_forall hucov)
            simpa using ENNReal.tendsto_ofReal (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ))
        _ ≤ ENNReal.ofReal (10 ^ n / c) * ν O :=
            liminf_le_of_frequently_le' (Frequently.of_forall husum)
    calc μHE[n] A = (k : ℝ≥0∞) * μH[(n : ℝ)] A := by
          rw [Measure.euclideanHausdorffMeasure_def, Measure.smul_apply, ENNReal.smul_def,
            smul_eq_mul]
      _ ≤ (k : ℝ≥0∞) * (ENNReal.ofReal (10 ^ n / c) * ν O) := by gcongr
      _ = (k : ℝ≥0∞) * ENNReal.ofReal (10 ^ n / c) * ν O := by rw [mul_assoc]
  -- (step 4 tool) `Hⁿ`-null sets of closed-ball density-one points of `μ` are `μ`-null
  have hnull_gen : ∀ (P n : ℕ) (μ : Measure (Euclid P)) (A : Set (Euclid P)), (∀ x ∈ A, Tendsto (fun r : ℝ => μ (closedBall x r) / (unitBallVolume n * ENNReal.ofReal (r ^ n))) (𝓝[>] 0) (𝓝 1)) → μHE[n] A = 0 → μ A = 0 := by
    intro P n μ A hdens hA
    have hω0 : unitBallVolume n ≠ 0 := (measure_ball_pos _ _ zero_lt_one).ne'
    have hωtop : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
    set C : ℝ≥0∞ := 2 * unitBallVolume n with hCdef
    have hC0 : C ≠ 0 := mul_ne_zero two_ne_zero hω0
    have hCtop : C ≠ ∞ := ENNReal.mul_ne_top ENNReal.ofNat_ne_top hωtop
    -- the pieces `A_k` on which `μ` has uniform growth below radius `1/(k+1)`
    set Ak : ℕ → Set (Euclid P) := fun k => {x | x ∈ A ∧ ∀ r : ℝ, 0 < r → r ≤ 1 / ((k : ℝ) + 1) →
      μ (closedBall x r) ≤ C * ENNReal.ofReal r ^ n} with hAkdef
    have hcover : A ⊆ ⋃ k, Ak k := by
      intro x hx
      have h2 : ∀ᶠ r in 𝓝[>] (0 : ℝ),
          μ (closedBall x r) / (unitBallVolume n * ENNReal.ofReal (r ^ n)) < 2 :=
        (hdens x hx).eventually (gt_mem_nhds (by norm_num))
      obtain ⟨δ, hδ, hδsub⟩ := (nhdsGT_basis (0 : ℝ)).mem_iff.mp h2
      obtain ⟨k, hk⟩ := exists_nat_one_div_lt hδ
      refine mem_iUnion.mpr ⟨k, hx, fun r hr hrk => ?_⟩
      have hq := hδsub ⟨hr, hrk.trans_lt hk⟩
      have hc0 : unitBallVolume n * ENNReal.ofReal (r ^ n) ≠ 0 :=
        mul_ne_zero hω0 (ENNReal.ofReal_pos.mpr (pow_pos hr n)).ne'
      have hctop : unitBallVolume n * ENNReal.ofReal (r ^ n) ≠ ∞ :=
        ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top
      have := ((ENNReal.div_lt_iff (Or.inl hc0) (Or.inl hctop)).mp hq).le
      calc μ (closedBall x r) ≤ 2 * (unitBallVolume n * ENNReal.ofReal (r ^ n)) := this
        _ = C * ENNReal.ofReal r ^ n := by rw [hCdef, ENNReal.ofReal_pow hr.le, mul_assoc]
    -- every `A_k` is `μ`-null
    have hnull : ∀ k, μ (Ak k) = 0 := by
      intro k
      set R : ℝ := 1 / ((k : ℝ) + 1) with hRdef
      have hR : 0 < R := by positivity
      have hHk : μH[(n : ℝ)] (Ak k) = 0 := by
        have h0 : μHE[n] (Ak k) = 0 := measure_mono_null (fun x hx => hx.1) hA
        rw [Measure.euclideanHausdorffMeasure_def, Measure.smul_apply, ENNReal.smul_def,
          smul_eq_mul] at h0
        exact (mul_eq_zero.mp h0).resolve_left (by
          simpa using Measure.addHaarScalarFactor_volume_hausdorffMeasure_ne_zero n)
      have hdiam : ∀ s : Set (Euclid P), ediam s ≤ ENNReal.ofReal R →
          OuterMeasure.restrict (Ak k) μ.toOuterMeasure s ≤ C * ediam s ^ n := by
        intro s hs
        rw [OuterMeasure.restrict_apply, Measure.toOuterMeasure_apply]
        rcases (s ∩ Ak k).eq_empty_or_nonempty with he | ⟨x, hxs, hxA⟩
        · simp only [he, measure_empty, zero_le]
        have hsfin : ediam s ≠ ∞ := ne_top_of_le_ne_top ENNReal.ofReal_ne_top hs
        have hdR : (ediam s).toReal ≤ R := ENNReal.toReal_le_of_le_ofReal hR.le hs
        have hsub : s ∩ Ak k ⊆ closedBall x (ediam s).toReal := by
          intro y hy
          change dist y x ≤ (ediam s).toReal
          simpa only [edist_dist, ENNReal.toReal_ofReal dist_nonneg] using
            (ENNReal.toReal_mono hsfin (edist_le_ediam_of_mem hy.1 hxs))
        apply (measure_mono hsub).trans
        by_cases hd : 0 < (ediam s).toReal
        · simpa only [ENNReal.ofReal_toReal hsfin] using hxA.2 _ hd hdR
        · have hd0 : (ediam s).toReal = 0 := le_antisymm (not_lt.mp hd) ENNReal.toReal_nonneg
          have hed0 : ediam s = 0 := by
            rw [← ENNReal.ofReal_toReal hsfin, hd0, ENNReal.ofReal_zero]
          rw [hd0, hed0]
          -- zero radius: let the radius tend to zero in the growth bound
          have hid : Tendsto (fun r : ℝ ↦ r) (𝓝[>] 0) (𝓝 0) :=
            tendsto_id.mono_left inf_le_left
          have hlim : Tendsto (fun r : ℝ ↦ C * (ENNReal.ofReal r) ^ n) (𝓝[>] 0)
              (𝓝 (C * (0 : ℝ≥0∞) ^ n)) := by
            simpa only [ENNReal.ofReal_zero, Function.comp_def] using
              ENNReal.Tendsto.const_mul
                (ENNReal.Tendsto.pow (ENNReal.continuous_ofReal.continuousAt.tendsto.comp hid))
                (Or.inr hCtop)
          apply ge_of_tendsto hlim
          filter_upwards [Ioo_mem_nhdsGT hR] with r hr
          exact (measure_mono (closedBall_subset_closedBall hr.1.le)).trans
            (hxA.2 r hr.1 hr.2.le)
      have hm := OuterMeasure.le_mkMetric (fun d : ℝ≥0∞ ↦ C * d ^ n)
        (OuterMeasure.restrict (Ak k) μ.toOuterMeasure) (ENNReal.ofReal R)
        (ENNReal.ofReal_pos.mpr hR) hdiam
      have hcost : (fun d : ℝ≥0∞ ↦ C * d ^ n) = C • (fun d : ℝ≥0∞ ↦ d ^ (n : ℝ)) := by
        funext d
        simp only [Pi.smul_apply, smul_eq_mul, ENNReal.rpow_natCast]
      rw [hcost, OuterMeasure.mkMetric_smul _ hCtop hC0] at hm
      have hk := hm (Ak k)
      rw [OuterMeasure.restrict_apply, inter_self, Measure.toOuterMeasure_apply,
        smul_apply, smul_eq_mul] at hk
      have hH : OuterMeasure.mkMetric (fun d : ℝ≥0∞ ↦ d ^ (n : ℝ)) (Ak k) = 0 := by
        have : (μH[(n : ℝ)] : Measure (Euclid P)).toOuterMeasure =
            OuterMeasure.mkMetric (fun d : ℝ≥0∞ ↦ d ^ (n : ℝ)) := by
          rw [Measure.hausdorffMeasure, Measure.mkMetric_toOuterMeasure]
        rw [← this, Measure.toOuterMeasure_apply, hHk]
      rw [hH, mul_zero] at hk
      exact le_antisymm hk zero_le
    exact measure_mono_null hcover (measure_iUnion_null hnull)
  -- (step 5 tool) (RD) on pieces `B ∩ ball` gives closed-ball density one of `Hⁿ⌞B` a.e.
  have hdens_gen : ∀ (P n : ℕ) (D B : Set (Euclid P)), IsOpen D → MeasurableSet B → B ⊆ D → CountablyRectifiable n B → (∀ K : Set (Euclid P), IsCompact K → K ⊆ D → μHE[n] (B ∩ K) ≠ ∞) → (∀ S : Set (Euclid P), MeasurableSet S → CountablyRectifiable n S → μHE[n] S ≠ ∞ → ∀ᵐ w ∂(μHE[n].restrict S), Tendsto (fun t : ℝ => μHE[n] (S ∩ ball w t) / (unitBallVolume n * ENNReal.ofReal (t ^ n))) (𝓝[>] 0) (𝓝 1)) → ∀ᵐ w ∂(μHE[n].restrict B), Tendsto (fun t : ℝ => (μHE[n].restrict B) (closedBall w t) / (unitBallVolume n * ENNReal.ofReal (t ^ n))) (𝓝[>] 0) (𝓝 1) := by
    intro P n D B hD hBm hBD hBrect hloc hRD
    have hω0 : unitBallVolume n ≠ 0 := (measure_ball_pos _ _ zero_lt_one).ne'
    have hωtop : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
    -- Step 1: open-ball density one of `Hⁿ⌞B` at `Hⁿ⌞B`-a.e. point, from (RD) on pieces
    have hopen : ∀ᵐ w ∂(μHE[n].restrict B), Tendsto (fun t : ℝ => μHE[n] (B ∩ ball w t) /
        (unitBallVolume n * ENNReal.ofReal (t ^ n))) (𝓝[>] 0) (𝓝 1) := by
      have hrad : ∀ x : D, ∃ ε : ℝ, 0 < ε ∧ closedBall (x : Euclid P) ε ⊆ D := by
        intro x
        obtain ⟨ε, hε, hεD⟩ := Metric.isOpen_iff.mp hD x x.2
        exact ⟨ε / 2, half_pos hε, (closedBall_subset_ball (half_lt_self hε)).trans hεD⟩
      choose ε hε hεD using hrad
      obtain ⟨T, hTc, hT⟩ := TopologicalSpace.isOpen_iUnion_countable
        (fun x : D => ball (x : Euclid P) (ε x)) (fun _ => isOpen_ball)
      have hcov : (⋃ x ∈ T, ball (x : Euclid P) (ε x)) = D := by
        rw [hT]
        apply subset_antisymm
        · exact iUnion_subset fun x => ball_subset_closedBall.trans (hεD x)
        · intro y hy
          exact mem_iUnion.mpr ⟨⟨y, hy⟩, mem_ball_self (hε ⟨y, hy⟩)⟩
      have hBae : ∀ᵐ w ∂(μHE[n].restrict B), w ∈ D :=
        (ae_restrict_mem hBm).mono fun w hw => hBD hw
      rw [← Measure.restrict_eq_self_of_ae_mem hBae, ← hcov,
        ae_restrict_biUnion_iff _ hTc]
      intro x _
      rw [Measure.restrict_restrict measurableSet_ball]
      have hSm : MeasurableSet (ball (x : Euclid P) (ε x) ∩ B) := measurableSet_ball.inter hBm
      have hSrect : CountablyRectifiable n (ball (x : Euclid P) (ε x) ∩ B) :=
        hBrect.mono inter_subset_right
      have hSfin : μHE[n] (ball (x : Euclid P) (ε x) ∩ B) ≠ ∞ :=
        ne_top_of_le_ne_top (hloc _ (isCompact_closedBall _ _) (hεD x))
          (measure_mono fun y hy => ⟨hy.2, ball_subset_closedBall hy.1⟩)
      filter_upwards [hRD _ hSm hSrect hSfin, ae_restrict_mem hSm] with w hw hwS
      refine hw.congr' ?_
      obtain ⟨δ, hδ, hδW⟩ := Metric.isOpen_iff.mp isOpen_ball w hwS.1
      filter_upwards [Ioo_mem_nhdsGT hδ] with t ht
      have hset : ball (x : Euclid P) (ε x) ∩ B ∩ ball w t = B ∩ ball w t := by
        ext y
        constructor
        · rintro ⟨⟨_, hyB⟩, hyt⟩
          exact ⟨hyB, hyt⟩
        · rintro ⟨hyB, hyt⟩
          exact ⟨⟨hδW (ball_subset_ball ht.2.le hyt), hyB⟩, hyt⟩
      rw [hset]
    -- Step 2: pass from open to closed balls by squeezing between radii `t` and `t + t²`
    filter_upwards [hopen] with w hw
    set c : ℝ → ℝ≥0∞ := fun t => unitBallVolume n * ENNReal.ofReal (t ^ n) with hcdef
    set q : ℝ → ℝ≥0∞ := fun t => μHE[n] (B ∩ ball w t) / c t with hqdef
    have hs : Tendsto (fun t : ℝ => t + t ^ 2) (𝓝[>] 0) (𝓝[>] 0) := by
      apply tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within
      · have : Tendsto (fun t : ℝ => t + t ^ 2) (𝓝 0) (𝓝 (0 + 0 ^ 2)) :=
          (continuous_id.add (continuous_pow 2)).tendsto 0
        simpa using this.mono_left nhdsWithin_le_nhds
      · filter_upwards [self_mem_nhdsWithin] with t ht
        exact add_pos_of_pos_of_nonneg ht (sq_nonneg t)
    have hk : Tendsto (fun t : ℝ => ENNReal.ofReal ((1 + t) ^ n)) (𝓝[>] 0) (𝓝 1) := by
      have : Tendsto (fun t : ℝ => ENNReal.ofReal ((1 + t) ^ n)) (𝓝 0)
          (𝓝 (ENNReal.ofReal ((1 + 0) ^ n))) :=
        (ENNReal.continuous_ofReal.comp
          ((continuous_const.add continuous_id).pow n)).tendsto 0
      simpa using this.mono_left nhdsWithin_le_nhds
    have hupper : Tendsto (fun t : ℝ => ENNReal.ofReal ((1 + t) ^ n) * q (t + t ^ 2))
        (𝓝[>] 0) (𝓝 1) := by
      have := ENNReal.Tendsto.mul hk (Or.inl one_ne_zero) (hw.comp hs) (Or.inl one_ne_zero)
      simpa using this
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le' hw hupper ?_ ?_
    · filter_upwards [self_mem_nhdsWithin] with t ht
      show μHE[n] (B ∩ ball w t) / c t ≤ (μHE[n].restrict B) (closedBall w t) / c t
      rw [Measure.restrict_apply measurableSet_closedBall]
      have hsub : B ∩ ball w t ⊆ closedBall w t ∩ B := fun y hy =>
        ⟨ball_subset_closedBall hy.2, hy.1⟩
      exact ENNReal.div_le_div_right (measure_mono hsub) _
    · filter_upwards [self_mem_nhdsWithin] with t ht
      have ht0 : (0 : ℝ) < t := ht
      have hk0 : ENNReal.ofReal ((1 + t) ^ n) ≠ 0 :=
        (ENNReal.ofReal_pos.mpr (pow_pos (by linarith) n)).ne'
      have hktop : ENNReal.ofReal ((1 + t) ^ n) ≠ ∞ := ENNReal.ofReal_ne_top
      have hc0 : c t ≠ 0 := mul_ne_zero hω0 (ENNReal.ofReal_pos.mpr (pow_pos ht0 n)).ne'
      have hctop : c t ≠ ∞ := ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top
      have hcs : c (t + t ^ 2) = c t * ENNReal.ofReal ((1 + t) ^ n) := by
        simp only [hcdef]
        rw [mul_assoc, ← ENNReal.ofReal_mul (pow_nonneg ht0.le n), ← mul_pow]
        congr 3
        ring
      show (μHE[n].restrict B) (closedBall w t) / c t ≤
        ENNReal.ofReal ((1 + t) ^ n) * (μHE[n] (B ∩ ball w (t + t ^ 2)) / c (t + t ^ 2))
      rw [Measure.restrict_apply measurableSet_closedBall, hcs]
      have hsub : closedBall w t ∩ B ⊆ B ∩ ball w (t + t ^ 2) := fun y hy =>
        ⟨hy.2, closedBall_subset_ball (by nlinarith) hy.1⟩
      calc μHE[n] (closedBall w t ∩ B) / c t
          ≤ μHE[n] (B ∩ ball w (t + t ^ 2)) / c t := ENNReal.div_le_div_right (measure_mono hsub) _
        _ = ENNReal.ofReal ((1 + t) ^ n) *
            (μHE[n] (B ∩ ball w (t + t ^ 2)) / (c t * ENNReal.ofReal ((1 + t) ^ n))) := by
          rw [ENNReal.div_eq_inv_mul, ENNReal.div_eq_inv_mul,
            ENNReal.mul_inv (Or.inl hc0) (Or.inl hctop), ← mul_assoc, ← mul_assoc,
            mul_comm (ENNReal.ofReal _) (c t)⁻¹, mul_assoc (c t)⁻¹,
            ENNReal.mul_inv_cancel hk0 hktop, mul_one]
  -- (step 6 tool) `μ ≪ ρ` and ball ratios `μ/ρ → 1` `ρ`-a.e. force `μ = ρ` (Besicovitch)
  have heq_gen : ∀ (P : ℕ) (D : Set (Euclid P)) (μ ρ : Measure (Euclid P)), IsOpen D → μ Dᶜ = 0 → ρ Dᶜ = 0 → (∀ K : Set (Euclid P), IsCompact K → K ⊆ D → μ K ≠ ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ D → ρ K ≠ ∞) → μ ≪ ρ → (∀ᵐ w ∂ρ, Tendsto (fun t : ℝ => μ (closedBall w t) / ρ (closedBall w t)) (𝓝[>] 0) (𝓝 1)) → μ = ρ := by
    intro P D μ ρ hD hμD hρD hμK hρK hac hratio
    -- Step 1: equality on every open ball whose closure lies in `D`
    have hlocal : ∀ c : Euclid P, ∀ s : ℝ, closedBall c s ⊆ D →
        μ.restrict (ball c s) = ρ.restrict (ball c s) := by
      intro c s hcs
      have hfinμ : μ (ball c s) ≠ ∞ := ne_top_of_le_ne_top
        (hμK _ (isCompact_closedBall c s) hcs) (measure_mono ball_subset_closedBall)
      have hfinρ : ρ (ball c s) ≠ ∞ := ne_top_of_le_ne_top
        (hρK _ (isCompact_closedBall c s) hcs) (measure_mono ball_subset_closedBall)
      have : IsFiniteMeasure (μ.restrict (ball c s)) :=
        ⟨by rw [Measure.restrict_apply_univ]; exact hfinμ.lt_top⟩
      have : IsFiniteMeasure (ρ.restrict (ball c s)) :=
        ⟨by rw [Measure.restrict_apply_univ]; exact hfinρ.lt_top⟩
      have hacW : μ.restrict (ball c s) ≪ ρ.restrict (ball c s) := hac.restrict _
      have hone : (μ.restrict (ball c s)).rnDeriv (ρ.restrict (ball c s))
          =ᵐ[ρ.restrict (ball c s)] 1 := by
        filter_upwards [Besicovitch.ae_tendsto_rnDeriv (μ.restrict (ball c s))
            (ρ.restrict (ball c s)), ae_restrict_mem measurableSet_ball,
            ae_restrict_of_ae hratio] with w hw hwW hwr
        obtain ⟨ε, hε, hεW⟩ := Metric.isOpen_iff.mp isOpen_ball w hwW
        have heq : (fun t : ℝ => μ (closedBall w t) / ρ (closedBall w t)) =ᶠ[𝓝[>] 0]
            (fun t : ℝ => μ.restrict (ball c s) (closedBall w t) /
              ρ.restrict (ball c s) (closedBall w t)) := by
          filter_upwards [Ioo_mem_nhdsGT hε] with t ht
          have hsub : closedBall w t ⊆ ball c s := (closedBall_subset_ball ht.2).trans hεW
          rw [Measure.restrict_apply measurableSet_closedBall,
            Measure.restrict_apply measurableSet_closedBall, inter_eq_left.mpr hsub]
        exact tendsto_nhds_unique hw (hwr.congr' heq)
      calc μ.restrict (ball c s)
          = (ρ.restrict (ball c s)).withDensity
              ((μ.restrict (ball c s)).rnDeriv (ρ.restrict (ball c s))) :=
            by
              have h := Measure.singularPart_add_rnDeriv (μ.restrict (ball c s)) (ρ.restrict (ball c s))
              rw [Measure.singularPart_eq_zero_of_ac hacW, zero_add] at h
              exact h.symm
        _ = (ρ.restrict (ball c s)).withDensity 1 := withDensity_congr_ae hone
        _ = ρ.restrict (ball c s) := withDensity_one
    -- Step 2: countably many such balls cover `D`
    have hrad : ∀ x : D, ∃ ε : ℝ, 0 < ε ∧ closedBall (x : Euclid P) ε ⊆ D := by
      intro x
      obtain ⟨ε, hε, hεD⟩ := Metric.isOpen_iff.mp hD x x.2
      exact ⟨ε / 2, half_pos hε, (closedBall_subset_ball (half_lt_self hε)).trans hεD⟩
    choose ε hε hεD using hrad
    obtain ⟨T, hTc, hT⟩ := TopologicalSpace.isOpen_iUnion_countable
      (fun x : D => ball (x : Euclid P) (ε x)) (fun _ => isOpen_ball)
    have hcov : (⋃ x ∈ T, ball (x : Euclid P) (ε x)) = D := by
      rw [hT]
      apply subset_antisymm
      · exact iUnion_subset fun x => ball_subset_closedBall.trans (hεD x)
      · intro y hy
        exact mem_iUnion.mpr ⟨⟨y, hy⟩, mem_ball_self (hε ⟨y, hy⟩)⟩
    have hD' : μ.restrict D = ρ.restrict D := by
      rw [← hcov]
      exact (Measure.restrict_biUnion_congr hTc).mpr fun x _ => hlocal x (ε x) (hεD x)
    have hμae : ∀ᵐ x ∂μ, x ∈ D := by
      rw [ae_iff]
      exact hμD
    have hρae : ∀ᵐ x ∂ρ, x ∈ D := by
      rw [ae_iff]
      exact hρD
    rw [← Measure.restrict_eq_self_of_ae_mem hμae, ← Measure.restrict_eq_self_of_ae_mem hρae, hD']
  -- (step 7 tool) local copy of the accepted `setIntegral_blowUpMap_image_eq_inv_pow_mul`
  have hcov_gen : ∀ (P n : ℕ) (M : Set (Euclid P)) (x : Euclid P) (r : ℝ), 0 < r → ∀ f : Euclid P → ℝ, ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, f y ∂μHE[n] = r⁻¹ ^ n * ∫ y in M, f (Poincare.SimonGMT.Chapter03.blowUpMap x r y) ∂μHE[n] := by
    intro P n M x r hr f
    -- `η_{x,r} = (r⁻¹ • ·) ∘ (· - x)` is a homeomorphism
    obtain ⟨e, he⟩ : ∃ e : Euclid P ≃ₜ Euclid P,
        ⇑e = Poincare.SimonGMT.Chapter03.blowUpMap x r :=
      ⟨(Homeomorph.subRight x).trans (Homeomorph.smulOfNeZero r⁻¹ (inv_ne_zero hr.ne')), rfl⟩
    -- `Hⁿ(η_{x,r}(S)) = ‖r⁻¹‖₊ⁿ Hⁿ(S)` for every set `S`
    have hscale : ∀ S : Set (Euclid P), μHE[n] (e '' S) = ‖r⁻¹‖₊ ^ n • μHE[n] S := by
      intro S
      have hS : e '' S = (fun y => r⁻¹ • y) '' ((IsometryEquiv.subRight x) '' S) := by
        rw [image_image, he]
        rfl
      rw [hS, image_smul, Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hr.ne'),
        (IsometryEquiv.subRight x).isometry.euclideanHausdorffMeasure_image]
    -- `Hⁿ⌞η_{x,r}(M) = ‖r⁻¹‖₊ⁿ η_{x,r#}(Hⁿ⌞M)`, checked on Borel sets
    have hmeas : μHE[n].restrict (e '' M) = (‖r⁻¹‖₊ ^ n) • (μHE[n].restrict M).map e := by
      ext A hA
      rw [Measure.restrict_apply hA, Measure.smul_apply, Measure.map_apply e.measurable hA,
        Measure.restrict_apply (hA.preimage e.measurable), ← hscale, image_inter e.injective,
        e.image_preimage]
    -- change of variables, with `‖r⁻¹‖₊ⁿ = r⁻¹ ^ n`
    rw [← he, hmeas, integral_smul_nnreal_measure, e.measurableEmbedding.integral_map,
      NNReal.smul_def, smul_eq_mul, NNReal.coe_pow, coe_nnnorm, Real.norm_eq_abs,
      abs_of_pos (inv_pos.2 hr)]
  -- Step 1: the good set `G` of flat-tangent points, of full `μ`-measure
  set G : Set (Euclid (m + 1)) := {y | ∀ f : Euclid (m + 1) → ℝ, Continuous f →
    HasCompactSupport f → Tendsto (fun r : ℝ => (r ^ m)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) ∂μ)
      (𝓝[>] 0) (𝓝 (∫ z in ((Submodule.span ℝ {ν y})ᗮ : Set (Euclid (m + 1))), f z ∂μHE[m]))}
    with hGdef
  have hGc : μ Gᶜ = 0 := hflat
  -- Step 2: rectifiable carrier `B = (D ∩ R) \ N`
  obtain ⟨R, hRm, hRrect, hRc⟩ :=
    Submission.codim1_rdo_dg_rectifiable_of_flat_tangent m D μ ν hm hD hμD hμK hνm hν1 hflat
  set N : Set (Euclid (m + 1)) := toMeasurable μ Gᶜ with hNdef
  set B : Set (Euclid (m + 1)) := (D ∩ R) \ N with hBdef
  have hBm : MeasurableSet B :=
    (hD.measurableSet.inter hRm).diff (measurableSet_toMeasurable _ _)
  have hBD : B ⊆ D := fun y hy => hy.1.1
  have hBrect : CountablyRectifiable m B := hRrect.mono fun y hy => hy.1.2
  have hBG : ∀ y ∈ B, y ∈ G := by
    intro y hy
    by_contra h
    exact hy.2 (subset_toMeasurable μ Gᶜ h)
  have hN : μ N = 0 := by rw [hNdef, measure_toMeasurable]; exact hGc
  have hμBc : μ Bᶜ = 0 := by
    have hsub : Bᶜ ⊆ Dᶜ ∪ Rᶜ ∪ N := by
      intro y hy
      by_cases hyD : y ∈ D
      · by_cases hyR : y ∈ R
        · right
          by_contra hyN
          exact hy ⟨⟨hyD, hyR⟩, hyN⟩
        · left; right; exact hyR
      · left; left; exact hyD
    exact measure_mono_null hsub (measure_union_null (measure_union_null hμD hRc) hN)
  -- Step 1 (cont.): density one of `μ` at every point of `B`
  have hdens : ∀ y ∈ B, Tendsto (fun r : ℝ => μ (closedBall y r) /
      (unitBallVolume m * ENNReal.ofReal (r ^ m))) (𝓝[>] 0) (𝓝 1) := by
    intro y hy
    obtain ⟨ε, hε, hεD⟩ := Metric.isOpen_iff.mp hD y (hBD hy)
    have hfin : ∃ r₀ : ℝ, 0 < r₀ ∧ μ (closedBall y r₀) ≠ ∞ :=
      ⟨ε / 2, half_pos hε, hμK _ (isCompact_closedBall y (ε / 2))
        ((closedBall_subset_ball (half_lt_self hε)).trans hεD)⟩
    exact (Submission.codim1_rdo_dg_flat_tangent_density_cone m μ y (ν y) hm (hν1 y) hfin
      (hBG y hy)).1
  have hω0 : unitBallVolume m ≠ 0 := (measure_ball_pos _ _ zero_lt_one).ne'
  have hωtop : unitBallVolume m ≠ ∞ := measure_ball_lt_top.ne
  -- Step 3: local finiteness of `Hᵐ⌞B` by the density comparison
  have hω2top : unitBallVolume m / 2 ≠ ∞ := ENNReal.div_ne_top hωtop two_ne_zero
  set c : ℝ := (unitBallVolume m / 2).toReal with hcdef
  have hc : 0 < c := ENNReal.toReal_pos (ENNReal.div_ne_zero.mpr ⟨hω0, ENNReal.ofNat_ne_top⟩)
    hω2top
  obtain ⟨C, hCtop, hcmp⟩ := hcmp_gen (m + 1) m c hc
  have hlow : ∀ x ∈ B, ∃ t₀ : ℝ, 0 < t₀ ∧ ∀ t : ℝ, 0 < t → t < t₀ →
      ENNReal.ofReal (c * t ^ m) ≤ μ (closedBall x t) := by
    intro x hx
    have h := (hdens x hx).eventually (lt_mem_nhds (by norm_num : (2⁻¹ : ℝ≥0∞) < 1))
    obtain ⟨t₀, ht₀, hsub⟩ := (nhdsGT_basis (0 : ℝ)).mem_iff.mp h
    refine ⟨t₀, ht₀, fun t ht htt => ?_⟩
    have hq : 2⁻¹ < μ (closedBall x t) / (unitBallVolume m * ENNReal.ofReal (t ^ m)) :=
      hsub ⟨ht, htt⟩
    have hden0 : unitBallVolume m * ENNReal.ofReal (t ^ m) ≠ 0 :=
      mul_ne_zero hω0 (ENNReal.ofReal_pos.mpr (pow_pos ht m)).ne'
    have hdentop : unitBallVolume m * ENNReal.ofReal (t ^ m) ≠ ∞ :=
      ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top
    have hlt := (ENNReal.lt_div_iff_mul_lt (Or.inl hden0) (Or.inl hdentop)).mp hq
    calc ENNReal.ofReal (c * t ^ m) = unitBallVolume m / 2 * ENNReal.ofReal (t ^ m) := by
          rw [ENNReal.ofReal_mul hc.le, hcdef, ENNReal.ofReal_toReal hω2top]
      _ = 2⁻¹ * (unitBallVolume m * ENNReal.ofReal (t ^ m)) := by
          rw [ENNReal.div_eq_inv_mul, mul_assoc]
      _ ≤ μ (closedBall x t) := hlt.le
  have hloc : ∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μHE[m] (B ∩ K) ≠ ∞ := by
    intro K hK hKD
    obtain ⟨δ, hδ, hδD⟩ := hK.exists_cthickening_subset_open hD hKD
    have hle := hcmp μ (B ∩ K) (thickening δ K) isOpen_thickening
      (inter_subset_right.trans (self_subset_thickening hδ K)) (fun x hx => hlow x hx.1)
    exact ne_top_of_le_ne_top (ENNReal.mul_ne_top hCtop (hμK _ hK.cthickening hδD))
      (hle.trans (mul_le_mul' le_rfl (measure_mono (thickening_subset_cthickening δ K))))
  set ρ : Measure (Euclid (m + 1)) := μHE[m].restrict B with hρdef
  have hρDc : ρ Dᶜ = 0 := by
    rw [hρdef, Measure.restrict_apply hD.measurableSet.compl]
    have : Dᶜ ∩ B = ∅ := by
      ext y
      simp only [mem_inter_iff, mem_compl_iff, mem_empty_iff_false, iff_false, not_and]
      intro hyD hyB
      exact hyD (hBD hyB)
    rw [this, measure_empty]
  have hρK : ∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → ρ K ≠ ∞ := by
    intro K hK hKD
    rw [hρdef, Measure.restrict_apply' hBm, inter_comm]
    exact hloc K hK hKD
  -- Step 4: `μ ≪ Hᵐ⌞B`
  have hac : μ ≪ ρ := by
    intro A hA
    rw [hρdef, Measure.restrict_apply' hBm] at hA
    have h1 : μ (A ∩ B) = 0 :=
      hnull_gen (m + 1) m μ (A ∩ B)
        (fun x hx => hdens x hx.2) hA
    refine measure_mono_null (fun y hy => ?_) (measure_union_null h1 hμBc)
    by_cases hyB : y ∈ B
    · exact Or.inl ⟨hy, hyB⟩
    · exact Or.inr hyB
  -- Step 5: density one of `Hᵐ⌞B`
  have hρdens := hdens_gen (m + 1) m D B hD hBm
    hBD hBrect hloc hRD
  -- Step 6: ball ratios and identification
  have hratio : ∀ᵐ w ∂ρ, Tendsto (fun t : ℝ => μ (closedBall w t) / ρ (closedBall w t))
      (𝓝[>] 0) (𝓝 1) := by
    filter_upwards [hρdens, ae_restrict_mem hBm] with w hw hwB
    have h := ENNReal.Tendsto.div (hdens w hwB) (Or.inl one_ne_zero) hw
      (Or.inl ENNReal.one_ne_top)
    rw [ENNReal.div_self one_ne_zero ENNReal.one_ne_top] at h
    refine h.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with t ht
    have hc0 : unitBallVolume m * ENNReal.ofReal (t ^ m) ≠ 0 :=
      mul_ne_zero hω0 (ENNReal.ofReal_pos.mpr (pow_pos ht m)).ne'
    have hctop : unitBallVolume m * ENNReal.ofReal (t ^ m) ≠ ∞ :=
      ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top
    show μ (closedBall w t) / (unitBallVolume m * ENNReal.ofReal (t ^ m)) /
        (ρ (closedBall w t) / (unitBallVolume m * ENNReal.ofReal (t ^ m))) =
      μ (closedBall w t) / ρ (closedBall w t)
    conv_lhs => rw [div_eq_mul_inv (μ (closedBall w t)), div_eq_mul_inv (ρ (closedBall w t))]
    exact ENNReal.mul_div_mul_right _ _ (ENNReal.inv_ne_zero.mpr hctop)
      (ENNReal.inv_ne_top.mpr hc0)
  have hμeq : μ = μHE[m].restrict B :=
    heq_gen (m + 1) D μ ρ hD hμD hρDc hμK hρK hac hratio
  refine ⟨B, hBm, hBD, hBrect, hμeq, ?_⟩
  -- Step 7: approximate tangent planes by scaling
  filter_upwards [ae_restrict_mem hBm] with y hy
  have hν0 : ν y ≠ 0 := by
    intro h
    have := hν1 y
    rw [h, norm_zero] at this
    exact zero_ne_one this
  have hflaty : y ∈ G := hBG y hy
  simp only [hGdef, mem_ofPred_eq] at hflaty
  rw [hμeq] at hflaty
  refine ⟨?_, fun f => ?_⟩
  · have : Fact (Module.finrank ℝ (Euclid (m + 1)) = m + 1) := ⟨finrank_euclideanSpace_fin⟩
    exact Submodule.finrank_orthogonal_span_singleton hν0
  · refine (hflaty f f.continuous f.hasCompactSupport).congr' ?_
    filter_upwards [self_mem_nhdsWithin] with r hr
    rw [hcov_gen (m + 1) m B y r hr f, inv_pow]
    rfl
/-- Coefficient bound for a determinant covector (Simon 7.5, the test form of the chart
perimeter estimate).  If `α(a₁, …, aₙ) = det[p, Aa₁, …, Aaₙ]` with `‖A‖ ≤ 1` and `|p| ≤ 1`, then
every entry of the matrix `[p, Ae_{I(1)}, …, Ae_{I(n)}]` has absolute value `≤ 1`, so the Leibniz
formula gives `|α(e_I)| ≤ (n+1)!`; summing over the `Pⁿ` index tuples `I` yields
`|α| ≤ (Pⁿ ((n+1)!)²)^{1/2} = (n+1)! √(Pⁿ)`. -/
theorem Submission.codim1_lur_det_covector_norm_le : ∀ (P n : ℕ) (A : Euclid P →L[ℝ] Euclid (n + 1)) (p : Euclid (n + 1)) (α : Covector (Euclid P) n), ‖A‖ ≤ 1 → ‖p‖ ≤ 1 → (∀ a : Fin n → Euclid P, α a = Matrix.det (Matrix.of fun r c : Fin (n + 1) => (Fin.cons p (fun k : Fin n => A (a k)) : Fin (n + 1) → Euclid (n + 1)) c r)) → covectorEuclideanNorm α ≤ ((n + 1).factorial : ℝ) * Real.sqrt ((P : ℝ) ^ n) := by
  intro P n A p α hA hp hα
  -- Leibniz: a real `m × m` matrix with entries of absolute value `≤ 1` has `|det| ≤ m!`
  have hleib : ∀ (m : ℕ) (M : Matrix (Fin m) (Fin m) ℝ), (∀ r c, |M r c| ≤ 1) →
      |M.det| ≤ (m.factorial : ℝ) := by
    intro m M hM
    rw [Matrix.det_apply]
    calc |∑ σ : Equiv.Perm (Fin m), Equiv.Perm.sign σ • ∏ i, M (σ i) i|
        ≤ ∑ σ : Equiv.Perm (Fin m), |Equiv.Perm.sign σ • ∏ i, M (σ i) i| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _σ : Equiv.Perm (Fin m), (1 : ℝ) := by
          refine Finset.sum_le_sum fun σ _ => ?_
          rw [Units.smul_def, zsmul_eq_mul, abs_mul]
          have hs : |((Equiv.Perm.sign σ : ℤ) : ℝ)| = 1 := by
            rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h | h <;> simp [h]
          rw [hs, one_mul, Finset.abs_prod]
          exact Finset.prod_le_one₀ (fun i _ => abs_nonneg _) (fun i _ => hM _ _)
      _ = (m.factorial : ℝ) := by
          simp [Finset.card_univ, Fintype.card_perm]
  -- every coefficient `α(e_I) = det[p, Ae_{I(1)}, …, Ae_{I(n)}]` is bounded by `(n+1)!`
  have hcoef : ∀ I : Fin n → Fin P,
      |α (fun i => EuclideanSpace.basisFun (Fin P) ℝ (I i))| ≤ ((n + 1).factorial : ℝ) := by
    intro I
    rw [hα]
    apply hleib
    intro r c
    refine Fin.cases ?_ (fun k => ?_) c
    · simpa [Real.norm_eq_abs] using (PiLp.norm_apply_le p r).trans hp
    · simp only [Matrix.of_apply, Fin.cons_succ]
      have h1 := PiLp.norm_apply_le (A (EuclideanSpace.basisFun (Fin P) ℝ (I k))) r
      have h2 : ‖A (EuclideanSpace.basisFun (Fin P) ℝ (I k))‖ ≤ 1 := by
        calc ‖A (EuclideanSpace.basisFun (Fin P) ℝ (I k))‖
            ≤ ‖A‖ * ‖EuclideanSpace.basisFun (Fin P) ℝ (I k)‖ := A.le_opNorm _
          _ = ‖A‖ := by simp
          _ ≤ 1 := hA
      rw [← Real.norm_eq_abs]
      exact h1.trans h2
  -- sum the squared coefficients over the `Pⁿ` index tuples
  unfold covectorEuclideanNorm
  have hF : (0 : ℝ) ≤ ((n + 1).factorial : ℝ) := by positivity
  calc Real.sqrt (∑ I : Fin n → Fin P, if StrictMono I then
        (α (fun i => EuclideanSpace.basisFun (Fin P) ℝ (I i))) ^ 2 else 0)
      ≤ Real.sqrt (∑ _I : Fin n → Fin P, ((n + 1).factorial : ℝ) ^ 2) := by
        apply Real.sqrt_le_sqrt
        refine Finset.sum_le_sum fun I _ => ?_
        split_ifs
        · exact sq_le_sq' (abs_le.1 (hcoef I)).1 (abs_le.1 (hcoef I)).2
        · positivity
    _ = ((n + 1).factorial : ℝ) * Real.sqrt ((P : ℝ) ^ n) := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fun, Fintype.card_fin,
          Fintype.card_fin, nsmul_eq_mul, Real.sqrt_mul (by positivity), Real.sqrt_sq hF,
          mul_comm]
        push_cast
        ring
/-- **Simon 7.5** (codimension one, oriented normal frame): for a unit vector `ν ∈ ℝ^{n+1}`,
`n ≥ 1`, some orthonormal basis `σ` of `ν^⊥` has `det[ν, σ] = −1`, where `[ν, σ]` is the matrix
with columns `ν, σ₀, …, σₙ₋₁`.  For an orthonormal basis `τ` of `ν^⊥`, `W = [ν, τ]` has
orthonormal columns, so `WᵀW = 1` and `d = det W` has `d² = 1`; `σ` replaces `τ₀` by `−d τ₀`,
which keeps the frame orthonormal with the same span and gives `det[ν, σ] = −d² = −1`. -/
theorem Submission.codim1_lur_no_oriented_normal_frame : ∀ (n : ℕ) (ν : Euclid (n + 1)), 1 ≤ n → ‖ν‖ = 1 → ∃ σ : Fin n → Euclid (n + 1), Orthonormal ℝ σ ∧ Submodule.span ℝ (Set.range σ) = (Submodule.span ℝ {ν})ᗮ ∧ Matrix.det (Matrix.of fun r c : Fin (n + 1) => (Fin.cons ν σ : Fin (n + 1) → Euclid (n + 1)) c r) = -1 := by
  intro n ν hn hν
  -- `Q = ν^⊥` has dimension `n`
  have hν0 : ν ≠ 0 := by
    rintro rfl
    simp at hν
  have : Fact (Module.finrank ℝ (Euclid (n + 1)) = n + 1) := ⟨finrank_euclideanSpace_fin⟩
  have hQn : Module.finrank ℝ (Submodule.span ℝ {ν})ᗮ = n :=
    Submodule.finrank_orthogonal_span_singleton hν0
  -- an orthonormal basis `τ` of `Q` indexed by `Fin n`: it spans `Q` and is orthogonal to `ν`
  let b : OrthonormalBasis (Fin n) ℝ (Submodule.span ℝ {ν})ᗮ :=
    (stdOrthonormalBasis ℝ (Submodule.span ℝ {ν})ᗮ).reindex (finCongr hQn)
  let τ : Fin n → Euclid (n + 1) := fun k => (b k : Euclid (n + 1))
  have hτo : Orthonormal ℝ τ :=
    b.orthonormal.comp_linearIsometry (Submodule.span ℝ {ν})ᗮ.subtypeₗᵢ
  have hτs : Submodule.span ℝ (Set.range τ) = (Submodule.span ℝ {ν})ᗮ := by
    have hr : Set.range τ = (Submodule.span ℝ {ν})ᗮ.subtype '' Set.range b := by
      rw [← Set.range_comp]
      rfl
    have hb : Submodule.span ℝ (Set.range b) = ⊤ := by
      rw [← b.coe_toBasis]
      exact b.toBasis.span_eq
    rw [hr, Submodule.span_image, hb, Submodule.map_top, Submodule.range_subtype]
  have hτν : ∀ k, inner ℝ ν (τ k) = 0 := fun k =>
    Submodule.mem_orthogonal_singleton_iff_inner_right.mp (b k).2
  -- `u = (ν, τ₀, …, τₙ₋₁)` is orthonormal
  let u : Fin (n + 1) → Euclid (n + 1) := Fin.cons ν τ
  have hu : Orthonormal ℝ u := by
    rw [orthonormal_iff_ite]
    intro i j
    induction i using Fin.cases with
    | zero =>
      induction j using Fin.cases with
      | zero => simp [u, hν]
      | succ j => simp [u, hτν, (Fin.succ_ne_zero j).symm]
    | succ i =>
      induction j using Fin.cases with
      | zero => simp [u, real_inner_comm, hτν, Fin.succ_ne_zero]
      | succ j => simp [u, (orthonormal_iff_ite.mp hτo) i j]
  -- `W = [ν, τ]` has `WᵀW = 1`, so `d = det W` satisfies `d * d = 1`
  let W : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ := Matrix.of fun r c => u c r
  have hWW : W.transpose * W = 1 := by
    ext c c'
    rw [Matrix.mul_apply, Matrix.one_apply, ← (orthonormal_iff_ite.mp hu) c c']
    simp [W, PiLp.inner_apply, mul_comm]
  set d := W.det with hd_def
  have hd : d * d = 1 := by
    calc d * d = (W.transpose * W).det := by rw [Matrix.det_mul, Matrix.det_transpose]
      _ = 1 := by rw [hWW, Matrix.det_one]
  -- `σ` replaces `τ i₀` by `(-d) • τ i₀` (`i₀ = 0`, as `n ≥ 1`)
  let i0 : Fin n := ⟨0, hn⟩
  let σ : Fin n → Euclid (n + 1) := Function.update τ i0 ((-d) • τ i0)
  have hσo : Orthonormal ℝ σ := by
    rw [orthonormal_iff_ite]
    intro i j
    have hτ := orthonormal_iff_ite.mp hτo
    by_cases hi : i = i0 <;> by_cases hj : j = i0
    · subst hi hj
      simp only [σ, Function.update_self, real_inner_smul_left, real_inner_smul_right, hτ,
        ↓reduceIte, mul_one]
      linear_combination hd
    · subst hi
      simp [σ, real_inner_smul_left, Function.update_of_ne hj, hτ, Ne.symm hj]
    · subst hj
      simp [σ, real_inner_smul_right, hτ, hi]
    · simp [σ, Function.update_of_ne hi, Function.update_of_ne hj, hτ]
  have hσs : Submodule.span ℝ (Set.range σ) = Submodule.span ℝ (Set.range τ) := by
    apply le_antisymm
    · rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      by_cases hi : i = i0
      · subst hi
        simp only [σ, Function.update_self]
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i0, rfl⟩)
      · simp only [σ, Function.update_of_ne hi]
        exact Submodule.subset_span ⟨i, rfl⟩
    · rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      by_cases hi : i = i0
      · subst hi
        have h : τ i0 = (-d) • σ i0 := by
          simp only [σ, Function.update_self, smul_smul, neg_mul_neg, hd, one_smul]
        rw [h]
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i0, rfl⟩)
      · have h : τ i = σ i := by simp only [σ, Function.update_of_ne hi]
        rw [h]
        exact Submodule.subset_span ⟨i, rfl⟩
  refine ⟨σ, hσo, hσs.trans hτs, ?_⟩
  -- `[ν, σ]` is `W` with column `i₀ + 1` multiplied by `-d`, so its determinant is `-d * d`
  have hM : (Matrix.of fun r c : Fin (n + 1) => (Fin.cons ν σ : Fin (n + 1) → Euclid (n + 1)) c r)
      = W.updateCol i0.succ ((-d) • fun r => W r i0.succ) := by
    ext r c
    simp only [σ, Fin.cons_update, Matrix.of_apply, Matrix.updateCol_apply, Function.update_apply,
      W, u]
    split_ifs with h
    · subst h
      simp
    · rfl
  rw [hM, Matrix.det_updateCol_smul, Matrix.updateCol_eq_self, ← hd_def, neg_mul, hd]
/-- **An `n`-covector on `ℝ^{n+1}` is a determinant with first column `φ_β`** (linear algebra
for the normal orientation of `T = ∂[[E]]`, Simon §7.5).  With `b_j = β(e ∘ j.succAbove)` and
`φ_β = ∑ⱼ (-1)ʲ b_j e_j`, `β a = det[φ_β, a]`, the matrix with columns `φ_β, a₀, …, a_{n-1}`.
Both sides are alternating in `a`, so it suffices to compare them on injective basis tuples
`e ∘ v` (`Module.Basis.ext_alternating`).  An injective `v` misses an index `m` and equals
`m.succAbove ∘ σ` for a permutation `σ`, so both sides acquire the factor `sign σ`.  At the
sorted tuple `e ∘ m.succAbove` only the column term `j = m` survives (for `j ≠ m`, `e_j` is
repeated), and `det[e_m, e ∘ m.succAbove] = sign (cycleRange m)⁻¹ = (-1)ᵐ`, so both sides equal
`(-1)ᵐ (-1)ᵐ b_m = b_m`. -/
theorem Submission.codim1_lur_no_covector_eq_det_cons : ∀ (n : ℕ) (β : Covector (Euclid (n + 1)) n) (a : Fin n → Euclid (n + 1)), β a = Matrix.det (Matrix.of fun r c : Fin (n + 1) => (Fin.cons (∑ j : Fin (n + 1), ((-1 : ℝ) ^ (j : ℕ) * β (fun k => EuclideanSpace.single (j.succAbove k) (1 : ℝ))) • EuclideanSpace.single j (1 : ℝ)) a : Fin (n + 1) → Euclid (n + 1)) c r) := by
  intro n β a
  -- the standard basis `e` of `ℝ^{n+1}`, `e j = EuclideanSpace.single j 1`
  set e : Module.Basis (Fin (n + 1)) ℝ (Euclid (n + 1)) :=
    (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis with he_def
  have he : ∀ j, e j = EuclideanSpace.single j (1 : ℝ) := fun j => by
    rw [he_def, OrthonormalBasis.coe_toBasis, EuclideanSpace.basisFun_apply]
  set φ : Euclid (n + 1) := ∑ j : Fin (n + 1), ((-1 : ℝ) ^ (j : ℕ) *
    β (fun k => EuclideanSpace.single (j.succAbove k) (1 : ℝ))) • EuclideanSpace.single j (1 : ℝ)
    with hφ
  -- Step 0: the matrix determinant is `e.det` of the column family `[φ, a]`
  have hdet : ∀ w : Fin (n + 1) → Euclid (n + 1),
      Matrix.det (Matrix.of fun r c : Fin (n + 1) => w c r) = e.det w := by
    intro w
    rw [Module.Basis.det_apply]
    congr 1
  rw [hdet]
  -- Step 1: both sides are alternating in `a`; compare `β` with `e.det.curryLeft φ`
  suffices hFG : β.toAlternatingMap = e.det.curryLeft φ from DFunLike.congr_fun hFG a
  refine Module.Basis.ext_alternating e fun v hv => ?_
  -- Step 2: an injective `v` misses some index `m`
  obtain ⟨m, hm⟩ : ∃ m : Fin (n + 1), ∀ l, v l ≠ m := by
    by_contra h
    have hs : Function.Surjective v := fun m => by
      by_contra hm
      exact h ⟨m, fun l hl => hm ⟨l, hl⟩⟩
    have := Fintype.card_le_of_surjective v hs
    simp at this
  -- `v = m.succAbove ∘ σ` for a permutation `σ` of `Fin n`
  choose ρ hρ using fun l => Fin.exists_succAbove_eq (hm l)
  have hρinj : Function.Injective ρ := fun l l' h => hv (by rw [← hρ l, ← hρ l', h])
  set σ : Equiv.Perm (Fin n) := Equiv.ofBijective ρ (Finite.injective_iff_bijective.mp hρinj)
  have hvσ : (fun i => e (v i)) = (fun k => e (m.succAbove k)) ∘ σ := by
    funext i
    simp [σ, hρ]
  -- both sides change by `sign σ`
  rw [hvσ, AlternatingMap.map_perm, AlternatingMap.map_perm]
  congr 1
  -- Step 3: the sorted tuple `e ∘ m.succAbove`; only the column term `j = m` survives
  have hcol : ∀ j : Fin (n + 1), e.det.curryLeft (e j) (fun k => e (m.succAbove k)) =
      if j = m then (-1 : ℝ) ^ (m : ℕ) else 0 := by
    intro j
    rw [AlternatingMap.curryLeft_apply_apply]
    split_ifs with hjm
    · subst hjm
      have hcyc : (Matrix.vecCons (e j) fun k => e (j.succAbove k)) = e ∘ ⇑j.cycleRange.symm := by
        funext i
        refine Fin.cases ?_ (fun k => ?_) i <;> simp
      rw [hcyc, AlternatingMap.map_perm, Module.Basis.det_self, Equiv.Perm.sign_symm,
        Fin.sign_cycleRange]
      simp [Units.smul_def]
    · obtain ⟨l, hl⟩ := Fin.exists_succAbove_eq hjm
      refine AlternatingMap.map_eq_zero_of_eq _ _ (i := 0) (j := l.succ) ?_ (Fin.succ_ne_zero l).symm
      simp [hl]
  have hφe : φ = ∑ j : Fin (n + 1), ((-1 : ℝ) ^ (j : ℕ) *
      β (fun k => EuclideanSpace.single (j.succAbove k) (1 : ℝ))) • e j := by
    simp only [hφ, he]
  -- evaluation at a tuple is additive
  have hsum : ∀ (g : Fin (n + 1) → Euclid (n + 1) [⋀^Fin n]→ₗ[ℝ] ℝ) (w : Fin n → Euclid (n + 1)),
      (∑ j, g j) w = ∑ j, g j w := fun g w =>
    map_sum (AddMonoidHom.mk' (fun f : Euclid (n + 1) [⋀^Fin n]→ₗ[ℝ] ℝ => f w) fun _ _ => rfl) g
      Finset.univ
  rw [hφe, map_sum, hsum]
  simp only [map_smul, AlternatingMap.smul_apply, hcol, smul_eq_mul, mul_ite, mul_zero,
    Finset.sum_ite_eq', Finset.mem_univ, ite_true]
  simp only [ContinuousAlternatingMap.coe_toAlternatingMap, he]
  rw [mul_comm, ← mul_assoc, ← pow_add, ← two_mul, pow_mul, neg_one_sq, one_pow, one_mul]
/-- **Normal decomposition of a column determinant** (the determinant step of the normal
orientation of a codimension-one current).  If `‖ν‖ = 1` and `σ₀, …, σₙ₋₁` span `ν^⊥`, then
`det[w, σ] = ⟨w, ν⟩ det[ν, σ]`.  The column determinant is the standard-basis determinant of
`(x, σ)`, linear in the first column `x`, and `w - ⟨w, ν⟩ν ∈ ν^⊥ = span σ`, so the columns
`(w - ⟨w, ν⟩ν, σ)` are linearly dependent and contribute `0`.  Orthonormality of `σ` is not
used. -/
theorem Submission.codim1_lur_no_det_cons_normal_decomp : ∀ (n : ℕ) (ν w : Euclid (n + 1)) (σ : Fin n → Euclid (n + 1)), ‖ν‖ = 1 → Submodule.span ℝ (Set.range σ) = (Submodule.span ℝ {ν})ᗮ → Matrix.det (Matrix.of fun r c : Fin (n + 1) => (Fin.cons w σ : Fin (n + 1) → Euclid (n + 1)) c r) = inner ℝ w ν * Matrix.det (Matrix.of fun r c : Fin (n + 1) => (Fin.cons ν σ : Fin (n + 1) → Euclid (n + 1)) c r) := by
  intro n ν w σ hν hspan
  -- `det[x, σ]` is the standard-basis determinant of the columns `(x, σ)`
  have hD : ∀ x : Euclid (n + 1), Matrix.det (Matrix.of fun r c : Fin (n + 1) =>
      (Fin.cons x σ : Fin (n + 1) → Euclid (n + 1)) c r) =
        (PiLp.basisFun 2 ℝ (Fin (n + 1))).det (Matrix.vecCons x σ) := fun _ => rfl
  -- `q = w - ⟨w, ν⟩ν` lies in `ν^⊥ = span σ`, so the columns `(q, σ)` are linearly dependent
  have hq : w - inner ℝ w ν • ν ∈ Submodule.span ℝ (Set.range σ) := by
    rw [hspan, Submodule.mem_orthogonal_singleton_iff_inner_right, inner_sub_right,
      real_inner_smul_right, real_inner_self_eq_norm_sq, hν, real_inner_comm w ν]
    ring
  have h0 : (PiLp.basisFun 2 ℝ (Fin (n + 1))).det (Matrix.vecCons (w - inner ℝ w ν • ν) σ) = 0 :=
    AlternatingMap.map_linearDependent _ _ fun h => (linearIndependent_finCons.mp h).2 hq
  -- linearity in the first column along `w = q + ⟨w, ν⟩ν`
  have hw : Matrix.vecCons w σ = Matrix.vecCons (w - inner ℝ w ν • ν + inner ℝ w ν • ν) σ := by
    rw [sub_add_cancel]
  rw [hD, hD, hw, AlternatingMap.map_vecCons_add, h0, zero_add, AlternatingMap.map_vecCons_smul,
    smul_eq_mul]

/-- **Orienting `∂[[E]]` by the unit normal** (Simon 7.5.2 (∗), the orientation computation of
the local unit representation).  For a unit vector `ν ∈ ℝ^{n+1}`, `n ≥ 1`, some orthonormal frame
`σ` of `ν^⊥` has `β(σ) = −⟨φ_β, ν⟩` for every `n`-covector `β`, where
`φ_β = Σⱼ (−1)ʲ β(e_{j.succAbove 0}, …, e_{j.succAbove (n−1)}) eⱼ`: take `σ` with
`det[ν, σ] = −1`; then `β(σ) = det[φ_β, σ] = ⟨φ_β, ν⟩ det[ν, σ]`. -/
theorem Submission.codim1_lur_normal_covector_orientation : ∀ (n : ℕ) (ν : Euclid (n + 1)), 1 ≤ n → ‖ν‖ = 1 → ∃ σ : Fin n → Euclid (n + 1), Orthonormal ℝ σ ∧ Submodule.span ℝ (Set.range σ) = (Submodule.span ℝ {ν})ᗮ ∧ ∀ β : Covector (Euclid (n + 1)) n, β σ = -∑ j : Fin (n + 1), (-1 : ℝ) ^ (j : ℕ) * β (fun k => EuclideanSpace.single (j.succAbove k) (1 : ℝ)) * inner ℝ (EuclideanSpace.single j (1 : ℝ)) ν := by
  intro n ν hn hν
  obtain ⟨σ, hσ, hspan, hdet⟩ := Submission.codim1_lur_no_oriented_normal_frame n ν hn hν
  refine ⟨σ, hσ, hspan, fun β => ?_⟩
  -- `β(σ) = det[φ_β, σ] = ⟨φ_β, ν⟩ det[ν, σ] = −⟨φ_β, ν⟩`, then expand `⟨φ_β, ν⟩` linearly
  rw [Submission.codim1_lur_no_covector_eq_det_cons n β σ,
    Submission.codim1_lur_no_det_cons_normal_decomp n ν _ σ hν hspan, hdet, sum_inner]
  simp only [real_inner_smul_left]
  ring
/-- **Simon Ch. 3, 1.4 for one bi-Lipschitz Lipschitz piece** (the blow-up argument of the proof
of 1.6 '⇒'): let `F : ℝⁿ → ℝᴾ` be `L`-Lipschitz, `B ⊆ ℝⁿ` Borel and `m > 0` with
`m|a − a'| ≤ |F a − F a'|` on `B`, and let `F` be differentiable at every point of `B` with
injective derivative.  Then for a.e. `b ∈ B`, `range DF(b)` is the approximate tangent space of
`F(B)` at `F b`.
`F` is injective on `B`, so the area formula holds on `B` with a Borel Jacobian `0 ≤ J ≤ Lⁿ`
satisfying `Hⁿ(DF(a)(S)) = J(a) λ(S)`.  At every Lebesgue point `b ∈ B` of `1_B J`,
`∫_{η_{F b,r}(F(B))} f dHⁿ = ∫ 1_B J(b + rc) f(r⁻¹(F(b + rc) − F b)) dc` tends to
`J(b) ∫ f(DF(b)c) dc = ∫_{range DF(b)} f dHⁿ` as `r ↓ 0`. -/
theorem Submission.codim1_lur_piece_image_approxTangent_ae : ∀ (P n : ℕ) (F : Euclid n → Euclid P) (B : Set (Euclid n)) (L : NNReal) (m : ℝ), LipschitzWith L F → MeasurableSet B → 0 < m → (∀ a ∈ B, ∀ a' ∈ B, m * ‖a - a'‖ ≤ ‖F a - F a'‖) → (∀ a ∈ B, DifferentiableAt ℝ F a ∧ Injective (fderiv ℝ F a)) → ∀ᵐ b ∂(volume.restrict B), HasApproximateTangentSpaceAt n (F '' B) (F b) (LinearMap.range (fderiv ℝ F b : Euclid n →ₗ[ℝ] Euclid P)) := by
  intro P n F B L m hF hB hm hcolip hreg
  -- 0(a): `F` is injective on `B` (`F a = F a'` forces `m|a − a'| ≤ 0`)
  have hinjOn : InjOn F B := by
    intro a ha a' ha' hFa
    have h := hcolip a ha a' ha'
    rw [hFa, sub_self, norm_zero] at h
    have h' : ‖a - a'‖ ≤ 0 := by
      by_contra hcon
      have := mul_pos hm (not_le.1 hcon)
      linarith
    exact sub_eq_zero.1 (norm_le_zero_iff.1 h')
  -- 0(b)–(c): Borel Jacobian `0 ≤ J ≤ Lⁿ`, area formula on `B`, `Hⁿ(DF(a)(S)) = J(a) λ(S)`
  obtain ⟨J, hJmeas, hJ, harea, hJlin⟩ :=
    Submission.codim1_lurpt_piece_area_jacobian P n F B L hF hB hinjOn
  -- 1: `1_B J` is Borel and bounded by `Lⁿ`, hence locally integrable
  have hloc : LocallyIntegrable (B.indicator J) volume := by
    refine (locallyIntegrable_const ((L : ℝ) ^ n)).mono (hJmeas.indicator hB).aestronglyMeasurable
      (Eventually.of_forall fun a => ?_)
    have hLn : (0 : ℝ) ≤ (L : ℝ) ^ n := by positivity
    calc ‖B.indicator J a‖ ≤ ‖J a‖ := norm_indicator_le_norm_self J a
      _ = J a := Real.norm_of_nonneg (hJ a).1
      _ ≤ (L : ℝ) ^ n := (hJ a).2
      _ = ‖(L : ℝ) ^ n‖ := (Real.norm_of_nonneg hLn).symm
  -- a.e. `b ∈ B` is a Lebesgue point of `1_B J`, in the rescaled form
  filter_upwards [ae_restrict_mem hB,
    ae_restrict_of_ae (Submission.doraggt_ae_rescaled_lebesgue_point n _ hloc)] with b hbB hleb
  obtain ⟨hdb, hinj⟩ := hreg b hbB
  have hJb : B.indicator J b = J b := Set.indicator_of_mem hbB J
  refine ⟨?_, fun f => ?_⟩
  · -- `dim range DF(b) = n`, `DF(b)` being injective
    rw [LinearMap.finrank_range_of_inj (f := (fderiv ℝ F b : Euclid n →ₗ[ℝ] Euclid P)) hinj,
      finrank_euclideanSpace_fin]
  · -- 6: `∫_{range DF(b)} f dHⁿ = J(b) ∫ f(DF(b)c) dc`
    rw [Submission.pit_setIntegral_range_linear P n (fderiv ℝ F b) (J b) f (hJ b).1 (hJlin b)
      (map_continuous f)]
    -- 2–5: the rescaled integrals tend to `J(b) ∫ f(DF(b)c) dc`
    refine (Submission.codim1_lurpt_rescaled_integral_tendsto P n F B J ((L : ℝ) ^ n) m b f
      hF.continuous hB hJmeas hJ hm (fun a ha => hcolip a ha b hbB) hdb hinj
      (fun R hR => by simpa only [hJb] using hleb R hR) (map_continuous f)
      f.hasCompactSupport).congr' ?_
    -- 3: for `r > 0` they are the integrals over the blow-ups `η_{F b,r}(F(B))`
    filter_upwards [self_mem_nhdsWithin] with r (hr : 0 < r)
    exact (Submission.pit_blowUp_image_setIntegral_eq_rescaled P n F B J b r f hF.continuous hB
      hJmeas (fun a => (hJ a).1) harea hr (map_continuous f)).symm

/-- A `d`-dimensional `C²` submanifold `N ⊆ ℝ^{d+k}` is, near `x ∈ N`, a `C¹` graph over its
tangent directions (Simon Ch. 2, §4, (4.1)): if `ℝ^{d+k} = ι(ℝᵈ) ⊕ ι'(ℝᵏ)` orthogonally and
`TₓN ⊆ ι(ℝᵈ)`, then `N ∩ B_s(x) ⊆ {x + ιv + ι'u(v) : v ∈ O} ⊆ N` with `u(0) = 0`, `Du(0) = 0`.
With `A = ι*`, `A' = ι'*` (so `y = ιAy + ι'A'y`) and a chart `ψ : V → W` with `ψ(z₀) = x`, the
map `Φ = A(ψ - x)` has `DΦ(z₀) = A Dψ(z₀)` injective since `Dψ(z₀)(ℝᵈ) ⊆ TₓN ⊆ ι(ℝᵈ)`; a local
inverse `χ : O → V₀` of `Φ` gives `u = A'(ψ ∘ χ - x)`, and `s` comes from the continuity of `ψ⁻¹`
at `x`. -/
theorem Submission.codim1_zsl_gc_local_graph : ∀ (d k : ℕ) (N : Set (Euclid (d + k))) (x : Euclid (d + k)) (ι : Euclid d →ₗᵢ[ℝ] Euclid (d + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (d + k)), IsEmbeddedSubmanifold 2 d N → x ∈ N → (∀ v w, inner ℝ (ι v) (ι' w) = 0) → (∀ y : Euclid (d + k), ∃ v w, y = ι v + ι' w) → tangentSpace N x ⊆ Set.range ι → ∃ (O : Set (Euclid d)) (u : Euclid d → Euclid k) (s : ℝ), IsOpen O ∧ (0 : Euclid d) ∈ O ∧ 0 < s ∧ ContDiffOn ℝ 1 u O ∧ u 0 = 0 ∧ fderiv ℝ u 0 = 0 ∧ (∀ v ∈ O, x + ι v + ι' (u v) ∈ N) ∧ ∀ y ∈ N, dist y x < s → ∃ v ∈ O, y = x + ι v + ι' (u v) := by
  intro d k N x ι ι' hN hx horth hdecomp htan
  -- Step 0: left inverses of `ι`, `ι'` (the adjoints)
  obtain ⟨A, hAι, hAι'⟩ : ∃ A : Euclid (d + k) →L[ℝ] Euclid d,
      (∀ v, A (ι v) = v) ∧ (∀ w, A (ι' w) = 0) := by
    refine ⟨ContinuousLinearMap.adjoint ι.toContinuousLinearMap, fun v => ?_, fun w => ?_⟩
    · refine ext_inner_right ℝ fun v' => ?_
      rw [ContinuousLinearMap.adjoint_inner_left, LinearIsometry.coe_toContinuousLinearMap,
        LinearIsometry.inner_map_map]
    · refine ext_inner_right ℝ fun v' => ?_
      rw [ContinuousLinearMap.adjoint_inner_left, LinearIsometry.coe_toContinuousLinearMap,
        inner_zero_left, real_inner_comm]
      exact horth v' w
  obtain ⟨A', hA'ι, hA'ι'⟩ : ∃ A' : Euclid (d + k) →L[ℝ] Euclid k,
      (∀ v, A' (ι v) = 0) ∧ (∀ w, A' (ι' w) = w) := by
    refine ⟨ContinuousLinearMap.adjoint ι'.toContinuousLinearMap, fun v => ?_, fun w => ?_⟩
    · refine ext_inner_right ℝ fun w' => ?_
      rw [ContinuousLinearMap.adjoint_inner_left, LinearIsometry.coe_toContinuousLinearMap,
        inner_zero_left]
      exact horth v w'
    · refine ext_inner_right ℝ fun w' => ?_
      rw [ContinuousLinearMap.adjoint_inner_left, LinearIsometry.coe_toContinuousLinearMap,
        LinearIsometry.inner_map_map]
  have hdec : ∀ y, y = ι (A y) + ι' (A' y) := by
    intro y
    obtain ⟨v, w, rfl⟩ := hdecomp y
    simp only [map_add, hAι, hAι', hA'ι, hA'ι', add_zero, zero_add]
  -- Step 1: a chart at `x`
  obtain ⟨V, W, ψ, hVo, hWo, hxW, hψ, hinj, himg, hprop, hfinj⟩ := hN x hx
  obtain ⟨z₀, hz₀V, hψz₀⟩ : x ∈ ψ '' V := by rw [himg]; exact ⟨hxW, hx⟩
  have hψN : ψ '' V ⊆ N := by rw [himg]; exact inter_subset_right
  -- Step 2: the range of `Dψ(z₀)` lies in `range ι`
  have hrange : Set.range (fderiv ℝ ψ z₀) ⊆ Set.range ι := by
    have h := Submission.dsmc_chart_range_subset_tangentSpace (d + k) 2 d N V ψ (by norm_num)
      hVo hψ hψN z₀ hz₀V
    rw [hψz₀] at h
    exact h.trans htan
  -- Step 3: `Φ z = A (ψ z - x)` has injective derivative at `z₀`
  have hψ1 : ContDiffOn ℝ 1 ψ V := hψ.of_le (by norm_num)
  have hψdiff : ∀ z ∈ V, DifferentiableAt ℝ ψ z := fun z hz =>
    (hψ1.differentiableOn_one z hz).differentiableAt (hVo.mem_nhds hz)
  have hΦC : ContDiffOn ℝ 1 (fun z => A (ψ z - x)) V :=
    A.contDiff.comp_contDiffOn (hψ1.sub contDiffOn_const)
  have hΦd : HasFDerivAt (fun z => A (ψ z - x)) (A.comp (fderiv ℝ ψ z₀)) z₀ :=
    A.hasFDerivAt.comp z₀ ((hψdiff z₀ hz₀V).hasFDerivAt.sub_const x)
  have hΦinj : Injective (fderiv ℝ (fun z => A (ψ z - x)) z₀) := by
    rw [hΦd.fderiv, injective_iff_map_eq_zero]
    intro h hh
    obtain ⟨v, hv⟩ := hrange (Set.mem_range_self h)
    rw [ContinuousLinearMap.comp_apply, ← hv, hAι] at hh
    apply hfinj z₀ hz₀V
    rw [← hv, hh, map_zero, map_zero]
  -- Step 4: local inverse `χ` of `Φ`
  obtain ⟨V₀, O, χ, hV₀o, hOo, hz₀V₀, hV₀V, hχC, hχmaps, hΦχ, hχΦ⟩ :=
    Submission.codim1_zsl_gc_local_inverse d (fun z => A (ψ z - x)) V z₀ hVo hz₀V hΦC hΦinj
  have hΦχ' : ∀ a ∈ O, A (ψ (χ a) - x) = a := hΦχ
  have hχΦ' : ∀ z ∈ V₀, A (ψ z - x) ∈ O ∧ χ (A (ψ z - x)) = z := hχΦ
  have hΦz₀ : A (ψ z₀ - x) = 0 := by rw [hψz₀, sub_self, map_zero]
  have h0O : (0 : Euclid d) ∈ O := hΦz₀ ▸ (hχΦ' z₀ hz₀V₀).1
  have hχ0 : χ 0 = z₀ := hΦz₀ ▸ (hχΦ' z₀ hz₀V₀).2
  -- Step 5: the graph identity
  have hkey : ∀ v ∈ O, ψ (χ v) = x + ι v + ι' (A' (ψ (χ v) - x)) := by
    intro v hv
    have h1 := hdec (ψ (χ v) - x)
    rw [hΦχ' v hv] at h1
    rw [add_assoc, ← h1, add_sub_cancel]
  -- Step 6: the radius `s`
  obtain ⟨ε, hε, hεball⟩ := Metric.isOpen_iff.mp hV₀o z₀ hz₀V₀
  obtain ⟨r, hr, hrball⟩ := Metric.isOpen_iff.mp hWo x hxW
  obtain ⟨δ, hδ, hδprop⟩ := Submission.dsmc_chart_inverse_continuity (d + k) d V W ψ
    hψ1.continuousOn hinj (by rw [himg]; exact inter_subset_left) hprop z₀ hz₀V ε hε
  refine ⟨O, fun v => A' (ψ (χ v) - x), min δ r, hOo, h0O, lt_min hδ hr, ?_, ?_, ?_, ?_, ?_⟩
  · exact A'.contDiff.comp_contDiffOn
      ((hψ1.comp hχC (hχmaps.mono_right hV₀V)).sub contDiffOn_const)
  · show A' (ψ (χ 0) - x) = 0
    rw [hχ0, hψz₀, sub_self, map_zero]
  · have hχd : HasFDerivAt χ (fderiv ℝ χ 0) 0 :=
      ((hχC.differentiableOn_one 0 h0O).differentiableAt (hOo.mem_nhds h0O)).hasFDerivAt
    have hψd : HasFDerivAt ψ (fderiv ℝ ψ (χ 0)) (χ 0) :=
      (hψdiff (χ 0) (hχ0 ▸ hz₀V)).hasFDerivAt
    have hud : HasFDerivAt (fun v => A' (ψ (χ v) - x))
        (A'.comp ((fderiv ℝ ψ (χ 0)).comp (fderiv ℝ χ 0))) 0 :=
      A'.hasFDerivAt.comp 0 ((hψd.comp 0 hχd).sub_const x)
    rw [hud.fderiv]
    ext1 h
    obtain ⟨v, hv⟩ := hrange (Set.mem_range_self (fderiv ℝ χ 0 h))
    rw [ContinuousLinearMap.comp_apply, ContinuousLinearMap.comp_apply, hχ0, ← hv, hA'ι,
      zero_apply]
  · intro v hv
    show x + ι v + ι' (A' (ψ (χ v) - x)) ∈ N
    rw [← hkey v hv]
    exact hψN (mem_image_of_mem ψ (hV₀V (hχmaps hv)))
  · intro y hy hys
    have hyW : y ∈ W := hrball (mem_ball.mpr (lt_of_lt_of_le hys (min_le_right _ _)))
    obtain ⟨z, hzV, rfl⟩ : y ∈ ψ '' V := by rw [himg]; exact ⟨hyW, hy⟩
    have hzV₀ : z ∈ V₀ := hεball (mem_ball.mpr (hδprop z hzV
      (by rw [hψz₀]; exact lt_of_lt_of_le hys (min_le_left _ _))))
    refine ⟨A (ψ z - x), (hχΦ' z hzV₀).1, ?_⟩
    exact (congrArg ψ (hχΦ' z hzV₀).2).symm.trans (hkey _ (hχΦ' z hzV₀).1)
/-- Steps 9–10 of the oriented graph chart of an embedded `(n+1)`-submanifold used for the
zero-scale limits of Simon 7.5.3–7.5.5 (codimension-one regularity, 7.5.8).  Let `ι`, `ι'` be
linear isometries with orthogonal ranges and `Γ(v) = x + ιv + ι'u(v)`, `u` continuous at `0` with
`u(0) = 0`.  If `Γ(O) ⊆ N` for an open `O ∋ 0` and every point of `N ∩ B_s(x)` is some `Γ(v)`,
`v ∈ O`, then for `δ₂ = s/2` and a small `δ₁ > 0`: `B_{δ₁} ⊆ O`, `u(B_{δ₁}) ⊆ B_{δ₂}` and the part
of `N` in the cylinder `{x + ιv + ι'w : |v| < δ₁, |w| < δ₂}` is exactly `Γ(B_{δ₁})`.  The cylinder
lies in `B_s(x)`, and `ιa + ι'b = 0` forces `a = 0` (Pythagoras), so the `ι`-coordinate of a point
of `N` in the cylinder is that of a graph point. -/
theorem Submission.codim1_zsl_gc_graph_cylinder : ∀ (d k : ℕ) (N : Set (Euclid (d + k))) (x : Euclid (d + k)) (ι : Euclid d →ₗᵢ[ℝ] Euclid (d + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (d + k)) (O : Set (Euclid d)) (u : Euclid d → Euclid k) (s : ℝ), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → IsOpen O → (0 : Euclid d) ∈ O → ContinuousAt u 0 → u 0 = 0 → 0 < s → (∀ v ∈ O, x + ι v + ι' (u v) ∈ N) → (∀ y ∈ N, dist y x < s → ∃ v ∈ O, y = x + ι v + ι' (u v)) → ∃ δ₁ δ₂ : ℝ, 0 < δ₁ ∧ 0 < δ₂ ∧ ball (0 : Euclid d) δ₁ ⊆ O ∧ (∀ v ∈ ball (0 : Euclid d) δ₁, u v ∈ ball (0 : Euclid k) δ₂) ∧ N ∩ {y | ∃ v ∈ ball (0 : Euclid d) δ₁, ∃ w ∈ ball (0 : Euclid k) δ₂, y = x + ι v + ι' w} = (fun v => x + ι v + ι' (u v)) '' ball (0 : Euclid d) δ₁ := by
  intro d k N x ι ι' O u s horth hO h0O hu hu0 hs hN hfib
  -- `ι a + ι' b = 0` forces `a = 0` (Pythagoras)
  have hinj : ∀ a b, ι a + ι' b = 0 → a = 0 := by
    intro a b h
    have h1 := norm_add_sq_real (ι a) (ι' b)
    rw [h, horth, ι.norm_map, ι'.norm_map, norm_zero] at h1
    have h2 : ‖a‖ = 0 := by nlinarith [norm_nonneg a, sq_nonneg ‖b‖]
    exact norm_eq_zero.mp h2
  -- radii: `δ₂ = s / 2`, `δ₁ = min (min η ρ) (s / 2)`
  obtain ⟨η, hη, hηu⟩ := Metric.continuousAt_iff.mp hu (s / 2) (half_pos hs)
  obtain ⟨ρ, hρ, hρO⟩ := Metric.isOpen_iff.mp hO 0 h0O
  have hδ₁ : 0 < min (min η ρ) (s / 2) := lt_min (lt_min hη hρ) (half_pos hs)
  have hballO : ball (0 : Euclid d) (min (min η ρ) (s / 2)) ⊆ O :=
    (ball_subset_ball ((min_le_left _ _).trans (min_le_right _ _))).trans hρO
  have hball2 : ∀ v ∈ ball (0 : Euclid d) (min (min η ρ) (s / 2)),
      u v ∈ ball (0 : Euclid k) (s / 2) := by
    intro v hv
    have hv' : dist v 0 < η :=
      lt_of_lt_of_le (mem_ball.mp hv) ((min_le_left _ _).trans (min_le_left _ _))
    have h := hηu hv'
    rw [hu0] at h
    exact mem_ball.mpr h
  refine ⟨min (min η ρ) (s / 2), s / 2, hδ₁, half_pos hs, hballO, hball2, ?_⟩
  ext y
  constructor
  · -- `N ∩ Z ⊆ Γ(B_{δ₁})`: a point of the cylinder lies in `B_s(x)`
    rintro ⟨hyN, v', hv', w', hw', rfl⟩
    have hv's : ‖v'‖ < s / 2 :=
      lt_of_lt_of_le (mem_ball_zero_iff.mp hv') (min_le_right _ _)
    have hw's : ‖w'‖ < s / 2 := mem_ball_zero_iff.mp hw'
    have hdist : dist (x + ι v' + ι' w') x < s := by
      rw [dist_eq_norm, add_assoc, add_sub_cancel_left]
      calc ‖ι v' + ι' w'‖ ≤ ‖ι v'‖ + ‖ι' w'‖ := norm_add_le _ _
        _ = ‖v'‖ + ‖w'‖ := by rw [ι.norm_map, ι'.norm_map]
        _ < s / 2 + s / 2 := add_lt_add hv's hw's
        _ = s := add_halves s
    obtain ⟨v, -, hv⟩ := hfib _ hyN hdist
    have hv2 : ι v' + ι' w' = ι v + ι' (u v) := by
      rw [add_assoc, add_assoc] at hv
      exact add_left_cancel hv
    have h3 : ι (v' - v) + ι' (w' - u v) = 0 := by
      rw [map_sub, map_sub, sub_add_sub_comm, hv2, sub_self]
    have hvv : v' = v := sub_eq_zero.mp (hinj _ _ h3)
    exact ⟨v, hvv ▸ hv', hv.symm⟩
  · -- `Γ(B_{δ₁}) ⊆ N ∩ Z`
    rintro ⟨v, hv, rfl⟩
    exact ⟨hN v (hballO hv), v, hv, u v, hball2 v hv, rfl⟩

/-- **The orientation of `N` along a `C¹` graph through `x` is the normalized Jacobian
orientation** (steps 11–15 of the oriented graph chart of `N` at `x` used for Simon 7.5.3–7.5.5;
tangent spaces as in Ch. 2, §4, orientations as in Ch. 6, 2.2).  Let `Γ(v) = x + ιv + ι'u(v)` on
`B = B_δ(0)`, with `u` of class `C¹`, `u(0) = 0`, `Du(0) = 0`, `Γ(B) ⊆ N` and
`ξ_N(x) = ιe₀ ∧ ⋯ ∧ ιeₙ`.  The Jacobian orientation `ξ` of the graph (with `ξ(β) = 1` on `Γ(B)`)
satisfies `α(DΓ(v)e) = J(v) ξ(Γ v)(α)`, `J = √det(DΓ* ∘ DΓ)`, and orients `range DΓ(v)`, which
lies in `T_{Γ(v)}N` and has the same dimension `n + 1`; so `ξ_N(Γ v) = ±ξ(Γ v)`.  The sign
`s(v) = ξ_N(Γ v)(β(Γ v)) = ±1` is continuous on the connected ball, and `s(0) = 1` since
`DΓ(0) = ι` and `J(0) = 1`; hence `ξ_N ∘ Γ = ξ ∘ Γ` on `B`. -/
theorem Submission.codim1_zsl_gc_orientation_along_graph : ∀ (n k : ℕ) (N : Set (Euclid (n + 1 + k))) (ξN : Euclid (n + 1 + k) → MultiVector (n + 1 + k) (n + 1)) (x : Euclid (n + 1 + k)) (ι : Euclid (n + 1) →ₗᵢ[ℝ] Euclid (n + 1 + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + 1 + k)) (u : Euclid (n + 1) → Euclid k) (δ : ℝ), IsOrientation (n + 1) N ξN → (∀ v w, inner ℝ (ι v) (ι' w) = 0) → 0 < δ → ContDiffOn ℝ 1 u (ball 0 δ) → u 0 = 0 → fderiv ℝ u 0 = 0 → (∀ v ∈ ball (0 : Euclid (n + 1)) δ, x + ι v + ι' (u v) ∈ N) → (∀ α : Covector (Euclid (n + 1 + k)) (n + 1), ξN x α = α (fun j => ι (EuclideanSpace.single j (1 : ℝ)))) → ∀ v ∈ ball (0 : Euclid (n + 1)) δ, ∀ α : Covector (Euclid (n + 1 + k)) (n + 1), α (fun j => fderiv ℝ (fun v => x + ι v + ι' (u v)) v (EuclideanSpace.single j (1 : ℝ))) = Real.sqrt (((fderiv ℝ (fun v => x + ι v + ι' (u v)) v).adjoint ∘L fderiv ℝ (fun v => x + ι v + ι' (u v)) v).det) * ξN (x + ι v + ι' (u v)) α := by
  intro n k N ξN x ι ι' u δ hor horth hδ hu hu0 hDu0 hΓN hξx
  -- the Jacobian orientation `ξ` of the graph `Γ(B)` and its dual covector field `β`
  obtain ⟨ξ, β, hξc, hβc, hξβ, hξor, hJ⟩ :=
    Submission.dgcr_graph_orientation_jacobian (n + 1) k ι ι' u x δ (Nat.succ_pos n) horth hδ hu
  have h0 : (0 : Euclid (n + 1)) ∈ ball (0 : Euclid (n + 1)) δ := mem_ball_self hδ
  -- `Γ` is `C¹` on the ball and maps it into `N`
  have hΓC1 : ContDiffOn ℝ 1 (fun v => x + ι v + ι' (u v)) (ball (0 : Euclid (n + 1)) δ) := by
    have h1 : ContDiffOn ℝ 1 (fun v : Euclid (n + 1) => x + ι v) (ball (0 : Euclid (n + 1)) δ) :=
      contDiffOn_const.add ι.contDiff.contDiffOn
    exact h1.add (ι'.contDiff.comp_contDiffOn hu)
  have hΓcont : ContinuousOn (fun v => x + ι v + ι' (u v)) (ball (0 : Euclid (n + 1)) δ) :=
    hΓC1.continuousOn
  have hΓmaps : MapsTo (fun v => x + ι v + ι' (u v)) (ball (0 : Euclid (n + 1)) δ) N :=
    fun v hv => hΓN v hv
  have hΓimg : (fun v => x + ι v + ι' (u v)) '' (ball (0 : Euclid (n + 1)) δ) ⊆ N :=
    hΓmaps.image_subset
  -- `range DΓ(v) ⊆ T_{Γ(v)}N`
  have hrange := Submission.dsmc_chart_range_subset_tangentSpace (n + 1 + k) 1 (n + 1) N
    (ball (0 : Euclid (n + 1)) δ) (fun v => x + ι v + ι' (u v)) le_rfl isOpen_ball
    (by exact_mod_cast hΓC1) hΓimg
  -- a subspace with a unit `(n + 1)`-orientation has dimension `n + 1`
  have hfin : ∀ (ζ : MultiVector (n + 1 + k) (n + 1)) (Q : Submodule ℝ (Euclid (n + 1 + k))),
      IsUnitOrientationOf ζ Q → Module.finrank ℝ Q = n + 1 := by
    rintro ζ Q ⟨τ, hτ, hspan, -⟩
    rw [← hspan, finrank_span_eq_card hτ.linearIndependent, Fintype.card_fin]
  -- pointwise, `range DΓ(v) = T_{Γ(v)}N` and so `ξ_N(Γ v) = ±ξ(Γ v)`
  have hsign : ∀ v ∈ ball (0 : Euclid (n + 1)) δ,
      ξN (x + ι v + ι' (u v)) = ξ (x + ι v + ι' (u v)) ∨
        ξN (x + ι v + ι' (u v)) = -ξ (x + ι v + ι' (u v)) := by
    intro v hv
    obtain ⟨Q, hQ, hξNQ⟩ := hor.2 _ (hΓN v hv)
    have hle : LinearMap.range (fderiv ℝ (fun v => x + ι v + ι' (u v)) v :
        Euclid (n + 1) →ₗ[ℝ] Euclid (n + 1 + k)) ≤ Q := by
      rintro y ⟨w, rfl⟩
      have hmem : (fderiv ℝ (fun v => x + ι v + ι' (u v)) v) w ∈
          tangentSpace N (x + ι v + ι' (u v)) := hrange v hv ⟨w, rfl⟩
      rw [← hQ] at hmem
      exact hmem
    have heq := Submodule.eq_of_le_of_finrank_eq hle
      (by rw [hfin _ _ (hξor v hv), hfin _ _ hξNQ])
    have hξQ : IsUnitOrientationOf (ξ (x + ι v + ι' (u v))) Q := heq ▸ hξor v hv
    exact Submission.rsdic_unitOrientation_eq_or_eq_neg _ _ _ _ Q hξQ hξNQ
  -- the sign `s(v) = ξ_N(Γ v)(β(Γ v))` is continuous on the ball and takes the values `±1`
  have hs_cont : ContinuousOn (fun v => ξN (x + ι v + ι' (u v)) (β (x + ι v + ι' (u v))))
      (ball (0 : Euclid (n + 1)) δ) := by
    have h1 : ContinuousOn (fun v => ξN (x + ι v + ι' (u v))) (ball (0 : Euclid (n + 1)) δ) :=
      hor.1.comp hΓcont hΓmaps
    have h2 : ContinuousOn (fun v => β (x + ι v + ι' (u v))) (ball (0 : Euclid (n + 1)) δ) :=
      hβc.comp hΓcont (mapsTo_image _ _)
    exact h1.clm_apply h2
  have hs_val : ∀ v ∈ ball (0 : Euclid (n + 1)) δ,
      ξN (x + ι v + ι' (u v)) (β (x + ι v + ι' (u v))) = 1 ∨
        ξN (x + ι v + ι' (u v)) (β (x + ι v + ι' (u v))) = -1 := by
    intro v hv
    have h1 : ξ (x + ι v + ι' (u v)) (β (x + ι v + ι' (u v))) = 1 := hξβ _ ⟨v, hv, rfl⟩
    rcases hsign v hv with h | h
    · left; rw [h, h1]
    · right; rw [h, neg_apply, h1]
  -- at `0`: `Γ(0) = x`, `DΓ(0) = ι`, `J(0) = 1`, so `ξ_N(x) = ξ(x)` and `s(0) = 1`
  have hΓ0 : x + ι 0 + ι' (u 0) = x := by simp [hu0]
  have hu_diff : DifferentiableAt ℝ u 0 :=
    (hu.differentiableOn one_ne_zero).differentiableAt (isOpen_ball.mem_nhds h0)
  have hD0 : fderiv ℝ (fun v => x + ι v + ι' (u v)) 0 = ι.toContinuousLinearMap := by
    have h1 : HasFDerivAt (fun v : Euclid (n + 1) => x + ι v) ι.toContinuousLinearMap 0 :=
      ι.toContinuousLinearMap.hasFDerivAt.const_add x
    have h2 : HasFDerivAt (fun v => ι' (u v)) (ι'.toContinuousLinearMap.comp (fderiv ℝ u 0)) 0 :=
      ι'.toContinuousLinearMap.hasFDerivAt.comp 0 hu_diff.hasFDerivAt
    rw [hDu0, ContinuousLinearMap.comp_zero] at h2
    have h3 := h1.add h2
    rw [add_zero] at h3
    exact h3.fderiv
  have hdet0 : Real.sqrt (((fderiv ℝ (fun v => x + ι v + ι' (u v)) 0).adjoint ∘L
      fderiv ℝ (fun v => x + ι v + ι' (u v)) 0).det) = 1 := by
    rw [hD0, LinearIsometry.adjoint_comp_self]
    show Real.sqrt (LinearMap.det ((1 : Euclid (n + 1) →L[ℝ] Euclid (n + 1)) :
      Euclid (n + 1) →ₗ[ℝ] Euclid (n + 1))) = 1
    rw [ContinuousLinearMap.toLinearMap_one, map_one, Real.sqrt_one]
  have hξ0 : ξN x = ξ x := by
    ext α
    have h1 := hJ 0 h0 α
    rw [hdet0, one_mul, hΓ0, hD0] at h1
    rw [hξx α, ← h1]
    rfl
  have hs0 : ξN (x + ι 0 + ι' (u 0)) (β (x + ι 0 + ι' (u 0))) = 1 := by
    have h1 := hξβ (x + ι 0 + ι' (u 0)) ⟨0, h0, rfl⟩
    rw [hΓ0] at h1 ⊢
    rw [hξ0]
    exact h1
  -- `s ≡ 1` on the preconnected ball, by the intermediate value theorem
  have hconst : ∀ v ∈ ball (0 : Euclid (n + 1)) δ,
      ξN (x + ι v + ι' (u v)) (β (x + ι v + ι' (u v))) = 1 := by
    intro v hv
    rcases hs_val v hv with h | h
    · exact h
    · exfalso
      have hIcc := (convex_ball (0 : Euclid (n + 1)) δ).isPreconnected.intermediate_value hv h0
        hs_cont
      have hmem : (0 : ℝ) ∈ Icc (ξN (x + ι v + ι' (u v)) (β (x + ι v + ι' (u v))))
          (ξN (x + ι 0 + ι' (u 0)) (β (x + ι 0 + ι' (u 0)))) := by
        rw [h, hs0]
        constructor <;> norm_num
      obtain ⟨w, hw, hw0⟩ := hIcc hmem
      have hw0' : ξN (x + ι w + ι' (u w)) (β (x + ι w + ι' (u w))) = 0 := hw0
      rcases hs_val w hw with h' | h' <;> rw [h'] at hw0' <;> norm_num at hw0'
  -- hence `ξ_N(Γ v) = ξ(Γ v)`, and the Jacobian identity of `ξ` is the claim
  intro v hv α
  have hpos : ξN (x + ι v + ι' (u v)) = ξ (x + ι v + ι' (u v)) := by
    rcases hsign v hv with h | h
    · exact h
    · exfalso
      have h1 := hconst v hv
      have h2 : ξ (x + ι v + ι' (u v)) (β (x + ι v + ι' (u v))) = 1 := hξβ _ ⟨v, hv, rfl⟩
      rw [h, neg_apply, h2] at h1
      norm_num at h1
  rw [hpos]
  exact hJ v hv α

/-- Step 4 of the zero-scale limit plane argument (Simon 7.5.3–7.5.5; embedded submanifolds and
tangent spaces: Ch. 2, §4 (4.1); orientations: Ch. 6, 2.2): near `x ∈ N`, an oriented embedded `C²`
`(n+1)`-submanifold `N ⊆ ℝ^{n+1+k}` is an oriented `C¹` graph over its tangent plane.
`IsOrientation` gives `T_xN = Q₀` with `ξ_N(x)` a unit orientation of `Q₀`; isometries `ι` onto
`Q₀`, adapted to `ξ_N(x)`, and `ι'` orthogonal to it give (a) and (d).  As `T_xN ⊆ range ι`, `N`
is near `x` the graph of `Γ(v) = x + ιv + ι'u(v)` with `u` of class `C¹`, `u(0) = 0`, `Du(0) = 0`;
inside a cylinder `{x + ιv + ι'w : |v| < δ₁, |w| < δ₂}` this gives (b) and (c).  Along `Γ`, `ξ_N`
is the Jacobian orientation `α ↦ α(DΓ(v)e₀, …, DΓ(v)eₙ)/√det(DΓ(v)*DΓ(v))`, which is (e). -/
theorem Submission.codim1_zsl_oriented_graph_chart : ∀ (n k : ℕ) (N : Set (Euclid (n + 1 + k))) (ξN : Euclid (n + 1 + k) → MultiVector (n + 1 + k) (n + 1)) (x : Euclid (n + 1 + k)), IsEmbeddedSubmanifold 2 (n + 1) N → IsOrientation (n + 1) N ξN → x ∈ N → ∃ (ι : Euclid (n + 1) →ₗᵢ[ℝ] Euclid (n + 1 + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (n + 1 + k)) (u : Euclid (n + 1) → Euclid k) (δ₁ δ₂ : ℝ), (∀ v w, inner ℝ (ι v) (ι' w) = 0) ∧ (∀ y : Euclid (n + 1 + k), ∃ v w, y = ι v + ι' w) ∧ 0 < δ₁ ∧ 0 < δ₂ ∧ ContDiffOn ℝ 1 u (ball 0 δ₁) ∧ u 0 = 0 ∧ fderiv ℝ u 0 = 0 ∧ (∀ v ∈ ball (0 : Euclid (n + 1)) δ₁, u v ∈ ball (0 : Euclid k) δ₂) ∧ N ∩ {y | ∃ v ∈ ball (0 : Euclid (n + 1)) δ₁, ∃ w ∈ ball (0 : Euclid k) δ₂, y = x + ι v + ι' w} = (fun v => x + ι v + ι' (u v)) '' ball (0 : Euclid (n + 1)) δ₁ ∧ (∀ α : Covector (Euclid (n + 1 + k)) (n + 1), ξN x α = α (fun j => ι (EuclideanSpace.single j (1 : ℝ)))) ∧ ∀ v ∈ ball (0 : Euclid (n + 1)) δ₁, ∀ α : Covector (Euclid (n + 1 + k)) (n + 1), α (fun j => fderiv ℝ (fun v => x + ι v + ι' (u v)) v (EuclideanSpace.single j (1 : ℝ))) = Real.sqrt (((fderiv ℝ (fun v => x + ι v + ι' (u v)) v).adjoint ∘L fderiv ℝ (fun v => x + ι v + ι' (u v)) v).det) * ξN (x + ι v + ι' (u v)) α := by
  intro n k N ξN x hN hξN hx
  -- `T_xN = Q₀`, and `ξ_N(x)` is a unit orientation of `Q₀`
  obtain ⟨Q₀, hQ₀, hξx⟩ := hξN.2 x hx
  -- (a), (d): `ι` maps onto `Q₀` and is adapted to `ξ_N(x)`; `ι'` is orthogonal to `ι`
  obtain ⟨ι, ι', hperp, hspan, hrange, hframe⟩ :=
    Submission.codim1_zsl_gc_oriented_frame n k Q₀ (ξN x) hξx
  -- near `x`, `N` is the graph of `Γ(v) = x + ιv + ι'u(v)` over an open `O ∋ 0`
  obtain ⟨O, u, s, hO, hO0, hs, hu, hu0, hDu0, hΓN, hcover⟩ :=
    Submission.codim1_zsl_gc_local_graph (n + 1) k N x ι ι' hN hx hperp hspan
      (hQ₀.symm.trans hrange.symm).subset
  -- (b), (c): inside the cylinder `{x + ιv + ι'w : |v| < δ₁, |w| < δ₂}`, `N` is `Γ(B_{δ₁})`
  obtain ⟨δ₁, δ₂, hδ₁, hδ₂, hO₁, hmaps, hcyl⟩ :=
    Submission.codim1_zsl_gc_graph_cylinder (n + 1) k N x ι ι' O u s hperp hO hO0
      (hu.continuousOn.continuousAt (hO.mem_nhds hO0)) hu0 hs hΓN hcover
  have hu₁ : ContDiffOn ℝ 1 u (ball 0 δ₁) := hu.mono hO₁
  -- (e): along `Γ`, `ξ_N` is the Jacobian orientation normalized by `√det(DΓ*DΓ)`
  exact ⟨ι, ι', u, δ₁, δ₂, hperp, hspan, hδ₁, hδ₂, hu₁, hu0, hDu0, hmaps, hcyl, hframe,
    Submission.codim1_zsl_gc_orientation_along_graph n k N ξN x ι ι' u δ₁ hξN hperp hδ₁ hu₁ hu0
      hDu0 (fun v hv => hΓN v (hO₁ hv)) hframe⟩
/-- **Area formula for a `C¹` graph over an `m`-plane** (Simon Ch. 2, 3.1–3.3).  Let
`G(w) = ιw + ι'g(w)` with `ι`, `ι'` isometries onto orthogonal subspaces and `g` of class `C¹` on
the open set `D ⊇ A`, and `J(w) = √det(DG(w)* ∘ DG(w))`.  Then
`∫_{G(A)} f dHᵐ = ∫_A J(w) f(G(w)) dw` for every `f`.  `G` is continuous on `A` and injective
(`ι(w - w') = ι'(g w' - g w)` is orthogonal to itself), `J` is Borel as a continuous function of
`fderiv ℝ G`, and `Hᵐ(G(B)) = ∫_B J` for every measurable `B ⊆ A` (`codim1_zsl_ga_set_identity`);
`codim1_zsl_ga_integral_transfer` turns this weighted set identity into the Bochner identity. -/
theorem Submission.codim1_zsl_graph_area_formula : ∀ (m k : ℕ) (ι : Euclid m →ₗᵢ[ℝ] Euclid (m + k)) (ι' : Euclid k →ₗᵢ[ℝ] Euclid (m + k)) (g : Euclid m → Euclid k) (D A : Set (Euclid m)) (f : Euclid (m + k) → ℝ), (∀ v w, inner ℝ (ι v) (ι' w) = 0) → IsOpen D → ContDiffOn ℝ 1 g D → MeasurableSet A → A ⊆ D → ∫ y in (fun w => ι w + ι' (g w)) '' A, f y ∂μHE[m] = ∫ w in A, Real.sqrt (((fderiv ℝ (fun w => ι w + ι' (g w)) w).adjoint ∘L fderiv ℝ (fun w => ι w + ι' (g w)) w).det) * f (ι w + ι' (g w)) := by
  intro m k ι ι' g D A f horth hD hg hA hAD
  -- `G` is continuous on `A ⊆ D`, where `g` is `C¹`
  have hGc : ContinuousOn (fun w => ι w + ι' (g w)) A :=
    ι.continuous.continuousOn.add (ι'.continuous.comp_continuousOn (hg.continuousOn.mono hAD))
  -- `G` is injective: `ι (w - w') = ι' (g w' - g w)` is orthogonal to itself
  have hGi : Injective fun w => ι w + ι' (g w) := by
    intro w w' h
    have h1 : ι (w - w') = ι' (g w' - g w) := by
      rw [map_sub, map_sub, sub_eq_sub_iff_add_eq_add, add_comm (ι' (g w'))]
      exact h
    have h2 := horth (w - w') (g w' - g w)
    rw [← h1, inner_self_eq_zero] at h2
    exact sub_eq_zero.1 (ι.injective (h2.trans (map_zero ι).symm))
  -- `J = √det(DG* ∘ DG)` is Borel: a continuous function of the Borel map `fderiv ℝ G`
  have hJm : Measurable fun w => Real.sqrt (((fderiv ℝ (fun w => ι w + ι' (g w)) w).adjoint ∘L
      fderiv ℝ (fun w => ι w + ι' (g w)) w).det) := by
    have hc : Continuous fun T : Euclid m →L[ℝ] Euclid (m + k) =>
        Real.sqrt ((T.adjoint ∘L T).det) :=
      Real.continuous_sqrt.comp (ContinuousLinearMap.continuous_det.comp
        ((ContinuousLinearMap.adjoint (𝕜 := ℝ) (E := Euclid m)
          (F := Euclid (m + k))).continuous.clm_comp continuous_id))
    exact hc.measurable.comp (measurable_fderiv ℝ fun w => ι w + ι' (g w))
  -- `Hᵐ(G(B)) = ∫_B J` for measurable `B ⊆ A ⊆ D`; transfer to Bochner integrals
  exact Submission.codim1_zsl_ga_integral_transfer m (m + k) μHE[m] (fun w => ι w + ι' (g w))
    (fun w => Real.sqrt (((fderiv ℝ (fun w => ι w + ι' (g w)) w).adjoint ∘L
      fderiv ℝ (fun w => ι w + ι' (g w)) w).det)) A f hA hGc hGi.injOn hJm
    (fun w _ => Real.sqrt_nonneg _) fun B hB hBA =>
      Submission.codim1_zsl_ga_set_identity m k ι ι' g D B horth hD hg hB (hBA.trans hAD)
/-- **Compactness for sets of locally bounded perimeter** (Simon Ch. 2, 2.6, for the indicators
`uᵢ = 1_{Fᵢ}`).  If for each `R > 0` the perimeters of the `Fᵢ` in `B_R(0)` are eventually at most
`c(R)` (`∫_{Fᵢ} div φ ≤ c(R)` for smooth `φ` with `spt φ ⊆ B_R(0)` and `|φ| ≤ 1`), then a
subsequence converges in `L¹_loc`: `L^m((F_{σ i} Δ F') ∩ B_R(0)) → 0` for every `R`.
For `R > 0` and `i ≥ i_{R+2}`, `codim1_zsl_pc_translation_estimate` (steps 1–4: mollify, integrate
by parts, use the fundamental theorem of calculus, let `ε → 0`) turns the bound `c(R + 2)` into
`L^m(((Fᵢ − h) Δ Fᵢ) ∩ B_R(0)) ≤ c(R + 2)|h|` for `|h| ≤ 1`.  From this uniform local translation
estimate, `codim1_zsl_pc_compact_of_translation` (steps 5–8: cube averages, a diagonal
subsequence, a fast Cauchy subsequence and its `liminf` set) gives `σ` and `F'`. -/
theorem Submission.codim1_zsl_perimeter_compactness : ∀ (m : ℕ) (F : ℕ → Set (Euclid m)), (∀ i, MeasurableSet (F i)) → (∀ R : ℝ, 0 < R → ∃ c : ℝ, ∀ᶠ i in atTop, ∀ φ : Euclid m → Euclid m, ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ → tsupport φ ⊆ ball 0 R → (∀ v, ‖φ v‖ ≤ 1) → ∫ v in F i, LinearMap.trace ℝ (Euclid m) (fderiv ℝ φ v).toLinearMap ≤ c) → ∃ (σ : ℕ → ℕ) (F' : Set (Euclid m)), StrictMono σ ∧ MeasurableSet F' ∧ ∀ R : ℝ, Tendsto (fun i => volume (symmDiff (F (σ i)) F' ∩ ball 0 R)) atTop (𝓝 0) := by
  intro m F hF hP
  -- Steps 5–8: a uniform local translation estimate gives `σ` and `F'`.
  refine Submission.codim1_zsl_pc_compact_of_translation m F hF fun R hR => ?_
  -- Steps 1–4: for `i ≥ i_{R+2}`, the perimeter bound `c(R + 2)` gives the estimate with `C = c`.
  obtain ⟨c, hc⟩ := hP (R + 2) (by linarith)
  exact ⟨c, hc.mono fun i hi =>
    Submission.codim1_zsl_pc_translation_estimate m (F i) R c (hF i) hi⟩

/-- **Graph integrals under `C¹`-flattening graphs and `L¹_loc`-convergent domains** (Simon 7.5.3,
7.5.5).  For `G_i(w) = ιw + ι'gᵢ(w)` on `B = B_R(0)` with `gᵢ → b`, `Dgᵢ → 0` uniformly on `B` and
`Lᵐ((Aᵢ Δ A) ∩ B) → 0`, `∫_{Aᵢ∩B} β(Gᵢ)(DGᵢ e₀, …, DGᵢ e_{m−1}) → ∫_{A∩B} β(ιw + ι'b)(ιe₀, …)`.
`β` is bounded by `M` and uniformly continuous, and `DGᵢ(w) = ι + ι' ∘ Dgᵢ(w)`, so the multilinear
bounds `le_opNorm` and `norm_image_sub_le` give `|hᵢ − h| ≤ 2ᵐ|β(Gᵢ) − β(ιw + ι'b)| + Mm2ᵐ‖Dgᵢ‖`
for the integrands, which therefore converge uniformly on `B`; the integrals then differ by at most
`Lᵐ(B) sup_B |hᵢ − h| + 2M Lᵐ((Aᵢ Δ A) ∩ B) → 0`. -/
theorem Submission.codim1_zsl_fl_graph_integral_tendsto : ∀ (m k P : ℕ) (ι : Euclid m →ₗᵢ[ℝ] Euclid P) (ι' : Euclid k →ₗᵢ[ℝ] Euclid P) (b : Euclid k) (R : ℝ) (β : Euclid P → Covector (Euclid P) m) (gs : ℕ → Euclid m → Euclid k) (As : ℕ → Set (Euclid m)) (A : Set (Euclid m)), Continuous β → HasCompactSupport β → (∀ i, MeasurableSet (As i)) → MeasurableSet A → Tendsto (fun i => volume (symmDiff (As i) A ∩ ball (0 : Euclid m) R)) atTop (𝓝 0) → (∀ᶠ i in atTop, ∀ w ∈ ball (0 : Euclid m) R, DifferentiableAt ℝ (gs i) w) → (∀ ε : ℝ, 0 < ε → ∀ᶠ i in atTop, ∀ w ∈ ball (0 : Euclid m) R, ‖gs i w - b‖ < ε ∧ ‖fderiv ℝ (gs i) w‖ < ε) → Tendsto (fun i => ∫ w in As i ∩ ball 0 R, β (ι w + ι' (gs i w)) (fun j => fderiv ℝ (fun w => ι w + ι' (gs i w)) w (EuclideanSpace.single j (1 : ℝ)))) atTop (𝓝 (∫ w in A ∩ ball 0 R, β (ι w + ι' b) (fun j => ι (EuclideanSpace.single j (1 : ℝ))))) := by
  intro m k P ι ι' b R β gs As A hβc hβs hAs hA hsymm hH1 hH2
  classical
  set B : Set (Euclid m) := ball (0 : Euclid m) R with hB
  have hBmeas : MeasurableSet B := measurableSet_ball
  have hBfin : volume B < ⊤ := measure_ball_lt_top
  obtain ⟨M, hM⟩ := hβc.bounded_above_of_compact_support hβs
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  have hβu : UniformContinuous β := hβs.uniformContinuous_of_continuous hβc
  set e : Fin m → Euclid m := fun j => EuclideanSpace.single j (1 : ℝ) with he
  have hej : ∀ j, ‖e j‖ = 1 := by intro j; simp [he]
  set Φ : Euclid P × (Euclid m →L[ℝ] Euclid P) → ℝ := fun p => β p.1 (fun j => p.2 (e j)) with hΦ
  have hΦc : Continuous Φ := by
    have h1 : Continuous fun p : Euclid P × (Euclid m →L[ℝ] Euclid P) => β p.1 :=
      hβc.comp continuous_fst
    have h2 : Continuous fun p : Euclid P × (Euclid m →L[ℝ] Euclid P) => (fun j => p.2 (e j)) :=
      continuous_pi fun j => (continuous_eval_const (e j)).comp continuous_snd
    exact continuous_eval.comp (h1.prodMk h2)
  set G : ℕ → Euclid m → Euclid P := fun i w => ι w + ι' (gs i w) with hG
  set H : ℕ → Euclid m → ℝ := fun i w => Φ (G i w, fderiv ℝ (G i) w) with hH
  set H' : Euclid m → ℝ := fun w => β (ι w + ι' b) (fun j => ι (e j)) with hH'
  change Tendsto (fun i => ∫ w in As i ∩ B, H i w) atTop (𝓝 (∫ w in A ∩ B, H' w))
  have hD : ∀ i w, DifferentiableAt ℝ (gs i) w →
      fderiv ℝ (G i) w = ι.toContinuousLinearMap + ι'.toContinuousLinearMap.comp (fderiv ℝ (gs i) w) := by
    intro i w hw
    have hι : HasFDerivAt (fun w => ι w) ι.toContinuousLinearMap w :=
      ι.toContinuousLinearMap.hasFDerivAt
    have hι' : HasFDerivAt (fun w => ι' (gs i w))
        (ι'.toContinuousLinearMap.comp (fderiv ℝ (gs i) w)) w :=
      ι'.toContinuousLinearMap.hasFDerivAt.comp w hw.hasFDerivAt
    exact (hι.add hι').fderiv
  have hH'b : ∀ w, ‖H' w‖ ≤ M := by
    intro w
    calc ‖H' w‖ ≤ ‖β (ι w + ι' b)‖ * ∏ j, ‖ι (e j)‖ := ContinuousAlternatingMap.le_opNorm _ _
      _ = ‖β (ι w + ι' b)‖ := by simp [hej]
      _ ≤ M := hM _
  have hH'c : Continuous H' := by
    have h1 : Continuous fun w : Euclid m => β (ι w + ι' b) :=
      hβc.comp (ι.continuous.add continuous_const)
    exact (continuous_eval_const (fun j => ι (e j))).comp h1
  -- pointwise estimate
  have hpt : ∀ i w, DifferentiableAt ℝ (gs i) w → ‖fderiv ℝ (gs i) w‖ ≤ 1 →
      ‖H i w - H' w‖ ≤ 2 ^ m * ‖β (G i w) - β (ι w + ι' b)‖ +
        M * m * 2 ^ m * ‖fderiv ℝ (gs i) w‖ := by
    intro i w hd hL1
    set L := fderiv ℝ (gs i) w with hL
    set u : Fin m → Euclid P := fun j => fderiv ℝ (G i) w (e j) with hueq
    set u' : Fin m → Euclid P := fun j => ι (e j) with hu'eq
    have hu : ∀ j, u j = ι (e j) + ι' (L (e j)) := by
      intro j
      simp [u, hD i w hd, L]
    have hunorm : ‖u‖ ≤ 2 := by
      rw [pi_norm_le_iff_of_nonneg (by norm_num)]
      intro j
      rw [hu j]
      calc ‖ι (e j) + ι' (L (e j))‖ ≤ ‖ι (e j)‖ + ‖ι' (L (e j))‖ := norm_add_le _ _
        _ = 1 + ‖L (e j)‖ := by rw [LinearIsometry.norm_map, LinearIsometry.norm_map, hej]
        _ ≤ 1 + ‖L‖ * ‖e j‖ := by gcongr; exact L.le_opNorm _
        _ ≤ 2 := by rw [hej]; linarith
    have hu'norm : ‖u'‖ ≤ 1 := by
      rw [pi_norm_le_iff_of_nonneg zero_le_one]
      intro j
      simp [u', hej]
    have hdiff : ‖u - u'‖ ≤ ‖L‖ := by
      rw [pi_norm_le_iff_of_nonneg (norm_nonneg _)]
      intro j
      rw [Pi.sub_apply, hu j]
      simp only [u', add_sub_cancel_left, LinearIsometry.norm_map]
      calc ‖L (e j)‖ ≤ ‖L‖ * ‖e j‖ := L.le_opNorm _
        _ = ‖L‖ := by rw [hej, mul_one]
    have h1 : ‖β (G i w) u - β (ι w + ι' b) u‖ ≤ 2 ^ m * ‖β (G i w) - β (ι w + ι' b)‖ := by
      rw [← ContinuousAlternatingMap.sub_apply]
      calc _ ≤ ‖β (G i w) - β (ι w + ι' b)‖ * ∏ j, ‖u j‖ :=
            ContinuousAlternatingMap.le_opNorm _ _
        _ ≤ ‖β (G i w) - β (ι w + ι' b)‖ * 2 ^ m := by
          gcongr
          calc ∏ j, ‖u j‖ ≤ ∏ _j : Fin m, (2 : ℝ) :=
                Finset.prod_le_prod₀ (fun j _ => norm_nonneg _)
                  (fun j _ => (norm_le_pi_norm u j).trans hunorm)
            _ = 2 ^ m := by simp
        _ = _ := mul_comm _ _
    have h2 : ‖β (ι w + ι' b) u - β (ι w + ι' b) u'‖ ≤ M * m * 2 ^ m * ‖L‖ := by
      calc _ ≤ ‖β (ι w + ι' b)‖ * (Fintype.card (Fin m)) *
              (max ‖u‖ ‖u'‖) ^ (Fintype.card (Fin m) - 1) * ‖u - u'‖ :=
            ContinuousAlternatingMap.norm_image_sub_le _ _ _
        _ ≤ M * m * 2 ^ m * ‖L‖ := by
            rw [Fintype.card_fin]
            have hmax : max ‖u‖ ‖u'‖ ≤ 2 := max_le hunorm (hu'norm.trans (by norm_num))
            have hpow : (max ‖u‖ ‖u'‖) ^ (m - 1) ≤ 2 ^ m :=
              (pow_le_pow_left₀ (le_max_of_le_left (norm_nonneg _)) hmax _).trans
                (pow_le_pow_right₀ (by norm_num) (Nat.sub_le _ _))
            gcongr
            exact hM _
    have hsplit : H i w - H' w =
        (β (G i w) u - β (ι w + ι' b) u) + (β (ι w + ι' b) u - β (ι w + ι' b) u') := by
      simp only [H, H', Φ, u, u']
      ring
    rw [hsplit]
    exact (norm_add_le _ _).trans (add_le_add h1 h2)
  -- uniform convergence on B
  have hunif : ∀ ε > 0, ∀ᶠ i in atTop, ∀ w ∈ B, ‖H i w - H' w‖ ≤ ε := by
    intro ε hε
    obtain ⟨δ, hδ, hδβ⟩ := Metric.uniformContinuous_iff.1 hβu (ε / (2 * 2 ^ m)) (by positivity)
    set X : ℝ := M * m * 2 ^ m with hX
    have hX0 : 0 ≤ X := by positivity
    set η : ℝ := min 1 (ε / (2 * (X + 1))) with hη
    have hηpos : 0 < η := lt_min one_pos (by positivity)
    filter_upwards [hH1, hH2 δ hδ, hH2 η hηpos] with i hi1 hi2 hi3
    intro w hw
    have hd := hi1 w hw
    have hL1 : ‖fderiv ℝ (gs i) w‖ ≤ 1 := (hi3 w hw).2.le.trans (min_le_left _ _)
    have hLη : ‖fderiv ℝ (gs i) w‖ ≤ ε / (2 * (X + 1)) :=
      (hi3 w hw).2.le.trans (min_le_right _ _)
    have hβd : ‖β (G i w) - β (ι w + ι' b)‖ ≤ ε / (2 * 2 ^ m) := by
      rw [← dist_eq_norm]
      apply le_of_lt
      apply hδβ
      rw [dist_eq_norm]
      simp only [G]
      rw [add_sub_add_left_eq_sub, ← map_sub, LinearIsometry.norm_map]
      exact (hi2 w hw).1
    refine (hpt i w hd hL1).trans ?_
    have e1 : 2 ^ m * ‖β (G i w) - β (ι w + ι' b)‖ ≤ ε / 2 := by
      calc 2 ^ m * ‖β (G i w) - β (ι w + ι' b)‖ ≤ 2 ^ m * (ε / (2 * 2 ^ m)) := by gcongr
        _ = ε / 2 := by field_simp
    have e2 : X * ‖fderiv ℝ (gs i) w‖ ≤ ε / 2 := by
      calc X * ‖fderiv ℝ (gs i) w‖ ≤ X * (ε / (2 * (X + 1))) := by gcongr
        _ ≤ ε / 2 := by
          rw [mul_div_assoc', div_le_div_iff₀ (by positivity) (by positivity)]
          nlinarith
    linarith
  -- measurability
  have hHmeas : ∀ᶠ i in atTop, AEStronglyMeasurable (H i) (volume.restrict B) := by
    filter_upwards [hH1] with i hi
    have hGc : ContinuousOn (G i) B := fun w hw =>
      (ι.continuous.continuousAt.add
        (ι'.continuous.continuousAt.comp (hi w hw).continuousAt)).continuousWithinAt
    have h1 : AEStronglyMeasurable (G i) (volume.restrict B) := hGc.aestronglyMeasurable hBmeas
    have h2 : AEStronglyMeasurable (fderiv ℝ (G i)) (volume.restrict B) :=
      (measurable_fderiv ℝ (G i)).aestronglyMeasurable
    exact hΦc.comp_aestronglyMeasurable (h1.prodMk h2)
  -- the symmetric differences
  have hsymm' : Tendsto (fun i => (volume (symmDiff (As i) A ∩ B)).toReal) atTop (𝓝 0) := by
    have := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp hsymm
    simpa [Function.comp_def] using this
  set VB : ℝ := (volume B).toReal with hVB
  have hVB0 : 0 ≤ VB := ENNReal.toReal_nonneg
  rw [Metric.tendsto_nhds]
  intro ε hε
  filter_upwards [hunif (ε / (2 * (VB + 1))) (by positivity), hunif 1 one_pos, hHmeas,
    hsymm'.eventually (gt_mem_nhds (show (0 : ℝ) < ε / (4 * (M + 1)) by positivity))]
    with i hi1 hi1' hi2 hi3
  have hsB : As i ∩ B ⊆ B := inter_subset_right
  have hsfin : volume (As i ∩ B) < ⊤ := (measure_mono hsB).trans_lt hBfin
  have htfin : volume (A ∩ B) < ⊤ := (measure_mono inter_subset_right).trans_lt hBfin
  have hsmeas : MeasurableSet (As i ∩ B) := (hAs i).inter hBmeas
  have htmeas : MeasurableSet (A ∩ B) := hA.inter hBmeas
  have hHi_int : IntegrableOn (H i) (As i ∩ B) := by
    refine IntegrableOn.of_bound hsfin (hi2.mono_measure (Measure.restrict_mono hsB le_rfl)) (M + 1) ?_
    refine (ae_restrict_iff' hsmeas).2 (Eventually.of_forall fun w hw => ?_)
    have h := hi1' w hw.2
    calc ‖H i w‖ = ‖(H i w - H' w) + H' w‖ := by rw [sub_add_cancel]
      _ ≤ ‖H i w - H' w‖ + ‖H' w‖ := norm_add_le _ _
      _ ≤ 1 + M := add_le_add h (hH'b w)
      _ = M + 1 := add_comm _ _
  have hH'_int : ∀ s : Set (Euclid m), volume s < ⊤ → IntegrableOn H' s := fun s hs =>
    IntegrableOn.of_bound hs hH'c.aestronglyMeasurable M (Eventually.of_forall hH'b)
  -- first term
  have hT1 : ‖(∫ w in As i ∩ B, H i w) - ∫ w in As i ∩ B, H' w‖ ≤ ε / (2 * (VB + 1)) * VB := by
    rw [← integral_sub hHi_int (hH'_int _ hsfin)]
    refine (norm_setIntegral_le_of_norm_le_const hsfin fun w hw => hi1 w hw.2).trans ?_
    gcongr
    exact measureReal_mono hsB hBfin.ne
  -- second term
  have hT2 : ‖(∫ w in As i ∩ B, H' w) - ∫ w in A ∩ B, H' w‖ ≤
      2 * M * (volume (symmDiff (As i) A ∩ B)).toReal := by
    have e1 := integral_inter_add_sdiff htmeas (hH'_int _ hsfin)
    have e2 := integral_inter_add_sdiff hsmeas (hH'_int _ htfin)
    rw [inter_comm (A ∩ B)] at e2
    have hsub1 : (As i ∩ B) \ (A ∩ B) ⊆ symmDiff (As i) A ∩ B := by
      rintro w ⟨⟨hwA, hwB⟩, hw⟩
      exact ⟨Or.inl ⟨hwA, fun h => hw ⟨h, hwB⟩⟩, hwB⟩
    have hsub2 : (A ∩ B) \ (As i ∩ B) ⊆ symmDiff (As i) A ∩ B := by
      rintro w ⟨⟨hwA, hwB⟩, hw⟩
      exact ⟨Or.inr ⟨hwA, fun h => hw ⟨h, hwB⟩⟩, hwB⟩
    have hΔfin : volume (symmDiff (As i) A ∩ B) < ⊤ :=
      (measure_mono inter_subset_right).trans_lt hBfin
    have b1 : ‖∫ w in (As i ∩ B) \ (A ∩ B), H' w‖ ≤ M * (volume (symmDiff (As i) A ∩ B)).toReal := by
      refine (norm_setIntegral_le_of_norm_le_const ((measure_mono hsub1).trans_lt hΔfin)
        fun w _ => hH'b w).trans ?_
      gcongr
      exact measureReal_mono hsub1 hΔfin.ne
    have b2 : ‖∫ w in (A ∩ B) \ (As i ∩ B), H' w‖ ≤ M * (volume (symmDiff (As i) A ∩ B)).toReal := by
      refine (norm_setIntegral_le_of_norm_le_const ((measure_mono hsub2).trans_lt hΔfin)
        fun w _ => hH'b w).trans ?_
      gcongr
      exact measureReal_mono hsub2 hΔfin.ne
    have : (∫ w in As i ∩ B, H' w) - ∫ w in A ∩ B, H' w =
        (∫ w in (As i ∩ B) \ (A ∩ B), H' w) - ∫ w in (A ∩ B) \ (As i ∩ B), H' w := by
      linarith
    rw [this]
    calc _ ≤ ‖∫ w in (As i ∩ B) \ (A ∩ B), H' w‖ + ‖∫ w in (A ∩ B) \ (As i ∩ B), H' w‖ :=
          norm_sub_le _ _
      _ ≤ _ := by linarith
  rw [dist_eq_norm]
  have hsum : (∫ w in As i ∩ B, H i w) - ∫ w in A ∩ B, H' w =
      ((∫ w in As i ∩ B, H i w) - ∫ w in As i ∩ B, H' w) +
        ((∫ w in As i ∩ B, H' w) - ∫ w in A ∩ B, H' w) := by ring
  rw [hsum]
  have hlt1 : ε / (2 * (VB + 1)) * VB < ε / 2 := by
    rw [div_mul_eq_mul_div, div_lt_div_iff₀ (by positivity) (by positivity)]
    nlinarith
  have hlt2 : 2 * M * (volume (symmDiff (As i) A ∩ B)).toReal ≤ ε / 2 := by
    have h3 : (volume (symmDiff (As i) A ∩ B)).toReal < ε / (4 * (M + 1)) := hi3
    have h4 : 0 ≤ (volume (symmDiff (As i) A ∩ B)).toReal := ENNReal.toReal_nonneg
    calc 2 * M * (volume (symmDiff (As i) A ∩ B)).toReal
        ≤ 2 * (M + 1) * (volume (symmDiff (As i) A ∩ B)).toReal := by gcongr; linarith
      _ ≤ 2 * (M + 1) * (ε / (4 * (M + 1))) := by gcongr
      _ = ε / 2 := by field_simp; ring
  calc _ ≤ _ := norm_add_le _ _
    _ < ε := by linarith
/-- **Integrals over the image of a measurable set under an affine isometry `ℝᵐ → ℝᴾ`** (Simon
7.5.5 regards the limit set `F` as an `Hⁿ⁺¹`-measurable subset of the plane `TₓN` in this way).
`G(w) = ιw + c` is an isometry of the complete space `ℝᵐ`, hence a measurable embedding, so `G(A)`
is measurable.  `Hᵐ` is invariant under isometries and equals `Lᵐ` on `ℝᵐ`, so
`G_#Lᵐ = Hᵐ⌞G(ℝᵐ)` and, by injectivity, `Hᵐ⌞G(A) = G_#(Lᵐ⌞A)`; hence
`∫_{G(A)} f dHᵐ = ∫_A f(G(w)) dw` for every `f`. -/
theorem Submission.codim1_zsl_fl_isometry_image_setIntegral : ∀ (m P : ℕ) (ι : Euclid m →ₗᵢ[ℝ] Euclid P) (c : Euclid P) (A : Set (Euclid m)), MeasurableSet A → MeasurableSet ((fun w => ι w + c) '' A) ∧ ∀ f : Euclid P → ℝ, ∫ y in (fun w => ι w + c) '' A, f y ∂μHE[m] = ∫ w in A, f (ι w + c) := by
  intro m P ι c A hA
  -- `G` is an isometry of the complete space `ℝᵐ`, hence a measurable embedding.
  have hiso : Isometry (fun w => ι w + c) := by
    refine Isometry.of_dist_eq fun x y => ?_
    rw [dist_eq_norm, dist_eq_norm, add_sub_add_right_eq_sub, ← map_sub, LinearIsometry.norm_map]
  have hemb : MeasurableEmbedding (fun w => ι w + c) :=
    hiso.isClosedEmbedding.measurableEmbedding
  have hAimg : MeasurableSet ((fun w => ι w + c) '' A) := hemb.measurableSet_image' hA
  refine ⟨hAimg, fun f => ?_⟩
  -- `G_#Lᵐ = Hᵐ⌞G(ℝᵐ)`, hence `Hᵐ⌞G(A) = G_#(Lᵐ⌞A)`.
  have hmap : (volume : Measure (Euclid m)).map (fun w => ι w + c) =
      (μHE[m] : Measure (Euclid P)).restrict (range (fun w => ι w + c)) := by
    rw [← hiso.map_euclideanHausdorffMeasure, EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
  have hres : (μHE[m] : Measure (Euclid P)).restrict ((fun w => ι w + c) '' A) =
      ((volume : Measure (Euclid m)).restrict A).map (fun w => ι w + c) := by
    rw [← preimage_image_eq A hemb.injective, ← hemb.restrict_map, hmap,
      Measure.restrict_restrict hAimg, inter_eq_left.mpr (image_subset_range _ _),
      preimage_image_eq A hemb.injective]
  rw [hres, hemb.integral_map]
/-- **A `0`-dimensional current minimizing in `A` with `spt T ⊆ A` vanishes** (Simon 7.1.1 with
Ch. 6, 3.1).  Write `T = τ(M, θ, ξ)` and suppose `x₀ ∈ M`.  As `H⁰{x₀} = 1`,
`μ_T(B_s(x₀)) ≥ θ(x₀) ≥ 1` for every `s > 0`, so `x₀ ∈ spt T ⊆ A`; as `M` is finite on compact
subsets of `U`, some ball `W = B_ε(x₀) ⊂⊂ U` meets `M` only in `x₀`.  Deleting `x₀` gives the
integer multiplicity current `S = T − X`, `X(ω) = θ(x₀)⟨ω(x₀), ξ(x₀)⟩`, with
`spt(S − T) ⊆ spt X ⊆ {x₀} ⊆ A ∩ W` (and `∂S = ∂T`, the degree being `0`).  Minimality gives
`1 ≤ θ(x₀) ≤ μ_T(W) = M_W(T) ≤ M_W(S) = μ_S(W) = 0`, which is absurd; so `M = ∅` and `T = 0`. -/
theorem Submission.dimred_zero_dim_minimizing_eq_zero : ∀ (P : ℕ) (U A : Set (Euclid P)) (T : GeometricCurrentOn U 0), IsOpen U → IsMinimizingIn T A → T.support ⊆ A → T = 0 := by
  intro P U A T hU hmin hspt
  obtain ⟨R, hR⟩ := hmin.1
  obtain ⟨hmass, hsupp, -⟩ := Submission.dimred_im_mass_measure P 0 U T R hU hR
  -- it suffices that the carrier `M` is empty: then `T(ω) = ∫_∅ θ⟨ω, ξ⟩ dH⁰ = 0`
  suffices hM : R.carrier = ∅ by
    ext ω
    rw [hR ω, GeometricCurrentOn.zero_apply, IMRep.action, hM, setIntegral_empty]
  by_contra hne
  obtain ⟨x₀, hx₀⟩ := nonempty_iff_ne_empty.2 hne
  have hx₀U : x₀ ∈ U := R.carrier_subset hx₀
  -- `μ_T(V) ≥ μ_T{x₀} = θ(x₀) H⁰{x₀} = θ(x₀) ≥ 1` whenever `x₀ ∈ V`
  have hμ : ∀ V : Set (Euclid P), x₀ ∈ V → 1 ≤ R.measure V := by
    intro V hV
    have hθ : R.measure {x₀} = R.mult x₀ := by
      rw [IMRep.measure, withDensity_apply _ (measurableSet_singleton x₀), lintegral_singleton,
        Measure.restrict_apply (measurableSet_singleton x₀), singleton_inter_of_mem hx₀,
        Measure.euclideanHausdorffMeasure_zero, Measure.hausdorffMeasure_zero_singleton, mul_one]
    calc (1 : ℝ≥0∞) ≤ R.mult x₀ := Nat.one_le_cast.2 (R.mult_pos x₀ hx₀)
      _ = R.measure {x₀} := hθ.symm
      _ ≤ R.measure V := measure_mono (singleton_subset_iff.2 hV)
  -- `x₀ ∈ spt T ⊆ A`, by `im_mass_measure` (b)
  have hx₀A : x₀ ∈ A := hspt ((hsupp x₀ hx₀U).2 fun s hs =>
    (one_pos.trans_le (hμ _ (mem_ball_self hs))).ne')
  -- `M ∩ B̄_r(x₀)` is finite (`B̄_r(x₀) ⊆ U`), so a ball `B_ε(x₀)`, `ε ≤ r`, meets `M` only in `x₀`
  obtain ⟨r₀, hr₀, hr₀U⟩ := Metric.isOpen_iff.1 hU x₀ hx₀U
  have hKU : closedBall x₀ (r₀ / 2) ⊆ U := (closedBall_subset_ball (half_lt_self hr₀)).trans hr₀U
  have hF : IsClosed ((R.carrier ∩ closedBall x₀ (r₀ / 2)) \ {x₀}) :=
    (Submission.dimred_zdv_carrier_finite P U _ R (isCompact_closedBall x₀ _) hKU).sdiff.isClosed
  obtain ⟨δ, hδ, hδF⟩ := Metric.isOpen_iff.1 hF.isOpen_compl x₀ fun h => h.2 (mem_singleton x₀)
  have hε : 0 < min δ (r₀ / 2) := lt_min hδ (half_pos hr₀)
  have hMW : ∀ y ∈ R.carrier, y ∈ ball x₀ (min δ (r₀ / 2)) → y = x₀ := fun y hy hyW => by
    by_contra hyx
    exact hδF (ball_subset_ball (min_le_left _ _) hyW)
      ⟨⟨hy, ball_subset_closedBall (ball_subset_ball (min_le_right _ _) hyW)⟩, hyx⟩
  -- `W = B_ε(x₀)` is open, and `closure W ⊆ B̄_r(x₀)` is compact and contained in `U`
  have hWK : closure (ball x₀ (min δ (r₀ / 2))) ⊆ closedBall x₀ (r₀ / 2) :=
    closure_ball_subset_closedBall.trans (closedBall_subset_closedBall (min_le_right _ _))
  have hWU : ball x₀ (min δ (r₀ / 2)) ⊆ U := subset_closure.trans (hWK.trans hKU)
  have hWcc : CompactlyContained (ball x₀ (min δ (r₀ / 2))) U :=
    ⟨(isCompact_closedBall x₀ _).of_isClosed_subset isClosed_closure hWK, hWK.trans hKU⟩
  -- the competitor `S = T − X`, `X(ω) = θ(x₀)⟨ω(x₀), ξ(x₀)⟩`, is represented by `(M ∖ {x₀}, θ, ξ)`
  obtain ⟨R', hR'M, -, -, hR'⟩ := Submission.dimred_zdv_erase_point P U R x₀ hx₀
  obtain ⟨X, hX, hXspt⟩ :=
    Submission.dimred_zdv_point_current P 0 U x₀ ((R.mult x₀ : ℝ) • R.orient x₀) hU
  have hS : R'.Represents (T - X) := fun ω => by
    show T ω - X ω = _
    rw [hR ω, hR' ω, hX ω, smul_apply, smul_eq_mul, add_sub_cancel_right]
  -- `S − T = −X` vanishes wherever `X` does, so `spt(S − T) ⊆ spt X ⊆ {x₀} ⊆ A ∩ W`
  have hST : (T - X - T).support ⊆ {x₀} := by
    rintro y ⟨hyU, hyZ⟩
    refine hXspt ⟨hyU, fun hyX => hyZ ?_⟩
    obtain ⟨V, ⟨hVo, hVc, hVU, hXV⟩, hyV⟩ := hyX
    refine mem_sUnion_of_mem hyV ⟨hVo, hVc, hVU, fun ω hω => ?_⟩
    show T ω - X ω - T ω = 0
    rw [hXV ω hω, sub_zero, sub_self]
  have hle := hmin.2 (ball x₀ (min δ (r₀ / 2))) (T - X) isOpen_ball hWcc ⟨R', hS⟩ trivial
    ((finite_singleton x₀).subset hST).isCompact
    (hST.trans (singleton_subset_iff.2 ⟨hx₀A, mem_ball_self hε⟩))
  -- `M_W(S) = μ_S(W) = 0`, as `(M ∖ {x₀}) ∩ W = ∅`
  have hS0 : R'.measure (ball x₀ (min δ (r₀ / 2))) = 0 := by
    have hempty : ball x₀ (min δ (r₀ / 2)) ∩ R'.carrier = ∅ := by
      rw [hR'M]
      exact eq_empty_of_forall_notMem fun y hy => hy.2.2 (hMW y hy.2.1 hy.1)
    rw [IMRep.measure, withDensity_apply _ isOpen_ball.measurableSet,
      Measure.restrict_restrict isOpen_ball.measurableSet, hempty, Measure.restrict_empty,
      lintegral_zero_measure]
  have h1 := (hμ _ (mem_ball_self hε)).trans ((hmass _ isOpen_ball hWU).symm.le.trans hle)
  rw [(Submission.dimred_im_mass_measure P 0 U (T - X) R' hU hS).1 _ isOpen_ball hWU, hS0] at h1
  exact absurd h1 (not_le.2 zero_lt_one)

/-- **Monotonicity, densities and `Θ ≥ 1` for minimizing cycles in `N`** (Simon Ch. 4,
3.1–3.17, through 7.1.2).  Take `T = τ(M, θ, ξ)` and `μ_R = θHⁿ⌞M`.  By 7.1.2 (with `P = n + k`
and `d = n + ℓ`) the varifold `v(M, θ)` is stationary in `N ∩ U` and has mean curvature bounded
on compact subsets of `U`, and `M_W(T) = μ_R(W)` for open `W ⊆ U`.  (i) On a compact `K ⊆ U`
the mean curvature may be taken bounded by `Λ` everywhere, and `e^{Λρ}ρ⁻ⁿμ_R(B_ρ(y))` is
nondecreasing for `B̄_R(y) ⊆ K` (3.17).  (ii) If `N = ℝᴾ`, every vector is tangent to `N`, so
`δV = 0` in `U`, and the same argument with `H = 0`, `Λ = 0` on `B̄_{(ρ+R)/2}(y) ⊆ B_R(y)`
applies.  (iii) The masses of small balls are finite, so monotone limits give `Θ`, upper
semicontinuous on `U` (3.8–3.11).  (iv) `Θ ≥ 1` `μ_R`-a.e. and upper semicontinuity give
`Θ ≥ 1` on `spt T` (3.13). -/
theorem Submission.dimred_minimizing_monotonicity : ∀ (P n d : ℕ) (U N : Set (Euclid P)) (T : GeometricCurrentOn U n), 1 ≤ n → n ≤ d → d ≤ P → IsOpen U → IsEmbeddedSubmanifold 2 d N → (closure N \ N) ∩ U = ∅ → IsMinimizingIn T (U ∩ N) → T.support ⊆ U ∩ N → BoundaryVanishes T → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ∃ Λ : ℝ, 0 ≤ Λ ∧ ∀ (y : Euclid P) (R : ℝ), closedBall y R ⊆ K → MonotoneOn (fun ρ : ℝ => ENNReal.ofReal (Real.exp (Λ * ρ) / ρ ^ n) * T.massOn (ball y ρ)) (Ioo 0 R)) ∧ (N = univ → ∀ (y : Euclid P) (R : ℝ), ball y R ⊆ U → MonotoneOn (fun ρ : ℝ => ENNReal.ofReal (1 / ρ ^ n) * T.massOn (ball y ρ)) (Ioo 0 R)) ∧ (∃ Θ : Euclid P → ℝ, (∀ y ∈ U, HasMassDensity T y (Θ y)) ∧ UpperSemicontinuousOn Θ U) ∧ ∀ y ∈ T.support, ∀ θ : ℝ, HasMassDensity T y θ → 1 ≤ θ := by
  intro P n d U N T _ hnd hdP hU hN hcl hmin hspt hbd
  -- Step 0.  `T = τ(M, θ, ξ)`; by 7.1.2 in `ℝ^{n+k}`, `N` of dimension `n + ℓ`, `v(M, θ)` is
  -- stationary in `N ∩ U` and has locally bounded mean curvature in `U`
  obtain ⟨R, hR⟩ := hmin.1
  have hstat : R.IsStationaryAlong N ∧ R.HasLocallyBoundedMeanCurvature := by
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le (hnd.trans hdP)
    obtain ⟨ℓ, rfl⟩ := Nat.exists_eq_add_of_le hnd
    exact Submission.minimizing_implies_stationary n k ℓ (by omega) U N T hU hN hcl
      (hspt.trans inter_subset_right) (by rw [inter_comm]; exact hmin) hbd R hR
  -- `M_W(T) = μ_R(W)` for open `W ⊆ U`; `x ∈ spt T` iff `μ_R(B_ε(x)) > 0` for all `ε > 0`
  obtain ⟨hmass, hsupp, -⟩ := Submission.dimred_im_mass_measure P n U T R hU hR
  have hp := Submission.dsmc_approxTangentPlane_starProjection_aemeasurable P n U R hU
  -- (i) on `K`, `δV(X) = -∫ X · H dμ_R` with `|H| ≤ Λ` everywhere, so 3.17 applies on `B_r(y)`
  have hi : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ∃ Λ : ℝ, 0 ≤ Λ ∧
      ∀ (y : Euclid P) (r : ℝ), closedBall y r ⊆ K → MonotoneOn (fun ρ : ℝ =>
        ENNReal.ofReal (Real.exp (Λ * ρ) / ρ ^ n) * T.massOn (ball y ρ)) (Ioo 0 r) := by
    intro K hK hKU
    obtain ⟨Λ, hΛ, H, hHm, hHΛ, hfv⟩ :=
      Submission.dimred_mono_truncated_mean_curvature P n U R hstat.2 K hK hKU
    refine ⟨Λ, hΛ, fun y r hyr => ?_⟩
    intro σ hσ ρ hρ hσρ
    have hBU : ∀ s, s ≤ r → ball y s ⊆ U := fun s hs =>
      (ball_subset_ball hs).trans (ball_subset_closedBall.trans (hyr.trans hKU))
    dsimp only
    rw [hmass _ isOpen_ball (hBU σ hσ.2.le), hmass _ isOpen_ball (hBU ρ hρ.2.le)]
    exact Submission.dsmc_exp_ball_mass_monotone P n U R H Λ y r (hyr.trans hKU) hp hHm hHΛ
      (fun X hX hXc hXs => hfv X hX hXc (hXs.trans (ball_subset_closedBall.trans hyr)))
      σ ρ hσ.1 hσρ hρ.2.le
  -- (ii) if `N = ℝᴾ`, then `TₓN = ℝᴾ` (`γ(t) = x + tv`), so `δV = 0` in `U`: take `H = 0`
  have hii : N = univ → ∀ (y : Euclid P) (r : ℝ), ball y r ⊆ U → MonotoneOn (fun ρ : ℝ =>
      ENNReal.ofReal (1 / ρ ^ n) * T.massOn (ball y ρ)) (Ioo 0 r) := by
    rintro rfl y r hyr σ hσ ρ hρ hσρ
    have hfv : ∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X →
        tsupport X ⊆ U → R.firstVariation X = 0 := fun X hX hXc hXU =>
      hstat.1 X hX hXc hXU fun x _ => ⟨fun t => x + t • X x,
        (contDiff_const.add (contDiff_id.smul contDiff_const)).contDiffOn, mapsTo_univ _ _,
        by simp, by simpa using ((hasDerivAt_id (0 : ℝ)).smul_const (X x)).const_add x⟩
    -- 3.17 with `H = 0` and `κ = 0` on `B̄_{(ρ+r)/2}(y) ⊆ B_r(y)`
    have hr : closedBall y ((ρ + r) / 2) ⊆ U :=
      (closedBall_subset_ball (by linarith [hρ.2])).trans hyr
    have h := Submission.dsmc_exp_ball_mass_monotone P n U R 0 0 y ((ρ + r) / 2) hr hp
      aestronglyMeasurable_zero (fun _ => by simp) (fun X hX hXc hXs => by
        rw [hfv X hX hXc (hXs.trans (ball_subset_closedBall.trans hr))]
        simp) σ ρ hσ.1 hσρ (by linarith [hρ.2])
    simp only [zero_mul, Real.exp_zero] at h
    dsimp only
    rw [hmass _ isOpen_ball ((ball_subset_ball hσ.2.le).trans hyr),
      hmass _ isOpen_ball ((ball_subset_ball hρ.2.le).trans hyr)]
    exact h
  -- (iii) `M_{B_{ε/2}(y)}(T) ≤ μ_R(B̄_{ε/2}(y)) = ∫_{M ∩ B̄_{ε/2}(y)} θ dHⁿ < ∞` when
  -- `B_ε(y) ⊆ U`; monotone limits then give `Θ`, upper semicontinuous on `U`
  have hfin : ∀ y ∈ U, ∃ r : ℝ, 0 < r ∧ T.massOn (ball y r) ≠ ∞ := by
    intro y hy
    obtain ⟨ε, hε, hεU⟩ := Metric.isOpen_iff.1 hU y hy
    have hcU : closedBall y (ε / 2) ⊆ U := (closedBall_subset_ball (half_lt_self hε)).trans hεU
    refine ⟨ε / 2, half_pos hε, ?_⟩
    rw [hmass _ isOpen_ball (ball_subset_closedBall.trans hcU)]
    refine ne_top_of_le_ne_top ?_ (measure_mono ball_subset_closedBall)
    rw [IMRep.measure, withDensity_apply _ measurableSet_closedBall,
      Measure.restrict_restrict measurableSet_closedBall, inter_comm]
    exact R.locallyIntegrable_mult _ (isCompact_closedBall y (ε / 2)) hcU
  obtain ⟨Θ, hΘ, hΘusc⟩ := Submission.dimred_mono_density_usc_of_monotone P n U T hU hfin hi
  -- (iv) `Θ ≥ 1` `μ_R`-a.e. and `Θ` is upper semicontinuous, so `Θ ≥ 1` on `spt T`
  refine ⟨hi, hii, ⟨Θ, hΘ, hΘusc⟩, ?_⟩
  exact Submission.dimred_mono_support_density_ge_one_of_usc P n U T R.measure Θ hU hmass
    (fun x hx => (hsupp x (hspt hx).1).1 hx)
    (Submission.dimred_mono_ae_ball_density_ge_one P n U R hU) hΘ hΘusc

/-- Chapter 7 of Simon's *Introduction to GMT*: the headline results above. -/
theorem main_theorem : MinimizingImpliesStationary ∧ ExistenceOfMinimizingFilling ∧ CompactnessOfMinimizingCurrents ∧ DensityAndTangentCones ∧ IntegerDensityAndTangentPlanes ∧ RegularSetDense ∧ DensityOneImpliesRegular ∧ SingularSetSmallWhereDensityBelowTwo ∧ HalfSpaceConeLiesInBoundary ∧ CodimensionOneRegularity ∧ RegularComponentsAreMinimizing := by sorry

namespace Submission

/-- Mollification by an even `C¹` kernel `η` with compact support commutes with `D` and is
self-adjoint: `∫ D(η * u)(x)(s x) dx = −∫ u div(η * s)` for integrable `u`, `s` (Simon Ch. 2,
Lemma 2.5).  Both derivatives are convolutions with the odd, bounded `Dη`, and Fubini applies to
`Dη(x − z)(s x) u(z)`, which is dominated by `C ‖s x‖ |u z|`. -/
theorem codim1_rdo_dg_sp_mollifier_adjoint : ∀ (P : ℕ) (η u : Euclid P → ℝ) (s : Euclid P → Euclid P), ContDiff ℝ 1 η → HasCompactSupport η → (∀ z, η (-z) = η z) → Integrable u → Integrable s → ∫ x, fderiv ℝ (convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume) x (s x) = -∫ z, u z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ (convolution η s (ContinuousLinearMap.lsmul ℝ ℝ) volume) z : Euclid P →ₗ[ℝ] Euclid P) := by
  intro P η u s hη hηc heven hu hs
  -- Step 0: `Dη` is continuous with compact support, hence bounded by some `C`.
  have hDc : Continuous (fderiv ℝ η) := hη.continuous_fderiv one_ne_zero
  have hDcs : HasCompactSupport (fderiv ℝ η) := hηc.fderiv ℝ
  obtain ⟨C, hC⟩ := hDc.bounded_above_of_compact_support hDcs
  -- Step 1: `η` is even, so `Dη` is odd (chain rule for `η = η ∘ (−id)`).
  have hodd : ∀ y, fderiv ℝ η (-y) = -fderiv ℝ η y := by
    intro y
    have h1 : HasFDerivAt (η ∘ fun z => -z)
        ((fderiv ℝ η (-y)).comp (-ContinuousLinearMap.id ℝ (Euclid P))) y :=
      ((hη.differentiable one_ne_zero) (-y)).hasFDerivAt.comp y (hasFDerivAt_id y).neg
    rw [show (η ∘ fun z => -z) = η from funext heven] at h1
    ext v
    rw [h1.fderiv]
    simp
  -- Step 2: `D(η * u)(x) = (Dη * u)(x)`, so `D(η * u)(x)(s x) = ∫ Dη(x − z)(s x) u(z) dz`.
  have hLHS : ∀ x, fderiv ℝ (convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume) x (s x) =
      ∫ z, fderiv ℝ η (x - z) (s x) * u z := by
    intro x
    rw [(hηc.hasFDerivAt_convolution_left _ hη hu.locallyIntegrable x).fderiv, convolution_eq_swap,
      ContinuousLinearMap.integral_apply
        ((hDcs.convolutionExists_left _ hDc hu.locallyIntegrable x).integrable_swap)]
    simp
  -- Step 3: `div(η * s)(z) = trace D(η * s)(z) = ∫ Dη(z − x)(s x) dx`: the trace `T` is a
  -- continuous linear functional, and the trace of the rank-one map `v ↦ a(v) w` is `a(w)`.
  have hRHS : ∀ z, LinearMap.trace ℝ (Euclid P)
      (fderiv ℝ (convolution η s (ContinuousLinearMap.lsmul ℝ ℝ) volume) z :
        Euclid P →ₗ[ℝ] Euclid P) = ∫ x, fderiv ℝ η (z - x) (s x) := by
    let T : (Euclid P →L[ℝ] Euclid P) →L[ℝ] ℝ := LinearMap.toContinuousLinearMap
      (LinearMap.trace ℝ (Euclid P) ∘ₗ ContinuousLinearMap.coeLM ℝ)
    have hTA : ∀ A : Euclid P →L[ℝ] Euclid P,
        T A = LinearMap.trace ℝ (Euclid P) (A : Euclid P →ₗ[ℝ] Euclid P) := fun A => rfl
    have hrk : ∀ (a : Euclid P →L[ℝ] ℝ) (w : Euclid P), T (ContinuousLinearMap.precompL (Euclid P)
        (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] Euclid P →L[ℝ] Euclid P) a w) = a w := by
      intro a w
      have h : ((ContinuousLinearMap.precompL (Euclid P)
          (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] Euclid P →L[ℝ] Euclid P) a w :
            Euclid P →L[ℝ] Euclid P) : Euclid P →ₗ[ℝ] Euclid P) =
          (a : Euclid P →ₗ[ℝ] ℝ).smulRight w := by
        ext v
        simp
      rw [hTA, h, LinearMap.trace_smulRight]
      rfl
    intro z
    rw [(hηc.hasFDerivAt_convolution_left _ hη hs.locallyIntegrable z).fderiv, convolution_eq_swap]
    have hT := ContinuousLinearMap.integral_comp_comm T
      ((hDcs.convolutionExists_left (ContinuousLinearMap.precompL (Euclid P)
        (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] Euclid P →L[ℝ] Euclid P)) hDc
          hs.locallyIntegrable z).integrable_swap)
    simp_rw [hrk] at hT
    exact hT.symm
  -- Step 4: Fubini for `H(x, z) = Dη(x − z)(s x) u(z)`, dominated by `C ‖s x‖ |u z|`.
  have hint : Integrable (uncurry fun x z => fderiv ℝ η (x - z) (s x) * u z)
      ((volume : Measure (Euclid P)).prod volume) := by
    refine Integrable.mono' ((hs.norm.mul_prod hu.norm).const_mul C) ?_ (Eventually.of_forall ?_)
    · exact ((ContinuousLinearMap.apply ℝ ℝ).aestronglyMeasurable_comp₂
        hs.aestronglyMeasurable.comp_fst
        (hDc.comp (continuous_fst.sub continuous_snd)).aestronglyMeasurable).mul
        hu.aestronglyMeasurable.comp_snd
    · rintro ⟨x, z⟩
      simp only [uncurry_apply_pair, norm_mul]
      calc ‖fderiv ℝ η (x - z) (s x)‖ * ‖u z‖ ≤ (C * ‖s x‖) * ‖u z‖ := by
            gcongr
            exact ((fderiv ℝ η (x - z)).le_opNorm (s x)).trans (by gcongr; exact hC _)
        _ = C * (‖s x‖ * ‖u z‖) := by ring
  -- Step 5: combine, using `Dη(z − x) = −Dη(x − z)` to identify the swapped integral.
  calc ∫ x, fderiv ℝ (convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume) x (s x)
      = ∫ x, ∫ z, fderiv ℝ η (x - z) (s x) * u z := by simp_rw [hLHS]
    _ = ∫ z, ∫ x, fderiv ℝ η (x - z) (s x) * u z := integral_integral_swap hint
    _ = -∫ z, u z * LinearMap.trace ℝ (Euclid P)
          (fderiv ℝ (convolution η s (ContinuousLinearMap.lsmul ℝ ℝ) volume) z :
            Euclid P →ₗ[ℝ] Euclid P) := by
      rw [← integral_neg]
      congr 1
      funext z
      rw [hRHS z, ← integral_const_mul, ← integral_neg]
      congr 1
      funext x
      rw [← neg_sub x z, hodd, neg_apply]
      ring
/-- Mollification does not increase the variation (Simon Ch. 2, Lemma 2.5, formula (4)): if
`|∫ u div g| ≤ M` for every `g ∈ C¹_c(ℝᴾ; ℝᴾ)` with `|g| ≤ 1`, then `∫ |D(η * u)| ≤ M` for an even
mollifier `η ≥ 0` with `∫ η = 1`.  With `w = η * u`, the field `s = 1_{spt w} |∇w|⁻¹ ∇w`
(`0⁻¹ = 0`) is Borel, bounded by `1`, compactly supported and has `Dw(s) = |Dw|`;
`codim1_rdo_dg_sp_mollifier_adjoint` moves `η` onto `s`, and `g = η * s` is admissible. -/
theorem codim1_rdo_dg_sp_mollify_variation : ∀ (P : ℕ) (u : Euclid P → ℝ) (M : ℝ), Integrable u → HasCompactSupport u → (∀ g : Euclid P → Euclid P, ContDiff ℝ 1 g → HasCompactSupport g → (∀ z, ‖g z‖ ≤ 1) → |∫ z, u z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ g z : Euclid P →ₗ[ℝ] Euclid P)| ≤ M) → ∀ η : Euclid P → ℝ, ContDiff ℝ 1 η → HasCompactSupport η → (∀ z, 0 ≤ η z) → (∀ z, η (-z) = η z) → ∫ z, η z = 1 → ∫ z, ‖fderiv ℝ (convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume) z‖ ≤ M := by
  intro P u M hu huc hM η hη hηc hη0 heven hη1
  -- Step 1: `w = η * u` is `C¹` with compact support `S = spt w`.
  set w := convolution η u (ContinuousLinearMap.lsmul ℝ ℝ) volume
  have hwc : HasCompactSupport w := hηc.convolution _ huc
  have hDw : Continuous (fderiv ℝ w) :=
    (hηc.contDiff_convolution_left _ hη hu.locallyIntegrable).continuous_fderiv one_ne_zero
  set S := tsupport w
  have hSm : MeasurableSet S := (isClosed_tsupport w).measurableSet
  -- Step 2: the gradient `∇w = (toDual)⁻¹ Dw` is continuous, `|∇w| = |Dw|`, `Dw(∇w) = |∇w|²`.
  set grad : Euclid P → Euclid P :=
    fun x => (InnerProductSpace.toDual ℝ (Euclid P)).symm (fderiv ℝ w x)
  have hgc : Continuous grad := (InnerProductSpace.toDual ℝ (Euclid P)).symm.continuous.comp hDw
  have hgn : ∀ x, ‖grad x‖ = ‖fderiv ℝ w x‖ := fun x => LinearIsometryEquiv.norm_map _ _
  have hgg : ∀ x, fderiv ℝ w x (grad x) = ‖grad x‖ ^ 2 := by
    intro x
    rw [← InnerProductSpace.toDual_symm_apply (𝕜 := ℝ) (x := grad x) (y := fderiv ℝ w x)]
    exact real_inner_self_eq_norm_sq _
  -- Step 3: the unit field `f = |∇w|⁻¹ ∇w` (`0⁻¹ = 0`) and `s = 1_S f`.
  set f : Euclid P → Euclid P := fun x => ‖grad x‖⁻¹ • grad x with hf
  have hfm : Measurable f := hgc.norm.measurable.inv.smul hgc.measurable
  have hf1 : ∀ x, ‖f x‖ ≤ 1 := by
    intro x
    simp only [hf, norm_smul, norm_inv, norm_norm]
    rcases eq_or_ne ‖grad x‖ 0 with h | h
    · simp [h]
    · rw [inv_mul_cancel₀ h]
  set s : Euclid P → Euclid P := S.indicator f with hs
  have hs1 : ∀ x, ‖s x‖ ≤ 1 := fun x => (norm_indicator_le_norm_self f x).trans (hf1 x)
  have hsc : HasCompactSupport s :=
    HasCompactSupport.intro hwc.isCompact fun x hx => indicator_of_notMem hx f
  have hsi : Integrable s := by
    rw [hs, integrable_indicator_iff hSm]
    exact Measure.integrableOn_of_bounded hwc.isCompact.measure_lt_top.ne
      hfm.aestronglyMeasurable (Eventually.of_forall hf1)
  -- Step 4: `Dw(x)(s x) = |Dw(x)|` for all `x`.
  have hDs : ∀ x, fderiv ℝ w x (s x) = ‖fderiv ℝ w x‖ := by
    intro x
    by_cases hx : x ∈ S
    · simp only [hs, indicator_of_mem hx, hf, map_smul, hgg, smul_eq_mul, ← hgn]
      rcases eq_or_ne ‖grad x‖ 0 with h | h
      · simp [h]
      · field_simp
    · rw [fderiv_of_notMem_tsupport ℝ hx]
      simp
  -- Step 5: `g = η * s` is admissible: `C¹`, compact support, `|g| ≤ ∫ η = 1`.
  set g := convolution η s (ContinuousLinearMap.lsmul ℝ ℝ) volume with hg
  have hgC1 : ContDiff ℝ 1 g := hηc.contDiff_convolution_left _ hη hsi.locallyIntegrable
  have hgcs : HasCompactSupport g := hηc.convolution _ hsc
  have hηi : Integrable η := hη.continuous.integrable_of_hasCompactSupport hηc
  have hg1 : ∀ z, ‖g z‖ ≤ 1 := by
    intro z
    rw [hg, convolution_def]
    refine (norm_integral_le_of_norm_le hηi (Eventually.of_forall fun t => ?_)).trans hη1.le
    rw [ContinuousLinearMap.lsmul_apply, norm_smul, Real.norm_of_nonneg (hη0 t)]
    exact mul_le_of_le_one_right (hη0 t) (hs1 _)
  -- Steps 6–7: the adjoint identity, then the hypothesis for `g`.
  calc ∫ z, ‖fderiv ℝ w z‖ = ∫ z, fderiv ℝ w z (s z) :=
        integral_congr_ae (Eventually.of_forall fun z => (hDs z).symm)
    _ = -∫ z, u z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ g z : Euclid P →ₗ[ℝ] Euclid P) :=
        Submission.codim1_rdo_dg_sp_mollifier_adjoint P η u s hη hηc heven hu hsi
    _ ≤ |∫ z, u z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ g z : Euclid P →ₗ[ℝ] Euclid P)| :=
        neg_le_abs _
    _ ≤ M := hM g hgC1 hgcs hg1

/-- **Sobolev inequality in the limit of symmetric mollifications** (Simon Ch. 3, proof of
Theorem 4.3 (De Giorgi), Sobolev step, chapter-03.txt lines 689–712, with the mollification
Lemma Ch. 2, 2.5, chapter-02.txt lines 543–596).  Assume the Sobolev inequality
`(∫ |w|^p)^{1/p} ≤ c ∫ |Dw|` for `C¹` compactly supported `w`, let `u` be integrable with compact
support and `|∫ u div g| ≤ M` for `C¹_c` fields `|g| ≤ 1`, and let `η_k` be even, nonnegative,
`C¹`, compactly supported with `∫ η_k = 1` and `η_k * u → u` a.e.  Then `(∫ |u|^p)^{1/p} ≤ c M`:
`g = 0` gives `M ≥ 0`; each `w_k = η_k * u` is `C¹` with compact support and
`∫ |Dw_k| ≤ M` (`codim1_rdo_dg_sp_mollify_variation`), so `∫⁻ ‖w_k‖ₑ^p ≤ (cM)^p` by the Sobolev
inequality; Fatou's lemma along `w_k → u` a.e. gives `∫⁻ ‖u‖ₑ^p ≤ (cM)^p`, and taking `toReal`
and the `1/p` power concludes. -/
theorem codim1_rdo_dg_sp_sobolev_limit : ∀ (P : ℕ) (p c : ℝ), 0 < p → 0 ≤ c → (∀ w : Euclid P → ℝ, ContDiff ℝ 1 w → HasCompactSupport w → (∫ z, |w z| ^ p) ^ p⁻¹ ≤ c * ∫ z, ‖fderiv ℝ w z‖) → ∀ (u : Euclid P → ℝ) (M : ℝ), Integrable u → HasCompactSupport u → (∀ g : Euclid P → Euclid P, ContDiff ℝ 1 g → HasCompactSupport g → (∀ z, ‖g z‖ ≤ 1) → |∫ z, u z * LinearMap.trace ℝ (Euclid P) (fderiv ℝ g z : Euclid P →ₗ[ℝ] Euclid P)| ≤ M) → ∀ η : ℕ → Euclid P → ℝ, (∀ k, ContDiff ℝ 1 (η k)) → (∀ k, HasCompactSupport (η k)) → (∀ k z, 0 ≤ η k z) → (∀ k z, η k (-z) = η k z) → (∀ k, ∫ z, η k z = 1) → (∀ᵐ x, Tendsto (fun k => convolution (η k) u (ContinuousLinearMap.lsmul ℝ ℝ) volume x) atTop (𝓝 (u x))) → (∫ z, |u z| ^ p) ^ p⁻¹ ≤ c * M := by
  intro P p c hp hc hS u M hu hcu hM η hη hηc hη0 hηs hη1 hae
  -- Step 1: testing the variation bound with `g = 0` gives `M ≥ 0`, hence `c M ≥ 0`
  have hM0 : 0 ≤ M := by
    simpa using hM (fun _ => 0) contDiff_const HasCompactSupport.zero fun _ => by simp
  have hcM : 0 ≤ c * M := mul_nonneg hc hM0
  -- Step 2: the mollifications `w_k = η_k * u` are `C¹` with compact support
  set w : ℕ → Euclid P → ℝ :=
    fun k => convolution (η k) u (ContinuousLinearMap.lsmul ℝ ℝ) volume
  have hwC : ∀ k, ContDiff ℝ 1 (w k) := fun k =>
    (hηc k).contDiff_convolution_left (ContinuousLinearMap.lsmul ℝ ℝ) (hη k) hu.locallyIntegrable
  have hwcs : ∀ k, HasCompactSupport (w k) := fun k =>
    (hηc k).convolution (ContinuousLinearMap.lsmul ℝ ℝ) hcu
  -- `ofReal (|t|^p) = ‖t‖ₑ^p`
  have henorm : ∀ t : ℝ, ENNReal.ofReal (|t| ^ p) = ‖t‖ₑ ^ p := fun t => by
    rw [Real.enorm_eq_ofReal_abs, ENNReal.ofReal_rpow_of_nonneg (abs_nonneg t) hp.le]
  -- Step 3: `∫ |Dw_k| ≤ M` and the Sobolev inequality give `∫ |w_k|^p ≤ (c M)^p`
  have hbound : ∀ k, ∫ z, |w k z| ^ p ≤ (c * M) ^ p := by
    intro k
    have hvar : ∫ z, ‖fderiv ℝ (w k) z‖ ≤ M :=
      Submission.codim1_rdo_dg_sp_mollify_variation P u M hu hcu hM (η k) (hη k) (hηc k)
        (hη0 k) (hηs k) (hη1 k)
    have h1 : (∫ z, |w k z| ^ p) ^ p⁻¹ ≤ c * M :=
      (hS (w k) (hwC k) (hwcs k)).trans (mul_le_mul_of_nonneg_left hvar hc)
    have ha : 0 ≤ ∫ z, |w k z| ^ p :=
      integral_nonneg fun z => Real.rpow_nonneg (abs_nonneg _) p
    calc ∫ z, |w k z| ^ p = ((∫ z, |w k z| ^ p) ^ p⁻¹) ^ p :=
          (Real.rpow_inv_rpow ha hp.ne').symm
      _ ≤ (c * M) ^ p := Real.rpow_le_rpow (Real.rpow_nonneg ha _) h1 hp.le
  -- Step 4: `|w_k|^p` is continuous with compact support, so `∫⁻ ‖w_k‖ₑ^p ≤ ofReal ((c M)^p)`
  have hlow : ∀ k, ∫⁻ x, ‖w k x‖ₑ ^ p ≤ ENNReal.ofReal ((c * M) ^ p) := by
    intro k
    have hint : Integrable fun z => |w k z| ^ p :=
      ((hwC k).continuous.abs.rpow_const fun _ => Or.inr hp.le).integrable_of_hasCompactSupport
        ((hwcs k).abs.rpow_const hp.ne')
    calc ∫⁻ x, ‖w k x‖ₑ ^ p = ∫⁻ x, ENNReal.ofReal (|w k x| ^ p) :=
          lintegral_congr fun x => (henorm (w k x)).symm
      _ = ENNReal.ofReal (∫ z, |w k z| ^ p) :=
          (ofReal_integral_eq_lintegral_ofReal hint
            (Eventually.of_forall fun z => Real.rpow_nonneg (abs_nonneg _) p)).symm
      _ ≤ ENNReal.ofReal ((c * M) ^ p) := ENNReal.ofReal_le_ofReal (hbound k)
  -- Step 5: Fatou's lemma along `w_k → u` a.e.
  have hfatou : ∫⁻ x, ‖u x‖ₑ ^ p ≤ ENNReal.ofReal ((c * M) ^ p) :=
    calc ∫⁻ x, ‖u x‖ₑ ^ p = ∫⁻ x, liminf (fun k => ‖w k x‖ₑ ^ p) atTop := by
          refine lintegral_congr_ae ?_
          filter_upwards [hae] with x hx
          exact ((hx.enorm.ennrpow_const p).liminf_eq).symm
      _ ≤ liminf (fun k => ∫⁻ x, ‖w k x‖ₑ ^ p) atTop :=
          lintegral_liminf_le fun k => (hwC k).continuous.measurable.enorm.pow_const p
      _ ≤ ENNReal.ofReal ((c * M) ^ p) := liminf_le_of_frequently_le' (Frequently.of_forall hlow)
  -- Step 6: `∫ |u|^p = (∫⁻ ‖u‖ₑ^p).toReal ≤ (c M)^p`; take the `1/p` power
  have hup : 0 ≤ ∫ z, |u z| ^ p := integral_nonneg fun z => Real.rpow_nonneg (abs_nonneg _) p
  have hU : ∫ z, |u z| ^ p ≤ (c * M) ^ p := by
    rw [integral_eq_lintegral_of_nonneg_ae
      (Eventually.of_forall fun z => Real.rpow_nonneg (abs_nonneg (u z)) p)
      ((continuous_abs.rpow_const fun _ => Or.inr hp.le).comp_aestronglyMeasurable
        hu.aestronglyMeasurable)]
    refine ENNReal.toReal_le_of_le_ofReal (Real.rpow_nonneg hcM p) ?_
    calc ∫⁻ x, ENNReal.ofReal (|u x| ^ p) = ∫⁻ x, ‖u x‖ₑ ^ p :=
          lintegral_congr fun x => henorm (u x)
      _ ≤ ENNReal.ofReal ((c * M) ^ p) := hfatou
  calc (∫ z, |u z| ^ p) ^ p⁻¹ ≤ ((c * M) ^ p) ^ p⁻¹ :=
        Real.rpow_le_rpow hup hU (inv_nonneg.2 hp.le)
    _ = c * M := Real.rpow_rpow_inv hcM hp.ne'

/-- **The Sobolev inequality for `ζ 1_F`** (Simon Ch. 3, proof of Theorem 4.3 (De Giorgi),
chapter-03.txt lines 689–712: `(∫ (ζ 1_F)^{(n+1)/n})^{n/(n+1)} ≤ c ∫ |D(ζ 1_F)| ≤
c (∫ ζ dμ + ∫_F |Dζ|)`, with the mollification Lemma Ch. 2, 2.5).  For `m ≥ 1` the exponent
`p = (m+1)/m` is the Hölder conjugate of `dim ℝ^{m+1} = m+1`, so Mathlib's Gagliardo–Nirenberg–
Sobolev inequality gives the constant `c`.  Given the Gauss–Green identity, `u = 1_F ζ` has
variation at most `M = ∫ ζ dμ + ∫_F |Dζ|`; the normalized bump functions of radius `1/(k+1)` are
even, nonnegative, unit-mass `C¹` kernels whose mollifications converge to `u` a.e. (Lebesgue
differentiation), and the Sobolev bound passes from the mollifications to `u`. -/
theorem codim1_rdo_dg_sobolev_perimeter : ∀ (m : ℕ), 1 ≤ m → ∃ c : ℝ, 0 < c ∧ ∀ (D F : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)), IsOpen D → MeasurableSet F → μ Dᶜ = 0 → (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μ K ≠ ∞) → Measurable ν → (∀ z, ‖ν z‖ = 1) → (∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ z in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -∫ z, inner ℝ (φ z) (ν z) ∂μ) → ∀ ζ : Euclid (m + 1) → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ → tsupport ζ ⊆ D → (∀ z, 0 ≤ ζ z) → (∫ z in F, ζ z ^ ((m + 1 : ℝ) / m)) ^ ((m : ℝ) / (m + 1)) ≤ c * (∫ z, ζ z ∂μ + ∫ z in F, ‖fderiv ℝ ζ z‖) := by
  intro m hm
  -- Step 0: `p = (m+1)/m` is the Hölder conjugate of `m + 1`; GNS gives the constant `c`
  have hm0 : (0 : ℝ) < m := by exact_mod_cast hm
  have hp : (0 : ℝ) < (m + 1 : ℝ) / m := by positivity
  have hHC : Real.HolderConjugate (Module.finrank ℝ (Euclid (m + 1)) : ℝ) ((m + 1 : ℝ) / m) := by
    rw [finrank_euclideanSpace_fin]
    refine ⟨?_, by positivity, hp⟩
    push_cast
    field_simp
    ring
  obtain ⟨c, hc, hS⟩ := Submission.codim1_rdo_dg_sp_gns_real_of_lintegral (m + 1)
    ((m + 1 : ℝ) / m) (lintegralPowLePowLIntegralFDerivConst volume ((m + 1 : ℝ) / m)) hp
    fun w hw hwc => lintegral_pow_le_pow_lintegral_fderiv volume hw hwc hHC
  refine ⟨c, hc, ?_⟩
  intro D F μ ν hD hF hμD hμK hν hν1 hGG ζ hζ hζc hζD hζ0
  -- Step 1: `u = 1_F ζ` is integrable with compact support; its variation bound `M` is
  -- `gauss_green_variation` (used below)
  have hu : Integrable (F.indicator ζ) :=
    (hζ.continuous.integrable_of_hasCompactSupport hζc).indicator hF
  have huc : HasCompactSupport (F.indicator ζ) :=
    hζc.mono fun z hz h0 => hz (by simp [h0])
  -- Step 2: even, nonnegative, unit-mass `C¹` kernels of radius `1/(k+1)`
  let φ : ℕ → ContDiffBump (0 : Euclid (m + 1)) := fun k =>
    { rIn := 1 / ((k : ℝ) + 1) / 2
      rOut := 1 / ((k : ℝ) + 1)
      rIn_pos := by positivity
      rIn_lt_rOut := by
        have : (0 : ℝ) < 1 / ((k : ℝ) + 1) := by positivity
        linarith }
  have hφ0 : Tendsto (fun k => (φ k).rOut) atTop (𝓝 0) :=
    tendsto_one_div_add_atTop_nhds_zero_nat
  have hφK : ∀ᶠ k in atTop, (φ k).rOut ≤ 2 * (φ k).rIn :=
    Eventually.of_forall fun k => by
      change 1 / ((k : ℝ) + 1) ≤ 2 * (1 / ((k : ℝ) + 1) / 2)
      linarith
  -- Lebesgue differentiation: the mollifications converge to `u` almost everywhere
  have hae := ContDiffBump.ae_convolution_tendsto_right_of_locallyIntegrable (μ := volume)
    hφ0 hφK hu.locallyIntegrable
  -- Steps 3–4: GNS for the mollifications and passage to the limit
  have key := Submission.codim1_rdo_dg_sp_sobolev_limit (m + 1) ((m + 1 : ℝ) / m) c hp hc.le hS
    (F.indicator ζ) (∫ z, ζ z ∂μ + ∫ z in F, ‖fderiv ℝ ζ z‖) hu huc
    (fun g hg hgc hg1 => Submission.codim1_rdo_dg_sp_gauss_green_variation (m + 1) D F μ ν hD hF
      hμD hμK hν hν1 hGG ζ hζ hζc hζD hζ0 g hg hgc hg1)
    (fun k => (φ k).normed volume) (fun k => (φ k).contDiff_normed)
    (fun k => (φ k).hasCompactSupport_normed) (fun k => (φ k).nonneg_normed)
    (fun k => (φ k).normed_neg) (fun k => (φ k).integral_normed) hae
  -- Conclusion: `∫ |1_F ζ|^p = ∫_F ζ^p` and `p⁻¹ = m/(m+1)`
  have hint : ∫ z, |F.indicator ζ z| ^ ((m + 1 : ℝ) / m) = ∫ z in F, ζ z ^ ((m + 1 : ℝ) / m) := by
    rw [← integral_indicator hF]
    congr 1
    ext z
    by_cases hz : z ∈ F
    · simp [hz, abs_of_nonneg (hζ0 z)]
    · simp [hz, Real.zero_rpow hp.ne']
  rwa [hint, inv_div] at key

/-- **Lower volume density** of `F` and of its complement (Simon Ch. 3, proof of Theorem 4.3,
(10)–(11)) at a point `y` where the normal averages of the Gauss–Green measure `μ` tend to a unit
vector `v`.  `codim1_rdo_dg_cutoff_estimates` gives `ρ₁ > 0` and `C₁ ≥ 0` with `B̄_{ρ₁}(y) ⊆ D` and
the annular bounds `δ μ(B̄_ρ(y)) ≤ C₁ L(F ∩ (B_{ρ+δ}(y) \ B̄_ρ(y)))` and
`δ μ(B̄_ρ(y)) ≤ C₁ L((B_{ρ+δ}(y) \ B̄_ρ(y)) \ F)` for `ρ + δ < ρ₁`, and
`codim1_rdo_dg_sobolev_perimeter` gives `c_S > 0` with
`(∫_F ζ^{(m+1)/m})^{m/(m+1)} ≤ c_S (∫ ζ dμ + ∫_F |Dζ|)`.  Since `v ≠ 0`, every closed ball about
`y` has positive `μ`-measure, and `μ(B̄_{ρ₁}(y)) < ∞` by local finiteness.  The finite-difference
isoperimetric inequality and its discrete integration (`codim1_rdo_dg_vdl_one_sided_density`)
give `L(F ∩ B_ρ(y)) ≥ c₁ ρ^{m+1}` for `ρ < ρ₁` (printed (10)).  Since `∫ div φ = 0`, `Fᶜ`
satisfies the Gauss–Green identity with normal `−ν`, so the Sobolev inequality and the annular
bound hold for `Fᶜ` as well, and the same argument gives `L(B_ρ(y) \ F) ≥ c₂ ρ^{m+1}`
(printed (11)).  Take `c = min c₁ c₂` and `ρ₂ = ρ₁`. -/
theorem codim1_rdo_dg_volume_density_lower : ∀ (m : ℕ) (D F : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)) (y v : Euclid (m + 1)), 1 ≤ m → IsOpen D → MeasurableSet F → μ Dᶜ = 0 → (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μ K ≠ ∞) → Measurable ν → (∀ z, ‖ν z‖ = 1) → (∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ z in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -∫ z, inner ℝ (φ z) (ν z) ∂μ) → y ∈ D → ‖v‖ = 1 → Tendsto (fun ρ : ℝ => (μ (closedBall y ρ)).toReal⁻¹ • ∫ z in closedBall y ρ, ν z ∂μ) (𝓝[>] 0) (𝓝 v) → ∃ c ρ₂ : ℝ, 0 < c ∧ 0 < ρ₂ ∧ ∀ ρ : ℝ, 0 < ρ → ρ < ρ₂ → ENNReal.ofReal (c * ρ ^ (m + 1)) ≤ volume (F ∩ ball y ρ) ∧ ENNReal.ofReal (c * ρ ^ (m + 1)) ≤ volume (ball y ρ \ F) := by
  intro m D F μ ν y v hm hD hF hμD hμK hν hν1 hGG hy hv hT
  -- step 1: `ρ₁`, `C₁` and the annular bounds (a) for `F` and (b) for its complement
  obtain ⟨ρ₁, C₁, hρ₁, hC₁, hρ₁D, hann, -⟩ :=
    Submission.codim1_rdo_dg_cutoff_estimates m D F μ ν y v hD hF hμD hμK hν hν1 hGG hy hv hT
  -- step 2: the Sobolev inequality, with a constant `c_S` independent of `(D, F, μ, ν)`
  obtain ⟨cS, hcS, hS⟩ := Submission.codim1_rdo_dg_sobolev_perimeter m hm
  -- step 3: every closed ball about `y` has positive mass, and `μ(B̄_{ρ₁}(y)) < ∞`
  have hv0 : v ≠ 0 := norm_ne_zero_iff.mp (by rw [hv]; exact one_ne_zero)
  have hpos : ∀ r : ℝ, 0 < r → μ (closedBall y r) ≠ 0 :=
    Submission.codim1_rdo_dg_vdl_measure_closedBall_ne_zero (m + 1) μ ν y v hv0 hT
  have hfin : μ (closedBall y ρ₁) ≠ ∞ := hμK _ (isCompact_closedBall y ρ₁) hρ₁D
  -- step 4: the lower bound for `F` (printed (10))
  obtain ⟨c₁, hc₁, h₁⟩ := Submission.codim1_rdo_dg_vdl_one_sided_density m D F μ y ρ₁ C₁ cS hm
    hF hcS hC₁ hρ₁D hfin hpos (hS D F μ ν hD hF hμD hμK hν hν1 hGG)
    fun ρ δ hρ hδ hρδ => (hann ρ δ hρ hδ hρδ).1
  -- step 5: `Fᶜ` satisfies the Gauss–Green identity with normal `−ν`, so the Sobolev inequality
  -- holds for `Fᶜ`; with (b) this gives the lower bound for `Fᶜ` (printed (11))
  have hGGc := Submission.codim1_rdo_dg_vdl_gauss_green_compl (m + 1) D F μ ν hF hGG
  obtain ⟨c₂, hc₂, h₂⟩ := Submission.codim1_rdo_dg_vdl_one_sided_density m D Fᶜ μ y ρ₁ C₁ cS hm
    hF.compl hcS hC₁ hρ₁D hfin hpos
    (hS D Fᶜ μ (fun z => -ν z) hD hF.compl hμD hμK hν.neg
      (fun z => (norm_neg (ν z)).trans (hν1 z)) hGGc)
    fun ρ δ hρ hδ hρδ => by
      rw [← Set.sdiff_eq_compl_inter]
      exact (hann ρ δ hρ hδ hρδ).2
  -- step 6: `c = min c₁ c₂` and `ρ₂ = ρ₁`, using `B_ρ(y) \ F = Fᶜ ∩ B_ρ(y)`
  refine ⟨min c₁ c₂, ρ₁, lt_min hc₁ hc₂, hρ₁, fun ρ hρ hρρ₁ => ⟨?_, ?_⟩⟩
  · exact (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right (min_le_left c₁ c₂)
      (pow_nonneg hρ.le _))).trans (h₁ ρ hρ hρρ₁)
  · rw [Set.sdiff_eq_compl_inter]
    exact (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right (min_le_right c₁ c₂)
      (pow_nonneg hρ.le _))).trans (h₂ ρ hρ hρρ₁)

/-- The tangent space of the translate `{z | z + a ∈ Q} = Q − a` at any of its points `y` is `Q`:
slopes `t⁻¹(γ t − γ 0)` of a curve in the translate lie in the closed subspace `Q` and tend to
`γ'(0)`, and the line `t ↦ y + t • v` realizes each `v ∈ Q` as a velocity. -/
theorem codim1_zsl_op_translate_tangentSpace_eq : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (a y : Euclid P), y + a ∈ Q → tangentSpace {z | z + a ∈ Q} y = (Q : Set (Euclid P)) := by
  intro P Q a y hy
  -- Step 1: `Q` is finite-dimensional, hence closed.
  have hQ : IsClosed (Q : Set (Euclid P)) := Q.closed_of_finiteDimensional
  ext v
  constructor
  · -- Step 2: the slopes `t⁻¹(γ t − γ 0)` lie in `Q` for `t ∈ (−1, 1)` and tend to `v`.
    rintro ⟨γ, -, hγA, hγ0, hγv⟩
    have hIoo : Ioo (-1 : ℝ) 1 ∈ 𝓝[≠] (0 : ℝ) :=
      nhdsWithin_le_nhds (Ioo_mem_nhds (by norm_num) (by norm_num))
    refine hQ.mem_of_tendsto (hasDerivAt_iff_tendsto_slope.mp hγv) ?_
    filter_upwards [hIoo] with t ht
    have h1 : γ t + a ∈ Q := hγA ht
    have h2 : γ 0 + a ∈ Q := hγ0 ▸ hy
    rw [slope_def_module]
    exact Q.smul_mem _ (by simpa using Q.sub_mem h1 h2)
  · -- Step 3: the line `t ↦ y + t • v` witnesses `v ∈ tangentSpace {z | z + a ∈ Q} y`.
    intro hv
    refine ⟨fun t => y + t • v, ?_, ?_, by simp, ?_⟩
    · exact (contDiff_const.add (contDiff_id.smul contDiff_const)).contDiffOn
    · intro t _
      show y + t • v + a ∈ Q
      rw [add_right_comm]
      exact Q.add_mem hy (Q.smul_mem t hv)
    · simpa using ((hasDerivAt_id (0 : ℝ)).smul_const v).const_add y

end Submission

/-- **Blow-up of `F` at `y` is the half-space `{⟨w, v⟩ > 0}`** (Simon Ch. 3, proof of Theorem 4.3
(De Giorgi), printed (7)–(11) and the paragraph "Now given any sequence `λ_k ↓ 0` …",
chapter-03.txt lines 652–744; for the inward normal the limit is `{⟨w, v⟩ > 0}`, the OCR's
inequality being reversed).  Given `r_k ↓ 0`, the rescaled sets `F_{y,r_k}` have locally bounded
perimeter (`μ(B̄_ρ(y)) ≤ C₁ ρ^m`), so a subsequence converges in `L¹_loc` to some `F₀`; since the
normal averages tend to `v`, `F₀` has vanishing tangential and nonpositive normal distributional
derivative, hence is (a.e.) `∅`, `ℝ^{m+1}` or `{⟨w, v⟩ > c}`; the scale-invariant two-sided volume
bounds force `c = 0`.  The limit being independent of the sequence, the whole family converges. -/
theorem Submission.codim1_rdo_dg_blowup_halfspace : ∀ (m : ℕ) (D F : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)) (y v : Euclid (m + 1)), 1 ≤ m → IsOpen D → MeasurableSet F → μ Dᶜ = 0 → (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μ K ≠ ∞) → Measurable ν → (∀ z, ‖ν z‖ = 1) → (∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ z in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -∫ z, inner ℝ (φ z) (ν z) ∂μ) → y ∈ D → ‖v‖ = 1 → Tendsto (fun ρ : ℝ => (μ (closedBall y ρ)).toReal⁻¹ • ∫ z in closedBall y ρ, ν z ∂μ) (𝓝[>] 0) (𝓝 v) → ∀ R : ℝ, Tendsto (fun r : ℝ => volume (symmDiff ((fun w => y + r • w) ⁻¹' F) {w | 0 < inner ℝ w v} ∩ ball (0 : Euclid (m + 1)) R)) (𝓝[>] 0) (𝓝 0) := by
  intro m D F μ ν y v hm hD hF hμD hμK hν hν1 hGG hy hv hA R
  -- step 1: `μ(B̄_ρ(y)) ≤ C₁ ρ^m` for `ρ < ρ₁`, and `L(F ∩ B_ρ(y)), L(B_ρ(y) \ F) ≥ c₂ ρ^{m+1}`
  -- for `ρ < ρ₂`
  obtain ⟨ρ₁, C₁, hρ₁, hC₁, hball, -, hmass⟩ :=
    Submission.codim1_rdo_dg_cutoff_estimates m D F μ ν y v hD hF hμD hμK hν hν1 hGG hy hv hA
  obtain ⟨c₂, ρ₂, hc₂, hρ₂, hvol⟩ :=
    Submission.codim1_rdo_dg_volume_density_lower m D F μ ν y v hm hD hF hμD hμK hν hν1 hGG hy
      hv hA
  -- step 7: it suffices that every sequence `r_k → 0⁺` has a subsequence along which the
  -- quantity tends to `0`
  apply Filter.tendsto_of_subseq_tendsto
  intro rs hrs
  have hrs0 : Tendsto rs atTop (𝓝 0) := hrs.mono_right nhdsWithin_le_nhds
  have hrs_pos : ∀ᶠ k in atTop, 0 < rs k := hrs.eventually self_mem_nhdsWithin
  set Fs : ℕ → Set (Euclid (m + 1)) := fun k => (fun w => y + rs k • w) ⁻¹' F with hFs_def
  have hFs : ∀ k, MeasurableSet (Fs k) := fun k =>
    (measurable_const.add (measurable_id.const_smul (rs k))) hF
  -- step 4: perimeter bounds `C₁ R^m` on `B_R`, hence an `L¹_loc` limit `F₀` of a subsequence
  have hper : ∀ R' : ℝ, 0 < R' → ∃ C : ℝ, ∀ᶠ k in atTop, ∀ g : Euclid (m + 1) → Euclid (m + 1),
      ContDiff ℝ 1 g → HasCompactSupport g → tsupport g ⊆ ball (0 : Euclid (m + 1)) R' →
      (∀ z, ‖g z‖ ≤ 1) →
      ∫ z in Fs k, LinearMap.trace ℝ (Euclid (m + 1))
        (fderiv ℝ g z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) ≤ C := by
    intro R' hR'
    refine ⟨C₁ * R' ^ m, ?_⟩
    have h1 : ∀ᶠ k in atTop, rs k * R' < ρ₁ := by
      have : Tendsto (fun k => rs k * R') atTop (𝓝 0) := by simpa using hrs0.mul_const R'
      exact this.eventually (gt_mem_nhds hρ₁)
    filter_upwards [hrs_pos, h1] with k hk1 hk2
    intro g hg hgc hgs hg1
    exact Submission.codim1_rdo_dg_bh_perimeter_bound m D F μ ν y ρ₁ C₁ hF hν hν1 hGG hρ₁ hC₁
      hball hmass R' (rs k) hR' hk1 hk2 g hg hgc hgs hg1
  obtain ⟨ψ, F₀, hψ, hF₀, hconv⟩ := Submission.codim1_rdo_dg_bv_set_compactness m Fs hFs hper
  refine ⟨ψ, ?_⟩
  have hrsψ : Tendsto (fun j => rs (ψ j)) atTop (𝓝[>] 0) := hrs.comp hψ.tendsto_atTop
  obtain ⟨hint, hin, hout⟩ :=
    Submission.codim1_rdo_dg_bh_l1loc_transfer m (fun j => Fs (ψ j)) F₀ (fun j => hFs _) hF₀ hconv
  -- step 5: `F₀` has vanishing tangential and nonpositive normal derivative
  have htan : ∀ ζ : Euclid (m + 1) → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ →
      ∀ w : Euclid (m + 1), inner ℝ w v = 0 → ∫ z in F₀, fderiv ℝ ζ z w = 0 := by
    intro ζ hζ hζc w hw
    have h1 := (Submission.codim1_rdo_dg_bh_tangential_vanish m D F μ ν y v ρ₁ C₁ hF hν hν1 hGG hv
      hA hρ₁ hC₁ hball hmass ζ hζ hζc w hw).comp hrsψ
    have h2 := hint (fun z => fderiv ℝ ζ z w)
      ((hζ.continuous_fderiv one_ne_zero).clm_apply continuous_const) (hζc.fderiv_apply (𝕜 := ℝ) w)
    exact tendsto_nhds_unique h2 h1
  have hnor : ∀ ζ : Euclid (m + 1) → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ →
      (∀ z, 0 ≤ ζ z) → ∫ z in F₀, fderiv ℝ ζ z v ≤ 0 := by
    intro ζ hζ hζc hζ0
    have h2 := hint (fun z => fderiv ℝ ζ z v)
      ((hζ.continuous_fderiv one_ne_zero).clm_apply continuous_const) (hζc.fderiv_apply (𝕜 := ℝ) v)
    refine le_of_forall_pos_le_add fun δ hδ => ?_
    have h1 := Submission.codim1_rdo_dg_bh_normal_limsup m D F μ ν y v ρ₁ C₁ hF hν hν1 hGG hv hA
      hρ₁ hC₁ hball hmass ζ hζ hζc hζ0 δ hδ
    have h3 : ∀ᶠ j in atTop, ∫ z in Fs (ψ j), fderiv ℝ ζ z v ≤ δ := hrsψ.eventually h1
    simpa using le_of_tendsto h2 h3
  -- so `F₀` is a.e. `∅`, `ℝ^{m+1}` or `{⟨w, v⟩ > c}`
  have htri := Submission.codim1_rdo_dg_halfspace_rigidity m F₀ v hv hF₀ htan hnor
  -- step 6: the scale-invariant two-sided volume bounds pass to the limit, which forces `c = 0`
  have hpos : ∀ s : ℝ, 0 < s → 0 < volume (F₀ ∩ ball (0 : Euclid (m + 1)) s) ∧
      0 < volume (ball (0 : Euclid (m + 1)) s \ F₀) := by
    intro s hs
    have hpos' : ∀ᶠ j in atTop, 0 < rs (ψ j) := hrsψ.eventually self_mem_nhdsWithin
    have hsmall : ∀ᶠ j in atTop, rs (ψ j) * s < ρ₂ := by
      have : Tendsto (fun j => rs (ψ j) * s) atTop (𝓝 0) := by
        simpa using (hrsψ.mono_right nhdsWithin_le_nhds).mul_const s
      exact this.eventually (gt_mem_nhds hρ₂)
    have hlow : ∀ᶠ j in atTop,
        ENNReal.ofReal (c₂ * s ^ (m + 1)) ≤ volume (Fs (ψ j) ∩ ball (0 : Euclid (m + 1)) s) ∧
          ENNReal.ofReal (c₂ * s ^ (m + 1)) ≤ volume (ball (0 : Euclid (m + 1)) s \ Fs (ψ j)) := by
      filter_upwards [hpos', hsmall] with j h1 h2
      exact Submission.codim1_rdo_dg_bh_rescaled_volume_lower m F y c₂ ρ₂ hF hvol s (rs (ψ j)) hs
        h1 h2
    have hc : 0 < ENNReal.ofReal (c₂ * s ^ (m + 1)) :=
      ENNReal.ofReal_pos.mpr (mul_pos hc₂ (pow_pos hs _))
    exact ⟨lt_of_lt_of_le hc (ge_of_tendsto (hin s) (hlow.mono fun j h => h.1)),
      lt_of_lt_of_le hc (ge_of_tendsto (hout s) (hlow.mono fun j h => h.2))⟩
  have hH := Submission.codim1_rdo_dg_bh_offset_zero m F₀ v hv hpos htri
  -- step 7: `L((F_{r_{ψ j}} Δ H) ∩ B_R) ≤ L((F_{r_{ψ j}} Δ F₀) ∩ B_R) + L(F₀ Δ H) → 0`
  have hle : ∀ j, volume (symmDiff (Fs (ψ j)) {w | 0 < inner ℝ w v} ∩ ball (0 : Euclid (m + 1)) R) ≤
      volume (symmDiff (Fs (ψ j)) F₀ ∩ ball (0 : Euclid (m + 1)) R) := by
    intro j
    calc volume (symmDiff (Fs (ψ j)) {w | 0 < inner ℝ w v} ∩ ball (0 : Euclid (m + 1)) R)
        ≤ volume (symmDiff (Fs (ψ j)) F₀ ∩ ball (0 : Euclid (m + 1)) R ∪
            symmDiff F₀ {w | 0 < inner ℝ w v}) := by
          apply measure_mono
          intro x hx
          rcases symmDiff_triangle (Fs (ψ j)) F₀ {w | 0 < inner ℝ w v} hx.1 with h | h
          · exact Or.inl ⟨h, hx.2⟩
          · exact Or.inr h
      _ ≤ volume (symmDiff (Fs (ψ j)) F₀ ∩ ball (0 : Euclid (m + 1)) R) +
            volume (symmDiff F₀ {w | 0 < inner ℝ w v}) :=
          measure_union_le _ _
      _ = volume (symmDiff (Fs (ψ j)) F₀ ∩ ball (0 : Euclid (m + 1)) R) := by rw [hH, add_zero]
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds (hconv R) (fun j => by simp) hle

/-- **Blow-ups of the Gauss–Green measure converge to `Hᵐ⌞ν(y)ᗮ`** (Simon Ch. 3, proof of
Theorem 4.3 (De Giorgi), 4.3 (†), chapter-03.txt lines 734–746).  By `normal_average_ae`,
`μ`-a.e. `y` lies in `D` and has normal averages `A(ρ) → ν(y)`; fix such `y` and put
`v = ν(y)`.  `cutoff_estimates` gives `B̄_{ρ₁}(y) ⊆ D` and `μ(B̄_ρ(y)) ≤ C ρᵐ`,
`blowup_halfspace` gives `F_{y,r} → {⟨w, v⟩ > 0}` in `L¹_loc`, and `hyperplane_param` shows
that `τ = Hᵐ⌞vᗮ` is finite on balls.  By `continuous_extension` it suffices to treat `C¹`
test functions `g`; by `normal_defect` it suffices to show
`r⁻ᵐ ∫ g(r⁻¹(z − y)) ⟨v, ν(z)⟩ dμ(z) → ∫_{vᗮ} g dHᵐ`, which is the vector convergence (3a)
(`vector_convergence`) for the field `g v`, since `⟨g v, ν⟩ = g ⟨v, ν⟩` and `⟨g v, v⟩ = g`. -/
theorem Submission.codim1_rdo_dg_tangent_measure_ae : ∀ (m : ℕ) (D F : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)), 1 ≤ m → IsOpen D → MeasurableSet F → μ Dᶜ = 0 → (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μ K ≠ ∞) → Measurable ν → (∀ z, ‖ν z‖ = 1) → (∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ z in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -∫ z, inner ℝ (φ z) (ν z) ∂μ) → ∀ᵐ y ∂μ, ∀ f : Euclid (m + 1) → ℝ, Continuous f → HasCompactSupport f → Tendsto (fun r : ℝ => (r ^ m)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) ∂μ) (𝓝[>] 0) (𝓝 (∫ z in ((Submodule.span ℝ {ν y})ᗮ : Set (Euclid (m + 1))), f z ∂μHE[m])) := by
  intro m D F μ ν hm hD hF hDc hloc hνm hν1 hGG
  -- Step 1: good points `y` (`y ∈ D`, `A(ρ) → ν(y)`), with `v = ν(y)`
  filter_upwards [Submission.codim1_rdo_dg_normal_average_ae m D μ ν hD hDc hloc hνm hν1]
    with y hy
  obtain ⟨hyD, hA⟩ := hy
  have hv : ‖ν y‖ = 1 := hν1 y
  obtain ⟨ρ₁, C, hρ₁, hC, hball, -, hdens⟩ :=
    Submission.codim1_rdo_dg_cutoff_estimates m D F μ ν y (ν y) hD hF hDc hloc hνm hν1 hGG
      hyD hv hA
  have hblow := Submission.codim1_rdo_dg_blowup_halfspace m D F μ ν y (ν y) hm hD hF hDc hloc
    hνm hν1 hGG hyD hv hA
  -- `τ = Hᵐ⌞ν(y)ᗮ = ι_# Lᵐ` is finite on closed balls
  have hv0 : ν y ≠ 0 := by
    intro h
    rw [h, norm_zero] at hv
    exact zero_ne_one hv
  obtain ⟨ι, -, hmap⟩ := Submission.codim1_rdo_dg_tma_hyperplane_param m (ν y) hv0
  have hfin : ∀ R : ℝ, ((μHE[m] : Measure (Euclid (m + 1))).restrict
      ((Submodule.span ℝ {ν y})ᗮ : Set (Euclid (m + 1)))) (closedBall (0 : Euclid (m + 1)) R)
      ≠ ∞ := by
    intro R
    rw [hmap, Measure.map_apply ι.continuous.measurable measurableSet_closedBall]
    have hpre : (ι : Euclid m → Euclid (m + 1)) ⁻¹' closedBall 0 R = closedBall 0 R := by
      ext x
      simp [ι.norm_map]
    rw [hpre]
    exact measure_closedBall_lt_top.ne
  -- Step 5: it suffices to treat `C¹` test functions
  intro f hf hfc
  refine Submission.codim1_rdo_dg_tma_continuous_extension (m + 1) m μ _ y ρ₁ C hρ₁ hC hdens hfin
    ?_ f hf hfc
  -- Step 4: it suffices to treat the integrals weighted by `⟨ν(y), ν⟩`
  intro g hg hgc
  refine Submission.codim1_rdo_dg_tma_normal_defect (m + 1) m μ ν y (ν y) ρ₁ C _ g hνm hν1 hv hρ₁
    hC hdens hA hg.continuous hgc ?_
  -- Step 3: the vector convergence (3a) for the field `g ν(y)`
  have key := Submission.codim1_rdo_dg_tma_vector_convergence m D F μ ν y (ν y) ρ₁ hF hGG hρ₁
    hball hv hblow (fun w => g w • ν y) (hg.smul contDiff_const) hgc.smul_right
  simpa [real_inner_smul_left, real_inner_self_eq_norm_sq, hv] using key

/-- **De Giorgi's structure theorem**, Gauss–Green form (Simon Ch. 3, 4.1–4.3).  Let `m ≥ 1`,
`D ⊆ ℝ^{m+1}` open and `F` Borel with locally finite perimeter in `D`.  Then there are a
countably `m`-rectifiable Borel set `B ⊆ D`, with `Hᵐ(B ∩ K) < ∞` for compact `K ⊆ D`, and a
Borel `ν`, with `|ν| = 1` on `B` and approximate tangent space `ν(y)^⊥` at `Hᵐ`-a.e. `y ∈ B`,
such that `∫_F div φ = −∫_B ⟨φ, ν⟩ dHᵐ` for `φ ∈ C¹_c(D; ℝ^{m+1})`.  The Riesz representation
of the perimeter functional gives a Gauss–Green pair `(μ, ν)` (4.1).  At `μ`-a.e. `y` the
blow-ups of `μ` converge to `Hᵐ⌞ν(y)^⊥` (4.3 (†)).  Since countably `m`-rectifiable sets of finite
measure have `Hᵐ`-density one a.e., this gives `μ = Hᵐ⌞B`, with approximate tangent planes
`ν^⊥`, and then (4.1) is the Gauss–Green formula over `B`. -/
theorem Submission.codim1_rdo_de_giorgi_gauss_green : ∀ (m : ℕ) (D F : Set (Euclid (m + 1))), 1 ≤ m → IsOpen D → MeasurableSet F → (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → ∃ C : ℝ, ∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ → tsupport φ ⊆ K → (∀ y, ‖φ y‖ ≤ 1) → ∫ y in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ y : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) ≤ C) → ∃ (B : Set (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)), MeasurableSet B ∧ B ⊆ D ∧ CountablyRectifiable m B ∧ (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μHE[m] (B ∩ K) ≠ ∞) ∧ Measurable ν ∧ (∀ y ∈ B, ‖ν y‖ = 1) ∧ (∀ᵐ y ∂(μHE[m].restrict B), HasApproximateTangentSpaceAt m B y (Submodule.span ℝ {ν y})ᗮ) ∧ ∀ φ : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ y in F, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ φ y : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) = -∫ y in B, inner ℝ (φ y) (ν y) ∂μHE[m] := by
  intro m D F hm hD hF hper
  -- Steps 1–2: the Gauss–Green pair `(μ, ν)` of (4.1), `|ν| ≡ 1`
  obtain ⟨μ, ν, hμD, hμK, hν, hν1, hGG⟩ :=
    Submission.codim1_rdo_dg_gauss_green_measure m D F hD hF hper
  -- Steps 3–4: at `μ`-a.e. `y` the blow-ups of `μ` converge to `Hᵐ⌞ν(y)^⊥` (4.3 (†))
  have htan :=
    Submission.codim1_rdo_dg_tangent_measure_ae m D F μ ν hm hD hF hμD hμK hν hν1 hGG
  -- Steps 5–8: `μ = Hᵐ⌞B`, using `Hᵐ`-density one of rectifiable sets (`P = m + 1`, `n = m`)
  obtain ⟨B, hB, hBD, hBrect, rfl, hBtan⟩ :=
    Submission.codim1_rdo_dg_measure_eq_hausdorff m D μ ν hm hD hμD hμK hν hν1 htan
      fun S hS hSrect hSfin =>
        Submission.codim1_rdo_rectifiable_ae_density_one (m + 1) m S hm hS hSrect hSfin
  -- Step 9: `Hᵐ(B ∩ K) = μ(K) < ∞`, and (4.1) for `μ = Hᵐ⌞B` is the Gauss–Green formula
  refine ⟨B, ν, hB, hBD, hBrect, fun K hK hKD => ?_, hν, fun y _ => hν1 y, hBtan, hGG⟩
  rw [inter_comm, ← Measure.restrict_apply' hB]
  exact hμK K hK hKD

/-- **Locally finite perimeter of the chart region** (Simon Ch. 6, 2.35; the chart step of the
local unit representation in the proof of 7.5.8).  Let `G(v) = x + ιv + u(v)` on `D = B_{δ₁}(0)`
and `F = D ∩ G⁻¹(E)`.  `F` is Borel: `G` is continuous on the open ball `D`, so
`F = D ∩ G̃⁻¹(E)` for the Borel map `G̃ = D.piecewise G x`.  Let `K̂ = B̄_{δ₁+δ₂}(x)`, a compact
subset of `U`.  For an integer multiplicity representation `R` of `T`,
`M_{K̂}(T) ≤ μ_R(K̂) < ∞`.  Given `φ ∈ C^∞_c` with `spt φ ⊆ K ⊆ D` and `|φ| ≤ 1`, the test form
`ω_φ` of `codim1_lur_chart_test_form_exists` is supported in `Z ∩ K̂` and has
`|ω_φ| ≤ (n+1)! √(Pⁿ)`.  Its pull-back field is `φ`, so the chart divergence formula gives
`∫_F div φ = T(ω_φ) ≤ |T(ω_φ)| ≤ (n+1)! √(Pⁿ) M_{K̂}(T)`, a bound independent of `φ`. -/
theorem Submission.codim1_lur_chart_locally_finite_perimeter : ∀ (P n : ℕ) (U N E : Set (Euclid P)) (ξN : Euclid P → MultiVector P (n + 1)) (T : GeometricCurrentOn U n) (x : Euclid P) (ι : Euclid (n + 1) →ₗᵢ[ℝ] Euclid P) (u : Euclid (n + 1) → Euclid P) (δ₁ δ₂ : ℝ), MeasurableSet E → E ⊆ N ∩ U → IsBoundaryOfRegion T E ξN → IsIntegerMultiplicity T → 0 < δ₁ → 0 < δ₂ → closedBall x (δ₁ + δ₂) ⊆ U → ContDiffOn ℝ 2 u (ball 0 δ₁) → (∀ v ∈ ball (0 : Euclid (n + 1)) δ₁, (∀ w : Euclid (n + 1), inner ℝ (ι w) (u v) = 0) ∧ ‖fderiv ℝ u v‖ ≤ 1 ∧ ‖u v‖ < δ₂ / 2 ∧ x + ι v + u v ∈ N ∧ ∀ α : Covector (Euclid P) (n + 1), ξN (x + ι v + u v) α * Real.sqrt (Matrix.det (Matrix.of fun i j : Fin (n + 1) => inner ℝ (ι (EuclideanSpace.single i 1) + fderiv ℝ u v (EuclideanSpace.single i 1)) (ι (EuclideanSpace.single j 1) + fderiv ℝ u v (EuclideanSpace.single j 1)))) = α (fun i => ι (EuclideanSpace.single i 1) + fderiv ℝ u v (EuclideanSpace.single i 1))) → (∀ (v : Euclid (n + 1)) (h : Euclid P), ‖v‖ < δ₁ → ‖h‖ < δ₂ → (∀ w : Euclid (n + 1), inner ℝ (ι w) h = 0) → x + ι v + h ∈ N → h = u v) → MeasurableSet (ball 0 δ₁ ∩ (fun y => x + ι y + u y) ⁻¹' E) ∧ ∀ K : Set (Euclid (n + 1)), IsCompact K → K ⊆ ball 0 δ₁ → ∃ C : ℝ, ∀ φ : Euclid (n + 1) → Euclid (n + 1), ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ → tsupport φ ⊆ K → (∀ y, ‖φ y‖ ≤ 1) → ∫ y in ball 0 δ₁ ∩ (fun y => x + ι y + u y) ⁻¹' E, LinearMap.trace ℝ (Euclid (n + 1)) (fderiv ℝ φ y : Euclid (n + 1) →ₗ[ℝ] Euclid (n + 1)) ≤ C := by
  intro P n U N E ξN T x ι u δ₁ δ₂ hE hEU hTE hTim hδ₁ hδ₂ hxU hu hchart huniq
  -- on `D = B_{δ₁}(0)`: `u` is differentiable, `u ⊥ range ι` and `|u| < δ₂/2`
  have hud : DifferentiableOn ℝ u (ball 0 δ₁) := hu.differentiableOn two_ne_zero
  have huι : ∀ v ∈ ball (0 : Euclid (n + 1)) δ₁, ∀ w : Euclid (n + 1), inner ℝ (ι w) (u v) = 0 :=
    fun v hv => (hchart v hv).1
  have hus : ∀ v ∈ ball (0 : Euclid (n + 1)) δ₁, ‖u v‖ < δ₂ / 2 := fun v hv => (hchart v hv).2.2.1
  refine ⟨?_, fun K hK hKD => ?_⟩
  · -- `F = D ∩ G̃⁻¹(E)` for the Borel map `G̃ = D.piecewise G x`, `G` being continuous on `D`
    classical
    have hGc : ContinuousOn (fun y => x + ι y + u y) (ball (0 : Euclid (n + 1)) δ₁) :=
      (continuousOn_const.add ι.continuous.continuousOn).add hu.continuousOn
    have hGpw := hGc.measurable_piecewise (continuousOn_const (c := x)) measurableSet_ball
    convert measurableSet_ball.inter (hGpw hE) using 1
    ext y
    simp only [mem_inter_iff, mem_preimage]
    exact and_congr_right fun hy => by rw [piecewise_eq_of_mem _ _ _ hy]
  · -- `K̂ = B̄_{δ₁+δ₂}(x)` is a compact subset of `U`, so `M_{K̂}(T) ≤ μ_R(K̂) < ∞`
    obtain ⟨R, hR⟩ := hTim
    have hM : T.massOn (closedBall x (δ₁ + δ₂)) ≠ ∞ :=
      ne_top_of_le_ne_top (Submission.rsd_imrep_compact_measure_ne_top P n U R _
          (isCompact_closedBall x (δ₁ + δ₂)) hxU).2
        (Submission.dor_ims_massOn_le_measure P n U T R hR _)
    refine ⟨((n + 1).factorial : ℝ) * Real.sqrt ((P : ℝ) ^ n) *
        (T.massOn (closedBall x (δ₁ + δ₂))).toReal, fun φ hφ hφc hφK hφ1 => ?_⟩
    -- the test form `ω_φ`: support in `Z ∩ K̂`, `|ω_φ| ≤ (n+1)! √(Pⁿ)`, pull-back field `φ`
    obtain ⟨ω, hωZ, hωK, hω, hφω⟩ := Submission.codim1_lur_chart_test_form_exists P n U x ι u δ₁ δ₂
      φ hδ₂ hxU hud huι hus hφ hφc (hφK.trans hKD) hφ1
    -- the chart divergence formula with `Φ = φ`: `T(ω_φ) = ∫_F div φ`
    rw [← (Submission.codim1_lur_chart_divergence_formula P n U N E ξN T x ι u δ₁ δ₂ hE hEU hTE
      hδ₁ hδ₂ hu hchart huniq ω φ hωZ hφω).2.2.2]
    -- `T(ω_φ) ≤ |T(ω_φ)| ≤ (n+1)! √(Pⁿ) M_{K̂}(T)`
    exact (le_abs_self _).trans (Submission.cmr_abs_apply_le_massOn P n U _ T ω _ hM hωK hω)
/-- **Area formula on a countably rectifiable set for an injective `C¹` immersion** (Simon Ch. 3,
2.1–2.6; used for the local unit representation in the proof of 7.5.8).  Let `D ⊆ ℝᵈ` be open,
`G : ℝᵈ → ℝᴾ` be `C¹` and injective on `D` with `DG(v)` injective, and let `B ⊆ D` be Borel and
countably `m`-rectifiable, with `Hᵐ(B ∩ K) < ∞` for compact `K ⊆ D` and approximate tangent space
`Q(v)` at `Hᵐ`-a.e. `v ∈ B`.  Then `G(B)` is countably `m`-rectifiable, `Hᵐ(G(B ∩ K)) < ∞`, and a
Borel `J ≥ 0`, equal `Hᵐ`-a.e. on `B` to `√det[⟨DG σᵢ, DG σⱼ⟩]` for every orthonormal frame `σ` of
`Q(v)`, has `∫_{G(B)} g dHᵐ = ∫_B J (g ∘ G) dHᵐ` (lower and Bochner integrals).  Up to an
`Hᵐ`-null set, `B` is the disjoint union of bi-Lipschitz pieces `Aᵢ = Fᵢ(Bᵢ)`, and
`Q(Fᵢ b) = range DFᵢ(b)` for a.e. `b ∈ Bᵢ` (tangent spaces of the pieces, locality, uniqueness).
On `Aᵢ`, `J = J_{G ∘ Fᵢ} / J_{Fᵢ}` is the Gram Jacobian of `DG` along `Q` by the chain rule; the
injective area formula for `G ∘ Fᵢ` and for `Fᵢ` on `Bᵢ`, summed over the pieces, gives the lower
integral identity, and the measurable embedding `G|_B` gives the Bochner identity. -/
theorem Submission.codim1_lur_rectifiable_area_formula : ∀ (m d P : ℕ) (D B : Set (Euclid d)) (G : Euclid d → Euclid P) (Q : Euclid d → Submodule ℝ (Euclid d)), 1 ≤ m → IsOpen D → ContDiffOn ℝ 1 G D → InjOn G D → (∀ v ∈ D, Injective (fderiv ℝ G v)) → MeasurableSet B → B ⊆ D → CountablyRectifiable m B → (∀ K : Set (Euclid d), IsCompact K → K ⊆ D → μHE[m] (B ∩ K) ≠ ∞) → (∀ᵐ v ∂(μHE[m].restrict B), HasApproximateTangentSpaceAt m B v (Q v)) → CountablyRectifiable m (G '' B) ∧ (∀ K : Set (Euclid d), IsCompact K → K ⊆ D → μHE[m] (G '' (B ∩ K)) ≠ ∞) ∧ ∃ J : Euclid d → ℝ, Measurable J ∧ (∀ v, 0 ≤ J v) ∧ (∀ᵐ v ∂(μHE[m].restrict B), ∀ σ : Fin m → Euclid d, Orthonormal ℝ σ → Submodule.span ℝ (Set.range σ) = Q v → J v = Real.sqrt (Matrix.det (Matrix.of fun i j : Fin m => inner ℝ (fderiv ℝ G v (σ i)) (fderiv ℝ G v (σ j))))) ∧ (∀ g : Euclid P → ℝ≥0∞, ∫⁻ w in G '' B, g w ∂μHE[m] = ∫⁻ v in B, ENNReal.ofReal (J v) * g (G v) ∂μHE[m]) ∧ ∀ f : Euclid P → ℝ, ∫ w in G '' B, f w ∂μHE[m] = ∫ v in B, J v * f (G v) ∂μHE[m] := by
  intro m d P D B G Q hm hD hG hGinj hDG hB hBD hBrect hBfin hQ
  -- Step 0: `G` is Lipschitz on compacta of `D` and maps null, resp. countably `m`-rectifiable,
  -- subsets of `D` to null, resp. countably `m`-rectifiable, sets
  obtain ⟨hGlip, hGnull, hGrect⟩ :=
    Submission.codim1_lura_c1_image_lipschitz_null_rectifiable m d P D G hD hG
  have hGd : ∀ v ∈ D, DifferentiableAt ℝ G v := fun v hv =>
    (hG.contDiffAt (hD.mem_nhds hv)).differentiableAt one_ne_zero
  have hGc : ContinuousOn G B := hG.continuousOn.mono hBD
  have hGi : InjOn G B := hGinj.mono hBD
  -- Step 1: Borel pieces `Aᵢ = Fᵢ(Bᵢ) ⊆ B`, pairwise disjoint and covering `B` up to an
  -- `Hᵐ`-null set, with `Fᵢ` Lipschitz, `cᵢ|a − a'| ≤ |Fᵢ a − Fᵢ a'|` and `DFᵢ` injective on `Bᵢ`
  obtain ⟨F, S, c, hFL, hSm, hc, hlow, hFd, hAm, hAB, hAdisj, hN⟩ :=
    Submission.dpf_rectifiable_bilipschitz_pieces d m B hB hBrect
  have hFi : ∀ i, InjOn (F i) (S i) := fun i a ha a' ha' h => by
    have hle := hlow i a ha a' ha'
    rw [h, sub_self, norm_zero] at hle
    exact sub_eq_zero.1 (norm_le_zero_iff.1 (nonpos_of_mul_nonpos_right hle (hc i)))
  have hFc : ∀ i, Continuous (F i) := fun i => (hFL i).choose_spec.continuous
  have hFD : ∀ i, ∀ b ∈ S i, F i b ∈ D := fun i b hb => hBD (hAB i (mem_image_of_mem _ hb))
  -- `G ∘ Fᵢ` is differentiable at `b ∈ Bᵢ`, with `D(G ∘ Fᵢ)(b) = DG(Fᵢ b) ∘ DFᵢ(b)` injective, and
  -- `G ∘ Fᵢ` is injective on `Bᵢ`
  have hcomp : ∀ i, ∀ b ∈ S i,
      fderiv ℝ (G ∘ F i) b = (fderiv ℝ G (F i b)).comp (fderiv ℝ (F i) b) := fun i b hb =>
    fderiv_comp b (hGd _ (hFD i b hb)) (hFd i b hb).1
  have hGFd : ∀ i, ∀ b ∈ S i, DifferentiableAt ℝ (G ∘ F i) b := fun i b hb =>
    (hGd _ (hFD i b hb)).comp b (hFd i b hb).1
  have hGFinj : ∀ i, ∀ b ∈ S i, Injective (fderiv ℝ (G ∘ F i) b) := fun i b hb => by
    rw [hcomp i b hb, ContinuousLinearMap.coe_comp]
    exact (hDG _ (hFD i b hb)).comp (hFd i b hb).2
  have hGFi : ∀ i, InjOn (G ∘ F i) (S i) := fun i => hGinj.comp (hFi i) (hFD i)
  -- Step 2: `Q(Fᵢ b) = range DFᵢ(b)` for a.e. `b ∈ Bᵢ`
  have htan : ∀ i, ∀ᵐ b ∂(volume.restrict (S i)),
      Q (F i b) = LinearMap.range (fderiv ℝ (F i) b : Euclid m →ₗ[ℝ] Euclid d) := by
    intro i
    obtain ⟨L, hL⟩ := hFL i
    -- (a) `Aᵢ` has approximate tangent space `range DFᵢ(b)` at `Fᵢ b`, for a.e. `b ∈ Bᵢ`
    have ha := Submission.codim1_lur_piece_image_approxTangent_ae d m (F i) (S i) L (c i) hL
      (hSm i) (hc i) (hlow i) (hFd i)
    -- (b) `B` and `Aᵢ` have the same approximate tangent spaces `Hᵐ`-a.e. on `Aᵢ`
    have hb := Submission.regcomp_approx_tangent_locality d m D (F i '' S i) B hD (hAm i) hB
      (hAB i) hBD hBfin
    -- (c) `B` has approximate tangent space `Q` `Hᵐ`-a.e. on `Aᵢ ⊆ B`
    have hcQ := ae_restrict_of_ae_restrict_of_subset (hAB i) hQ
    -- (d) pull (b) ∧ (c) back to a.e. `b ∈ Bᵢ`
    have hd := (Submission.ptd_piece_image_measurable_ae_pullback d m (F i) (S i) L (c i) hL
      (hSm i) (hc i) (hlow i)).2 _ (hb.and hcQ)
    -- (e) uniqueness of the approximate tangent space of `Aᵢ` at `Fᵢ b`
    filter_upwards [ha, hd] with b hab hdb
    exact ((hdb.1 (Q (F i b))).1 hdb.2).unique hab
  -- Step 3: the Jacobians `J_{Fᵢ}`, `J_{G ∘ Fᵢ}` (`√det` of the Gram matrices) are Borel,
  -- `J_{Fᵢ} > 0` on `Bᵢ`, and `J_{G ∘ Fᵢ} = √det[⟨DG σₐ, DG σ_b⟩] · J_{Fᵢ}` along an orthonormal
  -- frame `σ` of `range DFᵢ(b)`
  obtain ⟨JF, hJF⟩ : ∃ JF : ℕ → Euclid m → ℝ, ∀ i b, JF i b = Real.sqrt (Matrix.det
      (Matrix.of fun k l : Fin m => inner ℝ (fderiv ℝ (F i) b (EuclideanSpace.single k 1))
        (fderiv ℝ (F i) b (EuclideanSpace.single l 1)))) := ⟨_, fun _ _ => rfl⟩
  obtain ⟨JGF, hJGF⟩ : ∃ JGF : ℕ → Euclid m → ℝ, ∀ i b, JGF i b = Real.sqrt (Matrix.det
      (Matrix.of fun k l : Fin m => inner ℝ (fderiv ℝ (G ∘ F i) b (EuclideanSpace.single k 1))
        (fderiv ℝ (G ∘ F i) b (EuclideanSpace.single l 1)))) := ⟨_, fun _ _ => rfl⟩
  have hJFm : ∀ i, Measurable (JF i) := fun i => by
    rw [show JF i = _ from funext (hJF i)]
    exact (Submission.codim1_lura_gram_area_formula m d (F i)).1
  have hJGFm : ∀ i, Measurable (JGF i) := fun i => by
    rw [show JGF i = _ from funext (hJGF i)]
    exact (Submission.codim1_lura_gram_area_formula m P (G ∘ F i)).1
  have hJFpos : ∀ i, ∀ b ∈ S i, 0 < JF i b := fun i b hb => by
    rw [hJF]
    exact Real.sqrt_pos.2
      ((Submission.codim1_lura_gram_det_comp_orthonormal m d P (fderiv ℝ (F i) b)).1 (hFd i b hb).2)
  have hchain : ∀ i, ∀ b ∈ S i, ∀ σ : Fin m → Euclid d, Orthonormal ℝ σ →
      Submodule.span ℝ (Set.range σ) =
        LinearMap.range (fderiv ℝ (F i) b : Euclid m →ₗ[ℝ] Euclid d) →
      JGF i b = Real.sqrt (Matrix.det (Matrix.of fun a a' : Fin m =>
        inner ℝ (fderiv ℝ G (F i b) (σ a)) (fderiv ℝ G (F i b) (σ a')))) * JF i b := by
    intro i b hb σ hσ hspan
    obtain ⟨hpos, hdet⟩ :=
      Submission.codim1_lura_gram_det_comp_orthonormal m d P (fderiv ℝ (F i) b)
    rw [hJGF, hJF, hcomp i b hb]
    simp only [ContinuousLinearMap.comp_apply]
    rw [hdet (fderiv ℝ G (F i b)) σ hσ hspan, Real.sqrt_mul' _ (hpos (hFd i b hb).2).le]
  -- Step 4: a Borel `J ≥ 0` with `J(Fᵢ b) = J_{G ∘ Fᵢ}(b) / J_{Fᵢ}(b)` for `b ∈ Bᵢ`
  obtain ⟨J, hJm, hJ0, hJ⟩ := Submission.codim1_lura_glue_measurable_on_pieces m d F S
    (fun i b => JGF i b / JF i b) hFc hSm hFi hAdisj (fun i => (hJGFm i).div (hJFm i))
    (fun i b => div_nonneg (hJGF i b ▸ Real.sqrt_nonneg _) (hJF i b ▸ Real.sqrt_nonneg _))
  -- (‡) `J(Fᵢ b) · J_{Fᵢ}(b) = J_{G ∘ Fᵢ}(b)` on `Bᵢ`
  have hJmul : ∀ i, ∀ b ∈ S i, JF i b * J (F i b) = JGF i b := fun i b hb => by
    rw [hJ i b hb, mul_div_cancel₀ _ (hJFpos i b hb).ne']
  -- Step 5: the Gram identity for `J`, first at `Fᵢ b` for a.e. `b ∈ Bᵢ`, then `Hᵐ`-a.e. on `B`
  have hgram : ∀ᵐ v ∂(μHE[m].restrict B), ∀ σ : Fin m → Euclid d, Orthonormal ℝ σ →
      Submodule.span ℝ (Set.range σ) = Q v → J v = Real.sqrt (Matrix.det
        (Matrix.of fun i j : Fin m => inner ℝ (fderiv ℝ G v (σ i)) (fderiv ℝ G v (σ j)))) := by
    refine Submission.dpf_itt_ae_of_ae_pieces d m B F S _ hB hFL hN fun i => ?_
    filter_upwards [htan i, ae_restrict_mem (hSm i)] with b hbQ hb σ hσ hspan
    have hne := (hJFpos i b hb).ne'
    rw [← mul_left_inj' hne, mul_comm (J (F i b)), hJmul i b hb,
      hchain i b hb σ hσ (hspan.trans hbQ)]
  -- Step 6: the area formula, first on each piece (applied to `G ∘ Fᵢ` and to `Fᵢ`), then summed
  have hpiece : ∀ i (g : Euclid P → ℝ≥0∞), ∫⁻ w in G '' (F i '' S i), g w ∂μHE[m] =
      ∫⁻ v in F i '' S i, ENNReal.ofReal (J v) * g (G v) ∂μHE[m] := by
    intro i g
    rw [← image_comp, (Submission.codim1_lura_gram_area_formula m P (G ∘ F i)).2 (S i) (hSm i)
      (hGFd i) (hGFinj i) (hGFi i) g, (Submission.codim1_lura_gram_area_formula m d (F i)).2
      (S i) (hSm i) (fun b hb => (hFd i b hb).1) (fun b hb => (hFd i b hb).2) (hFi i)
      (fun v => ENNReal.ofReal (J v) * g (G v))]
    refine setLIntegral_congr_fun (hSm i) fun b hb => ?_
    simp only [← hJF, ← hJGF, comp_apply]
    rw [← mul_assoc, ← ENNReal.ofReal_mul (hJFpos i b hb).le, hJmul i b hb]
  have hlint : ∀ g : Euclid P → ℝ≥0∞,
      ∫⁻ w in G '' B, g w ∂μHE[m] = ∫⁻ v in B, ENNReal.ofReal (J v) * g (G v) ∂μHE[m] := by
    intro g
    have hGN : μHE[m] (G '' (B \ ⋃ i, F i '' S i)) = 0 := hGnull _ (sdiff_subset.trans hBD) hN
    have hid := Submission.codim1_lura_lintegral_image_eq_tsum_pieces m d d B
      (fun i => F i '' S i) id continuousOn_id (injOn_id B) hAm hAB hAdisj (by rwa [image_id])
      (fun v => ENNReal.ofReal (J v) * g (G v))
    simp only [image_id] at hid
    rw [Submission.codim1_lura_lintegral_image_eq_tsum_pieces m d P B (fun i => F i '' S i) G hGc
      hGi hAm hAB hAdisj hGN g, hid]
    exact tsum_congr fun i => hpiece i g
  -- Step 7: the Bochner identity, from the lintegral identity along the embedding `G|_B`
  refine ⟨hGrect B hBD hBrect, fun K hK hKD => ?_, J, hJm, hJ0, hgram, hlint,
    Submission.codim1_lura_integral_image_of_lintegral d P (μHE[m]) (μHE[m]) B G J hB hGc hGi hJm
      hJ0 hlint⟩
  -- `Hᵐ(G(B ∩ K)) ≤ Lᵐ Hᵐ(B ∩ K) < ∞`, `G` being `L`-Lipschitz on `K`
  obtain ⟨L, hL⟩ := hGlip K hK hKD
  exact ne_top_of_le_ne_top
    (ENNReal.mul_ne_top (ENNReal.pow_ne_top ENNReal.coe_ne_top) (hBfin K hK hKD))
    (Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn m
      (hL.mono inter_subset_right))

/-- **A cone regular with density one off the vertex is a multiplicity-one oriented cone**
(Simon 7.3.1(2), 7.4.1; Ch. 6, 2.11, 2.23, 3.1).  Let `C ∈ 𝒟ₘ(ℝᴾ)`, `m ≥ 1`, be an integer
multiplicity cone such that every `y ∈ spt C \ {0}` lies in `reg C` with `Θᵐ(μ_C, y) = 1`.  Then
`M = spt C \ {0}` is an embedded `C¹` submanifold, invariant under dilations, of locally finite
`Hᵐ`-measure, with an orientation `ξ` such that `C(ω) = ∫_M ⟨ω, ξ⟩ dHᵐ` for every `ω ∈ 𝒟ᵐ(ℝᴾ)`.
The multiplicity-one pieces `M ∩ B_y` (`y ∈ M`, radius `≤ |y|/2`) glue to an orientation of `M`;
a partition of unity gives the representation away from `0`, and the vertex is negligible since
`C` is integer multiplicity and `m ≥ 1`. -/
theorem Submission.codim1_cone_offvertex_unit_multiplicity_rep : ∀ (P m : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) m), 1 ≤ m → IsIntegerMultiplicity C → IsConeCurrent C → (∀ y ∈ C.support, y ≠ 0 → y ∈ regularSet C ∧ HasMassDensity C y 1) → ∃ ξ : Euclid P → MultiVector P m, IsEmbeddedSubmanifold 1 m (C.support \ {0}) ∧ IsOrientation m (C.support \ {0}) ξ ∧ (∀ t : ℝ, 0 < t → ∀ x ∈ C.support \ {0}, t • x ∈ C.support \ {0}) ∧ (∀ K : Set (Euclid P), IsCompact K → μHE[m] ((C.support \ {0}) ∩ K) ≠ ∞) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) m, C ω = ∫ x in C.support \ {0}, ξ x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m] := by
  intro P m C hm hIM hcone hreg
  set M : Set (Euclid P) := C.support \ {0}
  -- `spt C` is closed (the complement of the open zero region), so `M` is Borel
  have hsuppC : IsClosed C.support := by
    have h : C.support = (C.zeroRegion)ᶜ := by
      ext x; simp [GeometricCurrentOn.support]
    rw [h]; exact C.isOpen_zeroRegion.isClosed_compl
  have hMmeas : MeasurableSet M := hsuppC.measurableSet.diff (measurableSet_singleton 0)
  have h0M : (0 : Euclid P) ∉ M := fun h => h.2 (mem_singleton 0)
  -- local multiplicity-one pieces `spt C ∩ B_y`, with radius `≤ |y|/2`
  have hloc : ∀ y : Euclid P, ∃ (r : ℝ) (ξ : Euclid P → MultiVector P m), y ∈ M →
      0 < r ∧ r ≤ ‖y‖ / 2 ∧ IsEmbeddedSubmanifold 1 m (C.support ∩ ball y r) ∧
      IsOrientation m (C.support ∩ ball y r) ξ ∧ μHE[m] (C.support ∩ ball y r) ≠ ∞ ∧
      ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
        tsupport (ω : DifferentialForm (Euclid P) m) ⊆ ball y r →
        C ω = ∫ x in C.support ∩ ball y r, ξ x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m] := by
    intro y
    by_cases hy : y ∈ M
    · obtain ⟨hyS, hy0⟩ := hy
      have hy0' : y ≠ 0 := fun h => hy0 (by rw [h]; exact mem_singleton 0)
      obtain ⟨hyreg, hyden⟩ := hreg y hyS hy0'
      obtain ⟨ρ₀, hρ₀, -, hρ⟩ :=
        Submission.codim1_density_one_regular_local_rep P m univ C y hm isOpen_univ hyreg hyden
      have hny : 0 < ‖y‖ := norm_pos_iff.2 hy0'
      have hrpos : 0 < min ρ₀ (‖y‖ / 2) := lt_min hρ₀ (by linarith)
      obtain ⟨ξ, h1, h2, h3, h4⟩ := hρ (min ρ₀ (‖y‖ / 2)) hrpos (min_le_left _ _)
      exact ⟨min ρ₀ (‖y‖ / 2), ξ, fun _ => ⟨hrpos, min_le_right _ _, h1, h2, h3, h4⟩⟩
    · exact ⟨1, 0, fun h => absurd h hy⟩
  choose ρ ξs hρξ using hloc
  -- `0 ∉ B_y`, so `spt C ∩ B_y = M ∩ B_y`
  have hSeq : ∀ y ∈ M, C.support ∩ ball y (ρ y) = M ∩ ball y (ρ y) := by
    intro y hy
    obtain ⟨hρpos, hρle, -⟩ := hρξ y hy
    ext x
    constructor
    · rintro ⟨hxS, hxB⟩
      refine ⟨⟨hxS, fun hx0 => ?_⟩, hxB⟩
      rw [mem_singleton_iff] at hx0
      subst hx0
      rw [mem_ball, dist_zero_left] at hxB
      linarith [norm_nonneg y]
    · rintro ⟨⟨hxS, -⟩, hxB⟩
      exact ⟨hxS, hxB⟩
  have hlocM : ∀ y ∈ M, 0 < ρ y ∧ IsEmbeddedSubmanifold 1 m (M ∩ ball y (ρ y)) ∧
      IsOrientation m (M ∩ ball y (ρ y)) (ξs y) ∧ μHE[m] (M ∩ ball y (ρ y)) ≠ ∞ ∧
      ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
        tsupport (ω : DifferentialForm (Euclid P) m) ⊆ ball y (ρ y) →
        C ω = ∫ x in M ∩ ball y (ρ y), ξs y x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m] := by
    intro y hy
    obtain ⟨hρpos, -, h1, h2, h3, h4⟩ := hρξ y hy
    rw [hSeq y hy] at h1 h2 h3 h4
    exact ⟨hρpos, h1, h2, h3, h4⟩
  -- `M` is an embedded `C¹` submanifold
  have hMsub : IsEmbeddedSubmanifold 1 m M :=
    (Submission.codim1_ovr_embedded_submanifold_local P 1 m M le_rfl (fun y hy =>
      ⟨ball y (ρ y), isOpen_ball, mem_ball_self (hlocM y hy).1, (hlocM y hy).2.1⟩)).1
  -- a global orientation `ξ` of `M` representing `C` on every ball `B_y`
  obtain ⟨ξ, hξor, -, hξrep⟩ := Submission.codim1_ovr_orientation_glue P m C M ρ ξs hMsub hMmeas
    (fun y hy => ⟨(hlocM y hy).1, (hlocM y hy).2.2.1, (hlocM y hy).2.2.2.1, (hlocM y hy).2.2.2.2⟩)
  -- `M` is invariant under dilations
  have hconeM : ∀ t : ℝ, 0 < t → ∀ x ∈ M, t • x ∈ M := by
    intro t ht x hx
    refine ⟨Submission.codim1_ovr_cone_support_smul P m C hcone t ht x hx.1, fun h => hx.2 ?_⟩
    rw [mem_singleton_iff] at h ⊢
    exact (smul_eq_zero.1 h).resolve_left ht.ne'
  -- `Hᵐ(M ∩ K) < ∞` for compact `K`
  have hclos : closure M ⊆ insert 0 M := by
    intro x hx
    have hxS : x ∈ C.support := closure_minimal sdiff_subset hsuppC hx
    by_cases hx0 : x = 0
    · exact Or.inl hx0
    · exact Or.inr ⟨hxS, fun h => hx0 (mem_singleton_iff.1 h)⟩
  have hfin : ∀ K : Set (Euclid P), IsCompact K → μHE[m] (M ∩ K) ≠ ∞ :=
    Submission.codim1_ovr_cone_locally_finite_measure P m M hm h0M hclos hconeM (fun y hy =>
      ⟨ball y (ρ y), isOpen_ball, mem_ball_self (hlocM y hy).1, (hlocM y hy).2.2.2.1⟩)
  -- `|⟨α, ξ(x)⟩| ≤ |α|` on `M`
  obtain ⟨L, hL⟩ := Submission.dor_ims_unitOrientation_dual P m
  have hbound : ∀ x ∈ M, ∀ α : Covector (Euclid P) m, |ξ x α| ≤ covectorEuclideanNorm α := by
    intro x hx α
    obtain ⟨Q, -, hQ⟩ := hξor.2 x hx
    exact (hL (ξ x) Q hQ).1 α
  -- the representation for test forms supported away from the vertex: near a point of `M` use
  -- `B_y`; off `spt C` both sides vanish
  have hoff : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
      (0 : Euclid P) ∉ tsupport (ω : DifferentialForm (Euclid P) m) →
      C ω = ∫ x in M, ξ x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m] := by
    intro ω hω
    refine Submission.codim1_ovr_partition_glue_rep P m C M {0}ᶜ ξ isOpen_compl_singleton hMmeas
      hξor.1 hbound hfin ?_ ω (subset_compl_singleton_iff.2 hω)
    intro x hx
    by_cases hxS : x ∈ C.support
    · have hxM : x ∈ M := ⟨hxS, hx⟩
      exact ⟨ball x (ρ x), isOpen_ball, mem_ball_self (hlocM x hxM).1, hξrep x hxM⟩
    · refine ⟨C.supportᶜ, hsuppC.isOpen_compl, hxS, fun η hη => ?_⟩
      rw [Submission.dtc_vanish_off_support P m univ C η (subset_compl_iff_disjoint_right.1 hη)]
      symm
      refine setIntegral_eq_zero_of_forall_eq_zero fun z hz => ?_
      have hzη : z ∉ tsupport (η : DifferentialForm (Euclid P) m) := fun h => hη h hz.1
      rw [image_eq_zero_of_notMem_tsupport hzη, map_zero]
  -- the vertex is negligible, so the representation holds for every test form
  have hrep := Submission.codim1_ovr_extend_rep_across_vertex P m C M ξ hm hIM hMmeas h0M hξor.1
    hbound hfin hoff
  exact ⟨ξ, hMsub, hξor, hconeM, hfin, hrep⟩
/-- **Area comparison from minimality** (Simon 7.1.1; Appendix B, the competitors `(id + tZ)_#C`
for `H^n(M_t) ≥ H^n(M_0)`).  Let `K = spt Z ⊆ V` and choose an open `W ⊇ K` with `closure W` a
compact subset of `V`, so `H^m(M ∩ W) < ∞`.  For `|t| < t₀`, `Φ = id + tZ` is a bi-Lipschitz
`C^∞` bijection with injective derivative, `Φ = id` off `K` and `Φ(K) ⊆ K`.  The push-forward
`S = Φ_#C`, `S(ω) = C(Φ^#ω)`, has `∂S = 0`.  For `D₁ = [[M ∩ W]]` and `D₂ = Φ_#[[M ∩ W]]`
(integer multiplicity), `S − C = D₂ − D₁`, because `Φ^#ω − ω` vanishes off `K ⊆ W` and `C = [[M]]`
on forms supported in `V`.  Hence `S = C − (D₁ − D₂)` is integer multiplicity, `∂S = ∂C`, and
`spt(S − C) ⊆ K`.  Minimality and `S = D₂` on forms supported in `W` give
`H^m(M ∩ W) ≤ M_W(C) ≤ M_W(S) ≤ M_W(D₂) ≤ H^m(Φ(M ∩ W))`.  Finally `Φ(M ∩ W) ∩ K = Φ(M ∩ K)` and
`Φ(M ∩ W) \ K = (M ∩ W) \ K`; cancelling the finite measure of `(M ∩ W) \ K` gives the claim. -/
theorem Submission.codim1_minimizing_piece_area_comparison : ∀ (P m : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) m) (V M : Set (Euclid P)) (ξ : Euclid P → MultiVector P m), 1 ≤ m → IsMinimizingIn C univ → BoundaryVanishes C → IsOpen V → M ⊆ V → IsEmbeddedSubmanifold 1 m M → IsOrientation m M ξ → (∀ K : Set (Euclid P), IsCompact K → K ⊆ V → μHE[m] (M ∩ K) ≠ ∞) → (∀ ω : TestFormOn (univ : Set (Euclid P)) m, tsupport (ω : DifferentialForm (Euclid P) m) ⊆ V → C ω = ∫ x in M, ξ x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m]) → (∀ W : Set (Euclid P), IsOpen W → W ⊆ V → μHE[m] (M ∩ W) ≠ ∞ → μHE[m] (M ∩ W) ≤ C.massOn W) → ∀ Z : Euclid P → Euclid P, ContDiff ℝ (⊤ : ℕ∞) Z → HasCompactSupport Z → tsupport Z ⊆ V → ∃ t₀ : ℝ, 0 < t₀ ∧ ∀ t : ℝ, |t| < t₀ → μHE[m] (M ∩ tsupport Z) ≤ μHE[m] ((fun x => x + t • Z x) '' (M ∩ tsupport Z)) := by
  intro P m C V M ξ hm hmin hbdry hV _hMV hM hξ hLF hRep hmass Z hZ hZc hZV
  -- currents with `∂ = 0` have the same boundary (vacuous in degree `0`)
  have hsame : ∀ {n : ℕ} (A B : GeometricCurrentOn (univ : Set (Euclid P)) n),
      BoundaryVanishes A → BoundaryVanishes B → SameBoundary A B := by
    intro n A B hA hB
    cases n with
    | zero => trivial
    | succ k => exact (hA : A.boundary = 0).trans (hB : B.boundary = 0).symm
  -- Step 1: `K = spt Z` is compact; an open `W ⊇ K` with `closure W` a compact subset of `V`
  set K : Set (Euclid P) := tsupport Z
  have hKc : IsCompact K := hZc.isCompact
  have hKm : MeasurableSet K := hKc.isClosed.measurableSet
  obtain ⟨W, hW, hKW, hWV', hWc⟩ := exists_open_between_and_isCompact_closure hKc hV hZV
  have hWV : W ⊆ V := subset_closure.trans hWV'
  have hMW : μHE[m] (M ∩ W) ≠ ∞ := ne_top_of_le_ne_top (hLF _ hWc hWV')
    (measure_mono (inter_subset_inter_right M subset_closure))
  -- integrals over `M` of functions vanishing off `W` are integrals over `M ∩ W`
  have hloc : ∀ g : Euclid P → ℝ, (∀ x, x ∉ W → g x = 0) →
      ∫ x in M, g x ∂μHE[m] = ∫ x in M ∩ W, g x ∂μHE[m] := by
    intro g hg
    rw [inter_comm, ← Measure.restrict_restrict hW.measurableSet,
      setIntegral_eq_integral_of_forall_compl_eq_zero hg]
  -- Step 2: `Φ = id + tZ` is a bi-Lipschitz bijection with injective derivative for `|t| < t₀`
  have hZ1 : ContDiff ℝ 1 Z := hZ.of_le (by exact_mod_cast le_top)
  obtain ⟨t₀, ht₀, hpert⟩ := Submission.codim1_ac_perturbation_diffeo P Z hZ1 hZc
  refine ⟨t₀, ht₀, fun t ht => ?_⟩
  obtain ⟨hbij, hDΦ, Λ, hlip, hanti⟩ := hpert t ht
  set Φ : Euclid P → Euclid P := fun x => x + t • Z x
  have hΦsm : ContDiff ℝ (⊤ : ℕ∞) Φ := contDiff_id.add (hZ.const_smul t)
  have hΦ1 : ContDiff ℝ 1 Φ := contDiff_id.add (hZ1.const_smul t)
  -- `Φ = id` off `K`, so `DΦ = I` off `K`; `Φ(K) ⊆ K` since `Φ` is injective
  have hΦid : ∀ x, x ∉ K → Φ x = x := fun x hx => by
    show x + t • Z x = x
    rw [image_eq_zero_of_notMem_tsupport hx, smul_zero, add_zero]
  have hDΦid : ∀ x, x ∉ K → fderiv ℝ Φ x = ContinuousLinearMap.id ℝ (Euclid P) := by
    intro x hx
    have h : Φ =ᶠ[𝓝 x] id := eventually_of_mem (hKc.isClosed.isOpen_compl.mem_nhds hx) hΦid
    rw [h.fderiv_eq, fderiv_id]
  have hΦK : ∀ x ∈ K, Φ x ∈ K := by
    intro x hx
    by_contra h
    have hx' : Φ x = x := hbij.injective (hΦid (Φ x) h)
    rw [hx'] at h
    exact h hx
  -- Step 3: the pull-back `Φ^#ω = ω(Φ) ∘ DΦ` of a test form is a test form
  obtain ⟨pb, hpb⟩ : ∃ pb : TestFormOn (univ : Set (Euclid P)) m →
      TestFormOn (univ : Set (Euclid P)) m, ∀ ω, (pb ω : DifferentialForm (Euclid P) m) =
        fun x => ((ω : DifferentialForm (Euclid P) m) (Φ x)).compContinuousLinearMap
          (fderiv ℝ Φ x) :=
    ⟨fun ω => ⟨fun x => ((ω : DifferentialForm (Euclid P) m) (Φ x)).compContinuousLinearMap
        (fderiv ℝ Φ x), (Submission.dpf_pb_smooth_pullback_isTestForm P m K Φ
          (ω : DifferentialForm (Euclid P) m) hKc hΦsm hΦid ω.property.1).1, subset_univ _⟩,
      fun ω => rfl⟩
  -- `Φ^#ω = ω` off `K`, and everywhere when `ω` vanishes on `K`
  have hpb_off : ∀ ω x, x ∉ K →
      (pb ω : DifferentialForm (Euclid P) m) x = (ω : DifferentialForm (Euclid P) m) x := by
    intro ω x hx
    simp only [hpb]
    rw [hΦid x hx, hDΦid x hx]
    ext v
    simp
  have hpb_eq : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
      (∀ y ∈ K, (ω : DifferentialForm (Euclid P) m) y = 0) → pb ω = ω := by
    intro ω hω
    refine Subtype.ext (funext fun x => ?_)
    by_cases hx : x ∈ K
    · simp only [hpb]
      rw [hω _ (hΦK x hx), hω x hx]
      ext v
      simp
    · exact hpb_off ω x hx
  -- Step 4: the competitor `S = Φ_#C`, with `S(ω) = C(Φ^#ω)` and `∂S = 0`
  obtain ⟨R, hR⟩ := hmin.1
  obtain ⟨S, hS⟩ := Submission.dpf_pushforward_formula_current_exists P m univ K R Φ hKc
    (subset_univ K) hΦ1 hΦid
  have hSC : ∀ ω, S ω = C (pb ω) := by
    intro ω
    rw [hS ω, hR (pb ω), IMRep.action, hpb ω]
  have hSb : BoundaryVanishes S := Submission.dpf_pushforward_formula_boundaryVanishes P m univ K
    C S R Φ isOpen_univ hR hKc (subset_univ K) hΦ1 hΦid hS hbdry
  -- Step 5: `D₁ = [[M ∩ W]]` and `D₂ = Φ_#[[M ∩ W]]`, integer multiplicity currents
  obtain ⟨D₁, hD₁im, hD₁, -⟩ := Submission.codim1_ac_oriented_piece_pushforward P m M W ξ id 1 hm
    hM hξ hW hMW contDiff_id bijective_id
    (fun x => by rw [fderiv_id, ContinuousLinearMap.coe_id']; exact injective_id)
    LipschitzWith.id AntilipschitzWith.id
  obtain ⟨D₂, hD₂im, hD₂, hD₂mass⟩ := Submission.codim1_ac_oriented_piece_pushforward P m M W ξ Φ
    Λ hm hM hξ hW hMW hΦ1 hbij hDΦ hlip hanti
  have hD₁' : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
      Integrable (fun x => ξ x ((ω : DifferentialForm (Euclid P) m) x))
        (μHE[m].restrict (M ∩ W)) ∧
      D₁ ω = ∫ x in M ∩ W, ξ x ((ω : DifferentialForm (Euclid P) m) x) ∂μHE[m] := by
    intro ω
    have hid : ∀ x, ((ω : DifferentialForm (Euclid P) m) (id x)).compContinuousLinearMap
        (fderiv ℝ id x) = (ω : DifferentialForm (Euclid P) m) x := by
      intro x
      rw [fderiv_id]
      ext v
      simp
    simpa only [hid] using hD₁ ω
  -- Step 6: `S − C = D₂ − D₁`: `Φ^#ω − ω` vanishes off `K ⊆ W ⊆ V`, where `C = [[M]]`
  have key : ∀ ω : TestFormOn (univ : Set (Euclid P)) m, S ω - C ω = D₂ ω - D₁ ω := by
    intro ω
    set β : TestFormOn (univ : Set (Euclid P)) m := pb ω - ω with hβ_def
    have hβ : ∀ x, (β : DifferentialForm (Euclid P) m) x =
        ((ω : DifferentialForm (Euclid P) m) (Φ x)).compContinuousLinearMap (fderiv ℝ Φ x) -
          (ω : DifferentialForm (Euclid P) m) x := by
      intro x
      rw [hβ_def, Submodule.coe_sub, Pi.sub_apply, hpb ω]
    have hβK : ∀ x, x ∉ K → (β : DifferentialForm (Euclid P) m) x = 0 := by
      intro x hx
      rw [hβ_def, Submodule.coe_sub, Pi.sub_apply, hpb_off ω x hx, sub_self]
    have hβs : tsupport (β : DifferentialForm (Euclid P) m) ⊆ K :=
      closure_minimal (fun x hx => by_contra fun hxK => hx (hβK x hxK)) hKc.isClosed
    calc S ω - C ω = C β := by rw [hSC ω, hβ_def]; exact (map_sub C.toCurrent (pb ω) ω).symm
      _ = ∫ x in M, ξ x ((β : DifferentialForm (Euclid P) m) x) ∂μHE[m] :=
          hRep β (hβs.trans hZV)
      _ = ∫ x in M ∩ W, ξ x ((β : DifferentialForm (Euclid P) m) x) ∂μHE[m] :=
          hloc _ fun x hx => by simp only [hβK x fun hxK => hx (hKW hxK), map_zero]
      _ = ∫ x in M ∩ W, (ξ x (((ω : DifferentialForm (Euclid P) m) (Φ x)).compContinuousLinearMap
            (fderiv ℝ Φ x)) - ξ x ((ω : DifferentialForm (Euclid P) m) x)) ∂μHE[m] := by
          congr 1
          ext x
          rw [hβ x, map_sub]
      _ = D₂ ω - D₁ ω := by
          rw [integral_sub (hD₂ ω).1 (hD₁' ω).1, (hD₂ ω).2, (hD₁' ω).2]
  -- Step 7: `S = C − (D₁ − D₂)` is integer multiplicity, `∂S = ∂C`, `spt(S − C) ⊆ K`
  have hSim : IsIntegerMultiplicity S := by
    have hSeq : S = C - (D₁ - D₂) := GeometricCurrentOn.ext fun ω => by
      show S ω = C ω - (D₁ ω - D₂ ω)
      linarith [key ω]
    rw [hSeq]
    exact Submission.regcomp_integer_multiplicity_sub P m univ C (D₁ - D₂) isOpen_univ hmin.1
      (Submission.regcomp_integer_multiplicity_sub P m univ D₁ D₂ isOpen_univ hD₁im hD₂im)
  have hvan : ∀ ω : TestFormOn (univ : Set (Euclid P)) m,
      tsupport (ω : DifferentialForm (Euclid P) m) ⊆ Kᶜ → (S - C) ω = 0 := by
    intro ω hω
    have h := hpb_eq ω fun y hy => image_eq_zero_of_notMem_tsupport fun h => hω h hy
    show S ω - C ω = 0
    rw [hSC ω, h, sub_self]
  have hsuppK : (S - C).support ⊆ K := by
    intro x hx
    by_contra hxK
    obtain ⟨r, hr, hrK⟩ := Metric.isOpen_iff.mp hKc.isClosed.isOpen_compl x hxK
    exact hx.2 (mem_sUnion.mpr ⟨ball x r, ⟨isOpen_ball,
      (isCompact_closedBall x r).of_isClosed_subset isClosed_closure closure_ball_subset_closedBall,
      subset_univ _, fun ω hω => hvan ω (hω.trans hrK)⟩, mem_ball_self hr⟩)
  -- minimality of `C` against `S`
  have hCS : C.massOn W ≤ S.massOn W :=
    hmin.2 W S hW ⟨hWc, subset_univ _⟩ hSim (hsame S C hSb hbdry)
      (hKc.of_isClosed_subset (isClosed_univ.sdiff (S - C).isOpen_zeroRegion) hsuppK)
      fun x hx => ⟨mem_univ x, hKW (hsuppK hx)⟩
  -- Step 8: `M_W(S) ≤ M_W(D₂) ≤ H^m(Φ(M ∩ W))`, since `C = D₁` on forms supported in `W`
  have hSmass : S.massOn W ≤ μHE[m] (Φ '' (M ∩ W)) := by
    refine sSup_le ?_
    rintro r ⟨ω, hω, rfl⟩
    have hCD : C ω = D₁ ω := by
      rw [hRep ω (hω.1.trans hWV), (hD₁' ω).2]
      exact hloc _ fun x hx => by
        simp only [image_eq_zero_of_notMem_tsupport fun h => hx (hω.1 h), map_zero]
    have hSD : S ω = D₂ ω := by linarith [key ω]
    show ENNReal.ofReal (S ω) ≤ _
    rw [hSD]
    exact (D₂.le_massOn hω).trans ((hD₂mass W).trans (measure_mono inter_subset_left))
  -- Step 9: cancel the finite common part `(M ∩ W) \ K`, using `Φ = id` off `K`, `Φ(K) ⊆ K`
  have himK : Φ '' (M ∩ W) ∩ K = Φ '' (M ∩ K) := by
    ext y
    constructor
    · rintro ⟨⟨x, ⟨hxM, -⟩, rfl⟩, hy⟩
      refine ⟨x, ⟨hxM, ?_⟩, rfl⟩
      by_contra hx
      rw [hΦid x hx] at hy
      exact hx hy
    · rintro ⟨x, ⟨hxM, hxK⟩, rfl⟩
      exact ⟨⟨x, ⟨hxM, hKW hxK⟩, rfl⟩, hΦK x hxK⟩
  have himW : Φ '' (M ∩ W) \ K = (M ∩ W) \ K := by
    ext y
    constructor
    · rintro ⟨⟨x, hx, rfl⟩, hy⟩
      have hxK : x ∉ K := fun hxK => hy (hΦK x hxK)
      rw [hΦid x hxK]
      exact ⟨hx, hxK⟩
    · rintro ⟨hy, hyK⟩
      exact ⟨⟨y, hy, hΦid y hyK⟩, hyK⟩
  have hb : μHE[m] ((M ∩ W) \ K) ≠ ∞ := ne_top_of_le_ne_top hMW (measure_mono sdiff_subset)
  have h1 := measure_inter_add_sdiff (μ := μHE[m]) (M ∩ W) hKm
  have h2 := measure_inter_add_sdiff (μ := μHE[m]) (Φ '' (M ∩ W)) hKm
  rw [inter_assoc, inter_eq_right.mpr hKW] at h1
  rw [himK, himW] at h2
  refine ENNReal.le_of_add_le_add_right hb ?_
  rw [h1, h2]
  exact ((hmass W hW hWV hMW).trans hCS).trans hSmass
/-- **Tangent projections of an embedded `C¹` submanifold** (Simon Ch. 2, §4, (4.1)–(4.3)).  Let
`M ⊆ ℝᴾ` be an embedded `C¹` `m`-dimensional submanifold, `S_x = span T_xM` and `P_x` the
orthogonal projection onto `S_x`.  Then (a) `dim S_x = m` on `M`, (b) `x ↦ P_x` is continuous on
`M`, and (c) `x ↦ trace(P_x ∘ DX(x))` is continuous on `M` for every `C¹` field `X`.  For a chart
`(V, W, ψ)`, `S_{ψ(v)} = Dψ(v)(ℝᵐ)` by `dsmc_chart_tangentSpace_eq_range`, and for injective `D`
the projection onto `D(ℝᵐ)` is `D (D*D)⁻¹ D*`, continuous in `v` since `Dψ` is continuous and
inversion is continuous at units.  Continuity of `ψ⁻¹` on `W ∩ M` moves this to `x = ψ(v)`; (c)
follows as the trace is linear on the finite-dimensional space `L(ℝᴾ)`. -/
theorem Submission.codim1_hcp_fv_tangent_projection_continuousOn : ∀ (P m : ℕ) (M : Set (Euclid P)), IsEmbeddedSubmanifold 1 m M → (∀ x ∈ M, Module.finrank ℝ (Submodule.span ℝ (tangentSpace M x)) = m) ∧ ContinuousOn (fun x => (Submodule.span ℝ (tangentSpace M x)).starProjection) M ∧ ∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → ContinuousOn (fun x => LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ X x).toLinearMap)) M := by
  intro P m M hM
  -- step 1: the span of the range of a continuous linear map is its range
  have hspan_range : ∀ D : Euclid m →L[ℝ] Euclid P,
      Submodule.span ℝ (Set.range D) = LinearMap.range (D : Euclid m →ₗ[ℝ] Euclid P) := by
    intro D
    rw [← ContinuousLinearMap.coe_coe, ← LinearMap.coe_range, Submodule.span_eq]
  -- step 2: for injective `D`, `G = D*D` is a unit and `P_{range D} = D G⁻¹ D*`
  have hproj : ∀ D : Euclid m →L[ℝ] Euclid P, Injective D →
      IsUnit (ContinuousLinearMap.adjoint D ∘L D) ∧
      (LinearMap.range (D : Euclid m →ₗ[ℝ] Euclid P)).starProjection =
        D ∘L (Ring.inverse (ContinuousLinearMap.adjoint D ∘L D) ∘L ContinuousLinearMap.adjoint D) := by
    intro D hD
    set G := ContinuousLinearMap.adjoint D ∘L D
    -- (a) `Gw = 0` gives `|Dw|² = ⟨Gw, w⟩ = 0`, so `w = 0`; injective endomorphisms are units
    have hGinj : Injective G := by
      rw [injective_iff_map_eq_zero]
      intro w hw
      apply hD
      rw [map_zero]
      have hnorm : ‖D w‖ ^ 2 = 0 := by
        rw [← real_inner_self_eq_norm_sq, ← ContinuousLinearMap.adjoint_inner_left]
        change inner ℝ (G w) w = 0
        rw [hw, inner_zero_left]
      exact norm_eq_zero.mp (pow_eq_zero_iff two_ne_zero |>.mp hnorm)
    have hGunit : IsUnit G := ContinuousLinearMap.isUnit_iff_bijective.mpr
      ⟨hGinj, (LinearMap.injective_iff_surjective (f := (G : Euclid m →ₗ[ℝ] Euclid m))).mp hGinj⟩
    refine ⟨hGunit, ?_⟩
    -- (b) with `y = G⁻¹D*h`, `Dy ∈ range D` and `h - Dy ⊥ range D`, so `P h = Dy`
    ext1 h
    set y := Ring.inverse G (ContinuousLinearMap.adjoint D h)
    have hGy : G y = ContinuousLinearMap.adjoint D h := by
      rw [← mul_apply_eq_comp, Ring.mul_inverse_cancel _ hGunit, one_apply_eq_self]
    change _ = D y
    refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero
      (LinearMap.mem_range_self (D : Euclid m →ₗ[ℝ] Euclid P) y) ?_
    rintro _ ⟨x, rfl⟩
    rw [ContinuousLinearMap.coe_coe, ← ContinuousLinearMap.adjoint_inner_left, map_sub]
    change inner ℝ (_ - G y) x = 0
    rw [hGy, sub_self, inner_zero_left]
  -- step 3: chart data at `y ∈ M`: `span T_{ψ v}M = range Dψ(v)` and `ψ⁻¹` is continuous
  have hlocal : ∀ y ∈ M, ∃ (V : Set (Euclid m)) (W : Set (Euclid P)) (ψ : Euclid m → Euclid P),
      IsOpen V ∧ IsOpen W ∧ y ∈ W ∧ ContDiffOn ℝ 1 ψ V ∧ ψ '' V = W ∩ M ∧
      (∀ z ∈ V, Injective (fderiv ℝ ψ z)) ∧
      (∀ v ∈ V, Submodule.span ℝ (tangentSpace M (ψ v)) =
        LinearMap.range (fderiv ℝ ψ v : Euclid m →ₗ[ℝ] Euclid P)) ∧
      (∀ v ∈ V, ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧
        ∀ v' ∈ V, dist (ψ v') (ψ v) < δ → dist v' v < ε) := by
    intro y hy
    obtain ⟨V, W, ψ, hV, hW, hyW, hψ, hinj, himg, hprop, hder⟩ := hM y hy
    refine ⟨V, W, ψ, hV, hW, hyW, hψ, himg, hder, fun v hv => ?_, fun v hv => ?_⟩
    · have h := (Submission.dsmc_chart_tangentSpace_eq_range P 1 m M V W ψ le_rfl hV hW hψ hinj
        himg hprop hder v hv).1
      rw [h, hspan_range]
    · exact (Submission.dsmc_chart_tangentSpace_eq_range P 1 m M V W ψ le_rfl hV hW hψ hinj
        himg hprop hder v hv).2.1
  -- step 4, (a): `S_{ψ v} = range Dψ(v)` with `Dψ(v)` injective has dimension `m`
  have hfin : ∀ x ∈ M, Module.finrank ℝ (Submodule.span ℝ (tangentSpace M x)) = m := by
    intro x hx
    obtain ⟨V, W, ψ, hV, hW, hxW, hψ, himg, hder, hsp, -⟩ := hlocal x hx
    obtain ⟨v, hv, rfl⟩ : x ∈ ψ '' V := by rw [himg]; exact ⟨hxW, hx⟩
    rw [hsp v hv, LinearMap.finrank_range_of_inj (hder v hv), finrank_euclideanSpace_fin]
  -- step 5, (b): `x ↦ P_x` is continuous within `M` at every `y = ψ(v₀)`
  have hcont : ContinuousOn (fun x => (Submodule.span ℝ (tangentSpace M x)).starProjection) M := by
    intro y hy
    obtain ⟨V, W, ψ, hV, hW, hyW, hψ, himg, hder, hsp, hinv⟩ := hlocal y hy
    obtain ⟨v₀, hv₀, rfl⟩ : y ∈ ψ '' V := by rw [himg]; exact ⟨hyW, hy⟩
    -- (a) `v ↦ D(v)`, `v ↦ D(v)*` and `v ↦ G(v) = D(v)*D(v)` are continuous on `V`
    have hD : ContinuousOn (fun v => fderiv ℝ ψ v) V := hψ.continuousOn_fderiv_of_isOpen hV le_rfl
    have hadj : Continuous (fun A : Euclid m →L[ℝ] Euclid P => ContinuousLinearMap.adjoint A) :=
      (ContinuousLinearMap.adjoint (𝕜 := ℝ) (E := Euclid m) (F := Euclid P)).continuous
    have hDt : ContinuousOn (fun v => ContinuousLinearMap.adjoint (fderiv ℝ ψ v)) V :=
      hadj.comp_continuousOn hD
    have hG : ContinuousOn
        (fun v => ContinuousLinearMap.adjoint (fderiv ℝ ψ v) ∘L fderiv ℝ ψ v) V :=
      hDt.clm_comp hD
    -- (b) each `G(v)` is a unit and inversion is continuous at units, so `R(v)` is continuous
    have hGinv : ContinuousOn (fun v =>
        Ring.inverse (ContinuousLinearMap.adjoint (fderiv ℝ ψ v) ∘L fderiv ℝ ψ v)) V := by
      intro v hv
      obtain ⟨u, hu⟩ := (hproj _ (hder v hv)).1
      have hinvc := NormedRing.inverse_continuousAt u
      rw [hu] at hinvc
      exact hinvc.comp_continuousWithinAt
        (f := fun v => ContinuousLinearMap.adjoint (fderiv ℝ ψ v) ∘L fderiv ℝ ψ v) (hG v hv)
    have hR : ContinuousOn (fun v => fderiv ℝ ψ v ∘L (Ring.inverse
        (ContinuousLinearMap.adjoint (fderiv ℝ ψ v) ∘L fderiv ℝ ψ v) ∘L
          ContinuousLinearMap.adjoint (fderiv ℝ ψ v))) V :=
      hD.clm_comp (hGinv.clm_comp hDt)
    -- (c) `P_{ψ v} = R(v)` on `V`
    have hPR : ∀ v ∈ V, (Submodule.span ℝ (tangentSpace M (ψ v))).starProjection =
        fderiv ℝ ψ v ∘L (Ring.inverse (ContinuousLinearMap.adjoint (fderiv ℝ ψ v) ∘L
          fderiv ℝ ψ v) ∘L ContinuousLinearMap.adjoint (fderiv ℝ ψ v)) := by
      intro v hv
      rw [← (hproj _ (hder v hv)).2]
      congr 1
      exact hsp v hv
    -- (d) `x ∈ M` near `ψ v₀` is `ψ v` with `v ∈ V` near `v₀`, so `P_x` is near `P_{ψ v₀}`
    rw [Metric.continuousWithinAt_iff]
    intro ε hε
    have hRat : ContinuousAt (fun v => fderiv ℝ ψ v ∘L (Ring.inverse
        (ContinuousLinearMap.adjoint (fderiv ℝ ψ v) ∘L fderiv ℝ ψ v) ∘L
          ContinuousLinearMap.adjoint (fderiv ℝ ψ v))) v₀ :=
      hR.continuousAt (hV.mem_nhds hv₀)
    obtain ⟨ρ, hρ, hρR⟩ := Metric.continuousAt_iff.mp hRat ε hε
    obtain ⟨δ₁, hδ₁, hδ₁inv⟩ := hinv v₀ hv₀ ρ hρ
    obtain ⟨δ₂, hδ₂, hδ₂W⟩ := Metric.isOpen_iff.mp hW (ψ v₀) hyW
    refine ⟨min δ₁ δ₂, lt_min hδ₁ hδ₂, fun {x} hxM hxy => ?_⟩
    have hxW : x ∈ W := hδ₂W (lt_of_lt_of_le hxy (min_le_right _ _))
    obtain ⟨v, hv, rfl⟩ : x ∈ ψ '' V := by rw [himg]; exact ⟨hxW, hxM⟩
    have hvv : dist v v₀ < ρ := hδ₁inv v hv (lt_of_lt_of_le hxy (min_le_left _ _))
    rw [hPR v hv, hPR v₀ hv₀]
    exact hρR hvv
  -- step 6, (c): `T ↦ trace T` is linear on `L(ℝᴾ)`, hence continuous; compose with `P_x ∘ DX(x)`
  refine ⟨hfin, hcont, fun X hX => ?_⟩
  have htr : Continuous (fun T : Euclid P →L[ℝ] Euclid P =>
      LinearMap.trace ℝ (Euclid P) (T : Euclid P →ₗ[ℝ] Euclid P)) :=
    LinearMap.continuous_of_finiteDimensional
      ((LinearMap.trace ℝ (Euclid P)).comp (ContinuousLinearMap.coeLM ℝ))
  have hcomp : ContinuousOn (fun x =>
      (Submodule.span ℝ (tangentSpace M x)).starProjection ∘L fderiv ℝ X x) M :=
    hcont.clm_comp (hX.continuous_fderiv one_ne_zero).continuousOn
  refine (htr.comp_continuousOn hcomp).congr fun x _ => ?_
  simp

/-- **Simon Ch. 2, (4.18)–(4.20)** (trace bound for a projected linear map): for a subspace `K` of
`ℝᴾ` and a continuous linear `L`, `|trace(p_K ∘ L)| ≤ (dim K) ‖L‖`.  For an orthonormal basis
`τ₁, …, τₙ` of `K`, `trace(p_K ∘ L) = Σₐ τₐ · Lτₐ`, and `|τₐ · Lτₐ| ≤ |τₐ| |Lτₐ| ≤ ‖L‖` by
Cauchy–Schwarz. -/
theorem Submission.codim1_hcp_fv_trace_comp_abs_le : ∀ (P : ℕ) (K : Submodule ℝ (Euclid P)) (L : Euclid P →L[ℝ] Euclid P), |LinearMap.trace ℝ (Euclid P) (K.starProjection.toLinearMap ∘ₗ L.toLinearMap)| ≤ (Module.finrank ℝ K : ℝ) * ‖L‖ := by
  intro P K L
  -- step 1: the standard orthonormal basis `e` of `K`, as vectors of `ℝᴾ`, is orthonormal
  set e := stdOrthonormalBasis ℝ K
  have hon : Orthonormal ℝ (fun i => ((e i : K) : Euclid P)) :=
    e.orthonormal.comp_linearIsometry K.subtypeₗᵢ
  -- step 2: it spans `K`, the image of `span (range e) = ⊤` under the inclusion
  have hspan : Submodule.span ℝ (Set.range (fun i => ((e i : K) : Euclid P))) = K := by
    have h : Set.range (fun i => ((e i : K) : Euclid P)) = K.subtype '' Set.range e := by
      rw [← Set.range_comp]; rfl
    have htop : Submodule.span ℝ (Set.range e) = ⊤ := by
      simpa using e.toBasis.span_eq
    rw [h, Submodule.span_image, htop, Submodule.map_top, Submodule.range_subtype]
  -- step 3: `trace(p_K ∘ L) = Σₐ ⟪τₐ, Lτₐ⟫`
  rw [Submission.fvmb_trace_starProjection_comp_eq_sum_inner P (Module.finrank ℝ K) K _ L hon hspan]
  -- steps 4-5: triangle inequality, then `|⟪τₐ, Lτₐ⟫| ≤ ‖τₐ‖ ‖L‖ ‖τₐ‖ = ‖L‖` termwise
  calc |∑ a, inner ℝ ((e a : K) : Euclid P) (L ((e a : K) : Euclid P))|
      ≤ ∑ a, |inner ℝ ((e a : K) : Euclid P) (L ((e a : K) : Euclid P))| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _a : Fin (Module.finrank ℝ K), ‖L‖ := by
        refine Finset.sum_le_sum fun a _ => ?_
        refine (abs_real_inner_le_norm _ _).trans ?_
        rw [hon.1 a, one_mul]
        exact (L.le_opNorm _).trans (by rw [hon.1 a, mul_one])
    _ = (Module.finrank ℝ K : ℝ) * ‖L‖ := by simp

/-- **Simon Ch. 2, §5** (the expansion `J_t = 1 + t div_M X + O(t²)` behind the first variation
formula 5.3, for the linear map `I + tB` on an `n`-plane): given `P`, `n`, `A ≥ 0` and `ε > 0`
there is `δ > 0` such that for `|t| < δ`, every subspace `K ⊆ ℝᴾ` with `dim K = n` and every `B`
with `‖B‖ ≤ A`, `(det(((I + tB) ∘ ι_K)* ((I + tB) ∘ ι_K)))^{1/2} ≤ 1 + t trace(p_K ∘ B) + ε|t|`.
In an orthonormal basis `e` of `K` the matrix of `((I + tB) ∘ ι_K)* ((I + tB) ∘ ι_K)` is the Gram
matrix `((I + tB)eᵢ · (I + tB)eⱼ)`, so the orthonormal-frame first-order bound applies with
`L = I + tB` (`‖L − I − tB‖ = 0`), and `Σₐ eₐ · Beₐ = trace(p_K ∘ B)` by the frame trace formula. -/
theorem Submission.codim1_hcp_fv_subspace_jacobian_first_order : ∀ (P n : ℕ) (A ε : ℝ), 0 ≤ A → 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ t : ℝ, |t| < δ → ∀ (K : Submodule ℝ (Euclid P)) (B : Euclid P →L[ℝ] Euclid P), Module.finrank ℝ K = n → ‖B‖ ≤ A → Real.sqrt ((((ContinuousLinearMap.id ℝ (Euclid P) + t • B).comp K.subtypeL).adjoint ∘L ((ContinuousLinearMap.id ℝ (Euclid P) + t • B).comp K.subtypeL)).det) ≤ 1 + t * LinearMap.trace ℝ (Euclid P) (K.starProjection.toLinearMap ∘ₗ B.toLinearMap) + ε * |t| := by
  intro P n A ε hA hε
  -- step 1: `η` and `δ` of the orthonormal-frame bound depend only on `P`, `n`, `A` and `ε`
  obtain ⟨η, hη, δ, hδ, hgram⟩ :=
    Submission.fvmb_orthonormal_gram_sqrt_det_le_first_order P n A ε hA hε
  refine ⟨δ, hδ, fun t ht K B hK hB => ?_⟩
  -- step 3: the standard orthonormal basis `e` of `K` is an orthonormal frame of `ℝᴾ` spanning `K`
  subst hK
  set e := stdOrthonormalBasis ℝ K
  have hon : Orthonormal ℝ (fun i => ((e i : K) : Euclid P)) :=
    e.orthonormal.comp_linearIsometry K.subtypeₗᵢ
  have hspan : Submodule.span ℝ (Set.range (fun i => ((e i : K) : Euclid P))) = K := by
    have h : Set.range (fun i => ((e i : K) : Euclid P)) = K.subtype '' Set.range e := by
      rw [← Set.range_comp]; rfl
    have htop : Submodule.span ℝ (Set.range e) = ⊤ := by
      simpa using e.toBasis.span_eq
    rw [h, Submodule.span_image, htop, Submodule.map_top, Submodule.range_subtype]
  -- step 4: the determinant on `K` is the Gram determinant of the frame `(L eᵢ)`
  have hgramdet : ∀ L : Euclid P →L[ℝ] Euclid P,
      ((L.comp K.subtypeL).adjoint ∘L (L.comp K.subtypeL)).det =
        Matrix.det (Matrix.of fun i j => inner ℝ (L ((e i : K) : Euclid P))
          (L ((e j : K) : Euclid P))) := by
    intro L
    rw [ContinuousLinearMap.det, ← LinearMap.det_toMatrix e.toBasis]
    congr 1
    ext i j
    rw [LinearMap.toMatrix_apply, OrthonormalBasis.coe_toBasis_repr_apply,
      OrthonormalBasis.coe_toBasis, OrthonormalBasis.repr_apply_apply, Matrix.of_apply]
    rw [ContinuousLinearMap.coe_coe, ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.adjoint_inner_right]
    rfl
  -- steps 5-6: the frame bound for `L = I + tB`, where `‖L − I − tB‖ = 0`, and the frame trace
  rw [hgramdet, Submission.fvmb_trace_starProjection_comp_eq_sum_inner P _ K _ B hon hspan]
  refine hgram t ht B _ hB ?_ _ hon
  have : ContinuousLinearMap.id ℝ (Euclid P) + t • B - ContinuousLinearMap.id ℝ (Euclid P) -
      t • B = 0 := by abel
  rw [this, norm_zero]
  exact mul_nonneg hη.le (abs_nonneg t)

/-- Small deformations `x ↦ x + t • Z x` by a compactly supported `C¹` field `Z` are injective
immersions (the maps `φ_t` of Simon Ch. 2, 5.1–5.2).  `DZ` is continuous with compact support, so
`‖DZ‖ ≤ Λ` for some `Λ ≥ 0`, and `|t| < 1 / (Λ + 1)` gives `|t| Λ < 1`.  By the mean value
inequality `Z` is `Λ`-Lipschitz, so `a + t • Z a = b + t • Z b` forces `‖a - b‖ ≤ |t| Λ ‖a - b‖`,
i.e. `a = b`; in the same way the derivative `I + t • DZ(x)` is injective. -/
theorem Submission.codim1_hcp_fv_perturbation_injective : ∀ (P : ℕ) (Z : Euclid P → Euclid P), ContDiff ℝ 1 Z → HasCompactSupport Z → ∃ c : ℝ, 0 < c ∧ ∀ t : ℝ, |t| < c → Injective (fun x => x + t • Z x) ∧ ∀ x, Injective (fderiv ℝ (fun x => x + t • Z x) x) := by
  intro P Z hZ hZc
  have hdiff : Differentiable ℝ Z := hZ.differentiable one_ne_zero
  -- step 1: `DZ` is continuous with compact support, hence bounded by some `Λ ≥ 0`
  obtain ⟨Λ₀, hΛ₀⟩ := (hZ.continuous_fderiv one_ne_zero).bounded_above_of_compact_support
    (hZc.fderiv (𝕜 := ℝ))
  obtain ⟨Λ, hΛ0, hΛ⟩ : ∃ Λ : ℝ, 0 ≤ Λ ∧ ∀ x, ‖fderiv ℝ Z x‖ ≤ Λ :=
    ⟨max Λ₀ 0, le_max_right _ _, fun x => (hΛ₀ x).trans (le_max_left _ _)⟩
  -- step 2: `c = 1 / (Λ + 1)`, so `|t| < c` gives `|t| Λ < 1`
  refine ⟨1 / (Λ + 1), by positivity, fun t ht => ?_⟩
  have htΛ : |t| * Λ < 1 := by
    have h1 : |t| * (Λ + 1) < 1 := by
      rwa [lt_div_iff₀ (by positivity)] at ht
    nlinarith [abs_nonneg t]
  -- step 3: mean value inequality, `‖Z a - Z b‖ ≤ Λ ‖a - b‖`
  have hlip : ∀ a b, ‖Z a - Z b‖ ≤ Λ * ‖a - b‖ := fun a b =>
    convex_univ.norm_image_sub_le_of_norm_fderiv_le (fun x _ => hdiff x) (fun x _ => hΛ x)
      (Set.mem_univ b) (Set.mem_univ a)
  refine ⟨fun a b hab => ?_, fun x => ?_⟩
  · -- step 4: `a - b = t • (Z b - Z a)` gives `‖a - b‖ ≤ |t| Λ ‖a - b‖`, so `a = b`
    have hab' : a - b = t • Z b - t • Z a := by
      rw [sub_eq_sub_iff_add_eq_add, add_comm (t • Z b) b]; exact hab
    have hn : ‖a - b‖ ≤ |t| * Λ * ‖a - b‖ := by
      calc ‖a - b‖ = |t| * ‖Z b - Z a‖ := by
            rw [hab', ← smul_sub, norm_smul, Real.norm_eq_abs]
        _ ≤ |t| * (Λ * ‖b - a‖) := mul_le_mul_of_nonneg_left (hlip b a) (abs_nonneg t)
        _ = |t| * Λ * ‖a - b‖ := by rw [norm_sub_rev]; ring
    have h0 : ‖a - b‖ = 0 := by
      by_contra hne
      have hpos : 0 < ‖a - b‖ := lt_of_le_of_ne (norm_nonneg _) (Ne.symm hne)
      nlinarith
    exact sub_eq_zero.mp (norm_eq_zero.mp h0)
  · -- step 5: `D(x + t • Z x) = I + t • DZ(x)`, and `‖v - w‖ ≤ |t| Λ ‖v - w‖` as in step 4
    have hfd : fderiv ℝ (fun x => x + t • Z x) x =
        ContinuousLinearMap.id ℝ (Euclid P) + t • fderiv ℝ Z x :=
      ((hasFDerivAt_id x).add ((hdiff x).hasFDerivAt.const_smul t)).fderiv
    rw [hfd]
    intro v w hvw
    have hvw' : v - w = t • fderiv ℝ Z x w - t • fderiv ℝ Z x v := by
      rw [sub_eq_sub_iff_add_eq_add, add_comm (t • fderiv ℝ Z x w) w]; exact hvw
    have hn : ‖v - w‖ ≤ |t| * Λ * ‖v - w‖ := by
      calc ‖v - w‖ = |t| * ‖fderiv ℝ Z x (w - v)‖ := by
            conv_lhs => rw [hvw']
            rw [← smul_sub, ← map_sub, norm_smul, Real.norm_eq_abs]
        _ ≤ |t| * (Λ * ‖w - v‖) :=
          mul_le_mul_of_nonneg_left ((fderiv ℝ Z x).le_of_opNorm_le (hΛ x) (w - v))
            (abs_nonneg t)
        _ = |t| * Λ * ‖v - w‖ := by rw [norm_sub_rev]; ring
    have h0 : ‖v - w‖ = 0 := by
      by_contra hne
      have hpos : 0 < ‖v - w‖ := lt_of_le_of_ne (norm_nonneg _) (Ne.symm hne)
      nlinarith
    exact sub_eq_zero.mp (norm_eq_zero.mp h0)
/-- Simon Ch. 2, §5 (first variation, 5.1–5.3), in one-sided form: if `M` is an embedded `C¹`
`m`-submanifold, `Z` is `C¹` with compact support, `E = M ∩ spt Z` has `Hᵐ(E) < ∞`, and
`Hᵐ(E) ≤ ∫_E J_t dHᵐ` for `|t| < t₀`, where `J_t` is the Jacobian of `Φ_t = id + tZ` along
`span T_xM`, then `∫_M div_M Z dHᵐ = 0`.  Instead of differentiating under the integral sign:
`J_t ≤ 1 + t div_M Z + ε|t|` uniformly on `E` for small `|t|`, so monotonicity of the lower
integral gives `0 ≤ t ∫_E div_M Z + ε|t| Hᵐ(E)`; `t = ±T/2` and `ε → 0` give
`∫_E div_M Z = 0`, and `div_M Z = 0` off `spt Z`. -/
theorem Submission.codim1_hcp_fv_jacobian_minimal_stationary : ∀ (P m : ℕ) (M : Set (Euclid P)) (Z : Euclid P → Euclid P), IsEmbeddedSubmanifold 1 m M → ContDiff ℝ 1 Z → HasCompactSupport Z → μHE[m] (M ∩ tsupport Z) ≠ ∞ → (∃ t₀ : ℝ, 0 < t₀ ∧ ∀ t : ℝ, |t| < t₀ → μHE[m] (M ∩ tsupport Z) ≤ ∫⁻ x in M ∩ tsupport Z, ENNReal.ofReal (Real.sqrt ((((fderiv ℝ (fun y => y + t • Z y) x).comp (Submodule.span ℝ (tangentSpace M x)).subtypeL).adjoint ∘L ((fderiv ℝ (fun y => y + t • Z y) x).comp (Submodule.span ℝ (tangentSpace M x)).subtypeL)).det)) ∂μHE[m]) → ∫ x in M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ Z x).toLinearMap) ∂μHE[m] = 0 := by
  intro P m M Z hM hZ hZc hfin ⟨t₀, ht₀, hmin⟩
  set τ : Euclid P → ℝ := fun x => LinearMap.trace ℝ (Euclid P)
    ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
      (fderiv ℝ Z x).toLinearMap) with hτ_def
  have hMmeas : MeasurableSet M := (Submission.dimred_rpd_embedded_locally_closed P 1 m M hM).1
  have hEmeas : MeasurableSet (M ∩ tsupport Z) := hMmeas.inter (isClosed_tsupport Z).measurableSet
  obtain ⟨hfr, -, hdivc⟩ := Submission.codim1_hcp_fv_tangent_projection_continuousOn P m M hM
  have hdiff : Differentiable ℝ Z := hZ.differentiable one_ne_zero
  obtain ⟨Λ₀, hΛ₀⟩ := (hZ.continuous_fderiv one_ne_zero).bounded_above_of_compact_support
    (hZc.fderiv (𝕜 := ℝ))
  set Λ := max Λ₀ 0 with hΛ_def
  have hΛ : ∀ x, ‖fderiv ℝ Z x‖ ≤ Λ := fun x => (hΛ₀ x).trans (le_max_left _ _)
  have hΛ0 : 0 ≤ Λ := le_max_right _ _
  -- |div_M Z| ≤ mΛ on M
  have hτb : ∀ x ∈ M, |τ x| ≤ m * Λ := by
    intro x hx
    have h := Submission.codim1_hcp_fv_trace_comp_abs_le P (Submodule.span ℝ (tangentSpace M x))
      (fderiv ℝ Z x)
    rw [hfr x hx] at h
    exact h.trans (mul_le_mul_of_nonneg_left (hΛ x) (Nat.cast_nonneg m))
  -- measurability and integrability of div_M Z on E = M ∩ tsupport Z
  have hτmeas : AEStronglyMeasurable τ (μHE[m].restrict M) :=
    (hdivc Z hZ).aestronglyMeasurable hMmeas
  have hτmeasE : AEStronglyMeasurable τ (μHE[m].restrict (M ∩ tsupport Z)) :=
    hτmeas.mono_measure (Measure.restrict_mono inter_subset_left le_rfl)
  have hτint : IntegrableOn τ (M ∩ tsupport Z) μHE[m] :=
    IntegrableOn.of_bound hfin.lt_top hτmeasE (m * Λ)
      (ae_restrict_of_forall_mem hEmeas fun x hx => by
        rw [Real.norm_eq_abs]; exact hτb x hx.1)
  -- derivative of the deformation Φ_t = id + tZ
  have hfd : ∀ (t : ℝ) (x : Euclid P), fderiv ℝ (fun y => y + t • Z y) x =
      ContinuousLinearMap.id ℝ (Euclid P) + t • fderiv ℝ Z x := fun t x =>
    ((hasFDerivAt_id x).add ((hdiff x).hasFDerivAt.const_smul t)).fderiv
  set a := (μHE[m] (M ∩ tsupport Z)).toReal with ha_def
  have ha0 : 0 ≤ a := ENNReal.toReal_nonneg
  set I := ∫ x in M ∩ tsupport Z, τ x ∂μHE[m] with hI_def
  -- one-sided first-order inequality: 0 ≤ t I + ε |t| a for small |t|
  have key : ∀ ε : ℝ, 0 < ε → ∃ T : ℝ, 0 < T ∧ ∀ t : ℝ, |t| < T → 0 ≤ t * I + ε * |t| * a := by
    intro ε hε
    obtain ⟨δ, hδ, hJ⟩ := Submission.codim1_hcp_fv_subspace_jacobian_first_order P m Λ ε hΛ0 hε
    refine ⟨min t₀ (min δ (1 / (m * Λ + 1))), lt_min ht₀ (lt_min hδ (by positivity)),
      fun t ht => ?_⟩
    have ht₀' : |t| < t₀ := lt_of_lt_of_le ht (min_le_left _ _)
    have htδ : |t| < δ := lt_of_lt_of_le ht ((min_le_right _ _).trans (min_le_left _ _))
    have htc : |t| < 1 / (m * Λ + 1) :=
      lt_of_lt_of_le ht ((min_le_right _ _).trans (min_le_right _ _))
    have htmΛ : |t| * (m * Λ) ≤ 1 := by
      have hpos : 0 < (m : ℝ) * Λ + 1 := by positivity
      rw [lt_div_iff₀ hpos] at htc
      nlinarith [abs_nonneg t, mul_nonneg (Nat.cast_nonneg m : (0:ℝ) ≤ m) hΛ0]
    have hnn : ∀ x ∈ M ∩ tsupport Z, 0 ≤ 1 + t * τ x + ε * |t| := by
      intro x hx
      have h1 : |t * τ x| ≤ 1 := by
        rw [abs_mul]
        exact (mul_le_mul_of_nonneg_left (hτb x hx.1) (abs_nonneg t)).trans htmΛ
      have h2 : -1 ≤ t * τ x := (abs_le.mp h1).1
      nlinarith [abs_nonneg t]
    have hpt : ∀ x ∈ M ∩ tsupport Z,
        ENNReal.ofReal (Real.sqrt ((((fderiv ℝ (fun y => y + t • Z y) x).comp
          (Submodule.span ℝ (tangentSpace M x)).subtypeL).adjoint ∘L
            ((fderiv ℝ (fun y => y + t • Z y) x).comp
              (Submodule.span ℝ (tangentSpace M x)).subtypeL)).det)) ≤
          ENNReal.ofReal (1 + t * τ x + ε * |t|) := by
      intro x hx
      apply ENNReal.ofReal_le_ofReal
      rw [hfd t x]
      exact hJ t htδ _ _ (hfr x hx.1) (hΛ x)
    have hc : IntegrableOn (fun _ : Euclid P => (1 : ℝ)) (M ∩ tsupport Z) μHE[m] :=
      integrableOn_const hfin
    have hc' : IntegrableOn (fun _ : Euclid P => ε * |t|) (M ∩ tsupport Z) μHE[m] :=
      integrableOn_const hfin
    have hint : IntegrableOn (fun x => 1 + t * τ x + ε * |t|) (M ∩ tsupport Z) μHE[m] :=
      (hc.add (hτint.const_mul t)).add hc'
    have h2 := (hmin t ht₀').trans (setLIntegral_mono' hEmeas hpt)
    rw [← ofReal_integral_eq_lintegral_ofReal hint (ae_restrict_of_forall_mem hEmeas hnn)] at h2
    have hcalc : ∫ x in M ∩ tsupport Z, (1 + t * τ x + ε * |t|) ∂μHE[m] =
        a + t * I + ε * |t| * a := by
      have e1 : ∫ x in M ∩ tsupport Z, (1 + t * τ x + ε * |t|) ∂μHE[m] =
          ∫ x in M ∩ tsupport Z, (1 + t * τ x) ∂μHE[m] +
            ∫ x in M ∩ tsupport Z, ε * |t| ∂μHE[m] :=
        integral_add (hc.add (hτint.const_mul t)) hc'
      have e2 : ∫ x in M ∩ tsupport Z, (1 + t * τ x) ∂μHE[m] =
          ∫ x in M ∩ tsupport Z, (1 : ℝ) ∂μHE[m] + ∫ x in M ∩ tsupport Z, t * τ x ∂μHE[m] :=
        integral_add hc (hτint.const_mul t)
      rw [e1, e2, integral_const_mul, setIntegral_const, setIntegral_const]
      simp only [smul_eq_mul, Measure.real, ha_def, hI_def]
      ring
    rw [hcalc] at h2
    have hrhs : 0 ≤ a + t * I + ε * |t| * a := by
      rw [← hcalc]
      exact setIntegral_nonneg hEmeas hnn
    rw [← ENNReal.ofReal_toReal hfin, ENNReal.ofReal_le_ofReal_iff hrhs] at h2
    linarith
  -- Fermat: |I| ≤ ε a for every ε > 0, hence I = 0
  have hI0 : I = 0 := by
    have hbound : ∀ ε : ℝ, 0 < ε → |I| ≤ ε * a := by
      intro ε hε
      obtain ⟨T, hT, hTI⟩ := key ε hε
      have hpos := hTI (T / 2) (by rw [abs_of_pos (by positivity)]; linarith)
      have hneg := hTI (-(T / 2)) (by rw [abs_neg, abs_of_pos (by positivity)]; linarith)
      rw [abs_of_pos (by positivity : (0:ℝ) < T / 2)] at hpos
      rw [abs_neg, abs_of_pos (by positivity : (0:ℝ) < T / 2)] at hneg
      have h1 : -(ε * a) ≤ I := by nlinarith
      have h2 : I ≤ ε * a := by nlinarith
      exact abs_le.mpr ⟨h1, h2⟩
    by_contra hne
    have hIpos : 0 < |I| := abs_pos.mpr hne
    have := hbound (|I| / (2 * (a + 1))) (by positivity)
    have hlt : |I| / (2 * (a + 1)) * a < |I| := by
      rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
      nlinarith
    linarith
  -- div_M Z vanishes on M \ tsupport Z, so ∫_M = ∫_{M ∩ tsupport Z}
  have hzero : ∀ x ∈ M \ (M ∩ tsupport Z), τ x = 0 := by
    intro x hx
    have hxs : x ∉ tsupport Z := fun h => hx.2 ⟨hx.1, h⟩
    have hD : fderiv ℝ Z x = 0 := by
      by_contra hne
      exact hxs (support_fderiv_subset ℝ hne)
    simp only [hτ_def, hD, ContinuousLinearMap.toLinearMap_zero, LinearMap.comp_zero, map_zero]
  rw [setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hMmeas inter_subset_left hzero]
  exact hI0
/-- Simon Ch. 2, §5 (p. 63), stationarity tested with `C¹` fields: if `M` is an embedded `C¹`
`m`-submanifold with `Hᵐ(M ∩ K) < ∞` for compact `K ⊆ U` and `∫_M div_M Z dHᵐ = 0` for every `C^∞`
field `Z` with compact support in `U`, then the same holds for every `C¹` such field `X`.  The `C^∞`
maps `ψₖ → id + X` of `dpf_smooth_approx_compact_perturbation` equal `id` off one compact `K' ⊆ U`,
so `Xₖ = ψₖ − id` are admissible, `‖DXₖ‖ ≤ C + 1`, `DXₖ = 0` off `K'` and `DXₖ → DX` pointwise.
With `dim T_xM = m`, `|div_M Xₖ| ≤ m(C + 1)·1_{K'}`, which is `Hᵐ⌞M`-integrable, so dominated
convergence gives `∫_M div_M X = lim ∫_M div_M Xₖ = 0`. -/
theorem Submission.codim1_hcp_fv_smooth_to_C1_stationary : ∀ (P m : ℕ) (U M : Set (Euclid P)), IsOpen U → IsEmbeddedSubmanifold 1 m M → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[m] (M ∩ K) ≠ ∞) → (∀ Z : Euclid P → Euclid P, ContDiff ℝ (⊤ : ℕ∞) Z → HasCompactSupport Z → tsupport Z ⊆ U → ∫ x in M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ Z x).toLinearMap) ∂μHE[m] = 0) → ∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ U → ∫ x in M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ X x).toLinearMap) ∂μHE[m] = 0 := by
  intro P m U M hU hM hfin hsmooth X hX hXc hXU
  -- Step 1: `M` is Borel, `dim T_xM = m` on `M`, and `div_M Y` is continuous on `M` for `C¹` `Y`
  have hMmeas : MeasurableSet M := (Submission.dimred_rpd_embedded_locally_closed P 1 m M hM).1
  obtain ⟨hfr, -, hdivc⟩ := Submission.codim1_hcp_fv_tangent_projection_continuousOn P m M hM
  -- Step 2: `C^∞` maps `ψ k` equal to `id` off one compact `K' ⊆ U`, with `‖Dψ k‖ ≤ C` and
  -- `Dψ k → D(id + X)` pointwise
  obtain ⟨ψ, K', C, hK', hK'U, hψs, hψid, hψC, -, hψD⟩ :=
    Submission.dpf_smooth_approx_compact_perturbation P U (tsupport X) (fun x => x + X x) hU hXc
      hXU (contDiff_id.add hX) (fun x hx => by simp [image_eq_zero_of_notMem_tsupport hx])
  -- Step 3: the `C^∞` fields `Xk k = ψ k - id` vanish off `K'`, so `∫_M div_M (Xk k) = 0`
  set Xk : ℕ → Euclid P → Euclid P := fun k x => ψ k x - x
  have hXks : ∀ k, ContDiff ℝ (⊤ : ℕ∞) (Xk k) := fun k => (hψs k).sub contDiff_id
  have hXk0 : ∀ k x, x ∉ K' → Xk k x = 0 := fun k x hx => by simp [Xk, hψid k x hx]
  have hXkts : ∀ k, tsupport (Xk k) ⊆ K' := fun k =>
    closure_minimal (support_subset_iff'.2 (hXk0 k)) hK'.isClosed
  have hstat : ∀ k, ∫ x in M, LinearMap.trace ℝ (Euclid P)
      ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
        (fderiv ℝ (Xk k) x).toLinearMap) ∂μHE[m] = 0 := fun k =>
    hsmooth (Xk k) (hXks k) (HasCompactSupport.intro hK' (hXk0 k)) ((hXkts k).trans hK'U)
  -- Step 4: `D(Xk k) = Dψ k - I`, so `‖D(Xk k)‖ ≤ C + 1`, `D(Xk k) → DX` and `D(Xk k) = 0` off `K'`
  have hψd : ∀ k, Differentiable ℝ (ψ k) := fun k => (hψs k).differentiable (by simp)
  have hDXk : ∀ k x, fderiv ℝ (Xk k) x = fderiv ℝ (ψ k) x - ContinuousLinearMap.id ℝ (Euclid P) :=
    fun k x => ((hψd k x).hasFDerivAt.sub (hasFDerivAt_id x)).fderiv
  have hDφ : ∀ x, fderiv ℝ (fun x => x + X x) x =
      ContinuousLinearMap.id ℝ (Euclid P) + fderiv ℝ X x :=
    fun x => ((hasFDerivAt_id x).add ((hX.differentiable one_ne_zero) x).hasFDerivAt).fderiv
  have hconv : ∀ x, Tendsto (fun k => fderiv ℝ (Xk k) x) atTop (𝓝 (fderiv ℝ X x)) := by
    intro x
    have h := (hψD x).sub_const (ContinuousLinearMap.id ℝ (Euclid P))
    rw [hDφ x, add_sub_cancel_left] at h
    simpa only [hDXk] using h
  have hDXkb : ∀ k x, ‖fderiv ℝ (Xk k) x‖ ≤ C + 1 := by
    intro k x
    rw [hDXk]
    exact (norm_sub_le _ _).trans (add_le_add (hψC k x) ContinuousLinearMap.norm_id_le)
  have hDXk0 : ∀ k x, x ∉ K' → fderiv ℝ (Xk k) x = 0 := fun k x hx =>
    fderiv_of_notMem_tsupport ℝ fun h => hx (hXkts k h)
  -- Step 5: the dominating function `g = m (C + 1) 1_{K'}` is integrable, `Hᵐ(M ∩ K') < ∞`
  set g : Euclid P → ℝ := K'.indicator (fun _ => (m : ℝ) * (C + 1)) with hg_def
  have hg : Integrable g (μHE[m].restrict M) := by
    rw [hg_def, integrable_indicator_iff hK'.isClosed.measurableSet]
    refine integrableOn_const ?_
    rw [Measure.restrict_apply hK'.isClosed.measurableSet, inter_comm]
    exact hfin K' hK' hK'U
  -- `|div_M (Xk k)| ≤ dim T_xM ‖D(Xk k)‖ ≤ m (C + 1)` on `M ∩ K'`, and `div_M (Xk k) = 0` off `K'`
  have hbound : ∀ k, ∀ᵐ x ∂(μHE[m].restrict M), ‖LinearMap.trace ℝ (Euclid P)
      ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
        (fderiv ℝ (Xk k) x).toLinearMap)‖ ≤ g x := by
    intro k
    filter_upwards [ae_restrict_mem hMmeas] with x hx
    by_cases hxK : x ∈ K'
    · rw [hg_def, indicator_of_mem hxK, Real.norm_eq_abs]
      have h := Submission.codim1_hcp_fv_trace_comp_abs_le P
        (Submodule.span ℝ (tangentSpace M x)) (fderiv ℝ (Xk k) x)
      rw [hfr x hx] at h
      exact h.trans (mul_le_mul_of_nonneg_left (hDXkb k x) (Nat.cast_nonneg m))
    · rw [hg_def, indicator_of_notMem hxK, hDXk0 k x hxK]
      simp
  -- Step 6: `div_M (Xk k) → div_M X` pointwise, `L ↦ trace (P_x ∘ L)` being linear on a
  -- finite-dimensional space
  have hlim : ∀ᵐ x ∂(μHE[m].restrict M), Tendsto (fun k => LinearMap.trace ℝ (Euclid P)
      ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
        (fderiv ℝ (Xk k) x).toLinearMap)) atTop
      (𝓝 (LinearMap.trace ℝ (Euclid P)
        ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
          (fderiv ℝ X x).toLinearMap))) := by
    refine Eventually.of_forall fun x => ?_
    have htr : Continuous (fun T : Euclid P →L[ℝ] Euclid P =>
        LinearMap.trace ℝ (Euclid P) (T : Euclid P →ₗ[ℝ] Euclid P)) :=
      LinearMap.continuous_of_finiteDimensional
        ((LinearMap.trace ℝ (Euclid P)).comp (ContinuousLinearMap.coeLM ℝ))
    have hF : Continuous (fun L : Euclid P →L[ℝ] Euclid P => LinearMap.trace ℝ (Euclid P)
        ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ L.toLinearMap)) := by
      have := htr.comp (Continuous.clm_comp
        (g := fun _ : Euclid P →L[ℝ] Euclid P =>
          (Submodule.span ℝ (tangentSpace M x)).starProjection)
        (f := id) continuous_const continuous_id)
      refine this.congr fun L => ?_
      simp only [Function.comp_apply, id]
      rfl
    exact (hF.tendsto _).comp (hconv x)
  -- Step 7: `div_M (Xk k)` is continuous on the Borel set `M`, hence measurable
  have hmeas : ∀ k, AEStronglyMeasurable (fun x => LinearMap.trace ℝ (Euclid P)
      ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ
        (fderiv ℝ (Xk k) x).toLinearMap)) (μHE[m].restrict M) :=
    fun k => (hdivc (Xk k) ((hXks k).of_le (by exact_mod_cast le_top))).aestronglyMeasurable hMmeas
  -- Step 8: dominated convergence, `∫_M div_M X = lim ∫_M div_M (Xk k) = 0`
  have hT := tendsto_integral_of_dominated_convergence g hmeas hg hbound hlim
  simp only [hstat] at hT
  exact tendsto_nhds_unique hT tendsto_const_nhds

/-- **Area formula on an embedded `C¹` submanifold** (Simon Ch. 2, 4.11–4.13, as used in Ch. 2,
5.1–5.2).  Let `M ⊂ ℝᴾ` be an embedded `m`-dimensional `C¹` submanifold, `E ⊆ M` Borel, and
`Φ : ℝᴾ → ℝᴾ` a `C¹` map that is injective on `E` with `DΦ(x)` injective for `x ∈ E`.  Then
`Hᵐ(Φ(E)) = ∫_E J^M Φ dHᵐ`, where `J^M Φ(x) = √det((DΦ(x) ∘ ι_x)*(DΦ(x) ∘ ι_x))` and
`ι_x : span T_xM → ℝᴾ` is the inclusion.  By Lindelöf countably many charts `W_k` cover `M`; on
each of the disjoint Borel pieces `E_k = (E ∩ W_k) \ ⋃_{j<k} (E ∩ W_j)` this is the area formula
in one chart.  Summing over `k` gives the claim: the integral is countably additive over the
`E_k`, and so is `Hᵐ(Φ(·))`, since the images `Φ(E_k)` are Borel (Lusin–Souslin) and pairwise
disjoint (`Φ` is injective on `E`). -/
theorem Submission.codim1_hcp_submanifold_area_formula : ∀ (P m : ℕ) (M E : Set (Euclid P)) (Φ : Euclid P → Euclid P), IsEmbeddedSubmanifold 1 m M → MeasurableSet E → E ⊆ M → ContDiff ℝ 1 Φ → InjOn Φ E → (∀ x ∈ E, Injective (fderiv ℝ Φ x)) → μHE[m] (Φ '' E) = ∫⁻ x in E, ENNReal.ofReal (Real.sqrt ((((fderiv ℝ Φ x).comp (Submodule.span ℝ (tangentSpace M x)).subtypeL).adjoint ∘L ((fderiv ℝ Φ x).comp (Submodule.span ℝ (tangentSpace M x)).subtypeL)).det)) ∂μHE[m] := by
  intro P m M E Φ hM hE hEM hΦ hΦinj hDΦ
  -- step 2: countably many charts `(V_k, W_k, ψ_k)` of `M` as in (4.1) and pairwise disjoint
  -- Borel pieces `E_k ⊆ W_k ∩ M` with `⋃_k E_k = E`
  obtain ⟨Es, Vs, Ws, ψs, hEs, hdisj, hunion, hcharts⟩ : ∃ (Es : ℕ → Set (Euclid P)) (Vs : ℕ → Set (Euclid m)) (Ws : ℕ → Set (Euclid P)) (ψs : ℕ → Euclid m → Euclid P), (∀ k, MeasurableSet (Es k)) ∧ Pairwise (fun i j => Disjoint (Es i) (Es j)) ∧ (⋃ k, Es k) = E ∧ ∀ k, IsOpen (Vs k) ∧ IsOpen (Ws k) ∧ ContDiffOn ℝ 1 (ψs k) (Vs k) ∧ InjOn (ψs k) (Vs k) ∧ ψs k '' Vs k = Ws k ∩ M ∧ (∀ K ⊆ Ws k, IsCompact K → IsCompact (Vs k ∩ ψs k ⁻¹' K)) ∧ (∀ z ∈ Vs k, Injective (fderiv ℝ (ψs k) z)) ∧ Es k ⊆ Ws k ∩ M := by
    -- every `y ∈ M` has a chart `(V_y, W_y, ψ_y)` with `y ∈ W_y`; every `y ∉ M` gets the empty
    -- chart `(∅, ∅, 0)`, which satisfies all chart conditions
    have hchart : ∀ y : Euclid P, ∃ (V : Set (Euclid m)) (W : Set (Euclid P))
        (ψ : Euclid m → Euclid P), IsOpen V ∧ IsOpen W ∧ ContDiffOn ℝ 1 ψ V ∧ InjOn ψ V ∧
          ψ '' V = W ∩ M ∧ (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) ∧
          (∀ z ∈ V, Injective (fderiv ℝ ψ z)) ∧ (y ∈ M → y ∈ W) := by
      intro y
      by_cases hy : y ∈ M
      · obtain ⟨V, W, ψ, hV, hW, hyW, hψ, hinj, himg, hprop, hD⟩ := hM y hy
        exact ⟨V, W, ψ, hV, hW, by exact_mod_cast hψ, hinj, himg, hprop, hD, fun _ => hyW⟩
      · exact ⟨∅, ∅, 0, isOpen_empty, isOpen_empty, contDiffOn_empty, injOn_empty _, by simp,
          by simp, by simp, fun h => absurd h hy⟩
    choose V W ψ hV hW hψ hinj himg hprop hD hyW using hchart
    -- Lindelöf: the `W_y` with `y` in a countable set `T ⊆ {y_0, y_1, …}` already cover `M`
    obtain ⟨T, hTc, hTU⟩ := TopologicalSpace.isOpen_iUnion_countable W hW
    obtain ⟨f, hf⟩ := Set.countable_iff_exists_subset_range.1 hTc
    have hcover : M ⊆ ⋃ k, W (f k) := by
      intro y hy
      have hyT : y ∈ ⋃ i ∈ T, W i := by
        rw [hTU]
        exact mem_iUnion.2 ⟨y, hyW y hy⟩
      obtain ⟨i, hiT, hyi⟩ := mem_iUnion₂.1 hyT
      obtain ⟨k, rfl⟩ := hf hiT
      exact mem_iUnion.2 ⟨k, hyi⟩
    -- `E_k = (E ∩ W_{y_k}) \ ⋃_{j<k} (E ∩ W_{y_j})`, with the chart at `y_k`
    refine ⟨disjointed fun k => E ∩ W (f k), fun k => V (f k), fun k => W (f k),
      fun k => ψ (f k), MeasurableSet.disjointed fun k => hE.inter (hW (f k)).measurableSet,
      disjoint_disjointed _, ?_, fun k => ⟨hV (f k), hW (f k), hψ (f k), hinj (f k), himg (f k),
        hprop (f k), hD (f k), fun x hx => ?_⟩⟩
    -- `⋃_k E_k = E ∩ ⋃_k W_{y_k} = E`, as `E ⊆ M ⊆ ⋃_k W_{y_k}`
    · rw [iUnion_disjointed, ← inter_iUnion]
      exact inter_eq_left.2 (hEM.trans hcover)
    -- `E_k ⊆ E ∩ W_{y_k} ⊆ W_{y_k} ∩ M`
    · have hx' := disjointed_subset _ k hx
      exact ⟨hx'.2, hEM hx'.1⟩
  choose hV hW hψ hinj himg hprop hD hEW using hcharts
  have hEsE : ∀ k, Es k ⊆ E := fun k => (subset_iUnion Es k).trans hunion.subset
  -- steps 4–8 on each piece `E_k ⊆ W_k ∩ M`: the area formula inside the chart `ψ_k`
  have hpiece := fun k => Submission.codim1_hcp_af_chart_area_formula P m M (Es k) (Ws k) (Vs k)
    (ψs k) Φ (hV k) (hW k) (hψ k) (hinj k) (himg k) (hprop k) (hD k) (hEs k) (hEW k) hΦ
    (hΦinj.mono (hEsE k)) fun x hx => hDΦ x (hEsE k hx)
  -- step 9: the images `Φ(E_k)` are Borel (Lusin–Souslin) and pairwise disjoint (`Φ` is
  -- injective on `E`), so `Hᵐ(Φ(E)) = Σ_k Hᵐ(Φ(E_k))`; the integral over `E` splits likewise
  have hΦEs : ∀ k, MeasurableSet (Φ '' Es k) := fun k =>
    (hEs k).image_of_continuousOn_injOn hΦ.continuous.continuousOn (hΦinj.mono (hEsE k))
  have hΦdisj : Pairwise (Disjoint on fun k => Φ '' Es k) := fun i j hij =>
    (hdisj hij).image hΦinj (hEsE i) (hEsE j)
  rw [← hunion, image_iUnion, measure_iUnion hΦdisj hΦEs, lintegral_iUnion hEs hdisj]
  exact tsum_congr hpiece

/-- **Simon Ch. 2, §5 (5.1–5.4)**: a deformation-minimal `C¹` submanifold is stationary.  Let
`M ⊆ U` be an embedded `C¹` `m`-submanifold with `Hᵐ(M ∩ K) < ∞` for compact `K ⊆ U`, whose area
does not decrease under the deformations `x ↦ x + tZ(x)`, `Z` smooth with compact support in `U`.
Then `∫_M div_M X dHᵐ = 0` for every `C¹` field `X` with compact support in `U`.  By smooth
approximation of `X` it suffices to take `X = Z` smooth.  `E = M ∩ spt Z` is Borel with
`Hᵐ(E) < ∞`, and for small `|t|` the map `Φₜ = id + tZ` is `C¹`, injective and has injective
differential.  So the area formula turns `Hᵐ(E) ≤ Hᵐ(Φₜ(E))` into `Hᵐ(E) ≤ ∫_E Jₜ dHᵐ`, and the
first-order expansion of the Jacobian `Jₜ` at `t = 0` gives `∫_M div_M Z dHᵐ = 0`. -/
theorem Submission.codim1_hcp_deformation_minimal_stationary : ∀ (P m : ℕ) (U M : Set (Euclid P)), IsOpen U → M ⊆ U → IsEmbeddedSubmanifold 1 m M → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[m] (M ∩ K) ≠ ∞) → (∀ Z : Euclid P → Euclid P, ContDiff ℝ (⊤ : ℕ∞) Z → HasCompactSupport Z → tsupport Z ⊆ U → ∃ t₀ : ℝ, 0 < t₀ ∧ ∀ t : ℝ, |t| < t₀ → μHE[m] (M ∩ tsupport Z) ≤ μHE[m] ((fun x => x + t • Z x) '' (M ∩ tsupport Z))) → ∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ U → ∫ x in M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ X x).toLinearMap) ∂μHE[m] = 0 := by
  intro P m U M hU _ hM hfin hdef
  -- it suffices to prove `∫_M div_M Z dHᵐ = 0` for smooth `Z` with compact support in `U`
  refine Submission.codim1_hcp_fv_smooth_to_C1_stationary P m U M hU hM hfin
    fun Z hZ hZc hZU => ?_
  have hZ1 : ContDiff ℝ 1 Z := hZ.of_le (by exact_mod_cast le_top)
  -- `E = M ∩ spt Z` is Borel (`M` is) and `Hᵐ(E) < ∞` (`spt Z` is a compact subset of `U`)
  have hE : MeasurableSet (M ∩ tsupport Z) :=
    (Submission.dimred_rpd_embedded_locally_closed P 1 m M hM).1.inter
      (isClosed_tsupport Z).measurableSet
  refine Submission.codim1_hcp_fv_jacobian_minimal_stationary P m M Z hM hZ1 hZc
    (hfin _ hZc.isCompact hZU) ?_
  -- for `|t| < min(t₀, c)`, `Φₜ = id + tZ` is `C¹`, injective and has injective differential, so
  -- the area formula rewrites `Hᵐ(Φₜ(E))` as `∫_E Jₜ dHᵐ`
  obtain ⟨t₀, ht₀, hmin⟩ := hdef Z hZ hZc hZU
  obtain ⟨c, hc, hinj⟩ := Submission.codim1_hcp_fv_perturbation_injective P Z hZ1 hZc
  refine ⟨min t₀ c, lt_min ht₀ hc, fun t ht => ?_⟩
  obtain ⟨hΦ, hDΦ⟩ := hinj t (ht.trans_le (min_le_right t₀ c))
  exact (hmin t (ht.trans_le (min_le_left t₀ c))).trans_eq
    (Submission.codim1_hcp_submanifold_area_formula P m M (M ∩ tsupport Z) (fun x => x + t • Z x)
      hM hE inter_subset_left (contDiff_id.add (hZ1.const_smul t)) hΦ.injOn fun x _ => hDΦ x)

/-- **Higher regularity of stationary `C¹` submanifolds** (Simon Ch. 5, Theorem 7.1, last part,
with `N = ℝᴾ`).  Let `G` be the minimal surface operator of `codim1_hcp_sr_stationary_mss`
(`Δu = div G(Du)` weakly, `G(0) = 0`, `DG(0) = 0`; Simon Ch. 5, §1) in codimension `P - m`, and
`ε₀` the small-gradient threshold of the Schauder theory `codim1_hcp_sr_quasilinear_smooth` for
`G`.  Given `y ∈ M`, take `δ > 0` with `B_δ(y) ⊆ U` and a graph chart `F(a) = y + ι a + ι' (u a)`
of `M` over `T_yM` (`codim1_hcp_sr_graph_chart`) with `‖Du‖ ≤ ε₀` whose cylinder
`Z = {y + ι a + ι' b : ‖a‖ < s, ‖b‖ < t}` has `s + t ≤ δ`, so `Z ⊆ B_δ(y) ⊆ U`.  Stationarity of
`M` in `U` makes `u` a weak solution of `Δu = div G(Du)` on `B_s(0)`, hence `u` is `Cʳ` there for
every `r`, and `(B_s(0), Z, F)` is a `Cʳ` chart of `M` at `y`. -/
theorem Submission.codim1_hcp_stationary_c1_smooth : ∀ (P m : ℕ) (U M : Set (Euclid P)), 1 ≤ m → IsOpen U → M ⊆ U → IsEmbeddedSubmanifold 1 m M → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[m] (M ∩ K) ≠ ∞) → (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ U → ∫ x in M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ X x).toLinearMap) ∂μHE[m] = 0) → ∀ r : ℕ, IsEmbeddedSubmanifold r m M := by
  intro P m U M hm hU hMU hM hfin hstat r
  -- step 1: the minimal surface operator `G` and the Schauder threshold `ε₀` (codimension `P - m`)
  obtain ⟨G, hG, hG0, hDG0, hmss⟩ := Submission.codim1_hcp_sr_stationary_mss m (P - m) hm
  obtain ⟨ε₀, hε₀, hqs⟩ := Submission.codim1_hcp_sr_quasilinear_smooth m (P - m) G hm hG hG0 hDG0
  intro y hy
  -- step 2: a graph chart at `y` with slope `≤ ε₀` whose cylinder `Z` lies in `B_δ(y) ⊆ U`
  obtain ⟨δ, hδ, hδU⟩ := Metric.isOpen_iff.1 hU y (hMU hy)
  obtain ⟨ι, ι', horth, hspan, hchart⟩ := Submission.codim1_hcp_sr_graph_chart P m M y hm hM hy
  obtain ⟨s, t, u, hs, ht, hst, hu, -, hbd, hZ, hMZ, hinj, hDF, hprop⟩ := hchart ε₀ δ hε₀ hδ
  have hZU : {z : Euclid P | ∃ a ∈ ball (0 : Euclid m) s, ∃ b ∈ ball (0 : Euclid (P - m)) t,
      z = y + ι a + ι' b} ⊆ U := by
    rintro z ⟨a, ha, b, hb, rfl⟩
    rw [mem_ball_zero_iff] at ha hb
    apply hδU
    rw [mem_ball, dist_eq_norm, add_assoc, add_sub_cancel_left]
    calc ‖ι a + ι' b‖ ≤ ‖ι a‖ + ‖ι' b‖ := norm_add_le _ _
      _ = ‖a‖ + ‖b‖ := by rw [ι.norm_map, ι'.norm_map]
      _ < s + t := add_lt_add ha hb
      _ ≤ δ := hst
  -- step 3: stationarity gives `Δu = div G(Du)` weakly on `B_s(0)`; Schauder theory: `u ∈ Cʳ`
  have hweak := hmss P U M y ι ι' s t u horth hspan hs ht hU hZU hu (fun a ha => (hbd a ha).2) hMZ
    (fun a ha => (hDF a ha).2) hfin hstat
  have hur : ContDiffOn ℝ r u (ball 0 s) :=
    hqs (ball 0 s) u isOpen_ball hu (fun a ha => (hbd a ha).1) hweak r
  -- step 4: `(B_s(0), Z, a ↦ y + ι a + ι' (u a))` is a `Cʳ` chart of `M` at `y`
  refine ⟨ball 0 s, _, fun a => y + ι a + ι' (u a), isOpen_ball, hZ,
    ⟨0, mem_ball_self hs, 0, mem_ball_self ht, by simp⟩,
    (contDiffOn_const.add ι.contDiff.contDiffOn).add (ι'.contDiff.comp_contDiffOn hur), hinj,
    hMZ.symm.trans (inter_comm _ _), hprop, fun a ha => (hDF a ha).1⟩
/-- Hausdorff measure and lower integrals over Lipschitz images (Simon Ch. 2, Theorem 1.8(i)):
if `G : ℝᵐ → ℝᴾ` is `Λ`-Lipschitz on `D`, then `Hᵐ(G(N)) ≤ Λᵐ Lᵐ(N)` for every `N ⊆ D`, measurable
or not, and for Borel `D` and Borel `H ≥ 0`, `∫_{G(D)} H dHᵐ ≤ Λᵐ ∫_D H ∘ G dLᵐ`.  The first
bound is the `μH[m]` estimate for Lipschitz images scaled by the common normalizing constant of
`μHE[m]`, with `μHE[m] = Lᵐ` on `ℝᵐ`.  Applied to `N = G⁻¹(s) ∩ D` it gives
`Hᵐ⌞G(D) ≤ Λᵐ G₊(Lᵐ⌞D)` on Borel sets `s`; integrating `H` against this measure inequality and
changing variables gives the second bound.  Injectivity of `G` is not needed. -/
theorem Submission.codim1_hcp_lsa_lipschitz_image_lintegral_le : ∀ (m P : ℕ) (G : Euclid m → Euclid P) (D : Set (Euclid m)) (Λ : NNReal), LipschitzOnWith Λ G D → (∀ N ⊆ D, μHE[m] (G '' N) ≤ (Λ : ℝ≥0∞) ^ m * volume N) ∧ (MeasurableSet D → ∀ H : Euclid P → ℝ≥0∞, Measurable H → ∫⁻ x in G '' D, H x ∂μHE[m] ≤ (Λ : ℝ≥0∞) ^ m * ∫⁻ a in D, H (G a)) := by
  intro m P G D Λ hG
  -- part (a): `μH[m](G(N)) ≤ Λᵐ μH[m](N)`, scaled by the normalizing constant of `μHE[m]`
  have hset : ∀ N ⊆ D, μHE[m] (G '' N) ≤ (Λ : ℝ≥0∞) ^ m * volume N := by
    intro N hN
    have h := (hG.mono hN).hausdorffMeasure_image_le (d := (m : ℝ)) (Nat.cast_nonneg m)
    rw [ENNReal.rpow_natCast] at h
    rw [← EuclideanSpace.euclideanHausdorffMeasure_eq_volume m,
      Measure.euclideanHausdorffMeasure_def, Measure.euclideanHausdorffMeasure_def]
    simp only [Measure.smul_apply, ENNReal.smul_def, smul_eq_mul]
    calc _ ≤ _ := mul_le_mul_right h _
      _ = _ := by ring
  refine ⟨hset, fun hD H hH => ?_⟩
  -- part (b): the measure inequality `Hᵐ⌞G(D) ≤ Λᵐ G₊(Lᵐ⌞D)`, from (a) with `N = G⁻¹(s) ∩ D`
  have hGae : AEMeasurable G (volume.restrict D) := hG.continuousOn.aemeasurable hD
  have hle : μHE[m].restrict (G '' D) ≤ ((Λ : ℝ≥0∞) ^ m) • (volume.restrict D).map G := by
    refine Measure.le_iff.2 fun s hs => ?_
    rw [Measure.restrict_apply hs, Measure.smul_apply, Measure.map_apply_of_aemeasurable hGae hs,
      Measure.restrict_apply' hD, smul_eq_mul]
    calc μHE[m] (s ∩ G '' D) ≤ μHE[m] (G '' (G ⁻¹' s ∩ D)) := by
          refine measure_mono ?_
          rintro _ ⟨hy, a, ha, rfl⟩
          exact ⟨a, ⟨hy, ha⟩, rfl⟩
      _ ≤ (Λ : ℝ≥0∞) ^ m * volume (G ⁻¹' s ∩ D) := hset _ inter_subset_right
  -- integrate `H` against the measure inequality and change variables along `G`
  calc ∫⁻ x in G '' D, H x ∂μHE[m] ≤ ∫⁻ x, H x ∂(((Λ : ℝ≥0∞) ^ m) • (volume.restrict D).map G) :=
        lintegral_mono' hle le_rfl
    _ = (Λ : ℝ≥0∞) ^ m * ∫⁻ a in D, H (G a) := by
        rw [lintegral_smul_measure, lintegral_map' hH.aemeasurable hGae, smul_eq_mul]
/-- The tangent projection `x ↦ P_x` of an embedded `C¹` submanifold `M ⊆ ℝᴾ`, `P_x` the
orthogonal projection onto `span T_xM`, is continuous on `M`.  Near `x₀ ∈ M` take a `C¹` graph
chart `G` on `B_r(0) ⊆ ℝᵐ`: `M ∩ W = G(B_r(0))`, `pr(G(a) − x₀) = a`, `pr ∘ DG(a) = id` and
`T_{G(a)}M = DG(a)(ℝᵐ)`.  `A = DG(a)` is injective, so the Gram operator `A*A` is invertible,
and `P_{G(a)} = A(A*A)⁻¹A*` by the orthogonality characterization of the projection.  This is
continuous in `a`, as `DG` is continuous, the adjoint is an isometry and inversion is continuous
at units; composing with `x ↦ pr(x − x₀)` gives continuity on the neighbourhood `M ∩ W` of `x₀`
in `M`. -/
theorem Submission.codim1_hcp_lsa_tangent_projection_continuousOn : ∀ (P m : ℕ) (M : Set (Euclid P)), IsEmbeddedSubmanifold 1 m M → ContinuousOn (fun x => (Submodule.span ℝ (tangentSpace M x)).starProjection) M := by
  intro P m M hM x₀ hx₀
  -- step 1: a `C¹` graph chart `G` on `B_r(0)` at `x₀`, with `M ∩ W = G(B_r(0))`
  obtain ⟨pr, G, r, W, -, -, hWo, hx₀W, -, -, hGc, -, hMW, hleft, hderiv, htan⟩ :=
    Submission.codim1_hcp_lsa_c1_graph_chart P m M x₀ hM hx₀
  -- step 2: `A(a) = DG(a)` is continuous on `B_r(0)`, and injective since `pr ∘ A(a) = id`
  set A : Euclid m → (Euclid m →L[ℝ] Euclid P) := fun a => fderiv ℝ G a
  have hAc : ContinuousOn A (ball 0 r) := hGc.continuousOn_fderiv_of_isOpen isOpen_ball le_rfl
  have hAinj : ∀ a ∈ ball (0 : Euclid m) r, Injective (A a) := by
    intro a ha u v huv
    have h1 := congrArg (fun L => L u) (hderiv a ha)
    have h2 := congrArg (fun L => L v) (hderiv a ha)
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.id_apply] at h1 h2
    rw [← h1, ← h2]
    exact congrArg pr huv
  -- step 3: the Gram operator `Γ(a) = A(a)* A(a)` is injective, hence a unit of `L(ℝᵐ)`
  set Γ : Euclid m → (Euclid m →L[ℝ] Euclid m) := fun a =>
    (ContinuousLinearMap.adjoint (A a)).comp (A a) with hΓ
  have hΓunit : ∀ a ∈ ball (0 : Euclid m) r, IsUnit (Γ a) := by
    intro a ha
    rw [ContinuousLinearMap.isUnit_iff_bijective]
    have hinj : Injective (Γ a) := by
      intro u v huv
      -- `⟨Γ(a) h, h⟩ = ‖A(a) h‖²` vanishes for `h = u - v`
      have h0 : Γ a (u - v) = 0 := by rw [map_sub, huv, sub_self]
      have h1 : inner ℝ (Γ a (u - v)) (u - v) = ‖A a (u - v)‖ ^ 2 := by
        simp only [hΓ, ContinuousLinearMap.comp_apply, ContinuousLinearMap.adjoint_inner_left]
        exact real_inner_self_eq_norm_sq _
      rw [h0, inner_zero_left] at h1
      have h2 : A a (u - v) = 0 := by
        have : ‖A a (u - v)‖ = 0 := by nlinarith [norm_nonneg (A a (u - v))]
        exact norm_eq_zero.1 this
      exact sub_eq_zero.1 (hAinj a ha (by rw [h2, map_zero]))
    exact ⟨hinj, (LinearMap.injective_iff_surjective
      (f := ((Γ a : Euclid m →L[ℝ] Euclid m) : Euclid m →ₗ[ℝ] Euclid m))).1 hinj⟩
  -- step 4: `P_{G(a)} = Q(a) = A(a) Γ(a)⁻¹ A(a)*`, by the orthogonality characterization
  set Q : Euclid m → (Euclid P →L[ℝ] Euclid P) := fun a =>
    (A a).comp ((Ring.inverse (Γ a)).comp (ContinuousLinearMap.adjoint (A a))) with hQ
  have hQeq : ∀ a ∈ ball (0 : Euclid m) r,
      (Submodule.span ℝ (tangentSpace M (G a))).starProjection = Q a := by
    intro a ha
    -- `T_{G(a)}M = A(a)(ℝᵐ)` is already a linear subspace
    have hspan : Submodule.span ℝ (tangentSpace M (G a)) =
        LinearMap.range ((A a : Euclid m →L[ℝ] Euclid P) : Euclid m →ₗ[ℝ] Euclid P) := by
      apply le_antisymm
      · rw [Submodule.span_le, htan a ha]
        rintro _ ⟨y, rfl⟩
        exact ⟨y, rfl⟩
      · rintro _ ⟨y, rfl⟩
        apply Submodule.subset_span
        rw [htan a ha]
        exact ⟨y, rfl⟩
    have hinvr : Γ a * Ring.inverse (Γ a) = 1 := Ring.mul_inverse_cancel _ (hΓunit a ha)
    ext1 u
    refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero ?_ ?_
    · rw [hspan]
      exact ⟨_, rfl⟩
    · -- `⟨u − Q(a) u, A(a) h⟩ = ⟨A(a)* u − Γ(a) Γ(a)⁻¹ A(a)* u, h⟩ = 0`
      intro w hw
      rw [hspan] at hw
      obtain ⟨h, rfl⟩ := hw
      simp only [hQ, ContinuousLinearMap.coe_coe]
      rw [inner_sub_left, ← ContinuousLinearMap.adjoint_inner_left,
        ← ContinuousLinearMap.adjoint_inner_left]
      have : ContinuousLinearMap.adjoint (A a) ((A a).comp ((Ring.inverse (Γ a)).comp
          (ContinuousLinearMap.adjoint (A a))) u) = ContinuousLinearMap.adjoint (A a) u := by
        have h4 := congrArg
          (fun L : Euclid m →L[ℝ] Euclid m => L (ContinuousLinearMap.adjoint (A a) u)) hinvr
        simpa [hΓ, mul_apply_eq_comp] using h4
      rw [this, sub_self]
  -- step 5: `Q` is continuous on `B_r(0)`: the adjoint is a linear isometry, and inversion is
  -- continuous at every unit
  have hQc : ContinuousOn Q (ball 0 r) := by
    have hadj : ContinuousOn (fun a => ContinuousLinearMap.adjoint (A a)) (ball 0 r) :=
      (ContinuousLinearMap.adjoint (𝕜 := ℝ) (E := Euclid m) (F := Euclid P)).continuous
        |>.comp_continuousOn hAc
    have hΓc : ContinuousOn Γ (ball 0 r) := hadj.clm_comp hAc
    have hinv : ContinuousOn (fun a => Ring.inverse (Γ a)) (ball 0 r) := by
      intro a ha
      obtain ⟨u, hu⟩ := hΓunit a ha
      have := NormedRing.inverse_continuousAt u
      rw [hu] at this
      exact this.comp_continuousWithinAt (hΓc a ha)
    exact hAc.clm_comp (hinv.clm_comp hadj)
  -- step 6: on `M ∩ W`, `x = G(a)` with `a = pr(x − x₀) ∈ B_r(0)`, so `P_x = Q(pr(x − x₀))`
  have hPQ : ∀ x ∈ M ∩ W,
      (Submodule.span ℝ (tangentSpace M x)).starProjection = Q (pr (x - x₀)) := by
    intro x hx
    rw [hMW] at hx
    obtain ⟨a, ha, rfl⟩ := hx
    rw [hleft a ha]
    exact hQeq a ha
  have hcont : ContinuousOn (fun x => Q (pr (x - x₀))) (M ∩ W) := by
    refine hQc.comp (by fun_prop) fun x hx => ?_
    rw [hMW] at hx
    obtain ⟨a, ha, rfl⟩ := hx
    rw [hleft a ha]
    exact ha
  -- step 7: `M ∩ W` is a neighbourhood of `x₀` in `M`
  exact (hcont.congr hPQ x₀ ⟨hx₀, hx₀W⟩).mono_of_mem_nhdsWithin
    (inter_mem_nhdsWithin M (hWo.mem_nhds hx₀W))

/-- **Mollifying a compactly supported Lipschitz function** (the smoothing step of the Lipschitz
approximation used for Simons' theorem, Simon B.2): if `g : ℝᵐ → ℝ` is `K`-Lipschitz and vanishes
off the compact set `S`, and `δ > 0`, then there are `C^∞` functions `gₖ`, vanishing off the closed
`δ`-neighbourhood of `S`, with `gₖ → g` uniformly and `Dgₖ → Dg` in `L²`.  Take `gₖ = ρₖ ⋆ g` for
normalized bumps `ρₖ ≥ 0` supported in `B_{εₖ}(0)`, `εₖ = δ / (k + 2)`, with
`ρₖ ≤ 2ᵐ / Lᵐ(B̄_{εₖ})`.  Then `|gₖ − g| ≤ K εₖ`, and `Dgₖ = ρₖ ⋆ Dg` by dominated convergence of
difference quotients (`g` is differentiable a.e. by Rademacher), so `Dgₖ → Dg` at every Lebesgue
point of `Dg` (Besicovitch differentiation).  As `|Dgₖ − Dg|² ≤ (2K)²` on the compact
`δ`-neighbourhood of `S` and `= 0` off it, dominated convergence gives the `L²` limit. -/
theorem Submission.codim1_hcp_lsa_mollify_lipschitz_compact_support : ∀ (m : ℕ) (g : Euclid m → ℝ) (K : NNReal) (S : Set (Euclid m)) (δ : ℝ), LipschitzWith K g → IsCompact S → (∀ a, a ∉ S → g a = 0) → 0 < δ → ∃ gs : ℕ → Euclid m → ℝ, (∀ k, ContDiff ℝ (⊤ : ℕ∞) (gs k)) ∧ (∀ k a, a ∉ Metric.cthickening δ S → gs k a = 0) ∧ TendstoUniformly gs g atTop ∧ Tendsto (fun k => ∫⁻ a, ENNReal.ofReal (‖fderiv ℝ (gs k) a - fderiv ℝ g a‖ ^ 2)) atTop (𝓝 0) := by
  intro m g K S δ hg hS hg0 hδ
  classical
  -- the a.e. derivative `F = Dg`
  set F : Euclid m → (Euclid m →L[ℝ] ℝ) := fderiv ℝ g with hFdef
  have hFm : Measurable F := measurable_fderiv ℝ g
  have hFb : ∀ y, ‖F y‖ ≤ K := fun y => norm_fderiv_le_of_lipschitz ℝ hg
  have hF0 : ∀ y, y ∉ S → F y = 0 := by
    intro y hy
    have h : g =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
      filter_upwards [hS.isClosed.isOpen_compl.mem_nhds hy] with z hz using hg0 z hz
    rw [hFdef, h.fderiv_eq]; simp
  have hFint : Integrable F := by
    refine Integrable.mono' (g := S.indicator fun _ => (K : ℝ)) ?_ hFm.aestronglyMeasurable ?_
    · exact (integrable_indicator_iff hS.isClosed.measurableSet).2
        (integrableOn_const hS.measure_lt_top.ne)
    · filter_upwards with y
      by_cases hy : y ∈ S
      · rw [indicator_of_mem hy]; exact hFb y
      · rw [indicator_of_notMem hy, hF0 y hy, norm_zero]
  -- radii
  set ε : ℕ → ℝ := fun k => δ / ((k : ℝ) + 2) with hεdef
  have hε : ∀ k, 0 < ε k := fun k => by positivity
  have hεδ : ∀ k, ε k < δ := fun k => by
    simp only [hεdef]
    rw [div_lt_iff₀ (by positivity)]
    nlinarith [(k.cast_nonneg : (0 : ℝ) ≤ k)]
  have hεlim : Tendsto ε atTop (𝓝 0) := by
    have h := (tendsto_const_nhds (x := δ)).div_atTop
      (tendsto_atTop_add_const_right atTop (2 : ℝ) tendsto_natCast_atTop_atTop)
    simpa [hεdef] using h
  -- normalized bumps
  let φ : ℕ → ContDiffBump (0 : Euclid m) := fun k =>
    ⟨ε k / 2, ε k, by linarith [hε k], by linarith [hε k]⟩
  set I : ℕ → ℝ := fun k => ∫ x, (φ k) x with hIdef
  have hφint : ∀ k, Integrable (fun x => (φ k) x) := fun k =>
    (φ k).continuous.integrable_of_hasCompactSupport (φ k).hasCompactSupport
  -- the volume of balls
  have hvol : ∀ (y : Euclid m) (s : ℝ), 0 ≤ s →
      volume.real (closedBall y s) = s ^ m * volume.real (ball (0 : Euclid m) 1) := by
    intro y s hs
    rw [measureReal_def, Measure.addHaar_closedBall volume y hs, finrank_euclideanSpace_fin,
      ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity), measureReal_def]
  have hc : 0 < volume.real (ball (0 : Euclid m) 1) := by
    rw [measureReal_def]
    exact ENNReal.toReal_pos (measure_ball_pos volume 0 one_pos).ne' measure_ball_lt_top.ne
  have hI : ∀ k, volume.real (closedBall (0 : Euclid m) (ε k / 2)) ≤ I k := by
    intro k
    have hle : (closedBall (0 : Euclid m) (ε k / 2)).indicator (fun _ => (1 : ℝ)) ≤
        fun x => (φ k) x := by
      intro x
      by_cases hx : x ∈ closedBall (0 : Euclid m) (ε k / 2)
      · rw [indicator_of_mem hx]; exact ((φ k).one_of_mem_closedBall hx).ge
      · rw [indicator_of_notMem hx]; exact (φ k).nonneg
    have hint1 : Integrable ((closedBall (0 : Euclid m) (ε k / 2)).indicator fun _ => (1 : ℝ)) :=
      (integrable_indicator_iff measurableSet_closedBall).2
        (integrableOn_const measure_closedBall_lt_top.ne)
    calc volume.real (closedBall (0 : Euclid m) (ε k / 2))
        = ∫ x, (closedBall (0 : Euclid m) (ε k / 2)).indicator (fun _ => (1 : ℝ)) x := by
          rw [integral_indicator measurableSet_closedBall]; simp
      _ ≤ I k := integral_mono hint1 (hφint k) hle
  have hIpos : ∀ k, 0 < I k := fun k =>
    lt_of_lt_of_le (by rw [hvol 0 _ (by linarith [hε k])]; exact mul_pos (pow_pos (by linarith [hε k]) _) hc)
      (hI k)
  set ρ : ℕ → Euclid m → ℝ := fun k x => (I k)⁻¹ * (φ k) x with hρdef
  have hρ0 : ∀ k x, 0 ≤ ρ k x := fun k x => mul_nonneg (inv_nonneg.2 (hIpos k).le) (φ k).nonneg
  have hρint1 : ∀ k, ∫ x, ρ k x = 1 := fun k => by
    have hIk : ∫ x, (φ k) x = I k := rfl
    simp only [hρdef]; rw [integral_const_mul, hIk, inv_mul_cancel₀ (hIpos k).ne']
  have hρsupp : ∀ k, Function.support (ρ k) ⊆ ball 0 (ε k) := fun k =>
    (Function.support_mul_subset_right _ _).trans (φ k).support_eq.subset
  have hρsmooth : ∀ k, ContDiff ℝ (⊤ : ℕ∞) (ρ k) := fun k => contDiff_const.mul (φ k).contDiff
  have hρcs : ∀ k, HasCompactSupport (ρ k) := fun k => (φ k).hasCompactSupport.mul_left
  have hρcont : ∀ k, Continuous (ρ k) := fun k => continuous_const.mul (φ k).continuous
  have hρintg : ∀ k, Integrable (ρ k) := fun k => (hρcont k).integrable_of_hasCompactSupport (hρcs k)
  have hρle : ∀ k x (y : Euclid m), ρ k x ≤ 2 ^ m / volume.real (closedBall y (ε k)) := by
    intro k x y
    have h1 : ρ k x ≤ (I k)⁻¹ := by
      simp only [hρdef]
      calc (I k)⁻¹ * (φ k) x ≤ (I k)⁻¹ * 1 :=
            mul_le_mul_of_nonneg_left (φ k).le_one (inv_nonneg.2 (hIpos k).le)
        _ = (I k)⁻¹ := mul_one _
    have hpos2 : 0 < (ε k / 2) ^ m * volume.real (ball (0 : Euclid m) 1) :=
      mul_pos (pow_pos (by linarith [hε k]) _) hc
    have h2 : (I k)⁻¹ ≤ ((ε k / 2) ^ m * volume.real (ball (0 : Euclid m) 1))⁻¹ := by
      rw [← hvol 0 _ (by linarith [hε k])]
      exact inv_anti₀ (by rw [hvol 0 _ (by linarith [hε k])]; exact hpos2) (hI k)
    have h3 : ((ε k / 2) ^ m * volume.real (ball (0 : Euclid m) 1))⁻¹ =
        2 ^ m / volume.real (closedBall y (ε k)) := by
      rw [hvol y _ (hε k).le, div_pow]
      field_simp
    linarith [h1, h2, h3.le, h3.ge]
  -- the approximants
  set gs : ℕ → Euclid m → ℝ := fun k => convolution (ρ k) g (ContinuousLinearMap.lsmul ℝ ℝ) volume
    with hgsdef
  have hgs_apply : ∀ k a, gs k a = ∫ t, ρ k t * g (a - t) := by
    intro k a
    simp only [hgsdef, convolution_def, ContinuousLinearMap.lsmul_apply, smul_eq_mul]
  have hgs_smooth : ∀ k, ContDiff ℝ (⊤ : ℕ∞) (gs k) := fun k =>
    (hρcs k).contDiff_convolution_left (ContinuousLinearMap.lsmul ℝ ℝ) (hρsmooth k)
      hg.continuous.locallyIntegrable
  set T : Set (Euclid m) := Metric.cthickening δ S with hT
  have hgs_supp : ∀ k a, a ∉ T → gs k a = 0 := by
    intro k a ha
    rw [hgs_apply]
    refine integral_eq_zero_of_ae (Eventually.of_forall fun t => ?_)
    by_cases ht : ρ k t = 0
    · simp [ht]
    · have htb : t ∈ ball (0 : Euclid m) (ε k) := hρsupp k ht
      rw [mem_ball_zero_iff] at htb
      have hS' : a - t ∉ S := by
        intro hmem
        exact ha (Metric.mem_cthickening_of_dist_le a (a - t) δ S hmem
          (by rw [dist_eq_norm, sub_sub_cancel]; linarith [hεδ k]))
      simp [hg0 _ hS']
  refine ⟨gs, hgs_smooth, hgs_supp, ?_, ?_⟩
  · -- uniform convergence
    rw [Metric.tendstoUniformly_iff]
    intro e he
    have hK : Tendsto (fun k => (K : ℝ) * ε k) atTop (𝓝 0) := by
      simpa using hεlim.const_mul (K : ℝ)
    filter_upwards [hK.eventually (gt_mem_nhds he)] with k hk a
    rw [dist_comm]
    refine lt_of_le_of_lt ?_ hk
    refine dist_convolution_le (by positivity) (hρsupp k) (hρ0 k) (hρint1 k)
      hg.continuous.aestronglyMeasurable fun x hx => ?_
    calc dist (g x) (g a) ≤ K * dist x a := hg.dist_le_mul x a
      _ ≤ K * ε k := by gcongr; exact (mem_ball.1 hx).le
  · -- the derivative of `gs k` is the mollification of `F`
    have hFae : ∀ a : Euclid m, ∀ᵐ t ∂(volume : Measure (Euclid m)), DifferentiableAt ℝ g (a - t) :=
      fun a => (Measure.measurePreserving_sub_left volume a).quasiMeasurePreserving.ae
        hg.ae_differentiableAt
    have hsl : Tendsto (fun n : ℕ => (1 : ℝ) / ((n : ℝ) + 1)) atTop (𝓝[≠] 0) := by
      refine tendsto_nhdsWithin_iff.2 ⟨tendsto_one_div_add_atTop_nhds_zero_nat, Eventually.of_forall
        fun n => ?_⟩
      simp only [mem_compl_iff, mem_singleton_iff]; positivity
    have hderiv : ∀ k a, fderiv ℝ (gs k) a = ∫ t, ρ k t • F (a - t) := by
      intro k a
      have hint : Integrable (fun t => ρ k t • F (a - t)) := by
        refine Integrable.mono' ((hρintg k).mul_const (K : ℝ)) ?_ (Eventually.of_forall fun t => ?_)
        · exact (hρcont k).aestronglyMeasurable.smul
            (hFm.comp (measurable_const.sub measurable_id)).aestronglyMeasurable
        · rw [norm_smul, Real.norm_of_nonneg (hρ0 k t)]
          exact mul_le_mul_of_nonneg_left (hFb _) (hρ0 k t)
      ext v
      rw [ContinuousLinearMap.integral_apply hint]
      simp only [_root_.smul_apply, smul_eq_mul]
      set s : ℕ → ℝ := fun n => 1 / ((n : ℝ) + 1) with hsdef
      have hspos : ∀ n, 0 < s n := fun n => by positivity
      -- difference quotients of `gs k` along `v`
      have hline : HasDerivAt (fun r : ℝ => gs k (a + r • v)) (fderiv ℝ (gs k) a v) 0 := by
        have h1 : HasDerivAt (fun r : ℝ => a + r • v) v 0 := by
          simpa using ((hasDerivAt_id (0 : ℝ)).smul_const v).const_add a
        have h2 : HasFDerivAt (gs k) (fderiv ℝ (gs k) a) (a + (0 : ℝ) • v) := by
          rw [zero_smul, add_zero]
          exact ((hgs_smooth k).differentiable (by simp) a).hasFDerivAt
        exact h2.comp_hasDerivAt (0 : ℝ) h1
      have hq1 : Tendsto (fun n => (s n)⁻¹ * (gs k (a + s n • v) - gs k a)) atTop
          (𝓝 (fderiv ℝ (gs k) a v)) := by
        have := (hasDerivAt_iff_tendsto_slope_zero.1 hline).comp hsl
        simpa [Function.comp_def, smul_eq_mul, hsdef] using this
      have hgint : ∀ w : Euclid m, Integrable (fun t => ρ k t * g (w - t)) := fun w =>
        ((hρcont k).mul (hg.continuous.comp (continuous_const.sub continuous_id))).integrable_of_hasCompactSupport
          ((hρcs k).mul_right)
      have hrepr : ∀ n, (s n)⁻¹ * (gs k (a + s n • v) - gs k a) =
          ∫ t, ρ k t * ((s n)⁻¹ * (g (a - t + s n • v) - g (a - t))) := by
        intro n
        rw [hgs_apply, hgs_apply, ← integral_sub (hgint _) (hgint _), ← integral_const_mul]
        congr 1
        ext t
        rw [show a + s n • v - t = a - t + s n • v by abel]
        ring
      have hq2 : Tendsto (fun n => (s n)⁻¹ * (gs k (a + s n • v) - gs k a)) atTop
          (𝓝 (∫ t, ρ k t * F (a - t) v)) := by
        simp_rw [hrepr]
        refine tendsto_integral_of_dominated_convergence (fun t => ρ k t * (K * ‖v‖)) (fun n => ?_)
          ((hρintg k).mul_const _) (fun n => Eventually.of_forall fun t => ?_) ?_
        · exact ((hρcont k).mul (continuous_const.mul ((hg.continuous.comp
            ((continuous_const.sub continuous_id).add continuous_const)).sub
            (hg.continuous.comp (continuous_const.sub continuous_id))))).aestronglyMeasurable
        · rw [norm_mul, Real.norm_of_nonneg (hρ0 k t)]
          refine mul_le_mul_of_nonneg_left ?_ (hρ0 k t)
          have hL := hg.dist_le_mul (a - t + s n • v) (a - t)
          rw [dist_eq_norm, dist_eq_norm, add_sub_cancel_left, norm_smul,
            Real.norm_of_nonneg (hspos n).le] at hL
          rw [norm_mul, norm_inv, Real.norm_of_nonneg (hspos n).le, Real.norm_eq_abs]
          calc (s n)⁻¹ * |g (a - t + s n • v) - g (a - t)|
              ≤ (s n)⁻¹ * (K * (s n * ‖v‖)) := by gcongr; exact hL
            _ = K * ‖v‖ := by
                rw [show (s n)⁻¹ * (K * (s n * ‖v‖)) = (s n)⁻¹ * s n * (K * ‖v‖) by ring,
                  inv_mul_cancel₀ (hspos n).ne', one_mul]
        · filter_upwards [hFae a] with t ht
          refine Tendsto.const_mul _ ?_
          have hl : HasDerivAt (fun r : ℝ => g (a - t + r • v)) (F (a - t) v) 0 := by
            have h1 : HasDerivAt (fun r : ℝ => a - t + r • v) v 0 := by
              simpa using ((hasDerivAt_id (0 : ℝ)).smul_const v).const_add (a - t)
            have h2 : HasFDerivAt g (F (a - t)) (a - t + (0 : ℝ) • v) := by
              rw [zero_smul, add_zero]; exact ht.hasFDerivAt
            exact h2.comp_hasDerivAt (0 : ℝ) h1
          have := (hasDerivAt_iff_tendsto_slope_zero.1 hl).comp hsl
          simpa [Function.comp_def, smul_eq_mul, hsdef] using this
      exact tendsto_nhds_unique hq1 hq2
    -- bounds and support of the derivatives
    have hDgsb : ∀ k a, ‖fderiv ℝ (gs k) a‖ ≤ K := by
      intro k a
      rw [hderiv k a]
      calc ‖∫ t, ρ k t • F (a - t)‖ ≤ ∫ t, ρ k t * K := by
            refine norm_integral_le_of_norm_le ((hρintg k).mul_const _) (Eventually.of_forall fun t => ?_)
            rw [norm_smul, Real.norm_of_nonneg (hρ0 k t)]
            exact mul_le_mul_of_nonneg_left (hFb _) (hρ0 k t)
        _ = K := by rw [integral_mul_const, hρint1 k, one_mul]
    have hDgs0 : ∀ k a, a ∉ T → fderiv ℝ (gs k) a = 0 := by
      intro k a ha
      have h : gs k =ᶠ[𝓝 a] fun _ => (0 : ℝ) := by
        filter_upwards [Metric.isClosed_cthickening.isOpen_compl.mem_nhds ha] with b hb
        exact hgs_supp k b hb
      rw [h.fderiv_eq]; simp
    -- Lebesgue points: `D gs k → F` a.e.
    have hεlim' : Tendsto ε atTop (𝓝[>] 0) := tendsto_nhdsWithin_iff.2 ⟨hεlim, Eventually.of_forall hε⟩
    have hae : ∀ᵐ a ∂(volume : Measure (Euclid m)), Tendsto (fun k => fderiv ℝ (gs k) a) atTop (𝓝 (F a)) := by
      filter_upwards [(Besicovitch.vitaliFamily (volume : Measure (Euclid m))).ae_tendsto_average_norm_sub
        hFint.locallyIntegrable] with a ha
      have havg : Tendsto (fun k => ⨍ y in closedBall a (ε k), ‖F y - F a‖) atTop (𝓝 0) :=
        ha.comp ((Besicovitch.tendsto_filterAt volume a).comp hεlim')
      have hconv := tendsto_integral_smul_of_tendsto_average_norm_sub (μ := volume)
        (g := fun k y => ρ k (a - y)) (2 ^ m) havg
        (Eventually.of_forall fun k => hFint.integrableOn)
        (tendsto_const_nhds.congr' (Eventually.of_forall fun k => by
          simp only
          rw [integral_sub_left_eq_self (fun y => ρ k y) volume a, hρint1 k]))
        (Eventually.of_forall fun k y hy => by
          have h := hρsupp k hy
          rw [mem_ball_zero_iff] at h
          rw [mem_closedBall, dist_eq_norm, ← norm_neg, neg_sub]
          exact h.le)
        (Eventually.of_forall fun k y => by
          rw [abs_of_nonneg (hρ0 k _)]; exact hρle k _ a)
      refine hconv.congr' (Eventually.of_forall fun k => ?_)
      show _ = fderiv ℝ (gs k) a
      rw [hderiv k a]
      have := integral_sub_left_eq_self (fun t => ρ k t • F (a - t)) volume a
      simp only [sub_sub_cancel] at this
      exact this
    -- dominated convergence in `L²`
    have hTc : IsCompact T := hS.cthickening
    have hkey := tendsto_lintegral_of_dominated_convergence (μ := volume)
      (F := fun k a => ENNReal.ofReal (‖fderiv ℝ (gs k) a - F a‖ ^ 2)) (f := fun _ => 0)
      (T.indicator fun _ => ENNReal.ofReal ((2 * K) ^ 2))
      (fun k => (((measurable_fderiv ℝ (gs k)).sub hFm).norm.pow_const 2).ennreal_ofReal)
      (fun k => Eventually.of_forall fun a => by
        by_cases ha : a ∈ T
        · rw [indicator_of_mem ha]
          refine ENNReal.ofReal_le_ofReal ?_
          have h1 : ‖fderiv ℝ (gs k) a - F a‖ ≤ 2 * K :=
            (norm_sub_le _ _).trans (by linarith [hDgsb k a, hFb a])
          exact pow_le_pow_left₀ (norm_nonneg _) h1 2
        · have haS : a ∉ S := fun h => ha (Metric.self_subset_cthickening S h)
          rw [indicator_of_notMem ha]
          show ENNReal.ofReal (‖fderiv ℝ (gs k) a - F a‖ ^ 2) ≤ 0
          rw [hDgs0 k a ha, hF0 a haS, sub_zero, norm_zero]
          simp)
      (by
        rw [lintegral_indicator_const hTc.isClosed.measurableSet]
        exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top hTc.measure_lt_top.ne)
      (by
        filter_upwards [hae] with a ha
        have h1 : Tendsto (fun k => ‖fderiv ℝ (gs k) a - F a‖) atTop (𝓝 0) :=
          tendsto_iff_norm_sub_tendsto_zero.1 ha
        have h2 := ENNReal.tendsto_ofReal (h1.pow 2)
        simpa using h2)
    simpa using hkey

/-- **Rademacher's theorem on a `C¹` submanifold** (Simon Ch. 2, 1.4 and §4).  If `M ⊆ ℝᴾ` is an
embedded `C¹` `m`-dimensional submanifold and `ζ` is locally Lipschitz on `M`, then `ζ` is
differentiable within `M` at `Hᵐ`-a.e. point of `M`.  Near `p ∈ M`, a graph chart `G` over
`B_r(0) ⊆ ℝᵐ` with `pr(G(a) − p) = a` is shrunk to `B_{r₁}(0)` so that `ζ ∘ G` is Lipschitz there
and every `x ∈ M ∩ O` is `G(pr(x − p))`, for an open `O ∋ p`.  By Rademacher `ζ ∘ G` is
differentiable off an `Lᵐ`-null set `N`, and `G(N)` is `Hᵐ`-null because `G` is Lipschitz; off
`G(N)`, `ζ` agrees on `M ∩ O` with the differentiable function `(ζ ∘ G)(pr(· − p))`.  Countably
many such `O` cover `M`. -/
theorem Submission.codim1_hcp_lsa_rademacher_on_submanifold : ∀ (P m : ℕ) (M : Set (Euclid P)) (ζ : Euclid P → ℝ), IsEmbeddedSubmanifold 1 m M → LocallyLipschitzOn M ζ → ∀ᵐ x ∂(μHE[m].restrict M), DifferentiableWithinAt ℝ ζ M x := by
  intro P m M ζ hM hζ
  -- step 1: `M` is Borel
  have hMmeas : MeasurableSet M := (Submission.dimred_rpd_embedded_locally_closed P 1 m M hM).1
  -- step 2: near each `p ∈ M`, `ζ` is differentiable within `M` off an `Hᵐ`-null set
  have hloc : ∀ p ∈ M, ∃ O : Set (Euclid P), IsOpen O ∧ p ∈ O ∧ ∃ E : Set (Euclid P),
      μHE[m] E = 0 ∧ ∀ x ∈ M ∩ O, x ∉ E → DifferentiableWithinAt ℝ ζ M x := by
    intro p hp
    -- (a) a graph chart `G` of `M ∩ W` over `B_r(0)`, inverted by `z ↦ pr(z − p)`
    obtain ⟨pr, G, r, W, Λ, hr, hWo, hpW, -, hG0, hGc, hGL, hMW, hleft, -, -⟩ :=
      Submission.codim1_hcp_lsa_c1_graph_chart P m M p hM hp
    -- (b) `ζ` is `K`-Lipschitz on `t ⊇ M ∩ U`, with `U ∋ p` open
    obtain ⟨K, t, ht, hKt⟩ := hζ hp
    obtain ⟨U, hUo, hpU, hUt⟩ : ∃ U : Set (Euclid P), IsOpen U ∧ p ∈ U ∧ M ∩ U ⊆ t := by
      obtain ⟨U, hUo, hpU, hUt⟩ := mem_nhdsWithin.1 ht
      exact ⟨U, hUo, hpU, fun x hx => hUt ⟨hx.2, hx.1⟩⟩
    -- (c) shrink the chart so that `G(B_{r₁}(0)) ⊆ U`; `O = W ∩ {pr(z − p) ∈ B_{r₁}(0)}`
    obtain ⟨r₁, hr₁, hr₁r, hGU⟩ : ∃ r₁ : ℝ, 0 < r₁ ∧ r₁ ≤ r ∧ G '' ball 0 r₁ ⊆ U := by
      have hGcont : ContinuousAt G 0 :=
        hGc.continuousOn.continuousAt (isOpen_ball.mem_nhds (mem_ball_self hr))
      have hpre : G ⁻¹' U ∈ 𝓝 (0 : Euclid m) :=
        hGcont.preimage_mem_nhds (hUo.mem_nhds (by rw [hG0]; exact hpU))
      obtain ⟨ε, hε, hεU⟩ := Metric.mem_nhds_iff.1 hpre
      refine ⟨min ε r, lt_min hε hr, min_le_right _ _, ?_⟩
      rintro _ ⟨a, ha, rfl⟩
      exact hεU (ball_subset_ball (min_le_left _ _) ha)
    have hball : ball (0 : Euclid m) r₁ ⊆ ball 0 r := ball_subset_ball hr₁r
    let O : Set (Euclid P) := W ∩ (fun z => pr (z - p)) ⁻¹' ball 0 r₁
    have hOo : IsOpen O := hWo.inter (isOpen_ball.preimage (by fun_prop))
    have hpO : p ∈ O := ⟨hpW, by simp [hr₁]⟩
    -- (d) every `x ∈ M ∩ O` is `G(a)` with `a = pr(x − p) ∈ B_{r₁}(0)`
    have hMO : ∀ x ∈ M ∩ O, pr (x - p) ∈ ball (0 : Euclid m) r₁ ∧ G (pr (x - p)) = x := by
      intro x hx
      have hxW : x ∈ M ∩ W := ⟨hx.1, hx.2.1⟩
      rw [hMW] at hxW
      obtain ⟨a, ha, rfl⟩ := hxW
      have h2 : pr (G a - p) ∈ ball (0 : Euclid m) r₁ := hx.2.2
      rw [hleft a ha] at h2 ⊢
      exact ⟨h2, rfl⟩
    -- (e) `ζ ∘ G` is `KΛ`-Lipschitz on `B_{r₁}(0)`
    have hGM : ∀ a ∈ ball (0 : Euclid m) r, G a ∈ M := fun a ha =>
      ((hMW.symm ▸ mem_image_of_mem G ha : G a ∈ M ∩ W)).1
    have hgL : LipschitzOnWith (K * Λ) (ζ ∘ G) (ball 0 r₁) :=
      hKt.comp (hGL.mono hball) fun a ha => hUt ⟨hGM a (hball ha), hGU (mem_image_of_mem G ha)⟩
    -- (f) Rademacher: `ζ ∘ G` is differentiable off the `Lᵐ`-null set `N`
    let N : Set (Euclid m) := {a | a ∈ ball (0 : Euclid m) r₁ ∧ ¬ DifferentiableAt ℝ (ζ ∘ G) a}
    have hN : volume N = 0 := by
      have hrad := hgL.ae_differentiableWithinAt_of_mem (μ := volume)
      rw [ae_iff] at hrad
      refine measure_mono_null (fun a ha => ?_) hrad
      simp only [mem_ofPred_eq, not_imp]
      exact ⟨ha.1, fun hd => ha.2 (hd.differentiableAt (isOpen_ball.mem_nhds ha.1))⟩
    refine ⟨O, hOo, hpO, G '' N, ?_, ?_⟩
    · -- (g) `Hᵐ(G(N)) ≤ Λᵐ Lᵐ(N) = 0`
      have h := (Submission.codim1_hcp_lsa_lipschitz_image_lintegral_le m P G (ball 0 r₁) Λ
        (hGL.mono hball)).1 N (fun a ha => ha.1)
      rw [hN, mul_zero] at h
      exact le_antisymm h zero_le
    · -- (h) off `G(N)`, `ζ` agrees on `M ∩ O` with `(ζ ∘ G)(pr(· − p))`, differentiable at `x`
      intro x hx hxE
      obtain ⟨ha, hGa⟩ := hMO x hx
      have hdiffa : DifferentiableAt ℝ (ζ ∘ G) (pr (x - p)) := by
        by_contra hnd
        exact hxE ⟨pr (x - p), ⟨ha, hnd⟩, hGa⟩
      have hpr' : DifferentiableAt ℝ (fun z : Euclid P => pr (z - p)) x := by fun_prop
      have hf : DifferentiableAt ℝ ((ζ ∘ G) ∘ fun z : Euclid P => pr (z - p)) x :=
        hdiffa.comp x hpr'
      refine hf.differentiableWithinAt.congr_of_eventuallyEq ?_ ?_
      · filter_upwards [inter_mem_nhdsWithin M (hOo.mem_nhds hx.2)] with y hy
        simp only [Function.comp_apply, (hMO y ⟨hy.1, hy.2⟩).2]
      · simp only [Function.comp_apply, hGa]
  -- step 3: countably many of the neighbourhoods `O p` cover `M` (second countability)
  choose! O hOo hpO E hE hdiff using hloc
  obtain ⟨T, hTM, hTc, hTU⟩ := TopologicalSpace.isOpen_biUnion_countable M O hOo
  have hnull : μHE[m] (⋃ p ∈ T, E p) = 0 :=
    (measure_biUnion_null_iff hTc).2 fun p hp => hE p (hTM hp)
  -- step 4: every point of `M` where `ζ` is not differentiable within `M` lies in `⋃_{p ∈ T} E p`
  rw [ae_restrict_iff' hMmeas, ae_iff]
  refine measure_mono_null (fun x hx => ?_) hnull
  simp only [mem_ofPred_eq, not_imp] at hx
  obtain ⟨hxM, hxnd⟩ := hx
  have hxU : x ∈ ⋃ p ∈ M, O p := mem_iUnion₂.2 ⟨x, hxM, hpO x hxM⟩
  rw [← hTU] at hxU
  obtain ⟨p, hpT, hxO⟩ := mem_iUnion₂.1 hxU
  refine mem_iUnion₂.2 ⟨p, hpT, ?_⟩
  by_contra hxE
  exact hxnd (hdiff p (hTM hpT) x ⟨hxM, hxO⟩ hxE)
/-- **Measurability of the tangential derivative of a Lipschitz function** (Simon Ch. 2, §4; used
in 7.5).  Let `M ⊆ ℝᴾ` be an embedded `C¹` `m`-dimensional submanifold, `ζ` locally Lipschitz on
`M`, and `P_x` the orthogonal projection onto `T_xM`.  Then `x ↦ d^M_xζ ∘ P_x` is `Hᵐ⌞M`-a.e.
strongly measurable.  On a graph chart `G : B_r(0) → M ∩ W` about `p` with `pr(G(a) − p) = a`,
`pr ∘ DG(a) = id` and `T_{G(a)}M = DG(a)(ℝᵐ)`, the map `Ψ(x) = D(ζ ∘ G)(pr(x − p)) ∘ pr ∘ P_x` is
a.e. strongly measurable (`D(ζ ∘ G)` is Borel and `x ↦ P_x` is continuous on `M`).  Where `ζ` is
differentiable within `M` (`Hᵐ`-a.e. on `M`, by Rademacher), the chain rule gives
`D(ζ ∘ G)(a) = d^M_xζ ∘ DG(a)` and `P_xv = DG(a)(pr P_xv)`, so `Ψ(x) = d^M_xζ ∘ P_x`.  Countably
many chart domains cover `M`. -/
theorem Submission.codim1_hcp_lsa_tangential_derivative_aesm : ∀ (P m : ℕ) (M : Set (Euclid P)) (ζ : Euclid P → ℝ), IsEmbeddedSubmanifold 1 m M → LocallyLipschitzOn M ζ → AEStronglyMeasurable (fun x => (fderivWithin ℝ ζ M x).comp (Submodule.span ℝ (tangentSpace M x)).starProjection) (μHE[m].restrict M) := by
  intro P m M ζ hM hζ
  -- step 1: `M` is Borel, `ζ` is differentiable within `M` a.e. on `M`, `x ↦ P_x` is continuous
  have hMmeas : MeasurableSet M := (Submission.dimred_rpd_embedded_locally_closed P 1 m M hM).1
  have hdiff := Submission.codim1_hcp_lsa_rademacher_on_submanifold P m M ζ hM hζ
  have hPc := Submission.codim1_hcp_lsa_tangent_projection_continuousOn P m M hM
  set F : Euclid P → (Euclid P →L[ℝ] ℝ) := fun x =>
    (fderivWithin ℝ ζ M x).comp (Submodule.span ℝ (tangentSpace M x)).starProjection with hF
  -- step 2: `F` is a.e. strongly measurable on `M ∩ W` for a graph-chart domain `W ∋ p`
  have hloc : ∀ p ∈ M, ∃ O : Set (Euclid P), IsOpen O ∧ p ∈ O ∧
      AEStronglyMeasurable F (μHE[m].restrict (M ∩ O)) := by
    intro p hp
    obtain ⟨pr, G, r, W, -, -, hWo, hpW, -, -, hGc, -, hMW, hleft, hderiv, htan⟩ :=
      Submission.codim1_hcp_lsa_c1_graph_chart P m M p hM hp
    refine ⟨W, hWo, hpW, ?_⟩
    have hMWm : MeasurableSet (M ∩ W) := hMmeas.inter hWo.measurableSet
    -- (b) the chart representative `Ψ(x) = D(ζ ∘ G)(pr(x − p)) ∘ pr ∘ P_x` is measurable
    set Ψ : Euclid P → (Euclid P →L[ℝ] ℝ) := fun x =>
      (fderiv ℝ (ζ ∘ G) (pr (x - p))).comp
        (pr.comp (Submodule.span ℝ (tangentSpace M x)).starProjection) with hΨ
    have hΨm : AEStronglyMeasurable Ψ (μHE[m].restrict (M ∩ W)) := by
      have h1 : Measurable (fun x : Euclid P => fderiv ℝ (ζ ∘ G) (pr (x - p))) :=
        (measurable_fderiv ℝ (ζ ∘ G)).comp (by fun_prop)
      have h2 : ContinuousOn (fun x => pr.comp (Submodule.span ℝ (tangentSpace M x)).starProjection)
          (M ∩ W) :=
        ((ContinuousLinearMap.compL ℝ (Euclid P) (Euclid P) (Euclid m) pr).continuous
          |>.comp_continuousOn hPc).mono inter_subset_left
      exact isBoundedBilinearMap_comp.continuous.comp_aestronglyMeasurable
        (h1.aestronglyMeasurable.prodMk (h2.aestronglyMeasurable hMWm))
    -- (c) `Ψ = F` at every `x ∈ M ∩ W` where `ζ` is differentiable within `M`
    refine hΨm.congr ?_
    have hdiff' : ∀ᵐ x ∂(μHE[m].restrict (M ∩ W)), DifferentiableWithinAt ℝ ζ M x :=
      ae_restrict_of_ae_restrict_of_subset inter_subset_left hdiff
    filter_upwards [hdiff', ae_restrict_mem hMWm] with x hxd hxMW
    -- `x = G a` with `a = pr (x - p)`
    have hxMW' := hxMW
    rw [hMW] at hxMW'
    obtain ⟨a, ha, rfl⟩ := hxMW'
    simp only [hΨ, hF]
    rw [hleft a ha]
    -- chain rule: `D(ζ ∘ G)(a) = d^M_{G a}ζ ∘ DG(a)`
    have hGM : MapsTo G (ball 0 r) M :=
      fun b hb => (hMW.symm ▸ mem_image_of_mem G hb : G b ∈ M ∩ W).1
    have hGd : HasFDerivAt G (fderiv ℝ G a) a :=
      ((hGc.contDiffAt (isOpen_ball.mem_nhds ha)).differentiableAt one_ne_zero).hasFDerivAt
    have hcomp : HasFDerivAt (ζ ∘ G) ((fderivWithin ℝ ζ M (G a)).comp (fderiv ℝ G a)) a :=
      (hxd.hasFDerivWithinAt.comp a hGd.hasFDerivWithinAt hGM).hasFDerivAt
        (isOpen_ball.mem_nhds ha)
    rw [hcomp.fderiv]
    ext v
    simp only [ContinuousLinearMap.comp_apply]
    -- `P_x v ∈ T_{G a}M = DG(a)(ℝᵐ)`, so `P_x v = DG(a) h` and `pr (P_x v) = h`
    have hmem0 := Submodule.starProjection_apply_mem (Submodule.span ℝ (tangentSpace M (G a))) v
    have hle : Submodule.span ℝ (tangentSpace M (G a)) ≤
        LinearMap.range ((fderiv ℝ G a : Euclid m →L[ℝ] Euclid P) : Euclid m →ₗ[ℝ] Euclid P) := by
      rw [Submodule.span_le, htan a ha]
      rintro _ ⟨y, rfl⟩
      exact ⟨y, rfl⟩
    have hmem : ∃ h, (fderiv ℝ G a) h =
        (Submodule.span ℝ (tangentSpace M (G a))).starProjection v :=
      LinearMap.mem_range.1 (hle hmem0)
    obtain ⟨h, hh⟩ := hmem
    rw [← hh]
    congr 1
    have := congrArg (fun L => L h) (hderiv a ha)
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.id_apply] at this
    rw [this]
  -- step 3: countably many chart domains `O p`, `p ∈ T`, cover `M`
  choose! O hOo hpO hO using hloc
  obtain ⟨T, hTM, hTc, hTU⟩ := TopologicalSpace.isOpen_biUnion_countable M O hOo
  have hcount : Countable T := hTc.to_subtype
  have hMU : M = ⋃ i : T, M ∩ O i := by
    ext x
    simp only [mem_iUnion, mem_inter_iff]
    constructor
    · intro hx
      have hxU : x ∈ ⋃ p ∈ M, O p := mem_iUnion₂.2 ⟨x, hx, hpO x hx⟩
      rw [← hTU] at hxU
      obtain ⟨p, hpT, hxO⟩ := mem_iUnion₂.1 hxU
      exact ⟨⟨p, hpT⟩, hx, hxO⟩
    · rintro ⟨i, hx, -⟩
      exact hx
  -- step 4: a.e. strong measurability passes to the countable union
  rw [hMU]
  exact aestronglyMeasurable_iUnion_iff.2 fun i => hO i.1 (hTM i.2)

/-- **Smooth approximation in one graph chart** (Simon Ch. 2, §4, 4.4–4.9; Lipschitz test
functions in App. B, proof of B.2, used for 7.5.8).  `W` is the domain of a `C¹` graph chart at `p`:
`M ∩ W = G(B_r(0))`, `pr(G(a) − p) = a`.  If `ζ` is locally Lipschitz on `M` and vanishes off a
compact `C ⊆ M ∩ W`, then `g = ζ ∘ G` on `B_r(0)` (`0` outside) is Lipschitz and vanishes off
`S = pr(C − p)`.  Mollify `g` to `gₖ`, supported in `T = cthickening δ S`, and put
`ζₖ = β · gₖ ∘ pr(· − p)` with `β` smooth, `= 1` near `C' = G(T)` and `tsupport β ⊆ W`.
`H^m`-a.e. on `M ∩ W` (Rademacher) the tangential error is `(Dgₖ(a) − Dg(a))(pr Pₓeⱼ)`,
`a = pr(x − p)`, whose squares sum to at most `‖Dgₖ(a) − Dg(a)‖²`; off `W` it vanishes.  The
Lipschitz area bound moves the error integral to `B_r(0)`, where it tends to `0`. -/
theorem Submission.codim1_hcp_lsa_local_chart_approx : ∀ (P m : ℕ) (M : Set (Euclid P)), IsEmbeddedSubmanifold 1 m M → ∀ p ∈ M, ∃ W : Set (Euclid P), IsOpen W ∧ p ∈ W ∧ ∀ ζ : Euclid P → ℝ, LocallyLipschitzOn M ζ → (∃ C : Set (Euclid P), IsCompact C ∧ C ⊆ M ∩ W ∧ ∀ x ∈ M, x ∉ C → ζ x = 0) → ∃ (C' : Set (Euclid P)) (ζs : ℕ → Euclid P → ℝ), IsCompact C' ∧ C' ⊆ M ∧ (∀ k, ContDiff ℝ (⊤ : ℕ∞) (ζs k) ∧ HasCompactSupport (ζs k)) ∧ (∀ k, ∀ x ∈ M, x ∉ C' → ζs k x = 0) ∧ TendstoUniformlyOn ζs ζ atTop M ∧ Tendsto (fun k => ∫⁻ x in M, ENNReal.ofReal (∑ j : Fin P, (fderiv ℝ (ζs k) x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1)) - fderivWithin ℝ ζ M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) ^ 2) ∂μHE[m]) atTop (𝓝 0) := by
  classical
  intro P m M hM p hp
  -- step 1: the graph chart at `p`; its domain `W` is the asserted neighbourhood
  obtain ⟨pr, G, r, W, Λ, hr, hWo, hpW, hpr, hG0, hGc, hGL, hMW, hleft, hderiv, htan⟩ :=
    Submission.codim1_hcp_lsa_c1_graph_chart P m M p hM hp
  have hMmeas : MeasurableSet M := (Submission.dimred_rpd_embedded_locally_closed P 1 m M hM).1
  refine ⟨W, hWo, hpW, ?_⟩
  rintro ζ hζ ⟨C, hCc, hCMW, hζC⟩
  have hGMW : ∀ a ∈ ball (0 : Euclid m) r, G a ∈ M ∩ W := fun a ha => by
    rw [hMW]; exact mem_image_of_mem G ha
  have hrep : ∀ x ∈ M ∩ W, pr (x - p) ∈ ball (0 : Euclid m) r ∧ G (pr (x - p)) = x := by
    intro x hx
    rw [hMW] at hx
    obtain ⟨a, ha, rfl⟩ := hx
    rw [hleft a ha]; exact ⟨ha, rfl⟩
  have hGcont : ContinuousOn G (ball 0 r) := hGc.continuousOn
  -- step 2: the compact parameter sets `S = pr(C − p) ⊆ T = cthickening δ S ⊆ B_r(0)`
  set S : Set (Euclid m) := (fun x => pr (x - p)) '' C with hS
  have hSc : IsCompact S := hCc.image (by fun_prop)
  have hSball : S ⊆ ball 0 r := by
    rintro _ ⟨x, hx, rfl⟩; exact (hrep x (hCMW hx)).1
  obtain ⟨δ₀, hδ₀, hδ₀sub⟩ := hSc.exists_cthickening_subset_open isOpen_ball hSball
  set δ : ℝ := δ₀ / 2 with hδ
  have hδpos : 0 < δ := by positivity
  set T : Set (Euclid m) := Metric.cthickening δ S with hT
  have hTc : IsCompact T := hSc.cthickening
  have hTball : T ⊆ ball 0 r := (Metric.cthickening_mono (by linarith) S).trans hδ₀sub
  have hST : S ⊆ T := Metric.self_subset_cthickening S
  -- step 3: the coordinate function `g = ζ ∘ G` on `B_r(0)`, `0` outside; `g = 0` off `S`
  set g : Euclid m → ℝ := fun a => if a ∈ ball (0 : Euclid m) r then ζ (G a) else 0 with hg
  have hg_ball : ∀ a ∈ ball (0 : Euclid m) r, g a = ζ (G a) := fun a ha => ite_eq_left ha
  have hg0 : ∀ a, a ∉ S → g a = 0 := by
    intro a ha
    by_cases hab : a ∈ ball (0 : Euclid m) r
    · rw [hg_ball a hab]
      refine hζC (G a) (hGMW a hab).1 fun hGC => ha ?_
      exact ⟨G a, hGC, hleft a hab⟩
    · exact ite_eq_right hab
  -- (b) `ζ ∘ G` is locally Lipschitz on the ball, hence Lipschitz and bounded on `T`
  have hζG : LocallyLipschitzOn (ball (0 : Euclid m) r) (ζ ∘ G) := by
    intro a ha
    obtain ⟨K, t, ht, hKt⟩ := hζ (hGMW a ha).1
    have ht' : t ∈ 𝓝[G '' ball 0 r] (G a) :=
      nhdsWithin_mono _ (fun y hy => by rw [← hMW] at hy; exact hy.1) ht
    refine ⟨K * Λ, G ⁻¹' t ∩ ball 0 r, ?_, ?_⟩
    · exact inter_mem ((hGcont a ha).preimage_mem_nhdsWithin' ht') self_mem_nhdsWithin
    · exact hKt.comp (hGL.mono inter_subset_right) fun b hb => hb.1
  obtain ⟨K₁, hK₁⟩ := (hζG.mono hTball).exists_lipschitzOnWith_of_compact hTc
  obtain ⟨B, hB⟩ := hTc.exists_bound_of_continuousOn (hK₁.continuousOn)
  -- (c) `g` is globally Lipschitz with constant `max(K₁, B/δ)`
  have hgLip : LipschitzWith (max K₁ (Real.toNNReal (B / δ))) g := by
    have hgT : ∀ a ∈ T, g a = ζ (G a) := fun a ha => hg_ball a (hTball ha)
    have hfar : ∀ a b, a ∈ S → b ∉ T →
        dist (g a) (g b) ≤ max K₁ (Real.toNNReal (B / δ)) * dist a b := by
      intro a b ha hb
      have hgb : g b = 0 := hg0 b fun h => hb (hST h)
      have hdist : δ < dist a b := by
        by_contra hle
        exact hb (Metric.mem_cthickening_of_dist_le b a δ S ha (by rw [dist_comm]; linarith))
      rw [hgb, dist_zero_right]
      have hBa : ‖g a‖ ≤ B := by rw [hgT a (hST ha)]; exact hB a (hST ha)
      have hB0 : 0 ≤ B := le_trans (norm_nonneg _) hBa
      calc ‖g a‖ ≤ B := hBa
        _ ≤ B / δ * dist a b := by
            rw [div_mul_eq_mul_div, le_div_iff₀ hδpos]
            exact mul_le_mul_of_nonneg_left hdist.le hB0
        _ ≤ (Real.toNNReal (B / δ) : ℝ) * dist a b :=
            mul_le_mul_of_nonneg_right (Real.le_coe_toNNReal _) dist_nonneg
        _ ≤ (max K₁ (Real.toNNReal (B / δ)) : ℝ) * dist a b := by
            gcongr; exact le_max_right _ _
    refine LipschitzWith.of_dist_le_mul fun a b => ?_
    by_cases ha : a ∈ T <;> by_cases hb : b ∈ T
    · rw [hgT a ha, hgT b hb]
      calc dist (ζ (G a)) (ζ (G b)) ≤ K₁ * dist a b := hK₁.dist_le_mul a ha b hb
        _ ≤ _ := by gcongr; exact le_max_left _ _
    · by_cases haS : a ∈ S
      · exact hfar a b haS hb
      · rw [hg0 a haS, hg0 b fun h => hb (hST h), dist_self]; positivity
    · by_cases hbS : b ∈ S
      · rw [dist_comm, dist_comm a b]; exact hfar b a hbS ha
      · rw [hg0 a fun h => ha (hST h), hg0 b hbS, dist_self]; positivity
    · rw [hg0 a fun h => ha (hST h), hg0 b fun h => hb (hST h), dist_self]; positivity
  -- step 4: mollification
  obtain ⟨gs, hgs_smooth, hgs_supp, hgs_unif, hgs_L2⟩ :=
    Submission.codim1_hcp_lsa_mollify_lipschitz_compact_support m g _ S δ hgLip hSc hg0 hδpos
  -- step 5: the cutoff `β`, smooth, `= 1` near `K' = G(T)`, `tsupport β ⊆ W`
  set K' : Set (Euclid P) := G '' T with hK'
  have hK'c : IsCompact K' := hTc.image_of_continuousOn (hGcont.mono hTball)
  have hK'MW : K' ⊆ M ∩ W := by rintro _ ⟨a, ha, rfl⟩; exact hGMW a (hTball ha)
  obtain ⟨ε, hε, hεW⟩ := hK'c.exists_cthickening_subset_open hWo fun x hx => (hK'MW hx).2
  obtain ⟨β, hβs, hβr, hβsupp, hβ1⟩ := exists_contDiff_support_eq_eq_one_iff (n := (⊤ : ℕ∞))
    (Metric.isOpen_thickening (δ := ε) (E := K'))
    (Metric.isClosed_cthickening (δ := ε / 2) (E := K'))
    (Metric.cthickening_subset_thickening' hε (by linarith) K')
  have htsβ : tsupport β ⊆ Metric.cthickening ε K' := by
    rw [tsupport, hβsupp]; exact Metric.closure_thickening_subset_cthickening ε K'
  have hβcs : HasCompactSupport β :=
    hK'c.cthickening.of_isClosed_subset (isClosed_tsupport β) htsβ
  have hβ0 : ∀ x, x ∉ W → x ∉ tsupport β := fun x hx h => hx (hεW (htsβ h))
  have hβone : ∀ x ∈ Metric.thickening (ε / 2) K', β x = 1 := fun x hx =>
    (hβ1 x).1 (Metric.thickening_subset_cthickening _ _ hx)
  have hK'thick : K' ⊆ Metric.thickening (ε / 2) K' :=
    Metric.self_subset_thickening (by positivity) K'
  have hprc : ContDiff ℝ (⊤ : ℕ∞) (fun z : Euclid P => pr (z - p)) := by fun_prop
  -- step 6: the approximants `ζₖ = β · gₖ ∘ pr(· − p)` and `C' = K'`
  refine ⟨K', fun k z => β z * gs k (pr (z - p)), hK'c, fun x hx => (hK'MW hx).1,
    fun k => ⟨hβs.mul ((hgs_smooth k).comp hprc), hβcs.mul_right⟩, ?_, ?_, ?_⟩
  · -- step 7: `ζₖ = 0` on `M \ K'`
    intro k x hxM hxK
    by_cases hxW : x ∈ W
    · obtain ⟨ha, hGa⟩ := hrep x ⟨hxM, hxW⟩
      have haT : pr (x - p) ∉ T := fun h => hxK ⟨_, h, hGa⟩
      simp only [hgs_supp k _ haT, mul_zero]
    · simp only [image_eq_zero_of_notMem_tsupport (hβ0 x hxW), zero_mul]
  · -- step 8: uniform convergence on `M`, read off in chart coordinates
    rw [Metric.tendstoUniformlyOn_iff]
    intro ε' hε'
    filter_upwards [Metric.tendstoUniformly_iff.1 hgs_unif ε' hε'] with k hk x hxM
    by_cases hxW : x ∈ W
    · obtain ⟨ha, hGa⟩ := hrep x ⟨hxM, hxW⟩
      have hζx : ζ x = g (pr (x - p)) := by rw [hg_ball _ ha, hGa]
      by_cases haT : pr (x - p) ∈ T
      · rw [hβone x (hK'thick ⟨_, haT, hGa⟩), one_mul, hζx]; exact hk _
      · rw [hgs_supp k _ haT, mul_zero, hζx, hg0 _ fun h => haT (hST h), dist_self]; exact hε'
    · rw [image_eq_zero_of_notMem_tsupport (hβ0 x hxW), zero_mul,
        hζC x hxM fun h => hxW (hCMW h).2, dist_self]
      exact hε'
  · -- steps 9–11: the tangential gradient error
    set w : Euclid P → Fin P → Euclid P := fun x j =>
      (Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1) with hw
    -- step 9: `∑ⱼ λ(pr(Pₓeⱼ))² ≤ ‖λ‖²`, via the Riesz vector of `λ ∘ pr ∘ Pₓ`
    have halg : ∀ (l : Euclid m →L[ℝ] ℝ) (x : Euclid P),
        ∑ j : Fin P, (l (pr (w x j))) ^ 2 ≤ ‖l‖ ^ 2 := by
      intro l x
      set ℓ : Euclid P →L[ℝ] ℝ :=
        (l.comp pr).comp (Submodule.span ℝ (tangentSpace M x)).starProjection
      set u : Euclid P := (InnerProductSpace.toDual ℝ (Euclid P)).symm ℓ
      have hu : ∀ v, ℓ v = inner ℝ u v := fun v => (InnerProductSpace.toDual_symm_apply).symm
      have hcoord : ∀ j : Fin P, l (pr (w x j)) = u j := by
        intro j
        have := hu (EuclideanSpace.single j 1)
        rw [EuclideanSpace.inner_single_right] at this
        simpa [ℓ, w] using this
      have hnorm : ‖u‖ = ‖ℓ‖ := LinearIsometryEquiv.norm_map _ _
      have hℓ : ‖ℓ‖ ≤ ‖l‖ := by
        calc ‖ℓ‖ ≤ ‖l.comp pr‖ * ‖(Submodule.span ℝ (tangentSpace M x)).starProjection‖ :=
              ContinuousLinearMap.opNorm_comp_le _ _
          _ ≤ (‖l‖ * ‖pr‖) * 1 := by
              gcongr
              · exact ContinuousLinearMap.opNorm_comp_le _ _
              · exact Submodule.starProjection_norm_le _
          _ ≤ ‖l‖ * 1 * 1 := by gcongr
          _ = ‖l‖ := by ring
      calc ∑ j : Fin P, (l (pr (w x j))) ^ 2 = ∑ j : Fin P, (u j) ^ 2 := by simp_rw [hcoord]
        _ = ‖u‖ ^ 2 := (EuclideanSpace.real_norm_sq_eq u).symm
        _ ≤ ‖l‖ ^ 2 := by rw [hnorm]; gcongr
    -- the Borel chart majorant `Hₖ(z) = ‖Dgₖ(pr(z − p)) − Dg(pr(z − p))‖²`
    set H : ℕ → Euclid P → ℝ≥0∞ := fun k z =>
      ENNReal.ofReal (‖fderiv ℝ (gs k) (pr (z - p)) - fderiv ℝ g (pr (z - p))‖ ^ 2) with hH
    have hHm : ∀ k, Measurable (H k) := by
      intro k
      have h1 : Measurable fun z : Euclid P => fderiv ℝ (gs k) (pr (z - p)) :=
        (measurable_fderiv ℝ (gs k)).comp (by fun_prop)
      have h2 : Measurable fun z : Euclid P => fderiv ℝ g (pr (z - p)) :=
        (measurable_fderiv ℝ g).comp (by fun_prop)
      exact ((h1.sub h2).norm.pow_const 2).ennreal_ofReal
    have hζdiff := Submission.codim1_hcp_lsa_rademacher_on_submanifold P m M ζ hM hζ
    -- step 10: the pointwise bound by `1_W · Hₖ`, `H^m`-a.e. on `M`
    have hpt : ∀ k, ∀ᵐ x ∂(μHE[m].restrict M), ENNReal.ofReal (∑ j : Fin P,
        (fderiv ℝ (fun z => β z * gs k (pr (z - p))) x (w x j) -
          fderivWithin ℝ ζ M x (w x j)) ^ 2) ≤ W.indicator (H k) x := by
      intro k
      filter_upwards [hζdiff, ae_restrict_mem hMmeas] with x hxd hxM
      by_cases hxW : x ∈ W
      · rw [indicator_of_mem hxW]
        obtain ⟨ha, hGa⟩ := hrep x ⟨hxM, hxW⟩
        set a := pr (x - p) with ha_def
        -- (i) `Dg(a) = d^M_xζ ∘ DG(a)`
        have hGd : HasFDerivAt G (fderiv ℝ G a) a :=
          ((hGc.contDiffAt (isOpen_ball.mem_nhds ha)).differentiableAt one_ne_zero).hasFDerivAt
        have hGM : MapsTo G (ball 0 r) M := fun b hb => (hGMW b hb).1
        have hcomp : HasFDerivAt (ζ ∘ G) ((fderivWithin ℝ ζ M x).comp (fderiv ℝ G a)) a := by
          have hxd' : HasFDerivWithinAt ζ (fderivWithin ℝ ζ M x) M (G a) := by
            rw [hGa]; exact hxd.hasFDerivWithinAt
          exact (hxd'.comp a hGd.hasFDerivWithinAt hGM).hasFDerivAt (isOpen_ball.mem_nhds ha)
        have hgeq : g =ᶠ[𝓝 a] ζ ∘ G := by
          filter_upwards [isOpen_ball.mem_nhds ha] with b hb
          exact hg_ball b hb
        have hDg : fderiv ℝ g a = (fderivWithin ℝ ζ M x).comp (fderiv ℝ G a) :=
          (hcomp.congr_of_eventuallyEq hgeq).fderiv
        -- (ii) `Dζₖ(x) = Dgₖ(a) ∘ pr`
        have hDζs : fderiv ℝ (fun z => β z * gs k (pr (z - p))) x =
            (fderiv ℝ (gs k) a).comp pr := by
          have hprd : HasFDerivAt (fun z : Euclid P => pr (z - p)) pr x := by
            have h := (pr.hasFDerivAt (x := x - p)).comp x ((hasFDerivAt_id x).sub_const p)
            rw [ContinuousLinearMap.comp_id] at h
            exact h
          by_cases haT : a ∈ T
          · have hxK : x ∈ Metric.thickening (ε / 2) K' := hK'thick ⟨a, haT, hGa⟩
            have heq : (fun z => β z * gs k (pr (z - p))) =ᶠ[𝓝 x]
                fun z => gs k (pr (z - p)) := by
              filter_upwards [Metric.isOpen_thickening.mem_nhds hxK] with z hz
              rw [hβone z hz, one_mul]
            rw [heq.fderiv_eq]
            have hgsd : HasFDerivAt (gs k) (fderiv ℝ (gs k) a) a :=
              ((hgs_smooth k).differentiable (by simp) a).hasFDerivAt
            exact (hgsd.comp x hprd).fderiv
          · have hnhds : (fun z : Euclid P => pr (z - p)) ⁻¹' Tᶜ ∈ 𝓝 x :=
              (Metric.isClosed_cthickening.isOpen_compl.preimage (by fun_prop)).mem_nhds haT
            have heq : (fun z => β z * gs k (pr (z - p))) =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
              filter_upwards [hnhds] with z hz
              rw [hgs_supp k _ hz, mul_zero]
            have hga : gs k =ᶠ[𝓝 a] fun _ => (0 : ℝ) := by
              filter_upwards [Metric.isClosed_cthickening.isOpen_compl.mem_nhds haT] with b hb
              exact hgs_supp k b hb
            rw [heq.fderiv_eq, hga.fderiv_eq]
            simp
        -- (iii) `Pₓeⱼ = DG(a)(pr(Pₓeⱼ))`, since `T_xM = range DG(a)` and `pr ∘ DG(a) = id`
        have hwj : ∀ j, fderiv ℝ G a (pr (w x j)) = w x j := by
          intro j
          have hmem0 := Submodule.starProjection_apply_mem (Submodule.span ℝ (tangentSpace M x))
            (EuclideanSpace.single j (1 : ℝ))
          have hle : Submodule.span ℝ (tangentSpace M x) ≤ LinearMap.range
              ((fderiv ℝ G a : Euclid m →L[ℝ] Euclid P) : Euclid m →ₗ[ℝ] Euclid P) := by
            rw [Submodule.span_le, ← hGa, htan a ha]
            rintro _ ⟨y, rfl⟩
            exact ⟨y, rfl⟩
          obtain ⟨h, hh⟩ := LinearMap.mem_range.1 (hle hmem0)
          have hh' : fderiv ℝ G a h = w x j := hh
          rw [← hh']
          congr 1
          have := congrArg (fun T => T h) (hderiv a ha)
          simpa using this
        -- (iv) the error is `(Dgₖ(a) − Dg(a))(pr(Pₓeⱼ))`; apply step 9
        have herr : ∀ j, fderiv ℝ (fun z => β z * gs k (pr (z - p))) x (w x j) -
            fderivWithin ℝ ζ M x (w x j) = (fderiv ℝ (gs k) a - fderiv ℝ g a) (pr (w x j)) := by
          intro j
          rw [hDζs, hDg]
          simp only [ContinuousLinearMap.comp_apply, sub_apply, hwj j]
        simp_rw [herr]
        exact ENNReal.ofReal_le_ofReal (halg _ x)
      · rw [indicator_of_notMem hxW]
        -- off `W`: `ζₖ = 0` near `x`, and `ζ` has derivative `0` within `M` at `x`
        have hxC : x ∉ C := fun h => hxW (hCMW h).2
        have hz1 : (fun z => β z * gs k (pr (z - p))) =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
          filter_upwards [(notMem_tsupport_iff_eventuallyEq.1 (hβ0 x hxW))] with z hz
          rw [hz, Pi.zero_apply, zero_mul]
        have hz2 : HasFDerivWithinAt ζ (0 : Euclid P →L[ℝ] ℝ) M x := by
          have h0 : HasFDerivWithinAt (fun _ : Euclid P => (0 : ℝ)) (0 : Euclid P →L[ℝ] ℝ) M x :=
            hasFDerivWithinAt_const 0 x M
          refine h0.congr_of_eventuallyEq ?_ (hζC x hxM hxC)
          filter_upwards [inter_mem_nhdsWithin M (hCc.isClosed.isOpen_compl.mem_nhds hxC)]
            with y hy
          exact hζC y hy.1 hy.2
        have hterm : ∀ j, fderiv ℝ (fun z => β z * gs k (pr (z - p))) x (w x j) -
            fderivWithin ℝ ζ M x (w x j) = 0 := by
          intro j
          rw [hz1.fderiv_eq,
            Submission.codim1_hcp_lsa_fderivWithin_eq_on_tangent_span P M ζ 0 x (w x j) hz2
              (Submodule.starProjection_apply_mem _ _)]
          simp
        have hsum0 : ∑ j : Fin P, (fderiv ℝ (fun z => β z * gs k (pr (z - p))) x (w x j) -
            fderivWithin ℝ ζ M x (w x j)) ^ 2 = 0 := by
          simp only [hterm]; simp
        rw [hsum0, ENNReal.ofReal_zero]
    -- step 11: integrate, transfer to the chart ball, and pass to the limit
    have hint : ∀ k, ∫⁻ x in M, ENNReal.ofReal (∑ j : Fin P,
        (fderiv ℝ (fun z => β z * gs k (pr (z - p))) x (w x j) -
          fderivWithin ℝ ζ M x (w x j)) ^ 2) ∂μHE[m] ≤ (Λ : ℝ≥0∞) ^ m *
            ∫⁻ a, ENNReal.ofReal (‖fderiv ℝ (gs k) a - fderiv ℝ g a‖ ^ 2) := by
      intro k
      have hWm : MeasurableSet W := hWo.measurableSet
      calc _ ≤ ∫⁻ x in M, W.indicator (H k) x ∂μHE[m] := lintegral_mono_ae (hpt k)
        _ = ∫⁻ x in G '' ball 0 r, H k x ∂μHE[m] := by
            rw [lintegral_indicator hWm, Measure.restrict_restrict hWm, inter_comm, hMW]
        _ ≤ (Λ : ℝ≥0∞) ^ m * ∫⁻ a in ball (0 : Euclid m) r, H k (G a) :=
            (Submission.codim1_hcp_lsa_lipschitz_image_lintegral_le m P G (ball 0 r) Λ hGL).2
              measurableSet_ball (H k) (hHm k)
        _ = (Λ : ℝ≥0∞) ^ m * ∫⁻ a in ball (0 : Euclid m) r,
              ENNReal.ofReal (‖fderiv ℝ (gs k) a - fderiv ℝ g a‖ ^ 2) := by
            congr 1
            refine setLIntegral_congr_fun measurableSet_ball fun a ha => ?_
            simp only [hH, hleft a ha]
        _ ≤ _ := mul_le_mul_right (setLIntegral_le_lintegral _ _) _
    have hlim : Tendsto (fun k => (Λ : ℝ≥0∞) ^ m *
        ∫⁻ a, ENNReal.ofReal (‖fderiv ℝ (gs k) a - fderiv ℝ g a‖ ^ 2)) atTop (𝓝 0) := by
      have := ENNReal.Tendsto.const_mul (a := (Λ : ℝ≥0∞) ^ m) hgs_L2
        (Or.inr (ENNReal.pow_ne_top ENNReal.coe_ne_top))
      simpa using this
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hlim (fun k => zero_le) hint
/-- **Calculus of locally Lipschitz functions on a `C¹` submanifold** (Simon Ch. 2, 4.4–4.9).
Let `M ⊆ ℝᴾ` be an embedded `C¹` `m`-submanifold and `P_x` the orthogonal projection onto
`span T_xM`.  (i) For `ζ` locally Lipschitz on `M`, `x ↦ d^M_xζ(P_xe_j)` is a.e. strongly
measurable for `Hᵐ⌞M`: evaluate the a.e. strongly measurable operator `d^M_xζ ∘ P_x` at `e_j`.
(ii) If moreover `ζ = 0` on `M` off a compact `C ⊆ M`, cover `C` by finitely many open sets
`W_p ∩ B₁(p)`, `p ∈ C`, where `W_p` carries one-chart approximations, and split `ζ = Σᵢ χᵢζ` on
`M` by a smooth partition of unity `χᵢ` on `C` subordinate to this cover.  Each piece `χᵢζ` is
locally Lipschitz on `M` and vanishes on `M` off the compact `C ∩ spt χᵢ`, so it has approximants
`ζ_{i,k}`; put `ζ_k = Σᵢ ζ_{i,k}`.  At `Hᵐ`-a.e. `x ∈ M` every piece is differentiable within `M`,
so `d^M_xζ = Σᵢ d^M_x(χᵢζ)` on `span T_xM`, and Cauchy–Schwarz over the pieces bounds the
gradient error of `ζ_k` by `#pieces` times the sum of the (a.e. measurable) errors of the pieces,
each of which tends to `0`. -/
theorem Submission.codim1_hcp_lipschitz_smooth_approx : ∀ (P m : ℕ) (M : Set (Euclid P)), IsEmbeddedSubmanifold 1 m M → (∀ (ζ : Euclid P → ℝ), LocallyLipschitzOn M ζ → ∀ j : Fin P, AEStronglyMeasurable (fun x => fderivWithin ℝ ζ M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) (μHE[m].restrict M)) ∧ ∀ (ζ : Euclid P → ℝ), LocallyLipschitzOn M ζ → (∃ C : Set (Euclid P), IsCompact C ∧ C ⊆ M ∧ ∀ x ∈ M, x ∉ C → ζ x = 0) → ∃ (C' : Set (Euclid P)) (ζs : ℕ → Euclid P → ℝ), IsCompact C' ∧ C' ⊆ M ∧ (∀ k, ContDiff ℝ (⊤ : ℕ∞) (ζs k) ∧ HasCompactSupport (ζs k)) ∧ (∀ k, ∀ x ∈ M, x ∉ C' → ζs k x = 0) ∧ TendstoUniformlyOn ζs ζ atTop M ∧ Tendsto (fun k => ∫⁻ x in M, ENNReal.ofReal (∑ j : Fin P, (fderiv ℝ (ζs k) x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1)) - fderivWithin ℝ ζ M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) ^ 2) ∂μHE[m]) atTop (𝓝 0) := by
  intro P m M hM
  have hMmeas : MeasurableSet M := (Submission.dimred_rpd_embedded_locally_closed P 1 m M hM).1
  -- the tangent projections `P_x e_j` are a.e. strongly measurable on `M`
  have hPj : ∀ j : Fin P, AEStronglyMeasurable
      (fun x => (Submodule.span ℝ (tangentSpace M x)).starProjection
        (EuclideanSpace.single j (1 : ℝ))) (μHE[m].restrict M) := by
    intro j
    have hc := Submission.codim1_hcp_lsa_tangent_projection_continuousOn P m M hM
    exact ((ContinuousLinearMap.apply ℝ (Euclid P)
      (EuclideanSpace.single j (1 : ℝ))).continuous.comp_continuousOn hc).aestronglyMeasurable
        hMmeas
  -- part (i): evaluate the operator `d^M_xζ ∘ P_x` at `e_j`
  have part_i : ∀ (ζ : Euclid P → ℝ), LocallyLipschitzOn M ζ → ∀ j : Fin P,
      AEStronglyMeasurable (fun x => fderivWithin ℝ ζ M x
        ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1)))
        (μHE[m].restrict M) := by
    intro ζ hζ j
    exact (ContinuousLinearMap.apply ℝ ℝ
      (EuclideanSpace.single j (1 : ℝ))).continuous.comp_aestronglyMeasurable
        (Submission.codim1_hcp_lsa_tangential_derivative_aesm P m M ζ hM hζ)
  refine ⟨part_i, ?_⟩
  -- part (ii)
  rintro ζ hζ ⟨C, hCc, hCM, hζC⟩
  -- open sets `W p ∋ p` carrying one-chart approximations
  choose! W hWo hpW hWapprox using Submission.codim1_hcp_lsa_local_chart_approx P m M hM
  -- a finite subcover of `C` by the sets `W p ∩ B₁(p)`, `p ∈ C`
  obtain ⟨t, htC, hCt⟩ := hCc.elim_nhds_subcover (fun p => W p ∩ ball p 1) fun p hp =>
    ((hWo p (hCM hp)).inter isOpen_ball).mem_nhds ⟨hpW p (hCM hp), mem_ball_self one_pos⟩
  let ι := {p // p ∈ t}
  let U : ι → Set (Euclid P) := fun i => W i.1 ∩ ball i.1 1
  have hUo : ∀ i, IsOpen (U i) := fun i => (hWo i.1 (hCM (htC i.1 i.2))).inter isOpen_ball
  have hCU : C ⊆ ⋃ i, U i := by
    intro x hx
    obtain ⟨p, hp, hxp⟩ := mem_iUnion₂.1 (hCt hx)
    exact mem_iUnion.2 ⟨⟨p, hp⟩, hxp⟩
  -- a smooth partition of unity `χᵢ = f i` on `C` subordinate to the cover
  obtain ⟨f, hf⟩ := SmoothPartitionOfUnity.exists_isSubordinate
    (modelWithCornersSelf ℝ (Euclid P)) hCc.isClosed U hUo hCU
  have hfsmooth : ∀ i, ContDiff ℝ (⊤ : ℕ∞) (f i) := fun i =>
    contMDiff_iff_contDiff.1 (f i).contMDiff
  have hfsum : ∀ x ∈ C, ∑ i, f i x = 1 := by
    intro x hx
    rw [← finsum_eq_sum_of_fintype]
    exact f.sum_eq_one hx
  -- the pieces `ζᵢ = χᵢ ζ`, with `ζ = Σᵢ ζᵢ` on `M`
  let ζi : ι → Euclid P → ℝ := fun i x => f i x * ζ x
  have hζeq : ∀ x ∈ M, ζ x = ∑ i, ζi i x := by
    intro x hx
    by_cases hxC : x ∈ C
    · simp only [ζi, ← Finset.sum_mul, hfsum x hxC, one_mul]
    · simp [ζi, hζC x hx hxC]
  -- each piece is locally Lipschitz on `M`: near `x`, `χᵢ` is Lipschitz with values in `[0, 1]`
  -- and `ζ` is Lipschitz and bounded by `|ζ x| + K`
  have hζiLip : ∀ i, LocallyLipschitzOn M (ζi i) := by
    intro i x hx
    obtain ⟨K, s, hs, hKs⟩ := hζ hx
    obtain ⟨L, u, hu, hLu⟩ := ((hfsmooth i).of_le (by exact_mod_cast le_top)).locallyLipschitz x
    have hxs : x ∈ s := mem_of_mem_nhdsWithin hx hs
    refine ⟨K + Real.toNNReal (|ζ x| + K) * L, s ∩ u ∩ closedBall x 1,
      inter_mem (inter_mem hs (mem_nhdsWithin_of_mem_nhds hu))
        (mem_nhdsWithin_of_mem_nhds (closedBall_mem_nhds x one_pos)), ?_⟩
    refine LipschitzOnWith.of_dist_le_mul fun y hy z hz => ?_
    have hζyz := hKs.dist_le_mul y hy.1.1 z hz.1.1
    have hfyz := hLu.dist_le_mul y hy.1.2 z hz.1.2
    have hζz : |ζ z| ≤ |ζ x| + K := by
      have h1 := hKs.dist_le_mul z hz.1.1 x hxs
      have h2 : dist z x ≤ 1 := hz.2
      rw [Real.dist_eq] at h1
      have h3 : |ζ z| ≤ |ζ x| + |ζ z - ζ x| := by
        have := abs_add_le (ζ x) (ζ z - ζ x); simpa using this
      nlinarith [abs_nonneg (ζ z - ζ x), NNReal.coe_nonneg K]
    have hfy : |f i y| ≤ 1 := by rw [abs_of_nonneg (f.nonneg i y)]; exact f.le_one i y
    rw [Real.dist_eq] at hζyz hfyz ⊢
    have hkey : f i y * ζ y - f i z * ζ z =
        f i y * (ζ y - ζ z) + ζ z * (f i y - f i z) := by ring
    simp only [ζi]
    rw [hkey]
    have hdist : 0 ≤ dist y z := dist_nonneg
    calc |f i y * (ζ y - ζ z) + ζ z * (f i y - f i z)|
        ≤ |f i y| * |ζ y - ζ z| + |ζ z| * |f i y - f i z| := by
          refine (abs_add_le _ _).trans ?_; rw [abs_mul, abs_mul]
      _ ≤ 1 * (K * dist y z) + (|ζ x| + K) * (L * dist y z) := by gcongr
      _ = ((K + Real.toNNReal (|ζ x| + K) * L : NNReal) : ℝ) * dist y z := by
          rw [NNReal.coe_add, NNReal.coe_mul, Real.coe_toNNReal _ (by positivity)]; ring
  -- one-chart approximations of the pieces
  have happ : ∀ i : ι, ∃ (C' : Set (Euclid P)) (ζs : ℕ → Euclid P → ℝ), IsCompact C' ∧
      C' ⊆ M ∧ (∀ k, ContDiff ℝ (⊤ : ℕ∞) (ζs k) ∧ HasCompactSupport (ζs k)) ∧
      (∀ k, ∀ x ∈ M, x ∉ C' → ζs k x = 0) ∧ TendstoUniformlyOn ζs (ζi i) atTop M ∧
      Tendsto (fun k => ∫⁻ x in M, ENNReal.ofReal (∑ j : Fin P,
        (fderiv ℝ (ζs k) x ((Submodule.span ℝ (tangentSpace M x)).starProjection
          (EuclideanSpace.single j 1)) - fderivWithin ℝ (ζi i) M x
          ((Submodule.span ℝ (tangentSpace M x)).starProjection
            (EuclideanSpace.single j 1))) ^ 2) ∂μHE[m]) atTop (𝓝 0) := by
    intro i
    refine hWapprox i.1 (hCM (htC i.1 i.2)) (ζi i) (hζiLip i)
      ⟨C ∩ tsupport (f i), hCc.inter_right (isClosed_tsupport _), ?_, ?_⟩
    · -- `C ∩ spt χᵢ ⊆ M ∩ W pᵢ`
      intro x hx
      exact ⟨hCM hx.1, (hf i hx.2).1⟩
    · -- `ζᵢ = 0` on `M` off `C ∩ spt χᵢ`
      intro x hxM hx
      by_cases hxC : x ∈ C
      · have hxt : x ∉ tsupport (f i) := fun h => hx ⟨hxC, h⟩
        simp [ζi, image_eq_zero_of_notMem_tsupport hxt]
      · simp [ζi, hζC x hxM hxC]
  choose C'i ζsi hC'c hC'M hζsi hζsi0 hζsiU hζsiL using happ
  -- `C' = ⋃ᵢ C'ᵢ` and `ζ_k = Σᵢ ζ_{i,k}`
  refine ⟨⋃ i, C'i i, fun k => ∑ i, ζsi i k, isCompact_iUnion hC'c, iUnion_subset hC'M,
    fun k => ⟨?_, HasCompactSupport.finset_sum fun i _ => (hζsi i k).2⟩, ?_, ?_, ?_⟩
  · -- smoothness
    show ContDiff ℝ _ (∑ i, ζsi i k)
    rw [Finset.sum_fn]
    exact ContDiff.sum fun i _ => (hζsi i k).1
  · -- `ζ_k = 0` on `M ∖ C'`
    intro k x hx hxC'
    show (∑ i, ζsi i k) x = 0
    rw [Finset.sum_apply]
    exact Finset.sum_eq_zero fun i _ => hζsi0 i k x hx fun h => hxC' (mem_iUnion.2 ⟨i, h⟩)
  · -- uniform convergence on `M`
    have hsum : ∀ s : Finset ι, TendstoUniformlyOn (fun k x => ∑ i ∈ s, ζsi i k x)
        (fun x => ∑ i ∈ s, ζi i x) atTop M := by
      intro s
      induction s using Finset.induction_on with
      | empty =>
        simp only [Finset.sum_empty]
        exact Metric.tendstoUniformlyOn_iff.2 fun ε hε =>
          Eventually.of_forall fun k x _ => by simpa using hε
      | insert a s ha ih =>
        simp only [Finset.sum_insert ha]
        exact (hζsiU a).add ih
    refine ((hsum Finset.univ).congr_right fun x hx => (hζeq x hx).symm).congr ?_
    exact Eventually.of_forall fun k x _ => by simp [Finset.sum_apply]
  · -- convergence of the tangential gradients
    set w : Euclid P → Fin P → Euclid P := fun x j =>
      (Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1)
    have hwmem : ∀ x j, w x j ∈ Submodule.span ℝ (tangentSpace M x) := fun x j =>
      Submodule.starProjection_apply_mem _ _
    -- `Hᵐ`-a.e. on `M` every piece is differentiable within `M`
    have hdiff : ∀ᵐ x ∂(μHE[m].restrict M),
        x ∈ M ∧ ∀ i, DifferentiableWithinAt ℝ (ζi i) M x := by
      have h1 : ∀ i, ∀ᵐ x ∂(μHE[m].restrict M), DifferentiableWithinAt ℝ (ζi i) M x :=
        fun i => Submission.codim1_hcp_lsa_rademacher_on_submanifold P m M (ζi i) hM (hζiLip i)
      filter_upwards [ae_restrict_mem hMmeas, Filter.eventually_all.2 h1] with x hx hx'
      exact ⟨hx, hx'⟩
    -- there `d^M_xζ = Σᵢ d^M_xζᵢ` on `span T_xM`, so the error of `ζ_k` is the sum of the errors
    -- of the pieces
    have hsplit : ∀ k, ∀ᵐ x ∂(μHE[m].restrict M), ∀ j,
        fderiv ℝ (∑ i, ζsi i k) x (w x j) - fderivWithin ℝ ζ M x (w x j) =
          ∑ i, (fderiv ℝ (ζsi i k) x (w x j) - fderivWithin ℝ (ζi i) M x (w x j)) := by
      intro k
      filter_upwards [hdiff] with x hx j
      obtain ⟨hxM, hxd⟩ := hx
      have hsum : HasFDerivWithinAt (∑ i, ζi i) (∑ i, fderivWithin ℝ (ζi i) M x) M x :=
        HasFDerivWithinAt.sum fun i _ => (hxd i).hasFDerivWithinAt
      have hζd : HasFDerivWithinAt ζ (∑ i, fderivWithin ℝ (ζi i) M x) M x :=
        hsum.congr (fun y hy => by rw [Finset.sum_apply]; exact hζeq y hy)
          (by rw [Finset.sum_apply]; exact hζeq x hxM)
      have hW := Submission.codim1_hcp_lsa_fderivWithin_eq_on_tangent_span P M ζ _ x (w x j)
        hζd (hwmem x j)
      have hD : fderiv ℝ (∑ i, ζsi i k) x = ∑ i, fderiv ℝ (ζsi i k) x :=
        fderiv_sum fun i _ => ((hζsi i k).1.differentiable (by simp)).differentiableAt
      rw [hW, hD, sum_apply, sum_apply, ← Finset.sum_sub_distrib]
    -- the errors of the pieces are a.e. measurable
    set n : ℕ := Fintype.card ι with hn
    let Fi : ι → ℕ → Euclid P → ℝ≥0∞ := fun i k x => ENNReal.ofReal (∑ j : Fin P,
      (fderiv ℝ (ζsi i k) x (w x j) - fderivWithin ℝ (ζi i) M x (w x j)) ^ 2)
    have hFi_meas : ∀ i k, AEMeasurable (Fi i k) (μHE[m].restrict M) := by
      intro i k
      refine AEMeasurable.ennreal_ofReal ?_
      refine (Finset.aestronglyMeasurable_fun_sum _ fun j _ => ?_).aemeasurable
      have hcont : Continuous (fderiv ℝ (ζsi i k)) := (hζsi i k).1.continuous_fderiv (by simp)
      have h1 : AEStronglyMeasurable (fun x => fderiv ℝ (ζsi i k) x (w x j))
          (μHE[m].restrict M) :=
        isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable
          (hcont.aestronglyMeasurable.prodMk (hPj j))
      exact (h1.sub (part_i (ζi i) (hζiLip i) j)).pow 2
    -- pointwise Cauchy–Schwarz over the pieces
    have hbound : ∀ k, ∀ᵐ x ∂(μHE[m].restrict M), ENNReal.ofReal (∑ j : Fin P,
        (fderiv ℝ (∑ i, ζsi i k) x (w x j) - fderivWithin ℝ ζ M x (w x j)) ^ 2) ≤
          (n : ℝ≥0∞) * ∑ i, Fi i k x := by
      intro k
      filter_upwards [hsplit k] with x hx
      have hcs : ∀ j : Fin P,
          (∑ i, (fderiv ℝ (ζsi i k) x (w x j) - fderivWithin ℝ (ζi i) M x (w x j))) ^ 2 ≤
            (n : ℝ) * ∑ i, (fderiv ℝ (ζsi i k) x (w x j) -
              fderivWithin ℝ (ζi i) M x (w x j)) ^ 2 := by
        intro j
        have := Finset.sum_mul_sq_le_sq_mul_sq Finset.univ (fun _ : ι => (1 : ℝ))
          (fun i => fderiv ℝ (ζsi i k) x (w x j) - fderivWithin ℝ (ζi i) M x (w x j))
        simpa [hn] using this
      calc ENNReal.ofReal (∑ j : Fin P,
            (fderiv ℝ (∑ i, ζsi i k) x (w x j) - fderivWithin ℝ ζ M x (w x j)) ^ 2)
          = ENNReal.ofReal (∑ j : Fin P, (∑ i, (fderiv ℝ (ζsi i k) x (w x j) -
              fderivWithin ℝ (ζi i) M x (w x j))) ^ 2) := by simp_rw [hx]
        _ ≤ ENNReal.ofReal (∑ j : Fin P, (n : ℝ) * ∑ i, (fderiv ℝ (ζsi i k) x (w x j) -
              fderivWithin ℝ (ζi i) M x (w x j)) ^ 2) :=
            ENNReal.ofReal_le_ofReal (Finset.sum_le_sum fun j _ => hcs j)
        _ = (n : ℝ≥0∞) * ∑ i, Fi i k x := by
            rw [← Finset.mul_sum, Finset.sum_comm, ENNReal.ofReal_mul (by positivity),
              ENNReal.ofReal_natCast, ENNReal.ofReal_sum_of_nonneg fun i _ => by positivity]
    -- integrate, split the finite sum, and pass to the limit
    have hint : ∀ k, ∫⁻ x in M, ENNReal.ofReal (∑ j : Fin P,
        (fderiv ℝ (∑ i, ζsi i k) x (w x j) - fderivWithin ℝ ζ M x (w x j)) ^ 2) ∂μHE[m] ≤
          (n : ℝ≥0∞) * ∑ i, ∫⁻ x in M, Fi i k x ∂μHE[m] := by
      intro k
      calc _ ≤ ∫⁻ x in M, (n : ℝ≥0∞) * ∑ i, Fi i k x ∂μHE[m] :=
            lintegral_mono_ae (hbound k)
        _ = (n : ℝ≥0∞) * ∫⁻ x in M, ∑ i, Fi i k x ∂μHE[m] :=
            lintegral_const_mul' _ _ (ENNReal.natCast_ne_top n)
        _ = (n : ℝ≥0∞) * ∑ i, ∫⁻ x in M, Fi i k x ∂μHE[m] := by
            rw [lintegral_finsetSum' _ fun i _ => hFi_meas i k]
    have hlim : Tendsto (fun k => (n : ℝ≥0∞) * ∑ i, ∫⁻ x in M, Fi i k x ∂μHE[m])
        atTop (𝓝 0) := by
      have := ENNReal.Tendsto.const_mul (tendsto_finsetSum Finset.univ fun i _ => hζsiL i)
        (Or.inr (ENNReal.natCast_ne_top n))
      simpa using this
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hlim (fun k => zero_le) hint

/-- **Tangential derivatives are well defined** (Simon Ch. 2, §4, p. 55; the tangential gradient
of the Simons cone step): for any set `M ⊆ ℝᴾ` and real normed space `E`, if `f : ℝᴾ → E` has
derivative `f'` within `M` at `x`, then `fderivWithin ℝ f M x` agrees with `f'` on the span of
`T_xM`.  `L = fderivWithin ℝ f M x` is itself a derivative of `f` within `M` at `x`, and two
derivatives within `M` agree on the tangent cone of `M` at `x`.  Each `w = γ'(0) ∈ T_xM` lies in
that cone: with `sₙ = 1/(n+2) ∈ (−1, 1)` and `dₙ = γ(sₙ) − x`, `dₙ → 0`, `x + dₙ = γ(sₙ) ∈ M` and
`(n+2) dₙ = sₙ⁻¹(γ(sₙ) − γ(0)) → w`.  So `L = f'` on `T_xM`, hence on its linear span. -/
theorem Submission.codim1_hcp_sc_fderivWithin_tangent_eq : ∀ (P : ℕ) (E : Type) [NormedAddCommGroup E] [NormedSpace ℝ E] (M : Set (Euclid P)) (f : Euclid P → E) (f' : Euclid P →L[ℝ] E) (x : Euclid P), HasFDerivWithinAt f f' M x → ∀ v ∈ Submodule.span ℝ (tangentSpace M x), fderivWithin ℝ f M x v = f' v := by
  intro P E _ _ M f f' x hf v hv
  -- steps 2–3: `L = fderivWithin ℝ f M x` and `f'` are both derivatives of `f` within `M` at
  -- `x`, so they agree on the tangent cone of `M` at `x`
  have huniq : EqOn (fderivWithin ℝ f M x) f' (tangentConeAt ℝ M x) :=
    hf.differentiableWithinAt.hasFDerivWithinAt.unique_on hf
  -- step 1: the velocity `w = γ'(0)` of a curve `γ` in `M` through `x` lies in the tangent cone
  have hcone : tangentSpace M x ⊆ tangentConeAt ℝ M x := by
    rintro w ⟨γ, -, hγM, hγ0, hγw⟩
    -- `sₙ = 1/(n+2)` tends to `0` through nonzero values and lies in `(−1, 1)`
    have hs : Tendsto (fun n : ℕ => 1 / ((n : ℝ) + 2)) atTop (𝓝[≠] 0) :=
      tendsto_nhdsWithin_iff.2 ⟨tendsto_const_nhds.div_atTop
        (tendsto_atTop_add_const_right _ 2 tendsto_natCast_atTop_atTop),
        Eventually.of_forall fun n => by simp only [mem_compl_singleton_iff]; positivity⟩
    have hsI : ∀ n : ℕ, 1 / ((n : ℝ) + 2) ∈ Ioo (-1 : ℝ) 1 := fun n => by
      have hn : (0 : ℝ) ≤ n := n.cast_nonneg
      have hpos : 0 < 1 / ((n : ℝ) + 2) := by positivity
      refine ⟨by linarith, ?_⟩
      rw [div_lt_one (by positivity)]
      linarith
    -- `cₙ = n + 2` and `dₙ = γ(sₙ) − x`
    refine mem_tangentConeAt_of_seq atTop (fun n : ℕ => (n : ℝ) + 2)
      (fun n => γ (1 / ((n : ℝ) + 2)) - x) ?_ ?_ ?_
    · -- `dₙ → γ(0) − x = 0`, since `γ` is continuous at `0`
      rw [tendsto_sub_nhds_zero_iff, ← hγ0]
      exact hγw.continuousAt.tendsto.comp (hs.mono_right nhdsWithin_le_nhds)
    · -- `x + dₙ = γ(sₙ) ∈ M`, as `sₙ ∈ (−1, 1)`
      refine Eventually.of_forall fun n => ?_
      simp only [add_sub_cancel]
      exact hγM (hsI n)
    · -- `cₙ dₙ = sₙ⁻¹(γ(0 + sₙ) − γ(0)) → γ'(0) = w`
      refine (hγw.tendsto_slope_zero.comp hs).congr fun n => ?_
      simp [hγ0]
  -- step 4: `L = f'` on `T_xM`; the set where the linear maps `L` and `f'` agree is a subspace,
  -- so it contains the linear span of `T_xM`
  exact LinearMap.eqOn_span (f := (fderivWithin ℝ f M x : Euclid P →ₗ[ℝ] E))
    (g := (f' : Euclid P →ₗ[ℝ] E)) (fun w hw => huniq (hcone hw)) hv
/-- **The unit normal of a cone is homogeneous of degree `0`** (Simon, Appendix B, proof of
Lemma B.11, (1)–(2)).  Let `M ⊆ A₀` be an embedded `C¹` `m`-submanifold with `tM ⊆ M` for
`t > 0`, and `ν` a `C^∞` unit normal to `M` in `A₀`.  By
`Submission.codim1_hcp_sc_tangent_normal_complement`, `T_yM = {v ∈ A₀ : ν(y) · v = 0}` is a
linear subspace.  The curve `s ↦ eˢx` gives `x ∈ T_xM`, and scaling curves gives
`tT_xM ⊆ T_{tx}M`, hence `T_{tx}M = T_xM`.  So `ν(tx)` is a unit vector in
`A₀ ∩ (T_xM)^⊥ = ℝν(x)`, i.e. `ν(tx) = ±ν(x)`; `t ↦ ν(x) · ν(tx)` is continuous on `(0, ∞)`
and equals `1` at `t = 1`, so the intermediate value theorem gives `ν(tx) = ν(x)`.
Differentiating `ν(tγ(s)) = ν(γ(s))` at `s = 0` along curves `γ` in `M` gives
`tDν(tx)v = Dν(x)v`, and differentiating the constant map `t ↦ ν(tx)` at `t = 1` gives
`Dν(x)x = 0`. -/
theorem Submission.codim1_hcp_sc_cone_normal_homogeneous : ∀ (P m : ℕ) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)) (ν : Euclid P → Euclid P), Module.finrank ℝ A₀ = m + 1 → M ⊆ (A₀ : Set (Euclid P)) → IsEmbeddedSubmanifold 1 m M → (∀ t : ℝ, 0 < t → ∀ x ∈ M, t • x ∈ M) → (∃ O : Set (Euclid P), IsOpen O ∧ M ⊆ O ∧ ContDiffOn ℝ (⊤ : ℕ∞) ν O) → (∀ x ∈ M, ν x ∈ A₀ ∧ ‖ν x‖ = 1 ∧ ∀ v ∈ tangentSpace M x, inner ℝ (ν x) v = 0) → ∀ x ∈ M, x ∈ tangentSpace M x ∧ fderiv ℝ ν x x = 0 ∧ ∀ t : ℝ, 0 < t → tangentSpace M (t • x) = tangentSpace M x ∧ ν (t • x) = ν x ∧ ∀ v ∈ tangentSpace M x, t • fderiv ℝ ν (t • x) v = fderiv ℝ ν x v := by
  intro P m A₀ M ν hdim hMA hM hcone hO hν x hx
  obtain ⟨O, hOo, hMO, hνO⟩ := hO
  -- Step 0: `ν` is differentiable at every point of `M ⊆ O`, and `T_yM = {v ∈ A₀ : ν(y) · v = 0}`
  have hνd : ∀ y ∈ M, HasFDerivAt ν (fderiv ℝ ν y) y := fun y hy =>
    ((hνO.contDiffAt (hOo.mem_nhds (hMO hy))).differentiableAt (by simp)).hasFDerivAt
  have hT : ∀ y ∈ M, tangentSpace M y = {v : Euclid P | v ∈ A₀ ∧ inner ℝ (ν y) v = 0} :=
    fun y hy =>
      (Submission.codim1_hcp_sc_tangent_normal_complement P m A₀ M ν hdim hMA hM hν y hy).1
  -- in particular each `T_yM`, `y ∈ M`, is closed under scalar multiplication
  have hTsmul : ∀ y ∈ M, ∀ (c : ℝ) (v : Euclid P), v ∈ tangentSpace M y →
      c • v ∈ tangentSpace M y := by
    intro y hy c v hv
    rw [hT y hy] at hv ⊢
    exact ⟨A₀.smul_mem c hv.1, by rw [real_inner_smul_right, hv.2, mul_zero]⟩
  -- Step 1: `x ∈ T_xM`, via the curve `s ↦ eˢx` in `M`
  have hxT : x ∈ tangentSpace M x := by
    refine ⟨fun s => Real.exp s • x, (Real.contDiff_exp.smul contDiff_const).contDiffOn,
      fun s _ => hcone _ (Real.exp_pos s) x hx, by simp, ?_⟩
    simpa using (Real.hasDerivAt_exp 0).smul_const x
  -- Step 2: `t • T_yM ⊆ T_{ty}M` for `t > 0`: scale the curves
  have hscale : ∀ t : ℝ, 0 < t → ∀ y v : Euclid P, v ∈ tangentSpace M y →
      t • v ∈ tangentSpace M (t • y) := by
    rintro t ht y v ⟨γ, hγ, hγM, hγ0, hγv⟩
    exact ⟨fun s => t • γ s, hγ.const_smul t, fun s hs => hcone t ht _ (hγM hs),
      by simp [hγ0], hγv.const_smul t⟩
  -- Step 3: `T_{ty}M = T_yM` for `y ∈ M` and `t > 0`
  have hTeq : ∀ y ∈ M, ∀ t : ℝ, 0 < t → tangentSpace M (t • y) = tangentSpace M y := by
    intro y hy t ht
    ext w
    constructor
    · intro hw
      have h1 := hscale t⁻¹ (inv_pos.2 ht) (t • y) w hw
      rw [inv_smul_smul₀ ht.ne'] at h1
      have h2 := hTsmul y hy t _ h1
      rwa [smul_inv_smul₀ ht.ne'] at h2
    · intro hw
      have h1 := hscale t ht y _ (hTsmul y hy t⁻¹ w hw)
      rwa [smul_inv_smul₀ ht.ne'] at h1
  -- Step 4: `ν(ty) = λν(y)` with `λ = ν(y) · ν(ty) ∈ {1, −1}`
  have hpm : ∀ y ∈ M, ∀ t : ℝ, 0 < t →
      ν (t • y) = inner ℝ (ν y) (ν (t • y)) • ν y ∧
        (inner ℝ (ν y) (ν (t • y)) = 1 ∨ inner ℝ (ν y) (ν (t • y)) = -1) := by
    intro y hy t ht
    obtain ⟨hνyA, hνy1, -⟩ := hν y hy
    obtain ⟨hνtA, hνt1, hνtT⟩ := hν (t • y) (hcone t ht y hy)
    set lam : ℝ := inner ℝ (ν y) (ν (t • y)) with hlam
    have hyy : inner ℝ (ν y) (ν y) = (1 : ℝ) := by
      rw [real_inner_self_eq_norm_sq, hνy1, one_pow]
    -- `h = ν(ty) − λν(y) ∈ A₀` is orthogonal to `ν(y)`, so `h ∈ T_yM = T_{ty}M`
    have hhT : ν (t • y) - lam • ν y ∈ tangentSpace M y := by
      rw [hT y hy]
      refine ⟨A₀.sub_mem hνtA (A₀.smul_mem lam hνyA), ?_⟩
      rw [inner_sub_right, real_inner_smul_right, hyy, mul_one, ← hlam, sub_self]
    have e1 : inner ℝ (ν (t • y)) (ν (t • y) - lam • ν y) = (0 : ℝ) :=
      hνtT _ (by rw [hTeq y hy t ht]; exact hhT)
    have e2 : inner ℝ (ν y) (ν (t • y) - lam • ν y) = (0 : ℝ) := by
      rw [hT y hy] at hhT
      exact hhT.2
    -- `|h|² = ν(ty) · h − λ ν(y) · h = 0`
    have hh0 : ν (t • y) - lam • ν y = 0 := by
      apply (inner_self_eq_zero (𝕜 := ℝ)).1
      rw [inner_sub_left, real_inner_smul_left, e1, e2, mul_zero, sub_zero]
    have hνt : ν (t • y) = lam • ν y := sub_eq_zero.1 hh0
    refine ⟨hνt, (abs_eq zero_le_one).1 ?_⟩
    -- `1 = |ν(ty)| = |λ| |ν(y)| = |λ|`
    have := congrArg norm hνt
    rw [norm_smul, hνt1, hνy1, mul_one, Real.norm_eq_abs] at this
    exact this.symm
  -- Step 5: `ν(ty) = ν(y)` for `y ∈ M` and `t > 0`: `g(s) = ν(y) · ν(sy)` is continuous on
  -- `(0, ∞)` with values in `{1, −1}` and `g(1) = 1`, so `g(t) = −1` contradicts the IVT
  have hhom : ∀ y ∈ M, ∀ t : ℝ, 0 < t → ν (t • y) = ν y := by
    intro y hy t ht
    have hg : ContinuousOn (fun s : ℝ => inner ℝ (ν y) (ν (s • y))) (Ioi 0) :=
      continuousOn_const.inner (hνO.continuousOn.comp
        (continuous_id.smul continuous_const).continuousOn fun s hs => hMO (hcone s hs y hy))
    obtain ⟨hνt, h1 | h1⟩ := hpm y hy t ht
    · rw [hνt, h1, one_smul]
    · exfalso
      have hg1 : inner ℝ (ν y) (ν ((1 : ℝ) • y)) = (1 : ℝ) := by
        rw [one_smul, real_inner_self_eq_norm_sq, (hν y hy).2.1, one_pow]
      obtain ⟨s, hs, hs0⟩ := isPreconnected_Ioi.intermediate_value (show t ∈ Ioi (0 : ℝ) from ht)
        (Set.mem_Ioi.2 one_pos) hg
        (show (0 : ℝ) ∈ Icc (inner ℝ (ν y) (ν (t • y))) (inner ℝ (ν y) (ν ((1 : ℝ) • y))) by
          rw [h1, hg1]
          constructor <;> norm_num)
      have hs0' : inner ℝ (ν y) (ν (s • y)) = (0 : ℝ) := hs0
      rcases (hpm y hy s hs).2 with h2 | h2 <;> linarith
  refine ⟨hxT, ?_, fun t ht => ⟨hTeq x hx t ht, hhom x hx t ht, ?_⟩⟩
  · -- Step 7: `Dν(x)x = 0`: `t ↦ ν(tx)` is constant near `t = 1`, with derivative `Dν(x)x` there
    have h1 : HasDerivAt (fun t : ℝ => ν (t • x)) (fderiv ℝ ν x x) 1 := by
      have hl : HasDerivAt (fun t : ℝ => t • x) x 1 := by
        simpa using (hasDerivAt_id (1 : ℝ)).smul_const x
      exact (hνd x hx).comp_hasDerivAt_of_eq 1 hl (one_smul ℝ x).symm
    have h2 : HasDerivAt (fun t : ℝ => ν (t • x)) 0 1 := by
      refine (hasDerivAt_const (1 : ℝ) (ν x)).congr_of_eventuallyEq ?_
      filter_upwards [Ioi_mem_nhds one_pos] with t ht using hhom x hx t ht
    exact h1.unique h2
  · -- Step 6: `tDν(tx)v = Dν(x)v`: differentiate `ν(tγ(s)) = ν(γ(s))` at `s = 0`
    rintro v ⟨γ, -, hγM, hγ0, hγv⟩
    have h1 : HasDerivAt (fun s => ν (t • γ s)) (fderiv ℝ ν (t • x) (t • v)) 0 :=
      (hνd (t • x) (hcone t ht x hx)).comp_hasDerivAt_of_eq 0 (hγv.const_smul t) (by simp [hγ0])
    have h2 : HasDerivAt (fun s => ν (t • γ s)) (fderiv ℝ ν x v) 0 := by
      refine ((hνd x hx).comp_hasDerivAt_of_eq 0 hγv hγ0.symm).congr_of_eventuallyEq ?_
      filter_upwards [Ioo_mem_nhds (by norm_num : (-1 : ℝ) < 0) (by norm_num : (0 : ℝ) < 1)]
        with s hs using hhom (γ s) (hγM hs) t ht
    rw [← map_smul]
    exact h1.unique h2
/-- **Hausdorff measure on a cone** (Simon, Appendix B, proof of B.2: the finiteness that the
polar formula (5) provides, obtained here by dyadic scaling of `Hᵐ`).  Let `M ⊆ ℝᴾ` with `0 ∉ M`,
`M̄ ⊆ M ∪ {0}`, `tM ⊆ M` for `t > 0` and `Hᵐ(M ∩ K) < ∞` for compact `K`.  Then `tM = M`, so
`Hᵐ(M ∩ tS) = Hᵐ(t(M ∩ S)) = tᵐHᵐ(M ∩ S)`, and `M = M̄ \ {0}` is Borel.  (a) The sets
`M ∩ ∂B_{cₙ}(0)`, `cₙ = 1 + 1/(n+1) ∈ (1, 2]`, are disjoint subsets of `M ∩ B̄₂(0)` of measure
`cₙᵐHᵐ(M ∩ ∂B₁(0)) ≥ Hᵐ(M ∩ ∂B₁(0))`, so `Hᵐ(M ∩ ∂B₁(0)) = 0`; scale to radius `c`.  (b), (c) With
`B = Hᵐ(M ∩ B̄₁(0)) < ∞`, the shell `{x ∈ M : asᵏ ≤ |x| ≤ bsᵏ}` has measure `≤ (bsᵏ)ᵐB`, and
`|x|^γ ≤ (asᵏ)^γ` on it for `γ ≤ 0`, so the integral over a union of such shells is at most a
geometric series of ratio `s^γsᵐ`.  The shells `2⁻ᵏ⁻¹ ≤ |x| ≤ 2⁻ᵏ` cover `M ∩ B₁(0)` (ratio
`2^{-(m+α)} < 1` for `−m < α < 0`; for `α ≥ 0` use `|x|^α ≤ 1`), and `2ᵏ ≤ |x| ≤ 2ᵏ⁺¹` cover
`M \ B₁(0)` (ratio `2^{m+β} < 1`, as `β < −m ≤ 0`). -/
theorem Submission.codim1_hcp_sc_cone_annuli_measure : ∀ (P m : ℕ) (M : Set (Euclid P)), (0 : Euclid P) ∉ M → closure M ⊆ insert 0 M → (∀ t : ℝ, 0 < t → ∀ x ∈ M, t • x ∈ M) → (∀ K : Set (Euclid P), IsCompact K → μHE[m] (M ∩ K) ≠ ∞) → (∀ c : ℝ, 0 < c → μHE[m] (M ∩ sphere (0 : Euclid P) c) = 0) ∧ (∀ α : ℝ, -(m : ℝ) < α → ∫⁻ x in M ∩ ball (0 : Euclid P) 1, ENNReal.ofReal (‖x‖ ^ α) ∂μHE[m] ≠ ∞) ∧ (∀ β : ℝ, β < -(m : ℝ) → ∫⁻ x in M \ ball (0 : Euclid P) 1, ENNReal.ofReal (‖x‖ ^ β) ∂μHE[m] ≠ ∞) := by
  intro P m M h0 hcl hcone hfin
  open scoped Pointwise in
  -- Step 1: `tM = M`, hence `M ∩ tS = t(M ∩ S)`, for `t > 0`
  have hMt : ∀ t : ℝ, 0 < t → ∀ S : Set (Euclid P), M ∩ t • S = t • (M ∩ S) := by
    intro t ht S
    ext x
    simp only [mem_inter_iff, mem_smul_set_iff_inv_smul_mem₀ ht.ne']
    constructor
    · rintro ⟨hx, hS⟩
      exact ⟨hcone _ (inv_pos.2 ht) x hx, hS⟩
    · rintro ⟨hx, hS⟩
      refine ⟨?_, hS⟩
      simpa [smul_inv_smul₀ ht.ne'] using hcone t ht _ hx
  -- Step 2: `M = M̄ \ {0}` is Borel
  have hMeas : MeasurableSet M := by
    have hM : M = closure M \ {0} := by
      ext x
      constructor
      · intro hx
        refine ⟨subset_closure hx, ?_⟩
        rintro rfl
        exact h0 hx
      · rintro ⟨hx, hx0⟩
        rcases hcl hx with h | h
        · exact absurd h hx0
        · exact h
    rw [hM]
    exact isClosed_closure.measurableSet.diff (measurableSet_singleton 0)
  -- Step 3: `Hᵐ(tS) = tᵐHᵐ(S)` (`hausdorffMeasure_smul₀`), so `Hᵐ(M ∩ tS) = tᵐHᵐ(M ∩ S)`
  have hsc : ∀ t : ℝ, 0 < t → ∀ S : Set (Euclid P),
      μHE[m] (M ∩ t • S) = ENNReal.ofReal (t ^ m) * μHE[m] (M ∩ S) := by
    intro t ht S
    have hc : ((‖t‖₊ ^ (m : ℝ) : NNReal) : ℝ≥0∞) = ENNReal.ofReal (t ^ m) := by
      rw [NNReal.rpow_natCast, ENNReal.ofReal_pow ht.le, ENNReal.coe_pow, Real.nnnorm_of_nonneg ht.le,
        ENNReal.ofReal_eq_coe_nnreal ht.le]
    rw [hMt t ht S, Measure.euclideanHausdorffMeasure_def, Measure.smul_apply, Measure.smul_apply,
      Measure.hausdorffMeasure_smul₀ (Nat.cast_nonneg m) ht.ne', smul_comm, ENNReal.smul_def,
      smul_eq_mul, hc]
  -- Step 4: `Hᵐ(M ∩ B̄ᵣ(0)) = rᵐB` with `B = Hᵐ(M ∩ B̄₁(0)) < ∞`
  set B := μHE[m] (M ∩ closedBall (0 : Euclid P) 1)
  have hBfin : B ≠ ∞ := hfin _ (isCompact_closedBall 0 1)
  have hball : ∀ r : ℝ, 0 < r →
      μHE[m] (M ∩ closedBall (0 : Euclid P) r) = ENNReal.ofReal (r ^ m) * B := by
    intro r hr
    have : closedBall (0 : Euclid P) r = r • closedBall (0 : Euclid P) 1 := by
      rw [smul_closedBall' hr.ne', smul_zero, Real.norm_of_nonneg hr.le, mul_one]
    rw [this, hsc r hr]
  -- Step 5: on the shell `{x ∈ M : asᵏ ≤ |x| ≤ bsᵏ}`, `|x|^γ ≤ (asᵏ)^γ` (`γ ≤ 0`) and the shell
  -- lies in `M ∩ B̄_{bsᵏ}(0)`; summing over `k` gives a geometric series of ratio `s^γsᵐ < 1`
  have hgeo : ∀ (γ a b s : ℝ) (Ω : Set (Euclid P)), γ ≤ 0 → 0 < a → 0 < b → 0 < s →
      s ^ γ * s ^ m < 1 → Ω ⊆ ⋃ k : ℕ, M ∩ {x | a * s ^ k ≤ ‖x‖ ∧ ‖x‖ ≤ b * s ^ k} →
      ∫⁻ x in Ω, ENNReal.ofReal (‖x‖ ^ γ) ∂μHE[m] ≠ ∞ := by
    intro γ a b s Ω hγ ha hb hs hρ hΩ
    have hterm : ∀ k : ℕ, ∫⁻ x in M ∩ {x | a * s ^ k ≤ ‖x‖ ∧ ‖x‖ ≤ b * s ^ k},
        ENNReal.ofReal (‖x‖ ^ γ) ∂μHE[m] ≤
          ENNReal.ofReal (a ^ γ * b ^ m) * B * ENNReal.ofReal (s ^ γ * s ^ m) ^ k := by
      intro k
      have hsk : 0 < s ^ k := pow_pos hs k
      calc ∫⁻ x in M ∩ {x | a * s ^ k ≤ ‖x‖ ∧ ‖x‖ ≤ b * s ^ k}, ENNReal.ofReal (‖x‖ ^ γ) ∂μHE[m]
          ≤ ∫⁻ x in M ∩ {x | a * s ^ k ≤ ‖x‖ ∧ ‖x‖ ≤ b * s ^ k},
              ENNReal.ofReal ((a * s ^ k) ^ γ) ∂μHE[m] := by
            apply setLIntegral_mono measurable_const
            rintro x ⟨-, hx1, -⟩
            exact ENNReal.ofReal_le_ofReal (Real.rpow_le_rpow_of_nonpos (mul_pos ha hsk) hx1 hγ)
        _ = ENNReal.ofReal ((a * s ^ k) ^ γ) *
              μHE[m] (M ∩ {x | a * s ^ k ≤ ‖x‖ ∧ ‖x‖ ≤ b * s ^ k}) := setLIntegral_const _ _
        _ ≤ ENNReal.ofReal ((a * s ^ k) ^ γ) * μHE[m] (M ∩ closedBall 0 (b * s ^ k)) := by
            gcongr
            intro x hx
            exact mem_closedBall_zero_iff.2 hx.2
        _ = ENNReal.ofReal ((a * s ^ k) ^ γ) * (ENNReal.ofReal ((b * s ^ k) ^ m) * B) := by
            rw [hball _ (mul_pos hb hsk)]
        _ = ENNReal.ofReal (a ^ γ * b ^ m) * B * ENNReal.ofReal (s ^ γ * s ^ m) ^ k := by
            rw [← ENNReal.ofReal_pow (by positivity), ← mul_assoc,
              ← ENNReal.ofReal_mul (by positivity), mul_right_comm,
              ← ENNReal.ofReal_mul (by positivity)]
            congr 2
            rw [Real.mul_rpow ha.le hsk.le, ← Real.rpow_pow_comm hs.le]
            ring
    have hρ' : ENNReal.ofReal (s ^ γ * s ^ m) < 1 := ENNReal.ofReal_lt_one.2 hρ
    refine ne_top_of_le_ne_top ?_ ((lintegral_mono_set hΩ).trans
      ((lintegral_iUnion_le _ _).trans (ENNReal.tsum_le_tsum hterm)))
    rw [ENNReal.tsum_mul_left, ENNReal.tsum_geometric]
    exact ENNReal.mul_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hBfin)
      (ENNReal.inv_ne_top.2 (tsub_pos_iff_lt.2 hρ').ne')
  refine ⟨?_, ?_, ?_⟩
  · -- (a) `Hᵐ(M ∩ ∂B_c(0)) = cᵐHᵐ(M ∩ ∂B₁(0))`, and `Hᵐ(M ∩ ∂B₁(0)) = 0`
    have hsph : ∀ c : ℝ, 0 < c → μHE[m] (M ∩ sphere (0 : Euclid P) c) =
        ENNReal.ofReal (c ^ m) * μHE[m] (M ∩ sphere (0 : Euclid P) 1) := by
      intro c hc
      have : sphere (0 : Euclid P) c = c • sphere (0 : Euclid P) 1 := by
        rw [smul_sphere' hc.ne', smul_zero, Real.norm_of_nonneg hc.le, mul_one]
      rw [this, hsc c hc]
    have h1 : μHE[m] (M ∩ sphere (0 : Euclid P) 1) = 0 := by
      by_contra hne
      -- the radii `cₙ = 1 + 1/(n+1) ∈ (1, 2]` are distinct
      set c : ℕ → ℝ := fun n => 1 + 1 / ((n : ℝ) + 1) with hc_def
      have hc1 : ∀ n, 1 ≤ c n := fun n => by
        have : (0 : ℝ) ≤ 1 / ((n : ℝ) + 1) := by positivity
        simp only [hc_def]; linarith
      have hc2 : ∀ n, c n ≤ 2 := fun n => by
        have : 1 / ((n : ℝ) + 1) ≤ 1 := by
          rw [div_le_one (by positivity)]; linarith [(Nat.cast_nonneg n : (0 : ℝ) ≤ n)]
        simp only [hc_def]; linarith
      have hcinj : Function.Injective c := by
        intro i j hij
        simp only [hc_def, add_right_inj, one_div, inv_inj, add_left_inj, Nat.cast_inj] at hij
        exact hij
      -- so the spheres `M ∩ ∂B_{cₙ}(0) ⊆ M ∩ B̄₂(0)` are disjoint Borel sets
      have hdisj : Pairwise (Disjoint on fun n => M ∩ sphere (0 : Euclid P) (c n)) := by
        intro i j hij
        rw [Function.onFun, Set.disjoint_left]
        rintro x ⟨-, hxi⟩ ⟨-, hxj⟩
        rw [mem_sphere_zero_iff_norm] at hxi hxj
        exact hij (hcinj (hxi.symm.trans hxj))
      have hmeas : ∀ n, MeasurableSet (M ∩ sphere (0 : Euclid P) (c n)) := fun n =>
        hMeas.inter isClosed_sphere.measurableSet
      have hsum : ∑' n, μHE[m] (M ∩ sphere (0 : Euclid P) (c n)) ≤
          μHE[m] (M ∩ closedBall (0 : Euclid P) 2) := by
        rw [← measure_iUnion hdisj hmeas]
        refine measure_mono (iUnion_subset fun n => ?_)
        exact inter_subset_inter_right _
          (sphere_subset_closedBall.trans (closedBall_subset_closedBall (hc2 n)))
      -- each has measure `cₙᵐHᵐ(M ∩ ∂B₁(0)) ≥ Hᵐ(M ∩ ∂B₁(0)) > 0`, so their sum is infinite
      have htop : ∑' n, μHE[m] (M ∩ sphere (0 : Euclid P) (c n)) = ∞ := by
        refine top_unique ?_
        rw [← ENNReal.tsum_const_eq_top_of_ne_zero (α := ℕ) hne]
        refine ENNReal.tsum_le_tsum fun n => ?_
        rw [hsph (c n) (by linarith [hc1 n])]
        calc μHE[m] (M ∩ sphere (0 : Euclid P) 1) = 1 * μHE[m] (M ∩ sphere (0 : Euclid P) 1) :=
              (one_mul _).symm
          _ ≤ _ := by gcongr; exact ENNReal.one_le_ofReal.2 (one_le_pow₀ (hc1 n))
      exact hfin _ (isCompact_closedBall 0 2) (top_unique (htop ▸ hsum))
    intro c hc
    rw [hsph c hc, h1, mul_zero]
  · -- (b) for `α ≥ 0`, `|x|^α ≤ 1` on `B₁(0)`; for `−m < α < 0`, shells `2⁻ᵏ⁻¹ ≤ |x| ≤ 2⁻ᵏ`
    intro α hα
    rcases le_or_gt 0 α with hα0 | hα0
    · refine ne_top_of_le_ne_top (hfin _ (isCompact_closedBall (0 : Euclid P) 1)) ?_
      calc ∫⁻ x in M ∩ ball (0 : Euclid P) 1, ENNReal.ofReal (‖x‖ ^ α) ∂μHE[m]
          ≤ ∫⁻ x in M ∩ ball (0 : Euclid P) 1, 1 ∂μHE[m] := by
            apply setLIntegral_mono measurable_const
            rintro x ⟨-, hx⟩
            rw [mem_ball_zero_iff] at hx
            exact ENNReal.ofReal_le_one.2 (Real.rpow_le_one (norm_nonneg x) hx.le hα0)
        _ = μHE[m] (M ∩ ball (0 : Euclid P) 1) := by rw [setLIntegral_const, one_mul]
        _ ≤ μHE[m] (M ∩ closedBall (0 : Euclid P) 1) :=
            measure_mono (inter_subset_inter_right _ ball_subset_closedBall)
    · refine hgeo α (1 / 2) 1 (1 / 2) _ hα0.le (by norm_num) one_pos (by norm_num) ?_ ?_
      · -- `2^{-α}2^{-m} = 2^{-(m+α)} < 1`
        rw [← Real.rpow_natCast, ← Real.rpow_add (by norm_num)]
        exact Real.rpow_lt_one (by norm_num) (by norm_num) (by linarith)
      · -- `0 < |x| < 1` as `0 ∉ M`, so `2⁻ᵏ⁻¹ < |x| ≤ 2⁻ᵏ` for some `k`
        rintro x ⟨hxM, hx⟩
        rw [mem_ball_zero_iff] at hx
        have hxpos : 0 < ‖x‖ := norm_pos_iff.2 (by rintro rfl; exact h0 hxM)
        obtain ⟨k, hk1, hk2⟩ := exists_nat_pow_near_of_lt_one hxpos hx.le
          (by norm_num : (0 : ℝ) < 1 / 2) (by norm_num : (1 / 2 : ℝ) < 1)
        refine mem_iUnion.2 ⟨k, hxM, ?_, ?_⟩
        · rw [← pow_succ']; exact hk1.le
        · rw [one_mul]; exact hk2
  · -- (c) `β < −m ≤ 0`; shells `2ᵏ ≤ |x| ≤ 2ᵏ⁺¹`
    intro β hβ
    have hβ0 : β < 0 := by linarith [(Nat.cast_nonneg m : (0 : ℝ) ≤ m)]
    refine hgeo β 1 2 2 _ hβ0.le one_pos two_pos two_pos ?_ ?_
    · -- `2^β2^m = 2^{m+β} < 1`
      rw [← Real.rpow_natCast, ← Real.rpow_add two_pos]
      exact Real.rpow_lt_one_of_one_lt_of_neg one_lt_two (by linarith)
    · -- `|x| ≥ 1`, so `2ᵏ ≤ |x| < 2ᵏ⁺¹` for some `k`
      rintro x ⟨hxM, hx⟩
      rw [mem_ball_zero_iff, not_lt] at hx
      obtain ⟨k, hk1, hk2⟩ := exists_nat_pow_near hx one_lt_two
      refine mem_iUnion.2 ⟨k, hxM, ?_, ?_⟩
      · rw [one_mul]; exact hk1
      · rw [← pow_succ']; exact hk2.le
/-- **Rademacher's theorem on an embedded `C¹` submanifold** (Simon Ch. 2, 4.8–4.9, via
Rademacher's theorem 1.4 in local coordinates).  If `M ⊆ ℝᴾ` is an embedded `C¹` `m`-dimensional
submanifold and `f` is locally Lipschitz on `M`, then `f` is differentiable within `M` at
`Hᵐ`-a.e. point of `M`.  The given charts `(V, W, ψ)` are used directly.  As `ψ` is proper and
injective, `M ∩ B_δ(ψ(b)) ⊆ ψ(V₀)` for every open `V₀ ∋ b`.  With `Q` a linear left inverse of
`Dψ(b)`, the inverse function theorem for `Q ∘ ψ` gives a local inverse `Θ`, differentiable at
`Q(ψ(b))`, so `f = (f ∘ ψ) ∘ Θ ∘ Q` on `M` near `ψ(b)`: if `f ∘ ψ` is differentiable at `b`, then
`f` is differentiable within `M` at `ψ(b)`.  On an open `B ∋ a` where `ψ` and `f ∘ ψ` are
Lipschitz, Rademacher's theorem makes `f ∘ ψ` differentiable off an `Lᵐ`-null set `N`, and
`Hᵐ(ψ(N)) ≤ Λᵐ Lᵐ(N) = 0`.  `M = O ∩ closure M` (`O` the union of the chart domains) is Borel,
and countably many of these neighbourhoods cover `M`. -/
theorem Submission.codim1_hcp_sc_rademacher_submanifold : ∀ (P m : ℕ) (M : Set (Euclid P)) (f : Euclid P → ℝ), IsEmbeddedSubmanifold 1 m M → LocallyLipschitzOn M f → ∀ᵐ x ∂(μHE[m].restrict M), DifferentiableWithinAt ℝ f M x := by
  intro P m M f hM hf
  -- step 1: `M` is Borel, as `M = O ∩ closure M` with `O` the union of the chart domains
  have hMmeas : MeasurableSet M := by
    have key : ∀ y ∈ M, ∃ W : Set (Euclid P), IsOpen W ∧ y ∈ W ∧
        ∀ K ⊆ W, IsCompact K → IsClosed (M ∩ K) := by
      intro y hy
      obtain ⟨V, W, ψ, -, hW, hyW, hψ, -, himg, hprop, -⟩ := hM y hy
      refine ⟨W, hW, hyW, fun K hKW hK => ?_⟩
      have hEq : M ∩ K = ψ '' (V ∩ ψ ⁻¹' K) := by
        ext x
        constructor
        · rintro ⟨hxM, hxK⟩
          obtain ⟨v, hv, rfl⟩ : x ∈ ψ '' V := by rw [himg]; exact ⟨hKW hxK, hxM⟩
          exact ⟨v, ⟨hv, hxK⟩, rfl⟩
        · rintro ⟨v, ⟨hv, hvK⟩, rfl⟩
          exact ⟨(himg ▸ mem_image_of_mem ψ hv : ψ v ∈ W ∩ M).2, hvK⟩
      rw [hEq]
      exact ((hprop K hKW hK).image_of_continuousOn
        (hψ.continuousOn.mono inter_subset_left)).isClosed
    choose! Wf hWo hyW hcl using key
    have hMeq : M = (⋃ y ∈ M, Wf y) ∩ closure M := by
      refine Subset.antisymm (fun x hx => ⟨mem_biUnion hx (hyW x hx), subset_closure hx⟩) ?_
      rintro p ⟨hpO, hpcl⟩
      obtain ⟨y, hy, hpW⟩ := mem_iUnion₂.1 hpO
      obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.1 (hWo y hy) p hpW
      have hC := hcl y hy (closedBall p (r / 2))
        ((closedBall_subset_ball (by linarith)).trans hball) (isCompact_closedBall p (r / 2))
      have h1 : p ∈ ball p (r / 2) ∩ closure M := ⟨mem_ball_self (by linarith), hpcl⟩
      have hsub : ball p (r / 2) ∩ M ⊆ M ∩ closedBall p (r / 2) :=
        fun x hx => ⟨hx.2, ball_subset_closedBall hx.1⟩
      have h3 : p ∈ closure (M ∩ closedBall p (r / 2)) :=
        closure_mono hsub (isOpen_ball.inter_closure h1)
      rw [hC.closure_eq] at h3
      exact h3.1
    rw [hMeq]
    exact (isOpen_biUnion fun y hy => hWo y hy).measurableSet.inter isClosed_closure.measurableSet
  -- step 2: near each `p ∈ M`, `f` is differentiable within `M` off an `Hᵐ`-null set
  have hloc : ∀ p ∈ M, ∃ O : Set (Euclid P), IsOpen O ∧ p ∈ O ∧ ∃ E : Set (Euclid P),
      μHE[m] E = 0 ∧ ∀ x ∈ M ∩ O, x ∉ E → DifferentiableWithinAt ℝ f M x := by
    intro p hp
    obtain ⟨V, W, ψ, hV, hW, hpW, hψ, hinj, himg, hprop, hDψ⟩ := hM p hp
    have hψ1 : ContDiffOn ℝ 1 ψ V := by exact_mod_cast hψ
    have hψM : ∀ c ∈ V, ψ c ∈ M := fun c hc => (himg ▸ mem_image_of_mem ψ hc : ψ c ∈ W ∩ M).2
    -- (a) `M ∩ B_δ(ψ(b)) ⊆ ψ(V₀)` for open `V₀ ∋ b`, as `ψ` is proper and injective
    have himgnhds : ∀ b ∈ V, ∀ V₀ : Set (Euclid m), IsOpen V₀ → V₀ ⊆ V → b ∈ V₀ →
        ∃ δ : ℝ, 0 < δ ∧ M ∩ ball (ψ b) δ ⊆ ψ '' V₀ := by
      intro b hb V₀ hV₀ hV₀V hbV₀
      have hbW : ψ b ∈ W := (himg ▸ mem_image_of_mem ψ hb : ψ b ∈ W ∩ M).1
      obtain ⟨ε, hε, hεW⟩ := Metric.isOpen_iff.1 hW _ hbW
      have hKW : closedBall (ψ b) (ε / 2) ⊆ W :=
        (closedBall_subset_ball (by linarith)).trans hεW
      -- `C = (V ∩ ψ⁻¹(K)) \ V₀` is compact, so its image is closed and misses `ψ(b)`
      have hCc : IsClosed (ψ '' ((V ∩ ψ ⁻¹' closedBall (ψ b) (ε / 2)) \ V₀)) :=
        (((hprop _ hKW (isCompact_closedBall _ _)).diff hV₀).image_of_continuousOn
          (hψ1.continuousOn.mono fun c hc => hc.1.1)).isClosed
      have hbC : ψ b ∉ ψ '' ((V ∩ ψ ⁻¹' closedBall (ψ b) (ε / 2)) \ V₀) := by
        rintro ⟨c, ⟨⟨hcV, -⟩, hcV₀⟩, hc⟩
        exact hcV₀ (hinj hcV hb hc ▸ hbV₀)
      obtain ⟨δ, hδ, hδC⟩ := Metric.isOpen_iff.1 hCc.isOpen_compl _ hbC
      refine ⟨min (ε / 2) δ, lt_min (by linarith) hδ, fun y hy => ?_⟩
      have hyK : y ∈ closedBall (ψ b) (ε / 2) :=
        ball_subset_closedBall (ball_subset_ball (min_le_left _ _) hy.2)
      obtain ⟨c, hcV, rfl⟩ : y ∈ ψ '' V := by rw [himg]; exact ⟨hKW hyK, hy.1⟩
      refine ⟨c, ?_, rfl⟩
      by_contra hcV₀
      exact hδC (ball_subset_ball (min_le_right _ _) hy.2) ⟨c, ⟨⟨hcV, hyK⟩, hcV₀⟩, rfl⟩
    -- (b) if `f ∘ ψ` is differentiable at `b`, then `f` is differentiable within `M` at `ψ(b)`
    have htransfer : ∀ b ∈ V, DifferentiableAt ℝ (f ∘ ψ) b →
        DifferentiableWithinAt ℝ f M (ψ b) := by
      intro b hb hdiff
      -- a continuous linear left inverse `Q` of the injective `Dψ(b)`
      obtain ⟨Q₀, hQ₀⟩ := LinearMap.exists_leftInverse_of_injective
        (fderiv ℝ ψ b : Euclid m →ₗ[ℝ] Euclid P) (LinearMap.ker_eq_bot.2 (hDψ b hb))
      let Q : Euclid P →L[ℝ] Euclid m := LinearMap.toContinuousLinearMap Q₀
      have hQ : ∀ v, Q (fderiv ℝ ψ b v) = v := fun v => LinearMap.congr_fun hQ₀ v
      -- `Φ = Q ∘ ψ` has strict derivative `id` at `b`
      have hψs : HasStrictFDerivAt ψ (fderiv ℝ ψ b) b :=
        (hψ1.contDiffAt (hV.mem_nhds hb)).hasStrictFDerivAt one_ne_zero
      have hΦ : HasStrictFDerivAt (Q ∘ ψ)
          ((ContinuousLinearEquiv.refl ℝ (Euclid m) : Euclid m ≃L[ℝ] Euclid m) :
            Euclid m →L[ℝ] Euclid m) b := by
        have hQψ : Q.comp (fderiv ℝ ψ b) =
            ((ContinuousLinearEquiv.refl ℝ (Euclid m) : Euclid m ≃L[ℝ] Euclid m) :
              Euclid m →L[ℝ] Euclid m) :=
          ContinuousLinearMap.ext fun v => hQ v
        rw [← hQψ]
        exact Q.hasStrictFDerivAt.comp b hψs
      -- the inverse function theorem: a local inverse `Θ` of `Φ`, differentiable at `Φ(b)`
      set Θ := hΦ.localInverse (Q ∘ ψ) _ b
      have hΘ := hΦ.to_localInverse
      have hleft : ∀ᶠ c in 𝓝 b, Θ ((Q ∘ ψ) c) = c := hΦ.eventually_left_inverse
      obtain ⟨V₁, hV₁sub, hV₁o, hbV₁⟩ := _root_.mem_nhds_iff.1 hleft
      obtain ⟨δ, hδ, hδsub⟩ :=
        himgnhds b hb (V₁ ∩ V) (hV₁o.inter hV) inter_subset_right ⟨hbV₁, hb⟩
      have hΘb : Θ (Q (ψ b)) = b := hleft.self_of_nhds
      -- `f = (f ∘ ψ) ∘ Θ ∘ Q` on `M ∩ B_δ(ψ(b))`, and the right side is differentiable at `ψ(b)`
      have hg : DifferentiableAt ℝ ((f ∘ ψ) ∘ Θ ∘ Q) (ψ b) := by
        have h1 : DifferentiableAt ℝ (f ∘ ψ) (Θ (Q (ψ b))) := by rw [hΘb]; exact hdiff
        exact h1.comp (ψ b) (hΘ.differentiableAt.comp (ψ b) Q.differentiableAt)
      refine hg.differentiableWithinAt.congr_of_eventuallyEq ?_ ?_
      · filter_upwards [inter_mem_nhdsWithin M (ball_mem_nhds (ψ b) hδ)] with y hy
        obtain ⟨c, ⟨hc₁, -⟩, rfl⟩ := hδsub hy
        have hc : Θ (Q (ψ c)) = c := hV₁sub hc₁
        simp only [Function.comp_apply, hc]
      · simp only [Function.comp_apply, hΘb]
    -- (c) `ψ` and `f ∘ ψ` are Lipschitz on an open `B ∋ a`, where `ψ(a) = p`
    obtain ⟨a, haV, rfl⟩ : p ∈ ψ '' V := by rw [himg]; exact ⟨hpW, hp⟩
    obtain ⟨K, t, ht, hft⟩ := hf hp
    obtain ⟨U, hUo, haU, hUt⟩ := mem_nhdsWithin.1 ht
    have hψa : ContDiffAt ℝ 1 ψ a := hψ1.contDiffAt (hV.mem_nhds haV)
    obtain ⟨Λ, s, hs, hψs⟩ := hψa.exists_lipschitzOnWith
    obtain ⟨B, hBsub, hBo, haB⟩ := _root_.mem_nhds_iff.1 (inter_mem (inter_mem (hV.mem_nhds haV) hs)
      (hψa.continuousAt.preimage_mem_nhds (hUo.mem_nhds haU)))
    have hBV : B ⊆ V := fun c hc => (hBsub hc).1.1
    have hψB : LipschitzOnWith Λ ψ B := hψs.mono fun c hc => (hBsub hc).1.2
    have hfB : LipschitzOnWith (K * Λ) (f ∘ ψ) B :=
      hft.comp hψB fun c hc => hUt ⟨(hBsub hc).2, hψM c (hBV hc)⟩
    -- (d) Rademacher: `f ∘ ψ` is differentiable on `B` off the `Lᵐ`-null set `N`
    let N : Set (Euclid m) := {c | c ∈ B ∧ ¬ DifferentiableAt ℝ (f ∘ ψ) c}
    have hN : volume N = 0 := by
      have hrad := hfB.ae_differentiableWithinAt_of_mem (μ := volume)
      rw [ae_iff] at hrad
      refine measure_mono_null (fun c hc => ?_) hrad
      simp only [mem_ofPred_eq, not_imp]
      exact ⟨hc.1, fun hd => hc.2 (hd.differentiableAt (hBo.mem_nhds hc.1))⟩
    obtain ⟨δ, hδ, hδB⟩ := himgnhds a haV B hBo hBV haB
    refine ⟨ball (ψ a) δ, isOpen_ball, mem_ball_self hδ, ψ '' N, ?_, ?_⟩
    · -- (e) `Hᵐ(ψ(N)) ≤ Λᵐ Lᵐ(N) = 0`
      have h := (hψB.mono fun c (hc : c ∈ N) => hc.1).hausdorffMeasure_image_le
        (d := (m : ℝ)) (Nat.cast_nonneg m)
      rw [ENNReal.rpow_natCast] at h
      have h2 : μHE[m] (ψ '' N) ≤ (Λ : ℝ≥0∞) ^ m * volume N := by
        rw [← EuclideanSpace.euclideanHausdorffMeasure_eq_volume m,
          Measure.euclideanHausdorffMeasure_def, Measure.euclideanHausdorffMeasure_def]
        simp only [Measure.smul_apply, ENNReal.smul_def, smul_eq_mul]
        calc _ ≤ _ := mul_le_mul_right h _
          _ = _ := by ring
      rw [hN, mul_zero] at h2
      exact le_antisymm h2 zero_le
    · -- (f) off `ψ(N)`, each `x ∈ M ∩ B_δ(ψ(a))` is `ψ(c)` with `f ∘ ψ` differentiable at `c`
      intro x hx hxE
      obtain ⟨c, hcB, rfl⟩ := hδB hx
      refine htransfer c (hBV hcB) ?_
      by_contra hnd
      exact hxE ⟨c, ⟨hcB, hnd⟩, rfl⟩
  -- step 3: countably many of the neighbourhoods `O p` cover `M` (second countability)
  choose! O hOo hpO E hE hdiff using hloc
  obtain ⟨T, hTM, hTc, hTU⟩ := TopologicalSpace.isOpen_biUnion_countable M O hOo
  have hnull : μHE[m] (⋃ p ∈ T, E p) = 0 :=
    (measure_biUnion_null_iff hTc).2 fun p hp => hE p (hTM hp)
  rw [ae_restrict_iff' hMmeas, ae_iff]
  refine measure_mono_null (fun x hx => ?_) hnull
  simp only [mem_ofPred_eq, not_imp] at hx
  obtain ⟨hxM, hxnd⟩ := hx
  have hxU : x ∈ ⋃ p ∈ M, O p := mem_iUnion₂.2 ⟨x, hxM, hpO x hxM⟩
  rw [← hTU] at hxU
  obtain ⟨p, hpT, hxO⟩ := mem_iUnion₂.1 hxU
  refine mem_iUnion₂.2 ⟨p, hpT, ?_⟩
  by_contra hxE
  exact hxnd (hdiff p (hTM hpT) x ⟨hxM, hxO⟩ hxE)
/-- **Weingarten map and Codazzi equations of a hypersurface** (Simon, Appendix B, B.4–B.5,
p. 231; cf. Ch. 2, 4.26).  Let `M ⊆ A₀` be an `m`-dimensional submanifold of the
`(m + 1)`-dimensional subspace `A₀`, `C^r` for every `r`, with unit normal `ν` in `A₀` that is
`C^∞` on an open `O ⊇ M`, and let `C(y) = Dν(y) ∘ P_y`.  For `x ∈ M` and `a, b, d ∈ T_xM`:
(i) `Dν(x)a ∈ T_xM`; (ii) `Dν(x)a · b = Dν(x)b · a` (B.4); (iii) `(D_aC)(b) · d = (D_bC)(a) · d`
(Codazzi, B.5); (iv) `(D_aC)(b) · d = (D_aC)(d) · b`.
(i): differentiate `ν(γ(t)) ∈ A₀` and `|ν(γ(t))|² = 1` along a curve `γ` with `γ'(0) = a`, and
use `T_xM = A₀ ∩ ν(x)^⊥` (`Submission.codim1_hcp_sc_tangent_normal_complement`).  (ii): in a
`C²` chart `ψ`, differentiate `ν(ψ(v)) · Dψ(v)e = 0` and use the symmetry of `D²ψ`.  On `M`,
`C = C̃ := Dν ∘ (Π − ν ⊗ ν)`, which is differentiable at `x`, so `D_aC = DC̃(x)a`
(`Submission.codim1_hcp_sc_fderivWithin_tangent_eq`) and
`(D_aC)(b) = D²ν(x)(a, b) − (Dν(x)a · b) Dν(x)ν(x)`; (iii) follows from the symmetry of
`D²ν(x)` and (ii).  (iv): by (i) and (ii), `C(y)u · w = C(y)w · u` for `y ∈ M`; differentiate
this identity along `M`. -/
theorem Submission.codim1_hcp_sc_weingarten_codazzi : ∀ (P m : ℕ) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)) (ν : Euclid P → Euclid P), Module.finrank ℝ A₀ = m + 1 → M ⊆ (A₀ : Set (Euclid P)) → (∀ r : ℕ, IsEmbeddedSubmanifold r m M) → (∃ O : Set (Euclid P), IsOpen O ∧ M ⊆ O ∧ ContDiffOn ℝ (⊤ : ℕ∞) ν O) → (∀ x ∈ M, ν x ∈ A₀ ∧ ‖ν x‖ = 1 ∧ ∀ v ∈ tangentSpace M x, inner ℝ (ν x) v = 0) → ∀ x ∈ M, ∀ a ∈ tangentSpace M x, ∀ b ∈ tangentSpace M x, fderiv ℝ ν x a ∈ tangentSpace M x ∧ inner ℝ (fderiv ℝ ν x a) b = inner ℝ (fderiv ℝ ν x b) a ∧ ∀ d ∈ tangentSpace M x, inner ℝ (fderivWithin ℝ (fun y => (fderiv ℝ ν y).comp (Submodule.span ℝ (tangentSpace M y)).starProjection) M x a b) d = inner ℝ (fderivWithin ℝ (fun y => (fderiv ℝ ν y).comp (Submodule.span ℝ (tangentSpace M y)).starProjection) M x b a) d ∧ inner ℝ (fderivWithin ℝ (fun y => (fderiv ℝ ν y).comp (Submodule.span ℝ (tangentSpace M y)).starProjection) M x a b) d = inner ℝ (fderivWithin ℝ (fun y => (fderiv ℝ ν y).comp (Submodule.span ℝ (tangentSpace M y)).starProjection) M x a d) b := by
  intro P m A₀ M ν hA hMA hM hO hν x hx a ha b hb
  obtain ⟨O, hOo, hMO, hνO⟩ := hO
  -- Step 0: `T_y = {v ∈ A₀ : ν(y) · v = 0}` and `P_y w = Π w − (ν(y) · w) ν(y)` on `M`
  have hNC := Submission.codim1_hcp_sc_tangent_normal_complement P m A₀ M ν hA hMA (hM 1) hν
  -- `ν` is `C^∞` near every point of `M`
  have hνc : ∀ y ∈ M, ContDiffAt ℝ (⊤ : ℕ∞) ν y := fun y hy =>
    hνO.contDiffAt (hOo.mem_nhds (hMO hy))
  have hνd : ∀ y ∈ M, HasFDerivAt ν (fderiv ℝ ν y) y := fun y hy =>
    ((hνc y hy).differentiableAt (by simp)).hasFDerivAt
  -- `T_y` is a linear subspace, so `span T_y = T_y`
  have hspan : ∀ y ∈ M, ∀ v ∈ Submodule.span ℝ (tangentSpace M y), v ∈ tangentSpace M y := by
    intro y hy v hv
    rw [(hNC y hy).1] at hv ⊢
    induction hv using Submodule.span_induction with
    | mem w hw => exact hw
    | zero => exact ⟨A₀.zero_mem, inner_zero_right _⟩
    | add u w _ _ hu hw =>
      exact ⟨A₀.add_mem hu.1 hw.1, by rw [inner_add_right, hu.2, hw.2, add_zero]⟩
    | smul c u _ hu => exact ⟨A₀.smul_mem c hu.1, by rw [inner_smul_right, hu.2, mul_zero]⟩
  -- Step 1 (i): `Dν(y) a ∈ T_y`, differentiating `ν(γ(t)) ∈ A₀` and `|ν(γ(t))|² = 1`
  have hi : ∀ y ∈ M, ∀ a ∈ tangentSpace M y, fderiv ℝ ν y a ∈ tangentSpace M y := by
    intro y hy a ha
    obtain ⟨γ, -, hγM, hγ0, hγa⟩ := ha
    have hc : HasDerivAt (ν ∘ γ) (fderiv ℝ ν y a) 0 :=
      (hνd y hy).comp_hasDerivAt_of_eq 0 hγa hγ0.symm
    have hI : Ioo (-1 : ℝ) 1 ∈ 𝓝 (0 : ℝ) := Ioo_mem_nhds (by norm_num) (by norm_num)
    have h0I : (0 : ℝ) ∈ Ioo (-1 : ℝ) 1 := ⟨by norm_num, by norm_num⟩
    rw [(hNC y hy).1]
    refine ⟨?_, ?_⟩
    · -- the difference quotients of `ν ∘ γ` lie in the closed subspace `A₀`
      refine A₀.closed_of_finiteDimensional.mem_of_tendsto hc.tendsto_slope ?_
      filter_upwards [nhdsWithin_le_nhds hI] with t ht
      rw [slope_def_module]
      exact A₀.smul_mem _ (A₀.sub_mem (hν _ (hγM ht)).1 (hν _ (hγM h0I)).1)
    · -- `|ν ∘ γ|² = 1` near `0`, so `2 ν(y) · Dν(y) a = 0`
      have hconst : (fun t => ‖(ν ∘ γ) t‖ ^ 2) =ᶠ[𝓝 0] fun _ => (1 : ℝ) := by
        filter_upwards [hI] with t ht
        simp [(hν _ (hγM ht)).2.1]
      have h0 := hc.norm_sq.unique ((hasDerivAt_const (0 : ℝ) (1 : ℝ)).congr_of_eventuallyEq hconst)
      simp only [Function.comp_apply, hγ0] at h0
      linarith
  -- Step 2 (ii): `Dν(y) a · b = Dν(y) b · a`, from a `C²` chart and the symmetry of `D²ψ`
  have hii : ∀ y ∈ M, ∀ a ∈ tangentSpace M y, ∀ b ∈ tangentSpace M y,
      inner ℝ (fderiv ℝ ν y a) b = inner ℝ (fderiv ℝ ν y b) a := by
    intro y hy a ha b hb
    obtain ⟨V, W, ψ, hV, hW, hyW, hψ, hinj, himg, hprop, hder⟩ := hM 2 y hy
    obtain ⟨v₀, hv₀, rfl⟩ : y ∈ ψ '' V := by rw [himg]; exact ⟨hyW, hy⟩
    have hT : ∀ v ∈ V, tangentSpace M (ψ v) = range (fderiv ℝ ψ v) := fun v hv =>
      Submission.chart_tangentSpace_eq_range_fderiv P m 2 M W V ψ v (by norm_num) hV hW hψ hinj
        himg hprop hder hv
    rw [hT v₀ hv₀] at ha hb
    obtain ⟨e₁, rfl⟩ := ha
    obtain ⟨e₂, rfl⟩ := hb
    have hψc := hψ.contDiffAt (hV.mem_nhds hv₀)
    have hψd : HasFDerivAt ψ (fderiv ℝ ψ v₀) v₀ := (hψc.differentiableAt (by simp)).hasFDerivAt
    have hDψd : HasFDerivAt (fderiv ℝ ψ) (fderiv ℝ (fderiv ℝ ψ) v₀) v₀ :=
      ((hψc.fderiv_right (m := 1) (by norm_num)).differentiableAt (by simp)).hasFDerivAt
    have hsymm : IsSymmSndFDerivAt ℝ ψ v₀ := hψc.isSymmSndFDerivAt (by simp)
    -- `v ↦ ν(ψ(v)) · Dψ(v) e` vanishes on `V`; its derivative in direction `e'` at `v₀`
    have key : ∀ e e' : Euclid m, inner ℝ (ν (ψ v₀)) (fderiv ℝ (fderiv ℝ ψ) v₀ e' e) +
        inner ℝ (fderiv ℝ ν (ψ v₀) (fderiv ℝ ψ v₀ e')) (fderiv ℝ ψ v₀ e) = 0 := by
      intro e e'
      have hzero : (fun v => inner ℝ ((ν ∘ ψ) v) (fderiv ℝ ψ v e)) =ᶠ[𝓝 v₀] fun _ => (0 : ℝ) := by
        filter_upwards [hV.mem_nhds hv₀] with v hv
        have hvM : ψ v ∈ M := (himg ▸ mem_image_of_mem ψ hv : ψ v ∈ W ∩ M).2
        exact (hν (ψ v) hvM).2.2 _ (by rw [hT v hv]; exact mem_range_self e)
      have hd := ((hνd (ψ v₀) hy).comp v₀ hψd).inner ℝ (hDψd.clm_apply (hasFDerivAt_const e v₀))
      have h0 := congrArg (fun L => L e')
        (hd.unique ((hasFDerivAt_const (0 : ℝ) v₀).congr_of_eventuallyEq hzero))
      simpa using h0
    have h1 := key e₂ e₁
    have h2 := key e₁ e₂
    rw [hsymm e₁ e₂] at h1
    linarith
  -- Step 3: `C = C̃` on `M`, where `C̃(y) = Dν(y) ∘ (Π − ν(y) ⊗ ν(y))` is differentiable at `x`
  set Ct : Euclid P → (Euclid P →L[ℝ] Euclid P) := fun y =>
    (fderiv ℝ ν y).comp (A₀.starProjection - (innerSL ℝ (ν y)).smulRight (ν y)) with hCt
  have hCeq : ∀ y ∈ M,
      (fderiv ℝ ν y).comp (Submodule.span ℝ (tangentSpace M y)).starProjection = Ct y := by
    intro y hy
    refine ContinuousLinearMap.ext fun w => ?_
    simp [hCt, (hNC y hy).2 w]
  have hν1 : ContDiffAt ℝ 1 ν x := (hνc x hx).of_le (by simp)
  have hDν1 : ContDiffAt ℝ 1 (fderiv ℝ ν) x := (hνc x hx).fderiv_right (by simp)
  have hD2 : HasFDerivAt (fderiv ℝ ν) (fderiv ℝ (fderiv ℝ ν) x) x :=
    (hDν1.differentiableAt (by simp)).hasFDerivAt
  have hCtd : HasFDerivAt Ct (fderiv ℝ Ct x) x := by
    have hCt1 : ContDiffAt ℝ 1 Ct x := hDν1.clm_comp (contDiffAt_const.sub
      ((((innerSL ℝ : Euclid P →L[ℝ] Euclid P →L[ℝ] ℝ).contDiff.contDiffAt).comp x hν1).smulRight
        hν1))
    exact (hCt1.differentiableAt (by simp)).hasFDerivAt
  -- `D_a C = DC̃(x) a` for `a ∈ T_x` (sibling `tangent_fderiv`)
  have hDC : ∀ a' ∈ tangentSpace M x, fderivWithin ℝ (fun y => (fderiv ℝ ν y).comp
      (Submodule.span ℝ (tangentSpace M y)).starProjection) M x a' = fderiv ℝ Ct x a' :=
    fun a' ha' => Submission.codim1_hcp_sc_fderivWithin_tangent_eq P (Euclid P →L[ℝ] Euclid P) M _ _
      x (hCtd.hasFDerivWithinAt.congr hCeq (hCeq x hx)) a' (Submodule.subset_span ha')
  have hmemT : ∀ v ∈ tangentSpace M x, v ∈ A₀ ∧ inner ℝ (ν x) v = 0 := fun v hv => by
    rw [(hNC x hx).1] at hv
    exact hv
  -- `(D_a C)(b) = D²ν(x)(a, b) − (Dν(x) a · b) Dν(x) ν(x)` for `b ∈ A₀` with `ν(x) · b = 0`
  have hformula : ∀ a' b', b' ∈ A₀ → inner ℝ (ν x) b' = 0 → fderiv ℝ Ct x a' b' =
      fderiv ℝ (fderiv ℝ ν) x a' b' - inner ℝ (fderiv ℝ ν x a') b' • fderiv ℝ ν x (ν x) := by
    intro a' b' hbA hbν
    have hF : (fun y => Ct y b') =
        fun y => fderiv ℝ ν y b' - inner ℝ (ν y) b' • fderiv ℝ ν y (ν y) := by
      funext y
      simp [hCt, Submodule.starProjection_eq_self_iff.mpr hbA]
    have h1 := hCtd.clm_apply (hasFDerivAt_const b' x)
    rw [hF] at h1
    have h2 := (hD2.clm_apply (hasFDerivAt_const b' x)).sub
      (((hνd x hx).inner ℝ (hasFDerivAt_const b' x)).smul (hD2.clm_apply (hνd x hx)))
    have h3 := congrArg (fun L => L a') (h1.unique h2)
    simpa [hbν] using h3
  have hsymmν : IsSymmSndFDerivAt ℝ ν x := (hνc x hx).isSymmSndFDerivAt (by simp)
  refine ⟨hi x hx a ha, hii x hx a ha b hb, fun d hd => ⟨?_, ?_⟩⟩
  · -- Step 4 (iii), Codazzi: symmetry of `D²ν(x)` and (ii)
    rw [hDC a ha, hDC b hb, hformula a b (hmemT b hb).1 (hmemT b hb).2,
      hformula b a (hmemT a ha).1 (hmemT a ha).2, hsymmν a b, hii x hx a ha b hb]
  · -- Step 5 (iv): `C(y) u · w = C(y) w · u` on `M`; differentiate along `M`
    have hsymC : ∀ y ∈ M, ∀ u w : Euclid P, inner ℝ (Ct y u) w = inner ℝ (Ct y w) u := by
      intro y hy u w
      rw [← hCeq y hy]
      set K := Submodule.span ℝ (tangentSpace M y)
      have hPu : K.starProjection u ∈ tangentSpace M y :=
        hspan y hy _ (K.starProjection_apply_mem u)
      have hPw : K.starProjection w ∈ tangentSpace M y :=
        hspan y hy _ (K.starProjection_apply_mem w)
      have h1 : fderiv ℝ ν y (K.starProjection u) ∈ K := Submodule.subset_span (hi y hy _ hPu)
      have h2 : fderiv ℝ ν y (K.starProjection w) ∈ K := Submodule.subset_span (hi y hy _ hPw)
      simp only [ContinuousLinearMap.comp_apply]
      calc inner ℝ (fderiv ℝ ν y (K.starProjection u)) w
          = inner ℝ (K.starProjection (fderiv ℝ ν y (K.starProjection u))) w := by
            rw [Submodule.starProjection_eq_self_iff.mpr h1]
        _ = inner ℝ (fderiv ℝ ν y (K.starProjection u)) (K.starProjection w) :=
            K.inner_starProjection_left_eq_right _ _
        _ = inner ℝ (fderiv ℝ ν y (K.starProjection w)) (K.starProjection u) :=
            hii y hy _ hPu _ hPw
        _ = inner ℝ (K.starProjection (fderiv ℝ ν y (K.starProjection w))) u :=
            (K.inner_starProjection_left_eq_right _ _).symm
        _ = inner ℝ (fderiv ℝ ν y (K.starProjection w)) u := by
            rw [Submodule.starProjection_eq_self_iff.mpr h2]
    have hs0 : EqOn (fun y => inner ℝ (Ct y b) d - inner ℝ (Ct y d) b) (fun _ => (0 : ℝ)) M :=
      fun y hy => sub_eq_zero.mpr (hsymC y hy b d)
    have hsd : HasFDerivAt (fun y => inner ℝ (Ct y b) d - inner ℝ (Ct y d) b) _ x :=
      ((hCtd.clm_apply (hasFDerivAt_const b x)).inner ℝ (hasFDerivAt_const d x)).sub
        ((hCtd.clm_apply (hasFDerivAt_const d x)).inner ℝ (hasFDerivAt_const b x))
    have e1 := Submission.codim1_hcp_sc_fderivWithin_tangent_eq P ℝ M _ _ x
      ((hasFDerivWithinAt_const (0 : ℝ) x M).congr hs0 (hs0 hx)) a (Submodule.subset_span ha)
    have e2 := Submission.codim1_hcp_sc_fderivWithin_tangent_eq P ℝ M _ _ x
      hsd.hasFDerivWithinAt a (Submodule.subset_span ha)
    rw [e1] at e2
    rw [hDC a ha]
    exact sub_eq_zero.mp (by simpa using e2.symm)

/-- **Simon, Appendix B, B.8 (Simons' identity) for a minimal hypersurface of `A₀`**: for every
`x ∈ M`, `Δ_M |A|²(x) = 2 |∇A|²(x) − 2 (|A|²(x))²`, where `δⱼ g = D^M g (P eⱼ)`,
`Δ_M = Σⱼ δⱼ δⱼ`, `|A|² = Σᵢ |Dν(P eᵢ)|²` and `∇A` is the tangential derivative of
`C = Dν ∘ P`.

The proof is the frame-free form of B.4–B.9 (the elementary derivation of [Giu84, Ch. 10] that
Simon cites before B.4).  On the open `O ⊇ M` put `Q(z) w = Π w − ⟨ν(z), w⟩ ν(z)` (`Π` the
projection onto `A₀`), `C(z) = Dν(z) ∘ Q(z)` and `δ_b f(z) = Df(z) (Q(z) b)`.  By
`codim1_hcp_sc_tangent_normal_complement`, `Q(y) = P_y` on `M`, and by
`codim1_hcp_sc_fderivWithin_tangent_eq`, `fderivWithin` along `T_y M` is the derivative of any
ambient smooth extension; so every quantity of the statement is an ambient one.  Then:
* `δ`-derivatives only see values on `M`;
* `δ_a δ_b f − δ_b δ_a f = ⟨ν, a⟩ Df(C b) − ⟨ν, b⟩ Df(C a)` on `M`, by the symmetry of `D²f` and
  of the Weingarten map (B.4, `codim1_hcp_sc_weingarten_codazzi`).  For `f = ν` this is Codazzi
  (B.5); applied to `f = C` it replaces the Gauss and Ricci identities (B.6–B.7);
* contracting Codazzi and using `H = tr C = 0` on `M`: `Σⱼ δⱼ C eⱼ = −|A|² ν` on `M`;
* B.8–B.9: the product rule, the splitting `Σⱼ |δⱼ C|² = |∇A|² + 2 Σⱼ |C² eⱼ|²` and
  `Σᵢ ⟨C eᵢ, Σⱼ δⱼ δⱼ C eᵢ⟩ = −|A|⁴ − 2 Σⱼ |C² eⱼ|²` give `Δ_M |A|² = 2 |∇A|² − 2 |A|⁴`. -/
theorem Submission.codim1_hcp_sc_simons_identity : ∀ (P m : ℕ) (A₀ : Submodule ℝ (Euclid P)) (M : Set (Euclid P)) (ν : Euclid P → Euclid P), Module.finrank ℝ A₀ = m + 1 → M ⊆ (A₀ : Set (Euclid P)) → (∀ r : ℕ, IsEmbeddedSubmanifold r m M) → (∃ O : Set (Euclid P), IsOpen O ∧ M ⊆ O ∧ ContDiffOn ℝ (⊤ : ℕ∞) ν O) → (∀ x ∈ M, ν x ∈ A₀ ∧ ‖ν x‖ = 1 ∧ ∀ v ∈ tangentSpace M x, inner ℝ (ν x) v = 0) → (∀ x ∈ M, LinearMap.trace ℝ (Euclid P) ((Submodule.span ℝ (tangentSpace M x)).starProjection.toLinearMap ∘ₗ (fderiv ℝ ν x).toLinearMap) = 0) → ∀ x ∈ M, (∑ j : Fin P, fderivWithin ℝ (fun y => fderivWithin ℝ (fun z => ∑ i : Fin P, ‖fderiv ℝ ν z ((Submodule.span ℝ (tangentSpace M z)).starProjection (EuclideanSpace.single i 1))‖ ^ 2) M y ((Submodule.span ℝ (tangentSpace M y)).starProjection (EuclideanSpace.single j 1))) M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) = 2 * (∑ i : Fin P, ∑ j : Fin P, ∑ k : Fin P, (inner ℝ (fderivWithin ℝ (fun y => (fderiv ℝ ν y).comp (Submodule.span ℝ (tangentSpace M y)).starProjection) M x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single k 1)) ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single i 1))) ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single j 1))) ^ 2) - 2 * (∑ i : Fin P, ‖fderiv ℝ ν x ((Submodule.span ℝ (tangentSpace M x)).starProjection (EuclideanSpace.single i 1))‖ ^ 2) ^ 2 := by
  intro P m A₀ M ν hdim hMA hM hO hν htr x hx
  refine Exists.elim hO fun O hO' => ?_
  have hOo : IsOpen O := hO'.1
  have hMO : M ⊆ O := hO'.2.1
  have hνO : ContDiffOn ℝ (⊤ : ℕ∞) ν O := hO'.2.2
  have hxO : x ∈ O := hMO hx
  have NC' := Submission.codim1_hcp_sc_tangent_normal_complement P m A₀ M ν hdim hMA (hM 1) hν
  have WC' := Submission.codim1_hcp_sc_weingarten_codazzi P m A₀ M ν hdim hMA hM
    ⟨O, hOo, hMO, hνO⟩ hν
  /- The standard basis `eⱼ` of `ℝᴾ`: Parseval's identity and its consequences. -/
  refine Exists.elim (⟨_, rfl⟩ : ∃ e : Fin P → Euclid P, e = fun i => EuclideanSpace.single i 1)
    fun e he => ?_
  have hpar : ∀ u v : Euclid P, ∑ i, inner ℝ u (e i) * inner ℝ v (e i) = inner ℝ u v := by
    intro u v
    have h := (EuclideanSpace.basisFun (Fin P) ℝ).sum_inner_mul_inner u v
    simp only [EuclideanSpace.basisFun_apply] at h
    rw [← h, he]
    exact Finset.sum_congr rfl fun j _ => by rw [real_inner_comm v]
  have hexp : ∀ u : Euclid P, ∑ i, inner ℝ u (e i) • e i = u := by
    intro u
    have h := (EuclideanSpace.basisFun (Fin P) ℝ).sum_repr' u
    simp only [EuclideanSpace.basisFun_apply] at h
    conv_rhs => rw [← h]
    rw [he]
    exact Finset.sum_congr rfl fun j _ => by rw [real_inner_comm]
  have hsq : ∀ u : Euclid P, ∑ i, inner ℝ u (e i) ^ 2 = ‖u‖ ^ 2 := by
    intro u
    rw [← real_inner_self_eq_norm_sq, ← hpar]
    exact Finset.sum_congr rfl fun j _ => sq _
  have hinclm : ∀ (W : Euclid P →L[ℝ] Euclid P) (n v : Euclid P),
      ∑ i, inner ℝ n (e i) * inner ℝ (W (e i)) v = inner ℝ (W n) v := by
    intro W n v
    conv_rhs => rw [← hexp n]
    rw [map_sum, sum_inner]
    exact Finset.sum_congr rfl fun i _ => by rw [map_smul, real_inner_smul_left]
  have hsmclm : ∀ (T : Euclid P →L[ℝ] Euclid P) (u : Euclid P),
      ∑ i, inner ℝ u (e i) • T (e i) = T u := by
    intro T u
    conv_rhs => rw [← hexp u]
    rw [map_sum]
    exact Finset.sum_congr rfl fun i _ => (map_smul T _ _).symm
  /- Step B (linear algebra): `Σⱼ |L_j|²` splits into the tangential block and twice
  `Σⱼ |S² eⱼ|²`, given the normal parts of `L_j` in both slots. -/
  have hstepB : ∀ (n : Euclid P) (S R : Euclid P →L[ℝ] Euclid P)
      (L : Fin P → Euclid P →L[ℝ] Euclid P), ‖n‖ = 1 → R n = 0 →
      (∀ w, inner ℝ n (R w) = 0) → (∀ w, inner ℝ n (S w) = 0) →
      (∀ u v, inner ℝ (R u) v = inner ℝ u (R v)) → (∀ w, S (R w) = S w) →
      (∀ u v, inner ℝ (S u) v = inner ℝ u (S v)) →
      (∀ j b, L j b - L j (R b) = -(inner ℝ n b • S (S (e j)))) →
      (∀ j b, L j b - R (L j b) = -(inner ℝ (S (e j)) (S b) • n)) →
      ∑ j, ∑ i, ‖L j (e i)‖ ^ 2 =
        ∑ j, ∑ i, ∑ k, inner ℝ (L j (R (e i))) (R (e k)) ^ 2 + 2 * ∑ j, ‖S (S (e j))‖ ^ 2 := by
    intro n S R L hn hRn hnR hnS hRsymm hSR hSsymm hLin' hLout'
    rw [Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    have hnn : inner ℝ n n = 1 := by rw [real_inner_self_eq_norm_sq, hn]; norm_num
    have hnw : inner ℝ n (S (S (e j))) = 0 := hnS _
    -- `L_j eᵢ = R L_j R eᵢ − ⟨n, eᵢ⟩ S² eⱼ − ⟨S² eⱼ, eᵢ⟩ n`
    have hdec : ∀ i, L j (e i) = R (L j (R (e i))) - inner ℝ n (e i) • S (S (e j)) -
        inner ℝ (S (S (e j))) (e i) • n := by
      intro i
      have h1 := hLin' j (e i)
      have h2 := hLout' j (R (e i))
      rw [hSR, ← hSsymm (S (e j)) (e i)] at h2
      calc L j (e i) = (L j (e i) - L j (R (e i))) + (L j (R (e i)) - R (L j (R (e i)))) +
            R (L j (R (e i))) := by abel
        _ = R (L j (R (e i))) - inner ℝ n (e i) • S (S (e j)) -
            inner ℝ (S (S (e j))) (e i) • n := by rw [h1, h2]; abel
    have hnorm : ∀ i, ‖L j (e i)‖ ^ 2 = ‖R (L j (R (e i)))‖ ^ 2 -
        2 * (inner ℝ n (e i) * inner ℝ (R (L j (R (e i)))) (S (S (e j)))) +
        inner ℝ n (e i) ^ 2 * ‖S (S (e j))‖ ^ 2 + inner ℝ (S (S (e j))) (e i) ^ 2 := by
      intro i
      have hnY : inner ℝ n (R (L j (R (e i)))) = 0 := hnR _
      have hYn : inner ℝ (R (L j (R (e i)))) n = 0 := by rw [real_inner_comm]; exact hnY
      have hwn : inner ℝ (S (S (e j))) n = 0 := by rw [real_inner_comm]; exact hnw
      rw [hdec i]
      simp only [← real_inner_self_eq_norm_sq, inner_sub_left, inner_sub_right,
        real_inner_smul_left, real_inner_smul_right, hYn, hnY, hwn, hnw, hnn,
        real_inner_comm (R (L j (R (e i)))) (S (S (e j)))]
      ring
    simp_rw [hnorm]
    rw [Finset.sum_add_distrib, Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum,
      ← Finset.sum_mul]
    have hA : ∑ i, ‖R (L j (R (e i)))‖ ^ 2 =
        ∑ i, ∑ k, inner ℝ (L j (R (e i))) (R (e k)) ^ 2 := by
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [← hsq]
      exact Finset.sum_congr rfl fun k _ => by rw [hRsymm]
    have hB : ∑ i, inner ℝ n (e i) * inner ℝ (R (L j (R (e i)))) (S (S (e j))) = 0 := by
      have := hinclm (R.comp ((L j).comp R)) n (S (S (e j)))
      simp only [ContinuousLinearMap.comp_apply, hRn, map_zero, inner_zero_left] at this
      exact this
    have hC1 : ∑ i, inner ℝ n (e i) ^ 2 = 1 := by
      rw [hsq, hn]; norm_num
    rw [hA, hB, hC1, hsq]
    ring
  /- Step C (algebra): `Σᵢ ⟨S eᵢ, Λ eᵢ⟩ = −|S|⁴ − 2 Σᵢ |S² eᵢ|²` for `Λ` of the form below. -/
  have hstepCalg : ∀ (n : Euclid P) (S : Euclid P →L[ℝ] Euclid P), S n = 0 →
      (∀ w, inner ℝ n (S w) = 0) → (∀ u v, inner ℝ (S u) v = inner ℝ u (S v)) →
      ∀ (Λ : Euclid P → Euclid P) (κ : Euclid P → ℝ) (V : Euclid P),
      (∀ b, Λ b = κ b • n - (∑ i, ‖S (e i)‖ ^ 2) • S b - (2 : ℝ) • S (S (S b)) -
        inner ℝ n b • V) →
      ∑ i, inner ℝ (S (e i)) (Λ (e i)) =
        -(∑ i, ‖S (e i)‖ ^ 2) ^ 2 - 2 * ∑ i, ‖S (S (e i))‖ ^ 2 := by
    intro n S hSn hnS hSsymm Λ κ V hΛ
    have h1 : ∀ i, inner ℝ (S (e i)) n = 0 := fun i => by rw [real_inner_comm]; exact hnS _
    have h2 : ∀ i, inner ℝ (S (e i)) (S (S (S (e i)))) = ‖S (S (e i))‖ ^ 2 := fun i => by
      rw [← hSsymm, real_inner_self_eq_norm_sq]
    have h3 : ∑ i, inner ℝ n (e i) * inner ℝ (S (e i)) V = 0 := by
      rw [hinclm, hSn, inner_zero_left]
    simp_rw [hΛ, inner_sub_right, real_inner_smul_right, h1, h2, real_inner_self_eq_norm_sq]
    simp only [mul_zero, zero_sub, Finset.sum_sub_distrib, Finset.sum_neg_distrib]
    rw [h3, ← Finset.mul_sum, ← Finset.mul_sum]
    ring
  /- The ambient projection field `Q(z) w = Π w − ⟨ν(z), w⟩ ν(z)`. -/
  refine Exists.elim (⟨_, rfl⟩ : ∃ Q : Euclid P → Euclid P →L[ℝ] Euclid P,
      Q = fun z => A₀.starProjection - (innerSL ℝ (ν z)).smulRight (ν z)) fun Q hQdef => ?_
  have hQ : ∀ z w, Q z w = A₀.starProjection w - inner ℝ (ν z) w • ν z := fun z w => by
    rw [hQdef]; simp
  have hQsymm : ∀ z u v, inner ℝ (Q z u) v = inner ℝ u (Q z v) := by
    intro z u v
    rw [hQ, hQ, inner_sub_left, inner_sub_right, real_inner_smul_left, real_inner_smul_right,
      Submodule.inner_starProjection_left_eq_right, real_inner_comm (ν z) u]
    ring
  -- where `ν ∈ A₀` is a unit vector, `Q` is the orthogonal projection onto `A₀ ∩ ν^⊥`
  have hQfacts : ∀ y, ν y ∈ A₀ → ‖ν y‖ = 1 →
      (∀ w, inner ℝ (ν y) (Q y w) = 0) ∧ (∀ w, Q y w ∈ A₀) ∧ Q y (ν y) = 0 ∧
        (∀ v ∈ A₀, inner ℝ (ν y) v = 0 → Q y v = v) ∧ (∀ w, Q y (Q y w) = Q y w) := by
    intro y hA h1
    have hPν : A₀.starProjection (ν y) = ν y := (Submodule.starProjection_eq_self_iff).2 hA
    have hνν : inner ℝ (ν y) (ν y) = 1 := by rw [real_inner_self_eq_norm_sq, h1]; norm_num
    have h1' : ∀ w, inner ℝ (ν y) (Q y w) = 0 := by
      intro w
      rw [hQ, inner_sub_right, real_inner_smul_right, hνν,
        ← Submodule.inner_starProjection_left_eq_right, hPν]
      ring
    have h2 : ∀ w, Q y w ∈ A₀ := fun w => by
      rw [hQ]; exact A₀.sub_mem (A₀.starProjection_apply_mem w) (A₀.smul_mem _ hA)
    have h4 : ∀ v ∈ A₀, inner ℝ (ν y) v = 0 → Q y v = v := by
      intro v hv hνv
      rw [hQ, hνv, zero_smul, sub_zero]
      exact (Submodule.starProjection_eq_self_iff).2 hv
    refine ⟨h1', h2, ?_, h4, fun w => h4 _ (h2 w) (h1' w)⟩
    rw [hQ, hPν, hνν, one_smul, sub_self]
  /- Smoothness on `O`. -/
  have hdiff : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] {f : Euclid P → F},
      ContDiffOn ℝ (⊤ : ℕ∞) f O → ∀ {y : Euclid P}, y ∈ O → DifferentiableAt ℝ f y := by
    intro F _ _ f hf y hy
    exact (hf.contDiffAt (hOo.mem_nhds hy)).differentiableAt (by simp)
  have hcdf : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] {f : Euclid P → F},
      ContDiffOn ℝ (⊤ : ℕ∞) f O → ContDiffOn ℝ (⊤ : ℕ∞) (fderiv ℝ f) O := by
    intro F _ _ f hf
    exact hf.fderiv_of_isOpen hOo (by simp)
  have hQb : ∀ b, ContDiffOn ℝ (⊤ : ℕ∞) (fun z => Q z b) O := by
    intro b
    have h : (fun z => Q z b) = fun z => A₀.starProjection b - inner ℝ (ν z) b • ν z :=
      funext fun z => hQ z b
    rw [h]
    exact contDiffOn_const.sub ((hνO.inner ℝ contDiffOn_const).smul hνO)
  have hQs : ContDiffOn ℝ (⊤ : ℕ∞) Q O := by
    rw [hQdef]
    exact contDiffOn_const.sub (((innerSL ℝ).contDiff.comp_contDiffOn hνO).smulRight hνO)
  /- Derivative formulas. -/
  have hfis : ∀ {W : Euclid P → Euclid P} {y : Euclid P}, DifferentiableAt ℝ ν y →
      DifferentiableAt ℝ W y → ∀ c u : Euclid P,
      fderiv ℝ (fun z => inner ℝ (ν z) c • W z) y u =
        inner ℝ (fderiv ℝ ν y u) c • W y + inner ℝ (ν y) c • fderiv ℝ W y u := by
    intro W y hνy hW c u
    rw [fderiv_fun_smul (hνy.inner ℝ (differentiableAt_const c)) hW, add_apply, smul_apply,
      ContinuousLinearMap.smulRight_apply, fderiv_inner_apply ℝ hνy (differentiableAt_const c),
      fderiv_const_apply, zero_apply, inner_zero_right, zero_add, add_comm]
  have hfQ : ∀ {y : Euclid P}, DifferentiableAt ℝ ν y → ∀ b u : Euclid P,
