        ⟨fun x => ζ x •
          ((ω : DifferentialForm (Euclid P) (k + 1)) (Fs j x)).compContinuousLinearMap
            (fderiv ℝ (Fs j) x),
          cutTest (k + 1) ζ _ hζ hζc (hpb P P (k + 1) (Fs j) _ (hFs j) ω.property.1.1)⟩
