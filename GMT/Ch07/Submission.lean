    intro j
    cases j with
    | zero => rw [hOB0, sk_bmass_boundary]; exact ENNReal.zero_lt_top
    | succ i =>
      rw [hOBs]
      exact lt_of_le_of_lt (sk_slice_boundary m T μ' ξ' d B hμ'fin hξ' hbd' hrep' hd hB (r i))
