    have hs1 := qs_second_diff hGd hlip hp hq (D := D) (by linarith)
    have hs2 := qs_norm_sub_le hGd hb (p := q + D) (q := q + t • a)
      ((norm_add_le _ _).trans (by linarith)) ((norm_add_le _ _).trans (by linarith))
    rw [add_sub_add_left_eq_sub] at hs2
