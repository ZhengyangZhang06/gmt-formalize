    hRspt.trans (closure_minimal (iUnion_subset fun j => (hspt j).2.1) hK₂), hbdspt,
    hSspt.trans (closure_minimal (iUnion_subset fun j => (hspt j).2.2.2) hK₃),
    hQm.trans hVsum, hbdm, hRm.trans hHsum, hSm.trans hEsum⟩

