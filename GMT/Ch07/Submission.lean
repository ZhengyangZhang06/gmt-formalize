            rw [setIntegral_const, hvol x₀ r hr, smul_eq_mul]
        _ = C₀ * (r / R) ^ (m + 2) * Λ := by
            rw [← hC₀_def]
            have hsq : (6 * (CH * lam / (R / 2)) * r) ^ 2 =
