  · -- (c7): supports, via `spt φ_{j#}X ⊆ φ_j(spt X)` and Step 8
    have hW4 := PF4 (m + 1) (Λ j) (φ j) (fun x => x) (W j) (hLip j) (hidLip j) (hWnc j).1
      (hWnc j).2.1 (hWnc j).2.2
    have hD4 := PF4 m (Λ j) (φ j) (fun x => x) (D j) (hLip j) (hidLip j) (hDnc j).1 (hDnc j).2.1
