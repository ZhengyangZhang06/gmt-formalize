  -- Step 0: `F = B[Du] + G` satisfies (H_F) on small balls, with `c = B(x)[(Du)ₓ,ᵨ] + G(x)`.
  have hCamp : ∀ (B : Euclid m → ((Euclid m →L[ℝ] Euclid k) →L[ℝ] (Euclid m →L[ℝ] Euclid k)))
