      ((tsupport_sub _ _).trans (union_subset (hζB n) (hζB l)))
    rw [← hnorm0 _ (hMζ _ hC).1, ← hnormH _ (hMζ _ hC).2, hsub0 _ _ (hMζ _ (hζC n)).1
