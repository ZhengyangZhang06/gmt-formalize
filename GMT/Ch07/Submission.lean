          ((ω : DifferentialForm (Euclid P) (k + 1)) (Gs j x)).compContinuousLinearMap
            (fderiv ℝ (Gs j) x) := by
        intro j x hx
        show ζ x • _ = _
        rw [hζW x (hEW hx), one_smul]
      have hb : ∀ j, ∀ x ∈ E, (b j : DifferentialForm (Euclid P) (k + 1)) x =
          ((ω : DifferentialForm (Euclid P) (k + 1)) (Fs j x)).compContinuousLinearMap
            (fderiv ℝ (Fs j) x) := by
        intro j x hx
        show ζ x • _ = _
        rw [hζW x (hEW hx), one_smul]
      have hc : ∀ j, ∀ x ∈ E, (c j : DifferentialForm (Euclid P) k) x = ∫ t in (0 : ℝ)..1,
          (((ω : DifferentialForm (Euclid P) (k + 1)) (Fs j x + t • (Gs j x - Fs j x))).curryLeft
            (Gs j x - Fs j x)).compContinuousLinearMap
              (fderiv ℝ (Fs j) x + t • (fderiv ℝ (Gs j) x - fderiv ℝ (Fs j) x)) := by
        intro j x hx
        show ζ x • _ = _
        rw [hζW x (hEW hx), one_smul]
      have he : ∀ j, ∀ x ∈ E,
          ((a j - b j - exteriorDerivativeTestOn univ k (c j) :
            TestFormOn (univ : Set (Euclid P)) (k + 1)) :
              DifferentialForm (Euclid P) (k + 1)) x = ∫ t in (0 : ℝ)..1,
          (((exteriorDerivativeTestOn univ (k + 1) ω : DifferentialForm (Euclid P) (k + 1 + 1))
            (Fs j x + t • (Gs j x - Fs j x))).curryLeft (Gs j x - Fs j x)).compContinuousLinearMap
              (fderiv ℝ (Fs j) x + t • (fderiv ℝ (Gs j) x - fderiv ℝ (Fs j) x)) := by
        intro j x hx
        have hxW := hEW hx
        simp only [Submodule.coe_sub, Pi.sub_apply]
        show ζ x • _ - ζ x • _ - exteriorDerivative (fun y => ζ y • _) x = _
        rw [hζW x hxW, one_smul, one_smul, dcut k ζ W _ x hW hζW hxW, (hcart j).2 x]
        exact add_sub_cancel_left _ _
      have h1 := (hpush (k + 1) Λ G E X hG hE hX hXE).2.2.1 Gs ω a
        (fun j => hC1 _ (hGs j)) hGsL hGsU ha
      have h2 := (hpush (k + 1) Λ F E X hF hE hX hXE).2.2.1 Fs ω b
        (fun j => hC1 _ (hFs j)) hFsL hFsU hb
      have h3 := (hhomot k Λ F G E X.boundary hF hG hE hbX hbXE).2.2.1 Fs Gs ω c
        (fun j => hC1 _ (hFs j)) (fun j => hC1 _ (hGs j)) hFsL hGsL hFsU hGsU hc
      have h4 := (hhomot (k + 1) Λ F G E X hF hG hE hX hXE).2.2.1 Fs Gs
        (exteriorDerivativeTestOn univ (k + 1) ω)
        (fun j => a j - b j - exteriorDerivativeTestOn univ k (c j))
        (fun j => hC1 _ (hFs j)) (fun j => hC1 _ (hGs j)) hFsL hGsL hFsU hGsU he
      -- `X(a_j − b_j − d c_j) = X(a_j) − X(b_j) − ∂X(c_j)`
      have h5 : Tendsto (fun j => X (a j - b j - exteriorDerivativeTestOn univ k (c j))) atTop
          (𝓝 (push (k + 1) G X ω - push (k + 1) F X ω - homot k F G X.boundary ω)) := by
        refine ((h1.sub h2).sub h3).congr fun j => ?_
        have e1 : X (a j - b j - exteriorDerivativeTestOn univ k (c j)) =
            X (a j - b j) - X (exteriorDerivativeTestOn univ k (c j)) :=
          X.toCurrent.map_sub (a j - b j) (exteriorDerivativeTestOn univ k (c j))
        have e2 : X (a j - b j) = X (a j) - X (b j) := X.toCurrent.map_sub (a j) (b j)
        show X (a j) - X (b j) - X (exteriorDerivativeTestOn univ k (c j)) = _
        rw [e1, e2]
      exact tendsto_nhds_unique h5 h4

/-- **Simon Ch. 6, Deformation Theorem 5.1, displays (6)–(25)** (deformation onto the
`n`-skeleton, `n = m + 1 < P`), with the slicing theorem (SL) and the series theorem (IMS) as
antecedents.  Let `T` be integer multiplicity with `∂T` integer multiplicity, vanishing off the
compact `K`, with `M(T), M(∂T) < ∞`; `μ_T`, `μ_∂T` are the measures of representations of `T`,
`∂T` (`M_W = μ(W)` for open `W`).
* The good centre `a` (`dor_lmb_fcd_good_center`) gives `μ({d < r}) ≤ C r^{n+1} μ(ℝᴾ)` for
  `d = dist(·, L*(a))` and `r ≤ 1/4`; the retraction `ψ` (`dor_lmb_fcd_retraction`) sends
  `{d > 0}` into `Lₙ`, moves points by at most `√P`, and is `c_R/r`-Lipschitz on `{d ≥ r}`.
* Slicing `T` by the `1`-Lipschitz `d` (SL) and a Markov choice (`dor_lmb_fcd_sd_good_slice`)
  give radii `r_j ∈ (2^{-j-3}, 2^{-j-2})` with `M(P_{r_j}) ≤ 4C 2^{-(j+2)(m+1)} M(T)`.
* The shells of `T`, `∂T` between consecutive radii (`dor_lmb_fcd_sd_shells`) vanish off
  `E_j = K ∩ {d ≥ r_j}`, where `ψ` agrees with its `√P c_R/r_j`-Lipschitz extension `φ_j`
  (`dor_lmb_fcd_sd_lipschitz_extend`); `Λ_j = max(1, √P c_R/r_j) ≤ c₄ 2^j`, `c₄ = 8(1 + √P c_R)`.
* `dor_lmb_fcd_sd_core` deforms the shells and sums them with (IMS), with the constant
  `c = max(c₄^{n}(1 + 2C), √P(2c₄)^{n}(1 + 2C), c₄^{n-1}(1 + 2C), √P(2c₄)^{n-1}(1 + 2C))`. -/
theorem Submission.dor_lmb_fcd_skeleton_deformation : ((∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → (∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) ∧ T.support = U ∩ R.measure.support) → ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (n + 1)) (RT : IMRep U (n + 1)) (RB : IMRep U n) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → RT.Represents T → RB.Represents T.boundary → LipschitzWith L f → ∃ Ps : ℝ → GeometricCurrentOn U n, (∀ W : Set (Euclid P), IsOpen W → AEMeasurable (fun t => (Ps t).massOn W) ∧ ∫⁻ t, (Ps t).massOn W ≤ (L : ℝ≥0∞) * T.massOn W) ∧ ∀ᵐ t, IsIntegerMultiplicity (Ps t) ∧ (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) (f ⁻¹' {t}) → Ps t ω = 0) ∧ ∀ ω : TestFormOn U n, Ps t ω = (∫ x in RT.carrier ∩ {x | f x < t}, (RT.mult x : ℝ) * RT.orient x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]) - ∫ x in RB.carrier ∩ {x | f x < t}, (RB.mult x : ℝ) * RB.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → (∀ (P m : ℕ) (U : Set (Euclid P)) (X : ℕ → GeometricCurrentOn U (m + 1)), IsOpen U → (∀ r, IsIntegerMultiplicity (X r)) → ∑' r, (X r).mass ≠ ∞ → ∃ Y : GeometricCurrentOn U (m + 1), IsIntegerMultiplicity Y ∧ (∀ ω : TestFormOn U (m + 1), HasSum (fun r => X r ω) (Y ω)) ∧ Y.mass ≤ ∑' r, (X r).mass) → ∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 0 ≤ c ∧ ∀ (K : Set (Euclid P)) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsCompact K → IsIntegerMultiplicity T → IsIntegerMultiplicity T.boundary → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (K) → T ω = 0) → T.mass ≠ ∞ → T.boundary.mass ≠ ∞ → ∃ (Q : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R₁ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S₁ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q ∧ IsIntegerMultiplicity R₁ ∧ IsIntegerMultiplicity S₁ ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), T ω - Q ω = R₁.boundary ω + S₁ ω) ∧ Q.mass ≤ ENNReal.ofReal c * T.mass ∧ Q.boundary.mass ≤ ENNReal.ofReal c * T.boundary.mass ∧ R₁.mass ≤ ENNReal.ofReal c * T.mass ∧ S₁.mass ≤ ENNReal.ofReal c * T.boundary.mass ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) ({x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} ∩ cthickening (Real.sqrt P) K) → Q ω = 0) ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 2), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 2))) (cthickening (Real.sqrt P) K) → R₁ ω = 0) ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) (cthickening (Real.sqrt P) K) → S₁ ω = 0 := by
  intro hSL hIMS P m hmP
  have hSL' := hSL Submission.dor_imrep_massOn_eq_measure_and_support
  -- constants: retraction `c_R`, good-centre `C`, `c₄ = 8(1 + √P c_R)` and `c`
  obtain ⟨cR, hcR, hRET⟩ := Submission.dor_lmb_fcd_retraction P m hmP
  obtain ⟨CG, hGC⟩ := Submission.dor_lmb_fcd_good_center P m hmP
  obtain ⟨push, homot, hPF1, hPF2, hPF3, hPF4, hPF5⟩ :=
    Submission.dor_lmb_fcd_pushforward_homotopy hIMS P
  have hsP : 0 ≤ Real.sqrt P := Real.sqrt_nonneg _
  have hC0 : (0 : ℝ) ≤ CG := NNReal.coe_nonneg CG
  obtain ⟨c₄, hc₄⟩ : ∃ c₄ : ℝ, c₄ = 8 * (1 + Real.sqrt P * cR) := ⟨_, rfl⟩
  have hc₄0 : 0 ≤ c₄ := by
    rw [hc₄]
    have := mul_nonneg hsP hcR.le
    linarith
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = max (max (c₄ ^ (m + 1) * (1 + 2 * (CG : ℝ)))
      (Real.sqrt P * (2 * c₄) ^ (m + 1) * (1 + 2 * (CG : ℝ))))
      (max (c₄ ^ m * (1 + 2 * (CG : ℝ))) (Real.sqrt P * (2 * c₄) ^ m * (1 + 2 * (CG : ℝ)))) :=
    ⟨_, rfl⟩
  have hc1 : c₄ ^ (m + 1) * (1 + 2 * (CG : ℝ)) ≤ c := by
    rw [hc]; exact le_max_of_le_left (le_max_left _ _)
  have hc2 : Real.sqrt P * (2 * c₄) ^ (m + 1) * (1 + 2 * (CG : ℝ)) ≤ c := by
    rw [hc]; exact le_max_of_le_left (le_max_right _ _)
  have hc3 : c₄ ^ m * (1 + 2 * (CG : ℝ)) ≤ c := by
    rw [hc]; exact le_max_of_le_right (le_max_left _ _)
  have hc4 : Real.sqrt P * (2 * c₄) ^ m * (1 + 2 * (CG : ℝ)) ≤ c := by
    rw [hc]; exact le_max_of_le_right (le_max_right _ _)
  refine ⟨c, le_trans (mul_nonneg (pow_nonneg hc₄0 _) (by positivity)) hc1, ?_⟩
  intro K T hK hTIM hBIM hTK hTmass hBmass
  -- the measures `μ_T`, `μ_∂T` of representations; `μ(ℝᴾ)` is the mass
  obtain ⟨RT, hRT⟩ := hTIM
  obtain ⟨RB, hRB⟩ := hBIM
  have hTuniv : RT.measure univ = T.mass :=
    ((Submission.dor_imrep_massOn_eq_measure_and_support P (m + 1) univ T RT isOpen_univ
      hRT).1 univ isOpen_univ).symm
  have hBuniv : RB.measure univ = T.boundary.mass :=
    ((Submission.dor_imrep_massOn_eq_measure_and_support P m univ T.boundary RB isOpen_univ
      hRB).1 univ isOpen_univ).symm
  have hTfin : IsFiniteMeasure RT.measure := ⟨by rw [hTuniv]; exact lt_top_iff_ne_top.2 hTmass⟩
  have hBfin : IsFiniteMeasure RB.measure := ⟨by rw [hBuniv]; exact lt_top_iff_ne_top.2 hBmass⟩
  -- good centre `a`, dual skeleton `L*(a)`, retraction `ψ`
  obtain ⟨a, ha, hGCa⟩ := hGC RT.measure RB.measure hTfin hBfin
  obtain ⟨ψ, hψ, hψLip⟩ := hRET a ha
  set Lstar : Set (Euclid P) :=
    {w : Euclid P | ∃ s : Finset (Fin P), m + 2 ≤ s.card ∧ ∀ i ∈ s, ∃ z : ℤ, w i - a i = z}
  have hdcont : Continuous fun x => infDist x Lstar := continuous_infDist_pt Lstar
  -- slices of `T` by `d = dist(·, L*(a))` and good radii `r_j ∈ (2^{-j-3}, 2^{-j-2})`
  obtain ⟨Ps, hPs1, hPs2⟩ := hSL' P m univ T RT RB (fun x => infDist x Lstar) 1 isOpen_univ hRT
    hRB (lipschitz_infDist_pt Lstar)
  have hab : ∀ j : ℕ, (1 / 2 : ℝ) ^ (j + 3) < (1 / 2) ^ (j + 2) := fun j =>
    pow_lt_pow_right_of_lt_one₀ (by norm_num) (by norm_num) (by omega)
  have hquarter : ∀ j : ℕ, (1 / 2 : ℝ) ^ (j + 2) ≤ 1 / 4 := fun j =>
    (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : 2 ≤ j + 2)).trans
      (by norm_num)
  choose r hr hrIM hrvan hrform hrmass using fun j : ℕ =>
    Submission.dor_lmb_fcd_sd_good_slice P m T RT RB (fun x => infDist x Lstar) 1 Ps
      ((1 / 2 : ℝ) ^ (j + 3)) ((1 / 2 : ℝ) ^ (j + 2)) hRT hdcont (hab j) hPs1 hPs2
  have hr0 : ∀ j, 0 < r j := fun j => (pow_pos (by norm_num) _).trans (hr j).1
  have hr14 : ∀ j, r j ≤ 1 / 4 := fun j => (hr j).2.le.trans (hquarter j)
  have hrsucc : ∀ j, r (j + 1) < r j := by
    intro j
    have h1 := (hr (j + 1)).2
    rw [show j + 1 + 2 = j + 3 by omega] at h1
    exact h1.trans (hr j).1
  have hranti : Antitone r := antitone_nat_of_succ_le fun j => (hrsucc j).le
  -- shells of `T` and `∂T` between consecutive good radii
  obtain ⟨W, A, D, hWIM, hDIM, hWvan, hDvan, hZvan, hW0bd, hWbd, hWsum, hW0mass, hWmass,
      hD0mass, hDmass, hAmass⟩ :=
    Submission.dor_lmb_fcd_sd_shells P m T RT RB K (fun x => infDist x Lstar) r
      (fun j => Ps (r j)) hRT hRB hK.isClosed hdcont hranti hTK hrform
  -- mass estimates (Simon (6), (7), (10))
  have hGCT : ∀ j : ℕ, RT.measure {x | infDist x Lstar < (1 / 2 : ℝ) ^ (j + 2)} ≤
      ENNReal.ofReal ((CG : ℝ) * (1 / 2) ^ ((j + 2) * (m + 2))) * T.mass := by
    intro j
    calc RT.measure {x | infDist x Lstar < (1 / 2 : ℝ) ^ (j + 2)}
        ≤ (CG : ℝ≥0∞) * ENNReal.ofReal (((1 / 2 : ℝ) ^ (j + 2)) ^ (m + 2)) * RT.measure univ :=
          (hGCa _ (by positivity) (hquarter j)).1
      _ = ENNReal.ofReal ((CG : ℝ) * (1 / 2) ^ ((j + 2) * (m + 2))) * T.mass := by
          rw [hTuniv, ← pow_mul, ENNReal.ofReal_mul hC0, ENNReal.ofReal_coe_nnreal]
  have hGCB : ∀ j : ℕ, RB.measure {x | infDist x Lstar < (1 / 2 : ℝ) ^ (j + 2)} ≤
      ENNReal.ofReal ((CG : ℝ) * (1 / 2) ^ ((j + 2) * (m + 2))) * T.boundary.mass := by
    intro j
    calc RB.measure {x | infDist x Lstar < (1 / 2 : ℝ) ^ (j + 2)}
        ≤ (CG : ℝ≥0∞) * ENNReal.ofReal (((1 / 2 : ℝ) ^ (j + 2)) ^ (m + 2)) * RB.measure univ :=
          (hGCa _ (by positivity) (hquarter j)).2
      _ = ENNReal.ofReal ((CG : ℝ) * (1 / 2) ^ ((j + 2) * (m + 2))) * T.boundary.mass := by
          rw [hBuniv, ← pow_mul, ENNReal.ofReal_mul hC0, ENNReal.ofReal_coe_nnreal]
  have hW0le : (W 0).mass ≤ T.mass := by
    rw [hW0mass, ← hTuniv]; exact measure_mono (subset_univ _)
  have hD0le : (D 0).mass ≤ T.boundary.mass := by
    rw [hD0mass, ← hBuniv]; exact measure_mono (subset_univ _)
  have hWle : ∀ j, (W (j + 1)).mass ≤
      ENNReal.ofReal ((CG : ℝ) * (1 / 2) ^ ((j + 2) * (m + 2))) * T.mass := by
    intro j
    rw [hWmass j]
    have hsub : {x | r (j + 1) ≤ infDist x Lstar ∧ infDist x Lstar < r j} ⊆
        {x | infDist x Lstar < (1 / 2 : ℝ) ^ (j + 2)} := fun x hx => hx.2.trans (hr j).2
    exact (measure_mono (μ := RT.measure) hsub).trans (hGCT j)
  have hDle : ∀ j, (D (j + 1)).mass ≤
      ENNReal.ofReal ((CG : ℝ) * (1 / 2) ^ ((j + 2) * (m + 2))) * T.boundary.mass := by
    intro j
    rw [hDmass j]
    have hsub : {x | r (j + 1) ≤ infDist x Lstar ∧ infDist x Lstar < r j} ⊆
        {x | infDist x Lstar < (1 / 2 : ℝ) ^ (j + 2)} := fun x hx => hx.2.trans (hr j).2
    exact (measure_mono (μ := RB.measure) hsub).trans (hGCB j)
  have hZle : ∀ j, (Ps (r j)).mass ≤
      ENNReal.ofReal (4 * (CG : ℝ) * (1 / 2) ^ ((j + 2) * (m + 1))) * T.mass := by
    intro j
    have hδpos : (0 : ℝ) < (1 / 2) ^ (j + 3) := by positivity
    have hsub : {x | (1 / 2 : ℝ) ^ (j + 3) < infDist x Lstar ∧
        infDist x Lstar < (1 / 2) ^ (j + 2)} ⊆ {x | infDist x Lstar < (1 / 2 : ℝ) ^ (j + 2)} :=
      fun x hx => hx.2
    have hstrip := (measure_mono (μ := RT.measure) hsub).trans (hGCT j)
    have hreal : (1 / 2 : ℝ) ^ (j + 3) * (4 * (CG : ℝ) * (1 / 2) ^ ((j + 2) * (m + 1))) =
        2 * ((CG : ℝ) * (1 / 2) ^ ((j + 2) * (m + 2))) := by
      rw [show (j + 2) * (m + 2) = (j + 2) * (m + 1) + (j + 2) by ring, pow_add]
      ring
    have hR : ENNReal.ofReal ((1 / 2 : ℝ) ^ (j + 3)) *
        (ENNReal.ofReal (4 * (CG : ℝ) * (1 / 2) ^ ((j + 2) * (m + 1))) * T.mass) =
        2 * (ENNReal.ofReal ((CG : ℝ) * (1 / 2) ^ ((j + 2) * (m + 2))) * T.mass) := by
      rw [← mul_assoc, ← ENNReal.ofReal_mul hδpos.le, hreal,
        ENNReal.ofReal_mul (show (0 : ℝ) ≤ 2 by norm_num), ENNReal.ofReal_ofNat, mul_assoc]
    have h1 := hrmass j
    rw [show (1 / 2 : ℝ) ^ (j + 2) - (1 / 2) ^ (j + 3) = (1 / 2) ^ (j + 3) by ring,
      ENNReal.coe_one, one_mul] at h1
    rw [← ENNReal.mul_le_mul_iff_right (ENNReal.ofReal_pos.2 hδpos).ne' ENNReal.ofReal_ne_top,
      hR]
    exact h1.trans (mul_le_mul' le_rfl hstrip)
  have hAtendsto : Tendsto (fun N => (A N).mass) atTop (𝓝 0) := by
    have hAle : ∀ N, (A N).mass ≤ ENNReal.ofReal ((CG : ℝ) * (1 / 2) ^ N) * T.mass := by
      intro N
      rw [hAmass N]
      have hsub : {x | infDist x Lstar < r N} ⊆ {x | infDist x Lstar < (1 / 2 : ℝ) ^ (N + 2)} :=
        fun x hx => lt_trans hx (hr N).2
      have hpow : (1 / 2 : ℝ) ^ ((N + 2) * (m + 2)) ≤ (1 / 2) ^ N :=
        pow_le_pow_of_le_one (by norm_num) (by norm_num) (by nlinarith)
      exact (measure_mono (μ := RT.measure) hsub).trans ((hGCT N).trans
        (mul_le_mul' (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hpow hC0)) le_rfl))
    have h1 : Tendsto (fun N : ℕ => (CG : ℝ) * (1 / 2) ^ N) atTop (𝓝 0) := by
      have := (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 2)
        (by norm_num)).const_mul (CG : ℝ)
      rwa [mul_zero] at this
    have h2 := ENNReal.Tendsto.mul_const (ENNReal.tendsto_ofReal h1) (Or.inr hTmass)
    rw [ENNReal.ofReal_zero, zero_mul] at h2
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds h2 (fun _ => zero_le)
      hAle
  -- globally Lipschitz pieces `φ_j = ψ` on `{d ≥ r_j}` with constants `Λ_j ≤ c₄ 2^j`
  have hψLipOn : ∀ j, LipschitzOnWith (Real.toNNReal (cR / r j)) ψ {x | r j ≤ infDist x Lstar} :=
    fun j => LipschitzOnWith.of_dist_le' fun x hx y hy => hψLip (r j) (hr0 j) (hr14 j) x y hx hy
  choose φ hφLip hφEq using fun j => Submission.dor_lmb_fcd_sd_lipschitz_extend P
    {x | r j ≤ infDist x Lstar} ψ (Real.toNNReal (cR / r j)) (hψLipOn j)
  obtain ⟨Λ, hΛ⟩ : ∃ Λ : ℕ → NNReal,
      ∀ j, Λ j = max 1 (NNReal.sqrt P * Real.toNNReal (cR / r j)) := ⟨_, fun j => rfl⟩
  have hφΛ : ∀ j, LipschitzWith (Λ j) (φ j) := fun j => by
    rw [hΛ]; exact (hφLip j).weaken (le_max_right _ _)
  have hΛ1 : ∀ j, 1 ≤ Λ j := fun j => by rw [hΛ]; exact le_max_left _ _
  have hΛmono : ∀ j, Λ j ≤ Λ (j + 1) := fun j => by
    rw [hΛ, hΛ]
    exact max_le_max le_rfl (mul_le_mul' le_rfl (Real.toNNReal_le_toNNReal
      (div_le_div_of_nonneg_left hcR.le (hr0 (j + 1)) (hranti (Nat.le_succ j)))))
  have hΛc₄ : ∀ j, (Λ j : ℝ) ≤ c₄ * 2 ^ j := fun j => by
    have h2j : (1 : ℝ) ≤ 2 ^ j := one_le_pow₀ (by norm_num)
    have hkey : cR / r j ≤ 8 * cR * 2 ^ j := by
      rw [div_le_iff₀ (hr0 j)]
      have h1 := mul_lt_mul_of_pos_left (hr j).1 (by positivity : (0 : ℝ) < 2 ^ j)
      have h2 : (2 : ℝ) ^ j * (1 / 2) ^ (j + 3) = 1 / 8 := by
        rw [pow_add, ← mul_assoc, ← mul_pow]; norm_num
      rw [h2] at h1
      nlinarith [mul_lt_mul_of_pos_left h1 hcR]
    rw [hΛ, NNReal.coe_max, NNReal.coe_one, NNReal.coe_mul, Real.coe_sqrt, NNReal.coe_natCast,
      Real.coe_toNNReal _ (div_nonneg hcR.le (hr0 j).le), hc₄]
    have h3 : 0 ≤ Real.sqrt P * cR * 2 ^ j :=
      mul_nonneg (mul_nonneg hsP hcR.le) (by positivity)
    refine max_le (by nlinarith) ?_
    nlinarith [mul_le_mul_of_nonneg_left hkey hsP]
  -- the compact sets `E_j = K ∩ {d ≥ r_j}` and the vanishing sets `F₁ = Lₙ ∩ K_√P`, `F₂ = K_√P`
  have hEcpt : ∀ j, IsCompact (K ∩ {x | r j ≤ infDist x Lstar}) := fun j =>
    hK.inter_right (isClosed_le continuous_const hdcont)
  have hEmono : ∀ j, K ∩ {x | r j ≤ infDist x Lstar} ⊆ K ∩ {x | r (j + 1) ≤ infDist x Lstar} :=
    fun j x hx => ⟨hx.1, (hranti (Nat.le_succ j)).trans hx.2⟩
  have hφψ : ∀ j, EqOn (φ j) ψ (K ∩ {x | r j ≤ infDist x Lstar}) := fun j x hx => hφEq j hx.2
  have hψdist : ∀ j, ∀ x ∈ K ∩ {x | r j ≤ infDist x Lstar}, dist (ψ x) x ≤ Real.sqrt P :=
    fun j x hx => (hψ x ((hr0 j).trans_le hx.2)).2
  have hψF₁ : ∀ j, ψ '' (K ∩ {x | r j ≤ infDist x Lstar}) ⊆
      {x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} ∩
        cthickening (Real.sqrt P) K := by
    rintro j _ ⟨x, hx, rfl⟩
    exact ⟨(hψ x ((hr0 j).trans_le hx.2)).1,
      mem_cthickening_of_dist_le _ x _ K hx.1 (hψdist j x hx)⟩
  have hψF₂ : ∀ j, ∀ x ∈ K ∩ {x | r j ≤ infDist x Lstar}, ∀ t ∈ Icc (0 : ℝ) 1,
      x + t • (ψ x - x) ∈ cthickening (Real.sqrt P) K := by
    intro j x hx t ht
    refine mem_cthickening_of_dist_le _ x _ K hx.1 ?_
    rw [dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_eq_abs, abs_of_nonneg ht.1,
      ← dist_eq_norm]
    calc t * dist (ψ x) x ≤ 1 * Real.sqrt P :=
          mul_le_mul ht.2 (hψdist j x hx) dist_nonneg zero_le_one
      _ = Real.sqrt P := one_mul _
  -- deform the shells and sum them (Simon (11)–(25))
  exact Submission.dor_lmb_fcd_sd_core hIMS P m push homot hPF1 hPF2 hPF3 hPF4 hPF5 c c₄ CG T
    ψ (fun j => K ∩ {x | r j ≤ infDist x Lstar}) φ Λ W A D (fun j => Ps (r j))
    ({x : Euclid P | ∃ s : Finset (Fin P), P ≤ m + 1 + s.card ∧ ∀ i ∈ s, ∃ z : ℤ, x i = z} ∩
      cthickening (Real.sqrt P) K) (cthickening (Real.sqrt P) K)
    hc₄0 hC0 hc1 hc2 hc3 hc4 hTmass hBmass hEcpt hEmono hφΛ hΛ1 hΛmono hΛc₄ hφψ hψdist hψF₁
    hψF₂ hWIM hDIM hrIM hWvan hDvan hZvan hW0bd hWbd hWsum hW0le hWle hD0le hDle hZle hAtendsto

/-- **Face representation** (Simon Ch. 6, proof of 5.1, (26)–(28) and (33)).  Let
`Q ∈ 𝒟ₙ(ℝᴾ)`, `n = m + 1`, be integer multiplicity and vanish off the closed set `E`, `Hⁿ`-almost
all of which lies in the open unit faces `A_p = Φ_p(Q₁)`, `p ∈ s`.  Then
`Q(ω) = Σ_p ∫_{Q₁} u_p(y) ω(Φ_p(y))(e_p) dy` with integer-valued `u_p` integrable on `Q₁` and
`Σ_p ∫_{Q₁} |u_p| ≤ M(Q)`.  For an `IMRep` `(M, θ, ξ)` of `Q`, `μ_Q(ℝᴾ ∖ E) = M_{ℝᴾ∖E}(Q) = 0`, so
`M` lies `Hⁿ`-a.e. in the pairwise disjoint `A_p`.  On `M_p = M ∩ A_p ⊆ z + V_ι`, `TₓM_p = TₓM`
a.e., so `ξ = σ_p e_p^*` a.e. for a Borel sign `σ_p`, read off from `ξ(dx^ι)`.  Then
`u_p = (θ σ_p 1_{M_p}) ∘ Φ_p`, and `Hⁿ⌞F_p = Φ_p#(volume⌞Q₁)` transports the integrals. -/
theorem Submission.dor_lmb_fcd_fr_face_representation : ∀ (P m : ℕ) (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (E : Set (Euclid P)) (Q : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ p ∈ s, StrictMono p.2) → IsClosed E → (∀ᵐ x ∂(μHE[m + 1].restrict E), ∃ p ∈ s, ∃ y : Euclid (m + 1), (∀ i, 0 < y i ∧ y i < 1) ∧ WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ) = x) → IsIntegerMultiplicity Q → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Disjoint (tsupport (ω : DifferentialForm (Euclid P) (m + 1))) E → Q ω = 0) → ∃ u : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid (m + 1) → ℝ, (∀ p ∈ s, ∀ y, ∃ z : ℤ, u p y = z) ∧ (∀ p ∈ s, IntegrableOn (u p) {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}) ∧ ENNReal.ofReal (∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |u p y|) ≤ Q.mass ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Q ω = ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, u p y * (ω : DifferentialForm (Euclid P) (m + 1)) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) := by
  intro P m s E Q hs hE hcov hQ hvan
  classical
  obtain ⟨R, hR⟩ := hQ
  -- `Φ_p(y) = z + Σ_j y_j e_{ι(j)}`, the open cube `Q₁ = (0, 1)ⁿ` and the closed face `F_p`
  set Φ : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid (m + 1) → Euclid P := fun p y =>
    WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)
  set Q₁ : Set (Euclid (m + 1)) := {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}
  set F : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Set (Euclid P) := fun p =>
    {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧
      (i ∉ Set.range p.2 → x i = p.1 i)}
  /- Step 1 (face geometry): `Hⁿ⌞F_p = Φ_p#(volume⌞Q₁)`, `∫_{F_p} h dHⁿ = ∫_{Q₁} h ∘ Φ_p`,
  `Φ_p(Q̄₁) ⊆ F_p`, `Φ_p` is an isometry, `F_p` is closed and bounded, and the open face
  `A_p = Φ_p(Q₁)` misses every other face `F_q`. -/
  have hF3 : ∀ p ∈ s, (μHE[m + 1] : Measure (Euclid P)).restrict (F p) =
      Measure.map (Φ p) (volume.restrict Q₁) := fun p hp =>
    (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.1
  have hF4 : ∀ p ∈ s, ∀ h : Euclid P → ℝ,
      ∫ x in F p, h x ∂μHE[m + 1] = ∫ y in Q₁, h (Φ p y) := fun p hp =>
    (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.1
  have hF5 : ∀ p ∈ s, ∀ y : Euclid (m + 1), (∀ i, 0 ≤ y i ∧ y i ≤ 1) → Φ p y ∈ F p :=
    fun p hp => (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.2.1
  have hF6 : ∀ p ∈ s, ∀ y y' : Euclid (m + 1), dist (Φ p y) (Φ p y') = dist y y' :=
    fun p hp => (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.2.2.1
  have hF7 : ∀ p ∈ s, ∀ x ∈ F p, ∀ x' ∈ F p, dist x x' ≤ Real.sqrt P :=
    fun p hp => (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.2.2.2.1
  have hF8 : ∀ p ∈ s, IsClosed (F p) :=
    fun p hp => (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.2.2.2.2.1
  have hF9 : ∀ p ∈ s, ∀ q : (Fin P → ℤ) × (Fin (m + 1) → Fin P), StrictMono q.2 → q ≠ p →
      ∀ y ∈ Q₁, Φ p y ∉ F q :=
    fun p hp => (Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)).2.2.2.2.2.2.2.2
  have hFc : ∀ p ∈ s, IsCompact (F p) := fun p hp =>
    isCompact_of_isClosed_isBounded (hF8 p hp) (isBounded_iff.mpr ⟨_, hF7 p hp⟩)
  have hΦemb : ∀ p ∈ s, MeasurableEmbedding (Φ p) := fun p hp =>
    (Isometry.of_dist_eq (hF6 p hp)).isClosedEmbedding.measurableEmbedding
  have hQ₁m : MeasurableSet Q₁ := by
    have hQ₁' : Q₁ = ⋂ i, {y : Euclid (m + 1) | 0 < y i} ∩ {y | y i < 1} := by
      ext y
      simp only [Q₁, Set.mem_ofPred_eq, mem_iInter, mem_inter_iff]
    rw [hQ₁']
    exact MeasurableSet.iInter fun i =>
      (measurableSet_lt measurable_const (PiLp.continuous_apply 2 _ i).measurable).inter
        (measurableSet_lt (PiLp.continuous_apply 2 _ i).measurable measurable_const)
  have hAm : ∀ p ∈ s, MeasurableSet (Φ p '' Q₁) := fun p hp =>
    (hΦemb p hp).measurableSet_image.mpr hQ₁m
  have hAF : ∀ p ∈ s, Φ p '' Q₁ ⊆ F p := by
    rintro p hp _ ⟨y, hy, rfl⟩
    exact hF5 p hp y fun i => ⟨(hy i).1.le, (hy i).2.le⟩
  have hAdisj : (s : Set ((Fin P → ℤ) × (Fin (m + 1) → Fin P))).PairwiseDisjoint
      fun p => Φ p '' Q₁ := by
    intro p hp q hq hpq
    refine Set.disjoint_left.mpr ?_
    rintro _ ⟨y, hy, rfl⟩ hyq
    exact hF9 p hp q (hs q hq) (Ne.symm hpq) y hy (hAF q hq hyq)
  /- Step 2: an integer multiplicity representation `R = (M, θ, ξ)` of `Q`, its measure
  `μ_R = θ Hⁿ⌞M`, and `M_W(Q) = μ_R(W)` for open `W` (C1). -/
  have hMm : MeasurableSet R.carrier := R.measurableSet_carrier
  have hθm : Measurable fun x => (R.mult x : ℝ) := measurable_from_nat.comp R.measurable_mult
  have hθm' : Measurable fun x => (R.mult x : ℝ≥0∞) := measurable_from_nat.comp R.measurable_mult
  have hfinθ : ∀ K : Set (Euclid P), IsCompact K →
      ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[m + 1] ≠ ∞ :=
    fun K hK => R.locallyIntegrable_mult K hK (subset_univ K)
  -- `Hⁿ(M ∩ B) ≤ ∫_{M ∩ B} θ dHⁿ`, as `θ ≥ 1` on `M`
  have hHle : ∀ B : Set (Euclid P),
      μHE[m + 1] (R.carrier ∩ B) ≤ ∫⁻ x in R.carrier ∩ B, (R.mult x : ℝ≥0∞) ∂μHE[m + 1] := by
    intro B
    calc μHE[m + 1] (R.carrier ∩ B) = ∫⁻ _ in R.carrier ∩ B, (1 : ℝ≥0∞) ∂μHE[m + 1] := by
          rw [setLIntegral_one]
      _ ≤ ∫⁻ x in R.carrier ∩ B, (R.mult x : ℝ≥0∞) ∂μHE[m + 1] := by
          refine setLIntegral_mono hθm' ?_
          intro x hx
          exact_mod_cast R.mult_pos x hx.1
  have hfinM : ∀ K : Set (Euclid P), IsCompact K → K ⊆ univ → μHE[m + 1] (R.carrier ∩ K) ≠ ∞ :=
    fun K hK _ => ne_top_of_le_ne_top (hfinθ K hK) (hHle K)
  have hμR : ∀ B : Set (Euclid P), MeasurableSet B →
      R.measure B = ∫⁻ x in R.carrier ∩ B, (R.mult x : ℝ≥0∞) ∂μHE[m + 1] := by
    intro B hB
    rw [IMRep.measure, withDensity_apply _ hB, Measure.restrict_restrict hB, inter_comm]
  have hC1 := (Submission.dor_imrep_massOn_eq_measure_and_support P (m + 1) univ Q R isOpen_univ
    hR).1
  /- Step 3: `M` is carried by the open faces.  `M_{ℝᴾ∖E}(Q) = 0` since every admissible form is
  supported off `E`, so `Hⁿ(M ∖ E) = 0`; and `Hⁿ(E ∖ ⋃_p A_p) = 0` by hypothesis. -/
  have hmassEc : Q.massOn Eᶜ = 0 := by
    refine le_antisymm (sSup_le ?_) zero_le
    rintro _ ⟨ω, ⟨hωE, -⟩, rfl⟩
    show ENNReal.ofReal (Q ω) ≤ 0
    rw [hvan ω (subset_compl_iff_disjoint_right.mp hωE), ENNReal.ofReal_zero]
  have hMEc : μHE[m + 1] (R.carrier ∩ Eᶜ) = 0 := by
    refine le_antisymm ((hHle Eᶜ).trans (le_of_eq ?_)) zero_le
    rw [← hμR Eᶜ hE.isOpen_compl.measurableSet, ← hC1 Eᶜ hE.isOpen_compl, hmassEc]
  have hEcov : μHE[m + 1] (E \ ⋃ p ∈ s, Φ p '' Q₁) = 0 := by
    have h := ae_iff.mp hcov
    rw [Measure.restrict_apply' hE.measurableSet] at h
    refine measure_mono_null ?_ h
    rintro x ⟨hxE, hxA⟩
    refine ⟨?_, hxE⟩
    rintro ⟨p, hp, y, hy, hxy⟩
    exact hxA (mem_iUnion₂.mpr ⟨p, hp, y, hy, hxy⟩)
  -- the pieces `M_p = M ∩ A_p`
  obtain ⟨Mp, hMp⟩ : ∃ Mp : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Set (Euclid P),
      ∀ p, Mp p = R.carrier ∩ Φ p '' Q₁ := ⟨_, fun _ => rfl⟩
  have hMpm : ∀ p ∈ s, MeasurableSet (Mp p) := fun p hp => by
    rw [hMp p]
    exact hMm.inter (hAm p hp)
  have hMpM : ∀ p, Mp p ⊆ R.carrier := fun p => by
    rw [hMp p]
    exact inter_subset_left
  have hMpF : ∀ p ∈ s, Mp p ⊆ F p := fun p hp => by
    rw [hMp p]
    exact inter_subset_right.trans (hAF p hp)
  have hMpdisj : (s : Set ((Fin P → ℤ) × (Fin (m + 1) → Fin P))).PairwiseDisjoint Mp :=
    hAdisj.mono fun p => by
      rw [hMp p]
      exact inter_subset_right
  have hMae : R.carrier =ᵐ[μHE[m + 1]] ⋃ p ∈ s, Mp p := by
    refine ae_eq_set.mpr ⟨measure_mono_null ?_ (measure_union_null hMEc hEcov), ?_⟩
    · rintro x ⟨hxM, hx⟩
      by_cases hxE : x ∈ E
      · refine mem_union_right _ ⟨hxE, fun hxA => hx ?_⟩
        obtain ⟨p, hp, hxp⟩ := mem_iUnion₂.mp hxA
        refine mem_iUnion₂.mpr ⟨p, hp, ?_⟩
        rw [hMp p]
        exact ⟨hxM, hxp⟩
      · exact mem_union_left _ ⟨hxM, hxE⟩
    · rw [sdiff_eq_empty.mpr (iUnion₂_subset fun p _ => hMpM p)]
      exact measure_empty
  /- Steps 4–5: on `M_p`, `ξ = σ_p e_p^*` a.e. for a Borel sign `σ_p`.  The orientation `ξ(x)`
  orients `TₓM = TₓM_p` (IMC(a)); `M_p ⊆ z + V_ι`, so `ξ(x) = ±e_p^*` (plane orientation); the
  sign is read off from `ξ'(x)(dx^ι)` with `dx^ι(e_p) = 1` and `ξ'` a Borel version of `ξ`. -/
  obtain ⟨dx, hdx, -⟩ := Submission.dor_lmb_fcd_fr_coordinate_covectors P (m + 1)
  have hdxe : ∀ p ∈ s, dx p.2 (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) = 1 :=
    fun p hp => (hdx p.2 p.2 (hs p hp) (hs p hp)).trans (ite_eq_left rfl)
  obtain ⟨ξ', hξ'm, hξξ'⟩ : ∃ ξ' : Euclid P → MultiVector P (m + 1), StronglyMeasurable ξ' ∧
      R.orient =ᵐ[μHE[m + 1].restrict R.carrier] ξ' :=
    ⟨_, R.aestronglyMeasurable_orient.stronglyMeasurable_mk,
      R.aestronglyMeasurable_orient.ae_eq_mk⟩
  obtain ⟨σ, hσ⟩ : ∃ σ : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid P → ℝ,
      ∀ p x, σ p x = if 0 ≤ ξ' x (dx p.2) then 1 else -1 := ⟨_, fun _ _ => rfl⟩
  have hσm : ∀ p, Measurable (σ p) := by
    intro p
    have hev : Measurable fun x => ξ' x (dx p.2) :=
      ((continuous_eval_const (dx p.2)).comp_stronglyMeasurable hξ'm).measurable
    rw [show σ p = fun x => if 0 ≤ ξ' x (dx p.2) then (1 : ℝ) else -1 from funext (hσ p)]
    exact Measurable.ite (measurableSet_le measurable_const hev) measurable_const measurable_const
  have hσabs : ∀ p x, |σ p x| = 1 := by
    intro p x
    rw [hσ p x]
    split_ifs <;> simp
  have hor : ∀ p ∈ s, ∀ᵐ x ∂(μHE[m + 1].restrict (Mp p)), ∀ α : Covector (Euclid P) (m + 1),
      R.orient x α = σ p x * α (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) := by
    intro p hp
    -- (b) `TₓM_p = TₓM` a.e. on `M_p` (IMC(a))
    have hIMC := Submission.cmc_imRep_locality_restrict_sub.1 P (m + 1) univ (Mp p) R.carrier
      isOpen_univ (hMpm p hp) hMm (hMpM p) (subset_univ _) hfinM
    -- (a) `ξ(x)` orients `TₓM` a.e. on `M ⊇ M_p`
    have hori : ∀ᵐ x ∂(μHE[m + 1].restrict (Mp p)), ∃ Q' : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt (m + 1) R.carrier x Q' ∧
          IsUnitOrientationOf (R.orient x) Q' :=
      ae_restrict_of_ae_restrict_of_subset (hMpM p) R.orients
    have hξ'p : ∀ᵐ x ∂(μHE[m + 1].restrict (Mp p)), R.orient x = ξ' x :=
      ae_restrict_of_ae_restrict_of_subset (hMpM p) hξξ'
    filter_upwards [hIMC, hori, hξ'p, ae_restrict_mem (hMpm p hp)] with x hxT hxo hxξ hxM
    obtain ⟨Q', hQ'M, hQ'ξ⟩ := hxo
    -- (c) `M_p ⊆ F_p` lies in the plane `x_i = z_i` (`i ∉ range ι`)
    have hcoord : ∀ a ∈ Mp p, ∀ i, (∀ j, p.2 j ≠ i) → a i = x i := by
      intro a ha i hi
      have hi' : i ∉ Set.range p.2 := by
        rintro ⟨j, hj⟩
        exact hi j hj
      have haF : ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ a i ∧ a i ≤ p.1 i + 1) ∧
          (i ∉ Set.range p.2 → a i = p.1 i) := hMpF p hp ha
      have hxF : ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧
          (i ∉ Set.range p.2 → x i = p.1 i) := hMpF p hp hxM
      rw [(haF i).2 hi', (hxF i).2 hi']
    rcases Submission.dor_lmb_fcd_fr_plane_orientation P (m + 1) p.2 (Mp p) x Q' (R.orient x)
        (hs p hp) hcoord ((hxT Q').mpr hQ'M) hQ'ξ with h | h
    · -- `ξ(x) = e_p^*`, so `ξ'(x)(dx^ι) = 1` and `σ_p(x) = 1`
      have hv : ξ' x (dx p.2) = 1 := by
        rw [← hxξ, h, hdxe p hp]
      intro α
      rw [h α, hσ p x, ite_eq_left (by rw [hv]; exact zero_le_one), one_mul]
    · -- `ξ(x) = -e_p^*`, so `ξ'(x)(dx^ι) = -1` and `σ_p(x) = -1`
      have hv : ξ' x (dx p.2) = -1 := by
        rw [← hxξ, h, hdxe p hp]
      intro α
      rw [h α, hσ p x, ite_eq_right (by rw [hv]; norm_num), neg_one_mul]
  /- Step 6: the densities `f_p = θ σ_p 1_{M_p}` on `ℝᴾ` and `u_p = f_p ∘ Φ_p` on `ℝⁿ`. -/
  obtain ⟨f, hf⟩ : ∃ f : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid P → ℝ,
      ∀ p, f p = (Mp p).indicator fun x => (R.mult x : ℝ) * σ p x := ⟨_, fun _ => rfl⟩
  have hfm : ∀ p ∈ s, Measurable (f p) := fun p hp => by
    rw [hf p]
    exact (hθm.mul (hσm p)).indicator (hMpm p hp)
  have hfabs : ∀ p x, |f p x| = (Mp p).indicator (fun x => (R.mult x : ℝ)) x := by
    intro p x
    rw [hf p]
    by_cases hx : x ∈ Mp p
    · rw [indicator_of_mem hx, indicator_of_mem hx, abs_mul, hσabs, mul_one, Nat.abs_cast]
    · rw [indicator_of_notMem hx, indicator_of_notMem hx, abs_zero]
  /- Step 7: integrability and the mass bound.  `∫_{M_p} θ dHⁿ ≤ ∫_{M ∩ F_p} θ dHⁿ < ∞`. -/
  have hlin : ∀ p ∈ s, ∫⁻ x in Mp p, (R.mult x : ℝ≥0∞) ∂μHE[m + 1] ≠ ∞ := fun p hp =>
    ne_top_of_le_ne_top (hfinθ (F p) (hFc p hp))
      (lintegral_mono_set (subset_inter (hMpM p) (hMpF p hp)))
  have hθint : ∀ p ∈ s, IntegrableOn (fun x => (R.mult x : ℝ)) (Mp p) μHE[m + 1] := by
    intro p hp
    have h := integrable_toReal_of_lintegral_ne_top hθm'.aemeasurable (hlin p hp)
    simp only [ENNReal.toReal_natCast] at h
    exact h
  have hfint : ∀ p ∈ s, IntegrableOn (f p) (F p) μHE[m + 1] := by
    intro p hp
    have hb : IntegrableOn ((Mp p).indicator fun x => (R.mult x : ℝ)) (F p) μHE[m + 1] := by
      refine (integrable_indicator_iff (hMpm p hp)).mpr ?_
      show Integrable _ ((μHE[m + 1].restrict (F p)).restrict (Mp p))
      rw [Measure.restrict_restrict (hMpm p hp), inter_eq_left.mpr (hMpF p hp)]
      exact hθint p hp
    exact hb.mono' (hfm p hp).aestronglyMeasurable
      (ae_of_all _ fun x => (Real.norm_eq_abs _).trans_le (hfabs p x).le)
  -- `∫_{Q₁} |u_p| = ∫_{F_p} |f_p| dHⁿ = ∫_{M_p} θ dHⁿ = μ_R(A_p)`
  have hint_eq : ∀ p ∈ s, ∫ y in Q₁, |f p (Φ p y)| = (R.measure (Φ p '' Q₁)).toReal := by
    intro p hp
    calc ∫ y in Q₁, |f p (Φ p y)| = ∫ x in F p, |f p x| ∂μHE[m + 1] :=
          (hF4 p hp fun x => |f p x|).symm
      _ = ∫ x in F p, (Mp p).indicator (fun x => (R.mult x : ℝ)) x ∂μHE[m + 1] :=
          integral_congr_ae (ae_of_all _ fun x => hfabs p x)
      _ = ∫ x in Mp p, (R.mult x : ℝ) ∂μHE[m + 1] := by
          rw [setIntegral_indicator (hMpm p hp), inter_eq_right.mpr (hMpF p hp)]
      _ = (∫⁻ x in Mp p, ENNReal.ofReal (R.mult x : ℝ) ∂μHE[m + 1]).toReal :=
          integral_eq_lintegral_of_nonneg_ae (ae_of_all _ fun x => Nat.cast_nonneg _)
            hθm.aestronglyMeasurable
      _ = (R.measure (Φ p '' Q₁)).toReal := by
          rw [hμR _ (hAm p hp), ← hMp p]
          simp only [ENNReal.ofReal_natCast]
  have hAfin : ∀ p ∈ s, R.measure (Φ p '' Q₁) ≠ ∞ := by
    intro p hp
    refine ne_top_of_le_ne_top ?_ (measure_mono (hAF p hp))
    rw [hμR (F p) (hF8 p hp).measurableSet]
    exact hfinθ (F p) (hFc p hp)
  refine ⟨fun p y => f p (Φ p y), ?_, ?_, ?_, ?_⟩
  · -- `u_p` is integer-valued: `θ ∈ ℕ`, `σ_p ∈ {1, -1}`
    intro p _ y
    show ∃ z : ℤ, f p (Φ p y) = z
    rw [hf p]
    by_cases hy : Φ p y ∈ Mp p
    · rw [indicator_of_mem hy, hσ p]
      split_ifs
      · exact ⟨R.mult (Φ p y), by push_cast; ring⟩
      · exact ⟨-(R.mult (Φ p y) : ℤ), by push_cast; ring⟩
    · exact ⟨0, by rw [indicator_of_notMem hy, Int.cast_zero]⟩
  · -- `u_p = f_p ∘ Φ_p` is integrable on `Q₁`, since `Hⁿ⌞F_p = Φ_p#(volume⌞Q₁)`
    intro p hp
    have h1 : Integrable (f p) (Measure.map (Φ p) (volume.restrict Q₁)) := by
      rw [← hF3 p hp]
      exact hfint p hp
    exact (hΦemb p hp).integrable_map_iff.mp h1
  · -- `Σ_p ∫_{Q₁} |u_p| = Σ_p μ_R(A_p) = μ_R(⋃_p A_p) ≤ μ_R(ℝᴾ) = M(Q)`
    calc ENNReal.ofReal (∑ p ∈ s, ∫ y in Q₁, |f p (Φ p y)|)
        = ∑ p ∈ s, ENNReal.ofReal (∫ y in Q₁, |f p (Φ p y)|) :=
          ENNReal.ofReal_sum_of_nonneg fun p _ => integral_nonneg fun y => abs_nonneg _
      _ = ∑ p ∈ s, R.measure (Φ p '' Q₁) := Finset.sum_congr rfl fun p hp => by
          rw [hint_eq p hp, ENNReal.ofReal_toReal (hAfin p hp)]
      _ = R.measure (⋃ p ∈ s, Φ p '' Q₁) := (measure_biUnion_finset hAdisj hAm).symm
      _ ≤ R.measure univ := measure_mono (subset_univ _)
      _ = Q.mass := (hC1 univ isOpen_univ).symm
  · /- Step 8: `Q(ω) = ∫_M θ ξ(ω) dHⁿ = Σ_p ∫_{M_p} θ σ_p ω(e_p) dHⁿ
    = Σ_p ∫_{F_p} f_p ω(e_p) dHⁿ = Σ_p ∫_{Q₁} u_p ω(Φ_p(·))(e_p)`. -/
    intro ω
    show Q ω = ∑ p ∈ s, ∫ y in Q₁, f p (Φ p y) * (ω : DifferentialForm (Euclid P) (m + 1)) (Φ p y)
      (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))
    obtain ⟨⟨hsmooth, hcpt⟩, -⟩ := ω.2
    -- `x ↦ ω(x)(e_p)` is continuous with compact support, hence bounded
    have hωe : ∀ p : (Fin P → ℤ) × (Fin (m + 1) → Fin P),
        Continuous (fun x => (ω : DifferentialForm (Euclid P) (m + 1)) x
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) ∧
        ∃ C, ∀ x, ‖(ω : DifferentialForm (Euclid P) (m + 1)) x
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))‖ ≤ C := by
      intro p
      have hc := hsmooth.continuous.eval_const (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))
      refine ⟨hc, hc.bounded_above_of_compact_support ?_⟩
      exact hcpt.comp_left (g := fun α : Covector (Euclid P) (m + 1) =>
        α (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) rfl
    -- the integrand `g = θ ξ(ω)` of `Q(ω)` is `θ σ_p ω(e_p)` a.e. on `M_p`
    obtain ⟨g, hg⟩ : ∃ g : Euclid P → ℝ, ∀ x,
        g x = (R.mult x : ℝ) * R.orient x ((ω : DifferentialForm (Euclid P) (m + 1)) x) :=
      ⟨_, fun _ => rfl⟩
    have hk : ∀ p ∈ s, g =ᵐ[μHE[m + 1].restrict (Mp p)] fun x => (R.mult x : ℝ) * σ p x *
        (ω : DifferentialForm (Euclid P) (m + 1)) x
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) := by
      intro p hp
      filter_upwards [hor p hp] with x hx
      rw [hg x, hx, mul_assoc]
    have hkint : ∀ p ∈ s, IntegrableOn (fun x => (R.mult x : ℝ) * σ p x *
        (ω : DifferentialForm (Euclid P) (m + 1)) x
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) (Mp p) μHE[m + 1] := by
      intro p hp
      have hθσ : IntegrableOn (fun x => (R.mult x : ℝ) * σ p x) (Mp p) μHE[m + 1] := by
        refine (hθint p hp).mono' (hθm.mul (hσm p)).aestronglyMeasurable (ae_of_all _ fun x => ?_)
        rw [Real.norm_eq_abs, abs_mul, hσabs, mul_one, Nat.abs_cast]
      obtain ⟨hc, C, hC⟩ := hωe p
      exact hθσ.mul_bdd hc.aestronglyMeasurable (ae_of_all _ hC)
    have hgint : ∀ p ∈ s, IntegrableOn g (Mp p) μHE[m + 1] := fun p hp =>
      (hkint p hp).congr (hk p hp).symm
    -- each piece transported to the cube
    have hpiece : ∀ p ∈ s, ∫ x in Mp p, g x ∂μHE[m + 1] = ∫ y in Q₁, f p (Φ p y) *
        (ω : DifferentialForm (Euclid P) (m + 1)) (Φ p y)
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) := by
      intro p hp
      have hfun : (fun x => f p x * (ω : DifferentialForm (Euclid P) (m + 1)) x
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) = fun x => (Mp p).indicator
            (fun x => (R.mult x : ℝ) * σ p x * (ω : DifferentialForm (Euclid P) (m + 1)) x
              (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) x := by
        funext x
        rw [hf p]
        exact (indicator_mul_left (Mp p) (fun x => (R.mult x : ℝ) * σ p x) fun x =>
          (ω : DifferentialForm (Euclid P) (m + 1)) x
            (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))).symm
      calc ∫ x in Mp p, g x ∂μHE[m + 1]
          = ∫ x in Mp p, (R.mult x : ℝ) * σ p x * (ω : DifferentialForm (Euclid P) (m + 1)) x
              (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) ∂μHE[m + 1] :=
            integral_congr_ae (hk p hp)
        _ = ∫ x in F p, f p x * (ω : DifferentialForm (Euclid P) (m + 1)) x
              (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) ∂μHE[m + 1] := by
            rw [hfun, setIntegral_indicator (hMpm p hp), inter_eq_right.mpr (hMpF p hp)]
        _ = _ := hF4 p hp _
    calc Q ω = ∫ x in R.carrier, g x ∂μHE[m + 1] := by
          rw [hR ω, IMRep.action]
          exact integral_congr_ae (ae_of_all _ fun x => (hg x).symm)
      _ = ∫ x in ⋃ p ∈ s, Mp p, g x ∂μHE[m + 1] := setIntegral_congr_set hMae
      _ = ∑ p ∈ s, ∫ x in Mp p, g x ∂μHE[m + 1] := integral_biUnion_finset s hMpm hMpdisj hgint
      _ = _ := Finset.sum_congr rfl hpiece

/-- **Divergence-form test forms near a face** (Simon Ch. 6, (28), by the arguments of 2.34–2.35).
For the face `Φ_p(y) = z + Σⱼ yⱼ e_{ι(j)}` and `g : ℝⁿ → ℝⁿ` smooth with compact support and
`|g| ≤ 1`, put `ω = χ Σ_l (-1)^l (g_l ∘ π) dx^{J_l}` with `J_l = ι ∘ succAbove l`, the face
coordinates `π(x)_k = x_{ι(k)} - z_{ι(k)}` and the normal cut-off `χ = η(|x - Φ_p(π x)|²)`, `η = 1`
on `[0, δ²/2]` and `η = 0` on `[δ², ∞)`.  The `dx^{J_l}` are orthonormal, so `|ω| = χ |g ∘ π| ≤ 1`;
`spt ω` lies in `{|x - Φ_p(π x)| ≤ δ} ∩ π⁻¹(spt g)`; and near the face
`ω(x)(e_{J_i}) = (-1)^i gᵢ(π x)`, so the alternating-sum formula for `d` gives
`dω(Φ_p y)(e_p) = Σᵢ ∂ᵢgᵢ(y) = trace Dg(y)`. -/
theorem Submission.dor_lmb_fcd_fr_divergence_form : ∀ (P m : ℕ) (p : (Fin P → ℤ) × (Fin (m + 1) → Fin P)) (g : Euclid (m + 1) → Euclid (m + 1)) (δ : ℝ), StrictMono p.2 → ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → (∀ y, ‖g y‖ ≤ 1) → 0 < δ → ∃ ω : TestFormOn (univ : Set (Euclid P)) m, (∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) m) x) ≤ 1) ∧ (∀ x ∈ tsupport (ω : DifferentialForm (Euclid P) m), ∃ y ∈ tsupport g, dist x (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) ≤ δ) ∧ ∀ y : Euclid (m + 1), exteriorDerivative (ω : DifferentialForm (Euclid P) m) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) = LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) := by
  intro P m p g δ hι hg hgc hg1 hδ
  -- 1. coordinate covectors `dx^J`
  obtain ⟨dx, hdx, hdxn⟩ := Submission.dor_lmb_fcd_fr_coordinate_covectors P m
  -- 2. the frames `J l = ι ∘ succAbove l`: strictly increasing and pairwise distinct
  let J : Fin (m + 1) → Fin m → Fin P := fun l r => p.2 (l.succAbove r)
  have hJ : ∀ l, StrictMono (J l) := fun l => hι.comp (Fin.strictMono_succAbove l)
  have hJinj : Injective J := by
    intro l l' h
    apply Fin.succAbove_left_injective
    funext r
    exact hι.injective (congrFun h r)
  -- the face map `Φ` and the face coordinates `π x = πL x - πL z`, with `π ∘ Φ = id`
  let z : Euclid P := WithLp.toLp 2 (fun i => (p.1 i : ℝ))
  let Φ : Euclid (m + 1) → Euclid P := fun y =>
    z + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)
  let πL : Euclid P →L[ℝ] Euclid (m + 1) :=
    (EuclideanSpace.equiv (Fin (m + 1)) ℝ).symm.toContinuousLinearMap.comp
      (ContinuousLinearMap.pi fun k => EuclideanSpace.proj (p.2 k))
  have hπL : ∀ x k, πL x k = x (p.2 k) := fun x k => rfl
  have hπLe : ∀ j, πL (EuclideanSpace.single (p.2 j) (1 : ℝ)) = EuclideanSpace.single j 1 := by
    intro j
    ext k
    simp [hπL, PiLp.single_apply, hι.injective.eq_iff]
  let π : Euclid P → Euclid (m + 1) := fun x => πL x - πL z
  have hπΦ : ∀ y, π (Φ y) = y := by
    intro y
    simp only [π, Φ, map_add, add_sub_cancel_left, map_sum, map_smul, hπLe]
    ext k
    simp [Pi.single_apply]
  -- the squared normal distance `ν x = |x - Φ(π x)|²` and the cut-off `χ = η ∘ ν`
  let ν : Euclid P → ℝ := fun x => ‖x - Φ (π x)‖ ^ 2
  let χ : Euclid P → ℝ := fun x => Real.smoothTransition (2 - 2 * ν x / δ ^ 2)
  -- 3. the form `ω = Σ_l (-1)^l χ (g_l ∘ π) dx^{J l}`
  let c : Fin (m + 1) → Euclid P → ℝ := fun l x => (-1) ^ (l : ℕ) * χ x * g (π x) l
  let ω : DifferentialForm (Euclid P) m := fun x => ∑ l, c l x • dx (J l)
  have hcoord : ∀ j : Fin (m + 1), ContDiff ℝ (⊤ : ℕ∞) fun y : Euclid (m + 1) => y j :=
    fun j => (EuclideanSpace.proj j : Euclid (m + 1) →L[ℝ] ℝ).contDiff
  have hπ : ContDiff ℝ (⊤ : ℕ∞) π := πL.contDiff.sub contDiff_const
  have hΦ : ContDiff ℝ (⊤ : ℕ∞) Φ :=
    contDiff_const.add (ContDiff.sum fun j _ => (hcoord j).smul contDiff_const)
  have hν : ContDiff ℝ (⊤ : ℕ∞) ν := (contDiff_norm_sq ℝ).comp (contDiff_id.sub (hΦ.comp hπ))
  have hχ : ContDiff ℝ (⊤ : ℕ∞) χ :=
    Real.smoothTransition.contDiff.comp (contDiff_const.sub ((contDiff_const.mul hν).div_const _))
  have hgπ : ∀ l, ContDiff ℝ (⊤ : ℕ∞) fun x => g (π x) l := fun l =>
    (hcoord l).comp (hg.comp hπ)
  have hω : ContDiff ℝ (⊤ : ℕ∞) ω :=
    ContDiff.sum fun l _ => ((contDiff_const.mul hχ).mul (hgπ l)).smul contDiff_const
  -- `χ = 0` where `ν ≥ δ²` and `χ = 1` where `2ν ≤ δ²`
  have hχ0 : ∀ x, δ ^ 2 ≤ ν x → χ x = 0 := by
    intro x hx
    apply Real.smoothTransition.zero_of_nonpos
    have : 2 ≤ 2 * ν x / δ ^ 2 := by
      rw [le_div_iff₀ (by positivity)]
      linarith
    linarith
  have hχ1 : ∀ x, 2 * ν x ≤ δ ^ 2 → χ x = 1 := by
    intro x hx
    apply Real.smoothTransition.one_of_one_le
    have : 2 * ν x / δ ^ 2 ≤ 1 := by
      rw [div_le_one₀ (by positivity)]
      exact hx
    linarith
  -- `spt ω ⊆ Z = {ν ≤ δ²} ∩ π⁻¹(spt g)`, and `|x - Φ(π x)| ≤ δ` on `Z`
  have hω0 : ∀ x, (χ x = 0 ∨ g (π x) = 0) → ω x = 0 := by
    intro x hx
    refine Finset.sum_eq_zero fun l _ => ?_
    rcases hx with h | h <;> simp [c, h]
  have hsuppZ : tsupport ω ⊆ {x | ν x ≤ δ ^ 2} ∩ π ⁻¹' tsupport g := by
    refine closure_minimal (fun x hx => ⟨?_, ?_⟩)
      ((isClosed_le hν.continuous continuous_const).inter
        ((isClosed_tsupport g).preimage hπ.continuous))
    · by_contra h
      exact hx (hω0 x (Or.inl (hχ0 x (le_of_not_ge h))))
    · by_contra h
      exact hx (hω0 x (Or.inr (image_eq_zero_of_notMem_tsupport h)))
  have hZδ : ∀ x, ν x ≤ δ ^ 2 → dist x (Φ (π x)) ≤ δ := fun x hx => by
    rw [dist_eq_norm]
    exact (pow_le_pow_iff_left₀ (norm_nonneg _) hδ.le two_ne_zero).mp hx
  -- compact support: `Z ⊆ cthickening δ (Φ(spt g))`
  have hcpt : HasCompactSupport ω :=
    ((hgc.isCompact.image hΦ.continuous).cthickening (r := δ)).of_isClosed_subset
      (isClosed_tsupport ω) (hsuppZ.trans fun x hx =>
        Metric.mem_cthickening_of_dist_le x (Φ (π x)) δ _ (mem_image_of_mem Φ hx.2)
          (hZδ x hx.1))
  refine ⟨⟨ω, ⟨hω, hcpt⟩, subset_univ _⟩, fun x => ?_, fun x hx => ?_, fun y => ?_⟩
  · -- 4. (i) `|ω(x)| = χ(x) |g(π x)| ≤ 1`
    show covectorEuclideanNorm (∑ l, c l x • dx (J l)) ≤ 1
    rw [hdxn (m + 1) J (fun l => c l x) hJinj hJ]
    refine (Real.sqrt_le_sqrt ?_).trans_eq Real.sqrt_one
    calc ∑ l, c l x ^ 2 = χ x ^ 2 * ‖g (π x)‖ ^ 2 := by
          rw [EuclideanSpace.real_norm_sq_eq, Finset.mul_sum]
          refine Finset.sum_congr rfl fun l _ => ?_
          simp only [c]
          rw [mul_pow, mul_pow, ← pow_mul, mul_comm (l : ℕ) 2, pow_mul, neg_one_sq, one_pow,
            one_mul]
      _ ≤ 1 * 1 := mul_le_mul (pow_le_one₀ (Real.smoothTransition.nonneg _)
          (Real.smoothTransition.le_one _)) (pow_le_one₀ (norm_nonneg _) (hg1 _)) (sq_nonneg _)
          zero_le_one
      _ = 1 := one_mul 1
  · -- 5. (ii) `x` is within `δ` of `Φ(π x)`, `π x ∈ spt g`
    obtain ⟨hxν, hxg⟩ := hsuppZ hx
    exact ⟨π x, hxg, hZδ x hxν⟩
  · -- 6. (iii) near `Φ y`, `χ = 1`, so `ω` agrees with `ω₀ = Σ_l (-1)^l (g_l ∘ π) dx^{J l}`
    let ω₀ : DifferentialForm (Euclid P) m := fun x =>
      ∑ l : Fin (m + 1), ((-1) ^ (l : ℕ) * g (π x) l) • dx (J l)
    have hω₀ : ContDiff ℝ (⊤ : ℕ∞) ω₀ :=
      ContDiff.sum fun l _ => (contDiff_const.mul (hgπ l)).smul contDiff_const
    have hνΦ : 2 * ν (Φ y) < δ ^ 2 := by
      simp only [ν, hπΦ, sub_self, norm_zero]
      simpa using pow_pos hδ 2
    have hloc : ω =ᶠ[𝓝 (Φ y)] ω₀ := by
      filter_upwards [(isOpen_lt (continuous_const.mul hν.continuous) continuous_const).mem_nhds
        hνΦ] with x hx
      simp only [ω, ω₀, c, hχ1 x (le_of_lt hx), mul_one]
    have hd : exteriorDerivative ω (Φ y) = exteriorDerivative ω₀ (Φ y) := hloc.extDeriv_eq
    -- `ω₀(x)(e_{J i}) = (-1)^i g_i(π x)`
    have hω₀e : ∀ i : Fin (m + 1),
        (fun x => ω₀ x (i.removeNth fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) =
          fun x => (-1) ^ (i : ℕ) * g (π x) i := by
      intro i
      funext x
      show (∑ l : Fin (m + 1), ((-1) ^ (l : ℕ) * g (π x) l) • dx (J l))
          (fun r => EuclideanSpace.single (J i r) (1 : ℝ)) = _
      rw [ContinuousAlternatingMap.sum_apply, Finset.sum_eq_single i]
      · rw [ContinuousAlternatingMap.smul_apply, hdx _ _ (hJ i) (hJ i), ite_eq_left rfl,
          smul_eq_mul, mul_one]
      · intro l _ hl
        rw [ContinuousAlternatingMap.smul_apply, hdx _ _ (hJ i) (hJ l),
          ite_eq_right fun h => hl (hJinj h).symm, smul_zero]
      · exact fun h => absurd (Finset.mem_univ i) h
    -- `D[(-1)^i g_i ∘ π](Φ y)(e_{ι i}) = (-1)^i (Dg(y) ê_i)_i`
    have hderiv : ∀ i : Fin (m + 1),
        fderiv ℝ (fun x => (-1) ^ (i : ℕ) * g (π x) i) (Φ y)
          (EuclideanSpace.single (p.2 i) (1 : ℝ)) =
          (-1) ^ (i : ℕ) * fderiv ℝ g y (EuclideanSpace.single i (1 : ℝ)) i := by
      intro i
      have hπd : HasFDerivAt π πL (Φ y) := πL.hasFDerivAt.sub_const (πL z)
      have hgd : HasFDerivAt g (fderiv ℝ g y) (π (Φ y)) := by
        rw [hπΦ]
        exact (hg.differentiable (by simp) y).hasFDerivAt
      have h2 : fderiv ℝ (fun x => (-1) ^ (i : ℕ) * g (π x) i) (Φ y) =
          ((-1 : ℝ) ^ (i : ℕ)) • ((EuclideanSpace.proj i).comp ((fderiv ℝ g y).comp πL)) :=
        (((EuclideanSpace.proj i).hasFDerivAt.comp (Φ y) (hgd.comp (Φ y) hπd)).const_mul
          ((-1 : ℝ) ^ (i : ℕ))).fderiv
      rw [h2, smul_apply, ContinuousLinearMap.comp_apply,
        ContinuousLinearMap.comp_apply, hπLe, smul_eq_mul]
      rfl
    show exteriorDerivative ω (Φ y) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) = _
    rw [hd, exteriorDerivative_apply (hω₀.differentiable (by simp)).differentiableAt,
      LinearMap.trace_eq_sum_inner _ (EuclideanSpace.basisFun (Fin (m + 1)) ℝ)]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hω₀e i, hderiv i, EuclideanSpace.basisFun_apply, EuclideanSpace.inner_single_left,
      map_one, one_mul, ContinuousLinearMap.coe_coe, zsmul_eq_mul]
    push_cast
    rw [← mul_assoc, ← mul_pow, neg_one_mul, neg_neg, one_pow, one_mul]

/-- **Boundary variation on the faces** (Simon Ch. 6, proof of 5.1, (28), second part, by the
arguments of the Constancy Theorem 2.34 and of 2.35).  Let `Q(ω) = Σ_{p∈s} ∫_{Q₁} u_p ω(Φ_p)(e_p)`
with `M(∂Q) < ∞`.  The sets `W_p = {x : dist(x, F_p) < dist(x, F_q) for q ∈ s ∖ {p}}` are
pairwise disjoint, so disjointly supported admissible forms add up to an admissible form and
`Σ_{p∈s} M_{W_p}(∂Q) ≤ M(∂Q)`; put `V_p = M_{W_p}(∂Q)`.  For an admissible `g`, the compact
`Φ_p(spt g)` has positive distance from the other faces, so the divergence form `ω` of `g` is
supported in `W_p`, and `∂Q(ω) = Q(dω) = ∫_{Q₁} u_p div g` since `dω` vanishes on the other faces;
hence `∫_{Q₁} u_p div g ≤ M_{W_p}(∂Q) = V_p`. -/
theorem Submission.dor_lmb_fcd_fr_boundary_variation : ∀ (P m : ℕ) (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (u : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid (m + 1) → ℝ) (Q : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), (∀ p ∈ s, StrictMono p.2) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Q ω = ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, u p y * (ω : DifferentialForm (Euclid P) (m + 1)) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) → Q.boundary.mass ≠ ∞ → ∃ V : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → ℝ, (∀ p ∈ s, 0 ≤ V p) ∧ ENNReal.ofReal (∑ p ∈ s, V p) ≤ Q.boundary.mass ∧ ∀ p ∈ s, ∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g → tsupport g ⊆ {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} → (∀ y, ‖g y‖ ≤ 1) → ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, u p y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) ≤ V p := by
  intro P m s u Q hs hQ hmass
  classical
  -- the parametrizations `Φ_p`, the closed faces `F_p` and the sets `W_p`
  let Φ : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid (m + 1) → Euclid P := fun p y =>
    WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)
  let F : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Set (Euclid P) := fun p =>
    {x : Euclid P | ∀ i : Fin P, (i ∈ Set.range p.2 → (p.1 i : ℝ) ≤ x i ∧ x i ≤ p.1 i + 1) ∧
      (i ∉ Set.range p.2 → x i = p.1 i)}
  let W : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Set (Euclid P) := fun p =>
    {x | ∀ q ∈ s, q ≠ p → infDist x (F p) < infDist x (F q)}
  -- face geometry: `Φ_p` maps the closed cube into `F_p`, is continuous, `F_p` is closed, and
  -- `Φ_p` maps the open cube off every other face
  have hFG : ∀ p ∈ s, (∀ y : Euclid (m + 1), (∀ i, 0 ≤ y i ∧ y i ≤ 1) → Φ p y ∈ F p) ∧
      Continuous (Φ p) ∧ IsClosed (F p) ∧ ∀ q : (Fin P → ℤ) × (Fin (m + 1) → Fin P),
        StrictMono q.2 → q ≠ p → ∀ y : Euclid (m + 1), (∀ i, 0 < y i ∧ y i < 1) → Φ p y ∉ F q := by
    intro p hp
    obtain ⟨-, -, -, -, h5, h6, -, h8, h9⟩ :=
      Submission.dor_lmb_fcd_fr_face_geometry P m p (hs p hp)
    exact ⟨h5, (Isometry.of_dist_eq h6).continuous, h8, h9⟩
  have hFne : ∀ p ∈ s, (F p).Nonempty := fun p hp =>
    ⟨Φ p 0, (hFG p hp).1 0 fun i => by simp⟩
  -- Step 1: the `W_p`, `p ∈ s`, are pairwise disjoint
  have hWdisj : ∀ p ∈ s, ∀ q ∈ s, p ≠ q → ∀ x, x ∈ W p → x ∉ W q := by
    intro p hp q hq hpq x hxp hxq
    exact lt_asymm (hxp q hq (Ne.symm hpq)) (hxq p hp hpq)
  -- Step 2: `Σ_{p∈s} M_{W_p}(∂Q) ≤ M(∂Q)`
  set T := Q.boundary with hT
  have hadm0 : ∀ V : Set (Euclid P),
      (0 : TestFormOn (univ : Set (Euclid P)) m) ∈ massAdmissibleOn univ m V := by
    intro V
    refine ⟨?_, fun x => ?_⟩ <;> simp
  -- (a) a family of admissible forms, one in each `W_p`
  have hfam : ∀ ω : (p : (Fin P → ℤ) × (Fin (m + 1) → Fin P)) → massAdmissibleOn univ m (W p),
      ∑ p ∈ s, ENNReal.ofReal (T (ω p)) ≤ T.mass := by
    intro ω
    -- drop the forms with negative value
    let ω' : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → TestFormOn (univ : Set (Euclid P)) m :=
      fun p => if 0 ≤ T (ω p) then (ω p : TestFormOn (univ : Set (Euclid P)) m) else 0
    have hω' : ∀ p, ENNReal.ofReal (T (ω p)) = ENNReal.ofReal (T (ω' p)) ∧ 0 ≤ T (ω' p) ∧
        ω' p ∈ massAdmissibleOn univ m (W p) := by
      intro p
      by_cases h : 0 ≤ T (ω p)
      · have h0 : ω' p = ω p := ite_eq_left h
        rw [h0]
        exact ⟨rfl, h, (ω p).2⟩
      · have h0 : ω' p = 0 := ite_eq_right h
        rw [h0, map_zero, ENNReal.ofReal_zero, ENNReal.ofReal_eq_zero]
        exact ⟨(not_le.1 h).le, le_rfl, hadm0 (W p)⟩
    -- the sum is admissible in `ℝ^P`: at each point at most one summand is nonzero
    have hsum_adm : (∑ p ∈ s, ω' p) ∈ massAdmissibleOn univ m univ := by
      refine ⟨subset_univ _, fun x => ?_⟩
      have hx : ((∑ p ∈ s, ω' p : TestFormOn (univ : Set (Euclid P)) m) :
          DifferentialForm (Euclid P) m) x =
          ∑ p ∈ s, ((ω' p : TestFormOn (univ : Set (Euclid P)) m) :
            DifferentialForm (Euclid P) m) x := by
        rw [Submodule.coe_sum, Finset.sum_apply]
      rw [hx]
      by_cases hex : ∃ p ∈ s, ((ω' p : TestFormOn (univ : Set (Euclid P)) m) :
          DifferentialForm (Euclid P) m) x ≠ 0
      · obtain ⟨p, hp, hpx⟩ := hex
        have hzero : ∀ q ∈ s, q ≠ p → ((ω' q : TestFormOn (univ : Set (Euclid P)) m) :
            DifferentialForm (Euclid P) m) x = 0 := by
          intro q hq hqp
          by_contra hqx
          exact hWdisj p hp q hq (Ne.symm hqp) x ((hω' p).2.2.1 (subset_tsupport _ hpx))
            ((hω' q).2.2.1 (subset_tsupport _ hqx))
        rw [Finset.sum_eq_single p hzero fun h => absurd hp h]
        exact (hω' p).2.2.2 x
      · have hzero : ∀ p ∈ s, ((ω' p : TestFormOn (univ : Set (Euclid P)) m) :
            DifferentialForm (Euclid P) m) x = 0 := fun p hp =>
          not_not.1 fun hpx => hex ⟨p, hp, hpx⟩
        rw [Finset.sum_eq_zero hzero, covectorEuclideanNorm_zero]
        exact zero_le_one
    calc ∑ p ∈ s, ENNReal.ofReal (T (ω p)) = ∑ p ∈ s, ENNReal.ofReal (T (ω' p)) :=
          Finset.sum_congr rfl fun p _ => (hω' p).1
      _ = ENNReal.ofReal (∑ p ∈ s, T (ω' p)) :=
          (ENNReal.ofReal_sum_of_nonneg fun p _ => (hω' p).2.1).symm
      _ = ENNReal.ofReal (T (∑ p ∈ s, ω' p)) := by rw [map_sum]
      _ ≤ T.mass := T.le_massOn hsum_adm
  -- (b) `M_{W_p}(∂Q)` as a supremum over families, which are directed
  have hsupW : ∀ p, T.massOn (W p) =
      ⨆ ω : (q : (Fin P → ℤ) × (Fin (m + 1) → Fin P)) → massAdmissibleOn univ m (W q),
        ENNReal.ofReal (T (ω p)) := by
    intro p
    rw [GeometricCurrentOn.massOn, sSup_image']
    refine le_antisymm (iSup_le fun ω => ?_) (iSup_le fun ω => le_iSup_of_le (ω p) le_rfl)
    let z : (q : (Fin P → ℤ) × (Fin (m + 1) → Fin P)) → massAdmissibleOn univ m (W q) :=
      fun q => ⟨0, hadm0 (W q)⟩
    exact le_iSup_of_le (Function.update z p ω) (by simp only [Function.update_self, le_refl])
  have hdir : ∀ i j : (p : (Fin P → ℤ) × (Fin (m + 1) → Fin P)) → massAdmissibleOn univ m (W p),
      ∃ k : (p : (Fin P → ℤ) × (Fin (m + 1) → Fin P)) → massAdmissibleOn univ m (W p), ∀ p,
        ENNReal.ofReal (T (i p)) ≤ ENNReal.ofReal (T (k p)) ∧
          ENNReal.ofReal (T (j p)) ≤ ENNReal.ofReal (T (k p)) := by
    intro i j
    refine ⟨fun p => if ENNReal.ofReal (T (i p)) ≤ ENNReal.ofReal (T (j p)) then j p else i p,
      fun p => ?_⟩
    by_cases h : ENNReal.ofReal (T (i p)) ≤ ENNReal.ofReal (T (j p))
    · simp only [ite_eq_left h]
      exact ⟨h, le_rfl⟩
    · simp only [ite_eq_right h]
      exact ⟨le_rfl, (not_le.1 h).le⟩
  have hsum : ∑ p ∈ s, T.massOn (W p) ≤ T.mass := by
    rw [Finset.sum_congr rfl fun p _ => hsupW p, ENNReal.finsetSum_iSup hdir]
    exact iSup_le hfam
  -- Step 3: `V_p = M_{W_p}(∂Q)`
  have hne : ∀ p, T.massOn (W p) ≠ ∞ := fun p =>
    ne_top_of_le_ne_top hmass (T.massOn_mono (subset_univ (W p)))
  refine ⟨fun p => (T.massOn (W p)).toReal, fun p _ => ENNReal.toReal_nonneg, ?_, ?_⟩
  · rw [ENNReal.ofReal_sum_of_nonneg fun p _ => ENNReal.toReal_nonneg]
    calc ∑ p ∈ s, ENNReal.ofReal (T.massOn (W p)).toReal = ∑ p ∈ s, T.massOn (W p) :=
          Finset.sum_congr rfl fun p _ => ENNReal.ofReal_toReal (hne p)
      _ ≤ T.mass := hsum
  intro p hp g hg hgc hgC hg1
  -- Step 4: `Φ_p(spt g)` is compact and has positive distance from the other faces
  have hGc : IsCompact (Φ p '' tsupport g) := IsCompact.image hgc (hFG p hp).2.1
  have hBc : IsClosed (⋃ q ∈ s.erase p, F q) :=
    isClosed_biUnion_finset fun q hq => (hFG q (Finset.mem_of_mem_erase hq)).2.2.1
  have hGB : Disjoint (Φ p '' tsupport g) (⋃ q ∈ s.erase p, F q) := by
    refine Set.disjoint_left.2 ?_
    rintro _ ⟨y, hy, rfl⟩ hyB
    obtain ⟨q, hq, hyq⟩ := Set.mem_iUnion₂.1 hyB
    exact (hFG p hp).2.2.2 q (hs q (Finset.mem_of_mem_erase hq)) (Finset.ne_of_mem_erase hq) y
      (hgC hy) hyq
  obtain ⟨r, hr0, hr⟩ := exists_pos_forall_lt_edist hGc hBc hGB
  set δ : ℝ := (r : ℝ) / 3 with hδ
  have hδ0 : 0 < δ := div_pos (NNReal.coe_pos.2 hr0) three_pos
  -- Step 5: the divergence form of `g`
  obtain ⟨ω, hω1, hωspt, hωd⟩ :=
    Submission.dor_lmb_fcd_fr_divergence_form P m p g δ (hs p hp) hg hgc hg1 hδ0
  -- Step 6: `spt ω ⊆ W_p`, so `ω` is admissible for `M_{W_p}(∂Q)`
  have hωW : tsupport (ω : DifferentialForm (Euclid P) m) ⊆ W p := by
    intro x hx q hq hqp
    obtain ⟨y, hy, hxy⟩ := hωspt x hx
    have hyC : ∀ i, 0 < y i ∧ y i < 1 := hgC hy
    have hxy' : dist (Φ p y) x ≤ δ := by
      rw [dist_comm]
      exact hxy
    have h1 : infDist x (F p) ≤ δ :=
      (infDist_le_dist_of_mem ((hFG p hp).1 y fun i => ⟨(hyC i).1.le, (hyC i).2.le⟩)).trans
        (by rw [dist_comm]; exact hxy')
    have h2 : 2 * δ ≤ infDist x (F q) := by
      refine (le_infDist (hFne q hq)).2 fun b hb => ?_
      have hb' : (r : ℝ≥0∞) < edist (Φ p y) b :=
        hr _ ⟨y, hy, rfl⟩ b (Set.mem_iUnion₂.2 ⟨q, Finset.mem_erase.2 ⟨hqp, hq⟩, hb⟩)
      have hrb : (r : ℝ) < dist (Φ p y) b := by
        rw [dist_edist]
        exact ENNReal.toReal_strict_mono (edist_ne_top _ _) hb'
      have htri := dist_triangle (Φ p y) x b
      linarith
    linarith
  have hωadm : ω ∈ massAdmissibleOn univ m (W p) := ⟨hωW, hω1⟩
  -- Step 7: `∂Q(ω) = Q(dω) = ∫_{Q₁} u_p div g`, `dω` vanishing on the other faces
  have hval : T ω = ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1},
      u p y * LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g y) := by
    rw [hT, GeometricCurrentOn.boundary_apply, hQ, Finset.sum_eq_single p]
    · congr 1
      funext y
      exact congrArg (fun t => u p y * t) (hωd y)
    · intro q hq hqp
      refine setIntegral_eq_zero_of_forall_eq_zero fun y hy => ?_
      have hyF : Φ q y ∈ F q := (hFG q hq).1 y fun i => ⟨(hy i).1.le, (hy i).2.le⟩
      have hnot : Φ q y ∉ tsupport (exteriorDerivative (ω : DifferentialForm (Euclid P) m)) := by
        intro hmem
        have hlt := hωW (tsupport_exteriorDerivative_subset _ hmem) q hq hqp
        rw [infDist_zero_of_mem hyF] at hlt
        exact absurd hlt (not_lt.2 infDist_nonneg)
      have h0 : exteriorDerivative (ω : DifferentialForm (Euclid P) m) (Φ q y)
          (fun k => EuclideanSpace.single (q.2 k) (1 : ℝ)) = 0 := by
        rw [image_eq_zero_of_notMem_tsupport hnot]
        rfl
      exact (congrArg (fun t => u q y * t) h0).trans (mul_zero _)
    · intro h
      exact absurd hp h
  -- Step 8: `∫_{Q₁} u_p div g = ∂Q(ω) ≤ M_{W_p}(∂Q)`
  have hle : ENNReal.ofReal (T ω) ≤ T.massOn (W p) := T.le_massOn hωadm
  rw [hval] at hle
  exact (ENNReal.ofReal_le_iff_le_toReal (hne p)).1 hle
/-- **Currents given by `L¹` densities on unit faces** (Simon Ch. 6, proof of the deformation
theorem 5.1, (29), and the mass estimate (34) via 2.35).  For pairs `p = (z, ι)` with `ι` strictly
increasing, `Φ_p(y) = z + Σⱼ yⱼ e_{ι(j)}` and `e_p = (e_{ι(0)}, …, e_{ι(m)})`:
(I) `y ↦ w_p(y) ω(Φ_p(y))(e_p)` is integrable on `Q₁ = (0, 1)^{m+1}`, since `ω` is continuous with
compact support and `|ω(x)(e_p)| ≤ ‖ω(x)‖`; (II) `ω ↦ Σ_p ∫_{Q₁} w_p ω(Φ_p)(e_p)` is linear and
bounded by `(Σ_p ∫_{Q₁} |w_p|) · sup ‖ω‖`, hence a current; (III) `|ω(x)(e_p)|` is bounded by the
Euclidean coefficient norm of `ω(x)`, so every such current has `M ≤ Σ_p ∫_{Q₁} |w_p|`. -/
theorem Submission.dor_lmb_fcd_fr_chain_current : ∀ (P m : ℕ) (s : Finset ((Fin P → ℤ) × (Fin (m + 1) → Fin P))) (w : (Fin P → ℤ) × (Fin (m + 1) → Fin P) → Euclid (m + 1) → ℝ), (∀ p ∈ s, StrictMono p.2) → (∀ p ∈ s, IntegrableOn (w p) {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), ∀ p ∈ s, IntegrableOn (fun y => w p y * (ω : DifferentialForm (Euclid P) (m + 1)) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}) ∧ (∃ D : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), D ω = ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, w p y * (ω : DifferentialForm (Euclid P) (m + 1)) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) ∧ ∀ D : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), D ω = ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, w p y * (ω : DifferentialForm (Euclid P) (m + 1)) (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ)) (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))) → D.mass ≤ ENNReal.ofReal (∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |w p y|) := by
  intro P m s w hmono hw
  -- Step 1: the frame `e_ι = (e_{ι 0}, …, e_{ι m})` consists of unit vectors, so `|α(e_ι)| ≤ ‖α‖`
  have hframe : ∀ (α : Covector (Euclid P) (m + 1)) (ι : Fin (m + 1) → Fin P),
      |α (fun k => EuclideanSpace.single (ι k) (1 : ℝ))| ≤ ‖α‖ := by
    intro α ι
    simpa using α.le_opNorm (fun k => EuclideanSpace.single (ι k) (1 : ℝ))
  -- for strictly increasing `ι`, `α(e_ι)` is one of the coefficients in the Euclidean norm of `α`
  have hcoeff : ∀ (α : Covector (Euclid P) (m + 1)) (ι : Fin (m + 1) → Fin P), StrictMono ι →
      |α (fun k => EuclideanSpace.single (ι k) (1 : ℝ))| ≤ covectorEuclideanNorm α := by
    intro α ι hι
    refine Real.abs_le_sqrt ?_
    have hle := Finset.single_le_sum (s := Finset.univ)
      (f := fun I : Fin (m + 1) → Fin P => if StrictMono I then
        (α (fun i => EuclideanSpace.basisFun (Fin P) ℝ (I i))) ^ 2 else 0)
      (fun I _ => by split_ifs <;> positivity) (Finset.mem_univ ι)
    simpa [hι, EuclideanSpace.basisFun_apply] using hle
  -- Step 2: `y ↦ ω(Φ_p(y))(e_p)` is continuous, and test forms are bounded
  have hcont : ∀ (ω : TestFormOn (univ : Set (Euclid P)) (m + 1))
      (p : (Fin P → ℤ) × (Fin (m + 1) → Fin P)),
      Continuous fun y : Euclid (m + 1) => (ω : DifferentialForm (Euclid P) (m + 1))
        (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ))
        (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)) := by
    intro ω p
    have hω : Continuous (ω : DifferentialForm (Euclid P) (m + 1)) := ω.property.1.1.continuous
    have hΦ : Continuous fun y : Euclid (m + 1) =>
        WithLp.toLp 2 (fun i => (p.1 i : ℝ)) +
          ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ) := by
      fun_prop
    exact (hω.comp hΦ).eval_const _
  have hbdd : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1),
      ∃ C, ∀ x, ‖(ω : DifferentialForm (Euclid P) (m + 1)) x‖ ≤ C := fun ω =>
    ω.property.1.1.continuous.bounded_above_of_compact_support ω.property.1.2
  -- (I): an integrable density times a bounded continuous function is integrable
  have hint : ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), ∀ p ∈ s,
      IntegrableOn (fun y => w p y * (ω : DifferentialForm (Euclid P) (m + 1))
        (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ))
        (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ)))
        {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1} := by
    intro ω p hp
    obtain ⟨C, hC⟩ := hbdd ω
    exact (hw p hp).mul_bdd (hcont ω p).aestronglyMeasurable (Filter.Eventually.of_forall fun y =>
      (Real.norm_eq_abs _).trans_le ((hframe _ _).trans (hC _)))
  -- Step 3: `|Σ_p ∫ w_p ω(Φ_p)(e_p)| ≤ c · Σ_p ∫ |w_p|` whenever `|ω(Φ_p)(e_p)| ≤ c`
  have hbound : ∀ (ω : TestFormOn (univ : Set (Euclid P)) (m + 1)) (c : ℝ),
      (∀ p ∈ s, ∀ y : Euclid (m + 1), |(ω : DifferentialForm (Euclid P) (m + 1))
        (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ))
        (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))| ≤ c) →
      |∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, w p y *
        (ω : DifferentialForm (Euclid P) (m + 1))
        (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ))
        (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))| ≤
      c * ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1}, |w p y| := by
    intro ω c hc
    rw [Finset.mul_sum]
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun p hp => ?_)
    rw [← integral_const_mul, ← Real.norm_eq_abs]
    refine norm_integral_le_of_norm_le ((hw p hp).abs.const_mul c)
      (Filter.Eventually.of_forall fun y => ?_)
    rw [Real.norm_eq_abs, abs_mul, mul_comm c]
    exact mul_le_mul_of_nonneg_left (hc p hp y) (abs_nonneg _)
  -- (II): the formula is a linear functional on test forms ...
  let L : TestFormOn (univ : Set (Euclid P)) (m + 1) →ₗ[ℝ] ℝ :=
    { toFun := fun ω => ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1},
        w p y * (ω : DifferentialForm (Euclid P) (m + 1))
          (WithLp.toLp 2 (fun i => (p.1 i : ℝ)) + ∑ j, y j • EuclideanSpace.single (p.2 j) (1 : ℝ))
          (fun k => EuclideanSpace.single (p.2 k) (1 : ℝ))
      map_add' := fun ω η => by
        have h : ∀ x v, ((ω + η : TestFormOn (univ : Set (Euclid P)) (m + 1)) :
            DifferentialForm (Euclid P) (m + 1)) x v =
            (ω : DifferentialForm (Euclid P) (m + 1)) x v +
              (η : DifferentialForm (Euclid P) (m + 1)) x v := fun x v => rfl
        simp only [h, mul_add]
        rw [← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl fun p hp => integral_add (hint ω p hp) (hint η p hp)
      map_smul' := fun c ω => by
        have h : ∀ x v, ((c • ω : TestFormOn (univ : Set (Euclid P)) (m + 1)) :
            DifferentialForm (Euclid P) (m + 1)) x v =
            c * (ω : DifferentialForm (Euclid P) (m + 1)) x v := fun x v => rfl
        simp only [h, RingHom.id_apply, smul_eq_mul, Finset.mul_sum]
        refine Finset.sum_congr rfl fun p _ => ?_
        rw [← integral_const_mul]
        congr 1
        funext y
        ring }
  -- ... and it is sequentially continuous: `ωⱼ → 0` forces `sup ‖ωⱼ‖ → 0`
  have hLcont : ∀ ωs : ℕ → TestFormOn (univ : Set (Euclid P)) (m + 1),
      TestFormOnConverges ωs 0 → Tendsto (fun j => L (ωs j)) atTop (𝓝 0) := by
    intro ωs hωs
    obtain ⟨K, -, -, hsupp, -, hunif⟩ := hωs
    have h0 := Metric.tendstoUniformlyOn_iff.1 (hunif 0)
    obtain ⟨S, hS⟩ : ∃ S, S = ∑ p ∈ s, ∫ y in {y : Euclid (m + 1) | ∀ i, 0 < y i ∧ y i < 1},
        |w p y| := ⟨_, rfl⟩
    have hS0 : 0 ≤ S := hS ▸ Finset.sum_nonneg fun p _ => integral_nonneg fun y => abs_nonneg _
    refine Metric.tendsto_nhds.2 fun ε hε => ?_
    have hδ : 0 < ε / (S + 1) := div_pos hε (by linarith)
    filter_upwards [h0 _ hδ] with j hj
    have hsup : ∀ x, ‖(ωs j : DifferentialForm (Euclid P) (m + 1)) x‖ ≤ ε / (S + 1) := by
      intro x
      by_cases hx : x ∈ K
      · have hjx := hj x hx
        have h00 : iteratedFDeriv ℝ 0 ((0 : TestFormOn (univ : Set (Euclid P)) (m + 1)) :
            DifferentialForm (Euclid P) (m + 1)) x = 0 := by
          rw [← norm_eq_zero, norm_iteratedFDeriv_zero]
          simp
        rw [h00, dist_zero_left, norm_iteratedFDeriv_zero] at hjx
        exact hjx.le
      · rw [image_eq_zero_of_notMem_tsupport fun h => hx (hsupp j h), norm_zero]
        exact hδ.le
    have hb := hbound (ωs j) (ε / (S + 1)) fun p _ y => (hframe _ _).trans (hsup _)
    rw [← hS] at hb
    rw [Real.dist_eq, sub_zero]
    calc |L (ωs j)| ≤ ε / (S + 1) * S := hb
      _ < ε / (S + 1) * (S + 1) := mul_lt_mul_of_pos_left (lt_add_one S) hδ
      _ = ε := div_mul_cancel₀ ε (by linarith : (0 : ℝ) < S + 1).ne'
  refine ⟨hint, ⟨⟨L, hLcont⟩, fun ω => rfl⟩, fun D hD => ?_⟩
  -- (III): admissible forms have `|ω(Φ_p)(e_p)| ≤ 1`, so every admissible value is `≤ Σ_p ∫ |w_p|`
  unfold GeometricCurrentOn.mass GeometricCurrentOn.massOn
  refine sSup_le ?_
  rintro _ ⟨ω, hω, rfl⟩
  dsimp only
  rw [hD ω]
  refine ENNReal.ofReal_le_ofReal ((le_abs_self _).trans ?_)
  have hb := hbound ω 1 fun p hp y => (hcoeff _ _ (hmono p hp)).trans (hω.2 _)
  rwa [one_mul] at hb
/-- **A set that coincides near `x` with the plane `x + V` has approximate tangent space `V` at
`x`** (Simon Ch. 3, Definition 1.4).  A test function `f ∈ C_c(ℝᴾ)` vanishes off a ball `B_R(0)`,
so `∫_S f dHⁿ = ∫_{B_R(0) ∩ S} f dHⁿ` for every `S`.  For `0 < λ < r/R` the blow-up
`η_{x,λ}(N) = λ⁻¹(N − x)` coincides with `V` inside `B_R(0)`, hence the blow-up integrals equal
`∫_V f dHⁿ` for all small `λ > 0` and converge to it. -/
theorem Submission.dor_lmb_fcd_fr_local_plane_tangent : ∀ (P n : ℕ) (N : Set (Euclid P)) (x : Euclid P) (V : Submodule ℝ (Euclid P)) (r : ℝ), Module.finrank ℝ V = n → 0 < r → (∀ y ∈ Metric.ball x r, y ∈ N ↔ y - x ∈ V) → HasApproximateTangentSpaceAt n N x V := by
  intro P n N x V r hV hr hN
  refine ⟨hV, fun f => ?_⟩
  -- Step 1: `f` vanishes off a ball `B_R(0)`
  obtain ⟨R, hR, hfR⟩ : ∃ R : ℝ, 0 < R ∧ ∀ w, w ∉ ball (0 : Euclid P) R → f w = 0 := by
    obtain ⟨C, hC⟩ := isBounded_iff_forall_norm_le.1 f.hasCompactSupport.isCompact.isBounded
    refine ⟨max C 0 + 1, add_pos_of_nonneg_of_pos (le_max_right C 0) one_pos,
      fun w hw => image_eq_zero_of_notMem_tsupport fun hwt => hw ?_⟩
    rw [mem_ball_zero_iff]
    exact (hC w hwt).trans_lt ((le_max_left C 0).trans_lt (lt_add_one _))
  -- Step 2: the integral of `f` over any `S` only sees `B_R(0) ∩ S`
  have hB : MeasurableSet (ball (0 : Euclid P) R) := measurableSet_ball
  have hloc : ∀ S : Set (Euclid P),
      ∫ y in S, f y ∂μHE[n] = ∫ y in ball (0 : Euclid P) R ∩ S, f y ∂μHE[n] := by
    intro S
    rw [← Measure.restrict_restrict hB, setIntegral_eq_integral_of_forall_compl_eq_zero hfR]
  -- Step 3: for `0 < λ < r/R` the blow-up of `N` coincides with `V` inside `B_R(0)`
  have hblow : ∀ lam ∈ Ioo 0 (r / R), ball (0 : Euclid P) R ∩
      Poincare.SimonGMT.Chapter03.blowUpMap x lam '' N =
        ball (0 : Euclid P) R ∩ (V : Set (Euclid P)) := by
    rintro lam ⟨hlam0, hlamR⟩
    have hsmall : ∀ w : Euclid P, ‖w‖ < R → ‖lam • w‖ < r := fun w hw => by
      rw [norm_smul, Real.norm_of_nonneg hlam0.le]
      exact (mul_lt_mul_of_pos_left hw hlam0).trans ((lt_div_iff₀ hR).1 hlamR)
    ext w
    constructor
    · rintro ⟨hw, y, hy, rfl⟩
      have hyx : y - x = lam • Poincare.SimonGMT.Chapter03.blowUpMap x lam y := by
        rw [Poincare.SimonGMT.Chapter03.blowUpMap, smul_smul, mul_inv_cancel₀ hlam0.ne',
          one_smul]
      have hy' : y ∈ ball x r := by
        rw [Metric.mem_ball, dist_eq_norm, hyx]
        exact hsmall _ (mem_ball_zero_iff.1 hw)
      exact ⟨hw, V.smul_mem lam⁻¹ ((hN y hy').1 hy)⟩
    · rintro ⟨hw, hwV⟩
      have hy : x + lam • w ∈ ball x r := by
        rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left]
        exact hsmall w (mem_ball_zero_iff.1 hw)
      refine ⟨hw, x + lam • w, (hN _ hy).2 ?_, ?_⟩
      · rw [add_sub_cancel_left]
        exact V.smul_mem lam hwV
      · rw [Poincare.SimonGMT.Chapter03.blowUpMap, add_sub_cancel_left, smul_smul,
          inv_mul_cancel₀ hlam0.ne', one_smul]
  -- Step 4: the blow-up integrals are eventually equal to `∫_V f dHⁿ`
  refine tendsto_const_nhds.congr' ?_
  filter_upwards [Ioo_mem_nhdsGT (div_pos hr hR)] with lam hlam
  rw [hloc (V : Set (Euclid P)), hloc (Poincare.SimonGMT.Chapter03.blowUpMap x lam '' N),
    hblow lam hlam]

/-- **Bounds for one piece of the cone** (Simon 6.2.30, `0 ⨯ T = h_#([[(0, 1)]] × T)` with
`h(t, x) = t x`, and the estimate of 6.2.27): let `B = {z ∈ ℝ^{n+1} : z₀ ∈ (0, 1), tail z ∈ A}`
and suppose `(DH(z)ê_b)_b = Fin.cons (G u) (z₀ DG(u)e_a)_a` for `z ∈ B`, `u = tail z`.  Then
`w ∘ tail` is integrable on `B` (Tonelli on `B`, `cmcdt_lpi_cyl_fubini`, and `|(0, 1)| = 1`);
`c′(z) = z₀ⁿ ‖G u‖ c(u)` satisfies `|α(DH(z)ê)| ≤ c′(z) |α|_E`, since
`α(Fin.cons v (s • x)) = sⁿ (ι_v α)(x)` by multilinearity and `|ι_v α|_E ≤ ‖v‖ |α|_E`
(`cmcdt_lp_covector_curryLeft_norm_le`); and Tonelli with `z₀ⁿ ≤ 1` and `‖G‖ ≤ ρ` on `A` gives
`∫⁻_B |w ∘ tail| c′ ≤ ρ ∫⁻_A |w| c`. -/
theorem Submission.dimred_cs_sos_cfs_cp_piece_bounds : ∀ (P n : ℕ) (ρ : ℝ) (G : Euclid n → Euclid P) (H : Euclid (n + 1) → Euclid P) (A : Set (Euclid n)) (w : Euclid n → ℤ) (c : Euclid n → ℝ), Measurable G → MeasurableSet A → Measurable w → Measurable c → IntegrableOn (fun u => (w u : ℝ)) A → (∀ u ∈ A, ‖G u‖ ≤ ρ) → (∀ u ∈ A, 0 ≤ c u ∧ ∀ α : Covector (Euclid P) n, |α (fun a => fderiv ℝ G u (EuclideanSpace.single a 1))| ≤ c u * covectorEuclideanNorm α) → (∀ z : Euclid (n + 1), WithLp.ofLp z 0 ∈ Ioo (0 : ℝ) 1 → (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)) : Euclid n) ∈ A → (fun b => fderiv ℝ H z (EuclideanSpace.single b 1)) = Fin.cons (G (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)))) (fun a => WithLp.ofLp z 0 • fderiv ℝ G (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))) (EuclideanSpace.single a 1))) → IntegrableOn (fun z : Euclid (n + 1) => (w (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))) : ℝ)) {z : Euclid (n + 1) | WithLp.ofLp z 0 ∈ Ioo (0 : ℝ) 1 ∧ (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)) : Euclid n) ∈ A} ∧ (∀ z : Euclid (n + 1), WithLp.ofLp z 0 ∈ Ioo (0 : ℝ) 1 → (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)) : Euclid n) ∈ A → 0 ≤ WithLp.ofLp z 0 ^ n * ‖G (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)))‖ * c (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))) ∧ ∀ α : Covector (Euclid P) (n + 1), |α (fun b => fderiv ℝ H z (EuclideanSpace.single b 1))| ≤ WithLp.ofLp z 0 ^ n * ‖G (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)))‖ * c (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))) * covectorEuclideanNorm α) ∧ ∫⁻ z in {z : Euclid (n + 1) | WithLp.ofLp z 0 ∈ Ioo (0 : ℝ) 1 ∧ (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)) : Euclid n) ∈ A}, ENNReal.ofReal (|(w (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))) : ℝ)| * (WithLp.ofLp z 0 ^ n * ‖G (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)))‖ * c (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))))) ≤ ENNReal.ofReal ρ * ∫⁻ u in A, ENNReal.ofReal (|(w u : ℝ)| * c u) := by
  intro P n ρ G H A w c hGm hA hw hc hwi hGρ hcb hDH
  obtain ⟨-, hlin, -⟩ := Submission.cmcdt_lpi_cyl_fubini n A hA
  have htail : Measurable (fun z : Euclid (n + 1) =>
      (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)) : Euclid n)) := by
    fun_prop
  have hz0 : Measurable (fun z : Euclid (n + 1) => WithLp.ofLp z 0) := by
    fun_prop
  -- `tail (t, u) = u`
  have hιtail : ∀ (t : ℝ) (u : Euclid n),
      (WithLp.toLp 2 (Fin.tail (WithLp.ofLp
        (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp u)) : Euclid (n + 1)))) : Euclid n) = u := by
    intro t u; simp
  have hwR : Measurable (fun u => (w u : ℝ)) := (measurable_of_countable _).comp hw
  refine ⟨?_, ?_, ?_⟩
  · -- integrability of `w ∘ tail` on `B`: `∫⁻_B |w ∘ tail| = ∫⁻_A |w| · |(0, 1)| < ∞`
    refine ⟨(hwR.comp htail).aestronglyMeasurable, ?_⟩
    rw [HasFiniteIntegral, hlin (fun z => ‖(w (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))) : ℝ)‖ₑ)
      (hwR.comp htail).enorm]
    simp only [hιtail]
    simp only [lintegral_const, Measure.restrict_apply MeasurableSet.univ, univ_inter,
      Real.volume_Ioo, sub_zero, ENNReal.ofReal_one, mul_one]
    exact hwi.2
  · -- the covector bound, with `s = z₀` and `u = tail z`
    intro z hz hzA
    set s := WithLp.ofLp z 0
    set u := (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)) : Euclid n)
    have hs : 0 < s := hz.1
    obtain ⟨hc0, hcα⟩ := hcb u hzA
    refine ⟨by positivity, fun α => ?_⟩
    rw [hDH z hz hzA]
    -- `α(Fin.cons v (s • x)) = sⁿ (ι_v α)(x)`
    have key : α (Fin.cons (G u) (fun a => s • fderiv ℝ G u (EuclideanSpace.single a 1))) =
        s ^ n * (α.curryLeft (G u)) (fun a => fderiv ℝ G u (EuclideanSpace.single a 1)) := by
      have h1 : α (Fin.cons (G u) (fun a => s • fderiv ℝ G u (EuclideanSpace.single a 1))) =
          (α.curryLeft (G u)) (fun a => s • fderiv ℝ G u (EuclideanSpace.single a 1)) :=
        (α.curryLeft_apply_apply (G u) _).symm
      rw [h1, ContinuousAlternatingMap.map_smul_univ (α.curryLeft (G u)) (fun _ => s)]
      simp
    rw [key, abs_mul, abs_of_nonneg (by positivity)]
    calc s ^ n * |(α.curryLeft (G u)) (fun a => fderiv ℝ G u (EuclideanSpace.single a 1))|
        ≤ s ^ n * (c u * covectorEuclideanNorm (α.curryLeft (G u))) := by
          gcongr; exact hcα _
      _ ≤ s ^ n * (c u * (‖G u‖ * covectorEuclideanNorm α)) := by
          gcongr
          exact Submission.cmcdt_lp_covector_curryLeft_norm_le P n (G u) α
      _ = s ^ n * ‖G u‖ * c u * covectorEuclideanNorm α := by ring
  · -- the mass bound: Tonelli on `B`, then `tⁿ ≤ 1` and `‖G u‖ ≤ ρ` for `u ∈ A`
    have hfm : Measurable (fun z : Euclid (n + 1) =>
        ENNReal.ofReal (|(w (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))) : ℝ)| *
          (WithLp.ofLp z 0 ^ n * ‖G (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)))‖ *
            c (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)))))) := by
      refine ENNReal.measurable_ofReal.comp ?_
      exact (continuous_abs.measurable.comp (hwR.comp htail)).mul
        (((hz0.pow_const n).mul (hGm.comp htail).norm).mul (hc.comp htail))
    rw [hlin _ hfm]
    simp only [hιtail]
    calc ∫⁻ u in A, ∫⁻ t in Ioo (0 : ℝ) 1,
          ENNReal.ofReal (|(w u : ℝ)| * (t ^ n * ‖G u‖ * c u))
        ≤ ∫⁻ u in A, ENNReal.ofReal ρ * ENNReal.ofReal (|(w u : ℝ)| * c u) := by
          refine setLIntegral_mono (by fun_prop) fun u hu => ?_
          obtain ⟨hc0, -⟩ := hcb u hu
          have hρ0 : 0 ≤ ρ := (norm_nonneg _).trans (hGρ u hu)
          calc ∫⁻ t in Ioo (0 : ℝ) 1, ENNReal.ofReal (|(w u : ℝ)| * (t ^ n * ‖G u‖ * c u))
              ≤ ∫⁻ t in Ioo (0 : ℝ) 1, ENNReal.ofReal ρ * ENNReal.ofReal (|(w u : ℝ)| * c u) := by
                refine setLIntegral_mono (by fun_prop) fun t ht => ?_
                rw [← ENNReal.ofReal_mul hρ0]
                refine ENNReal.ofReal_le_ofReal ?_
                have ht1 : t ^ n ≤ 1 := pow_le_one₀ ht.1.le ht.2.le
                have ht0 : 0 ≤ t ^ n := pow_nonneg ht.1.le n
                calc |(w u : ℝ)| * (t ^ n * ‖G u‖ * c u)
                    ≤ |(w u : ℝ)| * (1 * ρ * c u) := by
                      gcongr
                      · exact hGρ u hu
                  _ = ρ * (|(w u : ℝ)| * c u) := by ring
            _ = ENNReal.ofReal ρ * ENNReal.ofReal (|(w u : ℝ)| * c u) := by
                rw [setLIntegral_const, Real.volume_Ioo, sub_zero, ENNReal.ofReal_one, mul_one]
      _ = ENNReal.ofReal ρ * ∫⁻ u in A, ENNReal.ofReal (|(w u : ℝ)| * c u) := by
          rw [lintegral_const_mul]
          fun_prop
/-- **Cone piece change of variables** (Simon Ch. 6, 2.27 and 2.30, for one piece).  Let
`B = {z ∈ ℝ^{n+1} : z₀ ∈ (0, 1), tail z ∈ A}`, and suppose that on `B` the map `H` is the cone
map `H(z) = z₀ G(tail z)` with `DH(z)ê = (G(tail z), z₀ DG(tail z)e)`, and that on `G(A)` the
form `η` is the radial homotopy `η(v) = ∫₀¹ tⁿ ι_v ω(tv) dt`.  The weight `w ∘ tail` is
integrable on `B` by Tonelli on the cylinder (`|(0, 1)| = 1`), so the integrand on `B` is
integrable (Lipschitz pull-back) and Fubini reduces the identity to a fixed `u ∈ A`.  There
multilinearity gives `ω(tv)(v, t x) = tⁿ ω(tv)(v, x)` for `v = G(u)`, `x = DG(u)e`, and
evaluation at `x` commutes with the covector-valued interval integral defining `η(v)`. -/
theorem Submission.dimred_cs_sos_cfs_cp_piece_action : ∀ (P n : ℕ) (L : NNReal) (G : Euclid n → Euclid P) (H : Euclid (n + 1) → Euclid P) (A : Set (Euclid n)) (w : Euclid n → ℤ) (ω : TestFormOn (univ : Set (Euclid P)) (n + 1)) (η : DifferentialForm (Euclid P) n), LipschitzWith L H → MeasurableSet A → Measurable w → IntegrableOn (fun u => (w u : ℝ)) A → (∀ z : Euclid (n + 1), WithLp.ofLp z 0 ∈ Ioo (0 : ℝ) 1 → (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)) : Euclid n) ∈ A → H z = WithLp.ofLp z 0 • G (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))) ∧ (fun b => fderiv ℝ H z (EuclideanSpace.single b 1)) = Fin.cons (G (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)))) (fun a => WithLp.ofLp z 0 • fderiv ℝ G (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))) (EuclideanSpace.single a 1))) → (∀ u ∈ A, η (G u) = ∫ t in (0 : ℝ)..1, t ^ n • ((ω : DifferentialForm (Euclid P) (n + 1)) (t • G u)).curryLeft (G u)) → ∫ u in A, (w u : ℝ) * η (G u) (fun a => fderiv ℝ G u (EuclideanSpace.single a 1)) = ∫ z in {z : Euclid (n + 1) | WithLp.ofLp z 0 ∈ Ioo (0 : ℝ) 1 ∧ (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)) : Euclid n) ∈ A}, (w (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))) : ℝ) * (ω : DifferentialForm (Euclid P) (n + 1)) (H z) (fun b => fderiv ℝ H z (EuclideanSpace.single b 1)) := by
  intro P n L G H A w ω η hHL hA hw hwi hHB hη
  obtain ⟨-, hlin, hfub⟩ := Submission.cmcdt_lpi_cyl_fubini n A hA
  have htail : Measurable (fun z : Euclid (n + 1) =>
      (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)) : Euclid n)) := by
    fun_prop
  have hιtail : ∀ (t : ℝ) (u : Euclid n),
      (WithLp.toLp 2 (Fin.tail (WithLp.ofLp
        (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp u)) : Euclid (n + 1)))) : Euclid n) = u := by
    intro t u; simp
  have hι0 : ∀ (t : ℝ) (u : Euclid n),
      WithLp.ofLp (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp u)) : Euclid (n + 1)) 0 = t := by
    intro t u; simp
  have hwR : Measurable (fun u => (w u : ℝ)) := (measurable_of_countable _).comp hw
  -- `w ∘ tail` is integrable on `B`: Tonelli on the cylinder and `|(0, 1)| = 1`
  have hint : IntegrableOn
      (fun z : Euclid (n + 1) => (w (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))) : ℝ))
      {z : Euclid (n + 1) | WithLp.ofLp z 0 ∈ Ioo (0 : ℝ) 1 ∧
        (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)) : Euclid n) ∈ A} := by
    refine ⟨(hwR.comp htail).aestronglyMeasurable, ?_⟩
    rw [HasFiniteIntegral,
      hlin (fun z => ‖(w (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))) : ℝ)‖ₑ) (hwR.comp htail).enorm]
    simp only [hιtail]
    simp only [lintegral_const, Measure.restrict_apply MeasurableSet.univ, univ_inter,
      Real.volume_Ioo, sub_zero, ENNReal.ofReal_one, mul_one]
    exact hwi.2
  -- so the integrand on `B` is integrable (Lipschitz pull-back), and Fubini applies
  have hF := Submission.cmcdt_lpi_cyl_pullback_integrable P (n + 1) L H _ _ ω hHL hint
  rw [hfub _ hF]
  refine setIntegral_congr_fun hA fun u hu => ?_
  have hωc : Continuous (ω : DifferentialForm (Euclid P) (n + 1)) := ω.2.1.1.continuous
  -- `α(v, s x) = sⁿ α(v, x)` for an `(n + 1)`-covector `α`
  have hsc : ∀ (α : Covector (Euclid P) (n + 1)) (v : Euclid P) (x : Fin n → Euclid P) (s : ℝ),
      α (Fin.cons v (fun a => s • x a)) = s ^ n * α (Fin.cons v x) := by
    intro α v x s
    have h1 : α (Fin.cons v (fun a => s • x a)) = (α.curryLeft v) (fun a => s • x a) := rfl
    have h2 : α (Fin.cons v x) = (α.curryLeft v) x := rfl
    rw [h1, h2, ContinuousAlternatingMap.map_smul_univ (α.curryLeft v) (fun _ => s)]
    simp
  -- the inner integrand at `z = (t, u)`, `t ∈ (0, 1)`
  have hinner : ∀ t ∈ Ioo (0 : ℝ) 1,
      (w (WithLp.toLp 2 (Fin.tail (WithLp.ofLp
          (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp u)) : Euclid (n + 1))))) : ℝ) *
        (ω : DifferentialForm (Euclid P) (n + 1)) (H (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp u))))
          (fun b => fderiv ℝ H (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp u)))
            (EuclideanSpace.single b 1)) =
      (w u : ℝ) * (t ^ n * (ω : DifferentialForm (Euclid P) (n + 1)) (t • G u)
        (Fin.cons (G u) (fun a => fderiv ℝ G u (EuclideanSpace.single a 1)))) := by
    intro t ht
    have hz : WithLp.ofLp (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp u)) : Euclid (n + 1)) 0 ∈
        Ioo (0 : ℝ) 1 := by rw [hι0]; exact ht
    have hzA : (WithLp.toLp 2 (Fin.tail (WithLp.ofLp
        (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp u)) : Euclid (n + 1)))) : Euclid n) ∈ A := by
      rw [hιtail]; exact hu
    obtain ⟨h1, h2⟩ := hHB _ hz hzA
    rw [h1, h2]
    simp only [hιtail, Fin.cons_zero]
    rw [hsc]
  rw [setIntegral_congr_fun measurableSet_Ioo hinner, integral_const_mul]
  congr 1
  -- evaluation at `DG(u)e` commutes with the covector-valued integral defining `η(G u)`
  rw [hη u hu]
  have hcont : Continuous (fun t : ℝ =>
      t ^ n • ((ω : DifferentialForm (Euclid P) (n + 1)) (t • G u)).curryLeft (G u)) := by
    have : Continuous (fun t : ℝ => (ω : DifferentialForm (Euclid P) (n + 1)) (t • G u)) :=
      hωc.comp (continuous_id.smul continuous_const)
    exact (continuous_pow n).smul
      ((ContinuousAlternatingMap.curryLeftLI (𝕜 := ℝ) (E := Euclid P) (F := ℝ)
        (n := n)).continuous.comp this |>.clm_apply continuous_const)
  have hcomm := ContinuousLinearMap.intervalIntegral_comp_comm
    (ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ
      (fun a => fderiv ℝ G u (EuclideanSpace.single a 1)))
    (hcont.intervalIntegrable (μ := volume) 0 1)
  rw [← ContinuousAlternatingMap.apply_apply, ← hcomm,
    intervalIntegral.integral_of_le zero_le_one, integral_Ioc_eq_integral_Ioo]
  refine setIntegral_congr_fun measurableSet_Ioo fun t _ => ?_
  simp only [ContinuousAlternatingMap.apply_apply, ContinuousAlternatingMap.smul_apply,
    smul_eq_mul]
  rfl

/-- **Cone parametrization** (Simon 6.2.30, `0 ⨯ X = h_#([[(0, 1)]] × X)` with `h(t, x) = tx`).
If `X(γ) = Σᵢ ∫_{Aᵢ} wᵢ γ(Gᵢ u)(DGᵢ(u)e) du` for Lipschitz `Gᵢ` with `Gᵢ(Aᵢ) ⊆ spt X` compact,
and `Y(ω) = X(η)` with `η = Kω`, `Kω(x) = ∫₀¹ t^{q+1} ι_x ω(tx) dt`, on `spt X`, then `Y` is
parametrized by the cone maps: `Hᵢ(s, u) = s Gᵢ(u)` on `Bᵢ = {w₀ ∈ (0, 1), tail w ∈ Aᵢ}`,
`hᵢ(w) = wᵢ(tail w)` and `c′ᵢ(w) = w₀^{q+1} ‖Gᵢ(tail w)‖ cᵢ(tail w)`.  Take `ρ` with
`spt X ⊆ B_ρ(0)`, so `‖Gᵢ‖ < ρ` on `Aᵢ`.  `cone_map` gives the Lipschitz `Hᵢ` with this value and
derivative on `Bᵢ`; `piece_bounds` gives the integrability of `hᵢ`, the `c′ᵢ` bound and
`∫⁻_{Bᵢ} |hᵢ| c′ᵢ ≤ ρ ∫⁻_{Aᵢ} |wᵢ| cᵢ`, which sums to a finite bound; `piece_action` turns each
term of the series for `X(η)` into the corresponding term for `Y(ω)`. -/
theorem Submission.dimred_cs_sos_cfs_cone_param : ∀ (P q : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) (q + 1)) (Y : GeometricCurrentOn (univ : Set (Euclid P)) (q + 1 + 1)) (G : ℕ → Euclid (q + 1) → Euclid P) (A : ℕ → Set (Euclid (q + 1))) (w : ℕ → Euclid (q + 1) → ℤ) (c : ℕ → Euclid (q + 1) → ℝ), IsCompact X.support → (∀ i, ∃ L : NNReal, LipschitzWith L (G i)) → (∀ i, MeasurableSet (A i)) → (∀ i, Measurable (w i)) → (∀ i, Measurable (c i)) → (∀ i, ∀ u ∈ A i, DifferentiableAt ℝ (G i) u) → (∀ i, G i '' A i ⊆ X.support) → (∀ i, IntegrableOn (fun u => (w i u : ℝ)) (A i)) → (∀ i, ∀ u ∈ A i, 0 ≤ c i u ∧ ∀ α : Covector (Euclid P) (q + 1), |α (fun a => fderiv ℝ (G i) u (EuclideanSpace.single a 1))| ≤ c i u * covectorEuclideanNorm α) → ∑' i, ∫⁻ u in A i, ENNReal.ofReal (|(w i u : ℝ)| * c i u) ≠ ∞ → (∀ γ : TestFormOn (univ : Set (Euclid P)) (q + 1), HasSum (fun i => ∫ u in A i, (w i u : ℝ) * (γ : DifferentialForm (Euclid P) (q + 1)) (G i u) (fun a => fderiv ℝ (G i) u (EuclideanSpace.single a 1))) (X γ)) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (q + 1 + 1), ∃ η : TestFormOn (univ : Set (Euclid P)) (q + 1), (∀ x ∈ X.support, (η : DifferentialForm (Euclid P) (q + 1)) x = ∫ t in (0 : ℝ)..1, t ^ (q + 1) • ((ω : DifferentialForm (Euclid P) (q + 1 + 1)) (t • x)).curryLeft x) ∧ Y ω = X η) → ∃ (H : ℕ → Euclid (q + 1 + 1) → Euclid P) (B : ℕ → Set (Euclid (q + 1 + 1))) (h : ℕ → Euclid (q + 1 + 1) → ℤ) (c' : ℕ → Euclid (q + 1 + 1) → ℝ), (∀ i, ∃ L : NNReal, LipschitzWith L (H i)) ∧ (∀ i, MeasurableSet (B i)) ∧ (∀ i, Measurable (h i)) ∧ (∀ i, Measurable (c' i)) ∧ (∀ i, IntegrableOn (fun u => (h i u : ℝ)) (B i)) ∧ (∀ i, ∀ u ∈ B i, 0 ≤ c' i u ∧ ∀ α : Covector (Euclid P) (q + 1 + 1), |α (fun a => fderiv ℝ (H i) u (EuclideanSpace.single a 1))| ≤ c' i u * covectorEuclideanNorm α) ∧ ∑' i, ∫⁻ u in B i, ENNReal.ofReal (|(h i u : ℝ)| * c' i u) ≠ ∞ ∧ ∀ ω : TestFormOn (univ : Set (Euclid P)) (q + 1 + 1), HasSum (fun i => ∫ u in B i, (h i u : ℝ) * (ω : DifferentialForm (Euclid P) (q + 1 + 1)) (H i u) (fun a => fderiv ℝ (H i) u (EuclideanSpace.single a 1))) (Y ω) := by
  intro P q X Y G A w c hXc hGL hA hw hc hGd hGA hwi hcb hsum hXser hYK
  -- step 1: a radius `ρ` with `spt X ⊆ B_ρ(0)`, so `‖Gᵢ u‖ < ρ` on `Aᵢ`
  obtain ⟨ρ, hρ⟩ : ∃ ρ : ℝ, X.support ⊆ ball (0 : Euclid P) ρ := hXc.isBounded.subset_ball 0
  have hGρ : ∀ i, ∀ u ∈ A i, ‖G i u‖ < ρ := fun i u hu => by
    simpa [mem_ball_zero_iff] using hρ (hGA i ⟨u, hu, rfl⟩)
  -- step 2: the truncated cone maps `Hᵢ`, Lipschitz with `Hᵢ(s, u) = s Gᵢ(u)` near `Bᵢ`
  choose L hL using hGL
  choose H hHL hH using fun i =>
    Submission.dimred_cs_sos_cfs_cp_cone_map P (q + 1) (G i) (L i) ρ (hL i)
  choose K hK using hHL
  have htail : Continuous fun z : Euclid (q + 1 + 1) =>
      (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)) : Euclid (q + 1)) := by
    fun_prop
  have hz0 : Continuous fun z : Euclid (q + 1 + 1) => WithLp.ofLp z 0 := by
    fun_prop
  -- value and derivative of `Hᵢ` on `Bᵢ = {z₀ ∈ (0, 1), tail z ∈ Aᵢ}`
  have hHB : ∀ i, ∀ z : Euclid (q + 1 + 1), WithLp.ofLp z 0 ∈ Ioo (0 : ℝ) 1 →
      (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)) : Euclid (q + 1)) ∈ A i →
      H i z = WithLp.ofLp z 0 • G i (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))) ∧
      (fun b => fderiv ℝ (H i) z (EuclideanSpace.single b 1)) =
        Fin.cons (G i (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))))
          (fun a => WithLp.ofLp z 0 • fderiv ℝ (G i) (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)))
            (EuclideanSpace.single a 1)) := by
    intro i z hz hzA
    obtain ⟨h1, h2⟩ := hH i z hz (hGρ i _ hzA)
    exact ⟨h1, h2 (hGd i _ hzA)⟩
  -- steps 3, 5–7 for each piece: integrability of `hᵢ`, the `c′ᵢ` bound and the mass bound
  have hpb := fun i => Submission.dimred_cs_sos_cfs_cp_piece_bounds P (q + 1) ρ (G i) (H i) (A i)
    (w i) (c i) (hL i).continuous.measurable (hA i) (hw i) (hc i) (hwi i)
    (fun u hu => (hGρ i u hu).le) (hcb i) (fun z hz hzA => (hHB i z hz hzA).2)
  refine ⟨H, fun i => {z : Euclid (q + 1 + 1) | WithLp.ofLp z 0 ∈ Ioo (0 : ℝ) 1 ∧
      (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)) : Euclid (q + 1)) ∈ A i},
    fun i z => w i (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))),
    fun i z => WithLp.ofLp z 0 ^ (q + 1) * ‖G i (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z)))‖ *
      c i (WithLp.toLp 2 (Fin.tail (WithLp.ofLp z))),
    fun i => ⟨K i, hK i⟩, fun i => (Submission.cmcdt_lpi_cyl_fubini (q + 1) (A i) (hA i)).1,
    fun i => (hw i).comp htail.measurable, fun i => ?_, fun i => (hpb i).1,
    fun i z hz => (hpb i).2.1 z hz.1 hz.2, ?_, ?_⟩
  · -- `c′ᵢ` is measurable
    exact ((hz0.measurable.pow_const (q + 1)).mul
      ((hL i).continuous.comp htail).measurable.norm).mul ((hc i).comp htail.measurable)
  · -- step 7: `Σᵢ ∫⁻_{Bᵢ} |hᵢ| c′ᵢ ≤ ρ Σᵢ ∫⁻_{Aᵢ} |wᵢ| cᵢ < ∞`
    refine ne_top_of_le_ne_top ?_ (ENNReal.tsum_le_tsum fun i => (hpb i).2.2)
    rw [ENNReal.tsum_mul_left]
    exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top hsum
  · -- step 8: `Y(ω) = X(η)` with `η = Kω` on `spt X ⊇ Gᵢ(Aᵢ)`, and each term of the series for
    -- `X(η)` is the corresponding cone integral
    intro ω
    obtain ⟨η, hη, hYη⟩ := hYK ω
    rw [hYη]
    convert hXser η using 1
    funext i
    exact (Submission.dimred_cs_sos_cfs_cp_piece_action P (q + 1) (K i) (G i) (H i) (A i) (w i) ω
      η (hK i) (hA i) (hw i) (hwi i) (hHB i) fun u hu => hη (G i u) (hGA i ⟨u, hu, rfl⟩)).symm
/-- **An integer multiplicity triple carried by a Borel subset of a rectifiable set with tangent
data** (Simon Ch. 6, Definitions 3.1 and 4.4; for the slice `(M₊ ∩ f⁻¹(t), θ, ξ⌞ν)` take
`A = M₊ ∩ f⁻¹(t)` and `S = M ∩ f⁻¹(t)`).  Let `A ⊆ S ⊆ ℝᴾ` be Borel with `S` countably
`n`-rectifiable, `θ` Borel with `θ > 0` on `S` and `∫_{S ∩ K} θ dHⁿ < ∞` for compact `K`, and `ζ`
`Hⁿ⌞A`-measurable with `ζ(x)` a unit orientation of `TₓS` for `Hⁿ`-a.e. `x ∈ A`.  Then
`(A, θ, ζ)` is an `IMRep` in `ℝᴾ`.

`θ ≥ 1` on `S` makes `S` locally `Hⁿ`-finite, so tangent locality (`cmc_imRep_locality_restrict_sub`
(a) with `U = ℝᴾ`) gives `TₓA = TₓS` for `Hⁿ`-a.e. `x ∈ A`; rectifiability, positivity and local
integrability of `θ` pass from `S` to `A ⊆ S`. -/
theorem Submission.dtc_bc_lc_sl_sf_imrep_of_subset : ∀ (P n : ℕ) (A S : Set (Euclid P)) (θ : Euclid P → ℕ) (ζ : Euclid P → MultiVector P n), MeasurableSet A → MeasurableSet S → A ⊆ S → CountablyRectifiable n S → Measurable θ → (∀ x ∈ S, 0 < θ x) → (∀ K : Set (Euclid P), IsCompact K → ∫⁻ x in S ∩ K, (θ x : ℝ≥0∞) ∂μHE[n] ≠ ∞) → AEStronglyMeasurable ζ (μHE[n].restrict A) → (∀ᵐ x ∂(μHE[n].restrict A), ∃ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n S x Q ∧ IsUnitOrientationOf (ζ x) Q) → ∃ R : IMRep (univ : Set (Euclid P)) n, R.carrier = A ∧ R.mult = θ ∧ R.orient = ζ := by
  intro P n A S θ ζ hA hS hAS hrect hθ hpos hint hζ hor
  -- Step 1: `S` is locally `Hⁿ`-finite: `Hⁿ(S ∩ K) = ∫_{S ∩ K} 1 dHⁿ ≤ ∫_{S ∩ K} θ dHⁿ < ∞`
  have hSfin : ∀ K : Set (Euclid P), IsCompact K → K ⊆ univ → μHE[n] (S ∩ K) ≠ ∞ := by
    intro K hK _
    refine ne_top_of_le_ne_top (hint K hK) ?_
    exact (setLIntegral_one _).symm.trans_le
      (setLIntegral_mono' (hS.inter hK.measurableSet) fun x hx => Nat.one_le_cast.2 (hpos x hx.1))
  -- Step 2: `TₓA = TₓS` for `Hⁿ`-a.e. `x ∈ A` (tangent locality, `U = ℝᴾ`, `M = A`, `M' = S`)
  have hloc := Submission.cmc_imRep_locality_restrict_sub.1 P n univ A S isOpen_univ hA hS hAS
    (subset_univ S) hSfin
  -- Step 3: `ζ(x)` orients `TₓA` for `Hⁿ`-a.e. `x ∈ A`
  have horA : ∀ᵐ x ∂(μHE[n].restrict A), ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n A x Q ∧ IsUnitOrientationOf (ζ x) Q := by
    filter_upwards [hor, hloc] with x ⟨Q, hQ, hζQ⟩ hx
    exact ⟨Q, (hx Q).2 hQ, hζQ⟩
  -- Step 4: `∫_{A ∩ K} θ dHⁿ ≤ ∫_{S ∩ K} θ dHⁿ < ∞` for compact `K`, as `A ∩ K ⊆ S ∩ K`
  have hAint : ∀ K : Set (Euclid P), IsCompact K → K ⊆ univ →
      ∫⁻ x in A ∩ K, (θ x : ℝ≥0∞) ∂μHE[n] ≠ ∞ := fun K hK _ =>
    ne_top_of_le_ne_top (hint K hK) (lintegral_mono_set (inter_subset_inter_left K hAS))
  -- Step 5: assemble `R = (A, θ, ζ)`; `A ⊆ S` is countably `n`-rectifiable and `θ > 0` on `A`
  exact ⟨IMRep.mk A θ ζ hA (subset_univ A) (hrect.mono hAS) hθ (fun x hx => hpos x (hAS hx))
    hAint hζ horA, rfl, rfl, rfl⟩

/-- **Integer multiplicity current of an integer-weighted bi-Lipschitz image piece** (Simon Ch. 6,
3.3–3.9, for one piece `H|_A` of a Lipschitz push-forward).  Assume (MR) (`M_W(T) = μ_T(W)` for
`T = τ(M, θ, ξ)`) and (IMC) (locality/restriction/difference/orientation bound of `IMRep`s).  Let
`H : ℝⁿ → ℝᴾ` be `L`-Lipschitz, `A ⊆ ℝⁿ` Borel with `κ|a − a'| ≤ |H a − H a'|` on `A` (`κ > 0`),
`H` differentiable on `A` with injective derivative, and `g : ℝⁿ → ℤ` Borel, nonzero on `A` and
integrable over `A`.  Then `Φ(ω) = ∫_A g(u) ω(H u)(DH(u)e₁, …, DH(u)eₙ) du` is an integer
multiplicity current in `ℝᴾ` with `M(Φ) ≤ Lⁿ ∫_A |g|`.

`N = H(A)` is Borel and `H|_A` is a Borel isomorphism onto `N` (Lusin–Souslin).  With
`v(u) = (DH(u)e_a)_a` and `J = √det(⟨v_a, v_b⟩) > 0` on `A`, put `θ(H u) = |g(u)|` and
`ζ(H u) = sign(g u) J(u)⁻¹ v₁(u) ∧ ⋯ ∧ vₙ(u)`, a unit orientation of `range DH(u)`; this is the
approximate tangent space of `N` at `H u` for a.e. `u ∈ A`, and `Hⁿ(H(Z)) ≤ Lⁿ λ(Z)` makes the
exceptional set `Hⁿ`-null.  `τ(N, θ, ζ)` is the current; the area formula
`∫_N f dHⁿ = ∫_A J f(H u) du` gives the action, and (MR) with `Hⁿ⌞N ≤ Lⁿ H_#(λ⌞A)` the mass. -/
theorem Submission.dimred_mbl_dt_lpip_bilipschitz_image_current : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (P n : ℕ) (L : NNReal) (κ : ℝ) (H : Euclid n → Euclid P) (A : Set (Euclid n)) (g : Euclid n → ℤ), LipschitzWith L H → MeasurableSet A → 0 < κ → (∀ a ∈ A, ∀ a' ∈ A, κ * ‖a - a'‖ ≤ ‖H a - H a'‖) → (∀ a ∈ A, DifferentiableAt ℝ H a ∧ Injective (fderiv ℝ H a)) → Measurable g → (∀ a ∈ A, g a ≠ 0) → IntegrableOn (fun u => (g u : ℝ)) A → ∃ Φ : GeometricCurrentOn (univ : Set (Euclid P)) n, IsIntegerMultiplicity Φ ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) n, Φ ω = ∫ u in A, (g u : ℝ) * (ω : DifferentialForm (Euclid P) n) (H u) (fun a => fderiv ℝ H u (EuclideanSpace.single a 1))) ∧ Φ.mass ≤ (L : ℝ≥0∞) ^ n * ∫⁻ u in A, ‖(g u : ℝ)‖ₑ := by
  intro hMR hIMC P n L κ H A g hH hA hκ hbi hreg hg hg0 hgint
  -- Step 1: `H` is continuous and injective on `A`, so `N = H(A)` is Borel and `H|_A` is a
  -- measurable embedding (Lusin–Souslin)
  have hHc : Continuous H := hH.continuous
  have hinj : InjOn H A := by
    intro a ha a' ha' haa'
    have h := hbi a ha a' ha'
    rw [haa', sub_self, norm_zero] at h
    have h' : ‖a - a'‖ ≤ 0 := by
      by_contra hc
      exact absurd h (not_le.2 (mul_pos hκ (not_le.1 hc)))
    exact sub_eq_zero.1 (norm_le_zero_iff.1 h')
  have hN : MeasurableSet (H '' A) := hA.image_of_continuousOn_injOn hHc.continuousOn hinj
  have hemb : MeasurableEmbedding (A.domRestrict H) :=
    ContinuousOn.measurableEmbedding hA hHc.continuousOn hinj
  -- `Hⁿ(H(Z)) ≤ Lⁿ λ(Z)` for `Z ⊆ A`
  have hbilip := Submission.dimred_mbl_dt_lpip_bilipschitz_measure_bounds P n H A L κ hH hκ hbi
  -- Step 2: the frame `v(u) = (DH(u)e_a)_a` and its Gram Jacobian `J(u) = √det(⟨v_a, v_b⟩)`
  obtain ⟨v, hv⟩ : ∃ v : Euclid n → Fin n → Euclid P,
      v = fun u a => fderiv ℝ H u (EuclideanSpace.single a 1) := ⟨_, rfl⟩
  obtain ⟨J, hJ⟩ : ∃ J : Euclid n → ℝ,
      J = fun u => Real.sqrt (Matrix.det (Matrix.of fun i j : Fin n => inner ℝ (v u i) (v u j))) :=
    ⟨_, rfl⟩
  have hJm : Measurable J := by
    subst hJ hv
    exact (Submission.codim1_lura_gram_area_formula n P H).1
  -- the injective area formula `∫_{H(A)} f dHⁿ = ∫_A J f(H u) du`
  have harea : ∀ f : Euclid P → ℝ, ∫ w in H '' A, f w ∂μHE[n] = ∫ u in A, J u * f (H u) := by
    intro f
    subst hJ hv
    exact Submission.codim1_lur_cd_injective_area_formula_gram P n H A hA
      (fun u hu => (hreg u hu).1) (fun u hu => (hreg u hu).2) hinj f
  -- `v(u)` is a basis of `range DH(u)` for `u ∈ A`, as `DH(u)` is injective
  have hbf : ⇑(EuclideanSpace.basisFun (Fin n) ℝ) =
      fun a : Fin n => (EuclideanSpace.single a (1 : ℝ) : Euclid n) :=
    funext fun a => EuclideanSpace.basisFun_apply (Fin n) ℝ a
  have hsingle : Submodule.span ℝ (Set.range fun a : Fin n => (EuclideanSpace.single a (1 : ℝ) :
      Euclid n)) = ⊤ := by
    have h := (EuclideanSpace.basisFun (Fin n) ℝ).toBasis.span_eq
    rwa [OrthonormalBasis.coe_toBasis, hbf] at h
  have hli : ∀ u ∈ A, LinearIndependent ℝ (v u) := by
    intro u hu
    have hb := (EuclideanSpace.basisFun (Fin n) ℝ).toBasis.linearIndependent
    rw [OrthonormalBasis.coe_toBasis, hbf] at hb
    rw [hv]
    exact hb.map' (fderiv ℝ H u : Euclid n →ₗ[ℝ] Euclid P) (LinearMap.ker_eq_bot.2 (hreg u hu).2)
  have hspan : ∀ u, Submodule.span ℝ (Set.range (v u)) =
      LinearMap.range (fderiv ℝ H u : Euclid n →ₗ[ℝ] Euclid P) := by
    intro u
    have h1 : Set.range (v u) = (fderiv ℝ H u : Euclid n →ₗ[ℝ] Euclid P) ''
        Set.range fun a : Fin n => (EuclideanSpace.single a (1 : ℝ) : Euclid n) := by
      rw [hv, ← Set.range_comp]
      rfl
    rw [h1, Submodule.span_image, hsingle, Submodule.map_top]
  have hJpos : ∀ u ∈ A, 0 < J u := fun u hu => by
    rw [hJ]
    exact Real.sqrt_pos.2
      (Submission.codim1_lur_normalized_wedge_orientation P n (v u) (hli u hu)).1
  -- Step 3: `Ψ(u) = sign(g u) J(u)⁻¹ v₁(u) ∧ ⋯ ∧ vₙ(u)` is strongly measurable, as
  -- `w ↦ (α ↦ α(w))` is a continuous multilinear map `(ℝᴾ)ⁿ → Λₙ(ℝᴾ)`
  obtain ⟨Ψ, hΨm, hΨ⟩ : ∃ Ψ : Euclid n → MultiVector P n, StronglyMeasurable Ψ ∧
      ∀ u (α : Covector (Euclid P) n), Ψ u α = ((g u).sign : ℝ) * ((J u)⁻¹ * α (v u)) := by
    let ev : ContinuousMultilinearMap ℝ (fun _ : Fin n => Euclid P) (MultiVector P n) :=
      ContinuousLinearMap.flipMultilinear (ContinuousAlternatingMap.toContinuousMultilinearMapCLM ℝ)
    have hvm : Measurable v := by
      rw [hv]
      exact Measurable.of_eval fun a =>
        measurable_fderiv_apply_const ℝ H (EuclideanSpace.single a 1)
    refine ⟨fun u => (((g u).sign : ℝ) * (J u)⁻¹) • ev (v u), ?_, fun u α => ?_⟩
    · exact (((Measurable.of_discrete (f := fun z : ℤ => (z.sign : ℝ))).comp hg).mul
        hJm.inv).stronglyMeasurable.smul (ev.coe_continuous.comp_stronglyMeasurable
          hvm.stronglyMeasurable)
    · simp only [smul_apply, smul_eq_mul, ev,
        ContinuousLinearMap.flipMultilinear_apply_apply,
        ContinuousAlternatingMap.toContinuousMultilinearMapCLM_apply,
        ContinuousAlternatingMap.coe_toContinuousMultilinearMap]
      ring
  -- multiplicity `θ(H u) = |g(u)|` and orientation `ζ(H u) = Ψ(u)` on `N`, extended by `0`
  obtain ⟨θ, hθm, hθH⟩ : ∃ θ : Euclid P → ℕ, Measurable θ ∧ ∀ u ∈ A, θ (H u) = (g u).natAbs :=
    ⟨Function.extend (A.domRestrict H) (fun a => (g a).natAbs) fun _ => 0,
      hemb.measurable_extend ((Measurable.of_discrete (f := Int.natAbs)).comp
        (hg.comp measurable_subtype_coe)) measurable_const,
      fun u hu => hemb.injective.extend_apply _ _ ⟨u, hu⟩⟩
  obtain ⟨ζ, hζm, hζH⟩ : ∃ ζ : Euclid P → MultiVector P n, StronglyMeasurable ζ ∧
      ∀ u ∈ A, ζ (H u) = Ψ u :=
    ⟨Function.extend (A.domRestrict H) (fun a => Ψ a) fun _ => 0,
      hemb.stronglyMeasurable_extend (hΨm.comp_measurable measurable_subtype_coe)
        stronglyMeasurable_const,
      fun u hu => hemb.injective.extend_apply _ _ ⟨u, hu⟩⟩
  have hθpos : ∀ y ∈ H '' A, 0 < θ y := by
    rintro _ ⟨u, hu, rfl⟩
    rw [hθH u hu]
    exact Int.natAbs_pos.2 (hg0 u hu)
  -- Step 4: `Hⁿ⌞N ≤ Lⁿ H_#(λ⌞A)`, hence `∫_N θ dHⁿ ≤ Lⁿ ∫_A |g| < ∞`
  have hle : μHE[n].restrict (H '' A) ≤ ((L : ℝ≥0∞) ^ n) • (volume.restrict A).map H := by
    refine Measure.le_iff.2 fun B hB => ?_
    rw [Measure.restrict_apply hB, Measure.smul_apply, Measure.map_apply hHc.measurable hB,
      Measure.restrict_apply (hHc.measurable hB), smul_eq_mul]
    have hset : B ∩ H '' A = H '' (H ⁻¹' B ∩ A) := by
      ext y
      constructor
      · rintro ⟨hyB, u, hu, rfl⟩
        exact ⟨u, ⟨hyB, hu⟩, rfl⟩
      · rintro ⟨u, ⟨huB, hu⟩, rfl⟩
        exact ⟨huB, u, hu, rfl⟩
    rw [hset]
    exact (hbilip _ inter_subset_right).2
  have hθint : ∫⁻ y in H '' A, (θ y : ℝ≥0∞) ∂μHE[n] ≤
      (L : ℝ≥0∞) ^ n * ∫⁻ u in A, ‖(g u : ℝ)‖ₑ := by
    have hθm' : Measurable fun y => (θ y : ℝ≥0∞) :=
      (Measurable.of_discrete (f := fun k : ℕ => (k : ℝ≥0∞))).comp hθm
    calc ∫⁻ y in H '' A, (θ y : ℝ≥0∞) ∂μHE[n]
        ≤ ∫⁻ y, (θ y : ℝ≥0∞) ∂(((L : ℝ≥0∞) ^ n) • (volume.restrict A).map H) :=
          lintegral_mono' hle le_rfl
      _ = (L : ℝ≥0∞) ^ n * ∫⁻ u in A, (θ (H u) : ℝ≥0∞) := by
          rw [lintegral_smul_measure, lintegral_map hθm' hHc.measurable, smul_eq_mul]
      _ = (L : ℝ≥0∞) ^ n * ∫⁻ u in A, ‖(g u : ℝ)‖ₑ := by
          congr 1
          refine setLIntegral_congr_fun hA fun u hu => ?_
          show (θ (H u) : ℝ≥0∞) = ‖(g u : ℝ)‖ₑ
          rw [hθH u hu, Real.enorm_eq_ofReal_abs, ← Int.cast_abs, Int.abs_eq_natAbs,
            Int.cast_natCast, ENNReal.ofReal_natCast]
  have hfin : ∫⁻ u in A, ‖(g u : ℝ)‖ₑ < ∞ := hgint.2
  have hθloc : ∀ K : Set (Euclid P), IsCompact K →
      ∫⁻ x in H '' A ∩ K, (θ x : ℝ≥0∞) ∂μHE[n] ≠ ∞ := fun K _ =>
    ne_top_of_le_ne_top (ENNReal.mul_ne_top (ENNReal.pow_ne_top ENNReal.coe_ne_top) hfin.ne)
      ((lintegral_mono_set inter_subset_left).trans hθint)
  -- Step 5: `ζ(H u) = ±J(u)⁻¹ v₁(u) ∧ ⋯ ∧ vₙ(u)` orients `range DH(u)` for every `u ∈ A`
  have horH : ∀ u ∈ A, IsUnitOrientationOf (ζ (H u))
      (LinearMap.range (fderiv ℝ H u : Euclid n →ₗ[ℝ] Euclid P)) := by
    intro u hu
    have hJu : J u =
        Real.sqrt (Matrix.det (Matrix.of fun i j : Fin n => inner ℝ (v u i) (v u j))) := by
      rw [hJ]
    have hw := (Submission.codim1_lur_normalized_wedge_orientation P n (v u) (hli u hu)).2
    rw [hspan u] at hw
    rw [hζH u hu]
    rcases (hg0 u hu).lt_or_gt with hlt | hgt
    · -- `-ζ(H u)` is the normalized wedge; a unit orientation may carry either sign
      obtain ⟨τ, hτ, hτQ, h | h⟩ := hw (-Ψ u) fun α => by
        rw [neg_apply, hΨ, Int.sign_eq_neg_one_of_neg hlt, hJu]
        push_cast
        ring
      · refine ⟨τ, hτ, hτQ, Or.inr fun α => ?_⟩
        have h' := h α
        rw [neg_apply] at h'
        linarith
      · refine ⟨τ, hτ, hτQ, Or.inl fun α => ?_⟩
        have h' := h α
        rw [neg_apply] at h'
        linarith
    · exact hw (Ψ u) fun α => by
        rw [hΨ, Int.sign_eq_one_of_pos hgt, hJu]
        push_cast
        ring
  -- the approximate tangent space of `N` at `H u` is `range DH(u)` for a.e. `u ∈ A`; the
  -- exceptional parameters form a `λ`-null `Z ⊆ A` with `Hⁿ(H(Z)) ≤ Lⁿ λ(Z) = 0`
  have hor : ∀ᵐ y ∂(μHE[n].restrict (H '' A)), ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n (H '' A) y Q ∧ IsUnitOrientationOf (ζ y) Q := by
    have htan := Submission.ptd_piece_image_approxTangent_ae P n H A L κ hH hA hκ hbi hreg
    rw [ae_restrict_iff' hA, ae_iff] at htan
    have hHZ := (hbilip {u | ¬(u ∈ A → HasApproximateTangentSpaceAt n (H '' A) (H u)
      (LinearMap.range (fderiv ℝ H u : Euclid n →ₗ[ℝ] Euclid P)))} fun u hu => (not_imp.1 hu).1).2
    rw [htan, mul_zero, nonpos_iff_eq_zero] at hHZ
    rw [ae_iff, Measure.restrict_apply' hN]
    refine measure_mono_null ?_ hHZ
    rintro _ ⟨hy, u, hu, rfl⟩
    exact ⟨u, fun hT => hy ⟨_, hT hu, horH u hu⟩, rfl⟩
  -- Step 6: the `IMRep` `(N, θ, ζ)` in `ℝᴾ`
  obtain ⟨R₁, hR₁c, hR₁m, hR₁o⟩ := Submission.dtc_bc_lc_sl_sf_imrep_of_subset P n (H '' A) (H '' A)
    θ ζ hN hN subset_rfl
    ((Poincare.SimonGMT.Chapter03.countablyRectifiable_range hH).mono (image_subset_range H A))
    hθm hθpos hθloc hζm.aestronglyMeasurable hor
  -- Step 7: the current `Φ = τ(N, θ, ζ)`, by (IMC)(b) with `E = ℝᴾ`
  obtain ⟨Φ, R, hRep, hRc, hRm, hRo⟩ := hIMC.2.1 P n univ R₁ univ isOpen_univ MeasurableSet.univ
  refine ⟨Φ, ⟨R, hRep⟩, fun ω => ?_, ?_⟩
  · -- Step 8: `Φ(ω) = ∫_N θ⟨ω, ζ⟩ dHⁿ = ∫_A J θ(H u)⟨ω(H u), ζ(H u)⟩ du = ∫_A g⟨ω(H u), v(u)⟩ du`
    rw [hRep ω, IMRep.action, hRc, hRm, hRo, hR₁c, hR₁m, hR₁o, inter_univ, harea]
    refine setIntegral_congr_fun hA fun u hu => ?_
    show J u * ((θ (H u) : ℝ) * ζ (H u) ((ω : DifferentialForm (Euclid P) n) (H u))) =
      (g u : ℝ) * (ω : DifferentialForm (Euclid P) n) (H u)
        (fun a => fderiv ℝ H u (EuclideanSpace.single a 1))
    have hvu : v u = fun a => fderiv ℝ H u (EuclideanSpace.single a 1) := by rw [hv]
    have hgs : ((g u).natAbs : ℝ) * ((g u).sign : ℝ) = (g u : ℝ) := by
      rw [Nat.cast_natAbs, Int.cast_abs, mul_comm]
      exact_mod_cast Int.sign_mul_abs (g u)
    have key : ∀ s a b X : ℝ, s ≠ 0 → s * (a * (b * (s⁻¹ * X))) = a * b * X := by
      intro s a b X hs
      field_simp
    rw [hθH u hu, hζH u hu, hΨ, hvu, key _ _ _ _ (hJpos u hu).ne', hgs]
  · -- Step 9: `M(Φ) = μ_Φ(ℝᴾ) = ∫_N θ dHⁿ ≤ Lⁿ ∫_A |g|` by (MR)
    show Φ.massOn univ ≤ _
    rw [hMR P n univ Φ R isOpen_univ hRep univ isOpen_univ, IMRep.measure,
      withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ, hRc, hRm, hR₁c, hR₁m,
      inter_univ]
    exact hθint

/-- **Simon Ch. 3, proof of Theorem 1.6 "⇒"**, along a Lipschitz map `F : ℝᵏ → ℝᴾ`: if `Y` is
Borel with `Hᵏ(Y ∩ C) < ∞` for compact `C`, then for a.e. `u` with `F(u) ∈ Y`, `F`
differentiable at `u` and `DF(u)` injective, `Y` has approximate tangent space `DF(u)(ℝᵏ)` at
`F(u)`.  The Borel set `G` of such `u` is covered by countably many Borel pieces on which `F` is
`r(Aᵢ)`-close to some `Aᵢ = DF(yᵢ)`, where `2r(A)|w| ≤ |Aw|` for injective `A`.  Hence
`r(Aᵢ)|a − a'| ≤ |F(a) − F(a')|` on each piece, and the bi-Lipschitz piece lemma applies. -/
theorem Submission.idtp_fons_cs_sos_lipschitz_approx_tangent : ∀ (P k : ℕ) (F : Euclid k → Euclid P) (Y : Set (Euclid P)) (K : NNReal), 0 < k → LipschitzWith K F → MeasurableSet Y → (∀ C : Set (Euclid P), IsCompact C → μHE[k] (Y ∩ C) ≠ ∞) → ∀ᵐ u ∂(volume : Measure (Euclid k)), F u ∈ Y → DifferentiableAt ℝ F u → Function.Injective (fderiv ℝ F u) → HasApproximateTangentSpaceAt k Y (F u) (LinearMap.range (fderiv ℝ F u : Euclid k →ₗ[ℝ] Euclid P)) := by
  intro P k F Y K _hk hF hY hfin
  classical
  -- Step 1: the regular set `G = {u : DF(u) exists and is injective, F(u) ∈ Y}` is Borel
  set G : Set (Euclid k) :=
    ({u | DifferentiableAt ℝ F u} ∩ {u | Injective (fderiv ℝ F u)}) ∩ F ⁻¹' Y
  have hGm : MeasurableSet G :=
    ((measurableSet_of_differentiableAt ℝ F).inter
      (measurable_fderiv ℝ F ContinuousLinearMap.isOpen_injective.measurableSet)).inter
      (hF.continuous.measurable hY)
  -- Step 2: an injective `A` satisfies `c_A‖w‖ ≤ ‖Aw‖` with `c_A > 0`; tolerance `r(A) = c_A/2`
  have hlb : ∀ A : Euclid k →L[ℝ] Euclid P, Injective A →
      ∃ c : NNReal, 0 < c ∧ ∀ w, (c : ℝ) * ‖w‖ ≤ ‖A w‖ := by
    intro A hA
    obtain ⟨K', hK'pos, hK'⟩ :=
      (LinearMap.injective_iff_antilipschitz (A : Euclid k →ₗ[ℝ] Euclid P)).1 hA
    refine ⟨K'⁻¹, inv_pos.2 hK'pos, fun w => ?_⟩
    have hw := ZeroHomClass.bound_of_antilipschitz (A : Euclid k →ₗ[ℝ] Euclid P) hK' w
    have hK'r : (0 : ℝ) < K' := hK'pos
    rw [NNReal.coe_inv, inv_mul_le_iff₀ hK'r]
    simpa using hw
  choose! c hcpos hc using hlb
  let r : (Euclid k →L[ℝ] Euclid P) → NNReal := fun A => if Injective A then c A / 2 else 1
  have hr0 : ∀ A, r A ≠ 0 := by
    intro A
    simp only [r]
    split_ifs with h
    · exact (div_pos (hcpos A h) two_pos).ne'
    · exact one_ne_zero
  -- Step 3: countably many Borel pieces `G ∩ t n` on which `F` is `r(A n)`-close to `A n`
  obtain ⟨t, A, -, htm, hcov, happ, hAder⟩ :=
    exists_partition_approximatesLinearOn_of_hasFDerivWithinAt F G (fderiv ℝ F)
      (fun u hu => hu.1.1.hasFDerivAt.hasFDerivWithinAt) r hr0
  -- Steps 4–5: on a nonempty piece, `A n = DF(y)` is injective, so `F` is bi-Lipschitz there
  -- and the bi-Lipschitz piece lemma gives the tangent planes
  have hpiece : ∀ n, ∀ᵐ u ∂(volume : Measure (Euclid k)), u ∈ G ∩ t n →
      HasApproximateTangentSpaceAt k Y (F u)
        (LinearMap.range (fderiv ℝ F u : Euclid k →ₗ[ℝ] Euclid P)) := by
    intro n
    rcases (G ∩ t n).eq_empty_or_nonempty with hB | hB
    · exact Eventually.of_forall fun u hu => by simp [hB] at hu
    obtain ⟨y, hyG, hAy⟩ := hAder (hB.mono inter_subset_left) n
    have hinj : Injective (A n) := hAy ▸ hyG.1.2
    have hrA : r (A n) = c (A n) / 2 := ite_eq_left hinj
    have hm : (0 : ℝ) < r (A n) := NNReal.coe_pos.2 (pos_iff_ne_zero.2 (hr0 _))
    have hbi : ∀ a ∈ G ∩ t n, ∀ a' ∈ G ∩ t n, (r (A n) : ℝ) * ‖a - a'‖ ≤ ‖F a - F a'‖ := by
      intro a ha a' ha'
      have h1 := happ n a ha a' ha'
      have h2 := hc (A n) hinj (a - a')
      have h3 : ‖A n (a - a')‖ ≤ ‖F a - F a'‖ + ‖F a - F a' - A n (a - a')‖ := by
        calc ‖A n (a - a')‖ = ‖(F a - F a') - (F a - F a' - A n (a - a'))‖ := by
              congr 1; abel
          _ ≤ ‖F a - F a'‖ + ‖F a - F a' - A n (a - a')‖ := norm_sub_le _ _
      rw [hrA] at h1 ⊢
      push_cast at h1 ⊢
      linarith
    exact (ae_restrict_iff' (hGm.inter (htm n))).1
      (Submission.dpf_approxTangent_ae_bilipschitz_piece P k univ Y F (G ∩ t n) K (r (A n))
        isOpen_univ hY (subset_univ _) (fun C hC _ => hfin C hC) hF (hGm.inter (htm n)) hm hbi
        (fun a ha => ⟨ha.1.1.1, ha.1.1.2⟩) (by rintro _ ⟨a, ha, rfl⟩; exact ha.1.2))
  -- Step 6: a.e. `u` lies in no exceptional set; a regular `u ∈ F⁻¹(Y)` lies in some piece
  filter_upwards [ae_all_iff.2 hpiece] with u hu hFu hdiff hinj
  have huG : u ∈ G := ⟨⟨hdiff, hinj⟩, hFu⟩
  obtain ⟨n, hn⟩ := mem_iUnion.1 (hcov huG)
  exact hu n ⟨huG, hn⟩

/-- **Coarea formula along a spine, from bi-Lipschitz pieces** (Federer 3.2.22 for `p = p_L` on
`M`; the slicing step behind Simon 7.3.5, chapter-07.txt lines 407–418).  Let `M ⊆ ℝᴾ` be Borel
and locally `Hⁿ`-finite, covered up to an `Hⁿ`-null set by disjoint pieces `Fᵢ(Bᵢ) ⊆ M` with
`Fᵢ` Lipschitz, bi-Lipschitz on `Bᵢ` and `DFᵢ` injective on `Bᵢ`, with an approximate tangent
plane containing `L` at `Hⁿ`-a.e. point, `d = dim L < n` and `m = n − d`.  Then for `Hᵈ`-a.e.
`t ∈ L` the slice `Mₜ = M ∩ p⁻¹(t)` is countably `m`-rectifiable with `Tan(Mₜ, x) = TₓM ∩ L⊥`
for `Hᵐ`-a.e. `x ∈ Mₜ`, and `∫_M g dHⁿ = ∫_L ∫_{Mₜ} g dHᵐ dHᵈ(t)` for Borel `g ≥ 0`.

The given pieces are refined to pieces `H(Ω)` with `H` Lipschitz and bi-Lipschitz on
`Ω ⊆ ℝⁿ ≅ L × ℝᵐ` and `p ∘ H = (first coordinate)`: a part `Fᵢ(T)` on which `Fᵢ` is close to a
linear map `A` with `L ⊆ range A` is reparametrized by `u ↦ (pFᵢ(u), π_{ker pA}(u))`.  Because
`L ⊆ range DH`, a shear shows `JH = J(H(t, ·))` (the coarea factor is `1`), so the area formula
for `H` and for its slices and Fubini give the identity on each piece; `Hⁿ`-null sets have
`Hᵐ`-null slices for a.e. `t` (covering argument and Fatou).  The slices are covered by the slice
maps `H(t, ·)`, and `lipschitz_tangent` applied to them gives the tangent planes.  The argument
runs over abstract finite-dimensional spaces `V, F, B` and is instantiated at `ℝⁿ, ℝᴾ, ℝᵐ`. -/
theorem Submission.dimred_cs_sos_sc_coarea_of_pieces : ∀ (P n : ℕ) (L : Submodule ℝ (Euclid P)) (M : Set (Euclid P)), Module.finrank ℝ L < n → MeasurableSet M → (∃ (F : ℕ → Euclid n → Euclid P) (B : ℕ → Set (Euclid n)) (m : ℕ → ℝ), (∀ i, ∃ K : NNReal, LipschitzWith K (F i)) ∧ (∀ i, MeasurableSet (B i)) ∧ (∀ i, 0 < m i) ∧ (∀ i, ∀ a ∈ B i, ∀ a' ∈ B i, m i * ‖a - a'‖ ≤ ‖F i a - F i a'‖) ∧ (∀ i, ∀ a ∈ B i, DifferentiableAt ℝ (F i) a ∧ Injective (fderiv ℝ (F i) a)) ∧ (∀ i, MeasurableSet (F i '' B i)) ∧ (∀ i, F i '' B i ⊆ M) ∧ Pairwise (fun i j => Disjoint (F i '' B i) (F j '' B j)) ∧ μHE[n] (M \ ⋃ i, F i '' B i) = 0) → (∀ K : Set (Euclid P), IsCompact K → μHE[n] (M ∩ K) ≠ ∞) → (∀ᵐ x ∂(μHE[n].restrict M), ∃ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ∧ L ≤ Q) → (∀ᵐ t ∂(μHE[Module.finrank ℝ L].restrict (L : Set (Euclid P))), CountablyRectifiable (n - Module.finrank ℝ L) (M ∩ {x | L.starProjection x = t}) ∧ ∀ᵐ x ∂(μHE[n - Module.finrank ℝ L].restrict (M ∩ {x | L.starProjection x = t})), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q → HasApproximateTangentSpaceAt (n - Module.finrank ℝ L) (M ∩ {x | L.starProjection x = t}) x (Q ⊓ Lᗮ)) ∧ ∀ g : Euclid P → ℝ≥0∞, Measurable g → AEMeasurable (fun t => ∫⁻ x in M ∩ {x | L.starProjection x = t}, g x ∂μHE[n - Module.finrank ℝ L]) (μHE[Module.finrank ℝ L].restrict (L : Set (Euclid P))) ∧ ∫⁻ x in M, g x ∂μHE[n] = ∫⁻ t in (L : Set (Euclid P)), ∫⁻ x in M ∩ {x | L.starProjection x = t}, g x ∂μHE[n - Module.finrank ℝ L] ∂μHE[Module.finrank ℝ L] := by
  intro P n L M hdn hM hpieces hloc htan
  -- The argument runs over abstract spaces `V = ℝⁿ`, `F = ℝᴾ`, `B = ℝᵐ`; the Euclidean inputs
  -- (bi-Lipschitz pieces, pull-back of null sets along a piece, `lipschitz_tangent` in dimensions
  -- `n` and `m`, a.e. transfer through pieces) enter as hypotheses.
  have master : ∀ (V F B : Type) [NormedAddCommGroup V] [InnerProductSpace ℝ V]
      [FiniteDimensional ℝ V] [MeasurableSpace V] [BorelSpace V] [NormedAddCommGroup F]
      [InnerProductSpace ℝ F] [FiniteDimensional ℝ F] [MeasurableSpace F] [BorelSpace F]
      [NormedAddCommGroup B] [InnerProductSpace ℝ B] [FiniteDimensional ℝ B] [MeasurableSpace B]
      [BorelSpace B] (n d m : ℕ) (L : Submodule ℝ F) (M : Set F),
      Module.finrank ℝ V = n → Module.finrank ℝ B = m → Module.finrank ℝ ↥L = d → d < n →
      n - d = m → MeasurableSet M → (∀ K : Set F, IsCompact K → μHE[n] (M ∩ K) ≠ ∞) →
      (∀ᵐ x ∂(μHE[n].restrict M), ∃ Q : Submodule ℝ F, HasApproximateTangentSpaceAt n M x Q ∧
        L ≤ Q) →
      (∃ (Fp : ℕ → V → F) (Bp : ℕ → Set V) (mm : ℕ → ℝ),
        (∀ i, ∃ K : NNReal, LipschitzWith K (Fp i)) ∧ (∀ i, MeasurableSet (Bp i)) ∧
        (∀ i, 0 < mm i) ∧ (∀ i, ∀ a ∈ Bp i, ∀ a' ∈ Bp i, mm i * ‖a - a'‖ ≤ ‖Fp i a - Fp i a'‖) ∧
        (∀ i, ∀ a ∈ Bp i, DifferentiableAt ℝ (Fp i) a ∧ Injective (fderiv ℝ (Fp i) a)) ∧
        (∀ i, MeasurableSet (Fp i '' Bp i)) ∧ (∀ i, Fp i '' Bp i ⊆ M) ∧
        Pairwise (fun i j => Disjoint (Fp i '' Bp i) (Fp j '' Bp j)) ∧
        μHE[n] (M \ ⋃ i, Fp i '' Bp i) = 0) →
      (∀ (G : V → F) (S : Set V) (K : NNReal) (c : ℝ), LipschitzWith K G → MeasurableSet S →
        0 < c → (∀ a ∈ S, ∀ a' ∈ S, c * ‖a - a'‖ ≤ ‖G a - G a'‖) → MeasurableSet (G '' S) ∧
        ∀ p : F → Prop, (∀ᵐ y ∂(μHE[n].restrict (G '' S)), p y) →
          ∀ᵐ b ∂(volume.restrict S), p (G b)) →
      (∀ (G : V → F) (Y : Set F) (K : NNReal), LipschitzWith K G → MeasurableSet Y →
        (∀ C : Set F, IsCompact C → μHE[n] (Y ∩ C) ≠ ∞) → ∀ᵐ u ∂(volume : Measure V), G u ∈ Y →
        DifferentiableAt ℝ G u → Injective (fderiv ℝ G u) →
        HasApproximateTangentSpaceAt n Y (G u) (LinearMap.range (fderiv ℝ G u : V →ₗ[ℝ] F))) →
      (∀ (G : B → F) (Y : Set F) (K : NNReal), LipschitzWith K G → MeasurableSet Y →
        (∀ C : Set F, IsCompact C → μHE[m] (Y ∩ C) ≠ ∞) → ∀ᵐ u ∂(volume : Measure B), G u ∈ Y →
        DifferentiableAt ℝ G u → Injective (fderiv ℝ G u) →
        HasApproximateTangentSpaceAt m Y (G u) (LinearMap.range (fderiv ℝ G u : B →ₗ[ℝ] F))) →
      (∀ (S : Set F) (G : ℕ → B → F) (T : ℕ → Set B) (p : F → Prop), MeasurableSet S →
        (∀ i, ∃ K : NNReal, LipschitzWith K (G i)) → μHE[m] (S \ ⋃ i, G i '' T i) = 0 →
        (∀ i, ∀ᵐ b ∂(volume.restrict (T i)), p (G i b)) → ∀ᵐ x ∂(μHE[m].restrict S), p x) →
      (∀ᵐ t ∂(μHE[d].restrict (L : Set F)), (∃ M₀ : Set F, μHE[m] M₀ = 0 ∧ ∃ G : ℕ → B → F,
          (∀ j, ∃ K : NNReal, LipschitzWith K (G j)) ∧
          M ∩ {x | L.starProjection x = t} ⊆ M₀ ∪ ⋃ j, range (G j)) ∧
        ∀ᵐ x ∂(μHE[m].restrict (M ∩ {x | L.starProjection x = t})), ∀ Q : Submodule ℝ F,
          HasApproximateTangentSpaceAt n M x Q →
          HasApproximateTangentSpaceAt m (M ∩ {x | L.starProjection x = t}) x (Q ⊓ Lᗮ)) ∧
      ∀ g : F → ℝ≥0∞, Measurable g →
        AEMeasurable (fun t => ∫⁻ x in M ∩ {x | L.starProjection x = t}, g x ∂μHE[m])
          (μHE[d].restrict (L : Set F)) ∧
        ∫⁻ x in M, g x ∂μHE[n] = ∫⁻ t in (L : Set F),
          ∫⁻ x in M ∩ {x | L.starProjection x = t}, g x ∂μHE[m] ∂μHE[d] := by
    intro V F B _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ n d m L M hV hBm hd hdn hmd hM hloc htan hpieces
      hptd hchV hchB hitt
    have hm0 : 0 < m := hmd ▸ Nat.sub_pos_of_lt hdn
    have hnd : n = d + m := by rw [← hmd, Nat.add_sub_cancel' hdn.le]
    -- the parameter splitting `V ≅ L × B`
    have hfinE : Module.finrank ℝ V = Module.finrank ℝ (WithLp 2 (↥L × B)) := by
      rw [(WithLp.linearEquiv 2 ℝ (↥L × B)).finrank_eq, Module.finrank_prod, hd, hBm, hV, hnd]
    obtain ⟨Θ⟩ : Nonempty (V ≃ₗᵢ[ℝ] WithLp 2 (↥L × B)) :=
      ⟨(stdOrthonormalBasis ℝ V).equiv (stdOrthonormalBasis ℝ _) (finCongr hfinE)⟩
    -- the base: `volume` on `L` is `Hᵈ⌞L`
    have hLmeas : MeasurableSet (L : Set F) := L.closed_of_finiteDimensional.measurableSet
    have hemb : MeasurableEmbedding (Subtype.val : ↥L → F) := MeasurableEmbedding.subtype_coe hLmeas
    have hmap : (volume : Measure ↥L).map Subtype.val = μHE[d].restrict (L : Set F) := by
      rw [← InnerProductSpace.euclideanHausdorffMeasure_eq_volume, hd,
        isometry_subtype_coe.map_euclideanHausdorffMeasure, Subtype.range_coe]
    -- Fubini in the parameters
    have hmp : MeasurePreserving (fun x : ↥L × B => Θ.symm (WithLp.toLp 2 x)) (volume.prod volume)
        volume :=
      Θ.symm.measurePreserving.comp (WithLp.volume_preserving_toLp _ _)
    have hvolV : (μHE[n] : Measure V) = volume := by
      rw [← hV]
      exact InnerProductSpace.euclideanHausdorffMeasure_eq_volume
    -- the first coordinate `π₁ z = (Θ z).1 ∈ L` and the slice inclusion `jL s = Θ⁻¹(0, s)`
    obtain ⟨π₁, hπ₁⟩ : ∃ π₁ : V →L[ℝ] F, ∀ z, π₁ z = (((Θ z).fst : ↥L) : F) :=
      ⟨L.subtypeL.comp ((ContinuousLinearMap.fst ℝ ↥L B).comp
        ((WithLp.prodContinuousLinearEquiv 2 ℝ ↥L B).toContinuousLinearMap.comp
          (Θ.toContinuousLinearEquiv : V →L[ℝ] WithLp 2 (↥L × B)))), fun z => rfl⟩
    have hpπ : ∀ z, L.starProjection (π₁ z) = π₁ z := fun z =>
      Submodule.starProjection_eq_self_iff.mpr (by rw [hπ₁]; exact ((Θ z).fst).2)
    obtain ⟨jL, hjL⟩ : ∃ jL : B →L[ℝ] V, ∀ s, jL s = Θ.symm (WithLp.toLp 2 (0, s)) :=
      ⟨(Θ.symm.toContinuousLinearEquiv : WithLp 2 (↥L × B) →L[ℝ] V).comp
        ((WithLp.prodContinuousLinearEquiv 2 ℝ ↥L B).symm.toContinuousLinearMap.comp
          (ContinuousLinearMap.inr ℝ ↥L B)), fun s => rfl⟩
    have hjinj : Injective jL := fun s s' h => by
      rw [hjL, hjL] at h
      exact congrArg Prod.snd (WithLp.toLp_injective 2 (Θ.symm.injective h))
    have hjsplit : ∀ (t : ↥L) s, Θ.symm (WithLp.toLp 2 (t, s)) =
        Θ.symm (WithLp.toLp 2 (t, 0)) + jL s := fun t s => by
      rw [hjL, ← map_add, ← WithLp.toLp_add, Prod.mk_add_mk, add_zero, zero_add]
    -- **the Jacobian identity**: `J(DH) = J(DH ∘ jL)` when `p ∘ DH = π₁` and `L ⊆ range DH`
    have hLA : ∀ D : V →ₗ[ℝ] F, (∀ v, L.starProjection (D v) = π₁ v) → L ≤ LinearMap.range D →
        D.normDet = (D ∘ₗ (jL : B →ₗ[ℝ] V)).normDet ∧
        LinearMap.range (D ∘ₗ (jL : B →ₗ[ℝ] V)) = LinearMap.range D ⊓ Lᗮ := by
      intro D h1 h2
      have h1 : ∀ v, L.starProjection (D v) = ((Θ v).fst : F) := fun v => (h1 v).trans (hπ₁ v)
      obtain ⟨Y, hYdef⟩ : ∃ Y : B →ₗ[ℝ] F, Y = D ∘ₗ (jL : B →ₗ[ℝ] V) := ⟨_, rfl⟩
      rw [← hYdef]
      have hY : ∀ s, Y s = D (Θ.symm (WithLp.toLp 2 (0, s))) := fun s => by
        rw [hYdef]
        exact congrArg D (hjL s)
      have hYorth : ∀ s, Y s ∈ Lᗮ := fun s => by
        rw [← Submodule.orthogonalProjectionOnto_eq_zero_iff]
        apply Subtype.ext
        rw [← Submodule.starProjection_apply, hY, h1, LinearIsometryEquiv.apply_symm_apply]
        rfl
      have hsplit : ∀ w, D (Θ.symm w) = D (Θ.symm (WithLp.toLp 2 (w.fst, 0))) + Y w.snd :=
          fun w => by
        rw [hY, ← map_add, ← map_add, ← WithLp.toLp_add, Prod.mk_add_mk, add_zero, zero_add]
        rfl
      refine ⟨?_, ?_⟩
      · have hXY : ∀ τ : ↥L, D (Θ.symm (WithLp.toLp 2 (τ, 0))) - (τ : F) ∈ LinearMap.range Y := by
          intro τ
          obtain ⟨v, hv⟩ := h2 τ.2
          have hfst : (Θ v).fst = τ := Subtype.ext (by
            rw [← h1 v, show D v = (τ : F) from hv]
            exact Submodule.starProjection_eq_self_iff.mpr τ.2)
          refine ⟨-(Θ v).snd, ?_⟩
          have hs := hsplit (Θ v)
          rw [LinearIsometryEquiv.symm_apply_apply, hfst, show D v = (τ : F) from hv] at hs
          rw [map_neg, eq_sub_of_add_eq hs.symm]
          abel
        obtain ⟨Bm, hBm⟩ := Module.projective_lifting_property Y.rangeRestrict
          ((D ∘ₗ Θ.symm.toLinearIsometry.toLinearMap ∘ₗ
            (WithLp.linearEquiv 2 ℝ (↥L × B)).symm.toLinearMap
            ∘ₗ LinearMap.inl ℝ ↥L B - L.subtype).codRestrict (LinearMap.range Y) hXY)
          Y.surjective_rangeRestrict
        have hB : ∀ τ, Y (Bm τ) = D (Θ.symm (WithLp.toLp 2 (τ, 0))) - (τ : F) := fun τ =>
          congrArg Subtype.val (LinearMap.congr_fun hBm τ)
        obtain ⟨U, hU⟩ : ∃ U : WithLp 2 (↥L × B) →ₗ[ℝ] WithLp 2 (↥L × B), U = LinearMap.id +
            ((WithLp.linearEquiv 2 ℝ (↥L × B)).symm.toLinearMap ∘ₗ LinearMap.inr ℝ ↥L B ∘ₗ Bm) ∘ₗ
            (LinearMap.fst ℝ ↥L B ∘ₗ (WithLp.linearEquiv 2 ℝ (↥L × B)).toLinearMap) := ⟨_, rfl⟩
        have hdetU : LinearMap.det U = 1 := by
          classical
          have hA : (LinearMap.fst ℝ ↥L B ∘ₗ (WithLp.linearEquiv 2 ℝ (↥L × B)).toLinearMap) ∘ₗ
              ((WithLp.linearEquiv 2 ℝ (↥L × B)).symm.toLinearMap ∘ₗ LinearMap.inr ℝ ↥L B ∘ₗ Bm) =
                0 :=
            LinearMap.ext fun τ => rfl
          let b := Module.finBasis ℝ (WithLp 2 (↥L × B))
          let c := Module.finBasis ℝ ↥L
          rw [← LinearMap.det_toMatrix b, hU, map_add, LinearMap.toMatrix_id,
            LinearMap.toMatrix_comp b c b, Matrix.det_one_add_mul_comm,
            ← LinearMap.toMatrix_comp c b c, hA, map_zero, add_zero, Matrix.det_one]
        obtain ⟨D₀, hD₀⟩ : ∃ D₀ : WithLp 2 (↥L × B) →ₗ[ℝ] F, ∀ w, D₀ w = (w.fst : F) + Y w.snd :=
          ⟨L.subtype ∘ₗ LinearMap.fst ℝ ↥L B ∘ₗ (WithLp.linearEquiv 2 ℝ (↥L × B)).toLinearMap +
            Y ∘ₗ LinearMap.snd ℝ ↥L B ∘ₗ (WithLp.linearEquiv 2 ℝ (↥L × B)).toLinearMap,
            fun w => rfl⟩
        have hfac : D ∘ₗ Θ.symm.toLinearIsometry.toLinearMap = D₀ ∘ₗ U := by
          refine LinearMap.ext fun w => ?_
          have hUw : U w = WithLp.toLp 2 (w.fst, w.snd + Bm w.fst) := by
            rw [hU]
            exact WithLp.ofLp_injective 2 (Prod.ext (add_zero _) rfl)
          change D (Θ.symm w) = D₀ (U w)
          rw [hUw, hD₀, hsplit w]
          change D (Θ.symm (WithLp.toLp 2 (w.fst, 0))) + Y w.snd =
            (w.fst : F) + Y (w.snd + Bm w.fst)
          rw [map_add, hB]
          abel
        have hD₀Y : D₀.normDet = Y.normDet := by
          classical
          let bA := stdOrthonormalBasis ℝ ↥L
          let bB := stdOrthonormalBasis ℝ B
          have hg := LinearMap.normDet_sq_eq_det_gram D₀ (bA.prod bB)
          have hgY := LinearMap.normDet_sq_eq_det_gram Y bB
          have hb1 : ∀ i, D₀ (bA.prod bB (Sum.inl i)) = (bA i : F) := fun i => by
            rw [OrthonormalBasis.prod_apply, hD₀]
            change (bA i : F) + Y 0 = _
            rw [map_zero, add_zero]
          have hb2 : ∀ j, D₀ (bA.prod bB (Sum.inr j)) = Y (bB j) := fun j => by
            rw [OrthonormalBasis.prod_apply, hD₀]
            change ((0 : ↥L) : F) + Y (bB j) = _
            rw [Submodule.coe_zero, zero_add]
          have hG : Matrix.gram ℝ (fun i => D₀ (bA.prod bB i)) =
              Matrix.fromBlocks 1 0 0 (Matrix.gram ℝ (fun j => Y (bB j))) := by
            ext (i | i) (j | j)
            · rw [Matrix.gram_apply, hb1, hb1, Matrix.fromBlocks_apply₁₁, Matrix.one_apply,
                ← Submodule.coe_inner, bA.inner_eq_ite]
            · rw [Matrix.gram_apply, hb1, hb2, Matrix.fromBlocks_apply₁₂]
              exact Submodule.inner_right_of_mem_orthogonal (bA i).2 (hYorth _)
            · rw [Matrix.gram_apply, hb1, hb2, Matrix.fromBlocks_apply₂₁]
              exact Submodule.inner_left_of_mem_orthogonal (bA j).2 (hYorth _)
            · rw [Matrix.gram_apply, hb2, hb2, Matrix.fromBlocks_apply₂₂, Matrix.gram_apply]
          rw [hG, Matrix.det_fromBlocks_zero₂₁, Matrix.det_one, one_mul, ← hgY] at hg
          exact (sq_eq_sq₀ (LinearMap.normDet_nonneg _) (LinearMap.normDet_nonneg _)).mp
            (by exact_mod_cast hg)
        have e1 : (D ∘ₗ Θ.symm.toLinearIsometry.toLinearMap).normDet = D.normDet := by
          rw [LinearMap.normDet_comp_of_finrank_eq _ _ Θ.symm.toLinearEquiv.finrank_eq,
            Θ.symm.toLinearIsometry.normDet_eq_one, mul_one]
        rw [← e1, hfac, LinearMap.normDet_comp_of_finrank_eq U D₀ rfl,
          LinearMap.normDet_eq_abs_det U,
          hdetU, abs_one, mul_one, hD₀Y]
      · apply le_antisymm
        · rintro y ⟨s, rfl⟩
          exact ⟨⟨Θ.symm (WithLp.toLp 2 (0, s)), (hY s).symm⟩, hYorth s⟩
        · rintro y ⟨⟨v, rfl⟩, hy⟩
          have h0 : (Θ v).fst = 0 := by
            apply Subtype.ext
            rw [← h1 v, Submodule.starProjection_apply]
            exact congrArg Subtype.val (Submodule.orthogonalProjectionOnto_eq_zero_iff.mpr hy)
          refine ⟨(Θ v).snd, ?_⟩
          have hv : WithLp.toLp 2 ((0 : ↥L), (Θ v).snd) = Θ v :=
            WithLp.ofLp_injective 2 (Prod.ext h0.symm rfl)
          rw [hY, hv, LinearIsometryEquiv.symm_apply_apply]

    -- the constants of the reparametrization of a piece
    have hC : ∀ A : V →L[ℝ] F, ∃ C : NNReal, 0 < C ∧ ∀ v : V,
        ‖v‖ ≤ C * max ‖L.starProjection (A v)‖
          ‖(LinearMap.ker ((L.starProjection.comp A : V →L[ℝ] F) : V →ₗ[ℝ] F)).starProjection
            v‖ := by
      intro A
      obtain ⟨C, hC0, hCa⟩ := LinearMap.exists_antilipschitzWith
        (((L.starProjection.comp A : V →L[ℝ] F) : V →ₗ[ℝ] F).prod
          ((LinearMap.ker ((L.starProjection.comp A : V →L[ℝ] F) : V →ₗ[ℝ] F)).starProjection :
            V →ₗ[ℝ] V))
        (LinearMap.ker_eq_bot'.mpr fun v hv => by
          obtain ⟨h1, h2⟩ := Prod.ext_iff.mp hv
          exact (Submodule.starProjection_eq_self_iff.mpr (LinearMap.mem_ker.mpr h1)).symm.trans h2)
      exact ⟨C, hC0, fun v => (ZeroHomClass.bound_of_antilipschitz _ hCa v).trans_eq (by
        rw [Prod.norm_def]; rfl)⟩
    choose C hCpos hCb using hC
    have hdim : Module.finrank ℝ V = Module.finrank ℝ ↥L + Module.finrank ℝ B := by
      rw [hV, hd, hBm, hnd]
    -- **one piece**: reparametrize `F'` on `T` over `L × B`, with `p ∘ H' = π₁`
    have hPCL : ∀ (F' : V → F) (K' : NNReal) (T : Set V) (A' : V →L[ℝ] F) (m' : ℝ),
        LipschitzWith K' F' → MeasurableSet T → 0 < m' →
        (∀ a ∈ T, ∀ a' ∈ T, m' * ‖a - a'‖ ≤ ‖F' a - F' a'‖) →
        ApproximatesLinearOn F' A' T (2 * C A')⁻¹ →
        (T.Nonempty → L ≤ LinearMap.range (A' : V →ₗ[ℝ] F)) →
        ∃ (H' : V → F) (Ω' : Set V), (∃ K : NNReal, LipschitzWith K H') ∧ MeasurableSet Ω' ∧
          (∃ c : ℝ, 0 < c ∧ ∀ z ∈ Ω', ∀ z' ∈ Ω', c * ‖z - z'‖ ≤ ‖H' z - H' z'‖) ∧
          H' '' Ω' = F' '' T ∧ ∀ z, L.starProjection (H' z) = π₁ z := by
      intro F' K' T A' m' hF' hT hm' hbil' happ hLA'
      rcases T.eq_empty_or_nonempty with hT0 | hTne
      · exact ⟨π₁, ∅, ⟨_, π₁.lipschitzWith⟩, MeasurableSet.empty,
          ⟨1, one_pos, fun z hz => absurd hz (Set.notMem_empty z)⟩,
          by rw [hT0, Set.image_empty, Set.image_empty], hpπ⟩
      have hLA'' := hLA' hTne
      -- `K = ker (p ∘ A')` has dimension `dim B`
      have hrange : LinearMap.range ((L.starProjection.comp A' : V →L[ℝ] F) : V →ₗ[ℝ] F) = L := by
        apply le_antisymm
        · rintro _ ⟨v, rfl⟩
          change L.starProjection (A' v) ∈ L
          rw [Submodule.starProjection_apply]
          exact (L.orthogonalProjectionOnto (A' v)).2
        · intro ℓ hℓ
          obtain ⟨w, hw⟩ := hLA'' hℓ
          refine ⟨w, ?_⟩
          change L.starProjection (A' w) = ℓ
          rw [show A' w = ℓ from hw]
          exact Submodule.starProjection_eq_self_iff.mpr hℓ
      have hKfin : Module.finrank ℝ (LinearMap.ker ((L.starProjection.comp A' : V →L[ℝ] F) :
          V →ₗ[ℝ] F)) = Module.finrank ℝ B := by
        have h := LinearMap.finrank_range_add_finrank_ker
          ((L.starProjection.comp A' : V →L[ℝ] F) : V →ₗ[ℝ] F)
        rw [hrange, hdim] at h
        exact Nat.add_left_cancel h
      obtain ⟨κ⟩ : Nonempty (↥(LinearMap.ker ((L.starProjection.comp A' : V →L[ℝ] F) : V →ₗ[ℝ] F))
          ≃ₗᵢ[ℝ] B) := ⟨(stdOrthonormalBasis ℝ _).equiv (stdOrthonormalBasis ℝ B) (finCongr hKfin)⟩
      obtain ⟨Λ, hΛ⟩ : ∃ Λ : F × V →L[ℝ] V, ∀ x y, Λ (x, y) =
          Θ.symm (WithLp.toLp 2 (L.orthogonalProjectionOnto x,
