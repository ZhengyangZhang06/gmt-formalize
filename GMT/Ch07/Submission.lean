      (fun W _ _ => (iSup_le fun j => ?_).trans_lt hmass) hbconv
    rw [hbb d (Ts j) W, add_zero]
    exact ((Ts j).boundary.massOn_mono (subset_univ W)).trans (hmbTs j)
  -- Step 3: a compactly supported integer multiplicity `Y` of finite mass with `∂Y = ∂T`
  -- (an isoperimetric filling if `d ≥ 1`, signed segments from a point if `d = 0`)
  obtain ⟨Y, hYIM, hYb, hYmass, hYc⟩ := Submission.dmcbr_cc_compact_im_filling hMR hIMCc hVO
    (hIsoFill hDT) d P T hTc hbTmass hbTIM
  have hbYIM : IsIntegerMultiplicity Y.boundary := by rw [hYb]; exact hbTIM
  have hbYmass : Y.boundary.mass < ∞ := by rw [hYb]; exact hbTmass
  -- Step 4: the cycle `Γ = T − Y`: `∂Γ = 0`, `M(Γ) ≤ M(T) + M(Y) < ∞`, `spt Γ ⊆ spt T ∪ spt Y`
  have hΓb : (T - Y).boundary = 0 := by
    ext ω
    show T (exteriorDerivativeTestOn univ d ω) - Y (exteriorDerivativeTestOn univ d ω) = 0
    rw [sub_eq_zero]
    exact (congrArg (fun X : GeometricCurrentOn (univ : Set (Euclid P)) d => X ω) hYb).symm
  have hΓmass : (T - Y).mass < ∞ := by
    have h := hAlg.2.1 P (d + 1) univ (T - Y) T Y 1 (-1) (fun ω => by
      show T ω - Y ω = ((1 : ℤ) : ℝ) * T ω + ((-1 : ℤ) : ℝ) * Y ω
      push_cast
      ring) univ
    refine h.trans_lt ?_
    simp only [Int.natAbs_one, Int.natAbs_neg, Nat.cast_one, one_mul]
    exact ENNReal.add_lt_top.mpr ⟨hTmass, hYmass⟩
  have hΓc : IsCompact (T - Y).support := by
    refine (Submission.rsd_cmr_support_subset_of_vanish P (d + 1) univ (T.support ∪ Y.support)
      (T - Y) isOpen_univ (hTc.union hYc) (subset_univ _) fun ω hω => ?_).2
    show T ω - Y ω = 0
    rw [hVO P (d + 1) univ T ω (hω.mono_right subset_union_left),
      hVO P (d + 1) univ Y ω (hω.mono_right subset_union_right), sub_zero]
  -- Step 5: integer multiplicity currents with integer multiplicity boundaries (each `Tⱼ`, and
  -- `Y`) have the integer slice property
  have hloc : ∀ {m : ℕ} (X : GeometricCurrentOn (univ : Set (Euclid P)) m), X.mass < ∞ →
      ∀ W : Set (Euclid P), IsOpen W → CompactlyContained W univ → X.massOn W < ∞ :=
    fun X hX W _ _ => (X.massOn_mono (subset_univ W)).trans_lt hX
  have hISPY := hISP hIMC hSL hMM hRU d hBR P Y hYIM hbYIM
  -- Step 6: the integer slice property passes to the weak limit `T`
  have hISPT := Submission.dmcbr_slice_property_of_weak_limit hREP hMR hIMC hSL d hCL P Ts T
    (fun j => hISP hIMC hSL hMM hRU d hBR P (Ts j) (hTsIM j) (hbTsIM j))
    (fun W _ _ => (iSup_le fun j => (add_le_add ((Ts j).massOn_mono (subset_univ W))
      ((Ts j).boundary.massOn_mono (subset_univ W))).trans
        (le_iSup (fun j => (Ts j).mass + (Ts j).boundary.mass) j)).trans_lt hmass) hconv
  -- Step 7: and to the difference `Γ = T − Y`
  have hISPΓ := hISPsub hREP hSL hIMCc hRU d P T Y (hloc T hTmass) (hloc T.boundary hbTmass)
    (hloc Y hYmass) (hloc Y.boundary hbYmass) hISPT hISPY
  -- Step 8: `Γ` is integer multiplicity by cycle_im, hence so is `T = Γ − (0 − Y)` by (IMC)(c)
  have hΓIM := hCycleIM hREP hMR hIMC hSL hDT hVO d hCL P (T - Y) hΓb hΓmass hΓc hISPΓ
  have hT : T = (T - Y) - (0 - Y) := by
    ext ω
    show T ω = (T ω - Y ω) - (0 - Y ω)
    ring
  rw [hT]
  exact hIMCc P (d + 1) univ (T - Y) (0 - Y) isOpen_univ hΓIM
    (hIMCc P (d + 1) univ 0 Y isOpen_univ (hAlg.1 P (d + 1) univ) hYIM)

/-- **Push-forward of integer multiplicity currents by a `C¹` map** (Simon Ch. 6, 2.23–2.24 and
3.3–3.9).  Let `f` be `C¹` on the open set `O` with `‖Df‖ ≤ L` there, and call `Y ∈ 𝒟ₙ(ℝᴾ)`
(`n = m + 1`) admissible if it is integer multiplicity and `spt Y` is a compact subset of `O`.  For
admissible `Y = τ(M, θ, ξ)` let `push Y(ω) = ∫_M θ ⟨ω(f(x)) ∘ Df(x), ξ(x)⟩ dHⁿ`, a current
supported in `f(spt Y)`; otherwise `push Y = Y`.  This integral is the limit of `Y(ωⱼ)` for one
sequence of test forms `ωⱼ` chosen before the representation, so the formula holds for every
representation of `Y` and is additive in `Y`.  Integrality, `M(push Y) ≤ Lⁿ M(Y)`, `∂ push Y = 0`
if `∂Y = 0`, and `push Y = Y` if `f` fixes `spt Y` follow from the formula.  For admissible `Y₁`,
`Y₂`, `Y₁ - Y₂` is admissible since `spt(Y₁ - Y₂) ⊆ spt Y₁ ∪ spt Y₂`. -/
theorem Submission.dimred_mbl_pushforward : ∀ (P m : ℕ) (O : Set (Euclid P)) (f : Euclid P → Euclid P) (L : ℝ), IsOpen O → ContDiffOn ℝ 1 f O → (∀ y ∈ O, ‖fderiv ℝ f y‖ ≤ L) → ∃ push : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1) → GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), (∀ (Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : IMRep (univ : Set (Euclid P)) (m + 1)), R.Represents Y → IsCompact Y.support → Y.support ⊆ O → (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), push Y ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) (m + 1)) (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[m + 1]) ∧ IsIntegerMultiplicity (push Y) ∧ (push Y).support ⊆ f '' Y.support ∧ (push Y).mass ≤ ENNReal.ofReal (L ^ (m + 1)) * Y.mass ∧ (Y.boundary = 0 → (push Y).boundary = 0) ∧ ((∀ y ∈ Y.support, f y = y) → push Y = Y)) ∧ ∀ Y₁ Y₂ : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Y₁ → IsIntegerMultiplicity Y₂ → IsCompact Y₁.support → Y₁.support ⊆ O → IsCompact Y₂.support → Y₂.support ⊆ O → push (Y₁ - Y₂) = push Y₁ - push Y₂ := by
  intro P m O f L hO hf hL
  classical
  -- Step 1 (carrier_facts): `Hⁿ(M \ spt Y) = 0`, `spt Y` closed, `spt(Y₁ - Y₂) ⊆ spt Y₁ ∪ spt Y₂`
  have hcar := Submission.dimred_mbl_pf_imrep_carrier_mass_support P (m + 1)
  -- Step 3 (pf_current): for admissible `Y` and a representation `R` of `Y`, the push-forward
  -- formula defines a current supported in `f(spt Y)`
  have hex : ∀ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1),
      IsIntegerMultiplicity Y ∧ IsCompact Y.support ∧ Y.support ⊆ O →
        ∃ (Z : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1))
          (R : IMRep (univ : Set (Euclid P)) (m + 1)), R.Represents Y ∧
          (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), Z ω = ∫ x in R.carrier,
            (R.mult x : ℝ) * R.orient x
              (((ω : DifferentialForm (Euclid P) (m + 1)) (f x)).compContinuousLinearMap
                (fderiv ℝ f x)) ∂μHE[m + 1]) ∧ Z.support ⊆ f '' Y.support := by
    rintro Y ⟨⟨R, hR⟩, hK, hKO⟩
    obtain ⟨Z, hZ, -, hZs⟩ := Submission.dimred_mbl_pf_pushforward_current_exists P (m + 1) univ
      Y.support O R f isOpen_univ hK (subset_univ _) (hcar.1 Y R hR).1 hO hKO hf (subset_univ _)
    exact ⟨Z, R, hR, hZ, hZs⟩
  -- `push Y` is that current if `Y` is admissible, and `Y` otherwise
  obtain ⟨push, hpush⟩ : ∃ push : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1) →
      GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), ∀ Y
        (h : IsIntegerMultiplicity Y ∧ IsCompact Y.support ∧ Y.support ⊆ O),
          push Y = Classical.choose (hex Y h) :=
    ⟨fun Y => if h : IsIntegerMultiplicity Y ∧ IsCompact Y.support ∧ Y.support ⊆ O then
      Classical.choose (hex Y h) else Y, fun Y h => dite_eq_left h⟩
  have hspec : ∀ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1),
      IsIntegerMultiplicity Y → IsCompact Y.support → Y.support ⊆ O →
        ∃ R₀ : IMRep (univ : Set (Euclid P)) (m + 1), R₀.Represents Y ∧
          (∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), push Y ω = ∫ x in R₀.carrier,
            (R₀.mult x : ℝ) * R₀.orient x
              (((ω : DifferentialForm (Euclid P) (m + 1)) (f x)).compContinuousLinearMap
                (fderiv ℝ f x)) ∂μHE[m + 1]) ∧ (push Y).support ⊆ f '' Y.support := by
    intro Y hY hK hKO
    rw [hpush Y ⟨hY, hK, hKO⟩]
    exact Classical.choose_spec (hex Y ⟨hY, hK, hKO⟩)
  -- Step 2 (extension): the formula holds for every representation `R` of `Y`, both integrals
  -- being limits of `Y(ωⱼ)` for one sequence of test forms `ωⱼ`
  have hformula : ∀ (Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1))
      (R : IMRep (univ : Set (Euclid P)) (m + 1)), R.Represents Y → IsCompact Y.support →
        Y.support ⊆ O → ∀ ω : TestFormOn (univ : Set (Euclid P)) (m + 1), push Y ω =
          ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x
            (((ω : DifferentialForm (Euclid P) (m + 1)) (f x)).compContinuousLinearMap
              (fderiv ℝ f x)) ∂μHE[m + 1] := by
    intro Y R hR hK hKO ω
    obtain ⟨R₀, hR₀, hZ, -⟩ := hspec Y ⟨R, hR⟩ hK hKO
    obtain ⟨ωs, hωs⟩ := Submission.dimred_mbl_pf_pullback_integral_extension P (m + 1) O
      Y.support f ω hO hf hK hKO
    rw [hZ ω]
    exact tendsto_nhds_unique (hωs Y R₀ hR₀ subset_rfl) (hωs Y R hR subset_rfl)
  refine ⟨push, fun Y R hR hK hKO => ?_, fun Y₁ Y₂ hY₁ hY₂ hK₁ hKO₁ hK₂ hKO₂ => ?_⟩
  · -- (A) for an admissible `Y = τ(M, θ, ξ)`
    obtain ⟨-, -, -, hsupp⟩ := hspec Y ⟨R, hR⟩ hK hKO
    have hF := hformula Y R hR hK hKO
    have hnull : μHE[m + 1] (R.carrier \ Y.support) = 0 := (hcar.1 Y R hR).1
    refine ⟨hF, ?_, hsupp, ?_, fun hbd => ?_, fun hfix => ?_⟩
    · -- (ii) integrality (pf_integer), with (TL) from im_calculus (a)
      refine Submission.dimred_mbl_pf_pushforward_isIntegerMultiplicity
        (fun P' n' U' A B hU' hA hB hAB hBU hfin => ?_) P (m + 1) univ Y.support O R f (push Y)
        isOpen_univ (Nat.succ_pos m) hK (subset_univ _) hnull hO hKO hf (subset_univ _) hF
      filter_upwards [Submission.cmc_imRep_locality_restrict_sub.1 P' n' U' A B hU' hA hB hAB hBU
        hfin] with x hx Q
      exact (hx Q).symm
    · -- (iv) mass (mass_bound)
      exact Submission.dimred_mbl_pf_pushforward_mass_le P (m + 1) O f L Y (push Y) R hL hR hK hKO
        hF
    · -- (v) boundary (pf_boundary)
      exact Submission.dimred_mbl_pf_pushforward_boundaryVanishes P (m + 1) univ Y.support O R f Y
        (push Y) isOpen_univ hK (subset_univ _) hnull hO hKO hf hR hbd hF
    · -- (vi) identity
      exact Submission.dimred_mbl_pf_pushforward_eq_self_of_fix P (m + 1) O f Y (push Y) R hO hf hR
        hKO hfix hF
  · -- (B) `Y₁ - Y₂` is admissible (im_calculus (c), carrier_facts (2)), and the extension along
    -- `spt Y₁ ∪ spt Y₂` makes the formula additive
    obtain ⟨R₁, hR₁⟩ := hY₁
    obtain ⟨R₂, hR₂⟩ := hY₂
    obtain ⟨R, hR⟩ := Submission.cmc_imRep_locality_restrict_sub.2.2.1 P (m + 1) univ Y₁ Y₂
      isOpen_univ ⟨R₁, hR₁⟩ ⟨R₂, hR₂⟩
    have hsub : (Y₁ - Y₂).support ⊆ Y₁.support ∪ Y₂.support := (hcar.2 Y₁ Y₂).2
    have hK : IsCompact (Y₁ - Y₂).support :=
      (hK₁.union hK₂).of_isClosed_subset (hcar.2 (Y₁ - Y₂) Y₂).1 hsub
    have hKO : (Y₁ - Y₂).support ⊆ O := hsub.trans (union_subset hKO₁ hKO₂)
    ext ω
    obtain ⟨ωs, hωs⟩ := Submission.dimred_mbl_pf_pullback_integral_extension P (m + 1) O
      (Y₁.support ∪ Y₂.support) f ω hO hf (hK₁.union hK₂) (union_subset hKO₁ hKO₂)
    show push (Y₁ - Y₂) ω = push Y₁ ω - push Y₂ ω
    rw [hformula (Y₁ - Y₂) R hR hK hKO ω, hformula Y₁ R₁ hR₁ hK₁ hKO₁ ω,
      hformula Y₂ R₂ hR₂ hK₂ hKO₂ ω]
    exact tendsto_nhds_unique (hωs (Y₁ - Y₂) R hR hsub)
      ((hωs Y₁ R₁ hR₁ subset_union_left).sub (hωs Y₂ R₂ hR₂ subset_union_right))
/-- **Locally bounded masses of blow-ups at moving centres** (scaling identity (1) and the bound
`sup_j M_{B_R(0)}(η_{x,λⱼ#}T) < ∞` in the proof of Simon 7.3.1, chapter-07.txt lines 326–335, here
with moving centres `xⱼ → x`): if `T = τ(M, θ, ξ)` in the open set `U` satisfies the monotonicity
inequality on every compact `K ⊆ U`, `xⱼ → x ∈ U`, `λⱼ > 0` and `λⱼ → 0`, then for every `R` the
masses `M_{B_R(0)}(η_{xⱼ,λⱼ#}T)` are bounded for all large `j`.  Fix `r > 0` with
`B̄_{2r}(x) ⊆ U`; `M_{B_{2r}(x)}(T) = μ_T(B_{2r}(x)) < ∞` by the local integrability of `θ`
(`Submission.dor_imrep_massOn_eq_measure_and_support`).  Monotonicity between `ρ` and `r/2` on
balls centred at `y`, `|y − x| < r`, gives `M_{B_ρ(y)}(T) ≤ ρⁿ c₁` for `0 < ρ < r/2`, where
`c₁ = e^{Λr}(2/r)ⁿ M_{B_{2r}(x)}(T)`.  For large `j`, `η_{xⱼ,λⱼ}(B_{λⱼR'}(xⱼ)) = B_{R'}(0)` with
`R' = max(R, 1)`, and mass scaling (`Submission.dtc_blowUp_massOn_image`) gives
`M_{B_R(0)}(η_{xⱼ,λⱼ#}T) ≤ λⱼ⁻ⁿ (λⱼR')ⁿ c₁ = R'ⁿ c₁`. -/
theorem Submission.dimred_mbl_bh_moving_blowUp_mass_bound : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity T → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ∃ Λ : ℝ, 0 ≤ Λ ∧ ∀ (y : Euclid P) (R : ℝ), closedBall y R ⊆ K → MonotoneOn (fun ρ : ℝ => ENNReal.ofReal (Real.exp (Λ * ρ) / ρ ^ n) * T.massOn (ball y ρ)) (Ioo 0 R)) → ∀ (x : Euclid P) (xs : ℕ → Euclid P) (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), x ∈ U → Tendsto xs atTop (𝓝 x) → Tendsto lams atTop (𝓝 0) → ∀ R : ℝ, ∃ c : ℝ≥0∞, c ≠ ∞ ∧ ∀ᶠ j in atTop, (blowUp T (xs j) (lams j) (hlams j).ne').massOn (ball 0 R) ≤ c := by
  intro P n U T hU hIM hmon x xs lams hlams hxU hxs hlam0 R
  -- `η_{a,λ}(y) = λ⁻¹ • (y - a)`
  have hdil : ∀ (a : Euclid P) (lam : ℝ) (y : Euclid P), dilation a lam y = lam⁻¹ • (y - a) := by
    intro a lam y
    simp only [dilation, dilationCLM, FunLike.coe_smul, Pi.smul_apply,
      ContinuousLinearMap.coe_id', id_eq, smul_sub]
    abel
  -- Step 0: a radius `r` with `closedBall x (2r) ⊆ U`
  obtain ⟨ε, hε, hεU⟩ := Metric.isOpen_iff.1 hU x hxU
  set r := ε / 3 with hr_def
  have hr : 0 < r := by positivity
  have hK : closedBall x (2 * r) ⊆ U := by
    intro y hy
    apply hεU
    rw [mem_ball]
    rw [mem_closedBall] at hy
    linarith
  have hKc : IsCompact (closedBall x (2 * r)) := isCompact_closedBall x (2 * r)
  -- Step 1: monotonicity on `K = closedBall x (2r)`
  obtain ⟨Λ, hΛ, hmono⟩ := hmon _ hKc hK
  -- Step 2: `M_{B_{2r}(x)}(T) < ∞`
  obtain ⟨Rep, hRep⟩ := hIM
  have hfin : T.massOn (ball x (2 * r)) ≠ ∞ := by
    rw [(Submission.dor_imrep_massOn_eq_measure_and_support P n U T Rep hU hRep).1 _ isOpen_ball]
    have h1 : Rep.measure (ball x (2 * r)) ≤ Rep.measure (closedBall x (2 * r)) :=
      measure_mono ball_subset_closedBall
    have h2 : Rep.measure (closedBall x (2 * r)) =
        ∫⁻ y in Rep.carrier ∩ closedBall x (2 * r), (Rep.mult y : ℝ≥0∞) ∂μHE[n] := by
      unfold IMRep.measure
      rw [withDensity_apply _ measurableSet_closedBall,
        Measure.restrict_restrict measurableSet_closedBall, inter_comm]
    have h3 := Rep.locallyIntegrable_mult _ hKc hK
    rw [← h2] at h3
    exact ne_top_of_le_ne_top h3 h1
  -- Step 3: the constant `c₁`
  set c₁ : ℝ≥0∞ := ENNReal.ofReal (Real.exp (Λ * r) * (2 / r) ^ n) * T.massOn (ball x (2 * r))
    with hc₁_def
  have hc₁ : c₁ ≠ ∞ := ENNReal.mul_ne_top ENNReal.ofReal_ne_top hfin
  -- Step 4: `M_{B_ρ(y)}(T) ≤ ρⁿ c₁` for `|y - x| < r`, `0 < ρ < r/2`
  have hkey : ∀ y : Euclid P, dist y x < r → ∀ ρ : ℝ, 0 < ρ → ρ < r / 2 →
      T.massOn (ball y ρ) ≤ ENNReal.ofReal (ρ ^ n) * c₁ := by
    intro y hy ρ hρ hρr
    have hKy : closedBall y r ⊆ closedBall x (2 * r) := by
      intro z hz
      rw [mem_closedBall] at hz ⊢
      linarith [dist_triangle z y x]
    have hρmem : ρ ∈ Ioo 0 r := ⟨hρ, by linarith⟩
    have hr2mem : r / 2 ∈ Ioo 0 r := ⟨by positivity, by linarith⟩
    have hle := hmono y r hKy hρmem hr2mem hρr.le
    have hball : ball y (r / 2) ⊆ ball x (2 * r) := by
      intro z hz
      rw [mem_ball] at hz ⊢
      linarith [dist_triangle z y x]
    have hM : T.massOn (ball y (r / 2)) ≤ T.massOn (ball x (2 * r)) := T.massOn_mono hball
    have hcoef : ENNReal.ofReal (Real.exp (Λ * (r / 2)) / (r / 2) ^ n) ≤
        ENNReal.ofReal (Real.exp (Λ * r) * (2 / r) ^ n) := by
      apply ENNReal.ofReal_le_ofReal
      rw [div_eq_mul_inv, ← inv_pow, inv_div]
      gcongr
      nlinarith
    have h1 : ENNReal.ofReal (Real.exp (Λ * ρ) / ρ ^ n) * T.massOn (ball y ρ) ≤ c₁ :=
      hle.trans (mul_le_mul' hcoef hM)
    have hexp : 1 ≤ Real.exp (Λ * ρ) := Real.one_le_exp (by positivity)
    have h2 : ENNReal.ofReal ((ρ ^ n)⁻¹) * T.massOn (ball y ρ) ≤ c₁ := by
      refine le_trans (mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl) h1
      rw [div_eq_mul_inv]
      have : 0 < (ρ ^ n)⁻¹ := by positivity
      nlinarith
    calc T.massOn (ball y ρ)
        = ENNReal.ofReal (ρ ^ n) * (ENNReal.ofReal ((ρ ^ n)⁻¹) * T.massOn (ball y ρ)) := by
          rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity),
            mul_inv_cancel₀ (by positivity), ENNReal.ofReal_one, one_mul]
      _ ≤ ENNReal.ofReal (ρ ^ n) * c₁ := mul_le_mul' le_rfl h2
  -- Step 5: rescale
  set R' := max R 1 with hR'_def
  have hR' : 0 < R' := lt_of_lt_of_le one_pos (le_max_right _ _)
  refine ⟨ENNReal.ofReal (R' ^ n) * c₁, ENNReal.mul_ne_top ENNReal.ofReal_ne_top hc₁, ?_⟩
  have hev1 : ∀ᶠ j in atTop, dist (xs j) x < r := Metric.tendsto_nhds.1 hxs r hr
  have hev2 : ∀ᶠ j in atTop, lams j * R' < r / 2 := by
    have h0 : Tendsto (fun j => lams j * R') atTop (𝓝 0) := by
      simpa using hlam0.mul_const R'
    exact (tendsto_order.1 h0).2 (r / 2) (by positivity)
  filter_upwards [hev1, hev2] with j hj1 hj2
  have hlam := hlams j
  have himg : dilation (xs j) (lams j) '' ball (xs j) (lams j * R') = ball 0 R' := by
    ext z
    constructor
    · rintro ⟨y, hy, rfl⟩
      rw [mem_ball, dist_zero_right, hdil, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hlam.le),
        ← dist_eq_norm]
      rw [mem_ball] at hy
      calc (lams j)⁻¹ * dist y (xs j) < (lams j)⁻¹ * (lams j * R') :=
            mul_lt_mul_of_pos_left hy (inv_pos.2 hlam)
        _ = R' := by field_simp
    · intro hz
      refine ⟨xs j + lams j • z, ?_, ?_⟩
      · rw [mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hlam.le]
        rw [mem_ball, dist_zero_right] at hz
        exact mul_lt_mul_of_pos_left hz hlam
      · rw [hdil, add_sub_cancel_left, smul_smul, inv_mul_cancel₀ hlam.ne', one_smul]
  calc (blowUp T (xs j) (lams j) (hlams j).ne').massOn (ball 0 R)
      ≤ (blowUp T (xs j) (lams j) (hlams j).ne').massOn (ball 0 R') :=
        GeometricCurrentOn.massOn_mono _ (ball_subset_ball (le_max_left _ _))
    _ = (blowUp T (xs j) (lams j) (hlams j).ne').massOn
          (dilation (xs j) (lams j) '' ball (xs j) (lams j * R')) := by rw [himg]
    _ = ENNReal.ofReal ((lams j)⁻¹ ^ n) * T.massOn (ball (xs j) (lams j * R')) :=
        Submission.dtc_blowUp_massOn_image P n U T (xs j) (lams j) (hlams j) _
    _ ≤ ENNReal.ofReal ((lams j)⁻¹ ^ n) * (ENNReal.ofReal ((lams j * R') ^ n) * c₁) :=
        mul_le_mul' le_rfl (hkey _ hj1 _ (by positivity) hj2)
    _ = ENNReal.ofReal (R' ^ n) * c₁ := by
        rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity), ← mul_pow,
          inv_mul_cancel_left₀ hlam.ne']
/-- **Rescaled retractions at moving centres** (Simon 7.2.5(2), rescaled as in the proof of
7.3.1).  Let `xⱼ → x ∈ U`, `λⱼ > 0`, `λⱼ → 0` and `Aⱼ = η_{xⱼ,λⱼ}(U ∩ N)`.  If `x ∉ N`, then
`x ∉ N̄` (as `(N̄ \ N) ∩ U = ∅`), so `Aⱼ ∩ B_G(0) = ∅` for all large `j`.  If `x ∈ N`, the local
retraction `π` onto `N` at `x` rescales to `πⱼ = η_{xⱼ,λⱼ} ∘ π ∘ (z ↦ xⱼ + λⱼz)`: for all large
`j` it is `C¹` on `B_G(0)`, is the identity on `Aⱼ ∩ B_G(0)`, maps `B_G(0)` into `Aⱼ ∩ B_{5G}(0)`
(by the `2`-Lipschitz bound of `π` near `x`, once `Aⱼ ∩ B_G(0) ≠ ∅`), and is `(1 + η)`-Lipschitz
on `B_G(0)`, since `π` is `(1 + η)`-Lipschitz on `B_{s(η)}(x)`. -/
theorem Submission.dimred_mbl_bh_moving_rescaled_retractions : ∀ (P : ℕ) (U N : Set (Euclid P)) (x : Euclid P) (xs : ℕ → Euclid P) (lams : ℕ → ℝ), IsOpen U → (closure N \ N) ∩ U = ∅ → x ∈ U → (x ∈ N → ∃ (δ : ℝ) (π : Euclid P → Euclid P), 0 < δ ∧ ContDiffOn ℝ 1 π (ball x δ) ∧ MapsTo π (ball x δ) N ∧ (∀ y ∈ N ∩ ball x δ, π y = y) ∧ ∀ η : ℝ, 0 < η → ∃ s : ℝ, 0 < s ∧ s ≤ δ ∧ ∀ y ∈ ball x s, ∀ z ∈ ball x s, ‖π y - π z‖ ≤ (1 + η) * ‖y - z‖) → (∀ j, 0 < lams j) → Tendsto xs atTop (𝓝 x) → Tendsto lams atTop (𝓝 0) → ∀ G : ℝ, 0 < G → ∃ (πs : ℕ → Euclid P → Euclid P) (G' : ℝ), (∀ᶠ j in atTop, dilation (xs j) (lams j) '' (U ∩ N) ∩ ball 0 G = ∅ ∨ (ContDiffOn ℝ 1 (πs j) (ball 0 G) ∧ MapsTo (πs j) (ball 0 G) (dilation (xs j) (lams j) '' (U ∩ N) ∩ ball 0 G') ∧ ∀ y ∈ dilation (xs j) (lams j) '' (U ∩ N) ∩ ball 0 G, πs j y = y)) ∧ ∀ η : ℝ, 0 < η → ∀ᶠ j in atTop, dilation (xs j) (lams j) '' (U ∩ N) ∩ ball 0 G = ∅ ∨ ∀ y ∈ ball 0 G, ∀ z ∈ ball 0 G, ‖πs j y - πs j z‖ ≤ (1 + η) * ‖y - z‖ := by
  intro P U N x xs lams hU hcl hxU hret hlams hxs hlam0 G hG
  -- Step 1(a): `η_{a,λ}(y) = λ⁻¹ • (y - a)`
  have hdil : ∀ (a : Euclid P) (lam : ℝ) (y : Euclid P), dilation a lam y = lam⁻¹ • (y - a) := by
    intro a lam y
    simp only [dilation, dilationCLM, FunLike.coe_smul, Pi.smul_apply,
      ContinuousLinearMap.coe_id', id_eq, smul_sub]
    abel
  -- Step 1(a): `z ∈ η_{a,λ}(S) ↔ a + λ z ∈ S`
  have hmem_img : ∀ (a : Euclid P) (lam : ℝ) (S : Set (Euclid P)) (z : Euclid P), lam ≠ 0 →
      (z ∈ dilation a lam '' S ↔ a + lam • z ∈ S) := by
    intro a lam S z hlam
    constructor
    · rintro ⟨y, hy, rfl⟩
      rwa [hdil, smul_smul, mul_inv_cancel₀ hlam, one_smul, add_sub_cancel]
    · intro h
      exact ⟨a + lam • z, h, by rw [hdil, add_sub_cancel_left, smul_smul, inv_mul_cancel₀ hlam,
        one_smul]⟩
  -- Step 1(c): `|xⱼ - x| + λⱼ c` is eventually below any positive bound
  have hsmall : ∀ (c t : ℝ), 0 < t → ∀ᶠ j in atTop, dist (xs j) x + lams j * c < t := by
    intro c t ht
    have h1 : Tendsto (fun j => dist (xs j) x) atTop (𝓝 0) :=
      (tendsto_iff_dist_tendsto_zero).1 hxs
    have h2 : Tendsto (fun j => lams j * c) atTop (𝓝 0) := by
      simpa using hlam0.mul_const c
    have h0 : Tendsto (fun j => dist (xs j) x + lams j * c) atTop (𝓝 0) := by
      simpa using h1.add h2
    exact (tendsto_order.1 h0).2 t ht
  -- Step 1(b): `xⱼ + λⱼ z ∈ B_t(x)` for `z ∈ B_G(0)` once `|xⱼ - x| + λⱼ G ≤ t`
  have haff : ∀ (j : ℕ) (z : Euclid P) (t : ℝ), z ∈ ball (0 : Euclid P) G →
      dist (xs j) x + lams j * G ≤ t → xs j + lams j • z ∈ ball x t := by
    intro j z t hz ht
    have hlam := hlams j
    rw [mem_ball, dist_zero_right] at hz
    rw [mem_ball]
    calc dist (xs j + lams j • z) x ≤ dist (xs j + lams j • z) (xs j) + dist (xs j) x :=
          dist_triangle _ _ _
      _ = lams j * ‖z‖ + dist (xs j) x := by
          rw [dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hlam.le]
      _ < lams j * G + dist (xs j) x := by
          have := mul_lt_mul_of_pos_left hz hlam
          linarith
      _ ≤ t := by linarith
  by_cases hxN : x ∈ N
  · -- Step 3 (case B, `x ∈ N`): rescale the local retraction at `x`
    obtain ⟨δ, π, hδ, hC, hmaps, hid, hlip⟩ := hret hxN
    obtain ⟨r, hr, hrU⟩ := Metric.isOpen_iff.1 hU x hxU
    obtain ⟨s₁, hs₁, hs₁δ, hlip1⟩ := hlip 1 one_pos
    refine ⟨fun j z => dilation (xs j) (lams j) (π (xs j + lams j • z)), 5 * G, ?_, ?_⟩
    · -- Step 4: the first eventual statement
      filter_upwards [hsmall G s₁ hs₁, hsmall (5 * G) r hr] with j hj1 hj2
      have hlam := hlams j
      by_cases hempty : dilation (xs j) (lams j) '' (U ∩ N) ∩ ball 0 G = ∅
      · exact Or.inl hempty
      right
      obtain ⟨z₀, hz₀A, hz₀G⟩ := Set.nonempty_iff_ne_empty.2 hempty
      have hw : xs j + lams j • z₀ ∈ U ∩ N := (hmem_img _ _ _ _ hlam.ne').1 hz₀A
      have hwball : xs j + lams j • z₀ ∈ ball x s₁ := haff j z₀ s₁ hz₀G hj1.le
      have hπw : π (xs j + lams j • z₀) = xs j + lams j • z₀ :=
        hid _ ⟨hw.2, ball_subset_ball hs₁δ hwball⟩
      have hmapsδ : MapsTo (fun z : Euclid P => xs j + lams j • z) (ball 0 G) (ball x δ) :=
        fun z hz => ball_subset_ball hs₁δ (haff j z s₁ hz hj1.le)
      refine ⟨?_, ?_, ?_⟩
      · -- Step 4(a): `πⱼ` is `C¹` on `B_G(0)`
        have hdilC : ContDiff ℝ 1 (dilation (xs j) (lams j)) := by
          unfold dilation
          exact contDiff_const.add (dilationCLM P (lams j)).contDiff
        have haffC : ContDiff ℝ 1 (fun z : Euclid P => xs j + lams j • z) :=
          contDiff_const.add (contDiff_id.const_smul (lams j))
        exact hdilC.comp_contDiffOn (hC.comp haffC.contDiffOn hmapsδ)
      · -- Step 4(c): `πⱼ` maps `B_G(0)` into `Aⱼ ∩ B_{5G}(0)`
        intro z hz
        have hy1 : xs j + lams j • z ∈ ball x s₁ := haff j z s₁ hz hj1.le
        have hzG : ‖z‖ < G := by simpa using hz
        have hz₀G' : ‖z₀‖ < G := by simpa using hz₀G
        have hbound : ‖π (xs j + lams j • z) - xs j‖ < 5 * (lams j * G) := by
          have hl := hlip1 _ hy1 _ hwball
          rw [hπw] at hl
          have e1 : ‖xs j + lams j • z - (xs j + lams j • z₀)‖ = lams j * ‖z - z₀‖ := by
            rw [add_sub_add_left_eq_sub, ← smul_sub, norm_smul, Real.norm_of_nonneg hlam.le]
          have e2 : ‖xs j + lams j • z₀ - xs j‖ = lams j * ‖z₀‖ := by
            rw [add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hlam.le]
          have hzz : ‖z - z₀‖ < 2 * G := by
            calc ‖z - z₀‖ ≤ ‖z‖ + ‖z₀‖ := norm_sub_le _ _
              _ < 2 * G := by linarith
          have h4 : lams j * ‖z - z₀‖ < lams j * (2 * G) := mul_lt_mul_of_pos_left hzz hlam
          have h5 : lams j * ‖z₀‖ < lams j * G := mul_lt_mul_of_pos_left hz₀G' hlam
          calc ‖π (xs j + lams j • z) - xs j‖
              ≤ ‖π (xs j + lams j • z) - (xs j + lams j • z₀)‖ + ‖xs j + lams j • z₀ - xs j‖ :=
                norm_sub_le_norm_sub_add_norm_sub _ _ _
            _ ≤ (1 + 1) * (lams j * ‖z - z₀‖) + lams j * ‖z₀‖ := by
                rw [e2, ← e1]
                linarith
            _ < 5 * (lams j * G) := by nlinarith
        have hπyU : π (xs j + lams j • z) ∈ U := by
          apply hrU
          rw [mem_ball, dist_eq_norm]
          calc ‖π (xs j + lams j • z) - x‖
              ≤ ‖π (xs j + lams j • z) - xs j‖ + ‖xs j - x‖ :=
                norm_sub_le_norm_sub_add_norm_sub _ _ _
            _ < 5 * (lams j * G) + dist (xs j) x := by
                rw [← dist_eq_norm (xs j) x]
                linarith
            _ < r := by linarith
        have hπyN : π (xs j + lams j • z) ∈ N := hmaps (hmapsδ hz)
        refine ⟨⟨π (xs j + lams j • z), ⟨hπyU, hπyN⟩, rfl⟩, ?_⟩
        show dilation (xs j) (lams j) (π (xs j + lams j • z)) ∈ ball 0 (5 * G)
        rw [mem_ball, dist_zero_right, hdil, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hlam.le)]
        calc (lams j)⁻¹ * ‖π (xs j + lams j • z) - xs j‖
            < (lams j)⁻¹ * (5 * (lams j * G)) :=
              mul_lt_mul_of_pos_left hbound (inv_pos.2 hlam)
          _ = 5 * G := by field_simp
      · -- Step 4(b): `πⱼ` is the identity on `Aⱼ ∩ B_G(0)`
        rintro z ⟨hzA, hz⟩
        have hu : xs j + lams j • z ∈ U ∩ N := (hmem_img _ _ _ _ hlam.ne').1 hzA
        show dilation (xs j) (lams j) (π (xs j + lams j • z)) = z
        rw [hid _ ⟨hu.2, hmapsδ hz⟩, hdil, add_sub_cancel_left, smul_smul,
          inv_mul_cancel₀ hlam.ne', one_smul]
    · -- Step 5: the almost-isometry estimate
      intro η hη
      obtain ⟨s, hs, hsδ, hlipη⟩ := hlip η hη
      filter_upwards [hsmall G s hs] with j hj
      right
      intro y hy z hz
      have hlam := hlams j
      have hy' := haff j y s hy hj.le
      have hz' := haff j z s hz hj.le
      show ‖dilation (xs j) (lams j) (π (xs j + lams j • y)) -
          dilation (xs j) (lams j) (π (xs j + lams j • z))‖ ≤ (1 + η) * ‖y - z‖
      rw [hdil, hdil, ← smul_sub, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hlam.le)]
      have h1 := hlipη _ hy' _ hz'
      have h2 : ‖xs j + lams j • y - (xs j + lams j • z)‖ = lams j * ‖y - z‖ := by
        rw [add_sub_add_left_eq_sub, ← smul_sub, norm_smul, Real.norm_of_nonneg hlam.le]
      have h3 : π (xs j + lams j • y) - xs j - (π (xs j + lams j • z) - xs j) =
          π (xs j + lams j • y) - π (xs j + lams j • z) := by abel
      rw [h3]
      calc (lams j)⁻¹ * ‖π (xs j + lams j • y) - π (xs j + lams j • z)‖
          ≤ (lams j)⁻¹ * ((1 + η) * (lams j * ‖y - z‖)) := by
            rw [← h2]
            exact mul_le_mul_of_nonneg_left h1 (inv_nonneg.2 hlam.le)
        _ = (1 + η) * ‖y - z‖ := by field_simp
  · -- Step 2 (case A, `x ∉ N`): `x ∉ N̄`, so `Aⱼ ∩ B_G(0) = ∅` eventually
    have hxcl : x ∉ closure N := by
      intro h
      have : x ∈ (closure N \ N) ∩ U := ⟨⟨h, hxN⟩, hxU⟩
      rw [hcl] at this
      exact this
    obtain ⟨ε, hε, hεN⟩ := Metric.isOpen_iff.1 isClosed_closure.isOpen_compl x hxcl
    have hev : ∀ᶠ j in atTop, dilation (xs j) (lams j) '' (U ∩ N) ∩ ball 0 G = ∅ := by
      filter_upwards [hsmall G ε hε] with j hj
      rw [Set.eq_empty_iff_forall_notMem]
      rintro z ⟨hzA, hz⟩
      have hu : xs j + lams j • z ∈ U ∩ N := (hmem_img _ _ _ _ (hlams j).ne').1 hzA
      exact hεN (haff j z ε hz hj.le) (subset_closure hu.2)
    refine ⟨fun _ => id, 0, ?_, ?_⟩
    · filter_upwards [hev] with j hj
      exact Or.inl hj
    · intro η _
      filter_upwards [hev] with j hj
      exact Or.inl hj
/-- Local `C¹` retraction onto `N` (moving blow-ups in the dimension reduction results; it replaces
the nearest-point projection of Simon 7.2.5(2)), left inverse step: an injective continuous linear
map `L : ℝᵈ → ℝᴾ` has a continuous linear left inverse `A` with `‖L ∘ A‖ ≤ 1`.  With `Q = L(ℝᵈ)`,
`p : ℝᴾ → Q` the orthogonal projection and `e : ℝᵈ ≃ Q` induced by `L`, take `A = e⁻¹ ∘ p`; then
`A ∘ L = id`, and `L ∘ A` is the orthogonal projection onto `Q`, of norm `≤ 1`. -/
theorem Submission.dimred_mbl_bh_lr_left_inverse_projection : ∀ (P d : ℕ) (L : Euclid d →L[ℝ] Euclid P), Injective L → ∃ A : Euclid P →L[ℝ] Euclid d, A.comp L = ContinuousLinearMap.id ℝ (Euclid d) ∧ ‖L.comp A‖ ≤ 1 := by
  intro P d L hL
  -- Step 1: `Q := L(ℝᵈ)` is finite-dimensional, so the orthogonal projection `p : ℝᴾ → Q` exists
  let Q : Submodule ℝ (Euclid P) := LinearMap.range (L : Euclid d →ₗ[ℝ] Euclid P)
  -- Step 2: `e : ℝᵈ ≃ Q`, `e w = L w`, is a continuous linear equivalence (finite dimensions)
  let e : Euclid d ≃L[ℝ] Q :=
    (LinearEquiv.ofInjective (L : Euclid d →ₗ[ℝ] Euclid P) hL).toContinuousLinearEquiv
  -- Step 3: `A := e⁻¹ ∘ p`
  refine ⟨(e.symm : Q →L[ℝ] Euclid d).comp Q.orthogonalProjectionOnto, ?_, ?_⟩
  · -- Step 4: `p(L w) = e w` since `p` fixes `Q`, so `A(L w) = e⁻¹(e w) = w`
    ext1 w
    have hp : Q.orthogonalProjectionOnto (L w) = e w :=
      Q.orthogonalProjectionOnto_mem_subspace_eq_self (e w)
    rw [ContinuousLinearMap.comp_apply, ContinuousLinearMap.comp_apply, hp,
      ContinuousLinearEquiv.coe_coe, e.symm_apply_apply, ContinuousLinearMap.id_apply]
  · -- Step 5: `L(A y) = ι(e(e⁻¹(p y))) = ι(p y)`, i.e. `L ∘ A = ι ∘ p = Q.starProjection`
    have hLA : L.comp ((e.symm : Q →L[ℝ] Euclid d).comp Q.orthogonalProjectionOnto) =
        Q.starProjection := by
      ext1 y
      exact congrArg Subtype.val (e.apply_symm_apply (Q.orthogonalProjectionOnto y))
    -- Step 6: `‖L ∘ A‖ = ‖Q.starProjection‖ ≤ 1`
    rw [hLA]
    exact Q.starProjection_norm_le
/-- **Foundations of the closure step** (Simon Ch. 6, 2.7–2.8, 2.35–2.37, 3.1, 8.3; Ch. 1, 4.4).
(REP): a current `T` with locally finite mass is `T(ω) = ∫ ⟨ω, ξ⟩ dμ` with `μ(W) = M_W(T)` and
`|ξ| ≤ 1` (`dimred_mbl_fnd_exists_massRepresentation_core`); if `∂T` also has locally finite
mass, then `μ ≪ Hⁿ` for this same `(μ, ξ)` (`dimred_mbl_fnd_null_of_representation`).
(T1): measures with locally bounded masses have a vaguely convergent subsequence
(`cbr_vague_convergent_subseq`); its limit is a Radon measure on `U`
(`cbr_vague_limit_measure`) satisfying the portmanteau inequalities (`cbr_vague_portmanteau`).
(T2) and (MM) are `cbr_sublevel_restriction_tendsto` and `cbr_slice_mass_majorant`.
(IML): restriction to an open `V ⊆ U` preserves integer multiplicity
(`dtc_restrictDomain_isIntegerMultiplicity`).  Conversely, assume (REP), (MR) and (IMC), and
write `X = ξ·μ` by (REP).  Let `R` represent `X⌞B` on a ball `B ⊆ U`.  For `G ⊆ B`, `X` and
`X⌞B` have the same admissible forms for `M_G`.  So `μ(G) = M_G(X) = M_G(X⌞B) = μ_R(G)` for
open `G ⊆ B` by (MR), and `μ⌞B = μ_R` (`cmc_ml_measure_eq_of_eq_on_open_subsets`; `μ_R` lives
on `M_R ⊆ B`).  Both `ξ·μ` and `ξ_R·μ_R` represent `X⌞B`.  Hence their set integrals agree
(`cbr_setIntegral_eq_of_integral_eq`), so `ξ = ξ_R` `μ`-a.e. on `B`
(`cbr_orient_ae_eq_of_setIntegral_eq`).  The local triples then glue
(`cbr_isIntegerMultiplicity_of_local_reps`). -/
theorem Submission.dtc_bc_tc_cl_foundations : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) ∧ ((∀ (P : ℕ) (U : Set (Euclid P)) (μs : ℕ → Measure (Euclid P)), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ⨆ j, μs j K < ∞) → ∃ (φ : ℕ → ℕ) (μ : Measure (Euclid P)), StrictMono φ ∧ μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → tsupport f ⊆ U → Tendsto (fun j => ∫ x, f x ∂(μs (φ j))) atTop (𝓝 (∫ x, f x ∂μ))) ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → limsup (fun j => μs (φ j) K) atTop ≤ μ K) ∧ (∀ G : Set (Euclid P), IsOpen G → G ⊆ U → μ G ≤ liminf (fun j => μs (φ j) G) atTop)) ∧ (∀ (P k : ℕ) (U : Set (Euclid P)) (Xs : ℕ → GeometricCurrentOn U k) (X : GeometricCurrentOn U k) (μs : ℕ → Measure (Euclid P)) (ξs : ℕ → Euclid P → MultiVector P k) (μX μ : Measure (Euclid P)) (ξX : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (t : ℝ), IsOpen U → Continuous f → WeaklyConvergesOn Xs X → (∀ j, ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μs j K < ∞) → (∀ j, AEStronglyMeasurable (ξs j) (μs j)) → (∀ j, ∀ᵐ x ∂(μs j), ∀ α : Covector (Euclid P) k, |ξs j x α| ≤ covectorEuclideanNorm α) → (∀ j, ∀ ω : TestFormOn U k, Xs j ω = ∫ x, ξs j x ((ω : DifferentialForm (Euclid P) k) x) ∂(μs j)) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μX K < ∞) → AEStronglyMeasurable ξX μX → (∀ᵐ x ∂μX, ∀ α : Covector (Euclid P) k, |ξX x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U k, X ω = ∫ x, ξX x ((ω : DifferentialForm (Euclid P) k) x) ∂μX) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → limsup (fun j => μs j K) atTop ≤ μ K) → μ {x | f x = t} = 0 → ∀ ω : TestFormOn U k, Tendsto (fun j => ∫ x in {x | f x < t}, ξs j x ((ω : DifferentialForm (Euclid P) k) x) ∂(μs j)) atTop (𝓝 (∫ x in {x | f x < t}, ξX x ((ω : DifferentialForm (Euclid P) k) x) ∂μX))) ∧ (∀ (P : ℕ) (μs : ℕ → Measure (Euclid P)) (f : Euclid P → ℝ) (G : Set (Euclid P)) (a b : ℝ) (L : NNReal) (Z : ℕ → ℝ → ℝ≥0∞), Continuous f → (∀ j, μs j (G ∩ {x | a < f x ∧ f x < b}) < ∞) → (∀ (j : ℕ) (t : ℝ), t ∈ Ioo a b → Z j t ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μs j (G ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) → ∃ g : ℝ → ℝ≥0∞, Measurable g ∧ (∀ᵐ t ∂(volume : Measure ℝ), t ∈ Ioo a b → liminf (fun j => Z j t) atTop ≤ g t) ∧ ∫⁻ t in Ioo a b, g t ≤ (L : ℝ≥0∞) * liminf (fun j => μs j (G ∩ {x | a < f x ∧ f x < b})) atTop)) ∧ ((∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (P k : ℕ) (U : Set (Euclid P)) (X : GeometricCurrentOn U k), IsOpen U → ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → X.massOn W < ∞) → (∀ x ∈ U, ∃ r : ℝ, 0 < r ∧ ∃ h : ball x r ⊆ U, IsIntegerMultiplicity (X.restrictDomain h)) → IsIntegerMultiplicity X) ∧ (∀ (V : Set (Euclid P)) (h : V ⊆ U), IsOpen V → IsIntegerMultiplicity X → IsIntegerMultiplicity (X.restrictDomain h))) := by
  refine ⟨?_, ⟨?_, Submission.cbr_sublevel_restriction_tendsto,
    Submission.cbr_slice_mass_majorant⟩, ?_⟩
  · -- (REP): the representation core, then absolute continuity for the same `(μ, ξ)`
    intro P n U T hU hmass
    obtain ⟨μ, ξ, hμU, hμK, hμW, hξ, hξα, hTξ⟩ :=
      Submission.dimred_mbl_fnd_exists_massRepresentation_core P n U T hU hmass
    exact ⟨μ, ξ, hμU, hμK, hμW, hξ, hξα, hTξ, fun hbd =>
      Submission.dimred_mbl_fnd_null_of_representation P n U T μ ξ hU hbd hμU hμK hμW hξ hξα
        hTξ⟩
  · -- (T1): a vaguely convergent subsequence, its limit measure and the portmanteau inequalities
    intro P U μs hU hbound
    obtain ⟨φ, hφ, hconv⟩ := Submission.cbr_vague_convergent_subseq P U μs hU hbound
    -- `μ_{φ(j)}(K) ≤ ⨆ᵢ μᵢ(K) < ∞` for compact `K ⊆ U`
    have hfin : ∀ (j : ℕ) (K : Set (Euclid P)), IsCompact K → K ⊆ U → μs (φ j) K < ∞ :=
      fun j K hK hKU => (le_iSup (fun i => μs i K) (φ j)).trans_lt (hbound K hK hKU)
    obtain ⟨μ, hμU, hμK, hμconv⟩ :=
      Submission.cbr_vague_limit_measure P U (fun j => μs (φ j)) hU hfin hconv
    obtain ⟨hlimsup, hliminf⟩ :=
      Submission.cbr_vague_portmanteau P U (fun j => μs (φ j)) μ hU hfin hμK hμconv
    exact ⟨φ, μ, hφ, hμU, hμK, hμconv, hlimsup, hliminf⟩
  · -- (IML)
    intro hREP hMR hIMC P k U X hU
    -- (2): restriction to an open `V ⊆ U` preserves integer multiplicity
    refine ⟨fun hmass hloc => ?_, fun V hVU hV hX =>
      Submission.dtc_restrictDomain_isIntegerMultiplicity P k U V hVU X hV hX⟩
    -- (1), Step 1: `X = ξ·μ` with `μ(W) = M_W(X)` by (REP); it suffices to give local triples
    obtain ⟨μ, ξ, hμU, hμK, hμmass, hξmeas, hξbound, hXrep, -⟩ := hREP P k U X hU hmass
    refine Submission.cbr_isIntegerMultiplicity_of_local_reps hIMC.1 P k U X μ ξ hU hμU hμK
      hξmeas hXrep fun x hx => ?_
    -- Step 2: a ball `B = B_r(x) ⊆ U` and a triple `R` representing `X⌞B`
    obtain ⟨r, hr, hB, R, hR⟩ := hloc x hx
    obtain ⟨hRac, -, -, hRcompl, hRK, hRmeas, hRaction⟩ :=
      Submission.cbr_imRep_measure_basic P k (ball x r) R
    have hμKB : ∀ K : Set (Euclid P), IsCompact K → K ⊆ ball x r → μ K < ∞ :=
      fun K hK hKB => hμK K hK (hKB.trans hB)
    -- `|ξ_R| ≤ 1` holds `Hᵏ⌞M_R`-a.e. by (IMC)(d), hence `μ_R`-a.e.
    have hRbound : ∀ᵐ y ∂R.measure, ∀ α : Covector (Euclid P) k,
        |R.orient y α| ≤ covectorEuclideanNorm α :=
      hRac.ae_le (hIMC.2.2.2 P k (ball x r) R)
    -- Step 3: `M_G(X) = M_G(X⌞B)` for `G ⊆ B`: the admissible forms are the same forms
    have hmassB : ∀ G : Set (Euclid P), G ⊆ ball x r →
        X.massOn G = (X.restrictDomain hB).massOn G := by
      intro G hGB
      unfold GeometricCurrentOn.massOn
      congr 1
      ext s
      constructor
      · rintro ⟨ω, hω, rfl⟩
        exact ⟨⟨ω, ω.property.1, hω.1.trans hGB⟩, hω, rfl⟩
      · rintro ⟨ω', hω', rfl⟩
        exact ⟨testFormOnInclusion hB k ω', hω', rfl⟩
    -- Step 4: `μ(G) = M_G(X) = M_G(X⌞B) = μ_R(G)` for open `G ⊆ B` by (MR), so `μ⌞B = μ_R⌞B`
    have hopen : ∀ G : Set (Euclid P), IsOpen G → G ⊆ ball x r → μ G = R.measure G := by
      intro G hG hGB
      rw [← hμmass G hG, hmassB G hGB]
      exact hMR P k (ball x r) (X.restrictDomain hB) R isOpen_ball hR G hG
    have hborel := Submission.cmc_ml_measure_eq_of_eq_on_open_subsets P (ball x r) μ R.measure
      isOpen_ball (fun C hC hCB => (hμKB C hC hCB).ne) hopen
    have hrestr : μ.restrict (ball x r) = R.measure.restrict (ball x r) :=
      (Measure.restrict_congr_meas measurableSet_ball).2 fun A hAB hA => hborel A hA hAB
    -- `μ_R` lives on `M_R ⊆ B`, so `μ_R⌞B = μ_R`
    have hRB : R.measure.restrict (ball x r) = R.measure :=
      Measure.restrict_eq_self_of_ae_mem
        (Filter.mem_of_superset (mem_ae_iff.2 hRcompl) R.carrier_subset)
    -- Step 5: `∫ ⟨ω, ξ⟩ dμ = X(ιω) = X⌞B(ω) = ∫ ⟨ω, ξ_R⟩ dμ_R` for `ω ∈ 𝒟ᵏ(B)`, so the
    -- integrals over every Borel set agree
    have hset := Submission.cbr_setIntegral_eq_of_integral_eq P k (ball x r) μ R.measure 0 ξ
      R.orient 0 isOpen_ball hμKB hRK (fun K _ _ => by simp) hξmeas hRmeas
      (aestronglyMeasurable_zero_measure _) (ae_of_all μ hξbound) hRbound
      (ae_of_all _ fun y α => by simpa using covectorEuclideanNorm_nonneg α) fun ω => by
        rw [integral_zero_measure, add_zero, ← hRaction (ω : DifferentialForm (Euclid P) k),
          ← hR ω, GeometricCurrentOn.restrictDomain_apply, hXrep, testFormOnInclusion_coe]
    -- Step 6: hence `ξ = ξ_R` `μ`-a.e. on `B`, and `(B, R)` is the required local triple
    have hae := Submission.cbr_orient_ae_eq_of_setIntegral_eq P k (ball x r) μ R.measure ξ
      R.orient isOpen_ball hμKB hrestr hξmeas hRmeas (ae_of_all μ hξbound) hRbound
      fun E ω hE => by rw [hset E ω hE, Measure.restrict_zero, integral_zero_measure, add_zero]
    exact ⟨ball x r, R, isOpen_ball, mem_ball_self hr, hB, hrestr.trans hRB, hae⟩

/-- **The densities converge to the constant in `L¹(B_R(0))`** (step 11 of the weight bound).
Let `U = B_{2R}(0) ⊆ ℝⁿ`, `n = d + 1`, `Y_k(ω) = ∫_U u_k ω(e)` with `∫_U |u_k| ≤ Λ` eventually,
`M_U(∂Y_k) → 0` and `Y_k(ω) → c ∫ ω(e)`.  Testing with `b dy` gives `∫_U u_k b → c ∫ b` for
smooth `b` compactly supported in `U`.  Fix a normalized mollifier `φ ≥ 0` supported in
`B_{R/8}(0)`, so `tsupport φ ⊆ B_s(0)` with `s = R/4`; then `w_k = ∫_U u_k(y) φ(· − y) dy → c`
uniformly on `B̄_R(0)`.  Eventually `M_U(∂Y_k) < ∞`, and then, with `V_k = M_U(∂Y_k)` and the
interior-product form `ε_z` (`d(f ε_z)(e) = ∂_z f`, `|ε_z| ≤ ‖z‖`),
`|∫_U u_k ∂_z f| = |∂Y_k(f ε_z)| ≤ V_k ‖z‖ sup |f|`.  The BV estimate gives
`∫_{B_R} |u_k − w_k| ≤ s V_k → 0`, and the `L¹` squeeze yields `∫_{B_R} |u_k − c| → 0`. -/
theorem Submission.cbr_ci_pw_density_l1_tendsto_const : ∀ (d : ℕ) (R c Λ : ℝ) (Y : ℕ → GeometricCurrentOn (ball (0 : Euclid (d + 1)) (2 * R)) (d + 1)) (u : ℕ → Euclid (d + 1) → ℝ), 0 < R → (∀ k, IntegrableOn (u k) (ball 0 (2 * R))) → (∀ᶠ k in atTop, ∫ y in ball 0 (2 * R), |u k y| ≤ Λ) → (∀ (k : ℕ) (ω : TestFormOn (ball (0 : Euclid (d + 1)) (2 * R)) (d + 1)), Y k ω = ∫ y in ball 0 (2 * R), u k y * (ω : DifferentialForm (Euclid (d + 1)) (d + 1)) y (fun i => EuclideanSpace.single i (1 : ℝ))) → Tendsto (fun k => (Y k).boundary.massOn (ball 0 (2 * R))) atTop (𝓝 0) → (∀ ω : TestFormOn (ball (0 : Euclid (d + 1)) (2 * R)) (d + 1), Tendsto (fun k => Y k ω) atTop (𝓝 (c * ∫ y, (ω : DifferentialForm (Euclid (d + 1)) (d + 1)) y (fun i => EuclideanSpace.single i (1 : ℝ))))) → Tendsto (fun k => ∫ y in ball 0 R, |u k y - c|) atTop (𝓝 0) := by
  intro d R c Λ Y u hR hint hΛ hrep hbd hconv
  -- Step 1: scalar tests `∫_U u_k b → c ∫ b`
  have htest :=
    Submission.cbr_ci_pw_l1_scalar_test_tendsto (d + 1) (ball 0 (2 * R)) c Y u hrep hconv
  -- Step 2: a normalized mollifier `φ` with `tsupport φ ⊆ B̄_{R/8}(0) ⊆ B_s(0)`, `s = R/4`
  obtain ⟨φ, hφ, hφc, hφ0, hφ1, hφs⟩ :=
    Submission.dgcr_stc_exists_normalized_mollifier (d + 1) (R / 8) (by positivity)
  have hφt : tsupport φ ⊆ ball 0 (R / 4) :=
    (closure_minimal (hφs.trans ball_subset_closedBall) isClosed_closedBall).trans
      (closedBall_subset_ball (by linarith))
  -- Step 3: `w_k → c ∫ φ = c` uniformly on `B̄_R(0)`
  have hunif := Submission.cbr_ci_pw_mollified_tendstoUniformlyOn (d + 1) R (R / 4) c Λ φ u hR
    (by positivity) (by linarith) hφ hφt hint hΛ htest
  rw [hφ1, mul_one] at hunif
  -- Step 4: `V_k = M_U(∂Y_k).toReal → 0`, and eventually `M_U(∂Y_k) ≠ ∞`
  have hV : Tendsto (fun k => ((Y k).boundary.massOn (ball 0 (2 * R))).toReal) atTop (𝓝 0) := by
    simpa only [Function.comp_def, ENNReal.toReal_zero] using
      (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp hbd
  have hfin := hbd.eventually_ne ENNReal.zero_ne_top
  -- Step 5: `∫_{B_R} |u_k − w_k| ≤ s V_k`, by the BV estimate; its hypothesis
  -- `|∫_U u_k ∂_z f| ≤ V_k ‖z‖ M` comes from `ε_z` and the boundary-mass bound
  have hbv : ∀ᶠ k in atTop,
      ∫ x in ball 0 R, |u k x - ∫ y in ball 0 (2 * R), u k y * φ (x - y)| ≤
        R / 4 * ((Y k).boundary.massOn (ball 0 (2 * R))).toReal := by
    filter_upwards [hfin] with k hk
    refine Submission.cbr_ci_pw_bv_mollifier_estimate (d + 1) R (R / 4)
      ((Y k).boundary.massOn (ball 0 (2 * R))).toReal φ (u k) hR (by positivity) (by linarith)
      ENNReal.toReal_nonneg hφ hφ0 hφt hφ1 (hint k) fun f z M hf hfc hft hM => ?_
    obtain ⟨ε, hε, hεf⟩ := Submission.cbr_ci_pw_interior_product_form d z
    exact Submission.cbr_ci_pw_l1_boundary_variation_bound d (ball 0 (2 * R)) (Y k) (u k) ε f z M
      (hrep k) hk hε (fun y => hεf f y (hf.differentiable (by simp) y)) hf hfc hft hM
  -- Step 6: the `L¹` squeeze with `a_k = s V_k → 0`
  exact Submission.cbr_ci_pw_l1_squeeze_of_mollified (d + 1) R c φ u
    (fun k => R / 4 * ((Y k).boundary.massOn (ball 0 (2 * R))).toReal) hR hφ.continuous hφc hint
    hunif (by simpa only [mul_zero] using hV.const_mul (R / 4)) hbv

/-- **Each plane of a planar weak limit of cycles has weight `≥ 1`** (step (V11) of the proof that
the cycles of the closure theorem are integer multiplicity; White's projection argument).  Let
`Γₖ ⇀ C` be cycles with representations `(μₖ, ξₖ)`, `limsup μₖ(K) ≤ θ₀ν(K)`, carried by sets `Nₖ`
with `limsup Hⁿ(Nₖ ∩ K) ≤ ν(K)`, where `C(ω) = θ₀ ∫ ω(v) dν` and `ν = Σᵢ αᵢ Hⁿ⌞(V₀ + wᵢ)`.  Fix
`i₀`.  A `1`-Lipschitz `g` vanishing on `V₀ + w_{i₀}` isolates that plane
(`cbr_ci_pw_isolate_plane`); slicing by `g` at a good level `t` (`cbr_ci_pw_good_level_slices`)
and projecting by `pL x = (⟨vⱼ, x⟩)ⱼ` (`cbr_ci_pw_projected_current`) gives top-dimensional
currents `Yₖ` on `B₂ ⊆ ℝⁿ` with `M(∂Yₖ) → 0` and `Yₖ ⇀ θ₀α_{i₀}[[ℝⁿ]]`
(`cbr_ci_pw_plane_map_volume`).  Their densities `uₖ` (`cbr_ci_pw_top_current_density`) tend to
`θ₀α_{i₀}` in `L¹(B₁)` (`cbr_ci_pw_density_l1_tendsto_const`) and vanish off `pL(Nₖ)`
(`cbr_ci_pw_density_null_off_image`).  As `pL` is `1`-Lipschitz,
`Lⁿ(B₁) ≤ limsup Hⁿ(Nₖ ∩ A₁) ≤ ν(A₁) = α_{i₀}Lⁿ(B₁)` for the compact `A₁ = {g ≤ t} ∩ pL⁻¹(B̄₁)`. -/
theorem Submission.cbr_ci_plane_weight_ge_one : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → ((∀ (P : ℕ) (U : Set (Euclid P)) (μs : ℕ → Measure (Euclid P)), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ⨆ j, μs j K < ∞) → ∃ (φ : ℕ → ℕ) (μ : Measure (Euclid P)), StrictMono φ ∧ μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → tsupport f ⊆ U → Tendsto (fun j => ∫ x, f x ∂(μs (φ j))) atTop (𝓝 (∫ x, f x ∂μ))) ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → limsup (fun j => μs (φ j) K) atTop ≤ μ K) ∧ (∀ G : Set (Euclid P), IsOpen G → G ⊆ U → μ G ≤ liminf (fun j => μs (φ j) G) atTop)) ∧ (∀ (P k : ℕ) (U : Set (Euclid P)) (Xs : ℕ → GeometricCurrentOn U k) (X : GeometricCurrentOn U k) (μs : ℕ → Measure (Euclid P)) (ξs : ℕ → Euclid P → MultiVector P k) (μX μ : Measure (Euclid P)) (ξX : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (t : ℝ), IsOpen U → Continuous f → WeaklyConvergesOn Xs X → (∀ j, ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μs j K < ∞) → (∀ j, AEStronglyMeasurable (ξs j) (μs j)) → (∀ j, ∀ᵐ x ∂(μs j), ∀ α : Covector (Euclid P) k, |ξs j x α| ≤ covectorEuclideanNorm α) → (∀ j, ∀ ω : TestFormOn U k, Xs j ω = ∫ x, ξs j x ((ω : DifferentialForm (Euclid P) k) x) ∂(μs j)) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μX K < ∞) → AEStronglyMeasurable ξX μX → (∀ᵐ x ∂μX, ∀ α : Covector (Euclid P) k, |ξX x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U k, X ω = ∫ x, ξX x ((ω : DifferentialForm (Euclid P) k) x) ∂μX) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → limsup (fun j => μs j K) atTop ≤ μ K) → μ {x | f x = t} = 0 → ∀ ω : TestFormOn U k, Tendsto (fun j => ∫ x in {x | f x < t}, ξs j x ((ω : DifferentialForm (Euclid P) k) x) ∂(μs j)) atTop (𝓝 (∫ x in {x | f x < t}, ξX x ((ω : DifferentialForm (Euclid P) k) x) ∂μX))) ∧ (∀ (P : ℕ) (μs : ℕ → Measure (Euclid P)) (f : Euclid P → ℝ) (G : Set (Euclid P)) (a b : ℝ) (L : NNReal) (Z : ℕ → ℝ → ℝ≥0∞), Continuous f → (∀ j, μs j (G ∩ {x | a < f x ∧ f x < b}) < ∞) → (∀ (j : ℕ) (t : ℝ), t ∈ Ioo a b → Z j t ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μs j (G ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) → ∃ g : ℝ → ℝ≥0∞, Measurable g ∧ (∀ᵐ t ∂(volume : Measure ℝ), t ∈ Ioo a b → liminf (fun j => Z j t) atTop ≤ g t) ∧ ∫⁻ t in Ioo a b, g t ≤ (L : ℝ≥0∞) * liminf (fun j => μs j (G ∩ {x | a < f x ∧ f x < b})) atTop)) → ∀ (P d : ℕ) (v : Fin (d + 1) → Euclid P) (θ₀ : ℝ) (N : ℕ) (w : Fin N → Euclid P) (α : Fin N → ℝ) (ν : Measure (Euclid P)) (C : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (Γs : ℕ → GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (μs : ℕ → Measure (Euclid P)) (ξs : ℕ → Euclid P → MultiVector P (d + 1)) (Ns : ℕ → Set (Euclid P)), Orthonormal ℝ v → 0 < θ₀ → Injective w → (∀ (i : Fin N) (j : Fin (d + 1)), inner ℝ (w i) (v j) = 0) → (∀ i, 0 < α i) → ν = ∑ i, ENNReal.ofReal (α i) • (μHE[(d + 1)]).restrict {y : Euclid P | y - w i ∈ Submodule.span ℝ (Set.range v)} → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = θ₀ * ∫ y, (ω : DifferentialForm (Euclid P) (d + 1)) y v ∂ν) → WeaklyConvergesOn Γs C → (∀ k, (Γs k).boundary = 0) → (∀ (k : ℕ) (K : Set (Euclid P)), IsCompact K → μs k K < ∞) → (∀ k, AEStronglyMeasurable (ξs k) (μs k)) → (∀ k, ∀ᵐ x ∂(μs k), ∀ β : Covector (Euclid P) (d + 1), |ξs k x β| ≤ covectorEuclideanNorm β) → (∀ (k : ℕ) (ω : TestFormOn (univ : Set (Euclid P)) (d + 1)), Γs k ω = ∫ x, ξs k x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂(μs k)) → (∀ K : Set (Euclid P), IsCompact K → limsup (fun k => μs k K) atTop ≤ ENNReal.ofReal θ₀ * ν K) → (∀ k, μs k (Ns k)ᶜ = 0) → (∀ K : Set (Euclid P), IsCompact K → limsup (fun k => μHE[(d + 1)] (Ns k ∩ K)) atTop ≤ ν K) → ∀ i, 1 ≤ α i := by
  intro hREP hSL hCT P d v θ₀ N w α ν C Γs μs ξs Ns hv hθ₀ hw hwv hα hν hC hΓC hΓb hμfin
    hξmeas hξbd hΓrep hlimsup hNs hNlim i₀
  -- Step 0: the coordinate projection `pL x = (⟨v₀, x⟩, …, ⟨v_d, x⟩)` onto `ℝⁿ`, `n = d + 1`
  let pL : Euclid P →L[ℝ] Euclid (d + 1) :=
    (EuclideanSpace.equiv (Fin (d + 1)) ℝ).symm.toContinuousLinearMap ∘L
      ContinuousLinearMap.pi (fun i => innerSL ℝ (v i))
  have hpL : ∀ (x : Euclid P) (i : Fin (d + 1)), pL x i = inner ℝ (v i) x := by
    intro x i
    simp [pL]
  have hpLv : ∀ j, pL (v j) = EuclideanSpace.single j (1 : ℝ) := by
    intro j
    ext i
    rw [hpL, orthonormal_iff_ite.mp hv i j]
    simp [eq_comm]
  obtain ⟨hcb1, -⟩ := Submission.cbr_ci_pw_orthonormal_covector_bounds P (d + 1) v pL hv hpL
  -- the plane `Pl₀ = V₀ + w i₀`
  set Pl₀ : Set (Euclid P) := {y : Euclid P | y - w i₀ ∈ Submodule.span ℝ (Set.range v)}
  have hPlmeas : MeasurableSet Pl₀ :=
    ((Submodule.span ℝ (Set.range v)).closed_of_finiteDimensional.preimage
      (continuous_id.sub continuous_const)).measurableSet
  have hmapPl : ∀ i, Measure.map pL ((μHE[(d + 1)]).restrict
      {y : Euclid P | y - w i ∈ Submodule.span ℝ (Set.range v)}) = volume :=
    fun i => Submission.cbr_ci_pw_plane_map_volume P (d + 1) v (w i) pL hv hpL
  have hmap0 : Measure.map pL ((μHE[(d + 1)]).restrict Pl₀) = volume := hmapPl i₀
  -- `ν` is finite on compact sets: `Hⁿ(K ∩ (V₀ + w i)) ≤ Lⁿ(pL K)`
  have hνK : ∀ K : Set (Euclid P), IsCompact K → ν K < ∞ := by
    intro K hK
    rw [hν, Measure.coe_finsetSum, Finset.sum_apply]
    refine ENNReal.sum_lt_top.2 fun i _ => ?_
    rw [Measure.smul_apply, smul_eq_mul]
    refine ENNReal.mul_lt_top ENNReal.ofReal_lt_top ?_
    calc (μHE[(d + 1)]).restrict {y : Euclid P | y - w i ∈ Submodule.span ℝ (Set.range v)} K
        ≤ (μHE[(d + 1)]).restrict {y : Euclid P | y - w i ∈ Submodule.span ℝ (Set.range v)}
            (pL ⁻¹' (pL '' K)) := measure_mono (subset_preimage_image _ _)
      _ ≤ Measure.map pL ((μHE[(d + 1)]).restrict
            {y : Euclid P | y - w i ∈ Submodule.span ℝ (Set.range v)}) (pL '' K) :=
          Measure.le_map_apply pL.continuous.aemeasurable _
      _ = volume (pL '' K) := by rw [hmapPl i]
      _ < ∞ := (hK.image pL.continuous).measure_lt_top
  -- Steps 0–1: `g = dist(·, Pl₀)` isolates `Pl₀`
  obtain ⟨g, δ, hδ, hgLip, hgPl, hνg, hgcpt⟩ :=
    Submission.cbr_ci_pw_isolate_plane P (d + 1) N v w α ν pL i₀ hv hw hwv hν hpL
  have hgc : Continuous g := hgLip.continuous
  have hνsub : ∀ s : Set (Euclid P), s ⊆ {x | g x < 3 * δ} →
      ν s = ENNReal.ofReal (α i₀) * (μHE[(d + 1)]).restrict Pl₀ s := by
    intro s hs
    have h1 : ν s = ν.restrict {x | g x < 3 * δ} s := by
      rw [Measure.restrict_apply' (isOpen_lt hgc continuous_const).measurableSet,
        inter_eq_left.mpr hs]
    rw [h1, hνg, Measure.smul_apply, smul_eq_mul]
  have hνzero : ∀ s : Set (Euclid P), s ⊆ {x | g x < 3 * δ} → (∀ x ∈ s, x ∉ Pl₀) → ν s = 0 := by
    intro s hs hsPl
    rw [hνsub s hs, Measure.restrict_apply' hPlmeas]
    have : s ∩ Pl₀ = ∅ := by
      ext x
      simp only [mem_inter_iff, mem_empty_iff_false, iff_false, not_and]
      exact hsPl x
    rw [this, measure_empty, mul_zero]
  -- the limit measure `μc = θ₀ ν` and the constant `n`-vector field `ξ_v = v₀ ∧ ⋯ ∧ v_d`
  set μc : Measure (Euclid P) := ENNReal.ofReal θ₀ • ν with hμc
  have hμcK : ∀ K : Set (Euclid P), IsCompact K → μc K < ∞ := by
    intro K hK
    rw [hμc, Measure.smul_apply, smul_eq_mul]
    exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top (hνK K hK)
  have hlimc : ∀ K : Set (Euclid P), IsCompact K → limsup (fun k => μs k K) atTop ≤ μc K := by
    intro K hK
    rw [hμc, Measure.smul_apply, smul_eq_mul]
    exact hlimsup K hK
  let ξv : MultiVector P (d + 1) := ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ v
  have hCrep : ∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1),
      C ω = ∫ x, (fun _ => ξv) x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μc := by
    intro ω
    rw [hC ω, hμc, integral_smul_measure, ENNReal.toReal_ofReal hθ₀.le, smul_eq_mul]
    rfl
  -- the domain `U = B₂(0) ⊆ ℝⁿ` of the projected currents and `Ω = pL⁻¹(U)`
  set U : Set (Euclid (d + 1)) := ball (0 : Euclid (d + 1)) (2 * 1)
  have hUopen : IsOpen U := isOpen_ball
  set Ω : Set (Euclid P) := pL ⁻¹' U
  have hΩopen : IsOpen Ω := hUopen.preimage pL.continuous
  -- Step 1: the compact annulus `A₃ = {δ ≤ g ≤ 2δ} ∩ pL⁻¹(B̄₂)` meets no plane, so `ν(A₃) = 0`
  set A₃ : Set (Euclid P) := {x | δ ≤ g x} ∩ ({x | g x ≤ 2 * δ} ∩ pL ⁻¹' closedBall 0 (2 * 1))
  have hA₃c : IsCompact A₃ := (hgcpt (2 * δ) (2 * 1)).inter_left (isClosed_le continuous_const hgc)
  have hAnnA₃ : Ω ∩ {x | δ < g x ∧ g x < 2 * δ} ⊆ A₃ := fun x hx =>
    ⟨hx.2.1.le, hx.2.2.le, ball_subset_closedBall hx.1⟩
  have hνA₃ : ν A₃ = 0 := by
    refine hνzero A₃ (fun x hx => show g x < 3 * δ from lt_of_le_of_lt hx.2.1 (by linarith))
      fun x hx hxP => ?_
    have h1 : δ ≤ g x := hx.1
    rw [hgPl x hxP] at h1
    linarith
  have hAnnfin : ∀ k, μs k (Ω ∩ {x | δ < g x ∧ g x < 2 * δ}) < ∞ := fun k =>
    (measure_mono hAnnA₃).trans_lt (hμfin k A₃ hA₃c)
  have hAnnlim : liminf (fun k => μs k (Ω ∩ {x | δ < g x ∧ g x < 2 * δ})) atTop = 0 := by
    refine le_antisymm ?_ zero_le
    calc liminf (fun k => μs k (Ω ∩ {x | δ < g x ∧ g x < 2 * δ})) atTop
        ≤ limsup (fun k => μs k (Ω ∩ {x | δ < g x ∧ g x < 2 * δ})) atTop := liminf_le_limsup
      _ ≤ limsup (fun k => μs k A₃) atTop :=
          limsup_le_limsup (Eventually.of_forall fun k => measure_mono hAnnA₃)
      _ ≤ μc A₃ := hlimc A₃ hA₃c
      _ = 0 := by rw [hμc, Measure.smul_apply, hνA₃, smul_zero]
  -- the level sets `{g = t}`, `δ < t < 2δ`, meet no plane
  have hμcg : ∀ t ∈ Ioo δ (2 * δ), μc {x | g x = t} = 0 := by
    intro t ht
    have h0 : ν {x | g x = t} = 0 := by
      refine hνzero {x | g x = t} (fun x hx => ?_) fun x hx hxP => ?_
      · have h1 : g x = t := hx
        show g x < 3 * δ
        rw [h1]
        linarith [ht.2]
      · have h1 : g x = t := hx
        rw [hgPl x hxP] at h1
        linarith [ht.1]
    rw [hμc, Measure.smul_apply, h0, smul_zero]
  -- Steps 2–4: a good level `t ∈ (δ, 2δ)` and the slices `Z k = Γ_{φ k}⌞{g < t}`
  obtain ⟨t, ht, φ, Z, hφ, hZrep, hZfin, hZlim, hZconv⟩ :=
    Submission.cbr_ci_pw_good_level_slices hSL hCT.2.1 hCT.2.2 P d Γs C μs ξs μc μc (fun _ => ξv)
      g 1 Ω δ (2 * δ) hgLip hΩopen (by linarith) hΓC hΓb hμfin hξmeas hξbd hΓrep hμcK
      aestronglyMeasurable_const (ae_of_all _ fun _ β => hcb1 β) hCrep hμcK hlimc hμcg hAnnfin
      hAnnlim
  have ht0 : 0 < t := lt_trans hδ ht.1
  have ht3 : t < 3 * δ := by linarith [ht.2]
  -- the sets `S = {g ≤ t} ⊇ F = {g < t} ⊇ Pl₀`
  set S : Set (Euclid P) := {x | g x ≤ t}
  set F : Set (Euclid P) := {x | g x < t}
  have hFmeas : MeasurableSet F := (isOpen_lt hgc continuous_const).measurableSet
  have hFS : F ⊆ S := fun x (hx : g x < t) => show g x ≤ t from le_of_lt hx
  have hPlF : Pl₀ ⊆ F := fun y hy => by
    show g y < t
    rw [hgPl y hy]
    exact ht0
  have hSK : ∀ K : Set (Euclid (d + 1)), IsCompact K → K ⊆ U → IsCompact (S ∩ pL ⁻¹' K) := by
    intro K hK _
    obtain ⟨r, hr⟩ := hK.isBounded.subset_closedBall 0
    exact (hgcpt t r).of_isClosed_subset
      ((isClosed_le hgc continuous_const).inter (hK.isClosed.preimage pL.continuous))
      (inter_subset_inter_right _ (preimage_mono hr))
  -- Steps 5–7: the projected currents `Y k = pL_#(Z k)` on `U`
  have hproj := fun k => Submission.cbr_ci_pw_projected_current P d v pL U S F (μs (φ k)) (ξs (φ k))
    (Z k) hv hpL hUopen hFmeas hFS hSK (hμfin (φ k)) (hξmeas (φ k)) (hξbd (φ k)) (hZrep k)
  choose Y hYrep hYmass hYbd hYext using hproj
  -- the compact set `A₂ = S ∩ pL⁻¹(B̄₂)` controls the masses
  set A₂ : Set (Euclid P) := S ∩ pL ⁻¹' closedBall 0 (2 * 1)
  have hA₂c : IsCompact A₂ := hgcpt t (2 * 1)
  have hFA₂ : F ∩ pL ⁻¹' U ⊆ A₂ := inter_subset_inter hFS (preimage_mono ball_subset_closedBall)
  have hYmass' : ∀ k, (Y k).massOn U ≤ μs (φ k) A₂ := fun k =>
    (hYmass k).trans (measure_mono hFA₂)
  have hYfin : ∀ k, (Y k).massOn U < ∞ := fun k =>
    (hYmass' k).trans_lt (hμfin (φ k) A₂ hA₂c)
  have hYbdΩ : ∀ k, (Y k).boundary.massOn U ≤ (Z k).boundary.massOn Ω := fun k =>
    hYbd k U hUopen subset_rfl
  have hYbdfin : ∀ k, ∀ W : Set (Euclid (d + 1)), IsOpen W → CompactlyContained W U →
      (Y k).boundary.massOn W < ∞ := by
    intro k W hW hWU
    have hWU' : W ⊆ U := subset_closure.trans hWU.2
    exact ((hYbd k W hW hWU').trans ((Z k).boundary.massOn_mono (preimage_mono hWU'))).trans_lt
      (hZfin k)
  -- Step 9: the densities `u k` of the top-dimensional currents `Y k`
  have hdens := fun k =>
    Submission.cbr_ci_pw_top_current_density hREP d U (Y k) hUopen (hYfin k) (hYbdfin k)
  choose u hu_int hu_mass hu_rep using hdens
  -- a uniform bound `Λ` for `∫_U |u k|`
  obtain ⟨Λ, hΛ⟩ : ∃ Λ : ℝ, ∀ᶠ k in atTop, ∫ y in U, |u k y| ≤ Λ := by
    refine ⟨(μc A₂ + 1).toReal, ?_⟩
    have hlt : limsup (fun k => μs (φ k) A₂) atTop < μc A₂ + 1 :=
      calc limsup (fun k => μs (φ k) A₂) atTop ≤ limsup (fun k => μs k A₂) atTop :=
            hφ.tendsto_atTop.limsup_comp_le_limsup (u := fun k => μs k A₂)
        _ ≤ μc A₂ := hlimc A₂ hA₂c
        _ < μc A₂ + 1 := ENNReal.lt_add_right (hμcK A₂ hA₂c).ne one_ne_zero
    filter_upwards [eventually_lt_of_limsup_lt hlt] with k hk
    have h1 : ENNReal.ofReal (∫ y in U, |u k y|) ≤ μc A₂ + 1 :=
      (hu_mass k).trans ((hYmass' k).trans hk.le)
    exact (ENNReal.ofReal_le_iff_le_toReal
      (ENNReal.add_ne_top.2 ⟨(hμcK A₂ hA₂c).ne, ENNReal.one_ne_top⟩)).1 h1
  -- `M_U(∂Y k) → 0`
  have hYbd0 : Tendsto (fun k => (Y k).boundary.massOn U) atTop (𝓝 0) :=
    tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hZlim (fun _ => zero_le) hYbdΩ
  -- Step 8: `Y k ⇀ θ₀ α_{i₀} [[ℝⁿ]]` on `U`
  have hYconv : ∀ ω : TestFormOn U (d + 1), Tendsto (fun k => Y k ω) atTop
      (𝓝 ((θ₀ * α i₀) * ∫ y, (ω : DifferentialForm (Euclid (d + 1)) (d + 1)) y
        (fun i => EuclideanSpace.single i (1 : ℝ)))) := by
    intro ω
    -- a test form `ω'` on `ℝᴾ` agreeing with `pL^#ω` on `S`
    obtain ⟨ω', hω'⟩ := hYext 0 ω
    have hYZ : ∀ k, Y k ω = Z k ω' := by
      intro k
      rw [hYrep k ω, hZrep k ω']
      refine setIntegral_congr_fun hFmeas fun x hx => ?_
      rw [hω' x (hFS hx)]
    have hωc : Continuous fun y => (ω : DifferentialForm (Euclid (d + 1)) (d + 1)) y
        (fun i => EuclideanSpace.single i (1 : ℝ)) :=
      (ContinuousAlternatingMap.apply ℝ (Euclid (d + 1)) ℝ
        (fun i => EuclideanSpace.single i (1 : ℝ))).continuous.comp ω.property.1.1.continuous
    -- `θ₀ ν⌞F = θ₀ α_{i₀} Hⁿ⌞Pl₀`
    have hμcF : μc.restrict F =
        ENNReal.ofReal θ₀ • (ENNReal.ofReal (α i₀) • (μHE[(d + 1)]).restrict Pl₀) := by
      have hF3 : F ⊆ {x | g x < 3 * δ} := fun x (hx : g x < t) =>
        show g x < 3 * δ from lt_trans hx ht3
      rw [hμc, Measure.restrict_smul, ← Measure.restrict_restrict_of_subset hF3, hνg,
        Measure.restrict_smul, Measure.restrict_restrict hFmeas, inter_eq_right.2 hPlF]
    have hfun : (fun k => Y k ω) = fun k => Z k ω' := funext hYZ
    rw [hfun]
    convert hZconv ω' using 2
    symm
    calc ∫ x in F, (fun _ => ξv) x ((ω' : DifferentialForm (Euclid P) (d + 1)) x) ∂μc
        = ∫ x, ξv ((ω' : DifferentialForm (Euclid P) (d + 1)) x) ∂(ENNReal.ofReal θ₀ •
            (ENNReal.ofReal (α i₀) • (μHE[(d + 1)]).restrict Pl₀)) := by
          rw [← hμcF]
      _ = θ₀ * (α i₀ * ∫ x in Pl₀, ξv ((ω' : DifferentialForm (Euclid P) (d + 1)) x)
            ∂(μHE[(d + 1)])) := by
          rw [integral_smul_measure, integral_smul_measure, ENNReal.toReal_ofReal hθ₀.le,
            ENNReal.toReal_ofReal (hα i₀).le, smul_eq_mul, smul_eq_mul]
      _ = θ₀ * (α i₀ * ∫ x in Pl₀, (ω : DifferentialForm (Euclid (d + 1)) (d + 1)) (pL x)
            (fun i => EuclideanSpace.single i (1 : ℝ)) ∂(μHE[(d + 1)])) := by
          congr 2
          refine setIntegral_congr_fun hPlmeas fun x hx => ?_
          show ((ω' : DifferentialForm (Euclid P) (d + 1)) x) v = _
          rw [hω' x (hFS (hPlF hx)), ContinuousAlternatingMap.compContinuousLinearMap_apply]
          congr 1
          funext j
          exact hpLv j
      _ = θ₀ * (α i₀ * ∫ y, (ω : DifferentialForm (Euclid (d + 1)) (d + 1)) y
            (fun i => EuclideanSpace.single i (1 : ℝ))) := by
          rw [← integral_map pL.continuous.aemeasurable hωc.aestronglyMeasurable, hmap0]
      _ = θ₀ * α i₀ * ∫ y, (ω : DifferentialForm (Euclid (d + 1)) (d + 1)) y
            (fun i => EuclideanSpace.single i (1 : ℝ)) := by ring
  -- Step 11: `u k → θ₀ α_{i₀}` in `L¹(B₁)`
  have hl1 := Submission.cbr_ci_pw_density_l1_tendsto_const d 1 (θ₀ * α i₀) Λ Y u one_pos hu_int hΛ
    hu_rep hYbd0 hYconv
  -- the top covector `dy = dy¹ ∧ ⋯ ∧ dyⁿ` on `ℝⁿ`, `dy(e₁, …, eₙ) = 1`
  let dyA : (Euclid (d + 1)) [⋀^Fin (d + 1)]→ₗ[ℝ] ℝ :=
    (EuclideanSpace.basisFun (Fin (d + 1)) ℝ).toBasis.det
  have hdyA : ∀ m : Fin (d + 1) → Euclid (d + 1),
      dyA m = Matrix.det (Matrix.of fun i j => m j i) := by
    intro m
    simp only [dyA, Module.Basis.det_apply]
    congr 1
  have hdycont : Continuous dyA := by
    have : (dyA : (Fin (d + 1) → Euclid (d + 1)) → ℝ) =
        fun m => Matrix.det (Matrix.of fun i j => m j i) := funext hdyA
    rw [this]
    fun_prop
  let dy : Covector (Euclid (d + 1)) (d + 1) := { dyA with cont := hdycont }
  have hdy : dy (fun i => EuclideanSpace.single i (1 : ℝ)) = 1 := by
    show dyA _ = 1
    have h := (EuclideanSpace.basisFun (Fin (d + 1)) ℝ).toBasis.det_self
    have he : ((EuclideanSpace.basisFun (Fin (d + 1)) ℝ).toBasis : Fin (d + 1) → Euclid (d + 1)) =
        fun i => EuclideanSpace.single i (1 : ℝ) := by
      funext i
      simp
    rw [he] at h
    exact h
  -- Step 10: `u k` vanishes off `pL(N_{φ k} ∩ F)`
  have hB1U : ball (0 : Euclid (d + 1)) 1 ⊆ U := ball_subset_ball (by norm_num)
  have hnull : ∀ k, volume (ball (0 : Euclid (d + 1)) 1 ∩ {y | u k y ≠ 0}) ≤
      volume (ball (0 : Euclid (d + 1)) 1 ∩ pL '' (Ns (φ k) ∩ F)) := by
    intro k
    set σ : Measure (Euclid P) := ((μs (φ k)).restrict F).restrict (pL ⁻¹' U) with hσ
    have hσuniv : σ univ < ∞ := by
      rw [hσ, Measure.restrict_apply_univ, Measure.restrict_apply' hFmeas]
      exact (measure_mono (by rw [inter_comm]; exact hFA₂)).trans_lt (hμfin (φ k) A₂ hA₂c)
    have : IsFiniteMeasure σ := ⟨hσuniv⟩
    have hhint : Integrable (fun x => ξs (φ k) x (dy.compContinuousLinearMap pL)) σ := by
      refine Integrable.of_bound ?_ (covectorEuclideanNorm (dy.compContinuousLinearMap pL)) ?_
      · exact (ContinuousLinearMap.apply ℝ ℝ
          (dy.compContinuousLinearMap pL)).continuous.comp_aestronglyMeasurable
            (hξmeas (φ k)).restrict.restrict
      · filter_upwards [ae_restrict_of_ae (s := pL ⁻¹' U) (ae_restrict_of_ae (s := F) (hξbd (φ k)))]
          with x hx
        rw [Real.norm_eq_abs]
        exact hx _
    have hσA : σ (Ns (φ k) ∩ F)ᶜ = 0 := by
      rw [hσ, Measure.restrict_apply' (hUopen.preimage pL.continuous).measurableSet,
        Measure.restrict_apply' hFmeas]
      refine measure_mono_null (fun x hx => ?_) (hNs (φ k))
      exact fun hN => hx.1.1 ⟨hN, hx.2⟩
    have htest : ∀ b : Euclid (d + 1) → ℝ, ContDiff ℝ (⊤ : ℕ∞) b → HasCompactSupport b →
        tsupport b ⊆ U →
        ∫ y in U, b y * u k y = ∫ x, b (pL x) * ξs (φ k) x (dy.compContinuousLinearMap pL) ∂σ := by
      intro b hb hbc hbU
      let ωb : TestFormOn U (d + 1) := ⟨fun y => b y • dy,
        ⟨⟨hb.smul contDiff_const, hbc.smul_right⟩, (tsupport_smul_subset_left _ _).trans hbU⟩⟩
      have e1 : ∫ y in U, b y * u k y = Y k ωb := by
        rw [hu_rep k ωb]
        refine integral_congr_ae (ae_of_all _ fun y => ?_)
        show b y * u k y = u k y * (b y • dy) (fun i => EuclideanSpace.single i (1 : ℝ))
        rw [ContinuousAlternatingMap.smul_apply, hdy, smul_eq_mul, mul_one, mul_comm]
      have e2 : Y k ωb = ∫ x in F, b (pL x) * ξs (φ k) x (dy.compContinuousLinearMap pL)
          ∂(μs (φ k)) := by
        rw [hYrep k ωb]
        refine integral_congr_ae (ae_of_all _ fun x => ?_)
        show ξs (φ k) x ((b (pL x) • dy).compContinuousLinearMap pL) = _
        have : (b (pL x) • dy).compContinuousLinearMap pL =
            b (pL x) • dy.compContinuousLinearMap pL := by
          ext m
          simp
        rw [this, map_smul, smul_eq_mul]
      rw [e1, e2, hσ]
      exact (setIntegral_eq_integral_of_forall_compl_eq_zero (fun x hx => by
        rw [image_eq_zero_of_notMem_tsupport (fun h => hx (hbU h)), zero_mul])).symm
    exact Submission.cbr_ci_pw_density_null_off_image P (d + 1) U (u k) σ pL
      (fun x => ξs (φ k) x (dy.compContinuousLinearMap pL)) (Ns (φ k) ∩ F) hUopen pL.continuous
      (hu_int k) hσuniv hhint hσA htest (ball 0 1) measurableSet_ball hB1U
  -- Step 12: comparison of `Lⁿ(B₁)` with `Hⁿ(N_{φ k} ∩ A₁)`, `A₁ = S ∩ pL⁻¹(B̄₁)` compact
  set A₁ : Set (Euclid P) := S ∩ pL ⁻¹' closedBall 0 1
  have hA₁c : IsCompact A₁ := hgcpt t 1
  have hpLnorm : ∀ x, ‖pL x‖ ≤ ‖x‖ := by
    intro x
    rw [EuclideanSpace.norm_eq]
    have hb := hv.sum_inner_products_le (x := x) (s := Finset.univ)
    calc √(∑ i, ‖pL x i‖ ^ 2) ≤ √(‖x‖ ^ 2) := Real.sqrt_le_sqrt (by simpa [hpL] using hb)
      _ = ‖x‖ := Real.sqrt_sq (norm_nonneg x)
  have hpLLip : LipschitzWith 1 pL := LipschitzWith.of_dist_le_mul fun x y => by
    rw [dist_eq_norm, dist_eq_norm, ← map_sub, NNReal.coe_one, one_mul]
    exact hpLnorm (x - y)
  have hHE : ∀ X : Set (Euclid P), volume (pL '' X) ≤ μHE[(d + 1)] X := by
    intro X
    rw [← EuclideanSpace.euclideanHausdorffMeasure_eq_volume (d + 1)]
    simp only [Measure.euclideanHausdorffMeasure_def, Measure.smul_apply, ENNReal.smul_def,
      smul_eq_mul]
    gcongr
    have := hpLLip.hausdorffMeasure_image_le (d := ((d + 1 : ℕ) : ℝ)) (by positivity) X
    rwa [ENNReal.coe_one, ENNReal.one_rpow, one_mul] at this
  have hnz : ∀ k, volume (ball (0 : Euclid (d + 1)) 1 ∩ {y | u k y ≠ 0}) ≤
      μHE[(d + 1)] (Ns (φ k) ∩ A₁) := by
    intro k
    refine (hnull k).trans ((measure_mono ?_).trans (hHE _))
    rintro _ ⟨hy, x, ⟨hxN, hxF⟩, rfl⟩
    exact ⟨x, ⟨hxN, hFS hxF, ball_subset_closedBall hy⟩, rfl⟩
  -- `Lⁿ(B₁ ∩ {u k = 0}) ≤ (θ₀ α_{i₀})⁻¹ ∫_{B₁} |u k − θ₀ α_{i₀}|`
  set c : ℝ := θ₀ * α i₀
  have hcpos : 0 < c := mul_pos hθ₀ (hα i₀)
  have hzero : ∀ k, volume (ball (0 : Euclid (d + 1)) 1 ∩ {y | u k y = 0}) ≤
      ENNReal.ofReal (∫ y in ball (0 : Euclid (d + 1)) 1, |u k y - c|) / ENNReal.ofReal c := by
    intro k
    rw [ENNReal.le_div_iff_mul_le (Or.inl (ENNReal.ofReal_pos.2 hcpos).ne')
      (Or.inl ENNReal.ofReal_ne_top)]
    have hint : IntegrableOn (fun y => |u k y - c|) (ball (0 : Euclid (d + 1)) 1) :=
      (((hu_int k).mono_set hB1U).sub (integrableOn_const measure_ball_lt_top.ne)).abs
    rw [ofReal_integral_eq_lintegral_ofReal hint (ae_of_all _ fun y => abs_nonneg _), mul_comm]
    calc ENNReal.ofReal c * volume (ball (0 : Euclid (d + 1)) 1 ∩ {y | u k y = 0})
        ≤ ENNReal.ofReal c * (volume.restrict (ball (0 : Euclid (d + 1)) 1))
            {y | ENNReal.ofReal c ≤ ENNReal.ofReal |u k y - c|} := by
          refine mul_le_mul_of_nonneg_left
            ((measure_mono ?_).trans (Measure.le_restrict_apply _ _)) zero_le
          rintro y ⟨hy, hy0⟩
          refine ⟨?_, hy⟩
          have hy0' : u k y = 0 := hy0
          show ENNReal.ofReal c ≤ ENNReal.ofReal |u k y - c|
          rw [hy0', zero_sub, abs_neg, abs_of_pos hcpos]
      _ ≤ ∫⁻ y in ball (0 : Euclid (d + 1)) 1, ENNReal.ofReal |u k y - c| :=
          mul_meas_ge_le_lintegral₀ hint.aemeasurable.ennreal_ofReal _
  have ha : Tendsto (fun k => ENNReal.ofReal (∫ y in ball (0 : Euclid (d + 1)) 1, |u k y - c|) /
      ENNReal.ofReal c) atTop (𝓝 0) := by
    have := ENNReal.Tendsto.div_const (ENNReal.tendsto_ofReal hl1)
      (Or.inr (ENNReal.ofReal_pos.2 hcpos).ne')
    simpa using this
  -- `Lⁿ(B₁) ≤ ν(A₁)`
  have hvol : volume (ball (0 : Euclid (d + 1)) 1) ≤ ν A₁ := by
    refine ENNReal.le_of_forall_pos_le_add fun ε hε _ => ?_
    have hev : ∀ᶠ k in atTop,
        volume (ball (0 : Euclid (d + 1)) 1) - ε ≤ μHE[(d + 1)] (Ns (φ k) ∩ A₁) := by
      filter_upwards [ENNReal.tendsto_nhds_zero.1 ha ε (by exact_mod_cast hε)] with k hk
      rw [tsub_le_iff_left]
      have hsplit : ball (0 : Euclid (d + 1)) 1 \ {y | u k y ≠ 0} =
          ball (0 : Euclid (d + 1)) 1 ∩ {y | u k y = 0} := by
        ext y
        simp
      calc volume (ball (0 : Euclid (d + 1)) 1)
          ≤ volume (ball (0 : Euclid (d + 1)) 1 ∩ {y | u k y ≠ 0}) +
              volume (ball (0 : Euclid (d + 1)) 1 \ {y | u k y ≠ 0}) :=
            measure_le_inter_add_sdiff _ _ _
        _ ≤ μHE[(d + 1)] (Ns (φ k) ∩ A₁) + ε := by
            rw [hsplit]
            exact add_le_add (hnz k) ((hzero k).trans hk)
        _ = ε + μHE[(d + 1)] (Ns (φ k) ∩ A₁) := add_comm _ _
    have h1 : volume (ball (0 : Euclid (d + 1)) 1) - ε ≤ ν A₁ :=
      calc volume (ball (0 : Euclid (d + 1)) 1) - ε
          ≤ liminf (fun k => μHE[(d + 1)] (Ns (φ k) ∩ A₁)) atTop :=
            le_liminf_of_le (by isBoundedDefault) hev
        _ ≤ limsup (fun k => μHE[(d + 1)] (Ns (φ k) ∩ A₁)) atTop := liminf_le_limsup
        _ ≤ limsup (fun k => μHE[(d + 1)] (Ns k ∩ A₁)) atTop :=
            hφ.tendsto_atTop.limsup_comp_le_limsup (u := fun k => μHE[(d + 1)] (Ns k ∩ A₁))
        _ ≤ ν A₁ := hNlim A₁ hA₁c
    exact tsub_le_iff_right.1 h1
  -- `ν(A₁) = α_{i₀} Lⁿ(B̄₁)`
  have hνA₁ : ν A₁ = ENNReal.ofReal (α i₀) * volume (closedBall (0 : Euclid (d + 1)) 1) := by
    have hA₁sub : A₁ ⊆ {x | g x < 3 * δ} := fun x hx => lt_of_le_of_lt hx.1 ht3
    rw [hνsub A₁ hA₁sub, ← hmap0, Measure.map_apply pL.continuous.measurable
      measurableSet_closedBall, Measure.restrict_apply' hPlmeas, Measure.restrict_apply' hPlmeas]
    congr 2
    ext x
    constructor
    · rintro ⟨⟨_, hx⟩, hxP⟩
      exact ⟨hx, hxP⟩
    · rintro ⟨hx, hxP⟩
      exact ⟨⟨hFS (hPlF hxP), hx⟩, hxP⟩
  -- conclusion: `Lⁿ(B₁) ≤ α_{i₀} Lⁿ(B₁)` with `0 < Lⁿ(B₁) < ∞`
  rw [hνA₁, Measure.addHaar_closedBall_eq_addHaar_ball] at hvol
  have hball : volume (ball (0 : Euclid (d + 1)) 1) ≠ 0 := (measure_ball_pos _ _ one_pos).ne'
  have hball' : volume (ball (0 : Euclid (d + 1)) 1) ≠ ∞ := measure_ball_lt_top.ne
  have h1 : 1 * volume (ball (0 : Euclid (d + 1)) 1) ≤
      ENNReal.ofReal (α i₀) * volume (ball (0 : Euclid (d + 1)) 1) := by
    rwa [one_mul]
  exact ENNReal.one_le_ofReal.1 ((ENNReal.mul_le_mul_iff_left hball hball').1 h1)

/-- **A positive multiple of an oriented `n`-plane with the integer slice property has integer
multiplicity** (Simon Ch. 6, 8.2, the integrality step; step 10 of the integer multiplicity
criterion for cycles).  Here `n = d + 1`, `v = (v₁, …, vₙ)` is orthonormal, `V₀ = span v`, `θ₀ > 0`,
`C(ω) = θ₀ ∫_{V₀} ⟨ω, v₁ ∧ ⋯ ∧ vₙ⟩ dHⁿ`, and `C` has the integer slice property.
`Submission.cbr_cipi_slice_integer_multiplicity` (slicing `C` by `⟨·, v₁⟩` with (SL), plus the
half-space Stokes formula) gives, for `L¹`-a.e. `t`, an integer multiplicity current `Z` with
`Z(φ) = θ₀ ∫_{L_t} ⟨φ, v₂ ∧ ⋯ ∧ vₙ⟩ dH^d`, where `L_t = t v₁ + span(v₂, …, vₙ)`.  The a.e.
filter of `L¹` is non-trivial, so fix such `t` and `Z`, and an IMRep `R` of `Z`.  `(v₂, …, vₙ)` is
orthonormal, so `Submission.cbr_cipi_affine_plane_measure` shows that `L_t` is closed and that
`ν = H^d⌞L_t` is finite on compact sets and positive on `B₁(t v₁)`.  Let
`ζ₀ = θ₀ (v₂ ∧ ⋯ ∧ vₙ)`, i.e. `⟨α, ζ₀⟩ = θ₀ α(v₂, …, vₙ)`.  Then `|⟨α, ζ₀⟩| ≤ θ₀ |α|`
(`Submission.regcomp_covector_eval_orthonormal_le`), `⟨β, ζ₀⟩ = θ₀` for some `β` with `|β| = 1`
(`Submission.regcomp_exists_covector_eval_orthonormal_eq_one`), and `Z(φ) = ∫ ⟨φ, ζ₀⟩ dν`.  So
`Submission.cbr_ci_const_vector_massOn` gives `M_G(Z) = θ₀ ν(G)` for every open `G`, and (MR) gives
`M_G(Z) = R.measure(G)`.  Hence `R.measure(G) = θ₀ ν(G)` for every open `G`, and
`Submission.cbr_cipi_imrep_weight_const_nat` gives `θ₀ ∈ ℕ`. -/
theorem Submission.cbr_ci_plane_multiplicity_nat : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → (∀ (P k : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U (k + 1)) (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (k + 1)) (ξ' : Euclid P → MultiVector P k) (f : Euclid P → ℝ) (L : NNReal), IsOpen U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (k + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) k, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn U (k + 1), T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) → (∀ η : TestFormOn U k, T.boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') → LipschitzWith L f → ∃ (A : ℝ → GeometricCurrentOn U (k + 1)) (B : ℝ → GeometricCurrentOn U k), (∀ (t : ℝ) (ω : TestFormOn U (k + 1)), A t ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (k + 1)) x) ∂μ) ∧ (∀ (t : ℝ) (η : TestFormOn U k), B t η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) k) x) ∂μ') ∧ (∀ (t : ℝ) (η : TestFormOn U k), Disjoint (tsupport (η : DifferentialForm (Euclid P) k)) {x | f x = t} → (A t).boundary η = B t η) ∧ (∀ (W : Set (Euclid P)) (t : ℝ), IsOpen W → ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * liminf (fun h : ℝ => ENNReal.ofReal h⁻¹ * μ (W ∩ {x | t - h < f x ∧ f x < t})) (𝓝[>] 0)) ∧ (∀ (W : Set (Euclid P)) (a b : ℝ), IsOpen W → ∫⁻ t in Ioo a b, ((A t).boundary - B t).massOn W ≤ (L : ℝ≥0∞) * μ (W ∩ {x | a < f x ∧ f x < b}))) → ∀ (P d : ℕ) (v : Fin (d + 1) → Euclid P) (θ₀ : ℝ) (C : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)), Orthonormal ℝ v → 0 < θ₀ → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = θ₀ * ∫ y in (Submodule.span ℝ (Set.range v) : Set (Euclid P)), (ω : DifferentialForm (Euclid P) (d + 1)) y v ∂μHE[(d + 1)]) → (∀ (μ μ' : Measure (Euclid P)) (ξ : Euclid P → MultiVector P (d + 1)) (ξ' : Euclid P → MultiVector P d), (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → (∀ K : Set (Euclid P), IsCompact K → μ' K < ∞) → AEStronglyMeasurable ξ μ → AEStronglyMeasurable ξ' μ' → (∀ᵐ x ∂μ, ∀ α : Covector (Euclid P) (d + 1), |ξ x α| ≤ covectorEuclideanNorm α) → (∀ᵐ x ∂μ', ∀ α : Covector (Euclid P) d, |ξ' x α| ≤ covectorEuclideanNorm α) → (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), C ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, (C).boundary η = ∫ x, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → ∀ (f : Euclid P → ℝ) (L : NNReal), LipschitzWith L f → ∀ᵐ t ∂(volume : Measure ℝ), ∀ (A : GeometricCurrentOn (univ : Set (Euclid P)) (d + 1)) (B : GeometricCurrentOn (univ : Set (Euclid P)) d), (∀ ω : TestFormOn (univ : Set (Euclid P)) (d + 1), A ω = ∫ x in {x | f x < t}, ξ x ((ω : DifferentialForm (Euclid P) (d + 1)) x) ∂μ) → (∀ η : TestFormOn (univ : Set (Euclid P)) d, B η = ∫ x in {x | f x < t}, ξ' x ((η : DifferentialForm (Euclid P) d) x) ∂μ') → IsIntegerMultiplicity (A.boundary - B)) → ∃ m : ℕ, θ₀ = m := by
  intro hMR hSL P d v θ₀ C hv hθ₀ hC hISP
  -- Step 1: for a.e. `t` the slice boundary `Z` is integer multiplicity, with
  -- `Z(φ) = θ₀ ∫_{L_t} ⟨φ, v₂ ∧ ⋯ ∧ vₙ⟩ dH^d`; the a.e. filter on `ℝ` is non-trivial
  obtain ⟨t, Z, ⟨R, hR⟩, hZ⟩ :=
    (Submission.cbr_cipi_slice_integer_multiplicity hSL P d v θ₀ C hv hθ₀ hC hISP).exists
