    let D := (Matrix.of fun i j => inner ℝ (τ i) (b j)).det
    have hD : D = (Matrix.of fun i j => inner ℝ (τ i) (b j)).det := rfl
    have hbτ : ∀ α : Covector (Euclid P) n, α b = D * α τ :=
