    (ENNReal.ofReal (2 ^ ((n : ℝ) / 2)) * unitBallVolume n) C₉ (σ₀ / 8)
    isClosed_closedBall.measurableSet (fun η hη => hη.1.1) (fun η hη r hr => hFH η hη.1.1 r hr)
