  have hinvΓ : ∀ v ∈ L, ∀ᵐ z ∂(μHE[n] : Measure (Euclid P)), Γ (z + v) = Γ z := by
    intro v hv
    obtain ⟨Rv, hRvc, hRvm, hRvo⟩ := htrans n Rt (-v)
    have hRvS : Rv.Represents S := by
