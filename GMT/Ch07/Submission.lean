  let Γ : Euclid P → ℝ≥0∞ × MultiVector P n := fun z =>
    (M.indicator (fun x => (R.mult x : ℝ≥0∞)) z, M.indicator (fun x => (R.mult x : ℝ) • ξt x) z)
