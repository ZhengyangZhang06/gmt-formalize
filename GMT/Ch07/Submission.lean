    refine ⟨fun y => g (Φ y), fun y => ?_, hui, ?_, fun ω => ?_⟩
    · -- Step 4(b): `u` is integer valued
      by_cases hy : Φ y ∈ R.carrier
      · exact ⟨(R.mult (Φ y) : ℤ) * σ (Φ y), by simp only [indicator_of_mem hy, Int.cast_mul, Int.cast_natCast, g]⟩
