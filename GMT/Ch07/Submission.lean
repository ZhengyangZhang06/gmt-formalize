      (∀ᵐ x ∂(μHE[m].restrict (R.carrier ∩ {x | L.starProjection x = t})), ξ' x = R.orient x ∧
        ∃ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n R.carrier x Q ∧
