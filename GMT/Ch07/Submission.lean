/-- **First variation bound for the mass of a deformation** (Simon Ch. 4, 2.2; Ch. 2, 5.2–5.3).
Let `R = (M, θ, ξ)`, `μ_V(W) = ∫_{M ∩ W} θ dHⁿ < ∞`, `X ∈ C¹_c` with `spt X ⊆ W`, and let `φₜ` be
`C¹` maps with `φₜ = id` off `spt X` and `‖Dφₜ − I − t DX‖ ≤ ε|t|` for small `|t|`.  If `S` acts by
`S(ω) = ∫_M θ ⟨ω(φₜx) ∘ Dφₜ(x), ξ(x)⟩ dHⁿ`, then `M_W(S) ≤ μ_V(W) + t δV(X) + ε|t|` for small `|t|`.
At a.e. `x ∈ M`, `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ` for an orthonormal basis `τ` of `TₓM` and
`div_M X(x) = Σₐ τₐ · DX(x)τₐ`, so on `W` the integrand is at most
`θ |ω|_E det(Dφₜτᵢ · Dφₜτⱼ)^{1/2} ≤ θ (1 + t div_M X + ε'|t|)`, `ε' = ε/(μ_V(W) + 1)`; off `W`,
`φₜ x = x ∉ spt ω` and the integrand vanishes.  Integrate (a non-integrable integrand has integral
`0` and the bound is nonnegative) and take the supremum over admissible `ω`. -/
theorem Submission.pushforward_action_massOn_le_first_variation : ∀ (P n : ℕ) (U W : Set (Euclid P)) (R : IMRep U n) (X : Euclid P → Euclid P) (φ : ℝ → Euclid P → Euclid P), IsOpen W → R.measure W ≠ ∞ → ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ W → (∀ t, ContDiff ℝ 1 (φ t)) → (∀ t x, x ∉ tsupport X → φ t x = x) → (∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ t : ℝ, |t| < δ → ∀ x, ‖fderiv ℝ (φ t) x - ContinuousLinearMap.id ℝ (Euclid P) - t • fderiv ℝ X x‖ ≤ ε * |t|) → ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ t : ℝ, |t| < δ → ∀ S : GeometricCurrentOn U n, (∀ ω : TestFormOn U n, S ω = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (((ω : DifferentialForm (Euclid P) n) (φ t x)).compContinuousLinearMap (fderiv ℝ (φ t) x)) ∂μHE[n]) → S.massOn W ≤ ENNReal.ofReal ((R.measure W).toReal + t * R.firstVariation X + ε * |t|) := by
  intro P n U W R X φ hWo hRW hX hXc hXW _hφ hφid hφD ε hε
  classical
  have hDXc : Continuous (fderiv ℝ X) := hX.continuous_fderiv one_ne_zero
  -- `div_M X = trace(p_{TₓM} ∘ DX)` is a.e. strongly measurable: `p_{TₓM}` is (TM) and the trace
  -- of a composition is continuous
  have hdvm : AEStronglyMeasurable (tangentialDivergence n R.carrier X)
      (μHE[n].restrict R.carrier) := by
    have h1 : Continuous fun L : Euclid P →L[ℝ] Euclid P =>
        LinearMap.trace ℝ (Euclid P) L.toLinearMap :=
      ((LinearMap.trace ℝ (Euclid P)).comp
        (ContinuousLinearMap.coeLM ℝ)).continuous_of_finiteDimensional
    have h2 : Continuous fun pL : (Euclid P →L[ℝ] Euclid P) × (Euclid P →L[ℝ] Euclid P) =>
        LinearMap.trace ℝ (Euclid P) (pL.1.comp pL.2).toLinearMap :=
      h1.comp (continuous_fst.clm_comp continuous_snd)
    have h3 : Continuous fun pL : (Euclid P →L[ℝ] Euclid P) × (Euclid P →L[ℝ] Euclid P) =>
        LinearMap.trace ℝ (Euclid P) (pL.1.toLinearMap ∘ₗ pL.2.toLinearMap) := by
      simpa only [ContinuousLinearMap.toLinearMap_comp] using h2
    have hq := (Submission.imrep_approxTangent_starProjection_aesm P n U R).prodMk
      hDXc.aestronglyMeasurable
    have hr := h3.comp_aestronglyMeasurable hq
    exact hr
  set μ : Measure (Euclid P) := μHE[n].restrict R.carrier
  set θ : Euclid P → ℝ := fun x => (R.mult x : ℝ) with hθ
  set dv : Euclid P → ℝ := tangentialDivergence n R.carrier X
  set m : ℝ := (R.measure W).toReal with hm
  have hθ0 : ∀ x, 0 ≤ θ x := fun x => Nat.cast_nonneg _
  have hm0 : 0 ≤ m := ENNReal.toReal_nonneg
  -- `A` bounds `‖DX‖`: `DX` is continuous with compact support
  obtain ⟨C, hC⟩ := hDXc.bounded_above_of_compact_support (hXc.fderiv ℝ)
  set A : ℝ := max C 0
  have hA0 : 0 ≤ A := le_max_right _ _
  have hDXA : ∀ x, ‖fderiv ℝ X x‖ ≤ A := fun x => (hC x).trans (le_max_left _ _)
  -- constants: `ε' = ε / (m + 1)`; `η, δ₁` from the Jacobian bound at `(A, ε')`; `δ₂` from the
  -- hypothesis on `Dφₜ` at `η`
  set ε' : ℝ := ε / (m + 1) with hε'
  have hε'0 : 0 < ε' := div_pos hε (by linarith)
  obtain ⟨η, hη, δ₁, hδ₁, hJ⟩ :=
    Submission.fvmb_orthonormal_gram_sqrt_det_le_first_order P n A ε' hA0 hε'0
  obtain ⟨δ₂, hδ₂, hD⟩ := hφD η hη
  refine ⟨min δ₁ δ₂, lt_min hδ₁ hδ₂, fun t ht S hS => ?_⟩
  have ht₁ : |t| < δ₁ := ht.trans_le (min_le_left _ _)
  have ht₂ : |t| < δ₂ := ht.trans_le (min_le_right _ _)
  -- `θ 1_W` is integrable with integral `m`: `∫_{M ∩ W} θ dHⁿ = μ_V(W) < ∞`
  have hWm : MeasurableSet W := hWo.measurableSet
  have hθm : Measurable θ :=
    (measurable_from_nat (f := (Nat.cast : ℕ → ℝ))).comp R.measurable_mult
  have hRW' : R.measure W = ∫⁻ x in W, (R.mult x : ℝ≥0∞) ∂μ := withDensity_apply _ hWm
  have hθW : Integrable (W.indicator θ) μ := by
    rw [integrable_indicator_iff hWm]
    have := integrable_toReal_of_lintegral_ne_top (μ := μ.restrict W)
      (f := fun x => (R.mult x : ℝ≥0∞))
      ((measurable_from_nat (f := (Nat.cast : ℕ → ℝ≥0∞))).comp R.measurable_mult).aemeasurable
      (hRW' ▸ hRW)
    simpa [IntegrableOn, hθ] using this
  have hmW : ∫ x, W.indicator θ x ∂μ = m := by
    rw [integral_indicator hWm, integral_eq_lintegral_of_nonneg_ae (ae_of_all _ hθ0)
      hθm.aestronglyMeasurable, hm, hRW']
    simp only [hθ, ENNReal.ofReal_natCast]
  -- fix an admissible form `ω`; `g` is the integrand of `S(ω)` and `h` its majorant
  apply sSup_le
  rintro r ⟨ω, ⟨hωW, hω1⟩, rfl⟩
  apply ENNReal.ofReal_le_ofReal
  rw [hS ω]
  obtain ⟨g, hg⟩ : ∃ g : Euclid P → ℝ, g = fun x => (R.mult x : ℝ) * R.orient x
      (((ω : DifferentialForm (Euclid P) n) (φ t x)).compContinuousLinearMap
        (fderiv ℝ (φ t) x)) := ⟨_, rfl⟩
  obtain ⟨h, hh⟩ : ∃ h : Euclid P → ℝ,
      h = fun x => W.indicator θ x * (1 + ε' * |t|) + t * (θ x * dv x) := ⟨_, rfl⟩
  -- pointwise bounds at the a.e. points where `ξ(x)` orients `TₓM`
  have key : ∀ᵐ x ∂μ,
      g x ≤ h x ∧ 0 ≤ h x ∧ ‖θ x * dv x‖ ≤ ((n : ℝ) * A) * W.indicator θ x := by
    filter_upwards [Submission.fvmb_imrep_ae_unitOrientation_approxTangentPlane P n U R]
      with x hx
    obtain ⟨τ, hτ, hspan, hsign⟩ := hx
    -- `div_M X(x) = Σₐ τₐ · DX(x)τₐ`, hence `|div_M X(x)| ≤ nA`
    have hdvx : dv x = ∑ a, inner ℝ (τ a) (fderiv ℝ X x (τ a)) :=
      Submission.fvmb_trace_starProjection_comp_eq_sum_inner P n _ τ (fderiv ℝ X x) hτ hspan
    have hdvA : |dv x| ≤ n * A := by
      rw [hdvx]
      calc |∑ a, inner ℝ (τ a) (fderiv ℝ X x (τ a))|
          ≤ ∑ a, |inner ℝ (τ a) (fderiv ℝ X x (τ a))| := Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ _a : Fin n, A := Finset.sum_le_sum fun a _ => by
          calc |inner ℝ (τ a) (fderiv ℝ X x (τ a))|
              ≤ ‖τ a‖ * ‖fderiv ℝ X x (τ a)‖ := abs_real_inner_le_norm _ _
            _ ≤ ‖τ a‖ * (‖fderiv ℝ X x‖ * ‖τ a‖) :=
              mul_le_mul_of_nonneg_left (ContinuousLinearMap.le_opNorm _ _) (norm_nonneg _)
            _ ≤ A := by rw [hτ.1 a, one_mul, mul_one]; exact hDXA x
        _ = n * A := by simp
    by_cases hxW : x ∈ W
    · -- in `W`, with `β = ω(φₜx) ∘ Dφₜ(x)`:
      -- `|ξ(x)(β)| = |ω(φₜx)(Dφₜτ)| ≤ |ω|_E det(Dφₜτᵢ · Dφₜτⱼ)^{1/2} ≤ 1 + t div_M X + ε'|t|`
      obtain ⟨β, hβ⟩ : ∃ β : Covector (Euclid P) n,
          β = ((ω : DifferentialForm (Euclid P) n) (φ t x)).compContinuousLinearMap
            (fderiv ℝ (φ t) x) := ⟨_, rfl⟩
      have hξ : |R.orient x β| =
          |(ω : DifferentialForm (Euclid P) n) (φ t x) fun i => fderiv ℝ (φ t) x (τ i)| := by
        rcases hsign with hs | hs
        · rw [hs, hβ, ContinuousAlternatingMap.compContinuousLinearMap_apply]
          rfl
        · rw [hs, abs_neg, hβ, ContinuousAlternatingMap.compContinuousLinearMap_apply]
          rfl
      have hJx := hJ t ht₁ (fderiv ℝ X x) (fderiv ℝ (φ t) x) (hDXA x) (hD t ht₂ x) τ hτ
      rw [← hdvx] at hJx
      have hbound : |R.orient x β| ≤ 1 + t * dv x + ε' * |t| := by
        rw [hξ]
        refine ((Submission.covectorEuclideanNorm_gram_bounds P n).1 _ _).trans ?_
        exact (mul_le_of_le_one_left (Real.sqrt_nonneg _) (hω1 _)).trans hJx
      have hgx : g x = θ x * R.orient x β := by
        rw [hg, hβ]
      have hhx : h x = θ x * (1 + t * dv x + ε' * |t|) := by
        simp only [hh, Set.indicator_of_mem hxW]
        ring
      refine ⟨?_, ?_, ?_⟩
      · rw [hgx, hhx]
        exact mul_le_mul_of_nonneg_left ((le_abs_self _).trans hbound) (hθ0 x)
      · rw [hhx]
        exact mul_nonneg (hθ0 x) ((abs_nonneg _).trans hbound)
      · rw [Set.indicator_of_mem hxW, Real.norm_eq_abs, abs_mul, abs_of_nonneg (hθ0 x)]
        calc θ x * |dv x| ≤ θ x * (n * A) := mul_le_mul_of_nonneg_left hdvA (hθ0 x)
          _ = n * A * θ x := by ring
    · -- off `W`: `x ∉ spt X`, so `DX(x) = 0` and `φₜ x = x ∉ spt ω`
      have hxX : x ∉ tsupport X := fun hx => hxW (hXW hx)
      have hdv0 : dv x = 0 := by
        rw [hdvx, fderiv_of_notMem_tsupport ℝ hxX]
        simp
      have hω0 : (ω : DifferentialForm (Euclid P) n) (φ t x) = 0 := by
        rw [hφid t x hxX]
        exact image_eq_zero_of_notMem_tsupport fun hx => hxW (hωW hx)
      have hz : (0 : Covector (Euclid P) n).compContinuousLinearMap (fderiv ℝ (φ t) x) = 0 := by
        ext v
        simp
      have hg0 : g x = 0 := by
        simp only [hg, hω0, hz, map_zero, mul_zero]
      have hh0 : h x = 0 := by
        simp only [hh, Set.indicator_of_notMem hxW, hdv0, zero_mul, mul_zero, add_zero]
      refine ⟨by rw [hg0, hh0], by rw [hh0], ?_⟩
      rw [hdv0, Set.indicator_of_notMem hxW]
      simp
  -- integrate: `∫ g ≤ ∫ h = m (1 + ε'|t|) + t δV(X)` and `m ε' ≤ ε`
  have hθdv : Integrable (fun x => θ x * dv x) μ :=
    (hθW.const_mul ((n : ℝ) * A)).mono' (hθm.aestronglyMeasurable.mul hdvm)
      (key.mono fun x hx => hx.2.2)
  have hhint : Integrable h μ := by
    rw [hh]
    exact (hθW.mul_const _).add (hθdv.const_mul t)
  have hint_h : ∫ x, h x ∂μ = m * (1 + ε' * |t|) + t * R.firstVariation X := by
    simp only [hh]
    rw [integral_add (hθW.mul_const _) (hθdv.const_mul t), integral_mul_const,
      integral_const_mul, hmW]
    rfl
  have hgh : ∫ x, g x ∂μ ≤ ∫ x, h x ∂μ := by
    by_cases hgi : Integrable g μ
    · exact integral_mono_ae hgi hhint (key.mono fun x hx => hx.1)
    · rw [integral_undef hgi]
      exact integral_nonneg_of_ae (key.mono fun x hx => hx.2.1)
  have hεm : m * ε' ≤ ε := by
    rw [hε', mul_div_assoc', div_le_iff₀ (by linarith)]
    nlinarith
  have hεm' : m * ε' * |t| ≤ ε * |t| := mul_le_mul_of_nonneg_right hεm (abs_nonneg t)
  calc ∫ x, (R.mult x : ℝ) * R.orient x
        (((ω : DifferentialForm (Euclid P) n) (φ t x)).compContinuousLinearMap
          (fderiv ℝ (φ t) x)) ∂μ = ∫ x, g x ∂μ := by rw [hg]
    _ ≤ ∫ x, h x ∂μ := hgh
    _ = m * (1 + ε' * |t|) + t * R.firstVariation X := hint_h
    _ = m + t * R.firstVariation X + m * ε' * |t| := by ring
    _ ≤ m + t * R.firstVariation X + ε * |t| := by linarith

/-- **Simon 7.1.2, first claim (pp. 181–182).**  If `T ∈ 𝒟ₙ(U)` is minimizing in `N ∩ U`
(`N` an embedded `C²` submanifold, `(N̄ \ N) ∩ U = ∅`), `∂T = 0` in `U`, and `T = τ(M, θ, ξ)` with
`Hⁿ(M \ N) = 0`, then `V = v(M, θ)` is stationary in `N ∩ U`.  Fix `X` tangent to `N` and an
open `W ⊂⊂ U` containing `spt X`.  If `μ_V(W) = 0`, then `div_M X = 0` `μ_V`-a.e.  Otherwise the
deformations `φ_t` push `T` forward to competitors with `spt(φ_{t#}T − T) ⊆ spt X ∩ N`, so
`μ_V(W) ≤ M_W(φ_{t#}T) ≤ μ_V(W) + t δV(X) + ε|t|` for all small `t` of both signs, which forces
`δV(X) = 0`.  No separate case `n = 0` is needed, since `∂S = ∂T` is vacuous there. -/
theorem Submission.stationaryAlong_of_minimizing_in_submanifold :
    ∀ (P n d : ℕ) (U N : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n),
      IsOpen U → IsEmbeddedSubmanifold 2 d N → (closure N \ N) ∩ U = ∅ →
      IsMinimizingIn T (N ∩ U) → BoundaryVanishes T → R.Represents T →
      μHE[n] (R.carrier \ N) = 0 → R.IsStationaryAlong N := by
  intro P n d U N T R hU hN hNU hmin hT hR hMN X hX hXc hXU hXN
  -- `∂S₁ = 0 = ∂S₂` gives `∂S₁ = ∂S₂` (vacuous in degree `0`).
  have hsame : ∀ {m : ℕ} (S₁ S₂ : GeometricCurrentOn U m), BoundaryVanishes S₁ →
      BoundaryVanishes S₂ → SameBoundary S₁ S₂ := by
    intro m S₁ S₂ h₁ h₂
    cases m with
    | zero => trivial
    | succ m => exact (show S₁.boundary = 0 from h₁).trans (show S₂.boundary = 0 from h₂).symm
  -- An open `W ⊂⊂ U` containing `K = spt X`, with `μ_V(W) < ∞` and `M_W(T) = μ_V(W)`.
  obtain ⟨W, hWo, hKW, hWU, hWc⟩ := exists_open_between_and_isCompact_closure hXc hU hXU
  have hWm : MeasurableSet W := hWo.measurableSet
  have hRW : R.measure W = ∫⁻ x in W, (R.mult x : ℝ≥0∞) ∂(μHE[n].restrict R.carrier) := by
    rw [IMRep.measure, withDensity_apply _ hWm]
  have hRWfin : R.measure W ≠ ∞ := by
    rw [hRW, Measure.restrict_restrict hWm]
    refine ne_top_of_le_ne_top (R.locallyIntegrable_mult _ hWc hWU) (lintegral_mono_set ?_)
    exact fun x hx => ⟨hx.2, subset_closure hx.1⟩
  have hTW : T.massOn W = R.measure W :=
    Submission.imrep_represents_massOn_eq_measure P n U W T R hU hR hWo
      (subset_closure.trans hWU)
  -- If `μ_V(W) = 0`, then `Hⁿ(M ∩ W) = 0` and `DX = 0` off `W`, so `div_M X = 0` a.e. on `M`.
  by_cases hW0 : R.measure W = 0
  · have hMW : μHE[n].restrict R.carrier W = 0 := by
      refine le_antisymm ?_ bot_le
      calc μHE[n].restrict R.carrier W
          = ∫⁻ _ in W, 1 ∂(μHE[n].restrict R.carrier) := (setLIntegral_one W).symm
        _ ≤ ∫⁻ x in W, (R.mult x : ℝ≥0∞) ∂(μHE[n].restrict R.carrier) := by
          refine lintegral_mono_ae ?_
          filter_upwards [ae_restrict_of_ae (ae_restrict_mem R.measurableSet_carrier)] with x hx
          exact Nat.one_le_cast.2 (R.mult_pos x hx)
        _ = 0 := by rw [← hRW, hW0]
    rw [IMRep.firstVariation]
    refine integral_eq_zero_of_ae ?_
    filter_upwards [measure_eq_zero_iff_ae_notMem.1 hMW] with x hx
    have hDX : fderiv ℝ X x = 0 := fderiv_of_notMem_tsupport ℝ fun h => hx (hKW h)
    simp [tangentialDivergence, hDX]
  have hm : 0 < (R.measure W).toReal := ENNReal.toReal_pos hW0 hRWfin
  -- The deformations `φ_t` along `N`, fixing `ℝᴾ \ K` pointwise.
  obtain ⟨φ, hφ, hφD⟩ :=
    Submission.tangential_c1_deformation_exists P d U N X hU hN hNU hX hXc hXU hXN
  -- `K ∩ N = K ∩ N̄` is compact, since `(N̄ \ N) ∩ U = ∅` and `K ⊆ U`.
  have hKNc : IsCompact (tsupport X ∩ N) := by
    have h : tsupport X ∩ N = tsupport X ∩ closure N := by
      refine Subset.antisymm (inter_subset_inter_right _ subset_closure) ?_
      rintro x ⟨hxK, hxN⟩
      refine ⟨hxK, ?_⟩
      by_contra h
      exact hNU.subset ⟨⟨hxN, h⟩, hXU hxK⟩
    rw [h]
    exact hXc.inter_right isClosed_closure
  -- Every push-forward `φ_{t#}T` is an admissible competitor in 7.1.1, so `μ_V(W) ≤ M_W(φ_{t#}T)`.
  have hcomp : ∀ (t : ℝ) (S : GeometricCurrentOn U n), IsIntegerMultiplicity S →
      BoundaryVanishes S →
      (∀ ω : TestFormOn U n, S ω = ∫ x in R.carrier, (R.mult x : ℝ) *
        R.orient x (((ω : DifferentialForm (Euclid P) n) (φ t x)).compContinuousLinearMap
          (fderiv ℝ (φ t) x)) ∂μHE[n]) →
      R.measure W ≤ S.massOn W := by
    intro t S hSi hSb hSω
    -- `φ_t` is injective and fixes `ℝᴾ \ K` pointwise, so it maps `K` into `K`.
    have hφK : ∀ x ∈ tsupport X, φ t x ∈ tsupport X := by
      intro x hx
      by_contra h
      have hfix : φ t x = x := (hφ t).2.1.1 ((hφ t).2.2.2.1 _ h)
      exact h (by rwa [hfix])
    -- `spt(φ_{t#}T − T) ⊆ K ∩ N`: near `y ∉ K ∩ N` the integrands agree `Hⁿ`-a.e. on `M`.
    have hsub : (S - T).support ⊆ tsupport X ∩ N := by
      intro y hy
      by_contra hyKN
      obtain ⟨ε, hε, hεU⟩ :=
        Metric.isOpen_iff.1 (hU.inter hKNc.isClosed.isOpen_compl) y ⟨hy.1, hyKN⟩
      have hcl : closure (ball y (ε / 2)) ⊆ ball y ε :=
        closure_ball_subset_closedBall.trans (closedBall_subset_ball (half_lt_self hε))
      have hball : ball y (ε / 2) ∈ {V : Set (Euclid P) | IsOpen V ∧ IsCompact (closure V) ∧
          closure V ⊆ U ∧ (S - T).VanishesOn V} := by
        refine ⟨isOpen_ball,
          (isCompact_closedBall y (ε / 2)).closure_of_subset ball_subset_closedBall,
          fun z hz => (hεU (hcl hz)).1, ?_⟩
        intro ω hω
        have hω0 : ∀ z ∈ tsupport X ∩ N, (ω : DifferentialForm (Euclid P) n) z = 0 :=
          fun z hz => image_eq_zero_of_notMem_tsupport fun hzω =>
            (hεU (ball_subset_ball (half_le_self hε.le) (hω hzω))).2 hz
        change S ω - T ω = 0
        rw [hSω ω, hR ω, IMRep.action, sub_eq_zero]
        refine setIntegral_congr_ae R.measurableSet_carrier ?_
        filter_upwards [measure_eq_zero_iff_ae_notMem.1 hMN] with x hxMN hxM
        have hxN : x ∈ N := by
          by_contra h
          exact hxMN ⟨hxM, h⟩
        have harg : ((ω : DifferentialForm (Euclid P) n) (φ t x)).compContinuousLinearMap
            (fderiv ℝ (φ t) x) = (ω : DifferentialForm (Euclid P) n) x := by
          by_cases hxK : x ∈ tsupport X
          · rw [hω0 x ⟨hxK, hxN⟩, hω0 (φ t x) ⟨hφK x hxK, ((hφ t).2.2.2.2 ⟨hxN, hXU hxK⟩).1⟩]
            ext v
            simp
          · have hφx : φ t =ᶠ[𝓝 x] id := by
              filter_upwards [(isClosed_tsupport X).isOpen_compl.mem_nhds hxK] with z hz
              exact (hφ t).2.2.2.1 z hz
            rw [hφx.fderiv_eq, fderiv_id, (hφ t).2.2.2.1 x hxK]
            ext v
            simp
        rw [harg]
      exact hy.2 (mem_sUnion_of_mem (mem_ball_self (half_pos hε)) hball)
    have hSTc : IsCompact (S - T).support := by
      have h : (S - T).support = (tsupport X ∩ N) ∩ ((S - T).zeroRegion)ᶜ :=
        Subset.antisymm (fun y hy => ⟨hsub hy, hy.2⟩) fun y hy => ⟨hXU hy.1.1, hy.2⟩
      rw [h]
      exact hKNc.inter_right (S - T).isOpen_zeroRegion.isClosed_compl
    rw [← hTW]
    exact hmin.2 W S hWo ⟨hWc, hWU⟩ hSi (hsame S T hSb hT) hSTc fun y hy =>
      ⟨⟨(hsub hy).2, hXU (hsub hy).1⟩, hKW (hsub hy).1⟩
  -- The expansion `M_W(φ_{t#}T) ≤ μ_V(W) + t δV(X) + ε|t|` for `|t| < δ` gives `|δV(X)| ≤ ε`.
  have hbound : ∀ ε : ℝ, 0 < ε → |R.firstVariation X| ≤ ε := by
    intro ε hε
    obtain ⟨δ, hδ, hδS⟩ := Submission.pushforward_action_massOn_le_first_variation P n U W R X
      φ hWo hRWfin hX hXc hKW (fun t => (hφ t).1) (fun t => (hφ t).2.2.2.1) hφD ε hε
    have key : ∀ t : ℝ, |t| < δ → 0 ≤ t * R.firstVariation X + ε * |t| := by
      intro t ht
      obtain ⟨S, hSi, hSb, hSω⟩ := Submission.imrep_c1_diffeo_pushforward_im P n U
        (tsupport X) T R (φ t) hU hR hXc hXU (hφ t).1 (hφ t).2.1 (hφ t).2.2.1 (hφ t).2.2.2.1
      have h := (ENNReal.ofReal_toReal hRWfin).le.trans
        ((hcomp t S hSi (hSb hT) hSω).trans (hδS t ht S hSω))
      by_contra hneg
      exact not_lt.2 h ((ENNReal.ofReal_lt_ofReal_iff hm).2 (by linarith [not_le.1 hneg]))
    have h₁ := key (δ / 2) (by rw [abs_of_pos (half_pos hδ)]; exact half_lt_self hδ)
    have h₂ := key (-(δ / 2)) (by rw [abs_neg, abs_of_pos (half_pos hδ)]; exact half_lt_self hδ)
    rw [abs_of_pos (half_pos hδ)] at h₁
    rw [abs_neg, abs_of_pos (half_pos hδ)] at h₂
    rw [abs_le]
    constructor <;> nlinarith
  by_contra ha
  have h := hbound (|R.firstVariation X| / 2) (half_pos (abs_pos.2 ha))
  linarith [abs_pos.2 ha]

/-- **`TₓM ⊆ TₓN`** (Simon Ch. 3, 1.4 and Ch. 2, §4, (4.1)–(4.3); used in Ch. 4, 2.6–2.7).  Let
`N` be an embedded `C¹` `d`-dimensional submanifold, `Hⁿ(M \ N) = 0` and `x ∈ N`.  Then every
approximate tangent plane `Q` of `M` at `x` lies in `TₓN`.  Write `x = ψ(v)` for a chart `ψ` of
`N` and `A = Dψ(v)`: `N` is flat at `x` along `A(ℝᵈ)` (`atsm_chart_image_flat`), hence
`Q ⊆ A(ℝᵈ)` (`atsm_approxTangent_le_of_flat`), and `A(ℝᵈ) = TₓN`
(`chart_tangentSpace_eq_range_fderiv`). -/
theorem Submission.approxTangent_le_submanifold_tangentSpace : ∀ (P n d : ℕ) (N M : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)), IsEmbeddedSubmanifold 1 d N → x ∈ N → μHE[n] (M \ N) = 0 → HasApproximateTangentSpaceAt n M x Q → (Q : Set (Euclid P)) ⊆ tangentSpace N x := by
  intro P n d N M x Q hN hxN hnull hQ
  -- a chart `ψ : V → W ∩ N` of `N` around `x`, and `v ∈ V` with `ψ v = x`
  obtain ⟨V, W, ψ, hV, hW, hxW, hψ, hinj, himg, hprop, hDψ⟩ := hN x hxN
  obtain ⟨v, hv, rfl⟩ : x ∈ ψ '' V := by
    rw [himg]
    exact ⟨hxW, hxN⟩
  -- `N` is flat at `ψ v` along `A(ℝᵈ)`, `A = Dψ(v)`
  have hflat : ∀ ε : ℝ, 0 < ε → ∃ ρ : ℝ, 0 < ρ ∧ ∀ z ∈ N, dist z (ψ v) < ρ →
      ∃ t ∈ LinearMap.range (fderiv ℝ ψ v : Euclid d →ₗ[ℝ] Euclid P),
        ‖z - ψ v - t‖ ≤ ε * ‖z - ψ v‖ := by
    intro ε hε
    obtain ⟨ρ, hρ, hρN⟩ := Submission.atsm_chart_image_flat P d N W V ψ v hV hW
      (by exact_mod_cast hψ) hinj himg hprop (hDψ v hv) hv ε hε
    refine ⟨ρ, hρ, fun z hz hzρ => ?_⟩
    obtain ⟨h, hh⟩ := hρN z hz hzρ
    exact ⟨_, LinearMap.mem_range_self (fderiv ℝ ψ v : Euclid d →ₗ[ℝ] Euclid P) h, hh⟩
  -- hence `Q ⊆ A(ℝᵈ)`, and `A(ℝᵈ) = T_{ψ v}N`
  have hQA := Submission.atsm_approxTangent_le_of_flat P n N M (ψ v) Q _ hnull hflat hQ
  rw [Submission.chart_tangentSpace_eq_range_fderiv P d 1 N W V ψ v le_rfl hV hW hψ hinj himg
    hprop hDψ hv]
  intro w hw
  exact LinearMap.mem_range.1 (hQA hw)

/-- **Additivity of the pairing with a bounded field** (the identity
`∫ ⟨φ, ν_Y⟩ dHⁿ = ∫ ⟨φ, ν_Z + ν_X⟩ dHⁿ` in the competitor mass bound of Simon 7.2.4 (8)–(9)).
Write `ν_R = 1_M θ ξ` for `R = (M, θ, ξ)`.  If `ν_R = ν_{R₁} + ν_{R₂}` `Hⁿ`-a.e. and `F` is
`Hⁿ`-a.e. strongly measurable, vanishes off the compact `K ⊆ U` and `‖F‖ ≤ B`, then
`∫_M θ ⟨F, ξ⟩ dHⁿ = ∫_{M₁} θ₁ ⟨F, ξ₁⟩ dHⁿ + ∫_{M₂} θ₂ ⟨F, ξ₂⟩ dHⁿ`.  Each side is the integral
over `ℝᴾ` of `⟨F, ν⟩ = 1_M θ ⟨F, ξ⟩`, integrable by `dpf_pfc_imrep_pairing_integrable_abs_le`. -/
theorem Submission.dor_lmb_pc_cm_pairing_add_of_bounded : ∀ (P n : ℕ) (U K : Set (Euclid P)) (R₁ R₂ R : IMRep U n) (F : Euclid P → Covector (Euclid P) n) (B : ℝ), IsCompact K → K ⊆ U → AEStronglyMeasurable F μHE[n] → (∀ x, x ∉ K → F x = 0) → (∀ x, ‖F x‖ ≤ B) → (∀ᵐ x ∂μHE[n], R.carrier.indicator (fun y => (R.mult y : ℝ) • R.orient y) x = R₁.carrier.indicator (fun y => (R₁.mult y : ℝ) • R₁.orient y) x + R₂.carrier.indicator (fun y => (R₂.mult y : ℝ) • R₂.orient y) x) → ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (F x) ∂μHE[n] = ∫ x in R₁.carrier, (R₁.mult x : ℝ) * R₁.orient x (F x) ∂μHE[n] + ∫ x in R₂.carrier, (R₂.mult x : ℝ) * R₂.orient x (F x) ∂μHE[n] := by
  intro P n U K R₁ R₂ R F B hK hKU hF hF0 hFB hvd
  -- Steps 1–3: for each `R'`, `⟨F, ν_{R'}⟩` is `Hⁿ`-integrable with integral `∫_{M'} θ' ⟨F, ξ'⟩`
  have key : ∀ R' : IMRep U n,
      Integrable (fun x => R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x (F x))
        μHE[n] ∧
      ∫ x, R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x (F x) ∂μHE[n] =
        ∫ x in R'.carrier, (R'.mult x : ℝ) * R'.orient x (F x) ∂μHE[n] := by
    intro R'
    -- Step 2: `⟨F, ν_{R'}⟩ = 1_{M'} θ' ⟨F, ξ'⟩`
    have hfun : (fun x => R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x (F x)) =
        R'.carrier.indicator (fun y => (R'.mult y : ℝ) * R'.orient y (F y)) := by
      funext x
      by_cases hx : x ∈ R'.carrier
      · simp [indicator_of_mem hx]
      · simp [indicator_of_notMem hx]
    -- Steps 1 and 3: integrability on `M'` from the pairing bound, then `integral_indicator`
    rw [hfun, integrable_indicator_iff R'.measurableSet_carrier,
      integral_indicator R'.measurableSet_carrier]
    exact ⟨(Submission.dpf_pfc_imrep_pairing_integrable_abs_le P n U K R' F B hK hKU hF.restrict
      hF0 hFB).1, rfl⟩
  obtain ⟨-, he⟩ := key R
  obtain ⟨hi₁, he₁⟩ := key R₁
  obtain ⟨hi₂, he₂⟩ := key R₂
  -- Steps 4–5: evaluate `ν_R = ν_{R₁} + ν_{R₂}` at `F` a.e. and integrate additively
  rw [← he, ← he₁, ← he₂, ← integral_add hi₁ hi₂]
  refine integral_congr_ae ?_
  filter_upwards [hvd] with x hx
  rw [hx, add_apply]
/-- **Pull-back field** (the integrand `⟨ω(f(x)), df_x# T⃗⟩` of Simon Ch. 6, 2.24(2)–(3), and the
estimate behind 2.29): if `f` is `C¹` on the open set `O ⊇ G`, `G` is open, `‖Df‖ ≤ Λ` on `G`, and
the continuous form `ω` has `‖ω‖ ≤ W`, then `φ = 1_G · ω(f) ∘ Df` is a.e. strongly measurable for
every measure and `‖φ‖ ≤ W Λⁿ`.  `Df` and `ω ∘ f` are continuous on `O` and `L ↦ (α ↦ α ∘ L)` is
continuous, so `ω(f) ∘ Df` is continuous on the open set `G`; on `G`, `‖α ∘ L‖ ≤ ‖α‖ ‖L‖ⁿ`, and
`φ = 0` off `G`. -/
theorem Submission.dor_lmb_pc_cm_pullback_field_bounded : ∀ (P n : ℕ) (G O : Set (Euclid P)) (f : Euclid P → Euclid P) (ω : DifferentialForm (Euclid P) n) (Λ W : ℝ), IsOpen G → IsOpen O → G ⊆ O → ContDiffOn ℝ 1 f O → Continuous ω → 0 ≤ Λ → (∀ x ∈ G, ‖fderiv ℝ f x‖ ≤ Λ) → (∀ z, ‖ω z‖ ≤ W) → (∀ μ : Measure (Euclid P), AEStronglyMeasurable (G.indicator fun y => (ω (f y)).compContinuousLinearMap (fderiv ℝ f y)) μ) ∧ ∀ x, ‖G.indicator (fun y => (ω (f y)).compContinuousLinearMap (fderiv ℝ f y)) x‖ ≤ W * Λ ^ n := by
  intro P n G O f ω Λ W hG hO hGO hf hω hΛ hDf hW
  -- Steps 1–3: `Df` and `ω ∘ f` are continuous on `O`, hence so is `ω(f) ∘ Df`
  have hcont : ContinuousOn
      (fun y => (ω (f y)).compContinuousLinearMap (fderiv ℝ f y)) G := by
    have h1 : ContinuousOn (fun y => fderiv ℝ f y) O := hf.continuousOn_fderiv_of_isOpen hO le_rfl
    have h2 : ContinuousOn (fun y => ω (f y)) O := hω.comp_continuousOn hf.continuousOn
    have h3 : ContinuousOn (fun y => ContinuousAlternatingMap.compContinuousLinearMapCLM
        (fderiv ℝ f y) (ω (f y))) O :=
      (ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM.comp_continuousOn h1).clm_apply h2
    exact h3.mono hGO
  -- Step 5: `W ≥ 0`
  have hW0 : 0 ≤ W := (norm_nonneg _).trans (hW 0)
  refine ⟨fun μ => ?_, fun x => ?_⟩
  -- Step 4: continuity on the open (Borel) set `G` gives measurability of `1_G · ω(f) ∘ Df`
  · rw [aestronglyMeasurable_indicator_iff hG.measurableSet]
    exact hcont.aestronglyMeasurable hG.measurableSet
  -- Steps 6–7: `‖α ∘ L‖ ≤ ‖α‖ ‖L‖ⁿ` on `G`; the field vanishes off `G`
  · by_cases hx : x ∈ G
    · rw [Set.indicator_of_mem hx]
      calc ‖(ω (f x)).compContinuousLinearMap (fderiv ℝ f x)‖
          ≤ ‖ω (f x)‖ * ‖fderiv ℝ f x‖ ^ Fintype.card (Fin n) :=
            ContinuousAlternatingMap.norm_compContinuousLinearMap_le _ _
        _ = ‖ω (f x)‖ * ‖fderiv ℝ f x‖ ^ n := by rw [Fintype.card_fin]
        _ ≤ W * Λ ^ n := mul_le_mul (hW _) (pow_le_pow_left₀ (norm_nonneg _) (hDf x hx) n)
            (pow_nonneg (norm_nonneg _) _) hW0
    · rw [Set.indicator_of_notMem hx, norm_zero]
      exact mul_nonneg hW0 (pow_nonneg hΛ n)
/-- The integral form of the mass bound **Simon Ch. 6, 2.29**, `M_W(f_#T) ≤ (sup |Df|)ⁿ M(T)`: if
`|g| ≤ c 1_G` holds `Hⁿ⌞M`-a.e. with `G` measurable, then `ofReal(∫_M θ g dHⁿ) ≤ ofReal(c) μ_R(G)`,
where `μ_R = (Hⁿ⌞M).withDensity θ`.  Indeed `ofReal(∫ θg) ≤ ‖∫ θg‖ₑ ≤ ∫⁻ ‖θg‖ₑ`, and a.e.
`‖θg‖ₑ ≤ 1_G ofReal(c) θ` (on `G` since `|g| ≤ c`, off `G` since `g = 0`), whose lower integral
over `Hⁿ⌞M` is `ofReal(c) μ_R(G)`. -/
theorem Submission.dor_lmb_pc_cm_ofReal_integral_le_measure : ∀ (P n : ℕ) (U G : Set (Euclid P)) (R : IMRep U n) (g : Euclid P → ℝ) (c : ℝ), MeasurableSet G → (∀ᵐ x ∂(μHE[n].restrict R.carrier), |g x| ≤ G.indicator (fun _ => c) x) → ENNReal.ofReal (∫ x in R.carrier, (R.mult x : ℝ) * g x ∂μHE[n]) ≤ ENNReal.ofReal c * R.measure G := by
  intro P n U G R g c hG hg
  -- the weight `θ` is measurable into `[0, ∞]`, being measurable into `ℕ`
  have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) := measurable_from_nat.comp R.measurable_mult
  calc ENNReal.ofReal (∫ x in R.carrier, (R.mult x : ℝ) * g x ∂μHE[n])
      ≤ ‖∫ x in R.carrier, (R.mult x : ℝ) * g x ∂μHE[n]‖ₑ := by
        rw [Real.enorm_eq_ofReal_abs]; exact ENNReal.ofReal_le_ofReal (le_abs_self _)
    _ ≤ ∫⁻ x in R.carrier, ‖(R.mult x : ℝ) * g x‖ₑ ∂μHE[n] := enorm_integral_le_lintegral_enorm _
    -- `‖θg‖ₑ ≤ 1_G ofReal(c) θ` holds `Hⁿ⌞M`-a.e.
    _ ≤ ∫⁻ x in R.carrier, G.indicator (fun x => ENNReal.ofReal c * (R.mult x : ℝ≥0∞)) x
          ∂μHE[n] := by
        refine lintegral_mono_ae ?_
        filter_upwards [hg] with x hx
        by_cases hxG : x ∈ G
        · rw [Set.indicator_of_mem hxG] at hx ⊢
          rw [Real.enorm_eq_ofReal_abs, abs_mul, Nat.abs_cast]
          calc ENNReal.ofReal ((R.mult x : ℝ) * |g x|) ≤ ENNReal.ofReal ((R.mult x : ℝ) * c) :=
                ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hx (Nat.cast_nonneg _))
            _ = ENNReal.ofReal c * (R.mult x : ℝ≥0∞) := by
                rw [ENNReal.ofReal_mul (Nat.cast_nonneg _), ENNReal.ofReal_natCast, mul_comm]
        · rw [Set.indicator_of_notMem hxG] at hx ⊢
          have : g x = 0 := abs_nonpos_iff.mp hx
          simp [this]
    -- `∫⁻_G ofReal(c) θ d(Hⁿ⌞M) = ofReal(c) (Hⁿ⌞M).withDensity θ (G)`
    _ = ENNReal.ofReal c * R.measure G := by
        rw [lintegral_indicator hG, lintegral_const_mul _ hθ, IMRep.measure,
          withDensity_apply _ hG]
/-- **Simon 6.1.8–1.10, 6.3.4–3.5** for a unit orientation `ξ = ±τ₁ ∧ ⋯ ∧ τₙ` of `Q` and a
linear map `L`: `ξ(α ∘ L) = ±α(Lτ₁, …, Lτₙ)`, hence (a) `|ξ(α ∘ L)| ≤ |α|_E ‖L‖ⁿ`, the value
being `0` if `Lτ` is linearly dependent and otherwise bounded by Cauchy–Binet and Hadamard,
`|α(Lτ)| ≤ |α|_E det(⟨Lτᵢ, Lτⱼ⟩)^{1/2} ≤ |α|_E ∏ᵢ |Lτᵢ|`; and (b) `ξ(α ∘ L) = ξ(α)` when `L`
fixes `Q` pointwise. -/
theorem Submission.dor_lmb_pc_unitOrientation_comp : ∀ (P n : ℕ) (ξ : MultiVector P n) (Q : Submodule ℝ (Euclid P)) (L : Euclid P →L[ℝ] Euclid P), IsUnitOrientationOf ξ Q → (∀ α : Covector (Euclid P) n, |ξ (α.compContinuousLinearMap L)| ≤ covectorEuclideanNorm α * ‖L‖ ^ n) ∧ ((∀ v ∈ Q, L v = v) → ∀ α : Covector (Euclid P) n, ξ (α.compContinuousLinearMap L) = ξ α) := by
  intro P n ξ Q L hξ
  obtain ⟨τ, hτ, hspan, hsign⟩ := hξ
  -- `ξ(β) = ±β(τ)`, so `|ξ(β)| = |β(τ)|`
  have habs : ∀ β : Covector (Euclid P) n, |ξ β| = |β τ| := by
    intro β
    rcases hsign with h | h
    · rw [h β]
    · rw [h β, abs_neg]
  refine ⟨fun α => ?_, fun hL α => ?_⟩
  · -- (a): `ξ(α ∘ L) = ±α(v)` with `v = Lτ`
    rw [habs, ContinuousAlternatingMap.compContinuousLinearMap_apply]
    set v : Fin n → Euclid P := L ∘ τ
    have hα := covectorEuclideanNorm_nonneg α
    -- `|vᵢ| = |Lτᵢ| ≤ ‖L‖`
    have hprod : ∏ i, ‖v i‖ ≤ ‖L‖ ^ n := by
      calc ∏ i, ‖v i‖ ≤ ∏ _i : Fin n, ‖L‖ :=
            Finset.prod_le_prod₀ (fun i _ => norm_nonneg _) fun i _ => by
              calc ‖v i‖ = ‖L (τ i)‖ := rfl
                _ ≤ ‖L‖ * ‖τ i‖ := L.le_opNorm _
                _ = ‖L‖ := by rw [hτ.1 i, mul_one]
        _ = ‖L‖ ^ n := by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    by_cases hli : LinearIndependent ℝ v
    · -- Cauchy–Binet and Hadamard: `|α(v)| ≤ |α|_E det(⟨vᵢ, vⱼ⟩)^{1/2} ≤ |α|_E ∏ |vᵢ|`
      obtain ⟨σ, -, -, hG, -, hA⟩ := Submission.dpf_exists_orthonormal_frame_det_gram P n v hli
      have h1 := (Submission.covectorEuclideanNorm_gram_bounds P n).1 α v
      rw [hG, Real.sqrt_sq_eq_abs] at h1
      calc |α v| ≤ covectorEuclideanNorm α *
            |Matrix.det (Matrix.of fun i j => inner ℝ (σ i) (v j))| := h1
        _ ≤ covectorEuclideanNorm α * ∏ i, ‖v i‖ := mul_le_mul_of_nonneg_left hA hα
        _ ≤ covectorEuclideanNorm α * ‖L‖ ^ n := mul_le_mul_of_nonneg_left hprod hα
    · -- a linearly dependent `v` gives `α(v) = 0`
      rw [show α v = 0 from α.toAlternatingMap.map_linearDependent v hli, abs_zero]
      exact mul_nonneg hα (pow_nonneg (norm_nonneg L) n)
  · -- (b): `L` fixes each `τᵢ ∈ span τ = Q`, so `α(Lτ) = α(τ)`
    have hLτ : L ∘ τ = τ := funext fun i => hL (τ i) (hspan ▸ Submodule.subset_span ⟨i, rfl⟩)
    rcases hsign with h | h
    · rw [h, h, ContinuousAlternatingMap.compContinuousLinearMap_apply, hLτ]
    · rw [h, h, ContinuousAlternatingMap.compContinuousLinearMap_apply, hLτ]

/-- **A map fixing `N` to first order fixes the orientation of a triple carried by `N`** (steps
3–4 of the projected comparison; Simon Ch. 3, §1 and Ch. 2, §4).  Let `R = (M, θ, ξ)` satisfy
`Hⁿ(M \ N) = 0` for an embedded `C¹` submanifold `N`, and let `f(x) = x` and `Df(x)v = v` for
`x ∈ N ∩ O` and `v ∈ TₓN`.  For `Hⁿ`-a.e. `x ∈ M`, `x ∈ N` and `ξ(x)` orients an approximate
tangent plane `Q` of `M` at `x` (`R.orients`), and `Q ⊆ TₓN`
(`approxTangent_le_submanifold_tangentSpace`).  If also `x ∈ O`, then `f(x) = x` and `Df(x)`
fixes `Q`, so `ξ(x)(α ∘ Df(x)) = ξ(x)(α)` (`dor_lmb_pc_unitOrientation_comp`, part (b)). -/
theorem Submission.dor_lmb_pc_imrep_orient_fixed_by_retraction : ∀ (P n d : ℕ) (U N O : Set (Euclid P)) (R : IMRep U n) (f : Euclid P → Euclid P), IsEmbeddedSubmanifold 1 d N → MeasurableSet O → μHE[n] (R.carrier \ N) = 0 → (∀ x ∈ N ∩ O, f x = x) → (∀ x ∈ N ∩ O, ∀ v ∈ tangentSpace N x, fderiv ℝ f x v = v) → ∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ O)), f x = x ∧ ∀ α : Covector (Euclid P) n, R.orient x (α.compContinuousLinearMap (fderiv ℝ f x)) = R.orient x α := by
  intro P n d U N O R f hN hO hnull hfix hDfix
  -- `Hⁿ⌞M`-a.e. point lies in `N`: `Hⁿ⌞M(ℝᴾ \ N) = Hⁿ(M \ N) = 0`
  have hMN : ∀ᵐ x ∂(μHE[n].restrict R.carrier), x ∈ N := by
    rw [ae_iff, Measure.restrict_apply' R.measurableSet_carrier]
    refine measure_mono_null ?_ hnull
    exact fun x hx => ⟨hx.2, hx.1⟩
  -- with `R.orients`, pass from `Hⁿ⌞M` to `Hⁿ⌞(M ∩ O)`
  have hMO : ∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ O)), x ∈ N ∧ ∃ Q : Submodule ℝ (Euclid P),
      HasApproximateTangentSpaceAt n R.carrier x Q ∧ IsUnitOrientationOf (R.orient x) Q :=
    ae_restrict_of_ae_restrict_of_subset inter_subset_left (hMN.and R.orients)
  filter_upwards [hMO, ae_restrict_mem (R.measurableSet_carrier.inter hO)]
    with x ⟨hxN, Q, hQ, hξ⟩ hx
  have hxNO : x ∈ N ∩ O := ⟨hxN, hx.2⟩
  -- the approximate tangent plane `Q` lies in `TₓN`, on which `Df(x)` is the identity
  have hQN := Submission.approxTangent_le_submanifold_tangentSpace P n d N R.carrier x Q hN hxN
    hnull hQ
  exact ⟨hfix x hxNO, (Submission.dor_lmb_pc_unitOrientation_comp P n (R.orient x) Q
    (fderiv ℝ f x) hξ).2 fun v hv => hDfix x hxNO v (hQN hv)⟩
/-- **Competitor mass bound** (Simon 7.2.4 (8)–(9), for the competitor `S = Z + f_#X`).  Let
`Y = τ(RY) = τ(RZ) + τ(RX)`, `f ∈ C¹(O)` with `‖Df‖ ≤ Λ` on `G ⊂⊂ U`, `f = id` and
`ξ_Z(α ∘ Df) = ξ_Z(α)` a.e. on `M_Z ∩ G`, and `M_X ⊆ G` a.e.  For an admissible `ω`
(`spt ω ⊆ G`, `|ω|_E ≤ 1`), `φ := 1_G · ω(f) ∘ Df` is bounded, measurable and vanishes off the
compact `Ḡ ⊆ U`; it represents both parts of `S(ω)`, so the vector density identity
`1_{M_Y} θ_Y ξ_Y = 1_{M_Z} θ_Z ξ_Z + 1_{M_X} θ_X ξ_X` gives `S(ω) = ∫_{M_Y} θ_Y ξ_Y(φ) dHⁿ`.
As `|ξ_Y(α ∘ Df)| ≤ |α|_E ‖Df‖ⁿ ≤ Λⁿ` on `G`, `S(ω) ≤ Λⁿ μ_{RY}(G)`; take the supremum over `ω`. -/
theorem Submission.dor_lmb_pc_competitor_massOn_le : ∀ (P n : ℕ) (U G O : Set (Euclid P)) (RZ RX RY : IMRep U n) (Y S : GeometricCurrentOn U n) (f : Euclid P → Euclid P) (Λ : ℝ), IsOpen U → IsOpen G → CompactlyContained G U → IsOpen O → G ⊆ O → ContDiffOn ℝ 1 f O → 0 ≤ Λ → (∀ x ∈ G, ‖fderiv ℝ f x‖ ≤ Λ) → RY.Represents Y → (∀ ω : TestFormOn U n, Y ω = RZ.action (ω : DifferentialForm (Euclid P) n) + RX.action (ω : DifferentialForm (Euclid P) n)) → (∀ᵐ x ∂(μHE[n].restrict (RZ.carrier ∩ G)), f x = x ∧ ∀ α : Covector (Euclid P) n, RZ.orient x (α.compContinuousLinearMap (fderiv ℝ f x)) = RZ.orient x α) → μHE[n] (RX.carrier \ G) = 0 → (∀ ω : TestFormOn U n, S ω = RZ.action (ω : DifferentialForm (Euclid P) n) + ∫ x in RX.carrier, (RX.mult x : ℝ) * RX.orient x (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x)) ∂μHE[n]) → S.massOn G ≤ ENNReal.ofReal (Λ ^ n) * RY.measure G := by
  intro P n U G O RZ RX RY Y S f Λ hU hG hGU hO hGO hf hΛ hDf hY hYZX hZfix hXG hS
  obtain ⟨hKc, hKU⟩ := hGU
  -- Step 1: the vector densities satisfy `ν_Y = ν_Z + ν_X` `Hⁿ`-a.e.
  have hvd := Submission.dor_lmb_pc_cm_vector_density_add P n U RZ RX RY Y hU hY hYZX
  -- `M_G(S)` is the supremum of `S(ω)` over the admissible `ω`
  refine sSup_le ?_
  rintro _ ⟨ω, ⟨hωG, hω1⟩, rfl⟩
  show ENNReal.ofReal (S ω) ≤ ENNReal.ofReal (Λ ^ n) * RY.measure G
  -- `ω` is continuous and bounded by `W`
  obtain ⟨⟨hsmooth, hcpt⟩, -⟩ := ω.2
  have hωc : Continuous (ω : DifferentialForm (Euclid P) n) := ContDiff.continuous hsmooth
  obtain ⟨W, hW⟩ := hωc.bounded_above_of_compact_support hcpt
  -- Step 2: `φ = 1_G · ω(f) ∘ Df` is measurable, bounded by `W Λⁿ` and vanishes off `Ḡ`
  set φ : Euclid P → Covector (Euclid P) n := G.indicator fun y =>
    ((ω : DifferentialForm (Euclid P) n) (f y)).compContinuousLinearMap (fderiv ℝ f y) with hφ
  obtain ⟨hφm, hφB⟩ := Submission.dor_lmb_pc_cm_pullback_field_bounded P n G O f
    (ω : DifferentialForm (Euclid P) n) Λ W hG hO hGO hf hωc hΛ hDf hW
  have hφ0 : ∀ x, x ∉ closure G → φ x = 0 := fun x hx =>
    Set.indicator_of_notMem (fun h => hx (subset_closure h)) _
  -- Step 4: `τ(RZ)(ω) = ∫_{M_Z} θ_Z ξ_Z(φ) dHⁿ`, as `f` fixes `M_Z ∩ G` and `ω = φ = 0` off `G`
  have hZ : RZ.action (ω : DifferentialForm (Euclid P) n) =
      ∫ x in RZ.carrier, (RZ.mult x : ℝ) * RZ.orient x (φ x) ∂μHE[n] := by
    refine setIntegral_congr_ae RZ.measurableSet_carrier ?_
    filter_upwards [(ae_restrict_iff' (RZ.measurableSet_carrier.inter hG.measurableSet)).1 hZfix]
      with x hx hxZ
    by_cases hxG : x ∈ G
    · obtain ⟨hfx, hor⟩ := hx ⟨hxZ, hxG⟩
      rw [hφ, Set.indicator_of_mem hxG, hfx, hor]
    · rw [hφ, Set.indicator_of_notMem hxG,
        image_eq_zero_of_notMem_tsupport fun h => hxG (hωG h)]
  -- Step 5: the `X` part equals `∫_{M_X} θ_X ξ_X(φ) dHⁿ`, as `M_X ⊆ G` a.e.
  have hX : ∫ x in RX.carrier, (RX.mult x : ℝ) * RX.orient x
        (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap (fderiv ℝ f x))
        ∂μHE[n] =
      ∫ x in RX.carrier, (RX.mult x : ℝ) * RX.orient x (φ x) ∂μHE[n] := by
    refine setIntegral_congr_ae RX.measurableSet_carrier ?_
    filter_upwards [measure_eq_zero_iff_ae_notMem.1 hXG] with x hx hxX
    have hxG : x ∈ G := by_contra fun h => hx ⟨hxX, h⟩
    rw [hφ, Set.indicator_of_mem hxG]
  -- Steps 3 and 6: `S(ω) = ∫_{M_Y} θ_Y ξ_Y(φ) dHⁿ`, integrating `ν_Y = ν_Z + ν_X` against `φ`
  have hSY : S ω = ∫ x in RY.carrier, (RY.mult x : ℝ) * RY.orient x (φ x) ∂μHE[n] := by
    rw [hS ω, hZ, hX]
    exact (Submission.dor_lmb_pc_cm_pairing_add_of_bounded P n U (closure G) RZ RX RY φ
      (W * Λ ^ n) hKc hKU (hφm μHE[n]) hφ0 hφB hvd).symm
  -- Step 7: `|ξ_Y(φ)| ≤ |ω(f)|_E ‖Df‖ⁿ ≤ Λⁿ` on `G` and `ξ_Y(φ) = 0` off `G`, `Hⁿ⌞M_Y`-a.e.
  have hbound : ∀ᵐ x ∂(μHE[n].restrict RY.carrier),
      |RY.orient x (φ x)| ≤ G.indicator (fun _ => Λ ^ n) x := by
    filter_upwards [RY.orients] with x hx
    obtain ⟨Q, -, hQ⟩ := hx
    by_cases hxG : x ∈ G
    · rw [hφ, Set.indicator_of_mem hxG, Set.indicator_of_mem hxG]
      calc |RY.orient x (((ω : DifferentialForm (Euclid P) n) (f x)).compContinuousLinearMap
            (fderiv ℝ f x))|
          ≤ covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) n) (f x)) *
              ‖fderiv ℝ f x‖ ^ n :=
            (Submission.dor_lmb_pc_unitOrientation_comp P n (RY.orient x) Q (fderiv ℝ f x) hQ).1 _
        _ ≤ 1 * Λ ^ n := mul_le_mul (hω1 (f x)) (pow_le_pow_left₀ (norm_nonneg _) (hDf x hxG) n)
            (pow_nonneg (norm_nonneg _) n) zero_le_one
        _ = Λ ^ n := one_mul _
    · rw [hφ, Set.indicator_of_notMem hxG, Set.indicator_of_notMem hxG, map_zero, abs_zero]
  -- Step 8: `ofReal(S(ω)) ≤ ofReal(Λⁿ) μ_{RY}(G)`
  rw [hSY]
  exact Submission.dor_lmb_pc_cm_ofReal_integral_le_measure P n U G RY
    (fun x => RY.orient x (φ x)) (Λ ^ n) hG.measurableSet hbound

/-- **Basis independence of `Σ_j α(b ∘ j)²`** (Simon 6.1): for an `n`-covector `α` on `ℝᴾ` and
orthonormal bases `b`, `b'` of `ℝᴾ`, `Σ_{j : Fin n → Fin P} α(b_{j 0}, …, b_{j (n-1)})²` is the same
for `b` and `b'`.  Expand `bᵢ = Σₛ ⟨b'ₛ, bᵢ⟩ b'ₛ` in every slot (multilinearity), square and sum
over `j`; the `j`-sum factors over the slots, and `Σᵢ ⟨b'ₛ, bᵢ⟩⟨bᵢ, b'ₜ⟩ = ⟨b'ₛ, b'ₜ⟩ = δₛₜ`
(Parseval for `b`) kills every cross term. -/
theorem Submission.regcomp_covector_sq_sum_basis_invariant : ∀ (P n : ℕ) (α : Covector (Euclid P) n) (b b' : OrthonormalBasis (Fin P) ℝ (Euclid P)), ∑ j : Fin n → Fin P, (α (fun k => b (j k))) ^ 2 = ∑ j : Fin n → Fin P, (α (fun k => b' (j k))) ^ 2 := by
  intro P n α b b'
  classical
  -- `c i s = ⟨b'ₛ, bᵢ⟩`, the coordinates of `bᵢ` in `b'`
  set c : Fin P → Fin P → ℝ := fun i s => inner ℝ (b' s) (b i) with hc
  -- multilinearity: `α(b ∘ j) = Σ_a (Πₖ c(j k, a k)) α(b' ∘ a)`
  have hexp : ∀ j : Fin n → Fin P, α (fun k => b (j k)) =
      ∑ a : Fin n → Fin P, (∏ k, c (j k) (a k)) * α (fun k => b' (a k)) := by
    intro j
    have hb : (fun k => b (j k)) = fun k => ∑ s, c (j k) s • b' s :=
      funext fun k => (b'.sum_repr' (b (j k))).symm
    rw [hb, α.map_sum]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [← smul_eq_mul, ← α.map_smul_univ]
  -- Parseval for `b` and orthonormality of `b'`: `Σᵢ c(i, s) c(i, t) = δₛₜ`
  have hdelta : ∀ s t : Fin P, ∑ i, c i s * c i t = if s = t then 1 else 0 := by
    intro s t
    have h1 : ∑ i, c i s * c i t = inner ℝ (b' s) (b' t) := by
      rw [← b.sum_inner_mul_inner (b' s) (b' t)]
      refine Finset.sum_congr rfl fun i _ => ?_
      simp only [hc]
      rw [real_inner_comm (b' t) (b i)]
    rw [h1]
    exact (orthonormal_iff_ite.mp b'.orthonormal) s t
  -- `Σ_j Πₖ c(j k, a k) c(j k, a' k) = Πₖ Σᵢ c(i, a k) c(i, a' k) = δ_{a a'}`
  have hT : ∀ a a' : Fin n → Fin P,
      ∑ j : Fin n → Fin P, ∏ k, (c (j k) (a k) * c (j k) (a' k)) = if a = a' then 1 else 0 := by
    intro a a'
    rw [← Fintype.prod_sum (fun k i => c i (a k) * c i (a' k))]
    simp_rw [hdelta]
    split_ifs with h
    · subst h
      simp
    · obtain ⟨k, hk⟩ := Function.ne_iff.mp h
      exact Finset.prod_eq_zero (Finset.mem_univ k) (ite_eq_right hk)
  calc ∑ j : Fin n → Fin P, (α (fun k => b (j k))) ^ 2
      = ∑ j : Fin n → Fin P, ∑ a : Fin n → Fin P, ∑ a' : Fin n → Fin P,
          (α (fun k => b' (a k)) * α (fun k => b' (a' k))) *
            ∏ k, (c (j k) (a k) * c (j k) (a' k)) := by
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [hexp j, sq, Finset.sum_mul_sum]
        refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun a' _ => ?_
        rw [Finset.prod_mul_distrib]
        ring
    _ = ∑ a : Fin n → Fin P, ∑ a' : Fin n → Fin P,
          (α (fun k => b' (a k)) * α (fun k => b' (a' k))) *
            ∑ j : Fin n → Fin P, ∏ k, (c (j k) (a k) * c (j k) (a' k)) := by
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun a _ => ?_
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun a' _ => ?_
        rw [Finset.mul_sum]
    _ = ∑ a : Fin n → Fin P, (α (fun k => b' (a k))) ^ 2 := by
        refine Finset.sum_congr rfl fun a _ => ?_
        simp_rw [hT]
        rw [Finset.sum_eq_single a]
        · simp [sq]
        · intro a' _ hne
          simp [Ne.symm hne]
        · intro h
          exact absurd (Finset.mem_univ a) h
/-- **Simon 6.1.2, 6.1.5** (the Euclidean coefficient norm in the standard basis `e`):
`Σ_{j : Fin n → Fin P} α(e_{j(0)}, …, e_{j(n−1)})² = n! |α|_E²`.  Tuples `j` with a repeated
index contribute `0` (alternation), and `(I, σ) ↦ I ∘ σ` is a bijection from the strictly
increasing `I` and the permutations `σ` of `Fin n` onto the injective `j`, with
`α(e_{I ∘ σ}) = sgn σ · α(e_I)`. -/
theorem Submission.regcomp_covector_sq_sum_basisFun : ∀ (P n : ℕ) (α : Covector (Euclid P) n), ∑ j : Fin n → Fin P, (α (fun k => EuclideanSpace.basisFun (Fin P) ℝ (j k))) ^ 2 = (n.factorial : ℝ) * covectorEuclideanNorm α ^ 2 := by
  intro P n α
  classical
  -- `|α|_E² = Σ_I [I strictly increasing] α(e_I)²`, so `n! |α|_E² = Σ_{(I, σ)} α(e_I)²` over
  -- strictly increasing `I` and `σ ∈ Perm(Fin n)`
  unfold covectorEuclideanNorm
  rw [Real.sq_sqrt (Finset.sum_nonneg fun I _ => by positivity), ← Finset.sum_filter,
    Finset.mul_sum]
  have hcard : ∀ x : ℝ, (n.factorial : ℝ) * x = ∑ _σ : Equiv.Perm (Fin n), x := fun x => by
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_perm, Fintype.card_fin, nsmul_eq_mul]
  simp only [hcard]
  rw [← Finset.sum_product']
  -- alternation: non-injective `j` contribute `0`
  have hzero : ∀ j : Fin n → Fin P, ¬ Injective j →
      α (fun k => EuclideanSpace.basisFun (Fin P) ℝ (j k)) = 0 := fun j hj =>
    α.map_eq_zero_of_not_injective _
      fun h => hj (Injective.of_comp (f := ⇑(EuclideanSpace.basisFun (Fin P) ℝ)) h)
  rw [← Finset.sum_filter_of_ne (p := Injective) fun j _ hne => by
    by_contra hj
    exact hne (by rw [hzero j hj]; norm_num)]
  symm
  -- `(I, σ) ↦ I ∘ σ` is a bijection onto the injective `j`, and `α(e_{I ∘ σ}) = sgn σ · α(e_I)`
  refine Finset.sum_bij (fun p _ => fun k => p.1 (p.2 k)) ?_ ?_ ?_ ?_
  · intro p hp
    simp only [Finset.mem_product, Finset.mem_filter, Finset.mem_univ, true_and, and_true] at hp ⊢
    exact hp.injective.comp p.2.injective
  · -- equal ranges force `I = I'`, and then `σ = σ'` by injectivity of `I`
    intro p hp q hq hpq
    simp only [Finset.mem_product, Finset.mem_filter, Finset.mem_univ, true_and, and_true] at hp hq
    have hrange : Set.range p.1 = Set.range q.1 := by
      rw [← EquivLike.range_comp p.1 p.2, ← EquivLike.range_comp q.1 q.2]
      exact congrArg Set.range hpq
    have hI : p.1 = q.1 := (StrictMono.range_inj_of_wellFoundedLT hp hq).mp hrange
    have hσ : p.2 = q.2 := by
      ext k
      have := congr_fun hpq k
      rw [hI] at this
      exact congrArg Fin.val (hq.injective this)
    exact Prod.ext hI hσ
  · -- `j ∘ Tuple.sort j` is monotone and injective, hence strictly increasing
    intro j hj
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hj
    refine ⟨(j ∘ Tuple.sort j, (Tuple.sort j)⁻¹), ?_, ?_⟩
    · simp only [Finset.mem_product, Finset.mem_filter, Finset.mem_univ, true_and, and_true]
      exact (Tuple.monotone_sort j).strictMono_of_injective (hj.comp (Tuple.sort j).injective)
    · funext k
      simp
  · intro p _
    have hperm : α (fun k => EuclideanSpace.basisFun (Fin P) ℝ (p.1 (p.2 k))) =
        Equiv.Perm.sign p.2 • α (fun k => EuclideanSpace.basisFun (Fin P) ℝ (p.1 k)) :=
      α.toAlternatingMap.map_perm (fun k => EuclideanSpace.basisFun (Fin P) ℝ (p.1 k)) p.2
    dsimp only
    rw [hperm]
    rcases Int.units_eq_one_or (Equiv.Perm.sign p.2) with h | h <;> simp [h]

/-- **Simon 6.1.2, 6.1.5** in an arbitrary orthonormal basis (the coefficient norm behind
Remark 6.3.2(3)): for an `n`-covector `α` on `ℝᴾ` and an orthonormal basis `f` of `ℝᴾ`,
`Σ_{j : Fin n → Fin P} α(f_{j(0)}, …, f_{j(n−1)})² = n! |α|_E²`.  The sum is the same for every
orthonormal basis (`regcomp_covector_sq_sum_basis_invariant` with `b' = e`, the standard basis),
and for `e` it is `n! |α|_E²` (`regcomp_covector_sq_sum_basisFun`). -/
theorem Submission.regcomp_covector_sq_sum_orthonormalBasis : ∀ (P n : ℕ) (α : Covector (Euclid P) n) (f : OrthonormalBasis (Fin P) ℝ (Euclid P)), ∑ j : Fin n → Fin P, (α (fun k => f (j k))) ^ 2 = (n.factorial : ℝ) * covectorEuclideanNorm α ^ 2 := by
  intro P n α f
  rw [Submission.regcomp_covector_sq_sum_basis_invariant P n α f
    (EuclideanSpace.basisFun (Fin P) ℝ)]
  exact Submission.regcomp_covector_sq_sum_basisFun P n α

/-- **Evaluation on an orthonormal frame is bounded by the Euclidean coefficient norm** (Simon
Ch. 6, Remark 2.6(a); step 1(a) of the mass formula, Remark 6.3.2(3)): `|α(τ)| ≤ |α|_E` for every
`n`-covector `α` and orthonormal `τ₁, …, τₙ` in `ℝᴾ`.  Extend `τ` to an orthonormal basis `f` of
`ℝᴾ` with `f ∘ ι = τ`, `ι = Fin.castLE`.  For every permutation `π`,
`α(f ∘ (ι ∘ π))² = α(τ ∘ π)² = α(τ)²`, and `π ↦ ι ∘ π` is injective, so
`n! α(τ)² ≤ Σ_j α(f ∘ j)² = n! |α|_E²` by `regcomp_covector_sq_sum_orthonormalBasis`. -/
theorem Submission.regcomp_covector_eval_orthonormal_le : ∀ (P n : ℕ) (α : Covector (Euclid P) n) (τ : Fin n → Euclid P), Orthonormal ℝ τ → |α τ| ≤ covectorEuclideanNorm α := by
  intro P n α τ hτ
  classical
  -- Step 1: `n ≤ P`, and an orthonormal basis `f` of `ℝᴾ` with `f (ι k) = τ k`, `ι = Fin.castLE`
  have hnP : n ≤ P := by
    simpa [finrank_euclideanSpace_fin] using hτ.linearIndependent.fintype_card_le_finrank
  let ι : Fin n → Fin P := Fin.castLE hnP
  have hι : Injective ι := Fin.castLE_injective hnP
  let v : Fin P → Euclid P := fun i => if h : (i : ℕ) < n then τ ⟨i, h⟩ else 0
  let s : Set (Fin P) := {i | (i : ℕ) < n}
  have hvs : Orthonormal ℝ (s.domRestrict v) := by
    let e : s → Fin n := fun i => ⟨i.1, i.2⟩
    have he : Injective e := fun a b hab =>
      Subtype.ext (Fin.ext (congrArg (Fin.val : Fin n → ℕ) hab))
    have hve : s.domRestrict v = τ ∘ e := by
      funext i
      have hi : ((i : Fin P) : ℕ) < n := i.2
      simp [v, e, hi]
    rw [hve]
    exact hτ.comp e he
  obtain ⟨f, hf⟩ := Orthonormal.exists_orthonormalBasis_extension_of_card_eq (by simp) hvs
  have hfι : ∀ k, f (ι k) = τ k := by
    intro k
    rw [hf (ι k) k.2]
    simp [v, ι]
  -- Step 2: `α(f ∘ (ι ∘ π))² = α(τ ∘ π)² = α(τ)²` for every permutation `π`
  let Φ : Equiv.Perm (Fin n) → (Fin n → Fin P) := fun π => ι ∘ π
  have hΦ : Injective Φ := fun π π' h => Equiv.ext fun k => hι (congrFun h k)
  have hperm : ∀ π : Equiv.Perm (Fin n), α (fun k => f (Φ π k)) ^ 2 = α τ ^ 2 := by
    intro π
    have h1 : (fun k => f (Φ π k)) = τ ∘ π := funext fun k => hfι (π k)
    have h2 : α (τ ∘ π) = Equiv.Perm.sign π • α τ := α.toAlternatingMap.map_perm τ π
    rw [h1, h2]
    rcases Int.units_eq_one_or (Equiv.Perm.sign π) with h | h <;> simp [h]
  -- Step 3: `n! α(τ)² = Σ_π α(f ∘ (ι ∘ π))² ≤ Σ_j α(f ∘ j)²`, the terms being nonnegative
  have hle : (n.factorial : ℝ) * α τ ^ 2 ≤ ∑ j : Fin n → Fin P, α (fun k => f (j k)) ^ 2 :=
    calc (n.factorial : ℝ) * α τ ^ 2
        = ∑ j ∈ Finset.univ.image Φ, α (fun k => f (j k)) ^ 2 := by
          rw [Finset.sum_image fun π _ π' _ h => hΦ h]
          simp only [hperm, Finset.sum_const, Finset.card_univ, Fintype.card_perm,
            Fintype.card_fin, nsmul_eq_mul]
      _ ≤ ∑ j : Fin n → Fin P, α (fun k => f (j k)) ^ 2 :=
          Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _) fun j _ _ => sq_nonneg _
  -- Step 4: `Σ_j α(f ∘ j)² = n! |α|_E²` (`regcomp_covector_sq_sum_orthonormalBasis`); cancel `n!`
  rw [Submission.regcomp_covector_sq_sum_orthonormalBasis P n α f] at hle
  have hsq : α τ ^ 2 ≤ covectorEuclideanNorm α ^ 2 :=
    le_of_mul_le_mul_left hle (Nat.cast_pos.mpr n.factorial_pos)
  -- Step 5: `|α(τ)| ≤ |α|_E`, since `|α|_E ≥ 0`
  exact abs_le_of_sq_le_sq hsq (covectorEuclideanNorm_nonneg α)
/-- **Two-sided Hausdorff comparison on a bi-Lipschitz piece**: let `G : ℝⁿ → ℝᴾ` be
`L`-Lipschitz and `m > 0` with `m|a − a'| ≤ |G a − G a'|` on `A`.  Then for every `Z ⊆ A`,
`mⁿ λ(Z) ≤ Hⁿ(G(Z)) ≤ Lⁿ λ(Z)`.
`Hⁿ = λ` on `ℝⁿ`, and a `K`-Lipschitz map scales `Hⁿ` by at most `Kⁿ` (Simon Ch. 2, 1.8(i)).
The upper bound applies this to `G`.  For the lower bound, `G` is injective on `A`, and
`g := invFunOn G A` is `m⁻¹`-Lipschitz on `G(Z)` with `g(G(Z)) = Z`, so `λ(Z) ≤ m⁻ⁿ Hⁿ(G(Z))`. -/
theorem Submission.dimred_mbl_dt_lpip_bilipschitz_measure_bounds : ∀ (P n : ℕ) (G : Euclid n → Euclid P) (A : Set (Euclid n)) (L : NNReal) (m : ℝ), LipschitzWith L G → 0 < m → (∀ a ∈ A, ∀ a' ∈ A, m * ‖a - a'‖ ≤ ‖G a - G a'‖) → ∀ Z : Set (Euclid n), Z ⊆ A → ENNReal.ofReal m ^ n * volume Z ≤ μHE[n] (G '' Z) ∧ μHE[n] (G '' Z) ≤ (L : ℝ≥0∞) ^ n * volume Z := by
  intro P n G A L m hG hm hcolip Z hZA
  -- `Hⁿ = λ` on `ℝⁿ`
  have hvol : (μHE[n] : Measure (Euclid n)) = volume :=
    EuclideanSpace.euclideanHausdorffMeasure_eq_volume n
  refine ⟨?_, ?_⟩
  · -- `G` is injective on `A`, with left inverse `g := invFunOn G A`
    have hinjOn : InjOn G A := by
      intro a ha a' ha' hGa
      have h := hcolip a ha a' ha'
      rw [hGa, sub_self, norm_zero] at h
      have h' : ‖a - a'‖ ≤ 0 := le_of_mul_le_mul_left (by simpa using h) hm
      exact sub_eq_zero.1 (norm_le_zero_iff.1 h')
    have hleft : LeftInvOn (invFunOn G A) G A := hinjOn.leftInvOn_invFunOn
    have hgZ : invFunOn G A '' (G '' Z) = Z := by
      rw [image_image]
      exact (image_congr fun a ha => hleft (hZA ha)).trans (image_id' Z)
    -- `g` is `m⁻¹`-Lipschitz on `G(Z)`
    have hgLip : LipschitzOnWith (Real.toNNReal m⁻¹) (invFunOn G A) (G '' Z) := by
      refine LipschitzOnWith.of_dist_le_mul ?_
      rintro _ ⟨a, ha, rfl⟩ _ ⟨a', ha', rfl⟩
      rw [hleft (hZA ha), hleft (hZA ha'), Real.coe_toNNReal _ (inv_nonneg.2 hm.le),
        dist_eq_norm, dist_eq_norm, le_inv_mul_iff₀ hm]
      exact hcolip a (hZA ha) a' (hZA ha')
    -- `λ(Z) = Hⁿ(g(G(Z))) ≤ m⁻ⁿ Hⁿ(G(Z))`
    have h := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n hgLip
    rw [hgZ, hvol] at h
    have hone : ENNReal.ofReal m * (Real.toNNReal m⁻¹ : ℝ≥0∞) = 1 := by
      rw [← ENNReal.ofReal.eq_def, ← ENNReal.ofReal_mul hm.le, mul_inv_cancel₀ hm.ne',
        ENNReal.ofReal_one]
    calc ENNReal.ofReal m ^ n * volume Z
        ≤ ENNReal.ofReal m ^ n * ((Real.toNNReal m⁻¹ : ℝ≥0∞) ^ n * μHE[n] (G '' Z)) := by
          gcongr
      _ = (ENNReal.ofReal m * (Real.toNNReal m⁻¹ : ℝ≥0∞)) ^ n * μHE[n] (G '' Z) := by
          rw [mul_pow, mul_assoc]
      _ = μHE[n] (G '' Z) := by rw [hone, one_pow, one_mul]
  · -- `Hⁿ(G(Z)) ≤ Lⁿ Hⁿ(Z) = Lⁿ λ(Z)`
    have h := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
      (hG.lipschitzOnWith (s := Z))
    rwa [hvol] at h
/-- **`C¹` approximation of an indicator in `L¹`**: if `P ⊆ B_R(0) ⊆ ℝⁿ` is measurable and
`η > 0`, there is a `C¹` function `ψ : ℝⁿ → [0, 1]` with compact support in `B_R(0)` and
`∫ |ψ - 1_P| < η`.  Take a compact `K ⊆ P` with `L(P \ K) < η/2` (inner regularity), an open
`U ⊇ K` with `L(U \ K) < η/2` (outer regularity at `K`) and `r' < R` with `K ⊆ B_{r'}(0)`; the
smooth Urysohn lemma for `K ⊆ s := U ∩ B_{r'}(0)` gives `ψ` with `support ψ = s` and `ψ = 1`
exactly on `K`, and `|ψ - 1_P| ≤ 1_{P \ K} + 1_{s \ K}`. -/
theorem Submission.codim1_rdo_dg_bvc_smooth_indicator_approx : ∀ (n : ℕ) (P : Set (Euclid n)) (R η : ℝ), MeasurableSet P → P ⊆ ball (0 : Euclid n) R → 0 < η → ∃ ψ : Euclid n → ℝ, ContDiff ℝ 1 ψ ∧ HasCompactSupport ψ ∧ tsupport ψ ⊆ ball (0 : Euclid n) R ∧ (∀ z, 0 ≤ ψ z ∧ ψ z ≤ 1) ∧ ∫ z, |ψ z - P.indicator (fun _ => (1 : ℝ)) z| < η := by
  intro n P R η hP hPR hη
  -- Step 1: `L(P) ≤ L(B_R) < ∞`
  have hPfin : volume P ≠ ∞ := (measure_mono hPR |>.trans_lt measure_ball_lt_top).ne
  have hη2 : ENNReal.ofReal (η / 2) ≠ 0 := (ENNReal.ofReal_pos.2 (half_pos hη)).ne'
  -- Step 2: a compact closed `K ⊆ P` with `L(P \ K) < η/2`
  obtain ⟨K, hKP, hKc, hKcl, hPK⟩ := hP.exists_isCompact_isClosed_sdiff_lt hPfin hη2
  -- Step 3: an open `U ⊇ K` with `L(U) < L(K) + η/2`
  obtain ⟨U, hKU, hUo, hU⟩ := hKc.exists_isOpen_lt_add (μ := volume) hη2
  -- Step 4: `K ⊆ B_{r'}(0)` for some `r' < R`
  obtain ⟨r', hr'R, hKr'⟩ := exists_lt_subset_ball hKcl (hKP.trans hPR)
  -- Step 5: smooth Urysohn for `K ⊆ s := U ∩ B_{r'}(0)`
  set s := U ∩ ball (0 : Euclid n) r' with hsdef
  have hs : IsOpen s := hUo.inter isOpen_ball
  have hKs : K ⊆ s := fun x hx => ⟨hKU hx, hKr' hx⟩
  obtain ⟨ψ, hψ, hψr, hψs, hψ1⟩ := exists_contDiff_support_eq_eq_one_iff (n := 1) hs hKcl hKs
  have hψ01 : ∀ z, 0 ≤ ψ z ∧ ψ z ≤ 1 := fun z => hψr (mem_range_self z)
  -- Step 6: `tsupport ψ = closure s ⊆ B̄_{r'}(0) ⊆ B_R(0)`, which is compact
  have htsupp : tsupport ψ ⊆ closedBall (0 : Euclid n) r' := by
    rw [tsupport, hψs]
    exact closure_minimal (inter_subset_right.trans ball_subset_closedBall) isClosed_closedBall
  refine ⟨ψ, hψ, ?_, htsupp.trans (closedBall_subset_ball hr'R), hψ01, ?_⟩
  · exact HasCompactSupport.of_support_subset_isCompact (isCompact_closedBall _ _)
      ((subset_tsupport ψ).trans htsupp)
  -- Step 7: `|ψ - 1_P| ≤ 1_{P \ K} + 1_{s \ K}` pointwise
  have hdom : ∀ z, |ψ z - P.indicator (fun _ => (1 : ℝ)) z|
      ≤ (P \ K).indicator (fun _ => (1 : ℝ)) z + (s \ K).indicator (fun _ => (1 : ℝ)) z := by
    intro z
    have h01 := hψ01 z
    by_cases hzK : z ∈ K
    · have h1 : ψ z = 1 := (hψ1 z).1 hzK
      simp [h1, hKP hzK, hzK]
    · by_cases hzP : z ∈ P
      · have : (P \ K).indicator (fun _ => (1 : ℝ)) z = 1 := by simp [hzP, hzK]
        rw [indicator_of_mem hzP, this]
        have : 0 ≤ (s \ K).indicator (fun _ => (1 : ℝ)) z :=
          indicator_nonneg (fun _ _ => zero_le_one) _
        rw [abs_le]; constructor <;> linarith
      · rw [indicator_of_notMem hzP, sub_zero, abs_of_nonneg h01.1]
        by_cases hzs : z ∈ s
        · have : (s \ K).indicator (fun _ => (1 : ℝ)) z = 1 := by simp [hzs, hzK]
          rw [this]
          have : 0 ≤ (P \ K).indicator (fun _ => (1 : ℝ)) z :=
            indicator_nonneg (fun _ _ => zero_le_one) _
          linarith [h01.2]
        · have : ψ z = 0 := by
            by_contra h
            exact hzs (hψs ▸ (mem_support.2 h))
          rw [this]
          exact add_nonneg (indicator_nonneg (fun _ _ => zero_le_one) _)
            (indicator_nonneg (fun _ _ => zero_le_one) _)
  -- Step 8: integrate, using `L(P \ K) < η/2` and `L(s \ K) ≤ L(U \ K) < η/2`
  have hPKm : MeasurableSet (P \ K) := hP.diff hKcl.measurableSet
  have hsKm : MeasurableSet (s \ K) := hs.measurableSet.diff hKcl.measurableSet
  have hPKfin : volume (P \ K) ≠ ∞ := (measure_mono sdiff_subset |>.trans_lt hPfin.lt_top).ne
  have hsKlt : volume (s \ K) < ENNReal.ofReal (η / 2) := by
    calc volume (s \ K) ≤ volume (U \ K) :=
          measure_mono (sdiff_subset_sdiff_left inter_subset_left)
      _ = volume U - volume K :=
          measure_sdiff hKU hKcl.measurableSet.nullMeasurableSet hKc.measure_lt_top.ne
      _ < ENNReal.ofReal (η / 2) := by
        rw [ENNReal.sub_lt_iff_lt_right hKc.measure_lt_top.ne (measure_mono hKU)]
        rwa [add_comm]
  have hsKfin : volume (s \ K) ≠ ∞ := (hsKlt.trans ENNReal.ofReal_lt_top).ne
  have hint1 : Integrable ((P \ K).indicator (fun _ => (1 : ℝ))) :=
    (integrableOn_const hPKfin).integrable_indicator hPKm
  have hint2 : Integrable ((s \ K).indicator (fun _ => (1 : ℝ))) :=
    (integrableOn_const hsKfin).integrable_indicator hsKm
  calc ∫ z, |ψ z - P.indicator (fun _ => (1 : ℝ)) z|
      ≤ ∫ z, ((P \ K).indicator (fun _ => (1 : ℝ)) z + (s \ K).indicator (fun _ => (1 : ℝ)) z) :=
        integral_mono_of_nonneg (Filter.Eventually.of_forall fun z => abs_nonneg _)
          (hint1.add hint2) (Filter.Eventually.of_forall hdom)
    _ = (volume (P \ K)).toReal + (volume (s \ K)).toReal := by
        rw [integral_add hint1 hint2, integral_indicator_const _ hPKm,
          integral_indicator_const _ hsKm]
        simp [Measure.real]
    _ < η / 2 + η / 2 := by
        gcongr
        · exact (ENNReal.toReal_lt_toReal hPKfin ENNReal.ofReal_ne_top).2 hPK
            |>.trans_eq (ENNReal.toReal_ofReal (half_pos hη).le)
        · exact (ENNReal.toReal_lt_toReal hsKfin ENNReal.ofReal_ne_top).2 hsKlt
            |>.trans_eq (ENNReal.toReal_ofReal (half_pos hη).le)
    _ = η := add_halves η

/-- **The `L¹` norm on a ball by duality with `C¹` test functions** (used in the mollification
estimate of the precompactness step of the BV compactness theorem, Simon Ch. 2, 2.6, which the book
delegates to [GT01, Theorem 7.22]; this serves De Giorgi's argument), for
bounded Borel `f`: if `|f| ≤ M` and `∫ f φ ≤ A` for every `C¹` function `φ` with compact support in
`B_R(0)` and `|φ| ≤ 1`, then `∫_{B_R(0)} |f| ≤ A`.  With `P = {f > 0} ∩ B_R(0)`,
`N = {f < 0} ∩ B_R(0)` and `g = 1_P − 1_N` one has `f g = 1_{B_R(0)} |f|`.  Approximating `1_P` and
`1_N` in `L¹` within `η' = η / (2(M + 1))` by `C¹` functions `ψ_P`, `ψ_N` with values in `[0, 1]`
and compact support in `B_R(0)` (`smooth_indicator_approx`) gives the admissible test
`φ = ψ_P − ψ_N`, and `∫ f g − ∫ f φ ≤ M (∫ |ψ_P − 1_P| + ∫ |ψ_N − 1_N|) < (M + 1) 2η' = η`. -/
theorem Submission.codim1_rdo_dg_bvc_l1_le_of_tests : ∀ (n : ℕ) (f : Euclid n → ℝ) (R A M : ℝ), Measurable f → (∀ z, |f z| ≤ M) → (∀ φ : Euclid n → ℝ, ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ ball (0 : Euclid n) R → (∀ z, |φ z| ≤ 1) → ∫ z, f z * φ z ≤ A) → ∫ z in ball (0 : Euclid n) R, |f z| ≤ A := by
  intro n f R A M hf hM hA
  -- Step 1: `M ≥ |f 0| ≥ 0`; `P = {f > 0} ∩ B_R` and `N = {f < 0} ∩ B_R` are Borel subsets of
  -- `B_R` (so of finite measure); `g = 1_P − 1_N`
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  set P : Set (Euclid n) := {z | 0 < f z} ∩ ball 0 R
  set N : Set (Euclid n) := {z | f z < 0} ∩ ball 0 R
  have hPm : MeasurableSet P := (measurableSet_lt measurable_const hf).inter measurableSet_ball
  have hNm : MeasurableSet N := (measurableSet_lt hf measurable_const).inter measurableSet_ball
  have hPfin : volume P ≠ ∞ := (measure_mono inter_subset_right |>.trans_lt measure_ball_lt_top).ne
  have hNfin : volume N ≠ ∞ := (measure_mono inter_subset_right |>.trans_lt measure_ball_lt_top).ne
  set g : Euclid n → ℝ := fun z =>
    P.indicator (fun _ => (1 : ℝ)) z - N.indicator (fun _ => (1 : ℝ)) z with hg
  -- Step 2: `f g = 1_{B_R} |f|` pointwise, so `∫_{B_R} |f| = ∫ f g`; `f g` is integrable, being
  -- Borel, bounded by `M` and zero outside `B_R`
  have hfg : (fun z => f z * g z) = (ball (0 : Euclid n) R).indicator fun z => |f z| := by
    funext z
    by_cases hz : z ∈ ball (0 : Euclid n) R
    · rw [indicator_of_mem hz]
      rcases lt_trichotomy (f z) 0 with h | h | h
      · have hzP : z ∉ P := fun hzP => lt_asymm h hzP.1
        have hzN : z ∈ N := ⟨h, hz⟩
        simp only [hg, indicator_of_notMem hzP, indicator_of_mem hzN, abs_of_neg h]
        ring
      · simp [h]
      · have hzP : z ∈ P := ⟨h, hz⟩
        have hzN : z ∉ N := fun hzN => lt_asymm h hzN.1
        simp only [hg, indicator_of_mem hzP, indicator_of_notMem hzN, abs_of_pos h]
        ring
    · have hzP : z ∉ P := fun hzP => hz hzP.2
      have hzN : z ∉ N := fun hzN => hz hzN.2
      simp only [hg, indicator_of_notMem hzP, indicator_of_notMem hzN, indicator_of_notMem hz]
      ring
  have hrepr : ∫ z in ball (0 : Euclid n) R, |f z| = ∫ z, f z * g z := by
    rw [hfg, integral_indicator measurableSet_ball]
  have hfg_int : Integrable fun z => f z * g z := by
    rw [hfg]
    refine (Measure.integrableOn_of_bounded (M := M) measure_ball_lt_top.ne
      (continuous_abs.measurable.comp hf).aestronglyMeasurable
      (Eventually.of_forall fun z => ?_)).integrable_indicator measurableSet_ball
    simpa [Real.norm_eq_abs] using hM z
  -- Step 3: given `η > 0`, approximate `1_P` and `1_N` in `L¹` within `η' = η / (2(M + 1))`
  refine le_of_forall_pos_lt_add fun η hη => ?_
  have hM1 : 0 < M + 1 := by linarith
  set η' : ℝ := η / (2 * (M + 1)) with hη'
  have hη'0 : 0 < η' := div_pos hη (mul_pos two_pos hM1)
  obtain ⟨ψP, hψP, hcP, htP, h01P, hapP⟩ :=
    Submission.codim1_rdo_dg_bvc_smooth_indicator_approx n P R η' hPm inter_subset_right hη'0
  obtain ⟨ψN, hψN, hcN, htN, h01N, hapN⟩ :=
    Submission.codim1_rdo_dg_bvc_smooth_indicator_approx n N R η' hNm inter_subset_right hη'0
  -- Step 4: `φ = ψ_P − ψ_N` is an admissible test, so `∫ f φ ≤ A`; `f φ` is integrable
  set φ : Euclid n → ℝ := fun z => ψP z - ψN z with hφ
  have hφ1 : ∀ z, |φ z| ≤ 1 := fun z => by
    obtain ⟨h0P, h1P⟩ := h01P z
    obtain ⟨h0N, h1N⟩ := h01N z
    rw [hφ, abs_le]
    constructor <;> linarith
  have hφA : ∫ z, f z * φ z ≤ A :=
    hA φ (hψP.sub hψN) (hcP.sub hcN) ((tsupport_sub ψP ψN).trans (union_subset htP htN)) hφ1
  have hfφ_int : Integrable fun z => f z * φ z :=
    ((hψP.sub hψN).continuous.integrable_of_hasCompactSupport (hcP.sub hcN)).bdd_mul
      hf.aestronglyMeasurable (Eventually.of_forall fun z => by simpa [Real.norm_eq_abs] using hM z)
  -- Step 5: `f g − f φ ≤ M (|ψ_P − 1_P| + |ψ_N − 1_N|)` pointwise, and these errors are integrable;
  -- integrate
  have hIP : Integrable fun z => |ψP z - P.indicator (fun _ => (1 : ℝ)) z| :=
    ((hψP.continuous.integrable_of_hasCompactSupport hcP).sub
      ((integrableOn_const (C := (1 : ℝ)) hPfin).integrable_indicator hPm)).abs
  have hIN : Integrable fun z => |ψN z - N.indicator (fun _ => (1 : ℝ)) z| :=
    ((hψN.continuous.integrable_of_hasCompactSupport hcN).sub
      ((integrableOn_const (C := (1 : ℝ)) hNfin).integrable_indicator hNm)).abs
  have hpt : ∀ z, f z * g z - f z * φ z ≤ M * (|ψP z - P.indicator (fun _ => (1 : ℝ)) z| +
      |ψN z - N.indicator (fun _ => (1 : ℝ)) z|) := by
    intro z
    calc f z * g z - f z * φ z
        = f z * ((P.indicator (fun _ => (1 : ℝ)) z - ψP z) -
            (N.indicator (fun _ => (1 : ℝ)) z - ψN z)) := by
          simp only [hg, hφ]
          ring
      _ ≤ |f z| * |(P.indicator (fun _ => (1 : ℝ)) z - ψP z) -
            (N.indicator (fun _ => (1 : ℝ)) z - ψN z)| := by
          rw [← abs_mul]
          exact le_abs_self _
      _ ≤ M * (|ψP z - P.indicator (fun _ => (1 : ℝ)) z| +
            |ψN z - N.indicator (fun _ => (1 : ℝ)) z|) := by
          rw [abs_sub_comm (ψP z), abs_sub_comm (ψN z)]
          exact mul_le_mul (hM z) (abs_sub _ _) (abs_nonneg _) hM0
  have hmain : (∫ z, f z * g z) - ∫ z, f z * φ z ≤
      M * ((∫ z, |ψP z - P.indicator (fun _ => (1 : ℝ)) z|) +
        ∫ z, |ψN z - N.indicator (fun _ => (1 : ℝ)) z|) := by
    rw [← integral_sub hfg_int hfφ_int, ← integral_add hIP hIN, ← integral_const_mul]
    exact integral_mono (hfg_int.sub hfφ_int) ((hIP.add hIN).const_mul M) hpt
  -- Step 6: `S = ∫ |ψ_P − 1_P| + ∫ |ψ_N − 1_N|` satisfies `0 ≤ S < 2η'`, so
  -- `M S ≤ (M + 1) S < (M + 1) 2η' = η`
  set S : ℝ := (∫ z, |ψP z - P.indicator (fun _ => (1 : ℝ)) z|) +
    ∫ z, |ψN z - N.indicator (fun _ => (1 : ℝ)) z| with hS
  have hS0 : 0 ≤ S :=
    add_nonneg (integral_nonneg fun _ => abs_nonneg _) (integral_nonneg fun _ => abs_nonneg _)
  have hS2 : S < 2 * η' := by
    rw [hS]
    linarith
  have hMS : M * S < η :=
    calc M * S ≤ (M + 1) * S := by linarith
      _ < (M + 1) * (2 * η') := mul_lt_mul_of_pos_left hS2 hM1
      _ = η := by
        rw [hη']
        field_simp
  -- Step 7: `∫_{B_R} |f| = ∫ f g ≤ ∫ f φ + M S < A + η`; `η > 0` is arbitrary
  rw [hrepr]
  linarith
/-- **Translation against a `C¹` test function** (step 1 of the BV compactness argument, for a
single translation vector `w`): if `∫_F div g ≤ C` for every `C¹` field `g` with `|g| ≤ 1` and
compact support in `B_{R+|w|}(0)`, then `∫_F (φ(z) − φ(z + w)) dz ≤ |w| C` for every `C¹` test
function `φ` with `|φ| ≤ 1` and compact support in `B_R(0)`.  For `t ∈ [0, 1]` the field
`G_t = −|w|⁻¹ φ(· + tw) w` is admissible and `div G_t = −|w|⁻¹ Dφ(· + tw)[w]` (trace of a rank-one
map), so `Φ(t) = ∫_F φ(z + tw) dz`, differentiable under the integral sign, has
`Φ'(t) = ∫_F Dφ(z + tw)[w] dz ≥ −|w| C` on `[0, 1]`; hence `Φ(0) − Φ(1) ≤ |w| C`. -/
theorem Submission.codim1_rdo_dg_bvc_translate_test_le : ∀ (n : ℕ) (F : Set (Euclid n)) (R C : ℝ) (w : Euclid n) (φ : Euclid n → ℝ), MeasurableSet F → (∀ g : Euclid n → Euclid n, ContDiff ℝ 1 g → HasCompactSupport g → tsupport g ⊆ ball (0 : Euclid n) (R + ‖w‖) → (∀ z, ‖g z‖ ≤ 1) → ∫ z in F, LinearMap.trace ℝ (Euclid n) (fderiv ℝ g z : Euclid n →ₗ[ℝ] Euclid n) ≤ C) → ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ ball (0 : Euclid n) R → (∀ z, |φ z| ≤ 1) → ∫ z in F, (φ z - φ (z + w)) ≤ ‖w‖ * C := by
  intro n F R C w φ _hF hdiv hφ hφc hφs hφb
  -- `w = 0`: both sides vanish
  by_cases hw : w = 0
  · subst hw; simp
  have hwpos : 0 < ‖w‖ := norm_pos_iff.2 hw
  have hφd : Differentiable ℝ φ := hφ.differentiable one_ne_zero
  have hφ'c : Continuous (fderiv ℝ φ) := hφ.continuous_fderiv one_ne_zero
  have hφi : Integrable φ := hφ.continuous.integrable_of_hasCompactSupport hφc
  -- the elementary fields `G_t = (−‖w‖⁻¹ φ(· + t • w)) • w`, `0 ≤ t ≤ 1`, give
  -- `−‖w‖ C ≤ ∫_F Dφ(z + t • w)[w]`
  have hfield : ∀ t : ℝ, 0 ≤ t → t ≤ 1 →
      -(‖w‖ * C) ≤ ∫ z in F, fderiv ℝ φ (z + t • w) w := by
    intro t ht0 ht1
    set c : ℝ := -(‖w‖⁻¹) with hc
    set G : Euclid n → Euclid n := fun z => (c * φ (z + t • w)) • w with hG
    have hGd : ∀ z, HasFDerivAt G ((c • fderiv ℝ φ (z + t • w)).smulRight w) z := by
      intro z
      have h1 : HasFDerivAt (fun y : Euclid n => φ (y + t • w)) (fderiv ℝ φ (z + t • w)) z :=
        (hφd (z + t • w)).hasFDerivAt.comp z ((hasFDerivAt_id z).add_const (t • w))
      exact (h1.const_mul c).smul_const w
    have hGc1 : ContDiff ℝ 1 G :=
      (contDiff_const.mul (hφ.comp (contDiff_id.add contDiff_const))).smul contDiff_const
    -- `tsupport G ⊆ tsupport φ(· + t • w) = tsupport φ − t • w`
    have hpre : tsupport (fun y : Euclid n => φ (y + t • w)) =
        (fun y => y + t • w) ⁻¹' tsupport φ :=
      tsupport_comp_eq_preimage φ (Homeomorph.addRight (t • w))
    have hGsupp : tsupport G ⊆ tsupport (fun y : Euclid n => φ (y + t • w)) :=
      (tsupport_smul_subset_left _ _).trans tsupport_mul_subset_right
    have hGcs : HasCompactSupport G :=
      (hφc.comp_homeomorph (Homeomorph.addRight (t • w))).mul_left.smul_right
    have hGball : tsupport G ⊆ ball (0 : Euclid n) (R + ‖w‖) := by
      intro z hz
      have h1 : z + t • w ∈ ball (0 : Euclid n) R := hφs (hpre.subset (hGsupp hz))
      rw [mem_ball_zero_iff] at h1 ⊢
      have h2 : ‖t • w‖ ≤ ‖w‖ := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg ht0]
        exact mul_le_of_le_one_left (norm_nonneg _) ht1
      calc ‖z‖ = ‖(z + t • w) - t • w‖ := by simp
        _ ≤ ‖z + t • w‖ + ‖t • w‖ := norm_sub_le _ _
        _ < R + ‖w‖ := by linarith
    have hGnorm : ∀ z, ‖G z‖ ≤ 1 := by
      intro z
      simp only [hG, hc, norm_smul, Real.norm_eq_abs, abs_mul, abs_neg, abs_inv, abs_norm]
      rw [mul_comm (‖w‖⁻¹), mul_assoc, inv_mul_cancel₀ hwpos.ne', mul_one]
      exact hφb _
    -- `div G_t(z) = c Dφ(z + t • w)[w]`: the trace of the rank-one map `h ↦ c Dφ(z + t • w)[h] w`
    have htrace : ∀ z, LinearMap.trace ℝ (Euclid n) (fderiv ℝ G z : Euclid n →ₗ[ℝ] Euclid n) =
        c * fderiv ℝ φ (z + t • w) w := by
      intro z
      rw [(hGd z).fderiv]
      have : ((c • fderiv ℝ φ (z + t • w)).smulRight w : Euclid n →L[ℝ] Euclid n) =
          (((c • fderiv ℝ φ (z + t • w) : Euclid n →L[ℝ] ℝ) : Euclid n →ₗ[ℝ] ℝ).smulRight w :
            Euclid n →ₗ[ℝ] Euclid n) := by
        ext v; simp
      rw [this, LinearMap.trace_smulRight]
      simp
    have hbound := hdiv G hGc1 hGcs hGball hGnorm
    simp_rw [htrace] at hbound
    rw [integral_const_mul] at hbound
    -- `−‖w‖⁻¹ ∫_F Dφ(z + t • w)[w] ≤ C`; multiply by `‖w‖ > 0`
    have h3 := mul_le_mul_of_nonneg_left hbound hwpos.le
    rw [← mul_assoc, hc, mul_neg, mul_inv_cancel₀ hwpos.ne', neg_one_mul] at h3
    linarith
  -- `Φ(t) = ∫_F φ(z + t • w)` has derivative `∫_F Dφ(z + t • w)[w]` (dominated differentiation)
  obtain ⟨B, hB⟩ : ∃ B, ∀ x, ‖fderiv ℝ φ x‖ ≤ B :=
    (hφc.fderiv (𝕜 := ℝ)).exists_bound_of_continuous hφ'c
  set Φ : ℝ → ℝ := fun t => ∫ z in F, φ (z + t • w) with hΦ
  have hΦd : ∀ t₀ : ℝ, HasDerivAt Φ (∫ z in F, fderiv ℝ φ (z + t₀ • w) w) t₀ := by
    intro t₀
    set K : Set (Euclid n) := closedBall (0 : Euclid n) (R + (|t₀| + 1) * ‖w‖)
    have hKm : MeasurableSet K := measurableSet_closedBall
    have hKfin : volume K ≠ ∞ := measure_closedBall_lt_top.ne
    -- `Dφ(z + t • w) ≠ 0` forces `z + t • w ∈ tsupport φ ⊆ B_R(0)`
    have hsupp : ∀ z t, fderiv ℝ φ (z + t • w) ≠ 0 → ‖z‖ < R + |t| * ‖w‖ := by
      intro z t h
      have h1 := hφs (tsupport_fderiv_subset ℝ (subset_tsupport _ h))
      rw [mem_ball_zero_iff] at h1
      calc ‖z‖ = ‖(z + t • w) - t • w‖ := by simp
        _ ≤ ‖z + t • w‖ + ‖t • w‖ := norm_sub_le _ _
        _ < R + |t| * ‖w‖ := by rw [norm_smul, Real.norm_eq_abs]; linarith
    refine (hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := volume.restrict F)
      (F := fun t z => φ (z + t • w)) (F' := fun t z => fderiv ℝ φ (z + t • w) w)
      (bound := K.indicator (fun _ => B * ‖w‖)) (s := ball t₀ 1) (ball_mem_nhds t₀ zero_lt_one)
      ?_ ?_ ?_ ?_ ?_ ?_).2
    · exact Filter.Eventually.of_forall fun t =>
        (hφ.continuous.comp (continuous_id.add continuous_const)).aestronglyMeasurable
    · exact (hφi.comp_add_right (t₀ • w)).integrableOn
    · exact ((hφ'c.comp (continuous_id.add continuous_const)).clm_apply
        continuous_const).aestronglyMeasurable
    · refine Filter.Eventually.of_forall fun z t ht => ?_
      by_cases hz : fderiv ℝ φ (z + t • w) = 0
      · simp only [hz, zero_apply, norm_zero]
        exact indicator_nonneg
          (fun _ _ => mul_nonneg ((norm_nonneg _).trans (hB 0)) (norm_nonneg _)) _
      · have hzK : z ∈ K := by
          have h1 := hsupp z t hz
          have h2 : |t| ≤ |t₀| + 1 := by
            have := abs_sub_abs_le_abs_sub t t₀
            rw [mem_ball, Real.dist_eq] at ht; linarith
          rw [mem_closedBall_zero_iff]
          nlinarith [norm_nonneg w]
        rw [indicator_of_mem hzK]
        exact (ContinuousLinearMap.le_opNorm _ _).trans
          (mul_le_mul_of_nonneg_right (hB _) (norm_nonneg _))
    · exact ((integrableOn_const hKfin).integrable_indicator hKm).integrableOn
    · refine Filter.Eventually.of_forall fun z t _ => ?_
      have h1 : HasDerivAt (fun s : ℝ => z + s • w) w t := by
        simpa using ((hasDerivAt_id t).smul_const w).const_add z
      exact (hφd (z + t • w)).hasFDerivAt.comp_hasDerivAt t h1
  -- `Ψ(t) = Φ(t) + ‖w‖ C t` has `Ψ' ≥ 0` on `(0, 1)`, so `Ψ(0) ≤ Ψ(1)`
  set Ψ : ℝ → ℝ := fun t => Φ t + ‖w‖ * C * t with hΨ
  have hΨd : ∀ t, HasDerivAt Ψ ((∫ z in F, fderiv ℝ φ (z + t • w) w) + ‖w‖ * C) t := by
    intro t
    have := (hΦd t).add ((hasDerivAt_id t).const_mul (‖w‖ * C))
    simp only [id, mul_one] at this
    exact this
  have hmono : MonotoneOn Ψ (Icc 0 1) := by
    refine monotoneOn_of_deriv_nonneg (convex_Icc 0 1) ?_ ?_ ?_
    · exact fun t _ => (hΨd t).continuousAt.continuousWithinAt
    · exact fun t _ => (hΨd t).differentiableAt.differentiableWithinAt
    · intro t ht
      rw [interior_Icc] at ht
      rw [(hΨd t).deriv]
      linarith [hfield t ht.1.le ht.2.le]
  have h01 := hmono ⟨le_rfl, zero_le_one⟩ ⟨zero_le_one, le_rfl⟩ zero_le_one
  simp only [hΨ, hΦ, zero_smul, add_zero, one_smul, mul_zero, mul_one] at h01
  -- `Φ(0) − Φ(1) = ∫_F (φ z − φ (z + w))`
  rw [integral_sub hφi.integrableOn (hφi.comp_add_right w).integrableOn]
  linarith
/-- **`L¹` translation estimate** (step 1 of the BV compactness argument behind Simon Ch. 2, 2.6,
via [GT01, 7.22], for a single translation `w`).  If `∫_F div g ≤ C` for every `C¹` vector field
`g` with `|g| ≤ 1` and compact support in `B_{R+|w|}(0)`, then
`∫_{B_R(0)} |1_F(z) − 1_F(z − w)| dz ≤ |w| C`.  The difference `f = 1_F − 1_F(· − w)` is Borel with
`|f| ≤ 1`; for an admissible test `φ`, translation invariance of Lebesgue measure gives
`∫ f φ = ∫_F (φ − φ(· + w))`, which `translate_test` bounds by `|w| C`, and `l1_duality` (with
`M = 1`) turns this weak bound into the `L¹` bound. -/
theorem Submission.codim1_rdo_dg_bvc_translation_l1_le : ∀ (n : ℕ) (F : Set (Euclid n)) (R C : ℝ) (w : Euclid n), MeasurableSet F → (∀ g : Euclid n → Euclid n, ContDiff ℝ 1 g → HasCompactSupport g → tsupport g ⊆ ball (0 : Euclid n) (R + ‖w‖) → (∀ z, ‖g z‖ ≤ 1) → ∫ z in F, LinearMap.trace ℝ (Euclid n) (fderiv ℝ g z : Euclid n →ₗ[ℝ] Euclid n) ≤ C) → ∫ z in ball (0 : Euclid n) R, |F.indicator (fun _ => (1 : ℝ)) z - F.indicator (fun _ => (1 : ℝ)) (z - w)| ≤ ‖w‖ * C := by
  intro n F R C w hF hdiv
  -- Step 1: `u = 1_F` takes values in `[0, 1]`, so `f = u − u(· − w)` is Borel with `|f| ≤ 1`
  set u : Euclid n → ℝ := F.indicator (fun _ => (1 : ℝ)) with hu
  have hu01 : ∀ z, 0 ≤ u z ∧ u z ≤ 1 := fun z => by
    by_cases hz : z ∈ F <;> simp [hu, hz]
  have hu_meas : Measurable u := measurable_const.indicator hF
  have hu_shift : Measurable fun z => u (z - w) := hu_meas.comp (measurable_id.sub_const w)
  have hbd : ∀ z, |u z - u (z - w)| ≤ 1 := fun z => by
    rw [abs_le]
    constructor <;> linarith [(hu01 z).1, (hu01 z).2, (hu01 (z - w)).1, (hu01 (z - w)).2]
  -- Step 4: `l1_duality` with `M = 1` and `A = ‖w‖ C` reduces the claim to the tested bound
  refine Submission.codim1_rdo_dg_bvc_l1_le_of_tests n (fun z => u z - u (z - w)) R (‖w‖ * C) 1
    (hu_meas.sub hu_shift) hbd fun φ hφ hφc hφs hφb => ?_
  -- Step 2: `∫ f φ = ∫_F (φ − φ(· + w))`, moving the translation onto `φ` (`z = y + w`)
  have hφi : Integrable φ := hφ.continuous.integrable_of_hasCompactSupport hφc
  have hmul : ∀ ψ : Euclid n → ℝ, (fun z => u z * ψ z) = F.indicator ψ := fun ψ => by
    funext z
    by_cases hz : z ∈ F <;> simp [hu, hz]
  have h1 : Integrable fun z => u z * φ z := by
    rw [hmul]
    exact hφi.indicator hF
  have hu_shift_le : ∀ z, ‖u (z - w)‖ ≤ 1 := fun z => by
    rw [Real.norm_eq_abs, abs_of_nonneg (hu01 (z - w)).1]
    exact (hu01 (z - w)).2
  have h2 : Integrable fun z => u (z - w) * φ z :=
    hφi.bdd_mul hu_shift.aestronglyMeasurable (Eventually.of_forall hu_shift_le)
  have h3 : Integrable fun z => u z * φ (z + w) := by
    rw [hmul]
    exact (hφi.comp_add_right w).indicator hF
  have hshift : ∫ z, u (z - w) * φ z = ∫ z, u z * φ (z + w) := by
    rw [← integral_add_right_eq_self (fun z => u (z - w) * φ z) w]
    simp
  have key : ∫ z, (u z - u (z - w)) * φ z = ∫ z in F, (φ z - φ (z + w)) := by
    simp_rw [sub_mul]
    rw [integral_sub h1 h2, hshift, ← integral_sub h1 h3, ← integral_indicator hF]
    congr 1
    funext z
    by_cases hz : z ∈ F <;> simp [hu, hz]
  -- Step 3: `translate_test` bounds `∫_F (φ − φ(· + w))` by `‖w‖ C`
  exact key.trans_le
    (Submission.codim1_rdo_dg_bvc_translate_test_le n F R C w φ hF hdiv hφ hφc hφs hφb)

/-- **Mollification estimate for a set of bounded perimeter** (Simon 2.6, chapter-02.txt
lines 598–626, the precompactness step delegated to [GT01, Theorem 7.22]: with `u = 1_F`,
`‖u − ρ * u‖_{L¹(B_R)} ≤ ε C` when `ρ ≥ 0`, `∫ ρ = 1`, `support ρ ⊆ B_ε(0)`, `ε ≤ 1` and
`∫_F div g ≤ C` for the fields `g` of the class in `B_{R+1}(0)`).  As `∫ ρ = 1`,
`|u(z) − ∫ ρ(y) u(z − y) dy| ≤ ∫ ρ(y) |u(z) − u(z − y)| dy`; the integrand is at most `ρ(y)`,
so Fubini on `B_R(0) × ℝⁿ` turns the integral over `B_R(0)` into `∫ ρ(y) I(y) dy` with
`I(y) = ∫_{B_R(0)} |u(z) − u(z − y)| dz`.  For `ρ(y) ≠ 0`, `|y| < ε ≤ 1`, so the translation
estimate `Submission.codim1_rdo_dg_bvc_translation_l1_le` applies at radius
`R + |y| ≤ R + 1` and gives `I(y) ≤ |y| C ≤ ε C`. -/
theorem Submission.codim1_rdo_dg_bvc_mollify_l1_le : ∀ (n : ℕ) (F : Set (Euclid n)) (R C ε : ℝ) (ρ : Euclid n → ℝ), MeasurableSet F → ε ≤ 1 → Continuous ρ → HasCompactSupport ρ → (∀ y, 0 ≤ ρ y) → ∫ y, ρ y = 1 → support ρ ⊆ ball (0 : Euclid n) ε → (∀ g : Euclid n → Euclid n, ContDiff ℝ 1 g → HasCompactSupport g → tsupport g ⊆ ball (0 : Euclid n) (R + 1) → (∀ z, ‖g z‖ ≤ 1) → ∫ z in F, LinearMap.trace ℝ (Euclid n) (fderiv ℝ g z : Euclid n →ₗ[ℝ] Euclid n) ≤ C) → ∫ z in ball (0 : Euclid n) R, |F.indicator (fun _ => (1 : ℝ)) z - ∫ y, ρ y * F.indicator (fun _ => (1 : ℝ)) (z - y)| ≤ ε * C := by
  intro n F R C ε ρ hF hε1 hρc hρcs hρ0 hρ1 hρs hdiv
  set u : Euclid n → ℝ := F.indicator (fun _ => (1 : ℝ)) with hu
  have hu_meas : Measurable u := measurable_const.indicator hF
  have hu01 : ∀ z, 0 ≤ u z ∧ u z ≤ 1 := fun z => by
    simp only [hu, Set.indicator]; split_ifs <;> norm_num
  have hbd : ∀ z y, |u z - u (z - y)| ≤ 1 := fun z y => by
    have h1 := hu01 z
    have h2 := hu01 (z - y)
    rw [abs_le]; constructor <;> linarith
  -- Step 1: `C ≥ 0` (the field `g = 0`) and `ρ` is integrable
  have hC : 0 ≤ C := by
    simpa using hdiv (fun _ => 0) contDiff_const HasCompactSupport.zero (by simp) (by simp)
  have hρint : Integrable ρ := hρc.integrable_of_hasCompactSupport hρcs
  -- Step 2: pointwise, `|u z − ∫ ρ(y) u(z − y)| ≤ ∫ ρ(y) |u z − u(z − y)|`, since `∫ ρ = 1`
  have hpt : ∀ z, |u z - ∫ y, ρ y * u (z - y)| ≤ ∫ y, ρ y * |u z - u (z - y)| := by
    intro z
    have hint1 : Integrable (fun y => ρ y * u z) := hρint.mul_const _
    have hint2 : Integrable (fun y => ρ y * u (z - y)) :=
      hρint.mul_bdd (c := 1) (hu_meas.comp (measurable_const.sub measurable_id)).aestronglyMeasurable
        (Eventually.of_forall fun y => by
          rw [Real.norm_eq_abs, abs_of_nonneg (hu01 (z - y)).1]
          exact (hu01 (z - y)).2)
    have e : ∫ y, ρ y * (u z - u (z - y)) = u z - ∫ y, ρ y * u (z - y) := by
      simp_rw [mul_sub]
      rw [integral_sub hint1 hint2, integral_mul_const, hρ1, one_mul]
    rw [← e]
    refine abs_integral_le_integral_abs.trans_eq ?_
    congr 1
    funext y
    rw [abs_mul, abs_of_nonneg (hρ0 y)]
  -- Step 3: Fubini for `H(z, y) = ρ(y) |u z − u(z − y)| ≤ ρ(y)` on `B_R(0) × ℝⁿ`
  set H : Euclid n → Euclid n → ℝ := fun z y => ρ y * |u z - u (z - y)| with hH
  have hHmeas : Measurable (Function.uncurry H) :=
    (hρc.measurable.comp measurable_snd).mul (continuous_abs.measurable.comp
      ((hu_meas.comp measurable_fst).sub (hu_meas.comp (measurable_fst.sub measurable_snd))))
  have : IsFiniteMeasure (volume.restrict (ball (0 : Euclid n) R)) :=
    isFiniteMeasure_restrict.2 measure_ball_lt_top.ne
  have hHint :
      Integrable (Function.uncurry H) ((volume.restrict (ball (0 : Euclid n) R)).prod volume) := by
    have hdom : Integrable (fun p : Euclid n × Euclid n => ρ p.2)
        ((volume.restrict (ball (0 : Euclid n) R)).prod volume) := by
      simpa using
        (integrable_const (1 : ℝ) (μ := volume.restrict (ball (0 : Euclid n) R))).mul_prod hρint
    refine hdom.mono' hHmeas.aestronglyMeasurable (Eventually.of_forall fun p => ?_)
    simp only [Function.uncurry, hH, Real.norm_eq_abs, abs_mul, abs_of_nonneg (hρ0 p.2), abs_abs]
    exact mul_le_of_le_one_right (hρ0 p.2) (hbd _ _)
  -- Step 4: each translation; for `ρ(y) ≠ 0`, `translation_l1` with `w = y` at radius `R + |y|`
  have hinner : ∀ y, ∫ z in ball (0 : Euclid n) R, H z y ≤ ρ y * (ε * C) := by
    intro y
    simp only [hH]
    rw [integral_const_mul]
    by_cases hy : ρ y = 0
    · simp [hy]
    have hyε : ‖y‖ < ε := mem_ball_zero_iff.1 (hρs hy)
    have hdiv' : ∀ g : Euclid n → Euclid n, ContDiff ℝ 1 g → HasCompactSupport g →
        tsupport g ⊆ ball (0 : Euclid n) (R + ‖y‖) → (∀ z, ‖g z‖ ≤ 1) →
        ∫ z in F, LinearMap.trace ℝ (Euclid n) (fderiv ℝ g z : Euclid n →ₗ[ℝ] Euclid n) ≤ C :=
      fun g hg hgc hgs hgb => hdiv g hg hgc (hgs.trans (ball_subset_ball (by linarith))) hgb
    have hI : ∫ z in ball (0 : Euclid n) R, |u z - u (z - y)| ≤ ε * C :=
      (Submission.codim1_rdo_dg_bvc_translation_l1_le n F R C y hF hdiv').trans
        (mul_le_mul_of_nonneg_right hyε.le hC)
    exact mul_le_mul_of_nonneg_left hI (hρ0 y)
  -- Step 5: combine the three estimates
  calc ∫ z in ball (0 : Euclid n) R, |u z - ∫ y, ρ y * u (z - y)|
      ≤ ∫ z in ball (0 : Euclid n) R, ∫ y, H z y :=
        integral_mono_of_nonneg (Eventually.of_forall fun z => abs_nonneg _)
          hHint.integral_prod_left (Eventually.of_forall hpt)
    _ = ∫ y, ∫ z in ball (0 : Euclid n) R, H z y := integral_integral_swap hHint
    _ ≤ ∫ y, ρ y * (ε * C) := integral_mono hHint.integral_prod_right (hρint.mul_const _) hinner
    _ = ε * C := by rw [integral_mul_const, hρ1, one_mul]
/-- **Mollified indicators are uniformly bounded and uniformly Lipschitz** (step 2 of the `BV`
compactness theorem, Simon Ch. 2, 2.6, for indicators).  Let `ρ ≥ 0` be `C¹` with compact
support and `∫ ρ = 1`, and `v_F(x) = ∫ ρ(y) 1_F(x − y) dy`.  Then `|v_F| ≤ ∫ ρ = 1`.  `ρ` is
`L_ρ`-Lipschitz; after `y ↦ x − y`, `v_F(x) − v_F(x') = ∫ (ρ(x − z) − ρ(x' − z)) 1_F(z) dz`,
whose integrand is at most `L_ρ|x − x'| (1_K(x − z) + 1_K(x' − z))` with `K = spt ρ`, so
`|v_F(x) − v_F(x')| ≤ 2L_ρ|K| |x − x'|`.  Hence `L = max 1 (2L_ρ|K|)` serves every measurable
`F`. -/
theorem Submission.codim1_rdo_dg_bvc_mollified_lipschitz : ∀ (n : ℕ) (ρ : Euclid n → ℝ), ContDiff ℝ 1 ρ → HasCompactSupport ρ → (∀ y, 0 ≤ ρ y) → ∫ y, ρ y = 1 → ∃ L : ℝ, ∀ F : Set (Euclid n), MeasurableSet F → (∀ x, |∫ y, ρ y * F.indicator (fun _ => (1 : ℝ)) (x - y)| ≤ L) ∧ ∀ x x', |(∫ y, ρ y * F.indicator (fun _ => (1 : ℝ)) (x - y)) - ∫ y, ρ y * F.indicator (fun _ => (1 : ℝ)) (x' - y)| ≤ L * ‖x - x'‖ := by
  intro n ρ hρ hρc hρ0 hρ1
  -- `ρ` is `Lρ`-Lipschitz, and `K = spt ρ` is compact with finite measure `V`
  obtain ⟨Lρ, hLρ⟩ := hρ.lipschitzWith_of_hasCompactSupport hρc (by norm_num)
  set K := tsupport ρ
  have hKc : IsCompact K := hρc
  have hKm : MeasurableSet K := (isClosed_tsupport ρ).measurableSet
  have hKfin : volume K ≠ ∞ := hKc.measure_lt_top.ne
  set V : ℝ := (volume K).toReal with hV
  have hρint : Integrable ρ := hρ.continuous.integrable_of_hasCompactSupport hρc
  have hind : ∀ (s : Set (Euclid n)) (z : Euclid n), |s.indicator (fun _ => (1 : ℝ)) z| ≤ 1 := by
    intro s z
    simp only [Set.indicator]; split_ifs <;> norm_num
  have hK0 : ∀ w, 0 ≤ K.indicator (fun _ => (1 : ℝ)) w :=
    fun w => indicator_nonneg (fun _ _ => zero_le_one) w
  refine ⟨max 1 (2 * Lρ * V), fun F hF => ⟨fun x => ?_, fun x x' => ?_⟩⟩
  · -- `|v_F(x)| ≤ ∫ ρ = 1`
    have hu : ∀ y, |ρ y * F.indicator (fun _ => (1 : ℝ)) (x - y)| ≤ ρ y := by
      intro y
      rw [abs_mul, abs_of_nonneg (hρ0 y)]
      exact mul_le_of_le_one_right (hρ0 y) (hind F (x - y))
    calc |∫ y, ρ y * F.indicator (fun _ => (1 : ℝ)) (x - y)|
        ≤ ∫ y, |ρ y * F.indicator (fun _ => (1 : ℝ)) (x - y)| := abs_integral_le_integral_abs
      _ ≤ ∫ y, ρ y := integral_mono_of_nonneg (Filter.Eventually.of_forall fun y => abs_nonneg _)
          hρint (Filter.Eventually.of_forall hu)
      _ = 1 := hρ1
      _ ≤ max 1 (2 * Lρ * V) := le_max_left _ _
  · -- `v_F(x) = ∫ ρ(x − z) 1_F(z) dz` (Lebesgue measure is invariant under `y ↦ x − y`)
    have hsub : ∀ x : Euclid n, ∫ y, ρ y * F.indicator (fun _ => (1 : ℝ)) (x - y) =
        ∫ z, ρ (x - z) * F.indicator (fun _ => (1 : ℝ)) z := by
      intro x
      rw [← integral_sub_left_eq_self (fun z => ρ (x - z) * F.indicator (fun _ => (1 : ℝ)) z)
        volume x]
      simp
    have hi : ∀ x : Euclid n,
        Integrable (fun z => ρ (x - z) * F.indicator (fun _ => (1 : ℝ)) z) := by
      intro x
      refine Integrable.mul_bdd (c := 1) (hρint.comp_sub_left x) ?_ ?_
      · exact (measurable_const.indicator hF).aestronglyMeasurable
      · exact Filter.Eventually.of_forall fun z => by rw [Real.norm_eq_abs]; exact hind F z
    rw [hsub x, hsub x', ← integral_sub (hi x) (hi x')]
    -- pointwise, `|(ρ(x − z) − ρ(x' − z)) 1_F(z)| ≤ Lρ|x − x'| (1_K(x − z) + 1_K(x' − z))`
    have hpt : ∀ z, |ρ (x - z) * F.indicator (fun _ => (1 : ℝ)) z -
        ρ (x' - z) * F.indicator (fun _ => (1 : ℝ)) z| ≤
        Lρ * ‖x - x'‖ * (K.indicator (fun _ => (1 : ℝ)) (x - z) +
          K.indicator (fun _ => (1 : ℝ)) (x' - z)) := by
      intro z
      rw [← sub_mul, abs_mul]
      have hlip : |ρ (x - z) - ρ (x' - z)| ≤ Lρ * ‖x - x'‖ := by
        have := hLρ.dist_le_mul (x - z) (x' - z)
        rw [Real.dist_eq, dist_eq_norm] at this
        simpa using this
      by_cases h : x - z ∈ K ∨ x' - z ∈ K
      · have hs : 1 ≤ K.indicator (fun _ => (1 : ℝ)) (x - z) +
            K.indicator (fun _ => (1 : ℝ)) (x' - z) := by
          rcases h with h | h
          · rw [indicator_of_mem h]; linarith [hK0 (x' - z)]
          · rw [indicator_of_mem h (f := fun _ => (1 : ℝ))]; linarith [hK0 (x - z)]
        calc |ρ (x - z) - ρ (x' - z)| * |F.indicator (fun _ => (1 : ℝ)) z|
            ≤ Lρ * ‖x - x'‖ * 1 := mul_le_mul hlip (hind F z) (abs_nonneg _) (by positivity)
          _ ≤ _ := mul_le_mul_of_nonneg_left hs (by positivity)
      · push Not at h
        have h1 : ρ (x - z) = 0 := image_eq_zero_of_notMem_tsupport h.1
        have h2 : ρ (x' - z) = 0 := image_eq_zero_of_notMem_tsupport h.2
        rw [h1, h2, sub_zero, abs_zero, zero_mul]
        exact mul_nonneg (by positivity) (add_nonneg (hK0 _) (hK0 _))
    -- `∫ 1_K(x − z) dz = |K| = V`
    have hKi : ∀ x : Euclid n, Integrable (fun z => K.indicator (fun _ => (1 : ℝ)) (x - z)) :=
      fun x => ((integrableOn_const hKfin).integrable_indicator hKm).comp_sub_left x
    have hKint : ∀ x : Euclid n, ∫ z, K.indicator (fun _ => (1 : ℝ)) (x - z) = V := by
      intro x
      rw [integral_sub_left_eq_self (fun z => K.indicator (fun _ => (1 : ℝ)) z) volume x,
        integral_indicator_const _ hKm]
      simp [hV, Measure.real]
    calc |∫ z, (ρ (x - z) * F.indicator (fun _ => (1 : ℝ)) z -
          ρ (x' - z) * F.indicator (fun _ => (1 : ℝ)) z)|
        ≤ ∫ z, |ρ (x - z) * F.indicator (fun _ => (1 : ℝ)) z -
          ρ (x' - z) * F.indicator (fun _ => (1 : ℝ)) z| := abs_integral_le_integral_abs
      _ ≤ ∫ z, Lρ * ‖x - x'‖ * (K.indicator (fun _ => (1 : ℝ)) (x - z) +
          K.indicator (fun _ => (1 : ℝ)) (x' - z)) :=
          integral_mono_of_nonneg (Filter.Eventually.of_forall fun z => abs_nonneg _)
            (((hKi x).add (hKi x')).const_mul _) (Filter.Eventually.of_forall hpt)
      _ = Lρ * ‖x - x'‖ * (V + V) := by
          rw [integral_const_mul, integral_add (hKi x) (hKi x'), hKint x, hKint x']
      _ = 2 * Lρ * V * ‖x - x'‖ := by ring
      _ ≤ max 1 (2 * Lρ * V) * ‖x - x'‖ :=
          mul_le_mul_of_nonneg_right (le_max_right _ _) (norm_nonneg _)
/-- **Local `L¹` total boundedness of the indicators** (step 3 of the BV compactness argument
behind De Giorgi's theorem, Simon 2.6 / [GT01, 7.22]).  If the `F_k ⊆ ℝ^{m+1}` have eventually
bounded perimeter in every ball, then for `R, θ > 0` finitely many `F_i` form a `θ`-net of the
`F_k` in `L¹(B_R)`.  From the bound `C ≥ 0` at radius `R + 1`, valid for `k ≥ k₀`, choose
`ε ≤ 1` with `εC < θ/3` and a mollifier `ρ` supported in `B_ε`; then `1_{F_k}` is `εC`-close
in `L¹(B_R)` to `v_k = ρ * 1_{F_k}`, the `v_k` are uniformly bounded and Lipschitz, so a finite
sup-norm `δ`-net on `closedBall 0 R` with `δ L(B_R) < θ/3` gives the net for `k ≥ k₀`; the
indices `k < k₀` are their own centres. -/
theorem Submission.codim1_rdo_dg_bvc_indicator_totally_bounded : ∀ (m : ℕ) (Fs : ℕ → Set (Euclid (m + 1))), (∀ k, MeasurableSet (Fs k)) → (∀ R : ℝ, 0 < R → ∃ C : ℝ, ∀ᶠ k in atTop, ∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 g → HasCompactSupport g → tsupport g ⊆ ball (0 : Euclid (m + 1)) R → (∀ z, ‖g z‖ ≤ 1) → ∫ z in Fs k, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) ≤ C) → ∀ R : ℝ, 0 < R → ∀ θ : ℝ, 0 < θ → ∃ S : Finset ℕ, ∀ k, ∃ i ∈ S, volume (symmDiff (Fs k) (Fs i) ∩ ball (0 : Euclid (m + 1)) R) < ENNReal.ofReal θ := by
  intro m Fs hmeas hyp R hR θ hθ
  -- Step 1: the bound `C` at radius `R + 1` holds for `k ≥ k₀`; `g = 0` shows `C ≥ 0`
  obtain ⟨C, hev⟩ := hyp (R + 1) (by linarith)
  obtain ⟨k0, hk0⟩ := Filter.eventually_atTop.1 hev
  have hC : 0 ≤ C := by
    simpa using hk0 k0 le_rfl (fun _ => 0) contDiff_const HasCompactSupport.zero (by simp)
      (by simp)
  -- Step 2: `ε = min (1/2) (θ / (3(C + 1)))`, so `ε ≤ 1` and `εC < θ/3`, and a mollifier `ρ`
  -- supported in `B_ε`
  set ε : ℝ := min (1 / 2) (θ / (3 * (C + 1))) with hεdef
  have hεpos : 0 < ε := lt_min (by norm_num) (div_pos hθ (by positivity))
  have hε1 : ε ≤ 1 := (min_le_left _ _).trans (by norm_num)
  have hεC : ε * C < θ / 3 := by
    have h1 : ε ≤ θ / (3 * (C + 1)) := min_le_right _ _
    have h2 : θ / (3 * (C + 1)) * C < θ / 3 := by
      rw [div_mul_eq_mul_div, div_lt_div_iff₀ (by positivity) (by norm_num)]
      nlinarith
    exact (mul_le_mul_of_nonneg_right h1 hC).trans_lt h2
  obtain ⟨ρ, hρsmooth, hρcs, hρ0, hρ1, hρs⟩ :=
    Submission.dgcr_stc_exists_normalized_mollifier (m + 1) ε hεpos
  have hρC1 : ContDiff ℝ 1 ρ := hρsmooth.of_le (by exact_mod_cast le_top)
  -- Step 3: `u k = 1_{F_k}` is `εC`-close to `v k = ρ * 1_{F_k}` in `L¹(B_R)` for `k ≥ k₀`
  set u : ℕ → Euclid (m + 1) → ℝ := fun k => (Fs k).indicator (fun _ => (1 : ℝ)) with hu
  set v : ℕ → Euclid (m + 1) → ℝ :=
    fun k x => ∫ y, ρ y * (Fs k).indicator (fun _ => (1 : ℝ)) (x - y) with hv
  have hmoll : ∀ k, k0 ≤ k → ∫ z in ball (0 : Euclid (m + 1)) R, |u k z - v k z| ≤ ε * C :=
    fun k hk => Submission.codim1_rdo_dg_bvc_mollify_l1_le (m + 1) (Fs k) R C ε ρ (hmeas k) hε1
      hρsmooth.continuous hρcs hρ0 hρ1 hρs (hk0 k hk)
  -- Step 4: the `v k` are bounded by `L` and `L`-Lipschitz; a finite sup-norm `δ`-net of the
  -- `v (k₀ + j)` on `closedBall 0 R`, where `δ L(B_R) < θ/3`
  obtain ⟨L, hL⟩ := Submission.codim1_rdo_dg_bvc_mollified_lipschitz (m + 1) ρ hρC1 hρcs hρ0 hρ1
  set V : ℝ := (volume (ball (0 : Euclid (m + 1)) R)).toReal with hV
  have hV0 : 0 ≤ V := ENNReal.toReal_nonneg
  set δ : ℝ := θ / (3 * (V + 1)) with hδdef
  have hδ : 0 < δ := div_pos hθ (by positivity)
  have hδV : δ * V < θ / 3 := by
    rw [hδdef, div_mul_eq_mul_div, div_lt_div_iff₀ (by positivity) (by norm_num)]
    nlinarith
  obtain ⟨S', hS'⟩ := Submission.dorag_ha_rb_sup_net (m + 1) (closedBall (0 : Euclid (m + 1)) R)
      (fun j => v (k0 + j)) L (isCompact_closedBall _ _)
      (fun j x _ => (hL (Fs (k0 + j)) (hmeas _)).1 x)
      (fun j x _ y _ => (hL (Fs (k0 + j)) (hmeas _)).2 x y) δ hδ
  -- measurability, bounds and integrability on `B_R` of everything involved
  have hu_meas : ∀ k, Measurable (u k) := fun k => measurable_const.indicator (hmeas k)
  have hu_bd : ∀ k z, |u k z| ≤ 1 := by
    intro k z
    simp only [hu, Set.indicator]
    split_ifs <;> norm_num
  have hv_cont : ∀ k, Continuous (v k) := by
    intro k
    refine (LipschitzWith.of_dist_le_mul (K := L.toNNReal) fun x y => ?_).continuous
    rw [Real.dist_eq, dist_eq_norm]
    exact ((hL (Fs k) (hmeas k)).2 x y).trans
      (mul_le_mul_of_nonneg_right (Real.le_coe_toNNReal L) (norm_nonneg _))
  have hv_bd : ∀ k z, |v k z| ≤ L := fun k z => (hL (Fs k) (hmeas k)).1 z
  have hfin : volume (ball (0 : Euclid (m + 1)) R) ≠ ⊤ := measure_ball_lt_top.ne
  have hint : ∀ f : Euclid (m + 1) → ℝ, Measurable f → ∀ M : ℝ, (∀ z, |f z| ≤ M) →
      IntegrableOn f (ball (0 : Euclid (m + 1)) R) := by
    intro f hf M hM
    exact Measure.integrableOn_of_bounded (M := M) hfin hf.aestronglyMeasurable
      (Filter.Eventually.of_forall fun z => by simpa [Real.norm_eq_abs] using hM z)
  -- Step 5: the centres are `0, …, k₀ - 1` and `k₀ + i'`, `i' ∈ S'`
  refine ⟨Finset.range k0 ∪ S'.image (fun i => k0 + i), fun k => ?_⟩
  by_cases hk : k < k0
  · refine ⟨k, Finset.mem_union_left _ (Finset.mem_range.2 hk), ?_⟩
    simp only [symmDiff_self, Set.bot_eq_empty, Set.empty_inter, measure_empty]
    exact ENNReal.ofReal_pos.2 hθ
  have hk : k0 ≤ k := not_lt.1 hk
  obtain ⟨i', hi'S, hi'⟩ := hS' (k - k0)
  refine ⟨k0 + i', Finset.mem_union_right _ (Finset.mem_image_of_mem _ hi'S), ?_⟩
  have hkk : k0 + (k - k0) = k := Nat.add_sub_cancel' hk
  simp only [hkk] at hi'
  have hi : k0 ≤ k0 + i' := Nat.le_add_right _ _
  set i := k0 + i' with hidef
  -- Step 6: `|u k - u i| ≤ |u k - v k| + |v k - v i| + |u i - v i|`, integrated over `B_R`
  have htri : ∀ z, |u k z - u i z| ≤ |u k z - v k z| + |v k z - v i z| + |u i z - v i z| := by
    intro z
    calc |u k z - u i z| = |(u k z - v k z) + (v k z - v i z) - (u i z - v i z)| := by
          congr 1; ring
      _ ≤ |(u k z - v k z) + (v k z - v i z)| + |u i z - v i z| := abs_sub _ _
      _ ≤ |u k z - v k z| + |v k z - v i z| + |u i z - v i z| := by
          gcongr; exact abs_add_le _ _
  have hm1 : Measurable fun z => |u k z - v k z| :=
    continuous_abs.measurable.comp ((hu_meas k).sub (hv_cont k).measurable)
  have hm2 : Measurable fun z => |v k z - v i z| :=
    continuous_abs.measurable.comp ((hv_cont k).measurable.sub (hv_cont i).measurable)
  have hm3 : Measurable fun z => |u i z - v i z| :=
    continuous_abs.measurable.comp ((hu_meas i).sub (hv_cont i).measurable)
  have hb : ∀ a b : ℝ, |a| ≤ 1 → |b| ≤ L → |(|a - b|)| ≤ 1 + L := by
    intro a b ha hb
    rw [abs_abs]
    exact (abs_sub _ _).trans (add_le_add ha hb)
  have hI1 := hint _ hm1 (1 + L) fun z => hb _ _ (hu_bd k z) (hv_bd k z)
  have hI2 := hint _ hm2 (L + L) fun z => by
    rw [abs_abs]
    exact (abs_sub _ _).trans (add_le_add (hv_bd k z) (hv_bd i z))
  have hI3 := hint _ hm3 (1 + L) fun z => hb _ _ (hu_bd i z) (hv_bd i z)
  have h2 : ∫ z in ball (0 : Euclid (m + 1)) R, |v k z - v i z| ≤ δ * V := by
    calc ∫ z in ball (0 : Euclid (m + 1)) R, |v k z - v i z|
        ≤ ∫ z in ball (0 : Euclid (m + 1)) R, δ :=
          setIntegral_mono_on hI2 (integrableOn_const hfin) measurableSet_ball
            fun z hz => hi' z (ball_subset_closedBall hz)
      _ = δ * V := by rw [setIntegral_const, smul_eq_mul, mul_comm]; rfl
  have key : ∫ z in ball (0 : Euclid (m + 1)) R, |u k z - u i z| < θ := by
    have hI12 : IntegrableOn (fun z => |u k z - v k z| + |v k z - v i z|)
        (ball (0 : Euclid (m + 1)) R) := hI1.add hI2
    calc ∫ z in ball (0 : Euclid (m + 1)) R, |u k z - u i z|
        ≤ ∫ z in ball (0 : Euclid (m + 1)) R,
            (|u k z - v k z| + |v k z - v i z| + |u i z - v i z|) :=
          integral_mono_of_nonneg (Filter.Eventually.of_forall fun z => abs_nonneg _)
            (hI12.add hI3) (Filter.Eventually.of_forall htri)
      _ = (∫ z in ball (0 : Euclid (m + 1)) R, |u k z - v k z|) +
            (∫ z in ball (0 : Euclid (m + 1)) R, |v k z - v i z|) +
            ∫ z in ball (0 : Euclid (m + 1)) R, |u i z - v i z| := by
          rw [integral_add hI12 hI3, integral_add hI1 hI2]
      _ ≤ ε * C + δ * V + ε * C := by
          gcongr
          · exact hmoll k hk
          · exact hmoll i hi
      _ < θ := by linarith
  -- Step 7: `|u k - u i| = 1_{F_k Δ F_i}`, so the integral is `L((F_k Δ F_i) ∩ B_R)`
  have hsd : ∀ z, |u k z - u i z| = (symmDiff (Fs k) (Fs i)).indicator (fun _ => (1 : ℝ)) z := by
    intro z
    simp only [hu, Set.indicator, Set.mem_symmDiff]
    by_cases h1 : z ∈ Fs k <;> by_cases h2 : z ∈ Fs i <;> simp [h1, h2, Set.mem_symmDiff]
  have hA : MeasurableSet (symmDiff (Fs k) (Fs i)) := (hmeas k).symmDiff (hmeas i)
  have hmeas_eq : volume (symmDiff (Fs k) (Fs i) ∩ ball (0 : Euclid (m + 1)) R)
      = ENNReal.ofReal (∫ z in ball (0 : Euclid (m + 1)) R, |u k z - u i z|) := by
    simp_rw [hsd]
    rw [integral_indicator hA, setIntegral_const, smul_eq_mul, mul_one, Measure.real,
      Measure.restrict_apply hA, ENNReal.ofReal_toReal]
    exact (measure_mono Set.inter_subset_right |>.trans_lt measure_ball_lt_top).ne
  rw [hmeas_eq]
  exact (ENNReal.ofReal_lt_ofReal_iff hθ).2 key
/-- **Infinite pairwise close subsets** (the pigeonhole step behind "every sequence in a totally
bounded subset has a Cauchy subsequence" in the BV compactness theorem, Simon Ch. 2, 2.6, applied
to the indicators `1_{F_k}` in `L¹(B_R)`).  Suppose that for all `R, θ > 0` there is a finite set
`S` such that every `F_k` has some `i ∈ S` with `L((F_k Δ F_i) ∩ B_R) < θ`.  Then every infinite
`I ⊆ ℕ` contains an infinite `J ⊆ I` with `L((F_j Δ F_l) ∩ B_{r+1}) ≤ 2^{-r}` for all `j, l ∈ J`.
Take `R = r + 1`, `θ = 2^{-(r+1)}` and a centre map `c : ℕ → S`; then some fibre
`J = I ∩ c⁻¹{s}` is infinite, and `F_j Δ F_l ⊆ (F_j Δ F_s) ∪ (F_l Δ F_s)` gives
`2^{-(r+1)} + 2^{-(r+1)} = 2^{-r}`. -/
theorem Submission.codim1_rdo_dg_bvc_infinite_close_subset : ∀ (n : ℕ) (Fs : ℕ → Set (Euclid n)), (∀ R : ℝ, 0 < R → ∀ θ : ℝ, 0 < θ → ∃ S : Finset ℕ, ∀ k, ∃ i ∈ S, volume (symmDiff (Fs k) (Fs i) ∩ ball (0 : Euclid n) R) < ENNReal.ofReal θ) → ∀ (r : ℕ) (I : Set ℕ), I.Infinite → ∃ J ⊆ I, J.Infinite ∧ ∀ j ∈ J, ∀ l ∈ J, volume (symmDiff (Fs j) (Fs l) ∩ ball (0 : Euclid n) ((r : ℝ) + 1)) ≤ (2⁻¹ : ℝ≥0∞) ^ r := by
  intro n Fs hTB r I hI
  -- Step 1: radius `r + 1` and accuracy `2^{-(r+1)}` give `S` and a centre map `c : ℕ → S`
  obtain ⟨S, hS⟩ := hTB ((r : ℝ) + 1) (by positivity) ((1 / 2 : ℝ) ^ (r + 1)) (by positivity)
  choose c hcS hc using hS
  have hθ : ENNReal.ofReal ((1 / 2 : ℝ) ^ (r + 1)) = (2⁻¹ : ℝ≥0∞) ^ (r + 1) := by
    rw [ENNReal.ofReal_pow (by norm_num), one_div, ENNReal.ofReal_inv_of_pos (by norm_num),
      ENNReal.ofReal_ofNat]
  -- Step 2: `I ⊆ ⋃_{s ∈ S} (I ∩ c⁻¹{s})`, so some fibre `I ∩ c⁻¹{s}` is infinite
  obtain ⟨s, -, hJ⟩ : ∃ s ∈ S, (I ∩ c ⁻¹' {s}).Infinite := by
    by_contra! h
    exact hI ((S.finite_toSet.biUnion fun s hs => h s hs).subset
      fun k hk => mem_biUnion (hcS k) ⟨hk, rfl⟩)
  refine ⟨I ∩ c ⁻¹' {s}, inter_subset_left, hJ, fun j hj l hl => ?_⟩
  -- Step 3: `F_j Δ F_l ⊆ (F_j Δ F_s) ∪ (F_l Δ F_s)`, monotonicity and subadditivity
  set B := ball (0 : Euclid n) ((r : ℝ) + 1)
  have hjs : volume (symmDiff (Fs j) (Fs s) ∩ B) ≤ (2⁻¹ : ℝ≥0∞) ^ (r + 1) := by
    rw [← hθ, ← (hj.2 : c j = s)]
    exact (hc j).le
  have hls : volume (symmDiff (Fs l) (Fs s) ∩ B) ≤ (2⁻¹ : ℝ≥0∞) ^ (r + 1) := by
    rw [← hθ, ← (hl.2 : c l = s)]
    exact (hc l).le
  have htri : symmDiff (Fs j) (Fs l) ∩ B ⊆
      (symmDiff (Fs j) (Fs s) ∩ B) ∪ (symmDiff (Fs l) (Fs s) ∩ B) := by
    rintro x ⟨hx, hxB⟩
    rcases symmDiff_triangle (Fs j) (Fs s) (Fs l) hx with h | h
    · exact Or.inl ⟨h, hxB⟩
    · exact Or.inr ⟨by rwa [symmDiff_comm] at h, hxB⟩
  calc volume (symmDiff (Fs j) (Fs l) ∩ B)
      ≤ volume (symmDiff (Fs j) (Fs s) ∩ B) + volume (symmDiff (Fs l) (Fs s) ∩ B) :=
        (measure_mono htri).trans (measure_union_le _ _)
    _ ≤ (2⁻¹ : ℝ≥0∞) ^ (r + 1) + (2⁻¹ : ℝ≥0∞) ^ (r + 1) := add_le_add hjs hls
    _ = (2⁻¹ : ℝ≥0∞) ^ r := by rw [pow_succ, ← div_eq_mul_inv, ENNReal.add_halves]
/-- **Limit of a fast-Cauchy sequence of sets** (the completeness step of the BV compactness
argument in the De Giorgi proof, cf. Simon Ch. 2, 2.6; the Riesz–Fischer argument specialized to
indicators).  If the Borel sets `Gⱼ ⊆ ℝⁿ` satisfy `L((G_{i+1} Δ Gᵢ) ∩ B_{i+1}(0)) ≤ 2⁻ⁱ` for
every `i`, then the liminf `F₀ = ⋃_J ⋂_i G_{J+i}` is Borel and `L((Gⱼ Δ F₀) ∩ B_R(0)) → 0` for
every `R`: `Gⱼ Δ F₀ ⊆ ⋃_l (G_{j+l+1} Δ G_{j+l})`, and for `j ≥ ⌈R⌉₊` every ball `B_{j+l+1}(0)`
contains `B_R(0)`, so the measure is at most `∑_l 2^{-(j+l)} = 2 · 2⁻ʲ → 0`. -/
theorem Submission.codim1_rdo_dg_bvc_limit_of_fast_cauchy : ∀ (n : ℕ) (Gs : ℕ → Set (Euclid n)), (∀ j, MeasurableSet (Gs j)) → (∀ i : ℕ, volume (symmDiff (Gs (i + 1)) (Gs i) ∩ ball (0 : Euclid n) ((i : ℝ) + 1)) ≤ (2⁻¹ : ℝ≥0∞) ^ i) → ∃ F₀ : Set (Euclid n), MeasurableSet F₀ ∧ ∀ R : ℝ, Tendsto (fun j => volume (symmDiff (Gs j) F₀ ∩ ball (0 : Euclid n) R)) atTop (𝓝 0) := by
  intro n Gs hGm hG
  -- Step 1: the liminf `F₀ = ⋃_J ⋂_i G_{J+i}` is Borel
  set F₀ : Set (Euclid n) := ⋃ J : ℕ, ⋂ i : ℕ, Gs (J + i) with hF₀
  refine ⟨F₀, MeasurableSet.iUnion fun J => MeasurableSet.iInter fun i => hGm _, fun R => ?_⟩
  -- Step 2: `Gⱼ Δ F₀ ⊆ ⋃_l (G_{j+l+1} Δ G_{j+l})`
  have hincl : ∀ j, symmDiff (Gs j) F₀ ⊆ ⋃ l : ℕ, symmDiff (Gs (j + l + 1)) (Gs (j + l)) := by
    intro j x hx
    by_contra hxU
    simp only [mem_iUnion, not_exists] at hxU
    -- `x` is in no `G_{j+l+1} Δ G_{j+l}`, so by induction `x ∈ G_{j+l} ↔ x ∈ Gⱼ` for every `l`
    have hstep : ∀ l, (x ∈ Gs (j + l + 1) ↔ x ∈ Gs (j + l)) := by
      intro l
      have hl := hxU l
      rw [Set.mem_symmDiff] at hl
      tauto
    have hall : ∀ l, (x ∈ Gs (j + l) ↔ x ∈ Gs j) := by
      intro l
      induction l with
      | zero => simp
      | succ l ih => rw [← ih, ← add_assoc]; exact hstep l
    -- hence `x ∈ F₀ ↔ x ∈ Gⱼ`, contradicting `x ∈ Gⱼ Δ F₀`
    have hF : x ∈ F₀ ↔ x ∈ Gs j := by
      constructor
      · intro hx0
        rw [hF₀, mem_iUnion] at hx0
        obtain ⟨J, hJ⟩ := hx0
        have hJj := mem_iInter.1 hJ j
        rw [Nat.add_comm] at hJj
        exact (hall J).1 hJj
      · intro hxj
        rw [hF₀, mem_iUnion]
        exact ⟨j, mem_iInter.2 fun i => (hall i).2 hxj⟩
    rw [Set.mem_symmDiff] at hx
    tauto
  -- Step 3: for `j ≥ N = ⌈R⌉₊` and every `l`, `B_R(0) ⊆ B_{j+l+1}(0)`, so by countable
  -- subadditivity the measure is at most `∑_l 2^{-(j+l)} = 2⁻ʲ · ∑_l 2⁻ˡ = 2 · 2⁻ʲ`
  set N : ℕ := ⌈R⌉₊
  have hbound : ∀ j, N ≤ j →
      volume (symmDiff (Gs j) F₀ ∩ ball (0 : Euclid n) R) ≤ 2 * (2⁻¹ : ℝ≥0∞) ^ j := by
    intro j hj
    calc volume (symmDiff (Gs j) F₀ ∩ ball (0 : Euclid n) R)
        ≤ volume (⋃ l : ℕ, symmDiff (Gs (j + l + 1)) (Gs (j + l)) ∩
            ball (0 : Euclid n) (((j + l : ℕ) : ℝ) + 1)) := by
          refine measure_mono ?_
          rintro x ⟨hx, hxR⟩
          obtain ⟨l, hl⟩ := mem_iUnion.1 (hincl j hx)
          refine mem_iUnion.2 ⟨l, hl, ball_subset_ball ?_ hxR⟩
          have h1 : R ≤ (N : ℝ) := Nat.le_ceil R
          have h2 : (N : ℝ) ≤ ((j + l : ℕ) : ℝ) := by
            exact_mod_cast hj.trans (Nat.le_add_right j l)
          linarith
      _ ≤ ∑' l : ℕ, volume (symmDiff (Gs (j + l + 1)) (Gs (j + l)) ∩
            ball (0 : Euclid n) (((j + l : ℕ) : ℝ) + 1)) := measure_iUnion_le _
      _ ≤ ∑' l : ℕ, (2⁻¹ : ℝ≥0∞) ^ (j + l) := ENNReal.tsum_le_tsum fun l => hG (j + l)
      _ = (2⁻¹ : ℝ≥0∞) ^ j * ∑' l : ℕ, (2⁻¹ : ℝ≥0∞) ^ l := by
          rw [← ENNReal.tsum_mul_left]
          simp_rw [pow_add]
      _ = 2 * (2⁻¹ : ℝ≥0∞) ^ j := by
          rw [ENNReal.tsum_geometric, ENNReal.one_sub_inv_two, inv_inv, mul_comm]
  -- Step 4: `2 · 2⁻ʲ → 0`, and the measures are squeezed between `0` and this bound for `j ≥ N`
  have hlim : Tendsto (fun j : ℕ => 2 * (2⁻¹ : ℝ≥0∞) ^ j) atTop (𝓝 0) := by
    have h := ENNReal.Tendsto.const_mul
      (ENNReal.tendsto_pow_atTop_nhds_zero_of_lt_one (ENNReal.inv_lt_one.2 ENNReal.one_lt_two))
      (Or.inr (ENNReal.ofNat_ne_top : (2 : ℝ≥0∞) ≠ ∞))
    simpa using h
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hlim
    (Eventually.of_forall fun _ => zero_le) (eventually_atTop.2 ⟨N, hbound⟩)

/-- **Compactness for sets of locally bounded perimeter** (Simon Ch. 2, 2.6, chapter-02.txt
lines 598–626, for `u_k = 1_{F_k}` on `U = ℝ^{m+1}`; the precompactness that the book cites from
[GT01, Theorem 7.22] is proved by mollification and Arzelà–Ascoli).  If for every `R > 0` there is
`C_R` with `∫_{F_k} div g ≤ C_R` for all large `k` and every `C¹` field `g` with `|g| ≤ 1` and
compact support in `B_R(0)`, then a subsequence `F_{ψ j}` converges locally in measure to a Borel
set `F₀`.  The indicators `1_{F_k}` are totally bounded in `L¹(B_R)` for every `R`; so every
infinite index set contains an infinite one whose members are pairwise `2^{-r}`-close on
`B_{r+1}`; the diagonal subsequence is `2^{-r}`-fast Cauchy on `B_{r+1}`, hence converges. -/
theorem Submission.codim1_rdo_dg_bv_set_compactness : ∀ (m : ℕ) (Fs : ℕ → Set (Euclid (m + 1))), (∀ k, MeasurableSet (Fs k)) → (∀ R : ℝ, 0 < R → ∃ C : ℝ, ∀ᶠ k in atTop, ∀ g : Euclid (m + 1) → Euclid (m + 1), ContDiff ℝ 1 g → HasCompactSupport g → tsupport g ⊆ ball (0 : Euclid (m + 1)) R → (∀ z, ‖g z‖ ≤ 1) → ∫ z in Fs k, LinearMap.trace ℝ (Euclid (m + 1)) (fderiv ℝ g z : Euclid (m + 1) →ₗ[ℝ] Euclid (m + 1)) ≤ C) → ∃ (ψ : ℕ → ℕ) (F₀ : Set (Euclid (m + 1))), StrictMono ψ ∧ MeasurableSet F₀ ∧ ∀ R : ℝ, Tendsto (fun j => volume (symmDiff (Fs (ψ j)) F₀ ∩ ball (0 : Euclid (m + 1)) R)) atTop (𝓝 0) := by
  intro m Fs hmeas hdiv
  -- Steps 1–3: for every `R, θ > 0`, finitely many `F_i` are `θ`-close in measure on `B_R` to
  -- every `F_k` (mollification estimate and finite sup-norm nets of the mollified indicators)
  have hTB := Submission.codim1_rdo_dg_bvc_indicator_totally_bounded m Fs hmeas hdiv
  -- Step 4: every infinite `I ⊆ ℕ` contains an infinite `J` whose members are pairwise
  -- `2^{-r}`-close on `B_{r+1}`
  have hJ := Submission.codim1_rdo_dg_bvc_infinite_close_subset (m + 1) Fs hTB
  -- Step 4: diagonal extraction of a strictly increasing `ψ` with `F_{ψ(r+1)}` and `F_{ψ r}`
  -- `2^{-r}`-close on `B_{r+1}`
  obtain ⟨ψ, hψ, hclose⟩ := Submission.cmc_fc_cs_diagonal_subseq
    (fun r j l => volume (symmDiff (Fs j) (Fs l) ∩ ball (0 : Euclid (m + 1)) ((r : ℝ) + 1)) ≤
      (2⁻¹ : ℝ≥0∞) ^ r) hJ
  -- Step 5: the fast Cauchy subsequence converges locally in measure to a Borel `F₀`
  obtain ⟨F₀, hF₀, hconv⟩ := Submission.codim1_rdo_dg_bvc_limit_of_fast_cauchy (m + 1)
    (fun j => Fs (ψ j)) (fun j => hmeas (ψ j)) hclose
  exact ⟨ψ, F₀, hψ, hF₀, hconv⟩
/-- **Simon Ch. 3, 4.3 (8)–(9)** (translation identity): for a Borel set `F ⊆ ℝⁿ`,
`ζ ∈ C¹_c(ℝⁿ)`, `w ∈ ℝⁿ` and `t ∈ ℝ`,
`∫_F ζ(z − t w) dz = ∫_F ζ(z) dz − ∫₀ᵗ ∫_F Dζ(z − s w)(w) dz ds` (oriented `∫₀ᵗ`).  Integrate
the fundamental theorem of calculus for `s ↦ ζ(z − s w)` over `z ∈ F` and swap the integrals
(Fubini); `Dζ(z − s w)(w)` is bounded and, for `s` between `0` and `t`, vanishes for `z` off the
compact set `tsupport ζ + [0, t] w`. -/
theorem Submission.codim1_rdo_dg_hr_translate_integral_eq : ∀ (n : ℕ) (F : Set (EuclideanSpace ℝ (Fin n))) (ζ : EuclideanSpace ℝ (Fin n) → ℝ) (w : EuclideanSpace ℝ (Fin n)) (t : ℝ), MeasurableSet F → ContDiff ℝ 1 ζ → HasCompactSupport ζ → ∫ z in F, ζ (z - t • w) = (∫ z in F, ζ z) - ∫ s in (0 : ℝ)..t, ∫ z in F, fderiv ℝ ζ (z - s • w) w := by
  intro n F ζ w t hF hζ hcs
  -- `Dζ` is continuous and bounded by `M`
  have hDc : Continuous (fderiv ℝ ζ) := hζ.continuous_fderiv one_ne_zero
  obtain ⟨M, hM⟩ := hDc.bounded_above_of_compact_support (hcs.fderiv ℝ)
  -- `G (s, z) = Dζ (z - s • w) w` is continuous
  have hGc : Continuous (uncurry fun (s : ℝ) (z : EuclideanSpace ℝ (Fin n)) =>
      fderiv ℝ ζ (z - s • w) w) :=
    (hDc.comp (continuous_snd.sub (continuous_fst.smul continuous_const))).clm_apply
      continuous_const
  -- for `s ∈ uIcc 0 t`, `Dζ (z - s • w) = 0` off the compact `K' = tsupport ζ + uIcc 0 t • w`
  obtain ⟨K', hK', hvan⟩ : ∃ K' : Set (EuclideanSpace ℝ (Fin n)), IsCompact K' ∧
      ∀ s ∈ uIcc (0 : ℝ) t, ∀ z ∉ K', fderiv ℝ ζ (z - s • w) = 0 := by
    refine ⟨(fun p : EuclideanSpace ℝ (Fin n) × ℝ => p.1 + p.2 • w) '' (tsupport ζ ×ˢ uIcc 0 t),
      (hcs.isCompact.prod isCompact_uIcc).image
        (continuous_fst.add (continuous_snd.smul continuous_const)), fun s hs z hz => ?_⟩
    by_contra h
    exact hz ⟨(z - s • w, s), ⟨support_fderiv_subset ℝ h, hs⟩, sub_add_cancel z (s • w)⟩
  -- FTC along `s ↦ ζ (z - s • w)`, whose derivative is `-G (s, z)`
  have hFTC : ∀ z, ζ (z - t • w) - ζ z = -∫ s in (0 : ℝ)..t, fderiv ℝ ζ (z - s • w) w := by
    intro z
    have hderiv : ∀ s ∈ uIcc (0 : ℝ) t,
        HasDerivAt (fun s => ζ (z - s • w)) (-fderiv ℝ ζ (z - s • w) w) s := by
      intro s _
      have h1 : HasDerivAt (fun s : ℝ => z - s • w) (-w) s := by
        simpa using ((hasDerivAt_id s).smul_const w).const_sub z
      have h2 := ((hζ.differentiable one_ne_zero) (z - s • w)).hasFDerivAt.comp_hasDerivAt s h1
      rw [map_neg] at h2
      exact h2
    have hint : IntervalIntegrable (fun s => -fderiv ℝ ζ (z - s • w) w) volume 0 t :=
      ((hDc.comp (continuous_const.sub (continuous_id.smul continuous_const))).clm_apply
        continuous_const).neg.intervalIntegrable _ _
    rw [← intervalIntegral.integral_neg,
      intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv hint]
    simp
  -- `G` is integrable for `(volume|uIoc 0 t) ⊗ (volume|F)`: a.e. `|G (s, z)| ≤ M ‖w‖ 1_{K'}(z)`
  have hint : Integrable (uncurry fun (s : ℝ) (z : EuclideanSpace ℝ (Fin n)) =>
      fderiv ℝ ζ (z - s • w) w) ((volume.restrict (uIoc 0 t)).prod (volume.restrict F)) := by
    have hbound : Integrable (fun p : ℝ × EuclideanSpace ℝ (Fin n) =>
        (1 : ℝ) * K'.indicator (fun _ => M * ‖w‖) p.2)
        ((volume.restrict (uIoc 0 t)).prod (volume.restrict F)) :=
      Integrable.mul_prod (f := fun _ : ℝ => (1 : ℝ)) (g := K'.indicator fun _ => M * ‖w‖)
        (integrableOn_const (s := uIoc 0 t) measure_Ioc_lt_top.ne enorm_ne_top).integrable
        ((integrable_indicator_iff hK'.measurableSet).2
          (integrableOn_const hK'.measure_lt_top.ne enorm_ne_top))
    have hfst : ∀ᵐ p ∂((volume.restrict (uIoc (0 : ℝ) t)).prod (volume.restrict F)),
        p.1 ∈ uIoc (0 : ℝ) t :=
      Measure.quasiMeasurePreserving_fst.ae (ae_restrict_mem measurableSet_uIoc)
    refine hbound.mono' hGc.aestronglyMeasurable ?_
    filter_upwards [hfst] with ⟨s, z⟩ hs
    simp only [uncurry_apply_pair, one_mul]
    by_cases hz : z ∈ K'
    · rw [indicator_of_mem hz]
      exact (ContinuousLinearMap.le_opNorm _ _).trans
        (mul_le_mul_of_nonneg_right (hM _) (norm_nonneg _))
    · rw [indicator_of_notMem hz, hvan s (uIoc_subset_uIcc hs) z hz]
      simp
  -- `ζ (· - t • w)` and `ζ` are continuous with compact support, hence integrable
  have hi2 : Integrable ζ := hζ.continuous.integrable_of_hasCompactSupport hcs
  have hi1 : Integrable (fun z => ζ (z - t • w)) :=
    (hζ.continuous.comp (continuous_id.sub continuous_const)).integrable_of_hasCompactSupport
      (hcs.comp_homeomorph (Homeomorph.subRight (t • w)))
  -- integrate the FTC identity over `F` and swap the order of integration
  have hswap : ∫ s in (0 : ℝ)..t, ∫ z in F, fderiv ℝ ζ (z - s • w) w =
      ∫ z in F, ∫ s in (0 : ℝ)..t, fderiv ℝ ζ (z - s • w) w :=
    intervalIntegral_integral_swap hint
  have hsplit : ∫ z in F, (ζ (z - t • w) - ζ z) =
      -∫ z in F, ∫ s in (0 : ℝ)..t, fderiv ℝ ζ (z - s • w) w := by
    rw [← integral_neg]
    exact integral_congr_ae (ae_of_all _ hFTC)
  rw [integral_sub hi1.integrableOn hi2.integrableOn] at hsplit
  rw [hswap]
  linarith
/-- **Sign version of the fundamental lemma**: if `f` is locally integrable on `ℝⁿ` and
`∫ g f ≥ 0` for every nonnegative `C¹` function `g` with compact support, then `f ≥ 0` a.e.
For compact `K`, smooth Urysohn functions `gⱼ` (`0 ≤ gⱼ ≤ 1`, `gⱼ = 1` on `K`,
`support gⱼ = K_{uⱼ}`, `uⱼ ↓ 0`) are admissible tests with `gⱼ → 1_K` pointwise and
`|gⱼ f| ≤ 1_{K¹}|f|`, so dominated convergence gives `∫_K f ≥ 0`.  If `{f < 0}` had positive
measure, inner regularity would give a compact `K ⊆ {f < 0}` of positive measure, on which
`∫_K f < 0`. -/
theorem Submission.codim1_rdo_dg_hr_ae_nonneg_of_test_nonneg : ∀ (n : ℕ) (f : EuclideanSpace ℝ (Fin n) → ℝ), LocallyIntegrable f volume → (∀ g : EuclideanSpace ℝ (Fin n) → ℝ, ContDiff ℝ 1 g → HasCompactSupport g → (∀ x, 0 ≤ g x) → 0 ≤ ∫ x, g x * f x) → ∀ᵐ x ∂volume, 0 ≤ f x := by
  intro n f hf htest
  -- Steps 1–3: `0 ≤ ∫_K f` for every compact `K`
  have hcpt : ∀ K : Set (EuclideanSpace ℝ (Fin n)), IsCompact K → 0 ≤ ∫ x in K, f x := by
    intro K hK
    have hK1 : IsCompact (cthickening 1 K) := hK.cthickening
    -- radii `u j ∈ (0, 1)` with `u j → 0`
    obtain ⟨u, -, u_pos, u_lim⟩ : ∃ u : ℕ → ℝ, StrictAnti u ∧ (∀ j, u j ∈ Ioo 0 1) ∧
        Tendsto u atTop (𝓝 0) := exists_seq_strictAnti_tendsto' zero_lt_one
    have vK : ∀ j, thickening (u j) K ⊆ cthickening 1 K :=
      fun j => thickening_subset_cthickening_of_le (u_pos j).2.le K
    -- smooth Urysohn functions `g j` with `support (g j) = K_{u j}` and `g j = 1` on `K`
    have : ∀ j, ∃ g : EuclideanSpace ℝ (Fin n) → ℝ, ContDiff ℝ 1 g ∧ range g ⊆ Icc 0 1 ∧
        support g = thickening (u j) K ∧ ∀ x ∈ K, g x = 1 := by
      intro j
      obtain ⟨g, hg, hgr, hgs, hg1⟩ := exists_contDiff_support_eq_eq_one_iff (n := 1)
        isOpen_thickening hK.isClosed (self_subset_thickening (u_pos j).1 K)
      exact ⟨g, hg, hgr, hgs, fun x hx => (hg1 x).1 hx⟩
    choose g g_diff g_range g_supp hg1 using this
    have hnn : ∀ j, 0 ≤ ∫ x, g j x * f x := by
      intro j
      refine htest _ (g_diff j) ?_ (fun x => (g_range j (mem_range_self x)).1)
      apply HasCompactSupport.of_support_subset_isCompact hK1
      rw [g_supp]
      exact vK j
    -- dominated convergence: `∫ g j * f → ∫_K f`
    have L : Tendsto (fun j => ∫ x, g j x * f x) atTop (𝓝 (∫ x in K, f x)) := by
      rw [← integral_indicator hK.measurableSet]
      let bound : EuclideanSpace ℝ (Fin n) → ℝ := (cthickening 1 K).indicator fun x => ‖f x‖
      have A : ∀ j, AEStronglyMeasurable (fun x => g j x * f x) volume :=
        fun j => (g_diff j).continuous.aestronglyMeasurable.mul hf.aestronglyMeasurable
      have B : Integrable bound volume := by
        rw [integrable_indicator_iff hK1.measurableSet]
        exact (hf.integrableOn_isCompact hK1).norm
      have C : ∀ j, ∀ᵐ x ∂volume, ‖g j x * f x‖ ≤ bound x := by
        intro j
        filter_upwards with x
        rw [norm_mul]
        refine le_indicator_apply (fun _ => ?_) (fun hxK => ?_)
        · have h01 := g_range j (mem_range_self (f := g j) x)
          have : ‖g j x‖ ≤ 1 := by
            rw [Real.norm_of_nonneg h01.1]
            exact h01.2
          exact mul_le_of_le_one_left (norm_nonneg _) this
        · have : g j x = 0 := by
            rw [← notMem_support, g_supp]
            contrapose hxK
            exact vK j hxK
          simp [this]
      have D : ∀ᵐ x ∂volume, Tendsto (fun j => g j x * f x) atTop (𝓝 (K.indicator f x)) := by
        filter_upwards with x
        by_cases hxK : x ∈ K
        · have : ∀ j, g j x = 1 := fun j => hg1 j x hxK
          simp [this, indicator_of_mem hxK f]
        · simp_rw [indicator_of_notMem hxK f]
          apply tendsto_const_nhds.congr'
          suffices H : ∀ᶠ j in atTop, g j x = 0 by
            filter_upwards [H] with j hj using by simp [hj]
          obtain ⟨ε, εpos, hε⟩ : ∃ ε, 0 < ε ∧ x ∉ thickening ε K := by
            rw [← hK.isClosed.closure_eq, closure_eq_iInter_thickening K] at hxK
            simpa using hxK
          filter_upwards [(tendsto_order.1 u_lim).2 _ εpos] with j hj
          rw [← notMem_support, g_supp]
          contrapose hε
          exact thickening_mono hj.le K hε
      exact tendsto_integral_of_dominated_convergence bound A B C D
    exact ge_of_tendsto' L hnn
  -- Steps 4–6: `{f < 0}` is null; take a measurable `T ⊆ {f < 0}` with `T =ᵐ {f < 0}`
  rw [ae_iff]
  simp only [not_le]
  by_contra hS
  obtain ⟨T, hTS, hTm, hTeq⟩ := (nullMeasurableSet_lt hf.aestronglyMeasurable.aemeasurable
    aemeasurable_const : NullMeasurableSet {x | f x < 0} volume).exists_measurable_subset_ae_eq
  have hTpos : 0 < volume T := by
    rw [measure_congr hTeq]
    exact pos_iff_ne_zero.2 hS
  -- inner regularity: a compact `K ⊆ T` of positive measure
  obtain ⟨K, hKT, hKc, hKpos⟩ := hTm.exists_lt_isCompact hTpos
  -- `∫_K f < 0` since `f < 0` on `K`
  have hneg : 0 < ∫ x in K, -f x := by
    have hfK : IntegrableOn f K volume := hf.integrableOn_isCompact hKc
    rw [setIntegral_pos_iff_support_of_nonneg_ae (f := fun x => -f x) _ hfK.neg]
    · have : support (fun x => -f x) ∩ K = K := by
        refine inter_eq_right.2 fun x hx => ?_
        have : f x < 0 := hTS (hKT hx)
        rw [mem_support]
        linarith
      rwa [this]
    · exact ae_restrict_of_forall_mem hKc.measurableSet fun x hx => by
        have : f x < 0 := hTS (hKT hx)
        simp only [Pi.zero_apply]
        linarith
  rw [integral_neg] at hneg
  linarith [hcpt K hKc]

/-- **Tangential invariance** (step 2 of the half-space rigidity behind Simon Ch. 3, 4.3: "it
follows that `F = ℝⁿ × H`").  If the Borel set `F ⊆ ℝⁿ` has `∫_F Dζ(z)(w) dz = 0` for every
compactly supported `C¹` function `ζ`, then `z + w ∈ F ↔ z ∈ F` for a.e. `z`.  The translation
identity with `t = 1` gives `∫_F ζ(z − w) dz = ∫_F ζ`, since every translate `ζ(· − s w)` is
again admissible; substituting `z = y + w` turns this into `∫ ζ 1_F(· + w) = ∫ ζ 1_F`, and the
fundamental lemma of the calculus of variations gives `1_F(· + w) = 1_F` a.e. -/
theorem Submission.codim1_rdo_dg_hr_ae_translate_invariant : ∀ (n : ℕ) (F : Set (EuclideanSpace ℝ (Fin n))) (w : EuclideanSpace ℝ (Fin n)), MeasurableSet F → (∀ ζ : EuclideanSpace ℝ (Fin n) → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ → ∫ z in F, fderiv ℝ ζ z w = 0) → ∀ᵐ z ∂volume, (z + w ∈ F ↔ z ∈ F) := by
  intro n F w hF hζ
  -- `ζ(· − s w)` is again admissible, with derivative `Dζ(· − s w)`: the inner integrals vanish
  have hinner : ∀ ζ : EuclideanSpace ℝ (Fin n) → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ →
      ∀ s : ℝ, ∫ z in F, fderiv ℝ ζ (z - s • w) w = 0 := by
    intro ζ hζc hζs s
    have h := hζ (fun y => ζ (y - s • w)) (hζc.comp (contDiff_id.sub contDiff_const))
      (hζs.comp_homeomorph (Homeomorph.subRight (s • w)))
    simpa only [fderiv_comp_sub] using h
  -- the translation identity with `t = 1`
  have htrans : ∀ ζ : EuclideanSpace ℝ (Fin n) → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ →
      ∫ z in F, ζ (z - w) = ∫ z in F, ζ z := by
    intro ζ hζc hζs
    have h := Submission.codim1_rdo_dg_hr_translate_integral_eq n F ζ w 1 hF hζc hζs
    simpa only [one_smul, hinner ζ hζc hζs, intervalIntegral.integral_zero, sub_zero] using h
  -- substituting `z = y + w`: `∫ ζ 1_F(· + w) = ∫ ζ 1_F`
  have hG : MeasurableSet ((fun y => y + w) ⁻¹' F) := hF.preimage (measurable_add_const w)
  have hint : ∀ g : EuclideanSpace ℝ (Fin n) → ℝ, ContDiff ℝ 1 g → HasCompactSupport g →
      ∫ y, g y • ((fun y => y + w) ⁻¹' F).indicator (fun _ => (1 : ℝ)) y
        = ∫ y, g y • F.indicator (fun _ => (1 : ℝ)) y := by
    intro g hgc hgs
    have e1 : (fun y => g y • ((fun y => y + w) ⁻¹' F).indicator (fun _ => (1 : ℝ)) y)
        = fun y => F.indicator (fun z => g (z - w)) (y + w) := by
      funext y
      by_cases hy : y + w ∈ F <;> simp [hy]
    have e2 : (fun y => g y • F.indicator (fun _ => (1 : ℝ)) y) = F.indicator g := by
      funext y
      by_cases hy : y ∈ F <;> simp [hy]
    rw [e1, e2, integral_add_right_eq_self (F.indicator fun z => g (z - w)) w,
      integral_indicator hF, integral_indicator hF]
    exact htrans g hgc hgs
  -- the fundamental lemma: `1_F(· + w) = 1_F` a.e.
  have hae : ∀ᵐ y ∂volume, ((fun y => y + w) ⁻¹' F).indicator (fun _ => (1 : ℝ)) y
      = F.indicator (fun _ => (1 : ℝ)) y :=
    ae_eq_of_integral_contDiff_smul_eq ((locallyIntegrable_const 1).indicator hG)
      ((locallyIntegrable_const 1).indicator hF)
      (fun g hgc hgs => hint g (hgc.of_le (by simp)) hgs)
  -- equal indicators: `z + w ∈ F ↔ z ∈ F`
  filter_upwards [hae] with z hz
  by_cases h1 : z + w ∈ F <;> by_cases h2 : z ∈ F <;> simp_all
/-- Normal monotonicity (Simon Ch. 3, 4.3: "`H` is non-decreasing"): if `∫_F Dζ(z)(v) dz ≤ 0`
for every nonnegative `ζ ∈ C¹_c(ℝⁿ)`, then for `t ≥ 0` and a.e. `z`, `z ∈ F` implies
`z + t v ∈ F`.  The hypothesis for the translates `ζ(· − s v)` gives
`g(s) = ∫_F Dζ(z − s v)(v) dz ≤ 0`, so the translation identity
`codim1_rdo_dg_hr_translate_integral_eq` yields `∫_F ζ ≤ ∫_F ζ(· − t v)`.  Substituting
`z = y + t v`, `f = 1_F(· + t v) − 1_F` has `∫ ζ f ≥ 0` for all such `ζ`, so `f ≥ 0` a.e. by
`codim1_rdo_dg_hr_ae_nonneg_of_test_nonneg`; and `z ∈ F`, `z + t v ∉ F` would give `f(z) = −1`. -/
theorem Submission.codim1_rdo_dg_hr_ae_translate_monotone : ∀ (n : ℕ) (F : Set (EuclideanSpace ℝ (Fin n))) (v : EuclideanSpace ℝ (Fin n)), MeasurableSet F → (∀ ζ : EuclideanSpace ℝ (Fin n) → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ → (∀ z, 0 ≤ ζ z) → ∫ z in F, fderiv ℝ ζ z v ≤ 0) → ∀ t : ℝ, 0 ≤ t → ∀ᵐ z ∂volume, z ∈ F → z + t • v ∈ F := by
  intro n F v hF hdiv t ht
  classical
  -- Steps 1–2: for every admissible `ζ`, `∫_F ζ ≤ ∫_F ζ(· − t v)`
  have hmono : ∀ ζ : EuclideanSpace ℝ (Fin n) → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ →
      (∀ z, 0 ≤ ζ z) → ∫ z in F, ζ z ≤ ∫ z in F, ζ (z - t • v) := by
    intro ζ hζ hζc hζ0
    -- `g(s) = ∫_F Dζ(z − s v)(v) dz ≤ 0`: the hypothesis for the translate `ζ(· − s v)`
    have hg : ∀ s : ℝ, ∫ z in F, fderiv ℝ ζ (z - s • v) v ≤ 0 := fun s => by
      simpa only [fderiv_comp_sub] using hdiv (fun y => ζ (y - s • v))
        (hζ.comp (contDiff_id.sub contDiff_const))
        (hζc.comp_homeomorph (Homeomorph.subRight (s • v))) fun z => hζ0 _
    have hint : 0 ≤ ∫ s in (0 : ℝ)..t, -∫ z in F, fderiv ℝ ζ (z - s • v) v :=
      intervalIntegral.integral_nonneg_of_forall ht fun s => neg_nonneg.2 (hg s)
    rw [intervalIntegral.integral_neg] at hint
    rw [Submission.codim1_rdo_dg_hr_translate_integral_eq n F ζ v t hF hζ hζc]
    linarith
  -- Step 3: with `u = 1_F`, `f = u(· + t v) − u` has `∫ g f ≥ 0` for every admissible `g`
  set u : EuclideanSpace ℝ (Fin n) → ℝ := F.indicator fun _ => 1
  have hFt : MeasurableSet ((· + t • v) ⁻¹' F) := hF.preimage (measurable_add_const _)
  have htest : ∀ g : EuclideanSpace ℝ (Fin n) → ℝ, ContDiff ℝ 1 g → HasCompactSupport g →
      (∀ x, 0 ≤ g x) → 0 ≤ ∫ x, g x * (u (x + t • v) - u x) := by
    intro g hg hgc hg0
    have hgi : Integrable g := hg.continuous.integrable_of_hasCompactSupport hgc
    -- `∫_F g(z − t v) dz = ∫ 1_F(y + t v) g(y) dy` by translation invariance
    have e1 : ∫ z in F, g (z - t • v) = ∫ y, ((· + t • v) ⁻¹' F).indicator g y := by
      rw [← integral_indicator hF, ← integral_add_right_eq_self _ (t • v)]
      congr 1; ext y; simp [indicator_apply]
    have e2 : ∫ z in F, g z = ∫ y, F.indicator g y := (integral_indicator hF).symm
    have e3 : (fun x => g x * (u (x + t • v) - u x)) =
        fun x => ((· + t • v) ⁻¹' F).indicator g x - F.indicator g x := by
      ext x; simp [u, indicator_apply, mul_sub]
    have := hmono g hg hgc hg0
    rw [e3, integral_sub (hgi.indicator hFt) (hgi.indicator hF)]
    linarith
  -- `f` is bounded and Borel, hence locally integrable
  have hli : LocallyIntegrable (fun x => u (x + t • v) - u x) volume := by
    have hu' : (fun x => u (x + t • v)) = ((· + t • v) ⁻¹' F).indicator fun _ => 1 := by
      ext x; simp [u, indicator_apply]
    refine LocallyIntegrable.sub ?_ ?_
    · rw [hu']; exact (locallyIntegrable_const 1).indicator hFt
    · exact (locallyIntegrable_const 1).indicator hF
  -- Steps 4–5: `f ≥ 0` a.e., while `z ∈ F`, `z + t v ∉ F` would give `f(z) = −1`
  filter_upwards [Submission.codim1_rdo_dg_hr_ae_nonneg_of_test_nonneg n _ hli htest]
    with z hz hzF
  by_contra hzt
  norm_num [u, hzF, hzt] at hz
/-- **Simon, Ch. 3, 4.3, the step to (9)** (a monotone set is null, co-null or a half-space): if a
Borel `F ⊆ ℝⁿ` has `z ∈ F ⇒ z + a ∈ F` for a.e. `z`, for each `a` with `⟨a, v⟩ ≥ 0`, then `F` is
null, co-null, or a.e. equal to `{⟨z, v⟩ > c}`.  Translating `B̄_r(z₁)` onto `B̄_r(z₀)` shows that a
point `z₁` of density `1` lies strictly further along `v` than a point `z₀` of density `0`.  With
`c = sup ⟨z₀, v⟩`, the Lebesgue density theorem puts `F Δ {⟨z, v⟩ > c}` inside a null set and the
null hyperplane `{⟨z, v⟩ = c}`. -/
theorem Submission.codim1_rdo_dg_hr_monotone_set_trichotomy : ∀ (n : ℕ) (F : Set (EuclideanSpace ℝ (Fin n))) (v : EuclideanSpace ℝ (Fin n)), MeasurableSet F → (∀ a : EuclideanSpace ℝ (Fin n), 0 ≤ inner ℝ a v → ∀ᵐ z ∂volume, z ∈ F → z + a ∈ F) → volume F = 0 ∨ volume Fᶜ = 0 ∨ ∃ c : ℝ, volume (symmDiff F {z | c < inner ℝ z v}) = 0 := by
  intro n F v hF hmono
  -- a point of density `1` lies strictly further along `v` than a point of density `0`
  have hord : ∀ z₁ z₀ : EuclideanSpace ℝ (Fin n),
      Tendsto (fun r => volume (F ∩ closedBall z₁ r) / volume (closedBall z₁ r)) (𝓝[>] 0) (𝓝 1) →
      Tendsto (fun r => volume (F ∩ closedBall z₀ r) / volume (closedBall z₀ r)) (𝓝[>] 0) (𝓝 0) →
      inner ℝ z₀ v < inner ℝ z₁ v := by
    intro z₁ z₀ h₁ h₀
    by_contra hlt
    rw [not_lt] at hlt
    -- `z ↦ z + (z₀ - z₁)` keeps `F` a.e. and maps `B̄_r(z₁)` onto `B̄_r(z₀)`
    have hnull : volume {z | ¬(z ∈ F → z + (z₀ - z₁) ∈ F)} = 0 :=
      ae_iff.mp (hmono (z₀ - z₁) (by rw [inner_sub_left]; linarith))
    have hball : ∀ r : ℝ, (fun z => z + (z₀ - z₁)) ⁻¹' closedBall z₀ r = closedBall z₁ r := by
      intro r
      ext z
      simp only [mem_preimage, mem_closedBall, dist_eq_norm]
      rw [show z + (z₀ - z₁) - z₀ = z - z₁ by abel]
    have hle : ∀ r : ℝ, volume (F ∩ closedBall z₁ r) / volume (closedBall z₁ r) ≤
        volume (F ∩ closedBall z₀ r) / volume (closedBall z₀ r) := by
      intro r
      have hsub : F ∩ closedBall z₁ r ⊆ (fun z => z + (z₀ - z₁)) ⁻¹' (F ∩ closedBall z₀ r) ∪
          {z | ¬(z ∈ F → z + (z₀ - z₁) ∈ F)} := by
        rintro z ⟨hzF, hzB⟩
        by_cases h : z + (z₀ - z₁) ∈ F
        · rw [← hball r] at hzB
          exact Or.inl (show z + (z₀ - z₁) ∈ F ∩ closedBall z₀ r from ⟨h, hzB⟩)
        · exact Or.inr fun himp => h (himp hzF)
      have hden : volume (closedBall z₁ r) = volume (closedBall z₀ r) := by
        rw [← hball r, measure_preimage_add_right]
      rw [hden]
      refine ENNReal.div_le_div_right ?_ _
      calc volume (F ∩ closedBall z₁ r)
          ≤ volume ((fun z => z + (z₀ - z₁)) ⁻¹' (F ∩ closedBall z₀ r) ∪
              {z | ¬(z ∈ F → z + (z₀ - z₁) ∈ F)}) := measure_mono hsub
        _ ≤ volume ((fun z => z + (z₀ - z₁)) ⁻¹' (F ∩ closedBall z₀ r)) +
              volume {z | ¬(z ∈ F → z + (z₀ - z₁) ∈ F)} := measure_union_le _ _
        _ = volume (F ∩ closedBall z₀ r) := by rw [hnull, add_zero, measure_preimage_add_right]
    exact absurd (le_of_tendsto_of_tendsto' h₁ h₀ hle) (by simp)
  -- Lebesgue density theorem: off a null set `N`, points of `F` have density `1` and points of
  -- `Fᶜ` have density `0`
  obtain ⟨N, hN0, hN⟩ : ∃ N : Set (EuclideanSpace ℝ (Fin n)), volume N = 0 ∧ ∀ x ∉ N,
      Tendsto (fun r => volume (F ∩ closedBall x r) / volume (closedBall x r)) (𝓝[>] 0)
        (𝓝 (F.indicator 1 x)) :=
    ⟨_, ae_iff.mp (Besicovitch.ae_tendsto_measure_inter_div_of_measurableSet volume hF),
      fun x hx => not_not.mp hx⟩
  have hA₁ : ∀ x ∈ F, x ∉ N →
      Tendsto (fun r => volume (F ∩ closedBall x r) / volume (closedBall x r)) (𝓝[>] 0) (𝓝 1) := by
    intro x hx hxN
    simpa [indicator_of_mem hx] using hN x hxN
  have hA₀ : ∀ x ∉ F, x ∉ N →
      Tendsto (fun r => volume (F ∩ closedBall x r) / volume (closedBall x r)) (𝓝[>] 0) (𝓝 0) := by
    intro x hx hxN
    simpa [indicator_of_notMem hx] using hN x hxN
  -- no point of density `1`: `F` is null
  by_cases h₁ : ∃ z₁, Tendsto (fun r => volume (F ∩ closedBall z₁ r) / volume (closedBall z₁ r))
      (𝓝[>] 0) (𝓝 1)
  swap
  · refine Or.inl (measure_mono_null (fun x hx => ?_) hN0)
    by_contra hxN
    exact h₁ ⟨x, hA₁ x hx hxN⟩
  -- no point of density `0`: `Fᶜ` is null
  by_cases h₀ : ∃ z₀, Tendsto (fun r => volume (F ∩ closedBall z₀ r) / volume (closedBall z₀ r))
      (𝓝[>] 0) (𝓝 0)
  swap
  · refine Or.inr (Or.inl (measure_mono_null (fun x hx => ?_) hN0))
    by_contra hxN
    exact h₀ ⟨x, hA₀ x hx hxN⟩
  obtain ⟨z₁, hz₁⟩ := h₁
  obtain ⟨z₀, hz₀⟩ := h₀
  -- `c = sup {⟨z₀, v⟩ : z₀ has density 0}` separates the two kinds of density points
  obtain ⟨c, hc₀, hc₁⟩ : ∃ c : ℝ,
      (∀ z, Tendsto (fun r => volume (F ∩ closedBall z r) / volume (closedBall z r)) (𝓝[>] 0)
        (𝓝 0) → inner ℝ z v ≤ c) ∧
      (∀ z, Tendsto (fun r => volume (F ∩ closedBall z r) / volume (closedBall z r)) (𝓝[>] 0)
        (𝓝 1) → c ≤ inner ℝ z v) := by
    refine ⟨sSup ((fun z => inner ℝ z v) '' {z | Tendsto (fun r => volume (F ∩ closedBall z r) /
      volume (closedBall z r)) (𝓝[>] 0) (𝓝 0)}), fun z hz => le_csSup ⟨inner ℝ z₁ v, ?_⟩
      ⟨z, hz, rfl⟩, fun z hz => csSup_le ⟨_, z₀, hz₀, rfl⟩ ?_⟩
    · rintro _ ⟨w, hw, rfl⟩
      exact (hord z₁ w hz₁ hw).le
    · rintro _ ⟨w, hw, rfl⟩
      exact (hord z w hz hw).le
  -- the hyperplane `{⟨z, v⟩ = c}` is null, since `v ≠ 0`
  have hv : v ≠ 0 := by
    rintro rfl
    simpa using hord z₁ z₀ hz₁ hz₀
  have hP : volume {z : EuclideanSpace ℝ (Fin n) | inner ℝ z v = c} = 0 := by
    have hvv : inner ℝ v v ≠ 0 := inner_self_ne_zero.mpr hv
    refine measure_mono_null (t := (AffineSubspace.mk' ((c / inner ℝ v v) • v)
      (LinearMap.ker (innerₛₗ ℝ v)) : Set (EuclideanSpace ℝ (Fin n)))) (fun z hz => ?_)
      (Measure.addHaar_affineSubspace _ _ fun h => ?_)
    · replace hz : inner ℝ z v = c := hz
      rw [SetLike.mem_coe, AffineSubspace.mem_mk', vsub_eq_sub, LinearMap.mem_ker,
        innerₛₗ_apply_apply, inner_sub_right, real_inner_smul_right, div_mul_cancel₀ c hvv,
        real_inner_comm z v, hz, sub_self]
    · have hmem : (c / inner ℝ v v) • v + v ∈ AffineSubspace.mk' ((c / inner ℝ v v) • v)
          (LinearMap.ker (innerₛₗ ℝ v)) := by
        rw [h]
        exact AffineSubspace.mem_top _ _ _
      rw [AffineSubspace.mem_mk', vsub_eq_sub, add_sub_cancel_left, LinearMap.mem_ker,
        innerₛₗ_apply_apply] at hmem
      exact hvv hmem
  -- `F Δ {⟨z, v⟩ > c} ⊆ N ∪ {⟨z, v⟩ = c}`
  refine Or.inr (Or.inr ⟨c, measure_mono_null (fun z hz => ?_) (measure_union_null hN0 hP)⟩)
  rcases mem_symmDiff.mp hz with ⟨hzF, hzH⟩ | ⟨hzH, hzF⟩
  · by_cases hzN : z ∈ N
    · exact Or.inl hzN
    · exact Or.inr (le_antisymm (not_lt.mp (show ¬c < inner ℝ z v from hzH))
        (hc₁ z (hA₁ z hzF hzN)))
  · by_cases hzN : z ∈ N
    · exact Or.inl hzN
    · exact absurd (show c < inner ℝ z v from hzH) (not_lt.mpr (hc₀ z (hA₀ z hzF hzN)))

/-- **Half-space rigidity** (Simon Ch. 3, 4.3 (8)–(9); for the inward normal the limit set is
`{⟨z, v⟩ > c}`): if `D_w 1_{F₀} = 0` for every `w ⊥ v` and `D_v 1_{F₀} ≥ 0` in the sense of
distributions, then `F₀` is null, co-null, or a.e. a half-space `{⟨z, v⟩ > c}`.  Translation by
`w ⊥ v` preserves `F₀` a.e. and translation by `t • v`, `t ≥ 0`, maps `F₀` into itself a.e.; writing
`a = (a - ⟨a, v⟩ • v) + ⟨a, v⟩ • v`, translation by any `a` with `⟨a, v⟩ ≥ 0` maps `F₀` into itself
a.e., and the Lebesgue density trichotomy for such monotone sets concludes. -/
theorem Submission.codim1_rdo_dg_halfspace_rigidity : ∀ (m : ℕ) (F₀ : Set (Euclid (m + 1))) (v : Euclid (m + 1)), ‖v‖ = 1 → MeasurableSet F₀ → (∀ ζ : Euclid (m + 1) → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ → ∀ w : Euclid (m + 1), inner ℝ w v = 0 → ∫ z in F₀, fderiv ℝ ζ z w = 0) → (∀ ζ : Euclid (m + 1) → ℝ, ContDiff ℝ 1 ζ → HasCompactSupport ζ → (∀ z, 0 ≤ ζ z) → ∫ z in F₀, fderiv ℝ ζ z v ≤ 0) → volume F₀ = 0 ∨ volume F₀ᶜ = 0 ∨ ∃ c : ℝ, volume (symmDiff F₀ {z | c < inner ℝ z v}) = 0 := by
  intro m F₀ v hv hF htan hnor
  refine Submission.codim1_rdo_dg_hr_monotone_set_trichotomy (m + 1) F₀ v hF fun a ha => ?_
  -- `a = w + t • v` with `t = ⟨a, v⟩ ≥ 0` and `w = a - t • v ⊥ v`, as `‖v‖ = 1`
  generalize ht : inner ℝ a v = t at ha
  have hw : inner ℝ (a - t • v) v = 0 := by
    rw [inner_sub_left, real_inner_smul_left, real_inner_self_eq_norm_sq, hv, ht]
    ring
  -- a.e. `z + w ∈ F₀ ↔ z ∈ F₀`, and a.e. `z + w ∈ F₀ → z + w + t • v ∈ F₀` (translate by `w`)
  have hinv := Submission.codim1_rdo_dg_hr_ae_translate_invariant (m + 1) F₀ (a - t • v) hF
    fun ζ hζ hζc => htan ζ hζ hζc (a - t • v) hw
  have hmono := (measurePreserving_add_right volume (a - t • v)).quasiMeasurePreserving.ae
    (Submission.codim1_rdo_dg_hr_ae_translate_monotone (m + 1) F₀ v hF hnor t ha)
  filter_upwards [hinv, hmono] with z hzw hzwv hz
  simpa only [add_assoc, sub_add_cancel] using hzwv (hzw.2 hz)
/-- **The ball and cone masses are Borel functions of the centre.**  This is the measurability
that Simon's proof of Ch. 3, 1.6 "⇐" does not check when it applies Egoroff's theorem to `f_k`
and `q_k`, which are built from `μ(B_ρ(x))` and `μ(X_{1/2}(P_x^⊥, x) ∩ B_ρ(x))`.  For an s-finite
`μ` on `E = ℝ^{m+1}`, a Borel `ν : E → E` and `α, q ∈ ℝ`, the maps `x ↦ μ(B̄_q(x))` and
`x ↦ μ({z : α|z - x| ≤ |⟨z - x, ν(x)⟩|} ∩ B̄_q(x))` are measurable.  Each is `x ↦ μ(S_x)` for a
measurable `S ⊆ E × E`, namely `S = A = {(x, z) : |z - x| ≤ q}` or `S = B ∩ A` with
`B = {(x, z) : α|z - x| ≤ |⟨z - x, ν(x)⟩|}`, so the section lemma of Tonelli's theorem applies. -/
theorem Submission.codim1_rdo_dg_rc_ball_cone_measurable : ∀ (m : ℕ) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)) (α q : ℝ), SFinite μ → Measurable ν → Measurable (fun x : Euclid (m + 1) => μ (closedBall x q)) ∧ Measurable (fun x : Euclid (m + 1) => μ ({z | α * ‖z - x‖ ≤ |inner ℝ (z - x) (ν x)|} ∩ closedBall x q)) := by
  intro m μ ν α q hμ hν
  -- `A = {(x, z) : |z - x| ≤ q}` is measurable, with sections `B̄_q(x)`
  have hA : MeasurableSet {p : Euclid (m + 1) × Euclid (m + 1) | dist p.2 p.1 ≤ q} :=
    measurableSet_le (continuous_dist.comp (continuous_snd.prodMk continuous_fst)).measurable
      measurable_const
  -- `B = {(x, z) : α|z - x| ≤ |⟨z - x, ν(x)⟩|}` is measurable since `ν` is
  have hB : MeasurableSet {p : Euclid (m + 1) × Euclid (m + 1) |
      α * ‖p.2 - p.1‖ ≤ |inner ℝ (p.2 - p.1) (ν p.1)|} := by
    refine measurableSet_le ?_ ?_
    · exact (continuous_const.mul (continuous_norm.comp
        (continuous_snd.sub continuous_fst))).measurable
    · exact continuous_abs.measurable.comp (Continuous.measurable2 continuous_inner
        (measurable_snd.sub measurable_fst) (hν.comp measurable_fst))
  -- for s-finite `μ`, `x ↦ μ(S_x)` is measurable for every measurable `S ⊆ E × E`
  refine ⟨?_, ?_⟩
  · have h := measurable_measure_prodMk_left (ν := μ) hA
    convert h using 2 with x
    rfl
  · have h := measurable_measure_prodMk_left (ν := μ) (hB.inter hA)
    convert h using 2 with x
    rfl

/-- **Uniform density and cone bounds on a large compact set** (Simon Ch. 3, proof of 1.6 "⇐",
(4) and (7)–(9), chapter-03.txt lines 162–213).  Let `μ` be a finite measure on `ℝ^{m+1}`,
`C(x) = {z : ¼|z − x| ≤ |⟨z − x, ν(x)⟩|}`, and suppose that for `μ`-a.e. `y`,
`μ(B̄_r(y))/(ωₘrᵐ) → 1` and `μ(C(y) ∩ B̄_r(y))/rᵐ → 0` as `r ↓ 0`.  Then for `ε, η > 0` there are
a compact `K` with `μ(Kᶜ) ≤ η` and `δ > 0` such that `(1 − ε)⁺ωₘρᵐ ≤ μ(B̄_ρ(x))` and
`μ(C(x) ∩ B̄_ρ(x)) ≤ εωₘρᵐ` for all `x ∈ K`, `0 < ρ < δ`.  Egoroff's theorem is replaced by the
Borel sets `G_k` of points where both bounds hold at every rational radius `0 < q < 1/(k + 1)`
(Borel by `codim1_rdo_dg_rc_ball_cone_measurable`): they increase to a set of full measure, so
`μ(G_kᶜ) < η/2` for some `k` by continuity from above, and inner regularity gives a compact
`K ⊆ G_k` with `μ(G_k \ K) < η/2`.  The bounds pass from rational to real radii by monotonicity
in the radius and continuity of `ρ ↦ cρᵐ`. -/
theorem Submission.codim1_rdo_dg_rc_uniform_compact : ∀ (m : ℕ) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)) (ε : ℝ) (η : ℝ≥0∞), IsFiniteMeasure μ → Measurable ν → 0 < ε → 0 < η → (∀ᵐ y ∂μ, Tendsto (fun r : ℝ => μ (closedBall y r) / (unitBallVolume m * ENNReal.ofReal (r ^ m))) (𝓝[>] 0) (𝓝 1) ∧ Tendsto (fun r : ℝ => μ ({z | (1 / 4 : ℝ) * ‖z - y‖ ≤ |inner ℝ (z - y) (ν y)|} ∩ closedBall y r) / ENNReal.ofReal (r ^ m)) (𝓝[>] 0) (𝓝 0)) → ∃ K : Set (Euclid (m + 1)), ∃ δ : ℝ, IsCompact K ∧ 0 < δ ∧ μ Kᶜ ≤ η ∧ (∀ x ∈ K, ∀ ρ : ℝ, 0 < ρ → ρ < δ → ENNReal.ofReal (1 - ε) * unitBallVolume m * ENNReal.ofReal (ρ ^ m) ≤ μ (closedBall x ρ)) ∧ (∀ x ∈ K, ∀ ρ : ℝ, 0 < ρ → ρ < δ → μ ({z | (1 / 4 : ℝ) * ‖z - x‖ ≤ |inner ℝ (z - x) (ν x)|} ∩ closedBall x ρ) ≤ ENNReal.ofReal ε * unitBallVolume m * ENNReal.ofReal (ρ ^ m)) := by
  intro m μ ν ε η hfin hν hε hη hae
  have hω0 : unitBallVolume m ≠ 0 := by
    unfold unitBallVolume; exact (measure_ball_pos _ _ one_pos).ne'
  have hωtop : unitBallVolume m ≠ ∞ := by
    unfold unitBallVolume; exact measure_ball_lt_top.ne
  -- step 2: for each radius `q` both `x ↦ μ(B̄_q(x))` and `x ↦ μ(C(x) ∩ B̄_q(x))` are Borel
  have hball : ∀ q : ℝ, Measurable (fun x : Euclid (m + 1) => μ (closedBall x q)) :=
    fun q => (Submission.codim1_rdo_dg_rc_ball_cone_measurable m μ ν (1 / 4) q inferInstance hν).1
  have hcone : ∀ q : ℝ, Measurable (fun x : Euclid (m + 1) =>
      μ ({z | (1 / 4 : ℝ) * ‖z - x‖ ≤ |inner ℝ (z - x) (ν x)|} ∩ closedBall x q)) :=
    fun q => (Submission.codim1_rdo_dg_rc_ball_cone_measurable m μ ν (1 / 4) q inferInstance hν).2
  -- monotonicity and continuity of `ρ ↦ c * ofReal (ρ ^ m)`
  have hmono : ∀ (c : ℝ≥0∞) (s t : ℝ), 0 ≤ s → s ≤ t →
      c * ENNReal.ofReal (s ^ m) ≤ c * ENNReal.ofReal (t ^ m) := by
    intro c s t hs hst
    exact mul_le_mul_right (ENNReal.ofReal_le_ofReal (pow_le_pow_left₀ hs hst m)) c
  have hcont : ∀ c : ℝ≥0∞, c ≠ ∞ → Continuous (fun s : ℝ => c * ENNReal.ofReal (s ^ m)) :=
    fun c hc => (ENNReal.continuous_const_mul hc).comp
      (ENNReal.continuous_ofReal.comp (continuous_pow m))
  -- the argument for general constants `A`, `B` and a general family of sets `C x`
  have main : ∀ (C : Euclid (m + 1) → Set (Euclid (m + 1))) (A B : ℝ≥0∞), A ≠ ∞ → B ≠ ∞ →
      (∀ q : ℝ, Measurable (fun x => μ (C x ∩ closedBall x q))) →
      (∀ᵐ y ∂μ, ∃ r₁ : ℝ, 0 < r₁ ∧ ∀ r : ℝ, 0 < r → r < r₁ →
        A * ENNReal.ofReal (r ^ m) ≤ μ (closedBall y r) ∧
          μ (C y ∩ closedBall y r) ≤ B * ENNReal.ofReal (r ^ m)) →
      ∃ K : Set (Euclid (m + 1)), ∃ δ : ℝ, IsCompact K ∧ 0 < δ ∧ μ Kᶜ ≤ η ∧
        (∀ x ∈ K, ∀ ρ : ℝ, 0 < ρ → ρ < δ → A * ENNReal.ofReal (ρ ^ m) ≤ μ (closedBall x ρ)) ∧
        (∀ x ∈ K, ∀ ρ : ℝ, 0 < ρ → ρ < δ →
          μ (C x ∩ closedBall x ρ) ≤ B * ENNReal.ofReal (ρ ^ m)) := by
    intro C A B hA hB hCmeas hgood
    -- step 1: the good sets `G k`, bounds at rational radii `q < 1/(k + 1)`
    let G : ℕ → Set (Euclid (m + 1)) := fun k => {x | ∀ q : ℚ, 0 < (q : ℝ) →
      (q : ℝ) < 1 / ((k : ℝ) + 1) →
      A * ENNReal.ofReal ((q : ℝ) ^ m) ≤ μ (closedBall x q) ∧
        μ (C x ∩ closedBall x q) ≤ B * ENNReal.ofReal ((q : ℝ) ^ m)}
    -- step 2: each `G k` is Borel
    have hGmeas : ∀ k, MeasurableSet (G k) := by
      intro k
      refine Measurable.setOf (Measurable.forall fun q => ?_)
      refine Measurable.imp measurable_const (Measurable.imp measurable_const
        (Measurable.and ?_ ?_))
      · exact measurableSet_setOfPred.1 (measurableSet_le measurable_const (hball q))
      · exact measurableSet_setOfPred.1 (measurableSet_le (hCmeas q) measurable_const)
    -- step 3: `G` is increasing
    have hGmono : Monotone G := by
      intro k l hkl x hx q hq0 hql
      refine hx q hq0 (lt_of_lt_of_le hql ?_)
      have hkl' : (k : ℝ) ≤ l := Nat.cast_le.mpr hkl
      exact one_div_le_one_div_of_le (by positivity) (by linarith)
    -- step 4: `μ`-a.e. point lies in some `G k`
    have hGae : ∀ᵐ x ∂μ, x ∈ ⋃ k, G k := by
      filter_upwards [hgood] with y hy
      obtain ⟨r₁, hr₁, hy⟩ := hy
      obtain ⟨k, hk⟩ := exists_nat_one_div_lt hr₁
      exact mem_iUnion.mpr ⟨k, fun q hq0 hqk => hy q hq0 (hqk.trans hk)⟩
    have hnull : μ (⋂ k, (G k)ᶜ) = 0 := by
      rw [← compl_iUnion]
      exact mem_ae_iff.mp hGae
    -- step 5: continuity from above gives `μ (G k)ᶜ < η / 2` for some `k`
    have htend : Tendsto (fun k => μ (G k)ᶜ) atTop (𝓝 0) := by
      have := tendsto_measure_iInter_atTop (μ := μ) (s := fun k => (G k)ᶜ)
        (fun k => (hGmeas k).compl.nullMeasurableSet)
        (fun k l hkl => compl_subset_compl.mpr (hGmono hkl)) ⟨0, measure_ne_top μ _⟩
      rw [hnull] at this
      exact this
    have hη2 : 0 < η / 2 := ENNReal.half_pos hη.ne'
    obtain ⟨k, hk⟩ := (htend.eventually_lt_const hη2).exists
    -- step 6: inner regularity gives a compact `K ⊆ G k` with `μ (G k \ K) < η / 2`
    obtain ⟨K, hKG, hKc, hKμ⟩ :=
      (hGmeas k).exists_isCompact_sdiff_lt (measure_ne_top μ _) hη2.ne'
    refine ⟨K, 1 / ((k : ℝ) + 1), hKc, by positivity, ?_, ?_, ?_⟩
    · calc μ Kᶜ ≤ μ ((G k)ᶜ ∪ (G k \ K)) := by
            apply measure_mono
            intro x hx
            by_cases h : x ∈ G k
            · exact Or.inr ⟨h, hx⟩
            · exact Or.inl h
        _ ≤ μ (G k)ᶜ + μ (G k \ K) := measure_union_le _ _
        _ ≤ η / 2 + η / 2 := add_le_add hk.le hKμ.le
        _ = η := ENNReal.add_halves η
    -- step 7(a): lower bound at real radii, approximating `ρ` from below by rationals
    · intro x hxK ρ hρ hρδ
      have hxG := hKG hxK
      have key : ∀ s ∈ Ioo 0 ρ, A * ENNReal.ofReal (s ^ m) ≤ μ (closedBall x ρ) := by
        intro s hs
        obtain ⟨q, hsq, hqρ⟩ := exists_rat_btwn hs.2
        have hq0 : 0 < (q : ℝ) := hs.1.trans hsq
        calc A * ENNReal.ofReal (s ^ m) ≤ A * ENNReal.ofReal ((q : ℝ) ^ m) :=
              hmono A s q hs.1.le hsq.le
          _ ≤ μ (closedBall x q) := (hxG q hq0 (hqρ.trans hρδ)).1
          _ ≤ μ (closedBall x ρ) := measure_mono (closedBall_subset_closedBall hqρ.le)
      exact le_of_tendsto (((hcont A hA).tendsto ρ).mono_left nhdsWithin_le_nhds)
        (eventually_of_mem (Ioo_mem_nhdsLT hρ) key)
    -- step 7(b): cone bound at real radii, approximating `ρ` from above by rationals
    · intro x hxK ρ hρ hρδ
      have hxG := hKG hxK
      have key : ∀ s ∈ Ioo ρ (1 / ((k : ℝ) + 1)),
          μ (C x ∩ closedBall x ρ) ≤ B * ENNReal.ofReal (s ^ m) := by
        intro s hs
        obtain ⟨q, hρq, hqs⟩ := exists_rat_btwn hs.1
        have hq0 : 0 < (q : ℝ) := hρ.trans hρq
        calc μ (C x ∩ closedBall x ρ) ≤ μ (C x ∩ closedBall x q) :=
              measure_mono (inter_subset_inter_right _ (closedBall_subset_closedBall hρq.le))
          _ ≤ B * ENNReal.ofReal ((q : ℝ) ^ m) := (hxG q hq0 (hqs.trans hs.2)).2
          _ ≤ B * ENNReal.ofReal (s ^ m) := hmono B q s hq0.le hqs.le
      exact ge_of_tendsto (((hcont B hB).tendsto ρ).mono_left nhdsWithin_le_nhds)
        (eventually_of_mem (Ioo_mem_nhdsGT hρδ) key)
  -- step 4 for the actual constants: where both limits hold, the bounds hold for small `r`
  have hA1 : ENNReal.ofReal (1 - ε) < 1 := ENNReal.ofReal_lt_one.mpr (by linarith)
  have hB0 : 0 < ENNReal.ofReal ε * unitBallVolume m :=
    ENNReal.mul_pos (ENNReal.ofReal_pos.mpr hε).ne' hω0
  refine main (fun x => {z | (1 / 4 : ℝ) * ‖z - x‖ ≤ |inner ℝ (z - x) (ν x)|})
    (ENNReal.ofReal (1 - ε) * unitBallVolume m) (ENNReal.ofReal ε * unitBallVolume m)
    (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hωtop)
    (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hωtop) hcone ?_
  filter_upwards [hae] with y hy
  obtain ⟨h1, h2⟩ := hy
  have e1 := h1.eventually_const_lt hA1
  have e2 := h2.eventually_lt_const hB0
  obtain ⟨r₁, hr₁, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.mp (e1.and e2)
  refine ⟨r₁, hr₁, fun r hr0 hr1 => ?_⟩
  obtain ⟨hlow, hup⟩ := hsub ⟨hr0, hr1⟩
  have hpow0 : ENNReal.ofReal (r ^ m) ≠ 0 := (ENNReal.ofReal_pos.mpr (pow_pos hr0 m)).ne'
  have hpowtop : ENNReal.ofReal (r ^ m) ≠ ∞ := ENNReal.ofReal_ne_top
  constructor
  · have := (ENNReal.le_div_iff_mul_le (Or.inl (mul_ne_zero hω0 hpow0))
      (Or.inl (ENNReal.mul_ne_top hωtop hpowtop))).mp hlow.le
    rw [mul_assoc]
    exact this
  · exact (ENNReal.div_le_iff hpow0 hpowtop).mp hup.le
/-- **Simon Ch. 3, proof of 1.6 "⇐", claim (10)** (cone exclusion), in codimension one: let
`μ(B̄_ρ(y)) ≥ (1 − ε) ωₘ ρᵐ` and `μ(C(y) ∩ B̄_ρ(y)) ≤ ε ωₘ ρᵐ` for `y ∈ K`, `0 < ρ < δ`, where
`C(y) = {z : |z − y| ≤ 4 |⟨z − y, ν(y)⟩|}`, and let `(1 + 16ᵐ) ε < 1`.  Then
`|⟨x' − x, v⟩| ≤ |x' − x| / 2` for `x, x' ∈ K` with `|x' − x| < δ / 2` and `|ν(x) − v| ≤ 1/16`.
Otherwise `B̄_{ρ/8}(x') ⊆ C(x) ∩ B̄_{2ρ}(x)` for `ρ = |x' − x|`, and the two bounds give
`(1 − ε) ωₘ (ρ/8)ᵐ ≤ ε ωₘ (2ρ)ᵐ`, i.e. `1 − ε ≤ 16ᵐ ε`. -/
theorem Submission.codim1_rdo_dg_rc_cone_exclusion : ∀ (m : ℕ) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)) (K : Set (Euclid (m + 1))) (δ ε : ℝ), (∀ y, ‖ν y‖ = 1) → 0 ≤ ε → (1 + 16 ^ m) * ε < 1 → (∀ x ∈ K, ∀ ρ : ℝ, 0 < ρ → ρ < δ → ENNReal.ofReal (1 - ε) * unitBallVolume m * ENNReal.ofReal (ρ ^ m) ≤ μ (closedBall x ρ)) → (∀ x ∈ K, ∀ ρ : ℝ, 0 < ρ → ρ < δ → μ ({z | (1 / 4 : ℝ) * ‖z - x‖ ≤ |inner ℝ (z - x) (ν x)|} ∩ closedBall x ρ) ≤ ENNReal.ofReal ε * unitBallVolume m * ENNReal.ofReal (ρ ^ m)) → ∀ x ∈ K, ∀ x' ∈ K, ∀ v : Euclid (m + 1), ‖ν x - v‖ ≤ 1 / 16 → ‖x' - x‖ < δ / 2 → |inner ℝ (x' - x) v| ≤ ‖x' - x‖ / 2 := by
  intro m μ ν K δ ε hν1 hε0 hε1 hlow hup x hx x' hx' v hv hxx'
  by_contra hcon
  push Not at hcon
  set w := x' - x with hw
  set ρ := ‖w‖ with hρ
  have hρ0 : 0 < ρ := by
    rcases (norm_nonneg w).lt_or_eq with h | h
    · exact h
    · exfalso
      have hw0 : w = 0 := norm_eq_zero.1 h.symm
      rw [hw0] at hcon
      simp at hcon
      linarith [h, hρ]
  have hδ : 0 < δ := by linarith
  -- `|⟨w, ν x⟩| > 7ρ/16`, since `|⟨w, v⟩| > ρ/2` and `|ν x - v| ≤ 1/16`
  have h2 : 7 * ρ / 16 < |inner ℝ w (ν x)| := by
    have e1 : |inner ℝ w (v - ν x)| ≤ ρ * ‖ν x - v‖ := by
      calc |inner ℝ w (v - ν x)| ≤ ‖w‖ * ‖v - ν x‖ := abs_real_inner_le_norm _ _
        _ = ρ * ‖ν x - v‖ := by rw [norm_sub_rev v (ν x)]
    have e2 : inner ℝ w v = inner ℝ w (ν x) + inner ℝ w (v - ν x) := by
      rw [inner_sub_right]; ring
    have e3 : |inner ℝ w v| ≤ |inner ℝ w (ν x)| + |inner ℝ w (v - ν x)| := by
      rw [e2]; exact abs_add_le _ _
    have e4 : ρ * ‖ν x - v‖ ≤ ρ * (1 / 16) := mul_le_mul_of_nonneg_left hv hρ0.le
    linarith
  -- `B̄_{ρ/8}(x') ⊆ C(x) ∩ B̄_{2ρ}(x)`: on the small ball `|z - x| ≤ 9ρ/8` and
  -- `|⟨z - x, ν x⟩| > 7ρ/16 - ρ/8 = 5ρ/16`
  have hsub : closedBall x' (ρ / 8) ⊆
      {z | (1 / 4 : ℝ) * ‖z - x‖ ≤ |inner ℝ (z - x) (ν x)|} ∩ closedBall x (2 * ρ) := by
    intro z hz
    rw [mem_closedBall, dist_eq_norm] at hz
    have hzx : z - x = w + (z - x') := by rw [hw]; abel
    have hnorm : ‖z - x‖ ≤ 9 * ρ / 8 := by
      calc ‖z - x‖ = ‖w + (z - x')‖ := by rw [hzx]
        _ ≤ ‖w‖ + ‖z - x'‖ := norm_add_le _ _
        _ ≤ ρ + ρ / 8 := by linarith
        _ = 9 * ρ / 8 := by ring
    have hin : |inner ℝ (z - x') (ν x)| ≤ ρ / 8 := by
      calc |inner ℝ (z - x') (ν x)| ≤ ‖z - x'‖ * ‖ν x‖ := abs_real_inner_le_norm _ _
        _ = ‖z - x'‖ := by rw [hν1 x, mul_one]
        _ ≤ ρ / 8 := hz
    have hinner : inner ℝ (z - x) (ν x) = inner ℝ w (ν x) + inner ℝ (z - x') (ν x) := by
      rw [hzx, inner_add_left]
    have hbig : 5 * ρ / 16 < |inner ℝ (z - x) (ν x)| := by
      rw [hinner]
      have h' : |inner ℝ w (ν x)| ≤
          |inner ℝ w (ν x) + inner ℝ (z - x') (ν x)| + |inner ℝ (z - x') (ν x)| := by
        have := abs_sub (inner ℝ w (ν x) + inner ℝ (z - x') (ν x)) (inner ℝ (z - x') (ν x))
        simpa using this
      linarith
    refine ⟨?_, ?_⟩
    · show (1 / 4 : ℝ) * ‖z - x‖ ≤ |inner ℝ (z - x) (ν x)|
      linarith
    · rw [mem_closedBall, dist_eq_norm]; linarith
  -- `(1 - ε) ωₘ (ρ/8)ᵐ ≤ μ(B̄_{ρ/8}(x')) ≤ μ(C(x) ∩ B̄_{2ρ}(x)) ≤ ε ωₘ (2ρ)ᵐ`
  have hlow' := hlow x' hx' (ρ / 8) (by positivity) (by linarith)
  have hup' := hup x hx (2 * ρ) (by positivity) (by linarith)
  have hchain : ENNReal.ofReal (1 - ε) * unitBallVolume m * ENNReal.ofReal ((ρ / 8) ^ m) ≤
      ENNReal.ofReal ε * unitBallVolume m * ENNReal.ofReal ((2 * ρ) ^ m) :=
    hlow'.trans ((measure_mono hsub).trans hup')
  -- cancelling `ωₘ (ρ/8)ᵐ ∈ (0, ∞)` gives `1 - ε ≤ 16ᵐ ε`, contradicting `(1 + 16ᵐ) ε < 1`
  have hω0 : unitBallVolume m ≠ 0 := by
    unfold unitBallVolume; exact (measure_ball_pos _ _ one_pos).ne'
  have hωt : unitBallVolume m ≠ ∞ := by
    unfold unitBallVolume; exact measure_ball_lt_top.ne
  set a := (unitBallVolume m).toReal with ha_def
  have ha : 0 < a := ENNReal.toReal_pos hω0 hωt
  have hωeq : unitBallVolume m = ENNReal.ofReal a := (ENNReal.ofReal_toReal hωt).symm
  have h1ε : 0 ≤ 1 - ε := by
    have : 0 ≤ (16 : ℝ) ^ m * ε := by positivity
    nlinarith
  have hL : ENNReal.ofReal (1 - ε) * unitBallVolume m * ENNReal.ofReal ((ρ / 8) ^ m) =
      ENNReal.ofReal ((1 - ε) * a * (ρ / 8) ^ m) := by
    rw [hωeq, ← ENNReal.ofReal_mul h1ε, ← ENNReal.ofReal_mul (by positivity)]
  have hR : ENNReal.ofReal ε * unitBallVolume m * ENNReal.ofReal ((2 * ρ) ^ m) =
      ENNReal.ofReal (ε * a * (2 * ρ) ^ m) := by
    rw [hωeq, ← ENNReal.ofReal_mul hε0, ← ENNReal.ofReal_mul (by positivity)]
  rw [hL, hR, ENNReal.ofReal_le_ofReal_iff (by positivity)] at hchain
  have hpow : (2 * ρ) ^ m = 16 ^ m * (ρ / 8) ^ m := by
    rw [← mul_pow]; congr 1; ring
  rw [hpow] at hchain
  have hpos : 0 < a * (ρ / 8) ^ m := by positivity
  have h16 : (1 - ε) * (a * (ρ / 8) ^ m) ≤ (ε * 16 ^ m) * (a * (ρ / 8) ^ m) := by
    calc (1 - ε) * (a * (ρ / 8) ^ m) = (1 - ε) * a * (ρ / 8) ^ m := by ring
      _ ≤ ε * a * (16 ^ m * (ρ / 8) ^ m) := hchain
      _ = (ε * 16 ^ m) * (a * (ρ / 8) ^ m) := by ring
  have h17 : 1 - ε ≤ ε * 16 ^ m := le_of_mul_le_mul_right h16 hpos
  nlinarith
/-- **Simon Ch. 3, proof of 1.6 "⇐"** (Lipschitz graph step, codimension one): if `‖v‖ = 1` and
`|⟨x' − x, v⟩| ≤ ‖x' − x‖/2` on `S`, then `S` lies in a closed countably `m`-rectifiable set.
With `t(z) = ⟨z, v⟩` and `p(z) = z − t(z)v`, the hypothesis gives `|t(x') − t(x)| ≤ ‖p(x') − p(x)‖`
on `S`, so `p(x) ↦ t(x)` is 1-Lipschitz on `p(S)`; its McShane extension `τ` makes
`Γ = {z | τ(p(z)) = t(z)}` closed, and `Γ` lies in the range of the Lipschitz map
`y ↦ ι(y) + τ(ι(y))v`, where `ι : ℝᵐ ≃ v^⊥` is a linear isometry. -/
theorem Submission.codim1_rdo_dg_rc_closed_graph_cover : ∀ (m : ℕ) (v : Euclid (m + 1)) (S : Set (Euclid (m + 1))), ‖v‖ = 1 → (∀ x ∈ S, ∀ x' ∈ S, |inner ℝ (x' - x) v| ≤ ‖x' - x‖ / 2) → ∃ Γ : Set (Euclid (m + 1)), IsClosed Γ ∧ CountablyRectifiable m Γ ∧ S ⊆ Γ := by
  intro m v S hv hS
  -- Step 1: height `t` and orthogonal projection `p` onto `vᗮ`.
  obtain ⟨t, ht⟩ : ∃ t : Euclid (m + 1) → ℝ, ∀ z, t z = inner ℝ z v := ⟨_, fun _ => rfl⟩
  obtain ⟨p, hp⟩ : ∃ p : Euclid (m + 1) → Euclid (m + 1), ∀ z, p z = z - t z • v :=
    ⟨_, fun _ => rfl⟩
  have hvv : inner ℝ v v = (1 : ℝ) := by
    rw [real_inner_self_eq_norm_sq, hv]; norm_num
  have hpv : ∀ z, inner ℝ (p z) v = (0 : ℝ) := by
    intro z
    rw [hp, inner_sub_left, real_inner_smul_left, hvv, ht, mul_one, sub_self]
  have hpmem : ∀ z, p z ∈ (ℝ ∙ v)ᗮ := by
    intro z
    rw [Submodule.mem_orthogonal_singleton_iff_inner_left]
    exact hpv z
  have hdecomp : ∀ z, p z + t z • v = z := by
    intro z
    rw [hp, sub_add_cancel]
  -- Step 2: the key inequality `|t x' - t x| ≤ ‖p x' - p x‖` on `S`.
  have key : ∀ x ∈ S, ∀ x' ∈ S, |t x' - t x| ≤ ‖p x' - p x‖ := by
    intro x hx x' hx'
    have h1 := hS x hx x' hx'
    have h2 : inner ℝ (x' - x) v = t x' - t x := by
      rw [inner_sub_left, ht, ht]
    have h3 : x' - x = (p x' - p x) + (t x' - t x) • v := by
      rw [hp, hp, sub_smul]
      abel
    have h4 : ‖x' - x‖ ≤ ‖p x' - p x‖ + |t x' - t x| := by
      calc ‖x' - x‖ = ‖(p x' - p x) + (t x' - t x) • v‖ := by rw [← h3]
        _ ≤ ‖p x' - p x‖ + ‖(t x' - t x) • v‖ := norm_add_le _ _
        _ = ‖p x' - p x‖ + |t x' - t x| := by
          rw [norm_smul, hv, mul_one, Real.norm_eq_abs]
    rw [h2] at h1
    linarith
  -- Step 3: the height as a function of the projection, and its McShane extension.
  obtain ⟨τ, hτ⟩ : ∃ τ : Euclid (m + 1) → ℝ, ∀ x ∈ S, τ (p x) = t x := by
    refine ⟨fun y => t (Function.invFunOn p S y), ?_⟩
    intro x hx
    have hex : ∃ a ∈ S, p a = p x := ⟨x, hx, rfl⟩
    have hmem := Function.invFunOn_mem hex
    have heq := Function.invFunOn_eq hex
    have h := key x hx _ hmem
    rw [heq, sub_self, norm_zero] at h
    have h0 : t (Function.invFunOn p S (p x)) - t x = 0 := abs_nonpos_iff.mp h
    show t (Function.invFunOn p S (p x)) = t x
    linarith
  have hτLip : LipschitzOnWith 1 τ (p '' S) := by
    apply LipschitzOnWith.mk_one
    rintro _ ⟨x, hx, rfl⟩ _ ⟨x', hx', rfl⟩
    rw [hτ x hx, hτ x' hx', Real.dist_eq, dist_eq_norm]
    exact key x' hx' x hx
  obtain ⟨τ', hτ'Lip, hτ'eq⟩ := hτLip.extend_real
  -- Step 4: an isometry `ι : ℝᵐ ≃ vᗮ` and the Lipschitz graph map `F`.
  have : Fact (Module.finrank ℝ (Euclid (m + 1)) = m + 1) := ⟨finrank_euclideanSpace_fin⟩
  have hv0 : v ≠ 0 := by
    intro h; rw [h, norm_zero] at hv; exact zero_ne_one hv
  let ι := (OrthonormalBasis.fromOrthogonalSpanSingleton (𝕜 := ℝ) m hv0).repr.symm
  let F : Euclid m → Euclid (m + 1) := fun y => ((ι y : (ℝ ∙ v)ᗮ) : Euclid (m + 1)) +
    τ' ((ι y : (ℝ ∙ v)ᗮ) : Euclid (m + 1)) • v
  have hFLip : ∃ K, LipschitzWith K F := by
    have h1 : LipschitzWith (1 * 1)
        (fun y : Euclid m => ((ι y : (ℝ ∙ v)ᗮ) : Euclid (m + 1))) :=
      (Submodule.subtypeₗᵢ (ℝ ∙ v)ᗮ).lipschitzWith.comp ι.lipschitzWith
    have hsm : LipschitzWith 1 (fun r : ℝ => r • v) := by
      apply LipschitzWith.mk_one
      intro r s
      rw [dist_eq_norm, ← sub_smul, norm_smul, hv, mul_one, Real.dist_eq, Real.norm_eq_abs]
    exact ⟨_, h1.add (hsm.comp (hτ'Lip.comp h1))⟩
  obtain ⟨K, hK⟩ := hFLip
  -- Step 5: the closed graph `Γ = {z | τ' (p z) = t z}`.
  have htc : Continuous t := by
    rw [show t = fun z => inner ℝ z v from funext ht]
    fun_prop
  have hpc : Continuous p := by
    rw [show p = fun z => z - t z • v from funext hp]
    fun_prop
  refine ⟨{z | τ' (p z) = t z}, ?_, ?_, ?_⟩
  · exact isClosed_eq (hτ'Lip.continuous.comp hpc) htc
  · apply (Poincare.SimonGMT.Chapter03.countablyRectifiable_range hK).mono
    intro z hz
    simp only [mem_ofPred_eq] at hz
    refine ⟨ι.symm ⟨p z, hpmem z⟩, ?_⟩
    simp only [F, LinearIsometryEquiv.apply_symm_apply]
    rw [hz]
    exact hdecomp z
  · intro x hx
    simp only [mem_ofPred_eq]
    rw [← hτ'eq (mem_image_of_mem p hx)]
    exact hτ x hx

/-- **Compact cover** of Simon Ch. 3, proof of Theorem 1.6 "⇐": the choice of `π₁, …, π_N` with
`E = ⋃ⱼ Eⱼ` and the selection `E ⊆ ⋃ⱼ Qⱼ(graph fⱼ)`, in codimension one, where the subspaces `πⱼ`
become unit directions `v`.  Cover the unit sphere by finitely many balls `B_{1/16}(v)` and `K` by
finitely many balls `B_{δ/4}(c)`, `c ∈ K`.  Two points of
`S_{v,c} = {x ∈ K : |ν(x) − v| < 1/16} ∩ B_{δ/4}(c)` are less than `δ/2` apart, so
`codim1_rdo_dg_rc_cone_exclusion` gives `|⟨x' − x, v⟩| ≤ ½|x' − x|` on `S_{v,c}`, and
`codim1_rdo_dg_rc_closed_graph_cover` gives a closed countably `m`-rectifiable `Γ_{v,c} ⊇ S_{v,c}`.
The finite union of the `Γ_{v,c}` contains `K`, since `|ν(x)| = 1`. -/
theorem Submission.codim1_rdo_dg_rc_compact_cover : ∀ (m : ℕ) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)) (K : Set (Euclid (m + 1))) (δ ε : ℝ), (∀ y, ‖ν y‖ = 1) → IsCompact K → 0 < δ → 0 ≤ ε → (1 + 16 ^ m) * ε < 1 → (∀ x ∈ K, ∀ ρ : ℝ, 0 < ρ → ρ < δ → ENNReal.ofReal (1 - ε) * unitBallVolume m * ENNReal.ofReal (ρ ^ m) ≤ μ (closedBall x ρ)) → (∀ x ∈ K, ∀ ρ : ℝ, 0 < ρ → ρ < δ → μ ({z | (1 / 4 : ℝ) * ‖z - x‖ ≤ |inner ℝ (z - x) (ν x)|} ∩ closedBall x ρ) ≤ ENNReal.ofReal ε * unitBallVolume m * ENNReal.ofReal (ρ ^ m)) → ∃ Γ : Set (Euclid (m + 1)), IsClosed Γ ∧ CountablyRectifiable m Γ ∧ K ⊆ Γ := by
  intro m μ ν K δ ε hν1 hK hδ hε0 hε1 hlow hup
  -- step 1: a finite `1/16`-net `V` of the unit sphere
  obtain ⟨V, hVs, hVfin, hVcov⟩ :=
    (isCompact_sphere (0 : Euclid (m + 1)) 1).finite_cover_balls (e := 1 / 16) (by norm_num)
  -- step 2: a finite `δ/4`-net `C ⊆ K` of `K`
  obtain ⟨C, -, hCfin, hCcov⟩ := hK.finite_cover_balls (e := δ / 4) (by positivity)
  -- step 3: on `S_{v,c}` the cone condition holds in direction `v`, so `S_{v,c}` lies in a closed
  -- countably `m`-rectifiable `Γ_{v,c}`
  have hS : ∀ v ∈ V, ∀ c ∈ C, ∃ Γ : Set (Euclid (m + 1)), IsClosed Γ ∧ CountablyRectifiable m Γ ∧
      {x | x ∈ K ∧ dist (ν x) v < 1 / 16} ∩ ball c (δ / 4) ⊆ Γ := by
    intro v hv c _
    have hv1 : ‖v‖ = 1 := by simpa using hVs hv
    apply Submission.codim1_rdo_dg_rc_closed_graph_cover m v _ hv1
    rintro x ⟨⟨hxK, hxv⟩, hxc⟩ x' ⟨⟨hx'K, -⟩, hx'c⟩
    apply Submission.codim1_rdo_dg_rc_cone_exclusion m μ ν K δ ε hν1 hε0 hε1 hlow hup
      x hxK x' hx'K v
    · rw [← dist_eq_norm]
      exact hxv.le
    · calc ‖x' - x‖ = dist x' x := (dist_eq_norm _ _).symm
        _ ≤ dist x' c + dist c x := dist_triangle _ _ _
        _ < δ / 4 + δ / 4 := add_lt_add (mem_ball.1 hx'c) (mem_ball'.1 hxc)
        _ = δ / 2 := by ring
  choose! Γ hΓc hΓr hΓS using hS
  -- step 4: `⋃_{v,c} Γ_{v,c}` is closed (a finite union) and countably `m`-rectifiable (a
  -- countable union)
  refine ⟨⋃ v ∈ V, ⋃ c ∈ C, Γ v c, ?_, ?_, ?_⟩
  · exact hVfin.isClosed_biUnion fun v hv => hCfin.isClosed_biUnion fun c hc => hΓc v hv c hc
  · rw [← sUnion_image2 Γ V C]
    exact Poincare.SimonGMT.Chapter03.countablyRectifiable_sUnion
      (hVfin.image2 Γ hCfin).countable (forall_mem_image2.2 hΓr)
  -- step 5: `x ∈ K` lies in `S_{v,c}` for a `v ∈ V` with `|ν(x) − v| < 1/16` and a `c ∈ C` with
  -- `x ∈ B_{δ/4}(c)`
  · intro x hxK
    have hνx : ν x ∈ sphere (0 : Euclid (m + 1)) 1 := by simpa using hν1 x
    obtain ⟨v, hv, hxv⟩ := mem_iUnion₂.1 (hVcov hνx)
    obtain ⟨c, hc, hxc⟩ := mem_iUnion₂.1 (hCcov hxK)
    exact mem_iUnion₂.2 ⟨v, hv, mem_iUnion₂.2 ⟨c, hc, hΓS v hv c hc ⟨⟨hxK, mem_ball.1 hxv⟩, hxc⟩⟩⟩

/-- **Halving step (★)** of Simon Ch. 3, proof of Theorem 1.6 "⇐":
`μ(ℝ^{n+ℓ} \ ⋃ⱼ Qⱼ(graph fⱼ)) ≤ ½ μ(ℝ^{n+ℓ})`, obtained there from (4) and (8).  If `Ū` is a
compact subset of `D`, then `λ = μ⌞U` is finite and, since `λ = μ` on closed balls inside the open
set `U`, inherits the a.e. density and cone limits.  `codim1_rdo_dg_rc_uniform_compact` with
`ε = 1/(2(1 + 16ᵐ))` and `η = μ(U)/2` gives a compact `K` with `λ(Kᶜ) ≤ μ(U)/2` and uniform bounds
on `K`, and `codim1_rdo_dg_rc_compact_cover` gives a closed countably `m`-rectifiable `Γ ⊇ K`; then
`μ(U \ Γ) = λ(U \ Γ) ≤ λ(Kᶜ) ≤ μ(U)/2`. -/
theorem Submission.codim1_rdo_dg_rc_halving_step : ∀ (m : ℕ) (D : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)), (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μ K ≠ ∞) → Measurable ν → (∀ y, ‖ν y‖ = 1) → (∀ᵐ y ∂μ, Tendsto (fun r : ℝ => μ (closedBall y r) / (unitBallVolume m * ENNReal.ofReal (r ^ m))) (𝓝[>] 0) (𝓝 1) ∧ Tendsto (fun r : ℝ => μ ({z | (1 / 4 : ℝ) * ‖z - y‖ ≤ |inner ℝ (z - y) (ν y)|} ∩ closedBall y r) / ENNReal.ofReal (r ^ m)) (𝓝[>] 0) (𝓝 0)) → ∀ U : Set (Euclid (m + 1)), IsOpen U → IsCompact (closure U) → closure U ⊆ D → ∃ Γ : Set (Euclid (m + 1)), IsClosed Γ ∧ CountablyRectifiable m Γ ∧ μ (U \ Γ) ≤ μ U / 2 := by
  intro m D μ ν hfin hν hν1 hae U hU hUc hUD
  -- step 1: `μ(U) ≤ μ(Ū) < ∞`; if `μ(U) = 0`, then `Γ = ∅` works
  have hUfin : μ U ≠ ∞ := ne_top_of_le_ne_top (hfin _ hUc hUD) (measure_mono subset_closure)
  by_cases h0 : μ U = 0
  · refine ⟨∅, isClosed_empty,
      Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero (by simp), ?_⟩
    simp [h0]
  -- step 2: `λ = μ⌞U` is finite and has the same limits as `μ` at every `y ∈ U`, because the two
  -- functions of `r` agree for `0 < r < r_y`, where `B_{r_y}(y) ⊆ U`
  set lam := μ.restrict U with hlam
  have : IsFiniteMeasure lam := isFiniteMeasure_restrict.2 hUfin
  have haeL : ∀ᵐ y ∂lam,
      Tendsto (fun r : ℝ => lam (closedBall y r) / (unitBallVolume m * ENNReal.ofReal (r ^ m)))
        (𝓝[>] 0) (𝓝 1) ∧
      Tendsto (fun r : ℝ => lam ({z | (1 / 4 : ℝ) * ‖z - y‖ ≤ |inner ℝ (z - y) (ν y)|} ∩
        closedBall y r) / ENNReal.ofReal (r ^ m)) (𝓝[>] 0) (𝓝 0) := by
    filter_upwards [ae_restrict_mem hU.measurableSet, ae_restrict_of_ae hae] with y hyU hy
    obtain ⟨h1, h2⟩ := hy
    obtain ⟨r, hr, hrU⟩ := Metric.isOpen_iff.1 hU y hyU
    have hev : ∀ᶠ s in 𝓝[>] (0 : ℝ), s < r := by
      filter_upwards [Ioo_mem_nhdsGT hr] with s hs using hs.2
    constructor
    · refine h1.congr' ?_
      filter_upwards [hev] with s hs
      rw [hlam, Measure.restrict_apply' hU.measurableSet,
        inter_eq_left.2 ((closedBall_subset_ball hs).trans hrU)]
    · refine h2.congr' ?_
      filter_upwards [hev] with s hs
      rw [hlam, Measure.restrict_apply' hU.measurableSet,
        inter_eq_left.2 (inter_subset_right.trans ((closedBall_subset_ball hs).trans hrU))]
  -- step 3: `ε = 1/(2(1 + 16ᵐ)) > 0` with `(1 + 16ᵐ)ε = 1/2 < 1`, and `η = μ(U)/2 > 0`
  set ε : ℝ := 1 / (2 * (1 + 16 ^ m)) with hε
  have hεpos : 0 < ε := by positivity
  have hε1 : (1 + 16 ^ m) * ε < 1 := by
    have : (0 : ℝ) < 1 + 16 ^ m := by positivity
    rw [hε, mul_one_div, div_lt_one (by positivity)]
    linarith
  -- step 4: a compact `K` with `λ(Kᶜ) ≤ η` on which the density and cone bounds are uniform
  obtain ⟨K, δ, hK, hδ, hKc, hlow, hup⟩ := Submission.codim1_rdo_dg_rc_uniform_compact m lam ν ε
    (μ U / 2) inferInstance hν hεpos (ENNReal.half_pos h0) haeL
  -- step 5: a closed countably `m`-rectifiable `Γ ⊇ K`
  obtain ⟨Γ, hΓc, hΓr, hKΓ⟩ :=
    Submission.codim1_rdo_dg_rc_compact_cover m lam ν K δ ε hν1 hK hδ hεpos.le hε1 hlow hup
  -- step 6: `μ(U \ Γ) = λ(U \ Γ) ≤ λ(Kᶜ) ≤ μ(U)/2`, as `U \ Γ ⊆ U` and `U \ Γ ⊆ Kᶜ`
  refine ⟨Γ, hΓc, hΓr, ?_⟩
  calc μ (U \ Γ) = lam (U \ Γ) := by
        rw [hlam, Measure.restrict_apply' hU.measurableSet, inter_eq_left.2 sdiff_subset]
    _ ≤ lam Kᶜ := measure_mono fun x hx hxK => hx.2 (hKΓ hxK)
    _ ≤ μ U / 2 := hKc
/-- Iterated halving on a countable ball cover (Simon Ch. 3, proof of 1.6 "⇐", final iteration):
let `D ⊆ ℝ^{m+1}` be open, `μ(ℝ^{m+1} \ D) = 0` and `μ(K) < ∞` for compact `K ⊆ D`.  If every
open `U` with compact closure `Ū ⊆ D` has a closed countably `m`-rectifiable `Γ` with
`μ(U \ Γ) ≤ μ(U)/2`, then `μ` is carried by a Borel countably `m`-rectifiable set `R`.
For an open `W` with compact closure in `D`, applying the hypothesis to `W \ Γᵢ` gives closed
countably `m`-rectifiable sets `Γᵢ` with `μ(W \ Γᵢ) ≤ 2⁻ⁱ μ(W)`, so `μ(W \ ⋃ᵢ Γᵢ) = 0`; `D` is
covered by countably many balls `B_{r/2}(x)` with `B_r(x) ⊆ D` (Lindelöf), and `R` is the union
of the corresponding sets `⋃ᵢ Γᵢ`. -/
theorem Submission.codim1_rdo_dg_rc_of_halving : ∀ (m : ℕ) (D : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))), IsOpen D → μ Dᶜ = 0 → (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μ K ≠ ∞) → (∀ U : Set (Euclid (m + 1)), IsOpen U → IsCompact (closure U) → closure U ⊆ D → ∃ Γ : Set (Euclid (m + 1)), IsClosed Γ ∧ CountablyRectifiable m Γ ∧ μ (U \ Γ) ≤ μ U / 2) → ∃ R : Set (Euclid (m + 1)), MeasurableSet R ∧ CountablyRectifiable m R ∧ μ Rᶜ = 0 := by
  intro m D μ hDo hDc hfin hhalf
  -- Steps 2–3: on an open set `W` with compact closure in `D`, iterate the halving hypothesis.
  have key : ∀ W : Set (Euclid (m + 1)), IsOpen W → IsCompact (closure W) → closure W ⊆ D →
      ∃ R' : Set (Euclid (m + 1)), MeasurableSet R' ∧ CountablyRectifiable m R' ∧
        μ (W \ R') = 0 := by
    intro W hWo hWc hWD
    have hWfin : μ W ≠ ∞ := ne_top_of_le_ne_top (hfin _ hWc hWD) (measure_mono subset_closure)
    have step : ∀ i : ℕ, ∃ Γ : Set (Euclid (m + 1)), IsClosed Γ ∧ CountablyRectifiable m Γ ∧
        μ (W \ Γ) ≤ μ W * (2⁻¹ : ℝ≥0∞) ^ i := by
      intro i
      induction i with
      | zero =>
        refine ⟨∅, isClosed_empty,
          Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty, ?_⟩
        simp
      | succ i ih =>
        obtain ⟨Γ, hΓc, hΓr, hΓμ⟩ := ih
        have hUo : IsOpen (W \ Γ) := hWo.sdiff hΓc
        have hUcl : closure (W \ Γ) ⊆ closure W := closure_mono sdiff_subset
        obtain ⟨Γ', hΓ'c, hΓ'r, hΓ'μ⟩ :=
          hhalf (W \ Γ) hUo (hWc.of_isClosed_subset isClosed_closure hUcl) (hUcl.trans hWD)
        refine ⟨Γ ∪ Γ', hΓc.union hΓ'c, ?_, ?_⟩
        · rw [← sUnion_pair]
          refine Poincare.SimonGMT.Chapter03.countablyRectifiable_sUnion
            (Set.toFinite _).countable ?_
          rintro S (rfl | rfl)
          · exact hΓr
          · exact hΓ'r
        · rw [← Set.sdiff_sdiff]
          calc μ ((W \ Γ) \ Γ') ≤ μ (W \ Γ) / 2 := hΓ'μ
            _ = μ (W \ Γ) * 2⁻¹ := div_eq_mul_inv _ _
            _ ≤ μ W * (2⁻¹ : ℝ≥0∞) ^ i * 2⁻¹ := by gcongr
            _ = μ W * (2⁻¹ : ℝ≥0∞) ^ (i + 1) := by rw [pow_succ, mul_assoc]
    choose Γ hΓc hΓr hΓμ using step
    refine ⟨⋃ i, Γ i, MeasurableSet.iUnion (fun i => (hΓc i).measurableSet),
      Poincare.SimonGMT.Chapter03.countablyRectifiable_iUnion Γ hΓr, ?_⟩
    have hlim : Tendsto (fun i : ℕ => μ W * (2⁻¹ : ℝ≥0∞) ^ i) atTop (𝓝 0) := by
      have h1 : Tendsto (fun i : ℕ => (2⁻¹ : ℝ≥0∞) ^ i) atTop (𝓝 0) :=
        ENNReal.tendsto_pow_atTop_nhds_zero_of_lt_one ENNReal.one_half_lt_one
      simpa using ENNReal.Tendsto.const_mul h1 (Or.inr hWfin)
    refine nonpos_iff_eq_zero.1 ?_
    refine ge_of_tendsto' hlim (fun i => ?_)
    exact (measure_mono (sdiff_subset_sdiff_right (subset_iUnion Γ i))).trans (hΓμ i)
  -- Step 1: a countable cover of `D` by balls with compact closure inside `D`.
  have hr : ∀ x : Euclid (m + 1), ∃ r : ℝ, 0 < r ∧ (x ∈ D → ball x r ⊆ D) := by
    intro x
    by_cases hx : x ∈ D
    · obtain ⟨r, hr0, hrD⟩ := Metric.isOpen_iff.1 hDo x hx
      exact ⟨r, hr0, fun _ => hrD⟩
    · exact ⟨1, one_pos, fun h => absurd h hx⟩
  choose r hr0 hrD using hr
  let W : Euclid (m + 1) → Set (Euclid (m + 1)) := fun x => ball x (r x / 2)
  have hWcl : ∀ x ∈ D, closure (W x) ⊆ D := fun x hx =>
    closure_ball_subset_closedBall.trans
      ((closedBall_subset_ball (half_lt_self (hr0 x))).trans (hrD x hx))
  have hWcpt : ∀ x, IsCompact (closure (W x)) := fun x =>
    (isCompact_closedBall x (r x / 2)).of_isClosed_subset isClosed_closure
      closure_ball_subset_closedBall
  have hR : ∀ x : Euclid (m + 1), ∃ R' : Set (Euclid (m + 1)), MeasurableSet R' ∧
      CountablyRectifiable m R' ∧ (x ∈ D → μ (W x \ R') = 0) := by
    intro x
    by_cases hx : x ∈ D
    · obtain ⟨R', h1, h2, h3⟩ := key (W x) isOpen_ball (hWcpt x) (hWcl x hx)
      exact ⟨R', h1, h2, fun _ => h3⟩
    · exact ⟨∅, MeasurableSet.empty,
        Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty,
        fun h => absurd h hx⟩
  choose Rx hRxm hRxr hRxμ using hR
  obtain ⟨T, hTD, hTc, hTU⟩ :=
    TopologicalSpace.isOpen_biUnion_countable D W (fun x _ => isOpen_ball)
  have hDcov : D ⊆ ⋃ x ∈ T, W x := by
    rw [hTU]
    intro y hy
    exact mem_biUnion hy (mem_ball_self (half_pos (hr0 y)))
  -- Step 4: glue.
  refine ⟨⋃ x ∈ T, Rx x, MeasurableSet.biUnion hTc (fun x _ => hRxm x), ?_, ?_⟩
  · rw [← sUnion_image]
    exact Poincare.SimonGMT.Chapter03.countablyRectifiable_sUnion (hTc.image Rx)
      (by rintro S ⟨x, -, rfl⟩; exact hRxr x)
  · have hsub : (⋃ x ∈ T, Rx x)ᶜ ⊆ Dᶜ ∪ ⋃ x ∈ T, (W x \ Rx x) := by
      intro y hy
      by_cases hyD : y ∈ D
      · right
        obtain ⟨x, hxT, hyW⟩ := mem_iUnion₂.1 (hDcov hyD)
        exact mem_iUnion₂.2 ⟨x, hxT, hyW, fun hyR => hy (mem_iUnion₂.2 ⟨x, hxT, hyR⟩)⟩
      · exact Or.inl hyD
    refine measure_mono_null hsub (measure_union_null hDc ?_)
    exact (measure_biUnion_null_iff hTc).2 (fun x hx => hRxμ x (hTD hx))
/-- **`Hᵐ` of a ball in an `m`-dimensional subspace** (Simon Ch. 3, Remark 1.5(3): `Hᵐ` on an
`m`-plane is `m`-dimensional Lebesgue measure): if `Q ⊆ ℝᴺ` is a linear subspace with
`dim Q = m` and `s > 0`, then `Hᵐ(Q ∩ B_s(0)) = ωₘsᵐ`.  An orthonormal basis of `Q` gives a
linear isometry `ι : ℝᵐ → ℝᴺ` with `ι(B_s(0)) = Q ∩ B_s(0)`; `μHE[m]` is preserved by isometries
and equals `volume` on `ℝᵐ`, where `volume (B_s(0)) = sᵐωₘ`. -/
theorem Submission.codim1_rdo_dg_ftd_plane_ball_measure : ∀ (N m : ℕ) (Q : Submodule ℝ (Euclid N)), Module.finrank ℝ Q = m → ∀ s : ℝ, 0 < s → μHE[m] ((Q : Set (Euclid N)) ∩ ball 0 s) = unitBallVolume m * ENNReal.ofReal (s ^ m) := by
  intro N m Q hm s hs
  -- Step 1: the coordinates of an orthonormal basis of `Q` indexed by `Fin m` give
  -- `e : Q ≃ₗᵢ ℝᵐ`, and `ι = e⁻¹` followed by `Q ↪ ℝᴺ` is a linear isometry with values in `Q`
  let e : Q ≃ₗᵢ[ℝ] Euclid m := ((stdOrthonormalBasis ℝ Q).reindex (finCongr hm)).repr
  let ι : Euclid m →ₗᵢ[ℝ] Euclid N := Q.subtypeₗᵢ.comp e.symm.toLinearIsometry
  have hι : ∀ a, ι a = (e.symm a : Euclid N) := fun a => rfl
  -- Step 2: `ι(B_s(0)) = Q ∩ B_s(0)`
  have himage : ι '' ball 0 s = (Q : Set (Euclid N)) ∩ ball 0 s := by
    ext z
    constructor
    · rintro ⟨a, ha, rfl⟩
      refine ⟨by rw [hι]; exact (e.symm a).2, ?_⟩
      rw [mem_ball_zero_iff] at ha ⊢
      rwa [LinearIsometry.norm_map]
    · rintro ⟨hz, hzs⟩
      refine ⟨e ⟨z, hz⟩, ?_, by rw [hι, LinearIsometryEquiv.symm_apply_apply]⟩
      rw [mem_ball_zero_iff] at hzs ⊢
      rwa [LinearIsometryEquiv.norm_map]
  -- Steps 3–5: isometry invariance of `μHE[m]`, `μHE[m] = volume` on `ℝᵐ`, Haar scaling of balls
  rw [← himage, ι.isometry.euclideanHausdorffMeasure_image,
    EuclideanSpace.euclideanHausdorffMeasure_eq_volume,
    Measure.addHaar_ball_of_pos (volume : Measure (Euclid m)) 0 hs, finrank_euclideanSpace_fin,
    unitBallVolume]
  -- Step 6: commute the product
  exact mul_comm _ _
/-- **Markov bound for rescaled measures** (the measure-theoretic half of the flat-tangent
density estimate): if `f ≥ 0` is continuous with compact support, `f ≥ 1` on `A`,
`μ(B̄_{r₀}(y)) < ∞`, and `r⁻ᵐ ∫ f(r⁻¹(z − y)) dμ(z) → L < L'` as `r ↓ 0`, then
`μ{z : r⁻¹(z − y) ∈ A} ≤ L' rᵐ` for all small `r > 0`.  Once `r R' < r₀`, where `f = 0` off
`B̄_{R'}(0)`, the rescaled integrand is bounded and vanishes off `B̄_{r₀}(y)`, hence integrable,
and Markov's inequality at level `1` bounds the (possibly non-measurable) set by its integral. -/
theorem Submission.codim1_rdo_dg_ftd_test_upper_bound : ∀ (N m : ℕ) (μ : Measure (Euclid N)) (y : Euclid N) (f : Euclid N → ℝ) (A : Set (Euclid N)) (L L' : ℝ), (∃ r₀ : ℝ, 0 < r₀ ∧ μ (closedBall y r₀) ≠ ∞) → Continuous f → HasCompactSupport f → (∀ w, 0 ≤ f w) → (∀ w ∈ A, 1 ≤ f w) → Tendsto (fun r : ℝ => (r ^ m)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) ∂μ) (𝓝[>] 0) (𝓝 L) → L < L' → ∀ᶠ r in 𝓝[>] (0 : ℝ), μ {z | r⁻¹ • (z - y) ∈ A} ≤ ENNReal.ofReal (L' * r ^ m) := by
  intro N m μ y f A L L' ⟨r₀, hr₀, hfin⟩ hf hfc hf0 hA hlim hLL'
  -- a radius `R' > 0` outside of which `f` vanishes, and a bound `‖f‖ ≤ C`
  obtain ⟨R, hR⟩ := hfc.isCompact.isBounded.subset_closedBall 0
  obtain ⟨R', hR'pos, hzero⟩ : ∃ R' : ℝ, 0 < R' ∧ ∀ w : Euclid N, R' < ‖w‖ → f w = 0 := by
    refine ⟨max R 1, lt_max_of_lt_right one_pos, fun w hw => ?_⟩
    refine image_eq_zero_of_notMem_tsupport fun hws => ?_
    have hwR := hR hws
    rw [mem_closedBall, dist_zero_right] at hwR
    linarith [le_max_left R 1]
  obtain ⟨C, hC⟩ := hf.bounded_above_of_compact_support hfc
  -- eventually `r < r₀ / R'` and the rescaled integral is `< L'`
  filter_upwards [hlim (Iio_mem_nhds hLL'), Ioo_mem_nhdsGT (div_pos hr₀ hR'pos)] with r hrL hr
  have hr0 : 0 < r := hr.1
  have hrR : r * R' < r₀ := (lt_div_iff₀ hR'pos).mp hr.2
  -- `z ↦ f (r⁻¹ • (z - y))` is continuous, bounded, and vanishes off `closedBall y r₀`
  have hgc : Continuous fun z => f (r⁻¹ • (z - y)) :=
    hf.comp ((continuous_id.sub continuous_const).const_smul r⁻¹)
  have hgint : Integrable (fun z => f (r⁻¹ • (z - y))) μ := by
    have hball : IntegrableOn (fun z => f (r⁻¹ • (z - y))) (closedBall y r₀) μ :=
      Measure.integrableOn_of_bounded (M := C) hfin hgc.aestronglyMeasurable
        (Eventually.of_forall fun z => hC _)
    refine integrableOn_univ.mp (hball.of_forall_sdiff_eq_zero MeasurableSet.univ fun z hz => ?_)
    have hz' : r₀ < ‖z - y‖ := by
      have hz2 := hz.2
      rwa [mem_closedBall, dist_eq_norm, not_le] at hz2
    apply hzero
    rw [norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hr0, lt_inv_mul_iff₀ hr0]
    linarith
  -- Markov's inequality at level `1`
  have hmarkov : μ {z | r⁻¹ • (z - y) ∈ A} ≤ ENNReal.ofReal (∫ z, f (r⁻¹ • (z - y)) ∂μ) := by
    rw [ofReal_integral_eq_lintegral_ofReal hgint (Eventually.of_forall fun z => hf0 _)]
    calc μ {z | r⁻¹ • (z - y) ∈ A}
        ≤ μ {z | 1 ≤ ENNReal.ofReal (f (r⁻¹ • (z - y)))} :=
          measure_mono fun z hz => ENNReal.one_le_ofReal.mpr (hA _ hz)
      _ = 1 * μ {z | 1 ≤ ENNReal.ofReal (f (r⁻¹ • (z - y)))} := (one_mul _).symm
      _ ≤ ∫⁻ z, ENNReal.ofReal (f (r⁻¹ • (z - y))) ∂μ :=
          mul_meas_ge_le_lintegral₀ hgc.measurable.ennreal_ofReal.aemeasurable 1
  refine hmarkov.trans (ENNReal.ofReal_le_ofReal ?_)
  have hint := (inv_mul_lt_iff₀ (pow_pos hr0 m)).mp hrL
  rw [mul_comm L']
  exact hint.le
/-- **Lower bound for rescaled measures from a test function** (the lower half of the
flat-tangent density estimate): if `f` is continuous, `0 ≤ f ≤ 1`, `f = 0` off `A`, and
`r⁻ᵐ ∫ f(r⁻¹(z − y)) dμ(z) → L > L'` as `r ↓ 0`, then `L' rᵐ ≤ μ{z : r⁻¹(z − y) ∈ A}` for all
small `r > 0`.  The rescaled integrand is dominated by the indicator of the (possibly
non-measurable) set, and a non-integrable integrand has Bochner integral `0`. -/
theorem Submission.codim1_rdo_dg_ftd_test_lower_bound : ∀ (N m : ℕ) (μ : Measure (Euclid N)) (y : Euclid N) (f : Euclid N → ℝ) (A : Set (Euclid N)) (L L' : ℝ), Continuous f → (∀ w, 0 ≤ f w) → (∀ w, f w ≤ 1) → (∀ w, w ∉ A → f w = 0) → Tendsto (fun r : ℝ => (r ^ m)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) ∂μ) (𝓝[>] 0) (𝓝 L) → L' < L → ∀ᶠ r in 𝓝[>] (0 : ℝ), ENNReal.ofReal (L' * r ^ m) ≤ μ {z | r⁻¹ • (z - y) ∈ A} := by
  intro N m μ y f A L L' hf hf0 hf1 hfA hlim hLL'
  -- eventually `r > 0` and the rescaled integral exceeds `L'`
  filter_upwards [hlim (Ioi_mem_nhds hLL'), self_mem_nhdsWithin] with r hrL hr
  have hint : L' * r ^ m < ∫ z, f (r⁻¹ • (z - y)) ∂μ :=
    (lt_inv_mul_iff₀' (pow_pos hr m)).mp hrL
  -- `ofReal (∫ g) ≤ ∫⁻ ofReal g`: equality if `g` is integrable, otherwise `∫ g = 0`
  have hlint : ENNReal.ofReal (∫ z, f (r⁻¹ • (z - y)) ∂μ) ≤
      ∫⁻ z, ENNReal.ofReal (f (r⁻¹ • (z - y))) ∂μ := by
    by_cases hg : Integrable (fun z => f (r⁻¹ • (z - y))) μ
    · exact (ofReal_integral_eq_lintegral_ofReal hg (Eventually.of_forall fun z => hf0 _)).le
    · rw [integral_undef hg, ENNReal.ofReal_zero]
      exact zero_le
  -- `ofReal g ≤ 1_{S_r}` pointwise, and `∫⁻ 1_{S_r} dμ ≤ μ S_r` for any set `S_r`
  have hind : ∫⁻ z, ENNReal.ofReal (f (r⁻¹ • (z - y))) ∂μ ≤
      ∫⁻ z, {z | r⁻¹ • (z - y) ∈ A}.indicator 1 z ∂μ := by
    refine lintegral_mono fun z => ?_
    show ENNReal.ofReal (f (r⁻¹ • (z - y))) ≤ {z | r⁻¹ • (z - y) ∈ A}.indicator 1 z
    by_cases hz : r⁻¹ • (z - y) ∈ A
    · rw [indicator_of_mem (show z ∈ {z | r⁻¹ • (z - y) ∈ A} from hz), Pi.one_apply]
      exact ENNReal.ofReal_le_one.mpr (hf1 _)
    · rw [hfA _ hz, ENNReal.ofReal_zero]
      exact zero_le
  exact (ENNReal.ofReal_le_ofReal hint.le).trans
    (hlint.trans (hind.trans (lintegral_indicator_one_le _)))

/-- **Ball densities of a measure with a flat tangent measure** (Simon Ch. 3, Remark 1.5(3),
first assertion, for `μ` in place of `Hⁿ⌞M`): if `P = v^⊥` (`‖v‖ = 1`), `μ(B̄_{r₀}(y)) < ∞`
and `r⁻ᵐ ∫ f(r⁻¹(z − y)) dμ(z) → ∫_P f dHᵐ` as `r ↓ 0` for every continuous compactly
supported `f`, then `μ(B̄_r(y))/(ωₘrᵐ) → 1` and `μ(B_r(y))/(ωₘrᵐ) → 1`.  Since
`Hᵐ(P ∩ B_s(0)) = ωₘsᵐ`, the radial cutoffs `f₊ = 1` on `B̄₁(0)`, `= 0` off `B_{1+ε}(0)`, and
`f₋ = 1` on `B̄_{1−ε}(0)`, `= 0` off `B₁(0)`, have `∫_P f₊ ≤ ωₘ(1 + ε)ᵐ` and
`∫_P f₋ ≥ ωₘ(1 − ε)ᵐ`; the Markov-type bounds for rescaled measures then give
`ωₘcrᵐ ≤ μ(B_r(y)) ≤ μ(B̄_r(y)) ≤ ωₘCrᵐ` for small `r > 0`, for any `c < 1 < C`. -/
theorem Submission.codim1_rdo_dg_ftd_ball_density : ∀ (m : ℕ) (μ : Measure (Euclid (m + 1))) (y v : Euclid (m + 1)), 1 ≤ m → ‖v‖ = 1 → (∃ r₀ : ℝ, 0 < r₀ ∧ μ (closedBall y r₀) ≠ ∞) → (∀ f : Euclid (m + 1) → ℝ, Continuous f → HasCompactSupport f → Tendsto (fun r : ℝ => (r ^ m)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) ∂μ) (𝓝[>] 0) (𝓝 (∫ z in ((Submodule.span ℝ {v})ᗮ : Set (Euclid (m + 1))), f z ∂μHE[m]))) → Tendsto (fun r : ℝ => μ (closedBall y r) / (unitBallVolume m * ENNReal.ofReal (r ^ m))) (𝓝[>] 0) (𝓝 1) ∧ Tendsto (fun r : ℝ => μ (ball y r) / (unitBallVolume m * ENNReal.ofReal (r ^ m))) (𝓝[>] 0) (𝓝 1) := by
  intro m μ y v _hm hv hr₀ hlim
  -- Step 0(a): `P = v^⊥` is an `m`-dimensional subspace of `ℝ^{m+1}`
  have hv0 : v ≠ 0 := by
    rintro rfl
    rw [norm_zero] at hv
    exact zero_ne_one hv
  have : Fact (Module.finrank ℝ (Euclid (m + 1)) = m + 1) := ⟨finrank_euclideanSpace_fin⟩
  have hPdim : Module.finrank ℝ (Submodule.span ℝ {v})ᗮ = m :=
    Submodule.finrank_orthogonal_span_singleton hv0
  -- Step 0(b): `ωₘ = ofReal ω` with `ω > 0`
  have hω0 : unitBallVolume m ≠ 0 := by
    rw [unitBallVolume]
    exact (measure_ball_pos _ _ one_pos).ne'
  have hωtop : unitBallVolume m ≠ ∞ := by
    rw [unitBallVolume]
    exact measure_ball_lt_top.ne
  obtain ⟨ω, hωpos, hωeq⟩ : ∃ ω : ℝ, 0 < ω ∧ unitBallVolume m = ENNReal.ofReal ω :=
    ⟨(unitBallVolume m).toReal, ENNReal.toReal_pos hω0 hωtop, (ENNReal.ofReal_toReal hωtop).symm⟩
  -- Step 0(c): `ν = Hᵐ⌞P` gives `B_s(0)` the measure `ω sᵐ`
  set ν : Measure (Euclid (m + 1)) :=
    μHE[m].restrict ((Submodule.span ℝ {v})ᗮ : Set (Euclid (m + 1))) with hν
  have hνball : ∀ s : ℝ, 0 < s → ν (ball 0 s) = ENNReal.ofReal (ω * s ^ m) := by
    intro s hs
    rw [hν, Measure.restrict_apply measurableSet_ball, inter_comm,
      Submission.codim1_rdo_dg_ftd_plane_ball_measure (m + 1) m _ hPdim s hs, hωeq,
      ENNReal.ofReal_mul hωpos.le]
  have hνint : ∀ s : ℝ, 0 < s →
      Integrable ((ball (0 : Euclid (m + 1)) s).indicator fun _ => (1 : ℝ)) ν := by
    intro s hs
    have hfin : ν (ball 0 s) ≠ ∞ := by
      rw [hνball s hs]
      exact ENNReal.ofReal_ne_top
    exact (integrableOn_const hfin).integrable_indicator measurableSet_ball
  have hνind : ∀ s : ℝ, 0 < s →
      ∫ w, (ball (0 : Euclid (m + 1)) s).indicator (fun _ => (1 : ℝ)) w ∂ν = ω * s ^ m := by
    intro s hs
    rw [integral_indicator_const _ measurableSet_ball, measureReal_def, hνball s hs,
      ENNReal.toReal_ofReal (mul_pos hωpos (pow_pos hs m)).le, smul_eq_mul, mul_one]
  -- Step 1: comparison of `I(g) = ∫_P g dHᵐ` with plane balls
  have hle_ind : ∀ (b : ℝ) (g : Euclid (m + 1) → ℝ), (∀ w, g w ≤ 1) →
      (∀ w, b ≤ ‖w‖ → g w = 0) →
      ∀ w, g w ≤ (ball (0 : Euclid (m + 1)) b).indicator (fun _ => (1 : ℝ)) w := by
    intro b g hg1 hgb w
    by_cases hw : w ∈ ball (0 : Euclid (m + 1)) b
    · rw [indicator_of_mem hw]
      exact hg1 w
    · rw [indicator_of_notMem hw, hgb w (not_lt.mp fun h => hw (mem_ball_zero_iff.mpr h))]
  have hgint : ∀ (b : ℝ) (g : Euclid (m + 1) → ℝ), 0 < b → Continuous g → (∀ w, 0 ≤ g w) →
      (∀ w, g w ≤ 1) → (∀ w, b ≤ ‖w‖ → g w = 0) → Integrable g ν := by
    intro b g hb hg hg0 hg1 hgb
    refine (hνint b hb).mono' hg.aestronglyMeasurable (Eventually.of_forall fun w => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (hg0 w)]
    exact hle_ind b g hg1 hgb w
  -- (U) `I(g) ≤ ω bᵐ` if `0 ≤ g ≤ 1` vanishes off `B_b(0)`
  have hplane_le : ∀ (b : ℝ) (g : Euclid (m + 1) → ℝ), 0 < b → Continuous g →
      (∀ w, 0 ≤ g w) → (∀ w, g w ≤ 1) → (∀ w, b ≤ ‖w‖ → g w = 0) →
      ∫ w, g w ∂ν ≤ ω * b ^ m := fun b g hb hg hg0 hg1 hgb =>
    (integral_mono (hgint b g hb hg hg0 hg1 hgb) (hνint b hb) (hle_ind b g hg1 hgb)).trans_eq
      (hνind b hb)
  -- (L) `ω aᵐ ≤ I(g)` if moreover `g ≥ 1` on `B_a(0)`
  have hplane_ge : ∀ (a b : ℝ) (g : Euclid (m + 1) → ℝ), 0 < a → 0 < b → Continuous g →
      (∀ w, 0 ≤ g w) → (∀ w, g w ≤ 1) → (∀ w, ‖w‖ < a → 1 ≤ g w) →
      (∀ w, b ≤ ‖w‖ → g w = 0) → ω * a ^ m ≤ ∫ w, g w ∂ν := by
    intro a b g ha hb hg hg0 hg1 hga hgb
    refine (hνind a ha).symm.trans_le
      (integral_mono (hνint a ha) (hgint b g hb hg hg0 hg1 hgb) fun w => ?_)
    by_cases hw : w ∈ ball (0 : Euclid (m + 1)) a
    · rw [indicator_of_mem hw]
      exact hga w (mem_ball_zero_iff.mp hw)
    · rw [indicator_of_notMem hw]
      exact hg0 w
  -- Step 2: the radial cutoff `g_{a,b} = min 1 (max 0 ((b − ‖w‖)/(b − a)))`
  have hcut : ∀ a b : ℝ, a < b → ∃ g : Euclid (m + 1) → ℝ, Continuous g ∧ HasCompactSupport g ∧
      (∀ w, 0 ≤ g w) ∧ (∀ w, g w ≤ 1) ∧ (∀ w, ‖w‖ ≤ a → g w = 1) ∧
      (∀ w, b ≤ ‖w‖ → g w = 0) := by
    intro a b hab
    have hba : 0 < b - a := sub_pos.mpr hab
    have hzero : ∀ w : Euclid (m + 1), b ≤ ‖w‖ → min 1 (max 0 ((b - ‖w‖) / (b - a))) = 0 := by
      intro w hw
      rw [max_eq_left (div_nonpos_of_nonpos_of_nonneg (by linarith) hba.le),
        min_eq_right zero_le_one]
    refine ⟨fun w => min 1 (max 0 ((b - ‖w‖) / (b - a))), by fun_prop, ?_,
      fun w => le_min zero_le_one (le_max_left _ _), fun w => min_le_left _ _, fun w hw => ?_,
      hzero⟩
    · refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid (m + 1)) b)
        fun w hw => hzero w ?_
      rw [mem_closedBall_zero_iff, not_le] at hw
      exact hw.le
    · have h1 : 1 ≤ (b - ‖w‖) / (b - a) := by
        rw [le_div_iff₀ hba]
        linarith
      show min 1 (max 0 ((b - ‖w‖) / (b - a))) = 1
      rw [max_eq_right (zero_le_one.trans h1), min_eq_left h1]
  -- Step 3: `{z : r⁻¹(z − y) ∈ B̄₁(0)} = B̄_r(y)` and `{z : r⁻¹(z − y) ∈ B₁(0)} = B_r(y)`
  have hset_closed : ∀ r : ℝ, 0 < r →
      {z | r⁻¹ • (z - y) ∈ closedBall (0 : Euclid (m + 1)) 1} = closedBall y r := by
    intro r hr
    ext z
    change r⁻¹ • (z - y) ∈ closedBall (0 : Euclid (m + 1)) 1 ↔ z ∈ closedBall y r
    rw [mem_closedBall_zero_iff, mem_closedBall_iff_norm, norm_smul, Real.norm_eq_abs, abs_inv,
      abs_of_pos hr, inv_mul_le_iff₀ hr, mul_one]
  have hset_open : ∀ r : ℝ, 0 < r →
      {z | r⁻¹ • (z - y) ∈ ball (0 : Euclid (m + 1)) 1} = ball y r := by
    intro r hr
    ext z
    change r⁻¹ • (z - y) ∈ ball (0 : Euclid (m + 1)) 1 ↔ z ∈ ball y r
    rw [mem_ball_zero_iff, mem_ball_iff_norm, norm_smul, Real.norm_eq_abs, abs_inv,
      abs_of_pos hr, inv_mul_lt_iff₀ hr, mul_one]
  -- Step 4: for `C > 1`, eventually `μ(B̄_r(y)) ≤ ω C rᵐ` (test with `f₊ = g_{1,1+ε}`)
  have hupper : ∀ C : ℝ, 1 < C →
      ∀ᶠ r in 𝓝[>] (0 : ℝ), μ (closedBall y r) ≤ ENNReal.ofReal (ω * C * r ^ m) := by
    intro C hC
    have hcont : Continuous fun t : ℝ => (1 + t) ^ m := by fun_prop
    have hev : ∀ᶠ t in 𝓝[>] (0 : ℝ), (1 + t) ^ m < C :=
      ((hcont.tendsto' 0 1 (by simp)).eventually (gt_mem_nhds hC)).filter_mono
        nhdsWithin_le_nhds
    obtain ⟨ε, hεC, hε⟩ := (hev.and self_mem_nhdsWithin).exists
    have hε0 : (0 : ℝ) < ε := hε
    obtain ⟨g, hgc, hgcs, hg0, hg1, hgone, hgzero⟩ :=
      hcut 1 (1 + ε) (lt_add_of_pos_right 1 hε0)
    have hI : ∫ w, g w ∂ν < ω * C :=
      (hplane_le (1 + ε) g (by linarith) hgc hg0 hg1 hgzero).trans_lt
        (mul_lt_mul_of_pos_left hεC hωpos)
    filter_upwards [Submission.codim1_rdo_dg_ftd_test_upper_bound (m + 1) m μ y g
      (closedBall 0 1) _ (ω * C) hr₀ hgc hgcs hg0
      (fun w hw => (hgone w (mem_closedBall_zero_iff.mp hw)).ge) (hlim g hgc hgcs) hI,
      self_mem_nhdsWithin] with r hr hrpos
    rwa [hset_closed r hrpos] at hr
  -- Step 5: for `c < 1`, eventually `ω c rᵐ ≤ μ(B_r(y))` (test with `f₋ = g_{1−ε,1}`)
  have hlower : ∀ c : ℝ, c < 1 →
      ∀ᶠ r in 𝓝[>] (0 : ℝ), ENNReal.ofReal (ω * c * r ^ m) ≤ μ (ball y r) := by
    intro c hc
    have hcont : Continuous fun t : ℝ => (1 - t) ^ m := by fun_prop
    have hev : ∀ᶠ t in 𝓝[>] (0 : ℝ), c < (1 - t) ^ m :=
      ((hcont.tendsto' 0 1 (by simp)).eventually (lt_mem_nhds hc)).filter_mono
        nhdsWithin_le_nhds
    obtain ⟨ε, hεc, hε⟩ := (hev.and (Ioo_mem_nhdsGT one_pos)).exists
    have hε0 : (0 : ℝ) < ε := hε.1
    have hε1 : ε < 1 := hε.2
    obtain ⟨g, hgc, hgcs, hg0, hg1, hgone, hgzero⟩ := hcut (1 - ε) 1 (by linarith)
    have hI : ω * c < ∫ w, g w ∂ν :=
      (mul_lt_mul_of_pos_left hεc hωpos).trans_le
        (hplane_ge (1 - ε) 1 g (by linarith) one_pos hgc hg0 hg1
          (fun w hw => (hgone w hw.le).ge) hgzero)
    filter_upwards [Submission.codim1_rdo_dg_ftd_test_lower_bound (m + 1) m μ y g
      (ball 0 1) _ (ω * c) hgc hg0 hg1
      (fun w hw => hgzero w (not_lt.mp fun h => hw (mem_ball_zero_iff.mpr h)))
      (hlim g hgc hgcs) hI, self_mem_nhdsWithin] with r hr hrpos
    rwa [hset_open r hrpos] at hr
  -- Step 6: `ofReal (ω c rᵐ) / (ωₘ rᵐ) = ofReal c`
  have hratio : ∀ c : ℝ, 0 ≤ c → ∀ r : ℝ, 0 < r →
      ENNReal.ofReal (ω * c * r ^ m) / (unitBallVolume m * ENNReal.ofReal (r ^ m)) =
        ENNReal.ofReal c := by
    intro c hc r hr
    have hden0 : unitBallVolume m * ENNReal.ofReal (r ^ m) ≠ 0 :=
      mul_ne_zero hω0 (ENNReal.ofReal_pos.mpr (pow_pos hr m)).ne'
    have hdentop : unitBallVolume m * ENNReal.ofReal (r ^ m) ≠ ∞ :=
      ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top
    rw [show ω * c * r ^ m = c * (ω * r ^ m) by ring, ENNReal.ofReal_mul hc,
      ENNReal.ofReal_mul hωpos.le, ← hωeq, ENNReal.mul_div_cancel_right hden0 hdentop]
  -- Step 7: squeeze between `B_r(y)` and `B̄_r(y)` in the order topology of `[0, ∞]`
  have hsqueeze : ∀ F : ℝ → Set (Euclid (m + 1)), (∀ r, ball y r ⊆ F r) →
      (∀ r, F r ⊆ closedBall y r) →
      Tendsto (fun r : ℝ => μ (F r) / (unitBallVolume m * ENNReal.ofReal (r ^ m))) (𝓝[>] 0)
        (𝓝 1) := by
    intro F hF1 hF2
    rw [tendsto_order]
    refine ⟨fun a ha => ?_, fun b hb => ?_⟩
    · obtain ⟨c, hc0, hac, hc1⟩ := ENNReal.lt_iff_exists_real_btwn.mp ha
      filter_upwards [hlower c (ENNReal.ofReal_lt_one.mp hc1), self_mem_nhdsWithin]
        with r hr hrpos
      calc a < ENNReal.ofReal c := hac
        _ = ENNReal.ofReal (ω * c * r ^ m) / (unitBallVolume m * ENNReal.ofReal (r ^ m)) :=
          (hratio c hc0 r hrpos).symm
        _ ≤ μ (F r) / (unitBallVolume m * ENNReal.ofReal (r ^ m)) :=
          ENNReal.div_le_div_right (hr.trans (measure_mono (hF1 r))) _
    · obtain ⟨C, hC0, h1C, hCb⟩ := ENNReal.lt_iff_exists_real_btwn.mp hb
      filter_upwards [hupper C (ENNReal.one_lt_ofReal.mp h1C), self_mem_nhdsWithin]
        with r hr hrpos
      calc μ (F r) / (unitBallVolume m * ENNReal.ofReal (r ^ m))
          ≤ ENNReal.ofReal (ω * C * r ^ m) / (unitBallVolume m * ENNReal.ofReal (r ^ m)) :=
            ENNReal.div_le_div_right ((measure_mono (hF2 r)).trans hr) _
        _ = ENNReal.ofReal C := hratio C hC0 r hrpos
        _ < b := hCb
  exact ⟨hsqueeze (closedBall y) (fun _ => ball_subset_closedBall) (fun _ => subset_rfl),
    hsqueeze (ball y) (fun _ => subset_rfl) (fun _ => ball_subset_closedBall)⟩

/-- **The double cone around the normal has density zero** (Simon Ch. 3, Remark 1.5(3), second
assertion): if `‖v‖ = 1`, `P = v^⊥`, `μ(B̄_{r₀}(y)) < ∞` and `r⁻ᵐ ∫ f(r⁻¹(z − y)) dμ(z) → ∫_P f dHᵐ`
as `r ↓ 0` for every continuous compactly supported `f`, then for every `α > 0`
`μ({z : α‖z − y‖ ≤ |⟨z − y, v⟩|} ∩ B̄_r(y)) / rᵐ → 0` (`m ≥ 1`).  With
`K = {w : α‖w‖ ≤ |⟨w, v⟩|} ∩ B̄₁(0)`, the test function `g = (1 − dist(·, K)/θ)⁺` is `1` on `K` and
vanishes at points of `P` outside `B_{θ(1+1/α)}(0)`, so `∫_P g dHᵐ ≤ ωₘ(θ(1 + 1/α))ᵐ`; the Markov
bound then gives `μ(cone ∩ B̄_r(y)) ≤ (ωₘ(θ(1 + 1/α))ᵐ + θ) rᵐ` for small `r`, and `θ ↓ 0`. -/
theorem Submission.codim1_rdo_dg_ftd_cone_density : ∀ (m : ℕ) (μ : Measure (Euclid (m + 1))) (y v : Euclid (m + 1)), 1 ≤ m → ‖v‖ = 1 → (∃ r₀ : ℝ, 0 < r₀ ∧ μ (closedBall y r₀) ≠ ∞) → (∀ f : Euclid (m + 1) → ℝ, Continuous f → HasCompactSupport f → Tendsto (fun r : ℝ => (r ^ m)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) ∂μ) (𝓝[>] 0) (𝓝 (∫ z in ((Submodule.span ℝ {v})ᗮ : Set (Euclid (m + 1))), f z ∂μHE[m]))) → ∀ α : ℝ, 0 < α → Tendsto (fun r : ℝ => μ ({z | α * ‖z - y‖ ≤ |inner ℝ (z - y) v|} ∩ closedBall y r) / ENNReal.ofReal (r ^ m)) (𝓝[>] 0) (𝓝 0) := by
  intro m μ y v hm hv hfin hconv α hα
  -- Step 0: `P = v^⊥` is a closed `m`-dimensional subspace, and `(Hᵐ⌞P)(B_s(0)) = ωₘ sᵐ`
  set P : Submodule ℝ (Euclid (m + 1)) := (Submodule.span ℝ {v})ᗮ
  have hv0 : v ≠ 0 := by
    rintro rfl
    rw [norm_zero] at hv
    exact zero_ne_one hv
  have : Fact (Module.finrank ℝ (Euclid (m + 1)) = m + 1) := ⟨finrank_euclideanSpace_fin⟩
  have hPdim : Module.finrank ℝ P = m := Submodule.finrank_orthogonal_span_singleton hv0
  have hPmeas : MeasurableSet (P : Set (Euclid (m + 1))) :=
    P.closed_of_finiteDimensional.measurableSet
  have hωfin : unitBallVolume m ≠ ∞ := measure_ball_lt_top.ne
  set ω : ℝ := (unitBallVolume m).toReal
  have hω0 : 0 ≤ ω := ENNReal.toReal_nonneg
  have hωeq : unitBallVolume m = ENNReal.ofReal ω := (ENNReal.ofReal_toReal hωfin).symm
  have hball : ∀ s : ℝ, 0 < s →
      μHE[m].restrict (P : Set (Euclid (m + 1))) (ball 0 s) = ENNReal.ofReal (ω * s ^ m) := by
    intro s hs
    rw [Measure.restrict_apply measurableSet_ball, inter_comm,
      Submission.codim1_rdo_dg_ftd_plane_ball_measure (m + 1) m P hPdim s hs, hωeq,
      ← ENNReal.ofReal_mul hω0]
  -- Step 8: it suffices to bound the ratio eventually by each `ε ∈ (0, ∞)`
  rw [ENNReal.tendsto_nhds_zero]
  intro ε hε
  by_cases hεtop : ε = ∞
  · exact Eventually.of_forall fun r => hεtop ▸ le_top
  have ht : 0 < ε.toReal := ENNReal.toReal_pos hε.ne' hεtop
  -- since `m ≥ 1`, `ωₘ(θ(1 + α⁻¹))ᵐ + θ → 0` as `θ → 0`; pick `θ > 0` with this `< ε`
  have hφ : Tendsto (fun θ : ℝ => ω * (θ * (1 + α⁻¹)) ^ m + θ) (𝓝[>] 0) (𝓝 0) := by
    have hc : Continuous fun θ : ℝ => ω * (θ * (1 + α⁻¹)) ^ m + θ := by fun_prop
    have h0 := hc.tendsto 0
    rw [zero_mul, zero_pow (by omega), mul_zero, add_zero] at h0
    exact h0.mono_left nhdsWithin_le_nhds
  obtain ⟨θ, hθt, hθmem⟩ := ((hφ.eventually (gt_mem_nhds ht)).and self_mem_nhdsWithin).exists
  have hθ : 0 < θ := hθmem
  set ρ : ℝ := θ * (1 + α⁻¹) with hρ
  have hρpos : 0 < ρ := mul_pos hθ (add_pos one_pos (inv_pos.mpr hα))
  -- Step 1: the cone `K` in the closed unit ball contains `0`
  set K : Set (Euclid (m + 1)) := {w | α * ‖w‖ ≤ |inner ℝ w v|} ∩ closedBall 0 1
  have hKne : K.Nonempty := ⟨0, by simp [K]⟩
  -- Step 2: `g = (1 − dist(·, K)/θ)⁺` is continuous, `0 ≤ g ≤ 1`, `g = 1` on `K`, and `g(w) ≠ 0`
  -- forces `dist(w, k) < θ` for some `k ∈ K`
  set g : Euclid (m + 1) → ℝ := fun w => max 0 (1 - infDist w K / θ)
  have hgc : Continuous g :=
    continuous_const.max (continuous_const.sub ((continuous_infDist_pt K).div_const θ))
  have hg0 : ∀ w, 0 ≤ g w := fun w => le_max_left _ _
  have hg1 : ∀ w, g w ≤ 1 := fun w =>
    max_le zero_le_one (by linarith [div_nonneg (infDist_nonneg (x := w) (s := K)) hθ.le])
  have hgK : ∀ w ∈ K, 1 ≤ g w := fun w hw =>
    le_max_of_le_right (by rw [infDist_zero_of_mem hw, zero_div, sub_zero])
  have hgne : ∀ w, g w ≠ 0 → ∃ k ∈ K, dist w k < θ := by
    intro w hw
    rw [← infDist_lt_iff hKne]
    by_contra hcon
    have h1 : 1 ≤ infDist w K / θ := by
      rw [le_div_iff₀ hθ, one_mul]
      exact not_lt.mp hcon
    exact hw (max_eq_left (by linarith))
  -- Step 3: `g` vanishes outside `B̄_{1+θ}(0)`, so it has compact support
  have hgcs : HasCompactSupport g := by
    refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid (m + 1)) (1 + θ))
      fun w hw => ?_
    by_contra hne
    obtain ⟨k, hk, hwk⟩ := hgne w hne
    rw [dist_eq_norm] at hwk
    have hk1 : ‖k‖ ≤ 1 := mem_closedBall_zero_iff.mp hk.2
    apply hw
    rw [mem_closedBall_zero_iff]
    calc ‖w‖ = ‖(w - k) + k‖ := by rw [sub_add_cancel]
      _ ≤ ‖w - k‖ + ‖k‖ := norm_add_le _ _
      _ ≤ 1 + θ := by linarith
  -- Step 4: on `P`, `g(w) ≠ 0` forces `‖w‖ < ρ = θ(1 + α⁻¹)` (Cauchy–Schwarz, `⟨w, v⟩ = 0`)
  have hgP : ∀ w ∈ P, ρ ≤ ‖w‖ → g w = 0 := by
    intro w hwP hwρ
    by_contra hne
    obtain ⟨k, hk, hwk⟩ := hgne w hne
    rw [dist_eq_norm] at hwk
    have hwv : inner ℝ w v = 0 := Submodule.mem_orthogonal_singleton_iff_inner_left.mp hwP
    have hαk : α * ‖k‖ < θ :=
      calc α * ‖k‖ ≤ |inner ℝ k v| := hk.1
        _ = |inner ℝ (k - w) v| := by rw [inner_sub_left, hwv, sub_zero]
        _ ≤ ‖k - w‖ * ‖v‖ := abs_real_inner_le_norm _ _
        _ = ‖w - k‖ := by rw [hv, mul_one, norm_sub_rev]
        _ < θ := hwk
    have hkθ : ‖k‖ < θ * α⁻¹ := by
      rw [← div_eq_mul_inv, lt_div_iff₀ hα]
      linarith
    have hwρ' : ‖w‖ < ρ :=
      calc ‖w‖ = ‖(w - k) + k‖ := by rw [sub_add_cancel]
        _ ≤ ‖w - k‖ + ‖k‖ := norm_add_le _ _
        _ < θ + θ * α⁻¹ := add_lt_add hwk hkθ
        _ = ρ := by rw [hρ]; ring
    linarith
  -- Step 5: `∫_P g dHᵐ ≤ ∫_P 1_{B_ρ(0)} dHᵐ = ωₘ ρᵐ`
  have hIg : ∫ z in (P : Set (Euclid (m + 1))), g z ∂μHE[m] ≤ ω * ρ ^ m := by
    have hint : Integrable ((ball (0 : Euclid (m + 1)) ρ).indicator (1 : Euclid (m + 1) → ℝ))
        (μHE[m].restrict (P : Set (Euclid (m + 1)))) := by
      rw [integrable_indicator_iff measurableSet_ball]
      exact integrableOn_const (by rw [hball ρ hρpos]; exact ENNReal.ofReal_ne_top)
    calc ∫ z in (P : Set (Euclid (m + 1))), g z ∂μHE[m]
        ≤ ∫ z in (P : Set (Euclid (m + 1))),
            (ball (0 : Euclid (m + 1)) ρ).indicator 1 z ∂μHE[m] := by
          refine integral_mono_of_nonneg (Eventually.of_forall fun w => hg0 w) hint ?_
          rw [EventuallyLE, ae_restrict_iff' hPmeas]
          refine Eventually.of_forall fun w hwP => ?_
          by_cases hwb : w ∈ ball (0 : Euclid (m + 1)) ρ
          · rw [indicator_of_mem hwb, Pi.one_apply]
            exact hg1 w
          · rw [indicator_of_notMem hwb, hgP w hwP (by rwa [mem_ball_zero_iff, not_lt] at hwb)]
      _ = ω * ρ ^ m := by
          rw [integral_indicator_one measurableSet_ball, measureReal_def, hball ρ hρpos,
            ENNReal.toReal_ofReal (mul_nonneg hω0 (pow_nonneg hρpos.le m))]
  -- Step 6: the Markov bound for `g` and `K`, with `L' = ωₘ ρᵐ + θ`
  have hev := Submission.codim1_rdo_dg_ftd_test_upper_bound (m + 1) m μ y g K
    (∫ z in (P : Set (Euclid (m + 1))), g z ∂μHE[m]) (ω * ρ ^ m + θ) hfin hgc hgcs hg0 hgK
    (hconv g hgc hgcs) (by linarith)
  -- Steps 7–8: the cone in `B̄_r(y)` rescales into `K`, so the ratio is eventually `≤ ε`
  filter_upwards [hev, self_mem_nhdsWithin] with r hr hrmem
  have hr0 : 0 < r := hrmem
  have hincl : {z | α * ‖z - y‖ ≤ |inner ℝ (z - y) v|} ∩ closedBall y r ⊆
      {z | r⁻¹ • (z - y) ∈ K} := by
    rintro z ⟨hz1, hz2⟩
    refine ⟨?_, ?_⟩
    · show α * ‖r⁻¹ • (z - y)‖ ≤ |inner ℝ (r⁻¹ • (z - y)) v|
      rw [norm_smul, real_inner_smul_left, abs_mul, Real.norm_eq_abs, abs_inv, abs_of_pos hr0]
      calc α * (r⁻¹ * ‖z - y‖) = r⁻¹ * (α * ‖z - y‖) := by ring
        _ ≤ r⁻¹ * |inner ℝ (z - y) v| := mul_le_mul_of_nonneg_left hz1 (inv_nonneg.mpr hr0.le)
    · rw [mem_closedBall_zero_iff, norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hr0,
        inv_mul_le_iff₀ hr0, mul_one]
      rwa [mem_closedBall, dist_eq_norm] at hz2
  refine ENNReal.div_le_of_le_mul ?_
  calc μ ({z | α * ‖z - y‖ ≤ |inner ℝ (z - y) v|} ∩ closedBall y r)
      ≤ μ {z | r⁻¹ • (z - y) ∈ K} := measure_mono hincl
    _ ≤ ENNReal.ofReal ((ω * ρ ^ m + θ) * r ^ m) := hr
    _ ≤ ENNReal.ofReal (ε.toReal * r ^ m) :=
        ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right hθt.le (pow_nonneg hr0.le m))
    _ = ε * ENNReal.ofReal (r ^ m) := by
        rw [ENNReal.ofReal_mul ht.le, ENNReal.ofReal_toReal hεtop]

/-- **A flat tangent measure gives density one and the cone condition** (Simon Ch. 3,
Remark 1.5(3), applied to `μ`): if `μ(B̄_{r₀}(y)) < ∞` and `r⁻ᵐ ∫ f(r⁻¹(z − y)) dμ(z) →
∫_P f dHᵐ` as `r ↓ 0` for every continuous compactly supported `f`, where `P = (span{v})^⊥` and
`|v| = 1`, then `μ(B̄_r(y))/(ωₘrᵐ) → 1`, `μ(B_r(y))/(ωₘrᵐ) → 1`, and
`μ({z : α|z − y| ≤ |⟨z − y, v⟩|} ∩ B̄_r(y))/rᵐ → 0` for every `α > 0`.  The ball densities
sandwich `1_{B̄₁}` between continuous cut-offs; the cone test function
`(1 − dist(·, K_α)/θ)⁺` lives in `B_{θ(1+1/α)}` on `P`. -/
theorem Submission.codim1_rdo_dg_flat_tangent_density_cone : ∀ (m : ℕ) (μ : Measure (Euclid (m + 1))) (y v : Euclid (m + 1)), 1 ≤ m → ‖v‖ = 1 → (∃ r₀ : ℝ, 0 < r₀ ∧ μ (closedBall y r₀) ≠ ∞) → (∀ f : Euclid (m + 1) → ℝ, Continuous f → HasCompactSupport f → Tendsto (fun r : ℝ => (r ^ m)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) ∂μ) (𝓝[>] 0) (𝓝 (∫ z in ((Submodule.span ℝ {v})ᗮ : Set (Euclid (m + 1))), f z ∂μHE[m]))) → Tendsto (fun r : ℝ => μ (closedBall y r) / (unitBallVolume m * ENNReal.ofReal (r ^ m))) (𝓝[>] 0) (𝓝 1) ∧ Tendsto (fun r : ℝ => μ (ball y r) / (unitBallVolume m * ENNReal.ofReal (r ^ m))) (𝓝[>] 0) (𝓝 1) ∧ ∀ α : ℝ, 0 < α → Tendsto (fun r : ℝ => μ ({z | α * ‖z - y‖ ≤ |inner ℝ (z - y) v|} ∩ closedBall y r) / ENNReal.ofReal (r ^ m)) (𝓝[>] 0) (𝓝 0) := by
  intro m μ y v hm hv hfin hconv
  -- Step 2: closed and open ball densities tend to `1`
  obtain ⟨hclosed, hopen⟩ := Submission.codim1_rdo_dg_ftd_ball_density m μ y v hm hv hfin hconv
  -- Step 3: for every `α > 0` the cone `{α|z − y| ≤ |⟨z − y, v⟩|}` has density `0`
  exact ⟨hclosed, hopen, Submission.codim1_rdo_dg_ftd_cone_density m μ y v hm hv hfin hconv⟩

/-- **Rectifiability from flat tangent measures** (Simon Ch. 3, 1.6 "⇐" in codimension one).
Let `μ` be carried by the open set `D` and finite on its compact subsets. Suppose that at
`μ`-a.e. `y` the blow-ups `r⁻ᵐ μ(y + r ·)` converge to `Hᵐ⌞ν(y)^⊥`, for a Borel unit vector
field `ν`. Then `μ` is carried by a Borel countably `m`-rectifiable set.
Almost every `y` lies in `D`, so `μ(B̄_{r/2}(y)) < ∞` for any ball `B_r(y) ⊆ D`. Hence
`flat_tangent_density` gives (5) density one and (6) `μ(X_{1/4}(ν(y), y) ∩ B̄_ρ(y)) = o(ρᵐ)`.
These are the hypotheses of the halving step (★), and iterating (★) (`of_halving`) gives `R`. -/
theorem Submission.codim1_rdo_dg_rectifiable_of_flat_tangent : ∀ (m : ℕ) (D : Set (Euclid (m + 1))) (μ : Measure (Euclid (m + 1))) (ν : Euclid (m + 1) → Euclid (m + 1)), 1 ≤ m → IsOpen D → μ Dᶜ = 0 → (∀ K : Set (Euclid (m + 1)), IsCompact K → K ⊆ D → μ K ≠ ∞) → Measurable ν → (∀ y, ‖ν y‖ = 1) → (∀ᵐ y ∂μ, ∀ f : Euclid (m + 1) → ℝ, Continuous f → HasCompactSupport f → Tendsto (fun r : ℝ => (r ^ m)⁻¹ * ∫ z, f (r⁻¹ • (z - y)) ∂μ) (𝓝[>] 0) (𝓝 (∫ z in ((Submodule.span ℝ {ν y})ᗮ : Set (Euclid (m + 1))), f z ∂μHE[m]))) → ∃ R : Set (Euclid (m + 1)), MeasurableSet R ∧ CountablyRectifiable m R ∧ μ Rᶜ = 0 := by
  intro m D μ ν hm hD hDc hK hν hν1 hflat
  -- step 1: (5) and (6) at `μ`-a.e. `y`; such `y` lie in `D`, where `μ` is finite on small balls
  have hdens : ∀ᵐ y ∂μ,
      Tendsto (fun r : ℝ => μ (closedBall y r) / (unitBallVolume m * ENNReal.ofReal (r ^ m)))
        (𝓝[>] 0) (𝓝 1) ∧
      Tendsto (fun r : ℝ => μ ({z | (1 / 4 : ℝ) * ‖z - y‖ ≤ |inner ℝ (z - y) (ν y)|} ∩
        closedBall y r) / ENNReal.ofReal (r ^ m)) (𝓝[>] 0) (𝓝 0) := by
    filter_upwards [hflat, mem_ae_iff.2 hDc] with y hy hyD
    obtain ⟨r, hr, hrD⟩ := Metric.isOpen_iff.1 hD y hyD
    have hfin : μ (closedBall y (r / 2)) ≠ ∞ :=
      hK _ (isCompact_closedBall y (r / 2)) ((closedBall_subset_ball (half_lt_self hr)).trans hrD)
    obtain ⟨h5, -, h6⟩ := Submission.codim1_rdo_dg_flat_tangent_density_cone m μ y (ν y) hm
      (hν1 y) ⟨r / 2, half_pos hr, hfin⟩ hy
    exact ⟨h5, h6 (1 / 4) (by norm_num)⟩
  -- steps 2–6: the halving step (★) for open `U ⋐ D`; step 0: iterate (★) over balls in `D`
  exact Submission.codim1_rdo_dg_rc_of_halving m D μ hD hDc hK
    (Submission.codim1_rdo_dg_rc_halving_step m D μ ν hK hν hν1 hdens)
/-- **Simon Ch. 3, Lemma 1.2, "only if" part, final paragraph** (chapter-03.txt lines 61–65),
for one `C¹` map `G : ℝⁿ → ℝᴾ`: up to an `Hⁿ`-null set, `G(ℝⁿ)` is covered by the images
`G(B_{r_k}(c_k))` of countably many open balls (empty when `r_k ≤ 0`) carrying lower Lipschitz
bounds `m_k|a − b| ≤ |G a − G b|`, `m_k > 0`.
The critical image `G(C)`, `C = {x : DG(x) not injective}`, is `Hⁿ`-null.  Mathlib's partition
of `C ∩ B̄_R(0)` into pieces `T` on which `G` is `η`-close to some non-injective `A = DG(y)`
reduces this to `Hⁿ(G(T)) ≤ (‖A‖ + 1)ⁿ η Lⁿ(T)`: for a unit `u ∈ ker A`, the compression
`D w = w + (η − 1)⟨u, w⟩u` has `det D = η`, and `|G a − G b| ≤ (‖A‖ + 1)|D a − D b|` on `T`.
For a dense sequence `e` and `(q, p) = Nat.unpair k`, the candidate ball `B_{1/(p+1)}(e_q)` is
kept, with a witness `m_k`, when it carries a lower Lipschitz bound, and replaced by `B_0 = ∅`
otherwise.  At a regular point `x`, `codim1_rdo_c1cov_local_lower_lipschitz` gives a bound on
some `B_δ(x)`; a candidate ball with `2/(p+1) < δ` and `|x − e_q| < 1/(p+1)` contains `x`, lies
in `B_δ(x)` and is kept. -/
theorem Submission.codim1_rdo_c1cov_regular_ball_cover : ∀ (P n : ℕ) (G : Euclid n → Euclid P), ContDiff ℝ 1 G → ∃ (c : ℕ → Euclid n) (r m : ℕ → ℝ), (∀ k, 0 < m k) ∧ (∀ k, ∀ a ∈ ball (c k) (r k), ∀ b ∈ ball (c k) (r k), m k * ‖a - b‖ ≤ ‖G a - G b‖) ∧ μHE[n] (range G \ ⋃ k, G '' ball (c k) (r k)) = 0 := by
  intro P n G hG
  -- the critical image `G({x : DG(x) not injective})` is `Hⁿ`-null
  have hcrit : μHE[n] (G '' {x | ¬ Injective (fderiv ℝ G x)}) = 0 := by
    -- near a non-injective `A`, `G` shrinks `Hⁿ` by the factor `ε`
    have hloc : ∀ ε : NNReal, 0 < ε → ε ≤ 1 → ∀ A : Euclid n →L[ℝ] Euclid P, ∃ δ : NNReal,
        0 < δ ∧ (¬ Injective A → ∀ T : Set (Euclid n), ApproximatesLinearOn G A T δ →
          μHE[n] (G '' T) ≤ ε * volume T) := by
      intro ε hε hε1 A
      by_cases hA : Injective A
      · exact ⟨1, one_pos, fun h => absurd hA h⟩
      -- a unit vector `u` in the kernel of `A`
      obtain ⟨u, hu1, hAu⟩ : ∃ u : Euclid n, ‖u‖ = 1 ∧ A u = 0 := by
        rw [injective_iff_map_eq_zero] at hA
        push Not at hA
        obtain ⟨w, hw, hw0⟩ := hA
        refine ⟨‖w‖⁻¹ • w, ?_, ?_⟩
        · rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ (norm_ne_zero_iff.2 hw0)]
        · rw [map_smul, hw, smul_zero]
      set K : NNReal := ‖A‖₊ + 1 with hK
      have hK1 : 1 ≤ K := le_add_self
      have hKn : (0 : NNReal) < K ^ n := pow_pos (zero_lt_one.trans_le hK1) n
      set η : NNReal := ε / K ^ n with hη
      have hη0 : 0 < η := div_pos hε hKn
      have hη1 : (η : ℝ) ≤ 1 := by
        have : η ≤ ε := div_le_self (by positivity) (one_le_pow₀ hK1)
        exact_mod_cast this.trans hε1
      refine ⟨η, hη0, fun _ T hT => ?_⟩
      -- the compression `D w = w + (η - 1) ⟪u, w⟫ u` along `u`
      let D : Euclid n →ₗ[ℝ] Euclid n := LinearMap.id + ((η : ℝ) - 1) • (innerₛₗ ℝ u).smulRight u
      have hD : ∀ w, D w = w + (((η : ℝ) - 1) * inner ℝ u w) • u := by
        intro w
        simp [D, mul_smul]
      -- `det D = 1 + (η - 1) ‖u‖² = η` (matrix determinant lemma in the standard basis)
      have hdet : LinearMap.det D = η := by
        set b := (EuclideanSpace.basisFun (Fin n) ℝ).toBasis with hb
        have hM : LinearMap.toMatrix b b D =
            1 + Matrix.vecMulVec (fun i => u i) (fun j => ((η : ℝ) - 1) * u j) := by
          ext i j
          rw [LinearMap.toMatrix_apply, hD]
          simp [hb, Matrix.one_apply, Matrix.vecMulVec_apply, EuclideanSpace.inner_single_right]
          ring
        have hsum : ∑ j, u j * u j = 1 := by
          have h := real_inner_self_eq_norm_sq u
          rw [hu1, PiLp.inner_apply] at h
          simpa [sq] using h
        rw [← LinearMap.det_toMatrix b, hM, Matrix.vecMulVec_eq Unit,
          Matrix.det_one_add_replicateCol_mul_replicateRow]
        simp only [dotProduct, mul_assoc]
        rw [← Finset.mul_sum, hsum]
        ring
      -- `‖G y₁ - G y₂‖ ≤ ‖A (y₁ - y₂)‖ + η ‖y₁ - y₂‖ ≤ K ‖D (y₁ - y₂)‖` on `T`
      have hkey : ∀ y₁ ∈ T, ∀ y₂ ∈ T, ‖G y₁ - G y₂‖ ≤ K * ‖D y₁ - D y₂‖ := by
        intro y₁ h₁ y₂ h₂
        have happ : ‖G y₁ - G y₂ - A (y₁ - y₂)‖ ≤ η * ‖y₁ - y₂‖ := hT y₁ h₁ y₂ h₂
        rw [← map_sub]
        set w := y₁ - y₂
        have hAw : A w = A (D w) := by rw [hD, map_add, map_smul, hAu, smul_zero, add_zero]
        -- `‖D w‖² = ‖w‖² - (1 - η²) ⟪u, w⟫² ≥ η² ‖w‖²`
        have hnorm : (η : ℝ) * ‖w‖ ≤ ‖D w‖ := by
          have h1 : ‖D w‖ ^ 2 = ‖w‖ ^ 2 + ((η : ℝ) ^ 2 - 1) * inner ℝ u w ^ 2 := by
            rw [hD, norm_add_sq_real, inner_smul_right, norm_smul, real_inner_comm,
              Real.norm_eq_abs, hu1, mul_one, sq_abs]
            ring
          have h2 : inner ℝ u w ^ 2 ≤ ‖w‖ ^ 2 := by
            have h := abs_real_inner_le_norm u w
            rw [hu1, one_mul] at h
            exact sq_le_sq' (abs_le.1 h).1 (abs_le.1 h).2
          have h3 : ((η : ℝ) * ‖w‖) ^ 2 ≤ ‖D w‖ ^ 2 := by
            rw [h1, mul_pow]
            have h4 : (η : ℝ) ^ 2 ≤ 1 := by nlinarith [η.coe_nonneg]
            nlinarith [mul_nonneg (sub_nonneg.2 h2) (sub_nonneg.2 h4)]
          exact (pow_le_pow_iff_left₀ (by positivity) (norm_nonneg _) two_ne_zero).1 h3
        have hAD : ‖A (D w)‖ ≤ ‖A‖ * ‖D w‖ := A.le_opNorm _
        calc ‖G y₁ - G y₂‖ ≤ ‖A w‖ + ‖G y₁ - G y₂ - A w‖ := norm_le_insert' _ _
          _ ≤ ‖A‖ * ‖D w‖ + ‖D w‖ := by rw [hAw] at happ ⊢; linarith
          _ = K * ‖D w‖ := by simp [K]; ring
      -- `φ = G ∘ D⁻¹` is `K`-Lipschitz on `D '' T` and `G '' T ⊆ φ '' (D '' T)`
      let φ : Euclid n → Euclid P := fun z => G (Function.invFunOn D T z)
      have hφ : ∀ y ∈ T, Function.invFunOn D T (D y) ∈ T ∧ D (Function.invFunOn D T (D y)) = D y :=
        fun y hy => Function.invFunOn_pos ⟨y, hy, rfl⟩
      have hlip : LipschitzOnWith K φ (D '' T) := by
        apply LipschitzOnWith.of_dist_le_mul
        rintro _ ⟨y₁, h₁, rfl⟩ _ ⟨y₂, h₂, rfl⟩
        obtain ⟨h₁', e₁⟩ := hφ y₁ h₁
        obtain ⟨h₂', e₂⟩ := hφ y₂ h₂
        have h := hkey _ h₁' _ h₂'
        rw [e₁, e₂] at h
        simpa only [dist_eq_norm] using h
      have hsub : G '' T ⊆ φ '' (D '' T) := by
        rintro _ ⟨y, hy, rfl⟩
        refine ⟨D y, ⟨y, hy, rfl⟩, ?_⟩
        obtain ⟨h', e⟩ := hφ y hy
        have h := hkey _ h' _ hy
        rw [e, sub_self, norm_zero, mul_zero] at h
        exact sub_eq_zero.1 (norm_le_zero_iff.1 h)
      -- `Hⁿ(G(T)) ≤ Kⁿ Hⁿ(D(T)) = Kⁿ |det D| Lⁿ(T) = ε Lⁿ(T)`
      calc μHE[n] (G '' T) ≤ μHE[n] (φ '' (D '' T)) := measure_mono hsub
        _ ≤ (K : ℝ≥0∞) ^ n * μHE[n] (D '' T) :=
            Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n hlip
        _ = (K : ℝ≥0∞) ^ n * (ENNReal.ofReal |LinearMap.det D| * volume T) := by
            rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume, Measure.addHaar_image_linearMap]
        _ = ε * volume T := by
            rw [hdet, abs_of_nonneg η.coe_nonneg, ENNReal.ofReal_coe_nnreal, ← mul_assoc,
              ← ENNReal.coe_pow, ← ENNReal.coe_mul, hη, mul_div_cancel₀ _ hKn.ne']
    -- on `C ∩ B̄_R(0)`: partition into pieces where `G` is close to some `DG(y)`, `y ∈ C`
    have hR : ∀ R : ℝ, μHE[n] (G '' ({x | ¬ Injective (fderiv ℝ G x)} ∩ closedBall 0 R)) = 0 := by
      intro R
      set s := {x | ¬ Injective (fderiv ℝ G x)} ∩ closedBall (0 : Euclid n) R with hs
      have hbound : ∀ ε : NNReal, 0 < ε → ε ≤ 1 →
          μHE[n] (G '' s) ≤ ε * volume (closedBall (0 : Euclid n) R) := by
        intro ε hε hε1
        rcases eq_empty_or_nonempty s with h | h
        · rw [h, image_empty, measure_empty]
          exact bot_le
        choose δ hδ using hloc ε hε hε1
        obtain ⟨t, A, t_disj, t_meas, t_cover, ht, Af'⟩ :=
          exists_partition_approximatesLinearOn_of_hasFDerivWithinAt G s (fderiv ℝ G)
            (fun x _ => (hG.differentiable one_ne_zero x).hasFDerivAt.hasFDerivWithinAt) δ
            (fun A => (hδ A).1.ne')
        calc μHE[n] (G '' s) ≤ μHE[n] (⋃ k, G '' (s ∩ t k)) := by
              rw [← image_iUnion, ← inter_iUnion]
              exact measure_mono (image_mono (subset_inter Subset.rfl t_cover))
          _ ≤ ∑' k, μHE[n] (G '' (s ∩ t k)) := measure_iUnion_le _
          _ ≤ ∑' k, (ε : ℝ≥0∞) * volume (closedBall (0 : Euclid n) R ∩ t k) := by
              refine ENNReal.tsum_le_tsum fun k => ?_
              obtain ⟨y, hy, hAy⟩ := Af' h k
              calc μHE[n] (G '' (s ∩ t k)) ≤ ε * volume (s ∩ t k) :=
                    (hδ (A k)).2 (by rw [hAy]; exact hy.1) _ (ht k)
                _ ≤ ε * volume (closedBall (0 : Euclid n) R ∩ t k) := by
                    gcongr
                    exact inter_subset_right
          _ = ε * volume (⋃ k, closedBall (0 : Euclid n) R ∩ t k) := by
              rw [ENNReal.tsum_mul_left, measure_iUnion]
              · exact pairwise_disjoint_mono t_disj fun k => inter_subset_right
              · exact fun k => measurableSet_closedBall.inter (t_meas k)
          _ ≤ ε * volume (closedBall (0 : Euclid n) R) := by
              gcongr
              exact iUnion_subset fun k => inter_subset_left
      -- let `ε → 0`
      have B : Tendsto (fun ε : NNReal => (ε : ℝ≥0∞) * volume (closedBall (0 : Euclid n) R))
          (𝓝[>] 0) (𝓝 0) := by
        have h : Tendsto (fun ε : NNReal => (ε : ℝ≥0∞) * volume (closedBall (0 : Euclid n) R))
            (𝓝 0) (𝓝 (((0 : NNReal) : ℝ≥0∞) * volume (closedBall (0 : Euclid n) R))) :=
          ENNReal.Tendsto.mul_const (ENNReal.tendsto_coe.2 tendsto_id)
            (Or.inr measure_closedBall_lt_top.ne)
        simp only [zero_mul, ENNReal.coe_zero] at h
        exact h.mono_left nhdsWithin_le_nhds
      rw [← nonpos_iff_eq_zero]
      apply ge_of_tendsto B
      filter_upwards [Ioc_mem_nhdsGT zero_lt_one] with ε hε
      exact hbound ε hε.1 hε.2
    have h := measure_iUnion_null (μ := μHE[n]) fun k : ℕ => hR k
    rwa [← image_iUnion, iUnion_inter_closedBall_nat] at h
  classical
  -- candidate balls `B_{1/(p+1)}(e_q)`, `(q, p) = Nat.unpair k`, for a dense sequence `e`
  obtain ⟨e, he⟩ := TopologicalSpace.exists_dense_seq (Euclid n)
  let ctr : ℕ → Euclid n := fun k => e (Nat.unpair k).1
  let rad : ℕ → ℝ := fun k => 1 / ((Nat.unpair k).2 + 1 : ℝ)
  -- a candidate ball is good if `G` has a lower Lipschitz bound on it
  let good : ℕ → Prop := fun k => ∃ μ : ℝ, 0 < μ ∧
    ∀ a ∈ ball (ctr k) (rad k), ∀ b ∈ ball (ctr k) (rad k), μ * ‖a - b‖ ≤ ‖G a - G b‖
  refine ⟨ctr, fun k => if good k then rad k else 0,
    fun k => if h : good k then Exists.choose h else 1, fun k => ?_, fun k => ?_, ?_⟩
  · -- `m_k > 0`
    show 0 < if h : good k then Exists.choose h else 1
    split_ifs with h
    exacts [(Exists.choose_spec h).1, one_pos]
  · -- (i): the witness on a good ball; otherwise `B_0(c_k) = ∅`
    intro a ha b hb
    dsimp only at ha hb ⊢
    by_cases h : good k
    · rw [ite_eq_left h] at ha hb
      rw [dite_eq_left h]
      exact (Exists.choose_spec h).2 a ha b hb
    · rw [ite_eq_right h, ball_zero] at ha
      exact absurd ha (notMem_empty a)
  · -- (ii): each regular point lies in a good ball, so the remainder is in the critical image
    refine measure_mono_null ?_ hcrit
    rintro y ⟨⟨x, rfl⟩, hy⟩
    refine ⟨x, fun hinj => hy ?_, rfl⟩
    obtain ⟨δ, μ, hδ, hμ, hlip⟩ :=
      Submission.codim1_rdo_c1cov_local_lower_lipschitz P n G x hG hinj
    obtain ⟨p, hp⟩ := exists_nat_one_div_lt (half_pos hδ)
    obtain ⟨q, hq⟩ := he.exists_dist_lt x (Nat.one_div_pos_of_nat : (0 : ℝ) < 1 / ((p : ℝ) + 1))
    have hk : Nat.unpair (Nat.pair q p) = (q, p) := Nat.unpair_pair q p
    -- `B_{1/(p+1)}(e_q) ⊆ B_δ(x)`, so this candidate ball is good
    have hsub : ball (ctr (Nat.pair q p)) (rad (Nat.pair q p)) ⊆ ball x δ := by
      intro a ha
      simp only [ctr, rad, hk, mem_ball] at ha ⊢
      calc dist a x ≤ dist a (e q) + dist (e q) x := dist_triangle _ _ _
        _ < 1 / ((p : ℝ) + 1) + 1 / ((p : ℝ) + 1) := add_lt_add ha (by rwa [dist_comm])
        _ < δ := by linarith
    have hgood : good (Nat.pair q p) :=
      ⟨μ, hμ, fun a ha b hb => hlip a (hsub ha) b (hsub hb)⟩
    refine mem_iUnion.2 ⟨Nat.pair q p, x, ?_, rfl⟩
    show x ∈ ball (ctr (Nat.pair q p)) (if good (Nat.pair q p) then rad (Nat.pair q p) else 0)
    rw [ite_eq_left hgood]
    simpa only [ctr, rad, hk, mem_ball] using hq
/-- **Simon Ch. 3, proof of Lemma 1.2** (properties (ii), (iii) of the pieces `g(B_r(c))`): the
image of an open ball under a `C¹` map `g : ℝⁿ → ℝᴾ` is Borel and has finite `Hⁿ`-measure.
`B_r(c) = ⋃ₜ closedBall(c, r − 1/(t+1))`, so `g(B_r(c))` is a countable union of compact sets;
`g` is Lipschitz on the compact convex `closedBall(c, r)`, so by Simon Ch. 2, 1.8(i)
`Hⁿ(g(B_r(c))) ≤ Λⁿ Lⁿ(B_r(c)) < ∞`. -/
theorem Submission.codim1_rdo_c1cov_image_ball_borel_finite : ∀ (P n : ℕ) (g : Euclid n → Euclid P) (c : Euclid n) (r : ℝ), ContDiff ℝ 1 g → MeasurableSet (g '' ball c r) ∧ μHE[n] (g '' ball c r) ≠ ∞ := by
  intro P n g c r hg
  refine ⟨?_, ?_⟩
  · -- `B_r(c)` is the union of the compact balls `closedBall(c, r − 1/(t+1))`
    have hball : ball c r = ⋃ t : ℕ, closedBall c (r - 1 / ((t : ℝ) + 1)) := by
      ext y
      simp only [mem_ball, mem_iUnion, mem_closedBall]
      constructor
      · intro hy
        obtain ⟨t, ht⟩ := exists_nat_one_div_lt (sub_pos.mpr hy)
        exact ⟨t, by linarith⟩
      · rintro ⟨t, ht⟩
        have : (0 : ℝ) < 1 / ((t : ℝ) + 1) := by positivity
        linarith
    rw [hball, image_iUnion]
    exact MeasurableSet.iUnion fun t =>
      ((isCompact_closedBall c _).image hg.continuous).isClosed.measurableSet
  · -- `g` is Lipschitz on the compact convex `closedBall c r`, hence on `ball c r`
    obtain ⟨K, hK⟩ := (hg.contDiffOn (s := closedBall c r)).exists_lipschitzOnWith one_ne_zero
      (convex_closedBall c r) (isCompact_closedBall c r)
    refine ne_top_of_le_ne_top ?_
      (Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
        (hK.mono ball_subset_closedBall))
    rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
    exact ENNReal.mul_ne_top (ENNReal.pow_ne_top ENNReal.coe_ne_top) measure_ball_lt_top.ne
/-- Simon Ch. 3, Lemma 1.2, display (1) (corrected: `F(ℝⁿ) ⊆ E ∪ ⋃ᵢ Gᵢ(ℝⁿ)`, `Gᵢ : ℝⁿ → ℝᴾ`),
for one Lipschitz map `F : ℝⁿ → ℝᴾ`, given the scalar `C¹` approximation theorem (Simon Ch. 2,
Theorem 1.5) on `ℝⁿ` as the hypothesis.  Each coordinate `Fˡ` is `K`-Lipschitz; approximating it
with error `((i + 1)(P + 1))⁻¹` gives `C¹` maps `Gᵢ = (g_{i,l})ₗ` with `Lⁿ{F ≠ Gᵢ} ≤ (i + 1)⁻¹`, so
`Z = ⋂ᵢ {F ≠ Gᵢ}` is `Lⁿ`-null, `Hⁿ(F(Z)) ≤ Kⁿ Lⁿ(Z) = 0` (Simon 2.1.8(i), `Hⁿ = Lⁿ` on `ℝⁿ`) and
`F(ℝⁿ) \ ⋃ᵢ Gᵢ(ℝⁿ) ⊆ F(Z)`. -/
theorem Submission.codim1_rdo_c1cov_lipschitz_range_c1_cover : ∀ (P n : ℕ), (∀ (f : Euclid n → ℝ) (K : NNReal), LipschitzWith K f → ∀ ε : ℝ≥0∞, 0 < ε → ∃ g : Euclid n → ℝ, ContDiff ℝ 1 g ∧ volume {x | f x ≠ g x ∨ fderiv ℝ f x ≠ fderiv ℝ g x} < ε) → ∀ (F : Euclid n → Euclid P) (K : NNReal), LipschitzWith K F → ∃ G : ℕ → Euclid n → Euclid P, (∀ i, ContDiff ℝ 1 (G i)) ∧ μHE[n] (range F \ ⋃ i, range (G i)) = 0 := by
  intro P n hH F K hF
  -- Step 1: the coordinates `Fˡ` of `F` are `K`-Lipschitz
  have hFl : ∀ l : Fin P, LipschitzWith K fun x => F x l := fun l =>
    LipschitzWith.of_dist_le_mul fun x y =>
      (PiLp.dist_apply_le (F x) (F y) l).trans (hF.dist_le_mul x y)
  -- Step 2: `C¹` approximation of every coordinate with error `δᵢ = ((i + 1)(P + 1))⁻¹`
  have hδ : ∀ i : ℕ, (0 : ℝ≥0∞) < (((i : ℝ≥0∞) + 1) * ((P : ℝ≥0∞) + 1))⁻¹ := fun i =>
    ENNReal.inv_pos.2 (ENNReal.mul_ne_top (by simp) (by simp))
  choose g hg hgvol using fun (i : ℕ) (l : Fin P) => hH (fun x => F x l) K (hFl l) _ (hδ i)
  -- Step 3: `Gᵢ = (g_{i,1}, …, g_{i,P})` is `C¹`
  let G : ℕ → Euclid n → Euclid P := fun i x => WithLp.toLp 2 fun l => g i l x
  have hG : ∀ i, ContDiff ℝ 1 (G i) := fun i => (contDiff_piLp 2).2 fun l => hg i l
  -- Step 4: `{F ≠ Gᵢ} ⊆ ⋃ₗ {Fˡ ≠ g_{i,l} ∨ DFˡ ≠ Dg_{i,l}}`, so `Lⁿ{F ≠ Gᵢ} ≤ (i + 1)⁻¹`
  have hsub : ∀ i, {x | F x ≠ G i x} ⊆
      ⋃ l, {x | F x l ≠ g i l x ∨ fderiv ℝ (fun x => F x l) x ≠ fderiv ℝ (g i l) x} := by
    intro i x hx
    obtain ⟨l, hl⟩ : ∃ l, F x l ≠ g i l x := by
      by_contra! h
      exact hx (PiLp.ext h)
    exact mem_iUnion.2 ⟨l, Or.inl hl⟩
  have hvol : ∀ i : ℕ, volume {x | F x ≠ G i x} ≤ ((i : ℝ≥0∞) + 1)⁻¹ := by
    intro i
    calc volume {x | F x ≠ G i x}
        ≤ ∑ l, volume {x | F x l ≠ g i l x ∨ fderiv ℝ (fun x => F x l) x ≠ fderiv ℝ (g i l) x} :=
          (measure_mono (hsub i)).trans (measure_iUnion_fintype_le _ _)
      _ ≤ ∑ _l : Fin P, (((i : ℝ≥0∞) + 1) * ((P : ℝ≥0∞) + 1))⁻¹ :=
          Finset.sum_le_sum fun l _ => (hgvol i l).le
      _ = (P : ℝ≥0∞) * (((i : ℝ≥0∞) + 1) * ((P : ℝ≥0∞) + 1))⁻¹ := by simp
      _ ≤ ((P : ℝ≥0∞) + 1) * (((i : ℝ≥0∞) + 1) * ((P : ℝ≥0∞) + 1))⁻¹ := by gcongr; exact le_self_add
      _ = ((i : ℝ≥0∞) + 1)⁻¹ := by
          rw [ENNReal.mul_inv (Or.inl (by simp)) (Or.inl (by simp)), mul_left_comm,
            ENNReal.mul_inv_cancel (by simp) (by simp), mul_one]
  -- Step 5: `Z = ⋂ᵢ {F ≠ Gᵢ}` is `Lⁿ`-null
  have hZ : volume (⋂ i, {x | F x ≠ G i x}) = 0 := by
    refine le_antisymm (le_of_forall_gt fun ε hε => ?_) bot_le
    obtain ⟨i, hi⟩ := ENNReal.exists_inv_nat_lt hε.ne'
    calc volume (⋂ i, {x | F x ≠ G i x}) ≤ volume {x | F x ≠ G i x} := measure_mono (iInter_subset _ i)
      _ ≤ ((i : ℝ≥0∞) + 1)⁻¹ := hvol i
      _ ≤ (i : ℝ≥0∞)⁻¹ := ENNReal.inv_le_inv.2 le_self_add
      _ < ε := hi
  -- Step 6: `Hⁿ(F(Z)) ≤ Kⁿ Hⁿ(Z) = Kⁿ Lⁿ(Z) = 0`
  have hFZ : μHE[n] (F '' ⋂ i, {x | F x ≠ G i x}) = 0 := by
    refine le_antisymm ?_ bot_le
    calc μHE[n] (F '' ⋂ i, {x | F x ≠ G i x})
        ≤ (K : ℝ≥0∞) ^ n * μHE[n] (⋂ i, {x | F x ≠ G i x}) :=
          Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn n
            hF.lipschitzOnWith
      _ = 0 := by rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume, hZ, mul_zero]
  -- Step 7: `F(ℝⁿ) \ ⋃ᵢ Gᵢ(ℝⁿ) ⊆ F(Z)`
  refine ⟨G, hG, measure_mono_null ?_ hFZ⟩
  rintro _ ⟨⟨x, rfl⟩, hy⟩
  exact ⟨x, mem_iInter.2 fun i h => hy (mem_iUnion.2 ⟨i, x, h.symm⟩), rfl⟩
/-- **Simon Ch. 6, Remark 3.2(1)**: the difference of two integer multiplicity currents in the
open set `U` is integer multiplicity.  Let `S = τ(M₁, θ₁, ξ₁)`, `T = τ(M₂, θ₂, ξ₂)`.  By the Upper
Density Theorem (Ch. 1, 3.6) the carriers have density zero at `Hⁿ`-a.e. point outside them, and
approximate tangent spaces ignore sets of density zero (Ch. 3, 1.4–1.5), so `T_yM₁ = T_yM₂` and
`ξ₂(y) = σ(y) ξ₁(y)` with a Borel sign `σ = ±1` for `Hⁿ`-a.e. `y ∈ M₁ ∩ M₂`.  Then
`S − T = τ(M, m, ζ)` with `M = (M₁ \ M₂) ∪ (M₂ \ M₁) ∪ {y ∈ M₁ ∩ M₂ : θ₁ ≠ σθ₂}` and
`(m, ζ) = (θ₁, ξ₁)`, `(θ₂, −ξ₂)`, `(|θ₁ − σθ₂|, ±ξ₁)` on the three pieces. -/
theorem Submission.dtc_isIntegerMultiplicity_sub : ∀ (P n : ℕ) (U : Set (Euclid P)) (S T : GeometricCurrentOn U n), IsOpen U → 0 < n → IsIntegerMultiplicity S → IsIntegerMultiplicity T → IsIntegerMultiplicity (S - T) := by
  classical
  intro P n U S T hU _hn hS hT
  obtain ⟨R₁, hR₁⟩ := hS
  obtain ⟨R₂, hR₂⟩ := hT
  -- Step 1: carriers are locally `Hⁿ`-finite in `U` (multiplicities are `≥ 1`)
  have hfin : ∀ R : IMRep U n, ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
      μHE[n] (R.carrier ∩ K) ≠ ∞ := by
    intro R K hK hKU
    refine ne_top_of_le_ne_top (R.locallyIntegrable_mult K hK hKU) ?_
    rw [← setLIntegral_one]
    apply setLIntegral_mono' (R.measurableSet_carrier.inter hK.measurableSet)
    intro x hx
    have := R.mult_pos x hx.1
    exact_mod_cast Nat.one_le_iff_ne_zero.2 (Nat.pos_iff_ne_zero.1 this)
  -- Step 2 (F1): Upper Density Theorem (Simon 1.3.6), localized to `U`
  have F1 : ∀ A : Set (Euclid P), MeasurableSet A →
      (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (A ∩ K) ≠ ∞) →
      ∀ᵐ y ∂(μHE[n] : Measure (Euclid P)), y ∈ U → y ∉ A →
        Tendsto (fun ρ : ℝ => μHE[n] (A ∩ closedBall y ρ) / ENNReal.ofReal (ρ ^ n))
          (𝓝[>] 0) (𝓝 0) := by
    intro A hA hAfin
    have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    have hzero : ∀ y : Euclid P,
        Poincare.SimonGMT.Chapter01.dimensionalUpperDensity
          ((μHE[n] : Measure (Euclid P)).toOuterMeasure) (n : ℝ) A y = 0 →
        Tendsto (fun ρ : ℝ => μHE[n] (A ∩ closedBall y ρ) / ENNReal.ofReal (ρ ^ n))
          (𝓝[>] 0) (𝓝 0) := by
      intro y h
      have hq : Tendsto (Poincare.SimonGMT.Chapter01.dimensionalDensityQuotient
          ((μHE[n] : Measure (Euclid P)).toOuterMeasure) (n : ℝ) A y) (𝓝[>] (0 : ℝ)) (𝓝 0) := by
        apply tendsto_of_le_liminf_of_limsup_le (zero_le)
        exact h.le
      have hω0 : Poincare.SimonGMT.Chapter01.realUnitBallVolume (n : ℝ) ≠ 0 :=
        (Poincare.SimonGMT.Chapter01.realUnitBallVolume_pos hn0).ne'
      have hωt : Poincare.SimonGMT.Chapter01.realUnitBallVolume (n : ℝ) ≠ ∞ :=
        Poincare.SimonGMT.Chapter01.realUnitBallVolume_ne_top _
      have h2 := ENNReal.Tendsto.const_mul hq (Or.inr hωt)
        (a := Poincare.SimonGMT.Chapter01.realUnitBallVolume (n : ℝ))
      rw [mul_zero] at h2
      refine h2.congr' ?_
      filter_upwards [self_mem_nhdsWithin] with ρ hρ
      simp only [Poincare.SimonGMT.Chapter01.dimensionalDensityQuotient,
        Measure.toOuterMeasure_apply]
      rw [ENNReal.rpow_natCast, ← ENNReal.ofReal_pow (le_of_lt hρ), ← mul_div_assoc,
        ENNReal.mul_div_mul_left _ _ hω0 hωt]
    -- null sets of Simon's `Hⁿ` are `μHE[n]`-null
    have bridge : ∀ Z : Set (Euclid P),
        Poincare.SimonGMT.Chapter01.simonHausdorffOuterMeasureReal (n : ℝ) Z = 0 →
          (μHE[n] : Measure (Euclid P)) Z = 0 := by
      intro Z hZ
      rw [Poincare.SimonGMT.Chapter01.simonHausdorffOuterMeasureReal_eq_scaled_hausdorffMeasure
        hn0] at hZ
      rw [smul_apply, smul_eq_mul] at hZ
      have hc : Poincare.SimonGMT.Chapter01.realUnitBallVolume (n : ℝ) / (2 : ℝ≥0∞) ^ (n : ℝ)
          ≠ 0 :=
        ENNReal.div_ne_zero.mpr
          ⟨(Poincare.SimonGMT.Chapter01.realUnitBallVolume_pos hn0).ne', by simp⟩
      have hH : (μH[(n : ℝ)] : Measure (Euclid P)) Z = 0 := by
        simpa using (mul_eq_zero.mp hZ).resolve_left hc
      rw [Measure.euclideanHausdorffMeasure_def, Measure.smul_apply, hH, smul_zero]
    -- countable cover of `U` by balls whose closures are compact subsets of `U`
    let ι := {p : Euclid P × ℝ // 0 < p.2 ∧ closedBall p.1 p.2 ⊆ U}
    obtain ⟨J, hJc, hJU⟩ := TopologicalSpace.isOpen_iUnion_countable
      (fun i : ι => ball i.1.1 i.1.2) (fun _ => isOpen_ball)
    have hcover : U ⊆ ⋃ i : ι, ball i.1.1 i.1.2 := by
      intro x hx
      obtain ⟨ε, hε, hεU⟩ := Metric.isOpen_iff.mp hU x hx
      exact mem_iUnion.mpr ⟨⟨(x, ε / 2), half_pos hε,
        (closedBall_subset_ball (half_lt_self hε)).trans hεU⟩, mem_ball_self (half_pos hε)⟩
    let N : ι → Set (Euclid P) := fun i => {x | x ∉ A ∩ ball i.1.1 i.1.2 ∧
      Poincare.SimonGMT.Chapter01.dimensionalUpperDensity
        ((μHE[n] : Measure (Euclid P)).toOuterMeasure) (n : ℝ) (A ∩ ball i.1.1 i.1.2) x ≠ 0}
    have hN : ∀ i, (μHE[n] : Measure (Euclid P)) (N i) = 0 := by
      intro i
      apply bridge
      apply Poincare.SimonGMT.Chapter01.simon_theorem_3_6 _
        (Poincare.SimonGMT.Chapter01.measure_toOuterMeasure_isBorelRegular _) hn0
      · exact le_toOuterMeasure_caratheodory _ _ (hA.inter measurableSet_ball)
      · have := hAfin (closedBall i.1.1 i.1.2) (isCompact_closedBall _ _) i.2.2
        exact lt_of_le_of_lt (measure_mono (inter_subset_inter_right _ ball_subset_closedBall))
          this.lt_top
    rw [ae_iff]
    apply measure_mono_null (t := ⋃ i ∈ J, N i)
    · intro y hy
      simp only [mem_ofPred_eq, not_imp] at hy
      obtain ⟨hyU, hyA, hnot⟩ := hy
      have hy' := hcover hyU
      rw [← hJU] at hy'
      obtain ⟨i, hiJ, hyi⟩ := mem_iUnion₂.mp hy'
      refine mem_iUnion₂.mpr ⟨i, hiJ, fun h => hyA h.1, fun hden => hnot ?_⟩
      rw [Poincare.SimonGMT.Chapter01.dimensionalUpperDensity_inter_of_mem_nhds _ _ _ _ _
        (isOpen_ball.mem_nhds hyi)] at hden
      exact hzero y hden
    · exact (measure_biUnion_null_iff hJc).mpr fun i _ => hN i
  -- Step 3 (F2): approximate tangent spaces ignore sets of zero `n`-density
  have F2 : ∀ (A A' : Set (Euclid P)) (y : Euclid P) (Q : Submodule ℝ (Euclid P)) (s : ℝ),
      MeasurableSet A → MeasurableSet A' → 0 < s →
      μHE[n] (A ∩ closedBall y s) ≠ ∞ → μHE[n] (A' ∩ closedBall y s) ≠ ∞ →
      Tendsto (fun ρ : ℝ => μHE[n] (((A \ A') ∪ (A' \ A)) ∩ closedBall y ρ) /
        ENNReal.ofReal (ρ ^ n)) (𝓝[>] 0) (𝓝 0) →
      HasApproximateTangentSpaceAt n A y Q → HasApproximateTangentSpaceAt n A' y Q := by
    intro A A' y Q s hA hA' hs hAfin hA'fin hD hTA
    refine ⟨hTA.1, fun f => ?_⟩
    set D := (A \ A') ∪ (A' \ A) with hDdef
    have hfc : Continuous f := map_continuous f
    have hfcs : HasCompactSupport f := f.hasCompactSupport
    obtain ⟨C, hC⟩ := hfc.bounded_above_of_compact_support hfcs
    obtain ⟨L₀, hL₀⟩ := hfcs.isCompact.isBounded.subset_closedBall (0 : Euclid P)
    set L := max L₀ 1 with hLdef
    have hL : 0 < L := lt_of_lt_of_le one_pos (le_max_right _ _)
    have hfL : ∀ z, z ∉ closedBall (0 : Euclid P) L → f z = 0 := by
      intro z hz
      apply image_eq_zero_of_notMem_tsupport
      intro hzt
      exact hz (closedBall_subset_closedBall (le_max_left _ _) (hL₀ hzt))
    have hDm : MeasurableSet D := (hA.diff hA').union (hA'.diff hA)
    have hinj : ∀ r : ℝ, 0 < r → Injective (Poincare.SimonGMT.Chapter03.blowUpMap y r) := by
      intro r hr a b hab
      simp only [Poincare.SimonGMT.Chapter03.blowUpMap] at hab
      have := smul_right_injective (Euclid P) (inv_ne_zero hr.ne') hab
      simpa using this
    have hmeasIm : ∀ r : ℝ, 0 < r → ∀ Z : Set (Euclid P), MeasurableSet Z →
        MeasurableSet (Poincare.SimonGMT.Chapter03.blowUpMap y r '' Z) := by
      intro r hr Z hZ
      have : Poincare.SimonGMT.Chapter03.blowUpMap y r '' Z = (fun w => r • w + y) ⁻¹' Z := by
        ext w
        simp only [mem_image, mem_preimage, Poincare.SimonGMT.Chapter03.blowUpMap]
        constructor
        · rintro ⟨z, hz, rfl⟩
          rwa [smul_inv_smul₀ hr.ne', sub_add_cancel]
        · intro hw
          exact ⟨r • w + y, hw, by rw [add_sub_cancel_right, inv_smul_smul₀ hr.ne']⟩
      rw [this]
      exact hZ.preimage (by fun_prop)
    have hintOn : ∀ Z : Set (Euclid P), MeasurableSet Z →
        μHE[n] (Z ∩ closedBall 0 L) ≠ ∞ → IntegrableOn f Z μHE[n] := by
      intro Z hZ hZfin
      have h1 : IntegrableOn f (Z ∩ closedBall 0 L) μHE[n] :=
        Measure.integrableOn_of_bounded hZfin hfc.aestronglyMeasurable (M := C)
          (Eventually.of_forall hC)
      exact h1.of_forall_sdiff_eq_zero hZ (fun z hz => hfL z (fun h => hz.2 ⟨hz.1, h⟩))
    have hnormle : ∀ Z : Set (Euclid P), MeasurableSet Z →
        μHE[n] (Z ∩ closedBall 0 L) ≠ ∞ →
        ‖∫ z in Z, f z ∂μHE[n]‖ ≤ C * (μHE[n] : Measure (Euclid P)).real (Z ∩ closedBall 0 L) := by
      intro Z hZ hZfin
      rw [setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hZ inter_subset_left
        (fun z hz => hfL z (fun h => hz.2 ⟨hz.1, h⟩))]
      exact norm_setIntegral_le_of_norm_le_const hZfin.lt_top (fun z _ => hC z)
    -- the scaling identity: reused child `regcomp_atl_blowUp_measure_scaling`
    have hscale : ∀ r : ℝ, 0 < r → ∀ Z : Set (Euclid P),
        μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap y r '' Z ∩ closedBall 0 L) =
          (ENNReal.ofReal r)⁻¹ ^ n * μHE[n] (Z ∩ closedBall y (r * L)) :=
      fun r hr Z => Submission.regcomp_atl_blowUp_measure_scaling P n y r L Z hr
    have hfinS : ∀ Z ⊆ A ∪ A', ∀ r, 0 < r → r * L ≤ s →
        μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap y r '' Z ∩ closedBall 0 L) ≠ ∞ := by
      intro Z hZ r hr hrs
      rw [hscale r hr]
      refine ENNReal.mul_ne_top (ENNReal.pow_ne_top
        (ENNReal.inv_ne_top.2 (ENNReal.ofReal_pos.2 hr).ne')) ?_
      apply ne_top_of_le_ne_top (ENNReal.add_ne_top.mpr ⟨hAfin, hA'fin⟩)
      calc μHE[n] (Z ∩ closedBall y (r * L))
          ≤ μHE[n] ((A ∩ closedBall y s) ∪ (A' ∩ closedBall y s)) := by
            apply measure_mono
            rintro z ⟨hzZ, hzB⟩
            have hzB' : z ∈ closedBall y s := closedBall_subset_closedBall hrs hzB
            rcases hZ hzZ with h | h
            · exact Or.inl ⟨h, hzB'⟩
            · exact Or.inr ⟨h, hzB'⟩
        _ ≤ _ := measure_union_le _ _
    have hbound : ∀ᶠ r in 𝓝[>] (0 : ℝ),
        ‖(∫ z in Poincare.SimonGMT.Chapter03.blowUpMap y r '' A', f z ∂μHE[n]) -
            ∫ z in Poincare.SimonGMT.Chapter03.blowUpMap y r '' A, f z ∂μHE[n]‖ ≤
          2 * C * (L ^ n * (μHE[n] (D ∩ closedBall y (r * L)) /
            ENNReal.ofReal ((r * L) ^ n)).toReal) := by
      have hpos : ∀ᶠ r in 𝓝[>] (0 : ℝ), 0 < r ∧ r * L ≤ s := by
        filter_upwards [Ioo_mem_nhdsGT (div_pos hs hL)] with r hr
        refine ⟨hr.1, ?_⟩
        have := hr.2
        rw [lt_div_iff₀ hL] at this
        linarith
      filter_upwards [hpos] with r ⟨hr, hrs⟩
      set η := Poincare.SimonGMT.Chapter03.blowUpMap y r with hη
      have hinjr : Injective η := hinj r hr
      have hsub1 : A' ∩ A ⊆ A ∪ A' := fun z hz => Or.inl hz.2
      have hsub2 : A' \ A ⊆ A ∪ A' := fun z hz => Or.inr hz.1
      have hsub3 : A \ A' ⊆ A ∪ A' := fun z hz => Or.inl hz.1
      have hsubD : D ⊆ A ∪ A' := union_subset hsub3 hsub2
      have hI1 := hintOn _ (hmeasIm r hr _ (hA'.inter hA)) (hfinS _ hsub1 r hr hrs)
      have hI2 := hintOn _ (hmeasIm r hr _ (hA'.diff hA)) (hfinS _ hsub2 r hr hrs)
      have hI3 := hintOn _ (hmeasIm r hr _ (hA.diff hA')) (hfinS _ hsub3 r hr hrs)
      have hsplitA' : η '' A' = η '' (A' ∩ A) ∪ η '' (A' \ A) := by
        rw [← image_union, inter_union_sdiff]
      have hsplitA : η '' A = η '' (A' ∩ A) ∪ η '' (A \ A') := by
        rw [← image_union, inter_comm, inter_union_sdiff]
      have hdisj1 : Disjoint (η '' (A' ∩ A)) (η '' (A' \ A)) :=
        (disjoint_image_iff hinjr).mpr (disjoint_sdiff_inter.symm)
      have hdisj2 : Disjoint (η '' (A' ∩ A)) (η '' (A \ A')) := by
        rw [disjoint_image_iff hinjr, inter_comm]
        exact disjoint_sdiff_inter.symm
      rw [hsplitA', hsplitA, setIntegral_union hdisj1 (hmeasIm r hr _ (hA'.diff hA)) hI1 hI2,
        setIntegral_union hdisj2 (hmeasIm r hr _ (hA.diff hA')) hI1 hI3]
      have hfinD := hfinS D hsubD r hr hrs
      have hmono2 : (μHE[n] : Measure (Euclid P)).real (η '' (A' \ A) ∩ closedBall 0 L) ≤
          (μHE[n] : Measure (Euclid P)).real (η '' D ∩ closedBall 0 L) :=
        measureReal_mono (inter_subset_inter_left _ (image_mono subset_union_right)) hfinD
      have hmono3 : (μHE[n] : Measure (Euclid P)).real (η '' (A \ A') ∩ closedBall 0 L) ≤
          (μHE[n] : Measure (Euclid P)).real (η '' D ∩ closedBall 0 L) :=
        measureReal_mono (inter_subset_inter_left _ (image_mono subset_union_left)) hfinD
      have hn2 := hnormle _ (hmeasIm r hr _ (hA'.diff hA)) (hfinS _ hsub2 r hr hrs)
      have hn3 := hnormle _ (hmeasIm r hr _ (hA.diff hA')) (hfinS _ hsub3 r hr hrs)
      have hC0 : 0 ≤ C := (norm_nonneg _).trans (hC 0)
      have hkey : (μHE[n] : Measure (Euclid P)).real (η '' D ∩ closedBall 0 L) =
          L ^ n * (μHE[n] (D ∩ closedBall y (r * L)) / ENNReal.ofReal ((r * L) ^ n)).toReal := by
        have hfin' : μHE[n] (D ∩ closedBall y (r * L)) ≠ ∞ := by
          have h0 := hfinD
          rw [hscale r hr] at h0
          have ha0 : (ENNReal.ofReal r)⁻¹ ^ n ≠ 0 :=
            pow_ne_zero _ (ENNReal.inv_ne_zero.2 ENNReal.ofReal_ne_top)
          exact fun hb => h0 (ENNReal.mul_eq_top.mpr (Or.inl ⟨ha0, hb⟩))
        rw [measureReal_def, hscale r hr, ENNReal.toReal_mul, ENNReal.toReal_div,
          ENNReal.toReal_ofReal (by positivity), ENNReal.toReal_pow, ENNReal.toReal_inv,
          ENNReal.toReal_ofReal hr.le, mul_pow]
        have hrn : r ^ n ≠ 0 := pow_ne_zero n hr.ne'
        have hLn : L ^ n ≠ 0 := pow_ne_zero n hL.ne'
        rw [inv_pow, mul_div_assoc', mul_comm (L ^ n), mul_div_mul_right _ _ hLn, div_eq_inv_mul]
      calc ‖(∫ z in η '' (A' ∩ A), f z ∂μHE[n]) + (∫ z in η '' (A' \ A), f z ∂μHE[n]) -
            ((∫ z in η '' (A' ∩ A), f z ∂μHE[n]) + ∫ z in η '' (A \ A'), f z ∂μHE[n])‖
          = ‖(∫ z in η '' (A' \ A), f z ∂μHE[n]) - ∫ z in η '' (A \ A'), f z ∂μHE[n]‖ := by
            congr 1; ring
        _ ≤ ‖∫ z in η '' (A' \ A), f z ∂μHE[n]‖ + ‖∫ z in η '' (A \ A'), f z ∂μHE[n]‖ :=
            norm_sub_le _ _
        _ ≤ C * (μHE[n] : Measure (Euclid P)).real (η '' (A' \ A) ∩ closedBall 0 L) +
            C * (μHE[n] : Measure (Euclid P)).real (η '' (A \ A') ∩ closedBall 0 L) :=
            add_le_add hn2 hn3
        _ ≤ C * (μHE[n] : Measure (Euclid P)).real (η '' D ∩ closedBall 0 L) +
            C * (μHE[n] : Measure (Euclid P)).real (η '' D ∩ closedBall 0 L) :=
            add_le_add (mul_le_mul_of_nonneg_left hmono2 hC0)
              (mul_le_mul_of_nonneg_left hmono3 hC0)
        _ = 2 * C * (L ^ n * (μHE[n] (D ∩ closedBall y (r * L)) /
              ENNReal.ofReal ((r * L) ^ n)).toReal) := by
            rw [hkey]; ring
    have hlim : Tendsto (fun r : ℝ => 2 * C * (L ^ n * (μHE[n] (D ∩ closedBall y (r * L)) /
        ENNReal.ofReal ((r * L) ^ n)).toReal)) (𝓝[>] 0) (𝓝 0) := by
      have hmap : Tendsto (fun r : ℝ => r * L) (𝓝[>] 0) (𝓝[>] 0) := by
        apply tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within
        · have h0 : Tendsto (fun r : ℝ => r * L) (𝓝 0) (𝓝 (0 * L)) :=
            (continuous_id.mul continuous_const).tendsto 0
          rw [zero_mul] at h0
          exact h0.mono_left nhdsWithin_le_nhds
        · filter_upwards [self_mem_nhdsWithin] with r hr
          exact mul_pos hr hL
      have h1 := hD.comp hmap
      have h2 := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp h1
      have h3 := (h2.const_mul (L ^ n)).const_mul (2 * C)
      simpa [Function.comp_def] using h3
    have hdiff := squeeze_zero_norm' hbound hlim
    have h3 := (hTA.2 f).add hdiff
    simp only [add_zero, add_sub_cancel] at h3
    exact h3
  -- Steps 2–3 combined: a.e. on `A ∩ B` the tangent spaces of `A` and `B` coincide
  have F3 : ∀ A B : Set (Euclid P), MeasurableSet A → MeasurableSet B → A ⊆ U → B ⊆ U →
      (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (A ∩ K) ≠ ∞) →
      (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (B ∩ K) ≠ ∞) →
      ∀ᵐ y ∂(μHE[n].restrict (A ∩ B)), ∀ Q : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt n A y Q ↔ HasApproximateTangentSpaceAt n B y Q := by
    intro A B hA hB hAU hBU hAfin hBfin
    set D : Set (Euclid P) := (A \ B) ∪ (B \ A) with hD
    have hDmeas : MeasurableSet D := (hA.diff hB).union (hB.diff hA)
    have hDfin : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (D ∩ K) ≠ ∞ := by
      intro K hK hKU
      refine ne_top_of_le_ne_top (ENNReal.add_ne_top.2 ⟨hAfin K hK hKU, hBfin K hK hKU⟩) ?_
      calc μHE[n] (D ∩ K) ≤ μHE[n] ((A ∩ K) ∪ (B ∩ K)) := by
            apply measure_mono
            rintro x ⟨hx | hx, hxK⟩
            · exact Or.inl ⟨hx.1, hxK⟩
            · exact Or.inr ⟨hx.1, hxK⟩
        _ ≤ μHE[n] (A ∩ K) + μHE[n] (B ∩ K) := measure_union_le _ _
    have h1 := F1 D hDmeas hDfin
    have h1' : ∀ᵐ y ∂(μHE[n].restrict (A ∩ B)), y ∈ U → y ∉ D →
        Tendsto (fun ρ : ℝ => μHE[n] (D ∩ closedBall y ρ) / ENNReal.ofReal (ρ ^ n))
          (𝓝[>] 0) (𝓝 0) :=
      ae_restrict_of_ae h1
    filter_upwards [h1', ae_restrict_mem (hA.inter hB)] with y hy hyAB
    have hyU : y ∈ U := hAU hyAB.1
    have hyD : y ∉ D := by
      rintro (h | h)
      · exact h.2 hyAB.2
      · exact h.2 hyAB.1
    have hdens := hy hyU hyD
    obtain ⟨s, hs, hsU⟩ : ∃ s > 0, closedBall y s ⊆ U := by
      obtain ⟨ε, hε, hεU⟩ := Metric.isOpen_iff.1 hU y hyU
      exact ⟨ε / 2, by positivity, (closedBall_subset_ball (by linarith)).trans hεU⟩
    have hK : IsCompact (closedBall y s) := isCompact_closedBall y s
    have hAs := hAfin _ hK hsU
    have hBs := hBfin _ hK hsU
    intro Q
    constructor
    · intro hQ
      exact F2 A B y Q s hA hB hs hAs hBs hdens hQ
    · intro hQ
      have hdens' : Tendsto (fun ρ : ℝ => μHE[n] (((B \ A) ∪ (A \ B)) ∩ closedBall y ρ) /
          ENNReal.ofReal (ρ ^ n)) (𝓝[>] 0) (𝓝 0) := by
        simpa only [hD, Set.union_comm] using hdens
      exact F2 B A y Q s hB hA hs hBs hAs hdens' hQ
  -- Step 6 with Step 4 (reused child `rsdic_unitOrientation_eq_or_eq_neg`):
  -- `ξ₂ = ±ξ₁` a.e. on `M₁ ∩ M₂`
  have hov : ∀ᵐ x ∂(μHE[n].restrict (R₁.carrier ∩ R₂.carrier)),
      R₂.orient x = R₁.orient x ∨ R₂.orient x = -R₁.orient x := by
    have hL := F3 R₁.carrier R₂.carrier R₁.measurableSet_carrier R₂.measurableSet_carrier
      R₁.carrier_subset R₂.carrier_subset (hfin R₁) (hfin R₂)
    have ho₁ : ∀ᵐ x ∂(μHE[n].restrict (R₁.carrier ∩ R₂.carrier)), ∃ Q : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt n R₁.carrier x Q ∧ IsUnitOrientationOf (R₁.orient x) Q :=
      ae_restrict_of_ae_restrict_of_subset inter_subset_left R₁.orients
    have ho₂ : ∀ᵐ x ∂(μHE[n].restrict (R₁.carrier ∩ R₂.carrier)), ∃ Q : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt n R₂.carrier x Q ∧ IsUnitOrientationOf (R₂.orient x) Q :=
      ae_restrict_of_ae_restrict_of_subset inter_subset_right R₂.orients
    filter_upwards [hL, ho₁, ho₂] with x hx h₁ h₂
    obtain ⟨Q₁, hT₁, hO₁⟩ := h₁
    obtain ⟨Q₂, hT₂, hO₂⟩ := h₂
    have hT₁' : HasApproximateTangentSpaceAt n R₂.carrier x Q₁ := (hx Q₁).1 hT₁
    have hQ : Q₁ = Q₂ := hT₁'.unique hT₂
    subst hQ
    exact Submission.rsdic_unitOrientation_eq_or_eq_neg P n (R₁.orient x) (R₂.orient x) Q₁ hO₁ hO₂
  -- Step 8: IMRep fields for sub-data of `R₁`, `R₂`
  have recombine : ∀ (M : Set (Euclid P)) (m : Euclid P → ℕ) (ζ : Euclid P → MultiVector P n),
      MeasurableSet M → M ⊆ R₁.carrier ∪ R₂.carrier → Measurable m → (∀ x ∈ M, 0 < m x) →
      (∀ x ∈ M, m x ≤ R₁.carrier.indicator R₁.mult x + R₂.carrier.indicator R₂.mult x) →
      AEStronglyMeasurable ζ (μHE[n].restrict M) →
      (∀ᵐ x ∂(μHE[n].restrict (M ∩ R₁.carrier)), ζ x = R₁.orient x ∨ ζ x = -R₁.orient x) →
      (∀ᵐ x ∂(μHE[n].restrict (M \ R₁.carrier)), ζ x = R₂.orient x ∨ ζ x = -R₂.orient x) →
      ∃ R : IMRep U n, R.carrier = M ∧ R.mult = m ∧ R.orient = ζ := by
    intro M m ζ hM hMsub hm hmpos hmle hζ h₁ h₂
    have hMU : M ⊆ U := hMsub.trans (union_subset R₁.carrier_subset R₂.carrier_subset)
    have hMfin : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M ∩ K) ≠ ∞ := by
      intro K hK hKU
      refine ne_top_of_le_ne_top (ENNReal.add_ne_top.2 ⟨hfin R₁ K hK hKU, hfin R₂ K hK hKU⟩) ?_
      calc μHE[n] (M ∩ K) ≤ μHE[n] ((R₁.carrier ∩ K) ∪ (R₂.carrier ∩ K)) := by
            apply measure_mono
            rintro x ⟨hx, hxK⟩
            rcases hMsub hx with h | h
            · exact Or.inl ⟨h, hxK⟩
            · exact Or.inr ⟨h, hxK⟩
        _ ≤ _ := measure_union_le _ _
    have hneg : ∀ (ξ : MultiVector P n) (Q : Submodule ℝ (Euclid P)),
        IsUnitOrientationOf ξ Q → IsUnitOrientationOf (-ξ) Q := by
      rintro ξ Q ⟨τ, hτ, hspan, h | h⟩
      · exact ⟨τ, hτ, hspan, Or.inr fun α => by simp [h α]⟩
      · exact ⟨τ, hτ, hspan, Or.inl fun α => by simp [h α]⟩
    have hpm : ∀ (ξ ξ' : MultiVector P n) (Q : Submodule ℝ (Euclid P)),
        IsUnitOrientationOf ξ' Q → (ξ = ξ' ∨ ξ = -ξ') → IsUnitOrientationOf ξ Q := by
      rintro ξ ξ' Q hO (h | h)
      · rw [h]; exact hO
      · rw [h]; exact hneg _ _ hO
    have horient : ∀ᵐ x ∂(μHE[n].restrict M), ∃ Q : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt n M x Q ∧ IsUnitOrientationOf (ζ x) Q := by
      have key : ∀ᵐ x ∂(μHE[n].restrict ((M ∩ R₁.carrier) ∪ (M \ R₁.carrier))),
          ∃ Q : Submodule ℝ (Euclid P),
            HasApproximateTangentSpaceAt n M x Q ∧ IsUnitOrientationOf (ζ x) Q := by
        rw [ae_restrict_union_iff]
        constructor
        · have hL := F3 M R₁.carrier hM R₁.measurableSet_carrier hMU R₁.carrier_subset hMfin
            (hfin R₁)
          have ho := ae_restrict_of_ae_restrict_of_subset (inter_subset_right (s := M))
            R₁.orients
          filter_upwards [hL, ho, h₁] with x hx hox hζx
          obtain ⟨Q, hTQ, hO⟩ := hox
          exact ⟨Q, (hx Q).2 hTQ, hpm _ _ _ hO hζx⟩
        · have hL := F3 M R₂.carrier hM R₂.measurableSet_carrier hMU R₂.carrier_subset hMfin
            (hfin R₂)
          have hsub : M \ R₁.carrier ⊆ M ∩ R₂.carrier :=
            fun x hx => ⟨hx.1, (hMsub hx.1).resolve_left hx.2⟩
          have hL' := ae_restrict_of_ae_restrict_of_subset hsub hL
          have ho := ae_restrict_of_ae_restrict_of_subset (hsub.trans inter_subset_right)
            R₂.orients
          filter_upwards [hL', ho, h₂] with x hx hox hζx
          obtain ⟨Q, hTQ, hO⟩ := hox
          exact ⟨Q, (hx Q).2 hTQ, hpm _ _ _ hO hζx⟩
      rwa [inter_union_sdiff] at key
    have hrect : CountablyRectifiable n M := by
      have hU12 : CountablyRectifiable n
          (⋃ i : ℕ, (if i = 0 then R₁.carrier else R₂.carrier)) := by
        apply Poincare.SimonGMT.Chapter03.countablyRectifiable_iUnion
        intro i
        split_ifs
        · exact R₁.rectifiable
        · exact R₂.rectifiable
      apply hU12.mono
      intro x hx
      rcases hMsub hx with h | h
      · exact mem_iUnion.2 ⟨0, by simpa using h⟩
      · exact mem_iUnion.2 ⟨1, by simpa using h⟩
    have hint : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
        ∫⁻ x in M ∩ K, (m x : ℝ≥0∞) ∂μHE[n] ≠ ∞ := by
      intro K hK hKU
      have hm1 : Measurable fun x => (R₁.mult x : ℝ≥0∞) :=
        measurable_from_nat.comp R₁.measurable_mult
      have hS1 : MeasurableSet (R₁.carrier ∩ K) :=
        R₁.measurableSet_carrier.inter hK.measurableSet
      have hS2 : MeasurableSet (R₂.carrier ∩ K) :=
        R₂.measurableSet_carrier.inter hK.measurableSet
      have hbound : ∫⁻ x in M ∩ K, (m x : ℝ≥0∞) ∂μHE[n] ≤
          ∫⁻ x in R₁.carrier ∩ K, (R₁.mult x : ℝ≥0∞) ∂μHE[n] +
            ∫⁻ x in R₂.carrier ∩ K, (R₂.mult x : ℝ≥0∞) ∂μHE[n] := by
        calc ∫⁻ x in M ∩ K, (m x : ℝ≥0∞) ∂μHE[n]
            ≤ ∫⁻ x in M ∩ K, ((R₁.carrier ∩ K).indicator (fun x => (R₁.mult x : ℝ≥0∞)) x +
                (R₂.carrier ∩ K).indicator (fun x => (R₂.mult x : ℝ≥0∞)) x) ∂μHE[n] := by
              apply setLIntegral_mono' (hM.inter hK.measurableSet)
              intro x hx
              have h := hmle x hx.1
              have hxK := hx.2
              by_cases h1 : x ∈ R₁.carrier <;> by_cases h2 : x ∈ R₂.carrier <;>
                simp [h1, h2, hxK] at h ⊢ <;> exact_mod_cast h
          _ ≤ ∫⁻ x, ((R₁.carrier ∩ K).indicator (fun x => (R₁.mult x : ℝ≥0∞)) x +
                (R₂.carrier ∩ K).indicator (fun x => (R₂.mult x : ℝ≥0∞)) x) ∂μHE[n] :=
              setLIntegral_le_lintegral _ _
          _ = _ := by
              rw [lintegral_add_left (hm1.indicator hS1), lintegral_indicator hS1,
                lintegral_indicator hS2]
      exact ne_top_of_le_ne_top (ENNReal.add_ne_top.2 ⟨R₁.locallyIntegrable_mult K hK hKU,
        R₂.locallyIntegrable_mult K hK hKU⟩) hbound
    exact ⟨⟨M, m, ζ, hM, hMU, hrect, hm, hmpos, hint, hζ, horient⟩, rfl, rfl, rfl⟩
  -- Steps 5–7: Borel orientations, Borel sign, the new data `(M, m, ζ)`
  obtain ⟨R, hR⟩ : ∃ R : IMRep U n, ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)),
      ∀ α : Covector (Euclid P) n,
        R.carrier.indicator (fun y => (R.mult y : ℝ) * R.orient y α) x =
          R₁.carrier.indicator (fun y => (R₁.mult y : ℝ) * R₁.orient y α) x -
            R₂.carrier.indicator (fun y => (R₂.mult y : ℝ) * R₂.orient y α) x := by
    have : TopologicalSpace.MetrizableSpace (MultiVector P n) := by
      let M : MetricSpace (MultiVector P n) := inferInstance
      have h1 : @TopologicalSpace.PseudoMetrizableSpace (MultiVector P n)
          (PseudoMetricSpace.toUniformSpace.toTopologicalSpace) :=
        @UniformSpace.pseudoMetrizableSpace (MultiVector P n) PseudoMetricSpace.toUniformSpace
          inferInstance
      have h2 : @T0Space (MultiVector P n)
          (PseudoMetricSpace.toUniformSpace.toTopologicalSpace) := inferInstance
      exact @TopologicalSpace.MetrizableSpace.mk _ _ h1 h2
    have : ContinuousNeg (MultiVector P n) := by
      exact @IsTopologicalAddGroup.toContinuousNeg _ _ _ ContinuousLinearMap.isTopologicalAddGroup
    set M₁ := R₁.carrier with hM₁def
    set M₂ := R₂.carrier with hM₂def
    have hM₁ : MeasurableSet M₁ := R₁.measurableSet_carrier
    have hM₂ : MeasurableSet M₂ := R₂.measurableSet_carrier
    set ξt₁ := R₁.aestronglyMeasurable_orient.mk R₁.orient with hξt₁def
    set ξt₂ := R₂.aestronglyMeasurable_orient.mk R₂.orient with hξt₂def
    have hs₁ : StronglyMeasurable ξt₁ := R₁.aestronglyMeasurable_orient.stronglyMeasurable_mk
    have hs₂ : StronglyMeasurable ξt₂ := R₂.aestronglyMeasurable_orient.stronglyMeasurable_mk
    have he₁ : ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)), x ∈ M₁ → R₁.orient x = ξt₁ x :=
      (ae_restrict_iff' hM₁).1 R₁.aestronglyMeasurable_orient.ae_eq_mk
    have he₂ : ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)), x ∈ M₂ → R₂.orient x = ξt₂ x :=
      (ae_restrict_iff' hM₂).1 R₂.aestronglyMeasurable_orient.ae_eq_mk
    have hov' : ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)), x ∈ M₁ ∩ M₂ →
        R₂.orient x = R₁.orient x ∨ R₂.orient x = -R₁.orient x :=
      (ae_restrict_iff' (hM₁.inter hM₂)).1 hov
    set σ : Euclid P → ℤ := fun x => if ξt₂ x = ξt₁ x then 1 else -1 with hσdef
    have hσmeas : Measurable σ :=
      Measurable.ite (hs₂.measurableSet_eq_fun hs₁) measurable_const measurable_const
    set d : Euclid P → ℤ := fun x => (R₁.mult x : ℤ) - σ x * (R₂.mult x : ℤ) with hddef
    have hdmeas : Measurable d := by
      have h1 : Measurable fun x => (R₁.mult x : ℤ) := measurable_from_nat.comp R₁.measurable_mult
      have h2 : Measurable fun x => (R₂.mult x : ℤ) := measurable_from_nat.comp R₂.measurable_mult
      exact h1.sub (hσmeas.mul h2)
    set G : Set (Euclid P) := {x | x ∈ M₁ ∩ M₂ ∧ d x ≠ 0} with hGdef
    have hG : MeasurableSet G :=
      (hM₁.inter hM₂).inter (hdmeas (measurableSet_singleton 0).compl)
    set M : Set (Euclid P) := (M₁ \ M₂) ∪ (M₂ \ M₁) ∪ G with hMdef
    have hM : MeasurableSet M := ((hM₁.diff hM₂).union (hM₂.diff hM₁)).union hG
    set m : Euclid P → ℕ := fun x => if x ∈ M₁ \ M₂ then R₁.mult x
      else if x ∈ M₂ \ M₁ then R₂.mult x else if x ∈ M₁ ∩ M₂ then (d x).natAbs else 0
      with hmdef
    set ζ : Euclid P → MultiVector P n := fun x => if x ∈ M₁ \ M₂ then ξt₁ x
      else if x ∈ M₂ \ M₁ then -ξt₂ x else if 0 < d x then ξt₁ x else -ξt₁ x with hζdef
    have hmmeas : Measurable m := by
      refine Measurable.ite (hM₁.diff hM₂) R₁.measurable_mult
        (Measurable.ite (hM₂.diff hM₁) R₂.measurable_mult
          (Measurable.ite (hM₁.inter hM₂)
            ((Measurable.of_discrete (f := Int.natAbs)).comp hdmeas) measurable_const))
    have hζmeas : StronglyMeasurable ζ := by
      refine StronglyMeasurable.ite (hM₁.diff hM₂) hs₁
        (StronglyMeasurable.ite (hM₂.diff hM₁) hs₂.neg (StronglyMeasurable.ite ?_ hs₁ hs₁.neg))
      exact hdmeas (measurableSet_Ioi (a := (0 : ℤ)))
    have hMsub : M ⊆ M₁ ∪ M₂ := by
      rintro x ((h | h) | h)
      · exact Or.inl h.1
      · exact Or.inr h.1
      · exact Or.inl h.1.1
    have hmpos : ∀ x ∈ M, 0 < m x := by
      rintro x ((h | h) | h)
      · simp only [hmdef, ite_eq_left h]; exact R₁.mult_pos x h.1
      · have hn : x ∉ M₁ \ M₂ := fun h' => h.2 h'.1
        simp only [hmdef, ite_eq_right hn, ite_eq_left h]; exact R₂.mult_pos x h.1
      · have hn1 : x ∉ M₁ \ M₂ := fun h' => h'.2 h.1.2
        have hn2 : x ∉ M₂ \ M₁ := fun h' => h'.2 h.1.1
        simp only [hmdef, ite_eq_right hn1, ite_eq_right hn2, ite_eq_left h.1]
        exact Int.natAbs_pos.2 h.2
    have hσpm : ∀ x, σ x = 1 ∨ σ x = -1 := by
      intro x; simp only [hσdef]; split_ifs <;> simp
    have hmle : ∀ x ∈ M, m x ≤ M₁.indicator R₁.mult x + M₂.indicator R₂.mult x := by
      rintro x ((h | h) | h)
      · simp only [hmdef, ite_eq_left h, indicator_of_mem h.1, indicator_of_notMem h.2]; omega
      · have hn : x ∉ M₁ \ M₂ := fun h' => h.2 h'.1
        simp only [hmdef, ite_eq_right hn, ite_eq_left h, indicator_of_mem h.1, indicator_of_notMem h.2]
        omega
      · have hn1 : x ∉ M₁ \ M₂ := fun h' => h'.2 h.1.2
        have hn2 : x ∉ M₂ \ M₁ := fun h' => h'.2 h.1.1
        simp only [hmdef, ite_eq_right hn1, ite_eq_right hn2, ite_eq_left h.1, indicator_of_mem h.1.1,
          indicator_of_mem h.1.2]
        simp only [hddef]
        rcases hσpm x with hs | hs <;> rw [hs] <;> omega
    have h₁ : ∀ᵐ x ∂(μHE[n].restrict (M ∩ M₁)), ζ x = R₁.orient x ∨ ζ x = -R₁.orient x := by
      rw [ae_restrict_iff' (hM.inter hM₁)]
      filter_upwards [he₁] with x hx hxM
      have hxe := hx hxM.2
      rcases hxM.1 with (h | h) | h
      · left; simp only [hζdef, ite_eq_left h]; exact hxe.symm
      · exact absurd hxM.2 h.2
      · have hn1 : x ∉ M₁ \ M₂ := fun h' => h'.2 h.1.2
        have hn2 : x ∉ M₂ \ M₁ := fun h' => h'.2 h.1.1
        simp only [hζdef, ite_eq_right hn1, ite_eq_right hn2]
        split_ifs
        · left; exact hxe.symm
        · right; rw [hxe]
    have h₂ : ∀ᵐ x ∂(μHE[n].restrict (M \ M₁)), ζ x = R₂.orient x ∨ ζ x = -R₂.orient x := by
      rw [ae_restrict_iff' (hM.diff hM₁)]
      filter_upwards [he₂] with x hx hxM
      have hx2 : x ∈ M₂ \ M₁ := ⟨(hMsub hxM.1).resolve_left hxM.2, hxM.2⟩
      have hn1 : x ∉ M₁ \ M₂ := fun h' => hxM.2 h'.1
      right; simp only [hζdef, ite_eq_right hn1, ite_eq_left hx2]; rw [hx hx2.1]
    obtain ⟨R, hRc, hRm, hRo⟩ := recombine M m ζ hM hMsub hmmeas hmpos hmle
      hζmeas.aestronglyMeasurable h₁ h₂
    refine ⟨R, ?_⟩
    rw [hRc, hRm, hRo]
    filter_upwards [he₁, he₂, hov'] with x hx₁ hx₂ hx₃
    intro α
    by_cases hA : x ∈ M₁ <;> by_cases hB : x ∈ M₂
    · -- overlap
      have hAB : x ∈ M₁ ∩ M₂ := ⟨hA, hB⟩
      have hn1 : x ∉ M₁ \ M₂ := fun h' => h'.2 hB
      have hn2 : x ∉ M₂ \ M₁ := fun h' => h'.2 hA
      have e₁ := hx₁ hA
      have e₂ := hx₂ hB
      have hsig : R₂.orient x α = ((σ x : ℤ) : ℝ) * R₁.orient x α := by
        rcases hx₃ hAB with h | h
        · have : ξt₂ x = ξt₁ x := by rw [← e₁, ← e₂, h]
          simp only [hσdef, ite_eq_left this]; simp [h]
        · by_cases hq : ξt₂ x = ξt₁ x
          · have : R₂.orient x = R₁.orient x := by rw [e₁, e₂, hq]
            simp only [hσdef, ite_eq_left hq]; simp [this]
          · simp only [hσdef, ite_eq_right hq]; simp [h]
      rw [indicator_of_mem hA, indicator_of_mem hB, hsig]
      have hcoef : (R₁.mult x : ℝ) * R₁.orient x α -
          (R₂.mult x : ℝ) * (((σ x : ℤ) : ℝ) * R₁.orient x α) =
          ((d x : ℤ) : ℝ) * R₁.orient x α := by
        simp only [hddef]; push_cast; ring
      rw [hcoef]
      rcases lt_trichotomy (d x) 0 with hd | hd | hd
      · have hxM : x ∈ M := Or.inr ⟨hAB, hd.ne⟩
        rw [indicator_of_mem hxM]
        simp only [hmdef, hζdef, ite_eq_right hn1, ite_eq_right hn2, ite_eq_left hAB, ite_eq_right (not_lt.2 hd.le)]
        have hc : (((d x).natAbs : ℕ) : ℝ) = -((d x : ℤ) : ℝ) := by
          have h1 : ((d x).natAbs : ℤ) = -(d x) := Int.ofNat_natAbs_of_nonpos hd.le
          have h2 : ((((d x).natAbs : ℕ) : ℤ) : ℝ) = ((-(d x) : ℤ) : ℝ) := by rw [h1]
          simpa using h2
        rw [hc, neg_apply, e₁]; ring
      · have hxM : x ∉ M := by
          rintro ((h | h) | h)
          · exact hn1 h
          · exact hn2 h
          · exact h.2 hd
        rw [indicator_of_notMem hxM, hd]; simp
      · have hxM : x ∈ M := Or.inr ⟨hAB, hd.ne'⟩
        rw [indicator_of_mem hxM]
        simp only [hmdef, hζdef, ite_eq_right hn1, ite_eq_right hn2, ite_eq_left hAB, ite_eq_left hd]
        have hc : (((d x).natAbs : ℕ) : ℝ) = ((d x : ℤ) : ℝ) := by
          have h1 : ((d x).natAbs : ℤ) = d x := Int.natAbs_of_nonneg hd.le
          have h2 : ((((d x).natAbs : ℕ) : ℤ) : ℝ) = ((d x : ℤ) : ℝ) := by rw [h1]
          simpa using h2
        rw [hc, e₁]
    · -- only in `M₁`
      have h : x ∈ M₁ \ M₂ := ⟨hA, hB⟩
      have hxM : x ∈ M := Or.inl (Or.inl h)
      rw [indicator_of_mem hxM, indicator_of_mem hA, indicator_of_notMem hB, sub_zero]
      simp only [hmdef, hζdef, ite_eq_left h]
      rw [hx₁ hA]
    · -- only in `M₂`
      have h : x ∈ M₂ \ M₁ := ⟨hB, hA⟩
      have hn : x ∉ M₁ \ M₂ := fun h' => hA h'.1
      have hxM : x ∈ M := Or.inl (Or.inr h)
      rw [indicator_of_mem hxM, indicator_of_notMem hA, indicator_of_mem hB, zero_sub]
      simp only [hmdef, hζdef, ite_eq_right hn, ite_eq_left h]
      rw [hx₂ hB, neg_apply]; ring
    · -- outside both
      have hxM : x ∉ M := fun h => (hMsub h).elim hA hB
      rw [indicator_of_notMem hxM, indicator_of_notMem hA, indicator_of_notMem hB, sub_zero]
  -- Step 9 (reused child `rsdic_imrep_action_int_combination` with `p₁ = 1`, `p₂ = -1`)
  have hRv : ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)),
      R.carrier.indicator (fun y => (R.mult y : ℝ) • R.orient y) x =
        ((1 : ℤ) : ℝ) • R₁.carrier.indicator (fun y => (R₁.mult y : ℝ) • R₁.orient y) x +
          ((-1 : ℤ) : ℝ) • R₂.carrier.indicator (fun y => (R₂.mult y : ℝ) • R₂.orient y) x := by
    filter_upwards [hR] with x hx
    ext α
    have h := hx α
    rw [add_apply, smul_apply, smul_apply, smul_eq_mul, smul_eq_mul]
    by_cases h0 : x ∈ R.carrier <;> by_cases h1 : x ∈ R₁.carrier <;>
      by_cases h2 : x ∈ R₂.carrier <;>
      simp only [indicator_of_mem, indicator_of_notMem, h0, h1, h2, not_false_eq_true,
        smul_apply, smul_eq_mul, zero_apply] at h ⊢ <;> push_cast <;> linarith
  refine ⟨R, fun ω => ?_⟩
  rw [Submission.rsdic_imrep_action_int_combination P n U R₁ R₂ R 1 (-1) hRv ω, ← hR₁ ω,
    ← hR₂ ω]
  have hsub : (S - T) ω = S ω - T ω := rfl
  rw [hsub]
  push_cast
  ring

/-- **Simon Ch. 6, 3.6–3.9 and 2.29 for `n = 0`**: the Lipschitz push-forward of a finite-mass
`0`-dimensional integer multiplicity current.  `H⁰ = μHE[0]` is counting measure, so
`H⁰(M) ≤ μ_R(ℝᴺ) < ∞` makes the carrier `M` finite and `H⁰⌞M`-a.e. statements hold on all of `M`;
there each `ξ(x)` is `ε(x) ev` with `ε(x) = ±1`.  `Y(F)(ω) = ∑_{x ∈ M} θ(x) ε(x) ω(F(x))(∅)` is a
current, `R.action(F_j^# ω)` is the same finite sum with `F_j` in place of `F` (so it converges to
`Y(F)(ω)`), and `Y(F)` depends only on `F` on `M`.  Regrouping by the fibres of `F`,
`Y(F) = τ(M', |c|, sign(c) ev)` with `c(y) = ∑_{F(x) = y} θ(x) ε(x)` and `M' = {c ≠ 0}` finite
(a finite set has approximate tangent space `{0}` at each of its points). -/
theorem Submission.dor_lmb_fcd_imp_degree_zero : ∀ (N N' : ℕ) (R : IMRep (univ : Set (Euclid N)) 0), R.measure univ ≠ ∞ → ∃ Y : (Euclid N → Euclid N') → GeometricCurrentOn (univ : Set (Euclid N')) 0, (∀ (F : Euclid N → Euclid N') (Λ : NNReal), LipschitzWith Λ F → IsIntegerMultiplicity (Y F) ∧ ∀ Fs : ℕ → Euclid N → Euclid N', (∀ j, ContDiff ℝ 1 (Fs j)) → (∀ j, LipschitzWith Λ (Fs j)) → TendstoUniformly Fs F atTop → ∀ ω : TestFormOn (univ : Set (Euclid N')) 0, Tendsto (fun j => R.action (fun x => ((ω : DifferentialForm (Euclid N') 0) (Fs j x)).compContinuousLinearMap (fderiv ℝ (Fs j) x))) atTop (𝓝 (Y F ω))) ∧ ∀ (F F' : Euclid N → Euclid N') (Λ : NNReal), LipschitzWith Λ F → LipschitzWith Λ F' → (∀ᵐ x ∂(μHE[0].restrict R.carrier), F x = F' x) → Y F = Y F' := by
  intro N N' R hR
  classical
  -- `μHE[0]` is the counting measure
  have hsing : ∀ {P : ℕ} (x : Euclid P), (μHE[0] : Measure (Euclid P)) {x} = 1 := by
    intro P x
    rw [Measure.euclideanHausdorffMeasure_zero]
    exact Measure.hausdorffMeasure_zero_singleton x
  -- the carrier is finite, since `H⁰(M) ≤ R.measure univ < ∞`
  have hfin : R.carrier.Finite := by
    by_contra hinf
    have hle : (μHE[0] : Measure (Euclid N)) R.carrier ≤ R.measure univ := by
      rw [IMRep.measure, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ,
        ← setLIntegral_one]
      exact setLIntegral_mono' R.measurableSet_carrier fun x hx => by
        exact_mod_cast R.mult_pos x hx
    obtain ⟨n, hn⟩ := ENNReal.exists_nat_gt (ne_top_of_le_ne_top hR hle)
    obtain ⟨t, hts, rfl⟩ := Set.Infinite.exists_subset_card_eq hinf n
    have : ((t.card : ℕ) : ℝ≥0∞) ≤ (μHE[0] : Measure (Euclid N)) R.carrier := by
      calc ((t.card : ℕ) : ℝ≥0∞) = ∑ x ∈ t, (μHE[0] : Measure (Euclid N)) {x} := by
            simp
        _ = (μHE[0] : Measure (Euclid N)) t := sum_measure_singleton
        _ ≤ _ := measure_mono hts
    exact absurd hn (not_lt.mpr this)
  set S := hfin.toFinset
  have hS : (S : Set (Euclid N)) = R.carrier := hfin.coe_toFinset
  -- `H⁰⌞M`-a.e. statements hold at every point of `M`
  have hpt : ∀ {p : Euclid N → Prop},
      (∀ᵐ x ∂((μHE[0] : Measure (Euclid N)).restrict R.carrier), p x) → ∀ x ∈ R.carrier, p x := by
    intro p hp x hx
    by_contra hpx
    have h0 := ae_iff.mp hp
    have hsub : ({x} : Set (Euclid N)) ⊆ {y | ¬ p y} ∩ R.carrier := by
      rintro y rfl
      exact ⟨hpx, hx⟩
    have h1 : (μHE[0] : Measure (Euclid N)) {x} ≤
        ((μHE[0] : Measure (Euclid N)).restrict R.carrier) {y | ¬ p y} :=
      (measure_mono hsub).trans (Measure.le_restrict_apply _ _)
    rw [hsing, h0] at h1
    exact absurd h1 (by norm_num)
  -- the unit `0`-covector and the empty tuple; a `0`-covector is `α(∅)` times the unit
  let K₁ : ∀ {P : ℕ}, Covector (Euclid P) 0 := fun {P} =>
    ContinuousAlternatingMap.constOfIsEmpty ℝ (Euclid P) (Fin 0) (1 : ℝ)
  let v₀ : ∀ {P : ℕ}, Fin 0 → Euclid P := fun {P} => fun i => i.elim0
  have hcov : ∀ {P : ℕ} (α : Covector (Euclid P) 0), α = α v₀ • K₁ := by
    intro P α
    ext v
    simp [K₁, Subsingleton.elim v v₀]
  have horient : ∀ x (α : Covector (Euclid N) 0), R.orient x α = α v₀ * R.orient x K₁ := by
    intro x α
    conv_lhs => rw [hcov α]
    rw [map_smul, smul_eq_mul]
  -- signs: on `M`, `ξ(x) = ε(x) · ev` with `ε(x) = ±1`
  have hsign : ∀ x ∈ R.carrier, R.orient x K₁ = 1 ∨ R.orient x K₁ = -1 := by
    intro x hx
    obtain ⟨Q, -, τ, -, -, hτ⟩ := hpt R.orients x hx
    rcases hτ with hτ | hτ
    · left; rw [hτ]; simp [K₁]
    · right; rw [hτ]; simp [K₁]
  let σ : Euclid N → ℤ := fun x => if R.orient x K₁ = 1 then 1 else -1
  have hσ : ∀ x ∈ R.carrier, R.orient x K₁ = (σ x : ℝ) := by
    intro x hx
    rcases hsign x hx with h | h
    · simp [σ, h]
    · simp [σ, h]
  let wZ : Euclid N → ℤ := fun x => (R.mult x : ℤ) * σ x
  -- `R.action β = ∑_{x ∈ M} θ(x) ε(x) β(x)(∅)`
  have haction : ∀ β : DifferentialForm (Euclid N) 0,
      R.action β = ∑ x ∈ S, (wZ x : ℝ) * β x v₀ := by
    intro β
    have hint : IntegrableOn (fun x => (R.mult x : ℝ) * R.orient x (β x)) (S : Set (Euclid N))
        (μHE[0] : Measure (Euclid N)) := by
      rw [← (S : Set (Euclid N)).biUnion_of_singleton, integrableOn_finite_biUnion S.finite_toSet]
      intro x _
      exact integrableOn_singleton (hx := by rw [hsing]; exact ENNReal.one_lt_top)
    rw [IMRep.action, ← hS, setIntegral_finset S hint]
    refine Finset.sum_congr rfl fun x hx => ?_
    have hxM : x ∈ R.carrier := hS ▸ hx
    rw [measureReal_def, hsing, ENNReal.toReal_one, one_smul, horient, hσ x hxM]
    simp only [wZ]
    push_cast
    ring
  -- the currents `Y(F)(ω) = ∑_{x ∈ M} θ(x) ε(x) ω(F(x))(∅)`
  let L : (Euclid N → Euclid N') → CurrentOn (univ : Set (Euclid N')) 0 := fun F =>
    { toFun := fun ω => ∑ x ∈ S, (wZ x : ℝ) * (ω : DifferentialForm (Euclid N') 0) (F x) v₀
      map_add' := fun ω η => by
        simp only [Submodule.coe_add, Pi.add_apply, ContinuousAlternatingMap.add_apply, mul_add,
          Finset.sum_add_distrib]
      map_smul' := fun c ω => by
        simp only [Submodule.coe_smul, Pi.smul_apply, ContinuousAlternatingMap.smul_apply,
          smul_eq_mul, RingHom.id_apply, Finset.mul_sum]
        exact Finset.sum_congr rfl fun x _ => by ring }
  have hL : ∀ F ω, L F ω = ∑ x ∈ S, (wZ x : ℝ) * (ω : DifferentialForm (Euclid N') 0) (F x) v₀ :=
    fun F ω => rfl
  have hcont : ∀ F (ωs : ℕ → TestFormOn (univ : Set (Euclid N')) 0), TestFormOnConverges ωs 0 →
      Tendsto (fun j => L F (ωs j)) atTop (𝓝 0) := by
    intro F ωs hωs
    obtain ⟨K, -, -, hsupp, -, hconv⟩ := hωs
    have hpt0 : ∀ y,
        Tendsto (fun j => (ωs j : DifferentialForm (Euclid N') 0) y v₀) atTop (𝓝 0) := by
      intro y
      by_cases hy : y ∈ K
      · have hΦ : Continuous (fun g : ContinuousMultilinearMap ℝ (fun _ : Fin 0 => Euclid N')
            (Covector (Euclid N') 0) => g v₀ v₀) :=
          (continuous_eval_const v₀).comp (continuous_eval_const v₀)
        have h0 := (hΦ.tendsto _).comp ((hconv 0).tendsto_at hy)
        simpa [Function.comp_def, iteratedFDeriv_zero_apply] using h0
      · have hz : ∀ j, (ωs j : DifferentialForm (Euclid N') 0) y = 0 := fun j =>
          image_eq_zero_of_notMem_tsupport fun h => hy (hsupp j h)
        simp [hz]
    have := tendsto_finsetSum S fun x _ => (hpt0 (F x)).const_mul (wZ x : ℝ)
    simpa [hL] using this
  let Y : (Euclid N → Euclid N') → GeometricCurrentOn (univ : Set (Euclid N')) 0 := fun F =>
    ⟨L F, hcont F⟩
  have hY : ∀ F ω, Y F ω = ∑ x ∈ S, (wZ x : ℝ) * (ω : DifferentialForm (Euclid N') 0) (F x) v₀ :=
    fun F ω => rfl
  refine ⟨Y, fun F Λ hF => ⟨?_, ?_⟩, ?_⟩
  · -- integrality: regroup the finite sum by the fibres of `F`
    let c : Euclid N' → ℤ := fun y => ∑ x ∈ S.filter (fun x => F x = y), wZ x
    have hc_supp : ∀ y, c y ≠ 0 → y ∈ S.image F := by
      intro y hy
      by_contra hy'
      apply hy
      refine Finset.sum_eq_zero fun x hx => ?_
      rw [Finset.mem_filter] at hx
      exact absurd (Finset.mem_image.mpr ⟨x, hx.1, hx.2⟩) hy'
    let T' : Finset (Euclid N') := (S.image F).filter (fun y => c y ≠ 0)
    have hT' : ∀ y, y ∈ T' ↔ c y ≠ 0 := by
      intro y
      simp only [T', Finset.mem_filter]
      exact ⟨fun h => h.2, fun h => ⟨hc_supp y h, h⟩⟩
    have hT'meas : MeasurableSet (T' : Set (Euclid N')) := T'.finite_toSet.measurableSet
    let ev : MultiVector N' 0 := ContinuousAlternatingMap.apply ℝ (Euclid N') ℝ v₀
    let orient' : Euclid N' → MultiVector N' 0 := fun y => if c y < 0 then -ev else ev
    refine ⟨{ carrier := T'
              mult := fun y => (c y).natAbs
              orient := orient'
              measurableSet_carrier := hT'meas
              carrier_subset := subset_univ _
              rectifiable := ?_
              measurable_mult := ?_
              mult_pos := ?_
              locallyIntegrable_mult := ?_
              aestronglyMeasurable_orient := ?_
              orients := ?_ }, ?_⟩
    · -- a finite set is countably `0`-rectifiable
      obtain ⟨g, hg⟩ := Set.countable_iff_exists_subset_range.mp T'.countable_toSet
      refine ⟨∅, measure_empty, fun j _ => g j, fun j => ⟨0, LipschitzWith.const _⟩, ?_⟩
      intro y hy
      obtain ⟨j, rfl⟩ := hg hy
      exact Or.inr (Set.mem_iUnion.mpr ⟨j, 0, rfl⟩)
    · -- measurability of the multiplicity
      refine measurable_to_countable' fun k => ?_
      by_cases hk : k = 0
      · have : (fun y => (c y).natAbs) ⁻¹' {k} = (T' : Set (Euclid N'))ᶜ := by
          ext y
          simp [hk, hT']
        rw [this]
        exact hT'meas.compl
      · refine (T'.finite_toSet.subset fun y hy => ?_).measurableSet
        have hy' : (c y).natAbs = k := hy
        rw [Finset.mem_coe, hT']
        intro h0
        rw [h0] at hy'
        exact hk hy'.symm
    · intro y hy
      exact Int.natAbs_pos.mpr ((hT' y).mp hy)
    · intro K _ _
      refine ne_top_of_le_ne_top ?_ (lintegral_mono_set Set.inter_subset_left)
      rw [lintegral_finset]
      exact ENNReal.sum_ne_top.mpr fun y _ => by simp
    · refine (StronglyMeasurable.ite ?_ stronglyMeasurable_const
        stronglyMeasurable_const).aestronglyMeasurable
      exact (T'.finite_toSet.subset fun y hy => (hT' y).mpr (ne_of_lt hy)).measurableSet
    · refine ae_restrict_of_forall_mem hT'meas fun y hy => ⟨⊥, ⟨by simp, fun f => ?_⟩, ?_⟩
      · -- the approximate tangent space of a finite set is `{0}`
        obtain ⟨ρ, hρ⟩ := f.hasCompactSupport.isCompact.isBounded.subset_closedBall (0 : Euclid N')
        have hev : ∀ᶠ r in 𝓝[>] (0 : ℝ), 0 < r ∧ ∀ z ∈ T', z ≠ y → ρ < r⁻¹ * ‖z - y‖ := by
          refine eventually_mem_nhdsWithin.and ((Filter.eventually_all_finset T').2 fun z _ => ?_)
          by_cases hzy : z = y
          · exact Eventually.of_forall fun _ h => absurd hzy h
          · have hd : 0 < ‖z - y‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hzy)
            exact ((tendsto_inv_nhdsGT_zero.atTop_mul_const hd).eventually_gt_atTop ρ).mono
              fun r hr _ => hr
        refine tendsto_const_nhds.congr' ?_
        filter_upwards [hev] with r hr
        obtain ⟨hr0, hfar⟩ := hr
        symm
        rw [Submodule.bot_coe]
        refine setIntegral_eq_of_subset_of_forall_sdiff_eq_zero
          (T'.finite_toSet.image _).measurableSet ?_ ?_
        · rintro _ rfl
          exact ⟨y, hy, by simp [Poincare.SimonGMT.Chapter03.blowUpMap]⟩
        · rintro _ ⟨⟨z, hz, rfl⟩, hz0⟩
          apply image_eq_zero_of_notMem_tsupport
          intro hmem
          have hzy : z ≠ y := by
            rintro rfl
            exact hz0 (by simp [Poincare.SimonGMT.Chapter03.blowUpMap])
          have h1 := hρ hmem
          have h2 := hfar z hz hzy
          rw [mem_closedBall_zero_iff, Poincare.SimonGMT.Chapter03.blowUpMap, norm_smul, norm_inv,
            Real.norm_of_nonneg hr0.le] at h1
          linarith
      · -- `±ev` orients `⊥`
        refine ⟨v₀, ⟨fun i => i.elim0, by intro i; exact i.elim0⟩, by simp, ?_⟩
        by_cases hneg : c y < 0
        · right; intro α; simp [orient', hneg, ev]
        · left; intro α; simp [orient', hneg, ev]
    · -- `R'` represents `Y(F)`
      intro ω
      have hint : IntegrableOn
          (fun y => ((c y).natAbs : ℝ) * orient' y ((ω : DifferentialForm (Euclid N') 0) y))
          (T' : Set (Euclid N')) (μHE[0] : Measure (Euclid N')) := by
        rw [← (T' : Set (Euclid N')).biUnion_of_singleton,
          integrableOn_finite_biUnion T'.finite_toSet]
        intro y _
        exact integrableOn_singleton (hx := by rw [hsing]; exact ENNReal.one_lt_top)
      show ∑ x ∈ S, (wZ x : ℝ) * (ω : DifferentialForm (Euclid N') 0) (F x) v₀ =
        ∫ y in (T' : Set (Euclid N')),
          ((c y).natAbs : ℝ) * orient' y ((ω : DifferentialForm (Euclid N') 0) y)
            ∂(μHE[0] : Measure (Euclid N'))
      rw [setIntegral_finset T' hint]
      have hterm : ∀ y ∈ T', (μHE[0] : Measure (Euclid N')).real {y} •
          (((c y).natAbs : ℝ) * orient' y ((ω : DifferentialForm (Euclid N') 0) y)) =
          (c y : ℝ) * (ω : DifferentialForm (Euclid N') 0) y v₀ := by
        intro y _
        rw [measureReal_def, hsing, ENNReal.toReal_one, one_smul, Nat.cast_natAbs, Int.cast_abs]
        by_cases hneg : c y < 0
        · have habs : |(c y : ℝ)| = -(c y : ℝ) := abs_of_neg (by exact_mod_cast hneg)
          simp only [orient', ite_eq_left hneg, ev, habs, neg_apply,
            ContinuousAlternatingMap.apply_apply]
          ring
        · have habs : |(c y : ℝ)| = (c y : ℝ) := abs_of_nonneg (by exact_mod_cast not_lt.mp hneg)
          simp only [orient', ite_eq_right hneg, ev, habs, ContinuousAlternatingMap.apply_apply]
      rw [Finset.sum_congr rfl hterm]
      show _ = ∑ y ∈ (S.image F).filter (fun y => c y ≠ 0),
        (c y : ℝ) * (ω : DifferentialForm (Euclid N') 0) y v₀
      rw [Finset.sum_filter_of_ne]
      · simp only [c, Int.cast_sum, Finset.sum_mul]
        rw [← Finset.sum_fiberwise_of_maps_to (g := F) (t := S.image F)
          fun x hx => Finset.mem_image_of_mem F hx]
        refine Finset.sum_congr rfl fun y _ => Finset.sum_congr rfl fun x hx => ?_
        rw [(Finset.mem_filter.mp hx).2]
      · intro y _ h h0
        apply h
        rw [h0, Int.cast_zero, zero_mul]
  · -- `R.action(F_j^# ω) → Y(F)(ω)`
    intro Fs _ _ hFs ω
    simp only [haction, hY]
    refine tendsto_finsetSum S fun x _ => Tendsto.const_mul _ ?_
    have hω : Continuous (ω : DifferentialForm (Euclid N') 0) := ContDiff.continuous ω.property.1.1
    have h1 := (((continuous_eval_const v₀).comp hω).tendsto (F x)).comp (hFs.tendsto_at x)
    refine h1.congr fun j => ?_
    simp only [Function.comp_apply, ContinuousAlternatingMap.compContinuousLinearMap_apply]
    exact congrArg _ (Subsingleton.elim _ _)
  · -- locality
    intro F F' Λ _ _ hFF'
    have hEq : ∀ x ∈ R.carrier, F x = F' x := hpt hFF'
    ext ω
    simp only [hY]
    refine Finset.sum_congr rfl fun x hx => ?_
    rw [hEq x (hS ▸ hx)]

/-- **Simon Ch. 6, 3.4–3.5** (orientation along a bi-Lipschitz parametrised piece): let
`(M, θ, ξ)` be an integer multiplicity triple of degree `k` in `ℝᴺ` with `Hᵏ(M) < ∞`, `G : ℝᵏ → ℝᴺ`
Lipschitz, `B` Borel with `κ|a − a'| ≤ |G(a) − G(a')|` on `B`, `DG(a)` injective for `a ∈ B`, and
`G(B) ⊆ M`.  Then there is a Borel sign `s = ±1` with
`J_G(u) ξ(G u) = s(u) DG(u)e₁ ∧ ⋯ ∧ DG(u)eₖ` for a.e. `u ∈ B`, `J_G = det(⟨DG eₐ, DG e_b⟩)^{1/2}`.
For a.e. `u ∈ B`, `T_{G(u)}M = range DG(u)` and `ξ(G u)` orients it; so does
`ζ = J_G⁻¹ DG(u)e₁ ∧ ⋯ ∧ DG(u)eₖ`, hence `ξ(G u) = ±ζ`.  The sign is read off by comparing the
distances from `J_G ξ̃(G u)` to `±DG(u)e₁ ∧ ⋯ ∧ DG(u)eₖ`, `ξ̃` a Borel version of `ξ`. -/
theorem Submission.dor_lmb_fcd_imp_piece_orientation_sign : ∀ (N k : ℕ) (R : IMRep (univ : Set (Euclid N)) k) (G : Euclid k → Euclid N) (B : Set (Euclid k)) (L : NNReal) (κ : ℝ), μHE[k] R.carrier ≠ ∞ → LipschitzWith L G → MeasurableSet B → 0 < κ → (∀ a ∈ B, ∀ a' ∈ B, κ * ‖a - a'‖ ≤ ‖G a - G a'‖) → (∀ a ∈ B, DifferentiableAt ℝ G a ∧ Injective (fderiv ℝ G a)) → G '' B ⊆ R.carrier → ∃ s : Euclid k → ℝ, Measurable s ∧ (∀ u, s u = 1 ∨ s u = -1) ∧ ∀ᵐ u ∂(volume.restrict B), ∀ α : Covector (Euclid N) k, Real.sqrt (Matrix.det (Matrix.of fun a b : Fin k => inner ℝ (fderiv ℝ G u (EuclideanSpace.single a (1 : ℝ))) (fderiv ℝ G u (EuclideanSpace.single b (1 : ℝ))))) * R.orient (G u) α = s u * α (fun a => fderiv ℝ G u (EuclideanSpace.single a (1 : ℝ))) := by
  intro N k R G B L κ hfin hG hB hκ hbi hdiff hGBM
  -- `e` is the standard basis of `ℝᵏ`; `J T = det(⟨T eₐ, T e_b⟩)^{1/2}` and `Ev T = (α ↦ α(T e))`
  let e : Fin k → Euclid k := fun a => EuclideanSpace.single a (1 : ℝ)
  let J : (Euclid k →L[ℝ] Euclid N) → ℝ := fun T =>
    Real.sqrt (Matrix.det (Matrix.of fun a b : Fin k => inner ℝ (T (e a)) (T (e b))))
  let Ev : (Euclid k →L[ℝ] Euclid N) → MultiVector N k := fun T =>
    (ContinuousAlternatingMap.apply ℝ (Euclid k) ℝ e).comp
      (ContinuousAlternatingMap.compContinuousLinearMapCLM T)
  have hev : ∀ v : Euclid k, Continuous fun T : Euclid k →L[ℝ] Euclid N => T v :=
    fun v => continuous_eval_const v
  have hJc : Continuous J := Real.continuous_sqrt.comp (Continuous.matrix_det
    (continuous_matrix fun a b => (hev (e a)).inner (hev (e b))))
  have hEvc : Continuous Ev :=
    continuous_const.clm_comp ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM
  -- Step 1: `Hᵏ⌞M`-a.e. properties hold at `G u` for a.e. `u ∈ B`
  obtain ⟨-, hpull⟩ := Submission.ptd_piece_image_measurable_ae_pullback N k G B L κ hG hB hκ hbi
  have hpullM : ∀ p : Euclid N → Prop, (∀ᵐ y ∂(μHE[k].restrict R.carrier), p y) →
      ∀ᵐ u ∂(volume.restrict B), p (G u) :=
    fun p hp => hpull p (ae_restrict_of_ae_restrict_of_subset hGBM hp)
  -- a strongly measurable version `g` of the orientation `ξ`
  let g := R.aestronglyMeasurable_orient.mk R.orient
  have hg : StronglyMeasurable g := R.aestronglyMeasurable_orient.stronglyMeasurable_mk
  have hgeq : ∀ᵐ u ∂(volume.restrict B), R.orient (G u) = g (G u) :=
    hpullM (fun y => R.orient y = g y) R.aestronglyMeasurable_orient.ae_eq_mk
  -- the sign `s u = ±1` compares the distances from `J g(G u)` to `±Ev(DG u)`
  let X : Euclid k → MultiVector N k := fun u => J (fderiv ℝ G u) • g (G u)
  let E : Euclid k → MultiVector N k := fun u => Ev (fderiv ℝ G u)
  let s : Euclid k → ℝ := fun u =>
    if dist (X u) (E u) ≤ dist (X u) ((-1 : ℝ) • E u) then 1 else -1
  have hX : StronglyMeasurable X :=
    (hJc.measurable.comp (measurable_fderiv ℝ G)).stronglyMeasurable.smul
      (hg.comp_measurable hG.continuous.measurable)
  have hE : StronglyMeasurable E :=
    hEvc.comp_stronglyMeasurable (measurable_fderiv ℝ G).stronglyMeasurable
  have hs : Measurable s :=
    Measurable.ite (measurableSet_le
      ((continuous_dist (α := MultiVector N k)).comp_stronglyMeasurable (hX.prodMk hE)).measurable
      ((continuous_dist (α := MultiVector N k)).comp_stronglyMeasurable
        (hX.prodMk (hE.const_smul (-1 : ℝ)))).measurable)
      measurable_const measurable_const
  refine ⟨s, hs, fun u => ?_, ?_⟩
  · simp only [s]
    split_ifs
    · exact Or.inl rfl
    · exact Or.inr rfl
  -- Steps 2–5: for a.e. `u ∈ B`, `J ξ(G u) = ± Ev(DG u)`
  have hkey : ∀ᵐ u ∂(volume.restrict B), X u = E u ∨ X u = (-1 : ℝ) • E u := by
    filter_upwards [ae_restrict_mem hB, hgeq, hpullM _ R.orients,
      Submission.dpf_approxTangent_ae_bilipschitz_piece N k univ R.carrier G B L κ isOpen_univ
        R.measurableSet_carrier (subset_univ _)
        (fun C _ _ => ne_top_of_le_ne_top hfin (measure_mono inter_subset_left)) hG hB hκ hbi
        hdiff hGBM] with u huB hgu hQ hT
    obtain ⟨Q, hQ, hξQ⟩ := hQ
    obtain ⟨-, hinj⟩ := hdiff u huB
    -- the approximate tangent space at `G u` is `range DG(u)`
    have hQeq : Q = LinearMap.range (fderiv ℝ G u : Euclid k →ₗ[ℝ] Euclid N) := hQ.unique hT
    -- `v = DG(u) e` is linearly independent and spans `range DG(u)`
    have hli : LinearIndependent ℝ (fun a => fderiv ℝ G u (e a)) := by
      have h := ((EuclideanSpace.basisFun (Fin k) ℝ).toBasis.linearIndependent).map'
        (fderiv ℝ G u : Euclid k →ₗ[ℝ] Euclid N) (LinearMap.ker_eq_bot.2 hinj)
      convert h using 1
      funext a
      simp [e]
    have hspan : Submodule.span ℝ (range fun a => fderiv ℝ G u (e a)) =
        LinearMap.range (fderiv ℝ G u : Euclid k →ₗ[ℝ] Euclid N) := by
      rw [LinearMap.range_eq_map, ← (EuclideanSpace.basisFun (Fin k) ℝ).toBasis.span_eq,
        Submodule.map_span, ← range_comp]
      congr 2
      funext a
      simp [e]
    -- `ζ = J⁻¹ Ev(DG u)` is a unit orientation of `range DG(u)`, and `J > 0`
    obtain ⟨hpos, hwedge⟩ :=
      Submission.codim1_lur_normalized_wedge_orientation N k (fun a => fderiv ℝ G u (e a)) hli
    have hJpos : 0 < J (fderiv ℝ G u) := Real.sqrt_pos.2 hpos
    have hζ : IsUnitOrientationOf ((J (fderiv ℝ G u))⁻¹ • E u) Q := by
      rw [hQeq, ← hspan]
      exact hwedge _ fun α => rfl
    -- `ξ(G u) = ±ζ`
    rcases Submission.rsdic_unitOrientation_eq_or_eq_neg N k _ _ Q hζ hξQ with h | h
    · left
      ext α
      show J (fderiv ℝ G u) * g (G u) α = E u α
      rw [← hgu, h]
      show J (fderiv ℝ G u) * ((J (fderiv ℝ G u))⁻¹ * E u α) = E u α
      rw [← mul_assoc, mul_inv_cancel₀ hJpos.ne', one_mul]
    · right
      ext α
      show J (fderiv ℝ G u) * g (G u) α = -1 * E u α
      rw [← hgu, h]
      show J (fderiv ℝ G u) * -((J (fderiv ℝ G u))⁻¹ * E u α) = -1 * E u α
      rw [mul_neg, ← mul_assoc, mul_inv_cancel₀ hJpos.ne', one_mul, neg_one_mul]
  -- Steps 5–7: the distance comparison selects the sign
  filter_upwards [hkey, hgeq] with u hu hgu α
  rw [hgu]
  show X u α = s u * E u α
  simp only [s]
  split_ifs with hle
  · rcases hu with h | h
    · rw [h, one_mul]
    · rw [h, dist_self] at hle
      have h0 : (-1 : ℝ) • E u = E u := dist_le_zero.1 hle
      rw [h, h0, one_mul]
  · rcases hu with h | h
    · exact absurd (by rw [h, dist_self]; exact dist_nonneg) hle
    · rw [h]
      rfl

/-- **Parametric representation of an integer multiplicity triple of finite mass** (Simon Ch. 6,
3.1 and 3.3–3.6, with Ch. 3, 1.1–1.3).  Let `R = (M, θ, ξ)` be an `IMRep` in `ℝᴺ` with
`μ_R(ℝᴺ) = ∫_M θ dHᵏ < ∞`, and write `J_G = √det(⟨DG eₐ, DG e_b⟩)`.  Then `M` is, up to an
`Hᵏ`-null set, the disjoint union of Borel pieces `Pᵢ = Gᵢ(Bᵢ) ⊆ M` with `Gᵢ` Lipschitz,
`mᵢ|a − a'| ≤ |Gᵢ(a) − Gᵢ(a')|` on `Bᵢ` and `DGᵢ` injective on `Bᵢ`
(`dpf_rectifiable_bilipschitz_pieces`); on each piece `J_{Gᵢ} ξ(Gᵢ) = sᵢ DGᵢ e` a.e. with
`sᵢ = ±1` (`dor_lmb_fcd_imp_piece_orientation_sign`), and the integer weights are
`wᵢ = (θ ∘ Gᵢ) sᵢ`.  The inverse of `Gᵢ|Bᵢ` is `mᵢ⁻¹`-Lipschitz, so `Gᵢ#(Lᵏ⌞Bᵢ) ≤ mᵢ^{-k} Hᵏ⌞Pᵢ`:
this gives `∫_{Bᵢ} |wᵢ| < ∞` and pulls `Hᵏ`-a.e. statements on `M` back to `Lᵏ`-a.e. statements on
`Bᵢ`.  The area formula `Hᵏ⌞Pᵢ = Gᵢ#((J_{Gᵢ} Lᵏ)⌞Bᵢ)` (`codim1_lura_gram_area_formula`) gives
`Σᵢ ∫_{Bᵢ} |wᵢ| J_{Gᵢ} = ∫_{⋃ Pᵢ} θ dHᵏ ≤ μ_R(ℝᴺ)` and, for bounded continuous `γ`,
`τ(M, θ, ξ)(γ) = Σᵢ ∫_{Pᵢ} θ ξ(γ) dHᵏ = Σᵢ ∫_{Bᵢ} wᵢ γ(Gᵢ)(DGᵢ e)` by countable additivity. -/
theorem Submission.dor_lmb_fcd_imp_parametric_rep : ∀ (N k : ℕ) (R : IMRep (univ : Set (Euclid N)) k), R.measure univ ≠ ∞ → ∃ (G : ℕ → Euclid k → Euclid N) (B : ℕ → Set (Euclid k)) (w : ℕ → Euclid k → ℝ), (∀ i, ∃ L : NNReal, LipschitzWith L (G i)) ∧ (∀ i, MeasurableSet (B i)) ∧ (∀ i, ∀ u ∈ B i, DifferentiableAt ℝ (G i) u) ∧ (∀ i, Measurable (w i)) ∧ (∀ i u, ∃ z : ℤ, w i u = z) ∧ (∀ i, ∀ u ∈ B i, w i u ≠ 0) ∧ (∀ i, IntegrableOn (w i) (B i)) ∧ ∑' i, ∫⁻ u in B i, ‖w i u‖ₑ * ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun a b : Fin k => inner ℝ (fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ))) (fderiv ℝ (G i) u (EuclideanSpace.single b (1 : ℝ)))))) ≤ R.measure univ ∧ (∀ γ : Euclid N → Covector (Euclid N) k, Continuous γ → (∃ C : ℝ, ∀ x, ‖γ x‖ ≤ C) → HasSum (fun i => ∫ u in B i, w i u * γ (G i u) (fun a => fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ)))) (R.action γ)) ∧ ∀ p : Euclid N → Prop, (∀ᵐ x ∂(μHE[k].restrict R.carrier), p x) → ∀ i, ∀ᵐ u ∂(volume.restrict (B i)), p (G i u) := by
  intro N k R hfin
  -- `θ` as a Borel function with values in `ℝ≥0∞` and in `ℝ`
  have hθm : Measurable fun x => (R.mult x : ℝ≥0∞) :=
    (measurable_from_nat (f := fun j : ℕ => (j : ℝ≥0∞))).comp R.measurable_mult
  have hθmR : Measurable fun x => (R.mult x : ℝ) :=
    (measurable_from_nat (f := fun j : ℕ => (j : ℝ))).comp R.measurable_mult
  -- Step 1: `μ_R(ℝᴺ) = ∫_M θ dHᵏ`, and `Hᵏ(M) ≤ μ_R(ℝᴺ) < ∞` since `θ ≥ 1` on `M`
  have hmass : R.measure univ = ∫⁻ x in R.carrier, (R.mult x : ℝ≥0∞) ∂μHE[k] := by
    rw [IMRep.measure, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
  have hMfin : μHE[k] R.carrier ≠ ∞ := by
    refine ne_top_of_le_ne_top hfin ?_
    rw [hmass]
    calc μHE[k] R.carrier = ∫⁻ _ in R.carrier, (1 : ℝ≥0∞) ∂μHE[k] := by rw [setLIntegral_one]
      _ ≤ ∫⁻ x in R.carrier, (R.mult x : ℝ≥0∞) ∂μHE[k] := by
        refine setLIntegral_mono hθm fun x hx => ?_
        exact_mod_cast R.mult_pos x hx
  -- Step 2: disjoint Borel bi-Lipschitz pieces `Pᵢ = Gᵢ(Bᵢ) ⊆ M` covering `M` up to a null set
  obtain ⟨G, B, m, hLip, hBm, hm, hbi, hdiff, hPm, hPM, hdisj, hnull⟩ :=
    Submission.dpf_rectifiable_bilipschitz_pieces N k R.carrier R.measurableSet_carrier
      R.rectifiable
  choose L hL using hLip
  have hGm : ∀ i, Measurable (G i) := fun i => (hL i).continuous.measurable
  have hinj : ∀ i, InjOn (G i) (B i) := by
    intro i a ha a' ha' h
    have h1 := hbi i a ha a' ha'
    rw [h, sub_self, norm_zero] at h1
    have h2 : ‖a - a'‖ ≤ 0 := by
      by_contra hc
      exact absurd h1 (not_le.mpr (mul_pos (hm i) (not_le.mp hc)))
    exact sub_eq_zero.mp (norm_le_zero_iff.mp h2)
  -- the Gram-determinant Jacobian `J_{Gᵢ}`
  obtain ⟨J, hJ⟩ : ∃ J : ℕ → Euclid k → ℝ, ∀ i u, J i u = Real.sqrt (Matrix.det
      (Matrix.of fun a b : Fin k => inner ℝ (fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ)))
        (fderiv ℝ (G i) u (EuclideanSpace.single b (1 : ℝ))))) :=
    ⟨_, fun _ _ => rfl⟩
  have hJm : ∀ i, Measurable (J i) := by
    intro i
    have h := (Submission.codim1_lura_gram_area_formula k N (G i)).1
    simp only [← hJ] at h
    exact h
  -- Step 3: the signs `sᵢ = ±1` with `J_{Gᵢ}(u) ξ(Gᵢ u) = sᵢ(u) DGᵢ(u)e` a.e. on `Bᵢ`
  choose s hsm hspm hsae using fun i =>
    Submission.dor_lmb_fcd_imp_piece_orientation_sign N k R (G i) (B i) (L i) (m i) hMfin (hL i)
      (hBm i) (hm i) (hbi i) (hdiff i) (hPM i)
  -- Step 4: the weights `wᵢ = (θ ∘ Gᵢ) sᵢ`
  obtain ⟨w, hw⟩ : ∃ w : ℕ → Euclid k → ℝ, ∀ i u, w i u = (R.mult (G i u) : ℝ) * s i u :=
    ⟨_, fun _ _ => rfl⟩
  have hwm : ∀ i, Measurable (w i) := by
    intro i
    have h : w i = fun u => (R.mult (G i u) : ℝ) * s i u := funext (hw i)
    rw [h]
    exact (hθmR.comp (hGm i)).mul (hsm i)
  have hwz : ∀ i u, ∃ z : ℤ, w i u = z := by
    intro i u
    rcases hspm i u with h | h
    · exact ⟨(R.mult (G i u) : ℤ), by rw [hw, h]; push_cast; ring⟩
    · exact ⟨-(R.mult (G i u) : ℤ), by rw [hw, h]; push_cast; ring⟩
  have hw0 : ∀ i, ∀ u ∈ B i, w i u ≠ 0 := by
    intro i u hu
    have hpos : 0 < R.mult (G i u) := R.mult_pos _ (hPM i (mem_image_of_mem _ hu))
    rw [hw]
    refine mul_ne_zero (by exact_mod_cast hpos.ne') ?_
    rcases hspm i u with h | h <;> rw [h] <;> norm_num
  have hwe : ∀ i u, ‖w i u‖ₑ = (R.mult (G i u) : ℝ≥0∞) := by
    intro i u
    rcases hspm i u with h | h <;> simp [hw, h]
  -- Step 5: `Lᵏ(Bᵢ ∩ Gᵢ⁻¹ Z) ≤ mᵢ^{-k} Hᵏ(Z ∩ Pᵢ)`, the inverse of `Gᵢ|Bᵢ` being `mᵢ⁻¹`-Lipschitz
  have hpull : ∀ i (Z : Set (Euclid N)), volume (G i ⁻¹' Z ∩ B i) ≤
      ((Real.toNNReal (m i)⁻¹ : NNReal) : ℝ≥0∞) ^ k * μHE[k] (Z ∩ G i '' B i) := by
    intro i Z
    have hψ : LipschitzOnWith (Real.toNNReal (m i)⁻¹) (Function.invFunOn (G i) (B i))
        (G i '' B i) := by
      refine LipschitzOnWith.of_dist_le_mul fun y hy y' hy' => ?_
      obtain ⟨a, ha, rfl⟩ := hy
      obtain ⟨a', ha', rfl⟩ := hy'
      rw [(hinj i).leftInvOn_invFunOn ha, (hinj i).leftInvOn_invFunOn ha',
        Real.coe_toNNReal _ (inv_nonneg.mpr (hm i).le), dist_eq_norm, dist_eq_norm,
        inv_mul_eq_div, le_div_iff₀ (hm i)]
      linarith [hbi i a ha a' ha']
    have hsub : G i ⁻¹' Z ∩ B i ⊆ Function.invFunOn (G i) (B i) '' (Z ∩ G i '' B i) :=
      fun u hu => ⟨G i u, ⟨hu.1, mem_image_of_mem _ hu.2⟩, (hinj i).leftInvOn_invFunOn hu.2⟩
    calc volume (G i ⁻¹' Z ∩ B i)
        ≤ volume (Function.invFunOn (G i) (B i) '' (Z ∩ G i '' B i)) := measure_mono hsub
      _ = μHE[k] (Function.invFunOn (G i) (B i) '' (Z ∩ G i '' B i)) := by
        rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
      _ ≤ _ := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn k
          (hψ.mono inter_subset_right)
  have hmaple : ∀ i, Measure.map (G i) (volume.restrict (B i)) ≤
      ((Real.toNNReal (m i)⁻¹ : NNReal) : ℝ≥0∞) ^ k • μHE[k].restrict (G i '' B i) := by
    intro i
    rw [Measure.le_iff]
    intro Z hZ
    rw [Measure.map_apply (hGm i) hZ, Measure.restrict_apply (hGm i hZ), Measure.smul_apply,
      Measure.restrict_apply hZ, smul_eq_mul]
    exact hpull i Z
  -- Step 5(a): `Hᵏ`-a.e. statements on `M` pull back to `Lᵏ`-a.e. statements on `Bᵢ`
  have hae : ∀ p : Euclid N → Prop, (∀ᵐ x ∂(μHE[k].restrict R.carrier), p x) →
      ∀ i, ∀ᵐ u ∂(volume.restrict (B i)), p (G i u) := by
    intro p hp i
    rw [ae_iff, Measure.restrict_apply' R.measurableSet_carrier] at hp
    rw [ae_iff, Measure.restrict_apply' (hBm i)]
    refine nonpos_iff_eq_zero.mp ?_
    calc volume ({u | ¬p (G i u)} ∩ B i)
        ≤ ((Real.toNNReal (m i)⁻¹ : NNReal) : ℝ≥0∞) ^ k * μHE[k] ({x | ¬p x} ∩ G i '' B i) :=
          hpull i {x | ¬p x}
      _ ≤ ((Real.toNNReal (m i)⁻¹ : NNReal) : ℝ≥0∞) ^ k * μHE[k] ({x | ¬p x} ∩ R.carrier) := by
          gcongr
          exact hPM i
      _ = 0 := by rw [hp, mul_zero]
  -- Step 6: `∫_{Bᵢ} |wᵢ| = ∫_{Bᵢ} θ ∘ Gᵢ ≤ mᵢ^{-k} ∫_{Pᵢ} θ dHᵏ ≤ mᵢ^{-k} μ_R(ℝᴺ) < ∞`
  have hwint : ∀ i, IntegrableOn (w i) (B i) := by
    intro i
    refine ⟨(hwm i).aestronglyMeasurable, ?_⟩
    show ∫⁻ u in B i, ‖w i u‖ₑ < ∞
    simp only [hwe]
    calc ∫⁻ u in B i, (R.mult (G i u) : ℝ≥0∞)
        = ∫⁻ y, (R.mult y : ℝ≥0∞) ∂(Measure.map (G i) (volume.restrict (B i))) :=
          (lintegral_map hθm (hGm i)).symm
      _ ≤ ∫⁻ y, (R.mult y : ℝ≥0∞) ∂(((Real.toNNReal (m i)⁻¹ : NNReal) : ℝ≥0∞) ^ k •
            μHE[k].restrict (G i '' B i)) := lintegral_mono' (hmaple i) le_rfl
      _ = ((Real.toNNReal (m i)⁻¹ : NNReal) : ℝ≥0∞) ^ k *
            ∫⁻ y in G i '' B i, (R.mult y : ℝ≥0∞) ∂μHE[k] := lintegral_smul_measure _ _
      _ ≤ ((Real.toNNReal (m i)⁻¹ : NNReal) : ℝ≥0∞) ^ k *
            ∫⁻ y in R.carrier, (R.mult y : ℝ≥0∞) ∂μHE[k] := by
          gcongr
          exact hPM i
      _ < ∞ := by
          rw [← hmass]
          exact ENNReal.mul_lt_top (ENNReal.pow_lt_top ENNReal.coe_lt_top) hfin.lt_top
  -- Step 7: the area formula on `Pᵢ`, and `Hᵏ⌞Pᵢ = Gᵢ#((J_{Gᵢ} Lᵏ)⌞Bᵢ)`
  have harea' : ∀ i (g : Euclid N → ℝ≥0∞), ∫⁻ y in G i '' B i, g y ∂μHE[k] =
      ∫⁻ u in B i, ENNReal.ofReal (J i u) * g (G i u) := by
    intro i g
    rw [(Submission.codim1_lura_gram_area_formula k N (G i)).2 (B i) (hBm i)
      (fun u hu => (hdiff i u hu).1) (fun u hu => (hdiff i u hu).2) (hinj i) g]
    simp only [hJ]
  have hμeq : ∀ i, μHE[k].restrict (G i '' B i) = Measure.map (G i)
      ((volume.restrict (B i)).withDensity fun u => ((J i u).toNNReal : ℝ≥0∞)) := by
    intro i
    ext Z hZ
    rw [Measure.map_apply (hGm i) hZ, withDensity_apply _ (hGm i hZ),
      ← lintegral_indicator_one hZ, harea' i, ← lintegral_indicator (hGm i hZ)]
    refine lintegral_congr fun u => ?_
    by_cases hu : G i u ∈ Z
    · simp [hu, indicator_of_mem, ENNReal.ofReal]
    · simp [hu]
  have htr : ∀ i (h : Euclid N → ℝ), AEStronglyMeasurable h (μHE[k].restrict R.carrier) →
      ∫ y in G i '' B i, h y ∂μHE[k] = ∫ u in B i, J i u * h (G i u) := by
    intro i h hh
    have hh' : AEStronglyMeasurable h (Measure.map (G i)
        ((volume.restrict (B i)).withDensity fun u => ((J i u).toNNReal : ℝ≥0∞))) := by
      rw [← hμeq i]
      exact hh.mono_measure (Measure.restrict_mono (hPM i) le_rfl)
    rw [hμeq i, integral_map (hGm i).aemeasurable hh',
      integral_withDensity_eq_integral_smul (hJm i).real_toNNReal]
    refine integral_congr_ae (ae_of_all _ fun u => ?_)
    simp only [NNReal.smul_def, smul_eq_mul, Real.coe_toNNReal _ (Real.sqrt_nonneg _), hJ]
  -- Step 8: `Σᵢ ∫_{Bᵢ} |wᵢ| J_{Gᵢ} = Σᵢ ∫_{Pᵢ} θ dHᵏ = ∫_{⋃ Pᵢ} θ dHᵏ ≤ μ_R(ℝᴺ)`
  have hmassle : ∑' i, ∫⁻ u in B i, ‖w i u‖ₑ * ENNReal.ofReal (J i u) ≤ R.measure univ := by
    calc ∑' i, ∫⁻ u in B i, ‖w i u‖ₑ * ENNReal.ofReal (J i u)
        = ∑' i, ∫⁻ y in G i '' B i, (R.mult y : ℝ≥0∞) ∂μHE[k] := by
          refine tsum_congr fun i => ?_
          rw [harea' i]
          refine lintegral_congr fun u => ?_
          rw [hwe, mul_comm]
      _ = ∫⁻ y in ⋃ i, G i '' B i, (R.mult y : ℝ≥0∞) ∂μHE[k] := (lintegral_iUnion hPm hdisj _).symm
      _ ≤ ∫⁻ y in R.carrier, (R.mult y : ℝ≥0∞) ∂μHE[k] := lintegral_mono_set (iUnion_subset hPM)
      _ = R.measure univ := hmass.symm
  -- Step 9: for bounded continuous `γ`, `τ(γ) = Σᵢ ∫_{Pᵢ} θ ξ(γ) dHᵏ = Σᵢ ∫_{Bᵢ} wᵢ γ(Gᵢ)(DGᵢ e)`
  have hsum : ∀ γ : Euclid N → Covector (Euclid N) k, Continuous γ → (∃ C : ℝ, ∀ x, ‖γ x‖ ≤ C) →
      HasSum (fun i => ∫ u in B i, w i u * γ (G i u)
        (fun a => fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ)))) (R.action γ) := by
    rintro γ hγ ⟨C, hC⟩
    -- (a) `|ξ(x)(α)| ≤ ‖α‖` a.e. on `M`, `ξ(x)` being a unit orientation; hence `θ ξ(γ)` is
    -- `Hᵏ`-integrable on `M`, being dominated by `C θ`
    have hbound : ∀ᵐ x ∂(μHE[k].restrict R.carrier), ∀ α : Covector (Euclid N) k,
        |R.orient x α| ≤ ‖α‖ := by
      filter_upwards [R.orients] with x hx
      obtain ⟨Q, -, τ, hτ, -, hξ⟩ := hx
      intro α
      have hτn : ∀ j, ‖τ j‖ = 1 := fun j => hτ.1 j
      have hατ : |α τ| ≤ ‖α‖ := by
        have h := α.le_opNorm τ
        simp only [hτn, Finset.prod_const_one, mul_one, Real.norm_eq_abs] at h
        exact h
      rcases hξ with h | h
      · rw [h]; exact hατ
      · rw [h, abs_neg]; exact hατ
    have hθi : Integrable (fun x => (R.mult x : ℝ)) (μHE[k].restrict R.carrier) := by
      refine ⟨hθmR.aestronglyMeasurable, ?_⟩
      show ∫⁻ x in R.carrier, ‖(R.mult x : ℝ)‖ₑ ∂μHE[k] < ∞
      simp only [Real.enorm_natCast]
      rw [← hmass]
      exact hfin.lt_top
    have hhm : AEStronglyMeasurable (fun x => (R.mult x : ℝ) * R.orient x (γ x))
        (μHE[k].restrict R.carrier) := by
      have h2 : AEStronglyMeasurable (fun x => R.orient x (γ x)) (μHE[k].restrict R.carrier) :=
        Continuous.comp_aestronglyMeasurable₂
          (g := fun (L : MultiVector N k) (α : Covector (Euclid N) k) => L α)
          (isBoundedBilinearMap_apply (𝕜 := ℝ) (E := Covector (Euclid N) k) (F := ℝ)).continuous
          R.aestronglyMeasurable_orient hγ.aestronglyMeasurable
      exact hθmR.aestronglyMeasurable.mul h2
    have hhi : IntegrableOn (fun x => (R.mult x : ℝ) * R.orient x (γ x)) R.carrier μHE[k] := by
      refine Integrable.mono' (hθi.const_mul C) hhm ?_
      filter_upwards [hbound] with x hx
      rw [norm_mul, Real.norm_natCast, Real.norm_eq_abs]
      calc (R.mult x : ℝ) * |R.orient x (γ x)| ≤ (R.mult x : ℝ) * ‖γ x‖ := by
            gcongr; exact hx _
        _ ≤ (R.mult x : ℝ) * C := by gcongr; exact hC x
        _ = C * (R.mult x : ℝ) := mul_comm _ _
    -- (b) `τ(γ) = ∫_{⋃ Pᵢ} θ ξ(γ) dHᵏ = Σᵢ ∫_{Pᵢ} θ ξ(γ) dHᵏ`
    have haction : R.action γ =
        ∫ y in ⋃ i, G i '' B i, (R.mult y : ℝ) * R.orient y (γ y) ∂μHE[k] := by
      rw [IMRep.action]
      refine setIntegral_congr_set ?_
      rw [ae_eq_set]
      refine ⟨hnull, ?_⟩
      rw [sdiff_eq_empty.mpr (iUnion_subset hPM), measure_empty]
    have hU := hasSum_integral_iUnion hPm hdisj (hhi.mono_set (iUnion_subset hPM))
    -- (c) `∫_{Pᵢ} θ ξ(γ) dHᵏ = ∫_{Bᵢ} J_{Gᵢ} θ(Gᵢ) ξ(Gᵢ)(γ(Gᵢ)) = ∫_{Bᵢ} wᵢ γ(Gᵢ)(DGᵢ e)`
    have hterm : ∀ i, ∫ y in G i '' B i, (R.mult y : ℝ) * R.orient y (γ y) ∂μHE[k] =
        ∫ u in B i, w i u * γ (G i u)
          (fun a => fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ))) := by
      intro i
      rw [htr i _ hhm]
      refine integral_congr_ae ?_
      filter_upwards [hsae i] with u hu
      have h := hu (γ (G i u))
      rw [← hJ] at h
      rw [hw]
      calc J i u * ((R.mult (G i u) : ℝ) * R.orient (G i u) (γ (G i u)))
          = (R.mult (G i u) : ℝ) * (J i u * R.orient (G i u) (γ (G i u))) := by ring
        _ = (R.mult (G i u) : ℝ) * (s i u * γ (G i u)
              (fun a => fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ)))) := by rw [h]
        _ = (R.mult (G i u) : ℝ) * s i u * γ (G i u)
              (fun a => fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ))) := by ring
    rw [haction, ← funext hterm]
    exact hU
  -- Step 10: assemble
  refine ⟨G, B, w, fun i => ⟨L i, hL i⟩, hBm, fun i u hu => (hdiff i u hu).1, hwm, hwz, hw0,
    hwint, ?_, hsum, hae⟩
  simpa only [hJ] using hmassle
/-- **Simon Ch. 3, 1.2–1.3** (bi-Lipschitz partition of the regular set): for any
`H : ℝᵏ → ℝ^{N'}` and Borel `B ⊆ ℝᵏ`, the set `S` of `u ∈ B` at which `H` is differentiable with
injective derivative is the disjoint union of countably many Borel pieces `Aₗ` with
`κₗ|a − a'| ≤ |H(a) − H(a')|` on `Aₗ`, `κₗ > 0`.  `S` is Borel (`measurableSet_of_differentiableAt`,
`measurable_fderiv`, `ContinuousLinearMap.isOpen_injective`).  For injective `L` take `K > 0` with
`|x| ≤ K|Lx|` (`LinearMap.exists_antilipschitzWith`) and `r(L) = K⁻¹/2`; otherwise `r(L) = 1`.
`exists_partition_approximatesLinearOn_of_hasFDerivWithinAt` gives Borel `Aₗ = S ∩ tₗ` on which
`H` is `r(Tₗ)`-close to `Tₗ = DH(yₗ)`, `yₗ ∈ S`, so
`|H(a) − H(a')| ≥ |Tₗ(a − a')| − r(Tₗ)|a − a'| ≥ r(Tₗ)|a − a'|` and `κₗ = r(Tₗ)`. -/
theorem Submission.dor_lmb_fcd_imp_regular_partition : ∀ (k N' : ℕ) (H : Euclid k → Euclid N') (B : Set (Euclid k)), MeasurableSet B → ∃ (A : ℕ → Set (Euclid k)) (κ : ℕ → ℝ), (∀ l, MeasurableSet (A l)) ∧ (∀ l, A l ⊆ B) ∧ Pairwise (fun l l' => Disjoint (A l) (A l')) ∧ (∀ l, 0 < κ l) ∧ (∀ l, ∀ a ∈ A l, ∀ a' ∈ A l, κ l * ‖a - a'‖ ≤ ‖H a - H a'‖) ∧ (∀ l, ∀ a ∈ A l, DifferentiableAt ℝ H a ∧ Injective (fderiv ℝ H a)) ∧ ∀ u ∈ B, DifferentiableAt ℝ H u → Injective (fderiv ℝ H u) → ∃ l, u ∈ A l := by
  intro k N' H B hB
  -- the regular set `S = B ∩ {H differentiable, DH injective}` is Borel
  set S : Set (Euclid k) := B ∩ {u | DifferentiableAt ℝ H u ∧ Injective (fderiv ℝ H u)}
  have hS : MeasurableSet S :=
    hB.inter ((measurableSet_of_differentiableAt ℝ H).inter
      (measurable_fderiv ℝ H ContinuousLinearMap.isOpen_injective.measurableSet))
  -- coercivity radius: `r(L) ≠ 0`, and `2 r(L) |x| ≤ |Lx|` for injective `L`
  have hcoer : ∀ L : Euclid k →L[ℝ] Euclid N', ∃ c : NNReal, c ≠ 0 ∧
      (Injective L → ∀ x, 2 * ((c : ℝ) * ‖x‖) ≤ ‖L x‖) := by
    intro L
    by_cases hL : Injective L
    · obtain ⟨K, hK, hKL⟩ := LinearMap.exists_antilipschitzWith (L : Euclid k →ₗ[ℝ] Euclid N')
        (LinearMap.ker_eq_bot.mpr hL)
      refine ⟨K⁻¹ / 2, div_ne_zero (inv_ne_zero hK.ne') two_ne_zero, fun _ x => ?_⟩
      have hb : ‖x‖ ≤ K * ‖L x‖ := ZeroHomClass.bound_of_antilipschitz L hKL x
      have hK' : (0 : ℝ) < K := hK
      calc 2 * (((K⁻¹ / 2 : NNReal) : ℝ) * ‖x‖) = (K : ℝ)⁻¹ * ‖x‖ := by push_cast; ring
        _ ≤ (K : ℝ)⁻¹ * (K * ‖L x‖) := mul_le_mul_of_nonneg_left hb (inv_nonneg.mpr hK'.le)
        _ = ‖L x‖ := inv_mul_cancel_left₀ hK'.ne' _
    · exact ⟨1, one_ne_zero, fun h => absurd h hL⟩
  choose r rpos hr using hcoer
  -- partition of `S` into Borel pieces on which `H` is `r(Tₗ)`-close to `Tₗ = DH(yₗ)`
  obtain ⟨t, T, htd, htm, hSt, happrox, hrep⟩ :=
    exists_partition_approximatesLinearOn_of_hasFDerivWithinAt H S (fderiv ℝ H)
      (fun x hx => hx.2.1.hasFDerivAt.hasFDerivWithinAt) r rpos
  refine ⟨fun l => S ∩ t l, fun l => (r (T l) : ℝ), fun l => hS.inter (htm l),
    fun l x hx => hx.1.1, fun l l' hll' => (htd hll').mono inter_subset_right inter_subset_right,
    fun l => NNReal.coe_pos.mpr (pos_iff_ne_zero.mpr (rpos (T l))), ?_, fun l x hx => hx.1.2, ?_⟩
  · -- `|H(a) − H(a')| ≥ |Tₗ(a − a')| − r(Tₗ)|a − a'| ≥ r(Tₗ)|a − a'|`, `Tₗ = DH(yₗ)` injective
    intro l a ha a' ha'
    obtain ⟨y, hyS, hy⟩ := hrep ⟨a, ha.1⟩ l
    have hinj : Injective (T l) := by rw [hy]; exact hyS.2.2
    have h2 : ‖H a - H a' - T l (a - a')‖ ≤ r (T l) * ‖a - a'‖ := happrox l a ha a' ha'
    have h3 := hr (T l) hinj (a - a')
    have h4 : ‖T l (a - a')‖ ≤ ‖H a - H a'‖ + ‖H a - H a' - T l (a - a')‖ :=
      calc ‖T l (a - a')‖ = ‖(H a - H a') - (H a - H a' - T l (a - a'))‖ := by
            rw [sub_sub_cancel]
        _ ≤ _ := norm_sub_le _ _
    show (r (T l) : ℝ) * ‖a - a'‖ ≤ ‖H a - H a'‖
    linarith
  · -- every regular point of `H` in `B` lies in `S ⊆ ⋃ₗ tₗ`
    intro u hu hdiff hinj
    obtain ⟨l, hl⟩ := mem_iUnion.mp (hSt ⟨hu, hdiff, hinj⟩)
    exact ⟨l, ⟨hu, hdiff, hinj⟩, hl⟩
/-- **Simon Ch. 6, 3.5–3.9 on one bi-Lipschitz piece** (step 7 of the integer multiplicity
push-forward).  Assume (IMC): (a) approximate tangent spaces are local, (b) restricting an
`IMRep` to a Borel set represents a current, (c) differences of integer multiplicity currents are
integer multiplicity, (d) `|⟨α, ξ(x)⟩| ≤ |α|` a.e. on the carrier.  Let `H : ℝᵏ → ℝ^{N'}` be
Lipschitz, `A ⊆ ℝᵏ` Borel with `κ|a − a'| ≤ |H(a) − H(a')|` on `A` (`κ > 0`) and `DH(a)`
injective on `A`, and `g` Borel, integer-valued, nonzero on `A`, with `∫_A |g| J < ∞`, where
`J = √det(⟨DH eₐ, DH e_b⟩)`.  Then `Φ(ω) = ∫_A g ω(H)(DH e₁, …, DH eₖ)` is an integer
multiplicity current with `M(Φ) ≤ ∫_A |g| J`.  With `ψ` a Borel inverse of `H` on `A` and
`η = J⁻¹ DH e₁ ∧ ⋯ ∧ DH eₖ`, `Φ = τ(H(A), |g ∘ ψ|, sign(g ∘ ψ) η ∘ ψ)` by (IMC)(b); the area
formula gives `Hᵏ⌞H(A) = H_#(J Lᵏ⌞A)`, which yields the action, and (IMC)(d) the mass bound. -/
theorem Submission.dor_lmb_fcd_imp_piece_current : ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (k N' : ℕ) (H : Euclid k → Euclid N') (A : Set (Euclid k)) (L : NNReal) (κ : ℝ) (g : Euclid k → ℝ), LipschitzWith L H → MeasurableSet A → 0 < κ → (∀ a ∈ A, ∀ a' ∈ A, κ * ‖a - a'‖ ≤ ‖H a - H a'‖) → (∀ a ∈ A, DifferentiableAt ℝ H a ∧ Injective (fderiv ℝ H a)) → Measurable g → (∀ u, ∃ z : ℤ, g u = z) → (∀ u ∈ A, g u ≠ 0) → ∫⁻ u in A, ‖g u‖ₑ * ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun a b : Fin k => inner ℝ (fderiv ℝ H u (EuclideanSpace.single a (1 : ℝ))) (fderiv ℝ H u (EuclideanSpace.single b (1 : ℝ)))))) ≠ ∞ → ∃ Φ : GeometricCurrentOn (univ : Set (Euclid N')) k, IsIntegerMultiplicity Φ ∧ Φ.mass ≤ ∫⁻ u in A, ‖g u‖ₑ * ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun a b : Fin k => inner ℝ (fderiv ℝ H u (EuclideanSpace.single a (1 : ℝ))) (fderiv ℝ H u (EuclideanSpace.single b (1 : ℝ)))))) ∧ ∀ ω : TestFormOn (univ : Set (Euclid N')) k, Φ ω = ∫ u in A, g u * (ω : DifferentialForm (Euclid N') k) (H u) (fun a => fderiv ℝ H u (EuclideanSpace.single a (1 : ℝ))) := by
  intro hIMC k N' H A L κ g hH hA hκ hbi hdiff hg hgZ hg0 hfin
  obtain ⟨-, hIMCb, -, hIMCd⟩ := hIMC
  -- Step 1: `H` is injective on `A`, `N = H(A)` is Borel, and the area formula on `A`
  have hinj : InjOn H A := fun a ha a' ha' h => by
    have hle := hbi a ha a' ha'
    rw [h, sub_self, norm_zero] at hle
    exact sub_eq_zero.1 (norm_le_zero_iff.1 (nonpos_of_mul_nonpos_right hle hκ))
  have hN : MeasurableSet (H '' A) :=
    hA.image_of_continuousOn_injOn hH.continuous.continuousOn hinj
  have hHm : Measurable H := hH.continuous.measurable
  set J : Euclid k → ℝ := fun u => Real.sqrt (Matrix.det (Matrix.of fun a b : Fin k =>
    inner ℝ (fderiv ℝ H u (EuclideanSpace.single a (1 : ℝ)))
      (fderiv ℝ H u (EuclideanSpace.single b (1 : ℝ)))))
  obtain ⟨hJm, harea⟩ := Submission.codim1_lura_gram_area_formula k N' H
  have hJm' : Measurable J := hJm
  have hareaA : ∀ φ : Euclid N' → ℝ≥0∞,
      ∫⁻ y in H '' A, φ y ∂μHE[k] = ∫⁻ u in A, ENNReal.ofReal (J u) * φ (H u) :=
    harea A hA (fun u hu => (hdiff u hu).1) (fun u hu => (hdiff u hu).2) hinj
  -- Step 2: a Borel left inverse `ψ` of `H` on `A`
  obtain ⟨ψ, hψm, hψ⟩ := (ContinuousOn.measurableEmbedding hA hH.continuous.continuousOn
    hinj).exists_measurable_extend measurable_subtype_coe fun _ => ⟨0⟩
  have hψH : ∀ a ∈ A, ψ (H a) = a := fun a ha => congr_fun hψ ⟨a, ha⟩
  -- Step 3: `η(u) = J(u)⁻¹ DH(u)e₁ ∧ ⋯ ∧ DH(u)eₖ`
  let Ev : (Euclid k →L[ℝ] Euclid N') → MultiVector N' k := fun T =>
    (ContinuousAlternatingMap.apply ℝ (Euclid k) ℝ
      (fun a : Fin k => EuclideanSpace.single a (1 : ℝ))).comp
      (ContinuousAlternatingMap.compContinuousLinearMapCLM T)
  have hEvc : Continuous Ev :=
    continuous_const.clm_comp ContinuousAlternatingMap.continuous_compContinuousLinearMapCLM
  let η : Euclid k → MultiVector N' k := fun u => (J u)⁻¹ • Ev (fderiv ℝ H u)
  have hη : ∀ u α, η u α = (J u)⁻¹ * α (fun a => fderiv ℝ H u (EuclideanSpace.single a (1 : ℝ))) :=
    fun u α => rfl
  have hηm : StronglyMeasurable η :=
    hJm'.inv.stronglyMeasurable.smul
      (hEvc.comp_stronglyMeasurable (measurable_fderiv ℝ H).stronglyMeasurable)
  -- the frame `DH(a)e` is linearly independent and spans `range DH(a)` for `a ∈ A`
  have hli : ∀ a ∈ A, LinearIndependent ℝ
      (fun i : Fin k => fderiv ℝ H a (EuclideanSpace.single i (1 : ℝ))) := by
    intro a ha
    have := (EuclideanSpace.basisFun (Fin k) ℝ).toBasis.linearIndependent.map'
      (fderiv ℝ H a : Euclid k →ₗ[ℝ] Euclid N') (LinearMap.ker_eq_bot.mpr (hdiff a ha).2)
    simpa [Function.comp_def] using this
  have hspan : ∀ a, Submodule.span ℝ
      (Set.range (fun i : Fin k => fderiv ℝ H a (EuclideanSpace.single i (1 : ℝ)))) =
      LinearMap.range (fderiv ℝ H a : Euclid k →ₗ[ℝ] Euclid N') := by
    intro a
    have : (fun i : Fin k => fderiv ℝ H a (EuclideanSpace.single i (1 : ℝ))) =
        (fderiv ℝ H a : Euclid k →ₗ[ℝ] Euclid N') ∘
          (EuclideanSpace.basisFun (Fin k) ℝ).toBasis := by
      funext i; simp
    rw [this, Set.range_comp, Submodule.span_image,
      (EuclideanSpace.basisFun (Fin k) ℝ).toBasis.span_eq, Submodule.map_top]
  have hJpos : ∀ a ∈ A, 0 < J a := fun a ha =>
    Real.sqrt_pos.2 (Submission.codim1_lur_normalized_wedge_orientation N' k _ (hli a ha)).1
  have hηor : ∀ a ∈ A, IsUnitOrientationOf (η a)
      (LinearMap.range (fderiv ℝ H a : Euclid k →ₗ[ℝ] Euclid N')) := by
    intro a ha
    rw [← hspan a]
    exact (Submission.codim1_lur_normalized_wedge_orientation N' k _ (hli a ha)).2 (η a)
      (fun α => hη a α)
  have hJnn : ∀ u, 0 ≤ J u := fun u => Real.sqrt_nonneg _
  have hfin' : ∫⁻ u in A, ‖g u‖ₑ * ENNReal.ofReal (J u) ≠ ∞ := hfin
  -- Step 4: the multiplicity `θ = ⌊|g ∘ ψ|⌋₊`, equal to `|g|` on `A` via `ψ ∘ H = id`
  have hfloor : Measurable (Nat.floor : ℝ → ℕ) :=
    measurable_to_countable fun r => by
      rcases eq_or_ne ⌊r⌋₊ 0 with h | h <;>
        simp [h, Nat.preimage_floor_of_ne_zero, -Nat.floor_eq_zero]
  let mult : Euclid N' → ℕ := fun y => ⌊|g (ψ y)|⌋₊
  have hmultm : Measurable mult := hfloor.comp (continuous_abs.measurable.comp (hg.comp hψm))
  have hmultA : ∀ a ∈ A, ∃ z : ℤ, g a = z ∧ mult (H a) = z.natAbs ∧ |g a| = (z.natAbs : ℝ) := by
    intro a ha
    obtain ⟨z, hz⟩ := hgZ a
    have habs : |g a| = (z.natAbs : ℝ) := by rw [hz, Nat.cast_natAbs, Int.cast_abs]
    refine ⟨z, hz, ?_, habs⟩
    show ⌊|g (ψ (H a))|⌋₊ = z.natAbs
    rw [hψH a ha, habs, Nat.floor_natCast]
  have hmultR : ∀ a ∈ A, ((mult (H a) : ℕ) : ℝ) = |g a| := by
    intro a ha
    obtain ⟨z, -, hm, habs⟩ := hmultA a ha
    rw [habs, hm]
  have hmultE : ∀ a ∈ A, ((mult (H a) : ℕ) : ℝ≥0∞) = ‖g a‖ₑ := by
    intro a ha
    obtain ⟨z, -, hm, habs⟩ := hmultA a ha
    rw [Real.enorm_eq_ofReal_abs, habs, ENNReal.ofReal_natCast, hm]
  have hmultpos : ∀ a ∈ A, 0 < mult (H a) := by
    intro a ha
    obtain ⟨z, hz, hm, -⟩ := hmultA a ha
    rw [hm]
    exact Int.natAbs_pos.2 (by rintro rfl; exact hg0 a ha (by simpa using hz))
  -- `∫_{H(A)} θ dHᵏ = ∫_A |g| J`, and `Hᵏ(H(A)) = ∫_A J ≤ ∫_A |g| J < ∞`
  have hmultint : ∫⁻ y in H '' A, (mult y : ℝ≥0∞) ∂μHE[k] =
      ∫⁻ u in A, ‖g u‖ₑ * ENNReal.ofReal (J u) := by
    rw [hareaA]
    refine setLIntegral_congr_fun hA (fun u hu => ?_)
    rw [hmultE u hu, mul_comm]
  have hNfin : μHE[k] (H '' A) ≠ ∞ := by
    refine ne_top_of_le_ne_top hfin' ?_
    rw [← setLIntegral_one, hareaA]
    refine setLIntegral_mono' hA (fun u hu => ?_)
    rw [mul_one]
    calc ENNReal.ofReal (J u) = 1 * ENNReal.ofReal (J u) := (one_mul _).symm
      _ ≤ ‖g u‖ₑ * ENNReal.ofReal (J u) := by
        gcongr
        rw [← hmultE u hu]
        exact_mod_cast hmultpos u hu
  -- Step 5: the orientation `ξ = ±η ∘ ψ` (sign of `g ∘ ψ`)
  let orient : Euclid N' → MultiVector N' k := fun y =>
    (if 0 ≤ g (ψ y) then (1 : ℝ) else -1) • η (ψ y)
  have hsgn : Measurable fun y => if 0 ≤ g (ψ y) then (1 : ℝ) else -1 :=
    Measurable.ite (measurableSet_le measurable_const (hg.comp hψm)) measurable_const
      measurable_const
  have horm : StronglyMeasurable orient :=
    hsgn.stronglyMeasurable.smul (hηm.comp_measurable hψm)
  have horA : ∀ a ∈ A, IsUnitOrientationOf (orient (H a))
      (LinearMap.range (fderiv ℝ H a : Euclid k →ₗ[ℝ] Euclid N')) := by
    intro a ha
    obtain ⟨τ, hτ, hτspan, hτor⟩ := hηor a ha
    show IsUnitOrientationOf ((if 0 ≤ g (ψ (H a)) then (1 : ℝ) else -1) • η (ψ (H a))) _
    rw [hψH a ha]
    split_ifs
    · rw [one_smul]
      exact ⟨τ, hτ, hτspan, hτor⟩
    · refine ⟨τ, hτ, hτspan, hτor.symm.imp (fun h' α => ?_) (fun h' α => ?_)⟩
      · simp [h' α]
      · simp [h' α]
  -- `orients`: `H(A)` has approximate tangent space `range DH(a)` at `H(a)` for a.e. `a ∈ A`,
  -- and `Hᵏ`-null sets of parameters have `Hᵏ`-null images
  have htan := Submission.dpf_approxTangent_ae_bilipschitz_piece N' k univ (H '' A) H A L κ
    isOpen_univ hN (subset_univ _)
    (fun C _ _ => ne_top_of_le_ne_top hNfin (measure_mono inter_subset_left))
    hH hA hκ hbi hdiff subset_rfl
  have hgood : ∀ᵐ b ∂(volume.restrict A), ∃ Q : Submodule ℝ (Euclid N'),
      HasApproximateTangentSpaceAt k (H '' A) (H b) Q ∧ IsUnitOrientationOf (orient (H b)) Q := by
    filter_upwards [htan, ae_restrict_mem hA] with b hb hbA
    exact ⟨_, hb, horA b hbA⟩
  have horients : ∀ᵐ y ∂(μHE[k].restrict (H '' A)), ∃ Q : Submodule ℝ (Euclid N'),
      HasApproximateTangentSpaceAt k (H '' A) y Q ∧ IsUnitOrientationOf (orient y) Q := by
    rw [ae_restrict_iff' hA, ae_iff] at hgood
    rw [ae_restrict_iff' hN, ae_iff]
    refine measure_mono_null (fun y hy => ?_) (le_zero_iff.1
      ((Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn k
        hH.lipschitzOnWith).trans
        (by rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume, hgood, mul_zero])))
    obtain ⟨⟨b, hb, rfl⟩, hPy⟩ := not_imp.1 hy
    exact ⟨b, not_imp.2 ⟨hb, hPy⟩, rfl⟩
  -- Step 6: the triple `(H(A), θ, ξ)` is an integer multiplicity representation in `ℝ^{N'}`
  let R : IMRep (univ : Set (Euclid N')) k :=
    { carrier := H '' A
      mult := mult
      orient := orient
      measurableSet_carrier := hN
      carrier_subset := subset_univ _
      rectifiable := ⟨∅, measure_empty, fun _ => H, fun _ => ⟨L, hH⟩,
        fun y hy => Or.inr (mem_iUnion.2 ⟨0, image_subset_range H A hy⟩)⟩
      measurable_mult := hmultm
      mult_pos := by
        rintro _ ⟨a, ha, rfl⟩
        exact hmultpos a ha
      locallyIntegrable_mult := fun K _ _ =>
        ne_top_of_le_ne_top (hmultint ▸ hfin') (lintegral_mono_set inter_subset_left)
      aestronglyMeasurable_orient := horm.aestronglyMeasurable
      orients := horients }
  obtain ⟨Φ, R', hRep, hcar, hmul, hori⟩ :=
    hIMCb N' k univ R univ isOpen_univ MeasurableSet.univ
  have hcar' : R'.carrier = H '' A := by rw [hcar, inter_univ]
  have hΦ : ∀ ω : TestFormOn (univ : Set (Euclid N')) k, Φ ω =
      ∫ y in H '' A, (mult y : ℝ) * orient y ((ω : DifferentialForm (Euclid N') k) y) ∂μHE[k] := by
    intro ω
    rw [hRep ω, IMRep.action, hcar', hmul, hori]
  -- Step 7: `Hᵏ⌞H(A) = H_#(J Lᵏ⌞A)`, hence `∫_{H(A)} h dHᵏ = ∫_A J (h ∘ H)`
  have hmeasEq : μHE[k].restrict (H '' A) =
      Measure.map H ((volume.restrict A).withDensity fun u => ENNReal.ofReal (J u)) := by
    ext S hS
    calc (μHE[k].restrict (H '' A)) S = ∫⁻ y in H '' A, S.indicator 1 y ∂μHE[k] :=
          (lintegral_indicator_one hS).symm
      _ = ∫⁻ u in A, ENNReal.ofReal (J u) * S.indicator 1 (H u) := hareaA _
      _ = ∫⁻ u in A, (H ⁻¹' S).indicator (fun u => ENNReal.ofReal (J u)) u := by
          refine lintegral_congr fun u => ?_
          by_cases hu : H u ∈ S <;> simp [hu]
      _ = _ := by
          rw [lintegral_indicator (hHm hS), Measure.map_apply hHm hS, withDensity_apply _ (hHm hS)]
  have hint : ∀ h : Euclid N' → ℝ, AEStronglyMeasurable h (μHE[k].restrict (H '' A)) →
      ∫ y in H '' A, h y ∂μHE[k] = ∫ u in A, J u * h (H u) := by
    intro h hh
    rw [hmeasEq] at hh ⊢
    rw [integral_map hHm.aemeasurable hh, integral_withDensity_eq_integral_toReal_smul
      hJm'.ennreal_ofReal (ae_of_all _ fun _ => ENNReal.ofReal_lt_top)]
    refine integral_congr_ae (ae_of_all _ fun u => ?_)
    simp only [smul_eq_mul, ENNReal.toReal_ofReal (hJnn u)]
  -- Step 8: the action `Φ(ω) = ∫_A g ω(H)(DH e)`
  have hval : ∀ ω : TestFormOn (univ : Set (Euclid N')) k, Φ ω = ∫ u in A, g u *
      (ω : DifferentialForm (Euclid N') k) (H u)
        (fun a => fderiv ℝ H u (EuclideanSpace.single a (1 : ℝ))) := by
    intro ω
    have hωt : IsTestForm (ω : DifferentialForm (Euclid N') k) := ω.2.1
    have hωc : Continuous (ω : DifferentialForm (Euclid N') k) := ContDiff.continuous hωt.1
    have hcont : Continuous (uncurry fun (ξ : MultiVector N' k) (α : Covector (Euclid N') k) =>
        ξ α) := isBoundedBilinearMap_apply.continuous
    have hm : AEStronglyMeasurable
        (fun y => (mult y : ℝ) * orient y ((ω : DifferentialForm (Euclid N') k) y))
        (μHE[k].restrict (H '' A)) :=
      (measurable_from_nat.comp hmultm).aestronglyMeasurable.mul
        (hcont.comp_aestronglyMeasurable₂ horm.aestronglyMeasurable hωc.aestronglyMeasurable)
    rw [hΦ ω, hint _ hm]
    refine setIntegral_congr_fun hA (fun u hu => ?_)
    have hJu : J u ≠ 0 := (hJpos u hu).ne'
    rw [hmultR u hu]
    show J u * (|g u| * ((if 0 ≤ g (ψ (H u)) then (1 : ℝ) else -1) *
      η (ψ (H u)) ((ω : DifferentialForm (Euclid N') k) (H u)))) = _
    rw [hψH u hu, hη]
    split_ifs with hgu
    · rw [abs_of_nonneg hgu]
      field_simp
    · rw [abs_of_neg (not_le.1 hgu)]
      field_simp
  -- Step 9: the mass bound, from `|ξ(α)| ≤ |α|` a.e. (IMC (d))
  have hbound : ∀ᵐ y ∂(μHE[k].restrict (H '' A)), ∀ α : Covector (Euclid N') k,
      |orient y α| ≤ covectorEuclideanNorm α := by
    have h := hIMCd N' k univ R'
    rw [hcar', hori] at h
    exact h
  have hmass : Φ.mass ≤ ∫⁻ u in A, ‖g u‖ₑ * ENNReal.ofReal (J u) := by
    refine sSup_le ?_
    rintro _ ⟨ω, hω, rfl⟩
    show ENNReal.ofReal (Φ ω) ≤ _
    rw [hΦ ω, ← hmultint]
    calc ENNReal.ofReal (∫ y in H '' A, (mult y : ℝ) *
          orient y ((ω : DifferentialForm (Euclid N') k) y) ∂μHE[k])
        ≤ ‖∫ y in H '' A, (mult y : ℝ) *
          orient y ((ω : DifferentialForm (Euclid N') k) y) ∂μHE[k]‖ₑ := by
          rw [Real.enorm_eq_ofReal_abs]
          exact ENNReal.ofReal_le_ofReal (le_abs_self _)
      _ ≤ ∫⁻ y in H '' A, ‖(mult y : ℝ) *
          orient y ((ω : DifferentialForm (Euclid N') k) y)‖ₑ ∂μHE[k] :=
          enorm_integral_le_lintegral_enorm _
      _ ≤ ∫⁻ y in H '' A, (mult y : ℝ≥0∞) ∂μHE[k] := by
          refine lintegral_mono_ae (hbound.mono fun y hy => ?_)
          rw [Real.enorm_eq_ofReal_abs, ← ENNReal.ofReal_natCast]
          refine ENNReal.ofReal_le_ofReal ?_
          rw [abs_mul, Nat.abs_cast]
          exact mul_le_of_le_one_right (Nat.cast_nonneg _) ((hy _).trans (hω.2 y))
  exact ⟨Φ, ⟨R', hRep⟩, hmass, hval⟩
/-- **First-order calculus of Lipschitz maps on parameter domains** (Simon Ch. 7, deformation step;
Ch. 6, 2.29; Ch. 2, 3.3–3.5).  Write `J_H(u) = √det(⟨DH(u)eₐ, DH(u)e_b⟩)`.
(i) If `F` is `Λ`-Lipschitz and `G` is differentiable at `u`, then `J_{F∘G}(u) ≤ Λᵏ J_G(u)`:
`|D(F∘G)(u)v| ≤ Λ|DG(u)v|` by difference quotients; a non-injective `D(F∘G)(u)` has singular Gram
matrix, and otherwise the area formula for the linear maps `L = D(F∘G)(u)`, `M = DG(u)` on the unit
ball `S` gives `Hᵏ(L S) = J(L)|S|`, `Hᵏ(M S) = J(M)|S|`, while `L = A ∘ M` with `A` `Λ`-Lipschitz on
`M S`, so `Hᵏ(L S) ≤ Λᵏ Hᵏ(M S)`.
(ii) If `H, H'` are Lipschitz and agree a.e. on a Borel set `B`, then `DH = DH'` a.e. on `B`: at a
point `u` of `E = {H = H'}` where `E` has density `1` along the balls `B(y, |y - u|/(n+1))`,
`y → u` (Lebesgue density theorem for the doubling measure `Lᵏ`), every `y` near `u` is within
`|y - u|/(n+1)` of `E`, so `H - H'` has derivative `0` at `u`. -/
theorem Submission.dor_lmb_fcd_imp_lipschitz_jacobian_locality : (∀ (k N N' : ℕ) (F : Euclid N → Euclid N') (G : Euclid k → Euclid N) (Λ : NNReal) (u : Euclid k), LipschitzWith Λ F → DifferentiableAt ℝ G u → Real.sqrt (Matrix.det (Matrix.of fun a b : Fin k => inner ℝ (fderiv ℝ (F ∘ G) u (EuclideanSpace.single a (1 : ℝ))) (fderiv ℝ (F ∘ G) u (EuclideanSpace.single b (1 : ℝ))))) ≤ (Λ : ℝ) ^ k * Real.sqrt (Matrix.det (Matrix.of fun a b : Fin k => inner ℝ (fderiv ℝ G u (EuclideanSpace.single a (1 : ℝ))) (fderiv ℝ G u (EuclideanSpace.single b (1 : ℝ)))))) ∧ ∀ (k N' : ℕ) (H H' : Euclid k → Euclid N') (B : Set (Euclid k)) (L L' : NNReal), LipschitzWith L H → LipschitzWith L' H' → MeasurableSet B → (∀ᵐ u ∂(volume.restrict B), H u = H' u) → ∀ᵐ u ∂(volume.restrict B), fderiv ℝ H u = fderiv ℝ H' u := by
  refine ⟨fun k N N' F G Λ u hF hG => ?_, fun k N' H H' B L L' hH hH' hB hae => ?_⟩
  · -- (i)  `Lm = D(F∘G)(u)`, `Mm = DG(u)`
    set Lm := fderiv ℝ (F ∘ G) u with hLm
    set Mm := fderiv ℝ G u with hMm
    -- `|Lm v| ≤ Λ |Mm v|`, from the difference quotients along `u + v/n`
    have hLM : ∀ v : Euclid k, ‖Lm v‖ ≤ (Λ : ℝ) * ‖Mm v‖ := by
      intro v
      by_cases hFG : DifferentiableAt ℝ (F ∘ G) u
      · have hc : Tendsto (fun n : ℕ => ‖(n : ℝ)‖) atTop atTop := by
          simpa only [Real.norm_natCast] using tendsto_natCast_atTop_atTop
        have h1 := (hFG.hasFDerivAt.lim v hc).norm
        have h2 := ((hG.hasFDerivAt.lim v hc).norm).const_mul (Λ : ℝ)
        refine le_of_tendsto_of_tendsto' h1 h2 fun n => ?_
        rw [norm_smul, norm_smul, mul_left_comm]
        refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
        rw [← dist_eq_norm, ← dist_eq_norm]
        exact hF.dist_le_mul _ _
      · rw [hLm, fderiv_zero_of_not_differentiableAt hFG, zero_apply, norm_zero]
        positivity
    by_cases hLinj : Injective Lm
    · have hMinj : Injective Mm := by
        intro v w hvw
        apply hLinj
        have h := hLM (v - w)
        simp only [map_sub, hvw, sub_self, norm_zero, mul_zero] at h
        exact sub_eq_zero.mp (norm_le_zero_iff.mp h)
      -- area formula for an injective linear map on the closed unit ball
      have harea : ∀ {P : ℕ} (T : Euclid k →L[ℝ] Euclid P), Injective T →
          μHE[k] (T '' closedBall 0 1) = ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun a b : Fin k =>
            inner ℝ (T (EuclideanSpace.single a (1 : ℝ))) (T (EuclideanSpace.single b (1 : ℝ)))))) *
            volume (closedBall (0 : Euclid k) 1) := by
        intro P T hT
        have h := (Submission.codim1_lura_gram_area_formula k P T).2 (closedBall 0 1)
          measurableSet_closedBall (fun x _ => T.differentiableAt)
          (fun x _ => by rw [T.fderiv]; exact hT) hT.injOn (fun _ => 1)
        simpa only [ContinuousLinearMap.fderiv, mul_one, setLIntegral_one, setLIntegral_const] using h
      -- `Lm = A ∘ Mm` with `A = Lm ∘ Linv` `Λ`-Lipschitz on the range of `Mm`
      obtain ⟨Linv, hLinv⟩ := LinearMap.exists_leftInverse_of_injective (Mm : Euclid k →ₗ[ℝ] Euclid N)
        (LinearMap.ker_eq_bot.mpr hMinj)
      have hLx : ∀ x, Linv (Mm x) = x := fun x => by
        simpa using LinearMap.congr_fun hLinv x
      have hA : LipschitzOnWith Λ (fun y => Lm (Linv y)) (Mm '' closedBall 0 1) := by
        refine LipschitzOnWith.of_dist_le_mul fun y hy y' hy' => ?_
        obtain ⟨x, -, rfl⟩ := hy
        obtain ⟨x', -, rfl⟩ := hy'
        simp only [hLx, dist_eq_norm, ← map_sub]
        exact hLM (x - x')
      have himg : (fun y => Lm (Linv y)) '' (Mm '' closedBall 0 1) = Lm '' closedBall 0 1 := by
        rw [image_image]
        simp only [hLx]
      have hle := Poincare.SimonGMT.Chapter02.euclideanHausdorffMeasure_image_le_of_lipschitzOn k hA
      rw [himg, harea Lm hLinj, harea Mm hMinj] at hle
      have hS0 : volume (closedBall (0 : Euclid k) 1) ≠ 0 := (measure_closedBall_pos volume 0 one_pos).ne'
      have hSt : volume (closedBall (0 : Euclid k) 1) ≠ ∞ := measure_closedBall_lt_top.ne
      rw [← mul_assoc, ENNReal.mul_le_mul_iff_left hS0 hSt, ← ENNReal.ofReal_coe_nnreal,
        ← ENNReal.ofReal_pow Λ.coe_nonneg, ← ENNReal.ofReal_mul (p := (Λ : ℝ) ^ k) (by positivity)] at hle
      exact (ENNReal.ofReal_le_ofReal_iff (by positivity)).mp hle
    · -- a non-injective `Lm` has singular Gram matrix
      obtain ⟨v, w, hvw, hne⟩ : ∃ v w, Lm v = Lm w ∧ v ≠ w := by
        simpa [Injective] using hLinj
      have hdet : Matrix.det (Matrix.of fun a b : Fin k => inner ℝ (Lm (EuclideanSpace.single a (1 : ℝ)))
          (Lm (EuclideanSpace.single b (1 : ℝ)))) = 0 := by
        have hx : ∑ b, (v - w).ofLp b • EuclideanSpace.single b (1 : ℝ) = v - w := by
          ext i
          simp [Pi.single_apply]
        rw [← Matrix.exists_mulVec_eq_zero_iff]
        refine ⟨(v - w).ofLp, fun h0 => hne (sub_eq_zero.mp ?_), ?_⟩
        · rw [← hx, h0]
          simp
        · funext a
          simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.zero_apply]
          calc ∑ b, inner ℝ (Lm (EuclideanSpace.single a (1 : ℝ))) (Lm (EuclideanSpace.single b (1 : ℝ))) *
                (v - w).ofLp b
              = inner ℝ (Lm (EuclideanSpace.single a (1 : ℝ)))
                  (Lm (∑ b, (v - w).ofLp b • EuclideanSpace.single b (1 : ℝ))) := by
                rw [map_sum, inner_sum]
                refine Finset.sum_congr rfl fun b _ => ?_
                rw [map_smul, inner_smul_right, mul_comm]
            _ = 0 := by rw [hx, map_sub, hvw, sub_self, inner_zero_right]
      rw [hdet, Real.sqrt_zero]
      positivity
  · -- (ii)  `E = {H = H'}` is closed and contains almost all of `B`
    set E : Set (Euclid k) := {x | H x = H' x} with hE
    have hBE : B ≤ᵐ[volume] E := by
      filter_upwards [(ae_restrict_iff' hB).mp hae] with x hx
      exact fun hxB => hx hxB
    -- density of `E` along the balls `B(y, |y - x|/(n+1))`, `y → x`
    have hdens : ∀ᵐ x ∂(volume.restrict E), ∀ n : ℕ,
        Tendsto (fun y => volume (E ∩ closedBall y (dist y x / ((n : ℝ) + 1))) /
          volume (closedBall y (dist y x / ((n : ℝ) + 1)))) (𝓝[≠] x) (𝓝 1) := by
      rw [ae_all_iff]
      intro n
      filter_upwards [IsUnifLocDoublingMeasure.ae_tendsto_measure_inter_div
        (volume : Measure (Euclid k)) E ((n : ℝ) + 1)] with x hx
      have hn : (0 : ℝ) < (n : ℝ) + 1 := by positivity
      refine hx id (fun y => dist y x / ((n : ℝ) + 1)) ?_ ?_
      · rw [tendsto_nhdsWithin_iff]
        constructor
        · have h0 : Tendsto (fun y => dist y x / ((n : ℝ) + 1)) (𝓝 x) (𝓝 (dist x x / ((n : ℝ) + 1))) :=
            ((continuous_id.dist continuous_const).div_const _).tendsto x
          rw [dist_self, zero_div] at h0
          exact h0.mono_left nhdsWithin_le_nhds
        · filter_upwards [self_mem_nhdsWithin] with y hy
          exact div_pos (dist_pos.mpr (mem_compl_singleton_iff.mp hy)) hn
      · refine Eventually.of_forall fun y => ?_
        rw [mem_closedBall, id, mul_div_cancel₀ _ hn.ne', dist_comm]
    filter_upwards [hae, ae_mono (Measure.restrict_mono_ae hBE) hdens] with u hu hdu
    -- `H - H'` has derivative `0` at `u`
    have hD : HasFDerivAt (fun x => H x - H' x) (0 : Euclid k →L[ℝ] Euclid N') u := by
      refine HasFDerivAt.of_isLittleO (Asymptotics.isLittleO_iff.mpr fun c hc => ?_)
      obtain ⟨n, hn⟩ := exists_nat_gt (((L : ℝ) + L') / c)
      have hn1 : (0 : ℝ) < (n : ℝ) + 1 := by positivity
      have hev : ∀ᶠ y in 𝓝[≠] u, (E ∩ closedBall y (dist y u / ((n : ℝ) + 1))).Nonempty := by
        filter_upwards [(hdu n).eventually_ne one_ne_zero] with y hy
        refine nonempty_of_measure_ne_zero (μ := volume) fun h0 => hy ?_
        rw [h0, ENNReal.zero_div]
      rw [eventually_nhdsWithin_iff] at hev
      filter_upwards [hev] with y hy
      simp only [hu, sub_self, sub_zero, zero_apply]
      by_cases hyu : y = u
      · subst hyu
        simp [hu]
      obtain ⟨z, hzE, hz⟩ := hy (mem_compl_singleton_iff.mpr hyu)
      rw [mem_closedBall, dist_comm] at hz
      have hzE' : H z = H' z := hzE
      have hcoef : ((L : ℝ) + L') / ((n : ℝ) + 1) ≤ c := by
        rw [div_le_iff₀ hn1]
        rw [div_lt_iff₀ hc] at hn
        nlinarith
      calc ‖H y - H' y‖ = ‖(H y - H z) - (H' y - H' z)‖ := by rw [hzE']; congr 1; abel
        _ ≤ ‖H y - H z‖ + ‖H' y - H' z‖ := norm_sub_le _ _
        _ ≤ L * dist y z + L' * dist y z := by
            rw [← dist_eq_norm, ← dist_eq_norm]
            exact add_le_add (hH.dist_le_mul _ _) (hH'.dist_le_mul _ _)
        _ = (L + L') * dist y z := by ring
        _ ≤ (L + L') * (dist y u / ((n : ℝ) + 1)) := by gcongr
        _ = ((L + L') / ((n : ℝ) + 1)) * dist y u := by ring
        _ ≤ c * ‖y - u‖ := by
            rw [← dist_eq_norm]
            exact mul_le_mul_of_nonneg_right hcoef dist_nonneg
    by_cases hd : DifferentiableAt ℝ H u
    · have h1 := hd.hasFDerivAt.sub hD
      rw [show (H - fun x => H x - H' x) = H' from funext fun x => sub_sub_cancel (H x) (H' x)] at h1
      rw [h1.fderiv, sub_zero]
    · have hd' : ¬DifferentiableAt ℝ H' u := fun hd' => hd (by
        have h1 := hd'.hasFDerivAt.add hD
        rw [show (H' + fun x => H x - H' x) = H from funext fun x => add_sub_cancel (H' x) (H x)] at h1
        exact h1.differentiableAt)
      rw [fderiv_zero_of_not_differentiableAt hd, fderiv_zero_of_not_differentiableAt hd']

/-- **Integrality of the parametric image series** (Simon Ch. 6, 3.6–3.9: `f#τ(M, θ, ξ)` is an
integer multiplicity current; step 7 of the selected proof, with the bounds of step 6).  Write
`d = k + 1`, `Hᵢ = F ∘ Gᵢ`, `J_H = √det(⟨DH eₐ, DH e_b⟩)`,
`Tᵢ(ω) = ∫_{Bᵢ} wᵢ ω(Hᵢ)(DHᵢ e₀, …, DHᵢ eₖ)` and `mᵢ = ∫⁻_{Bᵢ} |wᵢ| J_{Gᵢ}`.
* `J_{Hᵢ} ≤ Λᵈ J_{Gᵢ}` on `Bᵢ` (`dor_lmb_fcd_imp_lipschitz_jacobian_locality`), so
  `∫⁻_{Bᵢ} |wᵢ| J_{Hᵢ} ≤ Λᵈ mᵢ < ∞`.
* `dor_lmb_fcd_imp_regular_partition` gives disjoint Borel `Aᵢₗ ⊆ Bᵢ` on which `Hᵢ` is
  bi-Lipschitz below with injective derivative, covering every `u ∈ Bᵢ` where `DHᵢ(u)` exists and
  is injective; `dor_lmb_fcd_imp_piece_current` gives integer multiplicity `Φᵢₗ` with
  `Φᵢₗ(ω) = ∫_{Aᵢₗ} wᵢ ω(Hᵢ)(DHᵢ e)` and `M(Φᵢₗ) ≤ ∫⁻_{Aᵢₗ} |wᵢ| J_{Hᵢ}`.
* On `Bᵢ \ ⋃ₗ Aᵢₗ` either `DHᵢ = 0` or the columns `DHᵢ eₐ` are linearly dependent, so the
  integrand vanishes there; it is integrable on `Bᵢ` (`|ω| ≤ C`, `‖DHᵢ‖ ≤ ΛLᵢ`).  Countable
  additivity gives `∑ₗ Φᵢₗ(ω) = Tᵢ(ω)` and `∑ₗ M(Φᵢₗ) ≤ ∫⁻_{Bᵢ} |wᵢ| J_{Hᵢ} ≤ Λᵈ mᵢ`.
* Enumerating the pairs `(i, l)` by `ℕ`, (IMS) gives an integer multiplicity `Y` with
  `∑ᵢₗ Φᵢₗ(ω) = Y(ω)`; summing fibrewise, `∑ᵢ Tᵢ(ω) = Y(ω)`.
* If `|ω(x)| ≤ c`, then `±c⁻¹ω` is admissible for the mass, so `|Φᵢₗ(ω)| ≤ c M(Φᵢₗ)` and
  `|Tᵢ(ω)| ≤ c ∑ₗ M(Φᵢₗ) ≤ c Λᵈ mᵢ`. -/
theorem Submission.dor_lmb_fcd_imp_image_series_im : (∀ (P m : ℕ) (U : Set (Euclid P)) (X : ℕ → GeometricCurrentOn U (m + 1)), IsOpen U → (∀ r, IsIntegerMultiplicity (X r)) → ∑' r, (X r).mass ≠ ∞ → ∃ Y : GeometricCurrentOn U (m + 1), IsIntegerMultiplicity Y ∧ (∀ ω : TestFormOn U (m + 1), HasSum (fun r => X r ω) (Y ω)) ∧ Y.mass ≤ ∑' r, (X r).mass) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (N N' k : ℕ) (G : ℕ → Euclid (k + 1) → Euclid N) (B : ℕ → Set (Euclid (k + 1))) (w : ℕ → Euclid (k + 1) → ℝ) (F : Euclid N → Euclid N') (Λ : NNReal), (∀ i, ∃ L : NNReal, LipschitzWith L (G i)) → (∀ i, MeasurableSet (B i)) → (∀ i, ∀ u ∈ B i, DifferentiableAt ℝ (G i) u) → (∀ i, Measurable (w i)) → (∀ i u, ∃ z : ℤ, w i u = z) → (∀ i, ∀ u ∈ B i, w i u ≠ 0) → (∀ i, IntegrableOn (w i) (B i)) → ∑' i, ∫⁻ u in B i, ‖w i u‖ₑ * ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun a b : Fin (k + 1) => inner ℝ (fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ))) (fderiv ℝ (G i) u (EuclideanSpace.single b (1 : ℝ)))))) ≠ ∞ → LipschitzWith Λ F → ∃ Y : GeometricCurrentOn (univ : Set (Euclid N')) (k + 1), IsIntegerMultiplicity Y ∧ (∀ ω : TestFormOn (univ : Set (Euclid N')) (k + 1), HasSum (fun i => ∫ u in B i, w i u * (ω : DifferentialForm (Euclid N') (k + 1)) ((F ∘ G i) u) (fun a => fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ)))) (Y ω)) ∧ ∀ (ω : TestFormOn (univ : Set (Euclid N')) (k + 1)) (c : ℝ), 0 < c → (∀ x, covectorEuclideanNorm ((ω : DifferentialForm (Euclid N') (k + 1)) x) ≤ c) → ∀ i, |∫ u in B i, w i u * (ω : DifferentialForm (Euclid N') (k + 1)) ((F ∘ G i) u) (fun a => fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ)))| ≤ c * (Λ : ℝ) ^ (k + 1) * (∫⁻ u in B i, ‖w i u‖ₑ * ENNReal.ofReal (Real.sqrt (Matrix.det (Matrix.of fun a b : Fin (k + 1) => inner ℝ (fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ))) (fderiv ℝ (G i) u (EuclideanSpace.single b (1 : ℝ))))))).toReal := by
  intro hIMS hIMC N N' k G B w F Λ hGlip hBm hGd hwm hwZ hw0 hwi hsum hF
  -- Lipschitz constants `Lᵢ` of `Gᵢ`; `Hᵢ = F ∘ Gᵢ` is `ΛLᵢ`-Lipschitz
  choose L hL using hGlip
  have hHlip : ∀ i, LipschitzWith (Λ * L i) (F ∘ G i) := fun i => hF.comp (hL i)
  have hΛ : (Λ : ℝ≥0∞) ^ (k + 1) ≠ ∞ := ENNReal.pow_ne_top ENNReal.coe_ne_top
  -- `mᵢ = ∫⁻_{Bᵢ} |wᵢ| J_{Gᵢ} < ∞`
  have hm : ∀ i, (∫⁻ u in B i, ‖w i u‖ₑ * ENNReal.ofReal (Real.sqrt (Matrix.det
      (Matrix.of fun a b : Fin (k + 1) =>
        inner ℝ (fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ)))
          (fderiv ℝ (G i) u (EuclideanSpace.single b (1 : ℝ))))))) ≠ ∞ :=
    fun i => ENNReal.ne_top_of_tsum_ne_top hsum i
  -- (1) Jacobian comparison `J_{Hᵢ} ≤ Λᵈ J_{Gᵢ}` on `Bᵢ`: `∫⁻_{Bᵢ} |wᵢ| J_{Hᵢ} ≤ Λᵈ mᵢ`
  have hJ : ∀ i, (∫⁻ u in B i, ‖w i u‖ₑ * ENNReal.ofReal (Real.sqrt (Matrix.det
      (Matrix.of fun a b : Fin (k + 1) =>
        inner ℝ (fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ)))
          (fderiv ℝ (F ∘ G i) u (EuclideanSpace.single b (1 : ℝ))))))) ≤
      (Λ : ℝ≥0∞) ^ (k + 1) * ∫⁻ u in B i, ‖w i u‖ₑ * ENNReal.ofReal (Real.sqrt (Matrix.det
        (Matrix.of fun a b : Fin (k + 1) =>
          inner ℝ (fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ)))
            (fderiv ℝ (G i) u (EuclideanSpace.single b (1 : ℝ)))))) := by
    intro i
    rw [← lintegral_const_mul' _ _ hΛ]
    refine setLIntegral_mono' (hBm i) fun u hu => ?_
    have h := ENNReal.ofReal_le_ofReal
      ((Submission.dor_lmb_fcd_imp_lipschitz_jacobian_locality).1 (k + 1) N N' F (G i) Λ u hF
        (hGd i u hu))
    rw [ENNReal.ofReal_mul (p := (Λ : ℝ) ^ (k + 1)) (by positivity),
      ENNReal.ofReal_pow NNReal.zero_le_coe, ENNReal.ofReal_coe_nnreal] at h
    exact (mul_le_mul_of_nonneg_left h zero_le).trans_eq (mul_left_comm _ _ _)
  -- (3) disjoint Borel pieces `Aᵢₗ ⊆ Bᵢ` covering the points of `Bᵢ` where `DHᵢ` is injective
  choose A κ hAm hAB hAd hκ hAbl hAreg hAcov using fun i =>
    Submission.dor_lmb_fcd_imp_regular_partition (k + 1) N' (F ∘ G i) (B i) (hBm i)
  -- (4) the integer multiplicity piece currents `Φᵢₗ`
  choose Φ hΦIM hΦM hΦω using fun i l =>
    Submission.dor_lmb_fcd_imp_piece_current hIMC (k + 1) N' (F ∘ G i) (A i l) (Λ * L i) (κ i l)
      (w i) (hHlip i) (hAm i l) (hκ i l) (hAbl i l) (hAreg i l) (hwm i) (hwZ i)
      (fun u hu => hw0 i u (hAB i l hu))
      (ne_top_of_le_ne_top (ENNReal.mul_ne_top hΛ (hm i))
        ((lintegral_mono_set (hAB i l)).trans (hJ i)))
  -- (7) `∑ₗ M(Φᵢₗ) ≤ ∫⁻_{⋃ₗ Aᵢₗ} |wᵢ| J_{Hᵢ} ≤ Λᵈ mᵢ`
  have hmass : ∀ i, ∑' l, (Φ i l).mass ≤
      (Λ : ℝ≥0∞) ^ (k + 1) * ∫⁻ u in B i, ‖w i u‖ₑ * ENNReal.ofReal (Real.sqrt (Matrix.det
        (Matrix.of fun a b : Fin (k + 1) =>
          inner ℝ (fderiv ℝ (G i) u (EuclideanSpace.single a (1 : ℝ)))
            (fderiv ℝ (G i) u (EuclideanSpace.single b (1 : ℝ)))))) := by
    intro i
    refine (ENNReal.tsum_le_tsum fun l => hΦM i l).trans ?_
    rw [← lintegral_iUnion (hAm i) (hAd i)]
    exact (lintegral_mono_set (iUnion_subset (hAB i))).trans (hJ i)
  -- linearly independent columns `T e₀, …, T eₖ` force `T` to be injective
  have hcols : ∀ T : Euclid (k + 1) →L[ℝ] Euclid N',
      LinearIndependent ℝ (fun a => T (EuclideanSpace.single a (1 : ℝ))) → Injective T := by
    intro T hli
    rw [injective_iff_map_eq_zero]
    intro z hz
    have hzs : ∑ a, z.ofLp a • EuclideanSpace.single a (1 : ℝ) = z := by
      have h := (EuclideanSpace.basisFun (Fin (k + 1)) ℝ).sum_repr z
      simp only [EuclideanSpace.basisFun_apply, EuclideanSpace.basisFun_repr] at h
      exact h
    have hc : ∀ a, z.ofLp a = 0 := by
      refine Fintype.linearIndependent_iff.mp hli _ ?_
      calc ∑ a, z.ofLp a • T (EuclideanSpace.single a (1 : ℝ))
          = T (∑ a, z.ofLp a • EuclideanSpace.single a (1 : ℝ)) := by
            rw [map_sum]; simp only [map_smul]
        _ = 0 := by rw [hzs, hz]
    rw [← hzs]
    exact Finset.sum_eq_zero fun a _ => by rw [hc a, zero_smul]
  -- (2), (5), (6): `∑ₗ Φᵢₗ(ω) = Tᵢ(ω)`
  have hfib : ∀ i (ω : TestFormOn (univ : Set (Euclid N')) (k + 1)),
      HasSum (fun l => Φ i l ω) (∫ u in B i, w i u * (ω : DifferentialForm (Euclid N') (k + 1))
        ((F ∘ G i) u) (fun a => fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ)))) := by
    intro i ω
    have hωc : Continuous (ω : DifferentialForm (Euclid N') (k + 1)) := ω.property.1.1.continuous
    obtain ⟨C, hC⟩ := HasCompactSupport.exists_bound_of_continuous ω.property.1.2 hωc
    -- (2) the integrand is Borel and bounded by `C (ΛLᵢ)ᵈ |wᵢ|`, hence integrable on `Bᵢ`
    have hcont : Continuous fun p : Euclid N' × (Euclid (k + 1) →L[ℝ] Euclid N') =>
        (ω : DifferentialForm (Euclid N') (k + 1)) p.1
          (fun a => p.2 (EuclideanSpace.single a (1 : ℝ))) :=
      (hωc.comp continuous_fst).eval
        (continuous_pi fun a => continuous_snd.clm_apply continuous_const)
    have hmeas : AEStronglyMeasurable (fun u => (ω : DifferentialForm (Euclid N') (k + 1))
        ((F ∘ G i) u) (fun a => fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ))))
        (volume.restrict (B i)) :=
      Continuous.comp_aestronglyMeasurable₂
        (g := fun (y : Euclid N') (T : Euclid (k + 1) →L[ℝ] Euclid N') =>
          (ω : DifferentialForm (Euclid N') (k + 1)) y
            (fun a => T (EuclideanSpace.single a (1 : ℝ))))
        hcont (hHlip i).continuous.aestronglyMeasurable
        (measurable_fderiv ℝ (F ∘ G i)).aestronglyMeasurable
    have hbd : ∀ u, ‖(ω : DifferentialForm (Euclid N') (k + 1)) ((F ∘ G i) u)
        (fun a => fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ)))‖ ≤
        C * ((Λ * L i : NNReal) : ℝ) ^ (k + 1) := by
      intro u
      have hcol : ∀ a : Fin (k + 1),
          ‖fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ))‖ ≤ ((Λ * L i : NNReal) : ℝ) := by
        intro a
        calc ‖fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ))‖
            ≤ ‖fderiv ℝ (F ∘ G i) u‖ * ‖EuclideanSpace.single a (1 : ℝ)‖ :=
              (fderiv ℝ (F ∘ G i) u).le_opNorm _
          _ = ‖fderiv ℝ (F ∘ G i) u‖ := by simp
          _ ≤ _ := norm_fderiv_le_of_lipschitz ℝ (hHlip i)
      have hprod : ∏ a : Fin (k + 1), ‖fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ))‖ ≤
          ((Λ * L i : NNReal) : ℝ) ^ (k + 1) := by
        calc ∏ a : Fin (k + 1), ‖fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ))‖
            ≤ ∏ _a : Fin (k + 1), ((Λ * L i : NNReal) : ℝ) :=
              Finset.prod_le_prod₀ (fun a _ => norm_nonneg _) fun a _ => hcol a
          _ = _ := by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      exact (((ω : DifferentialForm (Euclid N') (k + 1)) ((F ∘ G i) u)).le_opNorm _).trans
        (mul_le_mul (hC _) hprod (Finset.prod_nonneg fun a _ => norm_nonneg _)
          ((norm_nonneg _).trans (hC 0)))
    have hint : IntegrableOn (fun u => w i u * (ω : DifferentialForm (Euclid N') (k + 1))
        ((F ∘ G i) u) (fun a => fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ)))) (B i) := by
      refine Integrable.mono' ((hwi i).norm.mul_const (C * ((Λ * L i : NNReal) : ℝ) ^ (k + 1)))
        ((hwm i).aestronglyMeasurable.mul hmeas) (ae_of_all _ fun u => ?_)
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_left (hbd u) (norm_nonneg _)
    -- (5) the integrand vanishes on `Bᵢ \ ⋃ₗ Aᵢₗ`, where `DHᵢ = 0` or `DHᵢ` is not injective
    have hvan : ∀ u ∈ B i \ ⋃ l, A i l, w i u * (ω : DifferentialForm (Euclid N') (k + 1))
        ((F ∘ G i) u) (fun a => fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ))) = 0 := by
      rintro u ⟨huB, huA⟩
      rw [mem_iUnion, not_exists] at huA
      suffices h : (ω : DifferentialForm (Euclid N') (k + 1)) ((F ∘ G i) u)
          (fun a => fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ))) = 0 by
        rw [h, mul_zero]
      by_cases hd : DifferentiableAt ℝ (F ∘ G i) u
      · by_cases hinj : Injective (fderiv ℝ (F ∘ G i) u)
        · obtain ⟨l, hl⟩ := hAcov i u huB hd hinj
          exact absurd hl (huA l)
        · -- the columns `DHᵢ(u) eₐ` are linearly dependent
          exact ((ω : DifferentialForm (Euclid N') (k + 1))
            ((F ∘ G i) u)).toAlternatingMap.map_linearDependent _ fun hli => hinj (hcols _ hli)
      · rw [fderiv_zero_of_not_differentiableAt hd]
        exact ((ω : DifferentialForm (Euclid N') (k + 1)) ((F ∘ G i) u)).map_zero
    -- (6) `Tᵢ(ω) = ∫_{⋃ₗ Aᵢₗ} = ∑ₗ ∫_{Aᵢₗ} = ∑ₗ Φᵢₗ(ω)`
    rw [setIntegral_eq_of_subset_of_forall_sdiff_eq_zero (hBm i) (iUnion_subset (hAB i)) hvan]
    have hfun : (fun l => Φ i l ω) = fun l => ∫ u in A i l, w i u *
        (ω : DifferentialForm (Euclid N') (k + 1)) ((F ∘ G i) u)
          (fun a => fderiv ℝ (F ∘ G i) u (EuclideanSpace.single a (1 : ℝ))) :=
      funext fun l => hΦω i l ω
    rw [hfun]
    exact hasSum_integral_iUnion (hAm i) (hAd i) (hint.mono_set (iUnion_subset (hAB i)))
  -- (8) enumerate the pieces by `ℕ`: `Xᵣ = Φ_{π(r)}`; (IMS) gives the integer multiplicity `Y`
  let π : ℕ ≃ ℕ × ℕ := Nat.pairEquiv.symm
  let X : ℕ → GeometricCurrentOn (univ : Set (Euclid N')) (k + 1) := fun r => Φ (π r).1 (π r).2
  have hXmass : ∑' r, (X r).mass ≠ ∞ := by
    have h : ∑' r, (X r).mass = ∑' i, ∑' l, (Φ i l).mass :=
      (Equiv.tsum_eq π fun p : ℕ × ℕ => (Φ p.1 p.2).mass).trans
        (ENNReal.tsum_prod (f := fun i l => (Φ i l).mass))
    rw [h]
    refine ne_top_of_le_ne_top (ENNReal.mul_ne_top hΛ hsum) ?_
    rw [← ENNReal.tsum_mul_left]
    exact ENNReal.tsum_le_tsum hmass
  obtain ⟨Y, hYIM, hYsum, -⟩ :=
    hIMS N' k univ X isOpen_univ (fun r => hΦIM (π r).1 (π r).2) hXmass
  refine ⟨Y, hYIM, fun ω => ?_, fun ω c hc hωc i => ?_⟩
  · -- (9) `HasSum ((i, l) ↦ Φᵢₗ(ω)) (Y ω)`, summed fibrewise over `l`
    have h : HasSum ((fun p : ℕ × ℕ => Φ p.1 p.2 ω) ∘ π) (Y ω) := hYsum ω
    exact ((Equiv.hasSum_iff π).mp h).prod_fiberwise fun i => hfib i ω
  · -- (10) `±Tᵢ(ω) = ∑ₗ ±Φᵢₗ(ω) ≤ c ∑ₗ M(Φᵢₗ) ≤ c Λᵈ mᵢ`
    have hc0 : c ≠ 0 := hc.ne'
    have hsmul : ∀ (s : ℝ) (α : Covector (Euclid N') (k + 1)),
        covectorEuclideanNorm (s • α) = |s| * covectorEuclideanNorm α := by
      intro s α
      unfold covectorEuclideanNorm
      rw [← Real.sqrt_sq_eq_abs, ← Real.sqrt_mul (sq_nonneg s), Finset.mul_sum]
      congr 1
      refine Finset.sum_congr rfl fun I _ => ?_
      split_ifs
      · rw [ContinuousAlternatingMap.smul_apply, smul_eq_mul, mul_pow]
      · rw [mul_zero]
    -- `|Z(ω)| ≤ c M(Z)`: `±c⁻¹ω` is admissible for `M(Z) = M_{ℝ^{N'}}(Z)`
    have hZω : ∀ Z : GeometricCurrentOn (univ : Set (Euclid N')) (k + 1), Z.mass ≠ ∞ →
        |Z ω| ≤ c * Z.mass.toReal := by
      intro Z hZ
      have hadm : ∀ s : ℝ, |s| = c⁻¹ → s * Z ω ≤ Z.mass.toReal := by
        intro s hs
        have hmem : s • ω ∈ massAdmissibleOn (univ : Set (Euclid N')) (k + 1) univ := by
          rw [massAdmissibleOn, mem_ofPred_eq]
          refine ⟨subset_univ _, fun x => ?_⟩
          rw [Submodule.coe_smul, Pi.smul_apply, hsmul, hs]
          calc c⁻¹ * covectorEuclideanNorm ((ω : DifferentialForm (Euclid N') (k + 1)) x)
              ≤ c⁻¹ * c := mul_le_mul_of_nonneg_left (hωc x) (inv_nonneg.mpr hc.le)
            _ = 1 := inv_mul_cancel₀ hc0
        have h := Z.le_massOn hmem
        rw [map_smul, smul_eq_mul] at h
        exact (ENNReal.ofReal_le_iff_le_toReal hZ).mp h
      have h1 := mul_le_mul_of_nonneg_left (hadm c⁻¹ (abs_of_pos (inv_pos.mpr hc))) hc.le
      have h2 := mul_le_mul_of_nonneg_left
        (hadm (-c⁻¹) (by rw [abs_neg, abs_of_pos (inv_pos.mpr hc)])) hc.le
      rw [← mul_assoc, mul_inv_cancel₀ hc0, one_mul] at h1
      rw [neg_mul, mul_neg, ← mul_assoc, mul_inv_cancel₀ hc0, one_mul] at h2
      rw [abs_le]
      constructor <;> linarith
    have hfinsum : ∑' l, (Φ i l).mass ≠ ∞ :=
      ne_top_of_le_ne_top (ENNReal.mul_ne_top hΛ (hm i)) (hmass i)
    have hfin : ∀ l, (Φ i l).mass ≠ ∞ := ENNReal.ne_top_of_tsum_ne_top hfinsum
    have hS : HasSum (fun l => c * ((Φ i l).mass).toReal) (c * (∑' l, (Φ i l).mass).toReal) := by
      rw [ENNReal.tsum_toReal_eq hfin]
      exact (ENNReal.summable_toReal hfinsum).hasSum.mul_left c
    have hup := hasSum_le (fun l => (le_abs_self _).trans (hZω _ (hfin l))) (hfib i ω) hS
    have hlo := hasSum_le (fun l => (neg_le_abs _).trans (hZω _ (hfin l))) (hfib i ω).neg hS
    have hfinal := mul_le_mul_of_nonneg_left
      (ENNReal.toReal_mono (ENNReal.mul_ne_top hΛ (hm i)) (hmass i)) hc.le
    rw [ENNReal.toReal_mul, ENNReal.toReal_pow, ENNReal.coe_toReal, ← mul_assoc] at hfinal
    rw [abs_le]
    constructor <;> linarith
/-- **The coordinate covector `dx^I`** (Simon Ch. 6, §1): for `I : Fin n → Fin P` some
`n`-covector `θ` on `ℝᴾ` has `θ(v₁, …, vₙ) = det (vⱼ(I k))_{k,j}`.  With the coordinate
projection `p_I x = (x(I k))_k`, `θ⁰ = det ∘ p_I` is alternating, `det Mᵀ = det M` gives the
formula, and the Leibniz formula with `|x(l)| ≤ ‖x‖` gives `|θ⁰(v)| ≤ n! ∏ⱼ ‖vⱼ‖`, so
`θ⁰` is continuous. -/
theorem Submission.cmr_cc_det_covector_exists : ∀ (P n : ℕ) (I : Fin n → Fin P), ∃ θ : Covector (Euclid P) n, ∀ v : Fin n → Euclid P, θ v = Matrix.det (Matrix.of fun k j => v j (I k)) := by
  intro P n I
  -- Step 1: the coordinate projection `p_I x = (x(I k))_k` is linear
  let p : Euclid P →ₗ[ℝ] (Fin n → ℝ) :=
    { toFun := fun x k => x (I k)
      map_add' := fun x y => by
        funext k
        simp
      map_smul' := fun c x => by
        funext k
        simp }
  -- Step 2: `θ⁰ = Θ ∘ p_I`, with `Θ` the determinant as an alternating map in the rows
  let θ₀ : Euclid P [⋀^Fin n]→ₗ[ℝ] ℝ := Matrix.detRowAlternating.compLinearMap p
  -- Step 3: `θ⁰(v) = det (vⱼ(I k))_{j,k} = det (vⱼ(I k))_{k,j}` by `det Mᵀ = det M`
  have hθ₀ : ∀ v : Fin n → Euclid P, θ₀ v = Matrix.det (Matrix.of fun k j => v j (I k)) := by
    intro v
    rw [← Matrix.det_transpose]
    rfl
  -- Step 4: the Leibniz formula, `|sign σ| = 1` and `|x(l)| ≤ ‖x‖` give
  -- `|θ⁰(v)| ≤ n! ∏ⱼ ‖vⱼ‖`
  have hbound : ∀ v : Fin n → Euclid P, ‖θ₀ v‖ ≤ (n.factorial : ℝ) * ∏ j, ‖v j‖ := by
    intro v
    rw [hθ₀, Real.norm_eq_abs, Matrix.det_apply]
    calc |∑ σ : Equiv.Perm (Fin n),
            Equiv.Perm.sign σ • ∏ j, Matrix.of (fun k j => v j (I k)) (σ j) j|
        ≤ ∑ σ : Equiv.Perm (Fin n),
            |Equiv.Perm.sign σ • ∏ j, Matrix.of (fun k j => v j (I k)) (σ j) j| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _σ : Equiv.Perm (Fin n), ∏ j, ‖v j‖ := by
          refine Finset.sum_le_sum fun σ _ => ?_
          have hσ : |Equiv.Perm.sign σ • ∏ j, Matrix.of (fun k j => v j (I k)) (σ j) j| =
              ∏ j, |v j (I (σ j))| := by
            rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h | h <;>
              simp [h, Finset.abs_prod]
          rw [hσ]
          gcongr with j
          rw [← Real.norm_eq_abs]
          exact PiLp.norm_apply_le (v j) (I (σ j))
      _ = (n.factorial : ℝ) * ∏ j, ‖v j‖ := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_perm, Fintype.card_fin,
            nsmul_eq_mul]
  -- Step 5: `θ = θ⁰.mkContinuous n!` is an `n`-covector with the same values as `θ⁰`
  exact ⟨θ₀.mkContinuous (n.factorial : ℝ) hbound, hθ₀⟩
/-- **Coordinate expansion of a `k`-covector** (the pointwise identity behind
`H^#ω(u)(e) = Σ_I ω_I(H(u)) det D(H^I)(u)`): for `f ∈ Λᵏ(ℝ^{N'})` and `u ∈ (ℝ^{N'})ᵏ`,
`k! f(u) = Σ_I f(e'_{I 0}, …, e'_{I (k-1)}) det (u_b (I c))_{c,b}`, the sum over all maps
`I : Fin k → Fin N'`.  Expand each `u_b = Σ_i u_b(i) e'_i` and use multilinearity; for each
permutation `σ` reindex `J = I ∘ σ` and use `f (v ∘ σ) = sign σ • f v`; average over the `k!`
permutations and recognize the Leibniz formula for the determinant. -/
theorem Submission.dor_lmb_fcd_jwc_covector_det_expansion : ∀ (N' k : ℕ) (f : Covector (Euclid N') k) (u : Fin k → Euclid N'), (k.factorial : ℝ) * f u = ∑ I : Fin k → Fin N', f (fun c => EuclideanSpace.single (I c) (1 : ℝ)) * Matrix.det (Matrix.of fun c b => u b (I c)) := by
  intro N' k f u
  set e : Fin N' → Euclid N' := fun i => EuclideanSpace.single i (1 : ℝ) with he
  -- step 1: multilinear expansion in the standard basis
  have h1 : f u = ∑ J : Fin k → Fin N', (∏ b, u b (J b)) * f (fun b => e (J b)) := by
    have hu : u = fun b => ∑ i, u b i • e i := by
      funext b
      conv_lhs => rw [← (EuclideanSpace.basisFun (Fin N') ℝ).sum_repr (u b)]
      simp [he]
    conv_lhs => rw [hu]
    rw [show f (fun b => ∑ i, u b i • e i) = f.toMultilinearMap (fun b => ∑ i, u b i • e i) from rfl,
      MultilinearMap.map_sum]
    refine Finset.sum_congr rfl fun J _ => ?_
    rw [MultilinearMap.map_smul_univ]
    simp [smul_eq_mul]
  -- step 2: reindex by a permutation `σ`, using alternation
  have h2 : ∀ σ : Equiv.Perm (Fin k), f u = ∑ I : Fin k → Fin N',
      ((Equiv.Perm.sign σ : ℤ) : ℝ) * (∏ b, u b (I (σ b))) * f (fun c => e (I c)) := by
    intro σ
    rw [h1]
    rw [← Equiv.sum_comp ((σ.symm).arrowCongr (Equiv.refl (Fin N')))]
    refine Finset.sum_congr rfl fun I _ => ?_
    have hperm : f (fun b => e (I (σ b))) = ((Equiv.Perm.sign σ : ℤ) : ℝ) * f (fun c => e (I c)) := by
      have := f.toAlternatingMap.map_perm (fun c => e (I c)) σ
      simp only [Function.comp_def] at this
      rw [show f (fun b => e (I (σ b))) = f.toAlternatingMap (fun b => e (I (σ b))) from rfl, this,
        Units.smul_def, zsmul_eq_mul]
      rfl
    simp only [Equiv.arrowCongr_apply, Equiv.refl_apply, Equiv.symm_symm, Function.comp_apply]
    rw [hperm]
    ring
  -- step 3: average over `σ` and recognize the Leibniz formula
  have h3 : (k.factorial : ℝ) * f u = ∑ σ : Equiv.Perm (Fin k), f u := by
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_perm, Fintype.card_fin, nsmul_eq_mul]
  rw [h3]
  calc ∑ σ : Equiv.Perm (Fin k), f u
      = ∑ σ : Equiv.Perm (Fin k), ∑ I : Fin k → Fin N',
          ((Equiv.Perm.sign σ : ℤ) : ℝ) * (∏ b, u b (I (σ b))) * f (fun c => e (I c)) :=
        Finset.sum_congr rfl fun σ _ => h2 σ
    _ = ∑ I : Fin k → Fin N', ∑ σ : Equiv.Perm (Fin k),
          ((Equiv.Perm.sign σ : ℤ) : ℝ) * (∏ b, u b (I (σ b))) * f (fun c => e (I c)) :=
        Finset.sum_comm
    _ = _ := ?_
  refine Finset.sum_congr rfl fun I _ => ?_
  rw [Matrix.det_apply, Finset.mul_sum]
  refine Finset.sum_congr rfl fun σ _ => ?_
  rw [Units.smul_def, zsmul_eq_mul]
  simp only [Matrix.of_apply, he]
  ring
/-- **Jacobian minors of Lipschitz maps are measurable and bounded** (the integrands in the weak
continuity of Jacobian minors): if `g₀, …, g_{r-1}` are `L`-Lipschitz on `ℝᵏ` and
`V₀, …, V_{r-1} ∈ ℝᵏ`, then `D(x) = det (Dg_c(x) V_b)_{c,b}` is measurable and
`|D(x)| ≤ r! (L ∑_b ‖V_b‖)ʳ` for every `x`, where `Dg(x) = fderiv ℝ g x` (`0` where `g` is not
differentiable).  Each entry `x ↦ Dg_c(x) V_b` is measurable (`measurable_fderiv_apply_const`)
and bounded by `‖Dg_c(x)‖ ‖V_b‖ ≤ L ‖V_b‖ ≤ L ∑_b ‖V_b‖` (`norm_fderiv_le_of_lipschitz`); by the
Leibniz formula `D` is a signed sum of `r!` products of `r` entries, which gives both claims.
(`Matrix.det_le` is outside the import closure, so the bound is done by hand.) -/
theorem Submission.dor_lmb_fcd_jwc_minor_measurable_bound : ∀ (k r : ℕ) (L : NNReal) (g : Fin r → Euclid k → ℝ) (V : Fin r → Euclid k), (∀ c, LipschitzWith L (g c)) → Measurable (fun x => Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b))) ∧ ∀ x, |Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b))| ≤ (r.factorial : ℝ) * ((L : ℝ) * ∑ b, ‖V b‖) ^ r := by
  intro k r L g V hg
  -- Leibniz formula: `D(x) = ∑_σ sign σ ∏_b Dg_{σ b}(x) V_b`
  have hdet : ∀ x, Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)) =
      ∑ σ : Equiv.Perm (Fin r), ((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ b, fderiv ℝ (g (σ b)) x (V b) :=
    fun x => Matrix.det_apply' _
  refine ⟨?_, fun x => ?_⟩
  · -- steps 1–2: the entries are measurable, hence so is the signed sum of their products
    have hm : Measurable fun x => ∑ σ : Equiv.Perm (Fin r),
        ((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ b, fderiv ℝ (g (σ b)) x (V b) :=
      Finset.measurable_sum _ fun σ _ => measurable_const.mul
        (Finset.measurable_prod _ fun b _ => measurable_fderiv_apply_const ℝ (g (σ b)) (V b))
    simpa only [hdet] using hm
  · -- step 3: every entry is bounded by `s = L ∑_b ‖V_b‖`
    have hent : ∀ c b, |fderiv ℝ (g c) x (V b)| ≤ (L : ℝ) * ∑ b, ‖V b‖ := by
      intro c b
      rw [← Real.norm_eq_abs]
      calc ‖fderiv ℝ (g c) x (V b)‖ ≤ ‖fderiv ℝ (g c) x‖ * ‖V b‖ :=
            ContinuousLinearMap.le_opNorm _ _
        _ ≤ L * ‖V b‖ :=
            mul_le_mul_of_nonneg_right (norm_fderiv_le_of_lipschitz ℝ (hg c)) (norm_nonneg _)
        _ ≤ L * ∑ b, ‖V b‖ := by
            gcongr
            exact Finset.single_le_sum (f := fun b => ‖V b‖) (fun b _ => norm_nonneg _)
              (Finset.mem_univ b)
    -- step 4: the triangle inequality and `|sign σ| = 1` give `|D(x)| ≤ ∑_σ sʳ = r! sʳ`
    rw [hdet]
    calc |∑ σ : Equiv.Perm (Fin r), ((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ b, fderiv ℝ (g (σ b)) x (V b)|
        ≤ ∑ σ : Equiv.Perm (Fin r),
            |((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ b, fderiv ℝ (g (σ b)) x (V b)| :=
          Finset.abs_sum_le_sum_abs _ _
      _ = ∑ σ : Equiv.Perm (Fin r), ∏ b, |fderiv ℝ (g (σ b)) x (V b)| := by
          refine Finset.sum_congr rfl fun σ _ => ?_
          rw [abs_mul, Finset.abs_prod]
          rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h | h <;> simp [h]
      _ ≤ ∑ _σ : Equiv.Perm (Fin r), ∏ _b : Fin r, (L : ℝ) * ∑ b, ‖V b‖ := by
          gcongr with σ _ b _
          exact hent (σ b) b
      _ = (r.factorial : ℝ) * ((L : ℝ) * ∑ b, ‖V b‖) ^ r := by
          rw [Finset.sum_const, Finset.prod_const, Finset.card_univ, Finset.card_univ,
            Fintype.card_perm, Fintype.card_fin, nsmul_eq_mul]
/-- **Derivative of the mollification of a Lipschitz function**: for an `L`-Lipschitz `f` and a
`C¹` kernel `ρ` with compact support, `D(ρ ⋆ f)(x) v = ∫ ρ(t) Df(x − t) v dt`.  Differentiating
under the integral (`HasCompactSupport.hasFDerivAt_convolution_left`) gives
`D(ρ ⋆ f)(x) v = ∫ Dρ(t) v · f(x − t) dt`.  With `t = x − s` and the reflected kernel
`h(s) = ρ(x − s)` (`C¹` with compact support, hence Lipschitz, and `∂_{−v} h(s) = Dρ(x − s) v`)
the two sides become `∫ ∂_{−v} h · f` and `∫ h · Df(·) v`; they agree by integration by parts for
Lipschitz functions (`LipschitzWith.integral_lineDeriv_mul_eq`: `∫ ∂_v f · h = ∫ ∂_{−v} h · f`)
and Rademacher (`∂_v f = Df · v` a.e.). -/
theorem Submission.dor_lmb_fcd_jwc_mollify_fderiv_eq : ∀ (k : ℕ) (L : NNReal) (f ρ : Euclid k → ℝ), LipschitzWith L f → ContDiff ℝ 1 ρ → HasCompactSupport ρ → ∀ x v : Euclid k, fderiv ℝ (fun y => ∫ t, ρ t * f (y - t)) x v = ∫ t, ρ t * fderiv ℝ f (x - t) v := by
  intro k L f ρ hf hρ hρs x v
  have hconv : (fun y => ∫ t, ρ t * f (y - t)) =
      convolution ρ f (ContinuousLinearMap.lsmul ℝ ℝ) volume := by
    funext y; simp [convolution_def]
  have hD := hρs.hasFDerivAt_convolution_left (μ := volume) (ContinuousLinearMap.lsmul ℝ ℝ) hρ
    hf.continuous.locallyIntegrable x
  have hint := (hρs.fderiv (𝕜 := ℝ)).convolutionExists_left (μ := (volume : Measure (Euclid k)))
    ((ContinuousLinearMap.lsmul ℝ ℝ).precompL (Euclid k)) (hρ.continuous_fderiv (by norm_num))
    (hf.continuous.locallyIntegrable (μ := (volume : Measure (Euclid k)))) x
  rw [hconv, hD.fderiv, convolution_def, ContinuousLinearMap.integral_apply hint]
  simp only [ContinuousLinearMap.precompL_apply, ContinuousLinearMap.lsmul_apply, smul_eq_mul]
  -- change of variables `t ↦ x - t` on both sides
  rw [← integral_sub_left_eq_self (fun t => fderiv ℝ ρ t v * f (x - t)) (μ := volume) x,
    ← integral_sub_left_eq_self (fun t => ρ t * fderiv ℝ f (x - t) v) (μ := volume) x]
  simp only [sub_sub_cancel]
  -- integration by parts against `h(s) = ρ(x - s)`
  set h : Euclid k → ℝ := fun s => ρ (x - s) with hh
  have hhC1 : ContDiff ℝ 1 h := hρ.comp (contDiff_const.sub contDiff_id)
  have hhs : HasCompactSupport h := hρs.comp_homeomorph (Homeomorph.subLeft x)
  obtain ⟨D, hhL⟩ := ContDiff.lipschitzWith_of_hasCompactSupport hhs hhC1 (by norm_num)
  have hibp := hf.integral_lineDeriv_mul_eq (μ := volume) hhL hhs v
  have hlh : ∀ s, lineDeriv ℝ h s (-v) = fderiv ℝ ρ (x - s) v := by
    intro s
    rw [(hhC1.differentiable (by norm_num) s).lineDeriv_eq_fderiv]
    have h1 : HasFDerivAt h (-(fderiv ℝ ρ (x - s))) s := by
      have := (hρ.differentiable (by norm_num) (x - s)).hasFDerivAt.comp s
        ((hasFDerivAt_const x s).sub (hasFDerivAt_id s))
      simpa [hh, Function.comp_def] using this
    rw [h1.fderiv]
    simp
  -- Rademacher: `∂_v f = Df · v` almost everywhere
  have hlf : ∀ᵐ s ∂(volume : Measure (Euclid k)), lineDeriv ℝ f s v = fderiv ℝ f s v := by
    filter_upwards [hf.ae_differentiableAt] with s hs
    exact hs.lineDeriv_eq_fderiv
  simp only [hlh] at hibp
  rw [← hibp]
  refine integral_congr_ae ?_
  filter_upwards [hlf] with s hs
  rw [hs, hh]
  ring
/-- **Smooth approximation of a Lipschitz function** (step 4 of the weak continuity of Jacobians):
an `L`-Lipschitz `f : ℝᵏ → ℝ` is the uniform limit of `C^∞`, `L`-Lipschitz functions `f_n` with
`Df_n(x) → Df(x)` in operator norm for a.e. `x`.  Take `f_n = ρ_n ⋆ f`, where `ρ_n = φ_n / ∫ φ_n`
normalizes a bump `φ_n` equal to `1` on `B(0, 1/(n+2))` and supported in `B(0, 2/(n+2))`.  Then
`f_n` is smooth, `L`-Lipschitz (`cmcs_ls_mollify_lipschitz`) and `|f_n - f| ≤ 2L/(n+2)`.  By
`dor_lmb_fcd_jwc_mollify_fderiv_eq`, `Df_n(x) eᵢ = (ρ_n ⋆ Df(·) eᵢ)(x)`; as `∫ φ_n ≥ |B(0, 1/(n+2))|`
gives `0 ≤ ρ_n ≤ 2ᵈ / |B(0, 2/(n+2))|`, this tends to `Df(x) eᵢ` at every Lebesgue point of the
bounded function `Df(·) eᵢ`, and `‖T‖ ≤ ∑ᵢ |T eᵢ|` gives convergence in operator norm. -/
theorem Submission.dor_lmb_fcd_jwc_lipschitz_smooth_approx : ∀ (k : ℕ) (L : NNReal) (f : Euclid k → ℝ), LipschitzWith L f → ∃ fs : ℕ → Euclid k → ℝ, (∀ n, ContDiff ℝ (⊤ : ℕ∞) (fs n)) ∧ (∀ n, LipschitzWith L (fs n)) ∧ TendstoUniformly fs f atTop ∧ ∀ᵐ x ∂(volume : Measure (Euclid k)), Tendsto (fun n => fderiv ℝ (fs n) x) atTop (𝓝 (fderiv ℝ f x)) := by
  intro k L f hf
  -- step 1: bumps `φ n` with `rIn = 1/(n+2)`, `rOut = 2/(n+2)`, normalized to `ρ n = φ n / ∫ φ n`
  have hpos : ∀ n : ℕ, (0 : ℝ) < (n : ℝ) + 2 := fun n => by positivity
  let φ : ℕ → ContDiffBump (0 : Euclid k) := fun n =>
    ⟨1 / ((n : ℝ) + 2), 2 / ((n : ℝ) + 2), by have := hpos n; positivity,
      div_lt_div_of_pos_right (by norm_num) (hpos n)⟩
  have hrOut : ∀ n, (φ n).rOut = 2 * (φ n).rIn := fun n => by
    show 2 / ((n : ℝ) + 2) = 2 * (1 / ((n : ℝ) + 2))
    rw [mul_one_div]
  -- `|B(x, r)| = r ^ d * c` with `c = |B(0, 1)| > 0`
  set d := Module.finrank ℝ (Euclid k)
  set c := (volume : Measure (Euclid k)).real (closedBall 0 1)
  have hcpos : 0 < c := ENNReal.toReal_pos (measure_closedBall_pos _ _ one_pos).ne'
    measure_closedBall_lt_top.ne
  have hvol : ∀ (x : Euclid k) (r : ℝ), 0 ≤ r →
      (volume : Measure (Euclid k)).real (closedBall x r) = r ^ d * c :=
    fun x r hr => Measure.addHaar_real_closedBall' _ x hr
  -- `φ n = 1` on `B(0, rIn)` and `φ n ≥ 0`, so `∫ φ n ≥ |B(0, rIn)| = rIn ^ d * c > 0`
  have hφint : ∀ n, Integrable (φ n) (volume : Measure (Euclid k)) := fun n =>
    (φ n).continuous.integrable_of_hasCompactSupport (φ n).hasCompactSupport
  have hIge : ∀ n, (φ n).rIn ^ d * c ≤ ∫ x, φ n x := by
    intro n
    rw [← hvol 0 _ (φ n).rIn_pos.le]
    calc (volume : Measure (Euclid k)).real (closedBall 0 (φ n).rIn)
        = ∫ x in closedBall (0 : Euclid k) (φ n).rIn, φ n x := by
          rw [setIntegral_congr_fun measurableSet_closedBall
            (fun x hx => (φ n).one_of_mem_closedBall hx), setIntegral_const, smul_eq_mul, mul_one]
      _ ≤ ∫ x, φ n x :=
          setIntegral_le_integral (hφint n) (Eventually.of_forall fun x => (φ n).nonneg)
  have hIpos : ∀ n, 0 < ∫ x, φ n x := fun n =>
    (mul_pos (pow_pos (φ n).rIn_pos d) hcpos).trans_le (hIge n)
  set ρ : ℕ → Euclid k → ℝ := fun n x => φ n x / ∫ y, φ n y with hρ
  have hρc : ∀ n, ContDiff ℝ (⊤ : ℕ∞) (ρ n) := fun n => (φ n).contDiff.div_const _
  have hρc1 : ∀ n, ContDiff ℝ 1 (ρ n) := fun n => (φ n).contDiff.div_const _
  have hρcont : ∀ n, Continuous (ρ n) := fun n => (φ n).continuous.div_const _
  have hρs : ∀ n, HasCompactSupport (ρ n) := fun n =>
    (φ n).hasCompactSupport.comp_left (g := fun t : ℝ => t / ∫ y, φ n y) (zero_div _)
  have hρ0 : ∀ n x, 0 ≤ ρ n x := fun n x => div_nonneg (φ n).nonneg (hIpos n).le
  have hρint : ∀ n, ∫ x, ρ n x = 1 := fun n => by
    show ∫ x, φ n x / ∫ y, φ n y = 1
    rw [integral_div, div_self (hIpos n).ne']
  have hρsupp : ∀ n, support (ρ n) ⊆ ball 0 (φ n).rOut := fun n x hx => by
    rw [← (φ n).support_eq, mem_support]
    intro h0
    exact (mem_support.1 hx) (by simp [hρ, h0])
  have hρle : ∀ n x, ρ n x ≤ 1 / ((φ n).rIn ^ d * c) := fun n x =>
    calc ρ n x = φ n x / ∫ y, φ n y := rfl
      _ ≤ 1 / ∫ y, φ n y := div_le_div_of_nonneg_right (φ n).le_one (hIpos n).le
      _ ≤ 1 / ((φ n).rIn ^ d * c) :=
          one_div_le_one_div_of_le (mul_pos (pow_pos (φ n).rIn_pos d) hcpos) (hIge n)
  -- `f_n = ρ n ⋆ f`
  set fs : ℕ → Euclid k → ℝ := fun n x => ∫ t, ρ n t * f (x - t) with hfs
  have hconv : ∀ n, fs n = convolution (ρ n) f (ContinuousLinearMap.lsmul ℝ ℝ) volume := by
    intro n; funext x; simp [hfs, convolution_def]
  have hrOut0 : Tendsto (fun n => (φ n).rOut) atTop (𝓝 0) := by
    have := tendsto_const_nhds (x := (2 : ℝ)) |>.div_atTop
      (tendsto_atTop_add_const_right atTop (2 : ℝ) tendsto_natCast_atTop_atTop)
    simpa [φ] using this
  refine ⟨fs, fun n => ?_, fun n => ?_, ?_, ?_⟩
  · -- step 2: `ρ n ⋆ f` is smooth
    rw [hconv]
    exact (hρs n).contDiff_convolution_left _ (hρc n) hf.continuous.locallyIntegrable
  · -- step 3: `ρ n ⋆ f` is `L`-Lipschitz
    exact Submission.cmcs_ls_mollify_lipschitz k (ρ n) f L (hρcont n) (hρs n) (hρ0 n) (hρint n) hf
  · -- step 4: `|f_n x - f x| ≤ L * rOut` for all `x`, and `rOut → 0`
    rw [Metric.tendstoUniformly_iff]
    intro ε hε
    filter_upwards [(hrOut0.const_mul (L : ℝ)).eventually (gt_mem_nhds (by simpa using hε))]
      with n hn x
    have hdist := dist_convolution_le (μ := volume) (x₀ := x) (z₀ := f x) (g := f)
      (by positivity : (0 : ℝ) ≤ L * (φ n).rOut) (hρsupp n) (hρ0 n) (hρint n)
      hf.continuous.aestronglyMeasurable (fun y hy => by
        calc dist (f y) (f x) ≤ L * dist y x := hf.dist_le_mul y x
          _ ≤ L * (φ n).rOut := by gcongr; exact (mem_ball.1 hy).le)
    rw [← hconv] at hdist
    rw [dist_comm]
    exact lt_of_le_of_lt hdist hn
  · -- step 5: `Df_n(x) v = ∫ ρ n t * Df(x - t) v dt`
    have hB1 : ∀ n x v, fderiv ℝ (fs n) x v = ∫ t, ρ n t * fderiv ℝ f (x - t) v := fun n x v =>
      Submission.dor_lmb_fcd_jwc_mollify_fderiv_eq k L f (ρ n) hf (hρc1 n) (hρs n) x v
    have hδ : Tendsto (fun n => (φ n).rOut) atTop (𝓝[>] 0) :=
      tendsto_nhdsWithin_iff.2 ⟨hrOut0, Eventually.of_forall fun n => (φ n).rOut_pos⟩
    -- steps 6-7: for each basis vector `e_i`, `Df_n(x) e_i → Df(x) e_i` for a.e. `x`
    have hDi : ∀ i : Fin k, ∀ᵐ x ∂(volume : Measure (Euclid k)),
        Tendsto (fun n => fderiv ℝ (fs n) x (EuclideanSpace.single i (1 : ℝ))) atTop
          (𝓝 (fderiv ℝ f x (EuclideanSpace.single i (1 : ℝ)))) := by
      intro i
      set g : Euclid k → ℝ := fun s => fderiv ℝ f s (EuclideanSpace.single i (1 : ℝ)) with hg
      have hloc : LocallyIntegrable g (volume : Measure (Euclid k)) := by
        refine (locallyIntegrable_const ((L : ℝ) * ‖EuclideanSpace.single i (1 : ℝ)‖)).mono
          ((measurable_fderiv_apply_const ℝ f _).aestronglyMeasurable)
          (Eventually.of_forall fun s => ?_)
        rw [Real.norm_eq_abs (_ * _), abs_of_nonneg (by positivity)]
        exact (ContinuousLinearMap.le_opNorm _ _).trans
          (mul_le_mul_of_nonneg_right (norm_fderiv_le_of_lipschitz ℝ hf) (norm_nonneg _))
      -- Lebesgue differentiation: `⨍_{B(x, r)} |g - g x| → 0` as `r → 0`, for a.e. `x`
      filter_upwards [IsUnifLocDoublingMeasure.ae_tendsto_average_norm_sub volume hloc 1]
        with x hx
      have havg := hx (fun _ => x) (fun n => (φ n).rOut) hδ
        (Eventually.of_forall fun n => mem_closedBall_self (by simpa using (φ n).rOut_pos.le))
      -- `0 ≤ ρ n (x - ·) ≤ 2 ^ d / |B(x, rOut)|`, supported in `B(x, rOut)`, with integral `1`
      have key := tendsto_integral_smul_of_tendsto_average_norm_sub ((2 : ℝ) ^ d) havg
        (g := fun n y => ρ n (x - y))
        (Eventually.of_forall fun n => hloc.integrableOn_isCompact (isCompact_closedBall _ _))
        (tendsto_const_nhds.congr fun n => by
          rw [integral_sub_left_eq_self (ρ n) volume x, hρint n])
        (Eventually.of_forall fun n y hy => by
          have hy' : x - y ∈ ball (0 : Euclid k) (φ n).rOut := hρsupp n hy
          rw [mem_ball, dist_zero_right] at hy'
          rw [mem_closedBall, dist_eq_norm, ← norm_neg, neg_sub]
          exact hy'.le)
        (Eventually.of_forall fun n y => by
          rw [abs_of_nonneg (hρ0 n _), hvol x _ (φ n).rOut_pos.le, hrOut n]
          calc ρ n (x - y) ≤ 1 / ((φ n).rIn ^ d * c) := hρle n _
            _ = 2 ^ d / ((2 * (φ n).rIn) ^ d * c) := by
              rw [mul_pow]
              field_simp)
      refine key.congr fun n => ?_
      rw [hB1, ← integral_sub_left_eq_self (fun y => ρ n (x - y) • g y) volume x]
      simp only [sub_sub_cancel, smul_eq_mul, hg]
    filter_upwards [ae_all_iff.2 hDi] with x hx
    -- step 8: `‖T‖ ≤ ∑ᵢ |T eᵢ|`, so convergence on the basis gives convergence in norm
    have hbound : ∀ T : Euclid k →L[ℝ] ℝ, ‖T‖ ≤ ∑ i, ‖T (EuclideanSpace.single i (1 : ℝ))‖ := by
      intro T
      refine ContinuousLinearMap.opNorm_le_bound T (Finset.sum_nonneg fun i _ => norm_nonneg _)
        fun w => ?_
      have hw : w = ∑ i, w i • EuclideanSpace.single i (1 : ℝ) := by
        conv_lhs => rw [← (EuclideanSpace.basisFun (Fin k) ℝ).sum_repr w]
        simp
      calc ‖T w‖ = ‖∑ i, w i • T (EuclideanSpace.single i (1 : ℝ))‖ := by
            conv_lhs => rw [hw]
            simp [map_sum, map_smul]
        _ ≤ ∑ i, ‖w i • T (EuclideanSpace.single i (1 : ℝ))‖ := norm_sum_le _ _
        _ = ∑ i, ‖w i‖ * ‖T (EuclideanSpace.single i (1 : ℝ))‖ := by simp
        _ ≤ ∑ i, ‖w‖ * ‖T (EuclideanSpace.single i (1 : ℝ))‖ := by
            gcongr with i
            exact PiLp.norm_apply_le w i
        _ = (∑ i, ‖T (EuclideanSpace.single i (1 : ℝ))‖) * ‖w‖ := by
            rw [Finset.sum_mul]; simp [mul_comm]
    rw [tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero (fun n => norm_nonneg _) (fun n => hbound _) ?_
    have : Tendsto (fun n => ∑ i : Fin k, ‖(fderiv ℝ (fs n) x - fderiv ℝ f x)
        (EuclideanSpace.single i (1 : ℝ))‖) atTop (𝓝 (∑ i : Fin k, (0 : ℝ))) := by
      refine tendsto_finsetSum _ fun i _ => ?_
      have := tendsto_iff_norm_sub_tendsto_zero.1 (hx i)
      simpa using this
    simpa using this
/-- **The Piola identity** (the Jacobian minors are null Lagrangians): for `C²` functions
`g₀, …, g_{r-1}` on `ℝᵏ` and directions `V₀, …, V_r`, the minors
`M_b(y) = det (Dg_c(y) V_{s_b(b')})_{c,b'}` (`s_b = Fin.succAbove b`, so `V_b` is deleted) satisfy
`∑_b (-1)^b DM_b(x) V_b = 0`.  With `G = (g₀, …, g_{r-1})` and the constant determinant form
`θ = dy⁰ ∧ ⋯ ∧ dy^{r-1}` one has `M_b(y) = (G^*θ)(y)(V ∘ s_b)`, so the left side is
`d(G^*θ)(x)(V)`, and `d(G^*θ) = G^*(dθ) = 0` by the naturality of `d` (which is where the symmetry
of `D²G` enters). -/
theorem Submission.dor_lmb_fcd_jwc_piola_identity : ∀ (k r : ℕ) (g : Fin r → Euclid k → ℝ) (V : Fin (r + 1) → Euclid k) (x : Euclid k), (∀ c, ContDiff ℝ 2 (g c)) → ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * fderiv ℝ (fun y => Matrix.det (Matrix.of fun (c b' : Fin r) => fderiv ℝ (g c) y (V (b.succAbove b')))) x (V b) = 0 := by
  intro k r g V x hg
  -- Step 1: the map `G = (g₀, …, g_{r-1}) : ℝᵏ → ℝʳ` is `C²`, and `(DG(y) w)_c = Dg_c(y) w`
  set e : (Fin r → ℝ) ≃L[ℝ] Euclid r := (EuclideanSpace.equiv (Fin r) ℝ).symm with he
  set G : Euclid k → Euclid r := fun y => e (fun c => g c y) with hG
  have hGc : ContDiff ℝ 2 G := e.contDiff.comp (contDiff_pi.2 hg)
  have hGd : ∀ y w (c : Fin r), fderiv ℝ G y w c = fderiv ℝ (g c) y w := by
    intro y w c
    have hpi : HasFDerivAt (fun y => fun c => g c y)
        (ContinuousLinearMap.pi fun c => fderiv ℝ (g c) y) y :=
      hasFDerivAt_pi.2 fun c => ((hg c).differentiable (by norm_num) y).hasFDerivAt
    have h := e.hasFDerivAt.comp y hpi
    rw [show G = e ∘ (fun y => fun c => g c y) from rfl, h.fderiv]
    simp [he]
  -- Step 2: the constant determinant form `Θ ≡ θ`, `θ(w) = det (w_b(c))_{c,b}`
  obtain ⟨θ, hθ⟩ := Submission.cmr_cc_det_covector_exists r r id
  set Θ : Euclid r → Covector (Euclid r) r := fun _ => θ with hΘ
  -- Step 3: `dΘ = 0`, since `DΘ = 0` and the alternatization is linear
  have hdΘ : extDeriv Θ (G x) = 0 := by
    simp [extDeriv, hΘ, ← ContinuousAlternatingMap.alternatizeUncurryFinCLM_apply]
  -- Step 4: naturality of `d` gives `d(G^*Θ)(x) = (dΘ)(G x) ∘ DG(x) = 0`
  have hpull := extDeriv_pullback (ω := Θ) (f := G) (x := x) (r := 2) (differentiableAt_const θ)
    hGc.contDiffAt (by simp)
  rw [hdΘ] at hpull
  -- Step 5: the coordinate formula `d(G^*Θ)(x)(V) = ∑_b (-1)^b D[(G^*Θ)(·)(V ∘ s_b)](x) V_b`
  have hβd : DifferentiableAt ℝ (fun y => (Θ (G y)).compContinuousLinearMap (fderiv ℝ G y)) x :=
    (differentiableAt_const θ).continuousAlternatingMapCompContinuousLinearMap
      ((hGc.fderiv_right (m := 1) (by norm_num)).differentiable (by norm_num) x)
  have happ := extDeriv_apply hβd V
  rw [hpull] at happ
  -- Step 6: `(G^*Θ)(y)(V ∘ s_b) = M_b(y)` by Steps 1 and 2
  have hβ : ∀ i : Fin (r + 1), (fun y => (Θ (G y)).compContinuousLinearMap (fderiv ℝ G y)
      (i.removeNth V)) = fun y => Matrix.det (Matrix.of fun (c b' : Fin r) =>
        fderiv ℝ (g c) y (V (i.succAbove b'))) := by
    intro i
    funext y
    simp only [hΘ, ContinuousAlternatingMap.compContinuousLinearMap_apply, hθ]
    congr 1
    ext c b'
    simp [Matrix.of_apply, Fin.removeNth, hGd]
  -- Step 7: hence `0 = d(G^*Θ)(x)(V) = ∑_b (-1)^b DM_b(x) V_b`
  simp only [hβ] at happ
  rw [eq_comm] at happ
  simpa [zsmul_eq_mul] using happ

/-- **Integration by parts for Jacobian minors** (formula (∗) of the weak continuity of Jacobian
minors, for `C²` maps): for `C²` functions `g₀, …, g_r` on `ℝᵏ`, directions `V₀, …, V_r` and a
compactly supported `C¹` function `ψ`, with `A = (Dg_c V_b)_{c,b}` and `M_b` the minor of `A`
without row `0` and column `b`, `∫ ψ det A = −Σ_b (−1)^b ∫ (Dψ V_b) g₀ M_b`.  Laplace expansion
along row `0`, the product rule for `F_b = ψ g₀ M_b` and the Piola identity
`Σ_b (−1)^b ∂_{V_b} M_b = 0` give `ψ det A = Σ_b (−1)^b ∂_{V_b} F_b − Σ_b (−1)^b (∂_{V_b} ψ) g₀ M_b`
pointwise, and `∫ ∂_W F = 0` for every compactly supported `C¹` function `F` (integration by
parts of the Lipschitz functions `1` and `F`). -/
theorem Submission.dor_lmb_fcd_jwc_smooth_minor_ibp : ∀ (k r : ℕ) (g : Fin (r + 1) → Euclid k → ℝ) (V : Fin (r + 1) → Euclid k) (ψ : Euclid k → ℝ), (∀ c, ContDiff ℝ 2 (g c)) → ContDiff ℝ 1 ψ → HasCompactSupport ψ → ∫ x, ψ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)) = -∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * ∫ x, fderiv ℝ ψ x (V b) * g 0 x * Matrix.det (Matrix.of fun (c b' : Fin r) => fderiv ℝ (g c.succ) x (V (b.succAbove b'))) := by
  intro k r g V ψ hg hψ hψs
  -- Step 2: the entries `Dg_c(·)W` are `C¹` (`g_c` is `C²`), hence so is every determinant of
  -- such entries (Leibniz formula), in particular every minor `M_b`
  have hdetC1 : ∀ {m : ℕ} (A : Euclid k → Fin m → Fin m → ℝ),
      (∀ i j, ContDiff ℝ 1 (fun x => A x i j)) →
      ContDiff ℝ 1 (fun x => Matrix.det (Matrix.of (A x))) := by
    intro m A hA
    have hLeib : (fun x => Matrix.det (Matrix.of (A x))) =
        fun x => ∑ σ : Equiv.Perm (Fin m), ((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ i, A x (σ i) i := by
      funext x
      rw [Matrix.det_apply]
      refine Finset.sum_congr rfl fun σ _ => ?_
      rw [Units.smul_def, zsmul_eq_mul]
      simp [Matrix.of_apply]
    rw [hLeib]
    exact ContDiff.sum fun σ _ => contDiff_const.mul (contDiff_prod fun i _ => hA _ _)
  have hentry : ∀ c (W : Euclid k), ContDiff ℝ 1 (fun x => fderiv ℝ (g c) x W) := fun c W =>
    ((hg c).fderiv_right (by norm_num)).clm_apply contDiff_const
  set M : Fin (r + 1) → Euclid k → ℝ := fun b x => Matrix.det (Matrix.of fun (c b' : Fin r) =>
    fderiv ℝ (g c.succ) x (V (b.succAbove b')))
  have hMC1 : ∀ b, ContDiff ℝ 1 (M b) := fun b =>
    hdetC1 (fun x c b' => fderiv ℝ (g c.succ) x (V (b.succAbove b'))) fun c b' => hentry _ _
  -- `F_b = ψ g₀ M_b` is `C¹` with compact support
  have hFC1 : ∀ b, ContDiff ℝ 1 (fun y => ψ y * g 0 y * M b y) := fun b =>
    (hψ.mul ((hg 0).of_le (by norm_num))).mul (hMC1 b)
  have hFs : ∀ b, HasCompactSupport (fun y => ψ y * g 0 y * M b y) := fun b =>
    hψs.mul_right.mul_right
  -- Step 3: product rule for `∂_{V_b} F_b`
  have hdiff : ∀ b x, fderiv ℝ (fun y => ψ y * g 0 y * M b y) x (V b) =
      fderiv ℝ ψ x (V b) * g 0 x * M b x + ψ x * fderiv ℝ (g 0) x (V b) * M b x +
        ψ x * g 0 x * fderiv ℝ (M b) x (V b) := by
    intro b x
    have hψd : DifferentiableAt ℝ ψ x := hψ.differentiable (by norm_num) x
    have hgd : DifferentiableAt ℝ (g 0) x := (hg 0).differentiable (by norm_num) x
    have hMd : DifferentiableAt ℝ (M b) x := (hMC1 b).differentiable (by norm_num) x
    have h : HasFDerivAt (fun y => ψ y * g 0 y * M b y) _ x :=
      (hψd.hasFDerivAt.mul hgd.hasFDerivAt).mul hMd.hasFDerivAt
    rw [h.fderiv]
    simp only [add_apply, smul_apply, smul_eq_mul, Pi.mul_apply]
    ring
  -- Steps 1, 4, 5: Laplace expansion along row `0` and the Piola identity give, pointwise,
  -- `ψ det A = Σ_b (−1)^b ∂_{V_b} F_b − Σ_b (−1)^b (∂_{V_b} ψ) g₀ M_b`
  have hpt : ∀ x, ψ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)) =
      ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * fderiv ℝ (fun y => ψ y * g 0 y * M b y) x (V b) -
        ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * (fderiv ℝ ψ x (V b) * g 0 x * M b x) := by
    intro x
    have hp : ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * fderiv ℝ (M b) x (V b) = 0 :=
      Submission.dor_lmb_fcd_jwc_piola_identity k r (fun c => g c.succ) V x fun c => hg c.succ
    simp_rw [hdiff]
    have halg : ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * (fderiv ℝ ψ x (V b) * g 0 x * M b x +
          ψ x * fderiv ℝ (g 0) x (V b) * M b x + ψ x * g 0 x * fderiv ℝ (M b) x (V b)) -
        ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * (fderiv ℝ ψ x (V b) * g 0 x * M b x) =
        ψ x * ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * fderiv ℝ (g 0) x (V b) * M b x +
          ψ x * g 0 x * ∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * fderiv ℝ (M b) x (V b) := by
      rw [← Finset.sum_sub_distrib, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun b _ => by ring
    rw [halg, hp, mul_zero, add_zero, Matrix.det_succ_row_zero]
    rfl
  -- Step 6: `∫ ∂_W F = 0` for `C¹` compactly supported `F` (integration by parts of the
  -- Lipschitz functions `1` and `F`)
  have hIBP0 : ∀ F : Euclid k → ℝ, ContDiff ℝ 1 F → HasCompactSupport F → ∀ W,
      ∫ x, fderiv ℝ F x W = 0 := by
    intro F hF hFs W
    obtain ⟨C, hFL⟩ := ContDiff.lipschitzWith_of_hasCompactSupport hFs hF (by norm_num)
    have h := LipschitzWith.integral_lineDeriv_mul_eq (μ := (volume : Measure (Euclid k)))
      (LipschitzWith.const (1 : ℝ)) hFL hFs (-W)
    have h0 : ∀ x : Euclid k, lineDeriv ℝ (fun _ : Euclid k => (1 : ℝ)) x (-W) = 0 := by
      intro x
      rw [(differentiableAt_const (1 : ℝ)).lineDeriv_eq_fderiv]
      simp
    have h1 : ∀ x, lineDeriv ℝ F x W = fderiv ℝ F x W := fun x =>
      (hF.differentiable (by norm_num) x).lineDeriv_eq_fderiv
    simp only [h0, zero_mul, integral_zero, neg_neg, mul_one, h1] at h
    exact h.symm
  -- Step 7: every term is continuous with compact support, hence integrable; integrate
  have hi1 : ∀ b : Fin (r + 1), Integrable (fun x => (-1 : ℝ) ^ (b : ℕ) *
      fderiv ℝ (fun y => ψ y * g 0 y * M b y) x (V b)) := fun b =>
    ((((hFC1 b).continuous_fderiv (by norm_num)).clm_apply
      continuous_const).integrable_of_hasCompactSupport ((hFs b).fderiv_apply ℝ (V b))).const_mul _
  have hi2 : ∀ b : Fin (r + 1), Integrable (fun x => (-1 : ℝ) ^ (b : ℕ) *
      (fderiv ℝ ψ x (V b) * g 0 x * M b x)) := fun b =>
    (((((hψ.continuous_fderiv (by norm_num)).clm_apply continuous_const).mul
      (hg 0).continuous).mul (hMC1 b).continuous).integrable_of_hasCompactSupport
      ((hψs.fderiv_apply ℝ (V b)).mul_right.mul_right)).const_mul _
  rw [integral_congr_ae (Eventually.of_forall hpt),
    integral_sub (integrable_finsetSum _ fun b _ => hi1 b)
      (integrable_finsetSum _ fun b _ => hi2 b),
    integral_finsetSum _ fun b _ => hi1 b, integral_finsetSum _ fun b _ => hi2 b]
  have hz : ∑ b : Fin (r + 1), ∫ x, (-1 : ℝ) ^ (b : ℕ) *
      fderiv ℝ (fun y => ψ y * g 0 y * M b y) x (V b) = 0 :=
    Finset.sum_eq_zero fun b _ => by rw [integral_const_mul, hIBP0 _ (hFC1 b) (hFs b) _, mul_zero]
  rw [hz, zero_sub]
  simp only [integral_const_mul]
  rfl

/-- **Integration by parts for Jacobian minors of Lipschitz maps** (the step "`(∗)` holds for
Lipschitz `v`" in the weak continuity of Jacobian minors): for `L`-Lipschitz `g₀, …, g_r` on `ℝᵏ`,
vectors `V₀, …, V_r` and `ψ ∈ C¹_c(ℝᵏ)`,
`∫ ψ det A = −Σ_b (−1)^b ∫ ∂_{V_b}ψ · g₀ · M_b`, where `A = (Dg_c V_b)_{c,b}` and `M_b` is the minor
`det (Dg_{c+1} V_{s_b(b')})_{c,b'}`, `s_b = b.succAbove`.  Mollify every `g_c`: `C^∞`, `L`-Lipschitz
`g^n_c → g_c` uniformly with `Dg^n_c → Dg_c` a.e.  The identity holds for every `n` (smooth case);
the determinants converge a.e. and are bounded by `(r+1)! (L Σ_b ‖V_b‖)^(r+1)`, resp.
`r! (L Σ_b' ‖V_{s_b(b')}‖)^r`, so both sides converge by dominated convergence (on the right with
`|g^n_0| ≤ |g_0| + 1` for large `n`), and the limits agree. -/
theorem Submission.dor_lmb_fcd_jwc_lipschitz_minor_ibp : ∀ (k r : ℕ) (L : NNReal) (g : Fin (r + 1) → Euclid k → ℝ) (V : Fin (r + 1) → Euclid k) (ψ : Euclid k → ℝ), (∀ c, LipschitzWith L (g c)) → ContDiff ℝ 1 ψ → HasCompactSupport ψ → ∫ x, ψ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)) = -∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * ∫ x, fderiv ℝ ψ x (V b) * g 0 x * Matrix.det (Matrix.of fun (c b' : Fin r) => fderiv ℝ (g c.succ) x (V (b.succAbove b'))) := by
  intro k r L g V ψ hg hψ hψs
  -- step 1: smooth `L`-Lipschitz approximants `fs c n` of every component `g c`
  choose fs hfs_smooth hfs_lip hfs_unif hfs_ae using
    fun c => Submission.dor_lmb_fcd_jwc_lipschitz_smooth_approx k L (g c) (hg c)
  -- step 2: the identity for the smooth maps `fs · n`
  have hid := fun n => Submission.dor_lmb_fcd_jwc_smooth_minor_ibp k r (fun c => fs c n) V ψ
    (fun c => (hfs_smooth c n).of_le (by simp)) hψ hψs
  -- step 3: off a null set all derivatives converge, hence so do the entries and determinants
  have hae : ∀ᵐ x ∂(volume : Measure (Euclid k)), ∀ c,
      Tendsto (fun n => fderiv ℝ (fs c n) x) atTop (𝓝 (fderiv ℝ (g c) x)) := ae_all_iff.2 hfs_ae
  have hdet_lim : ∀ {m : ℕ} (σ : Fin m → Fin (r + 1)) (W : Fin m → Euclid k) (x : Euclid k),
      (∀ c, Tendsto (fun n => fderiv ℝ (fs c n) x) atTop (𝓝 (fderiv ℝ (g c) x))) →
      Tendsto (fun n => Matrix.det (Matrix.of fun (c b : Fin m) => fderiv ℝ (fs (σ c) n) x (W b)))
        atTop (𝓝 (Matrix.det (Matrix.of fun (c b : Fin m) => fderiv ℝ (g (σ c)) x (W b)))) := by
    intro m σ W x hx
    have hM : Tendsto (fun n => (Matrix.of fun (c b : Fin m) => fderiv ℝ (fs (σ c) n) x (W b)))
        atTop (𝓝 (Matrix.of fun (c b : Fin m) => fderiv ℝ (g (σ c)) x (W b))) := by
      refine tendsto_pi_nhds.2 fun c => tendsto_pi_nhds.2 fun b => ?_
      exact ((ContinuousLinearMap.apply ℝ ℝ (W b)).continuous.tendsto _).comp (hx (σ c))
    exact ((continuous_id.matrix_det).tendsto _).comp hM
  -- step 4: the bound `B` of the full determinants and the integrability of `ψ`
  set B : ℝ := ((r + 1).factorial : ℝ) * ((L : ℝ) * ∑ b, ‖V b‖) ^ (r + 1)
  have hψc : Continuous ψ := hψ.continuous
  have hψi : Integrable ψ := hψc.integrable_of_hasCompactSupport hψs
  -- step 5: the left side converges, dominated by `B |ψ|`
  have hL : Tendsto
      (fun n => ∫ x, ψ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (fs c n) x (V b)))
      atTop (𝓝 (∫ x, ψ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)))) := by
    refine tendsto_integral_of_dominated_convergence (fun x => B * ‖ψ x‖) (fun n => ?_)
      (hψi.norm.const_mul B) (fun n => Eventually.of_forall fun x => ?_) ?_
    · exact hψc.aestronglyMeasurable.mul
        (Submission.dor_lmb_fcd_jwc_minor_measurable_bound k (r + 1) L (fun c => fs c n) V
          (fun c => hfs_lip c n)).1.aestronglyMeasurable
    · have h := (Submission.dor_lmb_fcd_jwc_minor_measurable_bound k (r + 1) L (fun c => fs c n) V
        (fun c => hfs_lip c n)).2 x
      rw [norm_mul, Real.norm_eq_abs (Matrix.det _), mul_comm]
      exact mul_le_mul_of_nonneg_right h (norm_nonneg _)
    · filter_upwards [hae] with x hx
      exact tendsto_const_nhds.mul (hdet_lim id V x hx)
  -- step 6: each term of the right side converges, dominated by `Br |∂_{V_b}ψ| (|g 0| + 1)`
  have hR : ∀ b : Fin (r + 1), Tendsto (fun n => ∫ x, fderiv ℝ ψ x (V b) * fs 0 n x *
      Matrix.det (Matrix.of fun (c b' : Fin r) => fderiv ℝ (fs c.succ n) x (V (b.succAbove b'))))
      atTop (𝓝 (∫ x, fderiv ℝ ψ x (V b) * g 0 x * Matrix.det
        (Matrix.of fun (c b' : Fin r) => fderiv ℝ (g c.succ) x (V (b.succAbove b'))))) := by
    intro b
    set Br : ℝ := (r.factorial : ℝ) * ((L : ℝ) * ∑ b', ‖V (b.succAbove b')‖) ^ r
    have hdψc : Continuous (fun x => fderiv ℝ ψ x (V b)) :=
      (hψ.continuous_fderiv (by simp)).clm_apply continuous_const
    have hdψs : HasCompactSupport (fun x => fderiv ℝ ψ x (V b)) := hψs.fderiv_apply (𝕜 := ℝ) (V b)
    have hwi : Integrable (fun x => Br * (‖fderiv ℝ ψ x (V b)‖ * (‖g 0 x‖ + 1))) := by
      refine Integrable.const_mul ?_ _
      exact Continuous.integrable_of_hasCompactSupport
        (hdψc.norm.mul ((hg 0).continuous.norm.add continuous_const)) hdψs.norm.mul_right
    refine tendsto_integral_filter_of_dominated_convergence
      (fun x => Br * (‖fderiv ℝ ψ x (V b)‖ * (‖g 0 x‖ + 1)))
      (Eventually.of_forall fun n => ?_) ?_ hwi ?_
    · exact (hdψc.mul (hfs_smooth 0 n).continuous).aestronglyMeasurable.mul
        (Submission.dor_lmb_fcd_jwc_minor_measurable_bound k r L (fun c => fs c.succ n)
          (fun b' => V (b.succAbove b')) (fun c => hfs_lip c.succ n)).1.aestronglyMeasurable
    · -- `|fs 0 n| ≤ |g 0| + 1` once `fs 0 n` is uniformly `1`-close to `g 0`
      obtain ⟨N, hN⟩ :=
        (Metric.tendstoUniformly_iff.1 (hfs_unif 0) 1 one_pos).exists_forall_of_atTop
      refine eventually_atTop.2 ⟨N, fun n hn => Eventually.of_forall fun x => ?_⟩
      have h1 : ‖fs 0 n x‖ ≤ ‖g 0 x‖ + 1 := by
        have := hN n hn x
        rw [dist_comm, dist_eq_norm] at this
        have := norm_le_insert' (fs 0 n x) (g 0 x)
        linarith
      have h2 := (Submission.dor_lmb_fcd_jwc_minor_measurable_bound k r L (fun c => fs c.succ n)
        (fun b' => V (b.succAbove b')) (fun c => hfs_lip c.succ n)).2 x
      rw [norm_mul, norm_mul, Real.norm_eq_abs (Matrix.det _)]
      calc ‖fderiv ℝ ψ x (V b)‖ * ‖fs 0 n x‖ * |Matrix.det _|
          ≤ ‖fderiv ℝ ψ x (V b)‖ * (‖g 0 x‖ + 1) * Br := by gcongr
        _ = Br * (‖fderiv ℝ ψ x (V b)‖ * (‖g 0 x‖ + 1)) := by ring
    · filter_upwards [hae] with x hx
      refine (tendsto_const_nhds.mul ((hfs_unif 0).tendsto_at x)).mul ?_
      exact hdet_lim Fin.succ (fun b' => V (b.succAbove b')) x hx
  have hRall : Tendsto (fun n => -∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) *
      ∫ x, fderiv ℝ ψ x (V b) * fs 0 n x * Matrix.det
        (Matrix.of fun (c b' : Fin r) => fderiv ℝ (fs c.succ n) x (V (b.succAbove b'))))
      atTop (𝓝 (-∑ b : Fin (r + 1), (-1 : ℝ) ^ (b : ℕ) * ∫ x, fderiv ℝ ψ x (V b) * g 0 x *
        Matrix.det (Matrix.of fun (c b' : Fin r) => fderiv ℝ (g c.succ) x (V (b.succAbove b'))))) :=
    Tendsto.neg (tendsto_finsetSum _ fun b _ => (hR b).const_mul _)
  -- step 7: both sides of step 2 agree for every `n`, so their limits agree
  exact tendsto_nhds_unique hL (hRall.congr fun n => (hid n).symm)
/-- **Weak-* convergence against `L¹` test functions** (density step of the weak continuity of
Jacobian minors): if `|F_j|, |F| ≤ C` and `∫ ψ F_j → ∫ ψ F` for every `C^∞` compactly supported
`ψ`, then `∫ φ F_j → ∫ φ F` for every integrable `φ`.  `C_c^∞` is dense in `L¹`: by
`MemLp.induction_dense` it suffices to approximate `c 1_s` with `μ(s) < ∞`; regularity gives
`K ⊆ s ⊆ U`, `K` compact, `U` open, `μ(U \ K)` small, and `c χ` works for a smooth Urysohn
function `χ` (`χ = 1` exactly on `K`, `support χ = U ∩ B_R(0)`).  (Mathlib's
`MemLp.exist_eLpNorm_sub_le` is outside the import closure.)  For `ε > 0` take such `ψ` with
`∫ |φ − ψ| ≤ η = ε/(4C + 1)`; then `|∫ φ F_j − ∫ φ F| ≤ 2Cη + |∫ ψ F_j − ∫ ψ F| < ε` for large
`j`. -/
theorem Submission.dor_lmb_fcd_jwc_weak_star_l1_upgrade : ∀ (k : ℕ) (C : ℝ) (Fs : ℕ → Euclid k → ℝ) (F : Euclid k → ℝ), (∀ j, AEStronglyMeasurable (Fs j) (volume : Measure (Euclid k))) → AEStronglyMeasurable F (volume : Measure (Euclid k)) → (∀ j x, |Fs j x| ≤ C) → (∀ x, |F x| ≤ C) → (∀ ψ : Euclid k → ℝ, ContDiff ℝ (⊤ : ℕ∞) ψ → HasCompactSupport ψ → Tendsto (fun j => ∫ x, ψ x * Fs j x) atTop (𝓝 (∫ x, ψ x * F x))) → ∀ φ : Euclid k → ℝ, Integrable φ → Tendsto (fun j => ∫ x, φ x * Fs j x) atTop (𝓝 (∫ x, φ x * F x)) := by
  intro k C Fs F hFs hF hFsb hFb hconv φ hφ
  have hC : 0 ≤ C := (abs_nonneg _).trans (hFb 0)
  -- step 1: `C_c^∞` is dense in `L¹`; by `MemLp.induction_dense` only `c 1_s` needs approximating
  have hdense : ∀ {ε : ℝ≥0∞}, ε ≠ 0 → ∃ ψ : Euclid k → ℝ,
      eLpNorm (φ - ψ) 1 (volume : Measure (Euclid k)) ≤ ε ∧
        (ContDiff ℝ (⊤ : ℕ∞) ψ ∧ HasCompactSupport ψ) := by
    intro ε hε
    refine MemLp.induction_dense ENNReal.one_ne_top
      (fun g => ContDiff ℝ (⊤ : ℕ∞) g ∧ HasCompactSupport g) ?_ ?_
      (memLp_one_iff_integrable.2 hφ) hε
    · intro c s hs hμs ε' hε'
      -- `K ⊆ s ⊆ U` with `μ(U \ s), μ(s \ K) < δ/2`, `δ = ε'/‖c‖`
      set δ : ℝ≥0∞ := ε' / ‖c‖ₑ with hδ
      have hδ0 : δ ≠ 0 := by
        rw [hδ, Ne, ENNReal.div_eq_zero_iff, not_or]
        exact ⟨hε', enorm_ne_top⟩
      have hδ2 : δ / 2 ≠ 0 := (ENNReal.half_pos hδ0).ne'
      obtain ⟨K, hKs, hKc, hK⟩ := hs.exists_isCompact_sdiff_lt hμs.ne hδ2
      obtain ⟨U, hsU, hUo, -, hU⟩ := hs.exists_isOpen_sdiff_lt hμs.ne hδ2
      -- smooth Urysohn function `χ`: `χ = 1` on `K`, `support χ = U ∩ B_R(0)`, `0 ≤ χ ≤ 1`
      obtain ⟨R, hR⟩ := hKc.isBounded.subset_ball (0 : Euclid k)
      obtain ⟨χ, hχd, hχr, hχs, hχ1⟩ := exists_contDiff_support_eq_eq_one_iff (n := (⊤ : ℕ∞))
        (hUo.inter isOpen_ball) hKc.isClosed (subset_inter (hKs.trans hsU) hR)
      have hχc : HasCompactSupport χ := by
        refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid k) R) (fun x hx => ?_)
        rw [← notMem_support, hχs]
        exact fun h => hx (ball_subset_closedBall h.2)
      refine ⟨fun x => c * χ x, ?_, contDiff_const.mul hχd, hχc.mul_left⟩
      -- `|c χ − c 1_s| ≤ |c| 1_{U \ K}`, so `‖c χ − c 1_s‖₁ ≤ ‖c‖ μ(U \ K) ≤ ‖c‖ δ ≤ ε'`
      have hle : ∀ x, ‖((fun x => c * χ x) - s.indicator fun _ => c) x‖ ≤
          ‖(U \ K).indicator (fun _ => c) x‖ := by
        intro x
        obtain ⟨h0, h1⟩ := hχr (mem_range_self x)
        simp only [Pi.sub_apply, Real.norm_eq_abs]
        by_cases hxK : x ∈ K
        · rw [(hχ1 x).1 hxK, indicator_of_mem (hKs hxK)]
          simp
        by_cases hxU : x ∈ U
        · rw [indicator_of_mem (show x ∈ U \ K from ⟨hxU, hxK⟩)]
          by_cases hxs : x ∈ s
          · rw [indicator_of_mem hxs, show c * χ x - c = c * (χ x - 1) by ring, abs_mul]
            exact mul_le_of_le_one_right (abs_nonneg c) (by rw [abs_le]; constructor <;> linarith)
          · rw [indicator_of_notMem hxs, sub_zero, abs_mul]
            exact mul_le_of_le_one_right (abs_nonneg c) (by rw [abs_le]; constructor <;> linarith)
        · have hχ0 : χ x = 0 := by
            rw [← notMem_support, hχs]
            exact fun h => hxU h.1
          rw [hχ0, indicator_of_notMem (fun h => hxU (hsU h))]
          simp
      calc eLpNorm ((fun x => c * χ x) - s.indicator fun _ => c) 1 volume
          ≤ eLpNorm ((U \ K).indicator fun _ => c) 1 volume :=
            eLpNorm_mono (((contDiff_const.mul hχd).continuous.aestronglyMeasurable).sub
              (aestronglyMeasurable_const.indicator hs)) hle
        _ = ‖c‖ₑ * volume (U \ K) := by
          rw [eLpNorm_indicator_const (hUo.measurableSet.diff hKc.isClosed.measurableSet).nullMeasurableSet
            one_ne_zero ENNReal.one_ne_top]
          simp
        _ ≤ ‖c‖ₑ * δ := by
          gcongr
          calc volume (U \ K) ≤ volume ((U \ s) ∪ (s \ K)) := by
                refine measure_mono fun x hx => ?_
                by_cases hxs : x ∈ s
                · exact Or.inr ⟨hxs, hx.2⟩
                · exact Or.inl ⟨hx.1, hxs⟩
            _ ≤ volume (U \ s) + volume (s \ K) := measure_union_le _ _
            _ ≤ δ / 2 + δ / 2 := add_le_add hU.le hK.le
            _ = δ := ENNReal.add_halves δ
        _ ≤ ε' := ENNReal.mul_div_le
    · rintro f g ⟨hf1, hf2⟩ ⟨hg1, hg2⟩
      exact ⟨hf1.add hg1, hf2.add hg2⟩
  -- step 2: `|∫ θ G| ≤ C ∫ |θ|` for integrable `θ` and `|G| ≤ C`
  have hint : ∀ θ : Euclid k → ℝ, Integrable θ → ∀ G : Euclid k → ℝ,
      AEStronglyMeasurable G (volume : Measure (Euclid k)) → (∀ x, |G x| ≤ C) →
      Integrable (fun x => θ x * G x) ∧ |∫ x, θ x * G x| ≤ C * ∫ x, ‖θ x‖ := by
    intro θ hθ G hG hGb
    refine ⟨hθ.mul_bdd hG (Eventually.of_forall fun x => by rw [Real.norm_eq_abs]; exact hGb x), ?_⟩
    calc |∫ x, θ x * G x| = ‖∫ x, θ x * G x‖ := (Real.norm_eq_abs _).symm
      _ ≤ ∫ x, C * ‖θ x‖ := by
          refine norm_integral_le_of_norm_le (hθ.norm.const_mul C) (Eventually.of_forall fun x => ?_)
          rw [norm_mul, Real.norm_eq_abs (G x), mul_comm]
          exact mul_le_mul_of_nonneg_right (hGb x) (norm_nonneg _)
      _ = C * ∫ x, ‖θ x‖ := integral_const_mul _ _
  -- step 3: `ψ ∈ C_c^∞` with `∫ |φ − ψ| ≤ η = ε/(4C + 1)`, and `N` from the convergence on `ψ`
  rw [Metric.tendsto_atTop]
  intro ε hε
  set η : ℝ := ε / (4 * C + 1) with hη
  have hηpos : 0 < η := by positivity
  obtain ⟨ψ, hψε, hψs, hψc⟩ := hdense (ENNReal.ofReal_pos.2 hηpos).ne'
  have hψi : Integrable ψ := hψs.continuous.integrable_of_hasCompactSupport hψc
  have hdiff : ∫ x, ‖(φ - ψ) x‖ ≤ η := by
    have h1 := integral_norm_eq_lintegral_enorm (μ := (volume : Measure (Euclid k)))
      (hφ.sub hψi).aestronglyMeasurable
    rw [h1, ← eLpNorm_one_eq_lintegral_enorm]
    · exact ENNReal.toReal_le_of_le_ofReal hηpos.le hψε
    · exact (hφ.sub hψi).aestronglyMeasurable
  obtain ⟨N, hN⟩ := Metric.tendsto_atTop.1 (hconv ψ hψs hψc) (ε / 2) (by positivity)
  -- step 4: three-term estimate `|∫ φ F_j − ∫ φ F| ≤ 2Cη + |∫ ψ F_j − ∫ ψ F| < ε` for `j ≥ N`
  refine ⟨N, fun j hj => ?_⟩
  have h1 := hint (φ - ψ) (hφ.sub hψi) (Fs j) (hFs j) (hFsb j)
  have h2 := hint (φ - ψ) (hφ.sub hψi) F hF hFb
  have h3 := hint ψ hψi (Fs j) (hFs j) (hFsb j)
  have h4 := hint ψ hψi F hF hFb
  have e1 : ∫ x, φ x * Fs j x = (∫ x, (φ - ψ) x * Fs j x) + ∫ x, ψ x * Fs j x := by
    rw [← integral_add h1.1 h3.1]
    congr 1; funext x; simp only [Pi.sub_apply]; ring
  have e2 : ∫ x, φ x * F x = (∫ x, (φ - ψ) x * F x) + ∫ x, ψ x * F x := by
    rw [← integral_add h2.1 h4.1]
    congr 1; funext x; simp only [Pi.sub_apply]; ring
  have hNj := hN j hj
  rw [Real.dist_eq] at hNj ⊢
  rw [e1, e2]
  have hCη : C * η < ε / 4 := by
    rw [hη, mul_div_assoc']
    rw [div_lt_div_iff₀ (by positivity) (by norm_num)]
    nlinarith
  have hA := h1.2.trans (mul_le_mul_of_nonneg_left hdiff hC)
  have hB := h2.2.trans (mul_le_mul_of_nonneg_left hdiff hC)
  have key : ∀ a1 b1 a2 b2 : ℝ, |(a1 + b1) - (a2 + b2)| ≤ |a1| + |a2| + |b1 - b2| := by
    intro a1 b1 a2 b2
    calc |(a1 + b1) - (a2 + b2)| = |(a1 - a2) + (b1 - b2)| := by ring_nf
      _ ≤ |a1 - a2| + |b1 - b2| := abs_add_le _ _
      _ ≤ |a1| + |a2| + |b1 - b2| := by
          have := abs_sub a1 a2
          linarith
  have := key (∫ x, (φ - ψ) x * Fs j x) (∫ x, ψ x * Fs j x) (∫ x, (φ - ψ) x * F x) (∫ x, ψ x * F x)
  linarith

/-- **Weak continuity of Jacobian minors** (null Lagrangians; Reshetnyak 1967, Ball 1977): if the
`L`-Lipschitz `gʲ_c` converge uniformly to the `L`-Lipschitz `g_c` on `ℝᵏ` (`c < r`), then
`∫ φ det(Dgʲ_c V_b) → ∫ φ det(Dg_c V_b)` for every `φ ∈ L¹`.  Induction on `r`; for `r = 0` both
determinants are `1`.  For `r + 1` the minors are measurable and bounded by
`(r+1)! (L Σ_b ‖V_b‖)^{r+1}`, so by the weak-* to `L¹` upgrade it suffices to take `φ = ψ ∈ C^∞_c`.
Integration by parts in the first row writes `∫ ψ det(Dg_c V_b)` as
`−Σ_b (−1)^b ∫ ∂_{V_b}ψ · g₀ · M_b`, `M_b` the minor of the rows `c ≥ 1` and the columns `≠ b`.
Split `gʲ₀ = (gʲ₀ − g₀) + g₀`: the first part is at most
`r! (L Σ_{b'} ‖V_{b'}‖)^r sup |gʲ₀ − g₀| ∫ |∂_{V_b}ψ| → 0`, and the second converges by the
induction hypothesis with the continuous compactly supported weight `∂_{V_b}ψ · g₀`. -/
theorem Submission.dor_lmb_fcd_jwc_minor_weak_continuity : ∀ (k r : ℕ) (L : NNReal) (gs : ℕ → Fin r → Euclid k → ℝ) (g : Fin r → Euclid k → ℝ) (V : Fin r → Euclid k) (φ : Euclid k → ℝ), Integrable φ → (∀ j c, LipschitzWith L (gs j c)) → (∀ c, LipschitzWith L (g c)) → (∀ c, TendstoUniformly (fun j => gs j c) (g c) atTop) → Tendsto (fun j => ∫ x, φ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (gs j c) x (V b))) atTop (𝓝 (∫ x, φ x * Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)))) := by
  intro k r
  induction r with
  | zero =>
    -- the empty determinant is `1`
    intro L gs g V φ hφ hgs hg hU
    simp only [Matrix.det_isEmpty, mul_one]
    exact tendsto_const_nhds
  | succ r ih =>
    intro L gs g V φ hφ hgs hg hU
    -- Step 2: the minors are bounded, so it suffices to test against `ψ ∈ C^∞_c`
    have hb := fun (G : Fin (r + 1) → Euclid k → ℝ) (hG : ∀ c, LipschitzWith L (G c)) =>
      Submission.dor_lmb_fcd_jwc_minor_measurable_bound k (r + 1) L G V hG
    refine Submission.dor_lmb_fcd_jwc_weak_star_l1_upgrade k
      (((r + 1).factorial : ℝ) * ((L : ℝ) * ∑ b, ‖V b‖) ^ (r + 1))
      (fun j x => Matrix.det (Matrix.of fun c b => fderiv ℝ (gs j c) x (V b)))
      (fun x => Matrix.det (Matrix.of fun c b => fderiv ℝ (g c) x (V b)))
      (fun j => (hb (gs j) (hgs j)).1.aestronglyMeasurable) (hb g hg).1.aestronglyMeasurable
      (fun j => (hb (gs j) (hgs j)).2) (hb g hg).2 ?_ φ hφ
    intro ψ hψ hψs
    -- Step 3: integrate by parts in the first row
    have hψ1 : ContDiff ℝ 1 ψ := hψ.of_le (by exact_mod_cast le_top)
    have hIBPj := fun j =>
      Submission.dor_lmb_fcd_jwc_lipschitz_minor_ibp k r L (gs j) V ψ (hgs j) hψ1 hψs
    have hIBP := Submission.dor_lmb_fcd_jwc_lipschitz_minor_ibp k r L g V ψ hg hψ1 hψs
    simp only [hIBPj, hIBP]
    refine Tendsto.neg (tendsto_finsetSum _ fun b _ => Tendsto.const_mul _ ?_)
    -- the minors `Mʲ_b`, `M_b` and their bound
    set Mj : ℕ → Euclid k → ℝ := fun j x => Matrix.det (Matrix.of fun (c b' : Fin r) =>
      fderiv ℝ (gs j c.succ) x (V (b.succAbove b'))) with hMj
    set M : Euclid k → ℝ := fun x => Matrix.det (Matrix.of fun (c b' : Fin r) =>
      fderiv ℝ (g c.succ) x (V (b.succAbove b'))) with hM
    set Br : ℝ := (r.factorial : ℝ) * ((L : ℝ) * ∑ b', ‖V (b.succAbove b')‖) ^ r with hBr
    have hbr := fun j => Submission.dor_lmb_fcd_jwc_minor_measurable_bound k r L
      (fun c => gs j c.succ) (fun b' => V (b.succAbove b')) (fun c => hgs j c.succ)
    -- Step 4: the weight `θ_b = ∂_{V_b}ψ · g₀` is continuous with compact support
    have hdψc : Continuous (fun x => fderiv ℝ ψ x (V b)) :=
      (hψ.continuous_fderiv (by simp)).clm_apply continuous_const
    have hdψs : HasCompactSupport (fun x => fderiv ℝ ψ x (V b)) :=
      (hψs.fderiv (𝕜 := ℝ)).comp_left (g := fun T : Euclid k →L[ℝ] ℝ => T (V b)) (by simp)
    have hdψi : Integrable (fun x => fderiv ℝ ψ x (V b)) :=
      hdψc.integrable_of_hasCompactSupport hdψs
    have hθi : Integrable (fun x => fderiv ℝ ψ x (V b) * g 0 x) :=
      (hdψc.mul (hg 0).continuous).integrable_of_hasCompactSupport hdψs.mul_right
    -- Step 6: the induction hypothesis with the weight `θ_b`
    have hih := ih L (fun j c => gs j c.succ) (fun c => g c.succ) (fun b' => V (b.succAbove b'))
      (fun x => fderiv ℝ ψ x (V b) * g 0 x) hθi (fun j c => hgs j c.succ) (fun c => hg c.succ)
      (fun c => hU c.succ)
    -- Step 5: `|∫ ∂_{V_b}ψ (gʲ₀ − g₀) Mʲ_b| ≤ Br sup |gʲ₀ − g₀| ∫ |∂_{V_b}ψ| → 0`
    have herr : Tendsto (fun j => ∫ x, fderiv ℝ ψ x (V b) * (gs j 0 x - g 0 x) * Mj j x) atTop
        (𝓝 0) := by
      rw [Metric.tendsto_atTop]
      intro ε hε
      set K : ℝ := Br * (∫ x, ‖fderiv ℝ ψ x (V b)‖) + 1 with hK
      have hBr0 : 0 ≤ Br := by positivity
      have hK0 : 0 < K := by
        have : 0 ≤ ∫ x, ‖fderiv ℝ ψ x (V b)‖ := integral_nonneg fun _ => norm_nonneg _
        positivity
      have hδ : 0 < ε / (2 * K) := by positivity
      obtain ⟨N, hN⟩ :=
        (Metric.tendstoUniformly_iff.1 (hU 0) (ε / (2 * K)) hδ).exists_forall_of_atTop
      refine ⟨N, fun j hj => ?_⟩
      rw [Real.dist_eq, sub_zero]
      have hbd : ∀ x, ‖fderiv ℝ ψ x (V b) * (gs j 0 x - g 0 x) * Mj j x‖ ≤
          (ε / (2 * K) * Br) * ‖fderiv ℝ ψ x (V b)‖ := by
        intro x
        have h1 : |gs j 0 x - g 0 x| ≤ ε / (2 * K) := by
          have := hN j hj x
          rw [dist_comm, Real.dist_eq] at this
          exact this.le
        have h2 : |Mj j x| ≤ Br := (hbr j).2 x
        rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul, abs_mul]
        calc |fderiv ℝ ψ x (V b)| * |gs j 0 x - g 0 x| * |Mj j x|
            ≤ |fderiv ℝ ψ x (V b)| * (ε / (2 * K)) * Br := by gcongr
          _ = (ε / (2 * K) * Br) * |fderiv ℝ ψ x (V b)| := by ring
      calc |∫ x, fderiv ℝ ψ x (V b) * (gs j 0 x - g 0 x) * Mj j x|
          = ‖∫ x, fderiv ℝ ψ x (V b) * (gs j 0 x - g 0 x) * Mj j x‖ := (Real.norm_eq_abs _).symm
        _ ≤ ∫ x, (ε / (2 * K) * Br) * ‖fderiv ℝ ψ x (V b)‖ :=
            norm_integral_le_of_norm_le (hdψi.norm.const_mul _) (Eventually.of_forall hbd)
        _ = (ε / (2 * K)) * (Br * ∫ x, ‖fderiv ℝ ψ x (V b)‖) := by
            rw [integral_const_mul]; ring
        _ ≤ (ε / (2 * K)) * K := by gcongr; linarith
        _ = ε / 2 := by field_simp
        _ < ε := by linarith
    -- Step 7: `∫ ∂_{V_b}ψ gʲ₀ Mʲ_b = ∫ ∂_{V_b}ψ (gʲ₀ − g₀) Mʲ_b + ∫ θ_b Mʲ_b → 0 + ∫ θ_b M_b`
    have hsum := herr.add hih
    rw [zero_add] at hsum
    refine hsum.congr' (Eventually.of_forall fun j => ?_)
    have i2 : Integrable (fun x => fderiv ℝ ψ x (V b) * g 0 x * Mj j x) := by
      have h1 : Integrable (fun x => Mj j x * (fderiv ℝ ψ x (V b) * g 0 x)) :=
        Integrable.bdd_mul (c := Br) hθi (hbr j).1.aestronglyMeasurable
          (Eventually.of_forall fun x => by rw [Real.norm_eq_abs]; exact (hbr j).2 x)
      exact h1.congr (Eventually.of_forall fun x => by simp only; ring)
    have i1 : Integrable (fun x => fderiv ℝ ψ x (V b) * (gs j 0 x - g 0 x) * Mj j x) := by
      have hgj : Integrable (fun x => fderiv ℝ ψ x (V b) * gs j 0 x) :=
        (hdψc.mul (hgs j 0).continuous).integrable_of_hasCompactSupport hdψs.mul_right
      have h1 : Integrable (fun x => Mj j x * (fderiv ℝ ψ x (V b) * gs j 0 x)) :=
        Integrable.bdd_mul (c := Br) hgj (hbr j).1.aestronglyMeasurable
          (Eventually.of_forall fun x => by rw [Real.norm_eq_abs]; exact (hbr j).2 x)
      have h2 : Integrable (fun x => Mj j x * (fderiv ℝ ψ x (V b) * g 0 x)) :=
        Integrable.bdd_mul (c := Br) hθi (hbr j).1.aestronglyMeasurable
          (Eventually.of_forall fun x => by rw [Real.norm_eq_abs]; exact (hbr j).2 x)
      exact (h1.sub h2).congr (Eventually.of_forall fun x => by simp only [Pi.sub_apply]; ring)
    simp only
    rw [← integral_add i1 i2]
    congr 1
    funext x
    ring

/-- **Weak continuity of pulled-back `k`-forms** (the identification of Simon 2.29 with 3.6): if
the `L`-Lipschitz `H_j : ℝᵏ → ℝ^{N'}` converge uniformly to the `L`-Lipschitz `H`, `w ∈ L¹(A)` and
`ω ∈ 𝒟ᵏ(ℝ^{N'})`, then `∫_A w H_j^#ω(e) → ∫_A w H^#ω(e)`, where
`H^#ω(u)(e) = ω(H(u))(DH(u)e₁, …, DH(u)e_k)`.  Where `G` is differentiable (a.e., by Rademacher)
`D(G^i)(u) v = (DG(u) v) i`, so the covector expansion gives `k! G^#ω(e) = Σ_I ω_I(G) D_I(G)` a.e.,
with coefficients `ω_I(y) = ω(y)(e'_{I 0}, …, e'_{I (k-1)})` continuous with compact support and
minors `D_I(G) = det (D(G^{I c}) e_b)_{c,b}` measurable and bounded by `Cb = k! (L Σ_b ‖e_b‖)ᵏ`.
For each `I` split `ω_I(H_j) = (ω_I(H_j) − ω_I(H)) + ω_I(H)`: the first part contributes at most
`Cb sup |ω_I(H_j) − ω_I(H)| ∫_A |w| → 0` (`ω_I` is uniformly continuous), and
`∫_A w ω_I(H) D_I(H_j) → ∫_A w ω_I(H) D_I(H)` is the weak continuity of Jacobian minors with the
weight `1_A w ω_I(H) ∈ L¹`.  Summing over `I` and dividing by `k!` concludes. -/
theorem Submission.dor_lmb_fcd_jacobian_weak_continuity : ∀ (k N' : ℕ) (A : Set (Euclid k)) (w : Euclid k → ℝ) (L : NNReal) (Hs : ℕ → Euclid k → Euclid N') (H : Euclid k → Euclid N') (ω : TestFormOn (univ : Set (Euclid N')) k), MeasurableSet A → IntegrableOn w A → (∀ j, LipschitzWith L (Hs j)) → LipschitzWith L H → TendstoUniformly Hs H atTop → Tendsto (fun j => ∫ u in A, w u * (ω : DifferentialForm (Euclid N') k) (Hs j u) (fun i => fderiv ℝ (Hs j) u (EuclideanSpace.single i (1 : ℝ)))) atTop (𝓝 (∫ u in A, w u * (ω : DifferentialForm (Euclid N') k) (H u) (fun i => fderiv ℝ H u (EuclideanSpace.single i (1 : ℝ))))) := by
  intro k N' A w L Hs H ω hA hw hHs hH hU
  have hw' : Integrable w (volume.restrict A) := hw
  -- step 1: `ω` is continuous with compact support, hence so are its coefficients
  -- `ω_I(y) = ω(y)(e'_{I 0}, …, e'_{I (k-1)})`, which are therefore bounded
  obtain ⟨⟨hωsm, hωs⟩, -⟩ := ω.2
  have hωc : Continuous (ω : DifferentialForm (Euclid N') k) := ContDiff.continuous hωsm
  obtain ⟨ωI, hωI⟩ : ∃ f : (Fin k → Fin N') → Euclid N' → ℝ, ∀ I y,
      f I y = (ω : DifferentialForm (Euclid N') k) y
        (fun c => EuclideanSpace.single (I c) (1 : ℝ)) :=
    ⟨fun I y => (ω : DifferentialForm (Euclid N') k) y
      (fun c => EuclideanSpace.single (I c) (1 : ℝ)), fun _ _ => rfl⟩
  have hωIc : ∀ I, Continuous (ωI I) := by
    intro I
    have h : ωI I = fun y => ContinuousAlternatingMap.apply ℝ (Euclid N') ℝ
        (fun c => EuclideanSpace.single (I c) (1 : ℝ)) ((ω : DifferentialForm (Euclid N') k) y) := by
      funext y; rw [hωI]; rfl
    rw [h]
    exact (ContinuousLinearMap.continuous _).comp hωc
  have hωIs : ∀ I, HasCompactSupport (ωI I) := by
    intro I
    have h : ωI I = (fun f : Covector (Euclid N') k =>
        f (fun c => EuclideanSpace.single (I c) (1 : ℝ))) ∘ (ω : DifferentialForm (Euclid N') k) := by
      funext y; rw [hωI]; rfl
    rw [h]
    exact hωs.comp_left (by simp)
  have hωIG : ∀ I (G : Euclid k → Euclid N'), Continuous G →
      Continuous (fun u => ωI I (G u)) ∧ ∃ M, ∀ u, ‖ωI I (G u)‖ ≤ M := fun I G hG =>
    ⟨(hωIc I).comp hG, ((hωIc I).bounded_above_of_compact_support (hωIs I)).imp
      fun _ hM u => hM (G u)⟩
  -- step 2: coordinates of `L`-Lipschitz maps are `L`-Lipschitz, and the minors
  -- `D_I(G) = det (D(G^{I c}) e_b)_{c,b}` are measurable and bounded by `Cb`
  have hcoordL : ∀ G : Euclid k → Euclid N', LipschitzWith L G → ∀ i,
      LipschitzWith L (fun y => G y i) :=
    fun G hG i => LipschitzWith.of_dist_le_mul fun x y =>
      (PiLp.dist_apply_le (G x) (G y) i).trans (hG.dist_le_mul x y)
  obtain ⟨D, hD⟩ : ∃ D : (Euclid k → Euclid N') → (Fin k → Fin N') → Euclid k → ℝ, ∀ G I x,
      D G I x = Matrix.det (Matrix.of fun c b =>
        fderiv ℝ (fun y => G y (I c)) x (EuclideanSpace.single b (1 : ℝ))) :=
    ⟨fun G I x => Matrix.det (Matrix.of fun c b =>
      fderiv ℝ (fun y => G y (I c)) x (EuclideanSpace.single b (1 : ℝ))), fun _ _ _ => rfl⟩
  set Cb : ℝ := (k.factorial : ℝ) *
    ((L : ℝ) * ∑ b : Fin k, ‖EuclideanSpace.single b (1 : ℝ)‖) ^ k
  have hDmb : ∀ G : Euclid k → Euclid N', LipschitzWith L G → ∀ I,
      Measurable (D G I) ∧ ∀ x, |D G I x| ≤ Cb := by
    intro G hG I
    have h := Submission.dor_lmb_fcd_jwc_minor_measurable_bound k k L (fun c y => G y (I c))
      (fun b => EuclideanSpace.single b (1 : ℝ)) (fun c => hcoordL G hG (I c))
    have hDe : D G I = fun x => Matrix.det (Matrix.of fun c b =>
        fderiv ℝ (fun y => G y (I c)) x (EuclideanSpace.single b (1 : ℝ))) := funext (hD G I)
    rw [hDe]
    exact h
  -- `w F D_I(G)` is integrable on `A` for continuous bounded `F`
  have hint : ∀ F : Euclid k → ℝ, Continuous F → (∃ M, ∀ u, ‖F u‖ ≤ M) →
      ∀ G : Euclid k → Euclid N', LipschitzWith L G → ∀ I,
      Integrable (fun u => w u * F u * D G I u) (volume.restrict A) := by
    rintro F hF ⟨M, hM⟩ G hG I
    refine (hw'.mul_bdd hF.aestronglyMeasurable (Eventually.of_forall hM)).mul_bdd (c := Cb)
      (hDmb G hG I).1.aestronglyMeasurable (Eventually.of_forall fun u => ?_)
    rw [Real.norm_eq_abs]
    exact (hDmb G hG I).2 u
  -- step 3: where `G` is differentiable, `D(G^i)(u) v = (DG(u) v) i`, so the covector expansion
  -- gives `k! G^#ω(e) = Σ_I ω_I(G) D_I(G)`
  have hpt : ∀ (G : Euclid k → Euclid N') (u : Euclid k), DifferentiableAt ℝ G u →
      (k.factorial : ℝ) * (ω : DifferentialForm (Euclid N') k) (G u)
          (fun i => fderiv ℝ G u (EuclideanSpace.single i (1 : ℝ))) =
        ∑ I, ωI I (G u) * D G I u := by
    intro G u hGu
    rw [Submission.dor_lmb_fcd_jwc_covector_det_expansion]
    refine Finset.sum_congr rfl fun I _ => ?_
    rw [hωI, hD]
    congr 2
    ext c b
    simp only [Matrix.of_apply]
    have h : HasFDerivAt (PiLp.proj 2 (fun _ : Fin N' => ℝ) (I c) ∘ G)
        ((PiLp.proj 2 (fun _ : Fin N' => ℝ) (I c)).comp (fderiv ℝ G u)) u :=
      (PiLp.proj 2 (fun _ : Fin N' => ℝ) (I c)).hasFDerivAt.comp u hGu.hasFDerivAt
    have h' : HasFDerivAt (fun y => G y (I c))
        ((PiLp.proj 2 (fun _ : Fin N' => ℝ) (I c)).comp (fderiv ℝ G u)) u := h
    rw [h'.fderiv]
    rfl
  -- Rademacher: the expansion holds a.e., so `∫_A w G^#ω(e) = (k!)⁻¹ Σ_I ∫_A w ω_I(G) D_I(G)`
  have hexp : ∀ G : Euclid k → Euclid N', LipschitzWith L G →
      ∫ u in A, w u * (ω : DifferentialForm (Euclid N') k) (G u)
          (fun i => fderiv ℝ G u (EuclideanSpace.single i (1 : ℝ))) =
        (k.factorial : ℝ)⁻¹ * ∑ I, ∫ u in A, w u * ωI I (G u) * D G I u := by
    intro G hG
    have hk : (k.factorial : ℝ) ≠ 0 := by positivity
    rw [← integral_finsetSum (f := fun I u => w u * ωI I (G u) * D G I u) Finset.univ
      fun I _ => hint _ (hωIG I G hG.continuous).1 (hωIG I G hG.continuous).2 G hG I,
      ← integral_const_mul]
    refine integral_congr_ae ?_
    filter_upwards [ae_restrict_of_ae (hG.ae_differentiableAt (μ := volume))] with u hu
    have h2 : ∑ I, w u * ωI I (G u) * D G I u = w u * ∑ I, ωI I (G u) * D G I u := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun I _ => mul_assoc _ _ _
    rw [h2, ← hpt G u hu, mul_left_comm, inv_mul_cancel_left₀ hk]
  -- step 4: the coordinates `H_j^i` converge uniformly to `H^i`
  have hcoordU : ∀ i, TendstoUniformly (fun j y => Hs j y i) (fun y => H y i) atTop := by
    intro i
    have hl : LipschitzWith 1 (fun x : Euclid N' => x i) :=
      LipschitzWith.of_dist_le_mul fun x y => by
        rw [NNReal.coe_one, one_mul]
        exact PiLp.dist_apply_le x y i
    exact hl.uniformContinuous.comp_tendstoUniformly hU
  -- step 5: for each `I`, `∫_A w ω_I(H_j) D_I(H_j) → ∫_A w ω_I(H) D_I(H)`
  have hconvI : ∀ I, Tendsto (fun j => ∫ u in A, w u * ωI I (Hs j u) * D (Hs j) I u) atTop
      (𝓝 (∫ u in A, w u * ωI I (H u) * D H I u)) := by
    intro I
    obtain ⟨hωHc, M, hM⟩ := hωIG I H hH.continuous
    -- weak continuity of Jacobian minors, with the fixed weight `φ = 1_A w ω_I(H) ∈ L¹`
    have hφ : Integrable (A.indicator fun u => w u * ωI I (H u)) := by
      rw [integrable_indicator_iff hA]
      exact hw'.mul_bdd hωHc.aestronglyMeasurable (Eventually.of_forall hM)
    have hmain := Submission.dor_lmb_fcd_jwc_minor_weak_continuity k k L
      (fun j c y => Hs j y (I c)) (fun c y => H y (I c)) (fun b => EuclideanSpace.single b (1 : ℝ))
      _ hφ (fun j c => hcoordL (Hs j) (hHs j) (I c)) (fun c => hcoordL H hH (I c))
      (fun c => hcoordU (I c))
    have hind : ∀ G : Euclid k → Euclid N',
        ∫ x, A.indicator (fun u => w u * ωI I (H u)) x * Matrix.det (Matrix.of fun c b =>
          fderiv ℝ (fun y => G y (I c)) x (EuclideanSpace.single b (1 : ℝ))) =
        ∫ u in A, w u * ωI I (H u) * D G I u := by
      intro G
      rw [← integral_indicator hA]
      refine integral_congr_ae (Eventually.of_forall fun x => ?_)
      simp only
      rw [Set.indicator_mul_left A (fun u => w u * ωI I (H u)) (D G I), hD]
    have hmain' : Tendsto (fun j => ∫ u in A, w u * ωI I (H u) * D (Hs j) I u) atTop
        (𝓝 (∫ u in A, w u * ωI I (H u) * D H I u)) := by
      rw [← hind H]
      exact hmain.congr fun j => hind (Hs j)
    -- the error `|∫_A w (ω_I(H_j) − ω_I(H)) D_I(H_j)| ≤ Cb sup |ω_I(H_j) − ω_I(H)| ∫_A |w| → 0`
    have hωU : TendstoUniformly (fun j u => ωI I (Hs j u)) (fun u => ωI I (H u)) atTop :=
      ((hωIs I).uniformContinuous_of_continuous (hωIc I)).comp_tendstoUniformly hU
    have herr : Tendsto (fun j => ∫ u in A, w u * (ωI I (Hs j u) - ωI I (H u)) * D (Hs j) I u)
        atTop (𝓝 0) := by
      rw [Metric.tendsto_atTop]
      intro ε hε
      set K : ℝ := Cb * (∫ u in A, ‖w u‖) + 1
      have hCb0 : 0 ≤ Cb := by positivity
      have hK0 : 0 < K := by
        have : 0 ≤ ∫ u in A, ‖w u‖ := integral_nonneg fun _ => norm_nonneg _
        positivity
      have hδ : 0 < ε / (2 * K) := by positivity
      obtain ⟨N, hN⟩ :=
        (Metric.tendstoUniformly_iff.1 hωU (ε / (2 * K)) hδ).exists_forall_of_atTop
      refine ⟨N, fun j hj => ?_⟩
      rw [Real.dist_eq, sub_zero]
      have hbd : ∀ u, ‖w u * (ωI I (Hs j u) - ωI I (H u)) * D (Hs j) I u‖ ≤
          (ε / (2 * K) * Cb) * ‖w u‖ := by
        intro u
        have h1 : |ωI I (Hs j u) - ωI I (H u)| ≤ ε / (2 * K) := by
          have := hN j hj u
          rw [dist_comm, Real.dist_eq] at this
          exact this.le
        have h2 : |D (Hs j) I u| ≤ Cb := (hDmb (Hs j) (hHs j) I).2 u
        rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul, abs_mul]
        calc |w u| * |ωI I (Hs j u) - ωI I (H u)| * |D (Hs j) I u|
            ≤ |w u| * (ε / (2 * K)) * Cb := by gcongr
          _ = (ε / (2 * K) * Cb) * |w u| := by ring
      calc |∫ u in A, w u * (ωI I (Hs j u) - ωI I (H u)) * D (Hs j) I u|
          = ‖∫ u in A, w u * (ωI I (Hs j u) - ωI I (H u)) * D (Hs j) I u‖ :=
            (Real.norm_eq_abs _).symm
        _ ≤ ∫ u in A, (ε / (2 * K) * Cb) * ‖w u‖ :=
            norm_integral_le_of_norm_le (hw'.norm.const_mul _) (Eventually.of_forall hbd)
        _ = (ε / (2 * K)) * (Cb * ∫ u in A, ‖w u‖) := by
            rw [integral_const_mul]; ring
        _ ≤ (ε / (2 * K)) * K := by gcongr; linarith
        _ = ε / 2 := by field_simp
        _ < ε := by linarith
    -- `∫_A w ω_I(H_j) D_I(H_j) = (error) + ∫_A w ω_I(H) D_I(H_j)`
    have heq : ∀ j, (∫ u in A, w u * (ωI I (Hs j u) - ωI I (H u)) * D (Hs j) I u) +
        ∫ u in A, w u * ωI I (H u) * D (Hs j) I u =
        ∫ u in A, w u * ωI I (Hs j u) * D (Hs j) I u := by
      intro j
      have i1 := hint _ (hωIG I (Hs j) (hHs j).continuous).1 (hωIG I (Hs j) (hHs j).continuous).2
        (Hs j) (hHs j) I
      have i2 := hint _ hωHc ⟨M, hM⟩ (Hs j) (hHs j) I
      have i3 : Integrable (fun u => w u * (ωI I (Hs j u) - ωI I (H u)) * D (Hs j) I u)
          (volume.restrict A) :=
        (i1.sub i2).congr (Eventually.of_forall fun u => by simp only [Pi.sub_apply]; ring)
      rw [← integral_add i3 i2]
      refine integral_congr_ae (Eventually.of_forall fun u => ?_)
      simp only
      ring
    have hsum := herr.add hmain'
    rw [zero_add] at hsum
    exact hsum.congr heq
  -- step 6: sum over `I` and divide by `k!`
  have hlim := (tendsto_finsetSum (Finset.univ : Finset (Fin k → Fin N'))
    fun I _ => hconvI I).const_mul ((k.factorial : ℝ)⁻¹)
  rw [hexp H hH]
  exact hlim.congr fun j => (hexp (Hs j) (hHs j)).symm

/-- **A unit covector attaining `1` on an orthonormal frame** (Simon (6.1.1); step 1(b) of the
mass formula, Remark 6.3.2(3)): every orthonormal `τ₁, …, τₙ` in `ℝᴾ` admits an `n`-covector `β`
with `|β|_E = 1` and `β(τ) = 1`.  Take the wedge `β(v) = det(⟨τᵢ, v_k⟩)` of the covectors
`⟨τᵢ, ·⟩`, so `β(τ) = det 1 = 1`.  Extend `τ` to an orthonormal basis `f` of `ℝᴾ` with
`f ∘ ι = τ`, `ι = Fin.castLE`.  Then `β(f ∘ j) = sgn π` if `j = ι ∘ π` for a permutation `π`,
and `β(f ∘ j) = 0` otherwise (a zero column, or a repeated vector), so `Σ_j β(f ∘ j)² = n!`;
`regcomp_covector_sq_sum_orthonormalBasis` turns this into `n! = n! |β|_E²`. -/
theorem Submission.regcomp_exists_covector_eval_orthonormal_eq_one : ∀ (P n : ℕ) (τ : Fin n → Euclid P), Orthonormal ℝ τ → ∃ β : Covector (Euclid P) n, covectorEuclideanNorm β = 1 ∧ β τ = 1 := by
  intro P n τ hτ
  classical
  -- Step 1: the wedge `β(v) = det(⟨τᵢ, v_k⟩)` of the covectors `⟨τᵢ, ·⟩` (Simon (6.1.1))
  obtain ⟨β, hβ⟩ : ∃ β : Covector (Euclid P) n, ∀ v : Fin n → Euclid P,
      β v = Matrix.det (Matrix.of fun i k => inner ℝ (τ i) (v k)) := by
    let L : Euclid P →ₗ[ℝ] (Fin n → ℝ) :=
      LinearMap.pi fun i => (innerSL ℝ (τ i) : Euclid P →L[ℝ] ℝ).toLinearMap
    let g : Euclid P [⋀^Fin n]→ₗ[ℝ] ℝ := Matrix.detRowAlternating.compLinearMap L
    have hg : ∀ v, g v = Matrix.det (Matrix.of fun i k => inner ℝ (τ i) (v k)) := by
      intro v
      rw [← Matrix.det_transpose]
      show Matrix.det (Matrix.of fun a b => L (v a) b) = _
      congr 1
    have hcont : Continuous fun v : Fin n → Euclid P =>
        Matrix.det (Matrix.of fun i k => inner ℝ (τ i) (v k)) := by
      apply Continuous.matrix_det
      apply continuous_matrix
      intro i k
      exact Continuous.inner (f := fun _ => τ i) (g := fun v : Fin n → Euclid P => v k)
        continuous_const (continuous_apply k)
    refine ⟨{ g with cont := ?_ }, hg⟩
    have : (g : (Fin n → Euclid P) → ℝ) =
        fun v => Matrix.det (Matrix.of fun i k => inner ℝ (τ i) (v k)) := funext hg
    simpa [this] using hcont
  -- Step 2: by orthonormality `(⟨τᵢ, τ_k⟩) = 1`, so `β(τ) = det 1 = 1`
  have hβτ : β τ = 1 := by
    have hone : (Matrix.of fun i k => inner ℝ (τ i) (τ k) : Matrix (Fin n) (Fin n) ℝ) = 1 := by
      ext i k
      rw [Matrix.of_apply, Matrix.one_apply]
      exact orthonormal_iff_ite.mp hτ i k
    rw [hβ, hone, Matrix.det_one]
  -- Step 3: `n ≤ P`, and an orthonormal basis `f` of `ℝᴾ` with `f (ι k) = τ k`, `ι = Fin.castLE`
  have hnP : n ≤ P := by
    simpa [finrank_euclideanSpace_fin] using hτ.linearIndependent.fintype_card_le_finrank
  let ι : Fin n → Fin P := Fin.castLE hnP
  have hι : Injective ι := Fin.castLE_injective hnP
  let v : Fin P → Euclid P := fun i => if h : (i : ℕ) < n then τ ⟨i, h⟩ else 0
  let s : Set (Fin P) := {i | (i : ℕ) < n}
  have hvs : Orthonormal ℝ (s.domRestrict v) := by
    let e : s → Fin n := fun i => ⟨i.1, i.2⟩
    have he : Injective e := fun a b hab =>
      Subtype.ext (Fin.ext (congrArg (Fin.val : Fin n → ℕ) hab))
    have hve : s.domRestrict v = τ ∘ e := by
      funext i
      have hi : ((i : Fin P) : ℕ) < n := i.2
      simp [v, e, hi]
    rw [hve]
    exact hτ.comp e he
  obtain ⟨f, hf⟩ := Orthonormal.exists_orthonormalBasis_extension_of_card_eq (by simp) hvs
  have hfι : ∀ k, f (ι k) = τ k := by
    intro k
    rw [hf (ι k) k.2]
    simp [v, ι]
  -- Step 4: `β(f ∘ j)² = 1` if `j = ι ∘ π` for a permutation `π`, and `0` otherwise
  let Φ : Equiv.Perm (Fin n) → (Fin n → Fin P) := fun π => ι ∘ π
  have hΦ : Injective Φ := fun π π' h => Equiv.ext fun k => hι (congrFun h k)
  have hperm : ∀ π : Equiv.Perm (Fin n), β (fun k => f (Φ π k)) ^ 2 = 1 := by
    intro π
    have h1 : (fun k => f (Φ π k)) = τ ∘ π := funext fun k => hfι (π k)
    have h2 : β (τ ∘ π) = Equiv.Perm.sign π • β τ := β.toAlternatingMap.map_perm τ π
    rw [h1, h2, hβτ]
    rcases Int.units_eq_one_or (Equiv.Perm.sign π) with h | h <;> simp [h]
  have hzero : ∀ j : Fin n → Fin P, j ∉ Finset.univ.image Φ → β (fun k => f (j k)) ^ 2 = 0 := by
    intro j hj
    have hj' : ∀ π, Φ π ≠ j := fun π hπ => hj (Finset.mem_image.mpr ⟨π, Finset.mem_univ _, hπ⟩)
    rw [sq_eq_zero_iff]
    by_cases hr : ∀ k, j k ∈ range ι
    · -- `j = ι ∘ ρ` with `ρ` not a permutation, hence not injective: `f ∘ j` repeats a vector
      choose ρ hρ using hr
      have hρ' : ¬ Injective ρ := fun hinj =>
        hj' (Equiv.ofBijective ρ (Finite.injective_iff_bijective.mp hinj)) (funext hρ)
      refine β.map_eq_zero_of_not_injective _ fun hinj => hρ' fun a b hab => hinj ?_
      exact congrArg f ((hρ a).symm.trans ((congrArg ι hab).trans (hρ b)))
    · -- some `j k₀ ∉ range ι`: column `k₀` of `(⟨τᵢ, f (j k)⟩)` vanishes
      obtain ⟨k₀, hk₀⟩ := not_forall.mp hr
      rw [hβ]
      refine Matrix.det_eq_zero_of_column_eq_zero k₀ fun i => ?_
      rw [Matrix.of_apply, ← hfι i, f.inner_eq_ite, ite_eq_right fun h => hk₀ ⟨i, h⟩]
  have hsum : ∑ j : Fin n → Fin P, β (fun k => f (j k)) ^ 2 = n.factorial := by
    rw [← Finset.sum_subset (Finset.subset_univ (Finset.univ.image Φ)) fun j _ hj => hzero j hj,
      Finset.sum_image fun π _ π' _ h => hΦ h]
    simp only [hperm, Finset.sum_const, Finset.card_univ, Fintype.card_perm, Fintype.card_fin,
      nsmul_eq_mul, mul_one]
  -- Step 5: `n! = n! |β|_E²` by `regcomp_covector_sq_sum_orthonormalBasis`, so `|β|_E = 1`
  have hsq := Submission.regcomp_covector_sq_sum_orthonormalBasis P n β f
  rw [hsum] at hsq
  have hfac : (n.factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr n.factorial_ne_zero
  refine ⟨β, (pow_eq_one_iff_of_nonneg (covectorEuclideanNorm_nonneg β) two_ne_zero).mp ?_, hβτ⟩
  exact mul_left_cancel₀ hfac (by rw [← hsq, mul_one])
/-- **Simon Ch. 6, 1.7 and 1.15**: a unit orientation `ξ = ±τ₁ ∧ ⋯ ∧ τₙ` (`τ` orthonormal)
has dual Euclidean coefficient norm exactly one: `|ξ(α)| = |α(τ)| ≤ |α|_E` for every
`n`-covector `α`, and `ξ(±β₀) = 1` for a covector `β₀` with `|β₀|_E = 1` and `β₀(τ) = 1`
(`+β₀` for the sign `+`, `−β₀` for the sign `−`, using `|−β₀|_E = |β₀|_E`). -/
theorem Submission.regcomp_unit_orientation_pairing : ∀ (P n : ℕ) (ξ : MultiVector P n) (Q : Submodule ℝ (Euclid P)), IsUnitOrientationOf ξ Q → (∀ α : Covector (Euclid P) n, |ξ α| ≤ covectorEuclideanNorm α) ∧ ∃ β : Covector (Euclid P) n, covectorEuclideanNorm β ≤ 1 ∧ ξ β = 1 := by
  rintro P n ξ Q ⟨τ, hτ, -, hξ⟩
  obtain ⟨β₀, hβ₀, hβ₀τ⟩ := Submission.regcomp_exists_covector_eval_orthonormal_eq_one P n τ hτ
  rcases hξ with h | h
  · -- `ξ(α) = α(τ)`: take `β = β₀`
    refine ⟨fun α => ?_, β₀, hβ₀.le, ?_⟩
    · rw [h α]
      exact Submission.regcomp_covector_eval_orthonormal_le P n α τ hτ
    · rw [h β₀, hβ₀τ]
  · -- `ξ(α) = −α(τ)`: `|ξ(α)| = |α(τ)|`, and take `β = −β₀`
    refine ⟨fun α => ?_, -β₀, ?_, ?_⟩
    · rw [h α, abs_neg]
      exact Submission.regcomp_covector_eval_orthonormal_le P n α τ hτ
    · rw [covectorEuclideanNorm_neg]
      exact hβ₀.le
    · rw [h (-β₀), ContinuousAlternatingMap.neg_apply, hβ₀τ, neg_neg]

/-- **Mass bound for an integer combination** (Simon Ch. 6, Remark 3.2(1)): if
`1_M θ ξ = p₁ 1_{M₁} θ₁ ξ₁ + p₂ 1_{M₂} θ₂ ξ₂` holds `Hⁿ`-a.e. for integer multiplicity triples
`R = (M, θ, ξ)`, `R₁ = (M₁, θ₁, ξ₁)`, `R₂ = (M₂, θ₂, ξ₂)`, then `μ_R ≤ |p₁| μ_{R₁} + |p₂| μ_{R₂}`.
At a.e. `x ∈ M`, `regcomp_unit_orientation_pairing` gives `β` with `|β|_E ≤ 1` and
`ξ(x)(β) = 1`, and `|ξᵢ(x)(β)| ≤ |β|_E ≤ 1` at a.e. `x ∈ Mᵢ`; evaluating the identity at `β`
gives `1_M θ ≤ |p₁| 1_{M₁} θ₁ + |p₂| 1_{M₂} θ₂` a.e.  Since `μ_{R'}` has density `1_{M'} θ'` with
respect to `Hⁿ`, this bound integrates to the claim. -/
theorem Submission.dor_lmb_ic_measure_le_of_weighted_orient_eq : ∀ (P n : ℕ) (U : Set (Euclid P)) (R₁ R₂ R : IMRep U n) (p₁ p₂ : ℤ), (∀ᵐ x ∂μHE[n], R.carrier.indicator (fun y => (R.mult y : ℝ) • R.orient y) x = (p₁ : ℝ) • R₁.carrier.indicator (fun y => (R₁.mult y : ℝ) • R₁.orient y) x + (p₂ : ℝ) • R₂.carrier.indicator (fun y => (R₂.mult y : ℝ) • R₂.orient y) x) → R.measure ≤ (p₁.natAbs : ℝ≥0∞) • R₁.measure + (p₂.natAbs : ℝ≥0∞) • R₂.measure := by
  intro P n U R₁ R₂ R p₁ p₂ h
  -- Step 1: `Hⁿ`-a.e., `x ∈ M'` implies that `ξ'(x)` is a unit orientation
  have hor : ∀ R' : IMRep U n, ∀ᵐ x ∂μHE[n], x ∈ R'.carrier →
      ∃ Q : Submodule ℝ (Euclid P), IsUnitOrientationOf (R'.orient x) Q := by
    intro R'
    filter_upwards [(ae_restrict_iff' R'.measurableSet_carrier).mp R'.orients] with x hx hxM
    obtain ⟨Q, -, hQ⟩ := hx hxM
    exact ⟨Q, hQ⟩
  -- Step 2: at such `x`, `|(1_{M'} θ' ξ')(x)(β)| ≤ 1_{M'} θ'(x)` whenever `|β|_E ≤ 1`
  have hone : ∀ (R' : IMRep U n) (x : Euclid P),
      (x ∈ R'.carrier → ∃ Q : Submodule ℝ (Euclid P), IsUnitOrientationOf (R'.orient x) Q) →
      ∀ β : Covector (Euclid P) n, covectorEuclideanNorm β ≤ 1 →
        |R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x β| ≤
          ((R'.carrier.indicator R'.mult x : ℕ) : ℝ) := by
    intro R' x hx β hβ
    by_cases hxM : x ∈ R'.carrier
    · obtain ⟨Q, hQ⟩ := hx hxM
      have hle :=
        ((Submission.regcomp_unit_orientation_pairing P n (R'.orient x) Q hQ).1 β).trans hβ
      rw [Set.indicator_of_mem hxM, Set.indicator_of_mem hxM, smul_apply, smul_eq_mul, abs_mul,
        Nat.abs_cast]
      exact mul_le_of_le_one_right (Nat.cast_nonneg _) hle
    · rw [Set.indicator_of_notMem hxM, Set.indicator_of_notMem hxM]
      simp
  -- Step 3: `μ_{R'}` has the measurable density `1_{M'} θ'` with respect to `Hⁿ`
  have hM : ∀ R' : IMRep U n,
      R'.measure = μHE[n].withDensity (R'.carrier.indicator fun x => (R'.mult x : ℝ≥0∞)) := by
    intro R'
    rw [IMRep.measure, withDensity_indicator R'.measurableSet_carrier]
  have hmeas : ∀ R' : IMRep U n, Measurable (R'.carrier.indicator fun x => (R'.mult x : ℝ≥0∞)) :=
    fun R' => (measurable_from_nat.comp R'.measurable_mult).indicator R'.measurableSet_carrier
  have hind : ∀ (R' : IMRep U n) (x : Euclid P), R'.carrier.indicator
      (fun y => (R'.mult y : ℝ≥0∞)) x = ((R'.carrier.indicator R'.mult x : ℕ) : ℝ≥0∞) := by
    intro R' x
    by_cases hxM : x ∈ R'.carrier
    · rw [Set.indicator_of_mem hxM, Set.indicator_of_mem hxM]
    · rw [Set.indicator_of_notMem hxM, Set.indicator_of_notMem hxM, Nat.cast_zero]
  -- Step 4: `|p₁| μ_{R₁} + |p₂| μ_{R₂}` has density `|p₁| 1_{M₁} θ₁ + |p₂| 1_{M₂} θ₂`, so it
  -- suffices to compare the densities `Hⁿ`-a.e.
  rw [hM R, hM R₁, hM R₂, ← withDensity_smul _ (hmeas R₁), ← withDensity_smul _ (hmeas R₂),
    ← withDensity_add_left ((hmeas R₁).const_smul _)]
  refine withDensity_mono ?_
  -- Step 5: `1_M θ ≤ |p₁| 1_{M₁} θ₁ + |p₂| 1_{M₂} θ₂` wherever the identity and Step 1 hold
  filter_upwards [h, hor R, hor R₁, hor R₂] with x hx h0 h1 h2
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, hind]
  by_cases hxM : x ∈ R.carrier
  swap
  · rw [Set.indicator_of_notMem hxM, Nat.cast_zero]
    exact zero_le
  -- evaluate the identity at a `β` with `|β|_E ≤ 1` and `ξ(x)(β) = 1`
  obtain ⟨Q, hQ⟩ := h0 hxM
  obtain ⟨-, β, hβ, hξβ⟩ := Submission.regcomp_unit_orientation_pairing P n (R.orient x) Q hQ
  have hev := congrArg (fun F : MultiVector P n => F β) hx
  simp only [Set.indicator_of_mem hxM, add_apply, smul_apply, smul_eq_mul, hξβ, mul_one] at hev
  have hreal : (R.mult x : ℝ) ≤ (p₁.natAbs : ℝ) * ((R₁.carrier.indicator R₁.mult x : ℕ) : ℝ) +
      (p₂.natAbs : ℝ) * ((R₂.carrier.indicator R₂.mult x : ℕ) : ℝ) := by
    rw [hev, Nat.cast_natAbs, Nat.cast_natAbs, Int.cast_abs, Int.cast_abs]
    calc (p₁ : ℝ) * R₁.carrier.indicator (fun y => (R₁.mult y : ℝ) • R₁.orient y) x β +
          (p₂ : ℝ) * R₂.carrier.indicator (fun y => (R₂.mult y : ℝ) • R₂.orient y) x β
        ≤ |(p₁ : ℝ)| * |R₁.carrier.indicator (fun y => (R₁.mult y : ℝ) • R₁.orient y) x β| +
          |(p₂ : ℝ)| * |R₂.carrier.indicator (fun y => (R₂.mult y : ℝ) • R₂.orient y) x β| := by
          rw [← abs_mul, ← abs_mul]
          exact add_le_add (le_abs_self _) (le_abs_self _)
      _ ≤ _ := by
          gcongr
          · exact hone R₁ x h1 β hβ
          · exact hone R₂ x h2 β hβ
  -- a real inequality between natural numbers
  have hnat : R.mult x ≤ p₁.natAbs * R₁.carrier.indicator R₁.mult x +
      p₂.natAbs * R₂.carrier.indicator R₂.mult x := by
    exact_mod_cast hreal
  rw [Set.indicator_of_mem hxM]
  exact_mod_cast hnat

/-- **Representations of the partial sums** (Simon Ch. 6, Lemma 3.13, steps 3–4): for integer
multiplicity triples `R r = (M_r, θ_r, ξ_r)` in an open `U` and every `q`, there is a triple
`R' = (M', θ', ξ')` with `1_{M'} θ' ξ' = ∑_{r<q} 1_{M_r} θ_r ξ_r` `Hⁿ`-a.e. and
`μ_{R'} ≤ ∑_{r<q} μ_{R r}`.  Induction on `q`: for `q = 0` take the empty triple `(∅, 0, 0)`; for
`q → q + 1`, `rsdic_exists_imrep_int_combination` with `p₁ = p₂ = 1` combines `R'` and `R q`, and
`dor_lmb_ic_measure_le_of_weighted_orient_eq` bounds the weight of the combination by
`μ_{R'} + μ_{R q}`. -/
theorem Submission.dor_lmb_fc_ims_partial_sum_reps : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : ℕ → IMRep U n), IsOpen U → ∀ q : ℕ, ∃ R' : IMRep U n, (∀ᵐ x ∂μHE[n], R'.carrier.indicator (fun y => (R'.mult y : ℝ) • R'.orient y) x = ∑ r ∈ Finset.range q, (R r).carrier.indicator (fun y => ((R r).mult y : ℝ) • (R r).orient y) x) ∧ R'.measure ≤ ∑ r ∈ Finset.range q, (R r).measure := by
  intro P n U R hU q
  induction q with
  | zero =>
    -- the empty triple `(∅, 0, 0)` has density `0` and weight `0`
    let R₀ : IMRep U n :=
      { carrier := ∅
        mult := fun _ => 0
        orient := fun _ => 0
        measurableSet_carrier := MeasurableSet.empty
        carrier_subset := empty_subset U
        rectifiable :=
          Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty
        measurable_mult := measurable_const
        mult_pos := fun x hx => absurd hx (notMem_empty x)
        locallyIntegrable_mult := fun K _ _ => by simp
        aestronglyMeasurable_orient := aestronglyMeasurable_const
        orients := by simp }
    refine ⟨R₀, Eventually.of_forall fun x => by simp [R₀], ?_⟩
    simp [R₀, IMRep.measure]
  | succ q ih =>
    obtain ⟨R', hR', hR'μ⟩ := ih
    -- `R''` represents `1 • (density of R') + 1 • (density of R q)`
    obtain ⟨R'', hR''⟩ := Submission.rsdic_exists_imrep_int_combination P n U R' (R q) 1 1 hU
    refine ⟨R'', ?_, ?_⟩
    · filter_upwards [hR'', hR'] with x h₁ h₂
      rw [h₁, h₂, Finset.sum_range_succ]
      simp
    · have h := Submission.dor_lmb_ic_measure_le_of_weighted_orient_eq P n U R' (R q) R'' 1 1 hR''
      simp only [Int.natAbs_one, Nat.cast_one, one_smul] at h
      rw [Finset.sum_range_succ]
      exact h.trans (add_le_add hR'μ le_rfl)

/-- **Simon Ch. 6, Remark 3.2(1)**: if `T₁, T₂ ∈ 𝒟ₙ(U)` are integer multiplicity and
`p₁, p₂ ∈ ℤ`, then `S = p₁T₁ + p₂T₂` is integer multiplicity.  Write `Tᵢ = τ(Mᵢ, θᵢ, ξᵢ)`.  The
orientations agree up to sign `Hⁿ`-a.e. on `M₁ ∩ M₂`, which gives a triple `(M', θ', ξ')` in `U`
with `θ'ξ'1_{M'} = p₁θ₁ξ₁1_{M₁} + p₂θ₂ξ₂1_{M₂}` `Hⁿ`-a.e.; integrating `⟨ω, ·⟩` for
`ω ∈ 𝒟ⁿ(U)` then gives `S = τ(M', θ', ξ')`. -/
theorem Submission.rsd_isIntegerMultiplicity_int_combination : ∀ (P n : ℕ) (U : Set (Euclid P)) (T₁ T₂ S : GeometricCurrentOn U n) (p₁ p₂ : ℤ), IsOpen U → IsIntegerMultiplicity T₁ → IsIntegerMultiplicity T₂ → (∀ ω : TestFormOn U n, S ω = (p₁ : ℝ) * T₁ ω + (p₂ : ℝ) * T₂ ω) → IsIntegerMultiplicity S := by
  intro P n U T₁ T₂ S p₁ p₂ hU hT₁ hT₂ hS
  -- Representations `T₁ = τ(M₁, θ₁, ξ₁)` and `T₂ = τ(M₂, θ₂, ξ₂)`.
  obtain ⟨R₁, hR₁⟩ := hT₁
  obtain ⟨R₂, hR₂⟩ := hT₂
  -- A triple `R = (M', θ', ξ')` in `U` with `θ'ξ'1_{M'} = p₁θ₁ξ₁1_{M₁} + p₂θ₂ξ₂1_{M₂}` a.e.
  obtain ⟨R, hR⟩ := Submission.rsdic_exists_imrep_int_combination P n U R₁ R₂ p₁ p₂ hU
  -- Hence `τ(R)(ω) = p₁τ(R₁)(ω) + p₂τ(R₂)(ω) = p₁T₁(ω) + p₂T₂(ω) = S(ω)`.
  refine ⟨R, fun ω => ?_⟩
  rw [hS ω, hR₁ ω, hR₂ ω,
    Submission.rsdic_imrep_action_int_combination P n U R₁ R₂ R p₁ p₂ hR ω]

/-- **Integer multiplicity calculus** (Simon Ch. 3, Remark 1.5(2) and the proof of 1.6 "⇒";
Ch. 6, Remarks 2.6, 2.9 and 3.2(1)).
(a) Locality: for Borel `M ⊆ M' ⊆ U`, `M'` locally `Hⁿ`-finite in the open `U`, `TₓM = TₓM'` for
`Hⁿ`-a.e. `x ∈ M` (tangent locality with the two sides exchanged).
(b) Restriction: for an `IMRep` `R = (M, θ, ξ)` in the open `U` and Borel `E`, `(M ∩ E, θ, ξ)` is
an `IMRep`: `M` is locally `Hⁿ`-finite in `U` (`θ ≥ 1` on `M`), so (a) for `M ∩ E ⊆ M` transfers
`TₓM` to `Tₓ(M ∩ E)` a.e. on `M ∩ E`; it defines a current `τ(M ∩ E, θ, ξ)`.
(c) Differences: `A − B = 1 · A + (−1) · B` is an integer combination.
(d) Orientation bound: `Hⁿ`-a.e. on `M`, `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ` with `τ` orthonormal, so
`|⟨α, ξ(x)⟩| = |α(τ)| ≤ |α|`. -/
theorem Submission.cmc_imRep_locality_restrict_sub : (∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α) := by
  -- (a) tangent locality for `M ⊆ M'`, with the two sides of `↔` exchanged
  have ha : ∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M →
      MeasurableSet M' → M ⊆ M' → M' ⊆ U →
      (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) →
      ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q := by
    intro P n U M M' hU hM hM' hMM' hM'U hfin
    filter_upwards [Submission.rsdic_ae_tangent_iff_of_subset P n U M M' hU hM hM' hMM' hM'U
      hfin] with x hx Q
    exact (hx Q).symm
  refine ⟨ha, ?_, ?_, ?_⟩
  · -- (b) the restriction `(M ∩ E, θ, ξ)` of `R = (M, θ, ξ)`
    intro P n U R E hU hE
    have hME : MeasurableSet (R.carrier ∩ E) := R.measurableSet_carrier.inter hE
    -- `TₓM = Tₓ(M ∩ E)` a.e. on `M ∩ E`, `M` being locally `Hⁿ`-finite in `U`
    have htan : ∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ E)), ∀ Q : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt n R.carrier x Q →
          HasApproximateTangentSpaceAt n (R.carrier ∩ E) x Q := by
      filter_upwards [ha P n U (R.carrier ∩ E) R.carrier hU hME R.measurableSet_carrier
        inter_subset_left R.carrier_subset fun K hK hKU =>
          (Submission.rsd_imrep_compact_measure_ne_top P n U R K hK hKU).1] with x hx Q
      exact (hx Q).2
    obtain ⟨R', hcar, hmult, horient⟩ := Submission.regcomp_rim_sub_imrep P n U (R.carrier ∩ E) R
      R.mult hME inter_subset_left R.measurable_mult (fun x hx => R.mult_pos x hx.1)
      (fun x _ => le_rfl) htan
    -- the current `τ(M ∩ E, θ, ξ)`
    obtain ⟨A, hA⟩ := Submission.dtc_imrep_current P n U R'
    exact ⟨A, R', hA, hcar, hmult, horient⟩
  · -- (c) `A − B = 1 · A + (−1) · B`
    intro P n U A B hU hA hB
    refine Submission.rsd_isIntegerMultiplicity_int_combination P n U A B (A - B) 1 (-1) hU hA hB
      fun ω => ?_
    show A ω - B ω = _
    push_cast
    ring
  · -- (d) `ξ(x) = ±τ₁ ∧ ⋯ ∧ τₙ` with `τ` orthonormal, a.e. on `M`
    intro P n U R
    filter_upwards [R.orients] with x hx α
    obtain ⟨Q, -, τ, hτ, -, hξ⟩ := hx
    have hατ := Submission.regcomp_covector_eval_orthonormal_le P n α τ hτ
    rcases hξ with h | h
    · rw [h α]
      exact hατ
    · rw [h α, abs_neg]
      exact hατ
/-- Lower semicontinuity of mass under weak convergence on exhausting domains (Simon 6.2.14, as
used in 7.2.4 and 7.3.1): if every closed ball `B̄_R(0)` lies in `Uⱼ` for all large `j` and
`Sⱼ ⇀ C` in `ℝᴾ`, then `M_O(C) ≤ liminf_i M_O(S_{φ(i)})` for every subsequence `φ` and every `O`.
An `ω` admissible for `M_O(C)` has compact support, so it lies in some `B̄_R(0)` and is admissible
for `S_{φ(i)}` for all large `i`; hence `ofReal(C(ω)) = liminf_i ofReal(S_{φ(i)}(ω))` is at most
`liminf_i M_O(S_{φ(i)})`. -/
theorem Submission.dtc_bc_mm_massOn_le_liminf : ∀ (P n : ℕ) (Us : ℕ → Set (Euclid P)) (Ss : (j : ℕ) → GeometricCurrentOn (Us j) n) (C : GeometricCurrentOn (univ : Set (Euclid P)) n), (∀ R : ℝ, ∀ᶠ j in atTop, closedBall (0 : Euclid P) R ⊆ Us j) → ConvergesWeakly Ss C → ∀ φ : ℕ → ℕ, StrictMono φ → ∀ O : Set (Euclid P), C.massOn O ≤ liminf (fun i => (Ss (φ i)).massOn O) atTop := by
  intro P n Us Ss C hUs hconv φ hφ O
  -- `M_O(C)` is a supremum: bound each admissible evaluation `ofReal(C(ω))`.
  refine sSup_le ?_
  rintro r ⟨ω, hω, rfl⟩
  set w : DifferentialForm (Euclid P) n := (ω : DifferentialForm (Euclid P) n)
  have hwt : IsTestForm w := ω.property.1
  -- `tsupport ω` is compact, so it lies in a closed ball, eventually contained in `U_{φ(i)}`.
  obtain ⟨R, hR⟩ := hwt.2.isCompact.isBounded.subset_closedBall (0 : Euclid P)
  have hev : ∀ᶠ i in atTop, closedBall (0 : Euclid P) R ⊆ Us (φ i) :=
    hφ.tendsto_atTop.eventually (hUs R)
  -- There `ω` is admissible for `S_{φ(i)}`, and `currentEval` is its evaluation.
  have hle : ∀ᶠ i in atTop,
      ENNReal.ofReal (currentEval (Ss (φ i)) w) ≤ (Ss (φ i)).massOn O := by
    filter_upwards [hev] with i hi
    have hmem : IsTestForm w ∧ tsupport w ⊆ Us (φ i) := ⟨hwt, hR.trans hi⟩
    have heval : currentEval (Ss (φ i)) w = Ss (φ i) ⟨w, hmem⟩ := by
      unfold currentEval
      exact dite_eq_left hmem
    rw [heval]
    exact (Ss (φ i)).le_massOn (omega := ⟨w, hmem⟩) ⟨hω.1, hω.2⟩
  -- `currentEval (S_{φ(i)}) ω → C(ω)`, so `ofReal(C(ω))` is the liminf of `ofReal` of these values.
  calc ENNReal.ofReal (C ω)
      = liminf (fun i => ENNReal.ofReal (currentEval (Ss (φ i)) w)) atTop :=
        (ENNReal.tendsto_ofReal ((hconv ω).comp hφ.tendsto_atTop)).liminf_eq.symm
    _ ≤ liminf (fun i => (Ss (φ i)).massOn O) atTop := liminf_le_liminf hle
/-- **Simon 7.3.1** (proof, display (1)).  If `μ(B_r(x))/(ωₙrⁿ) → θ` as `r ↓ 0`, `λⱼ > 0`,
`λⱼ → 0`, and `μⱼ(s) = λⱼ⁻ⁿ μ(η_{x,λⱼ}⁻¹(s))` for measurable `s`, then `μⱼ(B_ρ(0)) → ωₙρⁿθ` for
every `ρ > 0`.  As `η_{x,λ}⁻¹(B_ρ(0)) = B_{λρ}(x)` and `0 < ωₙ < ∞`, cancelling `ωₙ` in `[0, ∞]`
gives `μⱼ(B_ρ(0)) = ωₙρⁿ · μ(B_{λⱼρ}(x))/(ωₙ(λⱼρ)ⁿ)`, and `λⱼρ ↓ 0`. -/
theorem Submission.dtc_rescaled_ball_measure_tendsto : ∀ (P n : ℕ) (μ : Measure (Euclid P)) (μs : ℕ → Measure (Euclid P)) (x : Euclid P) (θ : ℝ) (lams : ℕ → ℝ), (∀ j, 0 < lams j) → Tendsto lams atTop (𝓝 0) → Tendsto (fun r : ℝ => μ (ball x r) / (unitBallVolume n * ENNReal.ofReal (r ^ n))) (𝓝[>] 0) (𝓝 (ENNReal.ofReal θ)) → (∀ (j : ℕ) (s : Set (Euclid P)), MeasurableSet s → μs j s = ENNReal.ofReal ((lams j)⁻¹ ^ n) * μ (dilation x (lams j) ⁻¹' s)) → ∀ ρ : ℝ, 0 < ρ → Tendsto (fun j => μs j (ball 0 ρ)) atTop (𝓝 (unitBallVolume n * ENNReal.ofReal (ρ ^ n) * ENNReal.ofReal θ)) := by
  intro P n μ μs x θ lams hpos hlim hdens hscale ρ hρ
  -- Step 1: `0 < ωₙ < ∞`, so `K = ωₙρⁿ ≠ ∞`
  have hω0 : unitBallVolume n ≠ 0 :=
    (measure_ball_pos volume (0 : Euclid n) zero_lt_one).ne'
  have hωtop : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
  have hKtop : unitBallVolume n * ENNReal.ofReal (ρ ^ n) ≠ ∞ :=
    ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top
  -- Step 2: `η_{x,λ}⁻¹(B_ρ(0)) = B_{λρ}(x)`, since `η_{x,λ}(y) = λ⁻¹(y - x)`
  have hpre : ∀ lam : ℝ, 0 < lam → dilation x lam ⁻¹' ball 0 ρ = ball x (lam * ρ) := by
    intro lam hlam
    ext y
    have hy : dilation x lam y = lam⁻¹ • (y - x) := by
      simp [dilation, dilationCLM, smul_sub, neg_add_eq_sub]
    simp only [mem_preimage, mem_ball, dist_eq_norm, sub_zero, hy, norm_smul, Real.norm_eq_abs,
      abs_of_pos (inv_pos.mpr hlam)]
    exact inv_mul_lt_iff₀ hlam
  -- Steps 3–4: `μⱼ(B_ρ(0)) = λⱼ⁻ⁿ μ(B_{λⱼρ}(x)) = K · q(λⱼρ)`, cancelling `ωₙ` in `[0, ∞]`
  have heq : ∀ j, μs j (ball 0 ρ) = unitBallVolume n * ENNReal.ofReal (ρ ^ n) *
      (μ (ball x (lams j * ρ)) / (unitBallVolume n * ENNReal.ofReal ((lams j * ρ) ^ n))) := by
    intro j
    have hr : 0 < (lams j * ρ) ^ n := pow_pos (mul_pos (hpos j) hρ) n
    rw [hscale j _ measurableSet_ball, hpre _ (hpos j), ← ENNReal.mul_comm_div,
      ENNReal.mul_div_mul_left _ _ hω0 hωtop, ← ENNReal.ofReal_div_of_pos hr]
    congr 2
    rw [mul_pow, inv_pow]
    field_simp [(pow_pos (hpos j) n).ne', (pow_pos hρ n).ne']
  -- Step 5: `λⱼρ → 0` in `𝓝[>] 0`
  have hlimr : Tendsto (fun j => lams j * ρ) atTop (𝓝[>] 0) := by
    rw [tendsto_nhdsWithin_iff]
    exact ⟨by simpa using hlim.mul_const ρ, Eventually.of_forall fun j => mul_pos (hpos j) hρ⟩
  -- Step 6: multiply `q(λⱼρ) → θ` by the finite constant `K`
  have h := ENNReal.Tendsto.const_mul (hdens.comp hlimr) (Or.inr hKtop)
  simp only [Function.comp_def] at h
  simp only [heq]
  exact h
/-- **Simon 7.3.1** (proof, display (4)): if `∫ f dμⱼ → ∫ f dμ` for every continuous compactly
supported `f`, `μ` is finite on balls, each ball is eventually `μⱼ`-finite and `μ(∂B_ρ(0)) = 0`,
then `μⱼ(B_ρ(0)) → μ(B_ρ(0))`.  The radial cut-offs `φ_{a,b}` (`1` on `B̄_a(0)`, `0` off
`B_b(0)`) give `μ(B̄_{ρ-1/(k+1)}(0)) ≤ liminf μⱼ(B_ρ(0))` and
`limsup μⱼ(B̄_ρ(0)) ≤ μ(B_{ρ+1/(k+1)}(0))`; letting `k → ∞` and using the null sphere closes the
liminf/limsup sandwich. -/
theorem Submission.dtc_tendsto_measure_ball_of_vague : ∀ (P : ℕ) (μs : ℕ → Measure (Euclid P)) (μ : Measure (Euclid P)) (ρ : ℝ), 0 < ρ → (∀ r : ℝ, 0 < r → μ (ball 0 r) ≠ ∞) → (∀ r : ℝ, 0 < r → ∀ᶠ j in atTop, μs j (ball 0 r) ≠ ∞) → (∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → Tendsto (fun j => ∫ y, f y ∂(μs j)) atTop (𝓝 (∫ y, f y ∂μ))) → μ (sphere 0 ρ) = 0 → Tendsto (fun j => μs j (ball 0 ρ)) atTop (𝓝 (μ (ball 0 ρ))) := by
  intro P μs μ ρ hρ hμ hμs hvague hsph
  -- Step 1: cut-offs `φ a b = min 1 (max 0 ((b - ‖·‖) / (b - a)))`: `1` on `closedBall 0 a`,
  -- `0` off `ball 0 b`, continuous with compact support
  obtain ⟨φ, hφ_cont, hφ_nonneg, hφ_le_one, hφ_one, hφ_zero⟩ : ∃ φ : ℝ → ℝ → Euclid P → ℝ,
      (∀ a b, Continuous (φ a b)) ∧ (∀ a b y, 0 ≤ φ a b y) ∧ (∀ a b y, φ a b y ≤ 1) ∧
      (∀ a b y, a < b → ‖y‖ ≤ a → φ a b y = 1) ∧ (∀ a b y, a < b → b ≤ ‖y‖ → φ a b y = 0) := by
    refine ⟨fun a b y => min 1 (max 0 ((b - ‖y‖) / (b - a))), fun a b => ?_,
      fun a b y => le_min zero_le_one (le_max_left _ _), fun a b y => min_le_left _ _,
      fun a b y hab hy => ?_, fun a b y hab hy => ?_⟩
    · exact continuous_const.min (continuous_const.max
        ((continuous_const.sub continuous_norm).div_const _))
    · have h1 : 1 ≤ (b - ‖y‖) / (b - a) := by
        rw [le_div_iff₀ (sub_pos.2 hab)]
        linarith
      simp only [max_eq_right (zero_le_one.trans h1), min_eq_left h1]
    · have h0 : (b - ‖y‖) / (b - a) ≤ 0 :=
        div_nonpos_of_nonpos_of_nonneg (by linarith) (sub_pos.2 hab).le
      simp only [max_eq_left h0, min_eq_right zero_le_one]
  have hφ_supp : ∀ a b, a < b → HasCompactSupport (φ a b) := fun a b hab =>
    HasCompactSupport.intro (isCompact_closedBall (0 : Euclid P) b) fun y hy =>
      hφ_zero a b y hab (not_le.1 (mt mem_closedBall_zero_iff.2 hy)).le
  -- Step 2: `∫ φ dν = (∫⁻ ofReal φ dν).toReal`, and `1_E ≤ ofReal φ ≤ 1_{ball 0 b}`
  have hint : ∀ (ν : Measure (Euclid P)) a b,
      ∫ y, φ a b y ∂ν = (∫⁻ y, ENNReal.ofReal (φ a b y) ∂ν).toReal := fun ν a b =>
    integral_eq_lintegral_of_nonneg_ae (ae_of_all _ (hφ_nonneg a b))
      (hφ_cont a b).aestronglyMeasurable
  have hlint_le : ∀ (ν : Measure (Euclid P)) a b, a < b →
      ∫⁻ y, ENNReal.ofReal (φ a b y) ∂ν ≤ ν (ball 0 b) := by
    intro ν a b hab
    rw [← lintegral_indicator_one measurableSet_ball]
    refine lintegral_mono fun y => ?_
    by_cases hy : y ∈ ball (0 : Euclid P) b
    · rw [indicator_of_mem hy, Pi.one_apply, ← ENNReal.ofReal_one]
      exact ENNReal.ofReal_le_ofReal (hφ_le_one a b y)
    · rw [hφ_zero a b y hab (not_lt.1 (mt mem_ball_zero_iff.2 hy)), ENNReal.ofReal_zero]
      exact zero_le
  -- (i) `ofReal (∫ φ dν) ≤ ν (ball 0 b)`
  have hint_le : ∀ (ν : Measure (Euclid P)) a b, a < b →
      ENNReal.ofReal (∫ y, φ a b y ∂ν) ≤ ν (ball 0 b) := fun ν a b hab => by
    rw [hint]
    exact ENNReal.ofReal_toReal_le.trans (hlint_le ν a b hab)
  -- (ii) `ν E ≤ ofReal (∫ φ dν)` if `ν (ball 0 b) ≠ ∞` and `φ = 1` on `E`
  have hle_int : ∀ (ν : Measure (Euclid P)) a b (E : Set (Euclid P)), a < b →
      ν (ball 0 b) ≠ ∞ → MeasurableSet E → (∀ y ∈ E, φ a b y = 1) →
      ν E ≤ ENNReal.ofReal (∫ y, φ a b y ∂ν) := by
    intro ν a b E hab hfin hE hφE
    rw [hint, ENNReal.ofReal_toReal (ne_top_of_le_ne_top hfin (hlint_le ν a b hab)),
      ← lintegral_indicator_one hE]
    refine lintegral_mono fun y => ?_
    by_cases hy : y ∈ E
    · rw [indicator_of_mem hy, Pi.one_apply, hφE y hy, ENNReal.ofReal_one]
    · rw [indicator_of_notMem hy]
      exact zero_le
  have htend : ∀ a b, a < b → Tendsto (fun j => ENNReal.ofReal (∫ y, φ a b y ∂(μs j))) atTop
      (𝓝 (ENNReal.ofReal (∫ y, φ a b y ∂μ))) := fun a b hab =>
    (ENNReal.continuous_ofReal.tendsto _).comp (hvague _ (hφ_cont a b) (hφ_supp a b hab))
  have hk : Tendsto (fun k : ℕ => 1 / ((k : ℝ) + 1)) atTop (𝓝 0) :=
    tendsto_one_div_add_atTop_nhds_zero_nat
  have hk_pos : ∀ k : ℕ, 0 < 1 / ((k : ℝ) + 1) := fun k => by positivity
  have hk_anti : Antitone fun k : ℕ => 1 / ((k : ℝ) + 1) := fun i j hij =>
    one_div_le_one_div_of_le (by positivity) (by exact_mod_cast Nat.add_le_add_right hij 1)
  -- Step 3: `μ (ball 0 ρ) ≤ liminf μⱼ (ball 0 ρ)`, with `closedBall 0 (ρ - 1/(k+1)) ↑ ball 0 ρ`
  have hliminf : μ (ball 0 ρ) ≤ liminf (fun j => μs j (ball 0 ρ)) atTop := by
    have ha_lt : ∀ k : ℕ, ρ - 1 / ((k : ℝ) + 1) < ρ := fun k => by linarith [hk_pos k]
    have hU : ⋃ k : ℕ, closedBall (0 : Euclid P) (ρ - 1 / ((k : ℝ) + 1)) = ball 0 ρ := by
      refine Subset.antisymm (iUnion_subset fun k => closedBall_subset_ball (ha_lt k))
        fun y hy => ?_
      have ha : Tendsto (fun k : ℕ => ρ - 1 / ((k : ℝ) + 1)) atTop (𝓝 ρ) := by
        simpa using (tendsto_const_nhds (x := ρ)).sub hk
      obtain ⟨k, hk'⟩ := (ha.eventually (lt_mem_nhds (mem_ball_zero_iff.1 hy))).exists
      exact mem_iUnion.2 ⟨k, mem_closedBall_zero_iff.2 hk'.le⟩
    have hmono : Monotone fun k : ℕ => closedBall (0 : Euclid P) (ρ - 1 / ((k : ℝ) + 1)) :=
      fun i j hij => closedBall_subset_closedBall (by linarith [hk_anti hij])
    have hμU : μ (ball 0 ρ) = ⨆ k : ℕ, μ (closedBall 0 (ρ - 1 / ((k : ℝ) + 1))) := by
      rw [← hU, hmono.measure_iUnion]
    rw [hμU]
    refine iSup_le fun k => ?_
    calc μ (closedBall 0 (ρ - 1 / ((k : ℝ) + 1)))
        ≤ ENNReal.ofReal (∫ y, φ (ρ - 1 / ((k : ℝ) + 1)) ρ y ∂μ) :=
          hle_int μ _ ρ _ (ha_lt k) (hμ ρ hρ) measurableSet_closedBall
            fun y hy => hφ_one _ _ y (ha_lt k) (mem_closedBall_zero_iff.1 hy)
      _ = liminf (fun j => ENNReal.ofReal (∫ y, φ (ρ - 1 / ((k : ℝ) + 1)) ρ y ∂(μs j))) atTop :=
          ((htend _ _ (ha_lt k)).liminf_eq).symm
      _ ≤ liminf (fun j => μs j (ball 0 ρ)) atTop :=
          liminf_le_liminf (Eventually.of_forall fun j => hint_le (μs j) _ ρ (ha_lt k))
  -- Step 4: `limsup μⱼ (closedBall 0 ρ) ≤ μ (closedBall 0 ρ)`, with `ball 0 (ρ + 1/(k+1)) ↓`
  have hlimsup : limsup (fun j => μs j (closedBall 0 ρ)) atTop ≤ μ (closedBall 0 ρ) := by
    have hb_gt : ∀ k : ℕ, ρ < ρ + 1 / ((k : ℝ) + 1) := fun k => by linarith [hk_pos k]
    have hI : ⋂ k : ℕ, ball (0 : Euclid P) (ρ + 1 / ((k : ℝ) + 1)) = closedBall 0 ρ := by
      refine Subset.antisymm (fun y hy => ?_)
        (subset_iInter fun k => closedBall_subset_ball (hb_gt k))
      have hb : Tendsto (fun k : ℕ => ρ + 1 / ((k : ℝ) + 1)) atTop (𝓝 ρ) := by
        simpa using (tendsto_const_nhds (x := ρ)).add hk
      exact mem_closedBall_zero_iff.2
        (ge_of_tendsto' hb fun k => (mem_ball_zero_iff.1 (mem_iInter.1 hy k)).le)
    have hanti : Antitone fun k : ℕ => ball (0 : Euclid P) (ρ + 1 / ((k : ℝ) + 1)) :=
      fun i j hij => ball_subset_ball (by linarith [hk_anti hij])
    have hμI : μ (closedBall 0 ρ) = ⨅ k : ℕ, μ (ball 0 (ρ + 1 / ((k : ℝ) + 1))) := by
      rw [← hI, hanti.measure_iInter (fun k => measurableSet_ball.nullMeasurableSet)
        ⟨0, hμ _ (hρ.trans (hb_gt 0))⟩]
    rw [hμI]
    refine le_iInf fun k => ?_
    calc limsup (fun j => μs j (closedBall 0 ρ)) atTop
        ≤ limsup (fun j => ENNReal.ofReal (∫ y, φ ρ (ρ + 1 / ((k : ℝ) + 1)) y ∂(μs j))) atTop := by
          refine limsup_le_limsup ?_
          filter_upwards [hμs _ (hρ.trans (hb_gt k))] with j hj
          exact hle_int (μs j) ρ _ _ (hb_gt k) hj measurableSet_closedBall
            fun y hy => hφ_one _ _ y (hb_gt k) (mem_closedBall_zero_iff.1 hy)
      _ = ENNReal.ofReal (∫ y, φ ρ (ρ + 1 / ((k : ℝ) + 1)) y ∂μ) := (htend _ _ (hb_gt k)).limsup_eq
      _ ≤ μ (ball 0 (ρ + 1 / ((k : ℝ) + 1))) := hint_le μ ρ _ (hb_gt k)
  -- Step 5: the sphere is `μ`-null, so `μ (closedBall 0 ρ) ≤ μ (ball 0 ρ)`
  have hcb : μ (closedBall 0 ρ) ≤ μ (ball 0 ρ) :=
    calc μ (closedBall 0 ρ) = μ (ball 0 ρ ∪ sphere 0 ρ) := by rw [ball_union_sphere]
      _ ≤ μ (ball 0 ρ) + μ (sphere 0 ρ) := measure_union_le _ _
      _ = μ (ball 0 ρ) := by rw [hsph, add_zero]
  -- Step 6: the liminf/limsup sandwich in `[0, ∞]`
  refine tendsto_of_le_liminf_of_limsup_le hliminf ?_
  calc limsup (fun j => μs j (ball 0 ρ)) atTop ≤ limsup (fun j => μs j (closedBall 0 ρ)) atTop :=
        limsup_le_limsup (Eventually.of_forall fun j => measure_mono ball_subset_closedBall)
    _ ≤ μ (closedBall 0 ρ) := hlimsup
    _ ≤ μ (ball 0 ρ) := hcb
/-- **Simon 7.3.1** (proof, after display (4)): let `μ` be finite on balls and `c ≠ ∞`.  If
`μ(B_ρ(0)) = c ρⁿ` for every `ρ > 0` with `μ(∂B_ρ(0)) = 0`, then it holds for every `ρ > 0`.
Only countably many spheres `∂B_t(0)` are charged: they are level sets of `‖·‖` for the finite
measures `μ⌞B_{m+1}(0)`.  So there are good radii `rₖ ∈ (sₖ, ρ)`, `sₖ = ρ - ρ/(k+1)`; letting
`k → ∞` in `c rₖⁿ ≤ μ(B_ρ(0))` and in `μ(B_{sₖ}(0)) ≤ c rₖⁿ ≤ c ρⁿ` gives both inequalities. -/
theorem Submission.dtc_measure_ball_eq_of_null_sphere : ∀ (P n : ℕ) (μ : Measure (Euclid P)) (c : ℝ≥0∞), c ≠ ∞ → (∀ r : ℝ, 0 < r → μ (ball 0 r) ≠ ∞) → (∀ ρ : ℝ, 0 < ρ → μ (sphere 0 ρ) = 0 → μ (ball 0 ρ) = c * ENNReal.ofReal (ρ ^ n)) → ∀ ρ : ℝ, 0 < ρ → μ (ball 0 ρ) = c * ENNReal.ofReal (ρ ^ n) := by
  intro P n μ c hc hfin hgood ρ hρ
  -- Step 1: the set `N` of radii of charged spheres is countable
  set N : Set ℝ := {t | 0 < μ (sphere (0 : Euclid P) t)}
  have hNc : N.Countable := by
    -- `μ⌞B_{m+1}(0)` is finite, so it charges only countably many level sets of `‖·‖`
    have hlevel : ∀ m : ℕ,
        {t : ℝ | 0 < μ.restrict (ball (0 : Euclid P) (m + 1)) {a | ‖a‖ = t}}.Countable := by
      intro m
      have : IsFiniteMeasure (μ.restrict (ball (0 : Euclid P) (m + 1))) :=
        ⟨by rw [Measure.restrict_apply_univ]; exact lt_top_iff_ne_top.2 (hfin _ (by positivity))⟩
      exact Measure.countable_meas_level_set_pos measurable_norm
    refine (countable_iUnion hlevel).mono fun t ht => ?_
    have ht' : 0 < μ (sphere (0 : Euclid P) t) := ht
    obtain ⟨m, hm⟩ := exists_nat_gt t
    have hsub : sphere (0 : Euclid P) t ⊆ ball 0 (m + 1) := fun a ha => by
      rw [mem_ball_zero_iff, mem_sphere_zero_iff_norm.1 ha]
      linarith
    have hsph : {a : Euclid P | ‖a‖ = t} = sphere 0 t := by
      ext a
      simp
    simp only [mem_iUnion, mem_ofPred_eq]
    refine ⟨m, ?_⟩
    rwa [hsph, Measure.restrict_apply' measurableSet_ball, inter_eq_left.2 hsub]
  -- Step 2: every nonempty open interval contains a radius outside `N`
  have hIoo : ∀ a b : ℝ, a < b → ∃ r ∈ Ioo a b, r ∉ N := by
    intro a b hab
    by_contra h
    push Not at h
    have h0 : volume (Ioo a b) = 0 := measure_mono_null (fun r hr => h r hr) (hNc.measure_zero _)
    rw [Real.volume_Ioo, ENNReal.ofReal_eq_zero] at h0
    linarith
  have hgood' : ∀ r : ℝ, 0 < r → r ∉ N → μ (ball 0 r) = c * ENNReal.ofReal (r ^ n) :=
    fun r hr hrN => hgood r hr (by simpa [N, pos_iff_ne_zero] using hrN)
  -- Step 3: `sₖ = ρ - ρ/(k+1)` increases to `ρ`, and good radii `rₖ ∈ (sₖ, ρ)` tend to `ρ`
  set s : ℕ → ℝ := fun k => ρ - ρ / (k + 1) with hs
  have hs_lt : ∀ k, s k < ρ := fun k => by
    have : 0 < ρ / (k + 1) := by positivity
    simp only [hs]
    linarith
  have hs_nonneg : ∀ k, 0 ≤ s k := fun k => by
    have : ρ / (k + 1) ≤ ρ := div_le_self hρ.le (by linarith [k.cast_nonneg (α := ℝ)])
    simp only [hs]
    linarith
  have hs_mono : Monotone s := fun i j hij => by
    have : ρ / ((j : ℝ) + 1) ≤ ρ / ((i : ℝ) + 1) :=
      div_le_div_of_nonneg_left hρ.le (by positivity) (by exact_mod_cast Nat.add_le_add_right hij 1)
    simp only [hs]
    linarith
  have hs_tend : Tendsto s atTop (𝓝 ρ) := by
    have : Tendsto (fun k : ℕ => ρ / ((k : ℝ) + 1)) atTop (𝓝 0) :=
      ((tendsto_const_div_atTop_nhds_zero_nat ρ).comp (tendsto_add_atTop_nat 1)).congr
        fun k => by simp
    simpa using (tendsto_const_nhds (x := ρ)).sub this
  choose r hr hrN using fun k => hIoo (s k) ρ (hs_lt k)
  have hr_pos : ∀ k, 0 < r k := fun k => (hs_nonneg k).trans_lt (hr k).1
  have hr_tend : Tendsto r atTop (𝓝 ρ) :=
    tendsto_of_tendsto_of_tendsto_of_le_of_le hs_tend tendsto_const_nhds
      (fun k => (hr k).1.le) fun k => (hr k).2.le
  -- Step 4: lower bound, letting `k → ∞` in `c rₖⁿ = μ(B_{rₖ}(0)) ≤ μ(B_ρ(0))` (uses `c ≠ ∞`)
  have hlower : c * ENNReal.ofReal (ρ ^ n) ≤ μ (ball 0 ρ) := by
    have hlim : Tendsto (fun k => c * ENNReal.ofReal (r k ^ n)) atTop
        (𝓝 (c * ENNReal.ofReal (ρ ^ n))) :=
      ENNReal.Tendsto.const_mul ((ENNReal.continuous_ofReal.tendsto _).comp
        (((continuous_pow n).tendsto ρ).comp hr_tend)) (Or.inr hc)
    refine le_of_tendsto' hlim fun k => ?_
    rw [← hgood' _ (hr_pos k) (hrN k)]
    exact measure_mono (ball_subset_ball (hr k).2.le)
  -- Step 5: upper bound, by continuity from below along the balls `B_{sₖ}(0) ↑ B_ρ(0)`
  have hupper : μ (ball 0 ρ) ≤ c * ENNReal.ofReal (ρ ^ n) := by
    have hU : ⋃ k, ball (0 : Euclid P) (s k) = ball 0 ρ := by
      refine Subset.antisymm (iUnion_subset fun k => ball_subset_ball (hs_lt k).le) fun y hy => ?_
      rw [mem_ball_zero_iff] at hy
      obtain ⟨k, hk⟩ := (hs_tend.eventually (lt_mem_nhds hy)).exists
      exact mem_iUnion.2 ⟨k, mem_ball_zero_iff.2 hk⟩
    have hmono : Monotone fun k => ball (0 : Euclid P) (s k) :=
      fun i j hij => ball_subset_ball (hs_mono hij)
    rw [← hU, hmono.measure_iUnion]
    refine iSup_le fun k => ?_
    calc μ (ball 0 (s k)) ≤ μ (ball 0 (r k)) := measure_mono (ball_subset_ball (hr k).1.le)
      _ = c * ENNReal.ofReal (r k ^ n) := hgood' _ (hr_pos k) (hrN k)
      _ ≤ c * ENNReal.ofReal (ρ ^ n) := by
        have h1 : 0 ≤ r k := (hr_pos k).le
        have h2 : r k ≤ ρ := (hr k).2.le
        gcongr
  -- Step 6
  exact le_antisymm hupper hlower
/-- **`Df(x)` fixes the approximate tangent space of a pointwise fixed set** (steps 5–6 of the proof
that a map fixing `spt T` preserves the orientation of `T`; approximate tangent spaces as in Simon
Ch. 3, Definition 1.4).  If `f` is differentiable at `x`, `f(x) = x`, `f` fixes every point of `A`
and `Q` is an approximate tangent space of `A` at `x`, then `Df(x)v = v` for every `v ∈ Q`.  The
blow-up points `u = λ⁻¹(y − x)`, `y ∈ A`, approach `v` as `λ ↓ 0`; since `f(y) − f(x) = y − x`,
differentiability gives `|u − Df(x)u| ≤ η|u|`, so `|Df(x)v − v| ≤ ε` for every `ε > 0`. -/
theorem Submission.dtc_bc_lc_fderiv_apply_eq_of_approxTangent : ∀ (P n : ℕ) (A : Set (Euclid P)) (f : Euclid P → Euclid P) (x : Euclid P) (Q : Submodule ℝ (Euclid P)), HasApproximateTangentSpaceAt n A x Q → DifferentiableAt ℝ f x → f x = x → (∀ y ∈ A, f y = y) → ∀ v ∈ Q, fderiv ℝ f x v = v := by
  intro P n A f x Q hQ hf hfx hA v hv
  set L := fderiv ℝ f x
  have hfL : HasFDerivAt f L x := hf.hasFDerivAt
  -- Step 1: it suffices to show `|Lv − v| ≤ ε` for every `ε > 0`; fix the constants
  refine eq_of_forall_dist_le fun ε hε => ?_
  rw [dist_eq_norm]
  set C : ℝ := ‖v‖ + 1 with hC
  set K : ℝ := ‖L‖ + 1 with hK
  have hCpos : 0 < C := by rw [hC]; positivity
  have hKpos : 0 < K := by rw [hK]; positivity
  set η : ℝ := ε / (2 * C) with hη
  set s : ℝ := min 1 (ε / (2 * K))
  have hηpos : 0 < η := div_pos hε (mul_pos two_pos hCpos)
  have hspos : 0 < s := lt_min one_pos (div_pos hε (mul_pos two_pos hKpos))
  have hKs : K * s ≤ ε / 2 := by
    calc K * s ≤ K * (ε / (2 * K)) := mul_le_mul_of_nonneg_left (min_le_right _ _) hKpos.le
      _ = ε / 2 := by field_simp
  have hηC : η * C = ε / 2 := by rw [hη]; field_simp
  -- Step 2: differentiability gives `δ > 0` with `|f(y) − f(x) − L(y − x)| ≤ η|y − x|` near `x`
  obtain ⟨δ, hδ, hδf⟩ := Metric.eventually_nhds_iff.mp (hfL.isLittleO.bound hηpos)
  -- Step 3: blow-up points of `A ∩ A = A` approach `v`
  obtain ⟨lam₀, hlam₀, hpts⟩ :=
    Submission.dsmc_att_blowUp_points_of_approxTangent P n A A x v Q (by simp) hQ hv s hspos
  -- Step 4: the scale `λ = min(λ₀/2, δ/(2C))` and the point `u = λ⁻¹(y − x)`
  set lam : ℝ := min (lam₀ / 2) (δ / (2 * C))
  have hlampos : 0 < lam := lt_min (half_pos hlam₀) (div_pos hδ (mul_pos two_pos hCpos))
  obtain ⟨y, ⟨hyA, -⟩, hy⟩ := hpts lam hlampos ((min_le_left _ _).trans_lt (half_lt_self hlam₀))
  set u : Euclid P := lam⁻¹ • (y - x) with hu
  have hyx : y - x = lam • u := by rw [hu, smul_inv_smul₀ hlampos.ne']
  have huv : ‖u - v‖ < s := hy
  have huC : ‖u‖ ≤ C := by
    have h1 := norm_le_norm_sub_add u v
    have h2 := huv.trans_le (min_le_left _ _)
    rw [hC]; linarith
  have hyδ : dist y x < δ := by
    rw [dist_eq_norm, hyx, norm_smul, Real.norm_of_nonneg hlampos.le]
    calc lam * ‖u‖ ≤ δ / (2 * C) * C :=
          mul_le_mul (min_le_right _ _) huC (norm_nonneg _) (div_pos hδ (mul_pos two_pos hCpos)).le
      _ = δ / 2 := by field_simp
      _ < δ := half_lt_self hδ
  -- Step 5: `f(y) = y` and `f(x) = x` turn the estimate into `|u − Lu| ≤ η|u| ≤ ε/2`
  have hkey : ‖u - L u‖ ≤ ε / 2 := by
    have h := hδf hyδ
    rw [hA y hyA, hfx, hyx, map_smul, ← smul_sub, norm_smul, norm_smul,
      Real.norm_of_nonneg hlampos.le, mul_left_comm] at h
    calc ‖u - L u‖ ≤ η * ‖u‖ := le_of_mul_le_mul_left h hlampos
      _ ≤ η * C := mul_le_mul_of_nonneg_left huC hηpos.le
      _ = ε / 2 := hηC
  -- Step 6: `|Lv − v| ≤ |L(v − u)| + |Lu − u| + |u − v| ≤ Ks + ε/2 ≤ ε`
  have hLvu : ‖L v - L u‖ ≤ ‖L‖ * ‖u - v‖ := by
    calc ‖L v - L u‖ = ‖L (v - u)‖ := by rw [map_sub]
      _ ≤ ‖L‖ * ‖v - u‖ := L.le_opNorm _
      _ = ‖L‖ * ‖u - v‖ := by rw [norm_sub_rev]
  calc ‖L v - v‖ = ‖(L v - L u) + (L u - u) + (u - v)‖ := by congr 1; abel
    _ ≤ ‖L v - L u‖ + ‖L u - u‖ + ‖u - v‖ := norm_add₃_le
    _ ≤ ‖L‖ * ‖u - v‖ + ε / 2 + ‖u - v‖ := by rw [norm_sub_rev (L u) u]; linarith
    _ = K * ‖u - v‖ + ε / 2 := by rw [hK]; ring
    _ ≤ K * s + ε / 2 := by linarith [mul_le_mul_of_nonneg_left huv.le hKpos.le]
    _ ≤ ε := by linarith
/-- **Simon 6.1.1, 6.1.7** (step 7 of the local comparison in the proof of 7.3.1): if `ξ` is a unit
orientation of `Q` and the continuous linear map `L` fixes `Q` pointwise, then
`⟨α ∘ ΛⁿL, ξ⟩ = ⟨α, ξ⟩` for every `n`-covector `α`.  Write `⟨β, ξ⟩ = ±β(τ₁, …, τₙ)` with `τ`
spanning `Q`; each `τᵢ ∈ Q`, so `L ∘ τ = τ` and `(α ∘ ΛⁿL)(τ) = α(L ∘ τ) = α(τ)`. -/
theorem Submission.dtc_bc_lc_unitOrientation_comp_eq : ∀ (P n : ℕ) (ξ : MultiVector P n) (Q : Submodule ℝ (Euclid P)) (L : Euclid P →L[ℝ] Euclid P), IsUnitOrientationOf ξ Q → (∀ v ∈ Q, L v = v) → ∀ α : Covector (Euclid P) n, ξ (α.compContinuousLinearMap L) = ξ α := by
  intro P n ξ Q L hξ hL α
  obtain ⟨τ, -, hspan, hsign⟩ := hξ
  -- each `τᵢ` lies in `Q = span (range τ)`, so `L ∘ τ = τ`
  have hLτ : ⇑L ∘ τ = τ := by
    funext i
    exact hL (τ i) (hspan ▸ Submodule.subset_span (mem_range_self i))
  -- `(α ∘ ΛⁿL)(τ) = α(L ∘ τ) = α(τ)`
  have hτ : α.compContinuousLinearMap L τ = α τ := by
    rw [ContinuousAlternatingMap.compContinuousLinearMap_apply, hLτ]
  rcases hsign with h | h <;> rw [h, h, hτ]

/-- **Simon 6.3.2(3)** (with 6.2.4–6.2.8): for `T = τ(M, θ, ξ)` in `U` and open `W ⊆ U`,
`M_W(T) = μ_T(W) = ∫_{M ∩ W} θ dHⁿ`.  Upper bound: for admissible `ω`, `|⟨ω, ξ⟩| ≤ |ω| ≤ 1_W`
`Hⁿ`-a.e. on `M`, so `T(ω) ≤ μ_T(W)`.  Lower bound on a compact `K ⊆ W`, then exhaust `W`: with
`L` the dual of `dor_ims_unitOrientation_dual` (`|L(ξ)| ≤ 1`, `⟨L(ξ), ξ⟩ = 1`), approximate
`f = 1_K L(ξ)` in `L¹(μ_T⌞K_δ)` by a continuous compactly supported `g`, truncate to
`β = g / max(1, |g|)` (so `|β - f| ≤ 2|g - f|`), smooth to `h` with `‖h - β‖ < δ`, and take
`ω = χ h / (1 + Cδ)`, `χ ∈ C^∞`, `χ = 1` on `K`, `spt χ ⊆ K_δ`: `ω` is admissible and
`T(ω) ≥ μ_T(K) - ε`. -/
theorem Submission.dtc_mass_eq_measure : ∀ (P n : ℕ) (U W : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → IsOpen W → W ⊆ U → R.Represents T → T.massOn W = R.measure W := by
  intro P n U W T R _ hW hWU hRT
  obtain ⟨L, hL⟩ := Submission.dor_ims_unitOrientation_dual P n
  -- `L` is bounded on the unit ball (continuity at `0`)
  obtain ⟨B, hB⟩ : ∃ B : ℝ, ∀ ξ : MultiVector P n, ‖ξ‖ ≤ 1 → ‖L ξ‖ ≤ B := by
    have hcont : ∀ ε > 0, ∃ δ > 0, ∀ {x : MultiVector P n}, dist x 0 < δ →
        dist (L x) (L 0) < ε :=
      Metric.continuousAt_iff.1 (L.continuous.continuousAt (x := 0))
    obtain ⟨δ, hδ, hδL⟩ := hcont 1 one_pos
    refine ⟨2 / δ, fun ξ hξ => ?_⟩
    have hsm : ‖(δ / 2) • ξ‖ ≤ δ / 2 := by
      refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) fun α => ?_
      rw [smul_apply, norm_smul, Real.norm_of_nonneg (by positivity)]
      gcongr
      calc ‖ξ α‖ ≤ ‖ξ‖ * ‖α‖ := ξ.le_opNorm α
        _ ≤ 1 * ‖α‖ := by gcongr
        _ = ‖α‖ := one_mul _
    have h1 : dist ((δ / 2) • ξ) 0 < δ := by
      rw [dist_zero_right (E := MultiVector P n) _]
      linarith
    have h3 : dist (L ((δ / 2) • ξ)) (L 0) < 1 := hδL h1
    rw [map_smul, map_zero, dist_zero_right, norm_smul, Real.norm_of_nonneg (by positivity)] at h3
    rw [le_div_iff₀ hδ]
    nlinarith [norm_nonneg (L ξ)]
  -- `|α| = ‖c α‖` for the linear coefficient map `c α = (α(e_I))_I` (`I` strictly increasing)
  let e := EuclideanSpace.basisFun (Fin P) ℝ
  let c : Covector (Euclid P) n →ₗ[ℝ] EuclideanSpace ℝ (Fin n → Fin P) :=
    { toFun := fun α => WithLp.toLp 2 fun I => if StrictMono I then α (fun i => e (I i)) else 0
      map_add' := fun α β => by
        ext I
        simp only [ContinuousAlternatingMap.add_apply, PiLp.add_apply]
        split_ifs <;> simp
      map_smul' := fun a α => by
        ext I
        simp only [ContinuousAlternatingMap.smul_apply, PiLp.smul_apply, RingHom.id_apply]
        split_ifs <;> simp }
  have hc : ∀ α, covectorEuclideanNorm α = ‖c α‖ := by
    intro α
    rw [← Real.sqrt_sq (norm_nonneg (c α)), EuclideanSpace.real_norm_sq_eq]
    unfold covectorEuclideanNorm
    congr 1
    refine Finset.sum_congr rfl fun I _ => ?_
    simp only [c, LinearMap.coe_mk, AddHom.coe_mk]
    split_ifs <;> simp [e]
  -- `|α| ≤ C ‖α‖`, since each coefficient is bounded by the operator norm
  set C : ℝ := √(Fintype.card (Fin n → Fin P)) + 1
  have hCpos : 0 < C := by positivity
  have hN3 : ∀ α, ‖c α‖ ≤ C * ‖α‖ := by
    intro α
    rw [EuclideanSpace.norm_eq]
    calc √(∑ I, ‖(c α) I‖ ^ 2) ≤ √(∑ _I : Fin n → Fin P, ‖α‖ ^ 2) := by
          refine Real.sqrt_le_sqrt (Finset.sum_le_sum fun I _ => ?_)
          refine pow_le_pow_left₀ (norm_nonneg _) ?_ 2
          simp only [c, LinearMap.coe_mk, AddHom.coe_mk]
          split_ifs
          · calc ‖α (fun i => e (I i))‖ ≤ ‖α‖ * ∏ i, ‖e (I i)‖ := α.le_opNorm _
              _ = ‖α‖ := by
                rw [Finset.prod_eq_one (fun i _ => e.orthonormal.norm_eq_one (I i)), mul_one]
          · simp
      _ = √(Fintype.card (Fin n → Fin P)) * ‖α‖ := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, Real.sqrt_mul (Nat.cast_nonneg _),
            Real.sqrt_sq (norm_nonneg _)]
      _ ≤ C * ‖α‖ := by
          gcongr
          linarith
  have hcc : Continuous c := AddMonoidHomClass.continuous_of_bound c C hN3
  have hNc : Continuous fun α : Covector (Euclid P) n => covectorEuclideanNorm α := by
    simp only [hc]
    exact hcc.norm
  have hNtri : ∀ α β : Covector (Euclid P) n,
      covectorEuclideanNorm (α + β) ≤ covectorEuclideanNorm α + covectorEuclideanNorm β := by
    intro α β
    rw [hc, hc, hc, map_add]
    exact norm_add_le _ _
  have hNsmul : ∀ (r : ℝ) (α : Covector (Euclid P) n),
      covectorEuclideanNorm (r • α) = |r| * covectorEuclideanNorm α := by
    intro r α
    rw [hc, hc, map_smul, norm_smul, Real.norm_eq_abs]
  -- truncation `v ↦ v / max(1, |v|)` moves `v` by at most `|v - w|` towards any `|w| ≤ 1`
  have htrunc : ∀ v w : Covector (Euclid P) n, covectorEuclideanNorm w ≤ 1 →
      covectorEuclideanNorm ((max 1 (covectorEuclideanNorm v))⁻¹ • v - w) ≤
        2 * covectorEuclideanNorm (v - w) := by
    intro v w hw
    rcases le_total (covectorEuclideanNorm v) 1 with hv | hv
    · rw [max_eq_left hv, inv_one, one_smul]
      linarith [covectorEuclideanNorm_nonneg (v - w)]
    · rw [max_eq_right hv]
      have hvpos : 0 < covectorEuclideanNorm v := one_pos.trans_le hv
      have e1 : covectorEuclideanNorm ((covectorEuclideanNorm v)⁻¹ • v - v) =
          covectorEuclideanNorm v - 1 := by
        rw [show (covectorEuclideanNorm v)⁻¹ • v - v = ((covectorEuclideanNorm v)⁻¹ - 1) • v by
          module, hNsmul,
          abs_of_nonpos (sub_nonpos.2 (inv_le_one_of_one_le₀ hv)), neg_sub, sub_mul, one_mul,
          inv_mul_cancel₀ hvpos.ne']
      have e2 : covectorEuclideanNorm v ≤
          covectorEuclideanNorm (v - w) + covectorEuclideanNorm w := by
        calc covectorEuclideanNorm v = covectorEuclideanNorm ((v - w) + w) := by
              rw [sub_add_cancel]
          _ ≤ _ := hNtri _ _
      calc covectorEuclideanNorm ((covectorEuclideanNorm v)⁻¹ • v - w)
          = covectorEuclideanNorm (((covectorEuclideanNorm v)⁻¹ • v - v) + (v - w)) := by
            rw [sub_add_sub_cancel]
        _ ≤ _ := hNtri _ _
        _ ≤ 2 * covectorEuclideanNorm (v - w) := by rw [e1]; linarith
  -- good points: `ξ(x)` is a unit orientation of the approximate tangent plane
  have hgood : ∀ᵐ x ∂(μHE[n].restrict R.carrier),
      (∀ α, |R.orient x α| ≤ covectorEuclideanNorm α) ∧
      covectorEuclideanNorm (L (R.orient x)) ≤ 1 ∧ R.orient x (L (R.orient x)) = 1 ∧
      ‖R.orient x‖ ≤ 1 := by
    filter_upwards [R.orients] with x hx
    obtain ⟨Q, -, hQ⟩ := hx
    obtain ⟨h1, h2, h3⟩ := hL _ Q hQ
    exact ⟨h1, h2, h3, (Submission.imsupp_unit_orientation_ne_zero_norm_le_one P n _ Q hQ).2⟩
  have hac : R.measure ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
  have hgoodμ := hac.ae_le hgood
  -- `T(ω) = ∫ ⟨ω, ξ⟩ dμ` for `μ = θ Hⁿ⌞M`
  have hθ : Measurable fun x => (R.mult x : NNReal) :=
    measurable_from_nat.comp R.measurable_mult
  have hT : ∀ ω : TestFormOn U n,
      T ω = ∫ x, R.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂R.measure := by
    intro ω
    rw [hRT ω, IMRep.action, IMRep.measure]
    have : (fun x => (R.mult x : ℝ≥0∞)) = fun x => ((R.mult x : NNReal) : ℝ≥0∞) := by
      funext x
      simp
    rw [this, integral_withDensity_eq_integral_smul hθ]
    congr 1
  apply le_antisymm
  · -- upper bound: `T(ω) ≤ ∫ |ω| dμ ≤ μ(W)` for admissible `ω`
    apply sSup_le
    rintro _ ⟨ω, ⟨hωW, hω1⟩, rfl⟩
    dsimp only
    rw [hT ω]
    calc ENNReal.ofReal (∫ x, R.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂R.measure)
        ≤ ‖∫ x, R.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂R.measure‖ₑ := by
          rw [Real.enorm_eq_ofReal_abs]
          exact ENNReal.ofReal_le_ofReal (le_abs_self _)
      _ ≤ ∫⁻ x, ‖R.orient x ((ω : DifferentialForm (Euclid P) n) x)‖ₑ ∂R.measure :=
          enorm_integral_le_lintegral_enorm _
      _ ≤ ∫⁻ x, W.indicator 1 x ∂R.measure := by
          apply lintegral_mono_ae
          filter_upwards [hgoodμ] with x hx
          by_cases hxW : x ∈ W
          · rw [indicator_of_mem hxW, Pi.one_apply, Real.enorm_eq_ofReal_abs]
            exact ENNReal.ofReal_le_one.2 ((hx.1 _).trans (hω1 x))
          · have : (ω : DifferentialForm (Euclid P) n) x = 0 :=
              image_eq_zero_of_notMem_tsupport fun h => hxW (hωW h)
            rw [this, map_zero, enorm_zero]
            exact zero_le
      _ = R.measure W := lintegral_indicator_one hW.measurableSet
  · -- lower bound on a compact `K ⊆ W`: an admissible `ω ≈ 1_K L(ξ)` with `T(ω) ≥ μ(K) - ε`
    have hcompact : ∀ K : Set (Euclid P), IsCompact K → K ⊆ W → R.measure K ≤ T.massOn W := by
      intro K hK hKW
      obtain ⟨δ₀, hδ₀, hδ₀W⟩ := hK.exists_cthickening_subset_open hW hKW
      have hKV : K ⊆ thickening δ₀ K := self_subset_thickening hδ₀ K
      have hμC : R.measure (cthickening δ₀ K) < ∞ := by
        rw [IMRep.measure, withDensity_apply _ isClosed_cthickening.measurableSet,
          Measure.restrict_restrict isClosed_cthickening.measurableSet, inter_comm]
        exact lt_top_iff_ne_top.2
          (R.locallyIntegrable_mult _ hK.cthickening (hδ₀W.trans hWU))
      have hμV : R.measure (thickening δ₀ K) < ∞ :=
        (measure_mono (thickening_subset_cthickening δ₀ K)).trans_lt hμC
      have hμK : R.measure K < ∞ := (measure_mono hKV).trans_lt hμV
      -- `ν = μ⌞V`, `V = K_{δ₀}`, is finite
      set V := thickening δ₀ K
      set ν := R.measure.restrict V with hν
      have : IsFiniteMeasure ν := isFiniteMeasure_restrict.2 hμV.ne
      have hgoodν := ae_restrict_of_ae (s := V) hgoodμ
      have hacν : ν ≪ μHE[n].restrict R.carrier :=
        (Measure.absolutelyContinuous_of_le Measure.restrict_le_self).trans hac
      have hξν : AEStronglyMeasurable R.orient ν := R.aestronglyMeasurable_orient.mono_ac hacν
      have hev : Continuous fun p : MultiVector P n × Covector (Euclid P) n => p.1 p.2 :=
        isBoundedBilinearMap_apply.continuous
      have hevalm : ∀ v : Euclid P → Covector (Euclid P) n, AEStronglyMeasurable v ν →
          AEStronglyMeasurable (fun x => R.orient x (v x)) ν := fun v hv =>
        (hev.comp_aestronglyMeasurable (hξν.prodMk hv) :)
      -- the target `f = 1_K L(ξ)`: `|f| ≤ 1` and `ξ(f) = 1_K` a.e.
      set f : Euclid P → Covector (Euclid P) n := K.indicator fun x => L (R.orient x) with hf
      have hfm : AEStronglyMeasurable f ν :=
        (L.continuous.comp_aestronglyMeasurable hξν).indicator hK.measurableSet
      have hfi : Integrable f ν := by
        refine Integrable.of_bound hfm (max B 0) ?_
        filter_upwards [hgoodν] with x hx
        by_cases hxK : x ∈ K
        · rw [hf, indicator_of_mem hxK]
          exact (hB _ hx.2.2.2).trans (le_max_left _ _)
        · rw [hf, indicator_of_notMem hxK, norm_zero]
          exact le_max_right _ _
      have hf1 : ∀ᵐ x ∂ν, covectorEuclideanNorm (f x) ≤ 1 := by
        filter_upwards [hgoodν] with x hx
        by_cases hxK : x ∈ K
        · rw [hf, indicator_of_mem hxK]
          exact hx.2.1
        · rw [hf, indicator_of_notMem hxK, covectorEuclideanNorm_zero]
          exact zero_le_one
      have hfξi : Integrable (fun x => R.orient x (f x)) ν := by
        refine Integrable.of_bound (hevalm _ hfm) 1 ?_
        filter_upwards [hgoodν, hf1] with x hx hx1
        rw [Real.norm_eq_abs]
        exact (hx.1 _).trans hx1
      have hμKf : (R.measure K).toReal = ∫ x, R.orient x (f x) ∂ν := by
        have : (fun x => R.orient x (f x)) =ᵐ[ν] K.indicator 1 := by
          filter_upwards [hgoodν] with x hx
          by_cases hxK : x ∈ K
          · rw [hf, indicator_of_mem hxK, indicator_of_mem hxK, Pi.one_apply, hx.2.2.1]
          · rw [hf, indicator_of_notMem hxK, indicator_of_notMem hxK, map_zero]
        rw [integral_congr_ae this, integral_indicator_one hK.measurableSet, Measure.real, hν,
