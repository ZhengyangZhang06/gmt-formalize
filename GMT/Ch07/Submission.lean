          fderiv ℝ ζ x (EuclideanSpace.single j₀ (1 : ℝ)) + ζ x)) μ :=
      hinner _ _ hM1 (hML _ ((hcont.smul hdc).add hζ.continuous).continuousOn)
    have hS : Integrable (fun x => ∑ j : Fin m,
        ‖fderiv ℝ ζ x (EuclideanSpace.single j (1 : ℝ))‖ ^ 2) μ :=
