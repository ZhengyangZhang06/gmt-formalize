                inter_subset_right inter_subset_right)
              fun p hp => (hu_rep p ((hs p).1 hp).1 ω).1
        _ = _ := Finset.sum_congr rfl fun p hp => (hu_rep p ((hs p).1 hp).1 ω).2
  clear dfmf_cube_meas cmcdtfrsd_faces_meeting_compact_finite cmcdtfr_skeleton_null cmcdtfrsd_face_density cmcdtfrsd_skeleton_point_on_open_face dfmf_carrier_sdiff_support_null
  /- **Integer polyhedral chains are integer multiplicity** (Simon Ch. 6, 3.2(1) and §5): for
  strictly increasing faces `p ∈ s` and integers `β_p`, `Σ_p β_p [[F̆_p]]` is represented by an
  integer multiplicity triple `R`, built by induction on `s` from the triples of the single faces
  (`dfmf_face_imrep`) with the integer-combination lemmas `rsdic_exists_imrep_int_combination`,
  `rsdic_imrep_action_int_combination`.  Moreover `θ ⟨α, ξ⟩ 1_M = Σ_p β_p ⟨α, e_p⟩ 1_{F̆_p}` a.e. -/
  have dfmf_chain_imrep : ∀ (P k : ℕ) (s : Finset ((Fin k → Fin P) × (Fin P → ℤ))) (β : (Fin k → Fin P) × (Fin P → ℤ) → ℤ), (∀ p ∈ s, StrictMono p.1) → ∃ R : IMRep (univ : Set (Euclid P)) k, (∀ ω : TestFormOn (univ : Set (Euclid P)) k, R.action ω.1 = ∑ p ∈ s, (β p : ℝ) * ∫ y : Euclid k in {y | ∀ i, 0 < y i ∧ y i < 1}, ω.1 (HAdd.hAdd (WithLp.toLp 2 (fun i => (p.2 i : ℝ))) (∑ j, y j • EuclideanSpace.single (p.1 j) (1 : ℝ))) (fun j => EuclideanSpace.single (p.1 j) (1 : ℝ))) ∧ ∀ᵐ x ∂μHE[k], ∀ α : Covector (Euclid P) k, R.carrier.indicator (fun y => (R.mult y : ℝ) * R.orient y α) x = ∑ p ∈ s, (β p : ℝ) * ((fun y : Euclid k => HAdd.hAdd (WithLp.toLp 2 (fun i => (p.2 i : ℝ))) (∑ j, y j • EuclideanSpace.single (p.1 j) (1 : ℝ))) '' {y : Euclid k | ∀ i, 0 < y i ∧ y i < 1}).indicator (fun _ => α (fun j => EuclideanSpace.single (p.1 j) (1 : ℝ))) x := by
    clear cmcdtfrfg_cube_volume cmcdtfr_face_geometry cmr_cc_det_covector_basis_kronecker cmr_cc_det_covector_exists dfmf_support_boundary_subset cmcdtfr_boundary_variation cmcdtfr_chain_boundary cmcdtfr_face_integral_current cmcdtfr_finite_family cmcdtfr_skeleton_decomposition hVO hMR hIMC
    intro P k s β hs
    -- evaluation commutes with indicators
    have hev : ∀ (S : Set (Euclid P)) (f : Euclid P → MultiVector P k) (x : Euclid P)
        (α : Covector (Euclid P) k), S.indicator f x α = S.indicator (fun y => f y α) x := by
      intro S f x α
      by_cases hx : x ∈ S
      · rw [indicator_of_mem hx, indicator_of_mem hx]
      · rw [indicator_of_notMem hx, indicator_of_notMem hx, zero_apply]
    induction s using Finset.induction_on with
    | empty =>
      -- the empty triple
      refine ⟨{ carrier := ∅
                mult := fun _ => 0
                orient := fun _ => 0
                measurableSet_carrier := MeasurableSet.empty
                carrier_subset := empty_subset _
                rectifiable :=
                  Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty
                measurable_mult := measurable_const
                mult_pos := fun _ h => absurd h (notMem_empty _)
                locallyIntegrable_mult := fun K _ _ => by
                  rw [empty_inter, Measure.restrict_empty, lintegral_zero_measure]
                  exact ENNReal.zero_ne_top
                aestronglyMeasurable_orient := aestronglyMeasurable_const
                orients := by rw [Measure.restrict_empty, ae_zero]; exact Filter.eventually_bot },
        fun ω => ?_, ae_of_all _ fun x α => ?_⟩
      · exact setIntegral_empty.trans Finset.sum_empty.symm
      · rw [indicator_of_notMem (notMem_empty x), Finset.sum_empty]
    | insert p s hp ih =>
      obtain ⟨R, hRa, hRi⟩ := ih fun q hq => hs q (Finset.mem_insert_of_mem hq)
      obtain ⟨Rp, hRpc, hRpm, hRpo, -, hRpa⟩ :=
        dfmf_face_imrep P k p (hs p (Finset.mem_insert_self p s))
      -- `R' = 1 · R + β_p · R_p`
      obtain ⟨R', hR'⟩ :=
        Submission.rsdic_exists_imrep_int_combination P k univ R Rp 1 (β p) isOpen_univ
      refine ⟨R', fun ω => ?_, ?_⟩
      · rw [Submission.rsdic_imrep_action_int_combination P k univ R Rp R' 1 (β p) hR' ω, hRa ω,
          hRpa ω, Finset.sum_insert hp, Int.cast_one, one_mul, add_comm]
      · filter_upwards [hR', hRi] with x hx hxi α
        have h := congrArg (fun T : MultiVector P k => T α) hx
        simp only [add_apply, smul_apply, hev,
          smul_eq_mul, Int.cast_one, one_mul] at h
        rw [Finset.sum_insert hp, ← hxi α, ← hRpc]
        refine (show _ = _ from h).trans ?_
        rw [add_comm]
        congr 1
        congr 1
        by_cases hxp : x ∈ Rp.carrier
        · rw [indicator_of_mem hxp, indicator_of_mem hxp, hRpm, hRpo, Nat.cast_one, one_mul]
        · rw [indicator_of_notMem hxp, indicator_of_notMem hxp]
  /- **A nonzero integer polyhedral chain has mass `≥ 1`** (Simon Ch. 6, §5, after (38)).  If `R`
  satisfies `θ ⟨α, ξ⟩ 1_M = Σ_p β_p ⟨α, e_p⟩ 1_{F̆_p}` a.e. and `β_q ≠ 0`, then testing with
  `α = dx^{ι_q}` (`α(e_q) = 1`) shows that a.e. point of `F̆_q` lies in `M` (the open faces are
  disjoint, `cmcdtfr_face_geometry`), and `θ ≥ 1` on `M`; so
  `μ_R(ℝᴾ) ≥ ∫_{F̆_q} θ 1_M dHᵏ ≥ Hᵏ(F̆_q) = 1`. -/
  have dfmf_chain_mass_ge : ∀ (P k : ℕ) (s : Finset ((Fin k → Fin P) × (Fin P → ℤ))) (β : (Fin k → Fin P) × (Fin P → ℤ) → ℤ) (R : IMRep (univ : Set (Euclid P)) k), (∀ p ∈ s, StrictMono p.1) → (∀ᵐ x ∂μHE[k], ∀ α : Covector (Euclid P) k, R.carrier.indicator (fun y => (R.mult y : ℝ) * R.orient y α) x = ∑ p ∈ s, (β p : ℝ) * ((fun y : Euclid k => HAdd.hAdd (WithLp.toLp 2 (fun i => (p.2 i : ℝ))) (∑ j, y j • EuclideanSpace.single (p.1 j) (1 : ℝ))) '' {y : Euclid k | ∀ i, 0 < y i ∧ y i < 1}).indicator (fun _ => α (fun j => EuclideanSpace.single (p.1 j) (1 : ℝ))) x) → ∀ q ∈ s, β q ≠ 0 → 1 ≤ R.measure univ := by
    clear cmcdtfrfg_cube_volume dfmf_support_boundary_subset cmcdtfr_boundary_variation cmcdtfr_chain_boundary cmcdtfr_face_integral_current cmcdtfr_finite_family cmcdtfr_skeleton_decomposition dfmf_chain_imrep hVO hMR hIMC
    intro P k s β R hs hR q hq hβq
    -- the coordinate covector `θ = dx^{ι_q}`, `θ(e_{ι_q}) = 1`
    obtain ⟨θ, hθ⟩ := cmr_cc_det_covector_exists P k q.1
    clear cmr_cc_det_covector_exists
    have hθ1 : θ (fun j => EuclideanSpace.single (q.1 j) (1 : ℝ)) = 1 := by
      have h := cmr_cc_det_covector_basis_kronecker P k q.1 q.1 θ (hs q hq) (hs q hq) hθ
      rw [ite_eq_left rfl] at h
      simpa only [EuclideanSpace.basisFun_apply] using h
    -- the open face `F̆_q` (`Hᵏ(F̆_q) = 1`), disjoint from the other open faces
    clear cmr_cc_det_covector_basis_kronecker
    obtain ⟨Rq, hRqc, -, -, hRq1, -⟩ := dfmf_face_imrep P k q (hs q hq)
    clear dfmf_face_imrep
    have hdisj : ∀ p ∈ s, p ≠ q → ∀ x ∈ Rq.carrier,
        x ∉ (fun y : Euclid k => WithLp.toLp 2 (fun i => (p.2 i : ℝ)) +
          ∑ j, y j • EuclideanSpace.single (p.1 j) (1 : ℝ)) '' {y : Euclid k | ∀ i, 0 < y i ∧ y i < 1} := by
      intro p hp hpq x hx hxp
      rw [hRqc] at hx
      obtain ⟨y, hy, rfl⟩ := hx
      obtain ⟨y', hy', hyy'⟩ := hxp
      beta_reduce at hyy'
      rcases ((cmcdtfr_face_geometry P k).2 q p (hs q hq) (hs p hp)).2.2 (Ne.symm hpq) y y'
          hy (fun i => ⟨(hy' i).1.le, (hy' i).2.le⟩) with h | ⟨j, hj⟩
      · rw [hyy', dist_self] at h
        exact absurd h (by norm_num)
      · rw [hyy', dist_self] at hj
        exact absurd hj (not_le.2 (lt_min (hy j).1 (sub_pos.2 (hy j).2)))
    -- a.e. point of `F̆_q` lies in `M`: there `θ ⟨dx^{ι_q}, ξ⟩ 1_M = β_q ≠ 0`
    clear cmcdtfr_face_geometry
    have hae : ∀ᵐ x ∂(μHE[k].restrict Rq.carrier), x ∈ R.carrier := by
      filter_upwards [ae_restrict_of_ae hR, ae_restrict_mem Rq.measurableSet_carrier] with x hx hxq
      by_contra hxM
      have h := hx θ
      rw [indicator_of_notMem hxM, Finset.sum_eq_single q (fun p hp hpq => by
          rw [indicator_of_notMem (hdisj p hp hpq x hxq), mul_zero]) (fun h => absurd hq h)] at h
      rw [hRqc] at hxq
      rw [indicator_of_mem hxq, hθ1, mul_one] at h
      exact hβq (Int.cast_eq_zero.1 h.symm)
    -- `μ_R(ℝᴾ) ≥ μ_R(F̆_q) = ∫_{F̆_q} θ 1_M dHᵏ ≥ Hᵏ(F̆_q) = 1`
    calc (1 : ℝ≥0∞) = ∫⁻ _ in Rq.carrier, 1 ∂μHE[k] := by rw [setLIntegral_one, hRq1]
      _ ≤ ∫⁻ x in Rq.carrier, R.carrier.indicator (fun y => (R.mult y : ℝ≥0∞)) x ∂μHE[k] := by
          refine lintegral_mono_ae (hae.mono fun x hxM => ?_)
          rw [indicator_of_mem hxM]
          exact Nat.one_le_cast.2 (R.mult_pos x hxM)
      _ = R.measure Rq.carrier := by
          rw [lintegral_indicator R.measurableSet_carrier, IMRep.measure,
            withDensity_apply _ Rq.measurableSet_carrier,
            Measure.restrict_restrict R.measurableSet_carrier,
            Measure.restrict_restrict Rq.measurableSet_carrier, inter_comm]
      _ ≤ R.measure univ := measure_mono (subset_univ _)
  clear cmr_cc_det_covector_basis_kronecker cmr_cc_det_covector_exists dfmf_face_imrep
  -- the assembly (Simon Ch. 6, 5.1, displays (26)–(37))
  intro P m
  -- support and mass calculus for currents in `ℝᴾ`: `spt(A − B) ⊆ spt A ∪ spt B`,
  -- `spt ∂A ⊆ spt A` and `M(A − B) ≤ M(A) + M(B)`
  have hspt_sub : ∀ A B : GeometricCurrentOn (univ : Set (Euclid P)) m,
      (A - B).support ⊆ A.support ∪ B.support := by
    intro A B x hx
    simp only [GeometricCurrentOn.support, Set.mem_sdiff, mem_union, mem_univ, true_and] at hx ⊢
    by_contra h
    rw [not_or, not_not, not_not] at h
    apply hx
    obtain ⟨hA, hB⟩ := h
    simp only [GeometricCurrentOn.zeroRegion, mem_sUnion, mem_ofPred_eq] at hA hB ⊢
    obtain ⟨W₁, ⟨hW₁o, hW₁c, -, hW₁v⟩, hxW₁⟩ := hA
    obtain ⟨W₂, ⟨hW₂o, -, -, hW₂v⟩, hxW₂⟩ := hB
    refine ⟨W₁ ∩ W₂, ⟨hW₁o.inter hW₂o,
      hW₁c.of_isClosed_subset isClosed_closure (closure_mono inter_subset_left), subset_univ _,
      fun ω hω => ?_⟩, hxW₁, hxW₂⟩
    show A ω - B ω = 0
    rw [hW₁v ω (hω.trans inter_subset_left), hW₂v ω (hω.trans inter_subset_right), sub_zero]
  have hmass_sub : ∀ A B : GeometricCurrentOn (univ : Set (Euclid P)) m,
      (A - B).mass ≤ A.mass + B.mass := by
    intro A B
    refine sSup_le ?_
    rintro _ ⟨ω, hω, rfl⟩
    have h2 : ENNReal.ofReal (B (-ω)) ≤ B.mass := B.le_massOn
      ⟨subset_univ _, fun x => (covectorEuclideanNorm_neg _).trans_le (hω.2 x)⟩
    rw [map_neg B.toCurrent ω] at h2
    exact (ENNReal.ofReal_le_ofReal (sub_eq_add_neg _ _).le).trans
      (ENNReal.ofReal_add_le.trans (add_le_add (A.le_massOn hω) h2))
  -- `c_B` from the cube BV median lemma and `c := max(2, 1 + c_B)`
  obtain ⟨cB, hcB, hmedian⟩ := Submission.dtc_bc_tc_cl_dfm_cube_bv_median m
  refine ⟨Real.toNNReal (max 2 (1 + cB)),
    Real.one_le_toNNReal.2 (le_max_of_le_left one_le_two), fun K Λ hK => ?_⟩
  -- `𝒬₀`: the integer chains `Σ β_F [[F]]` on faces meeting `K` with `Σ|β_F| ≤ 2Λ`
  refine ⟨_, cmcdtfr_finite_family P (m + 1) K (2 * (Λ : ℝ)) hK, ?_⟩
  intro Q₀ hQ₀ hQ₀K hQ₀L hQ₀Λ hQ₀b
  -- `Q₀ = Σ_F ũ_F [[F̆]]` over the open faces `F̆` meeting `spt Q₀`
  obtain ⟨s, u, hs, huZ, huI, hSu, huspt, hQ₀rep⟩ :=
    cmcdtfr_skeleton_decomposition P m K Q₀ hK hQ₀ hQ₀K hQ₀L
  -- the variations `V_F` of the `ũ_F`, with `Σ_F V_F ≤ M(∂Q₀)`
  obtain ⟨V, hV0, hSV, hVbd, hVspt⟩ :=
    cmcdtfr_boundary_variation P m s u Q₀ hs huI hQ₀rep hQ₀b
  -- integer medians `β_F` of the `ũ_F` (`cube_bv_median`)
  choose! β hβ using fun p (hp : p ∈ s) => hmedian (u p) (V p) (huZ p hp) (huI p hp) (hVbd p hp)
  -- the face currents with densities `β_F` (this is `Pc`), `ũ_F` and `ũ_F − β_F`
  have hcube := cmcdtfrfg_cube_volume (m + 1)
  have hβI : ∀ p ∈ s, IntegrableOn (fun _ : Euclid (m + 1) => (β p : ℝ))
      {y | ∀ i, 0 < y i ∧ y i < 1} (volume : Measure (Euclid (m + 1))) := fun p _ =>
    integrableOn_const (hcube.trans_ne ENNReal.one_ne_top) enorm_ne_top
  -- `Pc = Σ_F β_F [[F]]`: the current of the integer multiplicity triple of `Σ_F β_F [[F]]`
  obtain ⟨RP, hRPact, hRPind⟩ := dfmf_chain_imrep P (m + 1) s β hs
  obtain ⟨Pc, hPc⟩ := Submission.dtc_imrep_current P (m + 1) univ RP
  have hPcrep := fun ω => (hPc ω).trans (hRPact ω)
  -- the face currents with densities `β_F`, `ũ_F` and `ũ_F − β_F`
  have hβD := cmcdtfr_face_integral_current P m s (fun p _ => (β p : ℝ)) hs hβI
  have huω := (cmcdtfr_face_integral_current P m s u hs huI).1
  have hdD := (cmcdtfr_face_integral_current P m s
    (fun p y => u p y - (β p : ℝ)) hs fun p hp => (huI p hp).sub (hβI p hp)).2
  -- `Pc = 0`, or some `β_F ≠ 0` and `M(Pc) = μ_RP(ℝᴾ) ≥ 1` by (MR) (`dfmf_chain_mass_ge`)
  have hPc01 : Pc = 0 ∨ 1 ≤ Pc.mass := by
    by_cases h : ∃ q ∈ s, β q ≠ 0
    · obtain ⟨q, hq, hβq⟩ := h
      exact Or.inr ((dfmf_chain_mass_ge P (m + 1) s β RP hs hRPind q hq hβq).trans_eq
        (hMR P (m + 1) univ Pc RP isOpen_univ hPc univ isOpen_univ).symm)
    · refine Or.inl (GeometricCurrentOn.ext fun ω => ?_)
      rw [hPcrep ω, GeometricCurrentOn.zero_apply]
      refine Finset.sum_eq_zero fun p hp => ?_
      rw [show β p = 0 from not_not.1 fun hβ => h ⟨p, hp, hβ⟩, Int.cast_zero, zero_mul]
  -- integrality of `∂Pc` (cubical Stokes)
  obtain ⟨s', β', hs', hPcbrep⟩ := cmcdtfr_chain_boundary P m s β Pc hs hPcrep
  obtain ⟨RB, hRBact, -⟩ := dfmf_chain_imrep P m s' β' hs'
  have hPcbIM : IsIntegerMultiplicity Pc.boundary :=
    ⟨RB, fun γ => (hPcbrep γ).trans (hRBact γ).symm⟩
  -- mass and support bounds for `Pc` and `Q₀ − Pc` from their face densities
  have hPcD := hβD.2 Pc fun ω =>
    (hPcrep ω).trans (Finset.sum_congr rfl fun p _ => (integral_const_mul _ _).symm)
  -- `M(Pc) ≤ Σ_F ∫_{Q₁} |β_F| = Σ_F |β_F|`
  have hPcmass : Pc.mass ≤ ENNReal.ofReal (∑ p ∈ s, |(β p : ℝ)|) := by
    refine hPcD.1.trans_eq (congrArg ENNReal.ofReal (Finset.sum_congr rfl fun p _ => ?_))
    rw [setIntegral_const, measureReal_def, hcube, ENNReal.toReal_one, one_smul]
  -- `Q₀ − Pc = Σ_F (ũ_F − β_F) [[F̆]]`
  have hdD' := hdD (Q₀ - Pc) fun ω => by
    show Q₀ ω - Pc ω = _
    rw [hQ₀rep ω, hPcrep ω, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun p hp => ?_
    rw [← integral_const_mul, ← integral_sub (huω ω p hp) (hβD.1 ω p hp)]
    exact integral_congr_ae (ae_of_all _ fun y => (sub_mul _ _ _).symm)
  have hdb := hdD'.2.1 (fun p => cB * V p) fun p hp G hG hG1 => (hβ p hp).2.2 G hG hG1
  -- `Σ|β_F| ≤ 2 Σ_F ∫|ũ_F| ≤ 2Λ`, `Σ_F ∫|ũ_F − β_F| ≤ c_B Σ_F V_F`
  have hβsum : ∑ p ∈ s, |(β p : ℝ)| ≤
      2 * ∑ p ∈ s, ∫ y : Euclid (m + 1) in {y | ∀ i, 0 < y i ∧ y i < 1}, |u p y| := by
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum fun p hp => (hβ p hp).2.1
  have hSuΛ : ∑ p ∈ s, ∫ y : Euclid (m + 1) in {y | ∀ i, 0 < y i ∧ y i < 1}, |u p y| ≤
      (Λ : ℝ) := by
    have h := hSu.trans hQ₀Λ
    rw [← ENNReal.ofReal_coe_nnreal] at h
    exact (ENNReal.ofReal_le_ofReal_iff Λ.coe_nonneg).1 h
  have hdsum : ∑ p ∈ s, ∫ y : Euclid (m + 1) in {y | ∀ i, 0 < y i ∧ y i < 1},
      |u p y - (β p : ℝ)| ≤ cB * ∑ p ∈ s, V p := by
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum fun p hp => (hβ p hp).1
  have hdb' : (Q₀ - Pc).boundary.mass ≤ ENNReal.ofReal cB * Q₀.boundary.mass := by
    calc (Q₀ - Pc).boundary.mass ≤ ENNReal.ofReal (∑ p ∈ s, cB * V p) := hdb
      _ = ENNReal.ofReal cB * ENNReal.ofReal (∑ p ∈ s, V p) := by
          rw [← Finset.mul_sum, ENNReal.ofReal_mul hcB.le]
      _ ≤ ENNReal.ofReal cB * Q₀.boundary.mass := mul_le_mul' le_rfl hSV
  -- `∂Pc = ∂Q₀ − ∂(Q₀ − Pc)`
  have hPcb_eq : Pc.boundary = Q₀.boundary - (Q₀ - Pc).boundary :=
    GeometricCurrentOn.ext fun γ => (sub_sub_cancel _ _).symm
  -- supports: a face carrying `Pc` meets `spt Q₀`, a face carrying `Q₀ − Pc` meets `spt ∂Q₀`
  -- (there `V_F ≠ 0`), and a face has diameter `≤ √P`
  have hdiam := fun p (hp : p ∈ s) =>
    ((cmcdtfr_face_geometry P (m + 1)).2 p p (hs p hp) (hs p hp)).2.1
  have hPcsupp : Pc.support ⊆ cthickening (Real.sqrt P) Q₀.support := by
    intro x hx
    obtain ⟨p, hp, -, y, hy, rfl⟩ := hPcD.2.2 x hx
    obtain ⟨y', hy', hy'Q⟩ := huspt p hp
    exact mem_cthickening_of_dist_le _ _ _ _ hy'Q (hdiam p hp y y' hy hy')
  have hdsupp : (Q₀ - Pc).support ⊆ cthickening (Real.sqrt P) Q₀.boundary.support := by
    intro x hx
    obtain ⟨p, hp, hne, y, hy, rfl⟩ := hdD'.2.2 x hx
    have hVp : V p ≠ 0 := fun h0 => hne (le_antisymm ((hβ p hp).1.trans_eq
      (by rw [h0, mul_zero])) (integral_nonneg fun y => abs_nonneg _))
    obtain ⟨y', hy', hy'Q⟩ := hVspt p hp hVp
    exact mem_cthickening_of_dist_le _ _ _ _ hy'Q (hdiam p hp y y' hy hy')
  have hPcbsupp : Pc.boundary.support ⊆ cthickening (Real.sqrt P) Q₀.boundary.support := by
    intro x hx
    rw [hPcb_eq] at hx
    rcases hspt_sub _ _ hx with h | h
    · exact self_subset_cthickening _ h
    · exact hdsupp (dfmf_support_boundary_subset P m _ h)
  refine ⟨Pc, ?_, ⟨RP, hPc⟩, hPcbIM, hPc01, ?_, ?_, ?_, hPcsupp, union_subset hdsupp hPcbsupp⟩
  · -- `Pc ∈ 𝒬₀`
    rw [Set.mem_ofPred_eq]
    refine ⟨s, β, hs, fun p hp => ?_, hβsum.trans (mul_le_mul_of_nonneg_left hSuΛ zero_le_two),
      hPcrep⟩
    obtain ⟨y, hy, hyQ⟩ := huspt p hp
    exact ⟨y, hy, hQ₀K hyQ⟩
  · -- `M(Pc) ≤ Σ|β_F| ≤ 2M(Q₀)`
    show Pc.mass ≤ ENNReal.ofReal (max 2 (1 + cB)) * Q₀.mass
    calc Pc.mass ≤ ENNReal.ofReal (∑ p ∈ s, |(β p : ℝ)|) := hPcmass
      _ ≤ ENNReal.ofReal (2 * _) := ENNReal.ofReal_le_ofReal hβsum
      _ = ENNReal.ofReal 2 * ENNReal.ofReal _ := ENNReal.ofReal_mul zero_le_two
      _ ≤ ENNReal.ofReal (max 2 (1 + cB)) * Q₀.mass :=
          mul_le_mul' (ENNReal.ofReal_le_ofReal (le_max_left _ _)) hSu
  · -- `M(∂Pc) ≤ M(∂Q₀) + M(∂(Q₀ − Pc)) ≤ (1 + c_B)M(∂Q₀)`
    show Pc.boundary.mass ≤ ENNReal.ofReal (max 2 (1 + cB)) * Q₀.boundary.mass
    rw [hPcb_eq]
    calc _ ≤ Q₀.boundary.mass + ENNReal.ofReal cB * Q₀.boundary.mass :=
          (hmass_sub _ _).trans (add_le_add le_rfl hdb')
      _ = ENNReal.ofReal (1 + cB) * Q₀.boundary.mass := by
          rw [ENNReal.ofReal_add zero_le_one hcB.le, ENNReal.ofReal_one, add_mul, one_mul]
      _ ≤ _ := mul_le_mul' (ENNReal.ofReal_le_ofReal (le_max_right _ _)) le_rfl
  · -- `M(Q₀ − Pc) ≤ Σ_F ∫|ũ_F − β_F| ≤ c_B M(∂Q₀)`
    show (Q₀ - Pc).mass ≤ ENNReal.ofReal (max 2 (1 + cB)) * Q₀.boundary.mass
    calc (Q₀ - Pc).mass ≤ ENNReal.ofReal _ := hdD'.1
      _ ≤ ENNReal.ofReal (cB * ∑ p ∈ s, V p) := ENNReal.ofReal_le_ofReal hdsum
      _ = ENNReal.ofReal cB * ENNReal.ofReal (∑ p ∈ s, V p) := ENNReal.ofReal_mul hcB.le
      _ ≤ ENNReal.ofReal (max 2 (1 + cB)) * Q₀.boundary.mass :=
          mul_le_mul' (ENNReal.ofReal_le_ofReal
            ((le_add_of_nonneg_left zero_le_one).trans (le_max_right _ _))) hSV

/-- **Simon Ch. 6, 6.1 (Isoperimetric Theorem)**, from the scaled deformation theorem 5.3 in the
frozen form (DTr), with constant `c ≥ 1` for `(P, m)`, `m + 1 < P`.  Let `Z ∈ 𝒟_{m+1}(ℝᴾ)` be
integer multiplicity with `spt Z` compact, `∂Z = 0` and `z = M(Z) < ∞`.  Apply (DTr) to `T = Z`
with `ρ = (2cz)^{1/(m+1)}` (`ρ = 1` if `z = 0`).  A current of zero mass is zero (test `±sω` with
`s‖ω‖_∞ ≤ 1`), so `M(S) ≤ cρ M(∂Z) = 0` gives `S = 0`, and `M(Q) ≤ cz < ρ^{m+1}` excludes the
second alternative, so `Q = 0` and `Z = ∂R`.  Then `Y = R` has the mass and support bounds of
(DTr); if `z = 0`, also `M(R) = 0`, so `spt R = ∅`. -/
theorem Submission.dtc_bc_tc_cl_dfm_isoperimetric_filling : (∀ (P m : ℕ), m + 1 < P → ∃ c : NNReal, 1 ≤ c ∧ ∀ (ρ : ℝ) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 0 < ρ → IsIntegerMultiplicity T → IsCompact T.support → T.mass < ∞ → T.boundary.mass < ∞ → ∃ (Q : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q ∧ IsIntegerMultiplicity Q.boundary ∧ IsIntegerMultiplicity R ∧ T - Q - S = R.boundary ∧ (Q = 0 ∨ ENNReal.ofReal (ρ ^ (m + 1)) ≤ Q.mass) ∧ Q.mass ≤ c * T.mass ∧ Q.boundary.mass ≤ c * T.boundary.mass ∧ R.mass ≤ c * ENNReal.ofReal ρ * T.mass ∧ S.mass ≤ c * ENNReal.ofReal ρ * T.boundary.mass ∧ Q.support ∪ R.support ⊆ thickening (3 * Real.sqrt P * ρ) T.support ∧ Q.boundary.support ∪ S.support ⊆ thickening (3 * Real.sqrt P * ρ) T.boundary.support) → ∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 1 ≤ c ∧ ∀ Z : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Z → IsCompact Z.support → Z.boundary = 0 → Z.mass < ∞ → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2), IsIntegerMultiplicity Y ∧ Y.boundary = Z ∧ Y.mass ≤ ENNReal.ofReal (c * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1)) * Z.mass.toReal) ∧ Y.support ⊆ thickening (3 * Real.sqrt P * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1))) Z.support := by
  intro hDT P m hPm
  obtain ⟨c, hc1, hDT⟩ := hDT P m hPm
  refine ⟨(c : ℝ), by exact_mod_cast hc1, ?_⟩
  intro Z hZ hZc hZb hZm
  -- `M(0) = 0` and `spt 0 = ∅`
  have hmass0 : ∀ k : ℕ, (0 : GeometricCurrentOn (univ : Set (Euclid P)) k).mass = 0 := by
    intro k
    refine le_antisymm (sSup_le ?_) zero_le
    rintro _ ⟨ω, -, rfl⟩
    simp
  have hsupp0 : ∀ k : ℕ, (0 : GeometricCurrentOn (univ : Set (Euclid P)) k).support = ∅ := by
    intro k
    refine eq_empty_of_forall_notMem fun x hx => hx.2 ?_
    exact ⟨ball x 1, ⟨isOpen_ball, isBounded_ball.isCompact_closure, subset_univ _,
      fun ω _ => rfl⟩, mem_ball_self one_pos⟩
  -- the Euclidean coefficient norm is absolutely homogeneous
  have hhom : ∀ (k : ℕ) (t : ℝ) (α : Covector (Euclid P) k),
      covectorEuclideanNorm (t • α) = |t| * covectorEuclideanNorm α := by
    intro k t α
    simp only [covectorEuclideanNorm]
    rw [← Real.sqrt_sq_eq_abs, ← Real.sqrt_mul (sq_nonneg t), Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl fun I _ => ?_
    split_ifs <;> simp [mul_pow]
  -- a current of zero mass is zero: test `±sω` with `s‖ω‖_∞ ≤ 1`
  have hzero : ∀ (k : ℕ) (X : GeometricCurrentOn (univ : Set (Euclid P)) k), X.mass = 0 →
      X = 0 := by
    intro k X hX
    ext ω
    have hω : Continuous (ω : DifferentialForm (Euclid P) k) := ω.property.1.1.continuous
    have hfc : Continuous (covectorEuclideanNorm ∘ (ω : DifferentialForm (Euclid P) k)) := by
      simp only [Function.comp_def, covectorEuclideanNorm]
      refine Continuous.sqrt (continuous_finsetSum _ fun I _ => ?_)
      exact continuous_if_const _ (fun _ => ((continuous_eval_const _).comp hω).pow 2)
        fun _ => continuous_const
    have hcs : HasCompactSupport (covectorEuclideanNorm ∘ (ω : DifferentialForm (Euclid P) k)) :=
      ω.property.1.2.comp_left (covectorEuclideanNorm_zero P k)
    obtain ⟨C, hC⟩ := hfc.bounded_above_of_compact_support hcs
    obtain ⟨s, hs, hsC⟩ : ∃ s : ℝ, 0 < s ∧ s * (|C| + 1) = 1 :=
      ⟨(|C| + 1)⁻¹, by positivity, inv_mul_cancel₀ (by positivity)⟩
    have hadm : ∀ t : ℝ, |t| ≤ s → t • ω ∈ massAdmissibleOn (univ : Set (Euclid P)) k univ := by
      intro t ht
      refine ⟨subset_univ _, fun x => ?_⟩
      show covectorEuclideanNorm (t • (ω : DifferentialForm (Euclid P) k) x) ≤ 1
      rw [hhom]
      have h0 := covectorEuclideanNorm_nonneg ((ω : DifferentialForm (Euclid P) k) x)
      have h1 : covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) k) x) ≤ |C| + 1 := by
        have := hC x
        rw [Function.comp_apply, Real.norm_of_nonneg h0] at this
        linarith [le_abs_self C]
      calc |t| * covectorEuclideanNorm ((ω : DifferentialForm (Euclid P) k) x)
          ≤ s * (|C| + 1) := mul_le_mul ht h1 h0 hs.le
        _ = 1 := hsC
    have hX' : X.massOn univ = 0 := hX
    have h1 := X.le_massOn (hadm s (abs_of_pos hs).le)
    have h2 := X.le_massOn (hadm (-s) (by rw [abs_neg, abs_of_pos hs]))
    rw [hX', nonpos_iff_eq_zero, ENNReal.ofReal_eq_zero] at h1 h2
    have e1 : X (s • ω) = s * X ω := map_smul X.toCurrent s ω
    have e2 : X ((-s) • ω) = -(s * X ω) := by
      rw [show X ((-s) • ω) = -s * X ω from map_smul X.toCurrent (-s) ω]
      ring
    rw [e1] at h1
    rw [e2] at h2
    have h3 : s * X ω = 0 := by linarith
    rw [GeometricCurrentOn.zero_apply]
    exact (mul_eq_zero.1 h3).resolve_left hs.ne'
  -- the scale `ρ`
  set z : ℝ := Z.mass.toReal
  have hz0 : 0 ≤ z := ENNReal.toReal_nonneg
  have hZmz : Z.mass = ENNReal.ofReal z := (ENNReal.ofReal_toReal hZm.ne).symm
  have hc0 : (0 : ℝ) ≤ c := c.coe_nonneg
  have hc0' : (0 : ℝ) < c := by exact_mod_cast zero_lt_one.trans_le hc1
  have hcz0 : 0 ≤ (c : ℝ) * z := mul_nonneg hc0 hz0
  obtain ⟨ρ, hρ0, hρlt, hρ⟩ : ∃ ρ : ℝ, 0 < ρ ∧ (c : ℝ) * z < ρ ^ (m + 1) ∧
      (z = 0 ∨ ρ = (2 * (c : ℝ) * z) ^ ((1 : ℝ) / (m + 1))) := by
    rcases hz0.eq_or_lt with h | h
    · exact ⟨1, one_pos, by rw [← h]; simp, Or.inl h.symm⟩
    · have hcz : 0 < 2 * (c : ℝ) * z := mul_pos (mul_pos two_pos hc0') h
      refine ⟨_, Real.rpow_pos_of_pos hcz _, ?_, Or.inr rfl⟩
      have hpow : ((2 * (c : ℝ) * z) ^ ((1 : ℝ) / (m + 1))) ^ (m + 1) = 2 * (c : ℝ) * z := by
        rw [one_div, ← Nat.cast_succ]
        exact Real.rpow_inv_natCast_pow hcz.le (Nat.succ_ne_zero m)
      rw [hpow]
      have : 0 < (c : ℝ) * z := mul_pos hc0' h
      linarith
  have hcρ : 0 ≤ (c : ℝ) * ρ := mul_nonneg hc0 hρ0.le
  -- apply (DTr) to `T = Z`
  obtain ⟨Q, R, S, -, -, hR, hZQS, hQ, hQm, -, hRm, hSm, hQR, -⟩ :=
    hDT ρ Z hρ0 hZ hZc hZm (by rw [hZb, hmass0]; exact ENNReal.zero_lt_top)
  -- `M(S) ≤ cρ M(∂Z) = 0`, so `S = 0`
  rw [hZb, hmass0, mul_zero, nonpos_iff_eq_zero] at hSm
  obtain rfl : S = 0 := hzero _ S hSm
  -- `M(Q) ≤ cz < ρ^{m+1}`, so `Q = 0`
  obtain rfl : Q = 0 := by
    refine hQ.resolve_right fun h => ?_
    have h' := h.trans hQm
    rw [hZmz, ← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_mul hc0,
      ENNReal.ofReal_le_ofReal_iff hcz0] at h'
    linarith
  -- hence `Z = ∂R`
  have hRZ : R.boundary = Z := by
    rw [← hZQS]
    ext ω
    show Z ω - 0 - 0 = Z ω
    ring
  rcases hρ with h | rfl
  · -- `z = 0`: `M(R) ≤ cρ · 0 = 0`, so `R = 0`
    rw [hZmz, h, ENNReal.ofReal_zero, mul_zero, nonpos_iff_eq_zero] at hRm
    refine ⟨R, hR, hRZ, hRm.trans_le zero_le, ?_⟩
    rw [hzero _ R hRm, hsupp0]
    exact empty_subset _
  · refine ⟨R, hR, hRZ, hRm.trans (le_of_eq ?_), subset_union_right.trans hQR⟩
    rw [ENNReal.ofReal_mul hcρ, ENNReal.ofReal_mul hc0, ENNReal.ofReal_coe_nnreal, hZmz]

/-- **Deformation theorem and isoperimetric filling** (Simon Ch. 6, 5.1, 5.3 and 6.1; steps 5–7
of the supplied proof).  Fix `P`, `m` with `m + 1 < P`, `ρ > 0` and `T`, and let `δ_λ` be the
dilation push-forward of `cmcdt_dilation_pushforward`.  The unit-scale deformation
`dtc_bc_tc_cl_dfm_skeleton_deformation` (with (REP) `dtc_bc_lc_fd_dfm_mass_representation_core`
and the slicing bounds `cmc_slice_mass_bounds`), applied to `T' = δ_{ρ⁻¹}T`, gives
`T' − Q₀ − S₁ = ∂R₁` with `Q₀` on the unit `n`-skeleton.  The face replacement
`dtc_bc_tc_cl_dfm_face_replacement`, applied with `K = cthickening √P (spt T')` and
`Λ = c_s M(T')`, gives the integer face chain `P_c`.  Then `Q = δ_ρ P_c`, `R = δ_ρ R₁` and
`S = δ_ρ(S₁ − (P_c − Q₀))` satisfy `T − Q − S = ∂R`.  Masses scale by `ρᵏ` in degree `k`, so the
constant is `c = c_s(1 + c_f)`.  All supports lie in `ρ · cthickening (2√P) (ρ⁻¹A)`, which is
contained in `thickening (3√Pρ) A`, for `A = spt T`, resp. `spt ∂T`.  (Isor) is
`dtc_bc_tc_cl_dfm_isoperimetric_filling` applied to (DTr). -/
theorem Submission.dtc_bc_tc_cl_deformation_isoperimetric : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P m : ℕ), m + 1 < P → ∃ c : NNReal, 1 ≤ c ∧ ∀ (ρ : ℝ) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 0 < ρ → IsIntegerMultiplicity T → IsCompact T.support → T.mass < ∞ → T.boundary.mass < ∞ → ∃ (Q : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q ∧ IsIntegerMultiplicity Q.boundary ∧ IsIntegerMultiplicity R ∧ T - Q - S = R.boundary ∧ (Q = 0 ∨ ENNReal.ofReal (ρ ^ (m + 1)) ≤ Q.mass) ∧ Q.mass ≤ c * T.mass ∧ Q.boundary.mass ≤ c * T.boundary.mass ∧ R.mass ≤ c * ENNReal.ofReal ρ * T.mass ∧ S.mass ≤ c * ENNReal.ofReal ρ * T.boundary.mass ∧ Q.support ∪ R.support ⊆ thickening (3 * Real.sqrt P * ρ) T.support ∧ Q.boundary.support ∪ S.support ⊆ thickening (3 * Real.sqrt P * ρ) T.boundary.support) ∧ (∀ (P m : ℕ), m + 1 < P → ∃ c : ℝ, 1 ≤ c ∧ ∀ Z : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1), IsIntegerMultiplicity Z → IsCompact Z.support → Z.boundary = 0 → Z.mass < ∞ → ∃ Y : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2), IsIntegerMultiplicity Y ∧ Y.boundary = Z ∧ Y.mass ≤ ENNReal.ofReal (c * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1)) * Z.mass.toReal) ∧ Y.support ⊆ thickening (3 * Real.sqrt P * (2 * c * Z.mass.toReal) ^ ((1 : ℝ) / (m + 1))) Z.support) := by
  intro hMR hIMC hVO
  refine ⟨?dtr, Submission.dtc_bc_tc_cl_dfm_isoperimetric_filling ?dtr⟩
  intro P m hPm
  obtain ⟨cs, hcs1, hskel⟩ := Submission.dtc_bc_tc_cl_dfm_skeleton_deformation hVO hMR
    Submission.dtc_bc_lc_fd_dfm_mass_representation_core hIMC Submission.cmc_slice_mass_bounds P m
  obtain ⟨cf, -, hface⟩ := Submission.dtc_bc_tc_cl_dfm_face_replacement hVO hMR hIMC P m
  obtain ⟨dil, hdil⟩ := Submission.cmcdt_dilation_pushforward P
  -- `(X − Y)(ω) = X(ω) − Y(ω)`
  have hsub : ∀ (k : ℕ) (X Y : GeometricCurrentOn (univ : Set (Euclid P)) k)
      (ω : TestFormOn (univ : Set (Euclid P)) k), (X - Y) ω = X ω - Y ω := fun _ _ _ _ => rfl
  -- if `Z = X + Y` then `M(Z) ≤ M(X) + M(Y)` and `spt Z ⊆ spt X ∪ spt Y`
  have hsum : ∀ (k : ℕ) (X Y Z : GeometricCurrentOn (univ : Set (Euclid P)) k),
      (∀ ω, Z ω = X ω + Y ω) → Z.mass ≤ X.mass + Y.mass ∧ Z.support ⊆ X.support ∪ Y.support := by
    intro k X Y Z hZ
    refine ⟨sSup_le ?_, fun x hx => ?_⟩
    · rintro r ⟨ω, hω, rfl⟩
      show ENNReal.ofReal (Z ω) ≤ X.massOn univ + Y.massOn univ
      rw [hZ ω]
      exact ENNReal.ofReal_add_le.trans (add_le_add (X.le_massOn hω) (Y.le_massOn hω))
    · by_contra hxXY
      rw [mem_union, not_or] at hxXY
      have hX : x ∈ X.zeroRegion := by
        by_contra h
        exact hxXY.1 ((mem_sdiff x).2 ⟨mem_univ x, h⟩)
      have hY : x ∈ Y.zeroRegion := by
        by_contra h
        exact hxXY.2 ((mem_sdiff x).2 ⟨mem_univ x, h⟩)
      obtain ⟨W₁, ⟨hW₁, hW₁c, -, hX0⟩, hxW₁⟩ := mem_sUnion.1 hX
      obtain ⟨W₂, ⟨hW₂, -, -, hY0⟩, hxW₂⟩ := mem_sUnion.1 hY
      refine ((mem_sdiff x).1 hx).2 (mem_sUnion.2 ⟨W₁ ∩ W₂, ⟨hW₁.inter hW₂,
        hW₁c.of_isClosed_subset isClosed_closure (closure_mono inter_subset_left),
        subset_univ _, fun ω hω => ?_⟩, hxW₁, hxW₂⟩)
      rw [hZ ω, hX0 ω (hω.trans inter_subset_left), hY0 ω (hω.trans inter_subset_right),
        add_zero]
  -- the dilation of `0` is `0`, by linearity
  have hdil0 : ∀ (k : ℕ) (lam : ℝ), 0 < lam → dil k lam 0 = 0 := by
    intro k lam hlam
    have h00 : (0 : GeometricCurrentOn (univ : Set (Euclid P)) k) - 0 = 0 := by
      ext ω
      rw [hsub, GeometricCurrentOn.zero_apply, sub_zero]
    have h := (hdil k lam hlam).1 0 0
    rw [h00] at h
    ext ω
    have hω : dil k lam 0 ω = (dil k lam 0 - dil k lam 0) ω := by rw [← h]
    rw [hω, hsub, sub_self, GeometricCurrentOn.zero_apply]
  have hsqrt : 0 < Real.sqrt P := Real.sqrt_pos.2 (by exact_mod_cast (by omega : 0 < P))
  refine ⟨cs * (1 + cf), one_le_mul_of_one_le_of_one_le hcs1 le_self_add, ?_⟩
  intro ρ T hρ hT hTc hTm hTbm
  have hρ0 : ρ ≠ 0 := hρ.ne'
  have hρi : 0 < ρ⁻¹ := inv_pos.2 hρ
  -- `ρʲ·ρ⁻ʲ = 1` and `ρʲ⁺¹·ρ⁻ʲ = ρ`
  have hcan : ∀ j : ℕ, ENNReal.ofReal (ρ ^ j) * ENNReal.ofReal (ρ⁻¹ ^ j) = 1 := fun j => by
    rw [← ENNReal.ofReal_mul (pow_pos hρ j).le, ← mul_pow, mul_inv_cancel₀ hρ0, one_pow,
      ENNReal.ofReal_one]
  have hcan' : ∀ j : ℕ, ENNReal.ofReal (ρ ^ (j + 1)) * ENNReal.ofReal (ρ⁻¹ ^ j) =
      ENNReal.ofReal ρ := fun j => by
    rw [← ENNReal.ofReal_mul (pow_pos hρ (j + 1)).le, pow_succ, mul_right_comm, ← mul_pow,
      mul_inv_cancel₀ hρ0, one_pow, one_mul]
  have hc2 : ENNReal.ofReal (ρ ^ (m + 2)) * ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) = ENNReal.ofReal ρ :=
    hcan' (m + 1)
  -- `ρ · cthickening (2√P) (ρ⁻¹A) ⊆ thickening (3√Pρ) A`
  have hscale : ∀ A C : Set (Euclid P),
      C ⊆ cthickening (2 * Real.sqrt P) ((fun x => ρ⁻¹ • x) '' A) →
        (fun x => ρ • x) '' C ⊆ thickening (3 * Real.sqrt P * ρ) A := by
    rintro A C hC _ ⟨y, hy, rfl⟩
    have hlt : infEDist y ((fun x => ρ⁻¹ • x) '' A) < ENNReal.ofReal (3 * Real.sqrt P) :=
      (mem_cthickening_iff.1 (hC hy)).trans_lt
        ((ENNReal.ofReal_lt_ofReal_iff (by linarith)).2 (by linarith))
    obtain ⟨_, ⟨a, ha, rfl⟩, hya⟩ := infEDist_lt_iff.1 hlt
    rw [edist_dist, ENNReal.ofReal_lt_ofReal_iff (by linarith)] at hya
    refine mem_thickening_iff.2 ⟨a, ha, ?_⟩
    calc dist (ρ • y) a = dist (ρ • y) (ρ • ρ⁻¹ • a) := by rw [smul_inv_smul₀ hρ0]
      _ = ρ * dist y (ρ⁻¹ • a) := by rw [dist_smul₀, Real.norm_eq_abs, abs_of_pos hρ]
      _ < ρ * (3 * Real.sqrt P) := mul_lt_mul_of_pos_left hya hρ
      _ = 3 * Real.sqrt P * ρ := by ring
  -- the dilate `T' = δ_{ρ⁻¹}T`
  obtain ⟨-, hinv, hmassT, hsuppT, himT, -⟩ := hdil (m + 1) ρ⁻¹ hρi
  obtain ⟨-, -, hmassbT, hsuppbT, -, hbdT⟩ := hdil m ρ⁻¹ hρi
  obtain ⟨T', hT'⟩ : ∃ T', dil (m + 1) ρ⁻¹ T = T' := ⟨_, rfl⟩
  have hTT' : dil (m + 1) ρ T' = T := by
    have h := hinv T
    rwa [inv_inv, hT'] at h
  have hT'IM : IsIntegerMultiplicity T' := by
    rw [← hT']
    exact himT T hT
  have hT's : T'.support = (fun x => ρ⁻¹ • x) '' T.support := by
    rw [← hT']
    exact hsuppT T
  have hT'bs : T'.boundary.support = (fun x => ρ⁻¹ • x) '' T.boundary.support := by
    rw [← hT', hbdT T]
    exact hsuppbT T.boundary
  have hT'm : T'.mass = ENNReal.ofReal (ρ⁻¹ ^ (m + 1)) * T.mass := by
    rw [← hT']
    exact hmassT T
  have hT'bm : T'.boundary.mass = ENNReal.ofReal (ρ⁻¹ ^ m) * T.boundary.mass := by
    rw [← hT', hbdT T]
    exact hmassbT T.boundary
  have hT'c : IsCompact T'.support := by
    rw [hT's]
    exact hTc.image (continuous_const_smul ρ⁻¹)
  have hT'mfin : T'.mass < ∞ := by
    rw [hT'm]
    exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top hTm
  have hT'bmfin : T'.boundary.mass < ∞ := by
    rw [hT'bm]
    exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top hTbm
  -- unit-scale deformation of `T'` onto the skeleton, then face replacement
  obtain ⟨Q₀, R₁, S₁, hQ₀IM, hR₁IM, hEq, hQ₀sk, hQ₀m, hQ₀bm, hR₁m, hS₁m, hs₁, hs₂⟩ :=
    hskel T' hT'IM hT'c hT'mfin hT'bmfin
  obtain ⟨𝒬, -, hface'⟩ := hface (cthickening (Real.sqrt P) T'.support)
    (cs * T'.mass.toNNReal) hT'c.cthickening
  obtain ⟨Pc, -, hPcIM, hPcbIM, hPc01, hPcm, hPcbm, hdm, hPcs, hds⟩ := hface' Q₀ hQ₀IM
    (subset_union_left.trans hs₁) hQ₀sk
    (by rw [ENNReal.coe_mul, ENNReal.coe_toNNReal hT'mfin.ne]; exact hQ₀m)
    (hQ₀bm.trans_lt (ENNReal.mul_lt_top ENNReal.coe_lt_top hT'bmfin))
  -- `S' = S₁ − (P_c − Q₀) = S₁ + (Q₀ − P_c)`
  obtain ⟨hS'm, hS's⟩ := hsum (m + 1) S₁ (Q₀ - Pc) (S₁ - (Pc - Q₀)) fun ω => by
    repeat rw [hsub]
    ring
  -- dilate back by `ρ`
  obtain ⟨hlin, -, hmass1, hsupp1, him1, hbd1⟩ := hdil (m + 1) ρ hρ
  obtain ⟨-, -, hmass0, hsupp0, him0, hbd0⟩ := hdil m ρ hρ
  obtain ⟨-, -, hmass2, hsupp2, him2, -⟩ := hdil (m + 2) ρ hρ
  have hbdR : (dil (m + 2) ρ R₁).boundary = dil (m + 1) ρ R₁.boundary := hbd1 R₁
  have hcs_le : (cs : ℝ≥0∞) ≤ ((cs * (1 + cf) : NNReal) : ℝ≥0∞) :=
    ENNReal.coe_le_coe.2 (le_mul_of_one_le_right zero_le le_self_add)
  have hcfcs : (cf : ℝ≥0∞) * cs ≤ ((cs * (1 + cf) : NNReal) : ℝ≥0∞) := by
    rw [← ENNReal.coe_mul]
    refine ENNReal.coe_le_coe.2 ?_
    rw [mul_add, mul_one, mul_comm cf cs]
    exact le_add_self
  refine ⟨dil (m + 1) ρ Pc, dil (m + 2) ρ R₁, dil (m + 1) ρ (S₁ - (Pc - Q₀)), him1 Pc hPcIM,
    by rw [hbd0]; exact him0 _ hPcbIM, him2 R₁ hR₁IM, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- `T − Q − S = ∂R`
    have hEq' : T' - Pc - (S₁ - (Pc - Q₀)) = R₁.boundary := by
      rw [← hEq]
      ext ω
      repeat rw [hsub]
      ring
    rw [hbdR, ← hEq', hlin (T' - Pc) (S₁ - (Pc - Q₀)), hlin T' Pc, hTT']
  · -- `Q = 0` or `M(Q) ≥ ρᵐ⁺¹`
    rcases hPc01 with h0 | h1
    · left
      rw [h0]
      exact hdil0 (m + 1) ρ hρ
    · right
      rw [hmass1]
      calc ENNReal.ofReal (ρ ^ (m + 1)) = ENNReal.ofReal (ρ ^ (m + 1)) * 1 := (mul_one _).symm
        _ ≤ ENNReal.ofReal (ρ ^ (m + 1)) * Pc.mass := by gcongr
  · -- `M(Q) ≤ c M(T)`
    calc (dil (m + 1) ρ Pc).mass = ENNReal.ofReal (ρ ^ (m + 1)) * Pc.mass := hmass1 Pc
      _ ≤ ENNReal.ofReal (ρ ^ (m + 1)) * (cf * (cs * T'.mass)) := by
        gcongr
        exact hPcm.trans (by gcongr)
      _ = cf * cs * (ENNReal.ofReal (ρ ^ (m + 1)) * ENNReal.ofReal (ρ⁻¹ ^ (m + 1))) * T.mass := by
        rw [hT'm]
        ring
      _ = cf * cs * T.mass := by rw [hcan, mul_one]
      _ ≤ ((cs * (1 + cf) : NNReal) : ℝ≥0∞) * T.mass := by gcongr
  · -- `M(∂Q) ≤ c M(∂T)`
    rw [hbd0]
    calc (dil m ρ Pc.boundary).mass = ENNReal.ofReal (ρ ^ m) * Pc.boundary.mass := hmass0 _
      _ ≤ ENNReal.ofReal (ρ ^ m) * (cf * (cs * T'.boundary.mass)) := by
        gcongr
        exact hPcbm.trans (by gcongr)
      _ = cf * cs * (ENNReal.ofReal (ρ ^ m) * ENNReal.ofReal (ρ⁻¹ ^ m)) * T.boundary.mass := by
        rw [hT'bm]
        ring
      _ = cf * cs * T.boundary.mass := by rw [hcan, mul_one]
      _ ≤ ((cs * (1 + cf) : NNReal) : ℝ≥0∞) * T.boundary.mass := by gcongr
  · -- `M(R) ≤ c ρ M(T)`
    calc (dil (m + 2) ρ R₁).mass = ENNReal.ofReal (ρ ^ (m + 2)) * R₁.mass := hmass2 R₁
      _ ≤ ENNReal.ofReal (ρ ^ (m + 2)) * (cs * T'.mass) := by gcongr
      _ = cs * (ENNReal.ofReal (ρ ^ (m + 2)) * ENNReal.ofReal (ρ⁻¹ ^ (m + 1))) * T.mass := by
        rw [hT'm]
        ring
      _ = cs * ENNReal.ofReal ρ * T.mass := by rw [hc2]
      _ ≤ ((cs * (1 + cf) : NNReal) : ℝ≥0∞) * ENNReal.ofReal ρ * T.mass := by gcongr
  · -- `M(S) ≤ c ρ M(∂T)`
    calc (dil (m + 1) ρ (S₁ - (Pc - Q₀))).mass
        = ENNReal.ofReal (ρ ^ (m + 1)) * (S₁ - (Pc - Q₀)).mass := hmass1 _
      _ ≤ ENNReal.ofReal (ρ ^ (m + 1)) *
          (cs * T'.boundary.mass + cf * (cs * T'.boundary.mass)) := by
        gcongr
        exact hS'm.trans (add_le_add hS₁m (hdm.trans (by gcongr)))
      _ = cs * (1 + cf) * (ENNReal.ofReal (ρ ^ (m + 1)) * ENNReal.ofReal (ρ⁻¹ ^ m)) *
          T.boundary.mass := by
        rw [hT'bm]
        ring
      _ = ((cs * (1 + cf) : NNReal) : ℝ≥0∞) * ENNReal.ofReal ρ * T.boundary.mass := by
        rw [hcan' m, ENNReal.coe_mul, ENNReal.coe_add, ENNReal.coe_one]
  · -- `spt Q ∪ spt R ⊆ thickening (3√Pρ) (spt T)`
    rw [hsupp1, hsupp2]
    refine union_subset (hscale _ _ ?_) (hscale _ _ ?_)
    · rw [← hT's, two_mul]
      exact hPcs.trans ((cthickening_subset_of_subset _ (subset_union_left.trans hs₁)).trans
        (cthickening_cthickening_subset hsqrt.le hsqrt.le _))
    · rw [← hT's]
      exact (subset_union_right.trans hs₁).trans (cthickening_mono (by linarith) _)
  · -- `spt ∂Q ∪ spt S ⊆ thickening (3√Pρ) (spt ∂T)`
    rw [hbd0, hsupp0, hsupp1]
    refine union_subset (hscale _ _ ?_) (hscale _ _ ?_)
    · rw [← hT'bs, two_mul]
      exact (subset_union_right.trans hds).trans
        ((cthickening_subset_of_subset _ (subset_union_left.trans hs₂)).trans
          (cthickening_cthickening_subset hsqrt.le hsqrt.le _))
    · rw [← hT'bs]
      refine hS's.trans (union_subset ?_ ?_)
      · exact (subset_union_right.trans hs₂).trans (cthickening_mono (by linarith) _)
      · rw [two_mul]
        exact (subset_union_left.trans hds).trans
          ((cthickening_subset_of_subset _ (subset_union_left.trans hs₂)).trans
            (cthickening_cthickening_subset hsqrt.le hsqrt.le _))
/-- **Simon 6.8.2 for `n = 0`** (the closure theorem in degree `0`, "trivial in case `n = 0`"),
given (REP), (MR) and (IMC): if integer multiplicity `T_j ∈ 𝒟₀(U)` satisfy
`sup_j M_W(T_j) < ∞` for all open `W ⊂⊂ U` and `T_j ⇀ T`, then `T` is integer multiplicity.
`M_W(T) ≤ liminf_j M_W(T_j) < ∞` (6.2.14).  For `x₀ ∈ U` take `B = B_r(x₀)` with `B̄ ⊆ U`: on
forms supported in `B`, `T_j(ω) = Σ_l w_{j,l} ⟨ω(x_{j,l})⟩` with `x_{j,l} ∈ B`, integers
`w_{j,l} ≠ 0` and `Σ_l |w_{j,l}| ≤ μ_{T_j}(B) = M_B(T_j) < C` (`dmcbrz_imrep_zero_local_point_sum`,
(MR)); the limits `T(ω)` are again integer point sums (`cbrz_point_sum_limit`), so `T` is integer
multiplicity in `B` (`dmcbrz_isIntegerMultiplicity_point_sum`), and the local criterion (IML)(1)
of the foundations concludes. -/
theorem Submission.dtc_bc_tc_cl_closure_degree_zero : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n), IsOpen U → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → T.massOn W < ∞) → ∃ (μ : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n), μ Uᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) ∧ (∀ W : Set (Euclid P), IsOpen W → T.massOn W = μ W) ∧ AEStronglyMeasurable ξ μ ∧ (∀ (x : Euclid P) (α : Covector (Euclid P) n), |ξ x α| ≤ covectorEuclideanNorm α) ∧ (∀ ω : TestFormOn U n, T ω = ∫ x, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μ) ∧ ((∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → boundaryMassOn T W < ∞) → ∀ E : Set (Euclid P), μHE[n] E = 0 → μ E = 0)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → ∀ (P : ℕ) (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U 0) (T : GeometricCurrentOn U 0), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T := by
  have hIML := Submission.dtc_bc_tc_cl_foundations.2.2
  have hPS := Submission.dmcbrz_imrep_zero_local_point_sum
  have hLim := Submission.cbrz_point_sum_limit
  have hIMps := Submission.dmcbrz_isIntegerMultiplicity_point_sum
  intro hREP hMR hIMC P U Ts T hU hTs hsup hconv
  refine (hIML hREP hMR hIMC P 0 U T hU).1 (fun W hW hWU => ?_) (fun x₀ hx₀ => ?_)
  · -- `M_W(T) ≤ liminf_j M_W(T_j) ≤ sup_j (M_W(T_j) + M_W(∂T_j)) < ∞` (6.2.14)
    refine lt_of_le_of_lt ?_ (hsup W hW hWU)
    calc T.massOn W ≤ liminf (fun j => (Ts j).massOn W) atTop := hconv.massOn_le_liminf W
      _ ≤ limsup (fun j => (Ts j).massOn W) atTop := liminf_le_limsup
      _ ≤ ⨆ j, (Ts j).massOn W := limsup_le_iSup
      _ ≤ ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) := iSup_mono fun j => le_self_add
  · -- `B = B_r(x₀)` with `r = ε / 2` and `B_ε(x₀) ⊆ U`, so `B̄ ⊆ U` and `B ⊂⊂ U`
    obtain ⟨ε, hε, hεU⟩ := Metric.isOpen_iff.1 hU x₀ hx₀
    have hcl : closedBall x₀ (ε / 2) ⊆ U := (closedBall_subset_ball (half_lt_self hε)).trans hεU
    have hBU : ball x₀ (ε / 2) ⊆ U := ball_subset_closedBall.trans hcl
    have hBcc : CompactlyContained (ball x₀ (ε / 2)) U :=
      ⟨(isCompact_closedBall x₀ (ε / 2)).of_isClosed_subset isClosed_closure
        closure_ball_subset_closedBall, closure_ball_subset_closedBall.trans hcl⟩
    refine ⟨ε / 2, half_pos hε, hBU, ?_⟩
    -- on `B` each `T_j` is a point sum `Σ_l w_{j,l} ⟨ω(x_{j,l})⟩`, `Σ_l |w_{j,l}| ≤ M_B(T_j) < C`
    choose R hR using hTs
    choose N w x hxB hw0 hwB hrep using fun j => hPS P U _ (R j) (Ts j) (hR j) hBcc
    obtain ⟨C, hC⟩ := ENNReal.exists_nat_gt (hsup _ isOpen_ball hBcc).ne
    have hwC : ∀ j, (∑ l ∈ Finset.range (N j), (w j l).natAbs) ≤ C := by
      intro j
      have h : ((∑ l ∈ Finset.range (N j), (w j l).natAbs : ℕ) : ℝ≥0∞) < C := by
        calc ((∑ l ∈ Finset.range (N j), (w j l).natAbs : ℕ) : ℝ≥0∞)
            = ∑ l ∈ Finset.range (N j), ((w j l).natAbs : ℝ≥0∞) := Nat.cast_sum _ _
          _ ≤ (R j).measure (ball x₀ (ε / 2)) := hwB j
          _ = (Ts j).massOn (ball x₀ (ε / 2)) :=
            (hMR P 0 U (Ts j) (R j) hU (hR j) _ isOpen_ball).symm
          _ ≤ (Ts j).massOn (ball x₀ (ε / 2)) + boundaryMassOn (Ts j) (ball x₀ (ε / 2)) :=
            le_self_add
          _ ≤ ⨆ i, ((Ts i).massOn (ball x₀ (ε / 2)) + boundaryMassOn (Ts i) (ball x₀ (ε / 2))) :=
            le_iSup (fun i => (Ts i).massOn (ball x₀ (ε / 2)) +
              boundaryMassOn (Ts i) (ball x₀ (ε / 2))) j
          _ < C := hC
      exact_mod_cast h.le
    -- `ω ↦ ⟨ω(p)⟩` is continuous, and `T_j(ω) → T(ω)` for `spt ω ⊆ B`
    have hcont : ∀ ω : TestFormOn (ball x₀ (ε / 2)) 0,
        Continuous fun p => (ω : DifferentialForm (Euclid P) 0) p (fun i => i.elim0) := by
      intro ω
      have hω := ω.property.1.1
      unfold IsSmoothForm at hω
      exact hω.continuous.eval_const _
    have hlim : ∀ ω : TestFormOn (ball x₀ (ε / 2)) 0, Tendsto (fun j =>
        ∑ l ∈ Finset.range (N j), (w j l : ℝ) * (ω : DifferentialForm (Euclid P) 0) (x j l)
          (fun i => i.elim0)) atTop (𝓝 (T.restrictDomain hBU ω)) := by
      intro ω
      refine (hconv (testFormOnInclusion hBU 0 ω)).congr fun j => ?_
      rw [hrep j (testFormOnInclusion hBU 0 ω) ω.property.2]
      rfl
    -- the limit is again an integer point sum, so `T` is integer multiplicity in `B`
    obtain ⟨M, v, y, -, hy⟩ := hLim P (closedBall x₀ (ε / 2)) C N w x
      (TestFormOn (ball x₀ (ε / 2)) 0)
      (fun ω p => (ω : DifferentialForm (Euclid P) 0) p (fun i => i.elim0))
      (fun ω => T.restrictDomain hBU ω) (isCompact_closedBall x₀ (ε / 2))
      (fun j l hl => ball_subset_closedBall (hxB j l hl)) hw0 hwC hcont hlim
    exact hIMps P _ (T.restrictDomain hBU) M v y hy

/-- **Simon 6.2–6.3: boundary rectifiability `BR_P(d)` from the closure theorem `CL_P(d)`**
(`d + 1 < P`).  If `R ∈ 𝒟_{d+1}(U)` is integer multiplicity and `M_W(∂R) < ∞` for every open
`W ⊂⊂ U`, then `∂R` is integer multiplicity.  By the local criterion (IML)(1) of the sibling
foundations it suffices to treat a neighbourhood of each `x₀ ∈ U`.  Slicing by `|· − x₀|` gives
`r > 0` with `B̄_r(x₀) ⊆ U` and an integer multiplicity `R' = R ⌞ B_r(x₀)` supported in
`B̄_r(x₀)`, with `M(R'), M(∂R') < ∞` and `∂R' = ∂R` on forms supported in `B_r(x₀)`.  Its
extension `Y` by zero to `ℝ^P` is integer multiplicity, has compact support, `M(Y) ≤ M(R')` and
`M(∂Y) ≤ M(∂R')`, so the deformation theorem and `CL_P(d)` make `∂Y` integer multiplicity.  As
`(∂R)|_{B_r(x₀)} = (∂Y)|_{B_r(x₀)}`, (IML)(2) concludes. -/
theorem Submission.dtc_bc_tc_cl_boundary_isIntegerMultiplicity : (∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → ∀ W : Set (Euclid P), IsOpen W → T.massOn W = R.measure W) → ((∀ (P n : ℕ) (U M M' : Set (Euclid P)), IsOpen U → MeasurableSet M → MeasurableSet M' → M ⊆ M' → M' ⊆ U → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μHE[n] (M' ∩ K) ≠ ∞) → ∀ᵐ x ∂(μHE[n].restrict M), ∀ Q : Submodule ℝ (Euclid P), HasApproximateTangentSpaceAt n M x Q ↔ HasApproximateTangentSpaceAt n M' x Q) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (E : Set (Euclid P)), IsOpen U → MeasurableSet E → ∃ (A : GeometricCurrentOn U n) (R' : IMRep U n), R'.Represents A ∧ R'.carrier = R.carrier ∩ E ∧ R'.mult = R.mult ∧ R'.orient = R.orient) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (A B : GeometricCurrentOn U n), IsOpen U → IsIntegerMultiplicity A → IsIntegerMultiplicity B → IsIntegerMultiplicity (A - B)) ∧ (∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∀ᵐ x ∂(μHE[n].restrict R.carrier), ∀ α : Covector (Euclid P) n, |R.orient x α| ≤ covectorEuclideanNorm α)) → (∀ (P n : ℕ) (U : Set (Euclid P)) (S : GeometricCurrentOn U n) (ω : TestFormOn U n), Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) S.support → S ω = 0) → (∀ (P m : ℕ), m + 1 < P → ∃ c : NNReal, 1 ≤ c ∧ ∀ (ρ : ℝ) (T : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), 0 < ρ → IsIntegerMultiplicity T → IsCompact T.support → T.mass < ∞ → T.boundary.mass < ∞ → ∃ (Q : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)) (R : GeometricCurrentOn (univ : Set (Euclid P)) (m + 2)) (S : GeometricCurrentOn (univ : Set (Euclid P)) (m + 1)), IsIntegerMultiplicity Q ∧ IsIntegerMultiplicity Q.boundary ∧ IsIntegerMultiplicity R ∧ T - Q - S = R.boundary ∧ (Q = 0 ∨ ENNReal.ofReal (ρ ^ (m + 1)) ≤ Q.mass) ∧ Q.mass ≤ c * T.mass ∧ Q.boundary.mass ≤ c * T.boundary.mass ∧ R.mass ≤ c * ENNReal.ofReal ρ * T.mass ∧ S.mass ≤ c * ENNReal.ofReal ρ * T.boundary.mass ∧ Q.support ∪ R.support ⊆ thickening (3 * Real.sqrt P * ρ) T.support ∧ Q.boundary.support ∪ S.support ⊆ thickening (3 * Real.sqrt P * ρ) T.boundary.support) → ∀ (P d : ℕ), d + 1 < P → (∀ (U : Set (Euclid P)) (Ts : ℕ → GeometricCurrentOn U d) (T : GeometricCurrentOn U d), IsOpen U → (∀ j, IsIntegerMultiplicity (Ts j)) → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) → WeaklyConvergesOn Ts T → IsIntegerMultiplicity T) → (∀ (U : Set (Euclid P)) (R : GeometricCurrentOn U (d + 1)), IsOpen U → IsIntegerMultiplicity R → (∀ W : Set (Euclid P), IsOpen W → CompactlyContained W U → R.boundary.massOn W < ∞) → IsIntegerMultiplicity R.boundary) := by
  intro hMR hIMC _hVO hDTr P d hdP hCL U R hU hR hbd
  -- (REP) and the locality of integer multiplicity (IML) from the sibling foundations
  obtain ⟨hREP, -, hIML⟩ := Submission.dtc_bc_tc_cl_foundations
  -- (IML)(1): `∂R` has locally finite mass, so it suffices to work near each `x₀ ∈ U`
  refine (hIML hREP hMR hIMC P d U R.boundary hU).1 hbd ?_
  intro x₀ hx₀
  -- slicing: `R' = R ⌞ B_r(x₀)` with `∂R' = ∂R` on forms supported in `B_r(x₀)`
  obtain ⟨r, hr, hrU, R', hR'im, hR'spt, hR'm, hR'bm, hagree⟩ :=
    Submission.dtc_bc_tc_cl_bim_slice_localization hREP hIMC.2.1 hIMC.2.2.2
      Submission.cmc_slice_mass_bounds P d U R x₀ hU hR hbd hx₀
  -- the extension `Y` of `R'` by zero to `ℝ^P`
  obtain ⟨Y, hYim, hYres, hYspt, hYm, hYbm⟩ :=
