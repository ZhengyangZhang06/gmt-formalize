open Filter Function Set MeasureTheory Metric
open scoped ENNReal Topology

namespace GMT.Ch07

open Poincare.SimonGMT.Chapter06
open Poincare.SimonGMT.Chapter03 (CountablyRectifiable HasApproximateTangentSpaceAt)

noncomputable section

/-- Euclidean space `ℝᴾ`. -/
abbrev Euclid (P : ℕ) := EuclideanSpace ℝ (Fin P)

variable {P : ℕ}

/-! ## Multivectors and integer multiplicity currents (Simon Ch. 6, §1 and 3.1) -/

/-- `n`-vectors `Λₙ(ℝᴾ)`, realized as the dual of `n`-covectors (Simon 6.1, `Λₙ ≅ (Λⁿ)*`);
`ξ α` is the pairing `⟨α, ξ⟩` of Simon (6.1.7). -/
abbrev MultiVector (P n : ℕ) := Covector (Euclid P) n →L[ℝ] ℝ

/-- `ξ = ±τ₁ ∧ ⋯ ∧ τₙ` for an orthonormal basis `τ` of the subspace `Q`, i.e.
`⟨α, ξ⟩ = ±α(τ₁, …, τₙ)` (Simon 6.1.1, 6.1.7; 6.2.2).  The sign matters only for `n = 0`. -/
def IsUnitOrientationOf {n : ℕ} (ξ : MultiVector P n) (Q : Submodule ℝ (Euclid P)) : Prop :=
  ∃ τ : Fin n → Euclid P, Orthonormal ℝ τ ∧ Submodule.span ℝ (range τ) = Q ∧
    ((∀ α : Covector (Euclid P) n, ξ α = α τ) ∨ ∀ α : Covector (Euclid P) n, ξ α = -α τ)

/-- Simon Ch. 6, Definition 3.1 (p. 146): a triple `(M, θ, ξ)` in `U`.  `M ⊆ U` is
`Hⁿ`-measurable (taken Borel; this loses nothing, `Hⁿ⌞M` being σ-finite) and countably
`n`-rectifiable; `θ` is positive integer-valued on `M` and locally `Hⁿ`-integrable in `U`; `ξ` is
`Hⁿ`-measurable and, `Hⁿ`-a.e. on `M`, orients the approximate tangent space `TₓM`
(Ch. 3, 1.4). -/
structure IMRep (U : Set (Euclid P)) (n : ℕ) where
  carrier : Set (Euclid P)
  mult : Euclid P → ℕ
  orient : Euclid P → MultiVector P n
  measurableSet_carrier : MeasurableSet carrier
  carrier_subset : carrier ⊆ U
  rectifiable : CountablyRectifiable n carrier
  measurable_mult : Measurable mult
  mult_pos : ∀ x ∈ carrier, 0 < mult x
  locallyIntegrable_mult : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
    ∫⁻ x in carrier ∩ K, (mult x : ℝ≥0∞) ∂μHE[n] ≠ ∞
  aestronglyMeasurable_orient : AEStronglyMeasurable orient (μHE[n].restrict carrier)
  orients : ∀ᵐ x ∂(μHE[n].restrict carrier), ∃ Q : Submodule ℝ (Euclid P),
    HasApproximateTangentSpaceAt n carrier x Q ∧ IsUnitOrientationOf (orient x) Q

variable {U : Set (Euclid P)} {n : ℕ}

/-- `τ(M, θ, ξ)(ω) = ∫_M ⟨ω(x), ξ(x)⟩ θ(x) dHⁿ(x)` (Simon 6.3.1 (‡)). -/
def IMRep.action (R : IMRep U n) (ω : DifferentialForm (Euclid P) n) : ℝ :=
  ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (ω x) ∂μHE[n]

/-- `T = τ(M, θ, ξ)` in `U`. -/
def IMRep.Represents (R : IMRep U n) (T : GeometricCurrentOn U n) : Prop :=
  ∀ ω : TestFormOn U n, T ω = R.action (ω : DifferentialForm (Euclid P) n)

/-- The weight `μ_V = θ Hⁿ⌞M` of the associated varifold `V = v(M, θ)`; it equals the mass
measure `μ_T` of `T = τ(M, θ, ξ)` (Simon 6.3.2(3), 4.1.1). -/
def IMRep.measure (R : IMRep U n) : Measure (Euclid P) :=
  (μHE[n].restrict R.carrier).withDensity fun x => (R.mult x : ℝ≥0∞)

/-- Simon 6.3.1: `T` is an integer multiplicity (rectifiable) current. -/
def IsIntegerMultiplicity (T : GeometricCurrentOn U n) : Prop :=
  ∃ R : IMRep U n, R.Represents T

/-- Difference of currents (needed for `spt(S − T)` in 7.1.1). -/
instance : Sub (GeometricCurrentOn U n) where
  sub S T :=
    { toCurrent := S.toCurrent - T.toCurrent
      continuous' := fun ωs h => by
        simpa using (S.continuous' ωs h).sub (T.continuous' ωs h) }

/-! ## Boundary conventions in arbitrary degree -/

/-- `∂S = ∂T` in `U` (vacuous for `n = 0`, where `∂ = 0`). -/
def SameBoundary : {n : ℕ} → GeometricCurrentOn U n → GeometricCurrentOn U n → Prop
  | 0, _, _ => True
  | _ + 1, S, T => S.boundary = T.boundary

/-- `∂T = 0` in `U`. -/
def BoundaryVanishes : {n : ℕ} → GeometricCurrentOn U n → Prop
  | 0, _ => True
  | _ + 1, T => T.boundary = 0

/-- `spt ∂T` (empty for `n = 0`). -/
def boundarySupport : {n : ℕ} → GeometricCurrentOn U n → Set (Euclid P)
  | 0, _ => ∅
  | _ + 1, T => T.boundary.support

/-- `M_W(∂T)` (zero for `n = 0`). -/
def boundaryMassOn : {n : ℕ} → GeometricCurrentOn U n → Set (Euclid P) → ℝ≥0∞
  | 0, _, _ => 0
  | _ + 1, T, W => T.boundary.massOn W

/-! ## Minimizing currents (Simon 7.1.1) -/

/-- `W ⊂⊂ U`: `closure W` is a compact subset of `U`. -/
def CompactlyContained (W U : Set (Euclid P)) : Prop :=
  IsCompact (closure W) ∧ closure W ⊆ U

/-- **Simon 7.1.1 (p. 181).**  The integer multiplicity `T ∈ 𝒟ₙ(U)` is *minimizing in `A`*
(`A ⊆ U`): `M_W(T) ≤ M_W(S)` whenever `W ⊂⊂ U` is open, `S ∈ 𝒟ₙ(U)` is integer multiplicity,
`∂S = ∂T` in `U` and `spt(S − T)` is a compact subset of `A ∩ W`.  Competitors are integer
multiplicity, as required by Remark 7.2.2(1) and the proofs of 7.1.4 and 7.2.4. -/
def IsMinimizingIn (T : GeometricCurrentOn U n) (A : Set (Euclid P)) : Prop :=
  IsIntegerMultiplicity T ∧
    ∀ (W : Set (Euclid P)) (S : GeometricCurrentOn U n), IsOpen W → CompactlyContained W U →
      IsIntegerMultiplicity S → SameBoundary S T → IsCompact (S - T).support →
        (S - T).support ⊆ A ∩ W → T.massOn W ≤ S.massOn W

/-! ## Densities, blow-ups, tangent cones (Simon 7.3) -/

/-- `ωₙ`, the Lebesgue measure of the unit ball of `ℝⁿ`. -/
def unitBallVolume (n : ℕ) : ℝ≥0∞ := volume (ball (0 : Euclid n) 1)

/-- `Θⁿ(μ_T, x) = θ`: `(ωₙρⁿ)⁻¹ μ_T(B_ρ(x)) → θ` as `ρ ↓ 0`, with `μ_T(B_ρ(x)) = M_{B_ρ(x)}(T)`
for small `ρ` (Simon 6.2.8; open and closed balls give the same limit). -/
def HasMassDensity (T : GeometricCurrentOn U n) (x : Euclid P) (θ : ℝ) : Prop :=
  0 ≤ θ ∧ Tendsto (fun ρ : ℝ => T.massOn (ball x ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n)))
    (𝓝[>] 0) (𝓝 (ENNReal.ofReal θ))

/-- Value of a current in `U` on an ambient form: `T(ω)` if `ω ∈ 𝒟ⁿ(U)`, else `0`.  Used for
convergence of currents on varying domains (Simon: "`η_{x,λⱼ#}T ⇀ C` in `ℝ^{n+ℓ}`"). -/
def currentEval (T : GeometricCurrentOn U n) (ω : DifferentialForm (Euclid P) n) : ℝ := by
  classical
  exact if h : IsTestForm ω ∧ tsupport ω ⊆ U then T ⟨ω, h⟩ else 0

/-- `Tⱼ ⇀ T` in `V`, for currents `Tⱼ ∈ 𝒟ₙ(Uⱼ)` whose domains eventually contain every compact
subset of `V` (as for blow-ups): `Tⱼ(ω) → T(ω)` for every `ω ∈ 𝒟ⁿ(V)` (Simon 6.2.13). -/
def ConvergesWeakly {Us : ℕ → Set (Euclid P)} (Ts : (j : ℕ) → GeometricCurrentOn (Us j) n)
    {V : Set (Euclid P)} (T : GeometricCurrentOn V n) : Prop :=
  ∀ ω : TestFormOn V n,
    Tendsto (fun j => currentEval (Ts j) (ω : DifferentialForm (Euclid P) n)) atTop (𝓝 (T ω))

/-- `μ_{Tⱼ} → μ_T` as Radon measures in `V` (Simon 7.2.4, Remark 7.2.5(1)): for all integer
multiplicity representations of the `Tⱼ` and of `T`, `∫ f dμ_{Tⱼ} → ∫ f dμ_T` for every
continuous `f` with compact support in `V`. -/
def MassMeasuresConverge {Us : ℕ → Set (Euclid P)} (Ts : (j : ℕ) → GeometricCurrentOn (Us j) n)
    {V : Set (Euclid P)} (T : GeometricCurrentOn V n) : Prop :=
  ∀ Rs : (j : ℕ) → IMRep (Us j) n, (∀ j, (Rs j).Represents (Ts j)) →
    ∀ R : IMRep V n, R.Represents T →
      ∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → tsupport f ⊆ V →
        Tendsto (fun j => ∫ x, f x ∂(Rs j).measure) atTop (𝓝 (∫ x, f x ∂R.measure))

/-- The linear part `y ↦ λ⁻¹y` of the dilation `η_{x,λ}`. -/
def dilationCLM (P : ℕ) (lam : ℝ) : Euclid P →L[ℝ] Euclid P :=
  lam⁻¹ • ContinuousLinearMap.id ℝ (Euclid P)

/-- Simon's dilation `η_{x,λ}(y) = λ⁻¹(y − x)`, written `y ↦ −λ⁻¹x + λ⁻¹y`. -/
def dilation (x : Euclid P) (lam : ℝ) : Euclid P → Euclid P :=
  fun y => -(lam⁻¹ • x) + dilationCLM P lam y

/-- The blow-up `η_{x,λ#}T ∈ 𝒟ₙ(η_{x,λ}(U))`, `η_{x,λ#}T(ω) = T(η_{x,λ}^# ω)` (Simon 6.2.23 for
the proper affine diffeomorphism `η_{x,λ}`, `λ ≠ 0`). -/
def blowUp (T : GeometricCurrentOn U n) (x : Euclid P) (lam : ℝ) (hlam : lam ≠ 0) :
    GeometricCurrentOn (dilation x lam '' U) n :=
  (T.restrictDomain (show (fun y => -(lam⁻¹ • x) + dilationCLM P lam y) ⁻¹'
      (dilation x lam '' U) ⊆ U by
    rintro y ⟨z, hz, hzy⟩
    have hzy' : lam⁻¹ • z = lam⁻¹ • y := by
      simpa [dilation, dilationCLM] using hzy
    rwa [← smul_right_injective (Euclid P) (inv_ne_zero hlam) hzy'])).affinePushforward
    (dilationCLM P lam) (-(lam⁻¹ • x)) (by
      convert ((Homeomorph.smulOfNeZero lam⁻¹ (inv_ne_zero hlam)).trans
        (Homeomorph.addLeft (-(lam⁻¹ • x)))).isProperMap using 1
      funext y
      simp [dilationCLM])

/-- `C ∈ 𝒟ₙ(ℝᴾ)` is a cone: `η_{0,λ#}C = C` for every `λ > 0` (Simon 7.3.1(2)). -/
def IsConeCurrent (C : GeometricCurrentOn (univ : Set (Euclid P)) n) : Prop :=
  ∀ (lam : ℝ) (hlam : 0 < lam) (ω : TestFormOn (univ : Set (Euclid P)) n),
    currentEval (blowUp C 0 lam hlam.ne') (ω : DifferentialForm (Euclid P) n) = C ω

/-- Simon 7.3.2(1): `C` is a tangent cone of `T` at `x`, i.e. `η_{x,λⱼ#}T ⇀ C` in `ℝᴾ` for some
sequence `λⱼ > 0`, `λⱼ → 0`. -/
def IsTangentConeAt (T : GeometricCurrentOn U n) (x : Euclid P)
    (C : GeometricCurrentOn (univ : Set (Euclid P)) n) : Prop :=
  ∃ (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), Tendsto lams atTop (𝓝 0) ∧
    ConvergesWeakly (fun j => blowUp T x (lams j) (hlams j).ne') C

/-- Simon 7.3.2(1): `T` has a (multiplicity `m`) tangent plane at `x`: some tangent cone has
support an `n`-dimensional subspace. -/
def HasTangentPlaneAt (T : GeometricCurrentOn U n) (x : Euclid P) : Prop :=
  ∃ C : GeometricCurrentOn (univ : Set (Euclid P)) n, IsTangentConeAt T x C ∧
    ∃ Q : Submodule ℝ (Euclid P), Module.finrank ℝ Q = n ∧ C.support = (Q : Set (Euclid P))

/-! ## Submanifolds, `reg T`, `sing T` (Simon Ch. 2, §4 and 7.4.1) -/

/-- Simon Ch. 2, §4, (4.1) (p. 55): `M ⊂ ℝᴾ` is a `d`-dimensional (embedded) `Cʳ` submanifold:
each `y ∈ M` has an open `W ∋ y` and a 1:1 `Cʳ` map `ψ : V → W`, `V ⊆ ℝᵈ` open, with
`ψ(V) = W ∩ M`, `ψ` proper, and `Dψ` of rank `d` on `V`. -/
def IsEmbeddedSubmanifold (r d : ℕ) (M : Set (Euclid P)) : Prop :=
  ∀ y ∈ M, ∃ (V : Set (Euclid d)) (W : Set (Euclid P)) (ψ : Euclid d → Euclid P),
    IsOpen V ∧ IsOpen W ∧ y ∈ W ∧ ContDiffOn ℝ r ψ V ∧ InjOn ψ V ∧ ψ '' V = W ∩ M ∧
      (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) ∧
      ∀ z ∈ V, Injective (fderiv ℝ ψ z)

/-- Simon Ch. 2, §4 (p. 55): `T_yM = {γ'(0) : γ ∈ C¹((−1,1); ℝᴾ), γ((−1,1)) ⊆ M, γ(0) = y}`. -/
def tangentSpace (M : Set (Euclid P)) (y : Euclid P) : Set (Euclid P) :=
  {v | ∃ γ : ℝ → Euclid P, ContDiffOn ℝ 1 γ (Ioo (-1) 1) ∧ MapsTo γ (Ioo (-1) 1) M ∧
    γ 0 = y ∧ HasDerivAt γ v 0}

/-- An orientation of the `d`-dimensional submanifold `M` (Simon 6.2.2): `ξ` is continuous on
`M` and `ξ(y) = ±τ₁ ∧ ⋯ ∧ τ_d` for an orthonormal basis `τ` of `T_yM`, for every `y ∈ M`. -/
def IsOrientation (d : ℕ) (M : Set (Euclid P)) (ξ : Euclid P → MultiVector P d) : Prop :=
  ContinuousOn ξ M ∧ ∀ y ∈ M, ∃ Q : Submodule ℝ (Euclid P),
    (Q : Set (Euclid P)) = tangentSpace M y ∧ IsUnitOrientationOf (ξ y) Q

/-- **Simon 7.4.1 (p. 193)**: `reg T` is the set of `y ∈ spt T` such that, for some `ρ > 0`
(with `B_ρ(y) ⊆ U`), `m ∈ ℤ \ {0}` and embedded `n`-dimensional oriented `C¹` submanifold `M`
(of locally finite `Hⁿ`-measure in `B_ρ(y)`, as `[[M]]` requires, 6.2.2), `T = m[[M]]` in
`B_ρ(y)` (6.2.16), i.e. `T(ω) = m ∫_M ⟨ω, ξ_M⟩ dHⁿ` whenever `spt ω ⊆ B_ρ(y)`.
The point `y` itself must lie on `M` (as in 4.4(8) and the proof of 5.8): otherwise a singular
point could be declared regular by deleting it from `M`, e.g. the vertex of the Simons cone. -/
def regularSet (T : GeometricCurrentOn U n) : Set (Euclid P) :=
  {y | y ∈ T.support ∧ ∃ ρ : ℝ, 0 < ρ ∧ ball y ρ ⊆ U ∧
    ∃ (m : ℤ) (M : Set (Euclid P)) (ξ : Euclid P → MultiVector P n), m ≠ 0 ∧ y ∈ M ∧
      IsEmbeddedSubmanifold 1 n M ∧ IsOrientation n M ξ ∧
      (∀ K : Set (Euclid P), IsCompact K → K ⊆ ball y ρ → μHE[n] (M ∩ K) ≠ ∞) ∧
      ∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ ball y ρ →
        T ω = m * ∫ x in M, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]}

/-- **Simon 7.4.1**: `sing T = spt T \ reg T`. -/
def singularSet (T : GeometricCurrentOn U n) : Set (Euclid P) :=
  T.support \ regularSet T

/-! ## The associated varifold `V = v(M, θ)` (Simon Ch. 4, 2.3–2.7 and 3.14) -/

/-- The approximate tangent plane `TₓM` (Ch. 3, 1.4; unique when it exists), `⊥` otherwise. -/
def approxTangentPlane (n : ℕ) (M : Set (Euclid P)) (x : Euclid P) :
    Submodule ℝ (Euclid P) := by
  classical
  exact if h : ∃ Q, HasApproximateTangentSpaceAt n M x Q then h.choose else ⊥

/-- `div_M X(x) = Σⱼ eⱼ · ∇^M Xʲ = trace(p_{TₓM} ∘ DX(x))` (Simon Ch. 4, 2.3). -/
def tangentialDivergence (n : ℕ) (M : Set (Euclid P)) (X : Euclid P → Euclid P)
    (x : Euclid P) : ℝ :=
  LinearMap.trace ℝ (Euclid P)
    ((approxTangentPlane n M x).starProjection.toLinearMap ∘ₗ (fderiv ℝ X x).toLinearMap)

/-- First variation `δV(X) = ∫_M div_M X dμ_V` of `V = v(M, θ)` (Simon Ch. 4, 2.2). -/
def IMRep.firstVariation (R : IMRep U n) (X : Euclid P → Euclid P) : ℝ :=
  ∫ x in R.carrier, (R.mult x : ℝ) * tangentialDivergence n R.carrier X x ∂μHE[n]

/-- Simon Ch. 4, 2.6 (computed form, p. 88): `V` is stationary in `U ∩ N`: `δV(X) = 0` for all
`X ∈ C¹_c(U; ℝᴾ)` with `X(x) ∈ TₓN` for every `x ∈ N ∩ U`. -/
def IMRep.IsStationaryAlong (R : IMRep U n) (N : Set (Euclid P)) : Prop :=
  ∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ U →
    (∀ x ∈ N ∩ U, X x ∈ tangentSpace N x) → R.firstVariation X = 0

/-- Simon Ch. 4, 3.14: `V` has generalized mean curvature `H` in `U`
(`∫ div_M X dμ_V = −∫ X · H dμ_V`, `X ∈ C¹_c(U; ℝᴾ)`), with `H` bounded on compact subsets. -/
def IMRep.HasLocallyBoundedMeanCurvature (R : IMRep U n) : Prop :=
  ∃ H : Euclid P → Euclid P, AEStronglyMeasurable H R.measure ∧
    (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ∃ Λ : ℝ, ∀ᵐ x ∂R.measure, x ∈ K → ‖H x‖ ≤ Λ) ∧
    ∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ U →
      R.firstVariation X = -∫ x, inner ℝ (X x) (H x) ∂R.measure

/-! ## Codimension one (Simon 7.5) -/

/-- Simon 7.5 (p. 197): `N ∈ 𝒪`, an oriented embedded `C²` submanifold of dimension `n + 1` with
`(N̄ \ N) ∩ U = ∅` and `N ∩ U ≠ ∅`, with chosen orientation `ξN`. -/
def InClassO (n : ℕ) (U N : Set (Euclid P)) (ξN : Euclid P → MultiVector P (n + 1)) : Prop :=
  IsEmbeddedSubmanifold 2 (n + 1) N ∧ IsOrientation (n + 1) N ξN ∧ (closure N \ N) ∩ U = ∅ ∧
    (N ∩ U).Nonempty

/-- Simon 7.5.1: `T = ∂[[E]]` in `U`, where `[[E]](ω) = ∫_E ⟨ω, ξ_N⟩ dH^{n+1}`. -/
def IsBoundaryOfRegion (T : GeometricCurrentOn U n) (E : Set (Euclid P))
    (ξN : Euclid P → MultiVector P (n + 1)) : Prop :=
  ∀ ω : TestFormOn U n,
    T ω = ∫ x in E, ξN x (exteriorDerivative (ω : DifferentialForm (Euclid P) n) x) ∂μHE[n + 1]

/-! ## Headline results -/

/-- **Simon 7.1.2 (Lemma, pp. 181–182).**  Let `N` be an embedded `C²` `(n+ℓ)`-dimensional
submanifold of `ℝ^{n+k}`, `(N̄ \ N) ∩ U = ∅`.  If `T ∈ 𝒟ₙ(U)` is minimizing in `N ∩ U`,
`spt T ⊆ N` and `∂T = 0` in `U`, then the associated varifold `V = v(M, θ)` (for any
representation `T = τ(M, θ, ξ)`) is stationary in `N ∩ U` (Ch. 4, 2.6) and has locally bounded
generalized mean curvature in `U` (Ch. 4, 3.14).
*Correction*: `spt T ⊆ N` and `(N̄ \ N) ∩ U = ∅` are implicit in the book (they are part of the
setting of Ch. 4, 2.5–2.6 and of §3); without `spt T ⊆ N` the lemma is false. -/
def MinimizingImpliesStationary : Prop :=
  ∀ (n k ℓ : ℕ), ℓ ≤ k → ∀ (U N : Set (Euclid (n + k))) (T : GeometricCurrentOn U n),
    IsOpen U → IsEmbeddedSubmanifold 2 (n + ℓ) N → (closure N \ N) ∩ U = ∅ →
    T.support ⊆ N → IsMinimizingIn T (N ∩ U) → BoundaryVanishes T →
    ∀ R : IMRep U n, R.Represents T → R.IsStationaryAlong N ∧ R.HasLocallyBoundedMeanCurvature

/-- **Simon 7.2.1 (Lemma, p. 183).**  Let `S ∈ 𝒟_{n−1}(ℝ^{n+ℓ})` be integer multiplicity with
`spt S` compact and `∂S = 0`.  Then there is an integer multiplicity `T ∈ 𝒟ₙ(ℝ^{n+ℓ})` with
`spt T` compact, `∂T = S`, and `M(T) ≤ M(R)` for every integer multiplicity `R` with `spt R`
compact and `∂R = S`.  Here `n = m + 2`: integer multiplicity currents have dimension `≥ 1`
(Ch. 6, §3).  *Correction*: the printed statement omits the conclusion `∂T = S` (proved: `T ∈ 𝓘_S`);
without it `T = 0` would do. -/
def ExistenceOfMinimizingFilling : Prop :=
  ∀ (m ℓ : ℕ) (S : GeometricCurrentOn (univ : Set (Euclid (m + 2 + ℓ))) (m + 1)),
    IsIntegerMultiplicity S → IsCompact S.support → S.boundary = 0 →
    ∃ T : GeometricCurrentOn (univ : Set (Euclid (m + 2 + ℓ))) (m + 2),
      IsIntegerMultiplicity T ∧ IsCompact T.support ∧ T.boundary = S ∧
      ∀ R : GeometricCurrentOn (univ : Set (Euclid (m + 2 + ℓ))) (m + 2),
        IsIntegerMultiplicity R → IsCompact R.support → R.boundary = S → T.mass ≤ R.mass

/-- **Simon 7.2.4 (Theorem, p. 184).**  If `Tⱼ` are minimizing in `U`,
`supⱼ (M_W(Tⱼ) + M_W(∂Tⱼ)) < ∞` for each open `W ⊂⊂ U`, and `Tⱼ ⇀ T ∈ 𝒟ₙ(U)`, then `T` is
(integer multiplicity, Remark 7.2.5(1), and) minimizing in `U`, and `μ_{Tⱼ} → μ_T` as Radon
measures in `U`. -/
def CompactnessOfMinimizingCurrents : Prop :=
  ∀ (n k : ℕ) (U : Set (Euclid (n + k))) (Ts : ℕ → GeometricCurrentOn U n)
      (T : GeometricCurrentOn U n),
    IsOpen U → (∀ j, IsMinimizingIn (Ts j) U) →
    (∀ W : Set (Euclid (n + k)), IsOpen W → CompactlyContained W U →
      ⨆ j, ((Ts j).massOn W + boundaryMassOn (Ts j) W) < ∞) →
    WeaklyConvergesOn Ts T → IsMinimizingIn T U ∧ MassMeasuresConverge (Us := fun _ => U) Ts T

/-- **Simon 7.3.1 (Theorem, p. 187).**  `N` as in 7.1.2 (`C²`).  If `T ∈ 𝒟ₙ(U)` is minimizing in
`U ∩ N` and `spt T ⊆ U ∩ N`, then (1) `Θⁿ(μ_T, x)` exists at every `x ∈ U \ spt ∂T` and is upper
semicontinuous there; (2) for `x ∈ spt T \ spt ∂T` and `λⱼ ↓ 0` (any `λⱼ > 0`, `λⱼ → 0`) there
are a subsequence `λⱼ'` and an integer multiplicity `C ∈ 𝒟ₙ(ℝ^{n+k})`, minimizing in `ℝ^{n+k}`,
with `η_{x,λⱼ'#}T ⇀ C`, `μ_{η_{x,λⱼ'#}T} → μ_C`, `η_{0,λ#}C = C` (`λ > 0`) and
`Θⁿ(μ_C, 0) = Θⁿ(μ_T, x)`.
*Correction*: the printed hypothesis "`x ∈ spt T \ spt ∂T`" and "(1) … everywhere in `U`" are
garbled; the monotonicity proof gives (1) on `U \ spt ∂T`, which is what is stated. -/
def DensityAndTangentCones : Prop :=
  ∀ (n k ℓ : ℕ), ℓ ≤ k → ∀ (U N : Set (Euclid (n + k))) (T : GeometricCurrentOn U n),
    IsOpen U → IsEmbeddedSubmanifold 2 (n + ℓ) N → (closure N \ N) ∩ U = ∅ →
    IsMinimizingIn T (U ∩ N) → T.support ⊆ U ∩ N →
    (∃ Θ : Euclid (n + k) → ℝ, (∀ x ∈ U \ boundarySupport T, HasMassDensity T x (Θ x)) ∧
        UpperSemicontinuousOn Θ (U \ boundarySupport T)) ∧
    ∀ x ∈ T.support \ boundarySupport T, ∀ (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j),
      Tendsto lams atTop (𝓝 0) →
      ∃ (φ : ℕ → ℕ) (C : GeometricCurrentOn (univ : Set (Euclid (n + k))) n), StrictMono φ ∧
        ConvergesWeakly (fun j => blowUp T x (lams (φ j)) (hlams (φ j)).ne') C ∧
        MassMeasuresConverge (fun j => blowUp T x (lams (φ j)) (hlams (φ j)).ne') C ∧
        IsMinimizingIn C univ ∧ IsConeCurrent C ∧
        ∃ θ : ℝ, HasMassDensity T x θ ∧ HasMassDensity C 0 θ

/-- **Simon 7.3.3 (Theorem, p. 189).**  `N` as in 7.3.1.  If `T` is minimizing in `U ∩ N`,
`spt T ⊆ U ∩ N` and `∂T = 0` in `U`, then (1) `Θⁿ(μ_T, x) ∈ ℤ` for all `x ∈ U \ E`, where
`H^{n−3+α}(E) = 0` for all `α > 0`; (2) there is `F ⊇ E` with `H^{n−2+α}(F) = 0` for all `α > 0`
such that `T` has a tangent plane at each `x ∈ spt T \ F`.
*Correction*: printed "`F ⊂ E`" must read `F ⊃ E` (non-integer density excludes tangent planes). -/
def IntegerDensityAndTangentPlanes : Prop :=
  ∀ (n k ℓ : ℕ), ℓ ≤ k → ∀ (U N : Set (Euclid (n + k))) (T : GeometricCurrentOn U n),
    IsOpen U → IsEmbeddedSubmanifold 2 (n + ℓ) N → (closure N \ N) ∩ U = ∅ →
    IsMinimizingIn T (U ∩ N) → T.support ⊆ U ∩ N → BoundaryVanishes T →
    ∃ E F : Set (Euclid (n + k)), E ⊆ F ∧
      (∀ α : ℝ, 0 < α → μH[(n : ℝ) - 3 + α] E = 0) ∧
      (∀ x ∈ U \ E, ∃ m : ℤ, HasMassDensity T x m) ∧
      (∀ α : ℝ, 0 < α → μH[(n : ℝ) - 2 + α] F = 0) ∧
      ∀ x ∈ T.support \ F, HasTangentPlaneAt T x

/-- **Simon 7.4.2 (Theorem, p. 194).**  If `T ∈ 𝒟ₙ(U)` is integer multiplicity and minimizing in
`U ∩ N` (`N` an embedded `C²` `(n+ℓ)`-submanifold, `(N̄ \ N) ∩ U = ∅`), `spt T ⊆ U ∩ N` and
`∂T = 0` in `U`, then `reg T` is dense in `spt T`. -/
def RegularSetDense : Prop :=
  ∀ (n k ℓ : ℕ), ℓ ≤ k → ∀ (U N : Set (Euclid (n + k))) (T : GeometricCurrentOn U n),
    IsOpen U → IsEmbeddedSubmanifold 2 (n + ℓ) N → (closure N \ N) ∩ U = ∅ →
    IsMinimizingIn T (U ∩ N) → T.support ⊆ U ∩ N → BoundaryVanishes T →
    T.support ⊆ closure (regularSet T)

/-- **Simon 7.4.3 (Theorem, p. 194)**, for a fixed `N` (`Nᵢ = N`).  Let `Tᵢ, T` be minimizing in
`U ∩ N`, `spt Tᵢ, spt T ⊆ N`, `∂Tᵢ = ∂T = 0` in `U`, `Tᵢ ⇀ T`, with
`supᵢ M_W(Tᵢ) < ∞` for `W ⊂⊂ U`.  If `y ∈ N ∩ U`, `Θⁿ(μ_T, y) = 1`, `y = lim yⱼ`, `yⱼ ∈ spt Tⱼ`,
then `y ∈ reg T` and `yⱼ ∈ reg Tⱼ` for all large `j`.
*Deviations*: the book allows `Nᵢ → N` "in the `C²` sense" (not defined at this point of the
book); we take `Nᵢ = N`.  The local mass bound is the hypothesis of 7.2.4, which the proof uses
for `μ_{Tⱼ} → μ_T`; it is added explicitly. -/
def DensityOneImpliesRegular : Prop :=
  ∀ (n k ℓ : ℕ), ℓ ≤ k → ∀ (U N : Set (Euclid (n + k))) (Ts : ℕ → GeometricCurrentOn U n)
      (T : GeometricCurrentOn U n) (ys : ℕ → Euclid (n + k)) (y : Euclid (n + k)),
    IsOpen U → IsEmbeddedSubmanifold 2 (n + ℓ) N → (closure N \ N) ∩ U = ∅ →
    (∀ j, IsMinimizingIn (Ts j) (U ∩ N)) → IsMinimizingIn T (U ∩ N) →
    (∀ j, (Ts j).support ⊆ N) → T.support ⊆ N →
    (∀ j, BoundaryVanishes (Ts j)) → BoundaryVanishes T →
    (∀ W : Set (Euclid (n + k)), IsOpen W → CompactlyContained W U → ⨆ j, (Ts j).massOn W < ∞) →
    WeaklyConvergesOn Ts T → y ∈ N ∩ U → HasMassDensity T y 1 →
    Tendsto ys atTop (𝓝 y) → (∀ j, ys j ∈ (Ts j).support) →
    y ∈ regularSet T ∧ ∀ᶠ j in atTop, ys j ∈ regularSet (Ts j)

/-- **Simon 7.4.4 (Theorem, p. 194).**  If `T` is as in 7.4.2 and `ξ ∈ spt T` has
`Θⁿ(μ_T, ξ) < 2`, then there is `ρ > 0` with `H^{n−2+α}(sing T ∩ B_ρ(ξ)) = 0` for all `α > 0`. -/
def SingularSetSmallWhereDensityBelowTwo : Prop :=
  ∀ (n k ℓ : ℕ), ℓ ≤ k → ∀ (U N : Set (Euclid (n + k))) (T : GeometricCurrentOn U n),
    IsOpen U → IsEmbeddedSubmanifold 2 (n + ℓ) N → (closure N \ N) ∩ U = ∅ →
    IsMinimizingIn T (U ∩ N) → T.support ⊆ U ∩ N → BoundaryVanishes T →
    ∀ ξ ∈ T.support, ∀ θ : ℝ, HasMassDensity T ξ θ → θ < 2 →
      ∃ ρ : ℝ, 0 < ρ ∧ ∀ α : ℝ, 0 < α → μH[(n : ℝ) - 2 + α] (singularSet T ∩ ball ξ ρ) = 0

/-- **Simon 7.4.5 (Theorem, p. 195).**  If `C ∈ 𝒟ₙ(ℝ^{n+k})` is minimizing in `ℝ^{n+k}`, `∂C = 0`,
`C` is a cone, and `spt C ⊆ H̄` for an open half-space `H = {x : v · x > 0}` (`v ≠ 0`, so
`0 ∈ ∂H`), then `spt C ⊆ ∂H`. -/
def HalfSpaceConeLiesInBoundary : Prop :=
  ∀ (n k : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid (n + k))) n) (v : Euclid (n + k)),
    IsMinimizingIn C univ → BoundaryVanishes C → IsConeCurrent C → v ≠ 0 →
    C.support ⊆ closure {x | 0 < inner ℝ v x} → C.support ⊆ frontier {x | 0 < inner ℝ v x}

/-- **Simon 7.5.8 (Theorem, p. 200).**  Let `N ∈ 𝒪` (oriented by `ξN`), `E ⊆ N ∩ U`
`H^{n+1}`-measurable, `T = ∂[[E]] ∈ 𝒟ₙ(U)` integer multiplicity and minimizing in `N ∩ U`.  Then
`sing T = ∅` if `n ≤ 6`; `sing T` is locally finite in `U` (finite on compact subsets of `U`) if
`n = 7`; `H^{n−7+α}(sing T) = 0` for all `α > 0` if `n > 7`.  (`N = ℝ^{n+1}` is the case `k = 1`.)
-/
def CodimensionOneRegularity : Prop :=
  ∀ (n k : ℕ) (U N E : Set (Euclid (n + k))) (ξN : Euclid (n + k) → MultiVector (n + k) (n + 1))
      (T : GeometricCurrentOn U n),
    IsOpen U → InClassO n U N ξN → MeasurableSet E → E ⊆ N ∩ U → IsBoundaryOfRegion T E ξN →
    IsMinimizingIn T (N ∩ U) →
    (n ≤ 6 → singularSet T = ∅) ∧
    (n = 7 → ∀ K : Set (Euclid (n + k)), IsCompact K → K ⊆ U → (singularSet T ∩ K).Finite) ∧
    (7 < n → ∀ α : ℝ, 0 < α → μH[(n : ℝ) - 7 + α] (singularSet T) = 0)

/-- **Simon 7.5.11 (Corollary, p. 202).**  If `T` is as in 7.5.8, `T = τ(M, θ, ξ)`, and
`T₁ ∈ 𝒟ₙ(U)` is obtained by equipping a connected component `M₁` of `reg T` with multiplicity
`1` and the orientation `ξ` of `T`, then `∂T₁ = 0` in `U` and `T₁` is minimizing in `U ∩ N`. -/
def RegularComponentsAreMinimizing : Prop :=
  ∀ (n k : ℕ) (U N E : Set (Euclid (n + k))) (ξN : Euclid (n + k) → MultiVector (n + k) (n + 1))
      (T : GeometricCurrentOn U n),
    IsOpen U → InClassO n U N ξN → MeasurableSet E → E ⊆ N ∩ U → IsBoundaryOfRegion T E ξN →
    IsMinimizingIn T (N ∩ U) →
    ∀ R : IMRep U n, R.Represents T → ∀ y ∈ regularSet T, ∀ T₁ : GeometricCurrentOn U n,
      (∀ ω : TestFormOn U n, T₁ ω = ∫ x in connectedComponentIn (regularSet T) y,
        R.orient x ((ω : DifferentialForm (Euclid (n + k)) n) x) ∂μHE[n]) →
      BoundaryVanishes T₁ ∧ IsMinimizingIn T₁ (U ∩ N)

end

/-- **Uniqueness of planes**: fact (b) in the proof of `idtp_tdc_density_locally_constant`, the
local constancy of the density of a two-dimensional minimizing cone away from `0`.  There it
identifies the plane of a planar piece of `spt C` near a point.  Let `Q₁, Q₂` be linear subspaces
of `ℝᴾ`, `x ∈ Q₁` and `t > 0`.  If `Q₁ ∩ B_t(x) = Q₂ ∩ B_t(x)`, then `Q₁ = Q₂`.  First,
`x ∈ Q₁ ∩ B_t(x) = Q₂ ∩ B_t(x)`, so `x ∈ Q₂`.  Next, let `x ∈ Q`, `x ∈ Q'` and `Q ∩ B_t(x) ⊆ Q'`.
For `v ∈ Q` and `s = t / (2(‖v‖ + 1)) > 0`, the point `x + s v` lies in `Q ∩ B_t(x) ⊆ Q'`, so
`s v ∈ Q'` and `v ∈ Q'`.  This gives `Q₁ ≤ Q₂` and `Q₂ ≤ Q₁`. -/
theorem Submission.idtp_tdc_dlc_subspace_eq_of_inter_ball_eq : ∀ (P : ℕ) (Q₁ Q₂ : Submodule ℝ (Euclid P)) (x : Euclid P) (t : ℝ), x ∈ Q₁ → 0 < t → (Q₁ : Set (Euclid P)) ∩ ball x t = (Q₂ : Set (Euclid P)) ∩ ball x t → Q₁ = Q₂ := by
  intro P Q₁ Q₂ x t hx ht h
  -- Step 1: `x ∈ Q₂`, as `x ∈ Q₁ ∩ B_t(x) = Q₂ ∩ B_t(x)`.
  have hx₂ : x ∈ Q₂ := (h.subset ⟨hx, Metric.mem_ball_self ht⟩).1
  -- Step 2: if `x ∈ Q`, `x ∈ Q'` and `Q ∩ B_t(x) ⊆ Q'`, then `Q ≤ Q'`.  For `v ∈ Q` and
  -- `s = t / (2(‖v‖ + 1)) > 0`, `x + s • v ∈ Q` and `dist (x + s • v) x = s‖v‖ < t`, so
  -- `x + s • v ∈ Q'`; then `s • v = (x + s • v) - x ∈ Q'` and `v ∈ Q'` as `s ≠ 0`.
  have key : ∀ Q Q' : Submodule ℝ (Euclid P), x ∈ Q → x ∈ Q' →
      (Q : Set (Euclid P)) ∩ ball x t ⊆ Q' → Q ≤ Q' := by
    intro Q Q' hxQ hxQ' hsub v hv
    have hs : 0 < t / (2 * (‖v‖ + 1)) := div_pos ht (by positivity)
    have hball : x + (t / (2 * (‖v‖ + 1))) • v ∈ ball x t := by
      rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hs.le,
        div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
      nlinarith [norm_nonneg v]
    have h₁ : x + (t / (2 * (‖v‖ + 1))) • v ∈ Q' := hsub ⟨Q.add_mem hxQ (Q.smul_mem _ hv), hball⟩
    exact (Q'.smul_mem_iff hs.ne').1 ((Q'.add_mem_iff_right hxQ').1 h₁)
  -- Step 3: `Q₁ ∩ B_t(x) ⊆ Q₂` and `Q₂ ∩ B_t(x) ⊆ Q₁`; conclude by antisymmetry.
  exact le_antisymm (key Q₁ Q₂ hx hx₂ (h.subset.trans inter_subset_left))
    (key Q₂ Q₁ hx₂ hx (h.symm.subset.trans inter_subset_left))
/-- Radial projection to the unit sphere at most doubles the distance to a unit vector: if
`y ≠ 0` and `|w| = 1`, then `|y/|y| − w| ≤ 2|y − w|` (fact (e) in the proof that the density of a
2-dimensional minimizing cone is locally constant).  `|y/|y| − y| = |1/|y| − 1| |y| = |1 − |y||`,
and `|1 − |y|| = ||w| − |y|| ≤ |y − w|` by the reverse triangle inequality; conclude by the
triangle inequality through `y`. -/
theorem Submission.idtp_tdc_dlc_normalize_dist_le : ∀ (P : ℕ) (y w : Euclid P), y ≠ 0 → ‖w‖ = 1 → ‖‖y‖⁻¹ • y - w‖ ≤ 2 * ‖y - w‖ := by
  intro P y w hy hw
  have hy0 : 0 < ‖y‖ := norm_pos_iff.mpr hy
  -- `‖y‖⁻¹ • y - y = (‖y‖⁻¹ - 1) • y` has norm `|‖y‖⁻¹ - 1| ‖y‖ = |1 - ‖y‖|`
  have h1 : ‖‖y‖⁻¹ • y - y‖ = |1 - ‖y‖| := by
    have e : (‖y‖⁻¹ - 1) * ‖y‖ = 1 - ‖y‖ := by
      rw [sub_mul, inv_mul_cancel₀ hy0.ne', one_mul]
    rw [← e, abs_mul, abs_of_pos hy0, ← Real.norm_eq_abs, ← norm_smul, sub_smul, one_smul]
  -- reverse triangle inequality, as `‖w‖ = 1`
  have h2 : |1 - ‖y‖| ≤ ‖y - w‖ := by
    rw [← hw, norm_sub_rev y w]
    exact abs_norm_sub_norm_le w y
  calc ‖‖y‖⁻¹ • y - w‖ ≤ ‖‖y‖⁻¹ • y - y‖ + ‖y - w‖ := norm_sub_le_norm_sub_add_norm_sub _ _ _
    _ ≤ 2 * ‖y - w‖ := by rw [h1]; linarith
/-- An orthonormal partner of a unit vector in a 2-plane (Gram–Schmidt in `Q`, used in the proof of
Simon 7.3.3(1), p. 191, for 2-dimensional minimizing cones): if `Q ⊆ ℝᴾ` is a subspace with
`dim Q = 2` and `z ∈ Q` has `‖z‖ = 1`, there is `e ∈ Q` with `‖e‖ = 1` and `⟪z, e⟫ = 0`, and
`w = ⟪w, z⟫ z + ⟪w, e⟫ e` for every `w ∈ Q`.  As `dim Q = 2 > 1 = dim ℝz`, some `u ∈ Q` lies off
the line `ℝz`, and `e` is the normalization of `u - ⟪z, u⟫ z`.  `(z, e)` is orthonormal, so
`span {z, e} ⊆ Q` has dimension `2` and equals `Q`; the residual `w - ⟪w, z⟫ z - ⟪w, e⟫ e` lies in
it and is orthogonal to `z` and `e`, hence vanishes. -/
theorem Submission.idtp_tdc_dlc_ld_orthonormal_partner : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (z : Euclid P), Module.finrank ℝ Q = 2 → z ∈ Q → ‖z‖ = 1 → ∃ e : Euclid P, e ∈ Q ∧ ‖e‖ = 1 ∧ inner ℝ z e = 0 ∧ ∀ w ∈ Q, w = inner ℝ w z • z + inner ℝ w e • e := by
  intro P Q z hQ hzQ hz
  have hzz : inner ℝ z z = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, hz, one_pow]
  -- `Q ⊄ ℝ ∙ z`, since `finrank (ℝ ∙ z) = 1 < 2 = finrank Q`
  have hz0 : z ≠ 0 := by
    rintro rfl
    rw [norm_zero] at hz
    exact zero_ne_one hz
  obtain ⟨u, huQ, hu⟩ : ∃ u ∈ Q, u ∉ ℝ ∙ z := by
    refine IsConcreteLE.not_le_iff_exists.mp fun hle => ?_
    have h := Submodule.finrank_mono hle
    rw [hQ, finrank_span_singleton hz0] at h
    omega
  -- `v = u - ⟪z, u⟫ z` is a nonzero vector of `Q` orthogonal to `z`
  obtain ⟨v, hvQ, hv0, hzv⟩ : ∃ v ∈ Q, v ≠ 0 ∧ inner ℝ z v = (0 : ℝ) := by
    refine ⟨u - inner ℝ z u • z, Q.sub_mem huQ (Q.smul_mem _ hzQ), fun h => ?_, ?_⟩
    · exact hu (Submodule.mem_span_singleton.mpr ⟨inner ℝ z u, (sub_eq_zero.mp h).symm⟩)
    · rw [inner_sub_right, real_inner_smul_right, hzz, mul_one, sub_self]
  -- `e = ‖v‖⁻¹ • v` is a unit vector of `Q` orthogonal to `z`
  obtain ⟨e, heQ, he, hze⟩ : ∃ e ∈ Q, ‖e‖ = 1 ∧ inner ℝ z e = (0 : ℝ) := by
    refine ⟨‖v‖⁻¹ • v, Q.smul_mem _ hvQ, ?_, ?_⟩
    · rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ (norm_ne_zero_iff.mpr hv0)]
    · rw [real_inner_smul_right, hzv, mul_zero]
  have hez : inner ℝ e z = (0 : ℝ) := by rw [real_inner_comm, hze]
  have hee : inner ℝ e e = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, he, one_pow]
  refine ⟨e, heQ, he, hze, fun w hwQ => ?_⟩
  -- `(z, e)` is orthonormal, so `span {z, e} ≤ Q` has dimension `2` and equals `Q`
  have hon : Orthonormal ℝ ![z, e] := by
    rw [orthonormal_iff_ite]
    intro i j
    fin_cases i <;> fin_cases j <;> simp [hz, he, hze, hez]
  have hspan : Submodule.span ℝ (range ![z, e]) = Q := by
    refine Submodule.eq_of_le_of_finrank_eq ?_ ?_
    · rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      fin_cases i
      · exact hzQ
      · exact heQ
    · rw [finrank_span_eq_card hon.linearIndependent, Fintype.card_fin, hQ]
  -- the residual `d = w - ⟪w, z⟫ z - ⟪w, e⟫ e` lies in `Q = span {z, e}` and is orthogonal to `z`
  -- and `e`, so `⟪d, d⟫ = 0`
  obtain ⟨d, hd⟩ : ∃ d, d = w - (inner ℝ w z • z + inner ℝ w e • e) := ⟨_, rfl⟩
  have hdz : inner ℝ d z = (0 : ℝ) := by
    rw [hd, inner_sub_left, inner_add_left, real_inner_smul_left, real_inner_smul_left, hzz, hez,
      mul_one, mul_zero, add_zero, sub_self]
  have hde : inner ℝ d e = (0 : ℝ) := by
    rw [hd, inner_sub_left, inner_add_left, real_inner_smul_left, real_inner_smul_left, hze, hee,
      mul_zero, mul_one, zero_add, sub_self]
  have hdQ : d ∈ Q := hd ▸ Q.sub_mem hwQ (Q.add_mem (Q.smul_mem _ hzQ) (Q.smul_mem _ heQ))
  rw [← hspan] at hdQ
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp hdQ
  rw [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_zero] at hc
  have hdd : inner ℝ d d = (0 : ℝ) := by
    rw [← hc, inner_add_left, real_inner_smul_left, real_inner_smul_left, real_inner_comm,
      real_inner_comm (c 0 • z + c 1 • e) e, hc, hdz, hde, mul_zero, mul_zero, add_zero]
  rw [← sub_eq_zero, ← hd]
  exact inner_self_eq_zero.mp hdd
/-- Points of a unit great-circle arc (used in the proof of Simon 7.3.3(1), pp. 191–192, for
2-dimensional minimizing cones): if `z, e ∈ ℝᴾ` are orthonormal and `φ ≥ 0`, then
`a = cos φ z + sin φ e` is a unit vector with `‖a − z‖ ≤ φ`.  By Pythagoras
`‖s z + t e‖² = s² + t²`, so `‖a‖² = cos² φ + sin² φ = 1` and
`‖a − z‖² = (cos φ − 1)² + sin² φ = 2 − 2 cos φ ≤ φ²`, as `1 − φ²/2 ≤ cos φ`. -/
theorem Submission.idtp_tdc_dlc_ld_arc_point_bounds : ∀ (P : ℕ) (z e : Euclid P) (φ : ℝ), ‖z‖ = 1 → ‖e‖ = 1 → inner ℝ z e = 0 → 0 ≤ φ → ‖Real.cos φ • z + Real.sin φ • e‖ = 1 ∧ ‖Real.cos φ • z + Real.sin φ • e - z‖ ≤ φ := by
  intro P z e φ hz he hze hφ
  -- Pythagoras: `‖s z + t e‖² = s² + t²` for orthonormal `z, e`
  have hpyth : ∀ s t : ℝ, ‖s • z + t • e‖ ^ 2 = s ^ 2 + t ^ 2 := by
    intro s t
    rw [norm_add_sq_real, norm_smul, norm_smul, real_inner_smul_left, real_inner_smul_right, hze,
      hz, he, Real.norm_eq_abs, Real.norm_eq_abs]
    ring_nf
    rw [sq_abs, sq_abs]
  refine ⟨?_, ?_⟩
  · have h := hpyth (Real.cos φ) (Real.sin φ)
    rw [Real.cos_sq_add_sin_sq] at h
    exact (pow_eq_one_iff_of_nonneg (norm_nonneg _) two_ne_zero).mp h
  · -- `a − z = (cos φ − 1) z + sin φ e`, so `‖a − z‖² = 2 − 2 cos φ ≤ φ²`
    have hsub : Real.cos φ • z + Real.sin φ • e - z = (Real.cos φ - 1) • z + Real.sin φ • e := by
      rw [sub_smul, one_smul]
      abel
    have h := hpyth (Real.cos φ - 1) (Real.sin φ)
    rw [← hsub] at h
    have hsq : ‖Real.cos φ • z + Real.sin φ • e - z‖ ^ 2 ≤ φ ^ 2 := by
      rw [h]
      nlinarith [Real.cos_sq_add_sin_sq φ, Real.one_sub_sq_div_two_le_cos (x := φ)]
    exact (sq_le_sq₀ (norm_nonneg _) hφ).mp hsq
/-- Angle parametrization of a unit vector in the plane of an orthonormal pair (used in the proof
of Simon 7.3.3(1), p. 191, for 2-dimensional minimizing cones): if `‖z‖ = ‖e‖ = 1`, `z ⊥ e`, and
the unit vector `w = ⟨w, z⟩z + ⟨w, e⟩e` has `‖w − z‖ < L/2`, then `w = cos θ z + sin θ v` with
`0 ≤ θ < L` and `v = ±e`.  For `α = ⟨w, z⟩`, `β = ⟨w, e⟩`, `α² + β² = ⟨w, αz + βe⟩ = ‖w‖² = 1`,
so `θ = arccos α ∈ [0, π]` has `cos θ = α` and `sin θ = √(1 − α²) = |β|`, and `v = ±e` absorbs
the sign of `β`.  The chord is `‖w − z‖² = 2 − 2cos θ = 4sin²(θ/2)`, so `‖w − z‖ = 2sin(θ/2)`,
and Jordan's inequality `(2/π)x ≤ sin x` (`0 ≤ x ≤ π/2`) gives `θ ≤ (π/2)‖w − z‖ < πL/4 ≤ L`.
The hypotheses `‖e‖ = 1` and `⟨z, e⟩ = 0` are not needed. -/
theorem Submission.idtp_tdc_dlc_ld_unit_vector_angle : ∀ (P : ℕ) (z e w : Euclid P) (L : ℝ), ‖z‖ = 1 → ‖e‖ = 1 → inner ℝ z e = 0 → ‖w‖ = 1 → w = inner ℝ w z • z + inner ℝ w e • e → ‖w - z‖ < L / 2 → ∃ (θ : ℝ) (v : Euclid P), 0 ≤ θ ∧ θ < L ∧ (v = e ∨ v = -e) ∧ w = Real.cos θ • z + Real.sin θ • v := by
  intro P z e w L hz _he _hze hw hwd hL
  -- `α = ⟨w, z⟩` and `β = ⟨w, e⟩` satisfy `α² + β² = ⟨w, αz + βe⟩ = ‖w‖² = 1`
  have hsq : inner ℝ w z ^ 2 + inner ℝ w e ^ 2 = 1 := by
    have h : inner ℝ w (inner ℝ w z • z + inner ℝ w e • e) = 1 := by
      rw [← hwd, real_inner_self_eq_norm_sq, hw, one_pow]
    rw [inner_add_right, real_inner_smul_right, real_inner_smul_right] at h
    linear_combination h
  have hα₁ : -1 ≤ inner ℝ w z := by nlinarith [sq_nonneg (inner ℝ w e)]
  have hα₂ : inner ℝ w z ≤ 1 := by nlinarith [sq_nonneg (inner ℝ w e)]
  -- `θ = arccos α ∈ [0, π]` has `cos θ = α` and `sin θ = √(1 - α²) = |β|`
  obtain ⟨θ, hθ₀, hθπ, hcos, hsin⟩ : ∃ θ : ℝ, 0 ≤ θ ∧ θ ≤ Real.pi ∧
      Real.cos θ = inner ℝ w z ∧ Real.sin θ = |inner ℝ w e| := by
    refine ⟨Real.arccos (inner ℝ w z), Real.arccos_nonneg _, Real.arccos_le_pi _,
      Real.cos_arccos hα₁ hα₂, ?_⟩
    rw [Real.sin_arccos, ← Real.sqrt_sq_eq_abs]
    congr 1
    linarith
  -- `‖w - z‖² = 2 - 2 cos θ = (2 sin(θ/2))²` with `sin(θ/2) ≥ 0`, so `‖w - z‖ = 2 sin(θ/2)`
  have hs₀ : 0 ≤ Real.sin (θ / 2) :=
    Real.sin_nonneg_of_nonneg_of_le_pi (by linarith) (by linarith [Real.pi_pos])
  have hchord : ‖w - z‖ = 2 * Real.sin (θ / 2) := by
    have h₁ := norm_sub_sq_real w z
    have h₂ := Real.cos_two_mul_eq_one_sub (θ / 2)
    rw [show 2 * (θ / 2) = θ by ring, hcos] at h₂
    rw [hw, hz, h₂] at h₁
    refine (pow_left_inj₀ (norm_nonneg _) (by linarith) two_ne_zero).mp ?_
    rw [h₁]
    ring
  -- Jordan's inequality `(2/π)(θ/2) ≤ sin(θ/2)` gives `θ ≤ (π/2)‖w - z‖ < πL/4 ≤ L`
  have hθL : θ < L := by
    have hπ := Real.pi_pos
    have hJ := Real.mul_le_sin (x := θ / 2) (by linarith) (by linarith)
    have hL₀ : 0 < L := by linarith [norm_nonneg (w - z)]
    have h₁ : θ / Real.pi < L / 4 := by
      have : 2 / Real.pi * (θ / 2) = θ / Real.pi := by ring
      linarith
    rw [div_lt_iff₀ hπ] at h₁
    have h₂ := mul_le_mul_of_nonneg_left Real.pi_le_four (by linarith : (0 : ℝ) ≤ L / 4)
    linarith
  -- `v = ±e` absorbs the sign of `β`: `sin θ • v = |β| • v = β • e`
  rcases le_or_gt 0 (inner ℝ w e) with hβ | hβ
  · refine ⟨θ, e, hθ₀, hθL, Or.inl rfl, ?_⟩
    rw [hcos, hsin, abs_of_nonneg hβ]
    exact hwd
  · refine ⟨θ, -e, hθ₀, hθL, Or.inr rfl, ?_⟩
    rw [hcos, hsin, abs_of_neg hβ, neg_smul_neg]
    exact hwd
/-- **Real induction on `[0, L)`** (the first-failure argument of the arc continuation): if
`G 0`, `G` propagates a little to the right of every `φ ∈ [0, L)` where it holds, and `G φ`
holds at every `φ ∈ (0, L)` such that `G` holds on `[0, φ)`, then `G` holds on `[0, L)`.  At
`s = inf {φ ∈ [0, L) : ¬G φ}`, `G` holds on `[0, s)`, hence at `s`, hence on `[s, s + ε)`, so
`s + ε` would be a lower bound of the failure set. -/
theorem Submission.idtp_tdc_acont_real_induction : ∀ (G : ℝ → Prop) (L : ℝ), G 0 → (∀ φ : ℝ, 0 ≤ φ → φ < L → G φ → ∃ ε : ℝ, 0 < ε ∧ ∀ ψ : ℝ, φ < ψ → ψ < φ + ε → G ψ) → (∀ φ : ℝ, 0 < φ → φ < L → (∀ ψ : ℝ, 0 ≤ ψ → ψ < φ → G ψ) → G φ) → ∀ φ : ℝ, 0 ≤ φ → φ < L → G φ := by
  intro G L h0 hright hleft φ₁ hφ₁0 hφ₁L
  by_contra hφ₁
  -- step 1: the failure set `A ⊆ [0, L)` is nonempty and bounded below by `0`; `s := inf A`
  let A : Set ℝ := {φ | 0 ≤ φ ∧ φ < L ∧ ¬G φ}
  have hAne : A.Nonempty := ⟨φ₁, hφ₁0, hφ₁L, hφ₁⟩
  have hAbdd : BddBelow A := ⟨0, fun φ hφ => hφ.1⟩
  have hsA : ∀ φ ∈ A, sInf A ≤ φ := fun φ hφ => csInf_le hAbdd hφ
  -- step 2: `0 ≤ s < L`
  have hs0 : 0 ≤ sInf A := le_csInf hAne fun φ hφ => hφ.1
  have hsL : sInf A < L := (hsA φ₁ ⟨hφ₁0, hφ₁L, hφ₁⟩).trans_lt hφ₁L
  -- step 3: `G` holds on `[0, s)`
  have hbelow : ∀ ψ : ℝ, 0 ≤ ψ → ψ < sInf A → G ψ := fun ψ hψ0 hψs =>
    by_contra fun hψ => (hsA ψ ⟨hψ0, hψs.trans hsL, hψ⟩).not_gt hψs
  -- step 4: `G s`, by (a) if `s = 0` and by (c) if `s > 0`
  have hGs : G (sInf A) := by
    rcases hs0.eq_or_lt with h | h
    · exact h ▸ h0
    · exact hleft (sInf A) h hsL hbelow
  -- step 5: (b) at `s`
  obtain ⟨ε, hε, hεG⟩ := hright (sInf A) hs0 hsL hGs
  -- step 6: `s + ε` is a lower bound of `A`
  have hlb : ∀ φ ∈ A, sInf A + ε ≤ φ := by
    intro φ hφ
    by_contra hlt
    rcases (hsA φ hφ).eq_or_lt with h | h
    · exact hφ.2.2 (h ▸ hGs)
    · exact hφ.2.2 (hεG φ h (not_le.mp hlt))
  -- step 7: `s + ε ≤ inf A = s`, contradicting `ε > 0`
  linarith [le_csInf hAne hlb]
/-- Great-circle parametrisation (step 0(b) and step 4 of `idtp_tdc_arc_continuation`).  For
orthonormal `z, e ∈ ℝᴾ`, `γ(φ) = cos φ·z + sin φ·e` is a unit vector with
`|γ(φ) − γ(ψ)|² = 2 − 2 cos(φ − ψ) ≤ (φ − ψ)²`, `ν(φ) = sin φ·z − cos φ·e` is a unit vector
orthogonal to `γ(φ)`, and `cos ψ·γ(φ) + sin ψ·ν(φ) = γ(φ − ψ)` by the subtraction formulas. -/
theorem Submission.idtp_tdc_acont_great_circle : ∀ (P : ℕ) (z e : Euclid P), ‖z‖ = 1 → ‖e‖ = 1 → inner ℝ z e = 0 → (∀ φ : ℝ, ‖Real.cos φ • z + Real.sin φ • e‖ = 1) ∧ (∀ φ ψ : ℝ, ‖(Real.cos φ • z + Real.sin φ • e) - (Real.cos ψ • z + Real.sin ψ • e)‖ ≤ |φ - ψ|) ∧ ∀ φ : ℝ, ‖Real.sin φ • z - Real.cos φ • e‖ = 1 ∧ inner ℝ (Real.cos φ • z + Real.sin φ • e) (Real.sin φ • z - Real.cos φ • e) = 0 ∧ ∀ ψ : ℝ, Real.cos ψ • (Real.cos φ • z + Real.sin φ • e) + Real.sin ψ • (Real.sin φ • z - Real.cos φ • e) = Real.cos (φ - ψ) • z + Real.sin (φ - ψ) • e := by
  intro P z e hz he hze
  -- Step 1: Gram data `⟨z, z⟩ = ⟨e, e⟩ = 1`, `⟨e, z⟩ = 0`
  have hzz : inner ℝ z z = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, hz, one_pow]
  have hee : inner ℝ e e = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, he, one_pow]
  have hez : inner ℝ e z = (0 : ℝ) := by rw [real_inner_comm, hze]
  -- Step 2: `|α·z + β·e|² = α² + β²`
  have hcomb : ∀ a b : ℝ, ‖a • z + b • e‖ ^ 2 = a ^ 2 + b ^ 2 := by
    intro a b
    rw [← real_inner_self_eq_norm_sq]
    simp only [inner_add_left, inner_add_right, real_inner_smul_left, real_inner_smul_right, hzz,
      hee, hze, hez]
    ring
  -- Step 3: `|v|² = 1 → |v| = 1`
  have hunit : ∀ v : Euclid P, ‖v‖ ^ 2 = 1 → ‖v‖ = 1 := fun v hv =>
    (pow_eq_one_iff_of_nonneg (norm_nonneg v) two_ne_zero).1 hv
  refine ⟨fun φ => hunit _ (by rw [hcomb, Real.cos_sq_add_sin_sq]), fun φ ψ => ?_,
    fun φ => ⟨?_, ?_, fun ψ => ?_⟩⟩
  -- Step 5: `|γ(φ) − γ(ψ)|² = 2 − 2 cos(φ − ψ) ≤ (φ − ψ)²`
  · have hdiff : (Real.cos φ • z + Real.sin φ • e) - (Real.cos ψ • z + Real.sin ψ • e) =
        (Real.cos φ - Real.cos ψ) • z + (Real.sin φ - Real.sin ψ) • e := by module
    have hcos := Real.one_sub_sq_div_two_le_cos (x := φ - ψ)
    rw [Real.cos_sub] at hcos
    rw [hdiff, ← pow_le_pow_iff_left₀ (norm_nonneg _) (abs_nonneg _) two_ne_zero, hcomb, sq_abs]
    nlinarith [Real.cos_sq_add_sin_sq φ, Real.cos_sq_add_sin_sq ψ]
  -- Step 6: `|ν(φ)| = 1`
  · rw [sub_eq_add_neg, ← neg_smul]
    exact hunit _ (by rw [hcomb, neg_sq, Real.sin_sq_add_cos_sq])
  -- Step 7: `⟨γ(φ), ν(φ)⟩ = 0`
  · simp only [inner_add_left, inner_sub_right, real_inner_smul_left, real_inner_smul_right, hzz,
      hee, hze, hez]
    ring
  -- Step 8: `cos ψ·γ(φ) + sin ψ·ν(φ) = γ(φ − ψ)`
  · rw [Real.cos_sub, Real.sin_sub]
    module
/-- Dilation invariance of a cone `C ∈ 𝒟ₙ(ℝᴾ)` (used in the proof of Simon 7.3.3(1), p. 191, for
2-dimensional minimizing cones): for `s > 0`, `M_{sW}(C) = sⁿ M_W(C)` for every `W ⊆ ℝᴾ`,
`sx ∈ spt C ⟺ x ∈ spt C`, and `Θⁿ(μ_C, sx) = θ ⟺ Θⁿ(μ_C, x) = θ`.  The pullback by
`η_{0,1/t}(y) = ty` multiplies `n`-covectors by `tⁿ`, so the cone identity `η_{0,1/t#}C = C`
gives `C(ω(t⁻¹ ·)) = tⁿ C(ω)` for `t > 0`.  The substitution `ω ↦ ω(s⁻¹ ·)` maps the forms
admissible for `M_W` onto those admissible for `M_{sW}`, and the forms supported in `V` onto those
supported in `sV`; this gives the mass scaling and the invariance of `spt C`.  As
`sB_{ρ/s}(x) = B_ρ(sx)`, the density ratio at `sx` and radius `ρ` is the ratio at `x` and radius
`ρ/s`.  The integer multiplicity hypothesis is not needed. -/
theorem Submission.idtp_tdc_cone_dilation : ∀ (P n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n), IsIntegerMultiplicity C → IsConeCurrent C → ∀ s : ℝ, 0 < s → (∀ W : Set (Euclid P), C.massOn ((fun x => s • x) '' W) = ENNReal.ofReal (s ^ n) * C.massOn W) ∧ (∀ x : Euclid P, s • x ∈ C.support ↔ x ∈ C.support) ∧ ∀ (x : Euclid P) (θ : ℝ), HasMassDensity C (s • x) θ ↔ HasMassDensity C x θ := by
  intro P n C _hIM hcone s hs
  -- `x ↦ ω(t • x)` is again a test form on `ℝᴾ` for `t ≠ 0`
  have hscale : ∀ t : ℝ, t ≠ 0 → ∀ ω : TestFormOn (univ : Set (Euclid P)) n,
      (fun x => (ω : DifferentialForm (Euclid P) n) (t • x)) ∈
        TestFormOn (univ : Set (Euclid P)) n := by
    intro t ht ω
    change IsTestForm _ ∧ _
    exact ⟨⟨ω.property.1.1.comp (contDiff_const_smul t), ω.property.1.2.comp_smul ht⟩,
      subset_univ _⟩
  -- the cone identity for `λ = t⁻¹`: `η_{0,λ}^#(ω(t⁻¹ ·)) = tⁿ ω`, so `C(ω(t⁻¹ ·)) = tⁿ C(ω)`
  have hkey : ∀ (t : ℝ) (ht : 0 < t) (ω : TestFormOn (univ : Set (Euclid P)) n),
      C ⟨_, hscale t⁻¹ (inv_ne_zero ht.ne') ω⟩ = t ^ n * C ω := by
    intro t ht ω
    have hdom : IsTestForm (fun x => (ω : DifferentialForm (Euclid P) n) (t⁻¹ • x)) ∧
        tsupport (fun x => (ω : DifferentialForm (Euclid P) n) (t⁻¹ • x)) ⊆
          dilation (0 : Euclid P) t⁻¹ '' univ := by
      refine ⟨(hscale t⁻¹ (inv_ne_zero ht.ne') ω).1, fun y _ => ⟨t⁻¹ • y, mem_univ _, ?_⟩⟩
      simp [dilation, dilationCLM, ht.ne']
    have hlin : C (t ^ n • ω) = t ^ n * C ω := by
      simpa only [smul_eq_mul] using C.toCurrent.map_smul (t ^ n) ω
    rw [← hcone t⁻¹ (inv_pos.mpr ht) ⟨_, hscale t⁻¹ (inv_ne_zero ht.ne') ω⟩, currentEval,
      dite_eq_left hdom, ← hlin, blowUp, GeometricCurrentOn.affinePushforward_apply,
      GeometricCurrentOn.restrictDomain_apply]
    congr 1
    apply Subtype.ext
    rw [testFormOnInclusion_coe, affinePullbackTestOn_coe]
    funext x
    ext v
    have hmul := ((ω : DifferentialForm (Euclid P) n) x).map_smul_univ (fun _ => t) v
    simp only [Finset.prod_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul] at hmul
    simp only [affinePullbackForm, inv_inv, smul_zero, neg_zero, dilationCLM, smul_apply,
      ContinuousLinearMap.id_apply, zero_add, ne_eq, ht.ne', not_false_eq_true, inv_smul_smul₀,
      ContinuousAlternatingMap.compContinuousLinearMap_apply, FunLike.coe_smul,
      ContinuousLinearMap.coe_id', SetLike.val_smul, Pi.smul_apply,
      ContinuousAlternatingMap.coe_smul, smul_eq_mul]
    rw [← hmul]
    rfl
  -- (1) `M_{sW}(C) = sⁿ M_W(C)`: `ω ↦ ω(s⁻¹ ·)` maps the forms admissible for `M_W` onto those
  -- admissible for `M_{sW}`
  have hmass : ∀ W : Set (Euclid P),
      C.massOn ((fun x => s • x) '' W) = ENNReal.ofReal (s ^ n) * C.massOn W := by
    intro W
    apply le_antisymm
    · apply sSup_le
      rintro _ ⟨ω', hω', rfl⟩
      have hω : (⟨_, hscale s hs.ne' ω'⟩ : TestFormOn (univ : Set (Euclid P)) n) ∈
          massAdmissibleOn univ n W := by
        refine ⟨fun y hy => ?_, fun y => hω'.2 (s • y)⟩
        exact (smul_right_injective (Euclid P) hs.ne').mem_set_image.mp
          (hω'.1 (tsupport_comp_subset_preimage (ω' : DifferentialForm (Euclid P) n)
            (continuous_const_smul s) hy))
      have heq : ω' = ⟨_, hscale s⁻¹ (inv_ne_zero hs.ne') ⟨_, hscale s hs.ne' ω'⟩⟩ := by
        apply Subtype.ext
        funext x
        simp [smul_smul, hs.ne']
      dsimp only
      rw [heq, hkey s hs, ENNReal.ofReal_mul (pow_nonneg hs.le n)]
      gcongr
      exact C.le_massOn hω
    · calc ENNReal.ofReal (s ^ n) * C.massOn W
          = ⨆ r ∈ (fun ω => ENNReal.ofReal (C ω)) '' massAdmissibleOn univ n W,
              ENNReal.ofReal (s ^ n) * r := ENNReal.mul_sSup
        _ ≤ C.massOn ((fun x => s • x) '' W) := by
          refine iSup₂_le ?_
          rintro _ ⟨ω, hω, rfl⟩
          rw [← ENNReal.ofReal_mul (pow_nonneg hs.le n), ← hkey s hs ω]
          apply C.le_massOn
          refine ⟨fun y hy => ?_, fun y => hω.2 (s⁻¹ • y)⟩
          exact ⟨s⁻¹ • y, hω.1 (tsupport_comp_subset_preimage (ω : DifferentialForm (Euclid P) n)
            (continuous_const_smul s⁻¹) hy), smul_inv_smul₀ hs.ne' y⟩
  -- the zero region (complement of `spt C`) is invariant under `x ↦ t • x`, `t > 0`
  have hzero : ∀ t : ℝ, 0 < t → ∀ y : Euclid P, y ∈ C.zeroRegion → t • y ∈ C.zeroRegion := by
    intro t ht y hy
    obtain ⟨V, ⟨hVo, hVc, -, hV0⟩, hyV⟩ := hy
    have hcpt : IsCompact ((fun x => t • x) '' closure V) := hVc.image (continuous_const_smul t)
    refine ⟨(fun x => t • x) '' V, ⟨isOpenMap_smul₀ ht.ne' V hVo,
      hcpt.of_isClosed_subset isClosed_closure
        (closure_minimal (image_mono subset_closure) hcpt.isClosed), subset_univ _, ?_⟩,
      mem_image_of_mem _ hyV⟩
    intro ω' hω'
    have hω : tsupport ((⟨_, hscale t ht.ne' ω'⟩ : TestFormOn (univ : Set (Euclid P)) n) :
        DifferentialForm (Euclid P) n) ⊆ V := fun z hz =>
      (smul_right_injective (Euclid P) ht.ne').mem_set_image.mp
        (hω' (tsupport_comp_subset_preimage (ω' : DifferentialForm (Euclid P) n)
          (continuous_const_smul t) hz))
    have heq : ω' = ⟨_, hscale t⁻¹ (inv_ne_zero ht.ne') ⟨_, hscale t ht.ne' ω'⟩⟩ := by
      apply Subtype.ext
      funext x
      simp [smul_smul, ht.ne']
    rw [heq, hkey t ht, hV0 _ hω, mul_zero]
  refine ⟨hmass, fun x => ?_, fun x θ => ?_⟩
  -- (2) `s • x ∈ spt C ↔ x ∈ spt C`
  · simp only [GeometricCurrentOn.support, Set.mem_sdiff, mem_univ, true_and]
    refine ⟨fun h hx => h (hzero s hs x hx), fun h hsx => h ?_⟩
    simpa [hs.ne'] using hzero s⁻¹ (inv_pos.mpr hs) _ hsx
  -- (3) the density ratio at `s • x` and radius `ρ` is the ratio at `x` and radius `ρ / s`
  · have hball : ∀ ρ : ℝ, (fun y => s • y) '' ball x (ρ / s) = ball (s • x) ρ := by
      intro ρ
      rw [image_smul, smul_ball hs.ne', Real.norm_of_nonneg hs.le, mul_div_cancel₀ ρ hs.ne']
    have hs0 : ENNReal.ofReal (s ^ n) ≠ 0 := (ENNReal.ofReal_pos.mpr (pow_pos hs n)).ne'
    have hratio : ∀ ρ : ℝ,
        C.massOn (ball (s • x) ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n)) =
          C.massOn (ball x (ρ / s)) / (unitBallVolume n * ENNReal.ofReal ((ρ / s) ^ n)) := by
      intro ρ
      rw [← hball, hmass, show ρ ^ n = s ^ n * (ρ / s) ^ n by
          rw [← mul_pow, mul_div_cancel₀ ρ hs.ne'],
        ENNReal.ofReal_mul (pow_nonneg hs.le n), mul_left_comm (unitBallVolume n),
        ENNReal.mul_div_mul_left _ _ hs0 ENNReal.ofReal_ne_top]
    have hto : Tendsto (fun ρ : ℝ => ρ / s) (𝓝[>] 0) (𝓝[>] 0) := by
      refine tendsto_nhdsWithin_iff.mpr
        ⟨?_, eventually_nhdsWithin_of_forall fun ρ hρ => div_pos hρ hs⟩
      have h0 : Tendsto (fun ρ : ℝ => ρ / s) (𝓝 0) (𝓝 (0 / s)) := tendsto_id.div_const s
      rw [zero_div] at h0
      exact h0.mono_left nhdsWithin_le_nhds
    have hfrom : Tendsto (fun ρ : ℝ => s * ρ) (𝓝[>] 0) (𝓝[>] 0) := by
      refine tendsto_nhdsWithin_iff.mpr
        ⟨?_, eventually_nhdsWithin_of_forall fun ρ hρ => mul_pos hs hρ⟩
      have h0 : Tendsto (fun ρ : ℝ => s * ρ) (𝓝 0) (𝓝 (s * 0)) := tendsto_id.const_mul s
      rw [mul_zero] at h0
      exact h0.mono_left nhdsWithin_le_nhds
    unfold HasMassDensity
    refine and_congr_right fun _ => ⟨fun h => ?_, fun h => ?_⟩
    · refine (h.comp hfrom).congr fun ρ => ?_
      simp only [Function.comp_apply]
      rw [hratio, mul_div_cancel_left₀ ρ hs.ne']
    · exact (h.comp hto).congr fun ρ => (hratio ρ).symm
/-- Local-to-global comparison of measures on `ℝᴾ` (a step of the proof of Simon 7.3.3, for
two-dimensional minimizing cones): if `μ` is finite on compact sets, `D` is Borel and every
`w ∈ D` is the centre of a ball `B_ε(w)` on whose open subsets `ν ≤ μ`, then `ν(D) ≤ μ(D)`.
On each such ball the finite measure `μ⌞B_ε(w)` is outer regular, so `ν ≤ μ` also holds on the
Borel subsets of the ball; countably many of the balls cover `D` (Lindelöf), and the disjointed
pieces of `D` add up by countable additivity. -/
theorem Submission.idtp_tdc_nipp_local_comparison : ∀ (P : ℕ) (μ ν : Measure (Euclid P)) (D : Set (Euclid P)), (∀ K : Set (Euclid P), IsCompact K → μ K ≠ ∞) → MeasurableSet D → (∀ w ∈ D, ∃ ε : ℝ, 0 < ε ∧ ∀ W : Set (Euclid P), IsOpen W → W ⊆ ball w ε → ν W ≤ μ W) → ν D ≤ μ D := by
  intro P μ ν D hμ hD hloc
  -- (2) if `ν ≤ μ` on the open subsets of `B = B_ε(w)`, then `ν ≤ μ` on the Borel subsets of `B`:
  -- `μ⌞B` is a finite measure by (1), hence outer regular
  have hball : ∀ (w : Euclid P) (ε : ℝ),
      (∀ W : Set (Euclid P), IsOpen W → W ⊆ ball w ε → ν W ≤ μ W) →
      ∀ E : Set (Euclid P), MeasurableSet E → E ⊆ ball w ε → ν E ≤ μ E := by
    intro w ε hW E hE hEB
    -- (1) `μ(B_ε(w)) ≤ μ(closedBall w ε) < ∞`, closed balls being compact
    have : IsFiniteMeasure (μ.restrict (ball w ε)) := ⟨by
      rw [Measure.restrict_apply_univ]
      exact (measure_mono ball_subset_closedBall).trans_lt
        (hμ _ (isCompact_closedBall w ε)).lt_top⟩
    refine le_of_forall_gt fun t ht => ?_
    have hEt : μ.restrict (ball w ε) E < t := by
      rwa [Measure.restrict_apply hE, inter_eq_left.mpr hEB]
    obtain ⟨O, hEO, hO, hOt⟩ := Set.exists_isOpen_lt_of_lt E t hEt
    rw [Measure.restrict_apply hO.measurableSet] at hOt
    calc ν E ≤ ν (O ∩ ball w ε) := measure_mono (subset_inter hEO hEB)
      _ ≤ μ (O ∩ ball w ε) := hW _ (hO.inter isOpen_ball) inter_subset_right
      _ < t := hOt
  -- (3) the case `D = ∅`
  rcases D.eq_empty_or_nonempty with rfl | ⟨x, hx⟩
  · simp
  -- (4) countably many of the balls `B_{ε_w}(w)`, `w ∈ D`, cover `D`; enumerate them as `B_l`
  choose! ε hεpos hε using hloc
  obtain ⟨T, hTD, hTc, hTU⟩ := TopologicalSpace.isOpen_biUnion_countable D
    (fun w => ball w (ε w)) fun w _ => isOpen_ball
  have hDT : D ⊆ ⋃ w ∈ T, ball w (ε w) := by
    rw [hTU]
    exact fun y hy => mem_biUnion hy (mem_ball_self (hεpos y hy))
  obtain ⟨w, hwT, -⟩ := mem_iUnion₂.mp (hDT hx)
  obtain ⟨c, rfl⟩ := hTc.exists_eq_range ⟨w, hwT⟩
  set B : ℕ → Set (Euclid P) := fun l => ball (c l) (ε (c l))
  have hDB : D ⊆ ⋃ l, B l := by rwa [biUnion_range] at hDT
  -- (5) the Borel pieces `E_l = D ∩ (B_l \ ⋃_{l' < l} B_{l'})`, pairwise disjoint with union `D`
  have hEm : ∀ l, MeasurableSet (D ∩ disjointed B l) := fun l =>
    hD.inter (MeasurableSet.disjointed (fun l => isOpen_ball.measurableSet) l)
  have hEd : Pairwise (Disjoint on fun l => D ∩ disjointed B l) := fun i j hij =>
    (disjoint_disjointed B hij).mono inter_subset_right inter_subset_right
  have hEU : ⋃ l, D ∩ disjointed B l = D := by
    rw [← inter_iUnion, iUnion_disjointed, inter_eq_left.mpr hDB]
  -- (6) `ν(E_l) ≤ μ(E_l)` by (2), since `E_l ⊆ B_l`; sum over `l`
  have hEle : ∀ l, ν (D ∩ disjointed B l) ≤ μ (D ∩ disjointed B l) := fun l =>
    hball (c l) (ε (c l)) (hε (c l) (hTD (mem_range_self l))) _ (hEm l)
      (inter_subset_right.trans (disjointed_subset B l))
  calc ν D = ∑' l, ν (D ∩ disjointed B l) := by rw [← measure_iUnion hEd hEm, hEU]
    _ ≤ ∑' l, μ (D ∩ disjointed B l) := ENNReal.tsum_le_tsum hEle
    _ = μ D := by rw [← measure_iUnion hEd hEm, hEU]
/-- `Hⁿ(Q ∩ B_ρ(y)) = ωₙρⁿ` for an `n`-dimensional linear subspace `Q` of `ℝᴾ`, `y ∈ Q` and
`ρ > 0` (used in the proof of Simon 7.3.3(1), p. 191, for the density of the planes of a
2-dimensional minimizing cone).  The inclusion `Q → ℝᴾ` is an isometry, so `Q ∩ B_ρ(y)` has the
measure of the ball `B_ρ(y)` of `Q`; on `Q`, `μHE[n]` is the volume, Haar scaling gives
`vol(B_ρ(y)) = ρⁿ vol(B_1(0))`, and orthonormal coordinates `Q ≃ₗᵢ ℝⁿ` preserve volume, so
`vol(B_1(0)) = ωₙ`. -/
theorem Submission.idtp_tdc_subspace_ball_measure : ∀ (P n : ℕ) (Q : Submodule ℝ (Euclid P)) (y : Euclid P) (ρ : ℝ), Module.finrank ℝ Q = n → y ∈ Q → 0 < ρ → μHE[n] ((Q : Set (Euclid P)) ∩ ball y ρ) = unitBallVolume n * ENNReal.ofReal (ρ ^ n) := by
  intro P n Q y ρ hn hy hρ
  subst hn
  -- the inclusion `Q → ℝᴾ` is an isometry with range `Q`; `B_ρ(y)` pulls back to the ball of `Q`
  have hball : μHE[Module.finrank ℝ Q] ((Q : Set (Euclid P)) ∩ ball y ρ) =
      μHE[Module.finrank ℝ Q] (ball (⟨y, hy⟩ : Q) ρ) := by
    rw [← isometry_subtype_coe.preimage_ball (⟨y, hy⟩ : Q) ρ,
      isometry_subtype_coe.euclideanHausdorffMeasure_preimage, Subtype.range_coe, Set.inter_comm]
  -- orthonormal coordinates `Q ≃ₗᵢ ℝⁿ` preserve volume and map `B_1(0)` onto `B_1(0)`
  have hunit := (stdOrthonormalBasis ℝ Q).measurePreserving_repr.measure_preimage
    (measurableSet_ball (x := (0 : Euclid (Module.finrank ℝ Q))) (ε := 1)).nullMeasurableSet
  rw [LinearIsometryEquiv.preimage_ball, map_zero] at hunit
  -- `μHE[n] = volume` on `Q`, then Haar scaling of balls
  rw [hball, InnerProductSpace.euclideanHausdorffMeasure_eq_volume,
    Measure.addHaar_ball_of_pos _ _ hρ, hunit, mul_comm]
  rfl

/-- Chapter 7 of Simon's *Introduction to GMT*: the headline results above. -/
theorem main_theorem : MinimizingImpliesStationary ∧ ExistenceOfMinimizingFilling ∧ CompactnessOfMinimizingCurrents ∧ DensityAndTangentCones ∧ IntegerDensityAndTangentPlanes ∧ RegularSetDense ∧ DensityOneImpliesRegular ∧ SingularSetSmallWhereDensityBelowTwo ∧ HalfSpaceConeLiesInBoundary ∧ CodimensionOneRegularity ∧ RegularComponentsAreMinimizing := by sorry
/-- **Support of a current vanishing away from a compact set** (Simon 6.2.11).  If `K ⊆ U` is
compact and `F ∈ 𝒟ₙ(U)` kills every `ω ∈ 𝒟ⁿ(U)` with `spt ω ∩ K = ∅`, then `spt F ⊆ K` and
`spt F` is compact.  For `y ∈ U \ K` choose `B_s(y) ⊆ U \ K`: the ball `W = B_{s/2}(y)` has compact
closure `⊆ B̄_{s/2}(y) ⊆ U \ K` and every form supported in `W` misses `K`, so `y ∈ Z(F)`.  Hence
`spt F = K \ Z(F)`, compact because the zero region `Z(F)` is open. -/
theorem Submission.rsd_cmr_support_subset_of_vanish : ∀ (P n : ℕ) (U K : Set (Euclid P)) (F : GeometricCurrentOn U n), IsOpen U → IsCompact K → K ⊆ U → (∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) K → F ω = 0) → F.support ⊆ K ∧ IsCompact F.support := by
  intro P n U K F hU hK hKU hvan
  -- Steps 1–2: no point of `U \ K` lies in `spt F = U \ Z(F)`, so `spt F ⊆ K`
  have hsub : F.support ⊆ K := by
    intro y hy
    by_contra hyK
    obtain ⟨s, hs, hball⟩ := Metric.isOpen_iff.mp (hU.sdiff hK.isClosed) y ⟨hy.1, hyK⟩
    apply hy.2
    -- `W = B_{s/2}(y)` is one of the open sets whose union is `Z(F)`
    refine ⟨ball y (s / 2), ⟨isOpen_ball, ?_, ?_, ?_⟩, mem_ball_self (by positivity)⟩
    · -- `closure W` is compact
      exact (isCompact_closedBall y (s / 2)).of_isClosed_subset isClosed_closure
        closure_ball_subset_closedBall
    · -- `closure W ⊆ B̄_{s/2}(y) ⊆ B_s(y) ⊆ U \ K ⊆ U`
      exact closure_ball_subset_closedBall.trans
        ((closedBall_subset_ball (by linarith)).trans (hball.trans sdiff_subset))
    · -- a form supported in `W ⊆ U \ K` misses `K`, so `F` kills it
      intro ω hω
      exact hvan ω (Set.disjoint_of_subset_left
        (hω.trans ((ball_subset_ball (by linarith)).trans hball)) disjoint_sdiff_left)
  -- Step 3: `spt F = K \ Z(F)` is compact, `Z(F)` being open
  refine ⟨hsub, ?_⟩
  have heq : F.support = K \ F.zeroRegion :=
    Set.ext fun x => ⟨fun hx => ⟨hsub hx, hx.2⟩, fun hx => ⟨hKU hx.1, hx.2⟩⟩
  rw [heq]
  exact hK.diff F.isOpen_zeroRegion
/-- **Blow-up domains eventually contain bounded sets** (Simon 7.3.3(2), proof: the domain
claims for `η_{x,σᵢ#}T`).  If `U` is open, `x ∈ U`, `λᵢ > 0` and `λᵢ → 0`, then every bounded `K`
lies in `η_{x,λᵢ}(U)` for all large `i`: with `B_δ(x) ⊆ U` and `K ⊆ B̄_r(0)`, eventually
`λᵢ(|r| + 1) < δ`, and then each `w ∈ K` is `η_{x,λᵢ}(x + λᵢw)` with `x + λᵢw ∈ B_δ(x)`. -/
theorem Submission.idtp_tpf_blowUp_domain_eventually : ∀ (P : ℕ) (U : Set (Euclid P)) (x : Euclid P) (lams : ℕ → ℝ), IsOpen U → x ∈ U → (∀ i, 0 < lams i) → Tendsto lams atTop (𝓝 0) → ∀ K : Set (Euclid P), Bornology.IsBounded K → ∀ᶠ i in atTop, K ⊆ dilation x (lams i) '' U := by
  intro P U x lams hU hx hpos hlim K hK
  -- `B_δ(x) ⊆ U` and `K ⊆ B̄_r(0)`
  obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.mp hU x hx
  obtain ⟨r, hr⟩ := hK.subset_closedBall 0
  -- `λᵢ(|r| + 1) → 0 < δ`, so `λᵢ(|r| + 1) < δ` for all large `i`
  have hlim' : Tendsto (fun i => lams i * (|r| + 1)) atTop (𝓝 0) := by
    simpa using hlim.mul_const (|r| + 1)
  filter_upwards [hlim'.eventually (gt_mem_nhds hδ)] with i hi w hw
  -- `y = x + λᵢw` lies in `B_δ(x) ⊆ U`, and `η_{x,λᵢ}(y) = w`
  refine ⟨x + lams i • w, hball ?_, ?_⟩
  · have hw : ‖w‖ ≤ |r| + 1 := by
      linarith [mem_closedBall_zero_iff.mp (hr hw), le_abs_self r]
    rw [mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg (hpos i).le]
    exact (mul_le_mul_of_nonneg_left hw (hpos i).le).trans_lt hi
  · simp only [dilation, dilationCLM, smul_apply, ContinuousLinearMap.id_apply, smul_add,
      smul_smul, inv_mul_cancel₀ (hpos i).ne', one_smul, neg_add_cancel_left]
/-- Dilation transfers a planar constant-density piece of a `2`-dimensional cone `C` (used in the
proof of Simon 7.3.3(1), pp. 191–192, that `Θ²(μ_C, ·)` is locally constant on `spt C \ {0}`):
for `s > 0`, if `spt C ∩ B_ε(s⁻¹x) = Q ∩ B_ε(s⁻¹x)` for a subspace `Q` and `Θ²(μ_C, y) = k` for
every `y ∈ spt C ∩ B_ε(s⁻¹x)`, then the same holds with `B_{sε}(x)` in place of `B_ε(s⁻¹x)`.
The map `y ↦ s⁻¹y` sends `B_{sε}(x)` onto `B_ε(s⁻¹x)` and preserves `Q`; by the dilation
invariance of the cone (`Submission.idtp_tdc_cone_dilation` with factors `s⁻¹` and `s`), it also
preserves `spt C`, and `Θ²(μ_C, s⁻¹y) = k` gives `Θ²(μ_C, y) = k`. -/
theorem Submission.idtp_tdc_dlc_ld_cone_scale_piece : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (x : Euclid P) (k : ℕ) (s ε : ℝ), IsIntegerMultiplicity C → IsConeCurrent C → 0 < s → C.support ∩ ball (s⁻¹ • x) ε = (Q : Set (Euclid P)) ∩ ball (s⁻¹ • x) ε → (∀ y ∈ C.support, y ∈ ball (s⁻¹ • x) ε → HasMassDensity C y k) → C.support ∩ ball x (s * ε) = (Q : Set (Euclid P)) ∩ ball x (s * ε) ∧ ∀ y ∈ C.support, y ∈ ball x (s * ε) → HasMassDensity C y k := by
  intro P C Q x k s ε hIM hcone hs hA hB
  -- `s⁻¹y ∈ spt C ↔ y ∈ spt C` and `Θ²(μ_C, su) = θ ↔ Θ²(μ_C, u) = θ`
  have hS := (Submission.idtp_tdc_cone_dilation P 2 C hIM hcone s⁻¹ (inv_pos.mpr hs)).2.1
  have hD := (Submission.idtp_tdc_cone_dilation P 2 C hIM hcone s hs).2.2
  -- `s⁻¹y ∈ B_ε(s⁻¹x) ↔ y ∈ B_{sε}(x)` and `s⁻¹y ∈ Q ↔ y ∈ Q`
  have hball : ∀ y : Euclid P, s⁻¹ • y ∈ ball (s⁻¹ • x) ε ↔ y ∈ ball x (s * ε) := by
    intro y
    rw [mem_ball, mem_ball, dist_smul₀, norm_inv, Real.norm_of_nonneg hs.le, inv_mul_lt_iff₀ hs]
  have hQ : ∀ y : Euclid P, s⁻¹ • y ∈ Q ↔ y ∈ Q := fun y => Q.smul_mem_iff (inv_ne_zero hs.ne')
  refine ⟨Set.ext fun y => ?_, fun y hy hyx => ?_⟩
  -- the support equation at the point `s⁻¹y`
  · simpa only [mem_inter_iff, SetLike.mem_coe, hS, hQ, hball] using Set.ext_iff.mp hA (s⁻¹ • y)
  -- the density `k` at `s⁻¹y` transfers to `s(s⁻¹y) = y`
  · simpa only [smul_inv_smul₀ hs.ne'] using
      (hD (s⁻¹ • y) k).mpr (hB _ ((hS y).mpr hy) ((hball y).mpr hyx))
/-- **Simon Ch. 6, 1.2 (p. 132)**: `Λⁿ(ℝᴾ)` is finite-dimensional.  An `n`-covector `α` is
determined by its values `α(e_{I(1)}, …, e_{I(n)})` on tuples of standard basis vectors (alternating
maps agreeing on distinct basis vectors are equal), so `α ↦ (α(e ∘ I))_{I : Fin n → Fin P}` is an
injective linear map into the finite-dimensional space `ℝ^(Fin n → Fin P)`. -/
theorem Submission.imsupp_covector_finiteDimensional : ∀ (P n : ℕ), FiniteDimensional ℝ (Covector (Euclid P) n) := by
  intro P n
  -- the standard basis `e` of `ℝᴾ`
  let e := (EuclideanSpace.basisFun (Fin P) ℝ).toBasis
  -- `L α = (α(e ∘ I))_I`, linear since addition and scaling of covectors are pointwise
  let L : Covector (Euclid P) n →ₗ[ℝ] ((Fin n → Fin P) → ℝ) :=
    { toFun := fun α I => α fun i => e (I i)
      map_add' := fun α β => rfl
      map_smul' := fun c α => rfl }
  -- `L α = L β` identifies `α` and `β` on distinct basis vectors, hence everywhere
  refine FiniteDimensional.of_injective L fun α β h => ?_
  exact ContinuousAlternatingMap.toAlternatingMap_injective
    (e.ext_alternating fun v _ => congr_fun h v)
/-- **Simon Ch. 6, 3.2(3)**, one covector at a time: if `T = τ(M, θ, ξ)` vanishes on the open set
`W ⊆ U`, then `ξ(x)(α) = 0` for `μ_T`-a.e. `x ∈ W`.  Here `f = ξ(·)(α)` is a.e. bounded by `‖α‖`
(`ξ = ±τ₁ ∧ ⋯ ∧ τₙ`, `τ` orthonormal) and `μ_T = θ Hⁿ⌞M` is finite on compact subsets of `U`, so
`f` is locally `μ_T`-integrable on `W`.  For smooth compactly supported `g` with `spt g ⊆ W`,
`∫ g f dμ_T = τ(M, θ, ξ)(g α) = T(g α) = 0`, and the fundamental lemma of the calculus of
variations gives `f = 0` a.e. on `W`. -/
theorem Submission.imsupp_orient_apply_ae_eq_zero_of_vanishesOn : ∀ (P n : ℕ) (U W : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), R.Represents T → IsOpen W → W ⊆ U → T.VanishesOn W → ∀ α : Covector (Euclid P) n, ∀ᵐ x ∂R.measure, x ∈ W → R.orient x α = 0 := by
  intro P n U W T R hRT hW hWU hT α
  -- `μ_T = θ Hⁿ⌞M ≪ Hⁿ⌞M`
  have hac : R.measure ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
  -- `|ξ(x)(α)| = |α(τ)| ≤ ‖α‖ ∏ᵢ ‖τᵢ‖ = ‖α‖` wherever `ξ(x)` is a unit orientation
  have hbound : ∀ᵐ x ∂R.measure, ‖R.orient x α‖ ≤ ‖α‖ := by
    refine hac.ae_le ?_
    filter_upwards [R.orients] with x hx
    obtain ⟨Q, -, τ, hτ, -, hξ⟩ := hx
    have h1 : ‖R.orient x α‖ = ‖α τ‖ := by
      rcases hξ with h | h
      · rw [h α]
      · rw [h α, norm_neg]
    rw [h1]
    calc ‖α τ‖ ≤ ‖α‖ * ∏ i, ‖τ i‖ := ContinuousAlternatingMap.le_opNorm α τ
      _ = ‖α‖ := by rw [Finset.prod_eq_one fun i _ => hτ.norm_eq_one i, mul_one]
  -- `f = ξ(·)(α)` is the continuous evaluation at `α` composed with `ξ`
  have hmeas : AEStronglyMeasurable (fun x => R.orient x α) R.measure :=
    ((ContinuousLinearMap.apply ℝ ℝ α).continuous.comp_aestronglyMeasurable
      R.aestronglyMeasurable_orient).mono_ac hac
  -- `μ_T(K) = ∫_{M ∩ K} θ dHⁿ < ∞` for compact `K ⊆ U`
  have hfin : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → R.measure K < ∞ := by
    intro K hK hKU
    rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
      Measure.restrict_restrict hK.measurableSet, inter_comm]
    exact (R.locallyIntegrable_mult K hK hKU).lt_top
  -- `f` is bounded and `μ_T` is finite on compact subsets of `W`
  have hli : LocallyIntegrableOn (fun x => R.orient x α) W R.measure := by
    refine (locallyIntegrableOn_iff hW.isLocallyClosed).2 fun K hKW hK => ?_
    exact IntegrableOn.of_bound (hfin K hK (hKW.trans hWU)) hmeas.restrict ‖α‖
      (ae_restrict_of_ae hbound)
  -- `∫ g f dμ_T = τ(M, θ, ξ)(g α) = T(g α) = 0`, as `g α` is a test form supported in `W`
  refine hW.ae_eq_zero_of_integral_contDiff_smul_eq_zero hli fun g hg hgc hgW => ?_
  let ω : TestFormOn U n := ⟨fun y => g y • α, ⟨hg.smul contDiff_const, hgc.smul_right⟩,
    (tsupport_smul_subset_left _ _).trans (hgW.trans hWU)⟩
  have h0 : T ω = 0 := hT ω ((tsupport_smul_subset_left _ _).trans hgW)
  rw [hRT ω] at h0
  have hθ : (fun x => (R.mult x : ℝ≥0∞)) = fun x => ((R.mult x : NNReal) : ℝ≥0∞) := by
    funext x; simp
  have hmθ : Measurable fun x => (R.mult x : NNReal) :=
    (measurable_from_nat (f := fun k : ℕ => (k : NNReal))).comp R.measurable_mult
  rw [IMRep.measure, hθ, integral_withDensity_eq_integral_smul hmθ, ← h0, IMRep.action]
  refine integral_congr_ae (Eventually.of_forall fun x => ?_)
  simp only [ω, NNReal.smul_def, NNReal.coe_natCast, smul_eq_mul, map_smul]
/-- A smooth cutoff `ϑ` with `0 ≤ ϑ ≤ 1`, `ϑ = 1` on `B_r(0)` and compact support, and the test
form `ϑβ ∈ 𝒟ⁿ(ℝᴾ)` of a constant covector `β` (the form `ω_ϑ = ϑβ` of the tilt-excess decay
step in the proof of Simon 7.3.3, used there with `n = 2`, `r = 3`).  A bump function `ϑ`
centred at `0` with radii `r < r + 1` has all the scalar properties, and `ϑβ` is smooth, being a
smooth scalar times a constant, with support inside that of `ϑ`. -/
theorem Submission.idtp_cse_bml_td_cutoff_test_form : ∀ (P n : ℕ) (r : ℝ) (β : Covector (Euclid P) n), 0 < r → ∃ (ϑ : Euclid P → ℝ) (ω : TestFormOn (univ : Set (Euclid P)) n), Continuous ϑ ∧ HasCompactSupport ϑ ∧ (∀ x, 0 ≤ ϑ x ∧ ϑ x ≤ 1) ∧ (∀ x : Euclid P, ‖x‖ < r → ϑ x = 1) ∧ ∀ x, (ω : DifferentialForm (Euclid P) n) x = ϑ x • β := by
  intro P n r β hr
  -- a bump function `ϑ`, equal to `1` on `closedBall 0 r` and supported in `closedBall 0 (r + 1)`
  let f : ContDiffBump (0 : Euclid P) := ⟨r, r + 1, hr, by linarith⟩
  -- `ϑβ` is smooth with compact support, so it is a test form on `ℝᴾ`
  have hsm : IsSmoothForm (fun x : Euclid P => f x • β) :=
    (f.contDiff (n := ⊤)).smul contDiff_const
  have hcs : HasCompactSupport (fun x : Euclid P => f x • β) := f.hasCompactSupport.smul_right
  have hmem : (fun x : Euclid P => f x • β) ∈ TestFormOn (univ : Set (Euclid P)) n :=
    ⟨⟨hsm, hcs⟩, subset_univ _⟩
  refine ⟨f, ⟨fun x => f x • β, hmem⟩, f.continuous, f.hasCompactSupport,
    fun x => ⟨f.nonneg, f.le_one⟩, fun x hx => f.one_of_mem_closedBall ?_, fun x => rfl⟩
  simpa [mem_closedBall, dist_zero_right] using hx.le
/-- **Planar fibre geometry** (fibre count for the cone-sector endpoint density in the proof of
Simon 7.3.3).  Let `Q ⊆ ℝᴾ` be a plane with orthonormal basis `a, e`, `π = Q.starProjection`,
`Ax = ⟨x, a⟩e − ⟨x, e⟩a` and `f(x) = arctan(⟨x, e⟩/⟨x, a⟩)`.  Then (a) `|p_T(Ax)| ≤ |πx| ≤ |x|`
for every subspace `T`; (b) for `t > 0` and `|α| < Real.pi/2`, the point
`x₀ = t(cos α a + sin α e)` has `⟨x₀, a⟩ > 0`, `|x₀| = t`, `f(x₀) = α`, `πx₀ = x₀` and
`|π(Ax₀)| = t`; (c) every other `x` with `⟨x, a⟩ > 0`, `|x| = t` and `f(x) = α` has `|πx| < t`.
A dimension count gives `Q = span{a, e}`, hence `πx = ⟨x, a⟩a + ⟨x, e⟩e` and `|Ax| = |πx|`; in
(c), `|πx| = |x|` would give `x ∈ Q`, `x = ua + ve` with `u² + v² = t²`, and then `cos α = u/t`,
`sin α = v/t` force `x = x₀`. -/
theorem Submission.idtp_cse_fc_planar_fibre_geometry : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P), Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → (∀ (T : Submodule ℝ (Euclid P)) (x : Euclid P), ‖T.starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ≤ ‖Q.starProjection x‖ ∧ ‖Q.starProjection x‖ ≤ ‖x‖) ∧ ∀ t α : ℝ, 0 < t → |α| < Real.pi / 2 → (0 < inner ℝ (t • (Real.cos α • a + Real.sin α • e)) a ∧ ‖t • (Real.cos α • a + Real.sin α • e)‖ = t ∧ Real.arctan (inner ℝ (t • (Real.cos α • a + Real.sin α • e)) e / inner ℝ (t • (Real.cos α • a + Real.sin α • e)) a) = α ∧ Q.starProjection (t • (Real.cos α • a + Real.sin α • e)) = t • (Real.cos α • a + Real.sin α • e) ∧ ‖Q.starProjection (inner ℝ (t • (Real.cos α • a + Real.sin α • e)) a • e - inner ℝ (t • (Real.cos α • a + Real.sin α • e)) e • a)‖ = t) ∧ ∀ x : Euclid P, 0 < inner ℝ x a → ‖x‖ = t → Real.arctan (inner ℝ x e / inner ℝ x a) = α → x ≠ t • (Real.cos α • a + Real.sin α • e) → ‖Q.starProjection x‖ < t := by
  intro P Q a e hQ haQ heQ ha he hae
  -- Step 1: the Gram matrix of `(a, e)`
  have haa : inner ℝ a a = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, ha, one_pow]
  have hee : inner ℝ e e = (1 : ℝ) := by rw [real_inner_self_eq_norm_sq, he, one_pow]
  have hea : inner ℝ e a = (0 : ℝ) := by rw [real_inner_comm, hae]
  -- Step 2: `Q = span {a, e}` by a dimension count, so every `w ∈ Q` is `c₁ a + c₂ e`
  have hQmem : ∀ w ∈ Q, ∃ c₁ c₂ : ℝ, w = c₁ • a + c₂ • e := by
    have hon : Orthonormal ℝ ![a, e] := by
      rw [orthonormal_iff_ite]
      intro i j
      fin_cases i <;> fin_cases j <;> simp [ha, he, hae, hea]
    have hspan : Submodule.span ℝ (Set.range ![a, e]) = Q := by
      refine Submodule.eq_of_le_of_finrank_eq ?_ ?_
      · rw [Submodule.span_le, Set.range_subset_iff]
        intro i
        fin_cases i
        · simpa using haQ
        · simpa using heQ
      · rw [finrank_span_eq_card hon.linearIndependent, hQ, Fintype.card_fin]
    intro w hw
    rw [← hspan, Submodule.mem_span_range_iff_exists_fun] at hw
    obtain ⟨c, rfl⟩ := hw
    exact ⟨c 0, c 1, by simp [Fin.sum_univ_two]⟩
  -- Step 3: `πx = ⟨x, a⟩ a + ⟨x, e⟩ e`
  have hproj : ∀ x : Euclid P, Q.starProjection x = inner ℝ x a • a + inner ℝ x e • e := by
    intro x
    refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero
      (Q.add_mem (Q.smul_mem _ haQ) (Q.smul_mem _ heQ)) fun w hw => ?_
    obtain ⟨c₁, c₂, rfl⟩ := hQmem w hw
    simp only [inner_sub_left, inner_add_left, inner_add_right, real_inner_smul_left,
      real_inner_smul_right, haa, hee, hae, hea]
    ring
  -- Step 4: `‖u e − v a‖² = u² + v² = ‖u a + v e‖²`, hence `‖Ax‖ = ‖πx‖`
  have hnormA : ∀ u v : ℝ, ‖u • e - v • a‖ ^ 2 = u ^ 2 + v ^ 2 := by
    intro u v
    rw [← real_inner_self_eq_norm_sq]
    simp only [inner_sub_left, inner_sub_right, real_inner_smul_left, real_inner_smul_right, haa,
      hee, hae, hea]
    ring
  have hnormP : ∀ u v : ℝ, ‖u • a + v • e‖ ^ 2 = u ^ 2 + v ^ 2 := by
    intro u v
    rw [← real_inner_self_eq_norm_sq]
    simp only [inner_add_left, inner_add_right, real_inner_smul_left, real_inner_smul_right, haa,
      hee, hae, hea]
    ring
  have hAx : ∀ x : Euclid P, ‖inner ℝ x a • e - inner ℝ x e • a‖ = ‖Q.starProjection x‖ := by
    intro x
    rw [hproj x]
    exact (pow_left_inj₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).1
      ((hnormA _ _).trans (hnormP _ _).symm)
  -- Step 5: part (a)
  refine ⟨fun T x => ⟨(T.norm_starProjection_apply_le _).trans (hAx x).le,
    Q.norm_starProjection_apply_le x⟩, fun t α ht hα => ?_⟩
  -- Step 6: part (b)
  obtain ⟨hα₁, hα₂⟩ := abs_lt.1 hα
  have hcos : 0 < Real.cos α := Real.cos_pos_of_mem_Ioo ⟨hα₁, hα₂⟩
  have hx₀Q : t • (Real.cos α • a + Real.sin α • e) ∈ Q :=
    Q.smul_mem t (Q.add_mem (Q.smul_mem _ haQ) (Q.smul_mem _ heQ))
  have hx₀a : inner ℝ (t • (Real.cos α • a + Real.sin α • e)) a = t * Real.cos α := by
    simp only [real_inner_smul_left, inner_add_left, haa, hea]
    ring
  have hx₀e : inner ℝ (t • (Real.cos α • a + Real.sin α • e)) e = t * Real.sin α := by
    simp only [real_inner_smul_left, inner_add_left, hee, hae]
    ring
  have hx₀n : ‖t • (Real.cos α • a + Real.sin α • e)‖ = t := by
    have h1 : ‖Real.cos α • a + Real.sin α • e‖ = 1 :=
      (pow_left_inj₀ (norm_nonneg _) zero_le_one two_ne_zero).1
        (by rw [hnormP, Real.cos_sq_add_sin_sq, one_pow])
    rw [norm_smul, h1, mul_one, Real.norm_eq_abs, abs_of_pos ht]
  refine ⟨⟨?_, hx₀n, ?_, Submodule.starProjection_eq_self_iff.2 hx₀Q, ?_⟩, ?_⟩
  · rw [hx₀a]
    exact mul_pos ht hcos
  · rw [hx₀a, hx₀e, mul_div_mul_left _ _ ht.ne', ← Real.tan_eq_sin_div_cos,
      Real.arctan_tan hα₁ hα₂]
  · rw [Submodule.starProjection_eq_self_iff.2 (Q.sub_mem (Q.smul_mem _ heQ) (Q.smul_mem _ haQ)),
      hAx, Submodule.starProjection_eq_self_iff.2 hx₀Q, hx₀n]
  -- Steps 7–8: part (c)
  · intro x hxa hxt hxα hne
    refine not_le.1 fun hlt => ?_
    have hπx : ‖Q.starProjection x‖ = ‖x‖ :=
      le_antisymm (Q.norm_starProjection_apply_le x) (by rw [hxt]; exact hlt)
    have hx : x = inner ℝ x a • a + inner ℝ x e • e := by
      rw [← hproj x,
        Submodule.starProjection_eq_self_iff.2 ((Q.mem_iff_norm_starProjection x).2 hπx)]
    have huv : inner ℝ x a ^ 2 + inner ℝ x e ^ 2 = t ^ 2 := by
      rw [← hnormP, ← hx, hxt]
    have hu0 : inner ℝ x a ≠ 0 := hxa.ne'
    have hsqrt : √(1 + (inner ℝ x e / inner ℝ x a) ^ 2) = t / inner ℝ x a := by
      rw [← Real.sqrt_sq (div_pos ht hxa).le]
      congr 1
      field_simp
      linarith [huv]
    have hcosα : Real.cos α = inner ℝ x a / t := by
      rw [← hxα, Real.cos_arctan, hsqrt, one_div_div]
    have hsinα : Real.sin α = inner ℝ x e / t := by
      rw [← hxα, Real.sin_arctan, hsqrt]
      field_simp
    apply hne
    rw [hcosα, hsinα, smul_add, smul_smul, smul_smul, mul_div_cancel₀ _ ht.ne',
      mul_div_cancel₀ _ ht.ne']
    exact hx
/-- **Fibre-count arithmetic** (Simon 7.3.3, cone-sector endpoint density: integrality of the
fibre multiplicity).  Let `θ : ι → ℕ`, `w : ι → ℝ` and `t > 0` with `w i ≤ t` for all `i`, and
`∑' i, θ i · ofReal (w i) = ofReal (m t)` in `[0, ∞]`.  Then `m ≤ ∑' i, θ i`.  If moreover every
`θ i ≥ 1`, `θ i₀ = k`, `w i₀ = t` and `w i < t` for `i ≠ i₀`, then `k ≤ m`, and `k < m` gives
`m + 1 ≤ ∑' i, θ i`: a finite total multiplicity forces `ι` to be finite, and the terms off `i₀`
are strictly below `θ i · ofReal t`. -/
theorem Submission.idtp_cse_fc_tsum_count_arith : ∀ (ι : Type) (θ : ι → ℕ) (w : ι → ℝ) (t : ℝ) (m : ℕ), 0 < t → (∀ i, w i ≤ t) → ∑' i, (θ i : ℝ≥0∞) * ENNReal.ofReal (w i) = ENNReal.ofReal ((m : ℝ) * t) → (m : ℝ≥0∞) ≤ ∑' i, (θ i : ℝ≥0∞) ∧ ∀ (i₀ : ι) (k : ℕ), (∀ i, 1 ≤ θ i) → θ i₀ = k → w i₀ = t → (∀ i, i ≠ i₀ → w i < t) → k ≤ m ∧ (k < m → (m : ℝ≥0∞) + 1 ≤ ∑' i, (θ i : ℝ≥0∞)) := by
  intro ι θ w t m ht hw hsum
  -- `τ = ofReal t ∈ (0, ∞)`, and the hypothesis reads `H = m τ`
  have hτ0 : ENNReal.ofReal t ≠ 0 := (ENNReal.ofReal_pos.mpr ht).ne'
  have hτ : ENNReal.ofReal t ≠ ∞ := ENNReal.ofReal_ne_top
  rw [ENNReal.ofReal_mul (Nat.cast_nonneg m), ENNReal.ofReal_natCast] at hsum
  -- (i): termwise `θ i ofReal (w i) ≤ θ i τ`, so `m τ = H ≤ N τ`
  have hN : ∑' i, (θ i : ℝ≥0∞) * ENNReal.ofReal (w i) ≤
      (∑' i, (θ i : ℝ≥0∞)) * ENNReal.ofReal t := by
    rw [← ENNReal.tsum_mul_right]
    exact ENNReal.tsum_le_tsum fun i => by gcongr; exact hw i
  refine ⟨(ENNReal.mul_le_mul_iff_left hτ0 hτ).mp (hsum ▸ hN), ?_⟩
  intro i₀ k hθ1 hk hw0 hlt
  -- (ii) `k ≤ m`: the `i₀` term `k τ` is at most `H = m τ`
  have hkτ : (k : ℝ≥0∞) * ENNReal.ofReal t ≤ (m : ℝ≥0∞) * ENNReal.ofReal t := by
    rw [← hsum, ← hk, ← hw0]
    exact ENNReal.le_tsum (f := fun i => (θ i : ℝ≥0∞) * ENNReal.ofReal (w i)) i₀
  refine ⟨by exact_mod_cast (ENNReal.mul_le_mul_iff_left hτ0 hτ).mp hkτ, fun hkm => ?_⟩
  -- if `N = ∞` there is nothing to prove; otherwise `ι` is finite, as every `θ i ≥ 1`
  by_cases hNtop : ∑' i, (θ i : ℝ≥0∞) = ∞
  · rw [hNtop]
    exact le_top
  have hfin : {i : ι | (1 : ℝ≥0∞) ≤ θ i}.Finite :=
    ENNReal.finite_const_le_of_tsum_ne_top hNtop one_ne_zero
  have huniv : {i : ι | (1 : ℝ≥0∞) ≤ θ i} = univ :=
    eq_univ_of_forall fun i => by exact_mod_cast hθ1 i
  rw [huniv] at hfin
  have : Finite ι := finite_univ_iff.mp hfin
  cases nonempty_fintype ι
  classical
  rw [tsum_fintype] at hsum ⊢
  -- split off the `i₀` term of `H` and of `N τ`
  have hsplitH : (θ i₀ : ℝ≥0∞) * ENNReal.ofReal (w i₀) +
      ∑ i ∈ Finset.univ.erase i₀, (θ i : ℝ≥0∞) * ENNReal.ofReal (w i) =
      ∑ i, (θ i : ℝ≥0∞) * ENNReal.ofReal (w i) :=
    Finset.add_sum_erase _ (fun i => (θ i : ℝ≥0∞) * ENNReal.ofReal (w i)) (Finset.mem_univ i₀)
  have hsplitN : (θ i₀ : ℝ≥0∞) * ENNReal.ofReal t +
      ∑ i ∈ Finset.univ.erase i₀, (θ i : ℝ≥0∞) * ENNReal.ofReal t =
      ∑ i, (θ i : ℝ≥0∞) * ENNReal.ofReal t :=
    Finset.add_sum_erase _ (fun i => (θ i : ℝ≥0∞) * ENNReal.ofReal t) (Finset.mem_univ i₀)
  -- `E = ι \ {i₀}` is nonempty, since otherwise `k τ = m τ`, i.e. `k = m`
  have hE : (Finset.univ.erase i₀).Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro hE
    rw [← hsplitH, hE, Finset.sum_empty, add_zero, hk, hw0, ENNReal.mul_left_inj hτ0 hτ] at hsum
    exact hkm.ne (by exact_mod_cast hsum)
  -- each remaining term is strictly below `θ i τ`, so `m τ < N τ`
  have hstrict : ∑ i ∈ Finset.univ.erase i₀, (θ i : ℝ≥0∞) * ENNReal.ofReal (w i) <
      ∑ i ∈ Finset.univ.erase i₀, (θ i : ℝ≥0∞) * ENNReal.ofReal t := by
    refine ENNReal.sum_lt_sum_of_nonempty hE fun i hi => ?_
    have hθi : (θ i : ℝ≥0∞) ≠ 0 := by exact_mod_cast (Nat.one_le_iff_ne_zero.mp (hθ1 i))
    exact ENNReal.mul_lt_mul_right hθi (ENNReal.natCast_ne_top _)
      ((ENNReal.ofReal_lt_ofReal_iff ht).mpr (hlt i (Finset.ne_of_mem_erase hi)))
  have hmN : (m : ℝ≥0∞) * ENNReal.ofReal t < (∑ i, (θ i : ℝ≥0∞)) * ENNReal.ofReal t := by
    rw [← hsum, ← hsplitH, Finset.sum_mul, ← hsplitN, hw0]
    exact ENNReal.add_lt_add_left (ENNReal.mul_ne_top (ENNReal.natCast_ne_top _) hτ) hstrict
  -- `N` is the natural number `∑ i, θ i`, so `m < N` gives `m + 1 ≤ N`
  have hmN' : m < ∑ i, θ i := by exact_mod_cast (ENNReal.mul_lt_mul_iff_left hτ0 hτ).mp hmN
  exact_mod_cast hmN'

/-- Pointwise fibre count for the density at the edge of a planar sector of a `2`-dimensional
minimizing cone (part of the classification of such cones used in the proof of Simon 7.3.3(1),
which the book cites to [Whi82]).  Let `p = (t, α)` with `|t − 1| < s`, `|α| < s ≤ 1/4`, let `X(p) = M ∩ Z_s ∩ F̃⁻¹{p}` be the fibre of
`F̃(x) = (|x|, arctan(⟨x, e⟩/⟨x, a⟩))` and weight its points by `w(x) = |p_{TₓM}(Ax)|`,
`Ax = ⟨x, a⟩e − ⟨x, e⟩a`.  Every fibre point has `|x| = t` and `w(x) ≤ |πx| ≤ t`, so
`Σ θ w = mt` forces `Σ θ ≥ m`.  If `x_Q(p) = t(cos α a + sin α e) ∈ M` has multiplicity `k` and
`T_{x_Q(p)}M = Q`, it is a fibre point of weight `t` and every other fibre point has weight `< t`,
so `k ≤ m`, and `Σ θ ≥ m + 1` if `k < m`.  The planar facts are
`idtp_cse_fc_planar_fibre_geometry`; the counting is `idtp_cse_fc_tsum_count_arith`. -/
theorem Submission.idtp_cse_fc_fibre_pointwise : ∀ (P : ℕ) (R : IMRep (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (s : ℝ) (m k : ℕ) (p : ℝ × ℝ), Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → 0 < s → s ≤ 1 / 4 → |p.1 - 1| < s → |p.2| < s → ∑' x : ↥(R.carrier ∩ {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} ∩ (fun x : Euclid P => (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a))) ⁻¹' {p}), (R.mult x : ℝ≥0∞) * ENNReal.ofReal ‖(approxTangentPlane 2 R.carrier (x : Euclid P)).starProjection (inner ℝ (x : Euclid P) a • e - inner ℝ (x : Euclid P) e • a)‖ = ENNReal.ofReal ((m : ℝ) * p.1) → (m : ℝ≥0∞) ≤ ∑' x : ↥(R.carrier ∩ {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} ∩ (fun x : Euclid P => (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a))) ⁻¹' {p}), (R.mult x : ℝ≥0∞) ∧ ((p.1 • (Real.cos p.2 • a + Real.sin p.2 • e)) ∈ R.carrier → R.mult (p.1 • (Real.cos p.2 • a + Real.sin p.2 • e)) = k → approxTangentPlane 2 R.carrier (p.1 • (Real.cos p.2 • a + Real.sin p.2 • e)) = Q → k ≤ m ∧ (k < m → (m : ℝ≥0∞) + 1 ≤ ∑' x : ↥(R.carrier ∩ {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} ∩ (fun x : Euclid P => (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a))) ⁻¹' {p}), (R.mult x : ℝ≥0∞))) := by
  intro P R Q a e s m k p hQ haQ heQ ha he hae hs hs4 hp1 hp2 hH
  obtain ⟨hA, hB⟩ := Submission.idtp_cse_fc_planar_fibre_geometry P Q a e hQ haQ heQ ha he hae
  -- `t = p.1 > 0` and `|α| = |p.2| < 1/4 < π/2`
  have ht : 0 < p.1 := by linarith [(abs_lt.mp hp1).1]
  have hα : |p.2| < Real.pi / 2 := by linarith [Real.two_le_pi]
  obtain ⟨⟨hx0a, hx0n, hx0f, hx0Q, hx0w⟩, hlt⟩ := hB p.1 p.2 ht hα
  -- a fibre point `x` has `|x| = t` and `f(x) = α`, hence weight `w(x) ≤ |πx| ≤ t`
  have hfib : ∀ x : Euclid P, (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a)) = p →
      ‖x‖ = p.1 ∧ Real.arctan (inner ℝ x e / inner ℝ x a) = p.2 := fun x hx =>
    ⟨congrArg Prod.fst hx, congrArg Prod.snd hx⟩
  have hw : ∀ i : ↥(R.carrier ∩ {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} ∩ (fun x : Euclid P => (‖x‖, Real.arctan (inner ℝ x e / inner ℝ x a))) ⁻¹' {p}),
      ‖(approxTangentPlane 2 R.carrier (i : Euclid P)).starProjection
        (inner ℝ (i : Euclid P) a • e - inner ℝ (i : Euclid P) e • a)‖ ≤ p.1 := fun i =>
    ((hA (approxTangentPlane 2 R.carrier i) i).1.trans (hA Q i).2).trans (hfib i i.2.2).1.le
  -- `m ≤ N(p)`
  obtain ⟨hmN, hcount⟩ := Submission.idtp_cse_fc_tsum_count_arith _ _ _ p.1 m ht hw hH
  refine ⟨hmN, fun hx0M hx0k hx0T => ?_⟩
  -- `x_Q(p)` is a fibre point of weight `t`, every other fibre point has weight `< t`
  refine hcount ⟨p.1 • (Real.cos p.2 • a + Real.sin p.2 • e), ⟨hx0M, hx0a, ?_, ?_, ?_⟩, ?_⟩ k
    (fun i => R.mult_pos _ i.2.1.1) hx0k ?_ fun i hi => ?_
  · rw [hx0n]; exact hp1
  · rw [hx0f]; exact hp2
  · rw [hx0Q, sub_self, norm_zero, hx0n]; exact mul_pos hs ht
  · exact Prod.ext hx0n hx0f
  · show ‖(approxTangentPlane 2 R.carrier _).starProjection _‖ = p.1
    rw [hx0T]; exact hx0w
  · obtain ⟨hin, hif⟩ := hfib i i.2.2
    exact (hA (approxTangentPlane 2 R.carrier i) i).1.trans_lt
      (hlt i i.2.1.2.1 hin hif fun h => hi (Subtype.ext h))
/-- **Lower bound for `∫⁻ N` over the square** `Sq = (1 − r, 1 + r) × (−r, r)` (parent step 5).
Let `U = {p : p₂ > 0}` and `g = m + 1_U`.  The two hypotheses give `g ≤ N` a.e. on `Sq`, so
`∫⁻_{Sq} N ≥ ∫⁻_{Sq} g = m·λ(Sq) + λ(U ∩ Sq)` (`U` is measurable, so `lintegral_add_left` and
`lintegral_indicator_one` apply; `N` itself need not be measurable).  Since `r > 0`,
`U ∩ Sq = (1 − r, 1 + r) × (0, r)`, and `Measure.prod_prod` with `Real.volume_Ioo` gives
`λ(Sq) = 4r²` and `λ(U ∩ Sq) = 2r²`.  Hence `∫⁻_{Sq} g = 4m r² + 2r² = (4m + 2) r²`. -/
theorem Submission.idtp_cse_fc_square_lintegral_lower : ∀ (N : ℝ × ℝ → ℝ≥0∞) (m : ℕ) (r : ℝ), 0 < r → (∀ᵐ p : ℝ × ℝ, p ∈ Ioo (1 - r) (1 + r) ×ˢ Ioo (-r) r → (m : ℝ≥0∞) ≤ N p) → (∀ᵐ p : ℝ × ℝ, p ∈ Ioo (1 - r) (1 + r) ×ˢ Ioo (-r) r → 0 < p.2 → (m : ℝ≥0∞) + 1 ≤ N p) → ENNReal.ofReal ((4 * (m : ℝ) + 2) * r ^ 2) ≤ ∫⁻ p in Ioo (1 - r) (1 + r) ×ˢ Ioo (-r) r, N p := by
  intro N m r hr hm hm1
  -- Measurability of `Sq` and of `U = {p₂ > 0}`.
  have hSq : MeasurableSet (Ioo (1 - r) (1 + r) ×ˢ Ioo (-r) r : Set (ℝ × ℝ)) :=
    measurableSet_Ioo.prod measurableSet_Ioo
  have hU : MeasurableSet {p : ℝ × ℝ | 0 < p.2} := measurableSet_lt measurable_const measurable_snd
  -- `g = m + 1_U ≤ N` a.e. on `Sq`.
  have hg : ∀ᵐ p ∂(volume.restrict (Ioo (1 - r) (1 + r) ×ˢ Ioo (-r) r)),
      (m : ℝ≥0∞) + {p : ℝ × ℝ | 0 < p.2}.indicator 1 p ≤ N p := by
    rw [ae_restrict_iff' hSq]
    filter_upwards [hm, hm1] with p hp hp1 hpSq
    by_cases hp2 : 0 < p.2
    · rw [indicator_of_mem (show p ∈ {p : ℝ × ℝ | 0 < p.2} from hp2), Pi.one_apply]
      exact hp1 hpSq hp2
    · rw [indicator_of_notMem (show p ∉ {p : ℝ × ℝ | 0 < p.2} from hp2), add_zero]
      exact hp hpSq
  -- `U ∩ Sq = (1 − r, 1 + r) × (0, r)`, and the two volumes.
  have hUSq : {p : ℝ × ℝ | 0 < p.2} ∩ Ioo (1 - r) (1 + r) ×ˢ Ioo (-r) r =
      Ioo (1 - r) (1 + r) ×ˢ Ioo 0 r := by
    ext p
    simp only [mem_inter_iff, mem_ofPred_eq, mem_prod, mem_Ioo]
    constructor
    · rintro ⟨h2, h1, -, h2r⟩
      exact ⟨h1, h2, h2r⟩
    · rintro ⟨h1, h2, h2r⟩
      exact ⟨h2, h1, by linarith, h2r⟩
  have hSqvol : volume (Ioo (1 - r) (1 + r) ×ˢ Ioo (-r) r : Set (ℝ × ℝ)) =
      ENNReal.ofReal (4 * r ^ 2) := by
    rw [Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Ioo, Real.volume_Ioo,
      ← ENNReal.ofReal_mul (by linarith)]
    congr 1
    ring
  have hUvol : volume (Ioo (1 - r) (1 + r) ×ˢ Ioo 0 r : Set (ℝ × ℝ)) =
      ENNReal.ofReal (2 * r ^ 2) := by
    rw [Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Ioo, Real.volume_Ioo,
      ← ENNReal.ofReal_mul (by linarith)]
    congr 1
    ring
  -- `∫⁻_{Sq} g = m·λ(Sq) + λ(U ∩ Sq) = (4m + 2) r² ≤ ∫⁻_{Sq} N`.
  calc ENNReal.ofReal ((4 * (m : ℝ) + 2) * r ^ 2)
      = (m : ℝ≥0∞) * ENNReal.ofReal (4 * r ^ 2) + ENNReal.ofReal (2 * r ^ 2) := by
        rw [← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_add (by positivity) (by positivity)]
        congr 1
        ring
    _ = ∫⁻ p in Ioo (1 - r) (1 + r) ×ˢ Ioo (-r) r,
          ((m : ℝ≥0∞) + {p : ℝ × ℝ | 0 < p.2}.indicator 1 p) := by
        rw [lintegral_add_left measurable_const, setLIntegral_const, lintegral_indicator_one hU,
          Measure.restrict_apply hU, hUSq, hSqvol, hUvol]
    _ ≤ ∫⁻ p in Ioo (1 - r) (1 + r) ×ˢ Ioo (-r) r, N p := lintegral_mono_ae hg

/-- **Upper bound for the fibre Jacobian over `Z(s, s')`** (step 6 of the fibre count in the proof
of Simon 7.3.3).  Write `π = p_Q`, `Ax = ⟨x, a⟩e − ⟨x, e⟩a` and `J(x) = |p_{TₓM}(Ax)| / |πx|²`.  At
`μ`-a.e. `x ∈ Z(s, s')` the localization hypothesis gives `|x − πx| < (s'/4)|x|`, so
`|πx| > (1 − s'/4)(1 − s') ≥ 1 − 2s' > 0`.  Since `|p_{TₓM}(Ax)| ≤ |πx|`
(`idtp_cse_fc_planar_fibre_geometry`), `J(x) ≤ 1/|πx| ≤ 1/(1 − 2s')`; integrate this constant
bound over `Z(s, s')`. -/
theorem Submission.idtp_cse_fc_jacobian_upper : ∀ (P : ℕ) (R : IMRep (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (S : Set (Euclid P)) (s s' : ℝ), Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → (∀ᵐ x ∂R.measure, x ∈ S) → 0 < s' → s' ≤ 1 / 4 → (∀ x ∈ S, 0 < inner ℝ x a → |‖x‖ - 1| < s' → |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' → ‖x - Q.starProjection x‖ < s * ‖x‖ → ‖x - Q.starProjection x‖ < s' / 4 * ‖x‖) → ∫⁻ x in {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s' ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' ∧ ‖x - Q.starProjection x‖ < s * ‖x‖}, ENNReal.ofReal (‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ / ‖Q.starProjection x‖ ^ 2) ∂R.measure ≤ ENNReal.ofReal (1 / (1 - 2 * s')) * R.measure {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s' ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} := by
  intro P R Q a e S s s' hQ ha he ha1 he1 hae hS hs' hs'4 hloc
  -- `|p_T(Ax)| ≤ |πx|` for every plane `T` (planar geometry (a))
  have hw := (Submission.idtp_cse_fc_planar_fibre_geometry P Q a e hQ ha he ha1 he1 hae).1
  -- compare with the constant `ofReal (1 / (1 - 2s'))`, a.e. on `Z(s, s')`
  refine (setLIntegral_mono_ae aemeasurable_const (hS.mono fun x hxS hxZ => ?_)).trans_eq
    (setLIntegral_const _ _)
  obtain ⟨hxa, hx1, hxf, hxs⟩ := hxZ
  -- localization at `x ∈ S ∩ Z(s, s')`, and `|x| > 1 - s'`
  have hxπ := hloc x hxS hxa hx1 hxf hxs
  have hx : 1 - s' < ‖x‖ := by linarith [(abs_lt.mp hx1).1]
  -- `|πx| ≥ |x| - |x - πx| > (1 - s'/4)|x| > (1 - s'/4)(1 - s') ≥ 1 - 2s' > 0`
  have htri : ‖x‖ - ‖x - Q.starProjection x‖ ≤ ‖Q.starProjection x‖ := by
    simpa using norm_sub_norm_le x (x - Q.starProjection x)
  have h2s' : 0 < 1 - 2 * s' := by linarith
  have hπ : 1 - 2 * s' < ‖Q.starProjection x‖ := by
    nlinarith [mul_lt_mul_of_pos_left hx (show 0 < 1 - s' / 4 by linarith)]
  have hπ0 : 0 < ‖Q.starProjection x‖ := h2s'.trans hπ
  -- `J(x) ≤ |πx| / |πx|² = 1 / |πx| ≤ 1 / (1 - 2s')`
  refine ENNReal.ofReal_le_ofReal ?_
  calc _ ≤ ‖Q.starProjection x‖ / ‖Q.starProjection x‖ ^ 2 := by
        gcongr
        exact (hw _ x).1
    _ = 1 / ‖Q.starProjection x‖ := by field_simp
    _ ≤ 1 / (1 - 2 * s') := one_div_le_one_div_of_le h2s' hπ.le
/-- **Simon 6.2.5** (mass of a restricted, positively scaled current; proof of 7.4.2, step 5).  If
`W ⊆ V ⊆ U`, `c ≥ 0`, and `T ∈ 𝒟ₙ(U)`, `T₀ ∈ 𝒟ₙ(V)` satisfy `T(ι ω) = c T₀(ω)` for every
`ω ∈ 𝒟ⁿ(V)` (`ι` = `testFormOnInclusion`), then `M_W(T) = c M_W(T₀)`.  A form admissible for
`M_W` has `spt ω ⊆ W ⊆ V`, so `ι` is a bijection from the admissible forms in `V` onto those in
`U`; the two value sets therefore agree after scaling by `c`, and `c` pulls out of the supremum
in `[0, ∞]`. -/
theorem Submission.rsd_cmr_massOn_eq_ofReal_mul : ∀ (P n : ℕ) (U V : Set (Euclid P)) (hVU : V ⊆ U) (T : GeometricCurrentOn U n) (T₀ : GeometricCurrentOn V n) (c : ℝ), 0 ≤ c → (∀ ω : TestFormOn V n, T (testFormOnInclusion hVU n ω) = c * T₀ ω) → ∀ W : Set (Euclid P), W ⊆ V → T.massOn W = ENNReal.ofReal c * T₀.massOn W := by
  intro P n U V hVU T T₀ c hc hT W hWV
  -- the values `ofReal (T ω)` over admissible `ω ∈ 𝒟ⁿ(U)` are the scaled values of `T₀`
  have hvalues : (fun ω ↦ ENNReal.ofReal (T ω)) '' massAdmissibleOn U n W =
      (fun ω' ↦ ENNReal.ofReal c * ENNReal.ofReal (T₀ ω')) '' massAdmissibleOn V n W := by
    ext r
    constructor
    · -- an admissible `ω ∈ 𝒟ⁿ(U)` has `spt ω ⊆ W ⊆ V`, so it is an admissible `ω' ∈ 𝒟ⁿ(V)`
      rintro ⟨ω, hω, rfl⟩
      let ω' : TestFormOn V n := ⟨ω, ω.property.1, hω.1.trans hWV⟩
      have hincl : testFormOnInclusion hVU n ω' = ω := Subtype.ext rfl
      refine ⟨ω', hω, ?_⟩
      dsimp only
      rw [← ENNReal.ofReal_mul hc, ← hT ω', hincl]
    · -- an admissible `ω' ∈ 𝒟ⁿ(V)` is admissible in `U` after inclusion
      rintro ⟨ω', hω', rfl⟩
      refine ⟨testFormOnInclusion hVU n ω', hω', ?_⟩
      dsimp only
      rw [hT ω', ENNReal.ofReal_mul hc]
  -- `ofReal c` pulls out of the supremum in `[0, ∞]`
  unfold GeometricCurrentOn.massOn
  rw [hvalues, ENNReal.mul_sSup, sSup_image, iSup_image]
/-- **Simon 6.2.11** (`spt T`, chapter-06.txt lines 296–302) under `T = c T₀` in `V`: the support
step of the reduction to multiplicity one behind 7.4.2 (chapter-07.txt lines 608–610), as in the
proof of Ch. 5, 7.3 (chapter-05.txt lines 1388–1395).  If `V ⊆ U` is open, `c ≠ 0` and
`T(ι ω) = c T₀(ω)` for every `ω ∈ 𝒟ⁿ(V)`, then `spt T₀ = spt T ∩ V`: a zero set of `T₀` is a zero
set of `T`, because a form in `U` supported in it is `ι` of a form in `V`; and a zero set `W ∋ y`
of `T` with `y ∈ V` shrinks to `W ∩ B_{s/2}(y)`, `B_s(y) ⊆ V`, a zero set of `T₀` as `c ≠ 0`. -/
theorem Submission.rsd_cmr_support_eq_inter : ∀ (P n : ℕ) (U V : Set (Euclid P)) (hVU : V ⊆ U) (T : GeometricCurrentOn U n) (T₀ : GeometricCurrentOn V n) (c : ℝ), IsOpen V → c ≠ 0 → (∀ ω : TestFormOn V n, T (testFormOnInclusion hVU n ω) = c * T₀ ω) → T₀.support = T.support ∩ V := by
  intro P n U V hVU T T₀ c hV hc hT
  -- Step 2: `Z(T₀) ⊆ Z(T)`; a form in `U` supported in `W ⊆ closure W ⊆ V` is `ι` of a form in `V`.
  have hZ₀ : T₀.zeroRegion ⊆ T.zeroRegion := by
    rintro y ⟨W, ⟨hWo, hWc, hWV, hW⟩, hyW⟩
    refine ⟨W, ⟨hWo, hWc, hWV.trans hVU, fun ω hω => ?_⟩, hyW⟩
    have hωV : (ω : DifferentialForm (Euclid P) n) ∈ testFormOnSubmodule V n :=
      ⟨ω.property.1, hω.trans (subset_closure.trans hWV)⟩
    calc T ω = T (testFormOnInclusion hVU n ⟨ω, hωV⟩) := rfl
      _ = c * T₀ ⟨ω, hωV⟩ := hT _
      _ = 0 := by rw [hW ⟨ω, hωV⟩ hω, mul_zero]
  -- Step 3: `Z(T) ∩ V ⊆ Z(T₀)`; shrink `W ∋ y` to `W ∩ B_{s/2}(y)`, `B_s(y) ⊆ V`, and cancel `c`.
  have hZ : T.zeroRegion ∩ V ⊆ T₀.zeroRegion := by
    rintro y ⟨⟨W, ⟨hWo, hWc, -, hW⟩, hyW⟩, hyV⟩
    obtain ⟨s, hs, hsV⟩ := Metric.isOpen_iff.1 hV y hyV
    refine ⟨W ∩ ball y (s / 2), ⟨hWo.inter isOpen_ball,
      hWc.of_isClosed_subset isClosed_closure (closure_mono inter_subset_left),
      (closure_mono inter_subset_right).trans (closure_ball_subset_closedBall.trans
        ((closedBall_subset_ball (half_lt_self hs)).trans hsV)), fun ω hω => ?_⟩,
      hyW, mem_ball_self (half_pos hs)⟩
    have h0 : c * T₀ ω = 0 := (hT ω).symm.trans (hW _ (hω.trans inter_subset_left))
    exact (mul_eq_zero.1 h0).resolve_left hc
  -- Steps 1 and 4: `spt T₀ = V \ Z(T₀) = V \ Z(T) = (U \ Z(T)) ∩ V`.
  ext y
  constructor
  · rintro ⟨hyV, hy⟩
    exact ⟨⟨hVU hyV, fun h => hy (hZ ⟨h, hyV⟩)⟩, hyV⟩
  · rintro ⟨⟨-, hy⟩, hyV⟩
    exact ⟨hyV, fun h => hy (hZ₀ h)⟩
/-- **`Hⁿ` under the blow-up map `η_{x,r}(y) = r⁻¹(y − x)`, `r > 0`**: `Hⁿ(η_{x,r}(S)) = r⁻ⁿ Hⁿ(S)`
for every `S ⊆ ℝᴾ`, the scaling used in the proof of Simon Ch. 3, Theorem 1.6 "⇒".  `η_{x,r}` is
the translation `y ↦ y + (−x)`, an isometry, followed by the dilation `z ↦ r⁻¹z`, and
`Hⁿ(cT) = |c|ⁿ Hⁿ(T)` for `c ≠ 0`. -/
theorem Submission.rsd_cmr_ir_blowUp_image_measure : ∀ (P n : ℕ) (x : Euclid P) (r : ℝ) (S : Set (Euclid P)), 0 < r → μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' S) = ENNReal.ofReal (r⁻¹ ^ n) * μHE[n] S := by
  intro P n x r S hr
  -- `η_{x,r}(S) = r⁻¹ • (S + (−x))`: `η_{x,r}(y) = r⁻¹ • (y − x)` and `y − x = y + (−x)`.
  have hS : Poincare.SimonGMT.Chapter03.blowUpMap x r '' S =
      (fun z => r⁻¹ • z) '' ((fun y => y + -x) '' S) := by
    rw [Set.image_image]
    rfl
  -- `Hⁿ(r⁻¹ • T) = ‖r⁻¹‖₊ⁿ • Hⁿ(T)`, translation invariance, and `‖r⁻¹‖₊ⁿ = r⁻¹ ^ n` for `r > 0`.
  rw [hS, Set.image_smul, Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hr.ne'),
    (isometry_add_right (-x)).euclideanHausdorffMeasure_image, ENNReal.smul_def, smul_eq_mul,
    ← ENNReal.ofReal_coe_nnreal]
  congr 2
  simp [abs_of_pos hr]

/-- Deleting from the Borel set `M` a set that is `Hⁿ`-null near `x` keeps the approximate
tangent space of `M` at `x` (Simon Ch. 3, 1.4): if `M' ⊆ M` and `Hⁿ((M ∖ M') ∩ B_δ(x)) = 0`, then
`TₓM = Q` gives `TₓM' = Q`.  Choose `R₀ > 0` with `spt f ⊆ B̄_{R₀}(0)`.  For
`0 < λ < δ/(R₀ + 1)`, a point `z = η_{x,λ}(y)` of `η_{x,λ}(M) ∖ η_{x,λ}(M')` with `f(z) ≠ 0` has
`y ∈ M ∖ M'` and `|y − x| = λ|z| ≤ λR₀ < δ`, so it lies in `η_{x,λ}((M ∖ M') ∩ B_δ(x))`, which is
`Hⁿ`-null by `rsd_cmr_ir_blowUp_image_measure`.  Hence `f = 0` a.e. on
`η_{x,λ}(M) ∖ η_{x,λ}(M')`, and the Borel set `η_{x,λ}(M)` and its subset `η_{x,λ}(M')` carry the
same integral of `f` for all small `λ` (as in the proof of 1.6 "⇒"). -/
theorem Submission.rsd_cmr_ir_approxTangent_of_local_null : ∀ (P n : ℕ) (M M' : Set (Euclid P)) (x : Euclid P) (δ : ℝ) (Q : Submodule ℝ (Euclid P)), MeasurableSet M → M' ⊆ M → 0 < δ → μHE[n] ((M \ M') ∩ ball x δ) = 0 → HasApproximateTangentSpaceAt n M x Q → HasApproximateTangentSpaceAt n M' x Q := by
  intro P n M M' x δ Q hM hM'M hδ hnull hT
  refine ⟨hT.1, fun f => ?_⟩
  -- `spt f ⊆ B̄_{R₀}(0)` with `R₀ > 0`
  obtain ⟨R₀, hR₀, hfR₀⟩ := f.hasCompactSupport.isCompact.isBounded.subset_closedBall_lt 0 0
  have hR₀' : (0 : ℝ) < R₀ + 1 := by linarith
  refine (hT.2 f).congr' ?_
  filter_upwards [Ioo_mem_nhdsGT (div_pos hδ hR₀')] with r hr
  have hr0 : r ≠ 0 := hr.1.ne'
  -- `Z_λ = η_{x,λ}((M ∖ M') ∩ B_δ(x))` is `Hⁿ`-null
  have hZ : μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' ((M \ M') ∩ ball x δ)) = 0 := by
    rw [Submission.rsd_cmr_ir_blowUp_image_measure P n x r _ hr.1, hnull, mul_zero]
  -- `η_{x,λ}(y) = λ⁻¹ • (y − x)`
  have hη : Poincare.SimonGMT.Chapter03.blowUpMap x r = fun y => r⁻¹ • (y - x) := rfl
  rw [hη] at hZ ⊢
  -- `η_{x,λ}(M)` is Borel: it is the preimage of `M` under `z ↦ x + λ • z`
  have hmeas : MeasurableSet ((fun y => r⁻¹ • (y - x)) '' M) := by
    have himg : (fun y => r⁻¹ • (y - x)) '' M = (fun z => x + r • z) ⁻¹' M := by
      ext z
      constructor
      · rintro ⟨y, hy, rfl⟩
        simpa [smul_smul, mul_inv_cancel₀ hr0] using hy
      · intro hz
        exact ⟨x + r • z, hz, by simp [smul_smul, inv_mul_cancel₀ hr0]⟩
    rw [himg]
    exact hM.preimage (by fun_prop)
  -- `f` vanishes on `η_{x,λ}(M) ∖ η_{x,λ}(M')` off `Z_λ`, hence a.e. there
  refine setIntegral_eq_of_subset_of_ae_sdiff_eq_zero hmeas.nullMeasurableSet
    (image_mono hM'M) ?_
  filter_upwards [measure_eq_zero_iff_ae_notMem.mp hZ] with z hzZ hz
  obtain ⟨⟨y, hyM, rfl⟩, hyM'⟩ := hz
  apply image_eq_zero_of_notMem_tsupport
  intro hyf
  apply hzZ
  refine ⟨y, ⟨⟨hyM, fun h => hyM' ⟨y, h, rfl⟩⟩, ?_⟩, rfl⟩
  -- `|y − x| = λ|η_{x,λ}(y)| ≤ λR₀ < λ(R₀ + 1) < δ`
  have h1 : ‖r⁻¹ • (y - x)‖ ≤ R₀ := mem_closedBall_zero_iff.mp (hfR₀ hyf)
  rw [norm_smul, norm_inv, Real.norm_of_nonneg hr.1.le, inv_mul_le_iff₀ hr.1] at h1
  have h2 := (lt_div_iff₀ hR₀').mp hr.2
  rw [mem_ball, dist_eq_norm]
  linarith [hr.1]

/-- **Restricting an integer multiplicity triple to a locally full-measure subset.**  If
`R = (M, θ, ξ)` is an integer multiplicity triple in `U` and `A` is Borel, then `(M ∩ A, θ', ξ)` is
one in `U'` provided `M ∩ A ⊆ U'`, `θ'` is measurable, positive on `M ∩ A` and locally integrable
on `M ∩ A` in `U'`, and `Hⁿ`-a.e. `x ∈ M ∩ A` has a ball `B_δ(x)` with `Hⁿ((M \ A) ∩ B_δ(x)) = 0`.
This is used for `(M ∩ B, 1, ξ)`, `B` open, and for `(M_X ∩ K, θ_X, ξ_X)` in the constant
multiplicity reduction behind Simon 7.4.2 (via Ch. 5, Corollary 7.3).  All fields but the
orientation pass from `R` to the subset `M ∩ A ⊆ M`; at such `x`, `T_x(M ∩ A) = T_xM`
(Simon Ch. 3, Definition 1.4, chapter-03.txt lines 77–84) by
`Submission.rsd_cmr_ir_approxTangent_of_local_null`, since `M \ (M ∩ A) = M \ A`. -/
theorem Submission.rsd_cmr_imrep_restrict : ∀ (P n : ℕ) (U U' A : Set (Euclid P)) (R : IMRep U n) (θ : Euclid P → ℕ), MeasurableSet A → R.carrier ∩ A ⊆ U' → Measurable θ → (∀ x ∈ R.carrier ∩ A, 0 < θ x) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U' → ∫⁻ x in R.carrier ∩ A ∩ K, (θ x : ℝ≥0∞) ∂μHE[n] ≠ ∞) → (∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ A)), ∃ δ : ℝ, 0 < δ ∧ μHE[n] ((R.carrier \ A) ∩ ball x δ) = 0) → ∃ R' : IMRep U' n, R'.carrier = R.carrier ∩ A ∧ R'.mult = θ ∧ R'.orient = R.orient := by
  intro P n U U' A R θ hA hsub hθ hθpos hθint hlocal
  refine ⟨{ carrier := R.carrier ∩ A
            mult := θ
            orient := R.orient
            measurableSet_carrier := R.measurableSet_carrier.inter hA
            carrier_subset := hsub
            rectifiable := R.rectifiable.mono inter_subset_left
            measurable_mult := hθ
            mult_pos := hθpos
            locallyIntegrable_mult := hθint
            aestronglyMeasurable_orient :=
              R.aestronglyMeasurable_orient.mono_set inter_subset_left
            orients := ?_ }, rfl, rfl, rfl⟩
  -- `Hⁿ⌞(M ∩ A)`-a.e. `x` has `T_xM = Q` oriented by `ξ(x)` (from `Hⁿ⌞M`-a.e., `M ∩ A ⊆ M`) and
  -- a ball `B_δ(x)` on which `M \ (M ∩ A) = M \ A` is `Hⁿ`-null, so `T_x(M ∩ A) = Q`.
  filter_upwards [ae_restrict_of_ae_restrict_of_subset inter_subset_left R.orients, hlocal]
    with x ⟨Q, hQ, hξ⟩ ⟨δ, hδ, hnull⟩
  refine ⟨Q, Submission.rsd_cmr_ir_approxTangent_of_local_null P n R.carrier (R.carrier ∩ A) x δ Q
    R.measurableSet_carrier inter_subset_left hδ ?_ hQ, hξ⟩
  rwa [Set.sdiff_self_inter]
/-- An embedded `Cʳ` submanifold `M ⊆ ℝᴾ` (Simon Ch. 2, §4, (4.1)) is Borel, and it meets every
small closed ball about one of its points in a compact set.  For a chart `(V, W, ψ)` and a compact
`K ⊆ W`, `M ∩ K = ψ(V ∩ ψ⁻¹(K))` is compact because `ψ` is proper and continuous on `V`.  With `O`
the union of the chart domains `W`, `M = O ∩ closure M`: a point `p ∈ O ∩ closure M` lies in the
closure of the compact, hence closed, set `M ∩ closedBall p ε`.  So `M` is Borel. -/
theorem Submission.dimred_rpd_embedded_locally_closed : ∀ (P r d : ℕ) (M : Set (Euclid P)), IsEmbeddedSubmanifold r d M → MeasurableSet M ∧ ∀ y ∈ M, ∃ ε : ℝ, 0 < ε ∧ IsCompact (M ∩ closedBall y ε) := by
  intro P r d M hM
  -- step 1: for a chart `(V, W, ψ)` at `y` and compact `K ⊆ W`, `M ∩ K = ψ(V ∩ ψ⁻¹(K))` is compact
  have key : ∀ y ∈ M, ∃ W : Set (Euclid P), IsOpen W ∧ y ∈ W ∧
      ∀ K ⊆ W, IsCompact K → IsCompact (M ∩ K) := by
    intro y hy
    obtain ⟨V, W, ψ, -, hW, hyW, hψ, -, himg, hprop, -⟩ := hM y hy
    refine ⟨W, hW, hyW, fun K hKW hK => ?_⟩
    have hEq : M ∩ K = ψ '' (V ∩ ψ ⁻¹' K) := by
      ext x
      constructor
      · rintro ⟨hxM, hxK⟩
        have hx : x ∈ ψ '' V := by rw [himg]; exact ⟨hKW hxK, hxM⟩
        obtain ⟨v, hv, rfl⟩ := hx
        exact ⟨v, ⟨hv, hxK⟩, rfl⟩
      · rintro ⟨v, ⟨hv, hvK⟩, rfl⟩
        have hv' : ψ v ∈ W ∩ M := by rw [← himg]; exact ⟨v, hv, rfl⟩
        exact ⟨hv'.2, hvK⟩
    rw [hEq]
    exact (hprop K hKW hK).image_of_continuousOn (hψ.continuousOn.mono inter_subset_left)
  refine ⟨?_, ?_⟩
  · -- steps 3-5: `O = ⋃_{y ∈ M} W_y` is open and `M = O ∩ closure M`, so `M` is Borel
    choose! Wf hWo hyW hcpt using key
    have hO : IsOpen (⋃ y ∈ M, Wf y) := isOpen_biUnion fun y hy => hWo y hy
    have hMeq : M = (⋃ y ∈ M, Wf y) ∩ closure M := by
      apply Subset.antisymm
      · intro x hx
        exact ⟨mem_biUnion hx (hyW x hx), subset_closure hx⟩
      · -- `p ∈ O ∩ closure M` lies in the closure of the compact set `M ∩ closedBall p (r'/2)`
        rintro p ⟨hpO, hpcl⟩
        obtain ⟨y, hy, hpW⟩ := mem_iUnion₂.1 hpO
        obtain ⟨r', hr', hball⟩ := Metric.isOpen_iff.1 (hWo y hy) p hpW
        have hcb : closedBall p (r' / 2) ⊆ Wf y :=
          (closedBall_subset_ball (by linarith)).trans hball
        have hC := hcpt y hy (closedBall p (r' / 2)) hcb (isCompact_closedBall p (r' / 2))
        have h1 : p ∈ ball p (r' / 2) ∩ closure M := ⟨mem_ball_self (by linarith), hpcl⟩
        have h2 := isOpen_ball.inter_closure h1
        have hsub : ball p (r' / 2) ∩ M ⊆ M ∩ closedBall p (r' / 2) :=
          fun x hx => ⟨hx.2, ball_subset_closedBall hx.1⟩
        have h3 : p ∈ closure (M ∩ closedBall p (r' / 2)) := closure_mono hsub h2
        rw [hC.isClosed.closure_eq] at h3
        exact h3.1
    rw [hMeq]
    exact hO.measurableSet.inter isClosed_closure.measurableSet
  · -- step 2: a closed ball about `y` inside the chart domain `W` meets `M` in a compact set
    intro y hy
    obtain ⟨W, hW, hyW, hcpt⟩ := key y hy
    obtain ⟨r', hr', hball⟩ := Metric.isOpen_iff.1 hW y hyW
    exact ⟨r' / 2, by linarith,
      hcpt _ ((closedBall_subset_ball (by linarith)).trans hball) (isCompact_closedBall y _)⟩
/-- Orthonormal partner of a unit vector `u` in a 2-plane `Q`: pick `w ∈ Q \ span {u}`
(`dim span {u} = 1 < 2`), put `e = e'/‖e'‖` with `e' = w - ⟨w, u⟩u`; then `(u, e)` is
orthonormal, so `span {u, e} = Q` by dimension, and `v = au + be` gives `a = ⟨v, u⟩`,
`b = ⟨v, e⟩`. -/
theorem Submission.idtp_ccd_scsp_cc_plane_orthonormal : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (u : Euclid P), Module.finrank ℝ Q = 2 → u ∈ Q → ‖u‖ = 1 → ∃ e : Euclid P, e ∈ Q ∧ ‖e‖ = 1 ∧ inner ℝ u e = 0 ∧ ∀ v ∈ Q, v = inner ℝ v u • u + inner ℝ v e • e := by
  intro P Q u hQ huQ hu
  have hu0 : u ≠ 0 := by
    rintro rfl
    simp at hu
  have huu : inner ℝ u u = (1 : ℝ) := by
    rw [real_inner_self_eq_norm_sq, hu]; norm_num
  -- some `w ∈ Q` lies outside `span {u}`
  obtain ⟨w, hwQ, hw⟩ : ∃ w ∈ Q, w ∉ Submodule.span ℝ {u} := by
    rw [← IsConcreteLE.not_le_iff_exists]
    intro h
    have h1 := Submodule.finrank_mono h
    rw [hQ, finrank_span_singleton hu0] at h1
    omega
  -- Gram–Schmidt step
  set e' := w - inner ℝ w u • u with he'
  have he'Q : e' ∈ Q := Q.sub_mem hwQ (Q.smul_mem _ huQ)
  have he'0 : e' ≠ 0 := by
    intro h
    apply hw
    have : w = inner ℝ w u • u := sub_eq_zero.mp h
    rw [this]
    exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self u)
  have hue' : inner ℝ u e' = (0 : ℝ) := by
    rw [he', inner_sub_right, real_inner_smul_right, huu, real_inner_comm]; ring
  have hne : ‖e'‖ ≠ 0 := norm_ne_zero_iff.mpr he'0
  set e := ‖e'‖⁻¹ • e' with he
  have heQ : e ∈ Q := Q.smul_mem _ he'Q
  have hen : ‖e‖ = 1 := by
    rw [he, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hne]
  have hue : inner ℝ u e = (0 : ℝ) := by
    rw [he, real_inner_smul_right, hue', mul_zero]
  have hee : inner ℝ e e = (1 : ℝ) := by
    rw [real_inner_self_eq_norm_sq, hen]; norm_num
  have heu : inner ℝ e u = (0 : ℝ) := by rw [real_inner_comm, hue]
  -- `span {u, e} = Q`
  have hon : Orthonormal ℝ ![u, e] := by
    rw [orthonormal_iff_ite]
    intro i j
    fin_cases i <;> fin_cases j <;> simp [hu, hen, hue, heu]
  have hspan : Submodule.span ℝ {u, e} = Q := by
    apply Submodule.eq_of_le_of_finrank_eq
    · rw [Submodule.span_le]
      rintro x (rfl | rfl)
      · exact huQ
      · exact heQ
    · have := finrank_span_eq_card hon.linearIndependent
      rw [Matrix.range_cons, Matrix.range_cons, Matrix.range_empty, Set.union_empty,
        Set.singleton_union] at this
      rw [this, hQ, Fintype.card_fin]
  refine ⟨e, heQ, hen, hue, ?_⟩
  intro v hv
  rw [← hspan] at hv
  obtain ⟨a, b, rfl⟩ := Submodule.mem_span_pair.mp hv
  simp only [inner_add_left, real_inner_smul_left, huu, heu, hue, hee]
  simp
/-- Polar coordinates `F(x) = (‖x‖, arctan(⟨x, e⟩/⟨x, u⟩))` on the half-space
`H = {x | 0 < ⟨x, u⟩}`: both coordinates are `C¹` on `H`, since `0 ∉ H` and `⟨x, u⟩ ≠ 0` on `H`.
At `p = r₀u` the norm `√(‖x‖²)` has derivative `⟨u, ·⟩`, and the product rule for
`⟨x, e⟩ · ⟨x, u⟩⁻¹` with `⟨p, e⟩ = 0` and `arctan' 0 = 1` gives `⟨e, ·⟩/r₀`; the coordinate
projections and uniqueness of the derivative identify `DF(p)`. -/
theorem Submission.idtp_ccd_scsp_cc_polar_map : ∀ (P : ℕ) (u e : Euclid P) (r₀ : ℝ), ‖u‖ = 1 → inner ℝ u e = 0 → 0 < r₀ → ContDiffOn ℝ 1 (fun x : Euclid P => (!₂[‖x‖, Real.arctan (inner ℝ x e / inner ℝ x u)] : Euclid 2)) {x : Euclid P | 0 < inner ℝ x u} ∧ ∀ h : Euclid P, fderiv ℝ (fun x : Euclid P => (!₂[‖x‖, Real.arctan (inner ℝ x e / inner ℝ x u)] : Euclid 2)) (r₀ • u) h = !₂[inner ℝ u h, inner ℝ e h / r₀] := by
  intro P u e r₀ hu hue hr₀
  -- `H = {0 < ⟨x, u⟩}` is open and does not contain `0`
  have hHopen : IsOpen {x : Euclid P | 0 < inner ℝ x u} :=
    isOpen_lt continuous_const (continuous_id.inner continuous_const)
  have hc0 : ∀ x ∈ {x : Euclid P | 0 < inner ℝ x u},
      ContDiffAt ℝ 1 (fun x : Euclid P => ‖x‖) x := by
    intro x hx
    refine contDiffAt_norm ℝ ?_
    rintro rfl
    simp only [mem_ofPred_eq, inner_zero_left, lt_self_iff_false] at hx
  have hc1 : ∀ x ∈ {x : Euclid P | 0 < inner ℝ x u},
      ContDiffAt ℝ 1 (fun x : Euclid P => Real.arctan (inner ℝ x e / inner ℝ x u)) x := by
    intro x hx
    have ha : ContDiff ℝ 1 (fun x : Euclid P => inner ℝ x e) := contDiff_id.inner ℝ contDiff_const
    have hb : ContDiff ℝ 1 (fun x : Euclid P => inner ℝ x u) := contDiff_id.inner ℝ contDiff_const
    exact Real.contDiff_arctan.contDiffAt.comp x (ha.contDiffAt.div hb.contDiffAt (ne_of_gt hx))
  -- `F` is `C¹` on `H` coordinatewise
  have hCD : ContDiffOn ℝ 1 (fun x : Euclid P =>
      (!₂[‖x‖, Real.arctan (inner ℝ x e / inner ℝ x u)] : Euclid 2))
      {x : Euclid P | 0 < inner ℝ x u} := by
    rw [contDiffOn_piLp]
    intro i
    fin_cases i
    · simp only [Fin.zero_eta, Matrix.cons_val_zero]
      exact fun x hx => (hc0 x hx).contDiffWithinAt
    · simp only [Fin.mk_one, Matrix.cons_val_one, Matrix.cons_val_zero]
      exact fun x hx => (hc1 x hx).contDiffWithinAt
  refine ⟨hCD, fun h => ?_⟩
  -- values at `p = r₀ • u`
  have hpu : inner ℝ (r₀ • u) u = r₀ := by
    rw [real_inner_smul_left, real_inner_self_eq_norm_sq, hu]; ring
  have hpe : inner ℝ (r₀ • u) e = (0 : ℝ) := by
    rw [real_inner_smul_left, hue, mul_zero]
  have hpn : ‖r₀ • u‖ = r₀ := by
    rw [norm_smul, hu, Real.norm_eq_abs, abs_of_pos hr₀, mul_one]
  have hpH : r₀ • u ∈ {x : Euclid P | 0 < inner ℝ x u} := by
    show 0 < inner ℝ (r₀ • u) u
    rw [hpu]; exact hr₀
  have hdiff : DifferentiableAt ℝ (fun x : Euclid P =>
      (!₂[‖x‖, Real.arctan (inner ℝ x e / inner ℝ x u)] : Euclid 2)) (r₀ • u) :=
    (hCD.contDiffAt (hHopen.mem_nhds hpH)).differentiableAt one_ne_zero
  -- the norm `√(‖x‖²)` has derivative `⟨p, ·⟩ / ‖p‖ = ⟨u, ·⟩` at `p`
  have hd0 : HasFDerivAt (fun x : Euclid P => ‖x‖) (innerSL ℝ u) (r₀ • u) := by
    have h2 : HasFDerivAt (fun x : Euclid P => ‖x‖ ^ 2) (2 • innerSL ℝ (r₀ • u)) (r₀ • u) :=
      (hasStrictFDerivAt_norm_sq (r₀ • u)).hasFDerivAt
    have h3 := h2.sqrt (by rw [hpn]; positivity)
    simp only [Real.sqrt_sq (norm_nonneg _)] at h3
    convert h3 using 1
    ext v
    simp only [coe_innerSL_apply, hpn, one_div, mul_inv_rev, map_smul, smul_apply, smul_eq_mul,
      nsmul_eq_mul, Nat.cast_ofNat]
    field_simp
  -- `⟨x, e⟩ · ⟨x, u⟩⁻¹` has derivative `⟨e, ·⟩ / r₀` at `p`, as `⟨p, e⟩ = 0`
  have ha : HasFDerivAt (fun x : Euclid P => inner ℝ x e) (innerSL ℝ e) (r₀ • u) := by
    convert (innerSL ℝ e).hasFDerivAt using 1
    ext x; simp [real_inner_comm]
  have hb : HasFDerivAt (fun x : Euclid P => inner ℝ x u) (innerSL ℝ u) (r₀ • u) := by
    convert (innerSL ℝ u).hasFDerivAt using 1
    ext x; simp [real_inner_comm]
  have hbinv : HasFDerivAt (fun x : Euclid P => (inner ℝ x u)⁻¹)
      ((-(r₀ ^ 2)⁻¹) • innerSL ℝ u) (r₀ • u) := by
    have h1 := hasDerivAt_inv (show r₀ ≠ 0 from ne_of_gt hr₀)
    rw [← hpu] at h1
    have h2 := h1.comp_hasFDerivAt (r₀ • u) hb
    rw [hpu] at h2
    exact h2
  have hq : HasFDerivAt (fun x : Euclid P => inner ℝ x e / inner ℝ x u)
      (r₀⁻¹ • innerSL ℝ e) (r₀ • u) := by
    have h1 := ha.fun_mul hbinv
    simp only [hpe, hpu, zero_smul, zero_add] at h1
    simpa only [div_eq_mul_inv] using h1
  -- `arctan' 0 = 1`
  have hd1 : HasFDerivAt (fun x : Euclid P => Real.arctan (inner ℝ x e / inner ℝ x u))
      (r₀⁻¹ • innerSL ℝ e) (r₀ • u) := by
    convert hq.arctan using 1
    simp [hpe, hpu]
  -- identify `fderiv` through the two coordinate projections
  have hproj : ∀ i : Fin 2, HasFDerivAt (fun x : Euclid P =>
      (EuclideanSpace.proj i : StrongDual ℝ (Euclid 2))
        (!₂[‖x‖, Real.arctan (inner ℝ x e / inner ℝ x u)] : Euclid 2))
      ((EuclideanSpace.proj i : StrongDual ℝ (Euclid 2)).comp (fderiv ℝ (fun x : Euclid P =>
        (!₂[‖x‖, Real.arctan (inner ℝ x e / inner ℝ x u)] : Euclid 2)) (r₀ • u))) (r₀ • u) :=
    fun i => (EuclideanSpace.proj i : StrongDual ℝ (Euclid 2)).hasFDerivAt.comp (r₀ • u)
      hdiff.hasFDerivAt
  have e0 := (hproj 0).unique (by simpa only [Fin.isValue, PiLp.proj_apply,
    Matrix.cons_val_zero] using hd0)
  have e1 := (hproj 1).unique (by simpa only [Fin.isValue, PiLp.proj_apply,
    Matrix.cons_val_one, Matrix.cons_val_fin_one] using hd1)
  have v0 := congrArg (fun f => f h) e0
  have v1 := congrArg (fun f => f h) e1
  simp only [Fin.isValue, ContinuousLinearMap.comp_apply, PiLp.proj_apply, coe_innerSL_apply,
    smul_apply, smul_eq_mul] at v0 v1
  ext i
  fin_cases i
  · simpa [real_inner_comm] using v0
  · simp only [Fin.mk_one, Matrix.cons_val_one, Matrix.cons_val_zero]
    rw [v1, div_eq_inv_mul]
/-- **Shrinking a local inverse chart to a coordinate square.**  Choose `ε > 0` with
`B_ε(F p) ⊆ O` and put `s = min(ε, r₀)/4`, so `0 < s < r₀`.  The open square
`R_s = (r₀ - s, r₀ + s) × (-s, s)` lies in `B_ε((r₀, 0)) ⊆ O`, since every `w ∈ R_s` has
`|w - (r₀, 0)|² < 2s² < ε²`.  `N = N₀ ∩ (U ∩ F⁻¹(R_s))` is open because `F` is continuous on the
open set `U`, and it contains `p`; as `G(O) = M ∩ N₀` and `F ∘ G = id` on `O`, `M ∩ N = G(R_s)`. -/
theorem Submission.idtp_ccd_scsp_cc_square_shrink : ∀ (P : ℕ) (M U N₀ : Set (Euclid P)) (O : Set (Euclid 2)) (F : Euclid P → Euclid 2) (G : Euclid 2 → Euclid P) (p : Euclid P) (r₀ : ℝ), 0 < r₀ → IsOpen U → ContinuousOn F U → IsOpen O → IsOpen N₀ → F p = !₂[r₀, 0] → F p ∈ O → p ∈ N₀ → N₀ ⊆ U → G '' O = M ∩ N₀ → (∀ w ∈ O, F (G w) = w) → ∃ (s : ℝ) (N : Set (Euclid P)), 0 < s ∧ s < r₀ ∧ IsOpen N ∧ p ∈ N ∧ N ⊆ U ∧ {w : Euclid 2 | w 0 ∈ Ioo (r₀ - s) (r₀ + s) ∧ w 1 ∈ Ioo (-s) s} ⊆ O ∧ M ∩ N = G '' {w : Euclid 2 | w 0 ∈ Ioo (r₀ - s) (r₀ + s) ∧ w 1 ∈ Ioo (-s) s} := by
  intro P M U N₀ O F G p r₀ hr₀ hU hF hO hN₀ hFp hFpO hpN₀ hN₀U hGO hFG
  -- Step 1: a ball `B_ε(F p) ⊆ O`
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hO (F p) hFpO
  -- Step 2: `s = min(ε, r₀)/4`, so `0 < s < r₀` and `s ≤ ε/4`
  set s := min ε r₀ / 4 with hs_def
  have hs : 0 < s := div_pos (lt_min hε hr₀) four_pos
  have hsr : s < r₀ := by linarith [min_le_right ε r₀]
  have hsε : s ≤ ε / 4 := by linarith [min_le_left ε r₀]
  set R : Set (Euclid 2) := {w : Euclid 2 | w 0 ∈ Ioo (r₀ - s) (r₀ + s) ∧ w 1 ∈ Ioo (-s) s}
    with hR_def
  -- Step 3: `R_s ⊆ B_ε(F p) ⊆ O`, since `(w₀ - r₀)² + w₁² < 2s² ≤ ε²/8 < ε²` on `R_s`
  have hRO : R ⊆ O := by
    rintro w ⟨⟨h0l, h0r⟩, h1l, h1r⟩
    apply hball
    rw [Metric.mem_ball, EuclideanSpace.dist_eq, hFp, Real.sqrt_lt' hε]
    simp only [Real.dist_eq, sq_abs, Fin.sum_univ_two, Fin.isValue, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_fin_one, sub_zero]
    have h0 : (w 0 - r₀) ^ 2 < s ^ 2 := sq_lt_sq' (by linarith) (by linarith)
    have h1 : w 1 ^ 2 < s ^ 2 := sq_lt_sq' (by linarith) (by linarith)
    have h2 : s ^ 2 ≤ (ε / 4) ^ 2 := pow_le_pow_left₀ hs.le hsε 2
    nlinarith [pow_pos hε 2]
  -- Step 4: `R_s` is open (preimages of open intervals under the coordinate maps)
  have hRopen : IsOpen R :=
    (isOpen_Ioo.preimage (PiLp.continuous_apply 2 _ 0)).inter
      (isOpen_Ioo.preimage (PiLp.continuous_apply 2 _ 1))
  -- Step 5: `N = N₀ ∩ (U ∩ F⁻¹(R_s))` is open and lies in `U`
  refine ⟨s, N₀ ∩ (U ∩ F ⁻¹' R), hs, hsr, hN₀.inter (hF.isOpen_inter_preimage hU hRopen), ?_,
    fun x hx => hx.2.1, hRO, ?_⟩
  -- Step 6: `p ∈ N`, as `F p = (r₀, 0) ∈ R_s`
  · refine ⟨hpN₀, hN₀U hpN₀, ?_⟩
    show F p ∈ R
    rw [hFp, hR_def]
    simp only [Fin.isValue, mem_Ioo, mem_ofPred_eq, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_fin_one]
    exact ⟨⟨by linarith, by linarith⟩, by linarith, hs⟩
  · ext x
    constructor
    -- Step 7: `M ∩ N ⊆ G(R_s)`: `x = G w` with `w ∈ O`, and `w = F x ∈ R_s`
    · rintro ⟨hxM, hxN₀, -, hxR⟩
      obtain ⟨w, hwO, rfl⟩ : x ∈ G '' O := hGO ▸ ⟨hxM, hxN₀⟩
      refine ⟨w, ?_, rfl⟩
      rw [← hFG w hwO]
      exact hxR
    -- Step 8: `G(R_s) ⊆ M ∩ N`: `w ∈ O`, so `G w ∈ M ∩ N₀ ⊆ U` and `F (G w) = w ∈ R_s`
    · rintro ⟨w, hwR, rfl⟩
      have hwO := hRO hwR
      have hmem : G w ∈ M ∩ N₀ := hGO ▸ mem_image_of_mem G hwO
      refine ⟨hmem.1, hmem.2, hN₀U hmem.2, ?_⟩
      show F (G w) ∈ R
      rw [hFG w hwO]
      exact hwR
/-- **Radial extension of the cone chart** (step 8 of the parent proof).  Fix `α ∈ (-s, s)` and
let `A = {t ∈ (r₀ - s, r₀ + s) : G (t, α) = t γ(α)}`, which contains `r₀`.  `A` is open: for `t ∈ A`
and `t′` near `t`, the point `t′ γ(α)` stays in the open set `N`, lies in `M` by radial invariance
(`t′ γ(α) = (t′ / t) • t γ(α)`), so it is `G w` for some `w` in the square, and `F ∘ G = id`
together with `F (t′ γ(α)) = (t′, α)` forces `w = (t′, α)`.  `A` is relatively closed since
`t ↦ G (t, α)` and `t ↦ t γ(α)` are continuous on the open interval and limits are unique.  The
interval is preconnected, so `G (t, α) = t γ(α)` on the whole square, which gives both
conclusions. -/
theorem Submission.idtp_ccd_scsp_cc_radial_extension : ∀ (P : ℕ) (M N : Set (Euclid P)) (p : Euclid P) (ρ r₀ s : ℝ) (F : Euclid P → Euclid 2) (G : Euclid 2 → Euclid P) (γ : ℝ → Euclid P), 0 < s → s < r₀ → IsOpen N → N ⊆ ball p ρ → (∀ x ∈ M ∩ ball p ρ, ∀ t : ℝ, 0 < t → t • x ∈ ball p ρ → t • x ∈ M) → ContinuousOn G {w : Euclid 2 | w 0 ∈ Ioo (r₀ - s) (r₀ + s) ∧ w 1 ∈ Ioo (-s) s} → M ∩ N = G '' {w : Euclid 2 | w 0 ∈ Ioo (r₀ - s) (r₀ + s) ∧ w 1 ∈ Ioo (-s) s} → (∀ w : Euclid 2, w 0 ∈ Ioo (r₀ - s) (r₀ + s) → w 1 ∈ Ioo (-s) s → F (G w) = w) → (∀ α ∈ Ioo (-s) s, ‖γ α‖ = 1 ∧ G !₂[r₀, α] = r₀ • γ α ∧ ∀ t : ℝ, 0 < t → F (t • γ α) = !₂[t, α]) → (∀ w : Euclid 2, w 0 ∈ Ioo (r₀ - s) (r₀ + s) → w 1 ∈ Ioo (-s) s → G w = w 0 • γ (w 1)) ∧ M ∩ N = (fun q : ℝ × ℝ => q.1 • γ q.2) '' (Ioo (r₀ - s) (r₀ + s) ×ˢ Ioo (-s) s) := by
  intro P M N p ρ r₀ s F G γ hs hsr hN hNb hrad hGc hMN hFG hγ
  -- the radial identity on each horizontal segment `J × {α}` of the coordinate square
  have key : ∀ α ∈ Ioo (-s) s, ∀ t ∈ Ioo (r₀ - s) (r₀ + s), G !₂[t, α] = t • γ α := by
    intro α hα
    obtain ⟨hγn, hG0, hF⟩ := hγ α hα
    -- `t ↦ G (t, α)` is continuous on `J`
    have hmaps : MapsTo (fun t : ℝ => (!₂[t, α] : Euclid 2)) (Ioo (r₀ - s) (r₀ + s))
        {w : Euclid 2 | w 0 ∈ Ioo (r₀ - s) (r₀ + s) ∧ w 1 ∈ Ioo (-s) s} := by
      intro t ht
      exact ⟨by simpa using ht, by simpa using hα⟩
    have hφ : ContinuousOn (fun t : ℝ => G !₂[t, α]) (Ioo (r₀ - s) (r₀ + s)) :=
      hGc.comp (by fun_prop) hmaps
    -- `A = {t ∈ J : G (t, α) = t γ(α)}`
    set A : Set ℝ := {t | t ∈ Ioo (r₀ - s) (r₀ + s) ∧ G !₂[t, α] = t • γ α}
    -- `A` is open: nearby `t′ γ(α)` stay in `N`, lie in `M` by radial invariance, and `F ∘ G = id`
    -- identifies their chart coordinates as `(t′, α)`
    have hAo : IsOpen A := by
      rw [Metric.isOpen_iff]
      rintro t ⟨htJ, hGt⟩
      have hx : t • γ α ∈ M ∩ N := by
        rw [hMN, ← hGt]
        exact mem_image_of_mem G (hmaps htJ)
      obtain ⟨η₀, hη₀, hball⟩ := Metric.isOpen_iff.1 hN _ hx.2
      refine ⟨min η₀ (t - (r₀ - s)), lt_min hη₀ (by linarith [htJ.1]), fun t' ht' => ?_⟩
      rw [Metric.mem_ball, Real.dist_eq] at ht'
      have h1 : |t' - t| < η₀ := lt_of_lt_of_le ht' (min_le_left _ _)
      have h2 : |t' - t| < t - (r₀ - s) := lt_of_lt_of_le ht' (min_le_right _ _)
      have h3 := neg_abs_le (t' - t)
      have ht0 : 0 < t := by linarith [htJ.1]
      have ht'0 : 0 < t' := by linarith
      have hyN : t' • γ α ∈ N := by
        apply hball
        rw [Metric.mem_ball, dist_eq_norm, ← sub_smul, norm_smul, hγn, mul_one, Real.norm_eq_abs]
        exact h1
      have hyM : t' • γ α ∈ M := by
        have h := hrad _ ⟨hx.1, hNb hx.2⟩ (t' / t) (div_pos ht'0 ht0)
        rw [smul_smul, div_mul_cancel₀ _ ht0.ne'] at h
        exact h (hNb hyN)
      have hy : t' • γ α ∈ G '' {w : Euclid 2 | w 0 ∈ Ioo (r₀ - s) (r₀ + s) ∧ w 1 ∈ Ioo (-s) s} := by
        rw [← hMN]
        exact ⟨hyM, hyN⟩
      obtain ⟨w, hwR, hGw⟩ := hy
      have hw : w = !₂[t', α] := by
        rw [← hFG w hwR.1 hwR.2, hGw, hF t' ht'0]
      subst hw
      refine ⟨?_, hGw⟩
      simpa using hwR.1
    -- `closure A ∩ J ⊆ A`: both sides are continuous on the open interval `J`
    have hAc : closure A ∩ Ioo (r₀ - s) (r₀ + s) ⊆ A := by
      rintro t ⟨htc, htJ⟩
      refine ⟨htJ, ?_⟩
      have : (𝓝[A] t).NeBot := mem_closure_iff_nhdsWithin_neBot.1 htc
      have t1 : Tendsto (fun u : ℝ => G !₂[u, α]) (𝓝[A] t) (𝓝 (G !₂[t, α])) :=
        ((hφ.continuousAt (isOpen_Ioo.mem_nhds htJ)).tendsto).mono_left nhdsWithin_le_nhds
      have t2 : Tendsto (fun u : ℝ => G !₂[u, α]) (𝓝[A] t) (𝓝 (t • γ α)) := by
        refine (((continuous_id.smul continuous_const).tendsto t).mono_left
          nhdsWithin_le_nhds).congr' ?_
        filter_upwards [self_mem_nhdsWithin] with u hu
        exact hu.2.symm
      exact tendsto_nhds_unique t1 t2
    -- `J` is preconnected and meets `A` at `r₀`
    have hr₀ : r₀ ∈ Ioo (r₀ - s) (r₀ + s) := ⟨by linarith, by linarith⟩
    have hJA := isPreconnected_Ioo.subset_of_closure_inter_subset hAo ⟨r₀, hr₀, hr₀, hG0⟩ hAc
    exact fun t ht => (hJA ht).2
  -- first conclusion: every `w ∈ R` is `(w₀, w₁)`
  have hfirst : ∀ w : Euclid 2, w 0 ∈ Ioo (r₀ - s) (r₀ + s) → w 1 ∈ Ioo (-s) s →
      G w = w 0 • γ (w 1) := by
    intro w hw0 hw1
    have hw : w = !₂[w 0, w 1] := by
      ext i
      fin_cases i <;> simp
    rw [← key (w 1) hw1 (w 0) hw0, ← hw]
  -- second conclusion: `M ∩ N = G(R)` is the image of `J × I` under `(t, α) ↦ t γ(α)`
  refine ⟨hfirst, ?_⟩
  rw [hMN]
  ext x
  constructor
  · rintro ⟨w, ⟨hw0, hw1⟩, rfl⟩
    exact ⟨(w 0, w 1), ⟨hw0, hw1⟩, (hfirst w hw0 hw1).symm⟩
  · rintro ⟨⟨t, α⟩, ⟨ht, hα⟩, rfl⟩
    refine ⟨!₂[t, α], ⟨?_, ?_⟩, key α hα t ht⟩
    · simpa using ht
    · simpa using hα
/-- **Range of the derivative of `(t, α) ↦ t γ(α)`.**  If `G(w) = w₀ γ(w₁)` on an open
neighbourhood `S` of `ω = (t, α)`, `γ` is differentiable at `α` and `t ≠ 0`, then
`DG(ω) h = h₀ γ(α) + (t h₁) γ'(α)`, so `range DG(ω) = span {γ(α), γ'(α)}`; the vector
`a γ(α) + b γ'(α)` is the value at `h = (a, b / t)`. -/
theorem Submission.idtp_ccd_scsp_cc_scaled_curve_range : ∀ (P : ℕ) (γ : ℝ → Euclid P) (G : Euclid 2 → Euclid P) (S : Set (Euclid 2)) (t α : ℝ), IsOpen S → !₂[t, α] ∈ S → (∀ w ∈ S, G w = w 0 • γ (w 1)) → DifferentiableAt ℝ γ α → t ≠ 0 → Set.range (fderiv ℝ G !₂[t, α]) = (Submodule.span ℝ {γ α, deriv γ α} : Set (Euclid P)) := by
  intro P γ G S t α hS hω hG hγ ht
  -- Step 1: `G = G̃` on the open neighbourhood `S` of `ω = (t, α)`, so `DG(ω) = DG̃(ω)`
  have hloc : G =ᶠ[𝓝 !₂[t, α]] fun w => w 0 • γ (w 1) :=
    Filter.eventually_of_mem (hS.mem_nhds hω) hG
  -- Steps 2–3: the coordinate maps are their own derivatives; chain rule for `w ↦ γ(w₁)`
  have h0 : HasFDerivAt (fun w : Euclid 2 => w 0) (EuclideanSpace.proj (𝕜 := ℝ) (0 : Fin 2))
      !₂[t, α] :=
    (EuclideanSpace.proj (𝕜 := ℝ) (0 : Fin 2)).hasFDerivAt
  have h1 : HasFDerivAt (fun w : Euclid 2 => w 1) (EuclideanSpace.proj (𝕜 := ℝ) (1 : Fin 2))
      !₂[t, α] :=
    (EuclideanSpace.proj (𝕜 := ℝ) (1 : Fin 2)).hasFDerivAt
  have hγ1 : HasFDerivAt (fun w : Euclid 2 => γ (w 1))
      ((ContinuousLinearMap.toSpanSingleton ℝ (deriv γ α)).comp
        (EuclideanSpace.proj (𝕜 := ℝ) (1 : Fin 2))) !₂[t, α] :=
    hγ.hasDerivAt.hasFDerivAt.comp _ h1
  -- Step 4: product rule, `DG(ω) h = h₀ γ(α) + (t h₁) γ'(α)`
  have hG' : HasFDerivAt (fun w : Euclid 2 => w 0 • γ (w 1)) _ !₂[t, α] := h0.smul hγ1
  have hval : ∀ h : Euclid 2, fderiv ℝ G !₂[t, α] h = h 0 • γ α + (t * h 1) • deriv γ α := by
    intro h
    rw [hloc.fderiv_eq, hG'.fderiv]
    simp only [Fin.isValue, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one,
      add_apply, smul_apply, ContinuousLinearMap.comp_apply, PiLp.proj_apply,
      ContinuousLinearMap.toSpanSingleton_apply, ContinuousLinearMap.smulRight_apply]
    rw [smul_smul, add_comm]
  -- Steps 5–7: both inclusions, via `Submodule.mem_span_pair`
  ext v
  simp only [Set.mem_range, SetLike.mem_coe, Submodule.mem_span_pair]
  constructor
  · rintro ⟨h, rfl⟩
    exact ⟨h 0, t * h 1, (hval h).symm⟩
  · rintro ⟨a, b, rfl⟩
    refine ⟨!₂[a, b / t], ?_⟩
    rw [hval]
    simp only [Fin.isValue, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one,
      mul_div_cancel₀ b ht]
/-- **Simon Ch. 2, §4 (tangent plane of a locally conical surface).**  Let `M ⊆ ℝᴾ` be an
embedded `C¹` surface, `p ∈ M`, and let `M ∩ B_ρ(p)` be closed under positive dilations `x ↦ tx`
that stay in `B_ρ(p)`.  Then `span T_pM` is `2`-dimensional and contains `p`.  For a chart
`ψ : V → W` with `ψ(v₀) = p`, `span T_pM = Dψ(v₀)(ℝ²)`: `⊇` by the curves `t ↦ ψ(v₀ + ctw)`;
`⊆` since, for a left inverse `π` of `Dψ(v₀)`, `π ∘ ψ` has a local inverse `g` near `v₀`
(inverse function theorem), and properness of `ψ` gives `γ = ψ ∘ g ∘ π ∘ γ` near `0` for every
`C¹` curve `γ` in `M` through `p`.  The radial curve `t ↦ (1 + ε₀t)p` lies in `M` and has
velocity `ε₀p` at `0`. -/
theorem Submission.idtp_ccd_scsp_tangent_plane_mem : ∀ (P : ℕ) (M : Set (Euclid P)) (p : Euclid P) (ρ : ℝ), IsEmbeddedSubmanifold 1 2 M → p ∈ M → 0 < ρ → (∀ x ∈ M ∩ ball p ρ, ∀ t : ℝ, 0 < t → t • x ∈ ball p ρ → t • x ∈ M) → Module.finrank ℝ (Submodule.span ℝ (tangentSpace M p)) = 2 ∧ p ∈ Submodule.span ℝ (tangentSpace M p) := by
  intro P M p ρ hM hp hρ hrad
  -- Step 1: a chart `ψ : V → W` of `M` at `p`, and `v₀ ∈ V` with `ψ(v₀) = p`
  obtain ⟨V, W, ψ, hV, hW, hpW, hψ, hinj, himg, hprop, hD⟩ := hM p hp
  obtain ⟨v₀, hv₀V, hv₀⟩ : p ∈ ψ '' V := by rw [himg]; exact ⟨hpW, hp⟩
  have hψ1 : ContDiffOn ℝ 1 ψ V := by exact_mod_cast hψ
  set L := fderiv ℝ ψ v₀
  have hψv₀ : HasStrictFDerivAt ψ L v₀ :=
    (hψ1.contDiffAt (hV.mem_nhds hv₀V)).hasStrictFDerivAt one_ne_zero
  -- Step 2: `span T_pM = Dψ(v₀)(ℝ²)`
  have hspan : Submodule.span ℝ (tangentSpace M p) =
      LinearMap.range (L : Euclid 2 →ₗ[ℝ] Euclid P) := by
    apply le_antisymm
    · -- `T_pM ⊆ Dψ(v₀)(ℝ²)`: let `γ` be a `C¹` curve in `M` with `γ(0) = p`, `γ'(0) = v`
      rw [Submodule.span_le]
      rintro v ⟨γ, -, hγM, hγ0, hγv⟩
      -- a continuous left inverse `π` of the injective `L`
      obtain ⟨π₀, hπ₀⟩ := (L : Euclid 2 →ₗ[ℝ] Euclid P).exists_leftInverse_of_injective
        (LinearMap.ker_eq_bot.mpr (hD v₀ hv₀V))
      set π : Euclid P →L[ℝ] Euclid 2 := LinearMap.toContinuousLinearMap π₀
      have hπL : π.comp L = ContinuousLinearMap.id ℝ (Euclid 2) := by
        refine ContinuousLinearMap.ext fun w => ?_
        simpa [π] using LinearMap.congr_fun hπ₀ w
      -- `π ∘ ψ` has derivative `id` at `v₀`, so it has a local inverse `g` near `v₀`
      have hf : HasStrictFDerivAt (fun x => π (ψ x))
          ((ContinuousLinearEquiv.refl ℝ (Euclid 2) : Euclid 2 →L[ℝ] Euclid 2)) v₀ := by
        rw [ContinuousLinearEquiv.coe_refl, ← hπL]
        exact π.hasStrictFDerivAt.comp v₀ hψv₀
      obtain ⟨g, hleft, hgd⟩ : ∃ g : Euclid 2 → Euclid 2, (∀ᶠ x in 𝓝 v₀, g (π (ψ x)) = x) ∧
          HasFDerivAt g (ContinuousLinearMap.id ℝ (Euclid 2)) (π (ψ v₀)) :=
        ⟨_, hf.eventually_left_inverse, by simpa using hf.to_localInverse.hasFDerivAt⟩
      have hg0 : g (π (ψ v₀)) = v₀ := hleft.self_of_nhds
      obtain ⟨U₀, hU₀, hU₀o, hv₀U₀⟩ := _root_.eventually_nhds_iff.mp hleft
      -- properness: for `B̄_δ(p) ⊆ W`, `C = (V ∩ ψ⁻¹(B̄_δ(p))) \ U₀` is compact, so `ψ(C)` is
      -- closed, and `p ∉ ψ(C)` as `ψ` is injective on `V`
      obtain ⟨δ, hδ, hδW⟩ := nhds_basis_closedBall.mem_iff.mp (hW.mem_nhds hpW)
      set C := (V ∩ ψ ⁻¹' closedBall p δ) \ U₀
      have hCc : IsCompact C := (hprop _ hδW (isCompact_closedBall p δ)).diff hU₀o
      have hCcl : IsClosed (ψ '' C) :=
        (hCc.image_of_continuousOn (hψ1.continuousOn.mono fun x hx => hx.1.1)).isClosed
      have hpC : p ∉ ψ '' C := by
        rintro ⟨x, ⟨⟨hxV, -⟩, hxU⟩, hx⟩
        exact hxU (by rw [hinj hxV hv₀V (hx.trans hv₀.symm)]; exact hv₀U₀)
      -- near `t = 0`, `γ(t) = ψ(x)` with `x ∈ U₀`, so `γ = ψ ∘ g ∘ π ∘ γ`
      have hev : γ =ᶠ[𝓝 0] fun t => ψ (g (π (γ t))) := by
        have h1 : ∀ᶠ t in 𝓝 (0:ℝ), γ t ∈ (ψ '' C)ᶜ ∩ ball p δ := by
          have h := hγv.continuousAt.tendsto
          rw [hγ0] at h
          exact h (inter_mem (hCcl.isOpen_compl.mem_nhds hpC) (ball_mem_nhds p hδ))
        filter_upwards [h1, Ioo_mem_nhds (show (-1:ℝ) < 0 by norm_num)
          (show (0:ℝ) < 1 by norm_num)] with t ht ht'
        obtain ⟨x, hxV, hxt⟩ : γ t ∈ ψ '' V := by
          rw [himg]; exact ⟨hδW (ball_subset_closedBall ht.2), hγM ht'⟩
        have hxU : x ∈ U₀ := by
          by_contra hxU
          exact ht.1 ⟨x, ⟨⟨hxV, by rw [mem_preimage, hxt]; exact ball_subset_closedBall ht.2⟩,
            hxU⟩, hxt⟩
        rw [← hxt, hU₀ x hxU]
      -- chain rule: `v = γ'(0) = L(π v)`
      have h1 : HasDerivAt (fun t => π (γ t)) (π v) 0 := π.hasFDerivAt.comp_hasDerivAt 0 hγv
      have h2 : HasDerivAt (fun t => g (π (γ t))) (π v) 0 :=
        hgd.comp_hasDerivAt_of_eq 0 h1 (by show π (ψ v₀) = π (γ 0); rw [hγ0, hv₀])
      have h3 : HasDerivAt (fun t => ψ (g (π (γ t)))) (L (π v)) 0 :=
        hψv₀.hasFDerivAt.comp_hasDerivAt_of_eq 0 h2
          (by show v₀ = g (π (γ 0)); rw [hγ0, ← hv₀, hg0])
      exact ⟨π v, (hγv.unique (h3.congr_of_eventuallyEq hev)).symm⟩
    · -- `Dψ(v₀)(ℝ²) ⊆ span T_pM`: `t ↦ ψ(v₀ + ctw)` (with `B_{r₀}(v₀) ⊆ V`) has velocity `cLw`
      rintro _ ⟨w, rfl⟩
      obtain ⟨r₀, hr₀, hball⟩ := Metric.isOpen_iff.mp hV v₀ hv₀V
      set c : ℝ := r₀ / (‖w‖ + 1) with hc
      have hc0 : 0 < c := div_pos hr₀ (by positivity)
      have hmaps : ∀ t ∈ Ioo (-1:ℝ) 1, v₀ + (c * t) • w ∈ V := by
        intro t ht
        apply hball
        rw [mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_eq_abs, abs_mul,
          abs_of_pos hc0]
        have ht1 : |t| < 1 := abs_lt.mpr ⟨ht.1, ht.2⟩
        calc c * |t| * ‖w‖ ≤ c * 1 * ‖w‖ := by gcongr
          _ < r₀ := by
            rw [mul_one, hc, div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
            nlinarith [norm_nonneg w]
      have hmem : c • L w ∈ tangentSpace M p := by
        refine ⟨fun t => ψ (v₀ + (c * t) • w), ?_, ?_, ?_, ?_⟩
        · exact hψ1.comp (by fun_prop : ContDiff ℝ 1 (fun t : ℝ => v₀ + (c * t) • w)).contDiffOn
            hmaps
        · intro t ht
          exact (himg ▸ mem_image_of_mem ψ (hmaps t ht) : ψ _ ∈ W ∩ M).2
        · simp [hv₀]
        · have hβ : HasDerivAt (fun t : ℝ => v₀ + (c * t) • w) (c • w) 0 := by
            simpa using (((hasDerivAt_id (0:ℝ)).const_mul c).smul_const w).const_add v₀
          have h := hψv₀.hasFDerivAt.comp_hasDerivAt_of_eq 0 hβ (by simp)
          rw [map_smul] at h
          exact h
      have := Submodule.smul_mem _ c⁻¹ (Submodule.subset_span hmem)
      rwa [smul_smul, inv_mul_cancel₀ hc0.ne', one_smul] at this
  refine ⟨?_, ?_⟩
  · -- Step 3: `dim span T_pM = dim Dψ(v₀)(ℝ²) = 2`, as `Dψ(v₀)` is injective
    rw [hspan, LinearMap.finrank_range_of_inj (f := (L : Euclid 2 →ₗ[ℝ] Euclid P)) (hD v₀ hv₀V),
      finrank_euclideanSpace_fin]
  · -- Step 4: the radial curve `t ↦ (1 + ε₀t)p`, `ε₀ = min(1/2, ρ/(|p| + 1))`, stays in
    -- `M ∩ B_ρ(p)` by radial invariance at `x = p`, so `ε₀p ∈ T_pM` and `p ∈ span T_pM`
    set ε₀ : ℝ := min (1/2) (ρ / (‖p‖ + 1))
    have hε₀0 : 0 < ε₀ := lt_min (by norm_num) (div_pos hρ (by positivity))
    have hmem : ε₀ • p ∈ tangentSpace M p := by
      refine ⟨fun t => (1 + ε₀ * t) • p, ?_, ?_, ?_, ?_⟩
      · exact (by fun_prop : ContDiff ℝ 1 (fun t : ℝ => (1 + ε₀ * t) • p)).contDiffOn
      · intro t ht
        have ht1 : |t| < 1 := abs_lt.mpr ⟨ht.1, ht.2⟩
        have hpos : 0 < 1 + ε₀ * t := by
          have : -ε₀ < ε₀ * t := by nlinarith [ht.1]
          linarith [min_le_left (1/2 : ℝ) (ρ / (‖p‖ + 1))]
        refine hrad p ⟨hp, mem_ball_self hρ⟩ _ hpos ?_
        rw [mem_ball, dist_eq_norm, add_smul, one_smul, add_sub_cancel_left, norm_smul,
          Real.norm_eq_abs, abs_mul, abs_of_pos hε₀0]
        calc ε₀ * |t| * ‖p‖ ≤ ε₀ * 1 * ‖p‖ := by gcongr
          _ ≤ ρ / (‖p‖ + 1) * ‖p‖ := by rw [mul_one]; gcongr; exact min_le_right _ _
          _ < ρ := by
            rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
            nlinarith [norm_nonneg p]
      · simp
      · simpa using ((hasDerivAt_id (0:ℝ)).const_mul ε₀ |>.const_add 1).smul_const p
    have := Submodule.smul_mem _ ε₀⁻¹ (Submodule.subset_span hmem)
    rwa [smul_smul, inv_mul_cancel₀ hε₀0.ne', one_smul] at this
/-- **`C¹` local inverse with surjective inverse derivative** (inverse function theorem on `ℝᵈ`;
local inverse step of the stationary-cone sheet argument).  If `Φ : ℝᵈ → ℝᵈ` is `C¹` on an open
`V ∋ v₀` and `DΦ(v₀)` is injective, there are open sets `V₁` and `O` with `v₀ ∈ V₁ ⊆ V` and
`Φ(v₀) ∈ O`, and a map `H`, `C¹` on `O`, with `H(O) = V₁`, `Φ(H w) = w` and `DH(w)` surjective
for every `w ∈ O`.  `DΦ` is continuous on `V`, so `V₁′ = {v ∈ V : DΦ(v) invertible}` is open and
contains `v₀`; the strict-derivative inverse function theorem gives an open partial homeomorphism
`Φ̃ = Φ` with `v₀ ∈ Φ̃.source`; restrict it to `V₁′` and take `V₁ = source`, `O = target` and
`H = Φ̃.symm`, which is `C¹` with derivative `DΦ(H w)⁻¹` at every `w ∈ O`. -/
theorem Submission.idtp_ccd_scsp_li_c1_inverse : ∀ (d : ℕ) (Φ : Euclid d → Euclid d) (V : Set (Euclid d)) (v₀ : Euclid d), IsOpen V → v₀ ∈ V → ContDiffOn ℝ 1 Φ V → Injective (fderiv ℝ Φ v₀) → ∃ (V₁ O : Set (Euclid d)) (H : Euclid d → Euclid d), IsOpen V₁ ∧ IsOpen O ∧ v₀ ∈ V₁ ∧ V₁ ⊆ V ∧ Φ v₀ ∈ O ∧ ContDiffOn ℝ 1 H O ∧ H '' O = V₁ ∧ (∀ w ∈ O, Φ (H w) = w) ∧ ∀ w ∈ O, Surjective (fderiv ℝ H w) := by
  intro d Φ V v₀ hV hv₀ hΦ hinj
  -- step 1: `Φ` is `C¹` and differentiable at every point of `V`
  have hC1 : ∀ v ∈ V, ContDiffAt ℝ 1 Φ v := fun v hv => hΦ.contDiffAt (hV.mem_nhds hv)
  have hdiff : ∀ v ∈ V, HasFDerivAt Φ (fderiv ℝ Φ v) v := fun v hv =>
    ((hC1 v hv).differentiableAt one_ne_zero).hasFDerivAt
  -- step 2: `DΦ(v₀)` is the coercion of a continuous linear equivalence `E₀`
  set E₀ : Euclid d ≃L[ℝ] Euclid d := (LinearEquiv.ofInjectiveEndo
    (fderiv ℝ Φ v₀ : Euclid d →ₗ[ℝ] Euclid d) hinj).toContinuousLinearEquiv
  have hE₀ : (E₀ : Euclid d →L[ℝ] Euclid d) = fderiv ℝ Φ v₀ := by ext x; rfl
  -- step 3: `V₁′ = V ∩ DΦ⁻¹(invertible maps)` is open and contains `v₀`
  set V₁' := V ∩ fderiv ℝ Φ ⁻¹' range ((↑) : (Euclid d ≃L[ℝ] Euclid d) → Euclid d →L[ℝ] Euclid d)
  have hV₁' : IsOpen V₁' := (hΦ.continuousOn_fderiv_of_isOpen hV le_rfl).isOpen_inter_preimage hV
    ContinuousLinearEquiv.isOpen
  have hv₀' : v₀ ∈ V₁' := ⟨hv₀, E₀, hE₀⟩
  -- step 4: the inverse function theorem at `v₀`, restricted to `V₁′`
  have hstrict : HasStrictFDerivAt Φ (E₀ : Euclid d →L[ℝ] Euclid d) v₀ := by
    rw [hE₀]; exact (hC1 v₀ hv₀).hasStrictFDerivAt one_ne_zero
  set Φ₁ := (hstrict.toOpenPartialHomeomorph Φ).restrOpen V₁' hV₁'
  have hsrc : Φ₁.source = (hstrict.toOpenPartialHomeomorph Φ).source ∩ V₁' :=
    OpenPartialHomeomorph.restrOpen_source _ _ _
  have hv₀₁ : v₀ ∈ Φ₁.source := by
    rw [hsrc]; exact ⟨hstrict.mem_toOpenPartialHomeomorph_source, hv₀'⟩
  have hsub : Φ₁.source ⊆ V₁' := by rw [hsrc]; exact inter_subset_right
  refine ⟨Φ₁.source, Φ₁.target, Φ₁.symm, Φ₁.open_source, Φ₁.open_target, hv₀₁,
    fun v hv => (hsub hv).1, Φ₁.map_source hv₀₁, ?_, Φ₁.symm_image_target_eq_source,
    fun w hw => Φ₁.right_inv hw, ?_⟩
  -- step 5: at `w ∈ O`, `v = H w ∈ V₁′`, so `DΦ(v) = E_v` is invertible and `Φ` is `C¹` at `v`
  · intro w hw
    have hv : Φ₁.symm w ∈ V₁' := hsub (Φ₁.map_target hw)
    obtain ⟨E, hE⟩ := hv.2
    apply ContDiffAt.contDiffWithinAt
    apply Φ₁.contDiffAt_symm hw
    · rw [hE]; exact hdiff _ hv.1
    · exact hC1 _ hv.1
  · intro w hw
    have hv : Φ₁.symm w ∈ V₁' := hsub (Φ₁.map_target hw)
    obtain ⟨E, hE⟩ := hv.2
    have hH : HasFDerivAt Φ₁.symm (E.symm : Euclid d →L[ℝ] Euclid d) w :=
      Φ₁.hasFDerivAt_symm hw (by rw [hE]; exact hdiff _ hv.1)
    rw [hH.fderiv]
    exact E.symm.surjective
/-- **Simon Ch. 2, §4, (4.3)**: if `ψ` is `Cʳ` (`r ≥ 1`) on an open `V ⊆ ℝᵈ` and `ψ(V) ⊆ N`,
then every `Dψ(v) a`, `v ∈ V`, is the velocity at `0` of a `C¹` curve in `N` through `ψ(v)`, i.e.
`Dψ(v)(ℝᵈ) ⊆ T_{ψ(v)}N`.  For `a = 0` take the constant curve.  Otherwise, with
`B_{ρ₀}(v) ⊆ V`, `c = ρ₀ / |a|` and `h(t) = t / (1 + t² / c²)` (smooth, `h(0) = 0`, `h'(0) = 1`,
`|h| ≤ c / 2`), the curve `γ(t) = ψ(v + h(t) a)` stays in `ψ(V)` and has velocity `Dψ(v) a`. -/
theorem Submission.dsmc_chart_range_subset_tangentSpace : ∀ (P r d : ℕ) (N : Set (Euclid P)) (V : Set (Euclid d)) (ψ : Euclid d → Euclid P), 1 ≤ r → IsOpen V → ContDiffOn ℝ r ψ V → ψ '' V ⊆ N → ∀ v ∈ V, Set.range (fderiv ℝ ψ v) ⊆ tangentSpace N (ψ v) := by
  rintro P r d N V ψ hr hV hψ hN v hv _ ⟨a, rfl⟩
  -- `ψ` is `C¹` on `V`, hence differentiable at the interior point `v`
  have hψ1 : ContDiffOn ℝ 1 ψ V := hψ.of_le (by exact_mod_cast hr)
  have hψv : HasFDerivAt ψ (fderiv ℝ ψ v) v :=
    ((hψ1.differentiableOn one_ne_zero).differentiableAt (hV.mem_nhds hv)).hasFDerivAt
  by_cases ha : a = 0
  · -- `a = 0`: the constant curve `ψ(v)` has velocity `0 = Dψ(v) 0`
    subst ha
    refine ⟨fun _ => ψ v, contDiffOn_const, fun _ _ => hN (mem_image_of_mem ψ hv), rfl, ?_⟩
    simpa using hasDerivAt_const (0 : ℝ) (ψ v)
  · -- `a ≠ 0`: `β(t) = v + h(t) a` with `h(t) = t / (1 + t² / c²)`, `c = ρ₀ / |a|`
    obtain ⟨ρ₀, hρ₀, hball⟩ := Metric.isOpen_iff.mp hV v hv
    have ha' : 0 < ‖a‖ := norm_pos_iff.mpr ha
    set c : ℝ := ρ₀ / ‖a‖ with hc_def
    have hc : 0 < c := div_pos hρ₀ ha'
    have hden : ∀ t : ℝ, 0 < 1 + t ^ 2 / c ^ 2 := fun t => by positivity
    set h : ℝ → ℝ := fun t => t / (1 + t ^ 2 / c ^ 2) with hh_def
    -- (a) `h` is smooth
    have h_cd : ContDiff ℝ 1 h :=
      contDiff_id.div (contDiff_const.add ((contDiff_id.pow 2).div_const _)) fun t => (hden t).ne'
    -- (b) `h'(0) = 1`
    have h_deriv : HasDerivAt h 1 0 := by
      have := hasDerivAt_id' (x := (0 : ℝ)) |>.fun_div
        (((hasDerivAt_id' (x := (0 : ℝ))).fun_pow 2).div_const (c ^ 2) |>.const_add 1) (hden 0).ne'
      convert this using 1
      simp
    -- (c) `|h(t)| ≤ c / 2`, since `2 c |t| ≤ c² + t²`
    have h_bd : ∀ t, |h t| ≤ c / 2 := by
      intro t
      rw [hh_def, abs_div, abs_of_pos (hden t), div_le_iff₀ (hden t)]
      have h1 : c / 2 * (1 + t ^ 2 / c ^ 2) = (c ^ 2 + |t| ^ 2) / (2 * c) := by
        rw [sq_abs]; field_simp
      rw [h1, le_div_iff₀ (by positivity)]
      nlinarith [sq_nonneg (c - |t|)]
    -- `β` stays in `B_{ρ₀}(v) ⊆ V`, `β(0) = v` and `β'(0) = a`
    set β : ℝ → Euclid d := fun t => v + h t • a with hβ_def
    have hβV : ∀ t, β t ∈ V := fun t => hball <| by
      rw [Metric.mem_ball, dist_eq_norm, hβ_def]
      simp only [add_sub_cancel_left, norm_smul, Real.norm_eq_abs]
      calc |h t| * ‖a‖ ≤ c / 2 * ‖a‖ := by gcongr; exact h_bd t
        _ = ρ₀ / 2 := by rw [hc_def]; field_simp
        _ < ρ₀ := by linarith
    have hβ0 : β 0 = v := by simp [hβ_def, hh_def]
    have hβ_cd : ContDiff ℝ 1 β := contDiff_const.add (h_cd.smul contDiff_const)
    have hβ_deriv : HasDerivAt β a 0 := by
      have := HasDerivAt.const_add v (h_deriv.smul_const a)
      rwa [one_smul] at this
    -- `γ = ψ ∘ β` is `C¹` on `(-1, 1)`, lies in `ψ(V) ⊆ N`, and `γ'(0) = Dψ(v) a`
    refine ⟨ψ ∘ β, hψ1.comp hβ_cd.contDiffOn fun t _ => hβV t,
      fun t _ => hN (mem_image_of_mem ψ (hβV t)), by simp [hβ0], ?_⟩
    exact hψv.comp_hasDerivAt_of_eq 0 hβ_deriv hβ0.symm
/-- Continuity of the inverse of a proper injective chart at a point (Simon Ch. 2, (4.1)–(4.2)):
if `ψ` is continuous and injective on `V`, `ψ(V) ⊆ W`, and `V ∩ ψ⁻¹(K)` is compact for every
compact `K ⊆ W`, then `ψ(v') → ψ(v)` with `v' ∈ V` forces `v' → v`.  Otherwise there are `vⱼ ∈ V`
with `ψ(vⱼ) → ψ(v)` and `|vⱼ - v| ≥ ε`; they lie in the compact set `V ∩ ψ⁻¹({ψ(v)} ∪ {ψ(vⱼ)})`,
and a limit `w ∈ V` of a subsequence has `ψ(w) = ψ(v)`, so `w = v`, a contradiction. -/
theorem Submission.dsmc_chart_inverse_continuity : ∀ (P d : ℕ) (V : Set (Euclid d)) (W : Set (Euclid P)) (ψ : Euclid d → Euclid P), ContinuousOn ψ V → InjOn ψ V → ψ '' V ⊆ W → (∀ K ⊆ W, IsCompact K → IsCompact (V ∩ ψ ⁻¹' K)) → ∀ v ∈ V, ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ v' ∈ V, dist (ψ v') (ψ v) < δ → dist v' v < ε := by
  intro P d V W ψ hψ hinj hVW hproper v hv ε hε
  by_contra! hfar
  -- `δ = 1/(j+1)` fails: `vⱼ ∈ V`, `|ψ(vⱼ) - ψ(v)| < 1/(j+1)` and `|vⱼ - v| ≥ ε`
  choose u huV hu_near hu_far using fun j : ℕ => hfar (1 / ((j : ℝ) + 1)) Nat.one_div_pos_of_nat
  have hlim : Tendsto (fun j => ψ (u j)) atTop (𝓝 (ψ v)) :=
    tendsto_iff_dist_tendsto_zero.2 <| squeeze_zero (fun j => dist_nonneg)
      (fun j => (hu_near j).le) tendsto_one_div_add_atTop_nhds_zero_nat
  -- `K = {ψ(v)} ∪ {ψ(vⱼ)}` is a compact subset of `W`, so `V ∩ ψ⁻¹(K)` is compact
  have hKW : insert (ψ v) (range fun j => ψ (u j)) ⊆ W := by
    rintro _ (rfl | ⟨j, rfl⟩)
    exacts [hVW (mem_image_of_mem ψ hv), hVW (mem_image_of_mem ψ (huV j))]
  obtain ⟨w, ⟨hwV, -⟩, φ, hφ, huw⟩ := (hproper _ hKW hlim.isCompact_insert_range).tendsto_subseq
    (x := u) fun j => ⟨huV j, Or.inr ⟨j, rfl⟩⟩
  -- `ψ(v_{φ(i)})` tends to `ψ(w)` (continuity on `V`) and to `ψ(v)`, so `w = v`
  have hw : w = v := hinj hwV hv <| tendsto_nhds_unique
    ((hψ w hwV).tendsto.comp (tendsto_nhdsWithin_iff.2 ⟨huw, .of_forall fun i => huV (φ i)⟩))
    (hlim.comp hφ.tendsto_atTop)
  rw [hw] at huw
  obtain ⟨N, hN⟩ := Metric.tendsto_atTop.1 huw ε hε
  exact absurd (hu_far (φ N)) (not_le.2 (hN N le_rfl))

/-- Near-isometric local parametrizations of an embedded `C¹` submanifold `M` (charts as in
Simon Ch. 2, (4.1)): for `z ∈ M` and `ε > 0` there are `χ` with `χ(0) = z` and `δ, δ' > 0` such
that `χ` is `(1 ± ε)`-bi-Lipschitz on `B_δ(0)`, `χ(B_δ(0)) ⊆ M` and `M ∩ B_{δ'}(z) ⊆ χ(B_δ(0))`.
Take a chart `ψ` with `ψ(v₀) = z`, choose `L ∈ GL(ℝⁿ)` with `Dψ(v₀) ∘ L` a linear isometry (an
orthonormal basis of `Dψ(v₀)(ℝⁿ)`) and put `χ(w) = ψ(v₀ + Lw)`; strict differentiability of `χ`
at `0` gives the two-point bounds, and continuity of the chart inverse
(`Submission.dsmc_chart_inverse_continuity`) gives the covering of `M ∩ B_{δ'}(z)`. -/
theorem Submission.dimred_rpd_near_isometric_chart : ∀ (P n : ℕ) (M : Set (Euclid P)) (z : Euclid P), IsEmbeddedSubmanifold 1 n M → z ∈ M → ∀ ε : ℝ, 0 < ε → ∃ (χ : Euclid n → Euclid P) (δ δ' : ℝ), 0 < δ ∧ 0 < δ' ∧ χ 0 = z ∧ (∀ a ∈ ball (0 : Euclid n) δ, ∀ b ∈ ball (0 : Euclid n) δ, (1 - ε) * ‖a - b‖ ≤ ‖χ a - χ b‖ ∧ ‖χ a - χ b‖ ≤ (1 + ε) * ‖a - b‖) ∧ χ '' ball 0 δ ⊆ M ∧ M ∩ ball z δ' ⊆ χ '' ball 0 δ := by
  intro P n M z hM hz ε hε
  obtain ⟨V, W, ψ, hV, hW, hzW, hψ, hinj, himg, hprop, hder⟩ := hM z hz
  obtain ⟨v₀, hv₀V, hψv₀⟩ : z ∈ ψ '' V := by rw [himg]; exact ⟨hzW, hz⟩
  set A : Euclid n →L[ℝ] Euclid P := fderiv ℝ ψ v₀
  have hA : Injective A := hder v₀ hv₀V
  have hstrict : HasStrictFDerivAt ψ A v₀ :=
    (hψ.contDiffAt (hV.mem_nhds hv₀V)).hasStrictFDerivAt one_ne_zero
  -- isometric normalization
  obtain ⟨L, hLJ⟩ : ∃ L : Euclid n ≃L[ℝ] Euclid n, ∀ w, ‖A (L w)‖ = ‖w‖ := by
    let Q := LinearMap.range (A : Euclid n →ₗ[ℝ] Euclid P)
    have hfin : Module.finrank ℝ Q = n := by
      rw [LinearMap.finrank_range_of_inj hA, finrank_euclideanSpace_fin]
    let b : OrthonormalBasis (Fin n) ℝ Q := (stdOrthonormalBasis ℝ Q).reindex (finCongr hfin)
    let A' : Euclid n ≃ₗ[ℝ] Q := LinearEquiv.ofInjective (A : Euclid n →ₗ[ℝ] Euclid P) hA
    let L₀ : Euclid n ≃ₗ[ℝ] Euclid n := b.repr.symm.toLinearEquiv.trans A'.symm
    refine ⟨L₀.toContinuousLinearEquiv, fun w => ?_⟩
    have h1 : A' (L₀ w) = b.repr.symm w := by simp [L₀]
    have h2 : A (L₀ w) = ((A' (L₀ w) : Q) : Euclid P) := rfl
    change ‖A (L₀ w)‖ = ‖w‖
    rw [h2, h1]
    exact b.repr.symm.norm_map w
  set χ : Euclid n → Euclid P := fun w => ψ (v₀ + L w)
  have hχ0 : χ 0 = z := by simp [χ, hψv₀]
  have hχstrict : HasStrictFDerivAt χ (A.comp (L : Euclid n →L[ℝ] Euclid n)) 0 := by
    have h1 : HasStrictFDerivAt (fun w : Euclid n => v₀ + L w) (L : Euclid n →L[ℝ] Euclid n) 0 :=
      (L.hasStrictFDerivAt).const_add v₀
    have h2 : HasStrictFDerivAt ψ A (v₀ + L 0) := by simpa using hstrict
    exact h2.comp (0 : Euclid n) h1
  -- two-point estimate
  have h1 := (hasStrictFDerivAt_iff_isLittleO.1 hχstrict).bound hε
  have h2 : ∀ᶠ w in 𝓝 (0 : Euclid n), v₀ + L w ∈ V := by
    have hc : Continuous (fun w : Euclid n => v₀ + L w) := continuous_const.add L.continuous
    have : (fun w : Euclid n => v₀ + L w) 0 ∈ V := by simpa using hv₀V
    exact hc.continuousAt.preimage_mem_nhds (hV.mem_nhds this)
  obtain ⟨δ₁, hδ₁, hball1⟩ := Metric.eventually_nhds_iff_ball.1 h1
  obtain ⟨δ₂, hδ₂, hball2⟩ := Metric.eventually_nhds_iff_ball.1 h2
  set δ := min δ₁ δ₂
  have hδ : 0 < δ := lt_min hδ₁ hδ₂
  have hδV : ∀ w ∈ ball (0 : Euclid n) δ, v₀ + L w ∈ V :=
    fun w hw => hball2 w (ball_subset_ball (min_le_right _ _) hw)
  have hbil : ∀ a ∈ ball (0 : Euclid n) δ, ∀ b ∈ ball (0 : Euclid n) δ,
      (1 - ε) * ‖a - b‖ ≤ ‖χ a - χ b‖ ∧ ‖χ a - χ b‖ ≤ (1 + ε) * ‖a - b‖ := by
    intro a ha b hb
    have hab : (a, b) ∈ ball ((0 : Euclid n), (0 : Euclid n)) δ₁ := by
      rw [← ball_prod_same]
      exact ⟨ball_subset_ball (min_le_left _ _) ha, ball_subset_ball (min_le_left _ _) hb⟩
    have he := hball1 (a, b) hab
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearEquiv.coe_coe] at he
    have hn : ‖A (L (a - b))‖ = ‖a - b‖ := hLJ _
    have t1 := norm_sub_norm_le (χ a - χ b) (A (L (a - b)))
    have t2 := norm_sub_norm_le (A (L (a - b))) (χ a - χ b)
    rw [norm_sub_rev (A (L (a - b))) (χ a - χ b)] at t2
    constructor <;> linarith
  -- local surjectivity
  have hinvc := Submission.dsmc_chart_inverse_continuity P n V W ψ hψ.continuousOn hinj
    (by rw [himg]; exact inter_subset_left) hprop v₀ hv₀V
  set C : ℝ := ‖((L.symm : Euclid n ≃L[ℝ] Euclid n) : Euclid n →L[ℝ] Euclid n)‖ with hCdef
  have hC : 0 ≤ C := norm_nonneg _
  obtain ⟨η, hη, hηprop⟩ := hinvc (δ / (C + 1)) (div_pos hδ (by linarith))
  obtain ⟨r₀, hr₀, hr₀W⟩ := Metric.isOpen_iff.1 hW z hzW
  refine ⟨χ, δ, min η r₀, hδ, lt_min hη hr₀, hχ0, hbil, ?_, ?_⟩
  · rintro _ ⟨w, hw, rfl⟩
    have : ψ (v₀ + L w) ∈ W ∩ M := by rw [← himg]; exact ⟨_, hδV w hw, rfl⟩
    exact this.2
  · rintro x ⟨hxM, hxb⟩
    have hxW : x ∈ W := hr₀W (ball_subset_ball (min_le_right _ _) hxb)
    obtain ⟨v', hv'V, rfl⟩ : x ∈ ψ '' V := by rw [himg]; exact ⟨hxW, hxM⟩
    have hd : dist (ψ v') (ψ v₀) < η := by
      rw [hψv₀]; exact lt_of_lt_of_le (mem_ball.1 hxb) (min_le_left _ _)
    have hv' := hηprop v' hv'V hd
    refine ⟨L.symm (v' - v₀), ?_, ?_⟩
    · rw [mem_ball, dist_zero_right]
      calc ‖L.symm (v' - v₀)‖ ≤ C * ‖v' - v₀‖ := by
            rw [hCdef]
            exact ContinuousLinearMap.le_opNorm
              ((L.symm : Euclid n ≃L[ℝ] Euclid n) : Euclid n →L[ℝ] Euclid n) (v' - v₀)
        _ ≤ C * (δ / (C + 1)) := by
            apply mul_le_mul_of_nonneg_left _ hC
            rw [← dist_eq_norm]; exact hv'.le
        _ < δ := by
            rw [mul_div_assoc', div_lt_iff₀ (by linarith)]
            nlinarith
    · simp [χ]
/-- **Bi-Lipschitz images** (Simon Ch. 2, 1.8(i), applied to `χ` and to its inverse): if
`c₁|a − b| ≤ |χ(a) − χ(b)| ≤ c₂|a − b|` on `E ⊆ ℝⁿ`, then `c₁ⁿ Lⁿ(E) ≤ Hⁿ(χ(E)) ≤ c₂ⁿ Lⁿ(E)`.
`Hⁿ = μHE[n]` is `c · μH[n]` with one constant `c` on every metric space and equals `volume` on
`ℝⁿ`; `χ` is `c₂`-Lipschitz on `E`, and it is injective there with `c₁⁻¹`-Lipschitz inverse on
`χ(E)`. -/
theorem Submission.dimred_rpd_bilipschitz_image_measure : ∀ (P n : ℕ) (χ : Euclid n → Euclid P) (E : Set (Euclid n)) (c₁ c₂ : ℝ), 0 < c₁ → 0 ≤ c₂ → (∀ a ∈ E, ∀ b ∈ E, c₁ * ‖a - b‖ ≤ ‖χ a - χ b‖ ∧ ‖χ a - χ b‖ ≤ c₂ * ‖a - b‖) → ENNReal.ofReal (c₁ ^ n) * volume E ≤ μHE[n] (χ '' E) ∧ μHE[n] (χ '' E) ≤ ENNReal.ofReal (c₂ ^ n) * volume E := by
  intro P n χ E c₁ c₂ hc₁ hc₂ h
  -- `Lⁿ = Hⁿ` on `ℝⁿ`, and `Hⁿ = c · μH[n]` on every metric space
  have hvol : (volume : Measure (Euclid n)) = μHE[n] :=
    (EuclideanSpace.euclideanHausdorffMeasure_eq_volume n).symm
  have hscale : ∀ {X : Type} [EMetricSpace X] [MeasurableSpace X] [BorelSpace X] (S : Set X),
      (μHE[n] : Measure X) S = (Measure.addHaarScalarFactor
        (volume : Measure (EuclideanSpace ℝ (Fin n))) μH[n] : ℝ≥0∞) * μH[(n : ℝ)] S := by
    intro X _ _ _ S
    rw [Measure.euclideanHausdorffMeasure_def, Measure.smul_apply, ENNReal.smul_def, smul_eq_mul]
  constructor
  · -- lower bound: `χ` is injective on `E` and its inverse on `χ(E)` is `c₁⁻¹`-Lipschitz
    have hinj : InjOn χ E := by
      intro a ha b hb hab
      have := (h a ha b hb).1
      rw [hab, sub_self, norm_zero] at this
      have : ‖a - b‖ = 0 := le_antisymm (by nlinarith [norm_nonneg (a - b)]) (norm_nonneg _)
      exact sub_eq_zero.1 (norm_eq_zero.1 this)
    set g := Function.invFunOn χ E
    have hleft : LeftInvOn g χ E := hinj.leftInvOn_invFunOn
    have hgL : LipschitzOnWith (Real.toNNReal c₁⁻¹) g (χ '' E) := by
      apply LipschitzOnWith.of_dist_le_mul
      rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩
      rw [hleft ha, hleft hb, dist_eq_norm, dist_eq_norm,
        Real.coe_toNNReal _ (inv_nonneg.2 hc₁.le)]
      have := (h a ha b hb).1
      rw [inv_mul_eq_div, le_div_iff₀ hc₁]
      linarith
    have himg : g '' (χ '' E) = E := hleft.image_image
    have hle := hgL.hausdorffMeasure_image_le (d := (n : ℝ)) (Nat.cast_nonneg n)
    rw [himg] at hle
    rw [hvol, hscale, hscale (χ '' E)]
    set c : ℝ≥0∞ := (Measure.addHaarScalarFactor
      (volume : Measure (EuclideanSpace ℝ (Fin n))) μH[n] : ℝ≥0∞)
    have hK : ((Real.toNNReal c₁⁻¹ : NNReal) : ℝ≥0∞) ^ (n : ℝ) = ENNReal.ofReal (c₁ ^ n)⁻¹ := by
      rw [ENNReal.rpow_natCast, ← ENNReal.ofReal_coe_nnreal,
        Real.coe_toNNReal _ (inv_nonneg.2 hc₁.le), ← ENNReal.ofReal_pow (inv_nonneg.2 hc₁.le),
        inv_pow]
    rw [hK] at hle
    have hpos : ENNReal.ofReal (c₁ ^ n) ≠ 0 := (ENNReal.ofReal_pos.2 (pow_pos hc₁ n)).ne'
    have hinv : ENNReal.ofReal (c₁ ^ n)⁻¹ = (ENNReal.ofReal (c₁ ^ n))⁻¹ :=
      ENNReal.ofReal_inv_of_pos (pow_pos hc₁ n)
    rw [hinv] at hle
    calc ENNReal.ofReal (c₁ ^ n) * (c * μH[(n : ℝ)] E)
        ≤ ENNReal.ofReal (c₁ ^ n) * (c * ((ENNReal.ofReal (c₁ ^ n))⁻¹ * μH[(n : ℝ)] (χ '' E))) := by
          gcongr
      _ = c * μH[(n : ℝ)] (χ '' E) := by
          rw [← mul_assoc, mul_comm (ENNReal.ofReal (c₁ ^ n)) c, mul_assoc,
            ← mul_assoc (ENNReal.ofReal (c₁ ^ n)), ENNReal.mul_inv_cancel hpos ENNReal.ofReal_ne_top,
            one_mul]
  · -- upper bound: `χ` is `c₂`-Lipschitz on `E`
    have hL : LipschitzOnWith (Real.toNNReal c₂) χ E := by
      apply LipschitzOnWith.of_dist_le_mul
      intro a ha b hb
      rw [dist_eq_norm, dist_eq_norm, Real.coe_toNNReal _ hc₂]
      exact (h a ha b hb).2
    have hle := hL.hausdorffMeasure_image_le (d := (n : ℝ)) (Nat.cast_nonneg n)
    rw [hvol, hscale, hscale E]
    have hK : ((Real.toNNReal c₂ : NNReal) : ℝ≥0∞) ^ (n : ℝ) = ENNReal.ofReal (c₂ ^ n) := by
      rw [ENNReal.rpow_natCast, ← ENNReal.ofReal_coe_nnreal, Real.coe_toNNReal _ hc₂,
        ← ENNReal.ofReal_pow hc₂]
    rw [hK] at hle
    calc _ ≤ (Measure.addHaarScalarFactor (volume : Measure (EuclideanSpace ℝ (Fin n))) μH[n] : ℝ≥0∞) *
          (ENNReal.ofReal (c₂ ^ n) * μH[(n : ℝ)] E) := by gcongr
      _ = _ := by ring

/-- **Density one on an embedded `C¹` submanifold** (the fact `Θⁿ(Hⁿ⌞M, z) = 1` behind
`Θⁿ(μ_T, z) = |m|` for `T = m[[M]]` near `z ∈ reg T`, Simon 7.4.1):
`Hⁿ(M ∩ B_s(z)) / (ωₙsⁿ) → 1` as `s ↓ 0`.  For `ε ∈ (0, 1)`, a `(1 ± ε)`-bi-Lipschitz chart `χ`
with `χ(0) = z` gives `χ(B_{s/(1+ε)}(0)) ⊆ M ∩ B_s(z) ⊆ χ(B_{s/(1−ε)}(0))` for small `s > 0`.  With
the bi-Lipschitz measure bounds (Simon Ch. 2, 1.8(i)) and `Lⁿ(B_r(0)) = ωₙrⁿ` this gives
`((1 − ε)/(1 + ε))ⁿ ≤ Hⁿ(M ∩ B_s(z)) / (ωₙsⁿ) ≤ ((1 + ε)/(1 − ε))ⁿ`, and both bounds tend to `1`
as `ε → 0`. -/
theorem Submission.dimred_rpd_submanifold_density_one : ∀ (P n : ℕ) (M : Set (Euclid P)) (z : Euclid P), IsEmbeddedSubmanifold 1 n M → z ∈ M → Tendsto (fun s : ℝ => μHE[n] (M ∩ ball z s) / (unitBallVolume n * ENNReal.ofReal (s ^ n))) (𝓝[>] 0) (𝓝 1) := by
  intro P n M z hM hz
  -- `ωₙ ∈ (0, ∞)`, and `Lⁿ(B_r(0)) = rⁿωₙ` for `r > 0`
  have hω0 : unitBallVolume n ≠ 0 := (measure_ball_pos volume (0 : Euclid n) one_pos).ne'
  have hωT : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
  have hvol : ∀ r : ℝ, 0 < r →
      volume (ball (0 : Euclid n) r) = ENNReal.ofReal (r ^ n) * unitBallVolume n := by
    intro r hr; rw [Measure.addHaar_ball_of_pos _ _ hr, finrank_euclideanSpace_fin]; rfl
  -- Step 1: for `ε ∈ (0, 1)`, `((1 − ε)/(1 + ε))ⁿ ≤ Hⁿ(M ∩ B_s(z)) / (ωₙsⁿ) ≤ ((1 + ε)/(1 − ε))ⁿ`
  -- for all small `s > 0`
  have hbounds : ∀ ε : ℝ, 0 < ε → ε < 1 → ∀ᶠ s in 𝓝[>] (0 : ℝ),
      ENNReal.ofReal (((1 - ε) / (1 + ε)) ^ n) ≤
          μHE[n] (M ∩ ball z s) / (unitBallVolume n * ENNReal.ofReal (s ^ n)) ∧
        μHE[n] (M ∩ ball z s) / (unitBallVolume n * ENNReal.ofReal (s ^ n)) ≤
          ENNReal.ofReal (((1 + ε) / (1 - ε)) ^ n) := by
    intro ε hε hε1
    -- the `(1 ± ε)`-bi-Lipschitz chart `χ : B_δ(0) → M` with `χ(0) = z`, onto `M` near `z`
    obtain ⟨χ, δ, δ', hδ, hδ', hχ0, hbil, hχM, hMχ⟩ :=
      Submission.dimred_rpd_near_isometric_chart P n M z hM hz ε hε
    have h1ε : 0 < 1 - ε := by linarith
    have h1ε' : 0 < 1 + ε := by linarith
    have hs₀ : 0 < min δ' ((1 - ε) * δ) := lt_min hδ' (mul_pos h1ε hδ)
    filter_upwards [Ioo_mem_nhdsGT hs₀] with s hs
    obtain ⟨hs0, hs1⟩ := hs
    have hsδ' : s < δ' := lt_of_lt_of_le hs1 (min_le_left _ _)
    have hsδ : s < (1 - ε) * δ := lt_of_lt_of_le hs1 (min_le_right _ _)
    -- `0 < r₁ = s/(1 + ε) ≤ r₂ = s/(1 − ε) < δ`
    set r₁ := s / (1 + ε) with hr₁def
    set r₂ := s / (1 - ε) with hr₂def
    have hr₁ : 0 < r₁ := div_pos hs0 h1ε'
    have hr₂ : 0 < r₂ := div_pos hs0 h1ε
    have hr₂δ : r₂ < δ := by rw [hr₂def, div_lt_iff₀ h1ε]; linarith
    have hr₁r₂ : r₁ ≤ r₂ := div_le_div_of_nonneg_left hs0.le h1ε (by linarith)
    have hb₁ : ball (0 : Euclid n) r₁ ⊆ ball 0 δ := ball_subset_ball (by linarith)
    have hb₂ : ball (0 : Euclid n) r₂ ⊆ ball 0 δ := ball_subset_ball hr₂δ.le
    -- (a) `χ(B_{r₁}(0)) ⊆ M ∩ B_s(z)`: `|χ(w) − z| ≤ (1 + ε)|w| < (1 + ε)r₁ = s`
    have hinc₁ : χ '' ball 0 r₁ ⊆ M ∩ ball z s := by
      rintro _ ⟨w, hw, rfl⟩
      refine ⟨hχM ⟨w, hb₁ hw, rfl⟩, ?_⟩
      rw [mem_ball, dist_eq_norm, ← hχ0]
      have h := (hbil w (hb₁ hw) 0 (mem_ball_self hδ)).2
      rw [sub_zero] at h
      rw [mem_ball, dist_zero_right] at hw
      calc ‖χ w - χ 0‖ ≤ (1 + ε) * ‖w‖ := h
        _ < (1 + ε) * r₁ := mul_lt_mul_of_pos_left hw h1ε'
        _ = s := by rw [hr₁def]; field_simp
    -- (b) `M ∩ B_s(z) ⊆ χ(B_{r₂}(0))`: `x = χ(w)` with `(1 − ε)|w| ≤ |x − z| < s`
    have hinc₂ : M ∩ ball z s ⊆ χ '' ball 0 r₂ := by
      rintro x ⟨hxM, hxs⟩
      obtain ⟨w, hw, rfl⟩ := hMχ ⟨hxM, ball_subset_ball hsδ'.le hxs⟩
      refine ⟨w, ?_, rfl⟩
      have h := (hbil w hw 0 (mem_ball_self hδ)).1
      rw [sub_zero] at h
      rw [mem_ball, dist_eq_norm, ← hχ0] at hxs
      rw [mem_ball, dist_zero_right, hr₂def, lt_div_iff₀ h1ε]
      nlinarith [norm_nonneg w]
    -- (c) the bi-Lipschitz measure bounds on `B_{r₁}(0), B_{r₂}(0) ⊆ B_δ(0)`
    have hlow := (Submission.dimred_rpd_bilipschitz_image_measure P n χ (ball 0 r₁) (1 - ε) (1 + ε)
      h1ε h1ε'.le (fun a ha b hb => hbil a (hb₁ ha) b (hb₁ hb))).1
    have hupp := (Submission.dimred_rpd_bilipschitz_image_measure P n χ (ball 0 r₂) (1 - ε) (1 + ε)
      h1ε h1ε'.le (fun a ha b hb => hbil a (hb₂ ha) b (hb₂ hb))).2
    rw [hvol r₁ hr₁] at hlow
    rw [hvol r₂ hr₂] at hupp
    have hm1 := hlow.trans (measure_mono hinc₁)
    have hm2 := (measure_mono hinc₂).trans hupp
    -- divide by `ωₙsⁿ ∈ (0, ∞)`
    have hden0 : unitBallVolume n * ENNReal.ofReal (s ^ n) ≠ 0 :=
      mul_ne_zero hω0 (ENNReal.ofReal_pos.2 (pow_pos hs0 n)).ne'
    have hdenT : unitBallVolume n * ENNReal.ofReal (s ^ n) ≠ ∞ :=
      ENNReal.mul_ne_top hωT ENNReal.ofReal_ne_top
    constructor
    · rw [ENNReal.le_div_iff_mul_le (Or.inl hden0) (Or.inl hdenT)]
      have e : ((1 - ε) / (1 + ε)) ^ n * s ^ n = (1 - ε) ^ n * r₁ ^ n := by
        rw [hr₁def, div_pow, div_pow]; field_simp
      calc ENNReal.ofReal (((1 - ε) / (1 + ε)) ^ n) * (unitBallVolume n * ENNReal.ofReal (s ^ n))
          = ENNReal.ofReal (((1 - ε) / (1 + ε)) ^ n * s ^ n) * unitBallVolume n := by
            rw [ENNReal.ofReal_mul (by positivity)]; ring
        _ = ENNReal.ofReal ((1 - ε) ^ n * r₁ ^ n) * unitBallVolume n := by rw [e]
        _ = ENNReal.ofReal ((1 - ε) ^ n) * (ENNReal.ofReal (r₁ ^ n) * unitBallVolume n) := by
            rw [ENNReal.ofReal_mul (by positivity)]; ring
        _ ≤ _ := hm1
    · rw [ENNReal.div_le_iff hden0 hdenT]
      have e : ((1 + ε) / (1 - ε)) ^ n * s ^ n = (1 + ε) ^ n * r₂ ^ n := by
        rw [hr₂def, div_pow, div_pow]; field_simp
      calc μHE[n] (M ∩ ball z s)
          ≤ ENNReal.ofReal ((1 + ε) ^ n) * (ENNReal.ofReal (r₂ ^ n) * unitBallVolume n) := hm2
        _ = ENNReal.ofReal ((1 + ε) ^ n * r₂ ^ n) * unitBallVolume n := by
            rw [ENNReal.ofReal_mul (by positivity)]; ring
        _ = ENNReal.ofReal (((1 + ε) / (1 - ε)) ^ n * s ^ n) * unitBallVolume n := by rw [e]
        _ = ENNReal.ofReal (((1 + ε) / (1 - ε)) ^ n) *
              (unitBallVolume n * ENNReal.ofReal (s ^ n)) := by
            rw [ENNReal.ofReal_mul (by positivity)]; ring
  -- Step 2: both bounds tend to `1` as `ε → 0`, so `Hⁿ(M ∩ B_s(z)) / (ωₙsⁿ) → 1` (`tendsto_order`)
  have hg₁ : Tendsto (fun ε : ℝ => ENNReal.ofReal (((1 - ε) / (1 + ε)) ^ n)) (𝓝 0) (𝓝 1) := by
    have h : Tendsto (fun ε : ℝ => ((1 - ε) / (1 + ε)) ^ n) (𝓝 0) (𝓝 (((1 - 0) / (1 + 0)) ^ n)) :=
      ((tendsto_const_nhds.sub tendsto_id).div (tendsto_const_nhds.add tendsto_id)
        (by norm_num)).pow n
    simpa using ENNReal.tendsto_ofReal h
  have hg₂ : Tendsto (fun ε : ℝ => ENNReal.ofReal (((1 + ε) / (1 - ε)) ^ n)) (𝓝 0) (𝓝 1) := by
    have h : Tendsto (fun ε : ℝ => ((1 + ε) / (1 - ε)) ^ n) (𝓝 0) (𝓝 (((1 + 0) / (1 - 0)) ^ n)) :=
      ((tendsto_const_nhds.add tendsto_id).div (tendsto_const_nhds.sub tendsto_id)
        (by norm_num)).pow n
    simpa using ENNReal.tendsto_ofReal h
  have hsmall : ∀ᶠ ε in 𝓝[>] (0 : ℝ), 0 < ε ∧ ε < 1 := by
    filter_upwards [self_mem_nhdsWithin,
      eventually_nhdsWithin_of_eventually_nhds (eventually_lt_nhds one_pos)] with ε h1 h2
    exact ⟨h1, h2⟩
  refine tendsto_order.2 ⟨fun a ha => ?_, fun b hb => ?_⟩
  · -- `a < 1`: choose `ε ∈ (0, 1)` with `a < ((1 − ε)/(1 + ε))ⁿ`
    obtain ⟨ε, hεa, hε0, hε1⟩ :=
      (((hg₁.mono_left nhdsWithin_le_nhds).eventually (lt_mem_nhds ha)).and hsmall).exists
    filter_upwards [hbounds ε hε0 hε1] with s hs
    exact lt_of_lt_of_le hεa hs.1
  · -- `1 < b`: choose `ε ∈ (0, 1)` with `((1 + ε)/(1 − ε))ⁿ < b`
    obtain ⟨ε, hεb, hε0, hε1⟩ :=
      (((hg₂.mono_left nhdsWithin_le_nhds).eventually (gt_mem_nhds hb)).and hsmall).exists
    filter_upwards [hbounds ε hε0 hε1] with s hs
    exact lt_of_le_of_lt hs.2 hεb
/-- **Simon Ch. 6, 1.1 and 1.7**: a unit orientation `ξ = ±τ₁ ∧ ⋯ ∧ τₙ` of a plane (`τ`
orthonormal) is a nonzero `n`-vector of norm at most one.  `|ξ(α)| = |α(τ)| ≤ ‖α‖ ∏ᵢ ‖τᵢ‖ = ‖α‖`
gives `‖ξ‖ ≤ 1`.  The covector `δ(w) = Σ_σ sgn σ ∏ᵢ ⟨τᵢ, w_{σ(i)}⟩ = det(⟨τᵢ, wⱼ⟩)`, the
alternatization of `w ↦ ∏ᵢ ⟨τᵢ, wᵢ⟩`, has `δ(τ) = 1` by orthonormality, so `ξ(δ) = ±1 ≠ 0`. -/
theorem Submission.imsupp_unit_orientation_ne_zero_norm_le_one : ∀ (P n : ℕ) (ξ : MultiVector P n) (Q : Submodule ℝ (Euclid P)), IsUnitOrientationOf ξ Q → ξ ≠ 0 ∧ ‖ξ‖ ≤ 1 := by
  rintro P n ξ Q ⟨τ, hτ, -, hξ⟩
  -- `|ξ(α)| = |α(τ)|` for either sign
  have hnorm : ∀ α : Covector (Euclid P) n, ‖ξ α‖ = ‖α τ‖ := fun α => by
    rcases hξ with h | h
    · rw [h α]
    · rw [h α, norm_neg]
  refine ⟨fun h0 => ?_, ContinuousLinearMap.opNorm_le_bound ξ zero_le_one fun α => ?_⟩
  · -- the covector `δ(w) = Σ_σ sgn σ ∏ᵢ ⟨τᵢ, w_{σ(i)}⟩` has `δ(τ) = 1`: the term `σ = 1` is
    -- `∏ᵢ ‖τᵢ‖² = 1`, and for `σ ≠ 1` some factor `⟨τᵢ, τ_{σ(i)}⟩`, `σ(i) ≠ i`, vanishes
    obtain ⟨δ, hδ⟩ : ∃ δ : Covector (Euclid P) n, δ τ = 1 := by
      refine ⟨ContinuousMultilinearMap.alternatization
        ((ContinuousMultilinearMap.mkPiAlgebra ℝ (Fin n) ℝ).compContinuousLinearMap
          fun i => innerSL ℝ (τ i)), ?_⟩
      rw [ContinuousMultilinearMap.alternatization_apply_apply,
        Finset.sum_eq_single (1 : Equiv.Perm (Fin n))]
      · rw [Equiv.Perm.sign_one, one_smul, Equiv.Perm.coe_one, Function.comp_id,
          ContinuousMultilinearMap.compContinuousLinearMap_apply,
          ContinuousMultilinearMap.mkPiAlgebra_apply]
        refine Finset.prod_eq_one fun i _ => ?_
        rw [innerSL_apply_apply, real_inner_self_eq_norm_sq, hτ.norm_eq_one, one_pow]
      · intro σ _ hσ
        obtain ⟨i, hi⟩ : ∃ i, σ i ≠ i := by
          by_contra! h
          exact hσ (Equiv.ext h)
        rw [ContinuousMultilinearMap.compContinuousLinearMap_apply,
          ContinuousMultilinearMap.mkPiAlgebra_apply,
          Finset.prod_eq_zero (Finset.mem_univ i) ?_, smul_zero]
        rw [innerSL_apply_apply, Function.comp_apply]
        exact hτ.inner_eq_zero hi.symm
      · exact fun h => absurd (Finset.mem_univ _) h
    -- `ξ = 0` would give `0 = ‖ξ(δ)‖ = ‖δ(τ)‖ = 1`
    have h := hnorm δ
    rw [h0, hδ, zero_apply, norm_zero, norm_one] at h
    exact zero_ne_one h
  · -- `|ξ(α)| = |α(τ)| ≤ ‖α‖ ∏ᵢ ‖τᵢ‖ = ‖α‖`
    rw [hnorm, one_mul]
    calc ‖α τ‖ ≤ ‖α‖ * ∏ i, ‖τ i‖ := ContinuousAlternatingMap.le_opNorm α τ
      _ = ‖α‖ := by rw [Finset.prod_eq_one fun i _ => hτ.norm_eq_one i, mul_one]
/-- **`Hⁿ⌞Q = ι_#(Lⁿ)` for the plane of an orthonormal frame** (step 3 of the planar constancy
argument, Simon Ch. 6, 2.34, in the proof of Simon 7.3.3).  For `τ` orthonormal in `ℝᴾ`,
`ι(s) = Σᵢ sᵢτᵢ` is linear with `|ι(s)|² = Σᵢ sᵢ² = |s|²`, so it is an isometry `ℝⁿ → ℝᴾ` with
range `Q = span{τ₁, …, τₙ}`; `Hⁿ` is preserved by isometries (`ι_#(Hⁿ) = Hⁿ⌞range ι`) and
`Hⁿ = Lⁿ` on `ℝⁿ`. -/
theorem Submission.idtp_pc_plane_hausdorff_eq_map : ∀ (P n : ℕ) (τ : Fin n → Euclid P), Orthonormal ℝ τ → (μHE[n] : Measure (Euclid P)).restrict (Submodule.span ℝ (Set.range τ) : Set (Euclid P)) = Measure.map (fun s : Euclid n => ∑ i, s i • τ i) volume := by
  intro P n τ hτ
  -- `ι(s) = Σᵢ sᵢτᵢ` is linear
  let L : Euclid n →ₗ[ℝ] Euclid P :=
    { toFun := fun s => ∑ i, s i • τ i
      map_add' := fun s t => by simp [add_smul, Finset.sum_add_distrib]
      map_smul' := fun c s => by simp [Finset.smul_sum, smul_smul] }
  have hLapp : ∀ s, L s = ∑ i, s i • τ i := fun s => rfl
  -- `|ι(s)|² = ⟨ι(s), ι(s)⟩ = Σᵢ sᵢ² = |s|²`, so `ι` is an isometry
  have hnorm : ∀ s, ‖L s‖ = ‖s‖ := by
    intro s
    have h1 : ‖L s‖ ^ 2 = ‖s‖ ^ 2 := by
      rw [hLapp, ← real_inner_self_eq_norm_sq, hτ.inner_sum, EuclideanSpace.norm_eq,
        Real.sq_sqrt (Finset.sum_nonneg fun i _ => sq_nonneg _)]
      simp [sq]
    exact (pow_left_inj₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).mp h1
  have hiso : Isometry L := AddMonoidHomClass.isometry_of_norm L hnorm
  -- `range ι = Q`: `ι(s) ∈ Q`, and each `y ∈ Q` is `Σᵢ cᵢτᵢ = ι(c)`
  have hrange : Set.range L = (Submodule.span ℝ (Set.range τ) : Set (Euclid P)) := by
    ext y
    constructor
    · rintro ⟨s, rfl⟩
      rw [hLapp]
      exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
    · intro hy
      obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp (SetLike.mem_coe.mp hy)
      exact ⟨(WithLp.equiv 2 (Fin n → ℝ)).symm c, by rw [hLapp]; rfl⟩
  -- `ι_#(Hⁿ) = Hⁿ⌞range ι = Hⁿ⌞Q`, and `Hⁿ = Lⁿ` on `ℝⁿ`
  have h := hiso.map_euclideanHausdorffMeasure (d := n)
  rw [EuclideanSpace.euclideanHausdorffMeasure_eq_volume, hrange] at h
  exact h.symm
/-- A test function on the parameter domain of a plane extends to an ambient test function (step 6
of the constancy argument for a current carried by a plane, Simon Ch. 6, 2.34).  For orthonormal
`τ`, `ι(s) = Σᵢ sᵢτᵢ` and `ψ ∈ C^∞_c` with `spt ψ ⊆ ι⁻¹(V)`, let `ι*(y) = (⟨τₖ, y⟩)ₖ` (so
`ι*ι = id`, `ι*τⱼ = eⱼ`) and `q(y) = y − ι(ι*y)`.  Choose `δ > 0` with
`cthickening δ (ι(spt ψ)) ⊆ V` and a smooth bump `χ`, `χ = 1` on `B̄_{δ/2}(0)`, `spt χ ⊆ B̄_δ(0)`,
and put `f(y) = ψ(ι*y)·χ(q y)`.  Then `spt f ⊆ {y : ι*y ∈ spt ψ, |q y| ≤ δ}`, a compact subset of
`V`, and `f = ψ ∘ ι*` near `ι(s)`, so `f(ι(s)) = ψ(s)` and `Df(ι(s))(τⱼ) = Dψ(s)(eⱼ)`. -/
theorem Submission.idtp_pc_plane_test_extension : ∀ (P n : ℕ) (V : Set (Euclid P)) (τ : Fin n → Euclid P) (ψ : Euclid n → ℝ), IsOpen V → Orthonormal ℝ τ → ContDiff ℝ (⊤ : ℕ∞) ψ → HasCompactSupport ψ → tsupport ψ ⊆ {s : Euclid n | ∑ i, s i • τ i ∈ V} → ∃ f : Euclid P → ℝ, ContDiff ℝ (⊤ : ℕ∞) f ∧ HasCompactSupport f ∧ tsupport f ⊆ V ∧ ∀ s : Euclid n, f (∑ i, s i • τ i) = ψ s ∧ ∀ j : Fin n, fderiv ℝ f (∑ i, s i • τ i) (τ j) = fderiv ℝ ψ s (EuclideanSpace.single j (1 : ℝ)) := by
  intro P n V τ ψ hV hτ hψ hψc hψΩ
  -- the parametrization L and its left inverse Ls
  let L₀ : Euclid n →ₗ[ℝ] Euclid P :=
    { toFun := fun s => ∑ i, s i • τ i
      map_add' := fun s t => by simp [add_smul, Finset.sum_add_distrib]
      map_smul' := fun c s => by simp [Finset.smul_sum, smul_smul] }
  let L : Euclid n →L[ℝ] Euclid P := LinearMap.toContinuousLinearMap L₀
  have hLapp : ∀ s, L s = ∑ i, s i • τ i := fun s => rfl
  have hnorm : ∀ s, ‖L s‖ = ‖s‖ := by
    intro s
    have h1 : ‖L s‖ ^ 2 = ‖s‖ ^ 2 := by
      rw [hLapp, ← real_inner_self_eq_norm_sq, hτ.inner_sum, EuclideanSpace.norm_eq,
        Real.sq_sqrt (Finset.sum_nonneg fun i _ => sq_nonneg _)]
      simp [sq]
    exact (pow_left_inj₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).mp h1
  let Ls₀ : Euclid P →ₗ[ℝ] Euclid n :=
    { toFun := fun y => (WithLp.equiv 2 (Fin n → ℝ)).symm (fun k => inner ℝ (τ k) y)
      map_add' := fun y z => by ext k; simp [inner_add_right]
      map_smul' := fun c y => by ext k; simp [inner_smul_right] }
  let Ls : Euclid P →L[ℝ] Euclid n := LinearMap.toContinuousLinearMap Ls₀
  have hLsL : ∀ s, Ls (L s) = s := by
    intro s
    ext k
    simp [Ls, Ls₀, L, L₀, orthonormal_iff_ite.mp hτ]
  have hLsτ : ∀ j, Ls (τ j) = EuclideanSpace.single j (1 : ℝ) := by
    intro j
    ext k
    simp [Ls, Ls₀, orthonormal_iff_ite.mp hτ, eq_comm]
  -- the normal component q y = y - L (Ls y)
  let q : Euclid P →L[ℝ] Euclid P := ContinuousLinearMap.id ℝ (Euclid P) - L.comp Ls
  have hqapp : ∀ y, q y = y - L (Ls y) := fun y => rfl
  have hqL : ∀ s, q (L s) = 0 := by intro s; rw [hqapp, hLsL, sub_self]
  -- compactness and a margin δ
  set K := tsupport ψ with hKdef
  have hK : IsCompact K := hψc
  have hLK : IsCompact (L '' K) := hK.image L.continuous
  have hLKV : L '' K ⊆ V := by
    rintro _ ⟨s, hs, rfl⟩
    exact hψΩ hs
  obtain ⟨δ, hδ, hδV⟩ := hLK.exists_cthickening_subset_open hV hLKV
  obtain ⟨R, hR⟩ := hK.isBounded.subset_closedBall 0
  -- the bump function
  let χ : ContDiffBump (0 : Euclid P) := ⟨δ / 2, δ, by positivity, by linarith⟩
  let f : Euclid P → ℝ := fun y => ψ (Ls y) * χ (q y)
  have hfapp : ∀ y, f y = ψ (Ls y) * χ (q y) := fun y => rfl
  -- the set A
  let A : Set (Euclid P) := {y | Ls y ∈ K ∧ ‖q y‖ ≤ δ}
  have hAclosed : IsClosed A :=
    (isClosed_tsupport ψ |>.preimage Ls.continuous).inter
      (isClosed_le (continuous_norm.comp q.continuous) continuous_const)
  have hsuppA : support f ⊆ A := by
    intro y hy
    have hy' : ψ (Ls y) * χ (q y) ≠ 0 := hy
    refine ⟨subset_tsupport ψ (left_ne_zero_of_mul hy'), ?_⟩
    have hχ : χ (q y) ≠ 0 := right_ne_zero_of_mul hy'
    have : q y ∈ support χ := hχ
    rw [χ.support_eq] at this
    simpa [dist_eq_norm] using (mem_ball.mp this).le
  have htsuppA : tsupport f ⊆ A := closure_minimal hsuppA hAclosed
  have hAbdd : A ⊆ closedBall 0 (R + δ) := by
    intro y hy
    rw [mem_closedBall, dist_zero_right]
    have h1 : y = L (Ls y) + q y := by rw [hqapp]; abel
    have h2 : ‖Ls y‖ ≤ R := by simpa using hR hy.1
    calc ‖y‖ = ‖L (Ls y) + q y‖ := by rw [← h1]
      _ ≤ ‖L (Ls y)‖ + ‖q y‖ := norm_add_le _ _
      _ = ‖Ls y‖ + ‖q y‖ := by rw [hnorm]
      _ ≤ R + δ := add_le_add h2 hy.2
  have hAcpt : IsCompact A := (isCompact_closedBall 0 (R + δ)).of_isClosed_subset hAclosed hAbdd
  have hAV : A ⊆ V := by
    intro y hy
    apply hδV
    apply mem_cthickening_of_dist_le y (L (Ls y)) δ (L '' K) ⟨Ls y, hy.1, rfl⟩
    rw [dist_eq_norm, ← hqapp]
    exact hy.2
  refine ⟨f, ?_, ?_, htsuppA.trans hAV, fun s => ⟨?_, fun j => ?_⟩⟩
  · exact (hψ.comp Ls.contDiff).mul (χ.contDiff.comp q.contDiff)
  · exact HasCompactSupport.of_support_subset_isCompact hAcpt hsuppA
  · show ψ (Ls (L s)) * χ (q (L s)) = ψ s
    rw [hLsL, hqL, χ.one_of_mem_closedBall (by simp; positivity), mul_one]
  · -- near L s, f = ψ ∘ Ls
    have hev : f =ᶠ[𝓝 (L s)] fun y => ψ (Ls y) := by
      have hq : Tendsto q (𝓝 (L s)) (𝓝 0) := by
        have := q.continuous.tendsto (L s)
        rwa [hqL] at this
      filter_upwards [hq (closedBall_mem_nhds 0 (by positivity : (0:ℝ) < δ / 2))] with y hy
      rw [hfapp, χ.one_of_mem_closedBall hy, mul_one]
    show fderiv ℝ f (L s) (τ j) = _
    rw [hev.fderiv_eq]
    change fderiv ℝ (ψ ∘ Ls) (L s) (τ j) = _
    have hψd : DifferentiableAt ℝ ψ (Ls (L s)) := (hψ.differentiable (by simp)).differentiableAt
    rw [fderiv_comp (L s) hψd Ls.differentiableAt, ContinuousLinearMap.fderiv]
    simp only [ContinuousLinearMap.coe_comp, Function.comp_apply, hLsτ, hLsL]
/-- **Simon Ch. 3, Definition 1.4 and Remark 1.5(1)**: an approximate tangent space of `M` at `x`
lies in every subspace `T` along which a set `N` carrying `Hⁿ`-almost all of `M` is flat at `x`
(for each `ε > 0` there is `ρ > 0` such that every `z ∈ N` with `|z − x| < ρ` has some `t ∈ T`
with `|z − x − t| ≤ ε|z − x|`).  If `q ∈ Q \ T`, put `δ = dist(q, T) > 0` and
`g = max(0, δ/2 − |· − q|) ∈ C_c(ℝᴾ)`; `∫_Q g dHⁿ > 0` because `spt(Hⁿ⌞Q) = Q`.  With
`ε = δ / (2(|q| + δ))` and `0 < r < ρ / (|q| + δ)`, flatness makes `g` vanish on `η_{x,r}(M ∩ N)`,
and `Hⁿ(η_{x,r}(M \ N)) = 0`; so `∫_{η_{x,r}(M)} g dHⁿ = 0` for all small `r`, contradicting
the defining limit. -/
theorem Submission.atsm_approxTangent_le_of_flat : ∀ (P n : ℕ) (N M : Set (Euclid P)) (x : Euclid P) (Q T : Submodule ℝ (Euclid P)), μHE[n] (M \ N) = 0 → (∀ ε : ℝ, 0 < ε → ∃ ρ : ℝ, 0 < ρ ∧ ∀ z ∈ N, dist z x < ρ → ∃ t ∈ T, ‖z - x - t‖ ≤ ε * ‖z - x‖) → HasApproximateTangentSpaceAt n M x Q → Q ≤ T := by
  intro P n N M x Q T hnull hflat hQ q hq
  by_contra hqT
  -- `T` is closed, so `δ = dist(q, T) > 0`
  have hTc : IsClosed (T : Set (Euclid P)) := T.closed_of_finiteDimensional
  have hδ : 0 < infDist q (T : Set (Euclid P)) :=
    (hTc.notMem_iff_infDist_pos ⟨0, T.zero_mem⟩).1 hqT
  set δ := infDist q (T : Set (Euclid P)) with hδdef
  -- the bump `g = max(0, δ/2 − |· − q|)`, positive exactly on `B_{δ/2}(q)`
  set g : Euclid P → ℝ := fun y => max 0 (δ / 2 - ‖y - q‖) with hgdef
  have hgc : Continuous g :=
    continuous_const.max (continuous_const.sub (continuous_id.sub continuous_const).norm)
  have hg0 : 0 ≤ g := fun y => le_max_left _ _
  have hgsupp : ∀ y, g y ≠ 0 → ‖y - q‖ < δ / 2 := by
    intro y hy
    by_contra h
    have h' : δ / 2 ≤ ‖y - q‖ := not_lt.mp h
    apply hy
    exact max_eq_left (by linarith)
  have hgpos : ∀ y, ‖y - q‖ < δ / 2 → 0 < g y := fun y hy =>
    lt_max_of_lt_right (by linarith)
  have hgcs : HasCompactSupport g := by
    apply HasCompactSupport.intro (isCompact_closedBall q (δ / 2))
    intro y hy
    by_contra h
    apply hy
    rw [mem_closedBall, dist_eq_norm]
    exact (hgsupp y h).le
  let f : CompactlySupportedContinuousMap (Euclid P) ℝ := ⟨⟨g, hgc⟩, hgcs⟩
  -- `∫_Q g dHⁿ > 0`: `Hⁿ⌞Q` is regular with support `Q ∋ q`
  have hQn : Module.finrank ℝ Q = n := hQ.1
  have := Poincare.SimonGMT.Chapter03.regular_euclideanHausdorffMeasure_restrict_submodule hQn
  have hsupp := Poincare.SimonGMT.Chapter03.support_euclideanHausdorffMeasure_restrict_submodule hQn
  have hint : Integrable g ((μHE[n] : Measure (Euclid P)).restrict (Q : Set (Euclid P))) :=
    hgc.integrable_of_hasCompactSupport hgcs
  have hpos : 0 < ∫ y in (Q : Set (Euclid P)), g y ∂μHE[n] := by
    rw [integral_pos_iff_support_of_nonneg hg0 hint]
    have hq' : q ∈ ((μHE[n] : Measure (Euclid P)).restrict (Q : Set (Euclid P))).support := by
      rw [hsupp]
      exact hq
    have hball : 0 < ((μHE[n] : Measure (Euclid P)).restrict (Q : Set (Euclid P)))
        (ball q (δ / 2)) :=
      (Measure.mem_support_iff_forall q).1 hq' _ (ball_mem_nhds q (by linarith))
    refine hball.trans_le (measure_mono ?_)
    intro y hy
    rw [mem_ball, dist_eq_norm] at hy
    exact (hgpos y hy).ne'
  -- constants: `ε (|q| + δ) = δ / 2`
  have hqδ : 0 < ‖q‖ + δ := by positivity
  set ε : ℝ := δ / (2 * (‖q‖ + δ)) with hεdef
  have hε : 0 < ε := by positivity
  have hεq : ε * (‖q‖ + δ) = δ / 2 := by
    rw [hεdef]
    field_simp
  obtain ⟨ρ, hρ, hflatρ⟩ := hflat ε hε
  -- `∫_{η_{x,r}(M)} g dHⁿ = 0` for `0 < r < ρ / (|q| + δ)`
  have hvan : ∀ r : ℝ, 0 < r → r < ρ / (‖q‖ + δ) →
      ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, f y ∂μHE[n] = 0 := by
    intro r hr hrρ
    -- `η_{x,r}(M \ N) = r⁻¹ (M \ N − x)` is `Hⁿ`-null
    have hnull' : μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' (M \ N)) = 0 := by
      have himg : Poincare.SimonGMT.Chapter03.blowUpMap x r '' (M \ N) =
          (fun y => r⁻¹ • y) '' ((fun y => y - x) '' (M \ N)) := by
        rw [Set.image_image]
        rfl
      have hiso : Isometry (fun y : Euclid P => y - x) :=
        Isometry.of_dist_eq fun a b => dist_sub_right a b x
      rw [himg, Set.image_smul, Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hr.ne'),
        hiso.euclideanHausdorffMeasure_image, hnull, smul_zero]
    -- flatness: `g` vanishes on `η_{x,r}(M ∩ N)`
    have hsub : {y | g y ≠ 0} ∩ Poincare.SimonGMT.Chapter03.blowUpMap x r '' M ⊆
        Poincare.SimonGMT.Chapter03.blowUpMap x r '' (M \ N) := by
      rintro y ⟨hgy, z, hzM, rfl⟩
      refine ⟨z, ⟨hzM, fun hzN => ?_⟩, rfl⟩
      have hyq : ‖Poincare.SimonGMT.Chapter03.blowUpMap x r z - q‖ < δ / 2 := hgsupp _ hgy
      set y := Poincare.SimonGMT.Chapter03.blowUpMap x r z with hy
      have hy' : y = r⁻¹ • (z - x) := rfl
      have hzx : z - x = r • y := by
        rw [hy', smul_smul, mul_inv_cancel₀ hr.ne', one_smul]
      have hynorm : ‖y‖ < ‖q‖ + δ / 2 := by
        calc ‖y‖ = ‖(y - q) + q‖ := by rw [sub_add_cancel]
          _ ≤ ‖y - q‖ + ‖q‖ := norm_add_le _ _
          _ < δ / 2 + ‖q‖ := by linarith
          _ = ‖q‖ + δ / 2 := by ring
      have hzxn : ‖z - x‖ = r * ‖y‖ := by
        rw [hzx, norm_smul, Real.norm_of_nonneg hr.le]
      have hdist : dist z x < ρ := by
        rw [dist_eq_norm, hzxn]
        calc r * ‖y‖ ≤ r * (‖q‖ + δ) := by gcongr; linarith
          _ < ρ / (‖q‖ + δ) * (‖q‖ + δ) := by gcongr
          _ = ρ := by field_simp
      obtain ⟨t, htT, ht⟩ := hflatρ z hzN hdist
      have hrt : r⁻¹ • t ∈ T := T.smul_mem _ htT
      have hyt : y - r⁻¹ • t = r⁻¹ • (z - x - t) := by
        rw [hy']
        exact (smul_sub _ _ _).symm
      have hyt' : ‖y - r⁻¹ • t‖ ≤ ε * ‖y‖ := by
        rw [hyt, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hr.le)]
        calc r⁻¹ * ‖z - x - t‖ ≤ r⁻¹ * (ε * ‖z - x‖) := by gcongr
          _ = ε * ‖y‖ := by rw [hzxn]; field_simp
      have hle : δ ≤ ‖q - r⁻¹ • t‖ := by
        rw [← dist_eq_norm]
        exact infDist_le_dist_of_mem hrt
      have h2 : ε * ‖y‖ ≤ δ / 2 := by
        rw [← hεq]
        gcongr
        linarith
      have hlt : ‖q - r⁻¹ • t‖ < δ := by
        calc ‖q - r⁻¹ • t‖ = ‖(q - y) + (y - r⁻¹ • t)‖ := by congr 1; abel
          _ ≤ ‖q - y‖ + ‖y - r⁻¹ • t‖ := norm_add_le _ _
          _ < δ / 2 + δ / 2 := by
            have h1 : ‖q - y‖ < δ / 2 := by rw [norm_sub_rev]; exact hyq
            linarith
          _ = δ := by ring
      linarith
    -- so `g = 0` a.e. for `Hⁿ⌞η_{x,r}(M)`, evaluated on the open set `{g ≠ 0}`
    have hopen : MeasurableSet {y | g y ≠ 0} :=
      (isOpen_ne_fun hgc continuous_const).measurableSet
    apply integral_eq_zero_of_ae
    rw [EventuallyEq, ae_iff]
    change (μHE[n].restrict (Poincare.SimonGMT.Chapter03.blowUpMap x r '' M)) {y | g y ≠ 0} = 0
    rw [Measure.restrict_apply hopen]
    exact measure_mono_null hsub hnull'
  -- the blow-up integrals of `g` are eventually `0`, so their limit `∫_Q g dHⁿ` is `0`
  have hlim := hQ.2 f
  have hev : (fun r : ℝ => ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, f y ∂μHE[n])
      =ᶠ[𝓝[>] 0] fun _ => 0 := by
    have hpos' : 0 < ρ / (‖q‖ + δ) := by positivity
    filter_upwards [Ioo_mem_nhdsGT hpos'] with r hr
    exact hvan r hr.1 hr.2
  have hlim0 : Tendsto (fun r : ℝ => ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M,
      f y ∂μHE[n]) (𝓝[>] 0) (𝓝 0) :=
    tendsto_const_nhds.congr' hev.symm
  have heq := tendsto_nhds_unique hlim hlim0
  have hzero : ∫ y in (Q : Set (Euclid P)), g y ∂μHE[n] = 0 := heq
  linarith
/-- Step 11 of the proof that an integer multiplicity cycle carried by a `C¹` graph is regular
(Simon 7.4.3, via Allard's theorem; orientations `±τ₁ ∧ ⋯ ∧ τₙ` as in Ch. 6, 2.1–2.2): two unit
orientations `ξ₁ = ±τ₁ ∧ ⋯ ∧ τₙ`, `ξ₂ = ±τ'₁ ∧ ⋯ ∧ τ'ₙ` of the same subspace `Q` differ by a
sign.  `τ` and `τ'` are orthonormal bases `b`, `b'` of `Q`; every alternating `n`-form on `Q` is a
multiple of `det_b`, so `α(τ') = det_b(b') α(τ)` for every `n`-covector `α`, and
`det_b(b') = ±1`, the change of orthonormal basis being orthogonal. -/
theorem Submission.dgcr_unitOrientation_eq_or_neg : ∀ (P n : ℕ) (Q : Submodule ℝ (Euclid P)) (ξ₁ ξ₂ : MultiVector P n), IsUnitOrientationOf ξ₁ Q → IsUnitOrientationOf ξ₂ Q → ξ₂ = ξ₁ ∨ ξ₂ = -ξ₁ := by
  rintro P n Q ξ₁ ξ₂ ⟨τ, hτ, hspan, h₁⟩ ⟨τ', hτ', hspan', h₂⟩
  -- an orthonormal frame spanning `Q` is an orthonormal basis of `Q`
  have frame : ∀ σ : Fin n → Euclid P, Orthonormal ℝ σ → Submodule.span ℝ (range σ) = Q →
      ∃ c : OrthonormalBasis (Fin n) ℝ Q, ∀ i, (c i : Euclid P) = σ i := by
    intro σ hσ hσspan
    have hmem : ∀ i, σ i ∈ Q := fun i => hσspan ▸ Submodule.subset_span (mem_range_self i)
    let u : Fin n → Q := fun i => ⟨σ i, hmem i⟩
    have hu : Orthonormal ℝ u := by
      rw [← Q.subtypeₗᵢ.orthonormal_comp_iff (v := u)]
      exact hσ
    have huspan : ⊤ ≤ Submodule.span ℝ (range u) := by
      rintro ⟨y, hy⟩ -
      rw [← hσspan, Submodule.mem_span_range_iff_exists_fun] at hy
      obtain ⟨c, hc⟩ := hy
      rw [Submodule.mem_span_range_iff_exists_fun]
      exact ⟨c, Subtype.ext (by simpa [u] using hc)⟩
    exact ⟨OrthonormalBasis.mk hu huspan, fun i => by simp [u]⟩
  obtain ⟨b, hb⟩ := frame τ hτ hspan
  obtain ⟨b', hb'⟩ := frame τ' hτ' hspan'
  -- `det_b(b') = ±1`
  have hd := b.det_to_matrix_orthonormalBasis_real b'
  -- `α(τ') = det_b(b') α(τ)`: the restriction `α_Q` of `α` to `Q` is `α_Q(b) det_b`
  have hτ'τ : ∀ α : Covector (Euclid P) n, α τ' = b.toBasis.det b' * α τ := by
    intro α
    let f : Q [⋀^Fin n]→ₗ[ℝ] ℝ := α.toAlternatingMap.compLinearMap Q.subtype
    have hf : ∀ (c : OrthonormalBasis (Fin n) ℝ Q) (σ : Fin n → Euclid P),
        (∀ i, (c i : Euclid P) = σ i) → f c = α σ := by
      intro c σ hc
      have hcσ : (fun i => Q.subtype (c i)) = σ := funext hc
      rw [AlternatingMap.compLinearMap_apply, hcσ, ContinuousAlternatingMap.coe_toAlternatingMap]
    have h := congrArg (fun g : Q [⋀^Fin n]→ₗ[ℝ] ℝ => g b') (f.eq_smul_basis_det b.toBasis)
    simp only [AlternatingMap.smul_apply, smul_eq_mul, OrthonormalBasis.coe_toBasis] at h
    rw [← hf b' τ' hb', h, hf b τ hb, mul_comm]
  -- `ξ₂ = ±ξ₁`
  rcases hd with hd | hd <;> rcases h₁ with h₁ | h₁ <;> rcases h₂ with h₂ | h₂
  · left; ext α; rw [h₂, h₁, hτ'τ, hd, one_mul]
  · right; ext α; rw [neg_apply, h₂, h₁, hτ'τ, hd, one_mul]
  · right; ext α; rw [neg_apply, h₂, h₁, hτ'τ, hd, one_mul, neg_neg]
  · left; ext α; rw [h₂, h₁, hτ'τ, hd, one_mul]
  · right; ext α; rw [neg_apply, h₂, h₁, hτ'τ, hd, neg_one_mul]
  · left; ext α; rw [h₂, h₁, hτ'τ, hd, neg_one_mul, neg_neg]
  · left; ext α; rw [h₂, h₁, hτ'τ, hd, neg_one_mul]
  · right; ext α; rw [neg_apply, h₂, h₁, hτ'τ, hd, neg_one_mul, neg_neg]
/-- **Normalized mollifier** (step 2 of the smooth-to-`C¹` test reduction): for `r > 0` there is
a `C^∞` function `ρ ≥ 0` on `ℝⁿ` with compact support in `B_r(0)` and `∫ ρ = 1`.  Take the
`ContDiffBump` `B` centred at `0` with `rIn = r/2`, `rOut = r`, so `support B = B_r(0)`; its
integral `I` is positive since `B ≥ 0` and `volume (B_r(0)) > 0`, and `ρ = I⁻¹ B`.  (Mathlib's
`ContDiffBump.normed` is outside the import closure, so the normalization is done by hand.) -/
theorem Submission.dgcr_stc_exists_normalized_mollifier : ∀ (n : ℕ) (r : ℝ), 0 < r → ∃ ρ : Euclid n → ℝ, ContDiff ℝ (⊤ : ℕ∞) ρ ∧ HasCompactSupport ρ ∧ (∀ x, 0 ≤ ρ x) ∧ ∫ x, ρ x = 1 ∧ support ρ ⊆ ball (0 : Euclid n) r := by
  intro n r hr
  -- the bump `B` with `rIn = r/2`, `rOut = r`
  let B : ContDiffBump (0 : Euclid n) := ⟨r / 2, r, half_pos hr, half_lt_self hr⟩
  have hBs : HasCompactSupport B := B.hasCompactSupport
  have hBi : Integrable B := B.continuous.integrable_of_hasCompactSupport hBs
  -- `I = ∫ B > 0`: `B ≥ 0` and `support B = B_r(0)` has positive measure
  have hI : 0 < ∫ x, B x := by
    rw [integral_pos_iff_support_of_nonneg (fun x => B.nonneg' x) hBi, B.support_eq]
    exact measure_ball_pos volume 0 hr
  refine ⟨fun x => (∫ y, B y)⁻¹ * B x, contDiff_const.mul B.contDiff, hBs.mul_left,
    fun x => mul_nonneg (inv_nonneg.2 hI.le) (B.nonneg' x), ?_, ?_⟩
  · rw [integral_const_mul, inv_mul_cancel₀ hI.ne']
  · exact (support_mul_subset_right _ _).trans B.support_eq.subset
/-- **An `L¹` pairing that vanishes on uniform approximants vanishes in the limit** (step 5 of the
extension from smooth to `C¹` tests in the graph-cycle regularity step of Simon 7.4.3).  Let
`K ⊆ ℝⁿ` be measurable, `G` integrable on `K` and `f` AE-strongly measurable with `|f| ≤ C` on `K`.
If for every `ε > 0` some AE-strongly measurable `g` with `|f − g| ≤ ε` on `K` has `∫_K G g = 0`,
then `∫_K G f = 0`: `|g| ≤ C + ε` on `K`, so both products are integrable on `K`, and
`|∫_K G f| = |∫_K G (f − g)| ≤ ε ∫_K |G|` for every `ε > 0`. -/
theorem Submission.dgcr_stc_setIntegral_mul_eq_zero_of_uniform_approx : ∀ (n : ℕ) (K : Set (Euclid n)) (G f : Euclid n → ℝ) (C : ℝ), MeasurableSet K → IntegrableOn G K volume → AEStronglyMeasurable f (volume.restrict K) → (∀ x ∈ K, |f x| ≤ C) → (∀ ε : ℝ, 0 < ε → ∃ g : Euclid n → ℝ, AEStronglyMeasurable g (volume.restrict K) ∧ (∀ x ∈ K, |f x - g x| ≤ ε) ∧ ∫ x in K, G x * g x = 0) → ∫ x in K, G x * f x = 0 := by
  intro n K G f C hK hG hf hfC happrox
  -- `M = ∫_K |G| ≥ 0`, and `G f` is integrable on `K` since `|f| ≤ C` on `K`.
  have hM : 0 ≤ ∫ x in K, |G x| := integral_nonneg fun x => abs_nonneg (G x)
  have hGf : Integrable (fun x => G x * f x) (volume.restrict K) :=
    Integrable.mul_bdd hG hf (ae_restrict_of_forall_mem hK fun x hx => hfC x hx)
  -- `|∫_K G f| ≤ ε M` for every `ε > 0`.
  have hbound : ∀ ε : ℝ, 0 < ε → |∫ x in K, G x * f x| ≤ ε * ∫ x in K, |G x| := by
    intro ε hε
    obtain ⟨g, hg, hfg, hGg⟩ := happrox ε hε
    -- `|g| ≤ |f| + |f − g| ≤ C + ε` on `K`, so `G g` is integrable on `K`.
    have hGg_int : Integrable (fun x => G x * g x) (volume.restrict K) :=
      Integrable.mul_bdd (c := C + ε) hG hg (ae_restrict_of_forall_mem hK fun x hx => by
        have h1 := abs_le.mp (hfC x hx)
        have h2 := abs_le.mp (hfg x hx)
        rw [Real.norm_eq_abs]
        exact abs_le.mpr ⟨by linarith [h1.1, h2.2], by linarith [h1.2, h2.1]⟩)
    -- `∫_K G f = ∫_K G f − ∫_K G g = ∫_K G (f − g)`.
    have heq : ∫ x in K, G x * f x = ∫ x in K, G x * (f x - g x) := by
      simp_rw [mul_sub]
      rw [integral_sub hGf hGg_int, hGg, sub_zero]
    -- `|G (f − g)| ≤ |G| ε` on `K`.
    rw [heq]
    calc |∫ x in K, G x * (f x - g x)| ≤ ∫ x in K, |G x| * ε :=
          norm_integral_le_of_norm_le ((Integrable.abs hG).mul_const ε)
            (ae_restrict_of_forall_mem hK fun x hx => by
              rw [Real.norm_eq_abs, abs_mul]
              exact mul_le_mul_of_nonneg_left (hfg x hx) (abs_nonneg _))
      _ = ε * ∫ x in K, |G x| := by rw [integral_mul_const, mul_comm]
  -- If `a = |∫_K G f| > 0`, then `ε = a / (2(M + 1))` gives `a ≤ a M / (2(M + 1)) < a`.
  by_contra hne
  set M := ∫ x in K, |G x|
  set a := |∫ x in K, G x * f x|
  have ha : 0 < a := abs_pos.mpr hne
  have hpos : 0 < 2 * (M + 1) := by linarith
  have h := hbound (a / (2 * (M + 1))) (div_pos ha hpos)
  rw [div_mul_eq_mul_div, le_div_iff₀ hpos] at h
  nlinarith
/-- **Support of a current equal to `m[[M]]` on an open set** (Simon 6.2.11; step 4 of the
support computation at regular points).  Let `G ⊆ U` be open, and let `T(ω) = m ∫_M ⟨ω, ξ⟩ dHⁿ`
for every test form `ω` with `spt ω ⊆ G`.  Then `spt T ∩ G ⊆ closure M`.  A point
`x ∈ G \ closure M` has a ball `B_ε(x) ⊆ G` missing `M`.  Every test form supported in
`W = B_{ε/2}(x)` vanishes on `M`, so `T` vanishes on `W`.  Since `closure W` is a compact subset
of `U`, `x ∈ W ⊆ zeroRegion T`. -/
theorem Submission.idtp_ccd_rps_support_subset_closure : ∀ (P n : ℕ) (U G M : Set (Euclid P)) (T : GeometricCurrentOn U n) (m : ℤ) (ξ : Euclid P → MultiVector P n), IsOpen G → G ⊆ U → (∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ G → T ω = m * ∫ x in M, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → T.support ∩ G ⊆ closure M := by
  intro P n U G M T m ξ hG hGU hrep x hx
  -- step 1: `x ∈ spt T ∩ G`, so `x ∉ zeroRegion T`; suppose `x ∉ closure M`
  obtain ⟨hxT, hxG⟩ := hx
  by_contra hxcl
  -- step 2: the open set `G \ closure M` contains a ball `B_ε(x)`, which misses `M`
  obtain ⟨ε, hε, hball⟩ :=
    Metric.isOpen_iff.1 (hG.inter isClosed_closure.isOpen_compl) x ⟨hxG, hxcl⟩
  -- step 3: `W = B_{ε/2}(x)` has `closure W ⊆ closedBall x (ε/2) ⊆ B_ε(x) ⊆ G ⊆ U`
  have hhalf : ball x (ε / 2) ⊆ ball x ε := ball_subset_ball (by linarith)
  have hclo : closure (ball x (ε / 2)) ⊆ ball x ε :=
    closure_ball_subset_closedBall.trans (closedBall_subset_ball (by linarith))
  -- step 5: `W` is one of the sets whose union is `zeroRegion T`, and `x ∈ W`
  apply hxT.2
  refine Set.mem_sUnion.2 ⟨ball x (ε / 2), ⟨isOpen_ball, ?_, ?_, ?_⟩, mem_ball_self (by linarith)⟩
  · exact (isCompact_closedBall x (ε / 2)).of_isClosed_subset isClosed_closure
      closure_ball_subset_closedBall
  · exact hclo.trans fun z hz => hGU (hball hz).1
  · -- step 4: `T` vanishes on `W`, as every test form supported in `W` vanishes on `M`
    intro ω hω
    rw [hrep ω (hω.trans (hhalf.trans fun z hz => (hball hz).1))]
    have h0 : ∫ z in M, ξ z ((ω : DifferentialForm (Euclid P) n) z) ∂μHE[n] = 0 := by
      apply setIntegral_eq_zero_of_forall_eq_zero
      intro z hzM
      have hz : z ∉ tsupport (ω : DifferentialForm (Euclid P) n) := fun hzt =>
        (hball (hhalf (hω hzt))).2 (subset_closure hzM)
      rw [image_eq_zero_of_notMem_tsupport hz, map_zero]
    rw [h0, mul_zero]

/-- **Simon Ch. 6, 2.11 and Ch. 7, 4.1**: if `T = m[[M]]` with `m ≠ 0` on an open `G ⊆ U`, where
`M` is an oriented embedded `C¹` submanifold and `Hⁿ(M ∩ K) < ∞` for compact `K ⊆ G`, then
`M ∩ G ⊆ spt T`.  Were `x ∈ M ∩ G` in an open `W` on which `T` vanishes, take `α` with
`ξ(x)(α) = 1` and a bump `g` at `x` with `tsupport g ⊆ W ∩ G` so small that `ξ(α) > 1/2` on `M`
there.  Then `0 = T(gα) = m ∫_M g ξ(α) dHⁿ`, yet the integrand is `≥ 0` and is `> 1/2` on
`M ∩ B_{ε/4}(x)`, which has positive `Hⁿ`-measure because `M` has density one at `x`. -/
theorem Submission.idtp_ccd_rps_submanifold_subset_support : ∀ (P n : ℕ) (U G M : Set (Euclid P)) (T : GeometricCurrentOn U n) (m : ℤ) (ξ : Euclid P → MultiVector P n), IsOpen G → G ⊆ U → m ≠ 0 → IsEmbeddedSubmanifold 1 n M → IsOrientation n M ξ → (∀ K : Set (Euclid P), IsCompact K → K ⊆ G → μHE[n] (M ∩ K) ≠ ∞) → (∀ ω : TestFormOn U n, tsupport (ω : DifferentialForm (Euclid P) n) ⊆ G → T ω = m * ∫ x in M, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) → M ∩ G ⊆ T.support := by
  intro P n U G M T m ξ hG hGU hm hM hξ hfin hrep x hx
  obtain ⟨hxM, hxG⟩ := hx
  refine ⟨hGU hxG, fun hxZ => ?_⟩
  obtain ⟨W, ⟨hWo, -, -, hWv⟩, hxW⟩ := Set.mem_sUnion.1 hxZ
  have hMmeas : MeasurableSet M := (Submission.dimred_rpd_embedded_locally_closed P 1 n M hM).1
  -- (a) a covector α with ξ(x)(α) = 1, and the bound ‖ξ(z)‖ ≤ 1 on M
  obtain ⟨Qx, -, hQx⟩ := hξ.2 x hxM
  have hξx := (Submission.imsupp_unit_orientation_ne_zero_norm_le_one P n (ξ x) Qx hQx).1
  obtain ⟨α₀, hα₀⟩ : ∃ α₀ : Covector (Euclid P) n, ξ x α₀ ≠ 0 := by
    by_contra h
    push Not at h
    exact hξx (ContinuousLinearMap.ext fun a => by simpa using h a)
  obtain ⟨α, hα⟩ : ∃ α : Covector (Euclid P) n, ξ x α = 1 :=
    ⟨(ξ x α₀)⁻¹ • α₀, by rw [map_smul, smul_eq_mul, inv_mul_cancel₀ hα₀]⟩
  have hnorm : ∀ z ∈ M, ‖ξ z‖ ≤ 1 := by
    intro z hz
    obtain ⟨Q, -, hQ⟩ := hξ.2 z hz
    exact (Submission.imsupp_unit_orientation_ne_zero_norm_le_one P n (ξ z) Q hQ).2
  -- (b) continuity of z ↦ ξ(z)(α) on M at x
  have hcont : ContinuousOn (fun z => ξ z α) M := hξ.1.clm_apply continuousOn_const
  obtain ⟨ε₁, hε₁, hε₁'⟩ := Metric.continuousWithinAt_iff.1 (hcont x hxM) (1 / 2) (by norm_num)
  have hhalf : ∀ z ∈ M, dist z x < ε₁ → 1 / 2 < ξ z α := by
    intro z hz hzx
    have h := hε₁' hz hzx
    rw [Real.dist_eq, hα] at h
    linarith [(abs_lt.1 h).1]
  -- (c) the radius ε
  obtain ⟨r, hr, hrWG⟩ := Metric.isOpen_iff.1 (hWo.inter hG) x ⟨hxW, hxG⟩
  set ε := min r ε₁ with hεdef
  have hε : 0 < ε := lt_min hr hε₁
  have hεr : ε ≤ r := min_le_left _ _
  have hεε₁ : ε ≤ ε₁ := min_le_right _ _
  have hcb : closedBall x (ε / 2) ⊆ W ∩ G :=
    (closedBall_subset_ball (by linarith)).trans ((ball_subset_ball hεr).trans hrWG)
  -- (d) the bump form ω = g·α
  let g : ContDiffBump x := ⟨ε / 4, ε / 2, by positivity, by linarith⟩
  let ω : DifferentialForm (Euclid P) n := fun z => g z • α
  have hωsmooth : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) ω := g.contDiff.smul contDiff_const
  have hωcpt : HasCompactSupport ω := g.hasCompactSupport.smul_right
  have hωts : tsupport ω ⊆ closedBall x (ε / 2) :=
    (tsupport_smul_subset_left (fun z => g z) (fun _ => α)).trans g.tsupport_eq.subset
  let ωU : TestFormOn U n :=
    ⟨ω, ⟨hωsmooth, hωcpt⟩, hωts.trans (hcb.trans fun z hz => hGU hz.2)⟩
  have hT0 : T ωU = 0 := hWv ωU (hωts.trans (hcb.trans inter_subset_left))
  have hTrep := hrep ωU (hωts.trans (hcb.trans inter_subset_right))
  -- (e) the integrand h(z) = g(z)·ξ(z)(α)
  have hval : ∀ z, ξ z ((ωU : DifferentialForm (Euclid P) n) z) = g z * ξ z α := by
    intro z
    show ξ z (g z • α) = g z * ξ z α
    rw [map_smul, smul_eq_mul]
  have hzero : ∀ z, z ∉ closedBall x (ε / 2) → g z = 0 := fun z hz =>
    image_eq_zero_of_notMem_tsupport (by rw [g.tsupport_eq]; exact hz)
  set μ : Measure (Euclid P) := μHE[n] with hμdef
  set h : Euclid P → ℝ := fun z => ξ z ((ωU : DifferentialForm (Euclid P) n) z) with hhdef
  have hcontOn : ContinuousOn h M := by
    have : ContinuousOn (fun z => g z * ξ z α) M := g.continuous.continuousOn.mul hcont
    exact this.congr fun z _ => hval z
  have hmeas : AEStronglyMeasurable h (μ.restrict M) := hcontOn.aestronglyMeasurable hMmeas
  have hfinK : μ (M ∩ closedBall x (ε / 2)) ≠ ∞ :=
    hfin _ (isCompact_closedBall _ _) (hcb.trans inter_subset_right)
  have hintK : IntegrableOn h (closedBall x (ε / 2)) (μ.restrict M) := by
    refine Measure.integrableOn_of_bounded (M := ‖α‖) ?_ hmeas ?_
    · rw [Measure.restrict_apply measurableSet_closedBall, inter_comm]
      exact hfinK
    · have hM' : ∀ᵐ z ∂(μ.restrict M), z ∈ M := ae_restrict_mem hMmeas
      refine ae_restrict_of_ae ?_
      filter_upwards [hM'] with z hz
      rw [hhdef]
      dsimp only
      rw [hval z, norm_mul]
      have h1 : ‖g z‖ ≤ 1 := by
        rw [Real.norm_eq_abs, abs_of_nonneg (g.nonneg)]
        exact g.le_one
      have h2 : ‖ξ z α‖ ≤ ‖α‖ :=
        ((ξ z).le_opNorm α).trans (by nlinarith [hnorm z hz, norm_nonneg α])
      nlinarith [norm_nonneg (g z), norm_nonneg (ξ z α)]
  have hint : Integrable h (μ.restrict M) :=
    hintK.integrable_of_forall_notMem_eq_zero fun z hz => by
      rw [hhdef]; dsimp only; rw [hval z, hzero z hz, zero_mul]
  have hnonneg : 0 ≤ᵐ[μ.restrict M] h := by
    filter_upwards [ae_restrict_mem hMmeas] with z hz
    show (0 : ℝ) ≤ h z
    rw [hhdef]; dsimp only; rw [hval z]
    by_cases hzb : z ∈ closedBall x (ε / 2)
    · have : 1 / 2 < ξ z α := hhalf z hz (by
        rw [mem_closedBall] at hzb; linarith)
      exact mul_nonneg g.nonneg (by linarith)
    · rw [hzero z hzb, zero_mul]
  -- (f) positive measure of M near x
  have hpos : 0 < μ (M ∩ ball x (ε / 4)) := by
    rw [pos_iff_ne_zero]
    intro h0
    have hlim := Submission.dimred_rpd_submanifold_density_one P n M x hM hxM
    have hev : (fun s : ℝ => μHE[n] (M ∩ ball x s) / (unitBallVolume n * ENNReal.ofReal (s ^ n)))
        =ᶠ[𝓝[>] 0] fun _ => 0 := by
      filter_upwards [Ioo_mem_nhdsGT (show (0 : ℝ) < ε / 4 by positivity)] with s hs
      have : μHE[n] (M ∩ ball x s) = 0 :=
        measure_mono_null (inter_subset_inter_right _ (ball_subset_ball hs.2.le)) h0
      rw [this, ENNReal.zero_div]
    exact one_ne_zero (tendsto_nhds_unique (hlim.congr' hev) tendsto_const_nhds)
  have hsupp : μ (M ∩ ball x (ε / 4)) ≤ (μ.restrict M) (support h) := by
    refine le_trans (measure_mono ?_) (Measure.le_restrict_apply _ _)
    rintro z ⟨hzM, hzb⟩
    refine ⟨?_, hzM⟩
    rw [mem_support, hhdef]; dsimp only; rw [hval z]
    have hg1 : g z = 1 := g.one_of_mem_closedBall (ball_subset_closedBall hzb)
    have : 1 / 2 < ξ z α := hhalf z hzM (by rw [mem_ball] at hzb; linarith)
    rw [hg1, one_mul]
    linarith
  have hIpos : 0 < ∫ z in M, h z ∂μ :=
    (integral_pos_iff_support_of_nonneg_ae hnonneg hint).2 (hpos.trans_le hsupp)
  -- (g) contradiction
  rw [hTrep] at hT0
  exact mul_ne_zero (Int.cast_ne_zero.2 hm) hIpos.ne' hT0

/-- **Simon 7.4.1 and 6.2.11: the support near a regular point.**  If `y ∈ reg T`, there are
`ρ > 0` with `B_ρ(y) ⊆ U` and an embedded `C¹` `n`-submanifold `M ∋ y`, of locally finite
`Hⁿ`-measure in `B_ρ(y)`, with `spt T ∩ B_ρ(y) = M ∩ B_ρ(y)`.  Unpack `T = m[[M]]` (`m ≠ 0`) on
`B_{ρ₀}(y)` and take `ρ = min(ρ₀, ε)`, where `M ∩ closedBall y ε` is compact.  In `B_ρ(y)`,
`spt T` lies in `closure M`, which there is contained in the closed set `M ∩ closedBall y ε`;
conversely `M ∩ B_{ρ₀}(y) ⊆ spt T` because `m ≠ 0`. -/
theorem Submission.idtp_ccd_regular_point_support : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (y : Euclid P), IsOpen U → y ∈ regularSet T → ∃ (ρ : ℝ) (M : Set (Euclid P)), 0 < ρ ∧ ball y ρ ⊆ U ∧ y ∈ M ∧ IsEmbeddedSubmanifold 1 n M ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ ball y ρ → μHE[n] (M ∩ K) ≠ ∞) ∧ T.support ∩ ball y ρ = M ∩ ball y ρ := by
  intro P n U T y _hU hy
  -- step 1: unpack `y ∈ reg T`: `T = m[[M]]` (`m ≠ 0`) for forms supported in `B_{ρ₀}(y) ⊆ U`
  obtain ⟨-, ρ₀, hρ₀, hball₀, m, M, ξ, hm, hyM, hM, hξ, hfin, hrep⟩ := hy
  -- step 2: `M ∩ closedBall y ε` is compact for some `ε > 0`
  obtain ⟨-, hloc⟩ := Submission.dimred_rpd_embedded_locally_closed P 1 n M hM
  obtain ⟨ε, hε, hcpt⟩ := hloc y hyM
  -- step 3: the radius `ρ = min(ρ₀, ε)`
  have hρ : 0 < min ρ₀ ε := lt_min hρ₀ hε
  have hsub₀ : ball y (min ρ₀ ε) ⊆ ball y ρ₀ := ball_subset_ball (min_le_left _ _)
  have hsubε : ball y (min ρ₀ ε) ⊆ ball y ε := ball_subset_ball (min_le_right _ _)
  refine ⟨min ρ₀ ε, M, hρ, hsub₀.trans hball₀, hyM, hM,
    fun K hK hKs => hfin K hK (hKs.trans hsub₀), ?_⟩
  apply Subset.antisymm
  · -- step 4: `spt T ∩ B_ρ(y) ⊆ closure M ∩ B_ε(y) ⊆ closure (M ∩ closedBall y ε) ⊆ M`
    rintro z ⟨hzT, hzb⟩
    have hzcl : z ∈ closure M :=
      Submission.idtp_ccd_rps_support_subset_closure P n U (ball y ρ₀) M T m ξ isOpen_ball
        hball₀ hrep ⟨hzT, hsub₀ hzb⟩
    have h2 := isOpen_ball.inter_closure (⟨hsubε hzb, hzcl⟩ : z ∈ ball y ε ∩ closure M)
    have h3 : z ∈ closure (M ∩ closedBall y ε) :=
      closure_mono (show ball y ε ∩ M ⊆ M ∩ closedBall y ε from
        fun x hx => ⟨hx.2, ball_subset_closedBall hx.1⟩) h2
    rw [hcpt.isClosed.closure_eq] at h3
    exact ⟨h3.1, hzb⟩
  · -- step 5: `M ∩ B_ρ(y) ⊆ M ∩ B_{ρ₀}(y) ⊆ spt T`
    rintro z ⟨hzM, hzb⟩
    exact ⟨Submission.idtp_ccd_rps_submanifold_subset_support P n U (ball y ρ₀) M T m ξ
      isOpen_ball hball₀ hm hM hξ hfin hrep ⟨hzM, hsub₀ hzb⟩, hzb⟩

/-- **Simon Ch. 6, 3.1 (‡)**: for an integer multiplicity triple `(M, θ, ξ)` in `U`, a compact
`K ⊆ U` and an `n`-covector `α`, the component `θ ⟨α, ξ⟩` is `Hⁿ`-integrable on `M ∩ K`.  `θ` is
locally `Hⁿ`-integrable, and `ξ` is `Hⁿ`-a.e. on `M` a unit orientation, so `‖ξ‖ ≤ 1` and
`|θ ⟨α, ξ⟩| ≤ θ ‖ξ‖ ‖α‖ ≤ ‖α‖ θ`, an integrable majorant on `M ∩ K`. -/
theorem Submission.lcn_mult_mul_orient_apply_integrableOn : ∀ (P n : ℕ) (U K : Set (Euclid P)) (R : IMRep U n), IsCompact K → K ⊆ U → ∀ α : Covector (Euclid P) n, IntegrableOn (fun x => (R.mult x : ℝ) * R.orient x α) (R.carrier ∩ K) μHE[n] := by
  intro P n U K R hK hKU α
  -- `μ := Hⁿ⌞(M ∩ K) ≤ Hⁿ⌞M`
  have hμ : μHE[n].restrict (R.carrier ∩ K) ≤ μHE[n].restrict R.carrier :=
    Measure.restrict_mono inter_subset_left le_rfl
  -- `θ` is `μ`-integrable, as `∫⁻_{M ∩ K} θ dHⁿ < ∞`; hence so is `‖α‖ θ`
  have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) := measurable_from_nat.comp R.measurable_mult
  have hmaj : Integrable (fun x => ‖α‖ * (R.mult x : ℝ)) (μHE[n].restrict (R.carrier ∩ K)) := by
    simpa using (integrable_toReal_of_lintegral_ne_top hθ.aemeasurable
      (R.locallyIntegrable_mult K hK hKU)).const_mul ‖α‖
  -- `‖ξ‖ ≤ 1` `Hⁿ⌞M`-a.e., hence `μ`-a.e.
  have hξ : ∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ K)), ‖R.orient x‖ ≤ 1 := by
    refine ae_mono hμ ?_
    filter_upwards [R.orients] with x hx
    obtain ⟨Q, -, hQ⟩ := hx
    exact (Submission.imsupp_unit_orientation_ne_zero_norm_le_one P n _ Q hQ).2
  -- `θ ⟨α, ξ⟩` is `μ`-a.e. strongly measurable: `ξ` is, and evaluation at `α` is continuous
  have hm : AEStronglyMeasurable (fun x => (R.mult x : ℝ) * R.orient x α)
      (μHE[n].restrict (R.carrier ∩ K)) := by
    have hξα : AEStronglyMeasurable (fun x => R.orient x α) (μHE[n].restrict (R.carrier ∩ K)) :=
      (ContinuousLinearMap.apply ℝ ℝ α).continuous.comp_aestronglyMeasurable
        (R.aestronglyMeasurable_orient.mono_measure hμ)
    exact (measurable_from_nat.comp R.measurable_mult).aestronglyMeasurable.mul hξα
  -- domination: `|θ ⟨α, ξ⟩| ≤ θ ‖ξ‖ ‖α‖ ≤ ‖α‖ θ` `μ`-a.e.
  refine hmaj.mono' hm ?_
  filter_upwards [hξ] with x hx
  rw [Real.norm_eq_abs, abs_mul, Nat.abs_cast]
  calc (R.mult x : ℝ) * |R.orient x α| ≤ (R.mult x : ℝ) * (‖R.orient x‖ * ‖α‖) := by
        gcongr
        exact (Real.norm_eq_abs _).symm.trans_le ((R.orient x).le_opNorm α)
    _ ≤ (R.mult x : ℝ) * (1 * ‖α‖) := by gcongr
    _ = ‖α‖ * R.mult x := by ring

/-- **Simon 6.2.11, 6.3.2(3)**: if `T = τ(M, θ, ξ)` vanishes on an open `W ⊂⊂ U`, then for every
`n`-covector `α`, `⟨α, ξ⟩ = 0` `Hⁿ`-a.e. on `M ∩ W`.  Let `ν = Hⁿ⌞(M ∩ closure W)`; then
`f = θ ⟨α, ξ⟩` is `ν`-integrable (`lcn_mult_mul_orient_apply_integrableOn`, `closure W` being a
compact subset of `U`).  For smooth `g` with compact support in `W`, `ω = g α` is a test form in
`U` supported in `W`, so `0 = T(ω) = ∫_M θ ⟨g α, ξ⟩ dHⁿ = ∫ g f dν` (`g = 0` off `W`).  The
fundamental lemma of the calculus of variations on `W` gives `f = 0` `ν`-a.e. on `W`; as
`Hⁿ⌞(M ∩ W) ≤ ν` and `θ > 0` on `M`, `⟨α, ξ⟩ = 0` `Hⁿ⌞(M ∩ W)`-a.e. -/
theorem Submission.lcn_orient_apply_ae_eq_zero_of_vanishesOn : ∀ (P n : ℕ) (U W : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), R.Represents T → IsOpen W → IsCompact (closure W) → closure W ⊆ U → T.VanishesOn W → ∀ α : Covector (Euclid P) n, ∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ W)), R.orient x α = 0 := by
  intro P n U W T R hRT hW hWc hWU hTW α
  -- `f = θ ⟨α, ξ⟩` is integrable for `ν = Hⁿ⌞(M ∩ closure W)`
  have hf : Integrable (fun x => (R.mult x : ℝ) * R.orient x α)
      (μHE[n].restrict (R.carrier ∩ closure W)) :=
    Submission.lcn_mult_mul_orient_apply_integrableOn P n U (closure W) R hWc hWU α
  -- fundamental lemma on the open set `W`: `f = 0` `ν`-a.e. on `W`
  have hae : ∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ closure W)), x ∈ W →
      (R.mult x : ℝ) * R.orient x α = 0 := by
    refine hW.ae_eq_zero_of_integral_contDiff_smul_eq_zero
      (hf.locallyIntegrable.locallyIntegrableOn W) fun g hg hgc hgW => ?_
    -- `ω = g α` is a test form in `U` supported in `W`, so `T(ω) = 0`
    have hωW : tsupport (fun x => g x • α) ⊆ W := (tsupport_smul_subset_left g _).trans hgW
    have hω : (fun x => g x • α) ∈ TestFormOn U n :=
      ⟨⟨hg.smul contDiff_const, hgc.smul_right⟩, hωW.trans (subset_closure.trans hWU)⟩
    calc ∫ x, g x • ((R.mult x : ℝ) * R.orient x α) ∂(μHE[n].restrict (R.carrier ∩ closure W))
        = ∫ x in R.carrier ∩ closure W, (R.mult x : ℝ) * R.orient x (g x • α) ∂μHE[n] := by
          congr 1
          funext x
          rw [map_smul, smul_eq_mul, smul_eq_mul]
          ring
      -- `g = 0` off `closure W`, so the integral over `M` is the integral over `M ∩ closure W`
      _ = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x (g x • α) ∂μHE[n] := by
          refine (setIntegral_eq_of_subset_of_forall_sdiff_eq_zero R.measurableSet_carrier
            inter_subset_left fun x hx => ?_).symm
          have hgx : g x = 0 :=
            image_eq_zero_of_notMem_tsupport fun h => hx.2 ⟨hx.1, subset_closure (hgW h)⟩
          rw [hgx, zero_smul, map_zero, mul_zero]
      _ = T ⟨_, hω⟩ := (hRT ⟨_, hω⟩).symm
      _ = 0 := hTW ⟨_, hω⟩ hωW
  -- pass to `Hⁿ⌞(M ∩ W) ≤ ν` and cancel `θ > 0` on `M`
  have hle : μHE[n].restrict (R.carrier ∩ W) ≤ μHE[n].restrict (R.carrier ∩ closure W) :=
    Measure.restrict_mono (inter_subset_inter_right _ subset_closure) le_rfl
  filter_upwards [ae_mono hle hae,
    ae_restrict_mem (R.measurableSet_carrier.inter hW.measurableSet)] with x hx hxMW
  have hθ : (R.mult x : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (R.mult_pos x hxMW.1).ne'
  exact (mul_eq_zero.mp (hx hxMW.2)).resolve_left hθ

/-- **Simon Ch. 6, 1.2 (p. 132)**: `Λⁿ(ℝᴾ)` is finite-dimensional.  An `n`-covector `α` is
determined by its values `α(e_{I(1)}, …, e_{I(n)})` on tuples of standard basis vectors
(alternating maps agreeing on distinct basis vectors are equal), so
`Φ α = (α(e ∘ I))_{I : Fin n → Fin P}` is an injective linear map into the finite-dimensional
space `ℝ^(Fin n → Fin P)`. -/
theorem Submission.lcn_covector_finiteDimensional : ∀ (P n : ℕ), FiniteDimensional ℝ (Covector (Euclid P) n) := by
  intro P n
  -- the standard basis `e` of `ℝᴾ`
  let e := (EuclideanSpace.basisFun (Fin P) ℝ).toBasis
  -- `Φ α = (α(e ∘ I))_I`, linear since addition and scaling of covectors are pointwise
  let Φ : Covector (Euclid P) n →ₗ[ℝ] ((Fin n → Fin P) → ℝ) :=
    { toFun := fun α I => α fun i => e (I i)
      map_add' := fun α β => rfl
      map_smul' := fun c α => rfl }
  -- `Φ α = Φ β` makes `α` and `β` agree on distinct basis vectors, hence everywhere
  refine FiniteDimensional.of_injective Φ fun α β h => ?_
  exact ContinuousAlternatingMap.toAlternatingMap_injective
    (e.ext_alternating fun v _ => congr_fun h v)

/-- **Simon 6.2.11, 6.3.2(3)**: if `T = τ(M, θ, ξ)` vanishes on an open `W ⊂⊂ U`, then
`Hⁿ(M ∩ W) = 0`.  `Λⁿ` is finite-dimensional (`lcn_covector_finiteDimensional`); for each `α` of
a basis, `⟨α, ξ⟩ = 0` `Hⁿ⌞(M ∩ W)`-a.e. (`lcn_orient_apply_ae_eq_zero_of_vanishesOn`), so
`ξ = 0` `Hⁿ⌞(M ∩ W)`-a.e.  But `ξ` is `Hⁿ`-a.e. on `M` a unit orientation, hence nonzero
(`imsupp_unit_orientation_ne_zero_norm_le_one`), so `Hⁿ⌞(M ∩ W) = 0`. -/
theorem Submission.imrep_carrier_inter_null_of_vanishesOn : ∀ (P n : ℕ) (U W : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), R.Represents T → IsOpen W → IsCompact (closure W) → closure W ⊆ U → T.VanishesOn W → μHE[n] (R.carrier ∩ W) = 0 := by
  intro P n U W T R hRT hW hWc hWU hTW
  -- a basis `α₁, …, α_N` of the finite-dimensional space `Λⁿ`
  have := Submission.lcn_covector_finiteDimensional P n
  let b := Module.finBasis ℝ (Covector (Euclid P) n)
  -- `⟨αₖ, ξ⟩ = 0` for every `k`, `Hⁿ⌞(M ∩ W)`-a.e.
  have h0 : ∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ W)), ∀ k, R.orient x (b k) = 0 :=
    ae_all_iff.mpr fun k =>
      Submission.lcn_orient_apply_ae_eq_zero_of_vanishesOn P n U W T R hRT hW hWc hWU hTW (b k)
  -- `ξ ≠ 0` `Hⁿ⌞M`-a.e., hence `Hⁿ⌞(M ∩ W)`-a.e.
  have h1 : ∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ W)), R.orient x ≠ 0 := by
    refine ae_mono (Measure.restrict_mono inter_subset_left le_rfl) ?_
    filter_upwards [R.orients] with x hx
    obtain ⟨Q, -, hQ⟩ := hx
    exact (Submission.imsupp_unit_orientation_ne_zero_norm_le_one P n _ Q hQ).1
  -- a functional on `Λⁿ` vanishing on a basis is zero, so `Hⁿ⌞(M ∩ W)`-a.e. `x` is impossible
  have h2 : ∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ W)), False := by
    filter_upwards [h0, h1] with x hx hne
    exact hne (ContinuousLinearMap.coe_injective (b.ext fun k => hx k))
  exact Measure.restrict_eq_zero.mp (ae_eq_bot.mp (eventually_false_iff_eq_bot.mp h2))

/-- **Simon 6.2.11, 6.3.2(3)**: if `T = τ(M, θ, ξ)` in `U`, then `Hⁿ(M ∖ spt T) = 0`, i.e.
`μ_T(U ∖ spt T) = 0`.  As `M ⊆ U` and `spt T = U ∖ Z`, `M ∖ spt T ⊆ M ∩ Z`, where the zero region
`Z = ⋃ 𝒲` is the union of the open `W ⊂⊂ U` on which `T` vanishes.  `ℝᴾ` is second countable, so
`Z = ⋃_{W ∈ 𝒮} W` for a countable `𝒮 ⊆ 𝒲`; each `Hⁿ(M ∩ W) = 0`
(`imrep_carrier_inter_null_of_vanishesOn`), and countable subadditivity concludes. -/
theorem Submission.imrep_carrier_sdiff_support_null : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), IsOpen U → R.Represents T → μHE[n] (R.carrier \ T.support) = 0 := by
  intro P n U T R _ hRT
  -- the zero region `Z = ⋃₀ 𝒲` is the union of a countable subfamily `𝒮 ⊆ 𝒲`
  obtain ⟨𝒮, h𝒮c, h𝒮W, h𝒮⟩ := TopologicalSpace.isOpen_sUnion_countable
    {W : Set (Euclid P) | IsOpen W ∧ IsCompact (closure W) ∧ closure W ⊆ U ∧ T.VanishesOn W}
    fun W hW => hW.1
  -- `M ∖ spt T ⊆ ⋃_{W ∈ 𝒮} M ∩ W`: a point of `M ⊆ U` outside `spt T = U ∖ Z` lies in `Z`
  have hsub : R.carrier \ T.support ⊆ ⋃ W ∈ 𝒮, R.carrier ∩ W := by
    rintro x ⟨hxM, hxS⟩
    have hxZ : x ∈ ⋃₀ 𝒮 := by
      rw [h𝒮]
      by_contra hxZ
      exact hxS (mem_sdiff_of_mem (R.carrier_subset hxM) hxZ)
    obtain ⟨W, hW, hxW⟩ := mem_sUnion.mp hxZ
    exact mem_biUnion hW ⟨hxM, hxW⟩
  -- `Hⁿ(M ∩ W) = 0` for each of the countably many `W ∈ 𝒮`
  refine measure_mono_null hsub ((measure_biUnion_null_iff h𝒮c).mpr fun W hW => ?_)
  obtain ⟨hWo, hWc, hWU, hTW⟩ := h𝒮W hW
  exact Submission.imrep_carrier_inter_null_of_vanishesOn P n U W T R hRT hWo hWc hWU hTW
/-- **Mass densities are unique** (Simon Ch. 1, 3.1, chapter-01.txt lines 562–598: `Θⁿ(μ, x)` is
the common value of the upper and lower densities, i.e. the limit of `(ωₙρⁿ)⁻¹μ(B_ρ(x))` as
`ρ ↓ 0`; used for `Θⁿ(μ_T, x)` in Ch. 7, 3.1, chapter-07.txt lines 302–310).  If
`HasMassDensity T x θ` and `HasMassDensity T x θ'`, the ratio `M_{B_ρ(x)}(T)/(ωₙρⁿ)` tends to both
`ofReal θ` and `ofReal θ'` along the nontrivial filter `𝓝[>] 0` in the Hausdorff space `[0, ∞]`,
so `ofReal θ = ofReal θ'`, and `θ, θ' ≥ 0` give `θ = θ'`. -/
theorem Submission.dimred_cs_mi_hasMassDensity_unique : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (x : Euclid P) (θ θ' : ℝ), HasMassDensity T x θ → HasMassDensity T x θ' → θ = θ' := by
  intro P n U T x θ θ' hθ hθ'
  -- Steps 1–2: `𝓝[>] 0` is nontrivial (`nhdsGT_neBot`) and `ℝ≥0∞` is Hausdorff, so the two
  -- limits of the density ratio coincide.
  have h : ENNReal.ofReal θ = ENNReal.ofReal θ' := tendsto_nhds_unique hθ.2 hθ'.2
  -- Step 3: `ENNReal.ofReal` is injective on `[0, ∞)`.
  exact (ENNReal.ofReal_eq_ofReal_iff hθ.1 hθ'.1).1 h
/-- **Upper density theorem** (Simon Ch. 1, 3.6 with Remark 3.7(2), via 3.3 with the crude
covering constant `6ⁿ`; chapter-01.txt lines 602–721).  If `μ` is finite on compact subsets of
`ℝᴾ` and `A ⊆ ℝᴾ` is Borel, then for `Hⁿ`-a.e. `x ∉ A`, `μ(A ∩ B_ρ(x)) / (ωₙ ρⁿ) → 0` as `ρ ↓ 0`.
Vitali's lemma (factor `2`, enlarged radius `3ρ`) and separability give `t · μH[n](E) ≤ 6ⁿ μ(G)`
whenever each `x ∈ E` has arbitrarily small `ρ` with `t ρⁿ ≤ μ(G ∩ B̄_ρ(x))`.  For Borel `S` with
`μ(S) < ∞`, taking `G = S \ F` for a closed `F ⊆ S` with `μ(S \ F)` small (weak regularity of
`μ⌞S`) makes every threshold set `{x ∉ S : μ(S ∩ B̄_ρ(x)) > t ρⁿ frequently as ρ ↓ 0}`
`μH[n]`-null, hence `Hⁿ`-null.  The general case applies this to `S = A ∩ B_j(0)`, which agrees
with `A` near `x` once `j > |x| + 1`. -/
theorem Submission.idtp_dema_upper_density_zero : ∀ (P n : ℕ) (μ : Measure (Euclid P)) (A : Set (Euclid P)), MeasurableSet A → (∀ K : Set (Euclid P), IsCompact K → μ K ≠ ∞) → ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)), x ∉ A → Tendsto (fun ρ : ℝ => μ (A ∩ ball x ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) (𝓝 0) := by
  intro P n μ A hA hfin
  -- Step 1, Vitali selection (Simon 1.3.4).
  have vitali : ∀ (E : Set (Euclid P)) (p : Euclid P → ℝ → Prop) (δ : ℝ),
      (∀ x ∈ E, ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ ∧ p x ρ) →
      ∃ u : Set (Euclid P × ℝ), u.Countable ∧ (∀ a ∈ u, a.1 ∈ E ∧ 0 < a.2 ∧ a.2 < δ ∧ p a.1 a.2) ∧
        u.PairwiseDisjoint (fun a => closedBall a.1 a.2) ∧
        E ⊆ ⋃ a ∈ u, closedBall a.1 (3 * a.2) := by
    intro E p δ hE
    obtain ⟨u, huT, hdisj, hcov⟩ := Vitali.exists_disjoint_subfamily_covering_enlargement
      (fun a : Euclid P × ℝ => closedBall a.1 a.2)
      {a : Euclid P × ℝ | a.1 ∈ E ∧ 0 < a.2 ∧ a.2 < δ ∧ p a.1 a.2} (fun a => a.2) 2 (by norm_num)
      (fun a ha => ha.2.1.le) δ (fun a ha => ha.2.2.1.le)
      (fun a ha => nonempty_closedBall.2 ha.2.1.le)
    refine ⟨u, ?_, fun a ha => huT ha, hdisj, ?_⟩
    · apply hdisj.countable_of_nonempty_interior
      intro a ha
      refine ⟨a.1, interior_mono ball_subset_closedBall ?_⟩
      rw [isOpen_ball.interior_eq]
      exact mem_ball_self (huT ha).2.1
    · intro x hx
      obtain ⟨ρ, hρ0, hρδ, hp⟩ := hE x hx
      obtain ⟨b, hbu, ⟨w, hw1, hw2⟩, hle⟩ := hcov (x, ρ) ⟨hx, hρ0, hρδ, hp⟩
      refine mem_iUnion₂.2 ⟨b, hbu, ?_⟩
      rw [mem_closedBall]
      have h1 : dist w x ≤ ρ := hw1
      have h2 : dist w b.1 ≤ b.2 := hw2
      have hle' : ρ ≤ 2 * b.2 := hle
      calc dist x b.1 ≤ dist x w + dist w b.1 := dist_triangle _ _ _
        _ ≤ ρ + b.2 := add_le_add (by rw [dist_comm]; exact h1) h2
        _ ≤ 3 * b.2 := by linarith
  -- Step 2, comparison (Simon 1.3.3 with the crude constant 6 ^ n).
  have comparison : ∀ (t : ℝ≥0∞) (E G : Set (Euclid P)), t ≠ 0 → t ≠ ∞ → MeasurableSet G →
      (∀ x ∈ E, ∀ δ : ℝ, 0 < δ → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ ∧
        t * ENNReal.ofReal ρ ^ n ≤ μ (G ∩ closedBall x ρ)) →
      t * μH[(n : ℝ)] E ≤ 6 ^ n * μ G := by
    intro t E G ht0 httop hG hE
    have hfam : ∀ j : ℕ, ∃ u : Set (Euclid P × ℝ), u.Countable ∧
        (∀ a ∈ u, a.1 ∈ E ∧ 0 < a.2 ∧ a.2 < 1 / ((j : ℝ) + 1) ∧
          t * ENNReal.ofReal a.2 ^ n ≤ μ (G ∩ closedBall a.1 a.2)) ∧
        u.PairwiseDisjoint (fun a => closedBall a.1 a.2) ∧
        E ⊆ ⋃ a ∈ u, closedBall a.1 (3 * a.2) :=
      fun j => vitali E (fun c ρ => t * ENNReal.ofReal ρ ^ n ≤ μ (G ∩ closedBall c ρ))
        (1 / ((j : ℝ) + 1)) (fun x hx => hE x hx _ (by positivity))
    choose u hucount hu hdisj hcover using hfam
    have : ∀ j, Countable (u j) := fun j => (hucount j).to_subtype
    have hsum : ∀ j, t * ∑' a : u j, ENNReal.ofReal (a : Euclid P × ℝ).2 ^ n ≤ μ G := by
      intro j
      rw [← ENNReal.tsum_mul_left]
      calc ∑' a : u j, t * ENNReal.ofReal (a : Euclid P × ℝ).2 ^ n
          ≤ ∑' a : u j, μ (G ∩ closedBall (a : Euclid P × ℝ).1 (a : Euclid P × ℝ).2) :=
            ENNReal.tsum_le_tsum fun a => (hu j a a.2).2.2.2
        _ = μ (⋃ a ∈ u j, G ∩ closedBall a.1 a.2) :=
            (measure_biUnion (hucount j) ((hdisj j).mono fun a => inter_subset_right)
              fun a _ => hG.inter measurableSet_closedBall).symm
        _ ≤ μ G := measure_mono (iUnion₂_subset fun a _ => inter_subset_left)
    have hdiam : ∀ j (a : u j), ediam (closedBall (a : Euclid P × ℝ).1 (3 * (a : Euclid P × ℝ).2))
        ≤ ENNReal.ofReal (6 * (a : Euclid P × ℝ).2) := by
      intro j a
      apply ediam_le_of_forall_dist_le
      intro y hy z hz
      rw [mem_closedBall] at hy hz
      calc dist y z ≤ dist y (a : Euclid P × ℝ).1 + dist z (a : Euclid P × ℝ).1 :=
            dist_triangle_right _ _ _
        _ ≤ 6 * (a : Euclid P × ℝ).2 := by linarith
    have hterm : ∀ j, t * ∑' a : u j,
        ediam (closedBall (a : Euclid P × ℝ).1 (3 * (a : Euclid P × ℝ).2)) ^ (n : ℝ) ≤
          6 ^ n * μ G := by
      intro j
      calc t * ∑' a : u j, ediam (closedBall (a : Euclid P × ℝ).1 (3 * (a : Euclid P × ℝ).2)) ^ (n : ℝ)
          ≤ t * ∑' a : u j, 6 ^ n * ENNReal.ofReal (a : Euclid P × ℝ).2 ^ n := by
            gcongr with a
            rw [ENNReal.rpow_natCast]
            calc ediam (closedBall (a : Euclid P × ℝ).1 (3 * (a : Euclid P × ℝ).2)) ^ n
                ≤ ENNReal.ofReal (6 * (a : Euclid P × ℝ).2) ^ n := by gcongr; exact hdiam j a
              _ = 6 ^ n * ENNReal.ofReal (a : Euclid P × ℝ).2 ^ n := by
                rw [ENNReal.ofReal_mul (show (0 : ℝ) ≤ 6 by norm_num), mul_pow]
                norm_num
        _ = 6 ^ n * (t * ∑' a : u j, ENNReal.ofReal (a : Euclid P × ℝ).2 ^ n) := by
            rw [ENNReal.tsum_mul_left]; ring
        _ ≤ 6 ^ n * μ G := by gcongr; exact hsum j
    have hH := MeasureTheory.Measure.hausdorffMeasure_le_liminf_tsum (X := Euclid P)
      (ι := fun j => (u j)) (n : ℝ) E (l := atTop)
      (fun j : ℕ => ENNReal.ofReal (6 * (1 / ((j : ℝ) + 1))))
      (by
        rw [← ENNReal.ofReal_zero]
        apply ENNReal.tendsto_ofReal
        have := tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)
        simpa using this.const_mul 6)
      (fun j a => closedBall (a : Euclid P × ℝ).1 (3 * (a : Euclid P × ℝ).2))
      (Eventually.of_forall fun j a => (hdiam j a).trans (ENNReal.ofReal_le_ofReal (by
        have := (hu j a a.2).2.2.1
        linarith)))
      (Eventually.of_forall fun j x hx => by
        obtain ⟨a, ha, hxa⟩ := mem_iUnion₂.1 (hcover j hx)
        exact mem_iUnion.2 ⟨⟨a, ha⟩, hxa⟩)
    have hbound : ∀ j, ∑' a : u j,
        ediam (closedBall (a : Euclid P × ℝ).1 (3 * (a : Euclid P × ℝ).2)) ^ (n : ℝ) ≤
          6 ^ n * μ G / t := by
      intro j
      rw [ENNReal.le_div_iff_mul_le (Or.inl ht0) (Or.inl httop), mul_comm]
      exact hterm j
    have hlim : μH[(n : ℝ)] E ≤ 6 ^ n * μ G / t :=
      hH.trans (liminf_le_of_frequently_le' (Frequently.of_forall hbound))
    calc t * μH[(n : ℝ)] E ≤ t * (6 ^ n * μ G / t) := by gcongr
      _ = 6 ^ n * μ G := ENNReal.mul_div_cancel ht0 httop
  -- Step 3, the finite case (Simon 1.3.6).
  have finite_case : ∀ S : Set (Euclid P), MeasurableSet S → μ S ≠ ∞ →
      ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)), x ∉ S →
        Tendsto (fun ρ : ℝ => μ (S ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n) (𝓝[>] 0) (𝓝 0) := by
    intro S hS hSfin
    have threshold : ∀ t : ℝ≥0∞, t ≠ 0 → t ≠ ∞ →
        μHE[n] {x : Euclid P | x ∉ S ∧ ∃ᶠ ρ in 𝓝[>] (0 : ℝ),
          t < μ (S ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n} = 0 := by
      intro t ht0 httop
      set N := {x : Euclid P | x ∉ S ∧ ∃ᶠ ρ in 𝓝[>] (0 : ℝ),
        t < μ (S ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n} with hN
      have key : ∀ ε : ℝ≥0∞, ε ≠ 0 → μH[(n : ℝ)] N < ε := by
        intro ε hε
        have : IsFiniteMeasure (μ.restrict S) :=
          ⟨by rw [Measure.restrict_apply_univ]; exact hSfin.lt_top⟩
        have : (μ.restrict S).WeaklyRegular :=
          Measure.WeaklyRegular.of_pseudoMetrizableSpace_of_isFiniteMeasure _
        have hpos : t * ε / 6 ^ n ≠ 0 := by
          apply ENNReal.div_ne_zero.2
          exact ⟨mul_ne_zero ht0 hε, ENNReal.pow_ne_top (by norm_num)⟩
        obtain ⟨F, hFS, hFc, hFlt⟩ := hS.exists_isClosed_sdiff_lt
          (μ := μ.restrict S)
          (by rw [Measure.restrict_apply hS, inter_self]; exact hSfin) hpos
        have hG : MeasurableSet (S \ F) := hS.diff hFc.measurableSet
        have hμG : μ (S \ F) < t * ε / 6 ^ n := by
          rwa [Measure.restrict_apply hG, inter_eq_left.2 sdiff_subset] at hFlt
        have hhyp : ∀ x ∈ N, ∀ δ : ℝ, 0 < δ → ∃ ρ : ℝ, 0 < ρ ∧ ρ < δ ∧
            t * ENNReal.ofReal ρ ^ n ≤ μ ((S \ F) ∩ closedBall x ρ) := by
          intro x hx δ hδ
          obtain ⟨hxS, hfreq⟩ := hx
          have hxF : x ∉ F := fun h => hxS (hFS h)
          obtain ⟨r₁, hr₁, hball⟩ := Metric.isOpen_iff.1 hFc.isOpen_compl x hxF
          have hev : ∀ᶠ ρ in 𝓝[>] (0 : ℝ), ρ ∈ Ioo 0 (min δ (r₁ / 2)) :=
            Ioo_mem_nhdsGT (by positivity)
          obtain ⟨ρ, hρq, hρ⟩ := (hfreq.and_eventually hev).exists
          refine ⟨ρ, hρ.1, lt_of_lt_of_le hρ.2 (min_le_left _ _), ?_⟩
          have hρpos : ENNReal.ofReal ρ ^ n ≠ 0 :=
            pow_ne_zero _ (ENNReal.ofReal_pos.2 hρ.1).ne'
          have hρtop : ENNReal.ofReal ρ ^ n ≠ ∞ := ENNReal.pow_ne_top ENNReal.ofReal_ne_top
          have h1 : t * ENNReal.ofReal ρ ^ n < μ (S ∩ closedBall x ρ) :=
            (ENNReal.lt_div_iff_mul_lt (Or.inl hρpos) (Or.inl hρtop)).1 hρq
          have h2 : S ∩ closedBall x ρ = (S \ F) ∩ closedBall x ρ := by
            ext y
            constructor
            · rintro ⟨hyS, hyB⟩
              refine ⟨⟨hyS, fun hyF => hball ?_ hyF⟩, hyB⟩
              rw [mem_ball]
              have := mem_closedBall.1 hyB
              have := hρ.2
              have := min_le_right δ (r₁ / 2)
              linarith
            · rintro ⟨⟨hyS, _⟩, hyB⟩
              exact ⟨hyS, hyB⟩
          rw [← h2]
          exact h1.le
        have hcomp := comparison t N (S \ F) ht0 httop hG hhyp
        have h6 : (6 : ℝ≥0∞) ^ n ≠ 0 := pow_ne_zero _ (by norm_num)
        have h6' : (6 : ℝ≥0∞) ^ n ≠ ∞ := ENNReal.pow_ne_top (by norm_num)
        have hlt : t * μH[(n : ℝ)] N < t * ε := by
          calc t * μH[(n : ℝ)] N ≤ 6 ^ n * μ (S \ F) := hcomp
            _ < 6 ^ n * (t * ε / 6 ^ n) := ENNReal.mul_lt_mul_right h6 h6' hμG
            _ = t * ε := ENNReal.mul_div_cancel h6 h6'
        exact (ENNReal.mul_lt_mul_iff_right ht0 httop).1 hlt
      have hH : μH[(n : ℝ)] N = 0 := by
        by_contra h
        exact lt_irrefl _ (key _ h)
      rw [Measure.euclideanHausdorffMeasure_def, Measure.smul_apply, hH, smul_zero]
    rw [ae_iff]
    apply measure_mono_null (t := ⋃ k : ℕ, {x : Euclid P | x ∉ S ∧ ∃ᶠ ρ in 𝓝[>] (0 : ℝ),
      ((k : ℝ≥0∞) + 1)⁻¹ < μ (S ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n})
    · intro x hx
      simp only [mem_ofPred_eq, Classical.not_imp] at hx
      obtain ⟨hxS, hnt⟩ := hx
      rw [ENNReal.tendsto_nhds_zero] at hnt
      push Not at hnt
      obtain ⟨ε, hε, hfreq⟩ := hnt
      obtain ⟨k, hk⟩ := ENNReal.exists_inv_nat_lt hε.ne'
      refine mem_iUnion.2 ⟨k, hxS, hfreq.mono fun ρ hρ => ?_⟩
      calc ((k : ℝ≥0∞) + 1)⁻¹ ≤ (k : ℝ≥0∞)⁻¹ := ENNReal.inv_le_inv.2 le_self_add
        _ < ε := hk
        _ < _ := hρ
    · exact measure_iUnion_null fun k => threshold _ (by simp) (by simp)
  -- Step 4, localization (Simon 1.3.7(2)).
  have hloc : ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)), ∀ j : ℕ, x ∉ A ∩ ball 0 j →
      Tendsto (fun ρ : ℝ => μ ((A ∩ ball 0 j) ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n)
        (𝓝[>] 0) (𝓝 0) :=
    ae_all_iff.2 fun j => finite_case _ (hA.inter measurableSet_ball)
      (ne_top_of_le_ne_top (hfin _ (isCompact_closedBall 0 j))
        (measure_mono (inter_subset_right.trans ball_subset_closedBall)))
  -- Step 0/5, normalization and open balls.
  have hω0 : unitBallVolume n ≠ 0 := (measure_ball_pos _ _ one_pos).ne'
  have hωtop : unitBallVolume n ≠ ∞ := measure_ball_lt_top.ne
  filter_upwards [hloc] with x hx hxA
  obtain ⟨j, hj⟩ := exists_nat_gt (‖x‖ + 1)
  have hcl := hx j (fun h => hxA h.1)
  have hlim : Tendsto (fun ρ : ℝ => (unitBallVolume n)⁻¹ *
      (μ ((A ∩ ball 0 j) ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n)) (𝓝[>] 0) (𝓝 0) := by
    simpa using ENNReal.Tendsto.const_mul hcl (Or.inr (ENNReal.inv_ne_top.2 hω0))
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hlim
    (Eventually.of_forall fun _ => zero_le) ?_
  have hev : ∀ᶠ ρ in 𝓝[>] (0 : ℝ), ρ ∈ Ioo 0 1 := Ioo_mem_nhdsGT one_pos
  filter_upwards [hev] with ρ hρ
  have hsub : A ∩ ball x ρ ⊆ (A ∩ ball 0 j) ∩ closedBall x ρ := by
    rintro y ⟨hyA, hyB⟩
    refine ⟨⟨hyA, ?_⟩, ball_subset_closedBall hyB⟩
    rw [mem_ball, dist_zero_right]
    have h1 : dist y x < ρ := hyB
    have h2 : ‖y‖ ≤ ‖x‖ + dist y x := by
      have := norm_le_norm_add_norm_sub' y x
      rw [dist_eq_norm]; linarith [norm_sub_rev y x]
    linarith [hρ.2]
  have hle : μ (A ∩ ball x ρ) ≤ μ ((A ∩ ball 0 j) ∩ closedBall x ρ) := measure_mono hsub
  calc μ (A ∩ ball x ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))
      = (unitBallVolume n)⁻¹ * (μ (A ∩ ball x ρ) / ENNReal.ofReal ρ ^ n) := by
        rw [ENNReal.ofReal_pow hρ.1.le, ENNReal.div_eq_inv_mul, ENNReal.div_eq_inv_mul,
          ENNReal.mul_inv (Or.inl hω0) (Or.inl hωtop), mul_assoc]
    _ ≤ (unitBallVolume n)⁻¹ * (μ ((A ∩ ball 0 j) ∩ closedBall x ρ) / ENNReal.ofReal ρ ^ n) := by
        gcongr
/-- An approximate tangent plane forces unit `Hⁿ`-density on closed balls (Simon Ch. 3,
Remark 1.5(3), with Definition 1.4).  If `Hⁿ(M ∩ B̄_s(x)) < ∞` and `Q` is an approximate tangent
space of `M` at `x`, then `Hⁿ(M ∩ B̄_ρ(x)) / (ωₙρⁿ) → 1` as `ρ ↓ 0`.  Since
`Hⁿ(η_{x,r}(M) ∩ B̄_1(0)) = r⁻ⁿHⁿ(M ∩ B̄_r(x))` and `Hⁿ(Q ∩ B̄_t(0)) = ωₙtⁿ`, the radial cut-offs
`g_{1-ε,1} ≤ 1_{B̄_1(0)} ≤ g_{1,1+ε}` in `C_c` squeeze `r⁻ⁿHⁿ(M ∩ B̄_r(x))` between blow-up integrals
whose limits lie within `ωₙ(1 ∓ ε)ⁿ`. -/
theorem Submission.rsd_tendsto_closedBall_density_of_approxTangent : ∀ (P n : ℕ) (M : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)) (s : ℝ), 0 < s → μHE[n] (M ∩ closedBall x s) ≠ ∞ → HasApproximateTangentSpaceAt n M x Q → Tendsto (fun ρ : ℝ => μHE[n] (M ∩ closedBall x ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) (𝓝 1) := by
  intro P n M x Q s hs hfin hT
  obtain ⟨hQ, hconv⟩ := hT
  -- Step 1: `ωₙ ∈ (0, ∞)`
  set ω := unitBallVolume n with hωdef
  have hω0 : ω ≠ 0 := (measure_ball_pos volume (0 : Euclid n) one_pos).ne'
  have hωtop : ω ≠ ∞ := measure_ball_lt_top.ne
  set w := ω.toReal with hwdef
  have hw : 0 < w := ENNReal.toReal_pos hω0 hωtop
  -- Step 2: `Hⁿ(Q ∩ B̄_t(0)) = ωₙ tⁿ`, via a linear isometry `ℝⁿ ≅ Q`
  have hplane0 : ∀ t : ℝ, 0 ≤ t →
      μHE[n] ((Q : Set (Euclid P)) ∩ closedBall 0 t) = ω * ENNReal.ofReal (t ^ n) := by
    intro t ht
    let b : OrthonormalBasis (Fin n) ℝ Q := (stdOrthonormalBasis ℝ Q).reindex (finCongr hQ)
    let ι : Euclid n →ₗᵢ[ℝ] Euclid P := Q.subtypeₗᵢ.comp b.repr.symm.toLinearIsometry
    have himage : ι '' closedBall 0 t = (Q : Set (Euclid P)) ∩ closedBall 0 t := by
      ext y
      constructor
      · rintro ⟨v, hv, rfl⟩
        refine ⟨(b.repr.symm v).2, ?_⟩
        rw [mem_closedBall, dist_zero_right] at hv ⊢
        have : ‖((b.repr.symm v : Q) : Euclid P)‖ = ‖v‖ := b.repr.symm.norm_map v
        simpa [ι, this] using hv
      · rintro ⟨hyQ, hy⟩
        refine ⟨b.repr ⟨y, hyQ⟩, ?_, ?_⟩
        · rw [mem_closedBall, dist_zero_right] at hy ⊢
          simpa using hy
        · simp [ι]
    rw [← himage, ι.isometry.euclideanHausdorffMeasure_image,
      EuclideanSpace.euclideanHausdorffMeasure_eq_volume,
      Measure.addHaar_closedBall _ _ ht, finrank_euclideanSpace_fin, hωdef, unitBallVolume, mul_comm]
  -- Step 3: scaling `Hⁿ(η_{x,r}(A)) = r⁻ⁿ Hⁿ(A)` and `η_{x,r}(M) ∩ B̄_t(0) = η_{x,r}(M ∩ B̄_{tr}(x))`
  have hscale : ∀ r : ℝ, 0 < r → ∀ A : Set (Euclid P),
      μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' A) = ENNReal.ofReal (r⁻¹ ^ n) * μHE[n] A := by
    intro r hr A
    have h1 : Poincare.SimonGMT.Chapter03.blowUpMap x r '' A =
        (fun y => r⁻¹ • y) '' ((fun y => y - x) '' A) := by
      rw [image_image]
      rfl
    have hiso : Isometry (fun y : Euclid P => y - x) :=
      Isometry.of_dist_eq (fun a c => by simp [dist_eq_norm])
    rw [h1, Set.image_smul, Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hr.ne'),
      hiso.euclideanHausdorffMeasure_image, ENNReal.smul_def, smul_eq_mul]
    congr 1
    rw [← ENNReal.ofReal_coe_nnreal]
    congr 1
    simp [abs_of_pos hr]
  have himg : ∀ r : ℝ, 0 < r → ∀ t : ℝ,
      Poincare.SimonGMT.Chapter03.blowUpMap x r '' M ∩ closedBall 0 t =
        Poincare.SimonGMT.Chapter03.blowUpMap x r '' (M ∩ closedBall x (t * r)) := by
    intro r hr t
    have key : ∀ z : Euclid P,
        ‖Poincare.SimonGMT.Chapter03.blowUpMap x r z‖ ≤ t ↔ dist z x ≤ t * r := by
      intro z
      simp only [Poincare.SimonGMT.Chapter03.blowUpMap, norm_smul, Real.norm_eq_abs, abs_inv,
        abs_of_pos hr, dist_eq_norm]
      rw [inv_mul_le_iff₀ hr, mul_comm r t]
    ext y
    constructor
    · rintro ⟨⟨z, hz, rfl⟩, hy⟩
      rw [mem_closedBall, dist_zero_right, key] at hy
      exact ⟨z, ⟨hz, hy⟩, rfl⟩
    · rintro ⟨z, ⟨hz, hzb⟩, rfl⟩
      refine ⟨⟨z, hz, rfl⟩, ?_⟩
      rw [mem_closedBall, dist_zero_right, key]
      exact hzb
  have hνball : ∀ r : ℝ, 0 < r → ∀ t : ℝ,
      (μHE[n].restrict (Poincare.SimonGMT.Chapter03.blowUpMap x r '' M)) (closedBall 0 t) =
        ENNReal.ofReal (r⁻¹ ^ n) * μHE[n] (M ∩ closedBall x (t * r)) := by
    intro r hr t
    rw [Measure.restrict_apply measurableSet_closedBall, inter_comm, himg r hr t, hscale r hr]
  have hmfin : ∀ r : ℝ, r ≤ s → μHE[n] (M ∩ closedBall x r) ≠ ∞ := fun r hr =>
    ne_top_of_le_ne_top hfin (measure_mono (inter_subset_inter_right _ (closedBall_subset_closedBall hr)))
  have hνfin : ∀ r : ℝ, 0 < r → ∀ t : ℝ, t * r ≤ s →
      (μHE[n].restrict (Poincare.SimonGMT.Chapter03.blowUpMap x r '' M)) (closedBall 0 t) ≠ ∞ := by
    intro r hr t ht
    rw [hνball r hr t]
    exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top (hmfin _ ht)
  -- Step 4: radial cut-off functions `g_{a,b}` in `C_c`
  have hbump : ∀ a b : ℝ, 0 < a → a < b →
      ∃ f : CompactlySupportedContinuousMap (Euclid P) ℝ, Continuous f ∧ (0 ≤ ⇑f) ∧
        (closedBall (0 : Euclid P) a).indicator 1 ≤ ⇑f ∧ ⇑f ≤ (closedBall (0 : Euclid P) b).indicator 1 := by
    intro a b ha hab
    have hcont : Continuous (fun y : Euclid P => max 0 (min 1 ((b - ‖y‖) / (b - a)))) :=
      continuous_const.max (continuous_const.min ((continuous_const.sub continuous_norm).div_const _))
    have hzero : ∀ y : Euclid P, b ≤ ‖y‖ → max 0 (min 1 ((b - ‖y‖) / (b - a))) = 0 := by
      intro y hy
      have h1 : (b - ‖y‖) / (b - a) ≤ 0 := div_nonpos_of_nonpos_of_nonneg (by linarith) (by linarith)
      rw [max_eq_left ((min_le_right _ _).trans h1)]
    let f : CompactlySupportedContinuousMap (Euclid P) ℝ :=
      { toFun := fun y => max 0 (min 1 ((b - ‖y‖) / (b - a)))
        continuous_toFun := hcont
        hasCompactSupport' := by
          refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid P) b) ?_
          intro y hy
          rw [mem_closedBall, dist_zero_right, not_le] at hy
          exact hzero y hy.le }
    have hf : ∀ y, f y = max 0 (min 1 ((b - ‖y‖) / (b - a))) := fun y => rfl
    refine ⟨f, f.continuous, fun y => by rw [hf]; exact le_max_left _ _, ?_, ?_⟩
    · intro y
      by_cases hy : y ∈ closedBall (0 : Euclid P) a
      · rw [indicator_of_mem hy, Pi.one_apply, hf]
        rw [mem_closedBall, dist_zero_right] at hy
        have : 1 ≤ (b - ‖y‖) / (b - a) := by
          rw [le_div_iff₀ (by linarith)]; linarith
        rw [min_eq_left this, max_eq_right zero_le_one]
      · rw [indicator_of_notMem hy, hf]; exact le_max_left _ _
    · intro y
      by_cases hy : y ∈ closedBall (0 : Euclid P) b
      · rw [indicator_of_mem hy, Pi.one_apply, hf]
        exact max_le zero_le_one (min_le_left _ _)
      · rw [indicator_of_notMem hy, hf, hzero]
        rw [mem_closedBall, dist_zero_right, not_le] at hy
        exact hy.le
  -- Step 5: integrability of functions dominated by the indicator of a finite-measure closed ball
  have hindint : ∀ (ν : Measure (Euclid P)) (t : ℝ), ν (closedBall 0 t) ≠ ∞ →
      Integrable ((closedBall (0 : Euclid P) t).indicator (1 : Euclid P → ℝ)) ν := fun ν t h =>
    (integrable_indicator_iff measurableSet_closedBall).2 (integrableOn_const h)
  have hdomint : ∀ (ν : Measure (Euclid P)) (f : Euclid P → ℝ) (t : ℝ), Continuous f →
      ν (closedBall 0 t) ≠ ∞ → 0 ≤ f → f ≤ (closedBall (0 : Euclid P) t).indicator 1 →
      Integrable f ν := by
    intro ν f t hf hfin' h0 hle
    refine (hindint ν t hfin').mono' hf.aestronglyMeasurable (Eventually.of_forall fun y => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (h0 y)]
    exact hle y
  -- Step 6: the normalised mass `a(r) = r⁻ⁿ Hⁿ(M ∩ B̄_r(x))` and the plane-ball values
  set a : ℝ → ℝ := fun r => (r⁻¹) ^ n * (μHE[n] (M ∩ closedBall x r)).toReal with hadef
  have hareal : ∀ r : ℝ, 0 < r →
      (μHE[n].restrict (Poincare.SimonGMT.Chapter03.blowUpMap x r '' M)).real (closedBall 0 1) = a r := by
    intro r hr
    rw [measureReal_def, hνball r hr 1, one_mul, ENNReal.toReal_mul,
      ENNReal.toReal_ofReal (by positivity)]
  have hplane : ∀ t : ℝ, 0 ≤ t →
      (μHE[n].restrict (Q : Set (Euclid P))) (closedBall 0 t) = ω * ENNReal.ofReal (t ^ n) := by
    intro t ht
    rw [Measure.restrict_apply measurableSet_closedBall, inter_comm, hplane0 t ht]
  have hplanefin : ∀ t : ℝ, 0 ≤ t → (μHE[n].restrict (Q : Set (Euclid P))) (closedBall 0 t) ≠ ∞ := by
    intro t ht
    rw [hplane t ht]
    exact ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top
  have hplanereal : ∀ t : ℝ, 0 ≤ t →
      (μHE[n].restrict (Q : Set (Euclid P))).real (closedBall 0 t) = w * t ^ n := by
    intro t ht
    rw [measureReal_def, hplane t ht, ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity)]
  -- Step 7: `a r → ωₙ`
  have ha : Tendsto a (𝓝[>] 0) (𝓝 w) := by
    rw [tendsto_order]
    constructor
    · intro c hc
      have hcont : Tendsto (fun ε : ℝ => w * (1 - ε) ^ n) (𝓝[>] 0) (𝓝 w) := by
        have : Continuous (fun ε : ℝ => w * (1 - ε) ^ n) := by fun_prop
        simpa using (this.tendsto 0).mono_left nhdsWithin_le_nhds
      obtain ⟨ε, hcε, hε⟩ :=
        ((hcont.eventually (lt_mem_nhds hc)).and (Ioo_mem_nhdsGT one_pos)).exists
      obtain ⟨f, hfc, hf0, hfge, hfle⟩ := hbump (1 - ε) 1 (by linarith [hε.2]) (by linarith [hε.1])
      -- `∫_Q f ≥ ωₙ (1-ε)ⁿ`
      have hQ1 : w * (1 - ε) ^ n ≤ ∫ y in (Q : Set (Euclid P)), f y ∂μHE[n] := by
        rw [← hplanereal (1 - ε) (by linarith [hε.2]), ← integral_indicator_one measurableSet_closedBall]
        exact integral_mono (hindint _ _ (hplanefin _ (by linarith [hε.2])))
          (hdomint _ _ 1 hfc (hplanefin _ zero_le_one) hf0 hfle) hfge
      filter_upwards [(tendsto_order.1 (hconv f)).1 c (hcε.trans_le hQ1),
        Ioc_mem_nhdsGT (half_pos hs)] with r hr1 hr2
      -- `∫_{η(M)} f ≤ a r`
      have h1 : (1 : ℝ) * r ≤ s := by linarith [hr2.2]
      have hle : ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, f y ∂μHE[n] ≤ a r := by
        rw [← hareal r hr2.1, ← integral_indicator_one measurableSet_closedBall]
        exact integral_mono (hdomint _ _ 1 hfc (hνfin r hr2.1 1 h1) hf0 hfle)
          (hindint _ _ (hνfin r hr2.1 1 h1)) hfle
      exact hr1.trans_le hle
    · intro c hc
      have hcont : Tendsto (fun ε : ℝ => w * (1 + ε) ^ n) (𝓝[>] 0) (𝓝 w) := by
        have : Continuous (fun ε : ℝ => w * (1 + ε) ^ n) := by fun_prop
        simpa using (this.tendsto 0).mono_left nhdsWithin_le_nhds
      obtain ⟨ε, hcε, hε⟩ :=
        ((hcont.eventually (gt_mem_nhds hc)).and (Ioo_mem_nhdsGT one_pos)).exists
      obtain ⟨f, hfc, hf0, hfge, hfle⟩ := hbump 1 (1 + ε) one_pos (by linarith [hε.1])
      -- `∫_Q f ≤ ωₙ (1+ε)ⁿ`
      have hQ2 : ∫ y in (Q : Set (Euclid P)), f y ∂μHE[n] ≤ w * (1 + ε) ^ n := by
        rw [← hplanereal (1 + ε) (by linarith [hε.1]), ← integral_indicator_one measurableSet_closedBall]
        exact integral_mono (hdomint _ _ (1 + ε) hfc (hplanefin _ (by linarith [hε.1])) hf0 hfle)
          (hindint _ _ (hplanefin _ (by linarith [hε.1]))) hfle
      filter_upwards [(tendsto_order.1 (hconv f)).2 c (hQ2.trans_lt hcε),
        Ioc_mem_nhdsGT (half_pos hs)] with r hr1 hr2
      -- `a r ≤ ∫_{η(M)} f`
      have h1 : (1 : ℝ) * r ≤ s := by linarith [hr2.2]
      have h2 : (1 + ε) * r ≤ s := by nlinarith [hr2.1, hr2.2, hε.2]
      have hge : a r ≤ ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, f y ∂μHE[n] := by
        rw [← hareal r hr2.1, ← integral_indicator_one measurableSet_closedBall]
        exact integral_mono (hindint _ _ (hνfin r hr2.1 1 h1))
          (hdomint _ _ (1 + ε) hfc (hνfin r hr2.1 _ h2) hf0 hfle) hfge
      exact hge.trans_lt hr1
  -- Step 8: back to the `ℝ≥0∞` quotient
  have hconvert : ∀ ρ : ℝ, 0 < ρ → ρ ≤ s →
      μHE[n] (M ∩ closedBall x ρ) / (ω * ENNReal.ofReal (ρ ^ n)) = ENNReal.ofReal (a ρ / w) := by
    intro ρ hρ hρs
    have hρn : 0 < ρ ^ n := pow_pos hρ n
    rw [← ENNReal.ofReal_toReal (hmfin ρ hρs), ← ENNReal.ofReal_toReal hωtop,
      ← ENNReal.ofReal_mul ENNReal.toReal_nonneg,
      ← ENNReal.ofReal_div_of_pos (mul_pos hw hρn)]
    congr 1
    simp only [hadef, inv_pow]
    field_simp
  have hlim : Tendsto (fun ρ : ℝ => ENNReal.ofReal (a ρ / w)) (𝓝[>] 0) (𝓝 1) := by
    have := ENNReal.tendsto_ofReal (ha.div_const w)
    rwa [div_self hw.ne', ENNReal.ofReal_one] at this
  refine hlim.congr' ?_
  filter_upwards [Ioc_mem_nhdsGT hs] with ρ hρ
  exact (hconvert ρ hρ.1 hρ.2).symm
/-- **Simon Ch. 1, 3.16–3.17 with 3.11(3)**, localized to an open `U`: if `μ` and
`ν = μ.withDensity θ` (`θ` Borel) are finite on compact subsets of `U`, then
`ν(B̄_ρ(x))/μ(B̄_ρ(x)) → θ(x)` as `ρ ↓ 0` for `μ`-a.e. `x ∈ U`.  Besicovitch differentiation
(`Besicovitch.ae_tendsto_rnDeriv`, `Measure.rnDeriv_withDensity`) is applied to `μ⌞Kⱼ` and
`ν⌞Kⱼ = (μ⌞Kⱼ).withDensity θ` for the compact exhaustion
`Kⱼ = B̄_{j+1}(0) ∩ {y : dist(y, z) ≥ 1/(j+1) for all z ∉ U}` of `U`; each `x ∈ U` has
`B_{1/(j+1)}(x) ⊆ Kⱼ` for some `j`, and there the localized ball ratios are the global ones. -/
theorem Submission.rsd_ae_tendsto_withDensity_div_closedBall : ∀ (P : ℕ) (U : Set (Euclid P)) (μ : Measure (Euclid P)) (θ : Euclid P → ℝ≥0∞), IsOpen U → Measurable θ → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K ≠ ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ.withDensity θ K ≠ ∞) → ∀ᵐ x ∂μ, x ∈ U → Tendsto (fun ρ : ℝ => μ.withDensity θ (closedBall x ρ) / μ (closedBall x ρ)) (𝓝[>] 0) (𝓝 (θ x)) := by
  intro P U μ θ hU hθ hμK hνK
  -- the compact exhaustion `K j`
  set K : ℕ → Set (Euclid P) := fun j =>
    closedBall 0 ((j : ℝ) + 1) ∩ {y | ∀ z ∉ U, 1 / ((j : ℝ) + 1) ≤ dist y z} with hKdef
  have hKclosed' : ∀ j : ℕ, IsClosed {y : Euclid P | ∀ z ∉ U, 1 / ((j : ℝ) + 1) ≤ dist y z} := by
    intro j
    have : {y : Euclid P | ∀ z ∉ U, 1 / ((j : ℝ) + 1) ≤ dist y z} =
        ⋂ z ∈ Uᶜ, {y | 1 / ((j : ℝ) + 1) ≤ dist y z} := by
      ext y; simp
    rw [this]
    exact isClosed_biInter fun z _ => isClosed_le continuous_const (continuous_id.dist continuous_const)
  have hKclosed : ∀ j, IsClosed (K j) := fun j => isClosed_closedBall.inter (hKclosed' j)
  have hKcpt : ∀ j, IsCompact (K j) := fun j =>
    (isCompact_closedBall (0 : Euclid P) _).inter_right (hKclosed' j)
  have hKU : ∀ j, K j ⊆ U := by
    intro j y hy
    by_contra hyU
    have h := hy.2 y hyU
    rw [dist_self] at h
    have : (0 : ℝ) < 1 / ((j : ℝ) + 1) := by positivity
    linarith
  have hcover : ∀ x ∈ U, ∃ j : ℕ, ball x (1 / ((j : ℝ) + 1)) ⊆ K j := by
    intro x hx
    obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.1 hU x hx
    obtain ⟨j, hj⟩ := exists_nat_gt (max (2 / δ) ‖x‖)
    have hj1 : 2 / δ < (j : ℝ) + 1 := by
      have := le_max_left (2 / δ) ‖x‖; linarith
    have hj2 : ‖x‖ < (j : ℝ) := lt_of_le_of_lt (le_max_right _ _) hj
    have hjpos : (0 : ℝ) < (j : ℝ) + 1 := by positivity
    have hsmall : 2 / ((j : ℝ) + 1) < δ := by
      rw [div_lt_iff₀ hjpos]
      rw [div_lt_iff₀ hδ] at hj1
      linarith
    refine ⟨j, fun y hy => ⟨?_, ?_⟩⟩
    · rw [mem_closedBall, dist_zero_right]
      have h1 : ‖y‖ ≤ ‖x‖ + dist y x := by
        have := norm_le_norm_add_norm_sub' y x
        rw [dist_eq_norm]; linarith [norm_sub_rev y x]
      have h2 : dist y x < 1 / ((j : ℝ) + 1) := hy
      have h3 : 1 / ((j : ℝ) + 1) ≤ 1 := by
        rw [div_le_one hjpos]; linarith [(Nat.cast_nonneg j : (0 : ℝ) ≤ j)]
      linarith
    · intro z hz
      have hxz : δ ≤ dist x z := by
        by_contra h
        exact hz (hball (by rw [mem_ball, dist_comm]; linarith))
      have h2 : dist y x < 1 / ((j : ℝ) + 1) := hy
      have htri := dist_triangle x y z
      have h4 : 2 / ((j : ℝ) + 1) = 2 * (1 / ((j : ℝ) + 1)) := by ring
      rw [dist_comm] at h2
      linarith
  -- Besicovitch on each `K j`
  have hj : ∀ j : ℕ, ∀ᵐ x ∂μ, x ∈ K j → Tendsto (fun ρ : ℝ =>
      ((μ.withDensity θ).restrict (K j)) (closedBall x ρ) / (μ.restrict (K j)) (closedBall x ρ))
      (𝓝[>] 0) (𝓝 (θ x)) := by
    intro j
    have hKm : MeasurableSet (K j) := (hKclosed j).measurableSet
    have : IsFiniteMeasure (μ.restrict (K j)) :=
      ⟨by rw [Measure.restrict_apply_univ]; exact (hμK _ (hKcpt j) (hKU j)).lt_top⟩
    have : IsFiniteMeasure ((μ.withDensity θ).restrict (K j)) :=
      ⟨by rw [Measure.restrict_apply_univ]; exact (hνK _ (hKcpt j) (hKU j)).lt_top⟩
    have h1 := Besicovitch.ae_tendsto_rnDeriv ((μ.withDensity θ).restrict (K j)) (μ.restrict (K j))
    have h2 := Measure.rnDeriv_withDensity (μ.restrict (K j)) hθ
    rw [← restrict_withDensity hKm] at h2
    have h3 : ∀ᵐ x ∂(μ.restrict (K j)), Tendsto (fun ρ : ℝ =>
        ((μ.withDensity θ).restrict (K j)) (closedBall x ρ) / (μ.restrict (K j)) (closedBall x ρ))
        (𝓝[>] 0) (𝓝 (θ x)) := by
      filter_upwards [h1, h2] with x hx1 hx2
      rwa [hx2] at hx1
    exact (ae_restrict_iff' hKm).1 h3
  filter_upwards [ae_all_iff.2 hj] with x hx hxU
  obtain ⟨j, hjK⟩ := hcover x hxU
  have hr : (0 : ℝ) < 1 / ((j : ℝ) + 1) := by positivity
  have hxK : x ∈ K j := hjK (mem_ball_self hr)
  refine (hx j hxK).congr' ?_
  filter_upwards [Ioo_mem_nhdsGT hr] with ρ hρ
  have hsub : closedBall x ρ ⊆ K j := (closedBall_subset_ball hρ.2).trans hjK
  rw [Measure.restrict_apply measurableSet_closedBall, Measure.restrict_apply measurableSet_closedBall,
    inter_eq_left.2 hsub]
/-- **Simon Ch. 1, 3.1–3.2** (densities may be computed with closed or open balls; cf. 6.2.8 and
`HasMassDensity`): if `ν(B̄_ρ(x)) / (ωₙρⁿ) → θ ∈ [0, ∞]` as `ρ ↓ 0`, then also
`ν(B_ρ(x)) / (ωₙρⁿ) → θ`.  The upper bound follows from `B_ρ(x) ⊆ B̄_ρ(x)`.  For the lower
bound, given `a < θ` pick `t ∈ (0, 1)` with `a < tⁿθ`; then `B̄_{tρ}(x) ⊆ B_ρ(x)` and
`ωₙ(tρ)ⁿ = tⁿ ωₙρⁿ` give `ν(B_ρ(x)) / (ωₙρⁿ) ≥ tⁿ · ν(B̄_{tρ}(x)) / (ωₙ(tρ)ⁿ) > a` for small
`ρ`. -/
theorem Submission.rsd_tendsto_ball_density_of_closedBall : ∀ (P n : ℕ) (ν : Measure (Euclid P)) (x : Euclid P) (θ : ℝ≥0∞), Tendsto (fun ρ : ℝ => ν (closedBall x ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) (𝓝 θ) → Tendsto (fun ρ : ℝ => ν (ball x ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) (𝓝 θ) := by
  intro P n ν x θ hg
  set ω := unitBallVolume n
  rw [tendsto_order]
  refine ⟨fun a ha => ?_, fun b hb => ?_⟩
  · -- Step 2: choose `t ∈ (0, 1)` with `a < tⁿθ`, using `tⁿθ → θ` as `t ↑ 1`
    have hlim : Tendsto (fun t : ℝ => ENNReal.ofReal (t ^ n) * θ) (𝓝[<] 1) (𝓝 (1 * θ)) := by
      refine ENNReal.Tendsto.mul_const ?_ (Or.inl one_ne_zero)
      have : Tendsto (fun t : ℝ => ENNReal.ofReal (t ^ n)) (𝓝 1) (𝓝 (ENNReal.ofReal (1 ^ n))) :=
        (ENNReal.continuous_ofReal.comp (continuous_pow n)).tendsto 1
      simpa using this.mono_left nhdsWithin_le_nhds
    rw [one_mul] at hlim
    obtain ⟨t, hta, ht0, ht1⟩ : ∃ t : ℝ, a < ENNReal.ofReal (t ^ n) * θ ∧ 0 < t ∧ t < 1 := by
      have h1 := (tendsto_order.1 hlim).1 a ha
      have h2 : ∀ᶠ t in 𝓝[<] (1 : ℝ), t ∈ Ioo (0 : ℝ) 1 := Ioo_mem_nhdsLT (by norm_num)
      obtain ⟨t, ht, ht'⟩ := (h1.and h2).exists
      exact ⟨t, ht, ht'.1, ht'.2⟩
    have hc0 : ENNReal.ofReal (t ^ n) ≠ 0 := by
      rw [Ne, ENNReal.ofReal_eq_zero, not_le]
      positivity
    have hctop : ENNReal.ofReal (t ^ n) ≠ ∞ := ENNReal.ofReal_ne_top
    have ha' : a / ENNReal.ofReal (t ^ n) < θ := by
      rw [ENNReal.div_lt_iff (Or.inl hc0) (Or.inl hctop), mul_comm]
      exact hta
    -- Step 3: the rescaled closed-ball ratio `g(tρ)` still tends to `θ`
    have hmap : Tendsto (fun ρ : ℝ => t * ρ) (𝓝[>] 0) (𝓝[>] 0) := by
      refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ ?_ ?_
      · have h0 : Tendsto (fun ρ : ℝ => t * ρ) (𝓝 0) (𝓝 0) := by
          simpa using (tendsto_id (x := 𝓝 (0 : ℝ))).const_mul t
        exact h0.mono_left nhdsWithin_le_nhds
      · filter_upwards [self_mem_nhdsWithin] with ρ hρ
        exact mul_pos ht0 hρ
    have hev := (tendsto_order.1 (hg.comp hmap)).1 _ ha'
    filter_upwards [hev, self_mem_nhdsWithin] with ρ hρ hρpos
    simp only [Function.comp] at hρ
    have hρpos' : (0 : ℝ) < ρ := hρpos
    -- Step 4: `ν(B̄_{tρ}(x)) / (ωₙ(tρ)ⁿ) · tⁿ = ν(B̄_{tρ}(x)) / (ωₙρⁿ)`
    have hid : ν (closedBall x (t * ρ)) / (ω * ENNReal.ofReal ((t * ρ) ^ n)) * ENNReal.ofReal (t ^ n)
        = ν (closedBall x (t * ρ)) / (ω * ENNReal.ofReal (ρ ^ n)) := by
      rw [mul_pow, ENNReal.ofReal_mul (by positivity), mul_comm (ENNReal.ofReal (t ^ n)),
        ← mul_assoc, div_eq_mul_inv, div_eq_mul_inv, ENNReal.mul_inv (Or.inr hctop) (Or.inr hc0),
        mul_assoc, mul_assoc, ENNReal.inv_mul_cancel hc0 hctop, mul_one]
    -- Step 5: `a < tⁿ g(tρ) ≤ h(ρ)`, as `B̄_{tρ}(x) ⊆ B_ρ(x)`
    calc a = a / ENNReal.ofReal (t ^ n) * ENNReal.ofReal (t ^ n) :=
          (ENNReal.div_mul_cancel hc0 hctop).symm
      _ < ν (closedBall x (t * ρ)) / (ω * ENNReal.ofReal ((t * ρ) ^ n)) * ENNReal.ofReal (t ^ n) :=
          (ENNReal.mul_lt_mul_iff_left hc0 hctop).2 hρ
      _ = ν (closedBall x (t * ρ)) / (ω * ENNReal.ofReal (ρ ^ n)) := hid
      _ ≤ ν (ball x ρ) / (ω * ENNReal.ofReal (ρ ^ n)) := by
          gcongr
          exact closedBall_subset_ball (by nlinarith)
  · -- Step 1: `h(ρ) ≤ g(ρ)`, as `B_ρ(x) ⊆ B̄_ρ(x)`
    filter_upwards [(tendsto_order.1 hg).2 b hb] with ρ hρ
    refine lt_of_le_of_lt ?_ hρ
    gcongr
    exact ball_subset_closedBall
/-- Local finiteness of an integer multiplicity representation `(M, θ, ξ)` in `U` (Simon Ch. 6,
Definition 3.1).  For compact `K ⊆ U`, `μ_R(K) = ∫_{M ∩ K} θ dHⁿ < ∞` by the local integrability
of `θ`, and `Hⁿ(M ∩ K) = ∫_{M ∩ K} 1 dHⁿ ≤ ∫_{M ∩ K} θ dHⁿ < ∞` since `θ ≥ 1` on `M`. -/
theorem Submission.rsd_imrep_compact_measure_ne_top : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (K : Set (Euclid P)), IsCompact K → K ⊆ U → μHE[n] (R.carrier ∩ K) ≠ ∞ ∧ R.measure K ≠ ∞ := by
  intro P n U R K hK hKU
  have hint := R.locallyIntegrable_mult K hK hKU
  -- `μ_R(K) = ∫_K θ d(Hⁿ⌞M) = ∫_{M ∩ K} θ dHⁿ`, `K` being closed, hence Borel
  have hmeas : R.measure K = ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
    rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
      Measure.restrict_restrict hK.measurableSet, inter_comm]
  refine ⟨?_, by rw [hmeas]; exact hint⟩
  refine ne_top_of_le_ne_top hint ?_
  -- `Hⁿ(M ∩ K) = ∫_{M ∩ K} 1 dHⁿ ≤ ∫_{M ∩ K} θ dHⁿ`, as `1 ≤ θ` on `M`
  calc μHE[n] (R.carrier ∩ K) = ∫⁻ _ in R.carrier ∩ K, (1 : ℝ≥0∞) ∂μHE[n] := by
        rw [setLIntegral_one]
    _ ≤ ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
        refine setLIntegral_mono (measurable_from_nat.comp R.measurable_mult) ?_
        intro x hx
        exact_mod_cast R.mult_pos x hx.1
/-- **Simon Ch. 3, Remarks 1.8(1)–(2) and Theorem 1.9** (with the upper density theorem, Ch. 1,
3.6–3.7(2)): if `R = (M, θ, ξ)` has weight `μ_R = θ Hⁿ⌞M` finite on compact sets, then for
`Hⁿ`-a.e. `x ∈ M`, `μ_R(B_ρ(x)) / (ωₙρⁿ) → θ(x)` as `ρ ↓ 0`.  As `θ ≥ 1` on `M`,
`ν := Hⁿ⌞M ≤ μ_R`, so `ν(B_ρ(x)) / (ωₙρⁿ) → 1` at approximate tangent points.  With `k = θ(x)` and
`A_k = M ∩ θ⁻¹(ℕ ∖ {k})`, `μ_R(A_k ∩ B_ρ(x)) = o(ρⁿ)` for `Hⁿ`-a.e. `x ∉ A_k`, and
`kν(B) ≤ μ_R(B) + kμ_R(A_k ∩ B)`, `μ_R(B) ≤ kν(B) + μ_R(A_k ∩ B)` squeeze the ratio to `k`. -/
theorem Submission.idtp_dema_density_on_carrier : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), (∀ K : Set (Euclid P), IsCompact K → R.measure K ≠ ∞) → ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)), x ∈ R.carrier → Tendsto (fun ρ : ℝ => R.measure (ball x ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) (𝓝 (R.mult x : ℝ≥0∞)) := by
  intro P n U R hfin
  set M := R.carrier with hM
  have hMm : MeasurableSet M := R.measurableSet_carrier
  set ν : Measure (Euclid P) := (μHE[n] : Measure (Euclid P)).restrict M with hν
  -- `μ_R(S) = ∫_{S ∩ M} θ dHⁿ` for Borel `S`
  have hmeas : ∀ S : Set (Euclid P), MeasurableSet S →
      R.measure S = ∫⁻ y in S ∩ M, (R.mult y : ℝ≥0∞) ∂μHE[n] := by
    intro S hS
    simp only [IMRep.measure]
    rw [withDensity_apply _ hS, Measure.restrict_restrict hS]
  -- Step 1: `ν ≤ μ_R` on Borel sets, as `θ ≥ 1` on `M`
  have hνle : ∀ S : Set (Euclid P), MeasurableSet S → ν S ≤ R.measure S := by
    intro S hS
    rw [hmeas S hS, hν, Measure.restrict_apply hS]
    calc μHE[n] (S ∩ M) = ∫⁻ _y in S ∩ M, (1 : ℝ≥0∞) ∂μHE[n] := by simp
      _ ≤ ∫⁻ y in S ∩ M, (R.mult y : ℝ≥0∞) ∂μHE[n] := by
        apply setLIntegral_mono' (hS.inter hMm)
        intro y hy
        have h := R.mult_pos y hy.2
        exact_mod_cast Nat.one_le_iff_ne_zero.mpr h.ne'
  -- Step 2: the Borel sets `A_k = M ∩ θ⁻¹(ℕ ∖ {k})`
  set A : ℕ → Set (Euclid P) := fun k => M ∩ R.mult ⁻¹' ({k}ᶜ) with hA
  have hAm : ∀ k, MeasurableSet (A k) := fun k =>
    hMm.inter (R.measurable_mult (measurableSet_singleton k).compl)
  -- Step 3: `Hⁿ`-a.e., `μ_R(A_k ∩ B_ρ(x)) / (ωₙρⁿ) → 0` for every `k` with `x ∉ A_k`
  have hUD : ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)), ∀ k : ℕ, x ∉ A k →
      Tendsto (fun ρ : ℝ => R.measure (A k ∩ ball x ρ) /
        (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) (𝓝 0) :=
    ae_all_iff.2 fun k => Submission.idtp_dema_upper_density_zero P n R.measure (A k) (hAm k) hfin
  -- Step 4: `Hⁿ`-a.e. on `M` there is an approximate tangent space (field `orients`)
  have htan : ∀ᵐ x ∂(μHE[n] : Measure (Euclid P)), x ∈ M →
      ∃ Q, HasApproximateTangentSpaceAt n M x Q := by
    have h := R.orients
    rw [ae_restrict_iff' hMm] at h
    filter_upwards [h] with x hx hxM
    obtain ⟨Q, hQ, -⟩ := hx hxM
    exact ⟨Q, hQ⟩
  filter_upwards [hUD, htan] with x hxUD hxtan hxM
  obtain ⟨Q, hQ⟩ := hxtan hxM
  set k : ℕ := R.mult x with hk
  have hxA : x ∉ A k := fun h => h.2 (by simp [hk])
  have he := hxUD k hxA
  -- `ν(B_ρ(x)) / (ωₙρⁿ) → 1`, using `Hⁿ(M ∩ B̄_1(x)) ≤ μ_R(B̄_1(x)) < ∞`
  have hfinball : μHE[n] (M ∩ closedBall x 1) ≠ ∞ := by
    have h1 := hνle (closedBall x 1) measurableSet_closedBall
    have h2 := hfin (closedBall x 1) (isCompact_closedBall x 1)
    rw [hν, Measure.restrict_apply measurableSet_closedBall] at h1
    rw [inter_comm]
    exact ne_top_of_le_ne_top h2 h1
  have hTD := Submission.rsd_tendsto_closedBall_density_of_approxTangent P n M x Q 1 one_pos
    hfinball hQ
  have hTD' : Tendsto (fun ρ : ℝ => ν (closedBall x ρ) /
      (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) (𝓝 1) := by
    refine hTD.congr fun ρ => ?_
    rw [hν, Measure.restrict_apply measurableSet_closedBall, inter_comm]
  have hb := Submission.rsd_tendsto_ball_density_of_closedBall P n ν x 1 hTD'
  -- Step 5: `μ_R(B) = k Hⁿ(B ∩ M ∩ θ⁻¹(k)) + μ_R(A_k ∩ B)`, whence the bounds (U) and (L)
  set T : Set (Euclid P) := R.mult ⁻¹' {k} with hT
  have hTm : MeasurableSet T := R.measurable_mult (measurableSet_singleton k)
  have hsplit : ∀ ρ : ℝ, R.measure (ball x ρ) =
      (k : ℝ≥0∞) * μHE[n] ((ball x ρ ∩ M) ∩ T) + R.measure (A k ∩ ball x ρ) := by
    intro ρ
    rw [hmeas _ measurableSet_ball, hmeas _ ((hAm k).inter measurableSet_ball),
      ← lintegral_inter_add_sdiff (B := T) _ _ hTm]
    congr 1
    · rw [setLIntegral_congr_fun ((measurableSet_ball.inter hMm).inter hTm)
        (g := fun _ => (k : ℝ≥0∞)) (fun y hy => by
          have : R.mult y = k := hy.2
          simp [this])]
      simp
    · have hset : (ball x ρ ∩ M) \ T = (A k ∩ ball x ρ) ∩ M := by
        ext y
        simp only [hA, hT, mem_inter_iff, Set.mem_sdiff, mem_preimage, mem_compl_iff,
          mem_singleton_iff]
        tauto
      rw [hset]
  have hνsplit : ∀ ρ : ℝ, ν (ball x ρ) =
      μHE[n] ((ball x ρ ∩ M) ∩ T) + ν (A k ∩ ball x ρ) := by
    intro ρ
    rw [hν, Measure.restrict_apply measurableSet_ball,
      Measure.restrict_apply ((hAm k).inter measurableSet_ball),
      ← measure_inter_add_sdiff (ball x ρ ∩ M) hTm]
    have hset : (ball x ρ ∩ M) \ T = (A k ∩ ball x ρ) ∩ M := by
      ext y
      simp only [hA, hT, mem_inter_iff, Set.mem_sdiff, mem_preimage, mem_compl_iff,
        mem_singleton_iff]
      tauto
    rw [hset]
  -- (U) `μ_R(B) ≤ kν(B) + μ_R(A_k ∩ B)`
  have hup : ∀ ρ : ℝ, R.measure (ball x ρ) ≤
      (k : ℝ≥0∞) * ν (ball x ρ) + R.measure (A k ∩ ball x ρ) := by
    intro ρ
    rw [hsplit ρ]
    have h1 : μHE[n] ((ball x ρ ∩ M) ∩ T) ≤ ν (ball x ρ) := by
      rw [hν, Measure.restrict_apply measurableSet_ball]
      exact measure_mono inter_subset_left
    exact add_le_add (mul_le_mul_right h1 _) le_rfl
  -- (L) `kν(B) ≤ μ_R(B) + kμ_R(A_k ∩ B)`
  have hlow : ∀ ρ : ℝ, (k : ℝ≥0∞) * ν (ball x ρ) ≤
      R.measure (ball x ρ) + (k : ℝ≥0∞) * R.measure (A k ∩ ball x ρ) := by
    intro ρ
    rw [hνsplit ρ, mul_add, hsplit ρ, add_assoc]
    have h2 := hνle (A k ∩ ball x ρ) ((hAm k).inter measurableSet_ball)
    exact add_le_add le_rfl ((mul_le_mul_right h2 _).trans le_add_self)
  -- Step 6: divide by `ωₙρⁿ`; both bounds tend to `k`, as `k < ∞`
  set c : ℝ → ℝ≥0∞ := fun ρ => unitBallVolume n * ENNReal.ofReal (ρ ^ n) with hc
  have hk_top : (k : ℝ≥0∞) ≠ ∞ := ENNReal.natCast_ne_top k
  have hupper : Tendsto (fun ρ => (k : ℝ≥0∞) * (ν (ball x ρ) / c ρ) +
      R.measure (A k ∩ ball x ρ) / c ρ) (𝓝[>] 0) (𝓝 (k : ℝ≥0∞)) := by
    have := (ENNReal.Tendsto.const_mul hb (Or.inr hk_top)).add he
    simpa using this
  have hlower : Tendsto (fun ρ => (k : ℝ≥0∞) * (ν (ball x ρ) / c ρ) -
      (k : ℝ≥0∞) * (R.measure (A k ∩ ball x ρ) / c ρ)) (𝓝[>] 0) (𝓝 (k : ℝ≥0∞)) := by
    have h1 := ENNReal.Tendsto.const_mul hb (Or.inr hk_top)
    have h2 := ENNReal.Tendsto.const_mul he (Or.inr hk_top)
    have := ENNReal.Tendsto.sub h1 h2 (Or.inl (by simp))
    simpa using this
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le hlower hupper (fun ρ => ?_) (fun ρ => ?_)
  · -- the lower bound, from (L)
    simp only
    rw [tsub_le_iff_right, ← mul_div_assoc, ← mul_div_assoc, ← ENNReal.add_div]
    exact ENNReal.div_le_div_right (hlow ρ) _
  · -- the upper bound, from (U)
    simp only
    rw [← mul_div_assoc, ← ENNReal.add_div]
    exact ENNReal.div_le_div_right (hup ρ) _

/-- **Simon Ch. 3, Remarks 1.8(1),(2) and Theorem 1.9** (with Ch. 1, 3.6 and Remark 3.7(2)): the
density of `μ_R = θ Hⁿ⌞M` is `1_M θ` `Hⁿ`-a.e.  If `μ_R(K) < ∞` for every compact `K`, then
`μ_R(B_ρ(x)) / (ωₙρⁿ) → 1_M(x) θ(x)` as `ρ ↓ 0` for `Hⁿ`-a.e. `x`.  At `Hⁿ`-a.e. `x ∈ M` this is
`idtp_dema_density_on_carrier`.  Since `μ_R(ℝᴾ \ M) = 0`, `μ_R(B_ρ(x)) = μ_R(M ∩ B_ρ(x))`, so at
`Hⁿ`-a.e. `x ∉ M` the upper density theorem `idtp_dema_upper_density_zero` (with `μ = μ_R` and
`A = M`) gives the limit `0`. -/
theorem Submission.idtp_imrep_measure_density_ae : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), 1 ≤ n → (∀ K : Set (Euclid P), IsCompact K → R.measure K ≠ ∞) → ∀ᵐ x ∂μHE[n], Tendsto (fun ρ : ℝ => R.measure (ball x ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) (𝓝 (Set.indicator R.carrier (fun y => (R.mult y : ℝ≥0∞)) x)) := by
  intro P n U R _hn hfin
  -- `μ_R` is carried by `M`
  have hnull : R.measure R.carrierᶜ = 0 := by
    rw [IMRep.measure, withDensity_apply _ R.measurableSet_carrier.compl,
      Measure.restrict_restrict R.measurableSet_carrier.compl, compl_inter_self,
      Measure.restrict_empty, lintegral_zero_measure]
  filter_upwards [Submission.idtp_dema_upper_density_zero P n R.measure R.carrier
      R.measurableSet_carrier hfin, Submission.idtp_dema_density_on_carrier P n U R hfin]
    with x hoff hon
  by_cases hx : x ∈ R.carrier
  · -- on `M` the density is `θ(x)`
    rw [indicator_of_mem hx]
    exact hon hx
  · -- off `M` the density is that of `μ_R⌞M`, namely `0`
    rw [indicator_of_notMem hx]
    refine (hoff hx).congr fun ρ => ?_
    rw [inter_comm, measure_inter_conull hnull]

/-- **Simon Ch. 6, 3.1 (‡)**: the integrand `θ ⟨ω, ξ⟩` of `τ(M, θ, ξ)(ω)` is `Hⁿ⌞M`-integrable.
`ω` is continuous with compact support `K = spt ω ⊆ U`, so `‖ω‖ ≤ C` and `ω = 0` off `K`, and
`‖ξ‖ ≤ 1` `Hⁿ⌞M`-a.e.; hence `|θ ⟨ω, ξ⟩| ≤ C θ 1_K`, integrable as `∫_{M ∩ K} θ dHⁿ < ∞`. -/
theorem Submission.rsd_cmr_ic_action_integrable : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (ω : TestFormOn U n), Integrable (fun x => (R.mult x : ℝ) * R.orient x ((ω : DifferentialForm (Euclid P) n) x)) (μHE[n].restrict R.carrier) := by
  intro P n U R ω
  have hω : IsTestForm (ω : DifferentialForm (Euclid P) n) ∧
      tsupport (ω : DifferentialForm (Euclid P) n) ⊆ U := ω.2
  obtain ⟨⟨hsmooth, hcpt⟩, hsupp⟩ := hω
  have hcont : Continuous (ω : DifferentialForm (Euclid P) n) := ContDiff.continuous hsmooth
  -- `‖ω‖ ≤ C`, and `K = spt ω` is closed
  obtain ⟨C, hC⟩ := hcpt.exists_bound_of_continuous hcont
  have hKm : MeasurableSet (tsupport (ω : DifferentialForm (Euclid P) n)) :=
    (isClosed_tsupport _).measurableSet
  have hθ : Measurable fun x => (R.mult x : ℝ) := measurable_from_nat.comp R.measurable_mult
  -- `1_K θ` is `Hⁿ⌞M`-integrable: `∫_{M ∩ K} θ dHⁿ < ∞`
  have hh : Integrable ((tsupport (ω : DifferentialForm (Euclid P) n)).indicator
      fun x => (R.mult x : ℝ)) (μHE[n].restrict R.carrier) := by
    rw [integrable_indicator_iff hKm, IntegrableOn, Measure.restrict_restrict hKm, inter_comm]
    refine ⟨hθ.aestronglyMeasurable, ?_⟩
    rw [hasFiniteIntegral_iff_ofReal (Eventually.of_forall fun x => Nat.cast_nonneg _)]
    simp only [ENNReal.ofReal_natCast]
    exact (R.locallyIntegrable_mult _ hcpt.isCompact hsupp).lt_top
  -- `θ ⟨ω, ξ⟩` is a.e. strongly measurable and dominated by `C θ 1_K`
  refine (hh.const_mul C).mono' (hθ.aestronglyMeasurable.mul
    (isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable
      (R.aestronglyMeasurable_orient.prodMk hcont.aestronglyMeasurable))) ?_
  filter_upwards [R.orients] with x hx
  obtain ⟨Q, -, hQ⟩ := hx
  have hξ := (Submission.imsupp_unit_orientation_ne_zero_norm_le_one P n _ Q hQ).2
  by_cases hK : x ∈ tsupport (ω : DifferentialForm (Euclid P) n)
  · rw [indicator_of_mem hK, norm_mul, Real.norm_natCast, mul_comm C]
    refine mul_le_mul_of_nonneg_left ?_ (Nat.cast_nonneg _)
    calc ‖R.orient x ((ω : DifferentialForm (Euclid P) n) x)‖
        ≤ ‖R.orient x‖ * ‖(ω : DifferentialForm (Euclid P) n) x‖ := (R.orient x).le_opNorm _
      _ ≤ 1 * C := mul_le_mul hξ (hC x) (norm_nonneg _) zero_le_one
      _ = C := one_mul C
  · simp [indicator_of_notMem hK, image_eq_zero_of_notMem_tsupport hK]
/-- **Simon Ch. 6, 3.1 (‡)**: if `spt ω ⊆ K` for a compact `K ⊆ U` and `‖ω(x)‖ ≤ ε` for all `x`,
then `|τ(M, θ, ξ)(ω)| ≤ ε ∫_{M ∩ K} θ dHⁿ`.  `Hⁿ`-a.e. on `M`, `ξ(x)` is a unit orientation, so
`‖ξ(x)‖ ≤ 1` and `|θ(x) ⟨ω(x), ξ(x)⟩| ≤ ε θ(x) 1_K(x)`; the bound `θ 1_K` is `Hⁿ⌞M`-integrable
with integral `∫_{M ∩ K} θ dHⁿ < ∞`, `θ` being locally `Hⁿ`-integrable in `U`. -/
theorem Submission.rsd_cmr_ic_action_abs_le : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (K : Set (Euclid P)) (ω : TestFormOn U n) (ε : ℝ), IsCompact K → K ⊆ U → tsupport (ω : DifferentialForm (Euclid P) n) ⊆ K → (∀ x, ‖(ω : DifferentialForm (Euclid P) n) x‖ ≤ ε) → |R.action (ω : DifferentialForm (Euclid P) n)| ≤ ε * (∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal := by
  intro P n U R K ω ε hK hKU hsupp hbound
  have hKm : MeasurableSet K := hK.isClosed.measurableSet
  have hθm : Measurable fun x => (R.mult x : ℝ) := measurable_from_nat.comp R.measurable_mult
  have hθ0 : ∀ x, (0 : ℝ) ≤ R.mult x := fun x => Nat.cast_nonneg _
  -- `(Hⁿ⌞M)⌞K = Hⁿ⌞(M ∩ K)`, and `ofReal θ = θ` since `θ` is `ℕ`-valued
  have hrestr : (μHE[n].restrict R.carrier).restrict K = μHE[n].restrict (R.carrier ∩ K) := by
    rw [Measure.restrict_restrict hKm, inter_comm]
  have hlint : ∫⁻ x, ENNReal.ofReal (R.mult x : ℝ) ∂(μHE[n].restrict (R.carrier ∩ K)) =
      ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
    simp_rw [ENNReal.ofReal_natCast]
  -- `θ 1_K` is `Hⁿ⌞M`-integrable with integral `∫_{M ∩ K} θ dHⁿ`
  have hint : Integrable (K.indicator fun x => (R.mult x : ℝ)) (μHE[n].restrict R.carrier) := by
    rw [integrable_indicator_iff hKm, IntegrableOn, hrestr]
    refine ⟨hθm.aestronglyMeasurable, ?_⟩
    rw [hasFiniteIntegral_iff_ofReal (Eventually.of_forall hθ0), hlint]
    exact (R.locallyIntegrable_mult K hK hKU).lt_top
  have hval : ∫ x, K.indicator (fun x => (R.mult x : ℝ)) x ∂(μHE[n].restrict R.carrier) =
      (∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal := by
    rw [integral_indicator hKm, hrestr,
      integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall hθ0) hθm.aestronglyMeasurable, hlint]
  -- `‖ξ(x)‖ ≤ 1` for `Hⁿ`-a.e. `x ∈ M`, `ξ(x)` being a unit orientation there
  have hξ : ∀ᵐ x ∂(μHE[n].restrict R.carrier), ‖R.orient x‖ ≤ 1 := by
    filter_upwards [R.orients] with x hx
    obtain ⟨Q, -, hQ⟩ := hx
    exact (Submission.imsupp_unit_orientation_ne_zero_norm_le_one P n _ Q hQ).2
  -- `|θ ⟨ω, ξ⟩| ≤ θ ‖ξ‖ ‖ω‖ ≤ ε θ` on `K`, and `ω = 0` off `K ⊇ spt ω`
  have hpt : ∀ᵐ x ∂(μHE[n].restrict R.carrier),
      ‖(R.mult x : ℝ) * R.orient x ((ω : DifferentialForm (Euclid P) n) x)‖ ≤
        ε * K.indicator (fun x => (R.mult x : ℝ)) x := by
    filter_upwards [hξ] with x hx
    by_cases hxK : x ∈ K
    · rw [indicator_of_mem hxK, norm_mul, Real.norm_of_nonneg (hθ0 x), mul_comm ε]
      refine mul_le_mul_of_nonneg_left ?_ (hθ0 x)
      calc ‖R.orient x ((ω : DifferentialForm (Euclid P) n) x)‖
          ≤ ‖R.orient x‖ * ‖(ω : DifferentialForm (Euclid P) n) x‖ := (R.orient x).le_opNorm _
        _ ≤ 1 * ε := mul_le_mul hx (hbound x) (norm_nonneg _) zero_le_one
        _ = ε := one_mul ε
    · have hωx : (ω : DifferentialForm (Euclid P) n) x = 0 :=
        image_eq_zero_of_notMem_tsupport fun h => hxK (hsupp h)
      rw [indicator_of_notMem hxK, hωx, map_zero, mul_zero, norm_zero, mul_zero]
  -- `|τ(M, θ, ξ)(ω)| ≤ ∫ ε θ 1_K d(Hⁿ⌞M) = ε ∫_{M ∩ K} θ dHⁿ`
  have h := norm_integral_le_of_norm_le (hint.const_mul ε) hpt
  rwa [integral_const_mul, hval, Real.norm_eq_abs] at h

/-- **Simon Ch. 6, 3.1 (‡)**: an integer multiplicity triple `(M, θ, ξ)` in `U` defines a current
`τ(M, θ, ξ) ∈ 𝒟ₙ(U)`, `τ(M, θ, ξ)(ω) = ∫_M ⟨ω(x), ξ(x)⟩ θ(x) dHⁿ(x)`.  The integrand is
`Hⁿ⌞M`-integrable, so `ω ↦ τ(M, θ, ξ)(ω)` is linear.  If `ωⱼ → 0` in `𝒟ⁿ(U)`, then
`spt ωⱼ ⊆ K` for one compact `K ⊆ U` and `ωⱼ → 0` uniformly on `K`; for `ε > 0` and `j` large,
`‖ωⱼ‖ ≤ δ = ε / (I + 1)`, `I = ∫_{M ∩ K} θ dHⁿ`, so `|τ(M, θ, ξ)(ωⱼ)| ≤ δ I < ε`. -/
theorem Submission.rsd_cmr_imrep_represents_exists : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), ∃ T : GeometricCurrentOn U n, R.Represents T := by
  intro P n U R
  refine ⟨{ toCurrent :=
              { toFun := fun ω => R.action (ω : DifferentialForm (Euclid P) n)
                map_add' := fun ω η => ?_
                map_smul' := fun c ω => ?_ }
            continuous' := fun ωs hωs => ?_ }, fun ω => rfl⟩
  · -- `θ ⟨ω + η, ξ⟩ = θ ⟨ω, ξ⟩ + θ ⟨η, ξ⟩`, both integrable
    simp only [IMRep.action, Submodule.coe_add, Pi.add_apply, map_add, mul_add]
    exact integral_add (Submission.rsd_cmr_ic_action_integrable P n U R ω)
      (Submission.rsd_cmr_ic_action_integrable P n U R η)
  · -- `θ ⟨c ω, ξ⟩ = c θ ⟨ω, ξ⟩`
    simp only [IMRep.action, Submodule.coe_smul, Pi.smul_apply, map_smul, smul_eq_mul,
      RingHom.id_apply]
    rw [← integral_const_mul]
    congr 1
    funext x
    ring
  · -- `spt ωⱼ ⊆ K` for a compact `K ⊆ U`, and the `0`-th derivatives `ωⱼ → 0` uniformly on `K`
    obtain ⟨K, hK, hKU, hsupp, -, hconv⟩ := hωs
    change Tendsto (fun j => R.action (ωs j : DifferentialForm (Euclid P) n)) atTop (𝓝 0)
    set I := (∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n]).toReal
    have hI : 0 ≤ I := ENNReal.toReal_nonneg
    rw [Metric.tendsto_atTop]
    intro ε hε
    have hδ : 0 < ε / (I + 1) := div_pos hε (by linarith)
    obtain ⟨N, hN⟩ := eventually_atTop.1 (Metric.tendstoUniformlyOn_iff.1 (hconv 0) _ hδ)
    refine ⟨N, fun j hj => ?_⟩
    -- `‖ωⱼ(x)‖ ≤ δ` everywhere: on `K` by uniform convergence, off `K` since `ωⱼ = 0` there
    have hbound : ∀ x, ‖(ωs j : DifferentialForm (Euclid P) n) x‖ ≤ ε / (I + 1) := fun x => by
      by_cases hx : x ∈ K
      · have h := hN j hj x hx
        rw [iteratedFDeriv_zero_eq_comp, iteratedFDeriv_zero_eq_comp, comp_apply, comp_apply,
          LinearIsometryEquiv.dist_map, Submodule.coe_zero, Pi.zero_apply, dist_zero_left] at h
        exact h.le
      · rw [image_eq_zero_of_notMem_tsupport fun h => hx (hsupp j h), norm_zero]
        exact hδ.le
    -- `|τ(M, θ, ξ)(ωⱼ)| ≤ δ I < ε`
    have h := Submission.rsd_cmr_ic_action_abs_le P n U R K (ωs j) _ hK hKU (hsupp j) hbound
    rw [Real.dist_eq, sub_zero]
    calc |R.action (ωs j : DifferentialForm (Euclid P) n)| ≤ ε / (I + 1) * I := h
      _ < ε := by
        rw [div_mul_eq_mul_div, div_lt_iff₀ (by linarith)]
        nlinarith

/-- **Constant multiplicity: the quotient current is integer multiplicity** (Simon Ch. 5, proof of
Corollary 7.3, chapter-05.txt lines 1389–1394, `Ṽ = v(M, N⁻¹θ)⌞B_ρ(ξ)`; a step of the constant
multiplicity reduction behind Simon 7.4.2).  Let `T = τ(M, θ, ξ)` in `U`, `V ⊆ U` open, `N₀ ≥ 1`
with `θ = N₀` `μ_T`-a.e. on `V`, and `T(ω) = N₀ T₀(ω)` for `ω ∈ 𝒟ⁿ(V)`.  Then `(M ∩ V, 1, ξ)`
represents `T₀`.  Since `μ_T = θHⁿ⌞M` with `θ ≥ 1` on `M`, `θ = N₀` `Hⁿ`-a.e. on `M ∩ V`.
`Submission.rsd_cmr_imrep_restrict` makes `(M ∩ V, 1, ξ)` a triple in `V` (`1 ≤ θ` gives local
integrability, and `V` is open).  As `ω = 0` off `V`,
`N₀ T₀(ω) = ∫_M θ⟨ω, ξ⟩ dHⁿ = ∫_{M ∩ V} N₀⟨ω, ξ⟩ dHⁿ`; cancel `N₀ ≠ 0`. -/
theorem Submission.rsd_cmr_isIntegerMultiplicity_of_const_mult : ∀ (P n : ℕ) (U V : Set (Euclid P)) (hVU : V ⊆ U) (T : GeometricCurrentOn U n) (R : IMRep U n) (T₀ : GeometricCurrentOn V n) (N₀ : ℕ), IsOpen V → 0 < N₀ → R.Represents T → (∀ᵐ x ∂R.measure, x ∈ V → R.mult x = N₀) → (∀ ω : TestFormOn V n, T (testFormOnInclusion hVU n ω) = (N₀ : ℝ) * T₀ ω) → IsIntegerMultiplicity T₀ := by
  intro P n U V hVU T R T₀ N₀ hV hN₀ hRT hconst hT₀
  have hMV : MeasurableSet (R.carrier ∩ V) := R.measurableSet_carrier.inter hV.measurableSet
  have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) :=
    (measurable_from_nat (f := fun k : ℕ => (k : ℝ≥0∞))).comp R.measurable_mult
  -- Step 1: `θ = N₀` `Hⁿ`-a.e. on `M ∩ V`, as `μ_T = θHⁿ⌞M` and `θ ≠ 0` on `M`.
  have hae : ∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ V)), R.mult x = N₀ := by
    have h := (ae_withDensity_iff (μ := μHE[n].restrict R.carrier) hθ).1 hconst
    filter_upwards [ae_restrict_of_ae_restrict_of_subset
      (inter_subset_left : R.carrier ∩ V ⊆ R.carrier) h, ae_restrict_mem hMV] with x hx hxMV
    exact hx (Nat.cast_ne_zero.2 (R.mult_pos x hxMV.1).ne') hxMV.2
  -- Step 2: `R₀ = (M ∩ V, 1, ξ)` is an integer multiplicity triple in `V`.
  obtain ⟨R₀, hcar, hmult, horient⟩ := Submission.rsd_cmr_imrep_restrict P n U V V R (fun _ => 1)
    hV.measurableSet inter_subset_right measurable_const (fun _ _ => Nat.one_pos)
    -- `∫_{M ∩ V ∩ K} 1 dHⁿ ≤ ∫_{M ∩ K} θ dHⁿ < ∞`, as `1 ≤ θ` on `M`.
    (fun K hK hKV => ne_top_of_le_ne_top (R.locallyIntegrable_mult K hK (hKV.trans hVU))
      (le_trans (setLIntegral_mono hθ fun x hx => Nat.cast_le.2 (R.mult_pos x hx.1.1))
        (lintegral_mono_set (inter_subset_inter_left K inter_subset_left))))
    (by
      -- A ball `B_δ(x) ⊆ V` about `x ∈ M ∩ V` misses `M \ V`.
      filter_upwards [ae_restrict_mem hMV] with x hx
      obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.1 hV x hx.2
      exact ⟨δ, hδ, measure_mono_null (fun y hy => absurd (hball hy.2) hy.1.2) measure_empty⟩)
  -- Step 3: `N₀ T₀(ω) = N₀ R₀(ω)`, and `N₀ ≠ 0`.
  refine ⟨R₀, fun ω => mul_left_cancel₀ (Nat.cast_ne_zero.2 hN₀.ne' : (N₀ : ℝ) ≠ 0) ?_⟩
  -- `ω = 0` on `M \ V`, as `spt ω ⊆ V`.
  have hω : ∀ x ∈ R.carrier \ (R.carrier ∩ V), (ω : DifferentialForm (Euclid P) n) x = 0 :=
    fun x hx => image_eq_zero_of_notMem_tsupport fun h => hx.2 ⟨hx.1, ω.2.2 h⟩
  calc (N₀ : ℝ) * T₀ ω = T (testFormOnInclusion hVU n ω) := (hT₀ ω).symm
    _ = ∫ x in R.carrier, (R.mult x : ℝ) * R.orient x ((ω : DifferentialForm (Euclid P) n) x)
          ∂μHE[n] := hRT _
    _ = ∫ x in R.carrier ∩ V,
          (R.mult x : ℝ) * R.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n] :=
        setIntegral_eq_of_subset_of_forall_sdiff_eq_zero R.measurableSet_carrier
          inter_subset_left fun x hx => by simp only [hω x hx, map_zero, mul_zero]
    _ = ∫ x in R.carrier ∩ V,
          (N₀ : ℝ) * R.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n] :=
        integral_congr_ae (hae.mono fun x hx => by simp only [hx])
    _ = (N₀ : ℝ) * R₀.action ω := by
        rw [integral_const_mul]
        simp only [IMRep.action, hcar, hmult, horient, Nat.cast_one, one_mul]
/-- **Extension by zero** (Simon 6.2.16, 6.3.1; step 6(b)–(c) of the proof of 7.4.2).  Let
`B ⊆ U` with `B` open, `K ⊆ B` compact, and `X = τ(M, θ, ξ) ∈ 𝒟ₙ(B)` with `μ_X = θ Hⁿ⌞M`
vanishing near each point of `B \ K`.  By second countability `μ_X(B \ K) = 0`, so
`Hⁿ(M \ K) = 0` as `θ ≥ 1` on `M ⊆ B`.  Then `E = τ(M ∩ K, θ, ξ) ∈ 𝒟ₙ(U)` is integer
multiplicity, extends `X` (`M ∩ K = M` up to the `Hⁿ`-null set `M \ K`) and vanishes on forms
whose support misses `K`. -/
theorem Submission.rsd_cmr_zero_extension : ∀ (P n : ℕ) (U B K : Set (Euclid P)) (hBU : B ⊆ U) (X : GeometricCurrentOn B n) (R : IMRep B n), IsOpen B → IsCompact K → K ⊆ B → R.Represents X → (∀ y ∈ B, y ∉ K → ∃ ρ : ℝ, 0 < ρ ∧ R.measure (ball y ρ) = 0) → ∃ E : GeometricCurrentOn U n, IsIntegerMultiplicity E ∧ (∀ ω : TestFormOn B n, E (testFormOnInclusion hBU n ω) = X ω) ∧ ∀ ω : TestFormOn U n, Disjoint (tsupport (ω : DifferentialForm (Euclid P) n)) K → E ω = 0 := by
  intro P n U B K hBU X R hB hK hKB hX hloc
  -- `μ_X(B \ K) = 0`: each point of `B \ K` has a `μ_X`-null ball, and `ℝᴾ` is second countable.
  have hnull : R.measure (B \ K) = 0 :=
    measure_null_of_locally_null _ fun y hy => by
      obtain ⟨ρ, hρ, hball⟩ := hloc y hy.1 hy.2
      exact ⟨ball y ρ, mem_nhdsWithin_of_mem_nhds (ball_mem_nhds y hρ), hball⟩
  -- `Hⁿ(M \ K) ≤ ∫_{M ∩ (B \ K)} θ dHⁿ = μ_X(B \ K) = 0`, since `θ ≥ 1` on `M ⊆ B`.
  have hBK : MeasurableSet (B \ K) := hB.measurableSet.diff hK.measurableSet
  have hMK : μHE[n] (R.carrier \ K) = 0 := by
    refine nonpos_iff_eq_zero.1 (le_of_le_of_eq ?_ hnull)
    calc μHE[n] (R.carrier \ K) ≤ μHE[n] ((B \ K) ∩ R.carrier) :=
          measure_mono fun x hx => ⟨⟨R.carrier_subset hx.1, hx.2⟩, hx.1⟩
      _ = ∫⁻ _ in (B \ K) ∩ R.carrier, 1 ∂μHE[n] := (setLIntegral_one _).symm
      _ ≤ ∫⁻ x in (B \ K) ∩ R.carrier, (R.mult x : ℝ≥0∞) ∂μHE[n] :=
          setLIntegral_mono' (hBK.inter R.measurableSet_carrier) fun x hx =>
            Nat.one_le_cast.2 (R.mult_pos x hx.2)
      _ = R.measure (B \ K) := by
          rw [IMRep.measure, withDensity_apply _ hBK, Measure.restrict_restrict hBK]
  -- `(M ∩ K, θ, ξ)` is a triple in `U`: `θ` is integrable on the compact `K ⊆ B`, and the
  -- discarded part `M \ K` is `Hⁿ`-null.
  obtain ⟨R', hR'c, hR'm, hR'o⟩ := Submission.rsd_cmr_imrep_restrict P n B U K R R.mult
    hK.measurableSet (fun x hx => hBU (hKB hx.2)) R.measurable_mult
    (fun x hx => R.mult_pos x hx.1)
    (fun _ _ _ => ne_top_of_le_ne_top (R.locallyIntegrable_mult K hK hKB)
      (lintegral_mono_set inter_subset_left))
    (Eventually.of_forall fun _ => ⟨1, one_pos, measure_mono_null inter_subset_left hMK⟩)
  -- `E = τ(M ∩ K, θ, ξ) ∈ 𝒟ₙ(U)`.
  obtain ⟨E, hE⟩ := Submission.rsd_cmr_imrep_represents_exists P n U R'
  refine ⟨E, ⟨R', hE⟩, fun ω => ?_, fun ω hω => ?_⟩
  · -- `E` extends `X`: `M ∩ K` and `M` differ by the `Hⁿ`-null set `M \ K`.
    rw [hE (testFormOnInclusion hBU n ω), hX ω]
    simp only [IMRep.action, testFormOnInclusion_coe]
    rw [hR'c, hR'm, hR'o]
    refine setIntegral_congr_set (ae_eq_set.2 ⟨?_, ?_⟩)
    · rw [Set.sdiff_eq_empty.2 inter_subset_left, measure_empty]
    · rwa [Set.sdiff_self_inter]
  · -- `E(ω) = 0` when `spt ω ∩ K = ∅`: `ω` vanishes on `M ∩ K ⊆ K`.
    rw [hE ω]
    simp only [IMRep.action]
    rw [hR'c]
    refine setIntegral_eq_zero_of_forall_eq_zero fun x hx => ?_
    rw [image_eq_zero_of_notMem_tsupport (Set.disjoint_right.1 hω hx.2), map_zero, mul_zero]
/-- Cut-off step of the reduction to multiplicity one behind **Simon 7.4.2** (chapter-07.txt
lines 608–610), as in the proof of Ch. 5, 7.3 (chapter-05.txt lines 1388–1395), where it gives
`∂S = ∂T` for the competitor `S = T + N₀E`.  If `B ⊆ U` is open, `K ⊆ B` is compact, and
`F ∈ 𝒟ₘ(U)` vanishes on every form whose support misses `K` and on `ι(𝒟ᵐ(B))`, then `F = 0`:
take a smooth `φ` with `tsupport φ ⊆ B` compact and `φ = 1` on an open `V ⊇ K`; then
`ω = ι(φω) + (1 − φ)ω`, and `(1 − φ)ω` vanishes on `V`, so its support misses `K`. -/
theorem Submission.rsd_cmr_eq_zero_of_vanish_off_compact : ∀ (P m : ℕ) (U B K : Set (Euclid P)) (hBU : B ⊆ U) (F : GeometricCurrentOn U m), IsOpen B → IsCompact K → K ⊆ B → (∀ ω : TestFormOn U m, Disjoint (tsupport (ω : DifferentialForm (Euclid P) m)) K → F ω = 0) → (∀ ψ : TestFormOn B m, F (testFormOnInclusion hBU m ψ) = 0) → ∀ ω : TestFormOn U m, F ω = 0 := by
  intro P m U B K hBU F hB hK hKB hoff hin ω
  -- Step 1: a smooth cutoff `φ`, `= 1` on `thickening (δ/2) K ⊇ K`, `tsupport φ ⊆ cthickening δ K ⊆ B`.
  obtain ⟨δ, hδ, hδB⟩ := hK.exists_cthickening_subset_open hB hKB
  obtain ⟨φ, hφ, -, hφs, hφt⟩ := exists_contDiff_support_eq_eq_one_iff (n := ⊤)
    (isOpen_thickening (δ := δ) (E := K)) (isClosed_cthickening (δ := δ / 2) (E := K))
    (cthickening_subset_thickening' hδ (half_lt_self hδ) K)
  have htφ : tsupport φ ⊆ cthickening δ K := by
    rw [tsupport, hφs]
    exact closure_thickening_subset_cthickening δ K
  have hφ1 : ∀ x ∈ thickening (δ / 2) K, φ x = 1 :=
    fun x hx => (hφt x).1 (thickening_subset_cthickening _ _ hx)
  -- Step 2: `ψ = φ ω ∈ 𝒟ᵐ(B)`, so `F (ι ψ) = 0`.
  have hωs : ContDiff ℝ (⊤ : ℕ∞) (ω : DifferentialForm (Euclid P) m) := ω.property.1.1
  have hψt : tsupport (fun x => φ x • (ω : DifferentialForm (Euclid P) m) x) ⊆ tsupport φ :=
    tsupport_smul_subset_left _ _
  have hcφ : IsCompact (tsupport φ) :=
    hK.cthickening.of_isClosed_subset (isClosed_tsupport φ) htφ
  let ψ : TestFormOn B m := ⟨fun x => φ x • (ω : DifferentialForm (Euclid P) m) x,
    ⟨hφ.fun_smul hωs, hcφ.of_isClosed_subset (isClosed_tsupport _) hψt⟩, hψt.trans (htφ.trans hδB)⟩
  -- Step 3: `ω - ι ψ = (1 - φ) ω` vanishes on the open `thickening (δ/2) K ⊇ K`.
  have hdisj : Disjoint (tsupport ((ω - testFormOnInclusion hBU m ψ : TestFormOn U m) :
      DifferentialForm (Euclid P) m)) K := by
    refine Set.disjoint_right.2 fun x hx => notMem_tsupport_iff_eventuallyEq.2 ?_
    filter_upwards [isOpen_thickening.mem_nhds (self_subset_thickening (half_pos hδ) K hx)]
      with y hy
    simp [ψ, hφ1 y hy]
  -- Step 4: linearity, `F ω = F (ι ψ) + F (ω - ι ψ) = 0`.
  have h := hoff _ hdisj
  rw [map_sub F.toCurrent ω (testFormOnInclusion hBU m ψ), hin ψ, sub_zero] at h
  exact h
/-- **Simon 7.4.1** (`reg T`, chapter-07.txt lines 590–594) under `T = c T₀` in `V`: the
regularity transfer of the reduction to multiplicity one behind 7.4.2 (lines 605–610), as in the
proof of Ch. 5, 7.3 (chapter-05.txt lines 1388–1395).  If `V ⊆ U`, `c ∈ ℤ \ {0}`,
`T(ι ω) = c T₀(ω)` for every `ω ∈ 𝒟ⁿ(V)`, `y ∈ spt T` and `y ∈ reg T₀`, then `y ∈ reg T`: the
`ρ`, `M` and `ξ` with `T₀ = m[[M]]` in `B_ρ(y) ⊆ V` give `T = (c m)[[M]]` in `B_ρ(y)`, because a
form in `U` supported in `B_ρ(y)` is `ι` of a form in `V`. -/
theorem Submission.rsd_cmr_regularSet_transfer : ∀ (P n : ℕ) (U V : Set (Euclid P)) (hVU : V ⊆ U) (T : GeometricCurrentOn U n) (T₀ : GeometricCurrentOn V n) (c : ℤ) (y : Euclid P), c ≠ 0 → (∀ ω : TestFormOn V n, T (testFormOnInclusion hVU n ω) = (c : ℝ) * T₀ ω) → y ∈ T.support → y ∈ regularSet T₀ → y ∈ regularSet T := by
  intro P n U V hVU T T₀ c y hc hT hyT hy
  -- Step 1: `ρ, m, M, ξ` with `T₀ = m[[M]]` in `B_ρ(y) ⊆ V` (the clause `y ∈ spt T₀` is unused).
  obtain ⟨-, ρ, hρ, hball, m, M, ξ, hm, hyM, hM, hξ, hfin, hrep⟩ := hy
  -- Steps 2 and 4: the same `ρ, M, ξ`, multiplicity `c m ≠ 0`, and `B_ρ(y) ⊆ V ⊆ U`.
  refine ⟨hyT, ρ, hρ, hball.trans hVU, c * m, M, ξ, mul_ne_zero hc hm, hyM, hM, hξ, hfin, ?_⟩
  -- Step 3: `ω ∈ 𝒟ⁿ(U)` with `spt ω ⊆ B_ρ(y) ⊆ V` is `ι ω'` for `ω' ∈ 𝒟ⁿ(V)`, the same form.
  intro ω hω
  have hωV : (ω : DifferentialForm (Euclid P) n) ∈ testFormOnSubmodule V n :=
    ⟨ω.property.1, hω.trans hball⟩
  calc T ω = T (testFormOnInclusion hVU n ⟨ω, hωV⟩) := rfl
    _ = (c : ℝ) * T₀ ⟨ω, hωV⟩ := hT _
    _ = (c : ℝ) * (m * ∫ x in M, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n]) := by
      rw [hrep ⟨ω, hωV⟩ hω]
    _ = ((c * m : ℤ) : ℝ) * ∫ x in M, ξ x ((ω : DifferentialForm (Euclid P) n) x) ∂μHE[n] := by
      push_cast
      ring
/-- A unit orientation has operator norm at most `1` (step 1(c) of the proof that the weight of
`T = τ(M, θ, ξ)` is at most its mass).  If `ξ α = ±α(τ₁, …, τₙ)` for an orthonormal family `τ`,
then `|ξ α| = |α(τ)| ≤ ‖α‖ ∏ᵢ ‖τᵢ‖ = ‖α‖` for every `n`-covector `α`, so `‖ξ‖ ≤ 1`. -/
theorem Submission.rsd_mw_wlm_orient_opNorm_le_one : ∀ (P n : ℕ) (Q : Submodule ℝ (Euclid P)) (ξ : MultiVector P n), IsUnitOrientationOf ξ Q → ‖ξ‖ ≤ 1 := by
  rintro P n Q ξ ⟨τ, hτ, -, hξ⟩
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun α => ?_
  -- `|α(τ)| ≤ ‖α‖ ∏ᵢ ‖τᵢ‖ = ‖α‖`, as `‖τᵢ‖ = 1`
  have hbound : ‖α τ‖ ≤ ‖α‖ := by
    simpa [hτ.1] using α.le_opNorm τ
  rcases hξ with h | h
  · rw [h, one_mul]
    exact hbound
  · rw [h, norm_neg, one_mul]
    exact hbound
/-- An open `W ⊆ U` with `c < μ(W)`, `μ = θ Hⁿ⌞M`, contains an open `V` with `c < μ(V) < ∞`
(step 3 of the proof that the weight of `T = τ(M, θ, ξ)` is at most its mass).  Inner regularity
gives a compact `K ⊆ W` with `c < μ(K)`; an open `V ⊇ K` with compact `closure V ⊆ W` has
`μ(V) ≥ μ(K) > c` and `μ(V) ≤ μ(closure V) = ∫⁻_{M ∩ closure V} θ dHⁿ < ∞`. -/
theorem Submission.rsd_mw_wlm_exists_open_measure_between : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (W : Set (Euclid P)), IsOpen W → W ⊆ U → ∀ c : ℝ≥0∞, c < R.measure W → ∃ V : Set (Euclid P), IsOpen V ∧ V ⊆ W ∧ c < R.measure V ∧ R.measure V < ∞ := by
  intro P n U R W hW hWU c hc
  -- open sets are inner regular for closed sets, and closed sets for compact sets
  obtain ⟨K, hKW, hK, hcK⟩ := ((Measure.InnerRegularWRT.isCompact_isClosed R.measure).trans
    (Measure.InnerRegularWRT.of_pseudoMetrizableSpace R.measure)) hW c hc
  obtain ⟨V, hVo, hKV, hVW, hVc⟩ := exists_open_between_and_isCompact_closure hK hW hKW
  refine ⟨V, hVo, subset_closure.trans hVW, hcK.trans_le (measure_mono hKV), ?_⟩
  -- `μ(closure V) = ∫⁻_{M ∩ closure V} θ dHⁿ`, finite as `closure V` is a compact subset of `U`
  have hcl : R.measure (closure V) ≠ ∞ := by
    unfold IMRep.measure
    rw [withDensity_apply _ isClosed_closure.measurableSet,
      Measure.restrict_restrict isClosed_closure.measurableSet, Set.inter_comm]
    exact R.locallyIntegrable_mult _ hVc (hVW.trans hWU)
  exact (measure_mono subset_closure).trans_lt hcl.lt_top
/-- A continuous linear image of an a.e. unit-bounded measurable `n`-vector field is integrable:
if `ν` is finite, `ξ` is `ν`-a.e. strongly measurable with `‖ξ x‖ ≤ 1` for `ν`-a.e. `x`, and
`J : MultiVector P n →L[ℝ] Covector (Euclid P) n`, then `x ↦ J (ξ x)` is `ν`-integrable.
Continuity of `J` at `0` gives `δ > 0` with `‖J w‖ < 1` whenever `‖w‖ < δ`; applied to
`(δ / 2) • w`, homogeneity gives `‖J w‖ ≤ 2 / δ` on the closed unit ball.  Hence `J ∘ ξ` is
a.e. strongly measurable and a.e. dominated by the constant `2 / δ`, which is `ν`-integrable as
`ν` is finite. -/
theorem Submission.rsd_mw_wlm_integrable_clm_comp : ∀ (P n : ℕ) (ν : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n) (J : MultiVector P n →L[ℝ] Covector (Euclid P) n), IsFiniteMeasure ν → AEStronglyMeasurable ξ ν → (∀ᵐ x ∂ν, ‖ξ x‖ ≤ 1) → Integrable (fun x => J (ξ x)) ν := by
  intro P n ν ξ J hν hξ hξ1
  obtain ⟨δ, hδ, hJδ⟩ : ∃ δ > 0, ∀ w : MultiVector P n, ‖w‖ < δ → ‖J w‖ < 1 := by
    have hJc : @Continuous (MultiVector P n) (Covector (Euclid P) n)
        PseudoMetricSpace.toUniformSpace.toTopologicalSpace
        PseudoMetricSpace.toUniformSpace.toTopologicalSpace J := J.continuous
    obtain ⟨δ, hδ, h⟩ := Metric.continuous_iff.1 hJc 0 1 one_pos
    refine ⟨δ, hδ, fun w hw => ?_⟩
    have h' := h w (by convert hw using 1; exact dist_zero_right w)
    convert h' using 1
    rw [map_zero]
    exact (dist_zero_right _).symm
  have hbound : ∀ w : MultiVector P n, ‖w‖ ≤ 1 → ‖J w‖ ≤ 2 / δ := by
    intro w hw
    have h2 : ‖(δ / 2) • w‖ < δ := by
      calc ‖(δ / 2) • w‖ ≤ ‖δ / 2‖ * ‖w‖ := ContinuousLinearMap.opNorm_smul_le _ _
        _ ≤ δ / 2 * 1 := by
          rw [Real.norm_of_nonneg (by positivity)]
          exact mul_le_mul_of_nonneg_left hw (by positivity)
        _ < δ := by linarith
    have := hJδ _ h2
    rw [map_smul, norm_smul, Real.norm_of_nonneg (by positivity)] at this
    rw [le_div_iff₀ hδ]
    nlinarith
  refine Integrable.mono' (integrable_const (2 / δ)) (J.continuous.comp_aestronglyMeasurable hξ) ?_
  filter_upwards [hξ1] with x hx using hbound _ hx
/-- If `T = τ(M, θ, ξ)` and `spt ω ⊆ V`, then `T(ω) = ∫ ⟨ω, ξ⟩ d(μ⌞V)` with `μ = θ Hⁿ⌞M`
(step 7 of the proof that the weight of `T = τ(M, θ, ξ)` is at most its mass).  The integrand
vanishes off `spt ω ⊆ V`, so restricting `μ` to `V` changes nothing; writing the density `θ` as
a measurable `ℝ≥0`-valued function turns `∫ ⟨ω, ξ⟩ dμ` into `∫_M θ ⟨ω, ξ⟩ dHⁿ = T(ω)`. -/
theorem Submission.rsd_mw_wlm_eval_eq_integral_restrict : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), R.Represents T → ∀ (V : Set (Euclid P)) (ω : TestFormOn U n), tsupport (ω : DifferentialForm (Euclid P) n) ⊆ V → T ω = ∫ x, R.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂(R.measure.restrict V) := by
  intro P n U T R hR V ω hωV
  rw [hR ω, setIntegral_eq_integral_of_forall_compl_eq_zero]
  · -- `μ = (Hⁿ⌞M).withDensity θ` with `θ` read as a measurable `ℝ≥0`-valued density
    have hμ : R.measure = (μHE[n].restrict R.carrier).withDensity
        (fun x => ((R.mult x : NNReal) : ℝ≥0∞)) := by
      simp [IMRep.measure]
    have hmeas : Measurable fun x => (R.mult x : NNReal) :=
      measurable_from_nat.comp R.measurable_mult
    rw [hμ, integral_withDensity_eq_integral_smul hmeas]
    simp [IMRep.action, NNReal.smul_def]
  · -- off `V`, hence off `spt ω`, the form vanishes and so does `⟨ω, ξ⟩`
    intro x hx
    have h0 : (ω : DifferentialForm (Euclid P) n) x = 0 :=
      image_eq_zero_of_notMem_tsupport fun h => hx (hωV h)
    simp [h0]
/-- Integral lower bound for `⟨ω, ξ⟩` from an `L¹`-close dual field.  Write
`N = covectorEuclideanNorm`.  Let `ν` be finite, `ξ` `ν`-a.e. strongly measurable and `ω`
continuous with `N (ω x) ≤ 1`; suppose that, for `ν`-a.e. `x`, `|ξ x α| ≤ N α` for every `α` and
`ξ x (β x) = 1`.  If `∫⁻ N (ω − β) dν < ε`, then `ν(ℝᴾ) − ε < ∫ ξ(ω) dν`.
The function `h = ξ(ω)` is a.e. strongly measurable (continuous bilinear evaluation) and a.e.
bounded by `N ∘ ω ≤ 1`, hence integrable.  A.e., `h ≤ 1` and
`h = ξ(β) + ξ(ω − β) ≥ 1 − N (ω − β)`, so `0 ≤ 1 − h ≤ N (ω − β)`.  Therefore
`ofReal (∫ (1 − h) dν) = ∫⁻ ofReal (1 − h) dν ≤ ∫⁻ ofReal (N (ω − β)) dν < ofReal ε`, whence
`ν(ℝᴾ) − ∫ h dν = ∫ (1 − h) dν < ε`.  No measurability of `β` is needed: the comparison is made
only between lower integrals. -/
theorem Submission.rsd_mw_wlm_sub_lt_integral : ∀ (P n : ℕ) (ν : Measure (Euclid P)) (ξ : Euclid P → MultiVector P n) (β ω : Euclid P → Covector (Euclid P) n) (ε : ℝ), IsFiniteMeasure ν → AEStronglyMeasurable ξ ν → Continuous ω → (∀ x, covectorEuclideanNorm (ω x) ≤ 1) → (∀ᵐ x ∂ν, (∀ α : Covector (Euclid P) n, |ξ x α| ≤ covectorEuclideanNorm α) ∧ ξ x (β x) = 1) → ∫⁻ x, ENNReal.ofReal (covectorEuclideanNorm (ω x - β x)) ∂ν < ENNReal.ofReal ε → (ν univ).toReal - ε < ∫ x, ξ x (ω x) ∂ν := by
  intro P n ν ξ β ω ε hν hξ hω hωN hG hlt
  have hhm : AEStronglyMeasurable (fun x => ξ x (ω x)) ν :=
    isBoundedBilinearMap_apply.continuous.comp_aestronglyMeasurable
      (hξ.prodMk hω.aestronglyMeasurable)
  have hh_int : Integrable (fun x => ξ x (ω x)) ν := by
    refine Integrable.mono' (integrable_const (1 : ℝ)) hhm ?_
    filter_upwards [hG] with x hx
    rw [Real.norm_eq_abs]
    exact (hx.1 (ω x)).trans (hωN x)
  have hpt : ∀ᵐ x ∂ν, 0 ≤ 1 - ξ x (ω x) ∧
      1 - ξ x (ω x) ≤ covectorEuclideanNorm (ω x - β x) := by
    filter_upwards [hG] with x hx
    have hsplit : ξ x (ω x) = ξ x (β x) + ξ x (ω x - β x) := by
      rw [← map_add, add_sub_cancel]
    have h1 := (abs_le.1 ((hx.1 (ω x)).trans (hωN x))).2
    have h2 := (abs_le.1 (hx.1 (ω x - β x))).1
    constructor
    · linarith
    · rw [hsplit, hx.2]
      linarith
  have h1h_int : Integrable (fun x => 1 - ξ x (ω x)) ν := (integrable_const 1).sub hh_int
  have hint_eq : ∫ x, (1 - ξ x (ω x)) ∂ν = (ν univ).toReal - ∫ x, ξ x (ω x) ∂ν := by
    rw [integral_sub (integrable_const 1) hh_int, integral_const, smul_eq_mul, mul_one,
      measureReal_def]
  have hofreal : ENNReal.ofReal (∫ x, (1 - ξ x (ω x)) ∂ν) < ENNReal.ofReal ε := by
    rw [ofReal_integral_eq_lintegral_ofReal h1h_int (hpt.mono fun x hx => hx.1)]
    calc ∫⁻ x, ENNReal.ofReal (1 - ξ x (ω x)) ∂ν
        ≤ ∫⁻ x, ENNReal.ofReal (covectorEuclideanNorm (ω x - β x)) ∂ν :=
          lintegral_mono_ae (hpt.mono fun x hx => ENNReal.ofReal_le_ofReal hx.2)
      _ < ENNReal.ofReal ε := hlt
  have hlt' := (ENNReal.ofReal_lt_ofReal_iff'.1 hofreal).1
  linarith
/-- **Simon Ch. 6, Remark 2.6(a)–(b)** for the Euclidean coefficient norm: a unit orientation
`ξ = ±τ₁ ∧ ⋯ ∧ τₙ` (`τ` orthonormal) has `|ξ(α)| ≤ |α|`, and the single continuous linear map
`J(w) = Σ_I w(e^I) e^I` (`I` strictly increasing) has `|J(ξ)| = 1` and `ξ(J(ξ)) = 1`.  Here
`e^I(v) = det(⟨e_{I(k)}, vⱼ⟩)`, every covector expands as `α = Σ_I α(e_I) e^I`, and
`e^I(e_K) = δ_IK`.  Expanding `γ(v) = det(⟨τₖ, vⱼ⟩)` at `v = τ` gives the Cauchy–Binet identity
`Σ_I e^I(τ)² = 1`; with Cauchy–Schwarz, `|α(τ)| ≤ |α|`. -/
theorem Submission.rsd_mw_unit_orientation_dual : ∀ (P n : ℕ), ∃ J : MultiVector P n →L[ℝ] Covector (Euclid P) n, ∀ (ξ : MultiVector P n) (Q : Submodule ℝ (Euclid P)), IsUnitOrientationOf ξ Q → (∀ α : Covector (Euclid P) n, |ξ α| ≤ covectorEuclideanNorm α) ∧ covectorEuclideanNorm (J ξ) = 1 ∧ ξ (J ξ) = 1 := by
  intro P n
  -- `D u v = Σ_σ sgn σ ∏ₖ ⟨uₖ, v_{σ k}⟩ = det(⟨uₖ, vⱼ⟩)`, a continuous alternating map as an
  -- alternatization; `e^I = D (e ∘ I)` and `γ = D τ`
  let D : (Fin n → Euclid P) → Covector (Euclid P) n := fun u =>
    ContinuousMultilinearMap.alternatization
      ((ContinuousMultilinearMap.mkPiAlgebra ℝ (Fin n) ℝ).compContinuousLinearMap
        fun k => innerSL ℝ (u k))
  have hD : ∀ u v, D u v =
      ∑ σ : Equiv.Perm (Fin n), Equiv.Perm.sign σ • ∏ k, inner ℝ (u k) (v (σ k)) := by
    intro u v
    simp only [D, ContinuousMultilinearMap.alternatization_apply_apply,
      ContinuousMultilinearMap.compContinuousLinearMap_apply,
      ContinuousMultilinearMap.mkPiAlgebra_apply, innerSL_apply_apply, Function.comp_apply]
  -- `D u v = D v u` (determinant of the transpose): substitute `σ ↦ σ⁻¹` and `k ↦ σ k`
  have hDsymm : ∀ u v, D u v = D v u := by
    intro u v
    rw [hD, hD]
    refine Fintype.sum_equiv (Equiv.inv (Equiv.Perm (Fin n))) _ _ fun σ => ?_
    rw [Equiv.inv_apply, Equiv.Perm.sign_inv,
      ← Equiv.prod_comp σ (fun k => inner ℝ (v k) (u (σ⁻¹ k)))]
    simp only [Equiv.Perm.coe_inv, Equiv.symm_apply_apply, real_inner_comm]
  -- `D u u = 1` for orthonormal `u`: only `σ = 1` contributes
  have hD1 : ∀ u, Orthonormal ℝ u → D u u = 1 := by
    intro u hu
    rw [hD, Finset.sum_eq_single (1 : Equiv.Perm (Fin n))]
    · rw [Equiv.Perm.sign_one, one_smul]
      refine Finset.prod_eq_one fun k _ => ?_
      rw [Equiv.Perm.coe_one, id, real_inner_self_eq_norm_sq, hu.norm_eq_one, one_pow]
    · intro σ _ hσ
      obtain ⟨k, hk⟩ : ∃ k, σ k ≠ k := by
        by_contra! h
        exact hσ (Equiv.ext h)
      rw [Finset.prod_eq_zero (Finset.mem_univ k) (hu.inner_eq_zero hk.symm), smul_zero]
    · exact fun h => absurd (Finset.mem_univ _) h
  -- step 2: `e^I(e_K) = δ_IK` for strictly increasing `I`, `K`; a nonzero term forces
  -- `K ∘ σ = I`, so `range I = range K` and `I = K`
  let e := EuclideanSpace.basisFun (Fin P) ℝ
  have he : ∀ i j, inner ℝ (e i) (e j) = if i = j then (1 : ℝ) else 0 :=
    orthonormal_iff_ite.mp e.orthonormal
  have hK : ∀ I K : Fin n → Fin P, StrictMono I → StrictMono K →
      D (fun k => e (I k)) (fun k => e (K k)) = if I = K then 1 else 0 := by
    intro I K hI hK
    split_ifs with hIK
    · subst hIK
      exact hD1 _ (e.orthonormal.comp I hI.injective)
    · rw [hD]
      refine Finset.sum_eq_zero fun σ _ => ?_
      rw [Finset.prod_eq_zero_iff.mpr, smul_zero]
      by_contra! h
      apply hIK
      have hKσ : K ∘ σ = I := funext fun k => by
        have := h k (Finset.mem_univ k)
        rw [he] at this
        split_ifs at this with hk
        · exact hk.symm
        · exact absurd rfl this
      rw [← StrictMono.range_inj_of_wellFoundedLT hI hK, ← hKσ, EquivLike.range_comp]
  -- step 1: `α = Σ_{I ∈ S} α(e_I) e^I`; both sides are alternating, so compare them on `e ∘ f`
  -- for injective `f`, and write `f = (f ∘ σ) ∘ σ⁻¹` with `f ∘ σ` strictly increasing
  let S : Finset (Fin n → Fin P) := Finset.univ.filter StrictMono
  have hE : ∀ α : Covector (Euclid P) n,
      α = ∑ I ∈ S, α (fun k => e (I k)) • D (fun k => e (I k)) := by
    intro α
    apply ContinuousAlternatingMap.toAlternatingMap_injective
    refine e.toBasis.ext_alternating fun f hf => ?_
    simp only [OrthonormalBasis.coe_toBasis, ContinuousAlternatingMap.coe_toAlternatingMap]
    set σ := Tuple.sort f
    have hfσ : StrictMono (f ∘ σ) :=
      (Tuple.monotone_sort f).strictMono_of_injective (hf.comp σ.injective)
    have hperm : ∀ β : Covector (Euclid P) n,
        β (fun k => e (f k)) = Equiv.Perm.sign σ⁻¹ • β (fun k => e ((f ∘ σ) k)) := by
      intro β
      have : (fun k => e (f k)) = (fun k => e ((f ∘ σ) k)) ∘ ⇑(σ⁻¹) := by
        funext k
        simp
      rw [this]
      exact β.toAlternatingMap.map_perm _ _
    rw [hperm α, hperm, ContinuousAlternatingMap.sum_apply, Finset.sum_eq_single (f ∘ σ)]
    · rw [ContinuousAlternatingMap.smul_apply, hK _ _ hfσ hfσ, ite_eq_left rfl, smul_eq_mul,
        mul_one]
    · intro I hI hIf
      rw [ContinuousAlternatingMap.smul_apply, hK _ _ (Finset.mem_filter.mp hI).2 hfσ,
        ite_eq_right hIf, smul_zero]
    · exact fun h => absurd (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hfσ⟩) h
  -- `|β| = (Σ_{I ∈ S} β(e_I)²)^{1/2}`
  have hnorm : ∀ β : Covector (Euclid P) n,
      covectorEuclideanNorm β = Real.sqrt (∑ I ∈ S, β (fun k => e (I k)) ^ 2) := by
    intro β
    rw [covectorEuclideanNorm, Finset.sum_filter]
  -- step 3 (Cauchy–Binet): `Σ_{I ∈ S} e^I(τ)² = 1` for orthonormal `τ`; evaluate the expansion
  -- of `γ = D τ` at `τ`, using `γ(τ) = 1` and `γ(e_I) = e^I(τ)`
  have hCB : ∀ τ : Fin n → Euclid P, Orthonormal ℝ τ →
      ∑ I ∈ S, D (fun k => e (I k)) τ ^ 2 = 1 := by
    intro τ hτ
    have h := congrArg (fun β : Covector (Euclid P) n => β τ) (hE (D τ))
    simp only [ContinuousAlternatingMap.sum_apply, ContinuousAlternatingMap.smul_apply,
      smul_eq_mul, hD1 τ hτ] at h
    rw [h]
    refine Finset.sum_congr rfl fun I _ => ?_
    rw [hDsymm τ, sq]
  -- step 4: `J w = Σ_{I ∈ S} w(e^I) e^I`
  refine ⟨∑ I ∈ S, (ContinuousLinearMap.apply ℝ ℝ (D fun k => e (I k))).smulRight
    (D fun k => e (I k)), ?_⟩
  have hJ : ∀ w : MultiVector P n, (∑ I ∈ S, (ContinuousLinearMap.apply ℝ ℝ
      (D fun k => e (I k))).smulRight (D fun k => e (I k))) w =
      ∑ I ∈ S, w (D fun k => e (I k)) • D fun k => e (I k) := by
    intro w
    simp only [sum_apply, ContinuousLinearMap.smulRight_apply,
      ContinuousLinearMap.apply_apply]
  -- step 5: `ξ(α) = s α(τ)` with `s = ±1`
  rintro ξ Q ⟨τ, hτ, -, hξ⟩
  have hξ2 : ∀ α β : Covector (Euclid P) n, ξ α * ξ β = α τ * β τ := by
    intro α β
    rcases hξ with h | h
    · rw [h, h]
    · rw [h, h, neg_mul_neg]
  have hξabs : ∀ α : Covector (Euclid P) n, |ξ α| = |α τ| := by
    intro α
    rcases hξ with h | h
    · rw [h]
    · rw [h, abs_neg]
  have hCBτ := hCB τ hτ
  refine ⟨fun α => ?_, ?_, ?_⟩
  · -- (i) `|ξ(α)| = |Σ_I α(e_I) e^I(τ)| ≤ |α| (Σ_I e^I(τ)²)^{1/2} = |α|`
    rw [hξabs, hnorm]
    apply Real.abs_le_sqrt
    have h := congrArg (fun β : Covector (Euclid P) n => β τ) (hE α)
    simp only [ContinuousAlternatingMap.sum_apply, ContinuousAlternatingMap.smul_apply,
      smul_eq_mul] at h
    rw [h]
    calc (∑ I ∈ S, α (fun k => e (I k)) * D (fun k => e (I k)) τ) ^ 2
        ≤ (∑ I ∈ S, α (fun k => e (I k)) ^ 2) * ∑ I ∈ S, D (fun k => e (I k)) τ ^ 2 :=
          Finset.sum_mul_sq_le_sq_mul_sq _ _ _
      _ = ∑ I ∈ S, α (fun k => e (I k)) ^ 2 := by rw [hCBτ, mul_one]
  · -- (ii) `J(ξ)(e_K) = ξ(e^K)`, so `|J(ξ)|² = Σ_K ξ(e^K)² = Σ_K e^K(τ)² = 1`
    rw [hnorm, hJ]
    have : ∑ K ∈ S, (∑ I ∈ S, ξ (D fun k => e (I k)) • D fun k => e (I k))
        (fun k => e (K k)) ^ 2 = 1 := by
      rw [← hCBτ]
      refine Finset.sum_congr rfl fun K hK' => ?_
      rw [ContinuousAlternatingMap.sum_apply, Finset.sum_eq_single K]
      · rw [ContinuousAlternatingMap.smul_apply, hK _ _ (Finset.mem_filter.mp hK').2
          (Finset.mem_filter.mp hK').2, ite_eq_left rfl, smul_eq_mul, mul_one, sq, sq, hξ2]
      · intro I hI hIK
        rw [ContinuousAlternatingMap.smul_apply, hK _ _ (Finset.mem_filter.mp hI).2
          (Finset.mem_filter.mp hK').2, ite_eq_right hIK, smul_zero]
      · exact fun h => absurd hK' h
    rw [this, Real.sqrt_one]
  · -- (iii) `ξ(J(ξ)) = Σ_I ξ(e^I)² = Σ_I e^I(τ)² = 1`
    rw [hJ, map_sum, ← hCBτ]
    refine Finset.sum_congr rfl fun I _ => ?_
    rw [map_smul, smul_eq_mul, hξ2, sq]
/-- **Simon Ch. 6, 1.2 (p. 132)**: `Λⁿ(ℝᴾ)` is finite-dimensional.  An `n`-covector `α` is
determined by its values `α(e_{I(1)}, …, e_{I(n)})` on tuples of standard basis vectors, so
`α ↦ (α(e ∘ I))_{I : Fin n → Fin P}` is an injective linear map into `ℝ^(Fin n → Fin P)`. -/
theorem Submission.idtp_cse_fc_covector_finiteDimensional : ∀ (P n : ℕ), FiniteDimensional ℝ (Covector (Euclid P) n) := by
  intro P n
  -- the standard basis `e` of `ℝᴾ`
  let e := (EuclideanSpace.basisFun (Fin P) ℝ).toBasis
  -- `L α = (α(e ∘ I))_I`, linear since addition and scaling of covectors are pointwise
  let L : Covector (Euclid P) n →ₗ[ℝ] ((Fin n → Fin P) → ℝ) :=
    { toFun := fun α I => α fun i => e (I i)
      map_add' := fun α β => rfl
      map_smul' := fun c α => rfl }
  -- `L α = L β` identifies `α` and `β` on distinct basis vectors, hence everywhere
  refine FiniteDimensional.of_injective L fun α β h => ?_
  exact ContinuousAlternatingMap.toAlternatingMap_injective
    (e.ext_alternating fun v _ => congr_fun h v)
/-- **Simon Ch. 6, 1.1 and 1.7**: a unit orientation `ξ = ±τ₁ ∧ ⋯ ∧ τₙ` of a plane (`τ`
orthonormal) is nonzero.  The covector `δ(w) = Σ_σ sgn σ ∏ᵢ ⟨τᵢ, w_{σ(i)}⟩ = det(⟨τᵢ, wⱼ⟩)`, the
alternatization of `w ↦ ∏ᵢ ⟨τᵢ, wᵢ⟩`, has `δ(τ) = 1` by orthonormality, so `|ξ(δ)| = 1`. -/
theorem Submission.idtp_cse_fc_unit_orientation_ne_zero : ∀ (P n : ℕ) (ξ : MultiVector P n) (Q : Submodule ℝ (Euclid P)), IsUnitOrientationOf ξ Q → ξ ≠ 0 := by
  rintro P n ξ Q ⟨τ, hτ, -, hξ⟩ h0
  -- `δ(τ) = 1`: the term `σ = 1` is `∏ᵢ ‖τᵢ‖² = 1`, and for `σ ≠ 1` some factor
  -- `⟨τᵢ, τ_{σ(i)}⟩` with `σ(i) ≠ i` vanishes
  obtain ⟨δ, hδ⟩ : ∃ δ : Covector (Euclid P) n, δ τ = 1 := by
    refine ⟨ContinuousMultilinearMap.alternatization
      ((ContinuousMultilinearMap.mkPiAlgebra ℝ (Fin n) ℝ).compContinuousLinearMap
        fun i => innerSL ℝ (τ i)), ?_⟩
    rw [ContinuousMultilinearMap.alternatization_apply_apply,
      Finset.sum_eq_single (1 : Equiv.Perm (Fin n))]
    · rw [Equiv.Perm.sign_one, one_smul, Equiv.Perm.coe_one, Function.comp_id,
        ContinuousMultilinearMap.compContinuousLinearMap_apply,
        ContinuousMultilinearMap.mkPiAlgebra_apply]
      refine Finset.prod_eq_one fun i _ => ?_
      rw [innerSL_apply_apply, real_inner_self_eq_norm_sq, hτ.norm_eq_one, one_pow]
    · intro σ _ hσ
      obtain ⟨i, hi⟩ : ∃ i, σ i ≠ i := by
        by_contra! h
        exact hσ (Equiv.ext h)
      rw [ContinuousMultilinearMap.compContinuousLinearMap_apply,
        ContinuousMultilinearMap.mkPiAlgebra_apply,
        Finset.prod_eq_zero (Finset.mem_univ i) ?_, smul_zero]
      rw [innerSL_apply_apply, Function.comp_apply]
      exact hτ.inner_eq_zero hi.symm
    · exact fun h => absurd (Finset.mem_univ _) h
  -- `ξ = 0` would give `0 = |ξ(δ)| = |δ(τ)| = 1`
  have h : ‖ξ δ‖ = ‖δ τ‖ := by
    rcases hξ with h | h
    · rw [h δ]
    · rw [h δ, norm_neg]
  rw [h0, hδ, zero_apply, norm_zero, norm_one] at h
  exact zero_ne_one h

/-- **Simon Ch. 6, 3.2(3)**, one covector at a time: if `C = τ(M, θ, ξ)` (in `ℝᴾ`) vanishes on the
open set `W`, then `ξ(x)(α) = 0` for `μ_C`-a.e. `x ∈ W`.  Here `f = ξ(·)(α)` is a.e. bounded by
`‖α‖` and `μ_C = θ Hⁿ⌞M` is finite on compact sets, so `f` is locally `μ_C`-integrable on `W`; for
smooth `g` with compact support in `W`, `∫ g f dμ_C = τ(M, θ, ξ)(g α) = C(g α) = 0`, and the
fundamental lemma of the calculus of variations gives `f = 0` a.e. on `W`. -/
theorem Submission.idtp_cse_fc_orient_apply_ae_eq_zero : ∀ (P n : ℕ) (W : Set (Euclid P)) (C : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n), R.Represents C → IsOpen W → C.VanishesOn W → ∀ α : Covector (Euclid P) n, ∀ᵐ x ∂R.measure, x ∈ W → R.orient x α = 0 := by
  intro P n W C R hRC hW hC α
  -- `μ_C = θHⁿ⌞M ≪ Hⁿ⌞M`
  have hac : R.measure ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
  -- `|ξ(x)(α)| = |α(τ)| ≤ ‖α‖ ∏ᵢ ‖τᵢ‖ = ‖α‖` wherever `ξ(x)` is a unit orientation
  have hbound : ∀ᵐ x ∂R.measure, ‖R.orient x α‖ ≤ ‖α‖ := by
    refine hac.ae_le ?_
    filter_upwards [R.orients] with x hx
    obtain ⟨Q, -, τ, hτ, -, hξ⟩ := hx
    have h1 : ‖R.orient x α‖ = ‖α τ‖ := by
      rcases hξ with h | h
      · rw [h α]
      · rw [h α, norm_neg]
    rw [h1]
    calc ‖α τ‖ ≤ ‖α‖ * ∏ i, ‖τ i‖ := ContinuousAlternatingMap.le_opNorm α τ
      _ = ‖α‖ := by rw [Finset.prod_eq_one fun i _ => hτ.norm_eq_one i, mul_one]
  -- `f = ξ(·)(α)` is the continuous evaluation at `α` composed with `ξ`
  have hmeas : AEStronglyMeasurable (fun x => R.orient x α) R.measure :=
    ((ContinuousLinearMap.apply ℝ ℝ α).continuous.comp_aestronglyMeasurable
      R.aestronglyMeasurable_orient).mono_ac hac
  -- `μ_C(K) = ∫_{M ∩ K} θ dHⁿ < ∞` for compact `K`
  have hfin : ∀ K : Set (Euclid P), IsCompact K → R.measure K < ∞ := by
    intro K hK
    rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
      Measure.restrict_restrict hK.measurableSet, inter_comm]
    exact (R.locallyIntegrable_mult K hK (subset_univ K)).lt_top
  have hli : LocallyIntegrableOn (fun x => R.orient x α) W R.measure := by
    refine (locallyIntegrableOn_iff hW.isLocallyClosed).2 fun K hKW hK => ?_
    exact IntegrableOn.of_bound (hfin K hK) hmeas.restrict ‖α‖ (ae_restrict_of_ae hbound)
  -- `∫ g f dμ_C = τ(M, θ, ξ)(g α) = C(g α) = 0`, as `g α` is a test form supported in `W`
  refine hW.ae_eq_zero_of_integral_contDiff_smul_eq_zero hli fun g hg hgc hgW => ?_
  let ω : TestFormOn (univ : Set (Euclid P)) n :=
    ⟨fun y => g y • α, ⟨hg.smul contDiff_const, hgc.smul_right⟩, subset_univ _⟩
  have h0 : C ω = 0 := hC ω ((tsupport_smul_subset_left _ _).trans hgW)
  rw [hRC ω] at h0
  have hθ : (fun x => (R.mult x : ℝ≥0∞)) = fun x => ((R.mult x : NNReal) : ℝ≥0∞) := by
    funext x; simp
  have hmθ : Measurable fun x => (R.mult x : NNReal) :=
    (measurable_from_nat (f := fun k : ℕ => (k : NNReal))).comp R.measurable_mult
  rw [IMRep.measure, hθ, integral_withDensity_eq_integral_smul hmθ, ← h0, IMRep.action]
  refine integral_congr_ae (Eventually.of_forall fun x => ?_)
  simp only [ω, NNReal.smul_def, NNReal.coe_natCast, smul_eq_mul, map_smul]
/-- The flat current `c[[Q']]`, `Q' = span τ` (Simon 6.2.2 for a plane, as in the proof of 7.3.3):
`R = (Q', |c|, sgn c · τ₁ ∧ ⋯ ∧ τₙ)` is an integer multiplicity triple in `ℝᴾ` with
`τ(R)(ω) = c ∫_{Q'} ω(τ) dHⁿ` and `μ_R = |c| Hⁿ⌞Q'`.  `Q'` is an `n`-plane (`τ` is linearly
independent), closed, the range of a linear isometry `ℝⁿ → ℝᴾ` (so countably `n`-rectifiable),
locally `Hⁿ`-finite, and is its own approximate tangent space at each of its points. -/
theorem Submission.idtp_cse_etp_plane_imrep : ∀ (P n : ℕ) (τ : Fin n → Euclid P) (c : ℤ), Orthonormal ℝ τ → c ≠ 0 → ∃ R : IMRep (univ : Set (Euclid P)) n, (∀ ω : DifferentialForm (Euclid P) n, R.action ω = (c : ℝ) * ∫ x in (Submodule.span ℝ (Set.range τ) : Set (Euclid P)), ω x τ ∂μHE[n]) ∧ R.measure = (c.natAbs : ℝ≥0∞) • (μHE[n] : Measure (Euclid P)).restrict (Submodule.span ℝ (Set.range τ) : Set (Euclid P)) := by
  intro P n τ c hτ hc
  -- the plane `Q = span τ` has dimension `n` and is closed, hence Borel
  have hQrank : Module.finrank ℝ (Submodule.span ℝ (Set.range τ)) = n := by
    rw [finrank_span_eq_card hτ.linearIndependent, Fintype.card_fin]
  have hQmeas : MeasurableSet (Submodule.span ℝ (Set.range τ) : Set (Euclid P)) :=
    (Submodule.span ℝ (Set.range τ)).closed_of_finiteDimensional.measurableSet
  set Q := Submodule.span ℝ (Set.range τ)
  -- `Q` is the range of a linear isometry `ℝⁿ → ℝᴾ`, hence countably `n`-rectifiable
  have hrect : CountablyRectifiable n (Q : Set (Euclid P)) := by
    let e : EuclideanSpace ℝ (Fin n) ≃ₗᵢ[ℝ] Q :=
      ((stdOrthonormalBasis ℝ Q).reindex (finCongr hQrank)).repr.symm
    have hrange : Set.range (Q.subtypeₗᵢ.comp e.toLinearIsometry) = (Q : Set (Euclid P)) := by
      ext y
      constructor
      · rintro ⟨v, rfl⟩
        exact (e v).2
      · intro hy
        exact ⟨e.symm ⟨y, hy⟩, by simp⟩
    rw [← hrange]
    exact Poincare.SimonGMT.Chapter03.countablyRectifiable_range
      (Q.subtypeₗᵢ.comp e.toLinearIsometry).lipschitzWith
  -- the orientation `sgn c · τ₁ ∧ ⋯ ∧ τₙ`, i.e. `α ↦ sgn c · α(τ)`
  let ξ : MultiVector P n := ((Int.sign c : ℤ) : ℝ) • ContinuousAlternatingMap.apply ℝ (Euclid P) ℝ τ
  have hξ : ∀ α : Covector (Euclid P) n, ξ α = ((Int.sign c : ℤ) : ℝ) * α τ := fun α => rfl
  have hcs : ((c.natAbs : ℕ) : ℝ) * ((Int.sign c : ℤ) : ℝ) = (c : ℝ) := by
    have h : ((c.sign * (c.natAbs : ℤ) : ℤ) : ℝ) = (c : ℝ) := by rw [Int.sign_mul_natAbs]
    rw [Int.cast_mul, Int.cast_natCast, mul_comm] at h
    exact h
  refine ⟨{ carrier := (Q : Set (Euclid P))
            mult := fun _ => c.natAbs
            orient := fun _ => ξ
            measurableSet_carrier := hQmeas
            carrier_subset := subset_univ _
            rectifiable := hrect
            measurable_mult := measurable_const
            mult_pos := fun _ _ => Int.natAbs_pos.mpr hc
            locallyIntegrable_mult := ?_
            aestronglyMeasurable_orient := aestronglyMeasurable_const
            orients := ?_ }, ?_, ?_⟩
  · -- local finiteness: `Hⁿ⌞Q` is finite on compact sets
    intro K hK _
    have := Poincare.SimonGMT.Chapter03.regular_euclideanHausdorffMeasure_restrict_submodule
      (E := Euclid P) hQrank
    have hfin : (μHE[n] : Measure (Euclid P)).restrict (Q : Set (Euclid P)) K < ∞ :=
      hK.measure_lt_top
    rw [Measure.restrict_apply' hQmeas, Set.inter_comm] at hfin
    simp only [lintegral_const, Measure.restrict_apply_univ]
    exact ENNReal.mul_ne_top (ENNReal.natCast_ne_top _) hfin.ne
  · -- every point of `Q` has approximate tangent space `Q`, oriented by `±τ`
    filter_upwards [Poincare.SimonGMT.Chapter03.ae_hasApproximateTangentSpaceAt_submodule
      (E := Euclid P) hQrank] with x hx
    refine ⟨Q, hx, τ, hτ, rfl, ?_⟩
    rcases lt_or_gt_of_ne hc with hneg | hpos
    · right
      intro α
      show ξ α = -α τ
      rw [hξ, Int.sign_eq_neg_one_of_neg hneg]
      push_cast
      ring
    · left
      intro α
      show ξ α = α τ
      rw [hξ, Int.sign_eq_one_of_pos hpos]
      push_cast
      ring
  · -- the action: `|c| · sgn c = c`
    intro ω
    show ∫ x in (Q : Set (Euclid P)), ((c.natAbs : ℕ) : ℝ) * ξ (ω x) ∂μHE[n] = _
    rw [← integral_const_mul]
    congr 1
    funext x
    rw [hξ, ← mul_assoc, hcs]
  · -- the measure: a constant density
    show ((μHE[n] : Measure (Euclid P)).restrict (Q : Set (Euclid P))).withDensity
      (fun _ => ((c.natAbs : ℕ) : ℝ≥0∞)) = _
    exact withDensity_const _
/-- **`μ_C`-a.e. point lies in `spt C`** (Simon 6.2.11 with 6.3.2(3), the half
`spt μ_C ⊆ spt C` of `spt C = spt μ_C`).  Let `C = τ(M, θ, ξ)` in `ℝᴾ`.  If `C` vanishes on the
open set `W`, then for a basis `α₁, …, α_N` of `Λⁿ(ℝᴾ)`, `μ_C`-a.e. `x ∈ W` has `ξ(x)(αₖ) = 0` for
every `k` (`idtp_cse_fc_orient_apply_ae_eq_zero`), i.e. `ξ(x) = 0`, while `ξ ≠ 0` holds
`μ_C`-a.e. (`idtp_cse_fc_unit_orientation_ne_zero`); so `μ_C(W) = 0`.  The zero region
`(spt C)ᶜ` is a union of such `W`, hence (`ℝᴾ` being second countable) of countably many of them,
and is `μ_C`-null. -/
theorem Submission.idtp_cse_fc_ae_mem_support : ∀ (P n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n), R.Represents C → ∀ᵐ x ∂R.measure, x ∈ C.support := by
  intro P n C R hRC
  -- (i) `μ_C(W) = 0` for every open `W` on which `C` vanishes
  have hW : ∀ W : Set (Euclid P), IsOpen W → C.VanishesOn W → R.measure W = 0 := by
    intro W hWo hCW
    -- `μ_C ≪ Hⁿ⌞M`, and `Hⁿ⌞M`-a.e. `ξ(x)` is a unit orientation, hence nonzero
    have hac : R.measure ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
    have hξ : ∀ᵐ x ∂R.measure, R.orient x ≠ 0 :=
      hac.ae_le <| R.orients.mono fun x ⟨Q, _, hQ⟩ =>
        Submission.idtp_cse_fc_unit_orientation_ne_zero P n _ Q hQ
    -- a basis `α₁, …, α_N` of the finite-dimensional space `Λⁿ(ℝᴾ)`
    have := Submission.idtp_cse_fc_covector_finiteDimensional P n
    let α := Module.finBasis ℝ (Covector (Euclid P) n)
    have hα : ∀ᵐ x ∂R.measure, ∀ k, x ∈ W → R.orient x (α k) = 0 :=
      ae_all_iff.2 fun k =>
        Submission.idtp_cse_fc_orient_apply_ae_eq_zero P n W C R hRC hWo hCW (α k)
    -- such an `x ∈ W` has `ξ(x) = 0`, as `ξ(x)` vanishes on a basis
    refine measure_eq_zero_iff_ae_notMem.2 ?_
    filter_upwards [hξ, hα] with x hx0 hxα hxW
    exact hx0 (ContinuousLinearMap.coe_injective (α.ext fun k => by simpa using hxα k hxW))
  -- (ii) the zero region is the union of countably many such `W`
  obtain ⟨T, hTc, hTS, hTU⟩ := TopologicalSpace.isOpen_sUnion_countable
    {W : Set (Euclid P) | IsOpen W ∧ IsCompact (closure W) ∧ closure W ⊆ univ ∧ C.VanishesOn W}
    fun W hW => hW.1
  have hZ : R.measure (⋃₀ {W : Set (Euclid P) | IsOpen W ∧ IsCompact (closure W) ∧
      closure W ⊆ univ ∧ C.VanishesOn W}) = 0 := by
    rw [← hTU, measure_sUnion_null_iff hTc]
    exact fun W hWT => hW W (hTS hWT).1 (hTS hWT).2.2.2
  filter_upwards [measure_eq_zero_iff_ae_notMem.1 hZ] with x hx
  exact ⟨mem_univ x, hx⟩

/-- **Weak limits of blow-ups of a cycle are cycles** (`∂C = 0` for the blow-up limit `C` in the
proof of Simon 7.3.3(2), chapter-07.txt line 512 ff.; cf. the proof of 7.3.1, lines 335–336,
where `∂η_{x,λⱼ#}T = 0` in `B_{MR}(0)` for large `j`, and Ch. 6, 2.13 and 2.24(1)).  If
`∂T = 0` in `U`, `λᵢ > 0`, `λᵢ → 0` and `η_{x,λᵢ#}T ⇀ C` in `ℝᴾ`, then `∂C = 0`: for
`ω ∈ 𝒟ᵐ(ℝᴾ)`, the compact set `spt ω ⊇ spt dω` lies in `η_{x,λᵢ}(U)` for all large `i`
(`idtp_tpf_blowUp_domain_eventually`), and there
`η_{x,λᵢ#}T(dω) = ∂(η_{x,λᵢ#}T)(ω) = η_{x,λᵢ#}(∂T)(ω) = 0`; hence
`∂C(ω) = C(dω) = limᵢ η_{x,λᵢ#}T(dω) = 0`. -/
theorem Submission.idtp_tpf_blowUp_limit_boundaryVanishes : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (x : Euclid P) (lams : ℕ → ℝ) (hlams : ∀ i, 0 < lams i) (C : GeometricCurrentOn (univ : Set (Euclid P)) n), IsOpen U → x ∈ U → BoundaryVanishes T → Tendsto lams atTop (𝓝 0) → ConvergesWeakly (fun i => blowUp T x (lams i) (hlams i).ne') C → BoundaryVanishes C := by
  intro P n U T x lams hlams C hU hx hT hlim hconv
  cases n with
  | zero => trivial
  | succ m =>
    -- step 1: `∂T = 0`, and it suffices that `∂C(ω) = C(dω) = 0` for every `ω ∈ 𝒟ᵐ(ℝᴾ)`
    change T.boundary = 0 at hT
    change C.boundary = 0
    ext ω
    rw [GeometricCurrentOn.boundary_apply, GeometricCurrentOn.zero_apply]
    -- step 2: the compact set `spt ω` lies in `η_{x,λᵢ}(U)` for all large `i`
    have hev := Submission.idtp_tpf_blowUp_domain_eventually P U x lams hU hx hlams hlim
      (tsupport (ω : DifferentialForm (Euclid P) m)) ω.property.1.2.isCompact.isBounded
    -- steps 3–4: for such `i`, `η_{x,λᵢ#}T(dω) = ∂(η_{x,λᵢ#}T)(ω) = η_{x,λᵢ#}(∂T)(ω) = 0`
    have hzero : ∀ᶠ i in atTop, currentEval (blowUp T x (lams i) (hlams i).ne')
        (exteriorDerivative (ω : DifferentialForm (Euclid P) m)) = 0 := by
      filter_upwards [hev] with i hi
      -- `∂` commutes with the affine push-forward `η_{x,λᵢ#}` (Simon 6.2.24(1)) ...
      have hB : (blowUp T x (lams i) (hlams i).ne').boundary =
          blowUp T.boundary x (lams i) (hlams i).ne' := by
        unfold blowUp
        rw [GeometricCurrentOn.boundary_affinePushforward]
        rfl
      -- ... and the blow-up of the zero current is zero
      have h0 : blowUp (0 : GeometricCurrentOn U m) x (lams i) (hlams i).ne' = 0 := by
        ext η
        unfold blowUp
        rw [GeometricCurrentOn.affinePushforward_apply, GeometricCurrentOn.restrictDomain_apply,
          GeometricCurrentOn.zero_apply, GeometricCurrentOn.zero_apply]
      -- `ω` is a test form in `η_{x,λᵢ}(U)`, and `currentEval` evaluates the blow-up on `dω`
      let ωi : TestFormOn (dilation x (lams i) '' U) m := ⟨ω, ω.property.1, hi⟩
      have hd : IsTestForm (exteriorDerivative (ω : DifferentialForm (Euclid P) m)) ∧
          tsupport (exteriorDerivative (ω : DifferentialForm (Euclid P) m)) ⊆
            dilation x (lams i) '' U :=
        ⟨exteriorDerivative_isTestForm ω.property.1,
          (tsupport_exteriorDerivative_subset _).trans hi⟩
      rw [currentEval, dite_eq_left hd]
      change (blowUp T x (lams i) (hlams i).ne').boundary ωi = 0
      rw [hB, hT, h0, GeometricCurrentOn.zero_apply]
    -- step 5: `C(dω)` is the limit of a sequence that is eventually `0`
    exact tendsto_nhds_unique (hconv (exteriorDerivativeTestOn univ m ω))
      (tendsto_const_nhds.congr' (hzero.mono fun i hi => hi.symm))
/-- **A cone takes equal values on dilated test forms** (Simon 7.3.1(2), via 6.2.23).
If `C ∈ 𝒟ₙ(ℝᴾ)` is a cone, `λ > 0` and `ω ∈ 𝒟ⁿ(ℝᴾ)`, then `ω'(y) = λ⁻ⁿ ω(λ⁻¹y)` defines a test
form with `C(ω') = C(ω)`.  As `η_{0,λ}(ℝᴾ) = ℝᴾ`, the cone property `η_{0,λ#}C = C` reads
`C(η_{0,λ}^# ω) = C(ω)`, and by multilinearity
`η_{0,λ}^# ω (y) = ω(λ⁻¹y) ∘ (λ⁻¹ id) = λ⁻ⁿ ω(λ⁻¹y)`. -/
theorem Submission.cone_current_apply_dilation_pullback : ∀ (P n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n), IsConeCurrent C → ∀ lam : ℝ, 0 < lam → ∀ ω : TestFormOn (univ : Set (Euclid P)) n, ∃ ω' : TestFormOn (univ : Set (Euclid P)) n, (∀ y, (ω' : DifferentialForm (Euclid P) n) y = (lam⁻¹ ^ n) • (ω : DifferentialForm (Euclid P) n) (lam⁻¹ • y)) ∧ C ω' = C ω := by
  intro P n C hC lam hlam ω
  -- Step 1: the cone property `η_{0,λ#}C(ω) = C(ω)`.
  have hcone := hC lam hlam ω
  -- Step 2: `η_{0,λ}(ℝᴾ) = ℝᴾ`, so `currentEval` takes its test-form branch.
  have hV : dilation (0 : Euclid P) lam '' univ = univ := by
    refine eq_univ_of_forall fun x => ⟨lam • x, mem_univ _, ?_⟩
    simp [dilation, dilationCLM, smul_smul, mul_inv_cancel₀ hlam.ne']
  have h : IsTestForm (ω : DifferentialForm (Euclid P) n) ∧
      tsupport (ω : DifferentialForm (Euclid P) n) ⊆ dilation (0 : Euclid P) lam '' univ :=
    ⟨ω.property.1, by rw [hV]; exact subset_univ _⟩
  rw [currentEval, dite_eq_left h] at hcone
  -- Steps 3–4: unfolding `blowUp`, `η_{0,λ#}C(ω) = C(ω')` for the affine pullback `ω'` of `ω`,
  -- so `C(ω') = C(ω)`.
  refine ⟨_, fun y => ?_, hcone⟩
  -- Step 5: `ω'(y) = ω(λ⁻¹y) ∘ (λ⁻¹ id) = λ⁻ⁿ ω(λ⁻¹y)` by multilinearity.
  ext v
  change (ω : DifferentialForm (Euclid P) n) (-(lam⁻¹ • (0 : Euclid P)) + dilationCLM P lam y)
      (fun i => dilationCLM P lam (v i)) = _
  simp only [dilationCLM, smul_zero, neg_zero, zero_add, smul_apply,
    ContinuousLinearMap.id_apply, ContinuousAlternatingMap.smul_apply, smul_eq_mul]
  rw [ContinuousAlternatingMap.map_smul_univ, Finset.prod_const, Finset.card_univ,
    Fintype.card_fin, smul_eq_mul]
/-- **Simon Ch. 6, Remark 3.2(1)**, step 3 (orientations `±τ₁ ∧ ⋯ ∧ τₙ` as in 2.1–2.2): two unit
orientations `v = ±τ₁ ∧ ⋯ ∧ τₙ`, `w = ±τ'₁ ∧ ⋯ ∧ τ'ₙ` of the same subspace `Q` differ by a sign.
`τ` and `τ'` are orthonormal bases `b`, `b'` of `Q`; every alternating `n`-form on `Q` is a
multiple of `det_b`, so `α(τ') = det_b(b') α(τ)` for every `n`-covector `α`, and
`det_b(b') = ±1`, the change of orthonormal basis being orthogonal. -/
theorem Submission.rsdic_unitOrientation_eq_or_eq_neg : ∀ (P n : ℕ) (v w : MultiVector P n) (Q : Submodule ℝ (Euclid P)), IsUnitOrientationOf v Q → IsUnitOrientationOf w Q → w = v ∨ w = -v := by
  rintro P n v w Q ⟨τ, hτ, hspan, hv⟩ ⟨τ', hτ', hspan', hw⟩
  -- an orthonormal frame spanning `Q` is an orthonormal basis of `Q`
  have frame : ∀ σ : Fin n → Euclid P, Orthonormal ℝ σ → Submodule.span ℝ (range σ) = Q →
      ∃ c : OrthonormalBasis (Fin n) ℝ Q, ∀ i, (c i : Euclid P) = σ i := by
    intro σ hσ hσspan
    have hmem : ∀ i, σ i ∈ Q := fun i => hσspan ▸ Submodule.subset_span (mem_range_self i)
    let u : Fin n → Q := fun i => ⟨σ i, hmem i⟩
    have hu : Orthonormal ℝ u := by
      rw [← Q.subtypeₗᵢ.orthonormal_comp_iff (v := u)]
      exact hσ
    have huspan : ⊤ ≤ Submodule.span ℝ (range u) := by
      rintro ⟨y, hy⟩ -
      rw [← hσspan, Submodule.mem_span_range_iff_exists_fun] at hy
      obtain ⟨c, hc⟩ := hy
      rw [Submodule.mem_span_range_iff_exists_fun]
      exact ⟨c, Subtype.ext (by simpa [u] using hc)⟩
    exact ⟨OrthonormalBasis.mk hu huspan, fun i => by simp [u]⟩
  obtain ⟨b, hb⟩ := frame τ hτ hspan
  obtain ⟨b', hb'⟩ := frame τ' hτ' hspan'
  -- `det_b(b') = ±1`
  have hd := b.det_to_matrix_orthonormalBasis_real b'
  -- `α(τ') = det_b(b') α(τ)`: the restriction `α_Q` of `α` to `Q` is `α_Q(b) det_b`
  have hτ'τ : ∀ α : Covector (Euclid P) n, α τ' = b.toBasis.det b' * α τ := by
    intro α
    let f : Q [⋀^Fin n]→ₗ[ℝ] ℝ := α.toAlternatingMap.compLinearMap Q.subtype
    have hf : ∀ (c : OrthonormalBasis (Fin n) ℝ Q) (σ : Fin n → Euclid P),
        (∀ i, (c i : Euclid P) = σ i) → f c = α σ := by
      intro c σ hc
      have hcσ : (fun i => Q.subtype (c i)) = σ := funext hc
      rw [AlternatingMap.compLinearMap_apply, hcσ, ContinuousAlternatingMap.coe_toAlternatingMap]
    have h := congrArg (fun g : Q [⋀^Fin n]→ₗ[ℝ] ℝ => g b') (f.eq_smul_basis_det b.toBasis)
    simp only [AlternatingMap.smul_apply, smul_eq_mul, OrthonormalBasis.coe_toBasis] at h
    rw [← hf b' τ' hb', h, hf b τ hb, mul_comm]
  -- `w = ±v`
  rcases hd with hd | hd <;> rcases hv with hv | hv <;> rcases hw with hw | hw
  · left; ext α; rw [hw, hv, hτ'τ, hd, one_mul]
  · right; ext α; rw [neg_apply, hw, hv, hτ'τ, hd, one_mul]
  · right; ext α; rw [neg_apply, hw, hv, hτ'τ, hd, one_mul, neg_neg]
  · left; ext α; rw [hw, hv, hτ'τ, hd, one_mul]
  · right; ext α; rw [neg_apply, hw, hv, hτ'τ, hd, neg_one_mul]
  · left; ext α; rw [hw, hv, hτ'τ, hd, neg_one_mul, neg_neg]
  · left; ext α; rw [hw, hv, hτ'τ, hd, neg_one_mul]
  · right; ext α; rw [neg_apply, hw, hv, hτ'τ, hd, neg_one_mul, neg_neg]
/-- **Degenerate case `P < n` of the cone splitting** (step 0 of the parent proof of Simon 7.3.5;
the book assumes `n ≤ P`).  An alternating `n`-form on `ℝᴾ` vanishes when `n > P`, so every test
`n`-form is `0` and `S = 0`; hence `S` and all its blow-ups vanish, giving the cone property and the
invariance under translations along `L`.  For the splitting take `S₀ := 0`: the zero current is
integer multiplicity (empty carrier), has zero mass, so it is minimizing, it is a cone with
`∂S₀ = 0` and empty support, and it has density `θ` at a point iff `θ = 0`, in every degree. -/
theorem Submission.dimred_cs_high_degree_case : ∀ (P n : ℕ) (S : GeometricCurrentOn (univ : Set (Euclid P)) n) (L : Submodule ℝ (Euclid P)), P < n → IsConeCurrent S ∧ (∀ v ∈ L, ∀ ω : TestFormOn (univ : Set (Euclid P)) n, currentEval (blowUp S (-v) 1 one_ne_zero) (ω : DifferentialForm (Euclid P) n) = S ω) ∧ ∃ S₀ : GeometricCurrentOn (univ : Set (Euclid P)) (n - Module.finrank ℝ L), IsMinimizingIn S₀ univ ∧ BoundaryVanishes S₀ ∧ IsConeCurrent S₀ ∧ S₀.support ⊆ (Lᗮ : Set (Euclid P)) ∧ (∀ t ∈ L, ∀ y ∈ Lᗮ, (t + y ∈ S.support ↔ y ∈ S₀.support)) ∧ ∀ t ∈ L, ∀ y ∈ Lᗮ, ∀ θ : ℝ, (HasMassDensity S (t + y) θ ↔ HasMassDensity S₀ y θ) := by
  intro P n S L hPn
  -- an alternating `k`-form on `ℝᴾ`, `k > P`, vanishes: `k` vectors in `ℝᴾ` are dependent
  have covector_eq_zero : ∀ {k : ℕ}, P < k → ∀ α : Covector (Euclid P) k, α = 0 := by
    intro k hk α
    ext v
    have hdep : ¬ LinearIndependent ℝ v := by
      intro hli
      have := hli.fintype_card_le_finrank
      simp only [Fintype.card_fin, finrank_euclideanSpace] at this
      omega
    exact α.toAlternatingMap.map_linearDependent v hdep
  -- hence every test `k`-form is `0`, and so is every `k`-current
  have current_eq_zero : ∀ {k : ℕ} {U : Set (Euclid P)} (T : GeometricCurrentOn U k), P < k →
      T = 0 := by
    intro k U T hk
    ext ω
    have hω : ω = 0 := by
      apply Subtype.ext
      funext x
      exact covector_eq_zero hk _
    rw [hω, GeometricCurrentOn.zero_apply]
    exact T.toCurrent.map_zero
  -- the zero current in an arbitrary degree `j`: zero mass
  have zero_mass : ∀ {j : ℕ} (W : Set (Euclid P)),
      (0 : GeometricCurrentOn (univ : Set (Euclid P)) j).massOn W = 0 := by
    intro j W
    apply le_antisymm _ zero_le
    apply sSup_le
    rintro _ ⟨ω, _, rfl⟩
    simp
  -- integer multiplicity, represented by the empty carrier
  have zero_im : ∀ {j : ℕ},
      IsIntegerMultiplicity (0 : GeometricCurrentOn (univ : Set (Euclid P)) j) := by
    intro j
    refine ⟨{ carrier := ∅
              mult := fun _ => 0
              orient := fun _ => 0
              measurableSet_carrier := MeasurableSet.empty
              carrier_subset := empty_subset _
              rectifiable :=
                Poincare.SimonGMT.Chapter03.countablyRectifiable_of_measure_zero measure_empty
              measurable_mult := measurable_const
              mult_pos := fun x hx => absurd hx (notMem_empty x)
              locallyIntegrable_mult := fun K _ _ => by simp
              aestronglyMeasurable_orient := aestronglyMeasurable_const
              orients := by simp }, ?_⟩
    intro ω
    simp [IMRep.action]
  -- minimizing: its mass `0` is below that of every competitor
  have zero_min : ∀ {j : ℕ},
      IsMinimizingIn (0 : GeometricCurrentOn (univ : Set (Euclid P)) j) univ := by
    intro j
    refine ⟨zero_im, fun W S' _ _ _ _ _ _ => ?_⟩
    rw [zero_mass]
    exact zero_le
  -- `∂0 = 0`
  have zero_bdry : ∀ {j : ℕ},
      BoundaryVanishes (0 : GeometricCurrentOn (univ : Set (Euclid P)) j) := by
    intro j
    cases j with
    | zero => trivial
    | succ j => exact GeometricCurrentOn.ext fun ω => rfl
  -- every blow-up of `0` evaluates to `0`, so `0` is a cone
  have eval_blowUp_zero : ∀ {j : ℕ} (x : Euclid P) (lam : ℝ) (h : lam ≠ 0)
      (ω : DifferentialForm (Euclid P) j),
      currentEval (blowUp (0 : GeometricCurrentOn (univ : Set (Euclid P)) j) x lam h) ω = 0 := by
    intro j x lam h ω
    unfold currentEval
    split_ifs <;> rfl
  have zero_cone : ∀ {j : ℕ}, IsConeCurrent (0 : GeometricCurrentOn (univ : Set (Euclid P)) j) := by
    intro j lam hlam ω
    rw [eval_blowUp_zero]
    rfl
  -- empty support: `0` vanishes on the relatively compact ball `B₁(x)`
  have zero_support : ∀ {j : ℕ},
      (0 : GeometricCurrentOn (univ : Set (Euclid P)) j).support = ∅ := by
    intro j
    apply eq_empty_of_forall_notMem
    intro x hx
    apply hx.2
    refine mem_sUnion.2 ⟨ball x 1, ⟨isOpen_ball, ?_, subset_univ _, fun ω _ => rfl⟩,
      mem_ball_self one_pos⟩
    exact (isCompact_closedBall x 1).of_isClosed_subset isClosed_closure
      closure_ball_subset_closedBall
  -- density: the ratios are all `0`, and `𝓝[>] 0` is nontrivial
  have zero_density : ∀ {j : ℕ} (x : Euclid P) (θ : ℝ),
      HasMassDensity (0 : GeometricCurrentOn (univ : Set (Euclid P)) j) x θ ↔ θ = 0 := by
    intro j x θ
    simp only [HasMassDensity, zero_mass, ENNReal.zero_div]
    rw [tendsto_const_nhds_iff]
    constructor
    · rintro ⟨h0, h⟩
      have := ENNReal.ofReal_eq_zero.1 h.symm
      linarith
    · rintro rfl
      exact ⟨le_rfl, by simp⟩
  -- assembly with `S = 0` and `S₀ := 0`
  obtain rfl : S = 0 := current_eq_zero S hPn
  refine ⟨zero_cone, ?_, 0, zero_min, zero_bdry, zero_cone, ?_, ?_, ?_⟩
  · intro v _ ω
    rw [eval_blowUp_zero]
    rfl
  · rw [zero_support]
    exact empty_subset _
  · intro t _ y _
    rw [zero_support, zero_support]
    simp
  · intro t _ y _ θ
    rw [zero_density, zero_density]
/-- **Cut-off quadratic moments over `n`-planes** (the constant `cₙ` of the measurability proof
for the approximate tangent planes of Simon Ch. 3, 1.4).  For `n ≥ 1` one constant `c > 0`,
depending only on `n`, gives `∫_Q max(1 − |y|², 0)⟨u, y⟩² dHⁿ(y) = c|p_Q u|²` for every `P`,
every `n`-dimensional subspace `Q ⊆ ℝᴾ` and every `u ∈ ℝᴾ`.  On `ℝⁿ` put
`q(w) = ∫ max(1 − |z|², 0)⟨w, z⟩² dHⁿ(z)` and `c = q(e)`, `|e| = 1`: linear isometries preserve
`Hⁿ`, so `q` is invariant under them, `q(tw) = t²q(w)`, and a reflection maps `|w|e` to `w`,
whence `q(w) = c|w|²`; `c > 0` since the integrand is continuous, `≥ 0`, compactly supported and
`3/16` at `e/2`.  An isometry `ι = L⁻¹ : ℝⁿ → Q ⊆ ℝᴾ` carries `Hⁿ` to `Hⁿ⌞Q`, and
`⟨u, ι z⟩ = ⟨L(p_Q u), z⟩`, so the integral is `q(L(p_Q u)) = c|p_Q u|²`. -/
theorem Submission.exists_plane_cutoff_quadratic_moment_eq : ∀ n : ℕ, 0 < n → ∃ c : ℝ, 0 < c ∧ ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)), Module.finrank ℝ Q = n → ∀ u : Euclid P, ∫ y in (Q : Set (Euclid P)), max (1 - ‖y‖ ^ 2) 0 * inner ℝ u y ^ 2 ∂μHE[n] = c * ‖Q.starProjection u‖ ^ 2 := by
  intro n hn
  -- The moment `q(w)` on the model plane `ℝⁿ`; the constant is `c = q(e)` for a unit vector `e`.
  obtain ⟨q, hq_def⟩ : ∃ q : Euclid n → ℝ,
      ∀ w, q w = ∫ z, max (1 - ‖z‖ ^ 2) 0 * inner ℝ w z ^ 2 ∂μHE[n] :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨e, he⟩ : ∃ e : Euclid n, ‖e‖ = 1 := ⟨EuclideanSpace.single ⟨0, hn⟩ 1, by simp⟩
  -- `q(Rw) = q(w)` for a linear isometry `R`: substitute `z = Rz'`, `R` preserves `Hⁿ`.
  have hq_iso : ∀ (R : Euclid n ≃ₗᵢ[ℝ] Euclid n) (w : Euclid n), q (R w) = q w := by
    intro R w
    have key : ∫ z, max (1 - ‖R z‖ ^ 2) 0 * inner ℝ (R w) (R z) ^ 2 ∂μHE[n] =
        ∫ z, max (1 - ‖z‖ ^ 2) 0 * inner ℝ (R w) z ^ 2 ∂μHE[n] :=
      (R.toIsometryEquiv.measurePreserving_euclideanHausdorffMeasure n).integral_comp
        R.toHomeomorph.measurableEmbedding (fun y => max (1 - ‖y‖ ^ 2) 0 * inner ℝ (R w) y ^ 2)
    simp only [LinearIsometryEquiv.norm_map, LinearIsometryEquiv.inner_map_map] at key
    rw [hq_def, hq_def, ← key]
  have hq_smul : ∀ (t : ℝ) (w : Euclid n), q (t • w) = t ^ 2 * q w := by
    intro t w
    rw [hq_def, hq_def, ← integral_const_mul]
    congr 1
    funext z
    rw [real_inner_smul_left]
    ring
  -- `q(w) = c|w|²`: the reflection in `(|w|e − w)ᗮ` maps `|w|e` to `w`.
  have hq : ∀ w : Euclid n, q w = q e * ‖w‖ ^ 2 := by
    intro w
    have h1 : ‖‖w‖ • e‖ = ‖w‖ := by rw [norm_smul, he, mul_one, norm_norm]
    obtain ⟨R, hR⟩ : ∃ R : Euclid n ≃ₗᵢ[ℝ] Euclid n, R (‖w‖ • e) = w :=
      ⟨_, Submodule.reflection_sub h1⟩
    calc q w = q (R (‖w‖ • e)) := by rw [hR]
      _ = q (‖w‖ • e) := hq_iso R _
      _ = q e * ‖w‖ ^ 2 := by rw [hq_smul, mul_comm]
  -- `c > 0`: on `ℝⁿ`, `Hⁿ` is Lebesgue measure, and the integrand is `3/16` at `e/2`.
  have hc : 0 < q e := by
    have hcont : Continuous fun z : Euclid n => max (1 - ‖z‖ ^ 2) 0 * inner ℝ e z ^ 2 := by
      fun_prop
    have hsupp : HasCompactSupport fun z : Euclid n => max (1 - ‖z‖ ^ 2) 0 * inner ℝ e z ^ 2 := by
      refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid n) 1) fun z hz => ?_
      have h1 : 1 < ‖z‖ := by simpa using hz
      have h2 : 1 - ‖z‖ ^ 2 ≤ 0 := by nlinarith
      simp [max_eq_right h2]
    have hnonneg : 0 ≤ fun z : Euclid n => max (1 - ‖z‖ ^ 2) 0 * inner ℝ e z ^ 2 :=
      fun z => mul_nonneg (le_max_right _ _) (sq_nonneg _)
    have hx : (fun z : Euclid n => max (1 - ‖z‖ ^ 2) 0 * inner ℝ e z ^ 2) ((1 / 2 : ℝ) • e) ≠ 0 := by
      simp only [norm_smul, he, real_inner_smul_right, real_inner_self_eq_norm_sq]
      norm_num
    rw [hq_def, EuclideanSpace.euclideanHausdorffMeasure_eq_volume]
    exact hcont.integral_pos_of_hasCompactSupport_nonneg_nonzero hsupp hnonneg hx
  refine ⟨q e, hc, fun P Q hQ u => ?_⟩
  -- An orthonormal basis of `Q` indexed by `Fin n` gives `L : Q ≃ ℝⁿ`; `ι = L⁻¹` is an isometry
  -- of `ℝⁿ` onto `Q ⊆ ℝᴾ`, so `ι_# Hⁿ = Hⁿ⌞Q`.
  obtain ⟨L, -⟩ : ∃ L : Q ≃ₗᵢ[ℝ] Euclid n, True :=
    ⟨((stdOrthonormalBasis ℝ Q).reindex (finCongr hQ)).repr, trivial⟩
  have hι : Isometry fun z : Euclid n => ((L.symm z : Q) : Euclid P) :=
    isometry_subtype_coe.comp L.symm.isometry
  have hrange : Set.range (fun z : Euclid n => ((L.symm z : Q) : Euclid P)) =
      (Q : Set (Euclid P)) := by
    ext y
    refine ⟨?_, fun hy => ⟨L ⟨y, hy⟩, by simp⟩⟩
    rintro ⟨z, rfl⟩
    exact (L.symm z).2
  have hemb : MeasurableEmbedding fun z : Euclid n => ((L.symm z : Q) : Euclid P) :=
    hι.isClosedEmbedding.measurableEmbedding
  have hnorm : ∀ z : Euclid n, ‖((L.symm z : Q) : Euclid P)‖ = ‖z‖ := fun z => L.symm.norm_map z
  -- `⟨u, ι z⟩ = ⟨p_Q u, ι z⟩ = ⟨L(p_Q u), z⟩`.
  have hinner : ∀ z : Euclid n, inner ℝ u ((L.symm z : Q) : Euclid P) =
      inner ℝ (L (Q.orthogonalProjectionOnto u)) z := by
    intro z
    rw [LinearIsometryEquiv.inner_map_eq_flip,
      Submodule.inner_orthogonalProjectionOnto_eq_of_mem_right]
  rw [← hrange, ← hι.map_euclideanHausdorffMeasure, hemb.integral_map]
  simp only [hnorm, hinner]
  rw [← hq_def, hq, LinearIsometryEquiv.norm_map, Submodule.starProjection_apply]
  rfl
/-- **Mass measures of blow-ups converging to `c[[Q']]`** (proof of Simon 7.3.3(1), edge of a
planar sector of a 2-dimensional minimizing cone, chapter-07.txt lines 497–510; `μ_{Tⱼ} → μ_T` as
in 7.2.4 and Remark 7.2.5(1), lines 160–165; blow-up scaling as in the proof of 7.3.1, lines
329–337).  Let `τ` be orthonormal, `Q' = span τ`, `C' = c[[Q']]` with `c ≠ 0`, and let the mass
measures of `η_{a,λⱼ#}C` converge to that of `C'`.  Then for every representation `R` of `C` and
every `g ∈ C_c(ℝᴾ)`, `λⱼ⁻ⁿ ∫ g ∘ η_{a,λⱼ} dμ_R → |c| ∫_{Q'} g dHⁿ`.  `C'` has a representation
with `μ_{C'} = |c| Hⁿ⌞Q'` (`idtp_cse_etp_plane_imrep`).  For `λ > 0` and `η = η_{a,λ}`,
`(η(M), θ ∘ η⁻¹, ξ ∘ η⁻¹)` represents `η_{a,λ#}C`, with measure `λ⁻ⁿ η_#μ_R`, by the argument of
`dtc_blowUp_imrep`: `Hⁿ⌞η(s) = λ⁻ⁿ η_#(Hⁿ⌞s)`, `η` preserves approximate tangent spaces, and
`η_{a,λ#}C(ω) = λ⁻ⁿ C(ω ∘ η)`.  Hence `∫ g dμ_{η_{a,λⱼ#}C} = λⱼ⁻ⁿ ∫ g ∘ η_{a,λⱼ} dμ_R`. -/
theorem Submission.idtp_cse_etp_blowup_vague_limit : ∀ (P n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n) (a : Euclid P) (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j) (C' : GeometricCurrentOn (univ : Set (Euclid P)) n) (τ : Fin n → Euclid P) (c : ℤ), Orthonormal ℝ τ → c ≠ 0 → (∀ ω : TestFormOn (univ : Set (Euclid P)) n, C' ω = (c : ℝ) * ∫ x in (Submodule.span ℝ (Set.range τ) : Set (Euclid P)), (ω : DifferentialForm (Euclid P) n) x τ ∂μHE[n]) → MassMeasuresConverge (fun j => blowUp C a (lams j) (hlams j).ne') C' → ∀ R : IMRep (univ : Set (Euclid P)) n, R.Represents C → ∀ g : Euclid P → ℝ, Continuous g → HasCompactSupport g → Tendsto (fun j => (lams j)⁻¹ ^ n * ∫ x, g (dilation a (lams j) x) ∂R.measure) atTop (𝓝 ((c.natAbs : ℝ) * ∫ x in (Submodule.span ℝ (Set.range τ) : Set (Euclid P)), g x ∂μHE[n])) := by
  intro P n C a lams hlams C' τ c hτ hc hC' hconv R hR g hg hgc
  -- Step 1: `C' = c[[Q']]` is represented by `R'` with `μ_{R'} = |c| Hⁿ⌞Q'`, so
  -- `∫ g dμ_{R'} = |c| ∫_{Q'} g dHⁿ`
  obtain ⟨R', hR'act, hR'meas⟩ := Submission.idtp_cse_etp_plane_imrep P n τ c hτ hc
  have hR'rep : R'.Represents C' := fun ω => by rw [hC' ω, hR'act]
  have hlim : ∫ x, g x ∂R'.measure =
      (c.natAbs : ℝ) * ∫ x in (Submodule.span ℝ (Set.range τ) : Set (Euclid P)), g x ∂μHE[n] := by
    rw [hR'meas, integral_smul_measure, ENNReal.toReal_natCast, smul_eq_mul]
  -- Step 2: for `λ > 0`, `η_{a,λ#}C` is represented by `(η(M), θ ∘ η⁻¹, ξ ∘ η⁻¹)`, `η = η_{a,λ}`,
  -- whose measure is `B ↦ λ⁻ⁿ μ_R(η⁻¹(B))`
  have hblow : ∀ (lam : ℝ) (hlam : 0 < lam), ∃ R₁ : IMRep (dilation a lam '' univ) n,
      R₁.Represents (blowUp C a lam hlam.ne') ∧ ∀ s : Set (Euclid P), MeasurableSet s →
        R₁.measure s = ENNReal.ofReal (lam⁻¹ ^ n) * R.measure (dilation a lam ⁻¹' s) := by
    intro lam hlam
    have hne : lam ≠ 0 := hlam.ne'
    -- `η` is an affine homeomorphism with inverse `z ↦ a + λz`
    have hη : (((Homeomorph.smulOfNeZero lam⁻¹ (inv_ne_zero hne)).trans
        (Homeomorph.addLeft (-(lam⁻¹ • a)))) : Euclid P → Euclid P) = dilation a lam := by
      funext y
      simp [dilation, dilationCLM]
    have hme : MeasurableEmbedding (dilation a lam) := by
      rw [← hη]
      exact Homeomorph.measurableEmbedding _
    have hηsmooth : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (dilation a lam) :=
      contDiff_const.add (dilationCLM P lam).contDiff
    have hιη : ∀ y, a + lam • dilation a lam y = y := fun y => by
      simp [dilation, dilationCLM, smul_add, smul_smul, hne]
    -- `Hⁿ(η_{x,r}(s)) = r⁻ⁿ Hⁿ(s)` for `r > 0`: `η_{x,r}(s)` is the translate of `r⁻¹s`
    have himage : ∀ (x : Euclid P) (r : ℝ), 0 < r → ∀ s : Set (Euclid P),
        μHE[n] (dilation x r '' s) = ENNReal.ofReal (r⁻¹ ^ n) * μHE[n] s := by
      intro x r hr s
      have hs : dilation x r '' s = (fun z => -(r⁻¹ • x) + z) '' ((fun y => r⁻¹ • y) '' s) := by
        rw [Set.image_image]
        rfl
      rw [hs, (isometry_add_left (-(r⁻¹ • x))).euclideanHausdorffMeasure_image, Set.image_smul,
        Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hr.ne') s, ENNReal.smul_def,
        smul_eq_mul, ← ENNReal.ofReal_coe_nnreal]
      congr 2
      simp [abs_of_pos hr]
    -- `η_#Hⁿ = λⁿ Hⁿ`, as `η⁻¹(B) = η_{−λ⁻¹a,λ⁻¹}(B)`
    have hmap : Measure.map (dilation a lam) (μHE[n] : Measure (Euclid P)) =
        ENNReal.ofReal (lam ^ n) • (μHE[n] : Measure (Euclid P)) := by
      ext B hB
      have hpre : dilation a lam ⁻¹' B = dilation (-(lam⁻¹ • a)) lam⁻¹ '' B :=
        (congrFun (Set.image_eq_preimage_of_inverse
          (fun z => by simp [dilation, dilationCLM, smul_add, smul_smul, hne])
          (fun y => by simp [dilation, dilationCLM, smul_add, smul_smul, hne])) B).symm
      rw [Measure.map_apply hme.measurable hB, hpre, himage _ _ (inv_pos.mpr hlam), inv_inv,
        Measure.smul_apply, smul_eq_mul]
    have hκ0 : 0 ≤ lam⁻¹ ^ n := by positivity
    set κ : ℝ≥0∞ := ENNReal.ofReal (lam⁻¹ ^ n) with hκ
    -- `Hⁿ⌞η(s) = κ η_#(Hⁿ⌞s)`, `κ = λ⁻ⁿ`, hence change of variables along `η`
    have hkey : ∀ s : Set (Euclid P),
        μHE[n].restrict (dilation a lam '' s) = κ • (μHE[n].restrict s).map (dilation a lam) := by
      intro s
      have h1 : (μHE[n].restrict s).map (dilation a lam) =
          ENNReal.ofReal (lam ^ n) • μHE[n].restrict (dilation a lam '' s) := by
        rw [← hme.injective.preimage_image s, ← hme.restrict_map, hmap, Measure.restrict_smul,
          hme.injective.preimage_image]
      rw [h1, smul_smul, hκ, ← ENNReal.ofReal_mul hκ0, ← mul_pow, inv_mul_cancel₀ hne,
        one_pow, ENNReal.ofReal_one, one_smul]
    have hlint : ∀ (s : Set (Euclid P)) (f : Euclid P → ℝ≥0∞),
        ∫⁻ z in dilation a lam '' s, f z ∂μHE[n] =
          κ * ∫⁻ y in s, f (dilation a lam y) ∂μHE[n] := by
      intro s f
      rw [hkey s, lintegral_smul_measure, hme.lintegral_map, smul_eq_mul]
    have hint : ∀ (s : Set (Euclid P)) (f : Euclid P → ℝ),
        ∫ z in dilation a lam '' s, f z ∂μHE[n] =
          lam⁻¹ ^ n * ∫ y in s, f (dilation a lam y) ∂μHE[n] := by
      intro s f
      rw [hkey s, integral_smul_measure, hme.integral_map, hκ, ENNReal.toReal_ofReal hκ0,
        smul_eq_mul]
    -- `T_{η(y)}η(M) = T_yM`: `η_{η(y),r}(η(M)) = η_{y,λr}(M)`, and `r ↦ λr` maps `r ↓ 0` into
    -- `r ↓ 0`
    have htan : ∀ (y : Euclid P) (Q : Submodule ℝ (Euclid P)),
        HasApproximateTangentSpaceAt n R.carrier y Q →
          HasApproximateTangentSpaceAt n (dilation a lam '' R.carrier) (dilation a lam y) Q := by
      intro y Q hT
      refine ⟨hT.1, fun f => ?_⟩
      have hset : ∀ r : ℝ, Poincare.SimonGMT.Chapter03.blowUpMap (dilation a lam y) r ''
          (dilation a lam '' R.carrier) =
            Poincare.SimonGMT.Chapter03.blowUpMap y (lam * r) '' R.carrier := by
        intro r
        rw [image_image]
        congr 1
        funext w
        simp only [Poincare.SimonGMT.Chapter03.blowUpMap, dilation, dilationCLM,
          smul_apply, ContinuousLinearMap.id_apply, add_sub_add_left_eq_sub]
        rw [← smul_sub, smul_smul, mul_inv, mul_comm]
      simp_rw [hset]
      have hscale : Tendsto (fun r : ℝ => lam * r) (𝓝[>] 0) (𝓝[>] 0) := by
        refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ ?_ ?_
        · simpa using (tendsto_id.const_mul lam).mono_left (nhdsWithin_le_nhds (a := (0 : ℝ)))
        · filter_upwards [self_mem_nhdsWithin] with r hr
          exact mul_pos hlam hr
      exact (hT.2 f).comp hscale
    -- `ω ↦ ω ∘ η` maps `𝒟ⁿ(η(ℝᴾ))` to `𝒟ⁿ(ℝᴾ)`
    have hpull : ∀ ω : TestFormOn (dilation a lam '' univ) n,
        ∃ ω' : TestFormOn (univ : Set (Euclid P)) n, ∀ y, (ω' : DifferentialForm (Euclid P) n) y =
          (ω : DifferentialForm (Euclid P) n) (dilation a lam y) := by
      intro ω
      obtain ⟨⟨hsmooth, hcompact⟩, -⟩ := ω.property
      refine ⟨⟨fun y => (ω : DifferentialForm (Euclid P) n) (dilation a lam y), ?_⟩, fun y => rfl⟩
      change IsTestForm (fun y => (ω : DifferentialForm (Euclid P) n) (dilation a lam y)) ∧
        tsupport (fun y => (ω : DifferentialForm (Euclid P) n) (dilation a lam y)) ⊆ univ
      refine ⟨⟨hsmooth.comp hηsmooth, ?_⟩, subset_univ _⟩
      have h := hcompact.comp_homeomorph ((Homeomorph.smulOfNeZero lam⁻¹
        (inv_ne_zero hne)).trans (Homeomorph.addLeft (-(lam⁻¹ • a))))
      rwa [hη] at h
    -- `η_{a,λ#}C(ω) = C(η^#ω) = λ⁻ⁿ C(ω ∘ η)`, since `(η^#ω)(y) = ω(η(y)) ∘ (λ⁻¹ id)`
    have hpush : ∀ (ω : TestFormOn (dilation a lam '' univ) n)
        (ω' : TestFormOn (univ : Set (Euclid P)) n),
        (∀ y, (ω' : DifferentialForm (Euclid P) n) y =
          (ω : DifferentialForm (Euclid P) n) (dilation a lam y)) →
        blowUp C a lam hne ω = lam⁻¹ ^ n * C ω' := by
      intro ω ω' hω
      unfold blowUp
      rw [GeometricCurrentOn.affinePushforward_apply, GeometricCurrentOn.restrictDomain_apply,
        show lam⁻¹ ^ n * C ω' = C (lam⁻¹ ^ n • ω') by rw [map_smul, smul_eq_mul]]
      congr 1
      apply Subtype.ext
      funext y
      ext v
      rw [testFormOnInclusion_coe, affinePullbackTestOn_coe]
      simp only [affinePullbackForm, ContinuousAlternatingMap.compContinuousLinearMap_apply]
      have hv : ⇑(dilationCLM P lam) ∘ v = fun i => lam⁻¹ • v i := by
        funext i
        simp [dilationCLM]
      rw [hv, ContinuousAlternatingMap.map_smul_univ, Finset.prod_const, Finset.card_univ,
        Fintype.card_fin, show -(lam⁻¹ • a) + dilationCLM P lam y = dilation a lam y from rfl,
        ← hω y]
      simp
    refine ⟨{ carrier := dilation a lam '' R.carrier
              mult := fun z => R.mult (a + lam • z)
              orient := fun z => R.orient (a + lam • z)
              measurableSet_carrier := hme.measurableSet_image.mpr R.measurableSet_carrier
              carrier_subset := image_mono R.carrier_subset
              rectifiable := ?_
              measurable_mult := R.measurable_mult.comp (by fun_prop)
              mult_pos := ?_
              locallyIntegrable_mult := ?_
              aestronglyMeasurable_orient := ?_
              orients := ?_ }, ?_, ?_⟩
    · -- `η(M) ⊆ η(M₀) ∪ ⋃ⱼ range (η ∘ Fⱼ)` with `Hⁿ(η(M₀)) = 0` and `η ∘ Fⱼ` Lipschitz
      obtain ⟨M₀, hM₀, F, hF, hcover⟩ := R.rectifiable
      refine ⟨dilation a lam '' M₀, by rw [himage a lam hlam, hM₀, mul_zero],
        fun j => dilation a lam ∘ F j, fun j => ?_, ?_⟩
      · obtain ⟨K, hK⟩ := hF j
        exact ⟨_, ((isometry_add_left (-(lam⁻¹ • a))).lipschitzWith.comp
          (dilationCLM P lam).lipschitzWith).comp hK⟩
      · rintro _ ⟨y, hy, rfl⟩
        rcases hcover hy with h0 | h1
        · exact Or.inl ⟨y, h0, rfl⟩
        · obtain ⟨j, v, rfl⟩ := mem_iUnion.mp h1
          exact Or.inr (mem_iUnion.mpr ⟨j, v, rfl⟩)
    · rintro _ ⟨y, hy, rfl⟩
      show 0 < R.mult (a + lam • dilation a lam y)
      rw [hιη]
      exact R.mult_pos y hy
    · -- `η(M) ∩ K = η(M ∩ η⁻¹(K))`, and `η⁻¹(K)` is compact
      intro K hK _
      rw [← image_inter_preimage, hlint]
      simp only [hιη]
      refine ENNReal.mul_ne_top ENNReal.ofReal_ne_top
        (R.locallyIntegrable_mult _ ?_ (subset_univ _))
      rw [← hη]
      exact (Homeomorph.isCompact_preimage _).mpr hK
    · rw [hkey]
      refine (hme.aestronglyMeasurable_map_iff.mpr ?_).smul_measure κ
      simpa [Function.comp_def, hιη] using R.aestronglyMeasurable_orient
    · rw [hkey]
      refine Measure.ae_smul_measure (hme.ae_map_iff.mpr (R.orients.mono fun y hy => ?_)) κ
      obtain ⟨Q, hQ, hξ⟩ := hy
      exact ⟨Q, htan y Q hQ, by simpa [hιη] using hξ⟩
    · -- `η_{a,λ#}C(ω) = λ⁻ⁿ ∫_M θ ⟨ω ∘ η, ξ⟩ dHⁿ = ∫_{η(M)} θ ∘ η⁻¹ ⟨ω, ξ ∘ η⁻¹⟩ dHⁿ`
      intro ω
      obtain ⟨ω', hω'⟩ := hpull ω
      rw [hpush ω ω' hω', hR ω']
      simp only [IMRep.action]
      rw [hint]
      congr 1
      refine setIntegral_congr_fun R.measurableSet_carrier fun y _ => ?_
      simp [hιη, hω']
    · -- `∫_B θ ∘ η⁻¹ d(Hⁿ⌞η(M)) = κ ∫_{η⁻¹(B)} θ d(Hⁿ⌞M)`
      intro s hs
      simp only [IMRep.measure]
      rw [withDensity_apply _ hs, withDensity_apply _ (hme.measurable hs), hkey,
        Measure.restrict_smul, hme.restrict_map, lintegral_smul_measure, hme.lintegral_map]
      simp [hιη]
  choose Rs hRs hRsmeas using fun j => hblow (lams j) (hlams j)
  -- Step 3: `μ_{R_j} = λⱼ⁻ⁿ (η_j)_#μ_R`, so `∫ g dμ_{R_j} = λⱼ⁻ⁿ ∫ g ∘ η_j dμ_R` (no
  -- integrability needed)
  have hcont : ∀ j, Continuous (dilation a (lams j)) := fun j => by
    unfold dilation
    fun_prop
  have hmeasEq : ∀ j, (Rs j).measure =
      ENNReal.ofReal ((lams j)⁻¹ ^ n) • R.measure.map (dilation a (lams j)) := by
    intro j
    ext s hs
    rw [hRsmeas j s hs, Measure.smul_apply, Measure.map_apply (hcont j).measurable hs, smul_eq_mul]
  have hint : ∀ j, ∫ x, g x ∂(Rs j).measure =
      (lams j)⁻¹ ^ n * ∫ x, g (dilation a (lams j) x) ∂R.measure := by
    intro j
    rw [hmeasEq j, integral_smul_measure,
      integral_map (hcont j).measurable.aemeasurable hg.aestronglyMeasurable,
      ENNReal.toReal_ofReal (pow_nonneg (inv_nonneg.mpr (hlams j).le) n), smul_eq_mul]
  -- Step 4: test `μ_{η_{a,λⱼ#}C} → μ_{C'}` against `g`
  have h := hconv Rs hRs R' hR'rep g hg hgc (subset_univ _)
  rw [hlim] at h
  simpa only [hint] using h
/-- **Two orthonormal frames of one `2`-plane** (used in the proof of Simon 7.3.3).  If
`a, e ∈ Q` (`dim Q = 2`) are orthonormal and lie in the span of the orthonormal pair `τ`, then
`span τ = Q` (`span {a, e}` is a `2`-plane inside both), and `α(τ) = ε α(a, e)`, `ε = ±1`, for
every `2`-covector `α`: writing `a = c₀τ₀ + c₁τ₁`, `e = d₀τ₀ + d₁τ₁`, bilinearity and alternation
give `α(a, e) = D α(τ)` with `D = c₀d₁ − c₁d₀`, and `D² = 1` by Lagrange's identity. -/
theorem Submission.idtp_cse_etp_plane_frame_sign : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (τ : Fin 2 → Euclid P), Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → Orthonormal ℝ τ → a ∈ Submodule.span ℝ (Set.range τ) → e ∈ Submodule.span ℝ (Set.range τ) → Submodule.span ℝ (Set.range τ) = Q ∧ ∃ ε : ℤ, ε.natAbs = 1 ∧ ∀ α : Covector (Euclid P) 2, α τ = (ε : ℝ) * α ![a, e] := by
  intro P Q a e τ hQ haQ heQ ha he hae hτ haτ heτ
  -- `![a, e]` is orthonormal, so `W = span {a, e}` is a plane inside both `Q` and `span τ`
  have hae' : Orthonormal ℝ ![a, e] := by
    refine ⟨Fin.forall_fin_two.mpr ⟨ha, he⟩, fun i j hij => ?_⟩
    fin_cases i <;> fin_cases j
    · exact absurd rfl hij
    · simpa using hae
    · simpa [real_inner_comm] using hae
    · exact absurd rfl hij
  have hWdim : Module.finrank ℝ (Submodule.span ℝ (Set.range ![a, e])) = 2 := by
    rw [finrank_span_eq_card hae'.linearIndependent, Fintype.card_fin]
  have hτdim : Module.finrank ℝ (Submodule.span ℝ (Set.range τ)) = 2 := by
    rw [finrank_span_eq_card hτ.linearIndependent, Fintype.card_fin]
  have hWτ : Submodule.span ℝ (Set.range ![a, e]) = Submodule.span ℝ (Set.range τ) :=
    Submodule.eq_of_le_of_finrank_eq
      (Submodule.span_le.mpr (Set.range_subset_iff.mpr (Fin.forall_fin_two.mpr ⟨haτ, heτ⟩)))
      (by rw [hWdim, hτdim])
  have hWQ : Submodule.span ℝ (Set.range ![a, e]) = Q :=
    Submodule.eq_of_le_of_finrank_eq
      (Submodule.span_le.mpr (Set.range_subset_iff.mpr (Fin.forall_fin_two.mpr ⟨haQ, heQ⟩)))
      (by rw [hWdim, hQ])
  refine ⟨hWτ.symm.trans hWQ, ?_⟩
  -- coordinates `a = c₀τ₀ + c₁τ₁`, `e = d₀τ₀ + d₁τ₁`
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp haτ
  obtain ⟨d, hd⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp heτ
  have hi : ∀ u v : Fin 2 → ℝ,
      inner ℝ (∑ i, u i • τ i) (∑ i, v i • τ i) = u 0 * v 0 + u 1 * v 1 := by
    intro u v
    rw [hτ.inner_sum u v Finset.univ, Fin.sum_univ_two]
    simp
  have h1 := hi c c
  rw [hc, real_inner_self_eq_norm_sq, ha] at h1
  have h2 := hi d d
  rw [hd, real_inner_self_eq_norm_sq, he] at h2
  have h3 := hi c d
  rw [hc, hd, hae] at h3
  -- Lagrange's identity: the determinant `D = c₀d₁ − c₁d₀` has `D² = 1`
  have hD : (c 0 * d 1 - c 1 * d 0) * (c 0 * d 1 - c 1 * d 0) = 1 := by
    linear_combination (-(d 0 * d 0 + d 1 * d 1)) * h1 - h2 + (c 0 * d 0 + c 1 * d 1) * h3
  -- bilinearity and alternation of a `2`-covector: `α(a, e) = D α(τ)`
  have hα : ∀ α : Covector (Euclid P) 2, α ![a, e] = (c 0 * d 1 - c 1 * d 0) * α τ := by
    intro α
    have hu0 : ∀ x y w : Euclid P, update ![x, y] 0 w = ![w, y] := by
      intro x y w; funext i; fin_cases i <;> rfl
    have hu1 : ∀ x y w : Euclid P, update ![x, y] 1 w = ![x, w] := by
      intro x y w; funext i; fin_cases i <;> rfl
    have add0 : ∀ x y z : Euclid P, α ![x + y, z] = α ![x, z] + α ![y, z] := by
      intro x y z
      have h := α.map_update_add ![x, z] 0 x y
      rwa [hu0, hu0, hu0] at h
    have add1 : ∀ x y z : Euclid P, α ![x, y + z] = α ![x, y] + α ![x, z] := by
      intro x y z
      have h := α.map_update_add ![x, y] 1 y z
      rwa [hu1, hu1, hu1] at h
    have smul0 : ∀ (r : ℝ) (x z : Euclid P), α ![r • x, z] = r * α ![x, z] := by
      intro r x z
      have h := α.map_update_smul ![x, z] 0 r x
      rwa [hu0, hu0, smul_eq_mul] at h
    have smul1 : ∀ (r : ℝ) (x z : Euclid P), α ![x, r • z] = r * α ![x, z] := by
      intro r x z
      have h := α.map_update_smul ![x, z] 1 r z
      rwa [hu1, hu1, smul_eq_mul] at h
    have diag : ∀ x : Euclid P, α ![x, x] = 0 := fun x =>
      α.map_eq_zero_of_eq ![x, x] (i := 0) (j := 1) rfl (by decide)
    have anti : ∀ x y : Euclid P, α ![y, x] = -α ![x, y] := by
      intro x y
      have h := diag (x + y)
      rw [add0, add1, add1, diag, diag] at h
      linarith
    rw [← hc, ← hd, Fin.sum_univ_two, Fin.sum_univ_two]
    simp only [add0, add1, smul0, smul1, diag]
    rw [anti (τ 0) (τ 1),
      show (![τ 0, τ 1] : Fin 2 → Euclid P) = τ by funext i; fin_cases i <;> rfl]
    ring
  have key : ∀ α : Covector (Euclid P) 2, α τ = (c 0 * d 1 - c 1 * d 0) * α ![a, e] := by
    intro α
    rw [hα α, ← mul_assoc, hD, one_mul]
  rcases mul_self_eq_one_iff.mp hD with h | h
  · exact ⟨1, rfl, fun α => by rw [key α, h]; norm_num⟩
  · exact ⟨-1, rfl, fun α => by rw [key α, h]; norm_num⟩
/-- **Simon Ch. 6, 3.1–3.2** (the weight `θHᵏ⌞M`): for an integer multiplicity triple
`R = (M, θ, ξ)` in `W`, `R.measure = (Hᵏ⌞M).withDensity θ` has the same null sets as `Hᵏ⌞M`
(`θ` is measurable and `θ ≥ 1` on `M`).  For Borel `A`, `R.measure(A) = ∫_{M ∩ A} θ dHᵏ`; hence
`R.measure(ℝᴾ \ M) = 0`, and `R.measure(K) < ∞` for compact `K ⊆ W` by local integrability of
`θ`.  Absolute continuity makes `ξ` a.e. strongly measurable for `R.measure`, and
`R.action ω = ∫_M θ⟨ω, ξ⟩ dHᵏ = ∫ ⟨ω, ξ⟩ dR.measure` for every form `ω`. -/
theorem Submission.cbr_imRep_measure_basic : ∀ (P k : ℕ) (W : Set (Euclid P)) (R : IMRep W k), R.measure ≪ μHE[k].restrict R.carrier ∧ μHE[k].restrict R.carrier ≪ R.measure ∧ (∀ A : Set (Euclid P), MeasurableSet A → R.measure A = ∫⁻ x in R.carrier ∩ A, (R.mult x : ℝ≥0∞) ∂μHE[k]) ∧ R.measure R.carrierᶜ = 0 ∧ (∀ K : Set (Euclid P), IsCompact K → K ⊆ W → R.measure K < ∞) ∧ AEStronglyMeasurable R.orient R.measure ∧ ∀ ω : DifferentialForm (Euclid P) k, R.action ω = ∫ x, R.orient x (ω x) ∂R.measure := by
  intro P k W R
  -- the density `θ`, as an `ℝ≥0`-valued measurable function
  have hθ : Measurable fun x => (R.mult x : NNReal) := measurable_from_nat.comp R.measurable_mult
  -- (a) a measure with density is absolutely continuous w.r.t. its base measure
  have hac : R.measure ≪ μHE[k].restrict R.carrier := withDensity_absolutelyContinuous _ _
  -- (c) `μ(A) = ∫_A θ d(Hᵏ⌞M) = ∫_{M ∩ A} θ dHᵏ` for Borel `A`
  have happly : ∀ A : Set (Euclid P), MeasurableSet A →
      R.measure A = ∫⁻ x in R.carrier ∩ A, (R.mult x : ℝ≥0∞) ∂μHE[k] := fun A hA => by
    rw [IMRep.measure, withDensity_apply _ hA, Measure.restrict_restrict hA, inter_comm A]
  refine ⟨hac, ?_, happly, ?_, fun K hK hKW => ?_, R.aestronglyMeasurable_orient.mono_ac hac,
    fun ω => ?_⟩
  -- (b) `θ ≠ 0` on `M`, hence `Hᵏ⌞M`-a.e.
  · refine withDensity_absolutelyContinuous'
      (measurable_from_nat.comp R.measurable_mult).aemeasurable ?_
    filter_upwards [ae_restrict_mem R.measurableSet_carrier] with x hx
    exact Nat.cast_ne_zero.2 (R.mult_pos x hx).ne'
  -- (d) `M ∩ Mᶜ = ∅`
  · rw [happly _ R.measurableSet_carrier.compl, inter_compl_self, Measure.restrict_empty,
      lintegral_zero_measure]
  -- (e) local integrability of `θ`
  · rw [happly K hK.measurableSet]
    exact lt_top_iff_ne_top.2 (R.locallyIntegrable_mult K hK hKW)
  -- (g) `∫ ⟨ω, ξ⟩ d(θ Hᵏ⌞M) = ∫_M θ ⟨ω, ξ⟩ dHᵏ`
  · have h := integral_withDensity_eq_integral_smul (μ := μHE[k].restrict R.carrier) hθ
      fun x => R.orient x (ω x)
    simp only [ENNReal.coe_natCast] at h
    rw [IMRep.measure, h, IMRep.action]
    refine integral_congr_ae (Eventually.of_forall fun x => ?_)
    simp [NNReal.smul_def]

/-- **Test forms and the blow-up under the dilation `η_{x,λ}(y) = λ⁻¹(y − x)`, `λ > 0`** (Simon
Ch. 3, 1.4, chapter-03.txt line 85; push-forward 6.2.23, chapter-06.txt lines 403–413; used for
`η_{x,λⱼ#}T` in the proof of 7.3.1, chapter-07.txt lines 329–337).  `η = η_{x,λ}` is an affine
homeomorphism of `ℝᴾ` with inverse `ι(z) = x + λz`, and `η⁻¹(η(U)) = U`.  (a) `ω ↦ ω ∘ η` maps
`𝒟ⁿ(η(U))` to `𝒟ⁿ(U)`; (b) `ω' ↦ ω' ∘ ι` maps `𝒟ⁿ(U)` to `𝒟ⁿ(η(U))`, and `(ω' ∘ ι) ∘ η = ω'`;
(c) if `ω' = ω ∘ η` then `η_{x,λ#}T(ω) = T(η^#ω) = λ⁻ⁿ T(ω')`, since by multilinearity
`(η^#ω)(y) = ω(η(y)) ∘ (λ⁻¹ id) = λ⁻ⁿ ω(η(y))`. -/
theorem Submission.dtc_blowUp_testForm_corr : ∀ (P n : ℕ) (U : Set (Euclid P)) (x : Euclid P) (lam : ℝ) (hlam : 0 < lam), (∀ ω : TestFormOn (dilation x lam '' U) n, ∃ ω' : TestFormOn U n, ∀ y : Euclid P, (ω' : DifferentialForm (Euclid P) n) y = (ω : DifferentialForm (Euclid P) n) (dilation x lam y)) ∧ (∀ ω' : TestFormOn U n, ∃ ω : TestFormOn (dilation x lam '' U) n, ∀ y : Euclid P, (ω' : DifferentialForm (Euclid P) n) y = (ω : DifferentialForm (Euclid P) n) (dilation x lam y)) ∧ ∀ (T : GeometricCurrentOn U n) (ω : TestFormOn (dilation x lam '' U) n) (ω' : TestFormOn U n), (∀ y : Euclid P, (ω' : DifferentialForm (Euclid P) n) y = (ω : DifferentialForm (Euclid P) n) (dilation x lam y)) → blowUp T x lam hlam.ne' ω = lam⁻¹ ^ n * T ω' := by
  intro P n U x lam hlam
  have hne : lam ≠ 0 := hlam.ne'
  -- Step 1: `η = η_{x,λ}` (`y ↦ −λ⁻¹x + λ⁻¹y`) and `ι(z) = x + λz` are mutually inverse affine
  -- homeomorphisms, both `C^∞`.  (`∞` is `ℝ≥0∞`'s top under `open scoped ENNReal`.)
  let η : Euclid P ≃ₜ Euclid P := (Homeomorph.smulOfNeZero lam⁻¹ (inv_ne_zero hne)).trans
    (Homeomorph.addLeft (-(lam⁻¹ • x)))
  have hη : ⇑η = dilation x lam := by
    funext y
    simp [η, dilation, dilationCLM]
  let ι : Euclid P ≃ₜ Euclid P := (Homeomorph.smulOfNeZero lam hne).trans (Homeomorph.addLeft x)
  have hι : ⇑ι = fun z => x + lam • z := by
    funext z
    simp [ι]
  have hηι : ∀ z, dilation x lam (x + lam • z) = z := by
    intro z
    simp [dilation, dilationCLM, smul_add, smul_smul, hne]
  have hιη : ∀ y, x + lam • dilation x lam y = y := by
    intro y
    simp [dilation, dilationCLM, smul_add, smul_smul, hne]
  have hηsmooth : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (dilation x lam) :=
    contDiff_const.add (dilationCLM P lam).contDiff
  have hιsmooth : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun z : Euclid P => x + lam • z) :=
    contDiff_const.add (contDiff_id.const_smul lam)
  refine ⟨?_, ?_, ?_⟩
  · -- (a) `ω' := ω ∘ η`: smooth, compactly supported (`η` a homeomorphism), and
    -- `tsupport ω' ⊆ η⁻¹(tsupport ω) ⊆ η⁻¹(η(U)) = U`.
    intro ω
    obtain ⟨⟨hsmooth, hcompact⟩, hsupp⟩ := ω.property
    refine ⟨⟨fun y => (ω : DifferentialForm (Euclid P) n) (dilation x lam y), ?_⟩, fun y => rfl⟩
    change IsTestForm (fun y => (ω : DifferentialForm (Euclid P) n) (dilation x lam y)) ∧
      tsupport (fun y => (ω : DifferentialForm (Euclid P) n) (dilation x lam y)) ⊆ U
    refine ⟨⟨hsmooth.comp hηsmooth, ?_⟩, ?_⟩
    · have h := hcompact.comp_homeomorph η
      rwa [hη] at h
    · refine (tsupport_comp_subset_preimage (ω : DifferentialForm (Euclid P) n)
        (hη ▸ η.continuous)).trans ((preimage_mono hsupp).trans ?_)
      rw [preimage_image_eq U (hη ▸ η.injective)]
  · -- (b) `ω := ω' ∘ ι`: a test form with `tsupport ω ⊆ ι⁻¹(U) ⊆ η(U)`, and `ω ∘ η = ω'`.
    intro ω'
    obtain ⟨⟨hsmooth, hcompact⟩, hsupp⟩ := ω'.property
    refine ⟨⟨fun z => (ω' : DifferentialForm (Euclid P) n) (x + lam • z), ?_⟩, fun y => ?_⟩
    · change IsTestForm (fun z => (ω' : DifferentialForm (Euclid P) n) (x + lam • z)) ∧
        tsupport (fun z => (ω' : DifferentialForm (Euclid P) n) (x + lam • z)) ⊆ dilation x lam '' U
      refine ⟨⟨hsmooth.comp hιsmooth, ?_⟩, ?_⟩
      · have h := hcompact.comp_homeomorph ι
        rwa [hι] at h
      · refine (tsupport_comp_subset_preimage (ω' : DifferentialForm (Euclid P) n)
          (hι ▸ ι.continuous)).trans fun z hz => ?_
        exact ⟨x + lam • z, hsupp hz, hηι z⟩
    · change (ω' : DifferentialForm (Euclid P) n) y =
        (ω' : DifferentialForm (Euclid P) n) (x + lam • dilation x lam y)
      rw [hιη]
  · -- (c) `η_{x,λ#}T(ω) = T(η^#ω)`, and `η^#ω = λ⁻ⁿ ω'` by multilinearity; `T` is linear.
    intro T ω ω' hω
    unfold blowUp
    rw [GeometricCurrentOn.affinePushforward_apply, GeometricCurrentOn.restrictDomain_apply,
      show lam⁻¹ ^ n * T ω' = T (lam⁻¹ ^ n • ω') by rw [map_smul, smul_eq_mul]]
    congr 1
    apply Subtype.ext
    funext y
    ext v
    rw [testFormOnInclusion_coe, affinePullbackTestOn_coe]
    simp only [affinePullbackForm, ContinuousAlternatingMap.compContinuousLinearMap_apply]
    have hv : ⇑(dilationCLM P lam) ∘ v = fun i => lam⁻¹ • v i := by
      funext i
      simp [dilationCLM]
    rw [hv, ContinuousAlternatingMap.map_smul_univ, Finset.prod_const, Finset.card_univ,
      Fintype.card_fin, show -(lam⁻¹ • x) + dilationCLM P lam y = dilation x lam y from rfl, ← hω y]
    simp
/-- **The blow-up of a represented current on the form `ω = g β`** (push-forward 6.2.23,
chapter-06.txt lines 403–413; `T = τ(M, θ, ξ)`, 6.3.1 (‡), chapter-06.txt lines 733–748; the
blow-ups `η_{x,λⱼ#}T` in the proof of 7.3.1, chapter-07.txt lines 325–337).  Let `R` represent
`C ∈ 𝒟ₙ(ℝᴾ)`, `μ = R.measure`, `ξ = R.orient`, `t > 0`, and `ω ∈ 𝒟ⁿ(ℝᴾ)` with `ω(x) = g(x) β`.
`η = η_{a,t}` is onto, so `ω` is a test form on the domain `η(ℝᴾ)` of `η_{a,t#}C`, and
`η_{a,t#}C(ω) = t⁻ⁿ C(ω ∘ η) = t⁻ⁿ ∫ ⟨g(η(y)) β, ξ(y)⟩ dμ = t⁻ⁿ ∫ g(η(y)) ⟨β, ξ(y)⟩ dμ`. -/
theorem Submission.idtp_cse_bml_td_blowUp_smul_form_eval : ∀ (P n : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) n) (R : IMRep (univ : Set (Euclid P)) n) (a : Euclid P) (t : ℝ) (ht : 0 < t) (g : Euclid P → ℝ) (β : Covector (Euclid P) n) (ω : TestFormOn (univ : Set (Euclid P)) n), R.Represents C → (∀ x, (ω : DifferentialForm (Euclid P) n) x = g x • β) → currentEval (blowUp C a t ht.ne') (ω : DifferentialForm (Euclid P) n) = t⁻¹ ^ n * ∫ y, g (dilation a t y) * R.orient y β ∂R.measure := by
  intro P n C R a t ht g β ω hRC hω
  -- Step 1: `η = η_{a,t}` is onto (`η(a + tz) = z`), so `ω` is a test form on `η(ℝᴾ)` and
  -- `currentEval` takes its positive branch.
  have hsurj : dilation a t '' (univ : Set (Euclid P)) = univ :=
    eq_univ_of_forall fun z => ⟨a + t • z, mem_univ _, by
      simp [dilation, dilationCLM, smul_add, smul_smul, ht.ne']⟩
  have hmem : IsTestForm (ω : DifferentialForm (Euclid P) n) ∧
      tsupport (ω : DifferentialForm (Euclid P) n) ⊆ dilation a t '' univ :=
    ⟨ω.2.1, by rw [hsurj]; exact subset_univ _⟩
  rw [currentEval, dite_eq_left hmem]
  -- Step 2: `ω' = ω ∘ η ∈ 𝒟ⁿ(ℝᴾ)` and `η_{a,t#}C(ω) = t⁻ⁿ C(ω')`; `C(ω') = ∫ ⟨ω', ξ⟩ dμ`.
  obtain ⟨ω', hω'⟩ := (Submission.dtc_blowUp_testForm_corr P n univ a t ht).1 ⟨ω, hmem⟩
  rw [(Submission.dtc_blowUp_testForm_corr P n univ a t ht).2.2 C ⟨ω, hmem⟩ ω' hω', hRC ω',
    (Submission.cbr_imRep_measure_basic P n univ R).2.2.2.2.2.2]
  -- Step 3: `⟨ω'(y), ξ(y)⟩ = ⟨g(η(y)) β, ξ(y)⟩ = g(η(y)) ⟨β, ξ(y)⟩` pointwise, by linearity.
  congr 1
  refine integral_congr_ae (Eventually.of_forall fun y => ?_)
  simp only [hω', hω, map_smul, smul_eq_mul]
/-- Single-scale calibration bound for the tilt excess on `B_{3t}(a)`.  With
`h = ϑ ∘ dilation a t` (continuous with compact support, so `μ`-integrable; `h ≥ 0`, `h = 1` on
`B_{3t}(a)`), the ball integral of `1 - |d|` is at most `∫ h (1 - |d|) dμ`, and
`∫ h (1 - |d|) dμ = ∫ h dμ - ∫ h |d| dμ ≤ ∫ h dμ - |∫ h d dμ|`; divide by `t²`. -/
theorem Submission.idtp_cse_bml_td_excess_bound : ∀ (P : ℕ) (μ : Measure (Euclid P)) (d ϑ : Euclid P → ℝ) (a : Euclid P) (t : ℝ), 0 < t → (∀ K : Set (Euclid P), IsCompact K → μ K < ∞) → AEStronglyMeasurable d μ → (∀ᵐ x ∂μ, |d x| ≤ 1) → Continuous ϑ → HasCompactSupport ϑ → (∀ x, 0 ≤ ϑ x) → (∀ x : Euclid P, ‖x‖ < 3 → ϑ x = 1) → (∫⁻ x in ball a (3 * t), ENNReal.ofReal (1 - |d x|) ∂μ) / ENNReal.ofReal (t ^ 2) ≤ ENNReal.ofReal (t⁻¹ ^ 2 * ∫ x, ϑ (dilation a t x) ∂μ - |t⁻¹ ^ 2 * ∫ x, ϑ (dilation a t x) * d x ∂μ|) := by
  intro P μ d ϑ a t ht hloc hdm hd1 hϑc hϑcs hϑ0 hϑ1
  have : IsFiniteMeasureOnCompacts μ := ⟨fun K hK => hloc K hK⟩
  -- `dilation a t` is the homeomorphism `x ↦ -(t⁻¹ • a) + t⁻¹ • x`
  let e : Euclid P ≃ₜ Euclid P :=
    (Homeomorph.smulOfNeZero t⁻¹ (inv_ne_zero ht.ne')).trans (Homeomorph.addLeft (-(t⁻¹ • a)))
  have he : (fun x => ϑ (dilation a t x)) = ϑ ∘ e := by
    funext x
    simp [e, dilation, dilationCLM]
  have hdil : ∀ x, dilation a t x = t⁻¹ • (x - a) := fun x => by
    simp [dilation, dilationCLM, smul_sub]
    abel
  set h : Euclid P → ℝ := fun x => ϑ (dilation a t x)
  have hcont : Continuous h := by
    rw [he]
    exact hϑc.comp e.continuous
  have hint : Integrable h μ := by
    refine hcont.integrable_of_hasCompactSupport ?_
    rw [he]
    exact hϑcs.comp_homeomorph e
  have hnn : ∀ x, 0 ≤ h x := fun x => hϑ0 _
  -- `h = 1` on `B_{3t}(a)`
  have hone : ∀ x ∈ ball a (3 * t), h x = 1 := by
    intro x hx
    rw [mem_ball, dist_eq_norm] at hx
    apply hϑ1
    rw [hdil, norm_smul, norm_inv, Real.norm_of_nonneg ht.le, inv_mul_lt_iff₀ ht]
    linarith
  -- `h d`, `h |d|` and `h (1 - |d|)` are integrable, being dominated by `h`
  have hdom : ∀ᵐ x ∂μ, h x * |d x| ≤ h x := by
    filter_upwards [hd1] with x hx
    simpa using mul_le_mul_of_nonneg_left hx (hnn x)
  have hhd : Integrable (fun x => h x * d x) μ := by
    refine hint.mono' (hcont.aestronglyMeasurable.mul hdm) ?_
    filter_upwards [hdom] with x hx
    rwa [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hnn x)]
  have hha : Integrable (fun x => h x * |d x|) μ := by
    refine hint.mono' (hcont.aestronglyMeasurable.mul hdm.norm) ?_
    filter_upwards [hdom] with x hx
    rwa [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hnn x), abs_abs]
  have hE : Integrable (fun x => h x * (1 - |d x|)) μ := by
    refine (hint.sub hha).congr (Eventually.of_forall fun x => ?_)
    simp only [Pi.sub_apply]
    ring
  have hE0 : 0 ≤ᵐ[μ] fun x => h x * (1 - |d x|) := by
    filter_upwards [hd1] with x hx
    exact mul_nonneg (hnn x) (by linarith)
  -- the ball estimate
  have hball : ∫⁻ x in ball a (3 * t), ENNReal.ofReal (1 - |d x|) ∂μ ≤
      ENNReal.ofReal (∫ x, h x * (1 - |d x|) ∂μ) := by
    rw [ofReal_integral_eq_lintegral_ofReal hE hE0, ← lintegral_indicator measurableSet_ball]
    refine lintegral_mono fun x => ?_
    by_cases hx : x ∈ ball a (3 * t)
    · rw [indicator_of_mem hx, hone x hx, one_mul]
    · rw [indicator_of_notMem hx]
      exact zero_le
  -- the calibration inequality
  have hcal : ∫ x, h x * (1 - |d x|) ∂μ ≤ ∫ x, h x ∂μ - |∫ x, h x * d x ∂μ| := by
    have h1 : ∫ x, h x * (1 - |d x|) ∂μ = ∫ x, h x ∂μ - ∫ x, h x * |d x| ∂μ := by
      rw [← integral_sub hint hha]
      congr 1
      funext x
      ring
    have h2 : |∫ x, h x * d x ∂μ| ≤ ∫ x, h x * |d x| ∂μ := by
      refine abs_integral_le_integral_abs.trans (le_of_eq ?_)
      congr 1
      funext x
      rw [abs_mul, abs_of_nonneg (hnn x)]
    linarith
  -- rescaling
  have ht2 : 0 < t ^ 2 := by positivity
  calc (∫⁻ x in ball a (3 * t), ENNReal.ofReal (1 - |d x|) ∂μ) / ENNReal.ofReal (t ^ 2)
      ≤ ENNReal.ofReal (∫ x, h x ∂μ - |∫ x, h x * d x ∂μ|) / ENNReal.ofReal (t ^ 2) := by
        gcongr
        exact hball.trans (ENNReal.ofReal_le_ofReal hcal)
    _ = ENNReal.ofReal ((∫ x, h x ∂μ - |∫ x, h x * d x ∂μ|) / t ^ 2) :=
        (ENNReal.ofReal_div_of_pos ht2).symm
    _ = ENNReal.ofReal (t⁻¹ ^ 2 * ∫ x, h x ∂μ - |t⁻¹ ^ 2 * ∫ x, h x * d x ∂μ|) := by
        congr 1
        rw [abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ t⁻¹ ^ 2)]
        field_simp
/-- **One-sided limits at `0⁺` from subsequences of positive null sequences.**  If every
sequence `λⱼ > 0`, `λⱼ → 0` has a subsequence along which `f(λ_{φ(j)}) → L`, then `f(t) → L` as
`t ↓ 0`.  `𝓝[>] 0` is countably generated, so by the subsequence criterion it suffices to treat a
sequence `ns → 0⁺`.  It is positive from some `N` on and tends to `0`, so `λⱼ = ns (j + N)` is a
positive null sequence; the hypothesis gives `φ` with `f(λ_{φ(j)}) → L`, and `ms j = φ j + N` is
the required subsequence of `ns`. -/
theorem Submission.idtp_cse_bml_tendsto_nhdsGT_of_subseq : ∀ (f : ℝ → ℝ≥0∞) (L : ℝ≥0∞), (∀ lams : ℕ → ℝ, (∀ j, 0 < lams j) → Tendsto lams atTop (𝓝 0) → ∃ φ : ℕ → ℕ, StrictMono φ ∧ Tendsto (fun j => f (lams (φ j))) atTop (𝓝 L)) → Tendsto f (𝓝[>] 0) (𝓝 L) := by
  intro f L h
  -- `𝓝[>] 0` is countably generated: it suffices to treat sequences `ns → 0⁺`
  refine tendsto_of_subseq_tendsto fun ns hns => ?_
  -- `0 < ns n` for `n ≥ N` and `ns → 0`, so `λⱼ = ns (j + N)` is a positive null sequence
  obtain ⟨N, hN⟩ := eventually_atTop.1 (hns.eventually_mem self_mem_nhdsWithin)
  obtain ⟨φ, -, hφ⟩ := h (fun j => ns (j + N)) (fun j => hN (j + N) (Nat.le_add_left N j))
    ((tendsto_nhdsWithin_iff.1 hns).1.comp (tendsto_add_atTop_nat N))
  -- `ms j = φ j + N` gives `ns (ms j) = λ_{φ(j)}`
  exact ⟨fun j => φ j + N, hφ⟩
/-- **Cubic bound `|arctan z − z| ≤ |z|³`** (step 1(e) of the box inclusions in the proof of
Simon 7.3.3).  `g(t) = arctan t − t` has `g(0) = 0` and
`g'(t) = 1/(1 + t²) − 1 = −t²/(1 + t²)`, so `|g'(t)| ≤ t²`.  The mean value theorem on
`[min 0 z, max 0 z]` gives `arctan z − z = g'(ξ) z` for some `ξ` strictly between `0` and `z`,
hence `|arctan z − z| ≤ ξ² |z| ≤ |z|³`. -/
theorem Submission.idtp_cse_bml_rbi_abs_arctan_sub_self_le : ∀ z : ℝ, |Real.arctan z - z| ≤ |z| ^ 3 := by
  intro z
  -- step 1: both sides vanish at `z = 0`
  rcases eq_or_ne z 0 with rfl | hz
  · simp
  -- step 2: `g(t) = arctan t − t` is differentiable with `g'(t) = 1/(1 + t²) − 1`
  have hg : ∀ t : ℝ, HasDerivAt (fun t => Real.arctan t - t) (1 / (1 + t ^ 2) - 1) t :=
    fun t => (Real.hasDerivAt_arctan t).sub (hasDerivAt_id t)
  -- step 3: `|g'(ξ)| = ξ²/(1 + ξ²) ≤ ξ²`
  have hg' : ∀ ξ : ℝ, |1 / (1 + ξ ^ 2) - 1| ≤ ξ ^ 2 := by
    intro ξ
    have hpos : 0 < 1 + ξ ^ 2 := by positivity
    rw [show 1 / (1 + ξ ^ 2) - 1 = -(ξ ^ 2 / (1 + ξ ^ 2)) by field_simp; ring, abs_neg,
      abs_of_nonneg (by positivity)]
    exact div_le_self (sq_nonneg ξ) (le_add_of_nonneg_right (sq_nonneg ξ))
  -- step 4: the mean value theorem on `[min 0 z, max 0 z]` gives `arctan z − z = g'(ξ) z`
  obtain ⟨ξ, hξ, hslope⟩ := exists_hasDerivAt_eq_slope (fun t => Real.arctan t - t)
    (fun t => 1 / (1 + t ^ 2) - 1) (min_lt_max.2 hz.symm)
    (fun t _ => (hg t).continuousAt.continuousWithinAt) (fun t _ => hg t)
  have hval : Real.arctan z - z = (1 / (1 + ξ ^ 2) - 1) * z := by
    rw [hslope]
    rcases hz.lt_or_gt with h | h
    · rw [min_eq_right h.le, max_eq_left h.le, Real.arctan_zero]
      field_simp
      ring
    · rw [min_eq_left h.le, max_eq_right h.le, Real.arctan_zero]
      field_simp
      ring
  -- step 5: `ξ` lies strictly between `0` and `z`, so `ξ² ≤ |z|²`
  have hξz : ξ ^ 2 ≤ |z| ^ 2 := by
    have h := Set.abs_sub_left_of_mem_uIcc (Set.Ioo_subset_Icc_self hξ)
    rw [sub_zero, sub_zero] at h
    rw [← sq_abs ξ]
    exact pow_le_pow_left₀ (abs_nonneg ξ) h 2
  -- step 6: `|arctan z − z| = |g'(ξ)| |z| ≤ ξ² |z| ≤ |z|³`
  calc |Real.arctan z - z| = |1 / (1 + ξ ^ 2) - 1| * |z| := by rw [hval, abs_mul]
    _ ≤ ξ ^ 2 * |z| := mul_le_mul_of_nonneg_right (hg' ξ) (abs_nonneg z)
    _ ≤ |z| ^ 2 * |z| := mul_le_mul_of_nonneg_right hξz (abs_nonneg z)
    _ = |z| ^ 3 := by ring

/-- Arctangent of a perturbed quotient: if `0 < s'`, `20s' < 1` and `|p|, |q| ≤ 3s'`, then
`|arctan(q/(1 + p)) − q| ≤ 30s'²`.  Here `1 + p > 17/20`, so `z = q/(1 + p)` has `|z| ≤ 4s'` and
`|z − q| = |q||p|/(1 + p) ≤ 11s'²`, while the cubic bound `|arctan z − z| ≤ |z|³` gives
`|arctan z − z| ≤ 64s'³ ≤ 4s'²`. -/
theorem Submission.idtp_cse_bml_rbi_arctan_quotient_estimate : ∀ (p q s' : ℝ), 0 < s' → 20 * s' < 1 → |p| ≤ 3 * s' → |q| ≤ 3 * s' → |Real.arctan (q / (1 + p)) - q| ≤ 30 * s' ^ 2 := by
  intro p q s' hs h20 hp hq
  -- `1 + p ≥ 1 − 3s' > 17/20`, so `z = q/(1 + p)` is a genuine quotient
  have hd : 17 / 20 < 1 + p := by linarith [neg_abs_le p]
  have hd0 : 0 < 1 + p := by linarith
  set z := q / (1 + p) with hz
  -- `|z| = |q|/(1 + p) ≤ 60s'/17 ≤ 4s'`
  have hz4 : |z| ≤ 4 * s' := by
    rw [hz, abs_div, abs_of_pos hd0, div_le_iff₀ hd0]
    nlinarith [mul_lt_mul_of_pos_left hd hs]
  -- `z − q = −qp/(1 + p)`, so `|z − q| = |q||p|/(1 + p) ≤ 180s'²/17 ≤ 11s'²`
  have hzq : |z - q| ≤ 11 * s' ^ 2 := by
    have hqp : |q| * |p| ≤ 3 * s' * (3 * s') := mul_le_mul hq hp (abs_nonneg p) (by linarith)
    rw [show z - q = -(q * p) / (1 + p) by rw [hz]; field_simp; ring, abs_div, abs_neg, abs_mul,
      abs_of_pos hd0, div_le_iff₀ hd0]
    nlinarith [mul_lt_mul_of_pos_left hd (by positivity : (0 : ℝ) < 11 * s' ^ 2), sq_nonneg s']
  -- the cubic bound: `|arctan z − z| ≤ |z|³ ≤ 64s'³ ≤ 4s'²`, as `s' < 1/20`
  have hat : |Real.arctan z - z| ≤ 4 * s' ^ 2 := by
    refine (Submission.idtp_cse_bml_rbi_abs_arctan_sub_self_le z).trans ?_
    have h3 : |z| ^ 3 ≤ (4 * s') ^ 3 := pow_le_pow_left₀ (abs_nonneg z) hz4 3
    nlinarith [mul_le_mul_of_nonneg_left (by linarith : 16 * s' ≤ 1) (sq_nonneg s')]
  -- triangle inequality: `|arctan z − q| ≤ 4s'² + 11s'² ≤ 30s'²`
  calc |Real.arctan z - q| ≤ |Real.arctan z - z| + |z - q| := abs_sub_le _ _ _
    _ ≤ 4 * s' ^ 2 + 11 * s' ^ 2 := add_le_add hat hzq
    _ ≤ 30 * s' ^ 2 := by nlinarith [sq_nonneg s']
/-- **Second-order expansion of `|a + s'w|` at a unit vector `a`** (steps 1(a), 1(d) of the
box-inclusion estimate in the proof of Simon 7.3.3).  With `t = |a + s'w|`, `p = s'⟨w, a⟩` and
`y = 2p + s'²|w|²` one has `t² = 1 + y`, `|y| ≤ 7s'`, hence `(t − 1)² ≤ y² ≤ 49s'²` (as
`(t + 1)² ≥ 1`), and `t − 1 − p = (s'²|w|² − (t − 1)²) / 2` lies in `[−49s'²/2, 9s'²/2]`. -/
theorem Submission.idtp_cse_bml_rbi_norm_expansion : ∀ (P : ℕ) (a w : Euclid P) (s' : ℝ), ‖a‖ = 1 → ‖w‖ ≤ 3 → 0 < s' → 20 * s' < 1 → |‖a + s' • w‖ - 1 - s' * inner ℝ w a| ≤ 30 * s' ^ 2 := by
  intro P a w s' ha hw hs hs20
  -- Step 1: `|⟨w, a⟩| ≤ |w| |a| = |w| ≤ 3` (Cauchy–Schwarz), so `|p| ≤ 3s'`
  have hinner : |inner ℝ w a| ≤ 3 := by
    calc |inner ℝ w a| ≤ ‖w‖ * ‖a‖ := abs_real_inner_le_norm w a
      _ = ‖w‖ := by rw [ha, mul_one]
      _ ≤ 3 := hw
  have hp : |s' * inner ℝ w a| ≤ 3 * s' := by
    rw [abs_mul, abs_of_pos hs, mul_comm]
    exact mul_le_mul_of_nonneg_right hinner hs.le
  -- Step 2: `t² = 1 + y`, `y = 2p + s'²|w|²`
  have hsq : ‖a + s' • w‖ ^ 2 = 1 + (2 * (s' * inner ℝ w a) + s' ^ 2 * ‖w‖ ^ 2) := by
    rw [norm_add_sq_real, ha, real_inner_smul_right, real_inner_comm w a, norm_smul,
      Real.norm_eq_abs, abs_of_pos hs]
    ring
  set t := ‖a + s' • w‖
  set p := s' * inner ℝ w a
  have ht0 : 0 ≤ t := norm_nonneg _
  have hw0 : 0 ≤ ‖w‖ := norm_nonneg w
  -- Step 3: `0 ≤ s'²|w|² ≤ 9s'² ≤ s'`, hence `|y| ≤ 6s' + s' = 7s'`
  have hW : s' ^ 2 * ‖w‖ ^ 2 ≤ 9 * s' ^ 2 := by
    have : ‖w‖ ^ 2 ≤ 3 ^ 2 := pow_le_pow_left₀ hw0 hw 2
    nlinarith [sq_nonneg s']
  have hW0 : 0 ≤ s' ^ 2 * ‖w‖ ^ 2 := by positivity
  have h9 : 9 * s' ^ 2 ≤ s' := by nlinarith
  have hy : |2 * p + s' ^ 2 * ‖w‖ ^ 2| ≤ 7 * s' := by
    rw [abs_le] at hp ⊢
    constructor <;> linarith [hp.1, hp.2]
  -- Step 4: `(t − 1)(t + 1) = y` and `(t + 1)² ≥ 1`, so `(t − 1)² ≤ y² ≤ 49s'²`
  have hty : (t - 1) * (t + 1) = 2 * p + s' ^ 2 * ‖w‖ ^ 2 := by linear_combination hsq
  have htsq : (t - 1) ^ 2 ≤ 49 * s' ^ 2 := by
    have h1 : (t - 1) ^ 2 ≤ ((t - 1) * (t + 1)) ^ 2 := by
      rw [mul_pow]
      have : 1 ≤ (t + 1) ^ 2 := by nlinarith
      nlinarith [sq_nonneg (t - 1)]
    have h2 : (2 * p + s' ^ 2 * ‖w‖ ^ 2) ^ 2 ≤ (7 * s') ^ 2 :=
      sq_le_sq' (abs_le.1 hy).1 (abs_le.1 hy).2
    rw [hty] at h1
    nlinarith
  -- Steps 5–7: `t − 1 − p = (s'²|w|² − (t − 1)²) / 2 ∈ [−49s'²/2, 9s'²/2]`
  have hkey : t - 1 - p = (s' ^ 2 * ‖w‖ ^ 2 - (t - 1) ^ 2) / 2 := by
    linear_combination hsq / 2
  rw [hkey, abs_le]
  constructor <;> nlinarith [sq_nonneg (t - 1), sq_nonneg s']
/-- Projection residual of `a + s'w` for `a ∈ Q`, `s' ≥ 0`: with `π = Q.starProjection`, `πa = a`
and linearity give `(a + s'w) − π(a + s'w) = s'(w − πw)`; since `w − πw = π_{Qᗮ}w`, Pythagoras
`‖w‖² = ‖πw‖² + ‖w − πw‖²` gives `‖w − πw‖ ≤ ‖w‖`, so the residual has norm at most `s'‖w‖`. -/
theorem Submission.idtp_cse_bml_rbi_projection_residual_le : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (a w : Euclid P) (s' : ℝ), a ∈ Q → 0 ≤ s' → ‖(a + s' • w) - Q.starProjection (a + s' • w)‖ ≤ s' * ‖w‖ := by
  intro P Q a w s' ha hs'
  -- `πa = a`, since `a ∈ Q`
  have hπa : Q.starProjection a = a := Submodule.starProjection_eq_self_iff.mpr ha
  -- by linearity the residual is `s' • (w − πw)`
  have hres : (a + s' • w) - Q.starProjection (a + s' • w) = s' • (w - Q.starProjection w) := by
    rw [map_add, map_smul, hπa, smul_sub, add_sub_add_left_eq_sub]
  -- `w − πw = π_{Qᗮ}w`, so Pythagoras gives `‖w‖² = ‖πw‖² + ‖w − πw‖²`
  have hpyth : ‖w‖ ^ 2 = ‖Q.starProjection w‖ ^ 2 + ‖w - Q.starProjection w‖ ^ 2 := by
    rw [← Submodule.starProjection_orthogonal_val]
    exact Submodule.norm_sq_eq_add_norm_sq_starProjection w Q
  have hle : ‖w - Q.starProjection w‖ ≤ ‖w‖ := by
    refine (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mp ?_
    rw [hpyth]
    exact le_add_of_nonneg_left (sq_nonneg _)
  -- `‖s' • (w − πw)‖ = s'‖w − πw‖ ≤ s'‖w‖`, as `s' ≥ 0`
  rw [hres, norm_smul, Real.norm_of_nonneg hs']
  exact mul_le_mul_of_nonneg_left hle hs'

/-- **Rescaled box inclusions** (box-mass limits in the proof of Simon 7.3.3).  With the open box
`U = {w : ‖w‖ < 3, |⟨w, a⟩| < 1 − η, |⟨w, e⟩| < 1 − η}`, the closed box
`K = {w : ‖w‖ ≤ 3, |⟨w, a⟩| ≤ 1 + η, |⟨w, e⟩| ≤ 1 + η}` and the sector
`Z(s, s') = {x : ⟨x, a⟩ > 0, |‖x‖ − 1| < s', |arctan(⟨x, e⟩/⟨x, a⟩)| < s', ‖x − πx‖ < s‖x‖}`,
`η_{a,s'}⁻¹(U) ⊆ Z(s, s')` and `Z(s, s') ∩ B_{3s'}(a) ⊆ η_{a,s'}⁻¹(K)`.  Write `x = a + s'w` with
`w = η_{a,s'}(x) = s'⁻¹(x − a)`; then `⟨x, a⟩ = 1 + p`, `⟨x, e⟩ = q` for `p = s'⟨w, a⟩`,
`q = s'⟨w, e⟩`, and for `‖w‖ ≤ 3`: `|‖x‖ − 1 − p| ≤ 30s'²`, `|arctan(q/(1 + p)) − q| ≤ 30s'²` and
`‖x − πx‖ ≤ s'‖w‖`.  If `w ∈ U` then `|p|, |q| < s'(1 − η)`, so `x ∈ Z(s, s')` as `30s' < η` and
`6s' < s`; if `x ∈ Z(s, s')` and `|x − a| < 3s'` then `‖w‖ < 3` and
`|p|, |q| < s' + 30s'² < s'(1 + η)`. -/
theorem Submission.idtp_cse_bml_rescaled_box_inclusions : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (s η s' : ℝ), a ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → 0 < η → 0 < s' → 20 * s' < 1 → 30 * s' < η → 6 * s' < s → dilation a s' ⁻¹' {w : Euclid P | ‖w‖ < 3 ∧ |inner ℝ w a| < 1 - η ∧ |inner ℝ w e| < 1 - η} ⊆ {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s' ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} ∧ {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s' ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} ∩ ball a (3 * s') ⊆ dilation a s' ⁻¹' {w : Euclid P | ‖w‖ ≤ 3 ∧ |inner ℝ w a| ≤ 1 + η ∧ |inner ℝ w e| ≤ 1 + η} := by
  intro P Q a e s η s' haQ ha he hae hη hs h20 h30 h6
  -- `η_{a,s'}(y) = −s'⁻¹a + s'⁻¹y`, so `η_{a,s'}(a + s'w) = w` and `x = a + s'η_{a,s'}(x)`
  have hdil : ∀ w : Euclid P, dilation a s' (a + s' • w) = w := by
    intro w
    simp only [dilation, dilationCLM, smul_apply, ContinuousLinearMap.id_apply, smul_add,
      smul_smul, inv_mul_cancel₀ hs.ne', one_smul, neg_add_cancel_left]
  have hrep : ∀ x : Euclid P, ∃ w : Euclid P, x = a + s' • w := by
    intro x
    refine ⟨dilation a s' x, ?_⟩
    simp only [dilation, dilationCLM, smul_apply, ContinuousLinearMap.id_apply, smul_add,
      smul_neg, smul_smul, mul_inv_cancel₀ hs.ne', one_smul, add_neg_cancel_left]
  -- `⟨x, a⟩ = 1 + p` and `⟨x, e⟩ = q`, as `‖a‖ = 1` and `⟨a, e⟩ = 0`
  have hxa : ∀ w : Euclid P, inner ℝ (a + s' • w) a = 1 + s' * inner ℝ w a := by
    intro w
    rw [inner_add_left, real_inner_self_eq_norm_sq, ha, one_pow, real_inner_smul_left]
  have hxe : ∀ w : Euclid P, inner ℝ (a + s' • w) e = s' * inner ℝ w e := by
    intro w
    rw [inner_add_left, hae, real_inner_smul_left, zero_add]
  -- `|s't| ≤ 3s'` whenever `|t| ≤ 3`
  have h3 : ∀ t : ℝ, |t| ≤ 3 → |s' * t| ≤ 3 * s' := by
    intro t ht
    rw [abs_mul, abs_of_pos hs, mul_comm]
    exact mul_le_mul_of_nonneg_right ht hs.le
  -- the error `30s'²` is less than `s'η`
  have hsη : 30 * s' ^ 2 < s' * η := by nlinarith
  constructor
  · -- step 2: `η_{a,s'}⁻¹(U) ⊆ Z(s, s')`
    intro x hx
    obtain ⟨w, rfl⟩ := hrep x
    rw [Set.mem_preimage, hdil] at hx
    obtain ⟨hw3, hwa, hwe⟩ := hx
    -- `|p|, |q| < s'(1 − η) < s'`
    have hp : |s' * inner ℝ w a| < s' * (1 - η) := by
      rw [abs_mul, abs_of_pos hs]
      exact mul_lt_mul_of_pos_left hwa hs
    have hq : |s' * inner ℝ w e| < s' * (1 - η) := by
      rw [abs_mul, abs_of_pos hs]
      exact mul_lt_mul_of_pos_left hwe hs
    have hp3 : |s' * inner ℝ w a| ≤ 3 * s' := h3 _ (by linarith)
    have hq3 : |s' * inner ℝ w e| ≤ 3 * s' := h3 _ (by linarith)
    have hN := Submission.idtp_cse_bml_rbi_norm_expansion P a w s' ha hw3.le hs h20
    have hA := Submission.idtp_cse_bml_rbi_arctan_quotient_estimate _ _ s' hs h20 hp3 hq3
    have hR := Submission.idtp_cse_bml_rbi_projection_residual_le P Q a w s' haQ hs.le
    -- `|‖x‖ − 1| ≤ |p| + 30s'² < s'(1 − η) + s'η = s'`
    have hnorm : |‖a + s' • w‖ - 1| < s' := by
      rw [abs_le] at hN
      rw [abs_lt] at hp ⊢
      constructor <;> linarith
    simp only [Set.mem_ofPred_eq]
    rw [hxa, hxe]
    refine ⟨?_, hnorm, ?_, ?_⟩
    · -- `⟨x, a⟩ = 1 + p > 1 − s' > 0`
      have := (abs_lt.1 hp).1
      nlinarith
    · -- `|arctan(q/(1 + p))| ≤ |q| + 30s'² < s'(1 − η) + s'η = s'`
      rw [abs_le] at hA
      rw [abs_lt] at hq ⊢
      constructor <;> linarith
    · -- `‖x − πx‖ ≤ s'‖w‖ < 3s' < s‖x‖`, as `‖x‖ > 1 − s' > 1/2` and `s > 6s'`
      have hx1 := (abs_lt.1 hnorm).1
      have hxpos : 0 < ‖a + s' • w‖ := by linarith
      calc ‖a + s' • w - Q.starProjection (a + s' • w)‖ ≤ s' * ‖w‖ := hR
        _ < 3 * s' := by nlinarith
        _ < s * ‖a + s' • w‖ := by nlinarith [mul_pos (sub_pos.2 h6) hxpos]
  · -- step 3: `Z(s, s') ∩ B_{3s'}(a) ⊆ η_{a,s'}⁻¹(K)`
    rintro x ⟨hx, hxB⟩
    obtain ⟨w, rfl⟩ := hrep x
    simp only [Set.mem_ofPred_eq] at hx
    rw [hxa, hxe] at hx
    obtain ⟨-, hx1, hxat, -⟩ := hx
    rw [Set.mem_preimage, hdil]
    -- `s'‖w‖ = ‖x − a‖ < 3s'`, so `‖w‖ < 3`
    have hw3 : ‖w‖ < 3 := by
      rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_eq_abs,
        abs_of_pos hs] at hxB
      nlinarith
    -- Cauchy–Schwarz: `|p|, |q| ≤ s'‖w‖ ≤ 3s'`
    have hp3 : |s' * inner ℝ w a| ≤ 3 * s' :=
      h3 _ ((abs_real_inner_le_norm w a).trans (by rw [ha, mul_one]; exact hw3.le))
    have hq3 : |s' * inner ℝ w e| ≤ 3 * s' :=
      h3 _ ((abs_real_inner_le_norm w e).trans (by rw [he, mul_one]; exact hw3.le))
    have hN := Submission.idtp_cse_bml_rbi_norm_expansion P a w s' ha hw3.le hs h20
    have hA := Submission.idtp_cse_bml_rbi_arctan_quotient_estimate _ _ s' hs h20 hp3 hq3
    rw [abs_le] at hN hA
    rw [abs_lt] at hx1 hxat
    refine ⟨hw3.le, ?_, ?_⟩
    · -- `|p| ≤ |‖x‖ − 1| + 30s'² < s' + s'η`, so `|⟨w, a⟩| < 1 + η`
      have hu : s' * inner ℝ w a < s' * (1 + η) := by linarith
      have hl : s' * -(1 + η) < s' * inner ℝ w a := by linarith
      exact abs_le.2 ⟨(lt_of_mul_lt_mul_left hl hs.le).le, (lt_of_mul_lt_mul_left hu hs.le).le⟩
    · -- `|q| ≤ |arctan(q/(1 + p))| + 30s'² < s' + s'η`, so `|⟨w, e⟩| < 1 + η`
      have hu : s' * inner ℝ w e < s' * (1 + η) := by linarith
      have hl : s' * -(1 + η) < s' * inner ℝ w e := by linarith
      exact abs_le.2 ⟨(lt_of_mul_lt_mul_left hl hs.le).le, (lt_of_mul_lt_mul_left hu hs.le).le⟩
/-- **Rescaled points with a uniform lower mass bound lie in the limit set** (the common core of
steps 2(d) and 3 of the edge tangent-plane argument in the cone-sector endpoint density proof for
Simon 7.3.3).  Let `μ` be finite on compact subsets of `ℝᴾ`, `S ⊆ ℝᴾ` closed, `λⱼ > 0` and
`wⱼ → w`.  Suppose `λⱼ⁻² ∫ g ∘ η_{a,λⱼ} dμ → m ∫_S g dH²` for every continuous compactly
supported `g`, and for each `r > 0` eventually `ω₂ (λⱼ r)² ≤ μ(B_{λⱼ r}(a + λⱼ wⱼ))`.  Then
`w ∈ S`.  Otherwise some `B_ρ(w)` misses `S`; with `r = ρ/4`, the bump
`g = min(1, max(0, 2 - |z - w|/(2r)))` vanishes on `S`, so the rescaled integrals tend to `0`.
But once `|wⱼ - w| < r`, `η_{a,λⱼ}` maps `B_{λⱼ r}(a + λⱼ wⱼ)` into `B̄_{2r}(w)`, where `g = 1`,
so `λⱼ⁻² ∫ g ∘ η_{a,λⱼ} dμ ≥ λⱼ⁻² μ(B_{λⱼ r}(a + λⱼ wⱼ)) ≥ ω₂ r² > 0` eventually. -/
theorem Submission.idtp_cse_etp_rescaled_limit_mem : ∀ (P : ℕ) (μ : Measure (Euclid P)) (S : Set (Euclid P)) (a w : Euclid P) (m : ℝ) (lams : ℕ → ℝ) (ws : ℕ → Euclid P), IsClosed S → (∀ K : Set (Euclid P), IsCompact K → μ K ≠ ∞) → (∀ j, 0 < lams j) → Tendsto ws atTop (𝓝 w) → (∀ g : Euclid P → ℝ, Continuous g → HasCompactSupport g → Tendsto (fun j => (lams j)⁻¹ ^ 2 * ∫ x, g (dilation a (lams j) x) ∂μ) atTop (𝓝 (m * ∫ x in S, g x ∂μHE[2]))) → (∀ r : ℝ, 0 < r → ∀ᶠ j in atTop, unitBallVolume 2 * ENNReal.ofReal ((lams j * r) ^ 2) ≤ μ (ball (a + lams j • ws j) (lams j * r))) → w ∈ S := by
  intro P μ S a w m lams ws hS hμ hlam hws hV hL
  by_contra hw
  -- step 2: a ball `B_ρ(w)` misses `S`; `r = ρ / 4`
  obtain ⟨ρ, hρ, hρS⟩ := Metric.isOpen_iff.1 hS.isOpen_compl w hw
  obtain ⟨r, hr_def⟩ : ∃ r : ℝ, r = ρ / 4 := ⟨_, rfl⟩
  have hr : 0 < r := by rw [hr_def]; positivity
  -- the bump `g`: `g = 1` on `closedBall w (2r)`, `g = 0` off `ball w ρ`, `g ≥ 0`
  obtain ⟨g, hg_def⟩ : ∃ g : Euclid P → ℝ, g = fun z => min 1 (max 0 (2 - dist z w / (2 * r))) :=
    ⟨_, rfl⟩
  have hg_cont : Continuous g := by rw [hg_def]; fun_prop
  have hg_nonneg : ∀ z, 0 ≤ g z := fun z => by
    rw [hg_def]
    exact le_min zero_le_one (le_max_left _ _)
  have hg_one : ∀ z, dist z w ≤ 2 * r → g z = 1 := by
    intro z hz
    have h : 1 ≤ 2 - dist z w / (2 * r) := by
      have : dist z w / (2 * r) ≤ 1 := (div_le_one₀ (by positivity)).2 hz
      linarith
    rw [hg_def]
    exact min_eq_left (h.trans (le_max_right _ _))
  have hg_zero : ∀ z, ρ ≤ dist z w → g z = 0 := by
    intro z hz
    have h : 2 - dist z w / (2 * r) ≤ 0 := by
      have : 2 ≤ dist z w / (2 * r) := by
        rw [le_div_iff₀ (by positivity)]
        linarith
      linarith
    rw [hg_def]
    simp only [max_eq_left h, min_eq_right zero_le_one]
  have hg_supp : HasCompactSupport g :=
    HasCompactSupport.intro (isCompact_closedBall w ρ) fun z hz =>
      hg_zero z (not_le.1 (by simpa only [Metric.mem_closedBall] using hz)).le
  -- `g = 0` on `S`, so `∫_S g dH² = 0` and the rescaled integrals tend to `0`
  have hgS : ∫ x in S, g x ∂μHE[2] = 0 :=
    setIntegral_eq_zero_of_forall_eq_zero fun x hx =>
      hg_zero x (not_lt.1 fun h => hρS (Metric.mem_ball.2 h) hx)
  have hlim := hV g hg_cont hg_supp
  rw [hgS, mul_zero] at hlim
  -- step 1: `κ = ω₂ ∈ (0, ∞)`
  have hκ : 0 < (unitBallVolume 2).toReal := by
    have h0 : (0 : ℝ≥0∞) < volume (ball (0 : Euclid 2) 1) := measure_ball_pos _ _ one_pos
    have h1 : volume (ball (0 : Euclid 2) 1) < ∞ := measure_ball_lt_top
    exact ENNReal.toReal_pos h0.ne' h1.ne
  -- `ηⱼ = dilation a λⱼ` scales distances by `λⱼ⁻¹`
  have hdil : ∀ l : ℝ, 0 < l → ∀ x v : Euclid P,
      dist (dilation a l x) v = l⁻¹ * dist x (a + l • v) := by
    intro l hl x v
    have h : dilation a l x - v = l⁻¹ • (x - (a + l • v)) := by
      simp only [dilation, dilationCLM, smul_apply, ContinuousLinearMap.id_apply]
      rw [smul_sub, smul_add, smul_smul, inv_mul_cancel₀ hl.ne', one_smul]
      abel
    rw [dist_eq_norm, h, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hl.le), ← dist_eq_norm]
  have : IsFiniteMeasureOnCompacts μ := ⟨fun K hK => lt_top_iff_ne_top.2 (hμ K hK)⟩
  -- steps 3–4: `κ r² ≤ λⱼ⁻² ∫ g ∘ ηⱼ dμ` for all large `j`
  have hlow : ∀ᶠ j in atTop,
      (unitBallVolume 2).toReal * r ^ 2 ≤ (lams j)⁻¹ ^ 2 * ∫ x, g (dilation a (lams j) x) ∂μ := by
    filter_upwards [hL r hr, Metric.tendsto_nhds.1 hws r hr] with j hj hwj
    have hl := hlam j
    have hBfin : μ (ball (a + lams j • ws j) (lams j * r)) ≠ ∞ := measure_ball_lt_top.ne
    -- `1_{Bⱼ} ≤ g ∘ ηⱼ` for `Bⱼ = B_{λⱼ r}(a + λⱼ wⱼ)`, as `ηⱼ(Bⱼ) ⊆ closedBall w (2r)`
    have hle : (ball (a + lams j • ws j) (lams j * r)).indicator (1 : Euclid P → ℝ) ≤
        fun x => g (dilation a (lams j) x) := by
      refine fun x => ?_
      by_cases hx : x ∈ ball (a + lams j • ws j) (lams j * r)
      · rw [Set.indicator_of_mem hx, Pi.one_apply]
        refine (hg_one _ ?_).ge
        have h1 : dist (dilation a (lams j) x) (ws j) < r := by
          rw [hdil _ hl, inv_mul_lt_iff₀ hl]
          exact Metric.mem_ball.1 hx
        linarith [dist_triangle (dilation a (lams j) x) (ws j) w]
      · rw [Set.indicator_of_notMem hx]
        exact hg_nonneg _
    -- step 3: both sides are `μ`-integrable (`μ` is finite on compact sets)
    have hcomp : HasCompactSupport fun x => g (dilation a (lams j) x) :=
      HasCompactSupport.intro (isCompact_closedBall (a + lams j • w) (lams j * ρ)) fun x hx => by
        refine hg_zero _ ?_
        rw [hdil _ hl, le_inv_mul_iff₀ hl]
        exact (not_le.1 (by simpa only [Metric.mem_closedBall] using hx)).le
    have hηc : Continuous (dilation a (lams j)) :=
      continuous_const.add (dilationCLM P (lams j)).continuous
    have hint_g : Integrable (fun x => g (dilation a (lams j) x)) μ :=
      (hg_cont.comp hηc).integrable_of_hasCompactSupport hcomp
    have hint_B : Integrable
        ((ball (a + lams j • ws j) (lams j * r)).indicator (1 : Euclid P → ℝ)) μ :=
      (integrableOn_const (C := (1 : ℝ)) hBfin).integrable_indicator measurableSet_ball
    -- `κ (λⱼ r)² ≤ μ(Bⱼ) ≤ ∫ g ∘ ηⱼ dμ`
    have h1 := integral_mono hint_B hint_g hle
    rw [integral_indicator_one measurableSet_ball, measureReal_def] at h1
    have h2 := ENNReal.toReal_mono hBfin hj
    rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal (sq_nonneg _)] at h2
    have hinv : (lams j)⁻¹ ^ 2 * lams j ^ 2 = 1 := by
      rw [← mul_pow, inv_mul_cancel₀ hl.ne', one_pow]
    calc (unitBallVolume 2).toReal * r ^ 2
        = (lams j)⁻¹ ^ 2 * ((unitBallVolume 2).toReal * (lams j * r) ^ 2) := by
          linear_combination (-((unitBallVolume 2).toReal * r ^ 2)) * hinv
      _ ≤ (lams j)⁻¹ ^ 2 * ∫ x, g (dilation a (lams j) x) ∂μ := by
          gcongr
          exact h2.trans h1
  -- step 5: `0 < κ r² ≤ lim λⱼ⁻² ∫ g ∘ ηⱼ dμ = 0`, a contradiction
  have h := ge_of_tendsto hlim hlow
  have hpos : 0 < (unitBallVolume 2).toReal * r ^ 2 := mul_pos hκ (pow_pos hr 2)
  linarith
/-- **Radial first-variation inequality** (Simon Ch. 4, 3.2–3.3 with the bounded generalized mean
curvature of 3.14–3.16).  Test the first variation of `v(M, θ)` with the radial field
`X(x) = η(u(x)) (x - z)`, `u(x) = ‖x - z‖² / s²`, where `η ≥ 0` is `C¹`, nonincreasing and vanishes
on `[1, ∞)`.  Then `μ`-a.e. `n η(u) + 2 u η'(u) ≤ div_M X ≤ n η(u)`, and
`|X · H| ≤ κ s η(u)`, so `n ∫ η(u) dμ + ∫ 2 u η'(u) dμ ≤ ∫ div_M X dμ = -∫ X · H dμ ≤ κ s ∫ η(u) dμ`. -/
theorem Submission.dsmc_em_cutoff_first_variation_le : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (H : Euclid P → Euclid P) (κ : ℝ) (z : Euclid P) (r : ℝ) (η : ℝ → ℝ), closedBall z r ⊆ U → AEMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) R.measure → (∀ x, ‖H x‖ ≤ κ) → (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ ball z r → R.firstVariation X = -∫ x, inner ℝ (X x) (H x) ∂R.measure) → ContDiff ℝ 1 η → (∀ u, 0 ≤ η u) → (∀ u, deriv η u ≤ 0) → (∀ u, 1 ≤ u → η u = 0) → ∀ s : ℝ, 0 < s → s < r → (n : ℝ) * ∫ x, η (‖x - z‖ ^ 2 / s ^ 2) ∂R.measure + ∫ x, 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ∂R.measure ≤ κ * s * ∫ x, η (‖x - z‖ ^ 2 / s ^ 2) ∂R.measure := by
  intro P n U R H κ z r η hzU hPm hHκ hfv hη hη0 hη'0 hη1 s hs hsr
  classical
  set μ : Measure (Euclid P) := R.measure with hμ
  /- Step 0.  `κ ≥ 0`; `μ(B̄_s(z)) < ∞`; `η' = deriv η` is continuous and vanishes on `(1, ∞)`;
  `η` and `η'` are bounded on `[0, 1]`. -/
  have hκ0 : 0 ≤ κ := (norm_nonneg _).trans (hHκ 0)
  have hBc : IsCompact (closedBall z s) := isCompact_closedBall z s
  have hBm : MeasurableSet (closedBall z s) := measurableSet_closedBall
  have hBU : closedBall z s ⊆ U := (closedBall_subset_closedBall hsr.le).trans hzU
  have hBr : closedBall z s ⊆ ball z r := closedBall_subset_ball hsr
  have hμB : μ (closedBall z s) < ∞ := by
    rw [hμ, IMRep.measure, withDensity_apply _ hBm, Measure.restrict_restrict hBm, inter_comm]
    exact lt_top_iff_ne_top.mpr (R.locallyIntegrable_mult _ hBc hBU)
  have hind : ∀ c : ℝ, Integrable ((closedBall z s).indicator fun _ => c) μ := fun c =>
    (integrable_indicator_iff hBm).mpr (integrableOn_const hμB.ne)
  have hηd : ∀ u, HasDerivAt η (deriv η u) u := fun u =>
    ((hη.differentiable (by norm_num)) u).hasDerivAt
  have hηc : Continuous η := hη.continuous
  have hη'c : Continuous (deriv η) := hη.continuous_deriv le_rfl
  have hη'1 : ∀ u, 1 < u → deriv η u = 0 := by
    intro u hu
    have : η =ᶠ[𝓝 u] fun _ => 0 := by
      filter_upwards [Ioi_mem_nhds hu] with v hv
      exact hη1 v hv.le
    rw [this.deriv_eq]
    simp
  obtain ⟨C, hC⟩ : ∃ C, ∀ u ∈ Icc (0 : ℝ) 1, ‖η u‖ ≤ C :=
    isCompact_Icc.exists_bound_of_continuousOn hηc.continuousOn
  obtain ⟨M, hM⟩ : ∃ M, ∀ u ∈ Icc (0 : ℝ) 1, ‖deriv η u‖ ≤ M :=
    isCompact_Icc.exists_bound_of_continuousOn hη'c.continuousOn
  -- the radius ratio `u(x) = ‖x - z‖² / s²`
  have hucont : Continuous fun x : Euclid P => ‖x - z‖ ^ 2 / s ^ 2 := by fun_prop
  have hu0 : ∀ x : Euclid P, 0 ≤ ‖x - z‖ ^ 2 / s ^ 2 := fun x => by positivity
  have hu_le : ∀ x ∈ closedBall z s, ‖x - z‖ ^ 2 / s ^ 2 ≤ 1 := by
    intro x hx
    rw [mem_closedBall, dist_eq_norm] at hx
    rw [div_le_one (pow_pos hs 2)]
    exact pow_le_pow_left₀ (norm_nonneg _) hx 2
  have hu_gt : ∀ x, x ∉ closedBall z s → 1 < ‖x - z‖ ^ 2 / s ^ 2 := by
    intro x hx
    rw [mem_closedBall, dist_eq_norm, not_le] at hx
    rw [one_lt_div (pow_pos hs 2)]
    exact pow_lt_pow_left₀ hx hs.le two_ne_zero
  -- the two integrands vanish off `B̄_s(z)` and are bounded on it
  have hFint : Integrable (fun x => η (‖x - z‖ ^ 2 / s ^ 2)) μ := by
    refine Integrable.mono' (hind C) (hηc.comp hucont).aestronglyMeasurable
      (ae_of_all _ fun x => ?_)
    by_cases hx : x ∈ closedBall z s
    · rw [indicator_of_mem hx]
      exact hC _ ⟨hu0 x, hu_le x hx⟩
    · rw [indicator_of_notMem hx, hη1 _ (hu_gt x hx).le, norm_zero]
  have hGint : Integrable
      (fun x => 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)) μ := by
    refine Integrable.mono' (hind (2 * M))
      ((continuous_const.mul hucont).mul (hη'c.comp hucont)).aestronglyMeasurable
      (ae_of_all _ fun x => ?_)
    by_cases hx : x ∈ closedBall z s
    · have h1 := hu_le x hx
      have h2 := hM _ ⟨hu0 x, h1⟩
      rw [Real.norm_eq_abs] at h2
      rw [indicator_of_mem hx, Real.norm_eq_abs, abs_mul, abs_mul, abs_two,
        abs_of_nonneg (hu0 x)]
      calc 2 * (‖x - z‖ ^ 2 / s ^ 2) * |deriv η (‖x - z‖ ^ 2 / s ^ 2)| ≤ 2 * 1 * M :=
            mul_le_mul (mul_le_mul_of_nonneg_left h1 zero_le_two) h2 (abs_nonneg _)
              (by norm_num)
        _ = 2 * M := by ring
    · rw [indicator_of_notMem hx, hη'1 _ (hu_gt x hx), mul_zero, norm_zero]
  /- Step 1.  The radial field `X(x) = η(u(x)) (x - z)` is `C¹`, with
  `DX(x) v = η(u) v + η'(u) (2/s²) ⟪x - z, v⟫ (x - z)` and `tsupport X ⊆ B̄_s(z) ⊆ B_r(z)`. -/
  let X : Euclid P → Euclid P := fun x => η (‖x - z‖ ^ 2 / s ^ 2) • (x - z)
  have hXd : ∀ x, HasFDerivAt X
      (η (‖x - z‖ ^ 2 / s ^ 2) • ContinuousLinearMap.id ℝ (Euclid P) +
        ((deriv η (‖x - z‖ ^ 2 / s ^ 2) * (2 / s ^ 2)) • innerSL ℝ (x - z)).smulRight
          (x - z)) x := by
    intro x
    have h1 : HasFDerivAt (fun x : Euclid P => x - z) (ContinuousLinearMap.id ℝ _) x :=
      (hasFDerivAt_id x).sub_const z
    have h3 : HasFDerivAt (fun x : Euclid P => ‖x - z‖ ^ 2 / s ^ 2)
        ((s ^ 2)⁻¹ • (2 • (innerSL ℝ (x - z)).comp (ContinuousLinearMap.id ℝ (Euclid P)))) x := by
      simpa only [div_eq_mul_inv] using HasFDerivAt.mul_const h1.norm_sq (s ^ 2)⁻¹
    have h5 := ((hηd (‖x - z‖ ^ 2 / s ^ 2)).comp_hasFDerivAt x h3).smul h1
    refine HasFDerivAt.congr_fderiv (f := X) h5 (ContinuousLinearMap.ext fun v => ?_)
    simp only [add_apply, FunLike.coe_smul, Pi.smul_apply,
      ContinuousLinearMap.id_apply, ContinuousLinearMap.smulRight_apply, innerSL_apply_apply,
      ContinuousLinearMap.comp_apply, Function.comp_apply, smul_eq_mul]
    congr 2
    rw [nsmul_eq_mul]
    push_cast
    ring
  have hXcd : ContDiff ℝ 1 X := by
    have h1 : ContDiff ℝ 1 (fun x : Euclid P => ‖x - z‖ ^ 2 / s ^ 2) :=
      ((contDiff_norm_sq ℝ).comp (contDiff_id.sub contDiff_const)).div_const _
    exact (hη.comp h1).smul (contDiff_id.sub contDiff_const)
  have hXzero : ∀ x, x ∉ closedBall z s → X x = 0 := by
    intro x hx
    show η (‖x - z‖ ^ 2 / s ^ 2) • (x - z) = 0
    rw [hη1 _ (hu_gt x hx).le, zero_smul]
  have hXts : tsupport X ⊆ closedBall z s := by
    refine closure_minimal (fun x hx => ?_) isClosed_closedBall
    by_contra h
    exact hx (hXzero x h)
  have hXcs : HasCompactSupport X := HasCompactSupport.intro hBc hXzero
  /- Step 2.  `μ`-a.e. the tangent projection is `∑ᵢ τᵢ ⟪τᵢ, ·⟫` for an orthonormal family `τ`
  of size `n` (`R.orients` and uniqueness of approximate tangent spaces). -/
  have hproj : ∀ τ : Fin n → Euclid P, Orthonormal ℝ τ →
      (Submodule.span ℝ (range τ)).starProjection =
        ∑ i, InnerProductSpace.rankOne ℝ (τ i) (τ i) := by
    intro τ hτ
    let b0 := Module.Basis.span hτ.linearIndependent
    have hb0 : ∀ i, (b0 i : Euclid P) = τ i := fun i =>
      congrArg Subtype.val (Module.Basis.span_apply hτ.linearIndependent i)
    have hb0o : Orthonormal ℝ b0 := by
      have e : (Submodule.span ℝ (range τ)).subtypeₗᵢ ∘ b0 = τ := funext hb0
      rw [← (Submodule.span ℝ (range τ)).subtypeₗᵢ.orthonormal_comp_iff, e]
      exact hτ
    rw [OrthonormalBasis.starProjection_eq_sum_rankOne (b0.toOrthonormalBasis hb0o),
      Module.Basis.coe_toOrthonormalBasis]
    simp only [hb0]
  have hμac : μ ≪ μHE[n].restrict R.carrier := withDensity_absolutelyContinuous _ _
  have hPae : ∀ᵐ x ∂μ, ∃ τ : Fin n → Euclid P, Orthonormal ℝ τ ∧
      (approxTangentPlane n R.carrier x).starProjection =
        ∑ i, InnerProductSpace.rankOne ℝ (τ i) (τ i) := by
    refine hμac.ae_le ?_
    filter_upwards [R.orients] with x ⟨Q, hQ, τ, hτ, hspan, _⟩
    have hex : ∃ Q', HasApproximateTangentSpaceAt n R.carrier x Q' := ⟨Q, hQ⟩
    have happrox : approxTangentPlane n R.carrier x = Q := by
      rw [approxTangentPlane, dite_eq_left hex]
      exact hex.choose_spec.unique hQ
    exact ⟨τ, hτ, by rw [happrox, ← hspan, hproj τ hτ]⟩
  /- Step 3.  `div_M X = n η(u) + η'(u) (2/s²) ∑ᵢ ⟪τᵢ, x - z⟫²`, and by Bessel's inequality and
  `η' ≤ 0`, `n η(u) + 2 u η'(u) ≤ div_M X ≤ n η(u)` `μ`-a.e. -/
  let d : Euclid P → ℝ := fun x => tangentialDivergence n R.carrier X x
  -- `trace ((∑ τᵢ ⊗ τᵢ) ∘ L) = ∑ ⟪τᵢ, L τᵢ⟫`
  have htr : ∀ (τ : Fin n → Euclid P) (L : Euclid P →L[ℝ] Euclid P),
      LinearMap.trace ℝ (Euclid P) ((∑ i, InnerProductSpace.rankOne ℝ (τ i) (τ i) :
        Euclid P →L[ℝ] Euclid P).toLinearMap ∘ₗ L.toLinearMap) =
        ∑ i, inner ℝ (τ i) (L (τ i)) := by
    intro τ L
    rw [← ContinuousLinearMap.toLinearMap_comp, ContinuousLinearMap.finsetSum_comp,
      ContinuousLinearMap.toLinearMap_sum, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [ContinuousLinearMap.toLinearMap_comp, LinearMap.trace_comp_comm',
      ← ContinuousLinearMap.toLinearMap_comp, InnerProductSpace.comp_rankOne,
      InnerProductSpace.trace_rankOne]
  -- Bessel's inequality
  have hbessel : ∀ (τ : Fin n → Euclid P), Orthonormal ℝ τ → ∀ v : Euclid P,
      ∑ i, inner ℝ (τ i) v ^ 2 ≤ ‖v‖ ^ 2 := by
    intro τ hτ v
    have := hτ.sum_inner_products_le (s := Finset.univ) (x := v)
    simpa [Real.norm_eq_abs, sq_abs] using this
  have hdae : ∀ᵐ x ∂μ,
      n * η (‖x - z‖ ^ 2 / s ^ 2) + 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ≤
        d x ∧ d x ≤ n * η (‖x - z‖ ^ 2 / s ^ 2) := by
    filter_upwards [hPae] with x ⟨τ, hτ, hPx⟩
    have h1 : ∀ i, inner ℝ (τ i) (τ i) = (1 : ℝ) := fun i => by
      rw [real_inner_self_eq_norm_sq, hτ.1 i, one_pow]
    have e : d x = n * η (‖x - z‖ ^ 2 / s ^ 2) + deriv η (‖x - z‖ ^ 2 / s ^ 2) * (2 / s ^ 2) *
        ∑ i, inner ℝ (τ i) (x - z) ^ 2 := by
      show tangentialDivergence n R.carrier X x = _
      unfold tangentialDivergence
      rw [hPx, (hXd x).fderiv, htr]
      simp only [add_apply, FunLike.coe_smul, Pi.smul_apply, ContinuousLinearMap.id_apply,
        ContinuousLinearMap.smulRight_apply, innerSL_apply_apply, smul_eq_mul, inner_add_right,
        inner_smul_right, h1, Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ,
        Fintype.card_fin, nsmul_eq_mul, mul_one, Finset.mul_sum]
      congr 1
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [real_inner_comm (x - z) (τ i)]
      ring
    have hb := hbessel τ hτ (x - z)
    have hS0 : 0 ≤ ∑ i, inner ℝ (τ i) (x - z) ^ 2 := Finset.sum_nonneg fun i _ => sq_nonneg _
    have hk : deriv η (‖x - z‖ ^ 2 / s ^ 2) * (2 / s ^ 2) ≤ 0 :=
      mul_nonpos_of_nonpos_of_nonneg (hη'0 _) (div_nonneg zero_le_two (sq_nonneg s))
    have h2 := mul_le_mul_of_nonpos_left hb hk
    have h3 := mul_nonpos_of_nonpos_of_nonneg hk hS0
    have e2 : deriv η (‖x - z‖ ^ 2 / s ^ 2) * (2 / s ^ 2) * ‖x - z‖ ^ 2 =
        2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) := by ring
    rw [e]
    exact ⟨e2 ▸ add_le_add le_rfl h2, add_le_of_nonpos_right h3⟩
  /- Step 4.  `div_M X` is `μ`-integrable: it is `AEStronglyMeasurable` (the tangent projection
  is `μ`-measurable, `DX` is continuous, `(A, B) ↦ trace (A ∘ B)` is continuous) and
  `|div_M X| ≤ n η(u) + |2 u η'(u)|` `μ`-a.e. -/
  have hTc : Continuous fun p : (Euclid P →L[ℝ] Euclid P) × (Euclid P →L[ℝ] Euclid P) =>
      LinearMap.trace ℝ (Euclid P) (p.1.toLinearMap ∘ₗ p.2.toLinearMap) := by
    have h1 : Continuous fun A : Euclid P →L[ℝ] Euclid P =>
        LinearMap.trace ℝ (Euclid P) A.toLinearMap :=
      ((LinearMap.trace ℝ (Euclid P)).comp
        (ContinuousLinearMap.coeLM ℝ)).continuous_of_finiteDimensional
    exact h1.comp (continuous_fst.clm_comp continuous_snd)
  have hPmeas : AEStronglyMeasurable
      (fun x => (approxTangentPlane n R.carrier x).starProjection) μ := hPm.aestronglyMeasurable
  have hdmeas : AEStronglyMeasurable d μ := by
    have h3 := hTc.comp_aestronglyMeasurable
      (hPmeas.prodMk (hXcd.continuous_fderiv one_ne_zero).aestronglyMeasurable)
    show AEStronglyMeasurable (fun x => tangentialDivergence n R.carrier X x) μ
    unfold tangentialDivergence
    exact h3
  have hdint : Integrable d μ := by
    refine Integrable.mono' ((hFint.const_mul n).add hGint.abs) hdmeas ?_
    filter_upwards [hdae] with x hx
    have h0 : 0 ≤ (n : ℝ) * η (‖x - z‖ ^ 2 / s ^ 2) := mul_nonneg (Nat.cast_nonneg n) (hη0 _)
    have hG1 := neg_abs_le (2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2))
    have hG2 := abs_nonneg (2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2))
    show ‖d x‖ ≤ n * η (‖x - z‖ ^ 2 / s ^ 2) +
      |2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)|
    rw [Real.norm_eq_abs, abs_le]
    exact ⟨by linarith [hx.1], by linarith [hx.2]⟩
  /- Step 5.  `∫ f dμ = ∫_M θ f dHⁿ`, so `∫ div_M X dμ = R.firstVariation X`. -/
  have hμint : ∀ f : Euclid P → ℝ,
      ∫ x, f x ∂μ = ∫ x in R.carrier, (R.mult x : ℝ) * f x ∂μHE[n] := by
    intro f
    have hθ : (fun x => (R.mult x : ℝ≥0∞)) = fun x => ((R.mult x : NNReal) : ℝ≥0∞) := by
      funext x
      simp
    have hθm : Measurable fun x => (R.mult x : NNReal) :=
      measurable_from_top.comp R.measurable_mult
    rw [hμ, IMRep.measure, hθ, integral_withDensity_eq_integral_smul hθm]
    refine integral_congr_ae (ae_of_all _ fun x => ?_)
    simp [NNReal.smul_def]
  /- Step 6.  Integrate: `n ∫ η(u) + ∫ 2 u η'(u) ≤ ∫ div_M X = -∫ X · H ≤ κ s ∫ η(u)`, using
  `|X · H| ≤ ‖X‖ κ ≤ κ s η(u)` (`X = 0` off `B̄_s(z)`). -/
  have e1 : (n : ℝ) * ∫ x, η (‖x - z‖ ^ 2 / s ^ 2) ∂μ +
      ∫ x, 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ∂μ =
      ∫ x, ((n : ℝ) * η (‖x - z‖ ^ 2 / s ^ 2) +
        2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)) ∂μ := by
    rw [integral_add (hFint.const_mul _) hGint, integral_const_mul]
  have e3 : ∫ x, ((n : ℝ) * η (‖x - z‖ ^ 2 / s ^ 2) +
        2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)) ∂μ ≤ ∫ x, d x ∂μ := by
    refine integral_mono_ae ((hFint.const_mul _).add hGint) hdint ?_
    filter_upwards [hdae] with x hx
    exact hx.1
  have e4 : ∫ x, d x ∂μ = -∫ x, inner ℝ (X x) (H x) ∂μ := by
    rw [hμint]
    exact hfv X hXcd hXcs (hXts.trans hBr)
  have e5 : -∫ x, inner ℝ (X x) (H x) ∂μ ≤ κ * s * ∫ x, η (‖x - z‖ ^ 2 / s ^ 2) ∂μ := by
    have h1 : -∫ x, inner ℝ (X x) (H x) ∂μ ≤ ∫ x, ‖inner ℝ (X x) (H x)‖ ∂μ := by
      refine (neg_le_abs _).trans ?_
      rw [← Real.norm_eq_abs]
      exact norm_integral_le_integral_norm _
    have h2 : ∫ x, ‖inner ℝ (X x) (H x)‖ ∂μ ≤ ∫ x, κ * s * η (‖x - z‖ ^ 2 / s ^ 2) ∂μ := by
      refine integral_mono_of_nonneg (ae_of_all _ fun x => norm_nonneg _) (hFint.const_mul _)
        (ae_of_all _ fun x => ?_)
      show ‖inner ℝ (X x) (H x)‖ ≤ κ * s * η (‖x - z‖ ^ 2 / s ^ 2)
      by_cases hx : x ∈ closedBall z s
      · have hXn : ‖X x‖ ≤ η (‖x - z‖ ^ 2 / s ^ 2) * s := by
          show ‖η (‖x - z‖ ^ 2 / s ^ 2) • (x - z)‖ ≤ η (‖x - z‖ ^ 2 / s ^ 2) * s
          rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (hη0 _)]
          exact mul_le_mul_of_nonneg_left (by rwa [mem_closedBall, dist_eq_norm] at hx) (hη0 _)
        calc ‖inner ℝ (X x) (H x)‖ ≤ ‖X x‖ * ‖H x‖ := norm_inner_le_norm _ _
          _ ≤ (η (‖x - z‖ ^ 2 / s ^ 2) * s) * κ :=
            mul_le_mul hXn (hHκ x) (norm_nonneg _) (mul_nonneg (hη0 _) hs.le)
          _ = κ * s * η (‖x - z‖ ^ 2 / s ^ 2) := by ring
      · rw [hXzero x hx, inner_zero_left, norm_zero]
        exact mul_nonneg (mul_nonneg hκ0 hs.le) (hη0 _)
    rw [integral_const_mul] at h2
    exact h1.trans h2
  calc (n : ℝ) * ∫ x, η (‖x - z‖ ^ 2 / s ^ 2) ∂μ +
        ∫ x, 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ∂μ = _ := e1
    _ ≤ _ := e3
    _ = _ := e4
    _ ≤ _ := e5
/-- **Radial cutoffs for the monotonicity formula** (Simon Ch. 4, 3.1–3.4).  With
`g = Real.smoothTransition` and `ηⱼ(u) = g((j + 2)(1 − u))`, every `ηⱼ` is `C¹`, nonnegative and
nonincreasing, vanishes for `u ≥ 1`, and `ηⱼ(|x − z|²/s²)` increases to the indicator of the
open ball `B_s(z)`; by dominated convergence `∫ ηⱼ(|x − z|²/s²) dμ → μ(B_s(z))` whenever
`μ(B_s(z)) < ∞`. -/
theorem Submission.dsmc_em_cutoff_tendsto_ball : ∃ η : ℕ → ℝ → ℝ, (∀ j, ContDiff ℝ 1 (η j)) ∧ (∀ j u, 0 ≤ η j u) ∧ (∀ j u, deriv (η j) u ≤ 0) ∧ (∀ j u, 1 ≤ u → η j u = 0) ∧ ∀ (P : ℕ) (μ : Measure (Euclid P)) (z : Euclid P) (s : ℝ), 0 < s → μ (ball z s) < ∞ → Tendsto (fun j => ∫ x, η j (‖x - z‖ ^ 2 / s ^ 2) ∂μ) atTop (𝓝 (μ.real (ball z s))) := by
  -- Steps 1–5: `ηⱼ(u) = g((j + 2)(1 − u))` is `C¹`, `≥ 0`, antitone, and `0` for `u ≥ 1`.
  have hanti : ∀ j : ℕ, Antitone fun u : ℝ => Real.smoothTransition (((j : ℝ) + 2) * (1 - u)) := by
    intro j a b hab
    apply Real.smoothTransition.monotone
    have hj : (0 : ℝ) ≤ (j : ℝ) + 2 := by positivity
    nlinarith
  have hzero : ∀ (j : ℕ) (u : ℝ), 1 ≤ u →
      Real.smoothTransition (((j : ℝ) + 2) * (1 - u)) = 0 := by
    intro j u hu
    apply Real.smoothTransition.zero_of_nonpos
    have hj : (0 : ℝ) ≤ (j : ℝ) + 2 := by positivity
    nlinarith
  refine ⟨fun j u => Real.smoothTransition (((j : ℝ) + 2) * (1 - u)), fun j => ?_,
    fun j u => Real.smoothTransition.nonneg _, fun j u => (hanti j).deriv_nonpos, hzero, ?_⟩
  · exact Real.smoothTransition.contDiff.comp (contDiff_const.mul (contDiff_const.sub contDiff_id))
  -- Step 6: dominated convergence with the bound `1_{B_s(z)}`.
  intro P μ z s hs hμ
  have hs2 : 0 < s ^ 2 := by positivity
  -- `|x − z|²/s² < 1` exactly on the open ball
  have hlt : ∀ x : Euclid P, x ∈ ball z s → ‖x - z‖ ^ 2 / s ^ 2 < 1 := by
    intro x hx
    rw [mem_ball, dist_eq_norm] at hx
    rw [div_lt_one hs2]
    exact pow_lt_pow_left₀ hx (norm_nonneg _) two_ne_zero
  have hge : ∀ x : Euclid P, x ∉ ball z s → 1 ≤ ‖x - z‖ ^ 2 / s ^ 2 := by
    intro x hx
    rw [mem_ball, dist_eq_norm, not_lt] at hx
    rw [one_le_div hs2]
    exact pow_le_pow_left₀ hs.le hx 2
  have hint : Integrable ((ball z s).indicator (1 : Euclid P → ℝ)) μ :=
    (integrable_indicator_iff measurableSet_ball).2 (integrableOn_const hμ.ne)
  rw [← integral_indicator_one measurableSet_ball]
  refine tendsto_integral_of_dominated_convergence ((ball z s).indicator 1)
    (F := fun (j : ℕ) (x : Euclid P) =>
      Real.smoothTransition (((j : ℝ) + 2) * (1 - ‖x - z‖ ^ 2 / s ^ 2)))
    (fun j => ?_) hint (fun j => ae_of_all _ fun x => ?_) (ae_of_all _ fun x => ?_)
  · -- (a) each integrand is continuous
    exact (Real.smoothTransition.continuous.comp (by fun_prop)).aestronglyMeasurable
  · -- (a) `|ηⱼ(u(x))| ≤ 1_{B_s(z)}(x)`
    by_cases hx : x ∈ ball z s
    · rw [indicator_of_mem hx, Pi.one_apply, Real.norm_eq_abs,
        abs_of_nonneg (Real.smoothTransition.nonneg _)]
      exact Real.smoothTransition.le_one _
    · rw [indicator_of_notMem hx, hzero j _ (hge x hx), norm_zero]
  · -- (b) pointwise convergence to `1_{B_s(z)}(x)`
    by_cases hx : x ∈ ball z s
    · rw [indicator_of_mem hx, Pi.one_apply]
      have hpos : 0 < 1 - ‖x - z‖ ^ 2 / s ^ 2 := sub_pos.2 (hlt x hx)
      obtain ⟨N, hN⟩ := exists_nat_ge (1 / (1 - ‖x - z‖ ^ 2 / s ^ 2))
      rw [div_le_iff₀ hpos] at hN
      refine tendsto_const_nhds.congr' (eventually_atTop.2 ⟨N, fun j hj => ?_⟩)
      have hj : (N : ℝ) ≤ j := by exact_mod_cast hj
      refine (Real.smoothTransition.one_of_one_le ?_).symm
      nlinarith
    · rw [indicator_of_notMem hx]
      exact tendsto_const_nhds.congr fun j => (hzero j _ (hge x hx)).symm

/-- **Integrating factor for the monotonicity identity** (Simon Ch. 4, 3.16–3.17).  If `I` is
continuous on `(0, r]`, has derivative `I'` on `(0, r)` and `n I(s) − s I'(s) ≤ κ s I(s)` there,
then `s ↦ e^{κs} s⁻ⁿ I(s)` is nondecreasing on `(0, r]`.  On `(0, r]` this function equals
`G(s) = exp(κs − n log s) I(s)`, and `G'(s) = exp(κs − n log s) s⁻¹ (κ s I(s) − (n I(s) − s I'(s)))
≥ 0` on `(0, r)`, so the mean value theorem applies. -/
theorem Submission.dsmc_em_exp_monotoneOn_of_deriv_ineq : ∀ (n : ℕ) (κ r : ℝ) (I I' : ℝ → ℝ), ContinuousOn I (Ioc 0 r) → (∀ s ∈ Ioo 0 r, HasDerivAt I (I' s) s) → (∀ s ∈ Ioo 0 r, (n : ℝ) * I s - s * I' s ≤ κ * s * I s) → MonotoneOn (fun s => Real.exp (κ * s) / s ^ n * I s) (Ioc 0 r) := by
  intro n κ r I I' hIc hId hineq
  -- on `(0, r]`, `e^{κs}/sⁿ · I(s) = G(s) := exp(κs − n log s) · I(s)`
  refine MonotoneOn.congr (f₁ := fun s => Real.exp (κ * s - n * Real.log s) * I s) ?_ ?_
  swap
  · intro s hs
    simp only [Real.exp_sub, Real.exp_nat_mul, Real.exp_log hs.1]
  -- `G` is continuous on `(0, r]`
  have hGc : ContinuousOn (fun s => Real.exp (κ * s - n * Real.log s) * I s) (Ioc 0 r) := by
    refine ContinuousOn.mul (Real.continuous_exp.comp_continuousOn ?_) hIc
    exact (continuousOn_const.mul continuousOn_id).sub
      (continuousOn_const.mul (Real.continuousOn_log.mono fun s hs => hs.1.ne'))
  -- `G' = exp(κs − n log s) · ((κ − n/s) I + I') ≥ 0` on `(0, r)`; mean value theorem
  refine monotoneOn_of_hasDerivWithinAt_nonneg (convex_Ioc 0 r) hGc
    (f' := fun s => Real.exp (κ * s - n * Real.log s) * ((κ - n * s⁻¹) * I s + I' s)) ?_ ?_
  · intro s hs
    rw [interior_Ioc] at hs
    have h1 : HasDerivAt (fun s => κ * s - n * Real.log s) (κ * 1 - n * s⁻¹) s :=
      ((hasDerivAt_id' s).const_mul κ).sub ((Real.hasDerivAt_log hs.1.ne').const_mul (n : ℝ))
    exact ((h1.exp.mul (hId s hs)).congr_deriv (by ring)).hasDerivWithinAt
  · intro s hs
    rw [interior_Ioc] at hs
    have key : (κ - n * s⁻¹) * I s + I' s = s⁻¹ * (κ * s * I s - (n * I s - s * I' s)) := by
      linear_combination (-(κ * I s + I' s)) * mul_inv_cancel₀ hs.1.ne'
    rw [key]
    exact mul_nonneg (Real.exp_pos _).le
      (mul_nonneg (inv_nonneg.mpr hs.1.le) (sub_nonneg.mpr (hineq s hs)))
/-- **Differentiation of radial cutoff integrals** (Simon Ch. 4, 3.3–3.4, where
`I(ρ) = ∫ φ(r/ρ) dμ` is differentiated in `ρ`; here the cutoff is written in the squared ratio
`|x - z|²/t²`).  If `μ(B_r(z)) < ∞` and `η` is `C¹` with `η = 0` on `[1, ∞)`, then
`I(t) = ∫ η(|x - z|²/t²) dμ` is continuous on `(0, r]` and, for `0 < s < r`,
`I'(s) = -(∫ 2 (|x - z|²/s²) η'(|x - z|²/s²) dμ)/s` (dominated convergence and differentiation
under the integral sign). -/
theorem Submission.dsmc_em_cutoff_integral_hasDerivAt : ∀ (P : ℕ) (μ : Measure (Euclid P)) (z : Euclid P) (r : ℝ) (η : ℝ → ℝ), μ (ball z r) < ∞ → ContDiff ℝ 1 η → (∀ u, 1 ≤ u → η u = 0) → ContinuousOn (fun t => ∫ x, η (‖x - z‖ ^ 2 / t ^ 2) ∂μ) (Ioc 0 r) ∧ ∀ s ∈ Ioo 0 r, HasDerivAt (fun t => ∫ x, η (‖x - z‖ ^ 2 / t ^ 2) ∂μ) (-(∫ x, 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ∂μ) / s) s := by
  intro P μ z r η hμ hη hη1
  have hηc : Continuous η := hη.continuous
  have hη'c : Continuous (deriv η) := hη.continuous_deriv le_rfl
  -- `η' = deriv η` vanishes on `(1, ∞)` (where `η` is locally zero), hence on `[1, ∞)`.
  have hη'1 : ∀ u, 1 ≤ u → deriv η u = 0 := by
    have hIoi : Ioi (1 : ℝ) ⊆ {u | deriv η u = 0} := fun u hu => by
      have hloc : η =ᶠ[𝓝 u] fun _ => (0 : ℝ) := by
        filter_upwards [Ioi_mem_nhds hu] with v hv
        exact hη1 v (le_of_lt hv)
      show deriv η u = 0
      rw [hloc.deriv_eq, deriv_const]
    have hIci : Ici (1 : ℝ) ⊆ {u | deriv η u = 0} := by
      rw [← closure_Ioi]
      exact closure_minimal hIoi (isClosed_eq hη'c continuous_const)
    exact fun u hu => hIci hu
  -- Bounds on `[0, 1]` for `η` and for `u ↦ 2 u η'(u)`.
  obtain ⟨C, hC⟩ := isCompact_Icc.exists_bound_of_continuousOn (s := Icc (0 : ℝ) 1)
    hηc.continuousOn
  obtain ⟨K, hK⟩ := isCompact_Icc.exists_bound_of_continuousOn (s := Icc (0 : ℝ) 1)
    (f := fun u : ℝ => 2 * u * deriv η u) (by fun_prop)
  have hg1 : ∀ u, 1 ≤ u → 2 * u * deriv η u = 0 := fun u hu => by
    rw [hη'1 u hu, mul_zero]
  -- For `0 < t ≤ r`, `g(|x - z|²/t²)` vanishes off `B_t(z) ⊆ B_r(z)` and is dominated there.
  have hdom : ∀ (g : ℝ → ℝ) (B : ℝ), (∀ u, 1 ≤ u → g u = 0) → (∀ u ∈ Icc (0 : ℝ) 1, ‖g u‖ ≤ B) →
      ∀ t, 0 < t → t ≤ r → ∀ x : Euclid P,
        ‖g (‖x - z‖ ^ 2 / t ^ 2)‖ ≤ (ball z r).indicator (fun _ => B) x := by
    intro g B hg0 hgB t ht htr x
    have hB : 0 ≤ B := (norm_nonneg _).trans (hgB 0 ⟨le_rfl, zero_le_one⟩)
    by_cases hx : ‖x - z‖ < t
    · have hxr : x ∈ ball z r := by
        rw [mem_ball, dist_eq_norm]
        exact hx.trans_le htr
      rw [indicator_of_mem hxr]
      apply hgB
      refine ⟨by positivity, ?_⟩
      rw [div_le_one (by positivity)]
      exact pow_le_pow_left₀ (norm_nonneg _) hx.le 2
    · rw [not_lt] at hx
      rw [hg0 _ ?_, norm_zero]
      · exact indicator_nonneg (fun _ _ => hB) x
      · rw [le_div_iff₀ (by positivity), one_mul]
        exact pow_le_pow_left₀ ht.le hx 2
  have hint : ∀ c : ℝ, Integrable ((ball z r).indicator (fun _ => c)) μ := fun c =>
    (integrable_indicator_iff measurableSet_ball).2 (integrableOn_const hμ.ne)
  have hcont : ∀ t : ℝ, Continuous fun x : Euclid P => η (‖x - z‖ ^ 2 / t ^ 2) := fun t => by
    fun_prop
  -- Pointwise derivative in `t ≠ 0`.
  have hderiv : ∀ x : Euclid P, ∀ t : ℝ, t ≠ 0 →
      HasDerivAt (fun t => η (‖x - z‖ ^ 2 / t ^ 2))
        (-(2 * (‖x - z‖ ^ 2 / t ^ 2) * deriv η (‖x - z‖ ^ 2 / t ^ 2)) / t) t := by
    intro x t ht
    have h1 := (hasDerivAt_const t (‖x - z‖ ^ 2)).div (hasDerivAt_pow 2 t) (pow_ne_zero 2 ht)
    have h2 := (hη.differentiable one_ne_zero (‖x - z‖ ^ 2 / t ^ 2)).hasDerivAt.comp t h1
    refine h2.congr_deriv ?_
    field_simp
    ring
  refine ⟨?_, fun s hs => ?_⟩
  · -- (i) continuity on `(0, r]` by dominated convergence
    refine continuousOn_of_dominated (F := fun t x => η (‖x - z‖ ^ 2 / t ^ 2))
      (bound := (ball z r).indicator (fun _ => C)) (fun t _ => (hcont t).aestronglyMeasurable)
      (fun t ht => Eventually.of_forall (hdom η C hη1 hC t ht.1 ht.2)) (hint C)
      (Eventually.of_forall fun x t ht => (hderiv x t ht.1.ne').continuousAt.continuousWithinAt)
  · -- (ii) differentiation under the integral sign on `(s/2, r)`
    have hs0 : 0 < s := hs.1
    have hb : ∀ x : Euclid P, ∀ t ∈ Ioo (s / 2) r,
        ‖-(2 * (‖x - z‖ ^ 2 / t ^ 2) * deriv η (‖x - z‖ ^ 2 / t ^ 2)) / t‖ ≤
          (ball z r).indicator (fun _ => K) x / (s / 2) := by
      intro x t ht
      have ht0 : 0 < t := by linarith [ht.1]
      have h1 : ‖2 * (‖x - z‖ ^ 2 / t ^ 2) * deriv η (‖x - z‖ ^ 2 / t ^ 2)‖ ≤
          (ball z r).indicator (fun _ => K) x :=
        hdom (fun u => 2 * u * deriv η u) K hg1 hK t ht0 ht.2.le x
      have h2 : 0 ≤ (ball z r).indicator (fun _ => K) x := (norm_nonneg _).trans h1
      rw [norm_div, norm_neg, Real.norm_of_nonneg ht0.le]
      calc ‖2 * (‖x - z‖ ^ 2 / t ^ 2) * deriv η (‖x - z‖ ^ 2 / t ^ 2)‖ / t
          ≤ (ball z r).indicator (fun _ => K) x / t := by gcongr
        _ ≤ (ball z r).indicator (fun _ => K) x / (s / 2) := by
          gcongr
          exact ht.1.le
    have key := hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := μ) (x₀ := s)
      (F := fun t x => η (‖x - z‖ ^ 2 / t ^ 2))
      (F' := fun t x => -(2 * (‖x - z‖ ^ 2 / t ^ 2) * deriv η (‖x - z‖ ^ 2 / t ^ 2)) / t)
      (bound := fun x => (ball z r).indicator (fun _ => K) x / (s / 2))
      (Ioo_mem_nhds (by linarith) hs.2)
      (Eventually.of_forall fun t => (hcont t).aestronglyMeasurable)
      ((hint C).mono' (hcont s).aestronglyMeasurable
        (Eventually.of_forall (hdom η C hη1 hC s hs0 hs.2.le)))
      (by fun_prop : Continuous fun x : Euclid P =>
        -(2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)) / s).aestronglyMeasurable
      (Eventually.of_forall hb) ((hint K).div_const (s / 2))
      (Eventually.of_forall fun x t ht => hderiv x t (by linarith [ht.1] : 0 < t).ne')
    have hval : ∫ x, -(2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2)) / s ∂μ =
        -(∫ x, 2 * (‖x - z‖ ^ 2 / s ^ 2) * deriv η (‖x - z‖ ^ 2 / s ^ 2) ∂μ) / s := by
      rw [integral_div, integral_neg]
    rw [← hval]
    exact key.2
/-- **Monotonicity of `e^{κρ} ρ⁻ⁿ μ_R(B_ρ(z))` under bounded generalized mean curvature**
(Simon Ch. 4, 3.14–3.17).  If `δV(X) = -∫ X · H dμ_R` for `C¹` fields `X` supported in `B_r(z)`,
`B̄_r(z) ⊆ U` and `|H| ≤ κ`, then `e^{κs} s⁻ⁿ μ_R(B_s(z))` is nondecreasing on `(0, r]`.  For each
radial cutoff `ηⱼ`, `I(s) = ∫ ηⱼ(|x - z|²/s²) dμ_R` satisfies `n I - s I' ≤ κ s I` on `(0, r)`, so
`e^{κs} s⁻ⁿ I(s)` is nondecreasing; letting `j → ∞` gives `I(s) → μ_R(B_s(z))`. -/
theorem Submission.dsmc_exp_ball_mass_monotone : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (H : Euclid P → Euclid P) (κ : ℝ) (z : Euclid P) (r : ℝ), closedBall z r ⊆ U → AEMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) R.measure → AEStronglyMeasurable H R.measure → (∀ x, ‖H x‖ ≤ κ) → (∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ ball z r → R.firstVariation X = -∫ x, inner ℝ (X x) (H x) ∂R.measure) → ∀ σ ρ : ℝ, 0 < σ → σ ≤ ρ → ρ ≤ r → ENNReal.ofReal (Real.exp (κ * σ) / σ ^ n) * R.measure (ball z σ) ≤ ENNReal.ofReal (Real.exp (κ * ρ) / ρ ^ n) * R.measure (ball z ρ) := by
  intro P n U R H κ z r hzU hPm _ hHκ hfv σ ρ hσ hσρ hρr
  have hρ : 0 < ρ := hσ.trans_le hσρ
  -- (a) `μ(B̄_r(z)) < ∞` (`R.locallyIntegrable_mult`), so `μ(B_t(z)) < ∞` for `t ≤ r`
  have hμB : R.measure (closedBall z r) < ∞ := by
    rw [IMRep.measure, withDensity_apply _ measurableSet_closedBall,
      Measure.restrict_restrict measurableSet_closedBall, inter_comm]
    exact lt_top_iff_ne_top.mpr (R.locallyIntegrable_mult _ (isCompact_closedBall z r) hzU)
  have hμt : ∀ t, t ≤ r → R.measure (ball z t) < ∞ := fun t ht =>
    (measure_mono (ball_subset_closedBall.trans (closedBall_subset_closedBall ht))).trans_lt hμB
  -- (b) for each cutoff `ηⱼ`, `e^{κs} s⁻ⁿ ∫ ηⱼ(|x - z|²/s²) dμ` is nondecreasing on `(0, r]`
  obtain ⟨η, hηC, hη0, hη'0, hη1, hlim⟩ := Submission.dsmc_em_cutoff_tendsto_ball
  have hj : ∀ j, Real.exp (κ * σ) / σ ^ n * ∫ x, η j (‖x - z‖ ^ 2 / σ ^ 2) ∂R.measure ≤
      Real.exp (κ * ρ) / ρ ^ n * ∫ x, η j (‖x - z‖ ^ 2 / ρ ^ 2) ∂R.measure := by
    intro j
    obtain ⟨hcont, hderiv⟩ := Submission.dsmc_em_cutoff_integral_hasDerivAt P R.measure z r (η j)
      (hμt r le_rfl) (hηC j) (hη1 j)
    refine Submission.dsmc_em_exp_monotoneOn_of_deriv_ineq n κ r _ _ hcont hderiv (fun s hs => ?_)
      ⟨hσ, hσρ.trans hρr⟩ ⟨hρ, hρr⟩ hσρ
    -- `n I(s) - s I'(s) = n I(s) + ∫ 2 u η'(u) dμ ≤ κ s I(s)`
    have h := Submission.dsmc_em_cutoff_first_variation_le P n U R H κ z r (η j) hzU hPm hHκ hfv
      (hηC j) (hη0 j) (hη'0 j) (hη1 j) s hs.1 hs.2
    rw [mul_div_cancel₀ _ hs.1.ne', sub_neg_eq_add]
    exact h
  -- (c) let `j → ∞`: the integrals tend to `μ(B_σ(z))` and `μ(B_ρ(z))`
  have hreal : Real.exp (κ * σ) / σ ^ n * R.measure.real (ball z σ) ≤
      Real.exp (κ * ρ) / ρ ^ n * R.measure.real (ball z ρ) :=
    le_of_tendsto_of_tendsto'
      ((hlim P R.measure z σ hσ (hμt σ (hσρ.trans hρr))).const_mul _)
      ((hlim P R.measure z ρ hρ (hμt ρ hρr)).const_mul _) hj
  -- (d) transfer to `[0, ∞]`
  rw [← ofReal_measureReal (hμt σ (hσρ.trans hρr)).ne, ← ofReal_measureReal (hμt ρ hρr).ne,
    ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
  exact ENNReal.ofReal_le_ofReal hreal

/-- **Simon Ch. 4, 2.2 and 4.1.1**: for `R = (M, θ, ξ)` and `X ∈ C¹_c(U; ℝᴾ)` with `x ↦ p_{TₓM}`
`μ_R`-measurable, `div_M X` is `μ_R`-integrable and `δV(X) = ∫_M θ div_M X dHⁿ = ∫ div_M X dμ_R`,
`μ_R = θ Hⁿ⌞M`.  `div_M X(x) = tr(p_{TₓM} ∘ DX(x))` is bounded by `‖tr‖ ‖DX(x)‖`, and it vanishes
off the compact `spt X ⊆ U`, which has finite `μ_R`-measure. -/
theorem Submission.dsmc_firstVariation_eq_integral : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (X : Euclid P → Euclid P), ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ U → AEMeasurable (fun x => (approxTangentPlane n R.carrier x).starProjection) R.measure → Integrable (fun x => tangentialDivergence n R.carrier X x) R.measure ∧ R.firstVariation X = ∫ x, tangentialDivergence n R.carrier X x ∂R.measure := by
  intro P n U R X hX hcpt hU hp
  -- the trace is a continuous linear functional on `L(ℝᴾ, ℝᴾ)`, and `div_M X(x) = tr(p_x ∘ DX(x))`
  let tr : (Euclid P →L[ℝ] Euclid P) →L[ℝ] ℝ := LinearMap.toContinuousLinearMap
    ((LinearMap.trace ℝ (Euclid P)).comp (ContinuousLinearMap.coeLM ℝ))
  have hdiv : ∀ x, tangentialDivergence n R.carrier X x =
      tr ((approxTangentPlane n R.carrier x).starProjection ∘L fderiv ℝ X x) := fun x => rfl
  have hθ : Measurable fun x => (R.mult x : ℝ≥0∞) := measurable_from_nat.comp R.measurable_mult
  have hD : Continuous (fderiv ℝ X) := hX.continuous_fderiv one_ne_zero
  -- `div_M X` is `μ_R`-a.e. strongly measurable
  have hmeas : AEStronglyMeasurable (fun x => tangentialDivergence n R.carrier X x) R.measure :=
    (tr.continuous.comp isBoundedBilinearMap_comp.continuous).comp_aestronglyMeasurable₂
      (g := fun p D : Euclid P →L[ℝ] Euclid P => tr (p ∘L D)) hp.aestronglyMeasurable
      hD.aestronglyMeasurable
  -- `|div_M X(x)| ≤ ‖tr‖ C 1_K(x)`, `K = spt X`, `C = sup ‖DX‖`
  obtain ⟨C, hC⟩ := hD.bounded_above_of_compact_support (hcpt.fderiv ℝ)
  have hKm : MeasurableSet (tsupport X) := (isClosed_tsupport X).measurableSet
  have hbound : ∀ x, ‖tangentialDivergence n R.carrier X x‖ ≤
      (tsupport X).indicator (fun _ => ‖tr‖ * C) x := by
    intro x
    rw [hdiv]
    by_cases hxK : x ∈ tsupport X
    · rw [Set.indicator_of_mem hxK]
      refine (tr.le_opNorm _).trans (mul_le_mul_of_nonneg_left ?_ (norm_nonneg tr))
      refine (ContinuousLinearMap.opNorm_comp_le _ _).trans ?_
      simpa using mul_le_mul (Submodule.starProjection_norm_le _) (hC x) (norm_nonneg _) zero_le_one
    · rw [Set.indicator_of_notMem hxK, fderiv_of_notMem_tsupport ℝ hxK,
        ContinuousLinearMap.comp_zero, map_zero, norm_zero]
  -- `μ_R(K) = ∫_{M ∩ K} θ dHⁿ < ∞`
  have hKfin : R.measure (tsupport X) ≠ ∞ := by
    rw [IMRep.measure, withDensity_apply _ hKm, Measure.restrict_restrict hKm,
      Set.inter_comm (tsupport X) R.carrier]
    exact R.locallyIntegrable_mult _ hcpt hU
  have hint : Integrable (fun x => tangentialDivergence n R.carrier X x) R.measure :=
    ((integrable_indicator_iff hKm).2 (integrableOn_const hKfin)).mono' hmeas (ae_of_all _ hbound)
  refine ⟨hint, ?_⟩
  -- `∫ g d(θ Hⁿ⌞M) = ∫_M θ g dHⁿ`
  rw [IMRep.measure, integral_withDensity_eq_integral_toReal_smul hθ
    (ae_of_all _ fun x => ENNReal.natCast_lt_top _), IMRep.firstVariation]
  simp only [ENNReal.toReal_natCast, smul_eq_mul]
/-- **Simon Ch. 4, 3.14–3.15**: if `V = v(M, θ)` has generalized mean curvature `H₀` in `U`,
bounded `μ_V`-a.e. on compact subsets, then for a compact `K ⊆ U` there are `Λ ≥ 0` and a
`μ_V`-measurable `H` with `|H| ≤ Λ` everywhere and `δV(X) = −∫ X · H dμ_V` for every `C¹` field `X`
with compact support in `K`.  Take a strongly measurable version `H₁` of `H₀` and set
`H = 1_{|H₁| ≤ Λ} H₁` with `Λ = max(Λ_K, 0)`: then `H = H₀` `μ_V`-a.e. on `K`, and `X = 0` off
`K`, so `X · H = X · H₀` `μ_V`-a.e. -/
theorem Submission.dimred_mono_truncated_mean_curvature : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n), R.HasLocallyBoundedMeanCurvature → ∀ K : Set (Euclid P), IsCompact K → K ⊆ U → ∃ Λ : ℝ, 0 ≤ Λ ∧ ∃ H : Euclid P → Euclid P, AEStronglyMeasurable H R.measure ∧ (∀ x, ‖H x‖ ≤ Λ) ∧ ∀ X : Euclid P → Euclid P, ContDiff ℝ 1 X → HasCompactSupport X → tsupport X ⊆ K → R.firstVariation X = -∫ x, inner ℝ (X x) (H x) ∂R.measure := by
  intro P n U R hR K hK hKU
  obtain ⟨H₀, hH₀m, hH₀b, hH₀fv⟩ := hR
  obtain ⟨Λ₀, hΛ₀⟩ := hH₀b K hK hKU
  -- `H₁` is a strongly measurable version of `H₀`; `S = {|H₁| ≤ Λ}` is measurable
  obtain ⟨H₁, hH₁, hH₀₁⟩ : ∃ H₁ : Euclid P → Euclid P, StronglyMeasurable H₁ ∧
      H₀ =ᵐ[R.measure] H₁ :=
    ⟨hH₀m.mk H₀, hH₀m.stronglyMeasurable_mk, hH₀m.ae_eq_mk⟩
  set S : Set (Euclid P) := {x | ‖H₁ x‖ ≤ max Λ₀ 0}
  have hS : MeasurableSet S := measurableSet_le hH₁.norm.measurable measurable_const
  refine ⟨max Λ₀ 0, le_max_right _ _, S.indicator H₁, (hH₁.indicator hS).aestronglyMeasurable,
    fun x => ?_, fun X hX hXc hXK => ?_⟩
  · by_cases hx : x ∈ S
    · rw [Set.indicator_of_mem hx]
      exact hx
    · rw [Set.indicator_of_notMem hx, norm_zero]
      exact le_max_right _ _
  -- `X · H₀ = X · H` `μ_V`-a.e.: on `K`, `H = H₁ = H₀` a.e.; off `K`, `X = 0`
  rw [hH₀fv X hX hXc (hXK.trans hKU)]
  congr 1
  refine integral_congr_ae ?_
  filter_upwards [hH₀₁, hΛ₀] with x hx₁ hx₂
  by_cases hxK : x ∈ K
  · have hxS : x ∈ S := by
      change ‖H₁ x‖ ≤ max Λ₀ 0
      rw [← hx₁]
      exact (hx₂ hxK).trans (le_max_left _ _)
    rw [Set.indicator_of_mem hxS, hx₁]
  · rw [image_eq_zero_of_notMem_tsupport fun h => hxK (hXK h), inner_zero_left, inner_zero_left]
/-- **Lebesgue measure of the squares `(−r, r)²` and `[−r, r]²` in `ℝ²`** (for the box masses at
the edge of a planar sector, in the proof of Simon 7.3.3).  `WithLp.ofLp : ℝ² → (Fin 2 → ℝ)`
preserves volume, the open square is the preimage of the box `∏ᵢ (−r, r)` and the closed square
that of `∏ᵢ [−r, r]`, and both boxes have volume `(2r)·(2r) = 4r²` for `r ≥ 0`. -/
theorem Submission.idtp_cse_bml_sqm_coord_square_volume : ∀ r : ℝ, 0 ≤ r → volume {v : Euclid 2 | |v 0| < r ∧ |v 1| < r} = ENNReal.ofReal (4 * r ^ 2) ∧ volume {v : Euclid 2 | |v 0| ≤ r ∧ |v 1| ≤ r} = ENNReal.ofReal (4 * r ^ 2) := by
  intro r hr
  -- `WithLp.ofLp : ℝ² → (Fin 2 → ℝ)` is measure preserving
  have hmp := PiLp.volume_preserving_ofLp (Fin 2)
  -- both boxes have volume `ofReal (2r) · ofReal (2r) = ofReal (4r²)`, using `r ≥ 0`
  have h4 : (∏ _i : Fin 2, ENNReal.ofReal (r - -r)) = ENNReal.ofReal (4 * r ^ 2) := by
    rw [Fin.prod_univ_two, ← ENNReal.ofReal_mul (by linarith)]
    congr 1
    ring
  constructor
  · -- the open square is the preimage of `∏ᵢ (−r, r)` (`|t| < r ↔ −r < t < r`)
    have hset : {v : Euclid 2 | |v 0| < r ∧ |v 1| < r} =
        WithLp.ofLp ⁻¹' (Set.pi univ fun _ : Fin 2 => Ioo (-r) r) := by
      ext v
      simp [abs_lt, Fin.forall_fin_two]
    rw [hset, hmp.measure_preimage
      (MeasurableSet.univ_pi fun _ => measurableSet_Ioo).nullMeasurableSet,
      Real.volume_pi_Ioo, h4]
  · -- the closed square is the preimage of `∏ᵢ [−r, r]` (`|t| ≤ r ↔ −r ≤ t ≤ r`)
    have hset : {v : Euclid 2 | |v 0| ≤ r ∧ |v 1| ≤ r} =
        WithLp.ofLp ⁻¹' (Set.Icc (fun _ : Fin 2 => -r) (fun _ => r)) := by
      ext v
      simp only [Set.mem_ofPred_eq, Set.mem_preimage, Set.mem_Icc, Pi.le_def, Fin.forall_fin_two,
        abs_le]
      tauto
    rw [hset, hmp.measure_preimage measurableSet_Icc.nullMeasurableSet, Real.volume_Icc_pi, h4]

/-- **`H²` of the squares in a `2`-plane, and local finiteness of `H²⌞Q`** (for the box masses at
the edge of a planar sector, in the proof of Simon 7.3.3).  `H²⌞Q` is regular
(`regular_euclideanHausdorffMeasure_restrict_submodule`), hence finite on compacts.  The orthonormal
pair `(a, e)` spans `Q` (`dim Q = 2`), so `H²⌞Q = ι_#(L²)` for `ι(s) = s₀a + s₁e`; since
`⟨ι s, a⟩ = s₀`, `⟨ι s, e⟩ = s₁` and `|ι s|² = s₀² + s₁² ≤ 2r² ≤ 8 < 9`, the preimages of the two
sets are the squares `(−r, r)²` and `[−r, r]²`, both of area `4r²`. -/
theorem Submission.idtp_cse_bml_plane_square_measure : ∀ (P : ℕ) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P), Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → IsFiniteMeasureOnCompacts (μHE[2].restrict (Q : Set (Euclid P))) ∧ ∀ r : ℝ, 0 ≤ r → r ≤ 2 → μHE[2].restrict (Q : Set (Euclid P)) {w : Euclid P | ‖w‖ < 3 ∧ |inner ℝ w a| < r ∧ |inner ℝ w e| < r} = ENNReal.ofReal (4 * r ^ 2) ∧ μHE[2].restrict (Q : Set (Euclid P)) {w : Euclid P | ‖w‖ ≤ 3 ∧ |inner ℝ w a| ≤ r ∧ |inner ℝ w e| ≤ r} = ENNReal.ofReal (4 * r ^ 2) := by
  intro P Q a e hQ haQ heQ ha he hae
  refine ⟨(Poincare.SimonGMT.Chapter03.regular_euclideanHausdorffMeasure_restrict_submodule
    hQ).toIsFiniteMeasureOnCompacts, ?_⟩
  intro r hr0 hr2
  -- `τ = (a, e)` is an orthonormal frame
  let τ : Fin 2 → Euclid P := ![a, e]
  have hτ : Orthonormal ℝ τ := by
    rw [orthonormal_iff_ite]
    intro i j
    fin_cases i <;> fin_cases j <;>
      simp [τ, ha, he, hae, real_inner_comm a e]
  -- its span is `Q`
  have hspan : Submodule.span ℝ (Set.range τ) = Q := by
    apply Submodule.eq_of_le_of_finrank_eq
    · rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      fin_cases i
      · exact haQ
      · exact heQ
    · rw [finrank_span_eq_card hτ.linearIndependent, hQ]
      simp
  have hmap := Submission.idtp_pc_plane_hausdorff_eq_map P 2 τ hτ
  rw [hspan] at hmap
  -- `ι(s) = s₀a + s₁e`, with `⟨ι s, a⟩ = s₀`, `⟨ι s, e⟩ = s₁` and `|ι s|² = s₀² + s₁²`
  set ι : Euclid 2 → Euclid P := fun s => ∑ i, s i • τ i
  have hιc : Continuous ι := by fun_prop
  have hf : ∀ s : Euclid 2, ι s = s 0 • a + s 1 • e := by
    intro s
    simp [ι, τ, Fin.sum_univ_two]
  have hia : ∀ s : Euclid 2, inner ℝ (ι s) a = s 0 := by
    intro s
    rw [hf, inner_add_left, real_inner_smul_left, real_inner_smul_left, real_inner_self_eq_norm_sq,
      ha, real_inner_comm a e, hae]
    ring
  have hie : ∀ s : Euclid 2, inner ℝ (ι s) e = s 1 := by
    intro s
    rw [hf, inner_add_left, real_inner_smul_left, real_inner_smul_left, real_inner_self_eq_norm_sq,
      he, hae]
    ring
  have hn : ∀ s : Euclid 2, ‖ι s‖ ^ 2 = s 0 ^ 2 + s 1 ^ 2 := by
    intro s
    rw [← real_inner_self_eq_norm_sq]
    calc inner ℝ (ι s) (ι s) = inner ℝ (ι s) (s 0 • a + s 1 • e) := by rw [← hf]
      _ = s 0 * inner ℝ (ι s) a + s 1 * inner ℝ (ι s) e := by
          rw [inner_add_right, real_inner_smul_right, real_inner_smul_right]
      _ = s 0 ^ 2 + s 1 ^ 2 := by rw [hia, hie]; ring
  -- both sets are Borel
  have hSo : MeasurableSet {w : Euclid P | ‖w‖ < 3 ∧ |inner ℝ w a| < r ∧ |inner ℝ w e| < r} :=
    IsOpen.measurableSet <| (isOpen_lt continuous_norm continuous_const).inter
      ((isOpen_lt (f := fun w : Euclid P => |inner ℝ w a|) (by fun_prop) continuous_const).inter
        (isOpen_lt (f := fun w : Euclid P => |inner ℝ w e|) (by fun_prop) continuous_const))
  have hSc : MeasurableSet {w : Euclid P | ‖w‖ ≤ 3 ∧ |inner ℝ w a| ≤ r ∧ |inner ℝ w e| ≤ r} :=
    IsClosed.measurableSet <| (isClosed_le continuous_norm continuous_const).inter
      ((isClosed_le (f := fun w : Euclid P => |inner ℝ w a|) (by fun_prop) continuous_const).inter
        (isClosed_le (f := fun w : Euclid P => |inner ℝ w e|) (by fun_prop) continuous_const))
  have hsq := Submission.idtp_cse_bml_sqm_coord_square_volume r hr0
  constructor
  · -- `ι⁻¹(S) = (−r, r)²`: the ball constraint is redundant, `|ι s|² < 2r² ≤ 8 < 9`
    rw [hmap, Measure.map_apply hιc.measurable hSo]
    convert hsq.1 using 2
    ext s
    simp only [Set.mem_preimage, Set.mem_ofPred_eq, hia, hie]
    constructor
    · rintro ⟨-, h0, h1⟩
      exact ⟨h0, h1⟩
    · rintro ⟨h0, h1⟩
      refine ⟨?_, h0, h1⟩
      have h2 := hn s
      nlinarith [sq_abs (s 0), sq_abs (s 1), abs_nonneg (s 0), abs_nonneg (s 1), norm_nonneg (ι s)]
  · -- `ι⁻¹(K) = [−r, r]²`: `|ι s|² ≤ 2r² ≤ 8 < 9`
    rw [hmap, Measure.map_apply hιc.measurable hSc]
    convert hsq.2 using 2
    ext s
    simp only [Set.mem_preimage, Set.mem_ofPred_eq, hia, hie]
    constructor
    · rintro ⟨-, h0, h1⟩
      exact ⟨h0, h1⟩
    · rintro ⟨h0, h1⟩
      refine ⟨?_, h0, h1⟩
      have h2 := hn s
      nlinarith [sq_abs (s 0), sq_abs (s 1), abs_nonneg (s 0), abs_nonneg (s 1), norm_nonneg (ι s)]
/-- **Portmanteau inequalities for vague convergence on an open set** (Evans–Gariepy §1.9).
Simon does not state this separately: it is the converse of the "standard approximation
argument" ending the proof of 7.2.4, and its compact-set half is the `ε`-neighbourhood argument
giving (13) there (chapter-07.txt lines 264–288).  Let `U` be open and `νⱼ`, `μ` finite on compact
subsets of `U`.  If `∫ f dνⱼ → ∫ f dμ` for every continuous `f` with compact support in `U`, then
`limsup νⱼ(K) ≤ μ(K)` for compact `K ⊆ U` and `μ(G) ≤ liminf νⱼ(G)` for open `G ⊆ U`.  Urysohn
cut-offs `1_K ≤ h ≤ 1_{thickening r K}` give `limsup νⱼ(K) ≤ μ(cthickening r K) → μ(K)` as
`r ↓ 0`; cut-offs `1_C ≤ h` with `tsupport h ⊆ G` give `μ(C) ≤ liminf νⱼ(G)` for compact
`C ⊆ G`, and `G` is exhausted by increasing compact sets. -/
theorem Submission.cbr_vague_portmanteau : ∀ (P : ℕ) (U : Set (Euclid P)) (νs : ℕ → Measure (Euclid P)) (μ : Measure (Euclid P)), IsOpen U → (∀ (j : ℕ) (K : Set (Euclid P)), IsCompact K → K ⊆ U → νs j K < ∞) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → μ K < ∞) → (∀ f : Euclid P → ℝ, Continuous f → HasCompactSupport f → tsupport f ⊆ U → Tendsto (fun j => ∫ x, f x ∂(νs j)) atTop (𝓝 (∫ x, f x ∂μ))) → (∀ K : Set (Euclid P), IsCompact K → K ⊆ U → limsup (fun j => νs j K) atTop ≤ μ K) ∧ (∀ G : Set (Euclid P), IsOpen G → G ⊆ U → μ G ≤ liminf (fun j => νs j G) atTop) := by
  intro P U νs μ hU hνs hμ hconv
  -- Step 1: cut-off functions.  For compact `C` and `r > 0`, Urysohn's lemma gives a continuous
  -- `h` with compact support, `0 ≤ h ≤ 1`, `h = 1` on `C` and `h = 0` off `thickening r C`;
  -- hence `tsupport h ⊆ cthickening r C`
  have hcut : ∀ (C : Set (Euclid P)) (r : ℝ), IsCompact C → 0 < r →
      ∃ h : Euclid P → ℝ, Continuous h ∧ HasCompactSupport h ∧ (∀ x, 0 ≤ h x) ∧
        (∀ x ∈ C, h x = 1) ∧ (∀ x, h x ≤ 1) ∧ (∀ x, x ∉ thickening r C → h x = 0) ∧
        tsupport h ⊆ cthickening r C := by
    intro C r hC hr
    obtain ⟨h, h1, h0, hcs, h01⟩ := exists_continuous_one_zero_of_isCompact hC
      isOpen_thickening.isClosed_compl
      (disjoint_compl_right_iff_subset.mpr (self_subset_thickening hr C))
    refine ⟨h, h.continuous, hcs, fun x => (h01 x).1, fun x hx => h1 hx, fun x => (h01 x).2,
      fun x hx => h0 hx, (closure_mono fun x hx => ?_).trans
        (closure_thickening_subset_cthickening r C)⟩
    by_contra hxr
    exact hx (h0 hxr)
  -- Step 0: such an `h` is `ρ`-integrable whenever `ρ(tsupport h) < ∞`; then
  -- `ρ(B) ≤ ofReal (∫ h dρ)` if `h = 1` on `B` (`Integrable.measure_le_integral`), and in any
  -- case `ofReal (∫ h dρ) ≤ ρ(V)` if `h ≤ 1` and `h = 0` off `V` (`integral_le_measure`)
  have hint : ∀ (ρ : Measure (Euclid P)) (h : Euclid P → ℝ), Continuous h → HasCompactSupport h →
      ρ (tsupport h) < ∞ → Integrable h ρ := fun ρ h hc hcs hρ =>
    (integrableOn_iff_integrable_of_support_subset (subset_tsupport h)).mp
      (hc.continuousOn.integrableOn_of_subset_isCompact hcs (isClosed_tsupport h).measurableSet
        subset_rfl hρ.ne)
  -- Step 2: compact sets.  Choose `δ > 0` with `cthickening δ K ⊆ U`; for `0 < r ≤ δ`,
  -- `limsup νⱼ(K) ≤ lim ofReal (∫ h dνⱼ) = ofReal (∫ h dμ) ≤ μ(cthickening r K)`, and
  -- `μ(cthickening r K) → μ(K)` as `r → 0` because `μ(cthickening δ K) < ∞`
  have hK : ∀ K : Set (Euclid P), IsCompact K → K ⊆ U →
      limsup (fun j => νs j K) atTop ≤ μ K := by
    intro K hKc hKU
    obtain ⟨δ, hδ, hδU⟩ := hKc.exists_cthickening_subset_open hU hKU
    have hr : ∀ r, 0 < r → r ≤ δ → limsup (fun j => νs j K) atTop ≤ μ (cthickening r K) := by
      intro r hr hrδ
      obtain ⟨h, hc, hcs, h0, h1, hle1, hout, hts⟩ := hcut K r hKc hr
      have htsU : tsupport h ⊆ U := hts.trans ((cthickening_mono hrδ K).trans hδU)
      calc limsup (fun j => νs j K) atTop
          ≤ limsup (fun j => ENNReal.ofReal (∫ x, h x ∂(νs j))) atTop :=
            limsup_le_limsup (Eventually.of_forall fun j =>
              (hint (νs j) h hc hcs (hνs j _ hcs htsU)).measure_le_integral
                (Eventually.of_forall h0) fun x hx => (h1 x hx).ge)
        _ = ENNReal.ofReal (∫ x, h x ∂μ) :=
            ((ENNReal.continuous_ofReal.tendsto _).comp (hconv h hc hcs htsU)).limsup_eq
        _ ≤ μ (cthickening r K) := integral_le_measure (fun x _ => hle1 x)
            fun x hx => (hout x fun hx' => hx (thickening_subset_cthickening r K hx')).le
    have hlim := tendsto_measure_cthickening_of_isClosed
      ⟨δ, hδ, (hμ _ hKc.cthickening hδU).ne⟩ hKc.isClosed
    refine ge_of_tendsto (hlim.mono_left (nhdsWithin_le_nhds : 𝓝[>] (0 : ℝ) ≤ 𝓝 0)) ?_
    filter_upwards [Ioc_mem_nhdsGT hδ] with r hr' using hr r hr'.1 hr'.2
  -- Step 3: compact subsets `C` of open `G ⊆ U`.  With `h = 1` on `C` and `tsupport h ⊆ G`,
  -- `μ(C) ≤ ofReal (∫ h dμ) = lim ofReal (∫ h dνⱼ) ≤ liminf νⱼ(G)`
  have hCG : ∀ G : Set (Euclid P), IsOpen G → G ⊆ U → ∀ C : Set (Euclid P), IsCompact C →
      C ⊆ G → μ C ≤ liminf (fun j => νs j G) atTop := by
    intro G hG hGU C hCc hCG
    obtain ⟨δ, hδ, hδG⟩ := hCc.exists_cthickening_subset_open hG hCG
    obtain ⟨h, hc, hcs, h0, h1, hle1, -, hts⟩ := hcut C δ hCc hδ
    have htsG : tsupport h ⊆ G := hts.trans hδG
    calc μ C ≤ ENNReal.ofReal (∫ x, h x ∂μ) :=
          (hint μ h hc hcs (hμ _ hcs (htsG.trans hGU))).measure_le_integral
            (Eventually.of_forall h0) fun x hx => (h1 x hx).ge
      _ = liminf (fun j => ENNReal.ofReal (∫ x, h x ∂(νs j))) atTop :=
          (((ENNReal.continuous_ofReal.tendsto _).comp
            (hconv h hc hcs (htsG.trans hGU))).liminf_eq).symm
      _ ≤ liminf (fun j => νs j G) atTop :=
          liminf_le_liminf (Eventually.of_forall fun j => integral_le_measure (fun x _ => hle1 x)
            fun x hx => (image_eq_zero_of_notMem_tsupport fun hx' => hx (htsG hx')).le)
  -- Step 4: open sets.  `G = ⋃ₙ Fₙ` with `Fₙ` closed and increasing, so `G` is exhausted by the
  -- increasing compact sets `Fₙ ∩ closedBall 0 n ⊆ G`; continuity from below and Step 3
  refine ⟨hK, fun G hG hGU => ?_⟩
  obtain ⟨F, hFc, hFG, hFU, hFm⟩ := hG.exists_iUnion_isClosed
  have hCm : Monotone fun n : ℕ => F n ∩ closedBall (0 : Euclid P) n := fun m n hmn =>
    inter_subset_inter (hFm hmn) (closedBall_subset_closedBall (Nat.cast_le.mpr hmn))
  calc μ G ≤ μ (⋃ n : ℕ, F n ∩ closedBall (0 : Euclid P) n) := measure_mono fun x hx => by
        rw [← hFU] at hx
        obtain ⟨m, hm⟩ := mem_iUnion.mp hx
        obtain ⟨k, hk⟩ := exists_nat_ge ‖x‖
        exact mem_iUnion.mpr ⟨max m k, hFm (le_max_left m k) hm,
          mem_closedBall_zero_iff.mpr (hk.trans (Nat.cast_le.mpr (le_max_right m k)))⟩
    _ = ⨆ n : ℕ, μ (F n ∩ closedBall (0 : Euclid P) n) := hCm.measure_iUnion
    _ ≤ liminf (fun j => νs j G) atTop := iSup_le fun n =>
        hCG G hG hGU _ ((isCompact_closedBall 0 n).inter_left (hFc n))
          (inter_subset_left.trans (hFG n))
/-- **Rescaled push-forward under a dilation** (Simon 7.3, the scaling `μ_{η_{a,λ#}T}` of blow-ups).
For `λ > 0`, `η = η_{a,λ}` is the homeomorphism `y ↦ −λ⁻¹a + λ⁻¹y`.  Hence `ν = η_#(λ⁻²μ)` is
finite on compact sets when `μ` is (preimages of compact sets are compact), `ν(S) = λ⁻²μ(η⁻¹S)`
for measurable `S`, and `∫ g dν = λ⁻² ∫ g ∘ η dμ` for continuous `g` (change of variables). -/
theorem Submission.idtp_cse_bml_rpm_dilation_map : ∀ (P : ℕ) (μ : Measure (Euclid P)) (a : Euclid P) (lam : ℝ), IsFiniteMeasureOnCompacts μ → 0 < lam → (∀ K : Set (Euclid P), IsCompact K → Measure.map (dilation a lam) (ENNReal.ofReal (lam⁻¹ ^ 2) • μ) K < ∞) ∧ (∀ S : Set (Euclid P), MeasurableSet S → Measure.map (dilation a lam) (ENNReal.ofReal (lam⁻¹ ^ 2) • μ) S = ENNReal.ofReal (lam⁻¹ ^ 2) * μ (dilation a lam ⁻¹' S)) ∧ ∀ g : Euclid P → ℝ, Continuous g → ∫ x, g x ∂(Measure.map (dilation a lam) (ENNReal.ofReal (lam⁻¹ ^ 2) • μ)) = lam⁻¹ ^ 2 * ∫ x, g (dilation a lam x) ∂μ := by
  intro P μ a lam hμ hlam
  -- Step 1: `η_{a,λ}` is the homeomorphism `y ↦ −λ⁻¹a + λ⁻¹y`, so it is measurable and
  -- preimages of compact sets are compact
  let e : Euclid P ≃ₜ Euclid P := (Homeomorph.smulOfNeZero lam⁻¹ (inv_ne_zero hlam.ne')).trans
    (Homeomorph.addLeft (-(lam⁻¹ • a)))
  have he : ⇑e = dilation a lam := by
    funext y
    simp [e, dilation, dilationCLM]
  have hη : Measurable (dilation a lam) := he ▸ e.continuous.measurable
  -- Step 2: `ν(S) = (λ⁻²μ)(η⁻¹S) = λ⁻²μ(η⁻¹S)` for measurable `S`
  have hset : ∀ S : Set (Euclid P), MeasurableSet S →
      Measure.map (dilation a lam) (ENNReal.ofReal (lam⁻¹ ^ 2) • μ) S =
        ENNReal.ofReal (lam⁻¹ ^ 2) * μ (dilation a lam ⁻¹' S) := fun S hS => by
    rw [Measure.map_apply hη hS, Measure.smul_apply, smul_eq_mul]
  refine ⟨fun K hK => ?_, hset, fun g hg => ?_⟩
  · -- Step 3: a compact `K` is closed, hence measurable, and `μ(η⁻¹K) < ∞` as `η⁻¹K` is compact
    have hK' : IsCompact (dilation a lam ⁻¹' K) := by
      rw [← he]
      exact e.isCompact_preimage.mpr hK
    rw [hset K hK.isClosed.measurableSet]
    exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top hK'.measure_lt_top
  · -- Step 4: change of variables, then `∫ f d(cμ) = c.toReal ∫ f dμ` with `c.toReal = λ⁻²`
    rw [integral_map hη.aemeasurable hg.aestronglyMeasurable, integral_smul_measure,
      ENNReal.toReal_ofReal (sq_nonneg _), smul_eq_mul]

/-- **Portmanteau bounds for the rescaled measures `λⱼ⁻²(η_{a,λⱼ})_#μ`** (Simon 7.3, the blow-up
measures `μ_{η_{a,λⱼ#}T}`; the compact-set half is (13) in the proof of 7.2.4).  Let `μ`, `ν` be
finite on compact sets, `λⱼ > 0` and `ηⱼ = η_{a,λⱼ}`.  If `λⱼ⁻² ∫ g ∘ ηⱼ dμ → ∫ g dν` for every
continuous `g` with compact support, then `limsup λⱼ⁻²μ(ηⱼ⁻¹K) ≤ ν(K)` for compact `K` and
`ν(U) ≤ liminf λⱼ⁻²μ(ηⱼ⁻¹U)` for open `U`: the measures `νⱼ = ηⱼ#(λⱼ⁻²μ)` are finite on compact
sets with `∫ g dνⱼ = λⱼ⁻² ∫ g ∘ ηⱼ dμ`, so vague portmanteau on `ℝᴾ` applies to `νⱼ → ν`, and
`νⱼ(S) = λⱼ⁻²μ(ηⱼ⁻¹S)` for the (Borel) sets `S = K, U`. -/
theorem Submission.idtp_cse_bml_rescaled_portmanteau : ∀ (P : ℕ) (μ ν : Measure (Euclid P)) (a : Euclid P) (lams : ℕ → ℝ), IsFiniteMeasureOnCompacts μ → IsFiniteMeasureOnCompacts ν → (∀ j, 0 < lams j) → (∀ g : Euclid P → ℝ, Continuous g → HasCompactSupport g → Tendsto (fun j => (lams j)⁻¹ ^ 2 * ∫ x, g (dilation a (lams j) x) ∂μ) atTop (𝓝 (∫ x, g x ∂ν))) → (∀ K : Set (Euclid P), IsCompact K → limsup (fun j => ENNReal.ofReal ((lams j)⁻¹ ^ 2) * μ (dilation a (lams j) ⁻¹' K)) atTop ≤ ν K) ∧ ∀ U : Set (Euclid P), IsOpen U → ν U ≤ liminf (fun j => ENNReal.ofReal ((lams j)⁻¹ ^ 2) * μ (dilation a (lams j) ⁻¹' U)) atTop := by
  intro P μ ν a lams hμ hν hlams hconv
  -- Step 1: `νⱼ = ηⱼ#(λⱼ⁻²μ)` is finite on compact sets, `νⱼ(S) = λⱼ⁻²μ(ηⱼ⁻¹S)` for measurable
  -- `S` and `∫ g dνⱼ = λⱼ⁻² ∫ g ∘ ηⱼ dμ` for continuous `g`
  have hmap := fun j => Submission.idtp_cse_bml_rpm_dilation_map P μ a (lams j) hμ (hlams j)
  have hset : ∀ (j : ℕ) (S : Set (Euclid P)), MeasurableSet S →
      Measure.map (dilation a (lams j)) (ENNReal.ofReal ((lams j)⁻¹ ^ 2) • μ) S =
        ENNReal.ofReal ((lams j)⁻¹ ^ 2) * μ (dilation a (lams j) ⁻¹' S) :=
    fun j => (hmap j).2.1
  -- Step 2: vague portmanteau on `U = ℝᴾ` for `νⱼ → ν`
  obtain ⟨hK, hU⟩ := Submission.cbr_vague_portmanteau P univ
    (fun j => Measure.map (dilation a (lams j)) (ENNReal.ofReal ((lams j)⁻¹ ^ 2) • μ)) ν
    isOpen_univ (fun j K hK _ => (hmap j).1 K hK) (fun K hK _ => hK.measure_lt_top)
    fun g hg hgs _ => (hconv g hg hgs).congr fun j => ((hmap j).2.2 g hg).symm
  -- Step 3: compact and open sets are measurable, so `νⱼ(S) = λⱼ⁻²μ(ηⱼ⁻¹S)` for them
  refine ⟨fun K hKc => ?_, fun U hUo => ?_⟩
  · have hS : ∀ j, Measure.map (dilation a (lams j)) (ENNReal.ofReal ((lams j)⁻¹ ^ 2) • μ) K =
        ENNReal.ofReal ((lams j)⁻¹ ^ 2) * μ (dilation a (lams j) ⁻¹' K) := fun j =>
      hset j K hKc.measurableSet
    simpa only [hS] using hK K hKc (subset_univ K)
  · have hS : ∀ j, Measure.map (dilation a (lams j)) (ENNReal.ofReal ((lams j)⁻¹ ^ 2) • μ) U =
        ENNReal.ofReal ((lams j)⁻¹ ^ 2) * μ (dilation a (lams j) ⁻¹' U) := fun j =>
      hset j U hUo.measurableSet
    simpa only [hS] using hU U hUo (subset_univ U)

/-- **Box mass limit** at the edge point of a planar sector of a 2-dimensional minimizing cone
(the rigidity behind the classification of 2-dimensional minimizing cones used in Simon 7.3.3(1),
case `n − d = 2`, chapter-07.txt lines 497–510; the book cites [Whi82] and gives no proof).
Let `μ` be finite on compact sets, `Q` a `2`-plane with orthonormal `a, e ∈ Q`, and
`Z(s, s') = {⟨x, a⟩ > 0, ||x| − 1| < s', |arctan(⟨x, e⟩/⟨x, a⟩)| < s', |x − πx| < s|x|}`.
Suppose (L) `μ(Z(s, s') \ B_{3s'}(a)) = 0` for `0 < s' ≤ s`, and (V) every null sequence
`λⱼ > 0` has a subsequence along which `λ⁻² ∫ g ∘ dilation a λ dμ → m ∫_Q g dH²` for continuous
compactly supported `g`.  Then `μ(Z(s, s')) / s'² → 4m` as `s' ↓ 0`.
By the subsequence criterion it suffices to treat a subsequence `tⱼ` given by (V).  For
`0 < η < 1/2` the open square `U_η` (`‖w‖ < 3`, `|⟨w, a⟩|, |⟨w, e⟩| < 1 − η`) and the compact
square `K_η` (`≤ 3`, `≤ 1 + η`) satisfy `(dilation a tⱼ)⁻¹ U_η ⊆ Z(s, tⱼ)` and
`Z(s, tⱼ) ∩ B_{3tⱼ}(a) ⊆ (dilation a tⱼ)⁻¹ K_η` for large `j`; with (L) and the portmanteau
inequalities for `ν = m H²⌞Q` this gives `4m(1 − η)² ≤ liminf ≤ limsup ≤ 4m(1 + η)²`.
Let `η ↓ 0`. -/
theorem Submission.idtp_cse_bml_box_mass_limit : ∀ (P : ℕ) (μ : Measure (Euclid P)) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (m : ℕ) (s : ℝ), IsFiniteMeasureOnCompacts μ → Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → 0 < s → (∀ s' : ℝ, 0 < s' → s' ≤ s → μ ({x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s' ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} \ ball a (3 * s')) = 0) → (∀ lams : ℕ → ℝ, (∀ j, 0 < lams j) → Tendsto lams atTop (𝓝 0) → ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ g : Euclid P → ℝ, Continuous g → HasCompactSupport g → Tendsto (fun j => (lams (φ j))⁻¹ ^ 2 * ∫ x, g (dilation a (lams (φ j)) x) ∂μ) atTop (𝓝 ((m : ℝ) * ∫ x in (Q : Set (Euclid P)), g x ∂μHE[2]))) → Tendsto (fun s' : ℝ => μ {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s' ∧ |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' ∧ ‖x - Q.starProjection x‖ < s * ‖x‖} / ENNReal.ofReal (s' ^ 2)) (𝓝[>] 0) (𝓝 (4 * (m : ℝ≥0∞))) := by
  intro P μ Q a e m s hμ hQ haQ heQ ha he hae hs hL hV
  set Z : ℝ → Set (Euclid P) := fun s' => {x : Euclid P | 0 < inner ℝ x a ∧ |‖x‖ - 1| < s' ∧
    |Real.arctan (inner ℝ x e / inner ℝ x a)| < s' ∧ ‖x - Q.starProjection x‖ < s * ‖x‖}
  -- Steps 2–8, along a null sequence `tⱼ > 0` for which (V) holds
  have key : ∀ t : ℕ → ℝ, (∀ j, 0 < t j) → Tendsto t atTop (𝓝 0) →
      (∀ g : Euclid P → ℝ, Continuous g → HasCompactSupport g →
        Tendsto (fun j => (t j)⁻¹ ^ 2 * ∫ x, g (dilation a (t j) x) ∂μ) atTop
          (𝓝 ((m : ℝ) * ∫ x in (Q : Set (Euclid P)), g x ∂μHE[2]))) →
      Tendsto (fun j => μ (Z (t j)) / ENNReal.ofReal (t j ^ 2)) atTop (𝓝 (4 * (m : ℝ≥0∞))) := by
    intro t ht0 ht hVt
    -- Step 3: `ν = m H²⌞Q` is finite on compact sets, and `∫ g dν = m ∫_Q g dH²`
    obtain ⟨hQfin, hsq⟩ :=
      Submission.idtp_cse_bml_plane_square_measure P Q a e hQ haQ heQ ha he hae
    set ν : Measure (Euclid P) := (m : ℝ≥0∞) • μHE[2].restrict (Q : Set (Euclid P)) with hν
    have hνfin : IsFiniteMeasureOnCompacts ν := ⟨fun K hK => by
      rw [hν, Measure.smul_apply, smul_eq_mul]
      exact ENNReal.mul_lt_top (ENNReal.natCast_lt_top m) (hQfin.lt_top_of_isCompact hK)⟩
    have hconv : ∀ g : Euclid P → ℝ, Continuous g → HasCompactSupport g →
        Tendsto (fun j => (t j)⁻¹ ^ 2 * ∫ x, g (dilation a (t j) x) ∂μ) atTop
          (𝓝 (∫ x, g x ∂ν)) := by
      intro g hg hgc
      rw [hν, integral_smul_measure, ENNReal.toReal_natCast, smul_eq_mul]
      exact hVt g hg hgc
    -- Step 4: limsup on compact sets and liminf on open sets of the rescaled masses
    -- `ofReal (tⱼ⁻²) μ((dilation a tⱼ)⁻¹ ·)`
    obtain ⟨hC, hO⟩ :=
      Submission.idtp_cse_bml_rescaled_portmanteau P μ ν a t hμ hνfin ht0 hconv
    -- Step 5: `c / ofReal (tⱼ²) = ofReal (tⱼ⁻²) c`
    have hdiv : ∀ j (c : ℝ≥0∞),
        c / ENNReal.ofReal (t j ^ 2) = ENNReal.ofReal ((t j)⁻¹ ^ 2) * c := by
      intro j c
      rw [ENNReal.div_eq_inv_mul, inv_pow, ENNReal.ofReal_inv_of_pos (pow_pos (ht0 j) 2)]
    -- Steps 6–7: for `0 < η < 1/2`, `4m(1 − η)² ≤ liminf` and `limsup ≤ 4m(1 + η)²`
    have hη : ∀ η : ℝ, 0 < η → η < 1 / 2 →
        (m : ℝ≥0∞) * ENNReal.ofReal (4 * (1 - η) ^ 2) ≤
            liminf (fun j => μ (Z (t j)) / ENNReal.ofReal (t j ^ 2)) atTop ∧
          limsup (fun j => μ (Z (t j)) / ENNReal.ofReal (t j ^ 2)) atTop ≤
            (m : ℝ≥0∞) * ENNReal.ofReal (4 * (1 + η) ^ 2) := by
      intro η hη0 hη1
      -- the open square `U_η` and the compact square `K_η`, and their `ν`-measures
      have hUo : IsOpen {w : Euclid P | ‖w‖ < 3 ∧ |inner ℝ w a| < 1 - η ∧ |inner ℝ w e| < 1 - η} :=
        (isOpen_lt (by fun_prop) (by fun_prop)).and
          ((isOpen_lt (by fun_prop) (by fun_prop)).and (isOpen_lt (by fun_prop) (by fun_prop)))
      have hKc : IsCompact
          {w : Euclid P | ‖w‖ ≤ 3 ∧ |inner ℝ w a| ≤ 1 + η ∧ |inner ℝ w e| ≤ 1 + η} := by
        refine (isCompact_closedBall (0 : Euclid P) 3).of_isClosed_subset ?_
          fun w hw => mem_closedBall_zero_iff.mpr hw.1
        exact (isClosed_le (by fun_prop) (by fun_prop)).and
          ((isClosed_le (by fun_prop) (by fun_prop)).and (isClosed_le (by fun_prop) (by fun_prop)))
      have hνU : ν {w : Euclid P | ‖w‖ < 3 ∧ |inner ℝ w a| < 1 - η ∧ |inner ℝ w e| < 1 - η} =
          (m : ℝ≥0∞) * ENNReal.ofReal (4 * (1 - η) ^ 2) := by
        rw [hν, Measure.smul_apply, smul_eq_mul, (hsq (1 - η) (by linarith) (by linarith)).1]
      have hνK : ν {w : Euclid P | ‖w‖ ≤ 3 ∧ |inner ℝ w a| ≤ 1 + η ∧ |inner ℝ w e| ≤ 1 + η} =
          (m : ℝ≥0∞) * ENNReal.ofReal (4 * (1 + η) ^ 2) := by
        rw [hν, Measure.smul_apply, smul_eq_mul, (hsq (1 + η) (by linarith) (by linarith)).2]
      -- Step 6: once `20 tⱼ < 1`, `30 tⱼ < η` and `6 tⱼ < s`, the box inclusions and (L)
      -- sandwich `μ(Z(s, tⱼ)) / ofReal (tⱼ²)` between the rescaled masses of `U_η` and `K_η`
      have hsand : ∀ᶠ j in atTop,
          ENNReal.ofReal ((t j)⁻¹ ^ 2) * μ (dilation a (t j) ⁻¹'
              {w : Euclid P | ‖w‖ < 3 ∧ |inner ℝ w a| < 1 - η ∧ |inner ℝ w e| < 1 - η}) ≤
            μ (Z (t j)) / ENNReal.ofReal (t j ^ 2) ∧
          μ (Z (t j)) / ENNReal.ofReal (t j ^ 2) ≤
            ENNReal.ofReal ((t j)⁻¹ ^ 2) * μ (dilation a (t j) ⁻¹'
              {w : Euclid P | ‖w‖ ≤ 3 ∧ |inner ℝ w a| ≤ 1 + η ∧ |inner ℝ w e| ≤ 1 + η}) := by
        filter_upwards [ht.eventually (gt_mem_nhds (by norm_num : (0 : ℝ) < 1 / 20)),
          ht.eventually (gt_mem_nhds (by positivity : (0 : ℝ) < η / 30)),
          ht.eventually (gt_mem_nhds (by positivity : (0 : ℝ) < s / 6))] with j hj1 hj2 hj3
        obtain ⟨hin, hout⟩ := Submission.idtp_cse_bml_rescaled_box_inclusions P Q a e s η (t j)
          haQ ha he hae hη0 (ht0 j) (by linarith) (by linarith) (by linarith)
        have hnull : μ (Z (t j) \ ball a (3 * t j)) = 0 := hL (t j) (ht0 j) (by linarith)
        rw [hdiv]
        refine ⟨mul_le_mul_right (measure_mono hin) _, mul_le_mul_right ?_ _⟩
        calc μ (Z (t j)) ≤ μ (Z (t j) ∩ ball a (3 * t j)) + μ (Z (t j) \ ball a (3 * t j)) :=
              measure_le_inter_add_sdiff μ _ _
          _ = μ (Z (t j) ∩ ball a (3 * t j)) := by rw [hnull, add_zero]
          _ ≤ _ := measure_mono hout
      -- Step 7
      constructor
      · rw [← hνU]
        exact (hO _ hUo).trans (liminf_le_liminf (hsand.mono fun j hj => hj.1))
      · rw [← hνK]
        exact (limsup_le_limsup (hsand.mono fun j hj => hj.2)).trans (hC _ hKc)
    -- Step 8: `m ofReal (4(1 ∓ η)²) → 4m` as `η ↓ 0`
    have hlim : ∀ c : ℝ, Tendsto (fun η : ℝ => (m : ℝ≥0∞) * ENNReal.ofReal (4 * (1 + c * η) ^ 2))
        (𝓝[>] 0) (𝓝 (4 * (m : ℝ≥0∞))) := by
      intro c
      have h : Tendsto (fun η : ℝ => ENNReal.ofReal (4 * (1 + c * η) ^ 2)) (𝓝 0)
          (𝓝 (ENNReal.ofReal (4 * (1 + c * 0) ^ 2))) :=
        (ENNReal.continuous_ofReal.comp (by fun_prop)).tendsto 0
      convert (ENNReal.Tendsto.const_mul h (Or.inr (ENNReal.natCast_ne_top m))).mono_left
        nhdsWithin_le_nhds using 2
      simp [mul_comm]
    refine tendsto_of_le_liminf_of_limsup_le ?_ ?_
    · refine le_of_tendsto (hlim (-1)) ?_
      filter_upwards [Ioo_mem_nhdsGT (show (0 : ℝ) < 1 / 2 by norm_num)] with η hη'
      simpa [← sub_eq_add_neg] using (hη η hη'.1 hη'.2).1
    · refine ge_of_tendsto (hlim 1) ?_
      filter_upwards [Ioo_mem_nhdsGT (show (0 : ℝ) < 1 / 2 by norm_num)] with η hη'
      simpa using (hη η hη'.1 hη'.2).2
  -- Step 1: the subsequence criterion, the subsequence being supplied by (V)
  refine Submission.idtp_cse_bml_tendsto_nhdsGT_of_subseq _ _ fun lams hl0 hl => ?_
  obtain ⟨φ, hφ, hVφ⟩ := hV lams hl0 hl
  exact ⟨φ, hφ, key (fun j => lams (φ j)) (fun j => hl0 (φ j)) (hl.comp hφ.tendsto_atTop) hVφ⟩
/-- The constant `2`-covector `a♭ ∧ e♭`: `f(v) = ⟨a, v₀⟩⟨e, v₁⟩ − ⟨a, v₁⟩⟨e, v₀⟩` is linear in
each entry (each product has exactly one factor depending on `vᵢ`) and vanishes when `v₀ = v₁`, so
it is an alternating map.  By Cauchy–Schwarz `|f(v)| ≤ 2‖a‖‖e‖‖v₀‖‖v₁‖`, so
`AlternatingMap.mkContinuous` turns it into a continuous alternating map, i.e. an element of
`Covector (Euclid P) 2`, with the same values. -/
theorem Submission.idtp_cse_bml_wedge_covector : ∀ (P : ℕ) (a e : Euclid P), ∃ β : Covector (Euclid P) 2, ∀ v : Fin 2 → Euclid P, β v = inner ℝ a (v 0) * inner ℝ e (v 1) - inner ℝ a (v 1) * inner ℝ e (v 0) := by
  intro P a e
  -- `f` is multilinear (two cases `i = 0, 1`) and alternating (`v₀ = v₁` forces `f v = 0`)
  let f : Euclid P [⋀^Fin 2]→ₗ[ℝ] ℝ :=
    { toFun := fun v => inner ℝ a (v 0) * inner ℝ e (v 1) - inner ℝ a (v 1) * inner ℝ e (v 0)
      map_update_add' := fun v i x y => by
        fin_cases i <;> simp [inner_add_right] <;> ring
      map_update_smul' := fun v i c x => by
        fin_cases i <;> simp [real_inner_smul_right] <;> ring
      map_eq_zero_of_eq' := fun v i j hij hne => by
        fin_cases i <;> fin_cases j <;> simp_all }
  -- bound `‖f v‖ ≤ 2‖a‖‖e‖ ∏ᵢ ‖vᵢ‖` (triangle inequality and Cauchy–Schwarz)
  refine ⟨f.mkContinuous (2 * ‖a‖ * ‖e‖) fun v => ?_, fun v => rfl⟩
  rw [Fin.prod_univ_two]
  calc ‖f v‖ = ‖inner ℝ a (v 0) * inner ℝ e (v 1) - inner ℝ a (v 1) * inner ℝ e (v 0)‖ := rfl
    _ ≤ ‖inner ℝ a (v 0)‖ * ‖inner ℝ e (v 1)‖ + ‖inner ℝ a (v 1)‖ * ‖inner ℝ e (v 0)‖ := by
      rw [← norm_mul, ← norm_mul]
      exact norm_sub_le _ _
    _ ≤ (‖a‖ * ‖v 0‖) * (‖e‖ * ‖v 1‖) + (‖a‖ * ‖v 1‖) * (‖e‖ * ‖v 0‖) := by
      gcongr <;> exact norm_inner_le_norm _ _
    _ = 2 * ‖a‖ * ‖e‖ * (‖v 0‖ * ‖v 1‖) := by ring
/-- **Pointwise tilt bound** (in the proof of Simon 7.3.3(1), the classification of the
two-dimensional minimizing cones `S₀` in (15), chapter-07.txt lines 493–504).  For `a, e ∈ Q`
orthonormal, `β = a♭ ∧ e♭`, `Ax = ⟨x, a⟩e − ⟨x, e⟩a` and `G = |p_{TₓM}(Ax)|² / |πx|²`:
(i) `G ≤ 1` on `{⟨x, a⟩ > 0}`, because `|Ax|² = ⟨x, a⟩² + ⟨x, e⟩² ≤ |πx|²` (Bessel in `Q`, so
`dim Q = 2` is not needed);
(ii) `μ`-a.e., `TₓM` has an orthonormal basis `τ` with `ξ(x)(β) = ±D`,
`D = ⟨a, τ₀⟩⟨e, τ₁⟩ − ⟨a, τ₁⟩⟨e, τ₀⟩`, so `|ξ(x)(β)| ≤ 1` (Lagrange and Bessel), and
`x ∈ TₓM` gives `|p_{TₓM}(Ax)|² = D²|x|² ≥ D²|πx|²`, whence `G ≥ D² ≥ 2|D| − 1`. -/
theorem Submission.idtp_cse_bml_tilt_pointwise_bound : ∀ (P : ℕ) (R : IMRep (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (β : Covector (Euclid P) 2), Module.finrank ℝ Q = 2 → a ∈ Q → e ∈ Q → ‖a‖ = 1 → ‖e‖ = 1 → inner ℝ a e = 0 → (∀ v : Fin 2 → Euclid P, β v = inner ℝ a (v 0) * inner ℝ e (v 1) - inner ℝ a (v 1) * inner ℝ e (v 0)) → (∀ᵐ x ∂R.measure, (approxTangentPlane 2 R.carrier x).starProjection x = x) → (∀ x : Euclid P, 0 < inner ℝ x a → ‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2 ≤ 1) ∧ ∀ᵐ x ∂R.measure, |R.orient x β| ≤ 1 ∧ (0 < inner ℝ x a → 1 - 2 * (1 - |R.orient x β|) ≤ ‖(approxTangentPlane 2 R.carrier x).starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 / ‖Q.starProjection x‖ ^ 2) := by
  intro P R Q a e β _ ha he hna hne hae hβ hrad
  -- Step 1: `|Ax|² = ⟨x, a⟩² + ⟨x, e⟩²`, since `a, e` are orthonormal
  have hAx : ∀ x : Euclid P,
      ‖inner ℝ x a • e - inner ℝ x e • a‖ ^ 2 = inner ℝ x a ^ 2 + inner ℝ x e ^ 2 := by
    intro x
    rw [norm_sub_sq_real, norm_smul, norm_smul, real_inner_smul_left, real_inner_smul_right,
      real_inner_comm a e, hae, hna, hne, Real.norm_eq_abs, Real.norm_eq_abs, mul_pow, mul_pow,
      sq_abs, sq_abs]
    ring
  -- Step 2: `⟨x, a⟩² + ⟨x, e⟩² ≤ |πx|²` (Bessel for `a, e` applied to `πx`; `x − πx ⊥ Q`)
  have hon : Orthonormal ℝ ![a, e] := by
    rw [orthonormal_iff_ite]
    intro i j
    fin_cases i <;> fin_cases j <;>
      simp [hna, hne, hae, real_inner_comm a e]
  have hπ : ∀ x : Euclid P, inner ℝ x a ^ 2 + inner ℝ x e ^ 2 ≤ ‖Q.starProjection x‖ ^ 2 := by
    intro x
    have h1 : inner ℝ x a = inner ℝ a (Q.starProjection x) := by
      have h := Submodule.starProjection_inner_eq_zero x a ha
      rw [inner_sub_left, sub_eq_zero] at h
      rw [h, real_inner_comm]
    have h2 : inner ℝ x e = inner ℝ e (Q.starProjection x) := by
      have h := Submodule.starProjection_inner_eq_zero x e he
      rw [inner_sub_left, sub_eq_zero] at h
      rw [h, real_inner_comm]
    have h := hon.sum_inner_products_le (Q.starProjection x) (s := Finset.univ)
    simpa [Fin.sum_univ_two, h1, h2] using h
  refine ⟨fun x _ => ?_, ?_⟩
  · -- Claim (i): `|p_{TₓM}(Ax)|² ≤ |Ax|² ≤ |πx|²`
    refine div_le_one_of_le₀ ?_ (sq_nonneg _)
    calc ‖(approxTangentPlane 2 R.carrier x).starProjection
            (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2
        ≤ ‖inner ℝ x a • e - inner ℝ x e • a‖ ^ 2 := by
          gcongr
          exact Submodule.norm_starProjection_apply_le _ _
      _ ≤ ‖Q.starProjection x‖ ^ 2 := by rw [hAx]; exact hπ x
  · -- Claim (ii).  Step 3: `μ ≪ H²⌞M`, so `R.orients` holds `μ`-a.e.
    have hor : ∀ᵐ x ∂R.measure, ∃ Q' : Submodule ℝ (Euclid P),
        HasApproximateTangentSpaceAt 2 R.carrier x Q' ∧ IsUnitOrientationOf (R.orient x) Q' :=
      (withDensity_absolutelyContinuous _ _).ae_le R.orients
    filter_upwards [hor, hrad] with x hx hxT
    obtain ⟨Q', hQ', τ, hτ, hspan, hξ⟩ := hx
    -- Step 4: `TₓM = Q' = span τ`, by uniqueness of approximate tangent spaces
    have hT : approxTangentPlane 2 R.carrier x = Q' := by
      have h : ∃ Q'', HasApproximateTangentSpaceAt 2 R.carrier x Q'' := ⟨Q', hQ'⟩
      rw [approxTangentPlane, dite_eq_left h]
      exact h.choose_spec.unique hQ'
    set T := approxTangentPlane 2 R.carrier x
    have h00 : inner ℝ (τ 0) (τ 0) = 1 := by rw [real_inner_self_eq_norm_sq, hτ.1 0]; norm_num
    have h11 : inner ℝ (τ 1) (τ 1) = 1 := by rw [real_inner_self_eq_norm_sq, hτ.1 1]; norm_num
    have h01 : inner ℝ (τ 0) (τ 1) = 0 := hτ.2 (by decide)
    have h10 : inner ℝ (τ 1) (τ 0) = 0 := hτ.2 (by decide)
    -- Step 5: `p_T v = ⟨τ₀, v⟩τ₀ + ⟨τ₁, v⟩τ₁` and `|p_T v|² = ⟨τ₀, v⟩² + ⟨τ₁, v⟩²`
    have hproj : ∀ v : Euclid P,
        T.starProjection v = inner ℝ (τ 0) v • τ 0 + inner ℝ (τ 1) v • τ 1 := by
      intro v
      apply Submodule.eq_starProjection_of_mem_of_inner_eq_zero
      · rw [hT, ← hspan]
        exact Submodule.add_mem _ (Submodule.smul_mem _ _ (Submodule.subset_span ⟨0, rfl⟩))
          (Submodule.smul_mem _ _ (Submodule.subset_span ⟨1, rfl⟩))
      · intro w hw
        rw [hT, ← hspan] at hw
        induction hw using Submodule.span_induction with
        | mem w hw =>
          obtain ⟨i, rfl⟩ := hw
          fin_cases i
          · simp [inner_sub_left, inner_add_left, real_inner_smul_left, h10, hτ.1 0,
              real_inner_comm (τ 0) v]
          · simp [inner_sub_left, inner_add_left, real_inner_smul_left, h01, hτ.1 1,
              real_inner_comm (τ 1) v]
        | zero => simp
        | add u w _ _ hu hw => rw [inner_add_right, hu, hw, add_zero]
        | smul c u _ hu => rw [real_inner_smul_right, hu, mul_zero]
    have hnorm : ∀ v : Euclid P,
        ‖T.starProjection v‖ ^ 2 = inner ℝ (τ 0) v ^ 2 + inner ℝ (τ 1) v ^ 2 := by
      intro v
      rw [hproj, ← real_inner_self_eq_norm_sq]
      simp only [inner_add_left, inner_add_right, real_inner_smul_left, real_inner_smul_right,
        h00, h11, h01, h10]
      ring
    -- Step 6: `ξ(x)(β) = ±D`
    have hd : |R.orient x β| =
        |inner ℝ a (τ 0) * inner ℝ e (τ 1) - inner ℝ a (τ 1) * inner ℝ e (τ 0)| := by
      rcases hξ with h | h
      · rw [h, hβ]
      · rw [h, hβ, abs_neg]
    -- Step 7: `D² ≤ 1` (Lagrange's identity and Bessel for `τ`)
    have hBa : inner ℝ a (τ 0) ^ 2 + inner ℝ a (τ 1) ^ 2 ≤ 1 := by
      have h := hτ.sum_inner_products_le a (s := Finset.univ)
      simpa [Fin.sum_univ_two, real_inner_comm a, hna] using h
    have hBe : inner ℝ e (τ 0) ^ 2 + inner ℝ e (τ 1) ^ 2 ≤ 1 := by
      have h := hτ.sum_inner_products_le e (s := Finset.univ)
      simpa [Fin.sum_univ_two, real_inner_comm e, hne] using h
    -- Step 8: coordinates of `x ∈ T`
    have hx : x = inner ℝ (τ 0) x • τ 0 + inner ℝ (τ 1) x • τ 1 := by
      rw [← hproj, hxT]
    have hxa : inner ℝ x a = inner ℝ (τ 0) x * inner ℝ a (τ 0) +
        inner ℝ (τ 1) x * inner ℝ a (τ 1) := by
      conv_lhs => rw [hx]
      rw [inner_add_left, real_inner_smul_left, real_inner_smul_left, real_inner_comm a (τ 0),
        real_inner_comm a (τ 1)]
    have hxe : inner ℝ x e = inner ℝ (τ 0) x * inner ℝ e (τ 0) +
        inner ℝ (τ 1) x * inner ℝ e (τ 1) := by
      conv_lhs => rw [hx]
      rw [inner_add_left, real_inner_smul_left, real_inner_smul_left, real_inner_comm e (τ 0),
        real_inner_comm e (τ 1)]
    have hxx : ‖x‖ ^ 2 = inner ℝ (τ 0) x ^ 2 + inner ℝ (τ 1) x ^ 2 := by
      rw [← hnorm, hxT]
    -- Step 9: `|p_T(Ax)|² = D²|x|²`
    have hPA : ‖T.starProjection (inner ℝ x a • e - inner ℝ x e • a)‖ ^ 2 =
        (inner ℝ a (τ 0) * inner ℝ e (τ 1) - inner ℝ a (τ 1) * inner ℝ e (τ 0)) ^ 2 *
          ‖x‖ ^ 2 := by
      rw [hnorm, hxx]
      simp only [inner_sub_right, real_inner_smul_right]
      rw [hxa, hxe, real_inner_comm (τ 0) a, real_inner_comm (τ 1) a, real_inner_comm (τ 0) e,
        real_inner_comm (τ 1) e]
      ring
    have hD2 : (inner ℝ a (τ 0) * inner ℝ e (τ 1) - inner ℝ a (τ 1) * inner ℝ e (τ 0)) ^ 2 ≤ 1 := by
      have hL : (inner ℝ a (τ 0) * inner ℝ e (τ 1) - inner ℝ a (τ 1) * inner ℝ e (τ 0)) ^ 2 +
          (inner ℝ a (τ 0) * inner ℝ e (τ 0) + inner ℝ a (τ 1) * inner ℝ e (τ 1)) ^ 2 =
          (inner ℝ a (τ 0) ^ 2 + inner ℝ a (τ 1) ^ 2) *
            (inner ℝ e (τ 0) ^ 2 + inner ℝ e (τ 1) ^ 2) := by ring
      have hprod := mul_le_mul hBa hBe (by positivity) zero_le_one
      nlinarith [sq_nonneg (inner ℝ a (τ 0) * inner ℝ e (τ 0) +
        inner ℝ a (τ 1) * inner ℝ e (τ 1))]
    refine ⟨?_, fun hxa0 => ?_⟩
    · rw [hd]
      exact (sq_le_one_iff_abs_le_one _).mp hD2
    · -- Step 10: `G = D²|x|²/|πx|² ≥ D² ≥ 2|D| − 1`, as `0 < |πx|² ≤ |x|²`
      have hpos : 0 < ‖Q.starProjection x‖ ^ 2 :=
        lt_of_lt_of_le (add_pos_of_pos_of_nonneg (pow_pos hxa0 2) (sq_nonneg _)) (hπ x)
      have hle : ‖Q.starProjection x‖ ^ 2 ≤ ‖x‖ ^ 2 := by
        gcongr
        exact Submodule.norm_starProjection_apply_le _ _
      rw [hd, le_div_iff₀ hpos, hPA]
      set D := inner ℝ a (τ 0) * inner ℝ e (τ 1) - inner ℝ a (τ 1) * inner ℝ e (τ 0)
      calc (1 - 2 * (1 - |D|)) * ‖Q.starProjection x‖ ^ 2
          ≤ D ^ 2 * ‖Q.starProjection x‖ ^ 2 := by
            gcongr
            nlinarith [sq_abs D, sq_nonneg (|D| - 1)]
        _ ≤ D ^ 2 * ‖x‖ ^ 2 := by gcongr

/-- **Tilt-excess decay at a point with a multiplicity-`m` tangent plane** (the tilt-excess step
for the 2-dimensional minimizing cones `S₀` of (15) in the proof of Simon 7.3.3(1),
chapter-07.txt lines 499–507).  Let `R` represent `C ∈ 𝒟₂(ℝᴾ)`, `μ = R.measure`, `d = ⟨β, ξ⟩`
with `|d| ≤ 1` `μ`-a.e. and `β(a, e) = 1`, and let every sequence `λⱼ ↓ 0` have a subsequence
`tⱼ` with `η_{a,tⱼ#}C ⇀ C' = c ∫_Q ⟨·, a ∧ e⟩ dH²`, `|c| = m`, and `μ_{η_{a,tⱼ#}C} → m H²⌞Q`.
Testing with `ω_ϑ = ϑβ` (`ϑ = 1` on `B₃(0)`), `η_{a,tⱼ#}C(ω_ϑ) = tⱼ⁻² ∫ (ϑ ∘ η_{a,tⱼ}) d dμ`
tends to `c ∫_Q ϑ dH²`, while `tⱼ⁻² ∫ ϑ ∘ η_{a,tⱼ} dμ → m ∫_Q ϑ dH²`; the difference bounds
`tⱼ⁻² ∫_{B_{3tⱼ}(a)} (1 - |d|) dμ`, so the latter tends to `0`, and hence so does
`s⁻² ∫_{B_{3s}(a)} (1 - |d|) dμ` as `s ↓ 0`, by the subsequence criterion. -/
theorem Submission.idtp_cse_bml_tilt_excess_decay : ∀ (P : ℕ) (C : GeometricCurrentOn (univ : Set (Euclid P)) 2) (R : IMRep (univ : Set (Euclid P)) 2) (Q : Submodule ℝ (Euclid P)) (a e : Euclid P) (m : ℕ) (β : Covector (Euclid P) 2), R.Represents C → β ![a, e] = 1 → (∀ᵐ x ∂R.measure, |R.orient x β| ≤ 1) → (∀ (lams : ℕ → ℝ) (hlams : ∀ j, 0 < lams j), Tendsto lams atTop (𝓝 0) → ∃ (φ : ℕ → ℕ) (C' : GeometricCurrentOn (univ : Set (Euclid P)) 2) (c : ℤ), StrictMono φ ∧ c.natAbs = m ∧ ConvergesWeakly (fun j => blowUp C a (lams (φ j)) (hlams (φ j)).ne') C' ∧ (∀ ω : TestFormOn (univ : Set (Euclid P)) 2, C' ω = (c : ℝ) * ∫ x in (Q : Set (Euclid P)), (ω : DifferentialForm (Euclid P) 2) x ![a, e] ∂μHE[2]) ∧ ∀ g : Euclid P → ℝ, Continuous g → HasCompactSupport g → Tendsto (fun j => (lams (φ j))⁻¹ ^ 2 * ∫ x, g (dilation a (lams (φ j)) x) ∂R.measure) atTop (𝓝 ((m : ℝ) * ∫ x in (Q : Set (Euclid P)), g x ∂μHE[2]))) → Tendsto (fun s' : ℝ => (∫⁻ x in ball a (3 * s'), ENNReal.ofReal (1 - |R.orient x β|) ∂R.measure) / ENNReal.ofReal (s' ^ 2)) (𝓝[>] 0) (𝓝 0) := by
  intro P C R Q a e m β hRC hβ hd1 hBP
  -- Step 0: `μ` is finite on compacts and `d = ⟨β, ξ⟩` is a.e. strongly measurable
  obtain ⟨-, -, -, -, hloc, horient, -⟩ := Submission.cbr_imRep_measure_basic P 2 univ R
  have hfin : ∀ K : Set (Euclid P), IsCompact K → R.measure K < ∞ :=
    fun K hK => hloc K hK (subset_univ K)
  have hdm : AEStronglyMeasurable (fun x => R.orient x β) R.measure :=
    (ContinuousLinearMap.apply ℝ ℝ β).continuous.comp_aestronglyMeasurable horient
  -- Step 3: the cutoff `ϑ` (`= 1` on `B₃(0)`) and the test form `ω_ϑ = ϑβ`
  obtain ⟨ϑ, ω, hϑc, hϑcs, hϑ01, hϑ1, hω⟩ :=
    Submission.idtp_cse_bml_td_cutoff_test_form P 2 3 β (by norm_num)
  -- Step 1: by the subsequence criterion it suffices to treat sequences `λⱼ → 0⁺`
  refine Submission.idtp_cse_bml_tendsto_nhdsGT_of_subseq _ 0 fun lams hlams hlim => ?_
  -- Step 2: the subsequence `tⱼ = λ_{φ(j)}`, the limit `C'` and the multiplicity `c` of (BP)
  obtain ⟨φ, C', c, hφ, hc, hconv, hC', hmass⟩ := hBP lams hlams hlim
  refine ⟨φ, hφ, ?_⟩
  -- Step 4: `C'(ω_ϑ) = c ∫_Q ϑ dH²`, since `ω_ϑ(x)(a, e) = ϑ(x) β(a, e) = ϑ(x)`
  have hC'ω : C' ω = (c : ℝ) * ∫ x in (Q : Set (Euclid P)), ϑ x ∂μHE[2] := by
    rw [hC' ω]
    congr 1
    refine integral_congr_ae (Eventually.of_forall fun x => ?_)
    simp only [hω x, ContinuousAlternatingMap.smul_apply, hβ, smul_eq_mul, mul_one]
  -- Steps 4–5: `tⱼ⁻² ∫ ϑ(η_{a,tⱼ}(y)) ⟨β, ξ(y)⟩ dμ = η_{a,tⱼ#}C(ω_ϑ) → c ∫_Q ϑ dH²`
  have hV : Tendsto (fun j => (lams (φ j))⁻¹ ^ 2 *
      ∫ y, ϑ (dilation a (lams (φ j)) y) * R.orient y β ∂R.measure) atTop
      (𝓝 ((c : ℝ) * ∫ x in (Q : Set (Euclid P)), ϑ x ∂μHE[2])) := by
    have h := hconv ω
    rw [hC'ω] at h
    exact h.congr fun j => Submission.idtp_cse_bml_td_blowUp_smul_form_eval P 2 C R a
      (lams (φ j)) (hlams (φ j)) ϑ β ω hRC hω
  -- Step 7: `tⱼ⁻² ∫ ϑ ∘ η_{a,tⱼ} dμ → m ∫_Q ϑ dH²` by (BP) and `m = |c|`, so the bound
  -- `tⱼ⁻² ∫ ϑ ∘ η_{a,tⱼ} dμ - |η_{a,tⱼ#}C(ω_ϑ)|` tends to `m ∫_Q ϑ - |c ∫_Q ϑ| = 0`
  have hD : Tendsto (fun j => (lams (φ j))⁻¹ ^ 2 * ∫ x, ϑ (dilation a (lams (φ j)) x) ∂R.measure -
      |(lams (φ j))⁻¹ ^ 2 * ∫ x, ϑ (dilation a (lams (φ j)) x) * R.orient x β ∂R.measure|)
      atTop (𝓝 0) := by
    have hI : 0 ≤ ∫ x in (Q : Set (Euclid P)), ϑ x ∂μHE[2] := integral_nonneg fun x => (hϑ01 x).1
    have hm : (m : ℝ) = |(c : ℝ)| := by rw [← hc, Nat.cast_natAbs, Int.cast_abs]
    have h := (hmass ϑ hϑc hϑcs).sub hV.abs
    rwa [abs_mul, abs_of_nonneg hI, hm, sub_self] at h
  -- Steps 8–9: `0 ≤ X(tⱼ)/tⱼ² ≤ ofReal(tⱼ⁻² ∫ ϑ ∘ η_{a,tⱼ} dμ - |η_{a,tⱼ#}C(ω_ϑ)|) → 0`
  have hD' := ENNReal.tendsto_ofReal hD
  rw [ENNReal.ofReal_zero] at hD'
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hD' (fun _ => zero_le)
    fun j => Submission.idtp_cse_bml_td_excess_bound P R.measure (fun x => R.orient x β) ϑ a
      (lams (φ j)) (hlams (φ j)) hfin hdm hd1 hϑc hϑcs (fun x => (hϑ01 x).1) hϑ1
/-- **Simon Ch. 6, 1.2 and 1.5–1.7**: a unit orientation `ξ = ±τ₁ ∧ ⋯ ∧ τₙ` (`τ` orthonormal)
has `|ξ(α)| ≤ |α|` for the Euclidean coefficient norm, and `L(ζ) = Σ_I ζ(dx^I) dx^I` (`I` strictly
increasing) has `|L(ξ)| ≤ 1` and `ξ(L(ξ)) = 1`.  Every covector expands as `α = Σ_I α(e_I) dx^I`,
and `dx^I(e_J) = δ_IJ`.  Expanding `δ_τ(v) = det(⟨τᵢ, vⱼ⟩)` at `v = τ` gives the Cauchy–Binet
identity `Σ_I dx^I(τ)² = 1`; with Cauchy–Schwarz, `|α(τ)| ≤ |α|`. -/
theorem Submission.dor_ims_unitOrientation_dual : ∀ (P n : ℕ), ∃ L : MultiVector P n →L[ℝ] Covector (Euclid P) n, ∀ (ξ : MultiVector P n) (Q : Submodule ℝ (Euclid P)), IsUnitOrientationOf ξ Q → (∀ α : Covector (Euclid P) n, |ξ α| ≤ covectorEuclideanNorm α) ∧ covectorEuclideanNorm (L ξ) ≤ 1 ∧ ξ (L ξ) = 1 := by
  intro P n
  -- `W u v = Σ_σ sgn σ ∏ₖ ⟨uₖ, v_{σ k}⟩ = det(⟨uₖ, vⱼ⟩)`; `dx^I = W (e ∘ I)` and `δ_τ = W τ`
  let W : (Fin n → Euclid P) → Covector (Euclid P) n := fun u =>
    ContinuousMultilinearMap.alternatization
      ((ContinuousMultilinearMap.mkPiAlgebra ℝ (Fin n) ℝ).compContinuousLinearMap
        fun k => innerSL ℝ (u k))
  have hW : ∀ u v, W u v =
      ∑ σ : Equiv.Perm (Fin n), Equiv.Perm.sign σ • ∏ k, inner ℝ (u k) (v (σ k)) := by
    intro u v
    simp only [W, ContinuousMultilinearMap.alternatization_apply_apply,
      ContinuousMultilinearMap.compContinuousLinearMap_apply,
      ContinuousMultilinearMap.mkPiAlgebra_apply, innerSL_apply_apply, Function.comp_apply]
  -- `W u v = W v u` (the determinant of the transpose): substitute `σ ↦ σ⁻¹` and `k ↦ σ k`
  have hWsymm : ∀ u v, W u v = W v u := by
    intro u v
    rw [hW, hW]
    refine Fintype.sum_equiv (Equiv.inv (Equiv.Perm (Fin n))) _ _ fun σ => ?_
    rw [Equiv.inv_apply, Equiv.Perm.sign_inv,
      ← Equiv.prod_comp σ (fun k => inner ℝ (v k) (u (σ⁻¹ k)))]
    simp only [Equiv.Perm.coe_inv, Equiv.symm_apply_apply, real_inner_comm]
  -- `W u u = 1` for orthonormal `u`: only `σ = 1` contributes
  have hW1 : ∀ u, Orthonormal ℝ u → W u u = 1 := by
    intro u hu
    rw [hW, Finset.sum_eq_single (1 : Equiv.Perm (Fin n))]
    · rw [Equiv.Perm.sign_one, one_smul]
      refine Finset.prod_eq_one fun k _ => ?_
      rw [Equiv.Perm.coe_one, id, real_inner_self_eq_norm_sq, hu.norm_eq_one, one_pow]
    · intro σ _ hσ
      obtain ⟨k, hk⟩ : ∃ k, σ k ≠ k := by
        by_contra! h
        exact hσ (Equiv.ext h)
      rw [Finset.prod_eq_zero (Finset.mem_univ k) (hu.inner_eq_zero hk.symm), smul_zero]
    · exact fun h => absurd (Finset.mem_univ _) h
  -- Kronecker property `dx^I(e_J) = δ_IJ` for strictly increasing `I`, `J`: a nonzero term
  -- forces `J ∘ σ = I`, so `range I = range J` and `I = J`
  let e := EuclideanSpace.basisFun (Fin P) ℝ
  have he : ∀ i j, inner ℝ (e i) (e j) = if i = j then (1 : ℝ) else 0 :=
    orthonormal_iff_ite.mp e.orthonormal
  have hK : ∀ I J : Fin n → Fin P, StrictMono I → StrictMono J →
      W (fun k => e (I k)) (fun k => e (J k)) = if I = J then 1 else 0 := by
    intro I J hI hJ
    split_ifs with hIJ
    · subst hIJ
      have hIo : Orthonormal ℝ (fun k => e (I k)) := e.orthonormal.comp I hI.injective
      exact hW1 _ hIo
    · rw [hW]
      refine Finset.sum_eq_zero fun σ _ => ?_
      rw [Finset.prod_eq_zero_iff.mpr, smul_zero]
      by_contra! h
      apply hIJ
      have hJσ : J ∘ σ = I := funext fun k => by
        have := h k (Finset.mem_univ k)
        rw [he] at this
        split_ifs at this with hk
        · exact hk.symm
        · exact absurd rfl this
      rw [← (StrictMono.range_inj_of_wellFoundedLT hI hJ), ← hJσ, EquivLike.range_comp]
  -- expansion `α = Σ_{I ∈ S} α(e_I) dx^I`: both sides are alternating, so compare them on
  -- `e ∘ f`, `f` injective; writing `f = J ∘ σ⁻¹` with `J` strictly increasing (`J = f ∘ sort f`)
  -- reduces this to `e ∘ J`, where it is the Kronecker property
  let S : Finset (Fin n → Fin P) := Finset.univ.filter StrictMono
  have hE : ∀ α : Covector (Euclid P) n,
      α = ∑ I ∈ S, α (fun k => e (I k)) • W (fun k => e (I k)) := by
    intro α
    apply ContinuousAlternatingMap.toAlternatingMap_injective
    refine e.toBasis.ext_alternating fun f hf => ?_
    simp only [OrthonormalBasis.coe_toBasis, ContinuousAlternatingMap.coe_toAlternatingMap]
    set σ := Tuple.sort f
    have hJ : StrictMono (f ∘ σ) :=
      (Tuple.monotone_sort f).strictMono_of_injective (hf.comp σ.injective)
    have hperm : ∀ β : Covector (Euclid P) n,
        β (fun k => e (f k)) = Equiv.Perm.sign σ⁻¹ • β (fun k => e ((f ∘ σ) k)) := by
      intro β
      have : (fun k => e (f k)) = (fun k => e ((f ∘ σ) k)) ∘ ⇑(σ⁻¹) := by
        funext k
        simp
      rw [this]
      exact β.toAlternatingMap.map_perm _ _
    rw [hperm α, hperm, ContinuousAlternatingMap.sum_apply, Finset.sum_eq_single (f ∘ σ)]
    · rw [ContinuousAlternatingMap.smul_apply, hK _ _ hJ hJ, ite_eq_left rfl, smul_eq_mul,
        mul_one]
    · intro I hI hIJ
      rw [ContinuousAlternatingMap.smul_apply, hK _ _ (Finset.mem_filter.mp hI).2 hJ,
        ite_eq_right hIJ, smul_zero]
    · exact fun h => absurd (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hJ⟩) h
  -- `|β| = (Σ_{I ∈ S} β(e_I)²)^{1/2}`
  have hnorm : ∀ β : Covector (Euclid P) n,
      covectorEuclideanNorm β = Real.sqrt (∑ I ∈ S, β (fun k => e (I k)) ^ 2) := by
    intro β
    rw [covectorEuclideanNorm, Finset.sum_filter]
  -- Cauchy–Binet `Σ_{I ∈ S} dx^I(τ)² = 1` for orthonormal `τ`: evaluate the expansion of `δ_τ`
  -- at `τ`, using `δ_τ(τ) = 1` and `δ_τ(e_I) = dx^I(τ)`
  have hCB : ∀ τ : Fin n → Euclid P, Orthonormal ℝ τ →
      ∑ I ∈ S, W (fun k => e (I k)) τ ^ 2 = 1 := by
    intro τ hτ
    have h := congrArg (fun β : Covector (Euclid P) n => β τ) (hE (W τ))
    simp only [ContinuousAlternatingMap.sum_apply, ContinuousAlternatingMap.smul_apply,
      smul_eq_mul, hW1 τ hτ] at h
    rw [h]
    refine Finset.sum_congr rfl fun I _ => ?_
    rw [hWsymm τ, sq]
  -- `L ζ = Σ_{I ∈ S} ζ(dx^I) dx^I`
  refine ⟨∑ I ∈ S, (ContinuousLinearMap.apply ℝ ℝ (W fun k => e (I k))).smulRight
    (W fun k => e (I k)), ?_⟩
  rintro ξ Q ⟨τ, hτ, -, hξ⟩
  -- `ξ(α) = ±α(τ)` with a common sign
  have hξ2 : ∀ α β : Covector (Euclid P) n, ξ α * ξ β = α τ * β τ := by
    intro α β
    rcases hξ with h | h
    · rw [h, h]
    · rw [h, h, neg_mul_neg]
  have hξabs : ∀ α : Covector (Euclid P) n, |ξ α| = |α τ| := by
    intro α
    rcases hξ with h | h
    · rw [h]
    · rw [h, abs_neg]
  have hL : ∀ ζ : MultiVector P n, (∑ I ∈ S, (ContinuousLinearMap.apply ℝ ℝ
      (W fun k => e (I k))).smulRight (W fun k => e (I k))) ζ =
      ∑ I ∈ S, ζ (W fun k => e (I k)) • W fun k => e (I k) := by
    intro ζ
    simp only [sum_apply, ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.apply_apply]
  have hCBτ := hCB τ hτ
  refine ⟨fun α => ?_, ?_, ?_⟩
  · -- (a) `|ξ(α)| = |Σ_I α(e_I) dx^I(τ)| ≤ |α| (Σ_I dx^I(τ)²)^{1/2} = |α|`
    rw [hξabs, hnorm]
    apply Real.abs_le_sqrt
    have h := congrArg (fun β : Covector (Euclid P) n => β τ) (hE α)
    simp only [ContinuousAlternatingMap.sum_apply, ContinuousAlternatingMap.smul_apply,
      smul_eq_mul] at h
    rw [h]
    calc (∑ I ∈ S, α (fun k => e (I k)) * W (fun k => e (I k)) τ) ^ 2
        ≤ (∑ I ∈ S, α (fun k => e (I k)) ^ 2) * ∑ I ∈ S, W (fun k => e (I k)) τ ^ 2 :=
          Finset.sum_mul_sq_le_sq_mul_sq _ _ _
      _ = ∑ I ∈ S, α (fun k => e (I k)) ^ 2 := by rw [hCBτ, mul_one]
  · -- (b) `L(ξ)(e_J) = ξ(dx^J)`, so `|L(ξ)|² = Σ_J ξ(dx^J)² = Σ_J dx^J(τ)² = 1`
    rw [hnorm, hL]
    have : ∑ J ∈ S, (∑ I ∈ S, ξ (W fun k => e (I k)) • W fun k => e (I k))
        (fun k => e (J k)) ^ 2 = 1 := by
      rw [← hCBτ]
      refine Finset.sum_congr rfl fun J hJ => ?_
      rw [ContinuousAlternatingMap.sum_apply, Finset.sum_eq_single J]
      · rw [ContinuousAlternatingMap.smul_apply, hK _ _ (Finset.mem_filter.mp hJ).2
          (Finset.mem_filter.mp hJ).2, ite_eq_left rfl, smul_eq_mul, mul_one, sq, sq, hξ2]
      · intro I hI hIJ
        rw [ContinuousAlternatingMap.smul_apply, hK _ _ (Finset.mem_filter.mp hI).2
          (Finset.mem_filter.mp hJ).2, ite_eq_right hIJ, smul_zero]
      · exact fun h => absurd hJ h
    rw [this, Real.sqrt_one]
  · -- (c) `ξ(L(ξ)) = Σ_I ξ(dx^I)² = Σ_I dx^I(τ)² = 1`
    rw [hL, map_sum, ← hCBτ]
    refine Finset.sum_congr rfl fun I _ => ?_
    rw [map_smul, smul_eq_mul, hξ2, sq]

/-- **Constant density on the support forces constant multiplicity** (Simon Ch. 3, Remark 1.8(2),
chapter-03.txt lines 298–313, with `μ_T = μ_V`, Ch. 6, Remark 3.2(3)).  Let `T = τ(M, θ, ξ)` in open
`U`, `μ_T = θHⁿ⌞M`, `B = B_ρ(p)`, and suppose `Θⁿ(μ_T, y) = k` for every `y ∈ spt T ∩ B`.
* `Θⁿ(μ_T, x) = θ(x)` for `μ_T`-a.e. `x`, as in the accepted `Submission.rsd_ae_hasMassDensity_mult`.
  This node has no dependency edges, so the accepted `Submission.rsd_*` lemmas used here are
  repeated as local steps.  Approximate tangent planes and Besicovitch differentiation give
  `μ_T(B̄_r(x))/(ωₙrⁿ) → θ(x)`, and `M_W(T) ≤ μ_T(W)` bounds `M_{B_r(x)}(T)` from above.  From
  below, test `T` against `χ g(x)`, with `g = J ∘ ξ` the unit covector field dual to `ξ` and `χ` a
  smooth cut-off, at a Lebesgue point `x` of `g` (Ch. 1, 3.16–3.17, chapter-01.txt lines 907–935):
  `M_{B_r(x)}(T) ≥ μ_T(B̄_{tr}(x)) − o(rⁿ)` for every `t < 1`.
* Such an `x` lies in `spt T`.  Otherwise `T` vanishes on an open `W ∋ x`, so `M_{B_r(x)}(T) = 0`
  for small `r` and `Θⁿ(μ_T, x) = 0`, whereas `θ(x) ≥ 1` on `M ∋ x`.
* If moreover `x ∈ B`, then `Θⁿ(μ_T, x) = k` as well; limits in `[0, ∞]` are unique, so
  `θ(x) = k`.  This is (a).
* `θ ≥ 1` on `M` gives `Hⁿ⌞M ≪ μ_T` (`withDensity_absolutelyContinuous'`), so (a) also holds
  `Hⁿ⌞M`-a.e., hence `Hⁿ⌞(M ∩ B)`-a.e., where a.e. point lies in `B`.  This is (b). -/
theorem Submission.idtp_ccd_sfv_mult_ae_eq_density : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n) (p : Euclid P) (ρ : ℝ) (k : ℕ), IsOpen U → R.Represents T → (∀ y ∈ T.support, y ∈ ball p ρ → HasMassDensity T y k) → (∀ᵐ x ∂R.measure, x ∈ ball p ρ → R.mult x = k) ∧ ∀ᵐ x ∂(μHE[n].restrict (R.carrier ∩ ball p ρ)), R.mult x = k := by
  -- Accepted `Submission.rsd_tendsto_closedBall_density_of_approxTangent`, inlined: an approximate
  -- tangent plane forces `Hⁿ(M ∩ B̄_ρ(x))/(ωₙρⁿ) → 1` (Ch. 3, Remark 1.5(3)).
  have rsd_tendsto_closedBall_density_of_approxTangent : ∀ (P n : ℕ) (M : Set (Euclid P)) (x : Euclid P) (Q : Submodule ℝ (Euclid P)) (s : ℝ), 0 < s → μHE[n] (M ∩ closedBall x s) ≠ ∞ → HasApproximateTangentSpaceAt n M x Q → Tendsto (fun ρ : ℝ => μHE[n] (M ∩ closedBall x ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) (𝓝 1) := by
    intro P n M x Q s hs hfin hT
    obtain ⟨hQ, hconv⟩ := hT
    -- Step 1: `ωₙ ∈ (0, ∞)`
    set ω := unitBallVolume n with hωdef
    have hω0 : ω ≠ 0 := (measure_ball_pos volume (0 : Euclid n) one_pos).ne'
    have hωtop : ω ≠ ∞ := measure_ball_lt_top.ne
    set w := ω.toReal with hwdef
    have hw : 0 < w := ENNReal.toReal_pos hω0 hωtop
    -- Step 2: `Hⁿ(Q ∩ B̄_t(0)) = ωₙ tⁿ`, via a linear isometry `ℝⁿ ≅ Q`
    have hplane0 : ∀ t : ℝ, 0 ≤ t →
        μHE[n] ((Q : Set (Euclid P)) ∩ closedBall 0 t) = ω * ENNReal.ofReal (t ^ n) := by
      intro t ht
      let b : OrthonormalBasis (Fin n) ℝ Q := (stdOrthonormalBasis ℝ Q).reindex (finCongr hQ)
      let ι : Euclid n →ₗᵢ[ℝ] Euclid P := Q.subtypeₗᵢ.comp b.repr.symm.toLinearIsometry
      have himage : ι '' closedBall 0 t = (Q : Set (Euclid P)) ∩ closedBall 0 t := by
        ext y
        constructor
        · rintro ⟨v, hv, rfl⟩
          refine ⟨(b.repr.symm v).2, ?_⟩
          rw [mem_closedBall, dist_zero_right] at hv ⊢
          have : ‖((b.repr.symm v : Q) : Euclid P)‖ = ‖v‖ := b.repr.symm.norm_map v
          exact this.trans_le hv
        · rintro ⟨hyQ, hy⟩
          refine ⟨b.repr ⟨y, hyQ⟩, ?_, ?_⟩
          · rw [mem_closedBall, dist_zero_right] at hy ⊢
            exact (b.repr.norm_map ⟨y, hyQ⟩).trans_le hy
          · exact congrArg Subtype.val (b.repr.symm_apply_apply ⟨y, hyQ⟩)
      rw [← himage, ι.isometry.euclideanHausdorffMeasure_image,
        EuclideanSpace.euclideanHausdorffMeasure_eq_volume,
        Measure.addHaar_closedBall _ _ ht, finrank_euclideanSpace_fin, hωdef, unitBallVolume, mul_comm]
    -- Step 3: scaling `Hⁿ(η_{x,r}(A)) = r⁻ⁿ Hⁿ(A)` and `η_{x,r}(M) ∩ B̄_t(0) = η_{x,r}(M ∩ B̄_{tr}(x))`
    have hscale : ∀ r : ℝ, 0 < r → ∀ A : Set (Euclid P),
        μHE[n] (Poincare.SimonGMT.Chapter03.blowUpMap x r '' A) = ENNReal.ofReal (r⁻¹ ^ n) * μHE[n] A := by
      intro r hr A
      have h1 : Poincare.SimonGMT.Chapter03.blowUpMap x r '' A =
          (fun y => r⁻¹ • y) '' ((fun y => y - x) '' A) := by
        rw [image_image]
        rfl
      have hiso : Isometry (fun y : Euclid P => y - x) :=
        Isometry.of_dist_eq (fun a c => by simp [dist_eq_norm])
      rw [h1, Set.image_smul, Measure.euclideanHausdorffMeasure_smul₀ n (inv_ne_zero hr.ne'),
        hiso.euclideanHausdorffMeasure_image, ENNReal.smul_def, smul_eq_mul]
      congr 1
      rw [← ENNReal.ofReal_coe_nnreal]
      congr 1
      simp [abs_of_pos hr]
    have himg : ∀ r : ℝ, 0 < r → ∀ t : ℝ,
        Poincare.SimonGMT.Chapter03.blowUpMap x r '' M ∩ closedBall 0 t =
          Poincare.SimonGMT.Chapter03.blowUpMap x r '' (M ∩ closedBall x (t * r)) := by
      intro r hr t
      have key : ∀ z : Euclid P,
          ‖Poincare.SimonGMT.Chapter03.blowUpMap x r z‖ ≤ t ↔ dist z x ≤ t * r := by
        intro z
        simp only [Poincare.SimonGMT.Chapter03.blowUpMap, norm_smul, Real.norm_eq_abs, abs_inv,
          abs_of_pos hr, dist_eq_norm]
        rw [inv_mul_le_iff₀ hr, mul_comm r t]
      ext y
      constructor
      · rintro ⟨⟨z, hz, rfl⟩, hy⟩
        rw [mem_closedBall, dist_zero_right, key] at hy
        exact ⟨z, ⟨hz, hy⟩, rfl⟩
      · rintro ⟨z, ⟨hz, hzb⟩, rfl⟩
        refine ⟨⟨z, hz, rfl⟩, ?_⟩
        rw [mem_closedBall, dist_zero_right, key]
        exact hzb
    have hνball : ∀ r : ℝ, 0 < r → ∀ t : ℝ,
        (μHE[n].restrict (Poincare.SimonGMT.Chapter03.blowUpMap x r '' M)) (closedBall 0 t) =
          ENNReal.ofReal (r⁻¹ ^ n) * μHE[n] (M ∩ closedBall x (t * r)) := by
      intro r hr t
      rw [Measure.restrict_apply measurableSet_closedBall, inter_comm, himg r hr t, hscale r hr]
    have hmfin : ∀ r : ℝ, r ≤ s → μHE[n] (M ∩ closedBall x r) ≠ ∞ := fun r hr =>
      ne_top_of_le_ne_top hfin (measure_mono (inter_subset_inter_right _ (closedBall_subset_closedBall hr)))
    have hνfin : ∀ r : ℝ, 0 < r → ∀ t : ℝ, t * r ≤ s →
        (μHE[n].restrict (Poincare.SimonGMT.Chapter03.blowUpMap x r '' M)) (closedBall 0 t) ≠ ∞ := by
      intro r hr t ht
      rw [hνball r hr t]
      exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top (hmfin _ ht)
    -- Step 4: radial cut-off functions `g_{a,b}` in `C_c`
    have hbump : ∀ a b : ℝ, 0 < a → a < b →
        ∃ f : CompactlySupportedContinuousMap (Euclid P) ℝ, Continuous f ∧ (0 ≤ ⇑f) ∧
          (closedBall (0 : Euclid P) a).indicator 1 ≤ ⇑f ∧ ⇑f ≤ (closedBall (0 : Euclid P) b).indicator 1 := by
      intro a b ha hab
      have hcont : Continuous (fun y : Euclid P => max 0 (min 1 ((b - ‖y‖) / (b - a)))) :=
        continuous_const.max (continuous_const.min ((continuous_const.sub continuous_norm).div_const _))
      have hzero : ∀ y : Euclid P, b ≤ ‖y‖ → max 0 (min 1 ((b - ‖y‖) / (b - a))) = 0 := by
        intro y hy
        have h1 : (b - ‖y‖) / (b - a) ≤ 0 := div_nonpos_of_nonpos_of_nonneg (by linarith) (by linarith)
        rw [max_eq_left ((min_le_right _ _).trans h1)]
      let f : CompactlySupportedContinuousMap (Euclid P) ℝ :=
        { toFun := fun y => max 0 (min 1 ((b - ‖y‖) / (b - a)))
          continuous_toFun := hcont
          hasCompactSupport' := by
            refine HasCompactSupport.intro (isCompact_closedBall (0 : Euclid P) b) ?_
            intro y hy
            rw [mem_closedBall, dist_zero_right, not_le] at hy
            exact hzero y hy.le }
      have hf : ∀ y, f y = max 0 (min 1 ((b - ‖y‖) / (b - a))) := fun y => rfl
      refine ⟨f, f.continuous, fun y => by rw [hf]; exact le_max_left _ _, ?_, ?_⟩
      · intro y
        by_cases hy : y ∈ closedBall (0 : Euclid P) a
        · rw [indicator_of_mem hy, Pi.one_apply, hf]
          rw [mem_closedBall, dist_zero_right] at hy
          have : 1 ≤ (b - ‖y‖) / (b - a) := by
            rw [le_div_iff₀ (by linarith)]; linarith
          rw [min_eq_left this, max_eq_right zero_le_one]
        · rw [indicator_of_notMem hy, hf]; exact le_max_left _ _
      · intro y
        by_cases hy : y ∈ closedBall (0 : Euclid P) b
        · rw [indicator_of_mem hy, Pi.one_apply, hf]
          exact max_le zero_le_one (min_le_left _ _)
        · rw [indicator_of_notMem hy, hf, hzero]
          rw [mem_closedBall, dist_zero_right, not_le] at hy
          exact hy.le
    -- Step 5: integrability of functions dominated by the indicator of a finite-measure closed ball
    have hindint : ∀ (ν : Measure (Euclid P)) (t : ℝ), ν (closedBall 0 t) ≠ ∞ →
        Integrable ((closedBall (0 : Euclid P) t).indicator (1 : Euclid P → ℝ)) ν := fun ν t h =>
      (integrable_indicator_iff measurableSet_closedBall).2 (integrableOn_const h enorm_ne_top)
    have hdomint : ∀ (ν : Measure (Euclid P)) (f : Euclid P → ℝ) (t : ℝ), Continuous f →
        ν (closedBall 0 t) ≠ ∞ → 0 ≤ f → f ≤ (closedBall (0 : Euclid P) t).indicator 1 →
        Integrable f ν := by
      intro ν f t hf hfin' h0 hle
      refine (hindint ν t hfin').mono' hf.aestronglyMeasurable (Eventually.of_forall fun y => ?_)
      rw [Real.norm_eq_abs, abs_of_nonneg (h0 y)]
      exact hle y
    -- Step 6: the normalised mass `a(r) = r⁻ⁿ Hⁿ(M ∩ B̄_r(x))` and the plane-ball values
    set a : ℝ → ℝ := fun r => (r⁻¹) ^ n * (μHE[n] (M ∩ closedBall x r)).toReal with hadef
    have hareal : ∀ r : ℝ, 0 < r →
        (μHE[n].restrict (Poincare.SimonGMT.Chapter03.blowUpMap x r '' M)).real (closedBall 0 1) = a r := by
      intro r hr
      rw [measureReal_def, hνball r hr 1, one_mul, ENNReal.toReal_mul,
        ENNReal.toReal_ofReal (by positivity)]
    have hplane : ∀ t : ℝ, 0 ≤ t →
        (μHE[n].restrict (Q : Set (Euclid P))) (closedBall 0 t) = ω * ENNReal.ofReal (t ^ n) := by
      intro t ht
      rw [Measure.restrict_apply measurableSet_closedBall, inter_comm, hplane0 t ht]
    have hplanefin : ∀ t : ℝ, 0 ≤ t → (μHE[n].restrict (Q : Set (Euclid P))) (closedBall 0 t) ≠ ∞ := by
      intro t ht
      rw [hplane t ht]
      exact ENNReal.mul_ne_top hωtop ENNReal.ofReal_ne_top
    have hplanereal : ∀ t : ℝ, 0 ≤ t →
        (μHE[n].restrict (Q : Set (Euclid P))).real (closedBall 0 t) = w * t ^ n := by
      intro t ht
      rw [measureReal_def, hplane t ht, ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity)]
    -- Step 7: `a r → ωₙ`
    have ha : Tendsto a (𝓝[>] 0) (𝓝 w) := by
      rw [tendsto_order]
      constructor
      · intro c hc
        have hcont : Tendsto (fun ε : ℝ => w * (1 - ε) ^ n) (𝓝[>] 0) (𝓝 w) := by
          have : Continuous (fun ε : ℝ => w * (1 - ε) ^ n) := by fun_prop
          simpa using (this.tendsto 0).mono_left nhdsWithin_le_nhds
        obtain ⟨ε, hcε, hε⟩ :=
          ((hcont.eventually (lt_mem_nhds hc)).and (Ioo_mem_nhdsGT one_pos)).exists
        obtain ⟨f, hfc, hf0, hfge, hfle⟩ := hbump (1 - ε) 1 (by linarith [hε.2]) (by linarith [hε.1])
        -- `∫_Q f ≥ ωₙ (1-ε)ⁿ`
        have hQ1 : w * (1 - ε) ^ n ≤ ∫ y in (Q : Set (Euclid P)), f y ∂μHE[n] := by
          rw [← hplanereal (1 - ε) (by linarith [hε.2]), ← integral_indicator_one measurableSet_closedBall]
          exact integral_mono (hindint _ _ (hplanefin _ (by linarith [hε.2])))
            (hdomint _ _ 1 hfc (hplanefin _ zero_le_one) hf0 hfle) hfge
        filter_upwards [(tendsto_order.1 (hconv f)).1 c (hcε.trans_le hQ1),
          Ioc_mem_nhdsGT (half_pos hs)] with r hr1 hr2
        -- `∫_{η(M)} f ≤ a r`
        have h1 : (1 : ℝ) * r ≤ s := by linarith [hr2.2]
        have hle : ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, f y ∂μHE[n] ≤ a r := by
          rw [← hareal r hr2.1, ← integral_indicator_one measurableSet_closedBall]
          exact integral_mono (hdomint _ _ 1 hfc (hνfin r hr2.1 1 h1) hf0 hfle)
            (hindint _ _ (hνfin r hr2.1 1 h1)) hfle
        exact hr1.trans_le hle
      · intro c hc
        have hcont : Tendsto (fun ε : ℝ => w * (1 + ε) ^ n) (𝓝[>] 0) (𝓝 w) := by
          have : Continuous (fun ε : ℝ => w * (1 + ε) ^ n) := by fun_prop
          simpa using (this.tendsto 0).mono_left nhdsWithin_le_nhds
        obtain ⟨ε, hcε, hε⟩ :=
          ((hcont.eventually (gt_mem_nhds hc)).and (Ioo_mem_nhdsGT one_pos)).exists
        obtain ⟨f, hfc, hf0, hfge, hfle⟩ := hbump 1 (1 + ε) one_pos (by linarith [hε.1])
        -- `∫_Q f ≤ ωₙ (1+ε)ⁿ`
        have hQ2 : ∫ y in (Q : Set (Euclid P)), f y ∂μHE[n] ≤ w * (1 + ε) ^ n := by
          rw [← hplanereal (1 + ε) (by linarith [hε.1]), ← integral_indicator_one measurableSet_closedBall]
          exact integral_mono (hdomint _ _ (1 + ε) hfc (hplanefin _ (by linarith [hε.1])) hf0 hfle)
            (hindint _ _ (hplanefin _ (by linarith [hε.1]))) hfle
        filter_upwards [(tendsto_order.1 (hconv f)).2 c (hQ2.trans_lt hcε),
          Ioc_mem_nhdsGT (half_pos hs)] with r hr1 hr2
        -- `a r ≤ ∫_{η(M)} f`
        have h1 : (1 : ℝ) * r ≤ s := by linarith [hr2.2]
        have h2 : (1 + ε) * r ≤ s :=
          (mul_le_mul_of_nonneg_right (show 1 + ε ≤ 2 by linarith [hε.2]) hr2.1.le).trans
            (by linarith [hr2.2])
        have hge : a r ≤ ∫ y in Poincare.SimonGMT.Chapter03.blowUpMap x r '' M, f y ∂μHE[n] := by
          rw [← hareal r hr2.1, ← integral_indicator_one measurableSet_closedBall]
          exact integral_mono (hindint _ _ (hνfin r hr2.1 1 h1))
            (hdomint _ _ (1 + ε) hfc (hνfin r hr2.1 _ h2) hf0 hfle) hfge
        exact hge.trans_lt hr1
    -- Step 8: back to the `ℝ≥0∞` quotient
    have hconvert : ∀ ρ : ℝ, 0 < ρ → ρ ≤ s →
        μHE[n] (M ∩ closedBall x ρ) / (ω * ENNReal.ofReal (ρ ^ n)) = ENNReal.ofReal (a ρ / w) := by
      intro ρ hρ hρs
      have hρn : 0 < ρ ^ n := pow_pos hρ n
      rw [← ENNReal.ofReal_toReal (hmfin ρ hρs), ← ENNReal.ofReal_toReal hωtop,
        ← ENNReal.ofReal_mul ENNReal.toReal_nonneg,
        ← ENNReal.ofReal_div_of_pos (mul_pos hw hρn)]
      congr 1
      simp only [hadef, inv_pow]
      field_simp
    have hlim : Tendsto (fun ρ : ℝ => ENNReal.ofReal (a ρ / w)) (𝓝[>] 0) (𝓝 1) := by
      have := ENNReal.tendsto_ofReal (ha.div_const w)
      rwa [div_self hw.ne', ENNReal.ofReal_one] at this
    refine hlim.congr' ?_
    filter_upwards [Ioc_mem_nhdsGT hs] with ρ hρ
    exact (hconvert ρ hρ.1 hρ.2).symm
  -- Accepted `Submission.rsd_tendsto_ball_density_of_closedBall`, inlined: densities computed with
  -- closed balls are also computed with open balls (Ch. 1, 3.1–3.2).
  have rsd_tendsto_ball_density_of_closedBall : ∀ (P n : ℕ) (ν : Measure (Euclid P)) (x : Euclid P) (θ : ℝ≥0∞), Tendsto (fun ρ : ℝ => ν (closedBall x ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) (𝓝 θ) → Tendsto (fun ρ : ℝ => ν (ball x ρ) / (unitBallVolume n * ENNReal.ofReal (ρ ^ n))) (𝓝[>] 0) (𝓝 θ) := by
    intro P n ν x θ hg
    set ω := unitBallVolume n
    rw [tendsto_order]
    refine ⟨fun a ha => ?_, fun b hb => ?_⟩
    · -- Step 2: choose `t ∈ (0, 1)` with `a < tⁿθ`, using `tⁿθ → θ` as `t ↑ 1`
      have hlim : Tendsto (fun t : ℝ => ENNReal.ofReal (t ^ n) * θ) (𝓝[<] 1) (𝓝 (1 * θ)) := by
        refine ENNReal.Tendsto.mul_const ?_ (Or.inl one_ne_zero)
        have : Tendsto (fun t : ℝ => ENNReal.ofReal (t ^ n)) (𝓝 1) (𝓝 (ENNReal.ofReal (1 ^ n))) :=
          (ENNReal.continuous_ofReal.comp (continuous_pow n)).tendsto 1
        simpa using this.mono_left nhdsWithin_le_nhds
      rw [one_mul] at hlim
      obtain ⟨t, hta, ht0, ht1⟩ : ∃ t : ℝ, a < ENNReal.ofReal (t ^ n) * θ ∧ 0 < t ∧ t < 1 := by
        have h1 := (tendsto_order.1 hlim).1 a ha
        have h2 : ∀ᶠ t in 𝓝[<] (1 : ℝ), t ∈ Ioo (0 : ℝ) 1 := Ioo_mem_nhdsLT (by norm_num)
        obtain ⟨t, ht, ht'⟩ := (h1.and h2).exists
        exact ⟨t, ht, ht'.1, ht'.2⟩
      have hc0 : ENNReal.ofReal (t ^ n) ≠ 0 := by
        rw [Ne, ENNReal.ofReal_eq_zero, not_le]
        positivity
      have hctop : ENNReal.ofReal (t ^ n) ≠ ∞ := ENNReal.ofReal_ne_top
      have ha' : a / ENNReal.ofReal (t ^ n) < θ := by
        rw [ENNReal.div_lt_iff (Or.inl hc0) (Or.inl hctop), mul_comm]
        exact hta
      -- Step 3: the rescaled closed-ball ratio `g(tρ)` still tends to `θ`
      have hmap : Tendsto (fun ρ : ℝ => t * ρ) (𝓝[>] 0) (𝓝[>] 0) := by
        refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ ?_ ?_
        · have h0 : Tendsto (fun ρ : ℝ => t * ρ) (𝓝 0) (𝓝 0) := by
            simpa using (tendsto_id (x := 𝓝 (0 : ℝ))).const_mul t
          exact h0.mono_left nhdsWithin_le_nhds
        · filter_upwards [self_mem_nhdsWithin] with ρ hρ
          exact mul_pos ht0 hρ
      have hev := (tendsto_order.1 (hg.comp hmap)).1 _ ha'
      filter_upwards [hev, self_mem_nhdsWithin] with ρ hρ hρpos
      simp only [Function.comp] at hρ
      have hρpos' : (0 : ℝ) < ρ := hρpos
      -- Step 4: `ν(B̄_{tρ}(x)) / (ωₙ(tρ)ⁿ) · tⁿ = ν(B̄_{tρ}(x)) / (ωₙρⁿ)`
      have hid : ν (closedBall x (t * ρ)) / (ω * ENNReal.ofReal ((t * ρ) ^ n)) * ENNReal.ofReal (t ^ n)
          = ν (closedBall x (t * ρ)) / (ω * ENNReal.ofReal (ρ ^ n)) := by
        rw [mul_pow, ENNReal.ofReal_mul (by positivity), mul_comm (ENNReal.ofReal (t ^ n)),
          ← mul_assoc, div_eq_mul_inv, div_eq_mul_inv, ENNReal.mul_inv (Or.inr hctop) (Or.inr hc0),
          mul_assoc, mul_assoc, ENNReal.inv_mul_cancel hc0 hctop, mul_one]
      -- Step 5: `a < tⁿ g(tρ) ≤ h(ρ)`, as `B̄_{tρ}(x) ⊆ B_ρ(x)`
      calc a = a / ENNReal.ofReal (t ^ n) * ENNReal.ofReal (t ^ n) :=
            (ENNReal.div_mul_cancel hc0 hctop).symm
        _ < ν (closedBall x (t * ρ)) / (ω * ENNReal.ofReal ((t * ρ) ^ n)) * ENNReal.ofReal (t ^ n) :=
            (ENNReal.mul_lt_mul_iff_left hc0 hctop).2 hρ
        _ = ν (closedBall x (t * ρ)) / (ω * ENNReal.ofReal (ρ ^ n)) := hid
        _ ≤ ν (ball x ρ) / (ω * ENNReal.ofReal (ρ ^ n)) := by
            gcongr
            exact closedBall_subset_ball (by nlinarith)
    · -- Step 1: `h(ρ) ≤ g(ρ)`, as `B_ρ(x) ⊆ B̄_ρ(x)`
      filter_upwards [(tendsto_order.1 hg).2 b hb] with ρ hρ
      refine lt_of_le_of_lt ?_ hρ
      gcongr
      exact ball_subset_closedBall
  -- Accepted `Submission.rsd_imrep_compact_measure_ne_top`, inlined: `Hⁿ(M ∩ K) < ∞` and `μ_T(K) < ∞`
  -- for compact `K ⊆ U` (Ch. 6, Definition 3.1).
  have rsd_imrep_compact_measure_ne_top : ∀ (P n : ℕ) (U : Set (Euclid P)) (R : IMRep U n) (K : Set (Euclid P)), IsCompact K → K ⊆ U → μHE[n] (R.carrier ∩ K) ≠ ∞ ∧ R.measure K ≠ ∞ := by
    intro P n U R K hK hKU
    have hint := R.locallyIntegrable_mult K hK hKU
    -- `μ_R(K) = ∫_K θ d(Hⁿ⌞M) = ∫_{M ∩ K} θ dHⁿ`, `K` being closed, hence Borel
    have hmeas : R.measure K = ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
      rw [IMRep.measure, withDensity_apply _ hK.measurableSet,
        Measure.restrict_restrict hK.measurableSet, inter_comm]
    refine ⟨?_, by rw [hmeas]; exact hint⟩
    refine ne_top_of_le_ne_top hint ?_
    -- `Hⁿ(M ∩ K) = ∫_{M ∩ K} 1 dHⁿ ≤ ∫_{M ∩ K} θ dHⁿ`, as `1 ≤ θ` on `M`
    calc μHE[n] (R.carrier ∩ K) = ∫⁻ _ in R.carrier ∩ K, (1 : ℝ≥0∞) ∂μHE[n] := by
          rw [setLIntegral_one]
      _ ≤ ∫⁻ x in R.carrier ∩ K, (R.mult x : ℝ≥0∞) ∂μHE[n] := by
          refine setLIntegral_mono (measurable_from_nat.comp R.measurable_mult) ?_
          intro x hx
          exact_mod_cast R.mult_pos x hx.1
  -- Accepted `Submission.rsd_mw_wlm_orient_opNorm_le_one`, inlined: a unit orientation has operator
  -- norm at most `1`.
  have rsd_mw_wlm_orient_opNorm_le_one : ∀ (P n : ℕ) (Q : Submodule ℝ (Euclid P)) (ξ : MultiVector P n), IsUnitOrientationOf ξ Q → ‖ξ‖ ≤ 1 := by
    rintro P n Q ξ ⟨τ, hτ, -, hξ⟩
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun α => ?_
    -- `|α(τ)| ≤ ‖α‖ ∏ᵢ ‖τᵢ‖ = ‖α‖`, as `‖τᵢ‖ = 1`
    have hbound : ‖α τ‖ ≤ ‖α‖ := by
      simpa [hτ.1] using α.le_opNorm τ
    rcases hξ with h | h
    · rw [h, one_mul]
      exact hbound
    · rw [h, norm_neg, one_mul]
      exact hbound
  -- Accepted `Submission.rsd_mw_wlm_eval_eq_integral_restrict`, inlined: `T(ω) = ∫ ⟨ω, ξ⟩ d(μ_T⌞V)`
  -- when `spt ω ⊆ V`.
  have rsd_mw_wlm_eval_eq_integral_restrict : ∀ (P n : ℕ) (U : Set (Euclid P)) (T : GeometricCurrentOn U n) (R : IMRep U n), R.Represents T → ∀ (V : Set (Euclid P)) (ω : TestFormOn U n), tsupport (ω : DifferentialForm (Euclid P) n) ⊆ V → T ω = ∫ x, R.orient x ((ω : DifferentialForm (Euclid P) n) x) ∂(R.measure.restrict V) := by
    intro P n U T R hR V ω hωV
    rw [hR ω, setIntegral_eq_integral_of_forall_compl_eq_zero]
    · -- `μ = (Hⁿ⌞M).withDensity θ` with `θ` read as a measurable `ℝ≥0`-valued density
      have hμ : R.measure = (μHE[n].restrict R.carrier).withDensity
          (fun x => ((R.mult x : NNReal) : ℝ≥0∞)) := by
        simp [IMRep.measure]
      have hmeas : Measurable fun x => (R.mult x : NNReal) :=
        measurable_from_nat.comp R.measurable_mult
      rw [hμ, integral_withDensity_eq_integral_smul hmeas]
      simp [IMRep.action, NNReal.smul_def]
    · -- off `V`, hence off `spt ω`, the form vanishes and so does `⟨ω, ξ⟩`
      intro x hx
      have h0 : (ω : DifferentialForm (Euclid P) n) x = 0 :=
        image_eq_zero_of_notMem_tsupport fun h => hx (hωV h)
      simp [h0]
  -- Accepted `Submission.rsd_mw_unit_orientation_dual`, inlined: `|ξ(α)| ≤ |α|` for a unit
  -- orientation `ξ`, and a dual field `J` with `|J(ξ)| = ξ(J(ξ)) = 1` (Ch. 6, Remark 2.6); here also
  -- `‖J w‖ ≤ C‖w‖`.
  have rsd_mw_unit_orientation_dual : ∀ (P n : ℕ), ∃ J : MultiVector P n →L[ℝ] Covector (Euclid P) n, (∃ C : ℝ, 0 ≤ C ∧ ∀ w : MultiVector P n, ‖J w‖ ≤ C * ‖w‖) ∧ ∀ (ξ : MultiVector P n) (Q : Submodule ℝ (Euclid P)), IsUnitOrientationOf ξ Q → (∀ α : Covector (Euclid P) n, |ξ α| ≤ covectorEuclideanNorm α) ∧ covectorEuclideanNorm (J ξ) = 1 ∧ ξ (J ξ) = 1 := by
    intro P n
    -- `D u v = Σ_σ sgn σ ∏ₖ ⟨uₖ, v_{σ k}⟩ = det(⟨uₖ, vⱼ⟩)`, a continuous alternating map as an
    -- alternatization; `e^I = D (e ∘ I)` and `γ = D τ`
    let D : (Fin n → Euclid P) → Covector (Euclid P) n := fun u =>
      ContinuousMultilinearMap.alternatization
        ((ContinuousMultilinearMap.mkPiAlgebra ℝ (Fin n) ℝ).compContinuousLinearMap
          fun k => innerSL ℝ (u k))
    have hD : ∀ u v, D u v =
        ∑ σ : Equiv.Perm (Fin n), Equiv.Perm.sign σ • ∏ k, inner ℝ (u k) (v (σ k)) := by
      intro u v
      simp only [D, ContinuousMultilinearMap.alternatization_apply_apply,
        ContinuousMultilinearMap.compContinuousLinearMap_apply,
        ContinuousMultilinearMap.mkPiAlgebra_apply, innerSL_apply_apply, Function.comp_apply]
    -- `D u v = D v u` (determinant of the transpose): substitute `σ ↦ σ⁻¹` and `k ↦ σ k`
    have hDsymm : ∀ u v, D u v = D v u := by
      intro u v
      rw [hD, hD]
      refine Fintype.sum_equiv (Equiv.inv (Equiv.Perm (Fin n))) _ _ fun σ => ?_
      rw [Equiv.inv_apply, Equiv.Perm.sign_inv,
        ← Equiv.prod_comp σ (fun k => inner ℝ (v k) (u (σ⁻¹ k)))]
      simp only [Equiv.Perm.coe_inv, Equiv.symm_apply_apply, real_inner_comm]
    -- `D u u = 1` for orthonormal `u`: only `σ = 1` contributes
    have hD1 : ∀ u, Orthonormal ℝ u → D u u = 1 := by
      intro u hu
      rw [hD, Finset.sum_eq_single (1 : Equiv.Perm (Fin n))]
      · rw [Equiv.Perm.sign_one, one_smul]
        refine Finset.prod_eq_one fun k _ => ?_
        rw [Equiv.Perm.coe_one, id, real_inner_self_eq_norm_sq, hu.norm_eq_one, one_pow]
      · intro σ _ hσ
        obtain ⟨k, hk⟩ : ∃ k, σ k ≠ k := by
          by_contra! h
          exact hσ (Equiv.ext h)
        rw [Finset.prod_eq_zero (Finset.mem_univ k) (hu.inner_eq_zero hk.symm), smul_zero]
      · exact fun h => absurd (Finset.mem_univ _) h
    -- step 2: `e^I(e_K) = δ_IK` for strictly increasing `I`, `K`; a nonzero term forces
    -- `K ∘ σ = I`, so `range I = range K` and `I = K`
    let e := EuclideanSpace.basisFun (Fin P) ℝ
    have he : ∀ i j, inner ℝ (e i) (e j) = if i = j then (1 : ℝ) else 0 :=
      orthonormal_iff_ite.mp e.orthonormal
    have hK : ∀ I K : Fin n → Fin P, StrictMono I → StrictMono K →
        D (fun k => e (I k)) (fun k => e (K k)) = if I = K then 1 else 0 := by
      intro I K hI hK
      split_ifs with hIK
      · subst hIK
        exact hD1 _ (e.orthonormal.comp I hI.injective)
      · rw [hD]
        refine Finset.sum_eq_zero fun σ _ => ?_
        rw [Finset.prod_eq_zero_iff.mpr, smul_zero]
        by_contra! h
        apply hIK
        have hKσ : K ∘ σ = I := funext fun k => by
          have := h k (Finset.mem_univ k)
          rw [he] at this
          split_ifs at this with hk
          · exact hk.symm
          · exact absurd rfl this
        rw [← StrictMono.range_inj_of_wellFoundedLT hI hK, ← hKσ, EquivLike.range_comp]
    -- step 1: `α = Σ_{I ∈ S} α(e_I) e^I`; both sides are alternating, so compare them on `e ∘ f`
    -- for injective `f`, and write `f = (f ∘ σ) ∘ σ⁻¹` with `f ∘ σ` strictly increasing
    let S : Finset (Fin n → Fin P) := Finset.univ.filter StrictMono
    have hE : ∀ α : Covector (Euclid P) n,
        α = ∑ I ∈ S, α (fun k => e (I k)) • D (fun k => e (I k)) := by
      intro α
      apply ContinuousAlternatingMap.toAlternatingMap_injective
      refine e.toBasis.ext_alternating fun f hf => ?_
      simp only [OrthonormalBasis.coe_toBasis, ContinuousAlternatingMap.coe_toAlternatingMap]
      set σ := Tuple.sort f
      have hfσ : StrictMono (f ∘ σ) :=
        (Tuple.monotone_sort f).strictMono_of_injective (hf.comp σ.injective)
      have hperm : ∀ β : Covector (Euclid P) n,
          β (fun k => e (f k)) = Equiv.Perm.sign σ⁻¹ • β (fun k => e ((f ∘ σ) k)) := by
        intro β
        have : (fun k => e (f k)) = (fun k => e ((f ∘ σ) k)) ∘ ⇑(σ⁻¹) := by
          funext k
          simp
        rw [this]
        exact β.toAlternatingMap.map_perm _ _
      rw [hperm α, hperm, ContinuousAlternatingMap.sum_apply, Finset.sum_eq_single (f ∘ σ)]
      · rw [ContinuousAlternatingMap.smul_apply, hK _ _ hfσ hfσ, ite_eq_left rfl, smul_eq_mul,
          mul_one]
      · intro I hI hIf
        rw [ContinuousAlternatingMap.smul_apply, hK _ _ (Finset.mem_filter.mp hI).2 hfσ,
          ite_eq_right hIf, smul_zero]
      · exact fun h => absurd (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hfσ⟩) h
    -- `|β| = (Σ_{I ∈ S} β(e_I)²)^{1/2}`
    have hnorm : ∀ β : Covector (Euclid P) n,
        covectorEuclideanNorm β = Real.sqrt (∑ I ∈ S, β (fun k => e (I k)) ^ 2) := by
      intro β
      rw [covectorEuclideanNorm, Finset.sum_filter]
    -- step 3 (Cauchy–Binet): `Σ_{I ∈ S} e^I(τ)² = 1` for orthonormal `τ`; evaluate the expansion
    -- of `γ = D τ` at `τ`, using `γ(τ) = 1` and `γ(e_I) = e^I(τ)`
    have hCB : ∀ τ : Fin n → Euclid P, Orthonormal ℝ τ →
        ∑ I ∈ S, D (fun k => e (I k)) τ ^ 2 = 1 := by
      intro τ hτ
      have h := congrArg (fun β : Covector (Euclid P) n => β τ) (hE (D τ))
      simp only [ContinuousAlternatingMap.sum_apply, ContinuousAlternatingMap.smul_apply,
        smul_eq_mul, hD1 τ hτ] at h
      rw [h]
      refine Finset.sum_congr rfl fun I _ => ?_
      rw [hDsymm τ, sq]
    -- step 4: `J w = Σ_{I ∈ S} w(e^I) e^I`
    have hJ : ∀ w : MultiVector P n, (∑ I ∈ S, (ContinuousLinearMap.apply ℝ ℝ
        (D fun k => e (I k))).smulRight (D fun k => e (I k))) w =
        ∑ I ∈ S, w (D fun k => e (I k)) • D fun k => e (I k) := by
      intro w
      simp only [sum_apply, ContinuousLinearMap.smulRight_apply,
        ContinuousLinearMap.apply_apply]
    -- (added) `‖J w‖ = ‖Σ_I w(e^I) e^I‖ ≤ Σ_I |w(e^I)| |e^I| ≤ (Σ_I |e^I|²) ‖w‖`
    have hJb : ∀ w : MultiVector P n, ‖∑ I ∈ S, w (D fun k => e (I k)) • D fun k => e (I k)‖ ≤
