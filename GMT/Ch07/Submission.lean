  -- Step 8: `R_{t₀} = (M_{t₀}, θ, ζ)`, `R₀ = R_{t₀} − t₀` and `S₀ = τ(R₀)`
  obtain ⟨Rs, hRsc, hRsm, hRso⟩ : ∃ Rs : IMRep (univ : Set (Euclid P)) (n - d),
