      image_inter_preimage, inter_comm]
  -- (9) Bochner area formula: `∫_{ψ(Y)} h dHᵐ = ∫_Y J · h ∘ ψ` for every `h`.
  have harea : ∀ h : Euclid P → ℝ,
      ∫ x in ψ '' Y, h x ∂μHE[m] = ∫ v in Y, Jf (fderiv ℝ ψ v) * h (ψ v) := by
    intro h
