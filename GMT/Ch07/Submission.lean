  refine ⟨?_, ?_, ?_⟩
  · -- (10): degree `0`.
    intro N N' Λ L F G H X hF hG hH hXc hXm hHX
    have hXb : boundaryMassOn X univ < ∞ := by simp [boundaryMassOn]
    obtain ⟨Fs, Gs, Hs, Λ', hFsC, hGsC, hHsC, hHsid, hFsD, hGsD, -, -, hFU, hGU, hHU, hHsD⟩ :=
